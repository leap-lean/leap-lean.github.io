import WeilPart42
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_net_curve_punctured_etale_cover_and_chart0_bridge (k : Type u) [Field k] [IsAlgClosed k]
    (S_aff_k : Finset k)
    (Δ_k : Polynomial k)
    (R₀_k : Type u) [CommRing R₀_k] [Algebra k R₀_k] [Algebra (Polynomial k) R₀_k]
    [IsScalarTower k (Polynomial k) R₀_k]
    (_hR₀_k : IsLocalization.Away Δ_k R₀_k) :
    Δ_k = (∏ s_k ∈ S_aff_k, (Polynomial.X - Polynomial.C s_k : Polynomial k)) →
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (d_Sigma d_disc : ℕ)
      (H_Sigma F_disc_hom : MvPolynomial (Fin 3) k)
      (P₀ P₁ P₂ : Polynomial k)
      (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂],
      1 ≤ d_Sigma → 1 ≤ d_disc →
      F_disc_hom.IsHomogeneous d_disc →
      P₀.Monic → P₀.natDegree = d_Sigma →
      (∀ c : Fin 3,
        (![P₀, P₁, P₂] c = 0 ∧ IsUnit (eval_c c H_Sigma)) ∨
        (![P₀, P₁, P₂] c ≠ 0 ∧
          let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
            MvPolynomial.aeval (fun j : Fin 2 =>
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
          RingHom.ker θ_c.toRingHom = Ideal.span {eval_c c H_Sigma} ∧
          Set.range θ_c =
            { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
                Q.natDegree ≤ n * d_Sigma ∧
                f = algebraMap (Polynomial k) (RatFunc k) Q /
                  (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n })) →
      (∀ b : k,
        P₀.eval b ≠ 0 →
        MvPolynomial.eval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]
          (eval_c 0 F_disc_hom) = 0 →
        b ∈ S_aff_k) →
      (∀ b : k,
        P₀.eval b = 0 →
        Δ_k.eval b ≠ 0 ∧
        (P₁.eval b ≠ 0 ∨ P₂.eval b ≠ 0) ∧
        MvPolynomial.eval ![0, P₁.eval b, P₂.eval b] F_disc_hom ≠ 0) →
      (∀ c : Fin 3,
        letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
          ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
        @RingHom.Etale
          (Localization.Away (eval_c c F_disc_hom))
          (Localization.Away (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c (eval_c c F_disc_hom)))
          inferInstance inferInstance
          (Localization.awayMap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c)
            (eval_c c F_disc_hom))) →
      ∀ (L_Sigma : Type u) [Field L_Sigma]
        [Algebra k L_Sigma] [Algebra (Polynomial k) L_Sigma] [Algebra (RatFunc k) L_Sigma]
        [IsScalarTower k (Polynomial k) L_Sigma]
        [IsScalarTower k (RatFunc k) L_Sigma]
        [IsScalarTower (Polynomial k) (RatFunc k) L_Sigma]
        [FiniteDimensional (RatFunc k) L_Sigma] [IsGalois (RatFunc k) L_Sigma],
        (∀ c : Fin 3, ![P₀, P₁, P₂] c ≠ 0 →
          letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
            ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
          let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
          let I_hc : Ideal ↥B₂_c :=
            Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c (eval_c c H_Sigma)}
          let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
            MvPolynomial.aeval (fun j : Fin 2 =>
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
          ∃ ι_c : (↥B₂_c ⧸ I_hc) →+* L_Sigma,
            Function.Injective ι_c ∧
            (∀ g : MvPolynomial (Fin 2) k,
              ι_c (Ideal.Quotient.mk I_hc (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c g)) =
                algebraMap (RatFunc k) L_Sigma (θ_c g)) ∧
            (let D_c : Subalgebra k (RatFunc k) := θ_c.range
             letI : Algebra ↥D_c L_Sigma :=
               ((algebraMap (RatFunc k) L_Sigma).comp D_c.val.toRingHom).toAlgebra
             ∀ z : L_Sigma, z ∈ Set.range ι_c ↔ IsIntegral ↥D_c z)) →
        ∃ (B_Sigma : Type u)
          (_ : CommRing B_Sigma) (_ : IsDomain B_Sigma)
          (_ : Algebra k B_Sigma) (_ : Algebra (Polynomial k) B_Sigma) (_ : Algebra R₀_k B_Sigma)
          (_ : Algebra B_Sigma L_Sigma) (_ : Algebra R₀_k L_Sigma)
          (_ : IsScalarTower k (Polynomial k) B_Sigma)
          (_ : IsScalarTower (Polynomial k) R₀_k B_Sigma)
          (_ : IsScalarTower (Polynomial k) B_Sigma L_Sigma)
          (_ : IsScalarTower R₀_k B_Sigma L_Sigma)
          (_ : Module.Finite R₀_k B_Sigma)
          (_ : Algebra.Etale R₀_k B_Sigma)
          (_ : IsFractionRing B_Sigma L_Sigma)
          (_ : IsIntegralClosure B_Sigma R₀_k L_Sigma),
          letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
            ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
          let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
          let f_B0 : ↥B₂_0 :=
            algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 F_disc_hom)
          let p₀_BSigma : B_Sigma :=
            algebraMap R₀_k B_Sigma (algebraMap (Polynomial k) R₀_k P₀)
          let ι_B0 : MvPolynomial (Fin 2) k →+* Localization.Away f_B0 :=
            (algebraMap ↥B₂_0 (Localization.Away f_B0)).comp
              (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0)
          let ι_BSigma : Polynomial k →+* Localization.Away p₀_BSigma :=
            (algebraMap B_Sigma (Localization.Away p₀_BSigma)).comp
              ((algebraMap R₀_k B_Sigma).comp (algebraMap (Polynomial k) R₀_k))
          ∃ ψ_0 : Localization.Away f_B0 →+* Localization.Away p₀_BSigma,
            (∀ c₀ : k, ψ_0 (ι_B0 (MvPolynomial.C c₀)) = ι_BSigma (Polynomial.C c₀)) ∧
            ψ_0 (ι_B0 (MvPolynomial.X 0)) * ι_BSigma P₀ = ι_BSigma P₁ ∧
            ψ_0 (ι_B0 (MvPolynomial.X 1)) * ι_BSigma P₀ = ι_BSigma P₂ :=
by
  intro hΔ_k K₂ x₁ x₂ homCoord eval_c φ_K₂ d_Sigma d_disc H_Sigma F_disc_hom P₀ P₁ P₂ L₂
    _ _ _ _ hd_Sigma hd_disc hHom_Fdisc hP₀_mon hP₀_deg
    hCharts_Sigma hConv_Saff hPoles_P₀ hEtale_3charts
    L_Sigma _ _ _ _ _ _ _ _ _ hCharts_ι
  haveI : IsLocalization.Away Δ_k R₀_k := _hR₀_k

  
  
  
  have hAwayMap_eq : ∀ {R P : Type u} [CommRing R] [CommRing P] (f : R →+* P) (r x : R),
      Localization.awayMap f r (algebraMap R (Localization.Away r) x) =
        algebraMap P (Localization.Away (f r)) (f x) :=
    fun f r x => IsLocalization.Away.lift_eq r
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (f r)) (f r)) x

  have hFin3 : ∀ c i : Fin 3, i = c ∨ ∃ j : Fin 2, i = c.succAbove j := by decide
  have hSuccSelf : ∀ (c : Fin 3) {α : Type u} (x : α) (f : Fin 2 → α),
      Fin.succAboveCases c x f c = x := fun c _ _ _ => by fin_cases c <;> rfl
  have hSuccAbove : ∀ (c : Fin 3) (j : Fin 2) {α : Type u} (x : α) (f : Fin 2 → α),
      Fin.succAboveCases c x f (c.succAbove j) = f j :=
    fun c j _ _ _ => by fin_cases c <;> fin_cases j <;> rfl
  have hPullbackRingHom : ∀ {R S F : Type u} [CommRing R] [CommRing S] [CommRing F]
      (f : R →+* F) (j : S →+* F), Function.Injective j →
      (∀ r : R, ∃ s : S, j s = f r) →
      ∃ g : R →+* S, ∀ r : R, j (g r) = f r := by
    intro R S F _ _ _ f j hj hr
    let g_fun : R → S := fun r => Classical.choose (hr r)
    have hg : ∀ r : R, j (g_fun r) = f r := fun r => Classical.choose_spec (hr r)
    refine ⟨{
      toFun := g_fun
      map_one' := hj (by rw [hg, map_one, map_one])
      map_mul' := fun x y => hj (by rw [hg, map_mul, map_mul, hg, hg])
      map_zero' := hj (by rw [hg, map_zero, map_zero])
      map_add' := fun x y => hj (by rw [hg, map_add, map_add, hg, hg])
    }, hg⟩

  have hAwayLiftToField : ∀ {A F : Type u} [CommRing A] [Field F]
      (φ : A →+* F), Function.Injective φ →
      ∀ (dA : A), dA ≠ 0 →
      ∃ j : Localization.Away dA →+* F,
        Function.Injective j ∧
        (∀ a : A, j (algebraMap A (Localization.Away dA) a) = φ a) ∧
        j (IsLocalization.Away.invSelf (S := Localization.Away dA) dA) * φ dA = 1 := by
    intro A F _ _ φ hφ dA hdA
    have hφ_ne : φ dA ≠ 0 := (map_ne_zero_iff φ hφ).mpr hdA
    have hu : IsUnit (φ dA) := IsUnit.mk0 (φ dA) hφ_ne
    let j : Localization.Away dA →+* F :=
      IsLocalization.Away.lift dA (S := Localization.Away dA) hu
    have hj_eq : ∀ a : A, j (algebraMap A (Localization.Away dA) a) = φ a :=
      IsLocalization.Away.lift_eq dA hu
    have hj_inj : Function.Injective j := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨p, ⟨_, n, rfl⟩⟩, hpz⟩ := IsLocalization.surj (Submonoid.powers dA) z
      have hpz' : z * (algebraMap A (Localization.Away dA) dA) ^ n =
          algebraMap A (Localization.Away dA) p := by
        simpa only [map_pow] using hpz
      have hφp : φ p = 0 := by
        calc φ p = j (algebraMap A (Localization.Away dA) p) := (hj_eq p).symm
          _ = j (z * (algebraMap A (Localization.Away dA) dA) ^ n) := by rw [← hpz']
          _ = j z * j ((algebraMap A (Localization.Away dA) dA) ^ n) := map_mul _ _ _
          _ = 0 := by rw [hz, zero_mul]
      have hp0 : p = 0 := hφ (hφp.trans (map_zero φ).symm)
      rw [hp0, map_zero] at hpz'
      have hu_pow : IsUnit ((algebraMap A (Localization.Away dA) dA) ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit dA).pow n
      rcases hu_pow.exists_right_inv with ⟨v, hv⟩
      calc z = z * 1 := (mul_one z).symm
        _ = z * ((algebraMap A (Localization.Away dA) dA) ^ n * v) := by rw [hv]
        _ = (z * (algebraMap A (Localization.Away dA) dA) ^ n) * v := (mul_assoc _ _ _).symm
        _ = 0 := by rw [hpz', zero_mul]
    have hj_inv : j (IsLocalization.Away.invSelf (S := Localization.Away dA) dA) * φ dA = 1 := by
      calc j (IsLocalization.Away.invSelf (S := Localization.Away dA) dA) * φ dA
          = j (IsLocalization.Away.invSelf (S := Localization.Away dA) dA) *
              j (algebraMap A (Localization.Away dA) dA) := by rw [hj_eq]
        _ = j (algebraMap A (Localization.Away dA) dA *
              IsLocalization.Away.invSelf (S := Localization.Away dA) dA) := by
            rw [← map_mul, mul_comm]
        _ = j 1 := by rw [IsLocalization.Away.mul_invSelf]
        _ = 1 := map_one j
    exact ⟨j, hj_inj, hj_eq, hj_inv⟩

  have hMonicSum : ∀ {R : Type u} [CommRing R] (d : ℕ) (c_fn : ℕ → R),
      ((Polynomial.X : Polynomial R) ^ d +
        ∑ i ∈ Finset.range d, Polynomial.C (c_fn i) * Polynomial.X ^ i).Monic := by
    intro R _ d c_fn
    rcases Nat.eq_zero_or_pos d with rfl | hd_pos
    · simp [Polynomial.monic_one]
    · apply Polynomial.monic_X_pow_add
      have hdeg_lt : ∀ m : ℕ, m ≤ d →
          (∑ i ∈ Finset.range m, Polynomial.C (c_fn i) * Polynomial.X ^ i).degree <
            (d : WithBot ℕ) := by
        intro m
        induction m with
        | zero =>
          intro _
          simp
        | succ m ih =>
          intro hm
          rw [Finset.sum_range_succ]
          refine lt_of_le_of_lt (Polynomial.degree_add_le _ _) (max_lt (ih (Nat.le_of_lt hm)) ?_)
          exact lt_of_le_of_lt (Polynomial.degree_C_mul_X_pow_le m (c_fn m))
            (WithBot.coe_lt_coe.mpr hm)
      exact hdeg_lt d (le_refl d)

  have hMonicEvalSplit : ∀ {R S : Type u} [CommRing R] [CommRing S]
      (f : R →+* S) (z : S) (P : Polynomial R),
      P.Monic → Polynomial.eval₂ f z P = 0 →
      z ^ P.natDegree + ∑ i ∈ Finset.range P.natDegree, f (P.coeff i) * z ^ i = 0 := by
    intro R S _ _ f z P hP hev
    have hsum : Polynomial.eval₂ f z P =
        ∑ i ∈ Finset.range (P.natDegree + 1), f (P.coeff i) * z ^ i :=
      Polynomial.eval₂_eq_sum_range f z
    rw [Finset.sum_range_succ, hP.coeff_natDegree, map_one, one_mul, add_comm] at hsum
    exact hsum.symm.trans hev

  
  
  
  have hΔ_mon : Δ_k.Monic := by
    rw [hΔ_k]
    exact Polynomial.monic_prod_of_monic S_aff_k _ (fun s _ => Polynomial.monic_X_sub_C s)
  have hΔ_ne : Δ_k ≠ 0 := hΔ_mon.ne_zero
  have hΔ_deg : Δ_k.natDegree = S_aff_k.card := by
    rw [hΔ_k, Polynomial.natDegree_prod_of_monic S_aff_k _ (fun s _ => Polynomial.monic_X_sub_C s)]
    simp
  have hPowers_le : Submonoid.powers Δ_k ≤ nonZeroDivisors (Polynomial k) :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hΔ_ne)
  have hDom_R₀ : IsDomain R₀_k :=
    IsLocalization.isDomain_of_le_nonZeroDivisors R₀_k hPowers_le
  have hNoeth_R₀ : IsNoetherianRing R₀_k :=
    IsLocalization.isNoetherianRing (Submonoid.powers Δ_k) R₀_k inferInstance
  have hIntClosed_R₀ : IsIntegrallyClosed R₀_k :=
    isIntegrallyClosed_of_isLocalization R₀_k (Submonoid.powers Δ_k) hPowers_le

  have hPoly_RF_inj : Function.Injective (algebraMap (Polynomial k) (RatFunc k)) :=
    IsFractionRing.injective (Polynomial k) (RatFunc k)
  have hΔ_RF_ne : algebraMap (Polynomial k) (RatFunc k) Δ_k ≠ 0 :=
    (map_ne_zero_iff _ hPoly_RF_inj).mpr hΔ_ne
  have hΔ_RF_unit : IsUnit (algebraMap (Polynomial k) (RatFunc k) Δ_k) :=
    IsUnit.mk0 _ hΔ_RF_ne
  let j_R0_RF : R₀_k →+* RatFunc k :=
    IsLocalization.Away.lift Δ_k (S := R₀_k) hΔ_RF_unit
  have hj_align : ∀ p : Polynomial k,
      j_R0_RF (algebraMap (Polynomial k) R₀_k p) = algebraMap (Polynomial k) (RatFunc k) p :=
    IsLocalization.Away.lift_eq Δ_k hΔ_RF_unit
  have hj_inj : Function.Injective j_R0_RF := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    obtain ⟨⟨p, ⟨_, n, rfl⟩⟩, hpr⟩ := IsLocalization.surj (Submonoid.powers Δ_k) r
    have hpr' : r * (algebraMap (Polynomial k) R₀_k Δ_k) ^ n =
        algebraMap (Polynomial k) R₀_k p := by
      simpa only [map_pow] using hpr
    have hp_RF : algebraMap (Polynomial k) (RatFunc k) p = 0 := by
      calc algebraMap (Polynomial k) (RatFunc k) p
          = j_R0_RF (algebraMap (Polynomial k) R₀_k p) := (hj_align p).symm
        _ = j_R0_RF (r * (algebraMap (Polynomial k) R₀_k Δ_k) ^ n) := by rw [← hpr']
        _ = j_R0_RF r * j_R0_RF ((algebraMap (Polynomial k) R₀_k Δ_k) ^ n) := map_mul _ _ _
        _ = 0 := by rw [hr, zero_mul]
    have hp0 : p = 0 := hPoly_RF_inj (hp_RF.trans (map_zero _).symm)
    rw [hp0, map_zero] at hpr'
    have hΔ_R0_ne : (algebraMap (Polynomial k) R₀_k Δ_k) ^ n ≠ 0 :=
      ((IsLocalization.Away.algebraMap_isUnit (S := R₀_k) Δ_k).pow n).ne_zero
    exact (mul_eq_zero.mp hpr').resolve_right hΔ_R0_ne

  let alg_R₀_RF : Algebra R₀_k (RatFunc k) := j_R0_RF.toAlgebra
  have hFrac_R₀ : IsFractionRing R₀_k (RatFunc k) := by
    refine {
      map_units := fun y => IsUnit.mk0 (j_R0_RF y.1)
        ((map_ne_zero_iff j_R0_RF hj_inj).mpr (mem_nonZeroDivisors_iff_ne_zero.mp y.2))
      surj := fun z => ?_
      exists_of_eq := fun {x y} hxy => ⟨1, by simp [hj_inj hxy]⟩
    }
    obtain ⟨⟨p, q⟩, hpq⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial k)) z
    have hq_ne : (q : Polynomial k) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp q.2
    have hq_R0_ne : algebraMap (Polynomial k) R₀_k (q : Polynomial k) ≠ 0 := by
      intro h0
      apply hq_ne
      apply hPoly_RF_inj
      rw [← hj_align, h0, map_zero, map_zero]
    refine ⟨⟨algebraMap (Polynomial k) R₀_k p,
      ⟨algebraMap (Polynomial k) R₀_k q, mem_nonZeroDivisors_of_ne_zero hq_R0_ne⟩⟩, ?_⟩
    change z * j_R0_RF (algebraMap (Polynomial k) R₀_k q) =
      j_R0_RF (algebraMap (Polynomial k) R₀_k p)
    rw [hj_align, hj_align]
    exact hpq

  
  
  
  have hHomScale : ∀ {S : Type u} [CommSemiring S] (f_c : k →+* S) (v : Fin 3 → S) (u : S),
      MvPolynomial.eval₂ f_c (fun i => u * v i) F_disc_hom =
        u ^ d_disc * MvPolynomial.eval₂ f_c v F_disc_hom := by
    intro S _ f_c v u
    rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m hm => ?_
    have hm_deg : (∑ i ∈ m.support, m i) = d_disc := by
      simpa [Finsupp.weight_apply, Finsupp.sum] using
        hHom_Fdisc (MvPolynomial.mem_support_iff.mp hm)
    have hprod : (∏ i ∈ m.support, (u * v i) ^ m i) =
        u ^ d_disc * ∏ i ∈ m.support, v i ^ m i := by
      calc (∏ i ∈ m.support, (u * v i) ^ m i)
          = ∏ i ∈ m.support, (u ^ m i * v i ^ m i) :=
            Finset.prod_congr rfl fun i _ => mul_pow u (v i) (m i)
        _ = (∏ i ∈ m.support, u ^ m i) * ∏ i ∈ m.support, v i ^ m i :=
            Finset.prod_mul_distrib
        _ = u ^ (∑ i ∈ m.support, m i) * ∏ i ∈ m.support, v i ^ m i := by
            rw [Finset.prod_pow_eq_pow_sum]
        _ = u ^ d_disc * ∏ i ∈ m.support, v i ^ m i := by rw [hm_deg]
    rw [hprod, ← mul_assoc, mul_comm (f_c _), mul_assoc]

  let P_vec : Fin 3 → Polynomial k := ![P₀, P₁, P₂]
  let g_disc : Polynomial k := MvPolynomial.eval₂ Polynomial.C P_vec F_disc_hom

  have hg_disc_map : ∀ {S : Type u} [CommSemiring S] (ψ : Polynomial k →+* S),
      ψ g_disc = MvPolynomial.eval₂ (ψ.comp Polynomial.C) (fun i => ψ (P_vec i)) F_disc_hom := by
    intro S _ ψ
    dsimp [g_disc]
    rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, map_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [map_mul, map_prod]
    congr 1
    exact Finset.prod_congr rfl fun i _ => map_pow ψ (P_vec i) (m i)

  have hg_disc_eval : ∀ b : k,
      g_disc.eval b = MvPolynomial.eval ![P₀.eval b, P₁.eval b, P₂.eval b] F_disc_hom := by
    intro b
    have h := hg_disc_map (Polynomial.evalRingHom b)
    have hC : (Polynomial.evalRingHom b).comp Polynomial.C = RingHom.id k := by
      ext x; simp
    have hv : (fun i : Fin 3 => (Polynomial.evalRingHom b) (P_vec i)) =
        ![P₀.eval b, P₁.eval b, P₂.eval b] := by
      ext i; fin_cases i <;> rfl
    rw [hC, hv] at h
    exact h

  have hθ_fdisc : ∀ c : Fin 3, P_vec c ≠ 0 →
      let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
        MvPolynomial.aeval (fun j : Fin 2 =>
          algebraMap (Polynomial k) (RatFunc k) (P_vec (c.succAbove j)) /
          algebraMap (Polynomial k) (RatFunc k) (P_vec c))
      θ_c (eval_c c F_disc_hom) =
        algebraMap (Polynomial k) (RatFunc k) g_disc /
          (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ d_disc := by
    intro c hPc θ_c
    let p_bar : Fin 3 → RatFunc k := fun i => algebraMap (Polynomial k) (RatFunc k) (P_vec i)
    have hp_bar_c : p_bar c ≠ 0 := (map_ne_zero_iff _ hPoly_RF_inj).mpr hPc
    have hcomp_alg : θ_c.comp (eval_c c) =
        MvPolynomial.aeval (fun i : Fin 3 => (p_bar c)⁻¹ * p_bar i) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      rcases hFin3 c i with rfl | ⟨j, rfl⟩
      · rw [hSuccSelf, map_one, inv_mul_cancel₀ hp_bar_c]
      · rw [hSuccAbove, MvPolynomial.aeval_X, div_eq_inv_mul]
    have hev : θ_c (eval_c c F_disc_hom) =
        MvPolynomial.eval₂ (algebraMap k (RatFunc k))
          (fun i : Fin 3 => (p_bar c)⁻¹ * p_bar i) F_disc_hom := by
      calc θ_c (eval_c c F_disc_hom)
          = (θ_c.comp (eval_c c)) F_disc_hom := rfl
        _ = MvPolynomial.aeval (fun i : Fin 3 => (p_bar c)⁻¹ * p_bar i) F_disc_hom := by
            rw [hcomp_alg]
        _ = MvPolynomial.eval₂ (algebraMap k (RatFunc k))
              (fun i : Fin 3 => (p_bar c)⁻¹ * p_bar i) F_disc_hom := MvPolynomial.aeval_def _ _
    have hg_RF : algebraMap (Polynomial k) (RatFunc k) g_disc =
        MvPolynomial.eval₂ (algebraMap k (RatFunc k)) p_bar F_disc_hom := by
      have h := hg_disc_map (algebraMap (Polynomial k) (RatFunc k))
      have hC : (algebraMap (Polynomial k) (RatFunc k)).comp Polynomial.C =
          algebraMap k (RatFunc k) := by
        ext x
        exact (IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k) x).symm
      rwa [hC] at h
    rw [hev, hHomScale, ← hg_RF, inv_pow, div_eq_mul_inv, mul_comm]

  have hUnit_gdisc : IsUnit (algebraMap (Polynomial k) R₀_k g_disc) := by
    have hP₀_deg_ne : P₀.degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hP₀_mon.ne_zero, hP₀_deg]
      intro h0
      have hd0 : d_Sigma = 0 := WithBot.coe_inj.mp h0
      omega
    obtain ⟨b₀, hb₀_aeval⟩ := IsAlgClosed.exists_aeval_eq_zero k P₀ hP₀_deg_ne
    have hb₀ : P₀.eval b₀ = 0 := by simpa using hb₀_aeval
    have hg_b₀_ne : g_disc.eval b₀ ≠ 0 := by
      rw [hg_disc_eval b₀, hb₀]
      exact (hPoles_P₀ b₀ hb₀).2.2
    have hg_ne : g_disc ≠ 0 := fun h0 => hg_b₀_ne (by simp [h0])
    have hlc_ne : g_disc.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg_ne
    have hRoot_in_S : ∀ b : k, g_disc.eval b = 0 → b ∈ S_aff_k := by
      intro b hgb
      have hP₀_b : P₀.eval b ≠ 0 := by
        intro h0
        apply (hPoles_P₀ b h0).2.2
        have hv := hg_disc_eval b
        rw [hgb, h0] at hv
        exact hv.symm
      apply hConv_Saff b hP₀_b
      let v_b : Fin 3 → k := ![P₀.eval b, P₁.eval b, P₂.eval b]
      have hcomp_b : (MvPolynomial.aeval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]).comp
          (eval_c 0) = MvPolynomial.aeval (fun i : Fin 3 => (P₀.eval b)⁻¹ * v_b i) := by
        apply MvPolynomial.algHom_ext
        intro i
        rw [AlgHom.comp_apply, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        rcases hFin3 0 i with rfl | ⟨j, rfl⟩
        · rw [hSuccSelf, map_one]
          dsimp only [v_b]
          exact (inv_mul_cancel₀ hP₀_b).symm
        · rw [hSuccAbove, MvPolynomial.aeval_X]
          fin_cases j
          · change P₁.eval b / P₀.eval b = (P₀.eval b)⁻¹ * P₁.eval b
            exact div_eq_inv_mul _ _
          · change P₂.eval b / P₀.eval b = (P₀.eval b)⁻¹ * P₂.eval b
            exact div_eq_inv_mul _ _
      calc MvPolynomial.eval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]
            (eval_c 0 F_disc_hom)
          = ((MvPolynomial.aeval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]).comp
              (eval_c 0)) F_disc_hom := rfl
        _ = MvPolynomial.aeval (fun i : Fin 3 => (P₀.eval b)⁻¹ * v_b i) F_disc_hom := by
            rw [hcomp_b]
        _ = MvPolynomial.eval₂ (RingHom.id k) (fun i : Fin 3 => (P₀.eval b)⁻¹ * v_b i)
              F_disc_hom := MvPolynomial.aeval_def _ _
        _ = ((P₀.eval b)⁻¹) ^ d_disc * MvPolynomial.eval v_b F_disc_hom :=
            hHomScale (RingHom.id k) v_b (P₀.eval b)⁻¹
        _ = ((P₀.eval b)⁻¹) ^ d_disc * g_disc.eval b := by rw [hg_disc_eval b]
        _ = 0 := by rw [hgb, mul_zero]
    obtain ⟨m, hm_eq⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits g_disc)
    have hm_roots : ∀ b ∈ m, g_disc.eval b = 0 := by
      intro b hb
      have hdvd_prod : (Polynomial.X - Polynomial.C b) ∣
          (m.map (fun x : k => Polynomial.X - Polynomial.C x)).prod :=
        Multiset.dvd_prod (Multiset.mem_map_of_mem _ hb)
      have hdvd_g : (Polynomial.X - Polynomial.C b) ∣ g_disc := by
        rw [hm_eq]
        exact dvd_mul_of_dvd_right hdvd_prod _
      rcases hdvd_g with ⟨q, hq⟩
      simp [hq]
    have hm_prod_unit : ∀ l : Multiset k, (∀ b ∈ l, g_disc.eval b = 0) →
        IsUnit (algebraMap (Polynomial k) R₀_k
          (l.map (fun x : k => Polynomial.X - Polynomial.C x)).prod) := by
      intro l
      induction l using Multiset.induction_on with
      | empty =>
        intro _
        simp
      | cons b l ih =>
        intro hl
        rw [Multiset.map_cons, Multiset.prod_cons, map_mul]
        refine IsUnit.mul ?_ (ih fun x hx => hl x (Multiset.mem_cons_of_mem hx))
        have hb_S : b ∈ S_aff_k := hRoot_in_S b (hl b (Multiset.mem_cons_self b l))
        have hdvd_Δ : (Polynomial.X - Polynomial.C b) ∣ Δ_k := by
          rw [hΔ_k]
          exact Finset.dvd_prod_of_mem _ hb_S
        exact isUnit_of_dvd_unit (map_dvd (algebraMap (Polynomial k) R₀_k) hdvd_Δ)
          (IsLocalization.Away.algebraMap_isUnit (S := R₀_k) Δ_k)
    rw [hm_eq, map_mul]
    refine IsUnit.mul ?_ (hm_prod_unit m hm_roots)
    exact ((IsUnit.mk0 g_disc.leadingCoeff hlc_ne).map Polynomial.C).map
      (algebraMap (Polynomial k) R₀_k)

  let s_nz : Set R₀_k :=
    (fun c : Fin 3 => algebraMap (Polynomial k) R₀_k (P_vec c)) '' { c : Fin 3 | P_vec c ≠ 0 }
  have hSpan_nz : Ideal.span s_nz = ⊤ := by
    let I_P : Ideal (Polynomial k) := Ideal.span {P₀, P₁, P₂}
    have hI_P_top : I_P = ⊤ := by
      by_contra h_ne
      obtain ⟨q, hq_sub⟩ := (IsPrincipalIdealRing.principal I_P).principal
      have hq_eq : I_P = Ideal.span {q} := hq_sub
      have hP₀_mem : P₀ ∈ Ideal.span {q} := by
        rw [← hq_eq]
        exact Ideal.subset_span (by simp)
      have hq_dvd_0 : q ∣ P₀ := Ideal.mem_span_singleton.mp hP₀_mem
      have hq_ne : q ≠ 0 := by
        rintro rfl
        exact hP₀_mon.ne_zero (zero_dvd_iff.mp hq_dvd_0)
      have hq_not_unit : ¬ IsUnit q := by
        intro hu
        apply h_ne
        rw [hq_eq, Ideal.span_singleton_eq_top.mpr hu]
      have hq_deg : q.degree ≠ 0 := by
        intro hdeg0
        apply hq_not_unit
        have hqC := Polynomial.eq_C_of_degree_eq_zero hdeg0
        have hc0 : q.coeff 0 ≠ 0 := by
          intro h0
          apply hq_ne
          rw [hqC, h0, map_zero]
        exact Polynomial.isUnit_iff.mpr ⟨q.coeff 0, IsUnit.mk0 _ hc0, hqC.symm⟩
      obtain ⟨b, hb_aeval⟩ := IsAlgClosed.exists_aeval_eq_zero k q hq_deg
      have hqb : q.eval b = 0 := by simpa using hb_aeval
      have hdvd_all : ∀ p ∈ ({P₀, P₁, P₂} : Set (Polynomial k)), p.eval b = 0 := by
        intro p hp
        have hp_mem : p ∈ Ideal.span {q} := by
          rw [← hq_eq]
          exact Ideal.subset_span hp
        rcases Ideal.mem_span_singleton.mp hp_mem with ⟨r, rfl⟩
        simp [hqb]
      have h0b : P₀.eval b = 0 := hdvd_all P₀ (by simp)
      have h1b : P₁.eval b = 0 := hdvd_all P₁ (by simp)
      have h2b : P₂.eval b = 0 := hdvd_all P₂ (by simp)
      rcases (hPoles_P₀ b h0b).2.1 with h1 | h2
      · exact h1 h1b
      · exact h2 h2b
    have h1_mem : (1 : Polynomial k) ∈ Ideal.span {P₀, P₁, P₂} := by
      rw [show Ideal.span {P₀, P₁, P₂} = I_P from rfl, hI_P_top]
      trivial
    rw [Ideal.mem_span_insert] at h1_mem
    rcases h1_mem with ⟨a₀, z₁, hz₁, ha₀⟩
    rw [Ideal.mem_span_insert] at hz₁
    rcases hz₁ with ⟨a₁, z₂, hz₂, rfl⟩
    rw [Ideal.mem_span_singleton'] at hz₂
    rcases hz₂ with ⟨a₂, rfl⟩
    have hterm_mem : ∀ (a : Polynomial k) (c : Fin 3),
        algebraMap (Polynomial k) R₀_k (a * P_vec c) ∈ Ideal.span s_nz := by
      intro a c
      by_cases hPc : P_vec c = 0
      · simp [hPc]
      · rw [map_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨c, hPc, rfl⟩)
    apply Ideal.eq_top_of_isUnit_mem _ _ isUnit_one
    have h1_R0 : (1 : R₀_k) =
        algebraMap (Polynomial k) R₀_k (a₀ * P_vec 0) +
        (algebraMap (Polynomial k) R₀_k (a₁ * P_vec 1) +
         algebraMap (Polynomial k) R₀_k (a₂ * P_vec 2)) := by
      rw [← map_add, ← map_add]
      have heq : a₀ * P₀ + (a₁ * P₁ + a₂ * P₂) = 1 := by
        simpa [mul_comm] using ha₀.symm
      simpa [P_vec] using (congrArg (algebraMap (Polynomial k) R₀_k) heq).symm
    rw [h1_R0]
    exact Ideal.add_mem _ (hterm_mem a₀ 0) (Ideal.add_mem _ (hterm_mem a₁ 1) (hterm_mem a₂ 2))

  
  
  
  let alg_R₀_L : Algebra R₀_k L_Sigma :=
    ((algebraMap (RatFunc k) L_Sigma).comp j_R0_RF).toAlgebra
  have hST_R₀_RF_L : IsScalarTower R₀_k (RatFunc k) L_Sigma :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST_P_R₀_L : IsScalarTower (Polynomial k) R₀_k L_Sigma :=
    IsScalarTower.of_algebraMap_eq fun p => by
      change algebraMap (Polynomial k) L_Sigma p =
        algebraMap (RatFunc k) L_Sigma (j_R0_RF (algebraMap (Polynomial k) R₀_k p))
      rw [hj_align p, ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_Sigma p]

  let B_Sigma : Type u := ↥(integralClosure R₀_k L_Sigma)
  let instCR_B : CommRing B_Sigma := inferInstance
  let instDom_B : IsDomain B_Sigma := inferInstance
  let alg_R₀_B : Algebra R₀_k B_Sigma := inferInstance
  let alg_B_L : Algebra B_Sigma L_Sigma := inferInstance
  let alg_P_B : Algebra (Polynomial k) B_Sigma :=
    ((algebraMap R₀_k B_Sigma).comp (algebraMap (Polynomial k) R₀_k)).toAlgebra
  let alg_k_B : Algebra k B_Sigma :=
    ((algebraMap R₀_k B_Sigma).comp (algebraMap k R₀_k)).toAlgebra

  have hST_k_P_B : IsScalarTower k (Polynomial k) B_Sigma :=
    IsScalarTower.of_algebraMap_eq fun c => by
      change algebraMap R₀_k B_Sigma (algebraMap k R₀_k c) =
        algebraMap R₀_k B_Sigma (algebraMap (Polynomial k) R₀_k (algebraMap k (Polynomial k) c))
      rw [← IsScalarTower.algebraMap_apply k (Polynomial k) R₀_k c]
  have hST_P_R₀_B : IsScalarTower (Polynomial k) R₀_k B_Sigma :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST_R₀_B_L : IsScalarTower R₀_k B_Sigma L_Sigma :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST_P_B_L : IsScalarTower (Polynomial k) B_Sigma L_Sigma :=
    IsScalarTower.of_algebraMap_eq fun p => by
      rw [IsScalarTower.algebraMap_apply (Polynomial k) R₀_k L_Sigma p,
        IsScalarTower.algebraMap_apply R₀_k B_Sigma L_Sigma,
        ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k B_Sigma p]

  have hIntCl_B : IsIntegralClosure B_Sigma R₀_k L_Sigma :=
    integralClosure.isIntegralClosure R₀_k L_Sigma
  have hFrac_B : IsFractionRing B_Sigma L_Sigma :=
    integralClosure.isFractionRing_of_finite_extension (RatFunc k) L_Sigma
  have hFin_B : Module.Finite R₀_k B_Sigma :=
    IsIntegralClosure.finite R₀_k (RatFunc k) L_Sigma B_Sigma

  
  
  
  have hClearPc_to_J2 : ∀ (c : Fin 3) (hPc : P_vec c ≠ 0),
      let p_c_R0 : R₀_k := algebraMap (Polynomial k) R₀_k (P_vec c)
      let p_c_B : B_Sigma := algebraMap R₀_k B_Sigma p_c_R0
      let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
        MvPolynomial.aeval (fun j : Fin 2 =>
          algebraMap (Polynomial k) (RatFunc k) (P_vec (c.succAbove j)) /
          algebraMap (Polynomial k) (RatFunc k) (P_vec c))
      let D_c : Subalgebra k (RatFunc k) := θ_c.range
      letI : Algebra ↥D_c L_Sigma :=
        ((algebraMap (RatFunc k) L_Sigma).comp D_c.val.toRingHom).toAlgebra
      ∀ (J₂ : Localization.Away p_c_B →+* L_Sigma),
        (∀ b : B_Sigma, J₂ (algebraMap B_Sigma (Localization.Away p_c_B) b) =
          algebraMap B_Sigma L_Sigma b) →
        J₂ (IsLocalization.Away.invSelf (S := Localization.Away p_c_B) p_c_B) *
          algebraMap B_Sigma L_Sigma p_c_B = 1 →
        ∀ z : L_Sigma, IsIntegral ↥D_c z → ∃ w_loc : Localization.Away p_c_B, J₂ w_loc = z := by
    intro c hPc p_c_R0 p_c_B θ_c D_c J₂ hJ₂_eq hJ₂_inv z hz
    have hCharts_c := (hCharts_Sigma c).resolve_left (fun h => hPc h.1)
    have hRange_c := hCharts_c.2.2
    have hPc_RF_ne : algebraMap (Polynomial k) (RatFunc k) (P_vec c) ≠ 0 :=
      (map_ne_zero_iff _ hPoly_RF_inj).mpr hPc
    let p_L : L_Sigma := algebraMap (Polynomial k) L_Sigma (P_vec c)
    have hp_L_eq : algebraMap B_Sigma L_Sigma p_c_B = p_L := by
      dsimp [p_c_B, p_c_R0, p_L]
      rw [← IsScalarTower.algebraMap_apply R₀_k B_Sigma L_Sigma,
        ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k L_Sigma]
    have hp_L_ne : p_L ≠ 0 := by
      dsimp [p_L]
      rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_Sigma]
      exact (map_ne_zero_iff _ (algebraMap (RatFunc k) L_Sigma).injective).mpr hPc_RF_ne
    obtain ⟨P, hP_mon, hP_eval⟩ := hz
    let d := P.natDegree
    have hcoeff_rep : ∀ i : ℕ, ∃ (n : ℕ) (Q : Polynomial k),
        (P.coeff i : RatFunc k) =
          algebraMap (Polynomial k) (RatFunc k) Q /
            (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ n := by
      intro i
      have hmem : (P.coeff i : RatFunc k) ∈ Set.range θ_c := (P.coeff i).2
      rw [hRange_c] at hmem
      rcases hmem with ⟨n, Q, _, hQ⟩
      exact ⟨n, Q, hQ⟩
    let n_fn : ℕ → ℕ := fun i => Classical.choose (hcoeff_rep i)
    let Q_fn : ℕ → Polynomial k := fun i => Classical.choose (Classical.choose_spec (hcoeff_rep i))
    have hQ_spec : ∀ i : ℕ, (P.coeff i : RatFunc k) =
        algebraMap (Polynomial k) (RatFunc k) (Q_fn i) /
          (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (n_fn i) :=
      fun i => Classical.choose_spec (Classical.choose_spec (hcoeff_rep i))
    let M : ℕ := ∑ i ∈ Finset.range d, n_fn i
    let c_poly : ℕ → Polynomial k := fun i =>
      (P_vec c) ^ (M * (d - i) - n_fn i) * Q_fn i
    let R_poly : Polynomial (Polynomial k) :=
      Polynomial.X ^ d + ∑ i ∈ Finset.range d, Polynomial.C (c_poly i) * Polynomial.X ^ i
    have hR_mon : R_poly.Monic := hMonicSum d c_poly
    have hR_eval : Polynomial.eval₂ (algebraMap (Polynomial k) L_Sigma) (p_L ^ M * z) R_poly = 0 := by
      dsimp [R_poly]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
      have hterms : ∀ i ∈ Finset.range d,
          Polynomial.eval₂ (algebraMap (Polynomial k) L_Sigma) (p_L ^ M * z)
            (Polynomial.C (c_poly i) * Polynomial.X ^ i) =
          p_L ^ (M * d) * (algebraMap ↥D_c L_Sigma (P.coeff i) * z ^ i) := by
        intro i hi
        have hi_lt : i < d := Finset.mem_range.mp hi
        have hn_le_M : n_fn i ≤ M := Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi
        have hM_le : M ≤ M * (d - i) := Nat.le_mul_of_pos_right M (Nat.sub_pos_of_lt hi_lt)
        have hn_le : n_fn i ≤ M * (d - i) := le_trans hn_le_M hM_le
        have hRF_eq : algebraMap (Polynomial k) (RatFunc k) (c_poly i) =
            (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (M * (d - i)) *
              (P.coeff i : RatFunc k) := by
          dsimp [c_poly]
          have hQ_mul : algebraMap (Polynomial k) (RatFunc k) (Q_fn i) =
              (P.coeff i : RatFunc k) *
                (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (n_fn i) := by
            symm
            rw [hQ_spec i, div_mul_cancel₀ _ (pow_ne_zero (n_fn i) hPc_RF_ne)]
          rw [map_mul, map_pow, hQ_mul]
          calc (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (M * (d - i) - n_fn i) *
                ((P.coeff i : RatFunc k) *
                  (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (n_fn i))
              = ((algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (M * (d - i) - n_fn i) *
                  (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (n_fn i)) *
                  (P.coeff i : RatFunc k) := by ring
            _ = (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^
                  (M * (d - i) - n_fn i + n_fn i) * (P.coeff i : RatFunc k) := by rw [← pow_add]
            _ = (algebraMap (Polynomial k) (RatFunc k) (P_vec c)) ^ (M * (d - i)) *
                  (P.coeff i : RatFunc k) := by rw [Nat.sub_add_cancel hn_le]
        have hL_eq : algebraMap (Polynomial k) L_Sigma (c_poly i) =
            p_L ^ (M * (d - i)) * algebraMap ↥D_c L_Sigma (P.coeff i) := by
          rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_Sigma, hRF_eq,
            map_mul, map_pow, ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_Sigma (P_vec c)]
          rfl
        have hexp : M * (d - i) + M * i = M * d := by
          rw [← mul_add, Nat.sub_add_cancel (le_of_lt hi_lt)]
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, hL_eq,
          mul_pow, ← pow_mul]
        calc (p_L ^ (M * (d - i)) * algebraMap ↥D_c L_Sigma (P.coeff i)) *
              (p_L ^ (M * i) * z ^ i)
            = (p_L ^ (M * (d - i)) * p_L ^ (M * i)) *
                (algebraMap ↥D_c L_Sigma (P.coeff i) * z ^ i) := by ring
          _ = p_L ^ (M * d) * (algebraMap ↥D_c L_Sigma (P.coeff i) * z ^ i) := by
              rw [← pow_add, hexp]
      rw [Finset.sum_congr rfl hterms, ← Finset.mul_sum, mul_pow, ← pow_mul, ← mul_add,
        hMonicEvalSplit (algebraMap ↥D_c L_Sigma) z P hP_mon hP_eval, mul_zero]
    have hInt_R₀ : IsIntegral R₀_k (p_L ^ M * z) := by
      refine ⟨R_poly.map (algebraMap (Polynomial k) R₀_k), hR_mon.map _, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp : (algebraMap R₀_k L_Sigma).comp (algebraMap (Polynomial k) R₀_k) =
          algebraMap (Polynomial k) L_Sigma :=
        RingHom.ext fun p => (IsScalarTower.algebraMap_apply (Polynomial k) R₀_k L_Sigma p).symm
      rwa [hcomp]
    let b_num : B_Sigma := ⟨p_L ^ M * z, hInt_R₀⟩
    let w_loc : Localization.Away p_c_B :=
      algebraMap B_Sigma (Localization.Away p_c_B) b_num *
        (IsLocalization.Away.invSelf (S := Localization.Away p_c_B) p_c_B) ^ M
    refine ⟨w_loc, ?_⟩
    apply mul_right_cancel₀ (pow_ne_zero M hp_L_ne)
    calc J₂ w_loc * p_L ^ M
        = (J₂ (algebraMap B_Sigma (Localization.Away p_c_B) b_num) *
            J₂ (IsLocalization.Away.invSelf (S := Localization.Away p_c_B) p_c_B) ^ M) *
            p_L ^ M := by
          dsimp [w_loc]
          rw [map_mul, map_pow]
      _ = (p_L ^ M * z) *
            (J₂ (IsLocalization.Away.invSelf (S := Localization.Away p_c_B) p_c_B) *
              algebraMap B_Sigma L_Sigma p_c_B) ^ M := by
          rw [hJ₂_eq b_num, hp_L_eq]
          change (p_L ^ M * z) * _ * p_L ^ M = _
          rw [mul_assoc, ← mul_pow]
      _ = z * p_L ^ M := by rw [hJ₂_inv, one_pow, mul_one, mul_comm]

  
  
  
  haveI hEt_B : Algebra.Etale R₀_k B_Sigma := by
    rw [← RingHom.etale_algebraMap]
    refine RingHom.Etale.ofLocalizationSpan (algebraMap R₀_k B_Sigma) s_nz hSpan_nz ?_
    rintro ⟨r_elt, c, hPc_mem, rfl⟩
    have hPc : P_vec c ≠ 0 := hPc_mem
    let p_c_R0 : R₀_k := algebraMap (Polynomial k) R₀_k (P_vec c)
    let p_c_B : B_Sigma := algebraMap R₀_k B_Sigma p_c_R0
    change @RingHom.Etale (Localization.Away p_c_R0) (Localization.Away p_c_B)
      inferInstance inferInstance (Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0)

    
    have hCharts_c := (hCharts_Sigma c).resolve_left (fun h => hPc h.1)
    have hKer_c := hCharts_c.2.1
    have hRange_c := hCharts_c.2.2
    obtain ⟨ι_c, hι_inj, hι_align, hι_range⟩ := hCharts_ι c hPc

    let A_mv := MvPolynomial (Fin 2) k
    letI alg_A_L₂ : Algebra A_mv L₂ :=
      ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
    let B₂_c := integralClosure A_mv L₂
    let f_c : A_mv := eval_c c F_disc_hom
    let h_c : A_mv := eval_c c H_Sigma
    let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A_mv ↥B₂_c h_c}
    let θ_c : A_mv →ₐ[k] RatFunc k :=
      MvPolynomial.aeval (fun j : Fin 2 =>
        algebraMap (Polynomial k) (RatFunc k) (P_vec (c.succAbove j)) /
        algebraMap (Polynomial k) (RatFunc k) (P_vec c))
    let D_c : Subalgebra k (RatFunc k) := θ_c.range
    letI alg_Dc_L : Algebra ↥D_c L_Sigma :=
      ((algebraMap (RatFunc k) L_Sigma).comp D_c.val.toRingHom).toAlgebra
    let C_c := integralClosure ↥D_c L_Sigma

    let π_c : A_mv →+* ↥D_c := θ_c.rangeRestrict.toRingHom
    have hπ_surj : Function.Surjective π_c := AlgHom.rangeRestrict_surjective θ_c
    have hπ_hc : π_c h_c = 0 := by
      apply Subtype.ext
      change θ_c h_c = 0
      have hmem : h_c ∈ RingHom.ker θ_c.toRingHom := by
        rw [hKer_c]
        exact Ideal.subset_span rfl
      exact hmem

    let d_fc : ↥D_c := π_c f_c
    let c_fc : ↥C_c := algebraMap ↥D_c ↥C_c d_fc
    let R_ch := Localization.Away f_c
    let S_ch := Localization.Away (algebraMap A_mv ↥B₂_c f_c)
    let U₁ := Localization.Away d_fc
    let V₁ := Localization.Away c_fc
    let U₂ := Localization.Away p_c_R0
    let V₂ := Localization.Away p_c_B

    
    have hEt_U1_V1 : @RingHom.Etale U₁ V₁ inferInstance inferInstance
        (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc) := by
      let toCc : (↥B₂_c ⧸ I_hc) →+* ↥C_c := {
        toFun := fun x => ⟨ι_c x, (hι_range (ι_c x)).mp ⟨x, rfl⟩⟩
        map_one' := Subtype.ext (map_one ι_c)
        map_mul' := fun x y => Subtype.ext (map_mul ι_c x y)
        map_zero' := Subtype.ext (map_zero ι_c)
        map_add' := fun x y => Subtype.ext (map_add ι_c x y)
      }
      have htoCc_bij : Function.Bijective toCc := ⟨
        fun x y hxy => hι_inj (congrArg Subtype.val hxy),
        fun z => by
          obtain ⟨x, hx⟩ := (hι_range z.1).mpr z.2
          exact ⟨x, Subtype.ext hx⟩⟩
      let e_C : (↥B₂_c ⧸ I_hc) ≃+* ↥C_c := RingEquiv.ofBijective toCc htoCc_bij
      have heC_align : ∀ g : A_mv,
          e_C (Ideal.Quotient.mk I_hc (algebraMap A_mv ↥B₂_c g)) =
            algebraMap ↥D_c ↥C_c (π_c g) := by
        intro g
        apply Subtype.ext
        exact hι_align g

      letI alg_R_S : Algebra R_ch S_ch :=
        (Localization.awayMap (algebraMap A_mv ↥B₂_c) f_c).toAlgebra
      haveI hEt_R_S : Algebra.Etale R_ch S_ch :=
        RingHom.etale_algebraMap.mp (hEtale_3charts c)
      letI alg_U1_V1 : Algebra U₁ V₁ :=
        (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc).toAlgebra
      refine RingHom.etale_algebraMap.mpr ?_

      have hu_R : IsUnit (((algebraMap ↥D_c U₁).comp π_c) f_c) :=
        IsLocalization.Away.algebraMap_isUnit (S := U₁) d_fc
      let α_R : R_ch →+* U₁ := IsLocalization.Away.lift f_c (S := R_ch) hu_R
      have hα_R_eq : ∀ g : A_mv, α_R (algebraMap A_mv R_ch g) = algebraMap ↥D_c U₁ (π_c g) :=
        IsLocalization.Away.lift_eq f_c hu_R
      letI alg_R_U1 : Algebra R_ch U₁ := α_R.toAlgebra
      haveI hEt_TP : Algebra.Etale U₁ (TensorProduct R_ch U₁ S_ch) :=
        Algebra.Etale.baseChange R_ch S_ch U₁

      let g_S : ↥B₂_c →+* V₁ :=
        (algebraMap ↥C_c V₁).comp (e_C.toRingHom.comp (Ideal.Quotient.mk I_hc))
      have hu_S : IsUnit (g_S (algebraMap A_mv ↥B₂_c f_c)) := by
        change IsUnit (algebraMap ↥C_c V₁ (e_C (Ideal.Quotient.mk I_hc (algebraMap A_mv ↥B₂_c f_c))))
        rw [heC_align f_c]
        exact IsLocalization.Away.algebraMap_isUnit (S := V₁) c_fc
      let α_S : S_ch →+* V₁ := IsLocalization.Away.lift (algebraMap A_mv ↥B₂_c f_c) (S := S_ch) hu_S
      have hα_S_eq : ∀ b : ↥B₂_c,
          α_S (algebraMap ↥B₂_c S_ch b) = algebraMap ↥C_c V₁ (e_C (Ideal.Quotient.mk I_hc b)) :=
        IsLocalization.Away.lift_eq (algebraMap A_mv ↥B₂_c f_c) hu_S

      letI alg_R_V1 : Algebra R_ch V₁ := ((algebraMap U₁ V₁).comp α_R).toAlgebra
      letI : SMul R_ch U₁ := alg_R_U1.toSMul
      letI : SMul U₁ V₁ := alg_U1_V1.toSMul
      letI : SMul R_ch V₁ := alg_R_V1.toSMul
      haveI hST_R_U1_V1 : IsScalarTower R_ch U₁ V₁ :=
        IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hα_S_comm : α_S.comp (algebraMap R_ch S_ch) = (algebraMap U₁ V₁).comp α_R := by
        apply IsLocalization.ringHom_ext (Submonoid.powers f_c)
        refine RingHom.ext fun g => ?_
        simp only [RingHom.comp_apply]
        change α_S (Localization.awayMap (algebraMap A_mv ↥B₂_c) f_c (algebraMap A_mv R_ch g)) =
          Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc (α_R (algebraMap A_mv R_ch g))
        rw [hAwayMap_eq, hα_S_eq, heC_align, hα_R_eq, hAwayMap_eq]
      let α_S_alg : S_ch →ₐ[R_ch] V₁ := {
        toRingHom := α_S
        commutes' := fun r => RingHom.congr_fun hα_S_comm r
      }
      let Φ : TensorProduct R_ch U₁ S_ch →ₐ[U₁] V₁ :=
        Algebra.TensorProduct.lift (Algebra.ofId U₁ V₁) α_S_alg (fun _ _ => mul_comm _ _)
      have hΦ_tmul : ∀ (u : U₁) (s : S_ch), Φ (u ⊗ₜ[R_ch] s) = algebraMap U₁ V₁ u * α_S s :=
        fun u s => Algebra.TensorProduct.lift_tmul (Algebra.ofId U₁ V₁) α_S_alg
          (fun _ _ => mul_comm _ _) u s

      let inr_B : ↥B₂_c →+* TensorProduct R_ch U₁ S_ch :=
        (Algebra.TensorProduct.includeRight (R := R_ch) (A := U₁) (B := S_ch)).toRingHom.comp
          (algebraMap ↥B₂_c S_ch)
      have hI_ker : ∀ b ∈ I_hc, inr_B b = 0 := by
        intro b hb
        rw [Ideal.mem_span_singleton] at hb
        rcases hb with ⟨y, rfl⟩
        rw [map_mul]
        suffices h0 : inr_B (algebraMap A_mv ↥B₂_c h_c) = 0 by
          rw [h0]
          exact zero_mul (inr_B y)
        change (Algebra.TensorProduct.includeRight (R := R_ch) (A := U₁) (B := S_ch))
          (algebraMap ↥B₂_c S_ch (algebraMap A_mv ↥B₂_c h_c)) = 0
        have hmap_hc : algebraMap ↥B₂_c S_ch (algebraMap A_mv ↥B₂_c h_c) =
            algebraMap R_ch S_ch (algebraMap A_mv R_ch h_c) :=
          (hAwayMap_eq (algebraMap A_mv ↥B₂_c) f_c h_c).symm
        rw [hmap_hc, AlgHom.commutes]
        change (α_R (algebraMap A_mv R_ch h_c)) ⊗ₜ[R_ch] (1 : S_ch) = 0
        rw [hα_R_eq h_c, hπ_hc, map_zero, TensorProduct.zero_tmul]
      let q_B := Ideal.Quotient.lift (S := TensorProduct R_ch U₁ S_ch) I_hc inr_B hI_ker
      let γ_C := q_B.comp e_C.symm.toRingHom
      have hu_γ : IsUnit (γ_C c_fc) := by
        have he_symm : e_C.symm c_fc = Ideal.Quotient.mk I_hc (algebraMap A_mv ↥B₂_c f_c) := by
          apply e_C.injective
          rw [RingEquiv.apply_symm_apply, heC_align f_c]
        change IsUnit (q_B (e_C.symm c_fc))
        rw [he_symm]
        change IsUnit (inr_B (algebraMap A_mv ↥B₂_c f_c))
        exact (IsLocalization.Away.algebraMap_isUnit (S := S_ch)
          (algebraMap A_mv ↥B₂_c f_c)).map
          (Algebra.TensorProduct.includeRight (R := R_ch) (A := U₁) (B := S_ch)).toRingHom
      let Ψ := IsLocalization.Away.lift c_fc (S := V₁) (P := TensorProduct R_ch U₁ S_ch) hu_γ
      have hΨ_eq : ∀ y : ↥C_c, Ψ (algebraMap ↥C_c V₁ y) = γ_C y :=
        IsLocalization.Away.lift_eq c_fc (S := V₁) (P := TensorProduct R_ch U₁ S_ch) hu_γ

      have hΦΨ : Φ.toRingHom.comp Ψ = RingHom.id V₁ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers c_fc)
        refine RingHom.ext fun y => ?_
        obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (e_C.symm y)
        simp only [RingHom.comp_apply, RingHom.id_apply, hΨ_eq]
        change Φ (q_B (e_C.symm y)) = algebraMap ↥C_c V₁ y
        rw [← hb]
        change Φ ((1 : U₁) ⊗ₜ[R_ch] (algebraMap ↥B₂_c S_ch b)) = algebraMap ↥C_c V₁ y
        rw [hΦ_tmul, map_one, one_mul]
        rw [hα_S_eq b, hb, RingEquiv.apply_symm_apply]

      have hΨΦ_S : (Ψ.comp Φ.toRingHom).comp
          (Algebra.TensorProduct.includeRight (R := R_ch) (A := U₁) (B := S_ch)).toRingHom =
          (Algebra.TensorProduct.includeRight (R := R_ch) (A := U₁) (B := S_ch)).toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (algebraMap A_mv ↥B₂_c f_c))
        refine RingHom.ext fun b => ?_
        simp only [RingHom.comp_apply]
        change Ψ (Φ ((1 : U₁) ⊗ₜ[R_ch] (algebraMap ↥B₂_c S_ch b))) =
          (1 : U₁) ⊗ₜ[R_ch] (algebraMap ↥B₂_c S_ch b)
        rw [hΦ_tmul, map_one, one_mul]
        rw [hα_S_eq b, hΨ_eq]
        change q_B (e_C.symm (e_C (Ideal.Quotient.mk I_hc b))) = _
        rw [RingEquiv.symm_apply_apply]
        rfl

      have hΨΦ_U : (Ψ.comp Φ.toRingHom).comp
          (algebraMap U₁ (TensorProduct R_ch U₁ S_ch)) =
          algebraMap U₁ (TensorProduct R_ch U₁ S_ch) := by
        apply IsLocalization.ringHom_ext (Submonoid.powers d_fc)
        refine RingHom.ext fun d => ?_
        obtain ⟨g, rfl⟩ := hπ_surj d
        simp only [RingHom.comp_apply]
        change Ψ (Φ ((algebraMap ↥D_c U₁ (π_c g)) ⊗ₜ[R_ch] (1 : S_ch))) =
          (algebraMap ↥D_c U₁ (π_c g)) ⊗ₜ[R_ch] (1 : S_ch)
        rw [hΦ_tmul, map_one, mul_one]
        change Ψ (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc
          (algebraMap ↥D_c U₁ (π_c g))) = _
        rw [hAwayMap_eq, ← heC_align g, hΨ_eq]
        change q_B (e_C.symm (e_C (Ideal.Quotient.mk I_hc (algebraMap A_mv ↥B₂_c g)))) = _
        rw [RingEquiv.symm_apply_apply]
        change (Algebra.TensorProduct.includeRight (R := R_ch) (A := U₁) (B := S_ch))
          (algebraMap ↥B₂_c S_ch (algebraMap A_mv ↥B₂_c g)) = _
        have hmap_g : algebraMap ↥B₂_c S_ch (algebraMap A_mv ↥B₂_c g) =
            algebraMap R_ch S_ch (algebraMap A_mv R_ch g) :=
          (hAwayMap_eq (algebraMap A_mv ↥B₂_c) f_c g).symm
        rw [hmap_g, AlgHom.commutes]
        change (α_R (algebraMap A_mv R_ch g)) ⊗ₜ[R_ch] (1 : S_ch) = _
        rw [hα_R_eq g]

      have hΨΦ : ∀ t : TensorProduct R_ch U₁ S_ch, Ψ (Φ t) = t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul u s =>
          have hdecomp : (u ⊗ₜ[R_ch] s : TensorProduct R_ch U₁ S_ch) =
              (u ⊗ₜ[R_ch] 1) * (1 ⊗ₜ[R_ch] s) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hdecomp, map_mul, map_mul]
          have hu_id := RingHom.congr_fun hΨΦ_U u
          have hs_id := RingHom.congr_fun hΨΦ_S s
          exact congrArg₂ (· * ·) hu_id hs_id
        | add x y ihx ihy =>
          rw [map_add, map_add, ihx, ihy]

      have hΦ_bij : Function.Bijective Φ := ⟨
        fun x y hxy => by rw [← hΨΦ x, ← hΨΦ y, hxy],
        fun v => ⟨Ψ v, RingHom.congr_fun hΦΨ v⟩⟩
      exact Algebra.Etale.of_equiv (R := U₁) (A := TensorProduct R_ch U₁ S_ch) (B := V₁)
        (AlgEquiv.ofBijective Φ hΦ_bij)

    
    let Pc_bar : RatFunc k := algebraMap (Polynomial k) (RatFunc k) (P_vec c)
    let Δ_bar : RatFunc k := algebraMap (Polynomial k) (RatFunc k) Δ_k
    let g_bar : RatFunc k := algebraMap (Polynomial k) (RatFunc k) g_disc
    have hPc_bar_ne : Pc_bar ≠ 0 := (map_ne_zero_iff _ hPoly_RF_inj).mpr hPc
    have hg_R0_ne : algebraMap (Polynomial k) R₀_k g_disc ≠ 0 := hUnit_gdisc.ne_zero
    have hg_bar_ne : g_bar ≠ 0 := by
      dsimp [g_bar]
      rw [← hj_align g_disc]
      exact (map_ne_zero_iff j_R0_RF hj_inj).mpr hg_R0_ne
    have hdf_val : (d_fc : RatFunc k) = g_bar / Pc_bar ^ d_disc := hθ_fdisc c hPc
    have hdf_val_ne : (d_fc : RatFunc k) ≠ 0 := by
      rw [hdf_val]
      exact div_ne_zero hg_bar_ne (pow_ne_zero d_disc hPc_bar_ne)
    have hdf_ne : d_fc ≠ 0 := fun h0 => hdf_val_ne (congrArg Subtype.val h0)
    have hpc_R0_ne : p_c_R0 ≠ 0 := by
      intro h0
      apply hPc_bar_ne
      dsimp [Pc_bar, p_c_R0] at *
      rw [← hj_align (P_vec c), h0, map_zero]
    have hcf_ne : c_fc ≠ 0 := by
      intro h0
      have hval : (c_fc : L_Sigma) = 0 := congrArg Subtype.val h0
      change algebraMap (RatFunc k) L_Sigma (d_fc : RatFunc k) = 0 at hval
      exact hdf_val_ne ((map_eq_zero_iff _ (algebraMap (RatFunc k) L_Sigma).injective).mp hval)
    have hpc_B_ne : p_c_B ≠ 0 := by
      intro h0
      have hL : algebraMap R₀_k L_Sigma p_c_R0 = 0 := by
        rw [IsScalarTower.algebraMap_apply R₀_k B_Sigma L_Sigma]
        change algebraMap B_Sigma L_Sigma p_c_B = 0
        rw [h0, map_zero]
      exact hpc_R0_ne ((map_eq_zero_iff j_R0_RF hj_inj).mp
        ((map_eq_zero_iff _ (algebraMap (RatFunc k) L_Sigma).injective).mp hL))

    obtain ⟨j₁, hj₁_inj, hj₁_eq₀, hj₁_inv₀⟩ :=
      hAwayLiftToField D_c.val.toRingHom Subtype.val_injective d_fc hdf_ne
    have hj₁_eq : ∀ a : ↥D_c, j₁ (algebraMap ↥D_c U₁ a) = (a : RatFunc k) := hj₁_eq₀
    have hj₁_inv : j₁ (IsLocalization.Away.invSelf (S := U₁) d_fc) * (d_fc : RatFunc k) = 1 :=
      hj₁_inv₀

    obtain ⟨j₂, hj₂_inj, hj₂_eq₀, hj₂_inv₀⟩ :=
      hAwayLiftToField j_R0_RF hj_inj p_c_R0 hpc_R0_ne
    have hj₂_eq : ∀ a : R₀_k, j₂ (algebraMap R₀_k U₂ a) = j_R0_RF a := hj₂_eq₀
    have hj₂_inv : j₂ (IsLocalization.Away.invSelf (S := U₂) p_c_R0) * Pc_bar = 1 := by
      simpa only [Pc_bar, p_c_R0, hj_align (P_vec c)] using hj₂_inv₀

    obtain ⟨J₁, hJ₁_inj, hJ₁_eq₀, hJ₁_inv₀⟩ :=
      hAwayLiftToField C_c.val.toRingHom Subtype.val_injective c_fc hcf_ne
    have hJ₁_eq : ∀ a : ↥C_c, J₁ (algebraMap ↥C_c V₁ a) = (a : L_Sigma) := hJ₁_eq₀
    have hJ₁_inv : J₁ (IsLocalization.Away.invSelf (S := V₁) c_fc) * (c_fc : L_Sigma) = 1 :=
      hJ₁_inv₀

    obtain ⟨J₂, hJ₂_inj, hJ₂_eq₀, hJ₂_inv₀⟩ :=
      hAwayLiftToField (algebraMap B_Sigma L_Sigma) Subtype.val_injective p_c_B hpc_B_ne
    have hJ₂_eq : ∀ a : B_Sigma, J₂ (algebraMap B_Sigma V₂ a) = (a : L_Sigma) := hJ₂_eq₀
    have hJ₂_inv : J₂ (IsLocalization.Away.invSelf (S := V₂) p_c_B) *
        algebraMap B_Sigma L_Sigma p_c_B = 1 := hJ₂_inv₀

    
    rcases hUnit_gdisc with ⟨u_g, hu_g⟩
    have hj_ug_inv : j_R0_RF (↑u_g⁻¹) * g_bar = 1 := by
      dsimp [g_bar]
      rw [← hj_align g_disc, ← hu_g, ← map_mul, Units.inv_mul, map_one]
    let df_inv_U2 : U₂ :=
      algebraMap R₀_k U₂ (p_c_R0 ^ d_disc * ↑u_g⁻¹)
    have hj₂_df_inv : j₂ df_inv_U2 = j₁ (IsLocalization.Away.invSelf (S := U₁) d_fc) := by
      apply mul_right_cancel₀ hdf_val_ne
      rw [hj₁_inv]
      dsimp [df_inv_U2]
      rw [hj₂_eq, map_mul, map_pow, hj_align (P_vec c), hdf_val]
      calc (Pc_bar ^ d_disc * j_R0_RF (↑u_g⁻¹)) * (g_bar / Pc_bar ^ d_disc)
          = j_R0_RF (↑u_g⁻¹) * (g_bar / Pc_bar ^ d_disc * Pc_bar ^ d_disc) := by ring
        _ = j_R0_RF (↑u_g⁻¹) * g_bar := by
            rw [div_mul_cancel₀ _ (pow_ne_zero d_disc hPc_bar_ne)]
        _ = 1 := hj_ug_inv

    have hj₁_in_j₂ : ∀ u : U₁, ∃ u' : U₂, j₂ u' = j₁ u := by
      intro u
      obtain ⟨⟨d, ⟨_, m, rfl⟩⟩, hdu⟩ := IsLocalization.surj (Submonoid.powers d_fc) u
      have hdu' : u * (algebraMap ↥D_c U₁ d_fc) ^ m = algebraMap ↥D_c U₁ d := by
        simpa only [map_pow] using hdu
      have hmem : (d : RatFunc k) ∈ Set.range θ_c := d.2
      rw [hRange_c] at hmem
      rcases hmem with ⟨n, Q, _, hQ⟩
      let d_U2 : U₂ := algebraMap R₀_k U₂ (algebraMap (Polynomial k) R₀_k Q) *
        (IsLocalization.Away.invSelf (S := U₂) p_c_R0) ^ n
      have hj₂_d : j₂ d_U2 = (d : RatFunc k) := by
        apply mul_right_cancel₀ (pow_ne_zero n hPc_bar_ne)
        dsimp [d_U2]
        rw [map_mul, map_pow, hj₂_eq, hj_align Q, hQ,
          div_mul_cancel₀ _ (pow_ne_zero n hPc_bar_ne)]
        calc (algebraMap (Polynomial k) (RatFunc k) Q *
              j₂ (IsLocalization.Away.invSelf (S := U₂) p_c_R0) ^ n) * Pc_bar ^ n
            = algebraMap (Polynomial k) (RatFunc k) Q *
                (j₂ (IsLocalization.Away.invSelf (S := U₂) p_c_R0) * Pc_bar) ^ n := by
              rw [mul_assoc, ← mul_pow]
          _ = algebraMap (Polynomial k) (RatFunc k) Q := by
              rw [hj₂_inv, one_pow, mul_one]
      refine ⟨d_U2 * df_inv_U2 ^ m, ?_⟩
      apply mul_right_cancel₀ (pow_ne_zero m hdf_val_ne)
      rw [map_mul, map_pow, hj₂_d, hj₂_df_inv]
      have hdu_j₁ : j₁ u * (d_fc : RatFunc k) ^ m = (d : RatFunc k) := by
        have h := congrArg j₁ hdu'
        rwa [map_mul, map_pow, hj₁_eq, hj₁_eq] at h
      calc ((d : RatFunc k) * j₁ (IsLocalization.Away.invSelf (S := U₁) d_fc) ^ m) *
            (d_fc : RatFunc k) ^ m
          = (d : RatFunc k) *
              (j₁ (IsLocalization.Away.invSelf (S := U₁) d_fc) * (d_fc : RatFunc k)) ^ m := by
            rw [mul_assoc, ← mul_pow]
        _ = (d : RatFunc k) := by rw [hj₁_inv, one_pow, mul_one]
        _ = j₁ u * (d_fc : RatFunc k) ^ m := hdu_j₁.symm

    obtain ⟨φ_base, hφ_base⟩ := hPullbackRingHom j₁ j₂ hj₂_inj hj₁_in_j₂

    have hJ₁_in_J₂ : ∀ v : V₁, ∃ v' : V₂, J₂ v' = J₁ v := by
      intro v
      obtain ⟨⟨y, ⟨_, m, rfl⟩⟩, hyv⟩ := IsLocalization.surj (Submonoid.powers c_fc) v
      have hyv' : v * (algebraMap ↥C_c V₁ c_fc) ^ m = algebraMap ↥C_c V₁ y := by
        simpa only [map_pow] using hyv
      obtain ⟨w_y, hw_y⟩ := hClearPc_to_J2 c hPc J₂ hJ₂_eq hJ₂_inv y.1 y.2
      let cf_inv_V2 : V₂ := Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0 df_inv_U2
      have hJ₂_cf_inv : J₂ cf_inv_V2 = J₁ (IsLocalization.Away.invSelf (S := V₁) c_fc) := by
        have hcf_val_ne : (c_fc : L_Sigma) ≠ 0 :=
          (map_ne_zero_iff _ (algebraMap (RatFunc k) L_Sigma).injective).mpr hdf_val_ne
        apply mul_right_cancel₀ hcf_val_ne
        rw [hJ₁_inv]
        dsimp [cf_inv_V2, df_inv_U2]
        rw [hAwayMap_eq, hJ₂_eq]
        change algebraMap R₀_k L_Sigma (p_c_R0 ^ d_disc * ↑u_g⁻¹) *
          algebraMap (RatFunc k) L_Sigma (d_fc : RatFunc k) = 1
        have hR0L : algebraMap R₀_k L_Sigma (p_c_R0 ^ d_disc * ↑u_g⁻¹) =
            algebraMap (RatFunc k) L_Sigma (j₂ df_inv_U2) := by
          dsimp [df_inv_U2]
          rw [hj₂_eq]
          rfl
        rw [hR0L, ← map_mul, hj₂_df_inv]
        change algebraMap (RatFunc k) L_Sigma
          (j₁ (IsLocalization.Away.invSelf (S := U₁) d_fc) * (d_fc : RatFunc k)) = 1
        rw [hj₁_inv, map_one]
      refine ⟨w_y * cf_inv_V2 ^ m, ?_⟩
      have hcf_val_ne : (c_fc : L_Sigma) ≠ 0 :=
        (map_ne_zero_iff _ (algebraMap (RatFunc k) L_Sigma).injective).mpr hdf_val_ne
      apply mul_right_cancel₀ (pow_ne_zero m hcf_val_ne)
      rw [map_mul, map_pow, hw_y, hJ₂_cf_inv]
      have hyv_J₁ : J₁ v * (c_fc : L_Sigma) ^ m = (y : L_Sigma) := by
        have h := congrArg J₁ hyv'
        rwa [map_mul, map_pow, hJ₁_eq, hJ₁_eq] at h
      calc ((y : L_Sigma) * J₁ (IsLocalization.Away.invSelf (S := V₁) c_fc) ^ m) *
            (c_fc : L_Sigma) ^ m
          = (y : L_Sigma) *
              (J₁ (IsLocalization.Away.invSelf (S := V₁) c_fc) * (c_fc : L_Sigma)) ^ m := by
            rw [mul_assoc, ← mul_pow]
        _ = (y : L_Sigma) := by rw [hJ₁_inv, one_pow, mul_one]
        _ = J₁ v * (c_fc : L_Sigma) ^ m := hyv_J₁.symm

    obtain ⟨φ_top, hφ_top⟩ := hPullbackRingHom J₁ J₂ hJ₂_inj hJ₁_in_J₂

    have hSquare_comm : φ_top.comp (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc) =
        (Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0).comp φ_base := by
      have hJ₂_away : J₂.comp (Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0) =
          (algebraMap (RatFunc k) L_Sigma).comp j₂ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers p_c_R0)
        refine RingHom.ext fun r => ?_
        simp only [RingHom.comp_apply]
        change J₂ (Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0
          (algebraMap R₀_k U₂ r)) = algebraMap (RatFunc k) L_Sigma (j₂ (algebraMap R₀_k U₂ r))
        rw [hAwayMap_eq, hJ₂_eq, hj₂_eq]
        rfl
      have hJ₁_away : J₁.comp (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc) =
          (algebraMap (RatFunc k) L_Sigma).comp j₁ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers d_fc)
        refine RingHom.ext fun d => ?_
        simp only [RingHom.comp_apply]
        change J₁ (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc
          (algebraMap ↥D_c U₁ d)) = algebraMap (RatFunc k) L_Sigma (j₁ (algebraMap ↥D_c U₁ d))
        rw [hAwayMap_eq, hJ₁_eq, hj₁_eq]
        rfl
      refine RingHom.ext fun u => ?_
      apply hJ₂_inj
      calc J₂ (φ_top (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc u))
          = J₁ (Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc u) := hφ_top _
        _ = algebraMap (RatFunc k) L_Sigma (j₁ u) := RingHom.congr_fun hJ₁_away u
        _ = algebraMap (RatFunc k) L_Sigma (j₂ (φ_base u)) := by rw [← hφ_base u]
        _ = J₂ (Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0 (φ_base u)) :=
            (RingHom.congr_fun hJ₂_away (φ_base u)).symm

    
    let N_S : ℕ := S_aff_k.card
    let s_rat : RatFunc k := Δ_bar / Pc_bar ^ (N_S + 1)
    have hs_mem : s_rat ∈ D_c := by
      change s_rat ∈ Set.range θ_c
      rw [hRange_c]
      refine ⟨N_S + 1, Δ_k, ?_, rfl⟩
      rw [hΔ_deg]
      exact le_trans (Nat.le_succ N_S) (Nat.le_mul_of_pos_right (N_S + 1) hd_Sigma)
    let d_sc : ↥D_c := ⟨s_rat, hs_mem⟩
    let u_sc : U₁ := algebraMap ↥D_c U₁ d_sc
    let v_sc : V₁ := Localization.awayMap (algebraMap ↥D_c ↥C_c) d_fc u_sc

    have hBaseClear : ∀ u : U₂, ∃ n : ℕ, j₂ u * s_rat ^ n ∈ D_c := by
      intro u
      obtain ⟨⟨r₀, ⟨_, a, rfl⟩⟩, hur₀⟩ := IsLocalization.surj (Submonoid.powers p_c_R0) u
      have hur₀' : u * (algebraMap R₀_k U₂ p_c_R0) ^ a = algebraMap R₀_k U₂ r₀ := by
        simpa only [map_pow] using hur₀
      obtain ⟨⟨Q, ⟨_, b, rfl⟩⟩, hQr₀⟩ := IsLocalization.surj (Submonoid.powers Δ_k) r₀
      have hQr₀' : r₀ * (algebraMap (Polynomial k) R₀_k Δ_k) ^ b =
          algebraMap (Polynomial k) R₀_k Q := by
        simpa only [map_pow] using hQr₀
      have hu_eq : j₂ u * (Pc_bar ^ a * Δ_bar ^ b) = algebraMap (Polynomial k) (RatFunc k) Q := by
        have h1 : j₂ u * Pc_bar ^ a = j_R0_RF r₀ := by
          have h := congrArg j₂ hur₀'
          rwa [map_mul, map_pow, hj₂_eq, hj₂_eq, hj_align (P_vec c)] at h
        have h2 : j_R0_RF r₀ * Δ_bar ^ b = algebraMap (Polynomial k) (RatFunc k) Q := by
          have h := congrArg j_R0_RF hQr₀'
          rwa [map_mul, map_pow, hj_align, hj_align] at h
        rw [← mul_assoc, h1, h2]
      let n : ℕ := b + Q.natDegree
      let Q_num : Polynomial k := Q * Δ_k ^ Q.natDegree
      let m_den : ℕ := a + n * (N_S + 1)
      refine ⟨n, ?_⟩
      change j₂ u * s_rat ^ n ∈ Set.range θ_c
      rw [hRange_c]
      refine ⟨m_den, Q_num, ?_, ?_⟩
      · have hdeg_num : Q_num.natDegree ≤ Q.natDegree * (N_S + 1) := by
          calc Q_num.natDegree
              ≤ Q.natDegree + (Δ_k ^ Q.natDegree).natDegree := Polynomial.natDegree_mul_le
            _ ≤ Q.natDegree + Q.natDegree * Δ_k.natDegree :=
                Nat.add_le_add_left (Polynomial.natDegree_pow_le) _
            _ = Q.natDegree * (N_S + 1) := by rw [hΔ_deg]; ring
        have hle_m : Q.natDegree * (N_S + 1) ≤ m_den := by
          dsimp [m_den, n]
          exact le_trans (Nat.mul_le_mul_right (N_S + 1) (Nat.le_add_left _ _))
            (Nat.le_add_left _ _)
        exact le_trans hdeg_num (le_trans hle_m (Nat.le_mul_of_pos_right m_den hd_Sigma))
      · rw [eq_div_iff (pow_ne_zero m_den hPc_bar_ne)]
        have hs_cancel : s_rat ^ n * Pc_bar ^ m_den = Δ_bar ^ n * Pc_bar ^ a := by
          calc s_rat ^ n * Pc_bar ^ m_den
              = (Δ_bar ^ n / (Pc_bar ^ (N_S + 1)) ^ n) *
                  (Pc_bar ^ (n * (N_S + 1)) * Pc_bar ^ a) := by
                dsimp only [s_rat, m_den]
                rw [div_pow, add_comm a, pow_add Pc_bar (n * (N_S + 1)) a]
            _ = (Δ_bar ^ n / Pc_bar ^ (n * (N_S + 1)) * Pc_bar ^ (n * (N_S + 1))) *
                  Pc_bar ^ a := by
                rw [← pow_mul, mul_comm (N_S + 1) n, ← mul_assoc]
            _ = Δ_bar ^ n * Pc_bar ^ a := by
                rw [div_mul_cancel₀ _ (pow_ne_zero (n * (N_S + 1)) hPc_bar_ne)]
        have hΔ_split : Δ_bar ^ n = Δ_bar ^ b * Δ_bar ^ Q.natDegree := by
          dsimp [n]
          rw [pow_add]
        calc j₂ u * s_rat ^ n * Pc_bar ^ m_den
            = j₂ u * (s_rat ^ n * Pc_bar ^ m_den) := mul_assoc _ _ _
          _ = j₂ u * (Δ_bar ^ b * Δ_bar ^ Q.natDegree * Pc_bar ^ a) := by
              rw [hs_cancel, hΔ_split]
          _ = (j₂ u * (Pc_bar ^ a * Δ_bar ^ b)) * Δ_bar ^ Q.natDegree := by ring
          _ = algebraMap (Polynomial k) (RatFunc k) Q_num := by
              rw [hu_eq]
              dsimp [Q_num, Δ_bar]
              rw [map_mul, map_pow]

    have hu_sc_unit : IsUnit (φ_base u_sc) := by
      rcases IsLocalization.Away.algebraMap_isUnit (S := R₀_k) Δ_k with ⟨u_Δ, hu_Δ⟩
      let w_inv : U₂ := algebraMap R₀_k U₂ (↑u_Δ⁻¹ * p_c_R0 ^ (N_S + 1))
      have hmul_one : φ_base u_sc * w_inv = 1 := by
        apply hj₂_inj
        rw [map_mul, map_one, hφ_base u_sc, hj₁_eq d_sc, hj₂_eq, map_mul, map_pow,
          hj_align (P_vec c)]
        have hj_uΔ : j_R0_RF (↑u_Δ⁻¹) * Δ_bar = 1 := by
          dsimp [Δ_bar]
          rw [← hj_align Δ_k, ← hu_Δ, ← map_mul, Units.inv_mul, map_one]
        change s_rat * (j_R0_RF (↑u_Δ⁻¹) * Pc_bar ^ (N_S + 1)) = 1
        dsimp [s_rat]
        calc (Δ_bar / Pc_bar ^ (N_S + 1)) * (j_R0_RF (↑u_Δ⁻¹) * Pc_bar ^ (N_S + 1))
            = j_R0_RF (↑u_Δ⁻¹) * (Δ_bar / Pc_bar ^ (N_S + 1) * Pc_bar ^ (N_S + 1)) := by ring
          _ = j_R0_RF (↑u_Δ⁻¹) * Δ_bar := by
              rw [div_mul_cancel₀ _ (pow_ne_zero (N_S + 1) hPc_bar_ne)]
          _ = 1 := hj_uΔ
      exact ⟨⟨φ_base u_sc, w_inv, hmul_one, mul_comm (φ_base u_sc) w_inv ▸ hmul_one⟩, rfl⟩

    letI alg_U1_U2 : Algebra U₁ U₂ := φ_base.toAlgebra
    haveI hLoc_U2 : IsLocalization.Away u_sc U₂ := {
      map_units := by
        rintro ⟨_, k_exp, rfl⟩
        change IsUnit (φ_base (u_sc ^ k_exp))
        rw [map_pow]
        exact hu_sc_unit.pow k_exp
      surj := fun u => by
        obtain ⟨n, hn_mem⟩ := hBaseClear u
        let d_num : ↥D_c := ⟨j₂ u * s_rat ^ n, hn_mem⟩
        refine ⟨⟨algebraMap ↥D_c U₁ d_num, ⟨u_sc ^ n, n, rfl⟩⟩, ?_⟩
        apply hj₂_inj
        change j₂ (u * φ_base (u_sc ^ n)) = j₂ (φ_base (algebraMap ↥D_c U₁ d_num))
        rw [map_mul, map_pow, map_pow, hφ_base u_sc, hφ_base, hj₁_eq d_sc, hj₁_eq d_num]
      exists_of_eq := fun {x y} hxy => ⟨1, by
        change φ_base x = φ_base y at hxy
        have hx : j₁ x = j₁ y := by rw [← hφ_base x, ← hφ_base y, hxy]
        simp [hj₁_inj hx]⟩
    }

    letI alg_V1_V2 : Algebra V₁ V₂ := φ_top.toAlgebra
    have hv_sc_unit : IsUnit (φ_top v_sc) := by
      have hcomm_u : φ_top v_sc =
          Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0 (φ_base u_sc) :=
        RingHom.congr_fun hSquare_comm u_sc
      rw [hcomm_u]
      exact hu_sc_unit.map (Localization.awayMap (algebraMap R₀_k B_Sigma) p_c_R0)

    haveI hLoc_V2 : IsLocalization.Away v_sc V₂ := {
      map_units := by
        rintro ⟨_, k_exp, rfl⟩
        change IsUnit (φ_top (v_sc ^ k_exp))
        rw [map_pow]
        exact hv_sc_unit.pow k_exp
      surj := fun v => by
        obtain ⟨⟨b_elt, ⟨_, a, rfl⟩⟩, hvb⟩ := IsLocalization.surj (Submonoid.powers p_c_B) v
        have hvb' : v * (algebraMap B_Sigma V₂ p_c_B) ^ a = algebraMap B_Sigma V₂ b_elt := by
          simpa only [map_pow] using hvb
        obtain ⟨P, hP_mon, hP_eval⟩ := b_elt.2
        let d := P.natDegree
        let p_L : L_Sigma := algebraMap (Polynomial k) L_Sigma (P_vec c)
        have hp_L_eq : (p_c_B : L_Sigma) = p_L := by
          change algebraMap B_Sigma L_Sigma p_c_B = p_L
          dsimp [p_c_B, p_c_R0, p_L]
          rw [← IsScalarTower.algebraMap_apply R₀_k B_Sigma L_Sigma,
            ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k L_Sigma]
        have hp_L_ne : p_L ≠ 0 := by
          dsimp [p_L]
          rw [IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_Sigma]
          exact (map_ne_zero_iff _ (algebraMap (RatFunc k) L_Sigma).injective).mpr hPc_bar_ne
        have hv_eq : J₂ v * p_L ^ a = (b_elt : L_Sigma) := by
          have h := congrArg J₂ hvb'
          rwa [map_mul, map_pow, hJ₂_eq, hJ₂_eq, hp_L_eq] at h
        let u_coeff : ℕ → U₂ := fun i =>
          algebraMap R₀_k U₂ (P.coeff i) *
            (IsLocalization.Away.invSelf (S := U₂) p_c_R0) ^ (a * (d - i))
        let n_fn : ℕ → ℕ := fun i => Classical.choose (hBaseClear (u_coeff i))
        have hn_spec : ∀ i : ℕ, j₂ (u_coeff i) * s_rat ^ (n_fn i) ∈ D_c :=
          fun i => Classical.choose_spec (hBaseClear (u_coeff i))
        let N : ℕ := ∑ i ∈ Finset.range d, n_fn i
        have hd_coeff_mem : ∀ i : ℕ,
            (if i < d then j₂ (u_coeff i) * s_rat ^ (N * (d - i)) else 0) ∈ D_c := by
          intro i
          split_ifs with hi_lt
          · have hn_le : n_fn i ≤ N * (d - i) :=
              le_trans (Finset.single_le_sum (fun _ _ => Nat.zero_le _)
                (Finset.mem_range.mpr hi_lt))
                (Nat.le_mul_of_pos_right N (Nat.sub_pos_of_lt hi_lt))
            have hpow : j₂ (u_coeff i) * s_rat ^ (N * (d - i)) =
                (j₂ (u_coeff i) * s_rat ^ (n_fn i)) * s_rat ^ (N * (d - i) - n_fn i) := by
              rw [mul_assoc, ← pow_add, Nat.add_sub_of_le hn_le]
            rw [hpow]
            exact D_c.mul_mem (hn_spec i) (D_c.pow_mem hs_mem _)
          · exact D_c.zero_mem
        let d_coeff : ℕ → ↥D_c := fun i => ⟨_, hd_coeff_mem i⟩
        let Q_poly : Polynomial ↥D_c :=
          Polynomial.X ^ d + ∑ i ∈ Finset.range d, Polynomial.C (d_coeff i) * Polynomial.X ^ i
        have hQ_mon : Q_poly.Monic := hMonicSum d d_coeff
        let s_L : L_Sigma := algebraMap (RatFunc k) L_Sigma s_rat
        have hQ_eval : Polynomial.eval₂ (algebraMap ↥D_c L_Sigma) (s_L ^ N * J₂ v) Q_poly = 0 := by
          apply mul_left_cancel₀ (pow_ne_zero (a * d) hp_L_ne)
          rw [mul_zero]
          dsimp [Q_poly]
          rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum,
            mul_add, Finset.mul_sum]
          have hlead : p_L ^ (a * d) * (s_L ^ N * J₂ v) ^ d =
              s_L ^ (N * d) * (b_elt : L_Sigma) ^ d := by
            rw [mul_pow, ← pow_mul, ← hv_eq, mul_pow, ← pow_mul, mul_comm (a : ℕ) d]
            ring
          have hterms : ∀ i ∈ Finset.range d,
              p_L ^ (a * d) * Polynomial.eval₂ (algebraMap ↥D_c L_Sigma) (s_L ^ N * J₂ v)
                (Polynomial.C (d_coeff i) * Polynomial.X ^ i) =
              s_L ^ (N * d) * (algebraMap R₀_k L_Sigma (P.coeff i) * (b_elt : L_Sigma) ^ i) := by
            intro i hi
            have hi_lt : i < d := Finset.mem_range.mp hi
            have hju_clear : j₂ (u_coeff i) * Pc_bar ^ (a * (d - i)) = j_R0_RF (P.coeff i) := by
              dsimp [u_coeff]
              rw [map_mul, map_pow, hj₂_eq, mul_assoc, ← mul_pow, hj₂_inv, one_pow, mul_one]
            have hL_clear : algebraMap (RatFunc k) L_Sigma (j₂ (u_coeff i)) *
                p_L ^ (a * (d - i)) = algebraMap R₀_k L_Sigma (P.coeff i) := by
              have hp_RF : p_L = algebraMap (RatFunc k) L_Sigma Pc_bar :=
                IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_Sigma (P_vec c)
              rw [hp_RF, ← map_pow, ← map_mul, hju_clear]
              rfl
            have hdc_L : algebraMap ↥D_c L_Sigma (d_coeff i) =
                algebraMap (RatFunc k) L_Sigma (j₂ (u_coeff i)) * s_L ^ (N * (d - i)) := by
              change algebraMap (RatFunc k) L_Sigma (if i < d then _ else 0) = _
              simp only [hi_lt, ↓reduceIte, map_mul, map_pow]
              rfl
            have hexp_a : a * d = a * (d - i) + a * i := by
              rw [← mul_add, Nat.sub_add_cancel (le_of_lt hi_lt)]
            have hexp_N : N * (d - i) + N * i = N * d := by
              rw [← mul_add, Nat.sub_add_cancel (le_of_lt hi_lt)]
            rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, hdc_L,
              hexp_a, pow_add, mul_pow, ← pow_mul]
            calc (p_L ^ (a * (d - i)) * p_L ^ (a * i)) *
                  ((algebraMap (RatFunc k) L_Sigma (j₂ (u_coeff i)) * s_L ^ (N * (d - i))) *
                    (s_L ^ (N * i) * J₂ v ^ i))
                = (s_L ^ (N * (d - i)) * s_L ^ (N * i)) *
                    ((algebraMap (RatFunc k) L_Sigma (j₂ (u_coeff i)) * p_L ^ (a * (d - i))) *
                      (J₂ v ^ i * p_L ^ (a * i))) := by ring
