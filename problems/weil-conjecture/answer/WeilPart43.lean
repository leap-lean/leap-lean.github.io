              have hx_top : x ∈ (((TopologicalSpace.Opens.map h_U.base).obj U_Y) ⊔ W₀) := by
                rw [hW₀_top]; trivial
              rcases TopologicalSpace.Opens.mem_sup.mp hx_top with hxU | hxW
              · have hx_rng : h_U.base x ∈ Set.range ι_Y.base := hRange_ιY.symm ▸ hxU
                rcases hx_rng with ⟨v_pt, hv_pt⟩
                obtain ⟨y, hy_fst, _⟩ :=
                  AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x v_pt hv_pt.symm
                let p : C_vec × C_vec := (f₁ y, f₂ y)
                refine ⟨obj_add (Sum.inr p), mor_add (Sum.inr p), ⟨y, ⟨rfl, rfl⟩⟩,
                  ⟨obj_add (Sum.inr p), 𝟙 _, mor_add (Sum.inr p), ⟨Sum.inr p⟩,
