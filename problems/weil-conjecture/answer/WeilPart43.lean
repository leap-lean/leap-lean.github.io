                  inferInstance inferInstance
              · refine ⟨obj_add (Sum.inl ()), mor_add (Sum.inl ()), ⟨x, hxW⟩,
                  ⟨obj_add (Sum.inl ()), 𝟙 _, mor_add (Sum.inl ()), ⟨Sum.inl ()⟩,
