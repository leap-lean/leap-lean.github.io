  have _ : CategoryTheory.Limits.PreservesFiniteColimits E_S :=
    CategoryTheory.Limits.comp_preservesFiniteColimits _ _
  have _ : E_S.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products E_S
  have hSE_step : ∀ {A₁ A₂ A₃ : AddCommGrpCat.{0}} (f : A₁ ⟶ A₂) (g : A₂ ⟶ A₃)
      (h0 : f ≫ g = 0),
      Function.Injective f.hom →
      Function.Surjective g.hom →
      (∀ x₂ : A₂, g.hom x₂ = 0 → ∃ x₁ : A₁, f.hom x₁ = x₂) →
      Subsingleton ((E_S.obj A₁).H 1) →
      Subsingleton ((E_S.obj A₃).H 1) →
      Subsingleton ((E_S.obj A₂).H 1) := by
    intro A₁ A₂ A₃ f g h0 hf_inj hg_surj hex hSub1 hSub3
    have _ : CategoryTheory.Mono f := ConcreteCategory.mono_of_injective f hf_inj
    have _ : CategoryTheory.Epi g := ConcreteCategory.epi_of_surjective g hg_surj
    have hEx : (CategoryTheory.ShortComplex.mk f g h0).Exact := by
