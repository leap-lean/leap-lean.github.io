theorem weil_mid_dev_konig_quotient_padic_tower_module (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H₁ H₂ : ℕ → Type u) [∀ r, AddCommGroup (H₁ r)] [∀ r, AddCommGroup (H₂ r)]
    (τ₁ : ∀ r : ℕ, H₁ (r + 1) →+ H₁ r)
    (τ₂ : ∀ r : ℕ, H₂ (r + 1) →+ H₂ r)
    (f₁ : ∀ r : ℕ, H₁ r →+ H₁ r)
    (f₂ : ∀ r : ℕ, H₂ r →+ H₂ r)
    (q : ∀ r : ℕ, H₁ r →+ H₂ r)
    (sys₁ : AddSubgroup (∀ r : ℕ, H₁ r))
    (sys₂ : AddSubgroup (∀ r : ℕ, H₂ r))
    (V₁ : Type u) [AddCommGroup V₁] [Module (Padic ℓ) V₁] [Module.Finite (Padic ℓ) V₁]
    (frob₁ : V₁ →ₗ[Padic ℓ] V₁)
    (equiv₁ : TensorProduct ℤ ℚ ↥sys₁ ≃+ V₁)
    (hTors₁ : ∀ (r : ℕ) (w : H₁ r), (ℓ ^ (r + 1)) • w = 0)
    (hTors₂ : ∀ (r : ℕ) (w : H₂ r), (ℓ ^ (r + 1)) • w = 0)
    (hFin₁ : ∀ r : ℕ, Finite (H₁ r))
    (hq_surj : ∀ r : ℕ, Function.Surjective (q r))
    (hq_τ : ∀ (r : ℕ) (x : H₁ (r + 1)), q r (τ₁ r x) = τ₂ r (q (r + 1) x))
    (hq_f : ∀ (r : ℕ) (x : H₁ r), q r (f₁ r x) = f₂ r (q r x))
    (hf₁_τ : ∀ (r : ℕ) (x : H₁ (r + 1)), τ₁ r (f₁ (r + 1) x) = f₁ r (τ₁ r x))
    (hsys₁ : ∀ x : (∀ r : ℕ, H₁ r), x ∈ sys₁ ↔ ∀ r : ℕ, τ₁ r (x (r + 1)) = x r)
    (hsys₂ : ∀ y : (∀ r : ℕ, H₂ r), y ∈ sys₂ ↔ ∀ r : ℕ, τ₂ r (y (r + 1)) = y r)
    (hsmul₁ : ∀ (z : PadicInt ℓ) (x y : ↥sys₁),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
        equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))
    (hfrob₁ : ∀ (x y : ↥sys₁),
      (∀ r : ℕ, y.1 r = f₁ r (x.1 r)) →
        frob₁ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y)) :
    (∀ r : ℕ, Finite (H₂ r)) ∧
    ∃ (V₂ : Type u) (_ : AddCommGroup V₂) (_ : Module (Padic ℓ) V₂)
      (_ : Module.Finite (Padic ℓ) V₂)
      (frob₂ : V₂ →ₗ[Padic ℓ] V₂)
      (equiv₂ : TensorProduct ℤ ℚ ↥sys₂ ≃+ V₂),
      (∀ (z : PadicInt ℓ) (x y : ↥sys₂),
        (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
          equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y) =
            (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) ∧
      (∀ (x y : ↥sys₂),
        (∀ r : ℕ, y.1 r = f₂ r (x.1 r)) →
          frob₂ (equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
            equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y)) :=
by
  classical
  let _ := frob₁
  let _ := hfrob₁
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne_zero : ℓ ≠ 0 := hPrime.ne_zero
  
  have hFin₂ : ∀ r : ℕ, Finite (H₂ r) := fun r => by
    have : Finite (H₁ r) := hFin₁ r
    exact Finite.of_surjective (q r) (hq_surj r)
  have hf₂_τ : ∀ (r : ℕ) (y : H₂ (r + 1)), τ₂ r (f₂ (r + 1) y) = f₂ r (τ₂ r y) := by
    intro r y
    obtain ⟨x, rfl⟩ := hq_surj (r + 1) y
    rw [← hq_f (r + 1) x, ← hq_τ r (f₁ (r + 1) x), hf₁_τ r x, hq_f r (τ₁ r x), hq_τ r x]
  
  have hMod_nsmul : ∀ {A : Type u} [AddCommGroup A] {N : ℕ} (w : A),
      N • w = 0 → ∀ k : ℕ, (k % N) • w = k • w := by
    intro A _ N w hNw k
    conv_rhs => rw [← Nat.div_add_mod k N]
    rw [add_nsmul, mul_comm N (k / N), mul_smul, hNw, smul_zero, zero_add]
  have hzmod_mod : ∀ (r : ℕ) (z : PadicInt ℓ),
      (PadicInt.toZModPow (r + 1) z).val =
        (PadicInt.toZModPow (r + 2) z).val % (ℓ ^ (r + 1)) := by
    intro r z
    have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne_zero⟩
    have hcomp := RingHom.congr_fun
      (PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2) (Nat.le_succ (r + 1))) z
    rw [RingHom.comp_apply] at hcomp
    rw [← hcomp, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
  have hz_mem₁ : ∀ (z : PadicInt ℓ) (x : ↥sys₁),
      (fun r : ℕ => (PadicInt.toZModPow (r + 1) z).val • x.1 r) ∈ sys₁ := by
    intro z x
    rw [hsys₁]
    intro r
    rw [map_nsmul, (hsys₁ x.1).mp x.2 r, hzmod_mod r z,
      hMod_nsmul (x.1 r) (hTors₁ r (x.1 r))]
  have hz_mem₂ : ∀ (z : PadicInt ℓ) (x : ↥sys₂),
      (fun r : ℕ => (PadicInt.toZModPow (r + 1) z).val • x.1 r) ∈ sys₂ := by
    intro z x
    rw [hsys₂]
    intro r
    rw [map_nsmul, (hsys₂ x.1).mp x.2 r, hzmod_mod r z,
      hMod_nsmul (x.1 r) (hTors₂ r (x.1 r))]
  let instSMul₂ : SMul (PadicInt ℓ) ↥sys₂ :=
    ⟨fun z x => ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, hz_mem₂ z x⟩⟩
  let _ : SMul (PadicInt ℓ) ↥sys₂ := instSMul₂
  let instMod₂ : Module (PadicInt ℓ) ↥sys₂ :=
    { one_smul := fun x => Subtype.ext <| funext fun r => by
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne_zero⟩
        have hval1 : (1 : ZMod (ℓ ^ (r + 1))).val = 1 % (ℓ ^ (r + 1)) := by
          rw [← Nat.cast_one (R := ZMod (ℓ ^ (r + 1))), ZMod.val_natCast]
        change (PadicInt.toZModPow (r + 1) 1).val • x.1 r = x.1 r
        rw [map_one, hval1, hMod_nsmul (x.1 r) (hTors₂ r (x.1 r)), one_nsmul]
      mul_smul := fun z₁ z₂ x => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow (r + 1) (z₁ * z₂)).val • x.1 r =
          (PadicInt.toZModPow (r + 1) z₁).val • ((PadicInt.toZModPow (r + 1) z₂).val • x.1 r)
        rw [map_mul, ZMod.val_mul, hMod_nsmul (x.1 r) (hTors₂ r (x.1 r)), mul_smul]
      smul_zero := fun z => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow (r + 1) z).val • (0 : H₂ r) = 0
        exact nsmul_zero _
      smul_add := fun z x₁ x₂ => Subtype.ext <| funext fun r => by
        change (PadicInt.toZModPow (r + 1) z).val • (x₁.1 r + x₂.1 r) =
          (PadicInt.toZModPow (r + 1) z).val • x₁.1 r +
            (PadicInt.toZModPow (r + 1) z).val • x₂.1 r
        exact nsmul_add _ _ _
      add_smul := fun z₁ z₂ x => Subtype.ext <| funext fun r => by
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne_zero⟩
        change (PadicInt.toZModPow (r + 1) (z₁ + z₂)).val • x.1 r =
          (PadicInt.toZModPow (r + 1) z₁).val • x.1 r +
            (PadicInt.toZModPow (r + 1) z₂).val • x.1 r
        rw [map_add, ZMod.val_add, hMod_nsmul (x.1 r) (hTors₂ r (x.1 r)), add_nsmul]
      zero_smul := fun x => Subtype.ext <| funext fun r => by
        have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hℓ_ne_zero⟩
        change (PadicInt.toZModPow (r + 1) 0).val • x.1 r = 0
        rw [map_zero, ZMod.val_zero, zero_nsmul] }
  let _ : Module (PadicInt ℓ) ↥sys₂ := instMod₂
  have hf₂_mem : ∀ x : ↥sys₂, (fun r : ℕ => f₂ r (x.1 r)) ∈ sys₂ := by
    intro x
    rw [hsys₂]
    intro r
    rw [hf₂_τ r (x.1 (r + 1)), (hsys₂ x.1).mp x.2 r]
  let frob_sys₂ : ↥sys₂ →ₗ[PadicInt ℓ] ↥sys₂ :=
    { toFun := fun x => ⟨fun r => f₂ r (x.1 r), hf₂_mem x⟩
      map_add' := fun x₁ x₂ => Subtype.ext <| funext fun r => map_add (f₂ r) (x₁.1 r) (x₂.1 r)
      map_smul' := fun z x => Subtype.ext <| funext fun r => by
        change f₂ r ((PadicInt.toZModPow (r + 1) z).val • x.1 r) =
          (PadicInt.toZModPow (r + 1) z).val • f₂ r (x.1 r)
        exact map_nsmul (f₂ r) _ _ }
  
  let S := ↥sys₂
  let V₂ : Type u := TensorProduct (PadicInt ℓ) (Padic ℓ) S
  let Φ_right : ℚ → (S →ₗ[ℤ] V₂) := fun q_rat =>
    (AddMonoidHom.mk' (fun x : S => TensorProduct.tmul (PadicInt ℓ) (q_rat : Padic ℓ) x)
      (fun x₁ x₂ => TensorProduct.tmul_add (q_rat : Padic ℓ) x₁ x₂)).toIntLinearMap
  let Φ_bilin : ℚ →ₗ[ℤ] (S →ₗ[ℤ] V₂) :=
    (AddMonoidHom.mk' Φ_right (fun q₁ q₂ => by
      ext x
      simp only [Φ_right, AddMonoidHom.coe_toIntLinearMap, AddMonoidHom.mk'_apply,
        LinearMap.add_apply, Rat.cast_add, TensorProduct.add_tmul])).toIntLinearMap
  let Φ : TensorProduct ℤ ℚ S →ₗ[ℤ] V₂ := TensorProduct.lift Φ_bilin
  have hΦ_tmul : ∀ (q_rat : ℚ) (x : S),
      Φ (TensorProduct.tmul ℤ q_rat x) = TensorProduct.tmul (PadicInt ℓ) (q_rat : Padic ℓ) x :=
    fun _ _ => rfl
  let z_lin : PadicInt ℓ → (S →ₗ[ℤ] S) := fun z =>
    (AddMonoidHom.mk' (fun x : S => z • x) (fun x₁ x₂ => smul_add z x₁ x₂)).toIntLinearMap
  let z_act_fun : PadicInt ℓ → (TensorProduct ℤ ℚ S →ₗ[ℤ] TensorProduct ℤ ℚ S) :=
    fun z => LinearMap.lTensor ℚ (z_lin z)
  let z_act_ringHom : PadicInt ℓ →+* (TensorProduct ℤ ℚ S →ₗ[ℤ] TensorProduct ℤ ℚ S) :=
    { toFun := z_act_fun
      map_one' := by
        apply LinearMap.ext; intro t
        refine TensorProduct.inductionOn (motive := fun t => z_act_fun 1 t = t) t
          (fun q_rat x => ?_) (fun t₁ t₂ ih₁ ih₂ => ?_)
        · change TensorProduct.tmul ℤ q_rat ((1 : PadicInt ℓ) • x) = TensorProduct.tmul ℤ q_rat x
          rw [one_smul]
        · rw [map_add, ih₁, ih₂]
      map_mul' := fun z₁ z₂ => by
        apply LinearMap.ext; intro t
        refine TensorProduct.inductionOn
          (motive := fun t => z_act_fun (z₁ * z₂) t = (z_act_fun z₁ * z_act_fun z₂) t) t
          (fun q_rat x => ?_) (fun t₁ t₂ ih₁ ih₂ => ?_)
        · change TensorProduct.tmul ℤ q_rat ((z₁ * z₂) • x) =
            TensorProduct.tmul ℤ q_rat (z₁ • (z₂ • x))
          rw [mul_smul]
        · rw [map_add, map_add, ih₁, ih₂]
      map_zero' := by
        apply LinearMap.ext; intro t
        refine TensorProduct.inductionOn (motive := fun t => z_act_fun 0 t = 0) t
          (fun q_rat x => ?_) (fun t₁ t₂ ih₁ ih₂ => ?_)
        · change TensorProduct.tmul ℤ q_rat ((0 : PadicInt ℓ) • x) = 0
          rw [zero_smul, TensorProduct.tmul_zero]
        · rw [map_add, ih₁, ih₂, add_zero]
      map_add' := fun z₁ z₂ => by
        apply LinearMap.ext; intro t
        refine TensorProduct.inductionOn
          (motive := fun t => z_act_fun (z₁ + z₂) t = (z_act_fun z₁ + z_act_fun z₂) t) t
          (fun q_rat x => ?_) (fun t₁ t₂ ih₁ ih₂ => ?_)
        · change TensorProduct.tmul ℤ q_rat ((z₁ + z₂) • x) =
            TensorProduct.tmul ℤ q_rat (z₁ • x) + TensorProduct.tmul ℤ q_rat (z₂ • x)
          rw [add_smul, TensorProduct.tmul_add]
        · rw [map_add, map_add, ih₁, ih₂] }
  let instMod_TQ : Module (PadicInt ℓ) (TensorProduct ℤ ℚ S) :=
    Module.compHom (TensorProduct ℤ ℚ S) z_act_ringHom
  let _ : Module (PadicInt ℓ) (TensorProduct ℤ ℚ S) := instMod_TQ
  have h_tens_zsmul : ∀ (z : PadicInt ℓ) (q_rat : ℚ) (x : S),
      z • TensorProduct.tmul ℤ q_rat x = TensorProduct.tmul ℤ q_rat (z • x) :=
    fun _ _ _ => rfl
  have h_tmul_nsmul : ∀ (n : ℕ) (q_rat : ℚ) (x : S),
      TensorProduct.tmul ℤ (n • q_rat) x = TensorProduct.tmul ℤ q_rat (n • x) := by
    intro n q_rat x
    have hL : TensorProduct.tmul ℤ (n • q_rat) x = n • TensorProduct.tmul ℤ q_rat x :=
      map_nsmul ((TensorProduct.mk ℤ ℚ S).flip x) n q_rat
    have hR : TensorProduct.tmul ℤ q_rat (n • x) = n • TensorProduct.tmul ℤ q_rat x :=
      map_nsmul (TensorProduct.mk ℤ ℚ S q_rat) n x
    exact hL.trans hR.symm
  have h_tmul_zsmul : ∀ (m : ℤ) (q_rat : ℚ) (x : S),
      TensorProduct.tmul ℤ (m • q_rat) x = TensorProduct.tmul ℤ q_rat (m • x) := by
    intro m q_rat x
    have hL : TensorProduct.tmul ℤ (m • q_rat) x = m • TensorProduct.tmul ℤ q_rat x :=
      map_zsmul ((TensorProduct.mk ℤ ℚ S).flip x) m q_rat
    have hR : TensorProduct.tmul ℤ q_rat (m • x) = m • TensorProduct.tmul ℤ q_rat x :=
      map_zsmul (TensorProduct.mk ℤ ℚ S q_rat) m x
    exact hL.trans hR.symm
  have hex_clear : ∀ a : Padic ℓ, ∃ k : ℕ, ∃ z : PadicInt ℓ,
      (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * a := by
    intro a
    have hℓ_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
    obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖a‖ hℓ_gt1
    have hnorm : ‖(ℓ : Padic ℓ) ^ k * a‖ ≤ 1 := by
      rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := by positivity
      rw [inv_mul_le_iff₀ hpos, mul_one]
      exact le_of_lt hk
    exact ⟨k, ⟨(ℓ : Padic ℓ) ^ k * a, hnorm⟩, rfl⟩
  have hshift : ∀ (u v : ℕ) (z : PadicInt ℓ) (x : S),
      TensorProduct.tmul ℤ (((ℓ : ℚ) ^ u)⁻¹) (z • x) =
        TensorProduct.tmul ℤ (((ℓ : ℚ) ^ (u + v))⁻¹) ((((ℓ : PadicInt ℓ) ^ v) * z) • x) := by
    intro u v z x
    have hℓ_rat_ne : (ℓ : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hℓ_ne_zero
    have hℓv_ne : (ℓ : ℚ) ^ v ≠ 0 := pow_ne_zero v hℓ_rat_ne
    have hq_eq : ((ℓ : ℚ) ^ u)⁻¹ = (ℓ ^ v) • (((ℓ : ℚ) ^ (u + v))⁻¹) := by
      rw [nsmul_eq_mul, Nat.cast_pow, pow_add, mul_inv, ← mul_assoc,
        mul_comm ((ℓ : ℚ) ^ v) (((ℓ : ℚ) ^ u)⁻¹), mul_assoc, mul_inv_cancel₀ hℓv_ne, mul_one]
    rw [hq_eq, h_tmul_nsmul, ← Nat.cast_smul_eq_nsmul (PadicInt ℓ), Nat.cast_pow, mul_smul]
  have hclear_indep : ∀ (a : Padic ℓ) (x : S) (k₁ k₂ : ℕ) (z₁ z₂ : PadicInt ℓ),
      (z₁ : Padic ℓ) = (ℓ : Padic ℓ) ^ k₁ * a →
      (z₂ : Padic ℓ) = (ℓ : Padic ℓ) ^ k₂ * a →
      TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₁)⁻¹) (z₁ • x) =
        TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k₂)⁻¹) (z₂ • x) := by
    intro a x k₁ k₂ z₁ z₂ hz₁ hz₂
    have hz_eq : (ℓ : PadicInt ℓ) ^ k₂ * z₁ = (ℓ : PadicInt ℓ) ^ k₁ * z₂ := by
      apply Subtype.ext
      push_cast
      rw [hz₁, hz₂]
      ring
    rw [hshift k₁ k₂ z₁ x, hshift k₂ k₁ z₂ x, hz_eq, Nat.add_comm k₁ k₂]
  let ψ_fun : Padic ℓ → S → TensorProduct ℤ ℚ S := fun a x =>
    let k := Classical.choose (hex_clear a)
    let z := Classical.choose (Classical.choose_spec (hex_clear a))
    TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k)⁻¹) (z • x)
  have hψ_spec : ∀ (a : Padic ℓ) (x : S) (k : ℕ) (z : PadicInt ℓ),
      (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * a →
      ψ_fun a x = TensorProduct.tmul ℤ (((ℓ : ℚ) ^ k)⁻¹) (z • x) := by
    intro a x k z hz
    dsimp only [ψ_fun]
    exact hclear_indep a x _ k _ z
      (Classical.choose_spec (Classical.choose_spec (hex_clear a))) hz
  have hPadic_smul_eq : ∀ (w : PadicInt ℓ) (a : Padic ℓ), w • a = (w : Padic ℓ) * a := by
    intro w a
    rw [Algebra.smul_def]
    rfl
  let Ψ_right : Padic ℓ → (S →ₗ[PadicInt ℓ] TensorProduct ℤ ℚ S) := fun a =>
    { toFun := fun x => ψ_fun a x
      map_add' := fun x₁ x₂ => by
        obtain ⟨k, z, hz⟩ := hex_clear a
        rw [hψ_spec a (x₁ + x₂) k z hz, hψ_spec a x₁ k z hz, hψ_spec a x₂ k z hz,
          smul_add, TensorProduct.tmul_add]
      map_smul' := fun w x => by
        obtain ⟨k, z, hz⟩ := hex_clear a
        change ψ_fun a (w • x) = w • ψ_fun a x
        rw [hψ_spec a (w • x) k z hz, hψ_spec a x k z hz, h_tens_zsmul,
          ← mul_smul, mul_comm z w, mul_smul] }
  let Ψ_bilin : Padic ℓ →ₗ[PadicInt ℓ] (S →ₗ[PadicInt ℓ] TensorProduct ℤ ℚ S) :=
    { toFun := Ψ_right
      map_add' := fun a₁ a₂ => by
        apply LinearMap.ext; intro x
        obtain ⟨k₁, z₁, hz₁⟩ := hex_clear a₁
        obtain ⟨k₂, z₂, hz₂⟩ := hex_clear a₂
        let z₁' : PadicInt ℓ := (ℓ : PadicInt ℓ) ^ k₂ * z₁
        let z₂' : PadicInt ℓ := (ℓ : PadicInt ℓ) ^ k₁ * z₂
        have hz₁' : (z₁' : Padic ℓ) = (ℓ : Padic ℓ) ^ (k₁ + k₂) * a₁ := by
          dsimp [z₁']; rw [hz₁]; ring
        have hz₂' : (z₂' : Padic ℓ) = (ℓ : Padic ℓ) ^ (k₁ + k₂) * a₂ := by
          dsimp [z₂']; rw [hz₂]; ring
        have hz_sum : ((z₁' + z₂' : PadicInt ℓ) : Padic ℓ) =
            (ℓ : Padic ℓ) ^ (k₁ + k₂) * (a₁ + a₂) := by
          push_cast; rw [hz₁', hz₂']; ring
        change ψ_fun (a₁ + a₂) x = ψ_fun a₁ x + ψ_fun a₂ x
        rw [hψ_spec (a₁ + a₂) x (k₁ + k₂) (z₁' + z₂') hz_sum,
          hψ_spec a₁ x (k₁ + k₂) z₁' hz₁', hψ_spec a₂ x (k₁ + k₂) z₂' hz₂',
          add_smul, TensorProduct.tmul_add]
      map_smul' := fun w a => by
        apply LinearMap.ext; intro x
        obtain ⟨k, z, hz⟩ := hex_clear a
        have hwz : ((w * z : PadicInt ℓ) : Padic ℓ) = (ℓ : Padic ℓ) ^ k * (w • a) := by
          rw [hPadic_smul_eq]; push_cast; rw [hz]; ring
        change ψ_fun (w • a) x = w • ψ_fun a x
        rw [hψ_spec (w • a) x k (w * z) hwz, hψ_spec a x k z hz, h_tens_zsmul, mul_smul] }
  let Ψ : V₂ →ₗ[PadicInt ℓ] TensorProduct ℤ ℚ S := TensorProduct.lift Ψ_bilin
  have hΦΨ : ∀ v : V₂, Φ (Ψ v) = v := by
    intro v
    refine TensorProduct.inductionOn (motive := fun v => Φ (Ψ v) = v) v
      (fun a x => ?_) (fun v₁ v₂ ih₁ ih₂ => ?_)
    · obtain ⟨k, z, hz⟩ := hex_clear a
      change Φ (ψ_fun a x) = TensorProduct.tmul (PadicInt ℓ) a x
      rw [hψ_spec a x k z hz, hΦ_tmul, ← TensorProduct.smul_tmul, hPadic_smul_eq]
      have hℓ_padic_ne : (ℓ : Padic ℓ) ^ k ≠ 0 := pow_ne_zero k (Nat.cast_ne_zero.mpr hℓ_ne_zero)
      have hcast_inv : ((((ℓ : ℚ) ^ k)⁻¹ : ℚ) : Padic ℓ) = ((ℓ : Padic ℓ) ^ k)⁻¹ := by
        push_cast; rfl
      rw [hcast_inv, hz, mul_comm ((ℓ : Padic ℓ) ^ k) a, mul_assoc,
        mul_inv_cancel₀ hℓ_padic_ne, mul_one]
    · rw [map_add, map_add, ih₁, ih₂]
  have hΨΦ : ∀ t : TensorProduct ℤ ℚ S, Ψ (Φ t) = t := by
    intro t
    refine TensorProduct.inductionOn (motive := fun t => Ψ (Φ t) = t) t
      (fun q_rat x => ?_) (fun t₁ t₂ ih₁ ih₂ => ?_)
    · let m : ℤ := q_rat.num
      let b : ℕ := q_rat.den
      have hb_pos : 0 < b := q_rat.pos
      obtain ⟨k, d, hndvd, hb_eq⟩ :=
        Nat.exists_eq_pow_mul_and_not_dvd hb_pos.ne' ℓ hPrime.ne_one
      have hd_ne : d ≠ 0 := by
        intro hd0
        rw [hd0, mul_zero] at hb_eq
        exact hb_pos.ne' hb_eq
      have hd_cop : Nat.Coprime ℓ d := hPrime.coprime_iff_not_dvd.mpr hndvd
      have hd_unit : IsUnit (d : PadicInt ℓ) :=
        PadicInt.isUnit_iff.mpr (PadicInt.norm_natCast_eq_one_iff.mpr hd_cop)
      obtain ⟨u_d, hu_d⟩ := hd_unit
      let z : PadicInt ℓ := (m : PadicInt ℓ) * ↑(u_d⁻¹)
      have hdz : (d : PadicInt ℓ) * z = (m : PadicInt ℓ) := by
        dsimp [z]
        rw [← hu_d, mul_comm (m : PadicInt ℓ) ↑(u_d⁻¹), ← mul_assoc, Units.mul_inv, one_mul]
      have hqb_rat : q_rat * (b : ℚ) = (m : ℚ) := Rat.mul_den_eq_num q_rat
      have hz_coe : (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * (q_rat : Padic ℓ) := by
        have hd_padic_ne : (d : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
        apply mul_left_cancel₀ hd_padic_ne
        have hLHS : (d : Padic ℓ) * (z : Padic ℓ) = (m : Padic ℓ) := by
          have h1 := congrArg (fun u : PadicInt ℓ => (u : Padic ℓ)) hdz
          simpa using h1
        have hRHS : (d : Padic ℓ) * ((ℓ : Padic ℓ) ^ k * (q_rat : Padic ℓ)) = (m : Padic ℓ) := by
          have hb_padic : (d : Padic ℓ) * (ℓ : Padic ℓ) ^ k = (b : Padic ℓ) := by
            rw [hb_eq]; push_cast; ring
          calc (d : Padic ℓ) * ((ℓ : Padic ℓ) ^ k * (q_rat : Padic ℓ))
              = ((d : Padic ℓ) * (ℓ : Padic ℓ) ^ k) * (q_rat : Padic ℓ) := (mul_assoc _ _ _).symm
            _ = (b : Padic ℓ) * (q_rat : Padic ℓ) := by rw [hb_padic]
            _ = ((q_rat * (b : ℚ) : ℚ) : Padic ℓ) := by push_cast; ring
            _ = ((m : ℚ) : Padic ℓ) := by rw [hqb_rat]
            _ = (m : Padic ℓ) := by push_cast; rfl
        exact hLHS.trans hRHS.symm
      change ψ_fun (q_rat : Padic ℓ) x = TensorProduct.tmul ℤ q_rat x
      rw [hψ_spec (q_rat : Padic ℓ) x k z hz_coe]
      have hd_rat_ne : (d : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne
      have hb_rat_ne : (b : ℚ) ≠ 0 := Nat.cast_ne_zero.mpr hb_pos.ne'
      have hq_inv : ((ℓ : ℚ) ^ k)⁻¹ = d • ((b : ℚ)⁻¹) := by
        rw [nsmul_eq_mul, hb_eq, Nat.cast_mul, Nat.cast_pow, mul_inv,
          ← mul_assoc, mul_comm (d : ℚ) (((ℓ : ℚ) ^ k)⁻¹), mul_assoc,
          mul_inv_cancel₀ hd_rat_ne, mul_one]
      have hmb_eq : m • ((b : ℚ)⁻¹) = q_rat := by
        rw [zsmul_eq_mul, ← hqb_rat, mul_assoc, mul_inv_cancel₀ hb_rat_ne, mul_one]
      rw [hq_inv, h_tmul_nsmul, ← Nat.cast_smul_eq_nsmul (PadicInt ℓ), ← mul_smul, hdz,
        Int.cast_smul_eq_zsmul, ← h_tmul_zsmul, hmb_eq]
    · rw [map_add, map_add, ih₁, ih₂]
  let equiv₂ : TensorProduct ℤ ℚ ↥sys₂ ≃+ V₂ :=
    { toFun := Φ
      invFun := Ψ
      left_inv := hΨΦ
      right_inv := hΦΨ
      map_add' := Φ.map_add }
  
  let frob₂ : V₂ →ₗ[Padic ℓ] V₂ := LinearMap.baseChange (Padic ℓ) frob_sys₂
  have hsmul₂ : ∀ (z : PadicInt ℓ) (x y : ↥sys₂),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
        equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    intro z x y hxy
    have hy : y = z • x := Subtype.ext (funext hxy)
    rw [hy]
    change TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) (z • x) =
      (z : Padic ℓ) • TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) x
    rw [Rat.cast_one, ← TensorProduct.smul_tmul, hPadic_smul_eq, mul_one,
      TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have hfrob₂ : ∀ (x y : ↥sys₂),
      (∀ r : ℕ, y.1 r = f₂ r (x.1 r)) →
        frob₂ (equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y) := by
    intro x y hxy
    have hy : y = frob_sys₂ x := Subtype.ext (funext hxy)
    rw [hy]
    change LinearMap.baseChange (Padic ℓ) frob_sys₂
        (TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) x) =
      TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) (frob_sys₂ x)
    exact LinearMap.baseChange_tmul frob_sys₂ _ x
  
  have hq_sys_mem : ∀ x : ↥sys₁, (fun r : ℕ => q r (x.1 r)) ∈ sys₂ := by
    intro x
    rw [hsys₂]
    intro r
    rw [← hq_τ r (x.1 (r + 1)), (hsys₁ x.1).mp x.2 r]
  let q_sys : ↥sys₁ →+ ↥sys₂ :=
    { toFun := fun x => ⟨fun r => q r (x.1 r), hq_sys_mem x⟩
      map_zero' := Subtype.ext <| funext fun r => map_zero (q r)
      map_add' := fun x₁ x₂ => Subtype.ext <| funext fun r => map_add (q r) (x₁.1 r) (x₂.1 r) }
  have hq_sys_surj : Function.Surjective q_sys := by
    intro y
    let K_fib : ℕ → Type u := fun r => { x_r : H₁ r // q r x_r = y.1 r }
    let step : ∀ r : ℕ, K_fib (r + 1) → K_fib r := fun r u =>
      ⟨τ₁ r u.1, by rw [hq_τ r u.1, u.2, (hsys₂ y.1).mp y.2 r]⟩
    let F_inv : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
      CategoryTheory.Functor.ofOpSequence (fun r => TypeCat.ofHom (step r))
    have hFin_K : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := fun j => by
      dsimp [F_inv, K_fib]
      have : Finite (H₁ j.unop) := hFin₁ j.unop
      exact Subtype.finite
    have hNe_K : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := fun j => by
      dsimp [F_inv, K_fib]
      obtain ⟨x_r, hx_r⟩ := hq_surj j.unop (y.1 j.unop)
      exact ⟨⟨x_r, hx_r⟩⟩
    obtain ⟨s, hs⟩ := nonempty_sections_of_finite_inverse_system F_inv
    let x_seq : ∀ r : ℕ, H₁ r := fun r => (s (Opposite.op r)).1
    have hx_mem : x_seq ∈ sys₁ := by
      rw [hsys₁]
      intro r
      have hsec := hs (CategoryTheory.homOfLE (Nat.le_succ r)).op
      rw [CategoryTheory.Functor.ofOpSequence_map_homOfLE_succ] at hsec
      exact congrArg Subtype.val hsec
    refine ⟨⟨x_seq, hx_mem⟩, Subtype.ext <| funext fun r => ?_⟩
    exact (s (Opposite.op r)).2
  let π_Q : TensorProduct ℤ ℚ ↥sys₁ →ₗ[ℤ] TensorProduct ℤ ℚ ↥sys₂ :=
    LinearMap.lTensor ℚ q_sys.toIntLinearMap
  have hπ_Q_surj : Function.Surjective π_Q :=
    LinearMap.lTensor_surjective ℚ hq_sys_surj
  let π₀ : V₁ →+ V₂ :=
    equiv₂.toAddMonoidHom.comp (π_Q.toAddMonoidHom.comp equiv₁.symm.toAddMonoidHom)
  have hπ₀_surj : Function.Surjective π₀ :=
    equiv₂.surjective.comp (hπ_Q_surj.comp equiv₁.symm.surjective)
  have hπ₀_equiv₁ : ∀ t : TensorProduct ℤ ℚ ↥sys₁, π₀ (equiv₁ t) = equiv₂ (π_Q t) := by
    intro t
    simp only [π₀, AddMonoidHom.comp_apply, AddEquiv.coe_toAddMonoidHom,
      LinearMap.toAddMonoidHom_coe, equiv₁.symm_apply_apply]
  have hRatSmul₁ : ∀ (a : ℚ) (x : ↥sys₁),
      equiv₁ (TensorProduct.tmul ℤ a x) =
        (a : Padic ℓ) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    intro a x
    let m : ℤ := a.num
    let d : ℕ := a.den
    have hd_pos : 0 < d := a.pos
    have had : a * (d : ℚ) = (m : ℚ) := Rat.mul_den_eq_num a
    have h_tens_eq : d • TensorProduct.tmul ℤ a x = m • TensorProduct.tmul ℤ (1 : ℚ) x := by
      have h1 : d • TensorProduct.tmul ℤ a x = TensorProduct.tmul ℤ (d • a) x :=
        (map_nsmul ((TensorProduct.mk ℤ ℚ ↥sys₁).flip x) d a).symm
      have h2 : m • TensorProduct.tmul ℤ (1 : ℚ) x = TensorProduct.tmul ℤ (m • (1 : ℚ)) x :=
        (map_zsmul ((TensorProduct.mk ℤ ℚ ↥sys₁).flip x) m (1 : ℚ)).symm
      rw [h1, h2, nsmul_eq_mul, mul_comm (d : ℚ) a, had, zsmul_eq_mul, mul_one]
    have heq_V₁ := congrArg equiv₁ h_tens_eq
    rw [map_nsmul, map_zsmul, ← Nat.cast_smul_eq_nsmul (Padic ℓ),
      ← Int.cast_smul_eq_zsmul (Padic ℓ)] at heq_V₁
    have hd_ne : (d : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
    have hcancel := congrArg (fun u : V₁ => ((d : Padic ℓ)⁻¹) • u) heq_V₁
    rw [← mul_smul, inv_mul_cancel₀ hd_ne, one_smul, ← mul_smul] at hcancel
    have hscalar : (d : Padic ℓ)⁻¹ * (m : Padic ℓ) = (a : Padic ℓ) := by
      have had_padic : (a : Padic ℓ) * (d : Padic ℓ) = (m : Padic ℓ) := by
        have h := congrArg (fun r : ℚ => (r : Padic ℓ)) had
        simpa using h
      rw [← had_padic, mul_comm (a : Padic ℓ) (d : Padic ℓ), ← mul_assoc,
        inv_mul_cancel₀ hd_ne, one_mul]
    rwa [hscalar] at hcancel
  have hπ₀_smul_one : ∀ (c : Padic ℓ) (x : ↥sys₁),
      π₀ (c • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        c • π₀ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) := by
    intro c x
    obtain ⟨k, z, hz⟩ := hex_clear c
    let y₁ : ↥sys₁ := ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, hz_mem₁ z x⟩
    have hq_y₁ : ∀ r : ℕ, (q_sys y₁).1 r = (PadicInt.toZModPow (r + 1) z).val • (q_sys x).1 r :=
      fun r => map_nsmul (q r) _ _
    have hscaled : (ℓ ^ k) • π₀ (c • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
        (ℓ ^ k) • (c • π₀ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))) := by
      rw [← map_nsmul π₀, ← Nat.cast_smul_eq_nsmul (Padic ℓ) (ℓ ^ k), Nat.cast_pow,
        ← mul_smul, ← hz, ← hsmul₁ z x y₁ (fun _ => rfl), hπ₀_equiv₁]
      change equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) (q_sys y₁)) = _
      rw [hsmul₂ z (q_sys x) (q_sys y₁) hq_y₁, hz, mul_smul, ← Nat.cast_pow,
        Nat.cast_smul_eq_nsmul (Padic ℓ) (ℓ ^ k), hπ₀_equiv₁]
      rfl
    have hℓk_ne : ((ℓ ^ k : ℕ) : Padic ℓ) ≠ 0 :=
      Nat.cast_ne_zero.mpr (pow_ne_zero k hℓ_ne_zero)
    rw [← Nat.cast_smul_eq_nsmul (Padic ℓ), ← Nat.cast_smul_eq_nsmul (Padic ℓ)] at hscaled
    have hcancel := congrArg (fun u : V₂ => (((ℓ ^ k : ℕ) : Padic ℓ)⁻¹) • u) hscaled
    rwa [← mul_smul, ← mul_smul, inv_mul_cancel₀ hℓk_ne, one_smul, one_smul] at hcancel
  have hπ₀_smul : ∀ (c : Padic ℓ) (v : V₁), π₀ (c • v) = c • π₀ v := by
    intro c v
    have h_on_t : ∀ t : TensorProduct ℤ ℚ ↥sys₁, π₀ (c • equiv₁ t) = c • π₀ (equiv₁ t) := by
      intro t
      refine TensorProduct.inductionOn
        (motive := fun t => π₀ (c • equiv₁ t) = c • π₀ (equiv₁ t)) t
        (fun a x => ?_) (fun t₁ t₂ ih₁ ih₂ => ?_)
      · have hπ₀_ax : π₀ (equiv₁ (TensorProduct.tmul ℤ a x)) =
            (a : Padic ℓ) • π₀ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) := by
          rw [hπ₀_equiv₁, hπ₀_equiv₁]
          change TensorProduct.tmul (PadicInt ℓ) (a : Padic ℓ) (q_sys x) =
            (a : Padic ℓ) • TensorProduct.tmul (PadicInt ℓ) ((1 : ℚ) : Padic ℓ) (q_sys x)
          rw [Rat.cast_one, TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hπ₀_ax, hRatSmul₁ a x, ← mul_smul, hπ₀_smul_one (c * (a : Padic ℓ)) x, mul_smul]
      · rw [map_add, smul_add, map_add, ih₁, ih₂, map_add, smul_add]
    simpa only [equiv₁.apply_symm_apply] using h_on_t (equiv₁.symm v)
  let π : V₁ →ₗ[Padic ℓ] V₂ :=
    { toFun := π₀
      map_add' := π₀.map_add
      map_smul' := hπ₀_smul }
  have hFin_V₂ : Module.Finite (Padic ℓ) V₂ :=
    Module.Finite.of_surjective π hπ₀_surj
  exact ⟨hFin₂, V₂, inferInstance, inferInstance, hFin_V₂, frob₂, equiv₂, hsmul₂, hfrob₂⟩

theorem weil_mid_dev_curve_tower_mid_ext_model_existence (F : Type u) [Finite F] [Field F]
    (S_aff : Finset F)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ K : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) (hK : 1 ≤ K) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (B_F L_F : ℕ → Type u)
      [∀ r, CommRing (B_F r)] [∀ r, IsDomain (B_F r)] [∀ r, Field (L_F r)]
      [∀ r, Algebra F (B_F r)] [∀ r, Algebra (Polynomial F) (B_F r)] [∀ r, Algebra R₀ (B_F r)]
      [∀ r, Algebra F (L_F r)] [∀ r, Algebra (Polynomial F) (L_F r)]
      [∀ r, Algebra (RatFunc F) (L_F r)] [∀ r, Algebra (B_F r) (L_F r)] [∀ r, Algebra R₀ (L_F r)]
      [∀ r, IsScalarTower F (Polynomial F) (B_F r)] [∀ r, IsScalarTower (Polynomial F) R₀ (B_F r)]
      [∀ r, IsScalarTower F (RatFunc F) (L_F r)]
      [∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_F r)]
      [∀ r, IsScalarTower (Polynomial F) (B_F r) (L_F r)]
      [∀ r, IsScalarTower R₀ (B_F r) (L_F r)]
      [∀ r, Module.Finite R₀ (B_F r)] [∀ r, Algebra.Etale R₀ (B_F r)]
      [∀ r, IsFractionRing (B_F r) (L_F r)] [∀ r, IsIntegralClosure (B_F r) R₀ (L_F r)]
      [∀ r, FiniteDimensional (RatFunc F) (L_F r)] [∀ r, IsGalois (RatFunc F) (L_F r)]
      (ρ_F : ∀ r : ℕ, (B_F r ≃ₐ[R₀] B_F r) →* (Matrix (Fin K) (Fin K) (ZMod (ℓ ^ (r + 1))))ˣ)
      (ι_BF : ∀ r : ℕ, B_F r →ₐ[R₀] B_F (r + 1))
      (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
      (_heU_eq : CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀))) j_aff)
      (_hι_BF_compat : ∀ r : ℕ, Function.Injective (ι_BF r) ∧
        ∀ τ : B_F (r + 1) ≃ₐ[R₀] B_F (r + 1),
          ∃ σ : B_F r ≃ₐ[R₀] B_F r,
            (∀ b : B_F r, τ (ι_BF r b) = ι_BF r (σ b)) ∧
            ((ρ_F (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
              (ρ_F r σ).val)
      (ℱ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (τ_ℱ : ∀ r : ℕ, Quiver.Hom (ℱ₀ (r + 1)) (ℱ₀ r))
      (_hTriv_F : ∃ triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
          let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B_F r))
          let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F r)))) e_U.hom
          let W_r := CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
          ↑((ℱ₀ r).obj.obj (Opposite.op W)) →+
            (LocallyConstant ↥W_r (Fin K → ZMod (ℓ ^ (r + 1)))),
        ∀ r : ℕ,
          let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B_F r))
          let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F r)))) e_U.hom
          let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (B_F (r + 1)))) U₀.toScheme :=
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F (r + 1))))) e_U.hom
          (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
            let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
            let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
            let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
            let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
            ∀ (u_r : Quiver.Hom W₁_r W₂_r),
              CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.fst h₁ π_r)
                  ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
              CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
                CategoryTheory.Limits.pullback.snd h₁ π_r →
              ∀ (s : ↑((ℱ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
                triv r W₁ (((ℱ₀ r).obj.map (Opposite.op u)) s) y₁ =
                  triv r W₂ s (u_r.base y₁)) ∧
          ∀ (W : U₀.toScheme.Etale),
            let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
            let W_r := CategoryTheory.Limits.pullback h_W π_r
            let W_succ := CategoryTheory.Limits.pullback h_W π_succ
            Function.Injective (triv r W) ∧
            Set.range (triv r W) =
              { f | ∀ (σ : B_F r ≃ₐ[R₀] B_F r) (m_σ : Quiver.Hom W_r W_r),
                CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                  CategoryTheory.Limits.pullback.fst h_W π_r →
                CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd h_W π_r)
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
                ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_F r σ).val).mulVec (f y) } ∧
            ∀ (s_up : ↑((ℱ₀ (r + 1)).obj.obj (Opposite.op W)))
              (m_ι : Quiver.Hom W_succ W_r),
              CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_succ →
              CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_succ)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_BF r).toRingHom)) →
              ∀ (y_up : ↥W_succ) (i : Fin K),
                triv r W (((τ_ℱ r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                  ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                    (triv (r + 1) W s_up y_up i)),
      ∃ (M_mid : WeilTransvTriSheafCohomologyModel F (weilProjectiveSpaceOver F 1) ℓ 1
          (fun r => weilEtaleHigherDirectImage U₀.ι 0 (ℱ₀ r))
          (fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℱ r))),
        ∀ r : ℕ, Finite ((M_mid.ℳ_bar r).H 1) :=
by
  classical
  intro R₀ B_F L_F
    _ _ _
    _ _ _
    _ _ _ _ _
    _ _ _ _ _ _
    _ _ _ _ _ _
    ρ_F ι_BF e_U _heU_eq hι_BF_compat ℱ₀ τ_ℱ hTriv_F
  let Y₀ := weilProjectiveSpaceOver F 1
  let D₀ := Y₀.left
  let S := weilGeomScheme F Y₀
  let pr_Y : Quiver.Hom S D₀ :=
    CategoryTheory.Limits.pullback.fst Y₀.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  have _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
      (CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  have _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.Abelian
      (CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.Abelian
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let _ : CategoryTheory.HasExt
      (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
  let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let mapH : ∀ {𝒜 ℬ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}},
      Quiver.Hom 𝒜 ℬ → (𝒜.H 1 →+ ℬ.H 1) :=
    fun {𝒜 ℬ} f => (CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ (Nat.add_zero 1)
  have hExt_nsmul : ∀ {𝒴 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (w : 𝒴.H 1) (k : ℕ),
      mapH (k • CategoryTheory.CategoryStruct.id 𝒴) w = k • w := by
    intro 𝒴 w k
    change w.comp (CategoryTheory.Abelian.Ext.mk₀ (k • CategoryTheory.CategoryStruct.id 𝒴))
      (Nat.add_zero 1) = k • w
    induction k with
    | zero =>
      rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]
  have hPost_comp : ∀ {𝒜 ℬ 𝒞 : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (f : Quiver.Hom 𝒜 ℬ) (g : Quiver.Hom ℬ 𝒞) (w : 𝒜.H 1),
      mapH g (mapH f w) = mapH (CategoryTheory.CategoryStruct.comp f g) w :=
    fun {𝒜 ℬ 𝒞} f g w =>
      (CategoryTheory.Abelian.Ext.comp_assoc w
        (CategoryTheory.Abelian.Ext.mk₀ f) (CategoryTheory.Abelian.Ext.mk₀ g)
        (Nat.add_zero 1) (Nat.zero_add 0) (by omega)).trans
        (congrArg (fun u => w.comp u (Nat.add_zero 1))
          (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f g))
  have hTors_bar :
      ∀ {L_pr : CategoryTheory.Functor
          (CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})}
        (_hAdd : L_pr.Additive)
        {𝒢₀ : CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u}}
        {𝒢_bar : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (e : CategoryTheory.Iso (L_pr.obj 𝒢₀) 𝒢_bar)
        (N : ℕ),
        N • CategoryTheory.CategoryStruct.id 𝒢₀ = 0 →
        ∀ w : 𝒢_bar.H 1, N • w = 0 := by
    intro L_pr hAdd 𝒢₀ 𝒢_bar e N hN w
    let _ : L_pr.Additive := hAdd
    have hL0 : N • CategoryTheory.CategoryStruct.id (L_pr.obj 𝒢₀) = 0 := by
      rw [← L_pr.map_id, ← CategoryTheory.Functor.map_nsmul, hN, L_pr.map_zero]
    have hbar0 : N • CategoryTheory.CategoryStruct.id 𝒢_bar = 0 := by
      have hid_eq : CategoryTheory.CategoryStruct.id 𝒢_bar =
          CategoryTheory.CategoryStruct.comp e.inv
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.id (L_pr.obj 𝒢₀)) e.hom) := by
        rw [CategoryTheory.Category.id_comp, e.inv_hom_id]
      rw [hid_eq, ← CategoryTheory.Preadditive.comp_nsmul,
        ← CategoryTheory.Preadditive.nsmul_comp, hL0,
        CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
    rw [← hExt_nsmul w N, hbar0]
    change w.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : Quiver.Hom 𝒢_bar 𝒢_bar))
      (Nat.add_zero 1) = 0
    rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  obtain ⟨𝒥₀, τ_𝒥, triv_!₀, ι_bock, ρ_bock, ι_ext,
    htriv_!₀, hTors_𝒥, hTors_ℳ, hSES_bock, hιτ_bock, hτι_bock, hρ0_bock, hρsucc_bock,
    hMono_ext, hCompat_ext, hBij_ext⟩ :=
    weil_mid_dev_zero_ext_bockstein_tower_and_dir_inclusion F S_aff D₀ U₀ ℓ K
      B_F L_F ρ_F ι_BF e_U hι_BF_compat ℱ₀ τ_ℱ hTriv_F

  obtain ⟨M_J, hFin_MJ, _⟩ :=
    (weil_transv_sheaf_model_builder_and_frob_naturality F Y₀ ℓ).1 1
      𝒥₀ τ_𝒥 ι_bock ρ_bock hTors_𝒥 hSES_bock hιτ_bock hτι_bock hρ0_bock hρsucc_bock
      (fun hCont_pr hAdj_pr =>
        weil_mid_dev_level_zero_zero_ext_geom_mod_prime_finite F S_aff U₀ ℓ K
          (Fact.out : Nat.Prime ℓ) hℓ
          (B_F 0) (L_F 0) e_U (ρ_F 0) (𝒥₀ 0) triv_!₀ htriv_!₀ hCont_pr hAdj_pr 1)

  let hCont_pr := M_J.hCont_pr
  let hAdj_pr := M_J.hAdj_pr
  obtain ⟨hAdd_L, hColim_L, hLim_L⟩ :=
    (weil_transv_etale_sheaf_pullback_exact S D₀ pr_Y).2 hCont_pr hAdj_pr
  let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
    (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
    D₀.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
  let _ : L_pr.Additive := hAdd_L
  let _ : CategoryTheory.Limits.PreservesFiniteColimits L_pr := hColim_L
  let _ : CategoryTheory.Limits.PreservesFiniteLimits L_pr := hLim_L

  let ℳ_dir : ℕ → CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u} :=
    fun r => weilEtaleHigherDirectImage U₀.ι 0 (ℱ₀ r)
  let τ_dir : ∀ r : ℕ, Quiver.Hom (ℳ_dir (r + 1)) (ℳ_dir r) :=
    fun r => weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℱ r)
  let ℳ_bar_dir : ℕ → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun r => L_pr.obj (ℳ_dir r)
  let τ_bar_dir : ∀ r : ℕ, Quiver.Hom (ℳ_bar_dir (r + 1)) (ℳ_bar_dir r) :=
    fun r => L_pr.map (τ_dir r)
  let iso_bar_dir : ∀ r : ℕ, CategoryTheory.Iso (L_pr.obj (ℳ_dir r)) (ℳ_bar_dir r) :=
    fun r => CategoryTheory.Iso.refl (ℳ_bar_dir r)
  have hτ_bar_dir : ∀ r : ℕ,
      CategoryTheory.CategoryStruct.comp (L_pr.map (τ_dir r)) (iso_bar_dir r).hom =
        CategoryTheory.CategoryStruct.comp (iso_bar_dir (r + 1)).hom (τ_bar_dir r) :=
    fun r => (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm

  obtain ⟨hFrobEx, hFrobNat⟩ :=
    weil_transv_geom_base_sheaf_frob_action_existence_and_naturality F Y₀ 1 hCont_pr hAdj_pr
  let frobTorsion_dir : ∀ r : ℕ, (ℳ_bar_dir r).H 1 →+ (ℳ_bar_dir r).H 1 :=
    fun r => Classical.choose (hFrobEx (ℳ_dir r) (ℳ_bar_dir r) (iso_bar_dir r))
  have hfrobTorsion_dir : ∀ r : ℕ,
      WeilTransvTriIsGeomBaseSheafAction F Y₀ (ℳ_dir r) (ℳ_bar_dir r) hCont_pr hAdj_pr
        (iso_bar_dir r) 1 (frobTorsion_dir r) :=
    fun r => Classical.choose_spec (hFrobEx (ℳ_dir r) (ℳ_bar_dir r) (iso_bar_dir r))

  let φ_bar : ∀ r : ℕ, Quiver.Hom (M_J.ℳ_bar r) (ℳ_bar_dir r) :=
    fun r => CategoryTheory.CategoryStruct.comp (M_J.iso_bar r).inv (L_pr.map (ι_ext r))
  let τ₁_H : ∀ r : ℕ, (M_J.ℳ_bar (r + 1)).H 1 →+ (M_J.ℳ_bar r).H 1 :=
    fun r => mapH (M_J.τ_bar r)
  let τ₂_H : ∀ r : ℕ, (ℳ_bar_dir (r + 1)).H 1 →+ (ℳ_bar_dir r).H 1 :=
    fun r => mapH (τ_bar_dir r)
  let q_H : ∀ r : ℕ, (M_J.ℳ_bar r).H 1 →+ (ℳ_bar_dir r).H 1 :=
    fun r => mapH (φ_bar r)

  have hTors₁_H : ∀ (r : ℕ) (w : (M_J.ℳ_bar r).H 1), (ℓ ^ (r + 1)) • w = 0 :=
    fun r => hTors_bar hAdd_L (M_J.iso_bar r) (ℓ ^ (r + 1)) (hTors_𝒥 r)
  have hTors₂_H : ∀ (r : ℕ) (w : (ℳ_bar_dir r).H 1), (ℓ ^ (r + 1)) • w = 0 :=
    fun r => hTors_bar hAdd_L (iso_bar_dir r) (ℓ ^ (r + 1)) (hTors_ℳ r)

  have hφ_iso_comm : ∀ r : ℕ,
      CategoryTheory.CategoryStruct.comp (L_pr.map (ι_ext r)) (iso_bar_dir r).hom =
        CategoryTheory.CategoryStruct.comp (M_J.iso_bar r).hom (φ_bar r) :=
    fun r =>
      (CategoryTheory.Category.comp_id (L_pr.map (ι_ext r))).trans
        (((CategoryTheory.Category.id_comp (L_pr.map (ι_ext r))).symm.trans
          (congrArg (fun u => CategoryTheory.CategoryStruct.comp u (L_pr.map (ι_ext r)))
            (M_J.iso_bar r).hom_inv_id.symm)).trans
          (CategoryTheory.Category.assoc (M_J.iso_bar r).hom (M_J.iso_bar r).inv
            (L_pr.map (ι_ext r))))

  have hq_surj : ∀ r : ℕ, Function.Surjective (q_H r) := by
    intro r y
    let SC₀ := CategoryTheory.ShortComplex.mk (ι_ext r)
      (CategoryTheory.Limits.cokernel.π (ι_ext r))
      (CategoryTheory.Limits.cokernel.condition (ι_ext r))
    have hSE₀ : SC₀.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₀
          (CategoryTheory.Limits.cokernelIsCokernel (ι_ext r)))
        (hMono_ext r) inferInstance
    have hSE_bar : (SC₀.map L_pr).ShortExact := hSE₀.map_of_exact L_pr
    have hSub_coker :
        Subsingleton ((L_pr.obj (CategoryTheory.Limits.cokernel (ι_ext r))).H 1) :=
      weil_curve_open_iso_cokernel_geom_h1_subsingleton F S_aff j_aff hj_open hj_hom
        s_inf hsinf_sec hsinf_compl U₀ hU₀_eq
        (𝒥₀ r) (ℳ_dir r) (ι_ext r) (hBij_ext r) hCont_pr hAdj_pr
    have h_to_coker : y.comp (CategoryTheory.Abelian.Ext.mk₀
        (L_pr.map (CategoryTheory.Limits.cokernel.π (ι_ext r)))) (Nat.add_zero 1) = 0 :=
      @Subsingleton.elim _ hSub_coker _ _
    obtain ⟨x₀, hx₀⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE_bar y h_to_coker
    have hx₀' : mapH (L_pr.map (ι_ext r)) x₀ = y := hx₀
    refine ⟨mapH (M_J.iso_bar r).hom x₀, ?_⟩
    exact (hPost_comp (M_J.iso_bar r).hom (φ_bar r) x₀).trans
      ((congrArg (fun g => mapH g x₀)
        ((CategoryTheory.Category.assoc (M_J.iso_bar r).hom (M_J.iso_bar r).inv
          (L_pr.map (ι_ext r))).symm.trans
          ((congrArg (fun u => CategoryTheory.CategoryStruct.comp u (L_pr.map (ι_ext r)))
            (M_J.iso_bar r).hom_inv_id).trans
            (CategoryTheory.Category.id_comp _)))).trans hx₀')

  have hτ_φ_bar : ∀ r : ℕ,
      CategoryTheory.CategoryStruct.comp (M_J.τ_bar r) (φ_bar r) =
        CategoryTheory.CategoryStruct.comp (φ_bar (r + 1)) (τ_bar_dir r) := by
    intro r
    apply (CategoryTheory.Iso.cancel_iso_hom_left (M_J.iso_bar (r + 1)) _ _).mp
    have hlhs : CategoryTheory.CategoryStruct.comp (M_J.iso_bar (r + 1)).hom
        (CategoryTheory.CategoryStruct.comp (M_J.τ_bar r) (φ_bar r)) =
        CategoryTheory.CategoryStruct.comp
          (L_pr.map (CategoryTheory.CategoryStruct.comp (τ_𝒥 r) (ι_ext r)))
          (iso_bar_dir r).hom :=
      (CategoryTheory.Category.assoc _ _ _).symm.trans
        ((congrArg (fun u => CategoryTheory.CategoryStruct.comp u (φ_bar r))
          (M_J.hτ_bar r).symm).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp (L_pr.map (τ_𝒥 r)))
              (hφ_iso_comm r).symm).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (fun u => CategoryTheory.CategoryStruct.comp u (iso_bar_dir r).hom)
                  (L_pr.map_comp (τ_𝒥 r) (ι_ext r)).symm)))))
    have hrhs : CategoryTheory.CategoryStruct.comp (M_J.iso_bar (r + 1)).hom
        (CategoryTheory.CategoryStruct.comp (φ_bar (r + 1)) (τ_bar_dir r)) =
        CategoryTheory.CategoryStruct.comp
          (L_pr.map (CategoryTheory.CategoryStruct.comp (ι_ext (r + 1)) (τ_dir r)))
          (iso_bar_dir r).hom :=
      (CategoryTheory.Category.assoc _ _ _).symm.trans
        ((congrArg (fun u => CategoryTheory.CategoryStruct.comp u (τ_bar_dir r))
          (hφ_iso_comm (r + 1)).symm).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp (L_pr.map (ι_ext (r + 1))))
              (hτ_bar_dir r).symm).trans
              ((CategoryTheory.Category.assoc _ _ _).symm.trans
                (congrArg (fun u => CategoryTheory.CategoryStruct.comp u (iso_bar_dir r).hom)
                  (L_pr.map_comp (ι_ext (r + 1)) (τ_dir r)).symm)))))
    exact hlhs.trans ((congrArg (fun f => CategoryTheory.CategoryStruct.comp (L_pr.map f)
      (iso_bar_dir r).hom) (hCompat_ext r)).trans hrhs.symm)

  have hq_τ : ∀ (r : ℕ) (x : (M_J.ℳ_bar (r + 1)).H 1),
      q_H r (τ₁_H r x) = τ₂_H r (q_H (r + 1) x) :=
    fun r x => (hPost_comp (M_J.τ_bar r) (φ_bar r) x).trans
      ((congrArg (fun g => mapH g x) (hτ_φ_bar r)).trans
        (hPost_comp (φ_bar (r + 1)) (τ_bar_dir r) x).symm)

  have hq_f : ∀ (r : ℕ) (x : (M_J.ℳ_bar r).H 1),
      q_H r (M_J.frobTorsion r x) = frobTorsion_dir r (q_H r x) :=
    fun r x => hFrobNat (𝒥₀ r) (ℳ_dir r) (M_J.ℳ_bar r) (ℳ_bar_dir r)
      (M_J.iso_bar r) (iso_bar_dir r) (M_J.frobTorsion r) (frobTorsion_dir r)
      (ι_ext r) (φ_bar r) (M_J.hfrobTorsion r) (hfrobTorsion_dir r) (hφ_iso_comm r) x

  have hf₁_τ : ∀ (r : ℕ) (x : (M_J.ℳ_bar (r + 1)).H 1),
      τ₁_H r (M_J.frobTorsion (r + 1) x) = M_J.frobTorsion r (τ₁_H r x) :=
    fun r x => hFrobNat (𝒥₀ (r + 1)) (𝒥₀ r) (M_J.ℳ_bar (r + 1)) (M_J.ℳ_bar r)
      (M_J.iso_bar (r + 1)) (M_J.iso_bar r) (M_J.frobTorsion (r + 1)) (M_J.frobTorsion r)
      (τ_𝒥 r) (M_J.τ_bar r) (M_J.hfrobTorsion (r + 1)) (M_J.hfrobTorsion r) (M_J.hτ_bar r) x

  let sys_dir : AddSubgroup (∀ r : ℕ, (ℳ_bar_dir r).H 1) :=
    AddMonoidHom.ker (AddMonoidHom.pi fun r =>
      (τ₂_H r).comp (Pi.evalAddMonoidHom (fun k => (ℳ_bar_dir k).H 1) (r + 1)) -
        Pi.evalAddMonoidHom (fun k => (ℳ_bar_dir k).H 1) r)
  have hsys_dir : ∀ y : (∀ r : ℕ, (ℳ_bar_dir r).H 1),
      y ∈ sys_dir ↔ ∀ r : ℕ, τ₂_H r (y (r + 1)) = y r := by
    intro y
    simp only [sys_dir, AddMonoidHom.mem_ker, AddMonoidHom.pi_apply, funext_iff,
      Pi.zero_apply, AddMonoidHom.sub_apply, AddMonoidHom.comp_apply,
      Pi.evalAddMonoidHom_apply, sub_eq_zero]

  obtain ⟨hFin_dir, V_dir, instAdd_dir, instMod_dir, instFin_dir,
    frob_dir, equiv_dir, hsmul_dir, hfrob_dir⟩ :=
    weil_mid_dev_konig_quotient_padic_tower_module ℓ
      (fun r => (M_J.ℳ_bar r).H 1) (fun r => (ℳ_bar_dir r).H 1)
      τ₁_H τ₂_H M_J.frobTorsion frobTorsion_dir q_H
      M_J.sysSubgroup sys_dir M_J.V M_J.frob M_J.equiv
      hTors₁_H hTors₂_H hFin_MJ hq_surj hq_τ hq_f hf₁_τ
      M_J.hsys hsys_dir M_J.hsmul M_J.hfrob

  let M_mid : WeilTransvTriSheafCohomologyModel F Y₀ ℓ 1 ℳ_dir τ_dir :=
    { hCont_pr := hCont_pr
      hAdj_pr := hAdj_pr
      ℳ_bar := ℳ_bar_dir
      τ_bar := τ_bar_dir
      iso_bar := iso_bar_dir
      hτ_bar := hτ_bar_dir
      frobTorsion := frobTorsion_dir
      hfrobTorsion := hfrobTorsion_dir
      V := V_dir
      addCommGroup := instAdd_dir
      module := instMod_dir
      finite := instFin_dir
      frob := frob_dir
      sysSubgroup := sys_dir
      hsys := hsys_dir
      equiv := equiv_dir
      hsmul := hsmul_dir
      hfrob := hfrob_dir }
  exact ⟨M_mid, hFin_dir⟩

theorem weil_mid_dev_u0_adapted_block_sheaf_filtration (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
