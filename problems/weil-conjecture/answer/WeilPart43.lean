      · exact map_one cast_r
      · exact map_zero cast_r
    have hfix₀ : τ₀ (j_B r b) = j_B r b :=
      ((hρ_spec r).2.1 (j_B r b)).mp ⟨b, rfl⟩ τ₀ hτ₀_ker
    rw [hτ₀_comm, hfix₀]

  let ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1) := fun r =>
    let ι_fun : B r → B (r + 1) := fun b => Classical.choose (hι_B_ex r b)
