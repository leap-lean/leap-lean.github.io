            obtain ⟨n, u, hu, rfl⟩ := hUnitFactor x hx0
            obtain ⟨m, v, hv, rfl⟩ := hUnitFactor y hy0
            have hmul : π₂ ^ (n + m) * (u * v) = 0 := by
              calc π₂ ^ (n + m) * (u * v) = (π₂ ^ n * u) * (π₂ ^ m * v) := by ring
                _ = 0 := hxy
            exact (hu.mul hv).ne_zero (hπ₂_pow_reg (n + m) (u * v) hmul)
    have hSpecPreirredNbhd : ∀ (B : Type u) [CommRing B] [Algebra (Polynomial F) B]
        [Algebra.Etale (Polynomial F) B] (q : PrimeSpectrum B),
        ∃ O₀ : Set (PrimeSpectrum B), IsOpen O₀ ∧ q ∈ O₀ ∧ IsPreirreducible O₀ := by
      intro B _ _ _ q
      have : Algebra.FiniteType (Polynomial F) B := inferInstance
      have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing (Polynomial F) B
      have : Ideal.IsPrime q.asIdeal := q.isPrime
      let R₂ := Localization.AtPrime q.asIdeal
      have : IsDomain R₂ := hStalkDom B q
      let oIso := IsLocalization.orderIsoOfPrime q.asIdeal.primeCompl R₂
      have hbot_prime : (⊥ : Ideal R₂).IsPrime :=
        ⟨bot_ne_top, fun {a b} hab => by
          rwa [Ideal.mem_bot, mul_eq_zero, ← Ideal.mem_bot, ← Ideal.mem_bot] at hab⟩
      let botPrime : { J : Ideal R₂ // J.IsPrime } := ⟨⊥, hbot_prime⟩
      let P₀_sub := oIso botPrime
      let P₀ : Ideal B := P₀_sub.1
      have hP₀_prime : P₀.IsPrime := P₀_sub.2.1
      have hP₀_le_q : P₀ ≤ q.asIdeal := Set.disjoint_compl_left_iff_subset.mp P₀_sub.2.2
      have hP₀_least_below_q : ∀ J : Ideal B, J.IsPrime → J ≤ q.asIdeal → P₀ ≤ J := by
        intro J hJp hJle
        have hdisj : Disjoint (q.asIdeal.primeCompl : Set B) (J : Set B) :=
          Set.disjoint_compl_left_iff_subset.mpr hJle
        let J_sub : { I : Ideal B // I.IsPrime ∧ Disjoint (q.asIdeal.primeCompl : Set B) (I : Set B) } :=
          ⟨J, hJp, hdisj⟩
        have hbot_le : botPrime ≤ oIso.symm J_sub := by
          show (⊥ : Ideal R₂) ≤ (oIso.symm J_sub).1
          exact bot_le
        have hmono : oIso botPrime ≤ J_sub := by
          simpa using oIso.monotone hbot_le
        exact hmono
      have hP₀_min : P₀ ∈ minimalPrimes B := by
        refine ⟨⟨hP₀_prime, bot_le⟩, ?_⟩
        intro J ⟨hJp, _⟩ hJle
        exact hP₀_least_below_q J hJp (le_trans hJle hP₀_le_q)
      let C₀ : Set (PrimeSpectrum B) := PrimeSpectrum.zeroLocus (P₀ : Set B)
      have hC₀_mem : C₀ ∈ irreducibleComponents (PrimeSpectrum B) := by
        rw [← PrimeSpectrum.zeroLocus_minimalPrimes B]
        exact ⟨P₀, hP₀_min, rfl⟩
      have hC₀_unique : ∀ C ∈ irreducibleComponents (PrimeSpectrum B), q ∈ C → C = C₀ := by
        intro C hC hqC
        rw [← PrimeSpectrum.zeroLocus_minimalPrimes B] at hC
        rcases hC with ⟨J, hJ_min, rfl⟩
        have hJ_le_q : J ≤ q.asIdeal := hqC
        have hP₀_le_J : P₀ ≤ J := hP₀_least_below_q J hJ_min.1.1 hJ_le_q
        have hJ_le_P₀ : J ≤ P₀ := hJ_min.2 ⟨hP₀_prime, bot_le⟩ hP₀_le_J
        have hEq : J = P₀ := le_antisymm hJ_le_P₀ hP₀_le_J
        simp [C₀, hEq]
      have hFinComp : (irreducibleComponents (PrimeSpectrum B)).Finite :=
        TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
      let S_other : Set (Set (PrimeSpectrum B)) := irreducibleComponents (PrimeSpectrum B) \ {C₀}
      have hFinOther : S_other.Finite := hFinComp.sdiff
      let K : Set (PrimeSpectrum B) := ⋃ C ∈ S_other, C
      have hK_closed : IsClosed K :=
        hFinOther.isClosed_biUnion fun C hC => isClosed_of_mem_irreducibleComponents C hC.1
      have hq_not_K : q ∉ K := by
        intro hqK
        rw [Set.mem_iUnion₂] at hqK
        rcases hqK with ⟨C, hCS, hqC⟩
        exact hCS.2 (hC₀_unique C hCS.1 hqC)
      have hCompl_sub : Kᶜ ⊆ C₀ := by
        intro x hx
        by_contra hx_not
        apply hx
        rw [Set.mem_iUnion₂]
        refine ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x, ?_⟩,
          mem_irreducibleComponent⟩
        intro hEq
        rw [← Set.mem_singleton_iff.mp hEq] at hx_not
        exact hx_not mem_irreducibleComponent
      exact ⟨Kᶜ, hK_closed.isOpen_compl, hq_not_K,
        hC₀_mem.1.isPreirreducible.open_subset hK_closed.isOpen_compl hCompl_sub⟩
    have hEt_comp : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hChartPreirred : ∀ (u_i : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶ P)
        [AlgebraicGeometry.IsOpenImmersion u_i] (w : ↥W),
        h_W.base w ∈ Set.range u_i.base →
        ∃ V_w : Set ↥W, IsOpen V_w ∧ w ∈ V_w ∧ IsPreirreducible V_w := by
      intro u_i _ w hw
      let W_i := CategoryTheory.Limits.pullback h_W u_i
      let fst_i : W_i ⟶ W := CategoryTheory.Limits.pullback.fst h_W u_i
      let snd_i : W_i ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) :=
