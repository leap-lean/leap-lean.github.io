    have hRatSmul : ∀ {S W : Type u} [AddCommGroup S] [AddCommGroup W] [Module (Padic ℓ) W]
        (E : TensorProduct ℤ ℚ S ≃+ W) (a : ℚ) (s : S),
        E (TensorProduct.tmul ℤ a s) = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
      intro S W _ _ _ E a s
      let m_num : ℤ := a.num; let d_den : ℕ := a.den
      have hd_pos : 0 < d_den := a.pos
      have hd_ne_K : (d_den : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
      have hda : (d_den : ℚ) * a = (m_num : ℚ) := by
        dsimp [d_den, m_num]; rw [mul_comm]; exact Rat.mul_den_eq_num a
      have h_tens : d_den • (TensorProduct.tmul ℤ a s) =
          m_num • (TensorProduct.tmul ℤ (1 : ℚ) s) := by
        calc d_den • (TensorProduct.tmul ℤ a s)
            = (d_den : ℤ) • (TensorProduct.tmul ℤ a s) := (natCast_zsmul _ _).symm
          _ = TensorProduct.tmul ℤ ((d_den : ℤ) • a) s :=
                (TensorProduct.smul_tmul' (d_den : ℤ) a s).symm
          _ = TensorProduct.tmul ℤ ((d_den : ℚ) * a) s := by rw [zsmul_eq_mul, Int.cast_natCast]
          _ = TensorProduct.tmul ℤ (m_num • (1 : ℚ)) s := by rw [hda, zsmul_eq_mul, mul_one]
          _ = m_num • TensorProduct.tmul ℤ (1 : ℚ) s :=
                TensorProduct.smul_tmul' m_num (1 : ℚ) s
      have hE_eq : d_den • E (TensorProduct.tmul ℤ a s) =
          m_num • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
        rw [← map_nsmul, ← map_zsmul, h_tens]
      have hK_lhs : d_den • E (TensorProduct.tmul ℤ a s) =
          (d_den : Padic ℓ) • E (TensorProduct.tmul ℤ a s) :=
        (Nat.cast_smul_eq_nsmul (Padic ℓ) d_den _).symm
      have hK_rhs : m_num • E (TensorProduct.tmul ℤ (1 : ℚ) s) =
          (d_den : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) := by
        rw [← Int.cast_smul_eq_zsmul (Padic ℓ) m_num, ← mul_smul]
        congr 1
        have hda_K := congrArg (Rat.cast : ℚ → Padic ℓ) hda
        push_cast at hda_K; exact hda_K.symm
      rw [hK_lhs, hK_rhs] at hE_eq
      calc E (TensorProduct.tmul ℤ a s)
          = ((d_den : Padic ℓ)⁻¹ * (d_den : Padic ℓ)) • E (TensorProduct.tmul ℤ a s) := by
              rw [inv_mul_cancel₀ hd_ne_K, one_smul]
        _ = (d_den : Padic ℓ)⁻¹ • ((d_den : Padic ℓ) • E (TensorProduct.tmul ℤ a s)) :=
              mul_smul _ _ _
        _ = (d_den : Padic ℓ)⁻¹ •
              ((d_den : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s))) := by
              rw [hE_eq]
        _ = ((d_den : Padic ℓ)⁻¹ * (d_den : Padic ℓ)) •
              ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) :=
              (mul_smul _ _ _).symm
        _ = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
              rw [inv_mul_cancel₀ hd_ne_K, one_smul]
