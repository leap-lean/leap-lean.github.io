    constructor
    · intro f₁ f₂ hf
      ext w
      let O : Set ↥W := f₁ ⁻¹' {f₁ w} ∩ f₂ ⁻¹' {f₂ w}
      have hO_open : IsOpen O :=
        (f₁.isLocallyConstant {f₁ w}).inter (f₂.isLocallyConstant {f₂ w})
      have hwO : w ∈ O := ⟨rfl, rfl⟩
