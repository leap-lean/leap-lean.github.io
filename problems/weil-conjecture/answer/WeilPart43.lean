      change ((C_S.obj A₂).obj.map (Opposite.op (u₀ ≫ j_a a))).hom
          (((C_S.map φ).hom.app (Opposite.op Y)).hom (θ_of A₁ Y g)) =
        ((C_S.obj A₂).obj.map (Opposite.op (u₀ ≫ j_a a))).hom
          (θ_of A₂ Y (g.map φ.hom))
      have hg_ja : g.comap ((AlgebraicGeometry.Scheme.Etale.forget S).map (j_a a)).left.base.hom =
          LocallyConstant.const _ a := by
        ext z
        exact z.2
      have hg_map_ja : (g.map φ.hom).comap
          ((AlgebraicGeometry.Scheme.Etale.forget S).map (j_a a)).left.base.hom =
          LocallyConstant.const _ (φ.hom a) := by
        ext z
        show φ.hom (g z.1) = φ.hom a
        rw [show g z.1 = a from z.2]
