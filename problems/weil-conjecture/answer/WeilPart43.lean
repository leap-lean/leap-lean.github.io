          CommRingCat.hom_ext (RingHom.ext fun r => σ.symm.commutes r)
        rw [hcomm]
      have hDeck_mul : ∀ σ τ : S ≃ₐ[R] S, d_V σ ≫ d_V τ = d_V (τ * σ) := by
        intro σ τ
        dsimp only [d_V]
        rw [← AlgebraicGeometry.Spec.map_comp]
        rfl
      let A := TensorProduct R S S
      let T : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A)
