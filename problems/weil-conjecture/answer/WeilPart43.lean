                  = (e_pb.inv ≫ v_i).base q_pt := rfl
                _ = (CategoryTheory.Limits.pullback.fst p_W u_i).base q_pt := by rw [heq]
                _ = e := hq_fst
            rcases TopologicalSpace.Opens.mem_sup.mp hx_top with hxU | hxW
            · have hx_rng : h_W.base (p_W.base e) ∈ Set.range ι₀.base := hRange_ι₀.symm ▸ hxU
              rcases hx_rng with ⟨v₀_pt, hv₀_pt⟩
              obtain ⟨y₀, hy₀_fst, _⟩ :=
                AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (p_W.base e) v₀_pt hv₀_pt.symm
              let c := f_W y₀
              have hEt_uc : AlgebraicGeometry.Etale (Fgt_D.map (mor_W (Sum.inr c))).left := by
                let O_c : W_0.Opens := ⟨f_W ⁻¹' {c}, f_W.isLocallyConstant {c}⟩
                change AlgebraicGeometry.Etale (O_c.ι ≫ fst_W)
                exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _
                  inferInstance inferInstance
