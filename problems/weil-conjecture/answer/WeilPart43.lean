    (M₀ M M₂ : ℕ) (hSum : M₀ + M + M₂ = D.N)
    (P_chg : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ)
    (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℒ : ∀ r : ℕ, Quiver.Hom (ℒ₀ (r + 1)) (ℒ₀ r)) :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    letI := D.hCR; letI := D.hDom; letI := D.hFld
    letI := D.hAF_B; letI := D.hAP_B; letI := D.hAR_B
    letI := D.hAF_L; letI := D.hAP_L; letI := D.hARF_L; letI := D.hABL; letI := D.hARL
    letI := D.hST1; letI := D.hST2; letI := D.hST3; letI := D.hST4; letI := D.hST5; letI := D.hST6
    letI := D.hFin_B; letI := D.hEt_B; letI := D.hFrac; letI := D.hIntCl; letI := D.hFD_L; letI := D.hGal_L
    ∀ (triv_V : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (D.B_V r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (D.B_V r)))) D.e_U.hom
        let W_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
        ↑((D.𝒱₀ r).obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_r (Fin D.N → ZMod (ℓ ^ (r + 1)))))
      (_htriv_V : ∀ r : ℕ,
        let V_r := AlgebraicGeometry.Spec (CommRingCat.of (D.B_V r))
        let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (D.B_V r)))) D.e_U.hom
        let π_succ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (D.B_V (r + 1)))) U₀.toScheme :=
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (D.B_V (r + 1))))) D.e_U.hom
        (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
          let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
          let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
          let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
          let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
          ∀ (u_r : Quiver.Hom W₁_r W₂_r),
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.fst h₁ π_r)
                ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
            CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
              CategoryTheory.Limits.pullback.snd h₁ π_r →
            ∀ (s : ↑((D.𝒱₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
              triv_V r W₁ (((D.𝒱₀ r).obj.map (Opposite.op u)) s) y₁ =
                triv_V r W₂ s (u_r.base y₁)) ∧
        ∀ (W : U₀.toScheme.Etale),
          let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
          let W_r := CategoryTheory.Limits.pullback h_W π_r
          let W_succ := CategoryTheory.Limits.pullback h_W π_succ
          Function.Injective (triv_V r W) ∧
          Set.range (triv_V r W) =
            { f | ∀ (σ : D.B_V r ≃ₐ[R₀] D.B_V r) (m_σ : Quiver.Hom W_r W_r),
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_r →
              CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_r)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
              ∀ y : ↥W_r, f (m_σ.base y) = ((D.ρ_V r σ).val).mulVec (f y) } ∧
          ∀ (s_up : ↑((D.𝒱₀ (r + 1)).obj.obj (Opposite.op W)))
            (m_ι : Quiver.Hom W_succ W_r),
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
              CategoryTheory.Limits.pullback.fst h_W π_succ →
            CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
              CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd h_W π_succ)
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (D.ι_BV r).toRingHom)) →
            ∀ (y_up : ↥W_succ) (i : Fin D.N),
              triv_V r W (((D.τ_𝒱 r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                  (triv_V (r + 1) W s_up y_up i))
      (B L_fld : ℕ → Type u)
      [∀ r, CommRing (B r)] [∀ r, IsDomain (B r)] [∀ r, Field (L_fld r)]
      [∀ r, Algebra F (B r)] [∀ r, Algebra (Polynomial F) (B r)] [∀ r, Algebra R₀ (B r)]
      [∀ r, Algebra F (L_fld r)] [∀ r, Algebra (Polynomial F) (L_fld r)]
      [∀ r, Algebra (RatFunc F) (L_fld r)] [∀ r, Algebra (B r) (L_fld r)] [∀ r, Algebra R₀ (L_fld r)]
      [∀ r, IsScalarTower F (Polynomial F) (B r)] [∀ r, IsScalarTower (Polynomial F) R₀ (B r)]
      [∀ r, IsScalarTower F (RatFunc F) (L_fld r)]
      [∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_fld r)]
      [∀ r, IsScalarTower (Polynomial F) (B r) (L_fld r)]
      [∀ r, IsScalarTower R₀ (B r) (L_fld r)]
      [∀ r, Module.Finite R₀ (B r)] [∀ r, Algebra.Etale R₀ (B r)]
      [∀ r, IsFractionRing (B r) (L_fld r)] [∀ r, IsIntegralClosure (B r) R₀ (L_fld r)]
      [∀ r, FiniteDimensional (RatFunc F) (L_fld r)] [∀ r, IsGalois (RatFunc F) (L_fld r)]
      (ρ : ∀ r : ℕ, (B r ≃ₐ[R₀] B r) →* (Matrix (Fin M) (Fin M) (ZMod (ℓ ^ (r + 1))))ˣ)
      (ι_B : ∀ r : ℕ, B r →ₐ[R₀] B (r + 1))
      (_hι_B_compat : ∀ r : ℕ, Function.Injective (ι_B r) ∧
        ∀ τ : B (r + 1) ≃ₐ[R₀] B (r + 1),
          ∃ σ : B r ≃ₐ[R₀] B r,
            (∀ b : B r, τ (ι_B r b) = ι_B r (σ b)) ∧
            ((ρ (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
              (ρ r σ).val)
      (triv_L : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
        let V_B_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_B_r : Quiver.Hom V_B_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) D.e_U.hom
        let W_B_r := CategoryTheory.Limits.pullback
          ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_B_r
        ↑((ℒ₀ r).obj.obj (Opposite.op W)) →+
          (LocallyConstant ↥W_B_r (Fin M → ZMod (ℓ ^ (r + 1)))))
      (_htriv_L : ∀ r : ℕ,
        let V_B_r := AlgebraicGeometry.Spec (CommRingCat.of (B r))
        let π_B_r : Quiver.Hom V_B_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B r)))) D.e_U.hom
