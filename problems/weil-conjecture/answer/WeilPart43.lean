        hO₀_pre.image emb hemb_open.continuous.continuousOn⟩
    have hWPreirred : ∀ w : ↥W, ∃ V_w : Set ↥W, IsOpen V_w ∧ w ∈ V_w ∧ IsPreirreducible V_w := by
      intro w
      have hmem : h_W.base w ∈ Set.range u₀.base ∪ Set.range u₁.base := by
        rw [hCov]; trivial
