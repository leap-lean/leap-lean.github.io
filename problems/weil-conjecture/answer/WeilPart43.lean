    obtain ⟨hRaw_aff, hRaw_inf⟩ := hInert_raw r

    
    let π_r : PadicInt ℓ →+* ZMod (ℓ ^ (r + 1)) := PadicInt.toZModPow (r + 1)
    have hR0Restrict : ∀ (σ_L : L ≃ₐ[RatFunc F] L),
        ∃ τ_B : D.B_V r ≃ₐ[R₀] D.B_V r,
          ∀ b_V : D.B_V r, σ_L (algebraMap (D.B_V r) L b_V) = algebraMap (D.B_V r) L (τ_B b_V) := by
      intro σ_L
      let Δ_aff : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
      have hPF_R₀_L : ∀ p : Polynomial F,
          algebraMap R₀ L (algebraMap (Polynomial F) R₀ p) = algebraMap (Polynomial F) L p := by
        intro p
        rw [IsScalarTower.algebraMap_apply R₀ (D.B_V r) L,
          ← IsScalarTower.algebraMap_apply (Polynomial F) R₀ (D.B_V r),
          ← IsScalarTower.algebraMap_apply (Polynomial F) (D.B_V r) L]
      have hσ_PF : ∀ p : Polynomial F,
          σ_L (algebraMap (Polynomial F) L p) = algebraMap (Polynomial F) L p := by
        intro p
        rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) L, σ_L.commutes]
      have hσ_R₀ : ∀ z : R₀, σ_L (algebraMap R₀ L z) = algebraMap R₀ L z := by
        intro z
        let p := (IsLocalization.Away.sec Δ_aff z).1
        let n := (IsLocalization.Away.sec Δ_aff z).2
        have hsec : z * algebraMap (Polynomial F) R₀ (Δ_aff ^ n) = algebraMap (Polynomial F) R₀ p :=
          IsLocalization.Away.sec_spec Δ_aff z
        have hunit : IsUnit (algebraMap R₀ L (algebraMap (Polynomial F) R₀ (Δ_aff ^ n))) := by
          rw [map_pow]
          exact ((IsLocalization.Away.algebraMap_isUnit (S := R₀) Δ_aff).pow n).map (algebraMap R₀ L)
        have hmap_eq : algebraMap R₀ L z *
            algebraMap R₀ L (algebraMap (Polynomial F) R₀ (Δ_aff ^ n)) =
            algebraMap (Polynomial F) L p := by
          rw [← map_mul, hsec, hPF_R₀_L]
        have hσ_mul : σ_L (algebraMap R₀ L z) *
            algebraMap R₀ L (algebraMap (Polynomial F) R₀ (Δ_aff ^ n)) =
            algebraMap R₀ L z *
              algebraMap R₀ L (algebraMap (Polynomial F) R₀ (Δ_aff ^ n)) := by
          have h1 := congrArg σ_L hmap_eq
          rw [map_mul, hPF_R₀_L, hσ_PF, hσ_PF] at h1
          rw [hPF_R₀_L] at hmap_eq ⊢
          exact h1.trans hmap_eq.symm
        exact hunit.mul_right_cancel hσ_mul
      let σ_R₀ : L ≃ₐ[R₀] L := { σ_L.toRingEquiv with commutes' := hσ_R₀ }
      let e_BV : D.B_V r ≃ₐ[R₀] ↥(integralClosure R₀ L) :=
        IsIntegralClosure.equiv R₀ (D.B_V r) L ↥(integralClosure R₀ L)
      let τ_B : D.B_V r ≃ₐ[R₀] D.B_V r :=
        (e_BV.trans (AlgEquiv.mapIntegralClosure σ_R₀)).trans e_BV.symm
      refine ⟨τ_B, fun b_V => ?_⟩
      have he_val : ∀ x : D.B_V r, (e_BV x : L) = algebraMap (D.B_V r) L x :=
        fun x => IsIntegralClosure.algebraMap_equiv R₀ (D.B_V r) L ↥(integralClosure R₀ L) x
      rw [← he_val (τ_B b_V)]
      dsimp [τ_B]
      rw [e_BV.apply_symm_apply, AlgEquiv.coe_mapIntegralClosure, he_val b_V]
      rfl

    have hProjSGen : ∀ (σ_E : E ≃ₐ[RatFunc F] E) (σ_B : B r ≃ₐ[R₀] B r)
        (σ_L : L ≃ₐ[RatFunc F] L) (τ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
        (∀ b : B r, σ_E (algebraMap (B r) E b) = algebraMap (B r) E (σ_B b)) →
        (∀ x : E, σ_L (algebraMap E L x) = algebraMap E L (σ_E x)) →
        (∀ b_V : D.B_V r, σ_L (algebraMap (D.B_V r) L b_V) = algebraMap (D.B_V r) L (τ_B b_V)) →
        (∃ u_V ∈ D.G_V,
          (D.ρ_V r τ_B).val = (u_V.val).map π_r ∧
          ∃ g₀ ∈ D.G_V, ∃ c : K, ∀ x : Fin D.N → K,
