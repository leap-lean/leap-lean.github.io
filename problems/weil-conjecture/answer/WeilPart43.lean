                        (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) ∧
      (w_inf ≠ 0 →
        (∃ φ_inf : (Fin D.N → Padic ℓ) →ₗ[Padic ℓ] Padic ℓ,
