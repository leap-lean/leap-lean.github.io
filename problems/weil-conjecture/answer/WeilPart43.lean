        constructor
        · rintro ⟨w, rfl⟩
          change Ψ.base (Φ.base ((δ σ).base w)) ∈ Set.range (δ σ).base
          have hpt : Ψ.base (Φ.base ((δ σ).base w)) = (δ σ).base w :=
            congrArg (fun m : P_W ⟶ P_W => m.base ((δ σ).base w)) hΦΨ
          rw [hpt]
          exact ⟨w, rfl⟩
        · rintro ⟨w, hw⟩
          refine ⟨w, ?_⟩
          have hpt : Φ.base (Ψ.base y) = y :=
            congrArg (fun m : W_r ⟶ W_r => m.base y) hΨΦ
          change Φ.base ((δ σ).base w) = y
          rw [hw, hpt]
      have hδ'_open : ∀ σ : B_V ≃ₐ[R₀] B_V, IsOpen (Set.range (δ' σ).base) := by
        intro σ
        rw [hδ'_range σ]
        exact ((hδ_spec σ).2.2.2).preimage (AlgebraicGeometry.Scheme.Hom.continuous Ψ)
      have hδ'_disj : ∀ σ₁ σ₂ : B_V ≃ₐ[R₀] B_V, σ₁ ≠ σ₂ →
          Disjoint (Set.range (δ' σ₁).base) (Set.range (δ' σ₂).base) := by
        intro σ₁ σ₂ hne
        rw [hδ'_range σ₁, hδ'_range σ₂]
        exact (hδ_disj σ₁ σ₂ hne).preimage Ψ.base
      have hδ'_cov : (⋃ σ : B_V ≃ₐ[R₀] B_V, Set.range (δ' σ).base) = Set.univ := by
        ext y
        simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
        have hmem : Ψ.base y ∈ (Set.univ : Set ↥P_W) := Set.mem_univ _
        rw [← hδ_cov, Set.mem_iUnion] at hmem
        rcases hmem with ⟨σ, hσ⟩
        exact ⟨σ, (hδ'_range σ).symm ▸ hσ⟩
      have hδ'_mul : ∀ (σ τ : B_V ≃ₐ[R₀] B_V) (m_τ : W_r ⟶ W_r),
          m_τ ≫ CategoryTheory.Limits.pullback.fst h_W π_r =
            CategoryTheory.Limits.pullback.fst h_W π_r →
          m_τ ≫ CategoryTheory.Limits.pullback.snd h_W π_r =
            CategoryTheory.Limits.pullback.snd h_W π_r ≫ d_V τ →
          δ' σ ≫ m_τ = δ' (τ * σ) := by
        intro σ τ m_τ hm1 hm2
        let m'_τ : P_W ⟶ P_W := Φ ≫ m_τ ≫ Ψ
        have hm'_fst : m'_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r) π_r =
            CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r) π_r :=
          (CategoryTheory.Category.assoc Φ (m_τ ≫ Ψ) _).trans
            ((congrArg (Φ ≫ ·)
              ((CategoryTheory.Category.assoc m_τ Ψ _).trans
                ((congrArg (m_τ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  hm1))).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _))
        have hm'_snd : m'_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r) π_r =
            CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r) π_r ≫ d_V τ :=
          (CategoryTheory.Category.assoc Φ (m_τ ≫ Ψ) _).trans
            ((congrArg (Φ ≫ ·)
              ((CategoryTheory.Category.assoc m_τ Ψ _).trans
                ((congrArg (m_τ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                  hm2))).trans
              ((CategoryTheory.Category.assoc Φ _ _).symm.trans
                (congrArg (· ≫ d_V τ) (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
        have heq := hδ_mul σ τ m'_τ hm'_fst hm'_snd
        calc
          δ' σ ≫ m_τ = δ σ ≫ Φ ≫ m_τ ≫ 𝟙 W_r := by
            simp only [δ', CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc]
          _ = δ σ ≫ Φ ≫ m_τ ≫ (Ψ ≫ Φ) := by rw [hΨΦ]
          _ = (δ σ ≫ m'_τ) ≫ Φ := by simp only [m'_τ, CategoryTheory.Category.assoc]
          _ = δ' (τ * σ) := by rw [heq]
      refine ⟨δ', hδ'_fst, hδ'_cov,
        fun σ τ => hδ'_mul σ τ (m_act W τ) (hm_fst W τ) (hm_snd W τ), ?_⟩
      intro K_dim ρ_X φ₀
      have hEx_σ : ∀ y : ↥W_r, ∃ σ : B_V ≃ₐ[R₀] B_V, y ∈ Set.range (δ' σ).base := by
        intro y
        have hy : y ∈ (Set.univ : Set ↥W_r) := Set.mem_univ y
        rwa [← hδ'_cov, Set.mem_iUnion] at hy
      let σ_of : ↥W_r → (B_V ≃ₐ[R₀] B_V) := fun y => Classical.choose (hEx_σ y)
      have hσ_of_mem : ∀ y : ↥W_r, y ∈ Set.range (δ' (σ_of y)).base :=
        fun y => Classical.choose_spec (hEx_σ y)
      have hσ_of_eq : ∀ (σ : B_V ≃ₐ[R₀] B_V) {y : ↥W_r},
          y ∈ Set.range (δ' σ).base → σ_of y = σ := by
        intro σ y hy
        by_contra hne
        exact Set.disjoint_left.mp (hδ'_disj (σ_of y) σ hne) (hσ_of_mem y) hy
      let fst_cont : C(↥W_r, ↥Y_left) :=
        ⟨(CategoryTheory.Limits.pullback.fst h_W π_r).base,
          AlgebraicGeometry.Scheme.Hom.continuous _⟩
      let h_loc : (B_V ≃ₐ[R₀] B_V) → LocallyConstant ↥W_r (Fin K_dim → ZMod m_mod) :=
        fun σ => (φ₀.comap fst_cont).map (fun v => ((ρ_X σ).val).mulVec v)
      let F_raw : ↥W_r → (Fin K_dim → ZMod m_mod) :=
        fun y => ((ρ_X (σ_of y)).val).mulVec (φ₀ (fst_cont y))
      have hF_on_U : ∀ (σ : B_V ≃ₐ[R₀] B_V) {y : ↥W_r},
          y ∈ Set.range (δ' σ).base → F_raw y = h_loc σ y := by
        intro σ y hy
        dsimp only [F_raw, h_loc]
        rw [hσ_of_eq σ hy]
        rfl
      have hF_loc : IsLocallyConstant F_raw := by
        intro S
        have hpre : F_raw ⁻¹' S =
            ⋃ σ : B_V ≃ₐ[R₀] B_V, (Set.range (δ' σ).base ∩ ((h_loc σ) ⁻¹' S)) := by
          ext y
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff]
          constructor
          · intro hyS
            refine ⟨σ_of y, hσ_of_mem y, ?_⟩
            rw [← hF_on_U (σ_of y) (hσ_of_mem y)]
            exact hyS
          · rintro ⟨σ, hyU, hyh⟩
            rw [hF_on_U σ hyU]
            exact hyh
        rw [hpre]
        exact isOpen_iUnion fun σ => (hδ'_open σ).inter ((h_loc σ).isLocallyConstant S)
      let F : LocallyConstant ↥W_r (Fin K_dim → ZMod m_mod) := ⟨F_raw, hF_loc⟩
      have hF_sheet : ∀ (σ : B_V ≃ₐ[R₀] B_V) (x : ↥Y_left),
          F ((δ' σ).base x) = ((ρ_X σ).val).mulVec (φ₀ x) := by
        intro σ x
        change F_raw ((δ' σ).base x) = ((ρ_X σ).val).mulVec (φ₀ x)
        rw [hF_on_U σ ⟨x, rfl⟩]
        have hfst_x : fst_cont ((δ' σ).base x) = x :=
          congrArg (fun m : Y_left ⟶ Y_left => m.base x) (hδ'_fst σ)
        change ((ρ_X σ).val).mulVec (φ₀ (fst_cont ((δ' σ).base x))) =
          ((ρ_X σ).val).mulVec (φ₀ x)
        rw [hfst_x]
      refine ⟨F, hF_sheet, ?_⟩
      intro τ m_τ hm1 hm2 y
      obtain ⟨σ, x, rfl⟩ := hEx_σ y
      have hmul_pt : m_τ.base ((δ' σ).base x) = (δ' (τ * σ)).base x := by
        have h := congrArg (fun m : Y_left ⟶ W_r => m.base x) (hδ'_mul σ τ m_τ hm1 hm2)
        simpa only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h
      rw [hmul_pt, hF_sheet (τ * σ) x, hF_sheet σ x, map_mul, Units.val_mul, ← Matrix.mulVec_mulVec]

    have hMidBlock : ∀ (τ : B_V ≃ₐ[R₀] B_V) (v : Fin M → ZMod m_mod),
        ((ρ (res τ)).val).mulVec v =
          (Matrix.of fun k₁ k₂ : Fin M =>
            (P_inv_r * (ρ_V τ).val * P_r) ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩).mulVec v := by
      intro τ v
      have : AlgebraicGeometry.Etale π_r := hEt_π
      let W₀ : U.Etale := AlgebraicGeometry.Scheme.Etale.mk π_r
      let Y₀_left := ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₀).left
      have hg_W₀ : (𝟙 V_r : Y₀_left ⟶ V_r) ≫ π_r =
          ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₀).hom :=
        CategoryTheory.Category.id_comp π_r
      obtain ⟨δ'_0, _, _, hδ'_0_mul, hExt₀⟩ := hDiagExt W₀ (𝟙 V_r) hg_W₀
      let e₀ : Fin (M₀ + M) → ZMod m_mod :=
        fun i => if hi : i.1 < M₀ then 0 else v ⟨i.1 - M₀, by omega⟩
      obtain ⟨F_E, hFE_sheet, hFE_eqv⟩ := hExt₀ (M₀ + M) ρ_ℰ (LocallyConstant.const ↥Y₀_left e₀)
      have hFE_mem : F_E ∈ Set.range (triv_ℰ W₀) := by
        rw [(_htriv_ℰ W₀).2]
        exact hFE_eqv
      rcases hFE_mem with ⟨s_E, hs_E⟩
      let z₀ : ↥Y₀_left := Classical.arbitrary ↥V_r
      let y₁ := (δ'_0 1).base z₀
      let y_τ := (δ'_0 τ).base z₀
      have hy_τ_eq : (m_act W₀ τ).base y₁ = y_τ := by
        have h := congrArg (fun m => m.base z₀) (hδ'_0_mul 1 τ)
        rw [mul_one, AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp,
          Function.comp_apply] at h
        exact h
      let f_L₀ := triv_L W₀ ((π_ℒ.hom.app (Opposite.op W₀)) s_E)
      have hf_L₀_y₁ : f_L₀ ((q_can W₀).base y₁) = v := by
        funext k
        have hc := (_hCoord W₀).2 (q_can W₀) (hq_fst W₀) (hq_snd W₀) s_E y₁ k
        change f_L₀ ((q_can W₀).base y₁) k = _ at hc
        rw [hc, hs_E, hFE_sheet 1 z₀, map_one, Units.val_one, Matrix.one_mulVec]
        change e₀ ⟨M₀ + k.1, by omega⟩ = v k
        have hnot : ¬ (M₀ + k.1 < M₀) := by omega
        simp only [e₀, hnot, ↓reduceDIte]
        exact congrArg v (Fin.ext (Nat.add_sub_cancel_left M₀ k.1))
      have hf_L₀_mem : f_L₀ ∈ Set.range (triv_L W₀) := ⟨(π_ℒ.hom.app (Opposite.op W₀)) s_E, rfl⟩
      rw [(_htriv_L W₀).2] at hf_L₀_mem
      have hWay1 : f_L₀ ((q_can W₀).base y_τ) = ((ρ (res τ)).val).mulVec v := by
        rw [← hy_τ_eq, hm_q_base W₀ τ y₁,
          hf_L₀_mem (res τ) (m_B_act W₀ (res τ)) (hm_B_fst W₀ (res τ)) (hm_B_snd W₀ (res τ))
            ((q_can W₀).base y₁),
          hf_L₀_y₁]
      funext k₁
      rw [← hWay1]
      have hc := (_hCoord W₀).2 (q_can W₀) (hq_fst W₀) (hq_snd W₀) s_E y_τ k₁
      change f_L₀ ((q_can W₀).base y_τ) k₁ = _ at hc
      rw [hc, hs_E, hFE_sheet τ z₀]
      change (((ρ_ℰ τ).val).mulVec e₀) ⟨M₀ + k₁.1, by omega⟩ = _
      dsimp only [Matrix.mulVec, dotProduct, Matrix.of_apply]
      rw [Fin.sum_univ_add]
      have hSum1 : (∑ i : Fin M₀,
          (ρ_ℰ τ).val ⟨M₀ + k₁.1, by omega⟩ (Fin.castAdd M i) * e₀ (Fin.castAdd M i)) = 0 := by
        apply Finset.sum_eq_zero
        intro i _
        have hi : (Fin.castAdd M i).1 < M₀ := i.2
        simp only [e₀, hi, ↓reduceDIte, mul_zero]
      rw [hSum1, zero_add]
      refine Finset.sum_congr rfl fun k₂ _ => ?_
      have hnatAdd : Fin.natAdd M₀ k₂ = ⟨M₀ + k₂.1, by omega⟩ := by
        ext
        simp [Fin.natAdd]
      rw [hnatAdd, (_hρ_blocks τ).1 ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩]
      have hnot : ¬ (M₀ + k₂.1 < M₀) := by omega
      simp only [e₀, hnot, ↓reduceDIte]
      exact congrArg (_ * ·) (congrArg v (Fin.ext (Nat.add_sub_cancel_left M₀ k₂.1)))

    refine ⟨?_, ?_⟩
    · 
      intro H_I C₀ hC₀_ne hC₀_clopen hC₀_preconn hCov hCoset n₁ n₂
      have hCov' : ∀ y : ↥W'_r, ∃ σ : B_V ≃ₐ[R₀] B_V, y ∈ (m_act W' σ).base '' C₀ := by
        intro y
        obtain ⟨σ, m_σ, hm1, hm2, hy⟩ := hCov y
        rw [hm_uniq W' σ m_σ hm1 hm2] at hy
        exact ⟨σ, hy⟩
      have hCoset_mem : ∀ σ : B_V ≃ₐ[R₀] B_V,
          σ ∈ H_I → (m_act W' σ).base '' C₀ ⊆ C₀ :=
        fun σ => (hCoset σ (m_act W' σ) (hm_fst W' σ) (hm_snd W' σ)).1
      have hCoset_disj : ∀ σ : B_V ≃ₐ[R₀] B_V,
          σ ∉ H_I → Disjoint C₀ ((m_act W' σ).base '' C₀) :=
        fun σ => (hCoset σ (m_act W' σ) (hm_fst W' σ) (hm_snd W' σ)).2
      have hCoset_eq_pre : ∀ σ : B_V ≃ₐ[R₀] B_V,
          (m_act W' σ).base '' C₀ = (m_act W' σ⁻¹).base ⁻¹' C₀ := by
        intro σ
        ext y
        constructor
        · rintro ⟨c, hc, rfl⟩
          change (m_act W' σ⁻¹).base ((m_act W' σ).base c) ∈ C₀
          rw [hm_base_inv_left W' σ c]
          exact hc
        · intro hy
          refine ⟨(m_act W' σ⁻¹).base y, hy, ?_⟩
          exact hm_base_inv_right W' σ y
      have hOpen_coset : ∀ σ : B_V ≃ₐ[R₀] B_V, IsOpen ((m_act W' σ).base '' C₀) := by
        intro σ
        rw [hCoset_eq_pre σ]
        exact hC₀_clopen.isOpen.preimage (AlgebraicGeometry.Scheme.Hom.continuous (m_act W' σ⁻¹))
      have hOverlap : ∀ {σ₁ σ₂ : B_V ≃ₐ[R₀] B_V} {y : ↥W'_r},
          y ∈ (m_act W' σ₁).base '' C₀ → y ∈ (m_act W' σ₂).base '' C₀ →
          σ₁⁻¹ * σ₂ ∈ H_I := by
        rintro σ₁ σ₂ y ⟨c₁, hc₁, rfl⟩ ⟨c₂, hc₂, hy₂⟩
        by_contra hnot
        have hc₁_mem : c₁ ∈ (m_act W' (σ₁⁻¹ * σ₂)).base '' C₀ := by
          refine ⟨c₂, hc₂, ?_⟩
          rw [← hm_base_mul W' σ₁⁻¹ σ₂ c₂, hy₂, hm_base_inv_left W' σ₁ c₁]
        exact Set.disjoint_left.mp (hCoset_disj (σ₁⁻¹ * σ₂) hnot) hc₁ hc₁_mem

      have hCosetExt : ∀ (K_dim : ℕ)
          (ρ_X : (B_V ≃ₐ[R₀] B_V) →* (Matrix (Fin K_dim) (Fin K_dim) (ZMod m_mod))ˣ)
          (v_hat : Fin K_dim → ZMod m_mod),
          (∀ τ ∈ H_I, ((ρ_X τ).val).mulVec v_hat = v_hat) →
          ∃ F : LocallyConstant ↥W'_r (Fin K_dim → ZMod m_mod),
            (∀ c ∈ C₀, F c = v_hat) ∧
            (∀ (γ : B_V ≃ₐ[R₀] B_V) (m_γ : W'_r ⟶ W'_r),
              m_γ ≫ CategoryTheory.Limits.pullback.fst h_W' π_r =
                CategoryTheory.Limits.pullback.fst h_W' π_r →
              m_γ ≫ CategoryTheory.Limits.pullback.snd h_W' π_r =
                CategoryTheory.Limits.pullback.snd h_W' π_r ≫ d_V γ →
              ∀ y : ↥W'_r, F (m_γ.base y) = ((ρ_X γ).val).mulVec (F y)) := by
        intro K_dim ρ_X v_hat hv_inv
        let σ_cos : ↥W'_r → (B_V ≃ₐ[R₀] B_V) := fun y => Classical.choose (hCov' y)
        have hσ_cos : ∀ y : ↥W'_r, y ∈ (m_act W' (σ_cos y)).base '' C₀ :=
          fun y => Classical.choose_spec (hCov' y)
        let F_raw : ↥W'_r → (Fin K_dim → ZMod m_mod) :=
          fun y => ((ρ_X (σ_cos y)).val).mulVec v_hat
        have hF_coset : ∀ (σ : B_V ≃ₐ[R₀] B_V) {y : ↥W'_r},
            y ∈ (m_act W' σ).base '' C₀ → F_raw y = ((ρ_X σ).val).mulVec v_hat := by
          intro σ y hy
          have hτ : σ⁻¹ * σ_cos y ∈ H_I := hOverlap hy (hσ_cos y)
          dsimp only [F_raw]
          have hdecomp : σ_cos y = σ * (σ⁻¹ * σ_cos y) := (mul_inv_cancel_left σ (σ_cos y)).symm
          conv_lhs => rw [hdecomp]
          rw [map_mul, Units.val_mul, ← Matrix.mulVec_mulVec, hv_inv _ hτ]
        have hF_loc : IsLocallyConstant F_raw := by
          intro S
          have hpre : F_raw ⁻¹' S =
              ⋃ (σ : B_V ≃ₐ[R₀] B_V) (_ : ((ρ_X σ).val).mulVec v_hat ∈ S),
                (m_act W' σ).base '' C₀ := by
            ext y
            simp only [Set.mem_preimage, Set.mem_iUnion]
            constructor
            · intro hyS
              exact ⟨σ_cos y, hyS, hσ_cos y⟩
            · rintro ⟨σ, hvalS, hyC⟩
              rw [hF_coset σ hyC]
              exact hvalS
          rw [hpre]
          exact isOpen_iUnion fun σ => isOpen_iUnion fun _ => hOpen_coset σ
        let F : LocallyConstant ↥W'_r (Fin K_dim → ZMod m_mod) := ⟨F_raw, hF_loc⟩
        refine ⟨F, ?_, ?_⟩
        · intro c hc
          have hc1 : c ∈ (m_act W' 1).base '' C₀ := ⟨c, hc, hm_base_one W' c⟩
          change F_raw c = v_hat
          rw [hF_coset 1 hc1, map_one, Units.val_one, Matrix.one_mulVec]
        · intro γ m_γ hm1 hm2 y
          rw [hm_uniq W' γ m_γ hm1 hm2]
          rcases hCov' y with ⟨σ, c, hc, rfl⟩
          have hy_mem : (m_act W' σ).base c ∈ (m_act W' σ).base '' C₀ := ⟨c, hc, rfl⟩
          have hγy_mem : (m_act W' γ).base ((m_act W' σ).base c) ∈
              (m_act W' (γ * σ)).base '' C₀ :=
            ⟨c, hc, (hm_base_mul W' γ σ c).symm⟩
          change F_raw ((m_act W' γ).base ((m_act W' σ).base c)) =
            ((ρ_X γ).val).mulVec (F_raw ((m_act W' σ).base c))
          rw [hF_coset (γ * σ) hγy_mem, hF_coset σ hy_mem,
            map_mul, Units.val_mul, ← Matrix.mulVec_mulVec]

      rcases hC₀_ne with ⟨y₀, hy₀⟩
      refine ⟨?_, ?_⟩
      · intro hVecQ s_Q
        let f_Q := triv_𝒬 W' s_Q
        let q_mod := f_Q y₀
        obtain ⟨x_hat, hx_coord, hx_inv⟩ := hVecQ q_mod
        obtain ⟨F_V, hFV_C₀, hFV_eqv⟩ := hCosetExt N ρ_V x_hat hx_inv
        have hFV_mem : F_V ∈ Set.range (triv_V W') := by
          rw [(_htriv_V W').2]
          exact hFV_eqv
        rcases hFV_mem with ⟨s_V, hs_V⟩
        refine ⟨s_V, ?_⟩
        apply (_htriv_𝒬 W').1
        let lhs := triv_𝒬 W' ((π_𝒬.hom.app (Opposite.op W')) s_V)
        let rhs := triv_𝒬 W' (n₁ • s_Q)
        have hlhs_mem : lhs ∈ Set.range (triv_𝒬 W') := ⟨_, rfl⟩
        have hrhs_mem : rhs ∈ Set.range (triv_𝒬 W') := ⟨_, rfl⟩
        rw [(_htriv_𝒬 W').2] at hlhs_mem hrhs_mem
        have hOnC₀ : ∀ c ∈ C₀, lhs c = rhs c := by
          intro c hc
          have hfc : f_Q c = q_mod := f_Q.apply_eq_of_isPreconnected hC₀_preconn hc hy₀
          funext k
          have hc_coord := (_hCoord W').1 s_V c k
          change lhs c k = _ at hc_coord
          rw [hc_coord, hs_V, hFV_C₀ c hc, hx_coord k, ← hfc]
          dsimp only [rhs, f_Q]
          rw [map_nsmul, LocallyConstant.smul_apply, Pi.smul_apply]
        apply LocallyConstant.ext
        intro y
        rcases hCov' y with ⟨σ, c, hc, rfl⟩
        change lhs ((m_act W' σ).base c) = rhs ((m_act W' σ).base c)
        rw [hlhs_mem σ (m_act W' σ) (hm_fst W' σ) (hm_snd W' σ) c,
          hrhs_mem σ (m_act W' σ) (hm_fst W' σ) (hm_snd W' σ) c,
          hOnC₀ c hc]
      · intro hVecL s_L
        let f_L := triv_L W' s_L
        let f_L_pb : LocallyConstant ↥W'_r (Fin M → ZMod m_mod) :=
          f_L.comap ⟨(q_can W').base, AlgebraicGeometry.Scheme.Hom.continuous (q_can W')⟩
        let v_mod := f_L_pb y₀
        have hf_L_mem : f_L ∈ Set.range (triv_L W') := ⟨s_L, rfl⟩
        rw [(_htriv_L W').2] at hf_L_mem
        have hv_mod_inv : ∀ τ ∈ H_I,
            let A_adap := P_inv_r * (ρ_V τ).val * P_r
            (Matrix.of fun k₁ k₂ : Fin M =>
              A_adap ⟨M₀ + k₁.1, by omega⟩ ⟨M₀ + k₂.1, by omega⟩).mulVec v_mod = v_mod := by
          intro τ hτ
          have hτy₀ : (m_act W' τ).base y₀ ∈ C₀ := hCoset_mem τ hτ ⟨y₀, hy₀, rfl⟩
          have hconst : f_L_pb ((m_act W' τ).base y₀) = v_mod :=
            f_L_pb.apply_eq_of_isPreconnected hC₀_preconn hτy₀ hy₀
          have heqv : f_L_pb ((m_act W' τ).base y₀) = ((ρ (res τ)).val).mulVec v_mod := by
            change f_L ((q_can W').base ((m_act W' τ).base y₀)) =
              ((ρ (res τ)).val).mulVec (f_L ((q_can W').base y₀))
            rw [hm_q_base W' τ y₀]
            exact hf_L_mem (res τ) (m_B_act W' (res τ))
              (hm_B_fst W' (res τ)) (hm_B_snd W' (res τ)) ((q_can W').base y₀)
          dsimp only
          rw [← hMidBlock τ v_mod, ← heqv, hconst]
        obtain ⟨e_hat, _, he_coord, he_inv⟩ := hVecL v_mod hv_mod_inv
        obtain ⟨F_E, hFE_C₀, hFE_eqv⟩ := hCosetExt (M₀ + M) ρ_ℰ e_hat he_inv
        have hFE_mem : F_E ∈ Set.range (triv_ℰ W') := by
          rw [(_htriv_ℰ W').2]
          exact hFE_eqv
        rcases hFE_mem with ⟨s_E, hs_E⟩
        refine ⟨s_E, ?_⟩
        apply (_htriv_L W').1
        let lhs := triv_L W' ((π_ℒ.hom.app (Opposite.op W')) s_E)
        let rhs := triv_L W' (n₂ • s_L)
        have hlhs_mem : lhs ∈ Set.range (triv_L W') := ⟨_, rfl⟩
        have hrhs_mem : rhs ∈ Set.range (triv_L W') := ⟨_, rfl⟩
        rw [(_htriv_L W').2] at hlhs_mem hrhs_mem
        have hOnC₀ : ∀ c ∈ C₀, lhs ((q_can W').base c) = rhs ((q_can W').base c) := by
          intro c hc
          have hfc : f_L ((q_can W').base c) = v_mod :=
            f_L_pb.apply_eq_of_isPreconnected hC₀_preconn hc hy₀
          funext k
          have hc_coord := (_hCoord W').2 (q_can W') (hq_fst W') (hq_snd W') s_E c k
          change lhs ((q_can W').base c) k = _ at hc_coord
          rw [hc_coord, hs_E, hFE_C₀ c hc, he_coord k, ← hfc]
          dsimp only [rhs, f_L]
          rw [map_nsmul, LocallyConstant.smul_apply, Pi.smul_apply]
        apply LocallyConstant.ext
        intro z
        obtain ⟨y, rfl⟩ := hq_surj W' z
        rcases hCov' y with ⟨σ, c, hc, rfl⟩
        change lhs ((q_can W').base ((m_act W' σ).base c)) =
          rhs ((q_can W').base ((m_act W' σ).base c))
        rw [hm_q_base W' σ c,
          hlhs_mem (res σ) (m_B_act W' (res σ))
            (hm_B_fst W' (res σ)) (hm_B_snd W' (res σ)) ((q_can W').base c),
          hrhs_mem (res σ) (m_B_act W' (res σ))
            (hm_B_fst W' (res σ)) (hm_B_snd W' (res σ)) ((q_can W').base c),
          hOnC₀ c hc]

    · 
      rintro ⟨g_Y, hg_Y⟩ n₁ n₂
      obtain ⟨δ', _, hδ'_cov, hδ'_mul, hExt⟩ := hDiagExt W' g_Y hg_Y
      have hEx_σ : ∀ y : ↥W'_r, ∃ σ : B_V ≃ₐ[R₀] B_V, y ∈ Set.range (δ' σ).base := by
        intro y
        have hy : y ∈ (Set.univ : Set ↥W'_r) := Set.mem_univ y
        rwa [← hδ'_cov, Set.mem_iUnion] at hy
      refine ⟨?_, ?_⟩
      · intro s_Q
        let f_Q := triv_𝒬 W' s_Q
        let pad_Q : (Fin M₂ → ZMod m_mod) → (Fin N → ZMod m_mod) :=
          fun q => P_r.mulVec
            (fun i : Fin N => if hi : M₀ + M ≤ i.1 then n₁ • q ⟨i.1 - (M₀ + M), by omega⟩ else 0)
        let φ₀_Q := (f_Q.comap ⟨(δ' 1).base, AlgebraicGeometry.Scheme.Hom.continuous (δ' 1)⟩).map pad_Q
        obtain ⟨F_V, hFV_sheet, hFV_eqv⟩ := hExt N ρ_V φ₀_Q
        have hFV_mem : F_V ∈ Set.range (triv_V W') := by
          rw [(_htriv_V W').2]
          exact hFV_eqv
        rcases hFV_mem with ⟨s_V, hs_V⟩
        refine ⟨s_V, ?_⟩
        apply (_htriv_𝒬 W').1
        let lhs := triv_𝒬 W' ((π_𝒬.hom.app (Opposite.op W')) s_V)
        let rhs := triv_𝒬 W' (n₁ • s_Q)
        have hlhs_mem : lhs ∈ Set.range (triv_𝒬 W') := ⟨_, rfl⟩
        have hrhs_mem : rhs ∈ Set.range (triv_𝒬 W') := ⟨_, rfl⟩
        rw [(_htriv_𝒬 W').2] at hlhs_mem hrhs_mem
        have hOn1 : ∀ x : ↥(((AlgebraicGeometry.Scheme.Etale.forget U).obj W').left),
            lhs ((δ' 1).base x) = rhs ((δ' 1).base x) := by
          intro x
          funext k
          have hc := (_hCoord W').1 s_V ((δ' 1).base x) k
          change lhs ((δ' 1).base x) k = _ at hc
          rw [hc, hs_V, hFV_sheet 1 x, map_one, Units.val_one, Matrix.one_mulVec]
          change (P_inv_r.mulVec (pad_Q (f_Q ((δ' 1).base x)))) ⟨M₀ + M + k.1, by omega⟩ =
            rhs ((δ' 1).base x) k
          dsimp only [pad_Q]
          rw [Matrix.mulVec_mulVec, _hP_inv_mul, Matrix.one_mulVec]
          have hge : M₀ + M ≤ M₀ + M + k.1 := by omega
          simp only [hge, ↓reduceDIte]
          have hidx : (⟨(M₀ + M + k.1) - (M₀ + M), by omega⟩ : Fin M₂) = k :=
            Fin.ext (Nat.add_sub_cancel_left (M₀ + M) k.1)
          rw [hidx]
          dsimp only [rhs, f_Q]
          rw [map_nsmul, LocallyConstant.smul_apply, Pi.smul_apply]
        apply LocallyConstant.ext
        intro y
        obtain ⟨τ, x, rfl⟩ := hEx_σ y
        have hy_τ : (δ' τ).base x = (m_act W' τ).base ((δ' 1).base x) := by
          have h := congrArg (fun m => m.base x) (hδ'_mul 1 τ).symm
          rw [mul_one] at h
          simpa only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h
        change lhs ((δ' τ).base x) = rhs ((δ' τ).base x)
        rw [hy_τ,
          hlhs_mem τ (m_act W' τ) (hm_fst W' τ) (hm_snd W' τ) ((δ' 1).base x),
          hrhs_mem τ (m_act W' τ) (hm_fst W' τ) (hm_snd W' τ) ((δ' 1).base x),
          hOn1 x]
      · intro s_L
        let f_L := triv_L W' s_L
        let pad_L : (Fin M → ZMod m_mod) → (Fin (M₀ + M) → ZMod m_mod) :=
          fun v i => if hi : i.1 < M₀ then 0 else n₂ • v ⟨i.1 - M₀, by omega⟩
        let φ₀_L := (f_L.comap
          ⟨(δ' 1 ≫ q_can W').base, AlgebraicGeometry.Scheme.Hom.continuous _⟩).map pad_L
        obtain ⟨F_E, hFE_sheet, hFE_eqv⟩ := hExt (M₀ + M) ρ_ℰ φ₀_L
        have hFE_mem : F_E ∈ Set.range (triv_ℰ W') := by
          rw [(_htriv_ℰ W').2]
          exact hFE_eqv
        rcases hFE_mem with ⟨s_E, hs_E⟩
        refine ⟨s_E, ?_⟩
        apply (_htriv_L W').1
        let lhs := triv_L W' ((π_ℒ.hom.app (Opposite.op W')) s_E)
        let rhs := triv_L W' (n₂ • s_L)
        have hlhs_mem : lhs ∈ Set.range (triv_L W') := ⟨_, rfl⟩
        have hrhs_mem : rhs ∈ Set.range (triv_L W') := ⟨_, rfl⟩
        rw [(_htriv_L W').2] at hlhs_mem hrhs_mem
        have hOn1 : ∀ x : ↥(((AlgebraicGeometry.Scheme.Etale.forget U).obj W').left),
            lhs ((q_can W').base ((δ' 1).base x)) = rhs ((q_can W').base ((δ' 1).base x)) := by
          intro x
          funext k
          have hc := (_hCoord W').2 (q_can W') (hq_fst W') (hq_snd W') s_E ((δ' 1).base x) k
          change lhs ((q_can W').base ((δ' 1).base x)) k = _ at hc
          rw [hc, hs_E, hFE_sheet 1 x, map_one, Units.val_one, Matrix.one_mulVec]
          change pad_L (f_L ((δ' 1 ≫ q_can W').base x)) ⟨M₀ + k.1, by omega⟩ =
            rhs ((q_can W').base ((δ' 1).base x)) k
          have hnot : ¬ (M₀ + k.1 < M₀) := by omega
          simp only [pad_L, hnot, ↓reduceDIte]
          have hidx : (⟨(M₀ + k.1) - M₀, by omega⟩ : Fin M) = k :=
            Fin.ext (Nat.add_sub_cancel_left M₀ k.1)
          rw [hidx]
          have hcomp_pt : (δ' 1 ≫ q_can W').base x = (q_can W').base ((δ' 1).base x) := by
            rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply]
          rw [hcomp_pt]
          dsimp only [rhs, f_L]
          rw [map_nsmul, LocallyConstant.smul_apply, Pi.smul_apply]
        apply LocallyConstant.ext
        intro z
        obtain ⟨y, rfl⟩ := hq_surj W' z
        obtain ⟨τ, x, rfl⟩ := hEx_σ y
        have hy_τ : (δ' τ).base x = (m_act W' τ).base ((δ' 1).base x) := by
          have h := congrArg (fun m => m.base x) (hδ'_mul 1 τ).symm
          rw [mul_one] at h
          simpa only [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply] using h
        change lhs ((q_can W').base ((δ' τ).base x)) = rhs ((q_can W').base ((δ' τ).base x))
        rw [hy_τ, hm_q_base W' τ ((δ' 1).base x),
          hlhs_mem (res τ) (m_B_act W' (res τ))
            (hm_B_fst W' (res τ)) (hm_B_snd W' (res τ)) ((q_can W').base ((δ' 1).base x)),
          hrhs_mem (res τ) (m_B_act W' (res τ))
            (hm_B_fst W' (res τ)) (hm_B_snd W' (res τ)) ((q_can W').base ((δ' 1).base x)),
          hOn1 x]

theorem weil_mid_dev_puncture_cokernel_uniform_annihilation (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    (u₀ : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hu₀_sec : u₀ ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (Z_u₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (hj_open : AlgebraicGeometry.IsOpenImmersion j_aff)
    (hj_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (hsinf_sec : s_inf ≫ (weilProjectiveSpaceOver F 1).hom =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (hsinf_compl : (Set.range j_aff.base)ᶜ = Set.range s_inf.base)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (hU₀_eq : (U₀ : Set (weilProjectiveSpaceOver F 1).left) =
      j_aff.base '' { p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) |
        ∀ a ∈ S_aff, Polynomial.X - Polynomial.C a ∉ p.asIdeal })
    (hu₀_mem : Set.range u₀.base ⊆ (U₀ : Set (weilProjectiveSpaceOver F 1).left))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_Zu_mid : WeilEllAdicCohomologyModel F Z_u₀ ℓ (2 * m + 1))
    (D : WeilMidDevSmoothMonodromyPackage.{u} F m Z_tilde f₀ u₀ Z_u₀ j_aff S_aff U₀ ℓ M_Zu_mid)
    (E_van E_perp E_rad : Submodule (Padic ℓ) (Fin D.N → Padic ℓ))
    (hE_perp : ∀ x : Fin D.N → Padic ℓ,
      x ∈ E_perp ↔ ∀ y ∈ E_van, dotProduct x (D.J_V.mulVec y) = 0)
    (hE_rad : E_rad = E_van ⊓ E_perp)
    (hGV_van : ∀ g ∈ D.G_V, ∀ x : Fin D.N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x - x ∈ E_van)
    (hGV_perp : ∀ g ∈ D.G_V, ∀ x ∈ E_perp,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x = x)
    (w_inf : Fin D.N → Padic ℓ) (w_aff : F → (Fin D.N → Padic ℓ))
    (hw_inf_van : w_inf ∈ E_van) (hw_inf_ni : w_inf ∉ E_perp)
    (hw_aff_van : ∀ a ∈ S_aff, w_aff a ∈ E_van) (hw_aff_ni : ∀ a ∈ S_aff, w_aff a ∉ E_perp)
    (hInert_all : ∀ r : ℕ,
      letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hAP_L r
      letI := D.hARF_L r; letI := D.hABL r; letI := D.hAR_B r
      let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
      let C₀_r := integralClosure (Polynomial F) (D.L_V r)
      let A_inf_r := Algebra.adjoin F
        ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
      let t_inf_r : ↥A_inf_r :=
        ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹, Algebra.self_mem_adjoin_singleton F _⟩
      let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
      (∀ a ∈ S_aff, ∀ Q : Ideal ↥C₀_r, Q.IsPrime →
        Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
          Ideal.span {Polynomial.X - Polynomial.C a} →
        ∃ g_Q ∈ D.G_V,
          ∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
            (∀ y : ↥C₀_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q : Set ↥C₀_r)) →
            ∃ u ∈ D.G_V,
              (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
              ∃ c : Padic ℓ, ∀ x : Fin D.N → Padic ℓ,
                ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                  x + (c * dotProduct x (D.J_V.mulVec
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) •
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf)) ∧
      (∀ Q_inf : Ideal ↥C_inf_r, Q_inf.IsPrime →
        Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} →
        ∃ g_Q ∈ D.G_V,
          ∀ (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r) (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) →
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) →
            (∀ y : ↥C_inf_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r)) →
            ∃ u ∈ D.G_V,
              (D.ρ_V r σ_B).val = (u.val).map (PadicInt.toZModPow (r + 1)) ∧
              ∃ c : Padic ℓ, ∀ x : Fin D.N → Padic ℓ,
                ((u.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
                  x + (c * dotProduct x (D.J_V.mulVec
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf))) •
                    (((g_Q.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec w_inf)))
    (hInert_wit :
      (∃ (c_inf : Padic ℓ) (u_inf : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
        c_inf ≠ 0 ∧ u_inf ∈ D.G_V ∧
        (∀ x : Fin D.N → Padic ℓ,
          ((u_inf.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
            x + (c_inf * dotProduct x (D.J_V.mulVec w_inf)) • w_inf) ∧
        ∀ r : ℕ,
          letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hARF_L r
          letI := D.hABL r; letI := D.hAR_B r
          let R₀ := Localization.Away
            (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
          let A_inf_r := Algebra.adjoin F
            ({algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹} : Set (D.L_V r))
          let t_inf_r : ↥A_inf_r :=
            ⟨algebraMap (RatFunc F) (D.L_V r) (RatFunc.X)⁻¹,
              Algebra.self_mem_adjoin_singleton F _⟩
          let C_inf_r := integralClosure ↥A_inf_r (D.L_V r)
          ∃ (Q_inf : Ideal ↥C_inf_r)
            (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r)
            (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
            Q_inf.IsPrime ∧
            Ideal.comap (algebraMap ↥A_inf_r ↥C_inf_r) Q_inf = Ideal.span {t_inf_r} ∧
            (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
            (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
              algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
            (∀ y : ↥C_inf_r,
              σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q_inf : Set ↥C_inf_r)) ∧
            (D.ρ_V r σ_B).val = (u_inf.val).map (PadicInt.toZModPow (r + 1))) ∧
      (∀ a ∈ S_aff,
        ∃ (c_a : Padic ℓ) (u_a : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ),
          c_a ≠ 0 ∧ u_a ∈ D.G_V ∧
          (∀ x : Fin D.N → Padic ℓ,
            ((u_a.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x =
              x + (c_a * dotProduct x (D.J_V.mulVec (w_aff a))) • w_aff a) ∧
          ∀ r : ℕ,
            letI := D.hCR r; letI := D.hFld r; letI := D.hAF_L r; letI := D.hAP_L r
            letI := D.hARF_L r; letI := D.hABL r; letI := D.hAR_B r
            let R₀ := Localization.Away
              (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
            let C₀_r := integralClosure (Polynomial F) (D.L_V r)
            ∃ (Q : Ideal ↥C₀_r)
              (σ_L : D.L_V r ≃ₐ[RatFunc F] D.L_V r)
              (σ_B : D.B_V r ≃ₐ[R₀] D.B_V r),
              Q.IsPrime ∧
              Ideal.comap (algebraMap (Polynomial F) ↥C₀_r) Q =
                Ideal.span {Polynomial.X - Polynomial.C a} ∧
              (∀ x : D.L_V r, IsIntegral F x → σ_L x = x) ∧
              (∀ b : D.B_V r, σ_L (algebraMap (D.B_V r) (D.L_V r) b) =
                algebraMap (D.B_V r) (D.L_V r) (σ_B b)) ∧
              (∀ y : ↥C₀_r,
                σ_L (y : D.L_V r) - (y : D.L_V r) ∈ Subtype.val '' (Q : Set ↥C₀_r)) ∧
              (D.ρ_V r σ_B).val = (u_a.val).map (PadicInt.toZModPow (r + 1))))
    (M₀ M M₂ : ℕ) (hM : 1 ≤ M) (hSum : M₀ + M + M₂ = D.N)
    (P_chg : (Matrix (Fin D.N) (Fin D.N) (PadicInt ℓ))ˣ)
    (ℒ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
    (hBasis : ∀ x : Fin D.N → Padic ℓ,
      (x ∈ E_rad ↔ ∀ i : Fin D.N, M₀ ≤ i.1 →
