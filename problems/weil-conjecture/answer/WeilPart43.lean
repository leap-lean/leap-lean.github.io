      rfl
  · 
    intro r σ hσ_int
    obtain ⟨τ, hτ_int, hτ_comm⟩ := hGeomLift r σ hσ_int
    obtain ⟨σ', hσ'_comm, hσ'_ρ⟩ := (hρ_spec r).2.2.1 τ
    have hσ_eq : σ' = σ := by
      apply AlgEquiv.ext; intro b; apply hj_B_inj r; rw [← hσ'_comm b, hτ_comm b]
    rw [hσ_eq] at hσ'_ρ
    obtain ⟨g_V, hg_V, hg_V_mat⟩ := hG_mem r τ hτ_int
    obtain ⟨h, hh_mem, hh_val⟩ := (hGV_blk.1 g_V hg_V).2.2.2.2
    refine ⟨h, hh_mem, ?_⟩
    ext k₁ k₂
    rw [congrArg Units.val hσ'_ρ, (hρ_mid_spec r).1 τ k₁ k₂, hh_val]
    dsimp only
    have hAdap_eq :
        ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1)) * (ρ_V r τ).val *
