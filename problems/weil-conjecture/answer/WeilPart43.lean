    have hL_compat : ∀ b : B,
        algebraMap L_fld L_V (algebraMap B L_fld b) = algebraMap B_V L_V (j_B b) :=
      fun b => (IsScalarTower.algebraMap_apply B L_fld L_V b).symm
    have hK_compat : (algebraMap L_fld L_V).comp (algebraMap K L_fld) = algebraMap K L_V := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors R₀)
      ext r
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply R₀ K L_fld,
        IsScalarTower.algebraMap_apply R₀ B L_fld,
        hL_compat (algebraMap R₀ B r),
        j_B.commutes r,
        ← IsScalarTower.algebraMap_apply R₀ B_V L_V,
        IsScalarTower.algebraMap_apply R₀ K L_V]
    have _ : IsScalarTower K L_fld L_V :=
      IsScalarTower.of_algebraMap_eq fun k => (congrFun (congrArg DFunLike.coe hK_compat) k).symm
    let e_ICB : B ≃ₐ[R₀] ↥(integralClosure R₀ L_fld) :=
      IsIntegralClosure.equiv R₀ B L_fld ↥(integralClosure R₀ L_fld)
    let res : (B_V ≃ₐ[R₀] B_V) → (B ≃ₐ[R₀] B) := fun τ =>
      let τ_L : L_V ≃ₐ[K] L_V := IsFractionRing.fieldEquivOfAlgEquiv K L_V L_V τ
      let σ_L : L_fld ≃ₐ[K] L_fld := τ_L.restrictNormal L_fld
      (e_ICB.trans (AlgEquiv.mapIntegralClosure (σ_L.restrictScalars R₀))).trans e_ICB.symm
    have hres : ∀ (τ : B_V ≃ₐ[R₀] B_V) (b : B), τ (j_B b) = j_B (res τ b) := by
      intro τ b
      let τ_L : L_V ≃ₐ[K] L_V := IsFractionRing.fieldEquivOfAlgEquiv K L_V L_V τ
      let σ_L : L_fld ≃ₐ[K] L_fld := τ_L.restrictNormal L_fld
      have h_res_eval : algebraMap B L_fld (res τ b) = σ_L (algebraMap B L_fld b) := by
        have h1 := IsIntegralClosure.algebraMap_equiv R₀ B L_fld ↥(integralClosure R₀ L_fld) (res τ b)
        have h2 := IsIntegralClosure.algebraMap_equiv R₀ B L_fld ↥(integralClosure R₀ L_fld) b
        change (↑(e_ICB (res τ b)) : L_fld) = algebraMap B L_fld (res τ b) at h1
        change (↑(e_ICB b) : L_fld) = algebraMap B L_fld b at h2
        rw [← h1, ← h2]
        dsimp [res]
        rw [e_ICB.apply_symm_apply]
        exact AlgEquiv.coe_mapIntegralClosure (σ_L.restrictScalars R₀) (e_ICB b)
      apply IsFractionRing.injective B_V L_V
      have hτ_eval : algebraMap B_V L_V (τ (j_B b)) = τ_L (algebraMap B_V L_V (j_B b)) :=
        (IsFractionRing.fieldEquivOfAlgEquiv_algebraMap K L_V L_V τ (j_B b)).symm
      rw [hτ_eval, ← hL_compat b]
      have hcomm : τ_L (algebraMap L_fld L_V (algebraMap B L_fld b)) =
          algebraMap L_fld L_V (σ_L (algebraMap B L_fld b)) :=
        (AlgEquiv.restrictNormal_commutes τ_L L_fld (algebraMap B L_fld b)).symm
      rw [hcomm, ← h_res_eval, hL_compat (res τ b)]
    have hres_symm : ∀ (τ : B_V ≃ₐ[R₀] B_V) (b : B), τ.symm (j_B b) = j_B ((res τ).symm b) := by
