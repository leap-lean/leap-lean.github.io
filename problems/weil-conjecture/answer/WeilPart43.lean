    intro H₁ H₂ _ _ τ₁ τ₂ f₁ f₂ ψ sys₁ sys₂ V₁ V₂ _ _ _ _ _ _ frob₁ frob₂ equiv₁ equiv₂
      hTors₁ hTors₂ hψ_τ hψ_f hf₁_τ hf₂_τ hsys₁ hsys₂ hsmul₁ hsmul₂ hfrob₁ hfrob₂
