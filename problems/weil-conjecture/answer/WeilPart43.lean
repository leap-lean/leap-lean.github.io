        ((hθ_spec A₁).2.1 q_a (LocallyConstant.const _ a)).symm.trans
          (congrArg (((C_S.obj A₁).obj.map (Opposite.op q_a)).hom) ((hθ_spec A₁).2.2 a))
      have hconst_A₂ : θ_of A₂ (Y_a a) (LocallyConstant.const _ (φ.hom a)) =
          ((C_S.obj A₂).obj.map (Opposite.op q_a)).hom
            (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).unit.app A₂).hom (φ.hom a)) :=
        ((hθ_spec A₂).2.1 q_a (LocallyConstant.const _ (φ.hom a))).symm.trans
          (congrArg (((C_S.obj A₂).obj.map (Opposite.op q_a)).hom) ((hθ_spec A₂).2.2 (φ.hom a)))
      have hunit_nat : ((C_S.map φ).hom.app (Opposite.op T_S)).hom
          (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).unit.app A₁).hom a) =
          ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).unit.app A₂).hom (φ.hom a) := by
        have hn := ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).unit.naturality φ)
        exact (congrArg (fun k => k.hom a) hn).symm
