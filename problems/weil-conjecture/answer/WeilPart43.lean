            CategoryTheory.Limits.pullback.fst π₀ π₀ = p₁ :=
          AlgebraicGeometry.pullbackSpecIso_inv_fst R S S
        have hf₂ : (AlgebraicGeometry.pullbackSpecIso R S S).inv ≫
            CategoryTheory.Limits.pullback.snd π₀ π₀ = p₂ :=
          AlgebraicGeometry.pullbackSpecIso_inv_snd R S S
        rw [← hf₁, ← hf₂, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition]
      have hPb_T₀ : CategoryTheory.IsPullback p₁ p₂ π₀ π₀ :=
        CategoryTheory.IsPullback.of_iso_pullback ⟨hComm₀⟩
          (AlgebraicGeometry.pullbackSpecIso R S S).symm
          (AlgebraicGeometry.pullbackSpecIso_inv_fst R S S)
          (AlgebraicGeometry.pullbackSpecIso_inv_snd R S S)
      have hPb_iso : CategoryTheory.IsPullback (𝟙 V) π₀ π e_U.hom :=
        CategoryTheory.IsPullback.of_horiz_isIso ⟨CategoryTheory.Category.id_comp π⟩
      have hPb_T : CategoryTheory.IsPullback p₁ p₂ π π := by
        have h := hPb_T₀.paste_horiz hPb_iso
        rwa [CategoryTheory.Category.comp_id] at h
      let μ : (S ≃ₐ[R] S) → (A →ₐ[S] S) :=
        fun σ => Algebra.TensorProduct.lift (AlgHom.id S S) σ.symm.toAlgHom (fun _ _ => Commute.all _ _)
      let Δ : Fin m → (V ⟶ T) :=
        fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ (equiv_Γ i)).toRingHom)
      have hΔ_p₁ : ∀ i : Fin m, Δ i ≫ p₁ = 𝟙 V := by
        intro i
        dsimp only [Δ, p₁]
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hid : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫
            CommRingCat.ofHom (μ (equiv_Γ i)).toRingHom = 𝟙 (CommRingCat.of S) := by
