      have : AlgebraicGeometry.Etale hAff.fromSpec := inferInstance
      have : AlgebraicGeometry.Etale h_aff :=
        CategoryTheory.MorphismProperty.comp_mem _ hAff.fromSpec snd_i inferInstance inferInstance
