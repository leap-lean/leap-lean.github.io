    have hΘ_one : ∀ s : ↥E_push.sysSubgroup, Θ (TensorProduct.tmul ℤ (1 : ℚ) s) = 0 := fun s => by
      simp [Θ, hfrob_sq_one s]
    have hΘ_all : ∀ t : TensorProduct ℤ ℚ ↥E_push.sysSubgroup, Θ t = 0 :=
      hTP_zero Θ (fun q s => by
        have hq : (q.den : ℤ) • q = q.num • (1 : ℚ) := by
          rw [zsmul_eq_mul, zsmul_one, Int.cast_natCast, mul_comm]
          exact Rat.mul_den_eq_num q
        have hden_zero : (q.den : ℤ) • Θ (TensorProduct.tmul ℤ q s) = 0 := by
          rw [← map_zsmul, TensorProduct.smul_tmul', hq, ← TensorProduct.smul_tmul',
            map_zsmul, hΘ_one s, smul_zero]
        have hsmul : (q.den : K) • Θ (TensorProduct.tmul ℤ q s) = 0 := by
          rwa [Nat.cast_smul_eq_nsmul, ← natCast_zsmul]
        have hne : (q.den : K) ≠ 0 := Nat.cast_ne_zero.mpr q.den_nz
        exact (smul_eq_zero.mp hsmul).resolve_left hne)
    ext v
    have hv : Θ (E_push.equiv.symm v) = 0 := hΘ_all (E_push.equiv.symm v)
    simpa [Θ, sub_eq_zero] using hv

  let Φ_L : Module.End L (TensorProduct K L E_push.V) := LinearMap.baseChange L E_push.frob
  have hγ_roots : γ' ∈ (Φ_L.charpoly).roots := by
    rw [LinearMap.charpoly_baseChange, ← Polynomial.aroots_def]
    exact hγ'_push
  have hγ_isRoot : (Φ_L.charpoly).IsRoot γ' :=
    (Polynomial.mem_roots (LinearMap.charpoly_monic Φ_L).ne_zero).mp hγ_roots
  have hγ_eigen : Φ_L.HasEigenvalue γ' :=
    (Module.End.hasEigenvalue_iff_isRoot_charpoly Φ_L γ').mpr hγ_isRoot
  obtain ⟨v, hv⟩ := hγ_eigen.exists_hasEigenvector
  have h1 : (Φ_L ^ 2) v = (γ' ^ 2) • v := hv.pow_apply 2
  have h2 : (Φ_L ^ 2) v = (algebraMap K L c₀) • v := by
    have hpow : Φ_L ^ 2 = LinearMap.baseChange L (E_push.frob ^ 2) :=
      (LinearMap.baseChange_pow K L E_push.V E_push.frob 2).symm
    rw [hpow, hfrob_sq_id, LinearMap.baseChange_smul, LinearMap.baseChange_id,
      LinearMap.smul_apply, LinearMap.id_apply, algebraMap_smul]
  have heq : (γ' ^ 2) • v = (algebraMap K L c₀) • v := h1.symm.trans h2
  have hγ_sq : γ' ^ 2 = algebraMap K L c₀ := smul_left_injective L hv.2 heq
  rw [hγ_sq]
  dsimp [c₀, K, L]
  rw [map_pow, map_pow, map_natCast]

theorem weil_mid_dev_zero_ext_bockstein_tower_and_dir_inclusion (F : Type u) [Field F]
    (S_aff : Finset F)
    (D₀ : AlgebraicGeometry.Scheme.{u})
    (U₀ : D₀.Opens)
    (ℓ K : ℕ) [Fact (Nat.Prime ℓ)] :
    let R₀ := Localization.Away (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F))
    ∀ (B_F L_F : ℕ → Type u)
      [∀ r, CommRing (B_F r)] [∀ r, IsDomain (B_F r)] [∀ r, Field (L_F r)]
      [∀ r, Algebra F (B_F r)] [∀ r, Algebra (Polynomial F) (B_F r)] [∀ r, Algebra R₀ (B_F r)]
      [∀ r, Algebra F (L_F r)] [∀ r, Algebra (Polynomial F) (L_F r)]
      [∀ r, Algebra (RatFunc F) (L_F r)] [∀ r, Algebra (B_F r) (L_F r)] [∀ r, Algebra R₀ (L_F r)]
      [∀ r, IsScalarTower F (Polynomial F) (B_F r)] [∀ r, IsScalarTower (Polynomial F) R₀ (B_F r)]
      [∀ r, IsScalarTower F (RatFunc F) (L_F r)]
      [∀ r, IsScalarTower (Polynomial F) (RatFunc F) (L_F r)]
      [∀ r, IsScalarTower (Polynomial F) (B_F r) (L_F r)]
      [∀ r, IsScalarTower R₀ (B_F r) (L_F r)]
      [∀ r, Module.Finite R₀ (B_F r)] [∀ r, Algebra.Etale R₀ (B_F r)]
      [∀ r, IsFractionRing (B_F r) (L_F r)] [∀ r, IsIntegralClosure (B_F r) R₀ (L_F r)]
      [∀ r, FiniteDimensional (RatFunc F) (L_F r)] [∀ r, IsGalois (RatFunc F) (L_F r)]
      (ρ_F : ∀ r : ℕ, (B_F r ≃ₐ[R₀] B_F r) →* (Matrix (Fin K) (Fin K) (ZMod (ℓ ^ (r + 1))))ˣ)
      (ι_BF : ∀ r : ℕ, B_F r →ₐ[R₀] B_F (r + 1))
      (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme)
      (_hι_BF_compat : ∀ r : ℕ, Function.Injective (ι_BF r) ∧
        ∀ τ : B_F (r + 1) ≃ₐ[R₀] B_F (r + 1),
          ∃ σ : B_F r ≃ₐ[R₀] B_F r,
            (∀ b : B_F r, τ (ι_BF r b) = ι_BF r (σ b)) ∧
            ((ρ_F (r + 1) τ).val).map (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) _) =
              (ρ_F r σ).val)
      (ℱ₀ : ℕ → CategoryTheory.Sheaf U₀.toScheme.smallEtaleTopology AddCommGrpCat.{u})
      (τ_ℱ : ∀ r : ℕ, Quiver.Hom (ℱ₀ (r + 1)) (ℱ₀ r))
      (_hTriv_F : ∃ triv : ∀ (r : ℕ) (W : U₀.toScheme.Etale),
          let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B_F r))
          let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F r)))) e_U.hom
          let W_r := CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom π_r
          ↑((ℱ₀ r).obj.obj (Opposite.op W)) →+
            (LocallyConstant ↥W_r (Fin K → ZMod (ℓ ^ (r + 1)))),
        ∀ r : ℕ,
          let V_r := AlgebraicGeometry.Spec (CommRingCat.of (B_F r))
          let π_r : Quiver.Hom V_r U₀.toScheme := CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F r)))) e_U.hom
          let π_succ : Quiver.Hom
              (AlgebraicGeometry.Spec (CommRingCat.of (B_F (r + 1)))) U₀.toScheme :=
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F (r + 1))))) e_U.hom
          (∀ {W₁ W₂ : U₀.toScheme.Etale} (u : Quiver.Hom W₁ W₂),
            let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₁).hom
            let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W₂).hom
            let W₁_r := CategoryTheory.Limits.pullback h₁ π_r
            let W₂_r := CategoryTheory.Limits.pullback h₂ π_r
            ∀ (u_r : Quiver.Hom W₁_r W₂_r),
              CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.fst h₂ π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.fst h₁ π_r)
                  ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).map u).left →
              CategoryTheory.CategoryStruct.comp u_r (CategoryTheory.Limits.pullback.snd h₂ π_r) =
                CategoryTheory.Limits.pullback.snd h₁ π_r →
              ∀ (s : ↑((ℱ₀ r).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_r),
                triv r W₁ (((ℱ₀ r).obj.map (Opposite.op u)) s) y₁ =
                  triv r W₂ s (u_r.base y₁)) ∧
          ∀ (W : U₀.toScheme.Etale),
            let h_W := ((AlgebraicGeometry.Scheme.Etale.forget U₀.toScheme).obj W).hom
            let W_r := CategoryTheory.Limits.pullback h_W π_r
            let W_succ := CategoryTheory.Limits.pullback h_W π_succ
            Function.Injective (triv r W) ∧
            Set.range (triv r W) =
              { f | ∀ (σ : B_F r ≃ₐ[R₀] B_F r) (m_σ : Quiver.Hom W_r W_r),
                CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.fst h_W π_r) =
                  CategoryTheory.Limits.pullback.fst h_W π_r →
                CategoryTheory.CategoryStruct.comp m_σ (CategoryTheory.Limits.pullback.snd h_W π_r) =
                  CategoryTheory.CategoryStruct.comp
                    (CategoryTheory.Limits.pullback.snd h_W π_r)
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
                ∀ y : ↥W_r, f (m_σ.base y) = ((ρ_F r σ).val).mulVec (f y) } ∧
            ∀ (s_up : ↑((ℱ₀ (r + 1)).obj.obj (Opposite.op W)))
              (m_ι : Quiver.Hom W_succ W_r),
              CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.fst h_W π_r) =
                CategoryTheory.Limits.pullback.fst h_W π_succ →
              CategoryTheory.CategoryStruct.comp m_ι (CategoryTheory.Limits.pullback.snd h_W π_r) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.snd h_W π_succ)
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_BF r).toRingHom)) →
              ∀ (y_up : ↥W_succ) (i : Fin K),
                triv r W (((τ_ℱ r).hom.app (Opposite.op W)) s_up) (m_ι.base y_up) i =
                  ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
                    (triv (r + 1) W s_up y_up i)),
      let V₀ := AlgebraicGeometry.Spec (CommRingCat.of (B_F 0))
      let π₀ : Quiver.Hom V₀ U₀.toScheme := CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F 0)))) e_U.hom
      let ι₀ : Quiver.Hom V₀ D₀ := CategoryTheory.CategoryStruct.comp π₀ U₀.ι
      ∃ (𝒥₀ : ℕ → CategoryTheory.Sheaf D₀.smallEtaleTopology AddCommGrpCat.{u})
        (τ_𝒥 : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ r))
        (triv_!₀ : ∀ W : D₀.Etale,
          let W_0 := CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom ι₀
          ↑((𝒥₀ 0).obj.obj (Opposite.op W)) →+
            LocallyConstant ↥W_0 (Fin K → ZMod (ℓ ^ (0 + 1))))
        (ι_bock : ∀ r : ℕ, Quiver.Hom (𝒥₀ r) (𝒥₀ (r + 1)))
        (ρ_bock : ∀ r : ℕ, Quiver.Hom (𝒥₀ (r + 1)) (𝒥₀ 0))
        (ι_ext : ∀ r : ℕ, Quiver.Hom (𝒥₀ r) (weilEtaleHigherDirectImage U₀.ι 0 (ℱ₀ r))),
        ((∀ {W₁ W₂ : D₀.Etale} (u : Quiver.Hom W₁ W₂),
            let h₁ := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W₁).hom
            let h₂ := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W₂).hom
            let W₁_0 := CategoryTheory.Limits.pullback h₁ ι₀
            let W₂_0 := CategoryTheory.Limits.pullback h₂ ι₀
            ∀ (u_0 : Quiver.Hom W₁_0 W₂_0),
              CategoryTheory.CategoryStruct.comp u_0
                (CategoryTheory.Limits.pullback.fst h₂ ι₀) =
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.Limits.pullback.fst h₁ ι₀)
                  ((AlgebraicGeometry.Scheme.Etale.forget D₀).map u).left →
              CategoryTheory.CategoryStruct.comp u_0
                (CategoryTheory.Limits.pullback.snd h₂ ι₀) =
                CategoryTheory.Limits.pullback.snd h₁ ι₀ →
              ∀ (s : ↑((𝒥₀ 0).obj.obj (Opposite.op W₂))) (y₁ : ↥W₁_0),
                triv_!₀ W₁ (((𝒥₀ 0).obj.map (Opposite.op u)) s) y₁ =
                  triv_!₀ W₂ s (u_0.base y₁)) ∧
          ∀ (W : D₀.Etale),
            let h_W := ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom
            let W_0 := CategoryTheory.Limits.pullback h_W ι₀
            Function.Injective (triv_!₀ W) ∧
            Set.range (triv_!₀ W) =
              { f |
                (∃ W₀ : ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).left.Opens,
                  ((TopologicalSpace.Opens.map h_W.base).obj U₀) ⊔ W₀ = ⊤ ∧
                  ∀ y : ↥W_0,
                    (CategoryTheory.Limits.pullback.fst h_W ι₀).base y ∈ W₀ → f y = 0) ∧
                (∀ (σ : B_F 0 ≃ₐ[R₀] B_F 0) (m_σ : Quiver.Hom W_0 W_0),
                  CategoryTheory.CategoryStruct.comp m_σ
                    (CategoryTheory.Limits.pullback.fst h_W ι₀) =
                    CategoryTheory.Limits.pullback.fst h_W ι₀ →
                  CategoryTheory.CategoryStruct.comp m_σ
                    (CategoryTheory.Limits.pullback.snd h_W ι₀) =
                    CategoryTheory.CategoryStruct.comp
                      (CategoryTheory.Limits.pullback.snd h_W ι₀)
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom)) →
                  ∀ y : ↥W_0, f (m_σ.base y) = ((ρ_F 0 σ).val).mulVec (f y)) }) ∧
        (∀ r : ℕ, (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (𝒥₀ r) = 0) ∧
        (∀ r : ℕ,
          (ℓ ^ (r + 1)) •
            CategoryTheory.CategoryStruct.id (weilEtaleHigherDirectImage U₀.ι 0 (ℱ₀ r)) = 0) ∧
        (∀ r : ℕ,
          ∃ h0 : CategoryTheory.CategoryStruct.comp (ι_bock r) (ρ_bock r) = 0,
            (CategoryTheory.ShortComplex.mk (ι_bock r) (ρ_bock r) h0).ShortExact) ∧
        (∀ r : ℕ,
          CategoryTheory.CategoryStruct.comp (ι_bock r) (τ_𝒥 r) =
            ℓ • CategoryTheory.CategoryStruct.id (𝒥₀ r)) ∧
        (∀ r : ℕ,
          CategoryTheory.CategoryStruct.comp (τ_𝒥 r) (ι_bock r) =
            CategoryTheory.CategoryStruct.comp (ι_bock (r + 1)) (τ_𝒥 (r + 1))) ∧
        ρ_bock 0 = τ_𝒥 0 ∧
        (∀ r : ℕ,
          ρ_bock (r + 1) = CategoryTheory.CategoryStruct.comp (τ_𝒥 (r + 1)) (ρ_bock r)) ∧
        (∀ r : ℕ, CategoryTheory.Mono (ι_ext r)) ∧
        (∀ r : ℕ,
          CategoryTheory.CategoryStruct.comp (τ_𝒥 r) (ι_ext r) =
            CategoryTheory.CategoryStruct.comp (ι_ext (r + 1))
              (weilEtaleHigherDirectImageMap U₀.ι 0 (τ_ℱ r))) ∧
        (∀ (r : ℕ) (W : D₀.Etale),
          Set.range ((AlgebraicGeometry.Scheme.Etale.forget D₀).obj W).hom.base ⊆
            (U₀ : Set D₀) →
          Function.Bijective ((ι_ext r).hom.app (Opposite.op W))) :=
by
  classical
  intro R₀ B_F L_F
    _ _ _
    _ _ _
    _ _ _ _ _
    _ _ _ _ _ _
    _ _ _ _ _ _
    ρ_F ι_BF e_U hι_BF_compat ℱ₀ τ_ℱ hTriv_F
    V₀ π₀ ι₀
  obtain ⟨triv, hTriv⟩ := hTriv_F
  have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  let lcPrecomp : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {α : Type}
      (φ : X ⟶ Y) (g : LocallyConstant ↥Y α), LocallyConstant ↥X α :=
    fun φ g => ⟨fun x => g (φ.base x),
      fun t => φ.base.hom.continuous.isOpen_preimage _ (g.isLocallyConstant t)⟩
  let lcPostcomp : ∀ {X : Type u} [TopologicalSpace X] {α β : Type}
      (k : α → β) (g : LocallyConstant X α), LocallyConstant X β :=
    fun k g => ⟨fun x => k (g x), fun t => g.isLocallyConstant (k ⁻¹' t)⟩
  have lcPrecomp_apply : ∀ {X Y : AlgebraicGeometry.Scheme.{u}} {α : Type}
      (φ : X ⟶ Y) (g : LocallyConstant ↥Y α) (x : ↥X),
      lcPrecomp φ g x = g (φ.base x) := fun _ _ _ => rfl
  have lcPostcomp_apply : ∀ {X : Type u} [TopologicalSpace X] {α β : Type}
      (k : α → β) (g : LocallyConstant X α) (x : X),
      lcPostcomp k g x = k (g x) := fun _ _ _ => rfl
  have hLC_nsmul_apply : ∀ {X : Type u} [TopologicalSpace X] {α : Type} [AddCommMonoid α]
      (k : ℕ) (g : LocallyConstant X α) (x : X),
      (k • g) x = k • (g x) := by
    intro X _ α _ k g x
    induction k with
    | zero =>
      rw [zero_smul, zero_smul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, LocallyConstant.add_apply, ih]
  have hNsmul_sheaf : ∀ {C : Type (u + 1)} [CategoryTheory.LargeCategory C]
      {J : CategoryTheory.GrothendieckTopology C}
      (ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (k : ℕ) (X : Cᵒᵖ) (s : ↑(ℱ.obj.obj X)),
      (((k • CategoryTheory.CategoryStruct.id ℱ).hom.app X) s) = k • s := by
    intro C _ J ℱ k X s
    induction k with
    | zero =>
      rw [zero_smul, zero_smul]
      rfl
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, ← ih]
      rfl
  obtain ⟨hAlgIdemp, hR₀Pkg, hRelPkg⟩ := weil_etale_galois_domain_idempotents_and_aut_lift.{u}
  obtain ⟨hDom_R₀, instAlg_R₀K, hFrac_R₀K, hST_R₀KL_gen⟩ := hR₀Pkg F S_aff
  have _ : IsDomain R₀ := hDom_R₀
  let _ : Algebra R₀ (RatFunc F) := instAlg_R₀K
  have _ : IsFractionRing R₀ (RatFunc F) := hFrac_R₀K
  have _ : ∀ r, IsScalarTower R₀ (RatFunc F) (L_F r) := fun r => hST_R₀KL_gen (B_F r) (L_F r)
  let V_r : ℕ → AlgebraicGeometry.Scheme.{u} :=
    fun r => AlgebraicGeometry.Spec (CommRingCat.of (B_F r))
  let π_r : ∀ r : ℕ, V_r r ⟶ U₀.toScheme :=
    fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ (B_F r))) ≫ e_U.hom
  let ι_r : ∀ r : ℕ, V_r r ⟶ D₀ := fun r => π_r r ≫ U₀.ι
  let p_ι : ∀ r : ℕ, V_r (r + 1) ⟶ V_r r :=
    fun r => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_BF r).toRingHom)
  have hp_ι_π : ∀ r : ℕ, p_ι r ≫ π_r r = π_r (r + 1) := by
    intro r
    dsimp only [p_ι, π_r]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
    have hcomm : CommRingCat.ofHom (algebraMap R₀ (B_F r)) ≫
        CommRingCat.ofHom (ι_BF r).toRingHom =
        CommRingCat.ofHom (algebraMap R₀ (B_F (r + 1))) :=
      CommRingCat.hom_ext (RingHom.ext fun x => (ι_BF r).commutes x)
    rw [hcomm]
  have hp_ι_ι : ∀ r : ℕ, p_ι r ≫ ι_r r = ι_r (r + 1) := by
    intro r
    dsimp only [ι_r]
    rw [← CategoryTheory.Category.assoc, hp_ι_π r]
  have hTorsPkg : ∀ r : ℕ,
      (AlgebraicGeometry.Etale (π_r r) ∧ AlgebraicGeometry.Surjective (π_r r)) ∧
      (∀ (Y : AlgebraicGeometry.Scheme.{u}) (g_Y : Y ⟶ V_r r),
        let Y_V := CategoryTheory.Limits.pullback (g_Y ≫ π_r r) (π_r r)
        ∃ δ : (B_F r ≃ₐ[R₀] B_F r) → (Y ⟶ Y_V),
          (∀ σ : B_F r ≃ₐ[R₀] B_F r,
            δ σ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r r) (π_r r) = 𝟙 Y ∧
            δ σ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r r) (π_r r) =
              g_Y ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.symm.toRingHom) ∧
            AlgebraicGeometry.Etale (δ σ) ∧
            IsOpen (Set.range (δ σ).base)) ∧
          (∀ σ₁ σ₂ : B_F r ≃ₐ[R₀] B_F r, σ₁ ≠ σ₂ →
            Disjoint (Set.range (δ σ₁).base) (Set.range (δ σ₂).base)) ∧
          (⋃ σ : B_F r ≃ₐ[R₀] B_F r, Set.range (δ σ).base) = Set.univ ∧
          (∀ (σ τ : B_F r ≃ₐ[R₀] B_F r) (m_τ : Y_V ⟶ Y_V),
            m_τ ≫ CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r r) (π_r r) =
              CategoryTheory.Limits.pullback.fst (g_Y ≫ π_r r) (π_r r) →
            m_τ ≫ CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r r) (π_r r) =
              CategoryTheory.Limits.pullback.snd (g_Y ≫ π_r r) (π_r r) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.symm.toRingHom) →
            δ σ ≫ m_τ = δ (τ * σ))) := by
    intro r
    obtain ⟨hInj_r, m_r, equiv_r, e_r, hIdemp_r, hOrth_r, hSum_r, hEval_r, hAbsorb_r⟩ :=
      hAlgIdemp R₀ (B_F r) (RatFunc F) (L_F r)
    obtain ⟨hEtSurj_r, _, hSheets_r⟩ :=
      weil_scheme_galois_torsor_clopen_sheets.{u} R₀ (B_F r) hInj_r m_r equiv_r e_r
        hIdemp_r hOrth_r hSum_r hEval_r hAbsorb_r U₀.toScheme e_U
