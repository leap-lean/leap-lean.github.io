      · let r_a : Polynomial F := ∏ s ∈ S_aff.erase a, (Polynomial.X - Polynomial.C s)
        let t_a : Polynomial F := Polynomial.X - Polynomial.C a
        have hr_a_span :
            r_a ∉ Ideal.span {(AlgEquiv.refl : Polynomial F ≃ₐ[F] Polynomial F) t_a} := by
          intro hmem
          change r_a ∈ Ideal.span {t_a} at hmem
          rw [Ideal.mem_span_singleton] at hmem
          rcases hmem with ⟨q_p, hq_p⟩
          have hev : Polynomial.eval a r_a = 0 := by
            rw [hq_p, Polynomial.eval_mul]
            simp [t_a]
          dsimp [r_a] at hev
          rw [Polynomial.eval_prod, Finset.prod_eq_zero_iff] at hev
          rcases hev with ⟨s, hs, hs0⟩
          simp only [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C,
            sub_eq_zero] at hs0
          exact (Finset.ne_of_mem_erase hs) hs0.symm
        let R_a₀ := Localization.Away r_a
        let t_a₀ : R_a₀ := algebraMap (Polynomial F) R_a₀ t_a
        let R_a_U := Localization.Away t_a₀
        let f_loc := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R_a₀))
        let ι_a : AlgebraicGeometry.Spec (CommRingCat.of R_a₀) ⟶ D₀.left := f_loc ≫ j_aff
        have hOpen_loc : AlgebraicGeometry.IsOpenImmersion f_loc := inferInstance
        let _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
            (@AlgebraicGeometry.IsOpenImmersion) :=
          CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        have _ : AlgebraicGeometry.IsOpenImmersion ι_a :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
            f_loc j_aff hOpen_loc hj_open
        let p_a_ps : PrimeSpectrum (Polynomial F) := p_a
        have hp_a_basic : p_a_ps ∈ PrimeSpectrum.basicOpen r_a := by
          rw [PrimeSpectrum.mem_basicOpen]
          change r_a ∉ p_a.asIdeal
          rw [hp_a_ideal]
          exact hr_a_span
        have hp_a_range :
            p_a_ps ∈ Set.range (PrimeSpectrum.comap (algebraMap (Polynomial F) R_a₀)) := by
          rw [PrimeSpectrum.localization_away_comap_range R_a₀ r_a]
          exact hp_a_basic
        rcases hp_a_range with ⟨q'_a, hq'_a_eq⟩
        let p'_a : AlgebraicGeometry.Spec (CommRingCat.of R_a₀) := q'_a
        have hp'_a_comap :
            Ideal.comap (algebraMap (Polynomial F) R_a₀) p'_a.asIdeal = Ideal.span {t_a} := by
          change (PrimeSpectrum.comap (algebraMap (Polynomial F) R_a₀) q'_a).asIdeal =
            Ideal.span {t_a}
          rw [hq'_a_eq]
          exact hp_a_ideal
        have hp'_a_pt : ι_a.base p'_a = j_aff.base p_a := by
          have hι_eq : ι_a.base p'_a = j_aff.base (f_loc.base p'_a) := by
            change (f_loc ≫ j_aff).base p'_a = j_aff.base (f_loc.base p'_a)
            rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply]
          rw [hι_eq]
          exact congrArg j_aff.base hq'_a_eq
        let P_S : Polynomial F := ∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s)
        have hPS_eq : P_S = t_a * r_a := (Finset.mul_prod_erase S_aff _ ha).symm
        let f_RaU : Polynomial F →+* R_a_U :=
          (algebraMap R_a₀ R_a_U).comp (algebraMap (Polynomial F) R_a₀)
        have hUnit_PS_RaU : IsUnit (f_RaU P_S) := by
          change IsUnit (algebraMap R_a₀ R_a_U (algebraMap (Polynomial F) R_a₀ P_S))
          rw [hPS_eq, map_mul, map_mul]
          exact IsUnit.mul
            (IsLocalization.map_units R_a_U ⟨t_a₀, Submonoid.mem_powers t_a₀⟩)
            ((IsLocalization.map_units R_a₀ ⟨r_a, Submonoid.mem_powers r_a⟩).map
              (algebraMap R_a₀ R_a_U))
        let ψ_a : R₀ →+* R_a_U :=
          @IsLocalization.Away.lift (Polynomial F) _ R₀ _ _ R_a_U _ P_S _ f_RaU hUnit_PS_RaU
        have hψ_a_comp : ψ_a.comp (algebraMap (Polynomial F) R₀) = f_RaU := by
          apply RingHom.ext
          intro p
          exact @IsLocalization.Away.lift_eq (Polynomial F) _ R₀ _ _ R_a_U _ P_S _
            f_RaU hUnit_PS_RaU p
        have hUnit_PS_R₀ : IsUnit (algebraMap (Polynomial F) R₀ P_S) :=
          IsLocalization.map_units R₀ ⟨P_S, Submonoid.mem_powers P_S⟩
        rcases hUnit_PS_R₀ with ⟨u_PS, hu_PS⟩
        have hta_ra_R₀ :
            algebraMap (Polynomial F) R₀ t_a * algebraMap (Polynomial F) R₀ r_a = u_PS.val := by
          rw [← map_mul, ← hPS_eq, hu_PS]
        have hUnit_ra_R₀ : IsUnit (algebraMap (Polynomial F) R₀ r_a) :=
          IsUnit.of_mul_eq_one (algebraMap (Polynomial F) R₀ t_a * (u_PS⁻¹).val)
            (by rw [← mul_assoc, mul_comm (algebraMap _ _ r_a), hta_ra_R₀, Units.mul_inv])
        let ψ_a₀_inv : R_a₀ →+* R₀ :=
          @IsLocalization.Away.lift (Polynomial F) _ R_a₀ _ _ R₀ _ r_a _
            (algebraMap (Polynomial F) R₀) hUnit_ra_R₀
        have hψ_a₀_ta : IsUnit (ψ_a₀_inv t_a₀) := by
          have heq := @IsLocalization.Away.lift_eq (Polynomial F) _ R_a₀ _ _ R₀ _ r_a _
            (algebraMap (Polynomial F) R₀) hUnit_ra_R₀ t_a
          have hUnit_ta_R₀ : IsUnit (algebraMap (Polynomial F) R₀ t_a) :=
            IsUnit.of_mul_eq_one (algebraMap (Polynomial F) R₀ r_a * (u_PS⁻¹).val)
              (by rw [← mul_assoc, hta_ra_R₀, Units.mul_inv])
          rwa [heq]
        let ψ_a_inv : R_a_U →+* R₀ :=
          @IsLocalization.Away.lift R_a₀ _ R_a_U _ _ R₀ _ t_a₀ _ ψ_a₀_inv hψ_a₀_ta
        have hψ_inv_comp : ψ_a_inv.comp f_RaU = algebraMap (Polynomial F) R₀ := by
          apply RingHom.ext
          intro p
          simp only [RingHom.comp_apply, f_RaU]
          have h1 := @IsLocalization.Away.lift_eq R_a₀ _ R_a_U _ _ R₀ _ t_a₀ _ ψ_a₀_inv hψ_a₀_ta
            (algebraMap (Polynomial F) R_a₀ p)
          have h2 := @IsLocalization.Away.lift_eq (Polynomial F) _ R_a₀ _ _ R₀ _ r_a _
            (algebraMap (Polynomial F) R₀) hUnit_ra_R₀ p
          exact h1.trans h2
        have h_inv_left : ψ_a_inv.comp ψ_a = RingHom.id R₀ := by
          apply @IsLocalization.ringHom_ext (Polynomial F) _ (Submonoid.powers P_S) R₀ _ _ _ R₀ _
          rw [RingHom.comp_assoc, hψ_a_comp, hψ_inv_comp, RingHom.id_comp]
        have h_inv_right : ψ_a.comp ψ_a_inv = RingHom.id R_a_U := by
          apply @IsLocalization.ringHom_ext R_a₀ _ (Submonoid.powers t_a₀) R_a_U _ _ _ R_a_U _
          apply @IsLocalization.ringHom_ext (Polynomial F) _ (Submonoid.powers r_a) R_a₀ _ _ _
            R_a_U _
          change ψ_a.comp (ψ_a_inv.comp f_RaU) = f_RaU
          exact (congrArg ψ_a.comp hψ_inv_comp).trans hψ_a_comp
        have hψ_a_bij : Function.Bijective ψ_a :=
          ⟨fun x₁ x₂ hx => by
            have h1 := RingHom.congr_fun h_inv_left x₁
            have h2 := RingHom.congr_fun h_inv_left x₂
            simp only [RingHom.comp_apply, RingHom.id_apply] at h1 h2
            rw [← h1, ← h2, hx],
           fun y => ⟨ψ_a_inv y, RingHom.congr_fun h_inv_right y⟩⟩
        have hψ_a_loc : @IsLocalization.Away R₀ _ (1 : R₀) R_a_U _ ψ_a.toAlgebra := by
          let _ : Algebra R₀ R_a_U := ψ_a.toAlgebra
          exact IsLocalization.away_of_isUnit_of_bijective R_a_U isUnit_one hψ_a_bij
        have hU₀_a_pre : ι_a.base ⁻¹' (U₀ : Set ↥D₀.left) =
            { q : AlgebraicGeometry.Spec (CommRingCat.of R_a₀) |
              algebraMap (Polynomial F) R_a₀
                ((AlgEquiv.refl : Polynomial F ≃ₐ[F] Polynomial F) t_a) ∉ q.asIdeal } := by
          have hj_inj : Function.Injective j_aff.base := hj_open.base_open.injective
          ext q
          constructor
          · intro hq
            have hqU : ι_a.base q ∈ (U₀ : Set ↥D₀.left) := hq
            rw [hU₀_eq] at hqU
            rcases hqU with ⟨p', hp', hp'_eq⟩
            have hι_eq : ι_a.base q = j_aff.base (f_loc.base q) := by
              change (f_loc ≫ j_aff).base q = j_aff.base (f_loc.base q)
              rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply]
            have hfp : p' = f_loc.base q := hj_inj (hp'_eq.trans hι_eq.symm)
            subst hfp
            intro hmem
            exact hp' a ha hmem
          · intro hnot
            change ι_a.base q ∈ (U₀ : Set ↥D₀.left)
            rw [hU₀_eq]
            refine ⟨f_loc.base q, ?_, ?_⟩
            · intro s hs hmem
              by_cases hsa : s = a
              · subst hsa
                exact hnot hmem
              · have hs_er : s ∈ S_aff.erase a := Finset.mem_erase.mpr ⟨hsa, hs⟩
                have hdvd_ra : Polynomial.X - Polynomial.C s ∣ r_a :=
                  Finset.dvd_prod_of_mem _ hs_er
                rcases hdvd_ra with ⟨g_s, hg_s⟩
                have hra_eq : algebraMap (Polynomial F) R_a₀ r_a =
                    algebraMap (Polynomial F) R_a₀ (Polynomial.X - Polynomial.C s) *
                      algebraMap (Polynomial F) R_a₀ g_s := by
                  rw [← map_mul, ← hg_s]
                have hra_mem : algebraMap (Polynomial F) R_a₀ r_a ∈ q.asIdeal := by
                  rw [hra_eq]
                  exact q.asIdeal.mul_mem_right _ hmem
                exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hra_mem
                  (IsLocalization.map_units R_a₀ ⟨r_a, Submonoid.mem_powers r_a⟩))
            · change j_aff.base (f_loc.base q) = (f_loc ≫ j_aff).base q
              rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Function.comp_apply]
        have hι_a_comp :
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_a₀ R_a_U))) ι_a =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_a))
              (CategoryTheory.CategoryStruct.comp D.e_U.hom U₀.ι) := by
          dsimp [ι_a, f_loc]
          rw [D.heU_eq, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
            ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
          exact congrArg
            (fun φ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ j_aff) hψ_a_comp.symm
        let β_a : R_a_U →+* RatFunc F := (algebraMap R₀ (RatFunc F)).comp ψ_a_inv
        have hβ_a_poly :
            β_a.comp ((algebraMap R_a₀ R_a_U).comp (algebraMap (Polynomial F) R_a₀)) =
              algebraMap (Polynomial F) (RatFunc F) := by
          dsimp [β_a]
          rw [RingHom.comp_assoc]
          change (algebraMap R₀ (RatFunc F)).comp (ψ_a_inv.comp f_RaU) = _
          rw [hψ_inv_comp, hST_Poly_R₀_RF]
        have hβ_a_R₀ :
            (algebraMap (RatFunc F) (D.L_V r)).comp (β_a.comp ψ_a) =
              algebraMap R₀ (D.L_V r) := by
          dsimp [β_a]
          rw [RingHom.comp_assoc, h_inv_left, RingHom.comp_id]
          apply RingHom.ext
          intro z
          exact (IsScalarTower.algebraMap_apply R₀ (RatFunc F) (D.L_V r) z).symm
        have _ : IsLocalization.Away
            (algebraMap (Polynomial F) R_a₀
              ((AlgEquiv.refl : Polynomial F ≃ₐ[F] Polynomial F) (Polynomial.X - Polynomial.C a)))
            R_a_U := by
          change IsLocalization.Away t_a₀ R_a_U
          infer_instance
        obtain ⟨Q₀, W'', u_ref, x'', H_I, C₀,
          hQ₀_prime, hQ₀_comap, hu_ref_et, hx''_eq, hHI_inert,
          hC₀_ne, hC₀_clopen, hC₀_preconn, hC₀_cov, hC₀_coset⟩ :=
          weil_mid_dev_puncture_etale_inertia_coset_sheet
            F D₀.left U₀ R₀ D.e_U (D.B_V r) (D.L_V r)
            (Polynomial F) AlgEquiv.refl a r_a hr_a_span R_a₀ R_a_U
            1 one_ne_zero ι_a p'_a hp'_a_comap ψ_a hψ_a_loc β_a
            hU₀_a_pre hι_a_comp hβ_a_poly hβ_a_R₀ W x (hx_pa.trans hp'_a_pt.symm)
        obtain ⟨g_Q, hg_Q, hQ₀_act⟩ := (hInert_all r).1 a ha Q₀ hQ₀_prime hQ₀_comap
        obtain ⟨hLiftQ, hLiftL⟩ := hPadicLift r g_Q hg_Q
        let W''_U := (weilEtaleSitePullback U₀.ι).obj W''
        have hCosetLift := (hLiftAt W''_U).1 H_I C₀
          hC₀_ne hC₀_clopen hC₀_preconn hC₀_cov hC₀_coset (ℓ ^ C₁) (ℓ ^ C₂)
        refine ⟨W'', u_ref, x'', hu_ref_et, hx''_eq, ?_, ?_⟩
        · apply hCosetLift.1
          intro q_mod
          obtain ⟨x_hat, hx_hat_coord, hx_hat_inv⟩ := hLiftQ q_mod
          refine ⟨x_hat, hx_hat_coord, fun τ hτ => ?_⟩
          obtain ⟨σ_L, hσ_int, hσ_ext, hσ_inert⟩ := hHI_inert τ hτ
          obtain ⟨u_g, hu_g, hu_mod, c_g, hu_act⟩ :=
            hQ₀_act σ_L τ hσ_int hσ_ext hσ_inert
          rw [hu_mod]
          exact hx_hat_inv u_g hu_g c_g hu_act
        · apply hCosetLift.2
          intro v_mod hv_mod
          obtain ⟨e_hat, he_hat_zero, he_hat_coord, he_hat_inv⟩ := hLiftL v_mod
          refine ⟨e_hat, he_hat_zero, he_hat_coord, fun τ hτ => ?_⟩
          obtain ⟨σ_L, hσ_int, hσ_ext, hσ_inert⟩ := hHI_inert τ hτ
          obtain ⟨u_g, hu_g, hu_mod, c_g, hu_act⟩ :=
            hQ₀_act σ_L τ hσ_int hσ_ext hσ_inert
          have hmid := hv_mod τ hτ
          dsimp only [P_r, P_inv_r] at hmid
          rw [hu_mod] at hmid
          have htop := he_hat_inv u_g hu_g c_g hu_act hmid
          have hEqMat : (ρ_ℰ r τ).val = Matrix.of fun i₁ i₂ : Fin (M₀ + M) =>
              (P_inv_r * ((u_g.val).map (PadicInt.toZModPow (r + 1))) * P_r)
                ⟨i₁.1, by omega⟩ ⟨i₂.1, by omega⟩ := by
            ext i₁ i₂
            rw [((_hρ_blocks r τ).1 i₁ i₂), Matrix.of_apply]
            dsimp only [P_r, P_inv_r]
            rw [hu_mod]
          rw [hEqMat]
          exact htop
  refine ⟨?_, ?_⟩
  · apply hCokCrit (D.𝒱₀ r) (𝒬₀ r) (π_𝒬 r) (ℓ ^ C₁)
    intro W x s₂
    obtain ⟨W', u, x', hu_et, hx', hQ_lift, _⟩ := hLocalGeom W x
    obtain ⟨s₁, hs₁⟩ := hQ_lift (((𝒬₀ r).obj.map (Opposite.op ((weilEtaleSitePullback U₀.ι).map u))) s₂)
    exact ⟨W', u, x', s₁, hu_et, hx', hs₁⟩
  · apply hCokCrit (ℰ₀ r) (ℒ₀ r) (π_ℒ r) (ℓ ^ C₂)
    intro W x s₂
    obtain ⟨W', u, x', hu_et, hx', _, hL_lift⟩ := hLocalGeom W x
    obtain ⟨s₁, hs₁⟩ := hL_lift (((ℒ₀ r).obj.map (Opposite.op ((weilEtaleSitePullback U₀.ι).map u))) s₂)
    exact ⟨W', u, x', s₁, hu_et, hx', hs₁⟩

theorem weil_mid_dev_left_exact_up_to_pow_roof_eigenvalue_transfer (F : Type u) [Finite F] [Field F]
    (Y₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (ℛ_D ℰ_D 𝒱_D 𝒬_D ℒ_D : ℕ → CategoryTheory.Sheaf Y₀.left.smallEtaleTopology AddCommGrpCat.{u})
    (τ_ℰ_D : ∀ r : ℕ, Quiver.Hom (ℰ_D (r + 1)) (ℰ_D r))
    (τ_𝒱_D : ∀ r : ℕ, Quiver.Hom (𝒱_D (r + 1)) (𝒱_D r))
    (τ_ℒ_D : ∀ r : ℕ, Quiver.Hom (ℒ_D (r + 1)) (ℒ_D r))
    (α₁ : ∀ r : ℕ, Quiver.Hom (ℰ_D r) (𝒱_D r))
    (β₁ : ∀ r : ℕ, Quiver.Hom (𝒱_D r) (𝒬_D r))
    (α₂ : ∀ r : ℕ, Quiver.Hom (ℛ_D r) (ℰ_D r))
    (β₂ : ∀ r : ℕ, Quiver.Hom (ℰ_D r) (ℒ_D r))
    (C₁ C₂ : ℕ)
    (E_mid : WeilTransvTriSheafCohomologyModel F Y₀ ℓ 1 ℰ_D τ_ℰ_D)
    (E_push : WeilTransvTriSheafCohomologyModel F Y₀ ℓ 1 𝒱_D τ_𝒱_D)
    (W_mid : WeilTransvTriSheafCohomologyModel F Y₀ ℓ 1 ℒ_D τ_ℒ_D)
    (hFin_Emid : ∀ r : ℕ, Finite ((E_mid.ℳ_bar r).H 1))
    (hTor_ℰ : ∀ r : ℕ, (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id (ℰ_D r) = 0)
    (hSeq₁ : ∀ r : ℕ,
      CategoryTheory.Mono (α₁ r) ∧
      (∃ h0₁ : CategoryTheory.CategoryStruct.comp (α₁ r) (β₁ r) = 0,
        (CategoryTheory.ShortComplex.mk (α₁ r) (β₁ r) h0₁).Exact) ∧
      CategoryTheory.CategoryStruct.comp (τ_ℰ_D r) (α₁ r) =
        CategoryTheory.CategoryStruct.comp (α₁ (r + 1)) (τ_𝒱_D r) ∧
      (ℓ ^ C₁) • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel (β₁ r)) = 0)
    (hSeq₂ : ∀ r : ℕ,
      CategoryTheory.Mono (α₂ r) ∧
      (∃ h0₂ : CategoryTheory.CategoryStruct.comp (α₂ r) (β₂ r) = 0,
        (CategoryTheory.ShortComplex.mk (α₂ r) (β₂ r) h0₂).Exact) ∧
      CategoryTheory.CategoryStruct.comp (τ_ℰ_D r) (β₂ r) =
        CategoryTheory.CategoryStruct.comp (β₂ (r + 1)) (τ_ℒ_D r) ∧
      (ℓ ^ C₂) • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel (β₂ r)) = 0)
    (hSub_outer :
      let pr_Y : Quiver.Hom (weilGeomScheme F Y₀) Y₀.left :=
        CategoryTheory.Limits.pullback.fst Y₀.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      ∀ (r : ℕ)
        (hCont_pr : (weilEtaleSitePullback pr_Y).IsContinuous
          Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology)
        (hAdj_pr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
          Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology
          hCont_pr).IsRightAdjoint),
        let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback pr_Y) AddCommGrpCat.{u} _
          Y₀.left.smallEtaleTopology (weilGeomScheme F Y₀).smallEtaleTopology hCont_pr hAdj_pr
        Subsingleton ((L_pr.obj (𝒬_D r)).H 1) ∧ Subsingleton ((L_pr.obj (ℛ_D r)).H 1))
    (γ' : AlgebraicClosure (Padic ℓ))
    (hγ'_push : γ' ∈ ((E_push.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    γ' ∈ ((W_mid.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) :=
by
  
  have hH1Exact :
      ∀ (X₀ S₀ : AlgebraicGeometry.Scheme.{u})
        (L₀ : CategoryTheory.Functor
          (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}))
        (hAdd : L₀.Additive)
        (hColim : CategoryTheory.Limits.PreservesFiniteColimits L₀)
        (hLim : CategoryTheory.Limits.PreservesFiniteLimits L₀)
        (ℱ₁ ℱ₂ ℱ₃ : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
        (α : Quiver.Hom ℱ₁ ℱ₂)
        (β : Quiver.Hom ℱ₂ ℱ₃)
        (hMono : CategoryTheory.Mono α)
        (h0 : CategoryTheory.CategoryStruct.comp α β = 0)
        (hEx : (CategoryTheory.ShortComplex.mk α β h0).Exact)
        (N : ℕ)
        (hCok : N • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.cokernel β) = 0),
        let Fℤ₀ := (CategoryTheory.constantSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ))
        (Subsingleton ((L₀.obj ℱ₃).H 1) →
          ∀ y : (L₀.obj ℱ₂).H 1,
            ∃ x : (L₀.obj ℱ₁).H 1,
              ((CategoryTheory.Abelian.Ext.mk₀ (L₀.map α)).postcomp Fℤ₀ (Nat.add_zero 1)) x =
                N • y) ∧
        (Subsingleton ((L₀.obj ℱ₁).H 1) →
          ∀ x : (L₀.obj ℱ₂).H 1,
            ((CategoryTheory.Abelian.Ext.mk₀ (L₀.map β)).postcomp Fℤ₀ (Nat.add_zero 1)) x = 0 →
            N • x = 0) := by
    clear hFin_Emid hTor_ℰ hSeq₁ hSeq₂ hSub_outer hγ'_push E_mid E_push W_mid
      α₁ β₁ α₂ β₂ τ_ℰ_D τ_𝒱_D τ_ℒ_D ℛ_D ℰ_D 𝒱_D 𝒬_D ℒ_D C₁ C₂ γ' Y₀
    intro X₀ S₀ L₀ hAdd hColim hLim ℱ₁ ℱ₂ ℱ₃ α β hMono h0 hEx N hCok Fℤ₀
    have _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
        (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
    have _ : CategoryTheory.Limits.HasColimitsOfShape CategoryTheory.Limits.WalkingParallelPair
        (CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
    let _ : CategoryTheory.Abelian
        (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
    let _ : CategoryTheory.Abelian
        (CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
    let _ : CategoryTheory.HasExt.{u}
        (CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}) := inferInstance
    let _ : L₀.Additive := hAdd
    let _ : CategoryTheory.Limits.PreservesFiniteColimits L₀ := hColim
    let _ : CategoryTheory.Limits.PreservesFiniteLimits L₀ := hLim

    let mapH₀ : ∀ {d : ℕ}
        {𝒜 ℬ : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}},
        Quiver.Hom 𝒜 ℬ → (𝒜.H d →+ ℬ.H d) :=
      fun {d 𝒜 ℬ} f => (CategoryTheory.Abelian.Ext.mk₀ f).postcomp Fℤ₀ (Nat.add_zero d)

    have hExt_nsmul : ∀ {d : ℕ}
        {𝒴 : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
        (w : 𝒴.H d) (k : ℕ),
        mapH₀ (k • CategoryTheory.CategoryStruct.id 𝒴) w = k • w := by
      intro d 𝒴 w k
      change w.comp (CategoryTheory.Abelian.Ext.mk₀ (k • CategoryTheory.CategoryStruct.id 𝒴))
        (Nat.add_zero d) = k • w
      induction k with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]

    have hPost_comp : ∀ {d : ℕ}
        {𝒜 ℬ 𝒞 : CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}}
        (f : Quiver.Hom 𝒜 ℬ) (g : Quiver.Hom ℬ 𝒞) (w : 𝒜.H d),
        mapH₀ g (mapH₀ f w) = mapH₀ (CategoryTheory.CategoryStruct.comp f g) w :=
      fun {d 𝒜 ℬ 𝒞} f g w =>
        (CategoryTheory.Abelian.Ext.comp_assoc w
          (CategoryTheory.Abelian.Ext.mk₀ f) (CategoryTheory.Abelian.Ext.mk₀ g)
          (Nat.add_zero d) (Nat.zero_add 0) (by omega)).trans
          (congrArg (fun u => w.comp u (Nat.add_zero d))
            (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f g))

    let ℐ := CategoryTheory.Limits.cokernel α
    let p : Quiver.Hom ℱ₂ ℐ := CategoryTheory.Limits.cokernel.π α
    let SC_a := CategoryTheory.ShortComplex.mk α p (CategoryTheory.Limits.cokernel.condition α)
    have hSE_a : SC_a.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC_a
          (CategoryTheory.Limits.cokernelIsCokernel α))
        hMono inferInstance
    have hSE_a_bar : (SC_a.map L₀).ShortExact := hSE_a.map_of_exact L₀

    let i_hom : Quiver.Hom ℐ ℱ₃ := CategoryTheory.Limits.cokernel.desc α β h0
    have hpi : CategoryTheory.CategoryStruct.comp p i_hom = β :=
      CategoryTheory.Limits.cokernel.π_desc α β h0
    have hMono_i : CategoryTheory.Mono i_hom := hEx.mono_cokernelDesc

    let 𝒞 := CategoryTheory.Limits.cokernel β
    let q : Quiver.Hom ℱ₃ 𝒞 := CategoryTheory.Limits.cokernel.π β
    have hiq : CategoryTheory.CategoryStruct.comp i_hom q = 0 := by
      apply (CategoryTheory.cancel_epi p).mp
      rw [← CategoryTheory.Category.assoc, hpi, CategoryTheory.Limits.cokernel.condition β,
        CategoryTheory.Limits.comp_zero]
    have hColim_iq : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ q hiq) :=
      CategoryTheory.Limits.CokernelCofork.IsColimit.ofπ q hiq
        (fun g' hg' => CategoryTheory.Limits.cokernel.desc β g' (by
          rw [← hpi, CategoryTheory.Category.assoc, hg', CategoryTheory.Limits.comp_zero]))
        (fun _ _ => CategoryTheory.Limits.cokernel.π_desc _ _ _)
        (fun _ _ _ hm => (CategoryTheory.cancel_epi q).mp
          (hm.trans (CategoryTheory.Limits.cokernel.π_desc _ _ _).symm))

    let SC_b := CategoryTheory.ShortComplex.mk i_hom q hiq
    have hSE_b : SC_b.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC_b hColim_iq)
        hMono_i inferInstance
    have hSE_b_bar : (SC_b.map L₀).ShortExact := hSE_b.map_of_exact L₀

    have hCok_bar : N • CategoryTheory.CategoryStruct.id (L₀.obj 𝒞) = 0 := by
      rw [← L₀.map_id, ← CategoryTheory.Functor.map_nsmul, hCok, L₀.map_zero]

    have hAnn_H0 : ∀ c₀ : (L₀.obj 𝒞).H 0, N • c₀ = 0 := by
      intro c₀
      rw [← hExt_nsmul c₀ N, hCok_bar]
      change c₀.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : Quiver.Hom (L₀.obj 𝒞) (L₀.obj 𝒞)))
        (Nat.add_zero 0) = 0
      rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

    have hAnn_ker_i : ∀ z : (L₀.obj ℐ).H 1,
        mapH₀ (L₀.map i_hom) z = 0 → N • z = 0 := by
      intro z hz
      obtain ⟨c₀, hc₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ₀ hSE_b_bar z hz (Nat.zero_add 1)
      let δ : (L₀.obj 𝒞).H 0 →+ (L₀.obj ℐ).H 1 :=
        hSE_b_bar.extClass.postcomp Fℤ₀ (Nat.zero_add 1)
      have hδ : δ c₀ = z := hc₀
      rw [← hδ, ← map_nsmul, hAnn_H0 c₀, map_zero]

    refine ⟨?_, ?_⟩
    · intro hSub₃ y
      let z : (L₀.obj ℐ).H 1 := mapH₀ (L₀.map p) y
      have hiz : mapH₀ (L₀.map i_hom) z = 0 := @Subsingleton.elim _ hSub₃ _ _
      have hNz : N • z = 0 := hAnn_ker_i z hiz
      have hpNy : (N • y).comp (CategoryTheory.Abelian.Ext.mk₀ (L₀.map p))
          (Nat.add_zero 1) = 0 := by
        change mapH₀ (L₀.map p) (N • y) = 0
        rw [map_nsmul]
        exact hNz
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ₀ hSE_a_bar (N • y) hpNy
    · intro hSub₁ x hβx
      let z : (L₀.obj ℐ).H 1 := mapH₀ (L₀.map p) x
      have hiz : mapH₀ (L₀.map i_hom) z = 0 := by
        dsimp [z]
        rw [hPost_comp, ← L₀.map_comp, hpi]
        exact hβx
      have hNz : N • z = 0 := hAnn_ker_i z hiz
      have hpNx : (N • x).comp (CategoryTheory.Abelian.Ext.mk₀ (L₀.map p))
          (Nat.add_zero 1) = 0 := by
        change mapH₀ (L₀.map p) (N • x) = 0
        rw [map_nsmul]
        exact hNz
      obtain ⟨w, hw⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ₀ hSE_a_bar (N • x) hpNx
      have hw0 : w = 0 := @Subsingleton.elim _ hSub₁ w 0
      have hw' : mapH₀ (L₀.map α) w = N • x := hw
      rw [← hw', hw0, map_zero]

  
  have hPadicTowerMap :
      ∀ (H₁ H₂ : ℕ → Type u) [∀ r, AddCommGroup (H₁ r)] [∀ r, AddCommGroup (H₂ r)]
        (τ₁ : ∀ r : ℕ, H₁ (r + 1) →+ H₁ r)
        (τ₂ : ∀ r : ℕ, H₂ (r + 1) →+ H₂ r)
        (f₁ : ∀ r : ℕ, H₁ r →+ H₁ r)
        (f₂ : ∀ r : ℕ, H₂ r →+ H₂ r)
        (q : ∀ r : ℕ, H₁ r →+ H₂ r)
        (sys₁ : AddSubgroup (∀ r : ℕ, H₁ r))
        (sys₂ : AddSubgroup (∀ r : ℕ, H₂ r))
        (V₁ V₂ : Type u) [AddCommGroup V₁] [Module (Padic ℓ) V₁]
        [AddCommGroup V₂] [Module (Padic ℓ) V₂]
        (frob₁ : V₁ →ₗ[Padic ℓ] V₁)
        (frob₂ : V₂ →ₗ[Padic ℓ] V₂)
        (equiv₁ : TensorProduct ℤ ℚ ↥sys₁ ≃+ V₁)
        (equiv₂ : TensorProduct ℤ ℚ ↥sys₂ ≃+ V₂),
        (∀ (r : ℕ) (w : H₁ r), (ℓ ^ (r + 1)) • w = 0) →
        (∀ (r : ℕ) (x : H₁ (r + 1)), q r (τ₁ r x) = τ₂ r (q (r + 1) x)) →
        (∀ (r : ℕ) (x : H₁ r), q r (f₁ r x) = f₂ r (q r x)) →
        (∀ (r : ℕ) (x : H₁ (r + 1)), τ₁ r (f₁ (r + 1) x) = f₁ r (τ₁ r x)) →
        (∀ x : (∀ r : ℕ, H₁ r), x ∈ sys₁ ↔ ∀ r : ℕ, τ₁ r (x (r + 1)) = x r) →
        (∀ y : (∀ r : ℕ, H₂ r), y ∈ sys₂ ↔ ∀ r : ℕ, τ₂ r (y (r + 1)) = y r) →
        (∀ (z : PadicInt ℓ) (x y : ↥sys₁),
          (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
            equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ) • equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) →
        (∀ (z : PadicInt ℓ) (x y : ↥sys₂),
          (∀ r : ℕ, y.1 r = (PadicInt.toZModPow (r + 1) z).val • x.1 r) →
            equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y) =
              (z : Padic ℓ) • equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) →
        (∀ (x y : ↥sys₁),
          (∀ r : ℕ, y.1 r = f₁ r (x.1 r)) →
            frob₁ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) y)) →
        (∀ (x y : ↥sys₂),
          (∀ r : ℕ, y.1 r = f₂ r (x.1 r)) →
            frob₂ (equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) x)) =
              equiv₂ (TensorProduct.tmul ℤ (1 : ℚ) y)) →
        ∃ π : V₁ →ₗ[Padic ℓ] V₂,
          (∀ v : V₁, π (frob₁ v) = frob₂ (π v)) ∧
          ((∀ r : ℕ, Finite (H₁ r)) →
            ∀ B₁ : ℕ, (∀ (r : ℕ) (y : H₂ r), ∃ x : H₁ r, q r x = (ℓ ^ B₁) • y) →
            Function.Surjective π) ∧
          (∀ B₂ : ℕ, (∀ (r : ℕ) (x : H₁ r), q r x = 0 → (ℓ ^ B₂) • x = 0) →
            Function.Injective π) := by
    clear hH1Exact hFin_Emid hTor_ℰ hSeq₁ hSeq₂ hSub_outer hγ'_push E_mid E_push W_mid
      α₁ β₁ α₂ β₂ τ_ℰ_D τ_𝒱_D τ_ℒ_D ℛ_D ℰ_D 𝒱_D 𝒬_D ℒ_D C₁ C₂ γ' Y₀
    intro H₁ H₂ _ _ τ₁ τ₂ f₁ f₂ q sys₁ sys₂ V₁ V₂ _ _ _ _ frob₁ frob₂ equiv₁ equiv₂
      hTors₁ hq_τ hq_f hf₁_τ hsys₁ hsys₂ hsmul₁ hsmul₂ hfrob₁ hfrob₂
    have hPrime : Nat.Prime ℓ := Fact.out
    let q_sys : ↥sys₁ →+ ↥sys₂ :=
      { toFun := fun x => ⟨fun r => q r (x.1 r), (hsys₂ _).mpr fun r => by
          rw [← hq_τ r (x.1 (r + 1)), (hsys₁ x.1).mp x.2 r]⟩
        map_zero' := Subtype.ext (funext fun r => map_zero (q r))
        map_add' := fun x y => Subtype.ext (funext fun r => map_add (q r) (x.1 r) (y.1 r)) }

    let Q_rat : TensorProduct ℤ ℚ ↥sys₁ →ₗ[ℤ] TensorProduct ℤ ℚ ↥sys₂ :=
      LinearMap.lTensor ℚ q_sys.toIntLinearMap
    let π₀ : V₁ →+ V₂ :=
      equiv₂.toAddMonoidHom.comp (Q_rat.toAddMonoidHom.comp equiv₁.symm.toAddMonoidHom)
    have hπ₀_tmul : ∀ (a : ℚ) (x : ↥sys₁),
        π₀ (equiv₁ (TensorProduct.tmul ℤ a x)) = equiv₂ (TensorProduct.tmul ℤ a (q_sys x)) := by
      intro a x
      change equiv₂ (Q_rat (equiv₁.symm (equiv₁ (TensorProduct.tmul ℤ a x)))) = _
      rw [AddEquiv.symm_apply_apply]
      exact congrArg equiv₂ (LinearMap.lTensor_tmul ℚ q_sys.toIntLinearMap a x)

    have hRatSmul : ∀ {S W : Type u} [AddCommGroup S] [AddCommGroup W] [Module (Padic ℓ) W]
        (E : TensorProduct ℤ ℚ S ≃+ W) (a : ℚ) (s : S),
        E (TensorProduct.tmul ℤ a s) = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
      intro S W _ _ _ E a s
      let m : ℤ := a.num
      let d : ℕ := a.den
      have hd_pos : 0 < d := a.pos
      have hd_ne_K : (d : Padic ℓ) ≠ 0 := Nat.cast_ne_zero.mpr hd_pos.ne'
      have hda : (d : ℚ) * a = (m : ℚ) := by
        dsimp [d, m]
        rw [mul_comm]
        exact Rat.mul_den_eq_num a
      have h_tens : d • (TensorProduct.tmul ℤ a s) = m • (TensorProduct.tmul ℤ (1 : ℚ) s) := by
        calc d • (TensorProduct.tmul ℤ a s)
            = (d : ℤ) • (TensorProduct.tmul ℤ a s) := (natCast_zsmul _ _).symm
          _ = TensorProduct.tmul ℤ ((d : ℤ) • a) s := (TensorProduct.smul_tmul' (d : ℤ) a s).symm
          _ = TensorProduct.tmul ℤ ((d : ℚ) * a) s := by rw [zsmul_eq_mul, Int.cast_natCast]
          _ = TensorProduct.tmul ℤ (m • (1 : ℚ)) s := by rw [hda, zsmul_eq_mul, mul_one]
          _ = m • TensorProduct.tmul ℤ (1 : ℚ) s := TensorProduct.smul_tmul' m (1 : ℚ) s
      have hE_eq : d • E (TensorProduct.tmul ℤ a s) = m • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
        rw [← map_nsmul, ← map_zsmul, h_tens]
      have hK_lhs : d • E (TensorProduct.tmul ℤ a s) = (d : Padic ℓ) • E (TensorProduct.tmul ℤ a s) :=
        (Nat.cast_smul_eq_nsmul (Padic ℓ) d _).symm
      have hK_rhs : m • E (TensorProduct.tmul ℤ (1 : ℚ) s) =
          (d : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) := by
        rw [← Int.cast_smul_eq_zsmul (Padic ℓ) m, ← mul_smul]
        congr 1
        have hda_K := congrArg (Rat.cast : ℚ → Padic ℓ) hda
        push_cast at hda_K
        exact hda_K.symm
      rw [hK_lhs, hK_rhs] at hE_eq
      calc E (TensorProduct.tmul ℤ a s)
          = ((d : Padic ℓ)⁻¹ * (d : Padic ℓ)) • E (TensorProduct.tmul ℤ a s) := by
              rw [inv_mul_cancel₀ hd_ne_K, one_smul]
        _ = (d : Padic ℓ)⁻¹ • ((d : Padic ℓ) • E (TensorProduct.tmul ℤ a s)) :=
              mul_smul _ _ _
        _ = (d : Padic ℓ)⁻¹ • ((d : Padic ℓ) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s))) := by
              rw [hE_eq]
        _ = ((d : Padic ℓ)⁻¹ * (d : Padic ℓ)) • ((a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s)) :=
              (mul_smul _ _ _).symm
        _ = (a : Padic ℓ) • E (TensorProduct.tmul ℤ (1 : ℚ) s) := by
              rw [inv_mul_cancel₀ hd_ne_K, one_smul]

    have hMod_nsmul : ∀ {A : Type u} [AddCommGroup A] {N : ℕ} (w : A),
        N • w = 0 → ∀ k : ℕ, (k % N) • w = k • w := by
      intro A _ N w hNw k
      conv_rhs => rw [← Nat.div_add_mod k N]
      rw [add_nsmul, mul_comm N (k / N), mul_nsmul', hNw, smul_zero, zero_add]

    have hz_mem₁ : ∀ (z : PadicInt ℓ) (x : ↥sys₁),
        (fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r) ∈ sys₁ := by
      intro z x
      rw [hsys₁]
      intro r
      rw [map_nsmul, (hsys₁ x.1).mp x.2 r]
      have hcast : PadicInt.toZModPow (r + 1) z =
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (r + 1))) (ZMod (ℓ ^ (r + 1)))
            (PadicInt.toZModPow (r + 2) z) :=
        (RingHom.congr_fun (PadicInt.zmod_cast_comp_toZModPow (r + 1) (r + 2)
          (Nat.le_succ (r + 1))) z).symm
      have hcast_val : (PadicInt.toZModPow (r + 1) z).val =
          (PadicInt.toZModPow (r + 2) z).val % (ℓ ^ (r + 1)) := by
        rw [hcast, ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.val_natCast]
      rw [hcast_val, hMod_nsmul (x.1 r) (hTors₁ r (x.1 r))]

    have hπ₀_smul : ∀ (c : Padic ℓ) (v : V₁), π₀ (c • v) = c • π₀ v := by
      intro c v
      have h_gt1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast hPrime.one_lt
      obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ‖c‖ h_gt1
      have hnorm_le : ‖(ℓ : Padic ℓ) ^ k * c‖ ≤ 1 := by
        rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
        have hpos : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos (by positivity) k
        rw [inv_mul_le_iff₀ hpos, mul_one]
        exact le_of_lt hk
      let z : PadicInt ℓ := ⟨(ℓ : Padic ℓ) ^ k * c, hnorm_le⟩
      have hz_coe : (z : Padic ℓ) = (ℓ : Padic ℓ) ^ k * c := rfl
      have hℓk_ne_K : ((ℓ : Padic ℓ) ^ k) ≠ 0 := pow_ne_zero k (Nat.cast_ne_zero.mpr hPrime.ne_zero)
      let t : TensorProduct ℤ ℚ ↥sys₁ := equiv₁.symm v
      have hv_eq : v = equiv₁ t := (equiv₁.apply_symm_apply v).symm
      rw [hv_eq]
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
        (fun w => π₀ (c • equiv₁ w) = c • π₀ (equiv₁ w)) t ?_ ?_
      · intro a x
        let zx : ↥sys₁ := ⟨fun r => (PadicInt.toZModPow (r + 1) z).val • x.1 r, hz_mem₁ z x⟩
        let q' : ℚ := a * ((ℓ : ℚ) ^ k)⁻¹
        have hq'_z : (q' : Padic ℓ) * (z : Padic ℓ) = c * (a : Padic ℓ) := by
          dsimp [q']
          push_cast
          rw [hz_coe]
          calc (a : Padic ℓ) * ((ℓ : Padic ℓ) ^ k)⁻¹ * ((ℓ : Padic ℓ) ^ k * c)
              = (a : Padic ℓ) * (((ℓ : Padic ℓ) ^ k)⁻¹ * (ℓ : Padic ℓ) ^ k) * c := by ring
            _ = c * (a : Padic ℓ) := by rw [inv_mul_cancel₀ hℓk_ne_K, mul_one, mul_comm]
        have h1 : c • equiv₁ (TensorProduct.tmul ℤ a x) = equiv₁ (TensorProduct.tmul ℤ q' zx) := by
          rw [hRatSmul equiv₁ q' zx,
            hsmul₁ z x zx (fun _ => rfl), ← mul_smul, hq'_z, mul_smul,
            ← hRatSmul equiv₁ a x]
        have h2 : c • equiv₂ (TensorProduct.tmul ℤ a (q_sys x)) =
            equiv₂ (TensorProduct.tmul ℤ q' (q_sys zx)) := by
          have hq_zx : ∀ r : ℕ, (q_sys zx).1 r = (PadicInt.toZModPow (r + 1) z).val • (q_sys x).1 r :=
            fun r => map_nsmul (q r) _ (x.1 r)
          rw [hRatSmul equiv₂ q' (q_sys zx),
            hsmul₂ z (q_sys x) (q_sys zx) hq_zx, ← mul_smul, hq'_z, mul_smul,
            ← hRatSmul equiv₂ a (q_sys x)]
        rw [h1, hπ₀_tmul, hπ₀_tmul, h2]
      · intro w₁ w₂ ih₁ ih₂
        rw [map_add, smul_add, map_add, ih₁, ih₂, map_add, smul_add]

    let π : V₁ →ₗ[Padic ℓ] V₂ :=
      { toFun := π₀
        map_add' := π₀.map_add
        map_smul' := hπ₀_smul }

    have hπ_frob : ∀ v : V₁, π (frob₁ v) = frob₂ (π v) := by
      intro v
      let t : TensorProduct ℤ ℚ ↥sys₁ := equiv₁.symm v
      have hv_eq : v = equiv₁ t := (equiv₁.apply_symm_apply v).symm
      rw [hv_eq]
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₁ _ _ _ _
        (fun w => π (frob₁ (equiv₁ w)) = frob₂ (π (equiv₁ w))) t ?_ ?_
      · intro a x
        let y₁ : ↥sys₁ := ⟨fun r => f₁ r (x.1 r), (hsys₁ _).mpr fun r => by
          rw [hf₁_τ r (x.1 (r + 1)), (hsys₁ x.1).mp x.2 r]⟩
        have hq_y₁ : ∀ r : ℕ, (q_sys y₁).1 r = f₂ r ((q_sys x).1 r) :=
          fun r => hq_f r (x.1 r)
        rw [hRatSmul equiv₁ a x, map_smul, map_smul, map_smul, map_smul]
        congr 1
        change π₀ (frob₁ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x))) =
          frob₂ (π₀ (equiv₁ (TensorProduct.tmul ℤ (1 : ℚ) x)))
        rw [hfrob₁ x y₁ (fun _ => rfl), hπ₀_tmul, hπ₀_tmul, hfrob₂ (q_sys x) (q_sys y₁) hq_y₁]
      · intro w₁ w₂ ih₁ ih₂
        rw [map_add, map_add, map_add, ih₁, ih₂, map_add, map_add]

    refine ⟨π, hπ_frob, ?_, ?_⟩
    · 
      intro hFin₁ B₁ hq_pow_surj
      have hq_sys_pow : ∀ y : ↥sys₂, ∃ x : ↥sys₁, q_sys x = (ℓ ^ B₁) • y := by
        intro y
        let K_fib : ℕ → Type u := fun r => { x_r : H₁ r // q r x_r = (ℓ ^ B₁) • y.1 r }
        let step : ∀ r : ℕ, K_fib (r + 1) → K_fib r := fun r x_succ =>
          ⟨τ₁ r x_succ.1, by
            rw [hq_τ r x_succ.1, x_succ.2, map_nsmul, (hsys₂ y.1).mp y.2 r]⟩
        let iter : ∀ (b a : ℕ), a ≤ b → K_fib b → K_fib a :=
          Nat.rec
            (fun a h x => Eq.mp (congrArg K_fib (Nat.eq_zero_of_le_zero h).symm) x)
            (fun b' rec_b' a h x =>
              if h' : a ≤ b' then rec_b' a h' (step b' x)
              else Eq.mp (congrArg K_fib (by omega : b' + 1 = a)) x)
        have h_iter_id : ∀ (a : ℕ) (ha : a ≤ a) (x : K_fib a), iter a a ha x = x := by
          intro a ha x
          cases a with
          | zero => rfl
          | succ a' =>
            change (if h' : a' + 1 ≤ a' then iter a' (a' + 1) h' (step a' x) else x) = x
            have hnot : ¬ (a' + 1 ≤ a') := Nat.not_succ_le_self a'
            simp only [hnot, ↓reduceDIte]
        have h_iter_comp : ∀ (c a b : ℕ) (hab : a ≤ b) (hbc : b ≤ c) (x : K_fib c),
            iter c a (le_trans hab hbc) x = iter b a hab (iter c b hbc x) := by
          intro c
          induction c with
          | zero =>
            intro a b hab hbc x
            have hb : b = 0 := Nat.eq_zero_of_le_zero hbc
            subst hb
            have ha : a = 0 := Nat.eq_zero_of_le_zero hab
            subst ha
            rfl
          | succ c' ih =>
            intro a b hab hbc x
            by_cases hbc' : b ≤ c'
            · have hac' : a ≤ c' := le_trans hab hbc'
              change (if h' : a ≤ c' then iter c' a h' (step c' x) else _) =
                iter b a hab (if h' : b ≤ c' then iter c' b h' (step c' x) else _)
              simp only [hac', hbc', ↓reduceDIte]
              exact ih a b hab hbc' (step c' x)
            · have hb_eq : b = c' + 1 := by omega
              subst hb_eq
              rw [h_iter_id (c' + 1) hbc x]
        let F_inv : CategoryTheory.Functor ℕᵒᵖ (Type u) :=
          { obj := fun n => K_fib (Opposite.unop n)
            map := fun {n₁ n₂} f => TypeCat.ofHom
              (iter (Opposite.unop n₁) (Opposite.unop n₂) (CategoryTheory.leOfHom f.unop))
            map_id := fun n =>
              congrArg TypeCat.ofHom (funext fun x => h_iter_id (Opposite.unop n) _ x)
            map_comp := fun {n₁ n₂ n₃} f g =>
              congrArg TypeCat.ofHom (funext fun x =>
                h_iter_comp (Opposite.unop n₁) (Opposite.unop n₃) (Opposite.unop n₂)
                  (CategoryTheory.leOfHom g.unop) (CategoryTheory.leOfHom f.unop) x) }
        have : ∀ j : ℕᵒᵖ, Finite (F_inv.obj j) := fun j => by
          have := hFin₁ (Opposite.unop j)
          exact Subtype.finite
        have : ∀ j : ℕᵒᵖ, Nonempty (F_inv.obj j) := fun j => by
          obtain ⟨x_j, hx_j⟩ := hq_pow_surj (Opposite.unop j) (y.1 (Opposite.unop j))
          exact ⟨⟨x_j, hx_j⟩⟩
        obtain ⟨sec, hsec⟩ := nonempty_sections_of_finite_inverse_system F_inv
        refine ⟨⟨fun r => (sec (Opposite.op r)).1, (hsys₁ _).mpr fun r => ?_⟩, ?_⟩
        · have hstep := hsec (CategoryTheory.homOfLE (Nat.le_succ r)).op
          have h1 : (F_inv.map (CategoryTheory.homOfLE (Nat.le_succ r)).op)
              (sec (Opposite.op (r + 1))) = step r (sec (Opposite.op (r + 1))) := by
            change (if h' : r ≤ r then iter r r h' (step r (sec (Opposite.op (r + 1)))) else _) = _
            have hrr : r ≤ r := le_refl r
            simp only [hrr, ↓reduceDIte]
            exact h_iter_id r hrr _
          rw [h1] at hstep
          exact congrArg Subtype.val hstep
        · apply Subtype.ext
          ext r
          exact (sec (Opposite.op r)).2

      have hℓ_pow_ne_Q : ((ℓ ^ B₁ : ℕ) : ℚ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (pow_ne_zero B₁ hPrime.ne_zero)
      intro v
      let t : TensorProduct ℤ ℚ ↥sys₂ := equiv₂.symm v
      have hv_eq : v = equiv₂ t := (equiv₂.apply_symm_apply v).symm
      rw [hv_eq]
      refine @TensorProduct.inductionOn ℤ _ ℚ ↥sys₂ _ _ _ _
        (fun w => ∃ u : V₁, π u = equiv₂ w) t ?_ ?_
      · intro a y
        obtain ⟨x, hx⟩ := hq_sys_pow y
        let a' : ℚ := a * (((ℓ ^ B₁ : ℕ) : ℚ)⁻¹)
        refine ⟨equiv₁ (TensorProduct.tmul ℤ a' x), ?_⟩
        change π₀ (equiv₁ (TensorProduct.tmul ℤ a' x)) = equiv₂ (TensorProduct.tmul ℤ a y)
        rw [hπ₀_tmul, hx]
        congr 1
        calc TensorProduct.tmul ℤ a' ((ℓ ^ B₁) • y)
            = TensorProduct.tmul ℤ a' (((ℓ ^ B₁ : ℕ) : ℤ) • y) := by rw [natCast_zsmul]
          _ = TensorProduct.tmul ℤ (((ℓ ^ B₁ : ℕ) : ℤ) • a') y :=
              (TensorProduct.smul_tmul ((ℓ ^ B₁ : ℕ) : ℤ) a' y).symm
          _ = TensorProduct.tmul ℤ a y := by
              congr 1
              rw [zsmul_eq_mul, Int.cast_natCast]
              dsimp [a']
              rw [mul_comm, inv_mul_cancel_right₀ hℓ_pow_ne_Q]
      · rintro w₁ w₂ ⟨u₁, hu₁⟩ ⟨u₂, hu₂⟩
        exact ⟨u₁ + u₂, by rw [map_add, hu₁, hu₂, map_add]⟩

    · 
      intro B₂ hq_pow_ker
      rw [injective_iff_map_eq_zero]
      intro u hu
      let t : TensorProduct ℤ ℚ ↥sys₁ := equiv₁.symm u
      have hu_eq : u = equiv₁ t := (equiv₁.apply_symm_apply u).symm
      have hQt : Q_rat t = 0 := equiv₂.injective (hu.trans (map_zero equiv₂).symm)
      let S_nz := nonZeroDivisors ℤ
      let g₁ := TensorProduct.mk ℤ ℚ ↥sys₁ (1 : ℚ)
      let g₂ := TensorProduct.mk ℤ ℚ ↥sys₂ (1 : ℚ)
      obtain ⟨⟨x, s⟩, hst⟩ := IsLocalizedModule.surj S_nz g₁ t
      have hs_ne : (s : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hst' : (s : ℤ) • t = TensorProduct.tmul ℤ (1 : ℚ) x := hst
      have hg₂_zero : g₂ (q_sys x) = g₂ 0 := by
        rw [map_zero]
        change TensorProduct.tmul ℤ (1 : ℚ) (q_sys x) = 0
        calc TensorProduct.tmul ℤ (1 : ℚ) (q_sys x)
            = Q_rat (TensorProduct.tmul ℤ (1 : ℚ) x) :=
              (LinearMap.lTensor_tmul ℚ q_sys.toIntLinearMap (1 : ℚ) x).symm
          _ = Q_rat ((s : ℤ) • t) := by rw [hst']
          _ = (s : ℤ) • Q_rat t := map_zsmul Q_rat (s : ℤ) t
          _ = 0 := by rw [hQt, smul_zero]
      obtain ⟨s', hs'⟩ := IsLocalizedModule.exists_of_eq (S := S_nz) (f := g₂) hg₂_zero
      have hs'_ne : (s' : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s'.2
      have hq_s'x : q_sys ((s' : ℤ) • x) = 0 := by
        rw [map_zsmul]
        have hs'0 : (s' : ℤ) • q_sys x = (s' : ℤ) • (0 : ↥sys₂) := hs'
        rwa [smul_zero] at hs'0
      have hpow_s'x : (ℓ ^ B₂) • ((s' : ℤ) • x) = 0 := by
        apply Subtype.ext
        ext r
        change (ℓ ^ B₂) • (((s' : ℤ) • x).1 r) = 0
        apply hq_pow_ker r
        have hcoord : (q_sys ((s' : ℤ) • x)).1 r = 0 := by
          rw [hq_s'x]
          rfl
        exact hcoord
      let m_int : ℤ := ((ℓ ^ B₂ : ℕ) : ℤ) * (s' : ℤ)
      have hℓ_pow_ne_Z : ((ℓ ^ B₂ : ℕ) : ℤ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (pow_ne_zero B₂ hPrime.ne_zero)
      have hm_ne : m_int ≠ 0 := mul_ne_zero hℓ_pow_ne_Z hs'_ne
      let d_int : ℤ := m_int * (s : ℤ)
      have hd_ne : d_int ≠ 0 := mul_ne_zero hm_ne hs_ne
      have hd_ne_K : (d_int : Padic ℓ) ≠ 0 := Int.cast_ne_zero.mpr hd_ne
      have hmx_zero : m_int • x = 0 := by
        rw [show m_int = ((ℓ ^ B₂ : ℕ) : ℤ) * (s' : ℤ) from rfl, mul_smul, natCast_zsmul]
        exact hpow_s'x
      have hdt_zero : d_int • t = 0 := by
        dsimp [d_int]
        rw [mul_smul, hst', ← TensorProduct.tmul_smul, hmx_zero, TensorProduct.tmul_zero]
      have hdu_zero : (d_int : Padic ℓ) • u = 0 := by
        rw [Int.cast_smul_eq_zsmul, hu_eq, ← map_zsmul, hdt_zero, map_zero]
      calc u = ((d_int : Padic ℓ)⁻¹ * (d_int : Padic ℓ)) • u := by
            rw [inv_mul_cancel₀ hd_ne_K, one_smul]
        _ = (d_int : Padic ℓ)⁻¹ • ((d_int : Padic ℓ) • u) := mul_smul _ _ _
        _ = 0 := by rw [hdu_zero, smul_zero]

  
  have hRoofCharpoly :
      ∀ (K L : Type) [Field K] [CommRing L] [IsDomain L] [Algebra K L]
        (V_mid V_push V_target : Type u)
        [AddCommGroup V_mid] [Module K V_mid] [Module.Finite K V_mid]
        [AddCommGroup V_push] [Module K V_push] [Module.Finite K V_push]
        [AddCommGroup V_target] [Module K V_target] [Module.Finite K V_target]
        (f_mid : V_mid →ₗ[K] V_mid)
        (f_push : V_push →ₗ[K] V_push)
        (f_target : V_target →ₗ[K] V_target)
        (π_surj : V_mid →ₗ[K] V_push)
        (ι_inj : V_mid →ₗ[K] V_target),
        Function.Surjective π_surj →
        (∀ v : V_mid, π_surj (f_mid v) = f_push (π_surj v)) →
        Function.Injective ι_inj →
        (∀ v : V_mid, ι_inj (f_mid v) = f_target (ι_inj v)) →
        ∀ (γ₀ : L), γ₀ ∈ (f_push.charpoly).aroots L → γ₀ ∈ (f_target.charpoly).aroots L := by
    clear hH1Exact hPadicTowerMap hFin_Emid hTor_ℰ hSeq₁ hSeq₂ hSub_outer hγ'_push
      E_mid E_push W_mid α₁ β₁ α₂ β₂ τ_ℰ_D τ_𝒱_D τ_ℒ_D ℛ_D ℰ_D 𝒱_D 𝒬_D ℒ_D C₁ C₂ γ' Y₀
    intro K L _ _ _ _ V_mid V_push V_target _ _ _ _ _ _ _ _ _
      f_mid f_push f_target π_surj ι_inj hπ_surj hπ_comm hι_inj hι_comm γ₀ hγ₀
    have hSubQuot : ∀ (W : Type u) [AddCommGroup W] [Module K W] [Module.Finite K W]
        (Φ : W →ₗ[K] W) (U : Submodule K W)
        (hU_inv : ∀ x ∈ U, Φ x ∈ U),
        let hU_comap : U ≤ Submodule.comap Φ U := hU_inv
        Φ.charpoly =
          (Φ.restrict hU_inv).charpoly * (Submodule.mapQ U U Φ hU_comap).charpoly := by
      intro W _ _ _ Φ U hU_inv hU_comap
      obtain ⟨C, hCompl⟩ := Submodule.exists_isCompl U
      let e : (↥U × ↥C) ≃ₗ[K] W := Submodule.prodEquivOfIsCompl U C hCompl
      let q_C : (W ⧸ U) ≃ₗ[K] ↥C := Submodule.quotientEquivOfIsCompl U C hCompl
      let b₁ := Module.finBasis K ↥U
      let b₂ := Module.finBasis K ↥C
      let b := b₁.prod b₂
      let Ψ : (↥U × ↥C) →ₗ[K] (↥U × ↥C) := e.symm.conj Φ
      let Φ_U : ↥U →ₗ[K] ↥U := Φ.restrict hU_inv
      let Φ_Q : (W ⧸ U) →ₗ[K] (W ⧸ U) := Submodule.mapQ U U Φ hU_comap
      let Φ_C : ↥C →ₗ[K] ↥C := q_C.conj Φ_Q
      let A₁₁ := LinearMap.toMatrix b₁ b₁ Φ_U
      let A₂₂ := LinearMap.toMatrix b₂ b₂ Φ_C
      let M := LinearMap.toMatrix b b Ψ
      let A₁₂ : Matrix (Fin (Module.finrank K ↥U)) (Fin (Module.finrank K ↥C)) K :=
        fun i₁ j₂ => M (Sum.inl i₁) (Sum.inr j₂)
      have hΨ_inl : ∀ u : ↥U, Ψ (u, 0) = (Φ_U u, 0) := by
        intro u
        change e.symm (Φ (e (u, 0))) = (Φ_U u, 0)
        rw [Submodule.coe_prodEquivOfIsCompl', ZeroMemClass.coe_zero, add_zero]
        have hΦu : Φ u.1 = (Φ_U u).1 := rfl
        rw [hΦu]
        exact Submodule.prodEquivOfIsCompl_symm_apply_left U C hCompl (Φ_U u)
      have hΨ_inr_snd : ∀ c : ↥C, (Ψ (0, c)).2 = Φ_C c := by
        intro c
        set p := Ψ (0, c)
        have hp : e p = Φ c.1 := by
          change e (e.symm (Φ (e (0, c)))) = Φ c.1
          rw [LinearEquiv.apply_symm_apply,
            Submodule.coe_prodEquivOfIsCompl', ZeroMemClass.coe_zero, zero_add]
        have hmk : Submodule.Quotient.mk (p := U) (Φ c.1) =
            Submodule.Quotient.mk (p := U) p.2.1 := by
          rw [← hp, Submodule.coe_prodEquivOfIsCompl', Submodule.Quotient.mk_add,
            (Submodule.Quotient.mk_eq_zero U).mpr p.1.2, zero_add]
        have hq_c : q_C.symm c = Submodule.Quotient.mk (p := U) c.1 := by
          apply q_C.injective
          rw [LinearEquiv.apply_symm_apply,
            Submodule.quotientEquivOfIsCompl_apply_mk_right hCompl c]
        change p.2 = q_C (Φ_Q (q_C.symm c))
        rw [hq_c, Submodule.mapQ_apply, hmk,
          Submodule.quotientEquivOfIsCompl_apply_mk_right hCompl p.2]
      have hM_blocks : M = Matrix.fromBlocks A₁₁ A₁₂ 0 A₂₂ := by
        ext i j
        cases i with
        | inl i₁ =>
          cases j with
          | inl j₁ =>
            dsimp [M, A₁₁]
            rw [LinearMap.toMatrix_apply, LinearMap.toMatrix_apply,
              Module.Basis.prod_apply, Sum.elim_inl, Function.comp_apply, LinearMap.inl_apply,
              hΨ_inl (b₁ j₁), Module.Basis.prod_repr_inl]
          | inr j₂ =>
            rfl
        | inr i₂ =>
          cases j with
          | inl j₁ =>
            dsimp [M]
            rw [LinearMap.toMatrix_apply, Module.Basis.prod_apply, Sum.elim_inl,
              Function.comp_apply, LinearMap.inl_apply, hΨ_inl (b₁ j₁),
              Module.Basis.prod_repr_inr, map_zero, Finsupp.zero_apply]
          | inr j₂ =>
            dsimp [M, A₂₂]
            rw [LinearMap.toMatrix_apply, LinearMap.toMatrix_apply,
              Module.Basis.prod_apply, Sum.elim_inr, Function.comp_apply, LinearMap.inr_apply,
              Module.Basis.prod_repr_inr, hΨ_inr_snd (b₂ j₂)]
      have hchar_Ψ : Ψ.charpoly = Φ.charpoly := LinearEquiv.charpoly_conj e.symm Φ
      have hchar_C : Φ_C.charpoly = Φ_Q.charpoly := LinearEquiv.charpoly_conj q_C Φ_Q
      rw [← hchar_Ψ, ← LinearMap.charpoly_toMatrix Φ_U b₁, ← hchar_C,
        ← LinearMap.charpoly_toMatrix Φ_C b₂, ← LinearMap.charpoly_toMatrix Ψ b]
      change M.charpoly = A₁₁.charpoly * A₂₂.charpoly
      rw [hM_blocks, Matrix.charpoly_fromBlocks_zero₂₁]

    let U := LinearMap.ker π_surj
    have hU_inv : ∀ x ∈ U, f_mid x ∈ U := by
      intro x hx
      rw [LinearMap.mem_ker] at hx ⊢
      rw [hπ_comm x, hx, map_zero]
    let e_Q : (V_mid ⧸ U) ≃ₗ[K] V_push := π_surj.quotKerEquivOfSurjective hπ_surj
    have he_Q_conj : e_Q.conj (Submodule.mapQ U U f_mid hU_inv) = f_push := by
      apply LinearMap.ext
      intro w
      obtain ⟨v, rfl⟩ := hπ_surj w
      have hsymm : e_Q.symm (π_surj v) = Submodule.Quotient.mk v := by
        apply e_Q.injective
        rw [LinearEquiv.apply_symm_apply]
        rfl
      change e_Q (Submodule.mapQ U U f_mid hU_inv (e_Q.symm (π_surj v))) = f_push (π_surj v)
      rw [hsymm, Submodule.mapQ_apply]
      exact hπ_comm v
    have hdvd₁ : f_push.charpoly ∣ f_mid.charpoly := by
      refine ⟨(f_mid.restrict hU_inv).charpoly, ?_⟩
      rw [hSubQuot V_mid f_mid U hU_inv, mul_comm, ← LinearEquiv.charpoly_conj e_Q, he_Q_conj]

    let R := LinearMap.range ι_inj
    have hR_inv : ∀ y ∈ R, f_target y ∈ R := by
      rintro y ⟨v, rfl⟩
      exact ⟨f_mid v, hι_comm v⟩
    let e_R : V_mid ≃ₗ[K] ↥R := LinearEquiv.ofInjective ι_inj hι_inj
    have he_R_conj : e_R.conj f_mid = f_target.restrict hR_inv := by
      apply LinearMap.ext
      intro y
      apply Subtype.ext
      let v : V_mid := e_R.symm y
      have hv : ι_inj v = y.1 := by
        change (e_R v).1 = y.1
        rw [LinearEquiv.apply_symm_apply]
      change (e_R (f_mid v)).1 = f_target y.1
      change ι_inj (f_mid v) = f_target y.1
      rw [hι_comm v, hv]
    have hdvd₂ : f_mid.charpoly ∣ f_target.charpoly := by
      refine ⟨(Submodule.mapQ R R f_target hR_inv).charpoly, ?_⟩
      rw [hSubQuot V_target f_target R hR_inv, ← he_R_conj, LinearEquiv.charpoly_conj]

    obtain ⟨P, hP⟩ := dvd_trans hdvd₁ hdvd₂
    have hmonic : f_target.charpoly.Monic := LinearMap.charpoly_monic f_target
    have hne_tgt : Polynomial.map (algebraMap K L) f_target.charpoly ≠ 0 :=
      Polynomial.map_ne_zero hmonic.ne_zero
    rw [Polynomial.aroots_def, Polynomial.mem_roots hne_tgt]
    rw [Polynomial.aroots_def] at hγ₀
    have hne_push : Polynomial.map (algebraMap K L) f_push.charpoly ≠ 0 := by
      intro h0
      apply hne_tgt
      rw [hP, Polynomial.map_mul, h0, zero_mul]
    rw [Polynomial.mem_roots hne_push] at hγ₀
    rw [hP, Polynomial.map_mul, Polynomial.IsRoot.def, Polynomial.eval_mul,
      hγ₀.eq_zero, zero_mul]

  
  have hSheafGaugeBridge :
      ∀ (X₀ S₀ : AlgebraicGeometry.Scheme.{u})
        (L₀ : CategoryTheory.Functor
          (CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
          (CategoryTheory.Sheaf S₀.smallEtaleTopology AddCommGrpCat.{u}))
