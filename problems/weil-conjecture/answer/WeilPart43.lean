        exact hx.map j_F
      rw [← hσ_comm x, hτ_int (j_B r x) hx_V]
    · ext k₁ k₂
      rw [congrArg Units.val hσ_ρ, (hρ_mid_spec r).1 τ k₁ k₂, hg_mid]
      dsimp only
      have hAdap_eq :
          ((P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1)) * (ρ_V r τ).val *
            (P_chg.val.map (PadicInt.toZModPow (r + 1)))) =
          ((P_chg⁻¹).val * g_V.val * P_chg.val).map (PadicInt.toZModPow (r + 1)) := by
        rw [hτ_mat, ← RingHom.mapMatrix_apply, ← RingHom.mapMatrix_apply,
