            have hS₂_mem : S₂ ∈ Y.smallEtaleTopology U₂ := hYCoverMem U₂ W₀ f₂ hW₀_top
            let S₁ := S₂.pullback u
            have hS₁_mem : S₁ ∈ Y.smallEtaleTopology U₁ :=
