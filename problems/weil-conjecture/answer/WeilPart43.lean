          (((C_S.obj A₁).obj.map (Opposite.op (j_a a))).hom (θ_of A₁ Y g)) =
          ((C_S.obj A₂).obj.map (Opposite.op (j_a a))).hom (θ_of A₂ Y (g.map φ.hom)) := by
        have hl : ((C_S.map φ).hom.app (Opposite.op (Y_a a))).hom
            (((C_S.obj A₁).obj.map (Opposite.op (j_a a))).hom (θ_of A₁ Y g)) =
            ((C_S.map φ).hom.app (Opposite.op (Y_a a))).hom
              (((C_S.obj A₁).obj.map (Opposite.op q_a)).hom
                (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).unit.app A₁).hom a)) :=
          congrArg (((C_S.map φ).hom.app (Opposite.op (Y_a a))).hom)
            (((hθ_spec A₁).2.1 (j_a a) g).trans ((congrArg (θ_of A₁ (Y_a a)) hg_ja).trans hconst_A₁))
        have hr : ((C_S.obj A₂).obj.map (Opposite.op (j_a a))).hom (θ_of A₂ Y (g.map φ.hom)) =
            ((C_S.obj A₂).obj.map (Opposite.op q_a)).hom
              (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).unit.app A₂).hom (φ.hom a)) :=
          ((hθ_spec A₂).2.1 (j_a a) (g.map φ.hom)).trans
            ((congrArg (θ_of A₂ (Y_a a)) hg_map_ja).trans hconst_A₂)
        have hq_nat := congrArg (fun k => k.hom
          (((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).unit.app A₁).hom a))
          ((C_S.map φ).hom.naturality (Opposite.op q_a))
        exact hl.trans (hq_nat.trans
          ((congrArg (((C_S.obj A₂).obj.map (Opposite.op q_a)).hom) hunit_nat).trans hr.symm))
      have hlhs : ((C_S.obj A₂).obj.map (Opposite.op (u₀ ≫ j_a a))).hom
          (((C_S.map φ).hom.app (Opposite.op Y)).hom (θ_of A₁ Y g)) =
          ((C_S.obj A₂).obj.map (Opposite.op u₀)).hom
            (((C_S.map φ).hom.app (Opposite.op (Y_a a))).hom
              (((C_S.obj A₁).obj.map (Opposite.op (j_a a))).hom (θ_of A₁ Y g))) := by
        have hc := congrArg (fun k => k.hom (((C_S.map φ).hom.app (Opposite.op Y)).hom (θ_of A₁ Y g)))
