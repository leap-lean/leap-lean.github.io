    | succ s ih =>
      let A₁ := AddCommGrpCat.of (ZMod (ℓ ^ (s + 1)))
      let A₂ := AddCommGrpCat.of (ZMod (ℓ ^ (s + 2)))
      let A₃ := AddCommGrpCat.of (ZMod ℓ)
      have _ : NeZero (ℓ ^ (s + 1)) := ⟨pow_ne_zero _ hPrime.ne_zero⟩
      let f_hom : ZMod (ℓ ^ (s + 1)) →+ ZMod (ℓ ^ (s + 2)) :=
        { toFun := fun x => ((x.val * ℓ : ℕ) : ZMod (ℓ ^ (s + 2)))
          map_zero' := by simp
          map_add' := fun x y => by
            have hdiv := Nat.div_add_mod (x.val + y.val) (ℓ ^ (s + 1))
            have hmul : (x + y).val * ℓ + ℓ ^ (s + 2) * ((x.val + y.val) / ℓ ^ (s + 1)) =
                x.val * ℓ + y.val * ℓ := by
              rw [ZMod.val_add]
              calc ((x.val + y.val) % ℓ ^ (s + 1)) * ℓ +
                    ℓ ^ (s + 2) * ((x.val + y.val) / ℓ ^ (s + 1))
                  = (ℓ ^ (s + 1) * ((x.val + y.val) / ℓ ^ (s + 1)) +
                      (x.val + y.val) % ℓ ^ (s + 1)) * ℓ := by ring
                _ = (x.val + y.val) * ℓ := by rw [hdiv]
                _ = x.val * ℓ + y.val * ℓ := add_mul _ _ _
            have hcast := congrArg (Nat.cast (R := ZMod (ℓ ^ (s + 2)))) hmul
            simpa only [Nat.cast_add, Nat.cast_mul, ZMod.natCast_self, zero_mul, add_zero]
              using hcast }
      have hf_val : ∀ x : ZMod (ℓ ^ (s + 1)),
          f_hom x = ((x.val * ℓ : ℕ) : ZMod (ℓ ^ (s + 2))) := fun _ => rfl
      let f : A₁ ⟶ A₂ := AddCommGrpCat.ofHom f_hom
      let g_ring : ZMod (ℓ ^ (s + 2)) →+* ZMod ℓ :=
        ZMod.castHom (dvd_pow_self ℓ (by omega : s + 2 ≠ 0)) (ZMod ℓ)
      let g : A₂ ⟶ A₃ := AddCommGrpCat.ofHom g_ring.toAddMonoidHom
      have hg_val : ∀ y : ZMod (ℓ ^ (s + 2)), g.hom y = (y.val : ZMod ℓ) := by
        intro y
        change (ZMod.castHom (dvd_pow_self ℓ (by omega : s + 2 ≠ 0)) (ZMod ℓ)) y = (y.val : ZMod ℓ)
        rw [ZMod.castHom_apply, ZMod.cast_eq_val]
      have h0 : f ≫ g = 0 := by
        ext x
        change g.hom (f_hom x) = 0
        rw [hf_val x]
        change g_ring ((x.val * ℓ : ℕ) : ZMod (ℓ ^ (s + 2))) = 0
        rw [map_natCast, Nat.cast_mul, ZMod.natCast_self, mul_zero]
      refine hSE_step f g h0 ?_ ?_ ?_ ih hH1_mod_ℓ
      · intro x₁ x₂ h_eq
        have h_sub : f_hom (x₁ - x₂) = 0 := by
          rw [map_sub, sub_eq_zero]
          exact h_eq
        let d := x₁ - x₂
        have hd0 : ((d.val * ℓ : ℕ) : ZMod (ℓ ^ (s + 2))) = 0 := by
          rw [← hf_val d]
          exact h_sub
        rw [ZMod.natCast_eq_zero_iff] at hd0
        have hdvd : ℓ ^ (s + 1) ∣ d.val := by
          rw [pow_succ] at hd0
          exact (Nat.mul_dvd_mul_iff_right hℓ_pos).mp hd0
        have hd_val : d.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt d)
        have hd_eq : d = 0 := by
          rw [← ZMod.natCast_zmod_val d, hd_val, Nat.cast_zero]
        exact sub_eq_zero.mp hd_eq
      · change Function.Surjective g_ring
        exact ZMod.castHom_surjective _
      · intro y hy
        rw [hg_val y, ZMod.natCast_eq_zero_iff] at hy
        rcases hy with ⟨q, hq⟩
        have _ : NeZero (ℓ ^ (s + 2)) := ⟨pow_ne_zero _ hPrime.ne_zero⟩
        have hy_lt : y.val < ℓ ^ (s + 2) := ZMod.val_lt y
        have hq_lt : q < ℓ ^ (s + 1) := by
          have : ℓ * q < ℓ * ℓ ^ (s + 1) := by
            calc ℓ * q = y.val := hq.symm
              _ < ℓ ^ (s + 2) := hy_lt
              _ = ℓ * ℓ ^ (s + 1) := by ring
          exact lt_of_mul_lt_mul_left' this
        let x : ZMod (ℓ ^ (s + 1)) := (q : ZMod (ℓ ^ (s + 1)))
        refine ⟨x, ?_⟩
        change f_hom x = y
        have hx_val : x.val = q := ZMod.val_natCast_of_lt hq_lt
        rw [hf_val x, hx_val, mul_comm q ℓ, ← hq, ZMod.natCast_zmod_val]
  have hSub_const : Subsingleton ((C_S.obj A_K).H 1) := by
    have hVec : ∀ n : ℕ,
        Subsingleton ((E_S.obj (AddCommGrpCat.of (Fin n → Λ))).H 1) := by
      intro n
      induction n with
      | zero =>
        let A₀ := AddCommGrpCat.of (Fin 0 → Λ)
        have hZeroA₀ : CategoryTheory.Limits.IsZero A₀ := by
          rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
          apply AddCommGrpCat.ext
          intro v
          funext i
          exact Fin.elim0 i
        have hZeroES : CategoryTheory.Limits.IsZero (E_S.obj A₀) := E_S.map_isZero hZeroA₀
        refine Subsingleton.intro fun a b => ?_
        have hZeroExt : ∀ x : (E_S.obj A₀).H 1, x = 0 := by
          intro x
          let x' : CategoryTheory.Abelian.Ext Fℤ (E_S.obj A₀) 1 := x
          change x' = 0
          rw [← CategoryTheory.Abelian.Ext.comp_mk₀_id x',
            hZeroES.eq_of_tgt (𝟙 (E_S.obj A₀)) 0,
            CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero]
        exact (hZeroExt a).trans (hZeroExt b).symm
      | succ n ih =>
        let A₁ := AddCommGrpCat.of Λ
        let A₂ := AddCommGrpCat.of (Fin (n + 1) → Λ)
        let A₃ := AddCommGrpCat.of (Fin n → Λ)
        let cons_hom : Λ →+ (Fin (n + 1) → Λ) :=
          { toFun := fun a => Fin.cons a 0
            map_zero' := by
              ext j
              refine Fin.cases ?_ (fun _ => rfl) j
              rfl
            map_add' := fun a b => by
              ext j
              refine Fin.cases ?_ (fun i => ?_) j
              · rfl
              · simp }
        let tail_hom : (Fin (n + 1) → Λ) →+ (Fin n → Λ) :=
          { toFun := fun v i => v i.succ
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        let f : A₁ ⟶ A₂ := AddCommGrpCat.ofHom cons_hom
        let g : A₂ ⟶ A₃ := AddCommGrpCat.ofHom tail_hom
        have h0 : f ≫ g = 0 := by
          ext a i
          rfl
        refine hSE_step f g h0 ?_ ?_ ?_ (hZModPow r) ih
        · intro a₁ a₂ h_eq
          exact congrFun h_eq 0
        · intro w
          refine ⟨Fin.cons 0 w, ?_⟩
          ext i
          rfl
        · intro v hv
          refine ⟨v 0, ?_⟩
          ext j
          refine Fin.cases rfl (fun i => ?_) j
          exact (congrFun hv i).symm
    exact hVec K

  
  let L_pr := @CategoryTheory.Functor.sheafPullback _ _ _ _
    (weilEtaleSitePullback pr_D) AddCommGrpCat.{u} _
    D₀.left.smallEtaleTopology S.smallEtaleTopology hCont_pr hAdj_pr
  let M_lhs := L_pr.obj (weilEtaleHigherDirectImage U₀.ι 0 𝒢₀)
  have hZeroLhs : ∀ x : M_lhs.H 1, x = 0 := by
    intro x
    let x' : CategoryTheory.Abelian.Ext Fℤ M_lhs 1 := x
    change x' = 0
    let y' : CategoryTheory.Abelian.Ext Fℤ (C_S.obj A_K) 1 :=
      x'.comp (CategoryTheory.Abelian.Ext.mk₀ iso_final.hom) (Nat.add_zero 1)
    have hy' : y' = 0 := @Subsingleton.elim ((C_S.obj A_K).H 1) hSub_const y' 0
    calc x'
        = x'.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 M_lhs)) (Nat.add_zero 1) :=
          (CategoryTheory.Abelian.Ext.comp_mk₀_id x').symm
      _ = x'.comp (CategoryTheory.Abelian.Ext.mk₀ (iso_final.hom ≫ iso_final.inv))
            (Nat.add_zero 1) := by
          rw [iso_final.hom_inv_id]
      _ = x'.comp ((CategoryTheory.Abelian.Ext.mk₀ iso_final.hom).comp
            (CategoryTheory.Abelian.Ext.mk₀ iso_final.inv) (Nat.add_zero 0))
            (Nat.add_zero 1) := by
          rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      _ = (x'.comp (CategoryTheory.Abelian.Ext.mk₀ iso_final.hom) (Nat.add_zero 1)).comp
            (CategoryTheory.Abelian.Ext.mk₀ iso_final.inv) (Nat.add_zero 1) :=
          (CategoryTheory.Abelian.Ext.comp_assoc _ _ _
            (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1)).symm
      _ = y'.comp (CategoryTheory.Abelian.Ext.mk₀ iso_final.inv) (Nat.add_zero 1) := rfl
      _ = 0 := by rw [hy', CategoryTheory.Abelian.Ext.zero_comp]
  exact Subsingleton.intro fun a b => (hZeroLhs a).trans (hZeroLhs b).symm

theorem weil_mid_dev_padic_orbit_uniform_transvection_lifts (ℓ N M₀ M M₂ : ℕ) [Fact (Nat.Prime ℓ)] (hM : 1 ≤ M) (hSum : M₀ + M + M₂ = N)
    (J_V : Matrix (Fin N) (Fin N) (Padic ℓ)) (hJV_skew : J_V.transpose = -J_V)
    (G_V : Subgroup ((Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ))
    (hGV_sp : ∀ g ∈ G_V,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).transpose * J_V *
        ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))) = J_V)
    (E_van E_perp E_rad : Submodule (Padic ℓ) (Fin N → Padic ℓ))
    (hE_perp : ∀ x : Fin N → Padic ℓ,
      x ∈ E_perp ↔ ∀ y ∈ E_van, dotProduct x (J_V.mulVec y) = 0)
    (hE_rad : E_rad = E_van ⊓ E_perp)
    (hGV_van : ∀ g ∈ G_V, ∀ x : Fin N → Padic ℓ,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x - x ∈ E_van)
    (hGV_perp : ∀ g ∈ G_V, ∀ x ∈ E_perp,
      ((g.val).map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x = x)
    (w_inf : Fin N → Padic ℓ)
    (hw_inf_van : w_inf ∈ E_van) (hw_inf_ni : w_inf ∉ E_perp)
    (P_chg : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ)
    (hBasis : ∀ x : Fin N → Padic ℓ,
      (x ∈ E_rad ↔ ∀ i : Fin N, M₀ ≤ i.1 →
        (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0) ∧
      (x ∈ E_van ↔ ∀ i : Fin N, M₀ + M ≤ i.1 →
        (((P_chg⁻¹).val.map (algebraMap (PadicInt ℓ) (Padic ℓ))).mulVec x) i = 0)) :
    ∃ C₁ C₂ : ℕ, ∀ (r : ℕ) (g_Q : (Matrix (Fin N) (Fin N) (PadicInt ℓ))ˣ), g_Q ∈ G_V →
      let ι := algebraMap (PadicInt ℓ) (Padic ℓ)
      let v_Q := ((g_Q.val).map ι).mulVec w_inf
      let P_r := P_chg.val.map (PadicInt.toZModPow (r + 1))
      let P_inv_r := (P_chg⁻¹).val.map (PadicInt.toZModPow (r + 1))
      (∀ q_mod : Fin M₂ → ZMod (ℓ ^ (r + 1)),
        ∃ x_hat : Fin N → ZMod (ℓ ^ (r + 1)),
          (∀ k : Fin M₂,
            (P_inv_r.mulVec x_hat) ⟨M₀ + M + k.1, by omega⟩ = (ℓ ^ C₁) • q_mod k) ∧
          ∀ u ∈ G_V, ∀ c : Padic ℓ,
            (∀ x : Fin N → Padic ℓ,
              ((u.val).map ι).mulVec x = x + (c * dotProduct x (J_V.mulVec v_Q)) • v_Q) →
            ((u.val).map (PadicInt.toZModPow (r + 1))).mulVec x_hat = x_hat) ∧
      (∀ v_mod : Fin M → ZMod (ℓ ^ (r + 1)),
        ∃ e_hat : Fin (M₀ + M) → ZMod (ℓ ^ (r + 1)),
          (∀ i : Fin (M₀ + M), i.1 < M₀ → e_hat i = 0) ∧
          (∀ k : Fin M, e_hat ⟨M₀ + k.1, by omega⟩ = (ℓ ^ C₂) • v_mod k) ∧
          ∀ u ∈ G_V, ∀ c : Padic ℓ,
            (∀ x : Fin N → Padic ℓ,
