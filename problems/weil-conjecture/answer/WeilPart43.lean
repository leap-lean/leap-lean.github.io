      (τ₂ : ∀ r : ℕ, H₂ (r + 1) →+ H₂ r)
      (f₁ : ∀ r : ℕ, H₁ r →+ H₁ r)
      (f₂ : ∀ r : ℕ, H₂ r →+ H₂ r)
      (ψ : ∀ r : ℕ, H₁ r →+ H₂ r)
      (sys₁ : AddSubgroup (∀ r : ℕ, H₁ r))
      (sys₂ : AddSubgroup (∀ r : ℕ, H₂ r))
      (V₁ V₂ : Type u)
      [AddCommGroup V₁] [Module (Padic ℓ) V₁] [Module.Finite (Padic ℓ) V₁]
      [AddCommGroup V₂] [Module (Padic ℓ) V₂] [Module.Finite (Padic ℓ) V₂]
      (frob₁ : V₁ →ₗ[Padic ℓ] V₁)
      (frob₂ : V₂ →ₗ[Padic ℓ] V₂)
      (equiv₁ : TensorProduct ℤ ℚ ↥sys₁ ≃+ V₁)
      (equiv₂ : TensorProduct ℤ ℚ ↥sys₂ ≃+ V₂),
      (∀ (r : ℕ) (w : H₁ r), (ℓ ^ (r + 1)) • w = 0) →
      (∀ (r : ℕ) (w : H₂ r), (ℓ ^ (r + 1)) • w = 0) →
