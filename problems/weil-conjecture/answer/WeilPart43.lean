      commutes' := fun z => hj_B_inj (r + 1) (by
        rw [hι_spec, AlgHom.commutes, AlgHom.commutes, AlgHom.commutes]) }
  have hι_B_spec : ∀ (r : ℕ) (b : B r), j_B (r + 1) (ι_B r b) = ι_BV r (j_B r b) :=
    fun r b => Classical.choose_spec (hι_B_ex r b)

  
  refine ⟨B, L_fld,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    inferInstance, inferInstance, inferInstance,
    hFin_Br, hEt_Br, hFrac_Br, hIntCl_Br, hFD_Lr, hGal_Lr,
    ρ, ι_B, j_B, ι_L,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · 
    exact fun r => (hρ_spec r).1
  · 
    intro r g hg
    obtain ⟨g_V, hg_V, hg_mid⟩ := hGV_blk.2 g hg
    obtain ⟨τ, hτ_int, hτ_mat⟩ := hG_surj r g_V hg_V
    obtain ⟨σ, hσ_comm, hσ_ρ⟩ := (hρ_spec r).2.2.1 τ
