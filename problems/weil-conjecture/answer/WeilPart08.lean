              (e_prod.symm e₁ * e_prod.symm e₂) *
                (algebraMap B (Localization M₀) m₁.1 * algebraMap B (Localization M₀) m₂.1) := by ring
          _ = 0 := by rw [← map_mul, he12, map_zero, zero_mul]
