      · rw [Algebra.TensorProduct.tmul_mul_tmul, mul_inv_cancel₀ hk0, mul_one]; rfl
      · rw [Algebra.TensorProduct.tmul_mul_tmul, inv_mul_cancel₀ hk0, mul_one]; rfl
    let f_bwd : B_K →+* TensorProduct R K_R D :=
