          rw [← h_unit]; exact Ideal.mul_mem_left _ d hm_in_q'
        exact False.elim (q'₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1_in_q' isUnit_one))
    let e_RD : R ≃+* D := RingEquiv.ofBijective (algebraMap R D) ⟨hInjRD, hSurjRD⟩
    let σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_RD.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B D)) ≫ ι_V
    refine ⟨σ, ?_, ?_⟩
    · dsimp [σ]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hSpec_φRB, ← hφ_eq,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq R B D,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h_id : (↑e_RD.symm : D →+* R).comp (algebraMap R D) = RingHom.id R := by
        ext r; exact e_RD.symm_apply_apply r
      rw [h_id]; exact AlgebraicGeometry.Spec.map_id (CommRingCat.of R)
    · intro b hb
      have hb_q' : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_RD.symm.toRingHom)).base b = q'₀ := by
        apply PrimeSpectrum.ext; ext x
        change e_RD.symm x ∈ b.asIdeal ↔ x ∈ q'₀.asIdeal
        rw [hb, ← hq'₀_R, Ideal.mem_comap]
        have hx : algebraMap R D (e_RD.symm x) = x := e_RD.apply_symm_apply x
        rw [hx]
      have h_app : σ.base b =
          ι_V.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B D))).base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_RD.symm.toRingHom)).base b)) := by
        simp [σ]
      rw [h_app, hb_q']
      have h_comap : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B D))).base q'₀ = q₀ :=
        hq'₀_eq
      rw [h_comap, hq₀_eq]
  
  have hClause1 :
      ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
        ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g) := by
    intro A₀ B _ _ _ _ _ _ q
    let p : Ideal A₀ := q.asIdeal.under A₀
    let A₁ : Type u := Localization.AtPrime p
    let B_q : Type u := Localization.AtPrime q.asIdeal
    let _ : q.asIdeal.LiesOver p := ⟨rfl⟩
    let _ : Algebra A₁ B_q := Localization.AtPrime.algebraOfLiesOver p q.asIdeal
