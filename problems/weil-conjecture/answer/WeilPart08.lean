      j_open V hV ((X.presheaf.map (CategoryTheory.homOfLE hle).op).hom s) =
        j_open U hU s := by
    intro U V hU hV hle s
    have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hU
    have : Nonempty ↥(V : AlgebraicGeometry.Scheme.{u}) := hV
    change j_FF ((X.germToFunctionField V).hom
