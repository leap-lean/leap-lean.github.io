        exact sub_self c₀
      have hBot_lt : (⊥ : Ideal (Polynomial k_P)) < 𝔭_max :=
        lt_of_le_of_ne bot_le fun hEq =>
          Polynomial.X_sub_C_ne_zero c₀ (Ideal.mem_bot.mp (hEq ▸ hX_sub_mem))
      obtain ⟨Q_min, hQ_lt, hQ_prime, _⟩ :=
        Ideal.exists_ideal_lt_liesOver_of_lt (p := (⊥ : Ideal (Polynomial k_P))) Q_max hBot_lt
      obtain ⟨y_diff, hy_max, hy_not_min⟩ := SetLike.exists_of_lt hQ_lt
      obtain ⟨⟨a_diff, ⟨_, m, rfl⟩⟩, hya⟩ := IsLocalization.surj (Submonoid.powers t) y_diff
