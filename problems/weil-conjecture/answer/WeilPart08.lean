    intro R S _ _ φ_RS N
    let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let 𝒜_S := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) S
    let _ : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    let _ : GradedAlgebra 𝒜_S := MvPolynomial.gradedAlgebra
