    (∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ),
      c₁ μ j * (∏ i : Fin (k₁_num μ j), max r₀ (θ₁ μ j i)) *
        (∏ i : Fin (k₁_den μ j), max r₀ (η₁ μ j i))⁻¹ ≤ 1) ↔
    (∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ),
      c₁ μ j * (∏ i : Fin (k₁_num μ j), max r₁ (θ₁ μ j i)) *
        (∏ i : Fin (k₁_den μ j), max r₁ (η₁ μ j i))⁻¹ ≤ 1) :=
by
  let P₁ : Γ₀ → Prop := fun r => ∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ),
    c₁ μ j * (∏ i : Fin (k₁_num μ j), max r (θ₁ μ j i)) *
      (∏ i : Fin (k₁_den μ j), max r (η₁ μ j i))⁻¹ ≤ 1
  let P₂ : Γ₀ → Prop := fun r => ∃ ν : Fin (q + 1), ∀ j : Fin (m₂ ν),
    c₂ ν j * (∏ i : Fin (k₂_num ν j), max r (θ₂ ν j i)) *
      (∏ i : Fin (k₂_den ν j), max r (η₂ ν j i))⁻¹ ≤ 1
  change P₁ r₀ ↔ P₁ r₁
  have h_bisect : ∀ (R : Γ₀ → Γ₀ → Prop),
      (∀ x : Γ₀, R x x) →
      (∀ x y z : Γ₀, R x y → R y z → R x z) →
      ∀ (S : Finset Γ₀) (a b : Γ₀), a ≤ b →
      (∀ u v : Γ₀, a ≤ u → u < v → v ≤ b → (∀ x ∈ S, ¬ (u < x ∧ x < v)) → R u v) →
      R a b := by
    intro R hRefl hTrans S a b hab hStep
    have hInd : ∀ (n : ℕ) (u v : Γ₀),
        a ≤ u → u ≤ v → v ≤ b →
        (S.filter (fun y => u < y ∧ y < v)).card = n → R u v := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro u v hau huv hvb hcard
        rcases eq_or_lt_of_le huv with rfl | hlt
        · exact hRefl u
        · let F : Finset Γ₀ := S.filter (fun y => u < y ∧ y < v)
          change F.card = n at hcard
          rcases Finset.eq_empty_or_nonempty F with hF_empty | ⟨x, hxF⟩
          · apply hStep u v hau hlt hvb
            intro y hyS ⟨huy, hyv⟩
            have hyF : y ∈ F := Finset.mem_filter.mpr ⟨hyS, huy, hyv⟩
            exact Finset.eq_empty_iff_forall_notMem.mp hF_empty y hyF
          · obtain ⟨_hxS, hux, hxv⟩ := Finset.mem_filter.mp hxF
            let F₁ : Finset Γ₀ := S.filter (fun y => u < y ∧ y < x)
            let F₂ : Finset Γ₀ := S.filter (fun y => x < y ∧ y < v)
            have hsub₁ : F₁ ⊆ F := by
              intro y hy
              obtain ⟨hyS, huy, hyx⟩ := Finset.mem_filter.mp hy
              exact Finset.mem_filter.mpr ⟨hyS, huy, lt_trans hyx hxv⟩
            have hx_not₁ : x ∉ F₁ := fun hx1 => lt_irrefl x (Finset.mem_filter.mp hx1).2.2
            have hlt₁ : F₁.card < n := by
              rw [← hcard]
              exact Finset.card_lt_card ((Finset.ssubset_iff_of_subset hsub₁).mpr ⟨x, hxF, hx_not₁⟩)
            have hsub₂ : F₂ ⊆ F := by
              intro y hy
              obtain ⟨hyS, hxy, hyv⟩ := Finset.mem_filter.mp hy
              exact Finset.mem_filter.mpr ⟨hyS, lt_trans hux hxy, hyv⟩
            have hx_not₂ : x ∉ F₂ := fun hx2 => lt_irrefl x (Finset.mem_filter.mp hx2).2.1
            have hlt₂ : F₂.card < n := by
              rw [← hcard]
              exact Finset.card_lt_card ((Finset.ssubset_iff_of_subset hsub₂).mpr ⟨x, hxF, hx_not₂⟩)
            have hR₁ : R u x := ih F₁.card hlt₁ u x hau (le_of_lt hux)
              (le_trans (le_of_lt hxv) hvb) rfl
            have hR₂ : R x v := ih F₂.card hlt₂ x v (le_trans hau (le_of_lt hux))
              (le_of_lt hxv) hvb rfl
            exact hTrans u x v hR₁ hR₂
    exact hInd _ a b (le_refl a) hab (le_refl b) rfl
  have h_mid : ∀ u v : Γ₀, 0 < u → u < v → ∃ m : Γ₀, u < m ∧ m < v := by
    intro u v hu huv
    have hv : 0 < v := lt_trans hu huv
    obtain ⟨m, hm_sq⟩ := hDiv (u * v) 2 (by decide)
    refine ⟨m, ?_, ?_⟩
    · have h1 : u ^ 2 < m ^ 2 := by
        rw [sq, hm_sq]
        exact mul_lt_mul_of_pos_left huv hu
      exact (pow_lt_pow_iff_left₀ zero_le zero_le (by decide : (2 : ℕ) ≠ 0)).mp h1
    · have h2 : m ^ 2 < v ^ 2 := by
        rw [hm_sq, sq]
        exact mul_lt_mul_of_pos_right huv hv
      exact (pow_lt_pow_iff_left₀ zero_le zero_le (by decide : (2 : ℕ) ≠ 0)).mp h2
  let monomThreshold : Γ₀ → Γ₀ → ℕ → ℕ → Γ₀ := fun C_num C_den A B =>
    if hBA : B < A then
      Classical.choose (hDiv (C_den * C_num⁻¹) (A - B) (Nat.sub_pos_of_lt hBA))
    else if hAB : A < B then
      Classical.choose (hDiv (C_num * C_den⁻¹) (B - A) (Nat.sub_pos_of_lt hAB))
    else
      1
  have h_monom_transfer : ∀ (C_num C_den : Γ₀), C_num ≠ 0 → C_den ≠ 0 →
      ∀ (A B : ℕ) (u m v : Γ₀),
      0 < u → u < m → m < v →
      ¬ (u < monomThreshold C_num C_den A B ∧ monomThreshold C_num C_den A B < v) →
      C_num * m ^ A ≤ C_den * m ^ B →
      (C_num * u ^ A ≤ C_den * u ^ B) ∧ (C_num * v ^ A ≤ C_den * v ^ B) := by
    intro C_num C_den hCn hCd A B u m v hu_pos hum hmv hNo_ρ hAt_m
    have hm_pos : 0 < m := lt_trans hu_pos hum
    have hv_pos : 0 < v := lt_trans hm_pos hmv
    have hCn_pos : 0 < C_num := zero_lt_iff.mpr hCn
    have hCd_pos : 0 < C_den := zero_lt_iff.mpr hCd
    have h_pow_pos : ∀ (r : Γ₀), 0 < r → ∀ (d : ℕ), 0 < r ^ d :=
      fun r hr d => zero_lt_iff.mpr (pow_ne_zero d (zero_lt_iff.mp hr))
    by_cases hBA : B < A
    · have hρ_eq : monomThreshold C_num C_den A B =
          Classical.choose (hDiv (C_den * C_num⁻¹) (A - B) (Nat.sub_pos_of_lt hBA)) := by
        simp only [monomThreshold, hBA, ↓reduceDIte]
      let ρ := monomThreshold C_num C_den A B
      have hρ_pow : ρ ^ (A - B) = C_den * C_num⁻¹ := by
        change (monomThreshold C_num C_den A B) ^ (A - B) = C_den * C_num⁻¹
        rw [hρ_eq]
        exact Classical.choose_spec (hDiv (C_den * C_num⁻¹) (A - B) (Nat.sub_pos_of_lt hBA))
      have hAB_ne : A - B ≠ 0 := Nat.ne_of_gt (Nat.sub_pos_of_lt hBA)
      have hEquiv : ∀ r : Γ₀, 0 < r → (C_num * r ^ A ≤ C_den * r ^ B ↔ r ≤ ρ) := by
        intro r hr
        have hA_eq : A = (A - B) + B := (Nat.sub_add_cancel (le_of_lt hBA)).symm
        conv_lhs => rw [hA_eq, pow_add, ← mul_assoc C_num (r ^ (A - B)) (r ^ B)]
        rw [mul_le_mul_iff_left₀ (h_pow_pos r hr B), mul_comm C_num (r ^ (A - B)),
          ← le_mul_inv_iff₀ hCn_pos, ← hρ_pow,
          pow_le_pow_iff_left₀ zero_le zero_le hAB_ne]
      have hm_le : m ≤ ρ := (hEquiv m hm_pos).mp hAt_m
      have hu_lt_ρ : u < ρ := lt_of_lt_of_le hum hm_le
      have hv_le : v ≤ ρ := le_of_not_gt (fun hρ_lt_v => hNo_ρ ⟨hu_lt_ρ, hρ_lt_v⟩)
      have hu_le : u ≤ ρ := le_of_lt hu_lt_ρ
      exact ⟨(hEquiv u hu_pos).mpr hu_le, (hEquiv v hv_pos).mpr hv_le⟩
    · by_cases hAB : A < B
      · have hρ_eq : monomThreshold C_num C_den A B =
            Classical.choose (hDiv (C_num * C_den⁻¹) (B - A) (Nat.sub_pos_of_lt hAB)) := by
          simp only [monomThreshold, hBA, hAB, ↓reduceDIte]
        let ρ := monomThreshold C_num C_den A B
        have hρ_pow : ρ ^ (B - A) = C_num * C_den⁻¹ := by
          change (monomThreshold C_num C_den A B) ^ (B - A) = C_num * C_den⁻¹
          rw [hρ_eq]
          exact Classical.choose_spec (hDiv (C_num * C_den⁻¹) (B - A) (Nat.sub_pos_of_lt hAB))
        have hBA_ne : B - A ≠ 0 := Nat.ne_of_gt (Nat.sub_pos_of_lt hAB)
        have hEquiv : ∀ r : Γ₀, 0 < r → (C_num * r ^ A ≤ C_den * r ^ B ↔ ρ ≤ r) := by
          intro r hr
          have hB_eq : B = (B - A) + A := (Nat.sub_add_cancel (le_of_lt hAB)).symm
          conv_lhs => rw [hB_eq, pow_add, ← mul_assoc C_den (r ^ (B - A)) (r ^ A)]
          rw [mul_le_mul_iff_left₀ (h_pow_pos r hr A), mul_comm C_den (r ^ (B - A)),
            ← mul_inv_le_iff₀ hCd_pos, ← hρ_pow,
            pow_le_pow_iff_left₀ zero_le zero_le hBA_ne]
        have hρ_le_m : ρ ≤ m := (hEquiv m hm_pos).mp hAt_m
        have hρ_lt_v : ρ < v := lt_of_le_of_lt hρ_le_m hmv
        have hρ_le_u : ρ ≤ u := le_of_not_gt (fun hu_lt_ρ => hNo_ρ ⟨hu_lt_ρ, hρ_lt_v⟩)
        have hρ_le_v : ρ ≤ v := le_of_lt hρ_lt_v
        exact ⟨(hEquiv u hu_pos).mpr hρ_le_u, (hEquiv v hv_pos).mpr hρ_le_v⟩
      · have hEq : A = B := le_antisymm (le_of_not_gt hBA) (le_of_not_gt hAB)
        subst hEq
        have hC_le : C_num ≤ C_den :=
          (mul_le_mul_iff_left₀ (h_pow_pos m hm_pos A)).mp hAt_m
        exact ⟨(mul_le_mul_iff_left₀ (h_pow_pos u hu_pos A)).mpr hC_le,
          (mul_le_mul_iff_left₀ (h_pow_pos v hv_pos A)).mpr hC_le⟩
  let prodExp : ∀ (d_a : Γ₀) (k : ℕ), (Fin k → Γ₀) → ℕ :=
    fun d_a _ f => (Finset.univ.filter (fun i => f i ≤ d_a)).card
  let prodCoeff : ∀ (d_a : Γ₀) (k : ℕ), (Fin k → Γ₀) → Γ₀ :=
    fun d_a _ f => ∏ i ∈ Finset.univ.filter (fun i => ¬ f i ≤ d_a), f i
  have h_prodCoeff_ne : ∀ (d_a : Γ₀), 0 < d_a → ∀ (k : ℕ) (f : Fin k → Γ₀),
      prodCoeff d_a k f ≠ 0 := by
    intro d_a hda_pos k f
    refine Finset.prod_ne_zero_iff.mpr ?_
    intro i hi
    have hnot : ¬ f i ≤ d_a := (Finset.mem_filter.mp hi).2
    exact zero_lt_iff.mp (lt_trans hda_pos (lt_of_not_ge hnot))
  have h_prod_max_eq : ∀ (d_a d_b : Γ₀), d_a < d_b →
      ∀ (k : ℕ) (f : Fin k → Γ₀),
      (∀ i : Fin k, ¬ (d_a < f i ∧ f i < d_b)) →
      ∀ r : Γ₀, d_a ≤ r → r ≤ d_b →
      (∏ i : Fin k, max r (f i)) = prodCoeff d_a k f * r ^ prodExp d_a k f := by
    intro d_a d_b _hda_db k f hf r hd_a_r hr_d_b
    rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun i : Fin k => f i ≤ d_a)
      (fun i => max r (f i))]
    have h1 : (∏ i ∈ Finset.univ.filter (fun i : Fin k => f i ≤ d_a), max r (f i)) =
        r ^ prodExp d_a k f := by
      rw [← Finset.prod_const r]
      refine Finset.prod_congr rfl ?_
      intro i hi
      exact max_eq_left (le_trans (Finset.mem_filter.mp hi).2 hd_a_r)
    have h2 : (∏ i ∈ Finset.univ.filter (fun i : Fin k => ¬ f i ≤ d_a), max r (f i)) =
        prodCoeff d_a k f := by
      refine Finset.prod_congr rfl ?_
      intro i hi
      have hda_lt : d_a < f i := lt_of_not_ge (Finset.mem_filter.mp hi).2
      have hdb_le : d_b ≤ f i := le_of_not_gt (fun hlt_db => hf i ⟨hda_lt, hlt_db⟩)
      exact max_eq_right (le_trans hr_d_b hdb_le)
    rw [h1, h2, mul_comm]
  have h_atom_red : ∀ (d_a d_b : Γ₀), 0 < d_a → d_a < d_b →
      ∀ (c : Γ₀), c ≠ 0 →
      ∀ (k_num : ℕ) (θ : Fin k_num → Γ₀) (k_den : ℕ) (η : Fin k_den → Γ₀),
      (∀ i : Fin k_num, ¬ (d_a < θ i ∧ θ i < d_b)) →
      (∀ i : Fin k_den, ¬ (d_a < η i ∧ η i < d_b)) →
      ∀ r : Γ₀, d_a ≤ r → r ≤ d_b →
      (c * (∏ i : Fin k_num, max r (θ i)) * (∏ i : Fin k_den, max r (η i))⁻¹ ≤ 1 ↔
        (c * prodCoeff d_a k_num θ) * r ^ prodExp d_a k_num θ ≤
          prodCoeff d_a k_den η * r ^ prodExp d_a k_den η) := by
    intro d_a d_b hda_pos hda_db c _hc k_num θ k_den η hθ hη r hd_a_r hr_d_b
    have hr_pos : 0 < r := lt_of_lt_of_le hda_pos hd_a_r
    have hDen_ne : prodCoeff d_a k_den η * r ^ prodExp d_a k_den η ≠ 0 :=
      mul_ne_zero (h_prodCoeff_ne d_a hda_pos k_den η)
        (pow_ne_zero _ (zero_lt_iff.mp hr_pos))
    have hDen_pos : 0 < prodCoeff d_a k_den η * r ^ prodExp d_a k_den η :=
      zero_lt_iff.mpr hDen_ne
    rw [h_prod_max_eq d_a d_b hda_db k_num θ hθ r hd_a_r hr_d_b,
      h_prod_max_eq d_a d_b hda_db k_den η hη r hd_a_r hr_d_b,
      ← mul_assoc c (prodCoeff d_a k_num θ) (r ^ prodExp d_a k_num θ),
      mul_inv_le_iff₀ hDen_pos, one_mul]
  have h_stage2 : ∀ (d_a d_b : Γ₀), r₀ ≤ d_a → d_a < d_b → d_b ≤ r₁ →
      (∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)) (i : Fin (k₁_num μ j)),
        ¬ (d_a < θ₁ μ j i ∧ θ₁ μ j i < d_b)) →
      (∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)) (i : Fin (k₁_den μ j)),
        ¬ (d_a < η₁ μ j i ∧ η₁ μ j i < d_b)) →
      (∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)) (i : Fin (k₂_num ν j)),
        ¬ (d_a < θ₂ ν j i ∧ θ₂ ν j i < d_b)) →
      (∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)) (i : Fin (k₂_den ν j)),
        ¬ (d_a < η₂ ν j i ∧ η₂ ν j i < d_b)) →
      (P₁ d_a ↔ P₁ d_b) := by
    intro d_a d_b hr₀_da hda_db hdb_r₁ hNo_θ₁ hNo_η₁ hNo_θ₂ hNo_η₂
    have hda_pos : 0 < d_a := lt_of_lt_of_le (zero_lt_iff.mpr hr₀) hr₀_da
    let τ₁ : ∀ (μ : Fin (p + 1)), Fin (m₁ μ) → Γ₀ := fun μ j =>
      monomThreshold (c₁ μ j * prodCoeff d_a (k₁_num μ j) (θ₁ μ j))
        (prodCoeff d_a (k₁_den μ j) (η₁ μ j))
        (prodExp d_a (k₁_num μ j) (θ₁ μ j))
        (prodExp d_a (k₁_den μ j) (η₁ μ j))
    let τ₂ : ∀ (ν : Fin (q + 1)), Fin (m₂ ν) → Γ₀ := fun ν j =>
      monomThreshold (c₂ ν j * prodCoeff d_a (k₂_num ν j) (θ₂ ν j))
        (prodCoeff d_a (k₂_den ν j) (η₂ ν j))
        (prodExp d_a (k₂_num ν j) (θ₂ ν j))
        (prodExp d_a (k₂_den ν j) (η₂ ν j))
    let S₂ : Finset Γ₀ :=
      (Finset.univ.biUnion fun μ : Fin (p + 1) => Finset.univ.image (τ₁ μ)) ∪
      (Finset.univ.biUnion fun ν : Fin (q + 1) => Finset.univ.image (τ₂ ν))
    refine h_bisect (fun u v => P₁ u ↔ P₁ v) (fun _ => Iff.rfl)
      (fun _ _ _ h₁ h₂ => h₁.trans h₂) S₂ d_a d_b (le_of_lt hda_db) ?_
    intro u v hd_a_u huv hv_d_b hNoS₂
    have hu_pos : 0 < u := lt_of_lt_of_le hda_pos hd_a_u
    obtain ⟨m, hum, hmv⟩ := h_mid u v hu_pos huv
    have hd_a_m : d_a ≤ m := le_trans hd_a_u (le_of_lt hum)
    have hm_d_b : m ≤ d_b := le_trans (le_of_lt hmv) hv_d_b
    have hd_a_v : d_a ≤ v := le_trans hd_a_m (le_of_lt hmv)
    have hu_d_b : u ≤ d_b := le_trans (le_of_lt hum) hm_d_b
    have hr₀_u : r₀ ≤ u := le_trans hr₀_da hd_a_u
    have hu_r₁ : u ≤ r₁ := le_trans hu_d_b hdb_r₁
    have hr₀_m : r₀ ≤ m := le_trans hr₀_da hd_a_m
    have hm_r₁ : m ≤ r₁ := le_trans hm_d_b hdb_r₁
    have hr₀_v : r₀ ≤ v := le_trans hr₀_da hd_a_v
    have hv_r₁ : v ≤ r₁ := le_trans hv_d_b hdb_r₁
    rcases (hPart m hr₀_m hm_r₁).1 with ⟨μ, hμ_m⟩ | ⟨ν, hν_m⟩
    · have hBoth : ∀ j : Fin (m₁ μ),
          (c₁ μ j * (∏ i : Fin (k₁_num μ j), max u (θ₁ μ j i)) *
            (∏ i : Fin (k₁_den μ j), max u (η₁ μ j i))⁻¹ ≤ 1) ∧
          (c₁ μ j * (∏ i : Fin (k₁_num μ j), max v (θ₁ μ j i)) *
            (∏ i : Fin (k₁_den μ j), max v (η₁ μ j i))⁻¹ ≤ 1) := by
        intro j
        have hMem : τ₁ μ j ∈ S₂ :=
          Finset.mem_union_left _
            (Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ μ,
              Finset.mem_image_of_mem (τ₁ μ) (Finset.mem_univ j)⟩)
        have hRed := h_atom_red d_a d_b hda_pos hda_db (c₁ μ j) (hc₁ μ j)
          (k₁_num μ j) (θ₁ μ j) (k₁_den μ j) (η₁ μ j) (hNo_θ₁ μ j) (hNo_η₁ μ j)
        have hMon_m := (hRed m hd_a_m hm_d_b).mp (hμ_m j)
        obtain ⟨hMon_u, hMon_v⟩ := h_monom_transfer _ _
          (mul_ne_zero (hc₁ μ j) (h_prodCoeff_ne d_a hda_pos (k₁_num μ j) (θ₁ μ j)))
          (h_prodCoeff_ne d_a hda_pos (k₁_den μ j) (η₁ μ j))
          (prodExp d_a (k₁_num μ j) (θ₁ μ j))
          (prodExp d_a (k₁_den μ j) (η₁ μ j))
          u m v hu_pos hum hmv (hNoS₂ (τ₁ μ j) hMem) hMon_m
        exact ⟨(hRed u hd_a_u hu_d_b).mpr hMon_u, (hRed v hd_a_v hv_d_b).mpr hMon_v⟩
      have hP₁_u : P₁ u := ⟨μ, fun j => (hBoth j).1⟩
      have hP₁_v : P₁ v := ⟨μ, fun j => (hBoth j).2⟩
      exact ⟨fun _ => hP₁_v, fun _ => hP₁_u⟩
    · have hBoth : ∀ j : Fin (m₂ ν),
          (c₂ ν j * (∏ i : Fin (k₂_num ν j), max u (θ₂ ν j i)) *
            (∏ i : Fin (k₂_den ν j), max u (η₂ ν j i))⁻¹ ≤ 1) ∧
          (c₂ ν j * (∏ i : Fin (k₂_num ν j), max v (θ₂ ν j i)) *
            (∏ i : Fin (k₂_den ν j), max v (η₂ ν j i))⁻¹ ≤ 1) := by
        intro j
        have hMem : τ₂ ν j ∈ S₂ :=
          Finset.mem_union_right _
            (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν,
              Finset.mem_image_of_mem (τ₂ ν) (Finset.mem_univ j)⟩)
        have hRed := h_atom_red d_a d_b hda_pos hda_db (c₂ ν j) (hc₂ ν j)
          (k₂_num ν j) (θ₂ ν j) (k₂_den ν j) (η₂ ν j) (hNo_θ₂ ν j) (hNo_η₂ ν j)
        have hMon_m := (hRed m hd_a_m hm_d_b).mp (hν_m j)
        obtain ⟨hMon_u, hMon_v⟩ := h_monom_transfer _ _
          (mul_ne_zero (hc₂ ν j) (h_prodCoeff_ne d_a hda_pos (k₂_num ν j) (θ₂ ν j)))
          (h_prodCoeff_ne d_a hda_pos (k₂_den ν j) (η₂ ν j))
          (prodExp d_a (k₂_num ν j) (θ₂ ν j))
          (prodExp d_a (k₂_den ν j) (η₂ ν j))
          u m v hu_pos hum hmv (hNoS₂ (τ₂ ν j) hMem) hMon_m
        exact ⟨(hRed u hd_a_u hu_d_b).mpr hMon_u, (hRed v hd_a_v hv_d_b).mpr hMon_v⟩
      have hP₂_u : P₂ u := ⟨ν, fun j => (hBoth j).1⟩
      have hP₂_v : P₂ v := ⟨ν, fun j => (hBoth j).2⟩
      have hnP₁_u : ¬ P₁ u := fun h1 => (hPart u hr₀_u hu_r₁).2 ⟨h1, hP₂_u⟩
      have hnP₁_v : ¬ P₁ v := fun h1 => (hPart v hr₀_v hv_r₁).2 ⟨h1, hP₂_v⟩
      exact iff_of_false hnP₁_u hnP₁_v
  let S₁ : Finset Γ₀ :=
    ((Finset.univ.biUnion fun μ : Fin (p + 1) =>
        Finset.univ.biUnion fun j : Fin (m₁ μ) =>
          Finset.univ.image (θ₁ μ j)) ∪
      (Finset.univ.biUnion fun μ : Fin (p + 1) =>
        Finset.univ.biUnion fun j : Fin (m₁ μ) =>
          Finset.univ.image (η₁ μ j))) ∪
    ((Finset.univ.biUnion fun ν : Fin (q + 1) =>
        Finset.univ.biUnion fun j : Fin (m₂ ν) =>
          Finset.univ.image (θ₂ ν j)) ∪
      (Finset.univ.biUnion fun ν : Fin (q + 1) =>
        Finset.univ.biUnion fun j : Fin (m₂ ν) =>
          Finset.univ.image (η₂ ν j)))
  refine h_bisect (fun d_a d_b => P₁ d_a ↔ P₁ d_b) (fun _ => Iff.rfl)
    (fun _ _ _ h₁ h₂ => h₁.trans h₂) S₁ r₀ r₁ hr₀₁ ?_
  intro d_a d_b hr₀_da hda_db hdb_r₁ hNoS₁
  refine h_stage2 d_a d_b hr₀_da hda_db hdb_r₁ ?_ ?_ ?_ ?_
  · intro μ j i
    exact hNoS₁ (θ₁ μ j i)
      (Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ μ,
          Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j,
            Finset.mem_image_of_mem (θ₁ μ j) (Finset.mem_univ i)⟩⟩)))
  · intro μ j i
    exact hNoS₁ (η₁ μ j i)
      (Finset.mem_union_left _ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨μ, Finset.mem_univ μ,
          Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j,
            Finset.mem_image_of_mem (η₁ μ j) (Finset.mem_univ i)⟩⟩)))
  · intro ν j i
    exact hNoS₁ (θ₂ ν j i)
      (Finset.mem_union_right _ (Finset.mem_union_left _
        (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν,
          Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j,
            Finset.mem_image_of_mem (θ₂ ν j) (Finset.mem_univ i)⟩⟩)))
  · intro ν j i
    exact hNoS₁ (η₂ ν j i)
      (Finset.mem_union_right _ (Finset.mem_union_right _
        (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν,
          Finset.mem_biUnion.mpr ⟨j, Finset.mem_univ j,
            Finset.mem_image_of_mem (η₂ ν j) (Finset.mem_univ i)⟩⟩)))

theorem weil_algClosed_valuationRing_proj_p1_closure_connected (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Finite (PrimeSpectrum R)]
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (M : ℕ)
    (E_bar : AlgebraicGeometry.Scheme.{u})
    (ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left)
    (hCl : AlgebraicGeometry.IsClosedImmersion ι_bar)
    (hInt : AlgebraicGeometry.IsIntegral E_bar)
    (hGenIso : ∃ isoP1 :
        CategoryTheory.Limits.pullback
          (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) ≅
        (weilProjectiveSpaceOver K_R 1).left,
      CategoryTheory.Limits.pullback.snd
          (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) =
        isoP1.hom ≫ (weilProjectiveSpaceOver K_R 1).hom) :
    ConnectedSpace ↥(CategoryTheory.Limits.pullback
      (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) :=
by
  apply weil_proj_p1_closure_connected_of_no_ratFunc_val_split R K_R M E_bar ι_bar hCl hInt hGenIso
  rintro ⟨p, q, m₁, φ₁, m₂, φ₂, W₁, W₂, hW₁R, hW₂R, hφ₁_ne, hφ₂_ne,
    hW₁Max, hW₂Max, hW₁Mem, hW₂Mem, hSplit⟩
  obtain ⟨v_gauss, hv_domR, hv_domMax, hv_const, hv_lin, hv_apex, hLinFact⟩ :=
    weil_algClosed_ratFunc_gauss_valuation_pkg R K_R
  have hDiv : ∀ (γ : ValuationRing.ValueGroup R K_R) (n : ℕ), 1 ≤ n →
      ∃ δ : ValuationRing.ValueGroup R K_R, δ ^ n = γ := by
    intro γ n hn
    obtain ⟨x, hx⟩ := Quotient.exists_rep γ
    have hx_val : ValuationRing.valuation R K_R x = γ := hx
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq x (by omega : 0 < n)
    refine ⟨ValuationRing.valuation R K_R z, ?_⟩
    rw [← map_pow, hz, hx_val]
  obtain ⟨a₁, r_w1, hr_w1_mem⟩ :=
    weil_algClosed_ratFunc_gauss_approximation R hMaxR K_R v_gauss hv_const hv_lin hLinFact
      W₁ hW₁R hW₁Max (m₁ 0) (φ₁ 0) (hφ₁_ne 0) hW₁Mem
  obtain ⟨a₂, r_w2, hr_w2_mem⟩ :=
    weil_algClosed_ratFunc_gauss_approximation R hMaxR K_R v_gauss hv_const hv_lin hLinFact
      W₂ hW₂R hW₂Max (m₂ 0) (φ₂ 0) (hφ₂_ne 0) hW₂Mem
  have hFact₁ : ∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)),
      ∃ (c : K_R) (k_num k_den : ℕ) (α : Fin k_num → K_R) (β : Fin k_den → K_R),
        c ≠ 0 ∧
        φ₁ μ j = RatFunc.C c *
          (∏ i : Fin k_num, (RatFunc.X - RatFunc.C (α i))) *
          (∏ i : Fin k_den, (RatFunc.X - RatFunc.C (β i)))⁻¹ :=
    fun μ j => hLinFact (φ₁ μ j) (hφ₁_ne μ j)
  choose c₁_K k₁_num k₁_den hFact₁' using hFact₁
  choose α₁ β₁ hc₁_ne hφ₁_eq using hFact₁'
  have hFact₂ : ∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)),
      ∃ (c : K_R) (k_num k_den : ℕ) (α : Fin k_num → K_R) (β : Fin k_den → K_R),
        c ≠ 0 ∧
        φ₂ ν j = RatFunc.C c *
          (∏ i : Fin k_num, (RatFunc.X - RatFunc.C (α i))) *
          (∏ i : Fin k_den, (RatFunc.X - RatFunc.C (β i)))⁻¹ :=
    fun ν j => hLinFact (φ₂ ν j) (hφ₂_ne ν j)
  choose c₂_K k₂_num k₂_den hFact₂' using hFact₂
  choose α₂ β₂ hc₂_ne hφ₂_eq using hFact₂'
  let c₁ : ∀ μ : Fin (p + 1), Fin (m₁ μ) → ValuationRing.ValueGroup R K_R :=
    fun μ j => ValuationRing.valuation R K_R (c₁_K μ j)
  let c₂ : ∀ ν : Fin (q + 1), Fin (m₂ ν) → ValuationRing.ValueGroup R K_R :=
    fun ν j => ValuationRing.valuation R K_R (c₂_K ν j)
  have hc₁ : ∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)), c₁ μ j ≠ 0 :=
    fun μ j => (ValuationRing.valuation R K_R).ne_zero_iff.mpr (hc₁_ne μ j)
  have hc₂ : ∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)), c₂ ν j ≠ 0 :=
    fun ν j => (ValuationRing.valuation R K_R).ne_zero_iff.mpr (hc₂_ne ν j)
  have hMem₁ : ∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0})
      (μ : Fin (p + 1)) (j : Fin (m₁ μ)),
      φ₁ μ j ∈ (v_gauss a r).valuationSubring ↔
        c₁ μ j *
          (∏ i : Fin (k₁_num μ j), max r.1 (ValuationRing.valuation R K_R (a - α₁ μ j i))) *
          (∏ i : Fin (k₁_den μ j), max r.1 (ValuationRing.valuation R K_R (a - β₁ μ j i)))⁻¹ ≤ 1 := by
    intro a r μ j
    rw [Valuation.mem_valuationSubring_iff, hφ₁_eq μ j]
    rw [map_mul, map_mul, map_inv₀, map_prod, map_prod, hv_const]
    simp_rw [hv_lin]
    exact Iff.rfl
  have hMem₂ : ∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0})
      (ν : Fin (q + 1)) (j : Fin (m₂ ν)),
      φ₂ ν j ∈ (v_gauss a r).valuationSubring ↔
        c₂ ν j *
          (∏ i : Fin (k₂_num ν j), max r.1 (ValuationRing.valuation R K_R (a - α₂ ν j i))) *
          (∏ i : Fin (k₂_den ν j), max r.1 (ValuationRing.valuation R K_R (a - β₂ ν j i)))⁻¹ ≤ 1 := by
    intro a r ν j
    rw [Valuation.mem_valuationSubring_iff, hφ₂_eq ν j]
    rw [map_mul, map_mul, map_inv₀, map_prod, map_prod, hv_const]
    simp_rw [hv_lin]
    exact Iff.rfl
  have hRay : ∀ (a : K_R) (r₀ r₁ : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}),
      r₀.1 ≤ r₁.1 →
      ((∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ), φ₁ μ j ∈ (v_gauss a r₀).valuationSubring) ↔
       (∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ), φ₁ μ j ∈ (v_gauss a r₁).valuationSubring)) := by
    intro a r₀ r₁ hr₀₁
    simp_rw [hMem₁]
    exact weil_divisible_orderedGroup_monomial_ray_no_partition
      (ValuationRing.ValueGroup R K_R) hDiv r₀.1 r₁.1 r₀.2 hr₀₁ p q
      m₁ c₁ k₁_num k₁_den
      (fun μ j i => ValuationRing.valuation R K_R (a - α₁ μ j i))
      (fun μ j i => ValuationRing.valuation R K_R (a - β₁ μ j i))
      m₂ c₂ k₂_num k₂_den
      (fun ν j i => ValuationRing.valuation R K_R (a - α₂ ν j i))
      (fun ν j i => ValuationRing.valuation R K_R (a - β₂ ν j i))
      hc₁ hc₂
      (fun r hr₀_le _hr_le₁ => by
        have hr_pos : 0 < r := lt_of_lt_of_le (zero_lt_iff.mpr r₀.2) hr₀_le
        let r_sub : {x : ValuationRing.ValueGroup R K_R // x ≠ 0} := ⟨r, ne_of_gt hr_pos⟩
        have hSp := hSplit (v_gauss a r_sub).valuationSubring
          (hv_domR a r_sub) (fun x hx => hv_domMax a r_sub x (hv_domR a r_sub x) hx)
        simpa only [hMem₁ a r_sub, hMem₂ a r_sub] using hSp)
  let r_top_val : ValuationRing.ValueGroup R K_R :=
    max r_w1.1 (max r_w2.1 (ValuationRing.valuation R K_R (a₁ - a₂)))
  have hr_top_pos : 0 < r_top_val :=
    lt_of_lt_of_le (zero_lt_iff.mpr r_w1.2) (le_max_left _ _)
  let r_top : {r : ValuationRing.ValueGroup R K_R // r ≠ 0} :=
    ⟨r_top_val, ne_of_gt hr_top_pos⟩
  have hr1_le : r_w1.1 ≤ r_top.1 := le_max_left _ _
  have hr2_le : r_w2.1 ≤ r_top.1 := le_trans (le_max_left _ _) (le_max_right _ _)
  have ha12_le : ValuationRing.valuation R K_R (a₁ - a₂) ≤ r_top.1 :=
    le_trans (le_max_right _ _) (le_max_right _ _)
  have hApexEq : (v_gauss a₁ r_top).valuationSubring = (v_gauss a₂ r_top).valuationSubring :=
    hv_apex a₁ a₂ r_top ha12_le
  have hTop_a1 : ∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ),
      φ₁ μ j ∈ (v_gauss a₁ r_top).valuationSubring :=
    (hRay a₁ r_w1 r_top hr1_le).mp ⟨0, hr_w1_mem⟩
  have hTop_a2 : ∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ),
      φ₁ μ j ∈ (v_gauss a₂ r_top).valuationSubring := by
    rwa [← hApexEq]
  have hBot_a2 : ∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ),
      φ₁ μ j ∈ (v_gauss a₂ r_w2).valuationSubring :=
    (hRay a₂ r_w2 r_top hr2_le).mpr hTop_a2
  have hNoBoth := (hSplit (v_gauss a₂ r_w2).valuationSubring (hv_domR a₂ r_w2)
    (fun x hx => hv_domMax a₂ r_w2 x (hv_domR a₂ r_w2 x) hx)).2
  exact hNoBoth ⟨hBot_a2, ⟨0, hr_w2_mem⟩⟩

theorem weil_closed_fiber_etale_nodal_roof_to_affine_algebra (R : Type u) [CommRing R] [IsLocalRing R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat g_R)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g_R)
    (y₀ : ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hNode₀ : ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
      AlgebraicGeometry.Etale e₁ ∧
      AlgebraicGeometry.Etale e₂ ∧
      e₁.base u₀ = y₀ ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
      e₁ ≫ CategoryTheory.Limits.pullback.snd g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) :
    ∃ (A_R : Type u) (_ : CommRing A_R) (_ : Algebra R A_R)
      (ι_C : AlgebraicGeometry.Spec (CommRingCat.of A_R) ⟶ C_R)
      (p_A : AlgebraicGeometry.Spec (CommRingCat.of A_R))
      (B_bar : Type u) (_ : CommRing B_bar)
      (ψ₁ : (A_R ⧸ Ideal.map (algebraMap R A_R) (IsLocalRing.maximalIdeal R)) →+* B_bar)
      (ψ₂ : (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B_bar)
      (ε₀ : B_bar →+* IsLocalRing.ResidueField R),
      AlgebraicGeometry.IsOpenImmersion ι_C ∧
      ι_C ≫ g_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_R)) ∧
      ι_C.base p_A = (CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ ∧
      Module.Flat R A_R ∧
      Algebra.FinitePresentation R A_R ∧
      RingHom.Etale ψ₁ ∧
      RingHom.Etale ψ₂ ∧
      ψ₁.comp ((Ideal.Quotient.mk _).comp (algebraMap R A_R)) =
        (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp (IsLocalRing.residue R) ∧
      ε₀.comp (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
        RingHom.id (IsLocalRing.ResidueField R) ∧
      (∀ i : Fin 2, ε₀ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))) = 0) ∧
      Ideal.comap (ψ₁.comp (Ideal.Quotient.mk _)) (RingHom.ker ε₀) = p_A.asIdeal :=
by
  obtain ⟨U', u₀, e₁, e₂, hEt₁_sch, hEt₂_sch, hu₀_y₀, hu₀_X, hComm_k₀⟩ := hNode₀
  let s₀ : AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.ResidueField R)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
  
  have hs1 :
      ∃ (A_R : Type u) (_ : CommRing A_R) (_ : Algebra R A_R)
        (ι_C : AlgebraicGeometry.Spec (CommRingCat.of A_R) ⟶ C_R)
        (p_A : AlgebraicGeometry.Spec (CommRingCat.of A_R))
        (ι_A0 : AlgebraicGeometry.Spec (CommRingCat.of
            (A_R ⧸ Ideal.map (algebraMap R A_R) (IsLocalRing.maximalIdeal R))) ⟶
          CategoryTheory.Limits.pullback g_R s₀)
        (y_A : AlgebraicGeometry.Spec (CommRingCat.of
          (A_R ⧸ Ideal.map (algebraMap R A_R) (IsLocalRing.maximalIdeal R)))),
        AlgebraicGeometry.IsOpenImmersion ι_C ∧
        ι_C ≫ g_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_R)) ∧
        ι_C.base p_A = (CategoryTheory.Limits.pullback.fst g_R s₀).base y₀ ∧
        Module.Flat R A_R ∧
        Algebra.FinitePresentation R A_R ∧
        AlgebraicGeometry.IsOpenImmersion ι_A0 ∧
        ι_A0 ≫ CategoryTheory.Limits.pullback.fst g_R s₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _)) ≫ ι_C ∧
        ι_A0.base y_A = y₀ ∧
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk _))).base y_A = p_A := by
    let x_C : ↥C_R := (CategoryTheory.Limits.pullback.fst g_R s₀).base y₀
    obtain ⟨R_aff, ι_C, hOpen_ιC, ⟨p_A, hp_A⟩, _⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (X := C_R) (x := x_C) (U := ⊤) trivial
    let A_R : Type u := ↑R_aff
    let φ_RA : R →+* A_R := (AlgebraicGeometry.Spec.preimage (ι_C ≫ g_R)).hom
    let _ : Algebra R A_R := φ_RA.toAlgebra
    have h_alg_eq : CommRingCat.ofHom (algebraMap R A_R) =
        AlgebraicGeometry.Spec.preimage (ι_C ≫ g_R) := rfl
    have hComm_ιC : ι_C ≫ g_R =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_R)) := by
      rw [h_alg_eq, AlgebraicGeometry.Spec.map_preimage]
    have _ : AlgebraicGeometry.IsOpenImmersion ι_C := hOpen_ιC
    have hFlat_comp : AlgebraicGeometry.Flat (ι_C ≫ g_R) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Flat) ι_C g_R
        inferInstance hFlat
    have hFlat_A : Module.Flat R A_R := by
      rw [hComm_ιC] at hFlat_comp
      exact RingHom.flat_algebraMap_iff.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp
          hFlat_comp)
    have hLFP_comp : AlgebraicGeometry.LocallyOfFinitePresentation (ι_C ≫ g_R) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.LocallyOfFinitePresentation)
        ι_C g_R inferInstance hLFP
    have hFP_A : Algebra.FinitePresentation R A_R := by
      rw [hComm_ιC] at hLFP_comp
      exact RingHom.finitePresentation_algebraMap.mp
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFinitePresentation)).mp hLFP_comp)
    let m_R : Ideal R := IsLocalRing.maximalIdeal R
    let I_A : Ideal A_R := Ideal.map (algebraMap R A_R) m_R
    let A_bar : Type u := A_R ⧸ I_A
    let π_A : A_R →+* A_bar := Ideal.Quotient.mk I_A
    have h_ker_α : ∀ r ∈ m_R, (π_A.comp (algebraMap R A_R)) r = 0 := by
      intro r hr
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem (algebraMap R A_R) hr)
    let α_k : IsLocalRing.ResidueField R →+* A_bar :=
      Ideal.Quotient.lift m_R (π_A.comp (algebraMap R A_R)) h_ker_α
    have h_α_comp : α_k.comp (IsLocalRing.residue R) = π_A.comp (algebraMap R A_R) := by
      ext r
      rfl
    let f_ring : CommRingCat.of R ⟶ CommRingCat.of A_R :=
      CommRingCat.ofHom (algebraMap R A_R)
    let g_ring : CommRingCat.of R ⟶ CommRingCat.of (IsLocalRing.ResidueField R) :=
      CommRingCat.ofHom (IsLocalRing.residue R)
    let inl_ring : CommRingCat.of A_R ⟶ CommRingCat.of A_bar :=
      CommRingCat.ofHom π_A
    let inr_ring : CommRingCat.of (IsLocalRing.ResidueField R) ⟶ CommRingCat.of A_bar :=
      CommRingCat.ofHom α_k
    have h_sq : f_ring ≫ inl_ring = g_ring ≫ inr_ring := by
      ext r
      exact (RingHom.congr_fun h_α_comp r).symm
    let desc_fn : ∀ s : CategoryTheory.Limits.PushoutCocone f_ring g_ring,
        CommRingCat.of A_bar ⟶ s.pt := fun s =>
      CommRingCat.ofHom (Ideal.Quotient.lift I_A s.inl.hom (by
        have h_le : I_A ≤ RingHom.ker s.inl.hom := by
          rw [Ideal.map_le_iff_le_comap]
          intro r hr
          rw [Ideal.mem_comap, RingHom.mem_ker]
          have hcond := RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) r
          dsimp [f_ring, g_ring] at hcond
          rw [hcond]
          have hr0 : IsLocalRing.residue R r = 0 := by
            rw [← RingHom.mem_ker, IsLocalRing.ker_residue]
            exact hr
          rw [hr0, map_zero]
        intro a ha
        exact h_le ha))
    have h_colim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_ring inr_ring h_sq) :=
      CategoryTheory.Limits.PushoutCocone.IsColimit.mk h_sq desc_fn
        (fun s => by
          ext a
          rfl)
        (fun s => by
          ext x
          obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective (R := R) x
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) r)
        (fun s m hm_inl _ => by
          apply CommRingCat.Hom.ext
          apply Ideal.Quotient.ringHom_ext
          ext a
          exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm_inl) a)
    have h_push : CategoryTheory.IsPushout f_ring g_ring inl_ring inr_ring :=
      CategoryTheory.IsPushout.of_isColimit h_colim
    have h_pb_outer : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_ring)
        (AlgebraicGeometry.Spec.map inr_ring)
        (ι_C ≫ g_R) s₀ := by
      have h := AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_ring g_ring inl_ring inr_ring h_push
      rwa [← hComm_ιC] at h
    have h_lift_cond : (AlgebraicGeometry.Spec.map inl_ring ≫ ι_C) ≫ g_R =
        AlgebraicGeometry.Spec.map inr_ring ≫ s₀ := by
      rw [CategoryTheory.Category.assoc]
      exact h_pb_outer.w
    let ι_A0 : AlgebraicGeometry.Spec (CommRingCat.of A_bar) ⟶
        CategoryTheory.Limits.pullback g_R s₀ :=
      CategoryTheory.Limits.pullback.lift
        (AlgebraicGeometry.Spec.map inl_ring ≫ ι_C)
        (AlgebraicGeometry.Spec.map inr_ring)
        h_lift_cond
    have h_ιA0_fst : ι_A0 ≫ CategoryTheory.Limits.pullback.fst g_R s₀ =
        AlgebraicGeometry.Spec.map inl_ring ≫ ι_C :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have h_ιA0_snd : ι_A0 ≫ CategoryTheory.Limits.pullback.snd g_R s₀ =
        AlgebraicGeometry.Spec.map inr_ring :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have h_pb_outer' : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_ring)
        (ι_A0 ≫ CategoryTheory.Limits.pullback.snd g_R s₀)
        (ι_C ≫ g_R) s₀ := by
      rwa [h_ιA0_snd]
    have h_pb_top : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inl_ring)
        ι_A0 ι_C (CategoryTheory.Limits.pullback.fst g_R s₀) :=
      CategoryTheory.IsPullback.of_bot h_pb_outer' h_ιA0_fst.symm
        (CategoryTheory.IsPullback.of_hasPullback g_R s₀)
    have hOpen_ιA0 : AlgebraicGeometry.IsOpenImmersion ι_A0 :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.IsOpenImmersion) h_pb_top hOpen_ιC
    obtain ⟨y_A, hy_A_pA, hy_A_y₀⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback h_pb_top p_A y₀ hp_A
    exact ⟨A_R, inferInstance, inferInstance, ι_C, p_A, ι_A0, y_A,
      hOpen_ιC, hComm_ιC, hp_A, hFlat_A, hFP_A, hOpen_ιA0, h_ιA0_fst, hy_A_y₀, hy_A_pA⟩
  obtain ⟨A_R, instCommA, instAlgA, ι_C, p_A, ι_A0, y_A,
    hOpen_ιC, hComm_ιC, hp_A, hFlat_A, hFP_A, hOpen_ιA0, hComm_ιA0_fst, hy_A_y₀, hy_A_pA⟩ := hs1
  let _ : CommRing A_R := instCommA
  let _ : Algebra R A_R := instAlgA
  have _ : AlgebraicGeometry.IsOpenImmersion ι_A0 := hOpen_ιA0
  let A_bar_cat : CommRingCat.{u} :=
    CommRingCat.of (A_R ⧸ Ideal.map (algebraMap R A_R) (IsLocalRing.maximalIdeal R))
  let N_bar_cat : CommRingCat.{u} :=
    CommRingCat.of (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
        Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))))
  
  have hs2 :
      ∃ (B_bar : Type u) (_ : CommRing B_bar)
        (ι_U : AlgebraicGeometry.Spec (CommRingCat.of B_bar) ⟶ U')
        (q_B : AlgebraicGeometry.Spec (CommRingCat.of B_bar))
        (ψ₁ : ↑A_bar_cat →+* B_bar)
        (ψ₂ : ↑N_bar_cat →+* B_bar),
        AlgebraicGeometry.IsOpenImmersion ι_U ∧
        ι_U.base q_B = u₀ ∧
        RingHom.Etale ψ₁ ∧
        RingHom.Etale ψ₂ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ ι_A0 = ι_U ≫ e₁ ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) = ι_U ≫ e₂ ∧
        Ideal.comap ψ₁ q_B.asIdeal = y_A.asIdeal := by
    let W_U' : U'.Opens := (TopologicalSpace.Opens.map e₁.base).obj ι_A0.opensRange
    have hu₀_mem : u₀ ∈ W_U' := by
      change e₁.base u₀ ∈ Set.range ι_A0.base
      rw [hu₀_y₀, ← hy_A_y₀]
      exact ⟨y_A, rfl⟩
    obtain ⟨B_cat, ι_U, hOpen_ιU, ⟨q_B, hq_B_u₀⟩, hRange_sub⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (X := U') (x := u₀) (U := W_U') hu₀_mem
    let B_bar : Type u := ↑B_cat
    have _ : AlgebraicGeometry.IsOpenImmersion ι_U := hOpen_ιU
    have hRange_lift : Set.range (ι_U ≫ e₁).base ⊆ Set.range ι_A0.base := by
      rintro _ ⟨p, rfl⟩
      have hp : ι_U.base p ∈ (W_U' : Set U') := hRange_sub ⟨p, rfl⟩
      exact hp
    let f₁ : AlgebraicGeometry.Spec (CommRingCat.of B_bar) ⟶ AlgebraicGeometry.Spec A_bar_cat :=
      AlgebraicGeometry.IsOpenImmersion.lift ι_A0 (ι_U ≫ e₁) hRange_lift
    have hf₁_fac : f₁ ≫ ι_A0 = ι_U ≫ e₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι_A0 (ι_U ≫ e₁) hRange_lift
    have _ : AlgebraicGeometry.Etale e₁ := hEt₁_sch
    have _ : AlgebraicGeometry.Etale e₂ := hEt₂_sch
    have hEt_comp₁ : AlgebraicGeometry.Etale (f₁ ≫ ι_A0) := by
      rw [hf₁_fac]
      exact inferInstance
    have hEt_f₁ : AlgebraicGeometry.Etale f₁ :=
      CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
        f₁ ι_A0 inferInstance hEt_comp₁
    let ψ₁ : ↑A_bar_cat →+* B_bar := (AlgebraicGeometry.Spec.preimage f₁).hom
    have hψ₁_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) = f₁ :=
      AlgebraicGeometry.Spec.map_preimage f₁
    have hEt_ψ₁ : RingHom.Etale ψ₁ := by
      rw [← hψ₁_map] at hEt_f₁
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_f₁
    have hEt_comp₂ : AlgebraicGeometry.Etale (ι_U ≫ e₂) := inferInstance
    let ψ₂ : ↑N_bar_cat →+* B_bar := (AlgebraicGeometry.Spec.preimage (ι_U ≫ e₂)).hom
    have hψ₂_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) = ι_U ≫ e₂ :=
      AlgebraicGeometry.Spec.map_preimage (ι_U ≫ e₂)
    have hEt_ψ₂ : RingHom.Etale ψ₂ := by
      rw [← hψ₂_map] at hEt_comp₂
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        hEt_comp₂
    have hf₁_qB : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)).base q_B = y_A := by
      apply (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding ι_A0).injective
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ ι_A0).base q_B = ι_A0.base y_A
      rw [hψ₁_map, hf₁_fac]
      change e₁.base (ι_U.base q_B) = ι_A0.base y_A
      rw [hq_B_u₀, hu₀_y₀, hy_A_y₀]
    have hComap_ψ₁ : Ideal.comap ψ₁ q_B.asIdeal = y_A.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hf₁_qB
    refine ⟨B_bar, inferInstance, ι_U, q_B, ψ₁, ψ₂,
      hOpen_ιU, hq_B_u₀, hEt_ψ₁, hEt_ψ₂, ?_, hψ₂_map, hComap_ψ₁⟩
    rw [hψ₁_map, hf₁_fac]
  obtain ⟨B_bar, instCommB, ι_U, q_B, ψ₁, ψ₂,
    _hOpen_ιU, hq_B_u₀, hEt₁, hEt₂, hψ₁_comm, hψ₂_comm, hComap_ψ₁⟩ := hs2
  let _ : CommRing B_bar := instCommB
  have hX_mem : ∀ i : Fin 2, ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_B.asIdeal := by
    intro i
    change Ideal.Quotient.mk _ (MvPolynomial.X i) ∈
      ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂)).base q_B).asIdeal
    have h_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂)).base q_B = e₂.base u₀ := by
      rw [hψ₂_comm]
      change e₂.base (ι_U.base q_B) = e₂.base u₀
      rw [hq_B_u₀]
    rw [h_eq]
    exact hu₀_X i
  
  have hs3 :
      ∃ (ε₀ : B_bar →+* IsLocalRing.ResidueField R),
        ε₀.comp (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
          RingHom.id (IsLocalRing.ResidueField R) ∧
        (∀ i : Fin 2, ε₀ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))) = 0) ∧
        RingHom.ker ε₀ = q_B.asIdeal := by
    let _ : IsAlgClosed (IsLocalRing.ResidueField R) := hAlgRes
    let I_nod : Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) :=
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
    let N_bar : Type u := MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I_nod
    have h_ker_ev : ∀ p ∈ I_nod,
        (MvPolynomial.constantCoeff :
          MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) →+*
            IsLocalRing.ResidueField R) p = 0 := by
      have hle : I_nod ≤ RingHom.ker MvPolynomial.constantCoeff := by
        rw [Ideal.span_le]
        rintro p rfl
        simp [RingHom.mem_ker, MvPolynomial.constantCoeff_X]
      exact fun p hp => hle hp
    let ev_nod : N_bar →+* IsLocalRing.ResidueField R :=
      Ideal.Quotient.lift I_nod MvPolynomial.constantCoeff h_ker_ev
    have hSurj_ev : Function.Surjective ev_nod := by
      intro c
      refine ⟨Ideal.Quotient.mk I_nod (MvPolynomial.C c), ?_⟩
      change MvPolynomial.constantCoeff (MvPolynomial.C c) = c
      exact MvPolynomial.constantCoeff_C (Fin 2) c
    haveI : q_B.asIdeal.IsPrime := q_B.2
    let m_nod : Ideal N_bar := Ideal.comap ψ₂ q_B.asIdeal
    haveI : m_nod.IsPrime := Ideal.comap_isPrime ψ₂ q_B.asIdeal
    let φ_mod : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) →+* (N_bar ⧸ m_nod) :=
      (Ideal.Quotient.mk m_nod).comp (Ideal.Quotient.mk I_nod)
    let ψ_mod : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) →+* (N_bar ⧸ m_nod) :=
      ((Ideal.Quotient.mk m_nod).comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C)).comp
        MvPolynomial.constantCoeff
    have h_mod_eq : φ_mod = ψ_mod := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp [φ_mod, ψ_mod, MvPolynomial.constantCoeff_C]
      · intro i
        have h1 : φ_mod (MvPolynomial.X i) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (hX_mem i)
        have h2 : ψ_mod (MvPolynomial.X i) = 0 := by
          simp [ψ_mod, MvPolynomial.constantCoeff_X]
        rw [h1, h2]
    have h_ker_le : RingHom.ker ev_nod ≤ m_nod := by
      intro z hz
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hP0 : MvPolynomial.constantCoeff P = 0 := hz
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change φ_mod P = 0
      rw [h_mod_eq]
      simp [ψ_mod, hP0]
    have h_isField : IsField (N_bar ⧸ RingHom.ker ev_nod) :=
      MulEquiv.isField (Field.toIsField (IsLocalRing.ResidueField R))
        (RingHom.quotientKerEquivOfSurjective hSurj_ev).toMulEquiv
    have h_ker_max : (RingHom.ker ev_nod).IsMaximal :=
      Ideal.Quotient.maximal_of_isField (RingHom.ker ev_nod) h_isField
    have h_ker_eq_m : RingHom.ker ev_nod = m_nod :=
      h_ker_max.eq_of_le (Ideal.IsPrime.ne_top inferInstance) h_ker_le
    haveI : m_nod.IsMaximal := h_ker_eq_m ▸ h_ker_max
    letI : Algebra N_bar B_bar := ψ₂.toAlgebra
    haveI : Algebra.Etale N_bar B_bar := RingHom.etale_algebraMap.mp hEt₂
    letI : Algebra (IsLocalRing.ResidueField R) B_bar :=
      (ψ₂.comp (algebraMap (IsLocalRing.ResidueField R) N_bar)).toAlgebra
    haveI : IsScalarTower (IsLocalRing.ResidueField R) N_bar B_bar :=
      ⟨fun c y z => by
        rw [Algebra.smul_def c y]
        change ψ₂ (algebraMap (IsLocalRing.ResidueField R) N_bar c * y) * z =
          ψ₂ (algebraMap (IsLocalRing.ResidueField R) N_bar c) * (ψ₂ y * z)
        rw [map_mul, mul_assoc]⟩
    haveI : q_B.asIdeal.LiesOver m_nod := Ideal.LiesOver.mk rfl
    letI : Algebra (Localization.AtPrime m_nod) (Localization.AtPrime q_B.asIdeal) :=
      Localization.AtPrime.algebraOfLiesOver m_nod q_B.asIdeal
    letI : IsScalarTower N_bar (Localization.AtPrime m_nod) (Localization.AtPrime q_B.asIdeal) :=
      Localization.AtPrime.instIsScalarTower m_nod q_B.asIdeal
    have hSurj_k₀_mnod :
        Function.Surjective (algebraMap (IsLocalRing.ResidueField R) m_nod.ResidueField) := by
      intro w
      obtain ⟨z, rfl⟩ := Ideal.algebraMap_residueField_surjective m_nod w
      refine ⟨ev_nod z, ?_⟩
      rw [IsScalarTower.algebraMap_apply (IsLocalRing.ResidueField R) N_bar
        m_nod.ResidueField (ev_nod z)]
      have h_diff_ker : z - algebraMap (IsLocalRing.ResidueField R) N_bar (ev_nod z) ∈ m_nod := by
        rw [← h_ker_eq_m, RingHom.mem_ker, map_sub]
        have hev_alg : ev_nod (algebraMap (IsLocalRing.ResidueField R) N_bar (ev_nod z)) =
            ev_nod z :=
          MvPolynomial.constantCoeff_C (Fin 2) (ev_nod z)
        rw [hev_alg, sub_self]
      have h_zero :
          algebraMap N_bar m_nod.ResidueField
            (z - algebraMap (IsLocalRing.ResidueField R) N_bar (ev_nod z)) = 0 := by
        rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField m_nod]
        exact h_diff_ker
      rw [map_sub, sub_eq_zero] at h_zero
      exact h_zero.symm
    have _ : Module.Finite (IsLocalRing.ResidueField R) m_nod.ResidueField :=
      Module.Finite.of_surjective
        (Algebra.linearMap (IsLocalRing.ResidueField R) m_nod.ResidueField) hSurj_k₀_mnod
    have _ : Module.Finite (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField :=
      Module.Finite.trans m_nod.ResidueField q_B.asIdeal.ResidueField
    have _ : Algebra.IsIntegral (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField :=
      Algebra.IsIntegral.of_finite (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField
    have hBij : Function.Bijective
        (algebraMap (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e_res : IsLocalRing.ResidueField R ≃+* q_B.asIdeal.ResidueField :=
      RingEquiv.ofBijective
        (algebraMap (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField) hBij
    let ε₀ : B_bar →+* IsLocalRing.ResidueField R :=
      e_res.symm.toRingHom.comp (algebraMap B_bar q_B.asIdeal.ResidueField)
    have hKer_ε₀ : RingHom.ker ε₀ = q_B.asIdeal := by
      ext b
      change e_res.symm (algebraMap B_bar q_B.asIdeal.ResidueField b) = 0 ↔ b ∈ q_B.asIdeal
      rw [RingEquiv.symm_apply_eq, map_zero, ← RingHom.mem_ker,
        Ideal.ker_algebraMap_residueField q_B.asIdeal]
    have hAug : ε₀.comp (ψ₂.comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C)) =
        RingHom.id (IsLocalRing.ResidueField R) := by
      ext c
      change e_res.symm
        (algebraMap B_bar q_B.asIdeal.ResidueField
          (algebraMap (IsLocalRing.ResidueField R) B_bar c)) = c
      rw [← IsScalarTower.algebraMap_apply (IsLocalRing.ResidueField R) B_bar
        q_B.asIdeal.ResidueField c]
      exact e_res.symm_apply_apply c
    have hX₀ : ∀ i : Fin 2, ε₀ (ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.X i))) = 0 := by
      intro i
      rw [← RingHom.mem_ker, hKer_ε₀]
      exact hX_mem i
    exact ⟨ε₀, hAug, hX₀, hKer_ε₀⟩
  obtain ⟨ε₀, hAug, hX₀, hKer_ε₀⟩ := hs3
  refine ⟨A_R, instCommA, instAlgA, ι_C, p_A, B_bar, instCommB, ψ₁, ψ₂, ε₀,
    hOpen_ιC, hComm_ιC, hp_A, hFlat_A, hFP_A, hEt₁, hEt₂, ?_, hAug, hX₀, ?_⟩
  · 
    let π_A : A_R →+* (A_R ⧸ Ideal.map (algebraMap R A_R) (IsLocalRing.maximalIdeal R)) :=
      Ideal.Quotient.mk _
    let c_nod : IsLocalRing.ResidueField R →+*
        (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
          (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
            Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)))) :=
      (Ideal.Quotient.mk
        (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :
          Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)))).comp MvPolynomial.C
    have h_spec_eq :
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (ψ₁.comp (π_A.comp (algebraMap R A_R)))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((ψ₂.comp c_nod).comp (IsLocalRing.residue R))) := by
      have lhs_eq :
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ₁.comp (π_A.comp (algebraMap R A_R)))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A) ≫ (ι_C ≫ g_R)) := by
        rw [hComm_ιC, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have rhs_eq :
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((ψ₂.comp c_nod).comp (IsLocalRing.residue R))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) ≫ s₀ := by
        dsimp [s₀]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rfl
      rw [lhs_eq, rhs_eq]
      calc
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A) ≫ (ι_C ≫ g_R))
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
              ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_A) ≫ ι_C) ≫ g_R) := by
            simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
              ((ι_A0 ≫ CategoryTheory.Limits.pullback.fst g_R s₀) ≫ g_R) := by
            rw [← hComm_ιA0_fst]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ ι_A0) ≫
              (CategoryTheory.Limits.pullback.fst g_R s₀ ≫ g_R) := by
            simp only [CategoryTheory.Category.assoc]
        _ = (ι_U ≫ e₁) ≫ (CategoryTheory.Limits.pullback.snd g_R s₀ ≫ s₀) := by
            rw [hψ₁_comm, CategoryTheory.Limits.pullback.condition]
        _ = ι_U ≫ (e₁ ≫ CategoryTheory.Limits.pullback.snd g_R s₀) ≫ s₀ := by
            simp only [CategoryTheory.Category.assoc]
        _ = ι_U ≫ (e₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)) ≫ s₀ := by
            rw [hComm_k₀]
        _ = (ι_U ≫ e₂) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) ≫ s₀ := by
            simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) ≫ s₀ := by
            rw [← hψ₂_comm]
    have h_pre := congrArg (fun f => (AlgebraicGeometry.Spec.preimage f).hom) h_spec_eq
    rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at h_pre
    exact h_pre
  · 
    rw [hKer_ε₀, ← Ideal.comap_comap, hComap_ψ₁]
    exact congrArg PrimeSpectrum.asIdeal hy_A_pA

theorem weil_henselianLocalRing_etale_residue_section (R : Type u) [CommRing R] [HenselianLocalRing R]
    (E_R : Type u) [CommRing E_R] [Algebra R E_R] [Algebra.Etale R E_R]
    (σ_bar : E_R →+* IsLocalRing.ResidueField R)
    (hCompat : σ_bar.comp (algebraMap R E_R) = IsLocalRing.residue R) :
    ∃ σ : E_R →ₐ[R] R, (IsLocalRing.residue R).comp σ.toRingHom = σ_bar :=
by
  
  have hStep1 :
      ∃ (E_q : Type u) (_ : CommRing E_q) (_ : IsLocalRing E_q) (_ : Algebra R E_q)
        (ι_q : E_R →ₐ[R] E_q)
        (σ_q : E_q →+* IsLocalRing.ResidueField R)
        (R₁ : Subalgebra R E_q),
        Function.Injective (algebraMap R E_q) ∧
        IsLocalHom (algebraMap R E_q) ∧
        Ideal.map (algebraMap R E_q) (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal E_q ∧
        σ_q.comp ι_q.toRingHom = σ_bar ∧
        σ_q.comp (algebraMap R E_q) = IsLocalRing.residue R ∧
        RingHom.ker σ_q = IsLocalRing.maximalIdeal E_q ∧
        Module.Finite R ↥R₁ ∧
        IsLocalization (Ideal.comap R₁.val.toRingHom (IsLocalRing.maximalIdeal E_q)).primeCompl E_q := by
    let κ : Type u := IsLocalRing.ResidueField R
    let m_R : Ideal R := IsLocalRing.maximalIdeal R
    let res : R →+* κ := IsLocalRing.residue R
    let q : Ideal E_R := RingHom.ker σ_bar
    have hq_prime : q.IsPrime := RingHom.ker_isPrime σ_bar
    have hq_comap : Ideal.comap (algebraMap R E_R) q = m_R := by
      ext r
      change σ_bar (algebraMap R E_R r) = 0 ↔ r ∈ m_R
      have hr := RingHom.congr_fun hCompat r
      dsimp at hr
      rw [hr, IsLocalRing.residue_eq_zero_iff]
    obtain ⟨E_q, instCR_Eq, instLoc_Eq, instAlgER_Eq, instIsLoc_Eq,
        hmax_comap_E, instFlat_ER_Eq, instEssFT_ER_Eq, instUnram_ER_Eq⟩ :
        ∃ (E_q : Type u) (instCR : CommRing E_q) (_ : @IsLocalRing E_q instCR.toSemiring)
          (instAlg : Algebra E_R E_q)
          (_ : @IsLocalization E_R _ q.primeCompl E_q instCR.toCommSemiring instAlg),
          Ideal.comap (@algebraMap E_R E_q _ instCR.toSemiring instAlg)
            (@IsLocalRing.maximalIdeal E_q instCR.toCommSemiring _) = q ∧
          @Module.Flat E_R E_q _ instCR.toSemiring.toAddCommMonoid instAlg.toModule ∧
          @Algebra.EssFiniteType E_R E_q _ instCR instAlg ∧
          @Algebra.FormallyUnramified E_R E_q _ instCR instAlg :=
      ⟨Localization.AtPrime q, inferInstance, inferInstance, inferInstance, inferInstance,
        IsLocalization.AtPrime.under_maximalIdeal (Localization.AtPrime q) q,
        Localization.flat (R := E_R) E_R q.primeCompl, inferInstance, inferInstance⟩
    let _ : CommRing E_q := instCR_Eq
    let _ : IsLocalRing E_q := instLoc_Eq
    let _ : Algebra E_R E_q := instAlgER_Eq
    have _ : IsLocalization q.primeCompl E_q := instIsLoc_Eq
    have _ : Module.Flat E_R E_q := instFlat_ER_Eq
    have _ : Algebra.EssFiniteType E_R E_q := instEssFT_ER_Eq
    have _ : Algebra.FormallyUnramified E_R E_q := instUnram_ER_Eq
    let algR_Eq : Algebra R E_q := ((algebraMap E_R E_q).comp (algebraMap R E_R)).toAlgebra
    let _ : Algebra R E_q := algR_Eq
    have _ : IsScalarTower R E_R E_q := IsScalarTower.of_algebraMap_eq' rfl
    let ι_q : E_R →ₐ[R] E_q := IsScalarTower.toAlgHom R E_R E_q
    have hmax_comap_R : Ideal.comap (algebraMap R E_q) (IsLocalRing.maximalIdeal E_q) = m_R := by
      rw [IsScalarTower.algebraMap_eq R E_R E_q, ← Ideal.comap_comap, hmax_comap_E, hq_comap]
    have hLocHom : IsLocalHom (algebraMap R E_q) := ⟨fun r hr => by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hrm
      have hmem : algebraMap R E_q r ∈ IsLocalRing.maximalIdeal E_q := by
        change r ∈ Ideal.comap (algebraMap R E_q) (IsLocalRing.maximalIdeal E_q)
        rwa [hmax_comap_R]
      exact (IsLocalRing.notMem_maximalIdeal.mpr hr) hmem⟩
    have _ : Module.Flat R E_q := Module.Flat.trans R E_R E_q
    have hff : (algebraMap R E_q).FaithfullyFlat := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hInj : Function.Injective (algebraMap R E_q) := RingHom.FaithfullyFlat.injective hff
    have _ : Algebra.EssFiniteType R E_q := Algebra.EssFiniteType.comp R E_R E_q
    have _ : Algebra.FormallyUnramified R E_q := Algebra.FormallyUnramified.comp R E_R E_q
    have hMaxMap : Ideal.map (algebraMap R E_q) m_R = IsLocalRing.maximalIdeal E_q :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have h_units : ∀ s : q.primeCompl, IsUnit (σ_bar s.1) := by
      intro s
      exact IsUnit.mk0 (σ_bar s.1) (fun h0 => s.2 h0)
    let σ_q : E_q →+* κ := IsLocalization.lift (M := q.primeCompl) h_units
    have hσ_ι : σ_q.comp ι_q.toRingHom = σ_bar := by
      ext x
      exact IsLocalization.lift_eq (M := q.primeCompl) h_units x
    have hσ_R : σ_q.comp (algebraMap R E_q) = res := by
      ext r
      calc σ_q (algebraMap R E_q r)
          = σ_q (ι_q (algebraMap R E_R r)) := by
              rw [IsScalarTower.algebraMap_apply R E_R E_q]; rfl
        _ = σ_bar (algebraMap R E_R r) := RingHom.congr_fun hσ_ι (algebraMap R E_R r)
        _ = res r := RingHom.congr_fun hCompat r
    have hKer_σ : RingHom.ker σ_q = IsLocalRing.maximalIdeal E_q := by
      apply le_antisymm
      · exact IsLocalRing.le_maximalIdeal (RingHom.ker_isPrime σ_q).ne_top
      · rw [← hMaxMap, Ideal.map_le_iff_le_comap]
        intro r hr
        change (σ_q.comp (algebraMap R E_q)) r = 0
        rw [hσ_R]
        exact (IsLocalRing.residue_eq_zero_iff r).mpr hr
    have hzmt_prop : Algebra.ZariskisMainProperty R q :=
      Algebra.ZariskisMainProperty.of_finiteType (R := R) q
    obtain ⟨r₀, hr₀_not_q, hr₀_int, hzmt⟩ := Algebra.zariskisMainProperty_iff.mp hzmt_prop
    obtain ⟨S_gen, hS_gen⟩ := (inferInstance : Algebra.FiniteType R E_R).out
    let m_fn : E_R → ℕ := fun y => Classical.choose (hzmt y)
    have hm_fn : ∀ y : E_R, IsIntegral R (r₀ ^ (m_fn y) * y) :=
      fun y => Classical.choose_spec (hzmt y)
    let G_set : Set E_R := insert r₀ ((fun y => r₀ ^ (m_fn y) * y) '' (S_gen : Set E_R))
    have hG_fin : G_set.Finite :=
      ((S_gen.finite_toSet).image (fun y => r₀ ^ (m_fn y) * y)).insert r₀
    have hG_int : ∀ x ∈ G_set, IsIntegral R x := by
      rintro x (rfl | ⟨y, _, rfl⟩)
      · exact hr₀_int
      · exact hm_fn y
    let R₁ : Subalgebra R E_q := Algebra.adjoin R (ι_q '' G_set)
    have _ : Algebra.FiniteType R ↥R₁ := Algebra.FiniteType.adjoin_of_finite (hG_fin.image ι_q)
    have _ : Algebra.IsIntegral R ↥R₁ := by
      let Int_sub : Subalgebra R E_q := (integralClosure R ↥R₁).map R₁.val
      have hle : R₁ ≤ Int_sub := by
        rw [Algebra.adjoin_le_iff]
        rintro _ ⟨x, hxG, rfl⟩
        have hx_mem : ι_q x ∈ R₁ := Algebra.subset_adjoin ⟨x, hxG, rfl⟩
        have hx_int_Eq : IsIntegral R (ι_q x) := (hG_int x hxG).map ι_q
        have hx_int_R₁ : IsIntegral R (⟨ι_q x, hx_mem⟩ : ↥R₁) := by
          rcases hx_int_Eq with ⟨p, hp_monic, hp_eval⟩
          refine ⟨p, hp_monic, Subtype.ext ?_⟩
          have hp_val : R₁.val (Polynomial.aeval (⟨ι_q x, hx_mem⟩ : ↥R₁) p) = 0 := by
            rw [← Polynomial.aeval_algHom_apply]
            exact hp_eval
          exact hp_val
        exact ⟨⟨ι_q x, hx_mem⟩, hx_int_R₁, rfl⟩
      refine ⟨fun y => ?_⟩
      obtain ⟨y', hy'_int, hy'_eq⟩ := hle y.2
      have hy_eq : y' = y := Subtype.ext hy'_eq
      rwa [hy_eq] at hy'_int
    have hFin_R₁ : Module.Finite R ↥R₁ := Algebra.IsIntegral.finite
    have hr₀_mem : ι_q r₀ ∈ R₁ := Algebra.subset_adjoin ⟨r₀, Set.mem_insert _ _, rfl⟩
    let r₀_R₁ : ↥R₁ := ⟨ι_q r₀, hr₀_mem⟩
    have hsat : ∀ x : E_R, ∃ m : ℕ, ι_q (r₀ ^ m * x) ∈ R₁ := by
      let Sub_sat : Subalgebra R E_R :=
        { carrier := {x : E_R | ∃ m : ℕ, ι_q (r₀ ^ m * x) ∈ R₁}
          mul_mem' := fun {x y} ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩ =>
            ⟨m₁ + m₂, by
              have h := R₁.mul_mem hm₁ hm₂
              have heq : r₀ ^ (m₁ + m₂) * (x * y) = (r₀ ^ m₁ * x) * (r₀ ^ m₂ * y) := by ring
              rw [heq, map_mul]
              exact h⟩
          one_mem' := ⟨0, by simp [R₁.one_mem]⟩
          add_mem' := fun {x y} ⟨m₁, hm₁⟩ ⟨m₂, hm₂⟩ =>
            ⟨m₁ + m₂, by
              have h1 := R₁.mul_mem (R₁.pow_mem hr₀_mem m₂) hm₁
              have h2 := R₁.mul_mem (R₁.pow_mem hr₀_mem m₁) hm₂
              have heq : ι_q (r₀ ^ (m₁ + m₂) * (x + y)) =
                  ι_q r₀ ^ m₂ * ι_q (r₀ ^ m₁ * x) + ι_q r₀ ^ m₁ * ι_q (r₀ ^ m₂ * y) := by
                have hring : r₀ ^ (m₁ + m₂) * (x + y) =
                    r₀ ^ m₂ * (r₀ ^ m₁ * x) + r₀ ^ m₁ * (r₀ ^ m₂ * y) := by ring
                rw [hring, map_add, map_mul ι_q (r₀ ^ m₂) (r₀ ^ m₁ * x),
                  map_mul ι_q (r₀ ^ m₁) (r₀ ^ m₂ * y), map_pow, map_pow]
              rw [heq]
              exact R₁.add_mem h1 h2⟩
          algebraMap_mem' := fun r => ⟨0, by simp [AlgHom.commutes, R₁.algebraMap_mem r]⟩ }
      have hle : Algebra.adjoin R (S_gen : Set E_R) ≤ Sub_sat := by
        rw [Algebra.adjoin_le_iff]
        intro y hy
        exact ⟨m_fn y, Algebra.subset_adjoin
          ⟨r₀ ^ (m_fn y) * y, Set.mem_insert_of_mem _ ⟨y, hy, rfl⟩, rfl⟩⟩
      intro x
      exact hle (hS_gen.symm ▸ Algebra.mem_top)
    let q₀ : Ideal ↥R₁ := Ideal.comap R₁.val.toRingHom (IsLocalRing.maximalIdeal E_q)
    have hIsLoc_R₁ : IsLocalization q₀.primeCompl E_q := by
      refine ⟨?_, ?_, ?_⟩
      · intro t
        exact IsLocalRing.notMem_maximalIdeal.mp t.2
      · intro z
        obtain ⟨⟨x, s⟩, hz⟩ := IsLocalization.surj q.primeCompl z
        obtain ⟨m₁, hm₁⟩ := hsat x
        obtain ⟨m₂, hm₂⟩ := hsat s.1
        let u_num : ↥R₁ := r₀_R₁ ^ m₂ * ⟨ι_q (r₀ ^ m₁ * x), hm₁⟩
        let u_den : ↥R₁ := r₀_R₁ ^ m₁ * ⟨ι_q (r₀ ^ m₂ * s.1), hm₂⟩
        have hu_den_val : (u_den : E_q) = ι_q (r₀ ^ (m₁ + m₂) * s.1) := by
          change (ι_q r₀) ^ m₁ * ι_q (r₀ ^ m₂ * s.1) = _
          rw [← map_pow, ← map_mul]
          congr 1; ring
        have hu_num_val : (u_num : E_q) = ι_q (r₀ ^ (m₁ + m₂) * x) := by
          change (ι_q r₀) ^ m₂ * ι_q (r₀ ^ m₁ * x) = _
          rw [← map_pow, ← map_mul]
          congr 1; ring
        have hu_den_not_q₀ : u_den ∉ q₀ := by
          change (u_den : E_q) ∉ IsLocalRing.maximalIdeal E_q
          rw [hu_den_val, show ι_q (r₀ ^ (m₁ + m₂) * s.1) =
              algebraMap E_R E_q (r₀ ^ (m₁ + m₂) * s.1) from rfl]
          intro hmem
          have hmem' : r₀ ^ (m₁ + m₂) * s.1 ∈
              Ideal.comap (algebraMap E_R E_q) (IsLocalRing.maximalIdeal E_q) := hmem
          rw [hmax_comap_E] at hmem'
          exact (q.primeCompl.mul_mem (q.primeCompl.pow_mem hr₀_not_q (m₁ + m₂)) s.2) hmem'
        refine ⟨⟨u_num, ⟨u_den, hu_den_not_q₀⟩⟩, ?_⟩
        change z * (u_den : E_q) = (u_num : E_q)
        rw [hu_den_val, hu_num_val, map_mul, map_pow, map_mul, map_pow]
        have hz' : z * ι_q s.1 = ι_q x := hz
        calc z * ((ι_q r₀) ^ (m₁ + m₂) * ι_q s.1)
            = (ι_q r₀) ^ (m₁ + m₂) * (z * ι_q s.1) := by ring
          _ = (ι_q r₀) ^ (m₁ + m₂) * ι_q x := by rw [hz']
      · intro a b hab
        exact ⟨1, by simp [Subtype.ext hab]⟩
    exact ⟨E_q, instCR_Eq, instLoc_Eq, algR_Eq, ι_q, σ_q, R₁,
      hInj, hLocHom, hMaxMap, hσ_ι, hσ_R, hKer_σ, hFin_R₁, hIsLoc_R₁⟩
  obtain ⟨E_q, instCR_Eq, instLoc_Eq, instAlg_Eq, ι_q, σ_q, R₁,
    hInj, hLocHom, hMaxMap, hσ_ι, hσ_R, hKer_σ, hFin_R₁, hIsLoc_R₁⟩ := hStep1
  let _ : CommRing E_q := instCR_Eq
  let _ : IsLocalRing E_q := instLoc_Eq
  let _ : Algebra R E_q := instAlg_Eq
  have _ : Module.Finite R ↥R₁ := hFin_R₁
  have _ : IsLocalization (Ideal.comap R₁.val.toRingHom (IsLocalRing.maximalIdeal E_q)).primeCompl E_q :=
    hIsLoc_R₁
  
  have hStep2 :
      ∃ (θ₀ : ↥R₁) (m : ℕ) (w : Fin (m + 1) → ↥R₁) (M : Matrix (Fin (m + 1)) (Fin (m + 1)) R),
        σ_q θ₀.1 = 1 ∧
        (θ₀ - 1 ∈ Ideal.map (algebraMap R ↥R₁) (IsLocalRing.maximalIdeal R) →
          Function.Surjective (algebraMap R E_q)) ∧
        w 0 = θ₀ ∧
        Submodule.span R (Set.range w) = ⊤ ∧
        (∀ i : Fin (m + 1), w 0 * w i = ∑ j : Fin (m + 1), algebraMap R ↥R₁ (M i j) * w j) ∧
        M 0 0 - 1 ∈ IsLocalRing.maximalIdeal R ∧
        (∀ i j : Fin (m + 1), ¬ (i = 0 ∧ j = 0) → M i j ∈ IsLocalRing.maximalIdeal R) := by
    let m_R : Ideal R := IsLocalRing.maximalIdeal R
    let res : R →+* IsLocalRing.ResidueField R := IsLocalRing.residue R
    let I₁ : Ideal ↥R₁ := Ideal.map (algebraMap R ↥R₁) m_R
    let q₀ : Ideal ↥R₁ := Ideal.comap R₁.val.toRingHom (IsLocalRing.maximalIdeal E_q)
    have hI₁_le_q₀ : I₁ ≤ q₀ := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      change algebraMap R E_q r ∈ IsLocalRing.maximalIdeal E_q
      rw [← hMaxMap]
      exact Ideal.mem_map_of_mem _ hr
    let F₀ : Type u := TensorProduct R (IsLocalRing.ResidueField R) ↥R₁
    let π : ↥R₁ →ₐ[R] F₀ := Algebra.TensorProduct.includeRight
    have _ : Module.Finite (IsLocalRing.ResidueField R) F₀ := inferInstance
    have _ : IsNoetherian (IsLocalRing.ResidueField R) F₀ := inferInstance
    have _ : IsNoetherianRing F₀ := isNoetherian_of_tower (IsLocalRing.ResidueField R) inferInstance
    have hπ_surj : Function.Surjective π := by
      intro z
      change z ∈ Set.range π
      refine TensorProduct.inductionOn (motive := fun w => w ∈ Set.range π) z ?_ ?_
      · intro c x
        obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective c
        refine ⟨r • x, ?_⟩
        change (1 : IsLocalRing.ResidueField R) ⊗ₜ[R] (r • x) = (res r) ⊗ₜ[R] x
        rw [← TensorProduct.smul_tmul]
        have hr : r • (1 : IsLocalRing.ResidueField R) = res r := by
          rw [Algebra.smul_def, mul_one]
          rfl
        rw [hr]
      · rintro u v ⟨x₁, hx₁⟩ ⟨x₂, hx₂⟩
        exact ⟨x₁ + x₂, by rw [map_add, hx₁, hx₂]⟩
    have hker_π : RingHom.ker π.toRingHom = I₁ := by
      apply le_antisymm
      · intro x hx
        have hφ_ker : ∀ r ∈ m_R, (Algebra.ofId R (↥R₁ ⧸ I₁)) r = 0 := by
          intro r hr
          change Ideal.Quotient.mk I₁ (algebraMap R ↥R₁ r) = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hr)
        let φ_κ : IsLocalRing.ResidueField R →ₐ[R] (↥R₁ ⧸ I₁) :=
          Ideal.Quotient.liftₐ m_R (Algebra.ofId R (↥R₁ ⧸ I₁)) hφ_ker
        let Ψ_quot : F₀ →ₐ[R] (↥R₁ ⧸ I₁) :=
          Algebra.TensorProduct.lift φ_κ (Ideal.Quotient.mkₐ R I₁) (fun _ _ => Commute.all _ _)
        have hΨ_pi : Ψ_quot (π x) = Ideal.Quotient.mk I₁ x := by
          dsimp [Ψ_quot, π]
          rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.lift_tmul,
            map_one, one_mul]
          rfl
        have hΨx : Ideal.Quotient.mk I₁ x = 0 := by
          rw [← hΨ_pi, show π x = 0 from hx, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mp hΨx
      · rw [Ideal.map_le_iff_le_comap]
        intro r hr
        change π (algebraMap R ↥R₁ r) = 0
        rw [AlgHom.commutes]
        change (res r) ⊗ₜ[R] (1 : ↥R₁) = 0
        have hres0 : res r = 0 := (IsLocalRing.residue_eq_zero_iff r).mpr hr
        rw [hres0, TensorProduct.zero_tmul]
    let qbar₀ : Ideal F₀ := Ideal.map π.toRingHom q₀
    have hqbar₀_comap : Ideal.comap π.toRingHom qbar₀ = q₀ := by
      have hπ_surj' : Function.Surjective π.toRingHom := hπ_surj
      rw [Ideal.comap_map_of_surjective' π.toRingHom hπ_surj' q₀, hker_π,
        sup_eq_left.mpr hI₁_le_q₀]
    let σ₁_ring : ↥R₁ →+* IsLocalRing.ResidueField R := σ_q.comp R₁.val.toRingHom
    have hσ₁_comm : ∀ r : R,
        σ₁_ring (algebraMap R ↥R₁ r) = algebraMap R (IsLocalRing.ResidueField R) r :=
      fun r => RingHom.congr_fun hσ_R r
    let σ₁_alg : ↥R₁ →ₐ[R] IsLocalRing.ResidueField R :=
      { σ₁_ring with commutes' := hσ₁_comm }
    let σ_bar₁ : F₀ →ₐ[IsLocalRing.ResidueField R] IsLocalRing.ResidueField R :=
      Algebra.TensorProduct.lift (AlgHom.id _ _) σ₁_alg (fun _ _ => Commute.all _ _)
    have hσbar₁_π : ∀ y : ↥R₁, σ_bar₁ (π y) = σ_q y.1 := by
      intro y
      change (Algebra.TensorProduct.lift (AlgHom.id _ _) σ₁_alg _)
          ((1 : IsLocalRing.ResidueField R) ⊗ₜ[R] y) = σ_q y.1
      rw [Algebra.TensorProduct.lift_tmul, AlgHom.id_apply, one_mul]
      rfl
    have hker_σbar₁ : RingHom.ker σ_bar₁.toRingHom = qbar₀ := by
      ext z
      obtain ⟨y, rfl⟩ := hπ_surj z
      change σ_bar₁ (π y) = 0 ↔ π y ∈ qbar₀
      rw [hσbar₁_π y]
      have h1 : σ_q y.1 = 0 ↔ y ∈ q₀ := by
        change y.1 ∈ RingHom.ker σ_q ↔ y.1 ∈ IsLocalRing.maximalIdeal E_q
        rw [hKer_σ]
      rw [h1, ← hqbar₀_comap]
      rfl
    have hclear_Eq : ∀ x ∈ IsLocalRing.maximalIdeal E_q,
        ∃ (t : q₀.primeCompl) (u : ↥R₁), u ∈ I₁ ∧ (t.1 : E_q) * x = (u : E_q) := by
      intro x hx
      rw [← hMaxMap] at hx
      refine Submodule.span_induction
        (p := fun x _ => ∃ (t : q₀.primeCompl) (u : ↥R₁), u ∈ I₁ ∧ (t.1 : E_q) * x = (u : E_q))
        ?_ ⟨1, 0, I₁.zero_mem, by simp⟩
        (fun x₁ x₂ _ _ ⟨t₁, u₁, hu₁, ht₁⟩ ⟨t₂, u₂, hu₂, ht₂⟩ => ?_)
        (fun c x₁ _ ⟨t₁, u₁, hu₁, ht₁⟩ => ?_) hx
      · rintro _ ⟨r, hr, rfl⟩
        refine ⟨1, algebraMap R ↥R₁ r, Ideal.mem_map_of_mem _ hr, ?_⟩
        simp
      · refine ⟨t₁ * t₂, t₂.1 * u₁ + t₁.1 * u₂,
          I₁.add_mem (I₁.mul_mem_left t₂.1 hu₁) (I₁.mul_mem_left t₁.1 hu₂), ?_⟩
        push_cast
        calc ((t₁.1 : E_q) * (t₂.1 : E_q)) * (x₁ + x₂)
            = (t₂.1 : E_q) * ((t₁.1 : E_q) * x₁) + (t₁.1 : E_q) * ((t₂.1 : E_q) * x₂) := by ring
          _ = (t₂.1 : E_q) * (u₁ : E_q) + (t₁.1 : E_q) * (u₂ : E_q) := by rw [ht₁, ht₂]
      · obtain ⟨⟨y, t₂⟩, hc⟩ := IsLocalization.surj q₀.primeCompl c
        have hc' : c * (t₂.1 : E_q) = (y : E_q) := hc
        refine ⟨t₁ * t₂, y * u₁, I₁.mul_mem_left y hu₁, ?_⟩
        push_cast
        calc ((t₁.1 : E_q) * (t₂.1 : E_q)) * (c • x₁)
            = (c * (t₂.1 : E_q)) * ((t₁.1 : E_q) * x₁) := by rw [smul_eq_mul]; ring
          _ = (y : E_q) * (u₁ : E_q) := by rw [hc', ht₁]
    have hclear_q₀ : ∀ y ∈ q₀, ∃ t : q₀.primeCompl, t.1 * y ∈ I₁ := by
      intro y hy
      obtain ⟨t, u, hu, htu⟩ := hclear_Eq y.1 hy
      have heq : t.1 * y = u := Subtype.ext htu
      exact ⟨t, heq ▸ hu⟩
    have hqbar₀_fg : qbar₀.FG := IsNoetherian.noetherian qbar₀
    obtain ⟨r_gen, g_bar, hg_span⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hqbar₀_fg
    let g_lift : Fin r_gen → ↥R₁ := fun k => Classical.choose (hπ_surj (g_bar k))
    have hg_lift_π : ∀ k : Fin r_gen, π (g_lift k) = g_bar k :=
      fun k => Classical.choose_spec (hπ_surj (g_bar k))
    have hg_lift_q₀ : ∀ k : Fin r_gen, g_lift k ∈ q₀ := by
      intro k
      rw [← hqbar₀_comap]
      change π (g_lift k) ∈ qbar₀
      rw [hg_lift_π k, ← hg_span]
      exact Submodule.subset_span ⟨k, rfl⟩
    let t_fn : Fin r_gen → q₀.primeCompl :=
      fun k => Classical.choose (hclear_q₀ (g_lift k) (hg_lift_q₀ k))
    have ht_fn : ∀ k : Fin r_gen, (t_fn k).1 * g_lift k ∈ I₁ :=
      fun k => Classical.choose_spec (hclear_q₀ (g_lift k) (hg_lift_q₀ k))
    let T_val : ↥R₁ := ∏ k : Fin r_gen, (t_fn k).1
    have hT_mem : T_val ∈ q₀.primeCompl :=
      Submonoid.prod_mem q₀.primeCompl (fun k _ => (t_fn k).2)
    let s : F₀ := π T_val
    have hs_gen_ann : ∀ k : Fin r_gen, s * g_bar k = 0 := by
      intro k
      obtain ⟨q_k, hq_k⟩ :=
        Finset.dvd_prod_of_mem (fun i : Fin r_gen => (t_fn i).1) (Finset.mem_univ k)
      have hmem_I₁ : T_val * g_lift k ∈ I₁ := by
        have hcalc : T_val * g_lift k = q_k * ((t_fn k).1 * g_lift k) := by
          change (∏ i : Fin r_gen, (t_fn i).1) * g_lift k = _
          rw [hq_k]
          ring
        rw [hcalc]
        exact I₁.mul_mem_left q_k (ht_fn k)
      rw [← hg_lift_π k]
      change π T_val * π (g_lift k) = 0
      rw [← map_mul]
      rw [← hker_π] at hmem_I₁
      exact hmem_I₁
    have hs_ann : ∀ z ∈ qbar₀, s * z = 0 := by
      intro z hz
      rw [← hg_span] at hz
      refine Submodule.span_induction
        (p := fun z _ => s * z = 0)
        ?_ (mul_zero s)
        (fun u v _ _ hu hv => by rw [mul_add, hu, hv, add_zero])
        (fun a u _ hu => by
          change s * (a * u) = 0
          calc s * (a * u) = a * (s * u) := by ring
            _ = 0 := by rw [hu, mul_zero]) hz
      rintro _ ⟨k, rfl⟩
      exact hs_gen_ann k
    have hσs_ne : σ_bar₁ s ≠ 0 := by
      intro h0
      have hs_mem : s ∈ qbar₀ := by
        rw [← hker_σbar₁]
        exact h0
      have hT_q₀ : T_val ∈ q₀ := by
        rw [← hqbar₀_comap]
        exact hs_mem
      exact hT_mem hT_q₀
    let e₀ : F₀ := (σ_bar₁ s)⁻¹ • s
    have hσ_e₀ : σ_bar₁ e₀ = 1 := by
      dsimp [e₀]
      rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hσs_ne]
    have he₀_sub_mem : e₀ - 1 ∈ qbar₀ := by
      rw [← hker_σbar₁, RingHom.mem_ker]
      change σ_bar₁ (e₀ - 1) = 0
      rw [map_sub, map_one, hσ_e₀, sub_self]
    have he₀_ann : ∀ z ∈ qbar₀, e₀ * z = 0 := by
      intro z hz
      dsimp [e₀]
      rw [smul_mul_assoc, hs_ann z hz, smul_zero]
    have he₀_idem : e₀ * e₀ = e₀ := by
      have h0 : e₀ * (e₀ - 1) = 0 := he₀_ann (e₀ - 1) he₀_sub_mem
      rw [mul_sub, mul_one] at h0
      exact sub_eq_zero.mp h0
    let θ₀ : ↥R₁ := Classical.choose (hπ_surj e₀)
    have hπ_θ₀ : π θ₀ = e₀ := Classical.choose_spec (hπ_surj e₀)
    have hσ_θ₀ : σ_q θ₀.1 = 1 := by
      rw [← hσbar₁_π θ₀, hπ_θ₀, hσ_e₀]
    have hmR_jac : m_R ≤ (⊥ : Ideal R).jacobson := by
      intro r hr
      rw [Ideal.mem_jacobson_bot]
      intro y
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hmem
      have h1 : (1 : R) ∈ m_R := by
        have hsub := m_R.sub_mem hmem (m_R.mul_mem_right y hr)
        rwa [add_sub_cancel_left] at hsub
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top
        (Ideal.eq_top_of_isUnit_mem m_R h1 isUnit_one)
    have hI₁_smul : ∀ x ∈ I₁, x ∈ m_R • (⊤ : Submodule R ↥R₁) := by
      intro x hx
      refine Submodule.span_induction
        (p := fun x _ => x ∈ m_R • (⊤ : Submodule R ↥R₁))
        ?_ (Submodule.zero_mem _)
        (fun _ _ _ _ ha hb => Submodule.add_mem _ ha hb)
        (fun a z _ hz => ?_) hx
      · rintro _ ⟨r, hr, rfl⟩
        rw [show algebraMap R ↥R₁ r = r • (1 : ↥R₁) by rw [Algebra.smul_def, mul_one]]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
      · refine Submodule.smul_induction_on hz ?_
          (fun _ _ hu hv => by rw [smul_add]; exact Submodule.add_mem _ hu hv)
        intro r hr y _
        change a * (r • y) ∈ m_R • (⊤ : Submodule R ↥R₁)
        rw [mul_smul_comm]
        exact Submodule.smul_mem_smul hr Submodule.mem_top
    have hSurj_of_one : θ₀ - 1 ∈ I₁ → Function.Surjective (algebraMap R E_q) := by
      intro hθ_one
      have he₀_one : e₀ = 1 := by
        have h0 : π (θ₀ - 1) = 0 := by rwa [← hker_π] at hθ_one
        rw [map_sub, map_one, hπ_θ₀] at h0
        exact sub_eq_zero.mp h0
      have hqbar₀_bot : qbar₀ = ⊥ := by
        rw [eq_bot_iff]
        intro z hz
        have h0 := he₀_ann z hz
        rwa [he₀_one, one_mul] at h0
      let S_one : Submodule R ↥R₁ := Submodule.span R {(1 : ↥R₁)}
      have hS_one_top : (⊤ : Submodule R ↥R₁) ≤ S_one := by
        refine Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hmR_jac ?_
        intro y _
        obtain ⟨r, hr⟩ := IsLocalRing.residue_surjective (σ_bar₁ (π y))
        have hr_mem : r • (1 : ↥R₁) ∈ S_one :=
          Submodule.smul_mem S_one r (Submodule.subset_span (Set.mem_singleton _))
        have hdiff_I₁ : y - r • (1 : ↥R₁) ∈ I₁ := by
          rw [← hker_π, RingHom.mem_ker]
          change π (y - r • (1 : ↥R₁)) = 0
          have hπ_r : π (r • (1 : ↥R₁)) = algebraMap (IsLocalRing.ResidueField R) F₀ (σ_bar₁ (π y)) := by
            rw [Algebra.smul_def, mul_one, AlgHom.commutes]
            change algebraMap (IsLocalRing.ResidueField R) F₀ (res r) = _
            rw [hr]
          have hmem_ker : π (y - r • (1 : ↥R₁)) ∈ RingHom.ker σ_bar₁.toRingHom := by
            change σ_bar₁ (π (y - r • (1 : ↥R₁))) = 0
            rw [map_sub, map_sub, hπ_r, AlgHom.commutes σ_bar₁ (σ_bar₁ (π y))]
            exact sub_self _
          rw [hker_σbar₁, hqbar₀_bot, Ideal.mem_bot] at hmem_ker
          exact hmem_ker
        have h_eq : y = r • (1 : ↥R₁) + (y - r • (1 : ↥R₁)) := (add_sub_cancel _ _).symm
        rw [h_eq]
        exact Submodule.add_mem_sup hr_mem (hI₁_smul _ hdiff_I₁)
      have hSurj_R₁ : Function.Surjective (algebraMap R ↥R₁) := by
        intro y
        have hy : y ∈ S_one := hS_one_top Submodule.mem_top
        rw [Submodule.mem_span_singleton] at hy
        rcases hy with ⟨r, hr⟩
        rw [Algebra.smul_def, mul_one] at hr
        exact ⟨r, hr⟩
      intro z
      obtain ⟨⟨y, t⟩, hz⟩ := IsLocalization.surj q₀.primeCompl z
      obtain ⟨r_y, hry⟩ := hSurj_R₁ y
      obtain ⟨r_t, hrt⟩ := hSurj_R₁ t.1
      have hrt_Eq : algebraMap R E_q r_t = (t.1 : E_q) := congrArg Subtype.val hrt
      have hry_Eq : algebraMap R E_q r_y = (y : E_q) := congrArg Subtype.val hry
      have ht_unit : IsUnit (algebraMap R E_q r_t) := by
        rw [hrt_Eq]
        exact IsLocalization.map_units E_q t
      have hrt_unit : IsUnit r_t := hLocHom.map_nonunit r_t ht_unit
      let u_t : Rˣ := hrt_unit.unit
      have hu_t : (u_t : R) = r_t := by simp [u_t]
      refine ⟨r_y * ↑(u_t⁻¹), ?_⟩
      apply ht_unit.mul_right_cancel
      have hz' : z * algebraMap R E_q r_t = algebraMap R E_q r_y := by
        rw [hrt_Eq, hry_Eq]
        exact hz
      rw [hz', ← map_mul, mul_assoc, ← hu_t, Units.inv_mul, mul_one]
    let Q_mod : Submodule (IsLocalRing.ResidueField R) F₀ := qbar₀.restrictScalars _
    have hQ_fg : Q_mod.FG := IsNoetherian.noetherian Q_mod
    obtain ⟨m, u_bar, hu_span⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hQ_fg
    have hu_ann : ∀ j : Fin m, e₀ * u_bar j = 0 := by
      intro j
      have hj : u_bar j ∈ Q_mod := hu_span ▸ Submodule.subset_span ⟨j, rfl⟩
      exact he₀_ann (u_bar j) hj
    let w_bar : Fin (m + 1) → F₀ := Fin.cons e₀ u_bar
    have hwbar_span : Submodule.span (IsLocalRing.ResidueField R) (Set.range w_bar) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      let c : IsLocalRing.ResidueField R := σ_bar₁ x
      have hrem_mem : x - c • e₀ ∈ Q_mod := by
        change x - c • e₀ ∈ qbar₀
        rw [← hker_σbar₁, RingHom.mem_ker]
        change σ_bar₁ (x - c • e₀) = 0
        rw [map_sub, map_smul, hσ_e₀, smul_eq_mul, mul_one, sub_self]
      rw [← hu_span] at hrem_mem
      have hx_eq : x = c • e₀ + (x - c • e₀) := (add_sub_cancel _ _).symm
      rw [hx_eq]
      refine Submodule.add_mem _ ?_ ?_
      · refine Submodule.smul_mem _ c (Submodule.subset_span ⟨0, ?_⟩)
        exact @Fin.cons_zero m (fun _ => F₀) e₀ u_bar
      · refine Submodule.span_mono ?_ hrem_mem
        rintro _ ⟨j, rfl⟩
        exact ⟨j.succ, @Fin.cons_succ m (fun _ => F₀) e₀ u_bar j⟩
    have hspan_lin : ∀ {K M_mod : Type u} [CommRing K] [AddCommGroup M_mod] [Module K M_mod]
        {n : ℕ} (f_gen : Fin n → M_mod) (z : M_mod),
        z ∈ Submodule.span K (Set.range f_gen) →
        ∃ c : Fin n → K, z = ∑ i : Fin n, c i • f_gen i := by
      intro K M_mod _ _ _ n f_gen z hz
      refine Submodule.span_induction
        (p := fun z _ => ∃ c : Fin n → K, z = ∑ i : Fin n, c i • f_gen i)
        ?_ ⟨0, by simp⟩
        (fun _ _ _ _ ⟨c₁, hc₁⟩ ⟨c₂, hc₂⟩ =>
          ⟨c₁ + c₂, by simp [hc₁, hc₂, Pi.add_apply, add_smul, Finset.sum_add_distrib]⟩)
        (fun a _ _ ⟨c, hc⟩ =>
          ⟨fun i => a * c i, by simp [hc, Finset.smul_sum, mul_smul]⟩) hz
      rintro _ ⟨j, rfl⟩
      refine ⟨fun i => if i = j then 1 else 0, ?_⟩
      rw [Finset.sum_eq_single j]
      · simp
      · intro b _ hb
        simp [hb]
      · intro hj
        exact absurd (Finset.mem_univ j) hj
    let u_lift : Fin m → ↥R₁ := fun j => Classical.choose (hπ_surj (u_bar j))
    have hu_lift_π : ∀ j : Fin m, π (u_lift j) = u_bar j :=
      fun j => Classical.choose_spec (hπ_surj (u_bar j))
    let w : Fin (m + 1) → ↥R₁ := Fin.cons θ₀ u_lift
    have hw0 : w 0 = θ₀ := @Fin.cons_zero m (fun _ => ↥R₁) θ₀ u_lift
    have hw_π : ∀ i : Fin (m + 1), π (w i) = w_bar i := by
      intro i
      refine Fin.cases ?_ ?_ i
      · dsimp [w, w_bar]
        rw [Fin.cons_zero, Fin.cons_zero, hπ_θ₀]
      · intro j
        dsimp [w, w_bar]
        rw [Fin.cons_succ, Fin.cons_succ, hu_lift_π j]
    let S_w : Submodule R ↥R₁ := Submodule.span R (Set.range w)
    have hSw_top : S_w = ⊤ := by
      apply top_unique
      refine Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hmR_jac ?_
      intro x _
      obtain ⟨c, hc⟩ := hspan_lin w_bar (π x) (hwbar_span.symm ▸ Submodule.mem_top)
      let r_fn : Fin (m + 1) → R := fun i => Classical.choose (IsLocalRing.residue_surjective (c i))
      have hr_fn : ∀ i : Fin (m + 1), res (r_fn i) = c i :=
        fun i => Classical.choose_spec (IsLocalRing.residue_surjective (c i))
      let x' : ↥R₁ := ∑ i : Fin (m + 1), r_fn i • w i
      have hx'_mem : x' ∈ S_w :=
        Submodule.sum_mem S_w (fun i _ => Submodule.smul_mem S_w (r_fn i) (Submodule.subset_span ⟨i, rfl⟩))
      have hdiff_ker : x - x' ∈ I₁ := by
        rw [← hker_π, RingHom.mem_ker]
        change π (x - x') = 0
        rw [map_sub, hc]
        dsimp [x']
        rw [map_sum]
        have hsum_eq :
            (∑ i : Fin (m + 1), π (r_fn i • w i)) = ∑ i : Fin (m + 1), c i • w_bar i := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          change π.toRingHom (r_fn i • w i) = c i • w_bar i
          rw [Algebra.smul_def (r_fn i) (w i), map_mul]
          have h1 : π.toRingHom (algebraMap R ↥R₁ (r_fn i)) =
              algebraMap (IsLocalRing.ResidueField R) F₀ (c i) := by
            rw [← hr_fn i]
            exact π.commutes (r_fn i)
          have hc1_bar : algebraMap (IsLocalRing.ResidueField R) F₀ (c i) = c i • (1 : F₀) := by
            change c i ⊗ₜ[R] (1 : ↥R₁) = (c i * 1) ⊗ₜ[R] (1 : ↥R₁)
            rw [mul_one]
          rw [h1, show π.toRingHom (w i) = π (w i) from rfl, hw_π i, hc1_bar,
            smul_mul_assoc, one_mul]
        rw [hsum_eq, sub_self]
      have hx_split : x = x' + (x - x') := (add_sub_cancel x' x).symm
      rw [hx_split]
      exact Submodule.add_mem_sup hx'_mem (hI₁_smul (x - x') hdiff_ker)
    have hI₁_lin : ∀ z ∈ I₁, ∃ d : Fin (m + 1) → R,
        (∀ j : Fin (m + 1), d j ∈ m_R) ∧ z = ∑ j : Fin (m + 1), d j • w j := by
      intro z hz
      have hz_smul : z ∈ m_R • S_w := by
        rw [hSw_top]
        exact hI₁_smul z hz
      refine Submodule.smul_induction_on hz_smul ?_ ?_
      · intro r hr y hy
        obtain ⟨c, rfl⟩ := hspan_lin w y hy
        refine ⟨fun j => r * c j, fun j => m_R.mul_mem_right (c j) hr, ?_⟩
        simp [Finset.smul_sum, mul_smul]
      · rintro _ _ ⟨d₁, hd₁, rfl⟩ ⟨d₂, hd₂, rfl⟩
        exact ⟨fun j => d₁ j + d₂ j, fun j => m_R.add_mem (hd₁ j) (hd₂ j),
          by simp [add_smul, Finset.sum_add_distrib]⟩
    have hrel_π : ∀ i : Fin (m + 1),
        w 0 * w i - (if i = 0 then w 0 else 0) ∈ I₁ := by
      intro i
      rw [← hker_π, RingHom.mem_ker]
      change π (w 0 * w i - if i = 0 then w 0 else 0) = 0
      rw [map_sub, map_mul, hw_π 0]
      refine Fin.cases ?_ ?_ i
      · simp only [ ↓reduceIte, hw_π 0]
        dsimp [w_bar]
        rw [Fin.cons_zero, he₀_idem, sub_self]
      · intro j
        simp only [Fin.succ_ne_zero j, ↓reduceIte, map_zero, sub_zero, hw_π j.succ]
        dsimp [w_bar]
        rw [Fin.cons_zero, Fin.cons_succ, hu_ann j]
    let d_mat : Fin (m + 1) → Fin (m + 1) → R :=
      fun i => Classical.choose (hI₁_lin _ (hrel_π i))
    have hd_spec : ∀ i : Fin (m + 1),
        (∀ j : Fin (m + 1), d_mat i j ∈ m_R) ∧
        w 0 * w i - (if i = 0 then w 0 else 0) = ∑ j : Fin (m + 1), d_mat i j • w j :=
      fun i => Classical.choose_spec (hI₁_lin _ (hrel_π i))
    let M : Matrix (Fin (m + 1)) (Fin (m + 1)) R :=
      Matrix.of (fun i j => (if i = 0 ∧ j = 0 then (1 : R) else 0) + d_mat i j)
    have hM_mul : ∀ i : Fin (m + 1),
        w 0 * w i = ∑ j : Fin (m + 1), algebraMap R ↥R₁ (M i j) * w j := by
      intro i
      have h1 := (hd_spec i).2
      have h2 : w 0 * w i = (if i = 0 then w 0 else 0) + ∑ j : Fin (m + 1), d_mat i j • w j := by
        rw [sub_eq_iff_eq_add.mp h1, add_comm]
      have h_ite : (if i = 0 then w 0 else 0) =
          ∑ j : Fin (m + 1), (if i = 0 ∧ j = 0 then (1 : R) else 0) • w j := by
        by_cases hi : i = 0
        · subst hi
          simp only [↓reduceIte, true_and]
          rw [Finset.sum_eq_single 0]
          · simp
          · intro b _ hb
            simp [hb]
          · intro h0
            exact absurd (Finset.mem_univ 0) h0
        · simp only [hi, ↓reduceIte, false_and, zero_smul, Finset.sum_const_zero]
      rw [h2, h_ite, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← add_smul, Algebra.smul_def]
      rfl
    have hM_00 : M 0 0 - 1 ∈ m_R := by
      change ((if (0 : Fin (m + 1)) = 0 ∧ (0 : Fin (m + 1)) = 0 then (1 : R) else 0) +
        d_mat 0 0) - 1 ∈ m_R
      simp only [and_self, ↓reduceIte, add_sub_cancel_left]
      exact (hd_spec 0).1 0
    have hM_off : ∀ i j : Fin (m + 1), ¬ (i = 0 ∧ j = 0) → M i j ∈ m_R := by
      intro i j hij
      change (if i = 0 ∧ j = 0 then (1 : R) else 0) + d_mat i j ∈ m_R
      simp only [hij, ↓reduceIte, zero_add]
      exact (hd_spec i).1 j
    exact ⟨θ₀, m, w, M, hσ_θ₀, hSurj_of_one, hw0, hSw_top, hM_mul, hM_00, hM_off⟩
  obtain ⟨θ₀, m, w, M, hσ_θ₀, hSurj_of_one, hw0, hw_span, hM_mul, hM_00, hM_off⟩ := hStep2
  
  have hStep3 :
      ∃ (a : R) (Q : Polynomial R),
        a - 1 ∈ IsLocalRing.maximalIdeal R ∧
        Q.map (IsLocalRing.residue R) = Polynomial.X ^ m ∧
        (w 0 - algebraMap R ↥R₁ a) * Polynomial.aeval (w 0) Q = 0 := by
    let κ : Type u := IsLocalRing.ResidueField R
    let m_R : Ideal R := IsLocalRing.maximalIdeal R
    let res : R →+* κ := IsLocalRing.residue R
    let P : Polynomial R := M.charpoly
    have hP_aeval : Polynomial.aeval (w 0) P = 0 := by
      let ev_0 : Polynomial R →+* ↥R₁ := (Polynomial.aeval (w 0)).toRingHom
      have hdet_map : Polynomial.aeval (w 0) P =
          (ev_0.mapMatrix (Matrix.charmatrix M)).det :=
        RingHom.map_det ev_0 (Matrix.charmatrix M)
      rw [hdet_map]
      let B : Matrix (Fin (m + 1)) (Fin (m + 1)) ↥R₁ := ev_0.mapMatrix (Matrix.charmatrix M)
      have hB_entry : ∀ i j : Fin (m + 1),
          B i j = (if i = j then w 0 else 0) - algebraMap R ↥R₁ (M i j) := by
        intro i j
        simp only [B, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.charmatrix_apply]
        by_cases hij : i = j
        · subst hij
          simp [ev_0]
        · rw [Matrix.diagonal_apply_ne _ hij]
          simp [hij, ev_0]
      have hB_mulVec : B.mulVec w = 0 := by
        ext i
        simp only [Matrix.mulVec, dotProduct, Pi.zero_apply]
        have h_term : ∀ j : Fin (m + 1),
            B i j * w j = (if i = j then w 0 * w j else 0) - algebraMap R ↥R₁ (M i j) * w j := by
          intro j
          rw [hB_entry i j, sub_mul]
          by_cases hij : i = j <;> simp [hij]
        simp_rw [h_term, Finset.sum_sub_distrib]
        have hdiag : (∑ j : Fin (m + 1), if i = j then w 0 * w j else 0) = w 0 * w i := by
          rw [Finset.sum_eq_single i]
          · simp
          · intro b _ hb
            simp [Ne.symm hb]
          · intro hi
            exact absurd (Finset.mem_univ i) hi
        rw [hdiag, hM_mul i, sub_self]
      have hdet_ann : ∀ j : Fin (m + 1), B.det * w j = 0 := by
        intro j
        have h1 : ((B.adjugate * B).mulVec w) j = 0 := by
          rw [← Matrix.mulVec_mulVec, hB_mulVec, Matrix.mulVec_zero, Pi.zero_apply]
        rw [Matrix.adjugate_mul] at h1
        have hsmul : ((B.det • (1 : Matrix (Fin (m + 1)) (Fin (m + 1)) ↥R₁)).mulVec w) j =
            B.det * w j := by
          simp [Matrix.mulVec, dotProduct, Matrix.one_apply]
        rwa [hsmul] at h1
      have h1_mem : (1 : ↥R₁) ∈ Submodule.span R (Set.range w) :=
        hw_span.symm ▸ Submodule.mem_top
      have hdet_mul_mem : ∀ z ∈ Submodule.span R (Set.range w), B.det * z = 0 := by
        intro z hz
        refine Submodule.span_induction
          (p := fun z _ => B.det * z = 0)
          ?_ (mul_zero B.det)
          (fun u v _ _ hu hv => by rw [mul_add, hu, hv, add_zero])
          (fun r u _ hu => by rw [mul_smul_comm, hu, smul_zero]) hz
        rintro _ ⟨j, rfl⟩
        exact hdet_ann j
      change B.det = 0
      have hdet1 := hdet_mul_mem 1 h1_mem
      rwa [mul_one] at hdet1
    have hP_map_res : P.map res = (Polynomial.X - 1) * Polynomial.X ^ m := by
      dsimp [P]
      rw [← Matrix.charpoly_map M res]
      have hM_res : M.map res = Matrix.diagonal (Fin.cons (1 : κ) (fun _ : Fin m => 0)) := by
        ext i j
        simp only [Matrix.map_apply, Matrix.diagonal_apply]
        refine Fin.cases ?_ ?_ i
        · refine Fin.cases ?_ ?_ j
          · simp only [↓reduceIte, Fin.cons_zero]
            have h0 : res (M 0 0 - 1) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hM_00
            rw [map_sub, map_one] at h0
            exact sub_eq_zero.mp h0
          · intro j'
            simp only [(Fin.succ_ne_zero j').symm, ↓reduceIte]
            exact (IsLocalRing.residue_eq_zero_iff _).mpr
              (hM_off 0 j'.succ (fun h => Fin.succ_ne_zero j' h.2))
        · intro i'
          refine Fin.cases ?_ ?_ j
          · simp only [Fin.succ_ne_zero i', ↓reduceIte]
            exact (IsLocalRing.residue_eq_zero_iff _).mpr
              (hM_off i'.succ 0 (fun h => Fin.succ_ne_zero i' h.1))
          · intro j'
            have h0 : res (M i'.succ j'.succ) = 0 :=
              (IsLocalRing.residue_eq_zero_iff _).mpr
                (hM_off i'.succ j'.succ (fun h => Fin.succ_ne_zero i' h.1))
            rw [h0]
            by_cases hij : i'.succ = j'.succ
            · simp [hij]
            · simp [hij]
      rw [hM_res, Matrix.charpoly_diagonal, Fin.prod_univ_succ]
      simp
    have hP_eval1 : P.eval 1 ∈ m_R := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      change res (P.eval 1) = 0
      rw [← Polynomial.eval_map_apply, hP_map_res]
      simp
    have hP_deriv1 : IsUnit (P.derivative.eval 1) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hmem
      have h0 : res (P.derivative.eval 1) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hmem
      have hderiv_res : res (P.derivative.eval 1) = 1 := by
        have hderiv_map : (P.derivative).map res = (P.map res).derivative :=
          (Polynomial.derivative_map P res).symm
        rw [← Polynomial.eval_map_apply, hderiv_map, hP_map_res, Polynomial.derivative_mul]
        simp
      rw [hderiv_res] at h0
      exact one_ne_zero h0
    obtain ⟨a, ha_root, ha_mem⟩ :=
      HenselianLocalRing.is_henselian P M.charpoly_monic 1 hP_eval1 hP_deriv1
    have hres_a : res a = 1 := by
      have h0 : res (a - 1) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr ha_mem
      rw [map_sub, map_one] at h0
      exact sub_eq_zero.mp h0
    obtain ⟨Q, hP_fac⟩ := Polynomial.dvd_iff_isRoot.mpr ha_root
    have hQ_map : Q.map res = Polynomial.X ^ m := by
      have hfac_res := congrArg (Polynomial.map res) hP_fac
      rw [hP_map_res, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X,
        Polynomial.map_C, hres_a, Polynomial.C_1] at hfac_res
      have hX1_ne : (Polynomial.X - 1 : Polynomial κ) ≠ 0 := Polynomial.X_sub_C_ne_zero 1
      exact mul_left_cancel₀ hX1_ne hfac_res.symm
    have hAnn : (w 0 - algebraMap R ↥R₁ a) * Polynomial.aeval (w 0) Q = 0 := by
      calc (w 0 - algebraMap R ↥R₁ a) * Polynomial.aeval (w 0) Q
          = Polynomial.aeval (w 0) ((Polynomial.X - Polynomial.C a) * Q) := by
              rw [map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]
        _ = Polynomial.aeval (w 0) P := by rw [← hP_fac]
        _ = 0 := hP_aeval
    exact ⟨a, Q, ha_mem, hQ_map, hAnn⟩
  obtain ⟨a, Q, ha_mem, hQ_map, hAnn⟩ := hStep3
  
  rw [hw0] at hAnn
  have hAnn_Eq : (θ₀.1 - algebraMap R E_q a) * Polynomial.aeval θ₀.1 Q = 0 := by
    have hval := congrArg R₁.val hAnn
    rw [map_mul, map_sub, AlgHom.commutes, ← Polynomial.aeval_algHom_apply R₁.val θ₀ Q,
      map_zero] at hval
    exact hval
  have hσ_Q : σ_q (Polynomial.aeval θ₀.1 Q) = 1 := by
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂, hσ_R, hσ_θ₀, ← Polynomial.eval_map,
      hQ_map, Polynomial.eval_pow, Polynomial.eval_X, one_pow]
  have hu_Q : IsUnit (Polynomial.aeval θ₀.1 Q) := by
    rw [← IsLocalRing.notMem_maximalIdeal, ← hKer_σ, RingHom.mem_ker, hσ_Q]
    exact one_ne_zero
  have hθ₀_eq_a : θ₀.1 = algebraMap R E_q a := by
    have hsub0 : θ₀.1 - algebraMap R E_q a = 0 := hu_Q.mul_left_eq_zero.mp hAnn_Eq
    exact sub_eq_zero.mp hsub0
  have hθ₀_R₁ : θ₀ = algebraMap R ↥R₁ a := Subtype.ext hθ₀_eq_a
  have hθ₀_sub_mem : θ₀ - 1 ∈ Ideal.map (algebraMap R ↥R₁) (IsLocalRing.maximalIdeal R) := by
    rw [hθ₀_R₁, ← map_one (algebraMap R ↥R₁), ← map_sub]
    exact Ideal.mem_map_of_mem _ ha_mem
  have hSurj : Function.Surjective (algebraMap R E_q) := hSurj_of_one hθ₀_sub_mem
  let e_loc : R ≃ₐ[R] E_q := AlgEquiv.ofBijective (Algebra.ofId R E_q) ⟨hInj, hSurj⟩
  let σ : E_R →ₐ[R] R := e_loc.symm.toAlgHom.comp ι_q
  refine ⟨σ, ?_⟩
  ext x
  have he_σ : algebraMap R E_q (σ x) = ι_q x := e_loc.apply_symm_apply (ι_q x)
  calc IsLocalRing.residue R (σ x)
      = (σ_q.comp (algebraMap R E_q)) (σ x) := (RingHom.congr_fun hσ_R (σ x)).symm
    _ = σ_q (ι_q x) := by change σ_q (algebraMap R E_q (σ x)) = _; rw [he_σ]
    _ = σ_bar x := RingHom.congr_fun hσ_ι x

theorem weil_valuationRing_etale_nodal_roof_hypersurface_lift (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (A_R : Type u) [CommRing A_R] [Algebra R A_R] [Module.Flat R A_R] [Algebra.FinitePresentation R A_R]
    (B_bar : Type u) [CommRing B_bar]
    (ψ₁ : (A_R ⧸ Ideal.map (algebraMap R A_R) (IsLocalRing.maximalIdeal R)) →+* B_bar)
    (ψ₂ : (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
      Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B_bar)
    (ε₀ : B_bar →+* IsLocalRing.ResidueField R)
    (hEt₁ : RingHom.Etale ψ₁)
    (hEt₂ : RingHom.Etale ψ₂)
    (hCompat : ψ₁.comp ((Ideal.Quotient.mk _).comp (algebraMap R A_R)) =
      (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp (IsLocalRing.residue R))
    (hAug : ε₀.comp (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
      RingHom.id (IsLocalRing.ResidueField R))
    (hX₀ : ∀ i : Fin 2, ε₀ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))) = 0) :
    ∃ (S_R : Type u) (_ : CommRing S_R) (_ : Algebra R S_R)
      (φ_X : MvPolynomial (Fin 2) R →ₐ[R] S_R)
      (σ_bar : S_R →+* IsLocalRing.ResidueField R)
      (F : S_R)
      (σ_bar_quot : (S_R ⧸ Ideal.span {F}) →+* IsLocalRing.ResidueField R)
      (α_A : A_R →+* (S_R ⧸ Ideal.span {F})),
      RingHom.Etale φ_X.toRingHom ∧
      σ_bar.comp (algebraMap R S_R) = IsLocalRing.residue R ∧
      (∀ i : Fin 2, σ_bar (φ_X (MvPolynomial.X i)) = 0) ∧
      F - φ_X (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
        Ideal.map (algebraMap R S_R) (IsLocalRing.maximalIdeal R) ∧
      RingHom.Etale α_A ∧
      α_A.comp (algebraMap R A_R) =
        (Ideal.Quotient.mk (Ideal.span {F})).comp (algebraMap R S_R) ∧
      σ_bar_quot.comp (Ideal.Quotient.mk (Ideal.span {F})) = σ_bar ∧
      σ_bar_quot.comp α_A = ε₀.comp (ψ₁.comp (Ideal.Quotient.mk _)) :=
by
  
  have hSubPres : ∀ (R₀ T₀ : Type u) [CommRing R₀] [CommRing T₀] [Algebra R₀ T₀]
      [Algebra.Etale R₀ T₀],
      ∃ (m : ℕ), Nonempty (Algebra.SubmersivePresentation R₀ T₀ (Fin m) (Fin m)) := by
    intro R₀ T₀ _ _ _ _
    have hStd : Algebra.IsStandardSmoothOfRelativeDimension 0 R₀ T₀ :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
    obtain ⟨ι₀, σ₀, hFinσ, hFinι, P_raw, hDim⟩ := hStd.out
    have hLe : Nat.card σ₀ ≤ Nat.card ι₀ :=
      @Nat.card_le_card_of_injective σ₀ ι₀ hFinι P_raw.map P_raw.map_inj
    have hDimEq : Nat.card ι₀ - Nat.card σ₀ = 0 := hDim
    have hCardEq : Nat.card σ₀ = Nat.card ι₀ := by omega
    let e_ι : Fin (Nat.card ι₀) ≃ ι₀ := (@Finite.equivFin ι₀ hFinι).symm
    let e_σ : Fin (Nat.card ι₀) ≃ σ₀ :=
      (@Finite.equivFinOfCardEq σ₀ hFinσ (Nat.card ι₀) hCardEq).symm
    exact ⟨Nat.card ι₀, ⟨@Algebra.SubmersivePresentation.reindex R₀ T₀ ι₀ σ₀ _ _ _ hFinσ P_raw
      (Fin (Nat.card ι₀)) (Fin (Nat.card ι₀)) inferInstance e_ι e_σ⟩⟩

  
  have hEtNaiveAway : ∀ (B₀ Q' T' : Type u) [CommRing B₀] [CommRing Q'] [CommRing T']
      [Algebra B₀ Q'] [Algebra B₀ T'] [Algebra Q' T'] [IsScalarTower B₀ Q' T']
      (σ₀ : Type) [Fintype σ₀]
      (P_n : Algebra.PreSubmersivePresentation B₀ Q' σ₀ σ₀)
      [IsLocalization.Away P_n.jacobian T'],
      Algebra.Etale B₀ T' := by
    intro B₀ Q' T' _ _ _ _ _ _ _ σ₀ _ P_n _
    let L := Algebra.PreSubmersivePresentation.localizationAway T' P_n.jacobian
    let P_tot := L.comp P_n
    have hUnitΔ : IsUnit (algebraMap Q' T' P_n.jacobian) :=
      IsLocalization.Away.algebraMap_isUnit P_n.jacobian
    have hUnitJac : IsUnit P_tot.jacobian := by
      rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
        Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
      exact hUnitΔ.mul hUnitΔ
    let P_sub : Algebra.SubmersivePresentation B₀ T' (Unit ⊕ σ₀) (Unit ⊕ σ₀) :=
      { toPreSubmersivePresentation := P_tot
        jacobian_isUnit := hUnitJac }
    have hDimTot : P_sub.dimension = 0 := by
      change P_tot.dimension = 0
      rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension]
      have h1 : L.dimension = 0 := Nat.sub_self _
      have h2 : P_n.dimension = 0 := Nat.sub_self _
      omega
    exact Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr
      (P_sub.isStandardSmoothOfRelativeDimension hDimTot)

  
  have hStage1 : ∀ (A A_bar : Type u) [CommRing A] [CommRing A_bar]
      (q : A →+* A_bar) (_hq : Function.Surjective q)
      (ψ : A_bar →+* B_bar) (_hEt : RingHom.Etale ψ),
      ∃ (A' : Type u) (_ : CommRing A') (ι : A →+* A') (q' : A' →+* B_bar),
        RingHom.Etale ι ∧
        Function.Surjective q' ∧
        q'.comp ι = ψ.comp q ∧
        RingHom.ker q' = Ideal.map ι (RingHom.ker q) := by
    intro A A_bar _ _ q hq ψ hEt
    letI : Algebra A_bar B_bar := ψ.toAlgebra
    haveI : Algebra.Etale A_bar B_bar := hEt
    obtain ⟨m, ⟨P'⟩⟩ := hSubPres A_bar B_bar
    let v_bar : Fin m → B_bar := P'.val
    let g_bar : Fin m → MvPolynomial (Fin m) A_bar := P'.relation
    let a₁ : Fin m → Fin m := P'.map
    have hMapSurj : Function.Surjective (MvPolynomial.map q : MvPolynomial (Fin m) A →+* MvPolynomial (Fin m) A_bar) :=
      MvPolynomial.map_surjective q hq
    choose g hg using fun j : Fin m => hMapSurj (g_bar j)
    let I_g : Ideal (MvPolynomial (Fin m) A) := Ideal.span (Set.range g)
    let Q_A : Type u := MvPolynomial (Fin m) A ⧸ I_g
    let P_lift : Algebra.PreSubmersivePresentation A Q_A (Fin m) (Fin m) :=
      Algebra.PreSubmersivePresentation.naive (v := g) a₁ P'.map_inj
    let Δ_A : Q_A := P_lift.jacobian
    obtain ⟨A', instCommA', instAlgAA', instAlgQA', instTowerQA', instLocA'⟩ :
        ∃ (T : Type u) (_ : CommRing T) (_ : Algebra A T) (_ : Algebra Q_A T)
          (_ : IsScalarTower A Q_A T), IsLocalization.Away Δ_A T :=
      ⟨Localization.Away Δ_A, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance⟩
    haveI : Algebra.Etale A A' := hEtNaiveAway A Q_A A' (Fin m) P_lift
    let ι : A →+* A' := algebraMap A A'
    have hEt_ι : RingHom.Etale ι := RingHom.etale_algebraMap.mpr inferInstance
    let π₀ : MvPolynomial (Fin m) A →+* B_bar :=
      (MvPolynomial.aeval v_bar).toRingHom.comp (MvPolynomial.map q)
    have hSurj_aeval : Function.Surjective (MvPolynomial.aeval v_bar) := P'.aeval_val_surjective
    have hSurj_π₀ : Function.Surjective π₀ := hSurj_aeval.comp hMapSurj
    have hKer_aeval : RingHom.ker (MvPolynomial.aeval v_bar) = Ideal.span (Set.range g_bar) :=
      P'.ker_eq_ker_aeval_val.symm.trans P'.span_range_relation_eq_ker.symm
    have hIg_ker : ∀ f ∈ I_g, π₀ f = 0 := by
      intro f hf
      have hle : I_g ≤ RingHom.ker π₀ := by
        rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        change (MvPolynomial.aeval v_bar) (MvPolynomial.map q (g j)) = 0
        rw [hg j]
        have hmem : g_bar j ∈ Ideal.span (Set.range g_bar) := Ideal.subset_span ⟨j, rfl⟩
        rw [← hKer_aeval] at hmem
        exact hmem
      exact hle hf
    let q₀ : Q_A →+* B_bar := Ideal.Quotient.lift I_g π₀ hIg_ker
    have hSurj_q₀ : Function.Surjective q₀ :=
      Ideal.Quotient.lift_surjective_of_surjective I_g hIg_ker hSurj_π₀
    have hPlift_algMap : ∀ p : MvPolynomial (Fin m) A,
        algebraMap P_lift.Ring Q_A p = Ideal.Quotient.mk I_g p := by
      intro p
      rw [P_lift.algebraMap_apply]
      have hExt : MvPolynomial.aeval P_lift.val = Ideal.Quotient.mkₐ A I_g := by
        ext i
        rw [MvPolynomial.aeval_X]
        rfl
      exact DFunLike.congr_fun hExt p
    have hJacEq : q₀ Δ_A = P'.jacobian := by
      dsimp [Δ_A]
      rw [P_lift.jacobian_eq_jacobiMatrix_det, hPlift_algMap]
      change π₀ P_lift.jacobiMatrix.det = P'.jacobian
      rw [RingHom.map_det]
      rw [P'.jacobian_eq_jacobiMatrix_det, P'.algebraMap_apply]
      change (π₀.mapMatrix P_lift.jacobiMatrix).det =
        (MvPolynomial.aeval v_bar).toRingHom P'.jacobiMatrix.det
      rw [RingHom.map_det (MvPolynomial.aeval v_bar).toRingHom P'.jacobiMatrix]
      congr 1
      ext i j
      change (MvPolynomial.aeval v_bar) (MvPolynomial.map q (P_lift.jacobiMatrix i j)) =
        (MvPolynomial.aeval v_bar) (P'.jacobiMatrix i j)
      congr 1
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
        ← MvPolynomial.pderiv_map, hg j]
    have hUnit_q₀Δ : IsUnit (q₀ Δ_A) := hJacEq ▸ P'.jacobian_isUnit
    let q' : A' →+* B_bar := IsLocalization.Away.lift Δ_A (g := q₀) hUnit_q₀Δ
    have hq'_eq : ∀ y : Q_A, q' (algebraMap Q_A A' y) = q₀ y :=
      IsLocalization.Away.lift_eq Δ_A hUnit_q₀Δ
    have hSurj_q' : Function.Surjective q' := by
      intro b
      obtain ⟨y, rfl⟩ := hSurj_q₀ b
      exact ⟨algebraMap Q_A A' y, hq'_eq y⟩
    have hq'_comp : q'.comp ι = ψ.comp q := by
      ext x
      change q' (algebraMap A A' x) = ψ (q x)
      rw [IsScalarTower.algebraMap_apply A Q_A A' x, hq'_eq]
      change (MvPolynomial.aeval v_bar) (MvPolynomial.map q (MvPolynomial.C x)) = ψ (q x)
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
      rfl
    have hKer_q₀ : RingHom.ker q₀ ≤ Ideal.map (algebraMap A Q_A) (RingHom.ker q) := by
      intro y hy
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hf0 : (MvPolynomial.aeval v_bar) (MvPolynomial.map q f) = 0 := hy
      have hf_mem : MvPolynomial.map q f ∈ Ideal.span (Set.range g_bar) := by
        rw [← hKer_aeval]
        exact hf0
      have hSpanEq : Ideal.span (Set.range g_bar) = Ideal.map (MvPolynomial.map q) I_g := by
        dsimp [I_g]
        rw [Ideal.map_span]
        congr 1
        ext p_bar
        simp only [Set.mem_range, Set.mem_image]
        constructor
        · rintro ⟨j, rfl⟩
          exact ⟨g j, ⟨j, rfl⟩, hg j⟩
        · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
          exact ⟨j, (hg j).symm⟩
      rw [hSpanEq, Ideal.mem_map_iff_of_surjective _ hMapSurj] at hf_mem
      obtain ⟨h, hh_Ig, hh_eq⟩ := hf_mem
      have hsub_ker : f - h ∈ RingHom.ker (MvPolynomial.map q) := by
        change MvPolynomial.map q (f - h) = 0
        rw [map_sub, hh_eq, sub_self]
      rw [MvPolynomial.ker_map] at hsub_ker
      have hmk_eq : Ideal.Quotient.mk I_g f = Ideal.Quotient.mk I_g (f - h) := by
        rw [map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hh_Ig, sub_zero]
      rw [hmk_eq]
      have hmem_map : Ideal.Quotient.mk I_g (f - h) ∈
          Ideal.map (Ideal.Quotient.mk I_g) (Ideal.map MvPolynomial.C (RingHom.ker q)) :=
        Ideal.mem_map_of_mem _ hsub_ker
      rwa [Ideal.map_map] at hmem_map
    have hKer_q' : RingHom.ker q' = Ideal.map ι (RingHom.ker q) := by
      apply le_antisymm
      · intro z hz
        obtain ⟨n, y, hzy⟩ := IsLocalization.Away.surj Δ_A z
        have hq0_y : q₀ y = 0 := by
          have h1 := congrArg q' hzy
          rw [map_mul, map_pow, hq'_eq, hq'_eq] at h1
          have hz0 : q' z = 0 := hz
          rw [hz0, zero_mul] at h1
          exact h1.symm
        have hy_mem : y ∈ Ideal.map (algebraMap A Q_A) (RingHom.ker q) := hKer_q₀ hq0_y
        have hay_mem : algebraMap Q_A A' y ∈ Ideal.map ι (RingHom.ker q) := by
          have hm := Ideal.mem_map_of_mem (algebraMap Q_A A') hy_mem
          rw [Ideal.map_map] at hm
          have hEqMap : (algebraMap Q_A A').comp (algebraMap A Q_A) = ι :=
            RingHom.ext fun x => (IsScalarTower.algebraMap_apply A Q_A A' x).symm
          rwa [hEqMap] at hm
        obtain ⟨u, hu⟩ := (IsLocalization.Away.algebraMap_isUnit (S := A') Δ_A).pow n
        have hzu : z * (u : A') = algebraMap Q_A A' y := by rw [hu, hzy]
        have hz_eq : z = algebraMap Q_A A' y * ↑u⁻¹ := by
          rw [← hzu, mul_assoc, Units.mul_inv, mul_one]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ _ hay_mem
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        change (q'.comp ι) x = 0
        rw [hq'_comp]
        change ψ (q x) = 0
        have hqx : q x = 0 := hx
        rw [hqx, map_zero]
    exact ⟨A', instCommA', ι, q', hEt_ι, hSurj_q', hq'_comp, hKer_q'⟩

  
  let m_R : Ideal R := IsLocalRing.maximalIdeal R
  let k₀ : Type u := IsLocalRing.ResidueField R
  let I_AR : Ideal A_R := Ideal.map (algebraMap R A_R) m_R
  let q_A : A_R →+* (A_R ⧸ I_AR) := Ideal.Quotient.mk I_AR
  obtain ⟨A', instCommA', ι₁, q_A', hEt_ι₁, hSurj_qA', hqA'_comp, hqA'_ker0⟩ :=
    hStage1 A_R (A_R ⧸ I_AR) q_A Ideal.Quotient.mk_surjective ψ₁ hEt₁
  letI : CommRing A' := instCommA'
  letI : Algebra R A' := (ι₁.comp (algebraMap R A_R)).toAlgebra
  have hFlat_A' : Module.Flat R A' := by
    letI : Algebra A_R A' := ι₁.toAlgebra
    haveI : IsScalarTower R A_R A' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.Etale A_R A' := hEt_ι₁
    haveI : Module.Flat A_R A' := Algebra.Smooth.flat A_R A'
    exact Module.Flat.trans R A_R A'
  have hFP_A' : Algebra.FinitePresentation R A' := by
    letI : Algebra A_R A' := ι₁.toAlgebra
    haveI : IsScalarTower R A_R A' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.Etale A_R A' := hEt_ι₁
    haveI : Algebra.FinitePresentation A_R A' := Algebra.Etale.finitePresentation
    exact Algebra.FinitePresentation.trans R A_R A'
  haveI : Algebra.FinitePresentation R A' := hFP_A'
  have hqA'_ker : RingHom.ker q_A' = Ideal.map (algebraMap R A') m_R := by
    have hker_qA : RingHom.ker q_A = I_AR := by
      ext x
      exact Ideal.Quotient.eq_zero_iff_mem
    rw [hqA'_ker0, hker_qA]
    dsimp [I_AR]
    rw [Ideal.map_map]
    rfl
  have hCompat' : q_A'.comp (algebraMap R A') =
      (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp (IsLocalRing.residue R) := by
    calc
      q_A'.comp (algebraMap R A') = (q_A'.comp ι₁).comp (algebraMap R A_R) := rfl
      _ = (ψ₁.comp q_A).comp (algebraMap R A_R) := by rw [hqA'_comp]
      _ = ψ₁.comp (q_A.comp (algebraMap R A_R)) := rfl
      _ = (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp (IsLocalRing.residue R) :=
        hCompat

  
  let B_X : Type u := MvPolynomial (Fin 2) R
  let I_nod : Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
  let N_bar : Type u := MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I_nod
  let π_N : B_X →+* N_bar :=
    (Ideal.Quotient.mk I_nod).comp (MvPolynomial.map (IsLocalRing.residue R))
  have hStage2 : ∃ (S₀ : Type u) (_ : CommRing S₀) (_ : Algebra R S₀)
      (A'' : Type u) (_ : CommRing A'') (_ : Algebra R A'') (_ : Algebra A' A'')
      (_ : IsScalarTower R A' A'')
      (φ_X₀ : B_X →ₐ[R] S₀)
      (ψ : S₀ →ₐ[R] A'')
      (q_A'' : A'' →+* B_bar),
      Algebra.FinitePresentation R S₀ ∧
      RingHom.Etale φ_X₀.toRingHom ∧
      RingHom.Etale (algebraMap A' A'') ∧
      Function.Surjective ψ ∧
      q_A''.comp (algebraMap A' A'') = q_A' ∧
      RingHom.ker q_A'' ≤ Ideal.map (algebraMap R A'') m_R ∧
      (q_A''.comp ψ.toRingHom).comp φ_X₀.toRingHom = ψ₂.comp π_N ∧
      RingHom.ker (q_A''.comp ψ.toRingHom) ≤
        Ideal.map (algebraMap R S₀) m_R ⊔
          Ideal.span {φ_X₀ (MvPolynomial.X 0 * MvPolynomial.X 1)} := by
    have hSurj_mapRes : Function.Surjective
        (MvPolynomial.map (IsLocalRing.residue R) : B_X →+* MvPolynomial (Fin 2) k₀) :=
      MvPolynomial.map_surjective _ IsLocalRing.residue_surjective
    have hSurj_πN : Function.Surjective π_N :=
      Ideal.Quotient.mk_surjective.comp hSurj_mapRes
    have hKer_πN : RingHom.ker π_N ≤
        Ideal.map (algebraMap R B_X) m_R ⊔ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} := by
      intro f hf
      have hf_span : MvPolynomial.map (IsLocalRing.residue R) f ∈
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} :=
        Ideal.Quotient.eq_zero_iff_mem.mp hf
      have hSpanMap : (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) k₀)) =
          Ideal.map (MvPolynomial.map (IsLocalRing.residue R))
            (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) := by
        rw [Ideal.map_span, Set.image_singleton, map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
      rw [hSpanMap, Ideal.mem_map_iff_of_surjective _ hSurj_mapRes] at hf_span
      obtain ⟨h, hh_span, hh_eq⟩ := hf_span
      have hsub : f - h ∈ RingHom.ker (MvPolynomial.map (IsLocalRing.residue R)) := by
        change MvPolynomial.map (IsLocalRing.residue R) (f - h) = 0
        rw [map_sub, hh_eq, sub_self]
      rw [MvPolynomial.ker_map, IsLocalRing.ker_residue] at hsub
      have hf_eq : f = (f - h) + h := (sub_add_cancel f h).symm
      rw [hf_eq]
      exact Submodule.add_mem_sup hsub hh_span
    choose x_coord hx_coord using fun i : Fin 2 =>
      hSurj_qA' (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)))
    let θ_X : B_X →ₐ[R] A' := MvPolynomial.aeval x_coord
    have hθ_X_comp : q_A'.comp θ_X.toRingHom = ψ₂.comp π_N := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change q_A' (θ_X (MvPolynomial.C r)) = ψ₂ (π_N (MvPolynomial.C r))
        rw [MvPolynomial.aeval_C]
        have hr := RingHom.congr_fun hCompat' r
        dsimp at hr
        rw [hr]
        dsimp [π_N]
        rw [MvPolynomial.map_C]
      · intro i
        change q_A' (θ_X (MvPolynomial.X i)) = ψ₂ (π_N (MvPolynomial.X i))
        rw [MvPolynomial.aeval_X, hx_coord i]
        dsimp [π_N]
        rw [MvPolynomial.map_X]
    letI : Algebra N_bar B_bar := ψ₂.toAlgebra
    haveI : Algebra.Etale N_bar B_bar := hEt₂
    obtain ⟨m₂, ⟨P₂⟩⟩ := hSubPres N_bar B_bar
    let z_bar : Fin m₂ → B_bar := P₂.val
    let p_bar : Fin m₂ → MvPolynomial (Fin m₂) N_bar := P₂.relation
    let a₂ : Fin m₂ → Fin m₂ := P₂.map
    choose z hz using fun j : Fin m₂ => hSurj_qA' (z_bar j)
    have hSurj_mapπN : Function.Surjective
        (MvPolynomial.map π_N : MvPolynomial (Fin m₂) B_X →+* MvPolynomial (Fin m₂) N_bar) :=
      MvPolynomial.map_surjective π_N hSurj_πN
    choose p hp using fun j : Fin m₂ => hSurj_mapπN (p_bar j)
    have hFT_A' : Algebra.FiniteType R A' := Algebra.FiniteType.of_finitePresentation
    obtain ⟨s_gen, hs_gen⟩ := hFT_A'.out
    let e_gen := Finite.equivFin ↥s_gen
    let N := Nat.card ↥s_gen
    let y_raw : Fin N → A' := fun c => (e_gen.symm c).1
    have hRange_yraw : Set.range y_raw = (s_gen : Set A') := by
      ext a
      simp only [y_raw, Set.mem_range]
      constructor
      · rintro ⟨c, rfl⟩
        exact (e_gen.symm c).2
      · intro ha
        exact ⟨e_gen ⟨a, ha⟩, by simp⟩
    let π_Z : MvPolynomial (Fin m₂) B_X →+* B_bar :=
      (MvPolynomial.aeval z_bar).toRingHom.comp (MvPolynomial.map π_N)
    have hSurj_πZ : Function.Surjective π_Z :=
      P₂.aeval_val_surjective.comp hSurj_mapπN
    have hEval_πZ : ∀ g : MvPolynomial (Fin m₂) B_X,
        q_A' (MvPolynomial.eval₂ θ_X.toRingHom z g) = π_Z g := by
      intro g
      rw [MvPolynomial.hom_eval₂, hθ_X_comp]
      have hz_eq : (fun i => q_A' (z i)) = z_bar := funext hz
      rw [hz_eq]
      change MvPolynomial.eval₂ ((algebraMap N_bar B_bar).comp π_N) z_bar g =
        MvPolynomial.eval₂ (algebraMap N_bar B_bar) z_bar (MvPolynomial.map π_N g)
      rw [MvPolynomial.eval₂_map]
    choose h_shift hh_shift using fun c : Fin N => hSurj_πZ (q_A' (y_raw c))
    let y : Fin N → A' := fun c => y_raw c - MvPolynomial.eval₂ θ_X.toRingHom z (h_shift c)
    have hy_ker : ∀ c : Fin N, q_A' (y c) = 0 := by
      intro c
      change q_A' (y_raw c - MvPolynomial.eval₂ θ_X.toRingHom z (h_shift c)) = 0
      rw [map_sub]
      change q_A' (y_raw c) - q_A' (MvPolynomial.eval₂ θ_X.toRingHom z (h_shift c)) = 0
      rw [hEval_πZ, hh_shift c, sub_self]
    let P_ZY : Type u := MvPolynomial (Fin m₂ ⊕ Fin N) B_X
    let Φ_R_ring : P_ZY →+* A' := MvPolynomial.eval₂Hom θ_X.toRingHom (Sum.elim z y)
    let Φ_R : P_ZY →ₐ[R] A' :=
      { Φ_R_ring with
        commutes' := fun r => by
          change MvPolynomial.eval₂ θ_X.toRingHom (Sum.elim z y) (MvPolynomial.C (MvPolynomial.C r)) =
            algebraMap R A' r
          rw [MvPolynomial.eval₂_C]
          exact θ_X.commutes r }
    have hΦ_rename : ∀ g : MvPolynomial (Fin m₂) B_X,
        Φ_R (MvPolynomial.rename Sum.inl g) = MvPolynomial.eval₂ θ_X.toRingHom z g := by
      intro g
      change MvPolynomial.eval₂ θ_X.toRingHom (Sum.elim z y) (MvPolynomial.rename Sum.inl g) = _
      rw [MvPolynomial.eval₂_rename]
      rfl
    have hSurj_ΦR : Function.Surjective Φ_R := by
      intro a'
      have hTop : Φ_R.range = ⊤ := by
        rw [eq_top_iff, ← hs_gen, Algebra.adjoin_le_iff, ← hRange_yraw]
        rintro _ ⟨c, rfl⟩
        refine ⟨MvPolynomial.X (Sum.inr c) + MvPolynomial.rename Sum.inl (h_shift c), ?_⟩
        change Φ_R (MvPolynomial.X (Sum.inr c) + MvPolynomial.rename Sum.inl (h_shift c)) = y_raw c
        rw [map_add, hΦ_rename]
        have hX : Φ_R (MvPolynomial.X (Sum.inr c)) = y c := MvPolynomial.eval₂_X _ _ _
        rw [hX]
        exact sub_add_cancel (y_raw c) _
      have ha' : a' ∈ Φ_R.range := by
        rw [hTop]
        trivial
      exact ha'
    let M_ZY : Ideal P_ZY := Ideal.map (algebraMap R P_ZY) m_R
    have hMap_MZY : Ideal.map Φ_R.toRingHom M_ZY = RingHom.ker q_A' := by
      dsimp [M_ZY]
      rw [Ideal.map_map]
      have hComp : (Φ_R : P_ZY →+* A').comp (algebraMap R P_ZY) = algebraMap R A' :=
        RingHom.ext Φ_R.commutes
      rw [hComp, hqA'_ker]
    have hKer_P2 : RingHom.ker (MvPolynomial.aeval z_bar) = Ideal.span (Set.range p_bar) :=
      P₂.ker_eq_ker_aeval_val.symm.trans P₂.span_range_relation_eq_ker.symm
    have hp_in_map : ∀ j : Fin m₂,
        Φ_R (MvPolynomial.rename Sum.inl (p j)) ∈ Ideal.map Φ_R.toRingHom M_ZY := by
      intro j
      rw [hMap_MZY]
      change q_A' (Φ_R (MvPolynomial.rename Sum.inl (p j))) = 0
      rw [hΦ_rename, hEval_πZ]
      change (MvPolynomial.aeval z_bar) (MvPolynomial.map π_N (p j)) = 0
      rw [hp j]
      have hmem : p_bar j ∈ Ideal.span (Set.range p_bar) := Ideal.subset_span ⟨j, rfl⟩
      rw [← hKer_P2] at hmem
      exact hmem
    choose u_a hu_a using fun j : Fin m₂ =>
      (Ideal.mem_map_iff_of_surjective Φ_R.toRingHom hSurj_ΦR).mp (hp_in_map j)
    have hy_in_map : ∀ c : Fin N,
        Φ_R (MvPolynomial.X (Sum.inr c)) ∈ Ideal.map Φ_R.toRingHom M_ZY := by
      intro c
      rw [hMap_MZY]
      change q_A' (Φ_R (MvPolynomial.X (Sum.inr c))) = 0
      have hX : Φ_R (MvPolynomial.X (Sum.inr c)) = y c := MvPolynomial.eval₂_X _ _ _
      rw [hX]
      exact hy_ker c
    choose v_c hv_c using fun c : Fin N =>
      (Ideal.mem_map_iff_of_surjective Φ_R.toRingHom hSurj_ΦR).mp (hy_in_map c)
    let P_hat : Fin m₂ → P_ZY := fun j => MvPolynomial.rename Sum.inl (p j) - u_a j
    let G_c : Fin N → P_ZY := fun c => MvPolynomial.X (Sum.inr c) - v_c c
    let H : (Fin m₂ ⊕ Fin N) → P_ZY := Sum.elim P_hat G_c
    let I_H : Ideal P_ZY := Ideal.span (Set.range H)
    have hIH_ker : ∀ f ∈ I_H, Φ_R f = 0 := by
      intro f hf
      have hle : I_H ≤ RingHom.ker Φ_R.toRingHom := by
        rw [Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        cases k with
        | inl j =>
          change Φ_R (MvPolynomial.rename Sum.inl (p j) - u_a j) = 0
          have hu_eq : Φ_R (u_a j) = Φ_R (MvPolynomial.rename Sum.inl (p j)) := (hu_a j).2
          rw [map_sub, hu_eq, sub_self]
        | inr c =>
          change Φ_R (MvPolynomial.X (Sum.inr c) - v_c c) = 0
          have hv_eq : Φ_R (v_c c) = Φ_R (MvPolynomial.X (Sum.inr c)) := (hv_c c).2
          rw [map_sub, hv_eq, sub_self]
      exact hle hf
    let Q₀ : Type u := P_ZY ⧸ I_H
    let ψ₀ : Q₀ →ₐ[R] A' := Ideal.Quotient.liftₐ I_H Φ_R hIH_ker
    have hSurj_ψ₀ : Function.Surjective ψ₀ :=
      Ideal.Quotient.lift_surjective_of_surjective I_H hIH_ker hSurj_ΦR
    let P₀ : Algebra.PreSubmersivePresentation B_X Q₀ (Fin m₂ ⊕ Fin N) (Fin m₂ ⊕ Fin N) :=
      Algebra.PreSubmersivePresentation.naive (v := H) (Sum.map a₂ id)
        (P₂.map_inj.sumMap Function.injective_id)
    let Δ₀ : Q₀ := P₀.jacobian
    obtain ⟨S₀, instCommS₀, instAlgRS₀, instAlgBXS₀, instAlgQ₀S₀,
        instTowerRBS₀, instTowerRQS₀, instTowerBQS₀, instLocS₀⟩ :
        ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra B_X T) (_ : Algebra Q₀ T)
          (_ : IsScalarTower R B_X T) (_ : IsScalarTower R Q₀ T) (_ : IsScalarTower B_X Q₀ T),
          IsLocalization.Away Δ₀ T :=
      ⟨Localization.Away Δ₀, inferInstance, inferInstance, inferInstance, inferInstance,
        inferInstance, inferInstance, inferInstance, inferInstance⟩
    letI : CommRing S₀ := instCommS₀
    letI : Algebra R S₀ := instAlgRS₀
    letI : Algebra B_X S₀ := instAlgBXS₀
    letI : Algebra Q₀ S₀ := instAlgQ₀S₀
    haveI : IsScalarTower R B_X S₀ := instTowerRBS₀
    haveI : IsScalarTower R Q₀ S₀ := instTowerRQS₀
    haveI : IsScalarTower B_X Q₀ S₀ := instTowerBQS₀
    haveI : IsLocalization.Away Δ₀ S₀ := instLocS₀
    haveI : Algebra.Etale B_X S₀ := hEtNaiveAway B_X Q₀ S₀ (Fin m₂ ⊕ Fin N) P₀
    let ι_QS := instAlgQ₀S₀.algebraMap
    let φ_X₀ : B_X →ₐ[R] S₀ := IsScalarTower.toAlgHom R B_X S₀
    have hEt_φX₀ : RingHom.Etale φ_X₀.toRingHom := RingHom.etale_algebraMap.mpr inferInstance
    have hFP_S₀ : Algebra.FinitePresentation R S₀ := by
      haveI : Algebra.FinitePresentation R B_X := inferInstance
      haveI : Algebra.FinitePresentation B_X S₀ := Algebra.Etale.finitePresentation
      exact Algebra.FinitePresentation.trans R B_X S₀
    let π_ZY_bar : P_ZY →+* B_bar := q_A'.comp Φ_R.toRingHom
    let q₀ : Q₀ →+* B_bar := q_A'.comp ψ₀.toRingHom
    have hMZY_ker : M_ZY ≤ RingHom.ker π_ZY_bar := by
      dsimp [M_ZY]
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      change q_A' (Φ_R (algebraMap R P_ZY m)) = 0
      rw [Φ_R.commutes]
      have hmA : algebraMap R A' m ∈ RingHom.ker q_A' := by
        rw [hqA'_ker]
        exact Ideal.mem_map_of_mem _ hm
      exact hmA
    have hpderiv_MZY : ∀ (k : Fin m₂ ⊕ Fin N), ∀ w ∈ M_ZY, MvPolynomial.pderiv k w ∈ M_ZY := by
      intro k w hw
      refine Submodule.span_induction
        (fun x hx => ?_)
        (by rw [map_zero]; exact M_ZY.zero_mem)
        (fun x₁ x₂ _ _ hx₁ hx₂ => by rw [map_add]; exact M_ZY.add_mem hx₁ hx₂)
        (fun s x hx hpx => ?_) hw
      · rcases hx with ⟨m, _, rfl⟩
        have hEqC : algebraMap R P_ZY m = MvPolynomial.C (algebraMap R B_X m) :=
          IsScalarTower.algebraMap_apply R B_X P_ZY m
        rw [hEqC, MvPolynomial.pderiv_C]
        exact M_ZY.zero_mem
      · change MvPolynomial.pderiv k (s * x) ∈ M_ZY
        rw [MvPolynomial.pderiv_mul]
        exact M_ZY.add_mem (Ideal.mul_mem_left _ _ hx) (Ideal.mul_mem_left _ _ hpx)
    have hpderiv_inl_zero : ∀ (i₂ : Fin N) (g : MvPolynomial (Fin m₂) B_X),
        MvPolynomial.pderiv (Sum.inr i₂) (MvPolynomial.rename (Sum.inl : Fin m₂ → Fin m₂ ⊕ Fin N) g) = 0 := by
      intro i₂ g
      induction g using MvPolynomial.induction_on with
      | C b =>
        rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
      | add g₁ g₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂, add_zero]
      | mul_X g₁ j ih =>
        rw [map_mul, MvPolynomial.rename_X, MvPolynomial.pderiv_mul, ih, zero_mul, zero_add,
          MvPolynomial.pderiv_X_of_ne (by simp), mul_zero]
    have hP₀_algMap : ∀ f : P_ZY, algebraMap P₀.Ring Q₀ f = Ideal.Quotient.mk I_H f := by
      intro f
      rw [P₀.algebraMap_apply]
      have hExt : MvPolynomial.aeval P₀.val = Ideal.Quotient.mkₐ B_X I_H := by
        ext k
        rw [MvPolynomial.aeval_X]
        rfl
      exact DFunLike.congr_fun hExt f
    have hq₀_Δ₀ : q₀ Δ₀ = P₂.jacobian := by
      dsimp [Δ₀]
      rw [P₀.jacobian_eq_jacobiMatrix_det, hP₀_algMap]
      change π_ZY_bar P₀.jacobiMatrix.det = P₂.jacobian
      rw [RingHom.map_det]
      have hBlocks : π_ZY_bar.mapMatrix P₀.jacobiMatrix =
          Matrix.fromBlocks ((MvPolynomial.aeval z_bar).toRingHom.mapMatrix P₂.jacobiMatrix)
            0 0 (1 : Matrix (Fin N) (Fin N) B_bar) := by
        ext i j
        cases i with
        | inl i₁ =>
          cases j with
          | inl j₁ =>
            change π_ZY_bar (P₀.jacobiMatrix (Sum.inl i₁) (Sum.inl j₁)) =
              (MvPolynomial.aeval z_bar) (P₂.jacobiMatrix i₁ j₁)
            rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
            change π_ZY_bar (MvPolynomial.pderiv (Sum.inl (a₂ i₁))
              (MvPolynomial.rename Sum.inl (p j₁) - u_a j₁)) = _
            rw [map_sub, map_sub]
            have hu0 : π_ZY_bar (MvPolynomial.pderiv (Sum.inl (a₂ i₁)) (u_a j₁)) = 0 :=
              hMZY_ker (hpderiv_MZY _ _ (hu_a j₁).1)
            rw [hu0, sub_zero, MvPolynomial.pderiv_rename Sum.inl_injective]
            change q_A' (Φ_R (MvPolynomial.rename Sum.inl (MvPolynomial.pderiv (a₂ i₁) (p j₁)))) = _
            rw [hΦ_rename, hEval_πZ]
            change (MvPolynomial.aeval z_bar)
              (MvPolynomial.map π_N (MvPolynomial.pderiv (a₂ i₁) (p j₁))) = _
            rw [← MvPolynomial.pderiv_map, hp j₁,
              Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
          | inr j₂ =>
            change π_ZY_bar (P₀.jacobiMatrix (Sum.inl i₁) (Sum.inr j₂)) = 0
            rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
            change π_ZY_bar (MvPolynomial.pderiv (Sum.inl (a₂ i₁))
              (MvPolynomial.X (Sum.inr j₂) - v_c j₂)) = 0
            rw [map_sub, map_sub, MvPolynomial.pderiv_X_of_ne (by simp), map_zero,
              hMZY_ker (hpderiv_MZY _ _ (hv_c j₂).1), sub_self]
        | inr i₂ =>
          cases j with
          | inl j₁ =>
            change π_ZY_bar (P₀.jacobiMatrix (Sum.inr i₂) (Sum.inl j₁)) = 0
            rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
            change π_ZY_bar (MvPolynomial.pderiv (Sum.inr i₂)
              (MvPolynomial.rename Sum.inl (p j₁) - u_a j₁)) = 0
            rw [map_sub, map_sub, hpderiv_inl_zero, map_zero,
              hMZY_ker (hpderiv_MZY _ _ (hu_a j₁).1), sub_self]
          | inr j₂ =>
            change π_ZY_bar (P₀.jacobiMatrix (Sum.inr i₂) (Sum.inr j₂)) =
              (1 : Matrix (Fin N) (Fin N) B_bar) i₂ j₂
            rw [Algebra.PreSubmersivePresentation.jacobiMatrix_naive]
            change π_ZY_bar (MvPolynomial.pderiv (Sum.inr i₂)
              (MvPolynomial.X (Sum.inr j₂) - v_c j₂)) = _
            rw [map_sub, map_sub, hMZY_ker (hpderiv_MZY _ _ (hv_c j₂).1), sub_zero]
            by_cases hij : i₂ = j₂
            · subst hij
              rw [MvPolynomial.pderiv_X_self, map_one, Matrix.one_apply_eq]
            · rw [MvPolynomial.pderiv_X_of_ne (fun h => hij (Sum.inr.inj h).symm),
                map_zero, Matrix.one_apply_ne hij]
      rw [hBlocks, Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, mul_one,
        ← RingHom.map_det, P₂.jacobian_eq_jacobiMatrix_det, P₂.algebraMap_apply]
      rfl
    let d' : A' := ψ₀ Δ₀
    have hUnit_d' : IsUnit (q_A' d') := hq₀_Δ₀ ▸ P₂.jacobian_isUnit
    obtain ⟨A'', instCommA'', instAlgRA'', instAlgA'A'', instTowerRA'', instLocA''⟩ :
        ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra A' T)
          (_ : IsScalarTower R A' T), IsLocalization.Away d' T :=
      ⟨Localization.Away d', inferInstance, inferInstance, inferInstance, inferInstance, inferInstance⟩
    letI : CommRing A'' := instCommA''
    letI : Algebra R A'' := instAlgRA''
    letI : Algebra A' A'' := instAlgA'A''
    haveI : IsScalarTower R A' A'' := instTowerRA''
    haveI : IsLocalization.Away d' A'' := instLocA''
    haveI : Algebra.Etale A' A'' := Algebra.Etale.of_isLocalizationAway d'
    have hEt_ιA' : RingHom.Etale (algebraMap A' A'') := RingHom.etale_algebraMap.mpr inferInstance
    let q_A'' : A'' →+* B_bar := IsLocalization.Away.lift d' (g := q_A') hUnit_d'
    have hqA''_eq : ∀ a' : A', q_A'' (algebraMap A' A'' a') = q_A' a' :=
      IsLocalization.Away.lift_eq d' hUnit_d'
    have hqA''_comp : q_A''.comp (algebraMap A' A'') = q_A' := RingHom.ext hqA''_eq
    let f_Q₀_A'' : Q₀ →ₐ[R] A'' := (IsScalarTower.toAlgHom R A' A'').comp ψ₀
    have hUnit_fΔ₀ : IsUnit (f_Q₀_A''.toRingHom Δ₀) :=
      IsLocalization.Away.algebraMap_isUnit (S := A'') d'
    let ψ_ring : S₀ →+* A'' := IsLocalization.Away.lift Δ₀ (g := f_Q₀_A''.toRingHom) hUnit_fΔ₀
    have hψ_eq : ∀ y : Q₀, ψ_ring (algebraMap Q₀ S₀ y) = algebraMap A' A'' (ψ₀ y) :=
      IsLocalization.Away.lift_eq Δ₀ hUnit_fΔ₀
    let ψ : S₀ →ₐ[R] A'' :=
      { ψ_ring with
        commutes' := fun r => by
          change ψ_ring (algebraMap R S₀ r) = algebraMap R A'' r
          rw [IsScalarTower.algebraMap_apply R Q₀ S₀ r, hψ_eq, ψ₀.commutes,
            ← IsScalarTower.algebraMap_apply R A' A'' r] }
    have hSurj_ψ : Function.Surjective ψ := by
      intro w
      obtain ⟨n, a', hwa⟩ := IsLocalization.Away.surj d' w
      obtain ⟨y, rfl⟩ := hSurj_ψ₀ a'
      obtain ⟨u_Δ, hu_Δ⟩ := (IsLocalization.Away.algebraMap_isUnit (S := S₀) Δ₀).pow n
      refine ⟨ι_QS y * ↑u_Δ⁻¹, ?_⟩
      change ψ_ring (ι_QS y * ↑u_Δ⁻¹) = w
      obtain ⟨u_d, hu_d⟩ := (IsLocalization.Away.algebraMap_isUnit (S := A'') d').pow n
      have hmul_eq : ψ_ring (ι_QS y * ↑u_Δ⁻¹) * (u_d : A'') = w * (u_d : A'') := by
        calc
          ψ_ring (ι_QS y * ↑u_Δ⁻¹) * (u_d : A'')
            = ψ_ring (ι_QS y * ↑u_Δ⁻¹) * ψ_ring (u_Δ : S₀) := by
              rw [hu_d, hu_Δ, map_pow, hψ_eq]
          _ = ψ_ring (ι_QS y * (↑u_Δ⁻¹ * (u_Δ : S₀))) := by rw [← map_mul, mul_assoc]
          _ = algebraMap A' A'' (ψ₀ y) := by
              rw [Units.inv_mul, mul_one]
              exact hψ_eq y
          _ = w * (u_d : A'') := by rw [hu_d, hwa]
      calc
        ψ_ring (ι_QS y * ↑u_Δ⁻¹)
          = (ψ_ring (ι_QS y * ↑u_Δ⁻¹) * (u_d : A'')) * ↑u_d⁻¹ := by
            rw [mul_assoc, Units.mul_inv, mul_one]
        _ = (w * (u_d : A'')) * ↑u_d⁻¹ := by rw [hmul_eq]
        _ = w := by rw [mul_assoc, Units.mul_inv, mul_one]
    have hqA''_ker : RingHom.ker q_A'' ≤ Ideal.map (algebraMap R A'') m_R := by
      intro w hw
      obtain ⟨n, a', hwa⟩ := IsLocalization.Away.surj d' w
      have ha'0 : a' ∈ RingHom.ker q_A' := by
        change q_A' a' = 0
        have h1 := congrArg q_A'' hwa
        rw [map_mul, map_pow, hqA''_eq, hqA''_eq] at h1
        have hw0 : q_A'' w = 0 := hw
        rw [hw0, zero_mul] at h1
        exact h1.symm
      rw [hqA'_ker] at ha'0
      have hmem : algebraMap A' A'' a' ∈ Ideal.map (algebraMap R A'') m_R := by
        have hm := Ideal.mem_map_of_mem (algebraMap A' A'') ha'0
        rw [Ideal.map_map] at hm
        have hEqMap : (algebraMap A' A'').comp (algebraMap R A') = algebraMap R A'' :=
          RingHom.ext fun r => (IsScalarTower.algebraMap_apply R A' A'' r).symm
        rwa [hEqMap] at hm
      obtain ⟨u_d, hu_d⟩ := (IsLocalization.Away.algebraMap_isUnit (S := A'') d').pow n
      have hwu : w = algebraMap A' A'' a' * ↑u_d⁻¹ := by
        have h1 : w * (u_d : A'') = algebraMap A' A'' a' := by rw [hu_d, hwa]
        rw [← h1, mul_assoc, Units.mul_inv, mul_one]
      rw [hwu]
      exact Ideal.mul_mem_right _ _ hmem
    have hqS₀_Q₀ : ∀ y : Q₀, q_A'' (ψ (ι_QS y)) = q₀ y := by
      intro y
      change q_A'' (ψ_ring (ι_QS y)) = q₀ y
      rw [show ψ_ring (ι_QS y) = algebraMap A' A'' (ψ₀ y) from hψ_eq y, hqA''_eq]
      rfl
    have hqS₀_φX₀ : (q_A''.comp ψ.toRingHom).comp φ_X₀.toRingHom = ψ₂.comp π_N := by
      apply RingHom.ext
      intro b
      change q_A'' (ψ (algebraMap B_X S₀ b)) = ψ₂ (π_N b)
      have hb : algebraMap B_X S₀ b = ι_QS (algebraMap B_X Q₀ b) :=
        IsScalarTower.algebraMap_apply B_X Q₀ S₀ b
      rw [hb, hqS₀_Q₀]
      change q_A' (Φ_R (MvPolynomial.C b)) = ψ₂ (π_N b)
      have hCb : Φ_R (MvPolynomial.C b) = θ_X b := MvPolynomial.eval₂_C _ _ b
      rw [hCb]
      exact RingHom.congr_fun hθ_X_comp b
    have hKer_q₀ : RingHom.ker q₀ ≤
        Ideal.map (algebraMap R Q₀) m_R ⊔
          Ideal.span {algebraMap B_X Q₀ (MvPolynomial.X 0 * MvPolynomial.X 1)} := by
      intro y hy
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hf0 : π_ZY_bar f = 0 := hy
      let ρ : P_ZY →ₐ[B_X] MvPolynomial (Fin m₂) B_X :=
        MvPolynomial.aeval (Sum.elim MvPolynomial.X (fun _ => 0))
      have hf_ρ : f - MvPolynomial.rename Sum.inl (ρ f) ∈ I_H ⊔ M_ZY := by
        let mk_HM : P_ZY →ₐ[B_X] (P_ZY ⧸ (I_H ⊔ M_ZY)) := Ideal.Quotient.mkₐ B_X (I_H ⊔ M_ZY)
        have hAlgEq : mk_HM.comp ((MvPolynomial.rename Sum.inl).comp ρ) = mk_HM := by
          ext k
          cases k with
          | inl j =>
            simp [ρ]
          | inr c =>
            simp only [AlgHom.comp_apply, ρ, MvPolynomial.aeval_X, Sum.elim_inr, map_zero]
            symm
            change Ideal.Quotient.mk (I_H ⊔ M_ZY) (MvPolynomial.X (Sum.inr c)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem]
            have hXc : (MvPolynomial.X (Sum.inr c) : P_ZY) = H (Sum.inr c) + v_c c :=
              (sub_add_cancel _ _).symm
            rw [hXc]
            exact Submodule.add_mem_sup (Ideal.subset_span ⟨Sum.inr c, rfl⟩) (hv_c c).1
        have hApp := DFunLike.congr_fun hAlgEq f
        change Ideal.Quotient.mk (I_H ⊔ M_ZY) (MvPolynomial.rename Sum.inl (ρ f)) =
          Ideal.Quotient.mk (I_H ⊔ M_ZY) f at hApp
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hApp, sub_self]
      have hIHM_ker : I_H ⊔ M_ZY ≤ RingHom.ker π_ZY_bar := by
        refine sup_le ?_ hMZY_ker
        intro w hw
        change q_A' (Φ_R w) = 0
        rw [hIH_ker w hw, map_zero]
      have hρ0 : π_ZY_bar (MvPolynomial.rename Sum.inl (ρ f)) = 0 := by
        have h1 : π_ZY_bar (f - MvPolynomial.rename Sum.inl (ρ f)) = 0 := hIHM_ker hf_ρ
        rw [map_sub, hf0, zero_sub, neg_eq_zero] at h1
        exact h1
      have hρ_kerP2 : MvPolynomial.map π_N (ρ f) ∈ Ideal.span (Set.range p_bar) := by
        rw [← hKer_P2]
        change π_Z (ρ f) = 0
        rw [← hEval_πZ, ← hΦ_rename]
        exact hρ0
      have hSpanP : Ideal.span (Set.range p_bar) =
          Ideal.map (MvPolynomial.map π_N) (Ideal.span (Set.range p)) := by
        rw [Ideal.map_span]
        congr 1
        ext q_bar
        simp only [Set.mem_range, Set.mem_image]
        constructor
        · rintro ⟨j, rfl⟩
          exact ⟨p j, ⟨j, rfl⟩, hp j⟩
        · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
          exact ⟨j, (hp j).symm⟩
      rw [hSpanP, Ideal.mem_map_iff_of_surjective _ hSurj_mapπN] at hρ_kerP2
      obtain ⟨g_p, hgp_span, hgp_eq⟩ := hρ_kerP2
      have hgp_IHM : MvPolynomial.rename Sum.inl g_p ∈ I_H ⊔ M_ZY := by
        have hle : Ideal.span (Set.range p) ≤
            Ideal.comap (MvPolynomial.rename (Sum.inl : Fin m₂ → Fin m₂ ⊕ Fin N)).toRingHom (I_H ⊔ M_ZY) := by
          rw [Ideal.span_le]
          rintro _ ⟨j, rfl⟩
          change MvPolynomial.rename Sum.inl (p j) ∈ I_H ⊔ M_ZY
          have hpj : MvPolynomial.rename Sum.inl (p j) = H (Sum.inl j) + u_a j :=
            (sub_add_cancel _ _).symm
          rw [hpj]
          exact Submodule.add_mem_sup (Ideal.subset_span ⟨Sum.inl j, rfl⟩) (hu_a j).1
        exact hle hgp_span
      have hdiff_ker : ρ f - g_p ∈ Ideal.map MvPolynomial.C (RingHom.ker π_N) := by
        rw [← MvPolynomial.ker_map]
        change MvPolynomial.map π_N (ρ f - g_p) = 0
        rw [map_sub, hgp_eq, sub_self]
      have hren_diff : MvPolynomial.rename Sum.inl (ρ f - g_p) ∈
          Ideal.map (algebraMap B_X P_ZY) (RingHom.ker π_N) := by
        have hm := Ideal.mem_map_of_mem (MvPolynomial.rename (Sum.inl : Fin m₂ → Fin m₂ ⊕ Fin N)).toRingHom hdiff_ker
        rw [Ideal.map_map] at hm
        have hCompC : (MvPolynomial.rename (Sum.inl : Fin m₂ → Fin m₂ ⊕ Fin N)).toRingHom.comp MvPolynomial.C =
            algebraMap B_X P_ZY := by
          apply RingHom.ext
          intro b
          exact MvPolynomial.rename_C Sum.inl b
        rwa [hCompC] at hm
      have hf_decomp : f = ((f - MvPolynomial.rename Sum.inl (ρ f)) + MvPolynomial.rename Sum.inl g_p) +
          MvPolynomial.rename Sum.inl (ρ f - g_p) := by
        rw [map_sub]
        ring
      rw [hf_decomp, map_add]
      apply add_mem
      · have hsum_IHM : (f - MvPolynomial.rename Sum.inl (ρ f)) + MvPolynomial.rename Sum.inl g_p ∈
            I_H ⊔ M_ZY := (I_H ⊔ M_ZY).add_mem hf_ρ hgp_IHM
        rcases Submodule.mem_sup.mp hsum_IHM with ⟨w₁, hw₁, w₂, hw₂, hw_eq⟩
        rw [← hw_eq, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hw₁, zero_add]
        have hm := Ideal.mem_map_of_mem (Ideal.Quotient.mk I_H) hw₂
        dsimp [M_ZY] at hm
        rw [Ideal.map_map] at hm
        exact Submodule.mem_sup_left hm
      · have hm := Ideal.mem_map_of_mem (Ideal.Quotient.mk I_H) hren_diff
        rw [Ideal.map_map] at hm
        have hEqBX : (Ideal.Quotient.mk I_H).comp (algebraMap B_X P_ZY) = algebraMap B_X Q₀ := rfl
        rw [hEqBX] at hm
        have hle_BX : Ideal.map (algebraMap B_X Q₀) (RingHom.ker π_N) ≤
            Ideal.map (algebraMap R Q₀) m_R ⊔
              Ideal.span {algebraMap B_X Q₀ (MvPolynomial.X 0 * MvPolynomial.X 1)} := by
          refine (Ideal.map_mono hKer_πN).trans ?_
          rw [Ideal.map_sup, Ideal.map_map, Ideal.map_span, Set.image_singleton]
          have hEqR : (algebraMap B_X Q₀).comp (algebraMap R B_X) = algebraMap R Q₀ :=
            RingHom.ext fun r => (IsScalarTower.algebraMap_apply R B_X Q₀ r).symm
          rw [hEqR]
        exact hle_BX hm
    have hqS₀_ker : RingHom.ker (q_A''.comp ψ.toRingHom) ≤
        Ideal.map (algebraMap R S₀) m_R ⊔
          Ideal.span {φ_X₀ (MvPolynomial.X 0 * MvPolynomial.X 1)} := by
      intro s hs
      obtain ⟨n, y, hsy⟩ := IsLocalization.Away.surj Δ₀ s
      have hy0 : y ∈ RingHom.ker q₀ := by
        change q₀ y = 0
        have h1 := congrArg (q_A''.comp ψ.toRingHom) hsy
        rw [map_mul, map_pow] at h1
        change q_A'' (ψ s) * (q_A'' (ψ (ι_QS Δ₀))) ^ n =
          q_A'' (ψ (ι_QS y)) at h1
        rw [hqS₀_Q₀, hqS₀_Q₀] at h1
        have hs0 : q_A'' (ψ s) = 0 := hs
        rw [hs0, zero_mul] at h1
        exact h1.symm
      have hy_mem := hKer_q₀ hy0
      have hay_mem : ι_QS y ∈
          Ideal.map (algebraMap R S₀) m_R ⊔
            Ideal.span {φ_X₀ (MvPolynomial.X 0 * MvPolynomial.X 1)} := by
        have hm := Ideal.mem_map_of_mem ι_QS hy_mem
        rw [Ideal.map_sup, Ideal.map_map, Ideal.map_span, Set.image_singleton] at hm
        have hEqR : ι_QS.comp (algebraMap R Q₀) = algebraMap R S₀ :=
          RingHom.ext fun r => (IsScalarTower.algebraMap_apply R Q₀ S₀ r).symm
        have hEqX : ι_QS (algebraMap B_X Q₀ (MvPolynomial.X 0 * MvPolynomial.X 1)) =
            φ_X₀ (MvPolynomial.X 0 * MvPolynomial.X 1) :=
          (IsScalarTower.algebraMap_apply B_X Q₀ S₀ _).symm
        rwa [hEqR, hEqX] at hm
      obtain ⟨u_Δ, hu_Δ⟩ := (IsLocalization.Away.algebraMap_isUnit (S := S₀) Δ₀).pow n
      have hsu : s = ι_QS y * ↑u_Δ⁻¹ := by
        have h1 : s * (u_Δ : S₀) = ι_QS y := by rw [hu_Δ, hsy]
        rw [← h1, mul_assoc, Units.mul_inv, mul_one]
      rw [hsu]
      exact Ideal.mul_mem_right _ _ hay_mem
    exact ⟨S₀, instCommS₀, instAlgRS₀, A'', instCommA'', instAlgRA'', instAlgA'A'',
      instTowerRA'', φ_X₀, ψ, q_A'', hFP_S₀, hEt_φX₀, hEt_ιA', hSurj_ψ,
      hqA''_comp, hqA''_ker, hqS₀_φX₀, hqS₀_ker⟩

  obtain ⟨S₀, instCommS₀, instAlgRS₀, A'', instCommA'', instAlgRA'', instAlgA'A'',
      instTowerRA'', φ_X₀, ψ, q_A'', hFP_S₀, hEt_φX₀, hEt_ιA', hSurj_ψ,
      hqA''_comp, hqA''_ker, hqS₀_φX₀, hqS₀_ker⟩ := hStage2
  letI : CommRing S₀ := instCommS₀
  letI : Algebra R S₀ := instAlgRS₀
  haveI : Algebra.FinitePresentation R S₀ := hFP_S₀
  letI : CommRing A'' := instCommA''
  letI : Algebra R A'' := instAlgRA''
  letI : Algebra A' A'' := instAlgA'A''
  haveI : IsScalarTower R A' A'' := instTowerRA''
  haveI : Algebra.Etale A' A'' := RingHom.etale_algebraMap.mp hEt_ιA'
  haveI : Module.Flat R A'' := by
    haveI : Module.Flat R A' := hFlat_A'
    haveI : Module.Flat A' A'' := Algebra.Smooth.flat A' A''
    exact Module.Flat.trans R A' A''
  haveI : Algebra.FinitePresentation R A'' := by
    haveI : Algebra.FinitePresentation A' A'' := Algebra.Etale.finitePresentation
    exact Algebra.FinitePresentation.trans R A' A''

  
  let x₀ : S₀ := φ_X₀ (MvPolynomial.X 0 * MvPolynomial.X 1)
  have hx₀ : ψ x₀ ∈ Ideal.map (algebraMap R A'') m_R := by
    apply hqA''_ker
    change ((q_A''.comp ψ.toRingHom).comp φ_X₀.toRingHom)
      (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
    rw [hqS₀_φX₀]
    change ψ₂ (Ideal.Quotient.mk (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})
      (MvPolynomial.map (IsLocalRing.residue R) (MvPolynomial.X 0 * MvPolynomial.X 1))) = 0
    rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
  have hKerSub : RingHom.ker ψ.toRingHom ≤
      Ideal.map (algebraMap R S₀) m_R ⊔ Ideal.span {x₀} := by
    intro s hs
    apply hqS₀_ker
    change q_A'' (ψ s) = 0
    have hs0 : ψ s = 0 := hs
    rw [hs0, map_zero]

  
  let M_S₀ : Ideal S₀ := Ideal.map (algebraMap R S₀) m_R
  have hStage3 : ∃ (r F₀ : S₀)
      (S_R : Type u) (_ : CommRing S_R) (_ : Algebra R S_R) (_ : Algebra S₀ S_R)
      (_ : IsScalarTower R S₀ S_R) (_ : IsLocalization.Away r S_R)
      (F : S_R)
      (β_A'' : A'' →+* (S_R ⧸ Ideal.span {F})),
      r - 1 ∈ M_S₀ ∧
      F₀ - x₀ ∈ M_S₀ ∧
      F = algebraMap S₀ S_R F₀ ∧
      RingHom.Etale (algebraMap S₀ S_R) ∧
      RingHom.Etale β_A'' ∧
      (∀ s : S₀, β_A'' (ψ s) = Ideal.Quotient.mk (Ideal.span {F}) (algebraMap S₀ S_R s)) := by
    let K : Ideal S₀ := RingHom.ker ψ.toRingHom
    have hx₀_map : ψ x₀ ∈ Ideal.map ψ.toRingHom M_S₀ := by
      dsimp [M_S₀]
      rw [Ideal.map_map]
      have hEqMap : (ψ : S₀ →+* A'').comp (algebraMap R S₀) = algebraMap R A'' :=
        RingHom.ext ψ.commutes
      rwa [hEqMap]
    obtain ⟨w_corr, hw_corr_mem, hw_corr_eq⟩ :=
      (Ideal.mem_map_iff_of_surjective ψ.toRingHom hSurj_ψ).mp hx₀_map
    let F₀ : S₀ := x₀ - w_corr
    have hF₀_x₀ : F₀ - x₀ ∈ M_S₀ := by
      have hEq : F₀ - x₀ = -w_corr := sub_sub_cancel_left x₀ w_corr
      rw [hEq]
      exact M_S₀.neg_mem hw_corr_mem
    have hF₀_K : F₀ ∈ K := by
      change ψ (x₀ - w_corr) = 0
      have hw_eq : ψ w_corr = ψ x₀ := hw_corr_eq
      rw [map_sub, hw_eq, sub_self]
    have hSpanF₀_K : Ideal.span {F₀} ≤ K :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hF₀_K)
    have hKer_F₀ : K ≤ M_S₀ ⊔ Ideal.span {F₀} := by
      refine hKerSub.trans (sup_le le_sup_left ?_)
      rw [Ideal.span_le, Set.singleton_subset_iff]
      have hx₀_eq : x₀ = w_corr + F₀ := by dsimp [F₀]; ring
      rw [hx₀_eq]
      exact Submodule.add_mem_sup hw_corr_mem (Ideal.mem_span_singleton_self F₀)
    have hFactor : ∀ z ∈ M_S₀, ∃ m ∈ m_R, ∃ u : S₀, z = algebraMap R S₀ m * u := by
      intro z hz
      refine Submodule.span_induction
        (fun w hw => ?_)
        ⟨0, m_R.zero_mem, 0, by simp⟩
        (fun z₁ z₂ _ _ ih₁ ih₂ => ?_)
        (fun s z₁ _ ih => ?_) hz
      · rcases hw with ⟨m, hm, rfl⟩
        exact ⟨m, hm, 1, (mul_one _).symm⟩
      · obtain ⟨m₁, hm₁, u₁, rfl⟩ := ih₁
        obtain ⟨m₂, hm₂, u₂, rfl⟩ := ih₂
        rcases ((ValuationRing.iff_dvd_total (R := R)).mp inferInstance).total m₁ m₂ with
          ⟨d, rfl⟩ | ⟨d, rfl⟩
        · exact ⟨m₁, hm₁, u₁ + algebraMap R S₀ d * u₂, by rw [map_mul]; ring⟩
        · exact ⟨m₂, hm₂, algebraMap R S₀ d * u₁ + u₂, by rw [map_mul]; ring⟩
      · obtain ⟨m, hm, u, rfl⟩ := ih
        exact ⟨m, hm, s * u, by change s * (algebraMap R S₀ m * u) = _; ring⟩
    have hK_le_sup : (K : Submodule S₀ S₀) ≤
        (Ideal.span {F₀} : Submodule S₀ S₀) ⊔ M_S₀ • (K : Submodule S₀ S₀) := by
      intro x hx
      rcases Submodule.mem_sup.mp (hKer_F₀ hx) with ⟨z, hz_M, y, hy_F, rfl⟩
      have hy_K : y ∈ K := hSpanF₀_K hy_F
      have hz_K : z ∈ K := by
        have hzy : z = (z + y) - y := (add_sub_cancel_right z y).symm
        rw [hzy]
        exact K.sub_mem hx hy_K
      obtain ⟨m, hm, u, rfl⟩ := hFactor z hz_M
      have hz_smul : algebraMap R S₀ m * u ∈ M_S₀ • (K : Submodule S₀ S₀) := by
        by_cases hm0 : m = 0
        · rw [hm0, map_zero, zero_mul]
          exact Submodule.zero_mem _
        · have hsmul0 : m • ψ u = 0 := by
            rw [Algebra.smul_def, ← ψ.commutes, ← map_mul]
            exact hz_K
          haveI : Module.IsTorsionFree R A'' := inferInstance
          have hu0 : ψ u = 0 := (smul_eq_zero.mp hsmul0).resolve_left hm0
          have hu_K : u ∈ K := hu0
          exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hm) hu_K
      rw [add_comm]
      exact Submodule.add_mem_sup hy_F hz_smul
    have hK_fg : (K : Submodule S₀ S₀).FG :=
      Algebra.FinitePresentation.ker_fG_of_surjective ψ hSurj_ψ
    obtain ⟨r, hr_one, hr_smul⟩ :=
      Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hK_fg le_rfl hK_le_sup
    obtain ⟨S_R, instCommSR, instAlgRSR, instAlgS₀SR, instTowerSR, instLocSR⟩ :
        ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra S₀ T)
          (_ : IsScalarTower R S₀ T), IsLocalization.Away r T :=
      ⟨Localization.Away r, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance⟩
    obtain ⟨A''', instCommA''', instAlgRA''', instAlgA''A''', instTowerA''', instLocA'''⟩ :
        ∃ (T : Type u) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra A'' T)
          (_ : IsScalarTower R A'' T), IsLocalization.Away (ψ r) T :=
      ⟨Localization.Away (ψ r), inferInstance, inferInstance, inferInstance, inferInstance, inferInstance⟩
    haveI : Algebra.Etale S₀ S_R := Algebra.Etale.of_isLocalizationAway r
    haveI : Algebra.Etale A'' A''' := Algebra.Etale.of_isLocalizationAway (ψ r)
    have hEt_S₀_SR : RingHom.Etale (algebraMap S₀ S_R) := RingHom.etale_algebraMap.mpr inferInstance
    have hEt_A''_A''' : RingHom.Etale (algebraMap A'' A''') := RingHom.etale_algebraMap.mpr inferInstance
    let F : S_R := algebraMap S₀ S_R F₀
    have hUnit_ψr : IsUnit (((algebraMap A'' A''').comp ψ.toRingHom) r) :=
      IsLocalization.Away.algebraMap_isUnit (S := A''') (ψ r)
    let ψ_r : S_R →+* A''' :=
      IsLocalization.Away.lift r (g := (algebraMap A'' A''').comp ψ.toRingHom) hUnit_ψr
    have hψr_eq : ∀ s : S₀, ψ_r (algebraMap S₀ S_R s) = algebraMap A'' A''' (ψ s) :=
      IsLocalization.Away.lift_eq r hUnit_ψr
    have hSurj_ψr : Function.Surjective ψ_r := by
      intro w
      obtain ⟨k, a'', hwa⟩ := IsLocalization.Away.surj (ψ r) w
      obtain ⟨s, rfl⟩ := hSurj_ψ a''
      obtain ⟨u_r, hu_r⟩ := (IsLocalization.Away.algebraMap_isUnit (S := S_R) r).pow k
      refine ⟨algebraMap S₀ S_R s * ↑u_r⁻¹, ?_⟩
      obtain ⟨u_pr, hu_pr⟩ := (IsLocalization.Away.algebraMap_isUnit (S := A''') (ψ r)).pow k
      have hmul_eq : ψ_r (algebraMap S₀ S_R s * ↑u_r⁻¹) * (u_pr : A''') = w * (u_pr : A''') := by
        calc
          ψ_r (algebraMap S₀ S_R s * ↑u_r⁻¹) * (u_pr : A''')
            = ψ_r (algebraMap S₀ S_R s * ↑u_r⁻¹) * ψ_r (u_r : S_R) := by
              rw [hu_pr, hu_r, map_pow, hψr_eq]
          _ = ψ_r (algebraMap S₀ S_R s * (↑u_r⁻¹ * (u_r : S_R))) := by rw [← map_mul, mul_assoc]
          _ = algebraMap A'' A''' (ψ s) := by rw [Units.inv_mul, mul_one, hψr_eq]
          _ = w * (u_pr : A''') := by rw [hu_pr, hwa]
      calc
        ψ_r (algebraMap S₀ S_R s * ↑u_r⁻¹)
          = (ψ_r (algebraMap S₀ S_R s * ↑u_r⁻¹) * (u_pr : A''')) * ↑u_pr⁻¹ := by
            rw [mul_assoc, Units.mul_inv, mul_one]
        _ = (w * (u_pr : A''')) * ↑u_pr⁻¹ := by rw [hmul_eq]
        _ = w := by rw [mul_assoc, Units.mul_inv, mul_one]
    have hKer_ψr : RingHom.ker ψ_r = Ideal.span {F} := by
      apply le_antisymm
      · intro y hy
        obtain ⟨k, s, hys⟩ := IsLocalization.Away.surj r y
        have hs0 : algebraMap A'' A''' (ψ s) = 0 := by
          have h1 := congrArg ψ_r hys
          rw [map_mul, map_pow, hψr_eq, hψr_eq] at h1
          have hy0 : ψ_r y = 0 := hy
          rw [hy0, zero_mul] at h1
          exact h1.symm
        rw [IsLocalization.map_eq_zero_iff (Submonoid.powers (ψ r)) A'''] at hs0
        obtain ⟨⟨_, n, rfl⟩, hn0⟩ := hs0
        have hrns_K : r ^ n * s ∈ K := by
          change ψ (r ^ n * s) = 0
          rw [map_mul, map_pow]
          exact hn0
        have hr1_span : r * (r ^ n * s) ∈ Ideal.span {F₀} :=
          hr_smul (Submodule.smul_mem_pointwise_smul (r ^ n * s) r (K : Submodule S₀ S₀) hrns_K)
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hr1_span
        obtain ⟨u_rk, hu_rk⟩ :=
          (IsLocalization.Away.algebraMap_isUnit (S := S_R) r).pow (k + n + 1)
        have hy_prod : y * (u_rk : S_R) = F * algebraMap S₀ S_R c := by
          rw [hu_rk]
          calc
            y * (algebraMap S₀ S_R r) ^ (k + n + 1)
              = (y * (algebraMap S₀ S_R r) ^ k) * (algebraMap S₀ S_R r) ^ (n + 1) := by ring
            _ = algebraMap S₀ S_R s * (algebraMap S₀ S_R r) ^ (n + 1) := by rw [hys]
            _ = algebraMap S₀ S_R (r * (r ^ n * s)) := by
              rw [← map_pow, ← map_mul]
              congr 1
              ring
            _ = algebraMap S₀ S_R (F₀ * c) := by rw [hc]
            _ = F * algebraMap S₀ S_R c := map_mul _ F₀ c
        have hy_eq : y = F * (algebraMap S₀ S_R c * ↑u_rk⁻¹) := by
          have h1 : y = (y * (u_rk : S_R)) * ↑u_rk⁻¹ := by
            rw [mul_assoc, Units.mul_inv, mul_one]
          rw [h1, hy_prod, mul_assoc]
        rw [hy_eq]
        exact Ideal.mem_span_singleton.mpr ⟨_, rfl⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        change ψ_r (algebraMap S₀ S_R F₀) = 0
        rw [hψr_eq]
        have hF0 : ψ F₀ = 0 := hF₀_K
        rw [hF0, map_zero]
    let e_quot : (S_R ⧸ Ideal.span {F}) ≃+* A''' :=
      (Ideal.quotEquivOfEq hKer_ψr.symm).trans (RingHom.quotientKerEquivOfSurjective hSurj_ψr)
    have he_quot_mk : ∀ y : S_R, e_quot (Ideal.Quotient.mk (Ideal.span {F}) y) = ψ_r y :=
      fun _ => rfl
    let β_A'' : A'' →+* (S_R ⧸ Ideal.span {F}) :=
      e_quot.symm.toRingHom.comp (algebraMap A'' A''')
    have hEt_βA'' : RingHom.Etale β_A'' :=
      RingHom.Etale.stableUnderComposition (algebraMap A'' A''') e_quot.symm.toRingHom
        hEt_A''_A''' (RingHom.Etale.of_bijective e_quot.symm.bijective)
    have hβ_ψ : ∀ s : S₀,
        β_A'' (ψ s) = Ideal.Quotient.mk (Ideal.span {F}) (algebraMap S₀ S_R s) := by
      intro s
      apply e_quot.injective
      change e_quot (e_quot.symm (algebraMap A'' A''' (ψ s))) =
        e_quot (Ideal.Quotient.mk (Ideal.span {F}) (algebraMap S₀ S_R s))
      rw [e_quot.apply_symm_apply, he_quot_mk, hψr_eq]
    exact ⟨r, F₀, S_R, instCommSR, instAlgRSR, instAlgS₀SR, instTowerSR, instLocSR,
      F, β_A'', hr_one, hF₀_x₀, rfl, hEt_S₀_SR, hEt_βA'', hβ_ψ⟩

  obtain ⟨r, F₀, S_R, instCommSR, instAlgRSR, instAlgS₀SR, instTowerSR, instLocSR,
      F, β_A'', hr_one, hF₀_x₀, hF_eq, hEt_S₀_SR, hEt_βA'', hβ_ψ⟩ := hStage3
  letI : CommRing S_R := instCommSR
  letI : Algebra R S_R := instAlgRSR
  letI : Algebra S₀ S_R := instAlgS₀SR
  haveI : IsScalarTower R S₀ S_R := instTowerSR
  haveI : IsLocalization.Away r S_R := instLocSR

  
  let φ_X : B_X →ₐ[R] S_R := (IsScalarTower.toAlgHom R S₀ S_R).comp φ_X₀
  let α_A : A_R →+* (S_R ⧸ Ideal.span {F}) := (β_A''.comp (algebraMap A' A'')).comp ι₁
  let σ₀ : S₀ →+* k₀ := ε₀.comp (q_A''.comp ψ.toRingHom)
  have hσ₀_R : ∀ c : R, σ₀ (algebraMap R S₀ c) = IsLocalRing.residue R c := by
    intro c
    have hc_X : algebraMap R S₀ c = φ_X₀ (MvPolynomial.C c) := (φ_X₀.commutes c).symm
    rw [hc_X]
    change ε₀ (((q_A''.comp ψ.toRingHom).comp φ_X₀.toRingHom) (MvPolynomial.C c)) = _
    rw [hqS₀_φX₀]
    change ε₀ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.map (IsLocalRing.residue R) (MvPolynomial.C c)))) = _
    rw [MvPolynomial.map_C]
    exact RingHom.congr_fun hAug (IsLocalRing.residue R c)
  have hMS₀_ker_σ₀ : M_S₀ ≤ RingHom.ker σ₀ := by
    dsimp [M_S₀]
    rw [Ideal.map_le_iff_le_comap]
    intro m hm
    change σ₀ (algebraMap R S₀ m) = 0
    rw [hσ₀_R, ← RingHom.mem_ker, IsLocalRing.ker_residue]
    exact hm
  have hσ₀_r : σ₀ r = 1 := by
    have hr0 : σ₀ (r - 1) = 0 := hMS₀_ker_σ₀ hr_one
    rw [map_sub, map_one, sub_eq_zero] at hr0
    exact hr0
  have hUnit_σ₀r : IsUnit (σ₀ r) := by
    rw [hσ₀_r]
    exact isUnit_one
  let σ_bar : S_R →+* k₀ := IsLocalization.Away.lift r (g := σ₀) hUnit_σ₀r
  have hσbar_eq : ∀ s : S₀, σ_bar (algebraMap S₀ S_R s) = σ₀ s :=
    IsLocalization.Away.lift_eq r hUnit_σ₀r
  have hσ₀_Xi : ∀ i : Fin 2, σ₀ (φ_X₀ (MvPolynomial.X i)) = 0 := by
    intro i
    change ε₀ (((q_A''.comp ψ.toRingHom).comp φ_X₀.toRingHom) (MvPolynomial.X i)) = 0
    rw [hqS₀_φX₀]
    change ε₀ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.map (IsLocalRing.residue R) (MvPolynomial.X i)))) = 0
    rw [MvPolynomial.map_X]
    exact hX₀ i
  have hSpanF_ker : ∀ y ∈ Ideal.span {F}, σ_bar y = 0 := by
    intro y hy
    have hle : Ideal.span {F} ≤ RingHom.ker σ_bar := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      change σ_bar F = 0
      rw [hF_eq, hσbar_eq]
      have hdiff0 : σ₀ (F₀ - x₀) = 0 := hMS₀_ker_σ₀ hF₀_x₀
      have hx₀_0 : σ₀ x₀ = 0 := by
        dsimp [x₀]
        rw [map_mul, map_mul, hσ₀_Xi 0, zero_mul]
      rw [map_sub, hx₀_0, sub_zero] at hdiff0
      exact hdiff0
    exact hle hy
  let σ_bar_quot : (S_R ⧸ Ideal.span {F}) →+* k₀ :=
    Ideal.Quotient.lift (Ideal.span {F}) σ_bar hSpanF_ker

  refine ⟨S_R, instCommSR, instAlgRSR, φ_X, σ_bar, F, σ_bar_quot, α_A,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · 
    exact RingHom.Etale.stableUnderComposition φ_X₀.toRingHom (algebraMap S₀ S_R)
      hEt_φX₀ hEt_S₀_SR
  · 
    ext c
    change σ_bar (algebraMap R S_R c) = IsLocalRing.residue R c
    rw [IsScalarTower.algebraMap_apply R S₀ S_R c, hσbar_eq, hσ₀_R]
  · 
    intro i
    change σ_bar (algebraMap S₀ S_R (φ_X₀ (MvPolynomial.X i))) = 0
    rw [hσbar_eq, hσ₀_Xi i]
  · 
    have hEqSub : F - φ_X (MvPolynomial.X 0 * MvPolynomial.X 1) = algebraMap S₀ S_R (F₀ - x₀) := by
      rw [map_sub, hF_eq]
      rfl
    rw [hEqSub]
    have hm := Ideal.mem_map_of_mem (algebraMap S₀ S_R) hF₀_x₀
    dsimp [M_S₀] at hm
    rw [Ideal.map_map] at hm
    have hEqR : (algebraMap S₀ S_R).comp (algebraMap R S₀) = algebraMap R S_R :=
      RingHom.ext fun c => (IsScalarTower.algebraMap_apply R S₀ S_R c).symm
    rwa [hEqR] at hm
  · 
    exact RingHom.Etale.stableUnderComposition ι₁ (β_A''.comp (algebraMap A' A'')) hEt_ι₁
      (RingHom.Etale.stableUnderComposition (algebraMap A' A'') β_A'' hEt_ιA' hEt_βA'')
  · 
    ext c
    change β_A'' (algebraMap A' A'' (ι₁ (algebraMap R A_R c))) =
      Ideal.Quotient.mk (Ideal.span {F}) (algebraMap R S_R c)
    have hcA' : ι₁ (algebraMap R A_R c) = algebraMap R A' c := rfl
    rw [hcA', ← IsScalarTower.algebraMap_apply R A' A'' c, ← ψ.commutes c, hβ_ψ,
      ← IsScalarTower.algebraMap_apply R S₀ S_R c]
  · 
    rfl
  · 
    have hσ_β : ∀ a'' : A'', σ_bar_quot (β_A'' a'') = ε₀ (q_A'' a'') := by
      intro a''
      obtain ⟨s, rfl⟩ := hSurj_ψ a''
      rw [hβ_ψ]
      change σ_bar (algebraMap S₀ S_R s) = ε₀ (q_A'' (ψ s))
      rw [hσbar_eq]
      rfl
    ext a
    change σ_bar_quot (β_A'' (algebraMap A' A'' (ι₁ a))) = ε₀ (ψ₁ (q_A a))
    rw [hσ_β]
    have h1 := RingHom.congr_fun hqA''_comp (ι₁ a)
    dsimp at h1
    rw [h1]
    have h2 := RingHom.congr_fun hqA'_comp a
    dsimp at h2
    rw [h2]

theorem weil_henselian_etale_plane_critical_quadratic_normal_form (R : Type u) [CommRing R] [IsLocalRing R]
    (hHensSec : ∀ (E_R : Type u) [CommRing E_R] [Algebra R E_R] [Algebra.Etale R E_R]
      (σ_E : E_R →+* IsLocalRing.ResidueField R),
      σ_E.comp (algebraMap R E_R) = IsLocalRing.residue R →
      ∃ σ : E_R →ₐ[R] R, (IsLocalRing.residue R).comp σ.toRingHom = σ_E)
    (S_R : Type u) [CommRing S_R] [Algebra R S_R]
    (φ_X : MvPolynomial (Fin 2) R →ₐ[R] S_R)
    (hEtX : RingHom.Etale φ_X.toRingHom)
    (σ_bar : S_R →+* IsLocalRing.ResidueField R)
    (hσR : σ_bar.comp (algebraMap R S_R) = IsLocalRing.residue R)
    (hσX : ∀ i : Fin 2, σ_bar (φ_X (MvPolynomial.X i)) = 0)
    (F : S_R)
    (hF_mod : F - φ_X (MvPolynomial.X 0 * MvPolynomial.X 1) ∈
      Ideal.map (algebraMap R S_R) (IsLocalRing.maximalIdeal R)) :
    ∃ (S₄ : Type u) (_ : CommRing S₄) (_ : Algebra R S₄)
      (ι₄ : S_R →ₐ[R] S₄)
      (ι₄_quot : (S_R ⧸ Ideal.span {F}) →+* (S₄ ⧸ Ideal.span {ι₄ F}))
      (φ_X' : MvPolynomial (Fin 2) R →ₐ[R] S₄)
      (σ_bar₄ : S₄ →+* IsLocalRing.ResidueField R)
      (δ : R) (A₀₀ A₀₁ A₁₁ : S₄),
      RingHom.Etale ι₄_quot ∧
      ι₄_quot.comp (Ideal.Quotient.mk (Ideal.span {F})) =
        (Ideal.Quotient.mk (Ideal.span {ι₄ F})).comp ι₄.toRingHom ∧
      RingHom.Etale φ_X'.toRingHom ∧
      σ_bar₄.comp ι₄.toRingHom = σ_bar ∧
      σ_bar₄.comp (algebraMap R S₄) = IsLocalRing.residue R ∧
      (∀ i : Fin 2, σ_bar₄ (φ_X' (MvPolynomial.X i)) = 0) ∧
      δ ∈ IsLocalRing.maximalIdeal R ∧
      ι₄ F + algebraMap R S₄ δ =
        A₀₀ * (φ_X' (MvPolynomial.X 0)) ^ 2 +
          A₀₁ * (φ_X' (MvPolynomial.X 0)) * (φ_X' (MvPolynomial.X 1)) +
          A₁₁ * (φ_X' (MvPolynomial.X 1)) ^ 2 ∧
      σ_bar₄ A₀₀ = 0 ∧ σ_bar₄ A₀₁ = 1 ∧ σ_bar₄ A₁₁ = 0 :=
by
  let P := MvPolynomial (Fin 2) R
  have mkEtaleDer : ∀ (T : Type u) [CommRing T] [Algebra R T]
      (ψ : P →ₐ[R] T), RingHom.Etale ψ.toRingHom →
      ∃ D_T : Fin 2 → Derivation R T T,
        ∀ (i : Fin 2) (Q : P), D_T i (ψ Q) = ψ (MvPolynomial.pderiv i Q) := by
    intro T _ _ ψ hEtψ
    let _ : Algebra P T := ψ.toRingHom.toAlgebra
    have _ : IsScalarTower R P T := IsScalarTower.of_algebraMap_eq fun r => (ψ.commutes r).symm
    have _ : Algebra.Etale P T := RingHom.Etale.toAlgebra hEtψ
    have _ : Algebra.FormallyEtale P T := inferInstance
    let e := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale R P T
    let D_T : Fin 2 → Derivation R T T := fun i =>
      let dP : Derivation R P T := (Algebra.linearMap P T).compDer (MvPolynomial.pderiv i)
      let lP : Ω[P⁄R] →ₗ[P] T := Derivation.liftKaehlerDifferential dP
      let lT : TensorProduct P T Ω[P⁄R] →ₗ[T] T := LinearMap.liftBaseChange T lP
      (lT.comp e.symm.toLinearMap).compDer (KaehlerDifferential.D R T)
    refine ⟨D_T, fun i Q => ?_⟩
    let dP : Derivation R P T := (Algebra.linearMap P T).compDer (MvPolynomial.pderiv i)
    let lP : Ω[P⁄R] →ₗ[P] T := Derivation.liftKaehlerDifferential dP
    let lT : TensorProduct P T Ω[P⁄R] →ₗ[T] T := LinearMap.liftBaseChange T lP
    have heQ : e ((1 : T) ⊗ₜ[P] KaehlerDifferential.D R P Q) =
        KaehlerDifferential.D R T (ψ Q) := by
      rw [KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
        KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
      rfl
    have hsymm : e.symm (KaehlerDifferential.D R T (ψ Q)) =
        (1 : T) ⊗ₜ[P] KaehlerDifferential.D R P Q :=
      (e.symm_apply_eq).mpr heQ.symm
    change lT (e.symm (KaehlerDifferential.D R T (ψ Q))) = ψ (MvPolynomial.pderiv i Q)
    rw [hsymm, LinearMap.liftBaseChange_tmul, one_smul]
    exact Derivation.liftKaehlerDifferential_comp_D dP Q
  have uniqueEtaleDer : ∀ (T₁ T₂ : Type u) [CommRing T₁] [Algebra R T₁] [CommRing T₂] [Algebra R T₂]
      (ψ₁ : P →ₐ[R] T₁), RingHom.Etale ψ₁.toRingHom →
      ∀ (α : T₁ →ₐ[R] T₂) (d₁ : Derivation R T₁ T₁) (d₂ : Derivation R T₂ T₂),
      (∀ j : Fin 2, d₂ (α (ψ₁ (MvPolynomial.X j))) = α (d₁ (ψ₁ (MvPolynomial.X j)))) →
      ∀ s : T₁, d₂ (α s) = α (d₁ s) := by
    intro T₁ T₂ _ _ _ _ ψ₁ hEt₁ α d₁ d₂ hX s
    let _ : Algebra P T₁ := ψ₁.toRingHom.toAlgebra
    have _ : Algebra.Etale P T₁ := RingHom.Etale.toAlgebra hEt₁
    have _ : Algebra.FormallyUnramified P T₁ := inferInstance
    let _ : Algebra T₁ T₂ := α.toRingHom.toAlgebra
    let _ : Algebra P T₂ := (α.comp ψ₁).toRingHom.toAlgebra
    have _ : IsScalarTower P T₁ T₂ := IsScalarTower.of_algebraMap_eq' rfl
    let δ_fn : T₁ → T₂ := fun t => d₂ (α t) - α (d₁ t)
    have hδ_add : ∀ a b : T₁, δ_fn (a + b) = δ_fn a + δ_fn b := fun a b => by
      dsimp [δ_fn]; simp only [map_add]; ring
    have hδ_leib : ∀ a b : T₁, δ_fn (a * b) = α a * δ_fn b + α b * δ_fn a := fun a b => by
      dsimp [δ_fn]
      rw [map_mul, Derivation.leibniz, Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul,
        smul_eq_mul, smul_eq_mul, map_mul, map_mul]
      ring
    have hδ_P : ∀ Q : P, δ_fn (ψ₁ Q) = 0 := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C r =>
        dsimp [δ_fn]
        have hC : ψ₁ (MvPolynomial.C r) = algebraMap R T₁ r := by
          rw [← MvPolynomial.algebraMap_eq]
          exact ψ₁.commutes r
        rw [hC, α.commutes r, Derivation.map_algebraMap, Derivation.map_algebraMap, map_zero, sub_self]
      | add p q hp hq =>
        rw [map_add, hδ_add, hp, hq, add_zero]
      | mul_X p j hp =>
        rw [map_mul, hδ_leib, hp, mul_zero, add_zero]
        have hj : δ_fn (ψ₁ (MvPolynomial.X j)) = 0 := sub_eq_zero.mpr (hX j)
        rw [hj, mul_zero]
    let δ : Derivation P T₁ T₂ :=
      { toFun := δ_fn
        map_add' := hδ_add
        map_smul' := fun Q t => by
          change δ_fn (ψ₁ Q * t) = α (ψ₁ Q) * δ_fn t
          rw [hδ_leib, hδ_P Q, mul_zero, add_zero]
        map_one_eq_zero' := by simpa using hδ_P 1
        leibniz' := fun a b => hδ_leib a b }
    have _ : Subsingleton Ω[T₁⁄P] :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    have h0 : δ s = 0 := by
      rw [← Derivation.liftKaehlerDifferential_comp_D δ s]
      rw [Subsingleton.elim (KaehlerDifferential.D P T₁ s) 0, map_zero]
    exact sub_eq_zero.mp h0
  have hStep1 : ∃ (D : Fin 2 → Derivation R S_R S_R) (σ_crit : S_R →ₐ[R] R),
      (∀ (i : Fin 2) (Q : P), D i (φ_X Q) = φ_X (MvPolynomial.pderiv i Q)) ∧
      (IsLocalRing.residue R).comp σ_crit.toRingHom = σ_bar ∧
      (∀ i : Fin 2, σ_crit (D i F) = 0) := by
    obtain ⟨D, hD⟩ := mkEtaleDer S_R φ_X hEtX
    let x : Fin 2 → S_R := fun j => φ_X (MvPolynomial.X j)
    have hDx00 : D 0 (x 0) = 1 := by dsimp [x]; rw [hD, MvPolynomial.pderiv_X]; simp
    have hDx01 : D 0 (x 1) = 0 := by dsimp [x]; rw [hD, MvPolynomial.pderiv_X]; simp
    have hDx10 : D 1 (x 0) = 0 := by dsimp [x]; rw [hD, MvPolynomial.pderiv_X]; simp
    have hDx11 : D 1 (x 1) = 1 := by dsimp [x]; rw [hD, MvPolynomial.pderiv_X]; simp
    let M_S : Ideal S_R := Ideal.map (algebraMap R S_R) (IsLocalRing.maximalIdeal R)
    have hM_ker : ∀ {y : S_R}, y ∈ M_S → σ_bar y = 0 := by
      have hle : M_S ≤ RingHom.ker σ_bar := by
        rw [Ideal.map_le_iff_le_comap]
        intro m hm
        change (σ_bar.comp (algebraMap R S_R)) m = 0
        rw [hσR]
        exact (IsLocalRing.ker_residue (R := R) ▸ hm : m ∈ RingHom.ker (IsLocalRing.residue R))
      intro y hy; exact hle hy
    have hM_der : ∀ (i : Fin 2) {y : S_R}, y ∈ M_S → D i y ∈ M_S := by
      intro i y hy
      have hpair : y ∈ M_S ∧ D i y ∈ M_S := by
        change y ∈ Ideal.span (algebraMap R S_R '' (IsLocalRing.maximalIdeal R : Set R)) at hy
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
        · rintro _ ⟨m, hm, rfl⟩
          exact ⟨Ideal.mem_map_of_mem _ hm, by rw [Derivation.map_algebraMap]; exact M_S.zero_mem⟩
        · exact ⟨M_S.zero_mem, by rw [map_zero]; exact M_S.zero_mem⟩
        · intro a b _ _ ha hb
          exact ⟨M_S.add_mem ha.1 hb.1, by rw [map_add]; exact M_S.add_mem ha.2 hb.2⟩
        · intro c a _ ha
          refine ⟨M_S.mul_mem_left c ha.1, ?_⟩
          change D i (c * a) ∈ M_S
          rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
          exact M_S.add_mem (M_S.mul_mem_left c ha.2) (M_S.mul_mem_right (D i c) ha.1)
      exact hpair.2
    let w : S_R := F - x 0 * x 1
    have hw : w ∈ M_S := by
      dsimp [w]
      have hx01 : φ_X (MvPolynomial.X 0 * MvPolynomial.X 1) = x 0 * x 1 := map_mul φ_X _ _
      rwa [← hx01]
    have hF_eq : F = x 0 * x 1 + w := by dsimp [w]; ring
    let g₀ : S_R := D 1 F
    let g₁ : S_R := D 0 F
    have hg₀_eq : g₀ = x 0 + D 1 w := by
      dsimp [g₀]; rw [hF_eq, map_add, Derivation.leibniz, smul_eq_mul, smul_eq_mul, hDx10, hDx11]; ring
    have hg₁_eq : g₁ = x 1 + D 0 w := by
      dsimp [g₁]; rw [hF_eq, map_add, Derivation.leibniz, smul_eq_mul, smul_eq_mul, hDx00, hDx01]; ring
    have hσ_g₀ : σ_bar g₀ = 0 := by
      rw [hg₀_eq, map_add, hσX 0, hM_ker (hM_der 1 hw), add_zero]
    have hσ_g₁ : σ_bar g₁ = 0 := by
      rw [hg₁_eq, map_add, hσX 1, hM_ker (hM_der 0 hw), add_zero]
    have hD0g0 : D 0 g₀ = 1 + D 0 (D 1 w) := by rw [hg₀_eq, map_add, hDx00]
    have hD1g0 : D 1 g₀ = D 1 (D 1 w) := by rw [hg₀_eq, map_add, hDx10, zero_add]
    have hD0g1 : D 0 g₁ = D 0 (D 0 w) := by rw [hg₁_eq, map_add, hDx01, zero_add]
    have hD1g1 : D 1 g₁ = 1 + D 1 (D 0 w) := by rw [hg₁_eq, map_add, hDx11]
    let Δ_H : S_R := D 0 g₀ * D 1 g₁ - D 1 g₀ * D 0 g₁
    have hσ_Δ : σ_bar Δ_H = 1 := by
      dsimp [Δ_H]
      rw [map_sub, map_mul, map_mul, hD0g0, hD1g0, hD0g1, hD1g1,
        map_add, map_add, map_one,
        hM_ker (hM_der 0 (hM_der 1 hw)),
        hM_ker (hM_der 1 (hM_der 1 hw)),
        hM_ker (hM_der 0 (hM_der 0 hw)),
        hM_ker (hM_der 1 (hM_der 0 hw))]
      ring
    have hUnit_Δ : IsUnit (σ_bar Δ_H) := hσ_Δ ▸ isUnit_one
    have hCrit : ∀ (S_Δ : Type u) [CommRing S_Δ] [Algebra R S_Δ] [Algebra S_R S_Δ]
        [IsScalarTower R S_R S_Δ] [IsLocalization.Away Δ_H S_Δ],
        ∃ σ_crit : S_R →ₐ[R] R,
          (IsLocalRing.residue R).comp σ_crit.toRingHom = σ_bar ∧
          (∀ i : Fin 2, σ_crit (D i F) = 0) := by
      intro S_Δ _ _ _ _ _
      let ι_Δ : S_R →ₐ[R] S_Δ := IsScalarTower.toAlgHom R S_R S_Δ
      let ψ_Δ : P →ₐ[R] S_Δ := ι_Δ.comp φ_X
      have _ : Algebra.Etale S_R S_Δ := Algebra.Etale.of_isLocalizationAway Δ_H
      have hEt_ιΔ : RingHom.Etale ι_Δ.toRingHom := by
        change RingHom.Etale (algebraMap S_R S_Δ)
        exact RingHom.etale_algebraMap.mpr inferInstance
      have hEt_ψΔ : RingHom.Etale ψ_Δ.toRingHom :=
        RingHom.Etale.stableUnderComposition φ_X.toRingHom ι_Δ.toRingHom hEtX hEt_ιΔ
      obtain ⟨D_Δ, hD_Δ⟩ := mkEtaleDer S_Δ ψ_Δ hEt_ψΔ
      have hD_Δ_comp : ∀ (i : Fin 2) (s : S_R), D_Δ i (ι_Δ s) = ι_Δ (D i s) := by
        intro i s
        refine uniqueEtaleDer S_R S_Δ φ_X hEtX ι_Δ (D i) (D_Δ i) (fun j => ?_) s
        change D_Δ i (ψ_Δ (MvPolynomial.X j)) = ι_Δ (D i (φ_X (MvPolynomial.X j)))
        rw [hD_Δ, hD]; rfl
      have hD_Δ_x00 : D_Δ 0 (ι_Δ (x 0)) = 1 := by rw [hD_Δ_comp, hDx00, map_one]
      have hD_Δ_x01 : D_Δ 0 (ι_Δ (x 1)) = 0 := by rw [hD_Δ_comp, hDx01, map_zero]
      have hD_Δ_x10 : D_Δ 1 (ι_Δ (x 0)) = 0 := by rw [hD_Δ_comp, hDx10, map_zero]
      have hD_Δ_x11 : D_Δ 1 (ι_Δ (x 1)) = 1 := by rw [hD_Δ_comp, hDx11, map_one]
      let I_crit : Ideal S_Δ := Ideal.span {ι_Δ g₀, ι_Δ g₁}
      let E_crit : Type u := S_Δ ⧸ I_crit
      let π_crit : S_Δ →ₐ[R] E_crit := Ideal.Quotient.mkₐ R I_crit
      have hFP_E : Algebra.FinitePresentation R E_crit := by
        let _ : Algebra P S_Δ := ψ_Δ.toRingHom.toAlgebra
        have _ : IsScalarTower R P S_Δ :=
          IsScalarTower.of_algebraMap_eq fun r => (ψ_Δ.commutes r).symm
        have _ : Algebra.Etale P S_Δ := RingHom.Etale.toAlgebra hEt_ψΔ
        have _ : Algebra.FinitePresentation P S_Δ := inferInstance
        have _ : Algebra.FinitePresentation R S_Δ := Algebra.FinitePresentation.trans R P S_Δ
        let _ : DecidableEq S_Δ := Classical.decEq S_Δ
        have hFG : I_crit.FG := ⟨{ι_Δ g₀, ι_Δ g₁}, by simp [I_crit]⟩
        exact Algebra.FinitePresentation.quotient hFG
      have hFE_E : Algebra.FormallyEtale R E_crit := by
        rw [Algebra.FormallyEtale.iff_comp_bijective]
        intro B _ _ I hI
        let q : B →ₐ[R] B ⧸ I := Ideal.Quotient.mkₐ R I
        have hI_mul : ∀ {e₁ e₂ : B}, e₁ ∈ I → e₂ ∈ I → e₁ * e₂ = 0 := by
          intro e₁ e₂ he₁ he₂
          have h : e₁ * e₂ ∈ I ^ 2 := by rw [sq]; exact Ideal.mul_mem_mul he₁ he₂
          rwa [hI, Submodule.mem_bot] at h
        let perturb : ∀ (β₀ : S_Δ →ₐ[R] B) (ε₀ ε₁ : B), ε₀ ∈ I → ε₁ ∈ I → S_Δ →ₐ[R] B :=
          fun β₀ ε₀ ε₁ hε₀ hε₁ =>
            { toFun := fun s => β₀ s + ε₀ * β₀ (D_Δ 0 s) + ε₁ * β₀ (D_Δ 1 s)
              map_one' := by simp
              map_mul' := fun a b => by
                simp only [map_mul, Derivation.leibniz, smul_eq_mul, map_add]
                have h00 : ε₀ * ε₀ = 0 := hI_mul hε₀ hε₀
                have h01 : ε₀ * ε₁ = 0 := hI_mul hε₀ hε₁
                have h11 : ε₁ * ε₁ = 0 := hI_mul hε₁ hε₁
                linear_combination
                  -(β₀ (D_Δ 0 a) * β₀ (D_Δ 0 b)) * h00 -
                  (β₀ (D_Δ 0 a) * β₀ (D_Δ 1 b) + β₀ (D_Δ 1 a) * β₀ (D_Δ 0 b)) * h01 -
                  (β₀ (D_Δ 1 a) * β₀ (D_Δ 1 b)) * h11
              map_zero' := by simp
              map_add' := fun a b => by simp only [map_add]; ring
              commutes' := fun r => by simp [AlgHom.commutes, Derivation.map_algebraMap] }
        have hTaylor : ∀ (β₁ β₂ : S_Δ →ₐ[R] B),
            q.comp β₁ = q.comp β₂ →
            ∃ (hε₀ : β₂ (ι_Δ (x 0)) - β₁ (ι_Δ (x 0)) ∈ I)
              (hε₁ : β₂ (ι_Δ (x 1)) - β₁ (ι_Δ (x 1)) ∈ I),
              β₂ = perturb β₁ (β₂ (ι_Δ (x 0)) - β₁ (ι_Δ (x 0)))
                (β₂ (ι_Δ (x 1)) - β₁ (ι_Δ (x 1))) hε₀ hε₁ := by
          intro β₁ β₂ hq
          have hker : ∀ s : S_Δ, β₂ s - β₁ s ∈ I := fun s => by
            rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
            exact (AlgHom.congr_fun hq s).symm
          have hε₀ : β₂ (ι_Δ (x 0)) - β₁ (ι_Δ (x 0)) ∈ I := hker _
          have hε₁ : β₂ (ι_Δ (x 1)) - β₁ (ι_Δ (x 1)) ∈ I := hker _
          refine ⟨hε₀, hε₁, ?_⟩
          let β₁' := perturb β₁ _ _ hε₀ hε₁
          have hcompP : β₁'.comp ψ_Δ = β₂.comp ψ_Δ := by
            apply MvPolynomial.algHom_ext
            intro j
            fin_cases j
            · change β₁ (ι_Δ (x 0)) + (β₂ (ι_Δ (x 0)) - β₁ (ι_Δ (x 0))) * β₁ (D_Δ 0 (ι_Δ (x 0))) +
                (β₂ (ι_Δ (x 1)) - β₁ (ι_Δ (x 1))) * β₁ (D_Δ 1 (ι_Δ (x 0))) = β₂ (ι_Δ (x 0))
              rw [hD_Δ_x00, hD_Δ_x10, map_one, map_zero]; ring
            · change β₁ (ι_Δ (x 1)) + (β₂ (ι_Δ (x 0)) - β₁ (ι_Δ (x 0))) * β₁ (D_Δ 0 (ι_Δ (x 1))) +
                (β₂ (ι_Δ (x 1)) - β₁ (ι_Δ (x 1))) * β₁ (D_Δ 1 (ι_Δ (x 1))) = β₂ (ι_Δ (x 1))
              rw [hD_Δ_x01, hD_Δ_x11, map_zero, map_one]; ring
          let _ : Algebra P S_Δ := ψ_Δ.toRingHom.toAlgebra
          have _ : Algebra.Etale P S_Δ := RingHom.Etale.toAlgebra hEt_ψΔ
          have _ : Algebra.FormallyEtale P S_Δ := inferInstance
          let _ : Algebra P B := (β₂.comp ψ_Δ).toRingHom.toAlgebra
          let β₂_P : S_Δ →ₐ[P] B := { β₂.toRingHom with commutes' := fun _ => rfl }
          let β₁'_P : S_Δ →ₐ[P] B :=
            { β₁'.toRingHom with commutes' := fun Q => AlgHom.congr_fun hcompP Q }
          have hqP : (Ideal.Quotient.mkₐ P I).comp β₂_P = (Ideal.Quotient.mkₐ P I).comp β₁'_P := by
            ext s
            change Ideal.Quotient.mk I (β₂ s) =
              Ideal.Quotient.mk I (β₁ s + (β₂ (ι_Δ (x 0)) - β₁ (ι_Δ (x 0))) * β₁ (D_Δ 0 s) +
                (β₂ (ι_Δ (x 1)) - β₁ (ι_Δ (x 1))) * β₁ (D_Δ 1 s))
            rw [map_add, map_add, map_mul, map_mul,
              Ideal.Quotient.eq_zero_iff_mem.mpr hε₀, Ideal.Quotient.eq_zero_iff_mem.mpr hε₁,
              zero_mul, zero_mul, add_zero, add_zero]
            exact (AlgHom.congr_fun hq s).symm
          have heqP : β₂_P = β₁'_P :=
            (Algebra.FormallyEtale.comp_bijective P S_Δ I hI).1 hqP
          ext s
          exact AlgHom.congr_fun heqP s
        constructor
        · intro α₁ α₂ hqα
          let β₁ : S_Δ →ₐ[R] B := α₁.comp π_crit
          let β₂ : S_Δ →ₐ[R] B := α₂.comp π_crit
          have hqβ : q.comp β₁ = q.comp β₂ := by
            dsimp [β₁, β₂]
            rw [← AlgHom.comp_assoc, hqα, AlgHom.comp_assoc]
          obtain ⟨hε₀, hε₁, hβ₂_eq⟩ := hTaylor β₁ β₂ hqβ
          let ε₀ : B := β₂ (ι_Δ (x 0)) - β₁ (ι_Δ (x 0))
          let ε₁ : B := β₂ (ι_Δ (x 1)) - β₁ (ι_Δ (x 1))
          have hg₀_mem : ι_Δ g₀ ∈ I_crit := Ideal.subset_span (by simp)
          have hg₁_mem : ι_Δ g₁ ∈ I_crit := Ideal.subset_span (by simp)
          have hβ₁_g₀ : β₁ (ι_Δ g₀) = 0 := by
            change α₁ (Ideal.Quotient.mk I_crit (ι_Δ g₀)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hg₀_mem, map_zero]
          have hβ₂_g₀ : β₂ (ι_Δ g₀) = 0 := by
            change α₂ (Ideal.Quotient.mk I_crit (ι_Δ g₀)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hg₀_mem, map_zero]
          have hβ₁_g₁ : β₁ (ι_Δ g₁) = 0 := by
            change α₁ (Ideal.Quotient.mk I_crit (ι_Δ g₁)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hg₁_mem, map_zero]
          have hβ₂_g₁ : β₂ (ι_Δ g₁) = 0 := by
            change α₂ (Ideal.Quotient.mk I_crit (ι_Δ g₁)) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hg₁_mem, map_zero]
          let m₀₀ : B := β₁ (ι_Δ (D 0 g₀))
          let m₀₁ : B := β₁ (ι_Δ (D 1 g₀))
          let m₁₀ : B := β₁ (ι_Δ (D 0 g₁))
          let m₁₁ : B := β₁ (ι_Δ (D 1 g₁))
          have eq0 : ε₀ * m₀₀ + ε₁ * m₀₁ = 0 := by
            have h := AlgHom.congr_fun hβ₂_eq (ι_Δ g₀)
            change β₂ (ι_Δ g₀) = β₁ (ι_Δ g₀) + ε₀ * β₁ (D_Δ 0 (ι_Δ g₀)) +
              ε₁ * β₁ (D_Δ 1 (ι_Δ g₀)) at h
            rw [hβ₂_g₀, hβ₁_g₀, hD_Δ_comp, hD_Δ_comp, zero_add] at h
            exact h.symm
          have eq1 : ε₀ * m₁₀ + ε₁ * m₁₁ = 0 := by
            have h := AlgHom.congr_fun hβ₂_eq (ι_Δ g₁)
            change β₂ (ι_Δ g₁) = β₁ (ι_Δ g₁) + ε₀ * β₁ (D_Δ 0 (ι_Δ g₁)) +
              ε₁ * β₁ (D_Δ 1 (ι_Δ g₁)) at h
            rw [hβ₂_g₁, hβ₁_g₁, hD_Δ_comp, hD_Δ_comp, zero_add] at h
            exact h.symm
          let d_B : B := m₀₀ * m₁₁ - m₀₁ * m₁₀
