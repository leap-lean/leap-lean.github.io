    (Φ₀ : Polynomial K ≃+* ↑(X.presheaf.obj (Opposite.op V₀)))
    (Φ₁ : Polynomial K ≃+* ↑(X.presheaf.obj (Opposite.op V₁)))
    (hC0 : CommRingCat.ofHom (Φ₀.toRingHom.comp Polynomial.C) =
