            (MvPolynomial.X b) (hX_mem R N b)) =
        HomogeneousLocalization.Away.mk 𝒜_S (f_gr.map_mem (hX_mem R N a)) 1
          (MvPolynomial.X b) (hX_mem S N b) := by
      intro a b
      apply HomogeneousLocalization.val_injective (Submonoid.powers (f_gr (MvPolynomial.X a)))
      simp [HomogeneousLocalization.Away.map, HomogeneousLocalization.Away.mk,
        HomogeneousLocalization.map_mk, HomogeneousLocalization.val_mk, hfX b]
    have hSpecPB : ∀ a : Fin (N + 1),
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_S
              (Submonoid.powers (f_gr (MvPolynomial.X a)))).comp (algebraMap S ↥(𝒜_S 0)))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
              (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0)))))
          s_RS := by
      intro a
      let τ := {b : Fin (N + 1) // b ≠ a}
      have hPolyComm : CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial τ R) ≫
          CommRingCat.ofHom (MvPolynomial.map φ_RS) =
          CommRingCat.ofHom φ_RS ≫
            CommRingCat.ofHom (MvPolynomial.C : S →+* MvPolynomial τ S) := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        exact MvPolynomial.map_C φ_RS r
      have hPolyPush : CategoryTheory.IsPushout
          (CommRingCat.ofHom (MvPolynomial.C : R →+* MvPolynomial τ R))
          (CommRingCat.ofHom φ_RS)
          (CommRingCat.ofHom (MvPolynomial.map φ_RS))
          (CommRingCat.ofHom (MvPolynomial.C : S →+* MvPolynomial τ S)) := by
        refine CategoryTheory.IsPushout.of_isColimit
          (Limits.PushoutCocone.IsColimit.mk hPolyComm
            (fun c => CommRingCat.ofHom
              (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b))))
            ?_ ?_ ?_)
        · intro c
          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            have hc := RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp c.condition) r
            change (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b)))
