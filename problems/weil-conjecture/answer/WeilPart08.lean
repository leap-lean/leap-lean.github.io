      have hev := congrArg (fun f => f.base z_U) φ_res.hom_inv_id
      exact hev
    let ψ : U_Y.toScheme ⟶ Z₀ := φ_res.inv ≫ U_Z.ι
    haveI : AlgebraicGeometry.IsOpenImmersion ψ := inferInstance
    have hψ_yU : ψ.base y_U = z := by
      change U_Z.ι.base (φ_res.inv.base y_U) = z
      rw [hφ_inv_yU]
      rfl
    have hψ_snd : ψ ≫ snd_Z0 = U_Y.ι ≫ snd₀ := by
      have h_hom : φ_res.hom ≫ U_Y.ι ≫ snd₀ = U_Z.ι ≫ snd_Z0 := by
        dsimp [φ_res]
        rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι ι_Z0_Y0 U_Y,
          CategoryTheory.Category.assoc, hιZY_snd]
      dsimp [ψ]
      rw [CategoryTheory.Category.assoc, ← h_hom, ← CategoryTheory.Category.assoc,
        φ_res.inv_hom_id, CategoryTheory.Category.id_comp]

    
    have hSmTransport : ∀ V₀ : Y₀.Opens, y₀ ∈ V₀ →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₀.ι ≫ snd₀) →
        ∃ V_Z : Z₀.Opens, z ∈ V_Z ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_Z.ι ≫ snd_Z0) := by
      intro V₀ hy₀V hSm₀
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₀.ι ≫ snd₀) := hSm₀
      let W_Y : U_Y.toScheme.Opens := U_Y.ι ⁻¹ᵁ V₀
      have hy_WY : y_U ∈ W_Y := hy₀V
      let θ : W_Y.toScheme ⟶ Z₀ := W_Y.ι ≫ ψ
      haveI : AlgebraicGeometry.IsOpenImmersion θ := inferInstance
      have hSm_θ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (θ ≫ snd_Z0) := by
        have h_eq : θ ≫ snd_Z0 = (U_Y.ι ∣_ V₀) ≫ (V₀.ι ≫ snd₀) := by
          dsimp [θ]
          rw [CategoryTheory.Category.assoc, hψ_snd, ← CategoryTheory.Category.assoc,
            ← AlgebraicGeometry.morphismRestrict_ι U_Y.ι V₀, CategoryTheory.Category.assoc]
        rw [h_eq]
        have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
            ((U_Y.ι ∣_ V₀) ≫ (V₀.ι ≫ snd₀)) := inferInstance
        simpa using h01
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (θ ≫ snd_Z0) := hSm_θ
      refine ⟨θ.opensRange, ⟨⟨y_U, hy_WY⟩, ?_⟩, ?_⟩
      · change ψ.base y_U = z
        exact hψ_yU
      · have h_range_ι : θ.opensRange.ι ≫ snd_Z0 = θ.isoOpensRange.inv ≫ (θ ≫ snd_Z0) := by
          rw [← CategoryTheory.Category.assoc]
          congr 1
          rw [CategoryTheory.Iso.eq_inv_comp, AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι]
        rw [h_range_ι]
        have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
            (θ.isoOpensRange.inv ≫ (θ ≫ snd_Z0)) := inferInstance
        simpa using h01

    refine ⟨?_, ?_, ?_⟩
    · 
      intro hRed_y0
      haveI : _root_.IsReduced ↑(Y₀.presheaf.stalk y₀) := hRed_y0
      haveI : CategoryTheory.IsIso (φ_res.hom.stalkMap z_U) :=
        AlgebraicGeometry.LocallyRingedSpace.IsOpenImmersion.stalk_iso φ_res.hom.toLRSHom z_U
      let e_Z := U_Z.stalkIso z_U
      let e_φ := CategoryTheory.asIso (φ_res.hom.stalkMap z_U)
      let e_Y := U_Y.stalkIso (φ_res.hom.base z_U)
      have h_pt_eq : (φ_res.hom.base z_U).1 = y₀ := congrArg Subtype.val hφ_zU
      haveI : _root_.IsReduced ↑(Y₀.presheaf.stalk (φ_res.hom.base z_U).1) := by
        rwa [h_pt_eq]
      let e_tot : Z₀.presheaf.stalk z ≅ Y₀.presheaf.stalk (φ_res.hom.base z_U).1 :=
        e_Z.symm ≪≫ e_φ.symm ≪≫ e_Y
      refine ⟨fun s ⟨n, hn⟩ => ?_⟩
      have h0 : e_tot.hom.hom s = 0 := by
        apply eq_zero_of_pow_eq_zero (n := n)
        rw [← map_pow, hn, map_zero]
      have h_back := congrArg e_tot.inv.hom h0
      simpa using h_back
    · 
      rintro (⟨V₀, hy₀V, hSm₀⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hX_mem, hComm_e⟩)
      · exact Or.inl (hSmTransport V₀ hy₀V hSm₀)
      · right
        haveI : AlgebraicGeometry.Etale e₁ := hEt₁
        haveI : AlgebraicGeometry.Etale e₂ := hEt₂
        let U''_open : U'.Opens := e₁ ⁻¹ᵁ U_Y
        have hu₀_mem : u₀ ∈ U''_open := by
          change e₁.base u₀ ∈ U_Y
          rw [hu₀]
          exact hy_UY
        let u'₀ : ↥U''_open.toScheme := ⟨u₀, hu₀_mem⟩
        have hEt_res : AlgebraicGeometry.Etale (e₁ ∣_ U_Y) :=
          CategoryTheory.MorphismProperty.of_isPullback
            (AlgebraicGeometry.isPullback_morphismRestrict e₁ U_Y).flip hEt₁
        haveI : AlgebraicGeometry.Etale (e₁ ∣_ U_Y) := hEt_res
        let e'₁ : U''_open.toScheme ⟶ Z₀ := (e₁ ∣_ U_Y) ≫ ψ
        let e'₂ := U''_open.ι ≫ e₂
        refine ⟨U''_open.toScheme, u'₀, e'₁, e'₂, inferInstance, inferInstance, ?_, ?_, ?_⟩
        · have he1_u : (e₁ ∣_ U_Y).base u'₀ = y_U := by
            apply U_Y.ι.isOpenEmbedding.injective
            have hev := congrArg (fun f => f.base u'₀)
              (AlgebraicGeometry.morphismRestrict_ι e₁ U_Y)
            exact hev.trans hu₀
          change ψ.base ((e₁ ∣_ U_Y).base u'₀) = z
          rw [he1_u, hψ_yU]
        · intro i
          exact hX_mem i
        · change ((e₁ ∣_ U_Y) ≫ ψ) ≫ snd_Z0 = (U''_open.ι ≫ e₂) ≫ _
          rw [CategoryTheory.Category.assoc, hψ_snd, ← CategoryTheory.Category.assoc (e₁ ∣_ U_Y),
            AlgebraicGeometry.morphismRestrict_ι e₁ U_Y, CategoryTheory.Category.assoc,
            hComm_e, CategoryTheory.Category.assoc]
    · 
      rintro ⟨V_sm, hy₀_Vsm, hSm_C⟩
      let V₀ : Y₀.Opens := fst₀ ⁻¹ᵁ V_sm
      have hy₀_V₀ : y₀ ∈ V₀ := hy₀_Vsm
      have hPb_Vsm : CategoryTheory.IsPullback (fst₀ ∣_ V_sm) (V₀.ι ≫ snd₀)
          (V_sm.ι ≫ g_R) s₀ :=
        (AlgebraicGeometry.isPullback_morphismRestrict fst₀ V_sm).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback g_R s₀)
      have hSm_V₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₀.ι ≫ snd₀) :=
        CategoryTheory.MorphismProperty.of_isPullback hPb_Vsm hSm_C
      exact hSmTransport V₀ hy₀_V₀ hSm_V₀

  exact ⟨E_bar, ι_Ebar_C, ι_bar, j_to, ι_Z0_Y0,
    ⟨hOpen_fstK, hDense_fstK, hCl_fst0, hInj_fst0, hClosed_W0⟩,
    ⟨rfl, hCl_EbarC, hCl_ιbar, hInt_Ebar, hFlat_EbarC, hRange_EbarC, hPb_E,
      ⟨hPb_gen.isoPullback, hPb_gen.isoPullback_hom_snd⟩⟩,
    ⟨hCl_ιZY, hInj_ιZY, hιZY_snd, hιZY_fst, hPb_Z0, hRange_ιZY, hCover_Y0⟩,
    hClause4⟩

theorem weil_smooth_or_integrallyClosed_etale_open_generic_preirreducible (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (K_R : Type u) [Field K_R] [Algebra R K_R]
    (s_R : R) [IsLocalization.Away s_R K_R]
    (hEtDom : ∀ (A₀ B₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B₀] [Algebra A₀ B₀] [Algebra.Etale A₀ B₀]
        (q : PrimeSpectrum B₀),
      ∃ g : B₀, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g)) :
    let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))
    (∀ (X : AlgebraicGeometry.Scheme.{u})
        (f : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (W_sm : X.Opens) (x₀ : ↥X),
      x₀ ∈ W_sm →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ f) →
      ∃ U_X : X.Opens,
        x₀ ∈ U_X ∧
        IsPreirreducible ((CategoryTheory.Limits.pullback.fst f η_R).base ⁻¹' (U_X : Set ↥X))) ∧
    (∀ (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        (c₀ : R →+* A₀)
        (W : AlgebraicGeometry.Scheme.{u}) (w₀ : ↥W)
        (e_A : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of A₀)),
      AlgebraicGeometry.Etale e_A →
      ∃ U_W : W.Opens,
        w₀ ∈ U_W ∧
        IsPreirreducible
          ((CategoryTheory.Limits.pullback.fst
            (e_A ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c₀)) η_R).base ⁻¹'
            (U_W : Set ↥W))) ∧
    (∀ (C_R : AlgebraicGeometry.Scheme.{u})
        (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (E Y'_K : Set ↥(CategoryTheory.Limits.pullback g_R η_R)),
      IsClosed E →
      IsClosed Y'_K →
      E ∪ Y'_K = Set.univ →
      (∀ O : Set ↥(CategoryTheory.Limits.pullback g_R η_R),
        IsOpen O → (O ∩ Y'_K).Nonempty → ¬ (O ⊆ E)) →
      (∀ O : Set ↥(CategoryTheory.Limits.pullback g_R η_R),
        IsOpen O → (O ∩ E).Nonempty → ¬ (O ⊆ Y'_K)) →
      ∀ (W : AlgebraicGeometry.Scheme.{u}) (e_C : W ⟶ C_R) (w₀ : ↥W) (U_W : W.Opens),
        AlgebraicGeometry.Etale e_C →
        w₀ ∈ U_W →
        e_C.base w₀ ∈ closure ((CategoryTheory.Limits.pullback.fst g_R η_R).base '' E) →
        e_C.base w₀ ∈ closure ((CategoryTheory.Limits.pullback.fst g_R η_R).base '' Y'_K) →
        ¬ IsPreirreducible
          ((CategoryTheory.Limits.pullback.fst (e_C ≫ g_R) η_R).base ⁻¹' (U_W : Set ↥W))) :=
by
  intro η_R
  
  have hPillarA : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (f_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (U : W.Opens),
      AlgebraicGeometry.IsAffineOpen U →
      IsDomain ↑(W.presheaf.obj (Opposite.op U)) →
      IsPreirreducible ((CategoryTheory.Limits.pullback.fst f_W η_R).base ⁻¹' (U : Set ↥W)) := by
    intro W f_W U hU hDomD
    let fst_W := CategoryTheory.Limits.pullback.fst f_W η_R
    let snd_W := CategoryTheory.Limits.pullback.snd f_W η_R
    let V_K : (CategoryTheory.Limits.pullback f_W η_R).Opens :=
      (TopologicalSpace.Opens.map fst_W.base).obj U
    let D_cat : CommRingCat.{u} := W.presheaf.obj (Opposite.op U)
    let D : Type u := ↑D_cat
    have : IsDomain D := hDomD
    let φ_spec : AlgebraicGeometry.Spec D_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
      hU.fromSpec ≫ f_W
    let φ_cat : CommRingCat.of R ⟶ D_cat := AlgebraicGeometry.Spec.preimage φ_spec
    let c_D : R →+* D := φ_cat.hom
    have h_spec_cD : AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_D) = φ_spec := by
      have h1 : CommRingCat.ofHom c_D = φ_cat := CommRingCat.ofHom_hom φ_cat
      exact (congrArg AlgebraicGeometry.Spec.map h1).trans (AlgebraicGeometry.Spec.map_preimage φ_spec)
    let M : Submonoid R := Submonoid.powers s_R
    have : IsLocalization M K_R := inferInstanceAs (IsLocalization.Away s_R K_R)
    let M_D : Submonoid D := M.map c_D
    let D_loc : Type u := Localization M_D
    let f_loc : K_R →+* D_loc := IsLocalization.map D_loc c_D (Submonoid.le_comap_map M)
    have h_comp : f_loc.comp (algebraMap R K_R) = (algebraMap D D_loc).comp c_D :=
      IsLocalization.map_comp (Submonoid.le_comap_map M)
    have hPush : CategoryTheory.IsPushout
        (CommRingCat.ofHom c_D) (CommRingCat.ofHom (algebraMap R K_R))
        (CommRingCat.ofHom (algebraMap D D_loc)) (CommRingCat.ofHom f_loc) :=
      CommRingCat.isPushout_of_isLocalization c_D f_loc h_comp M
    have hPb_loc0 := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    have hPb_loc : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D D_loc)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_loc))
        φ_spec η_R := by
      simpa only [h_spec_cD] using hPb_loc0
    have hPb_vert : CategoryTheory.IsPullback (fst_W ∣_ U) (V_K.ι ≫ snd_W) (U.ι ≫ f_W) η_R :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst_W U).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback f_W η_R)
    have hComm_iso : CategoryTheory.CommSq hU.isoSpec.hom (U.ι ≫ f_W) φ_spec
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R))) := by
      refine ⟨?_⟩
      dsimp [φ_spec]
      rw [← hU.isoSpec_inv_ι]
      simp
    have hPb_iso : CategoryTheory.IsPullback hU.isoSpec.hom (U.ι ≫ f_W) φ_spec
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R))) :=
      CategoryTheory.IsPullback.of_horiz_isIso hComm_iso
    have hPb_VK : CategoryTheory.IsPullback ((fst_W ∣_ U) ≫ hU.isoSpec.hom) (V_K.ι ≫ snd_W)
        φ_spec η_R := by
      have h := hPb_vert.paste_horiz hPb_iso
      rwa [CategoryTheory.Category.comp_id] at h
    let e_V : AlgebraicGeometry.Spec (CommRingCat.of D_loc) ≅ ↑V_K :=
      hPb_loc.isoPullback ≪≫ hPb_VK.isoPullback.symm
    have hPreSpace : PreirreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of D_loc)) := by
      by_cases h0 : (0 : D) ∈ M_D
      · have : Subsingleton D_loc := IsLocalization.subsingleton h0
        have hEmpty : IsEmpty ↥(AlgebraicGeometry.Spec (CommRingCat.of D_loc)) :=
          ⟨fun p => p.isPrime.ne_top (Subsingleton.elim p.asIdeal ⊤)⟩
        exact ⟨fun _ _ _ _ ⟨p, _⟩ => isEmptyElim p⟩
      · have hLe : M_D ≤ nonZeroDivisors D := by
          intro d hd
          rw [mem_nonZeroDivisors_iff_ne_zero]
          rintro rfl
          exact h0 hd
        have : IsDomain D_loc := IsLocalization.isDomain_localization hLe
        have : IrreducibleSpace (PrimeSpectrum D_loc) := PrimeSpectrum.irreducibleSpace
        exact (inferInstance : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of D_loc))).toPreirreducibleSpace
    have hPreUniv : IsPreirreducible
        (Set.univ : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of D_loc))) :=
      @PreirreducibleSpace.isPreirreducible_univ _ _ hPreSpace
    have hImg := hPreUniv.image (e_V.hom ≫ V_K.ι).base (e_V.hom ≫ V_K.ι).continuous.continuousOn
    have hImgEq : (e_V.hom ≫ V_K.ι).base '' Set.univ = fst_W.base ⁻¹' (U : Set ↥W) := by
      ext z
      simp only [Set.mem_image, Set.mem_univ, true_and]
      constructor
      · rintro ⟨p, rfl⟩
        have h1 : (e_V.hom ≫ V_K.ι).base p = V_K.ι.base (e_V.hom.base p) := by simp
        rw [h1]
        have hmem : V_K.ι.base (e_V.hom.base p) ∈ Set.range V_K.ι.base := ⟨e_V.hom.base p, rfl⟩
        rw [V_K.range_ι] at hmem
        exact hmem
      · intro hz
        have hz' : z ∈ Set.range V_K.ι.base := by
          rw [V_K.range_ι]
          exact hz
        rcases hz' with ⟨y, rfl⟩
        refine ⟨e_V.inv.base y, ?_⟩
        simp
    rwa [hImgEq] at hImg
  refine ⟨?_, ?_, ?_⟩
  · 
    intro X f W_sm x₀ hx₀ hSm
    let S_R := AlgebraicGeometry.Spec (CommRingCat.of R)
    let Y : AlgebraicGeometry.Scheme.{u} := ↑W_sm
    let f_sm : Y ⟶ S_R := W_sm.ι ≫ f
    obtain ⟨y₀, hy₀_eq⟩ : ∃ y₀ : ↥Y, W_sm.ι.base y₀ = x₀ := by
      rw [← Set.mem_range, W_sm.range_ι]
      exact hx₀
    obtain ⟨U_R, hUR, V_W, hVW, hy₀_VW, e_VW, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f_sm).mp hSm y₀
    let A_U : Type u := ↑(S_R.presheaf.obj (Opposite.op U_R))
    let S_V : Type u := ↑(Y.presheaf.obj (Opposite.op V_W))
    let ρ : A_U →+* S_V := (f_sm.appLE U_R V_W e_VW).hom
    let p₀ : PrimeSpectrum R := f_sm.base y₀
    have hp₀_UR : p₀ ∈ (U_R.carrier : Set (PrimeSpectrum R)) := e_VW hy₀_VW
    have hOpen_UR : IsOpen (U_R.carrier : Set (PrimeSpectrum R)) := U_R.isOpen
    obtain ⟨_, ⟨r₀, rfl⟩, hp₀_r₀, hr₀_sub⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hp₀_UR hOpen_UR
    have hr₀_not_mem : r₀ ∉ p₀.asIdeal := hp₀_r₀
    have hr₀_ne : r₀ ≠ 0 := by
      rintro rfl
      exact hr₀_not_mem p₀.asIdeal.zero_mem
    let iso_Γ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)
    let Γ_R : Type u := ↑(S_R.presheaf.obj (Opposite.op ⊤))
    let e_Γ : R ≃+* Γ_R := iso_Γ.symm.commRingCatIsoToRingEquiv
    let s' : Γ_R := iso_Γ.inv.hom r₀
    have hs'_eq : e_Γ r₀ = s' := rfl
    let U_R0 : S_R.Opens := S_R.basicOpen s'
    have hUR0_eq_basic : U_R0 = PrimeSpectrum.basicOpen r₀ :=
      AlgebraicGeometry.basicOpen_eq_of_affine (R := CommRingCat.of R) r₀
    have hp₀_UR0 : p₀ ∈ U_R0 := by
      rw [hUR0_eq_basic]
      exact hp₀_r₀
    have hUR0_le : U_R0 ≤ U_R := by
      rw [hUR0_eq_basic]
      exact hr₀_sub
    let R₀ : Type u := ↑(S_R.presheaf.obj (Opposite.op U_R0))
    have : IsIntegrallyClosed R := inferInstance
    have : IsDomain Γ_R := Function.Injective.isDomain e_Γ.symm.toRingHom e_Γ.symm.injective
    have : IsIntegrallyClosed Γ_R := IsIntegrallyClosed.of_equiv e_Γ
    have hs'_ne : s' ≠ 0 := by
      intro h0
      apply hr₀_ne
      apply e_Γ.injective
      rw [hs'_eq, h0, map_zero]
    have hPow_le : Submonoid.powers s' ≤ nonZeroDivisors Γ_R := by
      rintro _ ⟨k, rfl⟩
      exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero k hs'_ne)
    have : IsLocalization.Away s' R₀ :=
      (AlgebraicGeometry.isAffineOpen_top S_R).isLocalization_basicOpen s'
    have : IsDomain R₀ := IsLocalization.isDomain_of_le_nonZeroDivisors R₀ hPow_le
    have : IsIntegrallyClosed R₀ :=
      isIntegrallyClosed_of_isLocalization R₀ (Submonoid.powers s') hPow_le
    let r_U : A_U := (S_R.presheaf.map (CategoryTheory.homOfLE (le_top : U_R ≤ ⊤)).op).hom s'
    let U_R1 : S_R.Opens := S_R.basicOpen r_U
    have hUR1_eq : U_R1 = U_R0 := by
      dsimp [U_R1, r_U, U_R0]
      rw [S_R.basicOpen_res]
      exact inf_of_le_right hUR0_le
    let R₁ : Type u := ↑(S_R.presheaf.obj (Opposite.op U_R1))
    let e_01 : R₀ ≃+* R₁ :=
      (S_R.presheaf.mapIso (CategoryTheory.eqToIso hUR1_eq).op).commRingCatIsoToRingEquiv
    have : IsDomain R₁ := Function.Injective.isDomain e_01.symm.toRingHom e_01.symm.injective
    have : IsIntegrallyClosed R₁ := IsIntegrallyClosed.of_equiv e_01
    have : IsLocalization (Submonoid.powers r_U) R₁ := hUR.isLocalization_basicOpen r_U
    let f_V : S_V := ρ r_U
    let V_1 : Y.Opens := Y.basicOpen f_V
    have hV1_eq : V_1 = V_W ⊓ (TopologicalSpace.Opens.map f_sm.base).obj U_R1 :=
      AlgebraicGeometry.Scheme.basicOpen_appLE f_sm V_W U_R e_VW r_U
    have hy₀_V1 : y₀ ∈ V_1 := by
      rw [hV1_eq]
      refine ⟨hy₀_VW, ?_⟩
      change p₀ ∈ U_R1
      rwa [hUR1_eq]
    have hV1_aff : AlgebraicGeometry.IsAffineOpen V_1 := hVW.basicOpen f_V
    let S₁ : Type u := ↑(Y.presheaf.obj (Opposite.op V_1))
    have : IsLocalization ((Submonoid.powers r_U).map ρ) S₁ := by
      rw [Submonoid.map_powers]
      exact hVW.isLocalization_basicOpen f_V
    have hStd₁ :=
      RingHom.isStandardSmoothOfRelativeDimension_localizationPreserves 1
        ρ (Submonoid.powers r_U) R₁ S₁ hStd
    obtain ⟨g_mv, _, hg_mv_et⟩ := hStd₁.exists_etale_mvPolynomial
    let e_poly : Polynomial R₁ ≃+* MvPolynomial (Fin 1) R₁ :=
      (MvPolynomial.uniqueAlgEquiv R₁ (Fin 1)).symm.toRingEquiv
    have he_poly_et : e_poly.toRingHom.Etale := RingHom.Etale.of_bijective e_poly.bijective
    let ψ₁ : Polynomial R₁ →+* S₁ := g_mv.comp e_poly.toRingHom
    have hψ₁_et : ψ₁.Etale :=
