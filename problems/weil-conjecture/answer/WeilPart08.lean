    let φ_RB_cat : CommRingCat.of R ⟶ CommRingCat.of B :=
      AlgebraicGeometry.Spec.preimage (ι_V ≫ f)
    have hSpec_φRB : AlgebraicGeometry.Spec.map φ_RB_cat = ι_V ≫ f :=
      AlgebraicGeometry.Spec.map_preimage (ι_V ≫ f)
