  have hx₀_Y' : x₀ ∈ closure (fst_K.base '' Y'_K) := hz_W₀
  have hx₀_Ebar : x₀ =
      ι_Ebar_C.base ((CategoryTheory.Limits.pullback.fst g_Ebar s₀).base z) := by
    have hev := congrArg (fun f => f.base z) hιZY_fst
    simpa [x₀, y₀, fst₀] using hev
