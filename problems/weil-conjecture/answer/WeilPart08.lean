            have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
            have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
            simp [U, hm0, hmL]
          rw [hRest, add_zero, hU00, hUL0]
          simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L.symm]
          ring
        · by_cases hkL : k = L
          · subst hkL
            have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, V L m * U m L) = 0 := by
              refine Finset.sum_eq_zero fun m hm => ?_
              have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
              have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
              simp [U, hm0, hmL]
            rw [hRest, add_zero, hU0L, hULL]
            simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L.symm]
            calc
              -(δ_inv * c_R) * b_R + δ_inv * a_R * d_R
                = δ_inv * Δ_R := by dsimp [Δ_R, a_R, b_R, c_R, d_R]; ring
              _ = 1 := hδ_mul
          · have hk_mem : k ∈ (Finset.univ.erase 0).erase L :=
              Finset.mem_erase.mpr ⟨hkL, Finset.mem_erase.mpr ⟨hk0, Finset.mem_univ k⟩⟩
            have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, V L m * U m k) = V L k := by
              rw [Finset.sum_eq_single k]
              · simp [U, hk0, hkL]
              · intro m hm hmk
                have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
                have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
                simp [U, hm0, hmL, hmk]
              · intro hk_abs
                exact False.elim (hk_abs hk_mem)
            rw [hRest]
            have hLk : L ≠ k := Ne.symm hkL
            simp only [V, Matrix.of_apply, ↓reduceIte, hk0, hkL, h0_ne_L.symm, hLk]
            ring
      · have hi_mem : i ∈ (Finset.univ.erase 0).erase L :=
          Finset.mem_erase.mpr ⟨hiL, Finset.mem_erase.mpr ⟨hi0, Finset.mem_univ i⟩⟩
        have hVi0 : V i 0 = 0 := by simp [V, hi0, hiL]
        have hViL : V i L = 0 := by simp [V, hi0, hiL]
        have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, V i m * U m k) =
            if i = k then 1 else 0 := by
          rw [Finset.sum_eq_single i]
          · simp [U, V, hi0, hiL]
          · intro m _ hmi
            have him : i ≠ m := hmi.symm
            simp [V, hi0, hiL, him]
          · intro hi_abs
            exact False.elim (hi_abs hi_mem)
        rw [hVi0, hViL, zero_mul, zero_mul, add_zero, zero_add, hRest]
  let W : Matrix (Fin (M + 1)) (Fin (M + 1)) R :=
    Matrix.of fun i j => U i (σ.symm j)
  let W' : Matrix (Fin (M + 1)) (Fin (M + 1)) R :=
    Matrix.of fun j i => V (σ.symm j) i
  have hWW' : W * W' = 1 := by
    ext i r
    rw [Matrix.mul_apply]
    have hEq : (∑ j : Fin (M + 1), W i j * W' j r) = (U * V) i r := by
      dsimp [W, W']
      rw [Matrix.mul_apply]
      exact Equiv.sum_comp σ.symm (fun m => U i m * V m r)
    rw [hEq, hUV]
  have hW'W : W' * W = 1 := by
    ext j r
    rw [Matrix.mul_apply]
    have hEq : (∑ i : Fin (M + 1), W' j i * W i r) = (V * U) (σ.symm j) (σ.symm r) := by
      dsimp [W, W']
      rw [Matrix.mul_apply]
    rw [hEq, hVU]
    simp [Matrix.one_apply, σ.symm.apply_eq_iff_eq]
  have hRow0 : (fun b => IsLocalRing.residue R (W 0 b)) = v₀ := by
    ext b
    simp [W, U, hv₀_R]
  have hRowL : (fun b => IsLocalRing.residue R (W L b)) = v₁ := by
    ext b
    simp [W, U, h0_ne_L.symm, hv₁_R]

  
  obtain ⟨hGLAut, hLinBC⟩ :=
    weil_commRing_proj_gl_automorphism_and_linear_basicOpen M
      (fun A _ => hAff_proj A M) (fun A _ => c_proj A M)
      (fun A _ => t_proj A M) (fun A _ => hCoord_proj A M)
  obtain ⟨α_R, hIso_αR, hαR_hom, hαR_open⟩ := hGLAut R W W' hWW' hW'W
  have : CategoryTheory.IsIso α_R := hIso_αR
  let ι'_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left := ι_bar ≫ α_R
  have hCl'_bar : AlgebraicGeometry.IsClosedImmersion ι'_bar := inferInstance
  have hComm'_bar : ι'_bar ≫ (weilProjectiveSpaceOver R M).hom = p_E := by
    dsimp [ι'_bar]
    rw [CategoryTheory.Category.assoc, hαR_hom, hp_E]
  have hw'_0 : (CategoryTheory.Limits.pullback.fst p_E s₀ ≫ ι'_bar) ≫
      (weilProjectiveSpaceOver R M).hom = p_Z₀ ≫ s₀ := by
    rw [CategoryTheory.Category.assoc, hComm'_bar]
    exact CategoryTheory.Limits.pullback.condition
  let ι'_0 : Z₀ ⟶ P_k₀ :=
    hBC_Rk₀.2.1.lift (CategoryTheory.Limits.pullback.fst p_E s₀ ≫ ι'_bar) p_Z₀ hw'_0
  have hι'0_fst : ι'_0 ≫ Φ_Rk₀ = CategoryTheory.Limits.pullback.fst p_E s₀ ≫ ι'_bar :=
    hBC_Rk₀.2.1.lift_fst _ _ _
  have hComm'_0 : ι'_0 ≫ (weilProjectiveSpaceOver k₀ M).hom = p_Z₀ :=
    hBC_Rk₀.2.1.lift_snd _ _ _
  have hPb_0 : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst p_E s₀) ι'_0 ι'_bar Φ_Rk₀ := by
    have hOuter : CategoryTheory.IsPullback
        (ι'_0 ≫ (weilProjectiveSpaceOver k₀ M).hom)
        (CategoryTheory.Limits.pullback.fst p_E s₀) s₀
        (ι'_bar ≫ (weilProjectiveSpaceOver R M).hom) := by
      rw [hComm'_0, hComm'_bar]
      exact (CategoryTheory.IsPullback.of_hasPullback p_E s₀).flip
    exact (CategoryTheory.IsPullback.of_right hOuter hι'0_fst hBC_Rk₀.2.1.flip).flip
  have hCl'_0 : AlgebraicGeometry.IsClosedImmersion ι'_0 :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsClosedImmersion) hPb_0 hCl'_bar

  have hChartEq : ∀ a : Fin (M + 1),
      (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M a) =
        (TopologicalSpace.Opens.map ι_0_init.base).obj
          (V_lin (fun b => IsLocalRing.residue R (W a b))) := by
    intro a
    obtain ⟨heq_a, _, _⟩ := hBC_Rk₀.2.2 a
    have h_comp : ι'_0 ≫ Φ_Rk₀ = (ι_0_init ≫ Φ_Rk₀) ≫ α_R := by
      rw [hι'0_fst, hι0_init_fst, CategoryTheory.Category.assoc]
    have h_bc_lin : (TopologicalSpace.Opens.map Φ_Rk₀.base).obj
        ((TopologicalSpace.Opens.map α_R.base).obj (weilProjBasicOpen R M a)) =
        V_lin (fun b => IsLocalRing.residue R (W a b)) := by
      rw [hαR_open a]
      exact hLinBC R k₀ (IsLocalRing.residue R) Φ_Rk₀ hBC_Rk₀ (W a)
    ext z
    rw [← heq_a]
    change Φ_Rk₀.base (ι'_0.base z) ∈ weilProjBasicOpen R M a ↔
      ι_0_init.base z ∈ V_lin (fun b => IsLocalRing.residue R (W a b))
    have h_ev := congrArg (fun f => f.base z) h_comp
    have h_lhs : (ι'_0 ≫ Φ_Rk₀).base z = Φ_Rk₀.base (ι'_0.base z) := by simp
    have h_rhs : ((ι_0_init ≫ Φ_Rk₀) ≫ α_R).base z =
        α_R.base (Φ_Rk₀.base (ι_0_init.base z)) := by simp
    rw [h_lhs, h_rhs] at h_ev
    rw [h_ev, ← h_bc_lin]
    rfl

  have hZ00_eq : (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M 0) = U_0_v0 := by
    rw [hChartEq 0, hRow0]
  have hZ01_eq : (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M L) =
      (TopologicalSpace.Opens.map ι_0_init.base).obj (V_lin v₁) := by
    rw [hChartEq L, hRowL]

  refine ⟨⟨h1M, hFinC, hNeC, hFinSing, hSubSing, hFinS, hSingCl, hAtMost2⟩,
    ι'_bar, ι'_0, Φ_Rk₀, hCl'_bar, hComm'_bar, hBC_Rk₀, hCl'_0, hComm'_0, hPb_0,
    ?_, ?_, ?_, ?_, ?_⟩
  · ext z
    simp only [TopologicalSpace.Opens.coe_sup, Set.mem_union,
      TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
    by_cases hz0 : z ∈ (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M 0)
    · exact Or.inl hz0
    · right
      change z ∈ (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M L)
      rw [hZ01_eq]
      show ι_0_init.base z ∈ V_lin v₁
      apply hF₂_sub
      refine ⟨z, Or.inr ?_, rfl⟩
      rw [hZ00_eq] at hz0
      exact hz0
  · intro z hz_sing
    refine ⟨?_, ?_⟩
    · rw [hZ00_eq]
      exact hF₁_sub ⟨z, Or.inl hz_sing, rfl⟩
    · change z ∈ (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M L)
      rw [hZ01_eq]
      exact hF₂_sub ⟨z, Or.inl (Or.inl hz_sing), rfl⟩
  · intro Z_comp hZ_comp
    let p_Z := (hSmWit Z_comp hZ_comp).choose
    obtain ⟨hp_Z_mem, hp_Z_not_sing⟩ := (hSmWit Z_comp hZ_comp).choose_spec
    have hp_Z_sm : p_Z ∈ S_sm := ⟨⟨Z_comp, hZ_comp⟩, rfl⟩
    refine ⟨p_Z, hp_Z_mem, ⟨?_, ?_⟩, hp_Z_not_sing⟩
    · rw [hZ00_eq]
      exact hF₁_sub ⟨p_Z, Or.inr hp_Z_sm, rfl⟩
    · change p_Z ∈ (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M L)
      rw [hZ01_eq]
      exact hF₂_sub ⟨p_Z, Or.inl (Or.inr hp_Z_sm), rfl⟩
  · intro a hAff_a _ha q hq_not_sing
    exact hSmExt _ hAff_a q hq_not_sing
  · intro hAff_1 q hq_sing
    obtain ⟨B₀, instB₀, q₀, φ₁_0, φ₂_0, hEt1, hEt2, hComap0, hComm0, hX0⟩ :=
      hNodRaw _ hAff_1 q hq_sing
    letI : CommRing B₀ := instB₀
    obtain ⟨h, _hh_not, u₀, hComap_u0, _hev₀, _hUnion, hInter, _hAwaySm, hBranch⟩ :=
      hRingPkg.2.2 B₀ φ₂_0 q₀ hEt2 hX0
    let B' : Type u := Localization.Away h
    let ψ : B₀ →+* B' := algebraMap B₀ B'
    have hEt_ψ : ψ.Etale := by
      have : Algebra.Etale B₀ B' := Algebra.Etale.of_isLocalizationAway h
      exact RingHom.etale_algebraMap.mpr inferInstance
    let φ₁ := ψ.comp φ₁_0
    let φ₂ := ψ.comp φ₂_0
    have hEt_φ₁ : φ₁.Etale := RingHom.Etale.stableUnderComposition φ₁_0 ψ hEt1 hEt_ψ
    have hEt_φ₂ : φ₂.Etale := RingHom.Etale.stableUnderComposition φ₂_0 ψ hEt2 hEt_ψ
    have hComap : PrimeSpectrum.comap φ₁ u₀ = q := by
      change PrimeSpectrum.comap φ₁_0 (PrimeSpectrum.comap ψ u₀) = q
      rw [hComap_u0, hComap0]
    have hu₀_in : u₀ ∈
        PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} : Set B') ∩
          PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))} : Set B') := by
      rw [hInter]
      exact rfl
    have hX_mem : ∀ i : Fin 2, φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ u₀.asIdeal := by
      intro i
      fin_cases i
      · exact hu₀_in.1 (Set.mem_singleton _)
      · exact hu₀_in.2 (Set.mem_singleton _)
    exact ⟨B', inferInstance, u₀, φ₁, φ₂, hEt_φ₁, hEt_φ₂, hComap,
      RingHom.ext fun x => congrArg ψ (RingHom.congr_fun hComm0 x),
      hX_mem, fun i => (hBranch i).1⟩

theorem weil_commRing_proj_coord_appLE_and_p1_chart_equiv (K : Type u) [Field K] :
    (∀ (N : ℕ)
      (hAff : ∀ a : Fin (N + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K N a))
      (c_N : ∀ a : Fin (N + 1),
        K →+* ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K N a))))
      (t_N : ∀ a : Fin (N + 1), Fin (N + 1) →
        ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K N a)))),
      IsCommRingProjCoordSystem K N hAff c_N t_N →
      ∀ a : Fin (N + 1),
        CommRingCat.ofHom (c_N a) =
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
            (weilProjectiveSpaceOver K N).hom.appLE ⊤ (weilProjBasicOpen K N a) le_top ∧
        ∀ x : ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K N a))),
          ∃ (D : ℕ) (c : weilDegMonomialIdx N D → K),
            1 ≤ D ∧
            x = ∑ e : weilDegMonomialIdx N D,
              c_N a (c e) * ∏ μ : Fin (N + 1), (t_N a μ) ^ (e.1 μ : ℕ)) ∧
    (∀ (hAff1 : ∀ a : Fin (1 + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K 1 a))
      (c_1 : ∀ a : Fin (1 + 1),
        K →+* ↑((weilProjectiveSpaceOver K 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K 1 a))))
      (t_1 : ∀ a : Fin (1 + 1), Fin (1 + 1) →
        ↑((weilProjectiveSpaceOver K 1).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K 1 a)))),
      IsCommRingProjCoordSystem K 1 hAff1 c_1 t_1 →
      let P₁ := (weilProjectiveSpaceOver K 1).left
      let V₀ := weilProjBasicOpen K 1 0
      let V₁ := weilProjBasicOpen K 1 1
      V₀ ⊔ V₁ = ⊤ ∧
      Nonempty ↥V₀ ∧
      Nonempty ↥V₁ ∧
      Nonempty ↥(V₀ ⊓ V₁) ∧
      IrreducibleSpace ↥P₁ ∧
      ∃ (Φ₀ : Polynomial K ≃+* ↑(P₁.presheaf.obj (Opposite.op V₀)))
        (Φ₁ : Polynomial K ≃+* ↑(P₁.presheaf.obj (Opposite.op V₁))),
        Φ₀.toRingHom.comp Polynomial.C = c_1 0 ∧
        Φ₀ Polynomial.X = t_1 0 1 ∧
        Φ₁.toRingHom.comp Polynomial.C = c_1 1 ∧
        Φ₁ Polynomial.X = t_1 1 0 ∧
        (P₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
            (Φ₀ Polynomial.X) *
          (P₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
            (Φ₁ Polynomial.X) = 1 ∧
        ∀ (d : ℕ) (P : Polynomial K),
          P.natDegree ≤ d →
          (P₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
              (Φ₁ (∑ j : Fin (d + 1),
                Polynomial.C (P.coeff (j : ℕ)) * Polynomial.X ^ (d - (j : ℕ)))) =
            ((P₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
                (Φ₁ Polynomial.X)) ^ d *
              (P₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
                (Φ₀ P)) :=
by
  constructor
  · intro N hAff c_N t_N hCoord a
    obtain ⟨_hProp, _hCov, hcSpec, _hMv, htDiag, hGen, _hUniv, _hBasic, _hScalar, _hCocycle⟩ := hCoord
    constructor
    · let p_N := (weilProjectiveSpaceOver K N).hom
      let U_a := weilProjBasicOpen K N a
      have hTop : AlgebraicGeometry.IsAffineOpen
          (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) :=
        AlgebraicGeometry.isAffineOpen_top _
      have hSpec := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_N hTop (hAff a) le_top
      rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top,
        AlgebraicGeometry.Scheme.isoSpec_Spec_inv,
        ← AlgebraicGeometry.Spec.map_comp] at hSpec
      have hEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_N a)) =
          AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
              p_N.appLE ⊤ U_a le_top) :=
        (hcSpec a).trans hSpec.symm
      have hPre := congrArg AlgebraicGeometry.Spec.preimage hEq
      simpa only [AlgebraicGeometry.Spec.preimage_map] using hPre
    · intro x
      let A := ↑((weilProjectiveSpaceOver K N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K N a)))
      let c_a : K →+* A := c_N a
      let t_a : Fin (N + 1) → A := t_N a
      have ht_diag : t_a a = 1 := htDiag a
      have hGen_a : Subring.closure (Set.range c_a ∪ Set.range t_a) = ⊤ := hGen a
      letI : Algebra K A := c_a.toAlgebra
      have h_smul : ∀ (r : K) (y : A), r • y = c_a r * y := fun r y => Algebra.smul_def r y
      let m_gen : ∀ D : ℕ, weilDegMonomialIdx N D → A :=
        fun D e => ∏ μ : Fin (N + 1), (t_a μ) ^ (e.1 μ : ℕ)
      let M_span : ℕ → Submodule K A :=
        fun D => Submodule.span K (Set.range (m_gen D))
      have hStep : ∀ D : ℕ, M_span D ≤ M_span (D + 1) := by
        intro D
        rw [Submodule.span_le, Set.range_subset_iff]
        intro e
        let e_succ_fn : Fin (N + 1) → Fin (D + 1 + 1) := fun μ =>
          if μ = a then ⟨(e.1 a : ℕ) + 1, by have := (e.1 a).isLt; omega⟩
          else ⟨(e.1 μ : ℕ), by have := (e.1 μ).isLt; omega⟩
        have he_succ_val : ∀ μ : Fin (N + 1),
            (e_succ_fn μ : ℕ) = if μ = a then (e.1 a : ℕ) + 1 else (e.1 μ : ℕ) := by
          intro μ
          dsimp only [e_succ_fn]
          split_ifs <;> rfl
        have he_succ_sum : (∑ μ : Fin (N + 1), (e_succ_fn μ : ℕ)) = D + 1 := by
          rw [← Finset.sum_erase_add Finset.univ _ (Finset.mem_univ a)]
          have h_er : ∑ μ ∈ Finset.univ.erase a, (e_succ_fn μ : ℕ) =
              ∑ μ ∈ Finset.univ.erase a, (e.1 μ : ℕ) := by
            refine Finset.sum_congr rfl fun μ hμ => ?_
            simp [he_succ_val μ, Finset.ne_of_mem_erase hμ]
          have ha_val : (e_succ_fn a : ℕ) = (e.1 a : ℕ) + 1 := by simp [he_succ_val]
          rw [h_er, ha_val, ← add_assoc,
            Finset.sum_erase_add Finset.univ _ (Finset.mem_univ a), e.2]
        let e_succ : weilDegMonomialIdx N (D + 1) := ⟨e_succ_fn, he_succ_sum⟩
        have hm_eq : m_gen (D + 1) e_succ = m_gen D e := by
          dsimp only [m_gen, e_succ]
          rw [← Finset.prod_erase_mul Finset.univ _ (Finset.mem_univ a),
            ← Finset.prod_erase_mul Finset.univ (fun μ => (t_a μ) ^ (e.1 μ : ℕ)) (Finset.mem_univ a)]
          have h_pr : ∏ μ ∈ Finset.univ.erase a, (t_a μ) ^ (e_succ_fn μ : ℕ) =
              ∏ μ ∈ Finset.univ.erase a, (t_a μ) ^ (e.1 μ : ℕ) := by
            refine Finset.prod_congr rfl fun μ hμ => ?_
            simp [he_succ_val μ, Finset.ne_of_mem_erase hμ]
          rw [h_pr, ht_diag, one_pow, one_pow]
        exact Submodule.subset_span ⟨e_succ, hm_eq⟩
      have hMono : Monotone M_span := monotone_nat_of_le_succ hStep
      have hMul : ∀ {D₁ D₂ : ℕ} {u v : A},
          u ∈ M_span D₁ → v ∈ M_span D₂ → u * v ∈ M_span (D₁ + D₂) := by
        intro D₁ D₂ u v hu hv
        refine Submodule.span_induction
          (p := fun u _ => u * v ∈ M_span (D₁ + D₂))
          (fun u hu_mem => ?_)
          (by rw [zero_mul]; exact (M_span (D₁ + D₂)).zero_mem)
          (fun u₁ u₂ _ _ ih₁ ih₂ => by
            rw [add_mul]
            exact (M_span (D₁ + D₂)).add_mem ih₁ ih₂)
          (fun r u' _ ih => by
            rw [smul_mul_assoc]
            exact (M_span (D₁ + D₂)).smul_mem r ih)
          hu
        rcases hu_mem with ⟨e₁, rfl⟩
        refine Submodule.span_induction
          (p := fun v _ => m_gen D₁ e₁ * v ∈ M_span (D₁ + D₂))
          (fun v hv_mem => ?_)
          (by rw [mul_zero]; exact (M_span (D₁ + D₂)).zero_mem)
          (fun v₁ v₂ _ _ ih₁ ih₂ => by
            rw [mul_add]
            exact (M_span (D₁ + D₂)).add_mem ih₁ ih₂)
          (fun r v' _ ih => by
            rw [mul_smul_comm]
            exact (M_span (D₁ + D₂)).smul_mem r ih)
          hv
        rcases hv_mem with ⟨e₂, rfl⟩
        let e₁₂_fn : Fin (N + 1) → Fin (D₁ + D₂ + 1) := fun μ =>
          ⟨(e₁.1 μ : ℕ) + (e₂.1 μ : ℕ), by
            have := (e₁.1 μ).isLt
            have := (e₂.1 μ).isLt
            omega⟩
        have he₁₂_sum : (∑ μ : Fin (N + 1), (e₁₂_fn μ : ℕ)) = D₁ + D₂ := by
          change (∑ μ : Fin (N + 1), ((e₁.1 μ : ℕ) + (e₂.1 μ : ℕ))) = D₁ + D₂
          rw [Finset.sum_add_distrib, e₁.2, e₂.2]
        let e₁₂ : weilDegMonomialIdx N (D₁ + D₂) := ⟨e₁₂_fn, he₁₂_sum⟩
        have hm₁₂ : m_gen (D₁ + D₂) e₁₂ = m_gen D₁ e₁ * m_gen D₂ e₂ := by
          dsimp only [m_gen, e₁₂, e₁₂_fn]
          rw [← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl fun μ _ => ?_
          exact pow_add (t_a μ) (e₁.1 μ : ℕ) (e₂.1 μ : ℕ)
        exact Submodule.subset_span ⟨e₁₂, hm₁₂⟩
      have ht_mem : ∀ b : Fin (N + 1), t_a b ∈ M_span 1 := by
        intro b
        let δ_fn : Fin (N + 1) → Fin (1 + 1) := fun μ =>
          if μ = b then ⟨1, by omega⟩ else ⟨0, by omega⟩
        have hδ_val : ∀ μ : Fin (N + 1), (δ_fn μ : ℕ) = if μ = b then 1 else 0 := by
          intro μ
          dsimp only [δ_fn]
          split_ifs <;> rfl
        have hδ_sum : (∑ μ : Fin (N + 1), (δ_fn μ : ℕ)) = 1 := by
          rw [Finset.sum_eq_single b]
          · simp [hδ_val]
          · intro μ _ hμ
            simp [hδ_val μ, hμ]
          · intro hb
            exact absurd (Finset.mem_univ b) hb
        let δ_idx : weilDegMonomialIdx N 1 := ⟨δ_fn, hδ_sum⟩
        have hm_δ : m_gen 1 δ_idx = t_a b := by
          dsimp only [m_gen, δ_idx]
          rw [Finset.prod_eq_single b]
          · simp [hδ_val]
          · intro μ _ hμ
            simp [hδ_val μ, hμ]
          · intro hb
            exact absurd (Finset.mem_univ b) hb
        exact Submodule.subset_span ⟨δ_idx, hm_δ⟩
      have h1_mem : (1 : A) ∈ M_span 1 := by
        rw [← ht_diag]
        exact ht_mem a
      let S_sub : Subring A :=
        { carrier := {y : A | ∃ D : ℕ, 1 ≤ D ∧ y ∈ M_span D}
          mul_mem' := by
            rintro y₁ y₂ ⟨D₁, hD₁, hy₁⟩ ⟨D₂, hD₂, hy₂⟩
            exact ⟨D₁ + D₂, by omega, hMul hy₁ hy₂⟩
          one_mem' := ⟨1, le_rfl, h1_mem⟩
          add_mem' := by
            rintro y₁ y₂ ⟨D₁, hD₁, hy₁⟩ ⟨D₂, _hD₂, hy₂⟩
            exact ⟨max D₁ D₂, le_trans hD₁ (le_max_left D₁ D₂),
              (M_span (max D₁ D₂)).add_mem
                (hMono (le_max_left D₁ D₂) hy₁)
                (hMono (le_max_right D₁ D₂) hy₂)⟩
          zero_mem' := ⟨1, le_rfl, (M_span 1).zero_mem⟩
          neg_mem' := by
            rintro y ⟨D, hD, hy⟩
            exact ⟨D, hD, (M_span D).neg_mem hy⟩ }
      have hSub_le : Subring.closure (Set.range c_a ∪ Set.range t_a) ≤ S_sub := by
        rw [Subring.closure_le]
        rintro y (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · refine ⟨1, le_rfl, ?_⟩
          have hr : c_a r = r • (1 : A) := by rw [h_smul, mul_one]
          rw [hr]
          exact (M_span 1).smul_mem r h1_mem
        · exact ⟨1, le_rfl, ht_mem b⟩
      rw [hGen_a] at hSub_le
      obtain ⟨D, hD, hxD⟩ : x ∈ S_sub := hSub_le trivial
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hxD
      refine ⟨D, c, hD, ?_⟩
      rw [← hc]
      refine Finset.sum_congr rfl fun e _ => ?_
      exact h_smul (c e) (m_gen D e)
  · intro hAff1 c_1 t_1 hCoord1
    dsimp only
    let P₁ := (weilProjectiveSpaceOver K 1).left
    let V₀ := weilProjBasicOpen K 1 0
    let V₁ := weilProjBasicOpen K 1 1
    let R₀ := ↑(P₁.presheaf.obj (Opposite.op V₀))
    let R₁ := ↑(P₁.presheaf.obj (Opposite.op V₁))
    let res₀ : R₀ →+* ↑(P₁.presheaf.obj (Opposite.op (V₀ ⊓ V₁))) :=
      (P₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
    let res₁ : R₁ →+* ↑(P₁.presheaf.obj (Opposite.op (V₀ ⊓ V₁))) :=
      (P₁.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
    obtain ⟨_hProp1, hCov1, _hcSpec1, _hMv1, htDiag1, hGen1, hUniv1, hBasic1, hScalar1, hCocycle1⟩ :=
      hCoord1
    have hSup : V₀ ⊔ V₁ = ⊤ := by
      apply le_antisymm le_top
      rw [← hCov1]
      refine iSup_le fun a => ?_
      fin_cases a
      · exact le_sup_left
      · exact le_sup_right
    obtain ⟨ψ₀, hψ₀_C, hψ₀_t⟩ :=
      hUniv1 0 (Polynomial K) Polynomial.C (fun b => if b = 0 then 1 else Polynomial.X) rfl
    let φ₀ : Polynomial K →+* R₀ := Polynomial.eval₂RingHom (c_1 0) (t_1 0 1)
    have hφ₀_C : φ₀.comp Polynomial.C = c_1 0 := by
      ext r
      exact Polynomial.eval₂_C (c_1 0) (t_1 0 1)
    have hφ₀_X : φ₀ Polynomial.X = t_1 0 1 := Polynomial.eval₂_X (c_1 0) (t_1 0 1)
    have h_ψφ₀ : ψ₀.comp φ₀ = RingHom.id (Polynomial K) := by
      apply Polynomial.ringHom_ext'
      · rw [RingHom.comp_assoc, hφ₀_C, hψ₀_C]
        rfl
      · change ψ₀ (φ₀ Polynomial.X) = Polynomial.X
        rw [hφ₀_X]
        exact hψ₀_t 1
    have h_φψ₀ : φ₀.comp ψ₀ = RingHom.id R₀ := by
      have hLocus₀ : Subring.closure (Set.range (c_1 0) ∪ Set.range (t_1 0)) ≤
          RingHom.eqLocus (φ₀.comp ψ₀) (RingHom.id R₀) := by
        rw [Subring.closure_le]
        rintro y (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · show φ₀ (ψ₀ (c_1 0 r)) = c_1 0 r
          have h1 : ψ₀ (c_1 0 r) = Polynomial.C r := RingHom.congr_fun hψ₀_C r
          rw [h1]
          exact RingHom.congr_fun hφ₀_C r
        · fin_cases b
          · show φ₀ (ψ₀ (t_1 0 0)) = t_1 0 0
            rw [htDiag1 0, map_one, map_one]
          · show φ₀ (ψ₀ (t_1 0 1)) = t_1 0 1
            rw [hψ₀_t 1]
            exact hφ₀_X
      rw [hGen1 0] at hLocus₀
      ext y
      exact hLocus₀ trivial
    let Φ₀ : Polynomial K ≃+* R₀ := RingEquiv.ofRingHom φ₀ ψ₀ h_φψ₀ h_ψφ₀
    have hΦ₀_C : Φ₀.toRingHom.comp Polynomial.C = c_1 0 := hφ₀_C
    have hΦ₀_X : Φ₀ Polynomial.X = t_1 0 1 := hφ₀_X
    obtain ⟨ψ₁, hψ₁_C, hψ₁_t⟩ :=
      hUniv1 1 (Polynomial K) Polynomial.C (fun b => if b = 1 then 1 else Polynomial.X) rfl
    let φ₁ : Polynomial K →+* R₁ := Polynomial.eval₂RingHom (c_1 1) (t_1 1 0)
    have hφ₁_C : φ₁.comp Polynomial.C = c_1 1 := by
      ext r
      exact Polynomial.eval₂_C (c_1 1) (t_1 1 0)
    have hφ₁_X : φ₁ Polynomial.X = t_1 1 0 := Polynomial.eval₂_X (c_1 1) (t_1 1 0)
    have h_ψφ₁ : ψ₁.comp φ₁ = RingHom.id (Polynomial K) := by
      apply Polynomial.ringHom_ext'
      · rw [RingHom.comp_assoc, hφ₁_C, hψ₁_C]
        rfl
      · change ψ₁ (φ₁ Polynomial.X) = Polynomial.X
        rw [hφ₁_X]
        exact hψ₁_t 0
    have h_φψ₁ : φ₁.comp ψ₁ = RingHom.id R₁ := by
      have hLocus₁ : Subring.closure (Set.range (c_1 1) ∪ Set.range (t_1 1)) ≤
          RingHom.eqLocus (φ₁.comp ψ₁) (RingHom.id R₁) := by
        rw [Subring.closure_le]
        rintro y (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · show φ₁ (ψ₁ (c_1 1 r)) = c_1 1 r
          have h1 : ψ₁ (c_1 1 r) = Polynomial.C r := RingHom.congr_fun hψ₁_C r
          rw [h1]
          exact RingHom.congr_fun hφ₁_C r
        · fin_cases b
          · show φ₁ (ψ₁ (t_1 1 0)) = t_1 1 0
            rw [hψ₁_t 0]
            exact hφ₁_X
          · show φ₁ (ψ₁ (t_1 1 1)) = t_1 1 1
            rw [htDiag1 1, map_one, map_one]
      rw [hGen1 1] at hLocus₁
      ext y
      exact hLocus₁ trivial
    let Φ₁ : Polynomial K ≃+* R₁ := RingEquiv.ofRingHom φ₁ ψ₁ h_φψ₁ h_ψφ₁
    have hΦ₁_C : Φ₁.toRingHom.comp Polynomial.C = c_1 1 := hφ₁_C
    have hΦ₁_X : Φ₁ Polynomial.X = t_1 1 0 := hφ₁_X
    have h_vu : res₁ (Φ₁ Polynomial.X) * res₀ (Φ₀ Polynomial.X) = 1 := by
      rw [hΦ₁_X, hΦ₀_X]
      have hcoc := hCocycle1 0 1 0
      change res₁ (t_1 1 0) * res₀ (t_1 0 1) = res₀ (t_1 0 0) at hcoc
      rw [hcoc, htDiag1 0, map_one]
    have h_uv : res₀ (Φ₀ Polynomial.X) * res₁ (Φ₁ Polynomial.X) = 1 := by
      rw [mul_comm, h_vu]
    have hRev : ∀ (d : ℕ) (P : Polynomial K),
        P.natDegree ≤ d →
        res₁ (Φ₁ (∑ j : Fin (d + 1),
          Polynomial.C (P.coeff (j : ℕ)) * Polynomial.X ^ (d - (j : ℕ)))) =
        (res₁ (Φ₁ Polynomial.X)) ^ d * res₀ (Φ₀ P) := by
      intro d P hdeg
      have hP_eq : P = ∑ j : Fin (d + 1), Polynomial.C (P.coeff (j : ℕ)) * Polynomial.X ^ (j : ℕ) := by
        apply Polynomial.ext
        intro n
        rw [Polynomial.finsetSum_coeff]
        by_cases hn : n ≤ d
        · let j₀ : Fin (d + 1) := ⟨n, by omega⟩
          rw [Finset.sum_eq_single j₀]
          · simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, j₀]
          · intro j _ hj
            have hnj : ¬ n = (j : ℕ) := fun h => hj (Fin.ext h.symm)
            simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hnj]
          · intro hj₀
            exact absurd (Finset.mem_univ j₀) hj₀
        · have hlt : P.natDegree < n := by omega
          rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt]
          symm
          refine Finset.sum_eq_zero fun j _ => ?_
          have hnj : ¬ n = (j : ℕ) := by
            have hj_lt := j.isLt
            omega
          simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, hnj]
      conv_rhs => rw [hP_eq]
      simp only [map_sum, map_mul, map_pow]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hC0 : Φ₀ (Polynomial.C (P.coeff (j : ℕ))) = c_1 0 (P.coeff (j : ℕ)) :=
        RingHom.congr_fun hΦ₀_C (P.coeff (j : ℕ))
      have hC1 : Φ₁ (Polynomial.C (P.coeff (j : ℕ))) = c_1 1 (P.coeff (j : ℕ)) :=
        RingHom.congr_fun hΦ₁_C (P.coeff (j : ℕ))
      have hSc : res₁ (c_1 1 (P.coeff (j : ℕ))) = res₀ (c_1 0 (P.coeff (j : ℕ))) :=
        hScalar1 0 1 (P.coeff (j : ℕ))
      rw [hC0, hC1, ← hSc]
      have hj_le : (j : ℕ) ≤ d := by
        have := j.isLt
        omega
      have hd_split : d = d - (j : ℕ) + (j : ℕ) := (Nat.sub_add_cancel hj_le).symm
      let u := res₀ (Φ₀ Polynomial.X)
      let v := res₁ (Φ₁ Polynomial.X)
      let s := res₁ (c_1 1 (P.coeff (j : ℕ)))
      change s * v ^ (d - (j : ℕ)) = v ^ d * (s * u ^ (j : ℕ))
      calc
        s * v ^ (d - (j : ℕ))
            = s * (v ^ (d - (j : ℕ)) * 1 ^ (j : ℕ)) := by rw [one_pow, mul_one]
        _ = s * (v ^ (d - (j : ℕ)) * (v * u) ^ (j : ℕ)) := by rw [h_vu]
        _ = s * (v ^ (d - (j : ℕ)) * (v ^ (j : ℕ) * u ^ (j : ℕ))) := by rw [mul_pow]
        _ = (v ^ (d - (j : ℕ)) * v ^ (j : ℕ)) * (s * u ^ (j : ℕ)) := by ring
        _ = v ^ d * (s * u ^ (j : ℕ)) := by rw [← pow_add, ← hd_split]
    let ev₁ : R₀ →+* K := (Polynomial.evalRingHom 1).comp Φ₀.symm.toRingHom
    let q₁ : PrimeSpectrum R₀ := ⟨RingHom.ker ev₁, RingHom.ker_isPrime ev₁⟩
    have hq₁_basic : q₁ ∈ PrimeSpectrum.basicOpen (Φ₀ Polynomial.X) := by
      rw [PrimeSpectrum.mem_basicOpen]
      change ev₁ (Φ₀ Polynomial.X) ≠ 0
      simp [ev₁]
    have hPreBasic :=
      AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen (hAff1 0) (Φ₀ Polynomial.X)
    have hBasicX : P₁.basicOpen (Φ₀ Polynomial.X) = V₀ ⊓ V₁ := by
      rw [hΦ₀_X]
      exact hBasic1 0 1
    let x₁ : ↥P₁ := (hAff1 0).fromSpec.base q₁
    have hx₁_inter : x₁ ∈ V₀ ⊓ V₁ := by
      rw [← hBasicX]
      change q₁ ∈ (TopologicalSpace.Opens.map (hAff1 0).fromSpec.base).obj
        (P₁.basicOpen (Φ₀ Polynomial.X))
      rwa [hPreBasic]
    have hx₁_0 : x₁ ∈ V₀ := hx₁_inter.1
    have hx₁_1 : x₁ ∈ V₁ := hx₁_inter.2
    have hDom₀ : IsDomain R₀ := (MulEquiv.isDomain_iff Φ₀.toMulEquiv).mp inferInstance
    have hDom₁ : IsDomain R₁ := (MulEquiv.isDomain_iff Φ₁.toMulEquiv).mp inferInstance
    have hIrredSpec₀ : IrreducibleSpace ↥(AlgebraicGeometry.Spec (P₁.presheaf.obj (Opposite.op V₀))) :=
      @PrimeSpectrum.irreducibleSpace R₀ _ hDom₀
    have hIrredSpec₁ : IrreducibleSpace ↥(AlgebraicGeometry.Spec (P₁.presheaf.obj (Opposite.op V₁))) :=
      @PrimeSpectrum.irreducibleSpace R₁ _ hDom₁
    have hV₀_irred : IsIrreducible (V₀ : Set ↥P₁) := by
      rw [← (hAff1 0).range_fromSpec, ← Set.image_univ]
      exact (@IrreducibleSpace.isIrreducible_univ _ _ hIrredSpec₀).image (hAff1 0).fromSpec.base
        (hAff1 0).fromSpec.continuous.continuousOn
    have hV₁_irred : IsIrreducible (V₁ : Set ↥P₁) := by
      rw [← (hAff1 1).range_fromSpec, ← Set.image_univ]
      exact (@IrreducibleSpace.isIrreducible_univ _ _ hIrredSpec₁).image (hAff1 1).fromSpec.base
        (hAff1 1).fromSpec.continuous.continuousOn
    have hMeetV₀ : ∀ (U : Set ↥P₁), IsOpen U → U.Nonempty → ((V₀ : Set ↥P₁) ∩ U).Nonempty := by
      intro U hU ⟨y, hyU⟩
      have hyCov : y ∈ (V₀ ⊔ V₁ : P₁.Opens) := by
        rw [hSup]
        trivial
      rcases hyCov with hy0 | hy1
      · exact ⟨y, hy0, hyU⟩
      · obtain ⟨z, _hzV₁, hzU, hzV₀⟩ :=
          hV₁_irred.2 U (V₀ : Set ↥P₁) hU V₀.isOpen ⟨y, hy1, hyU⟩ ⟨x₁, hx₁_1, hx₁_0⟩
        exact ⟨z, hzV₀, hzU⟩
    have hIrredP₁ : IrreducibleSpace ↥P₁ :=
      { isPreirreducible_univ := by
          intro U W hU hW ⟨_, _, hyU⟩ ⟨_, _, hwW⟩
          obtain ⟨z, _hzV₀, hzU, hzW⟩ :=
            hV₀_irred.2 U W hU hW (hMeetV₀ U hU ⟨_, hyU⟩) (hMeetV₀ W hW ⟨_, hwW⟩)
          exact ⟨z, trivial, hzU, hzW⟩
        toNonempty := ⟨x₁⟩ }
    exact ⟨hSup, ⟨⟨x₁, hx₁_0⟩⟩, ⟨⟨x₁, hx₁_1⟩⟩, ⟨⟨x₁, hx₁_inter⟩⟩, hIrredP₁,
      Φ₀, Φ₁, hΦ₀_C, hΦ₀_X, hΦ₁_C, hΦ₁_X, h_uv, hRev⟩

theorem weil_two_polynomial_chart_scheme_fraction_and_polar_gluing (K : Type u) [Field K]
    (X : AlgebraicGeometry.Scheme.{u})
    (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    [IrreducibleSpace ↥X]
    (V₀ V₁ : X.Opens)
    (hAff0 : AlgebraicGeometry.IsAffineOpen V₀)
