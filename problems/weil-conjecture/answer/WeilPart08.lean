    hSplit₅ (IsLocalRing.ResidueField R) σ_bar₄ hA₀₀ hA₀₁ hA₁₁
  letI : CommRing S₅ := instCommS₅
  letI : Algebra S₄ S₅ := instAlgS₄S₅
  letI : Algebra R S₅ := ((algebraMap S₄ S₅).comp (algebraMap R S₄)).toAlgebra
  haveI : IsScalarTower R S₄ S₅ := IsScalarTower.of_algebraMap_eq' rfl
  let φ₅ : MvPolynomial (Fin 2) R →ₐ[R] S₅ :=
