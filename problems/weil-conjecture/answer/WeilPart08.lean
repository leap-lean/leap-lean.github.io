  · intro U f hEt u₀ hu₀
    exact h_part5 (fun B _ _ _ q => hClause1 R B q) U f hEt u₀ hu₀

theorem weil_nodal_quotient_integrallyClosed_and_etale_smooth1d_descent (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
