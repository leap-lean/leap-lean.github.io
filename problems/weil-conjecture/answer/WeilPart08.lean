                  (Δ_inv * j_mat 1 1 * j_mat 0 0 - Δ_inv * j_mat 0 1 * j_mat 1 0) • e_X6 0 +
                    (Δ_inv * j_mat 1 1 * j_mat 0 1 - Δ_inv * j_mat 0 1 * j_mat 1 1) • e_X6 1 := by
                module
              rw [hmod, hc0, hc1, one_smul, zero_smul, add_zero]
            · rw [LinearMap.comp_apply, LinearMap.id_apply, h_fin1, hΨ_eX6_1,
                map_add, map_smul, map_smul, hΦ_eU 0, hΦ_eU 1]
              have hc0 : -(Δ_inv * j_mat 1 0 * j_mat 0 0) + Δ_inv * j_mat 0 0 * j_mat 1 0 = 0 := by
                ring
              have hc1 : -(Δ_inv * j_mat 1 0 * j_mat 0 1) + Δ_inv * j_mat 0 0 * j_mat 1 1 = 1 := by
                linear_combination hΔ_mul
              have hmod :
                  -(Δ_inv * j_mat 1 0) • (j_mat 0 0 • e_X6 0 + j_mat 0 1 • e_X6 1) +
                    (Δ_inv * j_mat 0 0) • (j_mat 1 0 • e_X6 0 + j_mat 1 1 • e_X6 1) =
                  (-(Δ_inv * j_mat 1 0 * j_mat 0 0) + Δ_inv * j_mat 0 0 * j_mat 1 0) • e_X6 0 +
                    (-(Δ_inv * j_mat 1 0 * j_mat 0 1) + Δ_inv * j_mat 0 0 * j_mat 1 1) • e_X6 1 := by
                module
              rw [hmod, hc0, hc1, zero_smul, one_smul, zero_add]
          intro w
          exact LinearMap.congr_fun hext w
        have hΨΦ : ∀ v : TensorProduct (MvPolynomial (Fin 2) R) S₆
            Ω[MvPolynomial (Fin 2) R⁄R], Ψ (Φ v) = v := by
          have hext : Ψ.comp Φ = LinearMap.id := by
            apply e_U.ext
