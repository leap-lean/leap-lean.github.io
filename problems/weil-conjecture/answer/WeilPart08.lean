      obtain ⟨D, c, _, rfl⟩ := hGenK a₀ x_lift
      refine ⟨∑ e : weilDegMonomialIdx M D,
        c e * ∏ μ : Fin (M + 1), (c₀ μ * (c₀ a₀)⁻¹) ^ (e.1 μ : ℕ), ?_⟩
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun e _ => ?_
      rw [map_mul, map_mul, map_prod, map_prod]
      congr 1
      refine Finset.prod_congr rfl fun μ _ => ?_
      rw [map_pow, map_pow, ← hη_const μ]
