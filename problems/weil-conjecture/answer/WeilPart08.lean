                    (-(j_mat 0 0 * (Δ_inv * j_mat 0 1)) + j_mat 0 1 * (Δ_inv * j_mat 0 0)) • e_U 1 := by
                module
              rw [hmod, hc0, hc1, one_smul, zero_smul, add_zero]
