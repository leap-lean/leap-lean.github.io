    intro d Q hQ
    conv_lhs => rw [hPolySum d Q hQ]
    dsimp [rev]
    rw [map_sum, Finset.sum_mul, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hj_le : (j : ℕ) ≤ d := Nat.le_of_lt_succ j.isLt
    have hxd : x_F ^ d = x_F ^ (j : ℕ) * x_F ^ (d - (j : ℕ)) := by
      rw [← pow_add, Nat.add_sub_of_le hj_le]
    have hcancel : (x_F⁻¹) ^ (j : ℕ) * x_F ^ (j : ℕ) = 1 := by
      rw [← mul_pow, inv_mul_cancel₀ hx_F, one_pow]
    simp only [φ_inv, map_mul, map_pow, Polynomial.coe_eval₂RingHom,
