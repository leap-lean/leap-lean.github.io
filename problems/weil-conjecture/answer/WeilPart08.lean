import WeilPart07
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_sup1_proj_baseChange_and_shifted_hyperplane_bridge (R S : Type u) [CommRing R] [CommRing S] (ρ : R →+* S) (N : ℕ) :
    let 𝒜_R := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let 𝒜_S := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) S
    let gR : GradedAlgebra 𝒜_R := MvPolynomial.gradedAlgebra
    let gS : GradedAlgebra 𝒜_S := MvPolynomial.gradedAlgebra
    let P_R := weilProjectiveSpaceOver R N
    let P_S := weilProjectiveSpaceOver S N
    let hX_R : ∀ b : Fin (N + 1), (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) R) ∈ 𝒜_R 1 :=
      fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X R b)
    let hX_S : ∀ b : Fin (N + 1), (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) S) ∈ 𝒜_S 1 :=
      fun b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X S b)
    AlgebraicGeometry.IsProper P_R.hom ∧
    (⨆ a : Fin (N + 1), weilProjBasicOpen S N a) = ⊤ ∧
    (∃ (Φ : P_S.left ⟶ P_R.left),
      Φ ≫ P_R.hom = P_S.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ) ∧
      CategoryTheory.IsPullback Φ P_S.hom P_R.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ)) ∧
      (∀ a : Fin (N + 1),
        ∃ (heq_a : (TopologicalSpace.Opens.map Φ.base).obj (weilProjBasicOpen R N a) =
            weilProjBasicOpen S N a),
          (∀ (r : ℕ) (Q : MvPolynomial (Fin (N + 1)) R) (hQ : Q ∈ 𝒜_R (r • 1))
             (hQ_S : MvPolynomial.map ρ Q ∈ 𝒜_S (r • 1)),
            (Φ.appLE (weilProjBasicOpen R N a) (weilProjBasicOpen S N a)
              (le_of_eq heq_a.symm)).hom
              ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_R gR (MvPolynomial.X a)).hom
                (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_R gR _ _ (hX_R a) r Q hQ)) =
            (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_S gS (MvPolynomial.X a)).hom
              (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_S gS _ _
                (hX_S a) r (MvPolynomial.map ρ Q) hQ_S)) ∧
          (∀ (c : S) (hC_S : (MvPolynomial.C c : MvPolynomial (Fin (N + 1)) S) ∈ 𝒜_S (0 • 1)),
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫
              P_S.hom.appLE ⊤ (weilProjBasicOpen S N a) le_top).hom c =
            (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_S gS (MvPolynomial.X a)).hom
              (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_S gS _ _
                (hX_S a) 0 (MvPolynomial.C c) hC_S)))) ∧
    (∀ (L : MvPolynomial (Fin (N + 1)) S) (hL : L ∈ 𝒜_S 1),
      let D_L : P_S.left.Opens := @AlgebraicGeometry.Proj.basicOpen _ _ _ _ _ 𝒜_S gS L
      AlgebraicGeometry.IsAffineOpen D_L ∧
      Function.Bijective (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_S gS L).hom ∧
      (∀ a : Fin (N + 1),
        P_S.left.basicOpen
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_S gS (MvPolynomial.X a)).hom
            (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_S gS _ _ (hX_S a) 1 L hL)) =
          weilProjBasicOpen S N a ⊓ D_L) ∧
      (∀ (a : Fin (N + 1)) (r : ℕ) (P : MvPolynomial (Fin (N + 1)) S) (hP : P ∈ 𝒜_S (r • 1)),
        ((P_S.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : weilProjBasicOpen S N a ⊓ D_L ≤ D_L)).op).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_S gS L).hom
            (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_S gS _ _ hL r P hP))) *
        ((P_S.left.presheaf.map
          (CategoryTheory.homOfLE
            (inf_le_left : weilProjBasicOpen S N a ⊓ D_L ≤ weilProjBasicOpen S N a)).op).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_S gS (MvPolynomial.X a)).hom
            (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_S gS _ _ (hX_S a) 1 L hL))) ^ r =
        (P_S.left.presheaf.map
          (CategoryTheory.homOfLE
            (inf_le_left : weilProjBasicOpen S N a ⊓ D_L ≤ weilProjBasicOpen S N a)).op).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_S gS (MvPolynomial.X a)).hom
            (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_S gS _ _ (hX_S a) r P hP)))) ∧
    (∀ (U : AlgebraicGeometry.Scheme.{u})
       (ψ : MvPolynomial (Fin (N + 1)) R →+* ↑(U.presheaf.obj (Opposite.op ⊤)))
       (hψ : Ideal.map ψ (@HomogeneousIdeal.irrelevant _ _ _ _ _ _ _ _ _ _ 𝒜_R gR).toIdeal = ⊤)
       (a : Fin (N + 1))
       (hW_a : U.basicOpen (ψ (MvPolynomial.X a)) ≤
         (TopologicalSpace.Opens.map
           (@AlgebraicGeometry.Proj.fromOfGlobalSections _ _ _ _ _ 𝒜_R gR U ψ hψ).base).obj
           (weilProjBasicOpen R N a))
       (r : ℕ) (Q : MvPolynomial (Fin (N + 1)) R) (hQ : Q ∈ 𝒜_R (r • 1)),
      ((@AlgebraicGeometry.Proj.fromOfGlobalSections _ _ _ _ _ 𝒜_R gR U ψ hψ).appLE
        (weilProjBasicOpen R N a) (U.basicOpen (ψ (MvPolynomial.X a))) hW_a).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_R gR (MvPolynomial.X a)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_R gR _ _ (hX_R a) r Q hQ)) *
      ((U.presheaf.map (CategoryTheory.homOfLE (U.basicOpen_le (ψ (MvPolynomial.X a)))).op).hom
        (ψ (MvPolynomial.X a))) ^ r =
      (U.presheaf.map (CategoryTheory.homOfLE (U.basicOpen_le (ψ (MvPolynomial.X a)))).op).hom
        (ψ Q)) :=
by
  classical
  intro 𝒜_R 𝒜_S gR gS P_R P_S hX_R hX_S
  let _ : GradedAlgebra 𝒜_R := gR
  let _ : GradedAlgebra 𝒜_S := gS
  
  
  
  have hX_mem : ∀ (T : Type u) [CommRing T] (b : Fin (N + 1)),
      (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) T) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T 1 :=
    fun T _ b => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X T b)
  have halg0 : ∀ (T : Type u) [CommRing T] (t : T),
      (algebraMap T ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T 0) t :
        MvPolynomial (Fin (N + 1)) T) = MvPolynomial.C t := by
    intro T _ t
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    rw [Algebra.algebraMap_eq_smul_one]
    change t • (1 : MvPolynomial (Fin (N + 1)) T) = MvPolynomial.C t
    rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
  have hSpec_ext : ∀ {Z_s : AlgebraicGeometry.Scheme.{u}} {B : CommRingCat.{u}}
      (m₁ m₂ : Z_s ⟶ AlgebraicGeometry.Spec B),
      m₁.appTop = m₂.appTop → m₁ = m₂ := by
    intro Z_s B m₁ m₂ happ
    let e_adj := AlgebraicGeometry.ΓSpec.adjunction.homEquiv Z_s (Opposite.op B)
    apply e_adj.symm.injective
    apply Quiver.Hom.unop_inj
    let φ₁ : B ⟶ Z_s.presheaf.obj (Opposite.op ⊤) := (e_adj.symm m₁).unop
    let φ₂ : B ⟶ Z_s.presheaf.obj (Opposite.op ⊤) := (e_adj.symm m₂).unop
    have h1 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₁
    have h2 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₂
    have hg₁ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Z_s (Opposite.op B)) φ₁.op = m₁ :=
      e_adj.apply_symm_apply m₁
    have hg₂ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv Z_s (Opposite.op B)) φ₂.op = m₂ :=
      e_adj.apply_symm_apply m₂
    rw [hg₁] at h1
    rw [hg₂] at h2
    change φ₁ = φ₂
    rw [← h1, ← h2, happ]
  have hBridge : ∀ (T : Type u) [CommRing T]
      (f : MvPolynomial (Fin (N + 1)) T)
      (hf : f ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T 1),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 f hf zero_lt_one =
      (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 f hf zero_lt_one).fromSpec := by
    intro T _ f hf 𝒜
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U : (AlgebraicGeometry.Proj 𝒜).Opens := AlgebraicGeometry.Proj.basicOpen 𝒜 f
    let hU : AlgebraicGeometry.IsAffineOpen U :=
      AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 f hf zero_lt_one
    have hg_eq : U.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom := by
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom]
      apply hSpec_ext
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop]
      change (AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f)).appTop ≫
          ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom ≫ U.topIso.inv) =
        (AlgebraicGeometry.Proj.basicOpenToSpec 𝒜 f).app ⊤
      rw [AlgebraicGeometry.Proj.basicOpenToSpec_app_top]
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality
        (AlgebraicGeometry.Proj.awayToSection 𝒜 f)
      rw [← Category.assoc, hnat, Category.assoc]
    have hiso_hom : hU.isoSpec.hom = U.toSpecΓ := AlgebraicGeometry.IsAffineOpen.isoSpec_hom hU
    have hspec_eq : AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜 f) =
        hU.isoSpec.inv ≫ (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 f hf zero_lt_one).hom := by
      rw [← hiso_hom] at hg_eq
      rw [← hg_eq, Iso.inv_hom_id_assoc]
    rw [hspec_eq, ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜 f hf zero_lt_one,
      Category.assoc, Iso.hom_inv_id_assoc, AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι]
  have hBridge_R : ∀ (f : MvPolynomial (Fin (N + 1)) R) (hf : f ∈ 𝒜_R 1),
      AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_R f) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_R f hf zero_lt_one =
      (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_R f hf zero_lt_one).fromSpec :=
    fun f hf => hBridge R f hf
  have hBridge_S : ∀ (f : MvPolynomial (Fin (N + 1)) S) (hf : f ∈ 𝒜_S 1),
      AlgebraicGeometry.Spec.map (AlgebraicGeometry.Proj.awayToSection 𝒜_S f) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_S f hf zero_lt_one =
      (AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_S f hf zero_lt_one).fromSpec :=
    fun f hf => hBridge S f hf
  have hIrrel : ∀ (T : Type u) [CommRing T],
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) T)) := by
    intro T _ 𝒜
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    intro p hp
    have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
    have hp_sum : (∑ i ∈ (DirectSum.decompose 𝒜 p).support,
        (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) T)) = p :=
      DirectSum.sum_support_decompose 𝒜 p
    have hcoeff0 : p.coeff 0 = 0 := by
      rw [← hp_sum, MvPolynomial.coeff_sum]
      apply Finset.sum_eq_zero
      intro i _
      by_cases hi : i = 0
      · subst hi
        have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin (N + 1)) T) = 0 := hp0_proj
        rw [h0]
        simp
      · have hmem_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) T) ∈ 𝒜 i :=
          (DirectSum.decompose 𝒜 p i).2
        have hhom_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) T).IsHomogeneous i :=
          (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem_i
        by_contra hne0
        have hdeg0 := hhom_i hne0
        simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg0
        exact hi hdeg0.symm
    have hrange : (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) T)) =
        MvPolynomial.X '' (Set.univ : Set (Fin (N + 1))) := Set.image_univ.symm
    rw [hrange, MvPolynomial.mem_ideal_span_X_image]
    intro m_idx hm
    have hm_ne : m_idx ≠ 0 := by
      intro hm0
      subst hm0
      exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
    have hex : ∃ a : Fin (N + 1), m_idx a ≠ 0 := by
      by_contra hall
      exact hm_ne (Finsupp.ext fun a => Classical.not_not.mp fun h => hall ⟨a, h⟩)
    rcases hex with ⟨a, ha⟩
    exact ⟨a, Set.mem_univ a, ha⟩
  have hProperCover : ∀ (T : Type u) [CommRing T],
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver T N).hom ∧
      (⨆ a : Fin (N + 1), weilProjBasicOpen T N a) = ⊤ := by
    intro T _
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hinj : Function.Injective (algebraMap T ↥(𝒜 0)) := by
      intro r₁ r₂ h
      have h1 : (algebraMap T ↥(𝒜 0) r₁ : MvPolynomial (Fin (N + 1)) T) =
          (algebraMap T ↥(𝒜 0) r₂ : MvPolynomial (Fin (N + 1)) T) := congrArg Subtype.val h
      rw [halg0 T r₁, halg0 T r₂] at h1
      simpa using congrArg MvPolynomial.constantCoeff h1
    have hsurj : Function.Surjective (algebraMap T ↥(𝒜 0)) := by
      intro p
      refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
      rw [halg0 T]
      ext m_idx
      by_cases hm : m_idx = 0
      · subst hm
        simp
      · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h => (hm h.symm).elim]
        symm
        by_contra hne
        have hp : p.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
        have hdeg := hp hne
        simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
        have hne' : ∃ i : Fin (N + 1), m_idx i ≠ 0 := by
          by_contra hall
          exact hm (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
        rcases hne' with ⟨i, hi⟩
        exact hi ((Finset.sum_eq_zero_iff.mp hdeg) i (Finsupp.mem_support_iff.mpr hi))
    let e₀ : T ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap T ↥(𝒜 0)) ⟨hinj, hsurj⟩
    have he₀ : CommRingCat.ofHom (algebraMap T ↥(𝒜 0)) = e₀.toCommRingCatIso.hom := by
      apply CommRingCat.hom_ext
      rfl
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap T ↥(𝒜 0))) := by
      rw [he₀]
      infer_instance
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap T ↥(𝒜 0)))) :=
      inferInstance
    let _ : IsScalarTower T ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) T) :=
      IsScalarTower.of_algebraMap_eq' (R := T) (S := ↥(𝒜 0))
        (A := MvPolynomial (Fin (N + 1)) T) (RingHom.ext fun t => by
          change algebraMap T (MvPolynomial (Fin (N + 1)) T) t =
            (algebraMap T ↥(𝒜 0) t : MvPolynomial (Fin (N + 1)) T)
          rw [halg0 T t, MvPolynomial.algebraMap_eq])
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) T) :=
      Algebra.FiniteType.of_restrictScalars_finiteType T ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) T)
    have hProp : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver T N).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap T ↥(𝒜 0))))
      infer_instance
    have hCov : (⨆ a : Fin (N + 1), weilProjBasicOpen T N a) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X (hIrrel T)
    exact ⟨hProp, hCov⟩
  refine ⟨(hProperCover R).1, (hProperCover S).2, ?_, ?_, ?_⟩
  
  
  
  · have hDehom : ∀ (T : Type u) [CommRing T] (a : Fin (N + 1))
        (x : MvPolynomial (Fin (N + 1)) T) (hx : x = MvPolynomial.X a),
        let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T
        letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
        ∃ (e : MvPolynomial {b : Fin (N + 1) // b ≠ a} T ≃+* HomogeneousLocalization.Away 𝒜 x),
          (∀ t : T, e (MvPolynomial.C t) =
            HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x)
              (algebraMap T ↥(𝒜 0) t)) ∧
          (∀ b : {b : Fin (N + 1) // b ≠ a}, e (MvPolynomial.X b) =
            HomogeneousLocalization.Away.mk 𝒜 (hx ▸ hX_mem T a) 1
              (MvPolynomial.X b.1) (hX_mem T b.1)) := by
      intro T _ a x hx
      subst hx
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) T
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let τ := {b : Fin (N + 1) // b ≠ a}
      let X_a : MvPolynomial (Fin (N + 1)) T := MvPolynomial.X a
      let S_a : Submonoid (MvPolynomial (Fin (N + 1)) T) := Submonoid.powers X_a
      let ι_a : T →+* HomogeneousLocalization.Away 𝒜 X_a :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_a).comp (algebraMap T ↥(𝒜 0))
      let t_tilde : Fin (N + 1) → HomogeneousLocalization.Away 𝒜 X_a :=
        fun c => HomogeneousLocalization.Away.mk 𝒜 (hX_mem T a) 1
          (MvPolynomial.X c) (hX_mem T c)
      let α : MvPolynomial τ T →+* HomogeneousLocalization.Away 𝒜 X_a :=
        MvPolynomial.eval₂Hom ι_a (fun b : τ => t_tilde b.1)
      let w : Fin (N + 1) → MvPolynomial τ T :=
        fun j => if h : j = a then 1 else MvPolynomial.X ⟨j, h⟩
      let dehom : MvPolynomial (Fin (N + 1)) T →+* MvPolynomial τ T :=
        MvPolynomial.eval₂Hom MvPolynomial.C w
      have hdehom_Xa : dehom X_a = 1 := by
        simp [dehom, w, X_a]
      have hdehom_S : ∀ y : S_a, dehom y.1 = 1 := by
        rintro ⟨_, n, rfl⟩
        simp [map_pow, hdehom_Xa]
      have hy_unit : ∀ y : S_a, IsUnit (dehom y.1) := fun y => by
        rw [hdehom_S y]
        exact isUnit_one
      let β_loc : Localization S_a →+* MvPolynomial τ T := IsLocalization.lift hy_unit
      have hβ_loc_mk : ∀ (p : MvPolynomial (Fin (N + 1)) T) (y : S_a),
          β_loc (Localization.mk p y) = dehom p := by
        intro p y
        rw [Localization.mk_eq_mk']
        dsimp only [β_loc]
        rw [IsLocalization.lift_mk'_spec, hdehom_S y, one_mul]
      let valHom : HomogeneousLocalization.Away 𝒜 X_a →+* Localization S_a :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := fun u v => HomogeneousLocalization.val_mul u v
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := fun u v => HomogeneousLocalization.val_add u v }
      let β : HomogeneousLocalization.Away 𝒜 X_a →+* MvPolynomial τ T :=
        β_loc.comp valHom
      have hval_ι : ∀ t : T, (ι_a t).val = Localization.mk (MvPolynomial.C t) 1 := by
        intro t
        change (HomogeneousLocalization.mk
          ⟨0, algebraMap T ↥(𝒜 0) t, 1, Submonoid.one_mem S_a⟩).val =
          Localization.mk (MvPolynomial.C t) 1
        rw [HomogeneousLocalization.val_mk, halg0 T t]
        rfl
      have hleft : Function.LeftInverse β α := by
        have hcomp : β.comp α = RingHom.id (MvPolynomial τ T) := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro t
            simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_C, β, valHom,
              RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, hval_ι, hβ_loc_mk, dehom]
          · intro b
            have hwb : w b.1 = MvPolynomial.X b := by simp [w, b.2]
            simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_X', β, valHom,
              RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, t_tilde,
              HomogeneousLocalization.Away.val_mk, hβ_loc_mk, dehom, MvPolynomial.eval₂Hom_X', hwb]
        intro q
        exact RingHom.congr_fun hcomp q
