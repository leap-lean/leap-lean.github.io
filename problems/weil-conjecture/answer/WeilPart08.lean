      have h_exists_t : ∃ t ∈ s_span, ev_A' t ≠ 0 := by
        by_contra hall
        have hall' : ∀ t ∈ s_span, t ∈ RingHom.ker ev_A' :=
          fun t ht => Classical.not_not.mp fun h => hall ⟨t, ht, h⟩
        have htop_le : (⊤ : Ideal A') ≤ RingHom.ker ev_A' := by
          rw [← hs_top, Ideal.span_le]
          exact hall'
        exact (RingHom.ker_isPrime ev_A').ne_top (top_unique htop_le)
      obtain ⟨t, ht_mem, ht_ne⟩ := h_exists_t
      let A'' := Localization.Away t
      obtain ⟨θ_mv, hθ_comp, hθ_et⟩ := (hs_sm t ht_mem).exists_etale_mvPolynomial
      let e_poly : Polynomial k_P ≃+* MvPolynomial (Fin 1) k_P :=
        (MvPolynomial.uniqueAlgEquiv k_P (Fin 1)).symm.toRingEquiv
