            ((x_F⁻¹) ^ (j : ℕ) * x_F ^ (j : ℕ)) * x_F ^ (d - (j : ℕ)) := by ring
      _ = ι (Polynomial.C (Q.coeff (j : ℕ))) * x_F ^ (d - (j : ℕ)) := by rw [hcancel, mul_one]
