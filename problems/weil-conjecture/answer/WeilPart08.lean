    have hd₀ : IsUnit d₀ := by
      have hEq := hResComp hEV0.le (X.basicOpen_le (Φ₀ P_b)) (inf_le_right : U₀_E ≤ V₀) (Φ₀ P_b)
      dsimp only [d₀]
      rw [← hEq]
      exact (X.toRingedSpace.isUnit_res_basicOpen (Φ₀ P_b)).map
