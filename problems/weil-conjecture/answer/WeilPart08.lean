        _ = u ^ (i : ℕ) * (v ^ (i : ℕ) * v ^ (d - (i : ℕ))) := by rw [pow_add]
        _ = (u * v) ^ (i : ℕ) * v ^ (d - (i : ℕ)) := by rw [← mul_assoc, ← mul_pow]
