        have hC : θ (Polynomial.C c₀) = (algebraMap A' A'') (ψ_kA c₀) := by
          have he_C : e_poly (Polynomial.C c₀) = MvPolynomial.C c₀ := by
            change (MvPolynomial.uniqueAlgEquiv k_P (Fin 1)).symm (Polynomial.C c₀) = _
            rw [← Polynomial.algebraMap_eq, AlgEquiv.commutes]
            rfl
          change θ_mv (e_poly (Polynomial.C c₀)) = _
          rw [he_C]
          exact congrArg (fun g : k_P →+* A'' => g c₀) hθ_comp
