      let q₀ : PrimeSpectrum B := hUB.primeIdealOf ⟨u₀, hu₀_UB⟩
      have hq₀_u₀ : hUB.fromSpec.base q₀ = u₀ := hUB.fromSpec_primeIdealOf ⟨u₀, hu₀_UB⟩
      have hMap_q : ∀ q : PrimeSpectrum B,
