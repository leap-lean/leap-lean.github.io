      have htop_sq : isoV.inv ≫ ((Φ_lift ∣_ W_pb a) ≫ (p₁ ∣_ D_R a)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫ isoDR.inv := by
        rw [← cancel_mono (D_R a).ι]
