      haveI : Algebra.FormallyUnramified A_Z B_q := inferInstance
      let ℓ : A_p →+* B_q := Localization.localRingHom p_z.asIdeal q'₀.asIdeal e_AB rfl
      letI : Algebra A_p B_q := ℓ.toAlgebra
