        have hres := X.basicOpen_res (θ₀ b_hat) (CategoryTheory.homOfLE hV₁_le).op
        change X.basicOpen (res_V₁ (θ₀ b_hat)) = V₁ ⊓ X.basicOpen (θ₀ b_hat) at hres
        rw [hb_hat, hf_res] at hres
        rw [hres] at hx_b
        rw [hb_hat]
        exact hx_b.2
      have hqx_ub : q.base x ∈ ((X_next.basicOpen b_hat : X_next.Opens) : Set ↥X_next) := by
        change x ∈ (TopologicalSpace.Opens.map q.base).obj (X_next.basicOpen b_hat)
        rw [hPreBasic b_hat]
        exact hx_bt
      rw [hqx] at hqx_ub
      have hb_not : b_hat ∉ (hAffU₀.isoSpec.hom.base ⟨y_star, hy_star⟩).asIdeal :=
        (hBasicIff hAffU₀ ⟨y_star, hy_star⟩ b_hat).mp hqx_ub
      rw [hB1] at hb_not
      exact hb_not hb_mem
    · intro hxE
      have hqx_U₀ : q.base x ∈ U₀ := by
        change x ∈ (TopologicalSpace.Opens.map q.base).obj U₀
        rw [hPreU₀]
        exact hE_sub hxE
      let p_x := hAffU₀.isoSpec.hom.base ⟨q.base x, hqx_U₀⟩
      have hp_eq : p_x = p_star := by
        apply PrimeSpectrum.ext
        ext a
        rw [← not_iff_not]
        have h1 : a ∉ p_x.asIdeal ↔
            q.base x ∈ ((X_next.basicOpen a : X_next.Opens) : Set ↥X_next) :=
          (hBasicIff hAffU₀ ⟨q.base x, hqx_U₀⟩ a).symm
        have h2 : q.base x ∈ ((X_next.basicOpen a : X_next.Opens) : Set ↥X_next) ↔
            x ∈ ((X.basicOpen (θ₀ a) : X.Opens) : Set ↥X) := by
          change x ∈ (TopologicalSpace.Opens.map q.base).obj (X_next.basicOpen a) ↔ _
          rw [hPreBasic a]
          rfl
        have h3 : x ∈ ((X.basicOpen (θ₀ a) : X.Opens) : Set ↥X) ↔ ev_E (θ₀ a) ≠ 0 := by
          constructor
          · intro hxa hev0
            exact Set.disjoint_left.mp (hev_zero (θ₀ a) hev0) hxE hxa
          · intro hev_ne0
            exact hev_ne (θ₀ a) hev_ne0 hxE
        exact h1.trans (h2.trans h3)
      have hu_eq : (⟨q.base x, hqx_U₀⟩ : ↥U₀.toScheme) = u_star := by
        have h1 := congrArg hAffU₀.isoSpec.inv.base hp_eq
        have hl := congrArg (fun g => g.base ⟨q.base x, hqx_U₀⟩) hAffU₀.isoSpec.hom_inv_id
        exact hl.symm.trans h1
      exact congrArg Subtype.val hu_eq
  have hB3 : Set.InjOn q.base ((W₀ : Set ↥X) \ E_star) := by
    rintro x₁ ⟨hx₁_W₀, hx₁_notE⟩ x₂ ⟨_, _⟩ hq12
    have hy₁ : q.base x₁ ∈ U₀ := by
      change x₁ ∈ (TopologicalSpace.Opens.map q.base).obj U₀
      rw [hPreU₀]
      exact hx₁_W₀
    have hne₁ : q.base x₁ ≠ y_star := by
      intro heq_y
      apply hx₁_notE
      rw [← hB2]
      exact heq_y
    obtain ⟨U_y, hy_Uy, _, hIso_Uy⟩ := hB4 (q.base x₁) hy₁ hne₁
    let W_y : X.Opens := (TopologicalSpace.Opens.map q.base).obj U_y
    have hx₁_Wy : x₁ ∈ W_y := hy_Uy
    have hx₂_Wy : x₂ ∈ W_y := by
      change q.base x₂ ∈ U_y
      rw [← hq12]
      exact hy_Uy
    let f_U : W_y.toScheme ⟶ U_y.toScheme := q ∣_ U_y
    have : CategoryTheory.IsIso f_U := hIso_Uy
    have hUy_eq : U_y.ι.base (f_U.base ⟨x₁, hx₁_Wy⟩) = U_y.ι.base (f_U.base ⟨x₂, hx₂_Wy⟩) := by
      have h1 := congrArg (fun h => h.base ⟨x₁, hx₁_Wy⟩)
        (AlgebraicGeometry.morphismRestrict_ι q U_y)
      have h2 := congrArg (fun h => h.base ⟨x₂, hx₂_Wy⟩)
        (AlgebraicGeometry.morphismRestrict_ι q U_y)
      exact h1.trans (hq12.trans h2.symm)
    have hf_eq : f_U.base ⟨x₁, hx₁_Wy⟩ = f_U.base ⟨x₂, hx₂_Wy⟩ :=
      U_y.ι.isOpenEmbedding.injective hUy_eq
    have hsub_eq : (⟨x₁, hx₁_Wy⟩ : ↥W_y.toScheme) = ⟨x₂, hx₂_Wy⟩ := by
      have h_inv := congrArg (fun z => (CategoryTheory.inv f_U).base z) hf_eq
      have h_id : f_U ≫ CategoryTheory.inv f_U = 𝟙 W_y.toScheme :=
        CategoryTheory.IsIso.hom_inv_id f_U
      have hlhs := congrArg (fun h => h.base ⟨x₁, hx₁_Wy⟩) h_id
      have hrhs := congrArg (fun h => h.base ⟨x₂, hx₂_Wy⟩) h_id
      exact hlhs.symm.trans (h_inv.trans hrhs)
    exact congrArg Subtype.val hsub_eq
  exact ⟨hGlueE, y_star, hy_star, hB1, hB2, hB3, hB4⟩

theorem weil_sup1_caseB_pinch_chart_and_closed_component_drop (K : Type u) [Field K]
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (m : ℕ)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀)
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (hφ_comm : φ ≫ (weilProjectiveSpaceOver ↥V N').hom = g) :
    let g_next := AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))
    (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
        (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥V))
        (q_s : CategoryTheory.Limits.pullback g s ⟶
          CategoryTheory.Limits.pullback g_next s),
      q_s ≫ CategoryTheory.Limits.pullback.fst g_next s =
        CategoryTheory.Limits.pullback.fst g s ≫ AlgebraicGeometry.Scheme.Hom.toImage φ →
      q_s ≫ CategoryTheory.Limits.pullback.snd g_next s =
        CategoryTheory.Limits.pullback.snd g s →
      ∀ (U₀_s : (CategoryTheory.Limits.pullback g_next s).Opens)
        (heq₀ :
          (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj
            (V₁ ⊔ C.basicOpen eZ) ≤
          (TopologicalSpace.Opens.map q_s.base).obj U₀_s),
        AlgebraicGeometry.IsAffineOpen U₀_s →
        (TopologicalSpace.Opens.map q_s.base).obj U₀_s =
          (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj
            (V₁ ⊔ C.basicOpen eZ) →
        Function.Bijective
          (q_s.appLE U₀_s
            ((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj
              (V₁ ⊔ C.basicOpen eZ))
            heq₀).hom →
        ∀ E_star ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s),
          E_star ⊆
            (((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj
              (V₁ ⊔ C.basicOpen eZ) :
                (CategoryTheory.Limits.pullback g s).Opens) :
              Set ↥(CategoryTheory.Limits.pullback g s)) →
          ((((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj
              (V₁ ⊔ C.basicOpen eZ) :
                (CategoryTheory.Limits.pullback g s).Opens) :
              Set ↥(CategoryTheory.Limits.pullback g s)) ∩
              (⋃ E' ∈ (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s)) \ {E_star}, E') ⊆
            (CategoryTheory.Limits.pullback.fst g s).base ⁻¹' (V₁ : Set C)) →
          1 ≤ (E_star ∩
            (⋃ E' ∈ (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s)) \ {E_star}, E')).ncard →
          (E_star ∩
            (⋃ E' ∈ (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s)) \ {E_star}, E')).ncard ≤ 2 →
          (∀ y : ↥(CategoryTheory.Limits.pullback g_next s),
            y ∈ U₀_s →
            (∃ V_sm : (CategoryTheory.Limits.pullback g_next s).Opens,
              y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
                (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_next s)) ∨
            (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
                (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_next s)
                (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                  (MvPolynomial (Fin 2) K' ⧸ Ideal.span
                    {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
                      (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}))),
              AlgebraicGeometry.Etale e₁ ∧
              AlgebraicGeometry.Etale e₂ ∧
              e₁.base u₀ = y ∧
              (∀ i : Fin 2,
                Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K') ∈
                  (e₂.base u₀).asIdeal) ∧
              e₁ ≫ CategoryTheory.Limits.pullback.snd g_next s =
                e₂ ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
                    (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K')))) ∨
            HasTwoPointPinchAt K' (CategoryTheory.Limits.pullback.snd g_next s) y) ∧
          (∃ y_star : ↥(CategoryTheory.Limits.pullback g_next s),
            y_star ∈ U₀_s ∧
            q_s.base ⁻¹' {y_star} = E_star ∧
            Set.InjOn q_s.base
              ((((TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj
                (V₁ ⊔ C.basicOpen eZ) :
                  (CategoryTheory.Limits.pullback g s).Opens) :
                Set ↥(CategoryTheory.Limits.pullback g s)) \ E_star))) ∧
    (∀ (q_s₀ : CategoryTheory.Limits.pullback g s₀ ⟶
        CategoryTheory.Limits.pullback g_next s₀),
      IsClosedMap q_s₀.base →
      Function.Surjective q_s₀.base →
      (∃ y_star : ↥(CategoryTheory.Limits.pullback g_next s₀),
        q_s₀.base ⁻¹' {y_star} = Z ∧ Set.InjOn q_s₀.base (Zᶜ)) →
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next s₀)) <
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀))) :=
by
  classical
  intro g_next s₀
  refine ⟨?_, ?_⟩
  · intro K' _ _ s q_s hq_fst hq_snd U₀_s heq₀ hAffU₀ hPreU₀ hBij₀
      E_star hE_comp hE_sub hW₀_Y' hΔ_ge1 hΔ_le2
    let X_s := CategoryTheory.Limits.pullback g s
    let fst_s := CategoryTheory.Limits.pullback.fst g s
    let p_s := CategoryTheory.Limits.pullback.snd g s
    let X_next_s := CategoryTheory.Limits.pullback g_next s
    let p_next_s := CategoryTheory.Limits.pullback.snd g_next s
    let W₀_s : X_s.Opens :=
      (TopologicalSpace.Opens.map fst_s.base).obj (V₁ ⊔ C.basicOpen eZ)
    let V₁_s : X_s.Opens := (TopologicalSpace.Opens.map fst_s.base).obj V₁
    let Y'_s_set : Set ↥X_s :=
      ⋃ E' ∈ (irreducibleComponents ↥X_s) \ {E_star}, E'
    let Δ_s : Set ↥X_s := E_star ∩ Y'_s_set
    have hΔ_ge1' : 1 ≤ Δ_s.ncard := hΔ_ge1
    have hΔ_le2' : Δ_s.ncard ≤ 2 := hΔ_le2
    have hPropG : AlgebraicGeometry.IsProper g := hSemi.1.2.2.1
    have hLFPG : AlgebraicGeometry.LocallyOfFinitePresentation g := hSemi.1.2.2.2.1
    have : AlgebraicGeometry.IsProper p_s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g s) hPropG
    have : AlgebraicGeometry.LocallyOfFinitePresentation p_s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g s) hLFPG
    have : AlgebraicGeometry.IsAffineHom fst_s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g s).flip
        (inferInstance : AlgebraicGeometry.IsAffineHom s)
    have hAffV₁_s : AlgebraicGeometry.IsAffineOpen V₁_s := hPencil.2.1.preimage fst_s
    have hV₁_le_W₀ : V₁_s ≤ W₀_s :=
      (TopologicalSpace.Opens.map fst_s.base).monotone le_sup_left
    have hGeom_s := (hSemi.2.2.2 K' s).2
    obtain ⟨⟨hFinX, hRedX⟩, hNodalAt, hConstComp⟩ :=
      weil_sup1_semistable_geom_fiber_reduced_and_const_comp
        K' X_s p_s inferInstance inferInstance hGeom_s
    have : AlgebraicGeometry.IsReduced X_s := hRedX
    have hE_closed : IsClosed E_star := isClosed_of_mem_irreducibleComponents E_star hE_comp
    have hFinRem : ((irreducibleComponents ↥X_s) \ {E_star}).Finite := hFinX.sdiff
    have hY'_closed : IsClosed Y'_s_set :=
      hFinRem.isClosed_biUnion fun E' hE' => isClosed_of_mem_irreducibleComponents E' hE'.1
    have hCovX : E_star ∪ Y'_s_set = Set.univ := by
      ext x
      simp only [Set.mem_union, Set.mem_univ, iff_true]
      by_cases hxE : irreducibleComponent x = E_star
      · left
        rw [← hxE]
        exact mem_irreducibleComponent
      · right
        exact Set.mem_biUnion ⟨irreducibleComponent_mem_irreducibleComponents x, hxE⟩
          mem_irreducibleComponent
    have hΔ_ne : Δ_s.Nonempty := Set.nonempty_of_ncard_ne_zero (by omega)
    obtain ⟨ev_E, hev_id, hev_zero, hev_ne⟩ := hConstComp E_star hE_comp W₀_s hE_sub
    have hev_surj : Function.Surjective ev_E :=
      fun c => ⟨_, DFunLike.congr_fun hev_id c⟩
    obtain ⟨hGlueE, y_star, hy_star, hm_star_eq, hPre_y_star, hInj_away, hIso_away⟩ :=
      weil_sup1_caseB_two_open_gluing_and_away_iso
        K' X_s X_next_s q_s U₀_s hAffU₀ W₀_s V₁_s hAffV₁_s hV₁_le_W₀
        heq₀ hPreU₀ hBij₀ E_star Y'_s_set hE_closed hY'_closed hCovX
        hE_sub hW₀_Y' hΔ_ne ev_E hev_surj hev_zero hev_ne
    refine ⟨?_, ⟨y_star, hy_star, hPre_y_star, hInj_away⟩⟩
    intro y hy_U₀
    by_cases hy_eq : y = y_star
    · subst hy_eq
      let R₁ := ↑(X_s.presheaf.obj (Opposite.op V₁_s))
      let W₀_ring := ↑(X_s.presheaf.obj (Opposite.op W₀_s))
      let U₀_ring := ↑(X_next_s.presheaf.obj (Opposite.op U₀_s))
      let ιK_U₀ : K' →+* U₀_ring :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
          p_next_s.appLE ⊤ U₀_s (fun _ _ => trivial)).hom
      let ιK_W₀ : K' →+* W₀_ring :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
          p_s.appLE ⊤ W₀_s (fun _ _ => trivial)).hom
      let ιK_V₁ : K' →+* R₁ :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
          p_s.appLE ⊤ V₁_s (fun _ _ => trivial)).hom
      let θ₀ : U₀_ring →+* W₀_ring := (q_s.appLE U₀_s W₀_s heq₀).hom
      let res_V₁ : W₀_ring →+* R₁ :=
        (X_s.presheaf.map (CategoryTheory.homOfLE hV₁_le_W₀).op).hom
      have hev_id_app : ∀ c : K', ev_E (ιK_W₀ c) = c :=
        fun c => DFunLike.congr_fun hev_id c
      have hθ₀_ιK : θ₀.comp ιK_U₀ = ιK_W₀ := by
        ext c
        have h_eq : p_next_s.appLE ⊤ U₀_s (fun _ _ => trivial) ≫ q_s.appLE U₀_s W₀_s heq₀ =
            p_s.appLE ⊤ W₀_s (fun _ _ => trivial) := by
          refine (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE q_s p_next_s ⊤ U₀_s W₀_s
            (fun _ _ => trivial) heq₀).trans ?_
          dsimp only [p_next_s, p_s]
          rw [hq_snd]
        exact congrArg
          (fun f => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫ f).hom c) h_eq
      have hres_ιK : res_V₁.comp ιK_W₀ = ιK_V₁ := by
        ext c
        have h_eq : p_s.appLE ⊤ W₀_s (fun _ _ => trivial) ≫
            X_s.presheaf.map (CategoryTheory.homOfLE hV₁_le_W₀).op =
            p_s.appLE ⊤ V₁_s (fun _ _ => trivial) :=
          AlgebraicGeometry.Scheme.Hom.appLE_map p_s _ _
        exact congrArg
          (fun f => ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫ f).hom c) h_eq
      have hAffSpecMap : ∀ {X_aux : AlgebraicGeometry.Scheme.{u}}
          (p_aux : X_aux ⟶ AlgebraicGeometry.Spec (CommRingCat.of K'))
          (U_aux : X_aux.Opens) (hAff_aux : AlgebraicGeometry.IsAffineOpen U_aux)
          (h_le_aux : U_aux ≤ (TopologicalSpace.Opens.map p_aux.base).obj ⊤),
          hAff_aux.isoSpec.hom ≫ AlgebraicGeometry.Spec.map
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
              p_aux.appLE ⊤ U_aux h_le_aux) = U_aux.ι ≫ p_aux := by
        intro X_aux p_aux U_aux hAff_aux h_le_aux
        have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE p_aux ⊤ U_aux h_le_aux
        rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom, AlgebraicGeometry.Spec.map_comp,
          ← CategoryTheory.Category.assoc, h1]
        simp
      have hIsoU₀_p : hAffU₀.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιK_U₀) =
          U₀_s.ι ≫ p_next_s :=
        hAffSpecMap p_next_s U₀_s hAffU₀ (fun _ _ => trivial)
      have hFT_R₁ : ιK_V₁.FiniteType := by
        have h1 : (p_s.appLE ⊤ V₁_s (fun _ _ => trivial)).hom.FiniteType :=
          AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE p_s
            (AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of K')))
            hAffV₁_s (fun _ _ => trivial)
        have h2 : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv).hom.FiniteType := by
          apply RingHom.FiniteType.of_surjective
          exact ((ConcreteCategory.isIso_iff_bijective
            (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv).mp inferInstance).2
        exact h1.comp h2
      have hIrredSlice : ∀ (S : Set ↥X_s), IsIrreducible S → (S ∩ (V₁_s : Set ↥X_s)).Nonempty →
          IsIrreducible (hAffV₁_s.isoSpec.hom.base '' {x : ↥V₁_s.toScheme | x.1 ∈ S}) := by
        intro S hS ⟨q₀, hq₀S, hq₀V₁⟩
        have hSubIrred : IsIrreducible {x : ↥V₁_s.toScheme | x.1 ∈ S} := by
          refine ⟨⟨⟨q₀, hq₀V₁⟩, hq₀S⟩, ?_⟩
          intro u v hu hv ⟨x₁, hx₁S, hx₁u⟩ ⟨x₂, hx₂S, hx₂v⟩
          have hu_open : IsOpen (Subtype.val '' u : Set ↥X_s) :=
            V₁_s.2.isOpenMap_subtype_val u hu
          have hv_open : IsOpen (Subtype.val '' v : Set ↥X_s) :=
            V₁_s.2.isOpenMap_subtype_val v hv
          obtain ⟨z, hzS, ⟨y₁, hy₁u, rfl⟩, ⟨y₂, hy₂v, hy₂eq⟩⟩ :=
            hS.2 (Subtype.val '' u) (Subtype.val '' v) hu_open hv_open
              ⟨x₁.1, hx₁S, ⟨x₁, hx₁u, rfl⟩⟩ ⟨x₂.1, hx₂S, ⟨x₂, hx₂v, rfl⟩⟩
          have hy : y₁ = y₂ := (Subtype.ext hy₂eq).symm
          rw [← hy] at hy₂v
          exact ⟨y₁, hzS, hy₁u, hy₂v⟩
        exact hSubIrred.image hAffV₁_s.isoSpec.hom.base hAffV₁_s.isoSpec.hom.continuous.continuousOn
      have hVanLeIff : ∀ (S : Set ↥X_s), IsClosed S → ∀ (p : PrimeSpectrum R₁),
          PrimeSpectrum.vanishingIdeal
            (hAffV₁_s.isoSpec.hom.base '' {x : ↥V₁_s.toScheme | x.1 ∈ S}) ≤ p.asIdeal ↔
          (hAffV₁_s.isoSpec.inv.base p).1 ∈ S := by
        intro S hS p
        let Sigma_S : Set (PrimeSpectrum R₁) :=
          hAffV₁_s.isoSpec.hom.base '' {x : ↥V₁_s.toScheme | x.1 ∈ S}
        have hSigma_eq :
            Sigma_S = (fun r : PrimeSpectrum R₁ => (hAffV₁_s.isoSpec.inv.base r).1) ⁻¹' S := by
          ext r
          constructor
          · rintro ⟨x, hxS, rfl⟩
            have hinv : hAffV₁_s.isoSpec.inv.base (hAffV₁_s.isoSpec.hom.base x) = x :=
              congrArg (fun f => f.base x) hAffV₁_s.isoSpec.hom_inv_id
            change (hAffV₁_s.isoSpec.inv.base (hAffV₁_s.isoSpec.hom.base x)).1 ∈ S
            rw [hinv]
            exact hxS
          · intro hr
            refine ⟨hAffV₁_s.isoSpec.inv.base r, hr, ?_⟩
            exact congrArg (fun f => f.base r) hAffV₁_s.isoSpec.inv_hom_id
        have hSigma_cl : IsClosed Sigma_S := by
          rw [hSigma_eq]
          exact hS.preimage (continuous_subtype_val.comp hAffV₁_s.isoSpec.inv.continuous)
        change p ∈ PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal Sigma_S : Set R₁) ↔ _
        rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hSigma_cl.closure_eq, hSigma_eq,
          Set.mem_preimage]
      have hBasicV₁Iff : ∀ (x : ↥V₁_s.toScheme) (r : R₁),
          x.1 ∈ (X_s.basicOpen r : Set ↥X_s) ↔
            r ∉ (hAffV₁_s.isoSpec.hom.base x).asIdeal := by
        intro x r
        have hpre := AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen V₁_s r
        rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_hom hAffV₁_s] at hpre
        have hmem := TopologicalSpace.Opens.ext_iff.mp hpre
        have hx := Set.ext_iff.mp hmem x
        exact hx.symm.trans (PrimeSpectrum.mem_basicOpen r (hAffV₁_s.isoSpec.hom.base x))
      let I_E : Ideal R₁ :=
        PrimeSpectrum.vanishingIdeal
          (hAffV₁_s.isoSpec.hom.base '' {x : ↥V₁_s.toScheme | x.1 ∈ E_star})
      let I_Y' : Ideal R₁ :=
        PrimeSpectrum.vanishingIdeal
          (hAffV₁_s.isoSpec.hom.base '' {x : ↥V₁_s.toScheme | x.1 ∈ Y'_s_set})
      have hΔ_sub_V₁ : Δ_s ⊆ (V₁_s : Set ↥X_s) :=
        fun q hq => hW₀_Y' ⟨hE_sub hq.1, hq.2⟩
      obtain ⟨q₀_wit, hq₀_Δ⟩ := hΔ_ne
      have hIE_prime : I_E.IsPrime :=
        PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp
          (hIrredSlice E_star hE_comp.1 ⟨q₀_wit, hq₀_Δ.1, hΔ_sub_V₁ hq₀_Δ⟩)
      have : I_E.IsPrime := hIE_prime
      have hRadY : I_Y'.IsRadical := PrimeSpectrum.isRadical_vanishingIdeal _
      have hInfBot : I_E ⊓ I_Y' = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro a ha
        have hnil : IsNilpotent a := by
          rw [← mem_nilradical, PrimeSpectrum.nilradical_eq_iInf, Ideal.mem_iInf]
          intro p
          have hp_cov : (hAffV₁_s.isoSpec.inv.base p).1 ∈ E_star ∪ Y'_s_set := by
            rw [hCovX]; trivial
          rcases hp_cov with hpE | hpY
          · exact ((hVanLeIff E_star hE_closed p).mpr hpE) ha.1
          · exact ((hVanLeIff Y'_s_set hY'_closed p).mpr hpY) ha.2
        exact hnil.eq_zero
      have hNotSubY : ¬ (I_Y' ≤ I_E) := by
        intro hle
        have hSubOpen : E_star ∩ (V₁_s : Set ↥X_s) ⊆ Y'_s_set := by
          rintro x ⟨hxE, hxV₁⟩
          let p := hAffV₁_s.isoSpec.hom.base ⟨x, hxV₁⟩
          have hpE : I_E ≤ p.asIdeal := by
            rw [hVanLeIff E_star hE_closed p]
            have hinv : hAffV₁_s.isoSpec.inv.base p = ⟨x, hxV₁⟩ :=
              congrArg (fun f => f.base ⟨x, hxV₁⟩) hAffV₁_s.isoSpec.hom_inv_id
            rw [hinv]; exact hxE
          have hpY : (hAffV₁_s.isoSpec.inv.base p).1 ∈ Y'_s_set :=
            (hVanLeIff Y'_s_set hY'_closed p).mp (hle.trans hpE)
          have hinv : hAffV₁_s.isoSpec.inv.base p = ⟨x, hxV₁⟩ :=
            congrArg (fun f => f.base ⟨x, hxV₁⟩) hAffV₁_s.isoSpec.hom_inv_id
          rw [hinv] at hpY
          exact hpY
        have hUnion : E_star ⊆ Y'_s_set ∪ (V₁_s : Set ↥X_s)ᶜ := by
          intro x hxE
          by_cases hxV₁ : x ∈ (V₁_s : Set ↥X_s)
          · exact Or.inl (hSubOpen ⟨hxE, hxV₁⟩)
          · exact Or.inr hxV₁
        rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hE_comp.1.2)
            Y'_s_set (V₁_s : Set ↥X_s)ᶜ hY'_closed V₁_s.2.isClosed_compl hUnion with
          hE_in_Y' | hE_in_compl
        · have hsUnion : E_star ⊆ ⋃₀ (↑hFinRem.toFinset : Set (Set ↥X_s)) := by
            intro x hx
            obtain ⟨E', hE', hxE'⟩ := Set.mem_iUnion₂.mp (hE_in_Y' hx)
            exact Set.mem_sUnion.mpr ⟨E', hFinRem.mem_toFinset.mpr hE', hxE'⟩
          obtain ⟨E', hE'_fin, hE_sub_E'⟩ :=
            (isIrreducible_iff_sUnion_isClosed.mp hE_comp.1) hFinRem.toFinset
              (fun E' hE' =>
                isClosed_of_mem_irreducibleComponents E' (hFinRem.mem_toFinset.mp hE').1)
              hsUnion
          have hE'_mem := hFinRem.mem_toFinset.mp hE'_fin
          have hEq : E' = E_star :=
            Set.Subset.antisymm (hE_comp.2 hE'_mem.1.1 hE_sub_E') hE_sub_E'
          exact hE'_mem.2 hEq
        · exact hE_in_compl hq₀_Δ.1 (hΔ_sub_V₁ hq₀_Δ)
      have hNodePkg : ∀ (q : ↥X_s) (hq_Δ : q ∈ Δ_s),
          let hq_V₁ : q ∈ V₁_s := hΔ_sub_V₁ hq_Δ
          let M_q : Ideal R₁ := (hAffV₁_s.isoSpec.hom.base ⟨q, hq_V₁⟩).asIdeal
          M_q.IsMaximal ∧
          (∀ m ∈ M_q, ∃ s_el : R₁, s_el ∉ M_q ∧ s_el * m ∈ I_E ⊔ I_Y') ∧
          ∃ (ev_q : R₁ ⧸ I_Y' →+* K'),
            ev_q.comp ((Ideal.Quotient.mk I_Y').comp ιK_V₁) = RingHom.id K' ∧
            RingHom.ker (ev_q.comp (Ideal.Quotient.mk I_Y')) = M_q ∧
            ∃ V_q : (AlgebraicGeometry.Spec (CommRingCat.of (R₁ ⧸ I_Y'))).Opens,
              (⟨RingHom.ker ev_q, RingHom.ker_isPrime ev_q⟩ : PrimeSpectrum (R₁ ⧸ I_Y')) ∈ V_q ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1
                (V_q.ι ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom ((Ideal.Quotient.mk I_Y').comp ιK_V₁))) := by
        intro q hq_Δ
        let hq_V₁ : q ∈ V₁_s := hΔ_sub_V₁ hq_Δ
        let p_q : PrimeSpectrum R₁ := hAffV₁_s.isoSpec.hom.base ⟨q, hq_V₁⟩
        let M_q : Ideal R₁ := p_q.asIdeal
        have : M_q.IsPrime := p_q.isPrime
        have hinv_pq : hAffV₁_s.isoSpec.inv.base p_q = ⟨q, hq_V₁⟩ :=
          congrArg (fun f => f.base ⟨q, hq_V₁⟩) hAffV₁_s.isoSpec.hom_inv_id
        have hIE_le : I_E ≤ M_q := by
          rw [hVanLeIff E_star hE_closed p_q, hinv_pq]
          exact hq_Δ.1
        have hIY_le : I_Y' ≤ M_q := by
          rw [hVanLeIff Y'_s_set hY'_closed p_q, hinv_pq]
          exact hq_Δ.2
        obtain ⟨E'_q, hE'_q_rem, hq_E'⟩ := Set.mem_iUnion₂.mp hq_Δ.2
        have hE'_q_comp : E'_q ∈ irreducibleComponents ↥X_s := hE'_q_rem.1
        have hE'_q_ne : E'_q ≠ E_star := hE'_q_rem.2
        let P'_q : Ideal R₁ :=
          PrimeSpectrum.vanishingIdeal
            (hAffV₁_s.isoSpec.hom.base '' {x : ↥V₁_s.toScheme | x.1 ∈ E'_q})
        have hP'_prime : P'_q.IsPrime :=
          PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp
            (hIrredSlice E'_q hE'_q_comp.1 ⟨q, hq_E', hq_V₁⟩)
        have hE'_q_closed : IsClosed E'_q := isClosed_of_mem_irreducibleComponents E'_q hE'_q_comp
        have hP'_le : P'_q ≤ M_q := by
          rw [hVanLeIff E'_q hE'_q_closed p_q, hinv_pq]
          exact hq_E'
        have hNotIE_P' : ¬ (I_E ≤ P'_q) := by
          intro hle
          have hSubOpen : E'_q ∩ (V₁_s : Set ↥X_s) ⊆ E_star := by
            rintro x ⟨hxE', hxV₁⟩
            let px := hAffV₁_s.isoSpec.hom.base ⟨x, hxV₁⟩
            have hinv_px : hAffV₁_s.isoSpec.inv.base px = ⟨x, hxV₁⟩ :=
              congrArg (fun f => f.base ⟨x, hxV₁⟩) hAffV₁_s.isoSpec.hom_inv_id
            have hpxP : P'_q ≤ px.asIdeal := by
              rw [hVanLeIff E'_q hE'_q_closed px, hinv_px]; exact hxE'
            have hpxE : (hAffV₁_s.isoSpec.inv.base px).1 ∈ E_star :=
              (hVanLeIff E_star hE_closed px).mp (hle.trans hpxP)
            rw [hinv_px] at hpxE
            exact hpxE
          have hUnion : E'_q ⊆ E_star ∪ (V₁_s : Set ↥X_s)ᶜ := by
            intro x hxE'
            by_cases hxV₁ : x ∈ (V₁_s : Set ↥X_s)
            · exact Or.inl (hSubOpen ⟨hxE', hxV₁⟩)
            · exact Or.inr hxV₁
          rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hE'_q_comp.1.2)
              E_star (V₁_s : Set ↥X_s)ᶜ hE_closed V₁_s.2.isClosed_compl hUnion with
            hSubE | hSubCompl
          · exact hE'_q_ne (Set.Subset.antisymm hSubE (hE'_q_comp.2 hE_comp.1 hSubE))
          · exact hSubCompl hq_E' hq_V₁
        obtain ⟨D, n₀, α₁, α₂, hEt₁, hEt₂, hcomap, hX, hcomm⟩ :=
          hNodalAt E_star E'_q hE_comp hE'_q_comp hE'_q_ne.symm
            V₁_s hAffV₁_s q hq_V₁ hq_Δ.1 hq_E'
        exact weil_sup1_etale_nodal_roof_branch_transversality_and_smooth
          K' R₁ ιK_V₁ hFT_R₁ I_E I_Y' hRadY hInfBot hNotSubY
          M_q hIE_le hIY_le ⟨P'_q, hP'_prime, hP'_le, hNotIE_P'⟩
          ↑D n₀ α₁ α₂ hEt₁ hEt₂ hcomap hX hcomm
      have hMemSupOfDelta : ∀ m : R₁,
          (∀ (q : ↥X_s) (hq_Δ : q ∈ Δ_s),
            m ∈ (hAffV₁_s.isoSpec.hom.base ⟨q, hΔ_sub_V₁ hq_Δ⟩).asIdeal) →
          m ∈ I_E ⊔ I_Y' := by
        intro m hm_all
        refine Ideal.mem_of_localization_maximal fun P hP_max => ?_
        have : P.IsMaximal := hP_max
        let p_P : PrimeSpectrum R₁ := ⟨P, hP_max.isPrime⟩
        let x_P : ↥V₁_s.toScheme := hAffV₁_s.isoSpec.inv.base p_P
        have hExistLoc : ∃ s_el : R₁, s_el ∉ P ∧ s_el * m ∈ I_E ⊔ I_Y' := by
          by_cases hx_Δ : x_P.1 ∈ Δ_s
          · have hhom_x : hAffV₁_s.isoSpec.hom.base ⟨x_P.1, hΔ_sub_V₁ hx_Δ⟩ = p_P :=
              congrArg (fun f => f.base p_P) hAffV₁_s.isoSpec.inv_hom_id
            have hP_eq : (hAffV₁_s.isoSpec.hom.base ⟨x_P.1, hΔ_sub_V₁ hx_Δ⟩).asIdeal = P :=
              congrArg PrimeSpectrum.asIdeal hhom_x
            obtain ⟨_, hTrans, _⟩ := hNodePkg x_P.1 hx_Δ
            obtain ⟨s_el, hs_not, hsm⟩ := hTrans m (hm_all x_P.1 hx_Δ)
            rw [hP_eq] at hs_not
            exact ⟨s_el, hs_not, hsm⟩
          · have hNotLe : ¬ (I_E ⊔ I_Y' ≤ P) := by
              intro hle
              have hxE : x_P.1 ∈ E_star :=
                (hVanLeIff E_star hE_closed p_P).mp (le_sup_left.trans hle)
              have hxY : x_P.1 ∈ Y'_s_set :=
                (hVanLeIff Y'_s_set hY'_closed p_P).mp (le_sup_right.trans hle)
              exact hx_Δ ⟨hxE, hxY⟩
            obtain ⟨s_el, hs_mem, hs_not⟩ := SetLike.not_le_iff_exists.mp hNotLe
            exact ⟨s_el, hs_not, Ideal.mul_mem_right m _ hs_mem⟩
        obtain ⟨s_el, hs_not, hsm⟩ := hExistLoc
        let s_sub : P.primeCompl := ⟨s_el, Ideal.mem_primeCompl_iff.mpr hs_not⟩
        have heq_loc : algebraMap R₁ (Localization.AtPrime P) m =
            IsLocalization.mk' (Localization.AtPrime P) 1 s_sub *
              algebraMap R₁ (Localization.AtPrime P) (s_el * m) := by
          rw [mul_comm, ← IsLocalization.mk'_eq_mul_mk'_one]
          exact (IsLocalization.mk'_mul_cancel_left
            (M := P.primeCompl) (S := Localization.AtPrime P) m s_sub).symm
        rw [heq_loc]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hsm)
      let A'_1 := R₁ ⧸ I_Y'
      let mkY' : R₁ →+* A'_1 := Ideal.Quotient.mk I_Y'
      let Φ' : W₀_ring →+* A'_1 := mkY'.comp res_V₁
      have hΦ'_inj : Function.Injective Φ' := by
        rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
        intro f hf
        have hres_mem : res_V₁ f ∈ I_Y' :=
          Ideal.Quotient.eq_zero_iff_mem.mp hf
        have hBasic_bot : X_s.basicOpen f = ⊥ := by
          ext x
          simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
          intro hx_bf
          have hx_W₀ : x ∈ (W₀_s : Set ↥X_s) := X_s.basicOpen_le f hx_bf
          have hq₀_not_bf : q₀_wit ∉ (X_s.basicOpen f : Set ↥X_s) := by
            intro hq₀_bf
            have hq₀_res : q₀_wit ∈ (X_s.basicOpen (res_V₁ f) : Set ↥X_s) := by
              rw [X_s.basicOpen_res f (CategoryTheory.homOfLE hV₁_le_W₀).op]
              exact ⟨hΔ_sub_V₁ hq₀_Δ, hq₀_bf⟩
            have hnot_ideal : res_V₁ f ∉
                (hAffV₁_s.isoSpec.hom.base ⟨q₀_wit, hΔ_sub_V₁ hq₀_Δ⟩).asIdeal :=
              (hBasicV₁Iff ⟨q₀_wit, hΔ_sub_V₁ hq₀_Δ⟩ (res_V₁ f)).mp hq₀_res
            have h_in_ideal : res_V₁ f ∈
                (hAffV₁_s.isoSpec.hom.base ⟨q₀_wit, hΔ_sub_V₁ hq₀_Δ⟩).asIdeal := by
              apply (hVanLeIff Y'_s_set hY'_closed
                (hAffV₁_s.isoSpec.hom.base ⟨q₀_wit, hΔ_sub_V₁ hq₀_Δ⟩)).mpr _ hres_mem
              have hinv : hAffV₁_s.isoSpec.inv.base
                  (hAffV₁_s.isoSpec.hom.base ⟨q₀_wit, hΔ_sub_V₁ hq₀_Δ⟩) =
                  ⟨q₀_wit, hΔ_sub_V₁ hq₀_Δ⟩ :=
                congrArg (fun g_hom => g_hom.base ⟨q₀_wit, hΔ_sub_V₁ hq₀_Δ⟩)
                  hAffV₁_s.isoSpec.hom_inv_id
              rw [hinv]
              exact hq₀_Δ.2
            exact hnot_ideal h_in_ideal
          have hev_f_zero : ev_E f = 0 := by
            by_contra hne
            exact hq₀_not_bf (hev_ne f hne hq₀_Δ.1)
          by_cases hx_E : x ∈ E_star
          · exact Set.disjoint_left.mp (hev_zero f hev_f_zero) hx_E hx_bf
          · have hx_cov : x ∈ E_star ∪ Y'_s_set := by rw [hCovX]; trivial
            have hx_Y' : x ∈ Y'_s_set := hx_cov.resolve_left hx_E
            have hx_V₁ : x ∈ V₁_s := hW₀_Y' ⟨hx_W₀, hx_Y'⟩
            have hx_res : x ∈ (X_s.basicOpen (res_V₁ f) : Set ↥X_s) := by
              rw [X_s.basicOpen_res f (CategoryTheory.homOfLE hV₁_le_W₀).op]
              exact ⟨hx_V₁, hx_bf⟩
            have hnot_ideal : res_V₁ f ∉ (hAffV₁_s.isoSpec.hom.base ⟨x, hx_V₁⟩).asIdeal :=
              (hBasicV₁Iff ⟨x, hx_V₁⟩ (res_V₁ f)).mp hx_res
            have h_in_ideal : res_V₁ f ∈ (hAffV₁_s.isoSpec.hom.base ⟨x, hx_V₁⟩).asIdeal := by
              apply (hVanLeIff Y'_s_set hY'_closed
                (hAffV₁_s.isoSpec.hom.base ⟨x, hx_V₁⟩)).mpr _ hres_mem
              have hinv : hAffV₁_s.isoSpec.inv.base
                  (hAffV₁_s.isoSpec.hom.base ⟨x, hx_V₁⟩) = ⟨x, hx_V₁⟩ :=
                congrArg (fun g_hom => g_hom.base ⟨x, hx_V₁⟩) hAffV₁_s.isoSpec.hom_inv_id
              rw [hinv]
              exact hx_Y'
            exact hnot_ideal h_in_ideal
        exact (AlgebraicGeometry.basicOpen_eq_bot_iff f).mp hBasic_bot
      have hRes_zero_mem_IE : ∀ f₀ : W₀_ring, ev_E f₀ = 0 → res_V₁ f₀ ∈ I_E := by
        intro f₀ hf₀
        have hdisj := hev_zero f₀ hf₀
        rw [PrimeSpectrum.mem_vanishingIdeal]
        rintro p ⟨z, hzE, rfl⟩
        by_contra hnot_mem
        have hz_res : z.1 ∈ (X_s.basicOpen (res_V₁ f₀) : Set ↥X_s) :=
          (hBasicV₁Iff z (res_V₁ f₀)).mpr hnot_mem
        rw [X_s.basicOpen_res f₀ (CategoryTheory.homOfLE hV₁_le_W₀).op] at hz_res
        exact Set.disjoint_left.mp hdisj hzE hz_res.2
      have hEv_compat : ∀ (q : ↥X_s) (hq_Δ : q ∈ Δ_s) (ev_q : A'_1 →+* K'),
          ev_q.comp (mkY'.comp ιK_V₁) = RingHom.id K' →
          RingHom.ker (ev_q.comp mkY') =
            (hAffV₁_s.isoSpec.hom.base ⟨q, hΔ_sub_V₁ hq_Δ⟩).asIdeal →
          ∀ f : W₀_ring, ev_q (Φ' f) = ev_E f := by
        intro q hq_Δ ev_q hevq_id hevq_ker f
        let c := ev_E f
        let f₀ := f - ιK_W₀ c
        have hf₀_zero : ev_E f₀ = 0 := by
          dsimp only [f₀, c]
          rw [map_sub, hev_id_app (ev_E f), sub_self]
        have hres_IE : res_V₁ f₀ ∈ I_E := hRes_zero_mem_IE f₀ hf₀_zero
        have hIE_Mq : I_E ≤ (hAffV₁_s.isoSpec.hom.base ⟨q, hΔ_sub_V₁ hq_Δ⟩).asIdeal := by
          rw [hVanLeIff E_star hE_closed (hAffV₁_s.isoSpec.hom.base ⟨q, hΔ_sub_V₁ hq_Δ⟩)]
          have hinv : hAffV₁_s.isoSpec.inv.base
              (hAffV₁_s.isoSpec.hom.base ⟨q, hΔ_sub_V₁ hq_Δ⟩) = ⟨q, hΔ_sub_V₁ hq_Δ⟩ :=
            congrArg (fun g_hom => g_hom.base ⟨q, hΔ_sub_V₁ hq_Δ⟩) hAffV₁_s.isoSpec.hom_inv_id
          rw [hinv]
          exact hq_Δ.1
        have hf₀_ker : res_V₁ f₀ ∈ RingHom.ker (ev_q.comp mkY') := by
          rw [hevq_ker]
          exact hIE_Mq hres_IE
        have hevq_f₀ : ev_q (Φ' f₀) = 0 := hf₀_ker
        have hf_decomp : f = ιK_W₀ c + f₀ := by simp [f₀]
