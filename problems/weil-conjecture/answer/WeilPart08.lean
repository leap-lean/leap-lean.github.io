    let A_i := TensorProduct ↥V ↑R_i K'
    let Ψ_i : V_is.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of A_i) :=
      hPb_spec.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso ↥V ↑R_i K'
    by_cases hNe : Nonempty ↥V_iE.toScheme
    · haveI : Nonempty ↥V_iE.toScheme := hNe
      obtain ⟨v₀⟩ := hNe
      have : AlgebraicGeometry.IsIntegral V_iE.toScheme :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion V_iE.ι
      let B_iE := ↑(E_sch.presheaf.obj (Opposite.op V_iE))
      have : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of B_iE)) :=
        ⟨hAff_iE.isoSpec.hom.base v₀⟩
      have : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of B_iE)) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion hAff_iE.isoSpec.inv
      have : IsDomain B_iE :=
        (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of B_iE)).mp inferInstance
      have hIrredE : IrreducibleSpace ↥E_sch :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral E_sch
      have : PreirreducibleSpace ↥E_sch := hIrredE.toPreirreducibleSpace
      have hDense : Dense (V_iE : Set ↥E_sch) := V_iE.isOpen.dense ⟨v₀.1, v₀.2⟩
      have hNotSub : ¬ ((V_iE : Set ↥E_sch) ⊆ F_E) := by
        intro hsub
        apply hFE_ne
        rw [← Set.univ_subset_iff, ← hDense.closure_eq]
        exact closure_minimal hsub hFE_cl
      let Z_i : Set (PrimeSpectrum B_iE) :=
        hAff_iE.isoSpec.inv.base ⁻¹' (V_iE.ι.base ⁻¹' F_E)
      have hZi_closed : IsClosed Z_i :=
        (hFE_cl.preimage V_iE.ι.continuous).preimage hAff_iE.isoSpec.inv.continuous
      have hZi_ne : Z_i ≠ Set.univ := by
        intro huniv
        apply hNotSub
        intro x hx
        let q : PrimeSpectrum B_iE := hAff_iE.isoSpec.hom.base ⟨x, hx⟩
        have hq_mem : q ∈ Z_i := by rw [huniv]; trivial
        have hinv_hom : hAff_iE.isoSpec.inv.base q = ⟨x, hx⟩ :=
          congrArg (fun f : V_iE.toScheme ⟶ V_iE.toScheme => f.base ⟨x, hx⟩)
            hAff_iE.isoSpec.hom_inv_id
        have hq_mem' : V_iE.ι.base (hAff_iE.isoSpec.inv.base q) ∈ F_E := hq_mem
        rw [hinv_hom] at hq_mem'
        exact hq_mem'
      obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z_i).mp hZi_closed
      have hI_ne_bot : I ≠ ⊥ := by
        intro hbot
        apply hZi_ne
        ext p
        rw [hI, hbot]
        simp
      obtain ⟨a_i, ha_mem, ha_ne⟩ := (Submodule.ne_bot_iff I).mp hI_ne_bot
      have hZi_sub : Z_i ⊆ PrimeSpectrum.zeroLocus (Ideal.span ({a_i} : Set B_iE) : Set B_iE) := by
        rw [hI]
        exact PrimeSpectrum.zeroLocus_anti_mono
          (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha_mem))
      have hΨ_appTop_surj : Function.Surjective Ψ_i.hom.appTop.hom := by
        intro y
        refine ⟨Ψ_i.inv.appTop.hom y, ?_⟩
        have h_id : Ψ_i.inv.appTop ≫ Ψ_i.hom.appTop = 𝟙 _ := by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, Ψ_i.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop]
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom h_id) y
      let e_Ai_hom : CommRingCat.of A_i ⟶ X_s.presheaf.obj (Opposite.op V_is) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_i)).inv ≫
          Ψ_i.hom.appTop ≫ V_is.topIso.hom
      have he_surj : Function.Surjective e_Ai_hom.hom := by
        dsimp only [e_Ai_hom]
        rw [CommRingCat.hom_comp, CommRingCat.hom_comp]
        exact V_is.topIso.commRingCatIsoToRingEquiv.surjective.comp
          (hΨ_appTop_surj.comp
            (AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of A_i)).symm.commRingCatIsoToRingEquiv.surjective)
      let q_E : A_i →+* B_iE := (ι_E.app V_is).hom.comp e_Ai_hom.hom
      have hqE_surj : Function.Surjective q_E :=
        (AlgebraicGeometry.Scheme.Hom.app_surjective ι_E V_is hAff_is).comp he_surj
      let φ_V : Polynomial ↥V →+* ↑R_i := (Polynomial.aeval (R := ↥V) u_i).toRingHom
      have hFin_mod : @Module.Finite (Polynomial ↥V) ↑R_i _ _ φ_V.toModule := hFin_u
      letI : Module (Polynomial ↥V) ↑R_i := φ_V.toModule
      obtain ⟨G, hG_span⟩ := @Module.Finite.fg_top (Polynomial ↥V) ↑R_i _ _ _ hFin_mod
      letI : Algebra K' A_i := Algebra.TensorProduct.includeRight.toRingHom.toAlgebra
      let u_A : A_i := u_i ⊗ₜ[↥V] (1 : K')
      let R_uA : Subalgebra K' A_i := (Polynomial.aeval (R := K') u_A).range
      have hmap_poly : ∀ P : Polynomial ↥V,
          (φ_V P) ⊗ₜ[↥V] (1 : K') =
            Polynomial.aeval (R := K') u_A (Polynomial.map φ_s P) := by
        intro P
        induction P using Polynomial.induction_on' with
        | add p q ihp ihq =>
          rw [map_add, TensorProduct.add_tmul, ihp, ihq, Polynomial.map_add, map_add]
        | monomial k_deg v =>
          change (Polynomial.aeval (R := ↥V) u_i (Polynomial.monomial k_deg v)) ⊗ₜ[↥V] (1 : K') =
            Polynomial.aeval (R := K') u_A (Polynomial.map φ_s (Polynomial.monomial k_deg v))
          rw [Polynomial.aeval_monomial, Polynomial.map_monomial, Polynomial.aeval_monomial,
            Algebra.algebraMap_eq_smul_one]
          have h1 : (v • (1 : ↑R_i) * u_i ^ k_deg) ⊗ₜ[↥V] (1 : K') =
              (v • u_i ^ k_deg) ⊗ₜ[↥V] (1 : K') := by
            rw [smul_mul_assoc, one_mul]
          rw [h1, TensorProduct.smul_tmul]
          change (u_i ^ k_deg) ⊗ₜ[↥V] (v • (1 : K')) =
            algebraMap K' A_i (φ_s v) * u_A ^ k_deg
          have hv : v • (1 : K') = φ_s v := by
            change algebraMap ↥V K' v * 1 = φ_s v
            exact mul_one _
          rw [hv]
          have hpow : ∀ k : ℕ, u_A ^ k = (u_i ^ k) ⊗ₜ[↥V] (1 : K') := by
            intro k
            induction k with
            | zero => simp [u_A]; rfl
            | succ k ih =>
              rw [pow_succ, ih]
              change ((u_i ^ k) ⊗ₜ[↥V] (1 : K')) * (u_i ⊗ₜ[↥V] (1 : K')) = _
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, pow_succ]
          rw [hpow k_deg]
          change (u_i ^ k_deg) ⊗ₜ[↥V] φ_s v =
            ((1 : ↑R_i) ⊗ₜ[↥V] φ_s v) * ((u_i ^ k_deg) ⊗ₜ[↥V] (1 : K'))
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      let S_genA : Finset A_i := G.image (fun w : ↑R_i => w ⊗ₜ[↥V] (1 : K'))
      have hSpan_RuA : Submodule.span ↥R_uA (S_genA : Set A_i) = ⊤ := by
        suffices hall : ∀ z : A_i, z ∈ Submodule.span ↥R_uA (S_genA : Set A_i) by
          rw [eq_top_iff]
          intro z _
          exact hall z
        intro z
        induction z using TensorProduct.induction_on with
        | zero => exact Submodule.zero_mem _
        | tmul r c =>
          have hr_top : r ∈ (⊤ : Submodule (Polynomial ↥V) ↑R_i) := trivial
          rw [← hG_span, Submodule.mem_span_finset] at hr_top
          obtain ⟨f_p, -, hr_eq⟩ := hr_top
          rw [← hr_eq, TensorProduct.sum_tmul]
          refine Submodule.sum_mem _ fun w hw => ?_
          have hterm : (f_p w • w) ⊗ₜ[↥V] c =
              (Polynomial.aeval (R := K') u_A
                (Polynomial.C c * Polynomial.map φ_s (f_p w))) * (w ⊗ₜ[↥V] (1 : K')) := by
            change (φ_V (f_p w) * w) ⊗ₜ[↥V] c = _
            have hsplit : (φ_V (f_p w) * w) ⊗ₜ[↥V] c =
                ((1 : ↑R_i) ⊗ₜ[↥V] c) * ((φ_V (f_p w)) ⊗ₜ[↥V] (1 : K')) * (w ⊗ₜ[↥V] (1 : K')) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul]
              simp
            rw [hsplit, hmap_poly, map_mul, Polynomial.aeval_C]
            rfl
          let coeff_u : ↥R_uA := ⟨Polynomial.aeval (R := K') u_A
            (Polynomial.C c * Polynomial.map φ_s (f_p w)), ⟨_, rfl⟩⟩
          rw [hterm]
          exact Submodule.smul_mem _ coeff_u
            (Submodule.subset_span (Finset.mem_image_of_mem _ hw))
        | add x y ihx ihy => exact Submodule.add_mem _ ihx ihy
      letI : Algebra K' B_iE := (q_E.comp Algebra.TensorProduct.includeRight.toRingHom).toAlgebra
      let q_alg : A_i →ₐ[K'] B_iE := { toRingHom := q_E, commutes' := fun _ => rfl }
      let u_E : B_iE := q_alg u_A
      let R_uE : Subalgebra K' B_iE := (Polynomial.aeval (R := K') u_E).range
      let S_genE : Finset B_iE := G.image (fun w : ↑R_i => q_alg (w ⊗ₜ[↥V] (1 : K')))
      have hSpan_RuE : Submodule.span ↥R_uE (S_genE : Set B_iE) = ⊤ := by
        rw [eq_top_iff]
        intro b _
        obtain ⟨z, rfl⟩ := hqE_surj b
        have hz_top : z ∈ (⊤ : Submodule ↥R_uA A_i) := trivial
        rw [← hSpan_RuA, Submodule.mem_span_finset] at hz_top
        obtain ⟨c_u, -, hz_eq⟩ := hz_top
        change q_alg z ∈ Submodule.span ↥R_uE (S_genE : Set B_iE)
        rw [← hz_eq, map_sum]
        refine Submodule.sum_mem _ fun s_el hs_el => ?_
        obtain ⟨w, hwG, rfl⟩ := Finset.mem_image.mp hs_el
        obtain ⟨g_p, hg_eq⟩ := (c_u (w ⊗ₜ[↥V] (1 : K'))).2
        change Polynomial.aeval (R := K') u_A g_p = (c_u (w ⊗ₜ[↥V] (1 : K')) : A_i) at hg_eq
        change q_alg ((c_u (w ⊗ₜ[↥V] (1 : K')) : A_i) * (w ⊗ₜ[↥V] (1 : K'))) ∈
          Submodule.span ↥R_uE (S_genE : Set B_iE)
        rw [← hg_eq, map_mul, ← Polynomial.aeval_algHom_apply q_alg u_A g_p]
        let coeff_E : ↥R_uE := ⟨Polynomial.aeval (R := K') u_E g_p, ⟨g_p, rfl⟩⟩
        exact Submodule.smul_mem _ coeff_E
          (Submodule.subset_span (Finset.mem_image_of_mem _ hwG))
      have : Module.Finite ↥R_uE B_iE := ⟨⟨S_genE, hSpan_RuE⟩⟩
      have : Algebra.IsIntegral ↥R_uE B_iE := Algebra.IsIntegral.of_finite ↥R_uE B_iE
      obtain ⟨P_ai, hP_monic, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := ↥R_uE) a_i
      have hP_ne : P_ai ≠ 0 := hP_monic.ne_zero
      have hDesc : ∀ (d : ℕ) (P : Polynomial ↥R_uE),
          P.natDegree = d → P ≠ 0 → Polynomial.aeval a_i P = 0 →
          ∃ r₀ : ↥R_uE, r₀ ≠ 0 ∧ (r₀ : B_iE) ∈ Ideal.span ({a_i} : Set B_iE) := by
        intro d
        induction d using Nat.strong_induction_on with
        | h d ih =>
          intro P hdeg hne heval
          by_cases h0 : P.coeff 0 = 0
          · obtain ⟨Q, hPQ⟩ := Polynomial.X_dvd_iff.mpr h0
            have hQ_ne : Q ≠ 0 := by
              intro hQ0
              rw [hQ0, mul_zero] at hPQ
              exact hne hPQ
            have hdegQ : Q.natDegree < d := by
              rw [← hdeg, hPQ, Polynomial.natDegree_X_mul hQ_ne]
              omega
            have hevalQ : Polynomial.aeval a_i Q = 0 := by
              rw [hPQ, map_mul, Polynomial.aeval_X] at heval
              exact (mul_eq_zero.mp heval).resolve_left ha_ne
            exact ih Q.natDegree hdegQ Q rfl hQ_ne hevalQ
          · refine ⟨P.coeff 0, h0, ?_⟩
            have hc0 : (P - Polynomial.C (P.coeff 0)).coeff 0 = 0 := by simp
            obtain ⟨Q, hQ⟩ := Polynomial.X_dvd_iff.mpr hc0
            have hev_sub : Polynomial.aeval a_i (P - Polynomial.C (P.coeff 0)) =
                -(P.coeff 0 : B_iE) := by
              have hsub := map_sub (Polynomial.aeval a_i) P (Polynomial.C (P.coeff 0))
              rw [hsub, heval, zero_sub, Polynomial.aeval_C]
              rfl
            rw [hQ, map_mul, Polynomial.aeval_X] at hev_sub
            rw [Ideal.mem_span_singleton]
            exact ⟨-Polynomial.aeval a_i Q, by rw [mul_neg, hev_sub, neg_neg]⟩
      obtain ⟨r₀, hr₀_ne, hr₀_mem⟩ := hDesc P_ai.natDegree P_ai rfl hP_ne hP_eval
      obtain ⟨f₀, hf₀_eq⟩ := r₀.2
      change Polynomial.aeval (R := K') u_E f₀ = (r₀ : B_iE) at hf₀_eq
      have hf₀_ne : f₀ ≠ 0 := by
        intro h0
        apply hr₀_ne
        apply Subtype.ext
        rw [← hf₀_eq, h0, map_zero]
        rfl
      let f_mon : Polynomial K' := Polynomial.C (f₀.leadingCoeff)⁻¹ * f₀
      have hf_monic : f_mon.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
          inv_mul_cancel₀ (Polynomial.leadingCoeff_ne_zero.mpr hf₀_ne)]
      have hf_mem : Polynomial.aeval (R := K') u_E f_mon ∈ Ideal.span ({a_i} : Set B_iE) := by
        dsimp only [f_mon]
        rw [map_mul, Polynomial.aeval_C, hf₀_eq]
        exact Ideal.mul_mem_left _ _ hr₀_mem
      let J_i : Ideal B_iE := Ideal.span ({a_i} : Set B_iE)
      let M_i := B_iE ⧸ J_i
      let π_M : B_iE →+* M_i := Ideal.Quotient.mk J_i
      let π_alg : B_iE →ₐ[K'] M_i := Ideal.Quotient.mkₐ K' J_i
      let d_m := f_mon.natDegree
      let B_M : Finset M_i :=
        (Finset.range d_m).biUnion
          (fun j => G.image (fun w => π_M (u_E ^ j * q_alg (w ⊗ₜ[↥V] (1 : K')))))
      have hSpan_K' : Submodule.span K' (B_M : Set M_i) = ⊤ := by
        rw [eq_top_iff]
        intro m_el _
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective m_el
        have hz_mem : z ∈ (⊤ : Submodule ↥R_uE B_iE) := trivial
        rw [← hSpan_RuE, Submodule.mem_span_finset] at hz_mem
        obtain ⟨c_u, -, hz_eq⟩ := hz_mem
        change π_alg z ∈ Submodule.span K' (B_M : Set M_i)
        rw [← hz_eq, map_sum]
        refine Submodule.sum_mem _ fun s_el hs_el => ?_
        obtain ⟨w, hwG, rfl⟩ := Finset.mem_image.mp hs_el
        obtain ⟨g_p, hg_eq⟩ := (c_u (q_alg (w ⊗ₜ[↥V] (1 : K')))).2
        change Polynomial.aeval (R := K') u_E g_p =
          (c_u (q_alg (w ⊗ₜ[↥V] (1 : K'))) : B_iE) at hg_eq
        change π_alg ((c_u (q_alg (w ⊗ₜ[↥V] (1 : K'))) : B_iE) *
          q_alg (w ⊗ₜ[↥V] (1 : K'))) ∈ Submodule.span K' (B_M : Set M_i)
        rw [← hg_eq]
        let rem_p := g_p %ₘ f_mon
        let div_p := g_p /ₘ f_mon
        have hdiv_eq : g_p = rem_p + f_mon * div_p := (Polynomial.modByMonic_add_div g_p f_mon).symm
        have haeval_zero : π_alg (Polynomial.aeval (R := K') u_E f_mon) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hf_mem
        have hrem_eq : π_alg (Polynomial.aeval (R := K') u_E g_p * q_alg (w ⊗ₜ[↥V] (1 : K'))) =
            π_alg (Polynomial.aeval (R := K') u_E rem_p * q_alg (w ⊗ₜ[↥V] (1 : K'))) := by
          have h1 : Polynomial.aeval (R := K') u_E g_p =
              Polynomial.aeval (R := K') u_E rem_p +
                Polynomial.aeval (R := K') u_E f_mon * Polynomial.aeval (R := K') u_E div_p := by
            rw [hdiv_eq, map_add, map_mul]
          simp only [h1, add_mul, map_add, map_mul, haeval_zero, zero_mul, add_zero]
        rw [hrem_eq]
        by_cases hrem0 : rem_p = 0
        · rw [hrem0, map_zero, zero_mul, map_zero]
          exact Submodule.zero_mem _
        · have hdeg_lt : rem_p.degree < f_mon.degree :=
            Polynomial.degree_modByMonic_lt g_p hf_monic
          rw [Polynomial.degree_eq_natDegree hrem0,
            Polynomial.degree_eq_natDegree hf_monic.ne_zero] at hdeg_lt
          have hnat_lt : rem_p.natDegree < d_m := WithBot.coe_lt_coe.mp hdeg_lt
          rw [Polynomial.as_sum_range' rem_p d_m hnat_lt, map_sum, Finset.sum_mul, map_sum]
          refine Submodule.sum_mem _ fun j hj => ?_
          rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, smul_mul_assoc,
            one_mul, smul_mul_assoc, map_smul]
          exact Submodule.smul_mem _ (rem_p.coeff j) (Submodule.subset_span
            (Finset.mem_biUnion.mpr ⟨j, hj, Finset.mem_image_of_mem _ hwG⟩))
      have : Module.Finite K' M_i := ⟨⟨B_M, hSpan_K'⟩⟩
      have : IsArtinian K' M_i := isArtinian_of_fg_of_artinian'
      have : IsArtinianRing M_i := isArtinian_of_tower K' inferInstance
      have : Finite (PrimeSpectrum M_i) := inferInstance
      have hRange : Set.range (PrimeSpectrum.comap π_M) =
          PrimeSpectrum.zeroLocus (J_i : Set B_iE) := by
        rw [_root_.range_comap_of_surjective M_i π_M Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      have hZloc_fin : (PrimeSpectrum.zeroLocus (J_i : Set B_iE)).Finite := by
        rw [← hRange]
        exact Set.finite_range (PrimeSpectrum.comap π_M)
      have hZi_fin : Z_i.Finite := hZloc_fin.subset hZi_sub
      let f_back : PrimeSpectrum B_iE → ↥E_sch := fun p => V_iE.ι.base (hAff_iE.isoSpec.inv.base p)
      have hSub_img : F_E ∩ (V_iE : Set ↥E_sch) ⊆ f_back '' Z_i := by
        rintro x ⟨hxF, hxV⟩
        let p : PrimeSpectrum B_iE := hAff_iE.isoSpec.hom.base ⟨x, hxV⟩
        have hinv : hAff_iE.isoSpec.inv.base p = ⟨x, hxV⟩ :=
          congrArg (fun f : V_iE.toScheme ⟶ V_iE.toScheme => f.base ⟨x, hxV⟩)
            hAff_iE.isoSpec.hom_inv_id
        refine ⟨p, ?_, ?_⟩
        · change V_iE.ι.base (hAff_iE.isoSpec.inv.base p) ∈ F_E
          rw [hinv]
          exact hxF
        · dsimp only [f_back]
          rw [hinv]
          rfl
      exact (hZi_fin.image f_back).subset hSub_img
    · have hEmpty : F_E ∩ (V_iE : Set ↥E_sch) = ∅ := by
        ext x
        simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
        intro _ hxV
        exact hNe ⟨x, hxV⟩
      rw [hEmpty]
      exact Set.finite_empty

  have hFin_proper : ∀ E ∈ irreducibleComponents ↥X_s,
      ∀ F : Set ↥X_s, IsClosed F → F ⊆ E → F ≠ E → F.Finite := by
    intro E hE F hF_cl hF_sub hF_ne
    obtain ⟨E_sch, ι_E, hCl_E, hInt_E, hRange_E⟩ := helper_integral_subscheme X_s E hE
    let F_E : Set ↥E_sch := ι_E.base ⁻¹' F
    have hFE_cl : IsClosed F_E := hF_cl.preimage ι_E.continuous
    have hFE_ne : F_E ≠ Set.univ := by
      intro huniv
      apply hF_ne
      apply Set.Subset.antisymm hF_sub
      intro x hxE
      rw [← hRange_E] at hxE
      obtain ⟨z, rfl⟩ := hxE
      have hz : z ∈ F_E := by rw [huniv]; trivial
      exact hz
    have hFin₀ := helper_chart_comp_closed_finite V₀ hAffV₀ h₀ hFin_h₀
      E_sch ι_E hCl_E hInt_E F_E hFE_cl hFE_ne
    have hFin₁ := helper_chart_comp_closed_finite V₁ hAffV₁ t₀ hFin_t₀
      E_sch ι_E hCl_E hInt_E F_E hFE_cl hFE_ne
    have hFE_cov : F_E ⊆ (F_E ∩ ((ι_E ⁻¹ᵁ (fst_s ⁻¹ᵁ V₀) : E_sch.Opens) : Set ↥E_sch)) ∪
        (F_E ∩ ((ι_E ⁻¹ᵁ (fst_s ⁻¹ᵁ V₁) : E_sch.Opens) : Set ↥E_sch)) := by
      intro z hz
      have hc : fst_s.base (ι_E.base z) ∈ (V₀ ⊔ V₁ : C.Opens) := by
        rw [hCovV]
        trivial
      rcases hc with h₀_mem | h₁_mem
      · exact Or.inl ⟨hz, h₀_mem⟩
      · exact Or.inr ⟨hz, h₁_mem⟩
    have hFE_fin : F_E.Finite := (hFin₀.union hFin₁).subset hFE_cov
    have hF_img : F ⊆ ι_E.base '' F_E := by
      intro x hxF
      have hxE : x ∈ E := hF_sub hxF
      rw [← hRange_E] at hxE
      obtain ⟨z, rfl⟩ := hxE
      exact ⟨z, hxF, rfl⟩
    exact (hFE_fin.image ι_E.base).subset hF_img

  
  have hConn_Xs : ConnectedSpace ↥X_s := (hSemi.2.2.2 K' s).1
  have helper_crux_chart_isIso :
      ∀ (U : X_next_s.Opens),
        AlgebraicGeometry.IsAffineOpen U →
        Function.Bijective (q_s.app U).hom →
        (∀ E ∈ irreducibleComponents ↥X_s, ¬ (E ⊆ (q_s ⁻¹ᵁ U : Set ↥X_s))) →
        CategoryTheory.IsIso (q_s ∣_ U) := by
    intro U hAffU hBijU hNoComp
    let W : X_s.Opens := q_s ⁻¹ᵁ U
    let A := ↑(X_next_s.presheaf.obj (Opposite.op U))
    let B := ↑(X_s.presheaf.obj (Opposite.op W))
    let θ : A →+* B := (q_s.app U).hom
    obtain ⟨x₀⟩ := hConn_Xs.toNonempty
    obtain ⟨z_out, _hz_in_E₀, hz_out⟩ := Set.not_subset.mp
      (hNoComp (irreducibleComponent x₀) (irreducibleComponent_mem_irreducibleComponents x₀))
    have hAffTopK' : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K')).Opens) :=
      AlgebraicGeometry.isAffineOpen_top _
    have hFT_app : RingHom.FiniteType (snd_next_s.appLE ⊤ U (fun _ _ => trivial)).hom :=
      AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE snd_next_s hAffTopK' hAffU
        (fun _ _ => trivial)
    let α_Y : CommRingCat.of K' ⟶ X_next_s.presheaf.obj (Opposite.op U) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
        snd_next_s.appLE ⊤ U (fun _ _ => trivial)
    let c_Y : K' →+* A := α_Y.hom
    have hc_FT : c_Y.FiniteType :=
      hFT_app.comp (RingHom.FiniteType.of_surjective _
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of K')).symm.commRingCatIsoToRingEquiv.surjective)
    have hCommU : hAffU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map α_Y = U.ι ≫ snd_next_s := by
      rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
      exact helper_open_toSpecΓ_comm K' X_next_s snd_next_s U
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K'
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have hdeg0_K' : ∀ p : MvPolynomial (Fin (M + 1)) K',
        p ∈ 𝒜 0 → p = MvPolynomial.C (p.coeff 0) := by
      intro p hp_mem
      ext m_idx
      by_cases hm : m_idx = 0
      · subst hm; simp
      · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr (fun h => absurd h.symm hm)]
        by_contra hne
        have hp : p.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p).mp hp_mem
        have hdeg := hp hne
        simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
        have hne' : ∃ i : Fin (M + 1), m_idx i ≠ 0 := by
          by_contra hall
          exact hm (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
        rcases hne' with ⟨i, hi⟩
        exact hi ((Finset.sum_eq_zero_iff.mp hdeg) i (Finsupp.mem_support_iff.mpr hi))
    have hScalarK' : ∀ (p : ProjectiveSpectrum 𝒜) (c : K'),
        MvPolynomial.C c ∈ p.asHomogeneousIdeal.toIdeal ↔ c = 0 := by
      intro p c
      constructor
      · intro hmem
        by_contra hc
        have hmul : (MvPolynomial.C c : MvPolynomial (Fin (M + 1)) K') *
            MvPolynomial.C c⁻¹ = 1 := by
          rw [← map_mul, mul_inv_cancel₀ hc, map_one]
        have h1 : (1 : MvPolynomial (Fin (M + 1)) K') ∈ p.asHomogeneousIdeal.toIdeal := by
          rw [← hmul]
          exact p.asHomogeneousIdeal.toIdeal.mul_mem_right _ hmem
        exact p.isPrime.ne_top (p.asHomogeneousIdeal.toIdeal.eq_top_of_isUnit_mem h1 isUnit_one)
      · rintro rfl
        simp
    let ιP_proj : X_s ⟶ AlgebraicGeometry.Proj 𝒜 := ιP_s
    have : AlgebraicGeometry.IsClosedImmersion ιP_proj := hCl_ιPs
    have : AlgebraicGeometry.IsAffineHom ιP_proj := inferInstance
    let K_cl : Set ↥(AlgebraicGeometry.Proj 𝒜) := ιP_proj.base '' ((W : Set ↥X_s)ᶜ)
    have hKcl_cl : IsClosed K_cl := ιP_proj.isClosedMap _ W.isOpen.isClosed_compl
    let U_cl : (AlgebraicGeometry.Proj 𝒜).Opens := ⟨K_clᶜ, hKcl_cl.isOpen_compl⟩
    have hInj_ιP : Function.Injective ιP_proj.base := ιP_proj.isClosedEmbedding.injective
    have hUcl_pre : ιP_proj ⁻¹ᵁ U_cl = W := by
      ext x
      change ιP_proj.base x ∉ ιP_proj.base '' ((W : Set ↥X_s)ᶜ) ↔ x ∈ W
      constructor
      · intro hx
        by_contra hnw
        exact hx ⟨x, hnw, rfl⟩
      · rintro hx ⟨y, hy, hyx⟩
        rw [hInj_ιP hyx] at hy
        exact hy hx
    have hz_out_Ucl : ιP_proj.base z_out ∉ U_cl := fun h => h ⟨z_out, hz_out, rfl⟩
    have hEnclose : ∀ (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal),
        ∃ V_𝔪 : X_s.Opens,
          AlgebraicGeometry.IsAffineOpen V_𝔪 ∧
          V_𝔪 ≤ W ∧
          q_s.base ⁻¹' {U.ι.base (hAffU.isoSpec.inv.base ⟨𝔪, h𝔪.isPrime⟩)} ⊆ (V_𝔪 : Set ↥X_s) := by
      intro 𝔪 h𝔪_max
      let p_𝔪 : PrimeSpectrum A := ⟨𝔪, h𝔪_max.isPrime⟩
      let y_𝔪 : ↥U.toScheme := hAffU.isoSpec.inv.base p_𝔪
      let y₀ : ↥X_next_s := U.ι.base y_𝔪
      let F_𝔪 : Set ↥X_s := q_s.base ⁻¹' {y₀}
      letI : Field (A ⧸ 𝔪) := Ideal.Quotient.field 𝔪
      letI : Algebra K' A := c_Y.toAlgebra
      have : Algebra.FiniteType K' A := hc_FT
      obtain ⟨_n_v, Φ_mv, hΦ_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hc_FT
      let π_𝔪 : A →+* A ⧸ 𝔪 := Ideal.Quotient.mk 𝔪
      have hInt_quot : ((π_𝔪.comp Φ_mv.toRingHom).comp MvPolynomial.C).IsIntegral :=
        MvPolynomial.comp_C_integral_of_surjective_of_isJacobsonRing _
          (Ideal.Quotient.mk_surjective.comp hΦ_surj)
      have hcomp_eq : (π_𝔪.comp Φ_mv.toRingHom).comp MvPolynomial.C = π_𝔪.comp c_Y := by
        ext c
        change π_𝔪 (Φ_mv (MvPolynomial.C c)) = π_𝔪 (algebraMap K' A c)
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      rw [hcomp_eq] at hInt_quot
      have hBij_πc : Function.Bijective (π_𝔪.comp c_Y) :=
        IsAlgClosed.ringHom_bijective_of_isIntegral (π_𝔪.comp c_Y) hInt_quot
      let e_𝔪 : K' ≃+* (A ⧸ 𝔪) := RingEquiv.ofBijective (π_𝔪.comp c_Y) hBij_πc
      let ev_𝔪 : A →+* K' := e_𝔪.symm.toRingHom.comp π_𝔪
      let σ_𝔪 : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ X_next_s :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_𝔪) ≫ hAffU.isoSpec.inv ≫ U.ι
      have hσ_snd : σ_𝔪 ≫ snd_next_s = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K')) := by
        dsimp only [σ_𝔪]
        rw [Category.assoc, Category.assoc, ← hCommU, Iso.inv_hom_id_assoc]
        have hα : α_Y = CommRingCat.ofHom c_Y := (CommRingCat.ofHom_hom α_Y).symm
        rw [hα, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hid : ev_𝔪.comp c_Y = RingHom.id K' := by
          ext c
          exact e_𝔪.symm_apply_apply c
        rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      have : AlgebraicGeometry.IsProper σ_𝔪 := by
        have : AlgebraicGeometry.IsProper (σ_𝔪 ≫ snd_next_s) := by
          rw [hσ_snd]
          infer_instance
        exact AlgebraicGeometry.IsProper.of_comp σ_𝔪 snd_next_s
      have hRange_σ : Set.range σ_𝔪.base = {y₀} := by
        have hbot_prime : (⊥ : Ideal K').IsPrime :=
          ⟨bot_ne_top, fun {a b} hab => by
            rw [Ideal.mem_bot] at hab ⊢
            simpa only [Ideal.mem_bot] using mul_eq_zero.mp hab⟩
        let pt₀ : PrimeSpectrum K' := ⟨⊥, hbot_prime⟩
        have hpt_uniq : ∀ pt : PrimeSpectrum K', pt = pt₀ := by
          intro pt
          apply PrimeSpectrum.ext
          rw [Submodule.eq_bot_iff]
          intro c hc
          by_contra hc_ne
          have h1 : (1 : K') ∈ pt.asIdeal := by
            rw [← mul_inv_cancel₀ hc_ne]
            exact pt.asIdeal.mul_mem_right c⁻¹ hc
          exact pt.isPrime.ne_top (pt.asIdeal.eq_top_of_isUnit_mem h1 isUnit_one)
        have h_ev_pt₀ : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_𝔪)).base pt₀ = p_𝔪 := by
          apply PrimeSpectrum.ext
          ext a
          change ev_𝔪 a ∈ (⊥ : Ideal K') ↔ a ∈ 𝔪
          rw [Ideal.mem_bot]
          change e_𝔪.symm (π_𝔪 a) = 0 ↔ a ∈ 𝔪
          rw [map_eq_zero_iff e_𝔪.symm e_𝔪.symm.injective]
          exact Ideal.Quotient.eq_zero_iff_mem
        ext y
        simp only [Set.mem_range, Set.mem_singleton_iff]
        constructor
        · rintro ⟨pt, rfl⟩
          rw [hpt_uniq pt]
          change U.ι.base (hAffU.isoSpec.inv.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_𝔪)).base pt₀)) = y₀
          rw [h_ev_pt₀]
        · rintro rfl
          refine ⟨pt₀, ?_⟩
          change U.ι.base (hAffU.isoSpec.inv.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_𝔪)).base pt₀)) = y₀
          rw [h_ev_pt₀]
      have hCl_y₀ : IsClosed ({y₀} : Set ↥X_next_s) := by
        rw [← hRange_σ]
        exact σ_𝔪.isClosedMap.isClosed_range
      have hF_cl : IsClosed F_𝔪 := hCl_y₀.preimage q_s.continuous
      have hF_sub_W : F_𝔪 ⊆ (W : Set ↥X_s) := by
        intro x hx
        change q_s.base x ∈ U
        have hqx : q_s.base x = y₀ := hx
        rw [hqx]
        exact y_𝔪.2
      have hF_inter_fin : ∀ E ∈ irreducibleComponents ↥X_s, (F_𝔪 ∩ E).Finite := by
        intro E hE
        refine hFin_proper E hE (F_𝔪 ∩ E)
          (hF_cl.inter (isClosed_of_mem_irreducibleComponents E hE)) Set.inter_subset_right ?_
        intro hEq
        apply hNoComp E hE
        intro x hxE
        have hxF : x ∈ F_𝔪 ∩ E := by rw [hEq]; exact hxE
        exact hF_sub_W hxF.1
      have hF_cov : F_𝔪 ⊆ ⋃ E ∈ irreducibleComponents ↥X_s, (F_𝔪 ∩ E) := by
        intro x hx
        exact Set.mem_biUnion (irreducibleComponent_mem_irreducibleComponents x)
          ⟨hx, mem_irreducibleComponent⟩
      have hF_fin : F_𝔪.Finite := (hFin_irred.biUnion hF_inter_fin).subset hF_cov
      letI : Fintype ↥F_𝔪 := hF_fin.fintype
      let k_pts : ℕ := Fintype.card ↥F_𝔪
      let e_fin : Fin k_pts ≃ ↥F_𝔪 := (Fintype.equivFin ↥F_𝔪).symm
      let x_pt : Fin k_pts → ↥X_s := fun i => (e_fin i).1
      have hx_in_W : ∀ i : Fin k_pts, x_pt i ∈ W := fun i => hF_sub_W (e_fin i).2
      have hBasis_i : ∀ i : Fin k_pts,
          ∃ (d : ℕ) (f : MvPolynomial (Fin (M + 1)) K'),
            0 < d ∧ f ∈ 𝒜 d ∧
            ιP_proj.base (x_pt i) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 f ∧
            AlgebraicGeometry.Proj.basicOpen 𝒜 f ≤ U_cl := by
        intro i
        have hp_in_Ucl : ιP_proj.base (x_pt i) ∈ U_cl := by
          have hxW : x_pt i ∈ ιP_proj ⁻¹ᵁ U_cl := by rw [hUcl_pre]; exact hx_in_W i
          exact hxW
        obtain ⟨_, ⟨_, ⟨g_raw, rfl⟩, rfl⟩, hp_g, hg_le⟩ :=
          (AlgebraicGeometry.Proj.isBasis_basicOpen 𝒜).exists_subset_of_mem_open
            hp_in_Ucl U_cl.isOpen
        have hp_sup : ιP_proj.base (x_pt i) ∈
            ⨆ d : ℕ, AlgebraicGeometry.Proj.basicOpen 𝒜 (GradedRing.proj 𝒜 d g_raw) := by
          rw [← AlgebraicGeometry.Proj.basicOpen_eq_iSup_proj 𝒜 g_raw]
          exact hp_g
        obtain ⟨d, hp_d⟩ := TopologicalSpace.Opens.mem_iSup.mp hp_sup
        let f := (GradedRing.proj 𝒜 d g_raw : MvPolynomial (Fin (M + 1)) K')
        have hf_mem : f ∈ 𝒜 d := (DirectSum.decompose 𝒜 g_raw d).2
        have hf_le : AlgebraicGeometry.Proj.basicOpen 𝒜 f ≤ U_cl := by
          refine le_trans ?_ hg_le
          rw [AlgebraicGeometry.Proj.basicOpen_eq_iSup_proj 𝒜 g_raw]
          exact le_iSup (fun m => AlgebraicGeometry.Proj.basicOpen 𝒜 (GradedRing.proj 𝒜 m g_raw)) d
        have hd_pos : 0 < d := by
          by_contra hd0
          have hd_zero : d = 0 := Nat.eq_zero_of_not_pos hd0
          subst hd_zero
          have hf_C : f = MvPolynomial.C (f.coeff 0) := hdeg0_K' f hf_mem
          have hc_ne : f.coeff 0 ≠ 0 := by
            intro hc0
            have hmem : MvPolynomial.C (f.coeff 0) ∈
                (ιP_proj.base (x_pt i)).asHomogeneousIdeal.toIdeal :=
              (hScalarK' (ιP_proj.base (x_pt i)) (f.coeff 0)).mpr hc0
            rw [← hf_C] at hmem
            exact ((ProjectiveSpectrum.mem_basicOpen 𝒜 f _).mp hp_d) hmem
          have hz_not_mem : f ∉ (ιP_proj.base z_out).asHomogeneousIdeal.toIdeal := by
            rw [hf_C]
            exact mt (hScalarK' (ιP_proj.base z_out) (f.coeff 0)).mp hc_ne
          have hz_in_bo : ιP_proj.base z_out ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 f :=
            (ProjectiveSpectrum.mem_basicOpen 𝒜 f _).mpr hz_not_mem
          exact hz_out_Ucl (hf_le hz_in_bo)
        exact ⟨d, f, hd_pos, hf_mem, hp_d, hf_le⟩
      choose d_f f_hom hd_pos hf_mem hp_f hf_le using hBasis_i
      let D : ℕ := ∏ j : Fin k_pts, d_f j
      have hD_pos : 0 < D := Finset.prod_pos fun j _ => hd_pos j
      let e_exp : Fin k_pts → ℕ := fun i => ∏ j ∈ Finset.univ.erase i, d_f j
      have he_pos : ∀ i : Fin k_pts, 0 < e_exp i :=
        fun i => Finset.prod_pos fun j _ => hd_pos j
      have he_mul : ∀ i : Fin k_pts, e_exp i • d_f i = D := by
        intro i
        rw [smul_eq_mul, mul_comm]
        exact Finset.mul_prod_erase Finset.univ d_f (Finset.mem_univ i)
      let g_hom : Fin k_pts → MvPolynomial (Fin (M + 1)) K' := fun i => (f_hom i) ^ (e_exp i)
      have hg_mem : ∀ i : Fin k_pts, g_hom i ∈ 𝒜 D := by
        intro i
        rw [← he_mul i]
        exact SetLike.pow_mem_graded (e_exp i) (hf_mem i)
      have hg_bo : ∀ i : Fin k_pts,
          AlgebraicGeometry.Proj.basicOpen 𝒜 (g_hom i) =
            AlgebraicGeometry.Proj.basicOpen 𝒜 (f_hom i) :=
        fun i => AlgebraicGeometry.Proj.basicOpen_pow 𝒜 (f_hom i) (e_exp i) (he_pos i)
      let B_bad : Fin k_pts → Set K' := fun i₀ =>
        {lam : K' | (∑ j : Fin k_pts, MvPolynomial.C (lam ^ j.1) * g_hom j) ∈
          (ιP_proj.base (x_pt i₀)).asHomogeneousIdeal.toIdeal}
      have hBad_fin : ∀ i₀ : Fin k_pts, (B_bad i₀).Finite := by
        intro i₀
        by_contra hInf_bad
        have hInf_sub : Infinite ↥(B_bad i₀) := Set.infinite_coe_iff.mpr hInf_bad
        let emb := Infinite.natEmbedding ↥(B_bad i₀)
        let v : Fin k_pts → K' := fun r => (emb r.1).1
        have hv_inj : Function.Injective v := by
          intro r₁ r₂ h
          exact Fin.ext (emb.injective (Subtype.ext h))
        have hv_mem : ∀ r : Fin k_pts, v r ∈ B_bad i₀ := fun r => (emb r.1).2
        let P_id := (ιP_proj.base (x_pt i₀)).asHomogeneousIdeal.toIdeal
        have : P_id.IsPrime := (ιP_proj.base (x_pt i₀)).isPrime
        let Q_dom := MvPolynomial (Fin (M + 1)) K' ⧸ P_id
        have : IsDomain Q_dom := Ideal.Quotient.isDomain P_id
        let π_Q : MvPolynomial (Fin (M + 1)) K' →+* Q_dom := Ideal.Quotient.mk P_id
        let ρ_K' : K' →+* Q_dom := π_Q.comp MvPolynomial.C
        let w_vec : Fin k_pts → Q_dom := fun j => π_Q (g_hom j)
        have hw_ne : w_vec i₀ ≠ 0 := by
          intro h0
          have hmem_g : g_hom i₀ ∈ P_id := Ideal.Quotient.eq_zero_iff_mem.mp h0
          have hp_in_g : ιP_proj.base (x_pt i₀) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (g_hom i₀) := by
            rw [hg_bo i₀]
            exact hp_f i₀
          exact ((ProjectiveSpectrum.mem_basicOpen 𝒜 (g_hom i₀) _).mp hp_in_g) hmem_g
        let M_K' : Matrix (Fin k_pts) (Fin k_pts) K' := Matrix.vandermonde v
        let M_Q : Matrix (Fin k_pts) (Fin k_pts) Q_dom := M_K'.map ρ_K'
        have hMulVec0 : M_Q.mulVec w_vec = 0 := by
          ext r
          simp only [Matrix.mulVec, dotProduct, M_Q, M_K', Matrix.map_apply,
            Matrix.vandermonde_apply, Pi.zero_apply]
          have hr_mem : (∑ j : Fin k_pts, MvPolynomial.C ((v r) ^ j.1) * g_hom j) ∈ P_id :=
            hv_mem r
          have hπ_sum : π_Q (∑ j : Fin k_pts, MvPolynomial.C ((v r) ^ j.1) * g_hom j) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hr_mem
          rw [map_sum] at hπ_sum
          simpa only [map_mul, w_vec, ρ_K', RingHom.comp_apply] using hπ_sum
        have hAdj := congrArg (M_Q.adjugate.mulVec ·) hMulVec0
        rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.mulVec_zero] at hAdj
        have hDet_w : M_Q.det * w_vec i₀ = 0 := by
          have h1 := congrFun hAdj i₀
          simpa [Matrix.mulVec, dotProduct, Matrix.one_apply] using h1
        have hDetK'_ne : M_K'.det ≠ 0 := Matrix.det_vandermonde_ne_zero_iff.mpr hv_inj
        have hDetQ_eq : M_Q.det = ρ_K' M_K'.det := (RingHom.map_det ρ_K' M_K').symm
        have hDetQ_ne : M_Q.det ≠ 0 := by
          rw [hDetQ_eq]
          exact (map_ne_zero_iff ρ_K' ρ_K'.injective).mpr hDetK'_ne
        exact hw_ne ((mul_eq_zero.mp hDet_w).resolve_left hDetQ_ne)
      have hUnion_fin : (⋃ i₀ : Fin k_pts, B_bad i₀).Finite := Set.finite_iUnion hBad_fin
      have : Infinite K' := inferInstance
      have hNotUniv : (⋃ i₀ : Fin k_pts, B_bad i₀) ≠ Set.univ :=
        fun huniv => Set.infinite_univ (huniv ▸ hUnion_fin)
      obtain ⟨lam₀, hlam₀⟩ := Set.nonempty_compl.mpr hNotUniv
      let H : MvPolynomial (Fin (M + 1)) K' :=
        ∑ j : Fin k_pts, MvPolynomial.C (lam₀ ^ j.1) * g_hom j
      have hH_mem : H ∈ 𝒜 D := by
        refine Submodule.sum_mem _ fun j _ => ?_
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have hgj : (g_hom j).IsHomogeneous D :=
          (MvPolynomial.mem_homogeneousSubmodule D _).mp (hg_mem j)
        simpa only [zero_add] using (MvPolynomial.isHomogeneous_C _ (lam₀ ^ j.1)).mul hgj
      have hAff_boH : AlgebraicGeometry.IsAffineOpen (AlgebraicGeometry.Proj.basicOpen 𝒜 H) :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜 H hH_mem hD_pos
      let V_𝔪 : X_s.Opens := ιP_proj ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜 H
      have hAff_V𝔪 : AlgebraicGeometry.IsAffineOpen V_𝔪 := hAff_boH.preimage ιP_proj
      have hV𝔪_le : V_𝔪 ≤ W := by
        rw [← hUcl_pre]
        intro x hx
        have hH_not : H ∉ (ιP_proj.base x).asHomogeneousIdeal.toIdeal :=
          (ProjectiveSpectrum.mem_basicOpen 𝒜 H _).mp hx
        have hex_j : ∃ j : Fin k_pts, g_hom j ∉ (ιP_proj.base x).asHomogeneousIdeal.toIdeal := by
          by_contra! hall
          apply hH_not
          dsimp only [H]
          exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hall j)
        obtain ⟨j, hgj_not⟩ := hex_j
        have hxj : ιP_proj.base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (g_hom j) :=
          (ProjectiveSpectrum.mem_basicOpen 𝒜 (g_hom j) _).mpr hgj_not
        rw [hg_bo j] at hxj
        exact hf_le j hxj
      have hF_sub_V𝔪 : F_𝔪 ⊆ (V_𝔪 : Set ↥X_s) := by
        intro x hx
        let i₀ : Fin k_pts := e_fin.symm ⟨x, hx⟩
        have hx_eq : x_pt i₀ = x := by
          dsimp only [x_pt, i₀]
          rw [e_fin.apply_symm_apply]
        rw [← hx_eq]
        have hlam_not : lam₀ ∉ B_bad i₀ := fun h => hlam₀ (Set.mem_iUnion.mpr ⟨i₀, h⟩)
        exact (ProjectiveSpectrum.mem_basicOpen 𝒜 H _).mpr hlam_not
      exact ⟨V_𝔪, hAff_V𝔪, hV𝔪_le, hF_sub_V𝔪⟩

    let q_U : W.toScheme ⟶ U.toScheme := q_s ∣_ U
    have : AlgebraicGeometry.IsProper q_U :=
      CategoryTheory.MorphismProperty.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict q_s U).flip hProp_qs
    have hClMap_qU : IsClosedMap q_U.base := AlgebraicGeometry.Scheme.Hom.isClosedMap q_U
    let s_A : Set A := {a : A | AlgebraicGeometry.IsAffineOpen (X_s.basicOpen (θ a))}
    have hex_good : ∀ (𝔪 : Ideal A), 𝔪.IsMaximal → ∃ a ∈ s_A, a ∉ 𝔪 := by
      intro 𝔪 h𝔪_max
      obtain ⟨V_𝔪, hAff_V𝔪, hV𝔪_le, hF_sub⟩ := hEnclose 𝔪 h𝔪_max
      let p_𝔪 : PrimeSpectrum A := ⟨𝔪, h𝔪_max.isPrime⟩
      let y_𝔪 : ↥U.toScheme := hAffU.isoSpec.inv.base p_𝔪
      let K_bad : Set ↥W.toScheme := (W.ι.base ⁻¹' (V_𝔪 : Set ↥X_s))ᶜ
      have hKbad_cl : IsClosed K_bad := (V_𝔪.isOpen.preimage W.ι.continuous).isClosed_compl
      let O_𝔪 : Set ↥U.toScheme := (q_U.base '' K_bad)ᶜ
      have hO_open : IsOpen O_𝔪 := (hClMap_qU K_bad hKbad_cl).isOpen_compl
      have hy_in_O : y_𝔪 ∈ O_𝔪 := by
        rintro ⟨w, hw_bad, hw_eq⟩
        have hqw : q_s.base w.1 = U.ι.base y_𝔪 := by
          rw [← hw_eq]
          exact (congrArg (fun f => f.base w)
            (AlgebraicGeometry.morphismRestrict_ι q_s U)).symm
        exact hw_bad (hF_sub hqw)
      have hp_in_pre : p_𝔪 ∈ hAffU.isoSpec.inv.base ⁻¹' O_𝔪 := hy_in_O
      obtain ⟨_, ⟨_, ⟨a_𝔪, rfl⟩, rfl⟩, hp_a, ha_sub⟩ :=
        PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open
          hp_in_pre (hO_open.preimage hAffU.isoSpec.inv.continuous)
      have ha_not_mem : a_𝔪 ∉ 𝔪 := hp_a
      have hBo_le_V𝔪 : X_s.basicOpen (θ a_𝔪) ≤ V_𝔪 := by
        have hpre_bo : X_s.basicOpen (θ a_𝔪) = q_s ⁻¹ᵁ X_next_s.basicOpen a_𝔪 :=
          (AlgebraicGeometry.Scheme.Hom.preimage_basicOpen q_s a_𝔪).symm
        rw [hpre_bo]
        intro x hx_bo
        have hqx_U : q_s.base x ∈ U := AlgebraicGeometry.Scheme.basicOpen_le X_next_s a_𝔪 hx_bo
        let w : ↥W.toScheme := ⟨x, hqx_U⟩
        let u_pt : ↥U.toScheme := q_U.base w
        have hu_eq : U.ι.base u_pt = q_s.base x :=
          congrArg (fun f => f.base w) (AlgebraicGeometry.morphismRestrict_ι q_s U)
        let p_pt : PrimeSpectrum A := hAffU.isoSpec.hom.base u_pt
        have hp_bo : p_pt ∈ PrimeSpectrum.basicOpen a_𝔪 := by
          rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hAffU a_𝔪]
          change hAffU.fromSpec.base p_pt ∈ X_next_s.basicOpen a_𝔪
          have hfrom : hAffU.fromSpec.base p_pt = U.ι.base u_pt := by
            rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffU]
            exact congrArg (fun f : U.toScheme ⟶ U.toScheme => U.ι.base (f.base u_pt))
              hAffU.isoSpec.hom_inv_id
          rw [hfrom, hu_eq]
          exact hx_bo
        have hu_in_O : u_pt ∈ O_𝔪 := by
          have hinv_p : hAffU.isoSpec.inv.base p_pt = u_pt :=
            congrArg (fun f : U.toScheme ⟶ U.toScheme => f.base u_pt)
              hAffU.isoSpec.hom_inv_id
          have h1 : hAffU.isoSpec.inv.base p_pt ∈ O_𝔪 := ha_sub hp_bo
          rw [hinv_p] at h1
          exact h1
        by_contra hx_not_V
        exact hu_in_O ⟨w, hx_not_V, rfl⟩
      have hAff_bo : AlgebraicGeometry.IsAffineOpen (X_s.basicOpen (θ a_𝔪)) := by
        have hres := X_s.basicOpen_res (θ a_𝔪) (CategoryTheory.homOfLE hV𝔪_le).op
        have hinf : V_𝔪 ⊓ X_s.basicOpen (θ a_𝔪) = X_s.basicOpen (θ a_𝔪) :=
          inf_eq_right.mpr hBo_le_V𝔪
        rw [← hinf, ← hres]
        exact hAff_V𝔪.basicOpen _
      exact ⟨a_𝔪, hAff_bo, ha_not_mem⟩
    have hSup_U : (⨆ f : s_A, X_next_s.basicOpen f.1) = U := by
      apply le_antisymm
      · exact iSup_le fun f => AlgebraicGeometry.Scheme.basicOpen_le X_next_s f.1
      · intro y hyU
        let p_y : PrimeSpectrum A := hAffU.isoSpec.hom.base ⟨y, hyU⟩
        obtain ⟨𝔪, h𝔪_max, hp_le_𝔪⟩ := Ideal.exists_le_maximal p_y.asIdeal p_y.isPrime.ne_top
        obtain ⟨a, ha_sA, ha_not_𝔪⟩ := hex_good 𝔪 h𝔪_max
        have ha_not_py : a ∉ p_y.asIdeal := fun h => ha_not_𝔪 (hp_le_𝔪 h)
        have hpy_bo : p_y ∈ PrimeSpectrum.basicOpen a := ha_not_py
        rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hAffU a] at hpy_bo
        have hfrom_y : hAffU.fromSpec.base p_y = y := by
          rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffU]
          exact congrArg (fun f : U.toScheme ⟶ U.toScheme => U.ι.base (f.base ⟨y, hyU⟩))
            hAffU.isoSpec.hom_inv_id
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨a, ha_sA⟩, hfrom_y ▸ hpy_bo⟩
    have hSpanA : Ideal.span s_A = ⊤ := (hAffU.iSup_basicOpen_eq_self_iff).mp hSup_U
    have hSpanB : Ideal.span (θ '' s_A) = ⊤ := by
      haveI : RingHomSurjective θ := ⟨hBijU.surjective⟩
      rw [← Ideal.map_span, hSpanA, Ideal.map_top]
    have hAffW : AlgebraicGeometry.IsAffineOpen W := by
      refine AlgebraicGeometry.isAffineOpen_of_isAffineOpen_basicOpen W (θ '' s_A) hSpanB ?_
      rintro _ ⟨a, ha, rfl⟩
      exact ha
    have : AlgebraicGeometry.IsAffine U.toScheme := hAffU
    have : AlgebraicGeometry.IsAffine W.toScheme := hAffW
    have : CategoryTheory.IsIso (q_s.app U) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (q_s.app U)).mpr hBijU
    have hiso_apptop : CategoryTheory.IsIso (q_s.app (U.ι ''ᵁ ⊤)) := by
      have heq_U' : U.ι ''ᵁ ⊤ = U := by ext x; simp
      have hnat' := q_s.naturality (CategoryTheory.eqToHom heq_U'.symm).op
      let r_iso' := X_s.presheaf.map
        ((TopologicalSpace.Opens.map q_s.base).map
          (CategoryTheory.eqToHom heq_U'.symm).op.unop).op
      have : CategoryTheory.IsIso (q_s.app (U.ι ''ᵁ ⊤) ≫ r_iso') := by
        dsimp only [r_iso']
        rw [← hnat']
        infer_instance
      exact CategoryTheory.IsIso.of_isIso_comp_right (q_s.app (U.ι ''ᵁ ⊤)) r_iso'
    have hMapEqIso : ∀ {O₁ O₂ : X_s.Opens} (heq : O₁ = O₂),
        CategoryTheory.IsIso (X_s.presheaf.map (CategoryTheory.eqToHom heq).op) := by
      intro _ _ heq
      subst heq
      simp
      infer_instance
    have : CategoryTheory.IsIso q_U.appTop := by
      dsimp only [q_U]
      rw [AlgebraicGeometry.morphismRestrict_appTop]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hiso_apptop (hMapEqIso _)
    have hspec := AlgebraicGeometry.Scheme.toSpecΓ_naturality q_U
    have : CategoryTheory.IsIso (q_U ≫ U.toScheme.toSpecΓ) := by
      rw [hspec]
      infer_instance
    exact CategoryTheory.IsIso.of_isIso_comp_right q_U U.toScheme.toSpecΓ

  
  have helper_cross_chart :
      ∀ (U₀ U₁ : X_next_s.Opens),
        AlgebraicGeometry.IsAffineOpen U₁ →
        ∀ E ∈ irreducibleComponents ↥X_s,
          (E ∩ (q_s ⁻¹ᵁ U₀ : Set ↥X_s)).Nonempty →
          ¬ (E ⊆ (q_s ⁻¹ᵁ U₀ : Set ↥X_s)) →
          ¬ (E ⊆ (q_s ⁻¹ᵁ U₁ : Set ↥X_s)) := by
    intro U₀ U₁ hAffU₁ E hE hMeet₀ hNotSub₀ hSub₁
    obtain ⟨E_sch, ι_E, _hCl_E, _hInt_E, hRange_E⟩ := helper_integral_subscheme X_s E hE
    let p_E : E_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of K') := ι_E ≫ snd_s
    have : AlgebraicGeometry.IsProper p_E := by dsimp only [p_E]; infer_instance
    have : IsDomain ↑(E_sch.presheaf.obj (Opposite.op ⊤)) := inferInstance
    have hInt_p : (p_E.appTop).hom.IsIntegral :=
      AlgebraicGeometry.isIntegral_appTop_of_universallyClosed p_E
    have hInt_iso : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv).hom.IsIntegral :=
      RingHom.isIntegral_of_surjective _
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of K')).symm.commRingCatIsoToRingEquiv.surjective
    let c_E : K' →+* ↑(E_sch.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫ p_E.appTop).hom
    have hBij_cE : Function.Bijective c_E :=
      IsAlgClosed.ringHom_bijective_of_isIntegral c_E (RingHom.IsIntegral.trans _ _ hInt_iso hInt_p)
    let e_K' : K' ≃+* ↑(E_sch.presheaf.obj (Opposite.op ⊤)) := RingEquiv.ofBijective c_E hBij_cE
    have hSubsing : Subsingleton ↥(AlgebraicGeometry.Spec (E_sch.presheaf.obj (Opposite.op ⊤))) := by
      refine ⟨fun q₁ q₂ => ?_⟩
      have hBot : ∀ q : PrimeSpectrum ↑(E_sch.presheaf.obj (Opposite.op ⊤)), q.asIdeal = ⊥ := by
        intro q
        rw [Submodule.eq_bot_iff]
        intro a ha
        by_contra ha_ne
        have hc_ne : e_K'.symm a ≠ 0 := fun h0 =>
          ha_ne ((e_K'.apply_symm_apply a).symm.trans (by rw [h0, map_zero]))
        have h_unit : a * e_K' (e_K'.symm a)⁻¹ = 1 := by
          calc
            a * e_K' (e_K'.symm a)⁻¹ = e_K' (e_K'.symm a) * e_K' (e_K'.symm a)⁻¹ := by
              congr 1
              exact (e_K'.apply_symm_apply a).symm
            _ = 1 := by rw [← map_mul, mul_inv_cancel₀ hc_ne, map_one]
        have h1_mem : (1 : ↑(E_sch.presheaf.obj (Opposite.op ⊤))) ∈ q.asIdeal := by
          rw [← h_unit]
          exact q.asIdeal.mul_mem_right _ ha
        exact q.isPrime.ne_top (q.asIdeal.eq_top_of_isUnit_mem h1_mem isUnit_one)
      exact PrimeSpectrum.ext ((hBot q₁).trans (hBot q₂).symm)
    have hRange_lift : Set.range (ι_E ≫ q_s).base ⊆ Set.range U₁.ι.base := by
      rintro _ ⟨z, rfl⟩
      have hxE : ι_E.base z ∈ E := by rw [← hRange_E]; exact ⟨z, rfl⟩
      have hxU₁ : q_s.base (ι_E.base z) ∈ U₁ := hSub₁ hxE
      exact ⟨⟨q_s.base (ι_E.base z), hxU₁⟩, rfl⟩
    let ψ_E : E_sch ⟶ U₁.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U₁.ι (ι_E ≫ q_s) hRange_lift
    have hψ_fac : ψ_E ≫ U₁.ι = ι_E ≫ q_s :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₁.ι (ι_E ≫ q_s) hRange_lift
    have hNat_ψ := AlgebraicGeometry.Scheme.toSpecΓ_naturality ψ_E
    have : AlgebraicGeometry.IsAffine U₁.toScheme := hAffU₁
    have hConst : ∀ z₁ z₂ : ↥E_sch, q_s.base (ι_E.base z₁) = q_s.base (ι_E.base z₂) := by
      intro z₁ z₂
      have hSpec_eq : E_sch.toSpecΓ.base z₁ = E_sch.toSpecΓ.base z₂ :=
        @Subsingleton.elim _ hSubsing _ _
      have h1 := congrArg (fun f => f.base z₁) hNat_ψ
      have h2 := congrArg (fun f => f.base z₂) hNat_ψ
      have hU₁_spec : U₁.toScheme.toSpecΓ.base (ψ_E.base z₁) =
          U₁.toScheme.toSpecΓ.base (ψ_E.base z₂) := by
        change (ψ_E ≫ U₁.toScheme.toSpecΓ).base z₁ = (ψ_E ≫ U₁.toScheme.toSpecΓ).base z₂
        rw [h1, h2]
        exact congrArg (AlgebraicGeometry.Spec.map ψ_E.appTop).base hSpec_eq
      have h_inv_eq := congrArg (CategoryTheory.inv U₁.toScheme.toSpecΓ).base hU₁_spec
      have hid₁ := congrArg (fun f => f.base (ψ_E.base z₁))
        (CategoryTheory.IsIso.hom_inv_id U₁.toScheme.toSpecΓ)
      have hid₂ := congrArg (fun f => f.base (ψ_E.base z₂))
        (CategoryTheory.IsIso.hom_inv_id U₁.toScheme.toSpecΓ)
      have hψ_eq : ψ_E.base z₁ = ψ_E.base z₂ := hid₁.symm.trans (h_inv_eq.trans hid₂)
      have hf₁ := congrArg (fun f => f.base z₁) hψ_fac
      have hf₂ := congrArg (fun f => f.base z₂) hψ_fac
      exact hf₁.symm.trans ((congrArg U₁.ι.base hψ_eq).trans hf₂)
    obtain ⟨x_in, hx_in_E, hx_in_U₀⟩ := hMeet₀
    obtain ⟨x_out, hx_out_E, hx_out_U₀⟩ := Set.not_subset.mp hNotSub₀
    rw [← hRange_E] at hx_in_E hx_out_E
    obtain ⟨z₁, rfl⟩ := hx_in_E
    obtain ⟨z₂, rfl⟩ := hx_out_E
    have hq_in : q_s.base (ι_E.base z₁) ∈ U₀ := hx_in_U₀
    rw [hConst z₁ z₂] at hq_in
    exact hx_out_U₀ hq_in

  
  obtain ⟨_hφ_comm, U_next₀, f₁, _hAff_Unext₀, _hPre_Unext₀, hFibProj, _hVanZ⟩ := hProjMap
  obtain ⟨hAff_U₀, heq₀, hPre_U₀, hBij_U₀_le, hChart₁⟩ :=
    hFibProj K' s q_s hq_fst hq_snd
  let U₀_s : X_next_s.Opens :=
    (TopologicalSpace.Opens.map fst_next_s.base).obj U_next₀
  let f₁_s : ↑(X_s.presheaf.obj (Opposite.op W₀_s)) :=
    (fst_s.appLE W_compl W₀_s le_rfl).hom f₁
  have hBij_U₀ : Function.Bijective (q_s.app U₀_s).hom := by
    have h_comp : q_s.app U₀_s ≫ X_s.presheaf.map (CategoryTheory.homOfLE heq₀).op =
        q_s.appLE U₀_s W₀_s heq₀ := rfl
    have h_hom_eq : CategoryTheory.homOfLE heq₀ = CategoryTheory.eqToHom hPre_U₀.symm :=
      Subsingleton.elim _ _
    have h_map_iso : CategoryTheory.IsIso (X_s.presheaf.map (CategoryTheory.homOfLE heq₀).op) := by
      rw [h_hom_eq]
      infer_instance
    have h_bij_res : Function.Bijective (X_s.presheaf.map (CategoryTheory.homOfLE heq₀).op).hom :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mp h_map_iso
    have h_bij_comp : Function.Bijective
        ((X_s.presheaf.map (CategoryTheory.homOfLE heq₀).op).hom.comp (q_s.app U₀_s).hom) := by
      simpa [← CommRingCat.hom_comp, h_comp] using hBij_U₀_le
    exact ⟨fun a b hab =>
      h_bij_comp.1 (congrArg (X_s.presheaf.map (CategoryTheory.homOfLE heq₀).op).hom hab),
      fun b => by
        obtain ⟨a, ha⟩ := h_bij_comp.2
          ((X_s.presheaf.map (CategoryTheory.homOfLE heq₀).op).hom b)
        exact ⟨a, h_bij_res.1 ha⟩⟩

  have hMeet_U₀ : ∀ E ∈ irreducibleComponents ↥X_s, (E ∩ (q_s ⁻¹ᵁ U₀_s : Set ↥X_s)).Nonempty := by
    intro E hE
    obtain ⟨x_E, hx_V₀₁, hx_E⟩ := hMeetV₀₁ K' s E hE
    have hx_W₀ : x_E ∈ (W₀_s : Set ↥X_s) := Or.inl hx_V₀₁.2
    have hx_U₀ : x_E ∈ (q_s ⁻¹ᵁ U₀_s : Set ↥X_s) := by
      change x_E ∈ (((TopologicalSpace.Opens.map q_s.base).obj U₀_s : X_s.Opens) : Set ↥X_s)
      rw [hPre_U₀]
      exact hx_W₀
    exact ⟨x_E, hx_E, hx_U₀⟩

  have hApp_of_appLE_rfl : ∀ (U₁ : X_next_s.Opens),
      Function.Bijective
        (q_s.appLE U₁ ((TopologicalSpace.Opens.map q_s.base).obj U₁) le_rfl).hom →
      Function.Bijective (q_s.app U₁).hom := by
    intro U₁ hBij_le
    have heq_app : q_s.app U₁ =
        q_s.appLE U₁ ((TopologicalSpace.Opens.map q_s.base).obj U₁) le_rfl := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
    rw [heq_app]
    exact hBij_le

  refine ⟨?_, ?_⟩
  · 
    intro hNoComp_W₀
    have hNoComp₀ : ∀ E ∈ irreducibleComponents ↥X_s, ¬ (E ⊆ (q_s ⁻¹ᵁ U₀_s : Set ↥X_s)) := by
      intro E hE hSub
      apply hNoComp_W₀ E hE
      intro x hxE
      have hx1 : x ∈ (((TopologicalSpace.Opens.map q_s.base).obj U₀_s : X_s.Opens) : Set ↥X_s) :=
        hSub hxE
      rw [hPre_U₀] at hx1
      exact hx1
    have hIso₀ : CategoryTheory.IsIso (q_s ∣_ U₀_s) :=
      helper_crux_chart_isIso U₀_s hAff_U₀ hBij_U₀ hNoComp₀
    obtain ⟨U₁_0, hAff_U₁, hCov_0, _, hBij_U₁_le⟩ := hChart₁ 0
    have hBij_U₁ : Function.Bijective (q_s.app U₁_0).hom := hApp_of_appLE_rfl U₁_0 hBij_U₁_le
    have hNoComp₁ : ∀ E ∈ irreducibleComponents ↥X_s, ¬ (E ⊆ (q_s ⁻¹ᵁ U₁_0 : Set ↥X_s)) :=
      fun E hE => helper_cross_chart U₀_s U₁_0 hAff_U₁ E hE (hMeet_U₀ E hE) (hNoComp₀ E hE)
    have hIso₁ : CategoryTheory.IsIso (q_s ∣_ U₁_0) :=
      helper_crux_chart_isIso U₁_0 hAff_U₁ hBij_U₁ hNoComp₁
    let U_cov : Bool → X_next_s.Opens
      | true => U₀_s
      | false => U₁_0
    have hSup : iSup U_cov = ⊤ := by
      rw [iSup_bool_eq]
      exact hCov_0
    rw [← CategoryTheory.MorphismProperty.isomorphisms.iff]
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme.{u}) U_cov hSup]
    intro b
    rw [CategoryTheory.MorphismProperty.isomorphisms.iff]
    cases b
    · exact hIso₁
    · exact hIso₀
  · 
    intro E_star hE_star hSub_star hOther
    let c_K' : K' →+* ↑(X_s.presheaf.obj (Opposite.op W₀_s)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE snd_s ⊤ W₀_s (fun _ _ => trivial)).hom
    letI : Algebra K' ↑(X_s.presheaf.obj (Opposite.op W₀_s)) := c_K'.toAlgebra
    obtain ⟨E_sch, ι_E, _, _, hRange_E⟩ := helper_integral_subscheme X_s E_star hE_star
    let p_E : E_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of K') := ι_E ≫ snd_s
    have : AlgebraicGeometry.IsProper p_E := by dsimp only [p_E]; infer_instance
    have : IsDomain ↑(E_sch.presheaf.obj (Opposite.op ⊤)) := inferInstance
    have hInt_p : (p_E.appTop).hom.IsIntegral :=
      AlgebraicGeometry.isIntegral_appTop_of_universallyClosed p_E
    have hInt_iso : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv).hom.IsIntegral :=
      RingHom.isIntegral_of_surjective _
        (AlgebraicGeometry.Scheme.ΓSpecIso
          (CommRingCat.of K')).symm.commRingCatIsoToRingEquiv.surjective
    let c_E : K' →+* ↑(E_sch.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫ p_E.appTop).hom
    have hBij_cE : Function.Bijective c_E :=
      IsAlgClosed.ringHom_bijective_of_isIntegral c_E (RingHom.IsIntegral.trans _ _ hInt_iso hInt_p)
    have h_top : (⊤ : E_sch.Opens) ≤ ι_E ⁻¹ᵁ W₀_s := by
      intro z _
      change ι_E.base z ∈ W₀_s
      apply hSub_star
      rw [← hRange_E]
      exact ⟨z, rfl⟩
    let ρ_E : ↑(X_s.presheaf.obj (Opposite.op W₀_s)) →+* ↑(E_sch.presheaf.obj (Opposite.op ⊤)) :=
      (ι_E.appLE W₀_s ⊤ h_top).hom
    have h_appLE_comp :
        AlgebraicGeometry.Scheme.Hom.appLE snd_s ⊤ W₀_s (fun _ _ => trivial) ≫
          ι_E.appLE W₀_s ⊤ h_top = p_E.appTop :=
      (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_E snd_s ⊤ W₀_s ⊤
        (fun _ _ => trivial) h_top).trans (AlgebraicGeometry.Scheme.Hom.app_eq_appLE p_E).symm
    have hρ_comp : ρ_E.comp c_K' = c_E := by
      dsimp only [ρ_E, c_K', c_E]
      rw [← CommRingCat.hom_comp, Category.assoc, h_appLE_comp]
    obtain ⟨c₁, hc₁⟩ := hBij_cE.2 (ρ_E f₁_s)
    have hρ_zero : ρ_E (f₁_s - algebraMap K' _ c₁) = 0 := by
      change ρ_E (f₁_s - c_K' c₁) = 0
      rw [map_sub, ← RingHom.comp_apply ρ_E c_K', hρ_comp, hc₁, sub_self]
    have hDisj_bo : Disjoint E_star
        (X_s.basicOpen (f₁_s - algebraMap K' _ c₁) : Set ↥X_s) := by
      refine Set.disjoint_left.mpr fun x hxE hx_bo => ?_
      rw [← hRange_E] at hxE
      obtain ⟨z, rfl⟩ := hxE
      have hz_pre : z ∈ ι_E ⁻¹ᵁ X_s.basicOpen (f₁_s - algebraMap K' _ c₁) := hx_bo
      rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen] at hz_pre
      have hz_res : z ∈ (⊤ : E_sch.Opens) ⊓
          E_sch.basicOpen ((ι_E.app W₀_s).hom (f₁_s - algebraMap K' _ c₁)) := ⟨trivial, hz_pre⟩
      rw [← E_sch.basicOpen_res _ (CategoryTheory.homOfLE h_top).op] at hz_res
      have h_res_eq : (E_sch.presheaf.map (CategoryTheory.homOfLE h_top).op).hom
          ((ι_E.app W₀_s).hom (f₁_s - algebraMap K' _ c₁)) =
          ρ_E (f₁_s - algebraMap K' _ c₁) := rfl
      rw [h_res_eq, hρ_zero, E_sch.basicOpen_zero] at hz_res
      exact hz_res
    obtain ⟨U₁_star, hAff_U₁_star, hCov_star, hInter_star, hBij_U₁_star_le⟩ := hChart₁ c₁
    have hBij_U₁_star : Function.Bijective (q_s.app U₁_star).hom :=
      hApp_of_appLE_rfl U₁_star hBij_U₁_star_le
    have hDisj_star : Disjoint E_star
        (((TopologicalSpace.Opens.map q_s.base).obj U₁_star : X_s.Opens) : Set ↥X_s) := by
      refine Set.disjoint_left.mpr fun x hxE hxW₁ => ?_
      have hx_inf : x ∈ ((W₀_s ⊓ (TopologicalSpace.Opens.map q_s.base).obj U₁_star :
          X_s.Opens) : Set ↥X_s) := ⟨hSub_star hxE, hxW₁⟩
      rw [hInter_star] at hx_inf
      exact Set.disjoint_left.mp hDisj_bo hxE hx_inf
    have hNoComp_star : ∀ E ∈ irreducibleComponents ↥X_s,
        ¬ (E ⊆ (q_s ⁻¹ᵁ U₁_star : Set ↥X_s)) := by
      intro E hE
      by_cases hEq : E = E_star
      · subst hEq
        intro hSub
        obtain ⟨x₀, hx₀⟩ := hE_star.1.1
        exact Set.disjoint_left.mp hDisj_star hx₀ (hSub hx₀)
      · have hNotW₀ : ¬ (E ⊆ (q_s ⁻¹ᵁ U₀_s : Set ↥X_s)) := by
          intro hSub
          apply hOther E ⟨hE, hEq⟩
          intro x hxE
          have hx1 :
              x ∈ (((TopologicalSpace.Opens.map q_s.base).obj U₀_s : X_s.Opens) : Set ↥X_s) :=
            hSub hxE
          rw [hPre_U₀] at hx1
          exact hx1
        exact helper_cross_chart U₀_s U₁_star hAff_U₁_star E hE (hMeet_U₀ E hE) hNotW₀
    have hIso_star : CategoryTheory.IsIso (q_s ∣_ U₁_star) :=
      helper_crux_chart_isIso U₁_star hAff_U₁_star hBij_U₁_star hNoComp_star
    exact ⟨U₀_s, U₁_star, hAff_U₀, hCov_star, hPre_U₀, ⟨heq₀, hBij_U₀_le⟩,
      hDisj_star, hIso_star⟩

theorem weil_sup1_closed_contraction_irreducibleComponents_drop (X X' : Type u) [TopologicalSpace X] [TopologicalSpace X']
    (f : X → X') (Z : Set X) (y_star : X')
    (hf_cont : Continuous f)
    (hf_closed : IsClosedMap f)
    (hf_surj : Function.Surjective f)
    (hpre : f ⁻¹' {y_star} = Z)
    (hinj : Set.InjOn f (Zᶜ))
    (hfin : (irreducibleComponents X).Finite)
    (hZ : Z ∈ irreducibleComponents X)
    (hmeet : (Z ∩ ⋃ E' ∈ (irreducibleComponents X) \ {Z}, E').Nonempty) :
    Nat.card ↥(irreducibleComponents X') < Nat.card ↥(irreducibleComponents X) :=
by
  let _ := hinj
  let S_rem : Set (Set X) := (irreducibleComponents X) \ {Z}
  let I_img : Set (Set X') := (fun E' : Set X => f '' E') '' S_rem
  obtain ⟨q₀, hq₀Z, hq₀U⟩ := hmeet
  obtain ⟨E'₀, hE'₀_rem, hq₀E'₀⟩ := Set.mem_iUnion₂.mp hq₀U
  have hfq₀ : f q₀ = y_star := by
    have hmem : q₀ ∈ f ⁻¹' {y_star} := by
      rw [hpre]
      exact hq₀Z
    exact Set.mem_singleton_iff.mp hmem
  have hy_star_mem : y_star ∈ f '' E'₀ := ⟨q₀, hq₀E'₀, hfq₀⟩
  have hcov : ∀ y : X', ∃ E' ∈ S_rem, y ∈ f '' E' := by
    intro y
    obtain ⟨x, rfl⟩ := hf_surj y
    by_cases hEZ : irreducibleComponent x = Z
    · have hxZ : x ∈ Z := by
        rw [← hEZ]
        exact mem_irreducibleComponent
      have hfx : f x = y_star := by
        have hmem : x ∈ f ⁻¹' {y_star} := by
          rw [hpre]
          exact hxZ
        exact Set.mem_singleton_iff.mp hmem
      rw [hfx]
      exact ⟨E'₀, hE'₀_rem, hy_star_mem⟩
    · exact ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x, hEZ⟩,
        ⟨x, mem_irreducibleComponent, rfl⟩⟩
  have hfin_rem : S_rem.Finite := Set.Finite.sdiff hfin
  have hfin_img : I_img.Finite := hfin_rem.image (fun E' : Set X => f '' E')
  have hSub_img : irreducibleComponents X' ⊆ I_img := by
    intro T hT
    have hT_sUnion : T ⊆ ⋃₀ (↑hfin_img.toFinset : Set (Set X')) := by
      intro y hy
      obtain ⟨E', hE'_rem, hy_img⟩ := hcov y
      exact Set.mem_sUnion.mpr ⟨f '' E', hfin_img.mem_toFinset.mpr ⟨E', hE'_rem, rfl⟩, hy_img⟩
    have hClosed_fin : ∀ C ∈ hfin_img.toFinset, IsClosed C := by
      intro C hC
      obtain ⟨E', hE'_rem, rfl⟩ := hfin_img.mem_toFinset.mp hC
      exact hf_closed E' (isClosed_of_mem_irreducibleComponents E' hE'_rem.1)
    obtain ⟨C, hC_fin, hT_sub_C⟩ :=
      (isIrreducible_iff_sUnion_isClosed.mp hT.prop) hfin_img.toFinset hClosed_fin hT_sUnion
    obtain ⟨E', hE'_rem, rfl⟩ := hfin_img.mem_toFinset.mp hC_fin
    have hImg_irred : IsIrreducible (f '' E') :=
      hE'_rem.1.prop.image f hf_cont.continuousOn
    have hEq : T = f '' E' := hT.eq_of_le hImg_irred hT_sub_C
    exact ⟨E', hE'_rem, hEq.symm⟩
  rw [Nat.card_coe_set_eq, Nat.card_coe_set_eq]
  have hle₁ : (irreducibleComponents X').ncard ≤ I_img.ncard :=
    Set.ncard_le_ncard hSub_img hfin_img
  have hle₂ : I_img.ncard ≤ S_rem.ncard :=
    Set.ncard_image_le hfin_rem
  have hlt₃ : S_rem.ncard < (irreducibleComponents X).ncard :=
    Set.ncard_sdiff_singleton_lt_of_mem hZ hfin
  exact lt_of_le_of_lt (le_trans hle₁ hle₂) hlt₃

theorem weil_sup1_semistable_geom_fiber_reduced_and_const_comp (K' : Type u) [Field K'] [IsAlgClosed K']
    (X : AlgebraicGeometry.Scheme.{u})
    (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K'))
    (hProp : AlgebraicGeometry.IsProper p)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation p)
    (hGeom : ∀ x : ↥X,
      (∃ V_sm : X.Opens, x ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ X)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) K' ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = x ∧
        (∀ i : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K') ∈
            (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K'))))) :
    ((irreducibleComponents ↥X).Finite ∧ AlgebraicGeometry.IsReduced X) ∧
    (∀ (E₁ E₂ : Set ↥X),
      E₁ ∈ irreducibleComponents ↥X →
      E₂ ∈ irreducibleComponents ↥X →
      E₁ ≠ E₂ →
      ∀ (V₁ : X.Opens) (hAffV₁ : AlgebraicGeometry.IsAffineOpen V₁)
        (q : ↥X) (hq : q ∈ V₁),
        q ∈ E₁ →
        q ∈ E₂ →
        let ιK_V₁ : K' →+* ↑(X.presheaf.obj (Opposite.op V₁)) :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
            p.appLE ⊤ V₁ (fun _ _ => trivial)).hom
        ∃ (D : CommRingCat.{u}) (n₀ : PrimeSpectrum ↑D)
          (α₁ : ↑(X.presheaf.obj (Opposite.op V₁)) →+* ↑D)
          (α₂ : (MvPolynomial (Fin 2) K' ⧸ Ideal.span
            {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
              (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}) →+* ↑D),
          α₁.Etale ∧
          α₂.Etale ∧
          Ideal.comap α₁ n₀.asIdeal = (hAffV₁.isoSpec.hom.base ⟨q, hq⟩).asIdeal ∧
          (∀ i : Fin 2,
            α₂ (Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K')) ∈
              n₀.asIdeal) ∧
          α₁.comp ιK_V₁ =
            α₂.comp ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K'))) ∧
    (∀ (E_star : Set ↥X),
      E_star ∈ irreducibleComponents ↥X →
      ∀ (W₀ : X.Opens),
        E_star ⊆ (W₀ : Set ↥X) →
        let ιK_W₀ : K' →+* ↑(X.presheaf.obj (Opposite.op W₀)) :=
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
            p.appLE ⊤ W₀ (fun _ _ => trivial)).hom
        ∃ (ev_E : ↑(X.presheaf.obj (Opposite.op W₀)) →+* K'),
          ev_E.comp ιK_W₀ = RingHom.id K' ∧
          (∀ f : ↑(X.presheaf.obj (Opposite.op W₀)),
            ev_E f = 0 → Disjoint E_star ((X.basicOpen f : X.Opens) : Set ↥X)) ∧
          (∀ f : ↑(X.presheaf.obj (Opposite.op W₀)),
            ev_E f ≠ 0 → E_star ⊆ ((X.basicOpen f : X.Opens) : Set ↥X))) :=
by
  classical
  have : AlgebraicGeometry.IsProper p := hProp
  have : AlgebraicGeometry.LocallyOfFinitePresentation p := hLFP

  
  have hLocNoethX : AlgebraicGeometry.IsLocallyNoetherian X :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p
  have hCompX : CompactSpace ↥X :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p
  have : AlgebraicGeometry.IsNoetherian X :=
    (AlgebraicGeometry.isNoetherian_iff X).mpr ⟨hLocNoethX, hCompX⟩
  have hFinComp : (irreducibleComponents ↥X).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian (X := X)

  
  let I_nod : Ideal (MvPolynomial (Fin 2) K') :=
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
      (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}
  let R_nod : Type u := MvPolynomial (Fin 2) K' ⧸ I_nod
  let c_nod : K' →+* R_nod :=
    (Ideal.Quotient.mk I_nod).comp (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K')

  have hRedRnod : _root_.IsReduced R_nod := by
    have hX_mon : ∀ i : Fin 2,
        (MvPolynomial.X i : MvPolynomial (Fin 2) K') =
          MvPolynomial.monomial (Finsupp.single i 1) 1 := by
      intro i
      simpa using (MvPolynomial.X_pow_eq_monomial (R := K') (σ := Fin 2) (e := 1) (n := i))
    let ev₀ : MvPolynomial (Fin 2) K' →+* Polynomial K' :=
      MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X]
    let ev₁ : MvPolynomial (Fin 2) K' →+* Polynomial K' :=
      MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0]
    have hev₀_ker : ∀ a ∈ I_nod, ev₀ a = 0 := by
      intro a ha
      rw [Ideal.mem_span_singleton] at ha
      rcases ha with ⟨r, rfl⟩
      simp [ev₀]
    have hev₁_ker : ∀ a ∈ I_nod, ev₁ a = 0 := by
      intro a ha
      rw [Ideal.mem_span_singleton] at ha
      rcases ha with ⟨r, rfl⟩
      simp [ev₁]
    let π₀ : R_nod →+* Polynomial K' := Ideal.Quotient.lift I_nod ev₀ hev₀_ker
    let π₁ : R_nod →+* Polynomial K' := Ideal.Quotient.lift I_nod ev₁ hev₁_ker
    have hev₀_mon : ∀ (d : Fin 2 →₀ ℕ) (c : K'),
        ev₀ (MvPolynomial.monomial d c) =
          Polynomial.C c * ((0 : Polynomial K') ^ (d 0) * Polynomial.X ^ (d 1)) := by
      intro d c
      rw [MvPolynomial.eval₂Hom_monomial,
        Finsupp.prod_of_support_subset d (Finset.subset_univ d.support) _ (fun i _ => pow_zero _),
        Fin.prod_univ_two]
      simp
    have hev₁_mon : ∀ (d : Fin 2 →₀ ℕ) (c : K'),
        ev₁ (MvPolynomial.monomial d c) =
          Polynomial.C c * (Polynomial.X ^ (d 0) * (0 : Polynomial K') ^ (d 1)) := by
      intro d c
      rw [MvPolynomial.eval₂Hom_monomial,
        Finsupp.prod_of_support_subset d (Finset.subset_univ d.support) _ (fun i _ => pow_zero _),
        Fin.prod_univ_two]
      simp
    let π_prod : R_nod →+* Polynomial K' × Polynomial K' := RingHom.prod π₀ π₁
    have hπ_inj : Function.Injective π_prod := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
      have hev₀_P : ev₀ P = 0 := congrArg Prod.fst ha
      have hev₁_P : ev₁ P = 0 := congrArg Prod.snd ha
      rw [Ideal.Quotient.eq_zero_iff_mem]
      have h_supp : ∀ d ∈ P.support, d 0 ≠ 0 ∧ d 1 ≠ 0 := by
        intro d hd
        have hd_ne : P.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        refine ⟨?_, ?_⟩
        · intro hd0
          have h0 : (ev₀ P).coeff (d 1) = 0 := by rw [hev₀_P, Polynomial.coeff_zero]
          rw [MvPolynomial.as_sum P, map_sum, Polynomial.finsetSum_coeff] at h0
          rw [Finset.sum_eq_single d] at h0
          · rw [hev₀_mon, hd0, pow_zero, one_mul, Polynomial.coeff_C_mul_X_pow] at h0
            simp at h0
            exact hd_ne h0
          · intro d' _ hd'_ne
            by_cases hd'0 : d' 0 = 0
            · have hd'1 : d' 1 ≠ d 1 := by
                intro h1
                apply hd'_ne
                ext j
                exact (Fin.forall_fin_two (p := fun j => d' j = d j)).mpr
                  ⟨hd'0.trans hd0.symm, h1⟩ j
              rw [hev₀_mon, hd'0, pow_zero, one_mul, Polynomial.coeff_C_mul_X_pow]
              exact ite_eq_right_iff.mpr fun h_eq => False.elim (hd'1 h_eq.symm)
            · rw [hev₀_mon, zero_pow hd'0, zero_mul, mul_zero, Polynomial.coeff_zero]
          · intro hd_abs; exact False.elim (hd_abs hd)
        · intro hd1
          have h0 : (ev₁ P).coeff (d 0) = 0 := by rw [hev₁_P, Polynomial.coeff_zero]
          rw [MvPolynomial.as_sum P, map_sum, Polynomial.finsetSum_coeff] at h0
          rw [Finset.sum_eq_single d] at h0
          · rw [hev₁_mon, hd1, pow_zero, mul_one, Polynomial.coeff_C_mul_X_pow] at h0
            simp at h0
            exact hd_ne h0
          · intro d' _ hd'_ne
            by_cases hd'1 : d' 1 = 0
            · have hd'0 : d' 0 ≠ d 0 := by
                intro h1
                apply hd'_ne
                ext j
                exact (Fin.forall_fin_two (p := fun j => d' j = d j)).mpr
                  ⟨h1, hd'1.trans hd1.symm⟩ j
              rw [hev₁_mon, hd'1, pow_zero, mul_one, Polynomial.coeff_C_mul_X_pow]
              exact ite_eq_right_iff.mpr fun h_eq => False.elim (hd'0 h_eq.symm)
            · rw [hev₁_mon, zero_pow hd'1, mul_zero, mul_zero, Polynomial.coeff_zero]
          · intro hd_abs; exact False.elim (hd_abs hd)
      let δ : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
      have hδ0 : δ 0 = 1 := by simp [δ]
      have hδ1 : δ 1 = 1 := by simp [δ]
      have hX01 : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) K') =
          MvPolynomial.monomial δ 1 := by
        rw [hX_mon 0, hX_mon 1, MvPolynomial.monomial_mul_monomial, one_mul]
      rw [Ideal.mem_span_singleton]
      refine ⟨∑ d ∈ P.support, MvPolynomial.monomial (d - δ) (P.coeff d), ?_⟩
      rw [Finset.mul_sum]
      conv_lhs => rw [MvPolynomial.as_sum P]
      refine Finset.sum_congr rfl fun d hd => ?_
      obtain ⟨hd0, hd1⟩ := h_supp d hd
      have h_add : δ + (d - δ) = d := by
        ext j
        refine (Fin.forall_fin_two (p := fun j => (δ + (d - δ)) j = d j)).mpr ⟨?_, ?_⟩ j
        · simp only [Finsupp.add_apply, Finsupp.tsub_apply, hδ0]; omega
        · simp only [Finsupp.add_apply, Finsupp.tsub_apply, hδ1]; omega
      rw [hX01, MvPolynomial.monomial_mul_monomial, one_mul, h_add]
    exact _root_.isReduced_of_injective π_prod hπ_inj

  have hEtaleReduced : ∀ (R B : Type u) [CommRing R] [IsNoetherianRing R] [_root_.IsReduced R]
      [CommRing B] [Algebra R B] [Algebra.Etale R B], _root_.IsReduced B := by
    intro R B _ _ _ _ _ _
    let M : Type u := ↥(minimalPrimes R)
    have hFinM : Finite M := (minimalPrimes.finite_of_isNoetherianRing R).to_subtype
    let _ : Fintype M := Fintype.ofFinite M
    have : ∀ m : M, m.1.IsPrime := fun m => m.2.1.1
    let _ : ∀ m : M, IsDomain (R ⧸ m.1) := fun m => Ideal.Quotient.isDomain m.1
    let ι_R : R →ₗ[R] (∀ m : M, FractionRing (R ⧸ m.1)) :=
      LinearMap.pi (fun m : M => Algebra.linearMap R (FractionRing (R ⧸ m.1)))
    have hι_inj : Function.Injective ι_R := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      have hr_nil : r ∈ nilradical R := by
        rw [nilradical_eq_sInf R, Ideal.mem_sInf]
        intro P hP
        obtain ⟨q, hq_min, hq_le⟩ := @Ideal.exists_minimalPrimes_le R _ ⊥ P hP bot_le
        have hq_M : q ∈ minimalPrimes R := hq_min
        have hm0 : algebraMap R (FractionRing (R ⧸ q)) r = 0 := congrFun hr ⟨q, hq_M⟩
        rw [IsScalarTower.algebraMap_apply R (R ⧸ q) (FractionRing (R ⧸ q)) r] at hm0
        have h_mk : Ideal.Quotient.mk q r = 0 :=
          (injective_iff_map_eq_zero _).mp
            (IsFractionRing.injective (R ⧸ q) (FractionRing (R ⧸ q))) _ hm0
        exact hq_le (Ideal.Quotient.eq_zero_iff_mem.mp h_mk)
      exact IsNilpotent.eq_zero (mem_nilradical.mp hr_nil)
    have : Module.Flat R B := Algebra.Smooth.flat R B
    have hlT_inj : Function.Injective (LinearMap.lTensor B ι_R) :=
      Module.Flat.lTensor_preserves_injective_linearMap ι_R hι_inj
    let j_B : B →+* (∀ m : M, TensorProduct R B (FractionRing (R ⧸ m.1))) :=
      RingHom.pi (fun m : M =>
        (Algebra.TensorProduct.includeLeft :
          B →ₐ[R] TensorProduct R B (FractionRing (R ⧸ m.1))).toRingHom)
    have hj_eq : ∀ b : B,
        j_B b = TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
          (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b)) := by
      intro b
      ext m
      simp [j_B, ι_R, TensorProduct.piRight]
    have hj_inj : Function.Injective j_B := by
      intro b₁ b₂ h
      have h1 : TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
          (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b₁)) =
        TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
          (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b₂)) := by
        rw [← hj_eq b₁, ← hj_eq b₂, h]
      exact (TensorProduct.rid R B).symm.injective
        (hlT_inj ((TensorProduct.piRight R R B _).injective h1))
    have : ∀ m : M, _root_.IsReduced (TensorProduct R B (FractionRing (R ⧸ m.1))) := by
      intro m
      have : Algebra.Etale (FractionRing (R ⧸ m.1))
          (TensorProduct R (FractionRing (R ⧸ m.1)) B) :=
        Algebra.Etale.baseChange R B (FractionRing (R ⧸ m.1))
      have : _root_.IsReduced (TensorProduct R (FractionRing (R ⧸ m.1)) B) :=
        Algebra.FormallyUnramified.isReduced_of_field (FractionRing (R ⧸ m.1)) _
      exact _root_.isReduced_of_injective
        (Algebra.TensorProduct.comm R B (FractionRing (R ⧸ m.1))).toRingEquiv
        (Algebra.TensorProduct.comm R B (FractionRing (R ⧸ m.1))).injective
    exact _root_.isReduced_of_injective j_B hj_inj

  
  
  have hPolyEtaleStalkDomain : ∀ (B : Type u) [CommRing B]
      (g_et : Polynomial K' →+* B) (_ : g_et.Etale) (q : Ideal B) [q.IsPrime],
      IsDomain (Localization.AtPrime q) := by
    intro B _ g_et hg_et q _
    let A₀ : Type u := Polynomial K'
    let _ : Algebra A₀ B := g_et.toAlgebra
    have : Algebra.Etale A₀ B := RingHom.etale_algebraMap.mp hg_et
    let p₀ : Ideal A₀ := Ideal.comap (algebraMap A₀ B) q
    have : p₀.IsPrime := Ideal.comap_isPrime (algebraMap A₀ B) q
    let R_loc : Type u := Localization.AtPrime p₀
    let S_loc : Type u := Localization.AtPrime q
    let φ_loc : R_loc →+* S_loc := Localization.localRingHom p₀ q (algebraMap A₀ B) rfl
    let _ : Algebra R_loc S_loc := φ_loc.toAlgebra
    have : IsScalarTower A₀ R_loc S_loc := IsScalarTower.of_algebraMap_eq fun a => by
      rw [IsScalarTower.algebraMap_apply A₀ B S_loc]
      exact (Localization.localRingHom_to_map p₀ q (algebraMap A₀ B) rfl a).symm
    have : IsLocalHom (algebraMap R_loc S_loc) :=
      Localization.isLocalHom_localRingHom p₀ q (algebraMap A₀ B) rfl
    have : Algebra.FormallyUnramified R_loc S_loc :=
      Algebra.instFormallyUnramifiedAtPrimeOfIsUnramifiedAtOfIsScalarTower p₀ q
    have : Algebra.EssFiniteType A₀ S_loc :=
      Algebra.EssFiniteType.comp A₀ B S_loc
    have : Algebra.EssFiniteType R_loc S_loc :=
      Algebra.EssFiniteType.of_comp A₀ R_loc S_loc
    have hMapMax : Ideal.map (algebraMap R_loc S_loc) (IsLocalRing.maximalIdeal R_loc) =
        IsLocalRing.maximalIdeal S_loc :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hMapR : Ideal.map (algebraMap A₀ R_loc) p₀ = IsLocalRing.maximalIdeal R_loc :=
      Localization.AtPrime.map_eq_maximalIdeal
    have hMaxS : IsLocalRing.maximalIdeal S_loc = Ideal.map (algebraMap A₀ S_loc) p₀ := by
      rw [← hMapMax, ← hMapR, Ideal.map_map, ← IsScalarTower.algebraMap_eq A₀ R_loc S_loc]
    have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing A₀ B
    have : IsNoetherianRing S_loc := IsLocalization.isNoetherianRing q.primeCompl S_loc inferInstance
    have : Module.Flat A₀ B := Algebra.Smooth.flat A₀ B
    have : Module.Flat A₀ S_loc := Module.Flat.trans A₀ B S_loc
    by_cases hp₀ : p₀ = ⊥
    · have hMaxBot : IsLocalRing.maximalIdeal S_loc = ⊥ := by
        rw [hMaxS, hp₀, Ideal.map_bot]
      have : NoZeroDivisors S_loc := ⟨fun {x y} hxy => by
        by_cases hx : x = 0
        · exact Or.inl hx
        · have hx_not : x ∉ IsLocalRing.maximalIdeal S_loc := by
            rw [hMaxBot, Ideal.mem_bot]; exact hx
          have hx_unit : IsUnit x := IsLocalRing.notMem_maximalIdeal.mp hx_not
          exact Or.inr (hx_unit.mul_right_eq_zero.mp hxy)⟩
      exact IsDomain.mk
    · let t₀ : A₀ := Submodule.IsPrincipal.generator p₀
      have ht₀_span : Ideal.span ({t₀} : Set A₀) = p₀ :=
        Submodule.IsPrincipal.span_singleton_generator p₀
      have ht₀_ne : t₀ ≠ 0 := by
        intro h0
        apply hp₀
        rw [← ht₀_span, h0, Set.singleton_zero, Ideal.span_zero]
      let π : S_loc := algebraMap A₀ S_loc t₀
      have hMaxSpan : IsLocalRing.maximalIdeal S_loc = Ideal.span ({π} : Set S_loc) := by
        rw [hMaxS, ← ht₀_span, Ideal.map_span, Set.image_singleton]
      let mul_t₀ : A₀ →ₗ[A₀] A₀ := LinearMap.mulLeft A₀ t₀
      have hmul_inj : Function.Injective mul_t₀ := mul_right_injective₀ ht₀_ne
      have hlT_t₀ : Function.Injective (LinearMap.lTensor S_loc mul_t₀) :=
        Module.Flat.lTensor_preserves_injective_linearMap mul_t₀ hmul_inj
      have hπ_reg : ∀ z : S_loc, π * z = 0 → z = 0 := by
        intro z hz
        have htz : (TensorProduct.rid A₀ S_loc)
            (LinearMap.lTensor S_loc mul_t₀ ((TensorProduct.rid A₀ S_loc).symm z)) = 0 := by
          simp only [TensorProduct.rid_symm_apply, LinearMap.lTensor_tmul, TensorProduct.rid_tmul,
            mul_t₀, LinearMap.mulLeft_apply, mul_one, Algebra.smul_def]
          exact hz
        have h1 : LinearMap.lTensor S_loc mul_t₀ ((TensorProduct.rid A₀ S_loc).symm z) = 0 :=
          (TensorProduct.rid A₀ S_loc).injective (htz.trans (map_zero _).symm)
        have h2 : (TensorProduct.rid A₀ S_loc).symm z = 0 :=
          hlT_t₀ (h1.trans (map_zero _).symm)
        exact (TensorProduct.rid A₀ S_loc).symm.injective (h2.trans (map_zero _).symm)
      have hπ_pow_reg : ∀ (k : ℕ) (z : S_loc), π ^ k * z = 0 → z = 0 := by
        intro k
        induction k with
        | zero => intro z hz; simpa using hz
        | succ k ih =>
          intro z hz
          rw [pow_succ', mul_assoc] at hz
          exact ih z (hπ_reg _ hz)
      have hKrull : (⨅ n : ℕ, (IsLocalRing.maximalIdeal S_loc) ^ n) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal S_loc)
          (IsLocalRing.maximalIdeal.isMaximal S_loc).ne_top
      have hUnitPow : ∀ z : S_loc, z ≠ 0 → ∃ (k : ℕ) (u : S_loc), IsUnit u ∧ z = π ^ k * u := by
        intro z hz
        have hex : ∃ n : ℕ, z ∉ (IsLocalRing.maximalIdeal S_loc) ^ (n + 1) := by
          by_contra hall
          push Not at hall
          have hmem : z ∈ ⨅ n : ℕ, (IsLocalRing.maximalIdeal S_loc) ^ n := by
            rw [Ideal.mem_iInf]
            intro n
            cases n with
            | zero => simp
            | succ n => exact hall n
          rw [hKrull, Ideal.mem_bot] at hmem
          exact hz hmem
        let k : ℕ := Nat.find hex
        have hnot_succ : z ∉ (IsLocalRing.maximalIdeal S_loc) ^ (k + 1) := Nat.find_spec hex
        have hmem_k : z ∈ (IsLocalRing.maximalIdeal S_loc) ^ k := by
          cases h_eq : k with
          | zero => simp
          | succ m =>
            have hm_lt : m < k := by omega
            exact Classical.not_not.mp (Nat.find_min hex hm_lt)
        rw [hMaxSpan, Ideal.span_singleton_pow] at hmem_k hnot_succ
        obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton.mp hmem_k
        refine ⟨k, u, ?_, hu_eq⟩
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hu_mem
        rw [hMaxSpan] at hu_mem
        obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton.mp hu_mem
        apply hnot_succ
        rw [hu_eq]
        exact Ideal.mem_span_singleton.mpr ⟨v, by ring⟩
      have : NoZeroDivisors S_loc := ⟨fun {a b} hab => by
        by_contra hne
        push Not at hne
        obtain ⟨i, u, hu, rfl⟩ := hUnitPow a hne.1
        obtain ⟨j, v, hv, rfl⟩ := hUnitPow b hne.2
        have hmul : π ^ (i + j) * (u * v) = 0 := by
          calc
            π ^ (i + j) * (u * v) = (π ^ i * u) * (π ^ j * v) := by rw [pow_add]; ring
            _ = 0 := hab
        exact (hu.mul hv).ne_zero (hπ_pow_reg (i + j) (u * v) hmul)⟩
      exact IsDomain.mk

  have hSmoothStalkDomain : ∀ (x : ↥X) (V_sm : X.Opens),
      x ∈ V_sm → AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p) →
      IsDomain ↑(X.presheaf.stalk x) := by
    intro x V_sm hx_Vsm hSm_V
    obtain ⟨U_base, _hAffU_base, W, hAffW, hxW, he_W, hStd_U⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (V_sm.ι ≫ p)).mp hSm_V ⟨x, hx_Vsm⟩
    have hy₀ : (V_sm.ι ≫ p).base ⟨x, hx_Vsm⟩ ∈ U_base := he_W hxW
    have hU_top : U_base = ⊤ := by
      ext z
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      rw [Subsingleton.elim z ((V_sm.ι ≫ p).base ⟨x, hx_Vsm⟩)]
      exact hy₀
    subst hU_top
    let B : Type u := ↑(V_sm.toScheme.presheaf.obj (Opposite.op W))
    have hBij_Γ : Function.Bijective
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv).hom :=
      (ConcreteCategory.isIso_iff_bijective
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv).mp inferInstance
    let e_Γ : K' ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of K')).presheaf.obj (Opposite.op ⊤)) :=
      RingEquiv.ofBijective _ hBij_Γ
    have hStd_K : RingHom.IsStandardSmoothOfRelativeDimension 1
        (((V_sm.ι ≫ p).appLE ⊤ W he_W).hom.comp e_Γ.toRingHom) :=
      (@RingHom.isStandardSmoothOfRelativeDimension_respectsIso 1).right
        ((V_sm.ι ≫ p).appLE ⊤ W he_W).hom e_Γ hStd_U
    obtain ⟨g_mv, _, hg_mv_et⟩ := hStd_K.exists_etale_mvPolynomial
    let φ_mv : MvPolynomial (Fin 1) K' →+* Polynomial K' :=
      MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X)
    let ψ_mv : Polynomial K' →+* MvPolynomial (Fin 1) K' :=
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
    have hφψ : φ_mv.comp ψ_mv = RingHom.id (Polynomial K') := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [φ_mv, ψ_mv]
      · simp [φ_mv, ψ_mv]
    have hψφ : ψ_mv.comp φ_mv = RingHom.id (MvPolynomial (Fin 1) K') := by
      apply MvPolynomial.ringHom_ext
      · intro c; simp [φ_mv, ψ_mv]
      · intro i; rw [Subsingleton.elim i 0]; simp [φ_mv, ψ_mv]
    have hψ_bij : Function.Bijective ψ_mv :=
      ⟨Function.LeftInverse.injective (g := φ_mv) (fun q => by simpa using RingHom.congr_fun hφψ q),
       Function.RightInverse.surjective (g := φ_mv) (fun q => by simpa using RingHom.congr_fun hψφ q)⟩
    have hg₁_et : (g_mv.comp ψ_mv).Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.of_bijective hψ_bij) hg_mv_et
    let x_W : ↥W := ⟨⟨x, hx_Vsm⟩, hxW⟩
    let P_x : Ideal B := (hAffW.primeIdealOf x_W).asIdeal
    have : IsDomain (Localization.AtPrime P_x) :=
      hPolyEtaleStalkDomain B (g_mv.comp ψ_mv) hg₁_et P_x
    let _ : Algebra B ↑(V_sm.toScheme.presheaf.stalk ⟨x, hx_Vsm⟩) :=
      TopCat.Presheaf.algebra_section_stalk V_sm.toScheme.presheaf x_W
    have : IsLocalization.AtPrime ↑(V_sm.toScheme.presheaf.stalk ⟨x, hx_Vsm⟩) P_x :=
      hAffW.isLocalization_stalk x_W
    let e_stalk₁ : ↑(V_sm.toScheme.presheaf.stalk ⟨x, hx_Vsm⟩) ≃+* Localization.AtPrime P_x :=
      (IsLocalization.algEquiv P_x.primeCompl
        ↑(V_sm.toScheme.presheaf.stalk ⟨x, hx_Vsm⟩) (Localization.AtPrime P_x)).toRingEquiv
    have : IsDomain ↑(V_sm.toScheme.presheaf.stalk ⟨x, hx_Vsm⟩) :=
      Function.Injective.isDomain e_stalk₁.toRingHom e_stalk₁.injective
    have : CategoryTheory.IsIso ((V_sm.ι).stalkMap ⟨x, hx_Vsm⟩) :=
      AlgebraicGeometry.IsOpenImmersion.instIsIsoCommRingCatStalkMap V_sm.ι ⟨x, hx_Vsm⟩
    have hInj_ι : Function.Injective ((V_sm.ι).stalkMap ⟨x, hx_Vsm⟩).hom :=
      ((ConcreteCategory.isIso_iff_bijective ((V_sm.ι).stalkMap ⟨x, hx_Vsm⟩)).mp inferInstance).1
    exact Function.Injective.isDomain ((V_sm.ι).stalkMap ⟨x, hx_Vsm⟩).hom hInj_ι

  
  have hStalkRed : ∀ x : ↥X, _root_.IsReduced ↑(X.presheaf.stalk x) := by
    intro x
    rcases hGeom x with ⟨V_sm, hx_Vsm, hSm_V⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀_x, _hXi, _he_comm⟩
    · have : IsDomain ↑(X.presheaf.stalk x) := hSmoothStalkDomain x V_sm hx_Vsm hSm_V
      exact isReduced_of_noZeroDivisors
    · obtain ⟨W', hAffW', hu₀, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := u₀) trivial
      let D_W : Type u := ↑(U'.presheaf.obj (Opposite.op W'))
      let α₂_W : R_nod →+* D_W :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv ≫
          e₂.appLE ⊤ W' (fun _ _ => trivial)).hom
      have h_e2_et : (e₂.appLE ⊤ W' (fun _ _ => trivial)).hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) e₂ hEt₂
          ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ ⟨W', hAffW'⟩ (fun _ _ => trivial)
      have h_iso_et : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv).hom.Etale :=
        RingHom.Etale.of_bijective ((ConcreteCategory.isIso_iff_bijective
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv).mp inferInstance)
      have hα₂_et : α₂_W.Etale :=
        RingHom.Etale.stableUnderComposition _ _ h_iso_et h_e2_et
      let _ : Algebra R_nod D_W := α₂_W.toAlgebra
      have : Algebra.Etale R_nod D_W := RingHom.etale_algebraMap.mp hα₂_et
      have : _root_.IsReduced R_nod := hRedRnod
      have : _root_.IsReduced D_W := hEtaleReduced R_nod D_W
      let _ : Algebra D_W ↑(U'.presheaf.stalk u₀) :=
        TopCat.Presheaf.algebra_section_stalk U'.presheaf ⟨u₀, hu₀⟩
      have : IsLocalization.AtPrime ↑(U'.presheaf.stalk u₀)
          (hAffW'.primeIdealOf ⟨u₀, hu₀⟩).asIdeal :=
        hAffW'.isLocalization_stalk ⟨u₀, hu₀⟩
      have : _root_.IsReduced ↑(U'.presheaf.stalk u₀) := ⟨fun z ⟨n, hzn⟩ => by
        obtain ⟨⟨d, s⟩, hds⟩ := IsLocalization.surj
          (hAffW'.primeIdealOf ⟨u₀, hu₀⟩).asIdeal.primeCompl z
        dsimp only at hds
        have hdn : algebraMap D_W ↑(U'.presheaf.stalk u₀) (d ^ n) =
            algebraMap D_W ↑(U'.presheaf.stalk u₀) 0 := by
          rw [map_pow, ← hds, mul_pow, hzn, zero_mul, map_zero]
        obtain ⟨t, ht⟩ := (IsLocalization.eq_iff_exists
          (hAffW'.primeIdealOf ⟨u₀, hu₀⟩).asIdeal.primeCompl _).mp hdn
        rw [mul_zero] at ht
        have htd : (t.1 * d) ^ n = 0 := by
          rcases n with _ | n
          · simp at hzn
          · calc (t.1 * d) ^ (n + 1) = t.1 ^ n * (t.1 * d ^ (n + 1)) := by ring
              _ = 0 := by rw [ht, mul_zero]
        have htd0 : t.1 * d = 0 := IsNilpotent.eq_zero ⟨n, htd⟩
        have hd0 : algebraMap D_W ↑(U'.presheaf.stalk u₀) d = 0 :=
          (IsLocalization.map_eq_zero_iff
            (hAffW'.primeIdealOf ⟨u₀, hu₀⟩).asIdeal.primeCompl _ d).mpr ⟨t, htd0⟩
        have hzs : z * algebraMap D_W ↑(U'.presheaf.stalk u₀) s.1 = 0 := hds.trans hd0
        exact (IsLocalization.map_units ↑(U'.presheaf.stalk u₀) s).mul_left_eq_zero.mp hzs⟩
      have : AlgebraicGeometry.Etale e₁ := hEt₁
      let ψ_stalk := (e₁.stalkMap u₀).hom
      have hFlat_ψ : ψ_stalk.Flat := AlgebraicGeometry.Flat.stalkMap e₁ u₀
      have hInj_ψ : Function.Injective ψ_stalk := by
        let _ := ψ_stalk.toAlgebra
        have : Module.Flat ↑(X.presheaf.stalk (e₁.base u₀)) ↑(U'.presheaf.stalk u₀) := hFlat_ψ
        have : IsLocalHom (algebraMap ↑(X.presheaf.stalk (e₁.base u₀))
            ↑(U'.presheaf.stalk u₀)) :=
          inferInstanceAs (IsLocalHom ψ_stalk)
        have hFaith : Module.FaithfullyFlat ↑(X.presheaf.stalk (e₁.base u₀))
            ↑(U'.presheaf.stalk u₀) :=
          Module.FaithfullyFlat.of_flat_of_isLocalHom
        exact RingHom.FaithfullyFlat.injective hFaith
      have hRed_eu₀ : _root_.IsReduced ↑(X.presheaf.stalk (e₁.base u₀)) :=
        _root_.isReduced_of_injective ψ_stalk hInj_ψ
      exact hu₀_x ▸ hRed_eu₀
  have hRedX : AlgebraicGeometry.IsReduced X :=
    @AlgebraicGeometry.isReduced_of_isReduced_stalk X hStalkRed

  refine ⟨⟨hFinComp, hRedX⟩, ?_, ?_⟩

  
  · intro E₁ E₂ hE₁ hE₂ hE₁₂ V₁ hAffV₁ q hq hq₁ hq₂ ιK_V₁
    rcases hGeom q with ⟨V_sm, hq_Vsm, hSm_V⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀_q, hXi, he_comm⟩
    · exfalso
      have : IsDomain ↑(X.presheaf.stalk q) := hSmoothStalkDomain q V_sm hq_Vsm hSm_V
      let A₁ : Type u := ↑(X.presheaf.obj (Opposite.op V₁))
      let q_V₁ : ↥V₁ := ⟨q, hq⟩
      let z₀ : PrimeSpectrum A₁ := hAffV₁.primeIdealOf q_V₁
      let _ : Algebra A₁ ↑(X.presheaf.stalk q) :=
        TopCat.Presheaf.algebra_section_stalk X.presheaf q_V₁
      have : IsLocalization.AtPrime ↑(X.presheaf.stalk q) z₀.asIdeal :=
        hAffV₁.isLocalization_stalk q_V₁
      let q₀ : Ideal A₁ := RingHom.ker (algebraMap A₁ ↑(X.presheaf.stalk q))
      have hq₀ : q₀.IsPrime := RingHom.ker_isPrime (algebraMap A₁ ↑(X.presheaf.stalk q))
      have hq₀_min : ∀ (P_id : Ideal A₁), P_id.IsPrime → P_id ≤ z₀.asIdeal → q₀ ≤ P_id := by
        intro P_id hP_id hPz a ha
        have ha0 : algebraMap A₁ ↑(X.presheaf.stalk q) a = 0 := ha
        obtain ⟨m, hma⟩ :=
          (IsLocalization.map_eq_zero_iff z₀.asIdeal.primeCompl ↑(X.presheaf.stalk q) a).mp ha0
        have hmem : m.1 * a ∈ P_id := by
          rw [hma]; exact P_id.zero_mem
        rcases hP_id.mem_or_mem hmem with hm | haP
        · exact False.elim (m.2 (hPz hm))
        · exact haP
      let j : PrimeSpectrum A₁ → ↥X := hAffV₁.fromSpec.base
      have : AlgebraicGeometry.IsOpenImmersion hAffV₁.fromSpec := hAffV₁.isOpenImmersion_fromSpec
      have hj : Topology.IsOpenEmbedding j := hAffV₁.fromSpec.isOpenEmbedding
      have hj_z₀ : j z₀ = q := hAffV₁.fromSpec_primeIdealOf q_V₁
      have hE_char : ∀ E : Set ↥X,
          E ∈ irreducibleComponents ↥X → q ∈ E →
          E = closure (j '' PrimeSpectrum.zeroLocus (q₀ : Set A₁)) := by
        intro E hE hqE
        have hE_irr : IsIrreducible E := hE.1
        have hE_max : ∀ T : Set ↥X, IsIrreducible T → E ⊆ T → T ⊆ E := hE.2
        have hE_cl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
        have hE_clos : closure (j '' (j ⁻¹' E)) = E := by
          rw [Set.image_preimage_eq_inter_range]
          apply Set.Subset.antisymm
          · exact hE_cl.closure_subset_iff.mpr Set.inter_subset_left
          · intro y hyE
            rw [mem_closure_iff]
            intro O hO hyO
            obtain ⟨w, hwE, hwO, hwR⟩ :=
              hE_irr.isPreirreducible O (Set.range j) hO hj.isOpen_range
                ⟨y, hyE, hyO⟩ ⟨q, hqE, z₀, hj_z₀⟩
            exact ⟨w, hwO, hwE, hwR⟩
        have hjE_irr : IsIrreducible (j ⁻¹' E) := by
          refine ⟨⟨z₀, ?_⟩, ?_⟩
          · show j z₀ ∈ E; rw [hj_z₀]; exact hqE
          · intro W₁ W₂ hW₁ hW₂ ⟨w₁, hw₁E, hw₁W⟩ ⟨w₂, hw₂E, hw₂W⟩
            obtain ⟨v, hvE, ⟨u₁, hu₁W, rfl⟩, ⟨u₂, hu₂W, hju⟩⟩ :=
              hE_irr.isPreirreducible (j '' W₁) (j '' W₂)
                (hj.isOpenMap W₁ hW₁) (hj.isOpenMap W₂ hW₂)
                ⟨j w₁, hw₁E, w₁, hw₁W, rfl⟩ ⟨j w₂, hw₂E, w₂, hw₂W, rfl⟩
            have hu_eq : u₁ = u₂ := hj.toIsEmbedding.injective hju.symm
            refine ⟨u₁, hvE, hu₁W, ?_⟩
            rw [hu_eq]; exact hu₂W
        have hjE_comp : j ⁻¹' E ∈ irreducibleComponents (PrimeSpectrum A₁) := by
          refine ⟨hjE_irr, ?_⟩
          intro S' hS' hsub
          have hS'_irr : IsIrreducible (closure (j '' S')) :=
            (hS'.image j hj.continuous.continuousOn).closure
          have hE_sub : E ⊆ closure (j '' S') := by
            rw [← hE_clos]
            exact closure_mono (Set.image_mono hsub)
          have hclos_sub : closure (j '' S') ⊆ E := hE_max (closure (j '' S')) hS'_irr hE_sub
          intro z hz
          exact hclos_sub (subset_closure ⟨z, hz, rfl⟩)
        rw [← PrimeSpectrum.zeroLocus_minimalPrimes] at hjE_comp
        obtain ⟨P_min, hP_min, hP_eq⟩ := hjE_comp
        dsimp only [Function.comp_apply] at hP_eq
        have hz₀_mem : z₀ ∈ PrimeSpectrum.zeroLocus (P_min : Set A₁) := by
          rw [hP_eq]; show j z₀ ∈ E; rw [hj_z₀]; exact hqE
        have hP_le_z₀ : P_min ≤ z₀.asIdeal := by
          simpa [PrimeSpectrum.mem_zeroLocus] using hz₀_mem
        have hq₀_le_P : q₀ ≤ P_min := hq₀_min P_min hP_min.1.1 hP_le_z₀
        have hP_le_q₀ : P_min ≤ q₀ := hP_min.2 ⟨hq₀, bot_le⟩ hq₀_le_P
        have hP_eq_q₀ : P_min = q₀ := le_antisymm hP_le_q₀ hq₀_le_P
        rw [← hE_clos, ← hP_eq, hP_eq_q₀]
      exact hE₁₂ ((hE_char E₁ hE₁ hq₁).trans (hE_char E₂ hE₂ hq₂).symm)
    · have hu₀_pre : u₀ ∈ (TopologicalSpace.Opens.map e₁.base).obj V₁ := by
        change e₁.base u₀ ∈ V₁
        rw [hu₀_q]
        exact hq
      obtain ⟨W', hAffW', hu₀, hW'_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := (TopologicalSpace.Opens.map e₁.base).obj V₁) (x := u₀) hu₀_pre
      let D : CommRingCat.{u} := U'.presheaf.obj (Opposite.op W')
      let n₀ : PrimeSpectrum ↑D := hAffW'.isoSpec.hom.base ⟨u₀, hu₀⟩
      let α₁ : ↑(X.presheaf.obj (Opposite.op V₁)) →+* ↑D := (e₁.appLE V₁ W' hW'_le).hom
      let α₂ : R_nod →+* ↑D :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv ≫
          e₂.appLE ⊤ W' (fun _ _ => trivial)).hom
      have hα₁_et : α₁.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) e₁ hEt₁
          ⟨V₁, hAffV₁⟩ ⟨W', hAffW'⟩ hW'_le
      have h_e2_et : (e₂.appLE ⊤ W' (fun _ _ => trivial)).hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) e₂ hEt₂
          ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ ⟨W', hAffW'⟩ (fun _ _ => trivial)
      have h_iso_et : ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv).hom.Etale :=
        RingHom.Etale.of_bijective ((ConcreteCategory.isIso_iff_bijective
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv).mp inferInstance)
      have hα₂_et : α₂.Etale :=
        RingHom.Etale.stableUnderComposition _ _ h_iso_et h_e2_et
      refine ⟨D, n₀, α₁, α₂, hα₁_et, hα₂_et, ?_, ?_, ?_⟩
      · have hSpec₁ : hAffW'.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (e₁.appLE V₁ W' hW'_le) =
            e₁.resLE V₁ W' hW'_le ≫ hAffV₁.isoSpec.hom := by
          rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom,
            AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
          exact AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE e₁ V₁ W' hW'_le
        have hres_pt : (e₁.resLE V₁ W' hW'_le).base ⟨u₀, hu₀⟩ = ⟨q, hq⟩ := by
          apply V₁.ι.isOpenEmbedding.injective
          have h1 := congrArg (fun f => f.base ⟨u₀, hu₀⟩)
            (AlgebraicGeometry.Scheme.Hom.resLE_comp_ι e₁ hW'_le)
          change V₁.ι.base ((e₁.resLE V₁ W' hW'_le).base ⟨u₀, hu₀⟩) = e₁.base u₀ at h1
          exact h1.trans hu₀_q
        have hbase₁ := congrArg (fun f => f.base ⟨u₀, hu₀⟩) hSpec₁
        change (AlgebraicGeometry.Spec.map (e₁.appLE V₁ W' hW'_le)).base n₀ =
          hAffV₁.isoSpec.hom.base ((e₁.resLE V₁ W' hW'_le).base ⟨u₀, hu₀⟩) at hbase₁
        rw [hres_pt] at hbase₁
        exact congrArg PrimeSpectrum.asIdeal hbase₁
      · intro i
        have hSpec₂ : hAffW'.isoSpec.hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₂) = W'.ι ≫ e₂ := by
          have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE e₂ ⊤ W' (fun _ _ => trivial)
          have h2 : CommRingCat.ofHom α₂ =
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv ≫
                e₂.appLE ⊤ W' (fun _ _ => trivial) := rfl
          rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom, h2, AlgebraicGeometry.Spec.map_comp,
            ← CategoryTheory.Category.assoc, h1]
          dsimp only [R_nod, I_nod]
          simp
          exact AlgebraicGeometry.Scheme.Hom.resLE_comp_ι e₂ (U := ⊤) (V := W') (fun _ _ => trivial)
        have hbase₂ := congrArg (fun f => f.base ⟨u₀, hu₀⟩) hSpec₂
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₂)).base n₀ = e₂.base u₀ at hbase₂
        have hasIdeal₂ : Ideal.comap α₂ n₀.asIdeal = (e₂.base u₀).asIdeal :=
          congrArg PrimeSpectrum.asIdeal hbase₂
        change Ideal.Quotient.mk I_nod (MvPolynomial.X i) ∈ Ideal.comap α₂ n₀.asIdeal
        rw [hasIdeal₂]
        exact hXi i
      · have hcomm_cat :
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
              p.appLE ⊤ V₁ (fun _ _ => trivial)) ≫ e₁.appLE V₁ W' hW'_le =
            CommRingCat.ofHom c_nod ≫
              ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R_nod)).inv ≫
                e₂.appLE ⊤ W' (fun _ _ => trivial)) := by
          rw [CategoryTheory.Category.assoc,
            AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e₁ p ⊤ V₁ W' (fun _ _ => trivial) hW'_le,
            he_comm,
            ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e₂
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)) ⊤ ⊤ W'
              (fun _ _ => trivial) (fun _ _ => trivial)]
          have happTop : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)).appLE ⊤ ⊤
              (fun _ _ => trivial) =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)).appTop := rfl
          rw [happTop, ← AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality_assoc]
        exact congrArg CommRingCat.Hom.hom hcomm_cat

  
  · intro E_star hE_star W₀ hE_sub ιK_W₀
    let Z_cl : TopologicalSpace.Closeds ↥X :=
      ⟨E_star, isClosed_of_mem_irreducibleComponents E_star hE_star⟩
    let I_sh : X.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_cl
    let E_sch : AlgebraicGeometry.Scheme.{u} := I_sh.subscheme
    let ι_E : E_sch ⟶ X := I_sh.subschemeι
    have hRange_ιE : Set.range ι_E.base = E_star := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
        AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have hEmb : Topology.IsClosedEmbedding ι_E.base := ι_E.isClosedEmbedding
    obtain ⟨x₀_E, hx₀_E⟩ := hE_star.1.1
    rw [← hRange_ιE] at hx₀_E
    obtain ⟨z₀_E, _⟩ := hx₀_E
    have hPreIrred_E : IsPreirreducible (Set.univ : Set ↥E_sch) := by
      intro U₁ U₂ hU₁ hU₂ ⟨z₁, _, hz₁⟩ ⟨z₂, _, hz₂⟩
      let C₁ : Set ↥X := ι_E.base '' (U₁ᶜ)
      let C₂ : Set ↥X := ι_E.base '' (U₂ᶜ)
      have hC₁_cl : IsClosed C₁ := hEmb.isClosedMap _ hU₁.isClosed_compl
      have hC₂_cl : IsClosed C₂ := hEmb.isClosedMap _ hU₂.isClosed_compl
      have hz₁_not : ι_E.base z₁ ∉ C₁ := by
        rintro ⟨w, hw, hw_eq⟩
        exact hw (hEmb.injective hw_eq ▸ hz₁)
      have hz₂_not : ι_E.base z₂ ∉ C₂ := by
        rintro ⟨w, hw, hw_eq⟩
        exact hw (hEmb.injective hw_eq ▸ hz₂)
      have hz₁_E : ι_E.base z₁ ∈ E_star := by rw [← hRange_ιE]; exact ⟨z₁, rfl⟩
      have hz₂_E : ι_E.base z₂ ∈ E_star := by rw [← hRange_ιE]; exact ⟨z₂, rfl⟩
      obtain ⟨y, hyE, hy₁, hy₂⟩ :=
        hE_star.1.2 (C₁ᶜ) (C₂ᶜ) hC₁_cl.isOpen_compl hC₂_cl.isOpen_compl
          ⟨ι_E.base z₁, hz₁_E, hz₁_not⟩ ⟨ι_E.base z₂, hz₂_E, hz₂_not⟩
      rw [← hRange_ιE] at hyE
      obtain ⟨w, rfl⟩ := hyE
      refine ⟨w, trivial, ?_, ?_⟩
      · by_contra hw₁; exact hy₁ ⟨w, hw₁, rfl⟩
      · by_contra hw₂; exact hy₂ ⟨w, hw₂, rfl⟩
    have : IrreducibleSpace ↥E_sch :=
      { toPreirreducibleSpace := ⟨hPreIrred_E⟩
        toNonempty := ⟨z₀_E⟩ }
    have hPieceRed : ∀ (U : I_sh.subschemeCover.openCover.I₀),
        AlgebraicGeometry.IsReduced ((I_sh.subschemeCover.openCover).X U) := by
      intro U
      let U' : ↥X.affineOpens := U
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op U'.1)) ⧸ I_sh.ideal U')))
      rw [AlgebraicGeometry.affine_isReduced_iff]
      dsimp only [CommRingCat.coe_of, I_sh]
      rw [← Ideal.isRadical_iff_quotient_reduced,
        AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
      exact PrimeSpectrum.isRadical_vanishingIdeal _
    have : AlgebraicGeometry.IsReduced E_sch :=
      @AlgebraicGeometry.IsReduced.of_openCover E_sch I_sh.subschemeCover.openCover hPieceRed
    have : AlgebraicGeometry.IsIntegral E_sch :=
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced E_sch
    have hInt_appTop : ((ι_E ≫ p).appTop).hom.IsIntegral :=
      AlgebraicGeometry.isIntegral_appTop_of_universallyClosed (ι_E ≫ p)
    let β_E : K' →+* ↑(E_sch.presheaf.obj (Opposite.op ⊤)) :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫ (ι_E ≫ p).appTop).hom
    have hβ_int : β_E.IsIntegral := by
      intro a
      obtain ⟨P, hP_monic, hP_eval⟩ := hInt_appTop a
      let φ_hom : ↑((AlgebraicGeometry.Spec (CommRingCat.of K')).presheaf.obj (Opposite.op ⊤)) →+* K' :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).hom).hom
      refine ⟨P.map φ_hom, hP_monic.map φ_hom, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp_id : β_E.comp φ_hom = ((ι_E ≫ p).appTop).hom := by
        have h1 : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).hom ≫
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫ (ι_E ≫ p).appTop) =
            (ι_E ≫ p).appTop := by simp
        exact congrArg CommRingCat.Hom.hom h1
      rw [hcomp_id]
      exact hP_eval
    have hBij_β : Function.Bijective β_E :=
      IsAlgClosed.ringHom_bijective_of_isIntegral β_E hβ_int
    let e_β : K' ≃+* ↑(E_sch.presheaf.obj (Opposite.op ⊤)) :=
      RingEquiv.ofBijective β_E hBij_β
    have hTop_le : (⊤ : E_sch.Opens) ≤ (TopologicalSpace.Opens.map ι_E.base).obj W₀ := by
      intro z _
      apply hE_sub
      rw [← hRange_ιE]
      exact ⟨z, rfl⟩
    let ρ_E : ↑(X.presheaf.obj (Opposite.op W₀)) →+* ↑(E_sch.presheaf.obj (Opposite.op ⊤)) :=
      (ι_E.appLE W₀ ⊤ hTop_le).hom
    let ev_E : ↑(X.presheaf.obj (Opposite.op W₀)) →+* K' :=
      e_β.symm.toRingHom.comp ρ_E
    have hBasic_eq : ∀ f : ↑(X.presheaf.obj (Opposite.op W₀)),
        (TopologicalSpace.Opens.map ι_E.base).obj (X.basicOpen f) = E_sch.basicOpen (ρ_E f) := by
      intro f
      have hρ_def : ρ_E f =
          (E_sch.presheaf.map (CategoryTheory.homOfLE hTop_le).op).hom ((ι_E.app W₀).hom f) := rfl
      rw [hρ_def, E_sch.basicOpen_res, top_inf_eq, AlgebraicGeometry.Scheme.Hom.preimage_basicOpen]
    have hρ_ev : ∀ f : ↑(X.presheaf.obj (Opposite.op W₀)), ρ_E f = e_β (ev_E f) :=
      fun f => (e_β.apply_symm_apply (ρ_E f)).symm
    refine ⟨ev_E, ?_, ?_, ?_⟩
    · ext c
      have hcomp_top : p.appLE ⊤ W₀ (fun _ _ => trivial) ≫ ι_E.appLE W₀ ⊤ hTop_le =
          (ι_E ≫ p).appTop := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ι_E p ⊤ W₀ ⊤ (fun _ _ => trivial) hTop_le]
        exact (AlgebraicGeometry.Scheme.Hom.app_eq_appLE (ι_E ≫ p)).symm
      have hρ_ι : ρ_E (ιK_W₀ c) = e_β c := by
        change (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K')).inv ≫
          p.appLE ⊤ W₀ (fun _ _ => trivial)) ≫ ι_E.appLE W₀ ⊤ hTop_le).hom c = β_E c
        rw [CategoryTheory.Category.assoc, hcomp_top]
      change e_β.symm (ρ_E (ιK_W₀ c)) = c
      rw [hρ_ι, e_β.symm_apply_apply]
    · intro f hf0
      rw [Set.disjoint_left]
      intro x hxE hx_bf
      rw [← hRange_ιE] at hxE
      obtain ⟨z, rfl⟩ := hxE
      have hz_pre : z ∈ (TopologicalSpace.Opens.map ι_E.base).obj (X.basicOpen f) := hx_bf
      rw [hBasic_eq f, hρ_ev f, hf0, map_zero, E_sch.basicOpen_zero] at hz_pre
      exact hz_pre
    · intro f hf_ne x hxE
      rw [← hRange_ιE] at hxE
      obtain ⟨z, rfl⟩ := hxE
      have hu : IsUnit (ρ_E f) := by
        rw [hρ_ev f]
        exact (IsUnit.mk0 (ev_E f) hf_ne).map e_β.toRingHom
      have hz_top : z ∈ E_sch.basicOpen (ρ_E f) := by
        rw [E_sch.basicOpen_of_isUnit hu]
        trivial
      rw [← hBasic_eq f] at hz_top
      exact hz_top

theorem weil_sup1_etale_nodal_roof_branch_transversality_and_smooth (K' : Type u) [Field K'] [IsAlgClosed K']
    (R₁ : Type u) [CommRing R₁] [IsReduced R₁]
    (ιK : K' →+* R₁) (hFT : ιK.FiniteType)
    (I_E I_Y' : Ideal R₁) [I_E.IsPrime]
    (hRadY : I_Y'.IsRadical)
    (hInfBot : I_E ⊓ I_Y' = ⊥)
    (hNotSubY : ¬ (I_Y' ≤ I_E))
    (M_q : Ideal R₁) [M_q.IsPrime]
    (hIE_le : I_E ≤ M_q)
    (hIY_le : I_Y' ≤ M_q)
    (hNotSubE : ∃ P' : Ideal R₁, P'.IsPrime ∧ P' ≤ M_q ∧ ¬ (I_E ≤ P'))
    (D : Type u) [CommRing D]
    (n₀ : PrimeSpectrum D)
    (α₁ : R₁ →+* D)
    (α₂ : (MvPolynomial (Fin 2) K' ⧸ Ideal.span
      {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
        (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}) →+* D)
    (hEt₁ : α₁.Etale)
    (hEt₂ : α₂.Etale)
    (hcomap : Ideal.comap α₁ n₀.asIdeal = M_q)
    (hX : ∀ i : Fin 2,
      α₂ (Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K')) ∈ n₀.asIdeal)
    (hcomm : α₁.comp ιK =
      α₂.comp ((Ideal.Quotient.mk _).comp (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K'))) :
    M_q.IsMaximal ∧
    (∀ m ∈ M_q, ∃ s : R₁, s ∉ M_q ∧ s * m ∈ I_E ⊔ I_Y') ∧
    ∃ (ev_q : R₁ ⧸ I_Y' →+* K'),
      ev_q.comp ((Ideal.Quotient.mk I_Y').comp ιK) = RingHom.id K' ∧
      RingHom.ker (ev_q.comp (Ideal.Quotient.mk I_Y')) = M_q ∧
      ∃ V_q : (AlgebraicGeometry.Spec (CommRingCat.of (R₁ ⧸ I_Y'))).Opens,
        (⟨RingHom.ker ev_q, RingHom.ker_isPrime ev_q⟩ : PrimeSpectrum (R₁ ⧸ I_Y')) ∈ V_q ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V_q.ι ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk I_Y').comp ιK))) :=
by
  
  have hQuotEtale :
      ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
        (φ : A →+* B) (π : A →+* C),
        φ.Etale →
        Function.Surjective π →
        ∀ (J : Ideal B),
          Ideal.map φ (RingHom.ker π) = J →
          ∃ ψ : C →+* (B ⧸ J),
            ψ.Etale ∧ ∀ a : A, ψ (π a) = Ideal.Quotient.mk J (φ a) := by
    intro A B C _ _ _ φ π hφ hπ J hJ
    let : Algebra A B := φ.toAlgebra
    have : Algebra.Etale A B := RingHom.etale_algebraMap.mp hφ
    let I_A : Ideal A := RingHom.ker π
    let e_C : (A ⧸ I_A) ≃+* C := RingHom.quotientKerEquivOfSurjective hπ
    have : Algebra.Etale (A ⧸ I_A) (TensorProduct A (A ⧸ I_A) B) :=
      Algebra.Etale.baseChange A B (A ⧸ I_A)
    have hJ_alg : Ideal.map (algebraMap A B) I_A = J := hJ
    let e_B : TensorProduct A (A ⧸ I_A) B ≃+* (B ⧸ J) :=
      ((Algebra.TensorProduct.comm A (A ⧸ I_A) B).toRingEquiv.trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I_A).symm.toRingEquiv).trans
        (Ideal.quotEquivOfEq hJ_alg)
    let ψ : C →+* (B ⧸ J) :=
      e_B.toRingHom.comp
        ((algebraMap (A ⧸ I_A) (TensorProduct A (A ⧸ I_A) B)).comp e_C.symm.toRingHom)
    have hψ_et : ψ.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.of_bijective (f := e_C.symm.toRingHom) e_C.symm.bijective)
          (RingHom.etale_algebraMap.mpr inferInstance))
        (RingHom.Etale.of_bijective (f := e_B.toRingHom) e_B.bijective)
    refine ⟨ψ, hψ_et, fun a => ?_⟩
    have heC : e_C.symm (π a) = Ideal.Quotient.mk I_A a := by
      apply e_C.injective
      rw [e_C.apply_symm_apply]
      rfl
    change e_B (algebraMap (A ⧸ I_A) (TensorProduct A (A ⧸ I_A) B) (e_C.symm (π a))) =
      Ideal.Quotient.mk J (φ a)
    rw [heC]
    change Ideal.quotEquivOfEq hJ_alg
      ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I_A).symm
        ((1 : B) ⊗ₜ[A] Ideal.Quotient.mk I_A a)) = Ideal.Quotient.mk J (φ a)
    rw [Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul]
    have hsmul : a • (1 : B) = φ a := by
      rw [Algebra.smul_def, mul_one]; rfl
    rw [hsmul]
    rfl

  
  have hRedEtale :
      ∀ (R B : Type u) [CommRing R] [IsNoetherianRing R] [_root_.IsReduced R]
        [CommRing B] [Algebra R B] [Algebra.Etale R B], _root_.IsReduced B := by
    intro R B _ _ _ _ _ _
    let M : Type u := ↥(minimalPrimes R)
    have hFinM : Finite M := (minimalPrimes.finite_of_isNoetherianRing R).to_subtype
    let : Fintype M := Fintype.ofFinite M
    let : DecidableEq M := Classical.decEq M
    have : ∀ m : M, m.1.IsPrime := fun m => m.2.1.1
    let : ∀ m : M, IsDomain (R ⧸ m.1) := fun m => Ideal.Quotient.isDomain m.1
    let ι_R : R →ₗ[R] (∀ m : M, FractionRing (R ⧸ m.1)) :=
      LinearMap.pi (fun m : M => Algebra.linearMap R (FractionRing (R ⧸ m.1)))
    have hι_inj : Function.Injective ι_R := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      have hr_nil : r ∈ nilradical R := by
        rw [nilradical_eq_sInf R, Ideal.mem_sInf]
        intro P hP
        obtain ⟨q, hq_min, hq_le⟩ := @Ideal.exists_minimalPrimes_le R _ ⊥ P hP bot_le
        have hq_M : q ∈ minimalPrimes R := hq_min
        have hm0 : algebraMap R (FractionRing (R ⧸ q)) r = 0 := congrFun hr ⟨q, hq_M⟩
        rw [IsScalarTower.algebraMap_apply R (R ⧸ q) (FractionRing (R ⧸ q)) r] at hm0
        have h_mk : Ideal.Quotient.mk q r = 0 :=
          (injective_iff_map_eq_zero _).mp
            (IsFractionRing.injective (R ⧸ q) (FractionRing (R ⧸ q))) _ hm0
        exact hq_le (Ideal.Quotient.eq_zero_iff_mem.mp h_mk)
      exact IsNilpotent.eq_zero (mem_nilradical.mp hr_nil)
    have : Module.Flat R B := Algebra.Smooth.flat R B
    have hlT_inj : Function.Injective (LinearMap.lTensor B ι_R) :=
      Module.Flat.lTensor_preserves_injective_linearMap ι_R hι_inj
    let j_B : B →+* (∀ m : M, TensorProduct R B (FractionRing (R ⧸ m.1))) :=
      RingHom.pi (fun m : M =>
        (Algebra.TensorProduct.includeLeft :
          B →ₐ[R] TensorProduct R B (FractionRing (R ⧸ m.1))).toRingHom)
    have hj_eq : ∀ b : B,
        j_B b = TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
          (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b)) := by
      intro b
      ext m
      simp [j_B, ι_R, TensorProduct.piRight]
    have hj_inj : Function.Injective j_B := by
      intro b₁ b₂ h
      have h1 : TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
          (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b₁)) =
        TensorProduct.piRight R R B (fun m : M => FractionRing (R ⧸ m.1))
          (LinearMap.lTensor B ι_R ((TensorProduct.rid R B).symm b₂)) := by
        rw [← hj_eq b₁, ← hj_eq b₂, h]
      exact (TensorProduct.rid R B).symm.injective
        (hlT_inj ((TensorProduct.piRight R R B _).injective h1))
    have : ∀ m : M, _root_.IsReduced (TensorProduct R B (FractionRing (R ⧸ m.1))) := by
      intro m
      have : Algebra.Etale (FractionRing (R ⧸ m.1))
          (TensorProduct R (FractionRing (R ⧸ m.1)) B) :=
        Algebra.Etale.baseChange R B (FractionRing (R ⧸ m.1))
      have : _root_.IsReduced (TensorProduct R (FractionRing (R ⧸ m.1)) B) :=
        Algebra.FormallyUnramified.isReduced_of_field (FractionRing (R ⧸ m.1)) _
      exact isReduced_of_injective
        (Algebra.TensorProduct.comm R B (FractionRing (R ⧸ m.1))).toRingEquiv
        (Algebra.TensorProduct.comm R B (FractionRing (R ⧸ m.1))).injective
    exact isReduced_of_injective j_B hj_inj

  
  have hSmoothDescent :
      ∀ (S₀ : Type u) [CommRing S₀] [Algebra K' S₀] [Algebra.FinitePresentation K' S₀]
        (p : Ideal S₀) [p.IsPrime]
        (T₀ : Type u) [CommRing T₀] [Algebra K' T₀] [Algebra S₀ T₀]
        [IsScalarTower K' S₀ T₀] [Algebra.Etale S₀ T₀]
        (q : Ideal T₀) [q.IsPrime],
        p = Ideal.comap (algebraMap S₀ T₀) q →
        ∀ (φ_poly : Polynomial K' →+* T₀),
          φ_poly.Etale →
          φ_poly.comp Polynomial.C = algebraMap K' T₀ →
          ∃ f : S₀, f ∉ p ∧
            RingHom.IsStandardSmoothOfRelativeDimension 1
              (algebraMap K' (Localization.Away f)) := by
    intro S₀ _ _ _ p _ T₀ _ _ _ _ _ q _ hpq φ_poly hφ_et hφ_comp
    have hT₀_poly : Algebra.FormallySmooth K' T₀ ∧ Nonempty (Ω[T₀ ⁄ K'] ≃ₗ[T₀] T₀) := by
      let : Algebra (Polynomial K') T₀ := φ_poly.toAlgebra
      have : IsScalarTower K' (Polynomial K') T₀ :=
        IsScalarTower.of_algebraMap_eq' hφ_comp.symm
      have : Algebra.Etale (Polynomial K') T₀ := hφ_et
      have hFS : Algebra.FormallySmooth K' T₀ :=
        Algebra.FormallySmooth.comp K' (Polynomial K') T₀
      let e1 := (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' (Polynomial K') T₀).symm
      let e2 := LinearEquiv.baseChange (Polynomial K') T₀ Ω[Polynomial K' ⁄ K'] (Polynomial K')
        (KaehlerDifferential.polynomialEquiv K')
      let e3 := TensorProduct.AlgebraTensorModule.rid (Polynomial K') T₀ T₀
      exact ⟨hFS, ⟨(e1.trans e2).trans e3⟩⟩
    have hFS_T₀ : Algebra.FormallySmooth K' T₀ := hT₀_poly.1
    have hSub_T₀ : Subsingleton (Algebra.H1Cotangent K' T₀) :=
      Algebra.FormallySmooth.subsingleton_h1Cotangent
    obtain ⟨e_ΩT₀⟩ := hT₀_poly.2
    have hKaehler_Sp : Module.Projective (Localization.AtPrime p) Ω[Localization.AtPrime p ⁄ K'] ∧
        Module.rank (Localization.AtPrime p) Ω[Localization.AtPrime p ⁄ K'] = 1 := by
      let S_p : Type u := Localization.AtPrime p
      let T_q : Type u := Localization.AtPrime q
      let ψ_loc : S_p →+* T_q := Localization.localRingHom p q (algebraMap S₀ T₀) hpq
      have h_loc_eq : ψ_loc.comp (algebraMap S₀ S_p) = algebraMap S₀ T_q :=
        RingHom.ext fun x => by
          rw [RingHom.comp_apply, Localization.localRingHom_to_map,
            IsScalarTower.algebraMap_apply S₀ T₀ T_q]
      let : Algebra S_p T_q := ψ_loc.toAlgebra
      have : IsScalarTower S₀ S_p T_q := IsScalarTower.of_algebraMap_eq' h_loc_eq.symm
      have : IsScalarTower K' S_p T_q := by
        apply IsScalarTower.of_algebraMap_eq'
        rw [IsScalarTower.algebraMap_eq K' S₀ T_q, ← h_loc_eq, RingHom.comp_assoc,
          ← IsScalarTower.algebraMap_eq K' S₀ S_p]
        rfl
      have hFlat_S₀T₀ : (algebraMap S₀ T₀).Flat :=
        RingHom.flat_algebraMap_iff.mpr (Algebra.Smooth.flat S₀ T₀)
      have : Module.Flat S_p T_q := RingHom.Flat.localRingHom hFlat_S₀T₀ q p hpq
      have : IsLocalHom (algebraMap S_p T_q) :=
        Localization.isLocalHom_localRingHom p q (algebraMap S₀ T₀) hpq
      have : Module.FaithfullyFlat S_p T_q := Module.FaithfullyFlat.of_flat_of_isLocalHom
      have : Algebra.FormallyEtale S₀ S_p := Algebra.FormallyEtale.of_isLocalization p.primeCompl
      have : Algebra.FormallyEtale T₀ T_q := Algebra.FormallyEtale.of_isLocalization q.primeCompl
      have : Algebra.FormallyEtale S₀ T_q := Algebra.FormallyEtale.comp S₀ T₀ T_q
      have : Algebra.FormallyEtale S_p T_q := Algebra.FormallyEtale.localization_base p.primeCompl
      let e_stalk : TensorProduct S_p T_q Ω[S_p ⁄ K'] ≃ₗ[T_q] T_q :=
        (((KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' S_p T_q).trans
          (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' T₀ T_q).symm).trans
          (LinearEquiv.baseChange T₀ T_q Ω[T₀ ⁄ K'] T₀ e_ΩT₀)).trans
          (TensorProduct.AlgebraTensorModule.rid T₀ T_q T_q)
      have : Module.Flat T_q (TensorProduct S_p T_q Ω[S_p ⁄ K']) :=
        Module.Flat.of_linearEquiv e_stalk
      have : Module.Flat S_p Ω[S_p ⁄ K'] :=
        Module.Flat.of_flat_tensorProduct S_p Ω[S_p ⁄ K'] T_q
      have : Module.Finite S₀ Ω[S₀ ⁄ K'] := KaehlerDifferential.finite K' S₀
      have : Module.Finite S_p Ω[S_p ⁄ K'] :=
        Module.Finite.equiv (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' S₀ S_p)
      have : Module.Free S_p Ω[S_p ⁄ K'] := Module.free_of_flat_of_isLocalRing
      refine ⟨inferInstance, ?_⟩
      have hbc := Module.rank_baseChange (R := T_q) (S := S_p) (M' := Ω[S_p ⁄ K'])
      rw [Cardinal.lift_id] at hbc
      rw [← hbc, e_stalk.rank_eq, Module.rank_self T_q]
    have h_ext_H1 : ∀ (E : Algebra.Extension K' S₀) [Algebra.FormallySmooth K' E.Ring],
        Function.Surjective (algebraMap E.Ring S₀) →
        Subsingleton (TensorProduct S₀ T₀ E.H1Cotangent) := by
      intro E _ hπ₀_surj
      have hStd0 : Algebra.IsStandardSmoothOfRelativeDimension 0 S₀ T₀ :=
        Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
      obtain ⟨ι, σ, hFinσ, hFinι, Q, hQdim⟩ := hStd0.out
      let : Finite σ := hFinσ
      let : Finite ι := hFinι
      let : Fintype σ := Fintype.ofFinite σ
      let : DecidableEq σ := Classical.decEq σ
      let : DecidableEq ι := Classical.decEq ι
      have hCard_le : Nat.card σ ≤ Nat.card ι :=
        Nat.card_le_card_of_injective Q.map Q.map_inj
      have hCard_eq : Nat.card ι = Nat.card σ := by
        have h0 : Nat.card ι - Nat.card σ = 0 := hQdim
        omega
      have hMap_surj : Function.Surjective (MvPolynomial.map (algebraMap E.Ring S₀) :
          MvPolynomial ι E.Ring →+* MvPolynomial ι S₀) :=
        MvPolynomial.map_surjective (algebraMap E.Ring S₀) hπ₀_surj
      choose g_tilde hg_tilde using fun s : σ => hMap_surj (Q.relation s)
      let I_g : Ideal (MvPolynomial ι E.Ring) := Ideal.span (Set.range g_tilde)
      let q_A₀ : MvPolynomial ι E.Ring →ₐ[E.Ring] (MvPolynomial ι E.Ring ⧸ I_g) :=
        Ideal.Quotient.mkₐ E.Ring I_g
      let M_tilde : Matrix σ σ (MvPolynomial ι E.Ring) :=
        Matrix.of fun a b => MvPolynomial.pderiv (Q.map a) (g_tilde b)
      let Δ₀ : MvPolynomial ι E.Ring := M_tilde.det
      let δ_tilde : MvPolynomial ι E.Ring ⧸ I_g := q_A₀ Δ₀
      let R' : Type u := Localization.Away δ_tilde
      have hEt_P₀R' : Algebra.Etale E.Ring R' := by
        let val' : ι ⊕ Unit → R' := Sum.elim
          (fun i => algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ (MvPolynomial.X i)))
          (fun _ => IsLocalization.Away.invSelf δ_tilde)
        have h_aeval_inl : ∀ F : MvPolynomial ι E.Ring,
            MvPolynomial.aeval val' (MvPolynomial.rename Sum.inl F) =
              algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) := by
          intro F
          rw [MvPolynomial.aeval_rename]
          have h_eq : (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R').comp q_A₀.toRingHom =
              (MvPolynomial.aeval (val' ∘ Sum.inl)).toRingHom := by
            apply MvPolynomial.ringHom_ext
            · intro p₀
              simp [← IsScalarTower.algebraMap_apply E.Ring (MvPolynomial ι E.Ring ⧸ I_g) R']
            · intro i
              simp [val']
          exact (DFunLike.congr_fun h_eq F).symm
        have h_val'_surj : Function.Surjective (MvPolynomial.aeval val' :
            MvPolynomial (ι ⊕ Unit) E.Ring →ₐ[E.Ring] R') := by
          intro z
          obtain ⟨k, a, hza⟩ := IsLocalization.Away.surj δ_tilde z
          obtain ⟨F, rfl⟩ : ∃ F : MvPolynomial ι E.Ring, q_A₀ F = a :=
            Ideal.Quotient.mk_surjective a
          refine ⟨MvPolynomial.rename Sum.inl F * (MvPolynomial.X (Sum.inr ())) ^ k, ?_⟩
          rw [map_mul, map_pow, h_aeval_inl, MvPolynomial.aeval_X]
          simp only [val', Sum.elim_inr]
          have hinv : algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde *
              IsLocalization.Away.invSelf δ_tilde = 1 :=
            IsLocalization.Away.mul_invSelf δ_tilde
          have hpow : (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde) ^ k *
              (IsLocalization.Away.invSelf δ_tilde) ^ k = 1 := by
            rw [← mul_pow, hinv, one_pow]
          calc
            algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) *
                IsLocalization.Away.invSelf δ_tilde ^ k
              = z * algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
                  IsLocalization.Away.invSelf δ_tilde ^ k := by
                rw [hza]
            _ = z * (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
                  IsLocalization.Away.invSelf δ_tilde ^ k) := by
                ring
            _ = z := by rw [hpow, mul_one]
        let G_R' : Algebra.Generators E.Ring R' (ι ⊕ Unit) :=
          Algebra.Generators.ofSurjective val' h_val'_surj
        let rel' : σ ⊕ Unit → MvPolynomial (ι ⊕ Unit) E.Ring := Sum.elim
          (fun s => MvPolynomial.rename Sum.inl (g_tilde s))
          (fun _ => MvPolynomial.rename Sum.inl Δ₀ * MvPolynomial.X (Sum.inr ()) - 1)
        have h_rel'_ker : Ideal.span (Set.range rel') = G_R'.ker := by
          let I_rel' : Ideal (MvPolynomial (ι ⊕ Unit) E.Ring) := Ideal.span (Set.range rel')
          have h_le : I_rel' ≤ RingHom.ker (MvPolynomial.aeval val').toRingHom := by
            rw [Ideal.span_le]
            rintro _ ⟨x, rfl⟩
            cases x with
            | inl s =>
              simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe,
                AlgHom.coe_toRingHom, rel', Sum.elim_inl, h_aeval_inl]
              have hmem : g_tilde s ∈ I_g := Ideal.subset_span ⟨s, rfl⟩
              have hq0 : q_A₀ (g_tilde s) = 0 :=
                (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
              rw [hq0, map_zero]
            | inr u =>
              simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe,
                AlgHom.coe_toRingHom, rel', Sum.elim_inr, map_sub, map_mul, map_one,
                h_aeval_inl, MvPolynomial.aeval_X, val']
              change algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde *
                IsLocalization.Away.invSelf δ_tilde - 1 = 0
              rw [IsLocalization.Away.mul_invSelf δ_tilde, sub_self]
          apply le_antisymm h_le
          let Q_quot := MvPolynomial (ι ⊕ Unit) E.Ring ⧸ I_rel'
          let mk_rel' : MvPolynomial (ι ⊕ Unit) E.Ring →ₐ[E.Ring] Q_quot :=
            Ideal.Quotient.mkₐ E.Ring I_rel'
          let Φ_fwd : Q_quot →ₐ[E.Ring] R' := Ideal.Quotient.liftₐ I_rel' (MvPolynomial.aeval val')
            (fun f hf => h_le hf)
          let φ_inl : MvPolynomial ι E.Ring →ₐ[E.Ring] Q_quot :=
            mk_rel'.comp (MvPolynomial.rename Sum.inl)
          have h_φ_inl_ker : ∀ f ∈ I_g, φ_inl f = 0 := by
            have hsub : I_g ≤ RingHom.ker φ_inl.toRingHom := by
              rw [Ideal.span_le]
              rintro _ ⟨s, rfl⟩
              change Ideal.Quotient.mk I_rel' (rel' (Sum.inl s)) = 0
              exact (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span ⟨Sum.inl s, rfl⟩)
            exact fun f hf => hsub hf
          let ψ₀ : (MvPolynomial ι E.Ring ⧸ I_g) →ₐ[E.Ring] Q_quot :=
            Ideal.Quotient.liftₐ I_g φ_inl h_φ_inl_ker
          have h_δ_mul : ψ₀ δ_tilde * mk_rel' (MvPolynomial.X (Sum.inr ())) = 1 := by
            have hmem : rel' (Sum.inr ()) ∈ I_rel' := Ideal.subset_span ⟨Sum.inr (), rfl⟩
            have h0 : mk_rel' (rel' (Sum.inr ())) = 0 :=
              (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
            simp only [rel', Sum.elim_inr, map_sub, map_mul, map_one] at h0
            exact sub_eq_zero.mp h0
          have h_δ_unit : IsUnit (ψ₀.toRingHom δ_tilde) :=
            ⟨⟨ψ₀ δ_tilde, mk_rel' (MvPolynomial.X (Sum.inr ())), h_δ_mul,
              by rw [mul_comm]; exact h_δ_mul⟩, rfl⟩
          let Φ_inv : R' →+* Q_quot := IsLocalization.Away.lift δ_tilde h_δ_unit
          have h_left_inv : Φ_inv.comp Φ_fwd.toRingHom = RingHom.id Q_quot := by
            apply Ideal.Quotient.ringHom_ext
            apply MvPolynomial.ringHom_ext
            · intro p₀
              change Φ_inv (Φ_fwd (mk_rel' (MvPolynomial.C p₀))) = mk_rel' (MvPolynomial.C p₀)
              have h1 : Φ_fwd (mk_rel' (MvPolynomial.C p₀)) = algebraMap E.Ring R' p₀ := by
                change (MvPolynomial.aeval val') (MvPolynomial.C p₀) = algebraMap E.Ring R' p₀
                exact MvPolynomial.aeval_C val' p₀
              rw [h1, IsScalarTower.algebraMap_apply E.Ring (MvPolynomial ι E.Ring ⧸ I_g) R' p₀,
                IsLocalization.Away.lift_eq δ_tilde h_δ_unit]
              change ψ₀ (algebraMap E.Ring (MvPolynomial ι E.Ring ⧸ I_g) p₀) = _
              rw [ψ₀.commutes]
              rfl
            · intro x
              change Φ_inv (Φ_fwd (mk_rel' (MvPolynomial.X x))) = mk_rel' (MvPolynomial.X x)
              cases x with
              | inl i =>
                have h1 : Φ_fwd (mk_rel' (MvPolynomial.X (Sum.inl i))) =
                    algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ (MvPolynomial.X i)) := by
                  change (MvPolynomial.aeval val') (MvPolynomial.X (Sum.inl i)) = _
                  rw [MvPolynomial.aeval_X]
                  rfl
                rw [h1, IsLocalization.Away.lift_eq δ_tilde h_δ_unit]
                change mk_rel' (MvPolynomial.rename Sum.inl (MvPolynomial.X i)) = _
                rw [MvPolynomial.rename_X]
              | inr u =>
                cases u
                have h1 : Φ_fwd (mk_rel' (MvPolynomial.X (Sum.inr ()))) =
                    IsLocalization.Away.invSelf δ_tilde := by
                  change (MvPolynomial.aeval val') (MvPolynomial.X (Sum.inr ())) = _
                  rw [MvPolynomial.aeval_X]
                  rfl
                rw [h1]
                have h_inv_mul : ψ₀ δ_tilde * Φ_inv (IsLocalization.Away.invSelf δ_tilde) = 1 := by
                  have h2 : ψ₀ δ_tilde =
                      Φ_inv (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde) :=
                    (IsLocalization.Away.lift_eq δ_tilde h_δ_unit δ_tilde).symm
                  rw [h2, ← map_mul, IsLocalization.Away.mul_invSelf δ_tilde, map_one]
                calc
                  Φ_inv (IsLocalization.Away.invSelf δ_tilde)
                    = Φ_inv (IsLocalization.Away.invSelf δ_tilde) *
                        (ψ₀ δ_tilde * mk_rel' (MvPolynomial.X (Sum.inr ()))) := by
                      rw [h_δ_mul, mul_one]
                  _ = (ψ₀ δ_tilde * Φ_inv (IsLocalization.Away.invSelf δ_tilde)) *
                        mk_rel' (MvPolynomial.X (Sum.inr ())) := by ring
                  _ = mk_rel' (MvPolynomial.X (Sum.inr ())) := by rw [h_inv_mul, one_mul]
          intro f hf
          have hmk : Φ_fwd (mk_rel' f) = 0 := hf
          have h2 : Φ_inv (Φ_fwd (mk_rel' f)) = 0 := by rw [hmk, map_zero]
          have h3 : mk_rel' f = 0 := by
            simpa using (DFunLike.congr_fun h_left_inv (mk_rel' f)).symm.trans h2
          exact (Ideal.Quotient.eq_zero_iff_mem).mp h3
        let pres_R' : Algebra.Presentation E.Ring R' (ι ⊕ Unit) (σ ⊕ Unit) :=
          Algebra.Presentation.mk G_R' rel' h_rel'_ker
        have h_map'_inj : Function.Injective (Sum.map Q.map (@id Unit)) :=
          Q.map_inj.sumMap Function.injective_id
        let pre_R' : Algebra.PreSubmersivePresentation E.Ring R' (ι ⊕ Unit) (σ ⊕ Unit) :=
          Algebra.PreSubmersivePresentation.mk pres_R' (Sum.map Q.map (@id Unit)) h_map'_inj
        have h_jac_unit : IsUnit pre_R'.jacobian := by
          let : Fintype (σ ⊕ Unit) := inferInstance
          let : DecidableEq (σ ⊕ Unit) := inferInstance
          rw [pre_R'.jacobian_eq_jacobiMatrix_det]
          have h_notMem : ∀ F : MvPolynomial ι E.Ring,
              (Sum.inr () : ι ⊕ Unit) ∉ (MvPolynomial.rename Sum.inl F).vars := by
            intro F hmem
            have hsub := MvPolynomial.vars_rename Sum.inl F hmem
            simp at hsub
          let B₁₁ : Matrix σ σ (MvPolynomial (ι ⊕ Unit) E.Ring) :=
            (MvPolynomial.rename Sum.inl).toRingHom.mapMatrix M_tilde
          let B₁₂ : Matrix σ Unit (MvPolynomial (ι ⊕ Unit) E.Ring) :=
            Matrix.of fun a _ => pre_R'.jacobiMatrix (Sum.inl a) (Sum.inr ())
          let B₂₂ : Matrix Unit Unit (MvPolynomial (ι ⊕ Unit) E.Ring) :=
            Matrix.of fun _ _ => MvPolynomial.rename Sum.inl Δ₀
          have h_mat_eq : pre_R'.jacobiMatrix = Matrix.fromBlocks B₁₁ B₁₂ 0 B₂₂ := by
            refine Matrix.ext fun x y => ?_
            cases x with
            | inl a =>
              cases y with
              | inl b =>
                rw [pre_R'.jacobiMatrix_apply]
                exact MvPolynomial.pderiv_rename Sum.inl_injective (Q.map a) (g_tilde b)
              | inr u => rfl
            | inr u =>
              cases u
              cases y with
              | inl b =>
                rw [pre_R'.jacobiMatrix_apply]
                exact MvPolynomial.pderiv_eq_zero_of_notMem_vars (h_notMem (g_tilde b))
              | inr v =>
                cases v
                rw [pre_R'.jacobiMatrix_apply]
                change MvPolynomial.pderiv (Sum.inr ())
                  (MvPolynomial.rename Sum.inl Δ₀ * MvPolynomial.X (Sum.inr ()) - 1) =
                  MvPolynomial.rename Sum.inl Δ₀
                rw [map_sub, Derivation.map_one_eq_zero, MvPolynomial.pderiv_mul,
                  MvPolynomial.pderiv_X_self,
                  MvPolynomial.pderiv_eq_zero_of_notMem_vars (h_notMem Δ₀)]
                ring
          rw [h_mat_eq, Matrix.det_fromBlocks_zero₂₁]
          have hdet1 : B₁₁.det = MvPolynomial.rename Sum.inl Δ₀ := by
            dsimp [B₁₁, Δ₀]
            exact (RingHom.map_det (MvPolynomial.rename Sum.inl).toRingHom M_tilde).symm
          have hdet2 : B₂₂.det = MvPolynomial.rename Sum.inl Δ₀ := by
            rw [Matrix.det_unique]
            rfl
          rw [hdet1, hdet2]
          change IsUnit (MvPolynomial.aeval val'
            (MvPolynomial.rename Sum.inl Δ₀ * MvPolynomial.rename Sum.inl Δ₀))
          rw [map_mul, h_aeval_inl]
          exact (IsLocalization.Away.algebraMap_isUnit δ_tilde).mul
            (IsLocalization.Away.algebraMap_isUnit δ_tilde)
        let sub_R' : Algebra.SubmersivePresentation E.Ring R' (ι ⊕ Unit) (σ ⊕ Unit) :=
          Algebra.SubmersivePresentation.mk pre_R' h_jac_unit
        have h_dim_R' : sub_R'.dimension = 0 := by
          change Nat.card (ι ⊕ Unit) - Nat.card (σ ⊕ Unit) = 0
          rw [Nat.card_sum, Nat.card_sum, hCard_eq, Nat.sub_self]
        have : Algebra.IsStandardSmoothOfRelativeDimension 0 E.Ring R' :=
          sub_R'.isStandardSmoothOfRelativeDimension h_dim_R'
        exact Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr inferInstance
      have : Module.Flat E.Ring R' := Algebra.Smooth.flat E.Ring R'
      have : Algebra.FormallyEtale E.Ring R' := inferInstance
      have : Algebra.FormallySmooth K' R' := Algebra.FormallySmooth.comp K' E.Ring R'
      let ev_T₀ : MvPolynomial ι E.Ring →+* T₀ :=
        (MvPolynomial.aeval Q.val).toRingHom.comp (MvPolynomial.map (algebraMap E.Ring S₀))
      have h_ev_ker : ∀ f ∈ I_g, ev_T₀ f = 0 := by
        have hsub : I_g ≤ RingHom.ker ev_T₀ := by
          rw [Ideal.span_le]
          rintro _ ⟨s, rfl⟩
          simp only [SetLike.mem_coe, RingHom.mem_ker, ev_T₀, RingHom.comp_apply, hg_tilde]
          have hmem : Q.relation s ∈ Q.ker := by
            rw [← Q.span_range_relation_eq_ker]
            exact Ideal.subset_span ⟨s, rfl⟩
          have h0 : (algebraMap Q.Ring T₀) (Q.relation s) = 0 := hmem
          rwa [Q.algebraMap_apply] at h0
        exact fun f hf => hsub hf
      let ψ_A₀ : (MvPolynomial ι E.Ring ⧸ I_g) →+* T₀ := Ideal.Quotient.lift I_g ev_T₀ h_ev_ker
      have h_ψ_δ_eq : ψ_A₀ δ_tilde = Q.jacobian := by
        rw [Q.jacobian_eq_jacobiMatrix_det, Q.algebraMap_apply]
        change (MvPolynomial.aeval Q.val) (MvPolynomial.map (algebraMap E.Ring S₀) M_tilde.det) =
          (MvPolynomial.aeval Q.val) Q.jacobiMatrix.det
        congr 1
        rw [RingHom.map_det]
        congr 1
        refine Matrix.ext fun a b => ?_
        simp only [RingHom.mapMatrix_apply, Matrix.map_apply, M_tilde, Matrix.of_apply,
          Q.jacobiMatrix_apply, ← hg_tilde]
        exact (MvPolynomial.pderiv_map).symm
      have h_ψ_δ_unit : IsUnit (ψ_A₀ δ_tilde) := h_ψ_δ_eq ▸ Q.jacobian_isUnit
      let ψ_R'_hom : R' →+* T₀ := IsLocalization.Away.lift δ_tilde h_ψ_δ_unit
      have h_ψ_P₀ : ∀ p₀ : E.Ring, ψ_R'_hom (algebraMap E.Ring R' p₀) =
          algebraMap S₀ T₀ (algebraMap E.Ring S₀ p₀) := by
        intro p₀
        rw [IsScalarTower.algebraMap_apply E.Ring (MvPolynomial ι E.Ring ⧸ I_g) R' p₀,
          IsLocalization.Away.lift_eq δ_tilde h_ψ_δ_unit, ← q_A₀.commutes p₀]
        change (MvPolynomial.aeval Q.val)
          (MvPolynomial.map (algebraMap E.Ring S₀) (MvPolynomial.C p₀)) = _
        rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
      let ψ_R' : R' →ₐ[K'] T₀ :=
        { ψ_R'_hom with
          commutes' := fun c => by
            change ψ_R'_hom (algebraMap K' R' c) = algebraMap K' T₀ c
            rw [IsScalarTower.algebraMap_apply K' E.Ring R' c, h_ψ_P₀,
              ← IsScalarTower.algebraMap_apply K' E.Ring S₀,
              ← IsScalarTower.algebraMap_apply K' S₀ T₀] }
      have h_ψ_surj : Function.Surjective ψ_R' := by
        intro t
        obtain ⟨F_S, hFS⟩ := Q.algebraMap_surjective t
        rw [Q.algebraMap_apply] at hFS
        obtain ⟨F_P, hFP⟩ := hMap_surj F_S
        refine ⟨algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F_P), ?_⟩
        change ψ_R'_hom (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F_P)) = t
        rw [IsLocalization.Away.lift_eq δ_tilde h_ψ_δ_unit]
        change (MvPolynomial.aeval Q.val) (MvPolynomial.map (algebraMap E.Ring S₀) F_P) = t
        rw [hFP]
        exact hFS
      have h_ker_R' : RingHom.ker ψ_R'_hom = Ideal.map (algebraMap E.Ring R') E.ker := by
        apply le_antisymm
        · intro z hz
          have hz0 : ψ_R'_hom z = 0 := hz
          obtain ⟨k, a, hza⟩ := IsLocalization.Away.surj δ_tilde z
          obtain ⟨F, rfl⟩ : ∃ F : MvPolynomial ι E.Ring, q_A₀ F = a :=
            Ideal.Quotient.mk_surjective a
          have h_evF : ev_T₀ F = 0 := by
            have h1 : ψ_R'_hom (z * algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k) =
                ψ_R'_hom (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F)) :=
              congrArg ψ_R'_hom hza
            rw [map_mul, hz0, zero_mul, IsLocalization.Away.lift_eq δ_tilde h_ψ_δ_unit] at h1
            exact h1.symm
          have h_in_Qker : MvPolynomial.map (algebraMap E.Ring S₀) F ∈ Q.ker := by
            change (algebraMap Q.Ring T₀) (MvPolynomial.map (algebraMap E.Ring S₀) F) = 0
            rw [Q.algebraMap_apply]
            exact h_evF
          rw [← Q.span_range_relation_eq_ker] at h_in_Qker
          have h_range : Set.range Q.relation =
              MvPolynomial.map (algebraMap E.Ring S₀) '' Set.range g_tilde := by
            ext h
            simp only [Set.mem_range, Set.mem_image]
            constructor
            · rintro ⟨s, rfl⟩
              exact ⟨g_tilde s, ⟨s, rfl⟩, hg_tilde s⟩
            · rintro ⟨_, ⟨s, rfl⟩, rfl⟩
              exact ⟨s, (hg_tilde s).symm⟩
          rw [h_range, ← Ideal.map_span] at h_in_Qker
          obtain ⟨G, hG_mem, hGF⟩ :=
            Ideal.mem_image_of_mem_map_of_surjective _ hMap_surj h_in_Qker
          have h_diff : F - G ∈ RingHom.ker (MvPolynomial.map (algebraMap E.Ring S₀)) := by
            rw [RingHom.mem_ker, map_sub, hGF, sub_self]
          rw [MvPolynomial.ker_map] at h_diff
          change F - G ∈ Ideal.map MvPolynomial.C E.ker at h_diff
          have h_qFG : q_A₀ (F - G) ∈
              Ideal.map (algebraMap E.Ring (MvPolynomial ι E.Ring ⧸ I_g)) E.ker := by
            have h1 : q_A₀ (F - G) ∈ Ideal.map q_A₀.toRingHom (Ideal.map MvPolynomial.C E.ker) :=
              Ideal.mem_map_of_mem q_A₀.toRingHom h_diff
            rw [Ideal.map_map] at h1
            have hcomp : q_A₀.toRingHom.comp MvPolynomial.C =
                algebraMap E.Ring (MvPolynomial ι E.Ring ⧸ I_g) := by
              ext p₀
              exact q_A₀.commutes p₀
            rwa [hcomp] at h1
          have h_qG : q_A₀ G = 0 := (Ideal.Quotient.eq_zero_iff_mem).mpr hG_mem
          rw [map_sub, h_qG, sub_zero] at h_qFG
          have h_in_R' : algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) ∈
              Ideal.map (algebraMap E.Ring R') E.ker := by
            have h2 := Ideal.mem_map_of_mem (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R') h_qFG
            rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq E.Ring _ R'] at h2
            exact h2
          have hz_eq : z = algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) *
              (IsLocalization.Away.invSelf δ_tilde) ^ k := by
            have hinv : algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
                (IsLocalization.Away.invSelf δ_tilde) ^ k = 1 := by
              rw [← mul_pow, IsLocalization.Away.mul_invSelf δ_tilde, one_pow]
            calc
              z = z * (algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k *
                    (IsLocalization.Away.invSelf δ_tilde) ^ k) := by
                rw [hinv, mul_one]
              _ = (z * algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' δ_tilde ^ k) *
                    (IsLocalization.Away.invSelf δ_tilde) ^ k := by
                ring
              _ = algebraMap (MvPolynomial ι E.Ring ⧸ I_g) R' (q_A₀ F) *
                    (IsLocalization.Away.invSelf δ_tilde) ^ k := by
                rw [hza]
          rw [hz_eq]
          exact Ideal.mul_mem_right _ _ h_in_R'
        · rw [Ideal.map_le_iff_le_comap]
          intro j hj
          have hj0 : algebraMap E.Ring S₀ j = 0 := hj
          simp only [Ideal.mem_comap, RingHom.mem_ker]
          rw [h_ψ_P₀, hj0, map_zero]
      let P' : Algebra.Extension K' T₀ := Algebra.Extension.ofSurjective ψ_R' h_ψ_surj
      let : Algebra E.Ring P'.Ring := (inferInstance : Algebra E.Ring R')
      have : Module.Flat E.Ring P'.Ring := (inferInstance : Module.Flat E.Ring R')
      let f_ext : E.Hom P' :=
        Algebra.Extension.Hom.mk (algebraMap E.Ring P'.Ring)
          (fun c => (IsScalarTower.algebraMap_apply K' E.Ring R' c).symm)
          (fun p₀ => h_ψ_P₀ p₀)
      have h_ker_bij : Function.Bijective
          (LinearMap.liftBaseChange P'.Ring (f_ext.mapKer rfl)) := by
        let L_ker : TensorProduct E.Ring P'.Ring ↥E.ker →ₗ[P'.Ring] ↥P'.ker :=
          LinearMap.liftBaseChange P'.Ring (f_ext.mapKer rfl)
        let sub_P' : ↥P'.ker →ₗ[E.Ring] P'.Ring := P'.ker.subtype.restrictScalars E.Ring
        have h_comp : sub_P' ∘ₗ (L_ker.restrictScalars E.Ring) =
            ((TensorProduct.AlgebraTensorModule.rid E.Ring P'.Ring P'.Ring).toLinearMap.restrictScalars E.Ring) ∘ₗ
              LinearMap.lTensor P'.Ring E.ker.subtype := by
          apply TensorProduct.ext'
          intro r' x
          simp only [L_ker, sub_P', LinearMap.comp_apply, LinearMap.coe_restrictScalars,
            LinearMap.liftBaseChange_tmul, Submodule.coe_subtype, SetLike.val_smul,
            smul_eq_mul, LinearEquiv.coe_toLinearMap, LinearMap.lTensor_tmul,
            TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def]
          exact mul_comm _ _
        have h_inj : Function.Injective L_ker := by
          change Function.Injective (L_ker.restrictScalars E.Ring)
          apply Function.Injective.of_comp (f := sub_P')
          change Function.Injective ⇑(sub_P' ∘ₗ L_ker.restrictScalars E.Ring)
          rw [h_comp]
          exact (TensorProduct.AlgebraTensorModule.rid E.Ring P'.Ring P'.Ring).injective.comp
            (Module.Flat.lTensor_preserves_injective_linearMap E.ker.subtype Subtype.val_injective)
        refine ⟨h_inj, ?_⟩
        intro y
        have hy : y.1 ∈ Ideal.map (algebraMap E.Ring P'.Ring) E.ker := by
          have hy_ker : (y.1 : R') ∈ RingHom.ker ψ_R'_hom := y.2
          exact h_ker_R' ▸ hy_ker
        rw [Ideal.map] at hy
        have hex : ∃ u : TensorProduct E.Ring P'.Ring ↥E.ker, (L_ker u).1 = y.1 := by
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
          · rintro _ ⟨j, hj, rfl⟩
            refine ⟨(1 : P'.Ring) ⊗ₜ[E.Ring] (⟨j, hj⟩ : ↥E.ker), ?_⟩
            have h1 := LinearMap.congr_fun h_comp ((1 : P'.Ring) ⊗ₜ[E.Ring] ⟨j, hj⟩)
            simpa [sub_P', Algebra.smul_def] using h1
          · exact ⟨0, by simp⟩
          · rintro x₁ x₂ _ _ ⟨u₁, hu₁⟩ ⟨u₂, hu₂⟩
            exact ⟨u₁ + u₂, by simp [hu₁, hu₂]⟩
          · rintro r' x₁ _ ⟨u₁, hu₁⟩
            refine ⟨r' • u₁, ?_⟩
            rw [map_smul]
            exact congrArg (r' * ·) hu₁
        obtain ⟨u, hu⟩ := hex
        exact ⟨u, Subtype.ext hu⟩
      let e_cot : TensorProduct S₀ T₀ E.Cotangent ≃ₗ[T₀] P'.Cotangent :=
        Algebra.Extension.tensorCotangent f_ext rfl h_ker_bij
      let : Algebra E.Ring T₀ := ((algebraMap S₀ T₀).comp (algebraMap E.Ring S₀)).toAlgebra
      have : IsScalarTower E.Ring S₀ T₀ := IsScalarTower.of_algebraMap_eq' rfl
      let : Algebra R' T₀ := P'.algebra₂
      have : IsScalarTower E.Ring R' T₀ :=
        IsScalarTower.of_algebraMap_eq' (RingHom.ext fun p₀ => (h_ψ_P₀ p₀).symm)
      let e_sp1 : TensorProduct S₀ T₀ (TensorProduct E.Ring S₀ Ω[E.Ring ⁄ K']) ≃ₗ[T₀]
          TensorProduct E.Ring T₀ Ω[E.Ring ⁄ K'] :=
        TensorProduct.AlgebraTensorModule.cancelBaseChange E.Ring S₀ T₀ T₀ Ω[E.Ring ⁄ K']
      let e_sp2 : TensorProduct E.Ring T₀ Ω[E.Ring ⁄ K'] ≃ₗ[T₀]
          TensorProduct R' T₀ (TensorProduct E.Ring R' Ω[E.Ring ⁄ K']) :=
        (TensorProduct.AlgebraTensorModule.cancelBaseChange E.Ring R' T₀ T₀ Ω[E.Ring ⁄ K']).symm
      let e_sp3 : TensorProduct R' T₀ (TensorProduct E.Ring R' Ω[E.Ring ⁄ K']) ≃ₗ[T₀]
          TensorProduct R' T₀ Ω[R' ⁄ K'] :=
        LinearEquiv.baseChange R' T₀ (TensorProduct E.Ring R' Ω[E.Ring ⁄ K']) Ω[R' ⁄ K']
          (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K' E.Ring R')
      let e_sp : TensorProduct S₀ T₀ E.CotangentSpace ≃ₗ[T₀] P'.CotangentSpace :=
        (e_sp1.trans e_sp2).trans e_sp3
      have h_esp_apply : ∀ u : TensorProduct S₀ T₀ E.CotangentSpace,
          e_sp u = LinearMap.liftBaseChange T₀ (Algebra.Extension.CotangentSpace.map f_ext) u := by
        intro u
        induction u using TensorProduct.induction_on with
        | zero => simp
        | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
        | tmul t v =>
          induction v using TensorProduct.induction_on with
          | zero => simp
          | add x y ihx ihy => rw [TensorProduct.tmul_add, map_add, map_add, ihx, ihy]
          | tmul s ω =>
            have hω_top : ω ∈ (⊤ : Submodule E.Ring Ω[E.Ring ⁄ K']) := Submodule.mem_top
            rw [← KaehlerDifferential.span_range_derivation K' E.Ring] at hω_top
            revert s
            refine Submodule.span_induction ?_ ?_ ?_ ?_ hω_top
            · rintro _ ⟨y, rfl⟩ s
              have hLHS : e_sp (t ⊗ₜ[S₀] (s ⊗ₜ[E.Ring] KaehlerDifferential.D K' E.Ring y)) =
                  (s • t) ⊗ₜ[R'] KaehlerDifferential.D K' R' (algebraMap E.Ring R' y) := by
                change e_sp3 (e_sp2 (e_sp1 (t ⊗ₜ[S₀]
                  (s ⊗ₜ[E.Ring] KaehlerDifferential.D K' E.Ring y)))) = _
                rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul]
                rw [TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul]
                rw [LinearEquiv.baseChange_tmul,
                  KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
                  KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.map_D, one_smul]
              rw [hLHS, LinearMap.liftBaseChange_tmul, Algebra.Extension.CotangentSpace.map_tmul]
              change (s • t) ⊗ₜ[R'] KaehlerDifferential.D K' R' (algebraMap E.Ring R' y) =
                t • (algebraMap S₀ T₀ s ⊗ₜ[R'] KaehlerDifferential.D K' R' (algebraMap E.Ring R' y))
              rw [TensorProduct.smul_tmul', Algebra.smul_def, smul_eq_mul, mul_comm]
            · intro s
              simp
            · intro ω₁ ω₂ _ _ ih₁ ih₂ s
              simp [TensorProduct.tmul_add, ih₁ s, ih₂ s]
            · intro p₀ ω₁ _ ih₁ s
              have hsmul : s ⊗ₜ[E.Ring] (p₀ • ω₁) = (p₀ • s) ⊗ₜ[E.Ring] ω₁ := by
                rw [TensorProduct.smul_tmul]
              rw [hsmul]
              exact ih₁ (p₀ • s)
      have h_comm_cc : ∀ u : TensorProduct S₀ T₀ E.Cotangent,
          e_sp (LinearMap.lTensor T₀ E.cotangentComplex u) =
            P'.cotangentComplex (e_cot u) := by
        intro u
        induction u using TensorProduct.induction_on with
        | zero => simp
        | add x y ihx ihy => rw [map_add, map_add, map_add, map_add, ihx, ihy]
        | tmul t x =>
          rw [LinearMap.lTensor_tmul, h_esp_apply, LinearMap.liftBaseChange_tmul]
          have hmap := LinearMap.congr_fun
            (Algebra.Extension.CotangentSpace.map_comp_cotangentComplex f_ext) x
          simp only [LinearMap.comp_apply, LinearMap.coe_restrictScalars] at hmap
          rw [hmap, ← map_smul]
          rfl
      have h_P'_inj : Function.Injective P'.cotangentComplex :=
        (@Algebra.Extension.cotangentComplex_injective_iff K' T₀ _ _ _ P'
          (inferInstance : Algebra.FormallySmooth K' R')).mpr hSub_T₀
      have h_lTensor_cc_inj : Function.Injective
          (LinearMap.lTensor T₀ E.cotangentComplex) := by
        intro u₁ u₂ hu
        apply e_cot.injective
        apply h_P'_inj
        rw [← h_comm_cc u₁, ← h_comm_cc u₂, hu]
      have : Module.Flat S₀ T₀ := Algebra.Smooth.flat S₀ T₀
      have h_ι_inj : Function.Injective
          (LinearMap.lTensor T₀ E.h1Cotangentι) :=
        Module.Flat.lTensor_preserves_injective_linearMap
          E.h1Cotangentι Algebra.Extension.h1Cotangentι_injective
      have h_cc_ι_zero : E.cotangentComplex ∘ₗ E.h1Cotangentι = 0 := by
        ext x
        exact x.2
      refine Subsingleton.intro fun u v => ?_
      apply h_ι_inj
      apply h_lTensor_cc_inj
      have hcomp : LinearMap.lTensor T₀ E.cotangentComplex ∘ₗ
          LinearMap.lTensor T₀ E.h1Cotangentι = 0 := by
        rw [← LinearMap.lTensor_comp, h_cc_ι_zero, LinearMap.lTensor_zero]
      have hu := LinearMap.congr_fun hcomp u
      have hv := LinearMap.congr_fun hcomp v
      simpa using hu.trans hv.symm
    have : Algebra.FormallySmooth K' (Algebra.Generators.self K' S₀).toExtension.Ring := by
      change Algebra.FormallySmooth K' (MvPolynomial S₀ K')
      infer_instance
    have h_sub_T₀H1 : Subsingleton (TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀)) :=
      h_ext_H1 (Algebra.Generators.self K' S₀).toExtension
        (Algebra.Generators.self K' S₀).algebraMap_surjective
    have hSub_Sp : Subsingleton (Algebra.H1Cotangent K' (Localization.AtPrime p)) := by
      let S_p : Type u := Localization.AtPrime p
      let T_q : Type u := Localization.AtPrime q
      let ψ_loc : S_p →+* T_q := Localization.localRingHom p q (algebraMap S₀ T₀) hpq
      have h_loc_eq : ψ_loc.comp (algebraMap S₀ S_p) = algebraMap S₀ T_q :=
        RingHom.ext fun x => by
          rw [RingHom.comp_apply, Localization.localRingHom_to_map,
            IsScalarTower.algebraMap_apply S₀ T₀ T_q]
      let : Algebra S_p T_q := ψ_loc.toAlgebra
      have : IsScalarTower S₀ S_p T_q := IsScalarTower.of_algebraMap_eq' h_loc_eq.symm
      have hFlat_S₀T₀ : (algebraMap S₀ T₀).Flat :=
        RingHom.flat_algebraMap_iff.mpr (Algebra.Smooth.flat S₀ T₀)
      have : Module.Flat S_p T_q := RingHom.Flat.localRingHom hFlat_S₀T₀ q p hpq
      have : IsLocalHom (algebraMap S_p T_q) :=
        Localization.isLocalHom_localRingHom p q (algebraMap S₀ T₀) hpq
      have : Module.FaithfullyFlat S_p T_q := Module.FaithfullyFlat.of_flat_of_isLocalHom
      have : Subsingleton (TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀)) := h_sub_T₀H1
      have : Subsingleton
          (TensorProduct T₀ T_q (TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀))) := by
        let M₀ := TensorProduct S₀ T₀ (Algebra.H1Cotangent K' S₀)
        have hid0 : (LinearMap.id : M₀ →ₗ[T₀] M₀) = 0 := by
          ext m
          exact Subsingleton.elim _ _
        refine ⟨fun x y => ?_⟩
        have hzero : ∀ z : TensorProduct T₀ T_q M₀, z = 0 := by
          intro z
          have hz : LinearMap.lTensor T_q (LinearMap.id : M₀ →ₗ[T₀] M₀) z = z := by
            rw [LinearMap.lTensor_id]
            rfl
          rw [← hz, hid0, LinearMap.lTensor_zero, LinearMap.zero_apply]
        rw [hzero x, hzero y]
      let e_h1_1 := TensorProduct.AlgebraTensorModule.cancelBaseChange S₀ T₀ T_q T_q
        (Algebra.H1Cotangent K' S₀)
      let e_h1_2 := (TensorProduct.AlgebraTensorModule.cancelBaseChange S₀ S_p T_q T_q
        (Algebra.H1Cotangent K' S₀)).symm
      let e_h1_3 := LinearEquiv.baseChange S_p T_q
        (TensorProduct S₀ S_p (Algebra.H1Cotangent K' S₀)) (Algebra.H1Cotangent K' S_p)
        (Algebra.tensorH1CotangentOfIsLocalization K' S_p p.primeCompl)
      let e_h1 := (e_h1_1.trans e_h1_2).trans e_h1_3
      have : Subsingleton (TensorProduct S_p T_q (Algebra.H1Cotangent K' S_p)) :=
        e_h1.symm.injective.subsingleton
      let zero_map : Algebra.H1Cotangent K' S_p →ₗ[S_p] Algebra.H1Cotangent K' S_p := 0
      have h_lt_zero_inj : Function.Injective (LinearMap.lTensor T_q zero_map) :=
        fun x y _ => Subsingleton.elim x y
      have h_zero_inj : Function.Injective zero_map :=
        (Module.FaithfullyFlat.lTensor_injective_iff_injective S_p T_q zero_map).mp h_lt_zero_inj
      exact ⟨fun x y => h_zero_inj (by simp [zero_map])⟩
    have : Algebra.IsSmoothAt K' p := Algebra.FormallySmooth.mk hKaehler_Sp.1 hSub_Sp
    obtain ⟨f, hf, hStd_f⟩ := Algebra.IsSmoothAt.exists_notMem_isStandardSmooth K' p
    have : Algebra.IsStandardSmooth K' (Localization.Away f) := hStd_f
    have h_powers_unit : ∀ y : Submonoid.powers f,
        IsUnit (algebraMap S₀ (Localization.AtPrime p) y) := by
      rintro ⟨_, k, rfl⟩
      change IsUnit (algebraMap S₀ (Localization.AtPrime p) (f ^ k))
      rw [map_pow]
      exact (IsLocalization.map_units (Localization.AtPrime p) (⟨f, hf⟩ : p.primeCompl)).pow k
    let φ_fp : Localization.Away f →+* Localization.AtPrime p :=
      IsLocalization.lift (M := Submonoid.powers f) h_powers_unit
    have h_fp_eq : φ_fp.comp (algebraMap S₀ (Localization.Away f)) =
        algebraMap S₀ (Localization.AtPrime p) :=
      RingHom.ext fun x =>
        IsLocalization.lift_eq (M := Submonoid.powers f) (S := Localization.Away f) h_powers_unit x
    let : Algebra (Localization.Away f) (Localization.AtPrime p) := φ_fp.toAlgebra
    have : IsScalarTower S₀ (Localization.Away f) (Localization.AtPrime p) :=
      IsScalarTower.of_algebraMap_eq' h_fp_eq.symm
    have : IsScalarTower K' (Localization.Away f) (Localization.AtPrime p) := by
      apply IsScalarTower.of_algebraMap_eq'
      rw [IsScalarTower.algebraMap_eq K' S₀ (Localization.AtPrime p), ← h_fp_eq,
        RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq K' S₀ (Localization.Away f)]
      rfl
    have : Algebra.FormallyEtale S₀ (Localization.AtPrime p) :=
      Algebra.FormallyEtale.of_isLocalization p.primeCompl
    have : Algebra.FormallyEtale (Localization.Away f) (Localization.AtPrime p) :=
      Algebra.FormallyEtale.localization_base (Submonoid.powers f)
    let e_fp : TensorProduct (Localization.Away f) (Localization.AtPrime p)
        Ω[Localization.Away f ⁄ K'] ≃ₗ[Localization.AtPrime p] Ω[Localization.AtPrime p ⁄ K'] :=
      KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K'
        (Localization.Away f) (Localization.AtPrime p)
    have : Nontrivial (Localization.Away f) := RingHom.domain_nontrivial φ_fp
    have : Module.Free (Localization.Away f) Ω[Localization.Away f ⁄ K'] :=
      Algebra.IsStandardSmooth.free_kaehlerDifferential
    have hRank_Sf : Module.rank (Localization.Away f) Ω[Localization.Away f ⁄ K'] =
        ((1 : ℕ) : Cardinal.{u}) := by
      have hbc := Module.rank_baseChange
        (R := Localization.AtPrime p) (S := Localization.Away f)
        (M' := Ω[Localization.Away f ⁄ K'])
      rw [Cardinal.lift_id] at hbc
      rw [← hbc, e_fp.rank_eq, hKaehler_Sp.2, Nat.cast_one]
    have : Algebra.IsStandardSmoothOfRelativeDimension 1 K' (Localization.Away f) :=
      (Algebra.IsStandardSmoothOfRelativeDimension.iff_of_isStandardSmooth 1).mpr hRank_Sf
    exact ⟨f, hf, (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 1).mpr inferInstance⟩

  
  have hStalk1D :
      ∀ (S : Type u) [CommRing S] (ψ : Polynomial K' →+* S),
        ψ.Etale →
        ∀ (q_S : Ideal S) [q_S.IsPrime],
          ψ Polynomial.X ∈ q_S →
          IsDomain (Localization.AtPrime q_S) ∧
          algebraMap S (Localization.AtPrime q_S) (ψ Polynomial.X) ≠ 0 ∧
          (∀ P : Ideal (Localization.AtPrime q_S),
            P.IsPrime → P = ⊥ ∨ P = IsLocalRing.maximalIdeal (Localization.AtPrime q_S)) := by
    intro S _ ψ hψ q_S _ hX_qS
    let π_D : Localization.AtPrime q_S :=
      algebraMap S (Localization.AtPrime q_S) (ψ Polynomial.X)
    let : Algebra (Polynomial K') S := ψ.toAlgebra
    have : Algebra.Etale (Polynomial K') S := RingHom.etale_algebraMap.mp hψ
    let p_K : Ideal (Polynomial K') := Ideal.comap ψ q_S
    have : p_K.IsPrime := Ideal.IsPrime.comap ψ
    have hp_K : p_K = Ideal.span ({Polynomial.X} : Set (Polynomial K')) := by
      let ev0 : Polynomial K' →+* K' := Polynomial.evalRingHom 0
      have hev0_surj : Function.Surjective ev0 := fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
      have hev0_ker : RingHom.ker ev0 = Ideal.span ({Polynomial.X} : Set (Polynomial K')) := by
        ext f
        rw [RingHom.mem_ker, Ideal.mem_span_singleton]
        change Polynomial.eval 0 f = 0 ↔ Polynomial.X ∣ f
        rw [← Polynomial.IsRoot.def, ← Polynomial.dvd_iff_isRoot, map_zero, sub_zero]
      let e_K0 : Polynomial K' ⧸ Ideal.span ({Polynomial.X} : Set (Polynomial K')) ≃+* K' :=
        (Ideal.quotEquivOfEq hev0_ker.symm).trans (RingHom.quotientKerEquivOfSurjective hev0_surj)
      have hX_max : (Ideal.span ({Polynomial.X} : Set (Polynomial K'))).IsMaximal :=
        Ideal.Quotient.maximal_of_isField _ (e_K0.toMulEquiv.isField (Field.toIsField K'))
      have hX_le : Ideal.span ({Polynomial.X} : Set (Polynomial K')) ≤ p_K := by
        rw [Ideal.span_singleton_le_iff_mem]
        exact hX_qS
      exact (hX_max.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hX_le).symm
    have hMaxD : IsLocalRing.maximalIdeal (Localization.AtPrime q_S) =
        Ideal.span ({π_D} : Set (Localization.AtPrime q_S)) := by
      let φ_loc : Localization.AtPrime p_K →+* Localization.AtPrime q_S :=
        Localization.localRingHom p_K q_S ψ rfl
      let : Algebra (Localization.AtPrime p_K) (Localization.AtPrime q_S) := φ_loc.toAlgebra
      have : IsScalarTower (Polynomial K') (Localization.AtPrime p_K)
          (Localization.AtPrime q_S) :=
        IsScalarTower.of_algebraMap_eq' (RingHom.ext fun f => by
          change (algebraMap S (Localization.AtPrime q_S)) (ψ f) =
            φ_loc ((algebraMap (Polynomial K') (Localization.AtPrime p_K)) f)
          exact (Localization.localRingHom_to_map p_K q_S ψ rfl f).symm)
      have : IsLocalHom (algebraMap (Localization.AtPrime p_K) (Localization.AtPrime q_S)) :=
        Localization.isLocalHom_localRingHom p_K q_S ψ rfl
      have : Algebra.EssFiniteType S (Localization.AtPrime q_S) :=
        Algebra.EssFiniteType.of_isLocalization (Localization.AtPrime q_S) q_S.primeCompl
      have : Algebra.EssFiniteType (Polynomial K') (Localization.AtPrime q_S) :=
        Algebra.EssFiniteType.comp (Polynomial K') S (Localization.AtPrime q_S)
      have : Algebra.EssFiniteType (Localization.AtPrime p_K) (Localization.AtPrime q_S) :=
        Algebra.EssFiniteType.of_comp (Polynomial K')
          (Localization.AtPrime p_K) (Localization.AtPrime q_S)
      have : Algebra.FormallyEtale S (Localization.AtPrime q_S) :=
        Algebra.FormallyEtale.of_isLocalization q_S.primeCompl
      have : Algebra.FormallyEtale (Polynomial K') (Localization.AtPrime q_S) :=
        Algebra.FormallyEtale.comp (Polynomial K') S (Localization.AtPrime q_S)
      have : Algebra.FormallyEtale (Localization.AtPrime p_K) (Localization.AtPrime q_S) :=
        Algebra.FormallyEtale.localization_base p_K.primeCompl
      have hField : IsField (Localization.AtPrime q_S ⧸
          Ideal.map (algebraMap (Localization.AtPrime p_K) (Localization.AtPrime q_S))
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_K))) :=
        Algebra.FormallyUnramified.isField_quotient_map_maximalIdeal
          (R := Localization.AtPrime p_K) (S := Localization.AtPrime q_S)
      have hmax_R : IsLocalRing.maximalIdeal (Localization.AtPrime p_K) =
          Ideal.span ({algebraMap (Polynomial K') (Localization.AtPrime p_K) Polynomial.X} :
            Set (Localization.AtPrime p_K)) := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_K (Localization.AtPrime p_K)]
        conv_lhs => arg 2; rw [hp_K]
        rw [Ideal.map_span, Set.image_singleton]
      have hMap_eq :
          Ideal.map (algebraMap (Localization.AtPrime p_K) (Localization.AtPrime q_S))
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_K)) =
          Ideal.span ({π_D} : Set (Localization.AtPrime q_S)) := by
        rw [hmax_R, Ideal.map_span, Set.image_singleton]
        change Ideal.span ({φ_loc (algebraMap (Polynomial K')
            (Localization.AtPrime p_K) Polynomial.X)} : Set (Localization.AtPrime q_S)) =
          Ideal.span ({π_D} : Set (Localization.AtPrime q_S))
        rw [Localization.localRingHom_to_map p_K q_S ψ rfl Polynomial.X]
      rw [hMap_eq] at hField
      exact (IsLocalRing.eq_maximalIdeal (Ideal.Quotient.maximal_of_isField _ hField)).symm
    have hPowNeZero : ∀ k : ℕ, π_D ^ k ≠ 0 := by
      intro k hk
      have : Module.Flat (Polynomial K') S := Algebra.Smooth.flat (Polynomial K') S
      have : Module.Flat S (Localization.AtPrime q_S) :=
        IsLocalization.flat (Localization.AtPrime q_S) q_S.primeCompl
      have : Module.Flat (Polynomial K') (Localization.AtPrime q_S) :=
        Module.Flat.trans (Polynomial K') S (Localization.AtPrime q_S)
      have hXk_ne : (Polynomial.X : Polynomial K') ^ k ≠ 0 := by
        intro h0
        have hc := congrArg (fun p : Polynomial K' => p.coeff k) h0
        simpa using hc
      let f_k : Polynomial K' →ₗ[Polynomial K'] Polynomial K' :=
        LinearMap.mulLeft (Polynomial K') (Polynomial.X ^ k)
      have hf_inj : Function.Injective f_k := by
        rw [injective_iff_map_eq_zero]
        intro g hg
        exact (mul_eq_zero.mp hg).resolve_left hXk_ne
      have hlT_inj : Function.Injective (LinearMap.lTensor (Localization.AtPrime q_S) f_k) :=
        Module.Flat.lTensor_preserves_injective_linearMap f_k hf_inj
      have h_one_zero : LinearMap.lTensor (Localization.AtPrime q_S) f_k
          ((1 : Localization.AtPrime q_S) ⊗ₜ[Polynomial K'] (1 : Polynomial K')) = 0 := by
        change (1 : Localization.AtPrime q_S) ⊗ₜ[Polynomial K']
          ((Polynomial.X ^ k : Polynomial K') * 1) = 0
        have h_smul : ((Polynomial.X ^ k : Polynomial K') * 1 : Polynomial K') =
            (Polynomial.X ^ k : Polynomial K') • (1 : Polynomial K') := by simp
        rw [h_smul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        have h_alg_pow : algebraMap (Polynomial K') (Localization.AtPrime q_S)
            (Polynomial.X ^ k) = π_D ^ k := by
          rw [map_pow, IsScalarTower.algebraMap_apply (Polynomial K') S (Localization.AtPrime q_S)]
          rfl
        rw [h_alg_pow, hk, TensorProduct.zero_tmul]
      have h_tmul :
          (1 : Localization.AtPrime q_S) ⊗ₜ[Polynomial K'] (1 : Polynomial K') = 0 :=
        (injective_iff_map_eq_zero _).mp hlT_inj _ h_one_zero
      have h10 : (1 : Localization.AtPrime q_S) = 0 := by
        simpa using
          congrArg (TensorProduct.rid (Polynomial K') (Localization.AtPrime q_S)) h_tmul
      exact one_ne_zero h10
    have : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing (Polynomial K') S
    have : IsNoetherianRing (Localization.AtPrime q_S) :=
      IsLocalization.isNoetherianRing q_S.primeCompl (Localization.AtPrime q_S) inferInstance
    have hKrull :
        (⨅ n : ℕ, (IsLocalRing.maximalIdeal (Localization.AtPrime q_S)) ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing
        (IsLocalRing.maximalIdeal (Localization.AtPrime q_S))
        (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime q_S)).ne_top
    have hUnif : ∀ y : Localization.AtPrime q_S, y ≠ 0 →
        ∃ (u₀ : Localization.AtPrime q_S) (b : ℕ), IsUnit u₀ ∧ y = u₀ * π_D ^ b := by
      intro y hy
      have hex : ∃ n : ℕ, y ∉ (IsLocalRing.maximalIdeal (Localization.AtPrime q_S)) ^ n := by
        by_contra h_all
        push Not at h_all
        have hy_bot : y ∈ (⊥ : Ideal (Localization.AtPrime q_S)) := by
          rw [← hKrull, Ideal.mem_iInf]
          exact h_all
        exact hy (Ideal.mem_bot.mp hy_bot)
      classical
      let N := Nat.find hex
      have hN_spec : y ∉ (IsLocalRing.maximalIdeal (Localization.AtPrime q_S)) ^ N :=
        Nat.find_spec hex
      have hN_ne : N ≠ 0 := by
        intro h0
        apply hN_spec
        rw [h0, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      obtain ⟨b, hb⟩ := Nat.exists_eq_succ_of_ne_zero hN_ne
      have hy_mem : y ∈ (IsLocalRing.maximalIdeal (Localization.AtPrime q_S)) ^ b :=
        not_not.mp (Nat.find_min hex (by omega))
      rw [hMaxD, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hy_mem
      obtain ⟨u₀, hu₀⟩ := hy_mem
      refine ⟨u₀, b, ?_, by rw [hu₀, mul_comm]⟩
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hu₀_mem
      rw [hMaxD, Ideal.mem_span_singleton] at hu₀_mem
      obtain ⟨v, rfl⟩ := hu₀_mem
      apply hN_spec
      rw [hb, Nat.succ_eq_add_one, hMaxD, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      exact ⟨v, by rw [hu₀, pow_add, pow_one]; ring⟩
    have : NoZeroDivisors (Localization.AtPrime q_S) := ⟨by
      intro y₁ y₂ hy
      by_contra h_neither
      push Not at h_neither
      obtain ⟨u₁, b₁, hu₁, rfl⟩ := hUnif y₁ h_neither.1
      obtain ⟨u₂, b₂, hu₂, rfl⟩ := hUnif y₂ h_neither.2
      have h_prod : (u₁ * u₂) * π_D ^ (b₁ + b₂) = 0 := by
        calc (u₁ * u₂) * π_D ^ (b₁ + b₂) = (u₁ * π_D ^ b₁) * (u₂ * π_D ^ b₂) := by rw [pow_add]; ring
        _ = 0 := hy
      exact hPowNeZero (b₁ + b₂) ((hu₁.mul hu₂).mul_right_eq_zero.mp h_prod)⟩
    have hDom : IsDomain (Localization.AtPrime q_S) :=
      NoZeroDivisors.to_isDomain (Localization.AtPrime q_S)
    refine ⟨hDom, by simpa using hPowNeZero 1, ?_⟩
    intro P hP
    by_cases hbot : P = ⊥
    · exact Or.inl hbot
    · right
      obtain ⟨y, hyP, hy0⟩ := (Submodule.ne_bot_iff P).mp hbot
      obtain ⟨u₀, b, hu₀, rfl⟩ := hUnif y hy0
      obtain ⟨u_unit, rfl⟩ := hu₀
      have hpow_mem : π_D ^ b ∈ P := by
        have h1 : (↑(u_unit⁻¹) : Localization.AtPrime q_S) *
            ((u_unit : Localization.AtPrime q_S) * π_D ^ b) ∈ P := P.mul_mem_left _ hyP
        simpa [← mul_assoc] using h1
      have hπ_mem : π_D ∈ P := hP.mem_of_pow_mem b hpow_mem
      have h𝔪_le : IsLocalRing.maximalIdeal (Localization.AtPrime q_S) ≤ P := by
        rw [hMaxD, Ideal.span_singleton_le_iff_mem]
        exact hπ_mem
      exact le_antisymm (IsLocalRing.le_maximalIdeal hP.ne_top) h𝔪_le

  
  let I_nod : Ideal (MvPolynomial (Fin 2) K') :=
    Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
      (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}
  let c_nod : K' →+* MvPolynomial (Fin 2) K' ⧸ I_nod :=
    (Ideal.Quotient.mk I_nod).comp (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K')
  let u : Fin 2 → MvPolynomial (Fin 2) K' ⧸ I_nod :=
    fun i => Ideal.Quotient.mk I_nod (MvPolynomial.X i : MvPolynomial (Fin 2) K')
  let x : Fin 2 → D := fun i => α₂ (u i)
  let L : Type u := Localization.AtPrime n₀.asIdeal
  let 𝔩 : Fin 2 → Ideal L := fun i => Ideal.span ({algebraMap D L (x i)} : Set L)

  have hRightLeg :
      Function.Bijective ((Ideal.Quotient.mk n₀.asIdeal).comp (α₂.comp c_nod)) ∧
      𝔩 0 ⊔ 𝔩 1 = IsLocalRing.maximalIdeal L ∧
      (∀ i : Fin 2, (𝔩 i).IsPrime) ∧
      (∀ Q : Ideal L, Q.IsPrime → 𝔩 0 ≤ Q ∨ 𝔩 1 ≤ Q) ∧
      (∀ (i : Fin 2) (Q : Ideal L),
        Q.IsPrime → 𝔩 i ≤ Q → Q = 𝔩 i ∨ Q = IsLocalRing.maximalIdeal L) ∧
      (∀ i : Fin 2,
        ∃ ψ_q : Polynomial K' →+* (D ⧸ Ideal.span ({x i} : Set D)),
          ψ_q.Etale ∧
          ψ_q.comp Polynomial.C = (Ideal.Quotient.mk _).comp (α₂.comp c_nod)) := by
    have hu_mul : u 0 * u 1 = 0 := by
      change Ideal.Quotient.mk I_nod (MvPolynomial.X 0) *
        Ideal.Quotient.mk I_nod (MvPolynomial.X 1) = 0
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span rfl
    have hX_mon : ∀ i : Fin 2,
        (MvPolynomial.X i : MvPolynomial (Fin 2) K') =
          MvPolynomial.monomial (Finsupp.single i 1) 1 := by
      intro i
      simpa using (MvPolynomial.X_pow_eq_monomial (R := K') (σ := Fin 2) (e := 1) (n := i))
    let ε_mv : MvPolynomial (Fin 2) K' →+* K' := MvPolynomial.constantCoeff
    have hε_ker : ∀ a ∈ I_nod, ε_mv a = 0 := by
      intro a ha
      rw [Ideal.mem_span_singleton] at ha
      rcases ha with ⟨q, rfl⟩
      simp [ε_mv]
    let ε₀ : MvPolynomial (Fin 2) K' ⧸ I_nod →+* K' :=
      Ideal.Quotient.lift I_nod ε_mv hε_ker
    let 𝔪_nod : Ideal (MvPolynomial (Fin 2) K' ⧸ I_nod) :=
      Ideal.span ({u 0, u 1} : Set (MvPolynomial (Fin 2) K' ⧸ I_nod))
    have hε₀_c : ∀ c : K', ε₀ (c_nod c) = c := fun c => by simp [ε₀, ε_mv, c_nod]
    have hε₀_surj : Function.Surjective ε₀ := fun c => ⟨c_nod c, hε₀_c c⟩
    have hε₀_ker_eq : RingHom.ker ε₀ = 𝔪_nod := by
      apply le_antisymm
      · intro a ha
        obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective a
        have hP0 : P.coeff 0 = 0 := by
          have h1 : ε_mv P = 0 := ha
          simpa [ε_mv, MvPolynomial.constantCoeff_eq] using h1
        rw [MvPolynomial.as_sum P, map_sum]
        refine Submodule.sum_mem 𝔪_nod fun d hd => ?_
        have hd_ne : P.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
        have hd_zero_ne : d ≠ 0 := fun h0 => hd_ne (h0 ▸ hP0)
        have hd_pos : d 0 ≠ 0 ∨ d 1 ≠ 0 := by
          by_contra h_both
          push Not at h_both
          apply hd_zero_ne
          ext j
          exact (Fin.forall_fin_two (p := fun j => d j = 0)).mpr ⟨h_both.1, h_both.2⟩ j
        rcases hd_pos with hd0 | hd1
        · let e0 : Fin 2 →₀ ℕ := Finsupp.single 0 1
          have he0_0 : e0 0 = 1 := by simp [e0]
          have he0_1 : e0 1 = 0 := by simp [e0]
          have h_add : e0 + (d - e0) = d := by
            ext j
            refine (Fin.forall_fin_two (p := fun j => (e0 + (d - e0)) j = d j)).mpr ⟨?_, ?_⟩ j
            · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he0_0]; omega
            · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he0_1, zero_add, tsub_zero]
          have h_mon : MvPolynomial.monomial d (P.coeff d) =
              MvPolynomial.X 0 * MvPolynomial.monomial (d - e0) (P.coeff d) := by
            rw [hX_mon 0, MvPolynomial.monomial_mul_monomial, one_mul]
            exact congrArg (fun s => MvPolynomial.monomial s (P.coeff d)) h_add.symm
          rw [h_mon, map_mul]
          exact Ideal.mul_mem_right _ 𝔪_nod (Ideal.subset_span (by simp [u]))
        · let e1 : Fin 2 →₀ ℕ := Finsupp.single 1 1
          have he1_0 : e1 0 = 0 := by simp [e1]
          have he1_1 : e1 1 = 1 := by simp [e1]
          have h_add : e1 + (d - e1) = d := by
            ext j
            refine (Fin.forall_fin_two (p := fun j => (e1 + (d - e1)) j = d j)).mpr ⟨?_, ?_⟩ j
            · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he1_0, zero_add, tsub_zero]
            · simp only [Finsupp.add_apply, Finsupp.tsub_apply, he1_1]; omega
          have h_mon : MvPolynomial.monomial d (P.coeff d) =
              MvPolynomial.X 1 * MvPolynomial.monomial (d - e1) (P.coeff d) := by
            rw [hX_mon 1, MvPolynomial.monomial_mul_monomial, one_mul]
            exact congrArg (fun s => MvPolynomial.monomial s (P.coeff d)) h_add.symm
          rw [h_mon, map_mul]
          exact Ideal.mul_mem_right _ 𝔪_nod (Ideal.subset_span (by simp [u]))
      · rw [Ideal.span_le]
        intro y hy
        rcases hy with rfl | rfl <;> simp [u, ε₀, ε_mv]
    let J_D : Ideal D := Ideal.map α₂ (RingHom.ker ε₀)
    obtain ⟨κ_D, hκ_et, hκ_eval⟩ :=
      hQuotEtale (MvPolynomial (Fin 2) K' ⧸ I_nod) D K' α₂ ε₀ hEt₂ hε₀_surj J_D rfl
    have hJD_le : J_D ≤ n₀.asIdeal := by
      rw [Ideal.map_le_iff_le_comap, hε₀_ker_eq, Ideal.span_le]
      rintro a (rfl | rfl)
      · exact hX 0
      · exact hX 1
    have hBij : Function.Bijective ((Ideal.Quotient.mk n₀.asIdeal).comp (α₂.comp c_nod)) := by
      let : Algebra K' (D ⧸ J_D) := κ_D.toAlgebra
      have : Algebra.Etale K' (D ⧸ J_D) := RingHom.etale_algebraMap.mp hκ_et
      have : Module.Finite K' (D ⧸ J_D) := by
        obtain ⟨I, _, Ai, _, _, e_prod, hAi⟩ :=
          (Algebra.Etale.iff_exists_algEquiv_prod K' (D ⧸ J_D)).mp inferInstance
        have : ∀ j : I, Module.Finite K' (Ai j) := fun j => (hAi j).1
        exact Module.Finite.equiv e_prod.symm.toLinearEquiv
      let φ_K_quot : K' →+* (D ⧸ n₀.asIdeal) :=
        (Ideal.Quotient.mk n₀.asIdeal).comp (α₂.comp c_nod)
      let : Algebra K' (D ⧸ n₀.asIdeal) := φ_K_quot.toAlgebra
      let fac_alg : (D ⧸ J_D) →ₐ[K'] (D ⧸ n₀.asIdeal) :=
        { Ideal.Quotient.factor hJD_le with
          commutes' := fun c => by
            change Ideal.Quotient.factor hJD_le (κ_D c) = φ_K_quot c
            have hc : c = ε₀ (c_nod c) := (hε₀_c c).symm
            conv_lhs => rw [hc, hκ_eval (c_nod c)]
            rfl }
      have hfac_surj : Function.Surjective fac_alg :=
        Ideal.Quotient.factor_surjective hJD_le
      have : Module.Finite K' (D ⧸ n₀.asIdeal) :=
        Module.Finite.of_surjective fac_alg.toLinearMap hfac_surj
      have : Algebra.IsIntegral K' (D ⧸ n₀.asIdeal) :=
        Algebra.IsIntegral.of_finite K' (D ⧸ n₀.asIdeal)
      have : IsDomain (D ⧸ n₀.asIdeal) := Ideal.Quotient.isDomain n₀.asIdeal
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K') (K := D ⧸ n₀.asIdeal)
    have hSupL : 𝔩 0 ⊔ 𝔩 1 = IsLocalRing.maximalIdeal L := by
      let A_nod := MvPolynomial (Fin 2) K' ⧸ I_nod
      let p_nod : Ideal A_nod := Ideal.comap α₂ n₀.asIdeal
      have : p_nod.IsPrime := Ideal.IsPrime.comap α₂
      have h𝔪_max : (RingHom.ker ε₀).IsMaximal := RingHom.ker_isMaximal_of_surjective ε₀ hε₀_surj
      have hker_le_p : RingHom.ker ε₀ ≤ p_nod := Ideal.map_le_iff_le_comap.mp hJD_le
      have hp_nod_eq : p_nod = RingHom.ker ε₀ :=
        (h𝔪_max.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hker_le_p).symm
      let φ_nod_loc : Localization.AtPrime p_nod →+* L :=
        Localization.localRingHom p_nod n₀.asIdeal α₂ rfl
      let : Algebra A_nod D := α₂.toAlgebra
      have : Algebra.Etale A_nod D := RingHom.etale_algebraMap.mp hEt₂
      let : Algebra (Localization.AtPrime p_nod) L := φ_nod_loc.toAlgebra
      have : IsScalarTower A_nod (Localization.AtPrime p_nod) L :=
        IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a =>
          (Localization.localRingHom_to_map p_nod n₀.asIdeal α₂ rfl a).symm)
      have : IsLocalHom (algebraMap (Localization.AtPrime p_nod) L) :=
        Localization.isLocalHom_localRingHom p_nod n₀.asIdeal α₂ rfl
      have : Algebra.EssFiniteType D L :=
        Algebra.EssFiniteType.of_isLocalization L n₀.asIdeal.primeCompl
      have : Algebra.EssFiniteType A_nod L := Algebra.EssFiniteType.comp A_nod D L
      have : Algebra.EssFiniteType (Localization.AtPrime p_nod) L :=
        Algebra.EssFiniteType.of_comp A_nod (Localization.AtPrime p_nod) L
      have : Algebra.FormallyEtale D L :=
        Algebra.FormallyEtale.of_isLocalization n₀.asIdeal.primeCompl
      have : Algebra.FormallyEtale A_nod L := Algebra.FormallyEtale.comp A_nod D L
      have : Algebra.FormallyEtale (Localization.AtPrime p_nod) L :=
        Algebra.FormallyEtale.localization_base p_nod.primeCompl
      have hField : IsField (L ⧸
          Ideal.map (algebraMap (Localization.AtPrime p_nod) L)
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_nod))) :=
        Algebra.FormallyUnramified.isField_quotient_map_maximalIdeal
          (R := Localization.AtPrime p_nod) (S := L)
      have hMap_eq :
          Ideal.map (algebraMap (Localization.AtPrime p_nod) L)
            (IsLocalRing.maximalIdeal (Localization.AtPrime p_nod)) = 𝔩 0 ⊔ 𝔩 1 := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p_nod (Localization.AtPrime p_nod),
          Ideal.map_map, ← IsScalarTower.algebraMap_eq A_nod (Localization.AtPrime p_nod) L]
        conv_lhs => arg 2; rw [hp_nod_eq, hε₀_ker_eq]
        dsimp only [𝔪_nod]
        rw [Ideal.span_insert, Ideal.map_sup, Ideal.map_span, Ideal.map_span,
          Set.image_singleton, Set.image_singleton]
        rfl
      rw [hMap_eq] at hField
      exact IsLocalRing.eq_maximalIdeal (Ideal.Quotient.maximal_of_isField _ hField)
    let j_opp : Fin 2 → Fin 2 := fun i => if i = 0 then 1 else 0
    have hBranch : ∀ i : Fin 2,
        ∃ ψ_q : Polynomial K' →+* (D ⧸ Ideal.span ({x i} : Set D)),
          ψ_q.Etale ∧
          ψ_q.comp Polynomial.C = (Ideal.Quotient.mk _).comp (α₂.comp c_nod) ∧
          ψ_q Polynomial.X = Ideal.Quotient.mk _ (x (j_opp i)) := by
      intro i
      let I_ui : Ideal (MvPolynomial (Fin 2) K' ⧸ I_nod) :=
        Ideal.span ({u i} : Set (MvPolynomial (Fin 2) K' ⧸ I_nod))
      let I_xi : Ideal D := Ideal.span ({x i} : Set D)
      let α_mv : MvPolynomial (Fin 2) K' →+* Polynomial K' :=
        MvPolynomial.eval₂Hom Polynomial.C (fun k : Fin 2 => if k = i then 0 else Polynomial.X)
      have hα_ker1 : ∀ a ∈ I_nod, α_mv a = 0 := by
        intro a ha
        rw [Ideal.mem_span_singleton] at ha
        rcases ha with ⟨q_mv, rfl⟩
        fin_cases i <;> simp [α_mv]
      let α_nod : MvPolynomial (Fin 2) K' ⧸ I_nod →+* Polynomial K' :=
        Ideal.Quotient.lift I_nod α_mv hα_ker1
      let γ_i : Polynomial K' →+* MvPolynomial (Fin 2) K' ⧸ I_nod :=
        Polynomial.eval₂RingHom c_nod (u (j_opp i))
      have hj_ne : j_opp i ≠ i := by fin_cases i <;> decide
      have h_αγ : α_nod.comp γ_i = RingHom.id (Polynomial K') := by
        apply Polynomial.ringHom_ext'
        · ext c; simp [α_nod, α_mv, γ_i, c_nod]
        · simp [α_nod, α_mv, γ_i, u, hj_ne]
      have hα_surj : Function.Surjective α_nod :=
        fun P => ⟨γ_i P, RingHom.congr_fun h_αγ P⟩
      have h_mk_γα :
          (Ideal.Quotient.mk I_ui).comp (γ_i.comp α_nod) = Ideal.Quotient.mk I_ui := by
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext c; simp [α_nod, α_mv, γ_i, c_nod]
        · intro k
          by_cases hk : k = i
          · subst hk
            simp only [RingHom.comp_apply, α_nod, α_mv, Ideal.Quotient.lift_mk,
              MvPolynomial.eval₂Hom_X', ↓reduceIte, map_zero]
            have hu_zero : Ideal.Quotient.mk I_ui (u k) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            exact hu_zero.symm
          · have hk_opp : j_opp i = k := by
              fin_cases i <;> fin_cases k <;> simp_all [j_opp]
            simp only [RingHom.comp_apply, α_nod, α_mv, Ideal.Quotient.lift_mk,
              MvPolynomial.eval₂Hom_X', hk, ↓reduceIte]
            simp only [γ_i, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hk_opp, u]
      have hα_ker_eq : RingHom.ker α_nod = I_ui := by
        apply le_antisymm
        · intro a ha
          have ha0 : α_nod a = 0 := ha
          have hmk := RingHom.congr_fun h_mk_γα a
          simp only [RingHom.comp_apply, ha0, map_zero] at hmk
          exact Ideal.Quotient.eq_zero_iff_mem.mp hmk.symm
        · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          simp [α_nod, α_mv, u]
      obtain ⟨ψ_q, hψ_et, hψ_eval⟩ :=
        hQuotEtale (MvPolynomial (Fin 2) K' ⧸ I_nod) D (Polynomial K') α₂ α_nod hEt₂ hα_surj I_xi
          (by rw [hα_ker_eq, Ideal.map_span, Set.image_singleton])
      refine ⟨ψ_q, hψ_et, ?_, ?_⟩
      · ext c
        have hc : α_nod (c_nod c) = Polynomial.C c := by simp [α_nod, α_mv, c_nod]
        rw [RingHom.comp_apply, ← hc, hψ_eval]
        rfl
      · have hX_eq : α_nod (u (j_opp i)) = Polynomial.X := by
          simp [α_nod, α_mv, u, hj_ne]
        rw [← hX_eq, hψ_eval]
    have hStalkBranch : ∀ i : Fin 2,
        (𝔩 i).IsPrime ∧
        (∀ Q : Ideal L, Q.IsPrime → 𝔩 i ≤ Q → Q = 𝔩 i ∨ Q = IsLocalRing.maximalIdeal L) := by
      intro i
      obtain ⟨ψ_q, hψ_et, _, hψ_X⟩ := hBranch i
      let I_xi : Ideal D := Ideal.span ({x i} : Set D)
      let π_Si : D →+* (D ⧸ I_xi) := Ideal.Quotient.mk I_xi
      let π_Bq : L →+* (L ⧸ 𝔩 i) := Ideal.Quotient.mk (𝔩 i)
      have hker_Si_le : RingHom.ker π_Si ≤ n₀.asIdeal := by
        rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]
        exact hX i
      let q_i : Ideal (D ⧸ I_xi) := Ideal.map π_Si n₀.asIdeal
      have : q_i.IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_Si_le
      have h_comap_qi : Ideal.comap π_Si q_i = n₀.asIdeal := by
        rw [Ideal.comap_map_of_surjective' π_Si Ideal.Quotient.mk_surjective,
          sup_eq_left.mpr hker_Si_le]
      have h_sub : Submonoid.map π_Si n₀.asIdeal.primeCompl = q_i.primeCompl := by
        ext y
        simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
        constructor
        · rintro ⟨b, hb, rfl⟩ hy
          exact hb (h_comap_qi ▸ hy)
        · intro hy
          obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
          exact ⟨b, fun hb => hy (Ideal.mem_map_of_mem π_Si hb), rfl⟩
      have hf_quot_ker :
          ∀ a ∈ I_xi, (π_Bq.comp (algebraMap D L)) a = 0 := by
        intro a ha
        rw [Ideal.mem_span_singleton] at ha
        rcases ha with ⟨b, rfl⟩
        rw [RingHom.comp_apply, map_mul, map_mul]
        have h0 : π_Bq (algebraMap D L (x i)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [h0, zero_mul]
      let f_quot : (D ⧸ I_xi) →+* (L ⧸ 𝔩 i) :=
        Ideal.Quotient.lift I_xi (π_Bq.comp (algebraMap D L)) hf_quot_ker
      let : Algebra (D ⧸ I_xi) (L ⧸ 𝔩 i) := f_quot.toAlgebra
      have h_ker_Bq :
          RingHom.ker π_Bq ≤ Ideal.map (algebraMap D L) (RingHom.ker π_Si) := by
        rw [Ideal.mk_ker, Ideal.mk_ker, Ideal.map_span, Set.image_singleton]
      have h_loc_map :
          IsLocalization (Submonoid.map π_Si n₀.asIdeal.primeCompl) (L ⧸ 𝔩 i) :=
        IsLocalization.of_surjective n₀.asIdeal.primeCompl L
          π_Si Ideal.Quotient.mk_surjective
          π_Bq Ideal.Quotient.mk_surjective (by ext b; rfl) h_ker_Bq
      let : IsLocalization q_i.primeCompl (L ⧸ 𝔩 i) := h_sub ▸ h_loc_map
      let e_loc : Localization.AtPrime q_i ≃ₐ[D ⧸ I_xi] (L ⧸ 𝔩 i) :=
        IsLocalization.algEquiv q_i.primeCompl (Localization.AtPrime q_i) (L ⧸ 𝔩 i)
      have hX_qi : ψ_q Polynomial.X ∈ q_i := by
        rw [hψ_X]
        exact Ideal.mem_map_of_mem π_Si (hX (j_opp i))
      obtain ⟨hDom_i, _, hPrimes_i⟩ := hStalk1D (D ⧸ I_xi) ψ_q hψ_et q_i hX_qi
      have hPrime_𝔩 : (𝔩 i).IsPrime := by
        have : IsDomain (L ⧸ 𝔩 i) :=
          Function.Injective.isDomain e_loc.symm.toRingHom e_loc.symm.injective
        exact (Ideal.Quotient.isDomain_iff_prime (𝔩 i)).mp inferInstance
      refine ⟨hPrime_𝔩, ?_⟩
      intro Q hQ hle
      have hker_Bq_le : RingHom.ker π_Bq ≤ Q := by rwa [Ideal.mk_ker]
      let Q_bar : Ideal (L ⧸ 𝔩 i) := Ideal.map π_Bq Q
      have : Q_bar.IsPrime :=
        Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hker_Bq_le
      have hQ_comap : Ideal.comap π_Bq Q_bar = Q := by
        rw [Ideal.comap_map_of_surjective' π_Bq Ideal.Quotient.mk_surjective,
          sup_eq_left.mpr hker_Bq_le]
      let P_D : Ideal (Localization.AtPrime q_i) := Ideal.comap e_loc.toRingHom Q_bar
      have hPD_prime : P_D.IsPrime := Ideal.IsPrime.comap e_loc.toRingHom
      rcases hPrimes_i P_D hPD_prime with hPD_bot | hPD_max
      · left
        refine le_antisymm ?_ hle
        intro z hz
        have hz_bar : π_Bq z ∈ Q_bar := Ideal.mem_map_of_mem π_Bq hz
        have hd_mem : e_loc.symm (π_Bq z) ∈ P_D := by
          change e_loc (e_loc.symm (π_Bq z)) ∈ Q_bar
          simpa using hz_bar
        rw [hPD_bot, Ideal.mem_bot] at hd_mem
        have hz_zero : π_Bq z = 0 := by simpa using congrArg e_loc hd_mem
        exact Ideal.Quotient.eq_zero_iff_mem.mp hz_zero
      · right
        let 𝔪_L : Ideal L := IsLocalRing.maximalIdeal L
        have hQ_le_𝔪 : Q ≤ 𝔪_L := IsLocalRing.le_maximalIdeal hQ.ne_top
        refine le_antisymm hQ_le_𝔪 fun y hy_𝔪 => ?_
        by_contra hy_not_Q
        let d : Localization.AtPrime q_i := e_loc.symm (π_Bq y)
        have hd_not_PD : d ∉ P_D := by
          intro hd_in
          have hy_bar : e_loc d ∈ Q_bar := hd_in
          rw [AlgEquiv.apply_symm_apply] at hy_bar
          exact hy_not_Q (hQ_comap ▸ hy_bar)
        rw [hPD_max] at hd_not_PD
        have hd_unit : IsUnit d := IsLocalRing.notMem_maximalIdeal.mp hd_not_PD
        have hy_bar_unit : IsUnit (π_Bq y) := by
          simpa [d] using hd_unit.map e_loc.toRingHom
        obtain ⟨u_bar, hu_bar⟩ := hy_bar_unit
        obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (↑(u_bar⁻¹) : L ⧸ 𝔩 i)
        have h1_sub : 1 - w * y ∈ 𝔩 i := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          change π_Bq (1 - w * y) = 0
          rw [map_sub, map_one, map_mul, hw, ← hu_bar, Units.inv_mul, sub_self]
        have h1_mem : (1 : L) ∈ 𝔪_L := by
          have h_wy : w * y ∈ 𝔪_L := 𝔪_L.mul_mem_left w hy_𝔪
          have h_diff : 1 - w * y ∈ 𝔪_L := hQ_le_𝔪 (hle h1_sub)
          simpa using 𝔪_L.add_mem h_diff h_wy
        exact (IsLocalRing.maximalIdeal.isMaximal L).ne_top
          ((Ideal.eq_top_iff_one 𝔪_L).mpr h1_mem)
    refine ⟨hBij, hSupL, fun i => (hStalkBranch i).1, ?_, fun i Q hQ hle => (hStalkBranch i).2 Q hQ hle,
      fun i => let ⟨ψ_q, h1, h2, _⟩ := hBranch i; ⟨ψ_q, h1, h2⟩⟩
    intro Q hQ
    have h0 : algebraMap D L (x 0) * algebraMap D L (x 1) = 0 := by
      rw [← map_mul, ← map_mul, hu_mul, map_zero, map_zero]
    rcases hQ.mem_or_mem (h0 ▸ Q.zero_mem) with h0_mem | h1_mem
    · left; rw [Ideal.span_singleton_le_iff_mem]; exact h0_mem
    · right; rw [Ideal.span_singleton_le_iff_mem]; exact h1_mem

  obtain ⟨hBij_D, hSupL, hP_prime, hCoverP, hMaxP, hEtQuot⟩ := hRightLeg

  
  let π_Q : R₁ →+* (D ⧸ n₀.asIdeal) := (Ideal.Quotient.mk n₀.asIdeal).comp α₁
  have hBij_Q : Function.Bijective (π_Q.comp ιK) := by
    have h_eq : π_Q.comp ιK = (Ideal.Quotient.mk n₀.asIdeal).comp (α₂.comp c_nod) := by
      dsimp [π_Q, c_nod]
      rw [RingHom.comp_assoc, hcomm]
    rwa [h_eq]
  have hker_Q : RingHom.ker π_Q = M_q := by
    rw [← hcomap]
    ext r
    simp [π_Q, RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
  let e_Q : K' ≃+* (D ⧸ n₀.asIdeal) := RingEquiv.ofBijective (π_Q.comp ιK) hBij_Q
  let ev_M : R₁ →+* K' := e_Q.symm.toRingHom.comp π_Q
  have hevM_id : ev_M.comp ιK = RingHom.id K' := by
    ext c
    exact e_Q.symm_apply_apply c
  have hevM_surj : Function.Surjective ev_M :=
    fun c => ⟨ιK c, RingHom.congr_fun hevM_id c⟩
  have hevM_ker : RingHom.ker ev_M = M_q := by
    rw [← hker_Q]
    ext r
    simp only [ev_M, RingHom.mem_ker, RingHom.comp_apply]
    exact ⟨fun h => (map_eq_zero_iff e_Q.symm e_Q.symm.injective).mp h,
      fun h => by rw [h, map_zero]⟩
  have hMaxMq : M_q.IsMaximal :=
    hevM_ker ▸ RingHom.ker_isMaximal_of_surjective ev_M hevM_surj
  have hIY_ker_evM : ∀ a ∈ I_Y', ev_M a = 0 := by
    intro a ha
    have ha_M : a ∈ RingHom.ker ev_M := hevM_ker ▸ hIY_le ha
    exact ha_M
  let ev_q : R₁ ⧸ I_Y' →+* K' := Ideal.Quotient.lift I_Y' ev_M hIY_ker_evM
  have hevq_comp_mk : ev_q.comp (Ideal.Quotient.mk I_Y') = ev_M :=
    RingHom.ext fun _ => rfl
  have hevq_id : ev_q.comp ((Ideal.Quotient.mk I_Y').comp ιK) = RingHom.id K' := by
    rw [← RingHom.comp_assoc, hevq_comp_mk, hevM_id]
  have hevq_ker : RingHom.ker (ev_q.comp (Ideal.Quotient.mk I_Y')) = M_q := by
    rw [hevq_comp_mk, hevM_ker]

  
  let φ₁_L : R₁ →+* L := (algebraMap D L).comp α₁
  have hLeftAndAway :
      (∀ m ∈ M_q, ∃ s : R₁, s ∉ M_q ∧ s * m ∈ I_E ⊔ I_Y') ∧
      ∃ f : R₁ ⧸ I_Y', f ∉ RingHom.ker ev_q ∧
        (letI : Algebra K' R₁ := ιK.toAlgebra
         RingHom.IsStandardSmoothOfRelativeDimension 1
           (algebraMap K' (Localization.Away f))) := by
    let : Algebra K' R₁ := ιK.toAlgebra
    have : Algebra.FiniteType K' R₁ := RingHom.finiteType_algebraMap.mp hFT
    have : IsNoetherianRing R₁ := Algebra.FiniteType.isNoetherianRing K' R₁
    have : Algebra.FinitePresentation K' R₁ :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance

    
    obtain ⟨P₀, hP₀_min, hP₀_le_IE⟩ :=
      @Ideal.exists_minimalPrimes_le R₁ _ ⊥ I_E inferInstance bot_le
    have hP₀_prime : P₀.IsPrime := hP₀_min.1.1
    have hNot_IY_P₀ : ¬ (I_Y' ≤ P₀) := fun h => hNotSubY (h.trans hP₀_le_IE)
    obtain ⟨y₀, hy₀_IY, hy₀_not_P₀⟩ := SetLike.not_le_iff_exists.mp hNot_IY_P₀
    have hIE_le_P₀ : I_E ≤ P₀ := by
      intro e he
      have hmul_bot : e * y₀ ∈ I_E ⊓ I_Y' := ⟨I_E.mul_mem_right y₀ he, I_Y'.mul_mem_left e hy₀_IY⟩
      rw [hInfBot, Ideal.mem_bot] at hmul_bot
      exact (hP₀_prime.mem_or_mem (hmul_bot ▸ P₀.zero_mem)).resolve_right hy₀_not_P₀
    have hIE_min : I_E ∈ minimalPrimes R₁ := le_antisymm hP₀_le_IE hIE_le_P₀ ▸ hP₀_min

    obtain ⟨P', hP'_prime, hP'_le_Mq, hNot_IE_P'⟩ := hNotSubE
    obtain ⟨P₁, hP₁_min, hP₁_le_P'⟩ :=
      @Ideal.exists_minimalPrimes_le R₁ _ ⊥ P' hP'_prime bot_le
    have hP₁_prime : P₁.IsPrime := hP₁_min.1.1
    have : P₁.IsPrime := hP₁_prime
    have hP₁_le_Mq : P₁ ≤ M_q := hP₁_le_P'.trans hP'_le_Mq
    have hNot_IE_P₁ : ¬ (I_E ≤ P₁) := fun h => hNot_IE_P' (h.trans hP₁_le_P')
    obtain ⟨e₀, he₀_IE, he₀_not_P₁⟩ := SetLike.not_le_iff_exists.mp hNot_IE_P₁
    have hIY_le_P₁ : I_Y' ≤ P₁ := by
      intro y hy
      have hmul_bot : e₀ * y ∈ I_E ⊓ I_Y' := ⟨I_E.mul_mem_right y he₀_IE, I_Y'.mul_mem_left e₀ hy⟩
      rw [hInfBot, Ideal.mem_bot] at hmul_bot
      exact (hP₁_prime.mem_or_mem (hmul_bot ▸ P₁.zero_mem)).resolve_left he₀_not_P₁
    have hne_IE_P₁ : I_E ≠ P₁ := fun heq => hNot_IE_P₁ (le_of_eq heq)

    
    let R_loc : Type u := Localization.AtPrime M_q
    let φ_loc : R_loc →+* L := Localization.localRingHom M_q n₀.asIdeal α₁ hcomap.symm
    have hφ_loc_comp : φ_loc.comp (algebraMap R₁ R_loc) = φ₁_L :=
      RingHom.ext (Localization.localRingHom_to_map M_q n₀.asIdeal α₁ hcomap.symm)
    have hFlat_loc : φ_loc.Flat := by
      let : Algebra R₁ D := α₁.toAlgebra
      have : Algebra.Etale R₁ D := RingHom.etale_algebraMap.mp hEt₁
      have hF : α₁.Flat := show Module.Flat R₁ D from inferInstance
      exact hF.localRingHom n₀.asIdeal M_q hcomap.symm
    have hLocMem_and_Match :
        (∀ (I : Ideal R₁) (r : R₁), φ₁_L r ∈ Ideal.map φ₁_L I ↔ ∃ s : R₁, s ∉ M_q ∧ s * r ∈ I) ∧
        (∀ (p_m : Ideal R₁) [p_m.IsPrime],
          p_m ∈ minimalPrimes R₁ → p_m ≤ M_q → ∃ i : Fin 2, Ideal.comap φ₁_L (𝔩 i) = p_m) := by
      let : Algebra R_loc L := φ_loc.toAlgebra
      have : Module.Flat R_loc L := hFlat_loc
      have : IsLocalHom φ_loc := Localization.isLocalHom_localRingHom M_q n₀.asIdeal α₁ hcomap.symm
      have : Module.FaithfullyFlat R_loc L := Module.FaithfullyFlat.of_flat_of_isLocalHom
      refine ⟨?_, ?_⟩
      · intro I r
        have hmap : Ideal.map φ₁_L I =
            Ideal.map (algebraMap R_loc L) (Ideal.map (algebraMap R₁ R_loc) I) := by
          rw [← hφ_loc_comp, ← Ideal.map_map]; rfl
        have happ : φ₁_L r = algebraMap R_loc L (algebraMap R₁ R_loc r) := by
          rw [← hφ_loc_comp]; rfl
        rw [hmap, happ, ← Ideal.mem_comap, Ideal.comap_map_eq_self_of_faithfullyFlat,
          IsLocalization.algebraMap_mem_map_algebraMap_iff M_q.primeCompl R_loc I r]
        simp only [Ideal.mem_primeCompl_iff]
      · have hSurj_loc : Function.Surjective (PrimeSpectrum.comap φ_loc) :=
          (RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mp
            ‹Module.FaithfullyFlat R_loc L›).2
        intro p_m _ hpm_min hpm_le
        have hDisj : Disjoint (M_q.primeCompl : Set R₁) p_m :=
          Set.disjoint_left.mpr fun _ hs hp => hs (hpm_le hp)
        let P_loc : Ideal R_loc := Ideal.map (algebraMap R₁ R_loc) p_m
        have hPloc_prime : P_loc.IsPrime :=
          IsLocalization.isPrime_of_isPrime_disjoint M_q.primeCompl R_loc p_m ‹_› hDisj
        have hPloc_under : Ideal.comap (algebraMap R₁ R_loc) P_loc = p_m :=
          IsLocalization.under_map_of_isPrime_disjoint M_q.primeCompl R_loc ‹_› hDisj
        obtain ⟨Q_pt, hQ_pt⟩ := hSurj_loc ⟨P_loc, hPloc_prime⟩
        have hQ_under : Ideal.comap φ₁_L Q_pt.asIdeal = p_m := by
          rw [← hφ_loc_comp, ← Ideal.comap_comap]
          have h1 : Ideal.comap φ_loc Q_pt.asIdeal = P_loc := congrArg PrimeSpectrum.asIdeal hQ_pt
          rw [h1, hPloc_under]
        have hCovQ : ∃ i : Fin 2, 𝔩 i ≤ Q_pt.asIdeal := by
          rcases hCoverP Q_pt.asIdeal Q_pt.isPrime with h0 | h1
          · exact ⟨0, h0⟩
          · exact ⟨1, h1⟩
        obtain ⟨i, hi_le⟩ := hCovQ
        refine ⟨i, ?_⟩
        have h_comap_le : Ideal.comap φ₁_L (𝔩 i) ≤ p_m := by
          rw [← hQ_under]
          exact Ideal.comap_mono hi_le
        have : (𝔩 i).IsPrime := hP_prime i
        have h_comap_prime : (Ideal.comap φ₁_L (𝔩 i)).IsPrime := Ideal.IsPrime.comap φ₁_L
        have h_pm_le : p_m ≤ Ideal.comap φ₁_L (𝔩 i) :=
          hpm_min.2 ⟨h_comap_prime, bot_le⟩ h_comap_le
        exact le_antisymm h_comap_le h_pm_le

    obtain ⟨hLocMem, hMatch⟩ := hLocMem_and_Match
    obtain ⟨i₀, hi₀⟩ := hMatch I_E hIE_min hIE_le
    obtain ⟨i₁, hi₁⟩ := hMatch P₁ hP₁_min hP₁_le_Mq
    have hi_ne : i₀ ≠ i₁ := by
      intro heq
      apply hne_IE_P₁
      rw [← hi₀, ← hi₁, heq]

    
    let : Algebra R₁ D := α₁.toAlgebra
    have : Algebra.Etale R₁ D := RingHom.etale_algebraMap.mp hEt₁
    have hMapRad : ∀ (I : Ideal R₁), I.IsRadical → (Ideal.map φ₁_L I).IsRadical := by
      intro I hRad_I
      let S_I : Type u := R₁ ⧸ I
      have : IsNoetherianRing S_I := inferInstance
      have : _root_.IsReduced S_I := (Ideal.isRadical_iff_quotient_reduced I).mp hRad_I
      have : Algebra.Etale S_I (TensorProduct R₁ S_I D) := Algebra.Etale.baseChange R₁ D S_I
      have : _root_.IsReduced (TensorProduct R₁ S_I D) := hRedEtale S_I (TensorProduct R₁ S_I D)
      let I_D : Ideal D := Ideal.map α₁ I
      have : _root_.IsReduced (D ⧸ I_D) := by
        let : Algebra S_I (D ⧸ I_D) := (Ideal.quotientMap I_D α₁ Ideal.le_comap_map).toAlgebra
        have : IsScalarTower R₁ S_I (D ⧸ I_D) := ⟨fun s z w => by
          rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
            map_mul, mul_assoc]
          rfl⟩
        let α_hom : TensorProduct R₁ S_I D →ₐ[S_I] (D ⧸ I_D) :=
          Algebra.TensorProduct.lift (Algebra.ofId S_I (D ⧸ I_D))
            ⟨Ideal.Quotient.mk I_D, fun _ => rfl⟩ (fun _ _ => mul_comm _ _)
        have hID_ker : ∀ b ∈ I_D,
            (Algebra.TensorProduct.includeRight : D →ₐ[R₁] TensorProduct R₁ S_I D) b = 0 := by
          have hsub : I_D ≤ RingHom.ker
              (Algebra.TensorProduct.includeRight : D →ₐ[R₁] TensorProduct R₁ S_I D).toRingHom := by
            rw [Ideal.map_le_iff_le_comap]
            intro s hs
            rw [Ideal.mem_comap, RingHom.mem_ker]
            change (1 : S_I) ⊗ₜ[R₁] α₁ s = 0
            have h_smul : α₁ s = s • (1 : D) := by rw [Algebra.smul_def, mul_one]; rfl
            rw [h_smul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
            change (Ideal.Quotient.mk I s) ⊗ₜ[R₁] (1 : D) = 0
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hs, TensorProduct.zero_tmul]
          exact fun b hb => hsub hb
        let β_hom : (D ⧸ I_D) →+* TensorProduct R₁ S_I D :=
          Ideal.Quotient.lift I_D
            (Algebra.TensorProduct.includeRight : D →ₐ[R₁] TensorProduct R₁ S_I D).toRingHom hID_ker
        have hLeftInv : Function.LeftInverse α_hom.toRingHom β_hom := by
          intro z
          refine Quotient.inductionOn' z fun r => ?_
          change α_hom ((1 : S_I) ⊗ₜ[R₁] r) = Ideal.Quotient.mk I_D r
          exact (Algebra.TensorProduct.lift_tmul _ _ _ (1 : S_I) r).trans (by simp)
        exact isReduced_of_injective β_hom hLeftInv.injective
      let J_q : Ideal L := Ideal.map φ₁_L I
      have hJq_ID : J_q = Ideal.map (algebraMap D L) I_D := (Ideal.map_map α₁ (algebraMap D L)).symm
      rintro z ⟨m_exp, hz_pow⟩
      cases m_exp with
      | zero =>
        rw [pow_zero] at hz_pow
        simpa using J_q.mul_mem_left z hz_pow
      | succ k =>
        obtain ⟨⟨r, t⟩, hrt⟩ := IsLocalization.surj n₀.asIdeal.primeCompl z
        dsimp at hrt
        have hr_pow : algebraMap D L (r ^ (k + 1)) ∈ Ideal.map (algebraMap D L) I_D := by
          rw [map_pow, ← hrt, mul_pow, ← hJq_ID]
          exact J_q.mul_mem_right _ hz_pow
        obtain ⟨m_s, hm_s_mem, hm_s⟩ :=
          (IsLocalization.algebraMap_mem_map_algebraMap_iff
            n₀.asIdeal.primeCompl L I_D (r ^ (k + 1))).mp hr_pow
        have hmr_pow : (m_s * r) ^ (k + 1) ∈ I_D := by
          have h_eq : (m_s * r) ^ (k + 1) = m_s ^ k * (m_s * r ^ (k + 1)) := by ring
          rw [h_eq]
          exact I_D.mul_mem_left _ hm_s
        have hmr_mem : m_s * r ∈ I_D := by
          have hq_nil : IsNilpotent (Ideal.Quotient.mk I_D (m_s * r)) :=
            ⟨k + 1, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact hmr_pow⟩
          exact Ideal.Quotient.eq_zero_iff_mem.mp hq_nil.eq_zero
        have hmr_Jq : algebraMap D L (m_s * r) ∈ J_q := by
          rw [hJq_ID]
          exact Ideal.mem_map_of_mem _ hmr_mem
        obtain ⟨u_mt, hu_mt⟩ := IsLocalization.map_units L (⟨m_s, hm_s_mem⟩ * t)
        have hzu : z * u_mt.val = algebraMap D L (m_s * r) := by
          rw [hu_mt, Submonoid.coe_mul, map_mul, ← mul_assoc, mul_comm z (algebraMap D L m_s),
            mul_assoc, hrt, ← map_mul]
        have hzu_mem : z * u_mt.val ∈ J_q := hzu ▸ hmr_Jq
        simpa [mul_assoc] using J_q.mul_mem_right (↑u_mt⁻¹ : L) hzu_mem

    have hRadEqBranch : ∀ (I : Ideal R₁) (a b : Fin 2),
        a ≠ b → (Ideal.map φ₁_L I).IsRadical →
        Ideal.map φ₁_L I ≤ 𝔩 a → ¬ (Ideal.map φ₁_L I ≤ 𝔩 b) → Ideal.map φ₁_L I = 𝔩 a := by
      intro I a b hab hRadJ hJ_le_a hJ_not_b
      have : (𝔩 a).IsPrime := hP_prime a
      have hLa_max : 𝔩 a ≤ IsLocalRing.maximalIdeal L :=
        IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)
      apply le_antisymm hJ_le_a
      have hLa_rad : 𝔩 a ≤ (Ideal.map φ₁_L I).radical := by
        rw [Ideal.radical_eq_sInf]
        refine le_sInf ?_
        rintro Q ⟨hJQ, hQ_prime⟩
        by_contra hNot_a
        have hb_Q : 𝔩 b ≤ Q := by
          have hcov := hCoverP Q hQ_prime
          fin_cases a <;> fin_cases b
          · exact absurd rfl hab
          · exact hcov.resolve_left hNot_a
          · exact hcov.resolve_right hNot_a
          · exact absurd rfl hab
        rcases hMaxP b Q hQ_prime hb_Q with rfl | rfl
        · exact hJ_not_b hJQ
        · exact hNot_a hLa_max
      rwa [hRadJ.radical] at hLa_rad

    have hJE_eq : Ideal.map φ₁_L I_E = 𝔩 i₀ :=
      hRadEqBranch I_E i₀ i₁ hi_ne (hMapRad I_E (Ideal.IsPrime.isRadical inferInstance))
        (Ideal.map_le_iff_le_comap.mpr (le_of_eq hi₀.symm))
        (fun hle => hNot_IE_P₁
          (le_trans Ideal.le_comap_map (le_trans (Ideal.comap_mono hle) (le_of_eq hi₁))))
    have hJY_eq : Ideal.map φ₁_L I_Y' = 𝔩 i₁ :=
      hRadEqBranch I_Y' i₁ i₀ hi_ne.symm (hMapRad I_Y' hRadY)
        (Ideal.map_le_iff_le_comap.mpr (hi₁ ▸ hIY_le_P₁))
        (fun hle => hNotSubY
          (le_trans Ideal.le_comap_map (le_trans (Ideal.comap_mono hle) (le_of_eq hi₀))))

    
    have hSupEY : Ideal.map φ₁_L (I_E ⊔ I_Y') = IsLocalRing.maximalIdeal L := by
      rw [Ideal.map_sup, hJE_eq, hJY_eq, ← hSupL]
      fin_cases i₀ <;> fin_cases i₁
      · exact absurd rfl hi_ne
      · rfl
      · exact sup_comm _ _
      · exact absurd rfl hi_ne
    have hConj2 : ∀ m ∈ M_q, ∃ s : R₁, s ∉ M_q ∧ s * m ∈ I_E ⊔ I_Y' := by
      intro m hm
      have hm_n₀ : α₁ m ∈ n₀.asIdeal := by
        rw [← Ideal.mem_comap, hcomap]
        exact hm
      have hm_maxL : φ₁_L m ∈ IsLocalRing.maximalIdeal L := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal n₀.asIdeal L]
        exact Ideal.mem_map_of_mem (algebraMap D L) hm_n₀
      rw [← hSupEY] at hm_maxL
      exact (hLocMem (I_E ⊔ I_Y') m).mp hm_maxL

    
    let I_D : Ideal D := Ideal.map α₁ I_Y'
    have hJY_ID : Ideal.map φ₁_L I_Y' = Ideal.map (algebraMap D L) I_D :=
      (Ideal.map_map α₁ (algebraMap D L)).symm
    let x₁ : D := x i₁
    have hx₁_n₀ : x₁ ∈ n₀.asIdeal := hX i₁
    have hFG : I_Y'.FG := IsNoetherian.noetherian I_Y'
    let S₀ : Type u := R₁ ⧸ I_Y'
    have : Algebra.FinitePresentation K' S₀ := Algebra.FinitePresentation.quotient hFG
    obtain ⟨G_Y, hGY_span⟩ := hFG
    have hx₁_mem_JY : algebraMap D L x₁ ∈ Ideal.map (algebraMap D L) I_D := by
      rw [← hJY_ID, hJY_eq]
      exact Ideal.subset_span (Set.mem_singleton _)
    obtain ⟨s_x, hs_x_mem, hs_x⟩ :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff
        n₀.asIdeal.primeCompl L I_D x₁).mp hx₁_mem_JY
    have hGY_clear : ∀ g : ↥G_Y,
        ∃ s_g : D, s_g ∈ n₀.asIdeal.primeCompl ∧ s_g * α₁ g.1 ∈ Ideal.span ({x₁} : Set D) := by
      intro g
      have hg_IY : g.1 ∈ I_Y' := hGY_span ▸ Ideal.subset_span g.2
      have hg_JY : algebraMap D L (α₁ g.1) ∈
          Ideal.map (algebraMap D L) (Ideal.span ({x₁} : Set D)) := by
        rw [Ideal.map_span, Set.image_singleton]
        change φ₁_L g.1 ∈ 𝔩 i₁
        rw [← hJY_eq]
        exact Ideal.mem_map_of_mem φ₁_L hg_IY
      exact (IsLocalization.algebraMap_mem_map_algebraMap_iff
        n₀.asIdeal.primeCompl L (Ideal.span ({x₁} : Set D)) (α₁ g.1)).mp hg_JY
    choose s_g hs_g_mem hs_g using hGY_clear
    let b_sub : n₀.asIdeal.primeCompl := ⟨s_x, hs_x_mem⟩ * ∏ g : ↥G_Y, ⟨s_g g, hs_g_mem g⟩
    let b : D := b_sub.1
    have hb_not_n₀ : b ∉ n₀.asIdeal := b_sub.2
    have hbx₁ : b * x₁ ∈ I_D := by
      have hb_eq : b * x₁ = (∏ g : ↥G_Y, s_g g) * (s_x * x₁) := by
        change (s_x * (∏ g : ↥G_Y, (⟨s_g g, hs_g_mem g⟩ : n₀.asIdeal.primeCompl)).1) * x₁ = _
        rw [Submonoid.coe_finset_prod]
        ring
      rw [hb_eq]
      exact I_D.mul_mem_left _ hs_x
    have hb_IY : ∀ s ∈ I_Y', b * α₁ s ∈ Ideal.span ({x₁} : Set D) := by
      let J_clear : Ideal R₁ :=
        { carrier := {s : R₁ | b * α₁ s ∈ Ideal.span ({x₁} : Set D)}
          add_mem' := fun {s₁ s₂} h₁ h₂ => by
            rw [Set.mem_setOf_eq, map_add, mul_add]
            exact Ideal.add_mem _ h₁ h₂
          zero_mem' := by simp
          smul_mem' := fun r {s} hs => by
            rw [Set.mem_setOf_eq, smul_eq_mul, map_mul]
            have : b * (α₁ r * α₁ s) = α₁ r * (b * α₁ s) := by ring
            rw [this]
            exact Ideal.mul_mem_left _ _ hs }
      have hSub : (G_Y : Set R₁) ⊆ (J_clear : Set R₁) := by
        intro g hg
        obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem (fun z : ↥G_Y => s_g z) (Finset.mem_univ ⟨g, hg⟩)
        have hb_g : b * α₁ g = (s_x * c) * (s_g ⟨g, hg⟩ * α₁ g) := by
          change (s_x * (∏ z : ↥G_Y, (⟨s_g z, hs_g_mem z⟩ : n₀.asIdeal.primeCompl)).1) * α₁ g = _
          rw [Submonoid.coe_finset_prod, hc]
          ring
        change b * α₁ g ∈ Ideal.span ({x₁} : Set D)
        rw [hb_g]
        exact Ideal.mul_mem_left _ _ (hs_g ⟨g, hg⟩)
      have hIY_le_J : I_Y' ≤ J_clear := by
        rw [← hGY_span, Ideal.span_le]
        exact hSub
      exact fun s hs => hIY_le_J hs
    let p' : Ideal S₀ := RingHom.ker ev_q
    have : p'.IsPrime := RingHom.ker_isPrime ev_q
    let Q_B : Type u := D ⧸ Ideal.span ({x₁} : Set D)
    let π_x : D →+* Q_B := Ideal.Quotient.mk (Ideal.span ({x₁} : Set D))
    let b_bar : Q_B := π_x b
    let T₀ : Type u := Localization.Away b_bar
    have hb_bar_unit : IsUnit (algebraMap Q_B T₀ b_bar) :=
      IsLocalization.Away.algebraMap_isUnit b_bar
    have hIY_ker_T₀ : ∀ s ∈ I_Y', ((algebraMap Q_B T₀).comp (π_x.comp α₁)) s = 0 := by
      intro s hs
      change algebraMap Q_B T₀ (π_x (α₁ s)) = 0
      have hmul0 : b_bar * π_x (α₁ s) = 0 := by
        rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
        exact hb_IY s hs
      have hmul0' : algebraMap Q_B T₀ b_bar * algebraMap Q_B T₀ (π_x (α₁ s)) = 0 := by
        rw [← map_mul, hmul0, map_zero]
      exact (hb_bar_unit.mul_right_eq_zero).mp hmul0'
    let φ_ST₀ : S₀ →+* T₀ :=
      Ideal.Quotient.lift I_Y' ((algebraMap Q_B T₀).comp (π_x.comp α₁)) hIY_ker_T₀
    let : Algebra S₀ T₀ := φ_ST₀.toAlgebra
    let : Algebra K' T₀ := (φ_ST₀.comp (algebraMap K' S₀)).toAlgebra
    have : IsScalarTower K' S₀ T₀ := IsScalarTower.of_algebraMap_eq' rfl
    have : IsScalarTower R₁ S₀ T₀ := ⟨fun s z w => by
      rw [Algebra.smul_def, Algebra.smul_def, Algebra.smul_def, Algebra.smul_def,
        map_mul, mul_assoc]
      rfl⟩
    have : Algebra.Etale S₀ T₀ := by
      let D_b : Type u := Localization.Away b
      have : Algebra.Etale D D_b := Algebra.Etale.of_isLocalizationAway b
      have : Algebra.Etale R₁ D_b := Algebra.Etale.comp R₁ D D_b
      let R_prod : Type u := TensorProduct R₁ S₀ D_b
      have : Algebra.Etale S₀ R_prod := Algebra.Etale.baseChange R₁ D_b S₀
      have hb_unit_T₀ : IsUnit (((algebraMap Q_B T₀).comp π_x) b) := hb_bar_unit
      let θ_Db_T₀ : D_b →+* T₀ := IsLocalization.Away.lift b hb_unit_T₀
      let θ_alg : D_b →ₐ[R₁] T₀ :=
        { θ_Db_T₀ with
          commutes' := fun s => by
            change θ_Db_T₀ (algebraMap D D_b (α₁ s)) = algebraMap Q_B T₀ (π_x (α₁ s))
            exact IsLocalization.Away.lift_eq b hb_unit_T₀ (α₁ s) }
      let Φ : R_prod →ₐ[S₀] T₀ :=
        Algebra.TensorProduct.lift (Algebra.ofId S₀ T₀) θ_alg (fun _ _ => mul_comm _ _)
      let ι_R : D →+* R_prod :=
        (Algebra.TensorProduct.includeRight : D_b →ₐ[R₁] R_prod).toRingHom.comp (algebraMap D D_b)
      have hID_ker_R : I_D ≤ RingHom.ker ι_R := by
        rw [Ideal.map_le_iff_le_comap]
        intro s hs
        rw [Ideal.mem_comap, RingHom.mem_ker]
        change (1 : S₀) ⊗ₜ[R₁] algebraMap D D_b (α₁ s) = 0
        have h_smul : algebraMap D D_b (α₁ s) = s • (1 : D_b) := by
          rw [Algebra.smul_def, mul_one]; rfl
        rw [h_smul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
        change (Ideal.Quotient.mk I_Y' s) ⊗ₜ[R₁] (1 : D_b) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hs, TensorProduct.zero_tmul]
      have hb_unit_R : IsUnit (ι_R b) :=
        IsUnit.map (Algebra.TensorProduct.includeRight : D_b →ₐ[R₁] R_prod).toRingHom
          (IsLocalization.Away.algebraMap_isUnit (S := D_b) b)
      have hx₁_ker_R : ∀ d ∈ Ideal.span ({x₁} : Set D), ι_R d = 0 := by
        have hsub : Ideal.span ({x₁} : Set D) ≤ RingHom.ker ι_R := by
          rw [Ideal.span_le, Set.singleton_subset_iff]
          have hbx₁_0 : ι_R b * ι_R x₁ = 0 := by
            rw [← map_mul]
            exact hID_ker_R hbx₁
          exact (hb_unit_R.mul_right_eq_zero).mp hbx₁_0
        exact fun d hd => hsub hd
      let ψ_QB : Q_B →+* R_prod := Ideal.Quotient.lift (Ideal.span ({x₁} : Set D)) ι_R hx₁_ker_R
      have hb_bar_unit_R : IsUnit (ψ_QB b_bar) := hb_unit_R
      let Ψ : T₀ →+* R_prod := IsLocalization.Away.lift b_bar hb_bar_unit_R
      have hΦΨ : Φ.toRingHom.comp Ψ = RingHom.id T₀ := by
        apply IsLocalization.ringHom_ext (Submonoid.powers b_bar)
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro r
        change Φ (Ψ (algebraMap Q_B T₀ (π_x r))) = algebraMap Q_B T₀ (π_x r)
        have h1 : Ψ (algebraMap Q_B T₀ (π_x r)) = ι_R r :=
          IsLocalization.Away.lift_eq b_bar hb_bar_unit_R (π_x r)
        rw [h1]
        change Φ ((1 : S₀) ⊗ₜ[R₁] algebraMap D D_b r) = _
        refine (Algebra.TensorProduct.lift_tmul _ _ _ (1 : S₀) (algebraMap D D_b r)).trans ?_
        simp only [map_one, one_mul]
        exact IsLocalization.Away.lift_eq b hb_unit_T₀ r
      have hΨΦ : Ψ.comp Φ.toRingHom = RingHom.id R_prod := by
        have hOnRight : (Ψ.comp Φ.toRingHom).comp
            (Algebra.TensorProduct.includeRight : D_b →ₐ[R₁] R_prod).toRingHom =
            (Algebra.TensorProduct.includeRight : D_b →ₐ[R₁] R_prod).toRingHom := by
          apply IsLocalization.ringHom_ext (Submonoid.powers b)
          apply RingHom.ext
          intro r
          change Ψ (Φ ((1 : S₀) ⊗ₜ[R₁] algebraMap D D_b r)) = (1 : S₀) ⊗ₜ[R₁] algebraMap D D_b r
          have h0 : Φ ((1 : S₀) ⊗ₜ[R₁] algebraMap D D_b r) = algebraMap Q_B T₀ (π_x r) := by
            refine (Algebra.TensorProduct.lift_tmul _ _ _ (1 : S₀) (algebraMap D D_b r)).trans ?_
            simp only [map_one, one_mul]
            exact IsLocalization.Away.lift_eq b hb_unit_T₀ r
          rw [h0]
          exact IsLocalization.Away.lift_eq b_bar hb_bar_unit_R (π_x r)
        apply RingHom.ext
        intro z
        change Ψ (Φ z) = z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul s₀' b_loc =>
          rcases Ideal.Quotient.mk_surjective s₀' with ⟨s, rfl⟩
          have h_split : (Ideal.Quotient.mk I_Y' s : S₀) ⊗ₜ[R₁] b_loc =
              ((Ideal.Quotient.mk I_Y' s : S₀) ⊗ₜ[R₁] (1 : D_b)) * ((1 : S₀) ⊗ₜ[R₁] b_loc) := by
            simp [Algebra.TensorProduct.tmul_mul_tmul]
          rw [h_split, map_mul, map_mul]
          congr 1
          · have hΦ_left : Φ ((Ideal.Quotient.mk I_Y' s : S₀) ⊗ₜ[R₁] (1 : D_b)) =
                algebraMap Q_B T₀ (π_x (α₁ s)) := by
              refine (Algebra.TensorProduct.lift_tmul _ _ _ (Ideal.Quotient.mk I_Y' s) (1 : D_b)).trans ?_
              simp only [map_one, mul_one]
              rfl
            rw [hΦ_left, IsLocalization.Away.lift_eq b_bar hb_bar_unit_R (π_x (α₁ s))]
            change (1 : S₀) ⊗ₜ[R₁] algebraMap D D_b (α₁ s) = _
            have h_smul : algebraMap D D_b (α₁ s) = s • (1 : D_b) := by
              rw [Algebra.smul_def, mul_one]; rfl
            rw [h_smul, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
            rfl
          · exact RingHom.congr_fun hOnRight b_loc
        | add u_t v_t hu hv => simp [hu, hv]
      have hBijΦ : Function.Bijective Φ :=
        ⟨fun x₁' x₂' hx' => by
          have h1 : (Ψ.comp Φ.toRingHom) x₁' = (Ψ.comp Φ.toRingHom) x₂' := congrArg Ψ hx'
          simpa using (RingHom.congr_fun hΨΦ x₁').symm.trans (h1.trans (RingHom.congr_fun hΨΦ x₂')),
         fun y' => ⟨Ψ y', RingHom.congr_fun hΦΨ y'⟩⟩
      let e_Φ : R_prod ≃ₐ[S₀] T₀ := AlgEquiv.ofBijective Φ hBijΦ
      have : Algebra.IsStandardSmoothOfRelativeDimension 0 S₀ R_prod :=
        Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
      have : Algebra.IsStandardSmoothOfRelativeDimension 0 S₀ T₀ :=
        Algebra.IsStandardSmoothOfRelativeDimension.of_algEquiv 0 e_Φ
      exact Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr inferInstance
    let q_QB : Ideal Q_B := Ideal.map π_x n₀.asIdeal
    have hx₁_le_n₀ : Ideal.span ({x₁} : Set D) ≤ n₀.asIdeal :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx₁_n₀)
    have hqQB_prime : q_QB.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
        (by simpa [Ideal.mk_ker] using hx₁_le_n₀)
    have hqQB_comap : Ideal.comap π_x q_QB = n₀.asIdeal := by
      rw [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker,
        sup_eq_left.mpr hx₁_le_n₀]
    have hb_bar_not_qQB : b_bar ∉ q_QB := by
      intro hmem
      have : b ∈ Ideal.comap π_x q_QB := hmem
      rw [hqQB_comap] at this
      exact hb_not_n₀ this
    have hDisj_bbar : Disjoint (Submonoid.powers b_bar : Set Q_B) q_QB := by
      have hle : Submonoid.powers b_bar ≤ q_QB.primeCompl := Submonoid.powers_le.mpr hb_bar_not_qQB
      exact Set.disjoint_left.mpr fun _ hz hq => hle hz hq
    let q_T₀ : Ideal T₀ := Ideal.map (algebraMap Q_B T₀) q_QB
    have : q_T₀.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers b_bar) T₀ q_QB hqQB_prime hDisj_bbar
    have hqT₀_under : Ideal.comap (algebraMap Q_B T₀) q_T₀ = q_QB :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers b_bar) T₀ hqQB_prime hDisj_bbar
    have hp'_qT₀ : p' = Ideal.comap (algebraMap S₀ T₀) q_T₀ := by
      ext z
      rcases Ideal.Quotient.mk_surjective z with ⟨s, rfl⟩
      have hL_p : Ideal.Quotient.mk I_Y' s ∈ p' ↔ s ∈ M_q := by
        change s ∈ RingHom.ker (ev_q.comp (Ideal.Quotient.mk I_Y')) ↔ s ∈ M_q
        rw [hevq_ker]
      have hR_p : Ideal.Quotient.mk I_Y' s ∈ Ideal.comap (algebraMap S₀ T₀) q_T₀ ↔ s ∈ M_q := by
        change algebraMap Q_B T₀ (π_x (α₁ s)) ∈ q_T₀ ↔ s ∈ M_q
        rw [← Ideal.mem_comap, hqT₀_under, ← Ideal.mem_comap, hqQB_comap, ← hcomap, Ideal.mem_comap]
      exact hL_p.trans hR_p.symm
    obtain ⟨ψ_q, hψ_et, hψ_comp⟩ := hEtQuot i₁
    let φ_poly : Polynomial K' →+* T₀ := (algebraMap Q_B T₀).comp ψ_q
    have hφ_poly_et : φ_poly.Etale := by
      let : Algebra (Polynomial K') Q_B := ψ_q.toAlgebra
      have : Algebra.Etale (Polynomial K') Q_B := RingHom.etale_algebraMap.mp hψ_et
      have : Algebra.Etale Q_B T₀ := Algebra.Etale.of_isLocalizationAway b_bar
      have : Algebra.Etale (Polynomial K') T₀ := Algebra.Etale.comp (Polynomial K') Q_B T₀
      exact RingHom.etale_algebraMap.mpr inferInstance
    have hφ_poly_comp : φ_poly.comp Polynomial.C = algebraMap K' T₀ := by
      calc
        φ_poly.comp Polynomial.C = (algebraMap Q_B T₀).comp (ψ_q.comp Polynomial.C) := rfl
        _ = (algebraMap Q_B T₀).comp (π_x.comp (α₂.comp c_nod)) := by rw [hψ_comp]
        _ = (algebraMap Q_B T₀).comp (π_x.comp (α₁.comp ιK)) := by rw [← hcomm]
        _ = algebraMap K' T₀ := rfl
    obtain ⟨f, hf_not, hSm_f⟩ :=
      hSmoothDescent S₀ p' T₀ q_T₀ hp'_qT₀ φ_poly hφ_poly_et hφ_poly_comp
    exact ⟨hConj2, f, hf_not, hSm_f⟩

  obtain ⟨hConj2, f, hf_not, hSm_f⟩ := hLeftAndAway

  
  let : Algebra K' R₁ := ιK.toAlgebra
  let S₀ : Type u := R₁ ⧸ I_Y'
  let ιS₀ : K' →+* S₀ := (Ideal.Quotient.mk I_Y').comp ιK
  let R_cat : CommRingCat.{u} := CommRingCat.of S₀
  let A_cat : CommRingCat.{u} := CommRingCat.of (Localization.Away f)
  let K_cat : CommRingCat.{u} := CommRingCat.of K'
  let g_loc : AlgebraicGeometry.Spec A_cat ⟶ AlgebraicGeometry.Spec R_cat :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ (Localization.Away f)))
  have : AlgebraicGeometry.IsOpenImmersion g_loc := inferInstance
  let V_q : (AlgebraicGeometry.Spec R_cat).Opens := g_loc.opensRange
  have hmem_Vq : (⟨RingHom.ker ev_q, RingHom.ker_isPrime ev_q⟩ : PrimeSpectrum S₀) ∈ V_q := by
    let p_S : PrimeSpectrum S₀ := ⟨RingHom.ker ev_q, RingHom.ker_isPrime ev_q⟩
    have : p_S.asIdeal.IsPrime := p_S.isPrime
    have hDisj : Disjoint (Submonoid.powers f : Set S₀) p_S.asIdeal := by
      have hle : Submonoid.powers f ≤ p_S.asIdeal.primeCompl := Submonoid.powers_le.mpr hf_not
      exact Set.disjoint_left.mpr fun _ hz hp => hle hz hp
    let q_A : Ideal (Localization.Away f) :=
      Ideal.map (algebraMap S₀ (Localization.Away f)) p_S.asIdeal
    have hq_prime : q_A.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f)
        (Localization.Away f) p_S.asIdeal p_S.isPrime hDisj
    have hq_under : Ideal.comap (algebraMap S₀ (Localization.Away f)) q_A = p_S.asIdeal :=
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f)
        (Localization.Away f) p_S.isPrime hDisj
    exact ⟨⟨q_A, hq_prime⟩, PrimeSpectrum.ext hq_under⟩
  let isoV : AlgebraicGeometry.Spec A_cat ≅ V_q.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq g_loc V_q.ι (by simp [V_q])
  have hisoV : isoV.inv ≫ g_loc = V_q.ι :=
    AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac g_loc V_q.ι _
  let φ_KA : K_cat ⟶ A_cat := CommRingCat.ofHom (algebraMap K' (Localization.Away f))
  have h_fac : V_q.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιS₀) =
      isoV.inv ≫ AlgebraicGeometry.Spec.map φ_KA := by
    rw [← hisoV, CategoryTheory.Category.assoc]
    congr 1
    dsimp [g_loc, φ_KA]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
  have : AlgebraicGeometry.IsOpenImmersion isoV.inv := inferInstance
  have : AlgebraicGeometry.SmoothOfRelativeDimension 0 isoV.inv := inferInstance
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (AlgebraicGeometry.Spec.map φ_KA) := by
    let g_KA := AlgebraicGeometry.Spec.map φ_KA
    refine AlgebraicGeometry.SmoothOfRelativeDimension.mk (fun _ =>
      ⟨⊤, AlgebraicGeometry.isAffineOpen_top _,
       (TopologicalSpace.Opens.map g_KA.base).obj ⊤,
       AlgebraicGeometry.isAffineOpen_top _, trivial, le_rfl, ?_⟩)
    have h_nat : g_KA.appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom ≫ φ_KA ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso A_cat).inv := by
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.eq_comp_inv]
      exact AlgebraicGeometry.Scheme.ΓSpecIso_naturality φ_KA
    have h_app : (g_KA.appLE ⊤ ((TopologicalSpace.Opens.map g_KA.base).obj ⊤) le_rfl).hom =
        ((AlgebraicGeometry.Scheme.ΓSpecIso A_cat).inv.hom.comp φ_KA.hom).comp
          (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).hom.hom := by
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact congrArg CommRingCat.Hom.hom h_nat
    rw [h_app]
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension 1
        ((AlgebraicGeometry.Scheme.ΓSpecIso A_cat).inv.hom.comp φ_KA.hom) :=
      RingHom.isStandardSmoothOfRelativeDimension_respectsIso.1 φ_KA.hom
        (AlgebraicGeometry.Scheme.ΓSpecIso A_cat).symm.commRingCatIsoToRingEquiv hSm_f
    exact RingHom.isStandardSmoothOfRelativeDimension_respectsIso.2 _
      (AlgebraicGeometry.Scheme.ΓSpecIso K_cat).commRingCatIsoToRingEquiv h1
  refine ⟨hMaxMq, hConj2, ev_q, hevq_id, hevq_ker, V_q, hmem_Vq, ?_⟩
  rw [h_fac]
  simpa using AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 isoV.inv
    (AlgebraicGeometry.Spec.map φ_KA)

theorem weil_sup1_caseB_two_open_gluing_and_away_iso (K' : Type u) [Field K']
    (X X_next : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsReduced X]
    (q : X ⟶ X_next)
    (U₀ : X_next.Opens) (hAffU₀ : AlgebraicGeometry.IsAffineOpen U₀)
    (W₀ V₁ : X.Opens) (hAffV₁ : AlgebraicGeometry.IsAffineOpen V₁) (hV₁_le : V₁ ≤ W₀)
    (heq₀ : W₀ ≤ (TopologicalSpace.Opens.map q.base).obj U₀)
    (hPreU₀ : (TopologicalSpace.Opens.map q.base).obj U₀ = W₀)
    (hBij₀ : Function.Bijective (q.appLE U₀ W₀ heq₀).hom)
    (E_star Y'_set : Set ↥X)
    (hE_closed : IsClosed E_star)
    (hY'_closed : IsClosed Y'_set)
    (hCovX : E_star ∪ Y'_set = Set.univ)
    (hE_sub : E_star ⊆ (W₀ : Set ↥X))
    (hW₀_Y' : (W₀ : Set ↥X) ∩ Y'_set ⊆ (V₁ : Set ↥X))
    (hΔ_ne : (E_star ∩ Y'_set).Nonempty)
    (ev_E : ↑(X.presheaf.obj (Opposite.op W₀)) →+* K')
    (hev_surj : Function.Surjective ev_E)
    (hev_zero : ∀ f : ↑(X.presheaf.obj (Opposite.op W₀)),
      ev_E f = 0 → Disjoint E_star ((X.basicOpen f : X.Opens) : Set ↥X))
    (hev_ne : ∀ f : ↑(X.presheaf.obj (Opposite.op W₀)),
      ev_E f ≠ 0 → E_star ⊆ ((X.basicOpen f : X.Opens) : Set ↥X)) :
    let res_V₁ : ↑(X.presheaf.obj (Opposite.op W₀)) →+* ↑(X.presheaf.obj (Opposite.op V₁)) :=
      (X.presheaf.map (CategoryTheory.homOfLE hV₁_le).op).hom
    let θ₀ : ↑(X_next.presheaf.obj (Opposite.op U₀)) →+* ↑(X.presheaf.obj (Opposite.op W₀)) :=
      (q.appLE U₀ W₀ heq₀).hom
    let I_E : Ideal ↑(X.presheaf.obj (Opposite.op V₁)) :=
      PrimeSpectrum.vanishingIdeal (hAffV₁.isoSpec.hom.base '' {x : ↥V₁.toScheme | x.1 ∈ E_star})
    (∀ b ∈ I_E, ∃ f : ↑(X.presheaf.obj (Opposite.op W₀)), res_V₁ f = b ∧ ev_E f = 0) ∧
    (∃ (y_star : ↥X_next) (hy_star : y_star ∈ U₀),
      (hAffU₀.isoSpec.hom.base ⟨y_star, hy_star⟩).asIdeal = RingHom.ker (ev_E.comp θ₀) ∧
      q.base ⁻¹' {y_star} = E_star ∧
      Set.InjOn q.base ((W₀ : Set ↥X) \ E_star) ∧
      ∀ y : ↥X_next, y ∈ U₀ → y ≠ y_star →
        ∃ U_y : X_next.Opens, y ∈ U_y ∧ U_y ≤ U₀ ∧ CategoryTheory.IsIso (q ∣_ U_y)) :=
by
  classical
  intro res_V₁ θ₀ I_E
  
  have hBasicIff : ∀ {S : AlgebraicGeometry.Scheme.{u}} {V : S.Opens}
      (hAff : AlgebraicGeometry.IsAffineOpen V)
      (x : ↥V.toScheme) (b : ↑(S.presheaf.obj (Opposite.op V))),
      x.1 ∈ ((S.basicOpen b : S.Opens) : Set ↥S) ↔
        b ∉ (hAff.isoSpec.hom.base x).asIdeal := by
    intro S V hAff x b
    have h1 := AlgebraicGeometry.Scheme.Opens.toSpecΓ_preimage_basicOpen V b
    rw [← hAff.isoSpec_hom] at h1
    have h2 : x ∈ (TopologicalSpace.Opens.map V.ι.base).obj (S.basicOpen b) ↔
        x ∈ (TopologicalSpace.Opens.map hAff.isoSpec.hom.base).obj (PrimeSpectrum.basicOpen b) := by
      rw [h1]
    exact h2.trans (PrimeSpectrum.mem_basicOpen b (hAff.isoSpec.hom.base x))
  have hMemIE : ∀ b : ↑(X.presheaf.obj (Opposite.op V₁)),
      b ∈ I_E ↔ Disjoint E_star ((X.basicOpen b : X.Opens) : Set ↥X) := by
    intro b
    dsimp only [I_E]
    rw [PrimeSpectrum.mem_vanishingIdeal, Set.disjoint_left]
    constructor
    · intro hb z hzE hzb
      have hzV₁ : z ∈ V₁ := X.basicOpen_le b hzb
      have hnot : b ∉ (hAffV₁.isoSpec.hom.base ⟨z, hzV₁⟩).asIdeal :=
        (hBasicIff hAffV₁ ⟨z, hzV₁⟩ b).mp hzb
      exact hnot (hb _ ⟨⟨z, hzV₁⟩, hzE, rfl⟩)
    · rintro hdisj _ ⟨x, hxE, rfl⟩
      by_contra hnot
      exact hdisj hxE ((hBasicIff hAffV₁ x b).mpr hnot)
  have hSepV₁ : ∀ x : ↥X, x ∈ V₁ → x ∉ E_star →
      ∃ b ∈ I_E, x ∈ ((X.basicOpen b : X.Opens) : Set ↥X) := by
    intro x hx_V₁ hx_notE
    let Sigma_E : Set (PrimeSpectrum ↑(X.presheaf.obj (Opposite.op V₁))) :=
      hAffV₁.isoSpec.hom.base '' {z : ↥V₁.toScheme | z.1 ∈ E_star}
    have hSigma_eq : Sigma_E = (hAffV₁.isoSpec.inv ≫ V₁.ι).base ⁻¹' E_star := by
      ext p
      dsimp only [Sigma_E]
      constructor
      · rintro ⟨z, hzE, rfl⟩
        have hinv : hAffV₁.isoSpec.inv.base (hAffV₁.isoSpec.hom.base z) = z :=
          congrArg (fun g => g.base z) hAffV₁.isoSpec.hom_inv_id
        change V₁.ι.base (hAffV₁.isoSpec.inv.base (hAffV₁.isoSpec.hom.base z)) ∈ E_star
        rw [hinv]
        exact hzE
