      have hθ_et' : θ.Etale :=
        RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective e_poly.bijective) hθ_et
      letI : Algebra (Polynomial k_P) A'' := θ.toAlgebra
      have _ : Algebra.Etale (Polynomial k_P) A'' := RingHom.etale_algebraMap.mp hθ_et'
      have _ : Algebra.HasGoingDown (Polynomial k_P) A'' := Algebra.HasGoingDown.of_flat
      have hUnit_t : IsUnit (ev_A' t) := IsUnit.mk0 (ev_A' t) ht_ne
      let ev_A'' : A'' →+* k_P := IsLocalization.Away.lift (S := A'') t hUnit_t
      have hev_A''_comp : ev_A''.comp (algebraMap A' A'') = ev_A' :=
        RingHom.ext fun a => IsLocalization.Away.lift_eq (S := A'') t hUnit_t a
