    have hI1_x : x 0 ∈ I₁ ∨ x 1 ∈ I₁ := hRad_mem_x I₁ hI1_ne (hEtRad J_Z hJZ_rad)
    have hI2_x : x 0 ∈ I₂ ∨ x 1 ∈ I₂ := hRad_mem_x I₂ hI2_ne (hEtRad J_Y' hJY'_rad)
    have hMax_le_sup : IsLocalRing.maximalIdeal R_loc ≤ I₁ ⊔ I₂ := by
