        have h_inj : ∀ e ∈ R.support, N + e 0 - e 1 = N + e₀ 0 - e₀ 1 → e = e₀ := by
          intro e he hdeg
          have h1 := hR_supp e he
          have h2 := hR_supp e₀ he₀
          have hl1 := hR_le e he
          have hl2 := hR_le e₀ he₀
          have heq0 : e 0 = e₀ 0 := by omega
          have heq1 : e 1 = e₀ 1 := by omega
          ext i
          fin_cases i
          · exact heq0
          · exact heq1
        have hc_term : (∑ e ∈ R.support,
            if N + e 0 - e 1 = N + e₀ 0 - e₀ 1 then R.coeff e * δ ^ e 1 else 0) =
            R.coeff e₀ * δ ^ e₀ 1 := by
          rw [Finset.sum_eq_single e₀]
          · simp
          · intro e he hne
            rw [if_neg]
            intro hdeg
            exact hne (h_inj e he hdeg)
          · intro hnot
            exact False.elim (hnot he₀)
        rw [hc_term] at hc0
        have hcoeff0 : R.coeff e₀ = 0 :=
          (mul_eq_zero.mp hc0).resolve_right (pow_ne_zero (e₀ 1) hδ)
        exact (MvPolynomial.mem_support_iff.mp he₀) hcoeff0
      rw [hR0, sub_zero] at hPR
      exact hPR
    have hbarΦ_inj : Function.Injective barΦ := by
      rw [RingHom.injective_iff_ker_eq_bot]
      ext x
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      change Φ P = 0 ↔ Ideal.Quotient.mk I_δ P = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact ⟨fun hx => hkerΦ hx, fun hx => hΦ_gen hx⟩
    have hDomA : IsDomain A_δ := Function.Injective.isDomain barΦ hbarΦ_inj
    refine ⟨hDomA, ?_⟩
    letI : Algebra A_δ F := barΦ.toAlgebra
    let α₀ : P_R →+* A_δ :=
      Polynomial.eval₂RingHom ((Ideal.Quotient.mk I_δ).comp MvPolynomial.C)
        (Ideal.Quotient.mk I_δ (MvPolynomial.X 0))
    have hbarΦ_α₀ : barΦ.comp α₀ = ι_P := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro r
        simp only [RingHom.comp_apply, α₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        dsimp [barΦ]
        rw [Ideal.Quotient.lift_mk]
        simp [Φ, ι_R]
      · simp only [RingHom.comp_apply, α₀, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        dsimp [barΦ]
        rw [Ideal.Quotient.lift_mk]
        simp [Φ, t]
    haveI hFracA : IsFractionRing A_δ F :=
      { map_units := by
          intro y
          have hy0 : (y : A_δ) ≠ 0 := nonZeroDivisors.ne_zero y.2
          exact IsUnit.mk0 (barΦ y) (fun h0 => hy0 (hbarΦ_inj (h0.trans barΦ.map_zero.symm)))
        surj := by
          intro z
          obtain ⟨f, g, hg_mem, hfg⟩ := IsFractionRing.div_surjective (A := P_R) z
          have hg0 : (g : P_R) ≠ 0 := nonZeroDivisors.ne_zero hg_mem
          have hιg_ne : ι_P g ≠ 0 := fun h0 => hg0 (hιP_inj (h0.trans ι_P.map_zero.symm))
          have hαg_ne : α₀ g ≠ 0 := by
            intro h0
            have : barΦ (α₀ g) = 0 := by rw [h0, map_zero]
            have h_eq : barΦ (α₀ g) = ι_P g := RingHom.congr_fun hbarΦ_α₀ g
            exact hιg_ne (h_eq ▸ this)
          refine ⟨⟨α₀ f, ⟨α₀ g, mem_nonZeroDivisors_of_ne_zero hαg_ne⟩⟩, ?_⟩
          change z * barΦ (α₀ g) = barΦ (α₀ f)
          have hf_eq : barΦ (α₀ f) = ι_P f := RingHom.congr_fun hbarΦ_α₀ f
          have hg_eq : barΦ (α₀ g) = ι_P g := RingHom.congr_fun hbarΦ_α₀ g
          rw [hf_eq, hg_eq, ← hfg, div_mul_cancel₀ _ hιg_ne]
        exists_of_eq := by
          intro x y hxy
          exact ⟨1, by simp [hbarΦ_inj hxy]⟩ }
    let S₁ := Localization.Away (Polynomial.X : P_R)
    have hPow_le : Submonoid.powers (Polynomial.X : P_R) ≤ nonZeroDivisors P_R := by
      rw [Submonoid.powers_le]
      exact mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero
    haveI hIntClS₁ : IsIntegrallyClosed S₁ :=
      isIntegrallyClosed_of_isLocalization _ _ hPow_le
    obtain ⟨lam₁, hlam₁_app⟩ : ∃ lam₁ : S₁ →+* F,
        ∀ f : P_R, lam₁ (algebraMap P_R S₁ f) = ι_P f :=
      ⟨IsLocalization.Away.lift (S := S₁) Polynomial.X (g := ι_P) (IsUnit.mk0 t ht_ne),
        fun f => IsLocalization.Away.lift_eq (S := S₁) Polynomial.X (IsUnit.mk0 t ht_ne) f⟩
    have hlam₁_comp : lam₁.comp (algebraMap P_R S₁) = ι_P :=
      RingHom.ext hlam₁_app
    have hlam₁_inj : Function.Injective lam₁ := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj (Polynomial.X : P_R) y
      have h1 := congrArg lam₁ hna
      have h2 : lam₁ (algebraMap P_R S₁ a) = ι_P a := RingHom.congr_fun hlam₁_comp a
      rw [map_mul, hy, zero_mul, h2] at h1
      have ha0 : a = 0 := hιP_inj (h1.symm.trans ι_P.map_zero.symm)
      subst ha0
      rw [map_zero] at hna
      have hX_unit : IsUnit (algebraMap P_R S₁ Polynomial.X ^ n) :=
        IsUnit.pow n (IsLocalization.Away.algebraMap_isUnit Polynomial.X)
      exact hX_unit.mul_left_eq_zero.mp hna
    letI : Algebra S₁ F := lam₁.toAlgebra
    haveI hDomS₁ : IsDomain S₁ := Function.Injective.isDomain lam₁ hlam₁_inj
    haveI hFracS₁ : IsFractionRing S₁ F :=
      { map_units := by
          intro y
          have hy0 : (y : S₁) ≠ 0 := nonZeroDivisors.ne_zero y.2
          exact IsUnit.mk0 (lam₁ y) (fun h0 => hy0 (hlam₁_inj (h0.trans lam₁.map_zero.symm)))
        surj := by
          intro z
          obtain ⟨f, g, hg_mem, hfg⟩ := IsFractionRing.div_surjective (A := P_R) z
          have hg0 : (g : P_R) ≠ 0 := nonZeroDivisors.ne_zero hg_mem
          have hιg_ne : ι_P g ≠ 0 := fun h0 => hg0 (hιP_inj (h0.trans ι_P.map_zero.symm))
          have hSg_ne : algebraMap P_R S₁ g ≠ 0 := by
            intro h0
            have : lam₁ (algebraMap P_R S₁ g) = 0 := by rw [h0, map_zero]
            have h_eq : lam₁ (algebraMap P_R S₁ g) = ι_P g := RingHom.congr_fun hlam₁_comp g
            exact hιg_ne (h_eq ▸ this)
          refine ⟨⟨algebraMap P_R S₁ f, ⟨algebraMap P_R S₁ g, mem_nonZeroDivisors_of_ne_zero hSg_ne⟩⟩, ?_⟩
          change z * lam₁ (algebraMap P_R S₁ g) = lam₁ (algebraMap P_R S₁ f)
          have hf_eq : lam₁ (algebraMap P_R S₁ f) = ι_P f := RingHom.congr_fun hlam₁_comp f
          have hg_eq : lam₁ (algebraMap P_R S₁ g) = ι_P g := RingHom.congr_fun hlam₁_comp g
          rw [hf_eq, hg_eq, ← hfg, div_mul_cancel₀ _ hιg_ne]
        exists_of_eq := by
          intro x y hxy
          exact ⟨1, by simp [hlam₁_inj hxy]⟩ }
    let invX : S₁ := IsLocalization.Away.invSelf (R := P_R) (S := S₁) Polynomial.X
    have hX_invX : algebraMap P_R S₁ Polynomial.X * invX = 1 :=
      IsLocalization.Away.mul_invSelf (R := P_R) (S := S₁) Polynomial.X
    let ψ₁ : MvPolynomial (Fin 2) R₀ →+* S₁ :=
      MvPolynomial.eval₂Hom ((algebraMap P_R S₁).comp Polynomial.C)
        ![algebraMap P_R S₁ Polynomial.X, algebraMap P_R S₁ (Polynomial.C δ) * invX]
    have hψ₁_gen : I_δ ≤ RingHom.ker ψ₁ := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp only [ψ₁, map_sub, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
      calc
        algebraMap P_R S₁ Polynomial.X * (algebraMap P_R S₁ (Polynomial.C δ) * invX) -
            algebraMap P_R S₁ (Polynomial.C δ)
            = algebraMap P_R S₁ (Polynomial.C δ) * (algebraMap P_R S₁ Polynomial.X * invX) -
                algebraMap P_R S₁ (Polynomial.C δ) := by ring
        _ = 0 := by rw [hX_invX, mul_one, sub_self]
    let barψ₁ : A_δ →+* S₁ :=
      Ideal.Quotient.lift I_δ ψ₁ (fun _ hx => RingHom.mem_ker.mp (hψ₁_gen hx))
    have hlam₁_invX : lam₁ invX = t⁻¹ := by
      apply mul_left_cancel₀ ht_ne
      rw [mul_inv_cancel₀ ht_ne]
      have h1 := congrArg lam₁ hX_invX
      have h2 : lam₁ (algebraMap P_R S₁ Polynomial.X) = t := RingHom.congr_fun hlam₁_comp Polynomial.X
      rwa [map_mul, map_one, h2] at h1
    have hlam₁_barψ₁ : lam₁.comp barψ₁ = barΦ := by
      have h_mv : (lam₁.comp barψ₁).comp (Ideal.Quotient.mk I_δ) =
          barΦ.comp (Ideal.Quotient.mk I_δ) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp only [RingHom.comp_apply]
          dsimp [barψ₁, barΦ]
          rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
          dsimp [ψ₁, Φ]
          rw [MvPolynomial.eval₂_C, MvPolynomial.eval₂_C, RingHom.comp_apply]
          exact hlam₁_app (Polynomial.C r)
        · intro i
          fin_cases i
          · simp only [Fin.zero_eta, RingHom.comp_apply]
            dsimp [barψ₁, barΦ]
            rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
            dsimp [ψ₁, Φ]
            rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
            simp only [Matrix.cons_val_zero]
            exact hlam₁_app Polynomial.X
          · simp only [Fin.mk_one, RingHom.comp_apply]
            dsimp [barψ₁, barΦ]
            rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
            dsimp [ψ₁, Φ]
            rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
            simp only [Matrix.cons_val_one, Matrix.cons_val_zero]
            rw [map_mul, hlam₁_invX, hlam₁_app (Polynomial.C δ)]
            rfl
      apply RingHom.ext
      intro x
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact RingHom.congr_fun h_mv P
    have hInt_to_laurent : ∀ w : F, IsIntegral A_δ w → ∃ (f : P_R) (M : ℕ), w = ι_P f * t⁻¹ ^ M := by
      intro w ⟨q, hq_monic, hq_eval⟩
      have hw_S₁ : IsIntegral S₁ w := by
        refine ⟨q.map barψ₁, hq_monic.map barψ₁, ?_⟩
        change Polynomial.eval₂ lam₁ w (q.map barψ₁) = 0
        rw [Polynomial.eval₂_map, hlam₁_barψ₁]
        exact hq_eval
      obtain ⟨y, hy⟩ := (isIntegrallyClosed_iff F).mp hIntClS₁ hw_S₁
      obtain ⟨M, f, hMf⟩ := IsLocalization.Away.surj (Polynomial.X : P_R) y
      refine ⟨f, M, ?_⟩
      have h1 := congrArg lam₁ hMf
      have hy' : lam₁ y = w := hy
      have hX' : lam₁ (algebraMap P_R S₁ Polynomial.X) = t := RingHom.congr_fun hlam₁_comp Polynomial.X
      have hf' : lam₁ (algebraMap P_R S₁ f) = ι_P f := RingHom.congr_fun hlam₁_comp f
      rw [map_mul, map_pow, hy', hX', hf'] at h1
      apply mul_right_cancel₀ (pow_ne_zero M ht_ne)
      rw [h1, mul_assoc, ← mul_pow, inv_mul_cancel₀ ht_ne, one_pow, mul_one]
    let ι₂ : P_R →+* F := Polynomial.eval₂RingHom ι_R u
    have hι₂_inj : Function.Injective ι₂ := by
      rw [injective_iff_map_eq_zero]
      intro g hg
      let D := g.natDegree
      have hg_sum : g = ∑ j ∈ Finset.range (D + 1), Polynomial.monomial j (g.coeff j) :=
        Polynomial.as_sum_range' g (D + 1) (Nat.lt_succ_self D)
      have hPoly0 : ∑ j ∈ Finset.range (D + 1),
          Polynomial.monomial (D - j) (g.coeff j * δ ^ j) = 0 := by
        apply hιP_inj
        rw [map_zero, map_sum]
        have h_term : ∀ j ∈ Finset.range (D + 1),
            ι_P (Polynomial.monomial (D - j) (g.coeff j * δ ^ j)) =
              ι₂ (Polynomial.monomial j (g.coeff j)) * t ^ D := by
          intro j hj
          have hjD : j ≤ D := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
          rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial,
            Polynomial.C_mul, Polynomial.C_pow]
          simp only [map_mul, map_pow]
          dsimp [ι₂]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, Polynomial.eval₂_X]
          change ι_R (g.coeff j) * ι_R δ ^ j * t ^ (D - j) =
            ι_R (g.coeff j) * (ι_R δ * t⁻¹) ^ j * t ^ D
          rw [mul_pow]
          have ht_pow : t⁻¹ ^ j * t ^ D = t ^ (D - j) := by
            apply mul_right_cancel₀ (pow_ne_zero j ht_ne)
            calc
              t⁻¹ ^ j * t ^ D * t ^ j = t ^ D * (t⁻¹ ^ j * t ^ j) := by ring
              _ = t ^ D := by rw [← mul_pow, inv_mul_cancel₀ ht_ne, one_pow, mul_one]
              _ = t ^ (D - j) * t ^ j := by rw [← pow_add, Nat.sub_add_cancel hjD]
          calc
            ι_R (g.coeff j) * ι_R δ ^ j * t ^ (D - j)
                = ι_R (g.coeff j) * ι_R δ ^ j * (t⁻¹ ^ j * t ^ D) := by rw [ht_pow]
            _ = ι_R (g.coeff j) * (ι_R δ ^ j * t⁻¹ ^ j) * t ^ D := by ring
        calc
          ∑ j ∈ Finset.range (D + 1), ι_P (Polynomial.monomial (D - j) (g.coeff j * δ ^ j))
              = ∑ j ∈ Finset.range (D + 1), ι₂ (Polynomial.monomial j (g.coeff j)) * t ^ D :=
            Finset.sum_congr rfl h_term
          _ = (∑ j ∈ Finset.range (D + 1), ι₂ (Polynomial.monomial j (g.coeff j))) * t ^ D :=
            (Finset.sum_mul _ _ _).symm
          _ = ι₂ g * t ^ D := by rw [← map_sum, ← hg_sum]
          _ = 0 := by rw [hg, zero_mul]
      ext j
      rw [Polynomial.coeff_zero]
      by_cases hj : j ≤ D
      · have hc := congrArg (fun q : P_R => q.coeff (D - j)) hPoly0
        simp only [Polynomial.finset_sum_coeff, Polynomial.coeff_monomial, Polynomial.coeff_zero] at hc
        have hc_eq : (∑ i ∈ Finset.range (D + 1),
            if D - i = D - j then g.coeff i * δ ^ i else 0) = g.coeff j * δ ^ j := by
          rw [Finset.sum_eq_single j]
          · simp
          · intro i hi hne
            have hiD : i ≤ D := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            rw [if_neg]
            omega
          · intro hnot
            exact False.elim (hnot (Finset.mem_range.mpr (Nat.lt_succ_of_le hj)))
        rw [hc_eq] at hc
        exact (mul_eq_zero.mp hc).resolve_right (pow_ne_zero j hδ)
      · exact Polynomial.coeff_eq_zero_of_natDegree_lt (Nat.lt_of_not_ge hj)
    obtain ⟨τ, hτ_ιP⟩ : ∃ τ : F →+* F, ∀ f : P_R, τ (ι_P f) = ι₂ f :=
      ⟨IsFractionRing.lift (A := P_R) (K := F) hι₂_inj,
        fun f => IsFractionRing.lift_algebraMap (A := P_R) (K := F) hι₂_inj f⟩
    have hτ_ιR : ∀ r : R₀, τ (ι_R r) = ι_R r := by
      intro r
      change τ (ι_P (Polynomial.C r)) = ι_R r
      rw [hτ_ιP]
      dsimp [ι₂]
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    have hτ_t : τ t = u := by
      change τ (ι_P Polynomial.X) = u
      rw [hτ_ιP]
      dsimp [ι₂]
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have hτ_u : τ u = t := by
      apply mul_left_cancel₀ hu_ne
      have h1 := congrArg τ htu
      rw [map_mul, hτ_t, hτ_ιR] at h1
      rw [h1, ← htu, mul_comm]
    have hτ_tinv : τ t⁻¹ = (ι_R δ)⁻¹ * t := by
      rw [map_inv₀, hτ_t]
      dsimp [u]
      rw [mul_inv_rev, inv_inv, mul_comm]
    let σ_mv : MvPolynomial (Fin 2) R₀ →+* A_δ :=
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I_δ).comp MvPolynomial.C)
        ![Ideal.Quotient.mk I_δ (MvPolynomial.X 1), Ideal.Quotient.mk I_δ (MvPolynomial.X 0)]
    have hσ_gen : I_δ ≤ RingHom.ker σ_mv := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp only [σ_mv, map_sub, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        Matrix.cons_val_zero, Matrix.cons_val_one, RingHom.comp_apply]
      rw [mul_comm, ← map_mul, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
      exact hgen_mem
    let σ_A : A_δ →+* A_δ :=
      Ideal.Quotient.lift I_δ σ_mv (fun _ hx => RingHom.mem_ker.mp (hσ_gen hx))
    have hτ_barΦ : τ.comp barΦ = barΦ.comp σ_A := by
      have h_mv : (τ.comp barΦ).comp (Ideal.Quotient.mk I_δ) =
          (barΦ.comp σ_A).comp (Ideal.Quotient.mk I_δ) := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp only [RingHom.comp_apply]
          dsimp [barΦ, σ_A]
          rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
          dsimp [Φ, σ_mv]
          rw [MvPolynomial.eval₂_C, MvPolynomial.eval₂_C]
          simp only [RingHom.comp_apply]
          rw [Ideal.Quotient.lift_mk]
          dsimp [Φ]
          rw [MvPolynomial.eval₂_C]
          exact hτ_ιR r
        · intro i
          fin_cases i
          · simp only [Fin.zero_eta, RingHom.comp_apply]
            dsimp [barΦ, σ_A]
            rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
            dsimp [Φ, σ_mv]
            rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
            simp only [Matrix.cons_val_zero]
            rw [Ideal.Quotient.lift_mk]
            dsimp [Φ]
            rw [MvPolynomial.eval₂_X]
            simp only [Matrix.cons_val_one, Matrix.cons_val_zero]
            exact hτ_t
          · simp only [Fin.mk_one, RingHom.comp_apply]
            dsimp [barΦ, σ_A]
            rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk]
            dsimp [Φ, σ_mv]
            rw [MvPolynomial.eval₂_X, MvPolynomial.eval₂_X]
            simp only [Matrix.cons_val_one, Matrix.cons_val_zero]
            rw [Ideal.Quotient.lift_mk]
            dsimp [Φ]
            rw [MvPolynomial.eval₂_X]
            simp only [Matrix.cons_val_zero]
            exact hτ_u
      apply RingHom.ext
      intro x
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      exact RingHom.congr_fun h_mv P
    rw [isIntegrallyClosed_iff F]
    intro z hz
    obtain ⟨f₁, M, hz_eq⟩ := hInt_to_laurent z hz
    let D := max (f₁.natDegree + 1) M
    have hf₁_sum : f₁ = ∑ j ∈ Finset.range D, Polynomial.monomial j (f₁.coeff j) :=
      Polynomial.as_sum_range' f₁ D (lt_of_lt_of_le (Nat.lt_succ_self _) (le_max_left _ _))
    have hMD : M ≤ D := le_max_right _ _
    let a_plus : A_δ :=
      ∑ j ∈ Finset.Ico M D,
        Ideal.Quotient.mk I_δ (MvPolynomial.C (f₁.coeff j) * MvPolynomial.X 0 ^ (j - M))
    have hbarΦ_aplus : barΦ a_plus =
        ∑ j ∈ Finset.Ico M D, ι_P (Polynomial.monomial j (f₁.coeff j)) * t⁻¹ ^ M := by
      simp only [a_plus, map_sum]
      apply Finset.sum_congr rfl
      intro j hj
      have hjM : M ≤ j := (Finset.mem_Ico.mp hj).1
      change Φ (MvPolynomial.C (f₁.coeff j) * MvPolynomial.X 0 ^ (j - M)) =
        ι_P (Polynomial.monomial j (f₁.coeff j)) * t⁻¹ ^ M
      simp only [Φ, map_mul, map_pow, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
