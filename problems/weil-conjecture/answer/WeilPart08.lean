            Algebra.smul_def (R := R₁) (A := R_loc), IsScalarTower.algebraMap_apply R₁ D R_loc a]
          exact congrArg (· * ((algebraMap L_Y R_loc) b * c)) (hφ₁_eq a).symm⟩
      exact (Module.flat_iff_of_isLocalization L_Y M_star.primeCompl R_loc).mpr ‹Module.Flat R₁ R_loc›
    have : Module.FaithfullyFlat L_Y R_loc := Module.FaithfullyFlat.of_flat_of_isLocalHom
    let I₁ : Ideal R_loc := Ideal.map φ₁ J_Z
    let I₂ : Ideal R_loc := Ideal.map φ₁ J_Y'
