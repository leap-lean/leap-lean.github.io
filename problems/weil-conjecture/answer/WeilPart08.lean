        rw [← map_mul, hmul0, map_zero]
      rcases mul_eq_zero.mp hsymm_mul with h1 | h2
      · have : u₁ i = 0 := by
          have hu : u₁ = 0 := by simpa using congrArg e_prod h1
          rw [hu]; rfl
        simp [u₁] at this
      · have : u₂ i₀ = 0 := by
          have hu : u₂ = 0 := by simpa using congrArg e_prod h2
          rw [hu]; rfl
        simp [u₂] at this
