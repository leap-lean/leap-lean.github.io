        exact mul_right_cancel₀ hDb0 (by simpa [mul_comm] using hEq_D.symm)
      · have hadvd : a ∣ (b : R) :=
          ((ValuationRing.iff_dvd_total (R := R)).mp inferInstance).total a b |>.resolve_right hdvd
        obtain ⟨m, hm⟩ := hadvd
        have ha0 : a ≠ 0 := by rintro rfl; rw [zero_mul] at hm; exact hb0 hm
        have hm_not_unit : ¬ IsUnit m := by
          rintro ⟨u, rfl⟩
          exact hdvd ⟨↑u⁻¹, by rw [hm, mul_assoc, Units.mul_inv, mul_one]⟩
        have hm_max : m ∈ IsLocalRing.maximalIdeal R := by
          by_contra hm_not
          exact hm_not_unit (IsLocalRing.notMem_maximalIdeal.mp hm_not)
        have hDa0 : algebraMap R D a ≠ 0 :=
          fun h0 => ha0 (hInjRD (h0.trans (map_zero _).symm))
        have h_unit : d * algebraMap R D m = 1 := by
          apply mul_left_cancel₀ hDa0
          calc
            algebraMap R D a * (d * algebraMap R D m) =
                d * (algebraMap R D a * algebraMap R D m) := by ring
            _ = d * algebraMap R D b := by rw [← map_mul, ← hm]
            _ = algebraMap R D a * 1 := by rw [hEq_D, mul_one]
