          intro z
          have hΦδ : Φ (Algebra.H1Cotangent.δ R (MvPolynomial (Fin 2) R) S₆ z) = 0 :=
            (Algebra.H1Cotangent.exact_δ_mapBaseChange R
              (MvPolynomial (Fin 2) R) S₆).apply_apply_eq_zero z
          have hδ0 : Algebra.H1Cotangent.δ R (MvPolynomial (Fin 2) R) S₆ z = 0 := by
            rw [← hΨΦ (Algebra.H1Cotangent.δ R (MvPolynomial (Fin 2) R) S₆ z), hΦδ, map_zero]
