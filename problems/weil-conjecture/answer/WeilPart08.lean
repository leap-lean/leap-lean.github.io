        (fstY.resLE V_sm_C W_sm_Y le_rfl) (W_sm_Y.ι ≫ sndY) (V_sm_C.ι ≫ g) s₀ :=
      hPb_open.paste_vert (CategoryTheory.IsPullback.of_hasPullback g s₀)
    have hSm_WsmY : SmoothOfRelativeDimension 1 (W_sm_Y.ι ≫ sndY) :=
      (smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback hPb_paste hSm_VsmC
    let W_away : Y.Opens := q_s₀ ⁻¹ᵁ U_away
    have hqj_Waway : q_j ∈ W_away := hyj_away
    let O_1 : W_away.toScheme.Opens := (TopologicalSpace.Opens.map W_away.ι.base).obj W_sm_Y
    have hqj_O1 : (⟨q_j, hqj_Waway⟩ : ↥W_away.toScheme) ∈ O_1 := hqj_WsmY
    let e_1 : O_1.toScheme ⟶ Y_next := O_1.ι ≫ (q_s₀ ∣_ U_away) ≫ U_away.ι
    have : IsOpenImmersion e_1 := inferInstance
    let W_sm : Y_next.Opens := e_1.opensRange
    have hyj_Wsm : y_j ∈ W_sm := by
      refine ⟨⟨⟨q_j, hqj_Waway⟩, hqj_O1⟩, ?_⟩
      dsimp only [e_1]
      change ((q_s₀ ∣_ U_away) ≫ U_away.ι).base ⟨q_j, hqj_Waway⟩ = y_j
      rw [morphismRestrict_ι q_s₀ U_away]
      rfl
    have hRange_O1_WsmY : Set.range (O_1.ι ≫ W_away.ι).base ⊆ Set.range W_sm_Y.ι.base := by
      rintro _ ⟨z, rfl⟩
      exact ⟨⟨z.1.1, z.2⟩, rfl⟩
    let j_WsmY : O_1.toScheme ⟶ W_sm_Y.toScheme :=
      IsOpenImmersion.lift W_sm_Y.ι (O_1.ι ≫ W_away.ι) hRange_O1_WsmY
    have hj_WsmY_fac : j_WsmY ≫ W_sm_Y.ι = O_1.ι ≫ W_away.ι :=
      IsOpenImmersion.lift_fac W_sm_Y.ι (O_1.ι ≫ W_away.ι) hRange_O1_WsmY
    have : IsOpenImmersion j_WsmY := by
      have : IsOpenImmersion (j_WsmY ≫ W_sm_Y.ι) := by rw [hj_WsmY_fac]; infer_instance
      exact IsOpenImmersion.of_comp j_WsmY W_sm_Y.ι
    have h_iso_ι1 : e_1.isoOpensRange.inv ≫ e_1 = W_sm.ι := by
      rw [← cancel_epi e_1.isoOpensRange.hom, ← Category.assoc,
        e_1.isoOpensRange.hom_inv_id, Category.id_comp]
      exact (Scheme.Hom.isoOpensRange_hom_ι e_1).symm
    have hWsm_hom1 : W_sm.ι ≫ snd_next =
        (e_1.isoOpensRange.inv ≫ j_WsmY) ≫ (W_sm_Y.ι ≫ sndY) := by
      calc
        W_sm.ι ≫ snd_next = (e_1.isoOpensRange.inv ≫ e_1) ≫ snd_next := by rw [h_iso_ι1]
        _ = e_1.isoOpensRange.inv ≫ O_1.ι ≫ ((q_s₀ ∣_ U_away) ≫ U_away.ι) ≫ snd_next := by
            simp only [e_1, Category.assoc]
        _ = e_1.isoOpensRange.inv ≫ (O_1.ι ≫ W_away.ι) ≫ sndY := by
            rw [morphismRestrict_ι q_s₀ U_away]; dsimp only [W_away]; simp only [Category.assoc, hq_snd]
        _ = (e_1.isoOpensRange.inv ≫ j_WsmY) ≫ (W_sm_Y.ι ≫ sndY) := by
            rw [← hj_WsmY_fac]; simp only [Category.assoc]
    have : SmoothOfRelativeDimension 0 (e_1.isoOpensRange.inv ≫ j_WsmY) := inferInstance
    have hSm_Wsm1 : SmoothOfRelativeDimension 1 (W_sm.ι ≫ snd_next) := by
      rw [hWsm_hom1]
      simpa using smoothOfRelativeDimension_comp 0 1
        (e_1.isoOpensRange.inv ≫ j_WsmY) (W_sm_Y.ι ≫ sndY)
    exact ⟨b₀, y_j, W_sm, hyj_Wsm, hfst_yj, hSm_Wsm1⟩

theorem weil_sup1_contracted_model_and_smooth_markings (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀)
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (hProjMap : IsUnstableP1ContractionProjMap V g Z V₀ V₁ eZ N' φ) :
    let C_next := AlgebraicGeometry.Scheme.Hom.image φ
    let g_next := AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom
    let τ_next := fun j : Fin n => τ j ≫ AlgebraicGeometry.Scheme.Hom.toImage φ
    let ι_next := ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ
    IsValuationPointedCurveModel V p_K n σ_K C_next g_next τ_next ι_next ∧
    (_root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_next i).base) (Set.range (τ_next j).base)) ∧
    (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      ∃ V_sm : C_next.Opens,
        (τ_next j).base b ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_next)) :=
by
  classical
  intro C_next g_next τ_next ι_next
  
  have hPropGen : ∀ (R : Type u) [CommRing R] (N : ℕ),
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom := by
    intro R _ N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have halg0 : ∀ r : R,
        (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r := by
      intro r
      rw [Algebra.algebraMap_eq_smul_one]
      change r • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r
      rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hinj : Function.Injective (algebraMap R ↥(𝒜 0)) := by
      intro r₁ r₂ h
      have h1 : (algebraMap R ↥(𝒜 0) r₁ : MvPolynomial (Fin (N + 1)) R) =
          (algebraMap R ↥(𝒜 0) r₂ : MvPolynomial (Fin (N + 1)) R) := congrArg Subtype.val h
      rw [halg0, halg0] at h1
      simpa using congrArg MvPolynomial.constantCoeff h1
    have hsurj : Function.Surjective (algebraMap R ↥(𝒜 0)) := by
      intro p
      refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
      rw [halg0]
      ext μ
      by_cases hμ : μ = 0
      · subst hμ
        simp
      · rw [MvPolynomial.coeff_C]
        simp only [Ne.symm hμ, ↓reduceIte]
        symm
        by_contra hne
        have hp : p.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
        have hdeg := hp hne
        simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
        have hne' : ∃ i : Fin (N + 1), μ i ≠ 0 := by
          by_contra hall
          exact hμ (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
        rcases hne' with ⟨i, hi⟩
        exact hi ((Finset.sum_eq_zero_iff.mp hdeg) i (Finsupp.mem_support_iff.mpr hi))
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))).mpr
        ⟨hinj, hsurj⟩
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) :=
      inferInstance
    let _ : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      IsScalarTower.of_algebraMap_eq' (R := R) (S := ↥(𝒜 0))
        (A := MvPolynomial (Fin (N + 1)) R) (RingHom.ext fun r => by
          change algebraMap R (MvPolynomial (Fin (N + 1)) R) r =
            (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R)
          rw [halg0, MvPolynomial.algebraMap_eq])
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))))
    infer_instance
  have hPropP_next : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver ↥V N').hom :=
    hPropGen ↥V N'
  have hProp_next : AlgebraicGeometry.IsProper g_next := by
    dsimp only [g_next]
    infer_instance
  
  obtain ⟨hIntC, _hFlatG, hPropG, _hLFPG, _hSurjG, _hProjG, hSecG, hPbC, hSecι⟩ := hSemi.1
  obtain ⟨hInt_next, hFlat_next, hLFP_next⟩ :=
    weil_sup1_image_integral_flat_and_lfp K m V hPkg C_K C p_K g ι
      hIntCK hIntC hPropG hPbC N' φ hProjMap.1
  have hPb_next : CategoryTheory.IsPullback ι_next p_K g_next
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) :=
    weil_sup1_generic_fiber_pullback_iso K m V hPkg C_K p_K n σ_K
      hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi.1 Z V₀ V₁ h₀ eZ eY t₀ hPencil N' φ hProjMap
  have hSec_next : ∀ j : Fin n,
      τ_next j ≫ g_next = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of ↥V)) := by
    intro j
    dsimp only [τ_next, g_next]
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.Hom.toImage φ),
      AlgebraicGeometry.Scheme.Hom.toImage_imageι φ, hProjMap.1]
    exact hSecG j
  have hSurj_next : AlgebraicGeometry.Surjective g_next := by
    let j₀ : Fin n := ⟨0, by have := hStabCK.1; omega⟩
    have _ : AlgebraicGeometry.Surjective (τ_next j₀ ≫ g_next) := by
      rw [hSec_next j₀]
      infer_instance
    exact AlgebraicGeometry.Surjective.of_comp (τ_next j₀) g_next
  have hSecι_next : ∀ j : Fin n,
      σ_K j ≫ ι_next =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) ≫ τ_next j := by
    intro j
    dsimp only [ι_next, τ_next]
    rw [← CategoryTheory.Category.assoc, hSecι j, CategoryTheory.Category.assoc]
  have hMod_next : IsValuationPointedCurveModel V p_K n σ_K C_next g_next τ_next ι_next :=
    ⟨hInt_next, hFlat_next, hProp_next, hLFP_next, hSurj_next,
      ⟨N', AlgebraicGeometry.Scheme.Hom.imageι φ, inferInstance, rfl⟩,
      hSec_next, hPb_next, hSecι_next⟩
  
  obtain ⟨hDisj_next, hClosedSm⟩ :=
    weil_sup1_closed_fiber_markings_disjoint_and_smooth K m V hMaxNeBot hPkg
      C_K p_K n σ_K C g τ ι hSemi Z Z_sch ιZ hUnstab V₀ V₁ h₀ eZ eY t₀ hPencil N' φ hProjMap
  refine ⟨hMod_next, hDisj_next, ?_⟩
  intro j b
  obtain ⟨b₀, y_j, W_sm, hy_j, hfst_yj, hSm_W⟩ := hClosedSm j
  obtain ⟨V_sm, hx_Vsm, hSm_V⟩ :=
    weil_localRing_flat_lfp_fiber_smoothOfRelDim_lift ↥V C_next g_next
      hFlat_next hLFP_next y_j W_sm hy_j hSm_W
  rw [hfst_yj] at hx_Vsm
  refine ⟨V_sm, ?_, hSm_V⟩
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
  let S_open : Set (PrimeSpectrum ↥V) := fun p => (τ_next j).base p ∈ V_sm
  have hOpen : IsOpen S_open := V_sm.2.preimage (τ_next j).continuous
  obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal S_openᶜ).mp hOpen.isClosed_compl
  by_contra hb
  have hb_zero : (b : PrimeSpectrum ↥V) ∈ PrimeSpectrum.zeroLocus (I : Set ↥V) := by
    rw [← hI]
    exact hb
  have hI_le_b : (I : Set ↥V) ⊆ ((b : PrimeSpectrum ↥V).asIdeal : Set ↥V) := hb_zero
  have hb_le_max : (b : PrimeSpectrum ↥V).asIdeal ≤ IsLocalRing.maximalIdeal ↥V :=
    IsLocalRing.le_maximalIdeal (b : PrimeSpectrum ↥V).isPrime.ne_top
  have hmax_le_s₀ : IsLocalRing.maximalIdeal ↥V ≤ (s₀.base b₀ : PrimeSpectrum ↥V).asIdeal := by
    intro x hx
    change algebraMap ↥V k₀ x ∈ (b₀ : PrimeSpectrum k₀).asIdeal
    rw [(Ideal.algebraMap_residueField_eq_zero (I := IsLocalRing.maximalIdeal ↥V)).mpr hx]
    exact (b₀ : PrimeSpectrum k₀).asIdeal.zero_mem
  have hs₀_zero : (s₀.base b₀ : PrimeSpectrum ↥V) ∈ PrimeSpectrum.zeroLocus (I : Set ↥V) :=
    hI_le_b.trans (hb_le_max.trans hmax_le_s₀)
  rw [← hI] at hs₀_zero
  exact hs₀_zero hx_Vsm

theorem weil_sup1_geom_fiber_threeWay_dichotomy_baseChange (k₁ K' : Type u) [Field k₁] [Field K']
    (ψ : k₁ →+* K')
    (X₀ X' : AlgebraicGeometry.Scheme.{u})
    (p₀ : X₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
    (p' : X' ⟶ AlgebraicGeometry.Spec (CommRingCat.of K'))
    (π : X' ⟶ X₀)
    (hPb : CategoryTheory.IsPullback π p' p₀
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)))
    (hDich₀ : ∀ y₀ : ↥X₀,
      (∃ V_sm : X₀.Opens,
        y₀ ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p₀)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ X₀)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k₁ ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k₁) *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) k₁)}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y₀ ∧
        (∀ i : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) k₁) ∈
            (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p₀ =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : k₁ →+* MvPolynomial (Fin 2) k₁)))) ∨
      HasTwoPointPinchAt k₁ p₀ y₀) :
    ∀ y : ↥X',
      (∃ V_sm : X'.Opens,
        y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p')) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ X')
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) K' ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K') ∈
            (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p' =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K')))) ∨
      HasTwoPointPinchAt K' p' y :=
by
  let u_ψ : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
      AlgebraicGeometry.Spec (CommRingCat.of k₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
  intro y
  let y₀ : ↥X₀ := π.base y
  rcases hDich₀ y₀ with ⟨V_sm, hy₀_V, hSm₀⟩ |
    ⟨U'₀, u₀, e₁, e₂, hEt₁, hEt₂, hu₀_y₀, hXi₀, he_comm₀⟩ | hPinch₀
  · 
    left
    let V'_sm : X'.Opens := (TopologicalSpace.Opens.map π.base).obj V_sm
    have hy_V' : y ∈ V'_sm := hy₀_V
    have hPb_sm : CategoryTheory.IsPullback (π ∣_ V_sm) (V'_sm.ι ≫ p') (V_sm.ι ≫ p₀) u_ψ :=
      (AlgebraicGeometry.isPullback_morphismRestrict π V_sm).paste_vert hPb
    exact ⟨V'_sm, hy_V',
      (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
        hPb_sm hSm₀⟩
  · 
    right
    left
    let P₁ := MvPolynomial (Fin 2) k₁
    let I₁ : Ideal P₁ :=
      Ideal.span {(MvPolynomial.X 0 : P₁) * (MvPolynomial.X 1 : P₁)}
    let R_nod₁ := P₁ ⧸ I₁
    let mk₁ : P₁ →+* R_nod₁ := Ideal.Quotient.mk I₁
    let ι_nod₁ : k₁ →+* R_nod₁ := mk₁.comp (MvPolynomial.C : k₁ →+* P₁)
    let P₂ := MvPolynomial (Fin 2) K'
    let I₂ : Ideal P₂ :=
      Ideal.span {(MvPolynomial.X 0 : P₂) * (MvPolynomial.X 1 : P₂)}
    let R_nod₂ := P₂ ⧸ I₂
    let mk₂ : P₂ →+* R_nod₂ := Ideal.Quotient.mk I₂
    let ι_nod₂ : K' →+* R_nod₂ := mk₂.comp (MvPolynomial.C : K' →+* P₂)
    let ψ_raw : P₁ →+* R_nod₂ := mk₂.comp (MvPolynomial.map ψ)
    have hmk₂_X01 : mk₂ ((MvPolynomial.X 0 : P₂) * (MvPolynomial.X 1 : P₂)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hmk₁_X01 : mk₁ ((MvPolynomial.X 0 : P₁) * (MvPolynomial.X 1 : P₁)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    have hψ_vanish : ∀ p ∈ I₁, ψ_raw p = 0 := by
      intro p hp
      obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hp
      change mk₂ (MvPolynomial.map ψ (((MvPolynomial.X 0 : P₁) * MvPolynomial.X 1) * q)) = 0
      rw [map_mul (MvPolynomial.map ψ), map_mul mk₂,
        map_mul (MvPolynomial.map ψ), MvPolynomial.map_X, MvPolynomial.map_X,
        hmk₂_X01, zero_mul]
    let ψ_nod : R_nod₁ →+* R_nod₂ := Ideal.Quotient.lift I₁ ψ_raw hψ_vanish
    have hψ_nod_C : ∀ a : k₁, ψ_nod (mk₁ (MvPolynomial.C a)) = mk₂ (MvPolynomial.C (ψ a)) := by
      intro a
      dsimp only [ψ_nod, mk₁, ψ_raw]
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
    have hψ_nod_X : ∀ i : Fin 2, ψ_nod (mk₁ (MvPolynomial.X i)) = mk₂ (MvPolynomial.X i) := by
      intro i
      dsimp only [ψ_nod, mk₁, ψ_raw]
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X]
    let f_ring : CommRingCat.of k₁ ⟶ CommRingCat.of R_nod₁ := CommRingCat.ofHom ι_nod₁
    let g_ring : CommRingCat.of k₁ ⟶ CommRingCat.of K' := CommRingCat.ofHom ψ
    let inl_ring : CommRingCat.of R_nod₁ ⟶ CommRingCat.of R_nod₂ := CommRingCat.ofHom ψ_nod
    let inr_ring : CommRingCat.of K' ⟶ CommRingCat.of R_nod₂ := CommRingCat.ofHom ι_nod₂
    have h_ring_comm : f_ring ≫ inl_ring = g_ring ≫ inr_ring := by
      apply CommRingCat.hom_ext
      ext a
      exact hψ_nod_C a
    let desc_poly : ∀ (s : CategoryTheory.Limits.PushoutCocone f_ring g_ring), P₂ →+* s.pt :=
