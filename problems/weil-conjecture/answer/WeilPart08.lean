        · simp only [Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
          rw [pre_Ah.jacobiMatrix_apply]; exact hpderiv_inr_inl (G b)
        · simp only [Matrix.fromBlocks_apply₂₂, D₂₂, Matrix.of_apply]
          rw [pre_Ah.jacobiMatrix_apply]
