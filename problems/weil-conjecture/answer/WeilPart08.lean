    intro hEtDomR U f hEt u₀ hu₀
    classical
    obtain ⟨V, hAffV, hu₀V, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := u₀) (U := (⊤ : U.Opens)) trivial
    let B : Type u := ↑(U.presheaf.obj (Opposite.op V))
