        _ = (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one) ≫ p_R := by
          rw [AlgebraicGeometry.Proj.awayι_comp_map f_gr hf_irrel zero_lt_one
            (MvPolynomial.X a) (hX_mem R N a)]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
                  (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0)))) := by
          rw [Category.assoc, haway_pR a]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((HomogeneousLocalization.fromZeroRingHom 𝒜_S
                (Submonoid.powers (f_gr (MvPolynomial.X a)))).comp (algebraMap S ↥(𝒜_S 0)))) ≫
