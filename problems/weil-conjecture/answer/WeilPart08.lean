    exact h_ap
  have hCut1 : ∀ b : Fin (M + 1), E b ⊓ V₁ = X.basicOpen (Φ₁ (P_tilde b)) := by
    apply hCutUniv V₁ (fun μ => Φ₁ (P_tilde μ))
    · refine ⟨fun μ => Φ₁ (B μ), ?_⟩
      calc
        ∑ μ : Fin (M + 1), Φ₁ (B μ) * Φ₁ (P_tilde μ)
          = Φ₁ (∑ μ : Fin (M + 1), B μ * P_tilde μ) := by simp only [map_sum, map_mul]
        _ = 1 := by rw [hBezoutB, map_one]
    · intro β μ hEβ
      have hW1 : Nonempty ↥(E β ⊓ V₁) := hInter (E β) V₁ hEβ hNe1
      apply hJ1 (E β ⊓ V₁) hW1
      rw [map_mul,
        hJ2 (E β) (E β ⊓ V₁) hEβ hW1 inf_le_left,
        hJ2 V₁ (E β ⊓ V₁) hNe1 hW1 inf_le_right,
        hJ2 V₁ (E β ⊓ V₁) hNe1 hW1 inf_le_right,
        hj_f1 β, hj_f1 μ]
      calc
        j_open (E β) hEβ (η β μ) * (v_F ^ d_E * ι (P β))
          = v_F ^ d_E * (j_open (E β) hEβ (η β μ) * ι (P β)) := by ring
        _ = v_F ^ d_E * ι (P μ) := by rw [hRatioAll β hEβ μ]
  
  refine ⟨P, d_E, hd_E, hPa₀, hDegLE, hDegEq, hCoprime, hScalarAll a₀ hNe, hRatio, ?_⟩
  intro b hPb i
  let R₀ := ↑(X.presheaf.obj (Opposite.op V₀))
  let q_bot : PrimeSpectrum R₀ := ⟨RingHom.ker Φ₀.symm.toRingHom, RingHom.ker_isPrime _⟩
  have hq_bo : q_bot ∈ PrimeSpectrum.basicOpen (Φ₀ (P b)) := by
    rw [PrimeSpectrum.mem_basicOpen]
    intro hMem
    apply hPb
    have h0 : Φ₀.symm (Φ₀ (P b)) = 0 := hMem
    simpa using h0
  have hx_bo : hAff0.fromSpec.base q_bot ∈ X.basicOpen (Φ₀ (P b)) := by
    have hPre := hAff0.fromSpec_preimage_basicOpen (Φ₀ (P b))
    have hq' : q_bot ∈
        (TopologicalSpace.Opens.map hAff0.fromSpec.base).obj (X.basicOpen (Φ₀ (P b))) := by
      rwa [hPre]
    exact hq'
  rw [← hCut0 b] at hx_bo
  have hEb : Nonempty ↥(E b) := ⟨⟨hAff0.fromSpec.base q_bot, hx_bo.1⟩⟩
  obtain ⟨σ, hσ⟩ := hJ5 (E b) hEb d_E (P b) hPb (hDegLE b) (hCut0 b) (hCut1 b) i
  obtain ⟨x_lift, hx_lift⟩ := ψ.app_surjective (U_M b) (hAffK b) σ
  obtain ⟨N, c, h1N, hx_eq⟩ := hGenK b x_lift
  refine ⟨N, c, h1N, ?_⟩
  apply hInj_ι
  have hPowN : (ι (P b)) ^ N = (ι (P b)) ^ (N - 1) * ι (P b) := by
    conv_lhs => rw [← Nat.sub_add_cancel h1N, pow_succ]
  have hLHS : j_open (E b) hEb σ * (ι (P b)) ^ N =
      ι ((P b) ^ (N - 1) * Polynomial.X ^ (i : ℕ)) := by
    calc
      j_open (E b) hEb σ * (ι (P b)) ^ N
        = (j_open (E b) hEb σ * ι (P b)) * (ι (P b)) ^ (N - 1) := by
            rw [hPowN]
            ring
      _ = ι (Polynomial.X ^ (i : ℕ)) * (ι (P b)) ^ (N - 1) := by rw [hσ]
      _ = ι ((P b) ^ (N - 1) * Polynomial.X ^ (i : ℕ)) := by
            simp only [map_mul, map_pow]
            ring
  have hRHS : j_open (E b) hEb σ * (ι (P b)) ^ N =
      ι (∑ e : weilDegMonomialIdx M N,
          Polynomial.C (c e) * ∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ)) := by
    have hσ_exp : j_open (E b) hEb σ =
        ∑ e : weilDegMonomialIdx M N,
          ι (Polynomial.C (c e)) *
            ∏ μ : Fin (M + 1), (j_open (E b) hEb (η b μ)) ^ (e.1 μ : ℕ) := by
      rw [← hx_lift, hx_eq, map_sum, map_sum]
      refine Finset.sum_congr rfl fun e _ => ?_
      rw [map_mul, map_mul, hScalarAll b hEb (c e), map_prod, map_prod]
      congr 1
      refine Finset.prod_congr rfl fun μ _ => ?_
      rw [map_pow, map_pow]
    rw [hσ_exp, Finset.sum_mul, map_sum]
    refine Finset.sum_congr rfl fun e _ => ?_
    have hPowSum : (ι (P b)) ^ N = ∏ μ : Fin (M + 1), (ι (P b)) ^ (e.1 μ : ℕ) := by
      rw [Finset.prod_pow_eq_pow_sum, e.2]
    rw [mul_assoc, hPowSum, ← Finset.prod_mul_distrib, map_mul, map_prod]
    congr 1
    refine Finset.prod_congr rfl fun μ _ => ?_
    rw [← mul_pow, hRatioAll b hEb μ, map_pow]
  exact hLHS.symm.trans hRHS

