      (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (_hProp_R : AlgebraicGeometry.IsProper g_R)
      (j_P : X_P ⟶ C_R)
      (_hRange_P : Set.range j_P.base = {x : C_R | (g_R.base x).asIdeal = ⊥})
      (i_Y : Y ⟶ C_R)
      (_hCl_Y : AlgebraicGeometry.IsClosedImmersion i_Y)
      (_hRange_Y : Set.range i_Y.base = {x : C_R | (g_R.base x).asIdeal = IsLocalRing.maximalIdeal R})
      (E : Set ↥X_P) (_hE : E ∈ irreducibleComponents ↥X_P),
      (i_Y.base ⁻¹' closure (j_P.base '' E)).Nonempty ∧
      ∀ (y : ↥Y), y ∈ i_Y.base ⁻¹' closure (j_P.base '' E) →
