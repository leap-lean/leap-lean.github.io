    let φ₀ : R₀ →+* K := (Polynomial.evalRingHom (0 : K)).comp Φ₀.symm.toRingHom
    let φ₁ : R₀ →+* K := (Polynomial.evalRingHom (1 : K)).comp Φ₀.symm.toRingHom
    let q₀ : PrimeSpectrum R₀ := ⟨RingHom.ker φ₀, RingHom.ker_isPrime φ₀⟩
    let q₁ : PrimeSpectrum R₀ := ⟨RingHom.ker φ₁, RingHom.ker_isPrime φ₁⟩
    have hq_ne : q₀ ≠ q₁ := by
      intro hEq
      have hx0 : Φ₀ Polynomial.X ∈ q₀.asIdeal := by
        change φ₀ (Φ₀ Polynomial.X) = 0
        simp [φ₀]
      have hx1 : Φ₀ Polynomial.X ∈ q₁.asIdeal := hEq ▸ hx0
      change φ₁ (Φ₀ Polynomial.X) = 0 at hx1
      simp [φ₁] at hx1
    have := hAff0.isOpenImmersion_fromSpec
    have hInj0 : Function.Injective hAff0.fromSpec.base :=
      (AlgebraicGeometry.Scheme.Hom.isOpenEmbedding hAff0.fromSpec).toIsEmbedding.injective
    have hx0_V0 : hAff0.fromSpec.base q₀ ∈ (V₀ : Set ↥X) := by
      rw [← hAff0.range_fromSpec]
      exact ⟨q₀, rfl⟩
    have hx1_V0 : hAff0.fromSpec.base q₁ ∈ (V₀ : Set ↥X) := by
      rw [← hAff0.range_fromSpec]
      exact ⟨q₁, rfl⟩
    have hx0_in : hAff0.fromSpec.base q₀ ∈ Set.range (hAffE a₀).fromSpec.base := by
      rw [(hAffE a₀).range_fromSpec]
      exact hV0_le hx0_V0
    have hx1_in : hAff0.fromSpec.base q₁ ∈ Set.range (hAffE a₀).fromSpec.base := by
      rw [(hAffE a₀).range_fromSpec]
      exact hV0_le hx1_V0
    rcases hx0_in with ⟨p₀, hp₀⟩
    rcases hx1_in with ⟨p₁, hp₁⟩
    have hp_eq : p₀ = p₁ :=
      PrimeSpectrum.comap_injective_of_surjective κ₀ hSurj_κ₀ (Subsingleton.elim _ _)
    exact hq_ne (hInj0 (hp₀.symm.trans ((congrArg (hAffE a₀).fromSpec.base hp_eq).trans hp₁)))
  
  let rev : ℕ → Polynomial K → Polynomial K :=
    fun d Q => ∑ j : Fin (d + 1), Polynomial.C (Q.coeff (j : ℕ)) * Polynomial.X ^ (d - (j : ℕ))
