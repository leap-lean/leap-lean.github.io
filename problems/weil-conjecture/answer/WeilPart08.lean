    have hW_top : (⨆ a : Fin (N + 1), W_pb a) = ⊤ := by
      have hCov_R : (⨆ a : Fin (N + 1), D_R a) = ⊤ := (hProperCover R N).2.2
      rw [eq_top_iff]
      intro z _
