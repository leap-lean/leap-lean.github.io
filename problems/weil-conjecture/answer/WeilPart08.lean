          (Polynomial.eval₂RingHom φ_R u_B).Finite →
          AlgebraicGeometry.IsOpenImmersion ψ_R →
          ψ_R ≫ g_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R) →
          i_Y.base y ∈ Set.range ψ_R.base →
