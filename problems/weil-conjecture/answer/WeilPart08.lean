          dsimp only [j_sm, j_UW]
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (j_UW ∣_ V_sm),
            AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc]
        have : AlgebraicGeometry.IsOpenImmersion j_sm := inferInstance
        have : AlgebraicGeometry.SmoothOfRelativeDimension 0 j_sm := inferInstance
        refine ⟨V_next, hy_Vnext, ?_⟩
        rw [hj_sm_snd]
        simpa using AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 j_sm (V_sm.ι ≫ p_s)
      · right
        left
        let U'_W : U'.Opens := (TopologicalSpace.Opens.map e₁.base).obj W_y
        have hu₀_W : u₀ ∈ U'_W := by
          change e₁.base u₀ ∈ W_y
          rw [hu₀_x]
          exact (f_U_inv.base ⟨y, hy_Uy⟩).2
        let e₁_next : U'_W.toScheme ⟶ X_next_s := (e₁ ∣_ W_y) ≫ f_U ≫ U_y.ι
        let e₂_next : U'_W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) K' ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')})) :=
          U'_W.ι ≫ e₂
        have : AlgebraicGeometry.Etale (e₁ ∣_ W_y) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (AlgebraicGeometry.isPullback_morphismRestrict e₁ W_y).flip hEt₁
        refine ⟨U'_W.toScheme, ⟨u₀, hu₀_W⟩, e₁_next, e₂_next,
          inferInstance, inferInstance, ?_, ?_, ?_⟩
        · have hW_eq : W_y.ι.base ((e₁ ∣_ W_y).base ⟨u₀, hu₀_W⟩) =
              W_y.ι.base (f_U_inv.base ⟨y, hy_Uy⟩) := by
            have h1 := congrArg (fun h => h.base ⟨u₀, hu₀_W⟩)
              (AlgebraicGeometry.morphismRestrict_ι e₁ W_y)
            change W_y.ι.base ((e₁ ∣_ W_y).base ⟨u₀, hu₀_W⟩) = e₁.base u₀ at h1
            exact h1.trans hu₀_x
          have h_sub_eq : (e₁ ∣_ W_y).base ⟨u₀, hu₀_W⟩ = f_U_inv.base ⟨y, hy_Uy⟩ :=
            W_y.ι.isOpenEmbedding.injective hW_eq
          have hf_eq : f_U.base ((e₁ ∣_ W_y).base ⟨u₀, hu₀_W⟩) = ⟨y, hy_Uy⟩ := by
            rw [h_sub_eq]
            change (f_U_inv ≫ f_U).base ⟨y, hy_Uy⟩ = ⟨y, hy_Uy⟩
            rw [CategoryTheory.IsIso.inv_hom_id f_U]
            rfl
          change U_y.ι.base (f_U.base ((e₁ ∣_ W_y).base ⟨u₀, hu₀_W⟩)) = y
          rw [hf_eq]
          rfl
        · intro i
          exact hXi i
        · dsimp only [e₁_next, e₂_next]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hf_U_snd,
            ← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            CategoryTheory.Category.assoc, he_comm, CategoryTheory.Category.assoc]
  · intro q_s₀ hClosed hSurj ⟨y_star, hPre, hInj⟩
    have hFinY : (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)).Finite :=
      hPencil.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
    have hZ_comp : Z ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀) := hUnstab.1
    have hΔ_ge1 : 1 ≤
        (Z ∩ ⋃ E' ∈ (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)) \ {Z},
          E').ncard :=
      hUnstab.2.2.2.2.2.2.2.2.2.1
    have hMeet :
        (Z ∩ ⋃ E' ∈ (irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)) \ {Z},
          E').Nonempty :=
      Set.nonempty_of_ncard_ne_zero (by omega)
    exact weil_sup1_closed_contraction_irreducibleComponents_drop
      ↥(CategoryTheory.Limits.pullback g s₀)
      ↥(CategoryTheory.Limits.pullback g_next s₀)
      q_s₀.base Z y_star q_s₀.continuous hClosed hSurj hPre hInj hFinY hZ_comp hMeet

theorem weil_henselian_algClosed_etale_away_bijective (R : Type u) [CommRing R] [HenselianLocalRing R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (C₀ : Type u) [CommRing C₀] [Algebra R C₀] [Algebra.Etale R C₀]
    (q_z : Ideal C₀) [q_z.IsPrime]
    (hq_comap : Ideal.comap (algebraMap R C₀) q_z = IsLocalRing.maximalIdeal R) :
    ∃ h : C₀, h ∉ q_z ∧ Function.Bijective (algebraMap R (Localization.Away h)) :=
by
  
  obtain ⟨f₁, hf₁_qz, ⟨⟨P, x, hx_map, hlift_bij⟩⟩⟩ :=
    Algebra.IsEtaleAt.exists_isStandardEtale (R := R) q_z
  let S₁ := Localization.Away f₁
  have hdisj : Disjoint (Submonoid.powers f₁ : Set C₀) (q_z : Set C₀) := by
    rw [Set.disjoint_left]
    rintro _ ⟨k, rfl⟩ hk_mem
    exact hf₁_qz (Ideal.IsPrime.mem_of_pow_mem inferInstance k hk_mem)
  let q₁ : Ideal S₁ := Ideal.map (algebraMap C₀ S₁) q_z
  have : q₁.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers f₁) S₁ q_z inferInstance hdisj
  have hq₁_under_C₀ : Ideal.comap (algebraMap C₀ S₁) q₁ = q_z :=
    IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers f₁) S₁ inferInstance hdisj
  have hq₁_under_R : Ideal.comap (algebraMap R S₁) q₁ = IsLocalRing.maximalIdeal R := by
    rw [IsScalarTower.algebraMap_eq R C₀ S₁, ← Ideal.comap_comap, hq₁_under_C₀, hq_comap]
  
  let D₁ := S₁ ⧸ q₁
  have : IsDomain D₁ := Ideal.Quotient.isDomain q₁
  let π₁ : S₁ →+* D₁ := Ideal.Quotient.mk q₁
  let φ : R →+* D₁ := π₁.comp (algebraMap R S₁)
  have hφ_ker : ∀ r ∈ IsLocalRing.maximalIdeal R, φ r = 0 := by
    intro r hr
    rw [← hq₁_under_R, Ideal.mem_comap] at hr
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
  let ψ : IsLocalRing.ResidueField R →+* D₁ :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) φ hφ_ker
  have hψ_res : ψ.comp (IsLocalRing.residue R) = φ := by
    ext r
    rfl
  let f_κ : Polynomial (IsLocalRing.ResidueField R) := P.f.map (IsLocalRing.residue R)
  have hf_κ_prod :
      f_κ = (Multiset.map (fun α => Polynomial.X - Polynomial.C α) f_κ.roots).prod :=
    (IsAlgClosed.splits f_κ).eq_prod_roots_of_monic (P.monic_f.map (IsLocalRing.residue R))
  have heval_zero : Polynomial.eval₂ ψ (π₁ x) f_κ = 0 := by
    rw [Polynomial.eval₂_map, hψ_res]
    change Polynomial.eval₂ (π₁.comp (algebraMap R S₁)) (π₁ x) P.f = 0
    rw [← Polynomial.hom_eval₂, ← Polynomial.aeval_def, hx_map.1, map_zero]
  rw [hf_κ_prod, Polynomial.eval₂_multiset_prod, Multiset.map_map] at heval_zero
  have hmem_zero := Multiset.prod_eq_zero_iff.mp heval_zero
  simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
    Polynomial.eval₂_C, Multiset.mem_map] at hmem_zero
  obtain ⟨α₀, _, hα₀_eq⟩ := hmem_zero
  have hx_ψ : π₁ x = ψ α₀ := sub_eq_zero.mp hα₀_eq
  obtain ⟨a₀, rfl⟩ := IsLocalRing.residue_surjective α₀
  have hx_a₀ : π₁ x = φ a₀ := hx_ψ
  have hπ₁_aeval : ∀ (r : R), π₁ x = φ r → ∀ Q : Polynomial R, π₁ (Polynomial.aeval x Q) = φ (Q.eval r) := by
    intro r hr Q
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂, hr]
    change Polynomial.eval₂ (φ.comp (RingHom.id R)) (φ r) Q = φ (Q.eval r)
    rw [← Polynomial.hom_eval₂]
    rfl
  have hπ₁_aeval_a₀ : ∀ Q : Polynomial R, π₁ (Polynomial.aeval x Q) = φ (Q.eval a₀) :=
    hπ₁_aeval a₀ hx_a₀
  
  have hf_a₀_mem : P.f.eval a₀ ∈ IsLocalRing.maximalIdeal R := by
    rw [← hq₁_under_R, Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem]
    change φ (P.f.eval a₀) = 0
    rw [← hπ₁_aeval_a₀, hx_map.1, map_zero]
  obtain ⟨p₁, p₂, n_c, hcond⟩ := P.cond
  have hf'_unit_S₁ : IsUnit (Polynomial.aeval x P.f.derivative) := by
    have h1 := congrArg (Polynomial.aeval x) hcond
    simp only [map_add, map_mul, map_pow, hx_map.1, zero_mul, add_zero] at h1
    exact isUnit_of_mul_isUnit_left (h1.symm ▸ hx_map.2.pow n_c)
  have hf'_π₁_ne : π₁ (Polynomial.aeval x P.f.derivative) ≠ 0 :=
    (hf'_unit_S₁.map π₁).ne_zero
  have hf'_a₀_unit : IsUnit (P.f.derivative.eval a₀) := by
    rw [← IsLocalRing.notMem_maximalIdeal, ← hq₁_under_R, Ideal.mem_comap,
      ← Ideal.Quotient.eq_zero_iff_mem]
    change φ (P.f.derivative.eval a₀) ≠ 0
    rw [← hπ₁_aeval_a₀]
    exact hf'_π₁_ne
  
  obtain ⟨a, ha_root, ha_mod⟩ :=
    HenselianLocalRing.is_henselian P.f P.monic_f a₀ hf_a₀_mem hf'_a₀_unit
  have hφ_a : π₁ x = φ a := by
    have hsub : φ (a - a₀) = 0 := hφ_ker (a - a₀) ha_mod
    rw [map_sub, sub_eq_zero] at hsub
    exact hx_a₀.trans hsub.symm
  have hπ₁_aeval_a : ∀ Q : Polynomial R, π₁ (Polynomial.aeval x Q) = φ (Q.eval a) :=
    hπ₁_aeval a hφ_a
  have hg_a_unit : IsUnit (P.g.eval a) := by
    rw [← IsLocalRing.notMem_maximalIdeal, ← hq₁_under_R, Ideal.mem_comap,
      ← Ideal.Quotient.eq_zero_iff_mem]
    change φ (P.g.eval a) ≠ 0
    rw [← hπ₁_aeval_a]
    exact (hx_map.2.map π₁).ne_zero
  have ha_hasMap : P.HasMap a := by
    refine ⟨?_, ?_⟩
    · simpa using ha_root.eq_zero
    · simpa using hg_a_unit
  obtain ⟨q, hq_fac⟩ := Polynomial.dvd_iff_isRoot.mpr ha_root
  have hq_eval_eq : q.eval a = P.f.derivative.eval a := by
    have hd := congrArg Polynomial.derivative hq_fac
    rw [Polynomial.derivative_mul, Polynomial.derivative_sub, Polynomial.derivative_X,
      Polynomial.derivative_C, sub_zero, one_mul] at hd
    have hev := congrArg (Polynomial.eval a) hd
    simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub,
      Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul, add_zero] at hev
    exact hev.symm
  have hq_a_unit : IsUnit (q.eval a) := by
    rw [hq_eval_eq, ← IsLocalRing.notMem_maximalIdeal, ← hq₁_under_R, Ideal.mem_comap,
      ← Ideal.Quotient.eq_zero_iff_mem]
    change φ (P.f.derivative.eval a) ≠ 0
    rw [← hπ₁_aeval_a]
    exact hf'_π₁_ne
  let e_std : P.Ring ≃ₐ[R] S₁ := AlgEquiv.ofBijective (P.lift x hx_map) hlift_bij
  let ρ₁ : S₁ →ₐ[R] R := (P.lift a ha_hasMap).comp e_std.symm.toAlgHom
  have hlift_X_x : (P.lift x hx_map) P.X = x :=
    congrArg Subtype.val (P.homEquiv.apply_symm_apply ⟨x, hx_map⟩)
  have hlift_X_a : (P.lift a ha_hasMap) P.X = a :=
    congrArg Subtype.val (P.homEquiv.apply_symm_apply ⟨a, ha_hasMap⟩)
  have he_symm_x : e_std.symm x = P.X := by
    apply e_std.injective
    rw [e_std.apply_symm_apply]
    exact hlift_X_x.symm
  have hρ₁_x : ρ₁ x = a := by
    change (P.lift a ha_hasMap) (e_std.symm x) = a
    rw [he_symm_x, hlift_X_a]
  let s₂ : S₁ := Polynomial.aeval x q
  have hxs₂_zero : (x - algebraMap R S₁ a) * s₂ = 0 := by
    have h1 := congrArg (Polynomial.aeval x) hq_fac
    simp only [map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, hx_map.1] at h1
    exact h1.symm
  have hs₂_q₁ : s₂ ∉ q₁ := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    change π₁ s₂ ≠ 0
    dsimp [s₂]
    rw [hπ₁_aeval_a]
    exact (hq_a_unit.map φ).ne_zero
  have hρ₁_s₂_unit : IsUnit (ρ₁ s₂) := by
    have hρ₁_s₂ : ρ₁ s₂ = q.eval a := by
      dsimp [s₂]
      rw [← Polynomial.aeval_algHom_apply, hρ₁_x]
      simp
    exact hρ₁_s₂ ▸ hq_a_unit
  
  obtain ⟨⟨g₀, ⟨_, ⟨m, rfl⟩⟩⟩, hm_eq⟩ := IsLocalization.surj (Submonoid.powers f₁) s₂
  dsimp only at hm_eq
  let s₀ : S₁ := algebraMap C₀ S₁ g₀
  have hf₁m_q₁ : algebraMap C₀ S₁ (f₁ ^ m) ∉ q₁ := by
    rw [← Ideal.mem_comap, hq₁_under_C₀]
    intro hpow
    exact hf₁_qz (Ideal.IsPrime.mem_of_pow_mem inferInstance m hpow)
  have hs₀_q₁ : s₀ ∉ q₁ := by
    dsimp only [s₀]
    rw [← hm_eq]
    exact q₁.primeCompl.mul_mem hs₂_q₁ hf₁m_q₁
  have hg₀_qz : g₀ ∉ q_z := by
    rw [← hq₁_under_C₀, Ideal.mem_comap]
    exact hs₀_q₁
  let h : C₀ := g₀ * f₁
  have hh_qz : h ∉ q_z := q_z.primeCompl.mul_mem hg₀_qz hf₁_qz
  have hxs₀_zero : (x - algebraMap R S₁ a) * s₀ = 0 := by
    dsimp only [s₀]
    rw [← hm_eq, ← mul_assoc, hxs₂_zero, zero_mul]
  have hρ₁_s₀_unit : IsUnit (ρ₁ s₀) := by
    dsimp only [s₀]
    rw [← hm_eq, map_mul, map_pow]
    exact hρ₁_s₂_unit.mul (((IsLocalization.Away.algebraMap_isUnit f₁).pow m).map ρ₁.toRingHom)
  
  let L := Localization.Away h
  have hh_unit_L : IsUnit (algebraMap C₀ L h) := IsLocalization.Away.algebraMap_isUnit h
  have hg₀_unit_L : IsUnit (algebraMap C₀ L g₀) := by
    have hmul : algebraMap C₀ L g₀ * algebraMap C₀ L f₁ = algebraMap C₀ L h :=
      (map_mul (algebraMap C₀ L) g₀ f₁).symm
    exact isUnit_of_mul_isUnit_left (hmul ▸ hh_unit_L)
  have hf₁_unit_L : IsUnit (algebraMap C₀ L f₁) := by
    have hmul : algebraMap C₀ L g₀ * algebraMap C₀ L f₁ = algebraMap C₀ L h :=
      (map_mul (algebraMap C₀ L) g₀ f₁).symm
    exact isUnit_of_mul_isUnit_right (hmul ▸ hh_unit_L)
  let ι_L : S₁ →+* L := IsLocalization.Away.lift f₁ hf₁_unit_L
  have hι_L_eq : ∀ c : C₀, ι_L (algebraMap C₀ S₁ c) = algebraMap C₀ L c :=
    fun c => IsLocalization.Away.lift_eq f₁ hf₁_unit_L c
  let ι_Lₐ : S₁ →ₐ[R] L :=
    { ι_L with
      commutes' := fun r => by
        change ι_L (algebraMap R S₁ r) = algebraMap R L r
        rw [IsScalarTower.algebraMap_apply R C₀ S₁, hι_L_eq,
          ← IsScalarTower.algebraMap_apply R C₀ L] }
  have hx_L : ι_L x = algebraMap R L a := by
    have h0 := congrArg ι_L hxs₀_zero
    simp only [map_mul, map_sub, map_zero] at h0
    have hs₀_L : ι_L s₀ = algebraMap C₀ L g₀ := hι_L_eq g₀
    have hR_L : ι_L (algebraMap R S₁ a) = algebraMap R L a := ι_Lₐ.commutes a
    rw [hs₀_L, hR_L] at h0
    obtain ⟨u₀, hu₀⟩ := hg₀_unit_L
    have h0' : (ι_L x - algebraMap R L a) * (u₀ : L) * ((u₀⁻¹ : Lˣ) : L) = 0 := by
      rw [hu₀, h0, zero_mul]
    rw [mul_assoc, Units.mul_inv, mul_one] at h0'
    exact sub_eq_zero.mp h0'
  let ρ_C₀ : C₀ →+* R := ρ₁.toRingHom.comp (algebraMap C₀ S₁)
  have hρ_powers_unit : ∀ y : Submonoid.powers h, IsUnit (ρ_C₀ y) := by
    rintro ⟨_, ⟨k, rfl⟩⟩
    simp only [ρ_C₀, RingHom.comp_apply, map_pow, h, map_mul]
    exact (hρ₁_s₀_unit.mul ((IsLocalization.Away.algebraMap_isUnit f₁).map ρ₁.toRingHom)).pow k
  let ρ_L : L →+* R := IsLocalization.lift (S := L) hρ_powers_unit
  have hρ_L_eq : ∀ c : C₀, ρ_L (algebraMap C₀ L c) = ρ_C₀ c :=
    fun c => IsLocalization.lift_eq hρ_powers_unit c
  have hleft_inv : Function.LeftInverse ρ_L (algebraMap R L) := by
    intro r
    rw [IsScalarTower.algebraMap_apply R C₀ L, hρ_L_eq]
    change ρ₁ (algebraMap C₀ S₁ (algebraMap R C₀ r)) = r
    rw [← IsScalarTower.algebraMap_apply R C₀ S₁, ρ₁.commutes]
    rfl
  have hright_inv : Function.RightInverse ρ_L (algebraMap R L) := by
    have halg_eq :
        ((Algebra.ofId R L).comp ρ₁).comp e_std.toAlgHom =
          ι_Lₐ.comp e_std.toAlgHom := by
      apply P.homEquiv.injective
      apply Subtype.ext
      change algebraMap R L (ρ₁ (e_std P.X)) = ι_L (e_std P.X)
      have heX : e_std P.X = x := hlift_X_x
      rw [heX, hρ₁_x, hx_L]
    have hS₁_eq : ∀ y : S₁, algebraMap R L (ρ₁ y) = ι_L y := by
      intro y
      have hy := AlgHom.congr_fun halg_eq (e_std.symm y)
      have hy' : algebraMap R L (ρ₁ y) = ι_Lₐ y := by
        simpa [e_std.apply_symm_apply] using hy
      exact hy'
    have hhom_eq : (algebraMap R L).comp ρ_L = RingHom.id L := by
      apply IsLocalization.ringHom_ext (Submonoid.powers h)
      ext c
      simp only [RingHom.comp_apply, RingHom.id_apply, hρ_L_eq]
      change algebraMap R L (ρ₁ (algebraMap C₀ S₁ c)) = algebraMap C₀ L c
      rw [hS₁_eq, hι_L_eq]
    intro z
    exact RingHom.congr_fun hhom_eq z
  exact ⟨h, hh_qz, hleft_inv.injective, hright_inv.surjective⟩

theorem weil_flat_lfp_closed_nodal_roof_lift_presentation (R : Type u) [CommRing R] [IsLocalRing R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat g_R)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g_R)
    (y₀ : ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hNode₀ : ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ Ideal.span
            {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) *
              (MvPolynomial.X 1 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))} ))),
      AlgebraicGeometry.Etale e₁ ∧
      AlgebraicGeometry.Etale e₂ ∧
      e₁.base u₀ = y₀ ∧
      (∀ i : Fin 2,
        Ideal.Quotient.mk _
          (MvPolynomial.X i : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) ∈
          (e₂.base u₀).asIdeal) ∧
      e₁ ≫ CategoryTheory.Limits.pullback.snd g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
            (MvPolynomial.C :
              IsLocalRing.ResidueField R →+*
                MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))))) :
    ∃ (m : ℕ)
      (R_rel : Fin m → MvPolynomial (Fin (2 + m)) R)
      (F H_Δ : MvPolynomial (Fin (2 + m)) R)
      (q₀ : Ideal (MvPolynomial (Fin (2 + m)) R)),
      let I_def : Ideal (MvPolynomial (Fin (2 + m)) R) :=
        Ideal.span (insert F (Set.range R_rel))
