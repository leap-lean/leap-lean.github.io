        ↑E_bar.functionField _ _ _ (RatFunc K_R) _ ψ_Wgen.toAlgebra hFrac_Wgen
    let e_ff : ↑E_bar.functionField ≃+* RatFunc K_R := e_ff_alg.toRingEquiv
    have he_ff_comm : ∀ a : ↑(E_bar.presheaf.obj (Opposite.op W_gen)),
        e_ff ((E_bar.germToFunctionField W_gen).hom a) = ψ_Wgen a :=
      fun a => e_ff_alg.commutes a
    let e_ff_hom : E_bar.functionField ⟶ CommRingCat.of (RatFunc K_R) :=
      CommRingCat.ofHom
        { toFun := e_ff
          map_one' := e_ff.map_one
          map_mul' := e_ff.map_mul
          map_zero' := e_ff.map_zero
          map_add' := e_ff.map_add }
    let η₀ : AlgebraicGeometry.Spec E_bar.functionField ⟶ E_bar :=
      E_bar.fromSpecStalk (genericPoint ↥E_bar)
    let η_E : AlgebraicGeometry.Spec (CommRingCat.of (RatFunc K_R)) ⟶ E_bar :=
      AlgebraicGeometry.Spec.map e_ff_hom ≫ η₀
    have hIsFunc : IsSchemeFunctionField E_bar (RatFunc K_R) η_E := by
      intro U hU hUne
      have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hUne
      have hFracU0 : IsFractionRing ↑(E_bar.presheaf.obj (Opposite.op U)) ↑E_bar.functionField :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen E_bar U hU
      let φ_U : E_bar.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of (RatFunc K_R) :=
        E_bar.germToFunctionField U ≫ e_ff_hom
      have hFracU :
          @IsFractionRing ↑(E_bar.presheaf.obj (Opposite.op U)) _ (RatFunc K_R) _
            φ_U.hom.toAlgebra := by
        let _ : Algebra ↑(E_bar.presheaf.obj (Opposite.op U)) (RatFunc K_R) := φ_U.hom.toAlgebra
        let e_U_alg : ↑E_bar.functionField ≃ₐ[↑(E_bar.presheaf.obj (Opposite.op U))] RatFunc K_R :=
          { e_ff with commutes' := fun a => rfl }
        exact IsLocalization.isLocalization_of_algEquiv
          (nonZeroDivisors ↑(E_bar.presheaf.obj (Opposite.op U))) e_U_alg
      have hxU : genericPoint ↥E_bar ∈ U := by
        obtain ⟨⟨x, hx⟩⟩ := hUne
        exact ((genericPoint_spec ↥E_bar).mem_open_set_iff U.isOpen).mpr ⟨x, trivial, hx⟩
      have hGermSpec :
          AlgebraicGeometry.Spec.map (E_bar.germToFunctionField U) ≫ hU.fromSpec = η₀ := by
        have h1 := (U.fromSpecStalkOfMem_toSpecΓ_assoc (genericPoint ↥E_bar) hxU hU.fromSpec).symm
        have h2 : E_bar.presheaf.germ U (genericPoint ↥E_bar) hxU =
            E_bar.germToFunctionField U := rfl
        rw [← h2, h1, hU.toSpecΓ_fromSpec, U.fromSpecStalkOfMem_ι]
      have hSpecφ : AlgebraicGeometry.Spec.map φ_U ≫ hU.fromSpec = η_E := by
        dsimp only [φ_U, η_E]
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, hGermSpec]
      exact ⟨φ_U, hFracU, hSpecφ⟩
    have hη_comm : η_E ≫ g_bar = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_RF) := by
      have hW_ne' : Nonempty ↥W_gen := hW_ne
      let φ_Wgen : E_bar.presheaf.obj (Opposite.op W_gen) ⟶ CommRingCat.of (RatFunc K_R) :=
        E_bar.germToFunctionField W_gen ≫ e_ff_hom
      have hxW : genericPoint ↥E_bar ∈ W_gen := by
        obtain ⟨⟨x, hx⟩⟩ := hW_ne'
        exact ((genericPoint_spec ↥E_bar).mem_open_set_iff W_gen.isOpen).mpr ⟨x, trivial, hx⟩
      have hGermW :
          AlgebraicGeometry.Spec.map (E_bar.germToFunctionField W_gen) ≫ hW_gen.fromSpec = η₀ := by
        have h1 := (W_gen.fromSpecStalkOfMem_toSpecΓ_assoc
          (genericPoint ↥E_bar) hxW hW_gen.fromSpec).symm
        have h2 : E_bar.presheaf.germ W_gen (genericPoint ↥E_bar) hxW =
            E_bar.germToFunctionField W_gen := rfl
        rw [← h2, h1, hW_gen.toSpecΓ_fromSpec, W_gen.fromSpecStalkOfMem_ι]
      have hη_eq1 : η_E = AlgebraicGeometry.Spec.map φ_Wgen ≫ hW_gen.fromSpec := by
        dsimp only [φ_Wgen, η_E]
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, hGermW]
      have hφ_eq : φ_Wgen = CommRingCat.ofHom α_W.toRingHom ≫ CommRingCat.ofHom ψ_P1 := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        exact he_ff_comm a
      have hη_eq2 : η_E = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_P1) ≫ j_open := by
        rw [hη_eq1, hφ_eq, AlgebraicGeometry.Spec.map_comp, Category.assoc, hα_fromSpec]
      rw [hη_eq2, Category.assoc, hj_open_gbar, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro r
      exact hψ_P1_C (algebraMap R K_R r)
    exact ⟨η_E, hη_comm, hIsFunc⟩
  obtain ⟨η_E, hη_comm, hFunc⟩ := hFuncPkg

  
  
  
  have hValCenter :
      ∀ (W : ValuationSubring (RatFunc K_R))
        (hWR : ∀ x : R, ρ_RF x ∈ W),
        (∀ x ∈ IsLocalRing.maximalIdeal R,
          (⟨ρ_RF x, hWR x⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W) →
        ∃ z_W : ↥E_bar,
          g_bar.base z_W = IsLocalRing.closedPoint R ∧
          ∀ (U : E_bar.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
            (ψ_U : E_bar.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of (RatFunc K_R)),
            AlgebraicGeometry.Spec.map ψ_U ≫ hU.fromSpec = η_E →
            (z_W ∈ U ↔ Set.range ψ_U.hom ⊆ (W : Set (RatFunc K_R))) := by
    have hUC : AlgebraicGeometry.UniversallyClosed g_bar := inferInstance
    rw [AlgebraicGeometry.universallyClosed_eq_universallySpecializing] at hUC
    have hEx : AlgebraicGeometry.ValuativeCriterion.Existence g_bar :=
      AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap g_bar hUC.1
    have hUniq : AlgebraicGeometry.ValuativeCriterion.Uniqueness g_bar :=
      AlgebraicGeometry.IsSeparated.valuativeCriterion g_bar
    intro W hWR hWMax
    let ρ_W : R →+* ↥W := ρ_RF.codRestrict W.toSubring hWR
    let i₂ : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_W)
    have hSqW :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W (RatFunc K_R))) ≫ i₂ =
          η_E ≫ g_bar := by
      dsimp only [i₂]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hη_comm]
      rfl
    let sq : AlgebraicGeometry.ValuativeCommSq g_bar :=
      ⟨↥W, RatFunc K_R, η_E, i₂, ⟨hSqW.symm⟩⟩
    obtain ⟨L_W⟩ := (hEx sq).exists_lift
    let γ_W : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ E_bar := L_W.l
    have hγ_top :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W (RatFunc K_R))) ≫ γ_W =
          η_E := L_W.fac_left
    have hγ_bot : γ_W ≫ g_bar = i₂ := L_W.fac_right
    let z_W : ↥E_bar := γ_W.base (IsLocalRing.closedPoint ↥W)
    have hzW_cl : g_bar.base z_W = IsLocalRing.closedPoint R := by
      have hbase : g_bar.base z_W = i₂.base (IsLocalRing.closedPoint ↥W) := by
        change (γ_W ≫ g_bar).base (IsLocalRing.closedPoint ↥W) = _
        rw [hγ_bot]
      rw [hbase]
      apply PrimeSpectrum.ext
      change Ideal.comap ρ_W (IsLocalRing.maximalIdeal ↥W) = IsLocalRing.maximalIdeal R
      apply le_antisymm
      · have hPr : (Ideal.comap ρ_W (IsLocalRing.maximalIdeal ↥W)).IsPrime :=
          Ideal.comap_isPrime ρ_W (IsLocalRing.maximalIdeal ↥W)
        exact IsLocalRing.le_maximalIdeal hPr.ne_top
      · intro x hx
        exact hWMax x hx
    refine ⟨z_W, hzW_cl, ?_⟩
    intro U hU ψ_U hSpecU
    constructor
    · intro hzU
      have hSubRange : Set.range γ_W.base ⊆ Set.range hU.fromSpec.base := by
        rw [hU.range_fromSpec]
        rintro _ ⟨q, rfl⟩
        exact ((IsLocalRing.specializes_closedPoint q).map γ_W.continuous).mem_open
          U.isOpen hzU
      let lam_W := AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec γ_W hSubRange
      have hlam_fac : lam_W ≫ hU.fromSpec = γ_W :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec γ_W hSubRange
      let θ_W := AlgebraicGeometry.Spec.preimage lam_W
      have hθ_eq : θ_W ≫ CommRingCat.ofHom (algebraMap ↥W (RatFunc K_R)) = ψ_U := by
        apply AlgebraicGeometry.Spec.map_injective
        apply (cancel_mono hU.fromSpec).mp
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
          AlgebraicGeometry.Spec.map_preimage, hlam_fac, hγ_top, hSpecU]
      rintro _ ⟨a, rfl⟩
      have ha : (θ_W.hom a : RatFunc K_R) = ψ_U.hom a :=
        RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hθ_eq) a
      rw [← ha]
      exact (θ_W.hom a).2
    · intro hRangeW
      let θ_W : E_bar.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of ↥W :=
        CommRingCat.ofHom (ψ_U.hom.codRestrict W.toSubring (fun a => hRangeW ⟨a, rfl⟩))
      have hθ_sub : θ_W ≫ CommRingCat.ofHom (algebraMap ↥W (RatFunc K_R)) = ψ_U := by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro a; rfl
      let γ' : AlgebraicGeometry.Spec (CommRingCat.of ↥W) ⟶ E_bar :=
        AlgebraicGeometry.Spec.map θ_W ≫ hU.fromSpec
      have hγ'_top :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥W (RatFunc K_R))) ≫ γ' =
            η_E := by
        dsimp only [γ']
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hθ_sub, hSpecU]
      have hγ'_bot : γ' ≫ g_bar = i₂ := by
        let α₁ := AlgebraicGeometry.Spec.preimage (γ' ≫ g_bar)
        have h1 : AlgebraicGeometry.Spec.map
            (α₁ ≫ CommRingCat.ofHom (algebraMap ↥W (RatFunc K_R))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_RF) := by
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
            ← Category.assoc, hγ'_top, hη_comm]
        have h2 := CommRingCat.Hom.ext_iff.mp (AlgebraicGeometry.Spec.map_injective h1)
        have hα_eq : α₁ = CommRingCat.ofHom ρ_W := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro r
          apply Subtype.ext
          exact RingHom.congr_fun h2 r
        calc γ' ≫ g_bar
          _ = AlgebraicGeometry.Spec.map α₁ :=
            (AlgebraicGeometry.Spec.map_preimage (γ' ≫ g_bar)).symm
          _ = i₂ := by rw [hα_eq]
      let L' : sq.commSq.LiftStruct := ⟨γ', hγ'_top, hγ'_bot⟩
      have hL_eq : L' = L_W := @Subsingleton.elim _ (hUniq sq) L' L_W
      have hγ_eq : γ' = γ_W := congrArg CategoryTheory.CommSq.LiftStruct.l hL_eq
      change γ_W.base (IsLocalRing.closedPoint ↥W) ∈ (U : Set ↥E_bar)
      rw [← hγ_eq, ← hU.range_fromSpec]
      exact ⟨(AlgebraicGeometry.Spec.map θ_W).base (IsLocalRing.closedPoint ↥W), rfl⟩

  have hValWitness :
      ∀ (U : E_bar.Opens) (hU : AlgebraicGeometry.IsAffineOpen U)
        (ψ_U : E_bar.presheaf.obj (Opposite.op U) ⟶ CommRingCat.of (RatFunc K_R))
        (z : ↥E_bar),
        @IsFractionRing ↑(E_bar.presheaf.obj (Opposite.op U)) _ (RatFunc K_R) _
          ψ_U.hom.toAlgebra →
        AlgebraicGeometry.Spec.map ψ_U ≫ hU.fromSpec = η_E →
        z ∈ U →
        g_bar.base z = IsLocalRing.closedPoint R →
        ∃ (W : ValuationSubring (RatFunc K_R))
          (hWR : ∀ x : R, ρ_RF x ∈ W),
          (∀ x ∈ IsLocalRing.maximalIdeal R,
            (⟨ρ_RF x, hWR x⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W) ∧
          Set.range ψ_U.hom ⊆ (W : Set (RatFunc K_R)) := by
    intro U hU ψ_U z hFracU hSpecU hzU hz_cl
    let A_U := ↑(E_bar.presheaf.obj (Opposite.op U))
    have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := ⟨⟨z, hzU⟩⟩
    have : IsDomain A_U := AlgebraicGeometry.IsIntegral.component_integral U
    have hz_range : z ∈ Set.range hU.fromSpec.base := by
      rw [hU.range_fromSpec]; exact hzU
    obtain ⟨p_z, hp_z⟩ := hz_range
    have : p_z.asIdeal.IsPrime := p_z.isPrime
    let R_loc := Localization.AtPrime p_z.asIdeal
    have hUnits : ∀ s : p_z.asIdeal.primeCompl, IsUnit (ψ_U.hom s.1) := by
      intro s
      have hs0 : (s : A_U) ≠ 0 := fun h0 => s.2 (h0 ▸ p_z.asIdeal.zero_mem)
      let _ : Algebra A_U (RatFunc K_R) := ψ_U.hom.toAlgebra
      have : IsFractionRing A_U (RatFunc K_R) := hFracU
      have hψs0 : ψ_U.hom s.1 ≠ 0 := fun h0 =>
        hs0 (IsFractionRing.injective A_U (RatFunc K_R) (h0.trans (map_zero ψ_U.hom).symm))
      exact IsUnit.mk0 _ hψs0
    let ψ_loc : R_loc →+* RatFunc K_R :=
      IsLocalization.lift (M := p_z.asIdeal.primeCompl) (S := R_loc) hUnits
    have hψ_loc_eq : ∀ a : A_U, ψ_loc (algebraMap A_U R_loc a) = ψ_U.hom a :=
      fun a => IsLocalization.lift_eq (M := p_z.asIdeal.primeCompl) (S := R_loc) hUnits a
    obtain ⟨W, h_mem_loc, hLocal⟩ := IsLocalRing.exists_factor_valuationRing ψ_loc
    have hRangeW : Set.range ψ_U.hom ⊆ (W : Set (RatFunc K_R)) := by
      rintro _ ⟨a, rfl⟩
      rw [← hψ_loc_eq a]
      exact h_mem_loc (algebraMap A_U R_loc a)
    let τ_RU := AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ g_bar)
    have hτ_spec : AlgebraicGeometry.Spec.map τ_RU = hU.fromSpec ≫ g_bar :=
      AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ g_bar)
    have h_ψ_τ : ∀ x : R, ψ_U.hom (τ_RU.hom x) = ρ_RF x := by
      have h1 : AlgebraicGeometry.Spec.map (τ_RU ≫ ψ_U) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_RF) := by
        rw [AlgebraicGeometry.Spec.map_comp, hτ_spec, ← Category.assoc, hSpecU, hη_comm]
      exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp
        (AlgebraicGeometry.Spec.map_injective h1))
    have hWR : ∀ x : R, ρ_RF x ∈ W := by
      intro x
      rw [← h_ψ_τ x]
      exact hRangeW ⟨τ_RU.hom x, rfl⟩
    have hComap_pz : Ideal.comap τ_RU.hom p_z.asIdeal = IsLocalRing.maximalIdeal R := by
      have hpt : (AlgebraicGeometry.Spec.map τ_RU).base p_z =
          IsLocalRing.closedPoint R := by
        rw [hτ_spec]
        change g_bar.base (hU.fromSpec.base p_z) = IsLocalRing.closedPoint R
        rw [hp_z, hz_cl]
      exact congrArg PrimeSpectrum.asIdeal hpt
    have hWMax : ∀ x ∈ IsLocalRing.maximalIdeal R,
        (⟨ρ_RF x, hWR x⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W := by
      intro x hx
      have hx_pz : τ_RU.hom x ∈ p_z.asIdeal := by
        change x ∈ Ideal.comap τ_RU.hom p_z.asIdeal
        rwa [hComap_pz]
      have hx_mloc : algebraMap A_U R_loc (τ_RU.hom x) ∈ IsLocalRing.maximalIdeal R_loc := by
        have h_under : (IsLocalRing.maximalIdeal R_loc).under A_U = p_z.asIdeal :=
          IsLocalization.AtPrime.under_maximalIdeal R_loc p_z.asIdeal
        change τ_RU.hom x ∈ (IsLocalRing.maximalIdeal R_loc).under A_U
        rwa [h_under]
      let f_loc : R_loc →+* ↥W := ψ_loc.codRestrict W.toSubring h_mem_loc
      have hf_mem : f_loc (algebraMap A_U R_loc (τ_RU.hom x)) ∈ IsLocalRing.maximalIdeal ↥W :=
        @map_nonunit R_loc ↥W _ _ _ _ f_loc hLocal _ hx_mloc
      have hf_eq : f_loc (algebraMap A_U R_loc (τ_RU.hom x)) = ⟨ρ_RF x, hWR x⟩ := by
        apply Subtype.ext
        change ψ_loc (algebraMap A_U R_loc (τ_RU.hom x)) = ρ_RF x
        rw [hψ_loc_eq, h_ψ_τ]
      rwa [hf_eq] at hf_mem
    exact ⟨W, hWR, hWMax, hRangeW⟩

  
  
  
  by_contra hNotConn
  let s_0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
  let Z_0 := CategoryTheory.Limits.pullback g_bar s_0
  let p_Z0 := CategoryTheory.Limits.pullback.fst g_bar s_0
  obtain ⟨pt_F⟩ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (RatFunc K_R))) := inferInstance
  have hClosed_im : IsClosed (Set.range g_bar.base) :=
    g_bar.isProperMap.isClosedMap.isClosed_range
  have hClPt_mem : IsLocalRing.closedPoint R ∈ Set.range g_bar.base :=
    Specializes.mem_closed (IsLocalRing.specializes_closedPoint (g_bar.base (η_E.base pt_F)))
      hClosed_im ⟨η_E.base pt_F, rfl⟩
  obtain ⟨z_0, hz_0⟩ := hClPt_mem
  obtain ⟨pt_k0⟩ :
      Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.ResidueField R))) :=
    inferInstance
  have hq_bot : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.ResidueField R))),
      q.asIdeal = ⊥ := by
    intro q
    rw [eq_bot_iff]
    intro a ha
    rw [Ideal.mem_bot]
    by_contra ha0
    exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal ha (IsUnit.mk0 a ha0))
  have hs0_pt : s_0.base pt_k0 = IsLocalRing.closedPoint R := by
    apply PrimeSpectrum.ext
    change Ideal.comap (IsLocalRing.residue R) pt_k0.asIdeal = IsLocalRing.maximalIdeal R
    rw [hq_bot pt_k0]
    exact IsLocalRing.ker_residue
  have hZ0_ne : Nonempty ↥Z_0 := by
    obtain ⟨q₀, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
      z_0 pt_k0 (hz_0.trans hs0_pt.symm)
    exact ⟨q₀⟩
  have : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.ResidueField R))) :=
    inferInstance
  have : CompactSpace ↥Z_0 :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace
      (CategoryTheory.Limits.pullback.snd g_bar s_0)
  have : AlgebraicGeometry.IsClosedImmersion s_0 :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (IsLocalRing.residue R)) IsLocalRing.residue_surjective
  have : AlgebraicGeometry.IsClosedImmersion p_Z0 := inferInstance
  have hp_emb : Topology.IsClosedEmbedding p_Z0.base := p_Z0.isClosedEmbedding
  have hRange_s0 : Set.range s_0.base = {IsLocalRing.closedPoint R} := by
    ext x
    simp only [Set.mem_range]
    constructor
    · rintro ⟨q, rfl⟩
      have hq_eq : q = pt_k0 :=
        PrimeSpectrum.ext ((hq_bot q).trans (hq_bot pt_k0).symm)
      rw [hq_eq, hs0_pt]
      rfl
    · rintro rfl
      exact ⟨pt_k0, hs0_pt⟩
  have hRange_pZ0 : Set.range p_Z0.base = g_bar.base ⁻¹' {IsLocalRing.closedPoint R} := by
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst, hRange_s0]
  have hNotPre : ¬ _root_.IsPreconnected (Set.univ : Set ↥Z_0) := by
    intro hPre
    exact hNotConn (@ConnectedSpace.mk ↥Z_0 _ ⟨hPre⟩ hZ0_ne)
  unfold _root_.IsPreconnected at hNotPre
  push Not at hNotPre
  obtain ⟨O₁, O₂, hO₁_open, hO₂_open, hO_cov, hO₁_ne', hO₂_ne', hO_disj'⟩ := hNotPre
  have hO₁_ne : O₁.Nonempty := by rcases hO₁_ne' with ⟨x, _, hx⟩; exact ⟨x, hx⟩
  have hO₂_ne : O₂.Nonempty := by rcases hO₂_ne' with ⟨x, _, hx⟩; exact ⟨x, hx⟩
  have hO_disj : Disjoint O₁ O₂ := by
    rw [Set.disjoint_left]
    intro x hx₁ hx₂
    have hx_emp : x ∈ (∅ : Set ↥Z_0) := hO_disj' ▸ ⟨Set.mem_univ x, hx₁, hx₂⟩
    exact hx_emp.elim
  have hO₁_eq_compl : O₁ = O₂ᶜ := by
    ext x
    simp only [Set.mem_compl_iff]
    exact ⟨fun hx₁ hx₂ => Set.disjoint_left.mp hO_disj hx₁ hx₂,
      fun hx₂ => (hO_cov (Set.mem_univ x)).resolve_right hx₂⟩
  have hO₂_eq_compl : O₂ = O₁ᶜ := by
    ext x
    simp only [Set.mem_compl_iff]
    exact ⟨fun hx₂ hx₁ => Set.disjoint_left.mp hO_disj hx₁ hx₂,
      fun hx₁ => (hO_cov (Set.mem_univ x)).resolve_left hx₁⟩
  have hO₁_cl : IsClosed O₁ := hO₁_eq_compl ▸ hO₂_open.isClosed_compl
  have hO₂_cl : IsClosed O₂ := hO₂_eq_compl ▸ hO₁_open.isClosed_compl
  let A₁ : Set ↥E_bar := p_Z0.base '' O₁
  let A₂ : Set ↥E_bar := p_Z0.base '' O₂
  have hA₁_comp : IsCompact A₁ := hO₁_cl.isCompact.image p_Z0.continuous
  have hA₂_comp : IsCompact A₂ := hO₂_cl.isCompact.image p_Z0.continuous
  have hA₁_cl : IsClosed A₁ := hp_emb.isClosedMap O₁ hO₁_cl
  have hA₂_cl : IsClosed A₂ := hp_emb.isClosedMap O₂ hO₂_cl
  have hA₁_ne : A₁.Nonempty := hO₁_ne.image p_Z0.base
  have hA₂_ne : A₂.Nonempty := hO₂_ne.image p_Z0.base
  have hA_disj : Disjoint A₁ A₂ := by
    rw [Set.disjoint_left]
    rintro _ ⟨x₁, hx₁, rfl⟩ ⟨x₂, hx₂, h_eq⟩
    have hx12 : x₁ = x₂ := hp_emb.injective h_eq.symm
    subst hx12
    exact Set.disjoint_left.mp hO_disj hx₁ hx₂
  have hA_union : A₁ ∪ A₂ = g_bar.base ⁻¹' {IsLocalRing.closedPoint R} := by
    calc A₁ ∪ A₂
      _ = p_Z0.base '' (O₁ ∪ O₂) := (Set.image_union p_Z0.base O₁ O₂).symm
      _ = p_Z0.base '' Set.univ := congrArg (p_Z0.base '' ·) (Set.Subset.antisymm
          (Set.subset_univ _) hO_cov)
      _ = Set.range p_Z0.base := Set.image_univ
      _ = g_bar.base ⁻¹' {IsLocalRing.closedPoint R} := hRange_pZ0
  let D_E : Fin (M + 1) → E_bar.Opens :=
    fun a => (TopologicalSpace.Opens.map ι_bar.base).obj (weilProjBasicOpen R M a)
  have : AlgebraicGeometry.IsAffineHom ι_bar := inferInstance
  have hAff_DE : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (D_E a) :=
    fun a => (hAff R M a).preimage ι_bar
  have hCov_DE : ∀ x : ↥E_bar, ∃ a : Fin (M + 1), x ∈ D_E a := by
    intro x
    have hx : ι_bar.base x ∈ (⊤ : (weilProjectiveSpaceOver R M).left.Opens) := trivial
    rw [← hCovProj, TopologicalSpace.Opens.mem_iSup] at hx
    exact hx

  
  have hBuildSide :
      ∀ (A_tar A_av : Set ↥E_bar),
        IsCompact A_tar →
        A_tar.Nonempty →
        IsClosed A_av →
        Disjoint A_tar A_av →
        A_tar ⊆ g_bar.base ⁻¹' {IsLocalRing.closedPoint R} →
        ∃ (p : ℕ)
          (U : Fin (p + 1) → E_bar.Opens)
          (hAffU : ∀ μ : Fin (p + 1), AlgebraicGeometry.IsAffineOpen (U μ))
          (ψU : ∀ μ : Fin (p + 1),
            E_bar.presheaf.obj (Opposite.op (U μ)) ⟶ CommRingCat.of (RatFunc K_R))
          (m : Fin (p + 1) → ℕ)
          (φ : ∀ μ : Fin (p + 1), Fin (m μ) → RatFunc K_R),
          (∀ (μ : Fin (p + 1)) (j : Fin (m μ)), φ μ j ≠ 0) ∧
          (∀ μ : Fin (p + 1),
            @IsFractionRing ↑(E_bar.presheaf.obj (Opposite.op (U μ))) _ (RatFunc K_R) _
              (ψU μ).hom.toAlgebra ∧
            AlgebraicGeometry.Spec.map (ψU μ) ≫ (hAffU μ).fromSpec = η_E ∧
            ∀ S : Subring (RatFunc K_R),
              (∀ x : R, ρ_RF x ∈ S) →
              (Set.range (ψU μ).hom ⊆ (S : Set (RatFunc K_R)) ↔
                ∀ j : Fin (m μ), φ μ j ∈ S)) ∧
          (∃ z₀ : ↥E_bar, z₀ ∈ U 0 ∧ g_bar.base z₀ = IsLocalRing.closedPoint R) ∧
          (∀ z ∈ A_tar, ∃ μ : Fin (p + 1), z ∈ U μ) ∧
          (∀ (μ : Fin (p + 1)) (z : ↥E_bar), z ∈ U μ → z ∉ A_av) := by
    classical
    intro A_tar A_av hComp hNe hCl_av hDisj hSub_cl
    let W_compl : E_bar.Opens := ⟨A_avᶜ, hCl_av.isOpen_compl⟩
    have hex_basic : ∀ x : ↥A_tar,
        ∃ (a : Fin (M + 1)) (f : ↑(E_bar.presheaf.obj (Opposite.op (D_E a)))),
          E_bar.basicOpen f ≤ W_compl ∧ x.1 ∈ E_bar.basicOpen f := by
      intro x
      have hxW : x.1 ∈ W_compl := Set.disjoint_left.mp hDisj x.2
      obtain ⟨a, hxa⟩ := hCov_DE x.1
      obtain ⟨f, hf_le, hxf⟩ := (hAff_DE a).exists_basicOpen_le (⟨x.1, hxW⟩ : ↥W_compl) hxa
      exact ⟨a, f, hf_le, hxf⟩
    choose a_x f_x hf_le hxf_mem using hex_basic
    obtain ⟨S_sub, hS_cov⟩ := hComp.elim_finite_subcover
      (fun x : ↥A_tar => (E_bar.basicOpen (f_x x) : Set ↥E_bar))
      (fun x => (E_bar.basicOpen (f_x x)).isOpen)
      (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hxf_mem ⟨y, hy⟩⟩)
    have hS_ne : S_sub.Nonempty := by
      obtain ⟨y₀, hy₀⟩ := hNe
      have hy_cov := hS_cov hy₀
      simp only [Set.mem_iUnion] at hy_cov
      rcases hy_cov with ⟨x, hxS, _⟩
      exact ⟨x, hxS⟩
    have hS_pos : 1 ≤ S_sub.card := Finset.card_pos.mpr hS_ne
    let p : ℕ := S_sub.card - 1
    have hcard_p : S_sub.card = p + 1 := by omega
    let e_idx : Fin (p + 1) ≃ ↥S_sub := (S_sub.equivFinOfCardEq hcard_p).symm
    let U : Fin (p + 1) → E_bar.Opens := fun μ => E_bar.basicOpen (f_x (e_idx μ).1)
    let hAffU : ∀ μ : Fin (p + 1), AlgebraicGeometry.IsAffineOpen (U μ) :=
      fun μ => (hAff_DE (a_x (e_idx μ).1)).basicOpen (f_x (e_idx μ).1)
    have hChartData : ∀ μ : Fin (p + 1),
        ∃ (ψ_U : E_bar.presheaf.obj (Opposite.op (U μ)) ⟶ CommRingCat.of (RatFunc K_R))
          (m_μ : ℕ) (φ_μ : Fin m_μ → RatFunc K_R),
          (∀ j : Fin m_μ, φ_μ j ≠ 0) ∧
          @IsFractionRing ↑(E_bar.presheaf.obj (Opposite.op (U μ))) _ (RatFunc K_R) _
            ψ_U.hom.toAlgebra ∧
          AlgebraicGeometry.Spec.map ψ_U ≫ (hAffU μ).fromSpec = η_E ∧
          (∀ S : Subring (RatFunc K_R),
            (∀ x : R, ρ_RF x ∈ S) →
            (Set.range ψ_U.hom ⊆ (S : Set (RatFunc K_R)) ↔
              ∀ j : Fin m_μ, φ_μ j ∈ S)) := by
      intro μ
      let x_μ : ↥A_tar := (e_idx μ).1
      let a : Fin (M + 1) := a_x x_μ
      let f : ↑(E_bar.presheaf.obj (Opposite.op (D_E a))) := f_x x_μ
      have hUne_U : Nonempty ↥(U μ) := ⟨⟨x_μ.1, hxf_mem x_μ⟩⟩
      have hUne_DE : Nonempty ↥(D_E a) := ⟨⟨x_μ.1, E_bar.basicOpen_le f (hxf_mem x_μ)⟩⟩
      obtain ⟨ψ_U, hFrac_U, hSpec_U⟩ := hFunc (U μ) (hAffU μ) hUne_U
      obtain ⟨ψ_DE, hFrac_DE, hSpec_DE⟩ := hFunc (D_E a) (hAff_DE a) hUne_DE
      let res : E_bar.presheaf.obj (Opposite.op (D_E a)) ⟶
          E_bar.presheaf.obj (Opposite.op (U μ)) :=
        E_bar.presheaf.map (CategoryTheory.homOfLE (E_bar.basicOpen_le f)).op
      have h_res_Spec :
          AlgebraicGeometry.Spec.map res ≫ (hAff_DE a).fromSpec = (hAffU μ).fromSpec :=
        AlgebraicGeometry.IsAffineOpen.map_fromSpec (hAff_DE a) (hAffU μ)
          (homOfLE (E_bar.basicOpen_le f)).op
      have h_res_ψ : ∀ s : ↑(E_bar.presheaf.obj (Opposite.op (D_E a))),
          ψ_U.hom (res.hom s) = ψ_DE.hom s := by
        have h1 : AlgebraicGeometry.Spec.map (res ≫ ψ_U) ≫ (hAff_DE a).fromSpec =
            AlgebraicGeometry.Spec.map ψ_DE ≫ (hAff_DE a).fromSpec := by
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, h_res_Spec, hSpec_U, hSpec_DE]
        have h2 := (cancel_mono (hAff_DE a).fromSpec).mp h1
        exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp
          (AlgebraicGeometry.Spec.map_injective h2))
      let q_a := ι_bar.app (weilProjBasicOpen R M a)
      have hq_fromSpec :
          AlgebraicGeometry.Spec.map q_a ≫ (hAff R M a).fromSpec =
            (hAff_DE a).fromSpec ≫ ι_bar := by
        have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
          ι_bar (hAff R M a) (hAff_DE a) (le_refl _)
        rwa [AlgebraicGeometry.Scheme.Hom.appLE_eq_app] at h1
      have h_c_compat : ∀ r : R, ψ_DE.hom (q_a.hom (c_proj R M a r)) = ρ_RF r := by
        have h1 : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (c_proj R M a) ≫ q_a ≫ ψ_DE) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ_RF) := by
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            hBridge R M a, Category.assoc, ← Category.assoc (AlgebraicGeometry.Spec.map q_a),
            hq_fromSpec, Category.assoc, ← Category.assoc (AlgebraicGeometry.Spec.map ψ_DE),
            hSpec_DE, hη_comm]
        exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp
          (AlgebraicGeometry.Spec.map_injective h1))
      have hf_ne0 : f ≠ 0 := by
        intro hf0
        have hbot : U μ = ⊥ := by
          change E_bar.basicOpen f = ⊥
          rw [hf0, E_bar.basicOpen_zero]
        obtain ⟨⟨y, hy⟩⟩ := hUne_U
        rw [hbot] at hy
        exact False.elim hy
      have : Nonempty ↥(D_E a : AlgebraicGeometry.Scheme.{u}) := hUne_DE
      have : IsDomain ↑(E_bar.presheaf.obj (Opposite.op (D_E a))) :=
        AlgebraicGeometry.IsIntegral.component_integral (D_E a)
      have hψf_ne0 : ψ_DE.hom f ≠ 0 := by
        intro h0
        let _ : Algebra ↑(E_bar.presheaf.obj (Opposite.op (D_E a))) (RatFunc K_R) :=
          ψ_DE.hom.toAlgebra
        have : IsFractionRing ↑(E_bar.presheaf.obj (Opposite.op (D_E a))) (RatFunc K_R) :=
          hFrac_DE
        exact hf_ne0 (IsFractionRing.injective _ (RatFunc K_R) (h0.trans (map_zero ψ_DE.hom).symm))
      let _ : Algebra ↑(E_bar.presheaf.obj (Opposite.op (D_E a)))
          ↑(E_bar.presheaf.obj (Opposite.op (U μ))) := res.hom.toAlgebra
      have hLocBasic :
          IsLocalization.Away f ↑(E_bar.presheaf.obj (Opposite.op (U μ))) :=
        (hAff_DE a).isLocalization_basicOpen f
      let g_raw : Fin (M + 2) → RatFunc K_R :=
        Fin.snoc (fun b : Fin (M + 1) => ψ_DE.hom (q_a.hom (t_proj R M a b))) (ψ_DE.hom f)⁻¹
      have hRawEquiv : ∀ S : Subring (RatFunc K_R),
          (∀ x : R, ρ_RF x ∈ S) →
          (Set.range ψ_U.hom ⊆ (S : Set (RatFunc K_R)) ↔
            ∀ i : Fin (M + 2), g_raw i ∈ S) := by
        intro S hSR
        constructor
        · intro hSub i
          refine Fin.lastCases ?_ ?_ i
          · dsimp only [g_raw]
            rw [Fin.snoc_last]
            have hUnit : IsUnit (res.hom f) :=
              IsLocalization.Away.algebraMap_isUnit
                (S := ↑(E_bar.presheaf.obj (Opposite.op (U μ)))) f
            obtain ⟨u_f, hu_f⟩ := hUnit
            have hmul1 : ψ_DE.hom f * ψ_U.hom (↑u_f⁻¹) = 1 := by
              rw [← h_res_ψ f, ← hu_f, ← map_mul, Units.mul_inv, map_one]
            have hinv_eq : (ψ_DE.hom f)⁻¹ = ψ_U.hom (↑u_f⁻¹) := by
              calc (ψ_DE.hom f)⁻¹
                _ = (ψ_DE.hom f)⁻¹ * (ψ_DE.hom f * ψ_U.hom (↑u_f⁻¹)) := by rw [hmul1, mul_one]
                _ = ((ψ_DE.hom f)⁻¹ * ψ_DE.hom f) * ψ_U.hom (↑u_f⁻¹) := by ring
                _ = ψ_U.hom (↑u_f⁻¹) := by rw [inv_mul_cancel₀ hψf_ne0, one_mul]
            rw [hinv_eq]
            exact hSub ⟨↑u_f⁻¹, rfl⟩
          · intro b
            dsimp only [g_raw]
            rw [Fin.snoc_castSucc, ← h_res_ψ]
            exact hSub ⟨res.hom (q_a.hom (t_proj R M a b)), rfl⟩
        · intro hMem
          have hProj_in_S : ∀ w : ↑((weilProjectiveSpaceOver R M).left.presheaf.obj
              (Opposite.op (weilProjBasicOpen R M a))),
              ψ_DE.hom (q_a.hom w) ∈ S := by
            intro w
            have hw_top : w ∈ (⊤ : Subring _) := trivial
            rw [← hGenProj a] at hw_top
            refine Subring.closure_induction ?_ ?_ ?_ ?_ ?_ ?_ hw_top
            · rintro _ (⟨r, rfl⟩ | ⟨b, rfl⟩)
              · rw [h_c_compat r]; exact hSR r
              · have hb := hMem (Fin.castSucc b)
                dsimp only [g_raw] at hb
                rwa [Fin.snoc_castSucc] at hb
            · simp [S.zero_mem]
            · simp [S.one_mem]
            · intro u v _ _ hu hv; rw [map_add, map_add]; exact S.add_mem hu hv
            · intro u _ hu; rw [map_neg, map_neg]; exact S.neg_mem hu
            · intro u v _ _ hu hv; rw [map_mul, map_mul]; exact S.mul_mem hu hv
          have hq_surj : Function.Surjective q_a.hom :=
            AlgebraicGeometry.Scheme.Hom.app_surjective ι_bar (weilProjBasicOpen R M a) (hAff R M a)
          have hDE_in_S : ∀ d : ↑(E_bar.presheaf.obj (Opposite.op (D_E a))),
              ψ_DE.hom d ∈ S := by
            intro d
            obtain ⟨w, rfl⟩ := hq_surj d
            exact hProj_in_S w
          rintro _ ⟨y, rfl⟩
          obtain ⟨n, d, hnd⟩ :=
            IsLocalization.Away.surj (S := ↑(E_bar.presheaf.obj (Opposite.op (U μ)))) f y
          have hnd' : y * res.hom f ^ n = res.hom d := hnd
          have h_eq_F : ψ_U.hom y * (ψ_DE.hom f) ^ n = ψ_DE.hom d := by
            calc ψ_U.hom y * (ψ_DE.hom f) ^ n
              _ = ψ_U.hom y * (ψ_U.hom (res.hom f)) ^ n := by rw [h_res_ψ f]
              _ = ψ_U.hom (y * res.hom f ^ n) := by rw [← map_pow, ← map_mul]
              _ = ψ_U.hom (res.hom d) := by rw [hnd']
              _ = ψ_DE.hom d := h_res_ψ d
          have hy_eq : ψ_U.hom y = ψ_DE.hom d * ((ψ_DE.hom f)⁻¹) ^ n := by
            have hpow_ne : (ψ_DE.hom f) ^ n ≠ 0 := pow_ne_zero n hψf_ne0
            calc ψ_U.hom y
              _ = (ψ_U.hom y * (ψ_DE.hom f) ^ n) * ((ψ_DE.hom f) ^ n)⁻¹ := by
                rw [mul_assoc, mul_inv_cancel₀ hpow_ne, mul_one]
              _ = ψ_DE.hom d * ((ψ_DE.hom f)⁻¹) ^ n := by
                rw [h_eq_F, inv_pow]
          rw [hy_eq]
          have hinv_S : (ψ_DE.hom f)⁻¹ ∈ S := by
            have hlast := hMem (Fin.last (M + 1))
            dsimp only [g_raw] at hlast
            rwa [Fin.snoc_last] at hlast
          exact S.mul_mem (hDE_in_S d) (S.pow_mem hinv_S n)
      let I_nz : Finset (Fin (M + 2)) := Finset.univ.filter (fun i => g_raw i ≠ 0)
      let m_μ : ℕ := I_nz.card
      let e_nz : Fin m_μ ≃ ↥I_nz := I_nz.equivFin.symm
      let φ_μ : Fin m_μ → RatFunc K_R := fun j => g_raw (e_nz j).1
      refine ⟨ψ_U, m_μ, φ_μ, ?_, hFrac_U, hSpec_U, ?_⟩
      · intro j
        exact (Finset.mem_filter.mp (e_nz j).2).2
      · intro S hSR
        rw [hRawEquiv S hSR]
        constructor
        · intro hAll j
          exact hAll (e_nz j).1
        · intro hNz i
          by_cases hi : g_raw i = 0
          · rw [hi]; exact S.zero_mem
          · have hi_mem : i ∈ I_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩
            have heq : φ_μ (e_nz.symm ⟨i, hi_mem⟩) = g_raw i := by
              dsimp only [φ_μ]
              rw [Equiv.apply_symm_apply]
            rw [← heq]
            exact hNz (e_nz.symm ⟨i, hi_mem⟩)
    choose ψU m φ hφ_ne hFracU hSpecU hSubEquiv using hChartData
    refine ⟨p, U, hAffU, ψU, m, φ, hφ_ne,
      fun μ => ⟨hFracU μ, hSpecU μ, hSubEquiv μ⟩, ?_, ?_, ?_⟩
    · refine ⟨(e_idx 0).1.1, hxf_mem (e_idx 0).1, hSub_cl (e_idx 0).1.2⟩
    · intro z hz
      have hz_cov := hS_cov hz
      simp only [Set.mem_iUnion] at hz_cov
      rcases hz_cov with ⟨x, hxS, hzx⟩
      refine ⟨e_idx.symm ⟨x, hxS⟩, ?_⟩
      change z ∈ E_bar.basicOpen (f_x (e_idx (e_idx.symm ⟨x, hxS⟩)).1)
      rw [Equiv.apply_symm_apply]
      exact hzx
    · intro μ z hzU
      exact hf_le (e_idx μ).1 hzU

  obtain ⟨p, U₁, hAff₁, ψ₁, m₁, φ₁, hφ₁_ne, hChart₁, ⟨z₁, hz₁_U, hz₁_cl⟩, hCov₁, hAv₁⟩ :=
    hBuildSide A₁ A₂ hA₁_comp hA₁_ne hA₂_cl hA_disj
      (fun z hz => by rw [← hA_union]; exact Or.inl hz)
  obtain ⟨q, U₂, hAff₂, ψ₂, m₂, φ₂, hφ₂_ne, hChart₂, ⟨z₂, hz₂_U, hz₂_cl⟩, hCov₂, hAv₂⟩ :=
    hBuildSide A₂ A₁ hA₂_comp hA₂_ne hA₁_cl hA_disj.symm
      (fun z hz => by rw [← hA_union]; exact Or.inr hz)
  obtain ⟨W₁, hW₁R, hW₁Max, hW₁Range⟩ :=
    hValWitness (U₁ 0) (hAff₁ 0) (ψ₁ 0) z₁ (hChart₁ 0).1 (hChart₁ 0).2.1 hz₁_U hz₁_cl
  obtain ⟨W₂, hW₂R, hW₂Max, hW₂Range⟩ :=
    hValWitness (U₂ 0) (hAff₂ 0) (ψ₂ 0) z₂ (hChart₂ 0).1 (hChart₂ 0).2.1 hz₂_U hz₂_cl
  have hW₁Mem : ∀ j : Fin (m₁ 0), φ₁ 0 j ∈ W₁ :=
    ((hChart₁ 0).2.2 W₁.toSubring hW₁R).mp hW₁Range
  have hW₂Mem : ∀ j : Fin (m₂ 0), φ₂ 0 j ∈ W₂ :=
    ((hChart₂ 0).2.2 W₂.toSubring hW₂R).mp hW₂Range
  apply hNoSplit
  refine ⟨p, q, m₁, φ₁, m₂, φ₂, W₁, W₂, hW₁R, hW₂R, hφ₁_ne, hφ₂_ne,
    hW₁Max, hW₂Max, hW₁Mem, hW₂Mem, ?_⟩
  intro W hWR hWMax
  obtain ⟨z_W, hzW_cl, hzW_iff⟩ := hValCenter W hWR hWMax
  have hzW_in_union : z_W ∈ A₁ ∪ A₂ := by
    rw [hA_union]; exact hzW_cl
  have hEquiv₁ : ∀ μ : Fin (p + 1),
      (z_W ∈ U₁ μ) ↔ (∀ j : Fin (m₁ μ), φ₁ μ j ∈ W) :=
    fun μ => (hzW_iff (U₁ μ) (hAff₁ μ) (ψ₁ μ) (hChart₁ μ).2.1).trans
      ((hChart₁ μ).2.2 W.toSubring hWR)
  have hEquiv₂ : ∀ ν : Fin (q + 1),
      (z_W ∈ U₂ ν) ↔ (∀ j : Fin (m₂ ν), φ₂ ν j ∈ W) :=
    fun ν => (hzW_iff (U₂ ν) (hAff₂ ν) (ψ₂ ν) (hChart₂ ν).2.1).trans
      ((hChart₂ ν).2.2 W.toSubring hWR)
  rcases hzW_in_union with hzA₁ | hzA₂
  · obtain ⟨μ₀, hμ₀⟩ := hCov₁ z_W hzA₁
    refine ⟨Or.inl ⟨μ₀, (hEquiv₁ μ₀).mp hμ₀⟩, ?_⟩
    rintro ⟨_, ⟨ν₀, hν₀⟩⟩
    exact hAv₂ ν₀ z_W ((hEquiv₂ ν₀).mpr hν₀) hzA₁
  · obtain ⟨ν₀, hν₀⟩ := hCov₂ z_W hzA₂
    refine ⟨Or.inr ⟨ν₀, (hEquiv₂ ν₀).mp hν₀⟩, ?_⟩
    rintro ⟨⟨μ₀, hμ₀⟩, _⟩
    exact hAv₁ μ₀ z_W ((hEquiv₁ μ₀).mpr hμ₀) hzA₂

theorem weil_algClosed_ratFunc_gauss_valuation_pkg (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R] :
    ∃ (v_gauss : K_R → {r : ValuationRing.ValueGroup R K_R // r ≠ 0} →
        Valuation (RatFunc K_R) (ValuationRing.ValueGroup R K_R)),
      (∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}) (x : R),
        RatFunc.C (algebraMap R K_R x) ∈ (v_gauss a r).valuationSubring) ∧
      (∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}) (x : R)
          (hx : RatFunc.C (algebraMap R K_R x) ∈ (v_gauss a r).valuationSubring),
        x ∈ IsLocalRing.maximalIdeal R →
        (⟨RatFunc.C (algebraMap R K_R x), hx⟩ : ↥(v_gauss a r).valuationSubring) ∈
          IsLocalRing.maximalIdeal ↥(v_gauss a r).valuationSubring) ∧
      (∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}) (c : K_R),
        v_gauss a r (RatFunc.C c) = ValuationRing.valuation R K_R c) ∧
      (∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}) (α : K_R),
        v_gauss a r (RatFunc.X - RatFunc.C α) =
          max r.1 (ValuationRing.valuation R K_R (a - α))) ∧
      (∀ (a₁ a₂ : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}),
        ValuationRing.valuation R K_R (a₁ - a₂) ≤ r.1 →
        (v_gauss a₁ r).valuationSubring = (v_gauss a₂ r).valuationSubring) ∧
      (∀ φ : RatFunc K_R, φ ≠ 0 →
        ∃ (c : K_R) (k_num k_den : ℕ) (α : Fin k_num → K_R) (β : Fin k_den → K_R),
          c ≠ 0 ∧
          φ = RatFunc.C c *
            (∏ i : Fin k_num, (RatFunc.X - RatFunc.C (α i))) *
            (∏ j : Fin k_den, (RatFunc.X - RatFunc.C (β j)))⁻¹) :=
by
  let Γ₀ := ValuationRing.ValueGroup R K_R
  let v_R : Valuation K_R Γ₀ := ValuationRing.valuation R K_R
  have h_strict_mul_left : ∀ {a b c d : Γ₀}, a < c → b ≤ d → 0 < c → 0 < d → a * b < c * d := by
    intro a b c d hac hbd hc hd
    by_cases hb : b = 0
    · rw [hb, mul_zero]
      exact zero_lt_iff.mpr (mul_ne_zero (zero_lt_iff.mp hc) (zero_lt_iff.mp hd))
    · have hab_lt : a * b < c * b := lt_of_le_of_ne (mul_le_mul' (le_of_lt hac) (le_refl b))
        (fun heq => (ne_of_lt hac) (mul_right_cancel₀ hb heq))
      exact lt_of_lt_of_le hab_lt (mul_le_mul' (le_refl c) hbd)
  have h_lt_of_mul_lt_right : ∀ {x y c : Γ₀}, x * c < y * c → x < y := by
    intro x y c hlt
    exact lt_of_not_ge (fun hle => not_le_of_gt hlt (mul_le_mul' hle (le_refl c)))
  have h_sum_mul_le : ∀ (S : Finset (ℕ × ℕ)) (f : ℕ × ℕ → K_R) (c M : Γ₀),
      (∀ p ∈ S, v_R (f p) * c ≤ M) → v_R (∑ p ∈ S, f p) * c ≤ M := by
    intro S f c M hS
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, map_zero, zero_mul]
      exact (zero_le : 0 ≤ M)
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      have h1 : v_R (f a) * c ≤ M := hS a (Finset.mem_insert_self a s)
      have h2 : v_R (∑ p ∈ s, f p) * c ≤ M :=
        ih (fun p hp => hS p (Finset.mem_insert_of_mem hp))
      have h_add : v_R (f a + ∑ p ∈ s, f p) ≤ max (v_R (f a)) (v_R (∑ p ∈ s, f p)) :=
        v_R.map_add _ _
      rcases le_total (v_R (f a)) (v_R (∑ p ∈ s, f p)) with hle | hle
      · have hm : max (v_R (f a)) (v_R (∑ p ∈ s, f p)) = v_R (∑ p ∈ s, f p) := max_eq_right hle
        exact le_trans (mul_le_mul' (hm ▸ h_add) (le_refl c)) h2
      · have hm : max (v_R (f a)) (v_R (∑ p ∈ s, f p)) = v_R (f a) := max_eq_left hle
        exact le_trans (mul_le_mul' (hm ▸ h_add) (le_refl c)) h1
  have h_sum_lt : ∀ (S : Finset (ℕ × ℕ)) (f : ℕ × ℕ → K_R) (M : Γ₀),
      0 < M → (∀ p ∈ S, v_R (f p) < M) → v_R (∑ p ∈ S, f p) < M := by
    intro S f M hM hS
    induction S using Finset.induction_on with
    | empty =>
      rw [Finset.sum_empty, map_zero]
      exact hM
    | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact lt_of_le_of_lt (v_R.map_add _ _)
        (max_lt (hS a (Finset.mem_insert_self a s))
          (ih (fun p hp => hS p (Finset.mem_insert_of_mem hp))))
  let g_fun : {r : Γ₀ // r ≠ 0} → Polynomial K_R → Γ₀ :=
    fun r P => P.support.sup (fun k => v_R (P.coeff k) * r.1 ^ k)
  have hg_term_le : ∀ (r : {r : Γ₀ // r ≠ 0}) (P : Polynomial K_R) (k : ℕ),
      v_R (P.coeff k) * r.1 ^ k ≤ g_fun r P := by
    intro r P k
    by_cases hk : P.coeff k = 0
    · rw [hk, map_zero, zero_mul]
      exact (zero_le : 0 ≤ g_fun r P)
    · exact Finset.le_sup (f := fun n => v_R (P.coeff n) * r.1 ^ n)
        (Polynomial.mem_support_iff.mpr hk)
  have hg_zero : ∀ r : {r : Γ₀ // r ≠ 0}, g_fun r 0 = 0 := by
    intro r
    dsimp [g_fun]
    rw [Finset.sup_empty, bot_eq_zero]
  have hg_pos : ∀ (r : {r : Γ₀ // r ≠ 0}) {P : Polynomial K_R}, P ≠ 0 → 0 < g_fun r P := by
    intro r P hP
    obtain ⟨k, hk⟩ := Polynomial.support_nonempty.mpr hP
    have hcoeff : P.coeff k ≠ 0 := Polynomial.mem_support_iff.mp hk
    have hv_ne : v_R (P.coeff k) ≠ 0 := (Valuation.ne_zero_iff v_R).mpr hcoeff
    have hterm_pos : 0 < v_R (P.coeff k) * r.1 ^ k :=
      zero_lt_iff.mpr (mul_ne_zero hv_ne (pow_ne_zero k r.2))
    exact lt_of_lt_of_le hterm_pos (hg_term_le r P k)
  have hg_const : ∀ (r : {r : Γ₀ // r ≠ 0}) (c : K_R),
      g_fun r (Polynomial.C c) = v_R c := by
    intro r c
    apply le_antisymm
    · refine Finset.sup_le (fun k hk => ?_)
      have hk_ne : (Polynomial.C c).coeff k ≠ 0 := Polynomial.mem_support_iff.mp hk
      by_cases hk0 : k = 0
      · subst hk0
        rw [Polynomial.coeff_C_zero, pow_zero, mul_one]
      · rw [Polynomial.coeff_C_of_ne_zero hk0] at hk_ne
        exact False.elim (hk_ne rfl)
    · have h0 := hg_term_le r (Polynomial.C c) 0
      rwa [Polynomial.coeff_C_zero, pow_zero, mul_one] at h0
  have hg_one : ∀ r : {r : Γ₀ // r ≠ 0}, g_fun r 1 = 1 := by
    intro r
    rw [← Polynomial.C_1, hg_const, map_one]
  have hg_lin : ∀ (r : {r : Γ₀ // r ≠ 0}) (b : K_R),
      g_fun r (Polynomial.X + Polynomial.C b) = max r.1 (v_R b) := by
    intro r b
    apply le_antisymm
    · refine Finset.sup_le (fun k hk => ?_)
      have hk_ne : (Polynomial.X + Polynomial.C b).coeff k ≠ 0 :=
        Polynomial.mem_support_iff.mp hk
      by_cases hk0 : k = 0
      · subst hk0
        rw [Polynomial.coeff_add, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero,
          zero_add, pow_zero, mul_one]
        exact le_max_right _ _
      · by_cases hk1 : k = 1
        · subst hk1
          rw [Polynomial.coeff_add, Polynomial.coeff_X_one,
            Polynomial.coeff_C_of_ne_zero one_ne_zero, add_zero, map_one, pow_one, one_mul]
          exact le_max_left _ _
        · have hX : (Polynomial.X : Polynomial K_R).coeff k = 0 := by
            rw [Polynomial.coeff_X]
            split_ifs with h1
            · exact False.elim (hk1 h1.symm)
            · rfl
          rw [Polynomial.coeff_add, hX, Polynomial.coeff_C_of_ne_zero hk0, add_zero] at hk_ne
          exact False.elim (hk_ne rfl)
    · refine max_le ?_ ?_
      · have h1 := hg_term_le r (Polynomial.X + Polynomial.C b) 1
        rwa [Polynomial.coeff_add, Polynomial.coeff_X_one,
          Polynomial.coeff_C_of_ne_zero one_ne_zero, add_zero, map_one, pow_one, one_mul] at h1
      · have h0 := hg_term_le r (Polynomial.X + Polynomial.C b) 0
        rwa [Polynomial.coeff_add, Polynomial.coeff_X_zero, Polynomial.coeff_C_zero,
          zero_add, pow_zero, mul_one] at h0
  have hg_add : ∀ (r : {r : Γ₀ // r ≠ 0}) (A B : Polynomial K_R),
      g_fun r (A + B) ≤ max (g_fun r A) (g_fun r B) := by
    intro r A B
    refine Finset.sup_le (fun k _hk => ?_)
    rw [Polynomial.coeff_add]
    have h_add := v_R.map_add (A.coeff k) (B.coeff k)
    rcases le_total (v_R (A.coeff k)) (v_R (B.coeff k)) with hle | hle
    · have hm : max (v_R (A.coeff k)) (v_R (B.coeff k)) = v_R (B.coeff k) := max_eq_right hle
      exact le_trans (mul_le_mul' (hm ▸ h_add) (le_refl _))
        (le_trans (hg_term_le r B k) (le_max_right _ _))
    · have hm : max (v_R (A.coeff k)) (v_R (B.coeff k)) = v_R (A.coeff k) := max_eq_left hle
      exact le_trans (mul_le_mul' (hm ▸ h_add) (le_refl _))
        (le_trans (hg_term_le r A k) (le_max_left _ _))
  have hg_min_max : ∀ (r : {r : Γ₀ // r ≠ 0}) {P : Polynomial K_R}, P ≠ 0 →
      ∃ m : ℕ, v_R (P.coeff m) * r.1 ^ m = g_fun r P ∧
        ∀ i < m, v_R (P.coeff i) * r.1 ^ i < g_fun r P := by
    intro r P hP
    obtain ⟨k, hk_supp, hk_eq⟩ := Finset.exists_mem_eq_sup P.support
      (Polynomial.support_nonempty.mpr hP) (fun n => v_R (P.coeff n) * r.1 ^ n)
    let S := P.support.filter (fun n => v_R (P.coeff n) * r.1 ^ n = g_fun r P)
    have hS_ne : S.Nonempty := ⟨k, Finset.mem_filter.mpr ⟨hk_supp, hk_eq.symm⟩⟩
    let m := S.min' hS_ne
    have hm_mem : m ∈ S := Finset.min'_mem S hS_ne
    have hm_eq : v_R (P.coeff m) * r.1 ^ m = g_fun r P := (Finset.mem_filter.mp hm_mem).2
    refine ⟨m, hm_eq, fun i hi => ?_⟩
    refine lt_of_le_of_ne (hg_term_le r P i) (fun heq => ?_)
    have hi_coeff : P.coeff i ≠ 0 := by
      intro h0
      rw [h0, map_zero, zero_mul] at heq
      exact (ne_of_gt (hg_pos r hP)) heq.symm
    have hi_mem : i ∈ S := Finset.mem_filter.mpr ⟨Polynomial.mem_support_iff.mpr hi_coeff, heq⟩
    exact not_le_of_gt hi (Finset.min'_le S i hi_mem)
  have hg_mul : ∀ (r : {r : Γ₀ // r ≠ 0}) (A B : Polynomial K_R),
      g_fun r (A * B) = g_fun r A * g_fun r B := by
    intro r A B
    apply le_antisymm
    · refine Finset.sup_le (fun n _hn => ?_)
      rw [Polynomial.coeff_mul]
      refine h_sum_mul_le (Finset.HasAntidiagonal.antidiagonal n)
        (fun p => A.coeff p.1 * B.coeff p.2) (r.1 ^ n) (g_fun r A * g_fun r B) (fun p hp => ?_)
      have hp_eq : p.1 + p.2 = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      rw [← hp_eq, map_mul, pow_add, mul_mul_mul_comm]
      exact mul_le_mul' (hg_term_le r A p.1) (hg_term_le r B p.2)
    · by_cases hA : A = 0
      · rw [hA, hg_zero, zero_mul]
        exact (zero_le : 0 ≤ g_fun r (0 * B))
      · by_cases hB : B = 0
        · rw [hB, hg_zero, mul_zero]
          exact (zero_le : 0 ≤ g_fun r (A * 0))
        · obtain ⟨i₀, hi₀_eq, hi₀_lt⟩ := hg_min_max r hA
          obtain ⟨j₀, hj₀_eq, hj₀_lt⟩ := hg_min_max r hB
          have h_mem_anti : (i₀, j₀) ∈ Finset.HasAntidiagonal.antidiagonal (i₀ + j₀) :=
            Finset.HasAntidiagonal.mem_antidiagonal.mpr rfl
          let d : K_R := A.coeff i₀ * B.coeff j₀
          let S_off := (Finset.HasAntidiagonal.antidiagonal (i₀ + j₀)).erase (i₀, j₀)
          let e : K_R := ∑ p ∈ S_off, A.coeff p.1 * B.coeff p.2
          have h_coeff_split : (A * B).coeff (i₀ + j₀) = d + e := by
            rw [Polynomial.coeff_mul]
            exact (Finset.add_sum_erase (Finset.HasAntidiagonal.antidiagonal (i₀ + j₀))
              (fun p => A.coeff p.1 * B.coeff p.2) h_mem_anti).symm
          have hvd_mul : v_R d * r.1 ^ (i₀ + j₀) = g_fun r A * g_fun r B := by
            dsimp [d]
            rw [map_mul, pow_add, mul_mul_mul_comm, hi₀_eq, hj₀_eq]
          have hAB_pos : 0 < g_fun r A * g_fun r B :=
            zero_lt_iff.mpr (mul_ne_zero (ne_of_gt (hg_pos r hA)) (ne_of_gt (hg_pos r hB)))
          have hvd_pos : 0 < v_R d := by
            by_contra hnot
            have h0 : v_R d = 0 := le_antisymm (not_lt.mp hnot) (zero_le : 0 ≤ v_R d)
            rw [h0, zero_mul] at hvd_mul
            exact (ne_of_gt hAB_pos) hvd_mul.symm
          have he_lt : v_R e < v_R d := by
            refine h_sum_lt S_off (fun p => A.coeff p.1 * B.coeff p.2) (v_R d) hvd_pos
              (fun p hp => ?_)
            have hp_ne : p ≠ (i₀, j₀) := (Finset.mem_erase.mp hp).1
            have hp_sum : p.1 + p.2 = i₀ + j₀ :=
              Finset.HasAntidiagonal.mem_antidiagonal.mp (Finset.mem_erase.mp hp).2
            have hp_lt_or : p.1 < i₀ ∨ p.2 < j₀ := by
              rcases lt_or_ge p.1 i₀ with h1 | h1
              · exact Or.inl h1
              · rcases lt_or_ge p.2 j₀ with h2 | h2
                · exact Or.inr h2
                · exfalso
                  apply hp_ne
                  ext <;> omega
            have h_prod_lt :
                (v_R (A.coeff p.1) * r.1 ^ p.1) * (v_R (B.coeff p.2) * r.1 ^ p.2) <
                  g_fun r A * g_fun r B := by
              rcases hp_lt_or with h1 | h2
              · exact h_strict_mul_left (hi₀_lt p.1 h1) (hg_term_le r B p.2)
                  (hg_pos r hA) (hg_pos r hB)
              · rw [mul_comm (v_R (A.coeff p.1) * r.1 ^ p.1), mul_comm (g_fun r A)]
                exact h_strict_mul_left (hj₀_lt p.2 h2) (hg_term_le r A p.1)
                  (hg_pos r hB) (hg_pos r hA)
            have h_term_mul :
                v_R (A.coeff p.1 * B.coeff p.2) * r.1 ^ (i₀ + j₀) <
                  v_R d * r.1 ^ (i₀ + j₀) := by
              calc
                v_R (A.coeff p.1 * B.coeff p.2) * r.1 ^ (i₀ + j₀) =
                    v_R (A.coeff p.1 * B.coeff p.2) * r.1 ^ (p.1 + p.2) := by rw [hp_sum]
                _ = (v_R (A.coeff p.1) * r.1 ^ p.1) * (v_R (B.coeff p.2) * r.1 ^ p.2) := by
                  rw [map_mul, pow_add, mul_mul_mul_comm]
                _ < g_fun r A * g_fun r B := h_prod_lt
                _ = v_R d * r.1 ^ (i₀ + j₀) := hvd_mul.symm
            exact h_lt_of_mul_lt_right h_term_mul
          have hv_coeff_eq : v_R ((A * B).coeff (i₀ + j₀)) = v_R d := by
            rw [h_coeff_split]
            exact v_R.map_add_eq_of_lt_left he_lt
          calc
            g_fun r A * g_fun r B = v_R d * r.1 ^ (i₀ + j₀) := hvd_mul.symm
            _ = v_R ((A * B).coeff (i₀ + j₀)) * r.1 ^ (i₀ + j₀) := by rw [hv_coeff_eq]
            _ ≤ g_fun r (A * B) := hg_term_le r (A * B) (i₀ + j₀)
  let g_val : ∀ r : {r : Γ₀ // r ≠ 0}, Valuation (Polynomial K_R) Γ₀ := fun r =>
    { toFun := g_fun r
      map_zero' := hg_zero r
      map_one' := hg_one r
      map_mul' := hg_mul r
      map_add_le_max' := hg_add r }
  let τ : K_R → Polynomial K_R →+* Polynomial K_R :=
    fun a => Polynomial.compRingHom (Polynomial.X + Polynomial.C a)
  let v_poly : K_R → {r : Γ₀ // r ≠ 0} → Valuation (Polynomial K_R) Γ₀ :=
    fun a r => (g_val r).comap (τ a)
  have hS_loc : ∀ (a : K_R) (r : {r : Γ₀ // r ≠ 0}),
      nonZeroDivisors (Polynomial K_R) ≤ (v_poly a r).supp.primeCompl := by
    intro a r P hP
    have hP_ne : P ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hP
    rw [Ideal.mem_primeCompl_iff, Valuation.mem_supp_iff]
    change g_fun r ((τ a) P) ≠ 0
    rw [Polynomial.coe_compRingHom_apply]
    have hcomp_ne : P.comp (Polynomial.X + Polynomial.C a) ≠ 0 := by
      intro h0
      apply hP_ne
      have h1 := congrArg (fun Q : Polynomial K_R => Q.comp (Polynomial.X - Polynomial.C a)) h0
      simpa [Polynomial.zero_comp, Polynomial.comp_assoc, Polynomial.add_comp,
        Polynomial.X_comp, Polynomial.C_comp, sub_add_cancel, Polynomial.comp_X] using h1
    exact ne_of_gt (hg_pos r hcomp_ne)
  let v_gauss : K_R → {r : Γ₀ // r ≠ 0} → Valuation (RatFunc K_R) Γ₀ :=
    fun a r => (v_poly a r).extendToLocalization (hS_loc a r) (RatFunc K_R)
  have hv_const : ∀ (a : K_R) (r : {r : Γ₀ // r ≠ 0}) (c : K_R),
      v_gauss a r (RatFunc.C c) = v_R c := by
    intro a r c
    rw [← RatFunc.algebraMap_C c]
    rw [Valuation.extendToLocalization_apply_map_apply (v_poly a r) (hS_loc a r) (RatFunc K_R)]
    change g_fun r ((τ a) (Polynomial.C c)) = v_R c
    rw [Polynomial.coe_compRingHom_apply, Polynomial.C_comp, hg_const]
  have hv_lin : ∀ (a : K_R) (r : {r : Γ₀ // r ≠ 0}) (α : K_R),
      v_gauss a r (RatFunc.X - RatFunc.C α) = max r.1 (v_R (a - α)) := by
    intro a r α
    have h_alg : RatFunc.X - RatFunc.C α =
        algebraMap (Polynomial K_R) (RatFunc K_R) (Polynomial.X - Polynomial.C α) := by
      rw [map_sub, RatFunc.algebraMap_X, RatFunc.algebraMap_C]
    rw [h_alg]
    rw [Valuation.extendToLocalization_apply_map_apply (v_poly a r) (hS_loc a r) (RatFunc K_R)]
    change g_fun r ((τ a) (Polynomial.X - Polynomial.C α)) = max r.1 (v_R (a - α))
    rw [Polynomial.coe_compRingHom_apply, Polynomial.sub_comp, Polynomial.X_comp,
      Polynomial.C_comp, add_sub_assoc, ← map_sub Polynomial.C a α, hg_lin]
  have hPolyFact : ∀ (A : Polynomial K_R), A ≠ 0 →
      ∃ (k : ℕ) (γ : Fin k → K_R),
        A.leadingCoeff ≠ 0 ∧
        algebraMap (Polynomial K_R) (RatFunc K_R) A =
          RatFunc.C A.leadingCoeff * ∏ i : Fin k, (RatFunc.X - RatFunc.C (γ i)) := by
    intro A hA
    have hcA : A.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hA
    obtain ⟨m, hm⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits A)
    let L : List K_R := m.toList
    refine ⟨L.length, L.get, hcA, ?_⟩
    let f_lin : K_R → Polynomial K_R := fun x => Polynomial.X - Polynomial.C x
    have h_prod : (Multiset.map f_lin m).prod = ∏ i : Fin L.length, f_lin (L.get i) := by
      rw [← Multiset.prod_map_toList m f_lin]
      change (List.map f_lin L).prod = ∏ i : Fin L.length, f_lin (L.get i)
      conv_lhs => rw [← List.ofFn_get L]
      rw [List.map_ofFn, List.prod_ofFn]
      rfl
    have hA_eq : A = Polynomial.C A.leadingCoeff * ∏ i : Fin L.length, f_lin (L.get i) := by
      simpa [f_lin, h_prod] using hm
    conv_lhs => rw [hA_eq]
    rw [map_mul, RatFunc.algebraMap_C, map_prod]
    congr 1
    refine Finset.prod_congr rfl (fun i _ => ?_)
    dsimp [f_lin]
    rw [map_sub, RatFunc.algebraMap_X, RatFunc.algebraMap_C]
  have hLinFact : ∀ φ : RatFunc K_R, φ ≠ 0 →
      ∃ (c : K_R) (k_num k_den : ℕ) (α : Fin k_num → K_R) (β : Fin k_den → K_R),
        c ≠ 0 ∧
        φ = RatFunc.C c *
          (∏ i : Fin k_num, (RatFunc.X - RatFunc.C (α i))) *
          (∏ j : Fin k_den, (RatFunc.X - RatFunc.C (β j)))⁻¹ := by
    intro φ hφ
    have hP : φ.num ≠ 0 := RatFunc.num_ne_zero hφ
    have hQ : φ.denom ≠ 0 := RatFunc.denom_ne_zero φ
    obtain ⟨k_num, α, hcP, hP_eq⟩ := hPolyFact φ.num hP
    obtain ⟨k_den, β, hcQ, hQ_eq⟩ := hPolyFact φ.denom hQ
    refine ⟨φ.num.leadingCoeff * (φ.denom.leadingCoeff)⁻¹, k_num, k_den, α, β,
      mul_ne_zero hcP (inv_ne_zero hcQ), ?_⟩
    have h_div := (RatFunc.num_div_denom φ).symm
    rw [div_eq_mul_inv, hP_eq, hQ_eq, mul_inv, mul_mul_mul_comm, ← map_inv₀, ← map_mul,
      ← mul_assoc] at h_div
    exact h_div
  have hvR : v_R.Integers R := ValuationRing.integers R K_R
  refine ⟨v_gauss, ?_, ?_, hv_const, hv_lin, ?_, hLinFact⟩
  · intro a r x
    rw [Valuation.mem_valuationSubring_iff, hv_const]
    exact hvR.map_le_one x
  · intro a r x hx hxMax
    have hxNotUnit : ¬ IsUnit x := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal x).mp hxMax)
    have hvx_ne_one : v_R (algebraMap R K_R x) ≠ 1 := by
      intro h1
      exact hxNotUnit ((hvR.isUnit_iff_valuation_eq_one).mpr h1)
    have hvx_lt_one : v_R (algebraMap R K_R x) < 1 :=
      lt_of_le_of_ne (hvR.map_le_one x) hvx_ne_one
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    rintro ⟨u, hu⟩
    have hmul_sub : (u : ↥(v_gauss a r).valuationSubring) * ↑(u⁻¹) = 1 := Units.mul_inv u
    rw [hu] at hmul_sub
    let y : ↥(v_gauss a r).valuationSubring := ↑(u⁻¹)
    have hmul_K : RatFunc.C (algebraMap R K_R x) * y.1 = 1 :=
      congrArg Subtype.val hmul_sub
    have hy_le : v_gauss a r y.1 ≤ 1 :=
      (Valuation.mem_valuationSubring_iff (v_gauss a r) y.1).mp y.2
    have h1_le : (1 : Γ₀) ≤ v_R (algebraMap R K_R x) := by
      calc
        (1 : Γ₀) = v_gauss a r 1 := (map_one (v_gauss a r)).symm
        _ = v_gauss a r (RatFunc.C (algebraMap R K_R x) * y.1) := by rw [hmul_K]
        _ = v_gauss a r (RatFunc.C (algebraMap R K_R x)) * v_gauss a r y.1 := map_mul _ _ _
        _ = v_R (algebraMap R K_R x) * v_gauss a r y.1 := by rw [hv_const]
        _ ≤ v_R (algebraMap R K_R x) * 1 := mul_le_mul' (le_refl _) hy_le
        _ = v_R (algebraMap R K_R x) := mul_one _
    exact not_lt_of_ge h1_le hvx_lt_one
  · intro a₁ a₂ r ha12
    have h_max_le : ∀ (b₁ b₂ α : K_R), v_R (b₁ - b₂) ≤ r.1 →
        max r.1 (v_R (b₁ - α)) ≤ max r.1 (v_R (b₂ - α)) := by
      intro b₁ b₂ α hb
      refine max_le (le_max_left _ _) ?_
      have h_eq : b₁ - α = (b₁ - b₂) + (b₂ - α) := (sub_add_sub_cancel b₁ b₂ α).symm
      rw [h_eq]
      exact le_trans (v_R.map_add _ _)
        (max_le (le_trans hb (le_max_left _ _)) (le_max_right _ _))
    have ha21 : v_R (a₂ - a₁) ≤ r.1 := by
      have h_neg : a₂ - a₁ = -(a₁ - a₂) := (neg_sub a₁ a₂).symm
      rw [h_neg, Valuation.map_neg]
      exact ha12
    have h_max_eq : ∀ α : K_R,
        max r.1 (v_R (a₁ - α)) = max r.1 (v_R (a₂ - α)) :=
      fun α => le_antisymm (h_max_le a₁ a₂ α ha12) (h_max_le a₂ a₁ α ha21)
    have h_val_eq : ∀ φ : RatFunc K_R, v_gauss a₁ r φ = v_gauss a₂ r φ := by
      intro φ
      by_cases hφ : φ = 0
      · rw [hφ, map_zero, map_zero]
      · obtain ⟨c, k_num, k_den, α, β, _hc, hφ_eq⟩ := hLinFact φ hφ
        rw [hφ_eq]
        simp only [map_mul, map_inv₀, map_prod, hv_const, hv_lin, h_max_eq]
    ext φ
    simp only [Valuation.mem_valuationSubring_iff, h_val_eq]

theorem weil_algClosed_ratFunc_gauss_approximation (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (v_gauss : K_R → {r : ValuationRing.ValueGroup R K_R // r ≠ 0} →
      Valuation (RatFunc K_R) (ValuationRing.ValueGroup R K_R))
    (hv_const : ∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}) (c : K_R),
      v_gauss a r (RatFunc.C c) = ValuationRing.valuation R K_R c)
    (hv_lin : ∀ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}) (α : K_R),
      v_gauss a r (RatFunc.X - RatFunc.C α) =
        max r.1 (ValuationRing.valuation R K_R (a - α)))
    (hLinFact : ∀ φ : RatFunc K_R, φ ≠ 0 →
      ∃ (c : K_R) (k_num k_den : ℕ) (α : Fin k_num → K_R) (β : Fin k_den → K_R),
        c ≠ 0 ∧
        φ = RatFunc.C c *
          (∏ i : Fin k_num, (RatFunc.X - RatFunc.C (α i))) *
          (∏ j : Fin k_den, (RatFunc.X - RatFunc.C (β j)))⁻¹)
    (W : ValuationSubring (RatFunc K_R))
    (hWR : ∀ x : R, RatFunc.C (algebraMap R K_R x) ∈ W)
    (hWMax : ∀ x ∈ IsLocalRing.maximalIdeal R,
      (⟨RatFunc.C (algebraMap R K_R x), hWR x⟩ : ↥W) ∈ IsLocalRing.maximalIdeal ↥W)
    (s : ℕ)
    (φ : Fin s → RatFunc K_R)
    (hφ_ne : ∀ ν : Fin s, φ ν ≠ 0)
    (hφ_mem : ∀ ν : Fin s, φ ν ∈ W) :
    ∃ (a : K_R) (r : {r : ValuationRing.ValueGroup R K_R // r ≠ 0}),
      ∀ ν : Fin s, φ ν ∈ (v_gauss a r).valuationSubring :=
by
  classical
  let v_R : Valuation K_R (ValuationRing.ValueGroup R K_R) := ValuationRing.valuation R K_R
  have hv_R : v_R.Integers R := ValuationRing.integers R K_R
  
  have hm₀_ex : ∃ m₀ ∈ IsLocalRing.maximalIdeal R, m₀ ≠ 0 := by
    by_contra! hall
    apply hMaxR
    ext x
    simp only [Ideal.mem_bot]
    exact ⟨hall x, fun hx => hx ▸ Ideal.zero_mem _⟩
  obtain ⟨m₀, hm₀_max, hm₀_ne⟩ := hm₀_ex
  have hm₀_K_ne : algebraMap R K_R m₀ ≠ 0 := by
    intro h0
    exact hm₀_ne ((IsFractionRing.injective R K_R) (h0.trans (map_zero (algebraMap R K_R)).symm))
  let ϖ : ValuationRing.ValueGroup R K_R := v_R (algebraMap R K_R m₀)
  have hϖ_ne : ϖ ≠ 0 := (v_R.ne_zero_iff).mpr hm₀_K_ne
  have hϖ_pos : 0 < ϖ := zero_lt_iff.mpr hϖ_ne
  have hϖ_le_one : ϖ ≤ 1 := hv_R.map_le_one m₀
  have hϖ_ne_one : ϖ ≠ 1 := by
    intro h1
    have hUnit : IsUnit m₀ := (hv_R.isUnit_iff_valuation_eq_one).mpr h1
    rw [IsLocalRing.mem_maximalIdeal] at hm₀_max
    exact hm₀_max hUnit
  have hϖ_lt_one : ϖ < 1 := lt_of_le_of_ne hϖ_le_one hϖ_ne_one
  
  have hDiv : ∀ (x : ValuationRing.ValueGroup R K_R) (n : ℕ), 1 ≤ n →
      ∃ y : ValuationRing.ValueGroup R K_R, y ^ n = x := by
    intro x n hn
    obtain ⟨z₀, hz₀⟩ := Quotient.exists_rep x
    have hz₀_val : v_R z₀ = x := hz₀
    obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq z₀ (by omega : 0 < n)
    refine ⟨v_R z, ?_⟩
    rw [← map_pow, hz, hz₀_val]
  
  have h_le_iff : ∀ x y : K_R,
      v_R x ≤ v_R y ↔ W.valuation (RatFunc.C x) ≤ W.valuation (RatFunc.C y) := by
    intro x y
    constructor
    · intro hxy
      by_cases hy : y = 0
      · subst hy
        rw [map_zero] at hxy
        have hx0 : v_R x = 0 := le_zero_iff.mp hxy
        have hx : x = 0 := (v_R.zero_iff).mp hx0
        subst hx
        exact le_rfl
      · have hvy_pos : 0 < v_R y := zero_lt_iff.mpr ((v_R.ne_zero_iff).mpr hy)
        have hdiv_le : v_R (x / y) ≤ 1 := by
          rw [div_eq_mul_inv, map_mul, map_inv₀, mul_inv_le_iff₀ hvy_pos, one_mul]
          exact hxy
        obtain ⟨r₀, hr₀⟩ := hv_R.exists_of_le_one hdiv_le
        have hmemW : RatFunc.C (x / y) ∈ W := by
          rw [← hr₀]
          exact hWR r₀
        have hvW_le : W.valuation (RatFunc.C (x / y)) ≤ 1 :=
          (W.valuation_le_one_iff (RatFunc.C (x / y))).mpr hmemW
        have hx_eq : x = (x / y) * y := (div_mul_cancel₀ x hy).symm
        calc
          W.valuation (RatFunc.C x)
            = W.valuation (RatFunc.C (x / y)) * W.valuation (RatFunc.C y) := by
              conv_lhs => rw [hx_eq]
              rw [map_mul, map_mul]
          _ ≤ 1 * W.valuation (RatFunc.C y) := mul_le_mul' hvW_le le_rfl
          _ = W.valuation (RatFunc.C y) := one_mul _
    · intro hWxy
      apply le_of_not_gt
      intro hyx
      have hvx_pos : 0 < v_R x := lt_of_le_of_lt zero_le hyx
      have hvx_ne : v_R x ≠ 0 := ne_of_gt hvx_pos
      have hx_ne : x ≠ 0 := (v_R.ne_zero_iff).mp hvx_ne
      have hCx_ne : (RatFunc.C x : RatFunc K_R) ≠ 0 := by
        intro hC0
        exact hx_ne (RatFunc.C_injective (hC0.trans (map_zero RatFunc.C).symm))
      have hvWCx_pos : 0 < W.valuation (RatFunc.C x) :=
        zero_lt_iff.mpr ((W.valuation.ne_zero_iff).mpr hCx_ne)
      have hdiv_lt : v_R (y / x) < 1 := by
        rw [div_eq_mul_inv, map_mul, map_inv₀, mul_inv_lt_iff₀ hvx_pos, one_mul]
        exact hyx
      obtain ⟨m₁, hm₁⟩ := hv_R.exists_of_le_one (le_of_lt hdiv_lt)
      have hm₁_not_unit : ¬ IsUnit m₁ := by
        intro hU
        have h1 : v_R (algebraMap R K_R m₁) = 1 := (hv_R.isUnit_iff_valuation_eq_one).mp hU
        rw [hm₁] at h1
        exact (ne_of_lt hdiv_lt) h1
      have hm₁_max : m₁ ∈ IsLocalRing.maximalIdeal R := by
        rw [IsLocalRing.mem_maximalIdeal]
        exact hm₁_not_unit
      have hvW_lt : W.valuation (RatFunc.C (y / x)) < 1 := by
        rw [← hm₁]
        exact (W.valuation_lt_one_iff ⟨RatFunc.C (algebraMap R K_R m₁), hWR m₁⟩).mp
          (hWMax m₁ hm₁_max)
      have hy_eq : y = (y / x) * x := (div_mul_cancel₀ y hx_ne).symm
      have hW_lt : W.valuation (RatFunc.C y) < W.valuation (RatFunc.C x) := by
        calc
          W.valuation (RatFunc.C y)
            = W.valuation (RatFunc.C (y / x)) * W.valuation (RatFunc.C x) := by
              conv_lhs => rw [hy_eq]
              rw [map_mul, map_mul]
          _ < 1 * W.valuation (RatFunc.C x) :=
              (mul_lt_mul_iff_left₀ hvWCx_pos).mpr hvW_lt
          _ = W.valuation (RatFunc.C x) := one_mul _
      exact not_lt_of_ge hWxy hW_lt
  let rep : ValuationRing.ValueGroup R K_R → K_R :=
    fun τ => Classical.choose (Quotient.exists_rep τ)
  have hrep : ∀ τ : ValuationRing.ValueGroup R K_R, v_R (rep τ) = τ :=
    fun τ => Classical.choose_spec (Quotient.exists_rep τ)
  let ι₀ : ValuationRing.ValueGroup R K_R → W.ValueGroup :=
    fun τ => W.valuation (RatFunc.C (rep τ))
  have hι₀_val : ∀ c : K_R, ι₀ (v_R c) = W.valuation (RatFunc.C c) := by
    intro c
    apply le_antisymm
    · exact (h_le_iff (rep (v_R c)) c).mp (le_of_eq (hrep (v_R c)))
    · exact (h_le_iff c (rep (v_R c))).mp (le_of_eq (hrep (v_R c)).symm)
  let ι : ValuationRing.ValueGroup R K_R →*₀ W.ValueGroup :=
    { toFun := ι₀
      map_zero' := by
        have h0 : (0 : ValuationRing.ValueGroup R K_R) = v_R 0 := (map_zero v_R).symm
        rw [h0, hι₀_val, map_zero, map_zero]
      map_one' := by
        have h1 : (1 : ValuationRing.ValueGroup R K_R) = v_R 1 := (map_one v_R).symm
        rw [h1, hι₀_val, map_one, map_one]
      map_mul' := by
        intro τ₁ τ₂
        conv_lhs => rw [← hrep τ₁, ← hrep τ₂, ← map_mul v_R]
        rw [hι₀_val, map_mul, map_mul] }
  have hι_val : ∀ c : K_R, ι (v_R c) = W.valuation (RatFunc.C c) := hι₀_val
  have hι : StrictMono ι := by
    intro τ₁ τ₂ hlt
    rw [lt_iff_le_not_ge] at hlt ⊢
    refine ⟨?_, ?_⟩
    · change ι₀ τ₁ ≤ ι₀ τ₂
      exact (h_le_iff (rep τ₁) (rep τ₂)).mp (by rw [hrep, hrep]; exact hlt.1)
    · intro hge
      apply hlt.2
      rw [← hrep τ₂, ← hrep τ₁]
      exact (h_le_iff (rep τ₂) (rep τ₁)).mpr hge
  
  have hFactAll : ∀ ν : Fin s,
      ∃ (c : K_R) (k_num k_den : ℕ) (α : Fin k_num → K_R) (β : Fin k_den → K_R),
        c ≠ 0 ∧
        φ ν = RatFunc.C c *
          (∏ i : Fin k_num, (RatFunc.X - RatFunc.C (α i))) *
          (∏ j : Fin k_den, (RatFunc.X - RatFunc.C (β j)))⁻¹ :=
    fun ν => hLinFact (φ ν) (hφ_ne ν)
  choose c_K k_num k_den α β hc_K_ne hφ_eq using hFactAll
  let S' : Finset K_R :=
    insert 0
      ((Finset.univ.biUnion fun ν : Fin s => Finset.univ.image (α ν)) ∪
       (Finset.univ.biUnion fun ν : Fin s => Finset.univ.image (β ν)))
  obtain ⟨a, ha_mem, ha_min⟩ :=
    Finset.exists_min_image S' (fun z : K_R => W.valuation (RatFunc.X - RatFunc.C z))
      ⟨0, Finset.mem_insert_self 0 _⟩
  let γ : W.ValueGroup := W.valuation (RatFunc.X - RatFunc.C a)
  have hXa_ne : (RatFunc.X - RatFunc.C a : RatFunc K_R) ≠ 0 := by
    have hp : (Polynomial.X - Polynomial.C a : Polynomial K_R) ≠ 0 :=
      Polynomial.X_sub_C_ne_zero a
    have hr := RatFunc.algebraMap_ne_zero hp
    rwa [map_sub, RatFunc.algebraMap_X, RatFunc.algebraMap_C] at hr
  have hγ : γ ≠ 0 := (W.valuation.ne_zero_iff).mpr hXa_ne
  have hγ_pos : 0 < γ := zero_lt_iff.mpr hγ
  have hUltra : ∀ z ∈ S',
      W.valuation (RatFunc.X - RatFunc.C z) =
        max γ (W.valuation (RatFunc.C (a - z))) := by
    intro z hz
    apply le_antisymm
    · have h_add_eq : (RatFunc.X - RatFunc.C z : RatFunc K_R) =
          (RatFunc.X - RatFunc.C a) + RatFunc.C (a - z) := by
        rw [map_sub]
        ring
      rw [h_add_eq]
      exact W.valuation.map_add (RatFunc.X - RatFunc.C a) (RatFunc.C (a - z))
    · refine max_le (ha_min z hz) ?_
      have h_sub_eq : (RatFunc.C (a - z) : RatFunc K_R) =
          (RatFunc.X - RatFunc.C z) - (RatFunc.X - RatFunc.C a) := by
        rw [map_sub]
        ring
      calc
        W.valuation (RatFunc.C (a - z))
          = W.valuation ((RatFunc.X - RatFunc.C z) - (RatFunc.X - RatFunc.C a)) := by
            rw [h_sub_eq]
        _ ≤ max (W.valuation (RatFunc.X - RatFunc.C z)) γ :=
            W.valuation.map_sub (RatFunc.X - RatFunc.C z) (RatFunc.X - RatFunc.C a)
        _ ≤ W.valuation (RatFunc.X - RatFunc.C z) := max_le le_rfl (ha_min z hz)
  let c : Fin s → ValuationRing.ValueGroup R K_R := fun ν => v_R (c_K ν)
  have hc : ∀ ν : Fin s, c ν ≠ 0 := fun ν => (v_R.ne_zero_iff).mpr (hc_K_ne ν)
  let θ : ∀ ν : Fin s, Fin (k_num ν) → ValuationRing.ValueGroup R K_R :=
    fun ν i => v_R (a - α ν i)
  let η : ∀ ν : Fin s, Fin (k_den ν) → ValuationRing.ValueGroup R K_R :=
    fun ν j => v_R (a - β ν j)
  have hα_mem_S' : ∀ (ν : Fin s) (i : Fin (k_num ν)), α ν i ∈ S' := by
    intro ν i
    exact Finset.mem_insert_of_mem (Finset.mem_union_left _
      (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, Finset.mem_image_of_mem _ (Finset.mem_univ i)⟩))
  have hβ_mem_S' : ∀ (ν : Fin s) (j : Fin (k_den ν)), β ν j ∈ S' := by
    intro ν j
    exact Finset.mem_insert_of_mem (Finset.mem_union_right _
      (Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, Finset.mem_image_of_mem _ (Finset.mem_univ j)⟩))
  have hW : ∀ ν : Fin s,
      ι (c ν) *
        (∏ i : Fin (k_num ν), max γ (ι (θ ν i))) *
        (∏ j : Fin (k_den ν), max γ (ι (η ν j)))⁻¹ ≤ 1 := by
    intro ν
    have hv_le : W.valuation (φ ν) ≤ 1 := (W.valuation_le_one_iff (φ ν)).mpr (hφ_mem ν)
    rw [hφ_eq ν, map_mul, map_mul, map_inv₀, map_prod, map_prod] at hv_le
    have h1 : W.valuation (RatFunc.C (c_K ν)) = ι (c ν) := (hι_val (c_K ν)).symm
    have h2 : (∏ i : Fin (k_num ν), W.valuation (RatFunc.X - RatFunc.C (α ν i))) =
        ∏ i : Fin (k_num ν), max γ (ι (θ ν i)) := by
      refine Finset.prod_congr rfl fun i _ => ?_
      rw [hUltra (α ν i) (hα_mem_S' ν i), ← hι_val (a - α ν i)]
    have h3 : (∏ j : Fin (k_den ν), W.valuation (RatFunc.X - RatFunc.C (β ν j))) =
        ∏ j : Fin (k_den ν), max γ (ι (η ν j)) := by
      refine Finset.prod_congr rfl fun j _ => ?_
      rw [hUltra (β ν j) (hβ_mem_S' ν j), ← hι_val (a - β ν j)]
    rwa [h1, h2, h3] at hv_le
  
  suffices hApprox : ∃ r₀ : ValuationRing.ValueGroup R K_R, r₀ ≠ 0 ∧
      ∀ ν : Fin s,
        c ν *
          (∏ i : Fin (k_num ν), max r₀ (θ ν i)) *
          (∏ j : Fin (k_den ν), max r₀ (η ν j))⁻¹ ≤ 1 by
    obtain ⟨r₀, hr₀, hr_ineq⟩ := hApprox
    refine ⟨a, ⟨r₀, hr₀⟩, ?_⟩
    intro ν
    rw [Valuation.mem_valuationSubring_iff, hφ_eq ν,
      map_mul, map_mul, map_inv₀, map_prod, map_prod, hv_const]
    simp_rw [hv_lin]
    exact hr_ineq ν
  by_cases hHit : ∃ r₀ : ValuationRing.ValueGroup R K_R, r₀ ≠ 0 ∧ ι r₀ = γ
  · 
    obtain ⟨r₀, hr₀, hEq⟩ := hHit
    refine ⟨r₀, hr₀, ?_⟩
    intro ν
    apply hι.le_iff_le.mp
    rw [map_one, map_mul, map_mul, map_inv₀, map_prod, map_prod]
    simp_rw [hι.monotone.map_max, hEq]
    exact hW ν
  · 
    have hNe : ∀ x : ValuationRing.ValueGroup R K_R, ι x ≠ γ := by
      intro x hx
      by_cases hx0 : x = 0
      · subst hx0
        rw [map_zero] at hx
        exact hγ hx.symm
      · exact hHit ⟨x, hx0, hx⟩
    have hNotLt : ∀ x : ValuationRing.ValueGroup R K_R, ¬ (ι x < γ) → γ < ι x := by
      intro x hnl
      exact lt_of_le_of_ne (not_lt.mp hnl) (hNe x).symm
    let I_lt : ∀ ν : Fin s, Finset (Fin (k_num ν)) :=
      fun ν => Finset.univ.filter (fun i => ι (θ ν i) < γ)
    let I_gt : ∀ ν : Fin s, Finset (Fin (k_num ν)) :=
      fun ν => Finset.univ.filter (fun i => ¬ (ι (θ ν i) < γ))
    let A : Fin s → ℕ := fun ν => (I_lt ν).card
    let P_num : Fin s → ValuationRing.ValueGroup R K_R :=
      fun ν => ∏ i ∈ I_gt ν, θ ν i
    let J_lt : ∀ ν : Fin s, Finset (Fin (k_den ν)) :=
      fun ν => Finset.univ.filter (fun j => ι (η ν j) < γ)
    let J_gt : ∀ ν : Fin s, Finset (Fin (k_den ν)) :=
      fun ν => Finset.univ.filter (fun j => ¬ (ι (η ν j) < γ))
    let B : Fin s → ℕ := fun ν => (J_lt ν).card
    let P_den : Fin s → ValuationRing.ValueGroup R K_R :=
      fun ν => ∏ j ∈ J_gt ν, η ν j
    have hθ_gt_ne : ∀ (ν : Fin s) (i : Fin (k_num ν)), i ∈ I_gt ν → θ ν i ≠ 0 := by
      intro ν i hi h0
      have hgt : γ < ι (θ ν i) := hNotLt (θ ν i) (Finset.mem_filter.mp hi).2
      rw [h0, map_zero] at hgt
      exact not_lt_of_ge zero_le hgt
    have hη_gt_ne : ∀ (ν : Fin s) (j : Fin (k_den ν)), j ∈ J_gt ν → η ν j ≠ 0 := by
      intro ν j hj h0
      have hgt : γ < ι (η ν j) := hNotLt (η ν j) (Finset.mem_filter.mp hj).2
      rw [h0, map_zero] at hgt
      exact not_lt_of_ge zero_le hgt
    have hP_num_ne : ∀ ν : Fin s, P_num ν ≠ 0 :=
      fun ν => Finset.prod_ne_zero_iff.mpr fun i hi => hθ_gt_ne ν i hi
    have hP_den_ne : ∀ ν : Fin s, P_den ν ≠ 0 :=
      fun ν => Finset.prod_ne_zero_iff.mpr fun j hj => hη_gt_ne ν j hj
    let C_num : Fin s → ValuationRing.ValueGroup R K_R := fun ν => c ν * P_num ν
    let C_den : Fin s → ValuationRing.ValueGroup R K_R := fun ν => P_den ν
    have hC_num_ne : ∀ ν : Fin s, C_num ν ≠ 0 :=
      fun ν => mul_ne_zero (hc ν) (hP_num_ne ν)
    have hC_den_ne : ∀ ν : Fin s, C_den ν ≠ 0 := hP_den_ne
    have hι_ne : ∀ {x : ValuationRing.ValueGroup R K_R}, x ≠ 0 → ι x ≠ 0 := by
      intro x hx h0
      exact hx (hι.injective (h0.trans (map_zero ι).symm))
    have hProd_γ_num : ∀ ν : Fin s,
        (∏ i : Fin (k_num ν), max γ (ι (θ ν i))) = γ ^ A ν * ι (P_num ν) := by
      intro ν
      rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
        (fun i : Fin (k_num ν) => ι (θ ν i) < γ)]
      congr 1
      · calc
          (∏ i ∈ I_lt ν, max γ (ι (θ ν i)))
            = ∏ _i ∈ I_lt ν, γ :=
              Finset.prod_congr rfl fun i hi => max_eq_left (le_of_lt (Finset.mem_filter.mp hi).2)
          _ = γ ^ A ν := Finset.prod_const γ
      · calc
          (∏ i ∈ I_gt ν, max γ (ι (θ ν i)))
            = ∏ i ∈ I_gt ν, ι (θ ν i) :=
              Finset.prod_congr rfl fun i hi =>
                max_eq_right (le_of_lt (hNotLt (θ ν i) (Finset.mem_filter.mp hi).2))
          _ = ι (P_num ν) := (map_prod ι _ _).symm
    have hProd_γ_den : ∀ ν : Fin s,
        (∏ j : Fin (k_den ν), max γ (ι (η ν j))) = γ ^ B ν * ι (P_den ν) := by
      intro ν
      rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
        (fun j : Fin (k_den ν) => ι (η ν j) < γ)]
      congr 1
      · calc
          (∏ j ∈ J_lt ν, max γ (ι (η ν j)))
            = ∏ _j ∈ J_lt ν, γ :=
              Finset.prod_congr rfl fun j hj => max_eq_left (le_of_lt (Finset.mem_filter.mp hj).2)
          _ = γ ^ B ν := Finset.prod_const γ
      · calc
          (∏ j ∈ J_gt ν, max γ (ι (η ν j)))
            = ∏ j ∈ J_gt ν, ι (η ν j) :=
              Finset.prod_congr rfl fun j hj =>
                max_eq_right (le_of_lt (hNotLt (η ν j) (Finset.mem_filter.mp hj).2))
          _ = ι (P_den ν) := (map_prod ι _ _).symm
    have hW_mon : ∀ ν : Fin s,
        ι (C_num ν) * γ ^ A ν ≤ ι (C_den ν) * γ ^ B ν := by
      intro ν
      have hw := hW ν
      rw [hProd_γ_num ν, hProd_γ_den ν] at hw
      have hden_pos : 0 < γ ^ B ν * ι (P_den ν) :=
        zero_lt_iff.mpr (mul_ne_zero (pow_ne_zero (B ν) hγ) (hι_ne (hP_den_ne ν)))
      rw [mul_inv_le_iff₀ hden_pos, one_mul] at hw
      calc
        ι (C_num ν) * γ ^ A ν
          = ι (c ν) * (γ ^ A ν * ι (P_num ν)) := by
            dsimp [C_num]
            rw [map_mul]
            ac_rfl
        _ ≤ γ ^ B ν * ι (P_den ν) := hw
        _ = ι (C_den ν) * γ ^ B ν := mul_comm _ _
    let ρ : Fin s → ValuationRing.ValueGroup R K_R := fun ν =>
      if h1 : B ν < A ν then
        Classical.choose (hDiv (C_den ν * (C_num ν)⁻¹) (A ν - B ν) (by omega))
      else if h2 : A ν < B ν then
        Classical.choose (hDiv (C_num ν * (C_den ν)⁻¹) (B ν - A ν) (by omega))
      else 1
    have hρ_BA : ∀ ν : Fin s, B ν < A ν →
        (ρ ν) ^ (A ν - B ν) = C_den ν * (C_num ν)⁻¹ ∧ ρ ν ≠ 0 ∧ γ < ι (ρ ν) := by
      intro ν hBA
      have hpow : (ρ ν) ^ (A ν - B ν) = C_den ν * (C_num ν)⁻¹ := by
        dsimp only [ρ]
        rw [dif_pos hBA]
        exact Classical.choose_spec (hDiv (C_den ν * (C_num ν)⁻¹) (A ν - B ν) (by omega))
      have hne : ρ ν ≠ 0 := by
        intro h0
        have hrhs_ne : C_den ν * (C_num ν)⁻¹ ≠ 0 :=
          mul_ne_zero (hC_den_ne ν) (inv_ne_zero (hC_num_ne ν))
        rw [h0, zero_pow (by omega : A ν - B ν ≠ 0)] at hpow
        exact hrhs_ne hpow.symm
      have hgt : γ < ι (ρ ν) := by
        have hw := hW_mon ν
        have hA_eq : A ν = (A ν - B ν) + B ν := (Nat.sub_add_cancel (le_of_lt hBA)).symm
        rw [hA_eq, pow_add, ← mul_assoc] at hw
        have hB_pos : 0 < γ ^ B ν := zero_lt_iff.mpr (pow_ne_zero (B ν) hγ)
        have hw' : ι (C_num ν) * γ ^ (A ν - B ν) ≤ ι (C_den ν) :=
          le_of_not_gt fun hlt => not_lt_of_ge hw ((mul_lt_mul_iff_left₀ hB_pos).mpr hlt)
        have hCnum_pos : 0 < ι (C_num ν) := zero_lt_iff.mpr (hι_ne (hC_num_ne ν))
        have hw'' : γ ^ (A ν - B ν) ≤ (ι (ρ ν)) ^ (A ν - B ν) := by
          rw [← map_pow ι, hpow, map_mul, map_inv₀, le_mul_inv_iff₀ hCnum_pos, mul_comm]
          exact hw'
        have hle : γ ≤ ι (ρ ν) :=
          (pow_le_pow_iff_left₀ zero_le zero_le (by omega : A ν - B ν ≠ 0)).mp hw''
        exact lt_of_le_of_ne hle (hNe (ρ ν)).symm
      exact ⟨hpow, hne, hgt⟩
    have hρ_AB : ∀ ν : Fin s, A ν < B ν →
        (ρ ν) ^ (B ν - A ν) = C_num ν * (C_den ν)⁻¹ ∧ ρ ν ≠ 0 ∧ ι (ρ ν) < γ := by
      intro ν hAB
      have hnBA : ¬ B ν < A ν := by omega
      have hpow : (ρ ν) ^ (B ν - A ν) = C_num ν * (C_den ν)⁻¹ := by
        dsimp only [ρ]
        rw [dif_neg hnBA, dif_pos hAB]
        exact Classical.choose_spec (hDiv (C_num ν * (C_den ν)⁻¹) (B ν - A ν) (by omega))
      have hne : ρ ν ≠ 0 := by
        intro h0
        have hrhs_ne : C_num ν * (C_den ν)⁻¹ ≠ 0 :=
          mul_ne_zero (hC_num_ne ν) (inv_ne_zero (hC_den_ne ν))
        rw [h0, zero_pow (by omega : B ν - A ν ≠ 0)] at hpow
        exact hrhs_ne hpow.symm
      have hlt : ι (ρ ν) < γ := by
        have hw := hW_mon ν
        have hB_eq : B ν = (B ν - A ν) + A ν := (Nat.sub_add_cancel (le_of_lt hAB)).symm
        rw [hB_eq, pow_add, ← mul_assoc] at hw
        have hA_pos : 0 < γ ^ A ν := zero_lt_iff.mpr (pow_ne_zero (A ν) hγ)
        have hw' : ι (C_num ν) ≤ ι (C_den ν) * γ ^ (B ν - A ν) :=
          le_of_not_gt fun hgt => not_lt_of_ge hw ((mul_lt_mul_iff_left₀ hA_pos).mpr hgt)
        have hCden_pos : 0 < ι (C_den ν) := zero_lt_iff.mpr (hι_ne (hC_den_ne ν))
        have hw'' : (ι (ρ ν)) ^ (B ν - A ν) ≤ γ ^ (B ν - A ν) := by
          rw [← map_pow, hpow, map_mul, map_inv₀, mul_inv_le_iff₀ hCden_pos,
            mul_comm (γ ^ (B ν - A ν))]
          exact hw'
        have hle : ι (ρ ν) ≤ γ :=
          (pow_le_pow_iff_left₀ zero_le zero_le (by omega : B ν - A ν ≠ 0)).mp hw''
        exact lt_of_le_of_ne hle (hNe (ρ ν))
      exact ⟨hpow, hne, hlt⟩
    have hρ_ne : ∀ ν : Fin s, ρ ν ≠ 0 := by
      intro ν
      by_cases h1 : B ν < A ν
      · exact (hρ_BA ν h1).2.1
      · by_cases h2 : A ν < B ν
        · exact (hρ_AB ν h2).2.1
        · dsimp only [ρ]
          rw [dif_neg h1, dif_neg h2]
          exact one_ne_zero
    let T₀ : Finset (ValuationRing.ValueGroup R K_R) :=
      ((Finset.univ.biUnion fun ν : Fin s => Finset.univ.image (θ ν)) ∪
       (Finset.univ.biUnion fun ν : Fin s => Finset.univ.image (η ν))).filter (· ≠ 0)
    let T_all : Finset (ValuationRing.ValueGroup R K_R) :=
      T₀ ∪ (Finset.univ.filter fun ν : Fin s => A ν ≠ B ν).image ρ
    have hT_ne : ∀ τ ∈ T_all, τ ≠ 0 := by
      intro τ hτ
      rcases Finset.mem_union.mp hτ with hτ₀ | hτρ
      · exact (Finset.mem_filter.mp hτ₀).2
      · rcases Finset.mem_image.mp hτρ with ⟨ν, _, rfl⟩
        exact hρ_ne ν
    let L : Finset (ValuationRing.ValueGroup R K_R) := T_all.filter (fun τ => ι τ < γ)
    let U : Finset (ValuationRing.ValueGroup R K_R) := T_all.filter (fun τ => γ < ι τ)
    have hSep : ∃ r₀ : ValuationRing.ValueGroup R K_R,
        r₀ ≠ 0 ∧ (∀ τ ∈ L, τ < r₀) ∧ (∀ τ ∈ U, r₀ < τ) := by
      by_cases hL : L.Nonempty
      · by_cases hU : U.Nonempty
        · 
          let ℓ := L.max' hL
          let u := U.min' hU
          have hℓ_L : ℓ ∈ L := Finset.max'_mem L hL
          have hu_U : u ∈ U := Finset.min'_mem U hU
          have hℓ_ne : ℓ ≠ 0 := hT_ne ℓ (Finset.mem_filter.mp hℓ_L).1
          have hu_ne : u ≠ 0 := hT_ne u (Finset.mem_filter.mp hu_U).1
          have hℓ_pos : 0 < ℓ := zero_lt_iff.mpr hℓ_ne
          have hu_pos : 0 < u := zero_lt_iff.mpr hu_ne
          have hℓu : ℓ < u :=
            hι.lt_iff_lt.mp (lt_trans (Finset.mem_filter.mp hℓ_L).2 (Finset.mem_filter.mp hu_U).2)
          obtain ⟨δ, hδ⟩ := hDiv (ℓ * u) 2 (by omega)
          have hδ_ne : δ ≠ 0 := by
            intro h0
            rw [h0, zero_pow (by omega : 2 ≠ 0)] at hδ
            exact mul_ne_zero hℓ_ne hu_ne hδ.symm
          have hℓ_lt_δ : ℓ < δ := by
            apply (pow_lt_pow_iff_left₀ zero_le zero_le (by omega : 2 ≠ 0)).mp
            rw [sq, hδ]
            exact (mul_lt_mul_iff_right₀ hℓ_pos).mpr hℓu
          have hδ_lt_u : δ < u := by
            apply (pow_lt_pow_iff_left₀ zero_le zero_le (by omega : 2 ≠ 0)).mp
            rw [hδ, sq]
            exact (mul_lt_mul_iff_left₀ hu_pos).mpr hℓu
          refine ⟨δ, hδ_ne, ?_, ?_⟩
          · intro τ hτ
            exact lt_of_le_of_lt (Finset.le_max' L τ hτ) hℓ_lt_δ
          · intro τ hτ
            exact lt_of_lt_of_le hδ_lt_u (Finset.min'_le U τ hτ)
        · 
          let ℓ := L.max' hL
          have hℓ_L : ℓ ∈ L := Finset.max'_mem L hL
          have hℓ_ne : ℓ ≠ 0 := hT_ne ℓ (Finset.mem_filter.mp hℓ_L).1
          have hℓ_pos : 0 < ℓ := zero_lt_iff.mpr hℓ_ne
          have hϖ_inv_gt_one : 1 < ϖ⁻¹ := (one_lt_inv₀ hϖ_pos).mpr hϖ_lt_one
          refine ⟨ℓ * ϖ⁻¹, mul_ne_zero hℓ_ne (inv_ne_zero hϖ_ne), ?_, ?_⟩
          · intro τ hτ
            calc
              τ ≤ ℓ := Finset.le_max' L τ hτ
              _ = ℓ * 1 := (mul_one ℓ).symm
              _ < ℓ * ϖ⁻¹ := (mul_lt_mul_iff_right₀ hℓ_pos).mpr hϖ_inv_gt_one
          · intro τ hτ
            exact False.elim (hU ⟨τ, hτ⟩)
      · by_cases hU : U.Nonempty
        · 
          let u := U.min' hU
          have hu_U : u ∈ U := Finset.min'_mem U hU
          have hu_ne : u ≠ 0 := hT_ne u (Finset.mem_filter.mp hu_U).1
          have hu_pos : 0 < u := zero_lt_iff.mpr hu_ne
          refine ⟨u * ϖ, mul_ne_zero hu_ne hϖ_ne, ?_, ?_⟩
          · intro τ hτ
            exact False.elim (hL ⟨τ, hτ⟩)
          · intro τ hτ
            calc
              u * ϖ < u * 1 := (mul_lt_mul_iff_right₀ hu_pos).mpr hϖ_lt_one
              _ = u := mul_one u
              _ ≤ τ := Finset.min'_le U τ hτ
        · 
          refine ⟨1, one_ne_zero, ?_, ?_⟩
          · intro τ hτ
            exact False.elim (hL ⟨τ, hτ⟩)
          · intro τ hτ
            exact False.elim (hU ⟨τ, hτ⟩)
    obtain ⟨r₀, hr₀_ne, hr₀_L, hr₀_U⟩ := hSep
    refine ⟨r₀, hr₀_ne, ?_⟩
    intro ν
    have hθ_mem_T : ∀ i : Fin (k_num ν), θ ν i ≠ 0 → θ ν i ∈ T_all := by
      intro i hi
      refine Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_union_left _ ?_, hi⟩)
      exact Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, Finset.mem_image_of_mem _ (Finset.mem_univ i)⟩
    have hη_mem_T : ∀ j : Fin (k_den ν), η ν j ≠ 0 → η ν j ∈ T_all := by
      intro j hj
      refine Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_union_right _ ?_, hj⟩)
      exact Finset.mem_biUnion.mpr ⟨ν, Finset.mem_univ ν, Finset.mem_image_of_mem _ (Finset.mem_univ j)⟩
    have hProd_r_num : (∏ i : Fin (k_num ν), max r₀ (θ ν i)) = r₀ ^ A ν * P_num ν := by
      rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
        (fun i : Fin (k_num ν) => ι (θ ν i) < γ)]
      congr 1
      · calc
          (∏ i ∈ I_lt ν, max r₀ (θ ν i))
            = ∏ _i ∈ I_lt ν, r₀ := by
              refine Finset.prod_congr rfl fun i hi => max_eq_left ?_
              by_cases h0 : θ ν i = 0
              · rw [h0]
                exact zero_le
              · exact le_of_lt (hr₀_L (θ ν i)
                  (Finset.mem_filter.mpr ⟨hθ_mem_T i h0, (Finset.mem_filter.mp hi).2⟩))
          _ = r₀ ^ A ν := Finset.prod_const r₀
      · refine Finset.prod_congr rfl fun i hi => max_eq_right ?_
        have hgt : γ < ι (θ ν i) := hNotLt (θ ν i) (Finset.mem_filter.mp hi).2
        have hne : θ ν i ≠ 0 := hθ_gt_ne ν i hi
        exact le_of_lt (hr₀_U (θ ν i) (Finset.mem_filter.mpr ⟨hθ_mem_T i hne, hgt⟩))
    have hProd_r_den : (∏ j : Fin (k_den ν), max r₀ (η ν j)) = r₀ ^ B ν * P_den ν := by
      rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ
        (fun j : Fin (k_den ν) => ι (η ν j) < γ)]
      congr 1
      · calc
          (∏ j ∈ J_lt ν, max r₀ (η ν j))
            = ∏ _j ∈ J_lt ν, r₀ := by
              refine Finset.prod_congr rfl fun j hj => max_eq_left ?_
              by_cases h0 : η ν j = 0
              · rw [h0]
                exact zero_le
              · exact le_of_lt (hr₀_L (η ν j)
                  (Finset.mem_filter.mpr ⟨hη_mem_T j h0, (Finset.mem_filter.mp hj).2⟩))
          _ = r₀ ^ B ν := Finset.prod_const r₀
      · refine Finset.prod_congr rfl fun j hj => max_eq_right ?_
        have hgt : γ < ι (η ν j) := hNotLt (η ν j) (Finset.mem_filter.mp hj).2
        have hne : η ν j ≠ 0 := hη_gt_ne ν j hj
        exact le_of_lt (hr₀_U (η ν j) (Finset.mem_filter.mpr ⟨hη_mem_T j hne, hgt⟩))
    rw [hProd_r_num, hProd_r_den]
    have hden_r_pos : 0 < r₀ ^ B ν * P_den ν :=
      zero_lt_iff.mpr (mul_ne_zero (pow_ne_zero (B ν) hr₀_ne) (hP_den_ne ν))
    rw [mul_inv_le_iff₀ hden_r_pos, one_mul]
    suffices h_mon_r : C_num ν * r₀ ^ A ν ≤ C_den ν * r₀ ^ B ν by
      calc
        c ν * (r₀ ^ A ν * P_num ν)
          = C_num ν * r₀ ^ A ν := by
            dsimp [C_num]
            ac_rfl
        _ ≤ C_den ν * r₀ ^ B ν := h_mon_r
        _ = r₀ ^ B ν * P_den ν := mul_comm _ _
    rcases lt_trichotomy (B ν) (A ν) with hBA | hEqAB | hAB
    · 
      obtain ⟨hpow, _, hgt⟩ := hρ_BA ν hBA
      have hρ_T : ρ ν ∈ T_all :=
        Finset.mem_union_right _ (Finset.mem_image.mpr
          ⟨ν, Finset.mem_filter.mpr ⟨Finset.mem_univ ν, by omega⟩, rfl⟩)
      have hr_le_ρ : r₀ ≤ ρ ν := le_of_lt (hr₀_U (ρ ν) (Finset.mem_filter.mpr ⟨hρ_T, hgt⟩))
      have hpow_le : r₀ ^ (A ν - B ν) ≤ C_den ν * (C_num ν)⁻¹ := by
        rw [← hpow]
        exact pow_le_pow_left' hr_le_ρ (A ν - B ν)
      have hCnum_pos : 0 < C_num ν := zero_lt_iff.mpr (hC_num_ne ν)
      have h1 : C_num ν * r₀ ^ (A ν - B ν) ≤ C_den ν := by
        rw [mul_comm]
        exact (le_mul_inv_iff₀ hCnum_pos).mp hpow_le
      have hA_eq : A ν = (A ν - B ν) + B ν := (Nat.sub_add_cancel (le_of_lt hBA)).symm
      rw [hA_eq, pow_add, ← mul_assoc]
      exact mul_le_mul' h1 le_rfl
    · 
      have hw := hW_mon ν
      rw [hEqAB] at hw ⊢
      have hA_pos : 0 < γ ^ A ν := zero_lt_iff.mpr (pow_ne_zero (A ν) hγ)
      have hι_le : ι (C_num ν) ≤ ι (C_den ν) :=
        le_of_not_gt fun hgt => not_lt_of_ge hw ((mul_lt_mul_iff_left₀ hA_pos).mpr hgt)
      exact mul_le_mul' (hι.le_iff_le.mp hι_le) le_rfl
    · 
      obtain ⟨hpow, _, hlt⟩ := hρ_AB ν hAB
      have hρ_T : ρ ν ∈ T_all :=
        Finset.mem_union_right _ (Finset.mem_image.mpr
          ⟨ν, Finset.mem_filter.mpr ⟨Finset.mem_univ ν, by omega⟩, rfl⟩)
      have hρ_le_r : ρ ν ≤ r₀ := le_of_lt (hr₀_L (ρ ν) (Finset.mem_filter.mpr ⟨hρ_T, hlt⟩))
      have hpow_le : C_num ν * (C_den ν)⁻¹ ≤ r₀ ^ (B ν - A ν) := by
        rw [← hpow]
        exact pow_le_pow_left' hρ_le_r (B ν - A ν)
      have hCden_pos : 0 < C_den ν := zero_lt_iff.mpr (hC_den_ne ν)
      have h1 : C_num ν ≤ C_den ν * r₀ ^ (B ν - A ν) := by
        rw [mul_comm (C_den ν)]
        exact (mul_inv_le_iff₀ hCden_pos).mp hpow_le
      have hB_eq : B ν = (B ν - A ν) + A ν := (Nat.sub_add_cancel (le_of_lt hAB)).symm
      rw [hB_eq, pow_add, ← mul_assoc]
      exact mul_le_mul' h1 le_rfl

theorem weil_divisible_orderedGroup_monomial_ray_no_partition (Γ₀ : Type u) [LinearOrderedCommGroupWithZero Γ₀]
    (hDiv : ∀ (γ : Γ₀) (n : ℕ), 1 ≤ n → ∃ δ : Γ₀, δ ^ n = γ)
    (r₀ r₁ : Γ₀)
    (hr₀ : r₀ ≠ 0)
    (hr₀₁ : r₀ ≤ r₁)
    (p q : ℕ)
    (m₁ : Fin (p + 1) → ℕ)
    (c₁ : ∀ μ : Fin (p + 1), Fin (m₁ μ) → Γ₀)
    (k₁_num k₁_den : ∀ μ : Fin (p + 1), Fin (m₁ μ) → ℕ)
    (θ₁ : ∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)), Fin (k₁_num μ j) → Γ₀)
    (η₁ : ∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)), Fin (k₁_den μ j) → Γ₀)
    (m₂ : Fin (q + 1) → ℕ)
    (c₂ : ∀ ν : Fin (q + 1), Fin (m₂ ν) → Γ₀)
    (k₂_num k₂_den : ∀ ν : Fin (q + 1), Fin (m₂ ν) → ℕ)
    (θ₂ : ∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)), Fin (k₂_num ν j) → Γ₀)
    (η₂ : ∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)), Fin (k₂_den ν j) → Γ₀)
    (hc₁ : ∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)), c₁ μ j ≠ 0)
    (hc₂ : ∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)), c₂ ν j ≠ 0)
    (hPart : ∀ r : Γ₀, r₀ ≤ r → r ≤ r₁ →
      let P₁ : Prop := ∃ μ : Fin (p + 1), ∀ j : Fin (m₁ μ),
        c₁ μ j * (∏ i : Fin (k₁_num μ j), max r (θ₁ μ j i)) *
          (∏ i : Fin (k₁_den μ j), max r (η₁ μ j i))⁻¹ ≤ 1
