        have hS₀_pre : IsPreirreducible S₀ := by
          intro U₁ U₂ hU₁ hU₂ ⟨z₁, hz₁S, hz₁U⟩ ⟨z₂, hz₂S, hz₂U⟩
          obtain ⟨V₁, hV₁, rfl⟩ := isOpen_induced_iff.mp hU₁
          obtain ⟨V₂, hV₂, rfl⟩ := isOpen_induced_iff.mp hU₂
          obtain ⟨w, hwS, hwV₁, hwV₂⟩ :=
            hS_irred.isPreirreducible V₁ V₂ hV₁ hV₂ ⟨z₁.1, hz₁S, hz₁U⟩ ⟨z₂.1, hz₂S, hz₂U⟩
