      rw [this, hx_mul, zero_mul, Ideal.mem_bot]
    have hKrullBranch : ∀ (i j : Fin 2), i ≠ j → ∀ z : R_loc,
        z ∉ Ideal.span {x i} → ∃ (v : R_loc) (k : ℕ), v * z - x j ^ k ∈ Ideal.span {x i} := by
      intro i j hij z hz_not
      have hNeTop_i : Ideal.span {x i} ≠ (⊤ : Ideal R_loc) := by
        intro htop
        have hle : Ideal.span {x i} ≤ IsLocalRing.maximalIdeal R_loc := by
          rw [Ideal.span_singleton_le_iff_mem]
          exact hx_mem i
        have h1 : (1 : R_loc) ∈ IsLocalRing.maximalIdeal R_loc := hle (htop ▸ Submodule.mem_top)
        exact (IsLocalRing.maximalIdeal.isMaximal R_loc).ne_top
          (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
      let B_i := R_loc ⧸ Ideal.span {x i}
      let π_i : R_loc →+* B_i := Ideal.Quotient.mk (Ideal.span {x i})
      have : Nontrivial B_i :=
        ⟨⟨0, 1, fun h01 => hNeTop_i ((Ideal.eq_top_iff_one _).mpr
          (Ideal.Quotient.eq_zero_iff_mem.mp h01.symm))⟩⟩
      have : IsLocalRing B_i := IsLocalRing.of_surjective' π_i Ideal.Quotient.mk_surjective
      have : IsNoetherianRing B_i := Ideal.Quotient.isNoetherianRing _
      let xj_bar : B_i := π_i (x j)
      have hMax_Bi : IsLocalRing.maximalIdeal B_i = Ideal.span {xj_bar} := by
        apply le_antisymm
        · intro w hw
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective w
          have hr_max : r ∈ IsLocalRing.maximalIdeal R_loc := by
            by_contra hr_not
            have hu : IsUnit (π_i r) := (IsLocalRing.notMem_maximalIdeal.mp hr_not).map π_i
            exact IsLocalRing.notMem_maximalIdeal.mpr hu hw
          rw [hMax_Rloc, Ideal.mem_span_pair] at hr_max
          rcases hr_max with ⟨c₀, c₁, rfl⟩
          change π_i (c₀ * x 0 + c₁ * x 1) ∈ Ideal.span {xj_bar}
          rw [map_add, map_mul, map_mul]
          fin_cases i <;> fin_cases j
          · exact absurd rfl hij
          · have h0 : π_i (x 0) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            rw [h0, mul_zero, zero_add]
            exact Ideal.mem_span_singleton.mpr ⟨π_i c₁, mul_comm _ _⟩
          · have h1 : π_i (x 1) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
            rw [h1, mul_zero, add_zero]
            exact Ideal.mem_span_singleton.mpr ⟨π_i c₀, mul_comm _ _⟩
          · exact absurd rfl hij
        · rw [Ideal.span_singleton_le_iff_mem]
          by_contra h_not
          have hu_bar : IsUnit xj_bar := IsLocalRing.notMem_maximalIdeal.mp h_not
          obtain ⟨v_bar, hv_bar⟩ := hu_bar.exists_left_inv
          obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective v_bar
          have h1_diff : v * x j - 1 ∈ Ideal.span {x i} :=
            Ideal.Quotient.eq_zero_iff_mem.mp (by simpa [xj_bar, map_sub, map_mul] using sub_eq_zero.mpr hv_bar)
          rw [Ideal.mem_span_singleton] at h1_diff
          rcases h1_diff with ⟨c, hc⟩
          have h1_max : (1 : R_loc) ∈ IsLocalRing.maximalIdeal R_loc := by
            have h_eq1 : (1 : R_loc) = v * x j - x i * c := by linear_combination -hc
            rw [h_eq1]
            exact sub_mem (Ideal.mul_mem_left _ _ (hx_mem j)) (Ideal.mul_mem_right _ _ (hx_mem i))
          exact (IsLocalRing.maximalIdeal.isMaximal R_loc).ne_top
            (Ideal.eq_top_of_isUnit_mem _ h1_max isUnit_one)
      have hz_bar_ne : π_i z ≠ 0 := fun h0 => hz_not (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      have hExPow : ∃ k : ℕ, π_i z ∉ (IsLocalRing.maximalIdeal B_i) ^ (k + 1) := by
        by_contra hAll
        have hAll' : ∀ k : ℕ, π_i z ∈ (IsLocalRing.maximalIdeal B_i) ^ (k + 1) := fun k =>
          Classical.not_not.mp fun hk => hAll ⟨k, hk⟩
        have h_iInf : π_i z ∈ ⨅ n_pow : ℕ, (IsLocalRing.maximalIdeal B_i) ^ n_pow := by
          rw [Ideal.mem_iInf]
          intro n_pow
          cases n_pow with
          | zero => simp
          | succ k => exact hAll' k
        rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal B_i).ne_top,
          Ideal.mem_bot] at h_iInf
        exact hz_bar_ne h_iInf
      let k := Nat.find hExPow
      have hk_not : π_i z ∉ (IsLocalRing.maximalIdeal B_i) ^ (k + 1) := Nat.find_spec hExPow
      have hk_mem : π_i z ∈ (IsLocalRing.maximalIdeal B_i) ^ k := by
        cases h_eq : k with
        | zero => simp
        | succ m_pred =>
          have hm_lt : m_pred < k := by omega
          exact Classical.not_not.mp (Nat.find_min hExPow hm_lt)
      rw [hMax_Bi, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hk_mem
      rcases hk_mem with ⟨u_bar, hu_eq⟩
      have hu_not_max : u_bar ∉ IsLocalRing.maximalIdeal B_i := by
        intro hu_in
        rw [hMax_Bi, Ideal.mem_span_singleton] at hu_in
        rcases hu_in with ⟨w_bar, rfl⟩
        apply hk_not
        rw [hMax_Bi, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        exact ⟨w_bar, by rw [hu_eq]; ring⟩
      have hu_unit : IsUnit u_bar := IsLocalRing.notMem_maximalIdeal.mp hu_not_max
      obtain ⟨v_bar, hv_bar⟩ := hu_unit.exists_left_inv
      obtain ⟨v, rfl⟩ := Ideal.Quotient.mk_surjective v_bar
      refine ⟨v, k, Ideal.Quotient.eq_zero_iff_mem.mp ?_⟩
      calc
        π_i (v * z - x j ^ k) = π_i v * π_i z - xj_bar ^ k := by simp [xj_bar, map_sub, map_mul, map_pow]
        _ = π_i v * (xj_bar ^ k * u_bar) - xj_bar ^ k := by rw [hu_eq]
        _ = (π_i v * u_bar) * xj_bar ^ k - xj_bar ^ k := by ring
        _ = 0 := by rw [hv_bar, one_mul, sub_self]
    have hRad_mem_x : ∀ I : Ideal R_loc, I ≠ ⊥ → I.IsRadical → x 0 ∈ I ∨ x 1 ∈ I := by
      intro I hI_ne hI_rad
      obtain ⟨z, hzI, hz0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI_ne
      by_cases hz_x1 : z ∈ Ideal.span {x 1}
      · have hz_not_x0 : z ∉ Ideal.span {x 0} := by
          intro hz_x0
          have : z ∈ Ideal.span {x 0} ⊓ Ideal.span {x 1} := ⟨hz_x0, hz_x1⟩
          rw [hSpan_inf, Ideal.mem_bot] at this
          exact hz0 this
        obtain ⟨v, k, hvk⟩ := hKrullBranch 0 1 (by decide) z hz_not_x0
        rw [Ideal.mem_span_singleton] at hvk
        rcases hvk with ⟨c, hc⟩
        have hx1_pow : x 1 ^ (k + 1) = (x 1 * v) * z := by
          have hmul : x 1 * (v * z - x 1 ^ k) = c * (x 0 * x 1) := by linear_combination x 1 * hc
          rw [hx_mul, mul_zero] at hmul
          linear_combination -hmul
        right
        exact hI_rad ⟨k + 1, hx1_pow ▸ Ideal.mul_mem_left I (x 1 * v) hzI⟩
      · obtain ⟨v, k, hvk⟩ := hKrullBranch 1 0 (by decide) z hz_x1
        rw [Ideal.mem_span_singleton] at hvk
        rcases hvk with ⟨c, hc⟩
        have hx0_pow : x 0 ^ (k + 1) = (x 0 * v) * z := by
          have hmul : x 0 * (v * z - x 0 ^ k) = c * (x 0 * x 1) := by linear_combination x 0 * hc
          rw [hx_mul, mul_zero] at hmul
          linear_combination -hmul
        left
        exact hI_rad ⟨k + 1, hx0_pow ▸ Ideal.mul_mem_left I (x 0 * v) hzI⟩
    have hx_sq_ne : ∀ i : Fin 2, x i ^ 2 ≠ 0 := by
      intro i hsq
      let j : Fin 2 := 1 - i
      have hij : j ≠ i := by fin_cases i <;> decide
      have h1_not : (1 : R_loc) ∉ Ideal.span {x j} := by
        intro h1
        have hle : Ideal.span {x j} ≤ IsLocalRing.maximalIdeal R_loc := by
          rw [Ideal.span_singleton_le_iff_mem]
          exact hx_mem j
        have h1_max : (1 : R_loc) ∈ IsLocalRing.maximalIdeal R_loc := hle h1
        exact (IsLocalRing.maximalIdeal.isMaximal R_loc).ne_top
          (Ideal.eq_top_of_isUnit_mem _ h1_max isUnit_one)
      have hxi_not : x i ∉ Ideal.span {x j} := fun h_in =>
        h1_not (hReg j i hij 1 (by simpa using h_in))
      have hsq_in : x i * x i ∈ Ideal.span {x j} := by
        have : x i * x i = x i ^ 2 := (sq (x i)).symm
        rw [this, hsq]
        exact Ideal.zero_mem _
      exact hxi_not (hReg j i hij (x i) hsq_in)
    let L_Y := Localization.AtPrime M_star
    let ψ₁_loc : L_Y →+* R_loc := Localization.localRingHom M_star n₀.asIdeal ψ₁ hcomap.symm
    letI : Algebra L_Y R_loc := ψ₁_loc.toAlgebra
    have : IsLocalHom (algebraMap L_Y R_loc) :=
      Localization.isLocalHom_localRingHom M_star n₀.asIdeal ψ₁ hcomap.symm
    have hφ₁_eq : ∀ r : R₁, φ₁ r = ψ₁_loc (algebraMap R₁ L_Y r) := fun r =>
      (Localization.localRingHom_to_map M_star n₀.asIdeal ψ₁ hcomap.symm r).symm
    have : Module.Flat L_Y R_loc := by
      letI : Algebra R₁ D := ψ₁.toAlgebra
      have : Algebra.Etale R₁ D := RingHom.etale_algebraMap.mp hEt₁
      have : Module.Flat R₁ D := inferInstance
      have : Module.Flat D R_loc := IsLocalization.flat R_loc n₀.asIdeal.primeCompl
      have : Module.Flat R₁ R_loc := Module.Flat.trans R₁ D R_loc
      have : IsScalarTower R₁ L_Y R_loc :=
        ⟨fun a b c => by
          rw [Algebra.smul_def (R := R₁) (A := L_Y), Algebra.smul_def (R := L_Y) (A := R_loc),
