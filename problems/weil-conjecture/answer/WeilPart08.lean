      have _ : AlgebraicGeometry.Etale e₂ := hEt₂
      have hEt_from₂ : AlgebraicGeometry.Etale (hAff'.fromSpec ≫ e₂) := inferInstance
      let φ₂ : A_nod →+* C' := (AlgebraicGeometry.Spec.preimage (hAff'.fromSpec ≫ e₂)).hom
