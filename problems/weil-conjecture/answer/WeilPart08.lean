          ∃ W ∈ irreducibleComponents ↥Y,
            y ∈ W ∧ W ⊆ i_Y.base ⁻¹' closure (j_P.base '' E) := by
    clear * -
    intro R _ _ _ _ k₀ _ ρ₀ hKer₀ C_R X_P Y g_R hProp_R j_P hRange_P i_Y hCl_Y hRange_Y E hE
    let E_tilde : Set C_R := closure (j_P.base '' E)
    let F_E : Set ↥Y := i_Y.base ⁻¹' E_tilde
    have _ : AlgebraicGeometry.IsProper g_R := hProp_R
    have _ : AlgebraicGeometry.IsClosedImmersion i_Y := hCl_Y
    refine ⟨?_, ?_⟩
    · obtain ⟨z₀, hz₀⟩ := hE.1.nonempty
      have hjz₀_mem : j_P.base z₀ ∈ E_tilde := subset_closure ⟨z₀, hz₀, rfl⟩
      let η_pt : AlgebraicGeometry.Spec (CommRingCat.of R) := g_R.base (j_P.base z₀)
      have hη_bot : η_pt.asIdeal = ⊥ := by
        have hmem : j_P.base z₀ ∈ Set.range j_P.base := ⟨z₀, rfl⟩
        rw [hRange_P] at hmem
        exact hmem
      have hS_closed : IsClosed (g_R.base '' E_tilde) :=
        g_R.isClosedMap E_tilde isClosed_closure
      let m_pt : AlgebraicGeometry.Spec (CommRingCat.of R) :=
        ⟨IsLocalRing.maximalIdeal R, (IsLocalRing.maximalIdeal.isMaximal R).isPrime⟩
      have hm_cl : m_pt ∈ closure ({η_pt} : Set (AlgebraicGeometry.Spec (CommRingCat.of R))) :=
        (PrimeSpectrum.le_iff_mem_closure η_pt m_pt).mp
          (by change η_pt.asIdeal ≤ m_pt.asIdeal; rw [hη_bot]; exact bot_le)
      have hm_img : m_pt ∈ g_R.base '' E_tilde :=
        (hS_closed.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr ⟨j_P.base z₀, hjz₀_mem, rfl⟩))
          hm_cl
      obtain ⟨x_m, hx_m_E, hx_m_g⟩ := hm_img
      have hx_m_rangeY : x_m ∈ Set.range i_Y.base := by
        rw [hRange_Y]
        change (g_R.base x_m).asIdeal = IsLocalRing.maximalIdeal R
        rw [hx_m_g]
      obtain ⟨y₀, hy₀_eq⟩ := hx_m_rangeY
      exact ⟨y₀, by change i_Y.base y₀ ∈ E_tilde; rwa [hy₀_eq]⟩
    · intro y hy B _ φ_R u_B ψ_R hFin_B hOpen_ψ hψ_g hy_range hInj
      have _ : AlgebraicGeometry.IsOpenImmersion ψ_R := hOpen_ψ
      have hFE_closed : IsClosed F_E := isClosed_closure.preimage i_Y.continuous
      let y_sub : ↥F_E := ⟨y, hy⟩
      let T₀ : Set ↥F_E := irreducibleComponent y_sub
      have hT₀_comp : T₀ ∈ irreducibleComponents ↥F_E :=
        irreducibleComponent_mem_irreducibleComponents y_sub
      have hy_T₀ : y_sub ∈ T₀ := mem_irreducibleComponent
      have hT₀_closed : IsClosed T₀ := isClosed_of_mem_irreducibleComponents T₀ hT₀_comp
      let T : Set ↥Y := Subtype.val '' T₀
      have hy_T : y ∈ T := ⟨y_sub, hy_T₀, rfl⟩
      have hT_sub_FE : T ⊆ F_E := by
        rintro _ ⟨z, _, rfl⟩
        exact z.2
