      let B_q := Localization.AtPrime q'₀.asIdeal
      haveI : Algebra.EssFiniteType A_Z B'_Z := Algebra.EssFiniteType.of_finiteType A_Z B'_Z
      haveI : Algebra.EssFiniteType B'_Z B_q :=
        Algebra.EssFiniteType.of_isLocalization B_q q'₀.asIdeal.primeCompl
