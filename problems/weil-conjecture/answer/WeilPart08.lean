        (Φ₀ (Polynomial.X ^ (i : ℕ)))
    let n₁ : ↑(X.presheaf.obj (Opposite.op U₁_E)) :=
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U₁_E ≤ V₁)).op).hom
        (Φ₁ (Polynomial.X ^ (d - (i : ℕ))))
    let s₀ : ↑(X.presheaf.obj (Opposite.op U₀_E)) := n₀ * ↑(hd₀.unit⁻¹)
    let s₁ : ↑(X.presheaf.obj (Opposite.op U₁_E)) := n₁ * ↑(hd₁.unit⁻¹)
    have hs₀_mul : s₀ * d₀ = n₀ := by
      dsimp only [s₀]
      rw [mul_assoc, hd₀.val_inv_mul, mul_one]
    have hs₁_mul : s₁ * d₁ = n₁ := by
      dsimp only [s₁]
      rw [mul_assoc, hd₁.val_inv_mul, mul_one]
    let W₀₁ : X.Opens := U₀_E ⊓ U₁_E
    let resL := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W₀₁ ≤ U₀_E)).op).hom
