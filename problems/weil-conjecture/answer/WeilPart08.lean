    have hPb_W' : CategoryTheory.IsPullback
        ((π ∣_ W_y) ≫ isoW.hom) (W'_y.ι ≫ p')
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιB₀)) u_ψ :=
      hPb_W.of_iso (CategoryTheory.Iso.refl _) isoW
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by simp) (by simp) (by simpa using hisoComm.symm) (by simp)
    let isoW' : W'_y.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of B') :=
      CategoryTheory.IsPullback.isoIsPullback _ _ hPb_W' hPb_B
    have hisoW'_fst : isoW'.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B) =
        (π ∣_ W_y) ≫ isoW.hom :=
      CategoryTheory.IsPullback.isoIsPullback_hom_fst _ _ hPb_W' hPb_B
    have hisoW'_snd : isoW'.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ιB') =
        W'_y.ι ≫ p' :=
      CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_W' hPb_B
    refine ⟨W'_y, hy, A'_K, ιK', ev'₁, ev'₂, hev'₁, hev'₂, hNeKer',
      ⟨V'₁, hp'₁, hSm'₁⟩, ⟨V'₂, hp'₂, hSm'₂⟩, hK', isoW', hisoW'_snd, ?_⟩
    let q_y : Ideal B' := (isoW'.hom.base ⟨y, hy⟩).asIdeal
    let ε' : B' →+* K' := ev'₁.hom.comp S'.subtype
    have hπW_y : (π ∣_ W_y).base ⟨y, hy⟩ = ⟨y₀, hy₀⟩ := by
      apply W_y.ι.isOpenEmbedding.injective
      have h1 := congrArg (fun h => h.base ⟨y, hy⟩)
        (AlgebraicGeometry.morphismRestrict_ι π W_y)
      exact h1
    have hψB_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)).base
        (isoW'.hom.base ⟨y, hy⟩) = isoW.hom.base ⟨y₀, hy₀⟩ := by
      have h1 := congrArg (fun h => h.base ⟨y, hy⟩) hisoW'_fst
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)).base
          (isoW'.hom.base ⟨y, hy⟩) = isoW.hom.base ((π ∣_ W_y).base ⟨y, hy⟩) at h1
      rwa [hπW_y] at h1
    have hψB_ker_sub : ∀ b : B₀, ev₁.hom b.1 = 0 → ψ_B b ∈ q_y := by
      intro b hb
      have hmem₀ : b ∈ (isoW.hom.base ⟨y₀, hy₀⟩).asIdeal := by
        rw [hisoPt]
        exact hb
      rw [← hψB_pt] at hmem₀
      exact hmem₀
    have hΘ_decomp : ∀ z : TensorProduct k₁ B₀ K',
        Θ z - ιB' (ε' (Θ z)) ∈ q_y := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul b c =>
        let r : k₁ := ev₁.hom b.1
        let b' : B₀ := b - ιB₀ r
        have hb'_ker : ev₁.hom b'.1 = 0 := by
          change ev₁.hom (b.1 - ιK.hom r) = 0
          rw [map_sub, hev₁_c r, sub_self]
        have hψb'_mem : ψ_B b' ∈ q_y := hψB_ker_sub b' hb'_ker
        have hΘ_bc : Θ (b ⊗ₜ[k₁] c) = ψ_B b * ιB' c :=
          Algebra.TensorProduct.lift_tmul ψ_B_alg ιB'_alg (fun _ _ => mul_comm _ _) b c
        have hε_ψb : ε' (ψ_B b) = ψ r := by
          change ev'₁.hom (b.1 ⊗ₜ[k₁] 1) = ψ r
          rw [hev'₁_tmul, mul_one]
        have hε_ιc : ε' (ιB' c) = c := by
          change (ιK' ≫ ev'₁).hom c = c
          rw [hev'₁]
          rfl
        have h_eq : Θ (b ⊗ₜ[k₁] c) - ιB' (ε' (Θ (b ⊗ₜ[k₁] c))) = ψ_B b' * ιB' c := by
          rw [hΘ_bc, map_mul ε', hε_ψb, hε_ιc, map_mul ιB', ← hψ_B_ι r]
          dsimp only [b']
          rw [map_sub ψ_B, sub_mul]
        rw [h_eq]
        exact q_y.mul_mem_right (ιB' c) hψb'_mem
      | add z₁ z₂ h₁ h₂ =>
        have h_add : Θ (z₁ + z₂) - ιB' (ε' (Θ (z₁ + z₂))) =
            (Θ z₁ - ιB' (ε' (Θ z₁))) + (Θ z₂ - ιB' (ε' (Θ z₂))) := by
          simp only [map_add]
          ring
        rw [h_add]
        exact q_y.add_mem h₁ h₂
    have hker_le : RingHom.ker ε' ≤ q_y := by
      intro x hx
      obtain ⟨z, rfl⟩ := hΘ_surj x
      have hx0 : ε' (Θ z) = 0 := hx
      have hmem := hΘ_decomp z
      rwa [hx0, map_zero, sub_zero] at hmem
    have hε'_surj : Function.Surjective ε' := by
      intro c
      refine ⟨ιB' c, ?_⟩
      change (ιK' ≫ ev'₁).hom c = c
      rw [hev'₁]
      rfl
    have hmax : (RingHom.ker ε').IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ε' hε'_surj
    exact (hmax.eq_of_le (isoW'.hom.base ⟨y, hy⟩).isPrime.ne_top hker_le).symm

theorem weil_sup1_proj_curve_no_contained_comp_chart_iso (K : Type u) [Field K]
    (V : ValuationSubring K)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀)
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (hProjMap : IsUnstableP1ContractionProjMap V g Z V₀ V₁ eZ N' φ)
    (K' : Type u) [Field K'] [IsAlgClosed K']
    (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (q_s : CategoryTheory.Limits.pullback g s ⟶
      CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) s)
    (hq_fst : q_s ≫
        CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) s =
      CategoryTheory.Limits.pullback.fst g s ≫ AlgebraicGeometry.Scheme.Hom.toImage φ)
    (hq_snd : q_s ≫
        CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) s =
      CategoryTheory.Limits.pullback.snd g s) :
    let X_s := CategoryTheory.Limits.pullback g s
    let X_next_s := CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) s
    let W₀_s : X_s.Opens :=
      (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s).base).obj
        (V₁ ⊔ C.basicOpen eZ)
    ((∀ E ∈ irreducibleComponents ↥X_s, ¬ (E ⊆ (W₀_s : Set ↥X_s))) →
      CategoryTheory.IsIso q_s) ∧
    (∀ E_star ∈ irreducibleComponents ↥X_s,
      E_star ⊆ (W₀_s : Set ↥X_s) →
      (∀ E' ∈ (irreducibleComponents ↥X_s) \ {E_star}, ¬ (E' ⊆ (W₀_s : Set ↥X_s))) →
      ∃ (U₀_s U₁_star : X_next_s.Opens),
        AlgebraicGeometry.IsAffineOpen U₀_s ∧
        U₀_s ⊔ U₁_star = ⊤ ∧
        (TopologicalSpace.Opens.map q_s.base).obj U₀_s = W₀_s ∧
        (∃ heq₀ : W₀_s ≤ (TopologicalSpace.Opens.map q_s.base).obj U₀_s,
          Function.Bijective (q_s.appLE U₀_s W₀_s heq₀).hom) ∧
        Disjoint E_star
          (((TopologicalSpace.Opens.map q_s.base).obj U₁_star : X_s.Opens) : Set ↥X_s) ∧
        CategoryTheory.IsIso (q_s ∣_ U₁_star)) :=
by
  classical
  intro X_s X_next_s W₀_s
  let g_next := AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom
  let fst_s := CategoryTheory.Limits.pullback.fst g s
  let snd_s := CategoryTheory.Limits.pullback.snd g s
  let fst_next_s := CategoryTheory.Limits.pullback.fst g_next s
  let snd_next_s := CategoryTheory.Limits.pullback.snd g_next s
  let W_compl : C.Opens := V₁ ⊔ C.basicOpen eZ

  
  have helper_integral_subscheme :
      ∀ (X : AlgebraicGeometry.Scheme.{u}) (E : Set ↥X),
        E ∈ irreducibleComponents ↥X →
        ∃ (E_sch : AlgebraicGeometry.Scheme.{u}) (ι_E : E_sch ⟶ X),
          AlgebraicGeometry.IsClosedImmersion ι_E ∧
          AlgebraicGeometry.IsIntegral E_sch ∧
          Set.range ι_E.base = E := by
    intro X E hE
    have hClE : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    let Z_E : TopologicalSpace.Closeds ↥X := ⟨E, hClE⟩
    let I_E : X.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z_E
    let E_sch : AlgebraicGeometry.Scheme.{u} := I_E.subscheme
    let ι_E : E_sch ⟶ X := I_E.subschemeι
    have hRange : Set.range ι_E.base = E := by
      change Set.range ⇑I_E.subschemeι = E
      rw [I_E.range_subschemeι, AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    have : ∀ (i : I_E.subschemeCover.openCover.I₀),
        AlgebraicGeometry.IsReduced (I_E.subschemeCover.openCover.X i) := by
      intro U
      let U' : X.affineOpens := U
      have hRad : (I_E.ideal U').IsRadical := by
        dsimp only [I_E]
        rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal Z_E U']
        exact PrimeSpectrum.isRadical_vanishingIdeal _
      have hRedQ : IsReduced (↑(X.presheaf.obj (Opposite.op U'.1)) ⧸ I_E.ideal U') :=
        (Ideal.isRadical_iff_quotient_reduced _).mp hRad
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op U'.1)) ⧸ I_E.ideal U')))
      exact (AlgebraicGeometry.affine_isReduced_iff _).mpr hRedQ
    have : AlgebraicGeometry.IsReduced E_sch :=
      AlgebraicGeometry.IsReduced.of_openCover E_sch I_E.subschemeCover.openCover
    have hEmb : Topology.IsClosedEmbedding ι_E.base := ι_E.isClosedEmbedding
    have : PreirreducibleSpace ↥E_sch := by
      refine ⟨fun O₁ O₂ hO₁ hO₂ ⟨z₁, hz₁⟩ ⟨z₂, hz₂⟩ => ?_⟩
      obtain ⟨V₁, hV₁_open, hV₁_eq⟩ := hEmb.isInducing.isOpen_iff.mp hO₁
      obtain ⟨V₂, hV₂_open, hV₂_eq⟩ := hEmb.isInducing.isOpen_iff.mp hO₂
      have hx₁ : ι_E.base z₁ ∈ E ∩ V₁ :=
        ⟨by rw [← hRange]; exact ⟨z₁, rfl⟩, by change z₁ ∈ ι_E.base ⁻¹' V₁; rw [hV₁_eq]; exact hz₁.2⟩
      have hx₂ : ι_E.base z₂ ∈ E ∩ V₂ :=
        ⟨by rw [← hRange]; exact ⟨z₂, rfl⟩, by change z₂ ∈ ι_E.base ⁻¹' V₂; rw [hV₂_eq]; exact hz₂.2⟩
      obtain ⟨x, hxE, hxV₁, hxV₂⟩ := hE.1.2 V₁ V₂ hV₁_open hV₂_open ⟨_, hx₁⟩ ⟨_, hx₂⟩
      rw [← hRange] at hxE
      obtain ⟨z, rfl⟩ := hxE
      exact ⟨z, trivial, by rw [← hV₁_eq]; exact hxV₁, by rw [← hV₂_eq]; exact hxV₂⟩
    obtain ⟨x₀, hx₀⟩ := hE.1.1
    rw [← hRange] at hx₀
    obtain ⟨z₀, -⟩ := hx₀
    have : IrreducibleSpace ↥E_sch := ⟨⟨z₀⟩⟩
    exact ⟨E_sch, ι_E, inferInstance,
      AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced E_sch, hRange⟩

  
  have helper_open_toSpecΓ_comm :
      ∀ (R : Type u) [CommRing R] (S_sch : AlgebraicGeometry.Scheme.{u})
        (f_sch : S_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) (U_op : S_sch.Opens),
        U_op.toSpecΓ ≫ AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE f_sch ⊤ U_op (fun _ _ => trivial)) =
          U_op.ι ≫ f_sch := by
    intro R _ S_sch f_sch U_op
    let hle_f : U_op ≤ f_sch ⁻¹ᵁ ⊤ := fun _ _ => trivial
    let α := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE f_sch ⊤ U_op hle_f
    let h₁ : U_op.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
      U_op.toSpecΓ ≫ AlgebraicGeometry.Spec.map α
    let h₂ : U_op.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) := U_op.ι ≫ f_sch
    change h₁ = h₂
    have happ : h₁.appTop = h₂.appTop := by
      rw [← CategoryTheory.Iso.cancel_iso_hom_right _ _ U_op.topIso]
      have h_lhs : h₁.appTop ≫ U_op.topIso.hom =
          AlgebraicGeometry.Scheme.Hom.appLE f_sch ⊤ U_op hle_f := by
        dsimp only [h₁]
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop,
          Category.assoc, Category.assoc,
          CategoryTheory.Iso.inv_hom_id, Category.comp_id,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality α]
        dsimp only [α]
        rw [CategoryTheory.Iso.hom_inv_id_assoc]
      have h_rhs : h₂.appTop ≫ U_op.topIso.hom =
          AlgebraicGeometry.Scheme.Hom.appLE f_sch ⊤ U_op hle_f := by
        dsimp only [h₂, AlgebraicGeometry.Scheme.Hom.appLE]
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, Category.assoc]
        congr 1
        have hι : U_op.ι.appTop = S_sch.presheaf.map
            (CategoryTheory.homOfLE (le_top : U_op.ι ''ᵁ ⊤ ≤ (⊤ : S_sch.Opens))).op :=
          AlgebraicGeometry.Scheme.Opens.ι_appTop U_op
        have htop : U_op.topIso.hom = S_sch.presheaf.map
            (CategoryTheory.eqToHom (by ext x; simp : U_op = U_op.ι ''ᵁ ⊤)).op :=
          AlgebraicGeometry.Scheme.Opens.topIso_hom U_op
        erw [hι, htop, ← S_sch.presheaf.map_comp]
        rfl
      rw [h_lhs, h_rhs]
    let e_adj := AlgebraicGeometry.ΓSpec.adjunction.homEquiv U_op.toScheme
      (Opposite.op (CommRingCat.of R))
    apply e_adj.symm.injective
    apply Quiver.Hom.unop_inj
    let φ₁ : CommRingCat.of R ⟶ U_op.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm h₁).unop
    let φ₂ : CommRingCat.of R ⟶ U_op.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm h₂).unop
    have e1 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₁
    have e2 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₂
    have hh₁ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U_op.toScheme
        (Opposite.op (CommRingCat.of R))) φ₁.op = h₁ := e_adj.apply_symm_apply h₁
    have hh₂ : (AlgebraicGeometry.ΓSpec.adjunction.homEquiv U_op.toScheme
        (Opposite.op (CommRingCat.of R))) φ₂.op = h₂ := e_adj.apply_symm_apply h₂
    rw [hh₁] at e1
    rw [hh₂] at e2
    change φ₁ = φ₂
    rw [← e1, ← e2, happ]

  
  have helper_proj_proper_and_baseChange :
      (∀ (R : Type u) [CommRing R] (N : ℕ),
        AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom) ∧
      (∀ (R S : Type u) [CommRing R] [CommRing S] (φ_RS : R →+* S) (N : ℕ),
        ∃ Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver R N).left,
          CategoryTheory.IsPullback Φ
            (weilProjectiveSpaceOver S N).hom
            (weilProjectiveSpaceOver R N).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS))) := by
    have hX_mem : ∀ (R : Type u) [CommRing R] (N : ℕ) (a : Fin (N + 1)),
        (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) R) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 1 :=
      fun R _ N a => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X R a)
    have halg0 : ∀ (R : Type u) [CommRing R] (N : ℕ) (r : R),
        (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0) r :
          MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r := by
      intro R _ N r
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      rw [Algebra.algebraMap_eq_smul_one]
      change r • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r
      rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hProperCover : ∀ (R : Type u) [CommRing R] (N : ℕ),
        let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
        letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
        AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom ∧
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) ∧
        (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)) = ⊤ := by
      intro R _ N
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      have hinj : Function.Injective (algebraMap R ↥(𝒜 0)) := by
        intro r₁ r₂ h
        have h1 : (algebraMap R ↥(𝒜 0) r₁ : MvPolynomial (Fin (N + 1)) R) =
            (algebraMap R ↥(𝒜 0) r₂ : MvPolynomial (Fin (N + 1)) R) := congrArg Subtype.val h
        rw [halg0 R N, halg0 R N] at h1
        simpa using congrArg MvPolynomial.constantCoeff h1
      have hsurj : Function.Surjective (algebraMap R ↥(𝒜 0)) := by
        intro p
        refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
        rw [halg0 R N]
        ext μ
        by_cases hμ : μ = 0
        · subst hμ; simp
        · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr (fun h => absurd h.symm hμ)]
          symm
          by_contra hne
          have hp : p.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
          have hdeg := hp hne
          simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
          have hne' : ∃ i : Fin (N + 1), μ i ≠ 0 := by
            by_contra hall
            exact hμ (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
          rcases hne' with ⟨i, hi⟩
          exact hi ((Finset.sum_eq_zero_iff.mp hdeg) i (Finsupp.mem_support_iff.mpr hi))
      have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) :=
        (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))).mpr
          ⟨hinj, hsurj⟩
      have _ : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) :=
        inferInstance
      let _ : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
        IsScalarTower.of_algebraMap_eq' (R := R) (S := ↥(𝒜 0))
          (A := MvPolynomial (Fin (N + 1)) R) (RingHom.ext fun r => by
            change algebraMap R (MvPolynomial (Fin (N + 1)) R) r =
              (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R)
            rw [halg0 R N, MvPolynomial.algebraMap_eq])
      have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
        Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
      have hProp : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom := by
        change AlgebraicGeometry.IsProper
          (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))))
        infer_instance
      have hIrrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) := by
        intro p hp
        have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
          (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
        have hp_sum : (∑ i ∈ (DirectSum.decompose 𝒜 p).support,
            (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R)) = p :=
          DirectSum.sum_support_decompose 𝒜 p
        have hcoeff0 : p.coeff 0 = 0 := by
          rw [← hp_sum, MvPolynomial.coeff_sum]
          apply Finset.sum_eq_zero
          intro i _
          by_cases hi : i = 0
          · subst hi
            have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin (N + 1)) R) = 0 := hp0_proj
            rw [h0]; simp
          · have hmem_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R) ∈ 𝒜 i :=
              (DirectSum.decompose 𝒜 p i).2
            have hhom_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R).IsHomogeneous i :=
              (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem_i
            by_contra hne0
            have hdeg0 := hhom_i hne0
            simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg0
            exact hi hdeg0.symm
        have hrange : (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) =
            MvPolynomial.X '' (Set.univ : Set (Fin (N + 1))) := Set.image_univ.symm
        rw [hrange, MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        have hm_ne : m ≠ 0 := by
          intro hm0
          subst hm0
          exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
        have hex : ∃ a : Fin (N + 1), m a ≠ 0 := by
          by_contra hall
          exact hm_ne (Finsupp.ext fun a => Classical.not_not.mp fun h => hall ⟨a, h⟩)
        rcases hex with ⟨a, ha⟩
        exact ⟨a, Set.mem_univ a, ha⟩
      have hCov : (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)) = ⊤ :=
