        (X_s.presheaf.map (CategoryTheory.homOfLE (X_s.basicOpen_le d₂)).op).hom
      letI : Algebra ↑(X_s.presheaf.obj (Opposite.op V₀_s))
          ↑(X_s.presheaf.obj (Opposite.op (X_s.basicOpen d₂))) := res_d₂.toAlgebra
      haveI hLoc_d₂ : IsLocalization.Away d₂
          ↑(X_s.presheaf.obj (Opposite.op (X_s.basicOpen d₂))) :=
        AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen hAff_V₀s d₂
      let sec₃ := IsLocalization.Away.sec d₂ α_d₂
      have hsec₃ : α_d₂ * res_d₂ (d₂ ^ sec₃.2) = res_d₂ sec₃.1 :=
        IsLocalization.Away.sec_spec d₂ α_d₂
      
      let p : ℕ := max sec₂.2 sec₃.2
      let r₀ : ℕ := max sec₁.2 p + 1
      have hr₀_pos : 1 ≤ r₀ := Nat.le_add_left 1 _
      have hr₁_le : sec₁.2 ≤ r₀ := (le_max_left _ _).trans (Nat.le_succ _)
      have hr₂_le_p : sec₂.2 ≤ p := le_max_left _ _
      have hr₃_le_p : sec₃.2 ≤ p := le_max_right _ _
      have hp_le_r₀ : p ≤ r₀ := (le_max_right _ _).trans (Nat.le_succ _)
      have hr₂_le_r₀ : sec₂.2 ≤ r₀ := hr₂_le_p.trans hp_le_r₀
      have hr₃_le_r₀ : sec₃.2 ≤ r₀ := hr₃_le_p.trans hp_le_r₀
      let a₁ : ↑(X_s.presheaf.obj (Opposite.op V₁_s)) := g_c ^ (r₀ - sec₁.2) * sec₁.1
      let a₂ : ↑(X_s.presheaf.obj (Opposite.op V₀_s)) :=
        (α₀ eZ) ^ (p - sec₂.2) * g'_Z ^ (r₀ - sec₂.2) * sec₂.1
      let a₃ : ↑(X_s.presheaf.obj (Opposite.op V₀_s)) :=
        (α₀ eY) ^ (p - sec₃.2) * ĝ_Y ^ (r₀ - sec₃.2) * sec₃.1
      have ha₁_eq : α_gc * res_gc (g_c ^ r₀) = res_gc a₁ := by
        have hsplit : g_c ^ r₀ = g_c ^ (r₀ - sec₁.2) * g_c ^ sec₁.2 := by
          rw [← pow_add, Nat.sub_add_cancel hr₁_le]
        calc
          α_gc * res_gc (g_c ^ r₀) = res_gc (g_c ^ (r₀ - sec₁.2)) * (α_gc * res_gc (g_c ^ sec₁.2)) := by
            rw [hsplit, map_mul]
            ring
          _ = res_gc a₁ := by rw [hsec₁, ← map_mul]
      have ha₂_eq : α_d₁ * res_d₁ ((α₀ eZ) ^ p * g'_Z ^ r₀) = res_d₁ a₂ := by
        have hsplit : (α₀ eZ) ^ p * g'_Z ^ r₀ =
            (α₀ eZ) ^ (p - sec₂.2) * g'_Z ^ (r₀ - sec₂.2) * d₁ ^ sec₂.2 := by
          have h1 : (α₀ eZ) ^ p = (α₀ eZ) ^ (p - sec₂.2) * (α₀ eZ) ^ sec₂.2 := by
            rw [← pow_add, Nat.sub_add_cancel hr₂_le_p]
          have h2 : g'_Z ^ r₀ = g'_Z ^ (r₀ - sec₂.2) * g'_Z ^ sec₂.2 := by
            rw [← pow_add, Nat.sub_add_cancel hr₂_le_r₀]
          dsimp [d₁]
          rw [h1, h2, mul_pow]
          ring
        calc
          α_d₁ * res_d₁ ((α₀ eZ) ^ p * g'_Z ^ r₀)
            = res_d₁ ((α₀ eZ) ^ (p - sec₂.2) * g'_Z ^ (r₀ - sec₂.2)) * (α_d₁ * res_d₁ (d₁ ^ sec₂.2)) := by
              rw [hsplit, map_mul]
              ring
          _ = res_d₁ a₂ := by rw [hsec₂, ← map_mul]
      have ha₃_eq : α_d₂ * res_d₂ ((α₀ eY) ^ p * ĝ_Y ^ r₀) = res_d₂ a₃ := by
        have hsplit : (α₀ eY) ^ p * ĝ_Y ^ r₀ =
            (α₀ eY) ^ (p - sec₃.2) * ĝ_Y ^ (r₀ - sec₃.2) * d₂ ^ sec₃.2 := by
          have h1 : (α₀ eY) ^ p = (α₀ eY) ^ (p - sec₃.2) * (α₀ eY) ^ sec₃.2 := by
            rw [← pow_add, Nat.sub_add_cancel hr₃_le_p]
          have h2 : ĝ_Y ^ r₀ = ĝ_Y ^ (r₀ - sec₃.2) * ĝ_Y ^ sec₃.2 := by
            rw [← pow_add, Nat.sub_add_cancel hr₃_le_r₀]
          dsimp [d₂]
          rw [h1, h2, mul_pow]
          ring
        calc
          α_d₂ * res_d₂ ((α₀ eY) ^ p * ĝ_Y ^ r₀)
            = res_d₂ ((α₀ eY) ^ (p - sec₃.2) * ĝ_Y ^ (r₀ - sec₃.2)) * (α_d₂ * res_d₂ (d₂ ^ sec₃.2)) := by
              rw [hsplit, map_mul]
              ring
          _ = res_d₂ a₃ := by rw [hsec₃, ← map_mul]
      
      let sec_b₀ := IsLocalization.Away.sec (α₀ h₀) (res₁_s a₁)
      have hsec_b₀ : res₁_s a₁ * res₀_s ((α₀ h₀) ^ sec_b₀.2) = res₀_s sec_b₀.1 :=
        IsLocalization.Away.sec_spec (α₀ h₀) (res₁_s a₁)
      let d₀ : ℕ := sec_b₀.2 + 1
      have hd₀_pos : 1 ≤ d₀ := Nat.le_add_left 1 _
      have hpb_le_dm : sec_b₀.2 ≤ d₀ * m₀ := by
        calc sec_b₀.2 ≤ d₀ := Nat.le_succ _
          _ = d₀ * 1 := (mul_one d₀).symm
          _ ≤ d₀ * m₀ := Nat.mul_le_mul_left d₀ hm₀
      let b₀ : ↑(X_s.presheaf.obj (Opposite.op V₀_s)) :=
        (α₀ h₀) ^ (d₀ * m₀ - sec_b₀.2) * sec_b₀.1
      have hb₀_eq : res₀_s ((α₀ h₀) ^ (d₀ * m₀)) * res₁_s a₁ = res₀_s b₀ := by
        have hsplit : (α₀ h₀) ^ (d₀ * m₀) =
            (α₀ h₀) ^ (d₀ * m₀ - sec_b₀.2) * (α₀ h₀) ^ sec_b₀.2 := by
          rw [← pow_add, Nat.sub_add_cancel hpb_le_dm]
        calc
          res₀_s ((α₀ h₀) ^ (d₀ * m₀)) * res₁_s a₁
            = res₀_s ((α₀ h₀) ^ (d₀ * m₀ - sec_b₀.2)) *
                (res₁_s a₁ * res₀_s ((α₀ h₀) ^ sec_b₀.2)) := by
              rw [hsplit, map_mul]
              ring
          _ = res₀_s b₀ := by rw [hsec_b₀, ← map_mul]
      
      have h_gY_gl : res₀_s ĝ_Y = res₀_s ((α₀ h₀) ^ m₀) * res₁_s g_c := by
        dsimp [ĝ_Y, g_c]
        have h1 : res₀_s (α₀ (f_Y 1)) = res₀_s ((α₀ h₀) ^ m₀) * res₁_s (α₁ (f 1)) := by
          have := congrArg α₀₁ (hfY_gl 1)
          have hl : (res₀_s.comp α₀) (f_Y 1) = (α₀₁.comp res₀.toRingHom) (f_Y 1) :=
            congrFun (congrArg DFunLike.coe hres₀_α) (f_Y 1)
          have hr1 : (res₀_s.comp α₀) (h₀ ^ m₀) = (α₀₁.comp res₀.toRingHom) (h₀ ^ m₀) :=
            congrFun (congrArg DFunLike.coe hres₀_α) (h₀ ^ m₀)
          have hr2 : (res₁_s.comp α₁) (f 1) = (α₀₁.comp res₁.toRingHom) (f 1) :=
            congrFun (congrArg DFunLike.coe hres₁_α) (f 1)
          simp only [RingHom.comp_apply] at hl hr1 hr2
          rw [map_mul, ← hl, ← hr1, ← hr2, map_pow] at this
          exact this
        have hc01 : res₀_s (c₀_s c₁) = res₁_s (c₁_s c₁) := by
          have h0 := congrFun (congrArg DFunLike.coe hres₀_c) c₁
          have h1' := congrFun (congrArg DFunLike.coe hres₁_c) c₁
          exact h0.trans h1'.symm
        rw [map_sub, map_sub, map_mul, h1, hc01]
        ring
      have h_gZ_gl : res₀_s g'_Z = res₀_s ((α₀ eZ) ^ m₀) * res₁_s g_c := by
        have hZ_mul : g'_Z * (α₀ h₀) ^ m₀ = (α₀ eZ) ^ m₀ * ĝ_Y := by
          dsimp [g'_Z, ĝ_Y]
          have h_ap := congrArg α₀ (hfZ_gl 1)
          simp only [map_mul, map_pow] at h_ap
          calc
            (α₀ (f_Z 1) - c₀_s c₁ * (α₀ eZ) ^ m₀) * (α₀ h₀) ^ m₀
              = α₀ (f_Z 1) * (α₀ h₀) ^ m₀ - c₀_s c₁ * (α₀ eZ) ^ m₀ * (α₀ h₀) ^ m₀ := by ring
            _ = (α₀ eZ) ^ m₀ * α₀ (f_Y 1) - c₀_s c₁ * (α₀ eZ) ^ m₀ * (α₀ h₀) ^ m₀ := by rw [h_ap]
            _ = (α₀ eZ) ^ m₀ * (α₀ (f_Y 1) - c₀_s c₁ * (α₀ h₀) ^ m₀) := by ring
        have h_inv_s : res₀_s (α₀ h₀) * res₁_s (α₁ t₀) = 1 := by
          have := congrArg α₀₁ hInv_ht
          have hl1 : res₀_s (α₀ h₀) = α₀₁ (res₀ h₀) :=
            congrFun (congrArg DFunLike.coe hres₀_α) h₀
          have hl2 : res₁_s (α₁ t₀) = α₀₁ (res₁ t₀) :=
            congrFun (congrArg DFunLike.coe hres₁_α) t₀
          rw [map_mul, map_one] at this
          rw [hl1, hl2]
          exact this
        have h_ap := congrArg res₀_s hZ_mul
        rw [map_mul, map_mul, h_gY_gl] at h_ap
        calc
          res₀_s g'_Z = res₀_s g'_Z * (res₀_s (α₀ h₀) * res₁_s (α₁ t₀)) ^ m₀ := by
            rw [h_inv_s, one_pow, mul_one]
          _ = (res₀_s g'_Z * res₀_s ((α₀ h₀) ^ m₀)) * (res₁_s (α₁ t₀)) ^ m₀ := by
            rw [map_pow, mul_pow]
            ring
          _ = (res₀_s ((α₀ eZ) ^ m₀) * (res₀_s ((α₀ h₀) ^ m₀) * res₁_s g_c)) *
                (res₁_s (α₁ t₀)) ^ m₀ := by
            rw [h_ap]
          _ = res₀_s ((α₀ eZ) ^ m₀) * res₁_s g_c *
                (res₀_s (α₀ h₀) * res₁_s (α₁ t₀)) ^ m₀ := by
            simp only [map_pow, mul_pow]
            ring
          _ = res₀_s ((α₀ eZ) ^ m₀) * res₁_s g_c := by
            rw [h_inv_s, one_pow, mul_one]
      
      let U_ov₁ : X_s.Opens := X_s.basicOpen (α₀ h₀ * d₁)
      have hU_ov₁_eq : U_ov₁ = X_s.basicOpen (α₀ h₀) ⊓ X_s.basicOpen d₁ :=
        AlgebraicGeometry.RingedSpace.basicOpen_mul X_s.toRingedSpace (α₀ h₀) d₁
      have hU_ov₁_V₀₁ : U_ov₁ ≤ V₀₁_s := by rw [hU_ov₁_eq, hbo_h₀s]; exact inf_le_left
      have hU_ov₁_d₁ : U_ov₁ ≤ X_s.basicOpen d₁ := by rw [hU_ov₁_eq]; exact inf_le_right
      have hU_ov₁_V₀ : U_ov₁ ≤ V₀_s := X_s.basicOpen_le (α₀ h₀ * d₁)
      have hU_ov₁_W₁ : U_ov₁ ≤ W₁_c := hU_ov₁_d₁.trans hd₁_le_W₁
      let res_ov₁ : ↑(X_s.presheaf.obj (Opposite.op V₀_s)) →+*
          ↑(X_s.presheaf.obj (Opposite.op U_ov₁)) :=
        (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀).op).hom
      letI : Algebra ↑(X_s.presheaf.obj (Opposite.op V₀_s))
          ↑(X_s.presheaf.obj (Opposite.op U_ov₁)) := res_ov₁.toAlgebra
      haveI hLoc_ov₁ : IsLocalization.Away (α₀ h₀ * d₁)
          ↑(X_s.presheaf.obj (Opposite.op U_ov₁)) :=
        AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen hAff_V₀s (α₀ h₀ * d₁)
      have h_ov₁_zero :
          res_ov₁ ((α₀ eZ) ^ (p + r₀ * m₀) * b₀ - (α₀ h₀) ^ (d₀ * m₀) * a₂) = 0 := by
        let α_ov₁ := (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_W₁).op).hom α
        let g_c_ov₁ := (X_s.presheaf.map
          (CategoryTheory.homOfLE (hOv₁.trans (X_s.basicOpen_le g_c))).op).hom g_c
        have h_gc_rel : res_ov₁ g'_Z = res_ov₁ ((α₀ eZ) ^ m₀) * g_c_ov₁ := by
          have h_ap := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom h_gZ_gl
          rw [map_mul] at h_ap
          have hr_1 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom (res₀_s g'_Z) =
              res_ov₁ g'_Z :=
            hRes_trans hU_ov₁_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₁_V₀ g'_Z
          have hr_2 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom
              (res₀_s ((α₀ eZ) ^ m₀)) = res_ov₁ ((α₀ eZ) ^ m₀) :=
            hRes_trans hU_ov₁_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₁_V₀ ((α₀ eZ) ^ m₀)
          have hr_3 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom (res₁_s g_c) =
              g_c_ov₁ :=
            hRes_trans hU_ov₁_V₀₁ (inf_le_right : V₀_s ⊓ V₁_s ≤ V₁_s)
              (hOv₁.trans (X_s.basicOpen_le g_c)) g_c
          rw [hr_1, hr_2, hr_3] at h_ap
          exact h_ap
        have h_b0_rel : res_ov₁ b₀ = res_ov₁ ((α₀ h₀) ^ (d₀ * m₀)) * (α_ov₁ * g_c_ov₁ ^ r₀) := by
          have h_ap1 := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom hb₀_eq
          rw [map_mul] at h_ap1
          have hr_1 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom
              (res₀_s ((α₀ h₀) ^ (d₀ * m₀))) = res_ov₁ ((α₀ h₀) ^ (d₀ * m₀)) :=
            hRes_trans hU_ov₁_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₁_V₀ ((α₀ h₀) ^ (d₀ * m₀))
          have hr_2 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom (res₀_s b₀) =
              res_ov₁ b₀ :=
            hRes_trans hU_ov₁_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₁_V₀ b₀
          have hr_3 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_V₀₁).op).hom (res₁_s a₁) =
              (X_s.presheaf.map
                (CategoryTheory.homOfLE (hOv₁.trans (X_s.basicOpen_le g_c))).op).hom a₁ :=
            hRes_trans hU_ov₁_V₀₁ (inf_le_right : V₀_s ⊓ V₁_s ≤ V₁_s)
              (hOv₁.trans (X_s.basicOpen_le g_c)) a₁
          rw [hr_1, hr_2, hr_3] at h_ap1
          have h_ap2 := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hOv₁).op).hom ha₁_eq
          rw [map_mul, map_pow, map_pow] at h_ap2
          have hr_4 : (X_s.presheaf.map (CategoryTheory.homOfLE hOv₁).op).hom α_gc = α_ov₁ :=
            hRes_trans hOv₁ hgc_le_W₁ hU_ov₁_W₁ α
          have hr_5 : (X_s.presheaf.map (CategoryTheory.homOfLE hOv₁).op).hom (res_gc g_c) = g_c_ov₁ :=
            hRes_trans hOv₁ (X_s.basicOpen_le g_c) (hOv₁.trans (X_s.basicOpen_le g_c)) g_c
          have hr_6 : (X_s.presheaf.map (CategoryTheory.homOfLE hOv₁).op).hom (res_gc a₁) =
              (X_s.presheaf.map
                (CategoryTheory.homOfLE (hOv₁.trans (X_s.basicOpen_le g_c))).op).hom a₁ :=
            hRes_trans hOv₁ (X_s.basicOpen_le g_c) (hOv₁.trans (X_s.basicOpen_le g_c)) a₁
          rw [hr_4, hr_5, hr_6] at h_ap2
          rw [← h_ap1, ← h_ap2]
        have h_a2_rel : res_ov₁ a₂ = α_ov₁ * res_ov₁ ((α₀ eZ) ^ p * g'_Z ^ r₀) := by
          have h_ap := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_d₁).op).hom ha₂_eq
          rw [map_mul] at h_ap
          have hr_1 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_d₁).op).hom α_d₁ = α_ov₁ :=
            hRes_trans hU_ov₁_d₁ hd₁_le_W₁ hU_ov₁_W₁ α
          have hr_2 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_d₁).op).hom
              (res_d₁ ((α₀ eZ) ^ p * g'_Z ^ r₀)) = res_ov₁ ((α₀ eZ) ^ p * g'_Z ^ r₀) :=
            hRes_trans hU_ov₁_d₁ (X_s.basicOpen_le d₁) hU_ov₁_V₀ ((α₀ eZ) ^ p * g'_Z ^ r₀)
          have hr_3 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₁_d₁).op).hom (res_d₁ a₂) =
              res_ov₁ a₂ :=
            hRes_trans hU_ov₁_d₁ (X_s.basicOpen_le d₁) hU_ov₁_V₀ a₂
          rw [hr_1, hr_2, hr_3] at h_ap
          exact h_ap.symm
        rw [RingHom.map_sub res_ov₁,
          RingHom.map_mul res_ov₁ ((α₀ eZ) ^ (p + r₀ * m₀)) b₀,
          pow_add,
          RingHom.map_mul res_ov₁ ((α₀ eZ) ^ p) ((α₀ eZ) ^ (r₀ * m₀)),
          RingHom.map_mul res_ov₁ ((α₀ h₀) ^ (d₀ * m₀)) a₂,
          h_b0_rel, h_a2_rel,
          RingHom.map_mul res_ov₁ ((α₀ eZ) ^ p) (g'_Z ^ r₀),
          RingHom.map_pow res_ov₁ g'_Z r₀,
          h_gc_rel]
        simp only [map_pow, mul_pow, ← pow_mul]
        rw [mul_comm m₀ r₀]
        ring
      obtain ⟨⟨_, ⟨q₁, rfl⟩⟩, hq₁_eq⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (α₀ h₀ * d₁))
          ↑(X_s.presheaf.obj (Opposite.op U_ov₁)) _).mp h_ov₁_zero
      have hq₁_eq' :
          (α₀ h₀ * α₀ eZ * g'_Z) ^ q₁ *
            ((α₀ eZ) ^ (p + r₀ * m₀) * b₀ - (α₀ h₀) ^ (d₀ * m₀) * a₂) = 0 := by
        simpa [d₁, mul_assoc] using hq₁_eq
      
      let U_ov₂ : X_s.Opens := X_s.basicOpen (α₀ h₀ * d₂)
      have hU_ov₂_eq : U_ov₂ = X_s.basicOpen (α₀ h₀) ⊓ X_s.basicOpen d₂ :=
        AlgebraicGeometry.RingedSpace.basicOpen_mul X_s.toRingedSpace (α₀ h₀) d₂
      have hU_ov₂_V₀₁ : U_ov₂ ≤ V₀₁_s := by rw [hU_ov₂_eq, hbo_h₀s]; exact inf_le_left
      have hU_ov₂_d₂ : U_ov₂ ≤ X_s.basicOpen d₂ := by rw [hU_ov₂_eq]; exact inf_le_right
      have hU_ov₂_V₀ : U_ov₂ ≤ V₀_s := X_s.basicOpen_le (α₀ h₀ * d₂)
      have hU_ov₂_W₁ : U_ov₂ ≤ W₁_c := hU_ov₂_d₂.trans hd₂_le_W₁
      let res_ov₂ : ↑(X_s.presheaf.obj (Opposite.op V₀_s)) →+*
          ↑(X_s.presheaf.obj (Opposite.op U_ov₂)) :=
        (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀).op).hom
      letI : Algebra ↑(X_s.presheaf.obj (Opposite.op V₀_s))
          ↑(X_s.presheaf.obj (Opposite.op U_ov₂)) := res_ov₂.toAlgebra
      haveI hLoc_ov₂ : IsLocalization.Away (α₀ h₀ * d₂)
          ↑(X_s.presheaf.obj (Opposite.op U_ov₂)) :=
        AlgebraicGeometry.IsAffineOpen.isLocalization_basicOpen hAff_V₀s (α₀ h₀ * d₂)
      have h_ov₂_zero :
          res_ov₂ ((α₀ eY) ^ p * (α₀ h₀) ^ (r₀ * m₀) * b₀ - (α₀ h₀) ^ (d₀ * m₀) * a₃) = 0 := by
        let α_ov₂ := (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_W₁).op).hom α
        let g_c_ov₂ := (X_s.presheaf.map
          (CategoryTheory.homOfLE (hOv₂.trans (X_s.basicOpen_le g_c))).op).hom g_c
        have h_gc_rel : res_ov₂ ĝ_Y = res_ov₂ ((α₀ h₀) ^ m₀) * g_c_ov₂ := by
          have h_ap := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom h_gY_gl
          rw [map_mul] at h_ap
          have hr_1 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom (res₀_s ĝ_Y) =
              res_ov₂ ĝ_Y :=
            hRes_trans hU_ov₂_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₂_V₀ ĝ_Y
          have hr_2 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom
              (res₀_s ((α₀ h₀) ^ m₀)) = res_ov₂ ((α₀ h₀) ^ m₀) :=
            hRes_trans hU_ov₂_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₂_V₀ ((α₀ h₀) ^ m₀)
          have hr_3 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom (res₁_s g_c) =
              g_c_ov₂ :=
            hRes_trans hU_ov₂_V₀₁ (inf_le_right : V₀_s ⊓ V₁_s ≤ V₁_s)
              (hOv₂.trans (X_s.basicOpen_le g_c)) g_c
          rw [hr_1, hr_2, hr_3] at h_ap
          exact h_ap
        have h_b0_rel : res_ov₂ b₀ = res_ov₂ ((α₀ h₀) ^ (d₀ * m₀)) * (α_ov₂ * g_c_ov₂ ^ r₀) := by
          have h_ap1 := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom hb₀_eq
          rw [map_mul] at h_ap1
          have hr_1 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom
              (res₀_s ((α₀ h₀) ^ (d₀ * m₀))) = res_ov₂ ((α₀ h₀) ^ (d₀ * m₀)) :=
            hRes_trans hU_ov₂_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₂_V₀ ((α₀ h₀) ^ (d₀ * m₀))
          have hr_2 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom (res₀_s b₀) =
              res_ov₂ b₀ :=
            hRes_trans hU_ov₂_V₀₁ (inf_le_left : V₀_s ⊓ V₁_s ≤ V₀_s) hU_ov₂_V₀ b₀
          have hr_3 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_V₀₁).op).hom (res₁_s a₁) =
              (X_s.presheaf.map
                (CategoryTheory.homOfLE (hOv₂.trans (X_s.basicOpen_le g_c))).op).hom a₁ :=
            hRes_trans hU_ov₂_V₀₁ (inf_le_right : V₀_s ⊓ V₁_s ≤ V₁_s)
              (hOv₂.trans (X_s.basicOpen_le g_c)) a₁
          rw [hr_1, hr_2, hr_3] at h_ap1
          have h_ap2 := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hOv₂).op).hom ha₁_eq
          rw [map_mul, map_pow, map_pow] at h_ap2
          have hr_4 : (X_s.presheaf.map (CategoryTheory.homOfLE hOv₂).op).hom α_gc = α_ov₂ :=
            hRes_trans hOv₂ hgc_le_W₁ hU_ov₂_W₁ α
          have hr_5 : (X_s.presheaf.map (CategoryTheory.homOfLE hOv₂).op).hom (res_gc g_c) = g_c_ov₂ :=
            hRes_trans hOv₂ (X_s.basicOpen_le g_c) (hOv₂.trans (X_s.basicOpen_le g_c)) g_c
          have hr_6 : (X_s.presheaf.map (CategoryTheory.homOfLE hOv₂).op).hom (res_gc a₁) =
              (X_s.presheaf.map
                (CategoryTheory.homOfLE (hOv₂.trans (X_s.basicOpen_le g_c))).op).hom a₁ :=
            hRes_trans hOv₂ (X_s.basicOpen_le g_c) (hOv₂.trans (X_s.basicOpen_le g_c)) a₁
          rw [hr_4, hr_5, hr_6] at h_ap2
          rw [← h_ap1, ← h_ap2]
        have h_a3_rel : res_ov₂ a₃ = α_ov₂ * res_ov₂ ((α₀ eY) ^ p * ĝ_Y ^ r₀) := by
          have h_ap := congrArg (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_d₂).op).hom ha₃_eq
          rw [map_mul] at h_ap
          have hr_1 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_d₂).op).hom α_d₂ = α_ov₂ :=
            hRes_trans hU_ov₂_d₂ hd₂_le_W₁ hU_ov₂_W₁ α
          have hr_2 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_d₂).op).hom
              (res_d₂ ((α₀ eY) ^ p * ĝ_Y ^ r₀)) = res_ov₂ ((α₀ eY) ^ p * ĝ_Y ^ r₀) :=
            hRes_trans hU_ov₂_d₂ (X_s.basicOpen_le d₂) hU_ov₂_V₀ ((α₀ eY) ^ p * ĝ_Y ^ r₀)
          have hr_3 : (X_s.presheaf.map (CategoryTheory.homOfLE hU_ov₂_d₂).op).hom (res_d₂ a₃) =
              res_ov₂ a₃ :=
            hRes_trans hU_ov₂_d₂ (X_s.basicOpen_le d₂) hU_ov₂_V₀ a₃
          rw [hr_1, hr_2, hr_3] at h_ap
          exact h_ap.symm
        rw [RingHom.map_sub res_ov₂,
          RingHom.map_mul res_ov₂ ((α₀ eY) ^ p * (α₀ h₀) ^ (r₀ * m₀)) b₀,
          RingHom.map_mul res_ov₂ ((α₀ eY) ^ p) ((α₀ h₀) ^ (r₀ * m₀)),
          RingHom.map_mul res_ov₂ ((α₀ h₀) ^ (d₀ * m₀)) a₃,
          h_b0_rel, h_a3_rel,
          RingHom.map_mul res_ov₂ ((α₀ eY) ^ p) (ĝ_Y ^ r₀),
          RingHom.map_pow res_ov₂ ĝ_Y r₀,
          h_gc_rel]
        simp only [map_pow, mul_pow, ← pow_mul]
        rw [mul_comm m₀ r₀]
        ring
      obtain ⟨⟨_, ⟨q₂, rfl⟩⟩, hq₂_eq⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers (α₀ h₀ * d₂))
          ↑(X_s.presheaf.obj (Opposite.op U_ov₂)) _).mp h_ov₂_zero
      have hq₂_eq' :
          (α₀ h₀ * α₀ eY * ĝ_Y) ^ q₂ *
            ((α₀ eY) ^ p * (α₀ h₀) ^ (r₀ * m₀) * b₀ - (α₀ h₀) ^ (d₀ * m₀) * a₃) = 0 := by
        simpa [d₂, mul_assoc] using hq₂_eq
      
      obtain ⟨q_exp, P, hP_hom, hP_eq⟩ :=
        hSurj_U₁ c₁ r₀ p d₀ q₁ q₂ a₁ a₂ a₃ b₀ hr₀_pos hd₀_pos hb₀_eq hq₁_eq' hq₂_eq'
      have hP_hom' : P ∈ 𝒜_F ((r₀ + q_exp) • 1) := by rwa [nsmul_eq_mul, mul_one]
      let z_c_cand := (ι_Xns.app D_c).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF L_c).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _
            hLc (r₀ + q_exp) P hP_hom'))
      refine ⟨z_c_cand, ?_⟩
      apply hInj_3chart g_c d₁ d₂ W₁_c hW₁_decomp hgc_le_W₁ hOv₁ hOv₂
      have h_eval_cand := hEval_U₁ hgc_le_W₁ (r₀ + q_exp) P hP_hom'
      rw [← hP_eq] at h_eval_cand
      have h_rhs_alpha :
          res_gc (g_c ^ q_exp * a₁) = α_gc * (res_gc g_c) ^ (r₀ + q_exp) := by
        rw [map_mul, map_pow, ← ha₁_eq, map_pow, pow_add]
        ring
      rw [h_rhs_alpha] at h_eval_cand
      have hUnit_gc : IsUnit (res_gc g_c) :=
        AlgebraicGeometry.RingedSpace.isUnit_res_basicOpen X_s.toRingedSpace g_c
      obtain ⟨u_gc, hu_gc⟩ := hUnit_gc.pow (r₀ + q_exp)
      rw [← hu_gc] at h_eval_cand
      calc
        (X_s.presheaf.map (CategoryTheory.homOfLE hgc_le_W₁).op).hom
            ((q_s.appLE U₁_c W₁_c le_rfl).hom z_c_cand)
          = ((X_s.presheaf.map (CategoryTheory.homOfLE hgc_le_W₁).op).hom
              ((q_s.appLE U₁_c W₁_c le_rfl).hom z_c_cand) * ↑u_gc) * ↑(u_gc⁻¹) := by
            rw [mul_assoc, Units.mul_inv, mul_one]
        _ = (α_gc * ↑u_gc) * ↑(u_gc⁻¹) := by rw [h_eval_cand]
        _ = α_gc := by rw [mul_assoc, Units.mul_inv, mul_one]

theorem weil_sup1_fractional_cech_veronese_proj_map (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀) :
    ∃ (N' : ℕ) (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left),
      IsUnstableP1ContractionProjMap V g Z V₀ V₁ eZ N' φ :=
by
  obtain ⟨⟨A₀, hA₀_pos, hA₀_surj⟩, hRelLift⟩ :=
    weil_sup1_relative_cech_freeness_and_veronese_basis K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
      V₀ V₁ h₀ eZ eY t₀ hPencil
  obtain ⟨m₀, f₁_bar, hSeed⟩ :=
    weil_sup1_closed_fiber_koszul_veronese_generation K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
      V₀ V₁ h₀ eZ eY t₀ hPencil A₀ hA₀_pos hA₀_surj
  obtain ⟨N', f, f_Y, f_Z, hBasis⟩ := hRelLift m₀ f₁_bar hSeed
  obtain ⟨φ, U_next₀, f₁_gl, hImg⟩ :=
    weil_sup1_three_chart_proj_gluing_and_image_ker K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
      V₀ V₁ h₀ eZ eY t₀ hPencil m₀ N' f f_Y f_Z hBasis
  have hFibers :=
    weil_sup1_fiber_shifted_chart_ring_bijections K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
      V₀ V₁ h₀ eZ eY t₀ hPencil m₀ N' f f_Y f_Z hBasis φ U_next₀ f₁_gl hImg
  rcases hImg with ⟨hφ_comm, _hSurj, _hUnext_eq, hAff_Unext₀, hPre_Unext₀,
    _hf₁_V₁, _hf₁_Z, hf₁_vanish, _hCharts, _hKer⟩
  exact ⟨N', φ, hφ_comm, U_next₀, f₁_gl, hAff_Unext₀, hPre_Unext₀, hFibers, hf₁_vanish⟩

theorem weil_sup1_image_integral_flat_and_lfp (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K C : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (ι : C_K ⟶ C)
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hIntC : AlgebraicGeometry.IsIntegral C)
    (hPropG : AlgebraicGeometry.IsProper g)
    (hPb : CategoryTheory.IsPullback ι p_K g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (hφ : φ ≫ (weilProjectiveSpaceOver ↥V N').hom = g) :
    AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Scheme.Hom.image φ) ∧
    AlgebraicGeometry.Flat
      (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) ∧
    AlgebraicGeometry.LocallyOfFinitePresentation
      (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) :=
by
  classical
  have h_integral_img : ∀ (X P : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsIntegral X]
      (f : X ⟶ P) [AlgebraicGeometry.QuasiCompact f],
      AlgebraicGeometry.IsIntegral f.image := by
    intro X P _ f _
    have hIrredX : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    have hRedX : AlgebraicGeometry.IsReduced X := inferInstance
    have hDense : DenseRange f.toImage.base := AlgebraicGeometry.IsDominant.denseRange (f := f.toImage)
    obtain ⟨z₀⟩ := hIrredX.toNonempty
    have hIrredImg : IrreducibleSpace ↥f.image :=
      { isPreirreducible_univ := by
          rw [← hDense.closure_eq, ← Set.image_univ]
          exact (hIrredX.isPreirreducible_univ.image f.toImage.base
            f.toImage.continuous.continuousOn).closure
        toNonempty := ⟨f.toImage.base z₀⟩ }
    have hStalkRed : ∀ x : ↥f.image, _root_.IsReduced ↑(f.image.presheaf.stalk x) := by
      intro x
      obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
        P.isBasis_affineOpens.exists_subset_of_mem_open
          (Set.mem_univ (f.imageι.base x)) isOpen_univ
      let U' : f.image.Opens := f.imageι ⁻¹ᵁ U
      have hxU' : x ∈ U' := hxU
      have hU' : AlgebraicGeometry.IsAffineOpen U' := hU.preimage f.imageι
      let e_sub := f.ker.subschemeObjIso ⟨U, hU⟩
      have h_ker_sub : ∀ a ∈ f.ker.ideal ⟨U, hU⟩, (f.app U).hom a = 0 := by
        intro a ha
        rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at ha
        exact ha
      let φ_inj : (↑Γ(P, U) ⧸ f.ker.ideal ⟨U, hU⟩) →+* ↑Γ(X, f ⁻¹ᵁ U) :=
        Ideal.Quotient.lift (f.ker.ideal ⟨U, hU⟩) (f.app U).hom h_ker_sub
      have hφ_inj : Function.Injective φ_inj := by
        rw [RingHom.injective_iff_ker_eq_bot, eq_bot_iff]
        intro q hq
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective q
        rw [RingHom.mem_ker] at hq
        have hq' : (f.app U).hom a = 0 := by
          simpa [φ_inj] using hq
        have ha : a ∈ f.ker.ideal ⟨U, hU⟩ := by
          rw [AlgebraicGeometry.Scheme.Hom.ker_apply]
          exact hq'
        exact (Submodule.mem_bot _).mpr (Ideal.Quotient.eq_zero_iff_mem.mpr ha)
      have hRedΓ : _root_.IsReduced ↑Γ(f.image, U') :=
        isReduced_of_injective (φ_inj.comp e_sub.hom.hom)
          (hφ_inj.comp e_sub.commRingCatIsoToRingEquiv.injective)
      have hRedSpec : AlgebraicGeometry.IsReduced (AlgebraicGeometry.Spec Γ(f.image, U')) :=
        (AlgebraicGeometry.affine_isReduced_iff Γ(f.image, U')).mpr hRedΓ
      have hRedU' : AlgebraicGeometry.IsReduced U'.toScheme :=
        @AlgebraicGeometry.isReduced_of_isOpenImmersion _ _ hU'.isoSpec.hom inferInstance hRedSpec
      have hStalkU' : _root_.IsReduced ↑(U'.toScheme.presheaf.stalk ⟨x, hxU'⟩) :=
        @AlgebraicGeometry.isReduced_stalk_of_isReduced U'.toScheme hRedU' ⟨x, hxU'⟩
      let e_stalk := (U'.stalkIso ⟨x, hxU'⟩).symm
      exact isReduced_of_injective e_stalk.hom.hom e_stalk.commRingCatIsoToRingEquiv.injective
    have hRedImg : AlgebraicGeometry.IsReduced f.image :=
      @AlgebraicGeometry.isReduced_of_isReduced_stalk f.image hStalkRed
    exact (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced f.image).mpr
      ⟨hIrredImg, hRedImg⟩
  have h_ker_eq : ∀ (X₀ X P : AlgebraicGeometry.Scheme.{u})
      [Nonempty ↥X₀] [AlgebraicGeometry.IsIntegral X]
      (ι₀ : X₀ ⟶ X) [AlgebraicGeometry.IsOpenImmersion ι₀]
      (f : X ⟶ P) [AlgebraicGeometry.QuasiCompact f]
      [AlgebraicGeometry.QuasiCompact (ι₀ ≫ f)],
      AlgebraicGeometry.Scheme.Hom.ker f = AlgebraicGeometry.Scheme.Hom.ker (ι₀ ≫ f) := by
    intro X₀ X P _ _ ι₀ _ f _ _
    have hIrredX : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    have : PreirreducibleSpace ↥X := hIrredX.toPreirreducibleSpace
    have : AlgebraicGeometry.IsReduced X := inferInstance
    obtain ⟨z₀⟩ : Nonempty ↥X₀ := inferInstance
    have hOpenRange : IsOpen (Set.range ι₀.base) :=
      AlgebraicGeometry.IsOpenImmersion.isOpen_range ι₀
    have hDense : Dense (Set.range ι₀.base) :=
      hOpenRange.dense ⟨ι₀.base z₀, ⟨z₀, rfl⟩⟩
    have hAppInj : ∀ (W : X.Opens) (s : ↑Γ(X, W)), (ι₀.app W).hom s = 0 → s = 0 := by
      intro W s hs
      have hPre : ι₀ ⁻¹ᵁ X.basicOpen s = ⊥ := by
        rw [AlgebraicGeometry.Scheme.Hom.preimage_basicOpen, hs,
          AlgebraicGeometry.Scheme.basicOpen_zero]
      have hBot : X.basicOpen s = ⊥ := by
        by_contra hNe
        have hNonempty : ((X.basicOpen s : Set ↥X)).Nonempty := by
          rw [Set.nonempty_iff_ne_empty]
          intro hEmpty
          apply hNe
          ext x
          change x ∈ (X.basicOpen s : Set ↥X) ↔ False
          rw [hEmpty]
          simp
        obtain ⟨y, hyBasic, z, rfl⟩ :=
          hDense.inter_open_nonempty (X.basicOpen s : Set ↥X) (X.basicOpen s).isOpen hNonempty
        have hz : z ∈ ι₀ ⁻¹ᵁ X.basicOpen s := hyBasic
        rw [hPre] at hz
        exact hz
      exact (AlgebraicGeometry.basicOpen_eq_bot_iff s).mp hBot
    ext U s
    rw [AlgebraicGeometry.Scheme.Hom.ker_apply, AlgebraicGeometry.Scheme.Hom.ker_apply,
      RingHom.mem_ker, RingHom.mem_ker, AlgebraicGeometry.Scheme.Hom.comp_app]
    change (f.app U.1).hom s = 0 ↔ (ι₀.app (f ⁻¹ᵁ U.1)).hom ((f.app U.1).hom s) = 0
    constructor
    · intro hs
      rw [hs, map_zero]
    · intro hs
      exact hAppInj (f ⁻¹ᵁ U.1) ((f.app U.1).hom s) hs
  have h_flat_lfp : ∀ (K₀ R : Type u) [Field K₀] [CommRing R] [IsDomain R] [ValuationRing R]
      (ι_RK : R →+* K₀), Function.Injective ι_RK →
      (∀ (r : ℕ) (J : Ideal (MvPolynomial (Fin r) R)),
        (∀ (c : R) (f : MvPolynomial (Fin r) R), c ≠ 0 → MvPolynomial.C c * f ∈ J → f ∈ J) →
        J.FG) →
      ∀ (X_K P_V : AlgebraicGeometry.Scheme.{u})
        (p₀ : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K₀))
        (π_V : P_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
        (j : X_K ⟶ P_V) [AlgebraicGeometry.QuasiCompact j],
        j ≫ π_V = p₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_RK) →
        ∀ (M : ℕ) (U : Fin (M + 1) → P_V.Opens),
          (⨆ a : Fin (M + 1), U a) = ⊤ →
          ∀ (hAff : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (U a))
            (c_V : ∀ a : Fin (M + 1), R →+* ↑Γ(P_V, U a)),
            (∀ a : Fin (M + 1),
