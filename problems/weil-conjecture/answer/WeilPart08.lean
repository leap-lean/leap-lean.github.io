            (hJ2 U (U ⊓ V₀) hU hUV₀ inf_le_left _).symm
      _ = j_open (U ⊓ V₀) hUV₀ ((γ ≫ p.appLE ⊤ (U ⊓ V₀) le_top).hom c) := by rw [hResU]
      _ = j_open (U ⊓ V₀) hUV₀
