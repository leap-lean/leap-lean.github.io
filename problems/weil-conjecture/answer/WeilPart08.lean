      have hComap₀ : PrimeSpectrum.comap e_AB q₀ = hUY.primeIdealOf ⟨y, hy_UY⟩ := by
        apply hUY.fromSpec.isOpenEmbedding.injective
        rw [hMap_q q₀, hq₀_u₀, hu₀, hUY.fromSpec_primeIdealOf ⟨y, hy_UY⟩]
      
      have hRedLoc : _root_.IsReduced (Localization.AtPrime (hUY.primeIdealOf ⟨y, hy_UY⟩).asIdeal) := by
        rw [← hComap₀]
        exact hNodStalk A B e_AB φ q₀ he_AB hφ
      letI : Algebra A ↑(Y.presheaf.stalk y) :=
        (Y.presheaf.germ U_Y y hy_UY).hom.toAlgebra
      haveI : IsLocalization.AtPrime ↑(Y.presheaf.stalk y)
          (hUY.primeIdealOf ⟨y, hy_UY⟩).asIdeal :=
        hUY.isLocalization_stalk ⟨y, hy_UY⟩
      have hRedStalkY : _root_.IsReduced ↑(Y.presheaf.stalk y) :=
        hRedEquiv hRedLoc
          (IsLocalization.algEquiv (hUY.primeIdealOf ⟨y, hy_UY⟩).asIdeal.primeCompl
            (Localization.AtPrime (hUY.primeIdealOf ⟨y, hy_UY⟩).asIdeal)
            ↑(Y.presheaf.stalk y)).toRingEquiv
      
      have hX_q₀ : ∀ i : Fin 2, φ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀.asIdeal := by
        intro i
        have hcomap_φ : PrimeSpectrum.comap φ q₀ = e₂.base u₀ := by
          have hev : PrimeSpectrum.comap φ q₀ = e₂.base (hUB.fromSpec.base q₀) :=
