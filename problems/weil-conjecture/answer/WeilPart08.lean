      (CategoryTheory.Limits.pullback.snd g_R s_res) u_res := by
    refine (CategoryTheory.IsPullback.of_bot ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
      (CategoryTheory.IsPullback.of_hasPullback g_R s_res).flip).flip
    rw [CategoryTheory.Limits.pullback.lift_fst, hu_res_s]
    exact hPb_Y.flip
  haveI : CategoryTheory.IsIso Θ_Y :=
    CategoryTheory.IsPullback.isIso_fst_of_isIso hΘ_Y_pb
  haveI : AlgebraicGeometry.Etale Θ_Y := inferInstance
  have hRoofTransport : ∀ q : ↥Y,
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ Y)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k₀) *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) k₀)}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = q ∧
        (∀ i : Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) k₀) ∈
            (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p_Y =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : k₀ →+* MvPolynomial (Fin 2) k₀)))) →
      ∃ y₀ : ↥Y_res,
        (CategoryTheory.Limits.pullback.fst g_R s_res).base y₀ = i_Y.base q ∧
        ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
            (e₁ : U' ⟶ Y_res)
            (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ Ideal.span
                {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) *
                  (MvPolynomial.X 1 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y₀ ∧
          (∀ i : Fin 2,
            Ideal.Quotient.mk _
              (MvPolynomial.X i : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) ∈
              (e₂.base u₀).asIdeal) ∧
          e₁ ≫ CategoryTheory.Limits.pullback.snd g_R s_res =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
                (MvPolynomial.C :
                  IsLocalRing.ResidueField R →+*
                    MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)))) := by
    rintro q ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀_q, hXi, he_comm⟩
    let y₀ : ↥Y_res := Θ_Y.base q
    have hΘ_Y_fst : Θ_Y ≫ CategoryTheory.Limits.pullback.fst g_R s_res = i_Y :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hy₀_fst : (CategoryTheory.Limits.pullback.fst g_R s_res).base y₀ = i_Y.base q :=
      congrArg (fun f : Y ⟶ C_R => f.base q) hΘ_Y_fst
    let I_res : Ideal (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) :=
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) *
        MvPolynomial.X 1}
    let I₀ : Ideal (MvPolynomial (Fin 2) k₀) :=
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k₀) * MvPolynomial.X 1}
    let M_eq : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ≃+* MvPolynomial (Fin 2) k₀ :=
      MvPolynomial.mapEquiv (Fin 2) e_res
    let M_fwd : (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I_res) →+*
        (MvPolynomial (Fin 2) k₀ ⧸ I₀) :=
      Ideal.Quotient.lift I_res ((Ideal.Quotient.mk I₀).comp M_eq.toRingHom) (by
        intro F hF
        rw [Ideal.mem_span_singleton] at hF
        rcases hF with ⟨G, rfl⟩
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
        change Ideal.Quotient.mk I₀ (MvPolynomial.map e_res.toRingHom
          (MvPolynomial.X 0 * MvPolynomial.X 1 * G)) = 0
        have h1 : MvPolynomial.map e_res.toRingHom (MvPolynomial.X 0 * MvPolynomial.X 1 * G) =
            MvPolynomial.X 0 * MvPolynomial.X 1 * MvPolynomial.map e_res.toRingHom G := by
          rw [map_mul, map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
        have h0 : Ideal.Quotient.mk I₀ (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton _))
        rw [h1, map_mul, h0, zero_mul])
    let M_bwd : (MvPolynomial (Fin 2) k₀ ⧸ I₀) →+*
        (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I_res) :=
      Ideal.Quotient.lift I₀ ((Ideal.Quotient.mk I_res).comp M_eq.symm.toRingHom) (by
        intro F hF
        rw [Ideal.mem_span_singleton] at hF
        rcases hF with ⟨G, rfl⟩
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
        change Ideal.Quotient.mk I_res (MvPolynomial.map e_res.symm.toRingHom
          (MvPolynomial.X 0 * MvPolynomial.X 1 * G)) = 0
        have h1 : MvPolynomial.map e_res.symm.toRingHom (MvPolynomial.X 0 * MvPolynomial.X 1 * G) =
            MvPolynomial.X 0 * MvPolynomial.X 1 * MvPolynomial.map e_res.symm.toRingHom G := by
          rw [map_mul, map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
        have h0 : Ideal.Quotient.mk I_res (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span (Set.mem_singleton _))
        rw [h1, map_mul, h0, zero_mul])
    have hM_fb : M_fwd.comp M_bwd = RingHom.id (MvPolynomial (Fin 2) k₀ ⧸ I₀) := by
      apply RingHom.ext
      intro x
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
      change M_fwd (M_bwd (Ideal.Quotient.mk I₀ F)) = Ideal.Quotient.mk I₀ F
      dsimp only [M_fwd, M_bwd]
      rw [Ideal.Quotient.lift_mk]
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [Ideal.Quotient.lift_mk]
      simp only [RingHom.comp_apply, RingHom.coe_coe, RingEquiv.apply_symm_apply]
    have hM_bf : M_bwd.comp M_fwd =
        RingHom.id (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I_res) := by
      apply RingHom.ext
      intro x
      obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective x
      change M_bwd (M_fwd (Ideal.Quotient.mk I_res F)) = Ideal.Quotient.mk I_res F
      dsimp only [M_fwd, M_bwd]
      rw [Ideal.Quotient.lift_mk]
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [Ideal.Quotient.lift_mk]
      simp only [RingHom.comp_apply, RingHom.coe_coe, RingEquiv.symm_apply_apply]
    let v_nod : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k₀ ⧸ I₀)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I_res)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_fwd)
    let v_nod_inv : AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ I_res)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k₀ ⧸ I₀)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_bwd)
    have hv_hom_inv : v_nod ≫ v_nod_inv = 𝟙 _ := by
      dsimp only [v_nod, v_nod_inv]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hM_fb]
      exact AlgebraicGeometry.Spec.map_id _
    have hv_inv_hom : v_nod_inv ≫ v_nod = 𝟙 _ := by
      dsimp only [v_nod, v_nod_inv]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hM_bf]
      exact AlgebraicGeometry.Spec.map_id _
    haveI : CategoryTheory.IsIso v_nod := ⟨⟨v_nod_inv, hv_hom_inv, hv_inv_hom⟩⟩
    haveI : AlgebraicGeometry.Etale v_nod := inferInstance
    refine ⟨y₀, hy₀_fst, U', u₀, e₁ ≫ Θ_Y, e₂ ≫ v_nod, inferInstance, inferInstance, ?_, ?_, ?_⟩
    · change Θ_Y.base (e₁.base u₀) = y₀
      rw [hu₀_q]
    · intro i
      have hv_app : (e₂ ≫ v_nod).base u₀ = v_nod.base (e₂.base u₀) := rfl
      rw [hv_app]
      change M_fwd (Ideal.Quotient.mk I_res (MvPolynomial.X i)) ∈ (e₂.base u₀).asIdeal
      have hM_Xi : M_fwd (Ideal.Quotient.mk I_res (MvPolynomial.X i)) =
          Ideal.Quotient.mk I₀ (MvPolynomial.X i) := by
        dsimp only [M_fwd]
        rw [Ideal.Quotient.lift_mk]
        change Ideal.Quotient.mk I₀ (MvPolynomial.map e_res.toRingHom (MvPolynomial.X i)) = _
        rw [MvPolynomial.map_X]
      rw [hM_Xi]
      exact hXi i
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, he_comm, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc]
      congr 1
      dsimp only [u_res, v_nod]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro r
      simp only [RingHom.comp_apply]
      change Ideal.Quotient.mk I₀ (MvPolynomial.C (e_res r)) =
        M_fwd (Ideal.Quotient.mk I_res (MvPolynomial.C r))
      dsimp only [M_fwd]
      rw [Ideal.Quotient.lift_mk]
      change Ideal.Quotient.mk I₀ (MvPolynomial.C (e_res r)) =
        Ideal.Quotient.mk I₀ (MvPolynomial.map e_res.toRingHom (MvPolynomial.C r))
      rw [MvPolynomial.map_C]
      rfl
  
  intro E_star hE_star Z_set Y'_set hZ_sub hY'_sub hRoof_Δ
  let Δ_P : Set ↥X_P := E_star ∩ (⋃ E' ∈ (irreducibleComponents ↥X_P) \ {E_star}, E')
  let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P))
  let η_R_pt : AlgebraicGeometry.Spec (CommRingCat.of R) := ⟨⊥, inferInstance⟩
  let m_R_star : AlgebraicGeometry.Spec (CommRingCat.of R) :=
    ⟨IsLocalRing.maximalIdeal R, inferInstance⟩
  have hη_pt_eq : η_R.base pt_P = η_R_pt := by
    apply PrimeSpectrum.ext
    change Ideal.comap (algebraMap R k_P) ⊥ = ⊥
    rw [Submodule.eq_bot_iff]
    intro r hr
    exact IsFractionRing.injective R k_P (hr.trans (map_zero _).symm)
  have hm_cl_η : m_R_star ∈ closure ({η_R_pt} : Set (AlgebraicGeometry.Spec (CommRingCat.of R))) :=
    (PrimeSpectrum.le_iff_mem_closure η_R_pt m_R_star).mp bot_le
  
  have hPtPkg : ∀ x : ↥Δ_P,
      ∃ (E'_x : Set ↥X_P) (σ_tilde_x : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R)
        (q_x : ↥Y),
        E'_x ∈ (irreducibleComponents ↥X_P) \ {E_star} ∧
        x.1 ∈ E'_x ∧
        σ_tilde_x ≫ g_R = 𝟙 _ ∧
        (η_R ≫ σ_tilde_x).base pt_P = j_P.base x.1 ∧
        i_Y.base q_x = σ_tilde_x.base m_R_star ∧
        q_x ∈ Z_set ∩ Y'_set := by
    intro x
    obtain ⟨E'_x, hE'_x_mem, hx_E'⟩ := Set.mem_iUnion₂.mp x.2.2
    obtain ⟨σ_x, hσ_x_pP, hσ_x_pt⟩ :=
      hSec_P x.1 E_star E'_x hE_star hE'_x_mem.1 (Ne.symm hE'_x_mem.2) x.2.1 hx_E'
    have hf_Px : (σ_x ≫ j_P) ≫ g_R = η_R := by
      rw [CategoryTheory.Category.assoc, hPb_P.w, ← CategoryTheory.Category.assoc,
        hσ_x_pP, CategoryTheory.Category.id_comp]
    obtain ⟨σ_tilde_x, hσ_tilde_g, hσ_tilde_gen⟩ := hValExt (σ_x ≫ j_P) hf_Px
    have hσ_tilde_ptP : (η_R ≫ σ_tilde_x).base pt_P = j_P.base x.1 := by
      rw [hσ_tilde_gen]
      change j_P.base (σ_x.base pt_P) = j_P.base x.1
      rw [hσ_x_pt pt_P]
    have hσ_tilde_ηpt : σ_tilde_x.base η_R_pt = j_P.base x.1 := by
      rw [← hη_pt_eq]
      exact hσ_tilde_ptP
    have hσ_tilde_m_cl : σ_tilde_x.base m_R_star ∈ closure ({j_P.base x.1} : Set ↥C_R) := by
      rw [← hσ_tilde_ηpt, ← Set.image_singleton]
      exact image_closure_subset_closure_image σ_tilde_x.continuous ⟨m_R_star, hm_cl_η, rfl⟩
    have hσ_tilde_m_rangeY : σ_tilde_x.base m_R_star ∈ Set.range i_Y.base := by
      rw [hRange_Y]
      have h1 := congrArg (fun f : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R) => (f.base m_R_star).asIdeal) hσ_tilde_g
      exact h1
    obtain ⟨q_x, hq_x_eq⟩ := hσ_tilde_m_rangeY
    have hqx_Z : q_x ∈ Z_set := by
      apply hZ_sub
      change i_Y.base q_x ∈ closure (j_P.base '' E_star)
      rw [hq_x_eq]
      have hsub_star : ({j_P.base x.1} : Set ↥C_R) ⊆ j_P.base '' E_star :=
        Set.singleton_subset_iff.mpr ⟨x.1, x.2.1, rfl⟩
      exact closure_mono hsub_star hσ_tilde_m_cl
    have hqx_Y' : q_x ∈ Y'_set := by
      apply hY'_sub E'_x hE'_x_mem
      change i_Y.base q_x ∈ closure (j_P.base '' E'_x)
      rw [hq_x_eq]
      have hsub_E' : ({j_P.base x.1} : Set ↥C_R) ⊆ j_P.base '' E'_x :=
        Set.singleton_subset_iff.mpr ⟨x.1, hx_E', rfl⟩
      exact closure_mono hsub_E' hσ_tilde_m_cl
    exact ⟨E'_x, σ_tilde_x, q_x, hE'_x_mem, hx_E', hσ_tilde_g, hσ_tilde_ptP, hq_x_eq, ⟨hqx_Z, hqx_Y'⟩⟩
  choose E'_fn σ_tilde_fn q_fn hE'_mem hx_E' hσ_tilde_g hσ_tilde_ptP hq_eq hq_ZY' using hPtPkg
  let f_sp : ↥Δ_P → ↥(Z_set ∩ Y'_set) := fun x => ⟨q_fn x, hq_ZY' x⟩
  refine ⟨f_sp, ?_⟩
  intro x₁ x₂ hf_eq
  have hq₁₂ : q_fn x₁ = q_fn x₂ := congrArg Subtype.val hf_eq
  obtain ⟨y₀, hy₀_fst, hRoof_y₀⟩ := hRoofTransport (q_fn x₁) (hRoof_Δ (q_fn x₁) (hq_ZY' x₁))
  have hm_spec : ∀ m_R : AlgebraicGeometry.Spec (CommRingCat.of R),
      m_R.asIdeal = IsLocalRing.maximalIdeal R →
      (σ_tilde_fn x₁).base m_R = (CategoryTheory.Limits.pullback.fst g_R s_res).base y₀ ∧
      (σ_tilde_fn x₂).base m_R = (CategoryTheory.Limits.pullback.fst g_R s_res).base y₀ := by
    intro m_R hm_R
    have hm_eq : m_R = m_R_star := PrimeSpectrum.ext hm_R
    rw [hm_eq, hy₀_fst, ← hq_eq x₁, hq₁₂, ← hq_eq x₂]
    exact ⟨rfl, rfl⟩
  let X_P_pb := CategoryTheory.Limits.pullback g_R η_R
  let Θ_P : X_P ≅ X_P_pb := hPb_P.isoPullback
  have hΘ_P_left : ∀ z : ↥X_P, Θ_P.inv.base (Θ_P.hom.base z) = z := fun z => by simp
  have hΘ_P_right : ∀ w : ↥X_P_pb, Θ_P.hom.base (Θ_P.inv.base w) = w := fun w => by simp
  have hIrredFwd : ∀ S : Set ↥X_P,
      S ∈ irreducibleComponents ↥X_P → Θ_P.hom.base '' S ∈ irreducibleComponents ↥X_P_pb := by
    intro S ⟨hSIrred, hSMax⟩
    refine ⟨hSIrred.image Θ_P.hom.base Θ_P.hom.continuous.continuousOn, ?_⟩
    intro T hTIrred hST
    have hSub : S ⊆ Θ_P.inv.base '' T := by
      intro z hz
      exact ⟨Θ_P.hom.base z, hST ⟨z, hz, rfl⟩, hΘ_P_left z⟩
    have hEq : Θ_P.inv.base '' T ⊆ S :=
      hSMax (hTIrred.image Θ_P.inv.base Θ_P.inv.continuous.continuousOn) hSub
    intro w hw
    exact ⟨Θ_P.inv.base w, hEq ⟨w, hw, rfl⟩, hΘ_P_right w⟩
  have hImgNe : ∀ (S₁ S₂ : Set ↥X_P), S₁ ≠ S₂ → Θ_P.hom.base '' S₁ ≠ Θ_P.hom.base '' S₂ := by
    intro S₁ S₂ hNe hEq
    apply hNe
    ext z
    constructor
    · intro hz
      have h1 : Θ_P.hom.base z ∈ Θ_P.hom.base '' S₂ := by
        rw [← hEq]
        exact ⟨z, hz, rfl⟩
      rcases h1 with ⟨z', hz', hz'eq⟩
      have hzz' : z' = z := by
        rw [← hΘ_P_left z', ← hΘ_P_left z, hz'eq]
      exact hzz' ▸ hz'
    · intro hz
      have h1 : Θ_P.hom.base z ∈ Θ_P.hom.base '' S₁ := by
        rw [hEq]
        exact ⟨z, hz, rfl⟩
      rcases h1 with ⟨z', hz', hz'eq⟩
      have hzz' : z' = z := by
        rw [← hΘ_P_left z', ← hΘ_P_left z, hz'eq]
      exact hzz' ▸ hz'
  let p_tilde₁ : ↥X_P_pb := Θ_P.hom.base x₁.1
  let p_tilde₂ : ↥X_P_pb := Θ_P.hom.base x₂.1
  have hp_tilde_fst : ∀ x : ↥Δ_P,
      (CategoryTheory.Limits.pullback.fst g_R η_R).base (Θ_P.hom.base x.1) =
        (η_R ≫ σ_tilde_fn x).base pt_P := by
    intro x
    have h1 := congrArg (fun f : X_P ⟶ C_R => f.base x.1) hPb_P.isoPullback_hom_fst
    exact h1.trans (hσ_tilde_ptP x).symm
  have hp_tilde_eq : p_tilde₁ = p_tilde₂ :=
    hNodalUnique_R hAlgResR y₀ hRoof_y₀ (σ_tilde_fn x₁) (σ_tilde_fn x₂)
      (hσ_tilde_g x₁) (hσ_tilde_g x₂) hm_spec
      p_tilde₁ p_tilde₂ ⟨pt_P, hp_tilde_fst x₁⟩ ⟨pt_P, hp_tilde_fst x₂⟩
      ⟨Θ_P.hom.base '' E_star, hIrredFwd E_star hE_star,
        Θ_P.hom.base '' E'_fn x₁, hIrredFwd (E'_fn x₁) (hE'_mem x₁).1,
        hImgNe E_star (E'_fn x₁) (Ne.symm (hE'_mem x₁).2),
        ⟨x₁.1, x₁.2.1, rfl⟩, ⟨x₁.1, hx_E' x₁, rfl⟩⟩
      ⟨Θ_P.hom.base '' E_star, hIrredFwd E_star hE_star,
        Θ_P.hom.base '' E'_fn x₂, hIrredFwd (E'_fn x₂) (hE'_mem x₂).1,
        hImgNe E_star (E'_fn x₂) (Ne.symm (hE'_mem x₂).2),
        ⟨x₂.1, x₂.2.1, rfl⟩, ⟨x₂.1, hx_E' x₂, rfl⟩⟩
  apply Subtype.ext
  rw [← hΘ_P_left x₁.1, ← hΘ_P_left x₂.1]
  exact congrArg Θ_P.inv.base hp_tilde_eq

theorem weil_sup1_intermediate_prime_caseB_bounds (K : Type u) [Field K] [IsSepClosed K]
    (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
