      let u := ρ₀ (Φ₀ Polynomial.X)
      let v := ρ₁ (Φ₁ Polynomial.X)
      have hu_pow : ρ₀ (Φ₀ (Polynomial.X ^ (i : ℕ))) = u ^ (i : ℕ) := by
        dsimp only [u]
        rw [map_pow, map_pow]
      have hv_pow : ρ₁ (Φ₁ (Polynomial.X ^ (d - (i : ℕ)))) = v ^ (d - (i : ℕ)) := by
        dsimp only [v]
        rw [map_pow, map_pow]
