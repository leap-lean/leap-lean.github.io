        _ = v_inv * algebraMap D R_loc (u_c * s_w.1 * d_r) := by
            rw [hds_r]; simp only [map_mul]
        _ = v_inv * algebraMap D R_loc (ψ₂ (Xbar i) * q_D) := by rw [hq_D]
        _ = x i * (v_inv * algebraMap D R_loc q_D) := by simp [x, map_mul]; ring
    have hSpan_inf : Ideal.span {x 0} ⊓ Ideal.span {x 1} = (⊥ : Ideal R_loc) := by
      rw [eq_bot_iff]
