    have hE_cov : E ≤ iSup U_covE := by
      calc
        E = E ⊓ ⊤ := (inf_top_eq E).symm
        _ = E ⊓ (V₀ ⊔ V₁) := by rw [← hCov]
        _ = U₀_E ⊔ U₁_E := inf_sup_left E V₀ V₁
        _ ≤ iSup U_covE := sup_le (le_iSup U_covE 0) (le_iSup U_covE 1)
    obtain ⟨σ, hσ, _⟩ := X.sheaf.existsUnique_gluing' U_covE E iUV hE_cov sf hCompat
    refine ⟨σ, ?_⟩
    have hσ0 : (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀_E ≤ E)).op).hom σ = s₀ :=
      hσ 0
    have hU₀E : Nonempty ↥U₀_E := hNonemptyInter E V₀ hE hNe0
    calc
      j_open E hE σ * algebraMap (Polynomial K) F_K P_b
          = j_open U₀_E hU₀E
              ((X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₀_E ≤ E)).op).hom σ) *
            j_open V₀ hNe0 (Φ₀ P_b) := by
          rw [hJ2 E U₀_E hE hU₀E inf_le_left σ, hJ3 P_b]
      _ = j_open U₀_E hU₀E s₀ * j_open U₀_E hU₀E d₀ := by
          rw [hσ0, ← hJ2 V₀ U₀_E hNe0 hU₀E inf_le_right (Φ₀ P_b)]
      _ = j_open U₀_E hU₀E (s₀ * d₀) := (map_mul (j_open U₀_E hU₀E) s₀ d₀).symm
      _ = j_open U₀_E hU₀E n₀ := by rw [hs₀_mul]
      _ = j_open V₀ hNe0 (Φ₀ (Polynomial.X ^ (i : ℕ))) :=
          hJ2 V₀ U₀_E hNe0 hU₀E inf_le_right _
      _ = algebraMap (Polynomial K) F_K (Polynomial.X ^ (i : ℕ)) :=
          hJ3 (Polynomial.X ^ (i : ℕ))

theorem weil_closedImmersion_into_proj_coprime_poly_and_pos_deg (K : Type u) [Field K]
    (M : ℕ) (h1M : 1 ≤ M)
    (hAffK : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen K M a))
    (c_K : ∀ a : Fin (M + 1),
      K →+* ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))))
    (t_K : ∀ a : Fin (M + 1), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen K M a))))
    (hCoordK : IsCommRingProjCoordSystem K M hAffK c_K t_K)
    (hcK_appLE : ∀ a : Fin (M + 1),
      CommRingCat.ofHom (c_K a) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          (weilProjectiveSpaceOver K M).hom.appLE ⊤ (weilProjBasicOpen K M a) le_top)
    (hGenK : ∀ (a : Fin (M + 1))
        (x : ↑((weilProjectiveSpaceOver K M).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K M a)))),
      ∃ (D : ℕ) (c : weilDegMonomialIdx M D → K),
        1 ≤ D ∧
        x = ∑ e : weilDegMonomialIdx M D,
          c_K a (c e) * ∏ μ : Fin (M + 1), (t_K a μ) ^ (e.1 μ : ℕ))
    (X : AlgebraicGeometry.Scheme.{u})
    (p : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    [IrreducibleSpace ↥X]
    (V₀ V₁ : X.Opens)
    (hAff0 : AlgebraicGeometry.IsAffineOpen V₀)
    (hAff1 : AlgebraicGeometry.IsAffineOpen V₁)
    (hCov : V₀ ⊔ V₁ = ⊤)
    (hNe0 : Nonempty ↥V₀)
    (hNe1 : Nonempty ↥V₁)
    (Φ₀ : Polynomial K ≃+* ↑(X.presheaf.obj (Opposite.op V₀)))
    (Φ₁ : Polynomial K ≃+* ↑(X.presheaf.obj (Opposite.op V₁)))
    (hRev : ∀ (d : ℕ) (P : Polynomial K),
      P.natDegree ≤ d →
      (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
          (Φ₁ (∑ j : Fin (d + 1),
            Polynomial.C (P.coeff (j : ℕ)) * Polynomial.X ^ (d - (j : ℕ)))) =
        ((X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom
            (Φ₁ Polynomial.X)) ^ d *
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom
            (Φ₀ P))
    (j_open : ∀ (U : X.Opens), Nonempty ↥U →
      ↑(X.presheaf.obj (Opposite.op U)) →+* FractionRing (Polynomial K))
    (hJ1 : ∀ (U : X.Opens) (hU : Nonempty ↥U), Function.Injective (j_open U hU))
    (hJ2 : ∀ (U V : X.Opens) (hU : Nonempty ↥U) (hV : Nonempty ↥V) (hle : V ≤ U)
        (s : ↑(X.presheaf.obj (Opposite.op U))),
      j_open V hV ((X.presheaf.map (CategoryTheory.homOfLE hle).op).hom s) =
        j_open U hU s)
    (hJ3 : ∀ P : Polynomial K,
      j_open V₀ hNe0 (Φ₀ P) =
        algebraMap (Polynomial K) (FractionRing (Polynomial K)) P)
    (hJ4 : ∀ (U : X.Opens) (hU : Nonempty ↥U) (c : K),
      j_open U hU
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
            p.appLE ⊤ U le_top).hom c) =
        algebraMap (Polynomial K) (FractionRing (Polynomial K)) (Polynomial.C c))
    (hJ5 : ∀ (E : X.Opens) (hE : Nonempty ↥E) (d : ℕ) (P_b : Polynomial K),
      P_b ≠ 0 →
      P_b.natDegree ≤ d →
      E ⊓ V₀ = X.basicOpen (Φ₀ P_b) →
      E ⊓ V₁ = X.basicOpen (Φ₁ (∑ j : Fin (d + 1),
        Polynomial.C (P_b.coeff (j : ℕ)) * Polynomial.X ^ (d - (j : ℕ)))) →
      ∀ i : Fin (d + 1),
        ∃ σ : ↑(X.presheaf.obj (Opposite.op E)),
          j_open E hE σ *
              algebraMap (Polynomial K) (FractionRing (Polynomial K)) P_b =
            algebraMap (Polynomial K) (FractionRing (Polynomial K))
              (Polynomial.X ^ (i : ℕ)))
    (ψ : X ⟶ (weilProjectiveSpaceOver K M).left)
    (hCl : AlgebraicGeometry.IsClosedImmersion ψ)
    (hComm : ψ ≫ (weilProjectiveSpaceOver K M).hom = p)
    (a₀ : Fin (M + 1))
    (hNe : Nonempty ↥((TopologicalSpace.Opens.map ψ.base).obj (weilProjBasicOpen K M a₀))) :
    let E_a₀ := (TopologicalSpace.Opens.map ψ.base).obj (weilProjBasicOpen K M a₀)
    let ξ : Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op E_a₀)) :=
      fun μ => (ψ.app (weilProjBasicOpen K M a₀)).hom (t_K a₀ μ)
    ∃ (P : Fin (M + 1) → Polynomial K) (d_E : ℕ),
      1 ≤ d_E ∧
      P a₀ ≠ 0 ∧
      (∀ μ : Fin (M + 1), (P μ).natDegree ≤ d_E) ∧
      (∃ μ_max : Fin (M + 1), (P μ_max).natDegree = d_E) ∧
      Ideal.span (Set.range P) = ⊤ ∧
      (∀ c : K,
        j_open E_a₀ hNe ((ψ.app (weilProjBasicOpen K M a₀)).hom (c_K a₀ c)) =
          algebraMap (Polynomial K) (FractionRing (Polynomial K)) (Polynomial.C c)) ∧
      (∀ μ : Fin (M + 1),
        j_open E_a₀ hNe (ξ μ) *
            algebraMap (Polynomial K) (FractionRing (Polynomial K)) (P a₀) =
          algebraMap (Polynomial K) (FractionRing (Polynomial K)) (P μ)) ∧
      (∀ (b : Fin (M + 1)), P b ≠ 0 → ∀ i : Fin (d_E + 1),
        ∃ (N : ℕ) (c : weilDegMonomialIdx M N → K),
          1 ≤ N ∧
          (P b) ^ (N - 1) * Polynomial.X ^ (i : ℕ) =
            ∑ e : weilDegMonomialIdx M N,
              Polynomial.C (c e) * ∏ μ : Fin (M + 1), (P μ) ^ (e.1 μ : ℕ)) :=
by
  classical
  have : AlgebraicGeometry.IsClosedImmersion ψ := hCl
  let F := FractionRing (Polynomial K)
  let ι : Polynomial K →+* F := algebraMap (Polynomial K) F
  have hInj_ι : Function.Injective ι := IsFractionRing.injective (Polynomial K) F
  let U_M : Fin (M + 1) → (weilProjectiveSpaceOver K M).left.Opens :=
    fun b => weilProjBasicOpen K M b
  let E : Fin (M + 1) → X.Opens :=
    fun b => (TopologicalSpace.Opens.map ψ.base).obj (U_M b)
  let η : ∀ b : Fin (M + 1), Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op (E b))) :=
    fun b μ => (ψ.app (U_M b)).hom (t_K b μ)
  
  have hInter : ∀ (U W : X.Opens), Nonempty ↥U → Nonempty ↥W → Nonempty ↥(U ⊓ W) := by
    intro U W ⟨⟨x, hx⟩⟩ ⟨⟨y, hy⟩⟩
    obtain ⟨z, hzU, hzW⟩ := nonempty_preirreducible_inter U.isOpen W.isOpen ⟨x, hx⟩ ⟨y, hy⟩
    exact ⟨⟨z, hzU, hzW⟩⟩
  have hCovE : (⨆ b : Fin (M + 1), E b) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : ψ.base x ∈ (⊤ : (weilProjectiveSpaceOver K M).left.Opens) := trivial
    rw [← hCoordK.2.1, TopologicalSpace.Opens.mem_iSup] at hx
    rcases hx with ⟨b, hb⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨b, hb⟩
  have hAffE : ∀ b : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (E b) :=
    fun b => (hAffK b).preimage ψ
  have hBasicη : ∀ b μ : Fin (M + 1), X.basicOpen (η b μ) = E b ⊓ E μ := by
    intro b μ
    dsimp [η, E, U_M]
    rw [← AlgebraicGeometry.Scheme.Hom.preimage_basicOpen ψ (t_K b μ),
      hCoordK.2.2.2.2.2.2.2.1 b μ]
    rfl
  have hη_diag : η a₀ a₀ = 1 := by
    dsimp [η, U_M]
    rw [hCoordK.2.2.2.2.1 a₀, map_one]
  have hScalarAll : ∀ (b : Fin (M + 1)) (hEb : Nonempty ↥(E b)) (c : K),
      j_open (E b) hEb ((ψ.app (U_M b)).hom (c_K b c)) = ι (Polynomial.C c) := by
    intro b hEb c
    have hEq_p : ∀ (q : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K)) (hq : q = p) (e),
        q.appLE ⊤ (E b) e = p.appLE ⊤ (E b) le_top := by
      rintro _ rfl _
      rfl
    have hComp : CommRingCat.ofHom (c_K b) ≫ ψ.app (U_M b) =
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          p.appLE ⊤ (E b) le_top := by
      rw [hcK_appLE b, ψ.app_eq_appLE, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE ψ (weilProjectiveSpaceOver K M).hom
          ⊤ (U_M b) (E b) le_top le_rfl,
        hEq_p (ψ ≫ (weilProjectiveSpaceOver K M).hom) hComm]
    have hEval : (ψ.app (U_M b)).hom (c_K b c) =
        (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          p.appLE ⊤ (E b) le_top).hom c) :=
      ConcreteCategory.congr_hom hComp c
    rw [hEval]
    exact hJ4 (E b) hEb c
  
  let z : Fin (M + 1) → F := fun μ => j_open (E a₀) hNe (η a₀ μ)
  have hz₀ : z a₀ = 1 := by
    dsimp [z]
    rw [hη_diag, map_one]
  obtain ⟨P, d_E, μ_max, A, hPa₀, hDegLE, hμ_max, hCoprime, hBezoutA, hRatio⟩ :
      ∃ (P : Fin (M + 1) → Polynomial K) (d_E : ℕ) (μ_max : Fin (M + 1))
        (A : Fin (M + 1) → Polynomial K),
        P a₀ ≠ 0 ∧
        (∀ μ : Fin (M + 1), (P μ).natDegree ≤ d_E) ∧
        (P μ_max).natDegree = d_E ∧
        Ideal.span (Set.range P) = ⊤ ∧
        (∑ μ : Fin (M + 1), A μ * P μ = 1) ∧
        (∀ μ : Fin (M + 1), z μ * ι (P a₀) = ι (P μ)) := by
    revert hz₀
    generalize (z : Fin (M + 1) → F) = z_vec
    intro hz_vec₀
    have hSurj_z : ∀ μ : Fin (M + 1),
        ∃ pair : Polynomial K × nonZeroDivisors (Polynomial K),
          z_vec μ * ι pair.2.1 = ι pair.1 :=
      fun μ => IsLocalization.surj (nonZeroDivisors (Polynomial K)) (z_vec μ)
    choose p_ pair_eq using hSurj_z
    have hp2_ne : ∀ ν : Fin (M + 1), (p_ ν).2.1 ≠ 0 :=
      fun ν => mem_nonZeroDivisors_iff_ne_zero.mp (p_ ν).2.2
    let D_raw : Polynomial K := ∏ ν : Fin (M + 1), (p_ ν).2.1
    have hD_raw_ne : D_raw ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun ν _ => hp2_ne ν)
    let Q_tilde : Fin (M + 1) → Polynomial K :=
      fun μ => (p_ μ).1 * ∏ ν ∈ Finset.univ.erase μ, (p_ ν).2.1
    have hz_Draw : ∀ μ : Fin (M + 1), z_vec μ * ι D_raw = ι (Q_tilde μ) := by
      intro μ
      have hErase : (p_ μ).2.1 * (∏ ν ∈ Finset.univ.erase μ, (p_ ν).2.1) = D_raw :=
        Finset.mul_prod_erase Finset.univ (fun ν => (p_ ν).2.1) (Finset.mem_univ μ)
      calc
        z_vec μ * ι D_raw
          = z_vec μ * (ι (p_ μ).2.1 * ι (∏ ν ∈ Finset.univ.erase μ, (p_ ν).2.1)) := by
              rw [← hErase, map_mul]
        _ = (z_vec μ * ι (p_ μ).2.1) * ι (∏ ν ∈ Finset.univ.erase μ, (p_ ν).2.1) := by ring
        _ = ι (p_ μ).1 * ι (∏ ν ∈ Finset.univ.erase μ, (p_ ν).2.1) := by rw [pair_eq μ]
        _ = ι (Q_tilde μ) := by rw [← map_mul]
    have hQa₀_eq : Q_tilde a₀ = D_raw := by
      apply hInj_ι
      have h0 := hz_Draw a₀
      rw [hz_vec₀, one_mul] at h0
      exact h0.symm
    have hQa₀_ne : Q_tilde a₀ ≠ 0 := hQa₀_eq.symm ▸ hD_raw_ne
    let J : Ideal (Polynomial K) := Ideal.span (Set.range Q_tilde)
    let h_gen : Polynomial K := Submodule.IsPrincipal.generator J
    have hSpan_gen : Ideal.span ({h_gen} : Set (Polynomial K)) = J :=
      Submodule.IsPrincipal.span_singleton_generator J
    have hDiv_Q : ∀ μ : Fin (M + 1), ∃ P_μ : Polynomial K, Q_tilde μ = h_gen * P_μ := by
      intro μ
      have hMem : Q_tilde μ ∈ Ideal.span ({h_gen} : Set (Polynomial K)) := by
        rw [hSpan_gen]
        exact Ideal.subset_span ⟨μ, rfl⟩
      exact Ideal.mem_span_singleton.mp hMem
    choose P hP_mul using hDiv_Q
    have hh_ne : h_gen ≠ 0 := fun hh0 => hQa₀_ne (by rw [hP_mul a₀, hh0, zero_mul])
    have hPa₀ : P a₀ ≠ 0 := fun hP0 => hQa₀_ne (by rw [hP_mul a₀, hP0, mul_zero])
    have hGen_mem : h_gen ∈ J := by
      rw [← hSpan_gen]
      exact Ideal.subset_span rfl
    obtain ⟨A, hA_sum⟩ := Ideal.mem_span_range_iff_exists_fun.mp hGen_mem
    have hBezoutA : ∑ μ : Fin (M + 1), A μ * P μ = 1 := by
      apply mul_right_cancel₀ hh_ne
      calc
        (∑ μ : Fin (M + 1), A μ * P μ) * h_gen
          = ∑ μ : Fin (M + 1), A μ * (h_gen * P μ) := by
              rw [Finset.sum_mul]
              refine Finset.sum_congr rfl fun μ _ => by ring
        _ = ∑ μ : Fin (M + 1), A μ * Q_tilde μ := by
              refine Finset.sum_congr rfl fun μ _ => by rw [← hP_mul μ]
        _ = 1 * h_gen := by rw [hA_sum, one_mul]
    have hCoprime : Ideal.span (Set.range P) = ⊤ := by
      rw [Ideal.eq_top_iff_one, Ideal.mem_span_range_iff_exists_fun]
      exact ⟨A, hBezoutA⟩
    have hRatio : ∀ μ : Fin (M + 1), z_vec μ * ι (P a₀) = ι (P μ) := by
      intro μ
      have hιh_ne : ι h_gen ≠ 0 := fun h0 => hh_ne (hInj_ι (h0.trans (map_zero ι).symm))
      apply mul_left_cancel₀ hιh_ne
      calc
        ι h_gen * (z_vec μ * ι (P a₀))
          = z_vec μ * ι (h_gen * P a₀) := by rw [map_mul]; ring
        _ = z_vec μ * ι D_raw := by rw [← hP_mul a₀, hQa₀_eq]
        _ = ι (Q_tilde μ) := hz_Draw μ
        _ = ι h_gen * ι (P μ) := by rw [hP_mul μ, map_mul]
    let d_E : ℕ := Finset.univ.sup (fun μ : Fin (M + 1) => (P μ).natDegree)
    have hDegLE : ∀ μ : Fin (M + 1), (P μ).natDegree ≤ d_E :=
      fun μ => Finset.le_sup (f := fun ν : Fin (M + 1) => (P ν).natDegree) (Finset.mem_univ μ)
    obtain ⟨μ_max, _, hμ_max⟩ :=
      Finset.exists_mem_eq_sup Finset.univ Finset.univ_nonempty
        (fun μ : Fin (M + 1) => (P μ).natDegree)
    exact ⟨P, d_E, μ_max, A, hPa₀, hDegLE, hμ_max.symm, hCoprime, hBezoutA, hRatio⟩
  have hDegEq : ∃ μ_m : Fin (M + 1), (P μ_m).natDegree = d_E := ⟨μ_max, hμ_max⟩
  
  have hRatioAll : ∀ (b : Fin (M + 1)) (hEb : Nonempty ↥(E b)) (μ : Fin (M + 1)),
      j_open (E b) hEb (η b μ) * ι (P b) = ι (P μ) := by
    intro b hEb μ
    have hE0b : Nonempty ↥(E a₀ ⊓ E b) := hInter (E a₀) (E b) hNe hEb
    have hC10 := hCoordK.2.2.2.2.2.2.2.2.2 a₀ b μ
    let U0 := U_M a₀
    let Ub := U_M b
    have hNatL := ψ.naturality (CategoryTheory.homOfLE (inf_le_left : U0 ⊓ Ub ≤ U0)).op
    have hNatR := ψ.naturality (CategoryTheory.homOfLE (inf_le_right : U0 ⊓ Ub ≤ Ub)).op
    have hL : ∀ s,
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : E a₀ ⊓ E b ≤ E a₀)).op).hom
          ((ψ.app U0).hom s) =
        (ψ.app (U0 ⊓ Ub)).hom
          (((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U0 ⊓ Ub ≤ U0)).op).hom s) :=
      fun s => ConcreteCategory.congr_hom hNatL.symm s
    have hR : ∀ s,
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : E a₀ ⊓ E b ≤ E b)).op).hom
          ((ψ.app Ub).hom s) =
        (ψ.app (U0 ⊓ Ub)).hom
          (((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : U0 ⊓ Ub ≤ Ub)).op).hom s) :=
      fun s => ConcreteCategory.congr_hom hNatR.symm s
    have hMul :
        (ψ.app (U0 ⊓ Ub)).hom
          (((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_right : U0 ⊓ Ub ≤ Ub)).op).hom (t_K b μ)) *
        (ψ.app (U0 ⊓ Ub)).hom
          (((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U0 ⊓ Ub ≤ U0)).op).hom (t_K a₀ b)) =
        (ψ.app (U0 ⊓ Ub)).hom
          (((weilProjectiveSpaceOver K M).left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U0 ⊓ Ub ≤ U0)).op).hom (t_K a₀ μ)) := by
      rw [← map_mul, hC10]
    have hOv :
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : E a₀ ⊓ E b ≤ E b)).op).hom
          (η b μ) *
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : E a₀ ⊓ E b ≤ E a₀)).op).hom
          (η a₀ b) =
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : E a₀ ⊓ E b ≤ E a₀)).op).hom
          (η a₀ μ) :=
      (congrArg₂ (· * ·) (hR (t_K b μ)) (hL (t_K a₀ b))).trans
        (hMul.trans (hL (t_K a₀ μ)).symm)
    have hjOv : j_open (E b) hEb (η b μ) * z b = z μ := by
      have h_ap := congrArg (j_open (E a₀ ⊓ E b) hE0b) hOv
      rw [map_mul,
        hJ2 (E b) (E a₀ ⊓ E b) hEb hE0b inf_le_right,
        hJ2 (E a₀) (E a₀ ⊓ E b) hNe hE0b inf_le_left,
        hJ2 (E a₀) (E a₀ ⊓ E b) hNe hE0b inf_le_left] at h_ap
      exact h_ap
    calc
      j_open (E b) hEb (η b μ) * ι (P b)
        = j_open (E b) hEb (η b μ) * (z b * ι (P a₀)) := by rw [← hRatio b]
      _ = (j_open (E b) hEb (η b μ) * z b) * ι (P a₀) := by ring
      _ = z μ * ι (P a₀) := by rw [hjOv]
      _ = ι (P μ) := hRatio μ
  
  have hCutUniv : ∀ (V : X.Opens) (f : Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op V))),
      (∃ B_V : Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op V)),
        ∑ μ : Fin (M + 1), B_V μ * f μ = 1) →
      (∀ (β μ : Fin (M + 1)), Nonempty ↥(E β) →
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : E β ⊓ V ≤ E β)).op).hom (η β μ) *
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : E β ⊓ V ≤ V)).op).hom (f β) =
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : E β ⊓ V ≤ V)).op).hom (f μ)) →
      ∀ b : Fin (M + 1), E b ⊓ V = X.basicOpen (f b) := by
    intro V f ⟨B_V, hBV⟩ hCoc b
    apply le_antisymm
    · intro x hx
      have hEb : Nonempty ↥(E b) := ⟨⟨x, hx.1⟩⟩
      let res_E := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : E b ⊓ V ≤ E b)).op).hom
      let res_V := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : E b ⊓ V ≤ V)).op).hom
      have hInvEq :
          res_V (f b) * (∑ μ : Fin (M + 1), res_V (B_V μ) * res_E (η b μ)) = 1 := by
        calc
          res_V (f b) * (∑ μ : Fin (M + 1), res_V (B_V μ) * res_E (η b μ))
