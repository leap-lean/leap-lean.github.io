      (↑R₁ ⧸ I₁_P) φ₁_R (Ideal.Quotient.mk I₁_P t₀) hFin₁_R ψ₁_R hOpen₁ hψ₁_g E hE hMeet₁
    have hy_top : fst_R.base (i_Y.base y) ∈ (V₀ ⊔ V₁ : C.Opens) := by
      rw [hCov]
      trivial
    rcases (hy_top : fst_R.base (i_Y.base y) ∈ (V₀ : Set C) ∪ (V₁ : Set C)) with hy₀ | hy₁
    · have hy_range₀ : i_Y.base y ∈ Set.range ψ₀_R.base := by
        rw [hRange₀]
        exact hy₀
      exact hFE_cov y hy (↑R₀ ⧸ I₀_P) φ₀_R (Ideal.Quotient.mk I₀_P h₀)
        ψ₀_R hFin₀_R hOpen₀ hψ₀_g hy_range₀ hInj₀
    · have hy_range₁ : i_Y.base y ∈ Set.range ψ₁_R.base := by
        rw [hRange₁]
        exact hy₁
      exact hFE_cov y hy (↑R₁ ⧸ I₁_P) φ₁_R (Ideal.Quotient.mk I₁_P t₀)
        ψ₁_R hFin₁_R hOpen₁ hψ₁_g hy_range₁ hInj₁
  exact ⟨j_P, i_Y, ψ₀_R, ψ₁_R, φ₀_R, φ₁_R,
    hj_P_fst, hPb_P, hOpen_P, hRange_P,
    hi_Y_fst, hPb_Y, hCl_Y, hRange_Y,
    hOpen₀, hRange₀, hψ₀_g, hφ₀_comp, hFin₀_R, hBasic₀_R,
    hOpen₁, hRange₁, hψ₁_g, hφ₁_comp, hFin₁_R, hSwitch,
    hSmUnique, hGoingDown⟩

theorem weil_quotientBase_curve_valuative_section_and_nodal_inj (R : Type u) [CommRing R] [IsDomain R] [HenselianLocalRing R]
    (hICR : IsIntegrallyClosed R)
    (k_P : Type u) [Field k_P] [IsAlgClosed k_P] [Algebra R k_P] [IsFractionRing R k_P]
    (hVal_kP : ∀ x : k_P,
      (∃ r : R, algebraMap R k_P r = x) ∨ (x ≠ 0 ∧ ∃ r : R, algebraMap R k_P r = x⁻¹))
    (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (ρ₀ : R →+* k₀) (hSurj₀ : Function.Surjective ρ₀)
    (hKer₀ : RingHom.ker ρ₀ = IsLocalRing.maximalIdeal R)
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat_R : AlgebraicGeometry.Flat g_R)
    (hProp_R : AlgebraicGeometry.IsProper g_R)
    (hLFP_R : AlgebraicGeometry.LocallyOfFinitePresentation g_R)
    (X_P Y : AlgebraicGeometry.Scheme.{u})
    (j_P : X_P ⟶ C_R)
    (p_P : X_P ⟶ AlgebraicGeometry.Spec (CommRingCat.of k_P))
    (i_Y : Y ⟶ C_R)
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    (hPb_P : CategoryTheory.IsPullback j_P p_P g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P))))
    (hPb_Y : CategoryTheory.IsPullback i_Y p_Y g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₀)))
    (hCl_Y : AlgebraicGeometry.IsClosedImmersion i_Y)
    (hRange_Y : Set.range i_Y.base = {x : C_R | (g_R.base x).asIdeal = IsLocalRing.maximalIdeal R})
    (B₀ B₁ : Type u) [CommRing B₀] [CommRing B₁]
    (φ₀_R : R →+* B₀) (φ₁_R : R →+* B₁)
    (ψ₀_R : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C_R)
    (ψ₁_R : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ C_R)
    (hOpen₀ : AlgebraicGeometry.IsOpenImmersion ψ₀_R)
    (hOpen₁ : AlgebraicGeometry.IsOpenImmersion ψ₁_R)
    (hCov_R : Set.range ψ₀_R.base ∪ Set.range ψ₁_R.base = Set.univ)
    (hψ₀_g : ψ₀_R ≫ g_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀_R))
    (hψ₁_g : ψ₁_R ≫ g_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁_R))
    (h₀_B : B₀) (t₀_B : B₁)
    (hFin₀_B : (Polynomial.eval₂RingHom φ₀_R h₀_B).Finite)
    (hFin₁_B : (Polynomial.eval₂RingHom φ₁_R t₀_B).Finite)
    (hZero₀ : ∀ p₀ : AlgebraicGeometry.Spec (CommRingCat.of B₀),
      ψ₀_R.base p₀ ∉ Set.range ψ₁_R.base → h₀_B ∈ p₀.asIdeal)
    (hSwitch : ∀ (ev₁ : B₁ →+* k_P),
      ev₁.comp φ₁_R = algebraMap R k_P →
      ev₁ t₀_B ≠ 0 →
      ∃ (ev₀ : B₀ →+* k_P),
        ev₀.comp φ₀_R = algebraMap R k_P ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ ψ₀_R =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₁) ≫ ψ₁_R ∧
        ev₀ h₀_B * ev₁ t₀_B = 1)
    (hSemi_P : ∀ y : ↥X_P,
      (∃ V_sm : X_P.Opens, y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_P)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ X_P)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k_P ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k_P) *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) k_P)}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) k_P) ∈
          (e₂.base u₀).asIdeal) ∧
        e₁ ≫ p_P =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : k_P →+* MvPolynomial (Fin 2) k_P)))))
    (hEtaleStalkDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
      [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B] (q : Ideal B) [q.IsPrime],
      IsDomain (Localization.AtPrime q))
    (hNodalUnique_R :
      IsAlgClosed (IsLocalRing.ResidueField R) →
      ∀ (y₀ : ↥(CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
        (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
            (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_R
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
            (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ Ideal.span
                {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) *
                  (MvPolynomial.X 1 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))} ))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y₀ ∧
          (∀ i : Fin 2,
            Ideal.Quotient.mk _
              (MvPolynomial.X i : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) ∈
              (e₂.base u₀).asIdeal) ∧
          e₁ ≫ CategoryTheory.Limits.pullback.snd g_R
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
                (MvPolynomial.C :
                  IsLocalRing.ResidueField R →+*
                    MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))))) →
        ∀ (σ₁ σ₂ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R),
          σ₁ ≫ g_R = 𝟙 _ →
          σ₂ ≫ g_R = 𝟙 _ →
          (∀ m_R : AlgebraicGeometry.Spec (CommRingCat.of R),
            m_R.asIdeal = IsLocalRing.maximalIdeal R →
            σ₁.base m_R =
              (CategoryTheory.Limits.pullback.fst g_R
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ ∧
            σ₂.base m_R =
              (CategoryTheory.Limits.pullback.fst g_R
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀) →
          ∀ (p₁ p₂ : ↥(CategoryTheory.Limits.pullback g_R
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P))))),
            (∃ pt₁ : AlgebraicGeometry.Spec (CommRingCat.of k_P),
              (CategoryTheory.Limits.pullback.fst g_R
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)))).base p₁ =
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)) ≫ σ₁).base pt₁) →
            (∃ pt₂ : AlgebraicGeometry.Spec (CommRingCat.of k_P),
              (CategoryTheory.Limits.pullback.fst g_R
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)))).base p₂ =
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)) ≫ σ₂).base pt₂) →
            (∃ E₁ ∈ irreducibleComponents
                ↥(CategoryTheory.Limits.pullback g_R
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)))),
              ∃ E₂ ∈ irreducibleComponents
                ↥(CategoryTheory.Limits.pullback g_R
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)))),
                E₁ ≠ E₂ ∧ p₁ ∈ E₁ ∧ p₁ ∈ E₂) →
            (∃ E₁ ∈ irreducibleComponents
                ↥(CategoryTheory.Limits.pullback g_R
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)))),
              ∃ E₂ ∈ irreducibleComponents
                ↥(CategoryTheory.Limits.pullback g_R
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)))),
                E₁ ≠ E₂ ∧ p₂ ∈ E₁ ∧ p₂ ∈ E₂) →
            p₁ = p₂) :
    (irreducibleComponents ↥X_P).Finite ∧
    ∀ (E_star : Set ↥X_P), E_star ∈ irreducibleComponents ↥X_P →
    ∀ (Z_set Y'_set : Set ↥Y),
      i_Y.base ⁻¹' closure (j_P.base '' E_star) ⊆ Z_set →
      (∀ E' ∈ (irreducibleComponents ↥X_P) \ {E_star},
        i_Y.base ⁻¹' closure (j_P.base '' E') ⊆ Y'_set) →
      (∀ q ∈ Z_set ∩ Y'_set,
        ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ Y)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k₀) *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) k₀)}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = q ∧
          (∀ i : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) k₀) ∈
              (e₂.base u₀).asIdeal) ∧
          e₁ ≫ p_Y =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
                (MvPolynomial.C : k₀ →+* MvPolynomial (Fin 2) k₀)))) →
      ∃ f_sp : ↥(E_star ∩ (⋃ E' ∈ (irreducibleComponents ↥X_P) \ {E_star}, E')) →
          ↥(Z_set ∩ Y'_set),
        Function.Injective f_sp :=
by
  classical
  
  have hProp_P : AlgebraicGeometry.IsProper p_P :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_P hProp_R
  have hLFP_P : AlgebraicGeometry.LocallyOfFinitePresentation p_P :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_P hLFP_R
  
  haveI : AlgebraicGeometry.IsLocallyNoetherian X_P :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_P
  haveI : CompactSpace ↥X_P :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_P
  haveI : AlgebraicGeometry.IsNoetherian X_P :=
    (AlgebraicGeometry.isNoetherian_iff X_P).mpr ⟨inferInstance, inferInstance⟩
  have hFinComp_P : (irreducibleComponents ↥X_P).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
  refine ⟨hFinComp_P, ?_⟩
  
  let pt_P : AlgebraicGeometry.Spec (CommRingCat.of k_P) := ⟨⊥, inferInstance⟩
  have hSpec_kP_eq_bot : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k_P), pt.asIdeal = ⊥ := by
    intro pt
    rw [Submodule.eq_bot_iff]
    intro c hc
    by_contra hc0
    have h1 : (1 : k_P) ∈ pt.asIdeal := by
      have : c * c⁻¹ = 1 := mul_inv_cancel₀ hc0
      rw [← this]
      exact pt.asIdeal.mul_mem_right c⁻¹ hc
    exact pt.isPrime.ne_top ((Ideal.eq_top_iff_one pt.asIdeal).mpr h1)
  have hSpec_kP_sub : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k_P), pt = pt_P := by
    intro pt
    exact PrimeSpectrum.ext (hSpec_kP_eq_bot pt)
  
  have hSec_P : ∀ (p : ↥X_P) (E₁ E₂ : Set ↥X_P),
      E₁ ∈ irreducibleComponents ↥X_P →
      E₂ ∈ irreducibleComponents ↥X_P →
      E₁ ≠ E₂ →
      p ∈ E₁ →
      p ∈ E₂ →
      ∃ σ_p : AlgebraicGeometry.Spec (CommRingCat.of k_P) ⟶ X_P,
        σ_p ≫ p_P = 𝟙 _ ∧
        ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of k_P), σ_p.base pt = p := by
    intro p E₁ E₂ hE₁ hE₂ hE₁₂ hp₁ hp₂
    have hNotSm : ¬ ∃ V_sm : X_P.Opens,
        p ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_P) := by
      rintro ⟨V_sm, hp_Vsm, hSm⟩
      let x₀ : ↥V_sm.toScheme := ⟨p, hp_Vsm⟩
      obtain ⟨U, _hU, V, hV, hx₀_V, e_UV, hStdSm⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (V_sm.ι ≫ p_P)).mp hSm x₀
      have hU_top : U = ⊤ := by
        ext pt
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        have hpt : pt = (V_sm.ι ≫ p_P).base x₀ :=
          (hSpec_kP_sub pt).trans (hSpec_kP_sub _).symm
        rw [hpt]
        exact e_UV hx₀_V
      let U₀_cat := (AlgebraicGeometry.Spec (CommRingCat.of k_P)).presheaf.obj (Opposite.op U)
      let B_cat := V_sm.toScheme.presheaf.obj (Opposite.op V)
      let isoU₀ : CommRingCat.of k_P ≅ U₀_cat :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k_P)).symm ≪≫
          ((AlgebraicGeometry.Spec (CommRingCat.of k_P)).presheaf.mapIso
            (eqToIso (by rw [hU_top])))
      let e_U₀ : k_P ≃+* ↑U₀_cat := isoU₀.commRingCatIsoToRingEquiv
      obtain ⟨g₁, _hg₁_C, hg₁_et⟩ := hStdSm.exists_etale_mvPolynomial
      let α_eq : Polynomial k_P ≃+* MvPolynomial (Fin 1) ↑U₀_cat :=
        (MvPolynomial.uniqueAlgEquiv k_P (Fin 1)).symm.toRingEquiv.trans
          (MvPolynomial.mapEquiv (Fin 1) e_U₀)
      have hα_et : α_eq.toRingHom.Etale := RingHom.Etale.of_bijective α_eq.bijective
      let g_poly : Polynomial k_P →+* ↑B_cat := g₁.comp α_eq.toRingHom
      have hg_poly_et : g_poly.Etale :=
        RingHom.Etale.stableUnderComposition α_eq.toRingHom g₁ hα_et hg₁_et
      letI : Algebra (Polynomial k_P) ↑B_cat := g_poly.toAlgebra
      haveI : Algebra.Etale (Polynomial k_P) ↑B_cat :=
        RingHom.etale_algebraMap.mp hg_poly_et
      let ψ_B : AlgebraicGeometry.Spec B_cat ⟶ X_P := hV.fromSpec ≫ V_sm.ι
      have hx₀_range : x₀ ∈ Set.range hV.fromSpec.base := by
        rw [hV.range_fromSpec]
        exact hx₀_V
      obtain ⟨q, hq_x₀⟩ := hx₀_range
      have hq_p : ψ_B.base q = p := by
        change V_sm.ι.base (hV.fromSpec.base q) = p
        rw [hq_x₀]
        rfl
      let q_pt : PrimeSpectrum ↑B_cat := q
      haveI : q_pt.asIdeal.IsPrime := q_pt.isPrime
      haveI hDom_q : IsDomain (Localization.AtPrime q_pt.asIdeal) :=
        @hEtaleStalkDom (Polynomial k_P) (↑B_cat) _ _ _ _ _ _ q_pt.asIdeal q_pt.isPrime
      let P₀ : Ideal ↑B_cat := Ideal.comap (algebraMap (↑B_cat) (Localization.AtPrime q_pt.asIdeal)) ⊥
      have hP₀_prime : P₀.IsPrime :=
        Ideal.IsPrime.comap (algebraMap (↑B_cat) (Localization.AtPrime q_pt.asIdeal))
      let p₀ : AlgebraicGeometry.Spec B_cat := ⟨P₀, hP₀_prime⟩
      have hP₀_min : ∀ (I : Ideal ↑B_cat) [I.IsPrime], I ≤ q_pt.asIdeal → P₀ ≤ I := by
        intro I hI hIq b hb
        have hb0 : algebraMap (↑B_cat) (Localization.AtPrime q_pt.asIdeal) b = 0 := hb
        rw [IsLocalization.map_eq_zero_iff q_pt.asIdeal.primeCompl] at hb0
        obtain ⟨⟨s, hs⟩, hsb⟩ := hb0
        have hmul : s * b ∈ I := by
          change s * b = 0 at hsb
          rw [hsb]
          exact I.zero_mem
        exact (hI.mem_or_mem hmul).resolve_left (fun hsI => hs (hIq hsI))
      have hEqComp : ∀ E ∈ irreducibleComponents ↥X_P,
          ψ_B.base q ∈ E → E = closure ({ψ_B.base p₀} : Set ↥X_P) := by
        intro E hE hqE
        have hClE : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
        have hGen : IsGenericPoint hE.1.genericPoint E := hE.1.isGenericPoint_genericPoint hClE
        have hη_mem : hE.1.genericPoint ∈ Set.range ψ_B.base := by
          by_contra hNot
          have hClCompl : IsClosed ((Set.range ψ_B.base)ᶜ) :=
            ψ_B.isOpenEmbedding.isOpen_range.isClosed_compl
          have hSub : E ⊆ (Set.range ψ_B.base)ᶜ := by
            rw [← hGen.def]
            exact hClCompl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hNot)
          exact hSub hqE ⟨q, rfl⟩
        obtain ⟨r_E, hr_E⟩ := hη_mem
        let r_pt : PrimeSpectrum ↑B_cat := r_E
        haveI : r_pt.asIdeal.IsPrime := r_pt.isPrime
        have hq_cl_r : q ∈ closure ({r_E} : Set (AlgebraicGeometry.Spec B_cat)) := by
          have himg : ψ_B.base q ∈ closure (ψ_B.base '' ({r_E} : Set _)) := by
            rw [Set.image_singleton, hr_E, hGen.def]
            exact hqE
          rw [ψ_B.isOpenEmbedding.isEmbedding.closure_eq_preimage_closure_image]
          exact himg
        have hr_le_q : r_pt.asIdeal ≤ q_pt.asIdeal :=
          (PrimeSpectrum.le_iff_mem_closure r_pt q_pt).mpr hq_cl_r
        have hP₀_le_r : P₀ ≤ r_pt.asIdeal := hP₀_min r_pt.asIdeal hr_le_q
        have hr_cl_p₀ : r_E ∈ closure ({p₀} : Set (AlgebraicGeometry.Spec B_cat)) :=
          (PrimeSpectrum.le_iff_mem_closure p₀ r_pt).mp hP₀_le_r
        have hη_cl : hE.1.genericPoint ∈ closure ({ψ_B.base p₀} : Set ↥X_P) := by
          rw [← hr_E, ← Set.image_singleton]
          exact image_closure_subset_closure_image ψ_B.continuous ⟨r_E, hr_cl_p₀, rfl⟩
        have hSub₁ : E ⊆ closure ({ψ_B.base p₀} : Set ↥X_P) := by
          rw [← hGen.def]
          exact isClosed_closure.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hη_cl)
        have hSub₂ : closure ({ψ_B.base p₀} : Set ↥X_P) ⊆ E :=
          hE.2 isIrreducible_singleton.closure hSub₁
        exact Set.Subset.antisymm hSub₁ hSub₂
      rw [← hq_p] at hp₁ hp₂
      exact hE₁₂ ((hEqComp E₁ hE₁ hp₁).trans (hEqComp E₂ hE₂ hp₂).symm)
    obtain ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀_p, hXi, he_comm⟩ :=
      (hSemi_P p).resolve_left hNotSm
    let I_nod : Ideal (MvPolynomial (Fin 2) k_P) :=
      Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k_P) * MvPolynomial.X 1}
    let A_nod := MvPolynomial (Fin 2) k_P ⧸ I_nod
    let c_nod : k_P →+* A_nod := (Ideal.Quotient.mk I_nod).comp MvPolynomial.C
    have hev₀₀_rel : ∀ a ∈ I_nod, (MvPolynomial.eval (0 : Fin 2 → k_P)) a = 0 := by
      intro F hF
      rw [Ideal.mem_span_singleton] at hF
      rcases hF with ⟨G, rfl⟩
      simp
    let ev₀₀ : A_nod →+* k_P :=
      Ideal.Quotient.lift I_nod (MvPolynomial.eval 0) hev₀₀_rel
    have hev₀₀_c : ev₀₀.comp c_nod = RingHom.id k_P := by
      ext c
      change Ideal.Quotient.lift I_nod (MvPolynomial.eval 0) hev₀₀_rel
