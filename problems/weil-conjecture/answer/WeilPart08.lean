        have h1 : hAff.fromSpec.base Q₁ ∈ Set.range hAff.fromSpec.base := ⟨Q₁, rfl⟩
        have h2 : hAff.fromSpec.base Q₂ ∈ Set.range hAff.fromSpec.base := ⟨Q₂, rfl⟩
        rw [hAff.range_fromSpec, hW_eq, Set.mem_singleton_iff] at h1 h2
