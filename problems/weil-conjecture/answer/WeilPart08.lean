        hT₀_comp.1.image Subtype.val continuous_subtype_val.continuousOn
      have hT_closed : IsClosed T := by
        obtain ⟨U_cl, hU_cl, hT₀_pre⟩ := isClosed_induced_iff.mp hT₀_closed
        have hT_eq : T = U_cl ∩ F_E := by
          ext w
          simp only [T, Set.mem_image, Subtype.exists, ← hT₀_pre, Set.mem_preimage,
            Set.mem_inter_iff]
          constructor
          · rintro ⟨a, haFE, haU, rfl⟩
            exact ⟨haU, haFE⟩
          · rintro ⟨hwU, hwFE⟩
            exact ⟨w, hwFE, hwU, rfl⟩
        rw [hT_eq]
        exact hU_cl.inter hFE_closed
      have hT_max : ∀ S : Set ↥Y, IsIrreducible S → S ⊆ F_E → T ⊆ S → S ⊆ T := by
        intro S hS_irred hS_FE hTS
        let S₀ : Set ↥F_E := Subtype.val ⁻¹' S
        have hT₀_S₀ : T₀ ⊆ S₀ := by
          intro z hz
