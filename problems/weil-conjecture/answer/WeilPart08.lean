    intro C_R g_R E Y'_K hClE hClY hUnion hNotSubE hNotSubY' W e_C w₀ U_W hEt hw₀ hwE hwY
    have : AlgebraicGeometry.Etale e_C := hEt
    let fst_K := CategoryTheory.Limits.pullback.fst g_R η_R
    let snd_K := CategoryTheory.Limits.pullback.snd g_R η_R
