        X_next_P (CategoryTheory.Limits.pullback g_next s)
        (CategoryTheory.Limits.pullback.snd g_next s_P)
        (CategoryTheory.Limits.pullback.snd g_next s)
        π_P hPb_P hDich_P

theorem weil_single_unstable_p1_valuation_contraction_step (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ) :
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))
    ∃ (C_next : AlgebraicGeometry.Scheme.{u})
      (g_next : C_next ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (τ_next : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C_next))
      (ι_next : C_K ⟶ C_next),
      IsValuationPointedCurveModel V p_K n σ_K C_next g_next τ_next ι_next ∧
      (_root_.Pairwise fun i j : Fin n =>
        Disjoint (Set.range (τ_next i).base) (Set.range (τ_next j).base)) ∧
      (∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
        ∃ V_sm : C_next.Opens,
          (τ_next j).base b ∈ V_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_next)) ∧
      (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
          (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
            AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
        ConnectedSpace ↥(CategoryTheory.Limits.pullback g_next s) ∧
        ∀ y : ↥(CategoryTheory.Limits.pullback g_next s),
          (∃ V_sm : (CategoryTheory.Limits.pullback g_next s).Opens,
            y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
              (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_next s)) ∨
          (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
              (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_next s)
              (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
                (MvPolynomial (Fin 2) K' ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
            AlgebraicGeometry.Etale e₁ ∧
            AlgebraicGeometry.Etale e₂ ∧
            e₁.base u₀ = y ∧
            (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
            e₁ ≫ CategoryTheory.Limits.pullback.snd g_next s =
              e₂ ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) ∨
          HasTwoPointPinchAt K' (CategoryTheory.Limits.pullback.snd g_next s) y) ∧
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next s₀)) <
        Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)) :=
by
  obtain ⟨V₀, V₁, h₀, eZ, eY, t₀, hPencil⟩ :=
    weil_sup1_hyperplane_henselian_divisor_split K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
  obtain ⟨N', φ, hProjMap⟩ :=
    weil_sup1_fractional_cech_veronese_proj_map K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
      V₀ V₁ h₀ eZ eY t₀ hPencil
  obtain ⟨hMod_next, hDisj_next, hSm_next⟩ :=
    weil_sup1_contracted_model_and_smooth_markings K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
      V₀ V₁ h₀ eZ eY t₀ hPencil N' φ hProjMap
  obtain ⟨hGeom3_next, hLt⟩ :=
    weil_sup1_geom_fibers_pinch_and_component_drop K m V hMaxNeBot hPkg
      C_K p_K n σ_K hIntCK hPropCK hSmCK hStabCK C g τ ι hSemi Z Z_sch ιZ hUnstab
      V₀ V₁ h₀ eZ eY t₀ hPencil N' φ hProjMap
  exact ⟨AlgebraicGeometry.Scheme.Hom.image φ,
    AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom,
    fun j : Fin n => τ j ≫ AlgebraicGeometry.Scheme.Hom.toImage φ,
    ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ,
    hMod_next, hDisj_next, hSm_next, hGeom3_next, hLt⟩

theorem weil_algClosed_finiteType_baseChange_open_irredFiber_and_domain (k₁ K' : Type u) [Field k₁] [IsAlgClosed k₁] [Field K']
    (φ : k₁ →+* K') :
    (∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra k₁ D] [Algebra.FiniteType k₁ D],
      letI : Algebra k₁ K' := φ.toAlgebra
      IsDomain (TensorProduct k₁ D K')) ∧
    (∀ (X₁ : AlgebraicGeometry.Scheme.{u})
      (p₁ : X₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
      [AlgebraicGeometry.LocallyOfFiniteType p₁],
      let α := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
      let π := CategoryTheory.Limits.pullback.fst p₁ α
      Function.Surjective π.base ∧
      IsOpenMap π.base ∧
      ∀ x : ↥X₁, IsPreirreducible (π.base ⁻¹' {x})) :=
by
  letI : Algebra k₁ K' := φ.toAlgebra
  have h_domain : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra k₁ D] [Algebra.FiniteType k₁ D],
      IsDomain (TensorProduct k₁ D K') := by
    intro D _ _ _ _
    let ι := Module.Basis.ofVectorSpaceIndex k₁ K'
    let b : Module.Basis ι k₁ K' := Module.Basis.ofVectorSpace k₁ K'
    let B_D : Module.Basis ι D (TensorProduct k₁ D K') := Algebra.TensorProduct.basis D b
    have hb1 : b.repr 1 ≠ 0 := by
      intro h
      exact one_ne_zero (b.repr.injective (h.trans (map_zero b.repr).symm))
    obtain ⟨i₁, _⟩ : ∃ i : ι, b.repr 1 i ≠ 0 := by
      by_contra! h
      exact hb1 (Finsupp.ext h)
    have : Nontrivial (TensorProduct k₁ D K') := by
      refine ⟨⟨B_D i₁, 0, ?_⟩⟩
      intro h
      have h1 : B_D.repr (B_D i₁) i₁ = B_D.repr 0 i₁ := congrArg (fun v => B_D.repr v i₁) h
      simp only [Module.Basis.repr_self, Finsupp.single_eq_same, map_zero, Finsupp.coe_zero,
        Pi.zero_apply] at h1
      exact one_ne_zero h1
    have : NoZeroDivisors (TensorProduct k₁ D K') := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra! hne
      obtain ⟨hx, hy⟩ := hne
      have hx_repr : B_D.repr x ≠ 0 := fun h => hx (B_D.repr.injective (h.trans (map_zero _).symm))
      have hy_repr : B_D.repr y ≠ 0 := fun h => hy (B_D.repr.injective (h.trans (map_zero _).symm))
      obtain ⟨i₀, ha₀⟩ : ∃ i : ι, B_D.repr x i ≠ 0 := by
        by_contra! h
        exact hx_repr (Finsupp.ext h)
      obtain ⟨j₀, hd₁⟩ : ∃ j : ι, B_D.repr y j ≠ 0 := by
        by_contra! h
        exact hy_repr (Finsupp.ext h)
      let a₀ : D := B_D.repr x i₀
      let d₁ : D := B_D.repr y j₀
      let d₀ : D := a₀ * d₁
      have hd₀ : d₀ ≠ 0 := mul_ne_zero ha₀ hd₁
      let D' := Localization.Away d₀
      have h_powers_le : Submonoid.powers d₀ ≤ nonZeroDivisors D := by
        rintro _ ⟨n, rfl⟩
        exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hd₀)
      have h_inj : Function.Injective (algebraMap D D') :=
        IsLocalization.injective D' h_powers_le
      have : Nontrivial D' :=
        ⟨⟨algebraMap D D' 1, 0, fun h =>
          one_ne_zero (h_inj (h.trans (map_zero (algebraMap D D')).symm))⟩⟩
      have : Algebra.FinitePresentation D D' := IsLocalization.Away.finitePresentation d₀
      have : Algebra.FiniteType D D' := inferInstance
      have : Algebra.FiniteType k₁ D' :=
        Algebra.FiniteType.trans (R := k₁) (S := D) (A := D') inferInstance inferInstance
      obtain ⟨s, hs⟩ := Algebra.FiniteType.out (R := k₁) (A := D')
      let ψ : MvPolynomial ↥s k₁ →ₐ[k₁] D' := MvPolynomial.aeval (Subtype.val : ↥s → D')
      have hψ_surj : Function.Surjective ψ := by
        rw [← AlgHom.range_eq_top, MvPolynomial.aeval_range, Subtype.range_coe_subtype,
          Finset.setOfPred_mem]
        exact hs
      obtain ⟨m', hm'⟩ := Ideal.exists_maximal D'
      let M : Ideal (MvPolynomial ↥s k₁) := Ideal.comap ψ.toRingHom m'
      have hM_max : M.IsMaximal := Ideal.comap_isMaximal_of_surjective ψ.toRingHom hψ_surj
      obtain ⟨v, hv⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hM_max
      have h_ker_le : ∀ P : MvPolynomial ↥s k₁, P ∈ RingHom.ker ψ.toRingHom →
          (MvPolynomial.eval v) P = 0 := by
        intro P hP
        have hPM : P ∈ M := by
          change ψ P ∈ m'
          have hP0 : ψ P = 0 := hP
          rw [hP0]
          exact m'.zero_mem
        rw [hv] at hPM
        simpa [MvPolynomial.vanishingIdeal] using hPM
      let ev_quot : (MvPolynomial ↥s k₁ ⧸ RingHom.ker ψ.toRingHom) →+* k₁ :=
        Ideal.Quotient.lift (RingHom.ker ψ.toRingHom) (MvPolynomial.eval v) h_ker_le
      let e_ker : (MvPolynomial ↥s k₁ ⧸ RingHom.ker ψ.toRingHom) ≃+* D' :=
        RingHom.quotientKerEquivOfSurjective hψ_surj
      let ev'_ring : D' →+* k₁ := ev_quot.comp e_ker.symm.toRingHom
      let ev' : D' →ₐ[k₁] k₁ :=
        { ev'_ring with
          commutes' := fun c => by
            have hc_ψ : ψ (MvPolynomial.C c) = algebraMap k₁ D' c := MvPolynomial.aeval_C _ c
            have hc_symm : e_ker.symm (ψ (MvPolynomial.C c)) =
                Ideal.Quotient.mk (RingHom.ker ψ.toRingHom) (MvPolynomial.C c) := by
              apply e_ker.injective
              rw [e_ker.apply_symm_apply]
              rfl
            change ev_quot (e_ker.symm (algebraMap k₁ D' c)) = algebraMap k₁ k₁ c
            rw [← hc_ψ, hc_symm]
            exact MvPolynomial.eval_C c }
      let ev : D →ₐ[k₁] k₁ := ev'.comp (IsScalarTower.toAlgHom k₁ D D')
      have hd₀_unit : IsUnit (algebraMap D D' d₀) :=
        IsLocalization.map_units D' ⟨d₀, Submonoid.mem_powers d₀⟩
      have hev_d₀_unit : IsUnit (ev d₀) := hd₀_unit.map ev'.toRingHom
      have hev_d₀_ne : ev a₀ * ev d₁ ≠ 0 := by
        rw [← map_mul]
        exact hev_d₀_unit.ne_zero
      have hev_a₀ : ev a₀ ≠ 0 := left_ne_zero_of_mul hev_d₀_ne
      have hev_d₁ : ev d₁ ≠ 0 := right_ne_zero_of_mul hev_d₀_ne
      let Φ_ev : TensorProduct k₁ D K' →ₐ[k₁] K' :=
        Algebra.TensorProduct.lift ((Algebra.ofId k₁ K').comp ev) (AlgHom.id k₁ K')
          (fun _ _ => mul_comm _ _)
      have h_coord : ∀ (z : TensorProduct k₁ D K') (i : ι),
          b.repr (Φ_ev z) i = ev (B_D.repr z i) := by
        intro z i
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul d c =>
          have hΦ : Φ_ev (d ⊗ₜ[k₁] c) = ev d • c := by
            change ((Algebra.ofId k₁ K').comp ev) d * c = ev d • c
            rw [AlgHom.comp_apply, Algebra.ofId_apply, Algebra.smul_def]
          rw [hΦ, LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul]
          have hB : B_D.repr (d ⊗ₜ[k₁] c) i = d * algebraMap k₁ D (b.repr c i) := by
            change (Algebra.TensorProduct.basis D b).repr (d ⊗ₜ[k₁] c) i = _
            rw [Algebra.TensorProduct.basis_repr_tmul, Finsupp.smul_apply,
              Finsupp.mapRange_apply, smul_eq_mul]
          rw [hB, map_mul, AlgHom.commutes]
          rfl
        | add z₁ z₂ ih₁ ih₂ =>
          simp [map_add, ih₁, ih₂]
      have hΦx : Φ_ev x ≠ 0 := by
        intro h0
        have := h_coord x i₀
        rw [h0, map_zero, Finsupp.coe_zero, Pi.zero_apply] at this
        exact hev_a₀ this.symm
      have hΦy : Φ_ev y ≠ 0 := by
        intro h0
        have := h_coord y j₀
        rw [h0, map_zero, Finsupp.coe_zero, Pi.zero_apply] at this
        exact hev_d₁ this.symm
      have hΦxy : Φ_ev x * Φ_ev y = 0 := by
        rw [← map_mul, hxy, map_zero]
      exact mul_ne_zero hΦx hΦy hΦxy
    exact NoZeroDivisors.to_isDomain (TensorProduct k₁ D K')
  have h_spec : ∀ (A : Type u) [CommRing A] [Algebra k₁ A] [Algebra.FiniteType k₁ A],
      let π_A := PrimeSpectrum.comap
        (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct k₁ A K')
      IsOpenMap π_A ∧ ∀ p : PrimeSpectrum A, IsPreirreducible (π_A ⁻¹' {p}) := by
    intro A _ _ _
    dsimp only
    let π_A := PrimeSpectrum.comap
      (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct k₁ A K')
    let ι := Module.Basis.ofVectorSpaceIndex k₁ K'
    let b : Module.Basis ι k₁ K' := Module.Basis.ofVectorSpace k₁ K'
    let B_A : Module.Basis ι A (TensorProduct k₁ A K') := Algebra.TensorProduct.basis A b
    have hb1 : b.repr 1 ≠ 0 := by
      intro h
      exact one_ne_zero (b.repr.injective (h.trans (map_zero b.repr).symm))
    obtain ⟨i₁, hi₁⟩ : ∃ i : ι, b.repr 1 i ≠ 0 := by
      by_contra! h
      exact hb1 (Finsupp.ext h)
    have h_mem_of_coords : ∀ (z : TensorProduct k₁ A K')
        (q : PrimeSpectrum (TensorProduct k₁ A K')),
        (∀ i ∈ (B_A.repr z).support, B_A.repr z i ∈ (π_A q).asIdeal) →
        z ∈ q.asIdeal := by
      intro z q hcoords
      have hz_eq : z = ∑ i ∈ (B_A.repr z).support, B_A.repr z i • B_A i := by
        have hlin := B_A.linearCombination_repr z
        rw [Finsupp.linearCombination_apply, Finsupp.sum] at hlin
        exact hlin.symm
      rw [hz_eq]
      refine Ideal.sum_mem q.asIdeal ?_
      intro i hi
      have h_smul : B_A.repr z i • B_A i =
          Algebra.TensorProduct.includeLeftRingHom (B_A.repr z i) * (1 ⊗ₜ[k₁] b i) := by
        change B_A.repr z i • (Algebra.TensorProduct.basis A b i) = _
        rw [Algebra.TensorProduct.basis_apply]
        change (B_A.repr z i • (1 : A)) ⊗ₜ[k₁] b i =
          (B_A.repr z i ⊗ₜ[k₁] (1 : K')) * (1 ⊗ₜ[k₁] b i)
        rw [Algebra.TensorProduct.tmul_mul_tmul, smul_eq_mul, mul_one, one_mul]
      rw [h_smul]
      exact q.asIdeal.mul_mem_right _ (hcoords i hi)
    have h_gen_prime : ∀ p : PrimeSpectrum A,
        ∃ q_p : PrimeSpectrum (TensorProduct k₁ A K'),
          π_A q_p = p ∧
          (∀ z : TensorProduct k₁ A K', z ∈ q_p.asIdeal ↔ ∀ i : ι, B_A.repr z i ∈ p.asIdeal) := by
      intro p
      have : p.asIdeal.IsPrime := p.isPrime
      let D_p := A ⧸ p.asIdeal
      have : IsDomain D_p := Ideal.Quotient.isDomain p.asIdeal
      have : Algebra.FiniteType k₁ D_p :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k₁ p.asIdeal)
          Ideal.Quotient.mk_surjective
      have : IsDomain (TensorProduct k₁ D_p K') := h_domain D_p
      let q_alg : TensorProduct k₁ A K' →ₐ[k₁] TensorProduct k₁ D_p K' :=
        Algebra.TensorProduct.map (Ideal.Quotient.mkₐ k₁ p.asIdeal) (AlgHom.id k₁ K')
      let q_p : PrimeSpectrum (TensorProduct k₁ A K') :=
        ⟨RingHom.ker q_alg.toRingHom, RingHom.ker_isPrime q_alg.toRingHom⟩
      let B_Dp : Module.Basis ι D_p (TensorProduct k₁ D_p K') :=
        Algebra.TensorProduct.basis D_p b
      have h_repr_q : ∀ (z : TensorProduct k₁ A K') (i : ι),
          B_Dp.repr (q_alg z) i = Ideal.Quotient.mk p.asIdeal (B_A.repr z i) := by
        intro z i
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a c =>
          change (Algebra.TensorProduct.basis D_p b).repr
            (Ideal.Quotient.mk p.asIdeal a ⊗ₜ[k₁] c) i =
            Ideal.Quotient.mk p.asIdeal ((Algebra.TensorProduct.basis A b).repr (a ⊗ₜ[k₁] c) i)
          rw [Algebra.TensorProduct.basis_repr_tmul, Algebra.TensorProduct.basis_repr_tmul,
            Finsupp.smul_apply, Finsupp.smul_apply, Finsupp.mapRange_apply,
            Finsupp.mapRange_apply, smul_eq_mul, smul_eq_mul, map_mul]
          rfl
        | add z₁ z₂ ih₁ ih₂ =>
          simp [map_add, ih₁, ih₂]
      have h_mem_qp : ∀ z : TensorProduct k₁ A K',
          z ∈ q_p.asIdeal ↔ ∀ i : ι, B_A.repr z i ∈ p.asIdeal := by
        intro z
        change q_alg z = 0 ↔ _
        rw [← B_Dp.repr.map_eq_zero_iff, Finsupp.ext_iff]
        simp only [Finsupp.coe_zero, Pi.zero_apply, h_repr_q]
        exact forall_congr' fun _ => Ideal.Quotient.eq_zero_iff_mem
      refine ⟨q_p, ?_, h_mem_qp⟩
      apply PrimeSpectrum.ext
      ext a
      change Algebra.TensorProduct.includeLeftRingHom a ∈ q_p.asIdeal ↔ a ∈ p.asIdeal
      rw [h_mem_qp]
      have h_inc : ∀ i : ι, B_A.repr (Algebra.TensorProduct.includeLeftRingHom a) i =
          a * algebraMap k₁ A (b.repr 1 i) := by
        intro i
        change (Algebra.TensorProduct.basis A b).repr (a ⊗ₜ[k₁] (1 : K')) i = _
        rw [Algebra.TensorProduct.basis_repr_tmul, Finsupp.smul_apply,
          Finsupp.mapRange_apply, smul_eq_mul]
      simp only [h_inc]
      constructor
      · intro h_all
        have ha_mul := h_all i₁
        have h_unit : a * algebraMap k₁ A (b.repr 1 i₁) * algebraMap k₁ A (b.repr 1 i₁)⁻¹ = a := by
          rw [mul_assoc, ← map_mul, mul_inv_cancel₀ hi₁, map_one, mul_one]
        rw [← h_unit]
        exact p.asIdeal.mul_mem_right _ ha_mul
      · intro ha i
        exact p.asIdeal.mul_mem_right _ ha
    refine ⟨?_, ?_⟩
    · rw [PrimeSpectrum.isTopologicalBasis_basic_opens.isOpenMap_iff]
      rintro _ ⟨h, rfl⟩
      have h_img : π_A '' (PrimeSpectrum.basicOpen h : Set _) =
          ⋃ i ∈ (B_A.repr h).support, (PrimeSpectrum.basicOpen (B_A.repr h i) : Set _) := by
        ext p
        simp only [Set.mem_image, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, Set.mem_iUnion]
        constructor
        · rintro ⟨q, hq, rfl⟩
          by_contra! h_all
          exact hq (h_mem_of_coords h q h_all)
        · rintro ⟨i₀, _, hp_i₀⟩
          obtain ⟨q_p, hqp_proj, hqp_mem⟩ := h_gen_prime p
          refine ⟨q_p, ?_, hqp_proj⟩
          rw [hqp_mem]
          intro h_all
          exact hp_i₀ (h_all i₀)
      rw [h_img]
      exact isOpen_biUnion (fun i _ => (PrimeSpectrum.basicOpen (B_A.repr h i)).isOpen)
    · intro p u v hu hv ⟨q₁, hq₁_fib, hq₁_u⟩ ⟨q₂, hq₂_fib, hq₂_v⟩
      obtain ⟨q_p, hqp_proj, hqp_mem⟩ := h_gen_prime p
      have h_dom : ∀ q : PrimeSpectrum (TensorProduct k₁ A K'),
          π_A q = p → q ∈ closure ({q_p} : Set _) := by
        intro q hq_eq
        rw [PrimeSpectrum.closure_singleton]
        intro z hz
        apply h_mem_of_coords z q
        intro i _
        rw [hq_eq]
        exact (hqp_mem z).mp hz i
      have hqp_u : q_p ∈ u := by
        by_contra hnot
        have h_cl : closure ({q_p} : Set _) ⊆ uᶜ :=
          closure_minimal (Set.singleton_subset_iff.mpr hnot) hu.isClosed_compl
        exact h_cl (h_dom q₁ hq₁_fib) hq₁_u
      have hqp_v : q_p ∈ v := by
        by_contra hnot
        have h_cl : closure ({q_p} : Set _) ⊆ vᶜ :=
          closure_minimal (Set.singleton_subset_iff.mpr hnot) hv.isClosed_compl
        exact h_cl (h_dom q₂ hq₂_fib) hq₂_v
      exact ⟨q_p, hqp_proj, hqp_u, hqp_v⟩
  refine ⟨h_domain, ?_⟩
  intro X₁ p₁ _
  let α := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
  let π := CategoryTheory.Limits.pullback.fst p₁ α
  have h_surj : Function.Surjective π.base := by
    obtain ⟨pt₂⟩ := (inferInstance : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of K')))
    have : AlgebraicGeometry.Surjective α := ⟨fun y => ⟨pt₂, Subsingleton.elim _ _⟩⟩
    exact (inferInstance : AlgebraicGeometry.Surjective π).surj
  have h_chart : ∀ (U : X₁.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      let A_U := X₁.presheaf.obj (Opposite.op U)
      letI : Algebra k₁ ↑A_U := (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ p₁)).hom.toAlgebra
      Algebra.FiniteType k₁ ↑A_U ∧
      ∃ (ψ_U : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ ↑A_U K')) ⟶
          CategoryTheory.Limits.pullback p₁ α),
        AlgebraicGeometry.IsOpenImmersion ψ_U ∧
        Set.range ψ_U.base = π.base ⁻¹' (U : Set ↥X₁) ∧
        ψ_U ≫ π =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
              ↑A_U →+* TensorProduct k₁ ↑A_U K')) ≫ hU.fromSpec := by
    intro U hU
    let A_U := X₁.presheaf.obj (Opposite.op U)
    let f_U : CommRingCat.of k₁ ⟶ A_U := AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ p₁)
    letI : Algebra k₁ ↑A_U := f_U.hom.toAlgebra
    have hf_U : AlgebraicGeometry.Spec.map f_U = hU.fromSpec ≫ p₁ :=
      AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ p₁)
    have : AlgebraicGeometry.IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have h_lft_comp : AlgebraicGeometry.LocallyOfFiniteType (hU.fromSpec ≫ p₁) := inferInstance
    rw [← hf_U] at h_lft_comp
    have hf_ft : f_U.hom.FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp
        h_lft_comp
    have hFT_U : Algebra.FiniteType k₁ ↑A_U := RingHom.finiteType_algebraMap.mp hf_ft
    let g_U := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↑A_U))
    let α' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))
    have hg_U_eq : g_U = hU.fromSpec ≫ p₁ := hf_U
    have hα'_eq : α' = α := rfl
    let j_U : CategoryTheory.Limits.pullback g_U α' ⟶ CategoryTheory.Limits.pullback p₁ α :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g_U α' ≫ hU.fromSpec)
        (CategoryTheory.Limits.pullback.snd g_U α')
        (by
          rw [CategoryTheory.Category.assoc, ← hg_U_eq]
          exact CategoryTheory.Limits.pullback.condition)
    have hj_fst : j_U ≫ π = CategoryTheory.Limits.pullback.fst g_U α' ≫ hU.fromSpec :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hj_snd : j_U ≫ CategoryTheory.Limits.pullback.snd p₁ α =
        CategoryTheory.Limits.pullback.snd g_U α' :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOuter : CategoryTheory.IsPullback
        (j_U ≫ CategoryTheory.Limits.pullback.snd p₁ α)
        (CategoryTheory.Limits.pullback.fst g_U α') α (hU.fromSpec ≫ p₁) := by
      rw [hj_snd, ← hg_U_eq, ← hα'_eq]
      exact (CategoryTheory.IsPullback.of_hasPullback g_U α').flip
    have hRight : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd p₁ α) π α p₁ :=
      (CategoryTheory.IsPullback.of_hasPullback p₁ α).flip
    have hPb_left : CategoryTheory.IsPullback j_U
        (CategoryTheory.Limits.pullback.fst g_U α') π hU.fromSpec :=
      CategoryTheory.IsPullback.of_right hOuter hj_fst hRight
    have hj_open : AlgebraicGeometry.IsOpenImmersion j_U := by
      rw [← hPb_left.isoPullback_hom_fst]
      infer_instance
    let iso_spec := AlgebraicGeometry.pullbackSpecIso k₁ ↑A_U K'
    let ψ_U : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ ↑A_U K')) ⟶
        CategoryTheory.Limits.pullback p₁ α :=
      iso_spec.inv ≫ j_U
    have : AlgebraicGeometry.IsOpenImmersion j_U := hj_open
    have hψ_open : AlgebraicGeometry.IsOpenImmersion ψ_U := inferInstance
    have hψ_range : Set.range ψ_U.base = π.base ⁻¹' (U : Set ↥X₁) := by
      have h_eq1 : ψ_U = (iso_spec.symm ≪≫ hPb_left.isoPullback).hom ≫
          CategoryTheory.Limits.pullback.fst π hU.fromSpec := by
        dsimp [ψ_U]
        rw [CategoryTheory.Category.assoc, hPb_left.isoPullback_hom_fst]
      rw [h_eq1]
      let e_tot := iso_spec.symm ≪≫ hPb_left.isoPullback
      have he_surj : Function.Surjective e_tot.hom.base := by
        intro z
        refine ⟨e_tot.inv.base z, ?_⟩
        simp
      have h_rng_comp : Set.range (e_tot.hom ≫
          CategoryTheory.Limits.pullback.fst π hU.fromSpec).base =
          Set.range (CategoryTheory.Limits.pullback.fst π hU.fromSpec).base := by
        ext y
        simp only [Set.mem_range]
        constructor
        · rintro ⟨w, hw⟩
          exact ⟨e_tot.hom.base w, hw⟩
        · rintro ⟨z, hz⟩
          obtain ⟨w, rfl⟩ := he_surj z
          exact ⟨w, hz⟩
      rw [h_rng_comp, AlgebraicGeometry.Scheme.Pullback.range_fst, hU.range_fromSpec]
    have hψ_comm : ψ_U ≫ π =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            ↑A_U →+* TensorProduct k₁ ↑A_U K')) ≫ hU.fromSpec := by
      dsimp [ψ_U]
      rw [CategoryTheory.Category.assoc, hj_fst, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.pullbackSpecIso_inv_fst k₁ ↑A_U K']
    exact ⟨hFT_U, ψ_U, hψ_open, hψ_range, hψ_comm⟩
  refine ⟨h_surj, ?_, ?_⟩
  · intro W hW
    have h_cov : π.base '' W =
        ⋃ U : X₁.affineOpens, π.base '' (W ∩ π.base ⁻¹' (U.1 : Set ↥X₁)) := by
      ext x
      simp only [Set.mem_image, Set.mem_iUnion, Set.mem_inter_iff, Set.mem_preimage]
      constructor
      · rintro ⟨y, hyW, rfl⟩
        have hy_top : π.base y ∈ (⨆ U : X₁.affineOpens, U.1) := by
          rw [AlgebraicGeometry.iSup_affineOpens_eq_top]
          trivial
        obtain ⟨U, hyU⟩ := TopologicalSpace.Opens.mem_iSup.mp hy_top
        exact ⟨U, y, ⟨hyW, hyU⟩, rfl⟩
      · rintro ⟨_, y, ⟨hyW, _⟩, rfl⟩
        exact ⟨y, hyW, rfl⟩
    rw [h_cov]
    refine isOpen_iUnion (fun U => ?_)
    let A_U := X₁.presheaf.obj (Opposite.op U.1)
    letI : Algebra k₁ ↑A_U := (AlgebraicGeometry.Spec.preimage (U.2.fromSpec ≫ p₁)).hom.toAlgebra
    obtain ⟨hFT_U, ψ_U, _, hRange_ψU, hComm_ψU⟩ := h_chart U.1 U.2
    obtain ⟨hOpen_AU, _⟩ := h_spec ↑A_U
    let π_AU := PrimeSpectrum.comap
      (Algebra.TensorProduct.includeLeftRingHom : ↑A_U →+* TensorProduct k₁ ↑A_U K')
    have h_piece : π.base '' (W ∩ π.base ⁻¹' (U.1 : Set ↥X₁)) =
        U.2.fromSpec.base '' (π_AU '' (ψ_U.base ⁻¹' W)) := by
      ext x
      simp only [Set.mem_image, Set.mem_inter_iff, Set.mem_preimage]
      have h_eval : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ ↑A_U K'))),
          π.base (ψ_U.base q) = U.2.fromSpec.base (π_AU q) := by
        intro q
        have h1 := congrArg (fun f => f.base q) hComm_ψU
        have h_lhs : (ψ_U ≫ π).base q = π.base (ψ_U.base q) := by simp
        have h_rhs : (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
              ↑A_U →+* TensorProduct k₁ ↑A_U K')) ≫ U.2.fromSpec).base q =
            U.2.fromSpec.base (π_AU q) := rfl
        rw [h_lhs, h_rhs] at h1
        exact h1
      constructor
      · rintro ⟨y, ⟨hyW, hyU⟩, rfl⟩
        have hy_rng : y ∈ Set.range ψ_U.base := by
          rw [hRange_ψU]
          exact hyU
        obtain ⟨q, rfl⟩ := hy_rng
        exact ⟨π_AU q, ⟨q, hyW, rfl⟩, (h_eval q).symm⟩
      · rintro ⟨_, ⟨q, hqW, rfl⟩, rfl⟩
        refine ⟨ψ_U.base q, ⟨hqW, ?_⟩, h_eval q⟩
        have h_in_rng : ψ_U.base q ∈ Set.range ψ_U.base := ⟨q, rfl⟩
        rw [hRange_ψU] at h_in_rng
        exact h_in_rng
    rw [h_piece]
    have : AlgebraicGeometry.IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
    exact U.2.fromSpec.isOpenEmbedding.isOpenMap _ (hOpen_AU _ (hW.preimage ψ_U.continuous))
  · intro x
    have hx_top : x ∈ (⨆ U : X₁.affineOpens, U.1) := by
      rw [AlgebraicGeometry.iSup_affineOpens_eq_top]
      trivial
    obtain ⟨U, hxU⟩ := TopologicalSpace.Opens.mem_iSup.mp hx_top
    let A_U := X₁.presheaf.obj (Opposite.op U.1)
    letI : Algebra k₁ ↑A_U := (AlgebraicGeometry.Spec.preimage (U.2.fromSpec ≫ p₁)).hom.toAlgebra
    obtain ⟨hFT_U, ψ_U, _, hRange_ψU, hComm_ψU⟩ := h_chart U.1 U.2
    obtain ⟨_, hFib_AU⟩ := h_spec ↑A_U
    let π_AU := PrimeSpectrum.comap
      (Algebra.TensorProduct.includeLeftRingHom : ↑A_U →+* TensorProduct k₁ ↑A_U K')
    have hx_rng : x ∈ Set.range U.2.fromSpec.base := by
      rw [U.2.range_fromSpec]
      exact hxU
    obtain ⟨p, hp⟩ := hx_rng
    have : AlgebraicGeometry.IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
    have h_inj : Function.Injective U.2.fromSpec.base :=
      U.2.fromSpec.isOpenEmbedding.injective
    have h_eval : ∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ ↑A_U K'))),
        π.base (ψ_U.base q) = U.2.fromSpec.base (π_AU q) := by
      intro q
      have h1 := congrArg (fun f => f.base q) hComm_ψU
      have h_lhs : (ψ_U ≫ π).base q = π.base (ψ_U.base q) := by simp
      have h_rhs : (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            ↑A_U →+* TensorProduct k₁ ↑A_U K')) ≫ U.2.fromSpec).base q =
          U.2.fromSpec.base (π_AU q) := rfl
      rw [h_lhs, h_rhs] at h1
      exact h1
    have h_fib_eq : π.base ⁻¹' {x} = ψ_U.base '' (π_AU ⁻¹' {p}) := by
      ext y
      simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_image]
      constructor
      · intro hy
        have hy_rng : y ∈ Set.range ψ_U.base := by
          rw [hRange_ψU]
          change π.base y ∈ (U.1 : Set ↥X₁)
          rw [hy]
          exact hxU
        obtain ⟨q, rfl⟩ := hy_rng
        refine ⟨q, ?_, rfl⟩
        apply h_inj
        rw [← h_eval q, hy, hp]
      · rintro ⟨q, hqp, rfl⟩
        rw [h_eval q, hqp, hp]
    rw [h_fib_eq]
    exact (hFib_AU p).image ψ_U.base ψ_U.continuous.continuousOn

theorem weil_algClosed_proper_scheme_iso_descent (k₁ K' : Type u) [Field k₁] [IsAlgClosed k₁] [Field K']
    (φ : k₁ →+* K')
    (Y Z : AlgebraicGeometry.Scheme.{u})
    (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
    (p_Z : Z ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
    [AlgebraicGeometry.IsProper p_Y]
    [AlgebraicGeometry.IsProper p_Z]
    (hIso : ∃ Ψ : CategoryTheory.Limits.pullback p_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ≅
      CategoryTheory.Limits.pullback p_Z
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)),
      Ψ.hom ≫ CategoryTheory.Limits.pullback.snd p_Z
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) =
      CategoryTheory.Limits.pullback.snd p_Y
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))) :
    ∃ Ψ₀ : Y ≅ Z, Ψ₀.hom ≫ p_Z = p_Y :=
by
  
  
  
  have fg_subalgebra_retraction :
      ∀ [Algebra k₁ K'] (B₀ : Subalgebra k₁ K'),
        B₀.FG → Nonempty (↥B₀ →ₐ[k₁] k₁) := by
    intro _ B₀ hFG
    have hFT : Algebra.FiniteType k₁ ↥B₀ := (Subalgebra.fg_iff_finiteType B₀).mp hFG
    obtain ⟨d, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT
    obtain ⟨𝔪, _h𝔪⟩ := Ideal.exists_maximal ↥B₀
    let 𝔐 : Ideal (MvPolynomial (Fin d) k₁) := Ideal.comap π.toRingHom 𝔪
    have h𝔐 : 𝔐.IsMaximal := Ideal.comap_isMaximal_of_surjective π.toRingHom hπ
    obtain ⟨v, hv⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp h𝔐
    have hker : ∀ P ∈ RingHom.ker π.toRingHom, (MvPolynomial.aeval v) P = 0 := by
      intro P hP
      have hP0 : π P = 0 := hP
      have hP𝔐 : P ∈ 𝔐 := by
        change π P ∈ 𝔪
        rw [hP0]
        exact 𝔪.zero_mem
      rw [hv] at hP𝔐
      have heval : MvPolynomial.eval v P = 0 := by
        simpa [MvPolynomial.vanishingIdeal] using hP𝔐
      rw [MvPolynomial.aeval_def]
      exact heval
    let q_alg : (MvPolynomial (Fin d) k₁ ⧸ RingHom.ker π.toRingHom) →ₐ[k₁] k₁ :=
      Ideal.Quotient.liftₐ (RingHom.ker π.toRingHom) (MvPolynomial.aeval v) hker
    let e_ring : (MvPolynomial (Fin d) k₁ ⧸ RingHom.ker π.toRingHom) ≃+* ↥B₀ :=
      RingHom.quotientKerEquivOfSurjective (f := π.toRingHom) hπ
    let ev_ring : ↥B₀ →+* k₁ := q_alg.toRingHom.comp e_ring.symm.toRingHom
    exact ⟨{ ev_ring with
      commutes' := fun c => by
        have hc : algebraMap k₁ ↥B₀ c = e_ring (Ideal.Quotient.mk _ (MvPolynomial.C c)) := by
          change algebraMap k₁ ↥B₀ c = π (MvPolynomial.C c)
          exact (π.commutes c).symm
        change q_alg (e_ring.symm (algebraMap k₁ ↥B₀ c)) = algebraMap k₁ k₁ c
        rw [hc, e_ring.symm_apply_apply]
        change (MvPolynomial.aeval v) (MvPolynomial.C c) = algebraMap k₁ k₁ c
        exact (MvPolynomial.aeval v).commutes c }⟩

  
  
  
  have tensor_map_injective :
      ∀ {E₁ E₂ : Type u} [CommRing E₁] [Algebra k₁ E₁] [CommRing E₂] [Algebra k₁ E₂]
        (ρ : E₁ →ₐ[k₁] E₂),
        Function.Injective ρ →
        ∀ (A : Type u) [CommRing A] [Algebra k₁ A],
          Function.Injective (Algebra.TensorProduct.map (AlgHom.id k₁ A) ρ) := by
    intro E₁ E₂ _ _ _ _ ρ hρ A _ _
    let ψ_A := Algebra.TensorProduct.map (AlgHom.id k₁ A) ρ
    have h_lin : ψ_A.toLinearMap = LinearMap.lTensor A ρ.toLinearMap := by
      apply TensorProduct.ext'
      intro a b
      rfl
    have h_inj := Module.Flat.lTensor_preserves_injective_linearMap
      (M := A) ρ.toLinearMap hρ
    intro x₁ x₂ hx
    exact h_inj (by rw [← h_lin]; exact hx)

  have exists_awayLift :
      ∀ {R S : Type u} [CommRing R] [CommRing S]
        (ψ : R →+* S), Function.Injective ψ →
        ∀ (h : R) (h_S : S), ψ h = h_S →
          ∃ (lam : Localization.Away h →+* Localization.Away h_S),
            Function.Injective lam ∧
            lam.comp (algebraMap R (Localization.Away h)) =
              (algebraMap S (Localization.Away h_S)).comp ψ ∧
            lam (IsLocalization.Away.invSelf h) = IsLocalization.Away.invSelf h_S := by
    intro R S _ _ ψ hψ h h_S hh
    have hu : IsUnit (((algebraMap S (Localization.Away h_S)).comp ψ) h) := by
      change IsUnit (algebraMap S (Localization.Away h_S) (ψ h))
      rw [hh]
      exact IsLocalization.Away.algebraMap_isUnit h_S
    let lam : Localization.Away h →+* Localization.Away h_S :=
      IsLocalization.Away.lift h hu
    have hcomp : lam.comp (algebraMap R (Localization.Away h)) =
        (algebraMap S (Localization.Away h_S)).comp ψ := by
      apply RingHom.ext
      intro r
      exact IsLocalization.Away.lift_eq (S := Localization.Away h) h hu r
    have hinj : Function.Injective lam := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      have hsec := IsLocalization.Away.sec_spec h w
      set r := (IsLocalization.Away.sec h w).2
      set z := (IsLocalization.Away.sec h w).1
      have hf_sec := congrArg lam hsec
      rw [map_mul, hw, zero_mul] at hf_sec
      have hf_alg : lam (algebraMap R (Localization.Away h) z) =
          algebraMap S (Localization.Away h_S) (ψ z) :=
        IsLocalization.Away.lift_eq (S := Localization.Away h) h hu z
      rw [hf_alg] at hf_sec
      obtain ⟨⟨_, m, rfl⟩, hm⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers h_S)
          (Localization.Away h_S) (ψ z)).mp hf_sec.symm
      rw [← hh] at hm
      have hmz : h ^ m * z = 0 := hψ (by simp only [map_mul, map_pow, hm, map_zero])
      have hloc := congrArg (algebraMap R (Localization.Away h)) hmz
      rw [map_mul, map_zero, ← hsec] at hloc
      have hinv_m : algebraMap R (Localization.Away h) (h ^ m) *
          (IsLocalization.Away.invSelf h) ^ m = 1 := by
        rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
      have hinv_r : algebraMap R (Localization.Away h) (h ^ r) *
          (IsLocalization.Away.invSelf h) ^ r = 1 := by
        rw [map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow]
      calc
        w = (IsLocalization.Away.invSelf h) ^ m *
              (algebraMap R (Localization.Away h) (h ^ m) *
                (w * algebraMap R (Localization.Away h) (h ^ r))) *
              (IsLocalization.Away.invSelf h) ^ r := by
          have h1 : (IsLocalization.Away.invSelf h) ^ m *
              (algebraMap R (Localization.Away h) (h ^ m) *
                (w * algebraMap R (Localization.Away h) (h ^ r))) =
              w * algebraMap R (Localization.Away h) (h ^ r) := by
            rw [← mul_assoc, mul_comm ((IsLocalization.Away.invSelf h) ^ m), hinv_m, one_mul]
          rw [h1, mul_assoc, hinv_r, mul_one]
        _ = 0 := by rw [hloc, mul_zero, zero_mul]
    have hinv : lam (IsLocalization.Away.invSelf h) = IsLocalization.Away.invSelf h_S := by
      have h_alg_h : lam (algebraMap R (Localization.Away h) h) =
          algebraMap S (Localization.Away h_S) h_S :=
        (IsLocalization.Away.lift_eq (S := Localization.Away h) h hu h).trans
          (congrArg (algebraMap S (Localization.Away h_S)) hh)
      have h1 : algebraMap S (Localization.Away h_S) h_S *
          lam (IsLocalization.Away.invSelf h) = 1 := by
        rw [← h_alg_h, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]
      calc
        lam (IsLocalization.Away.invSelf h) =
            (algebraMap S (Localization.Away h_S) h_S *
              lam (IsLocalization.Away.invSelf h)) *
            IsLocalization.Away.invSelf h_S := by
          rw [mul_assoc, mul_comm (lam _), ← mul_assoc,
            IsLocalization.Away.mul_invSelf, one_mul]
        _ = IsLocalization.Away.invSelf h_S := by rw [h1, one_mul]
    exact ⟨lam, hinj, hcomp, hinv⟩

  have exists_fg_lift_family :
      ∀ [Algebra k₁ K'] (ι : Type u) [Fintype ι]
        (M : ι → Type u) [∀ j, CommRing (M j)] [∀ j, Algebra k₁ (M j)]
        (x : ∀ j : ι, TensorProduct k₁ (M j) K'),
        ∃ (B : Subalgebra k₁ K'), B.FG ∧
          ∀ j : ι, ∃ y : TensorProduct k₁ (M j) ↥B,
            Algebra.TensorProduct.map (AlgHom.id k₁ (M j)) B.val y = x j := by
    intro _ ι _ M _ _ x
    classical
    have h_lin_eq : ∀ (j : ι) (B : Subalgebra k₁ K') (y : TensorProduct k₁ (M j) ↥B),
        Algebra.TensorProduct.map (AlgHom.id k₁ (M j)) B.val y =
          LinearMap.lTensor (M j) B.val.toLinearMap y := by
      intro j B y
      have h1 : (Algebra.TensorProduct.map (AlgHom.id k₁ (M j)) B.val).toLinearMap =
          LinearMap.lTensor (M j) B.val.toLinearMap := by
        apply TensorProduct.ext'
        intro a b
        rfl
      exact congrArg (fun f => f y) h1
    have h_mono : ∀ {M₀ : Type u} [AddCommGroup M₀] [Module k₁ M₀]
        {B₁ B₂ : Subalgebra k₁ K'} (hle : B₁ ≤ B₂)
        (y : TensorProduct k₁ M₀ ↥B₁),
        LinearMap.lTensor M₀ B₂.val.toLinearMap
          (LinearMap.lTensor M₀ (Subalgebra.inclusion hle).toLinearMap y) =
        LinearMap.lTensor M₀ B₁.val.toLinearMap y := by
      intro M₀ _ _ B₁ B₂ hle y
      rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
      rfl
    have h_single : ∀ {M₀ : Type u} [AddCommGroup M₀] [Module k₁ M₀]
        (v : TensorProduct k₁ M₀ K'),
        ∃ (B : Subalgebra k₁ K'), B.FG ∧
          ∃ y : TensorProduct k₁ M₀ ↥B, LinearMap.lTensor M₀ B.val.toLinearMap y = v := by
      intro M₀ _ _ v
      induction v using TensorProduct.induction_on with
      | zero => exact ⟨⊥, Subalgebra.fg_bot, 0, map_zero _⟩
      | tmul m c =>
        exact ⟨Algebra.adjoin k₁ (↑({c} : Finset K') : Set K'),
          Subalgebra.fg_adjoin_finset {c},
          m ⊗ₜ[k₁] ⟨c, Algebra.subset_adjoin (by simp)⟩, rfl⟩
      | add u₁ u₂ ih₁ ih₂ =>
        obtain ⟨B₁, hB₁, y₁, hy₁⟩ := ih₁
        obtain ⟨B₂, hB₂, y₂, hy₂⟩ := ih₂
        refine ⟨B₁ ⊔ B₂, hB₁.sup hB₂,
          LinearMap.lTensor M₀ (Subalgebra.inclusion le_sup_left).toLinearMap y₁ +
            LinearMap.lTensor M₀ (Subalgebra.inclusion le_sup_right).toLinearMap y₂, ?_⟩
        rw [map_add, h_mono le_sup_left, h_mono le_sup_right, hy₁, hy₂]
    have h_fin : ∀ s : Finset ι, ∃ (B : Subalgebra k₁ K'), B.FG ∧
        ∀ j ∈ s, ∃ y : TensorProduct k₁ (M j) ↥B,
          LinearMap.lTensor (M j) B.val.toLinearMap y = x j := by
      intro s
      induction s using Finset.induction_on with
      | empty => exact ⟨⊥, Subalgebra.fg_bot, fun _ hj => False.elim (Finset.notMem_empty _ hj)⟩
      | insert j₀ s _ ih =>
        obtain ⟨B₁, hB₁, y₀, hy₀⟩ := h_single (x j₀)
        obtain ⟨B₂, hB₂, hs⟩ := ih
        refine ⟨B₁ ⊔ B₂, hB₁.sup hB₂, fun j hj => ?_⟩
        rcases Finset.mem_insert.mp hj with rfl | hjs
        · exact ⟨LinearMap.lTensor (M j) (Subalgebra.inclusion le_sup_left).toLinearMap y₀,
            (h_mono le_sup_left y₀).trans hy₀⟩
        · obtain ⟨y, hy⟩ := hs j hjs
          exact ⟨LinearMap.lTensor (M j) (Subalgebra.inclusion le_sup_right).toLinearMap y,
            (h_mono le_sup_right y).trans hy⟩
    obtain ⟨B, hB, hmem⟩ := h_fin Finset.univ
    refine ⟨B, hB, fun j => ?_⟩
    obtain ⟨y, hy⟩ := hmem j (Finset.mem_univ j)
    exact ⟨y, (h_lin_eq j B y).trans hy⟩

  
  
  
  have exists_point_affine_k1_chart :
      ∀ (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
        (x : ↥X),
        ∃ (A : Type u) (_ : CommRing A) (_ : Algebra k₁ A)
          (u_X : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ X),
          AlgebraicGeometry.IsOpenImmersion u_X ∧
          u_X ≫ p_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ A)) ∧
          x ∈ Set.range u_X.base := by
    intro X p_X x
    let idx := X.affineCover.idx x
    haveI : AlgebraicGeometry.IsOpenImmersion (X.affineCover.f idx) :=
      X.affineCover.map_prop idx
    let W : X.Opens := (X.affineCover.f idx).opensRange
    have hW : AlgebraicGeometry.IsAffineOpen W :=
      AlgebraicGeometry.isAffineOpen_opensRange (X.affineCover.f idx)
    let A : Type u := ↑(X.presheaf.obj (Opposite.op W))
    let u_X : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ X := hW.fromSpec
    letI : Algebra k₁ A :=
      (AlgebraicGeometry.Spec.preimage (u_X ≫ p_X)).hom.toAlgebra
    have hu_pX : u_X ≫ p_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ A)) :=
      (AlgebraicGeometry.Spec.map_preimage (u_X ≫ p_X)).symm
    have hx_range : x ∈ Set.range u_X.base := by
      change x ∈ Set.range hW.fromSpec.base
      rw [hW.range_fromSpec]
      obtain ⟨z_cov, hz_cov⟩ := X.affineCover.covers x
      exact ⟨z_cov, hz_cov⟩
    exact ⟨A, inferInstance, inferInstance, u_X, inferInstance, hu_pX, hx_range⟩

  have exists_finite_affine_k1_cover :
      ∀ (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
        [AlgebraicGeometry.IsProper p_X],
        ∃ (m : ℕ) (A : Fin m → Type u)
          (_ : ∀ i, CommRing (A i)) (_ : ∀ i, Algebra k₁ (A i))
          (u_X : ∀ i : Fin m, AlgebraicGeometry.Spec (CommRingCat.of (A i)) ⟶ X),
          (∀ i : Fin m, Algebra.FiniteType k₁ (A i)) ∧
          (∀ i : Fin m, AlgebraicGeometry.IsOpenImmersion (u_X i)) ∧
          (∀ i : Fin m, u_X i ≫ p_X =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ (A i)))) ∧
          (∀ x : ↥X, ∃ i : Fin m, x ∈ Set.range (u_X i).base) := by
    intro X p_X _
    classical
    haveI : CompactSpace ↥X :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_X
    obtain ⟨sX, hsX_fin, hsX_eq⟩ :=
      (AlgebraicGeometry.isCompact_iff_finite_and_eq_biUnion_affineOpens
        (U := (⊤ : X.Opens))).mp isCompact_univ
    letI : Fintype ↥sX := hsX_fin.fintype
    let m : ℕ := Fintype.card ↥sX
    let eX : Fin m ≃ ↥sX := (Fintype.equivFin ↥sX).symm
    let U : Fin m → X.Opens := fun i => (eX i).1.1
    let hU : ∀ i : Fin m, AlgebraicGeometry.IsAffineOpen (U i) := fun i => (eX i).1.2
    let A : Fin m → Type u := fun i => ↑(X.presheaf.obj (Opposite.op (U i)))
    let u_X : ∀ i : Fin m, AlgebraicGeometry.Spec (CommRingCat.of (A i)) ⟶ X :=
      fun i => (hU i).fromSpec
    letI : ∀ i : Fin m, Algebra k₁ (A i) := fun i =>
      (AlgebraicGeometry.Spec.preimage (u_X i ≫ p_X)).hom.toAlgebra
    have hu_pX : ∀ i : Fin m, u_X i ≫ p_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ (A i))) :=
      fun i => (AlgebraicGeometry.Spec.map_preimage (u_X i ≫ p_X)).symm
    have hFT : ∀ i : Fin m, Algebra.FiniteType k₁ (A i) := by
      intro i
      have hLFT : AlgebraicGeometry.LocallyOfFiniteType
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ (A i)))) := by
        rw [← hu_pX i]
        infer_instance
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
    have hcov : ∀ x : ↥X, ∃ i : Fin m, x ∈ Set.range (u_X i).base := by
      intro x
      have hx : x ∈ (⊤ : X.Opens) := trivial
      rw [hsX_eq] at hx
      obtain ⟨w, hx1⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      obtain ⟨hw, hx2⟩ := TopologicalSpace.Opens.mem_iSup.mp hx1
      let i := eX.symm ⟨w, hw⟩
      refine ⟨i, ?_⟩
      change x ∈ Set.range (hU i).fromSpec.base
      rw [(hU i).range_fromSpec]
      change x ∈ (eX (eX.symm ⟨w, hw⟩)).1.1
      rwa [eX.apply_symm_apply]
    exact ⟨m, A, inferInstance, inferInstance, u_X, hFT, fun _ => inferInstance, hu_pX, hcov⟩

  have exists_tensorChart :
      ∀ (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
        (A : Type u) [CommRing A] [Algebra k₁ A]
        (u_X : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ X)
        [AlgebraicGeometry.IsOpenImmersion u_X],
        u_X ≫ p_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ A)) →
        ∀ (E : Type u) [CommRing E] [Algebra k₁ E],
          let s_E := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ E))
          ∃ (ι : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ A E)) ⟶
              CategoryTheory.Limits.pullback p_X s_E),
            AlgebraicGeometry.IsOpenImmersion ι ∧
            Set.range ι.base =
              (CategoryTheory.Limits.pullback.fst p_X s_E).base ⁻¹' Set.range u_X.base ∧
            ι ≫ CategoryTheory.Limits.pullback.fst p_X s_E =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫ u_X ∧
            ι ≫ CategoryTheory.Limits.pullback.snd p_X s_E =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom
                  (Algebra.TensorProduct.includeRight : E →ₐ[k₁] TensorProduct k₁ A E).toRingHom) := by
    intro X p_X A _ _ u_X _ hu_pX E _ _
    let s_E := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ E))
    let fst_AE : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ A E)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)
    let snd_AE : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ A E)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of E) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : E →ₐ[k₁] TensorProduct k₁ A E).toRingHom)
    have hPb_outer0 := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct k₁ A E)
    have hcomm : (fst_AE ≫ u_X) ≫ p_X = snd_AE ≫ s_E := by
      rw [Category.assoc, hu_pX]
      exact hPb_outer0.w
    let ι := CategoryTheory.Limits.pullback.lift (fst_AE ≫ u_X) snd_AE hcomm
    have hι_fst : ι ≫ CategoryTheory.Limits.pullback.fst p_X s_E = fst_AE ≫ u_X :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι_snd : ι ≫ CategoryTheory.Limits.pullback.snd p_X s_E = snd_AE :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_outer : CategoryTheory.IsPullback
        (ι ≫ CategoryTheory.Limits.pullback.snd p_X s_E) fst_AE s_E (u_X ≫ p_X) := by
      rw [hι_snd, hu_pX]
      exact hPb_outer0.flip
    have hPb_left : CategoryTheory.IsPullback ι fst_AE
        (CategoryTheory.Limits.pullback.fst p_X s_E) u_X :=
      CategoryTheory.IsPullback.of_right hPb_outer hι_fst
        (CategoryTheory.IsPullback.of_hasPullback p_X s_E).flip
    have hIso_fst : hPb_left.isoPullback.hom ≫
        CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.fst p_X s_E) u_X = ι :=
      hPb_left.isoPullback_hom_fst
    have hIso_inv_fst : hPb_left.isoPullback.inv ≫ ι =
        CategoryTheory.Limits.pullback.fst
          (CategoryTheory.Limits.pullback.fst p_X s_E) u_X :=
      hPb_left.isoPullback_inv_fst
    have hOpen : AlgebraicGeometry.IsOpenImmersion ι := by
      rw [← hIso_fst]
      infer_instance
    have hRange : Set.range ι.base =
        (CategoryTheory.Limits.pullback.fst p_X s_E).base ⁻¹' Set.range u_X.base := by
      rw [← hIso_fst]
      have h_comp : Set.range (hPb_left.isoPullback.hom ≫
          CategoryTheory.Limits.pullback.fst
            (CategoryTheory.Limits.pullback.fst p_X s_E) u_X).base =
          Set.range (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.Limits.pullback.fst p_X s_E) u_X).base := by
        ext y
        constructor
        · rintro ⟨z, rfl⟩
          exact ⟨hPb_left.isoPullback.hom.base z, rfl⟩
        · rintro ⟨w, rfl⟩
          refine ⟨hPb_left.isoPullback.inv.base w, ?_⟩
          rw [hIso_fst]
          exact congrArg (fun f => f.base w) hIso_inv_fst
      rw [h_comp, AlgebraicGeometry.Scheme.Pullback.range_fst]
    exact ⟨ι, hOpen, hRange, hι_fst, hι_snd⟩

  
  
  
  have subalgebra_baseChange_app_injective :
      ∀ [Algebra k₁ K'] (B : Subalgebra k₁ K')
        (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
        (π_X : CategoryTheory.Limits.pullback p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) ⟶
          CategoryTheory.Limits.pullback p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B)))),
        π_X ≫ CategoryTheory.Limits.pullback.fst p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) =
          CategoryTheory.Limits.pullback.fst p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) →
        π_X ≫ CategoryTheory.Limits.pullback.snd p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) =
          CategoryTheory.Limits.pullback.snd p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom B.val.toRingHom) →
        ∀ (U : (CategoryTheory.Limits.pullback p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B)))).Opens),
          Function.Injective (π_X.app U).hom := by
    intro _ B X p_X π_X hπ_fst hπ_snd U
    let β := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))
    let X_B := CategoryTheory.Limits.pullback p_X β
    rw [injective_iff_map_eq_zero]
    intro s hs
    apply TopCat.Presheaf.IsSheaf.section_ext X_B.sheaf.2 (U := Opposite.op U) (s := s) (t := 0)
    intro y _hyU
    obtain ⟨A, instRingA, instAlgA, u_X, hOpen_uX, hu_pX, hy_uX⟩ :=
      exists_point_affine_k1_chart X p_X ((CategoryTheory.Limits.pullback.fst p_X β).base y)
    letI : CommRing A := instRingA
    letI : Algebra k₁ A := instAlgA
    haveI : AlgebraicGeometry.IsOpenImmersion u_X := hOpen_uX
    obtain ⟨ι_B, hOpen_B, hRange_B, hFst_B, hSnd_B⟩ :=
      exists_tensorChart X p_X A u_X hu_pX ↥B
    obtain ⟨ι_K, hOpen_K, _hRange_K, hFst_K, hSnd_K⟩ :=
      exists_tensorChart X p_X A u_X hu_pX K'
    haveI : AlgebraicGeometry.IsOpenImmersion ι_B := hOpen_B
    haveI : AlgebraicGeometry.IsOpenImmersion ι_K := hOpen_K
    let ψ_A : TensorProduct k₁ A ↥B →ₐ[k₁] TensorProduct k₁ A K' :=
      Algebra.TensorProduct.map (AlgHom.id k₁ A) B.val
    have hψ_inj : Function.Injective ψ_A :=
      tensor_map_injective B.val Subtype.val_injective A
    have hι_comm : ι_K ≫ π_X =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_A.toRingHom) ≫ ι_B := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hπ_fst, hFst_K, Category.assoc, hFst_B,
          ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rfl
      · rw [Category.assoc, hπ_snd, ← Category.assoc, hSnd_K, Category.assoc, hSnd_B,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        rfl
    have hy_range : y ∈ Set.range ι_B.base := by
      rw [hRange_B]
      exact hy_uX
    rcases hy_range with ⟨z, hzy⟩
    have hz_open : z ∈ (TopologicalSpace.Opens.map ι_B.base).obj U := by
      change ι_B.base z ∈ U
      rwa [hzy]
    obtain ⟨_, ⟨h, rfl⟩, hzh, hh_sub⟩ :=
      TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
        PrimeSpectrum.isTopologicalBasis_basic_opens hz_open
        ((TopologicalSpace.Opens.map ι_B.base).obj U).2
    let j_B := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (TensorProduct k₁ A ↥B) (Localization.Away h)))
    let u_h := j_B ≫ ι_B
    haveI : AlgebraicGeometry.IsOpenImmersion u_h := inferInstance
    let V_y : X_B.Opens := u_h.opensFunctor.obj ⊤
    have hVU : V_y ≤ U := by
      rintro x ⟨z₀, _, rfl⟩
      have hz₀_range : (j_B.base z₀ : PrimeSpectrum (TensorProduct k₁ A ↥B)) ∈
          (PrimeSpectrum.basicOpen h : Set (PrimeSpectrum (TensorProduct k₁ A ↥B))) := by
        rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h) h]
        exact ⟨z₀, rfl⟩
      exact hh_sub hz₀_range
    have hyVy : y ∈ V_y := by
      have hzh' : (z : PrimeSpectrum (TensorProduct k₁ A ↥B)) ∈
          Set.range (PrimeSpectrum.comap (algebraMap _ (Localization.Away h))) := by
        rwa [PrimeSpectrum.localization_away_comap_range (Localization.Away h) h]
      rcases hzh' with ⟨z₀, hyz₀⟩
      have hjz₀ : j_B.base z₀ = z := hyz₀
      exact ⟨z₀, trivial, (congrArg ι_B.base hjz₀).trans hzy⟩
    refine ⟨V_y, hVU, hyVy, ?_⟩
    rw [map_zero]
    set s' : ↑(X_B.presheaf.obj (Opposite.op V_y)) :=
      (X_B.presheaf.map (CategoryTheory.homOfLE hVU).op).hom s
    let j_K := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (TensorProduct k₁ A K') (Localization.Away (ψ_A h))))
    let u_hK := j_K ≫ ι_K
    obtain ⟨lam_h, h_lam_inj, h_lam_comp, _⟩ :=
      exists_awayLift ψ_A.toRingHom hψ_inj h (ψ_A h) rfl
    have hu_comm : u_hK ≫ π_X = AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_h) ≫ u_h := by
      dsimp [u_hK, u_h, j_K, j_B]
      rw [Category.assoc, hι_comm, ← Category.assoc, ← Category.assoc]
      congr 1
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, h_lam_comp]
    have hle_uh : (⊤ : (AlgebraicGeometry.Spec _).Opens) ≤
        (TopologicalSpace.Opens.map u_h.base).obj V_y :=
      fun z₀ hz₀ => ⟨z₀, hz₀, rfl⟩
    have hle_comp : (⊤ : (AlgebraicGeometry.Spec _).Opens) ≤
        (TopologicalSpace.Opens.map (u_hK ≫ π_X).base).obj V_y := by
      rw [hu_comm]
      intro _ _
      exact hle_uh trivial
    have h_eval_zero : ((u_hK ≫ π_X).appLE V_y ⊤ hle_comp).hom s' = 0 := by
      have hmap := AlgebraicGeometry.Scheme.Hom.map_appLE (u_hK ≫ π_X) hle_comp
        (CategoryTheory.homOfLE hVU).op
      have h1 : ((u_hK ≫ π_X).appLE V_y ⊤ hle_comp).hom s' =
          ((u_hK ≫ π_X).appLE U ⊤ (fun z₀ hz₀ => hVU (hle_comp hz₀))).hom s :=
        congrArg (fun f => f.hom s) hmap
      rw [h1, ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE u_hK π_X U
        ((TopologicalSpace.Opens.map π_X.base).obj U) ⊤ (le_refl _)
        (fun _ _ => hVU (hle_comp trivial))]
      change (u_hK.appLE _ ⊤ _).hom ((π_X.appLE U _ _).hom s) = 0
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE, hs, map_zero]
    have h_eval_rhs : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_h) ≫ u_h).appLE
        V_y ⊤ (hu_comm ▸ hle_comp)).hom s' = 0 := by
      simpa only [hu_comm] using h_eval_zero
    rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_h)) u_h V_y ⊤ ⊤ hle_uh
      (fun _ _ => trivial)] at h_eval_rhs
    change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_h)).appLE ⊤ ⊤ _).hom
      ((u_h.appLE V_y ⊤ hle_uh).hom s') = 0 at h_eval_rhs
    have happTop_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_h)).appLE ⊤ ⊤
        (fun _ _ => trivial) = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_h)).appTop := by
      rw [AlgebraicGeometry.Scheme.Hom.appTop, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      rfl
    rw [happTop_eq] at h_eval_rhs
    have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom lam_h)
    have h_lam_zero : lam_h ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom.hom
        ((u_h.appLE V_y ⊤ hle_uh).hom s')) = 0 := by
      have h2 := congrArg (fun f => f.hom ((u_h.appLE V_y ⊤ hle_uh).hom s')) hnat.symm
      change lam_h ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom.hom
        ((u_h.appLE V_y ⊤ hle_uh).hom s')) =
        (AlgebraicGeometry.Scheme.ΓSpecIso _).hom.hom
          (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom lam_h)).appTop).hom
            ((u_h.appLE V_y ⊤ hle_uh).hom s')) at h2
      rw [h_eval_rhs, map_zero] at h2
      exact h2
    have h_γ_zero : (AlgebraicGeometry.Scheme.ΓSpecIso _).hom.hom
        ((u_h.appLE V_y ⊤ hle_uh).hom s') = 0 :=
      h_lam_inj (h_lam_zero.trans (map_zero _).symm)
    have h_uh_zero : (u_h.appLE V_y ⊤ hle_uh).hom s' = 0 := by
      have h_id := congrArg (fun fn => fn.hom ((u_h.appLE V_y ⊤ hle_uh).hom s'))
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Localization.Away h))).hom_inv_id
      change (AlgebraicGeometry.Scheme.ΓSpecIso _).inv.hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso _).hom.hom ((u_h.appLE V_y ⊤ hle_uh).hom s')) =
        (u_h.appLE V_y ⊤ hle_uh).hom s' at h_id
      rw [h_γ_zero, map_zero] at h_id
      exact h_id.symm
    have h_uh_iso : (u_h.appIso ⊤).hom.hom s' = 0 := by
      rwa [AlgebraicGeometry.Scheme.Hom.appIso_hom']
    have hs'_zero : s' = 0 := by
      have h_id := congrArg (fun fn => fn.hom s') (u_h.appIso ⊤).hom_inv_id
      change (u_h.appIso ⊤).inv.hom ((u_h.appIso ⊤).hom.hom s') = s' at h_id
      rw [h_uh_iso, map_zero] at h_id
      exact h_id.symm
    exact hs'_zero

  
  
  
  have openImmersion_pullback_cancel :
      ∀ {S W P Q T : AlgebraicGeometry.Scheme.{u}} [T.IsSeparated]
        (π : W ⟶ S),
        (∀ U : S.Opens, Function.Injective (π.app U).hom) →
        ∀ (u : P ⟶ S) [AlgebraicGeometry.IsOpenImmersion u]
          (q : Q ⟶ P) (π_Q : Q ⟶ W),
          CategoryTheory.IsPullback q π_Q u π →
          ∀ (g₁ g₂ : P ⟶ T), q ≫ g₁ = q ≫ g₂ → g₁ = g₂ := by
    intro S W P Q T _ π hInj u _ q π_Q hPb g₁ g₂ hEq
    have hIso_πQ : hPb.flip.isoPullback.hom ≫ CategoryTheory.Limits.pullback.fst π u = π_Q :=
      hPb.flip.isoPullback_hom_fst
    have hIso_inv_πQ : hPb.flip.isoPullback.inv ≫ π_Q = CategoryTheory.Limits.pullback.fst π u :=
      hPb.flip.isoPullback_inv_fst
    haveI : AlgebraicGeometry.IsOpenImmersion π_Q := by
      rw [← hIso_πQ]
      infer_instance
    have hRange_πQ : Set.range π_Q.base = π.base ⁻¹' Set.range u.base := by
      rw [← hIso_πQ]
      have h_comp : Set.range (hPb.flip.isoPullback.hom ≫
          CategoryTheory.Limits.pullback.fst π u).base =
          Set.range (CategoryTheory.Limits.pullback.fst π u).base := by
        ext y
        constructor
        · rintro ⟨z, rfl⟩
          exact ⟨hPb.flip.isoPullback.hom.base z, rfl⟩
        · rintro ⟨w, rfl⟩
          refine ⟨hPb.flip.isoPullback.inv.base w, ?_⟩
          rw [hIso_πQ]
          exact congrArg (fun f => f.base w) hIso_inv_πQ
      rw [h_comp, AlgebraicGeometry.Scheme.Pullback.range_fst]
    have hq_inj : ∀ V : P.Opens, Function.Injective (q.app V).hom := by
      intro V
      rw [injective_iff_map_eq_zero]
      intro s hs
      let U : S.Opens := u.opensFunctor.obj V
      let W₀ : Q.Opens := (TopologicalSpace.Opens.map q.base).obj V
      have hle_u : V ≤ (TopologicalSpace.Opens.map u.base).obj U :=
        fun x hx => ⟨x, hx, rfl⟩
      have hle_πQ : W₀ ≤ (TopologicalSpace.Opens.map π_Q.base).obj
          ((TopologicalSpace.Opens.map π.base).obj U) := by
        intro z hz
        change π.base (π_Q.base z) ∈ u.base '' (V : Set P)
        have hcomm_pt := congrArg (fun f => f.base z) hPb.w
        change u.base (q.base z) = π.base (π_Q.base z) at hcomm_pt
        rw [← hcomm_pt]
        exact ⟨q.base z, hz, rfl⟩
      have hUW_eq : (TopologicalSpace.Opens.map π.base).obj U = π_Q.opensFunctor.obj W₀ := by
        apply le_antisymm
        · intro w hw
          rcases hw with ⟨v, hvV, hw_eq⟩
          have hw_pre : w ∈ π.base ⁻¹' Set.range u.base := ⟨v, hw_eq⟩
          rw [← hRange_πQ] at hw_pre
          rcases hw_pre with ⟨z, rfl⟩
          refine ⟨z, ?_, rfl⟩
          have hcomm_pt := congrArg (fun f => f.base z) hPb.w
          change u.base (q.base z) = π.base (π_Q.base z) at hcomm_pt
          have huv : u.base (q.base z) = u.base v := hcomm_pt.trans hw_eq.symm
          have hzv : q.base z = v := u.isOpenEmbedding.injective huv
          change q.base z ∈ V
          rwa [hzv]
        · rintro w ⟨z, hz, rfl⟩
          exact hle_πQ hz
      let s_U : ↑(S.presheaf.obj (Opposite.op U)) := (u.appIso V).inv.hom s
      have hs_U : (u.appLE U V hle_u).hom s_U = s := by
        have h_iso := (u.appIso V).inv_hom_id
        rw [AlgebraicGeometry.Scheme.Hom.appIso_hom'] at h_iso
        exact congrArg (fun f => f.hom s) h_iso
      have h_comp1 : ((q ≫ u).appLE U W₀ (fun z hz => hle_u hz)).hom s_U = 0 := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE q u U V W₀ hle_u (le_refl W₀)]
        change (q.appLE V W₀ (le_refl W₀)).hom ((u.appLE U V hle_u).hom s_U) = 0
        rw [hs_U, ← AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        exact hs
      have h_comp2 : ((π_Q ≫ π).appLE U W₀ (fun z hz => hle_πQ hz)).hom s_U = 0 := by
        simpa only [hPb.w] using h_comp1
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE π_Q π U
        ((TopologicalSpace.Opens.map π.base).obj U) W₀ (le_refl _) hle_πQ] at h_comp2
      change (π_Q.appLE ((TopologicalSpace.Opens.map π.base).obj U) W₀ hle_πQ).hom
        ((π.appLE U ((TopologicalSpace.Opens.map π.base).obj U) (le_refl _)).hom s_U) = 0 at h_comp2
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE] at h_comp2
      have h_cancel_appLE : ∀ (O_W : W.Opens) (hEqO : O_W = π_Q.opensFunctor.obj W₀)
          (hle : W₀ ≤ (TopologicalSpace.Opens.map π_Q.base).obj O_W)
          (x_W : ↑(W.presheaf.obj (Opposite.op O_W))),
          (π_Q.appLE O_W W₀ hle).hom x_W = 0 → x_W = 0 := by
        intro O_W hEqO hle x_W hx_W
        subst hEqO
        have hx_iso : (π_Q.appIso W₀).hom.hom x_W = 0 := by
          rwa [AlgebraicGeometry.Scheme.Hom.appIso_hom']
        have h_id := congrArg (fun fn => fn.hom x_W) (π_Q.appIso W₀).hom_inv_id
        change (π_Q.appIso W₀).inv.hom ((π_Q.appIso W₀).hom.hom x_W) = x_W at h_id
        rw [hx_iso, map_zero] at h_id
        exact h_id.symm
      have hπ_sU : (π.app U).hom s_U = 0 :=
        h_cancel_appLE _ hUW_eq hle_πQ ((π.app U).hom s_U) h_comp2
      have hsU_zero : s_U = 0 := hInj U (hπ_sU.trans (map_zero _).symm)
      rw [← hs_U, hsU_zero, map_zero]
    let e := CategoryTheory.Limits.equalizer.ι g₁ g₂
    let q_hat := CategoryTheory.Limits.equalizer.lift q hEq
    have hfac : q_hat ≫ e = q := CategoryTheory.Limits.equalizer.lift_ι q hEq
    have he_inj : ∀ V : P.Opens, Function.Injective (e.app V).hom := by
      intro V
      rw [injective_iff_map_eq_zero]
      intro s hs
      have hle_qe : (TopologicalSpace.Opens.map q.base).obj V ≤
          (TopologicalSpace.Opens.map q_hat.base).obj
            ((TopologicalSpace.Opens.map e.base).obj V) := by
        rw [← hfac]
        exact le_refl _
      have hle_qe' : (TopologicalSpace.Opens.map q.base).obj V ≤
          (TopologicalSpace.Opens.map (q_hat ≫ e).base).obj V := by
        rw [hfac]
      have h1 : (q.app V).hom s = 0 := by
        rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
        have hq_eq : q.appLE V ((TopologicalSpace.Opens.map q.base).obj V) (le_refl _) =
            (q_hat ≫ e).appLE V ((TopologicalSpace.Opens.map q.base).obj V) hle_qe' := by
          congr 1
          exact hfac.symm
        rw [hq_eq, ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE q_hat e V
          ((TopologicalSpace.Opens.map e.base).obj V)
          ((TopologicalSpace.Opens.map q.base).obj V) (le_refl _) hle_qe]
        change (q_hat.appLE _ _ hle_qe).hom ((e.appLE V _ (le_refl _)).hom s) = 0
        rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE, hs, map_zero]
      exact hq_inj V (h1.trans (map_zero _).symm)
    have he_iso : CategoryTheory.IsIso e := by
      rw [AlgebraicGeometry.IsClosedImmersion.isIso_iff_ker_eq_bot]
      ext U x
      simp only [AlgebraicGeometry.Scheme.Hom.ker_apply, RingHom.mem_ker]
      exact ⟨fun hx => he_inj U.1 (hx.trans (map_zero _).symm),
        fun hx => by
          have hx0 : x = 0 := hx
          rw [hx0, map_zero]⟩
    exact (CategoryTheory.cancel_epi e).mp (CategoryTheory.Limits.equalizer.condition g₁ g₂)

  
  
  
  have glue_over_pullback_openCover :
      ∀ {X_B W_B X_K W_K S_B : AlgebraicGeometry.Scheme.{u}} [W_B.IsSeparated]
        (snd_XB : X_B ⟶ S_B) (snd_WB : W_B ⟶ S_B)
        (π_X : X_K ⟶ X_B) (π_W : W_K ⟶ W_B) (f : X_K ⟶ W_K),
        (∀ U : X_B.Opens, Function.Injective (π_X.app U).hom) →
        ∀ (J : Type u) (S_ch S_K_ch : J → AlgebraicGeometry.Scheme.{u})
          (w : ∀ κ : J, S_ch κ ⟶ X_B) [∀ κ, AlgebraicGeometry.IsOpenImmersion (w κ)]
          (w_K : ∀ κ : J, S_K_ch κ ⟶ X_K) [∀ κ, AlgebraicGeometry.IsOpenImmersion (w_K κ)],
          (∀ x : X_B, ∃ κ y, (w κ).base y = x) →
          (∀ x : X_K, ∃ κ y, (w_K κ).base y = x) →
          ∀ (g : ∀ κ : J, S_ch κ ⟶ W_B)
            (p_loc : ∀ κ : J, S_K_ch κ ⟶ S_ch κ),
            (∀ κ : J, g κ ≫ snd_WB = w κ ≫ snd_XB) →
            (∀ κ : J, CategoryTheory.IsPullback (p_loc κ) (w_K κ) (w κ) π_X) →
            (∀ κ : J, p_loc κ ≫ g κ = w_K κ ≫ f ≫ π_W) →
            ∃ f_B : X_B ⟶ W_B, f_B ≫ snd_WB = snd_XB ∧ π_X ≫ f_B = f ≫ π_W := by
    intro X_B W_B X_K W_K S_B _ snd_XB snd_WB π_X π_W f hInj J S_ch S_K_ch w _ w_K _
      hcov_B hcov_K g p_loc hg_snd hPb_loc hg_comm
    have h_overlap : ∀ κ₁ κ₂ : J,
        CategoryTheory.Limits.pullback.fst (w κ₁) (w κ₂) ≫ g κ₁ =
        CategoryTheory.Limits.pullback.snd (w κ₁) (w κ₂) ≫ g κ₂ := by
      intro κ₁ κ₂
      let fst₁₂ := CategoryTheory.Limits.pullback.fst (w κ₁) (w κ₂)
      let snd₁₂ := CategoryTheory.Limits.pullback.snd (w κ₁) (w κ₂)
      let u := fst₁₂ ≫ w κ₁
      let q := CategoryTheory.Limits.pullback.fst u π_X
      let π_Q := CategoryTheory.Limits.pullback.snd u π_X
      have hPb_u : CategoryTheory.IsPullback q π_Q u π_X :=
        CategoryTheory.IsPullback.of_hasPullback u π_X
      have hcond₁ : (q ≫ fst₁₂) ≫ w κ₁ = π_Q ≫ π_X := by
        rw [Category.assoc]
        exact hPb_u.w
      have hcond₂ : (q ≫ snd₁₂) ≫ w κ₂ = π_Q ≫ π_X := by
        rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition]
        exact hPb_u.w
      let l₁ := (hPb_loc κ₁).lift (q ≫ fst₁₂) π_Q hcond₁
      let l₂ := (hPb_loc κ₂).lift (q ≫ snd₁₂) π_Q hcond₂
      have hl₁_fst : l₁ ≫ p_loc κ₁ = q ≫ fst₁₂ := (hPb_loc κ₁).lift_fst _ _ _
      have hl₁_snd : l₁ ≫ w_K κ₁ = π_Q := (hPb_loc κ₁).lift_snd _ _ _
      have hl₂_fst : l₂ ≫ p_loc κ₂ = q ≫ snd₁₂ := (hPb_loc κ₂).lift_fst _ _ _
      have hl₂_snd : l₂ ≫ w_K κ₂ = π_Q := (hPb_loc κ₂).lift_snd _ _ _
      apply openImmersion_pullback_cancel π_X hInj u q π_Q hPb_u
      calc
        q ≫ (fst₁₂ ≫ g κ₁) = (q ≫ fst₁₂) ≫ g κ₁ := (Category.assoc _ _ _).symm
        _ = (l₁ ≫ p_loc κ₁) ≫ g κ₁ := by rw [hl₁_fst]
        _ = l₁ ≫ (p_loc κ₁ ≫ g κ₁) := Category.assoc _ _ _
        _ = l₁ ≫ (w_K κ₁ ≫ f ≫ π_W) := by rw [hg_comm κ₁]
        _ = (l₁ ≫ w_K κ₁) ≫ f ≫ π_W := (Category.assoc _ _ _).symm
        _ = π_Q ≫ f ≫ π_W := by rw [hl₁_snd]
        _ = (l₂ ≫ w_K κ₂) ≫ f ≫ π_W := by rw [hl₂_snd]
        _ = l₂ ≫ (w_K κ₂ ≫ f ≫ π_W) := Category.assoc _ _ _
        _ = l₂ ≫ (p_loc κ₂ ≫ g κ₂) := by rw [hg_comm κ₂]
        _ = (l₂ ≫ p_loc κ₂) ≫ g κ₂ := (Category.assoc _ _ _).symm
        _ = (q ≫ snd₁₂) ≫ g κ₂ := by rw [hl₂_fst]
        _ = q ≫ (snd₁₂ ≫ g κ₂) := Category.assoc _ _ _
    let 𝒰_B : X_B.OpenCover := AlgebraicGeometry.Scheme.Cover.mkOfCovers J S_ch w hcov_B
    let 𝒰_K : X_K.OpenCover := AlgebraicGeometry.Scheme.Cover.mkOfCovers J S_K_ch w_K hcov_K
    let f_B : X_B ⟶ W_B := 𝒰_B.glueMorphisms g h_overlap
    have hf_B : ∀ κ : J, w κ ≫ f_B = g κ := fun κ => 𝒰_B.ι_glueMorphisms g h_overlap κ
    refine ⟨f_B, ?_, ?_⟩
    · apply 𝒰_B.hom_ext
      intro κ
      change w κ ≫ (f_B ≫ snd_WB) = w κ ≫ snd_XB
      rw [← Category.assoc, hf_B κ, hg_snd κ]
    · apply 𝒰_K.hom_ext
      intro κ
      change w_K κ ≫ (π_X ≫ f_B) = w_K κ ≫ (f ≫ π_W)
      rw [← Category.assoc, (hPb_loc κ).w.symm, Category.assoc, hf_B κ, hg_comm κ]

  
  have pullback_isSeparated :
      ∀ {W : AlgebraicGeometry.Scheme.{u}}
        (p_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
        [AlgebraicGeometry.IsProper p_W]
        (E : Type u) [CommRing E] [Algebra k₁ E],
        (CategoryTheory.Limits.pullback p_W
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ E)))).IsSeparated := by
    intro W p_W _ E _ _
    let s_E := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ E))
    have h_term : CategoryTheory.Limits.terminal.from (CategoryTheory.Limits.pullback p_W s_E) =
        CategoryTheory.Limits.pullback.snd p_W s_E ≫
          CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of E)) :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    exact AlgebraicGeometry.Scheme.IsSeparated.mk (by rw [h_term]; infer_instance)

  
  
  
  have proper_morphism_spread_out :
      ∀ [Algebra k₁ K']
        (X W : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
        (p_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
        [AlgebraicGeometry.IsProper p_X] [AlgebraicGeometry.IsProper p_W]
        (f : CategoryTheory.Limits.pullback p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) ⟶
          CategoryTheory.Limits.pullback p_W
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K')))),
        f ≫ CategoryTheory.Limits.pullback.snd p_W
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) =
          CategoryTheory.Limits.pullback.snd p_X
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) →
        ∃ (B : Subalgebra k₁ K') (_ : B.FG)
          (f_B : CategoryTheory.Limits.pullback p_X
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) ⟶
            CategoryTheory.Limits.pullback p_W
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B)))),
          f_B ≫ CategoryTheory.Limits.pullback.snd p_W
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) =
            CategoryTheory.Limits.pullback.snd p_X
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) ∧
          ∀ (π_X : CategoryTheory.Limits.pullback p_X
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) ⟶
              CategoryTheory.Limits.pullback p_X
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))))
            (π_W : CategoryTheory.Limits.pullback p_W
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) ⟶
              CategoryTheory.Limits.pullback p_W
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B)))),
            π_X ≫ CategoryTheory.Limits.pullback.fst p_X
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) =
              CategoryTheory.Limits.pullback.fst p_X
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) →
            π_X ≫ CategoryTheory.Limits.pullback.snd p_X
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) =
              CategoryTheory.Limits.pullback.snd p_X
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom B.val.toRingHom) →
            π_W ≫ CategoryTheory.Limits.pullback.fst p_W
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) =
              CategoryTheory.Limits.pullback.fst p_W
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) →
            π_W ≫ CategoryTheory.Limits.pullback.snd p_W
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))) =
              CategoryTheory.Limits.pullback.snd p_W
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom B.val.toRingHom) →
            π_X ≫ f_B = f ≫ π_W := by
    intro _ X W p_X p_W _ _ f hf
    classical
    
    obtain ⟨m, A, instRingA, instAlgA, u_X, _hA_ft, hOpen_uX, huX_pX, huX_cov⟩ :=
      exists_finite_affine_k1_cover X p_X
    obtain ⟨n, C, instRingC, instAlgC, v_W, hC_ft, hOpen_vW, hvW_pW, hvW_cov⟩ :=
      exists_finite_affine_k1_cover W p_W
    letI : ∀ i : Fin m, CommRing (A i) := instRingA
    letI : ∀ i : Fin m, Algebra k₁ (A i) := instAlgA
    letI : ∀ b : Fin n, CommRing (C b) := instRingC
    letI : ∀ b : Fin n, Algebra k₁ (C b) := instAlgC
    haveI : ∀ i : Fin m, AlgebraicGeometry.IsOpenImmersion (u_X i) := hOpen_uX
    haveI : ∀ b : Fin n, AlgebraicGeometry.IsOpenImmersion (v_W b) := hOpen_vW

    obtain ⟨d, hd_pres⟩ := Classical.axiomOfChoice fun b : Fin n =>
      Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (hC_ft b)
    obtain ⟨π_C, hπ_C⟩ := Classical.axiomOfChoice hd_pres

    
    let α := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))
    obtain ⟨ι_XK, hι_XK⟩ := Classical.axiomOfChoice fun i : Fin m =>
      exists_tensorChart X p_X (A i) (u_X i) (huX_pX i) K'
    obtain ⟨ι_WK, hι_WK⟩ := Classical.axiomOfChoice fun b : Fin n =>
      exists_tensorChart W p_W (C b) (v_W b) (hvW_pW b) K'
    haveI : ∀ i : Fin m, AlgebraicGeometry.IsOpenImmersion (ι_XK i) := fun i => (hι_XK i).1
    haveI : ∀ b : Fin n, AlgebraicGeometry.IsOpenImmersion (ι_WK b) := fun b => (hι_WK b).1

    
    have hAff_f : ∀ i : Fin m, AlgebraicGeometry.IsAffineHom (ι_XK i ≫ f) := by
      intro i
      have h_comp_eq : (ι_XK i ≫ f) ≫ CategoryTheory.Limits.pullback.snd p_W α =
          ι_XK i ≫ CategoryTheory.Limits.pullback.snd p_X α := by
        rw [Category.assoc, hf]
      have : AlgebraicGeometry.IsAffineHom
          ((ι_XK i ≫ f) ≫ CategoryTheory.Limits.pullback.snd p_W α) := by
        rw [h_comp_eq, (hι_XK i).2.2.2]
        infer_instance
      exact AlgebraicGeometry.IsAffineHom.of_comp (ι_XK i ≫ f)
        (CategoryTheory.Limits.pullback.snd p_W α)
    have hBasic_ex : ∀ (i : Fin m) (b : Fin n),
        ∃ (r : ℕ) (h_bar : Fin r → TensorProduct k₁ (A i) K'),
          ∀ z : ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ (A i) K'))),
            (ι_XK i ≫ f).base z ∈ Set.range (ι_WK b).base ↔
              ∃ γ : Fin r,
                (z : PrimeSpectrum (TensorProduct k₁ (A i) K')) ∈
                  PrimeSpectrum.basicOpen (h_bar γ) := by
      intro i b
      let S_Ai := AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ (A i) K'))
      let O : S_Ai.Opens :=
        (TopologicalSpace.Opens.map (ι_XK i ≫ f).base).obj (ι_WK b).opensRange
      have hO_aff : AlgebraicGeometry.IsAffineOpen O := by
        haveI := hAff_f i
        exact AlgebraicGeometry.IsAffineHom.isAffine_preimage (ι_WK b).opensRange
          (AlgebraicGeometry.isAffineOpen_opensRange (ι_WK b))
      have hO_comp : IsCompact (O : Set ↥S_Ai) := hO_aff.isCompact
      obtain ⟨r_pt, hr_pt⟩ := Classical.axiomOfChoice fun z : ↥O =>
        show ∃ r_z : TensorProduct k₁ (A i) K',
            (z.1 : PrimeSpectrum (TensorProduct k₁ (A i) K')) ∈ PrimeSpectrum.basicOpen r_z ∧
              ∀ w : ↥S_Ai,
                (w : PrimeSpectrum (TensorProduct k₁ (A i) K')) ∈ PrimeSpectrum.basicOpen r_z →
                  w ∈ O from by
          obtain ⟨_, ⟨r_z, rfl⟩, hzr, hr_sub⟩ :=
            TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
              PrimeSpectrum.isTopologicalBasis_basic_opens z.2 O.2
          exact ⟨r_z, hzr, fun w hw => hr_sub hw⟩
      obtain ⟨t, ht_cov⟩ := hO_comp.elim_finite_subcover
        (fun z : ↥O => {w : ↥S_Ai |
          (w : PrimeSpectrum (TensorProduct k₁ (A i) K')) ∈ PrimeSpectrum.basicOpen (r_pt z)})
        (fun z => (PrimeSpectrum.basicOpen (r_pt z)).isOpen)
        (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, (hr_pt ⟨x, hx⟩).1⟩)
      let N_t : ℕ := Fintype.card ↥t
      let e_t : Fin N_t ≃ ↥t := (Fintype.equivFin ↥t).symm
      refine ⟨N_t, fun γ => r_pt (e_t γ).1, fun z => ?_⟩
      constructor
      · intro hz
        have hzt := ht_cov hz
        simp only [Set.mem_iUnion] at hzt
        rcases hzt with ⟨w_pt, hwt, hzw⟩
        refine ⟨e_t.symm ⟨w_pt, hwt⟩, ?_⟩
        change (z : PrimeSpectrum _) ∈ PrimeSpectrum.basicOpen (r_pt (e_t (e_t.symm ⟨w_pt, hwt⟩)).1)
        rwa [e_t.apply_symm_apply]
      · rintro ⟨γ, hzγ⟩
        exact (hr_pt (e_t γ).1).2 z hzγ
    obtain ⟨r_ib, h_bar_pair⟩ := Classical.axiomOfChoice fun p : Fin m × Fin n =>
      hBasic_ex p.1 p.2
    obtain ⟨h_bar, hh_bar_iff⟩ := Classical.axiomOfChoice h_bar_pair
    let P_idx : Fin m → Type := fun i => Σ b : Fin n, Fin (r_ib (i, b))
    have hc_bar_ex : ∀ i : Fin m,
        ∃ c_bar : P_idx i → TensorProduct k₁ (A i) K',
          ∑ p : P_idx i, c_bar p * h_bar (i, p.1) p.2 = 1 := by
      intro i
      let h_fam : P_idx i → TensorProduct k₁ (A i) K' := fun p => h_bar (i, p.1) p.2
      have h_top : (⨆ p : P_idx i, PrimeSpectrum.basicOpen (h_fam p)) = ⊤ := by
        rw [eq_top_iff]
        intro z _
        let z_S : ↥(AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ (A i) K'))) := z
        let y_W : ↥W := (CategoryTheory.Limits.pullback.fst p_W α).base ((ι_XK i ≫ f).base z_S)
        obtain ⟨b, hy_Vb⟩ := hvW_cov y_W
        have hz_O : (ι_XK i ≫ f).base z_S ∈ Set.range (ι_WK b).base := by
          rw [(hι_WK b).2.1]
          exact hy_Vb
        obtain ⟨γ, hzγ⟩ := (hh_bar_iff (i, b) z_S).mp hz_O
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨b, γ⟩, hzγ⟩
      have h_span : Ideal.span (Set.range h_fam) = ⊤ :=
        (PrimeSpectrum.iSup_basicOpen_eq_top_iff).mp h_top
      have h_one : (1 : TensorProduct k₁ (A i) K') ∈ Ideal.span (Set.range h_fam) := by
        rw [h_span]
        exact Submodule.mem_top
      exact Ideal.mem_span_range_iff_exists_fun.mp h_one
    obtain ⟨c_bar, hc_bar⟩ := Classical.axiomOfChoice hc_bar_ex

    let K_idx : Type := Σ (i : Fin m) (b : Fin n), Fin (r_ib (i, b))
    have hθ_bar_ex : ∀ κ : K_idx,
        let h_κ : TensorProduct k₁ (A κ.1) K' := h_bar (κ.1, κ.2.1) κ.2.2
        let j_K := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (TensorProduct k₁ (A κ.1) K') (Localization.Away h_κ)))
        ∃ θ_bar : TensorProduct k₁ (C κ.2.1) K' →+* Localization.Away h_κ,
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_bar) ≫ ι_WK κ.2.1 =
            j_K ≫ ι_XK κ.1 ≫ f ∧
          θ_bar.comp (Algebra.TensorProduct.includeRight :
              K' →ₐ[k₁] TensorProduct k₁ (C κ.2.1) K').toRingHom =
            (algebraMap (TensorProduct k₁ (A κ.1) K') (Localization.Away h_κ)).comp
              (Algebra.TensorProduct.includeRight :
                K' →ₐ[k₁] TensorProduct k₁ (A κ.1) K').toRingHom := by
      intro κ
      let h_κ : TensorProduct k₁ (A κ.1) K' := h_bar (κ.1, κ.2.1) κ.2.2
      let j_K := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k₁ (A κ.1) K') (Localization.Away h_κ)))
      have hsub : Set.range (j_K ≫ ι_XK κ.1 ≫ f).base ⊆ Set.range (ι_WK κ.2.1).base := by
        rintro _ ⟨w₀, rfl⟩
        have hw₀ : (j_K.base w₀ : PrimeSpectrum (TensorProduct k₁ (A κ.1) K')) ∈
            (PrimeSpectrum.basicOpen h_κ : Set (PrimeSpectrum (TensorProduct k₁ (A κ.1) K'))) := by
          rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h_κ) h_κ]
          exact ⟨w₀, rfl⟩
        exact (hh_bar_iff (κ.1, κ.2.1) (j_K.base w₀)).mpr ⟨κ.2.2, hw₀⟩
      let g_lift := AlgebraicGeometry.IsOpenImmersion.lift (ι_WK κ.2.1) (j_K ≫ ι_XK κ.1 ≫ f) hsub
      have hg_fac : g_lift ≫ ι_WK κ.2.1 = j_K ≫ ι_XK κ.1 ≫ f :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (ι_WK κ.2.1) (j_K ≫ ι_XK κ.1 ≫ f) hsub
      let θ_bar := (AlgebraicGeometry.Spec.preimage g_lift).hom
      have hSpec_θ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_bar) = g_lift :=
        AlgebraicGeometry.Spec.map_preimage g_lift
      refine ⟨θ_bar, hSpec_θ.symm ▸ hg_fac, ?_⟩
      have h_snd := congrArg (fun u => u ≫ CategoryTheory.Limits.pullback.snd p_W α)
        (hSpec_θ.symm ▸ hg_fac)
      dsimp at h_snd
      rw [Category.assoc, (hι_WK κ.2.1).2.2.2, Category.assoc, Category.assoc, hf,
        (hι_XK κ.1).2.2.2,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp] at h_snd
      have h_pre := congrArg AlgebraicGeometry.Spec.preimage h_snd
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at h_pre
      exact congrArg CommRingCat.Hom.hom h_pre
    obtain ⟨θ_bar, hθ_bar_spec⟩ := Classical.axiomOfChoice hθ_bar_ex

    
    let Gen_idx : Type := Σ (κ : K_idx), Fin (d κ.2.1)
    let p_bar_fam : ∀ g : Gen_idx, TensorProduct k₁ (A g.1.1) K' := fun g =>
      (IsLocalization.Away.sec (h_bar (g.1.1, g.1.2.1) g.1.2.2)
        ((θ_bar g.1) (Algebra.TensorProduct.includeLeftRingHom
          ((π_C g.1.2.1) (MvPolynomial.X g.2))))).1
    let exp_fam : Gen_idx → ℕ := fun g =>
      (IsLocalization.Away.sec (h_bar (g.1.1, g.1.2.1) g.1.2.2)
        ((θ_bar g.1) (Algebra.TensorProduct.includeLeftRingHom
          ((π_C g.1.2.1) (MvPolynomial.X g.2))))).2

    
    let All_idx : Type u :=
      ULift.{u} (K_idx ⊕ (Σ i : Fin m, P_idx i) ⊕ Gen_idx)
    let idx_to_i : All_idx → Fin m := fun idx =>
      match idx.down with
      | Sum.inl κ => κ.1
      | Sum.inr (Sum.inl ip) => ip.1
      | Sum.inr (Sum.inr g) => g.1.1
    let x_all : ∀ idx : All_idx, TensorProduct k₁ (A (idx_to_i idx)) K' := fun ⟨d_idx⟩ =>
      match d_idx with
      | Sum.inl κ => h_bar (κ.1, κ.2.1) κ.2.2
      | Sum.inr (Sum.inl ip) => c_bar ip.1 ip.2
      | Sum.inr (Sum.inr g) => p_bar_fam g
    obtain ⟨B, hFG, hx_all⟩ := exists_fg_lift_family All_idx (fun idx => A (idx_to_i idx)) x_all
    obtain ⟨h₀, hh₀⟩ := Classical.axiomOfChoice fun κ : K_idx =>
      show ∃ y : TensorProduct k₁ (A κ.1) ↥B,
          Algebra.TensorProduct.map (AlgHom.id k₁ (A κ.1)) B.val y =
            h_bar (κ.1, κ.2.1) κ.2.2 from
        hx_all (ULift.up (Sum.inl κ))
    obtain ⟨c₀_pair, hc₀_pair⟩ := Classical.axiomOfChoice fun i : Fin m =>
      Classical.axiomOfChoice fun p : P_idx i =>
        show ∃ y : TensorProduct k₁ (A i) ↥B,
            Algebra.TensorProduct.map (AlgHom.id k₁ (A i)) B.val y =
              c_bar i p from
          hx_all (ULift.up (Sum.inr (Sum.inl ⟨i, p⟩)))
    obtain ⟨p₀, hp₀⟩ := Classical.axiomOfChoice fun g : Gen_idx =>
      show ∃ y : TensorProduct k₁ (A g.1.1) ↥B,
          Algebra.TensorProduct.map (AlgHom.id k₁ (A g.1.1)) B.val y =
            p_bar_fam g from
        hx_all (ULift.up (Sum.inr (Sum.inr g)))

    let ψ_A : ∀ i : Fin m, TensorProduct k₁ (A i) ↥B →ₐ[k₁] TensorProduct k₁ (A i) K' :=
      fun i => Algebra.TensorProduct.map (AlgHom.id k₁ (A i)) B.val
    let ψ_C : ∀ b : Fin n, TensorProduct k₁ (C b) ↥B →ₐ[k₁] TensorProduct k₁ (C b) K' :=
      fun b => Algebra.TensorProduct.map (AlgHom.id k₁ (C b)) B.val
    have hψ_A_inj : ∀ i : Fin m, Function.Injective (ψ_A i) :=
      fun i => tensor_map_injective B.val Subtype.val_injective (A i)

    
    have hc₀_sum : ∀ i : Fin m,
        ∑ p : P_idx i, c₀_pair i p * (h₀ ⟨i, p.1, p.2⟩ : TensorProduct k₁ (A i) ↥B) = 1 := by
      intro i
      apply hψ_A_inj i
      rw [map_sum, map_one]
      have h_terms : ∀ p : P_idx i,
          ψ_A i (c₀_pair i p * (h₀ ⟨i, p.1, p.2⟩ : TensorProduct k₁ (A i) ↥B)) =
            c_bar i p * h_bar (i, p.1) p.2 := by
        intro p
        rw [map_mul, hc₀_pair i p, hh₀ ⟨i, p.1, p.2⟩]
      simp_rw [h_terms]
      exact hc_bar i

    
    obtain ⟨lam_κ, hlam_spec⟩ := Classical.axiomOfChoice fun κ : K_idx =>
      exists_awayLift (ψ_A κ.1).toRingHom (hψ_A_inj κ.1)
        (h₀ κ) (h_bar (κ.1, κ.2.1) κ.2.2 : TensorProduct k₁ (A κ.1) K') (hh₀ κ)
    have hlam_alg : ∀ (κ : K_idx) (z : TensorProduct k₁ (A κ.1) ↥B),
        lam_κ κ (algebraMap _ (Localization.Away (h₀ κ)) z) =
          algebraMap _ (Localization.Away (h_bar (κ.1, κ.2.1) κ.2.2 :
            TensorProduct k₁ (A κ.1) K')) ((ψ_A κ.1) z) :=
      fun κ z => congrArg (fun fn => fn z) (hlam_spec κ).2.1

    
    have hθ₀_ex : ∀ κ : K_idx,
        ∃ θ₀ : TensorProduct k₁ (C κ.2.1) ↥B →+* Localization.Away (h₀ κ),
          θ₀.comp (Algebra.TensorProduct.includeRight :
              ↥B →ₐ[k₁] TensorProduct k₁ (C κ.2.1) ↥B).toRingHom =
            (algebraMap (TensorProduct k₁ (A κ.1) ↥B) (Localization.Away (h₀ κ))).comp
              (Algebra.TensorProduct.includeRight :
                ↥B →ₐ[k₁] TensorProduct k₁ (A κ.1) ↥B).toRingHom ∧
          (lam_κ κ).comp θ₀ = (θ_bar κ).comp (ψ_C κ.2.1).toRingHom := by
      intro κ
      let i := κ.1
      let b := κ.2.1
      let h_K : TensorProduct k₁ (A i) K' := h_bar (κ.1, κ.2.1) κ.2.2
      let Loc₀ := Localization.Away (h₀ κ)
      let Loc_K := Localization.Away h_K
      let k₁_to_Loc₀ : k₁ →+* Loc₀ :=
        (algebraMap (TensorProduct k₁ (A i) ↥B) Loc₀).comp
          (algebraMap k₁ (TensorProduct k₁ (A i) ↥B))
      let φ_mv : MvPolynomial (Fin (d b)) k₁ →+* Loc₀ :=
        MvPolynomial.eval₂Hom k₁_to_Loc₀ fun μ =>
          algebraMap (TensorProduct k₁ (A i) ↥B) Loc₀ (p₀ ⟨κ, μ⟩) *
            (IsLocalization.Away.invSelf (h₀ κ)) ^ (exp_fam ⟨κ, μ⟩)
      have h_mv_comm : (lam_κ κ).comp φ_mv =
          ((θ_bar κ).comp Algebra.TensorProduct.includeLeftRingHom).comp
            (π_C b).toRingHom := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext
          intro r
          simp only [RingHom.comp_apply]
          dsimp [φ_mv, k₁_to_Loc₀]
          rw [MvPolynomial.eval₂_C, RingHom.comp_apply, hlam_alg κ]
          have h_alg_A : (ψ_A i) (algebraMap k₁ (TensorProduct k₁ (A i) ↥B) r) =
              (Algebra.TensorProduct.includeRight : K' →ₐ[k₁] TensorProduct k₁ (A i) K')
                (algebraMap k₁ K' r) := by
            rw [(ψ_A i).commutes r, (Algebra.TensorProduct.includeRight).commutes r]
          have h_alg_C : Algebra.TensorProduct.includeLeftRingHom ((π_C b) (MvPolynomial.C r)) =
              (Algebra.TensorProduct.includeRight : K' →ₐ[k₁] TensorProduct k₁ (C b) K')
                (algebraMap k₁ K' r) := by
            have h1 : (π_C b) (MvPolynomial.C r) = algebraMap k₁ (C b) r := (π_C b).commutes r
            rw [h1, (Algebra.TensorProduct.includeRight).commutes r]
            exact (Algebra.TensorProduct.includeLeft :
              C b →ₐ[k₁] TensorProduct k₁ (C b) K').commutes r
          rw [h_alg_A, h_alg_C]
          exact (congrArg (fun fn => fn (algebraMap k₁ K' r)) (hθ_bar_spec κ).2).symm
        · intro μ
          simp only [RingHom.comp_apply]
          dsimp [φ_mv]
          rw [MvPolynomial.eval₂_X, map_mul, map_pow, (hlam_spec κ).2.2,
            hlam_alg κ, hp₀ ⟨κ, μ⟩]
          have hsec := IsLocalization.Away.sec_spec h_K
            ((θ_bar κ) (Algebra.TensorProduct.includeLeftRingHom
              ((π_C b) (MvPolynomial.X μ))))
          change _ * algebraMap _ Loc_K (h_K ^ exp_fam ⟨κ, μ⟩) =
            algebraMap _ Loc_K (p_bar_fam ⟨κ, μ⟩) at hsec
          rw [← hsec, mul_assoc, map_pow, ← mul_pow, IsLocalization.Away.mul_invSelf,
            one_pow, mul_one]
      have hker_mv : ∀ P ∈ RingHom.ker (π_C b).toRingHom, φ_mv P = 0 := by
        intro P hP
        apply (hlam_spec κ).1
        have h1 := congrArg (fun fn => fn P) h_mv_comm
        simp only [RingHom.comp_apply] at h1
        have hP0 : (π_C b).toRingHom P = 0 := hP
        rw [h1, hP0, map_zero, map_zero, map_zero]
      let q_ring := Ideal.Quotient.lift (RingHom.ker (π_C b).toRingHom) φ_mv hker_mv
      let e_quot := RingHom.quotientKerEquivOfSurjective (f := (π_C b).toRingHom) (hπ_C b)
      let α₀_ring : C b →+* Loc₀ := q_ring.comp e_quot.symm.toRingHom
      have hα₀_π : ∀ P : MvPolynomial (Fin (d b)) k₁, α₀_ring ((π_C b) P) = φ_mv P := by
        intro P
        have he : (π_C b).toRingHom P = e_quot (Ideal.Quotient.mk _ P) := rfl
        change q_ring (e_quot.symm ((π_C b).toRingHom P)) = φ_mv P
        rw [he, e_quot.symm_apply_apply]
        rfl
      have hα₀_lam : ∀ c : C b, lam_κ κ (α₀_ring c) =
          (θ_bar κ) (Algebra.TensorProduct.includeLeftRingHom c) := by
        intro c
        obtain ⟨P, rfl⟩ := hπ_C b c
        rw [hα₀_π P]
        exact congrArg (fun fn => fn P) h_mv_comm
      have hk₁_Loc₀ : ∀ r : k₁, k₁_to_Loc₀ r = algebraMap k₁ Loc₀ r := by
        intro r
        exact (IsScalarTower.algebraMap_apply k₁ (TensorProduct k₁ (A i) ↥B) Loc₀ r).symm
      let α₀_alg : C b →ₐ[k₁] Loc₀ :=
        { α₀_ring with
          commutes' := fun r => by
            have hr : algebraMap k₁ (C b) r = (π_C b) (MvPolynomial.C r) :=
              ((π_C b).commutes r).symm
            change α₀_ring (algebraMap k₁ (C b) r) = algebraMap k₁ Loc₀ r
            rw [hr, hα₀_π, ← hk₁_Loc₀ r]
            exact MvPolynomial.eval₂_C k₁_to_Loc₀ _ r }
      let β₀_ring : ↥B →+* Loc₀ :=
        (algebraMap (TensorProduct k₁ (A i) ↥B) Loc₀).comp
          (Algebra.TensorProduct.includeRight : ↥B →ₐ[k₁] TensorProduct k₁ (A i) ↥B).toRingHom
      let β₀_alg : ↥B →ₐ[k₁] Loc₀ :=
        { β₀_ring with
          commutes' := fun r => by
            change (algebraMap (TensorProduct k₁ (A i) ↥B) Loc₀)
              ((Algebra.TensorProduct.includeRight : ↥B →ₐ[k₁] TensorProduct k₁ (A i) ↥B)
                (algebraMap k₁ ↥B r)) = algebraMap k₁ Loc₀ r
            rw [(Algebra.TensorProduct.includeRight).commutes r, ← hk₁_Loc₀ r]
            rfl }
      let θ₀_alg : TensorProduct k₁ (C b) ↥B →ₐ[k₁] Loc₀ :=
        Algebra.TensorProduct.lift α₀_alg β₀_alg (fun _ _ => Commute.all _ _)
      refine ⟨θ₀_alg.toRingHom, ?_, ?_⟩
      · apply RingHom.ext
        intro s
        exact (Algebra.TensorProduct.lift_tmul α₀_alg β₀_alg
          (fun _ _ => Commute.all _ _) 1 s).trans (by
            have h1 : α₀_alg 1 = 1 := map_one α₀_alg
            rw [h1, one_mul]
            rfl)
      · apply RingHom.ext
        intro w
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul c s =>
          have h_tmul : θ₀_alg (c ⊗ₜ[k₁] s) = α₀_alg c * β₀_alg s :=
            Algebra.TensorProduct.lift_tmul α₀_alg β₀_alg (fun _ _ => Commute.all _ _) c s
          change lam_κ κ (θ₀_alg (c ⊗ₜ[k₁] s)) = (θ_bar κ) ((ψ_C b) (c ⊗ₜ[k₁] s))
          rw [h_tmul, map_mul]
          have h_split : (ψ_C b) (c ⊗ₜ[k₁] s) =
              Algebra.TensorProduct.includeLeftRingHom c *
                (Algebra.TensorProduct.includeRight : K' →ₐ[k₁] TensorProduct k₁ (C b) K')
                  (B.val s) := by
            change c ⊗ₜ[k₁] B.val s = (c ⊗ₜ[k₁] 1) * (1 ⊗ₜ[k₁] B.val s)
            simp
          rw [h_split, map_mul]
          congr 1
          · exact hα₀_lam c
          · change lam_κ κ (algebraMap (TensorProduct k₁ (A i) ↥B) Loc₀
              ((1 : A i) ⊗ₜ[k₁] s)) = _
            rw [hlam_alg κ]
            have h_ps : (ψ_A i) ((1 : A i) ⊗ₜ[k₁] s) =
                (Algebra.TensorProduct.includeRight : K' →ₐ[k₁] TensorProduct k₁ (A i) K')
                  (B.val s) := rfl
            rw [h_ps]
            exact (congrArg (fun fn => fn (B.val s)) (hθ_bar_spec κ).2).symm
        | add u₁ u₂ ih₁ ih₂ =>
          simp only [RingHom.comp_apply, map_add] at ih₁ ih₂ ⊢
          rw [ih₁, ih₂]
    obtain ⟨θ₀, hθ₀_spec⟩ := Classical.axiomOfChoice hθ₀_ex

    
    let β := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B))
    let X_B := CategoryTheory.Limits.pullback p_X β
    let W_B := CategoryTheory.Limits.pullback p_W β
    let X_K := CategoryTheory.Limits.pullback p_X α
    let W_K := CategoryTheory.Limits.pullback p_W α
    haveI : W_B.IsSeparated := pullback_isSeparated p_W ↥B
    obtain ⟨ι_XB, hι_XB⟩ := Classical.axiomOfChoice fun i : Fin m =>
      exists_tensorChart X p_X (A i) (u_X i) (huX_pX i) ↥B
    obtain ⟨ι_WB, hι_WB⟩ := Classical.axiomOfChoice fun b : Fin n =>
      exists_tensorChart W p_W (C b) (v_W b) (hvW_pW b) ↥B
    haveI : ∀ i : Fin m, AlgebraicGeometry.IsOpenImmersion (ι_XB i) := fun i => (hι_XB i).1
    haveI : ∀ b : Fin n, AlgebraicGeometry.IsOpenImmersion (ι_WB b) := fun b => (hι_WB b).1

    let j_B_val := AlgebraicGeometry.Spec.map (CommRingCat.ofHom B.val.toRingHom)
    have hj_B_β : j_B_val ≫ β = α := by
      dsimp [j_B_val, β, α]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    let π_X₀ : X_K ⟶ X_B :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p_X α)
        (CategoryTheory.Limits.pullback.snd p_X α ≫ j_B_val)
        (by rw [Category.assoc, hj_B_β, CategoryTheory.Limits.pullback.condition])
    let π_W₀ : W_K ⟶ W_B :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p_W α)
        (CategoryTheory.Limits.pullback.snd p_W α ≫ j_B_val)
        (by rw [Category.assoc, hj_B_β, CategoryTheory.Limits.pullback.condition])
    have hπ_X₀_fst : π_X₀ ≫ CategoryTheory.Limits.pullback.fst p_X β =
        CategoryTheory.Limits.pullback.fst p_X α :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hπ_X₀_snd : π_X₀ ≫ CategoryTheory.Limits.pullback.snd p_X β =
        CategoryTheory.Limits.pullback.snd p_X α ≫ j_B_val :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hπ_W₀_fst : π_W₀ ≫ CategoryTheory.Limits.pullback.fst p_W β =
        CategoryTheory.Limits.pullback.fst p_W α :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hπ_W₀_snd : π_W₀ ≫ CategoryTheory.Limits.pullback.snd p_W β =
        CategoryTheory.Limits.pullback.snd p_W α ≫ j_B_val :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _

    have hι_X_comm : ∀ i : Fin m,
        ι_XK i ≫ π_X₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_A i).toRingHom) ≫ ι_XB i := by
      intro i
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hπ_X₀_fst, (hι_XK i).2.2.1, Category.assoc, (hι_XB i).2.2.1,
          ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rfl
      · rw [Category.assoc, hπ_X₀_snd, ← Category.assoc, (hι_XK i).2.2.2,
          Category.assoc, (hι_XB i).2.2.2,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        rfl
    have hι_W_comm : ∀ b : Fin n,
        ι_WK b ≫ π_W₀ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_C b).toRingHom) ≫ ι_WB b := by
      intro b
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, hπ_W₀_fst, (hι_WK b).2.2.1, Category.assoc, (hι_WB b).2.2.1,
          ← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rfl
      · rw [Category.assoc, hπ_W₀_snd, ← Category.assoc, (hι_WK b).2.2.2,
          Category.assoc, (hι_WB b).2.2.2,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        rfl

    let J : Type u := ULift.{u} K_idx
    let S_ch : J → AlgebraicGeometry.Scheme.{u} := fun κ =>
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h₀ κ.down)))
    let S_K_ch : J → AlgebraicGeometry.Scheme.{u} := fun κ =>
      AlgebraicGeometry.Spec (CommRingCat.of
        (Localization.Away (h_bar (κ.down.1, κ.down.2.1) κ.down.2.2 :
          TensorProduct k₁ (A κ.down.1) K')))
    let w_B : ∀ κ : J, S_ch κ ⟶ X_B := fun κ =>
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap
          (TensorProduct k₁ (A κ.down.1) ↥B)
          (Localization.Away (h₀ κ.down : TensorProduct k₁ (A κ.down.1) ↥B)))) ≫
        ι_XB κ.down.1
    let w_K : ∀ κ : J, S_K_ch κ ⟶ X_K := fun κ =>
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap
          (TensorProduct k₁ (A κ.down.1) K')
          (Localization.Away (h_bar (κ.down.1, κ.down.2.1) κ.down.2.2 :
            TensorProduct k₁ (A κ.down.1) K')))) ≫
        ι_XK κ.down.1
    haveI : ∀ κ : J, AlgebraicGeometry.IsOpenImmersion (w_B κ) := fun κ => by
      dsimp [w_B]
      haveI : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap
            (TensorProduct k₁ (A κ.down.1) ↥B)
            (Localization.Away (h₀ κ.down : TensorProduct k₁ (A κ.down.1) ↥B))))) :=
        AlgebraicGeometry.Scheme.instIsOpenImmersionMapOfHomAwayAlgebraMap
          (h₀ κ.down : TensorProduct k₁ (A κ.down.1) ↥B)
      haveI : AlgebraicGeometry.IsOpenImmersion (ι_XB κ.down.1) := (hι_XB κ.down.1).1
      infer_instance
    haveI : ∀ κ : J, AlgebraicGeometry.IsOpenImmersion (w_K κ) := fun κ => by
      dsimp [w_K]
      haveI : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap
            (TensorProduct k₁ (A κ.down.1) K')
            (Localization.Away (h_bar (κ.down.1, κ.down.2.1) κ.down.2.2 :
              TensorProduct k₁ (A κ.down.1) K'))))) :=
        AlgebraicGeometry.Scheme.instIsOpenImmersionMapOfHomAwayAlgebraMap
          (h_bar (κ.down.1, κ.down.2.1) κ.down.2.2 : TensorProduct k₁ (A κ.down.1) K')
      haveI : AlgebraicGeometry.IsOpenImmersion (ι_XK κ.down.1) := (hι_XK κ.down.1).1
      infer_instance
    let g_loc : ∀ κ : J, S_ch κ ⟶ W_B := fun κ =>
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ₀ κ.down)) ≫ ι_WB κ.down.2.1
    let p_loc : ∀ κ : J, S_K_ch κ ⟶ S_ch κ := fun κ =>
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (lam_κ κ.down))

    have hcov_B : ∀ x : ↥X_B, ∃ κ : J, ∃ y : ↥(S_ch κ), (w_B κ).base y = x := by
      intro x
      obtain ⟨i, hxi⟩ := huX_cov ((CategoryTheory.Limits.pullback.fst p_X β).base x)
      have hx_range : x ∈ Set.range (ι_XB i).base := by
        rw [(hι_XB i).2.1]
        exact hxi
      rcases hx_range with ⟨z, hzx⟩
      let h₀_fam : P_idx i → TensorProduct k₁ (A i) ↥B := fun p => h₀ ⟨i, p.1, p.2⟩
      have h_top_B : (⨆ p : P_idx i, PrimeSpectrum.basicOpen (h₀_fam p)) = ⊤ := by
        rw [PrimeSpectrum.iSup_basicOpen_eq_top_iff, Ideal.eq_top_iff_one]
        rw [← hc₀_sum i]
        exact Ideal.mem_span_range_iff_exists_fun.mpr ⟨c₀_pair i, rfl⟩
      have hz_top : (z : PrimeSpectrum (TensorProduct k₁ (A i) ↥B)) ∈
          (⨆ p : P_idx i, PrimeSpectrum.basicOpen (h₀_fam p)) := by
        rw [h_top_B]
        trivial
      obtain ⟨p, hzp⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_top
      have hzp' : (z : PrimeSpectrum (TensorProduct k₁ (A i) ↥B)) ∈
          Set.range (PrimeSpectrum.comap
            (algebraMap (TensorProduct k₁ (A i) ↥B) (Localization.Away (h₀_fam p)))) := by
        rwa [PrimeSpectrum.localization_away_comap_range
          (Localization.Away (h₀_fam p)) (h₀_fam p)]
      rcases hzp' with ⟨y, hyz⟩
      let j_loc := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k₁ (A i) ↥B)
          (Localization.Away (h₀_fam p))))
      have hjy : j_loc.base y = z := hyz
      exact ⟨ULift.up ⟨i, p.1, p.2⟩, y, (congrArg (ι_XB i).base hjy).trans hzx⟩

    have hcov_K : ∀ x : ↥X_K, ∃ κ : J, ∃ y : ↥(S_K_ch κ), (w_K κ).base y = x := by
      intro x
      obtain ⟨i, hxi⟩ := huX_cov ((CategoryTheory.Limits.pullback.fst p_X α).base x)
      have hx_range : x ∈ Set.range (ι_XK i).base := by
        rw [(hι_XK i).2.1]
        exact hxi
      rcases hx_range with ⟨z, hzx⟩
      let h_fam : P_idx i → TensorProduct k₁ (A i) K' := fun p => h_bar (i, p.1) p.2
      have h_top_K : (⨆ p : P_idx i, PrimeSpectrum.basicOpen (h_fam p)) = ⊤ := by
        rw [PrimeSpectrum.iSup_basicOpen_eq_top_iff, Ideal.eq_top_iff_one]
        rw [← hc_bar i]
        exact Ideal.mem_span_range_iff_exists_fun.mpr ⟨c_bar i, rfl⟩
      have hz_top : (z : PrimeSpectrum (TensorProduct k₁ (A i) K')) ∈
          (⨆ p : P_idx i, PrimeSpectrum.basicOpen (h_fam p)) := by
        rw [h_top_K]
        trivial
      obtain ⟨p, hzp⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_top
      have hzp' : (z : PrimeSpectrum (TensorProduct k₁ (A i) K')) ∈
          Set.range (PrimeSpectrum.comap
            (algebraMap (TensorProduct k₁ (A i) K') (Localization.Away (h_fam p)))) := by
        rwa [PrimeSpectrum.localization_away_comap_range
          (Localization.Away (h_fam p)) (h_fam p)]
      rcases hzp' with ⟨y, hyz⟩
      let j_loc := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (TensorProduct k₁ (A i) K')
          (Localization.Away (h_fam p))))
      have hjy : j_loc.base y = z := hyz
      exact ⟨ULift.up ⟨i, p.1, p.2⟩, y, (congrArg (ι_XK i).base hjy).trans hzx⟩

    have hg_snd : ∀ κ : J,
        g_loc κ ≫ CategoryTheory.Limits.pullback.snd p_W β =
          w_B κ ≫ CategoryTheory.Limits.pullback.snd p_X β := by
      intro κ
      dsimp [g_loc, w_B]
      rw [Category.assoc, (hι_WB κ.down.2.1).2.2.2, Category.assoc, (hι_XB κ.down.1).2.2.2,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, (hθ₀_spec κ.down).1]

    have hw_comm : ∀ κ : J, w_K κ ≫ π_X₀ = p_loc κ ≫ w_B κ := by
      intro κ
      dsimp [w_K, w_B, p_loc]
      rw [Category.assoc, hι_X_comm κ.down.1, ← Category.assoc, ← Category.assoc]
      congr 1
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, (hlam_spec κ.down).2.1]

    have hPb_loc : ∀ κ : J, CategoryTheory.IsPullback (p_loc κ) (w_K κ) (w_B κ) π_X₀ := by
      intro κ
      apply AlgebraicGeometry.IsOpenImmersion.isPullback (p_loc κ) (w_K κ) (w_B κ) π_X₀
        (hw_comm κ)
      ext x
      change π_X₀.base x ∈ Set.range (w_B κ).base ↔ x ∈ Set.range (w_K κ).base
      constructor
      · rintro ⟨z₀, hz₀⟩
        have hx_U : (CategoryTheory.Limits.pullback.fst p_X α).base x ∈
            Set.range (u_X κ.down.1).base := by
          have h1 := congrArg (fun fn => fn.base x) hπ_X₀_fst.symm
          change (CategoryTheory.Limits.pullback.fst p_X α).base x =
            (CategoryTheory.Limits.pullback.fst p_X β).base (π_X₀.base x) at h1
          rw [h1, ← hz₀]
          have h_in : (w_B κ).base z₀ ∈ Set.range (ι_XB κ.down.1).base := by
            dsimp [w_B]
            exact ⟨_, rfl⟩
          rw [(hι_XB κ.down.1).2.1] at h_in
          exact h_in
        have hx_XK : x ∈ Set.range (ι_XK κ.down.1).base := by
          rw [(hι_XK κ.down.1).2.1]
          exact hx_U
        rcases hx_XK with ⟨z_K, rfl⟩
        have h_pt := congrArg (fun fn => fn.base z_K) (hι_X_comm κ.down.1)
        change π_X₀.base ((ι_XK κ.down.1).base z_K) =
          (ι_XB κ.down.1).base ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ_A κ.down.1).toRingHom)).base z_K) at h_pt
        rw [← hz₀] at h_pt
        have hz_eq := (ι_XB κ.down.1).isOpenEmbedding.injective h_pt.symm
        have hz_basic : ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ_A κ.down.1).toRingHom)).base z_K :
              PrimeSpectrum (TensorProduct k₁ (A κ.down.1) ↥B)) ∈
            (PrimeSpectrum.basicOpen (h₀ κ.down) :
              Set (PrimeSpectrum (TensorProduct k₁ (A κ.down.1) ↥B))) := by
          rw [← PrimeSpectrum.localization_away_comap_range
            (Localization.Away (h₀ κ.down)) (h₀ κ.down)]
          exact ⟨z₀, hz_eq.symm⟩
        let h_K : TensorProduct k₁ (A κ.down.1) K' := h_bar (κ.down.1, κ.down.2.1) κ.down.2.2
        have hzK_basic : (z_K : PrimeSpectrum (TensorProduct k₁ (A κ.down.1) K')) ∈
            (PrimeSpectrum.basicOpen h_K :
              Set (PrimeSpectrum (TensorProduct k₁ (A κ.down.1) K'))) := by
          have hh_eq : (ψ_A κ.down.1) (h₀ κ.down) = h_K := hh₀ κ.down
          rw [← hh_eq]
          exact hz_basic
        rw [← PrimeSpectrum.localization_away_comap_range
          (Localization.Away h_K) h_K] at hzK_basic
        rcases hzK_basic with ⟨w₀, hw₀⟩
        let j_locK := AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (TensorProduct k₁ (A κ.down.1) K')
            (Localization.Away h_K)))
        have hjw₀ : j_locK.base w₀ = z_K := hw₀
        exact ⟨w₀, congrArg (ι_XK κ.down.1).base hjw₀⟩
      · rintro ⟨w₀, rfl⟩
        have h_pt := congrArg (fun fn => fn.base w₀) (hw_comm κ)
        exact ⟨(p_loc κ).base w₀, h_pt.symm⟩

    have hg_comm : ∀ κ : J, p_loc κ ≫ g_loc κ = w_K κ ≫ f ≫ π_W₀ := by
      intro κ
      dsimp [p_loc, g_loc, w_K]
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        (hθ₀_spec κ.down).2, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        Category.assoc, ← hι_W_comm κ.down.2.1,
        ← Category.assoc, (hθ_bar_spec κ.down).1,
        Category.assoc, Category.assoc (ι_XK κ.down.1) f π_W₀,
        ← Category.assoc _ (ι_XK κ.down.1)]

    have hInj_B : ∀ O : X_B.Opens, Function.Injective (π_X₀.app O).hom :=
      subalgebra_baseChange_app_injective B X p_X π_X₀ hπ_X₀_fst hπ_X₀_snd
    obtain ⟨f_B, hf_B_snd, hf_B_comm₀⟩ :=
      glue_over_pullback_openCover
        (CategoryTheory.Limits.pullback.snd p_X β)
        (CategoryTheory.Limits.pullback.snd p_W β)
        π_X₀ π_W₀ f hInj_B J S_ch S_K_ch w_B w_K hcov_B hcov_K
        g_loc p_loc hg_snd hPb_loc hg_comm
    refine ⟨B, hFG, f_B, hf_B_snd, ?_⟩
    intro π_X π_W hX_fst hX_snd hW_fst hW_snd
    have hπX_eq : π_X = π_X₀ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact hX_fst.trans hπ_X₀_fst.symm
      · exact hX_snd.trans hπ_X₀_snd.symm
    have hπW_eq : π_W = π_W₀ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact hW_fst.trans hπ_W₀_fst.symm
      · exact hW_snd.trans hπ_W₀_snd.symm
    rw [hπX_eq, hπW_eq]
    exact hf_B_comm₀

  
  
  
  letI : Algebra k₁ K' := φ.toAlgebra
  let α := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ K'))
  obtain ⟨Ψ, hΨ_snd⟩ := hIso
  have hΨ_snd' : Ψ.hom ≫ CategoryTheory.Limits.pullback.snd p_Z α =
      CategoryTheory.Limits.pullback.snd p_Y α := hΨ_snd
  have hΨ_inv_snd : Ψ.inv ≫ CategoryTheory.Limits.pullback.snd p_Y α =
      CategoryTheory.Limits.pullback.snd p_Z α := by
    rw [← hΨ_snd', ← Category.assoc, Ψ.inv_hom_id, Category.id_comp]

  obtain ⟨B₁, hFG₁, f₁, hf₁_snd, hf₁_comm⟩ :=
    proper_morphism_spread_out Y Z p_Y p_Z Ψ.hom hΨ_snd'
  obtain ⟨B₂, hFG₂, g₂, hg₂_snd, hg₂_comm⟩ :=
    proper_morphism_spread_out Z Y p_Z p_Y Ψ.inv hΨ_inv_snd

  let B₀ : Subalgebra k₁ K' := B₁ ⊔ B₂
  have hFG₀ : B₀.FG := hFG₁.sup hFG₂
  let β₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B₁))
  let β₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B₂))
  let β₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k₁ ↥B₀))
  let Y₀ := CategoryTheory.Limits.pullback p_Y β₀
  let Z₀ := CategoryTheory.Limits.pullback p_Z β₀
  haveI : Y₀.IsSeparated := pullback_isSeparated p_Y ↥B₀
  haveI : Z₀.IsSeparated := pullback_isSeparated p_Z ↥B₀

  let inc₁ := Subalgebra.inclusion (le_sup_left : B₁ ≤ B₀)
  let inc₂ := Subalgebra.inclusion (le_sup_right : B₂ ≤ B₀)
  let j₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₁.toRingHom)
  let j₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom inc₂.toRingHom)
  have hj₁ : j₁ ≫ β₁ = β₀ := by
    dsimp [j₁, β₁, β₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  have hj₂ : j₂ ≫ β₂ = β₀ := by
    dsimp [j₂, β₂, β₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

  let q_Y₁ : Y₀ ⟶ CategoryTheory.Limits.pullback p_Y β₁ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst p_Y β₀)
      (CategoryTheory.Limits.pullback.snd p_Y β₀ ≫ j₁)
      (by rw [Category.assoc, hj₁, CategoryTheory.Limits.pullback.condition])
  let q_Z₁ : Z₀ ⟶ CategoryTheory.Limits.pullback p_Z β₁ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst p_Z β₀)
      (CategoryTheory.Limits.pullback.snd p_Z β₀ ≫ j₁)
      (by rw [Category.assoc, hj₁, CategoryTheory.Limits.pullback.condition])
  let q_Z₂ : Z₀ ⟶ CategoryTheory.Limits.pullback p_Z β₂ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst p_Z β₀)
      (CategoryTheory.Limits.pullback.snd p_Z β₀ ≫ j₂)
      (by rw [Category.assoc, hj₂, CategoryTheory.Limits.pullback.condition])
  let q_Y₂ : Y₀ ⟶ CategoryTheory.Limits.pullback p_Y β₂ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst p_Y β₀)
      (CategoryTheory.Limits.pullback.snd p_Y β₀ ≫ j₂)
      (by rw [Category.assoc, hj₂, CategoryTheory.Limits.pullback.condition])

  have hq_Y₁_fst : q_Y₁ ≫ CategoryTheory.Limits.pullback.fst p_Y β₁ =
      CategoryTheory.Limits.pullback.fst p_Y β₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_Y₁_snd : q_Y₁ ≫ CategoryTheory.Limits.pullback.snd p_Y β₁ =
      CategoryTheory.Limits.pullback.snd p_Y β₀ ≫ j₁ := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hq_Z₁_fst : q_Z₁ ≫ CategoryTheory.Limits.pullback.fst p_Z β₁ =
      CategoryTheory.Limits.pullback.fst p_Z β₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_Z₁_snd : q_Z₁ ≫ CategoryTheory.Limits.pullback.snd p_Z β₁ =
      CategoryTheory.Limits.pullback.snd p_Z β₀ ≫ j₁ := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hq_Z₂_fst : q_Z₂ ≫ CategoryTheory.Limits.pullback.fst p_Z β₂ =
      CategoryTheory.Limits.pullback.fst p_Z β₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_Z₂_snd : q_Z₂ ≫ CategoryTheory.Limits.pullback.snd p_Z β₂ =
      CategoryTheory.Limits.pullback.snd p_Z β₀ ≫ j₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hq_Y₂_fst : q_Y₂ ≫ CategoryTheory.Limits.pullback.fst p_Y β₂ =
      CategoryTheory.Limits.pullback.fst p_Y β₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_Y₂_snd : q_Y₂ ≫ CategoryTheory.Limits.pullback.snd p_Y β₂ =
      CategoryTheory.Limits.pullback.snd p_Y β₀ ≫ j₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _

  let f₀ : Y₀ ⟶ Z₀ :=
    CategoryTheory.Limits.pullback.lift
      (q_Y₁ ≫ f₁ ≫ CategoryTheory.Limits.pullback.fst p_Z β₁)
      (CategoryTheory.Limits.pullback.snd p_Y β₀)
      (by
        rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← Category.assoc f₁, hf₁_snd, ← Category.assoc q_Y₁, hq_Y₁_snd,
          Category.assoc, hj₁])
  let g₀ : Z₀ ⟶ Y₀ :=
    CategoryTheory.Limits.pullback.lift
      (q_Z₂ ≫ g₂ ≫ CategoryTheory.Limits.pullback.fst p_Y β₂)
      (CategoryTheory.Limits.pullback.snd p_Z β₀)
      (by
        rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← Category.assoc g₂, hg₂_snd, ← Category.assoc q_Z₂, hq_Z₂_snd,
          Category.assoc, hj₂])
  have hf₀_fst : f₀ ≫ CategoryTheory.Limits.pullback.fst p_Z β₀ =
      q_Y₁ ≫ f₁ ≫ CategoryTheory.Limits.pullback.fst p_Z β₁ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hf₀_snd : f₀ ≫ CategoryTheory.Limits.pullback.snd p_Z β₀ =
      CategoryTheory.Limits.pullback.snd p_Y β₀ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hg₀_fst : g₀ ≫ CategoryTheory.Limits.pullback.fst p_Y β₀ =
      q_Z₂ ≫ g₂ ≫ CategoryTheory.Limits.pullback.fst p_Y β₂ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hg₀_snd : g₀ ≫ CategoryTheory.Limits.pullback.snd p_Y β₀ =
      CategoryTheory.Limits.pullback.snd p_Z β₀ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  let j_B₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom B₀.val.toRingHom)
  have hj_B₀ : j_B₀ ≫ β₀ = α := by
    dsimp [j_B₀, β₀, α]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  let π_Y₀ : CategoryTheory.Limits.pullback p_Y α ⟶ Y₀ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst p_Y α)
      (CategoryTheory.Limits.pullback.snd p_Y α ≫ j_B₀)
      (by rw [Category.assoc, hj_B₀, CategoryTheory.Limits.pullback.condition])
  let π_Z₀ : CategoryTheory.Limits.pullback p_Z α ⟶ Z₀ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst p_Z α)
      (CategoryTheory.Limits.pullback.snd p_Z α ≫ j_B₀)
      (by rw [Category.assoc, hj_B₀, CategoryTheory.Limits.pullback.condition])
  have hπ_Y₀_fst : π_Y₀ ≫ CategoryTheory.Limits.pullback.fst p_Y β₀ =
      CategoryTheory.Limits.pullback.fst p_Y α := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ_Y₀_snd : π_Y₀ ≫ CategoryTheory.Limits.pullback.snd p_Y β₀ =
      CategoryTheory.Limits.pullback.snd p_Y α ≫ j_B₀ := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hπ_Z₀_fst : π_Z₀ ≫ CategoryTheory.Limits.pullback.fst p_Z β₀ =
      CategoryTheory.Limits.pullback.fst p_Z α := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hπ_Z₀_snd : π_Z₀ ≫ CategoryTheory.Limits.pullback.snd p_Z β₀ =
      CategoryTheory.Limits.pullback.snd p_Z α ≫ j_B₀ := CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hj_B₀_1 : j_B₀ ≫ j₁ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom B₁.val.toRingHom) := by
    dsimp [j_B₀, j₁]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl
  have hj_B₀_2 : j_B₀ ≫ j₂ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom B₂.val.toRingHom) := by
    dsimp [j_B₀, j₂]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

  have hf₀_comm : π_Y₀ ≫ f₀ = Ψ.hom ≫ π_Z₀ := by
    have h_step := hf₁_comm (π_Y₀ ≫ q_Y₁) (π_Z₀ ≫ q_Z₁)
      (by rw [Category.assoc, hq_Y₁_fst, hπ_Y₀_fst])
      (by rw [Category.assoc, hq_Y₁_snd, ← Category.assoc, hπ_Y₀_snd, Category.assoc, hj_B₀_1])
      (by rw [Category.assoc, hq_Z₁_fst, hπ_Z₀_fst])
      (by rw [Category.assoc, hq_Z₁_snd, ← Category.assoc, hπ_Z₀_snd, Category.assoc, hj_B₀_1])
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, hf₀_fst, ← Category.assoc π_Y₀, ← Category.assoc (π_Y₀ ≫ q_Y₁),
        h_step, Category.assoc, Category.assoc, hq_Z₁_fst, hπ_Z₀_fst,
        Category.assoc Ψ.hom π_Z₀, hπ_Z₀_fst]
    · rw [Category.assoc, hf₀_snd, hπ_Y₀_snd, Category.assoc, hπ_Z₀_snd,
        ← Category.assoc, hΨ_snd']

  have hg₀_comm : π_Z₀ ≫ g₀ = Ψ.inv ≫ π_Y₀ := by
    have h_step := hg₂_comm (π_Z₀ ≫ q_Z₂) (π_Y₀ ≫ q_Y₂)
      (by rw [Category.assoc, hq_Z₂_fst, hπ_Z₀_fst])
      (by rw [Category.assoc, hq_Z₂_snd, ← Category.assoc, hπ_Z₀_snd, Category.assoc, hj_B₀_2])
      (by rw [Category.assoc, hq_Y₂_fst, hπ_Y₀_fst])
      (by rw [Category.assoc, hq_Y₂_snd, ← Category.assoc, hπ_Y₀_snd, Category.assoc, hj_B₀_2])
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, hg₀_fst, ← Category.assoc π_Z₀, ← Category.assoc (π_Z₀ ≫ q_Z₂),
        h_step, Category.assoc, Category.assoc, hq_Y₂_fst, hπ_Y₀_fst,
        Category.assoc Ψ.inv π_Y₀, hπ_Y₀_fst]
    · rw [Category.assoc, hg₀_snd, hπ_Z₀_snd, Category.assoc, hπ_Y₀_snd,
        ← Category.assoc, hΨ_inv_snd]

  have hfg₀ : f₀ ≫ g₀ = 𝟙 Y₀ := by
    apply openImmersion_pullback_cancel π_Y₀
      (subalgebra_baseChange_app_injective B₀ Y p_Y π_Y₀ hπ_Y₀_fst hπ_Y₀_snd)
      (𝟙 Y₀) π_Y₀ (𝟙 _)
      (CategoryTheory.IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, Category.id_comp]⟩)
    rw [← Category.assoc, hf₀_comm, Category.assoc, hg₀_comm, ← Category.assoc,
      Ψ.hom_inv_id, Category.id_comp, Category.comp_id]

  have hgf₀ : g₀ ≫ f₀ = 𝟙 Z₀ := by
    apply openImmersion_pullback_cancel π_Z₀
      (subalgebra_baseChange_app_injective B₀ Z p_Z π_Z₀ hπ_Z₀_fst hπ_Z₀_snd)
      (𝟙 Z₀) π_Z₀ (𝟙 _)
      (CategoryTheory.IsPullback.of_vert_isIso ⟨by rw [Category.comp_id, Category.id_comp]⟩)
    rw [← Category.assoc, hg₀_comm, Category.assoc, hf₀_comm, ← Category.assoc,
      Ψ.inv_hom_id, Category.id_comp, Category.comp_id]

  
  obtain ⟨ev⟩ := fg_subalgebra_retraction B₀ hFG₀
  let s_ev : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥B₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev.toRingHom)
  have hs_ev : s_ev ≫ β₀ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁)) := by
    dsimp [s_ev, β₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
    congr 1
    ext c
    exact ev.commutes c

  let σ_Y : Y ⟶ Y₀ :=
    CategoryTheory.Limits.pullback.lift (𝟙 Y) (p_Y ≫ s_ev)
      (by rw [Category.id_comp, Category.assoc, hs_ev, Category.comp_id])
  let σ_Z : Z ⟶ Z₀ :=
    CategoryTheory.Limits.pullback.lift (𝟙 Z) (p_Z ≫ s_ev)
      (by rw [Category.id_comp, Category.assoc, hs_ev, Category.comp_id])
  have hσ_Y_fst : σ_Y ≫ CategoryTheory.Limits.pullback.fst p_Y β₀ = 𝟙 Y :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hσ_Y_snd : σ_Y ≫ CategoryTheory.Limits.pullback.snd p_Y β₀ = p_Y ≫ s_ev :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hσ_Z_fst : σ_Z ≫ CategoryTheory.Limits.pullback.fst p_Z β₀ = 𝟙 Z :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hσ_Z_snd : σ_Z ≫ CategoryTheory.Limits.pullback.snd p_Z β₀ = p_Z ≫ s_ev :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  let Ψ₀_hom : Y ⟶ Z := σ_Y ≫ f₀ ≫ CategoryTheory.Limits.pullback.fst p_Z β₀
  let Ψ₀_inv : Z ⟶ Y := σ_Z ≫ g₀ ≫ CategoryTheory.Limits.pullback.fst p_Y β₀

  have hΨ₀_hom_pZ : Ψ₀_hom ≫ p_Z = p_Y := by
    dsimp [Ψ₀_hom]
    rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← Category.assoc f₀, hf₀_snd, ← Category.assoc, hσ_Y_snd,
      Category.assoc, hs_ev, Category.comp_id]

  have hΨ₀_inv_pY : Ψ₀_inv ≫ p_Y = p_Z := by
    dsimp [Ψ₀_inv]
    rw [Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← Category.assoc g₀, hg₀_snd, ← Category.assoc, hσ_Z_snd,
      Category.assoc, hs_ev, Category.comp_id]

  have h_intertwine_Y : Ψ₀_hom ≫ σ_Z = σ_Y ≫ f₀ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, hσ_Z_fst, Category.comp_id]
      rfl
    · rw [Category.assoc, hσ_Z_snd, ← Category.assoc, hΨ₀_hom_pZ,
        Category.assoc, hf₀_snd, hσ_Y_snd]

  have h_intertwine_Z : Ψ₀_inv ≫ σ_Y = σ_Z ≫ g₀ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, hσ_Y_fst, Category.comp_id]
      rfl
    · rw [Category.assoc, hσ_Y_snd, ← Category.assoc, hΨ₀_inv_pY,
        Category.assoc, hg₀_snd, hσ_Z_snd]

  refine ⟨{
    hom := Ψ₀_hom
    inv := Ψ₀_inv
    hom_inv_id := by
      change Ψ₀_hom ≫ (σ_Z ≫ g₀ ≫ CategoryTheory.Limits.pullback.fst p_Y β₀) = 𝟙 Y
      rw [← Category.assoc, ← Category.assoc, h_intertwine_Y,
        Category.assoc σ_Y, hfg₀, Category.comp_id, hσ_Y_fst]
    inv_hom_id := by
      change Ψ₀_inv ≫ (σ_Y ≫ f₀ ≫ CategoryTheory.Limits.pullback.fst p_Z β₀) = 𝟙 Z
      rw [← Category.assoc, ← Category.assoc, h_intertwine_Z,
        Category.assoc σ_Z, hgf₀, Category.comp_id, hσ_Z_fst]
  }, hΨ₀_hom_pZ⟩

theorem weil_algClosed_irreducible_subscheme_baseChange_iso (k₁ K' : Type u) [Field k₁] [Field K']
    (φ : k₁ →+* K')
    (hDom : ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra k₁ D] [Algebra.FiniteType k₁ D],
      letI : Algebra k₁ K' := φ.toAlgebra
      IsDomain (TensorProduct k₁ D K'))
    (X₁ : AlgebraicGeometry.Scheme.{u})
    (p₁ : X₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₁))
    [AlgebraicGeometry.IsProper p₁]
    (E₁ : Set ↥X₁)
    (hE₁ : E₁ ∈ irreducibleComponents ↥X₁)
    (E₂_sch : AlgebraicGeometry.Scheme.{u})
    (ιE₂ : E₂_sch ⟶ CategoryTheory.Limits.pullback p₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)))
    [AlgebraicGeometry.IsClosedImmersion ιE₂]
    [AlgebraicGeometry.IsIntegral E₂_sch]
    (hRange₂ : Set.range ιE₂.base =
      (CategoryTheory.Limits.pullback.fst p₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ))).base ⁻¹' E₁) :
    ∃ (E₁_sch : AlgebraicGeometry.Scheme.{u}) (ιE₁ : E₁_sch ⟶ X₁),
      AlgebraicGeometry.IsClosedImmersion ιE₁ ∧
      AlgebraicGeometry.IsIntegral E₁_sch ∧
      Set.range ιE₁.base = E₁ ∧
      ∃ Θ : CategoryTheory.Limits.pullback (ιE₁ ≫ p₁)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ≅ E₂_sch,
        Θ.hom ≫ ιE₂ ≫ CategoryTheory.Limits.pullback.snd p₁
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) =
          CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) :=
by
  have hClSet₁ : IsClosed E₁ := isClosed_of_mem_irreducibleComponents E₁ hE₁
  let Z₁ : TopologicalSpace.Closeds ↥X₁ := ⟨E₁, hClSet₁⟩
  let I₁ : X₁.IdealSheafData := AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal Z₁
  let E₁_sch : AlgebraicGeometry.Scheme.{u} := I₁.subscheme
  let ιE₁ : E₁_sch ⟶ X₁ := I₁.subschemeι
  have hCl₁ : AlgebraicGeometry.IsClosedImmersion ιE₁ := inferInstance
  have hRange₁ : Set.range ιE₁.base = E₁ := by
    dsimp [ιE₁, I₁]
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hRed₁ : AlgebraicGeometry.IsReduced E₁_sch := by
    have : ∀ U : I₁.subschemeCover.openCover.I₀,
        AlgebraicGeometry.IsReduced (I₁.subschemeCover.openCover.X U) := by
      intro U
      let U' : ↑X₁.affineOpens := U
      have hRadU : (I₁.ideal U').IsRadical := by
        dsimp [I₁]
        rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_ideal]
        exact PrimeSpectrum.isRadical_vanishingIdeal _
      have : IsReduced (↑(X₁.presheaf.obj (Opposite.op U'.1)) ⧸ I₁.ideal U') :=
        (Ideal.isRadical_iff_quotient_reduced (I₁.ideal U')).mp hRadU
      change AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (CommRingCat.of (↑(X₁.presheaf.obj (Opposite.op U'.1)) ⧸ I₁.ideal U')))
      exact (AlgebraicGeometry.affine_isReduced_iff _).mpr inferInstance
    exact AlgebraicGeometry.IsReduced.of_openCover E₁_sch I₁.subschemeCover.openCover
  have hNe₁ : Nonempty ↥E₁_sch := by
    obtain ⟨x₀, hx₀⟩ := hE₁.1.1
    rw [← hRange₁] at hx₀
    rcases hx₀ with ⟨y₀, _⟩
    exact ⟨y₀⟩
  have hPre₁ : PreirreducibleSpace ↥E₁_sch := by
    refine PreirreducibleSpace.mk ?_
    intro O₁ O₂ hO₁ hO₂ ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩
    have hInd : Topology.IsInducing ιE₁.base :=
      ιE₁.isClosedEmbedding.isEmbedding.isInducing
    obtain ⟨V₁, hV₁, hOV₁⟩ := hInd.isOpen_iff.mp hO₁
    obtain ⟨V₂, hV₂, hOV₂⟩ := hInd.isOpen_iff.mp hO₂
    subst hOV₁
    subst hOV₂
    have hy₁E : ιE₁.base y₁ ∈ E₁ := by
      rw [← hRange₁]
      exact ⟨y₁, rfl⟩
    have hy₂E : ιE₁.base y₂ ∈ E₁ := by
      rw [← hRange₁]
      exact ⟨y₂, rfl⟩
    obtain ⟨x, hxE, hxV₁, hxV₂⟩ :=
      hE₁.1.2 V₁ V₂ hV₁ hV₂ ⟨ιE₁.base y₁, hy₁E, hy₁⟩ ⟨ιE₁.base y₂, hy₂E, hy₂⟩
    rw [← hRange₁] at hxE
    rcases hxE with ⟨y, rfl⟩
    exact ⟨y, trivial, hxV₁, hxV₂⟩
  have hIrred₁ : IrreducibleSpace ↥E₁_sch :=
    { isPreirreducible_univ := PreirreducibleSpace.isPreirreducible_univ
      toNonempty := hNe₁ }
  have hInt₁ : AlgebraicGeometry.IsIntegral E₁_sch :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced E₁_sch
  let α := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
  let q₁ := ιE₁ ≫ p₁
  let X'₂ := CategoryTheory.Limits.pullback p₁ α
  let E₁_K' := CategoryTheory.Limits.pullback q₁ α
  let ιE₁_K' : E₁_K' ⟶ X'₂ :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst q₁ α ≫ ιE₁)
      (CategoryTheory.Limits.pullback.snd q₁ α)
      (by
        rw [CategoryTheory.Category.assoc]
        exact CategoryTheory.Limits.pullback.condition)
  have h_fst : ιE₁_K' ≫ CategoryTheory.Limits.pullback.fst p₁ α =
      CategoryTheory.Limits.pullback.fst q₁ α ≫ ιE₁ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have h_snd : ιE₁_K' ≫ CategoryTheory.Limits.pullback.snd p₁ α =
      CategoryTheory.Limits.pullback.snd q₁ α :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hRight : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.snd p₁ α)
      (CategoryTheory.Limits.pullback.fst p₁ α) α p₁ :=
    (CategoryTheory.IsPullback.of_hasPullback p₁ α).flip
  have hOuter : CategoryTheory.IsPullback
      (ιE₁_K' ≫ CategoryTheory.Limits.pullback.snd p₁ α)
      (CategoryTheory.Limits.pullback.fst q₁ α) α (ιE₁ ≫ p₁) := by
    rw [h_snd]
    exact (CategoryTheory.IsPullback.of_hasPullback q₁ α).flip
  have hPb : CategoryTheory.IsPullback ιE₁_K'
      (CategoryTheory.Limits.pullback.fst q₁ α)
      (CategoryTheory.Limits.pullback.fst p₁ α) ιE₁ :=
    CategoryTheory.IsPullback.of_right hOuter h_fst hRight
  have hCl₁_K' : AlgebraicGeometry.IsClosedImmersion ιE₁_K' :=
    AlgebraicGeometry.IsClosedImmersion.isStableUnderBaseChange.of_isPullback hPb.flip hCl₁
  have hRange₁_K' : Set.range ιE₁_K'.base =
      (CategoryTheory.Limits.pullback.fst p₁ α).base ⁻¹' E₁ := by
    let p_fst := CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.fst p₁ α) ιE₁
    have h_iso_fst : hPb.isoPullback.hom ≫ p_fst = ιE₁_K' :=
      hPb.isoPullback_hom_fst
    have hRangeEq : Set.range ιE₁_K'.base = Set.range p_fst.base := by
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        have hy := congrArg (fun f => f.base y) h_iso_fst
        have hy' : (hPb.isoPullback.hom ≫ p_fst).base y =
            p_fst.base (hPb.isoPullback.hom.base y) := by simp
        rw [hy'] at hy
        exact ⟨hPb.isoPullback.hom.base y, hy⟩
      · rintro ⟨z, rfl⟩
        refine ⟨hPb.isoPullback.inv.base z, ?_⟩
        have hz := congrArg (fun f => f.base (hPb.isoPullback.inv.base z)) h_iso_fst
        have hz1 : (hPb.isoPullback.hom ≫ p_fst).base (hPb.isoPullback.inv.base z) =
            p_fst.base (hPb.isoPullback.hom.base (hPb.isoPullback.inv.base z)) := by simp
        have hz2 : hPb.isoPullback.hom.base (hPb.isoPullback.inv.base z) = z := by simp
        rw [hz1, hz2] at hz
        exact hz.symm
    rw [hRangeEq]
    dsimp [p_fst]
    rw [AlgebraicGeometry.Scheme.Pullback.range_fst, hRange₁]
  have : AlgebraicGeometry.LocallyOfFiniteType q₁ := by
    dsimp [q₁]
    infer_instance
  let 𝒰 := E₁_sch.affineOpenCover
  let 𝒱 := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰.openCover q₁ α
  have hRed₁_K' : AlgebraicGeometry.IsReduced E₁_K' := by
    have : ∀ i : 𝒱.I₀, AlgebraicGeometry.IsReduced (𝒱.X i) := by
      intro i
      let j : 𝒰.I₀ := i
      have : AlgebraicGeometry.IsOpenImmersion (𝒰.f j) := inferInstance
      let V_j := CategoryTheory.Limits.pullback (𝒰.f j ≫ q₁) α
      change AlgebraicGeometry.IsReduced V_j
      by_cases hNe : Nonempty ↥(AlgebraicGeometry.Spec (𝒰.X j))
      · have : Nonempty ↥(AlgebraicGeometry.Spec (𝒰.X j)) := hNe
        have hIntChart : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (𝒰.X j)) :=
          AlgebraicGeometry.isIntegral_of_isOpenImmersion (𝒰.f j)
        have hDomRi : IsDomain ↑(𝒰.X j) :=
          (AlgebraicGeometry.affine_isIntegral_iff (𝒰.X j)).mp hIntChart
        let ψ_j : CommRingCat.of k₁ ⟶ 𝒰.X j :=
          AlgebraicGeometry.Spec.preimage (𝒰.f j ≫ q₁)
        have hSpec_ψ : AlgebraicGeometry.Spec.map ψ_j = 𝒰.f j ≫ q₁ :=
          AlgebraicGeometry.Spec.map_preimage (𝒰.f j ≫ q₁)
        have hLFT_j : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map ψ_j) := by
          rw [hSpec_ψ]
          infer_instance
        have hFT_hom : RingHom.FiniteType ψ_j.hom :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff
            (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_j
        let _ : Algebra k₁ ↑(𝒰.X j) := ψ_j.hom.toAlgebra
        let _ : Algebra k₁ K' := φ.toAlgebra
        have : Algebra.FiniteType k₁ ↑(𝒰.X j) := hFT_hom
        have hDomTP : IsDomain (TensorProduct k₁ ↑(𝒰.X j) K') := hDom ↑(𝒰.X j)
        have hRedTP : IsReduced (TensorProduct k₁ ↑(𝒰.X j) K') := inferInstance
        have hRedSpecTP : AlgebraicGeometry.IsReduced
            (AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ ↑(𝒰.X j) K'))) :=
          (AlgebraicGeometry.affine_isReduced_iff
            (CommRingCat.of (TensorProduct k₁ ↑(𝒰.X j) K'))).mpr hRedTP
        have h_alg_j : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap k₁ ↑(𝒰.X j))) = 𝒰.f j ≫ q₁ := by
          have h1 : CommRingCat.ofHom (algebraMap k₁ ↑(𝒰.X j)) = ψ_j := by
            ext x
            rfl
          rw [h1, hSpec_ψ]
        have h_alg_K : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap k₁ K')) = α := rfl
        let e_j : V_j ≅
            AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k₁ ↑(𝒰.X j) K')) :=
          CategoryTheory.Limits.pullback.congrHom h_alg_j.symm h_alg_K.symm ≪≫
            AlgebraicGeometry.pullbackSpecIso k₁ ↑(𝒰.X j) K'
        exact AlgebraicGeometry.isReduced_of_isOpenImmersion e_j.hom
      · have : IsEmpty ↥(AlgebraicGeometry.Spec (𝒰.X j)) := not_nonempty_iff.mp hNe
        have : IsEmpty ↥V_j :=
          Function.isEmpty (CategoryTheory.Limits.pullback.fst (𝒰.f j ≫ q₁) α).base
        have : ∀ x : ↥V_j, _root_.IsReduced ↑(V_j.presheaf.stalk x) :=
          fun x => IsEmpty.elim inferInstance x
        exact AlgebraicGeometry.isReduced_of_isReduced_stalk V_j
    exact AlgebraicGeometry.IsReduced.of_openCover E₁_K' 𝒱
  have hKerVan : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (f : Z ⟶ X'₂)
      [AlgebraicGeometry.IsClosedImmersion f] [AlgebraicGeometry.IsReduced Z],
      (f.ker.support : Set ↥X'₂) = Set.range f.base ∧
      f.ker = AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal f.ker.support := by
    intro Z f _ _
    have hSupp : (f.ker.support : Set ↥X'₂) = Set.range f.base := by
      rw [AlgebraicGeometry.Scheme.Hom.support_ker]
      exact f.isClosedEmbedding.isClosed_range.closure_eq
    refine ⟨hSupp, ?_⟩
    rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support]
    symm
    apply AlgebraicGeometry.Scheme.IdealSheafData.ext
    funext W
    rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal]
    apply Ideal.IsRadical.radical
    rw [AlgebraicGeometry.Scheme.Hom.ker_apply]
    intro a ⟨m, hm⟩
    rw [RingHom.mem_ker] at hm ⊢
    rw [map_pow] at hm
    have : IsReduced ↑(Z.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj W.1))) :=
      AlgebraicGeometry.IsReduced.component_reduced ((TopologicalSpace.Opens.map f.base).obj W.1)
    exact IsReduced.eq_zero _ ⟨m, hm⟩
  obtain ⟨hSupp₁, hKer₁⟩ := hKerVan E₁_K' ιE₁_K'
  obtain ⟨hSupp₂, hKer₂⟩ := hKerVan E₂_sch ιE₂
  have hSuppEq : ιE₁_K'.ker.support = ιE₂.ker.support := by
    apply TopologicalSpace.Closeds.ext
    rw [hSupp₁, hSupp₂, hRange₁_K', hRange₂]
  have hKerEq : ιE₁_K'.ker = ιE₂.ker := by
    rw [hKer₁, hKer₂, hSuppEq]
  let Θ_hom : E₁_K' ⟶ E₂_sch :=
    AlgebraicGeometry.IsClosedImmersion.lift ιE₂ ιE₁_K' (le_of_eq hKerEq.symm)
  let Θ_inv : E₂_sch ⟶ E₁_K' :=
    AlgebraicGeometry.IsClosedImmersion.lift ιE₁_K' ιE₂ (le_of_eq hKerEq)
  have h_hom_fac : Θ_hom ≫ ιE₂ = ιE₁_K' :=
    AlgebraicGeometry.IsClosedImmersion.lift_fac ιE₂ ιE₁_K' (le_of_eq hKerEq.symm)
  have h_inv_fac : Θ_inv ≫ ιE₁_K' = ιE₂ :=
    AlgebraicGeometry.IsClosedImmersion.lift_fac ιE₁_K' ιE₂ (le_of_eq hKerEq)
  let Θ : E₁_K' ≅ E₂_sch :=
    { hom := Θ_hom
      inv := Θ_inv
      hom_inv_id := by
        apply (cancel_mono ιE₁_K').mp
        rw [CategoryTheory.Category.assoc, h_inv_fac, h_hom_fac, CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply (cancel_mono ιE₂).mp
        rw [CategoryTheory.Category.assoc, h_hom_fac, h_inv_fac, CategoryTheory.Category.id_comp] }
  refine ⟨E₁_sch, ιE₁, hCl₁, hInt₁, hRange₁, Θ, ?_⟩
  have h_comp : Θ.hom ≫ ιE₂ = ιE₁_K' := h_hom_fac
  rw [← CategoryTheory.Category.assoc Θ.hom ιE₂, h_comp]
  exact h_snd

theorem weil_hasStablePointedGeomFiber_algClosed_ext (C S : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ S) [AlgebraicGeometry.IsProper g]
    (n : ℕ) (τ : Fin n → (S ⟶ C))
    (hSec : ∀ j : Fin n, τ j ≫ g = 𝟙 S)
    (k₁ K' : Type u) [Field k₁] [IsAlgClosed k₁] [Field K'] [IsAlgClosed K']
    (φ : k₁ →+* K')
    (s₁ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ S)
    (s₂ : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ S)
    (hs : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ s₁ = s₂)
    (hStab₁ : HasStablePointedGeomFiber g n τ k₁ s₁) :
    HasStablePointedGeomFiber g n τ K' s₂ :=
by
  let X₁ := CategoryTheory.Limits.pullback g s₁
  let fst₁ := CategoryTheory.Limits.pullback.fst g s₁
  let p₁ := CategoryTheory.Limits.pullback.snd g s₁
  let X₂ := CategoryTheory.Limits.pullback g s₂
  let fst₂ := CategoryTheory.Limits.pullback.fst g s₂
  let p₂ := CategoryTheory.Limits.pullback.snd g s₂
  let α := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
  let X'₂ := CategoryTheory.Limits.pullback p₁ α
  let π := CategoryTheory.Limits.pullback.fst p₁ α
  let p'₂ := CategoryTheory.Limits.pullback.snd p₁ α
  have hProp₁ : AlgebraicGeometry.IsProper p₁ := inferInstance
  have hLFT₁ : AlgebraicGeometry.LocallyOfFiniteType p₁ := inferInstance
  have hPb_paste : CategoryTheory.IsPullback (π ≫ fst₁) p'₂ g s₂ := by
    have h := (CategoryTheory.IsPullback.of_hasPullback p₁ α).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback g s₁)
    dsimp [α, π, fst₁, p'₂] at h ⊢
    rwa [hs] at h
  let Ξ : X'₂ ≅ X₂ := hPb_paste.isoPullback
  have hΞ_hom_fst : Ξ.hom ≫ fst₂ = π ≫ fst₁ := hPb_paste.isoPullback_hom_fst
  have hΞ_hom_snd : Ξ.hom ≫ p₂ = p'₂ := hPb_paste.isoPullback_hom_snd
  have hΞ_inv_snd : Ξ.inv ≫ p'₂ = p₂ := hPb_paste.isoPullback_inv_snd
  have hΞ_left : ∀ x : ↥X'₂, Ξ.inv.base (Ξ.hom.base x) = x := by
    intro x
    simp
  have hΞ_right : ∀ y : ↥X₂, Ξ.hom.base (Ξ.inv.base y) = y := by
    intro y
    simp
  have hIrredBwdΞ : ∀ T : Set ↥X₂,
      T ∈ irreducibleComponents ↥X₂ →
      Ξ.inv.base '' T ∈ irreducibleComponents ↥X'₂ := by
    intro T ⟨hTIrred, hTMax⟩
    refine ⟨hTIrred.image Ξ.inv.base Ξ.inv.continuous.continuousOn, ?_⟩
    intro W hWIrred hTW
    have hSub : T ⊆ Ξ.hom.base '' W := by
      intro y hy
      exact ⟨Ξ.inv.base y, hTW ⟨y, hy, rfl⟩, hΞ_right y⟩
    have hEq : Ξ.hom.base '' W ⊆ T :=
      hTMax (hWIrred.image Ξ.hom.base Ξ.hom.continuous.continuousOn) hSub
    intro x hx
    exact ⟨Ξ.hom.base x, hEq ⟨x, hx, rfl⟩, hΞ_left x⟩
  have hIrredFwdΞ : ∀ W : Set ↥X'₂,
      W ∈ irreducibleComponents ↥X'₂ →
      Ξ.hom.base '' W ∈ irreducibleComponents ↥X₂ := by
    intro W ⟨hWIrred, hWMax⟩
    refine ⟨hWIrred.image Ξ.hom.base Ξ.hom.continuous.continuousOn, ?_⟩
    intro T hTIrred hWT
    have hSub : W ⊆ Ξ.inv.base '' T := by
      intro x hx
      exact ⟨Ξ.hom.base x, hWT ⟨x, hx, rfl⟩, hΞ_left x⟩
    have hEq : Ξ.inv.base '' T ⊆ W :=
      hWMax (hTIrred.image Ξ.inv.base Ξ.inv.continuous.continuousOn) hSub
    intro y hy
    exact ⟨Ξ.inv.base y, hEq ⟨y, hy, rfl⟩, hΞ_right y⟩
  obtain ⟨hDom, hTop⟩ :=
    weil_algClosed_finiteType_baseChange_open_irredFiber_and_domain k₁ K' φ
  obtain ⟨hSurj_π, hOpen_π, hFib_π⟩ := hTop X₁ p₁
  obtain ⟨hAff_pkg, c_pkg, t_pkg, hCoord_pkg, hBC_pkg⟩ :=
    weil_commRing_projectiveSpace_chart_and_baseChange_pkg.{u}
  obtain ⟨hProp_P1_val, hSup_W, hc_hom_W, hPoly_W, _ht_diag_W, _hSub_W,
      hEval_W, hInter_W, _hc_ov_W, _ht_ov_W⟩ := hCoord_pkg k₁ 1
  have hProp_P1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k₁ 1).hom :=
    hProp_P1_val
  obtain ⟨Φ_P1, _hΦP1_comm, hPb_P1, _hΦP1_charts⟩ := hBC_pkg k₁ K' φ 1
  have hP1Sec : ∀ (z : ↥(weilProjectiveSpaceOver k₁ 1).left),
      closure ({z} : Set ↥(weilProjectiveSpaceOver k₁ 1).left) ≠ Set.univ →
      ∃ β : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ (weilProjectiveSpaceOver k₁ 1).left,
        β ≫ (weilProjectiveSpaceOver k₁ 1).hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁)) ∧
        z ∈ Set.range β.base := by
    intro z hz
    let P1 := (weilProjectiveSpaceOver k₁ 1).left
    let W : Fin 2 → P1.Opens := weilProjBasicOpen k₁ 1
    let hAff_W : ∀ b : Fin 2, AlgebraicGeometry.IsAffineOpen (W b) := hAff_pkg k₁ 1
    let e_mv_poly : MvPolynomial (Fin 1) k₁ ≃+* Polynomial k₁ :=
      (MvPolynomial.uniqueAlgEquiv k₁ (Fin 1)).toRingEquiv
    have hDom_mv : IsDomain (MvPolynomial (Fin 1) k₁) :=
      MulEquiv.isDomain (Polynomial k₁) e_mv_poly.toMulEquiv
    have hIrred_W : ∀ b : Fin 2, IsIrreducible (W b : Set ↥P1) := by
      intro b
      obtain ⟨θ_b, _⟩ := hPoly_W b
      let R_b := P1.presheaf.obj (Opposite.op (W b))
      have : IsDomain ↑R_b :=
        MulEquiv.isDomain (MvPolynomial (Fin 1) k₁) θ_b.symm.toMulEquiv
      have hIrredSpec : IsIrreducible (Set.univ : Set ↥(AlgebraicGeometry.Spec R_b)) :=
        IrreducibleSpace.isIrreducible_univ ↥(AlgebraicGeometry.Spec R_b)
      have hImg : (hAff_W b).fromSpec.base '' Set.univ = (W b : Set ↥P1) := by
        rw [Set.image_univ]
        exact (hAff_W b).range_fromSpec
      rw [← hImg]
      exact hIrredSpec.image (hAff_W b).fromSpec.base (hAff_W b).fromSpec.continuous.continuousOn
    have hInter01_ne : ((W 0 ⊓ W 1 : P1.Opens) : Set ↥P1).Nonempty := by
      obtain ⟨ψ₀, _hψ₀_c, hψ₀_t⟩ := hEval_W 0 k₁ (RingHom.id k₁) (fun _ => 1) rfl
      let q₀ : PrimeSpectrum ↑(P1.presheaf.obj (Opposite.op (W 0))) :=
        PrimeSpectrum.comap ψ₀ ⊥
      have hq₀_basic : q₀ ∈ PrimeSpectrum.basicOpen (t_pkg k₁ 1 0 1) := by
        change t_pkg k₁ 1 0 1 ∉ q₀.asIdeal
        change ψ₀ (t_pkg k₁ 1 0 1) ∉ (⊥ : Ideal k₁)
        rw [hψ₀_t, Ideal.mem_bot]
        exact one_ne_zero
      have hPre_basic := (hAff_W 0).fromSpec_preimage_basicOpen (t_pkg k₁ 1 0 1)
      have hImg_mem : (hAff_W 0).fromSpec.base q₀ ∈ P1.basicOpen (t_pkg k₁ 1 0 1) := by
        have h1 : q₀ ∈ (TopologicalSpace.Opens.map (hAff_W 0).fromSpec.base).obj
            (P1.basicOpen (t_pkg k₁ 1 0 1)) := by
          rwa [hPre_basic]
        exact h1
      rw [hInter_W 0 1] at hImg_mem
      exact ⟨(hAff_W 0).fromSpec.base q₀, hImg_mem⟩
    have hInter_ne : ∀ b₁ b₂ : Fin 2, ((W b₁ : Set ↥P1) ∩ (W b₂ : Set ↥P1)).Nonempty := by
      intro b₁ b₂
      fin_cases b₁ <;> fin_cases b₂
      · obtain ⟨x, hx⟩ := (hIrred_W 0).1
        exact ⟨x, hx, hx⟩
      · exact hInter01_ne
      · obtain ⟨x, hx0, hx1⟩ := hInter01_ne
        exact ⟨x, hx1, hx0⟩
      · obtain ⟨x, hx⟩ := (hIrred_W 1).1
        exact ⟨x, hx, hx⟩
    have hz_top : z ∈ (⨆ b : Fin 2, W b) := by
      rw [hSup_W]
      trivial
    obtain ⟨a, hza⟩ := TopologicalSpace.Opens.mem_iSup.mp hz_top
    let R_a := P1.presheaf.obj (Opposite.op (W a))
    let p : PrimeSpectrum ↑R_a := (hAff_W a).primeIdealOf ⟨z, hza⟩
    have hp_fromSpec : (hAff_W a).fromSpec.base p = z :=
      (hAff_W a).fromSpec_primeIdealOf ⟨z, hza⟩
    have hp_ne_bot : p.asIdeal ≠ ⊥ := by
      intro hp_bot
      apply hz
      have hWa_sub : (W a : Set ↥P1) ⊆ closure ({z} : Set ↥P1) := by
        intro w hw
        let q : PrimeSpectrum ↑R_a := (hAff_W a).primeIdealOf ⟨w, hw⟩
        have hq_fromSpec : (hAff_W a).fromSpec.base q = w :=
          (hAff_W a).fromSpec_primeIdealOf ⟨w, hw⟩
        let p_sp : ↥(AlgebraicGeometry.Spec R_a) := p
        let q_sp : ↥(AlgebraicGeometry.Spec R_a) := q
        have hq_cl : q_sp ∈ closure ({p_sp} : Set ↥(AlgebraicGeometry.Spec R_a)) := by
          change q ∈ closure ({p} : Set (PrimeSpectrum ↑R_a))
          rw [PrimeSpectrum.closure_singleton]
          change p.asIdeal ≤ q.asIdeal
          rw [hp_bot]
          exact bot_le
        have h_img_cl : (hAff_W a).fromSpec.base q_sp ∈
            closure ((hAff_W a).fromSpec.base '' ({p_sp} : Set ↥(AlgebraicGeometry.Spec R_a))) :=
          image_closure_subset_closure_image (hAff_W a).fromSpec.continuous
            ⟨q_sp, hq_cl, rfl⟩
        have h_img_s :
            (hAff_W a).fromSpec.base '' ({p_sp} : Set ↥(AlgebraicGeometry.Spec R_a)) = {z} := by
          rw [Set.image_singleton]
          exact congrArg Set.singleton hp_fromSpec
        rw [h_img_s] at h_img_cl
        exact hq_fromSpec ▸ h_img_cl
      have hAll_sub : ∀ b : Fin 2, (W b : Set ↥P1) ⊆ closure ({z} : Set ↥P1) := by
        intro b y hy
        by_contra hy_not
        obtain ⟨x, hxa, hxb⟩ := hInter_ne a b
        obtain ⟨u, _hu_b, hu_not_cl, hu_a⟩ :=
          (hIrred_W b).isPreirreducible
            (closure ({z} : Set ↥P1))ᶜ (W a : Set ↥P1)
            isClosed_closure.isOpen_compl (W a).2
            ⟨y, hy, hy_not⟩ ⟨x, hxb, hxa⟩
        exact hu_not_cl (hWa_sub hu_a)
      ext u
      simp only [Set.mem_univ, iff_true]
      have hu_top : u ∈ (⨆ b : Fin 2, W b) := by
        rw [hSup_W]
        trivial
      obtain ⟨b, hub⟩ := TopologicalSpace.Opens.mem_iSup.mp hu_top
      exact hAll_sub b hub
    obtain ⟨θ_a, hθ_a_C⟩ := hPoly_W a
    let e_tot : Polynomial k₁ ≃+* ↑R_a := e_mv_poly.symm.trans θ_a
    let P_poly : Ideal (Polynomial k₁) := Ideal.comap e_tot.toRingHom p.asIdeal
    have hPrime_poly : P_poly.IsPrime := Ideal.comap_isPrime e_tot.toRingHom p.asIdeal
    have hP_poly_ne_bot : P_poly ≠ ⊥ := by
      intro h0
      apply hp_ne_bot
      ext r
      simp only [Ideal.mem_bot]
      constructor
      · intro hr
        have h_mem : e_tot.symm r ∈ P_poly := by
          change e_tot (e_tot.symm r) ∈ p.asIdeal
          rwa [e_tot.apply_symm_apply]
        rw [h0, Ideal.mem_bot] at h_mem
        have h_zero := congrArg e_tot h_mem
        simpa using h_zero
      · rintro rfl
        exact p.asIdeal.zero_mem
    have hMax_poly : P_poly.IsMaximal := IsPrime.to_maximal_ideal hP_poly_ne_bot
    let M_mv : Ideal (MvPolynomial (Fin 1) k₁) := Ideal.comap θ_a.toRingHom p.asIdeal
    have hM_eq_comap : M_mv = Ideal.comap e_mv_poly.toRingHom P_poly := by
      ext f
      change θ_a f ∈ p.asIdeal ↔ e_tot (e_mv_poly f) ∈ p.asIdeal
      dsimp [e_tot]
      rw [e_mv_poly.symm_apply_apply]
    have hMax_mv : M_mv.IsMaximal := by
      rw [hM_eq_comap]
      exact Ideal.comap_isMaximal_of_surjective e_mv_poly.toRingHom e_mv_poly.surjective
    obtain ⟨v, hv⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hMax_mv
    let ψ : ↑R_a →+* k₁ := (MvPolynomial.eval v).comp θ_a.symm.toRingHom
    let β : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ P1 :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ (hAff_W a).fromSpec
    refine ⟨β, ?_, ?_⟩
    · dsimp [β]
      rw [CategoryTheory.Category.assoc, ← hc_hom_W a,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hψc : ψ.comp (c_pkg k₁ 1 a) = RingHom.id k₁ := by
        ext r
        dsimp [ψ]
        have hc_eq : c_pkg k₁ 1 a r = θ_a (MvPolynomial.C r) := by
          rw [← hθ_a_C]
          rfl
        rw [hc_eq, θ_a.symm_apply_apply, MvPolynomial.eval_C]
      rw [hψc]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of k₁)
    · let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)) :=
        (⊥ : PrimeSpectrum k₁)
      refine ⟨pt₀, ?_⟩
      have h_comap : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base pt₀ = p := by
        apply PrimeSpectrum.ext
        ext r
        change ψ r ∈ (⊥ : Ideal k₁) ↔ r ∈ p.asIdeal
        rw [Ideal.mem_bot]
        dsimp [ψ]
        have h_van : ∀ g : MvPolynomial (Fin 1) k₁,
            MvPolynomial.eval v g = 0 ↔ g ∈ MvPolynomial.vanishingIdeal k₁ {v} := by
          intro g
          simp [MvPolynomial.vanishingIdeal]
        rw [h_van (θ_a.symm r), ← hv]
        change θ_a (θ_a.symm r) ∈ p.asIdeal ↔ r ∈ p.asIdeal
        rw [θ_a.apply_symm_apply]
      have h_app : β.base pt₀ =
          (hAff_W a).fromSpec.base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).base pt₀) := rfl
      rw [h_app, h_comap, hp_fromSpec]
  intro E₂ E₂_sch ιE₂ hE₂_comp hCl₂ hInt₂ hRange₂ ⟨isoP1₂, hisoP1₂⟩
  change E₂ ∈ irreducibleComponents ↥X₂ at hE₂_comp
  let E'₂ : Set ↥X'₂ := Ξ.inv.base '' E₂
  have hE'₂_comp : E'₂ ∈ irreducibleComponents ↥X'₂ := hIrredBwdΞ E₂ hE₂_comp
  let E₁ : Set ↥X₁ := π.base '' E'₂
  have hE₁_comp : E₁ ∈ irreducibleComponents ↥X₁ :=
    image_mem_irreducibleComponents_of_isPreirreducible_fiber
      π.base π.continuous hOpen_π hFib_π hSurj_π hE'₂_comp
  have hPre_E₁_comp : π.base ⁻¹' E₁ ∈ irreducibleComponents ↥X'₂ :=
    ((irreducibleComponentsEquivOfIsPreirreducibleFiber
      π.base π.continuous hOpen_π hFib_π hSurj_π) ⟨E₁, hE₁_comp⟩).2
  have hPre_E₁_eq : π.base ⁻¹' E₁ = E'₂ := by
    apply Set.Subset.antisymm
    · exact hE'₂_comp.2 hPre_E₁_comp.1 (Set.subset_preimage_image π.base E'₂)
    · exact Set.subset_preimage_image π.base E'₂
  let ι'E₂ : E₂_sch ⟶ X'₂ := ιE₂ ≫ Ξ.inv
  have : AlgebraicGeometry.IsClosedImmersion ιE₂ := hCl₂
  have : AlgebraicGeometry.IsIntegral E₂_sch := hInt₂
  have hCl'₂ : AlgebraicGeometry.IsClosedImmersion ι'E₂ := inferInstance
  have hRange'₂ : Set.range ι'E₂.base = π.base ⁻¹' E₁ := by
    rw [hPre_E₁_eq]
    ext x
    have h_app : ∀ z : ↥E₂_sch, ι'E₂.base z = Ξ.inv.base (ιE₂.base z) := fun _ => rfl
    simp only [E'₂, Set.mem_range, Set.mem_image, h_app]
    constructor
    · rintro ⟨z, rfl⟩
      exact ⟨ιE₂.base z, by rw [← hRange₂]; exact ⟨z, rfl⟩, rfl⟩
    · rintro ⟨y, hy, rfl⟩
      rw [← hRange₂] at hy
      rcases hy with ⟨z, rfl⟩
      exact ⟨z, rfl⟩
  obtain ⟨E₁_sch, ιE₁, hCl₁, hInt₁, hRange₁, Θ, hΘ⟩ :=
    weil_algClosed_irreducible_subscheme_baseChange_iso k₁ K' φ hDom
      X₁ p₁ E₁ hE₁_comp E₂_sch ι'E₂ hRange'₂
  have : AlgebraicGeometry.IsClosedImmersion ιE₁ := hCl₁
  have hProp_E₁ : AlgebraicGeometry.IsProper (ιE₁ ≫ p₁) :=
    CategoryTheory.MorphismProperty.comp_mem _ ιE₁ p₁ inferInstance inferInstance
  let Ψ : CategoryTheory.Limits.pullback (ιE₁ ≫ p₁) α ≅
      CategoryTheory.Limits.pullback (weilProjectiveSpaceOver k₁ 1).hom α :=
    Θ ≪≫ isoP1₂ ≪≫ hPb_P1.isoPullback
  have hΨ_snd : Ψ.hom ≫
      CategoryTheory.Limits.pullback.snd (weilProjectiveSpaceOver k₁ 1).hom α =
      CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁) α := by
    dsimp [Ψ]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      hPb_P1.isoPullback_hom_snd, ← hisoP1₂]
    have h_ι' : ι'E₂ ≫ p'₂ = ιE₂ ≫ p₂ := by
      dsimp [ι'E₂]
      rw [CategoryTheory.Category.assoc, hΞ_inv_snd]
    have hΘ' : Θ.hom ≫ (ι'E₂ ≫ p'₂) =
        CategoryTheory.Limits.pullback.snd (ιE₁ ≫ p₁) α := hΘ
    rw [h_ι'] at hΘ'
    exact hΘ'
  obtain ⟨isoP1₁, hisoP1₁⟩ :=
    weil_algClosed_proper_scheme_iso_descent k₁ K' φ
      E₁_sch (weilProjectiveSpaceOver k₁ 1).left
      (ιE₁ ≫ p₁) (weilProjectiveSpaceOver k₁ 1).hom ⟨Ψ, hΨ_snd⟩
  obtain ⟨q₁, q₂, q₃, hne12, hne13, hne23, hq₁E₁, hq₂E₁, hq₃E₁, hSpec₁⟩ :=
    hStab₁ E₁ E₁_sch ιE₁ hE₁_comp hCl₁ hInt₁ hRange₁ ⟨isoP1₁, hisoP1₁.symm⟩
  let pt₁ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₁)) := default
  let pt₂ : ↥(AlgebraicGeometry.Spec (CommRingCat.of K')) := default
  have hα_pt : α.base pt₂ = pt₁ := Subsingleton.elim _ _
  have hLiftSec : ∀ q : ↥X₁, q ∈ E₁ →
      ((∃ E'₁ ∈ irreducibleComponents ↥X₁, E'₁ ≠ E₁ ∧ q ∈ E'₁) ∨
        (∃ j : Fin n, fst₁.base q ∈ Set.range (τ j).base)) →
      ∃ γ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ X₁,
        γ ≫ p₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁)) ∧
        γ.base pt₁ = q := by
    intro q hqE₁ hq_spec
    rcases hq_spec with ⟨E'₁, hE'₁_comp, hE'₁_ne, hqE'₁⟩ | ⟨j, hj⟩
    · have hqRange : q ∈ Set.range ιE₁.base := by rwa [hRange₁]
      rcases hqRange with ⟨y_q, hy_q⟩
      let z_q : ↥(weilProjectiveSpaceOver k₁ 1).left := isoP1₁.hom.base y_q
      have hz_q_not_dense :
          closure ({z_q} : Set ↥(weilProjectiveSpaceOver k₁ 1).left) ≠ Set.univ := by
        intro hDense
        apply hE'₁_ne
        let f_map : ↥(weilProjectiveSpaceOver k₁ 1).left → ↥X₁ :=
          fun w => ιE₁.base (isoP1₁.inv.base w)
        have hf_cont : Continuous f_map :=
          ιE₁.continuous.comp isoP1₁.inv.continuous
        have hf_zq : f_map z_q = q := by
          dsimp [f_map, z_q]
          have h_inv_hom : isoP1₁.inv.base (isoP1₁.hom.base y_q) = y_q := by simp
          rw [h_inv_hom, hy_q]
        have hE'₁_closed : IsClosed E'₁ :=
          isClosed_of_mem_irreducibleComponents E'₁ hE'₁_comp
        have hcl_q : closure ({q} : Set ↥X₁) ⊆ E'₁ :=
          closure_minimal (Set.singleton_subset_iff.mpr hqE'₁) hE'₁_closed
        have h_img_sub : f_map '' Set.univ ⊆ E'₁ := by
          rw [← hDense]
          calc
            f_map '' closure ({z_q} : Set _) ⊆ closure (f_map '' {z_q}) :=
              image_closure_subset_closure_image hf_cont
            _ = closure ({q} : Set ↥X₁) := by rw [Set.image_singleton, hf_zq]
            _ ⊆ E'₁ := hcl_q
        have hE₁_sub_E'₁ : E₁ ⊆ E'₁ := by
          intro x hx
          rw [← hRange₁] at hx
          rcases hx with ⟨y, rfl⟩
          apply h_img_sub
          refine ⟨isoP1₁.hom.base y, trivial, ?_⟩
          dsimp [f_map]
          have h_inv_hom : isoP1₁.inv.base (isoP1₁.hom.base y) = y := by simp
          rw [h_inv_hom]
        exact Set.Subset.antisymm (hE₁_comp.2 hE'₁_comp.1 hE₁_sub_E'₁) hE₁_sub_E'₁
      obtain ⟨β, hβ_hom, hβ_range⟩ := hP1Sec z_q hz_q_not_dense
      refine ⟨β ≫ isoP1₁.inv ≫ ιE₁, ?_, ?_⟩
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, ← hisoP1₁,
          ← CategoryTheory.Category.assoc isoP1₁.inv, CategoryTheory.Iso.inv_hom_id,
          CategoryTheory.Category.id_comp, hβ_hom]
      · rcases hβ_range with ⟨u, hu⟩
        have hu_pt : u = pt₁ := Subsingleton.elim _ _
        rw [← hu_pt]
        have h_app : (β ≫ isoP1₁.inv ≫ ιE₁).base u =
            ιE₁.base (isoP1₁.inv.base (β.base u)) := by simp
        rw [h_app, hu]
        dsimp [z_q]
        have h_inv_hom : isoP1₁.inv.base (isoP1₁.hom.base y_q) = y_q := by simp
        rw [h_inv_hom, hy_q]
    · let σ₁ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ X₁ :=
        CategoryTheory.Limits.pullback.lift (s₁ ≫ τ j)
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁)))
          (by rw [CategoryTheory.Category.assoc, hSec j,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
      have hσ₁_fst : σ₁ ≫ fst₁ = s₁ ≫ τ j :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hσ₁_snd : σ₁ ≫ p₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁)) :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hOuter : CategoryTheory.IsPullback (σ₁ ≫ p₁) s₁ s₁ (τ j ≫ g) := by
        rw [hσ₁_snd, hSec j]
        exact CategoryTheory.IsPullback.of_horiz_isIso
          ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
      have hRight : CategoryTheory.IsPullback p₁ fst₁ s₁ g :=
        (CategoryTheory.IsPullback.of_hasPullback g s₁).flip
      have hPb_sec : CategoryTheory.IsPullback σ₁ s₁ fst₁ (τ j) :=
        CategoryTheory.IsPullback.of_right hOuter hσ₁_fst hRight
      have hq_in_σ₁ : q ∈ Set.range σ₁.base := by
        have h_iso_fst : hPb_sec.isoPullback.inv ≫ σ₁ =
            CategoryTheory.Limits.pullback.fst fst₁ (τ j) :=
          hPb_sec.isoPullback_inv_fst
        have h_pre : q ∈ fst₁.base ⁻¹' Set.range (τ j).base := hj
        have h_rng : Set.range (CategoryTheory.Limits.pullback.fst fst₁ (τ j)).base =
            fst₁.base ⁻¹' Set.range (τ j).base :=
          AlgebraicGeometry.Scheme.Pullback.range_fst fst₁ (τ j)
        rw [← h_rng] at h_pre
        rcases h_pre with ⟨w, hw⟩
        refine ⟨hPb_sec.isoPullback.inv.base w, ?_⟩
        have h_ev := congrArg (fun f => f.base w) h_iso_fst
        have h_lhs : (hPb_sec.isoPullback.inv ≫ σ₁).base w =
            σ₁.base (hPb_sec.isoPullback.inv.base w) := rfl
        rw [h_lhs, hw] at h_ev
        exact h_ev
      rcases hq_in_σ₁ with ⟨u, hu⟩
      refine ⟨σ₁, hσ₁_snd, ?_⟩
      have hu_pt : u = pt₁ := Subsingleton.elim _ _
      rwa [← hu_pt]
  obtain ⟨γ₁, hγ₁_p, hγ₁_pt⟩ :=
    hLiftSec q₁ hq₁E₁ (hSpec₁ q₁ (by simp))
  obtain ⟨γ₂, hγ₂_p, hγ₂_pt⟩ :=
    hLiftSec q₂ hq₂E₁ (hSpec₁ q₂ (by simp))
  obtain ⟨γ₃, hγ₃_p, hγ₃_pt⟩ :=
    hLiftSec q₃ hq₃E₁ (hSpec₁ q₃ (by simp))
  let liftK' : ∀ (γ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ X₁),
      γ ≫ p₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁)) →
      (AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ X₂) :=
    fun γ hγ =>
      CategoryTheory.Limits.pullback.lift (α ≫ γ ≫ fst₁)
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K')))
        (by
          have hcond : fst₁ ≫ g = p₁ ≫ s₁ := CategoryTheory.Limits.pullback.condition
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hcond,
            ← CategoryTheory.Category.assoc γ, hγ, CategoryTheory.Category.id_comp,
            hs, CategoryTheory.Category.id_comp])
  have hLiftK'_proj : ∀ (γ : AlgebraicGeometry.Spec (CommRingCat.of k₁) ⟶ X₁)
      (hγ : γ ≫ p₁ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₁))),
      π.base (Ξ.inv.base ((liftK' γ hγ).base pt₂)) = γ.base pt₁ ∧
      fst₂.base ((liftK' γ hγ).base pt₂) = fst₁.base (γ.base pt₁) := by
    intro γ hγ
    let γ' : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ X'₂ :=
      CategoryTheory.Limits.pullback.lift (α ≫ γ)
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K')))
        (by rw [CategoryTheory.Category.assoc, hγ,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hγ'_Ξ : γ' ≫ Ξ.hom = liftK' γ hγ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc]
        change γ' ≫ (Ξ.hom ≫ fst₂) = liftK' γ hγ ≫ fst₂
        rw [hΞ_hom_fst, ← CategoryTheory.Category.assoc]
        dsimp [γ', liftK', π, fst₂]
        rw [CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
      · rw [CategoryTheory.Category.assoc]
        change γ' ≫ (Ξ.hom ≫ p₂) = liftK' γ hγ ≫ p₂
        rw [hΞ_hom_snd]
        dsimp [γ', liftK', p'₂, p₂]
        rw [CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd]
    have h_inv_comp : liftK' γ hγ ≫ Ξ.inv ≫ π = α ≫ γ := by
      rw [← hγ'_Ξ, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc Ξ.hom,
        CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
      exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    constructor
    · have h_eval := congrArg (fun f => f.base pt₂) h_inv_comp
      have h_lhs : (liftK' γ hγ ≫ Ξ.inv ≫ π).base pt₂ =
          π.base (Ξ.inv.base ((liftK' γ hγ).base pt₂)) := by simp
      have h_rhs : (α ≫ γ).base pt₂ = γ.base (α.base pt₂) := by simp
      rw [h_lhs, h_rhs, hα_pt] at h_eval
      exact h_eval
    · have h_fst : liftK' γ hγ ≫ fst₂ = α ≫ γ ≫ fst₁ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_eval := congrArg (fun f => f.base pt₂) h_fst
      have h_lhs : (liftK' γ hγ ≫ fst₂).base pt₂ =
          fst₂.base ((liftK' γ hγ).base pt₂) := by simp
      have h_rhs : (α ≫ γ ≫ fst₁).base pt₂ =
          fst₁.base (γ.base (α.base pt₂)) := by simp
      rw [h_lhs, h_rhs, hα_pt] at h_eval
      exact h_eval
  let q2_1 : ↥X₂ := (liftK' γ₁ hγ₁_p).base pt₂
  let q2_2 : ↥X₂ := (liftK' γ₂ hγ₂_p).base pt₂
  let q2_3 : ↥X₂ := (liftK' γ₃ hγ₃_p).base pt₂
  obtain ⟨hq2_1_π, hq2_1_fst⟩ := hLiftK'_proj γ₁ hγ₁_p
  obtain ⟨hq2_2_π, hq2_2_fst⟩ := hLiftK'_proj γ₂ hγ₂_p
  obtain ⟨hq2_3_π, hq2_3_fst⟩ := hLiftK'_proj γ₃ hγ₃_p
  rw [hγ₁_pt] at hq2_1_π hq2_1_fst
  rw [hγ₂_pt] at hq2_2_π hq2_2_fst
  rw [hγ₃_pt] at hq2_3_π hq2_3_fst
  have hMemE₂ : ∀ q2 : ↥X₂, π.base (Ξ.inv.base q2) ∈ E₁ → q2 ∈ E₂ := by
    intro q2 hq2
    have h1 : Ξ.inv.base q2 ∈ π.base ⁻¹' E₁ := hq2
    rw [hPre_E₁_eq] at h1
    rcases h1 with ⟨y, hy, hyeq⟩
    have h2 : Ξ.hom.base (Ξ.inv.base q2) = Ξ.hom.base (Ξ.inv.base y) :=
      congrArg Ξ.hom.base hyeq.symm
    rw [hΞ_right q2, hΞ_right y] at h2
    rwa [h2]
  refine ⟨q2_1, q2_2, q2_3,
    fun h => hne12 (hq2_1_π.symm.trans ((congrArg (fun x => π.base (Ξ.inv.base x)) h).trans hq2_2_π)),
    fun h => hne13 (hq2_1_π.symm.trans ((congrArg (fun x => π.base (Ξ.inv.base x)) h).trans hq2_3_π)),
    fun h => hne23 (hq2_2_π.symm.trans ((congrArg (fun x => π.base (Ξ.inv.base x)) h).trans hq2_3_π)),
    hMemE₂ q2_1 (by rwa [hq2_1_π]),
    hMemE₂ q2_2 (by rwa [hq2_2_π]),
    hMemE₂ q2_3 (by rwa [hq2_3_π]),
    ?_⟩
  have hTransferSpec : ∀ (q2 : ↥X₂) (q : ↥X₁),
      π.base (Ξ.inv.base q2) = q →
      fst₂.base q2 = fst₁.base q →
      ((∃ E'₁ ∈ irreducibleComponents ↥X₁, E'₁ ≠ E₁ ∧ q ∈ E'₁) ∨
        (∃ j : Fin n, fst₁.base q ∈ Set.range (τ j).base)) →
      (∃ E'₂_c ∈ irreducibleComponents ↥X₂, E'₂_c ≠ E₂ ∧ q2 ∈ E'₂_c) ∨
        (∃ j : Fin n, fst₂.base q2 ∈ Set.range (τ j).base) := by
    intro q2 q hq2_π hq2_fst hq_sp
    rcases hq_sp with ⟨E'₁, hE'₁_comp, hE'₁_ne, hqE'₁⟩ | ⟨j, hj⟩
    · left
      let W' : Set ↥X'₂ := π.base ⁻¹' E'₁
      have hW'_comp : W' ∈ irreducibleComponents ↥X'₂ :=
        ((irreducibleComponentsEquivOfIsPreirreducibleFiber
          π.base π.continuous hOpen_π hFib_π hSurj_π) ⟨E'₁, hE'₁_comp⟩).2
      let E'₂_c : Set ↥X₂ := Ξ.hom.base '' W'
      refine ⟨E'₂_c, hIrredFwdΞ W' hW'_comp, ?_, ?_⟩
      · intro hEq
        apply hE'₁_ne
        have hW'_eq : W' = E'₂ := by
          ext x
          constructor
          · intro hx
            have hy : Ξ.hom.base x ∈ E₂ := by
              rw [← hEq]
              exact ⟨x, hx, rfl⟩
            exact ⟨Ξ.hom.base x, hy, hΞ_left x⟩
          · rintro ⟨y, hy, rfl⟩
            have hy' : y ∈ E'₂_c := by rwa [hEq]
            rcases hy' with ⟨x', hx', hxy'⟩
            rw [← hxy', hΞ_left x']
            exact hx'
        calc
          E'₁ = π.base '' (π.base ⁻¹' E'₁) := (hSurj_π.image_preimage E'₁).symm
          _ = π.base '' W' := rfl
          _ = π.base '' E'₂ := by rw [hW'_eq]
          _ = E₁ := rfl
      · refine ⟨Ξ.inv.base q2, ?_, hΞ_right q2⟩
        change π.base (Ξ.inv.base q2) ∈ E'₁
        rwa [hq2_π]
    · right
      refine ⟨j, ?_⟩
      rwa [hq2_fst]
  intro q2 hq2
  rcases hq2 with rfl | rfl | rfl
  · exact hTransferSpec q2_1 q₁ hq2_1_π hq2_1_fst (hSpec₁ q₁ (by simp))
  · exact hTransferSpec q2_2 q₂ hq2_2_π hq2_2_fst (hSpec₁ q₂ (by simp))
  · exact hTransferSpec q2_3 q₃ hq2_3_π hq2_3_fst (hSpec₁ q₃ (by simp))

theorem weil_proj_p1_closure_connected_of_no_ratFunc_val_split (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Finite (PrimeSpectrum R)]
    (K_R : Type u) [Field K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (M : ℕ)
    (E_bar : AlgebraicGeometry.Scheme.{u})
    (ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left)
    (hCl : AlgebraicGeometry.IsClosedImmersion ι_bar)
    (hInt : AlgebraicGeometry.IsIntegral E_bar)
    (hGenIso : ∃ isoP1 :
        CategoryTheory.Limits.pullback
          (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) ≅
        (weilProjectiveSpaceOver K_R 1).left,
      CategoryTheory.Limits.pullback.snd
          (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) =
        isoP1.hom ≫ (weilProjectiveSpaceOver K_R 1).hom)
    (hNoSplit : ¬ ∃ (p q : ℕ)
        (m₁ : Fin (p + 1) → ℕ)
        (φ₁ : ∀ μ : Fin (p + 1), Fin (m₁ μ) → RatFunc K_R)
        (m₂ : Fin (q + 1) → ℕ)
        (φ₂ : ∀ ν : Fin (q + 1), Fin (m₂ ν) → RatFunc K_R)
        (W₁ W₂ : ValuationSubring (RatFunc K_R))
        (hW₁R : ∀ x : R, RatFunc.C (algebraMap R K_R x) ∈ W₁)
        (hW₂R : ∀ x : R, RatFunc.C (algebraMap R K_R x) ∈ W₂),
        (∀ (μ : Fin (p + 1)) (j : Fin (m₁ μ)), φ₁ μ j ≠ 0) ∧
        (∀ (ν : Fin (q + 1)) (j : Fin (m₂ ν)), φ₂ ν j ≠ 0) ∧
        (∀ x ∈ IsLocalRing.maximalIdeal R,
          (⟨RatFunc.C (algebraMap R K_R x), hW₁R x⟩ : ↥W₁) ∈ IsLocalRing.maximalIdeal ↥W₁) ∧
        (∀ x ∈ IsLocalRing.maximalIdeal R,
          (⟨RatFunc.C (algebraMap R K_R x), hW₂R x⟩ : ↥W₂) ∈ IsLocalRing.maximalIdeal ↥W₂) ∧
        (∀ j : Fin (m₁ 0), φ₁ 0 j ∈ W₁) ∧
        (∀ j : Fin (m₂ 0), φ₂ 0 j ∈ W₂) ∧
        (∀ (W : ValuationSubring (RatFunc K_R))
            (hWR : ∀ x : R, RatFunc.C (algebraMap R K_R x) ∈ W),
