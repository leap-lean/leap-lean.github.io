      obtain ⟨c₁, hc₁, hρ_c₁⟩ := hRel_span _ hρF_ker (ρ_X F) rfl
      let C_tot := c₀ + c₁
      have hC_J₀ : C_tot ∈ J₀ := J₀.add_mem hc₀ hc₁
      let W := F - C_tot
      have hW_IS : W ∈ I_S := by
        have hW_eq : W = w₀ + (MvPolynomial.rename Sum.inl (ρ_X F) - c₁) := by
          dsimp [W, C_tot]; linear_combination -hF_split
        rw [hW_eq]; exact I_S.add_mem hw₀ hρ_c₁
      have hW_K : W ∈ K := K.sub_mem hF (hJ₀_le_K hC_J₀)
      obtain ⟨m₀, hm₀, H, hW_mH⟩ := hBezout_IS W hW_IS
      have hW_smul : W ∈ I_S • K := by
        by_cases hm0 : m₀ = 0
        · rw [hW_mH, hm0, map_zero, zero_mul]; exact (I_S • K).zero_mem
        · have hΨH0 : H ∈ K := by
            change Ψ H = 0
            have h1 : m₀ • Ψ H = 0 := by
              rw [Algebra.smul_def, ← Ψ.commutes m₀, ← map_mul, ← hW_mH]; exact hW_K
            exact (smul_eq_zero.mp h1).resolve_left hm0
          rw [hW_mH]
          exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem _ hm₀) hΨH0
      have hF_eq : F = C_tot + W := by dsimp [W]; ring
      rw [hF_eq]; exact Submodule.add_mem_sup hC_J₀ hW_smul
    obtain ⟨r₀, hr₀_sub, hr₀_smul⟩ :=
      Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hK_FG le_rfl hK_le
    have hΨr₀_not_q : Ψ r₀ ∉ q.asIdeal := by
      intro hmem
      have hsub_q : Ψ r₀ - 1 ∈ q.asIdeal := by
        have : Ψ r₀ - 1 = Ψ (r₀ - 1) := by rw [map_sub, map_one]
        rw [this]; exact hMaxLe (hΨ_IS_le _ hr₀_sub)
      have h1_q : (1 : A) ∈ q.asIdeal := by
        have : (1 : A) = Ψ r₀ - (Ψ r₀ - 1) := by ring
        rw [this]; exact q.asIdeal.sub_mem hmem hsub_q
      exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1_q isUnit_one)
    have hpderiv_IS : ∀ (ν : Fin M₀ ⊕ Fin L) (u : MvPolynomial (Fin M₀ ⊕ Fin L) R),
        u ∈ I_S → MvPolynomial.pderiv ν u ∈ I_S := by
      intro ν u hu
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hu
      · rintro _ ⟨m, _, rfl⟩
        change MvPolynomial.pderiv ν (MvPolynomial.C m) ∈ I_S
        rw [MvPolynomial.pderiv_C]; exact I_S.zero_mem
      · simp
      · intro u₁ u₂ _ _ ih₁ ih₂; rw [map_add]; exact I_S.add_mem ih₁ ih₂
      · intro P_s u₁ hu₁ ih₁
        rw [smul_eq_mul, MvPolynomial.pderiv_mul]
        exact I_S.add_mem (I_S.mul_mem_left _ (show u₁ ∈ I_S from hu₁)) (I_S.mul_mem_left _ ih₁)
    let M_jac : Matrix (Fin N₀ ⊕ Fin L) (Fin N₀ ⊕ Fin L) (MvPolynomial (Fin M₀ ⊕ Fin L) R) :=
      Matrix.of fun a b => MvPolynomial.pderiv ((Sum.map P₀.map id) a) (G b)
    let Δ : MvPolynomial (Fin M₀ ⊕ Fin L) R := M_jac.det
    have hπ_Ψ_IS : ∀ u ∈ I_S, π_A (Ψ u) = 0 := by
      intro u hu; rw [← RingHom.mem_ker, hKer_π]; exact hΨ_IS_le u hu
    have hΔ_bar_unit : IsUnit (π_A (Ψ Δ)) := by
      let φ_bar : MvPolynomial (Fin M₀ ⊕ Fin L) R →+* A_bar := π_A.comp Ψ.toRingHom
      have hφ_bar_IS : ∀ u ∈ I_S, φ_bar u = 0 := hπ_Ψ_IS
      have h_det_map : π_A (Ψ Δ) = (M_jac.map φ_bar).det := by
        change φ_bar M_jac.det = (φ_bar.mapMatrix M_jac).det
        exact RingHom.map_det φ_bar M_jac
      let B₁₁ : Matrix (Fin N₀) (Fin N₀) A_bar :=
        P₀.jacobiMatrix.map (MvPolynomial.aeval P₀.val).toRingHom
      let B₂₁ : Matrix (Fin L) (Fin N₀) A_bar :=
        Matrix.of fun k j => φ_bar (M_jac (Sum.inr k) (Sum.inl j))
      have h_blocks : M_jac.map φ_bar = Matrix.fromBlocks B₁₁ 0 B₂₁ 1 := by
        refine Matrix.ext fun a b => ?_
        rcases a with i | k <;> rcases b with j | k'
        · simp only [Matrix.map_apply, Matrix.fromBlocks_apply₁₁, B₁₁, M_jac, Matrix.of_apply,
            Sum.map_inl, G, Sum.elim_inl, G_inl, map_sub]
          rw [hφ_bar_IS _ (hpderiv_IS _ _ (hu_rel_IS j)), sub_zero,
            MvPolynomial.pderiv_rename Sum.inl_injective]
          change π_A (Ψ (MvPolynomial.rename Sum.inl
            (MvPolynomial.pderiv (P₀.map i) (g_tilde j)))) =
            MvPolynomial.aeval P₀.val (P₀.jacobiMatrix i j)
          rw [hΨ_inl, hπ_aeval_x, P₀.jacobiMatrix_apply, ← hg_tilde j]
          congr 1; ext d
          simp [MvPolynomial.coeff_pderiv, MvPolynomial.coeff_map]
        · simp only [Matrix.map_apply, Matrix.fromBlocks_apply₁₂, Matrix.zero_apply,
            M_jac, Matrix.of_apply, Sum.map_inl, G, Sum.elim_inr, G_inr, map_sub,
            MvPolynomial.pderiv_X]
          rw [Pi.single_eq_of_ne (by simp), map_zero, zero_sub,
            hφ_bar_IS _ (hpderiv_IS _ _ (hv_rel_IS k')), neg_zero]
        · rfl
        · simp only [Matrix.map_apply, Matrix.fromBlocks_apply₂₂, Matrix.one_apply,
            M_jac, Matrix.of_apply, Sum.map_inr, id_eq, G, Sum.elim_inr, G_inr, map_sub,
            MvPolynomial.pderiv_X]
          rw [hφ_bar_IS _ (hpderiv_IS _ _ (hv_rel_IS k')), sub_zero]
          by_cases hkk : k' = k
          · subst hkk; simp
          · rw [Pi.single_eq_of_ne (fun h => hkk (Sum.inr.inj h)),
              ite_eq_right_iff.mpr fun h => False.elim (hkk h.symm), map_zero]
      rw [h_det_map, h_blocks, Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, mul_one]
      have hP₀_jac : P₀.jacobian = B₁₁.det := by
        rw [P₀.jacobian_eq_jacobiMatrix_det]
        exact RingHom.map_det (MvPolynomial.aeval P₀.val).toRingHom P₀.jacobiMatrix
      rw [← hP₀_jac]; exact P₀.jacobian_isUnit
    have hΨΔ_not_q : Ψ Δ ∉ q.asIdeal := by
      intro hmem
      obtain ⟨u_bar, hu_bar⟩ := hΔ_bar_unit.exists_right_inv
      obtain ⟨w, rfl⟩ := hSurj_π u_bar
      have hdiff_Im : Ψ Δ * w - 1 ∈ Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R) := by
        rw [← hKer_π, RingHom.mem_ker, map_sub, map_mul, map_one, hu_bar, sub_self]
      have h1_q : (1 : A) ∈ q.asIdeal := by
        have : (1 : A) = Ψ Δ * w - (Ψ Δ * w - 1) := by ring
        rw [this]; exact q.asIdeal.sub_mem (q.asIdeal.mul_mem_right w hmem) (hMaxLe hdiff_Im)
      exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1_q isUnit_one)
    let s_tot : MvPolynomial (Fin M₀ ⊕ Fin L) R := r₀ * Δ
    let h : A := Ψ s_tot
    have hh_eq : h = Ψ r₀ * Ψ Δ := map_mul Ψ r₀ Δ
    have hh_not_q : h ∉ q.asIdeal := by
      rw [hh_eq]; exact fun hm => (q.isPrime.mem_or_mem hm).elim hΨr₀_not_q hΨΔ_not_q
    let A_h : Type u := Localization.Away h
    let w_tot : (Fin M₀ ⊕ Fin L) ⊕ Unit → A_h :=
      Sum.elim (fun idx => algebraMap A A_h (Sum.elim x z idx))
        (fun _ => IsLocalization.Away.invSelf (S := A_h) h)
    let Ψ_tot : MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R →ₐ[R] A_h :=
      MvPolynomial.aeval w_tot
    have hΨ_tot_inl : ∀ F : MvPolynomial (Fin M₀ ⊕ Fin L) R,
        Ψ_tot (MvPolynomial.rename Sum.inl F) = algebraMap A A_h (Ψ F) := by
      intro F
      refine MvPolynomial.induction_on
        (motive := fun p => Ψ_tot (MvPolynomial.rename Sum.inl p) = algebraMap A A_h (Ψ p)) F ?_ ?_ ?_
      · intro r; dsimp [Ψ_tot, Ψ]
        rw [MvPolynomial.rename_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C,
          IsScalarTower.algebraMap_apply R A A_h r]
      · intro p₁ p₂ ih₁ ih₂; rw [map_add, map_add, ih₁, ih₂, map_add, map_add]
      · intro p₁ idx ih
        rw [map_mul, map_mul, ih, map_mul, map_mul, MvPolynomial.rename_X]
        dsimp [Ψ_tot, w_tot, Ψ]; simp
    have hSurj_Ψtot : Function.Surjective Ψ_tot := by
      intro y_h
      obtain ⟨⟨a, ⟨_, k_pow, rfl⟩⟩, hy_h⟩ := IsLocalization.surj (Submonoid.powers h) y_h
      dsimp only at hy_h
      obtain ⟨F_a, rfl⟩ := hSurj_Ψ a
      refine ⟨MvPolynomial.rename Sum.inl F_a * MvPolynomial.X (Sum.inr ()) ^ k_pow, ?_⟩
      rw [map_mul, map_pow, hΨ_tot_inl]
      have hX_inv : Ψ_tot (MvPolynomial.X (Sum.inr ())) =
          IsLocalization.Away.invSelf (S := A_h) h := by dsimp [Ψ_tot, w_tot]; simp
      rw [hX_inv]
      have hmul_cancel : algebraMap A A_h h * IsLocalization.Away.invSelf (S := A_h) h = 1 :=
        IsLocalization.Away.mul_invSelf h
      have hpow_cancel : algebraMap A A_h (h ^ k_pow) *
          (IsLocalization.Away.invSelf (S := A_h) h) ^ k_pow = 1 := by
        rw [map_pow, ← mul_pow, hmul_cancel, one_pow]
      have hgk_unit : IsUnit (algebraMap A A_h (h ^ k_pow)) :=
        IsLocalization.map_units A_h (⟨h ^ k_pow, k_pow, rfl⟩ : Submonoid.powers h)
      apply hgk_unit.mul_left_inj.mp
      calc
        (algebraMap A A_h (Ψ F_a) * IsLocalization.Away.invSelf (S := A_h) h ^ k_pow) *
            algebraMap A A_h (h ^ k_pow) =
            algebraMap A A_h (Ψ F_a) *
              (algebraMap A A_h (h ^ k_pow) * IsLocalization.Away.invSelf (S := A_h) h ^ k_pow) := by ring
        _ = algebraMap A A_h (Ψ F_a) := by rw [hpow_cancel, mul_one]
        _ = y_h * algebraMap A A_h (h ^ k_pow) := hy_h.symm
    let gen_Ah : Algebra.Generators R A_h ((Fin M₀ ⊕ Fin L) ⊕ Unit) :=
      Algebra.Generators.ofSurjective w_tot hSurj_Ψtot
    let G_tot : (Fin N₀ ⊕ Fin L) ⊕ Unit → MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R :=
      Sum.elim (fun b => MvPolynomial.rename Sum.inl (G b))
        (fun _ => MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl s_tot - 1)
    let J_tot : Ideal (MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R) :=
      Ideal.span (Set.range G_tot)
    have hJtot_eq_ker : J_tot = gen_Ah.ker := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨ab, rfl⟩
        rcases ab with b | ⟨⟩
        · change Ψ_tot (MvPolynomial.rename Sum.inl (G b)) = 0
          rw [hΨ_tot_inl, show Ψ (G b) = 0 from hJ₀_le_K (Ideal.subset_span ⟨b, rfl⟩), map_zero]
        · change Ψ_tot (MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl s_tot - 1) = 0
          rw [map_sub, map_mul, map_one, hΨ_tot_inl]
          have hX_inv : Ψ_tot (MvPolynomial.X (Sum.inr ())) =
              IsLocalization.Away.invSelf (S := A_h) h := by dsimp [Ψ_tot, w_tot]; simp
          rw [hX_inv, mul_comm, IsLocalization.Away.mul_invSelf h, sub_self]
      · intro H hH
        let ev_poly : MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R →ₐ[R]
            Polynomial (MvPolynomial (Fin M₀ ⊕ Fin L) R) :=
          MvPolynomial.aeval (Sum.elim (fun idx => Polynomial.C (MvPolynomial.X idx))
            (fun _ => Polynomial.X))
        let un_poly : Polynomial (MvPolynomial (Fin M₀ ⊕ Fin L) R) →+*
            MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R :=
          Polynomial.eval₂RingHom (MvPolynomial.rename Sum.inl).toRingHom
            (MvPolynomial.X (Sum.inr ()))
        have hun_ev : ∀ Q : MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R,
            un_poly (ev_poly Q) = Q := by
          intro Q
          refine MvPolynomial.induction_on (motive := fun p => un_poly (ev_poly p) = p) Q ?_ ?_ ?_
          · intro r; dsimp [ev_poly, un_poly]; rw [MvPolynomial.aeval_C]
            change Polynomial.eval₂ (MvPolynomial.rename Sum.inl).toRingHom
              (MvPolynomial.X (Sum.inr ())) (Polynomial.C (MvPolynomial.C r)) = _
            rw [Polynomial.eval₂_C]; simp
          · intro p₁ p₂ ih₁ ih₂; rw [map_add, map_add, ih₁, ih₂]
          · intro p₁ idx ih
            rw [map_mul, map_mul, ih]
            rcases idx with idx | ⟨⟩ <;> simp [ev_poly, un_poly]
        let P_H := ev_poly H
        let d := P_H.natDegree
        let S_inl := MvPolynomial.rename (R := R) (τ := (Fin M₀ ⊕ Fin L) ⊕ Unit) Sum.inl
        let U_var : MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R := MvPolynomial.X (Sum.inr ())
        have hUS_mem : U_var * S_inl s_tot - 1 ∈ J_tot :=
          Ideal.subset_span ⟨Sum.inr (), rfl⟩
        have hUS_pow : ∀ k : ℕ, S_inl (s_tot ^ k) * U_var ^ k - 1 ∈ J_tot := by
          intro k
          induction k with
          | zero => simp
          | succ k ih =>
            have h_id : S_inl (s_tot ^ (k + 1)) * U_var ^ (k + 1) - 1 =
                (S_inl (s_tot ^ k) * U_var ^ k) * (U_var * S_inl s_tot - 1) +
                (S_inl (s_tot ^ k) * U_var ^ k - 1) := by
              rw [pow_succ, pow_succ, map_mul]; ring
            rw [h_id]; exact J_tot.add_mem (J_tot.mul_mem_left _ hUS_mem) ih
        let F_H : MvPolynomial (Fin M₀ ⊕ Fin L) R :=
          ∑ e ∈ Finset.range (d + 1), P_H.coeff e * s_tot ^ (d - e)
        have hClear_U : S_inl (s_tot ^ d) * H - S_inl F_H ∈ J_tot := by
          have hH_sum : H = ∑ e ∈ Finset.range (d + 1), S_inl (P_H.coeff e) * U_var ^ e := by
            have hP_sum : P_H = ∑ e ∈ Finset.range (d + 1),
                Polynomial.C (P_H.coeff e) * Polynomial.X ^ e :=
              Polynomial.as_sum_range_C_mul_X_pow P_H
            calc
              H = un_poly P_H := (hun_ev H).symm
              _ = un_poly (∑ e ∈ Finset.range (d + 1),
                    Polynomial.C (P_H.coeff e) * Polynomial.X ^ e) := congrArg un_poly hP_sum
              _ = ∑ e ∈ Finset.range (d + 1), S_inl (P_H.coeff e) * U_var ^ e := by
                    rw [map_sum]
                    refine Finset.sum_congr rfl fun e _ => ?_
                    rw [map_mul, map_pow]; dsimp [un_poly, S_inl, U_var]; simp
          rw [hH_sum, Finset.mul_sum]; dsimp only [F_H]
          rw [map_sum, ← Finset.sum_sub_distrib]
          refine Ideal.sum_mem J_tot fun e he => ?_
          have he_le : e ≤ d := Nat.lt_succ_iff.mp (Finset.mem_range.mp he)
          have h_pow_split : s_tot ^ d = s_tot ^ (d - e) * s_tot ^ e := by
            rw [← pow_add, Nat.sub_add_cancel he_le]
          have h_term : S_inl (s_tot ^ d) * (S_inl (P_H.coeff e) * U_var ^ e) -
              S_inl (P_H.coeff e * s_tot ^ (d - e)) =
              S_inl (P_H.coeff e * s_tot ^ (d - e)) * (S_inl (s_tot ^ e) * U_var ^ e - 1) := by
            rw [h_pow_split, map_mul, map_mul]; ring
          rw [h_term]; exact J_tot.mul_mem_left _ (hUS_pow e)
        have hΨ_FH_Ah : algebraMap A A_h (Ψ F_H) = 0 := by
          have h1 : Ψ_tot (S_inl (s_tot ^ d) * H - S_inl F_H) = 0 := by
            have hJ_ker : J_tot ≤ RingHom.ker Ψ_tot.toRingHom := by
              rw [Ideal.span_le]
              rintro _ ⟨ab, rfl⟩
              rcases ab with b | ⟨⟩
              · change Ψ_tot (MvPolynomial.rename Sum.inl (G b)) = 0
                rw [hΨ_tot_inl, show Ψ (G b) = 0 from hJ₀_le_K (Ideal.subset_span ⟨b, rfl⟩), map_zero]
              · change Ψ_tot (MvPolynomial.X (Sum.inr ()) * MvPolynomial.rename Sum.inl s_tot - 1) = 0
                rw [map_sub, map_mul, map_one, hΨ_tot_inl]
                have hX_inv : Ψ_tot (MvPolynomial.X (Sum.inr ())) =
                    IsLocalization.Away.invSelf (S := A_h) h := by dsimp [Ψ_tot, w_tot]; simp
                rw [hX_inv, mul_comm, IsLocalization.Away.mul_invSelf h, sub_self]
            exact hJ_ker hClear_U
          have hH0 : Ψ_tot H = 0 := hH
          rw [map_sub, map_mul, hH0, mul_zero, zero_sub, neg_eq_zero, hΨ_tot_inl] at h1
          exact h1
        obtain ⟨⟨_, m_pow, rfl⟩, hm_eq⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers h) A_h (Ψ F_H)).mp hΨ_FH_Ah
        dsimp only at hm_eq
        have hsm_K : s_tot ^ m_pow * F_H ∈ K := by
          change Ψ (s_tot ^ m_pow * F_H) = 0; rw [map_mul, map_pow]; exact hm_eq
        have hr0_J0 : r₀ * (s_tot ^ m_pow * F_H) ∈ J₀ :=
          hr₀_smul (Submodule.smul_mem_pointwise_smul _ r₀ K hsm_K)
        have hs_mp1_J0 : s_tot ^ (m_pow + 1) * F_H ∈ J₀ := by
          have h_eq : s_tot ^ (m_pow + 1) * F_H = Δ * (r₀ * (s_tot ^ m_pow * F_H)) := by
            dsimp [s_tot]; rw [pow_succ]; ring
          rw [h_eq]; exact J₀.mul_mem_left Δ hr0_J0
        have hJ0_to_Jtot : ∀ w ∈ J₀, S_inl w ∈ J_tot := by
          intro w hw
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
          · rintro _ ⟨b, rfl⟩; exact Ideal.subset_span ⟨Sum.inl b, rfl⟩
          · simp
          · intro w₁ w₂ _ _ ih₁ ih₂; rw [map_add]; exact J_tot.add_mem ih₁ ih₂
          · intro P_s w₁ _ ih₁; rw [smul_eq_mul, map_mul]; exact J_tot.mul_mem_left _ ih₁
        let N_exp := m_pow + 1 + d
        have hSN_H : S_inl (s_tot ^ N_exp) * H ∈ J_tot := by
          have h_eq : S_inl (s_tot ^ N_exp) * H =
              S_inl (s_tot ^ (m_pow + 1)) * (S_inl (s_tot ^ d) * H - S_inl F_H) +
              S_inl (s_tot ^ (m_pow + 1) * F_H) := by
            dsimp [N_exp]; rw [pow_add, map_mul, map_mul]; ring
          rw [h_eq]
          exact J_tot.add_mem (J_tot.mul_mem_left _ hClear_U) (hJ0_to_Jtot _ hs_mp1_J0)
        have hH_final : H = U_var ^ N_exp * (S_inl (s_tot ^ N_exp) * H) -
            (S_inl (s_tot ^ N_exp) * U_var ^ N_exp - 1) * H := by ring
        rw [hH_final]
        exact J_tot.sub_mem (J_tot.mul_mem_left _ hSN_H)
          (J_tot.mul_mem_right H (hUS_pow N_exp))
    let pres_Ah : Algebra.Presentation R A_h
        ((Fin M₀ ⊕ Fin L) ⊕ Unit) ((Fin N₀ ⊕ Fin L) ⊕ Unit) :=
      { toGenerators := gen_Ah, relation := G_tot, span_range_relation_eq_ker := hJtot_eq_ker }
    let map_tot : (Fin N₀ ⊕ Fin L) ⊕ Unit → (Fin M₀ ⊕ Fin L) ⊕ Unit :=
      Sum.map (Sum.map P₀.map id) id
    have hMap_inj : Function.Injective map_tot :=
      Function.Injective.sumMap
        (Function.Injective.sumMap P₀.map_inj Function.injective_id)
        Function.injective_id
    let pre_Ah : Algebra.PreSubmersivePresentation R A_h
        ((Fin M₀ ⊕ Fin L) ⊕ Unit) ((Fin N₀ ⊕ Fin L) ⊕ Unit) :=
      { toPresentation := pres_Ah, map := map_tot, map_inj := hMap_inj }
    let S_inl := MvPolynomial.rename (R := R) (τ := (Fin M₀ ⊕ Fin L) ⊕ Unit) Sum.inl
    have hpderiv_inr_inl : ∀ F : MvPolynomial (Fin M₀ ⊕ Fin L) R,
        MvPolynomial.pderiv (Sum.inr ()) (S_inl F) = 0 := by
      intro F
      refine MvPolynomial.induction_on
        (motive := fun p => MvPolynomial.pderiv (Sum.inr ()) (S_inl p) = 0) F ?_ ?_ ?_
      · intro r; dsimp [S_inl]; rw [MvPolynomial.rename_C, MvPolynomial.pderiv_C]
      · intro p₁ p₂ ih₁ ih₂; rw [map_add, map_add, ih₁, ih₂, add_zero]
      · intro p₁ idx ih
        rw [map_mul, MvPolynomial.pderiv_mul, ih, zero_mul, zero_add]
        dsimp [S_inl]; rw [MvPolynomial.rename_X, MvPolynomial.pderiv_X]; simp
    have hJac_unit : IsUnit pre_Ah.jacobian := by
      let C₁₂ : Matrix (Fin N₀ ⊕ Fin L) Unit (MvPolynomial ((Fin M₀ ⊕ Fin L) ⊕ Unit) R) :=
        Matrix.of fun a u => pre_Ah.jacobiMatrix (Sum.inl a) (Sum.inr u)
