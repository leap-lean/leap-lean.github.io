          apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro s_el
            have hms := RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hmr) s_el
            change m.hom (MvPolynomial.C s_el) =
              (MvPolynomial.eval₂Hom c.inr.hom (fun b => c.inl.hom (MvPolynomial.X b)))
