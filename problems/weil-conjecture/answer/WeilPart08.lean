    have hd₁ : IsUnit d₁ := by
      have hEq := hResComp hEV1.le (X.basicOpen_le (Φ₁ P_tilde)) (inf_le_right : U₁_E ≤ V₁)
        (Φ₁ P_tilde)
      dsimp only [d₁]
      rw [← hEq]
      exact (X.toRingedSpace.isUnit_res_basicOpen (Φ₁ P_tilde)).map
        (X.presheaf.map (CategoryTheory.homOfLE hEV1.le).op).hom
    let n₀ : ↑(X.presheaf.obj (Opposite.op U₀_E)) :=
