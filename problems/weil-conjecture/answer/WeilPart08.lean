        ⟨⟨res_V (f b), ∑ μ : Fin (M + 1), res_V (B_V μ) * res_E (η b μ),
          hInvEq, mul_comm _ (res_V (f b)) ▸ hInvEq⟩, rfl⟩
      have hBO : X.basicOpen (res_V (f b)) = E b ⊓ V := X.basicOpen_of_isUnit hUnit
      rw [X.basicOpen_res (f b) (CategoryTheory.homOfLE (inf_le_right : E b ⊓ V ≤ V)).op] at hBO
      have hx' : x ∈ (E b ⊓ V) ⊓ X.basicOpen (f b) := hBO.symm ▸ hx
      exact hx'.2
    · intro x hx
      have hxV : x ∈ V := X.basicOpen_le (f b) hx
      have hxTop : x ∈ (⊤ : X.Opens) := trivial
      rw [← hCovE, TopologicalSpace.Opens.mem_iSup] at hxTop
      rcases hxTop with ⟨β, hxβ⟩
      have hEβ : Nonempty ↥(E β) := ⟨⟨x, hxβ⟩⟩
      let res_E := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : E β ⊓ V ≤ E β)).op).hom
      let res_V := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : E β ⊓ V ≤ V)).op).hom
      have hxRes : x ∈ X.basicOpen (res_V (f b)) := by
        rw [X.basicOpen_res (f b) (CategoryTheory.homOfLE (inf_le_right : E β ⊓ V ≤ V)).op]
        exact ⟨⟨hxβ, hxV⟩, hx⟩
      rw [← hCoc β b hEβ, X.basicOpen_mul] at hxRes
      have hxη : x ∈ X.basicOpen (η β b) := by
        have hx' := hxRes.1
        rw [X.basicOpen_res (η β b) (CategoryTheory.homOfLE (inf_le_left : E β ⊓ V ≤ E β)).op] at hx'
        exact hx'.2
      rw [hBasicη β b] at hxη
      exact ⟨hxη.2, hxV⟩
  have hCut0 : ∀ b : Fin (M + 1), E b ⊓ V₀ = X.basicOpen (Φ₀ (P b)) := by
    apply hCutUniv V₀ (fun μ => Φ₀ (P μ))
    · refine ⟨fun μ => Φ₀ (A μ), ?_⟩
      calc
        ∑ μ : Fin (M + 1), Φ₀ (A μ) * Φ₀ (P μ)
          = Φ₀ (∑ μ : Fin (M + 1), A μ * P μ) := by simp only [map_sum, map_mul]
        _ = 1 := by rw [hBezoutA, map_one]
    · intro β μ hEβ
      have hW0 : Nonempty ↥(E β ⊓ V₀) := hInter (E β) V₀ hEβ hNe0
      apply hJ1 (E β ⊓ V₀) hW0
      rw [map_mul,
        hJ2 (E β) (E β ⊓ V₀) hEβ hW0 inf_le_left,
        hJ2 V₀ (E β ⊓ V₀) hNe0 hW0 inf_le_right,
        hJ2 V₀ (E β ⊓ V₀) hNe0 hW0 inf_le_right,
        hJ3 (P β), hJ3 (P μ), hRatioAll β hEβ μ]
  have hd_E : 1 ≤ d_E := by
    by_contra hd_not
    have hd0 : d_E = 0 := by omega
    let c₀ : Fin (M + 1) → K := fun μ => (P μ).coeff 0
    have hP_const : ∀ μ : Fin (M + 1), P μ = Polynomial.C (c₀ μ) :=
      fun μ => Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero (hd0 ▸ hDegLE μ))
    have hc₀_ne : c₀ a₀ ≠ 0 := fun hc => hPa₀ (by rw [hP_const a₀, hc, map_zero])
    have hUnit0 : IsUnit (Φ₀ (P a₀)) := by
      rw [hP_const a₀]
      exact (IsUnit.mk0 (c₀ a₀) hc₀_ne).map (Φ₀.toRingHom.comp Polynomial.C)
    have hV0_le : V₀ ≤ E a₀ := by
      intro x hx
      have hEq := hCut0 a₀
      rw [X.basicOpen_of_isUnit hUnit0] at hEq
      have hx' : x ∈ E a₀ ⊓ V₀ := hEq.symm ▸ hx
      exact hx'.1
    let κ₀ : K →+* ↑(X.presheaf.obj (Opposite.op (E a₀))) :=
      ((ψ.app (U_M a₀)).hom).comp (c_K a₀)
    have hη_const : ∀ μ : Fin (M + 1), η a₀ μ = κ₀ (c₀ μ * (c₀ a₀)⁻¹) := by
      intro μ
      apply hJ1 (E a₀) hNe
      have hCa₀_ne : ι (Polynomial.C (c₀ a₀)) ≠ 0 := by
        intro h0
        apply hc₀_ne
        have hC0 : Polynomial.C (c₀ a₀) = (0 : Polynomial K) :=
