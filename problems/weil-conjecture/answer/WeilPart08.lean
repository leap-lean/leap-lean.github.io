      haveI : IsLocalHom (algebraMap A_p B_q) :=
        Localization.isLocalHom_localRingHom p_z.asIdeal q'₀.asIdeal e_AB rfl
      haveI : Algebra.EssFiniteType A_p B_q := Algebra.EssFiniteType.of_comp A_Z A_p B_q
      haveI : Algebra.FormallyUnramified A_p B_q :=
        Algebra.FormallyUnramified.of_restrictScalars A_Z A_p B_q
