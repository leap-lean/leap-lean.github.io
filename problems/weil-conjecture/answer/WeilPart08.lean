          algebraMap A A_h (Ψ Δ) * algebraMap A A_h h := by
        rw [pre_Ah.jacobian_eq_jacobiMatrix_det]
        change Ψ_tot pre_Ah.jacobiMatrix.det = _
        rw [hDet_eq, map_mul, hΨ_tot_inl, hΨ_tot_inl]
      rw [hJac_eq]
      have hh_unit : IsUnit (algebraMap A A_h h) := IsLocalization.Away.algebraMap_isUnit h
      have hΔ_unit : IsUnit (algebraMap A A_h (Ψ Δ)) := by
        have hmul : algebraMap A A_h (Ψ r₀) * algebraMap A A_h (Ψ Δ) = algebraMap A A_h h := by
          rw [← map_mul, ← hh_eq]
        exact isUnit_of_mul_isUnit_right (hmul ▸ hh_unit)
      exact hΔ_unit.mul hh_unit
    let sub_Ah : Algebra.SubmersivePresentation R A_h
        ((Fin M₀ ⊕ Fin L) ⊕ Unit) ((Fin N₀ ⊕ Fin L) ⊕ Unit) :=
      { toPreSubmersivePresentation := pre_Ah, jacobian_isUnit := hJac_unit }
    have hdim_Ah : sub_Ah.dimension = 1 := by
      change Nat.card ((Fin M₀ ⊕ Fin L) ⊕ Unit) - Nat.card ((Fin N₀ ⊕ Fin L) ⊕ Unit) = 1
      simp only [Nat.card_sum, Nat.card_fin, Nat.card_unique]; omega
    exact ⟨h, hh_not_q, sub_Ah.isStandardSmoothOfRelativeDimension hdim_Ah⟩
  
  have h_part5 :
      ∀ (hEtDomR : ∀ (B : Type u) [CommRing B] [Algebra R B] [Algebra.Etale R B]
