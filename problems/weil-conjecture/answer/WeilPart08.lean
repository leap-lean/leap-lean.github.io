        obtain ⟨q', hq'O, hq'1⟩ := mem_closure_iff.mp hq₀_cl _ hPre_open hq₀_pre
        rw [Set.mem_singleton_iff] at hq'1
        subst hq'1
        exact ⟨y₁, hq'O, rfl⟩
      have hy₁_ne : y₁ ≠ y := by
        intro hy_eq
        have h_inj_eq : hUY.fromSpec.base (PrimeSpectrum.comap e_AB q₁) =
