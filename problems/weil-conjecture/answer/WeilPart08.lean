        rw [CategoryTheory.Category.assoc, h]
      exact congrArg (fun f => f.hom c) hcomp
    have hResV₀ : (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U ⊓ V₀ ≤ V₀)).op).hom
        ((γ ≫ p.appLE ⊤ V₀ le_top).hom c) =
        (γ ≫ p.appLE ⊤ (U ⊓ V₀) le_top).hom c := by
      have h := p.appLE_map (U := ⊤) (V := V₀) (V' := U ⊓ V₀) le_top
        (CategoryTheory.homOfLE (inf_le_right : U ⊓ V₀ ≤ V₀)).op
      have hcomp : (γ ≫ p.appLE ⊤ V₀ le_top) ≫
          X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U ⊓ V₀ ≤ V₀)).op =
          γ ≫ p.appLE ⊤ (U ⊓ V₀) le_top := by
        rw [CategoryTheory.Category.assoc, h]
      exact congrArg (fun f => f.hom c) hcomp
    have hC0_c : (γ ≫ p.appLE ⊤ V₀ le_top).hom c = Φ₀ (Polynomial.C c) := by
      simpa using (congrArg (fun f => f.hom c) hC0).symm
    calc
