              have hc0 : j_mat 1 0 * (Δ_inv * j_mat 1 1) - j_mat 1 1 * (Δ_inv * j_mat 1 0) = 0 := by
                ring
              have hc1 : -(j_mat 1 0 * (Δ_inv * j_mat 0 1)) + j_mat 1 1 * (Δ_inv * j_mat 0 0) = 1 := by
                linear_combination hΔ_mul
              have hmod :
                  j_mat 1 0 • ((Δ_inv * j_mat 1 1) • e_U 0 - (Δ_inv * j_mat 0 1) • e_U 1) +
                    j_mat 1 1 • (-(Δ_inv * j_mat 1 0) • e_U 0 + (Δ_inv * j_mat 0 0) • e_U 1) =
                  (j_mat 1 0 * (Δ_inv * j_mat 1 1) - j_mat 1 1 * (Δ_inv * j_mat 1 0)) • e_U 0 +
                    (-(j_mat 1 0 * (Δ_inv * j_mat 0 1)) + j_mat 1 1 * (Δ_inv * j_mat 0 0)) • e_U 1 := by
                module
              rw [hmod, hc0, hc1, zero_smul, one_smul, zero_add]
          intro v
