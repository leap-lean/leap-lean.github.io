          AlgebraicGeometry.Spec (CommRingCat.of
            (HomogeneousLocalization.Away 𝒜_R (MvPolynomial.X a))) :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_R (MvPolynomial.X a)
          (hX_mem R N a) zero_lt_one
      have hisoV_ι : isoV.inv ≫ V_lift.ι =
          AlgebraicGeometry.Proj.awayι 𝒜_S (f_gr (MvPolynomial.X a)) hdeg_fXa zero_lt_one := by
        dsimp [isoV]
        rw [Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_inv_ι,
          AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
      have hisoDR_ι : isoDR.inv ≫ (D_R a).ι =
          AlgebraicGeometry.Proj.awayι 𝒜_R (MvPolynomial.X a) (hX_mem R N a) zero_lt_one :=
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_R (MvPolynomial.X a)
