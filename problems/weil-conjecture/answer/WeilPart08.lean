        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S ↥(𝒜_S 0))) = _
      rw [AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hAwayMap_zero : ∀ (a : Fin (N + 1)) (r : R),
        HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)
          (HomogeneousLocalization.fromZeroRingHom 𝒜_R (Submonoid.powers (MvPolynomial.X a))
            (algebraMap R ↥(𝒜_R 0) r)) =
        HomogeneousLocalization.fromZeroRingHom 𝒜_S
          (Submonoid.powers (f_gr (MvPolynomial.X a)))
          (algebraMap S ↥(𝒜_S 0) (φ_RS r)) := by
      intro a r
      apply HomogeneousLocalization.val_injective (Submonoid.powers (f_gr (MvPolynomial.X a)))
      change (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)
          (HomogeneousLocalization.mk ⟨0, algebraMap R ↥(𝒜_R 0) r, 1,
