        simpa using congrArg (fun Q => Q.coeff 0) hC0
      apply mul_right_cancel₀ hCa₀_ne
      calc
        j_open (E a₀) hNe (η a₀ μ) * ι (Polynomial.C (c₀ a₀))
          = z μ * ι (P a₀) := by rw [← hP_const a₀]
        _ = ι (P μ) := hRatio μ
        _ = ι (Polynomial.C (c₀ μ)) := by rw [hP_const μ]
        _ = ι (Polynomial.C (c₀ μ * (c₀ a₀)⁻¹ * c₀ a₀)) := by
              rw [inv_mul_cancel_right₀ hc₀_ne]
        _ = ι (Polynomial.C (c₀ μ * (c₀ a₀)⁻¹)) * ι (Polynomial.C (c₀ a₀)) := by
              rw [Polynomial.C.map_mul, map_mul]
        _ = j_open (E a₀) hNe (κ₀ (c₀ μ * (c₀ a₀)⁻¹)) * ι (Polynomial.C (c₀ a₀)) := by
