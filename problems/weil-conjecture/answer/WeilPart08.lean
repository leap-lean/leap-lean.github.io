      have h0 : π_i (a i) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [h0, map_zero]
    let α_quot : (B' ⧸ I'_i) →+* Localization.Away (π_i h) :=
      Ideal.Quotient.lift I'_i f_loc_i hf_loc_ker
    let mk'_i : B' →+* (B' ⧸ I'_i) := Ideal.Quotient.mk I'_i
    have hg_ker : Ideal.span ({a i} : Set B₀) ≤ RingHom.ker (mk'_i.comp ψ) := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    let g_qi : Q_i →+* (B' ⧸ I'_i) := Ideal.Quotient.lift _ (mk'_i.comp ψ) hg_ker
    have h_unit_g : IsUnit (g_qi (π_i h)) :=
      (IsLocalization.Away.algebraMap_isUnit (S := B') h).map mk'_i
    let β_quot : Localization.Away (π_i h) →+* (B' ⧸ I'_i) :=
      IsLocalization.Away.lift (π_i h) h_unit_g
    have h_βα : β_quot.comp α_quot = RingHom.id _ := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext (Submonoid.powers h)
      ext x
      change β_quot (f_loc_i (algebraMap B₀ B' x)) = mk'_i (ψ x)
      dsimp only [f_loc_i, β_quot]
      rw [IsLocalization.Away.lift_eq]
      change (IsLocalization.Away.lift (π_i h) h_unit_g)
        (algebraMap Q_i (Localization.Away (π_i h)) (π_i x)) = mk'_i (ψ x)
      rw [IsLocalization.Away.lift_eq]
      rfl
    have h_αβ : α_quot.comp β_quot = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (π_i h))
      apply Ideal.Quotient.ringHom_ext
      ext x
      change α_quot (β_quot (algebraMap Q_i (Localization.Away (π_i h)) (π_i x))) = ι_Qi (π_i x)
      dsimp only [β_quot]
      rw [IsLocalization.Away.lift_eq]
      change f_loc_i (algebraMap B₀ B' x) = ι_Qi (π_i x)
      exact IsLocalization.Away.lift_eq h h_unit_f x
    let e_quot_loc : (B' ⧸ I'_i) ≃+* Localization.Away (π_i h) :=
      { α_quot with
        invFun := β_quot
        left_inv := fun z => RingHom.congr_fun h_βα z
        right_inv := fun z => RingHom.congr_fun h_αβ z }
    
    let S_i : Type u := Localization.Away (π_i h_br)
    haveI : IsDomain S_i := hDom_Si
    let z_i : S_i := algebraMap Q_i S_i (π_i r_br)
    let T_i : Type u := Localization.Away z_i
    have hLoc_mul : IsLocalization.Away (π_i h_br * π_i r_br) T_i :=
      IsLocalization.Away.mul' S_i T_i (π_i h_br) (π_i r_br)
    have h_mul_eq : π_i h_br * π_i r_br = π_i h := by
      rw [← map_mul, ← hh_eq]
    haveI hLoc_Ti : IsLocalization.Away (π_i h) T_i := h_mul_eq ▸ hLoc_mul
    let e_Ti : T_i ≃+* Localization.Away (π_i h) :=
      (IsLocalization.algEquiv (Submonoid.powers (π_i h)) T_i (Localization.Away (π_i h))).toRingEquiv
    
    have h_ker_pi : RingHom.ker π_i ≤ q₀.asIdeal := by
      rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]
      exact hX₀ i
    have hqbar_i_pr : (Ideal.map π_i q₀.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective h_ker_pi
    have hqbar_i_cm : Ideal.comap π_i (Ideal.map π_i q₀.asIdeal) = q₀.asIdeal := by
      rw [Ideal.comap_map_of_surjective' π_i Ideal.Quotient.mk_surjective]
      exact sup_eq_left.mpr h_ker_pi
    have h_pih_not : π_i h ∉ Ideal.map π_i q₀.asIdeal := by
      intro h_in
      apply hh_not
      rw [← hqbar_i_cm, Ideal.mem_comap]
      exact h_in
    have h_zero_not_pow : (0 : Q_i) ∉ Submonoid.powers (π_i h) := by
      rintro ⟨n, hn⟩
      dsimp only at hn
      have h_pow_mem : (π_i h) ^ n ∈ Ideal.map π_i q₀.asIdeal := by
        rw [hn]; exact (Ideal.map π_i q₀.asIdeal).zero_mem
      exact h_pih_not (hqbar_i_pr.mem_of_pow_mem n h_pow_mem)
    have h_not_sub : ¬ Subsingleton (Localization.Away (π_i h)) := by
      rw [IsLocalization.subsingleton_iff (M := Submonoid.powers (π_i h))
        (S := Localization.Away (π_i h))]
      exact h_zero_not_pow
    haveI : Nontrivial (Localization.Away (π_i h)) := not_subsingleton_iff_nontrivial.mp h_not_sub
    haveI : Nontrivial T_i := e_Ti.toEquiv.nontrivial
    have hz_ne : z_i ≠ 0 := by
      intro hz0
      have h_sub_Ti : Subsingleton T_i := by
        rw [IsLocalization.subsingleton_iff (M := Submonoid.powers z_i) (S := T_i)]
        exact ⟨1, by dsimp only; rw [pow_one, hz0]⟩
      exact false_of_nontrivial_of_subsingleton T_i
    have h_pow_nzd : Submonoid.powers z_i ≤ nonZeroDivisors S_i := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hz_ne)
    haveI : IsDomain T_i := IsLocalization.isDomain_of_le_nonZeroDivisors T_i h_pow_nzd
    exact (e_quot_loc.trans e_Ti.symm).toMulEquiv.isDomain_iff.mpr inferInstance

theorem weil_proper_etale_nodal_curve_finiteness_and_affine_charts (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (hEtDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
      ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (hRingPkg :
      let A_nod : Type u :=
        MvPolynomial (Fin 2) k₀ ⧸
          Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
      (∀ (D : Type u) [CommRing D] [IsDomain D] (φ_T : Polynomial k₀ →+* D),
        φ_T.Etale →
        (∃ p₁ p₂ : PrimeSpectrum D, p₁ ≠ p₂) ∧
        (∀ Z : Set (PrimeSpectrum D), IsClosed Z → Z ≠ Set.univ → Z.Finite)) ∧
      (∀ (C_r : Type u) [CommRing C_r] (φ_N : A_nod →+* C_r) (q_r : PrimeSpectrum C_r)
         (ψ_sm : Polynomial k₀ →+* C_r),
        φ_N.Etale →
        ψ_sm.Etale →
        (∀ i : Fin 2, φ_N (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_r.asIdeal) →
        ψ_sm.comp Polynomial.C = φ_N.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) →
        False) ∧
      (∀ (B₀ : Type u) [CommRing B₀] (φ₂_0 : A_nod →+* B₀) (q₀ : PrimeSpectrum B₀),
        φ₂_0.Etale →
        (∀ i : Fin 2, φ₂_0 (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀.asIdeal) →
        ∃ h : B₀,
          h ∉ q₀.asIdeal ∧
          let B' : Type u := Localization.Away h
          let ψ : B₀ →+* B' := algebraMap B₀ B'
          let φ₂ : A_nod →+* B' := ψ.comp φ₂_0
          ∃ u₀ : PrimeSpectrum B',
            PrimeSpectrum.comap ψ u₀ = q₀ ∧
            (∃ ev₀ : B' →+* k₀,
              ev₀.comp (φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = RingHom.id k₀ ∧
              RingHom.ker ev₀ = u₀.asIdeal) ∧
            PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} : Set B') ∪
              PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))} : Set B') =
              Set.univ ∧
            PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} : Set B') ∩
              PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))} : Set B') =
              {u₀} ∧
            (∀ u' : PrimeSpectrum B', u' ≠ u₀ →
              ∃ (f_sm : B') (ψ_sm : Polynomial k₀ →+* Localization.Away f_sm),
                f_sm ∉ u'.asIdeal ∧
                ψ_sm.Etale ∧
                ψ_sm.comp Polynomial.C =
                  (algebraMap B' (Localization.Away f_sm)).comp
                    (φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) ∧
            (∀ i : Fin 2,
              IsDomain (B' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))}) ∧
              ∃ θ_i : Polynomial k₀ →+*
                  (B' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))}),
                θ_i.Etale)))
    (Z₀ : AlgebraicGeometry.Scheme.{u})
    (p_Z₀ : Z₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k₀))
    [AlgebraicGeometry.IsProper p_Z₀]
    (hNodZ₀ : ∀ z : ↥Z₀, HasSpreadSmoothOrNodalAt p_Z₀ z) :
    let Sing_Z₀ : Set ↥Z₀ :=
      {z : ↥Z₀ | ¬ ∃ V_sm : Z₀.Opens,
        z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Z₀)}
    let S_inter : Set ↥Z₀ :=
      {z : ↥Z₀ | ∃ Z₁ ∈ irreducibleComponents ↥Z₀, ∃ Z₂ ∈ irreducibleComponents ↥Z₀,
        Z₁ ≠ Z₂ ∧ z ∈ Z₁ ∧ z ∈ Z₂}
    (irreducibleComponents ↥Z₀).Finite ∧
    Sing_Z₀.Finite ∧
    S_inter ⊆ Sing_Z₀ ∧
    S_inter.Finite ∧
    (∀ z ∈ Sing_Z₀, IsClosed ({z} : Set ↥Z₀)) ∧
    (∀ z : ↥Z₀,
      ∀ Z₁ ∈ irreducibleComponents ↥Z₀,
      ∀ Z₂ ∈ irreducibleComponents ↥Z₀,
      ∀ Z₃ ∈ irreducibleComponents ↥Z₀,
        z ∈ Z₁ → z ∈ Z₂ → z ∈ Z₃ → Z₁ = Z₂ ∨ Z₁ = Z₃ ∨ Z₂ = Z₃) ∧
    (∀ Z_comp ∈ irreducibleComponents ↥Z₀, ∃ p_Z ∈ Z_comp, p_Z ∉ Sing_Z₀) ∧
    (∀ K_cut : Set ↥Z₀,
      IsClosed K_cut →
      (∀ z ∈ K_cut, z ∉ Sing_Z₀) →
      (∀ Z_comp ∈ irreducibleComponents ↥Z₀, ¬ Z_comp ⊆ K_cut) →
      K_cut.Finite) ∧
    (∀ (U : Z₀.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
       (q : PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op U))),
      hAff.fromSpec.base q ∉ Sing_Z₀ →
      ∃ (g : ↑(Z₀.presheaf.obj (Opposite.op U)))
        (ψ : Polynomial k₀ →+* Localization.Away g),
        g ∉ q.asIdeal ∧
        IsDomain (Localization.Away g) ∧
        ψ.Etale ∧
        ψ.comp Polynomial.C =
          (algebraMap _ (Localization.Away g)).comp
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              p_Z₀.appLE ⊤ U le_top).hom)) ∧
    (∀ (U : Z₀.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
       (q : PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op U))),
      hAff.fromSpec.base q ∈ Sing_Z₀ →
      ∃ (B₀ : Type u) (_ : CommRing B₀) (q₀ : PrimeSpectrum B₀)
        (φ₁_0 : ↑(Z₀.presheaf.obj (Opposite.op U)) →+* B₀)
        (φ₂_0 : (MvPolynomial (Fin 2) k₀ ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B₀),
        φ₁_0.Etale ∧
        φ₂_0.Etale ∧
        PrimeSpectrum.comap φ₁_0 q₀ = q ∧
        φ₁_0.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            p_Z₀.appLE ⊤ U le_top).hom) =
          φ₂_0.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
        (∀ i : Fin 2, φ₂_0 (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀.asIdeal)) :=
by
  classical
  intro Sing_Z₀ S_inter
  let A_nod : Type u :=
    MvPolynomial (Fin 2) k₀ ⧸
      Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
  let c_nod : k₀ →+* A_nod := (Ideal.Quotient.mk _).comp MvPolynomial.C
  obtain ⟨hSmRing, hIncompat, hNodRefine⟩ := hRingPkg

  
  have hFromSpecComp : ∀ {X : AlgebraicGeometry.Scheme.{u}} {R : Type u} [CommRing R]
      (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      {V : X.Opens} (hV : AlgebraicGeometry.IsAffineOpen V),
      hV.fromSpec ≫ g =
        AlgebraicGeometry.Spec.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            g.appLE ⊤ V le_top) := by
    intro X R _ g V hV
    rw [← AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec g
      (AlgebraicGeometry.isAffineOpen_top _) hV le_top]
    rw [AlgebraicGeometry.IsAffineOpen.fromSpec_top,
      AlgebraicGeometry.Scheme.isoSpec_Spec, AlgebraicGeometry.Spec.map_comp]
    rfl

  have hSpecFieldBot : ∀ p : PrimeSpectrum k₀, p.asIdeal = ⊥ := by
    intro p
    apply le_antisymm _ bot_le
    intro x hx
    rw [Ideal.mem_bot]
    by_contra hx0
    exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (IsUnit.mk0 x hx0))

  have hSpecSub : Subsingleton (PrimeSpectrum k₀) :=
    ⟨fun p₁ p₂ => PrimeSpectrum.ext ((hSpecFieldBot p₁).trans (hSpecFieldBot p₂).symm)⟩

  have hSpecSchemeSub : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)) := hSpecSub

  
  have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k₀)) :=
    AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
  have : AlgebraicGeometry.IsLocallyNoetherian Z₀ :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_Z₀
  have : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)) :=
    PrimeSpectrum.compactSpace
  have hCompZ₀ : CompactSpace ↥Z₀ :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_Z₀
  have : AlgebraicGeometry.IsNoetherian Z₀ := {}
  have hFinComp : (irreducibleComponents ↥Z₀).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
  have hOpenSmAll : IsOpen {z : ↥Z₀ | ∃ V_sm : Z₀.Opens,
      z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Z₀)} := by
    rw [isOpen_iff_forall_mem_open]
    rintro z ⟨V_sm, hz, hSm⟩
    exact ⟨(V_sm : Set ↥Z₀), fun w hw => ⟨V_sm, hw, hSm⟩, V_sm.isOpen, hz⟩
  have hClSing : IsClosed Sing_Z₀ := hOpenSmAll.isClosed_compl

  
  have hSmExt : ∀ (U : Z₀.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      (q : PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op U))),
      hAff.fromSpec.base q ∉ Sing_Z₀ →
      ∃ (g : ↑(Z₀.presheaf.obj (Opposite.op U)))
        (ψ : Polynomial k₀ →+* Localization.Away g),
        g ∉ q.asIdeal ∧
        IsDomain (Localization.Away g) ∧
        ψ.Etale ∧
        ψ.comp Polynomial.C =
          (algebraMap _ (Localization.Away g)).comp
            (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
              p_Z₀.appLE ⊤ U le_top).hom) := by
    intro U hAff q hNotSing
    obtain ⟨V_sm, hz_Vsm, hSm⟩ := Classical.not_not.mp hNotSing
    let A : Type u := ↑(Z₀.presheaf.obj (Opposite.op U))
    let α_U : k₀ →+* A :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Z₀.appLE ⊤ U le_top).hom
    let z : ↥Z₀ := hAff.fromSpec.base q
    obtain ⟨U_base, _hAff_Ubase, V_ch, hAff_Vch, hz_Vch, e_ch, hStdSm⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (V_sm.ι ≫ p_Z₀)).mp hSm ⟨z, hz_Vsm⟩
    have hUbase_top : U_base = ⊤ := by
      ext pt
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hs0 : (V_sm.ι ≫ p_Z₀).base ⟨z, hz_Vsm⟩ ∈ U_base := e_ch hz_Vch
      rwa [hSpecSchemeSub.elim pt ((V_sm.ι ≫ p_Z₀).base ⟨z, hz_Vsm⟩)]
    subst hUbase_top
    obtain ⟨g_mv, hg_mv_C, hg_mv_et⟩ :=
      RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hStdSm
    let W_sm : Z₀.Opens := (AlgebraicGeometry.Scheme.Hom.opensFunctor V_sm.ι).obj V_ch
    have hAff_W : AlgebraicGeometry.IsAffineOpen W_sm :=
      hAff_Vch.image_of_isOpenImmersion V_sm.ι
    have hAppEq : (V_sm.ι ≫ p_Z₀).appLE ⊤ V_ch e_ch = p_Z₀.appLE ⊤ W_sm le_top := by
      have e_ch' : V_ch ≤ (TopologicalSpace.Opens.map V_sm.ι.base).obj
          ((TopologicalSpace.Opens.map p_Z₀.base).obj ⊤) := e_ch
      refine (AlgebraicGeometry.Scheme.Hom.comp_appLE V_sm.ι p_Z₀ ⊤ V_ch e_ch).trans ?_
      change p_Z₀.app ⊤ ≫ V_sm.ι.appLE ((TopologicalSpace.Opens.map p_Z₀.base).obj ⊤) V_ch e_ch' =
        p_Z₀.app ⊤ ≫ Z₀.presheaf.map (CategoryTheory.homOfLE _).op
      rw [AlgebraicGeometry.Scheme.Opens.ι_appLE V_sm _ V_ch e_ch']
      rfl
    let e_Γ : k₀ ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.obj (Opposite.op ⊤)) :=
      CategoryTheory.Iso.commRingCatIsoToRingEquiv
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).symm
    let e_mv : MvPolynomial (Fin 1) k₀ ≃+*
        MvPolynomial (Fin 1) ↑((AlgebraicGeometry.Spec (CommRingCat.of k₀)).presheaf.obj (Opposite.op ⊤)) :=
      MvPolynomial.mapEquiv (Fin 1) e_Γ
    let e_poly : Polynomial k₀ ≃ₐ[k₀] MvPolynomial (Fin 1) k₀ :=
      (MvPolynomial.uniqueAlgEquiv k₀ (Fin 1)).symm
    let ψ_W : Polynomial k₀ →+* ↑(Z₀.presheaf.obj (Opposite.op W_sm)) :=
      (g_mv.comp e_mv.toRingHom).comp e_poly.toRingHom
    have hEt_emv : e_mv.toRingHom.Etale := RingHom.Etale.of_bijective e_mv.bijective
    have hEt_epoly : e_poly.toRingHom.Etale := RingHom.Etale.of_bijective e_poly.bijective
    have hEt_ψW : ψ_W.Etale :=
      RingHom.Etale.stableUnderComposition _ _ hEt_epoly
        (RingHom.Etale.stableUnderComposition _ _ hEt_emv hg_mv_et)
    have hComm_ψW : ψ_W.comp Polynomial.C =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Z₀.appLE ⊤ W_sm le_top).hom := by
      ext c
      have h1 : e_poly (Polynomial.C c) = MvPolynomial.C c := e_poly.commutes c
      have h2 : e_mv (MvPolynomial.C c) =
          MvPolynomial.C ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom c) :=
        MvPolynomial.map_C _ c
      have h3 := RingHom.congr_fun hg_mv_C
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom c)
      change g_mv (e_mv (e_poly (Polynomial.C c))) = _
      rw [h1, h2]
      dsimp at h3
      rw [h3, hAppEq]
      rfl
    have hz_U : z ∈ U := hAff.range_fromSpec.subset ⟨q, rfl⟩
    have hz_W : z ∈ W_sm := ⟨⟨z, hz_Vsm⟩, hz_Vch, rfl⟩
    obtain ⟨f₀, g₀, h_bo, hz_bo⟩ :=
      AlgebraicGeometry.exists_basicOpen_le_affine_inter hAff hAff_W z ⟨hz_U, hz_W⟩
    have hf₀_not : f₀ ∉ q.asIdeal := by
      have hz_img : hAff.fromSpec.base q ∈
          ((AlgebraicGeometry.Scheme.Hom.opensFunctor hAff.fromSpec).obj
            (PrimeSpectrum.basicOpen f₀) : Z₀.Opens) := by
        rwa [hAff.fromSpec_image_basicOpen f₀]
      rcases hz_img with ⟨q', hq'_bo, hq'_eq⟩
      have hqq' : q' = q := hAff.fromSpec.isOpenEmbedding.injective hq'_eq
      subst hqq'
      exact hq'_bo
    have : IsLocalization.Away g₀ ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen g₀))) :=
      hAff_W.isLocalization_basicOpen g₀
    have : IsLocalization.Away f₀ ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen f₀))) :=
      hAff.isLocalization_basicOpen f₀
    have hEt_locg : (algebraMap ↑(Z₀.presheaf.obj (Opposite.op W_sm))
        ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen g₀)))).Etale := by
      have : Algebra.Etale ↑(Z₀.presheaf.obj (Opposite.op W_sm))
          ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen g₀))) :=
        Algebra.Etale.of_isLocalizationAway g₀
      exact RingHom.etale_algebraMap.mpr inferInstance
    let i_bo := CategoryTheory.Iso.commRingCatIsoToRingEquiv
      (Z₀.presheaf.mapIso (CategoryTheory.eqToIso (congrArg Opposite.op h_bo.symm)))
    have hEt_ibo : i_bo.toRingHom.Etale := RingHom.Etale.of_bijective i_bo.bijective
    let e_locf : ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen f₀))) ≃ₐ[A] Localization.Away f₀ :=
      IsLocalization.algEquiv (Submonoid.powers f₀)
        ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen f₀))) (Localization.Away f₀)
    have hEt_elocf : e_locf.toRingHom.Etale := RingHom.Etale.of_bijective e_locf.bijective
    let B₁ : Type u := Localization.Away f₀
    let ψ₀ : Polynomial k₀ →+* B₁ :=
      e_locf.toRingHom.comp (i_bo.toRingHom.comp
        ((algebraMap ↑(Z₀.presheaf.obj (Opposite.op W_sm))
          ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen g₀)))).comp ψ_W))
    have hEt_ψ₀ : ψ₀.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _
          (RingHom.Etale.stableUnderComposition _ _ hEt_ψW hEt_locg) hEt_ibo)
        hEt_elocf
    have hResEq : i_bo.toRingHom.comp
        (algebraMap ↑(Z₀.presheaf.obj (Opposite.op W_sm))
          ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen g₀)))) =
        (Z₀.presheaf.map (CategoryTheory.homOfLE
          (h_bo.le.trans (Z₀.basicOpen_le g₀))).op).hom := by
      change (Z₀.presheaf.map (CategoryTheory.homOfLE (Z₀.basicOpen_le g₀)).op ≫
          Z₀.presheaf.map (CategoryTheory.eqToHom (congrArg Opposite.op h_bo.symm))).hom = _
      rw [← Z₀.presheaf.map_comp]
      congr 2
    have hComm_ψ₀ : ψ₀.comp Polynomial.C = (algebraMap A B₁).comp α_U := by
      have hAssoc : ψ₀.comp Polynomial.C =
          e_locf.toRingHom.comp ((i_bo.toRingHom.comp
            (algebraMap ↑(Z₀.presheaf.obj (Opposite.op W_sm))
              ↑(Z₀.presheaf.obj (Opposite.op (Z₀.basicOpen g₀))))).comp
            (ψ_W.comp Polynomial.C)) := rfl
      rw [hAssoc, hResEq, hComm_ψW]
      have hAppMap₁ :
          (p_Z₀.appLE ⊤ W_sm le_top ≫
            Z₀.presheaf.map (CategoryTheory.homOfLE (h_bo.le.trans (Z₀.basicOpen_le g₀))).op) =
          p_Z₀.appLE ⊤ (Z₀.basicOpen f₀) le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map p_Z₀ le_top _
      have hAppMap₂ :
          (p_Z₀.appLE ⊤ U le_top ≫
            Z₀.presheaf.map (CategoryTheory.homOfLE (Z₀.basicOpen_le f₀)).op) =
          p_Z₀.appLE ⊤ (Z₀.basicOpen f₀) le_top :=
        AlgebraicGeometry.Scheme.Hom.appLE_map p_Z₀ le_top _
      ext c
      dsimp [α_U]
      have hc1 := ConcreteCategory.congr_hom hAppMap₁
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom c)
      have hc2 := ConcreteCategory.congr_hom hAppMap₂
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv.hom c)
      change e_locf (((p_Z₀.appLE ⊤ W_sm le_top ≫ Z₀.presheaf.map _).hom) _) = _
      rw [hc1, ← hc2]
      exact e_locf.commutes (α_U c)
    have hq_bo : q ∈ (PrimeSpectrum.basicOpen f₀ : Set (PrimeSpectrum A)) := hf₀_not
    rw [← PrimeSpectrum.localization_away_comap_range B₁ f₀] at hq_bo
    rcases hq_bo with ⟨q₁, hq₁_eq⟩
    letI : Algebra (Polynomial k₀) B₁ := ψ₀.toAlgebra
    have : Algebra.Etale (Polynomial k₀) B₁ := RingHom.etale_algebraMap.mp hEt_ψ₀
    obtain ⟨g_loc, hg_loc_not, hDom_gloc⟩ := hEtDom (Polynomial k₀) B₁ q₁
    obtain ⟨⟨a, s⟩, has_eq⟩ := IsLocalization.surj (Submonoid.powers f₀) g_loc
    dsimp at has_eq
    have hs_unit : IsUnit (algebraMap A B₁ s.1) := IsLocalization.map_units B₁ s
    have ha_not_q1 : algebraMap A B₁ a ∉ q₁.asIdeal := by
      intro ha_in
      rw [← has_eq] at ha_in
      rcases q₁.isPrime.mem_or_mem ha_in with hg_in | hs_in
      · exact hg_loc_not hg_in
      · exact q₁.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hs_in hs_unit)
    have ha_not : a ∉ q.asIdeal := by
      rw [← hq₁_eq]
      exact ha_not_q1
    let g : A := f₀ * a
    have hg_not : g ∉ q.asIdeal := q.isPrime.mul_notMem hf₀_not ha_not
    have hUnit_g_in_Ag : IsUnit (algebraMap A (Localization.Away g) g) :=
      IsLocalization.Away.algebraMap_isUnit g
    have hMul_in_Ag : algebraMap A (Localization.Away g) f₀ *
        algebraMap A (Localization.Away g) a = algebraMap A (Localization.Away g) g := by
      rw [← map_mul]
    have hUnit_f0_Ag : IsUnit (algebraMap A (Localization.Away g) f₀) :=
      isUnit_of_mul_isUnit_left (hMul_in_Ag.symm ▸ hUnit_g_in_Ag)
    have hUnit_a_Ag : IsUnit (algebraMap A (Localization.Away g) a) :=
      isUnit_of_mul_isUnit_right (hMul_in_Ag.symm ▸ hUnit_g_in_Ag)
    let β : B₁ →+* Localization.Away g := IsLocalization.Away.lift f₀ hUnit_f0_Ag
    have hβ_eq : ∀ x : A, β (algebraMap A B₁ x) = algebraMap A (Localization.Away g) x :=
      IsLocalization.Away.lift_eq f₀ hUnit_f0_Ag
    have hUnit_gloc_Ag : IsUnit (β g_loc) := by
      have hmul_β : β g_loc * β (algebraMap A B₁ s.1) = algebraMap A (Localization.Away g) a := by
        rw [← map_mul, has_eq, hβ_eq]
      exact isUnit_of_mul_isUnit_left (hmul_β.symm ▸ hUnit_a_Ag)
    let φ_fwd : Localization.Away g_loc →+* Localization.Away g :=
      IsLocalization.Away.lift g_loc hUnit_gloc_Ag
    have hφ_fwd_eq : ∀ y : B₁, φ_fwd (algebraMap B₁ (Localization.Away g_loc) y) = β y :=
      IsLocalization.Away.lift_eq g_loc hUnit_gloc_Ag
    let ι_loc : A →+* Localization.Away g_loc :=
      (algebraMap B₁ (Localization.Away g_loc)).comp (algebraMap A B₁)
    have hUnit_g_gloc : IsUnit (ι_loc g) := by
      dsimp [ι_loc, g]
      rw [map_mul, map_mul, ← has_eq, map_mul]
      exact ((IsLocalization.Away.algebraMap_isUnit f₀).map _).mul
        ((IsLocalization.Away.algebraMap_isUnit g_loc).mul (hs_unit.map _))
    let φ_bwd : Localization.Away g →+* Localization.Away g_loc :=
      IsLocalization.Away.lift g hUnit_g_gloc
    have hφ_bwd_eq : ∀ x : A, φ_bwd (algebraMap A (Localization.Away g) x) = ι_loc x :=
      IsLocalization.Away.lift_eq g hUnit_g_gloc
    have h_fwd_bwd : φ_fwd.comp φ_bwd = RingHom.id (Localization.Away g) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g)
      ext x
      simp only [RingHom.comp_apply, RingHom.id_apply, hφ_bwd_eq]
      dsimp [ι_loc]
      rw [hφ_fwd_eq, hβ_eq]
    have h_bwd_fwd_B1 : (φ_bwd.comp φ_fwd).comp (algebraMap B₁ (Localization.Away g_loc)) =
        algebraMap B₁ (Localization.Away g_loc) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers f₀)
      ext x
      change φ_bwd (φ_fwd (algebraMap B₁ (Localization.Away g_loc) (algebraMap A B₁ x))) =
        algebraMap B₁ (Localization.Away g_loc) (algebraMap A B₁ x)
      rw [hφ_fwd_eq, hβ_eq, hφ_bwd_eq]
      rfl
    have h_bwd_fwd : φ_bwd.comp φ_fwd = RingHom.id (Localization.Away g_loc) := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g_loc)
      ext y
      exact RingHom.congr_fun h_bwd_fwd_B1 y
    have hBij_fwd : Function.Bijective φ_fwd :=
      ⟨fun x y h => by
        have := congrArg φ_bwd h
        rwa [← RingHom.comp_apply, ← RingHom.comp_apply, h_bwd_fwd,
          RingHom.id_apply, RingHom.id_apply] at this,
       fun w => ⟨φ_bwd w, RingHom.congr_fun h_fwd_bwd w⟩⟩
    have hInj_bwd : Function.Injective φ_bwd :=
      fun x y h => by
        have := congrArg φ_fwd h
        rwa [← RingHom.comp_apply, ← RingHom.comp_apply, h_fwd_bwd,
          RingHom.id_apply, RingHom.id_apply] at this
    have hDom_g : IsDomain (Localization.Away g) :=
      Function.Injective.isDomain φ_bwd hInj_bwd
    have hEt_locgloc : (algebraMap B₁ (Localization.Away g_loc)).Etale := by
      have : Algebra.Etale B₁ (Localization.Away g_loc) :=
        Algebra.Etale.of_isLocalizationAway g_loc
      exact RingHom.etale_algebraMap.mpr inferInstance
    have hEt_fwd : φ_fwd.Etale := RingHom.Etale.of_bijective hBij_fwd
    let ψ : Polynomial k₀ →+* Localization.Away g :=
      φ_fwd.comp ((algebraMap B₁ (Localization.Away g_loc)).comp ψ₀)
    have hEt_ψ : ψ.Etale :=
      RingHom.Etale.stableUnderComposition _ _
        (RingHom.Etale.stableUnderComposition _ _ hEt_ψ₀ hEt_locgloc)
        hEt_fwd
    have hComm_ψ : ψ.comp Polynomial.C = (algebraMap A (Localization.Away g)).comp α_U := by
      ext c
      dsimp [ψ]
      have hc := RingHom.congr_fun hComm_ψ₀ c
      dsimp at hc
      rw [hc, hφ_fwd_eq, hβ_eq]
    exact ⟨g, ψ, hg_not, hDom_g, hEt_ψ, hComm_ψ⟩

  
  have hNodRaw : ∀ (U : Z₀.Opens) (hAff : AlgebraicGeometry.IsAffineOpen U)
      (q : PrimeSpectrum ↑(Z₀.presheaf.obj (Opposite.op U))),
      hAff.fromSpec.base q ∈ Sing_Z₀ →
      ∃ (B₀ : Type u) (_ : CommRing B₀) (q₀ : PrimeSpectrum B₀)
        (φ₁_0 : ↑(Z₀.presheaf.obj (Opposite.op U)) →+* B₀)
        (φ₂_0 : A_nod →+* B₀),
        φ₁_0.Etale ∧
        φ₂_0.Etale ∧
        PrimeSpectrum.comap φ₁_0 q₀ = q ∧
        φ₁_0.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
            p_Z₀.appLE ⊤ U le_top).hom) =
          φ₂_0.comp c_nod ∧
        (∀ i : Fin 2, φ₂_0 (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀.asIdeal) := by
    intro U hAff q hz_sing
    rcases hNodZ₀ (hAff.fromSpec.base q) with hSmBranch | ⟨U', u₀', e₁, e₂, hEt₁, hEt₂, hu₀', hX_u₀', hComm_e⟩
    · exact False.elim (hz_sing hSmBranch)
    · have hu₀'_in : u₀' ∈ (TopologicalSpace.Opens.map e₁.base).obj U := by
        change e₁.base u₀' ∈ U
        rw [hu₀']
        exact hAff.range_fromSpec.subset ⟨q, rfl⟩
      obtain ⟨W', hAff_W', hu₀'_W', hW'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀'_in
      have hW'_le : W' ≤ (TopologicalSpace.Opens.map e₁.base).obj U := hW'_sub
      let B₀ : Type u := ↑(U'.presheaf.obj (Opposite.op W'))
      let q₀ : PrimeSpectrum B₀ := hAff_W'.primeIdealOf ⟨u₀', hu₀'_W'⟩
      have hq₀_base : hAff_W'.fromSpec.base q₀ = u₀' :=
        hAff_W'.fromSpec_primeIdealOf ⟨u₀', hu₀'_W'⟩
      let φ₁_0 : ↑(Z₀.presheaf.obj (Opposite.op U)) →+* B₀ :=
        (e₁.appLE U W' hW'_le).hom
      let φ₂_0 : A_nod →+* B₀ :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).inv ≫
          e₂.appLE ⊤ W' le_top).hom
      have hEt_φ₁0 : φ₁_0.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
          e₁ hEt₁ ⟨U, hAff⟩ ⟨W', hAff_W'⟩ hW'_le
      have hEt_e2app : (e₂.appLE ⊤ W' le_top).hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
          e₂ hEt₂ ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ ⟨W', hAff_W'⟩ le_top
      have hBij_Γnod : Function.Bijective
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).inv.hom :=
        (CategoryTheory.Iso.commRingCatIsoToRingEquiv
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).symm).bijective
      have hEt_φ₂0 : φ₂_0.Etale :=
        RingHom.Etale.stableUnderComposition _ _ (RingHom.Etale.of_bijective hBij_Γnod) hEt_e2app
      have hSpec1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec e₁ hAff hAff_W' hW'_le
      have hComap_q0 : PrimeSpectrum.comap φ₁_0 q₀ = q := by
        have hBase1 : hAff.fromSpec.base (PrimeSpectrum.comap φ₁_0 q₀) =
            e₁.base (hAff_W'.fromSpec.base q₀) :=
          congrArg (fun f => f.base q₀) hSpec1
        rw [hq₀_base, hu₀'] at hBase1
        exact hAff.fromSpec.isOpenEmbedding.injective hBase1
      have hSpec2 := hFromSpecComp e₂ hAff_W'
      have hX_q0 : ∀ i : Fin 2, φ₂_0 (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀.asIdeal := by
        intro i
        have hBase2 : e₂.base (hAff_W'.fromSpec.base q₀) = PrimeSpectrum.comap φ₂_0 q₀ :=
          congrArg (fun f => f.base q₀) hSpec2
        rw [hq₀_base] at hBase2
        have hIdeal2 : (e₂.base u₀').asIdeal = Ideal.comap φ₂_0 q₀.asIdeal :=
          congrArg PrimeSpectrum.asIdeal hBase2
        have hi := hX_u₀' i
        rwa [hIdeal2] at hi
      have hComm_φ : φ₁_0.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Z₀.appLE ⊤ U le_top).hom) = φ₂_0.comp c_nod := by
        let α_U := ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
          p_Z₀.appLE ⊤ U le_top).hom
        have hEqMor : (hAff_W'.fromSpec ≫ e₁) ≫ p_Z₀ =
            (hAff_W'.fromSpec ≫ e₂) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) := by
          rw [CategoryTheory.Category.assoc, hComm_e, CategoryTheory.Category.assoc]
        have hLHS : (hAff_W'.fromSpec ≫ e₁) ≫ p_Z₀ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁_0.comp α_U)) := by
          rw [← hSpec1, CategoryTheory.Category.assoc, hFromSpecComp p_Z₀ hAff,
            ← AlgebraicGeometry.Spec.map_comp]
          rfl
        have hRHS : (hAff_W'.fromSpec ≫ e₂) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₂_0.comp c_nod)) := by
          rw [hSpec2, ← AlgebraicGeometry.Spec.map_comp]
          rfl
        rw [hLHS, hRHS] at hEqMor
        exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_inj.mp hEqMor)
      exact ⟨B₀, inferInstance, q₀, φ₁_0, φ₂_0, hEt_φ₁0, hEt_φ₂0, hComap_q0, hComm_φ, hX_q0⟩

  
  have hLocalSingPkg : ∀ z ∈ Sing_Z₀,
      IsClosed ({z} : Set ↥Z₀) ∧
      ∃ (W_z B_z0 B_z1 : Set ↥Z₀),
        IsOpen W_z ∧
        z ∈ W_z ∧
        Sing_Z₀ ∩ W_z ⊆ {z} ∧
        IsIrreducible B_z0 ∧
        IsIrreducible B_z1 ∧
        W_z ⊆ B_z0 ∪ B_z1 ∧
        z ∈ B_z0 ∧
        ∃ z' ∈ B_z0, z' ≠ z := by
    intro z hz_sing
    have hz_top : z ∈ (⊤ : Z₀.Opens) := trivial
    obtain ⟨U_z, hAff_z, hz_Uz, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hz_top
    let A_z : Type u := ↑(Z₀.presheaf.obj (Opposite.op U_z))
    let α_Uz : k₀ →+* A_z :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
        p_Z₀.appLE ⊤ U_z le_top).hom
    let q_z : PrimeSpectrum A_z := hAff_z.primeIdealOf ⟨z, hz_Uz⟩
    have hqz_base : hAff_z.fromSpec.base q_z = z := hAff_z.fromSpec_primeIdealOf ⟨z, hz_Uz⟩
    obtain ⟨B₀, instB₀, q₀, φ₁_0, φ₂_0, hEt1_0, hEt2_0, hComap0, hComm0, hX0⟩ :=
      hNodRaw U_z hAff_z q_z (hqz_base.symm ▸ hz_sing)
    letI : CommRing B₀ := instB₀
    obtain ⟨h_loc, _hh_not, u₀, hComap_u0, ⟨ev₀, hev₀_id, hev₀_ker⟩,
        hUnion_zl, hInter_zl, hAwaySm, hBranch⟩ :=
      hNodRefine B₀ φ₂_0 q₀ hEt2_0 hX0
    let B' : Type u := Localization.Away h_loc
    let ψ_loc : B₀ →+* B' := algebraMap B₀ B'
    have hEt_ψloc : ψ_loc.Etale := by
      have : Algebra.Etale B₀ B' := Algebra.Etale.of_isLocalizationAway h_loc
      exact RingHom.etale_algebraMap.mpr inferInstance
    let φ₁ : A_z →+* B' := ψ_loc.comp φ₁_0
    let φ₂ : A_nod →+* B' := ψ_loc.comp φ₂_0
    have hEt_φ₁ : φ₁.Etale := RingHom.Etale.stableUnderComposition _ _ hEt1_0 hEt_ψloc
    have hComap_φ₁ : PrimeSpectrum.comap φ₁ u₀ = q_z := by
      change PrimeSpectrum.comap φ₁_0 (PrimeSpectrum.comap ψ_loc u₀) = q_z
      rw [hComap_u0, hComap0]
    have hComm_φ : φ₁.comp α_Uz = φ₂.comp c_nod :=
      RingHom.ext fun x => congrArg ψ_loc (RingHom.congr_fun hComm0 x)
    let e_z : AlgebraicGeometry.Spec (CommRingCat.of B') ⟶ Z₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ hAff_z.fromSpec
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_φ₁
    have : AlgebraicGeometry.IsOpenImmersion hAff_z.fromSpec := hAff_z.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.Etale e_z := inferInstance
    have : AlgebraicGeometry.UniversallyOpen e_z := AlgebraicGeometry.UniversallyOpen.of_flat e_z
    let W_z : Set ↥Z₀ := Set.range e_z.base
    have hOpen_Wz : IsOpen W_z := e_z.isOpenMap.isOpen_range
    have hez_u0 : e_z.base u₀ = z := by
      change hAff_z.fromSpec.base (PrimeSpectrum.comap φ₁ u₀) = z
      rw [hComap_φ₁, hqz_base]
    
    have hCl_z : IsClosed ({z} : Set ↥Z₀) := by
      let γ_z : A_z →+* k₀ := ev₀.comp φ₁
      let σ_z : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶ Z₀ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_z) ≫ hAff_z.fromSpec
      have hSec_z : σ_z ≫ p_Z₀ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀)) := by
        dsimp [σ_z]
        rw [CategoryTheory.Category.assoc, hFromSpecComp p_Z₀ hAff_z]
        have hγ_α : γ_z.comp α_Uz = RingHom.id k₀ := by
          change ev₀.comp (φ₁.comp α_Uz) = RingHom.id k₀
          rw [hComm_φ]
          exact hev₀_id
        have hMapComp :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_z) ≫
              AlgebraicGeometry.Spec.map
                ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                  p_Z₀.appLE ⊤ U_z le_top) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (γ_z.comp α_Uz)) := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          rfl
        rw [hMapComp, hγ_α]
        exact AlgebraicGeometry.Spec.map_id (CommRingCat.of k₀)
      have hProp_id : AlgebraicGeometry.IsProper
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k₀))) := inferInstance
      rw [← hSec_z, AlgebraicGeometry.IsProper.comp_iff] at hProp_id
      have : AlgebraicGeometry.IsProper σ_z := hProp_id
      have hClRange : IsClosed (Set.range σ_z.base) := σ_z.isClosedMap.isClosed_range
      have hRangeEq : Set.range σ_z.base = ({z} : Set ↥Z₀) := by
        let pt₀ : PrimeSpectrum k₀ := ⊥
        have hσ_pt0 : σ_z.base pt₀ = z := by
          change hAff_z.fromSpec.base (PrimeSpectrum.comap γ_z pt₀) = z
          have hComapγ : PrimeSpectrum.comap γ_z pt₀ = q_z := by
            apply PrimeSpectrum.ext
            change Ideal.comap (ev₀.comp φ₁) ⊥ = q_z.asIdeal
            rw [← Ideal.comap_comap]
            have hKerEq : Ideal.comap ev₀ ⊥ = u₀.asIdeal := hev₀_ker
            rw [hKerEq]
            exact congrArg PrimeSpectrum.asIdeal hComap_φ₁
          rw [hComapγ, hqz_base]
        ext y
        simp only [Set.mem_range, Set.mem_singleton_iff]
        constructor
        · rintro ⟨pt, rfl⟩
          rw [hSpecSchemeSub.elim pt pt₀, hσ_pt0]
        · rintro rfl
          exact ⟨pt₀, hσ_pt0⟩
      rwa [hRangeEq] at hClRange
    
    have hIsol : Sing_Z₀ ∩ W_z ⊆ {z} := by
      rintro y ⟨hy_sing, u', rfl⟩
      rw [Set.mem_singleton_iff]
      by_cases hu' : u' = u₀
      · rw [hu', hez_u0]
      · exfalso
        rcases hNodZ₀ (e_z.base u') with hSm_u' | ⟨U'', u''₀, e'₁, e'₂, hEt'₁, hEt'₂, hu''₀, hX'', hComm''⟩
        · exact hy_sing hSm_u'
        · obtain ⟨f_sm, ψ_sm₀, hf_not, hEt_ψ₀, hComm_ψ₀⟩ := hAwaySm u' hu'
          have hu'_bo : u' ∈ (PrimeSpectrum.basicOpen f_sm : Set (PrimeSpectrum B')) := hf_not
          rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away f_sm) f_sm] at hu'_bo
          rcases hu'_bo with ⟨u'_f, hu'_f_eq⟩
          let g₁ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f_sm)) ⟶ Z₀ :=
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap B' (Localization.Away f_sm))) ≫ e_z
          have hEt_locf : (algebraMap B' (Localization.Away f_sm)).Etale := by
            have : Algebra.Etale B' (Localization.Away f_sm) :=
              Algebra.Etale.of_isLocalizationAway f_sm
            exact RingHom.etale_algebraMap.mpr inferInstance
          have : AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap B' (Localization.Away f_sm)))) :=
            (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
              hEt_locf
          have : AlgebraicGeometry.Etale g₁ := inferInstance
          have : AlgebraicGeometry.Etale e'₁ := hEt'₁
          have : AlgebraicGeometry.Etale e'₂ := hEt'₂
          let u'_f_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f_sm))) := u'_f
          have hg₁_u : g₁.base u'_f_pt = e'₁.base u''₀ := by
            change e_z.base (PrimeSpectrum.comap (algebraMap B' (Localization.Away f_sm)) u'_f) =
              e'₁.base u''₀
            rw [hu'_f_eq, hu''₀]
          obtain ⟨w, hw₁, hw₂⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u'_f_pt u''₀ hg₁_u
          have hw_top : w ∈ (⊤ : (CategoryTheory.Limits.pullback g₁ e'₁).Opens) := trivial
          obtain ⟨W_P, hAff_WP, hw_WP, _⟩ :=
            AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hw_top
          let C_r : Type u := ↑((CategoryTheory.Limits.pullback g₁ e'₁).presheaf.obj
            (Opposite.op W_P))
          let q_r : PrimeSpectrum C_r := hAff_WP.primeIdealOf ⟨w, hw_WP⟩
          have hqr_base : hAff_WP.fromSpec.base q_r = w :=
            hAff_WP.fromSpec_primeIdealOf ⟨w, hw_WP⟩
          let π₁ := CategoryTheory.Limits.pullback.fst g₁ e'₁
          let π₂ := CategoryTheory.Limits.pullback.snd g₁ e'₁
          have hEt_π₁ : AlgebraicGeometry.Etale π₁ := inferInstance
          have hEt_π₂ : AlgebraicGeometry.Etale π₂ := inferInstance
          have hEt_π₂e₂ : AlgebraicGeometry.Etale (π₂ ≫ e'₂) := inferInstance
          let β₁ : Localization.Away f_sm →+* C_r :=
            ((AlgebraicGeometry.Scheme.ΓSpecIso
              (CommRingCat.of (Localization.Away f_sm))).inv ≫ π₁.appLE ⊤ W_P le_top).hom
          have hBij_Γf : Function.Bijective
              (AlgebraicGeometry.Scheme.ΓSpecIso
                (CommRingCat.of (Localization.Away f_sm))).inv.hom :=
            (CategoryTheory.Iso.commRingCatIsoToRingEquiv
              (AlgebraicGeometry.Scheme.ΓSpecIso
                (CommRingCat.of (Localization.Away f_sm))).symm).bijective
          have hEt_π₁app : (π₁.appLE ⊤ W_P le_top).hom.Etale :=
            AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
              π₁ hEt_π₁ ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ ⟨W_P, hAff_WP⟩ le_top
          have hEt_β₁ : β₁.Etale :=
            RingHom.Etale.stableUnderComposition _ _
              (RingHom.Etale.of_bijective hBij_Γf) hEt_π₁app
          let ψ_sm : Polynomial k₀ →+* C_r := β₁.comp ψ_sm₀
          have hEt_ψsm : ψ_sm.Etale :=
            RingHom.Etale.stableUnderComposition _ _ hEt_ψ₀ hEt_β₁
          let φ_N : A_nod →+* C_r :=
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).inv ≫
              (π₂ ≫ e'₂).appLE ⊤ W_P le_top).hom
          have hBij_Γnod : Function.Bijective
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).inv.hom :=
            (CategoryTheory.Iso.commRingCatIsoToRingEquiv
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A_nod)).symm).bijective
          have hEt_π₂e₂app : ((π₂ ≫ e'₂).appLE ⊤ W_P le_top).hom.Etale :=
            AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
              (π₂ ≫ e'₂) hEt_π₂e₂ ⟨⊤, AlgebraicGeometry.isAffineOpen_top _⟩ ⟨W_P, hAff_WP⟩ le_top
          have hEt_φN : φ_N.Etale :=
            RingHom.Etale.stableUnderComposition _ _
              (RingHom.Etale.of_bijective hBij_Γnod) hEt_π₂e₂app
          have hX_qr : ∀ i : Fin 2,
              φ_N (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_r.asIdeal := by
            intro i
            have hSpecN := hFromSpecComp (π₂ ≫ e'₂) hAff_WP
            have hBaseN : (π₂ ≫ e'₂).base (hAff_WP.fromSpec.base q_r) =
                PrimeSpectrum.comap φ_N q_r :=
              congrArg (fun f => f.base q_r) hSpecN
            have hCompBase : (π₂ ≫ e'₂).base w = e'₂.base u''₀ := by
              change e'₂.base (π₂.base w) = e'₂.base u''₀
              rw [hw₂]
            rw [hqr_base, hCompBase] at hBaseN
            have hIdealN : (e'₂.base u''₀).asIdeal = Ideal.comap φ_N q_r.asIdeal :=
              congrArg PrimeSpectrum.asIdeal hBaseN
            have hi := hX'' i
            rwa [hIdealN] at hi
          have hComm_Cr : ψ_sm.comp Polynomial.C = φ_N.comp c_nod := by
            have hg₁_p : g₁ ≫ p_Z₀ =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_sm₀.comp Polynomial.C)) := by
              dsimp [g₁, e_z]
              rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
                hFromSpecComp p_Z₀ hAff_z]
              have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫
                    AlgebraicGeometry.Spec.map
                      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                        p_Z₀.appLE ⊤ U_z le_top) =
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.comp α_Uz)) := by
                rw [← AlgebraicGeometry.Spec.map_comp]
                rfl
              rw [h1, hComm_φ, ← AlgebraicGeometry.Spec.map_comp]
              have h2 : CommRingCat.ofHom (φ₂.comp c_nod) ≫
                    CommRingCat.ofHom (algebraMap B' (Localization.Away f_sm)) =
                  CommRingCat.ofHom (ψ_sm₀.comp Polynomial.C) := by
                rw [← CommRingCat.ofHom_comp, hComm_ψ₀]
              rw [h2, CommRingCat.ofHom_comp]
            have hPbEq : (hAff_WP.fromSpec ≫ π₁) ≫ (g₁ ≫ p_Z₀) =
                (hAff_WP.fromSpec ≫ π₂) ≫ (e'₁ ≫ p_Z₀) := by
              simp only [CategoryTheory.Category.assoc]
              rw [← CategoryTheory.Category.assoc π₁ g₁ p_Z₀,
                CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
            have hLHS : (hAff_WP.fromSpec ≫ π₁) ≫ (g₁ ≫ p_Z₀) =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_sm.comp Polynomial.C)) := by
              rw [hFromSpecComp π₁ hAff_WP, hg₁_p, ← AlgebraicGeometry.Spec.map_comp]
              congr 1
            have hRHS : (hAff_WP.fromSpec ≫ π₂) ≫ (e'₁ ≫ p_Z₀) =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_N.comp c_nod)) := by
              rw [hComm'', ← CategoryTheory.Category.assoc,
                CategoryTheory.Category.assoc hAff_WP.fromSpec π₂ e'₂,
                hFromSpecComp (π₂ ≫ e'₂) hAff_WP, ← AlgebraicGeometry.Spec.map_comp]
              congr 1
            rw [hLHS, hRHS] at hPbEq
            exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_inj.mp hPbEq)
          exact hIncompat C_r φ_N q_r ψ_sm hEt_φN hEt_ψsm hX_qr hComm_Cr
    
    let b_val : Fin 2 → B' := fun i => φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))
    have hu₀_in_inter : u₀ ∈
        PrimeSpectrum.zeroLocus ({b_val 0} : Set B') ∩
          PrimeSpectrum.zeroLocus ({b_val 1} : Set B') := by
      rw [hInter_zl]
      exact Set.mem_singleton u₀
    have hIrred_zl : ∀ i : Fin 2,
        IsIrreducible (PrimeSpectrum.zeroLocus ({b_val i} : Set B')) := by
      intro i
      obtain ⟨hDom_i, _⟩ := hBranch i
      let P_i : Ideal B' := Ideal.span ({b_val i} : Set B')
      have hPi_prime : P_i.IsPrime := (Ideal.Quotient.isDomain_iff_prime P_i).mp hDom_i
      let u_gen_i : PrimeSpectrum B' := ⟨P_i, hPi_prime⟩
      have hEqCl : PrimeSpectrum.zeroLocus ({b_val i} : Set B') =
          closure ({u_gen_i} : Set (PrimeSpectrum B')) := by
        rw [← PrimeSpectrum.zeroLocus_span, PrimeSpectrum.closure_singleton]
      rw [hEqCl]
      exact isIrreducible_singleton.closure
    
    obtain ⟨hDom_0, θ_0, hEt_θ0⟩ := hBranch 0
    obtain ⟨⟨p₁, p₂, hp12⟩, _⟩ := hSmRing _ θ_0 hEt_θ0
    let P₀ : Ideal B' := Ideal.span ({b_val 0} : Set B')
    have hP₀_prime : P₀.IsPrime := (Ideal.Quotient.isDomain_iff_prime P₀).mp hDom_0
    let u_gen0 : PrimeSpectrum B' := ⟨P₀, hP₀_prime⟩
    have hb0_mem : b_val 0 ∈ u₀.asIdeal := hu₀_in_inter.1 (Set.mem_singleton _)
    have hP₀_le : P₀ ≤ u₀.asIdeal := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hb0_mem)
    have hSurj_ev₀ : Function.Surjective ev₀ :=
      fun c => ⟨(φ₂.comp c_nod) c, RingHom.congr_fun hev₀_id c⟩
    have hP₀_ne : P₀ ≠ u₀.asIdeal := by
      intro hEq
      let e_quot : (B' ⧸ P₀) ≃+* k₀ :=
        (Ideal.quotEquivOfEq (hEq.trans hev₀_ker.symm)).trans
          (RingHom.quotientKerEquivOfSurjective hSurj_ev₀)
      have hInj_comap : Function.Injective (PrimeSpectrum.comap e_quot.symm.toRingHom) :=
        PrimeSpectrum.comap_injective_of_surjective e_quot.symm.toRingHom e_quot.symm.surjective
      exact hp12 (hInj_comap (hSpecSub.elim _ _))
    have hComap_ne : PrimeSpectrum.comap φ₁ u_gen0 ≠ q_z := by
      rw [← hComap_φ₁]
      intro hComapEq
      let 𝔭 : Ideal A_z := Ideal.comap φ₁ u₀.asIdeal
      have : 𝔭.IsPrime := Ideal.comap_isPrime φ₁ u₀.asIdeal
      have h𝔭_eq : 𝔭 = Ideal.comap φ₁ P₀ := (congrArg PrimeSpectrum.asIdeal hComapEq).symm
      letI : Algebra A_z B' := φ₁.toAlgebra
      have : Algebra.Etale A_z B' := RingHom.etale_algebraMap.mp hEt_φ₁
      let R_loc : Type u := Localization.AtPrime 𝔭
      let S_loc : Type u := Localization.AtPrime u₀.asIdeal
      let f_loc : R_loc →+* S_loc := Localization.localRingHom 𝔭 u₀.asIdeal φ₁ rfl
      letI : Algebra R_loc S_loc := f_loc.toAlgebra
      have : IsScalarTower A_z R_loc S_loc :=
        IsScalarTower.mk fun a r s => by
          have hMap : algebraMap R_loc S_loc (algebraMap A_z R_loc a) = algebraMap A_z S_loc a := by
            rw [IsScalarTower.algebraMap_apply A_z B' S_loc a]
            exact Localization.localRingHom_to_map 𝔭 u₀.asIdeal φ₁ rfl a
          simp only [Algebra.smul_def, map_mul, hMap, mul_assoc]
      have : IsLocalHom (algebraMap R_loc S_loc) :=
        Localization.isLocalHom_localRingHom 𝔭 u₀.asIdeal φ₁ rfl
      have : Algebra.FormallyUnramified B' S_loc :=
        Algebra.FormallyUnramified.of_isLocalization u₀.asIdeal.primeCompl
      have : Algebra.FormallyUnramified A_z S_loc :=
        Algebra.FormallyUnramified.comp A_z B' S_loc
      have : Algebra.FormallyUnramified R_loc S_loc :=
        Algebra.FormallyUnramified.localization_base 𝔭.primeCompl
      have : Algebra.EssFiniteType A_z S_loc :=
        Algebra.EssFiniteType.comp A_z B' S_loc
      have : Algebra.EssFiniteType R_loc S_loc :=
        Algebra.EssFiniteType.of_comp A_z R_loc S_loc
      have hMaxMap :
          Ideal.map (algebraMap R_loc S_loc) (IsLocalRing.maximalIdeal R_loc) =
            IsLocalRing.maximalIdeal S_loc :=
        Algebra.FormallyUnramified.map_maximalIdeal
      have hMaxR : Ideal.map (algebraMap A_z R_loc) 𝔭 = IsLocalRing.maximalIdeal R_loc :=
        Localization.AtPrime.map_eq_maximalIdeal
      have hMaxS : Ideal.map (algebraMap B' S_loc) u₀.asIdeal = IsLocalRing.maximalIdeal S_loc :=
        Localization.AtPrime.map_eq_maximalIdeal
      have hCompMap :
          (algebraMap R_loc S_loc).comp (algebraMap A_z R_loc) =
            (algebraMap B' S_loc).comp φ₁ :=
        RingHom.ext fun x => Localization.localRingHom_to_map 𝔭 u₀.asIdeal φ₁ rfl x
      have hChain1 :
          Ideal.map (algebraMap B' S_loc) (Ideal.map φ₁ 𝔭) = IsLocalRing.maximalIdeal S_loc := by
        rw [Ideal.map_map, ← hCompMap, ← Ideal.map_map, hMaxR, hMaxMap]
      have hLe1 : Ideal.map φ₁ 𝔭 ≤ P₀ := by
        rw [h𝔭_eq]
        exact Ideal.map_comap_le
      have hSandwich1 : IsLocalRing.maximalIdeal S_loc ≤ Ideal.map (algebraMap B' S_loc) P₀ := by
        rw [← hChain1]
        exact Ideal.map_mono hLe1
      have hSandwich2 : Ideal.map (algebraMap B' S_loc) P₀ ≤ IsLocalRing.maximalIdeal S_loc := by
        rw [← hMaxS]
        exact Ideal.map_mono hP₀_le
      have hMapEq :
          Ideal.map (algebraMap B' S_loc) P₀ = Ideal.map (algebraMap B' S_loc) u₀.asIdeal :=
        (le_antisymm hSandwich2 hSandwich1).trans hMaxS.symm
      have hDisj_P₀ : Disjoint (u₀.asIdeal.primeCompl : Set B') (P₀ : Set B') :=
        Set.disjoint_left.mpr fun x hx_compl hx_P₀ => hx_compl (hP₀_le hx_P₀)
      have hDisj_u₀ : Disjoint (u₀.asIdeal.primeCompl : Set B') (u₀.asIdeal : Set B') :=
        Set.disjoint_left.mpr fun x hx_compl hx_u₀ => hx_compl hx_u₀
      have hUnder_P₀ : Ideal.under B' (Ideal.map (algebraMap B' S_loc) P₀) = P₀ :=
        IsLocalization.under_map_of_isPrime_disjoint u₀.asIdeal.primeCompl S_loc hP₀_prime hDisj_P₀
      have hUnder_u₀ : Ideal.under B' (Ideal.map (algebraMap B' S_loc) u₀.asIdeal) = u₀.asIdeal :=
        IsLocalization.under_map_of_isPrime_disjoint u₀.asIdeal.primeCompl S_loc u₀.isPrime hDisj_u₀
      exact hP₀_ne (hUnder_P₀.symm.trans ((congrArg (Ideal.under B') hMapEq).trans hUnder_u₀))
    let B_z0 : Set ↥Z₀ := e_z.base '' PrimeSpectrum.zeroLocus ({b_val 0} : Set B')
    let B_z1 : Set ↥Z₀ := e_z.base '' PrimeSpectrum.zeroLocus ({b_val 1} : Set B')
    have hIrred_Bz0 : IsIrreducible B_z0 := (hIrred_zl 0).image e_z.base e_z.continuous.continuousOn
    have hIrred_Bz1 : IsIrreducible B_z1 := (hIrred_zl 1).image e_z.base e_z.continuous.continuousOn
    have hWz_sub_union : W_z ⊆ B_z0 ∪ B_z1 := by
      rintro _ ⟨u, rfl⟩
      have hu_univ : u ∈ (Set.univ : Set (PrimeSpectrum B')) := trivial
      rw [← hUnion_zl] at hu_univ
      rcases hu_univ with hu0 | hu1
      · exact Or.inl ⟨u, hu0, rfl⟩
      · exact Or.inr ⟨u, hu1, rfl⟩
    have hz_in_Bz0 : z ∈ B_z0 := ⟨u₀, hu₀_in_inter.1, hez_u0⟩
    have hugen_in_zl0 : u_gen0 ∈ PrimeSpectrum.zeroLocus ({b_val 0} : Set B') :=
      Set.singleton_subset_iff.mpr (Ideal.subset_span (Set.mem_singleton _))
    have hz'_ne : e_z.base u_gen0 ≠ z := by
      intro hEq
      rw [← hqz_base] at hEq
      exact hComap_ne (hAff_z.fromSpec.isOpenEmbedding.injective hEq)
    exact ⟨hCl_z, W_z, B_z0, B_z1, hOpen_Wz, ⟨u₀, hez_u0⟩, hIsol,
      hIrred_Bz0, hIrred_Bz1, hWz_sub_union, hz_in_Bz0,
      ⟨e_z.base u_gen0, ⟨u_gen0, hugen_in_zl0, rfl⟩, hz'_ne⟩⟩

  
  have hSingCl : ∀ z ∈ Sing_Z₀, IsClosed ({z} : Set ↥Z₀) :=
    fun z hz => (hLocalSingPkg z hz).1

  have hFinSing : Sing_Z₀.Finite := by
    let W_of : ↥Sing_Z₀ → Set ↥Z₀ := fun z => (hLocalSingPkg z.1 z.2).2.choose
    have hW_spec : ∀ z : ↥Sing_Z₀,
        IsOpen (W_of z) ∧ z.1 ∈ W_of z ∧ Sing_Z₀ ∩ W_of z ⊆ {z.1} := by
      intro z
      obtain ⟨_B0, _B1, hOp, hzW, hSub, _⟩ := (hLocalSingPkg z.1 z.2).2.choose_spec
      exact ⟨hOp, hzW, hSub⟩
    obtain ⟨t, ht_cov⟩ := hClSing.isCompact.elim_finite_subcover W_of
      (fun z => (hW_spec z).1)
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, (hW_spec ⟨x, hx⟩).2.1⟩)
    have hSubFin : Sing_Z₀ ⊆ ⋃ z ∈ t, Sing_Z₀ ∩ W_of z := by
      intro x hx
      rcases Set.mem_iUnion₂.mp (ht_cov hx) with ⟨z, hzt, hxW⟩
      exact Set.mem_biUnion hzt ⟨hx, hxW⟩
    exact (t.finite_toSet.biUnion fun z _ =>
      (Set.finite_singleton z.1).subset (hW_spec z).2.2).subset hSubFin

  
  have hSmoothOpenSet : ∀ y : ↥Z₀, y ∉ Sing_Z₀ →
      ∃ W_y : Set ↥Z₀,
        IsOpen W_y ∧
        IsIrreducible W_y ∧
        y ∈ W_y ∧
        (∀ K : Set ↥Z₀, IsClosed K → ¬ closure W_y ⊆ K → (K ∩ W_y).Finite) := by
    intro y hy_not_sing
    have hy_top : y ∈ (⊤ : Z₀.Opens) := trivial
    obtain ⟨U_y, hAff_y, hy_Uy, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_top
    let A_y : Type u := ↑(Z₀.presheaf.obj (Opposite.op U_y))
    let q_y : PrimeSpectrum A_y := hAff_y.primeIdealOf ⟨y, hy_Uy⟩
    have hqy_base : hAff_y.fromSpec.base q_y = y := hAff_y.fromSpec_primeIdealOf ⟨y, hy_Uy⟩
    obtain ⟨g_y, ψ_y, hgy_not, hDom_y, hEt_ψy, _⟩ :=
      hSmExt U_y hAff_y q_y (hqy_base.symm ▸ hy_not_sing)
    let e_y : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g_y)) ⟶ Z₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_y (Localization.Away g_y))) ≫
        hAff_y.fromSpec
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A_y (Localization.Away g_y)))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization g_y
    have : AlgebraicGeometry.IsOpenImmersion hAff_y.fromSpec := hAff_y.isOpenImmersion_fromSpec
    have : AlgebraicGeometry.IsOpenImmersion e_y := inferInstance
    have hIrred_Ty : IrreducibleSpace (PrimeSpectrum (Localization.Away g_y)) :=
      @PrimeSpectrum.irreducibleSpace (Localization.Away g_y) _ hDom_y
    have hqy_bo : q_y ∈ (PrimeSpectrum.basicOpen g_y : Set (PrimeSpectrum A_y)) := hgy_not
    rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away g_y) g_y] at hqy_bo
    rcases hqy_bo with ⟨u_y, huy_eq⟩
    let u_y_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g_y))) := u_y
    let W_y : Set ↥Z₀ := Set.range e_y.base
    have hy_in_Wy : y ∈ W_y := by
      refine ⟨u_y_pt, ?_⟩
      change hAff_y.fromSpec.base (PrimeSpectrum.comap (algebraMap A_y (Localization.Away g_y)) u_y) = y
      rw [huy_eq, hqy_base]
    have hOpen_Wy : IsOpen W_y := e_y.isOpenEmbedding.isOpen_range
    have hIrred_Wy : IsIrreducible W_y := by
      change IsIrreducible (Set.range e_y.base)
      rw [← Set.image_univ]
      exact hIrred_Ty.isIrreducible_univ.image e_y.base e_y.continuous.continuousOn
    refine ⟨W_y, hOpen_Wy, hIrred_Wy, hy_in_Wy, ?_⟩
    intro K hCl_K hNotSub
    let F_y : Set (PrimeSpectrum (Localization.Away g_y)) := e_y.base ⁻¹' K
    have hCl_Fy : IsClosed F_y := hCl_K.preimage e_y.continuous
    have hNeUniv : F_y ≠ Set.univ := by
      intro hUniv
      have hWy_sub : W_y ⊆ K := by
        rintro _ ⟨t, rfl⟩
        have ht : (t : PrimeSpectrum (Localization.Away g_y)) ∈ F_y := by
          rw [hUniv]; trivial
        exact ht
      exact hNotSub (closure_minimal hWy_sub hCl_K)
    have hFin_Fy : F_y.Finite := (hSmRing (Localization.Away g_y) ψ_y hEt_ψy).2 F_y hCl_Fy hNeUniv
    have hInterEq : K ∩ W_y = e_y.base '' F_y := by
      ext x
      simp only [Set.mem_inter_iff, W_y, Set.mem_range, F_y]
      constructor
      · rintro ⟨hxK, t, rfl⟩
        exact ⟨t, hxK, rfl⟩
      · rintro ⟨t, htK, rfl⟩
        exact ⟨htK, t, rfl⟩
    rw [hInterEq]
    exact hFin_Fy.image e_y.base

  
  have hOpenIrredClosure : ∀ W : Set ↥Z₀, IsOpen W → IsIrreducible W →
      closure W ∈ irreducibleComponents ↥Z₀ ∧
      ∀ Z ∈ irreducibleComponents ↥Z₀, (Z ∩ W).Nonempty → Z = closure W := by
    intro W hOpen hIrred
    have hClIrred : IsIrreducible (closure W) := hIrred.closure
    have hSub_of_meet : ∀ T : Set ↥Z₀, IsIrreducible T → (T ∩ W).Nonempty → T ⊆ closure W := by
      intro T hT hTW
      exact (subset_closure_inter_of_isPreirreducible_of_isOpen hT.2 hOpen hTW).trans
        (closure_mono Set.inter_subset_right)
    refine ⟨⟨hClIrred, ?_⟩, ?_⟩
    · intro T hT hClSub
      rcases hIrred.1 with ⟨w, hw⟩
      exact hSub_of_meet T hT ⟨w, hClSub (subset_closure hw), hw⟩
    · intro Z hZ hZW
      have hZ_le : Z ⊆ closure W := hSub_of_meet Z hZ.1 hZW
      exact Set.Subset.antisymm hZ_le (hZ.2 hClIrred hZ_le)

  
  have hSubSing : S_inter ⊆ Sing_Z₀ := by
    rintro y ⟨Z₁, hZ₁, Z₂, hZ₂, hZ12, hy₁, hy₂⟩
    by_contra hy_not_sing
    obtain ⟨W_y, hOpen_Wy, hIrred_Wy, hy_Wy, _⟩ := hSmoothOpenSet y hy_not_sing
    obtain ⟨_, hUniq⟩ := hOpenIrredClosure W_y hOpen_Wy hIrred_Wy
    have h1 := hUniq Z₁ hZ₁ ⟨y, hy₁, hy_Wy⟩
    have h2 := hUniq Z₂ hZ₂ ⟨y, hy₂, hy_Wy⟩
    exact hZ12 (h1.trans h2.symm)

  have hFinS : S_inter.Finite := hFinSing.subset hSubSing

  
  have hAtMost2 : ∀ z : ↥Z₀,
      ∀ Z₁ ∈ irreducibleComponents ↥Z₀,
      ∀ Z₂ ∈ irreducibleComponents ↥Z₀,
      ∀ Z₃ ∈ irreducibleComponents ↥Z₀,
        z ∈ Z₁ → z ∈ Z₂ → z ∈ Z₃ → Z₁ = Z₂ ∨ Z₁ = Z₃ ∨ Z₂ = Z₃ := by
    intro z Z₁ hZ₁ Z₂ hZ₂ Z₃ hZ₃ hz₁ hz₂ hz₃
    by_cases hz_sing : z ∈ Sing_Z₀
    · obtain ⟨_, W_z, B_z0, B_z1, hOpen_Wz, hz_Wz, _, hIrred_B0, hIrred_B1, hWz_sub, _, _⟩ :=
        hLocalSingPkg z hz_sing
      have hComp_eq : ∀ Z ∈ irreducibleComponents ↥Z₀, z ∈ Z →
          Z = closure B_z0 ∨ Z = closure B_z1 := by
        intro Z hZ hzZ
        have hZ_sub : Z ⊆ closure B_z0 ∪ closure B_z1 := by
          calc Z
              ⊆ closure (Z ∩ W_z) :=
                subset_closure_inter_of_isPreirreducible_of_isOpen hZ.1.2 hOpen_Wz ⟨z, hzZ, hz_Wz⟩
            _ ⊆ closure W_z := closure_mono Set.inter_subset_right
            _ ⊆ closure (B_z0 ∪ B_z1) := closure_mono hWz_sub
            _ = closure B_z0 ∪ closure B_z1 := closure_union
        rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hZ.1.2)
          (closure B_z0) (closure B_z1) isClosed_closure isClosed_closure hZ_sub with hLe0 | hLe1
        · exact Or.inl (Set.Subset.antisymm hLe0 (hZ.2 hIrred_B0.closure hLe0))
        · exact Or.inr (Set.Subset.antisymm hLe1 (hZ.2 hIrred_B1.closure hLe1))
      rcases hComp_eq Z₁ hZ₁ hz₁ with h1 | h1 <;>
      rcases hComp_eq Z₂ hZ₂ hz₂ with h2 | h2 <;>
      rcases hComp_eq Z₃ hZ₃ hz₃ with h3 | h3
      · exact Or.inl (h1.trans h2.symm)
      · exact Or.inl (h1.trans h2.symm)
      · exact Or.inr (Or.inl (h1.trans h3.symm))
      · exact Or.inr (Or.inr (h2.trans h3.symm))
      · exact Or.inr (Or.inr (h2.trans h3.symm))
      · exact Or.inr (Or.inl (h1.trans h3.symm))
      · exact Or.inl (h1.trans h2.symm)
      · exact Or.inl (h1.trans h2.symm)
    · obtain ⟨W_z, hOpen_Wz, hIrred_Wz, hz_Wz, _⟩ := hSmoothOpenSet z hz_sing
      obtain ⟨_, hUniq⟩ := hOpenIrredClosure W_z hOpen_Wz hIrred_Wz
      exact Or.inl ((hUniq Z₁ hZ₁ ⟨z, hz₁, hz_Wz⟩).trans (hUniq Z₂ hZ₂ ⟨z, hz₂, hz_Wz⟩).symm)

  
  have hSmWit : ∀ Z_comp ∈ irreducibleComponents ↥Z₀, ∃ p_Z ∈ Z_comp, p_Z ∉ Sing_Z₀ := by
    intro Z_comp hZ_comp
    by_contra hNoSm
    have hAllSing : Z_comp ⊆ Sing_Z₀ :=
      fun x hx => Classical.not_not.mp fun hx_not => hNoSm ⟨x, hx, hx_not⟩
    have hZ_fin : Z_comp.Finite := hFinSing.subset hAllSing
    rcases hZ_comp.1.1 with ⟨s₀, hs₀⟩
    have hs₀_sing : s₀ ∈ Sing_Z₀ := hAllSing hs₀
    let R_rem : Set ↥Z₀ := Z_comp \ {s₀}
    have hCl_rem : IsClosed R_rem := by
      have hEqU : R_rem = ⋃ r ∈ R_rem, ({r} : Set ↥Z₀) := by
        ext x
        simp
      rw [hEqU]
      exact (hZ_fin.subset Set.sdiff_subset).isClosed_biUnion fun r hr =>
        hSingCl r (hAllSing hr.1)
    have hCovZ : Z_comp ⊆ ({s₀} : Set ↥Z₀) ∪ R_rem := by
      intro x hx
      by_cases hxs : x = s₀
      · exact Or.inl hxs
      · exact Or.inr ⟨hx, hxs⟩
    have hZ_sub_s0 : Z_comp ⊆ ({s₀} : Set ↥Z₀) := by
      rcases (isPreirreducible_iff_isClosed_union_isClosed.mp hZ_comp.1.2)
        ({s₀} : Set ↥Z₀) R_rem (hSingCl s₀ hs₀_sing) hCl_rem hCovZ with hSub1 | hSub2
      · exact hSub1
      · exfalso
        exact (hSub2 hs₀).2 rfl
    obtain ⟨_, _W, B_s0, _B1, _, _, _, hIrred_Bs0, _, _, hs₀_Bs0, s', hs'_Bs0, hs'_ne⟩ :=
      hLocalSingPkg s₀ hs₀_sing
    have hZ_le_Bs0 : Z_comp ⊆ B_s0 :=
      hZ_sub_s0.trans (Set.singleton_subset_iff.mpr hs₀_Bs0)
    have hBs0_le_Z : B_s0 ⊆ Z_comp := hZ_comp.2 hIrred_Bs0 hZ_le_Bs0
    exact hs'_ne (hZ_sub_s0 (hBs0_le_Z hs'_Bs0))

  
  have hKcutFin : ∀ K_cut : Set ↥Z₀,
      IsClosed K_cut →
      (∀ z ∈ K_cut, z ∉ Sing_Z₀) →
      (∀ Z_comp ∈ irreducibleComponents ↥Z₀, ¬ Z_comp ⊆ K_cut) →
      K_cut.Finite := by
    intro K_cut hCl_K hDisjSing hNoComp
    have hLocalFin : ∀ y : ↥K_cut,
        ∃ W_y : Set ↥Z₀, IsOpen W_y ∧ y.1 ∈ W_y ∧ (K_cut ∩ W_y).Finite := by
      intro y
      obtain ⟨W_y, hOpen_Wy, hIrred_Wy, hy_Wy, hFinK⟩ :=
        hSmoothOpenSet y.1 (hDisjSing y.1 y.2)
      obtain ⟨hClWy_comp, _⟩ := hOpenIrredClosure W_y hOpen_Wy hIrred_Wy
      exact ⟨W_y, hOpen_Wy, hy_Wy, hFinK K_cut hCl_K (hNoComp (closure W_y) hClWy_comp)⟩
    choose W_cut hOpen_Wcut hy_Wcut hFin_KWcut using hLocalFin
    obtain ⟨t, ht_cov⟩ := hCl_K.isCompact.elim_finite_subcover W_cut hOpen_Wcut
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hy_Wcut ⟨x, hx⟩⟩)
    have hSubFin : K_cut ⊆ ⋃ y ∈ t, K_cut ∩ W_cut y := by
      intro x hx
      rcases Set.mem_iUnion₂.mp (ht_cov hx) with ⟨y, hyt, hxW⟩
      exact Set.mem_biUnion hyt ⟨hx, hxW⟩
    exact (t.finite_toSet.biUnion fun y _ => hFin_KWcut y).subset hSubFin

  exact ⟨hFinComp, hFinSing, hSubSing, hFinS, hSingCl, hAtMost2, hSmWit, hKcutFin, hSmExt, hNodRaw⟩

theorem weil_commRing_proj_gl_automorphism_and_linear_basicOpen (M : ℕ)
    (hAff_proj : ∀ (A : Type u) [CommRing A] (a : Fin (M + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen A M a))
    (c_proj : ∀ (A : Type u) [CommRing A] (a : Fin (M + 1)),
      A →+* ↑((weilProjectiveSpaceOver A M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A M a))))
    (t_proj : ∀ (A : Type u) [CommRing A] (a : Fin (M + 1)), Fin (M + 1) →
      ↑((weilProjectiveSpaceOver A M).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A M a))))
    (hCoord_proj : ∀ (A : Type u) [CommRing A],
      IsCommRingProjCoordSystem A M (hAff_proj A) (c_proj A) (t_proj A)) :
    (∀ (A : Type u) [CommRing A]
       (W W' : Matrix (Fin (M + 1)) (Fin (M + 1)) A),
      W * W' = 1 →
      W' * W = 1 →
      ∃ α : (weilProjectiveSpaceOver A M).left ⟶ (weilProjectiveSpaceOver A M).left,
        CategoryTheory.IsIso α ∧
        α ≫ (weilProjectiveSpaceOver A M).hom = (weilProjectiveSpaceOver A M).hom ∧
        ∀ a : Fin (M + 1),
          (TopologicalSpace.Opens.map α.base).obj (weilProjBasicOpen A M a) =
            ⨆ c : Fin (M + 1),
              (weilProjectiveSpaceOver A M).left.basicOpen
                (∑ b : Fin (M + 1), c_proj A c (W a b) * t_proj A c b)) ∧
    (∀ (A S : Type u) [CommRing A] [CommRing S] (φ_AS : A →+* S)
       (Φ : (weilProjectiveSpaceOver S M).left ⟶ (weilProjectiveSpaceOver A M).left),
      IsCommRingProjBaseChange A S φ_AS M (c_proj A) (t_proj A) (c_proj S) (t_proj S) Φ →
      ∀ v : Fin (M + 1) → A,
        (TopologicalSpace.Opens.map Φ.base).obj
            (⨆ c : Fin (M + 1),
              (weilProjectiveSpaceOver A M).left.basicOpen
                (∑ b : Fin (M + 1), c_proj A c (v b) * t_proj A c b)) =
          ⨆ c : Fin (M + 1),
            (weilProjectiveSpaceOver S M).left.basicOpen
              (∑ b : Fin (M + 1), c_proj S c (φ_AS (v b)) * t_proj S c b)) :=
by
  refine ⟨?_, ?_⟩
  · intro A _ W₀ W₀' hWW' hW'W
    obtain ⟨_hProper, hCov0, hFromSpec0, _hPolyEquiv, ht_diag0, hClos0,
      hUniv0, hInter0, hc_res0, ht_res0⟩ := hCoord_proj A
    suffices hGen : ∀ (X : AlgebraicGeometry.Scheme.{u})
        (p_X : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
        (U : Fin (M + 1) → X.Opens)
        (hAff : ∀ a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (U a))
        (c_A : ∀ a : Fin (M + 1), A →+* ↑(X.presheaf.obj (Opposite.op (U a))))
        (t_A : ∀ a : Fin (M + 1), Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op (U a)))),
        (⨆ a : Fin (M + 1), U a) = ⊤ →
        (∀ a : Fin (M + 1),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_A a)) = (hAff a).fromSpec ≫ p_X) →
        (∀ a : Fin (M + 1), t_A a a = 1) →
        (∀ a : Fin (M + 1), Subring.closure (Set.range (c_A a) ∪ Set.range (t_A a)) = ⊤) →
        (∀ (a : Fin (M + 1)) (B : Type u) [CommRing B] (ρ : A →+* B) (v : Fin (M + 1) → B),
          v a = 1 →
          ∃ ψ : ↑(X.presheaf.obj (Opposite.op (U a))) →+* B,
            ψ.comp (c_A a) = ρ ∧ ∀ b : Fin (M + 1), ψ (t_A a b) = v b) →
        (∀ a a' : Fin (M + 1), X.basicOpen (t_A a a') = U a ⊓ U a') →
        (∀ (a a' : Fin (M + 1)) (r : A),
          (X.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (c_A a' r) =
          (X.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (c_A a r)) →
        (∀ (a a' b : Fin (M + 1)),
          (X.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (t_A a' b) *
          (X.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_A a a') =
          (X.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (t_A a b)) →
        ∃ α : X ⟶ X,
          CategoryTheory.IsIso α ∧
          α ≫ p_X = p_X ∧
          ∀ a : Fin (M + 1),
            (TopologicalSpace.Opens.map α.base).obj (U a) =
              ⨆ c : Fin (M + 1),
                X.basicOpen (∑ b : Fin (M + 1), c_A c (W₀ a b) * t_A c b) from
      hGen (weilProjectiveSpaceOver A M).left (weilProjectiveSpaceOver A M).hom
        (weilProjBasicOpen A M) (hAff_proj A) (c_proj A) (t_proj A)
        hCov0 hFromSpec0 ht_diag0 hClos0 hUniv0 hInter0 hc_res0 ht_res0
    intro X p_X U hAff c_A t_A hCov hFromSpec_hom ht_diag hClos hUniv hInter hc_res ht_res
    classical
    let ℓ : ∀ c : Fin (M + 1), (Fin (M + 1) → A) →
        ↑(X.presheaf.obj (Opposite.op (U c))) :=
      fun c v => ∑ b : Fin (M + 1), c_A c (v b) * t_A c b
    have hResComp : ∀ {O₁ O₂ O₃ : X.Opens} (h₁₂ : O₁ ≤ O₂) (h₂₃ : O₂ ≤ O₃)
        (x : ↑(X.presheaf.obj (Opposite.op O₃))),
        (X.presheaf.map (CategoryTheory.homOfLE h₁₂).op).hom
          ((X.presheaf.map (CategoryTheory.homOfLE h₂₃).op).hom x) =
        (X.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op).hom x := by
      intro O₁ O₂ O₃ h₁₂ h₂₃ x
      have h_eq : X.presheaf.map (CategoryTheory.homOfLE h₂₃).op ≫
          X.presheaf.map (CategoryTheory.homOfLE h₁₂).op =
          X.presheaf.map (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op := by
        rw [← X.presheaf.map_comp, ← op_comp, CategoryTheory.homOfLE_comp]
      exact congrArg (fun m => m.hom x) h_eq
    have hExt : ∀ (a : Fin (M + 1)) {B : Type u} [CommRing B]
        (φ₁ φ₂ : ↑(X.presheaf.obj (Opposite.op (U a))) →+* B),
        (∀ r : A, φ₁ (c_A a r) = φ₂ (c_A a r)) →
        (∀ b : Fin (M + 1), φ₁ (t_A a b) = φ₂ (t_A a b)) →
        φ₁ = φ₂ := by
      intro a B _ φ₁ φ₂ hc ht
      have hSub : Set.range (c_A a) ∪ Set.range (t_A a) ⊆ (φ₁.eqLocus φ₂ : Set _) := by
        rintro _ (⟨r, rfl⟩ | ⟨b, rfl⟩)
        · exact hc r
        · exact ht b
      have hTop : (⊤ : Subring _) ≤ φ₁.eqLocus φ₂ := by
        rw [← hClos a]
        exact Subring.closure_le.mpr hSub
      ext x
      exact hTop trivial
    have hCocycle : ∀ (c c' : Fin (M + 1)) (v : Fin (M + 1) → A),
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U c ⊓ U c' ≤ U c')).op).hom
            (ℓ c' v) *
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U c ⊓ U c' ≤ U c)).op).hom
            (t_A c c') =
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U c ⊓ U c' ≤ U c)).op).hom
          (ℓ c v) := by
      intro c c' v
      let resL := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U c ⊓ U c' ≤ U c)).op).hom
      let resR := (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U c ⊓ U c' ≤ U c')).op).hom
      change resR (ℓ c' v) * resL (t_A c c') = resL (ℓ c v)
      simp only [ℓ, map_sum, map_mul, Finset.sum_mul]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [mul_assoc, hc_res c c' (v b), ht_res c c' b]
    have ht_inv : ∀ (c c' : Fin (M + 1)),
        (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : U c ⊓ U c' ≤ U c')).op).hom
            (t_A c' c) *
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U c ⊓ U c' ≤ U c)).op).hom
            (t_A c c') = 1 := by
      intro c c'
      have h := ht_res c c' c
      rw [ht_diag c, map_one] at h
      exact h
    have hInterEq : ∀ (c c' : Fin (M + 1)) (w w' : Fin (M + 1) → A),
        X.basicOpen (ℓ c w) ⊓ X.basicOpen (ℓ c' w') =
          X.basicOpen (ℓ c w * t_A c c' * ℓ c w') := by
      intro c c' w w'
      let hL : U c ⊓ U c' ≤ U c := inf_le_left
      let hR : U c ⊓ U c' ≤ U c' := inf_le_right
      let resL := (X.presheaf.map (CategoryTheory.homOfLE hL).op).hom
      let resR := (X.presheaf.map (CategoryTheory.homOfLE hR).op).hom
      have h1 : resL (ℓ c w') = resR (ℓ c' w') * resL (t_A c c') :=
        (hCocycle c c' w').symm
      have h2 : resR (ℓ c' w') = resL (ℓ c w') * resR (t_A c' c) := by
        calc resR (ℓ c' w')
          _ = resR (ℓ c' w') * 1 := (mul_one _).symm
          _ = resR (ℓ c' w') * (resL (t_A c c') * resR (t_A c' c)) := by
              rw [mul_comm (resL (t_A c c')), ht_inv c c']
          _ = (resR (ℓ c' w') * resL (t_A c c')) * resR (t_A c' c) := (mul_assoc _ _ _).symm
          _ = resL (ℓ c w') * resR (t_A c' c) := by rw [h1]
      have hBO_eq : X.basicOpen (resL (ℓ c w')) = X.basicOpen (resR (ℓ c' w')) := by
        apply le_antisymm
        · rw [h1, X.basicOpen_mul]
          exact inf_le_left
        · rw [h2, X.basicOpen_mul]
          exact inf_le_left
      have hBO_res : (U c ⊓ U c') ⊓ X.basicOpen (ℓ c w') =
          (U c ⊓ U c') ⊓ X.basicOpen (ℓ c' w') := by
        have hL_eq : X.basicOpen (resL (ℓ c w')) = (U c ⊓ U c') ⊓ X.basicOpen (ℓ c w') :=
          X.basicOpen_res (ℓ c w') (CategoryTheory.homOfLE hL).op
        have hR_eq : X.basicOpen (resR (ℓ c' w')) = (U c ⊓ U c') ⊓ X.basicOpen (ℓ c' w') :=
          X.basicOpen_res (ℓ c' w') (CategoryTheory.homOfLE hR).op
        rwa [hL_eq, hR_eq] at hBO_eq
      have hw_le : X.basicOpen (ℓ c w) ≤ U c := X.basicOpen_le (ℓ c w)
      have hw'_le : X.basicOpen (ℓ c' w') ≤ U c' := X.basicOpen_le (ℓ c' w')
      calc X.basicOpen (ℓ c w) ⊓ X.basicOpen (ℓ c' w')
        _ = (X.basicOpen (ℓ c w) ⊓ U c) ⊓ (U c' ⊓ X.basicOpen (ℓ c' w')) := by
            rw [inf_eq_left.mpr hw_le, inf_eq_right.mpr hw'_le]
        _ = X.basicOpen (ℓ c w) ⊓ ((U c ⊓ U c') ⊓ X.basicOpen (ℓ c' w')) := by
            simp only [inf_assoc]
        _ = X.basicOpen (ℓ c w) ⊓ ((U c ⊓ U c') ⊓ X.basicOpen (ℓ c w')) := by
            rw [hBO_res]
        _ = X.basicOpen (ℓ c w) ⊓ X.basicOpen (t_A c c') ⊓ X.basicOpen (ℓ c w') := by
            rw [← hInter c c', ← inf_assoc]
        _ = X.basicOpen (ℓ c w * t_A c c' * ℓ c w') := by
            rw [X.basicOpen_mul, X.basicOpen_mul]
    have hInterAff : ∀ (c c' : Fin (M + 1)) (w w' : Fin (M + 1) → A),
        AlgebraicGeometry.IsAffineOpen (X.basicOpen (ℓ c w) ⊓ X.basicOpen (ℓ c' w')) := by
      intro c c' w w'
      rw [hInterEq c c' w w']
      exact (hAff c).basicOpen _
    let J := ULift.{u} (Fin (M + 1) × Fin (M + 1))
    have hMatRow : ∀ (W W' : Matrix (Fin (M + 1)) (Fin (M + 1)) A),
        W' * W = 1 →
        ∀ c d : Fin (M + 1),
          ∑ k : Fin (M + 1), c_A c (W' d k) * ℓ c (W k) = t_A c d := by
      intro W W' hInv c d
      calc ∑ k : Fin (M + 1), c_A c (W' d k) * ℓ c (W k)
        _ = ∑ k : Fin (M + 1), ∑ b : Fin (M + 1),
              c_A c (W' d k) * (c_A c (W k b) * t_A c b) := by
            simp only [ℓ, Finset.mul_sum]
        _ = ∑ b : Fin (M + 1), ∑ k : Fin (M + 1),
              (c_A c (W' d k) * c_A c (W k b)) * t_A c b := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun k _ => ?_
            rw [← mul_assoc]
        _ = ∑ b : Fin (M + 1), c_A c ((W' * W) d b) * t_A c b := by
            refine Finset.sum_congr rfl fun b _ => ?_
            rw [← Finset.sum_mul, Matrix.mul_apply, map_sum]
            simp only [map_mul]
        _ = ∑ b : Fin (M + 1),
              c_A c ((1 : Matrix (Fin (M + 1)) (Fin (M + 1)) A) d b) * t_A c b := by
            rw [hInv]
        _ = t_A c d := by
            rw [Finset.sum_eq_single d]
            · simp
            · intro b _ hbd
              simp [Ne.symm hbd]
            · intro hd
              exact absurd (Finset.mem_univ d) hd
    have hChartCov : ∀ (W W' : Matrix (Fin (M + 1)) (Fin (M + 1)) A),
        W' * W = 1 →
        ∀ c : Fin (M + 1), (⨆ a : Fin (M + 1), X.basicOpen (ℓ c (W a))) = U c := by
      intro W W' hInv c
      let g : Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op (U c))) := fun a => ℓ c (W a)
      have h1_mem : (1 : ↑(X.presheaf.obj (Opposite.op (U c)))) ∈ Ideal.span (Set.range g) := by
        have hOne : ∑ k : Fin (M + 1), c_A c (W' c k) * g k = 1 := by
          dsimp [g]
          rw [hMatRow W W' hInv c c, ht_diag c]
        rw [← hOne]
        exact Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩)
      have hSpan : Ideal.span (Set.range g) = ⊤ :=
        Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one
      have hRange : (⨆ f : Set.range g, X.basicOpen f.1) = U c :=
        (hAff c).iSup_basicOpen_eq_self_iff.mpr hSpan
      refine (le_antisymm ?_ ?_).trans hRange
      · exact iSup_le fun a => le_iSup (fun f : Set.range g => X.basicOpen f.1) ⟨g a, a, rfl⟩
      · refine iSup_le fun f => ?_
        rcases f with ⟨_, a, rfl⟩
        exact le_iSup (fun a => X.basicOpen (g a)) a
    have hGlobCov : ∀ (W W' : Matrix (Fin (M + 1)) (Fin (M + 1)) A),
        W' * W = 1 →
        (⨆ p : J, X.basicOpen (ℓ p.down.1 (fun b => W p.down.2 b))) = ⊤ := by
      intro W W' hInv
      apply le_antisymm le_top
      rw [← hCov, iSup_le_iff]
      intro c
      rw [← hChartCov W W' hInv c, iSup_le_iff]
      intro a
      exact le_iSup (fun p : J => X.basicOpen (ℓ p.down.1 (fun b => W p.down.2 b)))
        (ULift.up (c, a))
    have hConstruct : ∀ (W W' : Matrix (Fin (M + 1)) (Fin (M + 1)) A),
        W' * W = 1 →
        ∃ α : X ⟶ X,
          α ≫ p_X = p_X ∧
          (∀ d : Fin (M + 1),
            (TopologicalSpace.Opens.map α.base).obj (U d) =
              ⨆ c : Fin (M + 1), X.basicOpen (ℓ c (W d))) ∧
          (∀ c a : Fin (M + 1),
            ∃ hW_le : X.basicOpen (ℓ c (W a)) ≤ (TopologicalSpace.Opens.map α.base).obj (U a),
              (∀ r : A,
                (α.appLE (U a) (X.basicOpen (ℓ c (W a))) hW_le).hom (c_A a r) =
                  (X.presheaf.map
                    (CategoryTheory.homOfLE (X.basicOpen_le (ℓ c (W a)))).op).hom (c_A c r)) ∧
              (∀ b : Fin (M + 1),
                (α.appLE (U a) (X.basicOpen (ℓ c (W a))) hW_le).hom (t_A a b) *
                  (X.presheaf.map
                    (CategoryTheory.homOfLE (X.basicOpen_le (ℓ c (W a)))).op).hom (ℓ c (W a)) =
                  (X.presheaf.map
                    (CategoryTheory.homOfLE (X.basicOpen_le (ℓ c (W a)))).op).hom (ℓ c (W b)))) := by
      intro W W' hInv
      let W_open : Fin (M + 1) → Fin (M + 1) → X.Opens := fun c a => X.basicOpen (ℓ c (W a))
      have hAff_W : ∀ c a : Fin (M + 1), AlgebraicGeometry.IsAffineOpen (W_open c a) :=
        fun c a => (hAff c).basicOpen (ℓ c (W a))
      let res_W : ∀ c a : Fin (M + 1),
          ↑(X.presheaf.obj (Opposite.op (U c))) →+*
            ↑(X.presheaf.obj (Opposite.op (W_open c a))) :=
        fun c a =>
          (X.presheaf.map (CategoryTheory.homOfLE (X.basicOpen_le (ℓ c (W a)))).op).hom
      have hd_unit : ∀ c a : Fin (M + 1), IsUnit (res_W c a (ℓ c (W a))) :=
        fun c a => X.toRingedSpace.isUnit_res_basicOpen (ℓ c (W a))
      have hLocalΨ : ∀ c a : Fin (M + 1),
          ∃ ψ : ↑(X.presheaf.obj (Opposite.op (U a))) →+*
              ↑(X.presheaf.obj (Opposite.op (W_open c a))),
            ψ.comp (c_A a) = (res_W c a).comp (c_A c) ∧
            ∀ b : Fin (M + 1),
              ψ (t_A a b) * res_W c a (ℓ c (W a)) = res_W c a (ℓ c (W b)) := by
        intro c a
        obtain ⟨u, hu⟩ := hd_unit c a
        let v : Fin (M + 1) → ↑(X.presheaf.obj (Opposite.op (W_open c a))) :=
          fun b => res_W c a (ℓ c (W b)) * ↑u⁻¹
        have hva : v a = 1 := by
          dsimp [v]
          rw [← hu, Units.mul_inv]
        obtain ⟨ψ, hψ_c, hψ_v⟩ := hUniv a _ ((res_W c a).comp (c_A c)) v hva
        refine ⟨ψ, hψ_c, fun b => ?_⟩
        rw [hψ_v b]
        dsimp [v]
        rw [← hu, mul_assoc, Units.inv_mul, mul_one]
      choose ψ hψ_c hψ_t using hLocalΨ
      let f_loc : ∀ c a : Fin (M + 1), (W_open c a).toScheme ⟶ X :=
        fun c a =>
          (W_open c a).toSpecΓ ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ c a)) ≫
            (hAff a).fromSpec
      let W_cov : J → X.Opens := fun p => W_open p.down.1 p.down.2
      have hOv : ∀ p q : J,
          X.homOfLE (inf_le_left : W_cov p ⊓ W_cov q ≤ W_cov p) ≫ f_loc p.down.1 p.down.2 =
          X.homOfLE (inf_le_right : W_cov p ⊓ W_cov q ≤ W_cov q) ≫ f_loc q.down.1 q.down.2 := by
        intro p q
        let c := p.down.1
        let a := p.down.2
        let c' := q.down.1
        let a' := q.down.2
        let V : X.Opens := W_open c a ⊓ W_open c' a'
        have hV : AlgebraicGeometry.IsAffineOpen V := hInterAff c c' (W a) (W a')
        apply (cancel_epi hV.isoSpec.inv).mp
        have hIsoToSpec : ∀ (W_0 : X.Opens) (hW0 : AlgebraicGeometry.IsAffineOpen W_0)
            (hVW0 : V ≤ W_0),
            hV.isoSpec.inv ≫ X.homOfLE hVW0 ≫ W_0.toSpecΓ =
              AlgebraicGeometry.Spec.map (X.presheaf.map (CategoryTheory.homOfLE hVW0).op) := by
          intro W_0 hW0 hVW0
          apply (cancel_mono hW0.fromSpec).mp
          rw [Category.assoc, Category.assoc, hW0.toSpecΓ_fromSpec, X.homOfLE_ι,
            hV.isoSpec_inv_ι, hW0.map_fromSpec hV (CategoryTheory.homOfLE hVW0).op]
        let res_WV₁ :=
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V ≤ W_open c a)).op).hom
        let res_WV₂ :=
          (X.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V ≤ W_open c' a')).op).hom
        let φ₁ : ↑(X.presheaf.obj (Opposite.op (U a))) →+*
            ↑(X.presheaf.obj (Opposite.op V)) := res_WV₁.comp (ψ c a)
        let φ₂ : ↑(X.presheaf.obj (Opposite.op (U a'))) →+*
            ↑(X.presheaf.obj (Opposite.op V)) := res_WV₂.comp (ψ c' a')
        have hLHS : hV.isoSpec.inv ≫ X.homOfLE (inf_le_left : V ≤ W_open c a) ≫ f_loc c a =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ (hAff a).fromSpec := by
          calc hV.isoSpec.inv ≫ X.homOfLE inf_le_left ≫
                ((W_open c a).toSpecΓ ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ c a)) ≫ (hAff a).fromSpec)
            _ = (hV.isoSpec.inv ≫ X.homOfLE inf_le_left ≫ (W_open c a).toSpecΓ) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ c a)) ≫ (hAff a).fromSpec := by
                simp only [Category.assoc]
            _ = AlgebraicGeometry.Spec.map
                    (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V ≤ W_open c a)).op) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ c a)) ≫ (hAff a).fromSpec := by
                rw [hIsoToSpec (W_open c a) (hAff_W c a) inf_le_left]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ (hAff a).fromSpec := by
                rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
                rfl
        have hRHS : hV.isoSpec.inv ≫ X.homOfLE (inf_le_right : V ≤ W_open c' a') ≫ f_loc c' a' =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) ≫ (hAff a').fromSpec := by
          calc hV.isoSpec.inv ≫ X.homOfLE inf_le_right ≫
                ((W_open c' a').toSpecΓ ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ c' a')) ≫ (hAff a').fromSpec)
            _ = (hV.isoSpec.inv ≫ X.homOfLE inf_le_right ≫ (W_open c' a').toSpecΓ) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ c' a')) ≫
                    (hAff a').fromSpec := by
                simp only [Category.assoc]
            _ = AlgebraicGeometry.Spec.map
                    (X.presheaf.map
                      (CategoryTheory.homOfLE (inf_le_right : V ≤ W_open c' a')).op) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ c' a')) ≫
                    (hAff a').fromSpec := by
                rw [hIsoToSpec (W_open c' a') (hAff_W c' a') inf_le_right]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) ≫ (hAff a').fromSpec := by
                rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
                rfl
        have hVc : V ≤ U c :=
          (inf_le_left : V ≤ W_open c a).trans (X.basicOpen_le (ℓ c (W a)))
        have hVc' : V ≤ U c' :=
          (inf_le_right : V ≤ W_open c' a').trans (X.basicOpen_le (ℓ c' (W a')))
        have hVcc' : V ≤ U c ⊓ U c' := le_inf hVc hVc'
        let res_cV := (X.presheaf.map (CategoryTheory.homOfLE hVc).op).hom
        let res_c'V := (X.presheaf.map (CategoryTheory.homOfLE hVc').op).hom
        have hCoc_V : ∀ v : Fin (M + 1) → A,
            res_c'V (ℓ c' v) * res_cV (t_A c c') = res_cV (ℓ c v) := by
          intro v
          have h := congrArg (X.presheaf.map (CategoryTheory.homOfLE hVcc').op).hom
            (hCocycle c c' v)
          rw [map_mul, hResComp hVcc' inf_le_right, hResComp hVcc' inf_le_left,
            hResComp hVcc' inf_le_left] at h
          exact h
        have ht_inv_V : res_c'V (t_A c' c) * res_cV (t_A c c') = 1 := by
          have h := congrArg (X.presheaf.map (CategoryTheory.homOfLE hVcc').op).hom
            (ht_inv c c')
          rw [map_mul, map_one, hResComp hVcc' inf_le_right, hResComp hVcc' inf_le_left] at h
          exact h
        have hc_res_V : ∀ r : A, res_c'V (c_A c' r) = res_cV (c_A c r) := by
          intro r
          have h := congrArg (X.presheaf.map (CategoryTheory.homOfLE hVcc').op).hom
            (hc_res c c' r)
          rw [hResComp hVcc' inf_le_right, hResComp hVcc' inf_le_left] at h
          exact h
        have hφ₁_c : ∀ r : A, φ₁ (c_A a r) = res_cV (c_A c r) := by
          intro r
          change res_WV₁ (ψ c a (c_A a r)) = res_cV (c_A c r)
          have hc_eq : ψ c a (c_A a r) = res_W c a (c_A c r) :=
            RingHom.congr_fun (hψ_c c a) r
          rw [hc_eq]
          exact hResComp inf_le_left (X.basicOpen_le _) (c_A c r)
        have hφ₁_t : ∀ b : Fin (M + 1),
            φ₁ (t_A a b) * res_cV (ℓ c (W a)) = res_cV (ℓ c (W b)) := by
          intro b
          have h := congrArg res_WV₁ (hψ_t c a b)
          rw [map_mul, hResComp inf_le_left (X.basicOpen_le _),
            hResComp inf_le_left (X.basicOpen_le _)] at h
          exact h
        have hφ₂_c : ∀ r : A, φ₂ (c_A a' r) = res_c'V (c_A c' r) := by
          intro r
          change res_WV₂ (ψ c' a' (c_A a' r)) = res_c'V (c_A c' r)
          have hc_eq : ψ c' a' (c_A a' r) = res_W c' a' (c_A c' r) :=
            RingHom.congr_fun (hψ_c c' a') r
          rw [hc_eq]
          exact hResComp inf_le_right (X.basicOpen_le _) (c_A c' r)
        have hφ₂_t : ∀ b : Fin (M + 1),
            φ₂ (t_A a' b) * res_c'V (ℓ c' (W a')) = res_c'V (ℓ c' (W b)) := by
          intro b
          have h := congrArg res_WV₂ (hψ_t c' a' b)
          rw [map_mul, hResComp inf_le_right (X.basicOpen_le _),
            hResComp inf_le_right (X.basicOpen_le _)] at h
          exact h
        have hUnit_ca : IsUnit (res_cV (ℓ c (W a))) := by
          rw [← hResComp inf_le_left (X.basicOpen_le _)]
          exact (hd_unit c a).map res_WV₁
        have hUnit_c'a' : IsUnit (res_c'V (ℓ c' (W a'))) := by
          rw [← hResComp inf_le_right (X.basicOpen_le _)]
          exact (hd_unit c' a').map res_WV₂
        have hUnit_tcc' : IsUnit (res_cV (t_A c c')) :=
          IsUnit.of_mul_eq_one_right _ ht_inv_V
        have hUnit_ca' : IsUnit (res_cV (ℓ c (W a'))) := by
          rw [← hCoc_V (W a')]
          exact hUnit_c'a'.mul hUnit_tcc'
        have hUnit_φ₁_taa' : IsUnit (φ₁ (t_A a a')) := by
          obtain ⟨u_a, hu_a⟩ := hUnit_ca
          obtain ⟨u_a', hu_a'⟩ := hUnit_ca'
          refine ⟨u_a' * u_a⁻¹, ?_⟩
          rw [Units.val_mul, hu_a', ← hφ₁_t a', ← hu_a, mul_assoc, Units.mul_inv, mul_one]
        let B₀ : X.Opens := X.basicOpen (t_A a a')
        have hAff_B0 : AlgebraicGeometry.IsAffineOpen B₀ := (hAff a).basicOpen (t_A a a')
        have hB0_a : B₀ ≤ U a := X.basicOpen_le (t_A a a')
        have hB0_inter : B₀ ≤ U a ⊓ U a' := (hInter a a').le
        have hB0_a' : B₀ ≤ U a' := hB0_inter.trans inf_le_right
        let res_aB0 := (X.presheaf.map (CategoryTheory.homOfLE hB0_a).op).hom
        let res_a'B0 := (X.presheaf.map (CategoryTheory.homOfLE hB0_a').op).hom
        have hLiftExists :
            ∃ φ₁_lift : ↑(X.presheaf.obj (Opposite.op B₀)) →+*
                ↑(X.presheaf.obj (Opposite.op V)),
              ∀ x : ↑(X.presheaf.obj (Opposite.op (U a))),
                φ₁_lift (res_aB0 x) = φ₁ x := by
          letI := (hAff a).isLocalization_basicOpen (t_A a a')
          letI : Algebra ↑(X.presheaf.obj (Opposite.op (U a)))
              ↑(X.presheaf.obj (Opposite.op V)) := φ₁.toAlgebra
          have hf' : IsUnit (algebraMap ↑(X.presheaf.obj (Opposite.op (U a)))
              ↑(X.presheaf.obj (Opposite.op V)) (t_A a a')) := hUnit_φ₁_taa'
          exact ⟨IsLocalization.Away.lift (t_A a a') hf',
            fun x => IsLocalization.Away.lift_eq (t_A a a') hf' x⟩
        obtain ⟨φ₁_lift, hφ₁_lift⟩ := hLiftExists
        have hLift_eq_φ₂ : φ₁_lift.comp res_a'B0 = φ₂ := by
          apply hExt a'
          · intro r
            have hc_B0 := congrArg (X.presheaf.map (CategoryTheory.homOfLE hB0_inter).op).hom
              (hc_res a a' r)
            rw [hResComp hB0_inter inf_le_right, hResComp hB0_inter inf_le_left] at hc_B0
            change φ₁_lift (res_a'B0 (c_A a' r)) = φ₂ (c_A a' r)
            rw [hc_B0, hφ₁_lift, hφ₁_c, ← hc_res_V, hφ₂_c]
          · intro b
            have ht_B0 := congrArg (X.presheaf.map (CategoryTheory.homOfLE hB0_inter).op).hom
              (ht_res a a' b)
            rw [map_mul, hResComp hB0_inter inf_le_right, hResComp hB0_inter inf_le_left,
              hResComp hB0_inter inf_le_left] at ht_B0
            have h_mul : φ₁_lift (res_a'B0 (t_A a' b)) * φ₁ (t_A a a') = φ₁ (t_A a b) := by
              have happ := congrArg φ₁_lift ht_B0
              rw [map_mul, hφ₁_lift, hφ₁_lift] at happ
              exact happ
            apply hUnit_ca'.mul_right_cancel
            calc φ₁_lift (res_a'B0 (t_A a' b)) * res_cV (ℓ c (W a'))
              _ = φ₁_lift (res_a'B0 (t_A a' b)) * (φ₁ (t_A a a') * res_cV (ℓ c (W a))) := by
                  rw [hφ₁_t a']
              _ = (φ₁_lift (res_a'B0 (t_A a' b)) * φ₁ (t_A a a')) * res_cV (ℓ c (W a)) :=
                  (mul_assoc _ _ _).symm
              _ = φ₁ (t_A a b) * res_cV (ℓ c (W a)) := by
                  rw [h_mul]
              _ = res_cV (ℓ c (W b)) := hφ₁_t b
              _ = res_c'V (ℓ c' (W b)) * res_cV (t_A c c') := (hCoc_V (W b)).symm
              _ = (φ₂ (t_A a' b) * res_c'V (ℓ c' (W a'))) * res_cV (t_A c c') := by
                  rw [← hφ₂_t b]
              _ = φ₂ (t_A a' b) * (res_c'V (ℓ c' (W a')) * res_cV (t_A c c')) :=
                  mul_assoc _ _ _
              _ = φ₂ (t_A a' b) * res_cV (ℓ c (W a')) := by
                  rw [hCoc_V (W a')]
        have hφ₁_comp : φ₁_lift.comp res_aB0 = φ₁ := RingHom.ext hφ₁_lift
        calc hV.isoSpec.inv ≫ X.homOfLE (inf_le_left : V ≤ W_open c a) ≫ f_loc c a
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ (hAff a).fromSpec := hLHS
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁_lift.comp res_aB0)) ≫
                (hAff a).fromSpec := by rw [hφ₁_comp]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁_lift) ≫
                (AlgebraicGeometry.Spec.map (X.presheaf.map (CategoryTheory.homOfLE hB0_a).op) ≫
                  (hAff a).fromSpec) := by
              rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
              rfl
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁_lift) ≫ hAff_B0.fromSpec := by
              rw [(hAff a).map_fromSpec hAff_B0 (CategoryTheory.homOfLE hB0_a).op]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁_lift) ≫
                (AlgebraicGeometry.Spec.map (X.presheaf.map (CategoryTheory.homOfLE hB0_a').op) ≫
                  (hAff a').fromSpec) := by
              rw [(hAff a').map_fromSpec hAff_B0 (CategoryTheory.homOfLE hB0_a').op]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁_lift.comp res_a'B0)) ≫
                (hAff a').fromSpec := by
              rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
              rfl
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) ≫ (hAff a').fromSpec := by
              rw [hLift_eq_φ₂]
          _ = hV.isoSpec.inv ≫ X.homOfLE (inf_le_right : V ≤ W_open c' a') ≫ f_loc c' a' :=
              hRHS.symm
      let 𝒰 := X.openCoverOfIsOpenCover W_cov
        (TopologicalSpace.IsOpenCover.mk (hGlobCov W W' hInv))
      let f_cov : ∀ p : J, (W_cov p).toScheme ⟶ X := fun p => f_loc p.down.1 p.down.2
      have hGlue : ∀ p q : 𝒰.I₀,
          CategoryTheory.Limits.pullback.fst (𝒰.f p) (𝒰.f q) ≫ f_cov p =
          CategoryTheory.Limits.pullback.snd (𝒰.f p) (𝒰.f q) ≫ f_cov q := by
        intro p q
        let π₁ : CategoryTheory.Limits.pullback (W_cov p).ι (W_cov q).ι ⟶
            (W_cov p).toScheme :=
          CategoryTheory.Limits.pullback.fst (𝒰.f p) (𝒰.f q)
        let π₂ : CategoryTheory.Limits.pullback (W_cov p).ι (W_cov q).ι ⟶
            (W_cov q).toScheme :=
          CategoryTheory.Limits.pullback.snd (𝒰.f p) (𝒰.f q)
