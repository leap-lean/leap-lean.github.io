        split_ifs with h
        · omega
        · rfl
  let x_F : F := ι Polynomial.X
  have hx_F : x_F ≠ 0 :=
    fun h0 => Polynomial.X_ne_zero (hInj_ι (h0.trans (map_zero ι).symm))
  let φ_inv : Polynomial K →+* F :=
    Polynomial.eval₂RingHom (ι.comp Polynomial.C) x_F⁻¹
  have hEvalRev : ∀ (d : ℕ) (Q : Polynomial K),
      Q.natDegree ≤ d → φ_inv (rev d Q) * x_F ^ d = ι Q := by
    intro d Q hQ
    dsimp [rev]
    rw [map_sum, Finset.sum_mul]
    conv_rhs => rw [hPolySum d Q hQ, map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    have hj_le : (j : ℕ) ≤ d := Nat.le_of_lt_succ j.isLt
    have hxd : x_F ^ d = x_F ^ (d - (j : ℕ)) * x_F ^ (j : ℕ) := by
      rw [← pow_add, Nat.sub_add_cancel hj_le]
    have hcancel : (x_F⁻¹) ^ (d - (j : ℕ)) * x_F ^ (d - (j : ℕ)) = 1 := by
