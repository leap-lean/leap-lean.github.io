      obtain ⟨W', hAff', hu₀_W', hW'_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hu₀_pre
      have hW'_le : W' ≤ (TopologicalSpace.Opens.map e₁.base).obj W_aff := hW'_sub
