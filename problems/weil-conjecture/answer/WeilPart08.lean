        · exact Ideal.mem_sup_left hx0_1
        · exact Ideal.mem_sup_right hx1_2
      · rintro _ (rfl | rfl)
        · exact Ideal.mem_sup_right hx0_2
        · exact Ideal.mem_sup_left hx1_1
      · exfalso
