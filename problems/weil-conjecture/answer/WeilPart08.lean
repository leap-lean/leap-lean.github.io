  · intro E hE d P_b _hPb0 hPb_deg hEV0 hEV1 i
    let P_tilde : Polynomial K :=
      ∑ j : Fin (d + 1), Polynomial.C (P_b.coeff (j : ℕ)) * Polynomial.X ^ (d - (j : ℕ))
    let U₀_E : X.Opens := E ⊓ V₀
    let U₁_E : X.Opens := E ⊓ V₁
    let d₀ : ↑(X.presheaf.obj (Opposite.op U₀_E)) :=
