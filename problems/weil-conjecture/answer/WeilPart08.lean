    have hNotY := hNotSubY' O_K hOpen_OK ⟨q₁, hxE_VC, hq₁_E⟩
    obtain ⟨q_E, hqE_OK, hqE_notY⟩ := Set.not_subset.mp hNotY
    rcases hqE_OK with ⟨w_E, hwE_UW, hwE_eq⟩
    obtain ⟨z_E, hzE_CK, hzE_fst⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb q_E w_E hwE_eq.symm
    rcases mem_closure_iff.mp hwY V_C hOpen_VC hw₀_VC with ⟨_, hxY_VC, q₂, hq₂_Y, rfl⟩
    have hNotE := hNotSubE O_K hOpen_OK ⟨q₂, hxY_VC, hq₂_Y⟩
    obtain ⟨q_Y, hqY_OK, hqY_notE⟩ := Set.not_subset.mp hNotE
    rcases hqY_OK with ⟨w_Y, hwY_UW, hwY_eq⟩
    obtain ⟨z_Y, hzY_CK, hzY_fst⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb q_Y w_Y hwY_eq.symm
    intro hPre
    let O₁ : Set ↥(CategoryTheory.Limits.pullback f_W η_R) := e_CK.base ⁻¹' Y'_Kᶜ
    let O₂ : Set ↥(CategoryTheory.Limits.pullback f_W η_R) := e_CK.base ⁻¹' Eᶜ
    have hOpen₁ : IsOpen O₁ := hClY.isOpen_compl.preimage e_CK.continuous
    have hOpen₂ : IsOpen O₂ := hClE.isOpen_compl.preimage e_CK.continuous
    have hNe₁ : ((fst_W.base ⁻¹' (U_W : Set ↥W)) ∩ O₁).Nonempty :=
      ⟨z_E, by show fst_W.base z_E ∈ U_W; rwa [hzE_fst], by show e_CK.base z_E ∉ Y'_K; rwa [hzE_CK]⟩
    have hNe₂ : ((fst_W.base ⁻¹' (U_W : Set ↥W)) ∩ O₂).Nonempty :=
      ⟨z_Y, by show fst_W.base z_Y ∈ U_W; rwa [hzY_fst], by show e_CK.base z_Y ∉ E; rwa [hzY_CK]⟩
    rcases hPre O₁ O₂ hOpen₁ hOpen₂ hNe₁ hNe₂ with ⟨z, _, hz_notY, hz_notE⟩
    have hUniv : e_CK.base z ∈ E ∪ Y'_K := by
      rw [hUnion]
      trivial
    exact hUniv.elim hz_notE hz_notY

theorem weil_split_nodal_etale_chart_axis_domains_and_section (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (hEtDom : ∀ (A₀ B₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B₀] [Algebra A₀ B₀] [Algebra.Etale A₀ B₀]
        (q : PrimeSpectrum B₀),
      ∃ g : B₀, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (hEtSec : ∀ (U : AlgebraicGeometry.Scheme.{u})
        (f : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
      AlgebraicGeometry.Etale f →
      ∀ (u₀ : U),
        (f.base u₀).asIdeal = IsLocalRing.maximalIdeal R →
        ∃ (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U),
          σ ≫ f = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) ∧
          ∀ b : AlgebraicGeometry.Spec (CommRingCat.of R),
            b.asIdeal = IsLocalRing.maximalIdeal R → σ.base b = u₀)
    (hNodSplit : ∀ (S₀ B : Type u) [CommRing S₀] [IsDomain S₀] [CommRing B]
        (φ : (MvPolynomial (Fin 2) S₀ ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B),
      φ.Etale →
      let x₀ := φ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
      let x₁ := φ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      x₀ * x₁ = 0 ∧
      (Ideal.span {x₀} : Ideal B) ⊓ Ideal.span {x₁} = ⊥ ∧
      (∃ ψ₀ : Polynomial S₀ →+* (B ⧸ Ideal.span {x₁}),
        ψ₀.Etale ∧
        ψ₀.comp Polynomial.C =
          (Ideal.Quotient.mk _).comp (φ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
        ψ₀ Polynomial.X = Ideal.Quotient.mk _ x₀) ∧
      (∃ ψ₁ : Polynomial S₀ →+* (B ⧸ Ideal.span {x₀}),
        ψ₁.Etale ∧
        ψ₁.comp Polynomial.C =
          (Ideal.Quotient.mk _).comp (φ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ∧
        ψ₁ Polynomial.X = Ideal.Quotient.mk _ x₁) ∧
      ((Ideal.Quotient.mk (Ideal.span {x₀, x₁})).comp
        (φ.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))).Etale)
    (W' : AlgebraicGeometry.Scheme.{u}) (w₀ : ↥W')
    (e_nod₀ : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) R ⧸ Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1})))
    (hEt_nod₀ : AlgebraicGeometry.Etale e_nod₀)
    (hX_w₀ : ∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e_nod₀.base w₀).asIdeal)
    (hm_w₀ : ∀ m ∈ IsLocalRing.maximalIdeal R,
      Ideal.Quotient.mk _ (MvPolynomial.C m) ∈ (e_nod₀.base w₀).asIdeal) :
    ∃ (B_W : Type u) (_ : CommRing B_W)
      (c_W : R →+* B_W) (u₀ u₁ : B_W) (q_W : PrimeSpectrum B_W)
      (j_W : AlgebraicGeometry.Spec (CommRingCat.of B_W) ⟶ W')
      (ψ₀ : Polynomial R →+* (B_W ⧸ Ideal.span {u₁}))
      (ψ₁ : Polynomial R →+* (B_W ⧸ Ideal.span {u₀}))
      (σ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_W)),
      AlgebraicGeometry.IsOpenImmersion j_W ∧
      j_W.base q_W = w₀ ∧
      j_W ≫ e_nod₀ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) ∧
      u₀ ∈ q_W.asIdeal ∧
      u₁ ∈ q_W.asIdeal ∧
      (∀ m ∈ IsLocalRing.maximalIdeal R, c_W m ∈ q_W.asIdeal) ∧
      u₀ * u₁ = 0 ∧
      IsDomain (B_W ⧸ Ideal.span {u₁}) ∧
      IsDomain (B_W ⧸ Ideal.span {u₀}) ∧
      (∀ r : R, r ≠ 0 → c_W r ∉ Ideal.span {u₁} ∧ c_W r ∉ Ideal.span {u₀}) ∧
      ψ₀.Etale ∧
      ψ₀.comp Polynomial.C = (Ideal.Quotient.mk _).comp c_W ∧
      ψ₀ Polynomial.X = Ideal.Quotient.mk _ u₀ ∧
      ψ₁.Etale ∧
      ψ₁.comp Polynomial.C = (Ideal.Quotient.mk _).comp c_W ∧
      ψ₁ Polynomial.X = Ideal.Quotient.mk _ u₁ ∧
      σ_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) ∧
      (∀ b : AlgebraicGeometry.Spec (CommRingCat.of R),
        b.asIdeal = IsLocalRing.maximalIdeal R → σ_W.base b = q_W) ∧
      (∀ b : AlgebraicGeometry.Spec (CommRingCat.of R),
        u₀ ∈ (σ_W.base b).asIdeal ∧ u₁ ∈ (σ_W.base b).asIdeal) :=
by
  
  let A_nod : Type u :=
    MvPolynomial (Fin 2) R ⧸
      (Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1} : Ideal (MvPolynomial (Fin 2) R))
  letI : CommRing A_nod := inferInstance
  let ι_R : R →+* A_nod := (Ideal.Quotient.mk _).comp MvPolynomial.C
  obtain ⟨U₀, hU₀, hw₀_U₀, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w₀) (U := (⊤ : W'.Opens)) trivial
  let B₀ : Type u := ↑(W'.presheaf.obj (Opposite.op U₀))
  letI : CommRing B₀ := inferInstance
  let j₀ : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ W' := hU₀.fromSpec
  have hOpen_j₀ : AlgebraicGeometry.IsOpenImmersion j₀ := hU₀.isOpenImmersion_fromSpec
  haveI : AlgebraicGeometry.IsOpenImmersion j₀ := hOpen_j₀
  haveI : AlgebraicGeometry.Etale e_nod₀ := hEt_nod₀
  let q₀ : PrimeSpectrum B₀ := hU₀.isoSpec.hom.base ⟨w₀, hw₀_U₀⟩
  have hj₀_q₀ : j₀.base q₀ = w₀ := by
    have h_eq : hU₀.isoSpec.hom ≫ j₀ = U₀.ι := by
      dsimp [j₀]
      rw [← hU₀.isoSpec_inv_ι, ← CategoryTheory.Category.assoc,
        hU₀.isoSpec.hom_inv_id, CategoryTheory.Category.id_comp]
    exact congrArg (fun f => f.base ⟨w₀, hw₀_U₀⟩) h_eq
  let φ₀ : A_nod →+* B₀ := (AlgebraicGeometry.Spec.preimage (j₀ ≫ e_nod₀)).hom
  have hj₀_e : j₀ ≫ e_nod₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) := by
    symm
    exact AlgebraicGeometry.Spec.map_preimage (j₀ ≫ e_nod₀)
  have hEt_φ₀ : φ₀.Etale := by
    have hEt_comp : AlgebraicGeometry.Etale (j₀ ≫ e_nod₀) := inferInstance
    rw [hj₀_e] at hEt_comp
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_comp
  have hMem_q₀ : ∀ a : A_nod, a ∈ (e_nod₀.base w₀).asIdeal ↔ φ₀ a ∈ q₀.asIdeal := by
    intro a
    have h_ev := congrArg (fun f => f.base q₀) hj₀_e
    have h_lhs : (j₀ ≫ e_nod₀).base q₀ = e_nod₀.base (j₀.base q₀) := rfl
    rw [h_lhs, hj₀_q₀] at h_ev
    rw [h_ev]
    exact Ideal.mem_comap
  let x₀ : B₀ := φ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
  let x₁ : B₀ := φ₀ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
  have hx₀ : x₀ ∈ q₀.asIdeal := (hMem_q₀ _).mp (hX_w₀ 0)
  have hx₁ : x₁ ∈ q₀.asIdeal := (hMem_q₀ _).mp (hX_w₀ 1)
  have hm₀ : ∀ m ∈ IsLocalRing.maximalIdeal R, φ₀ (ι_R m) ∈ q₀.asIdeal :=
    fun m hm => (hMem_q₀ _).mp (hm_w₀ m hm)

  
  have hQL_dom : ∀ (S : Type u) [CommRing S] (x g : S),
      IsDomain (Localization.Away (Ideal.Quotient.mk (Ideal.span ({x} : Set S)) g)) →
      IsDomain (Localization.Away g ⧸
        Ideal.span ({algebraMap S (Localization.Away g) x} : Set (Localization.Away g))) := by
    intro S _ x g hDom_bar
    let I : Ideal S := Ideal.span ({x} : Set S)
    let π_S : S →+* (S ⧸ I) := Ideal.Quotient.mk I
    let g_bar : S ⧸ I := π_S g
    let L : Type u := Localization.Away g
    letI : CommRing L := inferInstance
    let loc_S : S →+* L := algebraMap S L
    let J : Ideal L := Ideal.span ({loc_S x} : Set L)
    let π_L : L →+* (L ⧸ J) := Ideal.Quotient.mk J
    let L_bar : Type u := Localization.Away g_bar
    letI : CommRing L_bar := inferInstance
    let loc_bar : (S ⧸ I) →+* L_bar := algebraMap (S ⧸ I) L_bar
    have hUnit_bar : IsUnit ((loc_bar.comp π_S) g) :=
      IsLocalization.Away.algebraMap_isUnit (S := L_bar) g_bar
    obtain ⟨α_tilde, hα_tilde⟩ : ∃ f : L →+* L_bar, ∀ s : S, f (loc_S s) = loc_bar (π_S s) :=
      ⟨IsLocalization.Away.lift g hUnit_bar, IsLocalization.Away.lift_eq g hUnit_bar⟩
    have hJ_ker : ∀ y ∈ J, α_tilde y = 0 := by
      intro y hy
      rcases Ideal.mem_span_singleton.mp hy with ⟨z, rfl⟩
      rw [map_mul, hα_tilde x]
      have hx0 : π_S x = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [hx0, map_zero, zero_mul]
    let α : (L ⧸ J) →+* L_bar := Ideal.Quotient.lift J α_tilde hJ_ker
    have hα_apply : ∀ z : L, α (π_L z) = α_tilde z := fun _ => rfl
    have hI_ker : ∀ a ∈ I, (π_L.comp loc_S) a = 0 := by
      intro a ha
      rcases Ideal.mem_span_singleton.mp ha with ⟨c, rfl⟩
      change π_L (loc_S (x * c)) = 0
      rw [map_mul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (Ideal.mul_mem_right (loc_S c) J (Ideal.subset_span rfl))
    let β₀ : (S ⧸ I) →+* (L ⧸ J) := Ideal.Quotient.lift I (π_L.comp loc_S) hI_ker
    have hβ₀_apply : ∀ s : S, β₀ (π_S s) = π_L (loc_S s) := fun _ => rfl
    have hUnit_L : IsUnit (β₀ g_bar) := by
      change IsUnit (β₀ (π_S g))
      rw [hβ₀_apply g]
      exact (IsLocalization.Away.algebraMap_isUnit (S := L) g).map π_L
    obtain ⟨β, hβ⟩ : ∃ f : L_bar →+* (L ⧸ J), ∀ y : S ⧸ I, f (loc_bar y) = β₀ y :=
      ⟨IsLocalization.Away.lift g_bar hUnit_L, IsLocalization.Away.lift_eq g_bar hUnit_L⟩
    have hαβ : α.comp β = RingHom.id L_bar := by
      apply IsLocalization.ringHom_ext (Submonoid.powers g_bar)
      apply Ideal.Quotient.ringHom_ext
      ext s
      change α (β (loc_bar (π_S s))) = loc_bar (π_S s)
      rw [hβ (π_S s), hβ₀_apply s, hα_apply (loc_S s), hα_tilde s]
    have hβα : β.comp α = RingHom.id (L ⧸ J) := by
      apply Ideal.Quotient.ringHom_ext
      apply IsLocalization.ringHom_ext (Submonoid.powers g)
      ext s
      change β (α (π_L (loc_S s))) = π_L (loc_S s)
      rw [hα_apply (loc_S s), hα_tilde s, hβ (π_S s), hβ₀_apply s]
    let e_ql : (L ⧸ J) ≃+* L_bar := RingEquiv.ofRingHom α β hαβ hβα
    exact @MulEquiv.isDomain (L ⧸ J) L_bar _ _ hDom_bar e_ql.toMulEquiv

  
  have hShrinkAxis : ∀ (B : Type u) [CommRing B] (q : PrimeSpectrum B) (u : B),
      u ∈ q.asIdeal →
      (∃ ψ : Polynomial R →+* (B ⧸ Ideal.span ({u} : Set B)), ψ.Etale) →
      ∃ (g : B) (q' : PrimeSpectrum (Localization.Away g)),
        g ∉ q.asIdeal ∧
        PrimeSpectrum.comap (algebraMap B (Localization.Away g)) q' = q ∧
        IsDomain (Localization.Away g ⧸
          Ideal.span ({algebraMap B (Localization.Away g) u} : Set (Localization.Away g))) := by
    intro B _ q u hu ⟨ψ, hEt_ψ⟩
    let I_u : Ideal B := Ideal.span ({u} : Set B)
    let π_u : B →+* (B ⧸ I_u) := Ideal.Quotient.mk I_u
    have hSurj_π : Function.Surjective π_u := Ideal.Quotient.mk_surjective
    have hKer_le : RingHom.ker π_u ≤ q.asIdeal := by
      rw [Ideal.mk_ker, Ideal.span_singleton_le_iff_mem]
      exact hu
    have hPrime_bar : (Ideal.map π_u q.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective hSurj_π hKer_le
    let q_bar : PrimeSpectrum (B ⧸ I_u) := ⟨Ideal.map π_u q.asIdeal, hPrime_bar⟩
    have hComap_bar : Ideal.comap π_u q_bar.asIdeal = q.asIdeal := by
      dsimp [q_bar]
      rw [Ideal.comap_map_of_surjective π_u hSurj_π]
      have hker : Ideal.comap π_u ⊥ = RingHom.ker π_u := rfl
      rw [hker]
      exact sup_eq_left.mpr hKer_le
    obtain ⟨g_bar, hg_bar_not, hDom_gbar⟩ :
        ∃ g_bar : B ⧸ I_u, g_bar ∉ q_bar.asIdeal ∧ IsDomain (Localization.Away g_bar) := by
      letI : Algebra (Polynomial R) (B ⧸ I_u) := ψ.toAlgebra
      haveI : Algebra.Etale (Polynomial R) (B ⧸ I_u) := RingHom.etale_algebraMap.mp hEt_ψ
      exact hEtDom (Polynomial R) (B ⧸ I_u) q_bar
    obtain ⟨g, rfl⟩ := hSurj_π g_bar
    have hg_not : g ∉ q.asIdeal := by
      rw [← hComap_bar, Ideal.mem_comap]
      exact hg_bar_not
    have hq_mem : q ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum B)) := by
      simpa [PrimeSpectrum.mem_basicOpen] using hg_not
    rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away g) g] at hq_mem
    obtain ⟨q', hq'_comap⟩ := hq_mem
    exact ⟨g, q', hg_not, hq'_comap, hQL_dom B u g hDom_gbar⟩

  
  obtain ⟨_, _, ⟨ψ₀_init, hEt_ψ₀_init, _, _⟩, _, _⟩ := hNodSplit R B₀ φ₀ hEt_φ₀
  obtain ⟨g₁, q₁, _hg₁_not, hq₁_comap, hDom_D₁⟩ :=
    hShrinkAxis B₀ q₀ x₁ hx₁ ⟨ψ₀_init, hEt_ψ₀_init⟩
  let B₁ : Type u := Localization.Away g₁
  letI : CommRing B₁ := inferInstance
  let loc₁ : B₀ →+* B₁ := algebraMap B₀ B₁
  let φ₁ : A_nod →+* B₁ := loc₁.comp φ₀
  have hEt_φ₁ : φ₁.Etale := by
    have hEt_s0 : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_φ₀
    haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) := hEt_s0
    have hEt_comp : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) := inferInstance
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) := by
      dsimp [φ₁]
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    rw [← hmap] at hEt_comp
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_comp
  have hq₁_ideal : Ideal.comap loc₁ q₁.asIdeal = q₀.asIdeal :=
    congrArg PrimeSpectrum.asIdeal hq₁_comap
  have hx₀_1 : loc₁ x₀ ∈ q₁.asIdeal := by
    rw [← Ideal.mem_comap, hq₁_ideal]; exact hx₀
  have hx₁_1 : loc₁ x₁ ∈ q₁.asIdeal := by
    rw [← Ideal.mem_comap, hq₁_ideal]; exact hx₁

  
  obtain ⟨_, _, _, ⟨ψ₁_mid, hEt_ψ₁_mid, _, _⟩, _⟩ := hNodSplit R B₁ φ₁ hEt_φ₁
  obtain ⟨g₂, q_W, hg₂_not, hqW_comap₂, hDom0⟩ :=
    hShrinkAxis B₁ q₁ (loc₁ x₀) hx₀_1 ⟨ψ₁_mid, hEt_ψ₁_mid⟩
  let B_W : Type u := Localization.Away g₂
  letI : CommRing B_W := inferInstance
  let loc₂ : B₁ →+* B_W := algebraMap B₁ B_W
  let loc_W : B₀ →+* B_W := loc₂.comp loc₁
  let φ_W : A_nod →+* B_W := loc_W.comp φ₀
  have hEt_φW : φ_W.Etale := by
    have hEt_s1 : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_φ₁
    haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) := hEt_s1
    have hEt_comp : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc₂) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁)) := inferInstance
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_W) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc₂) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (loc₂.comp φ₁)) = _
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    rw [← hmap] at hEt_comp
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_comp
  have hqW_comap : PrimeSpectrum.comap loc_W q_W = q₀ := by
    dsimp [loc_W]
    rw [hqW_comap₂, hq₁_comap]
  have hqW_ideal : Ideal.comap loc_W q_W.asIdeal = q₀.asIdeal :=
    congrArg PrimeSpectrum.asIdeal hqW_comap

  let c_W : R →+* B_W := φ_W.comp ι_R
  let u₀ : B_W := φ_W (Ideal.Quotient.mk _ (MvPolynomial.X 0))
  let u₁ : B_W := φ_W (Ideal.Quotient.mk _ (MvPolynomial.X 1))

  
  have hDom1 : IsDomain (B_W ⧸ Ideal.span ({u₁} : Set B_W)) := by
    let D₁ : Type u := B₁ ⧸ Ideal.span ({loc₁ x₁} : Set B₁)
    haveI : IsDomain D₁ := hDom_D₁
    let π_D₁ : B₁ →+* D₁ := Ideal.Quotient.mk (Ideal.span ({loc₁ x₁} : Set B₁))
    let g_tilde₂ : D₁ := π_D₁ g₂
    have hg_tilde_ne : g_tilde₂ ≠ 0 := by
      intro h0
      have hg₂_span : g₂ ∈ Ideal.span ({loc₁ x₁} : Set B₁) :=
        Ideal.Quotient.eq_zero_iff_mem.mp h0
      have h_le : Ideal.span ({loc₁ x₁} : Set B₁) ≤ q₁.asIdeal := by
        rw [Ideal.span_singleton_le_iff_mem]
        exact hx₁_1
      exact hg₂_not (h_le hg₂_span)
    have hPowers_le : Submonoid.powers g_tilde₂ ≤ nonZeroDivisors D₁ := by
      intro y hy
      rw [Submonoid.mem_powers_iff] at hy
      rcases hy with ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hg_tilde_ne)
    have hDom_loc : IsDomain (Localization.Away g_tilde₂) :=
      IsLocalization.isDomain_localization hPowers_le
    exact hQL_dom B₁ (loc₁ x₁) g₂ hDom_loc

  
  obtain ⟨hu_mul, _hInf_bot, ⟨ψ₀, hEt_ψ₀, hψ₀_C, hψ₀_X⟩, ⟨ψ₁, hEt_ψ₁, hψ₁_C, hψ₁_X⟩, hEt_orig⟩ :=
    hNodSplit R B_W φ_W hEt_φW

  have hu₀_qW : u₀ ∈ q_W.asIdeal := by
    change loc_W x₀ ∈ q_W.asIdeal
    rw [← Ideal.mem_comap, hqW_ideal]; exact hx₀
  have hu₁_qW : u₁ ∈ q_W.asIdeal := by
    change loc_W x₁ ∈ q_W.asIdeal
    rw [← Ideal.mem_comap, hqW_ideal]; exact hx₁
  have hm_qW : ∀ m ∈ IsLocalRing.maximalIdeal R, c_W m ∈ q_W.asIdeal := by
    intro m hm
    change loc_W (φ₀ (ι_R m)) ∈ q_W.asIdeal
    rw [← Ideal.mem_comap, hqW_ideal]; exact hm₀ m hm

  
  have hTorsFree : ∀ (u : B_W) (hu : u ∈ q_W.asIdeal)
      (ψ : Polynomial R →+* (B_W ⧸ Ideal.span ({u} : Set B_W))),
      ψ.Etale →
      ψ.comp Polynomial.C = (Ideal.Quotient.mk (Ideal.span ({u} : Set B_W))).comp c_W →
      ∀ r : R, r ≠ 0 → c_W r ∉ Ideal.span ({u} : Set B_W) := by
    intro u hu ψ hEt_ψ hψ_C r hr hmem
    let I_u : Ideal B_W := Ideal.span ({u} : Set B_W)
    let D : Type u := B_W ⧸ I_u
    letI : CommRing D := inferInstance
    letI : Algebra (Polynomial R) D := ψ.toAlgebra
    letI : Algebra R D := (ψ.comp Polynomial.C).toAlgebra
    haveI : IsScalarTower R (Polynomial R) D :=
      IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale (Polynomial R) D := RingHom.etale_algebraMap.mp hEt_ψ
    haveI : Module.Flat (Polynomial R) D := Algebra.Smooth.flat (Polynomial R) D
    haveI : Module.Flat R D := Module.Flat.trans R (Polynomial R) D
    have hTF : Module.IsTorsionFree R D :=
      (Submodule.isTorsionFree_iff_torsion_eq_bot (R := R) (M := D)).mpr
        (Module.Flat.torsion_eq_bot (R := R) (M := D))
    have h1_ne : (1 : D) ≠ 0 := by
      intro h10
      have h1_mem : (1 : B_W) ∈ I_u := Ideal.Quotient.eq_zero_iff_mem.mp h10
      have hIu_le : I_u ≤ q_W.asIdeal := by
        dsimp [I_u]
        rw [Ideal.span_singleton_le_iff_mem]
        exact hu
      exact q_W.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ (hIu_le h1_mem) isUnit_one)
    have hsmul0 : r • (1 : D) = 0 := by
      rw [Algebra.smul_def, mul_one]
      change (ψ.comp Polynomial.C) r = 0
      rw [hψ_C]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rcases (Module.isTorsionFree_iff_smul_eq_zero (R := R) (M := D)).mp hTF r 1 hsmul0 with rfl | h10
    · exact hr rfl
    · exact h1_ne h10

  
  let I₀₁ : Ideal B_W := Ideal.span ({u₀, u₁} : Set B_W)
  let D_orig : Type u := B_W ⧸ I₀₁
  letI : CommRing D_orig := inferInstance
  let π₀₁ : B_W →+* D_orig := Ideal.Quotient.mk I₀₁
  let c_orig : R →+* D_orig := π₀₁.comp c_W
  have hI₀₁_le : I₀₁ ≤ q_W.asIdeal := by
    rw [Ideal.span_le]
    intro x hx
    rcases hx with rfl | rfl
    · exact hu₀_qW
    · exact hu₁_qW
  have hKer₀₁_le : RingHom.ker π₀₁ ≤ q_W.asIdeal := by
    rw [Ideal.mk_ker]; exact hI₀₁_le
  have hSurj_π₀₁ : Function.Surjective π₀₁ := Ideal.Quotient.mk_surjective
  let q_orig : PrimeSpectrum D_orig :=
    ⟨Ideal.map π₀₁ q_W.asIdeal, Ideal.map_isPrime_of_surjective hSurj_π₀₁ hKer₀₁_le⟩
  have hComap_orig : Ideal.comap π₀₁ q_orig.asIdeal = q_W.asIdeal := by
    dsimp [q_orig]
    rw [Ideal.comap_map_of_surjective π₀₁ hSurj_π₀₁]
    have hker : Ideal.comap π₀₁ ⊥ = RingHom.ker π₀₁ := rfl
    rw [hker]
    exact sup_eq_left.mpr hKer₀₁_le
  have hSpec_orig : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀₁)).base q_orig = q_W :=
    PrimeSpectrum.ext hComap_orig
  let f_orig : AlgebraicGeometry.Spec (CommRingCat.of D_orig) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_orig)
  have hEt_forig : AlgebraicGeometry.Etale f_orig :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_orig
  have hMax_orig : (f_orig.base q_orig).asIdeal = IsLocalRing.maximalIdeal R := by
    apply le_antisymm
    · exact IsLocalRing.le_maximalIdeal (f_orig.base q_orig).isPrime.ne_top
    · intro m hm
      change c_orig m ∈ q_orig.asIdeal
      change π₀₁ (c_W m) ∈ q_orig.asIdeal
      rw [← Ideal.mem_comap, hComap_orig]
      exact hm_qW m hm
  obtain ⟨σ_orig, hσ_orig_sec, hσ_orig_max⟩ :=
    hEtSec (AlgebraicGeometry.Spec (CommRingCat.of D_orig)) f_orig hEt_forig q_orig hMax_orig
  let σ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B_W) :=
    σ_orig ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀₁)

  
  have hOpen_locW : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_W)) := by
    have hmap : AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_W) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc₂) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc₁) := by
      dsimp [loc_W]
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    rw [hmap]
    exact inferInstance
  haveI : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_W)) := hOpen_locW
  let j_W : AlgebraicGeometry.Spec (CommRingCat.of B_W) ⟶ W' :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_W) ≫ j₀
  have hOpen_jW : AlgebraicGeometry.IsOpenImmersion j_W := inferInstance
  have hjW_qW : j_W.base q_W = w₀ := by
    change j₀.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_W)).base q_W) = w₀
    have hloc_qW : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_W)).base q_W = q₀ := by
      apply PrimeSpectrum.ext
      exact hqW_ideal
    rw [hloc_qW, hj₀_q₀]
  have hjW_comm : j_W ≫ e_nod₀ ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) := by
    dsimp only [j_W]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j₀, hj₀_e]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_W) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W)
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  refine ⟨B_W, inferInstance, c_W, u₀, u₁, q_W, j_W, ψ₀, ψ₁, σ_W,
    hOpen_jW, hjW_qW, hjW_comm, hu₀_qW, hu₁_qW, hm_qW,
    hu_mul, hDom1, hDom0, ?_,
    hEt_ψ₀, hψ₀_C, hψ₀_X, hEt_ψ₁, hψ₁_C, hψ₁_X,
    ?_, ?_, ?_⟩
  · intro r hr
    exact ⟨hTorsFree u₁ hu₁_qW ψ₀ hEt_ψ₀ hψ₀_C r hr,
      hTorsFree u₀ hu₀_qW ψ₁ hEt_ψ₁ hψ₁_C r hr⟩
  · dsimp only [σ_W]
    have hf_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀₁) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) = f_orig := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [CategoryTheory.Category.assoc, hf_eq, hσ_orig_sec]
  · intro b hb
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₀₁)).base (σ_orig.base b) = q_W
    rw [hσ_orig_max b hb, hSpec_orig]
  · intro b
    have hu₀_I : u₀ ∈ I₀₁ := Ideal.subset_span (by simp)
    have hu₁_I : u₁ ∈ I₀₁ := Ideal.subset_span (by simp)
    have hπu₀ : π₀₁ u₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hu₀_I
    have hπu₁ : π₀₁ u₁ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hu₁_I
    refine ⟨?_, ?_⟩
    · change π₀₁ u₀ ∈ (σ_orig.base b).asIdeal
      rw [hπu₀]; exact (σ_orig.base b).asIdeal.zero_mem
    · change π₀₁ u₁ ∈ (σ_orig.base b).asIdeal
      rw [hπu₁]; exact (σ_orig.base b).asIdeal.zero_mem

theorem weil_split_nodal_chart_closure_pullback_branch_ideal (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (K_R : Type u) [Field K_R] [Algebra R K_R]
    (s_R : R) (hsR : s_R ≠ 0) [IsLocalization.Away s_R K_R]
    (hEtDom : ∀ (A₀ B₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B₀] [Algebra A₀ B₀] [Algebra.Etale A₀ B₀]
        (q : PrimeSpectrum B₀),
      ∃ g : B₀, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (E : Set ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))))
    (E_sch : AlgebraicGeometry.Scheme.{u})
    (ι_E : E_sch ⟶ CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))))
    (hCl_ιE : AlgebraicGeometry.IsClosedImmersion ι_E)
    (hRange_ιE : Set.range ι_E.base = E)
    (hClosed_E : IsClosed E)
    (hP1_E : ∃ isoP1 : E_sch ≅ (weilProjectiveSpaceOver K_R 1).left,
      ι_E ≫ CategoryTheory.Limits.pullback.snd g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) =
        isoP1.hom ≫ (weilProjectiveSpaceOver K_R 1).hom)
    (Y'_K : Set ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))))
    (hClosed_Y'K : IsClosed Y'_K)
    (hUnion_XK : E ∪ Y'_K = Set.univ)
    (hNotSubE : ∀ O : Set ↥(CategoryTheory.Limits.pullback g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))),
      IsOpen O → (O ∩ Y'_K).Nonempty → ¬ (O ⊆ E))
    (hNotSubY' : ∀ O : Set ↥(CategoryTheory.Limits.pullback g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))),
      IsOpen O → (O ∩ E).Nonempty → ¬ (O ⊆ Y'_K))
    (E_bar : AlgebraicGeometry.Scheme.{u})
    (ι_Ebar_C : E_bar ⟶ C_R)
    (g_Ebar : E_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (j_to : E_sch ⟶ E_bar)
    (hComm_Ebar : ι_Ebar_C ≫ g_R = g_Ebar)
    (hCl_EbarC : AlgebraicGeometry.IsClosedImmersion ι_Ebar_C)
    (hFlat_gEbar : AlgebraicGeometry.Flat g_Ebar)
    (hPb_gen : CategoryTheory.IsPullback ι_E j_to
      (CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))) ι_Ebar_C)
    (B_W : Type u) [CommRing B_W]
    (c_W : R →+* B_W) (u₀ u₁ : B_W) (q_W : PrimeSpectrum B_W)
    (f_C : AlgebraicGeometry.Spec (CommRingCat.of B_W) ⟶ C_R)
    (hEt_fC : AlgebraicGeometry.Etale f_C)
    (hfC_comm : f_C ≫ g_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W))
    (hqW_E : f_C.base q_W ∈ closure
      ((CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))).base '' E))
    (hqW_Y' : f_C.base q_W ∈ closure
      ((CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))).base '' Y'_K))
    (hu_mul : u₀ * u₁ = 0)
    (hDom1 : IsDomain (B_W ⧸ Ideal.span {u₁}))
    (hDom0 : IsDomain (B_W ⧸ Ideal.span {u₀}))
    (hsR_u1 : c_W s_R ∉ Ideal.span {u₁})
    (hsR_u0 : c_W s_R ∉ Ideal.span {u₀}) :
    let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))
    (∀ (σ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B_W)),
      σ_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) →
      (∀ b : AlgebraicGeometry.Spec (CommRingCat.of R),
        u₀ ∈ (σ_W.base b).asIdeal ∧ u₁ ∈ (σ_W.base b).asIdeal) →
      ∀ (hw : (η_R ≫ (σ_W ≫ f_C)) ≫ g_R =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R)) ≫ η_R)
        (pt_K : AlgebraicGeometry.Spec (CommRingCat.of K_R)),
        (CategoryTheory.Limits.pullback.lift (η_R ≫ (σ_W ≫ f_C))
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R))) hw).base pt_K ∈ E ∧
        (CategoryTheory.Limits.pullback.lift (η_R ≫ (σ_W ≫ f_C))
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R))) hw).base pt_K ∈ Y'_K) ∧
    (∃ (a : Fin 2)
        (e_Pa : AlgebraicGeometry.Spec (CommRingCat.of
          (B_W ⧸ Ideal.span {if a = 0 then u₀ else u₁})) ≅
          CategoryTheory.Limits.pullback ι_Ebar_C f_C),
      e_Pa.hom ≫ CategoryTheory.Limits.pullback.snd ι_Ebar_C f_C =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {if a = 0 then u₀ else u₁})))) :=
by
  classical
  intro η_R
  let X_K : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g_R η_R
  let fst_K : X_K ⟶ C_R := CategoryTheory.Limits.pullback.fst g_R η_R
  let snd_K : X_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K_R) :=
    CategoryTheory.Limits.pullback.snd g_R η_R
  let M_R : Submonoid R := Submonoid.powers s_R
  let M_W : Submonoid B_W := Submonoid.map c_W M_R
  let B_K : Type u := Localization M_W
  let loc_K : B_W →+* B_K := algebraMap B_W B_K
  let loc_Spec : AlgebraicGeometry.Spec (CommRingCat.of B_K) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B_W) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_K)

  
  
  
  haveI : IsLocalization M_R K_R := ‹IsLocalization.Away s_R K_R›
  let f_loc : K_R →+* B_K :=
    IsLocalization.lift (M := M_R) (g := loc_K.comp c_W)
      (fun y => IsLocalization.map_units B_K ⟨c_W y.1, Submonoid.mem_map_of_mem c_W y.2⟩)
  have hf_comp : f_loc.comp (algebraMap R K_R) = loc_K.comp c_W :=
    IsLocalization.lift_comp _
  have hPush_loc : CategoryTheory.IsPushout
      (CommRingCat.ofHom c_W) (CommRingCat.ofHom (algebraMap R K_R))
      (CommRingCat.ofHom loc_K) (CommRingCat.ofHom f_loc) :=
    CommRingCat.isPushout_of_isLocalization c_W f_loc hf_comp M_R
  let s_BK : AlgebraicGeometry.Spec (CommRingCat.of B_K) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of K_R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_loc)
  have hPb_loc : CategoryTheory.IsPullback loc_Spec s_BK
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W)) η_R :=
    AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_loc

  have hw_CK : (loc_Spec ≫ f_C) ≫ g_R = s_BK ≫ η_R := by
    rw [CategoryTheory.Category.assoc, hfC_comm]
    exact hPb_loc.w
  let f_CK : AlgebraicGeometry.Spec (CommRingCat.of B_K) ⟶ X_K :=
    CategoryTheory.Limits.pullback.lift (loc_Spec ≫ f_C) s_BK hw_CK
  have hfCK_fst : f_CK ≫ fst_K = loc_Spec ≫ f_C :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hfCK_snd : f_CK ≫ snd_K = s_BK :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_fCK : CategoryTheory.IsPullback f_CK loc_Spec fst_K f_C := by
    have hOuter : CategoryTheory.IsPullback (f_CK ≫ snd_K) loc_Spec η_R (f_C ≫ g_R) := by
      rw [hfCK_snd, hfC_comm]
      exact hPb_loc.flip
    exact CategoryTheory.IsPullback.of_right hOuter hfCK_fst
      (CategoryTheory.IsPullback.of_hasPullback g_R η_R).flip
  haveI : AlgebraicGeometry.Etale f_C := hEt_fC
  have hEt_fCK : AlgebraicGeometry.Etale f_CK :=
    CategoryTheory.MorphismProperty.of_isPullback hPb_fCK.flip hEt_fC
  haveI : AlgebraicGeometry.Etale f_CK := hEt_fCK

  have hAxisPrime : ∀ (u : B_W),
      IsDomain (B_W ⧸ Ideal.span {u}) →
      c_W s_R ∉ Ideal.span {u} →
      (Ideal.span {u}).IsPrime ∧
      Disjoint (M_W : Set B_W) (Ideal.span {u} : Set B_W) ∧
      (Ideal.span {loc_K u}).IsPrime ∧
      Ideal.comap loc_K (Ideal.span {loc_K u}) = Ideal.span {u} := by
    intro u hDom hsR_u
    have hPr : (Ideal.span {u}).IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp hDom
    have hDisj : Disjoint (M_W : Set B_W) (Ideal.span {u} : Set B_W) := by
      rw [Set.disjoint_left]
      rintro _ ⟨r_m, ⟨k, rfl⟩, rfl⟩ hmem
      have hpow : (c_W s_R) ^ k ∈ Ideal.span {u} := by simpa [map_pow] using hmem
      exact hsR_u (hPr.mem_of_pow_mem k hpow)
    have hMapEq : Ideal.map loc_K (Ideal.span {u}) = Ideal.span {loc_K u} := by
      rw [Ideal.map_span, Set.image_singleton]
    have hPrK : (Ideal.span {loc_K u}).IsPrime := by
      rw [← hMapEq]
      exact IsLocalization.isPrime_of_isPrime_disjoint M_W B_K (Ideal.span {u}) hPr hDisj
    have hComap : Ideal.comap loc_K (Ideal.span {loc_K u}) = Ideal.span {u} := by
      rw [← hMapEq]
      exact IsLocalization.under_map_of_isPrime_disjoint M_W B_K hPr hDisj
    exact ⟨hPr, hDisj, hPrK, hComap⟩

  
  
  
  obtain ⟨_, _, hPrK0, _⟩ := hAxisPrime u₀ hDom0 hsR_u0
  obtain ⟨_, _, hPrK1, _⟩ := hAxisPrime u₁ hDom1 hsR_u1
  let p₀ : PrimeSpectrum B_K := ⟨Ideal.span {loc_K u₀}, hPrK0⟩
  let p₁ : PrimeSpectrum B_K := ⟨Ideal.span {loc_K u₁}, hPrK1⟩
  have hCover_BK : ∀ P : PrimeSpectrum B_K,
      loc_K u₀ ∈ P.asIdeal ∨ loc_K u₁ ∈ P.asIdeal := by
    intro P
    have hmul0 : loc_K u₀ * loc_K u₁ ∈ P.asIdeal := by
      rw [← map_mul, hu_mul, map_zero]
      exact P.asIdeal.zero_mem
    exact P.isPrime.mul_mem_iff_mem_or_mem.mp hmul0
  have hSubCl : ∀ (u : B_W) (hPrK : (Ideal.span {loc_K u}).IsPrime)
      (S : Set ↥X_K), IsClosed S →
      f_CK.base (⟨Ideal.span {loc_K u}, hPrK⟩ : PrimeSpectrum B_K) ∈ S →
      ∀ P : PrimeSpectrum B_K, loc_K u ∈ P.asIdeal → f_CK.base P ∈ S := by
    intro u hPrK S hClosedS hpS P huP
    let p_u : ↥(AlgebraicGeometry.Spec (CommRingCat.of B_K)) := ⟨Ideal.span {loc_K u}, hPrK⟩
    have hle : p_u.asIdeal ≤ P.asIdeal := by
      change Ideal.span {loc_K u} ≤ P.asIdeal
      rwa [Ideal.span_singleton_le_iff_mem]
    have hcl : (P : ↥(AlgebraicGeometry.Spec (CommRingCat.of B_K))) ∈
        closure ({p_u} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B_K))) :=
      (PrimeSpectrum.le_iff_mem_closure p_u P).mp hle
    have hClosedPre : IsClosed (f_CK.base ⁻¹' S) := hClosedS.preimage f_CK.continuous
    have hp_pre : ({p_u} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B_K))) ⊆
        f_CK.base ⁻¹' S := Set.singleton_subset_iff.mpr hpS
    exact closure_minimal hp_pre hClosedPre hcl

  haveI : AlgebraicGeometry.UniversallyOpen f_C :=
    AlgebraicGeometry.UniversallyOpen.of_flat f_C
  haveI : AlgebraicGeometry.UniversallyOpen f_CK :=
    AlgebraicGeometry.UniversallyOpen.of_flat f_CK
  let U_C : Set ↥C_R := Set.range f_C.base
  have hOpen_UC : IsOpen U_C := f_C.isOpenMap.isOpen_range
  let O_K : Set ↥X_K := fst_K.base ⁻¹' U_C
  have hOpen_OK : IsOpen O_K := hOpen_UC.preimage fst_K.continuous
  have hOK_E_ne : (O_K ∩ E).Nonempty := by
    rcases mem_closure_iff.mp hqW_E U_C hOpen_UC ⟨q_W, rfl⟩ with ⟨_, hUC, y, hyE, rfl⟩
    exact ⟨y, hUC, hyE⟩
  have hOK_Y'_ne : (O_K ∩ Y'_K).Nonempty := by
    rcases mem_closure_iff.mp hqW_Y' U_C hOpen_UC ⟨q_W, rfl⟩ with ⟨_, hUC, y, hyY', rfl⟩
    exact ⟨y, hUC, hyY'⟩
  have hOK_notSubE : ¬ (O_K ⊆ E) := hNotSubE O_K hOpen_OK hOK_Y'_ne
  have hOK_notSubY' : ¬ (O_K ⊆ Y'_K) := hNotSubY' O_K hOpen_OK hOK_E_ne
  have hOK_sub_range : O_K ⊆ Set.range f_CK.base := by
    rintro y ⟨q, hq⟩
    obtain ⟨P, hP_eq, _⟩ :=
      AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_fCK y q hq.symm
    exact ⟨P, hP_eq⟩

  have hp0_or : f_CK.base p₀ ∈ E ∨ f_CK.base p₀ ∈ Y'_K := by
    have h : f_CK.base p₀ ∈ E ∪ Y'_K := by rw [hUnion_XK]; trivial
    exact h
  have hp1_or : f_CK.base p₁ ∈ E ∨ f_CK.base p₁ ∈ Y'_K := by
    have h : f_CK.base p₁ ∈ E ∪ Y'_K := by rw [hUnion_XK]; trivial
    exact h
  have hAxisSep : ∃ a : Fin 2,
      (∀ P : PrimeSpectrum B_K, loc_K (if a = 0 then u₀ else u₁) ∈ P.asIdeal → f_CK.base P ∈ E) ∧
      (∀ P : PrimeSpectrum B_K, loc_K (if a = 0 then u₁ else u₀) ∈ P.asIdeal → f_CK.base P ∈ Y'_K) := by
    rcases hp0_or with hp0E | hp0Y'
    · rcases hp1_or with hp1E | hp1Y'
      · exfalso
        apply hOK_notSubE
        intro y hy
        rcases hOK_sub_range hy with ⟨P, rfl⟩
        rcases hCover_BK P with hP0 | hP1
        · exact hSubCl u₀ hPrK0 E hClosed_E hp0E P hP0
        · exact hSubCl u₁ hPrK1 E hClosed_E hp1E P hP1
      · refine ⟨0, ?_, ?_⟩
        · simpa using hSubCl u₀ hPrK0 E hClosed_E hp0E
        · simpa using hSubCl u₁ hPrK1 Y'_K hClosed_Y'K hp1Y'
    · rcases hp1_or with hp1E | hp1Y'
      · refine ⟨1, ?_, ?_⟩
        · simpa using hSubCl u₁ hPrK1 E hClosed_E hp1E
        · simpa using hSubCl u₀ hPrK0 Y'_K hClosed_Y'K hp0Y'
      · exfalso
        apply hOK_notSubY'
        intro y hy
        rcases hOK_sub_range hy with ⟨P, rfl⟩
        rcases hCover_BK P with hP0 | hP1
        · exact hSubCl u₀ hPrK0 Y'_K hClosed_Y'K hp0Y' P hP0
        · exact hSubCl u₁ hPrK1 Y'_K hClosed_Y'K hp1Y' P hP1
  obtain ⟨a, hVa_E, hVb_Y'⟩ := hAxisSep

  have hClaim1 : ∀ (σ_W : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_W)),
      σ_W ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) →
      (∀ b : AlgebraicGeometry.Spec (CommRingCat.of R),
        u₀ ∈ (σ_W.base b).asIdeal ∧ u₁ ∈ (σ_W.base b).asIdeal) →
      ∀ (hw : (η_R ≫ (σ_W ≫ f_C)) ≫ g_R =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R)) ≫ η_R)
        (pt_K : AlgebraicGeometry.Spec (CommRingCat.of K_R)),
        (CategoryTheory.Limits.pullback.lift (η_R ≫ (σ_W ≫ f_C))
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R))) hw).base pt_K ∈ E ∧
        (CategoryTheory.Limits.pullback.lift (η_R ≫ (σ_W ≫ f_C))
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R))) hw).base pt_K ∈ Y'_K := by
    intro σ_W hσW_sec hσW_u hw pt_K
    have hw_τ : (η_R ≫ σ_W) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_W) =
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R)) ≫ η_R := by
      rw [CategoryTheory.Category.assoc, hσW_sec, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    let τ_BK : AlgebraicGeometry.Spec (CommRingCat.of K_R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_K) :=
      hPb_loc.lift (η_R ≫ σ_W) (𝟙 _) hw_τ
    have hτ_fst : τ_BK ≫ loc_Spec = η_R ≫ σ_W := hPb_loc.lift_fst _ _ _
    have hτ_snd : τ_BK ≫ s_BK = 𝟙 _ := hPb_loc.lift_snd _ _ _
    have hLift_eq : CategoryTheory.Limits.pullback.lift (η_R ≫ (σ_W ≫ f_C))
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K_R))) hw = τ_BK ≫ f_CK := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          hfCK_fst, ← CategoryTheory.Category.assoc τ_BK, hτ_fst, CategoryTheory.Category.assoc]
      · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          hfCK_snd, hτ_snd]
    rw [hLift_eq]
    let P₀ : PrimeSpectrum B_K := τ_BK.base pt_K
    have h_ev := congrArg (fun f => f.base pt_K) hτ_fst
    have h_comap : Ideal.comap loc_K P₀.asIdeal = (σ_W.base (η_R.base pt_K)).asIdeal :=
      congrArg PrimeSpectrum.asIdeal h_ev
    have hu0_P0 : loc_K u₀ ∈ P₀.asIdeal := by
      change u₀ ∈ Ideal.comap loc_K P₀.asIdeal
      rw [h_comap]
      exact (hσW_u (η_R.base pt_K)).1
    have hu1_P0 : loc_K u₁ ∈ P₀.asIdeal := by
      change u₁ ∈ Ideal.comap loc_K P₀.asIdeal
      rw [h_comap]
      exact (hσW_u (η_R.base pt_K)).2
    have hua_P0 : loc_K (if a = 0 then u₀ else u₁) ∈ P₀.asIdeal := by
      by_cases ha : a = 0 <;> simp [ha, hu0_P0, hu1_P0]
    have hub_P0 : loc_K (if a = 0 then u₁ else u₀) ∈ P₀.asIdeal := by
      by_cases ha : a = 0 <;> simp [ha, hu0_P0, hu1_P0]
    exact ⟨hVa_E P₀ hua_P0, hVb_Y' P₀ hub_P0⟩

  let u_a : B_W := if a = 0 then u₀ else u₁
  let u_b : B_W := if a = 0 then u₁ else u₀
  have hCover_ab : ∀ P : PrimeSpectrum B_K,
      loc_K u_a ∈ P.asIdeal ∨ loc_K u_b ∈ P.asIdeal := by
    intro P
    rcases hCover_BK P with h0 | h1
    · by_cases ha : a = 0 <;> simp [u_a, u_b, ha, h0]
    · by_cases ha : a = 0 <;> simp [u_a, u_b, ha, h1]
  have hPre_ua : ∀ P : PrimeSpectrum B_K,
      f_CK.base P ∈ E ↔ loc_K u_a ∈ P.asIdeal := by
    intro P
    refine ⟨?_, hVa_E P⟩
    intro hPE
    by_contra hNotMem
    let D_a : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B_K)) :=
      (PrimeSpectrum.zeroLocus ({loc_K u_a} : Set B_K))ᶜ
    have hOpen_Da : IsOpen D_a :=
      (PrimeSpectrum.isClosed_zeroLocus ({loc_K u_a} : Set B_K)).isOpen_compl
    have hP_Da : (P : ↥(AlgebraicGeometry.Spec (CommRingCat.of B_K))) ∈ D_a := by
      change ¬ ({loc_K u_a} : Set B_K) ⊆ P.asIdeal
      rwa [Set.singleton_subset_iff]
    let U_D : Set ↥X_K := f_CK.base '' D_a
    have hOpen_UD : IsOpen U_D := f_CK.isOpenMap D_a hOpen_Da
    have hUD_E_ne : (U_D ∩ E).Nonempty := ⟨f_CK.base P, ⟨P, hP_Da, rfl⟩, hPE⟩
    have hUD_sub_Y' : U_D ⊆ Y'_K := by
      rintro _ ⟨Q, hQ_Da, rfl⟩
      have hQ_not_a : loc_K u_a ∉ Q.asIdeal := by
        intro hmem
        exact hQ_Da (Set.singleton_subset_iff.mpr hmem)
      have hQ_b : loc_K u_b ∈ Q.asIdeal := (hCover_ab Q).resolve_left hQ_not_a
      exact hVb_Y' Q hQ_b
    exact hNotSubY' U_D hOpen_UD hUD_E_ne hUD_sub_Y'

  
  
  
  have hRed_etale_P1 : ∀ (S : Type u) [CommRing S]
      (ψ : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ (weilProjectiveSpaceOver K_R 1).left),
      AlgebraicGeometry.Etale ψ → _root_.IsReduced S := by
    intro S _ ψ hEt_ψ
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) K_R
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let hX_mem : ∀ c : Fin 2, MvPolynomial.X c ∈ 𝒜 1 :=
      fun c => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K_R c)
    let U_c : Fin 2 → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun c => AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X c)
    let hAff_c : ∀ c : Fin 2, AlgebraicGeometry.IsAffineOpen (U_c c) :=
      fun c => AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜
        (MvPolynomial.X c) (hX_mem c) zero_lt_one
    have halg0 : ∀ r : K_R,
        (algebraMap K_R ↥(𝒜 0) r : MvPolynomial (Fin 2) K_R) = MvPolynomial.C r := by
      intro r
      rw [Algebra.algebraMap_eq_smul_one]
      change r • (1 : MvPolynomial (Fin 2) K_R) = MvPolynomial.C r
      rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hCov_P1 : (⨆ c : Fin 2, U_c c) = ⊤ := by
      apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X
      intro p hp
      have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hp_sum : (∑ i ∈ (DirectSum.decompose 𝒜 p).support,
          (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin 2) K_R)) = p :=
        DirectSum.sum_support_decompose 𝒜 p
      have hcoeff0 : p.coeff 0 = 0 := by
        rw [← hp_sum, MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro i _
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin 2) K_R) = 0 := hp0_proj
          rw [h0]
          simp
        · have hmem_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin 2) K_R) ∈ 𝒜 i :=
            (DirectSum.decompose 𝒜 p i).2
          have hhom_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin 2) K_R).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem_i
          by_contra hne0
          have hdeg0 := hhom_i hne0
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg0
          exact hi hdeg0.symm
      have hrange : (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K_R)) =
          MvPolynomial.X '' (Set.univ : Set (Fin 2)) := Set.image_univ.symm
      rw [hrange, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : m ≠ 0 := by
        intro hm0
        subst hm0
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      have hex : ∃ c : Fin 2, m c ≠ 0 := by
        by_contra hall
        exact hm_ne (Finsupp.ext fun c => Classical.not_not.mp fun h => hall ⟨c, h⟩)
      rcases hex with ⟨c, hc⟩
      exact ⟨c, Set.mem_univ c, hc⟩
    have hDehom : ∀ c : Fin 2,
        Nonempty (MvPolynomial {b : Fin 2 // b ≠ c} K_R ≃+*
          ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (U_c c)))) := by
      intro c
      let τ := {b : Fin 2 // b ≠ c}
      let X_c : MvPolynomial (Fin 2) K_R := MvPolynomial.X c
      let S_c : Submonoid (MvPolynomial (Fin 2) K_R) := Submonoid.powers X_c
      let ι_c : K_R →+* HomogeneousLocalization.Away 𝒜 X_c :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_c).comp (algebraMap K_R ↥(𝒜 0))
      let t_tilde : Fin 2 → HomogeneousLocalization.Away 𝒜 X_c :=
        fun j => HomogeneousLocalization.Away.mk 𝒜 (hX_mem c) 1
          (MvPolynomial.X j) (hX_mem j)
      let α : MvPolynomial τ K_R →+* HomogeneousLocalization.Away 𝒜 X_c :=
        MvPolynomial.eval₂Hom ι_c (fun b : τ => t_tilde b.1)
      let w : Fin 2 → MvPolynomial τ K_R :=
        fun j => if h : j = c then 1 else MvPolynomial.X ⟨j, h⟩
      let dehom : MvPolynomial (Fin 2) K_R →+* MvPolynomial τ K_R :=
        MvPolynomial.eval₂Hom MvPolynomial.C w
      have hdehom_Xc : dehom X_c = 1 := by simp [dehom, w, X_c]
      have hdehom_S : ∀ y : S_c, dehom y.1 = 1 := by
        rintro ⟨_, n, rfl⟩
        simp [map_pow, hdehom_Xc]
      let β_loc : Localization S_c →+* MvPolynomial τ K_R :=
        IsLocalization.lift (fun y => by rw [hdehom_S y]; exact isUnit_one)
      have hβ_loc_mk : ∀ (p : MvPolynomial (Fin 2) K_R) (y : S_c),
          β_loc (Localization.mk p y) = dehom p := by
        intro p y
        rw [Localization.mk_eq_mk']
        dsimp only [β_loc]
        rw [IsLocalization.lift_mk'_spec, hdehom_S y, one_mul]
      let valHom : HomogeneousLocalization.Away 𝒜 X_c →+* Localization S_c :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := fun u v => HomogeneousLocalization.val_mul u v
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := fun u v => HomogeneousLocalization.val_add u v }
      let β : HomogeneousLocalization.Away 𝒜 X_c →+* MvPolynomial τ K_R :=
        β_loc.comp valHom
      have hval_ι : ∀ r : K_R, (ι_c r).val = Localization.mk (MvPolynomial.C r) 1 := by
        intro r
        change (HomogeneousLocalization.mk
          ⟨0, algebraMap K_R ↥(𝒜 0) r, 1, Submonoid.one_mem S_c⟩).val =
          Localization.mk (MvPolynomial.C r) 1
        rw [HomogeneousLocalization.val_mk, halg0 r]
        rfl
      have hleft : Function.LeftInverse β α := by
        have hcomp : β.comp α = RingHom.id (MvPolynomial τ K_R) := by
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext
            intro r
            simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_C, β, valHom,
              RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, hval_ι, hβ_loc_mk, dehom]
          · intro b
            simp only [RingHom.comp_apply, RingHom.id_apply, α, MvPolynomial.eval₂Hom_X', β, valHom,
              RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk, t_tilde,
              HomogeneousLocalization.Away.val_mk, hβ_loc_mk, dehom, MvPolynomial.eval₂Hom_X', w,
              dif_neg b.2, Subtype.coe_eta]
        intro q
        exact RingHom.congr_fun hcomp q
      have hright : Function.RightInverse β α := by
        intro z
        let φ : MvPolynomial (Fin 2) K_R →+* Localization S_c :=
          valHom.comp (α.comp dehom)
        have hφ_C : ∀ r : K_R, φ (MvPolynomial.C r) = Localization.mk (MvPolynomial.C r) 1 := by
          intro r
          simp [φ, dehom, α, valHom, hval_ι]
        have hφ_X : ∀ j : Fin 2,
            φ (MvPolynomial.X j) =
              Localization.mk (MvPolynomial.X j) ⟨X_c, Submonoid.mem_powers X_c⟩ := by
          intro j
          by_cases hj : j = c
          · subst hj
            have h1 : φ X_c = 1 := by simp [φ, hdehom_Xc]
            rw [h1]
            exact (Localization.mk_self (⟨X_c, Submonoid.mem_powers X_c⟩ : S_c)).symm
          · have h2 : φ (MvPolynomial.X j) = (t_tilde j).val := by
              simp [φ, dehom, w, dif_neg hj, α, valHom]
            rw [h2, HomogeneousLocalization.Away.val_mk]
            congr 1
            apply Subtype.ext
            exact pow_one X_c
        have hφ_prod : ∀ (d : Fin 2 →₀ ℕ) (s : Finset (Fin 2)),
            φ (∏ j ∈ s, MvPolynomial.X j ^ d j) =
              Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
                ⟨X_c ^ (∑ j ∈ s, d j),
                  S_c.pow_mem (Submonoid.mem_powers X_c) (∑ j ∈ s, d j)⟩ := by
          intro d s
          induction s using Finset.induction_on with
          | empty => simp
          | @insert j s hj ih =>
            rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul, map_pow, hφ_X j, ih,
              Localization.mk_pow, Localization.mk_mul]
            congr 1
            apply Subtype.ext
            change X_c ^ d j * X_c ^ (∑ i ∈ s, d i) = X_c ^ (d j + ∑ i ∈ s, d i)
            rw [← pow_add]
        have hφ_monomial : ∀ (d : Fin 2 →₀ ℕ) (r : K_R),
            φ (MvPolynomial.monomial d r) =
              Localization.mk (MvPolynomial.monomial d r)
                ⟨X_c ^ (∑ j ∈ d.support, d j),
                  S_c.pow_mem (Submonoid.mem_powers X_c) (∑ j ∈ d.support, d j)⟩ := by
          intro d r
          rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C r, hφ_prod d d.support,
            Localization.mk_mul]
          congr 1
          apply Subtype.ext
          exact one_mul _
        have hφ_homog : ∀ (n : ℕ) (p : MvPolynomial (Fin 2) K_R),
            p.IsHomogeneous n →
            φ p = Localization.mk p
              ⟨X_c ^ n, S_c.pow_mem (Submonoid.mem_powers X_c) n⟩ := by
          intro n p hp
          let y_n : S_c := ⟨X_c ^ n, S_c.pow_mem (Submonoid.mem_powers X_c) n⟩
          have hsum_eq : ∀ s : Finset (Fin 2 →₀ ℕ),
              (∀ d ∈ s, (∑ j ∈ d.support, d j) = n) →
              φ (∑ d ∈ s, MvPolynomial.monomial d (p.coeff d)) =
                Localization.mk (∑ d ∈ s, MvPolynomial.monomial d (p.coeff d)) y_n := by
            intro s
            induction s using Finset.induction_on with
            | empty =>
              intro _
              simp [Localization.mk_zero]
            | @insert d s hd ih =>
              intro hs
              have hd_n : (∑ j ∈ d.support, d j) = n := hs d (Finset.mem_insert_self d s)
              have hs_n : ∀ d' ∈ s, (∑ j ∈ d'.support, d' j) = n :=
                fun d' hd' => hs d' (Finset.mem_insert_of_mem hd')
              rw [Finset.sum_insert hd, map_add, hφ_monomial d (p.coeff d), ih hs_n]
              have hy_eq : (⟨X_c ^ (∑ j ∈ d.support, d j),
                  S_c.pow_mem (Submonoid.mem_powers X_c) (∑ j ∈ d.support, d j)⟩ : S_c) = y_n := by
                apply Subtype.ext
                exact congrArg (X_c ^ ·) hd_n
              rw [hy_eq, Localization.add_mk_self]
          have hp_supp : ∀ d ∈ p.support, (∑ j ∈ d.support, d j) = n := by
            intro d hd
            have hdeg := hp (MvPolynomial.mem_support_iff.mp hd)
            simpa [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one] using hdeg
          conv_lhs => rw [MvPolynomial.as_sum p]
          conv_rhs => rw [MvPolynomial.as_sum p]
          exact hsum_eq p.support hp_supp
        obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
        obtain ⟨n, hn⟩ := nd.den_mem
        dsimp only at hn
        have hXc_pow_ne : X_c ^ n ≠ 0 := by
          intro hzero
          have hev : MvPolynomial.eval (fun _ => (1 : K_R)) (X_c ^ n) = 0 := by
            rw [hzero, map_zero]
          have hev1 : MvPolynomial.eval (fun _ => (1 : K_R)) (X_c ^ n) = 1 := by
            simp [X_c]
          exact one_ne_zero (hev1.symm.trans hev)
        have hex_coeff : ∃ d₀ : Fin 2 →₀ ℕ, (X_c ^ n).coeff d₀ ≠ 0 := by
          by_contra hall
          exact hXc_pow_ne (MvPolynomial.ext _ _ fun d₀ => by
            simp [Classical.not_not.mp fun h => hall ⟨d₀, h⟩])
        rcases hex_coeff with ⟨d₀, hd₀⟩
        have hden_hom1 : (X_c ^ n).IsHomogeneous nd.deg := by
          rw [hn]
          exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
        have hden_hom2 : (X_c ^ n).IsHomogeneous n := by
          simpa using (MvPolynomial.isHomogeneous_X K_R c).pow n
        have hdeg_eq : nd.deg = n := (hden_hom1 hd₀).symm.trans (hden_hom2 hd₀)
        have hnum_hom : nd.num.1.IsHomogeneous n := by
          rw [← hdeg_eq]
          exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
        apply HomogeneousLocalization.val_injective S_c
        have hβ_nd : β (HomogeneousLocalization.mk nd) = dehom nd.num.1 := by
          change β_loc (HomogeneousLocalization.mk nd).val = dehom nd.num.1
          rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
        rw [hβ_nd]
        change φ nd.num.1 = (HomogeneousLocalization.mk nd).val
        rw [hφ_homog n nd.num.1 hnum_hom, HomogeneousLocalization.val_mk]
        congr 1
        apply Subtype.ext
        exact hn
      let e_away : MvPolynomial τ K_R ≃+* HomogeneousLocalization.Away 𝒜 X_c :=
        { α with invFun := β, left_inv := hleft, right_inv := hright }
      let e_sec : HomogeneousLocalization.Away 𝒜 X_c ≃+*
          ↑((AlgebraicGeometry.Proj 𝒜).presheaf.obj (Opposite.op (U_c c))) :=
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜 (MvPolynomial.X c)
          (hX_mem c) zero_lt_one).commRingCatIsoToRingEquiv
      exact ⟨e_away.trans e_sec⟩
    let X_S : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of S)
    let ψ_P : X_S ⟶ AlgebraicGeometry.Proj 𝒜 := ψ
    have hEt_ψP : AlgebraicGeometry.Etale ψ_P := hEt_ψ
    have hRed_stalk_S : ∀ x : ↥X_S, _root_.IsReduced ↑(X_S.presheaf.stalk x) := by
      intro x
      have hx_top : ψ_P.base x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
      rw [← hCov_P1, TopologicalSpace.Opens.mem_iSup] at hx_top
      rcases hx_top with ⟨c, hx_Uc⟩
      obtain ⟨θ_c⟩ := hDehom c
      obtain ⟨V, hV, hxV, hle⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ψ_P ⁻¹ᵁ U_c c) hx_Uc
      let A_c : Type u := MvPolynomial {b : Fin 2 // b ≠ c} K_R
      let B_V : Type u := ↑(X_S.presheaf.obj (Opposite.op V))
      have hEt_app : (ψ_P.appLE (U_c c) V hle).hom.Etale :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
          ψ_P hEt_ψP ⟨U_c c, hAff_c c⟩ ⟨V, hV⟩ hle
      let φ_V : A_c →+* B_V := (ψ_P.appLE (U_c c) V hle).hom.comp θ_c.toRingHom
      have hEt_φV : φ_V.Etale :=
        RingHom.Etale.stableUnderComposition θ_c.toRingHom (ψ_P.appLE (U_c c) V hle).hom
          (RingHom.Etale.of_bijective θ_c.bijective) hEt_app
      letI : Algebra A_c B_V := φ_V.toAlgebra
      haveI : Algebra.Etale A_c B_V := hEt_φV
      let q_V : PrimeSpectrum B_V := hV.isoSpec.hom.base ⟨x, hxV⟩
      obtain ⟨g, hg_not_mem, hDom_g⟩ := hEtDom A_c B_V q_V
      let W_g : X_S.Opens := X_S.basicOpen g
      have hWg : AlgebraicGeometry.IsAffineOpen W_g := hV.basicOpen g
      have hqV_pre : q_V ∈ hV.fromSpec ⁻¹ᵁ W_g := by
        rw [hV.fromSpec_preimage_basicOpen g]
        exact (PrimeSpectrum.mem_basicOpen g q_V).mpr hg_not_mem
      have h_from_qV : hV.fromSpec.base q_V = x := by
        rw [← hV.isoSpec_inv_ι]
        change V.ι.base (hV.isoSpec.inv.base (hV.isoSpec.hom.base ⟨x, hxV⟩)) = x
        have h_inv_hom : hV.isoSpec.inv.base (hV.isoSpec.hom.base ⟨x, hxV⟩) = ⟨x, hxV⟩ :=
          congrArg (fun f => f.base ⟨x, hxV⟩) hV.isoSpec.hom_inv_id
        rw [h_inv_hom]
        rfl
      have hxWg : x ∈ W_g := by
        rw [← h_from_qV]
        exact hqV_pre
      haveI : IsDomain (Localization.Away g) := hDom_g
      haveI : IsLocalization.Away g ↑(X_S.presheaf.obj (Opposite.op W_g)) :=
        hV.isLocalization_basicOpen g
      let e_loc : Localization.Away g ≃+* ↑(X_S.presheaf.obj (Opposite.op W_g)) :=
        (IsLocalization.algEquiv (Submonoid.powers g)
          (Localization.Away g) ↑(X_S.presheaf.obj (Opposite.op W_g))).toRingEquiv
      have hRed_Wg_sec : _root_.IsReduced ↑(X_S.presheaf.obj (Opposite.op W_g)) := by
        refine ⟨fun s hs => ?_⟩
        rcases hs with ⟨n, hn⟩
        apply e_loc.symm.injective
        rw [map_zero]
        apply eq_zero_of_pow_eq_zero (n := n)
        rw [← map_pow, hn, map_zero]
      have hRed_Spec : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (X_S.presheaf.obj (Opposite.op W_g))) := by
        rwa [AlgebraicGeometry.affine_isReduced_iff]
      haveI : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (X_S.presheaf.obj (Opposite.op W_g))) := hRed_Spec
      let Z_W : AlgebraicGeometry.Scheme.{u} := W_g.toScheme
      haveI : AlgebraicGeometry.IsReduced Z_W :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion hWg.isoSpec.hom
      let z₀ : ↥Z_W := ⟨x, hxWg⟩
      let e_stalk := W_g.stalkIso z₀
      refine ⟨fun s hs => ?_⟩
      rcases hs with ⟨n, hn⟩
      have h_inv_pow : (e_stalk.inv.hom s) ^ n = 0 := by
        rw [← map_pow, hn, map_zero]
      obtain ⟨W_0, hzW0, t_0, ht_0⟩ := Z_W.presheaf.exists_germ_eq (x := z₀) (e_stalk.inv.hom s)
      have h_germ_zero : (Z_W.presheaf.germ W_0 z₀ hzW0).hom (t_0 ^ n) =
          (Z_W.presheaf.germ W_0 z₀ hzW0).hom 0 := by
        rw [map_pow, ht_0, h_inv_pow, map_zero]
      obtain ⟨W_0', hzW0', i_W0, i_W0', h_res_eq⟩ :=
        Z_W.presheaf.germ_eq z₀ hzW0 hzW0 (t_0 ^ n) 0 h_germ_zero
      let t_0' := (Z_W.presheaf.map i_W0.op).hom t_0
      have ht_0'_pow : t_0' ^ n = 0 := by
        dsimp [t_0']
        rw [← map_pow]
        have h0_rhs : (Z_W.presheaf.map i_W0'.op).hom
            (0 : ↑(Z_W.presheaf.obj (Opposite.op W_0))) = 0 := map_zero _
        exact h_res_eq.trans h0_rhs
      have ht_0'_zero : t_0' = 0 := eq_zero_of_pow_eq_zero ht_0'_pow
      have h_inv_zero : e_stalk.inv.hom s = 0 := by
        rw [← ht_0, ← Z_W.presheaf.germ_res_apply i_W0 z₀ hzW0']
        change (Z_W.presheaf.germ W_0' z₀ hzW0').hom t_0' = 0
        rw [ht_0'_zero, map_zero]
      have h_back := congrArg e_stalk.hom.hom h_inv_zero
      simpa using h_back
    haveI : ∀ x : ↥X_S, _root_.IsReduced ↑(X_S.presheaf.stalk x) := hRed_stalk_S
    have hRed_XS : AlgebraicGeometry.IsReduced X_S :=
      AlgebraicGeometry.isReduced_of_isReduced_stalk X_S
    exact (@AlgebraicGeometry.affine_isReduced_iff (CommRingCat.of S)).mp hRed_XS

  
  
  
  have hua_cases : u_a = u₀ ∨ u_a = u₁ := by
    dsimp only [u_a]
    by_cases ha : a = 0
    · exact Or.inl (if_pos ha)
    · exact Or.inr (if_neg ha)
  have hDom_hsR_fn : ∀ x : B_W, x = u₀ ∨ x = u₁ →
      IsDomain (B_W ⧸ Ideal.span {x}) ∧ c_W s_R ∉ Ideal.span {x} := by
    rintro x (rfl | rfl)
    · exact ⟨hDom0, hsR_u0⟩
    · exact ⟨hDom1, hsR_u1⟩
  obtain ⟨hDom_ua, hsR_ua⟩ := hDom_hsR_fn u_a hua_cases
  obtain ⟨_, _, hPrK_a, hComap_a⟩ := hAxisPrime u_a hDom_ua hsR_ua

  let P_W : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback ι_Ebar_C f_C
  let p_Ebar : P_W ⟶ E_bar := CategoryTheory.Limits.pullback.fst ι_Ebar_C f_C
  let ι_PW : P_W ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_W) :=
    CategoryTheory.Limits.pullback.snd ι_Ebar_C f_C
  haveI : AlgebraicGeometry.IsClosedImmersion ι_Ebar_C := hCl_EbarC
  haveI : AlgebraicGeometry.IsClosedImmersion ι_PW := inferInstance
  obtain ⟨J_B, e_PW, he_PW⟩ :=
    (AlgebraicGeometry.IsClosedImmersion.Spec_iff (f := ι_PW)).mp inferInstance
  let π_J : B_W →+* (B_W ⧸ J_B) := Ideal.Quotient.mk J_B

  haveI : AlgebraicGeometry.Flat g_Ebar := hFlat_gEbar
  have hSpec_πJcW : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_J.comp c_W)) =
      e_PW.inv ≫ p_Ebar ≫ g_Ebar := by
    rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    have h_inv_ι : e_PW.inv ≫ ι_PW = AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_J) := by
      rw [he_PW, ← CategoryTheory.Category.assoc, e_PW.inv_hom_id, CategoryTheory.Category.id_comp]
    rw [← h_inv_ι, ← hfC_comm, CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc ι_PW, ← CategoryTheory.Limits.pullback.condition,
      CategoryTheory.Category.assoc, hComm_Ebar]
  have hFlat_spec_J : AlgebraicGeometry.Flat
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_J.comp c_W))) := by
    rw [hSpec_πJcW]
    infer_instance
  have hFlat_ring_J : (π_J.comp c_W).Flat :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mp hFlat_spec_J
  have hTorsFree_JB : ∀ m ∈ M_W, ∀ b : B_W, m * b ∈ J_B → b ∈ J_B := by
    rintro _ ⟨r_m, ⟨k, rfl⟩, rfl⟩ b hmb
    letI : Algebra R (B_W ⧸ J_B) := (π_J.comp c_W).toAlgebra
    haveI : Module.Flat R (B_W ⧸ J_B) := hFlat_ring_J
    have h_tor : Submodule.torsion R (B_W ⧸ J_B) = ⊥ := Module.Flat.torsion_eq_bot
    rw [← Submodule.isTorsionFree_iff_torsion_eq_bot,
      Module.isTorsionFree_iff_smul_eq_zero] at h_tor
    have hsk_ne : s_R ^ k ≠ 0 := pow_ne_zero k hsR
    have hsmul0 : (s_R ^ k) • π_J b = 0 := by
      change π_J (c_W (s_R ^ k)) * π_J b = 0
      rw [← map_mul]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hmb
    have hπb0 : π_J b = 0 := (h_tor (s_R ^ k) (π_J b) hsmul0).resolve_left hsk_ne
    exact Ideal.Quotient.eq_zero_iff_mem.mp hπb0

  let J_K : Ideal B_K := Ideal.map loc_K J_B
  let π_JK : B_K →+* (B_K ⧸ J_K) := Ideal.Quotient.mk J_K
  let bar_loc : (B_W ⧸ J_B) →+* (B_K ⧸ J_K) :=
    Ideal.Quotient.lift J_B (π_JK.comp loc_K) (fun x hx => by
      change Ideal.Quotient.mk J_K (loc_K x) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem loc_K hx))
  have hcomm_quot : CommRingCat.ofHom π_J ≫ CommRingCat.ofHom bar_loc =
      CommRingCat.ofHom loc_K ≫ CommRingCat.ofHom π_JK := by
    ext x
    rfl
  have hPush_quot : CategoryTheory.IsPushout
      (CommRingCat.ofHom π_J) (CommRingCat.ofHom loc_K)
      (CommRingCat.ofHom bar_loc) (CommRingCat.ofHom π_JK) := by
    refine CategoryTheory.IsPushout.of_isColimit
      (c := CategoryTheory.Limits.PushoutCocone.mk _ _ hcomm_quot) ?_
    refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_quot
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift J_K s.inr.hom (by
        intro y hy
        rw [← RingHom.mem_ker]
        have hle : J_K ≤ RingHom.ker s.inr.hom := by
          rw [Ideal.map_le_iff_le_comap]
          intro x hx
          change s.inr.hom (loc_K x) = 0
          have hw := RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) x
          change s.inl.hom (π_J x) = s.inr.hom (loc_K x) at hw
          rw [← hw, Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero]
        exact hle hy)))
      (fun s => by
        ext x
        exact (RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) x).symm)
      (fun s => by
        ext y
        rfl)
      (fun s m _ hm₂ => by
        ext y
        exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₂) y)
  have hPb_quot : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom bar_loc))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_JK))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_J)) loc_Spec :=
    AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_quot
  have hPb_ePW : CategoryTheory.IsPullback e_PW.inv
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_J)) ι_PW (𝟙 _) := by
    refine CategoryTheory.IsPullback.of_horiz_isIso ⟨?_⟩
    rw [CategoryTheory.Category.comp_id, he_PW, ← CategoryTheory.Category.assoc,
      e_PW.inv_hom_id, CategoryTheory.Category.id_comp]
  have hPb_1 : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom bar_loc) ≫ e_PW.inv)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_JK)) ι_PW loc_Spec := by
    have hp := hPb_quot.paste_horiz hPb_ePW
    rwa [CategoryTheory.Category.comp_id] at hp

  let Q_K : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback ι_E f_CK
  let q_E : Q_K ⟶ E_sch := CategoryTheory.Limits.pullback.fst ι_E f_CK
  let ι_QK : Q_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_K) :=
    CategoryTheory.Limits.pullback.snd ι_E f_CK
  have hw_Q : (q_E ≫ j_to) ≫ ι_Ebar_C = (ι_QK ≫ loc_Spec) ≫ f_C := by
    rw [CategoryTheory.Category.assoc, ← hPb_gen.w, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hfCK_fst,
      ← CategoryTheory.Category.assoc]
  let q_PW : Q_K ⟶ P_W :=
    CategoryTheory.Limits.pullback.lift (q_E ≫ j_to) (ι_QK ≫ loc_Spec) hw_Q
  have hPb_2 : CategoryTheory.IsPullback q_PW ι_QK ι_PW loc_Spec := by
    have hOuter_Q : CategoryTheory.IsPullback (q_PW ≫ p_Ebar) ι_QK ι_Ebar_C (loc_Spec ≫ f_C) := by
      rw [CategoryTheory.Limits.pullback.lift_fst, ← hfCK_fst]
      exact (CategoryTheory.IsPullback.of_hasPullback ι_E f_CK).paste_horiz hPb_gen.flip
    exact CategoryTheory.IsPullback.of_right hOuter_Q
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback ι_Ebar_C f_C)
  let iso_QK : AlgebraicGeometry.Spec (CommRingCat.of (B_K ⧸ J_K)) ≅ Q_K :=
    CategoryTheory.IsPullback.isoIsPullback _ _ hPb_1 hPb_2
  have hiso_QK_snd : iso_QK.hom ≫ ι_QK =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_JK) :=
    CategoryTheory.IsPullback.isoIsPullback_hom_snd _ _ hPb_1 hPb_2

  have hRad_JK : J_K.radical = Ideal.span {loc_K u_a} := by
    rw [Ideal.radical_eq_sInf, ← hPrK_a.radical, Ideal.radical_eq_sInf]
    congr 1
    ext P_id
    simp only [Set.mem_setOf_eq]
    refine ⟨fun ⟨hle, hPr⟩ => ⟨?_, hPr⟩, fun ⟨hle, hPr⟩ => ⟨?_, hPr⟩⟩
    · let P : PrimeSpectrum B_K := ⟨P_id, hPr⟩
      rw [Ideal.span_singleton_le_iff_mem, ← hPre_ua P, ← hRange_ιE]
      have hKer_le : RingHom.ker π_JK ≤ P.asIdeal := by
        rwa [Ideal.mk_ker]
      have hSurj_JK : Function.Surjective π_JK := Ideal.Quotient.mk_surjective
      let P_bar : PrimeSpectrum (B_K ⧸ J_K) :=
        ⟨Ideal.map π_JK P.asIdeal, Ideal.map_isPrime_of_surjective hSurj_JK hKer_le⟩
      have hComap_Pbar : Ideal.comap π_JK P_bar.asIdeal = P.asIdeal := by
        dsimp [P_bar]
        rw [Ideal.comap_map_of_surjective π_JK hSurj_JK]
        have hk : Ideal.comap π_JK ⊥ = RingHom.ker π_JK := rfl
        rw [hk]
        exact sup_eq_left.mpr hKer_le
      have hSpec_Pbar : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_JK)).base P_bar = P :=
        PrimeSpectrum.ext hComap_Pbar
      let z : ↥Q_K := iso_QK.hom.base P_bar
      have hz_snd : ι_QK.base z = P := by
        have hev := congrArg (fun f => f.base P_bar) hiso_QK_snd
        exact hev.trans hSpec_Pbar
      have h_cond := congrArg (fun f => f.base z)
        (CategoryTheory.Limits.pullback.condition (f := ι_E) (g := f_CK))
      change ι_E.base (q_E.base z) = f_CK.base (ι_QK.base z) at h_cond
      rw [hz_snd] at h_cond
      exact ⟨q_E.base z, h_cond⟩
    · let P : PrimeSpectrum B_K := ⟨P_id, hPr⟩
      have hPE : f_CK.base P ∈ Set.range ι_E.base := by
        rw [hRange_ιE, hPre_ua P]
        rwa [Ideal.span_singleton_le_iff_mem] at hle
      rcases hPE with ⟨w, hw⟩
      obtain ⟨z, _, hz_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := ι_E) (g := f_CK) w P hw
      let P_bar : PrimeSpectrum (B_K ⧸ J_K) := iso_QK.inv.base z
      have hSpec_Pbar : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_JK)).base P_bar = P := by
        have hev := congrArg (fun f => f.base P_bar) hiso_QK_snd.symm
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_JK)).base P_bar =
          ι_QK.base (iso_QK.hom.base (iso_QK.inv.base z)) at hev
        have h_inv : iso_QK.hom.base (iso_QK.inv.base z) = z :=
          congrArg (fun f => f.base z) iso_QK.inv_hom_id
        rw [h_inv, hz_snd] at hev
        exact hev
      have hComap_Pbar : Ideal.comap π_JK P_bar.asIdeal = P_id :=
        congrArg PrimeSpectrum.asIdeal hSpec_Pbar
      intro y hy
      rw [← hComap_Pbar, Ideal.mem_comap]
      change π_JK y ∈ P_bar.asIdeal
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hy]
      exact P_bar.asIdeal.zero_mem

  obtain ⟨isoP1, _⟩ := hP1_E
  haveI : AlgebraicGeometry.Etale q_E := inferInstance
  have hEt_toP1 : AlgebraicGeometry.Etale (iso_QK.hom ≫ q_E ≫ isoP1.hom) := inferInstance
  have hRed_BK_quot : _root_.IsReduced (B_K ⧸ J_K) :=
    hRed_etale_P1 (B_K ⧸ J_K) (iso_QK.hom ≫ q_E ≫ isoP1.hom) hEt_toP1
  have hJK_eq : J_K = Ideal.span {loc_K u_a} := by
    have hIsRad : J_K.IsRadical := (Ideal.isRadical_iff_quotient_reduced J_K).mpr hRed_BK_quot
    rw [← hIsRad.radical, hRad_JK]
  have hJB_eq : J_B = Ideal.span {if a = 0 then u₀ else u₁} := by
    change J_B = Ideal.span {u_a}
    apply le_antisymm
    · intro b hb
      rw [← hComap_a, Ideal.mem_comap, ← hJK_eq]
      exact Ideal.mem_map_of_mem loc_K hb
    · rw [Ideal.span_singleton_le_iff_mem]
      have hloc_mem : loc_K u_a ∈ Ideal.map loc_K J_B := by
        change loc_K u_a ∈ J_K
        rw [hJK_eq]
        exact Ideal.subset_span rfl
      rcases (IsLocalization.algebraMap_mem_map_algebraMap_iff M_W B_K J_B u_a).mp hloc_mem with
        ⟨m, hm, hmu⟩
      exact hTorsFree_JB m hm u_a hmu
  subst hJB_eq
  refine ⟨hClaim1, a, e_PW.symm, ?_⟩
  change e_PW.inv ≫ ι_PW = _
  rw [he_PW, ← CategoryTheory.Category.assoc, e_PW.inv_hom_id, CategoryTheory.Category.id_comp]

theorem weil_closed_fiber_etale_poly_chart_smooth_reduced_and_generalization (R : Type u) [CommRing R] [IsLocalRing R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (hEtDom : ∀ (A₀ B₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B₀] [Algebra A₀ B₀] [Algebra.Etale A₀ B₀]
        (q : PrimeSpectrum B₀),
      ∃ g : B₀, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (hSmDesc : ∀ (A B : Type u) [CommRing A] [CommRing B]
        (c_A : IsLocalRing.ResidueField R →+* A)
        (e_AB : A →+* B)
        (ψ_B : Polynomial (IsLocalRing.ResidueField R) →+* B),
      (letI : Algebra (IsLocalRing.ResidueField R) A := c_A.toAlgebra;
        Algebra.FiniteType (IsLocalRing.ResidueField R) A) →
      e_AB.Etale →
      ψ_B.Etale →
      e_AB.comp c_A = ψ_B.comp Polynomial.C →
      ∀ (q₀ : PrimeSpectrum B),
        ψ_B Polynomial.X ∈ q₀.asIdeal →
        ∃ f : A,
          f ∉ (PrimeSpectrum.comap e_AB q₀).asIdeal ∧
          RingHom.IsStandardSmoothOfRelativeDimension 1
            ((algebraMap A (Localization.Away f)).comp c_A))
    (E_bar : AlgebraicGeometry.Scheme.{u})
    (g_Ebar : E_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hLFTEbar : AlgebraicGeometry.LocallyOfFiniteType g_Ebar)
    (B_a : Type u) [CommRing B_a]
    (q_a : PrimeSpectrum B_a)
    (e_Ebar : AlgebraicGeometry.Spec (CommRingCat.of B_a) ⟶ E_bar)
    (ψ_R : Polynomial R →+* B_a)
    (hEt_eEbar : AlgebraicGeometry.Etale e_Ebar)
    (hEt_ψR : ψ_R.Etale)
    (hX_qa : ψ_R Polynomial.X ∈ q_a.asIdeal)
    (hm_qa : ∀ m ∈ IsLocalRing.maximalIdeal R, ψ_R (Polynomial.C m) ∈ q_a.asIdeal)
    (he_comm : e_Ebar ≫ g_Ebar =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_R.comp Polynomial.C))) :
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
    let Z₀ := CategoryTheory.Limits.pullback g_Ebar s₀
    ∀ z : ↥Z₀,
      (CategoryTheory.Limits.pullback.fst g_Ebar s₀).base z = e_Ebar.base q_a →
      (∃ V_Z : Z₀.Opens,
        z ∈ V_Z ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V_Z.ι ≫ CategoryTheory.Limits.pullback.snd g_Ebar s₀)) ∧
      _root_.IsReduced ↑(Z₀.presheaf.stalk z) ∧
      (∃ z' : ↥Z₀, z' ≠ z ∧ z ∈ closure ({z'} : Set ↥Z₀)) :=
by
  classical
  intro s₀ Z₀ z hz
  let k₀ : Type u := IsLocalRing.ResidueField R
  let res : R →+* k₀ := IsLocalRing.residue R
  have hSurj_res : Function.Surjective res := IsLocalRing.residue_surjective
  
  let c_a : R →+* B_a := ψ_R.comp Polynomial.C
  let I_a : Ideal B_a := Ideal.map c_a (IsLocalRing.maximalIdeal R)
  let B_Z : Type u := B_a ⧸ I_a
  let π_B : B_a →+* B_Z := Ideal.Quotient.mk I_a
  have hSurj_πB : Function.Surjective π_B := Ideal.Quotient.mk_surjective
  have hKer_res_le : RingHom.ker res ≤ RingHom.ker (π_B.comp c_a) := by
    intro m hm
    have hm_max : m ∈ IsLocalRing.maximalIdeal R := by
      rwa [← IsLocalRing.ker_residue]
    rw [RingHom.mem_ker, RingHom.comp_apply]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem c_a hm_max)
  let e_res : R ⧸ RingHom.ker res ≃+* k₀ :=
    RingHom.quotientKerEquivOfSurjective hSurj_res
  let c_BZ : k₀ →+* B_Z :=
    (Ideal.Quotient.lift (RingHom.ker res) (π_B.comp c_a) hKer_res_le).comp e_res.symm.toRingHom
  have hc_BZ_comp : c_BZ.comp res = π_B.comp c_a := by
    ext r
    dsimp [c_BZ, e_res]
    have hr : (RingHom.quotientKerEquivOfSurjective hSurj_res)
        (Ideal.Quotient.mk (RingHom.ker res) r) = res r := rfl
    rw [← hr, RingEquiv.symm_apply_apply]
    rfl
  have hKer_πB_le : RingHom.ker π_B ≤ q_a.asIdeal := by
    rw [Ideal.mk_ker, Ideal.map_le_iff_le_comap]
    exact hm_qa
  have hPrime_q0 : (Ideal.map π_B q_a.asIdeal).IsPrime :=
    Ideal.map_isPrime_of_surjective hSurj_πB hKer_πB_le
  let q₀ : PrimeSpectrum B_Z := ⟨Ideal.map π_B q_a.asIdeal, hPrime_q0⟩
  have hComap_q0 : Ideal.comap π_B q₀.asIdeal = q_a.asIdeal := by
    dsimp [q₀]
    rw [Ideal.comap_map_of_surjective π_B hSurj_πB]
    have hker : Ideal.comap π_B ⊥ = RingHom.ker π_B := rfl
    rw [hker]
    exact sup_eq_left.mpr hKer_πB_le
  have hSpec_q0 : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B)).base q₀ = q_a := by
    apply PrimeSpectrum.ext
    exact hComap_q0
  
  have he_Z_cond :
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫ e_Ebar) ≫ g_Ebar =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_BZ) ≫ s₀ := by
    rw [CategoryTheory.Category.assoc, he_comm]
    dsimp [s₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_B.comp c_a)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (c_BZ.comp res))
    rw [hc_BZ_comp]
  let e_Z : AlgebraicGeometry.Spec (CommRingCat.of B_Z) ⟶ Z₀ :=
    CategoryTheory.Limits.pullback.lift
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫ e_Ebar)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_BZ))
      he_Z_cond
  have he_Z_fst :
      e_Z ≫ CategoryTheory.Limits.pullback.fst g_Ebar s₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) ≫ e_Ebar :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have he_Z_snd :
      e_Z ≫ CategoryTheory.Limits.pullback.snd g_Ebar s₀ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_BZ) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hEt_eZ : AlgebraicGeometry.Etale e_Z := by
    letI : Algebra R B_a := c_a.toAlgebra
    let f_T_alg : TensorProduct R B_a k₀ →ₐ[R] B_Z :=
      Algebra.TensorProduct.lift
        (Ideal.Quotient.mkₐ R I_a)
        ⟨c_BZ, fun r => RingHom.congr_fun hc_BZ_comp r⟩
        (fun _ _ => mul_comm _ _)
    let f_T : TensorProduct R B_a k₀ →+* B_Z := f_T_alg.toRingHom
    have hIa_ker_T :
        I_a ≤ RingHom.ker
          (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := B_a) (B := k₀)) := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, RingHom.mem_ker]
      change (c_a m) ⊗ₜ[R] (1 : k₀) = 0
      have hm_smul : c_a m = m • (1 : B_a) := by
        rw [Algebra.smul_def, mul_one]; rfl
      rw [hm_smul, TensorProduct.smul_tmul]
      have hm_k0 : m • (1 : k₀) = 0 := by
        rw [Algebra.smul_def, mul_one]
        change res m = 0
        exact RingHom.mem_ker.mp (by rwa [IsLocalRing.ker_residue])
      rw [hm_k0, TensorProduct.tmul_zero]
    let g_T : B_Z →+* TensorProduct R B_a k₀ :=
      Ideal.Quotient.lift I_a Algebra.TensorProduct.includeLeftRingHom hIa_ker_T
    have hf_T_tmul : ∀ (b : B_a) (x : k₀), f_T (b ⊗ₜ[R] x) = π_B b * c_BZ x :=
      fun b x => Algebra.TensorProduct.lift_tmul _ _ _ b x
    have hf_g_T : ∀ y : B_Z, f_T (g_T y) = y := by
      intro y
      obtain ⟨b, rfl⟩ := hSurj_πB y
      change f_T (b ⊗ₜ[R] (1 : k₀)) = π_B b
      rw [hf_T_tmul, map_one, mul_one]
    have hg_f_T : ∀ t : TensorProduct R B_a k₀, g_T (f_T t) = t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul b x =>
        obtain ⟨r, rfl⟩ := hSurj_res x
        have h_tmul : b ⊗ₜ[R] (res r) = (c_a r * b) ⊗ₜ[R] (1 : k₀) := by
          have hr1 : res r = r • (1 : k₀) := by rw [Algebra.smul_def, mul_one]; rfl
          have hr2 : r • b = c_a r * b := by rw [Algebra.smul_def]; rfl
          rw [hr1, ← TensorProduct.smul_tmul, hr2]
        rw [h_tmul, hf_T_tmul, map_one, mul_one]
        rfl
      | add t₁ t₂ ht₁ ht₂ =>
        rw [map_add, map_add, ht₁, ht₂]
    let iso_SpecT : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R B_a k₀)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of B_Z) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_T)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_T)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_id : g_T.comp f_T = RingHom.id _ := RingHom.ext hg_f_T
          rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have h_id : f_T.comp g_T = RingHom.id B_Z := RingHom.ext hf_g_T
          rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let iso_pb := AlgebraicGeometry.pullbackSpecIso R B_a k₀ ≪≫ iso_SpecT
    have hiso_inv_fst :
        iso_pb.inv ≫ CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_a)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B) := by
      dsimp [iso_pb, iso_SpecT]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.Hom.ext
      ext b
      change f_T (b ⊗ₜ[R] (1 : k₀)) = π_B b
      rw [hf_T_tmul, map_one, mul_one]
    have hiso_inv_snd :
        iso_pb.inv ≫ CategoryTheory.Limits.pullback.snd
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_a)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_BZ) := by
      dsimp [iso_pb, iso_SpecT]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.Hom.ext
      ext x
      change f_T ((1 : B_a) ⊗ₜ[R] x) = c_BZ x
      rw [hf_T_tmul, map_one, one_mul]
    have hPb_outer : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B))
        (e_Z ≫ CategoryTheory.Limits.pullback.snd g_Ebar s₀)
        (e_Ebar ≫ g_Ebar) s₀ := by
      refine (CategoryTheory.IsPullback.of_hasPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R B_a)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k₀)))).of_iso
        iso_pb (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        ?_ ?_ ?_ ?_
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
        rw [← hiso_inv_fst, ← CategoryTheory.Category.assoc,
          CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id, he_Z_snd]
        rw [← hiso_inv_snd, ← CategoryTheory.Category.assoc,
          CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp]
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp, he_comm]
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
        rfl
    have hPb_top : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_B))
        e_Z e_Ebar (CategoryTheory.Limits.pullback.fst g_Ebar s₀) :=
      CategoryTheory.IsPullback.of_bot hPb_outer he_Z_fst.symm
        (CategoryTheory.IsPullback.of_hasPullback g_Ebar s₀)
    exact CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.Etale) hPb_top hEt_eEbar
  haveI hCl_s0 : AlgebraicGeometry.IsClosedImmersion s₀ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom res) hSurj_res
  haveI hCl_fst : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.fst g_Ebar s₀) := inferInstance
  have hInj_fst : Function.Injective (CategoryTheory.Limits.pullback.fst g_Ebar s₀).base :=
    (CategoryTheory.Limits.pullback.fst g_Ebar s₀).isClosedEmbedding.injective
  have he_Z_q0 : e_Z.base q₀ = z := by
    apply hInj_fst
    have hev := congrArg (fun f => f.base q₀) he_Z_fst
