        intro z
        rcases subsingleton_or_nontrivial T with hSub | hNontriv
        · have _ : Subsingleton T := hSub
          apply HomogeneousLocalization.val_injective S_a
          exact Subsingleton.elim _ _
        · have _ : Nontrivial T := hNontriv
          let φ_loc : MvPolynomial (Fin (N + 1)) T →+* Localization S_a :=
            valHom.comp (α.comp dehom)
          have hφ_C : ∀ t : T, φ_loc (MvPolynomial.C t) = Localization.mk (MvPolynomial.C t) 1 := by
            intro t
            simp [φ_loc, dehom, α, valHom, hval_ι]
          have hφ_X : ∀ j : Fin (N + 1),
              φ_loc (MvPolynomial.X j) =
                Localization.mk (MvPolynomial.X j) ⟨X_a, Submonoid.mem_powers X_a⟩ := by
            intro j
            by_cases hj : j = a
            · subst hj
              have h1 : φ_loc X_a = 1 := by simp [φ_loc, hdehom_Xa]
              rw [h1]
              exact (Localization.mk_self (⟨X_a, Submonoid.mem_powers X_a⟩ : S_a)).symm
            · have hwj : w j = MvPolynomial.X ⟨j, hj⟩ := by simp [w, hj]
              have h2 : φ_loc (MvPolynomial.X j) = (t_tilde j).val := by
                simp [φ_loc, dehom, hwj, α, valHom]
              rw [h2, HomogeneousLocalization.Away.val_mk]
              congr 1
              apply Subtype.ext
              exact pow_one X_a
          have hφ_prod : ∀ (d : Fin (N + 1) →₀ ℕ) (s : Finset (Fin (N + 1))),
              φ_loc (∏ j ∈ s, MvPolynomial.X j ^ d j) =
                Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
                  ⟨X_a ^ (∑ j ∈ s, d j),
                    S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ s, d j)⟩ := by
            intro d s
            induction s using Finset.induction_on with
            | empty =>
