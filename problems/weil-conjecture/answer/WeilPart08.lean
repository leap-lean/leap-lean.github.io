      rw [← op_comp]
      rfl
    have hmap := congrArg (fun f => f.hom x)
      (X.presheaf.map_comp (CategoryTheory.homOfLE hBC).op (CategoryTheory.homOfLE hAB).op)
    rw [hmor] at hmap
    exact hmap.symm
  refine ⟨j_open, hJ1, hJ2, hJ3, ?_, ?_⟩
  · intro U hU c
    have hUV₀ : Nonempty ↥(U ⊓ V₀) := hNonemptyInter U V₀ hU hNe0
    let γ := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv
    have hResU : (X.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U ⊓ V₀ ≤ U)).op).hom
