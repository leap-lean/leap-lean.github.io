      (RingHom.Etale.stableUnderComposition ι₄_quot β_S hEt_ι₄q hEt_βS)
  let W' : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of W_ring)
  let w₀ : W' := ⟨RingHom.ker σ_bar_W, RingHom.ker_isPrime σ_bar_W⟩
  let e_C : W' ⟶ C_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_C) ≫ ι_C
  let e_nod : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin 2) R ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C δ})) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_nod)
  have hEt_map_αC : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_C)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_αC
  have hEt_e_nod : AlgebraicGeometry.Etale e_nod :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_αnod
  have hEt_e_C : AlgebraicGeometry.Etale e_C := by
    have _ : AlgebraicGeometry.IsOpenImmersion ι_C := hOpen_ιC
    have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_C)) := hEt_map_αC
    dsimp [e_C]
    infer_instance
  refine ⟨W', w₀, δ, e_C, e_nod, hδ, hEt_e_C, hEt_e_nod, ?_, ?_, ?_, ?_⟩
  · have hσ_quot_eq : (σ_bar_W.comp β_S).comp ι₄_quot = σ_bar_quot := by
      apply Ideal.Quotient.ringHom_ext
      calc
        ((σ_bar_W.comp β_S).comp ι₄_quot).comp (Ideal.Quotient.mk (Ideal.span {F}))
          = (σ_bar_W.comp β_S).comp (ι₄_quot.comp (Ideal.Quotient.mk (Ideal.span {F}))) := rfl
        _ = (σ_bar_W.comp β_S).comp ((Ideal.Quotient.mk (Ideal.span {ι₄ F})).comp ι₄.toRingHom) := by
          rw [hι₄q_mk]
        _ = (σ_bar_W.comp (β_S.comp (Ideal.Quotient.mk (Ideal.span {ι₄ F})))).comp ι₄.toRingHom := rfl
        _ = σ_bar₄.comp ι₄.toRingHom := by rw [hσW_βS]
        _ = σ_bar := hσ₄_ι₄
        _ = σ_bar_quot.comp (Ideal.Quotient.mk (Ideal.span {F})) := hσ_quot_mk.symm
    have hσ_αC : σ_bar_W.comp α_C = ε₀.comp (ψ₁.comp (Ideal.Quotient.mk _)) := by
      calc
        σ_bar_W.comp α_C = ((σ_bar_W.comp β_S).comp ι₄_quot).comp α_A := rfl
        _ = σ_bar_quot.comp α_A := by rw [hσ_quot_eq]
        _ = ε₀.comp (ψ₁.comp (Ideal.Quotient.mk _)) := hσ_quot_αA
    have hp'_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_C)).base w₀ = p_A := by
      apply PrimeSpectrum.ext
      change Ideal.comap α_C (RingHom.ker σ_bar_W) = p_A.asIdeal
      have hcomap : Ideal.comap α_C (RingHom.ker σ_bar_W) =
          Ideal.comap (ψ₁.comp (Ideal.Quotient.mk _)) (RingHom.ker ε₀) := by
        ext a
        change σ_bar_W (α_C a) = 0 ↔ ε₀ (ψ₁ (Ideal.Quotient.mk _ a)) = 0
        have ha := RingHom.congr_fun hσ_αC a
        dsimp at ha
        rw [ha]
      exact hcomap.trans hComap_pA
    change ι_C.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_C)).base w₀) = _
    rw [hp'_eq, hp_A]
  · intro i
    change σ_bar_W (α_nod (Ideal.Quotient.mk _ (MvPolynomial.X i))) = 0
    exact hσW_X i
  · intro m hm
    change σ_bar_W (α_nod (Ideal.Quotient.mk _ (MvPolynomial.C m))) = 0
    have hm1 := RingHom.congr_fun hR_W m
    dsimp at hm1
    rw [← hm1]
    have hm2 := RingHom.congr_fun hσW_βS (algebraMap R S₄ m)
    dsimp at hm2
    rw [hm2]
    have hm3 := RingHom.congr_fun hσ₄R m
    dsimp at hm3
    rw [hm3]
    exact (IsLocalRing.ker_residue (R := R) ▸ hm : m ∈ RingHom.ker (IsLocalRing.residue R))
  · dsimp [e_C, e_nod]
    simp only [CategoryTheory.Category.assoc, hComm_ιC, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    apply congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
    ext r
    change β_S (ι₄_quot (α_A (algebraMap R A_R r))) =
      α_nod (Ideal.Quotient.mk _ (MvPolynomial.C r))
    have hr1 := RingHom.congr_fun hαA_R r
    dsimp at hr1
    rw [hr1]
    have hr2 := RingHom.congr_fun hι₄q_mk (algebraMap R S_R r)
    dsimp at hr2
    rw [hr2, ι₄.commutes r]
    exact RingHom.congr_fun hR_W r

theorem weil_etale_integrallyClosed_local_domain_and_fiber_smooth_lift (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R] :
    (∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
      ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g)) ∧
    (∀ (C_R : AlgebraicGeometry.Scheme.{u})
        (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
      AlgebraicGeometry.Flat g_R →
      AlgebraicGeometry.LocallyOfFinitePresentation g_R →
      ∀ (y₀ : ↥(CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
        (∃ V₀ : (CategoryTheory.Limits.pullback g_R
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).Opens,
          y₀ ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
            (V₀.ι ≫ CategoryTheory.Limits.pullback.snd g_R
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) →
        ∃ W_sm : C_R.Opens,
          (CategoryTheory.Limits.pullback.fst g_R
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ ∈ W_sm ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ g_R)) ∧
    (∀ (U : AlgebraicGeometry.Scheme.{u})
        (f : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
      AlgebraicGeometry.Etale f →
      ∀ (u₀ : U),
        (f.base u₀).asIdeal = IsLocalRing.maximalIdeal R →
        ∃ (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U),
          σ ≫ f = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) ∧
          ∀ b : AlgebraicGeometry.Spec (CommRingCat.of R),
            b.asIdeal = IsLocalRing.maximalIdeal R → σ.base b = u₀) :=
by
  
  have h_sec_zmt :
      ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
        let p : Ideal A₀ := q.asIdeal.under A₀
        let A₁ : Type u := Localization.AtPrime p
        let B_q : Type u := Localization.AtPrime q.asIdeal
        letI : q.asIdeal.LiesOver p := ⟨rfl⟩
        letI : Algebra A₁ B_q := Localization.AtPrime.algebraOfLiesOver p q.asIdeal
        Module.IsTorsionFree A₁ B_q ∧
        Algebra.FormallyUnramified A₁ B_q ∧
        Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q) ∧
        Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_q ∧
        ∃ (R₁ : Type u) (_ : CommRing R₁) (_ : Algebra A₁ R₁)
          (_ : Algebra R₁ B_q) (_ : IsScalarTower A₁ R₁ B_q),
          Function.Injective (algebraMap R₁ B_q) ∧
          Algebra.IsIntegral A₁ R₁ ∧
          Module.Finite A₁ R₁ ∧
          IsLocalization
            (Ideal.comap (algebraMap R₁ B_q) (IsLocalRing.maximalIdeal B_q)).primeCompl
            B_q := by
    intro A₀ B _ _ _ _ _ q
    classical
    let p : Ideal A₀ := q.asIdeal.under A₀
    let A₁ : Type u := Localization.AtPrime p
    let B_q : Type u := Localization.AtPrime q.asIdeal
    let _ : q.asIdeal.LiesOver p := ⟨rfl⟩
    let _ : Algebra A₁ B_q := Localization.AtPrime.algebraOfLiesOver p q.asIdeal
    have : Module.Flat A₀ B := inferInstance
    have : Module.Flat A₀ B_q := Module.Flat.trans A₀ B B_q
    have : Module.IsTorsionFree A₀ B_q := inferInstance
    have hp_le : p.primeCompl ≤ nonZeroDivisors A₀ :=
      fun x hx => mem_nonZeroDivisors_of_ne_zero (fun h0 => hx (h0 ▸ p.zero_mem))
    have : IsDomain A₁ := IsLocalization.isDomain_localization hp_le
    have hTF : Module.IsTorsionFree A₁ B_q := Module.IsTorsionFree.of_smul_eq_zero fun x z hxz => by
      by_cases hx : x = 0
      · exact Or.inl hx
      · right
        obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj p.primeCompl x
        have ha0 : a ≠ 0 := by
          rintro rfl
          rw [map_zero] at has
          have hs_unit : IsUnit (algebraMap A₀ A₁ s.1) := IsLocalization.map_units A₁ s
          exact hx (hs_unit.mul_left_eq_zero.mp has)
        have haz : a • z = 0 := by
          rw [← IsScalarTower.algebraMap_smul A₁ a z, ← has, mul_comm, mul_smul, hxz, smul_zero]
        exact (smul_eq_zero.mp haz).resolve_left ha0
    have : Algebra.FormallyUnramified B B_q := inferInstance
    have : Algebra.FormallyUnramified A₀ B_q := Algebra.FormallyUnramified.comp A₀ B B_q
    have hUnram : Algebra.FormallyUnramified A₁ B_q :=
      Algebra.FormallyUnramified.localization_base p.primeCompl
    have : Algebra.EssFiniteType A₀ B_q := Algebra.EssFiniteType.comp A₀ B B_q
    have : Algebra.EssFiniteType A₁ B_q := Algebra.EssFiniteType.of_comp A₀ A₁ B_q
    have hUnram_max :=
      (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := A₁) (S := B_q)).mp hUnram
    refine ⟨hTF, hUnram, hUnram_max.1, hUnram_max.2, ?_⟩
    have hZMP : Algebra.ZariskisMainProperty A₀ q.asIdeal :=
      Algebra.ZariskisMainProperty.of_finiteType (R := A₀) q.asIdeal
    obtain ⟨r, hr_not_q, hr_int, hr_sat⟩ := Algebra.zariskisMainProperty_iff.mp hZMP
    obtain ⟨G, hG_top⟩ := (inferInstance : Algebra.FiniteType A₀ B).out
    choose m_fn hm_fn using hr_sat
    let G_fin : Finset B_q :=
      insert (algebraMap B B_q r) (G.image fun b => algebraMap B B_q (r ^ m_fn b * b))
    let R_sub : Subalgebra A₁ B_q := Algebra.adjoin A₁ (G_fin : Set B_q)
    have hG_int : ∀ y ∈ (G_fin : Set B_q), IsIntegral A₁ y := by
      intro y hy
      simp only [G_fin, Finset.coe_insert, Finset.coe_image, Set.mem_insert_iff,
        Set.mem_image, Finset.mem_coe] at hy
      rcases hy with rfl | ⟨b, _, rfl⟩
      · exact IsIntegral.tower_top (hr_int.map (IsScalarTower.toAlgHom A₀ B B_q))
      · exact IsIntegral.tower_top ((hm_fn b).map (IsScalarTower.toAlgHom A₀ B B_q))
    have : Algebra.IsIntegral A₁ ↥R_sub := Algebra.IsIntegral.adjoin hG_int
    have : Algebra.FiniteType A₁ ↥R_sub :=
      Algebra.FiniteType.adjoin_of_finite (G_fin.finite_toSet)
    have hFin_sub : Module.Finite A₁ ↥R_sub := Algebra.IsIntegral.finite
    have hr_in : algebraMap B B_q r ∈ R_sub :=
      Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_insert_self _ _))
    have hClear : ∀ b : B, ∃ M : ℕ,
        (algebraMap B B_q r) ^ M * algebraMap B B_q b ∈ R_sub := by
      intro b
      have hb_top : b ∈ Algebra.adjoin A₀ (G : Set B) := by rw [hG_top]; trivial
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hb_top
      · intro x hx
        refine ⟨m_fn x, ?_⟩
        rw [← map_pow, ← map_mul]
        exact Algebra.subset_adjoin (Finset.mem_coe.mpr
          (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hx)))
      · intro a
        refine ⟨0, ?_⟩
        rw [pow_zero, one_mul, ← IsScalarTower.algebraMap_apply A₀ B B_q a,
          IsScalarTower.algebraMap_apply A₀ A₁ B_q a]
        exact R_sub.algebraMap_mem _
      · intro x y _ _ ⟨M₁, h₁⟩ ⟨M₂, h₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have h_eq : (algebraMap B B_q r) ^ (M₁ + M₂) * algebraMap B B_q (x + y) =
            (algebraMap B B_q r) ^ M₂ * ((algebraMap B B_q r) ^ M₁ * algebraMap B B_q x) +
            (algebraMap B B_q r) ^ M₁ * ((algebraMap B B_q r) ^ M₂ * algebraMap B B_q y) := by
          rw [map_add, pow_add]; ring
        rw [h_eq]
        exact R_sub.add_mem (R_sub.mul_mem (R_sub.pow_mem hr_in M₂) h₁)
          (R_sub.mul_mem (R_sub.pow_mem hr_in M₁) h₂)
      · intro x y _ _ ⟨M₁, h₁⟩ ⟨M₂, h₂⟩
        refine ⟨M₁ + M₂, ?_⟩
        have h_eq : (algebraMap B B_q r) ^ (M₁ + M₂) * algebraMap B B_q (x * y) =
            ((algebraMap B B_q r) ^ M₁ * algebraMap B B_q x) *
            ((algebraMap B B_q r) ^ M₂ * algebraMap B B_q y) := by
          rw [map_mul, pow_add]; ring
        rw [h_eq]
        exact R_sub.mul_mem h₁ h₂
    let alg_sub : Algebra ↥R_sub B_q := R_sub.val.toRingHom.toAlgebra
    let _ := alg_sub
    have hTower_sub : IsScalarTower A₁ ↥R_sub B_q := IsScalarTower.of_algebraMap_eq fun _ => rfl
    let q_sub : Ideal ↥R_sub := Ideal.comap (algebraMap ↥R_sub B_q) (IsLocalRing.maximalIdeal B_q)
    have hLoc_sub : IsLocalization q_sub.primeCompl B_q := by
      refine ⟨?_, ?_, ?_⟩
      · intro t; exact IsLocalRing.notMem_maximalIdeal.mp t.2
      · intro z
        obtain ⟨⟨u, v⟩, huv⟩ := IsLocalization.surj q.asIdeal.primeCompl z
        obtain ⟨M₁, hM₁⟩ := hClear u
        obtain ⟨M₂, hM₂⟩ := hClear v.1
        let x₀ : ↥R_sub := ⟨(algebraMap B B_q r) ^ M₂ * ((algebraMap B B_q r) ^ M₁ * algebraMap B B_q u),
          R_sub.mul_mem (R_sub.pow_mem hr_in M₂) hM₁⟩
        let s₀_val : B_q := (algebraMap B B_q r) ^ M₁ * ((algebraMap B B_q r) ^ M₂ * algebraMap B B_q v.1)
        have hs₀_mem : s₀_val ∈ R_sub := R_sub.mul_mem (R_sub.pow_mem hr_in M₁) hM₂
        have hs₀_not_max : s₀_val ∉ IsLocalRing.maximalIdeal B_q := by
          rw [IsLocalRing.notMem_maximalIdeal]
          have h_eq : s₀_val = algebraMap B B_q (r ^ (M₁ + M₂) * v.1) := by
            dsimp [s₀_val]; rw [map_mul, map_pow, pow_add]; ring
          rw [h_eq]
          have h_not_q : r ^ (M₁ + M₂) * v.1 ∉ q.asIdeal :=
            q.asIdeal.primeCompl.mul_mem (q.asIdeal.primeCompl.pow_mem hr_not_q _) v.2
          exact IsLocalization.map_units B_q (⟨r ^ (M₁ + M₂) * v.1, h_not_q⟩ : q.asIdeal.primeCompl)
        refine ⟨⟨x₀, ⟨⟨s₀_val, hs₀_mem⟩, hs₀_not_max⟩⟩, ?_⟩
        change z * s₀_val = x₀.1
        dsimp [s₀_val, x₀]
        calc
          z * ((algebraMap B B_q r) ^ M₁ * ((algebraMap B B_q r) ^ M₂ * algebraMap B B_q v.1)) =
              (algebraMap B B_q r) ^ M₂ * ((algebraMap B B_q r) ^ M₁ * (z * algebraMap B B_q v.1)) := by ring
          _ = (algebraMap B B_q r) ^ M₂ * ((algebraMap B B_q r) ^ M₁ * algebraMap B B_q u) := by rw [huv]
      · intro x y hxy
        exact ⟨1, by simp [Subtype.ext hxy]⟩
    exact ⟨↥R_sub, inferInstance, inferInstance, alg_sub, hTower_sub,
      Subtype.val_injective, inferInstance, hFin_sub, hLoc_sub⟩
  
  have h_sec_mono :
      ∀ (A₁ B_q R₁ : Type u) [CommRing A₁] [IsLocalRing A₁]
        [CommRing B_q] [IsLocalRing B_q] [Algebra A₁ B_q] [IsLocalHom (algebraMap A₁ B_q)]
        [CommRing R₁] [Algebra A₁ R₁] [Algebra R₁ B_q] [IsScalarTower A₁ R₁ B_q],
        Algebra.IsSeparable (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q) →
        Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal B_q →
        Function.Injective (algebraMap R₁ B_q) →
        ∀ [Algebra.IsIntegral A₁ R₁],
        Module.Finite A₁ R₁ →
        IsLocalization
          (Ideal.comap (algebraMap R₁ B_q) (IsLocalRing.maximalIdeal B_q)).primeCompl B_q →
        ∃ (θ : B_q),
          IsIntegral A₁ θ ∧
          IsLocalization
            (Ideal.comap (algebraMap ↥(Algebra.adjoin A₁ ({θ} : Set B_q)) B_q)
              (IsLocalRing.maximalIdeal B_q)).primeCompl
            B_q := by
    intro A₁ B_q R₁ _ _ _ _ _ _ _ _ _ _ hSep hMapMax hInj_R₁ _ hFin_R₁ hLoc_R₁
    classical
    let _ := hSep
    let _ := hLoc_R₁
    let q₀ : Ideal R₁ := Ideal.comap (algebraMap R₁ B_q) (IsLocalRing.maximalIdeal B_q)
    have : q₀.IsPrime := Ideal.comap_isPrime _ _
    let I₁ : Ideal R₁ := Ideal.map (algebraMap A₁ R₁) (IsLocalRing.maximalIdeal A₁)
    have hI₁_le_q₀ : I₁ ≤ q₀ := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      change algebraMap R₁ B_q (algebraMap A₁ R₁ a) ∈ IsLocalRing.maximalIdeal B_q
      rw [← IsScalarTower.algebraMap_apply A₁ R₁ B_q a, ← hMapMax]
      exact Ideal.mem_map_of_mem _ ha
    obtain ⟨F₀, _, _, _, mk_F₀, hSurj_mkF₀, hKer_mkF₀⟩ :
        ∃ (F₀ : Type u) (_ : CommRing F₀) (_ : IsArtinianRing F₀) (_ : IsNoetherianRing F₀)
          (mk_F₀ : R₁ →+* F₀),
          Function.Surjective mk_F₀ ∧ RingHom.ker mk_F₀ = I₁ := by
      let ψ_F₀ : IsLocalRing.ResidueField A₁ →+* (R₁ ⧸ I₁) :=
        Ideal.Quotient.lift (IsLocalRing.maximalIdeal A₁)
          ((Ideal.Quotient.mk I₁).comp (algebraMap A₁ R₁))
          (fun _ ha => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha))
      refine (fun (S : Type u) [CommRing S]
          (mk_S : R₁ →+* S) (hSurj_S : Function.Surjective mk_S) (hKer_S : RingHom.ker mk_S = I₁)
          (ψ : IsLocalRing.ResidueField A₁ →+* S)
          (hψ : ∀ a : A₁, ψ (IsLocalRing.residue A₁ a) = mk_S (algebraMap A₁ R₁ a)) => ?_)
        (R₁ ⧸ I₁) (Ideal.Quotient.mk I₁) Ideal.Quotient.mk_surjective Ideal.mk_ker ψ_F₀ (fun _ => rfl)
      let _ : Algebra (IsLocalRing.ResidueField A₁) S := ψ.toAlgebra
      obtain ⟨⟨S_R₁, hS_R₁⟩⟩ := hFin_R₁
      have hFG_k : (⊤ : Submodule (IsLocalRing.ResidueField A₁) S).FG := by
        refine ⟨S_R₁.image mk_S, ?_⟩
        rw [eq_top_iff]
        intro z _
        obtain ⟨w, rfl⟩ := hSurj_S z
        have hw : w ∈ Submodule.span A₁ (S_R₁ : Set R₁) := by rw [hS_R₁]; trivial
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
        · intro x hx
          exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hx))
        · simp
        · intro x y _ _ ihx ihy
          rw [map_add]; exact Submodule.add_mem _ ihx ihy
        · intro a x _ ih
          rw [Algebra.smul_def, map_mul, ← hψ a]
          exact Submodule.smul_mem _ (IsLocalRing.residue A₁ a) ih
      have : Module.Finite (IsLocalRing.ResidueField A₁) S := ⟨hFG_k⟩
      have : IsArtinianRing S := isArtinian_of_tower (IsLocalRing.ResidueField A₁) inferInstance
      exact ⟨S, inferInstance, inferInstance, inferInstance, mk_S, hSurj_S, hKer_S⟩
    let q_bar0 : Ideal F₀ := Ideal.map mk_F₀ q₀
    have : q_bar0.IsPrime :=
      Ideal.map_isPrime_of_surjective hSurj_mkF₀ (by rwa [hKer_mkF₀])
    have hq_bar0_max : q_bar0.IsMaximal := IsArtinianRing.isMaximal_of_isPrime q_bar0
    have hq_bar0_comap : Ideal.comap mk_F₀ q_bar0 = q₀ := by
      rw [Ideal.comap_map_of_surjective mk_F₀ hSurj_mkF₀,
        ← RingHom.ker_eq_comap_bot, hKer_mkF₀, sup_eq_left.mpr hI₁_le_q₀]
    let π_R₁ : R₁ →+* IsLocalRing.ResidueField B_q :=
      (IsLocalRing.residue B_q).comp (algebraMap R₁ B_q)
    have hSurj_πR₁ : Function.Surjective π_R₁ := by
      intro z_bar
      obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective z_bar
      obtain ⟨⟨x, s⟩, hzs⟩ := IsLocalization.surj q₀.primeCompl z
      have hs_not_qbar : mk_F₀ s.1 ∉ q_bar0 := by
        rw [← Ideal.mem_comap, hq_bar0_comap]; exact s.2
      have h_ne_qbar : q_bar0 < q_bar0 ⊔ Ideal.span {mk_F₀ s.1} := by
        refine lt_of_le_of_ne le_sup_left (fun h_eq => hs_not_qbar ?_)
        rw [h_eq]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
      have hsup : q_bar0 ⊔ Ideal.span {mk_F₀ s.1} = ⊤ :=
        hq_bar0_max.out.2 _ h_ne_qbar
      have h1_mem : (1 : F₀) ∈ q_bar0 ⊔ Ideal.span {mk_F₀ s.1} := by rw [hsup]; trivial
      obtain ⟨m_b, hm_b, d_b, hd_b, hmc⟩ := Submodule.mem_sup.mp h1_mem
      obtain ⟨c_b, rfl⟩ := Ideal.mem_span_singleton'.mp hd_b
      obtain ⟨w, rfl⟩ := hSurj_mkF₀ c_b
      let s_r : R₁ := s.1
      have h1_ws : 1 - w * s_r ∈ q₀ := by
        rw [← hq_bar0_comap, Ideal.mem_comap]
        have h_eq : mk_F₀ (1 - w * s_r) = m_b := by
          dsimp [s_r]; rw [map_sub, map_one, map_mul, ← hmc, add_sub_cancel_right]
        rwa [h_eq]
      have hπ_ws : π_R₁ w * π_R₁ s.1 = 1 := by
        have h0 : π_R₁ (1 - w * s_r) = 0 := by
          change IsLocalRing.residue B_q (algebraMap R₁ B_q (1 - w * s_r)) = 0
          rwa [← RingHom.mem_ker, IsLocalRing.ker_residue]
        dsimp [s_r] at h0
        rw [map_sub, map_one, map_mul, sub_eq_zero] at h0
        exact h0.symm
      refine ⟨x * w, ?_⟩
      have hzs_res := congrArg (IsLocalRing.residue B_q) hzs
      rw [map_mul] at hzs_res
      change IsLocalRing.residue B_q z * π_R₁ s.1 = π_R₁ x at hzs_res
      calc
        π_R₁ (x * w) = π_R₁ x * π_R₁ w := map_mul _ _ _
        _ = (IsLocalRing.residue B_q z * π_R₁ s.1) * π_R₁ w := by rw [← hzs_res]
        _ = IsLocalRing.residue B_q z * (π_R₁ w * π_R₁ s.1) := by ring
        _ = IsLocalRing.residue B_q z := by rw [hπ_ws, mul_one]
    let π_R₁_alg : R₁ →ₐ[A₁] IsLocalRing.ResidueField B_q :=
      (Ideal.Quotient.mkₐ A₁ (IsLocalRing.maximalIdeal B_q)).comp (IsScalarTower.toAlgHom A₁ R₁ B_q)
    have : Module.Finite A₁ (IsLocalRing.ResidueField B_q) :=
      Module.Finite.of_surjective π_R₁_alg.toLinearMap hSurj_πR₁
    have : Module.Finite (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q) :=
      Module.Finite.of_restrictScalars_finite A₁
        (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q)
    have hAnn_map : ∀ v ∈ Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁),
        ∃ (t : q₀.primeCompl) (u : R₁), u ∈ I₁ ∧ v * algebraMap R₁ B_q t.1 = algebraMap R₁ B_q u := by
      intro v hv
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hv
      · rintro _ ⟨a, ha, rfl⟩
        refine ⟨1, algebraMap A₁ R₁ a, Ideal.mem_map_of_mem _ ha, ?_⟩
        change algebraMap A₁ B_q a * algebraMap R₁ B_q 1 = algebraMap R₁ B_q (algebraMap A₁ R₁ a)
        rw [map_one, mul_one, IsScalarTower.algebraMap_apply A₁ R₁ B_q a]
      · exact ⟨1, 0, I₁.zero_mem, by simp⟩
      · rintro v₁ v₂ _ _ ⟨t₁, u₁, hu₁, h₁⟩ ⟨t₂, u₂, hu₂, h₂⟩
        refine ⟨t₁ * t₂, u₁ * t₂.1 + u₂ * t₁.1,
          I₁.add_mem (I₁.mul_mem_right _ hu₁) (I₁.mul_mem_right _ hu₂), ?_⟩
        change (v₁ + v₂) * algebraMap R₁ B_q (t₁.1 * t₂.1) = _
        rw [map_mul, map_add, map_mul, map_mul]
        calc
          (v₁ + v₂) * (algebraMap R₁ B_q t₁.1 * algebraMap R₁ B_q t₂.1) =
              (v₁ * algebraMap R₁ B_q t₁.1) * algebraMap R₁ B_q t₂.1 +
              (v₂ * algebraMap R₁ B_q t₂.1) * algebraMap R₁ B_q t₁.1 := by ring
          _ = algebraMap R₁ B_q u₁ * algebraMap R₁ B_q t₂.1 +
              algebraMap R₁ B_q u₂ * algebraMap R₁ B_q t₁.1 := by rw [h₁, h₂]
      · rintro b v₁ _ ⟨t₁, u₁, hu₁, h₁⟩
        obtain ⟨⟨x_b, s_b⟩, h_bs⟩ := IsLocalization.surj q₀.primeCompl b
        refine ⟨s_b * t₁, x_b * u₁, I₁.mul_mem_left _ hu₁, ?_⟩
        change (b • v₁) * algebraMap R₁ B_q (s_b.1 * t₁.1) = _
        rw [smul_eq_mul, map_mul, map_mul]
        calc
          (b * v₁) * (algebraMap R₁ B_q s_b.1 * algebraMap R₁ B_q t₁.1) =
              (b * algebraMap R₁ B_q s_b.1) * (v₁ * algebraMap R₁ B_q t₁.1) := by ring
          _ = algebraMap R₁ B_q x_b * algebraMap R₁ B_q u₁ := by rw [h_bs, h₁]
    have hAnn_qbar : ∀ g ∈ q_bar0, ∃ t_bar : F₀, t_bar ∉ q_bar0 ∧ t_bar * g = 0 := by
      intro g hg
      obtain ⟨w, rfl⟩ := hSurj_mkF₀ g
      have hw_q₀ : w ∈ q₀ := by rwa [← hq_bar0_comap, Ideal.mem_comap]
      have hw_max : algebraMap R₁ B_q w ∈ Ideal.map (algebraMap A₁ B_q) (IsLocalRing.maximalIdeal A₁) := by
        rw [hMapMax]; exact hw_q₀
      obtain ⟨t, u, hu, h_eq⟩ := hAnn_map (algebraMap R₁ B_q w) hw_max
      have hwt : t.1 * w = u := hInj_R₁ (by rw [map_mul, mul_comm, h_eq])
      refine ⟨mk_F₀ t.1, ?_, ?_⟩
      · rw [← Ideal.mem_comap, hq_bar0_comap]; exact t.2
      · rw [← map_mul, hwt, ← RingHom.mem_ker, hKer_mkF₀]; exact hu
    obtain ⟨e₀, h1_sub_e₀, he₀_ann⟩ :
        ∃ e₀ : F₀, 1 - e₀ ∈ q_bar0 ∧ ∀ y ∈ q_bar0, e₀ * y = 0 := by
      obtain ⟨G_q, hGq_span⟩ := IsNoetherian.noetherian q_bar0
      choose t_bar ht_not_q ht_mul_zero using hAnn_qbar
      let s_F : F₀ := ∏ g ∈ G_q.attach, t_bar g.1 (by rw [← hGq_span]; exact Ideal.subset_span g.2)
      have hs_F_not_q : s_F ∉ q_bar0 := by
        intro hmem
        obtain ⟨g, _, hg_mem⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
        exact ht_not_q g.1 _ hg_mem
      have hs_F_ann : ∀ y ∈ q_bar0, s_F * y = 0 := by
        intro y hy
        rw [← hGq_span] at hy
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
        · intro x hx
          have hx_att : (⟨x, hx⟩ : {z // z ∈ G_q}) ∈ G_q.attach := Finset.mem_attach _ _
          obtain ⟨c_prod, hc_prod⟩ := Finset.dvd_prod_of_mem
            (fun g : {z // z ∈ G_q} => t_bar g.1 (by rw [← hGq_span]; exact Ideal.subset_span g.2)) hx_att
          change s_F = _ * c_prod at hc_prod
          rw [hc_prod, mul_right_comm, ht_mul_zero, zero_mul]
        · simp
        · intro x₁ x₂ _ _ ih₁ ih₂
          rw [mul_add, ih₁, ih₂, add_zero]
        · intro c x _ ih
          rw [smul_eq_mul, ← mul_assoc, mul_comm s_F c, mul_assoc, ih, mul_zero]
      have h_ne_sF : q_bar0 < q_bar0 ⊔ Ideal.span {s_F} := by
        refine lt_of_le_of_ne le_sup_left (fun h_eq => hs_F_not_q ?_)
        rw [h_eq]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
      have h1_sF : (1 : F₀) ∈ q_bar0 ⊔ Ideal.span {s_F} := by
        rw [hq_bar0_max.out.2 _ h_ne_sF]; trivial
      obtain ⟨m_e, hm_e, d_e, hd_e, hm_ce⟩ := Submodule.mem_sup.mp h1_sF
      obtain ⟨c_e, rfl⟩ := Ideal.mem_span_singleton'.mp hd_e
      refine ⟨c_e * s_F, ?_, ?_⟩
      · have : 1 - c_e * s_F = m_e := by rw [← hm_ce, add_sub_cancel_right]
        rwa [this]
      · intro y hy; rw [mul_assoc, hs_F_ann y hy, mul_zero]
    obtain ⟨α_bar, hα_ne, hα_adjoin⟩ :
        ∃ α_bar : IsLocalRing.ResidueField B_q,
          α_bar ≠ 0 ∧
          Algebra.adjoin (IsLocalRing.ResidueField A₁) ({α_bar} : Set _) = ⊤ := by
      obtain ⟨α₀, hα₀⟩ := Field.exists_primitive_element
        (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q)
      let α_b : IsLocalRing.ResidueField B_q := if α₀ = 0 then 1 else α₀
      have hne : α_b ≠ 0 := by
        by_cases h0 : α₀ = 0 <;> simp [α_b, h0]
      refine ⟨α_b, hne, ?_⟩
      let S_α := Algebra.adjoin (IsLocalRing.ResidueField A₁)
        ({α_b} : Set (IsLocalRing.ResidueField B_q))
      have h_inv_mem : ∀ x ∈ S_α, x ≠ 0 → x⁻¹ ∈ S_α := by
        intro x hx hx0
        have : FiniteDimensional (IsLocalRing.ResidueField A₁) ↥S_α :=
          Submodule.finiteDimensional_of_le (le_top : S_α.toSubmodule ≤ ⊤)
        let mul_x : ↥S_α →ₗ[IsLocalRing.ResidueField A₁] ↥S_α :=
          LinearMap.mulLeft (IsLocalRing.ResidueField A₁) ⟨x, hx⟩
        have hInj_mx : Function.Injective mul_x := by
          intro u v huv
          apply Subtype.ext
          exact mul_left_cancel₀ hx0 (congrArg Subtype.val huv)
        obtain ⟨y_inv, hy_inv⟩ := LinearMap.surjective_of_injective hInj_mx 1
        have hy_eq : x⁻¹ = y_inv.1 := inv_eq_of_mul_eq_one_right (congrArg Subtype.val hy_inv)
        rw [hy_eq]; exact y_inv.2
      have h_inv_mem' : ∀ x ∈ S_α.carrier, x⁻¹ ∈ S_α.carrier := by
        intro x hx
        by_cases hx0 : x = 0
        · rw [hx0, inv_zero]; exact S_α.zero_mem
        · exact h_inv_mem x hx hx0
      let S_if : IntermediateField (IsLocalRing.ResidueField A₁) (IsLocalRing.ResidueField B_q) :=
        { toSubalgebra := S_α, inv_mem' := h_inv_mem' }
      have h_if_top : S_if = ⊤ := by
        rw [eq_top_iff, ← hα₀, IntermediateField.adjoin_le_iff]
        intro x hx
        rw [Set.mem_singleton_iff.mp hx]
        by_cases h0 : α₀ = 0
        · rw [h0]; exact S_α.zero_mem
        · have hα_eq : α₀ = α_b := by simp [α_b, h0]
          rw [hα_eq]; exact Algebra.self_mem_adjoin_singleton _ α_b
      rw [eq_top_iff]
      intro z _
      have hz : z ∈ S_if := by rw [h_if_top]; trivial
      exact hz
    obtain ⟨w_α, hw_α⟩ := hSurj_πR₁ α_bar
    obtain ⟨θ₀, hθ₀_mk⟩ := hSurj_mkF₀ (mk_F₀ w_α * e₀)
    obtain ⟨θ, hθ_def⟩ : ∃ θ : B_q, θ = algebraMap R₁ B_q θ₀ := ⟨_, rfl⟩
    have hInt_θ : IsIntegral A₁ θ := by
      rw [hθ_def]
      exact (Algebra.IsIntegral.isIntegral θ₀).map (IsScalarTower.toAlgHom A₁ R₁ B_q)
    have hRes_θ : IsLocalRing.residue B_q θ = α_bar := by
      rw [hθ_def]
      have hdiff_ker : θ₀ - w_α ∈ q₀ := by
        rw [← hq_bar0_comap, Ideal.mem_comap, map_sub, hθ₀_mk]
        have h_eq : mk_F₀ w_α * e₀ - mk_F₀ w_α = -(mk_F₀ w_α * (1 - e₀)) := by ring
        rw [h_eq]
        exact q_bar0.neg_mem (q_bar0.mul_mem_left _ h1_sub_e₀)
      have hres_diff : π_R₁ (θ₀ - w_α) = 0 := by
        change IsLocalRing.residue B_q (algebraMap R₁ B_q (θ₀ - w_α)) = 0
        rwa [← RingHom.mem_ker, IsLocalRing.ker_residue]
      rw [map_sub, sub_eq_zero] at hres_diff
      exact hres_diff.trans hw_α
    have hθ₀_not_q₀ : θ₀ ∉ q₀ := by
      intro hmem
      have h0 : IsLocalRing.residue B_q θ = 0 := by
        rw [hθ_def]
        rwa [← RingHom.mem_ker, IsLocalRing.ker_residue]
      exact hα_ne (hRes_θ.symm.trans h0)
    let S₀ : Subalgebra A₁ R₁ := Algebra.adjoin A₁ ({θ₀} : Set R₁)
    let p₀ : Ideal ↥S₀ := Ideal.comap S₀.val.toRingHom q₀
    have : p₀.IsPrime := Ideal.comap_isPrime _ _
    have : Algebra.IsIntegral ↥S₀ R₁ := Algebra.IsIntegral.tower_top A₁
    have hUnique_over : ∀ (Q' : Ideal R₁) [Q'.IsPrime],
        Ideal.under ↥S₀ Q' ≤ p₀ → Q' ≤ q₀ := by
      intro Q' _ h_under
      obtain ⟨Q'', hQ'_le, hQ''_prime, hQ''_under⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral p₀ Q' h_under
      let _ := hQ''_prime
      have hI₁_le_Q'' : I₁ ≤ Q'' := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        have ha_p₀ : algebraMap A₁ ↥S₀ a ∈ p₀ := by
          change algebraMap R₁ B_q (algebraMap A₁ R₁ a) ∈ IsLocalRing.maximalIdeal B_q
          rw [← IsScalarTower.algebraMap_apply A₁ R₁ B_q a, ← hMapMax]
          exact Ideal.mem_map_of_mem _ ha
        rw [← hQ''_under] at ha_p₀
        exact ha_p₀
      let Q_bar'' : Ideal F₀ := Ideal.map mk_F₀ Q''
      have hQbar_prime : Q_bar''.IsPrime :=
        Ideal.map_isPrime_of_surjective hSurj_mkF₀ (by rwa [hKer_mkF₀])
      have hQ''_comap : Ideal.comap mk_F₀ Q_bar'' = Q'' := by
        rw [Ideal.comap_map_of_surjective mk_F₀ hSurj_mkF₀,
          ← RingHom.ker_eq_comap_bot, hKer_mkF₀, sup_eq_left.mpr hI₁_le_Q'']
      have hQbar_eq : Q_bar'' = q_bar0 := by
        by_contra hne
        have h_not_le : ¬ (q_bar0 ≤ Q_bar'') :=
          fun hle => hne (hq_bar0_max.eq_of_le hQbar_prime.ne_top hle).symm
        obtain ⟨y, hy_q, hy_not_Q⟩ := Set.not_subset.mp h_not_le
        have he_mul : e₀ * y ∈ Q_bar'' := by
          rw [he₀_ann y hy_q]; exact Q_bar''.zero_mem
        have he_in_Q : e₀ ∈ Q_bar'' :=
          (hQbar_prime.mem_or_mem he_mul).resolve_right hy_not_Q
        have hθ_bar_in_Q : mk_F₀ θ₀ ∈ Q_bar'' := by
          rw [hθ₀_mk]; exact Q_bar''.mul_mem_left _ he_in_Q
        have hθ_in_Q'' : θ₀ ∈ Q'' := by
          rwa [← hQ''_comap, Ideal.mem_comap]
        have hθ_in_p₀ : (⟨θ₀, Algebra.self_mem_adjoin_singleton A₁ θ₀⟩ : ↥S₀) ∈ p₀ := by
          rw [← hQ''_under]; exact hθ_in_Q''
        exact hθ₀_not_q₀ hθ_in_p₀
      have hQ''_eq : Q'' = q₀ := by
        rw [← hQ''_comap, hQbar_eq, hq_bar0_comap]
      rwa [← hQ''_eq]
    let M₀ : Submonoid R₁ := p₀.primeCompl.map S₀.val.toMonoidHom
    have hClear_M₀ : ∀ t : q₀.primeCompl, ∃ (s : p₀.primeCompl) (u : R₁),
        t.1 * u = S₀.val s.1 := by
      intro t
      let T₀ := Localization M₀
      have h_unit_T₀ : IsUnit (algebraMap R₁ T₀ t.1) := by
        by_contra h_not_u
        have h_ne_top : Ideal.span {algebraMap R₁ T₀ t.1} ≠ ⊤ :=
          mt Ideal.span_singleton_eq_top.mp h_not_u
        obtain ⟨M_max, hM_max, h_le_M⟩ := Ideal.exists_le_maximal _ h_ne_top
        have _ : M_max.IsPrime := hM_max.isPrime
        let Q' : Ideal R₁ := Ideal.comap (algebraMap R₁ T₀) M_max
        have _ : Q'.IsPrime := Ideal.comap_isPrime _ _
        have h_under : Ideal.under ↥S₀ Q' ≤ p₀ := by
          intro x hx
          by_contra hx_not
          have hm_unit : IsUnit (algebraMap R₁ T₀ (S₀.val x)) :=
            IsLocalization.map_units T₀ (⟨S₀.val x, x, hx_not, rfl⟩ : M₀)
          exact hM_max.ne_top (Ideal.eq_top_of_isUnit_mem _ hx hm_unit)
        have ht_in_Q' : t.1 ∈ Q' :=
          h_le_M (Ideal.subset_span (Set.mem_singleton _))
        exact t.2 (hUnique_over Q' h_under ht_in_Q')
      obtain ⟨u_inv, hu_inv⟩ := h_unit_T₀.exists_right_inv
      obtain ⟨⟨u₀, m₁⟩, hm₁_eq⟩ := IsLocalization.surj M₀ u_inv
      have h_eq_T₀ : IsLocalization.mk' T₀ (t.1 * u₀) (1 : M₀) =
          IsLocalization.mk' T₀ m₁.1 (1 : M₀) := by
        rw [IsLocalization.mk'_one, IsLocalization.mk'_one,
          map_mul, ← hm₁_eq, ← mul_assoc, hu_inv, one_mul]
      obtain ⟨m₂, hm₂_eq⟩ := (IsLocalization.eq (M := M₀) (S := T₀)).mp h_eq_T₀
      obtain ⟨s₁, hs₁_not, hs₁_eq⟩ := m₁.2
      obtain ⟨s₂, hs₂_not, hs₂_eq⟩ := m₂.2
      refine ⟨⟨s₁ * s₂, p₀.primeCompl.mul_mem hs₁_not hs₂_not⟩, u₀ * m₂.1, ?_⟩
      calc
        t.1 * (u₀ * m₂.1) = m₂.1 * (1 * (t.1 * u₀)) := by ring
        _ = m₂.1 * (1 * m₁.1) := hm₂_eq
        _ = m₁.1 * m₂.1 := by ring
        _ = S₀.val (s₁ * s₂) := by
          rw [← hs₁_eq, ← hs₂_eq]; exact (map_mul S₀.val.toRingHom s₁ s₂).symm
    let S_θ : Subalgebra A₁ B_q := Algebra.adjoin A₁ ({θ} : Set B_q)
    let p_θ : Ideal ↥S_θ := Ideal.comap (algebraMap ↥S_θ B_q) (IsLocalRing.maximalIdeal B_q)
    have : p_θ.IsPrime := Ideal.comap_isPrime _ _
    have hS₀_in_Sθ : ∀ x : ↥S₀, algebraMap R₁ B_q x.1 ∈ S_θ := by
      rintro ⟨x, hx⟩
      refine Algebra.adjoin_induction (p := fun y _ => algebraMap R₁ B_q y ∈ S_θ) ?_ ?_ ?_ ?_ hx
      · intro y hy
        rw [Set.mem_singleton_iff.mp hy, ← hθ_def]
        exact Algebra.self_mem_adjoin_singleton A₁ θ
      · intro a
        rw [← IsScalarTower.algebraMap_apply A₁ R₁ B_q a]
        exact S_θ.algebraMap_mem a
      · intro x₁ x₂ _ _ ih₁ ih₂
        rw [map_add]; exact S_θ.add_mem ih₁ ih₂
      · intro x₁ x₂ _ _ ih₁ ih₂
        rw [map_mul]; exact S_θ.mul_mem ih₁ ih₂
    let C : Type u := Localization.AtPrime p_θ
    have hUnits_pθ : ∀ s : p_θ.primeCompl, IsUnit (algebraMap ↥S_θ B_q s.1) :=
      fun s => IsLocalRing.notMem_maximalIdeal.mp s.2
    obtain ⟨φ_C, hφ_C_eq⟩ :
        ∃ φ_C : C →+* B_q, ∀ x : ↥S_θ, φ_C (algebraMap ↥S_θ C x) = x.1 :=
      ⟨IsLocalization.lift hUnits_pθ, fun x => IsLocalization.lift_eq hUnits_pθ x⟩
    let _ : Algebra C B_q := φ_C.toAlgebra
    have hTower_A₁CBq : ∀ a : A₁, φ_C (algebraMap A₁ C a) = algebraMap A₁ B_q a := by
      intro a
      rw [IsScalarTower.algebraMap_apply A₁ ↥S_θ C a, hφ_C_eq]; rfl
    obtain ⟨⟨W_gen, hW_span⟩⟩ := hFin_R₁
    have hSpan_C : Submodule.span C ((fun w : R₁ => algebraMap R₁ B_q w) '' (W_gen : Set R₁)) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨⟨x, t⟩, hzt⟩ := IsLocalization.surj q₀.primeCompl z
      obtain ⟨s, u, htu⟩ := hClear_M₀ t
      let s_θ : ↥S_θ := ⟨algebraMap R₁ B_q (S₀.val s.1), hS₀_in_Sθ s.1⟩
      have hs_θ_not : s_θ ∉ p_θ := s.2
      let s_θ_pc : p_θ.primeCompl := ⟨s_θ, hs_θ_not⟩
