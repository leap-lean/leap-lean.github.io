    let PB := Limits.pullback p_R s_RS
    let p₁ : PB ⟶ AlgebraicGeometry.Proj 𝒜_R := Limits.pullback.fst p_R s_RS
    let p₂ : PB ⟶ AlgebraicGeometry.Spec (CommRingCat.of S) := Limits.pullback.snd p_R s_RS
    let Φ_lift : AlgebraicGeometry.Proj 𝒜_S ⟶ PB := Limits.pullback.lift Φ p_S hB1
