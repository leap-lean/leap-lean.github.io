    have hPb : CategoryTheory.IsPullback e_CK fst_W fst_K e_C := by
      have hOuter : CategoryTheory.IsPullback (e_CK ≫ snd_K) fst_W η_R (e_C ≫ g_R) := by
        rw [he_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback f_W η_R).flip
      exact CategoryTheory.IsPullback.of_right hOuter he_fst
        (CategoryTheory.IsPullback.of_hasPullback g_R η_R).flip
    let V_C : Set ↥C_R := e_C.base '' (U_W : Set ↥W)
    have hOpen_VC : IsOpen V_C := e_C.isOpenMap _ U_W.isOpen
    have hw₀_VC : e_C.base w₀ ∈ V_C := ⟨w₀, hw₀, rfl⟩
