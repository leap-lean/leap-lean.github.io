        have hSub_Ω : Subsingleton Ω[S₆⁄MvPolynomial (Fin 2) R] := by
          rw [subsingleton_iff_forall_eq 0]
          intro ω
          obtain ⟨ω', rfl⟩ := KaehlerDifferential.map_surjective R (MvPolynomial (Fin 2) R) S₆ ω
          rw [← hΦΨ ω']
