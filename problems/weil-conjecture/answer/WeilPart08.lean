                rw [hne] at hmem
                exact Finset.notMem_empty _ hmem
              obtain ⟨u, hu⟩ := hb_unit
              refine ⟨⟨↑(u⁻¹), ⟨1, Submonoid.one_mem _⟩⟩, ?_⟩
              change z * V.subtype 1 = V.subtype ↑(u⁻¹)
              have huK : z⁻¹ * V.subtype ↑(u⁻¹) = 1 := by
                have hmul : V.subtype (↑u * ↑(u⁻¹)) = 1 := by simp
                rw [map_mul, hu] at hmul
                exact hmul
              calc
                z * V.subtype 1 = z * 1 := by simp
                _ = z * (z⁻¹ * V.subtype ↑(u⁻¹)) := by rw [huK]
                _ = (z * z⁻¹) * V.subtype ↑(u⁻¹) := by ring
                _ = V.subtype ↑(u⁻¹) := by rw [mul_inv_cancel₀ hz0, one_mul]
        · intro x₁ x₂ h
          exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [Subtype.ext h]⟩
    obtain ⟨t₀, ht₀⟩ := hExAway
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ _ t₀ ht₀
  have : AlgebraicGeometry.IsProper g := hPropG
  have : AlgebraicGeometry.IsProper π_V := hProp_V
  have : AlgebraicGeometry.IsOpenImmersion ι :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.IsOpenImmersion.{u})
      hPb.flip hOpen_η
  have : AlgebraicGeometry.QuasiCompact ι :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.QuasiCompact.{u})
      hPb.flip inferInstance
  have hQC_comp : AlgebraicGeometry.QuasiCompact (φ ≫ π_V) := by
    change AlgebraicGeometry.QuasiCompact (φ ≫ (weilProjectiveSpaceOver ↥V N').hom)
    rw [hφ]
    infer_instance
  have : AlgebraicGeometry.QuasiCompact φ :=
    @AlgebraicGeometry.QuasiCompact.of_comp _ _ _ φ π_V hQC_comp inferInstance
  have : AlgebraicGeometry.QuasiCompact (ι ≫ φ) := inferInstance
  have : Nonempty ↥C_K := @AlgebraicGeometry.IsIntegral.nonempty C_K hIntCK
  have : AlgebraicGeometry.IsIntegral C := hIntC
  have hInt_φ : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Scheme.Hom.image φ) :=
    h_integral_img C P_V φ
  have hKer : AlgebraicGeometry.Scheme.Hom.ker φ = AlgebraicGeometry.Scheme.Hom.ker (ι ≫ φ) :=
    h_ker_eq C_K C P_V ι φ
  have hj_comm : (ι ≫ φ) ≫ π_V =
      p_K ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype) := by
    change (ι ≫ φ) ≫ (weilProjectiveSpaceOver ↥V N').hom = _
    rw [CategoryTheory.Category.assoc, hφ, hPb.w]
  obtain ⟨hFlat_j, hLFP_j⟩ :=
    h_flat_lfp K ↥V V.subtype Subtype.val_injective hPkg.2.2.2.2.2
      C_K P_V p_K π_V (ι ≫ φ) hj_comm N' (weilProjBasicOpen ↥V N')
      hCov_V hAff_V c_V hc_V hPoly_V
  have hFlat_φ : AlgebraicGeometry.Flat
      (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) := by
    change AlgebraicGeometry.Flat (φ.ker.subschemeι ≫ π_V)
    rw [hKer]
    exact hFlat_j
  have hLFP_φ : AlgebraicGeometry.LocallyOfFinitePresentation
      (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom) := by
    change AlgebraicGeometry.LocallyOfFinitePresentation (φ.ker.subschemeι ≫ π_V)
    rw [hKer]
    exact hLFP_j
  exact ⟨hInt_φ, hFlat_φ, hLFP_φ⟩

theorem weil_sup1_generic_fiber_pullback_iso (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hMod : IsValuationPointedCurveModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀)
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (hProjMap : IsUnstableP1ContractionProjMap V g Z V₀ V₁ eZ N' φ) :
    CategoryTheory.IsPullback
      (ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ)
      p_K
      (AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)) :=
by
  classical
  
  have helper_proj_proper_and_scalar : ∀ (R : Type u) [CommRing R] (N : ℕ),
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom ∧
      (∀ p : MvPolynomial (Fin (N + 1)) R, p ∈ 𝒜 0 → p = MvPolynomial.C (p.coeff 0)) ∧
      (∀ (p : (weilProjectiveSpaceOver R N).left) (c : R),
        c ∈ (((weilProjectiveSpaceOver R N).hom.base p) : PrimeSpectrum R).asIdeal ↔
          MvPolynomial.C c ∈ p.asHomogeneousIdeal.toIdeal) := by
    intro R _ N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have halg0 : ∀ r : R,
        (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r := by
      intro r
      rw [Algebra.algebraMap_eq_smul_one]
      change r • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r
      rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hdeg0_eq : ∀ p : MvPolynomial (Fin (N + 1)) R, p ∈ 𝒜 0 → p = MvPolynomial.C (p.coeff 0) := by
      intro p hp_mem
      ext m_idx
      by_cases hm : m_idx = 0
      · subst hm
        simp
      · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr (fun h => absurd h.symm hm)]
        by_contra hne
        have hp : p.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p).mp hp_mem
        have hdeg := hp hne
        simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
        have hne' : ∃ i : Fin (N + 1), m_idx i ≠ 0 := by
          by_contra hall
          exact hm (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
        rcases hne' with ⟨i, hi⟩
        exact hi ((Finset.sum_eq_zero_iff.mp hdeg) i (Finsupp.mem_support_iff.mpr hi))
    have hinj : Function.Injective (algebraMap R ↥(𝒜 0)) := by
      intro r₁ r₂ h
      have h1 : (algebraMap R ↥(𝒜 0) r₁ : MvPolynomial (Fin (N + 1)) R) =
          (algebraMap R ↥(𝒜 0) r₂ : MvPolynomial (Fin (N + 1)) R) := congrArg Subtype.val h
      rw [halg0, halg0] at h1
      simpa using congrArg MvPolynomial.constantCoeff h1
    have hsurj : Function.Surjective (algebraMap R ↥(𝒜 0)) := by
      intro p
      refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
      rw [halg0]
      exact (hdeg0_eq p.1 p.2).symm
    haveI : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))).mpr
        ⟨hinj, hsurj⟩
    haveI : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) :=
      inferInstance
    letI : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      IsScalarTower.of_algebraMap_eq' (R := R) (S := ↥(𝒜 0))
        (A := MvPolynomial (Fin (N + 1)) R) (RingHom.ext fun r => by
          change algebraMap R (MvPolynomial (Fin (N + 1)) R) r =
            (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R)
          rw [halg0, MvPolynomial.algebraMap_eq])
    haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
    have hProp : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom := by
      change AlgebraicGeometry.IsProper
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))))
      infer_instance
    have hIrrel : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) := by
      intro p hp
      have hp0_proj : GradedRing.proj 𝒜 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 p).mp hp
      have hp_sum : (∑ i ∈ (DirectSum.decompose 𝒜 p).support,
          (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R)) = p :=
        DirectSum.sum_support_decompose 𝒜 p
      have hcoeff0 : p.coeff 0 = 0 := by
        rw [← hp_sum, MvPolynomial.coeff_sum]
        apply Finset.sum_eq_zero
        intro i _
        by_cases hi : i = 0
        · subst hi
          have h0 : (DirectSum.decompose 𝒜 p 0 : MvPolynomial (Fin (N + 1)) R) = 0 := hp0_proj
          rw [h0]
          simp
        · have hmem_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R) ∈ 𝒜 i :=
            (DirectSum.decompose 𝒜 p i).2
          have hhom_i : (DirectSum.decompose 𝒜 p i : MvPolynomial (Fin (N + 1)) R).IsHomogeneous i :=
            (MvPolynomial.mem_homogeneousSubmodule i _).mp hmem_i
          by_contra hne0
          have hdeg0 := hhom_i hne0
          simp only [Finsupp.weight_apply, Finsupp.sum_zero_index] at hdeg0
          exact hi hdeg0.symm
      have hrange : (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) R)) =
          MvPolynomial.X '' (Set.univ : Set (Fin (N + 1))) := Set.image_univ.symm
      rw [hrange, MvPolynomial.mem_ideal_span_X_image]
      intro m_idx hm
      have hm_ne : m_idx ≠ 0 := by
        intro hm0
        subst hm0
        exact (MvPolynomial.mem_support_iff.mp hm) hcoeff0
      have hex : ∃ a : Fin (N + 1), m_idx a ≠ 0 := by
        by_contra hall
        exact hm_ne (Finsupp.ext fun a => Classical.not_not.mp fun h => hall ⟨a, h⟩)
      rcases hex with ⟨a, ha⟩
      exact ⟨a, Set.mem_univ a, ha⟩
    have hCov : (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X a)) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 MvPolynomial.X hIrrel
    refine ⟨hProp, hdeg0_eq, ?_⟩
    intro p c
    have hp_top : p ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜).Opens) := trivial
    rw [← hCov] at hp_top
    obtain ⟨a, hp_a⟩ := TopologicalSpace.Opens.mem_iSup.mp hp_top
    let X_a : MvPolynomial (Fin (N + 1)) R := MvPolynomial.X a
    have hXa_mem : X_a ∈ 𝒜 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 X_a).mpr (MvPolynomial.isHomogeneous_X R a)
    have hCcXa_mem : MvPolynomial.C c * X_a ∈ 𝒜 1 := by
      rw [MvPolynomial.mem_homogeneousSubmodule]
      simpa only [zero_add] using (MvPolynomial.isHomogeneous_C (Fin (N + 1)) c).mul
        (MvPolynomial.isHomogeneous_X R a)
    let iso := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 X_a hXa_mem zero_lt_one
    let q : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 X_a) := iso.hom.base ⟨p, hp_a⟩
    have hq_p : (AlgebraicGeometry.Proj.awayι 𝒜 X_a hXa_mem zero_lt_one).base q = p := by
      have h1 := congrArg (fun f : (AlgebraicGeometry.Proj.basicOpen 𝒜 X_a).toScheme ⟶
          (AlgebraicGeometry.Proj.basicOpen 𝒜 X_a).toScheme =>
        (AlgebraicGeometry.Proj.basicOpen 𝒜 X_a).ι.base (f.base ⟨p, hp_a⟩)) iso.hom_inv_id
      exact h1
    have hcomm : AlgebraicGeometry.Proj.awayι 𝒜 X_a hXa_mem zero_lt_one ≫
        (weilProjectiveSpaceOver R N).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers X_a)).comp
            (algebraMap R ↥(𝒜 0)))) := by
      change AlgebraicGeometry.Proj.awayι 𝒜 X_a hXa_mem zero_lt_one ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) = _
      rw [← Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜 X_a hXa_mem zero_lt_one,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    let z_c : HomogeneousLocalization.Away 𝒜 X_a :=
      HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers X_a) (algebraMap R ↥(𝒜 0) c)
    have hz_eq : HomogeneousLocalization.Away.isLocalizationElem hXa_mem hCcXa_mem = z_c := by
      apply HomogeneousLocalization.val_injective
      change Localization.mk ((MvPolynomial.C c * X_a) ^ 1)
          ⟨X_a ^ 1, Submonoid.pow_mem _ (Submonoid.mem_powers X_a) 1⟩ =
        Localization.mk (algebraMap R ↥(𝒜 0) c : MvPolynomial (Fin (N + 1)) R) 1
      rw [halg0, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp [pow_one, mul_comm]⟩
    have hlhs : c ∈ (((weilProjectiveSpaceOver R N).hom.base p) : PrimeSpectrum R).asIdeal ↔
        z_c ∈ q.asIdeal := by
      rw [← hq_p]
      have hbase := congrArg (fun f => f.base q) hcomm
      change c ∈ (((AlgebraicGeometry.Proj.awayι 𝒜 X_a hXa_mem zero_lt_one ≫
          (weilProjectiveSpaceOver R N).hom).base q) : PrimeSpectrum R).asIdeal ↔ _
      rw [hbase]
      rfl
    rw [hlhs]
    have hpre := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hXa_mem zero_lt_one
      hCcXa_mem zero_lt_one
    rw [hz_eq] at hpre
    have hnot_iff : z_c ∉ q.asIdeal ↔ MvPolynomial.C c ∉ p.asHomogeneousIdeal.toIdeal := by
      have hq_mem : q ∈ PrimeSpectrum.basicOpen z_c ↔
          p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.C c * X_a) := by
        rw [← hpre, ← hq_p]
        rfl
      have hp_xa_not : X_a ∉ p.asHomogeneousIdeal.toIdeal := hp_a
      change z_c ∉ q.asIdeal ↔ MvPolynomial.C c * X_a ∉ p.asHomogeneousIdeal.toIdeal at hq_mem
      rw [hq_mem]
      constructor
      · intro hmul hCc
        exact hmul (Ideal.mul_mem_right X_a _ hCc)
      · intro hCc hmul
        rcases p.isPrime.mem_or_mem hmul with h1 | h2
        · exact hCc h1
        · exact hp_xa_not h2
    exact not_iff_not.mp hnot_iff

  
  have helper_open_toSpecΓ_comm : ∀ (R : Type u) [CommRing R] (C_sch : AlgebraicGeometry.Scheme.{u})
      (g_sch : C_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)) (U_op : C_sch.Opens),
      U_op.toSpecΓ ≫ AlgebraicGeometry.Spec.map
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          AlgebraicGeometry.Scheme.Hom.appLE g_sch ⊤ U_op le_top) = U_op.ι ≫ g_sch := by
    intro R _ C_sch g_sch U_op
    let hle_g : U_op ≤ g_sch ⁻¹ᵁ ⊤ := fun _ _ => trivial
    let α := (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g_sch ⊤ U_op hle_g
    let h₁ : U_op.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
      U_op.toSpecΓ ≫ AlgebraicGeometry.Spec.map α
    let h₂ : U_op.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) := U_op.ι ≫ g_sch
    change h₁ = h₂
    have happ : h₁.appTop = h₂.appTop := by
      rw [← CategoryTheory.Iso.cancel_iso_hom_right _ _ U_op.topIso]
      have h_lhs : h₁.appTop ≫ U_op.topIso.hom =
          AlgebraicGeometry.Scheme.Hom.appLE g_sch ⊤ U_op hle_g := by
        dsimp only [h₁]
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_appTop,
          Category.assoc,
          Category.assoc,
          CategoryTheory.Iso.inv_hom_id,
          Category.comp_id,
          AlgebraicGeometry.Scheme.ΓSpecIso_naturality α]
        dsimp only [α]
        rw [CategoryTheory.Iso.hom_inv_id_assoc]
      have h_rhs : h₂.appTop ≫ U_op.topIso.hom =
          AlgebraicGeometry.Scheme.Hom.appLE g_sch ⊤ U_op hle_g := by
        dsimp only [h₂, AlgebraicGeometry.Scheme.Hom.appLE]
        rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, Category.assoc]
        congr 1
        have hι : U_op.ι.appTop = C_sch.presheaf.map
            (CategoryTheory.homOfLE (le_top : U_op.ι ''ᵁ ⊤ ≤ (⊤ : C_sch.Opens))).op :=
          AlgebraicGeometry.Scheme.Opens.ι_appTop U_op
        have htop : U_op.topIso.hom = C_sch.presheaf.map
            (CategoryTheory.eqToHom (by ext x; simp : U_op = U_op.ι ''ᵁ ⊤)).op :=
          AlgebraicGeometry.Scheme.Opens.topIso_hom U_op
        erw [hι, htop, ← C_sch.presheaf.map_comp]
        rfl
      rw [h_lhs, h_rhs]
    let e_adj := AlgebraicGeometry.ΓSpec.adjunction.homEquiv U_op.toScheme
      (Opposite.op (CommRingCat.of R))
    apply e_adj.symm.injective
    apply Quiver.Hom.unop_inj
    let φ₁ : CommRingCat.of R ⟶ U_op.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm h₁).unop
    let φ₂ : CommRingCat.of R ⟶ U_op.toScheme.presheaf.obj (Opposite.op ⊤) := (e_adj.symm h₂).unop
    have e1 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₁
    have e2 := AlgebraicGeometry.ΓSpecIso_inv_ΓSpec_adjunction_homEquiv φ₂
    have hh₁ : e_adj φ₁.op = h₁ := e_adj.apply_symm_apply h₁
    have hh₂ : e_adj φ₂.op = h₂ := e_adj.apply_symm_apply h₂
    rw [hh₁] at e1
    rw [hh₂] at e2
    change φ₁ = φ₂
    rw [← e1, ← e2, happ]

  
  have helper_chart_pullback_and_closed_finite :
      ∀ (hPb : CategoryTheory.IsPullback ι p_K g
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)))
        (V_i : C.Opens) (hAff_i : AlgebraicGeometry.IsAffineOpen V_i)
        (u_i : ↑(C.presheaf.obj (Opposite.op V_i))),
        (letI : Algebra ↥V ↑(C.presheaf.obj (Opposite.op V_i)) :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V_i le_top).hom).toAlgebra;
        (Polynomial.aeval (R := ↥V) u_i).toRingHom.Finite) →
        let R_i := C.presheaf.obj (Opposite.op V_i)
        letI : Algebra ↥V ↑R_i :=
          (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
            AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V_i le_top).hom).toAlgebra
        letI : Algebra ↥V K := V.subtype.toAlgebra
        let V_iK : C_K.Opens := ι ⁻¹ᵁ V_i
        (∃ Ψ_i : V_iK.toScheme ≅
            AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥V ↑R_i K)),
          Ψ_i.hom ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
            (ι ∣_ V_i) ≫ hAff_i.isoSpec.hom) ∧
        (∀ Z_cl : Set ↥C_K, IsClosed Z_cl → Z_cl ≠ Set.univ →
          (Z_cl ∩ (V_iK : Set ↥C_K)).Finite) := by
    intro hPb V_i hAff_i u_i hFin_u
    let R_i := C.presheaf.obj (Opposite.op V_i)
    let α_i : CommRingCat.of ↥V ⟶ R_i :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
        AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V_i le_top
    letI : Algebra ↥V ↑R_i := α_i.hom.toAlgebra
    letI : Algebra ↥V K := V.subtype.toAlgebra
    let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
    let V_iK : C_K.Opens := ι ⁻¹ᵁ V_i
    have hPb_res : CategoryTheory.IsPullback (ι ∣_ V_i) (V_iK.ι ≫ p_K) (V_i.ι ≫ g) η_V :=
      (AlgebraicGeometry.isPullback_morphismRestrict ι V_i).paste_vert hPb
    have hComm_i : hAff_i.isoSpec.hom ≫ AlgebraicGeometry.Spec.map α_i = V_i.ι ≫ g := by
      rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
      exact helper_open_toSpecΓ_comm ↥V C g V_i
    have hPb_spec : CategoryTheory.IsPullback ((ι ∣_ V_i) ≫ hAff_i.isoSpec.hom) (V_iK.ι ≫ p_K)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V ↑R_i)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V K))) :=
      CategoryTheory.IsPullback.of_iso hPb_res
        (CategoryTheory.Iso.refl V_iK.toScheme)
        hAff_i.isoSpec
        (CategoryTheory.Iso.refl _)
        (CategoryTheory.Iso.refl _)
        (Category.id_comp _).symm
        (Category.id_comp _).symm
        (by
          simp only [CategoryTheory.Iso.refl_hom, Category.comp_id]
          have hα : CommRingCat.ofHom (algebraMap ↥V ↑R_i) = α_i := CommRingCat.ofHom_hom α_i
          rw [hα]
          exact hComm_i.symm)
        (by simp [CategoryTheory.Iso.refl_hom]; rfl)
    let Ψ_i : V_iK.toScheme ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥V ↑R_i K)) :=
      hPb_spec.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso ↥V ↑R_i K
    have hΨ_fst : Ψ_i.hom ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
        (ι ∣_ V_i) ≫ hAff_i.isoSpec.hom := by
      dsimp only [Ψ_i, Iso.trans_hom]
      rw [Category.assoc, ← AlgebraicGeometry.pullbackSpecIso_inv_fst ↥V ↑R_i K,
        Iso.hom_inv_id_assoc, CategoryTheory.IsPullback.isoPullback_hom_fst]
    refine ⟨⟨Ψ_i, hΨ_fst⟩, ?_⟩
    intro Z_cl hZ_closed hZ_ne
    by_cases hNe : Nonempty ↥V_iK.toScheme
    · haveI : Nonempty ↥V_iK.toScheme := hNe
      obtain ⟨v₀⟩ := hNe
      haveI : AlgebraicGeometry.IsIntegral C_K := hIntCK
      haveI : AlgebraicGeometry.IsIntegral V_iK.toScheme :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion V_iK.ι
      let A_i := TensorProduct ↥V ↑R_i K
      haveI : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of A_i)) := ⟨Ψ_i.hom.base v₀⟩
      haveI : AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of A_i)) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion Ψ_i.inv
      haveI : IsDomain A_i :=
        (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of A_i)).mp inferInstance
      have hIrredCK : IrreducibleSpace ↥C_K :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K
      haveI : PreirreducibleSpace ↥C_K := hIrredCK.toPreirreducibleSpace
      have hDenseViK : Dense (V_iK : Set ↥C_K) :=
        V_iK.isOpen.dense ⟨v₀.1, v₀.2⟩
      have hNotSub : ¬ ((V_iK : Set ↥C_K) ⊆ Z_cl) := by
        intro hsub
        apply hZ_ne
        rw [← Set.univ_subset_iff, ← hDenseViK.closure_eq]
        exact closure_minimal hsub hZ_closed
      let Z_i : Set (PrimeSpectrum A_i) :=
        Ψ_i.inv.base ⁻¹' (V_iK.ι.base ⁻¹' Z_cl)
      have hZi_closed : IsClosed Z_i :=
        (hZ_closed.preimage V_iK.ι.continuous).preimage Ψ_i.inv.continuous
      have hZi_ne : Z_i ≠ Set.univ := by
        intro huniv
        apply hNotSub
        intro x hx
        let q : PrimeSpectrum A_i := Ψ_i.hom.base ⟨x, hx⟩
        have hq_mem : q ∈ Z_i := by
          rw [huniv]
          trivial
        have hinv_hom : Ψ_i.inv.base q = ⟨x, hx⟩ :=
          congrArg (fun f : V_iK.toScheme ⟶ V_iK.toScheme => f.base ⟨x, hx⟩) Ψ_i.hom_inv_id
        have hq_mem' : V_iK.ι.base (Ψ_i.inv.base q) ∈ Z_cl := hq_mem
        rw [hinv_hom] at hq_mem'
        exact hq_mem'
      obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Z_i).mp hZi_closed
      have hI_ne_bot : I ≠ ⊥ := by
        intro hbot
        apply hZi_ne
        ext p
        rw [hI, hbot]
        simp
      obtain ⟨a_i, ha_mem, ha_ne⟩ := (Submodule.ne_bot_iff I).mp hI_ne_bot
      have hZi_sub : Z_i ⊆ PrimeSpectrum.zeroLocus (Ideal.span ({a_i} : Set A_i) : Set A_i) := by
        rw [hI]
        exact PrimeSpectrum.zeroLocus_anti_mono (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha_mem))
      let φ_V : Polynomial ↥V →+* ↑R_i := (Polynomial.aeval (R := ↥V) u_i).toRingHom
      have hFin_mod : @Module.Finite (Polynomial ↥V) ↑R_i _ _ φ_V.toModule := hFin_u
      letI : Module (Polynomial ↥V) ↑R_i := φ_V.toModule
      obtain ⟨G, hG_span⟩ := @Module.Finite.fg_top (Polynomial ↥V) ↑R_i _ _ _ hFin_mod
      letI : Algebra K A_i := Algebra.TensorProduct.includeRight.toRingHom.toAlgebra
      let u_K : A_i := u_i ⊗ₜ[↥V] (1 : K)
      let R_u : Subalgebra K A_i := (Polynomial.aeval (R := K) u_K).range
      have hmap_poly : ∀ P : Polynomial ↥V,
          (φ_V P) ⊗ₜ[↥V] (1 : K) =
            Polynomial.aeval (R := K) u_K (Polynomial.map V.subtype P) := by
        intro P
        induction P using Polynomial.induction_on' with
        | add p q ihp ihq =>
          rw [map_add, TensorProduct.add_tmul, ihp, ihq, Polynomial.map_add, map_add]
        | monomial n v =>
          change (Polynomial.aeval (R := ↥V) u_i (Polynomial.monomial n v)) ⊗ₜ[↥V] (1 : K) =
            Polynomial.aeval (R := K) u_K (Polynomial.map V.subtype (Polynomial.monomial n v))
          rw [Polynomial.aeval_monomial,
            Polynomial.map_monomial, Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one]
          have h1 : (v • (1 : ↑R_i) * u_i ^ n) ⊗ₜ[↥V] (1 : K) =
              (v • u_i ^ n) ⊗ₜ[↥V] (1 : K) := by
            rw [smul_mul_assoc, one_mul]
          rw [h1, TensorProduct.smul_tmul]
          change (u_i ^ n) ⊗ₜ[↥V] (v • (1 : K)) =
            algebraMap K A_i (V.subtype v) * u_K ^ n
          have hv : v • (1 : K) = V.subtype v := by
            change algebraMap ↥V K v * 1 = V.subtype v
            exact mul_one _
          rw [hv]
          have hpow : ∀ k : ℕ, u_K ^ k = (u_i ^ k) ⊗ₜ[↥V] (1 : K) := by
            intro k
            induction k with
            | zero => simp [u_K]; rfl
            | succ k ih =>
              rw [pow_succ, ih]
              change ((u_i ^ k) ⊗ₜ[↥V] (1 : K)) * (u_i ⊗ₜ[↥V] (1 : K)) = _
              rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, pow_succ]
          rw [hpow n]
          change (u_i ^ n) ⊗ₜ[↥V] V.subtype v =
            ((1 : ↑R_i) ⊗ₜ[↥V] V.subtype v) * ((u_i ^ n) ⊗ₜ[↥V] (1 : K))
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]
      let S_gen : Finset A_i := G.image (fun w : ↑R_i => w ⊗ₜ[↥V] (1 : K))
      have hSpan_Ru : Submodule.span ↥R_u (S_gen : Set A_i) = ⊤ := by
        suffices hall : ∀ z : A_i, z ∈ Submodule.span ↥R_u (S_gen : Set A_i) by
          rw [eq_top_iff]
          intro z _
          exact hall z
        intro z
        induction z using TensorProduct.induction_on with
        | zero => exact Submodule.zero_mem _
        | tmul r c =>
          have hr_top : r ∈ (⊤ : Submodule (Polynomial ↥V) ↑R_i) := trivial
          rw [← hG_span, Submodule.mem_span_finset] at hr_top
          obtain ⟨f_p, -, hr_eq⟩ := hr_top
          rw [← hr_eq, TensorProduct.sum_tmul]
          refine Submodule.sum_mem _ fun w hw => ?_
          have hterm : (f_p w • w) ⊗ₜ[↥V] c =
              (Polynomial.aeval (R := K) u_K
                (Polynomial.C c * Polynomial.map V.subtype (f_p w))) * (w ⊗ₜ[↥V] (1 : K)) := by
            change (φ_V (f_p w) * w) ⊗ₜ[↥V] c = _
            have hsplit : (φ_V (f_p w) * w) ⊗ₜ[↥V] c =
                ((1 : ↑R_i) ⊗ₜ[↥V] c) * ((φ_V (f_p w)) ⊗ₜ[↥V] (1 : K)) * (w ⊗ₜ[↥V] (1 : K)) := by
              rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul]
              simp
            rw [hsplit, hmap_poly, map_mul, Polynomial.aeval_C]
            rfl
          let coeff_u : ↥R_u := ⟨Polynomial.aeval (R := K) u_K
            (Polynomial.C c * Polynomial.map V.subtype (f_p w)), ⟨_, rfl⟩⟩
          rw [hterm]
          exact Submodule.smul_mem _ coeff_u
            (Submodule.subset_span (Finset.mem_image_of_mem _ hw))
        | add x y ihx ihy => exact Submodule.add_mem _ ihx ihy
      haveI : Module.Finite ↥R_u A_i := ⟨⟨S_gen, hSpan_Ru⟩⟩
      haveI : Algebra.IsIntegral ↥R_u A_i := Algebra.IsIntegral.of_finite ↥R_u A_i
      obtain ⟨P_ai, hP_monic, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := ↥R_u) a_i
      have hP_ne : P_ai ≠ 0 := hP_monic.ne_zero
      have hDesc : ∀ (d : ℕ) (P : Polynomial ↥R_u),
          P.natDegree = d → P ≠ 0 → Polynomial.aeval a_i P = 0 →
          ∃ r₀ : ↥R_u, r₀ ≠ 0 ∧ (r₀ : A_i) ∈ Ideal.span ({a_i} : Set A_i) := by
        intro d
        induction d using Nat.strong_induction_on with
        | h d ih =>
          intro P hdeg hne heval
          by_cases h0 : P.coeff 0 = 0
          · obtain ⟨Q, hPQ⟩ := Polynomial.X_dvd_iff.mpr h0
            have hQ_ne : Q ≠ 0 := by
              intro hQ0
              rw [hQ0, mul_zero] at hPQ
              exact hne hPQ
            have hdegQ : Q.natDegree < d := by
              rw [← hdeg, hPQ, Polynomial.natDegree_X_mul hQ_ne]
              omega
            have hevalQ : Polynomial.aeval a_i Q = 0 := by
              rw [hPQ, map_mul, Polynomial.aeval_X] at heval
              exact (mul_eq_zero.mp heval).resolve_left ha_ne
            exact ih Q.natDegree hdegQ Q rfl hQ_ne hevalQ
          · refine ⟨P.coeff 0, h0, ?_⟩
            have hc0 : (P - Polynomial.C (P.coeff 0)).coeff 0 = 0 := by simp
            obtain ⟨Q, hQ⟩ := Polynomial.X_dvd_iff.mpr hc0
            have hev_sub : Polynomial.aeval a_i (P - Polynomial.C (P.coeff 0)) =
                -(P.coeff 0 : A_i) := by
              have hsub := map_sub (Polynomial.aeval a_i) P (Polynomial.C (P.coeff 0))
              rw [hsub, heval, zero_sub, Polynomial.aeval_C]
              rfl
            rw [hQ, map_mul, Polynomial.aeval_X] at hev_sub
            rw [Ideal.mem_span_singleton]
            exact ⟨-Polynomial.aeval a_i Q, by rw [mul_neg, hev_sub, neg_neg]⟩
      obtain ⟨r₀, hr₀_ne, hr₀_mem⟩ := hDesc P_ai.natDegree P_ai rfl hP_ne hP_eval
      obtain ⟨f₀, hf₀_eq⟩ := r₀.2
      change Polynomial.aeval (R := K) u_K f₀ = (r₀ : A_i) at hf₀_eq
      have hf₀_ne : f₀ ≠ 0 := by
        intro h0
        apply hr₀_ne
        apply Subtype.ext
        rw [← hf₀_eq, h0, map_zero]
        rfl
      let f_mon : Polynomial K := Polynomial.C (f₀.leadingCoeff)⁻¹ * f₀
      have hf_monic : f_mon.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C,
          inv_mul_cancel₀ (Polynomial.leadingCoeff_ne_zero.mpr hf₀_ne)]
      have hf_mem : Polynomial.aeval (R := K) u_K f_mon ∈ Ideal.span ({a_i} : Set A_i) := by
        dsimp only [f_mon]
        rw [map_mul, Polynomial.aeval_C, hf₀_eq]
        exact Ideal.mul_mem_left _ _ hr₀_mem
      let J_i : Ideal A_i := Ideal.span ({a_i} : Set A_i)
      let M_i := A_i ⧸ J_i
      let π_M : A_i →+* M_i := Ideal.Quotient.mk J_i
      let π_alg : A_i →ₐ[K] M_i := Ideal.Quotient.mkₐ K J_i
      let d_m := f_mon.natDegree
      let B_M : Finset M_i :=
        (Finset.range d_m).biUnion (fun j => G.image (fun w => π_M (u_K ^ j * (w ⊗ₜ[↥V] 1))))
      have hSpan_K : Submodule.span K (B_M : Set M_i) = ⊤ := by
        rw [eq_top_iff]
        intro m_el _
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective m_el
        have hz_mem : z ∈ (⊤ : Submodule ↥R_u A_i) := trivial
        rw [← hSpan_Ru, Submodule.mem_span_finset] at hz_mem
        obtain ⟨c_u, -, hz_eq⟩ := hz_mem
        change π_alg z ∈ Submodule.span K (B_M : Set M_i)
        rw [← hz_eq, map_sum]
        refine Submodule.sum_mem _ fun s hs => ?_
        obtain ⟨w, hwG, rfl⟩ := Finset.mem_image.mp hs
        obtain ⟨g_p, hg_eq⟩ := (c_u (w ⊗ₜ[↥V] 1)).2
        change Polynomial.aeval (R := K) u_K g_p = (c_u (w ⊗ₜ[↥V] 1) : A_i) at hg_eq
        change π_alg (((c_u (w ⊗ₜ[↥V] 1) : A_i) * (w ⊗ₜ[↥V] 1))) ∈ Submodule.span K (B_M : Set M_i)
        rw [← hg_eq]
        let rem_p := g_p %ₘ f_mon
        let div_p := g_p /ₘ f_mon
        have hdiv_eq : g_p = rem_p + f_mon * div_p := (Polynomial.modByMonic_add_div g_p f_mon).symm
        have haeval_zero : π_alg (Polynomial.aeval (R := K) u_K f_mon) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hf_mem
        have hrem_eq : π_alg (Polynomial.aeval (R := K) u_K g_p * (w ⊗ₜ[↥V] 1)) =
            π_alg (Polynomial.aeval (R := K) u_K rem_p * (w ⊗ₜ[↥V] 1)) := by
          have h1 : Polynomial.aeval (R := K) u_K g_p =
              Polynomial.aeval (R := K) u_K rem_p +
                Polynomial.aeval (R := K) u_K f_mon * Polynomial.aeval (R := K) u_K div_p := by
            rw [hdiv_eq, map_add, map_mul]
          simp only [h1, add_mul, map_add, map_mul, haeval_zero, zero_mul, add_zero]
        rw [hrem_eq]
        by_cases hrem0 : rem_p = 0
        · rw [hrem0, map_zero, zero_mul, map_zero]
          exact Submodule.zero_mem _
        · have hdeg_lt : rem_p.degree < f_mon.degree :=
            Polynomial.degree_modByMonic_lt g_p hf_monic
          rw [Polynomial.degree_eq_natDegree hrem0,
            Polynomial.degree_eq_natDegree hf_monic.ne_zero] at hdeg_lt
          have hnat_lt : rem_p.natDegree < d_m := WithBot.coe_lt_coe.mp hdeg_lt
          rw [Polynomial.as_sum_range' rem_p d_m hnat_lt, map_sum, Finset.sum_mul, map_sum]
          refine Submodule.sum_mem _ fun j hj => ?_
          rw [Polynomial.aeval_monomial, Algebra.algebraMap_eq_smul_one, smul_mul_assoc,
            one_mul, smul_mul_assoc, map_smul]
          exact Submodule.smul_mem _ (rem_p.coeff j) (Submodule.subset_span
            (Finset.mem_biUnion.mpr ⟨j, hj, Finset.mem_image_of_mem _ hwG⟩))
      haveI : Module.Finite K M_i := ⟨⟨B_M, hSpan_K⟩⟩
      haveI : IsArtinian K M_i := isArtinian_of_fg_of_artinian'
      haveI : IsArtinianRing M_i := isArtinian_of_tower K inferInstance
      haveI : Finite (PrimeSpectrum M_i) := inferInstance
      have hRange : Set.range (PrimeSpectrum.comap π_M) =
          PrimeSpectrum.zeroLocus (J_i : Set A_i) := by
        have hsurj_π : Function.Surjective π_M := Ideal.Quotient.mk_surjective
        rw [_root_.range_comap_of_surjective M_i π_M hsurj_π, Ideal.mk_ker]
      have hZloc_fin : (PrimeSpectrum.zeroLocus (J_i : Set A_i)).Finite := by
        rw [← hRange]
        exact Set.finite_range (PrimeSpectrum.comap π_M)
      have hZi_fin : Z_i.Finite := hZloc_fin.subset hZi_sub
      let f_back : PrimeSpectrum A_i → ↥C_K := fun p => V_iK.ι.base (Ψ_i.inv.base p)
      have hSub_img : Z_cl ∩ (V_iK : Set ↥C_K) ⊆ f_back '' Z_i := by
        rintro x ⟨hxZ, hxV⟩
        let p : PrimeSpectrum A_i := Ψ_i.hom.base ⟨x, hxV⟩
        have hinv : Ψ_i.inv.base p = ⟨x, hxV⟩ :=
          congrArg (fun f : V_iK.toScheme ⟶ V_iK.toScheme => f.base ⟨x, hxV⟩) Ψ_i.hom_inv_id
        refine ⟨p, ?_, ?_⟩
        · change V_iK.ι.base (Ψ_i.inv.base p) ∈ Z_cl
          rw [hinv]
          exact hxZ
        · dsimp only [f_back]
          rw [hinv]
          rfl
      exact (hZi_fin.image f_back).subset hSub_img
    · have hEmpty : Z_cl ∩ (V_iK : Set ↥C_K) = ∅ := by
        ext x
        simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
        intro _ hxV
        exact hNe ⟨x, hxV⟩
      rw [hEmpty]
      exact Set.finite_empty

  
  have helper_free_quotient_prime_exists :
      ∀ (R₀ : Type u) [CommRing R₀] [Algebra ↥V R₀] (u₁ u₂ : R₀),
        Module.Free ↥V (R₀ ⧸ Ideal.span ({u₁, u₂} : Set R₀)) →
        Nontrivial (R₀ ⧸ Ideal.span ({u₁, u₂} : Set R₀)) →
        letI : Algebra ↥V K := V.subtype.toAlgebra
        ∃ p : PrimeSpectrum (TensorProduct ↥V R₀ K),
          (u₁ ⊗ₜ[↥V] (1 : K)) ∈ p.asIdeal ∧ (u₂ ⊗ₜ[↥V] (1 : K)) ∈ p.asIdeal := by
    intro R₀ _ _ u₁ u₂ hFree hNontriv
    letI : Algebra ↥V K := V.subtype.toAlgebra
    let I₀ : Ideal R₀ := Ideal.span ({u₁, u₂} : Set R₀)
    let Q := R₀ ⧸ I₀
    let b := Module.Free.chooseBasis ↥V Q
    let B := Module.Free.ChooseBasisIndex ↥V Q
    have hB_ne : Nonempty B := by
      by_contra hEmpty
      haveI : IsEmpty B := not_nonempty_iff.mp hEmpty
      have _ : Subsingleton Q := b.repr.toEquiv.subsingleton
      exact false_of_nontrivial_of_subsingleton Q
    obtain ⟨i₀⟩ := hB_ne
    obtain ⟨r_star, hr_star⟩ := Ideal.Quotient.mk_surjective (b i₀)
    let lam0 : R₀ →ₗ[↥V] ↥V := (b.coord i₀).comp ((Submodule.mkQ I₀).restrictScalars ↥V)
    have hlam_star : lam0 r_star = 1 := by
      change (b.coord i₀) (Ideal.Quotient.mk I₀ r_star) = 1
      rw [hr_star]
      simp [Module.Basis.coord_apply, Module.Basis.repr_self]
    have hlam_zero : ∀ u ∈ I₀, lam0 u = 0 := by
      intro u hu
      change (b.coord i₀) (Ideal.Quotient.mk I₀ u) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hu, map_zero]
    let bil : R₀ →ₗ[↥V] K →ₗ[↥V] K :=
      LinearMap.mk₂ ↥V (fun r c => c * V.subtype (lam0 r))
        (fun r₁ r₂ c => by simp [map_add, mul_add])
        (fun v r c => by
          simp only [LinearMap.map_smul]
          change c * V.subtype (v • lam0 r) = v • (c * V.subtype (lam0 r))
          change c * V.subtype (v * lam0 r) = V.subtype v * (c * V.subtype (lam0 r))
          rw [map_mul]
          ring)
        (fun r c₁ c₂ => add_mul c₁ c₂ _)
        (fun v r c => by
          change (V.subtype v * c) * V.subtype (lam0 r) = V.subtype v * (c * V.subtype (lam0 r))
          ring)
    let Λ_K : TensorProduct ↥V R₀ K →ₗ[↥V] K := TensorProduct.lift bil
    have hΛ_star : Λ_K (r_star ⊗ₜ[↥V] (1 : K)) = 1 := by
      simp [Λ_K, bil, hlam_star]
    have hΛ_ideal_kill : ∀ (u : R₀), u ∈ I₀ →
        ∀ (z : TensorProduct ↥V R₀ K), Λ_K (z * (u ⊗ₜ[↥V] (1 : K))) = 0 := by
      intro u hu z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul r c =>
        change Λ_K ((r ⊗ₜ[↥V] c) * (u ⊗ₜ[↥V] (1 : K))) = 0
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
        change c * V.subtype (lam0 (r * u)) = 0
        rw [hlam_zero (r * u) (Ideal.mul_mem_left I₀ r hu), map_zero, mul_zero]
      | add x y ihx ihy =>
        rw [add_mul, map_add, ihx, ihy, add_zero]
    let A₀ := TensorProduct ↥V R₀ K
    let I_K : Ideal A₀ := Ideal.span ({u₁ ⊗ₜ[↥V] (1 : K), u₂ ⊗ₜ[↥V] (1 : K)} : Set A₀)
    have hIK_ne_top : I_K ≠ ⊤ := by
      intro htop
      have hmem : (r_star ⊗ₜ[↥V] (1 : K)) ∈ I_K := by
        rw [htop]
        trivial
      rw [Ideal.mem_span_pair] at hmem
      obtain ⟨z₁, z₂, hz_eq⟩ := hmem
      have h0 : Λ_K (r_star ⊗ₜ[↥V] (1 : K)) = 0 := by
        rw [← hz_eq, map_add,
          hΛ_ideal_kill u₁ (Ideal.subset_span (by simp)) z₁,
          hΛ_ideal_kill u₂ (Ideal.subset_span (by simp)) z₂,
          add_zero]
      exact one_ne_zero (hΛ_star.symm.trans h0)
    obtain ⟨𝔪, h𝔪_max, hIK_le⟩ := Ideal.exists_le_maximal I_K hIK_ne_top
    exact ⟨⟨𝔪, h𝔪_max.isPrime⟩,
      hIK_le (Ideal.subset_span (by simp)),
      hIK_le (Ideal.subset_span (by simp))⟩

  
  have helper_proper_integral_section_appTop_bijective :
      ∀ (σ₀ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K),
        σ₀ ≫ p_K = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K)) →
        Function.Bijective (p_K.appTop).hom := by
    intro σ₀ hSec
    haveI : AlgebraicGeometry.IsIntegral C_K := hIntCK
    haveI : AlgebraicGeometry.IsProper p_K := hPropCK
    let B_K := ↑Γ(AlgebraicGeometry.Spec (CommRingCat.of K), ⊤)
    let A_top := ↑Γ(C_K, ⊤)
    let φ_top : B_K →+* A_top := (p_K.appTop).hom
    let ψ_top : A_top →+* B_K := (σ₀.appTop).hom
    have hcomp_id : ψ_top.comp φ_top = RingHom.id B_K := by
      have happ := congrArg AlgebraicGeometry.Scheme.Hom.appTop hSec
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Hom.id_appTop] at happ
      exact congrArg CommRingCat.Hom.hom happ
    have hinj : Function.Injective φ_top :=
      Function.LeftInverse.injective (fun x => RingHom.congr_fun hcomp_id x)
    haveI : IsDomain A_top := inferInstance
    have hInt_hom : φ_top.IsIntegral :=
      AlgebraicGeometry.isIntegral_appTop_of_universallyClosed p_K
    letI : Algebra B_K A_top := φ_top.toAlgebra
    haveI : Algebra.IsIntegral B_K A_top := ⟨hInt_hom⟩
    refine ⟨hinj, ?_⟩
    intro a
    refine ⟨ψ_top a, ?_⟩
    let b : A_top := a - φ_top (ψ_top a)
    suffices hb0 : b = 0 by
      exact (sub_eq_zero.mp hb0).symm
    by_contra hb_ne
    have hψ_b : ψ_top b = 0 := by
      dsimp only [b]
      rw [map_sub]
      have h1 : ψ_top (φ_top (ψ_top a)) = ψ_top a := RingHom.congr_fun hcomp_id (ψ_top a)
      rw [h1, sub_self]
    obtain ⟨P, hP_monic, hP_eval⟩ := Algebra.IsIntegral.isIntegral (R := B_K) b
    have hP_ne : P ≠ 0 := hP_monic.ne_zero
    have hψ_poly : ∀ R_poly : Polynomial B_K, ψ_top (Polynomial.aeval b R_poly) = R_poly.coeff 0 := by
      intro R_poly
      induction R_poly using Polynomial.induction_on' with
      | add p q ihp ihq =>
        rw [map_add, map_add, ihp, ihq, Polynomial.coeff_add]
      | monomial k_deg c =>
        rw [Polynomial.aeval_monomial]
        change ψ_top (φ_top c * b ^ k_deg) = (Polynomial.monomial k_deg c).coeff 0
        have hc_id : ψ_top (φ_top c) = c := RingHom.congr_fun hcomp_id c
        rw [map_mul, hc_id, map_pow, hψ_b]
        cases k_deg with
        | zero => simp
        | succ k_deg => simp [zero_pow (Nat.succ_ne_zero k_deg)]
    have hNoPoly : ∀ (d : ℕ) (Q : Polynomial B_K),
        Q.natDegree = d → Q ≠ 0 → Polynomial.aeval b Q ≠ 0 := by
      intro d
      induction d using Nat.strong_induction_on with
      | h d ih =>
        intro Q hdeg hQ_ne hQ_eval
        have hc0 : Q.coeff 0 = 0 := by
          rw [← hψ_poly Q, hQ_eval, map_zero]
        obtain ⟨Q', hQQ'⟩ := Polynomial.X_dvd_iff.mpr hc0
        have hQ'_ne : Q' ≠ 0 := by
          intro h0
          rw [h0, mul_zero] at hQQ'
          exact hQ_ne hQQ'
        have hdeg' : Q'.natDegree < d := by
          rw [← hdeg, hQQ', Polynomial.natDegree_X_mul hQ'_ne]
          omega
        have heval' : Polynomial.aeval b Q' = 0 := by
          rw [hQQ', map_mul, Polynomial.aeval_X] at hQ_eval
          exact (mul_eq_zero.mp hQ_eval).resolve_left hb_ne
        exact ih Q'.natDegree hdeg' Q' rfl hQ'_ne heval'
    exact hNoPoly P.natDegree P rfl hP_ne hP_eval

  
  have helper_crux_chart_isAffineOpen :
      ∀ (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
        (q : C_K ⟶ Y),
        AlgebraicGeometry.IsProper p_Y →
        AlgebraicGeometry.IsProper q →
        q ≫ p_Y = p_K →
        Function.Surjective q.base →
        (∀ Z_cl : Set ↥C_K, IsClosed Z_cl → Z_cl ≠ Set.univ → Z_cl.Finite) →
        ∀ (M₀ : ℕ) (j_PV : C_K ⟶ (weilProjectiveSpaceOver ↥V M₀).left),
          AlgebraicGeometry.IsAffineHom j_PV →
          (∀ W : C_K.Opens, ((W : Set ↥C_K)ᶜ).Nonempty →
            ∃ U_cl : (weilProjectiveSpaceOver ↥V M₀).left.Opens,
              j_PV ⁻¹ᵁ U_cl = W ∧ ∃ z₀ : ↥C_K, j_PV.base z₀ ∉ U_cl) →
          (∀ x : ↥C_K,
            (((weilProjectiveSpaceOver ↥V M₀).hom.base (j_PV.base x)) : PrimeSpectrum ↥V).asIdeal = ⊥) →
          ∀ (U : Y.Opens),
            AlgebraicGeometry.IsAffineOpen U →
            Nonempty ↥(q ⁻¹ᵁ U) →
            (((q ⁻¹ᵁ U : C_K.Opens) : Set ↥C_K)ᶜ).Nonempty →
            Function.Bijective (q.app U).hom →
            AlgebraicGeometry.IsAffineOpen (q ⁻¹ᵁ U) := by
    intro Y p_Y q hPropY hPropQ hCommQ hSurjQ hFinClosed M₀ j_PV hAffJ hSepW hGenPt
      U hAffU hW_ne hWc_ne hBijU
    haveI : AlgebraicGeometry.IsIntegral C_K := hIntCK
    haveI : AlgebraicGeometry.IsProper p_K := hPropCK
    haveI : AlgebraicGeometry.IsProper p_Y := hPropY
    haveI : AlgebraicGeometry.IsProper q := hPropQ
    haveI : AlgebraicGeometry.IsAffineHom j_PV := hAffJ
    have hInfK : Infinite K := by
      by_contra hFinK
      rw [not_infinite_iff_finite] at hFinK
      letI : Fintype K := Fintype.ofFinite K
      let q_card : ℕ := Fintype.card K
      have hq2 : 2 ≤ q_card := Fintype.one_lt_card
      let P : Polynomial K := Polynomial.X ^ q_card - Polynomial.X + 1
      have hP_coeff_q : P.coeff q_card = 1 := by
        dsimp only [P]
        rw [Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_X_pow_self,
          Polynomial.coeff_X_of_ne_one (by omega), Polynomial.coeff_one,
          if_neg (by omega), sub_zero, add_zero]
      have hP_ne : P ≠ 0 := by
        intro h0
        rw [h0, Polynomial.coeff_zero] at hP_coeff_q
        exact one_ne_zero hP_coeff_q.symm
      have hP_deg_pos : 0 < P.natDegree := by
        have hle : q_card ≤ P.natDegree :=
          Polynomial.le_natDegree_of_ne_zero (by rw [hP_coeff_q]; exact one_ne_zero)
        omega
      have hP_deg_ne : P.degree ≠ 0 := by
        rw [Polynomial.degree_eq_natDegree hP_ne]
        intro h0
        have hnat0 : P.natDegree = 0 := WithBot.coe_eq_coe.mp h0
        omega
      have hderiv : Polynomial.derivative P = -1 := by
        dsimp only [P]
        rw [Polynomial.derivative_add, Polynomial.derivative_sub,
          Polynomial.derivative_X_pow, Polynomial.derivative_X, Polynomial.derivative_one,
          FiniteField.cast_card_eq_zero, map_zero, zero_mul, zero_sub, add_zero]
      have hSep : P.Separable := by
        rw [Polynomial.separable_def, hderiv]
        exact ⟨0, -1, by simp⟩
      obtain ⟨x₀, hx₀⟩ := IsSepClosed.exists_aeval_eq_zero K P hP_deg_ne hSep
      have hev : x₀ ^ q_card - x₀ + 1 = 0 := by
        simpa [P] using hx₀
      rw [FiniteField.pow_card x₀, sub_self, zero_add] at hev
      exact one_ne_zero hev
    haveI : Infinite K := hInfK
    haveI : Infinite ↥V := by
      by_contra hFinV
      rw [not_infinite_iff_finite] at hFinV
      let F_cov : ↥V ⊕ ↥V → K := Sum.elim V.subtype (fun v => (V.subtype v)⁻¹)
      have hSurjF : Function.Surjective F_cov := by
        intro z
        rcases V.mem_or_inv_mem z with hz | hz_inv
        · exact ⟨Sum.inl ⟨z, hz⟩, rfl⟩
        · exact ⟨Sum.inr ⟨z⁻¹, hz_inv⟩, inv_inv z⟩
      have _ : Finite K := Finite.of_surjective F_cov hSurjF
      exact not_finite K
    let W : C_K.Opens := q ⁻¹ᵁ U
    let A := ↑Γ(Y, U)
    let B := ↑Γ(C_K, W)
    let θ : A →+* B := (q.app U).hom
    haveI : Nonempty ↥W.toScheme := hW_ne
    haveI : AlgebraicGeometry.IsIntegral W.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion W.ι
    haveI : IsDomain B := by
      let e_top : CommRingCat.of B ≅ Γ(W.toScheme, ⊤) := W.topIso.symm
      exact e_top.commRingCatIsoToRingEquiv.toMulEquiv.isDomain Γ(W.toScheme, ⊤)
    haveI : IsDomain A := Function.Injective.isDomain θ hBijU.injective
    have hAffTopK : AlgebraicGeometry.IsAffineOpen
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of K)).Opens) :=
      AlgebraicGeometry.isAffineOpen_top (AlgebraicGeometry.Spec (CommRingCat.of K))
    have hFT_app : RingHom.FiniteType (p_Y.appLE ⊤ U le_top).hom :=
      AlgebraicGeometry.LocallyOfFiniteType.finiteType_appLE p_Y hAffTopK hAffU le_top
    let α_Y : CommRingCat.of K ⟶ Y.presheaf.obj (Opposite.op U) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ p_Y.appLE ⊤ U le_top
    let c_K : K →+* A := α_Y.hom
    have hc_FT : c_K.FiniteType := by
      have hIso_FT : RingHom.FiniteType
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).inv).hom :=
        RingHom.FiniteType.of_surjective _
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv.surjective
      exact hFT_app.comp hIso_FT
    have hCommU : hAffU.isoSpec.hom ≫ AlgebraicGeometry.Spec.map α_Y = U.ι ≫ p_Y := by
      rw [AlgebraicGeometry.IsAffineOpen.isoSpec_hom]
      exact helper_open_toSpecΓ_comm K Y p_Y U
    have hMax_ne_bot : ∀ (𝔪 : Ideal A), 𝔪.IsMaximal → 𝔪 ≠ ⊥ := by
      intro 𝔪 h𝔪_max h𝔪_bot
      letI : Field (A ⧸ 𝔪) := Ideal.Quotient.field 𝔪
      letI : Algebra K A := c_K.toAlgebra
      haveI : Algebra.FiniteType K A := hc_FT
      obtain ⟨n_v, Φ_mv, hΦ_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hc_FT
      let π_𝔪 : A →+* A ⧸ 𝔪 := Ideal.Quotient.mk 𝔪
      have hπΦ_surj : Function.Surjective (π_𝔪.comp Φ_mv.toRingHom) :=
        (Ideal.Quotient.mk_surjective).comp hΦ_surj
      have hInt_quot : ((π_𝔪.comp Φ_mv.toRingHom).comp MvPolynomial.C).IsIntegral :=
        MvPolynomial.comp_C_integral_of_surjective_of_isJacobsonRing
          (π_𝔪.comp Φ_mv.toRingHom) hπΦ_surj
      have hcomp_eq : (π_𝔪.comp Φ_mv.toRingHom).comp MvPolynomial.C = π_𝔪.comp c_K := by
        ext x
        change π_𝔪 (Φ_mv (MvPolynomial.C x)) = π_𝔪 (algebraMap K A x)
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      rw [hcomp_eq] at hInt_quot
      have hπ_inj : Function.Injective π_𝔪 := by
        rw [RingHom.injective_iff_ker_eq_bot, Ideal.mk_ker]
        exact h𝔪_bot
      let e_π : A ≃+* (A ⧸ 𝔪) := RingEquiv.ofBijective π_𝔪 ⟨hπ_inj, Ideal.Quotient.mk_surjective⟩
      have hc_eq : c_K = e_π.symm.toRingHom.comp (π_𝔪.comp c_K) := by
        ext x
        exact (e_π.symm_apply_apply (c_K x)).symm
      have hc_int : c_K.IsIntegral := by
        rw [hc_eq]
        exact RingHom.IsIntegral.trans _ _ hInt_quot
          (RingHom.isIntegral_of_surjective _ e_π.symm.surjective)
      have hc_fin : c_K.Finite := RingHom.Finite.of_isIntegral_of_finiteType hc_int hc_FT
      haveI : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map α_Y) :=
        (AlgebraicGeometry.IsFinite.SpecMap_iff α_Y).mpr hc_fin
      haveI : AlgebraicGeometry.IsProper (AlgebraicGeometry.Spec.map α_Y) :=
        (AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mp inferInstance).1
      have hProp_UY : AlgebraicGeometry.IsProper (U.ι ≫ p_Y) := by
        rw [← hCommU]
        infer_instance
      haveI : AlgebraicGeometry.IsProper (q ∣_ U) :=
        CategoryTheory.MorphismProperty.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict q U).flip inferInstance
      have hW_pX : W.ι ≫ p_K = (q ∣_ U) ≫ (U.ι ≫ p_Y) := by
        rw [← Category.assoc, AlgebraicGeometry.morphismRestrict_ι, Category.assoc, hCommQ]
      have hProp_WpX : AlgebraicGeometry.IsProper (W.ι ≫ p_K) := by
        rw [hW_pX]
        haveI := hProp_UY
        infer_instance
      haveI : AlgebraicGeometry.IsProper W.ι :=
        @AlgebraicGeometry.IsProper.of_comp _ _ _ W.ι p_K hProp_WpX inferInstance
      have hCl_W : IsClosed (W : Set ↥C_K) := by
        have hrange : (W : Set ↥C_K) = Set.range W.ι.base := by
          ext x
          simp
        rw [hrange, ← Set.image_univ]
        exact W.ι.isClosedMap Set.univ isClosed_univ
      haveI : IrreducibleSpace ↥C_K := AlgebraicGeometry.irreducibleSpace_of_isIntegral C_K
      haveI : ConnectedSpace ↥C_K := inferInstance
      obtain ⟨w₀⟩ := hW_ne
      have hClop : IsClopen (W : Set ↥C_K) := ⟨hCl_W, W.isOpen⟩
      have hEqUniv : (W : Set ↥C_K) = Set.univ := hClop.eq_univ ⟨w₀.1, w₀.2⟩
      obtain ⟨z₀, hz₀⟩ := hWc_ne
      have hzW : z₀ ∈ (W : Set ↥C_K) := by rw [hEqUniv]; trivial
      exact hz₀ hzW
    let 𝒜_V := MvPolynomial.homogeneousSubmodule (Fin (M₀ + 1)) ↥V
    letI : GradedAlgebra 𝒜_V := MvPolynomial.gradedAlgebra
    obtain ⟨_, hdeg0_V, hProjScalar⟩ := helper_proj_proper_and_scalar ↥V M₀
    have hScalar : ∀ (x : ↥C_K) (c : ↥V),
        MvPolynomial.C c ∈ (j_PV.base x).asHomogeneousIdeal.toIdeal ↔ c = 0 := by
      intro x c
      rw [← hProjScalar (j_PV.base x) c, hGenPt x, Ideal.mem_bot]
    obtain ⟨U_cl, hUcl_pre, z_out, hz_out⟩ := hSepW W hWc_ne
    have hEnclose : ∀ (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal),
        ∃ V_𝔪 : C_K.Opens,
          AlgebraicGeometry.IsAffineOpen V_𝔪 ∧
          V_𝔪 ≤ W ∧
          q.base ⁻¹' {U.ι.base (hAffU.isoSpec.inv.base ⟨𝔪, h𝔪.isPrime⟩)} ⊆ (V_𝔪 : Set ↥C_K) := by
      intro 𝔪 h𝔪_max
      let p_𝔪 : PrimeSpectrum A := ⟨𝔪, h𝔪_max.isPrime⟩
      let y_𝔪 : ↥U.toScheme := hAffU.isoSpec.inv.base p_𝔪
      let y₀ : ↥Y := U.ι.base y_𝔪
      let F_𝔪 : Set ↥C_K := q.base ⁻¹' {y₀}
      obtain ⟨a₀, ha₀_mem, ha₀_ne⟩ := (Submodule.ne_bot_iff 𝔪).mp (hMax_ne_bot 𝔪 h𝔪_max)
      have hθa₀_ne : θ a₀ ≠ 0 := fun h0 => ha₀_ne (hBijU.injective (h0.trans (map_zero θ).symm))
      have hBo_ne_bot : C_K.basicOpen (θ a₀) ≠ ⊥ :=
        fun hbot => hθa₀_ne ((AlgebraicGeometry.basicOpen_eq_bot_iff (θ a₀)).mp hbot)
      have hCompl_ne_univ : ((C_K.basicOpen (θ a₀) : Set ↥C_K)ᶜ) ≠ Set.univ := by
        intro huniv
        apply hBo_ne_bot
        ext x
        have hx_not : x ∉ (C_K.basicOpen (θ a₀) : Set ↥C_K) := by
          have hx_c : x ∈ ((C_K.basicOpen (θ a₀) : Set ↥C_K)ᶜ) := by rw [huniv]; trivial
          exact hx_c
        simp [hx_not]
      have hy₀_not_bo : y₀ ∉ Y.basicOpen a₀ := by
        intro hy_bo
        have hp_pre : p_𝔪 ∈ (hAffU.fromSpec ⁻¹ᵁ Y.basicOpen a₀) := by
          change hAffU.fromSpec.base p_𝔪 ∈ Y.basicOpen a₀
          have hfrom : hAffU.fromSpec = hAffU.isoSpec.inv ≫ U.ι :=
            (AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffU).symm
          rw [hfrom]
          exact hy_bo
        rw [AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hAffU a₀] at hp_pre
        exact hp_pre ha₀_mem
      have hF_sub_compl : F_𝔪 ⊆ (C_K.basicOpen (θ a₀) : Set ↥C_K)ᶜ := by
        intro x hx hx_bo
        have hpre : C_K.basicOpen (θ a₀) = q ⁻¹ᵁ Y.basicOpen a₀ :=
          (AlgebraicGeometry.Scheme.Hom.preimage_basicOpen q a₀).symm
        rw [hpre] at hx_bo
        have hqx : q.base x = y₀ := hx
        exact hy₀_not_bo (hqx ▸ hx_bo)
      have hF_fin : F_𝔪.Finite :=
        (hFinClosed _ (C_K.basicOpen (θ a₀)).isOpen.isClosed_compl hCompl_ne_univ).subset hF_sub_compl
      letI : Fintype ↥F_𝔪 := hF_fin.fintype
      let k_pts : ℕ := Fintype.card ↥F_𝔪
      let e_fin : Fin k_pts ≃ ↥F_𝔪 := (Fintype.equivFin ↥F_𝔪).symm
      let x_pt : Fin k_pts → ↥C_K := fun i => (e_fin i).1
      have hx_in_W : ∀ i : Fin k_pts, x_pt i ∈ W := by
        intro i
        change q.base (x_pt i) ∈ U
        have hq : q.base (x_pt i) = y₀ := (e_fin i).2
        rw [hq]
        exact y_𝔪.2
      have hBasis_i : ∀ i : Fin k_pts,
          ∃ (d : ℕ) (f : MvPolynomial (Fin (M₀ + 1)) ↥V),
            0 < d ∧ f ∈ 𝒜_V d ∧
            j_PV.base (x_pt i) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_V f ∧
            AlgebraicGeometry.Proj.basicOpen 𝒜_V f ≤ U_cl := by
        intro i
        have hp_in_Ucl : j_PV.base (x_pt i) ∈ U_cl := by
          have hxW : x_pt i ∈ j_PV ⁻¹ᵁ U_cl := by rw [hUcl_pre]; exact hx_in_W i
          exact hxW
        obtain ⟨_, ⟨_, ⟨g_raw, rfl⟩, rfl⟩, hp_g, hg_le⟩ :=
          (AlgebraicGeometry.Proj.isBasis_basicOpen 𝒜_V).exists_subset_of_mem_open
            hp_in_Ucl U_cl.isOpen
        have hp_sup : j_PV.base (x_pt i) ∈
            ⨆ d : ℕ, AlgebraicGeometry.Proj.basicOpen 𝒜_V (GradedRing.proj 𝒜_V d g_raw) := by
          rw [← AlgebraicGeometry.Proj.basicOpen_eq_iSup_proj 𝒜_V g_raw]
          exact hp_g
        obtain ⟨d, hp_d⟩ := TopologicalSpace.Opens.mem_iSup.mp hp_sup
        let f := (GradedRing.proj 𝒜_V d g_raw : MvPolynomial (Fin (M₀ + 1)) ↥V)
        have hf_mem : f ∈ 𝒜_V d := (DirectSum.decompose 𝒜_V g_raw d).2
        have hf_le : AlgebraicGeometry.Proj.basicOpen 𝒜_V f ≤ U_cl := by
          refine le_trans ?_ hg_le
          rw [AlgebraicGeometry.Proj.basicOpen_eq_iSup_proj 𝒜_V g_raw]
          exact le_iSup (fun m => AlgebraicGeometry.Proj.basicOpen 𝒜_V (GradedRing.proj 𝒜_V m g_raw)) d
        have hd_pos : 0 < d := by
          by_contra hd0
          have hd_zero : d = 0 := Nat.eq_zero_of_not_pos hd0
          subst hd_zero
          have hf_C : f = MvPolynomial.C (f.coeff 0) := hdeg0_V f hf_mem
          have hc_ne : f.coeff 0 ≠ 0 := by
            intro hc0
            have hmem : MvPolynomial.C (f.coeff 0) ∈
                (j_PV.base (x_pt i)).asHomogeneousIdeal.toIdeal :=
              (hScalar (x_pt i) (f.coeff 0)).mpr hc0
            rw [← hf_C] at hmem
            exact ((ProjectiveSpectrum.mem_basicOpen 𝒜_V f _).mp hp_d) hmem
          have hz_not_mem : f ∉ (j_PV.base z_out).asHomogeneousIdeal.toIdeal := by
            rw [hf_C]
            exact mt (hScalar z_out (f.coeff 0)).mp hc_ne
          have hz_in_bo : j_PV.base z_out ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_V f :=
            (ProjectiveSpectrum.mem_basicOpen 𝒜_V f _).mpr hz_not_mem
          exact hz_out (hf_le hz_in_bo)
        exact ⟨d, f, hd_pos, hf_mem, hp_d, hf_le⟩
      choose d_f f_hom hd_pos hf_mem hp_f hf_le using hBasis_i
      let D : ℕ := ∏ j : Fin k_pts, d_f j
      have hD_pos : 0 < D := Finset.prod_pos fun j _ => hd_pos j
      let e_exp : Fin k_pts → ℕ := fun i => ∏ j ∈ Finset.univ.erase i, d_f j
      have he_pos : ∀ i : Fin k_pts, 0 < e_exp i :=
        fun i => Finset.prod_pos fun j _ => hd_pos j
      have he_mul : ∀ i : Fin k_pts, e_exp i • d_f i = D := by
        intro i
        rw [smul_eq_mul, mul_comm]
        exact Finset.mul_prod_erase Finset.univ d_f (Finset.mem_univ i)
      let g_hom : Fin k_pts → MvPolynomial (Fin (M₀ + 1)) ↥V := fun i => (f_hom i) ^ (e_exp i)
      have hg_mem : ∀ i : Fin k_pts, g_hom i ∈ 𝒜_V D := by
        intro i
        rw [← he_mul i]
        exact SetLike.pow_mem_graded (e_exp i) (hf_mem i)
      have hg_bo : ∀ i : Fin k_pts,
          AlgebraicGeometry.Proj.basicOpen 𝒜_V (g_hom i) =
            AlgebraicGeometry.Proj.basicOpen 𝒜_V (f_hom i) :=
        fun i => AlgebraicGeometry.Proj.basicOpen_pow 𝒜_V (f_hom i) (e_exp i) (he_pos i)
      let B_bad : Fin k_pts → Set ↥V := fun i₀ =>
        {lam : ↥V | (∑ j : Fin k_pts, MvPolynomial.C (lam ^ j.1) * g_hom j) ∈
          (j_PV.base (x_pt i₀)).asHomogeneousIdeal.toIdeal}
      have hBad_fin : ∀ i₀ : Fin k_pts, (B_bad i₀).Finite := by
        intro i₀
        by_contra hInf_bad
        have hInf_sub : Infinite ↥(B_bad i₀) := Set.infinite_coe_iff.mpr hInf_bad
        let emb := Infinite.natEmbedding ↥(B_bad i₀)
        let v : Fin k_pts → ↥V := fun r => (emb r.1).1
        have hv_inj : Function.Injective v := by
          intro r₁ r₂ h
          have hemb : emb r₁.1 = emb r₂.1 := Subtype.ext h
          exact Fin.ext (emb.injective hemb)
        have hv_mem : ∀ r : Fin k_pts, v r ∈ B_bad i₀ := fun r => (emb r.1).2
        let P_id := (j_PV.base (x_pt i₀)).asHomogeneousIdeal.toIdeal
        haveI : P_id.IsPrime := (j_PV.base (x_pt i₀)).isPrime
        let Q_dom := MvPolynomial (Fin (M₀ + 1)) ↥V ⧸ P_id
        haveI : IsDomain Q_dom := Ideal.Quotient.isDomain P_id
        let π_Q : MvPolynomial (Fin (M₀ + 1)) ↥V →+* Q_dom := Ideal.Quotient.mk P_id
        let ρ_V : ↥V →+* Q_dom := π_Q.comp MvPolynomial.C
        let w_vec : Fin k_pts → Q_dom := fun j => π_Q (g_hom j)
        have hw_ne : w_vec i₀ ≠ 0 := by
          intro h0
          have hmem_g : g_hom i₀ ∈ P_id := Ideal.Quotient.eq_zero_iff_mem.mp h0
          have hp_in_g : j_PV.base (x_pt i₀) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_V (g_hom i₀) := by
            rw [hg_bo i₀]
            exact hp_f i₀
          exact ((ProjectiveSpectrum.mem_basicOpen 𝒜_V (g_hom i₀) _).mp hp_in_g) hmem_g
        let M_V : Matrix (Fin k_pts) (Fin k_pts) ↥V := Matrix.vandermonde v
        let M_Q : Matrix (Fin k_pts) (Fin k_pts) Q_dom := M_V.map ρ_V
        have hMulVec0 : M_Q.mulVec w_vec = 0 := by
          ext r
          simp only [Matrix.mulVec, dotProduct, M_Q, M_V, Matrix.map_apply,
            Matrix.vandermonde_apply, Pi.zero_apply]
          have hr_mem : (∑ j : Fin k_pts, MvPolynomial.C ((v r) ^ j.1) * g_hom j) ∈ P_id :=
            hv_mem r
          have hπ_sum : π_Q (∑ j : Fin k_pts, MvPolynomial.C ((v r) ^ j.1) * g_hom j) = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr hr_mem
          rw [map_sum] at hπ_sum
          simpa only [map_mul, w_vec, ρ_V, RingHom.comp_apply] using hπ_sum
        have hAdj := congrArg (M_Q.adjugate.mulVec ·) hMulVec0
        rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.mulVec_zero] at hAdj
        have hDet_w : M_Q.det * w_vec i₀ = 0 := by
          have h1 := congrFun hAdj i₀
          simpa [Matrix.mulVec, dotProduct, Matrix.one_apply] using h1
        have hDetV_ne : M_V.det ≠ 0 := Matrix.det_vandermonde_ne_zero_iff.mpr hv_inj
        have hDetQ_eq : M_Q.det = ρ_V M_V.det := (RingHom.map_det ρ_V M_V).symm
        have hDetQ_ne : M_Q.det ≠ 0 := by
          rw [hDetQ_eq]
          intro h0
          have hmem_det : MvPolynomial.C M_V.det ∈ P_id :=
            Ideal.Quotient.eq_zero_iff_mem.mp h0
          exact hDetV_ne ((hScalar (x_pt i₀) M_V.det).mp hmem_det)
        exact hw_ne ((mul_eq_zero.mp hDet_w).resolve_left hDetQ_ne)
      have hUnion_fin : (⋃ i₀ : Fin k_pts, B_bad i₀).Finite := Set.finite_iUnion hBad_fin
      have hNotUniv : (⋃ i₀ : Fin k_pts, B_bad i₀) ≠ Set.univ := by
        intro huniv
        exact Set.infinite_univ (huniv ▸ hUnion_fin)
      obtain ⟨lam₀, hlam₀⟩ := Set.nonempty_compl.mpr hNotUniv
      let H : MvPolynomial (Fin (M₀ + 1)) ↥V :=
        ∑ j : Fin k_pts, MvPolynomial.C (lam₀ ^ j.1) * g_hom j
      have hH_mem : H ∈ 𝒜_V D := by
        refine Submodule.sum_mem _ fun j _ => ?_
        rw [MvPolynomial.mem_homogeneousSubmodule]
        have hgj : (g_hom j).IsHomogeneous D :=
          (MvPolynomial.mem_homogeneousSubmodule D _).mp (hg_mem j)
        simpa only [zero_add] using (MvPolynomial.isHomogeneous_C _ (lam₀ ^ j.1)).mul hgj
      have hAff_boH : AlgebraicGeometry.IsAffineOpen (AlgebraicGeometry.Proj.basicOpen 𝒜_V H) :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_V H hH_mem hD_pos
      let j_PV' : C_K ⟶ AlgebraicGeometry.Proj 𝒜_V := j_PV
      haveI : AlgebraicGeometry.IsAffineHom j_PV' := hAffJ
      let V_𝔪 : C_K.Opens := j_PV' ⁻¹ᵁ AlgebraicGeometry.Proj.basicOpen 𝒜_V H
      have hAff_V𝔪 : AlgebraicGeometry.IsAffineOpen V_𝔪 := hAff_boH.preimage j_PV'
      have hV𝔪_le : V_𝔪 ≤ W := by
        rw [← hUcl_pre]
        intro x hx
        have hH_not : H ∉ (j_PV.base x).asHomogeneousIdeal.toIdeal :=
          (ProjectiveSpectrum.mem_basicOpen 𝒜_V H _).mp hx
        have hex_j : ∃ j : Fin k_pts, g_hom j ∉ (j_PV.base x).asHomogeneousIdeal.toIdeal := by
          by_contra! hall
          apply hH_not
          dsimp only [H]
          exact Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hall j)
        obtain ⟨j, hgj_not⟩ := hex_j
        have hxj : j_PV.base x ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_V (g_hom j) :=
          (ProjectiveSpectrum.mem_basicOpen 𝒜_V (g_hom j) _).mpr hgj_not
        rw [hg_bo j] at hxj
        exact hf_le j hxj
      have hF_sub_V𝔪 : F_𝔪 ⊆ (V_𝔪 : Set ↥C_K) := by
        intro x hx
        let i₀ : Fin k_pts := e_fin.symm ⟨x, hx⟩
        have hx_eq : x_pt i₀ = x := by
          dsimp only [x_pt, i₀]
          rw [e_fin.apply_symm_apply]
        rw [← hx_eq]
        have hlam_not : lam₀ ∉ B_bad i₀ := fun h => hlam₀ (Set.mem_iUnion.mpr ⟨i₀, h⟩)
        exact (ProjectiveSpectrum.mem_basicOpen 𝒜_V H _).mpr hlam_not
      exact ⟨V_𝔪, hAff_V𝔪, hV𝔪_le, hF_sub_V𝔪⟩
    let q_U : W.toScheme ⟶ U.toScheme := q ∣_ U
    haveI : AlgebraicGeometry.IsProper q_U :=
      CategoryTheory.MorphismProperty.of_isPullback
        (AlgebraicGeometry.isPullback_morphismRestrict q U).flip inferInstance
    have hClMap_qU : IsClosedMap q_U.base := AlgebraicGeometry.Scheme.Hom.isClosedMap q_U
    let s_A : Set A := {a : A | AlgebraicGeometry.IsAffineOpen (C_K.basicOpen (θ a))}
    have hex_good : ∀ (𝔪 : Ideal A), 𝔪.IsMaximal → ∃ a ∈ s_A, a ∉ 𝔪 := by
      intro 𝔪 h𝔪_max
      obtain ⟨V_𝔪, hAff_V𝔪, hV𝔪_le, hF_sub⟩ := hEnclose 𝔪 h𝔪_max
      let p_𝔪 : PrimeSpectrum A := ⟨𝔪, h𝔪_max.isPrime⟩
      let y_𝔪 : ↥U.toScheme := hAffU.isoSpec.inv.base p_𝔪
      let K_bad : Set ↥W.toScheme := (W.ι.base ⁻¹' (V_𝔪 : Set ↥C_K))ᶜ
      have hKbad_cl : IsClosed K_bad := (V_𝔪.isOpen.preimage W.ι.continuous).isClosed_compl
      let O_𝔪 : Set ↥U.toScheme := (q_U.base '' K_bad)ᶜ
      have hO_open : IsOpen O_𝔪 := (hClMap_qU K_bad hKbad_cl).isOpen_compl
      have hy_in_O : y_𝔪 ∈ O_𝔪 := by
        rintro ⟨w, hw_bad, hw_eq⟩
        have hqw : q.base w.1 = U.ι.base y_𝔪 := by
          rw [← hw_eq]
          exact (congrArg (fun f => f.base w) (AlgebraicGeometry.morphismRestrict_ι q U)).symm
        exact hw_bad (hF_sub hqw)
      have hp_in_pre : p_𝔪 ∈ hAffU.isoSpec.inv.base ⁻¹' O_𝔪 := hy_in_O
      obtain ⟨_, ⟨_, ⟨a_𝔪, rfl⟩, rfl⟩, hp_a, ha_sub⟩ :=
        PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open
          hp_in_pre (hO_open.preimage hAffU.isoSpec.inv.continuous)
      have ha_not_mem : a_𝔪 ∉ 𝔪 := hp_a
      have hBo_le_V𝔪 : C_K.basicOpen (θ a_𝔪) ≤ V_𝔪 := by
        have hpre_bo : C_K.basicOpen (θ a_𝔪) = q ⁻¹ᵁ Y.basicOpen a_𝔪 :=
          (AlgebraicGeometry.Scheme.Hom.preimage_basicOpen q a_𝔪).symm
        rw [hpre_bo]
        intro x hx_bo
        have hqx_U : q.base x ∈ U := AlgebraicGeometry.Scheme.basicOpen_le Y a_𝔪 hx_bo
        let w : ↥W.toScheme := ⟨x, hqx_U⟩
        let u_pt : ↥U.toScheme := q_U.base w
        have hu_eq : U.ι.base u_pt = q.base x :=
          congrArg (fun f => f.base w) (AlgebraicGeometry.morphismRestrict_ι q U)
        let p_pt : PrimeSpectrum A := hAffU.isoSpec.hom.base u_pt
        have hp_bo : p_pt ∈ PrimeSpectrum.basicOpen a_𝔪 := by
          rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hAffU a_𝔪]
          change hAffU.fromSpec.base p_pt ∈ Y.basicOpen a_𝔪
          have hfrom : hAffU.fromSpec.base p_pt = U.ι.base u_pt := by
            rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffU]
            exact congrArg (fun f : U.toScheme ⟶ U.toScheme => U.ι.base (f.base u_pt))
              hAffU.isoSpec.hom_inv_id
          rw [hfrom, hu_eq]
          exact hx_bo
        have hu_in_O : u_pt ∈ O_𝔪 := by
          have hinv_p : hAffU.isoSpec.inv.base p_pt = u_pt :=
            congrArg (fun f : U.toScheme ⟶ U.toScheme => f.base u_pt) hAffU.isoSpec.hom_inv_id
          have h1 : hAffU.isoSpec.inv.base p_pt ∈ O_𝔪 := ha_sub hp_bo
          rw [hinv_p] at h1
          exact h1
        by_contra hx_not_V
        have hw_bad : w ∈ K_bad := hx_not_V
        exact hu_in_O ⟨w, hw_bad, rfl⟩
      have hAff_bo : AlgebraicGeometry.IsAffineOpen (C_K.basicOpen (θ a_𝔪)) := by
        have hres := C_K.basicOpen_res (θ a_𝔪) (CategoryTheory.homOfLE hV𝔪_le).op
        have hinf : V_𝔪 ⊓ C_K.basicOpen (θ a_𝔪) = C_K.basicOpen (θ a_𝔪) :=
          inf_eq_right.mpr hBo_le_V𝔪
        rw [← hinf, ← hres]
        exact hAff_V𝔪.basicOpen _
      exact ⟨a_𝔪, hAff_bo, ha_not_mem⟩
    have hSup_U : (⨆ f : s_A, Y.basicOpen f.1) = U := by
      apply le_antisymm
      · exact iSup_le fun f => AlgebraicGeometry.Scheme.basicOpen_le Y f.1
      · intro y hyU
        let p_y : PrimeSpectrum A := hAffU.isoSpec.hom.base ⟨y, hyU⟩
        obtain ⟨𝔪, h𝔪_max, hp_le_𝔪⟩ := Ideal.exists_le_maximal p_y.asIdeal p_y.isPrime.ne_top
        obtain ⟨a, ha_sA, ha_not_𝔪⟩ := hex_good 𝔪 h𝔪_max
        have ha_not_py : a ∉ p_y.asIdeal := fun h => ha_not_𝔪 (hp_le_𝔪 h)
        have hpy_bo : p_y ∈ PrimeSpectrum.basicOpen a := ha_not_py
        rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hAffU a] at hpy_bo
        have hfrom_y : hAffU.fromSpec.base p_y = y := by
          rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffU]
          exact congrArg (fun f : U.toScheme ⟶ U.toScheme => U.ι.base (f.base ⟨y, hyU⟩))
            hAffU.isoSpec.hom_inv_id
        have hy_bo : y ∈ Y.basicOpen a := hfrom_y ▸ hpy_bo
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨a, ha_sA⟩, hy_bo⟩
    have hSpanA : Ideal.span s_A = ⊤ :=
      (hAffU.iSup_basicOpen_eq_self_iff).mp hSup_U
    have hSpanB : Ideal.span (θ '' s_A) = ⊤ := by
      rw [← Ideal.map_span, hSpanA, Ideal.map_top]
    refine AlgebraicGeometry.isAffineOpen_of_isAffineOpen_basicOpen W (θ '' s_A) hSpanB ?_
    rintro _ ⟨a, ha, rfl⟩
    exact ha

  
  have helper_two_chart_isIso :
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (q : C_K ⟶ Y) (U₀ U₁ : Y.Opens),
        U₀ ⊔ U₁ = ⊤ →
        AlgebraicGeometry.IsAffineOpen U₀ →
        AlgebraicGeometry.IsAffineOpen U₁ →
        AlgebraicGeometry.IsAffineOpen (q ⁻¹ᵁ U₀) →
        AlgebraicGeometry.IsAffineOpen (q ⁻¹ᵁ U₁) →
        Function.Bijective (q.app U₀).hom →
        Function.Bijective (q.app U₁).hom →
        CategoryTheory.IsIso q := by
    intro Y q U₀ U₁ hCov hAffU₀ hAffU₁ hAffW₀ hAffW₁ hBij₀ hBij₁
    have hChartIso : ∀ (U : Y.Opens),
        AlgebraicGeometry.IsAffineOpen U →
        AlgebraicGeometry.IsAffineOpen (q ⁻¹ᵁ U) →
        Function.Bijective (q.app U).hom →
        CategoryTheory.IsIso (q ∣_ U) := by
      intro U hAffU hAffW hBij
      haveI : AlgebraicGeometry.IsAffine U.toScheme := hAffU
      haveI : AlgebraicGeometry.IsAffine (q ⁻¹ᵁ U).toScheme := hAffW
      haveI : CategoryTheory.IsIso (q.app U) :=
        (CategoryTheory.ConcreteCategory.isIso_iff_bijective (q.app U)).mpr hBij
      have hiso_apptop : CategoryTheory.IsIso (q.app (U.ι ''ᵁ ⊤)) := by
        have heq_U' : U.ι ''ᵁ ⊤ = U := by
          ext x
          simp
        have hnat' := q.naturality (CategoryTheory.eqToHom heq_U'.symm).op
        let r_iso' := C_K.presheaf.map
          ((TopologicalSpace.Opens.map q.base).map (CategoryTheory.eqToHom heq_U'.symm).op.unop).op
        haveI : CategoryTheory.IsIso (q.app (U.ι ''ᵁ ⊤) ≫ r_iso') := by
          dsimp only [r_iso']
          rw [← hnat']
          infer_instance
        exact CategoryTheory.IsIso.of_isIso_comp_right (q.app (U.ι ''ᵁ ⊤)) r_iso'
      have hMapEqIso : ∀ {O₁ O₂ : C_K.Opens} (heq : O₁ = O₂),
          CategoryTheory.IsIso (C_K.presheaf.map (CategoryTheory.eqToHom heq).op) := by
        intro _ _ heq
        subst heq
        simp
        infer_instance
      haveI : CategoryTheory.IsIso (q ∣_ U).appTop := by
        rw [AlgebraicGeometry.morphismRestrict_appTop]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hiso_apptop (hMapEqIso _)
      have hspec := AlgebraicGeometry.Scheme.toSpecΓ_naturality (q ∣_ U)
      haveI : CategoryTheory.IsIso ((q ∣_ U) ≫ U.toScheme.toSpecΓ) := by
        rw [hspec]
        infer_instance
      exact CategoryTheory.IsIso.of_isIso_comp_right (q ∣_ U) U.toScheme.toSpecΓ
    let U_cov : Bool → Y.Opens
      | true => U₀
      | false => U₁
    have hSup : iSup U_cov = ⊤ := by
      rw [iSup_bool_eq]
      exact hCov
    rw [← CategoryTheory.MorphismProperty.isomorphisms.iff]
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme.{u}) U_cov hSup]
    intro b
    rw [CategoryTheory.MorphismProperty.isomorphisms.iff]
    cases b
    · exact hChartIso U₁ hAffU₁ hAffW₁ hBij₁
    · exact hChartIso U₀ hAffU₀ hAffW₀ hBij₀

  
  obtain ⟨hIntC, _hFlatG, hPropG, _hLFPG, _hSurjG,
    ⟨M₀, ιP₀, hClP₀, hCommP₀⟩, _hSecG, hPbC, hSecι⟩ := hMod
  obtain ⟨h3n, _hFlatCK, _hPropCK', _hLFPCK, _hSurjCK, hSecCK, _⟩ := hStabCK
  obtain ⟨hAffV₀, hAffV₁, hCovV, hBo_h₀, _hBo_t₀, _hMul_ht,
    hFin_h₀, hFin_t₀, _hFree_h₀, _hFree_t₀, _hFree_Q, _heZY_add, _heZY_mul,
    _hFree_eY, _hFin_eY, _hNon_eY, hFree_eZ, _hFin_eZ, hNon_eZ, hτ_mem, _⟩ := hPencil
  obtain ⟨hφ_comm, U_next₀, f₁, _hAff_Unext₀, _hPre_Unext₀, hBaseProj, _⟩ := hProjMap

  let η_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V.subtype)
  let P_next := weilProjectiveSpaceOver ↥V N'
  let C_next := AlgebraicGeometry.Scheme.Hom.image φ
  let g_next := AlgebraicGeometry.Scheme.Hom.imageι φ ≫ P_next.hom
  let X_next_K := CategoryTheory.Limits.pullback g_next η_V
  let fst_next := CategoryTheory.Limits.pullback.fst g_next η_V
  let snd_next := CategoryTheory.Limits.pullback.snd g_next η_V

  have hq_comm : (ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ) ≫ g_next = p_K ≫ η_V := by
    dsimp only [g_next, P_next, η_V]
    rw [Category.assoc,
      ← Category.assoc (AlgebraicGeometry.Scheme.Hom.toImage φ),
      AlgebraicGeometry.Scheme.Hom.toImage_imageι φ,
      hφ_comm, hPbC.w]
  let q_CK : C_K ⟶ X_next_K :=
    CategoryTheory.Limits.pullback.lift (ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ) p_K hq_comm
  have hq_fst : q_CK ≫ fst_next = ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_snd : q_CK ≫ snd_next = p_K :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  
  haveI : AlgebraicGeometry.IsProper P_next.hom := (helper_proj_proper_and_scalar ↥V N').1
  haveI : AlgebraicGeometry.IsProper g_next := by dsimp only [g_next]; infer_instance
  have hPropY : AlgebraicGeometry.IsProper snd_next := by dsimp only [snd_next]; infer_instance
  haveI : AlgebraicGeometry.IsProper snd_next := hPropY
  haveI : AlgebraicGeometry.IsProper p_K := hPropCK
  have hPropQ : AlgebraicGeometry.IsProper q_CK :=
    @AlgebraicGeometry.IsProper.of_comp _ _ _ q_CK snd_next
      (by rw [hq_snd]; infer_instance) inferInstance
  haveI : AlgebraicGeometry.IsProper q_CK := hPropQ

  have hOpen_η : AlgebraicGeometry.IsOpenImmersion η_V := by
    have hFinSpec : Set.Finite (Set.univ : Set (PrimeSpectrum ↥V)) := hPkg.1
    have _ : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFinSpec
    let _ : Fintype (PrimeSpectrum ↥V) := Fintype.ofFinite (PrimeSpectrum ↥V)
    let F_pos : Finset (PrimeSpectrum ↥V) :=
      Finset.univ.filter (fun P : PrimeSpectrum ↥V => P.asIdeal ≠ ⊥)
    have hExAway : ∃ s_loc : ↥V, @IsLocalization.Away _ _ s_loc K _ V.subtype.toAlgebra := by
      letI : Algebra ↥V K := V.subtype.toAlgebra
      by_cases hne : F_pos.Nonempty
      · have hMin : ∀ (G : Finset (PrimeSpectrum ↥V)), G.Nonempty →
            ∃ Q ∈ G, ∀ P ∈ G, Q.asIdeal ≤ P.asIdeal := by
          intro G
          induction G using Finset.induction with
          | empty =>
            intro hG
            exact False.elim (Finset.not_nonempty_empty hG)
          | @insert a G _ ih =>
            intro _
            by_cases hG : G.Nonempty
            · obtain ⟨Q', hQ'G, hQ'le⟩ := ih hG
              rcases le_total a.asIdeal Q'.asIdeal with haQ' | hQ'a
              · refine ⟨a, Finset.mem_insert_self a G, fun P hP => ?_⟩
                rcases Finset.mem_insert.mp hP with rfl | hPG
                · exact le_refl _
                · exact le_trans haQ' (hQ'le P hPG)
              · refine ⟨Q', Finset.mem_insert_of_mem hQ'G, fun P hP => ?_⟩
                rcases Finset.mem_insert.mp hP with rfl | hPG
                · exact hQ'a
                · exact hQ'le P hPG
            · refine ⟨a, Finset.mem_insert_self a G, fun P hP => ?_⟩
              rcases Finset.mem_insert.mp hP with rfl | hPG
              · exact le_refl _
              · exact False.elim (hG ⟨P, hPG⟩)
        obtain ⟨Q₀, hQ₀_mem, hQ₀_min⟩ := hMin F_pos hne
        have hQ₀_ne : Q₀.asIdeal ≠ ⊥ := (Finset.mem_filter.mp hQ₀_mem).2
        obtain ⟨s₀, hs₀_mem, hs₀_ne⟩ := (Submodule.ne_bot_iff Q₀.asIdeal).mp hQ₀_ne
        refine ⟨s₀, { map_units := ?_, surj := ?_, exists_of_eq := ?_ }⟩
        · intro y
          obtain ⟨k, hk⟩ := y.2
          dsimp at hk
          have hs₀K : algebraMap ↥V K s₀ ≠ 0 := fun h0 => hs₀_ne (Subtype.ext h0)
          have hyK : algebraMap ↥V K y.1 ≠ 0 := by
            rw [← hk, map_pow]
            exact pow_ne_zero k hs₀K
          exact Ne.isUnit hyK
        · intro z
          rcases V.mem_or_inv_mem z with hz | hz_inv
          · exact ⟨⟨⟨z, hz⟩, ⟨1, Submonoid.one_mem _⟩⟩, by simp; rfl⟩
          · by_cases hz0 : z = 0
            · subst hz0
              exact ⟨⟨0, ⟨1, Submonoid.one_mem _⟩⟩, by simp⟩
            · let b : ↥V := ⟨z⁻¹, hz_inv⟩
              have hb_ne : b ≠ 0 := fun hb0 => inv_ne_zero hz0 (congrArg Subtype.val hb0)
              have hs₀_rad : s₀ ∈ (Ideal.span ({b} : Set ↥V)).radical := by
                rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
                rintro I ⟨hbI, hI_prime⟩
                have hI_ne : I ≠ ⊥ := by
                  intro hI0
                  apply hb_ne
                  rw [hI0] at hbI
                  exact Ideal.mem_bot.mp (hbI (Ideal.subset_span (Set.mem_singleton b)))
                exact hQ₀_min ⟨I, hI_prime⟩
                  (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hI_ne⟩) hs₀_mem
              obtain ⟨k, hk⟩ := Ideal.mem_radical_iff.mp hs₀_rad
              obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hk
              refine ⟨⟨c, ⟨s₀ ^ k, ⟨k, rfl⟩⟩⟩, ?_⟩
              change z * V.subtype (s₀ ^ k) = V.subtype c
              have hcK : V.subtype (s₀ ^ k) = z⁻¹ * V.subtype c := by
                simpa [b] using congrArg V.subtype hc
              rw [hcK, ← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
        · intro x₁ x₂ h
          exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [Subtype.ext h]⟩
      · rw [Finset.not_nonempty_iff_eq_empty] at hne
        refine ⟨1, { map_units := ?_, surj := ?_, exists_of_eq := ?_ }⟩
        · intro y
          obtain ⟨k, hk⟩ := y.2
          dsimp at hk
          have hy1 : y.1 = 1 := by rw [← hk, one_pow]
          rw [hy1, map_one]
          exact isUnit_one
        · intro z
          rcases V.mem_or_inv_mem z with hz | hz_inv
          · exact ⟨⟨⟨z, hz⟩, ⟨1, Submonoid.one_mem _⟩⟩, by simp; rfl⟩
          · by_cases hz0 : z = 0
            · subst hz0
              exact ⟨⟨0, ⟨1, Submonoid.one_mem _⟩⟩, by simp⟩
            · let b : ↥V := ⟨z⁻¹, hz_inv⟩
              have hb_ne : b ≠ 0 := fun hb0 => inv_ne_zero hz0 (congrArg Subtype.val hb0)
              have hb_unit : IsUnit b := by
                by_contra hnu
                have hspan_ne : Ideal.span ({b} : Set ↥V) ≠ ⊤ :=
                  mt Ideal.span_singleton_eq_top.mp hnu
                obtain ⟨m_id, hm_max, hle_m⟩ := Ideal.exists_le_maximal _ hspan_ne
                have _ : m_id.IsPrime := hm_max.isPrime
                have hm_ne : m_id ≠ ⊥ := by
                  intro hm0
                  apply hb_ne
                  rw [hm0] at hle_m
                  exact Ideal.mem_bot.mp (hle_m (Ideal.subset_span (Set.mem_singleton b)))
                have hmem : (⟨m_id, inferInstance⟩ : PrimeSpectrum ↥V) ∈ F_pos :=
                  Finset.mem_filter.mpr ⟨Finset.mem_univ _, hm_ne⟩
                rw [hne] at hmem
                exact Finset.notMem_empty _ hmem
              obtain ⟨u, hu⟩ := hb_unit
              refine ⟨⟨↑(u⁻¹), ⟨1, Submonoid.one_mem _⟩⟩, ?_⟩
              change z * V.subtype 1 = V.subtype ↑(u⁻¹)
              have huK : z⁻¹ * V.subtype ↑(u⁻¹) = 1 := by
                have hmul : V.subtype (↑u * ↑(u⁻¹)) = 1 := by simp
                rw [map_mul, hu] at hmul
                exact hmul
              calc
                z * V.subtype 1 = z * 1 := by simp
                _ = z * (z⁻¹ * V.subtype ↑(u⁻¹)) := by rw [huK]
                _ = (z * z⁻¹) * V.subtype ↑(u⁻¹) := by ring
                _ = V.subtype ↑(u⁻¹) := by rw [mul_inv_cancel₀ hz0, one_mul]
        · intro x₁ x₂ h
          exact ⟨⟨1, Submonoid.one_mem _⟩, by simp [Subtype.ext h]⟩
    obtain ⟨s_loc, hs_loc⟩ := hExAway
    letI : Algebra ↥V K := V.subtype.toAlgebra
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization ↥V K _ _ _ s_loc hs_loc

  haveI : AlgebraicGeometry.IsOpenImmersion η_V := hOpen_η
  haveI : AlgebraicGeometry.IsOpenImmersion ι :=
    CategoryTheory.MorphismProperty.of_isPullback hPbC.flip inferInstance
  haveI : AlgebraicGeometry.IsOpenImmersion fst_next :=
    CategoryTheory.MorphismProperty.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_next η_V).flip inferInstance
  haveI : AlgebraicGeometry.IsIntegral C_K := hIntCK
  haveI : AlgebraicGeometry.IsIntegral C := hIntC
  haveI : AlgebraicGeometry.IsProper g := hPropG
  have hQC_φP : AlgebraicGeometry.QuasiCompact (φ ≫ P_next.hom) := by
    dsimp only [P_next]
    rw [hφ_comm]
    infer_instance
  haveI : AlgebraicGeometry.QuasiCompact φ :=
    @AlgebraicGeometry.QuasiCompact.of_comp _ _ _ φ P_next.hom hQC_φP inferInstance
  have hDense_toImg : DenseRange (AlgebraicGeometry.Scheme.Hom.toImage φ).base :=
    AlgebraicGeometry.IsDominant.denseRange (f := AlgebraicGeometry.Scheme.Hom.toImage φ)
  have hIrredC : IrreducibleSpace ↥C := AlgebraicGeometry.irreducibleSpace_of_isIntegral C
  haveI : PreirreducibleSpace ↥C := hIrredC.toPreirreducibleSpace
  obtain ⟨x_any⟩ : Nonempty ↥C_K := AlgebraicGeometry.IsIntegral.nonempty
  have hDense_ι : DenseRange ι.base :=
    (AlgebraicGeometry.IsOpenImmersion.isOpen_range ι).dense ⟨ι.base x_any, ⟨x_any, rfl⟩⟩
  have hDense_comp : DenseRange (ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ).base :=
    hDense_toImg.comp hDense_ι (AlgebraicGeometry.Scheme.Hom.toImage φ).continuous
  have hSurjQ : Function.Surjective q_CK.base := by
    intro y
    by_contra hy_not
    let U_y : Set ↥X_next_K := (Set.range q_CK.base)ᶜ
    have hCl_range : IsClosed (Set.range q_CK.base) := by
      rw [← Set.image_univ]
      exact q_CK.isClosedMap Set.univ isClosed_univ
    have hOpen_Uy : IsOpen U_y := hCl_range.isOpen_compl
    have hOpen_img : IsOpen (fst_next.base '' U_y) :=
      fst_next.isOpenEmbedding.isOpenMap U_y hOpen_Uy
    have hNe_img : (fst_next.base '' U_y).Nonempty := ⟨fst_next.base y, y, hy_not, rfl⟩
    obtain ⟨_, ⟨y', hy'_Uy, rfl⟩, x, hx_eq⟩ :=
      hDense_comp.inter_open_nonempty (fst_next.base '' U_y) hOpen_img hNe_img
    have hfst_eq : fst_next.base (q_CK.base x) = fst_next.base y' := by
      have h1 := congrArg (fun f => f.base x) hq_fst
      exact h1.trans hx_eq
    have hqx_eq : q_CK.base x = y' := fst_next.isOpenEmbedding.injective hfst_eq
    exact hy'_Uy ⟨x, hqx_eq⟩

  
  obtain ⟨⟨Ψ₀, hΨ₀_fst⟩, hFinV₀⟩ :=
    helper_chart_pullback_and_closed_finite hPbC V₀ hAffV₀ h₀ hFin_h₀
  obtain ⟨_, hFinV₁⟩ :=
    helper_chart_pullback_and_closed_finite hPbC V₁ hAffV₁ t₀ hFin_t₀
  have hFinClosed : ∀ Z_cl : Set ↥C_K, IsClosed Z_cl → Z_cl ≠ Set.univ → Z_cl.Finite := by
    intro Z_cl hZ_cl hZ_ne
    have hUnion : Z_cl =
        (Z_cl ∩ ((ι ⁻¹ᵁ V₀ : C_K.Opens) : Set ↥C_K)) ∪
          (Z_cl ∩ ((ι ⁻¹ᵁ V₁ : C_K.Opens) : Set ↥C_K)) := by
      ext x
      simp only [Set.mem_union, Set.mem_inter_iff]
      constructor
      · intro hxZ
        have htop : ι.base x ∈ (⊤ : C.Opens) := trivial
        rw [← hCovV] at htop
        rcases htop with hx0 | hx1
        · exact Or.inl ⟨hxZ, hx0⟩
        · exact Or.inr ⟨hxZ, hx1⟩
      · rintro (⟨hxZ, -⟩ | ⟨hxZ, -⟩) <;> exact hxZ
    rw [hUnion]
    exact (hFinV₀ Z_cl hZ_cl hZ_ne).union (hFinV₁ Z_cl hZ_cl hZ_ne)

  
  let e_CK : C_K ≅ CategoryTheory.Limits.pullback g η_V := hPbC.isoPullback
  let q_s : CategoryTheory.Limits.pullback g η_V ⟶ X_next_K := e_CK.inv ≫ q_CK
  have hqs_fst : q_s ≫ fst_next =
      CategoryTheory.Limits.pullback.fst g η_V ≫ AlgebraicGeometry.Scheme.Hom.toImage φ := by
    dsimp only [q_s]
    rw [Category.assoc, hq_fst, ← Category.assoc]
    congr 1
    rw [CategoryTheory.Iso.inv_comp_eq]
    exact (CategoryTheory.IsPullback.isoPullback_hom_fst hPbC).symm
  have hqs_snd : q_s ≫ snd_next = CategoryTheory.Limits.pullback.snd g η_V := by
    dsimp only [q_s]
    rw [Category.assoc, hq_snd, CategoryTheory.Iso.inv_comp_eq]
    exact (CategoryTheory.IsPullback.isoPullback_hom_snd hPbC).symm
  obtain ⟨hAffU₀, heq₀_le, hPre_qs₀, hBij_qs₀, hExU₁⟩ :=
    hBaseProj K η_V q_s hqs_fst hqs_snd
  obtain ⟨U₁_0, hAffU₁, hCovU, _hInter_bo, hBij_qs₁⟩ := hExU₁ (0 : K)
  let U₀_K : X_next_K.Opens := fst_next ⁻¹ᵁ U_next₀

  have hq_eq : q_CK = e_CK.hom ≫ q_s := by
    dsimp only [q_s]
    rw [CategoryTheory.Iso.hom_inv_id_assoc]
  have hTransBij : ∀ (U : X_next_K.Opens)
      (W' : (CategoryTheory.Limits.pullback g η_V).Opens)
      (hle : W' ≤ q_s ⁻¹ᵁ U),
      q_s ⁻¹ᵁ U = W' →
      Function.Bijective (q_s.appLE U W' hle).hom →
      Function.Bijective (q_CK.app U).hom := by
    intro U W' hle hW'_eq hBij_s
    haveI : CategoryTheory.IsIso e_CK.hom := e_CK.isIso_hom
    let res_map := (CategoryTheory.Limits.pullback g η_V).presheaf.map
      (CategoryTheory.homOfLE hle).op
    haveI : CategoryTheory.IsIso res_map := by
      dsimp only [res_map]
      have heq_hom : CategoryTheory.homOfLE hle = CategoryTheory.eqToHom hW'_eq.symm := rfl
      rw [heq_hom]
      infer_instance
    haveI : CategoryTheory.IsIso (q_s.appLE U W' hle) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (q_s.appLE U W' hle)).mpr hBij_s
    haveI : CategoryTheory.IsIso (q_s.app U) := by
      haveI : CategoryTheory.IsIso (q_s.app U ≫ res_map) := by
        change CategoryTheory.IsIso (q_s.appLE U W' hle)
        infer_instance
      exact CategoryTheory.IsIso.of_isIso_comp_right (q_s.app U) res_map
    have hMapEqIso : ∀ {O₁ O₂ : C_K.Opens} (heq : O₁ = O₂),
        CategoryTheory.IsIso (C_K.presheaf.map (CategoryTheory.eqToHom heq).op) := by
      intro _ _ heq
      subst heq
      simp
      infer_instance
    have hiso_eCK_app : CategoryTheory.IsIso (e_CK.hom.app (q_s ⁻¹ᵁ U)) :=
      @AlgebraicGeometry.Scheme.Hom.instIsIsoCommRingCatApp _ _ e_CK.hom e_CK.isIso_hom (q_s ⁻¹ᵁ U)
    have hcongr := AlgebraicGeometry.Scheme.Hom.congr_app hq_eq U
    haveI : CategoryTheory.IsIso (q_CK.app U) := by
      rw [hcongr, AlgebraicGeometry.Scheme.Hom.comp_app]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _
        (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ inferInstance hiso_eCK_app)
        (hMapEqIso _)
    exact (CategoryTheory.ConcreteCategory.isIso_iff_bijective (q_CK.app U)).mp inferInstance

  have hBij₀ : Function.Bijective (q_CK.app U₀_K).hom :=
    hTransBij U₀_K _ heq₀_le hPre_qs₀ hBij_qs₀
  have hBij₁ : Function.Bijective (q_CK.app U₁_0).hom :=
    hTransBij U₁_0 (q_s ⁻¹ᵁ U₁_0) le_rfl rfl hBij_qs₁

  let W₀_K : C_K.Opens := q_CK ⁻¹ᵁ U₀_K
  let W₁_0 : C_K.Opens := q_CK ⁻¹ᵁ U₁_0
  have hW₀_eq : W₀_K = ι ⁻¹ᵁ (V₁ ⊔ C.basicOpen eZ) := by
    ext x
    change x ∈ W₀_K ↔ x ∈ ι ⁻¹ᵁ (V₁ ⊔ C.basicOpen eZ)
    have h1 : x ∈ W₀_K ↔ q_s.base (e_CK.hom.base x) ∈ U₀_K := by
      change q_CK.base x ∈ U₀_K ↔ q_s.base (e_CK.hom.base x) ∈ U₀_K
      have hx := congrArg (fun f => f.base x) hq_eq
      rw [hx]
      rfl
    have h2 : q_s.base (e_CK.hom.base x) ∈ U₀_K ↔
        (CategoryTheory.Limits.pullback.fst g η_V).base (e_CK.hom.base x) ∈ V₁ ⊔ C.basicOpen eZ := by
      change e_CK.hom.base x ∈ q_s ⁻¹ᵁ U₀_K ↔ _
      rw [hPre_qs₀]
      rfl
    have h3 : (CategoryTheory.Limits.pullback.fst g η_V).base (e_CK.hom.base x) = ι.base x :=
      congrArg (fun f => f.base x) (CategoryTheory.IsPullback.isoPullback_hom_fst hPbC)
    rw [h1, h2, h3]
    rfl

  let j₀ : Fin n := ⟨0, by omega⟩
  let pt_K : AlgebraicGeometry.Spec (CommRingCat.of K) := (⊥ : PrimeSpectrum K)
  let x₀ : ↥C_K := (σ_K j₀).base pt_K
  have hx₀_W₀ : x₀ ∈ W₀_K := by
    rw [hW₀_eq]
    change ι.base x₀ ∈ V₁ ⊔ C.basicOpen eZ
    have hsec_x₀ : ι.base x₀ = (τ j₀).base (η_V.base pt_K) :=
      congrArg (fun f => f.base pt_K) (hSecι j₀)
    rw [hsec_x₀]
    exact Or.inl (hτ_mem j₀ (η_V.base pt_K)).2
  have hW₀_ne : Nonempty ↥W₀_K := ⟨⟨x₀, hx₀_W₀⟩⟩

  let R₀ := C.presheaf.obj (Opposite.op V₀)
  letI : Algebra ↥V ↑R₀ :=
    (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₀ le_top).hom).toAlgebra
  obtain ⟨p_bad, hp_h₀, hp_eZ⟩ :=
    helper_free_quotient_prime_exists ↑R₀ h₀ eZ hFree_eZ hNon_eZ
  let v₁ : ↥(ι ⁻¹ᵁ V₀).toScheme := Ψ₀.inv.base p_bad
  let x₁ : ↥C_K := (ι ⁻¹ᵁ V₀).ι.base v₁
  have hx₁_not_bo : ∀ s_sec : ↑R₀,
      (s_sec ⊗ₜ[↥V] (1 : K)) ∈ p_bad.asIdeal → ι.base x₁ ∉ C.basicOpen s_sec := by
    intro s_sec hs_mem hx_bo
    let u_C : ↥V₀.toScheme := (ι ∣_ V₀).base v₁
    have hu_eq : V₀.ι.base u_C = ι.base x₁ :=
      congrArg (fun f => f.base v₁) (AlgebraicGeometry.morphismRestrict_ι ι V₀)
    have hp_eq : hAffV₀.isoSpec.hom.base u_C =
        PrimeSpectrum.comap Algebra.TensorProduct.includeLeftRingHom p_bad := by
      have h1 := congrArg (fun f => f.base v₁) hΨ₀_fst.symm
      change ((ι ∣_ V₀) ≫ hAffV₀.isoSpec.hom).base v₁ = _
      rw [h1]
      have hinv : Ψ₀.hom.base v₁ = p_bad :=
        congrArg (fun f : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↥V ↑R₀ K)) ⟶ _ =>
          f.base p_bad) Ψ₀.inv_hom_id
      change (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom)).base (Ψ₀.hom.base v₁) = _
      rw [hinv]
      rfl
    have hp_bo : hAffV₀.isoSpec.hom.base u_C ∈ PrimeSpectrum.basicOpen s_sec := by
      rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_preimage_basicOpen hAffV₀ s_sec]
      change hAffV₀.fromSpec.base (hAffV₀.isoSpec.hom.base u_C) ∈ C.basicOpen s_sec
      have hfrom : hAffV₀.fromSpec.base (hAffV₀.isoSpec.hom.base u_C) = V₀.ι.base u_C := by
        rw [← AlgebraicGeometry.IsAffineOpen.isoSpec_inv_ι hAffV₀]
        exact congrArg (fun f : V₀.toScheme ⟶ V₀.toScheme => V₀.ι.base (f.base u_C))
          hAffV₀.isoSpec.hom_inv_id
      rw [hfrom, hu_eq]
      exact hx_bo
    rw [hp_eq] at hp_bo
    exact hp_bo hs_mem
  have hx₁_not_W₀ : x₁ ∉ W₀_K := by
    rw [hW₀_eq]
    intro hx_mem
    rcases hx_mem with hx_V₁ | hx_eZ
    · have hx_V₀ : ι.base x₁ ∈ V₀ := v₁.2
      have hx_inf : ι.base x₁ ∈ C.basicOpen h₀ := by
        rw [hBo_h₀]
        exact ⟨hx_V₀, hx_V₁⟩
      exact hx₁_not_bo h₀ hp_h₀ hx_inf
    · exact hx₁_not_bo eZ hp_eZ hx_eZ
  have hW₀c_ne : ((W₀_K : Set ↥C_K)ᶜ).Nonempty := ⟨x₁, hx₁_not_W₀⟩

  have hx₁_W₁ : x₁ ∈ W₁_0 := by
    have hq_top : q_CK.base x₁ ∈ (⊤ : X_next_K.Opens) := trivial
    rw [← hCovU] at hq_top
    rcases hq_top with hq0 | hq1
    · exact False.elim (hx₁_not_W₀ hq0)
    · exact hq1
  have hW₁_ne : Nonempty ↥W₁_0 := ⟨⟨x₁, hx₁_W₁⟩⟩

  have hW₁c_ne : ((W₁_0 : Set ↥C_K)ᶜ).Nonempty := by
    by_contra hEmpty
    have hW₁_top : W₁_0 = ⊤ := by
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      by_contra hx_not
      exact hEmpty ⟨x, hx_not⟩
    have hBij_pK := helper_proper_integral_section_appTop_bijective (σ_K j₀) (hSecCK j₀)
    haveI : CategoryTheory.IsIso p_K.appTop :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective p_K.appTop).mpr hBij_pK
    haveI : CategoryTheory.IsIso (q_CK.app U₁_0) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (q_CK.app U₁_0)).mpr hBij₁
    let iso_ring : CommRingCat.of K ≅ X_next_K.presheaf.obj (Opposite.op U₁_0) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).symm ≪≫
        CategoryTheory.asIso p_K.appTop ≪≫
        C_K.presheaf.mapIso (CategoryTheory.eqToIso hW₁_top).op ≪≫
        (CategoryTheory.asIso (q_CK.app U₁_0)).symm
    let iso_U₁ : U₁_0.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      hAffU₁.isoSpec ≪≫ AlgebraicGeometry.Scheme.Spec.mapIso iso_ring.op
    have hSubSpecK : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      refine ⟨fun p₁ p₂ => PrimeSpectrum.ext ?_⟩
      have hp₁ : p₁.asIdeal = ⊥ := (Ideal.eq_bot_or_top p₁.asIdeal).resolve_right p₁.isPrime.ne_top
      have hp₂ : p₂.asIdeal = ⊥ := (Ideal.eq_bot_or_top p₂.asIdeal).resolve_right p₂.isPrime.ne_top
      rw [hp₁, hp₂]
    have hSubU₁ : Subsingleton ↥U₁_0.toScheme :=
      Function.Injective.subsingleton
        (f := iso_U₁.hom.base)
        (fun u₁ u₂ h => by
          have h1 := congrArg iso_U₁.inv.base h
          have hu₁ : iso_U₁.inv.base (iso_U₁.hom.base u₁) = u₁ :=
            congrArg (fun f : U₁_0.toScheme ⟶ U₁_0.toScheme => f.base u₁) iso_U₁.hom_inv_id
          have hu₂ : iso_U₁.inv.base (iso_U₁.hom.base u₂) = u₂ :=
            congrArg (fun f : U₁_0.toScheme ⟶ U₁_0.toScheme => f.base u₂) iso_U₁.hom_inv_id
          exact hu₁.symm.trans (h1.trans hu₂))
    have hx₀_W₁ : x₀ ∈ W₁_0 := by rw [hW₁_top]; trivial
    have hEq_u : (⟨q_CK.base x₀, hx₀_W₁⟩ : ↥U₁_0.toScheme) = ⟨q_CK.base x₁, hx₁_W₁⟩ :=
      @Subsingleton.elim _ hSubU₁ _ _
    have hEq_q : q_CK.base x₀ = q_CK.base x₁ := congrArg Subtype.val hEq_u
    exact hx₁_not_W₀ (by change q_CK.base x₁ ∈ U₀_K; rw [← hEq_q]; exact hx₀_W₀)

  
  haveI : AlgebraicGeometry.IsClosedImmersion ιP₀ := hClP₀
  haveI : AlgebraicGeometry.IsAffineHom η_V := inferInstance
  haveI : AlgebraicGeometry.IsAffineHom ι :=
    CategoryTheory.MorphismProperty.of_isPullback hPbC.flip inferInstance
  let j_PV : C_K ⟶ (weilProjectiveSpaceOver ↥V M₀).left := ι ≫ ιP₀
  have hAffJ : AlgebraicGeometry.IsAffineHom j_PV := by dsimp only [j_PV]; infer_instance
  have hSepW : ∀ W : C_K.Opens, ((W : Set ↥C_K)ᶜ).Nonempty →
      ∃ U_cl : (weilProjectiveSpaceOver ↥V M₀).left.Opens,
        j_PV ⁻¹ᵁ U_cl = W ∧ ∃ z₀ : ↥C_K, j_PV.base z₀ ∉ U_cl := by
    intro W ⟨z₀, hz₀⟩
    obtain ⟨F_C, hFC_cl, hFC_pre⟩ :=
      ι.isOpenEmbedding.isInducing.isClosed_iff.mp W.isOpen.isClosed_compl
    let K_cl : Set ↥(weilProjectiveSpaceOver ↥V M₀).left := ιP₀.base '' F_C
    have hKcl_cl : IsClosed K_cl := ιP₀.isClosedMap F_C hFC_cl
    let U_cl : (weilProjectiveSpaceOver ↥V M₀).left.Opens := ⟨K_clᶜ, hKcl_cl.isOpen_compl⟩
    have hinj_ιP₀ : Function.Injective ιP₀.base :=
      (AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding ιP₀).injective
    refine ⟨U_cl, ?_, z₀, ?_⟩
    · ext x
      change ιP₀.base (ι.base x) ∉ ιP₀.base '' F_C ↔ x ∈ (W : Set ↥C_K)
      rw [hinj_ιP₀.mem_set_image]
      change x ∉ ι.base ⁻¹' F_C ↔ x ∈ (W : Set ↥C_K)
      rw [hFC_pre]
      exact not_not
    · intro hz_in
      have hz_FC : ι.base z₀ ∈ F_C := by
        change z₀ ∈ ι.base ⁻¹' F_C
        rw [hFC_pre]
        exact hz₀
      exact hz_in ⟨ι.base z₀, hz_FC, rfl⟩
  have hGenPt : ∀ x : ↥C_K,
      (((weilProjectiveSpaceOver ↥V M₀).hom.base (j_PV.base x)) : PrimeSpectrum ↥V).asIdeal = ⊥ := by
    intro x
    have hj_comm : j_PV ≫ (weilProjectiveSpaceOver ↥V M₀).hom = p_K ≫ η_V := by
      dsimp only [j_PV]
      rw [Category.assoc, hCommP₀, hPbC.w]
    have hpt_eq : (weilProjectiveSpaceOver ↥V M₀).hom.base (j_PV.base x) =
        η_V.base (p_K.base x) :=
      congrArg (fun f => f.base x) hj_comm
    rw [hpt_eq]
    let pt : PrimeSpectrum K := p_K.base x
    have hpt_bot : pt.asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top pt.asIdeal).resolve_right pt.isPrime.ne_top
    change Ideal.comap V.subtype pt.asIdeal = ⊥
    rw [hpt_bot, eq_bot_iff]
    intro v hv
    have hv0 : V.subtype v = 0 := Ideal.mem_bot.mp hv
    exact Ideal.mem_bot.mpr (Subtype.ext hv0)

  have hAffW₀ : AlgebraicGeometry.IsAffineOpen W₀_K :=
    helper_crux_chart_isAffineOpen X_next_K snd_next q_CK hPropY hPropQ hq_snd hSurjQ hFinClosed
      M₀ j_PV hAffJ hSepW hGenPt U₀_K hAffU₀ hW₀_ne hW₀c_ne hBij₀
  have hAffW₁ : AlgebraicGeometry.IsAffineOpen W₁_0 :=
    helper_crux_chart_isAffineOpen X_next_K snd_next q_CK hPropY hPropQ hq_snd hSurjQ hFinClosed
      M₀ j_PV hAffJ hSepW hGenPt U₁_0 hAffU₁ hW₁_ne hW₁c_ne hBij₁

  
  haveI : CategoryTheory.IsIso q_CK :=
    helper_two_chart_isIso X_next_K q_CK U₀_K U₁_0 hCovU hAffU₀ hAffU₁ hAffW₀ hAffW₁ hBij₀ hBij₁
  exact CategoryTheory.IsPullback.of_iso
    (CategoryTheory.IsPullback.of_hasPullback g_next η_V)
    (CategoryTheory.asIso q_CK).symm
    (CategoryTheory.Iso.refl C_next)
    (CategoryTheory.Iso.refl _)
    (CategoryTheory.Iso.refl _)
    (by
      change fst_next ≫ 𝟙 C_next = CategoryTheory.inv q_CK ≫ (ι ≫ AlgebraicGeometry.Scheme.Hom.toImage φ)
      rw [Category.comp_id, CategoryTheory.IsIso.eq_inv_comp]
      exact hq_fst)
    (by
      change snd_next ≫ 𝟙 _ = CategoryTheory.inv q_CK ≫ p_K
      rw [Category.comp_id, CategoryTheory.IsIso.eq_inv_comp]
      exact hq_snd)
    (by simp [CategoryTheory.Iso.refl_hom]; rfl)
    (by simp [CategoryTheory.Iso.refl_hom]; rfl)

theorem weil_sup1_closed_fiber_markings_disjoint_and_smooth (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀)
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (hProjMap : IsUnstableP1ContractionProjMap V g Z V₀ V₁ eZ N' φ) :
    let C_next := AlgebraicGeometry.Scheme.Hom.image φ
    let g_next := AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom
    let τ_next := fun j : Fin n => τ j ≫ AlgebraicGeometry.Scheme.Hom.toImage φ
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥V k₀))
    (_root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_next i).base) (Set.range (τ_next j).base)) ∧
    (∀ j : Fin n,
      ∃ (b₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀))
        (y_j : ↥(CategoryTheory.Limits.pullback g_next s₀))
        (W_sm : (CategoryTheory.Limits.pullback g_next s₀).Opens),
        y_j ∈ W_sm ∧
        (CategoryTheory.Limits.pullback.fst g_next s₀).base y_j = (s₀ ≫ τ_next j).base b₀ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (W_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_next s₀)) :=
by
  classical
  have part4_alg_stub : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (R₁ : Type u) [CommRing R₁] [_root_.IsReduced R₁] [IsNoetherianRing R₁]
      (c₁_Y : k₀ →+* R₁) (_hc₁_FT : c₁_Y.FiniteType)
      (J_Z J_Y' : Ideal R₁)
      (_hJZ_rad : J_Z.IsRadical) (_hJY'_rad : J_Y'.IsRadical)
      (_hInf : J_Z ⊓ J_Y' = ⊥)
      (M_star : Ideal R₁) [M_star.IsPrime]
      (_hUnique : ∀ P : PrimeSpectrum R₁, J_Z ⊔ J_Y' ≤ P.asIdeal ↔ P.asIdeal = M_star)
      (a_Z a_Y' : R₁)
      (_haZ_mem : a_Z ∈ J_Z) (_haZ_nz : ∀ s : R₁, s ∉ M_star → s * a_Z ≠ 0)
      (_haY'_mem : a_Y' ∈ J_Y') (_haY'_nz : ∀ s : R₁, s ∉ M_star → s * a_Y' ≠ 0)
      (D : Type u) [CommRing D] (n₀ : PrimeSpectrum D)
      (ψ₁ : R₁ →+* D) (_hEt₁ : ψ₁.Etale)
      (_hcomap : Ideal.comap ψ₁ n₀.asIdeal = M_star)
      (ψ₂ : (MvPolynomial (Fin 2) k₀ ⧸ Ideal.span
        {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k₀) * MvPolynomial.X 1}) →+* D)
      (_hEt₂ : ψ₂.Etale)
      (_hX : ∀ i : Fin 2,
        ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) k₀)) ∈ n₀.asIdeal),
      M_star.IsMaximal ∧
      (∀ r : R₁, ∃ c : k₀, r - c₁_Y c ∈ M_star) ∧
      J_Z ⊔ J_Y' = M_star := by
    intro k₀ _ _ R₁ _ _ _ c₁_Y hc₁_FT J_Z J_Y' hJZ_rad hJY'_rad hInf M_star _ hUnique
      a_Z a_Y' haZ_mem haZ_nz haY'_mem haY'_nz D _ n₀ ψ₁ hEt₁ hcomap ψ₂ hEt₂ hX
    have hJ_le_M : J_Z ⊔ J_Y' ≤ M_star := (hUnique ⟨M_star, inferInstance⟩).mpr rfl
    have hM_max : M_star.IsMaximal := by
      obtain ⟨𝔪, h𝔪_max, hM_le_𝔪⟩ := Ideal.exists_le_maximal M_star (Ideal.IsPrime.ne_top ‹_›)
      have h_eq : 𝔪 = M_star :=
        (hUnique ⟨𝔪, h𝔪_max.isPrime⟩).mp (hJ_le_M.trans hM_le_𝔪)
      rwa [← h_eq]
    have hRes_k₀ : ∀ r : R₁, ∃ c : k₀, r - c₁_Y c ∈ M_star := by
      letI : Algebra k₀ R₁ := c₁_Y.toAlgebra
      have : Algebra.FiniteType k₀ R₁ := hc₁_FT
      letI : Field (R₁ ⧸ M_star) := @Ideal.Quotient.field R₁ _ M_star hM_max
      have hFT_quot : Algebra.FiniteType k₀ (R₁ ⧸ M_star) := Algebra.FiniteType.of_surjective
        (Ideal.Quotient.mkₐ k₀ M_star) Ideal.Quotient.mk_surjective
      rcases hFT_quot with ⟨s_gen, hs_gen⟩
      let f_mv : MvPolynomial ↥s_gen k₀ →ₐ[k₀] (R₁ ⧸ M_star) := MvPolynomial.aeval Subtype.val
      have hf_surj : Function.Surjective f_mv.toRingHom := by
        intro y
        have hy : y ∈ f_mv.range := by
          rw [MvPolynomial.aeval_range, Subtype.range_coe, hs_gen]
          trivial
        rcases hy with ⟨P, rfl⟩
        exact ⟨P, rfl⟩
      have hInt : (algebraMap k₀ (R₁ ⧸ M_star)).IsIntegral := by
        have := MvPolynomial.comp_C_integral_of_surjective_of_isJacobsonRing f_mv.toRingHom hf_surj
        convert this using 1
        ext x
        simp
      have hBij : Function.Bijective (algebraMap k₀ (R₁ ⧸ M_star)) :=
        IsAlgClosed.ringHom_bijective_of_isIntegral (algebraMap k₀ (R₁ ⧸ M_star)) hInt
      intro r
      obtain ⟨c, hc⟩ := hBij.2 (Ideal.Quotient.mk M_star r)
      refine ⟨c, ?_⟩
      rw [← Ideal.Quotient.eq]
      exact hc.symm
    let R_loc := Localization.AtPrime n₀.asIdeal
    have hNoethD : IsNoetherianRing D := by
      letI : Algebra R₁ D := ψ₁.toAlgebra
      have : Algebra.Etale R₁ D := RingHom.etale_algebraMap.mp hEt₁
      have : Algebra.FiniteType R₁ D := inferInstance
      exact Algebra.FiniteType.isNoetherianRing R₁ D
    have : IsNoetherianRing R_loc :=
      IsLocalization.isNoetherianRing n₀.asIdeal.primeCompl R_loc hNoethD
    let φ₁ : R₁ →+* R_loc := (algebraMap D R_loc).comp ψ₁
    have hEtRad : ∀ J : Ideal R₁, J.IsRadical → (Ideal.map φ₁ J).IsRadical := by
      intro J hJrad
      letI : Algebra R₁ D := ψ₁.toAlgebra
      have : Algebra.Etale R₁ D := RingHom.etale_algebraMap.mp hEt₁
      have hMapD_rad : (Ideal.map ψ₁ J).IsRadical := by
        rw [Ideal.isRadical_iff_quotient_reduced] at hJrad ⊢
        let A := R₁ ⧸ J
        have : _root_.IsReduced A := hJrad
        have : IsNoetherianRing A := Ideal.Quotient.isNoetherianRing J
        let D_A := TensorProduct R₁ A D
        have : Algebra.Etale A D_A := Algebra.Etale.baseChange R₁ D A
        have : Module.Flat A D_A := inferInstance
        let e_quot : (D ⧸ Ideal.map (algebraMap R₁ D) J) ≃+* D_A :=
          (Algebra.TensorProduct.quotIdealMapEquivTensorQuot D J).toRingEquiv.trans
            (Algebra.TensorProduct.comm R₁ D A).toRingEquiv
        have hFinMin : (minimalPrimes A).Finite := minimalPrimes.finite_of_isNoetherianRing A
        let ι_min := ↥(minimalPrimes A)
        letI : Fintype ι_min := hFinMin.fintype
        have : ∀ q : ι_min, q.1.IsPrime := fun q => q.2.1.1
        let K_fam : ι_min → Type u := fun q => (q.1).ResidueField
        let toProd : A →ₗ[A] (∀ q : ι_min, K_fam q) :=
          LinearMap.pi fun q => Algebra.linearMap A (K_fam q)
        have hInj_toProd : Function.Injective toProd := by
          rw [injective_iff_map_eq_zero]
          intro a ha
          have h_nil : a ∈ nilradical A := by
            rw [nilradical_eq_sInf, Ideal.mem_sInf]
            intro P hP
            have : P.IsPrime := hP
            obtain ⟨q, hq_min, hq_le⟩ := Ideal.exists_minimalPrimes_le (J := P) bot_le
            let q_idx : ι_min := ⟨q, hq_min⟩
            have hq0 : algebraMap A q_idx.1.ResidueField a = 0 := congrFun ha q_idx
            have ha_q : a ∈ q_idx.1 := Ideal.algebraMap_residueField_eq_zero.mp hq0
            exact hq_le ha_q
          rcases mem_nilradical.mp h_nil with ⟨n_nil, hn_nil⟩
          exact IsNilpotent.eq_zero ⟨n_nil, hn_nil⟩
        have hInj_tens : Function.Injective (LinearMap.lTensor D_A toProd) :=
          Module.Flat.lTensor_preserves_injective_linearMap toProd hInj_toProd
        let e_pi : TensorProduct A D_A (∀ q : ι_min, K_fam q) ≃ₐ[A]
            (∀ q : ι_min, TensorProduct A D_A (K_fam q)) :=
          Algebra.TensorProduct.piRight A A D_A K_fam
        let ringHom_to_prod : D_A →+* (∀ q : ι_min, TensorProduct A D_A (K_fam q)) :=
          e_pi.toRingHom.comp Algebra.TensorProduct.includeLeftRingHom
        have hInj_ring : Function.Injective ringHom_to_prod := by
          intro u v huv
          have h_eq_ltens : ∀ w : D_A,
              ringHom_to_prod w = e_pi (LinearMap.lTensor D_A toProd (TensorProduct.tmul A w (1 : A))) := by
            intro w
            ext q
            simp [ringHom_to_prod, e_pi, toProd, Algebra.linearMap_apply, map_one]
          rw [h_eq_ltens u, h_eq_ltens v] at huv
          have h2 := hInj_tens (e_pi.injective huv)
          let rid_A : TensorProduct A D_A A ≃ₗ[A] D_A := TensorProduct.rid A D_A
          simpa [rid_A] using congrArg rid_A h2
        have : ∀ q : ι_min, _root_.IsReduced (TensorProduct A D_A (K_fam q)) := by
          intro q
          let e_symm := (Algebra.TensorProduct.comm A D_A (K_fam q)).toRingEquiv
          have : Algebra.Etale (K_fam q) (TensorProduct A (K_fam q) D_A) :=
            Algebra.Etale.baseChange A D_A (K_fam q)
          have hRed_q := Algebra.FormallyUnramified.isReduced_of_field (K_fam q) (TensorProduct A (K_fam q) D_A)
          refine ⟨fun z ⟨m_nil, hzm⟩ => e_symm.injective ?_⟩
          rw [map_zero]
          exact hRed_q.eq_zero (e_symm z) ⟨m_nil, by rw [← map_pow, hzm, map_zero]⟩
        have : _root_.IsReduced D_A := isReduced_of_injective ringHom_to_prod hInj_ring
        exact isReduced_of_injective e_quot e_quot.injective
      have h_map_comp : Ideal.map φ₁ J = Ideal.map (algebraMap D R_loc) (Ideal.map ψ₁ J) :=
        (Ideal.map_map ψ₁ (algebraMap D R_loc)).symm
      rw [h_map_comp]
      intro z hz
      have hz_rad : z ∈ (Ideal.map (algebraMap D R_loc) (Ideal.map ψ₁ J)).radical := hz
      rw [← IsLocalization.map_radical n₀.asIdeal.primeCompl R_loc (Ideal.map ψ₁ J),
        hMapD_rad.radical] at hz_rad
      exact hz_rad
    let P2 := MvPolynomial (Fin 2) k₀
    let I_X01 : Ideal P2 := Ideal.span {(MvPolynomial.X 0 : P2) * MvPolynomial.X 1}
    let R_nod := P2 ⧸ I_X01
    let Xbar : Fin 2 → R_nod := fun i => Ideal.Quotient.mk I_X01 (MvPolynomial.X i)
    let x : Fin 2 → R_loc := fun i => algebraMap D R_loc (ψ₂ (Xbar i))
    have hx_mem : ∀ i : Fin 2, x i ∈ IsLocalRing.maximalIdeal R_loc := by
      intro i
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_loc n₀.asIdeal _).mpr (hX i)
    have hx_mul : x 0 * x 1 = 0 := by
      dsimp [x, Xbar]
      rw [← map_mul, ← map_mul, ← map_mul]
      have h0 : Ideal.Quotient.mk I_X01 ((MvPolynomial.X 0 : P2) * MvPolynomial.X 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [h0, map_zero, map_zero]
    have hMax_Rloc : IsLocalRing.maximalIdeal R_loc = Ideal.span {x 0, x 1} := by
      letI : Algebra R_nod D := ψ₂.toAlgebra
      have : Algebra.Etale R_nod D := RingHom.etale_algebraMap.mp hEt₂
      apply le_antisymm
      · intro z hz
        obtain ⟨⟨d, s⟩, hds⟩ := IsLocalization.surj n₀.asIdeal.primeCompl z
        dsimp only at hds
        have hd_mem : d ∈ n₀.asIdeal := by
          by_contra hd_not
          have hu_d : IsUnit (algebraMap D R_loc d) :=
            IsLocalization.map_units R_loc (⟨d, hd_not⟩ : n₀.asIdeal.primeCompl)
          have hu_zs : IsUnit (z * algebraMap D R_loc s.1) := hds.symm ▸ hu_d
          obtain ⟨w, hw⟩ := hu_zs.exists_right_inv
          have hu_z : IsUnit z := IsUnit.of_mul_eq_one (algebraMap D R_loc s.1 * w) (by
            rw [← mul_assoc]; exact hw)
          exact IsLocalRing.notMem_maximalIdeal.mpr hu_z hz
        let ev0_P2 : P2 →ₐ[k₀] k₀ := MvPolynomial.aeval (fun _ : Fin 2 => (0 : k₀))
        have hker_I : I_X01 ≤ RingHom.ker ev0_P2.toRingHom := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          change ev0_P2 (MvPolynomial.X 0 * MvPolynomial.X 1) = 0
          rw [map_mul, MvPolynomial.aeval_X, zero_mul]
        let ev0_nod : R_nod →+* k₀ := Ideal.Quotient.lift I_X01 ev0_P2.toRingHom hker_I
        have hSurj_ev0 : Function.Surjective ev0_nod := by
          intro c
          refine ⟨Ideal.Quotient.mk I_X01 (MvPolynomial.C c), ?_⟩
          change ev0_P2 (MvPolynomial.C c) = c
