  have hα₀_inj : Function.Injective α₀ :=
    (IsFractionRing.injective (Polynomial K) F_K).comp Φ₀.symm.injective
  let j_FF : ↑X.functionField →+* F_K := IsFractionRing.lift hα₀_inj
