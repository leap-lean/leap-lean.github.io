          rw [hMap_q q₁, hMap_q q₀]
          exact hy_eq.trans hy₀_eq.symm
        have hcomap_eq : PrimeSpectrum.comap e_AB q₁ = PrimeSpectrum.comap e_AB q₀ :=
          hUY.fromSpec.isOpenEmbedding.injective h_inj_eq
        exact hq₁_ne (hEtDisc A B e_AB q₁ q₀ he_AB hq₁_le hcomap_eq)
      exact ⟨hRedStalkY, y₁, hy₁_ne, hy_cl⟩
    
    have hRedY : AlgebraicGeometry.IsReduced Y := by
      refine @AlgebraicGeometry.isReduced_of_isReduced_stalk Y fun y => ?_
      rcases hSmNod y with ⟨V_sm, hy_V, hSm_V⟩ | hNod_y
      · exact (hSmChart y V_sm hy_V hSm_V).1
      · exact (hNodChart y hNod_y).1
    
    have hSmUniq : ∀ (y : ↥Y) (V_sm : Y.Opens),
        y ∈ V_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) →
        ∀ E₁ ∈ irreducibleComponents ↥Y, ∀ E₂ ∈ irreducibleComponents ↥Y,
          y ∈ E₁ → y ∈ E₂ → E₁ = E₂ := by
      intro y V_sm hy hSm E₁ hE₁ E₂ hE₂ hy₁ hy₂
      obtain ⟨_, O_y, hOpenO, hIrredO, hyO⟩ := hSmChart y V_sm hy hSm
      have hEqCl : ∀ E ∈ irreducibleComponents ↥Y, y ∈ E → E = closure O_y := by
        intro E hE hyE
        have hE_sub : E ⊆ closure O_y := by
          intro x hxE
          rw [mem_closure_iff]
          intro U hU hxU
          obtain ⟨z, _, hzU, hzO⟩ :=
            hE.1.2 U O_y hU hOpenO ⟨x, hxE, hxU⟩ ⟨y, hyE, hyO⟩
          exact ⟨z, hzU, hzO⟩
        exact le_antisymm hE_sub (hE.2 hIrredO.closure hE_sub)
      exact (hEqCl E₁ hE₁ hy₁).trans (hEqCl E₂ hE₂ hy₂).symm
    
    have hGenSm : ∀ E_Y ∈ irreducibleComponents ↥Y,
        ∃ η_Y ∈ E_Y,
          closure ({η_Y} : Set ↥Y) = E_Y ∧
          ∃ V₀ : Y.Opens,
            η_Y ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₀.ι ≫ p_Y) := by
      intro E_Y hEY
      let η_Y : ↥Y := hEY.1.genericPoint
      have hcl : closure ({η_Y} : Set ↥Y) = E_Y :=
        hEY.1.closure_genericPoint (isClosed_of_mem_irreducibleComponents E_Y hEY)
      have hη_mem : η_Y ∈ E_Y := hcl ▸ subset_closure rfl
      refine ⟨η_Y, hη_mem, hcl, ?_⟩
      rcases hSmNod η_Y with ⟨V₀, hη_V₀, hSm_V₀⟩ | hNod_η
      · exact ⟨V₀, hη_V₀, hSm_V₀⟩
      · exfalso
        obtain ⟨_, y₁, hy₁_ne, hη_cl_y₁⟩ := hNodChart η_Y hNod_η
        have hsub1 : E_Y ⊆ closure ({y₁} : Set ↥Y) := by
          rw [← hcl]
          exact closure_minimal (Set.singleton_subset_iff.mpr hη_cl_y₁) isClosed_closure
        have hsub2 : closure ({y₁} : Set ↥Y) ⊆ E_Y :=
          hEY.2 isIrreducible_singleton.closure hsub1
        have hcl_eq : closure ({y₁} : Set ↥Y) = closure ({η_Y} : Set ↥Y) := by
          rw [hcl]
          exact le_antisymm hsub2 hsub1
        exact hy₁_ne (inseparable_iff_closure_eq.mpr hcl_eq).eq
    exact ⟨hFinY, hRedY, hSmUniq, hGenSm⟩
  
  refine ⟨hPart1, ?_⟩
  intro C S g hPropG n h3n τ hSec hDisj s _hConn hSmNodFib hNotStab
  let X_s := CategoryTheory.Limits.pullback g s
  let fst_s := CategoryTheory.Limits.pullback.fst g s
  let snd_s := CategoryTheory.Limits.pullback.snd g s
  letI : AlgebraicGeometry.IsProper g := hPropG
  have hPropSnd : AlgebraicGeometry.IsProper snd_s := inferInstance
  have hFinComp : (irreducibleComponents ↥X_s).Finite :=
    (hPart1 X_s snd_s hPropSnd hSmNodFib).1
  rw [HasStablePointedGeomFiber] at hNotStab
  rcases Classical.not_forall.mp hNotStab with ⟨E, hNotStab⟩
  rcases Classical.not_forall.mp hNotStab with ⟨E_sch, hNotStab⟩
  rcases Classical.not_forall.mp hNotStab with ⟨ι_E, hNotStab⟩
  rcases not_imp.mp hNotStab with ⟨hE_comp, hNotStab⟩
  rcases not_imp.mp hNotStab with ⟨hCl_ιE, hNotStab⟩
  rcases not_imp.mp hNotStab with ⟨hInt_E, hNotStab⟩
  rcases not_imp.mp hNotStab with ⟨hRange_ιE, hNotStab⟩
  rcases not_imp.mp hNotStab with ⟨⟨isoP1, hisoP1⟩, hNo3⟩
  let Y'_set : Set ↥X_s :=
    {q : ↥X_s | ∃ E' ∈ irreducibleComponents ↥X_s, E' ≠ E ∧ q ∈ E'}
  let S_other : Set (Set ↥X_s) := irreducibleComponents ↥X_s \ {E}
  have hFinOther : S_other.Finite := hFinComp.sdiff
  have hY'_bUnion : Y'_set = ⋃ E' ∈ S_other, E' := by
    ext q
    simp [Y'_set, S_other, and_assoc]
  have hClosedY' : IsClosed Y'_set := by
    rw [hY'_bUnion]
    exact hFinOther.isClosed_biUnion fun E' hE' => isClosed_of_mem_irreducibleComponents E' hE'.1
  have hClosedE : IsClosed E := isClosed_of_mem_irreducibleComponents E hE_comp
  have hUnion : E ∪ Y'_set = Set.univ := by
    ext q
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    by_cases hqEq : irreducibleComponent q = E
    · exact Or.inl (hqEq ▸ mem_irreducibleComponent)
    · exact Or.inr ⟨irreducibleComponent q, irreducibleComponent_mem_irreducibleComponents q,
        hqEq, mem_irreducibleComponent⟩
  have hY'_nonempty : Y'_set.Nonempty := by
    by_contra hNotNe
    have hY'_empty : Y'_set = ∅ := Set.not_nonempty_iff_eq_empty.mp hNotNe
    have hE_univ : E = Set.univ := by
      simpa [hY'_empty] using hUnion
    have hBotPrime : (⊥ : Ideal Ω).IsPrime :=
      ⟨ne_of_lt bot_lt_top, fun {a b} hab => by
        rw [Ideal.mem_bot] at hab ⊢
        exact mul_eq_zero.mp hab⟩
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := ⟨⊥, hBotPrime⟩
    let τ_lift : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X_s) :=
      fun j => CategoryTheory.Limits.pullback.lift (s ≫ τ j)
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        (by rw [CategoryTheory.Category.assoc, hSec j,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    let p_pt : Fin n → ↥X_s := fun j => (τ_lift j).base pt_Ω
    have hp_range : ∀ j : Fin n, fst_s.base (p_pt j) ∈ Set.range (τ j).base := by
      intro j
      refine ⟨s.base pt_Ω, ?_⟩
      have hev := congrArg (fun f => f.base pt_Ω)
        (CategoryTheory.Limits.pullback.lift_fst (f := g) (g := s) (s ≫ τ j)
          (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
          (by rw [CategoryTheory.Category.assoc, hSec j,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]))
      simpa [p_pt, τ_lift, fst_s] using hev.symm
    have hp_inj : Function.Injective p_pt := by
      intro i j hp_eq
      by_contra hij
      have h1 : fst_s.base (p_pt i) ∈ Set.range (τ i).base := hp_range i
      have h2 : fst_s.base (p_pt i) ∈ Set.range (τ j).base := hp_eq ▸ hp_range j
      exact Set.disjoint_left.mp (hDisj hij) h1 h2
    let j₀ : Fin n := ⟨0, by omega⟩
    let j₁ : Fin n := ⟨1, by omega⟩
    let j₂ : Fin n := ⟨2, by omega⟩
    apply hNo3
    refine ⟨p_pt j₀, p_pt j₁, p_pt j₂,
      fun h => by have := congrArg Fin.val (hp_inj h); dsimp [j₀, j₁] at this; omega,
      fun h => by have := congrArg Fin.val (hp_inj h); dsimp [j₀, j₂] at this; omega,
      fun h => by have := congrArg Fin.val (hp_inj h); dsimp [j₁, j₂] at this; omega,
      by rw [hE_univ]; trivial,
      by rw [hE_univ]; trivial,
      by rw [hE_univ]; trivial,
      ?_⟩
    intro q hq
    rcases hq with rfl | rfl | rfl
    · exact Or.inr ⟨j₀, hp_range j₀⟩
    · exact Or.inr ⟨j₁, hp_range j₁⟩
    · exact Or.inr ⟨j₂, hp_range j₂⟩
  have hNotSubE : ∀ O : Set ↥X_s, IsOpen O → (O ∩ Y'_set).Nonempty → ¬ (O ⊆ E) := by
    rintro O hO ⟨q₀, hq₀O, E', hE'_comp, hE'_ne, hq₀E'⟩ hO_sub
    have hNotSub : ¬ (E' ⊆ E) :=
      fun hSub => hE'_ne (le_antisymm hSub (hE'_comp.2 hE_comp.1 hSub))
    obtain ⟨q₁, hq₁E', hq₁NotE⟩ := Set.not_subset.mp hNotSub
    obtain ⟨q, _, hqO, hqNotE⟩ :=
      hE'_comp.1.2 O Eᶜ hO hClosedE.isOpen_compl ⟨q₀, hq₀E', hq₀O⟩ ⟨q₁, hq₁E', hq₁NotE⟩
    exact hqNotE (hO_sub hqO)
  have hNotSubY' : ∀ O : Set ↥X_s, IsOpen O → (O ∩ E).Nonempty → ¬ (O ⊆ Y'_set) := by
    rintro O hO ⟨q₀, hq₀O, hq₀E⟩ hO_sub
    let F_other : Finset (Set ↥X_s) := hFinOther.toFinset
    have hInter : ∀ G : Finset (Set ↥X_s),
        G ⊆ F_other → IsOpen (⋂ E' ∈ G, E'ᶜ) ∧ (E ∩ ⋂ E' ∈ G, E'ᶜ).Nonempty := by
      intro G
      induction G using Finset.induction_on with
      | empty =>
        intro _
        simp only [Finset.notMem_empty, Set.iInter_of_empty, Set.iInter_univ, Set.inter_univ]
        exact ⟨isOpen_univ, hE_comp.1.1⟩
      | @insert E'₀ G hNotMem ih =>
        intro hG_sub
        have hE'₀_other : E'₀ ∈ S_other :=
          hFinOther.mem_toFinset.mp (hG_sub (Finset.mem_insert_self E'₀ G))
        obtain ⟨hOpenG, hMeetG⟩ := ih (Finset.Subset.trans (Finset.subset_insert E'₀ G) hG_sub)
        have hClosedE'₀ : IsClosed E'₀ := isClosed_of_mem_irreducibleComponents E'₀ hE'₀_other.1
        have hNotSub₀ : ¬ (E ⊆ E'₀) :=
          fun hSub => hE'₀_other.2 (le_antisymm (hE_comp.2 hE'₀_other.1.1 hSub) hSub)
        obtain ⟨x₀, hx₀E, hx₀Not⟩ := Set.not_subset.mp hNotSub₀
        rw [Finset.set_biInter_insert]
        refine ⟨hClosedE'₀.isOpen_compl.inter hOpenG, ?_⟩
        obtain ⟨z, hzE, hz₀, hzG⟩ :=
          hE_comp.1.2 E'₀ᶜ (⋂ E' ∈ G, E'ᶜ) hClosedE'₀.isOpen_compl hOpenG
            ⟨x₀, hx₀E, hx₀Not⟩ hMeetG
        exact ⟨z, hzE, hz₀, hzG⟩
    obtain ⟨_, q₁, hq₁E, hq₁Inter⟩ := hInter F_other Finset.Subset.rfl
    have hq₁NotY' : q₁ ∉ Y'_set := by
      rw [hY'_bUnion, Set.mem_iUnion₂]
      rintro ⟨E', hE'_other, hq₁E'⟩
      have hE'_F : E' ∈ F_other := hFinOther.mem_toFinset.mpr hE'_other
      exact (Set.mem_iInter₂.mp hq₁Inter E' hE'_F) hq₁E'
    obtain ⟨q, _, hqO, hqNotY'⟩ :=
      hE_comp.1.2 O Y'_setᶜ hO hClosedY'.isOpen_compl ⟨q₀, hq₀E, hq₀O⟩ ⟨q₁, hq₁E, hq₁NotY'⟩
    exact hqNotY' (hO_sub hqO)
  exact ⟨E, Y'_set, E_sch, ι_E, isoP1,
    hE_comp, hCl_ιE, hInt_E, hRange_ιE, hisoP1,
    fun _ => Iff.rfl, hClosedY', hY'_nonempty, hUnion,
    hNotSubE, hNotSubY', hNo3⟩

theorem weil_unstable_component_schematic_closure_and_away_iso (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R]
    (K_R : Type u) [Field K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (s_R : R) (hsR : s_R ≠ 0) [IsLocalization.Away s_R K_R]
    (M : ℕ)
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlatR : AlgebraicGeometry.Flat g_R)
    (hLFPR : AlgebraicGeometry.LocallyOfFinitePresentation g_R)
    (ι_PR : C_R ⟶ (weilProjectiveSpaceOver R M).left)
    (hClPR : AlgebraicGeometry.IsClosedImmersion ι_PR)
    (hCommPR : ι_PR ≫ (weilProjectiveSpaceOver R M).hom = g_R)
    (hRedXK : AlgebraicGeometry.IsReduced
      (CategoryTheory.Limits.pullback g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))))
    (E : Set ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))))
    (E_sch : AlgebraicGeometry.Scheme.{u})
    (ι_E : E_sch ⟶ CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))))
    (hCl_ιE : AlgebraicGeometry.IsClosedImmersion ι_E)
    (hInt_E : AlgebraicGeometry.IsIntegral E_sch)
    (hRange_ιE : Set.range ι_E.base = E)
    (Y'_K : Set ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R)))))
    (hClosed_Y'K : IsClosed Y'_K)
    (hUnion_XK : E ∪ Y'_K = Set.univ) :
    let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
    let Y₀ := CategoryTheory.Limits.pullback g_R s₀
    let fst_K := CategoryTheory.Limits.pullback.fst g_R η_R
    let fst₀ := CategoryTheory.Limits.pullback.fst g_R s₀
    let W₀_set : Set ↥Y₀ := fst₀.base ⁻¹' closure (fst_K.base '' Y'_K)
    ∃ (E_bar : AlgebraicGeometry.Scheme.{u})
      (ι_Ebar_C : E_bar ⟶ C_R)
      (ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left)
      (j_to : E_sch ⟶ E_bar)
      (ι_Z0_Y0 : CategoryTheory.Limits.pullback
        (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀ ⟶ Y₀),
      let Z₀ := CategoryTheory.Limits.pullback (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀
      (AlgebraicGeometry.IsOpenImmersion fst_K ∧
        Dense (Set.range fst_K.base) ∧
        AlgebraicGeometry.IsClosedImmersion fst₀ ∧
        Function.Injective fst₀.base ∧
        IsClosed W₀_set) ∧
      (ι_bar = ι_Ebar_C ≫ ι_PR ∧
        AlgebraicGeometry.IsClosedImmersion ι_Ebar_C ∧
        AlgebraicGeometry.IsClosedImmersion ι_bar ∧
        AlgebraicGeometry.IsIntegral E_bar ∧
        AlgebraicGeometry.Flat (ι_Ebar_C ≫ g_R) ∧
        Set.range ι_Ebar_C.base = closure (fst_K.base '' E) ∧
        CategoryTheory.IsPullback ι_E j_to fst_K ι_Ebar_C ∧
        ∃ α_gen : E_sch ≅
            CategoryTheory.Limits.pullback (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) η_R,
          α_gen.hom ≫ CategoryTheory.Limits.pullback.snd
              (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) η_R =
            ι_E ≫ CategoryTheory.Limits.pullback.snd g_R η_R) ∧
      (AlgebraicGeometry.IsClosedImmersion ι_Z0_Y0 ∧
        Function.Injective ι_Z0_Y0.base ∧
        ι_Z0_Y0 ≫ CategoryTheory.Limits.pullback.snd g_R s₀ =
          CategoryTheory.Limits.pullback.snd (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀ ∧
        ι_Z0_Y0 ≫ fst₀ =
          CategoryTheory.Limits.pullback.fst (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀ ≫
            ι_Ebar_C ∧
        CategoryTheory.IsPullback ι_Z0_Y0
          (CategoryTheory.Limits.pullback.fst (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀)
          fst₀ ι_Ebar_C ∧
        Set.range ι_Z0_Y0.base = fst₀.base ⁻¹' (Set.range ι_Ebar_C.base) ∧
        Set.range ι_Z0_Y0.base ∪ W₀_set = Set.univ) ∧
      (∀ z : ↥Z₀,
        ι_Z0_Y0.base z ∉ W₀_set →
        (_root_.IsReduced ↑(Y₀.presheaf.stalk (ι_Z0_Y0.base z)) →
          _root_.IsReduced ↑(Z₀.presheaf.stalk z)) ∧
        (HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g_R s₀)
            (ι_Z0_Y0.base z) →
          HasSpreadSmoothOrNodalAt
            (CategoryTheory.Limits.pullback.snd
              (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀) z) ∧
        ((∃ V_sm : C_R.Opens,
            fst₀.base (ι_Z0_Y0.base z) ∈ V_sm ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_R)) →
          ∃ V_Z : Z₀.Opens,
            z ∈ V_Z ∧
            AlgebraicGeometry.SmoothOfRelativeDimension 1
              (V_Z.ι ≫ CategoryTheory.Limits.pullback.snd
                (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) s₀))) :=
by
  intro η_R s₀ Y₀ fst_K fst₀ W₀_set
  let X_K := CategoryTheory.Limits.pullback g_R η_R
  let snd_K := CategoryTheory.Limits.pullback.snd g_R η_R
  let snd₀ := CategoryTheory.Limits.pullback.snd g_R s₀
  haveI : AlgebraicGeometry.Flat g_R := hFlatR
  haveI : AlgebraicGeometry.LocallyOfFinitePresentation g_R := hLFPR
  haveI : AlgebraicGeometry.IsClosedImmersion ι_PR := hClPR
  haveI : AlgebraicGeometry.IsReduced X_K := hRedXK
  haveI : AlgebraicGeometry.IsClosedImmersion ι_E := hCl_ιE
  haveI : AlgebraicGeometry.IsIntegral E_sch := hInt_E

  
  
  
  have hOpen_ηR : AlgebraicGeometry.IsOpenImmersion η_R :=
    @AlgebraicGeometry.IsOpenImmersion.of_isLocalization R K_R _ _ _ s_R _
  haveI : AlgebraicGeometry.IsOpenImmersion η_R := hOpen_ηR
  have hOpen_fstK : AlgebraicGeometry.IsOpenImmersion fst_K := inferInstance
  haveI : AlgebraicGeometry.IsOpenImmersion fst_K := hOpen_fstK

  have hUnivOpen_gR : AlgebraicGeometry.UniversallyOpen g_R :=
    AlgebraicGeometry.UniversallyOpen.of_flat g_R
  haveI : AlgebraicGeometry.UniversallyOpen g_R := hUnivOpen_gR
  have hDense_fstK : Dense (Set.range fst_K.base) := by
    rw [dense_iff_inter_open]
    intro O hO ⟨x₀, hx₀⟩
    have hOpen_img : IsOpen (g_R.base '' O) := g_R.isOpenMap O hO
    have hx₀_img : g_R.base x₀ ∈ g_R.base '' O := ⟨x₀, hx₀, rfl⟩
    let η_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) := ⟨(⊥ : Ideal R), inferInstance⟩
    have h_bot_le : η_pt.asIdeal ≤ (g_R.base x₀).asIdeal := bot_le
    have hx₀_cl : g_R.base x₀ ∈ closure ({η_pt} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R))) :=
      (PrimeSpectrum.le_iff_mem_closure η_pt (g_R.base x₀)).mp h_bot_le
    rcases mem_closure_iff.mp hx₀_cl (g_R.base '' O) hOpen_img hx₀_img with
      ⟨_, ⟨x₁, hx₁O, hgx₁⟩, h_eq_η⟩
    rw [Set.mem_singleton_iff] at h_eq_η
    let η_K : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_R)) := ⟨(⊥ : Ideal K_R), inferInstance⟩
    have hη_eq : η_R.base η_K = η_pt := by
      apply PrimeSpectrum.ext
      ext r
      change algebraMap R K_R r ∈ (⊥ : Ideal K_R) ↔ r ∈ (⊥ : Ideal R)
      rw [Ideal.mem_bot, Ideal.mem_bot]
      exact ⟨fun h => IsFractionRing.injective R K_R (h.trans (map_zero _).symm),
        fun h => by rw [h, map_zero]⟩
    have hgx₁_ηK : g_R x₁ = η_R η_K := by
      rw [hgx₁, h_eq_η, hη_eq]
    obtain ⟨q, hq_fst, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x₁ η_K hgx₁_ηK
    exact ⟨x₁, hx₁O, q, hq_fst⟩

  have hCl_s0 : AlgebraicGeometry.IsClosedImmersion s₀ :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom (IsLocalRing.residue R)) IsLocalRing.residue_surjective
  haveI : AlgebraicGeometry.IsClosedImmersion s₀ := hCl_s0
  have hCl_fst0 : AlgebraicGeometry.IsClosedImmersion fst₀ := inferInstance
  haveI : AlgebraicGeometry.IsClosedImmersion fst₀ := hCl_fst0
  have hInj_fst0 : Function.Injective fst₀.base := fst₀.isClosedEmbedding.injective
  have hClosed_W0 : IsClosed W₀_set := isClosed_closure.preimage fst₀.continuous

  
  
  
  let j_E : E_sch ⟶ C_R := ι_E ≫ fst_K
  have hAff_ηR : AlgebraicGeometry.IsAffineHom η_R := inferInstance
  haveI : AlgebraicGeometry.IsAffineHom η_R := hAff_ηR
  have hAff_fstK : AlgebraicGeometry.IsAffineHom fst_K :=
    CategoryTheory.MorphismProperty.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback g_R η_R).flip hAff_ηR
  haveI : AlgebraicGeometry.IsAffineHom fst_K := hAff_fstK
  haveI : AlgebraicGeometry.IsAffineHom ι_E := inferInstance
  haveI : AlgebraicGeometry.IsAffineHom j_E := inferInstance
  haveI : AlgebraicGeometry.QuasiCompact j_E := inferInstance

  let E_bar : AlgebraicGeometry.Scheme.{u} := j_E.image
  let ι_Ebar_C : E_bar ⟶ C_R := j_E.imageι
  let ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left := ι_Ebar_C ≫ ι_PR
  let j_to : E_sch ⟶ E_bar := j_E.toImage

  have hCl_EbarC : AlgebraicGeometry.IsClosedImmersion ι_Ebar_C := inferInstance
  haveI : AlgebraicGeometry.IsClosedImmersion ι_Ebar_C := hCl_EbarC
  have hCl_ιbar : AlgebraicGeometry.IsClosedImmersion ι_bar := inferInstance

  have hRange_EbarC : Set.range ι_Ebar_C.base = closure (fst_K.base '' E) := by
