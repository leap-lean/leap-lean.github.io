      j_FF ((X.germToFunctionField U).hom s)
    congr 1
    exact TopCat.Presheaf.germ_res_apply X.presheaf
      (CategoryTheory.homOfLE hle) (genericPoint ↥X) _ s
  have hJ3 : ∀ P : Polynomial K,
