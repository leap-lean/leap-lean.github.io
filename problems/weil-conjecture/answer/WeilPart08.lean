    rw [h1, IsFractionRing.lift_algebraMap]
    exact congrArg (algebraMap (Polynomial K) F_K) (Φ₀.symm_apply_apply P)
  have hNonemptyInter : ∀ (A B : X.Opens), Nonempty ↥A → Nonempty ↥B → Nonempty ↥(A ⊓ B) := by
    intro A B ⟨⟨a, ha⟩⟩ ⟨⟨b, hb⟩⟩
    obtain ⟨y, hyA, hyB⟩ := nonempty_preirreducible_inter A.isOpen B.isOpen ⟨a, ha⟩ ⟨b, hb⟩
    exact ⟨⟨y, ⟨hyA, hyB⟩⟩⟩
  have hResComp : ∀ {A B C : X.Opens} (hAB : A ≤ B) (hBC : B ≤ C) (hAC : A ≤ C)
