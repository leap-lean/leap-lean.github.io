    have : Algebra.Etale R B := by rwa [RingHom.Etale] at hEt_hom
    have hq₀_over : Ideal.comap (algebraMap R B) q₀.asIdeal = IsLocalRing.maximalIdeal R := by
      have h1 : ((AlgebraicGeometry.Spec.map φ_RB_cat).base q₀).asIdeal =
