    refine le_antisymm le_top ?_
    rw [← hCov]
    exact sup_le (le_iSup U_cov 0) (le_iSup U_cov 1)
  have hOpenCov : TopologicalSpace.IsOpenCover U_cov := hSup
  let 𝒰 := X.openCoverOfIsOpenCover U_cov hOpenCov
  have : ∀ k : 𝒰.I₀, AlgebraicGeometry.IsReduced (𝒰.X k) :=
    Fin.cases hRed0 (fun j => Fin.cases hRed1 (fun k => Fin.elim0 k) j)
  have : AlgebraicGeometry.IsReduced X := AlgebraicGeometry.IsReduced.of_openCover X 𝒰
  have : AlgebraicGeometry.IsIntegral X :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced X
  let F_K := FractionRing (Polynomial K)
  have : Nonempty ↥(V₀ : AlgebraicGeometry.Scheme.{u}) := hNe0
  have : IsFractionRing ↑(X.presheaf.obj (Opposite.op V₀)) ↑X.functionField :=
