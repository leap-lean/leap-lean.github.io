    weil_quadratic_etale_nodal_splitting_descent R S₄ φ_X' hEtX' σ_bar₄ hσ₄R hσ₄X
      δ hδ (ι₄ F) A₀₀ A₀₁ A₁₁ hQuad hA₀₀ hA₀₁ hA₁₁
