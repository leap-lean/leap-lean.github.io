              rw [hHZ_one, one_pow, mul_one]
            _ = (mk_K Q * mk_K (emb H) ^ (N + r + 1)) * mk_K Z ^ (N + r + 1) := by ring
            _ = 0 := by rw [hβ_eq, zero_mul]
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmkQ_zero
    let pres : Algebra.Presentation k₀ A_f ι σ := Algebra.Presentation.mk gen rel hKR_eq_ker
    let pre : Algebra.PreSubmersivePresentation k₀ A_f ι σ :=
      Algebra.PreSubmersivePresentation.mk pres Sum.inr Sum.inr_injective
    have hpderiv_emb_inr : ∀ p : P,
        MvPolynomial.pderiv (Sum.inr (Sum.inr ()) : ι) (emb p) = 0 := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C c =>
        change MvPolynomial.pderiv _ (MvPolynomial.rename emb_idx (MvPolynomial.C c)) = 0
        rw [MvPolynomial.rename_C]
        exact MvPolynomial.pderiv_C
      | add p₁ p₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂, add_zero]
      | mul_X p₁ w ih =>
        rw [map_mul, show emb (MvPolynomial.X w) = MvPolynomial.X (emb_idx w) from
          MvPolynomial.rename_X emb_idx w]
        rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, ih, mul_zero, add_zero,
          MvPolynomial.pderiv_X]
        have hne : (Sum.inr (Sum.inr ()) : ι) ≠ emb_idx w := by
          cases w <;> intro h <;> cases h
        rw [Pi.single_eq_of_ne (Ne.symm hne), mul_zero]
    let B_top : Matrix (Fin m) Unit (MvPolynomial ι k₀) :=
      Matrix.of fun i _ => MvPolynomial.pderiv (Sum.inr (Sum.inl i)) (emb H * Z - 1)
    let D_bot : Matrix Unit Unit (MvPolynomial ι k₀) :=
      Matrix.of fun _ _ => emb H
    have hjac_blocks : pre.jacobiMatrix =
        Matrix.fromBlocks (emb.toRingHom.mapMatrix J_G) B_top 0 D_bot := by
      apply Matrix.ext
      intro r c
      rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      cases r with
      | inl i =>
        cases c with
        | inl j =>
          change MvPolynomial.pderiv (emb_idx (Sum.inr i)) (emb (G j)) = emb (J_G i j)
          exact MvPolynomial.pderiv_rename hemb_inj (Sum.inr i) (G j)
        | inr u =>
          cases u
          rfl
      | inr u =>
        cases u
        cases c with
        | inl j =>
          change MvPolynomial.pderiv (Sum.inr (Sum.inr ())) (emb (G j)) = 0
          exact hpderiv_emb_inr (G j)
        | inr v =>
          cases v
          change MvPolynomial.pderiv (Sum.inr (Sum.inr ())) (emb H * Z - 1) = emb H
          have h1_eq : (1 : MvPolynomial ι k₀) = MvPolynomial.C 1 := (MvPolynomial.C_1).symm
          rw [h1_eq, map_sub, MvPolynomial.pderiv_C, sub_zero,
            Derivation.leibniz, smul_eq_mul, smul_eq_mul,
            hpderiv_emb_inr H, mul_zero, add_zero]
          dsimp [Z]
          rw [MvPolynomial.pderiv_X, Pi.single_eq_same, mul_one]
    have hdet_jac : pre.jacobiMatrix.det = emb Δ * emb H := by
      rw [hjac_blocks, Matrix.det_fromBlocks_zero₂₁, ← RingHom.map_det]
      have hJG : J_G.det = Δ := hJG_det
      rw [hJG]
      congr 1
      exact Matrix.det_unique D_bot
    have hjac_unit : IsUnit pre.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      change IsUnit (MvPolynomial.aeval (R := k₀) val_v pre.jacobiMatrix.det)
      rw [hdet_jac, map_mul, haeval_emb Δ, haeval_emb H]
      change IsUnit (algebraMap A A_f (Ψ Δ) * algebraMap A A_f f)
      have hf2_unit : IsUnit (algebraMap A A_f f ^ 2) :=
        IsUnit.pow 2 (IsLocalization.Away.algebraMap_isUnit f)
      refine isUnit_of_dvd_unit ⟨algebraMap A A_f (Ψ F₀), ?_⟩ hf2_unit
      calc
        algebraMap A A_f f ^ 2
            = algebraMap A A_f (Ψ F₀ * Ψ Δ) * algebraMap A A_f f := by
              rw [sq]; dsimp [f, H]; rw [Ψ.map_mul, map_mul]
        _ = (algebraMap A A_f (Ψ Δ) * algebraMap A A_f f) * algebraMap A A_f (Ψ F₀) := by
          rw [map_mul]; ring
    let subm : Algebra.SubmersivePresentation k₀ A_f ι σ :=
      Algebra.SubmersivePresentation.mk pre hjac_unit
    have hdim : subm.dimension = 1 := by
      change Nat.card ι - Nat.card σ = 1
      simp only [ι, σ, Nat.card_eq_fintype_card, Fintype.card_sum, Fintype.card_unit,
        Fintype.card_fin]
      omega
    exact Algebra.SubmersivePresentation.isStandardSmoothOfRelativeDimension subm hdim

theorem weil_smooth_or_nodal_geom_fiber_reduced_and_generic_smooth (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (hEtDom : ∀ (A₀ B₀ : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B₀] [Algebra A₀ B₀] [Algebra.Etale A₀ B₀]
        (q : PrimeSpectrum B₀),
      ∃ g : B₀, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (hNodSplit : ∀ (S₀ B : Type u) [CommRing S₀] [IsDomain S₀] [CommRing B]
        (φ : (MvPolynomial (Fin 2) S₀ ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B),
      φ.Etale →
      let x₀ := φ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
      let x₁ := φ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
      x₀ * x₁ = 0 ∧
      (Ideal.span {x₀} : Ideal B) ⊓ Ideal.span {x₁} = ⊥ ∧
      (∃ ψ₀ : Polynomial S₀ →+* (B ⧸ Ideal.span {x₁}), ψ₀.Etale) ∧
      (∃ ψ₁ : Polynomial S₀ →+* (B ⧸ Ideal.span {x₀}), ψ₁.Etale)) :
    (∀ (Y : AlgebraicGeometry.Scheme.{u})
        (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)),
      AlgebraicGeometry.IsProper p_Y →
      (∀ y : ↥Y, HasSpreadSmoothOrNodalAt p_Y y) →
      (irreducibleComponents ↥Y).Finite ∧
      AlgebraicGeometry.IsReduced Y ∧
      (∀ (y : ↥Y) (V_sm : Y.Opens),
        y ∈ V_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) →
        ∀ E₁ ∈ irreducibleComponents ↥Y, ∀ E₂ ∈ irreducibleComponents ↥Y,
          y ∈ E₁ → y ∈ E₂ → E₁ = E₂) ∧
      (∀ E_Y ∈ irreducibleComponents ↥Y,
        ∃ η_Y ∈ E_Y,
          closure ({η_Y} : Set ↥Y) = E_Y ∧
          ∃ V₀ : Y.Opens,
            η_Y ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₀.ι ≫ p_Y))) ∧
    (∀ (C S : AlgebraicGeometry.Scheme.{u}) (g : C ⟶ S),
      AlgebraicGeometry.IsProper g →
      ∀ (n : ℕ), 3 ≤ n →
      ∀ (τ : Fin n → (S ⟶ C)),
        (∀ j : Fin n, τ j ≫ g = 𝟙 S) →
        (_root_.Pairwise fun i j : Fin n =>
          Disjoint (Set.range (τ i).base) (Set.range (τ j).base)) →
        ∀ (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
          ConnectedSpace ↥(CategoryTheory.Limits.pullback g s) →
          (∀ y : ↥(CategoryTheory.Limits.pullback g s),
            HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g s) y) →
          ¬ HasStablePointedGeomFiber g n τ Ω s →
          ∃ (E Y'_set : Set ↥(CategoryTheory.Limits.pullback g s))
            (E_sch : AlgebraicGeometry.Scheme.{u})
            (ι_E : E_sch ⟶ CategoryTheory.Limits.pullback g s)
            (isoP1 : E_sch ≅ (weilProjectiveSpaceOver Ω 1).left),
            E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s) ∧
            AlgebraicGeometry.IsClosedImmersion ι_E ∧
            AlgebraicGeometry.IsIntegral E_sch ∧
            Set.range ι_E.base = E ∧
            ι_E ≫ CategoryTheory.Limits.pullback.snd g s =
              isoP1.hom ≫ (weilProjectiveSpaceOver Ω 1).hom ∧
            (∀ q : ↥(CategoryTheory.Limits.pullback g s),
              q ∈ Y'_set ↔
                ∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s),
                  E' ≠ E ∧ q ∈ E') ∧
            IsClosed Y'_set ∧
            Y'_set.Nonempty ∧
            E ∪ Y'_set = Set.univ ∧
            (∀ O : Set ↥(CategoryTheory.Limits.pullback g s),
              IsOpen O → (O ∩ Y'_set).Nonempty → ¬ (O ⊆ E)) ∧
            (∀ O : Set ↥(CategoryTheory.Limits.pullback g s),
              IsOpen O → (O ∩ E).Nonempty → ¬ (O ⊆ Y'_set)) ∧
            ¬ ∃ q₁ q₂ q₃ : ↥(CategoryTheory.Limits.pullback g s),
              q₁ ≠ q₂ ∧ q₁ ≠ q₃ ∧ q₂ ≠ q₃ ∧
              q₁ ∈ E ∧ q₂ ∈ E ∧ q₃ ∈ E ∧
              ∀ q ∈ ({q₁, q₂, q₃} : Set ↥(CategoryTheory.Limits.pullback g s)),
                (∃ E' ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s),
                  E' ≠ E ∧ q ∈ E') ∨
                (∃ j : Fin n,
                  (CategoryTheory.Limits.pullback.fst g s).base q ∈ Set.range (τ j).base)) :=
by
  classical
  
  have hRedEquiv : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂],
      _root_.IsReduced R₁ → (R₁ ≃+* R₂) → _root_.IsReduced R₂ := by
    intro R₁ R₂ _ _ hRed e
    letI : _root_.IsReduced R₁ := hRed
    refine ⟨fun y hy => ?_⟩
    rcases hy with ⟨m, hym⟩
    have hx0 : e.symm y = 0 :=
      IsNilpotent.eq_zero ⟨m, by rw [← map_pow, hym, map_zero]⟩
    calc
      y = e (e.symm y) := (e.apply_symm_apply y).symm
      _ = e 0 := by rw [hx0]
      _ = 0 := map_zero e
  have hCommRingCatIsoToEquiv : ∀ {R₁ R₂ : CommRingCat.{u}},
      (R₁ ≅ R₂) → (↑R₁ ≃+* ↑R₂) := by
    intro R₁ R₂ iso
    exact
      { toFun := iso.hom.hom
        invFun := iso.inv.hom
        left_inv := fun x => by
          have h := congrArg (fun f : R₁ ⟶ R₁ => f.hom x) iso.hom_inv_id
          simpa using h
        right_inv := fun y => by
          have h := congrArg (fun f : R₂ ⟶ R₂ => f.hom y) iso.inv_hom_id
          simpa using h
        map_mul' := map_mul iso.hom.hom
        map_add' := map_add iso.hom.hom }
  have hLocRed : ∀ (R : Type u) [CommRing R], _root_.IsReduced R →
      ∀ (M : Submonoid R) (L : Type u) [CommRing L] [Algebra R L] [IsLocalization M L],
        _root_.IsReduced L := by
    intro R _ hRedR M L _ _ _
    letI : _root_.IsReduced R := hRedR
    refine ⟨fun z hz => ?_⟩
    rcases hz with ⟨m, hzm⟩
    cases m with
    | zero =>
      rw [pow_zero] at hzm
      calc
        z = z * 1 := (mul_one z).symm
        _ = z * 0 := by rw [hzm]
        _ = 0 := mul_zero z
    | succ k =>
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj M z
      have hbm : algebraMap R L (b ^ (k + 1)) = 0 := by
        rw [map_pow, ← hbs, mul_pow, hzm, zero_mul]
      obtain ⟨t, ht⟩ := (IsLocalization.map_eq_zero_iff M L (b ^ (k + 1))).mp hbm
      have htb_nil : IsNilpotent ((t : R) * b) := by
        refine ⟨k + 1, ?_⟩
        calc
          ((t : R) * b) ^ (k + 1) = (t : R) ^ (k + 1) * b ^ (k + 1) := mul_pow _ _ _
          _ = (t : R) ^ k * ((t : R) * b ^ (k + 1)) := by ring
          _ = (t : R) ^ k * 0 := by rw [ht]
          _ = 0 := mul_zero _
      have htb0 : (t : R) * b = 0 := htb_nil.eq_zero
      have hb0 : algebraMap R L b = 0 :=
        (IsLocalization.map_eq_zero_iff M L b).mpr ⟨t, htb0⟩
      rw [hb0] at hbs
      obtain ⟨u, hu⟩ := IsLocalization.map_units L s
      calc
        z = z * (↑u * ↑u⁻¹) := by rw [Units.mul_inv, mul_one]
        _ = (z * algebraMap R L s) * ↑u⁻¹ := by rw [← mul_assoc, hu]
        _ = 0 * ↑u⁻¹ := by rw [hbs]
        _ = 0 := zero_mul _
  
  have hPolyEt : ∀ (B : Type u) [CommRing B] (ψ : Polynomial Ω →+* B),
      ψ.Etale →
      _root_.IsReduced B ∧
        ∀ q : PrimeSpectrum B, ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g) := by
    intro B _ ψ hψ
    letI : Algebra (Polynomial Ω) B := ψ.toAlgebra
    haveI : Algebra.Etale (Polynomial Ω) B := hψ
    have hLoc : ∀ q : PrimeSpectrum B, ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g) :=
      fun q => hEtDom (Polynomial Ω) B q
    refine ⟨⟨fun b hb => ?_⟩, hLoc⟩
    rcases hb with ⟨m, hbm⟩
    by_contra hb0
    let I : Ideal B :=
      { carrier := {x : B | x * b = 0}
        zero_mem' := zero_mul b
        add_mem' := fun {x y} hx hy => by
          change (x + y) * b = 0
          rw [add_mul, hx, hy, add_zero]
        smul_mem' := fun c {x} hx => by
          change (c • x) * b = 0
          rw [smul_eq_mul, mul_assoc, hx, mul_zero] }
    have hI_ne : I ≠ ⊤ := by
      intro htop
      have h1 : (1 : B) ∈ I := htop ▸ Submodule.mem_top
      have : (1 : B) * b = 0 := h1
      rw [one_mul] at this
      exact hb0 this
    obtain ⟨𝔪, h𝔪_max, hI_le⟩ := Ideal.exists_le_maximal I hI_ne
    haveI : 𝔪.IsPrime := h𝔪_max.isPrime
    obtain ⟨g, hg_not_mem, hDomAway⟩ := hLoc ⟨𝔪, h𝔪_max.isPrime⟩
    letI : IsDomain (Localization.Away g) := hDomAway
    have hgb_pow : (algebraMap B (Localization.Away g) b) ^ m = 0 := by
      rw [← map_pow, hbm, map_zero]
    have hpow0 : ∀ (k : ℕ) (x : Localization.Away g), x ^ k = 0 → x = 0 := by
      intro k x hxk
      induction k with
      | zero =>
        rw [pow_zero] at hxk
        exact False.elim (one_ne_zero hxk)
      | succ k ih =>
        rw [pow_succ] at hxk
        rcases mul_eq_zero.mp hxk with h1 | h2
        · exact ih h1
        · exact h2
    have hgb0 : algebraMap B (Localization.Away g) b = 0 := hpow0 m _ hgb_pow
    obtain ⟨s_pow, hs_pow⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers g) (Localization.Away g) b).mp hgb0
    rcases s_pow.2 with ⟨k, hsk⟩
    rw [← hsk] at hs_pow
    have hgk_I : g ^ k ∈ I := hs_pow
    exact hg_not_mem (h𝔪_max.isPrime.mem_of_pow_mem k (hI_le hgk_I))
  have hSmRing : ∀ (R₀ S : Type u) [CommRing R₀] [CommRing S]
      (e_Ω : Ω ≃+* R₀) (f : R₀ →+* S),
      RingHom.IsStandardSmoothOfRelativeDimension 1 f →
      _root_.IsReduced S ∧
        ∀ q : PrimeSpectrum S, ∃ g : S, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g) := by
    intro R₀ S _ _ e_Ω f hf
    obtain ⟨g_mv, _, hg_mv⟩ :=
      RingHom.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial hf
    let θ : Polynomial Ω ≃+* MvPolynomial (Fin 1) R₀ :=
      (MvPolynomial.uniqueAlgEquiv Ω (Fin 1)).symm.toRingEquiv.trans
        (MvPolynomial.mapEquiv (Fin 1) e_Ω)
    have hθ_et : θ.toRingHom.Etale := RingHom.Etale.of_bijective θ.bijective
    have hψ_et : (g_mv.comp θ.toRingHom).Etale :=
      RingHom.Etale.stableUnderComposition θ.toRingHom g_mv hθ_et hg_mv
    exact hPolyEt S (g_mv.comp θ.toRingHom) hψ_et
  let I_nod_Ω : Ideal (MvPolynomial (Fin 2) Ω) :=
    Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}
  have hNodStalk : ∀ (A B : Type u) [CommRing A] [CommRing B]
      (e_AB : A →+* B)
      (φ : (MvPolynomial (Fin 2) Ω ⧸ I_nod_Ω) →+* B)
      (q₀ : PrimeSpectrum B),
      e_AB.Etale → φ.Etale →
      _root_.IsReduced (Localization.AtPrime (PrimeSpectrum.comap e_AB q₀).asIdeal) := by
    intro A B _ _ e_AB φ q₀ he_AB hφ
    obtain ⟨_, hInf, ⟨ψ₀, hψ₀⟩, ⟨ψ₁, hψ₁⟩⟩ := hNodSplit Ω B φ hφ
    let x₀ : B := φ (Ideal.Quotient.mk _ (MvPolynomial.X 0))
    let x₁ : B := φ (Ideal.Quotient.mk _ (MvPolynomial.X 1))
    have hRedQ1 : _root_.IsReduced (B ⧸ Ideal.span {x₁}) := (hPolyEt _ ψ₀ hψ₀).1
    have hRedQ0 : _root_.IsReduced (B ⧸ Ideal.span {x₀}) := (hPolyEt _ ψ₁ hψ₁).1
    have hRedB : _root_.IsReduced B := by
      refine ⟨fun b hb => ?_⟩
      rcases hb with ⟨m, hbm⟩
      have hb0_q : Ideal.Quotient.mk (Ideal.span {x₀}) b = 0 := by
        letI := hRedQ0
        exact IsNilpotent.eq_zero ⟨m, by rw [← map_pow, hbm, map_zero]⟩
      have hb1_q : Ideal.Quotient.mk (Ideal.span {x₁}) b = 0 := by
        letI := hRedQ1
        exact IsNilpotent.eq_zero ⟨m, by rw [← map_pow, hbm, map_zero]⟩
      have hb_mem : b ∈ (Ideal.span {x₀} : Ideal B) ⊓ Ideal.span {x₁} :=
        ⟨Ideal.Quotient.eq_zero_iff_mem.mp hb0_q, Ideal.Quotient.eq_zero_iff_mem.mp hb1_q⟩
      rw [hInf, Ideal.mem_bot] at hb_mem
      exact hb_mem
    let p₀ : PrimeSpectrum A := PrimeSpectrum.comap e_AB q₀
    let A_p := Localization.AtPrime p₀.asIdeal
    let B_q := Localization.AtPrime q₀.asIdeal
    have hRedBq : _root_.IsReduced B_q := hLocRed B hRedB q₀.asIdeal.primeCompl B_q
    let f_loc : A_p →+* B_q := Localization.localRingHom p₀.asIdeal q₀.asIdeal e_AB rfl
    letI : Algebra A B := e_AB.toAlgebra
    haveI : Algebra.Etale A B := he_AB
    letI : Algebra A_p B_q := f_loc.toAlgebra
    haveI : IsScalarTower A A_p B_q := ⟨fun a x z => by
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc, ← Algebra.smul_def]
      have hmap := Localization.localRingHom_to_map p₀.asIdeal q₀.asIdeal e_AB rfl a
      change f_loc (algebraMap A A_p a) * (x • z) = a • (x • z)
      rw [hmap]
      change algebraMap B B_q (algebraMap A B a) * (x • z) = a • (x • z)
      rw [← IsScalarTower.algebraMap_apply A B B_q a, ← Algebra.smul_def]⟩
    haveI : Module.Flat A B := inferInstance
    haveI : Module.Flat B B_q := IsLocalization.flat B_q q₀.asIdeal.primeCompl
    haveI : Module.Flat A B_q := Module.Flat.trans A B B_q
    haveI : Module.Flat A_p B_q :=
      (Module.flat_iff_of_isLocalization A_p p₀.asIdeal.primeCompl B_q).mpr inferInstance
    haveI : IsLocalHom (algebraMap A_p B_q) :=
      Localization.isLocalHom_localRingHom p₀.asIdeal q₀.asIdeal e_AB rfl
    haveI : Module.FaithfullyFlat A_p B_q := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hf_ff : f_loc.FaithfullyFlat := by
      show Module.FaithfullyFlat A_p B_q
      infer_instance
    have hInj_loc : Function.Injective f_loc := RingHom.FaithfullyFlat.injective hf_ff
    refine ⟨fun w hw => ?_⟩
    rcases hw with ⟨m, hwm⟩
    letI := hRedBq
    have hfw0 : f_loc w = 0 := IsNilpotent.eq_zero ⟨m, by rw [← map_pow, hwm, map_zero]⟩
    exact hInj_loc (hfw0.trans f_loc.map_zero.symm)
  have hNodGen : ∀ (B : Type u) [CommRing B]
      (φ : (MvPolynomial (Fin 2) Ω ⧸ I_nod_Ω) →+* B)
      (q₀ : PrimeSpectrum B),
      φ.Etale →
      (∀ i : Fin 2, φ (Ideal.Quotient.mk I_nod_Ω (MvPolynomial.X i)) ∈ q₀.asIdeal) →
      ∃ q₁ : PrimeSpectrum B, q₁ ≤ q₀ ∧ q₁ ≠ q₀ := by
    intro B _ φ q₀ hφ hX
    let R_nod := MvPolynomial (Fin 2) Ω ⧸ I_nod_Ω
    let π₀ : MvPolynomial (Fin 2) Ω →+* Polynomial Ω :=
      MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0]
    have h_ker_le : I_nod_Ω ≤ RingHom.ker π₀ := by
      rw [Ideal.span_le]
      rintro _ rfl
      simp [π₀]
    let π_bar : R_nod →+* Polynomial Ω := Ideal.Quotient.lift I_nod_Ω π₀ h_ker_le
    let p_nod : Ideal R_nod := RingHom.ker π_bar
    haveI : p_nod.IsPrime := RingHom.ker_isPrime π_bar
    let q_nod : Ideal R_nod := Ideal.comap φ q₀.asIdeal
    haveI : q_nod.IsPrime := Ideal.comap_isPrime φ q₀.asIdeal
    have h_ev0 : (Polynomial.evalRingHom (0 : Ω)).comp π₀ = MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext'
      · ext c
        simp [π₀]
      · intro i
        fin_cases i <;> simp [π₀]
    have hp_le_q : p_nod ≤ q_nod := by
      intro z hz
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hπP : π₀ P = 0 := hz
      have hcoeff0 : P.coeff 0 = 0 := by
        change MvPolynomial.constantCoeff P = 0
        rw [← h_ev0, RingHom.comp_apply, hπP, map_zero]
      let ψ_P : MvPolynomial (Fin 2) Ω →+* B := φ.comp (Ideal.Quotient.mk I_nod_Ω)
      show ψ_P P ∈ q₀.asIdeal
      rw [P.as_sum, map_sum]
      refine Ideal.sum_mem q₀.asIdeal fun d hd => ?_
      have hd_ne : d ≠ 0 := by
        intro hd0
        subst hd0
        exact (MvPolynomial.mem_support_iff.mp hd) hcoeff0
      have hex_pos : ∃ i₀ : Fin 2, 1 ≤ d i₀ := by
        by_contra hno
        apply hd_ne
        ext i
        simp only [Finsupp.coe_zero, Pi.zero_apply]
        by_contra hi_ne
        exact hno ⟨i, Nat.one_le_iff_ne_zero.mpr hi_ne⟩
      obtain ⟨i₀, hi₀⟩ := hex_pos
      let d' : Fin 2 →₀ ℕ := d - Finsupp.single i₀ 1
      have hd_split : d' + Finsupp.single i₀ 1 = d := by
        ext j
        simp only [d', Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
          Finsupp.single_apply]
        split_ifs with hj
        · subst hj
          omega
        · omega
      have hmon_eq : MvPolynomial.monomial d (P.coeff d) =
          MvPolynomial.monomial d' (P.coeff d) * MvPolynomial.X i₀ := by
        rw [MvPolynomial.X, MvPolynomial.monomial_mul_monomial, hd_split, mul_one]
      rw [hmon_eq, map_mul]
      exact Ideal.mul_mem_left q₀.asIdeal _ (hX i₀)
    have hp_ne_q : p_nod ≠ q_nod := by
      intro heq
      have hx0_q : Ideal.Quotient.mk I_nod_Ω (MvPolynomial.X 0) ∈ q_nod := hX 0
      rw [← heq] at hx0_q
      have hx0_ker : π₀ (MvPolynomial.X 0) = 0 := hx0_q
      rw [MvPolynomial.eval₂Hom_X'] at hx0_ker
      exact Polynomial.X_ne_zero hx0_ker
    have hp_lt_q : p_nod < q_nod := lt_of_le_of_ne hp_le_q hp_ne_q
    letI : Algebra R_nod B := φ.toAlgebra
    haveI : Algebra.Etale R_nod B := hφ
    haveI : Module.Flat R_nod B := inferInstance
    haveI : Algebra.HasGoingDown R_nod B := Algebra.HasGoingDown.of_flat
    haveI : q₀.asIdeal.LiesOver q_nod := ⟨rfl⟩
    obtain ⟨P, hP_lt, hP_prime, _⟩ :=
      Ideal.exists_ideal_lt_liesOver_of_lt q₀.asIdeal hp_lt_q
    exact ⟨⟨P, hP_prime⟩, le_of_lt hP_lt,
      fun heq => (ne_of_lt hP_lt) (congrArg PrimeSpectrum.asIdeal heq)⟩
  have hEtDisc : ∀ (A B : Type u) [CommRing A] [CommRing B]
      (e_AB : A →+* B) (q₁ q₀ : PrimeSpectrum B),
      e_AB.Etale → q₁ ≤ q₀ →
      PrimeSpectrum.comap e_AB q₁ = PrimeSpectrum.comap e_AB q₀ →
      q₁ = q₀ := by
    intro A B _ _ e_AB q₁ q₀ he_AB hle hcomap
    let p₀ : PrimeSpectrum A := PrimeSpectrum.comap e_AB q₀
    let A_p := Localization.AtPrime p₀.asIdeal
    let B_q := Localization.AtPrime q₀.asIdeal
    let f_loc : A_p →+* B_q := Localization.localRingHom p₀.asIdeal q₀.asIdeal e_AB rfl
    letI : Algebra A B := e_AB.toAlgebra
    haveI : Algebra.Etale A B := he_AB
    letI : Algebra A_p B_q := f_loc.toAlgebra
    haveI : IsScalarTower A A_p B_q := ⟨fun a x z => by
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc, ← Algebra.smul_def]
      have hmap := Localization.localRingHom_to_map p₀.asIdeal q₀.asIdeal e_AB rfl a
      change f_loc (algebraMap A A_p a) * (x • z) = a • (x • z)
      rw [hmap]
      change algebraMap B B_q (algebraMap A B a) * (x • z) = a • (x • z)
      rw [← IsScalarTower.algebraMap_apply A B B_q a, ← Algebra.smul_def]⟩
    haveI : IsLocalHom (algebraMap A_p B_q) :=
      Localization.isLocalHom_localRingHom p₀.asIdeal q₀.asIdeal e_AB rfl
    haveI : Algebra.EssFiniteType A B_q := Algebra.EssFiniteType.comp A B B_q
    haveI : Algebra.EssFiniteType A_p B_q := Algebra.EssFiniteType.of_comp A A_p B_q
    haveI : Algebra.FormallyUnramified A B_q := inferInstance
    haveI : Algebra.FormallyUnramified A_p B_q :=
      Algebra.FormallyUnramified.of_restrictScalars A A_p B_q
    have hMapMax : Ideal.map (algebraMap A_p B_q) (IsLocalRing.maximalIdeal A_p) =
        IsLocalRing.maximalIdeal B_q :=
      ((Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := A_p) (S := B_q)).mp
        inferInstance).2
    have hDisj₁ : Disjoint (q₀.asIdeal.primeCompl : Set B) (q₁.asIdeal : Set B) :=
      Set.disjoint_left.mpr fun _ hx0 hx1 => hx0 (hle hx1)
    have hDisj₀ : Disjoint (q₀.asIdeal.primeCompl : Set B) (q₀.asIdeal : Set B) :=
      Set.disjoint_left.mpr fun _ hx0 hx1 => hx0 hx1
    let P₁ : Ideal B_q := Ideal.map (algebraMap B B_q) q₁.asIdeal
    haveI hP₁_prime : P₁.IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint q₀.asIdeal.primeCompl B_q
        q₁.asIdeal q₁.isPrime hDisj₁
    have hP₁_le : P₁ ≤ IsLocalRing.maximalIdeal B_q :=
      IsLocalRing.le_maximalIdeal hP₁_prime.ne_top
    have hMax_le_P₁ : IsLocalRing.maximalIdeal B_q ≤ P₁ := by
      rw [← hMapMax, ← IsLocalization.AtPrime.map_eq_maximalIdeal p₀.asIdeal A_p,
        Ideal.map_map, ← IsScalarTower.algebraMap_eq A A_p B_q,
        IsScalarTower.algebraMap_eq A B B_q, ← Ideal.map_map]
      apply Ideal.map_mono
      have hp₀_eq : p₀.asIdeal = Ideal.comap e_AB q₁.asIdeal :=
        congrArg PrimeSpectrum.asIdeal hcomap.symm
      rw [hp₀_eq]
      exact Ideal.map_comap_le
    have hMap_eq : Ideal.map (algebraMap B B_q) q₁.asIdeal =
        Ideal.map (algebraMap B B_q) q₀.asIdeal :=
      (le_antisymm hP₁_le hMax_le_P₁).trans
        (IsLocalization.AtPrime.map_eq_maximalIdeal q₀.asIdeal B_q).symm
    have hq₁_eq : q₁.asIdeal = q₀.asIdeal := by
      calc
        q₁.asIdeal = Ideal.under B (Ideal.map (algebraMap B B_q) q₁.asIdeal) :=
          (IsLocalization.under_map_of_isPrime_disjoint q₀.asIdeal.primeCompl B_q
            q₁.isPrime hDisj₁).symm
        _ = Ideal.under B (Ideal.map (algebraMap B B_q) q₀.asIdeal) := by rw [hMap_eq]
        _ = q₀.asIdeal :=
          IsLocalization.under_map_of_isPrime_disjoint q₀.asIdeal.primeCompl B_q
            q₀.isPrime hDisj₀
    exact PrimeSpectrum.ext hq₁_eq
  
  have hPart1 : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (p_Y : Y ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)),
      AlgebraicGeometry.IsProper p_Y →
      (∀ y : ↥Y, HasSpreadSmoothOrNodalAt p_Y y) →
      (irreducibleComponents ↥Y).Finite ∧
      AlgebraicGeometry.IsReduced Y ∧
      (∀ (y : ↥Y) (V_sm : Y.Opens),
        y ∈ V_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) →
        ∀ E₁ ∈ irreducibleComponents ↥Y, ∀ E₂ ∈ irreducibleComponents ↥Y,
          y ∈ E₁ → y ∈ E₂ → E₁ = E₂) ∧
      (∀ E_Y ∈ irreducibleComponents ↥Y,
        ∃ η_Y ∈ E_Y,
          closure ({η_Y} : Set ↥Y) = E_Y ∧
          ∃ V₀ : Y.Opens,
            η_Y ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V₀.ι ≫ p_Y)) := by
    intro Y p_Y hPropY hSmNod
    letI : AlgebraicGeometry.IsProper p_Y := hPropY
    
    haveI : AlgebraicGeometry.IsLocallyNoetherian Y :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian p_Y
    haveI : CompactSpace ↥Y :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace p_Y
    haveI : AlgebraicGeometry.IsNoetherian Y :=
      (AlgebraicGeometry.isNoetherian_iff Y).mpr ⟨inferInstance, inferInstance⟩
    have hFinY : (irreducibleComponents ↥Y).Finite :=
      AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
    
    have hSmChart : ∀ (y : ↥Y) (V_sm : Y.Opens),
        y ∈ V_sm →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Y) →
        _root_.IsReduced ↑(Y.presheaf.stalk y) ∧
          ∃ O_y : Set ↥Y, IsOpen O_y ∧ IsIrreducible O_y ∧ y ∈ O_y := by
      intro y V_sm hy hSm
      let x_sm : ↥V_sm.toScheme := ⟨y, hy⟩
      obtain ⟨U_Ω, _, V_sub, hV_sub, hx_sub, e_le, hf_std⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 (V_sm.ι ≫ p_Y)).mp hSm x_sm
      have hpt_bot : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
          pt.asIdeal = (⊥ : Ideal Ω) := by
        intro pt
        ext c
        rw [Ideal.mem_bot]
        constructor
        · intro hc
          by_contra hc0
          exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hc0))
        · rintro rfl
          exact pt.asIdeal.zero_mem
      have hUΩ_top : U_Ω = ⊤ := by
        ext pt
        refine ⟨fun _ => trivial, fun _ => ?_⟩
        have hpt_eq : pt = (V_sm.ι ≫ p_Y).base x_sm :=
          PrimeSpectrum.ext ((hpt_bot pt).trans (hpt_bot _).symm)
        rw [hpt_eq]
        exact e_le hx_sub
      subst hUΩ_top
      let e_Ω : Ω ≃+* ↑((AlgebraicGeometry.Spec (CommRingCat.of Ω)).presheaf.obj (Opposite.op ⊤)) :=
        hCommRingCatIsoToEquiv (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).symm
      let S := ↑(V_sm.toScheme.presheaf.obj (Opposite.op V_sub))
      obtain ⟨hRedS, hLocDomS⟩ :=
        hSmRing _ S e_Ω ((V_sm.ι ≫ p_Y).appLE ⊤ V_sub e_le).hom hf_std
      letI : Algebra S ↑(V_sm.toScheme.presheaf.stalk x_sm) :=
        (V_sm.toScheme.presheaf.germ V_sub x_sm hx_sub).hom.toAlgebra
      haveI : IsLocalization.AtPrime ↑(V_sm.toScheme.presheaf.stalk x_sm)
          (hV_sub.primeIdealOf ⟨x_sm, hx_sub⟩).asIdeal :=
        hV_sub.isLocalization_stalk ⟨x_sm, hx_sub⟩
      have hRedStalkV : _root_.IsReduced ↑(V_sm.toScheme.presheaf.stalk x_sm) :=
        hLocRed S hRedS (hV_sub.primeIdealOf ⟨x_sm, hx_sub⟩).asIdeal.primeCompl
          ↑(V_sm.toScheme.presheaf.stalk x_sm)
      have hRedStalkY : _root_.IsReduced ↑(Y.presheaf.stalk y) :=
        hRedEquiv hRedStalkV (hCommRingCatIsoToEquiv (V_sm.stalkIso x_sm))
      let q_y : PrimeSpectrum S := hV_sub.primeIdealOf ⟨x_sm, hx_sub⟩
      obtain ⟨g, hg_not_mem, hDomAway⟩ := hLocDomS q_y
      letI : IsDomain (Localization.Away g) := hDomAway
      have hBasic_eq : (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum S)) =
          Set.range (PrimeSpectrum.comap (algebraMap S (Localization.Away g))) :=
        (PrimeSpectrum.localization_away_comap_range (Localization.Away g) g).symm
      have hIrredUniv : IsIrreducible (Set.univ : Set (PrimeSpectrum (Localization.Away g))) :=
        IrreducibleSpace.isIrreducible_univ (PrimeSpectrum (Localization.Away g))
      have hIrredBasic : IsIrreducible (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum S)) := by
        rw [hBasic_eq, ← Set.image_univ]
        exact hIrredUniv.image _ (PrimeSpectrum.continuous_comap _).continuousOn
      let ι_chart : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ Y := hV_sub.fromSpec ≫ V_sm.ι
      haveI : AlgebraicGeometry.IsOpenImmersion ι_chart := inferInstance
      let O_y : Set ↥Y := ι_chart.base '' (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum S))
      have hOpenO : IsOpen O_y :=
        ι_chart.isOpenEmbedding.isOpenMap _ (PrimeSpectrum.basicOpen g).isOpen
      have hIrredO : IsIrreducible O_y :=
        hIrredBasic.image ι_chart.base ι_chart.continuous.continuousOn
      have hqy_mem : q_y ∈ PrimeSpectrum.basicOpen g := hg_not_mem
      have hyO : y ∈ O_y := by
        refine ⟨q_y, hqy_mem, ?_⟩
        change V_sm.ι.base (hV_sub.fromSpec.base q_y) = y
        rw [hV_sub.fromSpec_primeIdealOf ⟨x_sm, hx_sub⟩]
        rfl
      exact ⟨hRedStalkY, O_y, hOpenO, hIrredO, hyO⟩
    
    have hNodChart : ∀ (y : ↥Y),
        (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ Y)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) Ω ⧸ I_nod_Ω))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y ∧
          (∀ i : Fin 2, Ideal.Quotient.mk I_nod_Ω (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
          e₁ ≫ p_Y =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk I_nod_Ω).comp MvPolynomial.C))) →
        _root_.IsReduced ↑(Y.presheaf.stalk y) ∧
          ∃ y₁ : ↥Y, y₁ ≠ y ∧ y ∈ closure ({y₁} : Set ↥Y) := by
      rintro y ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀, hX_mem, _⟩
      letI : AlgebraicGeometry.Etale e₁ := hEt₁
      letI : AlgebraicGeometry.Etale e₂ := hEt₂
      obtain ⟨U_Y, hUY, hy_UY, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := y) (U := (⊤ : Y.Opens)) trivial
      have hu₀_pre : u₀ ∈ e₁ ⁻¹ᵁ U_Y := by
        show e₁.base u₀ ∈ U_Y
        rw [hu₀]
        exact hy_UY
      obtain ⟨U_B, hUB, hu₀_UB, hUB_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := u₀) (U := e₁ ⁻¹ᵁ U_Y) hu₀_pre
      let A := ↑(Y.presheaf.obj (Opposite.op U_Y))
      let B := ↑(U'.presheaf.obj (Opposite.op U_B))
      have hRange_sub : Set.range (hUB.fromSpec ≫ e₁).base ⊆ Set.range hUY.fromSpec.base := by
        rw [hUY.range_fromSpec]
        rintro _ ⟨q, rfl⟩
        have hq_mem : hUB.fromSpec.base q ∈ (U_B : Set ↥U') := by
          rw [← hUB.range_fromSpec]
          exact ⟨q, rfl⟩
        exact hUB_le hq_mem
      let g_AB : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of A) :=
        AlgebraicGeometry.IsOpenImmersion.lift hUY.fromSpec (hUB.fromSpec ≫ e₁) hRange_sub
      have hg_fac : g_AB ≫ hUY.fromSpec = hUB.fromSpec ≫ e₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac hUY.fromSpec (hUB.fromSpec ≫ e₁) hRange_sub
      have hEt_comp : AlgebraicGeometry.Etale (g_AB ≫ hUY.fromSpec) := by
        rw [hg_fac]
        infer_instance
      have hEt_gAB : AlgebraicGeometry.Etale g_AB :=
        CategoryTheory.MorphismProperty.of_postcomp
          (@AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale)
          g_AB hUY.fromSpec inferInstance hEt_comp
      let e_AB : A →+* B := (AlgebraicGeometry.Spec.preimage g_AB).hom
      have hSpec_eAB : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_AB) = g_AB := by
        simpa [e_AB] using AlgebraicGeometry.Spec.map_preimage g_AB
      have he_AB : e_AB.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hSpec_eAB.symm ▸ hEt_gAB)
      let φ : (MvPolynomial (Fin 2) Ω ⧸ I_nod_Ω) →+* B :=
        (AlgebraicGeometry.Spec.preimage (hUB.fromSpec ≫ e₂)).hom
      have hSpec_φ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) = hUB.fromSpec ≫ e₂ := by
        simpa [φ] using AlgebraicGeometry.Spec.map_preimage (hUB.fromSpec ≫ e₂)
      have hEt_e2_comp : AlgebraicGeometry.Etale (hUB.fromSpec ≫ e₂) := inferInstance
      have hφ : φ.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
