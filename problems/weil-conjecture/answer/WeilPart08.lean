      obtain ⟨e_R, heR_C, heR_X⟩ := hDehom R N a (MvPolynomial.X a) rfl
      obtain ⟨e_S, heS_C, heS_X⟩ := hDehom S N a (f_gr (MvPolynomial.X a)) (hfX a)
      have hPush : CategoryTheory.IsPushout
          (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom 𝒜_R
            (Submonoid.powers (MvPolynomial.X a))).comp (algebraMap R ↥(𝒜_R 0))))
          (CommRingCat.ofHom φ_RS)
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_gr (MvPolynomial.X a)))
