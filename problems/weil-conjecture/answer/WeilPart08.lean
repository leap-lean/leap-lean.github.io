    have : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) := hU
    exact j_FF.injective.comp (X.germToFunctionField_injective U)
  have hJ2 : ∀ (U V : X.Opens) (hU : Nonempty ↥U) (hV : Nonempty ↥V) (hle : V ≤ U)
