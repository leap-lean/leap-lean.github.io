    have h_α_α' : α ≫ α' = 𝟙 X := hCompId W₀ W₀' hW'W α α' hα_app hα'_app
    have h_α'_α : α' ≫ α = 𝟙 X := hCompId W₀' W₀ hWW' α' α hα'_app hα_app
    exact ⟨α, ⟨⟨α', h_α_α', h_α'_α⟩⟩, hα_hom, hα_open⟩
  · intro A S _ _ φ_AS Φ hBC v
    suffices hGenBC : ∀ (X_A X_S : AlgebraicGeometry.Scheme.{u})
        (U_A : Fin (M + 1) → X_A.Opens) (U_S : Fin (M + 1) → X_S.Opens)
        (c_A : ∀ a : Fin (M + 1), A →+* ↑(X_A.presheaf.obj (Opposite.op (U_A a))))
        (t_A : ∀ a : Fin (M + 1), Fin (M + 1) → ↑(X_A.presheaf.obj (Opposite.op (U_A a))))
        (c_S : ∀ a : Fin (M + 1), S →+* ↑(X_S.presheaf.obj (Opposite.op (U_S a))))
        (t_S : ∀ a : Fin (M + 1), Fin (M + 1) → ↑(X_S.presheaf.obj (Opposite.op (U_S a))))
        (Ψ : X_S ⟶ X_A),
        (∀ a : Fin (M + 1),
          ∃ heq : (TopologicalSpace.Opens.map Ψ.base).obj (U_A a) = U_S a,
            (∀ r : A,
              (Ψ.app (U_A a) ≫ X_S.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
                (c_A a r) = c_S a (φ_AS r)) ∧
            (∀ b : Fin (M + 1),
              (Ψ.app (U_A a) ≫ X_S.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
                (t_A a b) = t_S a b)) →
        (TopologicalSpace.Opens.map Ψ.base).obj
            (⨆ c : Fin (M + 1),
              X_A.basicOpen (∑ b : Fin (M + 1), c_A c (v b) * t_A c b)) =
          ⨆ c : Fin (M + 1),
            X_S.basicOpen (∑ b : Fin (M + 1), c_S c (φ_AS (v b)) * t_S c b) from
      hGenBC (weilProjectiveSpaceOver A M).left (weilProjectiveSpaceOver S M).left
        (weilProjBasicOpen A M) (weilProjBasicOpen S M)
        (c_proj A) (t_proj A) (c_proj S) (t_proj S) Φ hBC.2.2
    intro X_A X_S U_A U_S c_A t_A c_S t_S Ψ hCharts
    let f_A : ∀ c : Fin (M + 1), ↑(X_A.presheaf.obj (Opposite.op (U_A c))) :=
      fun c => ∑ b : Fin (M + 1), c_A c (v b) * t_A c b
    have h_iSup :
        (TopologicalSpace.Opens.map Ψ.base).obj (⨆ c : Fin (M + 1), X_A.basicOpen (f_A c)) =
          ⨆ c : Fin (M + 1), (TopologicalSpace.Opens.map Ψ.base).obj (X_A.basicOpen (f_A c)) :=
      Ψ.preimage_iSup _
    rw [h_iSup]
    refine iSup_congr fun c => ?_
    obtain ⟨heq, hc, ht⟩ := hCharts c
    have h_pre : (TopologicalSpace.Opens.map Ψ.base).obj (X_A.basicOpen (f_A c)) =
        X_S.basicOpen ((Ψ.app (U_A c)).hom (f_A c)) :=
      Ψ.preimage_basicOpen (f_A c)
    rw [h_pre]
    have h_iso : X_S.basicOpen ((Ψ.app (U_A c)).hom (f_A c)) =
        X_S.basicOpen
          ((Ψ.app (U_A c) ≫ X_S.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom (f_A c)) :=
      (X_S.toRingedSpace.basicOpen_res_eq (CategoryTheory.eqToHom heq.symm).op
        ((Ψ.app (U_A c)).hom (f_A c))).symm
    rw [h_iso]
    congr 1
    let ρ := (Ψ.app (U_A c) ≫ X_S.presheaf.map (CategoryTheory.eqToHom heq.symm).op).hom
    change ρ (∑ b : Fin (M + 1), c_A c (v b) * t_A c b) = _
    simp only [map_sum, map_mul]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [hc (v b), ht b]

theorem weil_proj_nodal_fiber_finiteness_and_gl_twoChart_placement (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R]
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (hEtDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
      ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (M : ℕ)
    (hAff_proj : ∀ (A : Type u) [CommRing A] (N : ℕ) (a : Fin (N + 1)),
      AlgebraicGeometry.IsAffineOpen (weilProjBasicOpen A N a))
    (c_proj : ∀ (A : Type u) [CommRing A] (N : ℕ) (a : Fin (N + 1)),
      A →+* ↑((weilProjectiveSpaceOver A N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A N a))))
    (t_proj : ∀ (A : Type u) [CommRing A] (N : ℕ) (a : Fin (N + 1)), Fin (N + 1) →
      ↑((weilProjectiveSpaceOver A N).left.presheaf.obj
        (Opposite.op (weilProjBasicOpen A N a))))
    (hCoord_proj : ∀ (A : Type u) [CommRing A] (N : ℕ),
      IsCommRingProjCoordSystem A N (hAff_proj A N) (c_proj A N) (t_proj A N))
    (hBase_proj : ∀ (A S : Type u) [CommRing A] [CommRing S] (φ_AS : A →+* S) (N : ℕ),
      ∃ (Φ : (weilProjectiveSpaceOver S N).left ⟶ (weilProjectiveSpaceOver A N).left),
        IsCommRingProjBaseChange A S φ_AS N
          (c_proj A N) (t_proj A N) (c_proj S N) (t_proj S N) Φ)
    (E_bar : AlgebraicGeometry.Scheme.{u})
    (p_E : E_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left)
    (hCl : AlgebraicGeometry.IsClosedImmersion ι_bar)
    (hInt : AlgebraicGeometry.IsIntegral E_bar)
    (hp_E : ι_bar ≫ (weilProjectiveSpaceOver R M).hom = p_E)
    (hGenIso : ∃ isoP1 :
        CategoryTheory.Limits.pullback p_E
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) ≅
        (weilProjectiveSpaceOver K_R 1).left,
      CategoryTheory.Limits.pullback.snd p_E
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) =
        isoP1.hom ≫ (weilProjectiveSpaceOver K_R 1).hom)
    (hRedZ₀ : AlgebraicGeometry.IsReduced (CategoryTheory.Limits.pullback p_E
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hNodZ₀ : ∀ z : ↥(CategoryTheory.Limits.pullback p_E
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))),
      HasSpreadSmoothOrNodalAt
        (CategoryTheory.Limits.pullback.snd p_E
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
        z) :
    let k₀ := IsLocalRing.ResidueField R
    let s₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))
    let Z₀ := CategoryTheory.Limits.pullback p_E s₀
    let p_Z₀ := CategoryTheory.Limits.pullback.snd p_E s₀
    let Sing_Z₀ : Set ↥Z₀ :=
      {z : ↥Z₀ | ¬ ∃ V_sm : Z₀.Opens,
        z ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ p_Z₀)}
    let S_inter : Set ↥Z₀ :=
      {z : ↥Z₀ | ∃ Z₁ ∈ irreducibleComponents ↥Z₀, ∃ Z₂ ∈ irreducibleComponents ↥Z₀,
        Z₁ ≠ Z₂ ∧ z ∈ Z₁ ∧ z ∈ Z₂}
    (1 ≤ M ∧
      (irreducibleComponents ↥Z₀).Finite ∧
      (irreducibleComponents ↥Z₀).Nonempty ∧
      Sing_Z₀.Finite ∧
      S_inter ⊆ Sing_Z₀ ∧
      S_inter.Finite ∧
      (∀ z ∈ Sing_Z₀, IsClosed ({z} : Set ↥Z₀)) ∧
      (∀ z : ↥Z₀,
        ∀ Z₁ ∈ irreducibleComponents ↥Z₀,
        ∀ Z₂ ∈ irreducibleComponents ↥Z₀,
        ∀ Z₃ ∈ irreducibleComponents ↥Z₀,
          z ∈ Z₁ → z ∈ Z₂ → z ∈ Z₃ → Z₁ = Z₂ ∨ Z₁ = Z₃ ∨ Z₂ = Z₃)) ∧
    ∃ (ι'_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left)
      (ι'_0 : Z₀ ⟶ (weilProjectiveSpaceOver k₀ M).left)
      (Φ_Rk₀ : (weilProjectiveSpaceOver k₀ M).left ⟶ (weilProjectiveSpaceOver R M).left),
      AlgebraicGeometry.IsClosedImmersion ι'_bar ∧
      ι'_bar ≫ (weilProjectiveSpaceOver R M).hom = p_E ∧
      IsCommRingProjBaseChange R k₀ (IsLocalRing.residue R) M
        (c_proj R M) (t_proj R M) (c_proj k₀ M) (t_proj k₀ M) Φ_Rk₀ ∧
      AlgebraicGeometry.IsClosedImmersion ι'_0 ∧
      ι'_0 ≫ (weilProjectiveSpaceOver k₀ M).hom = p_Z₀ ∧
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst p_E s₀)
        ι'_0 ι'_bar Φ_Rk₀ ∧
      (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M 0) ⊔
        (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M (Fin.last M)) = ⊤ ∧
      Sing_Z₀ ⊆
        (((TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M 0) ⊓
          (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M (Fin.last M)) :
            Z₀.Opens) : Set ↥Z₀) ∧
      (∀ Z_comp ∈ irreducibleComponents ↥Z₀,
        (Z_comp ∩
          ((((TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M 0) ⊓
            (TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M (Fin.last M)) :
              Z₀.Opens) : Set ↥Z₀) \ Sing_Z₀)).Nonempty) ∧
      (∀ (a : Fin (M + 1))
         (hAff_a : AlgebraicGeometry.IsAffineOpen
           ((TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M a))),
         a ∈ ({0, Fin.last M} : Set (Fin (M + 1))) →
         ∀ q : PrimeSpectrum ↑(Z₀.presheaf.obj
             (Opposite.op ((TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M a)))),
           hAff_a.fromSpec.base q ∉ Sing_Z₀ →
           ∃ (g : ↑(Z₀.presheaf.obj
               (Opposite.op ((TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M a)))))
             (ψ : Polynomial k₀ →+* Localization.Away g),
             g ∉ q.asIdeal ∧
             IsDomain (Localization.Away g) ∧
             ψ.Etale ∧
             ψ.comp Polynomial.C =
               (algebraMap _ (Localization.Away g)).comp
                 (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
                   p_Z₀.appLE ⊤
                     ((TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M a))
                     le_top).hom)) ∧
      (∀ (hAff_1 : AlgebraicGeometry.IsAffineOpen
           ((TopologicalSpace.Opens.map ι'_0.base).obj (weilProjBasicOpen k₀ M (Fin.last M))))
         (q : PrimeSpectrum ↑(Z₀.presheaf.obj
           (Opposite.op ((TopologicalSpace.Opens.map ι'_0.base).obj
             (weilProjBasicOpen k₀ M (Fin.last M)))))),
         hAff_1.fromSpec.base q ∈ Sing_Z₀ →
         ∃ (B' : Type u) (_ : CommRing B') (u₀ : PrimeSpectrum B')
           (φ₁ : ↑(Z₀.presheaf.obj
             (Opposite.op ((TopologicalSpace.Opens.map ι'_0.base).obj
               (weilProjBasicOpen k₀ M (Fin.last M))))) →+* B')
           (φ₂ : (MvPolynomial (Fin 2) k₀ ⧸
             Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}) →+* B'),
           φ₁.Etale ∧
           φ₂.Etale ∧
           PrimeSpectrum.comap φ₁ u₀ = q ∧
           φ₁.comp (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k₀)).inv ≫
               p_Z₀.appLE ⊤
                 ((TopologicalSpace.Opens.map ι'_0.base).obj
                   (weilProjBasicOpen k₀ M (Fin.last M)))
                 le_top).hom) =
             φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
           (∀ i : Fin 2, φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ u₀.asIdeal) ∧
           (∀ i : Fin 2, IsDomain (B' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))}))) :=
by
  classical
  intro k₀ s₀ Z₀ p_Z₀ Sing_Z₀ S_inter
  have : IsAlgClosed k₀ := hAlgRes
  have : Infinite k₀ := IsAlgClosed.instInfinite

  
  have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R M).hom := (hCoord_proj R M).1
  have hProp_pE : AlgebraicGeometry.IsProper p_E := by
    have h1 : AlgebraicGeometry.IsProper (ι_bar ≫ (weilProjectiveSpaceOver R M).hom) :=
      inferInstance
    rwa [hp_E] at h1
  have : AlgebraicGeometry.IsProper p_Z₀ := inferInstance
  obtain ⟨isoP1, _hisoP1⟩ := hGenIso
  obtain ⟨θ₁, _⟩ := (hCoord_proj K_R 1).2.2.2.1 0
  let ev₀_KR : MvPolynomial (Fin 1) K_R →+* K_R :=
    (MvPolynomial.aeval (fun _ : Fin 1 => (0 : K_R))).toRingHom
  let ev₁_KR : MvPolynomial (Fin 1) K_R →+* K_R :=
    (MvPolynomial.aeval (fun _ : Fin 1 => (1 : K_R))).toRingHom
  let q₀_mv : PrimeSpectrum (MvPolynomial (Fin 1) K_R) :=
    ⟨RingHom.ker ev₀_KR, RingHom.ker_isPrime ev₀_KR⟩
  let q₁_mv : PrimeSpectrum (MvPolynomial (Fin 1) K_R) :=
    ⟨RingHom.ker ev₁_KR, RingHom.ker_isPrime ev₁_KR⟩
  let p₀_1 : PrimeSpectrum ↑((weilProjectiveSpaceOver K_R 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen K_R 1 0))) :=
    PrimeSpectrum.comap θ₁.symm.toRingHom q₀_mv
  let p₁_1 : PrimeSpectrum ↑((weilProjectiveSpaceOver K_R 1).left.presheaf.obj
      (Opposite.op (weilProjBasicOpen K_R 1 0))) :=
    PrimeSpectrum.comap θ₁.symm.toRingHom q₁_mv
  have hp01_ne : p₀_1 ≠ p₁_1 := by
    intro hEq
    have hMem0 : θ₁ (MvPolynomial.X 0) ∈ p₀_1.asIdeal := by
      change ev₀_KR (θ₁.symm (θ₁ (MvPolynomial.X 0))) = 0
      rw [θ₁.symm_apply_apply]
      simp [ev₀_KR]
    rw [hEq] at hMem0
    have hMem1 : ev₁_KR (θ₁.symm (θ₁ (MvPolynomial.X 0))) = 0 := hMem0
    rw [θ₁.symm_apply_apply] at hMem1
    simp [ev₁_KR] at hMem1
  let w₀ : ↥(weilProjectiveSpaceOver K_R 1).left := (hAff_proj K_R 1 0).fromSpec.base p₀_1
  let w₁ : ↥(weilProjectiveSpaceOver K_R 1).left := (hAff_proj K_R 1 0).fromSpec.base p₁_1
  have hw01_ne : w₀ ≠ w₁ := fun h =>
    hp01_ne ((hAff_proj K_R 1 0).fromSpec.isOpenEmbedding.injective h)
  let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))
  have h1M : 1 ≤ M := by
    rcases Nat.eq_zero_or_pos M with rfl | hPos
    · obtain ⟨Φ_RK0, _hComm0, hPbProj0, _⟩ := hBase_proj R K_R (algebraMap R K_R) 0
      have hw_0 : (CategoryTheory.Limits.pullback.fst p_E η_R ≫ ι_bar) ≫
          (weilProjectiveSpaceOver R 0).hom =
          CategoryTheory.Limits.pullback.snd p_E η_R ≫ η_R := by
        rw [CategoryTheory.Category.assoc, hp_E]
        exact CategoryTheory.Limits.pullback.condition
      let ι_K0 : CategoryTheory.Limits.pullback p_E η_R ⟶ (weilProjectiveSpaceOver K_R 0).left :=
        hPbProj0.lift (CategoryTheory.Limits.pullback.fst p_E η_R ≫ ι_bar)
          (CategoryTheory.Limits.pullback.snd p_E η_R) hw_0
      have hιK0_fst : ι_K0 ≫ Φ_RK0 = CategoryTheory.Limits.pullback.fst p_E η_R ≫ ι_bar :=
        hPbProj0.lift_fst _ _ _
      have hιK0_snd : ι_K0 ≫ (weilProjectiveSpaceOver K_R 0).hom =
          CategoryTheory.Limits.pullback.snd p_E η_R :=
        hPbProj0.lift_snd _ _ _
      have hPb_K0 : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst p_E η_R) ι_K0 ι_bar Φ_RK0 := by
        have hOuter : CategoryTheory.IsPullback
            (ι_K0 ≫ (weilProjectiveSpaceOver K_R 0).hom)
            (CategoryTheory.Limits.pullback.fst p_E η_R) η_R
            (ι_bar ≫ (weilProjectiveSpaceOver R 0).hom) := by
          rw [hιK0_snd, hp_E]
          exact (CategoryTheory.IsPullback.of_hasPullback p_E η_R).flip
        exact (CategoryTheory.IsPullback.of_right hOuter hιK0_fst hPbProj0.flip).flip
      have hCl_K0 : AlgebraicGeometry.IsClosedImmersion ι_K0 :=
        CategoryTheory.MorphismProperty.of_isPullback
          (P := @AlgebraicGeometry.IsClosedImmersion) hPb_K0 hCl
      have hCl_comp : AlgebraicGeometry.IsClosedImmersion (isoP1.inv ≫ ι_K0) := inferInstance
      have hInj0 : Function.Injective (isoP1.inv ≫ ι_K0).base :=
        (isoP1.inv ≫ ι_K0).isClosedEmbedding.toIsEmbedding.injective
      obtain ⟨θ₀, _⟩ := (hCoord_proj K_R 0).2.2.2.1 0
      let e_KR : K_R ≃+* ↑((weilProjectiveSpaceOver K_R 0).left.presheaf.obj
          (Opposite.op (weilProjBasicOpen K_R 0 0))) :=
        (MvPolynomial.isEmptyAlgEquiv K_R (Fin 0)).symm.toRingEquiv.trans θ₀
      have hSub_spec : Subsingleton (PrimeSpectrum
          ↑((weilProjectiveSpaceOver K_R 0).left.presheaf.obj
            (Opposite.op (weilProjBasicOpen K_R 0 0)))) := by
        refine ⟨fun a b => ?_⟩
        ext x
        have h_ab : PrimeSpectrum.comap e_KR.toRingHom a =
            PrimeSpectrum.comap e_KR.toRingHom b := Subsingleton.elim _ _
        have hx : e_KR (e_KR.symm x) = x := e_KR.apply_symm_apply x
        rw [← hx]
        exact Ideal.ext_iff.mp (PrimeSpectrum.ext_iff.mp h_ab) (e_KR.symm x)
      have hAll_in0 : ∀ y : ↥(weilProjectiveSpaceOver K_R 0).left,
          y ∈ weilProjBasicOpen K_R 0 0 := by
        intro y
        have hy_top : y ∈ (⊤ : (weilProjectiveSpaceOver K_R 0).left.Opens) := trivial
        rw [← (hCoord_proj K_R 0).2.1, TopologicalSpace.Opens.mem_iSup] at hy_top
        rcases hy_top with ⟨a, ha⟩
        rwa [Fin.eq_zero a] at ha
      rcases (hAff_proj K_R 0 0).range_fromSpec.symm.subset
        (hAll_in0 ((isoP1.inv ≫ ι_K0).base w₀)) with ⟨q_a, hq_a⟩
      rcases (hAff_proj K_R 0 0).range_fromSpec.symm.subset
        (hAll_in0 ((isoP1.inv ≫ ι_K0).base w₁)) with ⟨q_b, hq_b⟩
      have hqa_qb : q_a = q_b := @Subsingleton.elim _ hSub_spec _ _
      exact False.elim (hw01_ne (hInj0 (hq_a.symm.trans (by rw [hqa_qb, hq_b]))))
    · exact hPos
  let x_K : ↥(CategoryTheory.Limits.pullback p_E η_R) := isoP1.inv.base w₀
  let x_E : ↥E_bar := (CategoryTheory.Limits.pullback.fst p_E η_R).base x_K
  let pt_K0 : ↥(AlgebraicGeometry.Spec (CommRingCat.of K_R)) := (⊥ : PrimeSpectrum K_R)
  have hp_xE : p_E.base x_E = η_R.base pt_K0 := by
    have h_cond := congrArg (fun f => f.base x_K)
      (CategoryTheory.Limits.pullback.condition (f := p_E) (g := η_R))
    have h_sub : (CategoryTheory.Limits.pullback.snd p_E η_R).base x_K = pt_K0 :=
      Subsingleton.elim (α := PrimeSpectrum K_R) _ _
    exact h_cond.trans (congrArg η_R.base h_sub)
  have hbot_R : (p_E.base x_E : PrimeSpectrum R).asIdeal = ⊥ := by
    rw [hp_xE]
    change Ideal.comap (algebraMap R K_R) ⊥ = ⊥
    ext r
    simp only [Ideal.mem_comap, Ideal.mem_bot]
    exact ⟨fun h => IsFractionRing.injective R K_R (h.trans (map_zero _).symm),
      fun h => h ▸ map_zero _⟩
  have hClosed_img : IsClosed (p_E.base '' Set.univ : Set (PrimeSpectrum R)) :=
    p_E.isClosedMap Set.univ isClosed_univ
  obtain ⟨I_img, hI_img⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal _).mp hClosed_img
  have hI_le_bot : (I_img : Set R) ⊆ (⊥ : Ideal R) := by
    have hx_mem : (p_E.base x_E : PrimeSpectrum R) ∈
        (p_E.base '' Set.univ : Set (PrimeSpectrum R)) := ⟨x_E, trivial, rfl⟩
    rw [hI_img] at hx_mem
    change (I_img : Set R) ⊆ (p_E.base x_E : PrimeSpectrum R).asIdeal at hx_mem
    rwa [hbot_R] at hx_mem
  let pt_k0 : ↥(AlgebraicGeometry.Spec (CommRingCat.of k₀)) := (⊥ : PrimeSpectrum k₀)
  have hs0_mem : s₀.base pt_k0 ∈ p_E.base '' Set.univ := by
    have hs0_zl : (s₀.base pt_k0 : PrimeSpectrum R) ∈ PrimeSpectrum.zeroLocus (I_img : Set R) :=
      fun x hx => by
        have hx0 : x ∈ (⊥ : Ideal R) := hI_le_bot hx
        rw [Ideal.mem_bot] at hx0
        exact hx0 ▸ (s₀.base pt_k0 : PrimeSpectrum R).asIdeal.zero_mem
    rwa [← hI_img] at hs0_zl
  rcases hs0_mem with ⟨y_E, _, hy_E⟩
  obtain ⟨z₀, _, _⟩ :=
    AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y_E pt_k0 hy_E
  have hNeC : (irreducibleComponents ↥Z₀).Nonempty :=
    ⟨irreducibleComponent z₀, irreducibleComponent_mem_irreducibleComponents z₀⟩

  
  have hRingPkg := weil_algClosed_smooth_and_nodal_etale_ring_local_structure k₀ hEtDom
  obtain ⟨hFinC, hFinSing, hSubSing, hFinS, hSingCl, hAtMost2,
      hSmWit, hKcutFin, hSmExt, hNodRaw⟩ :=
    weil_proper_etale_nodal_curve_finiteness_and_affine_charts k₀ hEtDom hRingPkg Z₀ p_Z₀ hNodZ₀

  
  let P_k₀ := (weilProjectiveSpaceOver k₀ M).left
  let V_lin : (Fin (M + 1) → k₀) → P_k₀.Opens :=
    fun v => ⨆ c : Fin (M + 1),
      P_k₀.basicOpen (∑ b : Fin (M + 1), c_proj k₀ M c (v b) * t_proj k₀ M c b)
  obtain ⟨Φ_Rk₀, hBC_Rk₀⟩ := hBase_proj R k₀ (IsLocalRing.residue R) M
  have hw_init : (CategoryTheory.Limits.pullback.fst p_E s₀ ≫ ι_bar) ≫
      (weilProjectiveSpaceOver R M).hom = p_Z₀ ≫ s₀ := by
    rw [CategoryTheory.Category.assoc, hp_E]
    exact CategoryTheory.Limits.pullback.condition
  let ι_0_init : Z₀ ⟶ P_k₀ :=
    hBC_Rk₀.2.1.lift (CategoryTheory.Limits.pullback.fst p_E s₀ ≫ ι_bar) p_Z₀ hw_init
  have hι0_init_fst : ι_0_init ≫ Φ_Rk₀ = CategoryTheory.Limits.pullback.fst p_E s₀ ≫ ι_bar :=
    hBC_Rk₀.2.1.lift_fst _ _ _

  
  have hPointSub : ∀ y : ↥P_k₀,
      ∃ H_y : Submodule k₀ (Fin (M + 1) → k₀),
        H_y ≠ ⊤ ∧ ∀ v : Fin (M + 1) → k₀, v ∉ H_y → y ∈ V_lin v := by
    intro y
    have hy_top : y ∈ (⊤ : P_k₀.Opens) := trivial
    rw [← (hCoord_proj k₀ M).2.1, TopologicalSpace.Opens.mem_iSup] at hy_top
    rcases hy_top with ⟨c, hy_c⟩
    let q_y := (hAff_proj k₀ M c).primeIdealOf ⟨y, hy_c⟩
    let H_y : Submodule k₀ (Fin (M + 1) → k₀) :=
      { carrier := {v | (∑ b : Fin (M + 1), c_proj k₀ M c (v b) * t_proj k₀ M c b) ∈ q_y.asIdeal}
        zero_mem' := by simp [q_y.asIdeal.zero_mem]
        add_mem' := fun {u w} hu hw => by
          show (∑ b : Fin (M + 1), c_proj k₀ M c (u b + w b) * t_proj k₀ M c b) ∈ q_y.asIdeal
          simp only [map_add, add_mul, Finset.sum_add_distrib]
          exact q_y.asIdeal.add_mem hu hw
        smul_mem' := fun a {u} hu => by
          show (∑ b : Fin (M + 1), c_proj k₀ M c (a * u b) * t_proj k₀ M c b) ∈ q_y.asIdeal
          have h_eq : (∑ b : Fin (M + 1), c_proj k₀ M c (a * u b) * t_proj k₀ M c b) =
              c_proj k₀ M c a * ∑ b : Fin (M + 1), c_proj k₀ M c (u b) * t_proj k₀ M c b := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun b _ => ?_
            rw [map_mul, mul_assoc]
          rw [h_eq]
          exact q_y.asIdeal.mul_mem_left _ hu }
    have hHy_ne : H_y ≠ ⊤ := by
      intro hTop
      have hMem : (Pi.single c (1 : k₀) : Fin (M + 1) → k₀) ∈ H_y := by
        rw [hTop]; trivial
      have hSum1 : (∑ b : Fin (M + 1),
          c_proj k₀ M c ((Pi.single c (1 : k₀) : Fin (M + 1) → k₀) b) * t_proj k₀ M c b) = 1 := by
        rw [Finset.sum_eq_single c]
        · rw [Pi.single_eq_same, map_one, (hCoord_proj k₀ M).2.2.2.2.1 c, mul_one]
        · intro b _ hb
          rw [Pi.single_eq_of_ne hb, map_zero, zero_mul]
        · intro hc
          exact False.elim (hc (Finset.mem_univ c))
      change (∑ b : Fin (M + 1),
        c_proj k₀ M c ((Pi.single c (1 : k₀) : Fin (M + 1) → k₀) b) *
          t_proj k₀ M c b) ∈ q_y.asIdeal at hMem
      rw [hSum1] at hMem
      exact q_y.isPrime.one_notMem hMem
    refine ⟨H_y, hHy_ne, ?_⟩
    intro v hv
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨c, ?_⟩
    have hq_bo : q_y ∈ PrimeSpectrum.basicOpen
        (∑ b : Fin (M + 1), c_proj k₀ M c (v b) * t_proj k₀ M c b) := hv
    have hy_img : (hAff_proj k₀ M c).fromSpec.base q_y ∈
        ((AlgebraicGeometry.Scheme.Hom.opensFunctor (hAff_proj k₀ M c).fromSpec).obj
          (PrimeSpectrum.basicOpen
            (∑ b : Fin (M + 1), c_proj k₀ M c (v b) * t_proj k₀ M c b)) : P_k₀.Opens) :=
      ⟨q_y, hq_bo, rfl⟩
    rw [(hAff_proj k₀ M c).fromSpec_image_basicOpen,
      (hAff_proj k₀ M c).fromSpec_primeIdealOf ⟨y, hy_c⟩] at hy_img
    exact hy_img
  have hAvoid : ∀ (H_ex : Submodule k₀ (Fin (M + 1) → k₀)), H_ex ≠ ⊤ →
      ∀ (F : Set ↥P_k₀), F.Finite →
        ∃ v : Fin (M + 1) → k₀, v ∉ H_ex ∧ F ⊆ (V_lin v : Set ↥P_k₀) := by
    intro H_ex hHex F hF
    have : Finite ↥F := hF.to_subtype
    let fam : Unit ⊕ ↥F → Submodule k₀ (Fin (M + 1) → k₀) :=
      Sum.elim (fun _ => H_ex) (fun y => (hPointSub y.1).choose)
    have hfam : ∀ idx : Unit ⊕ ↥F, fam idx ≠ ⊤ := by
      rintro (⟨⟩ | y)
      · exact hHex
      · exact (hPointSub y.1).choose_spec.1
    obtain ⟨v, hv⟩ := Submodule.exists_forall_notMem_of_forall_ne_top fam hfam
    refine ⟨v, hv (Sum.inl ()), ?_⟩
    intro y hy
    exact (hPointSub y).choose_spec.2 v (hv (Sum.inr ⟨y, hy⟩))

  have : Finite ↥(irreducibleComponents ↥Z₀) := hFinC.to_subtype
  let S_sm : Set ↥Z₀ :=
    Set.range (fun Z : ↥(irreducibleComponents ↥Z₀) => (hSmWit Z.1 Z.2).choose)
  have hFinSsm : S_sm.Finite := Set.finite_range _
  let F₁ : Set ↥P_k₀ := ι_0_init.base '' (Sing_Z₀ ∪ S_sm)
  have hF₁_fin : F₁.Finite := (hFinSing.union hFinSsm).image ι_0_init.base
  have hBot_ne : (⊥ : Submodule k₀ (Fin (M + 1) → k₀)) ≠ ⊤ := by
    intro hEq
    have h1 : (Pi.single 0 (1 : k₀) : Fin (M + 1) → k₀) ∈
        (⊥ : Submodule k₀ (Fin (M + 1) → k₀)) := by
      rw [hEq]; trivial
    rw [Submodule.mem_bot] at h1
    have h10 := congrFun h1 0
    simp at h10
  obtain ⟨v₀, hv₀_ne_mem, hF₁_sub⟩ := hAvoid ⊥ hBot_ne F₁ hF₁_fin
  have hv₀_ne : v₀ ≠ 0 := by rwa [Submodule.mem_bot] at hv₀_ne_mem

  let U_0_v0 : Z₀.Opens := (TopologicalSpace.Opens.map ι_0_init.base).obj (V_lin v₀)
  let K_cut : Set ↥Z₀ := (U_0_v0 : Set ↥Z₀)ᶜ
  have hFinKcut : K_cut.Finite := by
    refine hKcutFin K_cut U_0_v0.isOpen.isClosed_compl ?_ ?_
    · intro z hz_cut hz_sing
      exact hz_cut (hF₁_sub ⟨z, Or.inl hz_sing, rfl⟩)
    · intro Z_comp hZ_comp hSub
      let p_Z := (hSmWit Z_comp hZ_comp).choose
      have hp_Z_in : p_Z ∈ Z_comp := (hSmWit Z_comp hZ_comp).choose_spec.1
      have hp_Z_sm : p_Z ∈ S_sm := ⟨⟨Z_comp, hZ_comp⟩, rfl⟩
      exact hSub hp_Z_in (hF₁_sub ⟨p_Z, Or.inr hp_Z_sm, rfl⟩)

  let F₂ : Set ↥P_k₀ := ι_0_init.base '' (Sing_Z₀ ∪ S_sm ∪ K_cut)
  have hF₂_fin : F₂.Finite := ((hFinSing.union hFinSsm).union hFinKcut).image ι_0_init.base
  let L : Fin (M + 1) := Fin.last M
  have h0_ne_L : (0 : Fin (M + 1)) ≠ L := by
    intro hEq
    have h_val : (0 : ℕ) = M := congrArg Fin.val hEq
    omega
  have hEx_j0 : ∃ j₀ : Fin (M + 1), v₀ j₀ ≠ 0 := by
    by_contra hAll0
    exact hv₀_ne (funext fun b => by_contra fun hb => hAll0 ⟨b, hb⟩)
  obtain ⟨j₀, hj₀⟩ := hEx_j0
  have hSpan_ne : Submodule.span k₀ ({v₀} : Set (Fin (M + 1) → k₀)) ≠ ⊤ := by
    intro hTop
    let j' : Fin (M + 1) := if j₀ = 0 then L else 0
    have hj'_ne : j' ≠ j₀ := by
      by_cases h : j₀ = 0
      · simp [j', h, h0_ne_L.symm]
      · simp [j', h, Ne.symm h]
    have hMem : (Pi.single j' (1 : k₀) : Fin (M + 1) → k₀) ∈
        Submodule.span k₀ ({v₀} : Set (Fin (M + 1) → k₀)) := by
      rw [hTop]; trivial
    rw [Submodule.mem_span_singleton] at hMem
    rcases hMem with ⟨c, hc⟩
    have h_at_j0 := congrFun hc j₀
    simp only [Pi.smul_apply, smul_eq_mul, Pi.single_eq_of_ne hj'_ne.symm] at h_at_j0
    have hc0 : c = 0 := (mul_eq_zero.mp h_at_j0).resolve_right hj₀
    have h_at_j' := congrFun hc j'
    simp only [hc0, zero_smul, Pi.zero_apply, Pi.single_eq_same] at h_at_j'
    exact zero_ne_one h_at_j'
  obtain ⟨v₁, hv₁_not_span, hF₂_sub⟩ :=
    hAvoid (Submodule.span k₀ ({v₀} : Set (Fin (M + 1) → k₀))) hSpan_ne F₂ hF₂_fin

  let w₁_vec : Fin (M + 1) → k₀ := v₁ - (v₁ j₀ / v₀ j₀) • v₀
  have hw₁_ne : w₁_vec ≠ 0 := by
    intro hw0
    apply hv₁_not_span
    rw [Submodule.mem_span_singleton]
    exact ⟨v₁ j₀ / v₀ j₀, (sub_eq_zero.mp hw0).symm⟩
  have hw₁_j0 : w₁_vec j₀ = 0 := by
    show v₁ j₀ - (v₁ j₀ / v₀ j₀) * v₀ j₀ = 0
    rw [div_mul_cancel₀ _ hj₀, sub_self]
  have hEx_j1 : ∃ j₁ : Fin (M + 1), w₁_vec j₁ ≠ 0 := by
    by_contra hAll0
    exact hw₁_ne (funext fun b => by_contra fun hb => hAll0 ⟨b, hb⟩)
  obtain ⟨j₁, hj₁⟩ := hEx_j1
  have hj10_ne : j₁ ≠ j₀ := fun h => hj₁ (h ▸ hw₁_j0)
  have hDet_k0 : v₀ j₀ * v₁ j₁ - v₀ j₁ * v₁ j₀ ≠ 0 := by
    have hEq : v₀ j₀ * w₁_vec j₁ = v₀ j₀ * v₁ j₁ - v₀ j₁ * v₁ j₀ := by
      show v₀ j₀ * (v₁ j₁ - (v₁ j₀ / v₀ j₀) * v₀ j₁) = v₀ j₀ * v₁ j₁ - v₀ j₁ * v₁ j₀
      rw [mul_sub, ← mul_assoc, mul_div_cancel₀ _ hj₀]
      ring
    rw [← hEq]
    exact mul_ne_zero hj₀ hj₁
  choose v₀_R hv₀_R using fun b => IsLocalRing.residue_surjective (v₀ b)
  choose v₁_R hv₁_R using fun b => IsLocalRing.residue_surjective (v₁ b)
  let Δ_R : R := v₀_R j₀ * v₁_R j₁ - v₀_R j₁ * v₁_R j₀
  have hΔ_not_max : Δ_R ∉ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.ker_residue, RingHom.mem_ker]
    show IsLocalRing.residue R (v₀_R j₀ * v₁_R j₁ - v₀_R j₁ * v₁_R j₀) ≠ 0
    simp only [map_sub, map_mul, hv₀_R, hv₁_R]
    exact hDet_k0
  obtain ⟨u_Δ, hu_Δ⟩ := IsLocalRing.notMem_maximalIdeal.mp hΔ_not_max
  let δ_inv : R := ↑(u_Δ⁻¹)
  have hδ_mul : δ_inv * Δ_R = 1 := by
    rw [← hu_Δ]
    exact Units.inv_mul u_Δ
  let e₁ : Fin (M + 1) ≃ Fin (M + 1) := Equiv.swap 0 j₀
  let σ : Fin (M + 1) ≃ Fin (M + 1) := (Equiv.swap L (e₁.symm j₁)).trans e₁
  have hσ0 : σ 0 = j₀ := by
    have h0_ne_symm : (0 : Fin (M + 1)) ≠ e₁.symm j₁ := by
      intro hEq
      have := congrArg e₁ hEq
      rw [Equiv.apply_symm_apply] at this
      have he1_0 : e₁ 0 = j₀ := Equiv.swap_apply_left 0 j₀
      exact hj10_ne (this.symm.trans he1_0)
    show e₁ (Equiv.swap L (e₁.symm j₁) 0) = j₀
    rw [Equiv.swap_apply_of_ne_of_ne h0_ne_L h0_ne_symm]
    exact Equiv.swap_apply_left 0 j₀
  have hσL : σ L = j₁ := by
    show e₁ (Equiv.swap L (e₁.symm j₁) L) = j₁
    rw [Equiv.swap_apply_left, Equiv.apply_symm_apply]
  let U : Matrix (Fin (M + 1)) (Fin (M + 1)) R :=
    Matrix.of fun i k =>
      if i = 0 then v₀_R (σ k)
      else if i = L then v₁_R (σ k)
      else if i = k then 1 else 0
  let a_R : R := v₀_R j₀
  let b_R : R := v₀_R j₁
  let c_R : R := v₁_R j₀
  let d_R : R := v₁_R j₁
  have hU00 : U 0 0 = a_R := by simp [U, a_R, hσ0]
  have hU0L : U 0 L = b_R := by simp [U, b_R, hσL]
  have hUL0 : U L 0 = c_R := by simp [U, c_R, h0_ne_L.symm, hσ0]
  have hULL : U L L = d_R := by simp [U, d_R, h0_ne_L.symm, hσL]
  let V : Matrix (Fin (M + 1)) (Fin (M + 1)) R :=
    Matrix.of fun i k =>
      if i = 0 then
        if k = 0 then δ_inv * d_R
        else if k = L then -(δ_inv * b_R)
        else -(δ_inv * d_R * U 0 k - δ_inv * b_R * U L k)
      else if i = L then
        if k = 0 then -(δ_inv * c_R)
        else if k = L then δ_inv * a_R
        else -(-(δ_inv * c_R) * U 0 k + δ_inv * a_R * U L k)
      else if i = k then 1 else 0
  have hSumSplit : ∀ f : Fin (M + 1) → R,
      (∑ m : Fin (M + 1), f m) =
        f 0 + f L + ∑ m ∈ (Finset.univ.erase 0).erase L, f m := by
    intro f
    have h0_mem : (0 : Fin (M + 1)) ∈ (Finset.univ : Finset (Fin (M + 1))) := Finset.mem_univ 0
    have hL_mem : L ∈ (Finset.univ.erase 0 : Finset (Fin (M + 1))) :=
      Finset.mem_erase.mpr ⟨h0_ne_L.symm, Finset.mem_univ L⟩
    rw [← Finset.add_sum_erase _ f h0_mem, ← Finset.add_sum_erase _ f hL_mem, add_assoc]
  have hUV : U * V = 1 := by
    ext i k
    rw [Matrix.mul_apply, hSumSplit, Matrix.one_apply]
    by_cases hi0 : i = 0
    · subst hi0
      by_cases hk0 : k = 0
      · subst hk0
        have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, U 0 m * V m 0) = 0 := by
          refine Finset.sum_eq_zero fun m hm => ?_
          have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
          have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
          simp [V, hm0, hmL]
        rw [hRest, add_zero, hU00, hU0L]
        simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L.symm]
        calc
          a_R * (δ_inv * d_R) + b_R * -(δ_inv * c_R)
            = δ_inv * Δ_R := by dsimp [Δ_R, a_R, b_R, c_R, d_R]; ring
          _ = 1 := hδ_mul
      · by_cases hkL : k = L
        · subst hkL
          have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, U 0 m * V m L) = 0 := by
            refine Finset.sum_eq_zero fun m hm => ?_
            have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
            have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
            simp [V, hm0, hmL]
          rw [hRest, add_zero, hU00, hU0L]
          simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L, h0_ne_L.symm]
          ring
        · have hk_mem : k ∈ (Finset.univ.erase 0).erase L :=
            Finset.mem_erase.mpr ⟨hkL, Finset.mem_erase.mpr ⟨hk0, Finset.mem_univ k⟩⟩
          have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, U 0 m * V m k) = U 0 k := by
            rw [Finset.sum_eq_single k]
            · simp [V, hk0, hkL]
            · intro m hm hmk
              have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
              have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
              simp [V, hm0, hmL, hmk]
            · intro hk_abs
              exact False.elim (hk_abs hk_mem)
          rw [hRest, hU00, hU0L]
          have h0k : (0 : Fin (M + 1)) ≠ k := Ne.symm hk0
          simp only [V, Matrix.of_apply, ↓reduceIte, hk0, hkL, h0_ne_L.symm, h0k]
          calc
            a_R * -(δ_inv * d_R * U 0 k - δ_inv * b_R * U L k) +
                b_R * -(-(δ_inv * c_R) * U 0 k + δ_inv * a_R * U L k) + U 0 k
              = (1 - δ_inv * Δ_R) * U 0 k := by dsimp [Δ_R, a_R, b_R, c_R, d_R]; ring
            _ = 0 := by rw [hδ_mul, sub_self, zero_mul]
    · by_cases hiL : i = L
      · subst hiL
        by_cases hk0 : k = 0
        · subst hk0
          have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, U L m * V m 0) = 0 := by
            refine Finset.sum_eq_zero fun m hm => ?_
            have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
            have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
            simp [V, hm0, hmL]
          rw [hRest, add_zero, hUL0, hULL]
          simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L.symm]
          ring
        · by_cases hkL : k = L
          · subst hkL
            have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, U L m * V m L) = 0 := by
              refine Finset.sum_eq_zero fun m hm => ?_
              have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
              have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
              simp [V, hm0, hmL]
            rw [hRest, add_zero, hUL0, hULL]
            simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L.symm]
            calc
              c_R * -(δ_inv * b_R) + d_R * (δ_inv * a_R)
                = δ_inv * Δ_R := by dsimp [Δ_R, a_R, b_R, c_R, d_R]; ring
              _ = 1 := hδ_mul
          · have hk_mem : k ∈ (Finset.univ.erase 0).erase L :=
              Finset.mem_erase.mpr ⟨hkL, Finset.mem_erase.mpr ⟨hk0, Finset.mem_univ k⟩⟩
            have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, U L m * V m k) = U L k := by
              rw [Finset.sum_eq_single k]
              · simp [V, hk0, hkL]
              · intro m hm hmk
                have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
                have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
                simp [V, hm0, hmL, hmk]
              · intro hk_abs
                exact False.elim (hk_abs hk_mem)
            rw [hRest, hUL0, hULL]
            have hLk : L ≠ k := Ne.symm hkL
            simp only [V, Matrix.of_apply, ↓reduceIte, hk0, hkL, h0_ne_L.symm, hLk]
            calc
              c_R * -(δ_inv * d_R * U 0 k - δ_inv * b_R * U L k) +
                  d_R * -(-(δ_inv * c_R) * U 0 k + δ_inv * a_R * U L k) + U L k
                = (1 - δ_inv * Δ_R) * U L k := by dsimp [Δ_R, a_R, b_R, c_R, d_R]; ring
              _ = 0 := by rw [hδ_mul, sub_self, zero_mul]
      · have hi_mem : i ∈ (Finset.univ.erase 0).erase L :=
          Finset.mem_erase.mpr ⟨hiL, Finset.mem_erase.mpr ⟨hi0, Finset.mem_univ i⟩⟩
        have hUi0 : U i 0 = 0 := by simp [U, hi0, hiL]
        have hUiL : U i L = 0 := by simp [U, hi0, hiL]
        have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, U i m * V m k) =
            if i = k then 1 else 0 := by
          rw [Finset.sum_eq_single i]
          · simp [U, V, hi0, hiL]
          · intro m _ hmi
            have him : i ≠ m := hmi.symm
            simp [U, hi0, hiL, him]
          · intro hi_abs
            exact False.elim (hi_abs hi_mem)
        rw [hUi0, hUiL, zero_mul, zero_mul, add_zero, zero_add, hRest]
  have hVU : V * U = 1 := by
    ext i k
    rw [Matrix.mul_apply, hSumSplit, Matrix.one_apply]
    by_cases hi0 : i = 0
    · subst hi0
      by_cases hk0 : k = 0
      · subst hk0
        have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, V 0 m * U m 0) = 0 := by
          refine Finset.sum_eq_zero fun m hm => ?_
          have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
          have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
          simp [U, hm0, hmL]
        rw [hRest, add_zero, hU00, hUL0]
        simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L.symm]
        calc
          δ_inv * d_R * a_R + -(δ_inv * b_R) * c_R
            = δ_inv * Δ_R := by dsimp [Δ_R, a_R, b_R, c_R, d_R]; ring
          _ = 1 := hδ_mul
      · by_cases hkL : k = L
        · subst hkL
          have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, V 0 m * U m L) = 0 := by
            refine Finset.sum_eq_zero fun m hm => ?_
            have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
            have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
            simp [U, hm0, hmL]
          rw [hRest, add_zero, hU0L, hULL]
          simp only [V, Matrix.of_apply, ↓reduceIte, h0_ne_L, h0_ne_L.symm]
          ring
        · have hk_mem : k ∈ (Finset.univ.erase 0).erase L :=
            Finset.mem_erase.mpr ⟨hkL, Finset.mem_erase.mpr ⟨hk0, Finset.mem_univ k⟩⟩
          have hRest : (∑ m ∈ (Finset.univ.erase 0).erase L, V 0 m * U m k) = V 0 k := by
            rw [Finset.sum_eq_single k]
            · simp [U, hk0, hkL]
            · intro m hm hmk
              have hmL : m ≠ L := (Finset.mem_erase.mp hm).1
              have hm0 : m ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hm).2).1
