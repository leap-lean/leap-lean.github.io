        (by simpa using hY'_P_ne)
      rcases hInter with ⟨x, _, hx_inter⟩
      exact hEmpty ⟨x, hx_inter⟩
    have _ : Finite ↥Δ := hΔ_fin.to_subtype
    have _ : Finite ↥Δ_P := Finite.of_injective f_sp hf_sp_inj
    have hΔ_P_fin : Δ_P.Finite := Set.toFinite Δ_P
    have hΔ_P_ge1 : 1 ≤ Δ_P.ncard :=
      Nat.succ_le_of_lt ((Set.ncard_pos hΔ_P_fin).mpr hΔ_P_ne)
    have hΔ_P_le2 : Δ_P.ncard ≤ 2 := by
      calc
        Δ_P.ncard = Nat.card ↥Δ_P := (Nat.card_coe_set_eq Δ_P).symm
        _ ≤ Nat.card ↥Δ := Nat.card_le_card_of_injective f_sp hf_sp_inj
        _ = Δ.ncard := Nat.card_coe_set_eq Δ
        _ ≤ 2 := hΔ_le2
    exact ⟨E_star, hE_comp, hE_sub, hE'_not_sub, hW₀_inter_Y'_P, hΔ_P_ge1, hΔ_P_le2⟩
  · left
    intro E hE hSub
    exact hCaseB ⟨E, hE, hSub⟩

theorem weil_sup1_geom_fibers_pinch_and_component_drop (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (C_K : AlgebraicGeometry.Scheme.{u})
    (p_K : C_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K))
    (n : ℕ)
    (σ_K : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_K))
    (hIntCK : AlgebraicGeometry.IsIntegral C_K)
    (hPropCK : AlgebraicGeometry.IsProper p_K)
    (hSmCK : AlgebraicGeometry.SmoothOfRelativeDimension 1 p_K)
    (hStabCK : IsGeometricStablePointedCurve p_K n σ_K)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
    (τ : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of ↥V) ⟶ C))
    (ι : C_K ⟶ C)
    (hSemi : IsSemistableValuationPointedModel V p_K n σ_K C g τ ι)
    (Z : Set ↥(CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField)))))
    (Z_sch : AlgebraicGeometry.Scheme.{u})
    (ιZ : Z_sch ⟶ CategoryTheory.Limits.pullback g
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))))
    (hUnstab : IsClosedFiberUnstableP1Datum V g n τ Z Z_sch ιZ)
    (V₀ V₁ : C.Opens)
    (h₀ eZ eY : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hPencil : IsUnstableP1HenselianPencil V g n τ Z V₀ V₁ h₀ eZ eY t₀)
    (N' : ℕ)
    (φ : C ⟶ (weilProjectiveSpaceOver ↥V N').left)
    (hProjMap : IsUnstableP1ContractionProjMap V g Z V₀ V₁ eZ N' φ) :
    let s₀ : AlgebraicGeometry.Spec (CommRingCat.of (IsLocalRing.maximalIdeal ↥V).ResidueField) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap ↥V (IsLocalRing.maximalIdeal ↥V).ResidueField))
    let C_next : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.image φ
    let g_next : C_next ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V) :=
      AlgebraicGeometry.Scheme.Hom.imageι φ ≫ (weilProjectiveSpaceOver ↥V N').hom
    (∀ (K' : Type u) [Field K'] [IsAlgClosed K']
        (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶
          AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback g_next s) ∧
      ∀ y : ↥(CategoryTheory.Limits.pullback g_next s),
        (∃ V_sm : (CategoryTheory.Limits.pullback g_next s).Opens,
          y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
            (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_next s)) ∨
        (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
            (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_next s)
            (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) K' ⧸ Ideal.span
                {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
                  (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y ∧
          (∀ i : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K') ∈
              (e₂.base u₀).asIdeal) ∧
          e₁ ≫ CategoryTheory.Limits.pullback.snd g_next s =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
                (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K')))) ∨
        HasTwoPointPinchAt K' (CategoryTheory.Limits.pullback.snd g_next s) y) ∧
    Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g_next s₀)) <
      Nat.card ↥(irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀)) :=
by
  classical
  intro s₀ C_next g_next
  
  have hPropGen : ∀ (R : Type u) [CommRing R] (N : ℕ),
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver R N).hom := by
    intro R _ N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have halg0 : ∀ r : R,
        (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r := by
      intro r
      rw [Algebra.algebraMap_eq_smul_one]
      change r • (1 : MvPolynomial (Fin (N + 1)) R) = MvPolynomial.C r
      rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
    have hinj : Function.Injective (algebraMap R ↥(𝒜 0)) := by
      intro r₁ r₂ h
      have h1 : (algebraMap R ↥(𝒜 0) r₁ : MvPolynomial (Fin (N + 1)) R) =
          (algebraMap R ↥(𝒜 0) r₂ : MvPolynomial (Fin (N + 1)) R) := congrArg Subtype.val h
      rw [halg0, halg0] at h1
      simpa using congrArg MvPolynomial.constantCoeff h1
    have hsurj : Function.Surjective (algebraMap R ↥(𝒜 0)) := by
      intro p
      refine ⟨p.1.coeff 0, Subtype.ext ?_⟩
      rw [halg0]
      ext μ
      by_cases hμ : μ = 0
      · subst hμ
        simp
      · rw [MvPolynomial.coeff_C]
        simp only [Ne.symm hμ, ↓reduceIte]
        symm
        by_contra hne
        have hp : p.1.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 p.1).mp p.2
        have hdeg := hp hne
        simp only [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, Pi.one_apply, mul_one] at hdeg
        have hne' : ∃ i : Fin (N + 1), μ i ≠ 0 := by
          by_contra hall
          exact hμ (Finsupp.ext fun i => Classical.not_not.mp fun h => hall ⟨i, h⟩)
        rcases hne' with ⟨i, hi⟩
        exact hi ((Finset.sum_eq_zero_iff.mp hdeg) i (Finsupp.mem_support_iff.mpr hi))
    have _ : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))).mpr
        ⟨hinj, hsurj⟩
    have _ : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0)))) :=
      inferInstance
    let _ : IsScalarTower R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      IsScalarTower.of_algebraMap_eq' (R := R) (S := ↥(𝒜 0))
        (A := MvPolynomial (Fin (N + 1)) R) (RingHom.ext fun r => by
          change algebraMap R (MvPolynomial (Fin (N + 1)) R) r =
            (algebraMap R ↥(𝒜 0) r : MvPolynomial (Fin (N + 1)) R)
          rw [halg0, MvPolynomial.algebraMap_eq])
    have _ : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) R)
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R ↥(𝒜 0))))
    infer_instance
  have hPropP_next : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver ↥V N').hom :=
    hPropGen ↥V N'
  have hProp_next : AlgebraicGeometry.IsProper g_next := by
    dsimp only [g_next]
    infer_instance
  let q_img : C ⟶ C_next := AlgebraicGeometry.Scheme.Hom.toImage φ
  have hq_img_g : q_img ≫ g_next = g := by
    dsimp only [q_img, g_next]
    rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.toImage_imageι φ, hProjMap.1]
  have hPropG : AlgebraicGeometry.IsProper g := hSemi.1.2.2.1
  have hProp_q_img : AlgebraicGeometry.IsProper q_img := by
    have _ : AlgebraicGeometry.IsProper (q_img ≫ g_next) := by
      rw [hq_img_g]
      exact hPropG
    exact AlgebraicGeometry.IsProper.of_comp q_img g_next
  have _ : AlgebraicGeometry.QuasiCompact φ := by
    have _ : AlgebraicGeometry.QuasiCompact (φ ≫ (weilProjectiveSpaceOver ↥V N').hom) := by
      rw [hProjMap.1]
      infer_instance
    exact AlgebraicGeometry.QuasiCompact.of_comp φ (weilProjectiveSpaceOver ↥V N').hom
  have hSurj_q_img : AlgebraicGeometry.Surjective q_img := by
    refine ⟨?_⟩
    rw [← Set.range_eq_univ, ← q_img.isClosedMap.isClosed_range.closure_eq]
    exact (AlgebraicGeometry.IsDominant.denseRange (f := q_img)).closure_range
  
  let q_fib : ∀ {F' : Type u} [Field F']
      (s : AlgebraicGeometry.Spec (CommRingCat.of F') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      CategoryTheory.Limits.pullback g s ⟶ CategoryTheory.Limits.pullback g_next s :=
    fun {_} [_] s =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g s ≫ q_img)
        (CategoryTheory.Limits.pullback.snd g s)
        (by rw [CategoryTheory.Category.assoc, hq_img_g, CategoryTheory.Limits.pullback.condition])
  have hq_fib_fst : ∀ {F' : Type u} [Field F']
      (s : AlgebraicGeometry.Spec (CommRingCat.of F') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      q_fib s ≫ CategoryTheory.Limits.pullback.fst g_next s =
        CategoryTheory.Limits.pullback.fst g s ≫ q_img :=
    fun {_} [_] _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq_fib_snd : ∀ {F' : Type u} [Field F']
      (s : AlgebraicGeometry.Spec (CommRingCat.of F') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      q_fib s ≫ CategoryTheory.Limits.pullback.snd g_next s =
        CategoryTheory.Limits.pullback.snd g s :=
    fun {_} [_] _ => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hq_fib_pb : ∀ {F' : Type u} [Field F']
      (s : AlgebraicGeometry.Spec (CommRingCat.of F') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g s)
        (q_fib s)
        q_img
        (CategoryTheory.Limits.pullback.fst g_next s) := by
    intro F' _ s
    refine CategoryTheory.IsPullback.of_bot ?_ (hq_fib_fst s).symm
      (CategoryTheory.IsPullback.of_hasPullback g_next s)
    rw [hq_fib_snd s, hq_img_g]
    exact CategoryTheory.IsPullback.of_hasPullback g s
  have hq_fib_proper : ∀ {F' : Type u} [Field F']
      (s : AlgebraicGeometry.Spec (CommRingCat.of F') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      AlgebraicGeometry.IsProper (q_fib s) :=
    fun {_} [_] s =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hq_fib_pb s) hProp_q_img
  have hq_fib_surj : ∀ {F' : Type u} [Field F']
      (s : AlgebraicGeometry.Spec (CommRingCat.of F') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      AlgebraicGeometry.Surjective (q_fib s) :=
    fun {_} [_] s =>
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hq_fib_pb s) hSurj_q_img
  have hConn_next : ∀ (K' : Type u) [Field K'] [IsAlgClosed K']
      (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V)),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback g_next s) := by
    intro K' _ _ s
    have _ : ConnectedSpace ↥(CategoryTheory.Limits.pullback g s) := (hSemi.2.2.2 K' s).1
    have _ : AlgebraicGeometry.Surjective (q_fib s) := hq_fib_surj s
    exact (q_fib s).surjective.connectedSpace (q_fib s).continuous
  
  have hTransferOpenIso : ∀ (K' : Type u) [Field K'] [IsAlgClosed K']
      (s : AlgebraicGeometry.Spec (CommRingCat.of K') ⟶ AlgebraicGeometry.Spec (CommRingCat.of ↥V))
      (U : (CategoryTheory.Limits.pullback g_next s).Opens),
      CategoryTheory.IsIso ((q_fib s) ∣_ U) →
      ∀ y : ↥(CategoryTheory.Limits.pullback g_next s),
        y ∈ U →
        (∃ V_sm : (CategoryTheory.Limits.pullback g_next s).Opens,
          y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
            (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g_next s)) ∨
        (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
            (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_next s)
            (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
              (MvPolynomial (Fin 2) K' ⧸ Ideal.span
                {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
                  (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')}))),
          AlgebraicGeometry.Etale e₁ ∧
          AlgebraicGeometry.Etale e₂ ∧
          e₁.base u₀ = y ∧
          (∀ i : Fin 2,
            Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) K') ∈
              (e₂.base u₀).asIdeal) ∧
          e₁ ≫ CategoryTheory.Limits.pullback.snd g_next s =
            e₂ ≫ AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
                (MvPolynomial.C : K' →+* MvPolynomial (Fin 2) K')))) ∨
        HasTwoPointPinchAt K' (CategoryTheory.Limits.pullback.snd g_next s) y := by
    intro K' _ _ s U hIsoU y hy
    let W : (CategoryTheory.Limits.pullback g s).Opens :=
      (TopologicalSpace.Opens.map (q_fib s).base).obj U
    let f_U : W.toScheme ⟶ U.toScheme := (q_fib s) ∣_ U
    have _ : CategoryTheory.IsIso f_U := hIsoU
    let f_U_inv : U.toScheme ⟶ W.toScheme := CategoryTheory.inv f_U
    have hf_U_snd : f_U ≫ U.ι ≫ CategoryTheory.Limits.pullback.snd g_next s =
        W.ι ≫ CategoryTheory.Limits.pullback.snd g s := by
      rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        CategoryTheory.Category.assoc, hq_fib_snd s]
    have he_U_snd : U.ι ≫ CategoryTheory.Limits.pullback.snd g_next s =
        f_U_inv ≫ W.ι ≫ CategoryTheory.Limits.pullback.snd g s := by
      dsimp only [f_U_inv]
      rw [CategoryTheory.IsIso.eq_inv_comp]
      exact hf_U_snd
    let x : ↥(CategoryTheory.Limits.pullback g s) := W.ι.base (f_U_inv.base ⟨y, hy⟩)
    rcases (hSemi.2.2.2 K' s).2 x with ⟨V_sm, hx_Vsm, hSm_V⟩ | ⟨U', u₀, e₁, e₂, hEt₁, hEt₂, hu₀_x, hXi, he_comm⟩
    · left
      let j_UW : U.toScheme ⟶ CategoryTheory.Limits.pullback g s := f_U_inv ≫ W.ι
      let U_sm : U.toScheme.Opens := (TopologicalSpace.Opens.map j_UW.base).obj V_sm
      have hy_Usm : (⟨y, hy⟩ : ↥U.toScheme) ∈ U_sm := hx_Vsm
      let V_next : (CategoryTheory.Limits.pullback g_next s).Opens := (U_sm.ι ≫ U.ι).opensRange
      have hy_Vnext : y ∈ V_next := ⟨⟨⟨y, hy⟩, hy_Usm⟩, rfl⟩
      let isoV : V_next.toScheme ≅ U_sm.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq V_next.ι (U_sm.ι ≫ U.ι) (by simp [V_next])
      have hisoV_ι : isoV.hom ≫ U_sm.ι ≫ U.ι = V_next.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac V_next.ι (U_sm.ι ≫ U.ι) _
      let j_sm : V_next.toScheme ⟶ V_sm.toScheme := isoV.hom ≫ (j_UW ∣_ V_sm)
      have hj_sm_snd : V_next.ι ≫ CategoryTheory.Limits.pullback.snd g_next s =
          j_sm ≫ (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g s) := by
        rw [← hisoV_ι, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, he_U_snd]
        dsimp only [j_sm, j_UW]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (j_UW ∣_ V_sm),
          AlgebraicGeometry.morphismRestrict_ι, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc]
      have _ : AlgebraicGeometry.IsOpenImmersion j_sm := inferInstance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 j_sm := inferInstance
      refine ⟨V_next, hy_Vnext, ?_⟩
      rw [hj_sm_snd]
      simpa using AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1 j_sm
        (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g s)
    · right
      left
      let U'_W : U'.Opens := (TopologicalSpace.Opens.map e₁.base).obj W
      have hu₀_W : u₀ ∈ U'_W := by
        change e₁.base u₀ ∈ W
        rw [hu₀_x]
        exact (f_U_inv.base ⟨y, hy⟩).2
      let e₁_next : U'_W.toScheme ⟶ CategoryTheory.Limits.pullback g_next s :=
        (e₁ ∣_ W) ≫ f_U ≫ U.ι
      let e₂_next : U'_W.toScheme ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) K' ⧸ Ideal.span
            {(MvPolynomial.X 0 : MvPolynomial (Fin 2) K') *
              (MvPolynomial.X 1 : MvPolynomial (Fin 2) K')})) :=
        U'_W.ι ≫ e₂
      have _ : AlgebraicGeometry.Etale (e₁ ∣_ W) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (AlgebraicGeometry.isPullback_morphismRestrict e₁ W).flip hEt₁
      refine ⟨U'_W.toScheme, ⟨u₀, hu₀_W⟩, e₁_next, e₂_next, inferInstance, inferInstance, ?_, ?_, ?_⟩
      · have hW_eq : W.ι.base ((e₁ ∣_ W).base ⟨u₀, hu₀_W⟩) = W.ι.base (f_U_inv.base ⟨y, hy⟩) := by
          have h1 := congrArg (fun h => h.base ⟨u₀, hu₀_W⟩) (AlgebraicGeometry.morphismRestrict_ι e₁ W)
          change W.ι.base ((e₁ ∣_ W).base ⟨u₀, hu₀_W⟩) = e₁.base u₀ at h1
          exact h1.trans hu₀_x
        have h_sub_eq : (e₁ ∣_ W).base ⟨u₀, hu₀_W⟩ = f_U_inv.base ⟨y, hy⟩ :=
          W.ι.isOpenEmbedding.injective hW_eq
        have hf_eq : f_U.base ((e₁ ∣_ W).base ⟨u₀, hu₀_W⟩) = ⟨y, hy⟩ := by
          rw [h_sub_eq]
          change (f_U_inv ≫ f_U).base ⟨y, hy⟩ = ⟨y, hy⟩
          have h_inv : f_U_inv ≫ f_U = 𝟙 U.toScheme := CategoryTheory.IsIso.inv_hom_id f_U
          rw [h_inv]
          rfl
        change U.ι.base (f_U.base ((e₁ ∣_ W).base ⟨u₀, hu₀_W⟩)) = y
        rw [hf_eq]
        rfl
      · intro i
        exact hXi i
      · dsimp only [e₁_next, e₂_next]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hf_U_snd,
          ← CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          CategoryTheory.Category.assoc, he_comm, CategoryTheory.Category.assoc]
  
  let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
  have hAlg_k₀ : IsAlgClosed k₀ :=
    hPkg.2.2.2.2.1 (IsLocalRing.maximalIdeal ↥V) hMaxNeBot
  let Y := CategoryTheory.Limits.pullback g s₀
  let Y_next := CategoryTheory.Limits.pullback g_next s₀
  let W₀_s₀ : Y.Opens :=
    (TopologicalSpace.Opens.map (CategoryTheory.Limits.pullback.fst g s₀).base).obj
      (V₁ ⊔ C.basicOpen eZ)
  let Y'_set : Set ↥Y := ⋃ E' ∈ (irreducibleComponents ↥Y) \ {Z}, E'
  have hZ_comp : Z ∈ irreducibleComponents ↥Y := hUnstab.1
  have hΔ_ge1 : 1 ≤ (Z ∩ Y'_set).ncard := hUnstab.2.2.2.2.2.2.2.2.2.1
  have hΔ_le2 : (Z ∩ Y'_set).ncard ≤ 2 := hUnstab.2.2.2.2.2.2.2.2.2.2.1
  have hZ_sub_W₀ : Z ⊆ (W₀_s₀ : Set ↥Y) :=
    hPencil.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
