theorem weil_henselian_valuationRing_etale_nodal_lift (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [HenselianLocalRing R]
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat g_R)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g_R)
    (y₀ : ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hNode₀ : ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸
            Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1}))),
      AlgebraicGeometry.Etale e₁ ∧
      AlgebraicGeometry.Etale e₂ ∧
      e₁.base u₀ = y₀ ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e₂.base u₀).asIdeal) ∧
      e₁ ≫ CategoryTheory.Limits.pullback.snd g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))) :
    ∃ (W' : AlgebraicGeometry.Scheme.{u}) (w₀ : W')
      (δ : R)
      (e_C : W' ⟶ C_R)
      (e_nod : W' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
        (MvPolynomial (Fin 2) R ⧸
          Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C δ}))),
      δ ∈ IsLocalRing.maximalIdeal R ∧
      AlgebraicGeometry.Etale e_C ∧
      AlgebraicGeometry.Etale e_nod ∧
      e_C.base w₀ = (CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ ∧
      (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i) ∈ (e_nod.base w₀).asIdeal) ∧
      (∀ m ∈ IsLocalRing.maximalIdeal R,
        Ideal.Quotient.mk _ (MvPolynomial.C m) ∈ (e_nod.base w₀).asIdeal) ∧
      e_C ≫ g_R =
        e_nod ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) :=
by
  obtain ⟨A_R, instCommA, instAlgA, ι_C, p_A, B_bar, instCommB, ψ₁, ψ₂, ε₀,
      hOpen_ιC, hComm_ιC, hp_A, hFlat_A, hFP_A, hEt₁, hEt₂, hCompat, hAug, hX₀, hComap_pA⟩ :=
    weil_closed_fiber_etale_nodal_roof_to_affine_algebra R hAlgRes C_R g_R hFlat hLFP y₀ hNode₀
  let _ : CommRing A_R := instCommA
  let _ : Algebra R A_R := instAlgA
  have _ : Module.Flat R A_R := hFlat_A
  have _ : Algebra.FinitePresentation R A_R := hFP_A
  let _ : CommRing B_bar := instCommB
  obtain ⟨S_R, instCommS, instAlgS, φ_X, σ_bar, F, σ_bar_quot, α_A,
      hEtX, hσR, hσX, hF_mod, hEt_αA, hαA_R, hσ_quot_mk, hσ_quot_αA⟩ :=
    weil_valuationRing_etale_nodal_roof_hypersurface_lift R A_R B_bar ψ₁ ψ₂ ε₀
      hEt₁ hEt₂ hCompat hAug hX₀
  let _ : CommRing S_R := instCommS
  let _ : Algebra R S_R := instAlgS
  obtain ⟨S₄, instCommS₄, instAlgS₄, ι₄, ι₄_quot, φ_X', σ_bar₄, δ, A₀₀, A₀₁, A₁₁,
      hEt_ι₄q, hι₄q_mk, hEtX', hσ₄_ι₄, hσ₄R, hσ₄X, hδ, hQuad, hA₀₀, hA₀₁, hA₁₁⟩ :=
    weil_henselian_etale_plane_critical_quadratic_normal_form R
      (fun E_R _ _ _ σ_E h => weil_henselianLocalRing_etale_residue_section R E_R σ_E h)
      S_R φ_X hEtX σ_bar hσR hσX F hF_mod
