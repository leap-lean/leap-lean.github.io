      intro a b
      refine Fin.cases ?_ (fun a' => Fin.cases ?_ (fun k => Fin.elim0 k) a') a
      · refine Fin.cases ?_ (fun b' => Fin.cases ?_ (fun k => Fin.elim0 k) b') b
