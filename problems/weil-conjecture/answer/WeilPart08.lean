        have _ : Algebra.HasGoingDown A_nod C' := Algebra.HasGoingDown.of_flat
        have _ : v₀.asIdeal.LiesOver 𝔭₀ := ⟨rfl⟩
        obtain ⟨v₁, hv₁_lt, hv₁_prime, _⟩ :=
