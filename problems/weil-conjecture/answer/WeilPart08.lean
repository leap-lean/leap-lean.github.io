    have hτ₃_1 : q_31.comp τ₃ = τ₁ := by
      let q_21 : (P_k ⧸ I_deg 2) →ₐ[P] (P_k ⧸ I_deg 1) :=
        Ideal.Quotient.liftₐ (I_deg 2) (Ideal.Quotient.mkₐ P (I_deg 1))
          (fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr (hI_anti (by omega) hz))
      let q_32 : (P_k ⧸ I_deg 3) →ₐ[P] (P_k ⧸ I_deg 2) :=
        Ideal.Quotient.liftₐ (I_deg 3) (Ideal.Quotient.mkₐ P (I_deg 2))
          (fun z hz => Ideal.Quotient.eq_zero_iff_mem.mpr (hI_anti (by omega) hz))
      have hq_comp : q_21.comp q_32 = q_31 := by
        apply Ideal.Quotient.algHom_ext; ext f; rfl
      rw [← hq_comp, AlgHom.comp_assoc, hτ₃, hτ₂]
    let mk₃ : P_k →+* P_k ⧸ I_deg 3 := Ideal.Quotient.mk (I_deg 3)
    have hτ₃_X : ∀ i : Fin 2, τ₃ (φ (MvPolynomial.X i)) = mk₃ (MvPolynomial.X i) := fun i => by
      have h := τ₃.commutes (MvPolynomial.X i)
      change τ₃ (φ (MvPolynomial.X i)) = mk₃ (MvPolynomial.map π_R (MvPolynomial.X i)) at h
      rwa [MvPolynomial.map_X] at h
    have hτ₃_mR : ∀ y ∈ Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R), τ₃ y = 0 := by
      have hle : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) ≤
          RingHom.ker τ₃.toRingHom := by
        rw [Ideal.map_le_iff_le_comap]
        intro m hm
        have hm0 : π_R m = 0 :=
          (IsLocalRing.ker_residue (R := R) ▸ hm : m ∈ RingHom.ker (IsLocalRing.residue R))
        have h1 : algebraMap R S m = φ (MvPolynomial.C m) := by
          rw [← MvPolynomial.algebraMap_eq]; exact (φ.commutes m).symm
        change τ₃ (algebraMap R S m) = 0
        rw [h1]
        have h2 := τ₃.commutes (MvPolynomial.C m)
        change τ₃ (φ (MvPolynomial.C m)) = mk₃ (MvPolynomial.map π_R (MvPolynomial.C m)) at h2
        rw [h2, MvPolynomial.map_C, hm0, map_zero, map_zero]
      intro y hy; exact hle hy
    have hτ₃_term : ∀ (a : S) (r s : Fin 2),
        τ₃ a * mk₃ (MvPolynomial.X r) * mk₃ (MvPolynomial.X s) =
          mk₃ (MvPolynomial.C (σ_bar_S a) * MvPolynomial.X r * MvPolynomial.X s) := by
      intro a r s
      obtain ⟨Pa, hPa⟩ := Ideal.Quotient.mk_surjective (τ₃ a)
      have hPa_I1 : Pa - MvPolynomial.C (σ_bar_S a) ∈ I_deg 1 := by
        have h1 : q_31 (mk₃ Pa) = τ₁ a := by
          change q_31 (Ideal.Quotient.mk (I_deg 3) Pa) = τ₁ a
          rw [hPa]; exact AlgHom.congr_fun hτ₃_1 a
        change Ideal.Quotient.mk (I_deg 1) Pa =
          Ideal.Quotient.mk (I_deg 1) (MvPolynomial.C (σ_bar_S a)) at h1
        exact Ideal.Quotient.eq.mp h1
      have hprod_I3 : (Pa - MvPolynomial.C (σ_bar_S a)) * MvPolynomial.X r * MvPolynomial.X s ∈
          I_deg 3 := by
        have h12 : (Pa - MvPolynomial.C (σ_bar_S a)) * MvPolynomial.X r ∈ I_deg 2 :=
          hI_mul 1 1 (Ideal.mul_mem_mul hPa_I1 (hX_mem_I1 r))
        exact hI_mul 2 1 (Ideal.mul_mem_mul h12 (hX_mem_I1 s))
      calc
        τ₃ a * mk₃ (MvPolynomial.X r) * mk₃ (MvPolynomial.X s) =
            mk₃ (Pa * MvPolynomial.X r * MvPolynomial.X s) := by
          dsimp [mk₃]; rw [← hPa, map_mul, map_mul]
        _ = mk₃ (MvPolynomial.C (σ_bar_S a) * MvPolynomial.X r * MvPolynomial.X s) := by
          rw [Ideal.Quotient.eq]; simpa [sub_mul] using hprod_I3
    have hMod3 :
        mk₃ (MvPolynomial.C (σ_bar_S A₀₀) * (MvPolynomial.X 0) ^ 2 +
          MvPolynomial.C (σ_bar_S A₀₁) * MvPolynomial.X 0 * MvPolynomial.X 1 +
          MvPolynomial.C (σ_bar_S A₁₁) * (MvPolynomial.X 1) ^ 2) =
        mk₃ (MvPolynomial.X 0 * MvPolynomial.X 1) := by
      have h0 := hτ₃_mR _ hQuad_mod
      rw [map_sub, sub_eq_zero] at h0
      have hRHS : τ₃ (φ (MvPolynomial.X 0 * MvPolynomial.X 1)) =
          mk₃ (MvPolynomial.X 0 * MvPolynomial.X 1) := by
        rw [map_mul, map_mul, hτ₃_X 0, hτ₃_X 1, map_mul]
      rw [hRHS] at h0
      rw [← h0]
      simp only [map_add, map_mul, sq, hτ₃_X 0, hτ₃_X 1, ← mul_assoc]
      rw [hτ₃_term A₀₀ 0 0, hτ₃_term A₀₁ 0 1, hτ₃_term A₁₁ 1 1]
      simp only [map_mul, mul_assoc]
    let H : P_k :=
      MvPolynomial.C (σ_bar_S A₀₀) * (MvPolynomial.X 0) ^ 2 +
        MvPolynomial.C (σ_bar_S A₀₁ - 1) * (MvPolynomial.X 0 * MvPolynomial.X 1) +
        MvPolynomial.C (σ_bar_S A₁₁) * (MvPolynomial.X 1) ^ 2
    have hH_I3 : H ∈ I_deg 3 := by
      have hsub := Ideal.Quotient.eq.mp hMod3
      have heq : MvPolynomial.C (σ_bar_S A₀₀) * (MvPolynomial.X 0 : P_k) ^ 2 +
          MvPolynomial.C (σ_bar_S A₀₁) * MvPolynomial.X 0 * MvPolynomial.X 1 +
          MvPolynomial.C (σ_bar_S A₁₁) * (MvPolynomial.X 1) ^ 2 -
          MvPolynomial.X 0 * MvPolynomial.X 1 = H := by
        dsimp [H]; rw [map_sub, map_one]; ring
      rwa [← heq]
    let d20 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 0 1
    let d11 : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1
    let d02 : Fin 2 →₀ ℕ := Finsupp.single 1 1 + Finsupp.single 1 1
    have hH_mon : H =
        MvPolynomial.monomial d20 (σ_bar_S A₀₀) +
          MvPolynomial.monomial d11 (σ_bar_S A₀₁ - 1) +
          MvPolynomial.monomial d02 (σ_bar_S A₁₁) := by
      dsimp [H, d20, d11, d02]
      rw [sq, sq, hX_mon 0, hX_mon 1,
        MvPolynomial.monomial_mul_monomial, MvPolynomial.monomial_mul_monomial,
        MvPolynomial.monomial_mul_monomial, mul_one,
        MvPolynomial.C_mul_monomial, MvPolynomial.C_mul_monomial, MvPolynomial.C_mul_monomial,
        mul_one, mul_one, mul_one]
    have hd20_val : d20 0 = 2 ∧ d20 1 = 0 := by dsimp [d20]; constructor <;> simp
    have hd11_val : d11 0 = 1 ∧ d11 1 = 1 := by dsimp [d11]; constructor <;> simp
    have hd02_val : d02 0 = 0 ∧ d02 1 = 2 := by dsimp [d02]; constructor <;> simp
    have hne_11_20 : d11 ≠ d20 := fun h => by
      have h0 := congrArg (fun m : Fin 2 →₀ ℕ => m 0) h; rw [hd11_val.1, hd20_val.1] at h0; omega
    have hne_02_20 : d02 ≠ d20 := fun h => by
      have h0 := congrArg (fun m : Fin 2 →₀ ℕ => m 0) h; rw [hd02_val.1, hd20_val.1] at h0; omega
    have hne_02_11 : d02 ≠ d11 := fun h => by
      have h0 := congrArg (fun m : Fin 2 →₀ ℕ => m 0) h; rw [hd02_val.1, hd11_val.1] at h0; omega
    have hA00 : σ_bar_S A₀₀ = 0 := by
      have h0 : H.coeff d20 = 0 := hH_I3 d20 (by omega)
      rw [hH_mon, AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_add,
        Finsupp.add_apply, Finsupp.add_apply,
        MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial] at h0
      simp only [↓reduceIte, hne_11_20, hne_02_20, add_zero] at h0
      exact h0
    have hA01 : σ_bar_S A₀₁ = 1 := by
      have h0 : H.coeff d11 = 0 := hH_I3 d11 (by omega)
      rw [hH_mon, AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_add,
        Finsupp.add_apply, Finsupp.add_apply,
        MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial] at h0
      simp only [hne_11_20.symm, ↓reduceIte, hne_02_11, zero_add, add_zero] at h0
      exact sub_eq_zero.mp h0
    have hA11 : σ_bar_S A₁₁ = 0 := by
      have h0 : H.coeff d02 = 0 := hH_I3 d02 (by omega)
      rw [hH_mon, AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_add,
        Finsupp.add_apply, Finsupp.add_apply,
        MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial] at h0
      simp only [hne_02_20.symm, hne_02_11.symm, ↓reduceIte, zero_add] at h0
      exact h0
    exact ⟨hA00, hA01, hA11⟩
  obtain ⟨D, σ_crit, hD, hσ_crit_res, hDF⟩ := hStep1
  obtain ⟨S₄, instCommS₄, instAlgS₄, ι₄, ι₄_quot, φ_X', σ₄, A₀₀, A₀₁, A₁₁,
      hEt_quot, hq_mk, hEtX', hφX'_X, hσ₄_comp, hσ₄_X', hQuad_sub⟩ :=
    hStep2 D hD σ_crit hDF
  let _ : CommRing S₄ := instCommS₄
  let _ : Algebra R S₄ := instAlgS₄
  let σ_bar₄ : S₄ →+* IsLocalRing.ResidueField R :=
    (IsLocalRing.residue R).comp σ₄.toRingHom
  let δ : R := -σ_crit F
  have hσ₄_ι₄ : σ_bar₄.comp ι₄.toRingHom = σ_bar := by
    ext s
    change IsLocalRing.residue R ((σ₄.comp ι₄) s) = σ_bar s
    rw [hσ₄_comp]
    exact RingHom.congr_fun hσ_crit_res s
  have hσ₄R : σ_bar₄.comp (algebraMap R S₄) = IsLocalRing.residue R := by
    ext r
    change IsLocalRing.residue R (σ₄ (algebraMap R S₄ r)) = IsLocalRing.residue R r
    rw [σ₄.commutes]
    rfl
  have hσ₄X : ∀ i : Fin 2, σ_bar₄ (φ_X' (MvPolynomial.X i)) = 0 := fun i => by
    change IsLocalRing.residue R (σ₄ (φ_X' (MvPolynomial.X i))) = 0
    rw [hσ₄_X' i, map_zero]
  have hM_S_ker : ∀ {y : S_R},
      y ∈ Ideal.map (algebraMap R S_R) (IsLocalRing.maximalIdeal R) → σ_bar y = 0 := by
    have hle : Ideal.map (algebraMap R S_R) (IsLocalRing.maximalIdeal R) ≤ RingHom.ker σ_bar := by
      rw [Ideal.map_le_iff_le_comap]
      intro m hm
      change (σ_bar.comp (algebraMap R S_R)) m = 0
      rw [hσR]
      exact (IsLocalRing.ker_residue (R := R) ▸ hm : m ∈ RingHom.ker (IsLocalRing.residue R))
    intro y hy; exact hle hy
  have hσ_F : σ_bar F = 0 := by
    have h0 := hM_S_ker hF_mod
    rw [map_sub, map_mul, map_mul, hσX 0, hσX 1, zero_mul, sub_zero] at h0
    exact h0
  have hδ_mem : δ ∈ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.ker_residue]
    change IsLocalRing.residue R (-σ_crit F) = 0
    rw [map_neg]
    have h1 : IsLocalRing.residue R (σ_crit F) = σ_bar F :=
      RingHom.congr_fun hσ_crit_res F
    rw [h1, hσ_F, neg_zero]
  have hQuad : ι₄ F + algebraMap R S₄ δ =
      A₀₀ * (φ_X' (MvPolynomial.X 0)) ^ 2 +
        A₀₁ * (φ_X' (MvPolynomial.X 0)) * (φ_X' (MvPolynomial.X 1)) +
        A₁₁ * (φ_X' (MvPolynomial.X 1)) ^ 2 := by
    dsimp [δ]
    rw [map_neg, ← sub_eq_add_neg]
    exact hQuad_sub
  let c : Fin 2 → R := fun i => σ_crit (φ_X (MvPolynomial.X i))
  have hc_mem : ∀ i : Fin 2, c i ∈ IsLocalRing.maximalIdeal R := fun i => by
    rw [← IsLocalRing.ker_residue]
    change (IsLocalRing.residue R).comp σ_crit.toRingHom (φ_X (MvPolynomial.X i)) = 0
    rw [hσ_crit_res]
    exact hσX i
  have hι₄_X : ∀ i : Fin 2,
      ι₄ (φ_X (MvPolynomial.X i)) = φ_X' (MvPolynomial.X i) + algebraMap R S₄ (c i) := fun i => by
    rw [hφX'_X i, map_sub, ι₄.commutes]
    dsimp [c]
    ring
  let M₄ : Ideal S₄ := Ideal.map (algebraMap R S₄) (IsLocalRing.maximalIdeal R)
  have hι₄_Fmod : ι₄ (F - φ_X (MvPolynomial.X 0 * MvPolynomial.X 1)) ∈ M₄ := by
    have hmap : Ideal.map ι₄.toRingHom
        (Ideal.map (algebraMap R S_R) (IsLocalRing.maximalIdeal R)) ≤ M₄ := by
      rw [Ideal.map_map]
      have hcomp : ι₄.toRingHom.comp (algebraMap R S_R) = algebraMap R S₄ := by
        ext r; exact ι₄.commutes r
      rw [hcomp]
    exact hmap (Ideal.mem_map_of_mem ι₄.toRingHom hF_mod)
  have hQuad_mod :
      A₀₀ * (φ_X' (MvPolynomial.X 0)) ^ 2 +
        A₀₁ * (φ_X' (MvPolynomial.X 0)) * (φ_X' (MvPolynomial.X 1)) +
        A₁₁ * (φ_X' (MvPolynomial.X 1)) ^ 2 -
        φ_X' (MvPolynomial.X 0 * MvPolynomial.X 1) ∈ M₄ := by
    have hid : A₀₀ * (φ_X' (MvPolynomial.X 0)) ^ 2 +
        A₀₁ * (φ_X' (MvPolynomial.X 0)) * (φ_X' (MvPolynomial.X 1)) +
        A₁₁ * (φ_X' (MvPolynomial.X 1)) ^ 2 -
        φ_X' (MvPolynomial.X 0 * MvPolynomial.X 1) =
        ι₄ (F - φ_X (MvPolynomial.X 0 * MvPolynomial.X 1)) +
          algebraMap R S₄ δ +
          algebraMap R S₄ (c 0) * φ_X' (MvPolynomial.X 1) +
          algebraMap R S₄ (c 1) * φ_X' (MvPolynomial.X 0) +
          algebraMap R S₄ (c 0 * c 1) := by
      rw [← hQuad, map_sub, map_mul, map_mul, map_mul, hι₄_X 0, hι₄_X 1, map_mul]
      ring
    rw [hid]
    refine M₄.add_mem (M₄.add_mem (M₄.add_mem (M₄.add_mem hι₄_Fmod ?_) ?_) ?_) ?_
    · exact Ideal.mem_map_of_mem _ hδ_mem
    · exact M₄.mul_mem_right _ (Ideal.mem_map_of_mem _ (hc_mem 0))
    · exact M₄.mul_mem_right _ (Ideal.mem_map_of_mem _ (hc_mem 1))
    · exact Ideal.mem_map_of_mem _ ((IsLocalRing.maximalIdeal R).mul_mem_right _ (hc_mem 0))
  obtain ⟨hA00, hA01, hA11⟩ :=
    hStep3 S₄ φ_X' hEtX' σ_bar₄ hσ₄R hσ₄X A₀₀ A₀₁ A₁₁ hQuad_mod
  exact ⟨S₄, instCommS₄, instAlgS₄, ι₄, ι₄_quot, φ_X', σ_bar₄, δ, A₀₀, A₀₁, A₁₁,
    hEt_quot, hq_mk, hEtX', hσ₄_ι₄, hσ₄R, hσ₄X, hδ_mem, hQuad, hA00, hA01, hA11⟩

theorem weil_quadratic_etale_nodal_splitting_descent (R : Type u) [CommRing R] [IsLocalRing R]
    (S₄ : Type u) [CommRing S₄] [Algebra R S₄]
    (φ_X' : MvPolynomial (Fin 2) R →ₐ[R] S₄)
    (hEtX' : RingHom.Etale φ_X'.toRingHom)
    (σ_bar₄ : S₄ →+* IsLocalRing.ResidueField R)
    (hσ₄R : σ_bar₄.comp (algebraMap R S₄) = IsLocalRing.residue R)
    (hσ₄X : ∀ i : Fin 2, σ_bar₄ (φ_X' (MvPolynomial.X i)) = 0)
    (δ : R) (hδ : δ ∈ IsLocalRing.maximalIdeal R)
    (F₄ A₀₀ A₀₁ A₁₁ : S₄)
    (hQuad : F₄ + algebraMap R S₄ δ =
      A₀₀ * (φ_X' (MvPolynomial.X 0)) ^ 2 +
        A₀₁ * (φ_X' (MvPolynomial.X 0)) * (φ_X' (MvPolynomial.X 1)) +
        A₁₁ * (φ_X' (MvPolynomial.X 1)) ^ 2)
    (hA₀₀ : σ_bar₄ A₀₀ = 0) (hA₀₁ : σ_bar₄ A₀₁ = 1) (hA₁₁ : σ_bar₄ A₁₁ = 0) :
    ∃ (W_ring : Type u) (_ : CommRing W_ring)
      (σ_bar_W : W_ring →+* IsLocalRing.ResidueField R)
      (β_S : (S₄ ⧸ Ideal.span {F₄}) →+* W_ring)
      (α_nod : (MvPolynomial (Fin 2) R ⧸
        Ideal.span {MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C δ}) →+* W_ring),
      RingHom.Etale β_S ∧
      RingHom.Etale α_nod ∧
      σ_bar_W.comp (β_S.comp (Ideal.Quotient.mk (Ideal.span {F₄}))) = σ_bar₄ ∧
      β_S.comp ((Ideal.Quotient.mk (Ideal.span {F₄})).comp (algebraMap R S₄)) =
        α_nod.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) ∧
      (∀ i : Fin 2, σ_bar_W (α_nod (Ideal.Quotient.mk _ (MvPolynomial.X i))) = 0) :=
by
  
  have hQuotDesc : ∀ (A B : Type u) [CommRing A] [CommRing B]
      (f : A →+* B) (_ : RingHom.Etale f) (a : A) (b : B), f a = b →
      ∃ g : (A ⧸ Ideal.span {a}) →+* (B ⧸ Ideal.span {b}),
        RingHom.Etale g ∧
        g.comp (Ideal.Quotient.mk (Ideal.span {a})) =
          (Ideal.Quotient.mk (Ideal.span {b})).comp f := by
    intro A B _ _ f hf a b hab
    letI : Algebra A B := f.toAlgebra
    have hAlgEq : algebraMap A B = f := rfl
    haveI : Algebra.Etale A B := RingHom.etale_algebraMap.mp hf
    let I : Ideal A := Ideal.span {a}
    let J : Ideal B := Ideal.span {b}
    have hmap : Ideal.map (algebraMap A B) I = J := by
      dsimp [I, J]
      rw [Ideal.map_span, Set.image_singleton, hAlgEq, hab]
    haveI : Algebra.Etale (A ⧸ I) (TensorProduct A (A ⧸ I) B) :=
      Algebra.Etale.baseChange A B (A ⧸ I)
    let η : (A ⧸ I) →+* TensorProduct A (A ⧸ I) B :=
      algebraMap (A ⧸ I) (TensorProduct A (A ⧸ I) B)
    have hEt_η : RingHom.Etale η := RingHom.etale_algebraMap.mpr inferInstance
    let e₁ : TensorProduct A (A ⧸ I) B ≃ₐ[A] TensorProduct A B (A ⧸ I) :=
      Algebra.TensorProduct.comm A (A ⧸ I) B
    let e₂ : (B ⧸ Ideal.map (algebraMap A B) I) ≃ₐ[B] TensorProduct A B (A ⧸ I) :=
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I
    let e₃ : (B ⧸ Ideal.map (algebraMap A B) I) ≃+* (B ⧸ J) :=
      Ideal.quotEquivOfEq hmap
    let e : TensorProduct A (A ⧸ I) B ≃+* (B ⧸ J) :=
      e₁.toRingEquiv.trans (e₂.symm.toRingEquiv.trans e₃)
    have hEt_e : RingHom.Etale e.toRingHom := RingHom.Etale.of_bijective e.bijective
    refine ⟨e.toRingHom.comp η, RingHom.Etale.stableUnderComposition η e.toRingHom hEt_η hEt_e, ?_⟩
    ext x
    change e₃ (e₂.symm (e₁ (η (Ideal.Quotient.mk I x)))) = Ideal.Quotient.mk J (f x)
    have hη_x : η (Ideal.Quotient.mk I x) = (Ideal.Quotient.mk I x) ⊗ₜ[A] (1 : B) :=
      Algebra.TensorProduct.includeLeft_apply (R := A) (S := A) (Ideal.Quotient.mk I x)
    have he₁_x : e₁ ((Ideal.Quotient.mk I x) ⊗ₜ[A] (1 : B)) = (f x) ⊗ₜ[A] (1 : A ⧸ I) := by
      change (1 : B) ⊗ₜ[A] (Ideal.Quotient.mk I x) = (f x) ⊗ₜ[A] (1 : A ⧸ I)
      have hmk : Ideal.Quotient.mk I x = x • (1 : A ⧸ I) := by
        change algebraMap A (A ⧸ I) x = x • (1 : A ⧸ I)
        exact Algebra.algebraMap_eq_smul_one x
      have hfx : f x = x • (1 : B) := by
        change algebraMap A B x = x • (1 : B)
        exact Algebra.algebraMap_eq_smul_one x
      rw [hmk, hfx, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
    rw [hη_x, he₁_x]
    have he₂_x : e₂ (Ideal.Quotient.mk (Ideal.map (algebraMap A B) I) (f x)) =
        (f x) ⊗ₜ[A] (1 : A ⧸ I) :=
      Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk B I (f x)
    rw [← he₂_x, AlgEquiv.symm_apply_apply]
    exact Ideal.quotEquivOfEq_mk hmap (f x)
  
  have hSplit₅ : ∀ (K : Type u) [Field K] (σ₄ : S₄ →+* K),
      σ₄ A₀₀ = 0 → σ₄ A₀₁ = 1 → σ₄ A₁₁ = 0 →
      ∃ (S₅ : Type u) (_ : CommRing S₅) (_ : Algebra S₄ S₅)
        (σ_bar₅ : S₅ →+* K) (c₀₀ c₁₀ : S₅),
        Algebra.Etale S₄ S₅ ∧
