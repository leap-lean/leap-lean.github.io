      have hX1_𝔭₀ : Ideal.Quotient.mk I_nod (MvPolynomial.X 1) ∈ 𝔭₀ := by
        rw [h𝔭₀_eq]
        exact hXi 1
      have h𝔭_br_le : 𝔭_br ≤ 𝔭₀ := by
        let σ_proj : MvPolynomial (Fin 2) k_P →+* MvPolynomial (Fin 2) k_P :=
