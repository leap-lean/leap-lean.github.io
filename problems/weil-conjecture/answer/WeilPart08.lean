      have hEt_spec₂ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂)) := by
        rw [hSpec_φ₂]
        exact hEt_from₂
      have hφ₂_et : φ₂.Etale :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec₂
