          Matrix.fromBlocks (M_jac.map S_inl.toRingHom) C₁₂ 0 D₂₂ := by
        refine Matrix.ext fun row col => ?_
        rcases row with a | ⟨⟩ <;> rcases col with b | ⟨⟩
