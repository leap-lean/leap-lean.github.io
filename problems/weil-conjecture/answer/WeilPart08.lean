      h_sec_zmt A₀ B q
    obtain ⟨θ, hInt, hLoc⟩ :=
      h_sec_mono A₁ B_q R₁ hSep hMapMax hInj_R₁ hFin_R₁ hLoc_R₁
    exact h_part2 A₀ B q hTF hUnram θ hInt hLoc
  refine ⟨hClause1, ?_, ?_⟩
  · intro C_R g_R hFlat hLFP y₀ hSmFib
    obtain ⟨A, _, _, q, φ₀, hFlatA, hFPA, hMaxLe, hφ₀, hSm₀, hLift⟩ :=
      h_part3 C_R g_R hFlat hLFP y₀ hSmFib
    let _ := hFlatA; let _ := hFPA
    obtain ⟨h, hh, hSm_h⟩ := h_part4 A q hMaxLe φ₀ hφ₀ hSm₀
