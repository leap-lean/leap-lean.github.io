        have h_xj_X : φ_toPoly (Xbar j) = Polynomial.X := by
          change toPoly (MvPolynomial.X j) = Polynomial.X
          rw [MvPolynomial.aeval_X, ite_eq_right_iff.mpr fun h => absurd h hij.symm]
        have h_kill_IDi : ∀ w ∈ I_Di, TensorProduct.tmul R_nod w (1 : Polynomial k₀) = 0 := by
          intro w hw
