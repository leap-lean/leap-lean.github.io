      (r : ℕ) (Q : MvPolynomial (Fin (N' + 1)) ↥V) (hQ : Q ∈ 𝒜_V (r • 1))
      (hQ_F : MvPolynomial.map ρ Q ∈ 𝒜_F (r • 1)),
      (φ_s.appLE (weilProjBasicOpen F' N' a) ((TopologicalSpace.Opens.map fst_g.base).obj U) hUs).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X a)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F a) r
            (MvPolynomial.map ρ Q) hQ_F)) =
      (fst_g.appLE U ((TopologicalSpace.Opens.map fst_g.base).obj U) le_rfl).hom
        ((φ.appLE (weilProjBasicOpen ↥V N' a) U hU).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X a)).hom
            (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _ (hX_V a) r Q hQ))) := by
    intro a U hU hUs r Q hQ hQ_F
    let U_s := (TopologicalSpace.Opens.map fst_g.base).obj U
    have heq_a := (hΦ_charts a).choose
    rw [← (hΦ_charts a).choose_spec.1 r Q hQ hQ_F]
    change ((Φ_s.appLE (weilProjBasicOpen ↥V N' a) (weilProjBasicOpen F' N' a)
      (le_of_eq heq_a.symm) ≫
      φ_s.appLE (weilProjBasicOpen F' N' a) U_s hUs).hom) _ =
      ((φ.appLE (weilProjBasicOpen ↥V N' a) U hU ≫ fst_g.appLE U U_s le_rfl).hom) _
    rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
      appLE_congr hφ_Φ _ _ _ _]

  have hBaseConst : ∀ (a : Fin (N' + 1)) (U : C.Opens)
      (hUs : (TopologicalSpace.Opens.map fst_g.base).obj U ≤
        (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' a))
      (c : F') (hC_S : (MvPolynomial.C c : MvPolynomial (Fin (N' + 1)) F') ∈ 𝒜_F (0 • 1)),
      (φ_s.appLE (weilProjBasicOpen F' N' a) ((TopologicalSpace.Opens.map fst_g.base).obj U) hUs).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X a)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _
            (hX_F a) 0 (MvPolynomial.C c) hC_S)) =
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F')).inv ≫
        snd_g.appLE ⊤ ((TopologicalSpace.Opens.map fst_g.base).obj U) le_top).hom c := by
    intro a U hUs c hC_S
    let U_s : X_s.Opens := (TopologicalSpace.Opens.map fst_g.base).obj U
    rw [← (hΦ_charts a).choose_spec.2 c hC_S]
    have h_comp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE φ_s P_F.hom ⊤
      (weilProjBasicOpen F' N' a) U_s (fun _ _ => trivial) hUs
    have h_cgr : (φ_s ≫ P_F.hom).appLE ⊤ U_s (fun _ _ => trivial) =
        snd_g.appLE ⊤ U_s le_top :=
      appLE_congr hφ_hom ⊤ U_s (fun _ _ => trivial) le_top
    change (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F')).inv ≫
      (P_F.hom.appLE ⊤ (weilProjBasicOpen F' N' a) (fun _ _ => trivial) ≫
        φ_s.appLE (weilProjBasicOpen F' N' a) U_s hUs)).hom) c = _
    rw [h_comp, h_cgr]

  
  have hLinEval : ∀ (a : Fin (N' + 1)) (c_shift : F')
      (hL : MvPolynomial.X (1 : Fin (N' + 1)) -
        MvPolynomial.C c_shift * MvPolynomial.X (0 : Fin (N' + 1)) ∈ 𝒜_F 1)
      (U : C.Opens)
      (hU : U ≤ (TopologicalSpace.Opens.map φ.base).obj (weilProjBasicOpen ↥V N' a))
      (hUs : (TopologicalSpace.Opens.map fst_g.base).obj U ≤
        (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' a)),
      let U_s : X_s.Opens := (TopologicalSpace.Opens.map fst_g.base).obj U
      let L_c : MvPolynomial (Fin (N' + 1)) F' :=
        MvPolynomial.X (1 : Fin (N' + 1)) -
          MvPolynomial.C c_shift * MvPolynomial.X (0 : Fin (N' + 1))
      (φ_s.appLE (weilProjBasicOpen F' N' a) U_s hUs).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X a)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F a) 1 L_c hL)) =
      (fst_g.appLE U U_s le_rfl).hom
        ((φ.appLE (weilProjBasicOpen ↥V N' a) U hU).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X a)).hom
            (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
              (hX_V a) 1 (MvPolynomial.X 1) (hX_V 1)))) -
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F')).inv ≫
        snd_g.appLE ⊤ U_s le_top).hom c_shift *
      (fst_g.appLE U U_s le_rfl).hom
        ((φ.appLE (weilProjBasicOpen ↥V N' a) U hU).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X a)).hom
            (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
              (hX_V a) 1 (MvPolynomial.X 0) (hX_V 0)))) := by
    intro a c_shift hL U hU hUs U_s L_c
    let _ : GradedAlgebra 𝒜_F := gF
    have hX_map : ∀ b : Fin (N' + 1),
        MvPolynomial.map ρ (MvPolynomial.X b : MvPolynomial (Fin (N' + 1)) ↥V) ∈ 𝒜_F (1 • 1) := by
      intro b
      rw [MvPolynomial.map_X]
      exact hX_F b
    have h_away_sub :
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F a) 1 L_c hL =
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _
          (hX_F a) 1 (MvPolynomial.map ρ (MvPolynomial.X 1)) (hX_map 1) -
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _
          (hX_F a) 0 (MvPolynomial.C c_shift) (hC_F c_shift) *
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _
          (hX_F a) 1 (MvPolynomial.map ρ (MvPolynomial.X 0)) (hX_map 0) := by
      rw [eq_sub_iff_add_eq]
      apply HomogeneousLocalization.val_injective (Submonoid.powers (MvPolynomial.X a))
      rw [HomogeneousLocalization.val_add, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_mul]
      have h_one_mul : (⟨(MvPolynomial.X a : MvPolynomial (Fin (N' + 1)) F') ^ 0, ⟨0, rfl⟩⟩ :
          Submonoid.powers (MvPolynomial.X a)) *
          ⟨(MvPolynomial.X a) ^ 1, ⟨1, rfl⟩⟩ = ⟨(MvPolynomial.X a) ^ 1, ⟨1, rfl⟩⟩ := by
        ext
        simp
      rw [h_one_mul, Localization.add_mk_self]
      dsimp [L_c]
      rw [MvPolynomial.map_X, MvPolynomial.map_X, sub_add_cancel]
    let ev_Fa : HomogeneousLocalization.Away 𝒜_F (MvPolynomial.X a) →+*
        ↑(X_s.presheaf.obj (Opposite.op U_s)) :=
      (φ_s.appLE (weilProjBasicOpen F' N' a) U_s hUs).hom.comp
        (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X a)).hom
    have hev_Fa : ∀ z : HomogeneousLocalization.Away 𝒜_F (MvPolynomial.X a),
        ev_Fa z = (φ_s.appLE (weilProjBasicOpen F' N' a) U_s hUs).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X a)).hom z) :=
      fun _ => rfl
    change ev_Fa (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F a) 1 L_c hL) = _
    rw [h_away_sub, map_sub, map_mul, hev_Fa, hev_Fa, hev_Fa,
      hBaseMapQ a U hU hUs 1 (MvPolynomial.X 1) (hX_V 1) (hX_map 1),
      hBaseConst a U hUs c_shift (hC_F c_shift),
      hBaseMapQ a U hU hUs 1 (MvPolynomial.X 0) (hX_V 0) (hX_map 0)]

  
  let c_V₁ : ↥V →+* ↑(C.presheaf.obj (Opposite.op V₁)) :=
    ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of ↥V)).inv ≫
      AlgebraicGeometry.Scheme.Hom.appLE g ⊤ V₁ le_top).hom
  have hψ₁_eq : ψ₁ = (V₁.topIso.inv).hom.comp (MvPolynomial.eval₂Hom c_V₁ f) := by
    apply MvPolynomial.ringHom_ext'
    · ext c
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
      exact hψ₁_C c
    · intro b
      simp [hψ₁_X b]
  have hbo_one_V₁ : C.basicOpen (1 : ↑(C.presheaf.obj (Opposite.op V₁))) = V₁ :=
    AlgebraicGeometry.RingedSpace.basicOpen_of_isUnit C.toRingedSpace isUnit_one
  have hψ₁_X0 : ψ₁ (MvPolynomial.X 0) = (V₁.topIso.inv).hom (1 : ↑(C.presheaf.obj (Opposite.op V₁))) := by
    rw [hψ₁_X 0, hf0]
  have hV₁_le_D0 : V₁ ≤ (TopologicalSpace.Opens.map φ.base).obj (weilProjBasicOpen ↥V N' 0) := by
    rw [← hbo_one_V₁]
    exact (hOpenEval V₁ ψ₁ hψ₁ hφ_V₁ 0 1 hψ₁_X0).1
  have hV₁_eval_V : ∀ (r : ℕ) (Q : MvPolynomial (Fin (N' + 1)) ↥V) (hQ : Q ∈ 𝒜_V (r • 1)),
      (φ.appLE (weilProjBasicOpen ↥V N' 0) V₁ hV₁_le_D0).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _ (hX_V 0) r Q hQ)) =
      MvPolynomial.eval₂Hom c_V₁ f Q := by
    intro r Q hQ
    have h_le1 : C.basicOpen (1 : ↑(C.presheaf.obj (Opposite.op V₁))) ≤
        (TopologicalSpace.Opens.map φ.base).obj (weilProjBasicOpen ↥V N' 0) := by
      rw [hbo_one_V₁]
      exact hV₁_le_D0
    have hQ_img : ψ₁ Q = (V₁.topIso.inv).hom (MvPolynomial.eval₂Hom c_V₁ f Q) := by
      rw [hψ₁_eq]
      rfl
    have h_ev := (hOpenEval V₁ ψ₁ hψ₁ hφ_V₁ 0 1 hψ₁_X0).2 h_le1 r Q hQ
      (MvPolynomial.eval₂Hom c_V₁ f Q) hQ_img
    rw [map_one, one_pow, mul_one] at h_ev
    have h_ap := congrArg (C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_V₁.symm)).op).hom h_ev
    let u_0Q := (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
      (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _ (hX_V 0) r Q hQ)
    have h_lhs : (C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_V₁.symm)).op).hom
        ((φ.appLE (weilProjBasicOpen ↥V N' 0) (C.basicOpen 1) h_le1).hom u_0Q) =
        (φ.appLE (weilProjBasicOpen ↥V N' 0) V₁ hV₁_le_D0).hom u_0Q := by
      change ((φ.appLE (weilProjBasicOpen ↥V N' 0) (C.basicOpen 1) h_le1 ≫
        C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_V₁.symm)).op).hom) u_0Q = _
      rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
    have h_rhs : (C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_V₁.symm)).op).hom
        ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le 1)).op).hom
          (MvPolynomial.eval₂Hom c_V₁ f Q)) = MvPolynomial.eval₂Hom c_V₁ f Q := by
      rw [res_comp C (le_of_eq hbo_one_V₁.symm) (C.basicOpen_le 1) le_rfl]
      change (C.presheaf.map (𝟙 (Opposite.op V₁))).hom _ = _
      rw [C.presheaf.map_id]
      rfl
    rw [h_lhs, h_rhs] at h_ap
    exact h_ap

  have hV₁s_le_D0 : V₁_s ≤ (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' 0) :=
    hBasePre 0 V₁ hV₁_le_D0
  have hV₁s_eval_F : ∀ (r : ℕ) (P : MvPolynomial (Fin (N' + 1)) F') (hP : P ∈ 𝒜_F (r • 1)),
      (φ_s.appLE (weilProjBasicOpen F' N' 0) V₁_s hV₁s_le_D0).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X 0)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F 0) r P hP)) =
      MvPolynomial.eval₂Hom c₁_s (α₁ ∘ f) P := by
    intro r P hP
    let _ : GradedAlgebra 𝒜_F := gF
    have hP_hom : MvPolynomial.IsHomogeneous P r := by
      rw [← MvPolynomial.mem_homogeneousSubmodule]
      change P ∈ 𝒜_F r
      rwa [nsmul_eq_mul, mul_one] at hP
    have h_deg : ∀ d ∈ P.support, Finsupp.degree d = r := by
      intro d hd
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hd) (hP_hom.coeff_eq_zero hne)
    have h_mon_V : ∀ d : Fin (N' + 1) →₀ ℕ, d ∈ P.support →
        MvPolynomial.monomial d (1 : ↥V) ∈ 𝒜_V (r • 1) := by
      intro d hd
      rw [nsmul_eq_mul, mul_one, MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_monomial 1 (h_deg d hd)
    have h_mon_F : ∀ d : Fin (N' + 1) →₀ ℕ, d ∈ P.support →
        MvPolynomial.map ρ (MvPolynomial.monomial d (1 : ↥V)) ∈ 𝒜_F (r • 1) := by
      intro d hd
      rw [MvPolynomial.map_monomial, map_one, nsmul_eq_mul, mul_one,
        MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_monomial 1 (h_deg d hd)
    let term_away : ∀ d : Fin (N' + 1) →₀ ℕ, d ∈ P.support →
        HomogeneousLocalization.Away 𝒜_F (MvPolynomial.X (0 : Fin (N' + 1))) :=
      fun d hd =>
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _
          (hX_F 0) 0 (MvPolynomial.C (P.coeff d)) (hC_F (P.coeff d)) *
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _
          (hX_F 0) r (MvPolynomial.map ρ (MvPolynomial.monomial d (1 : ↥V))) (h_mon_F d hd)
    have h_away_sum :
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F 0) r P hP =
        ∑ d ∈ P.support.attach, term_away d.1 d.2 := by
      apply HomogeneousLocalization.val_injective
        (Submonoid.powers (MvPolynomial.X (0 : Fin (N' + 1)) : MvPolynomial (Fin (N' + 1)) F'))
      rw [HomogeneousLocalization.Away.val_mk]
      have h_ind : ∀ (S_fin : Finset {d // d ∈ P.support}),
          (∑ d ∈ S_fin, term_away d.1 d.2).val =
          Localization.mk
            (∑ d ∈ S_fin, MvPolynomial.C (P.coeff d.1) *
              MvPolynomial.map ρ (MvPolynomial.monomial d.1 (1 : ↥V)))
            (⟨(MvPolynomial.X (0 : Fin (N' + 1)) : MvPolynomial (Fin (N' + 1)) F') ^ r,
              ⟨r, rfl⟩⟩ :
              Submonoid.powers (MvPolynomial.X (0 : Fin (N' + 1)) :
                MvPolynomial (Fin (N' + 1)) F')) := by
        intro S_fin
        induction S_fin using Finset.induction_on with
        | empty =>
          simp [HomogeneousLocalization.val_zero, Localization.mk_zero]
        | @insert d S_fin hd_not ih =>
          rw [Finset.sum_insert hd_not, Finset.sum_insert hd_not,
            HomogeneousLocalization.val_add, ih]
          dsimp only [term_away]
          rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
            HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
          have h_one_mul : (⟨(MvPolynomial.X (0 : Fin (N' + 1)) :
              MvPolynomial (Fin (N' + 1)) F') ^ 0, ⟨0, rfl⟩⟩ :
              Submonoid.powers (MvPolynomial.X (0 : Fin (N' + 1)))) *
              ⟨(MvPolynomial.X 0) ^ r, ⟨r, rfl⟩⟩ = ⟨(MvPolynomial.X 0) ^ r, ⟨r, rfl⟩⟩ := by
            ext
            simp
          rw [h_one_mul, Localization.add_mk_self]
      rw [h_ind P.support.attach, Finset.sum_attach P.support (fun d => MvPolynomial.C (P.coeff d) *
        MvPolynomial.map ρ (MvPolynomial.monomial d (1 : ↥V)))]
      have hP_sum : ∑ d ∈ P.support, MvPolynomial.C (P.coeff d) *
          MvPolynomial.map ρ (MvPolynomial.monomial d (1 : ↥V)) = P := by
        calc
          ∑ d ∈ P.support, MvPolynomial.C (P.coeff d) *
              MvPolynomial.map ρ (MvPolynomial.monomial d (1 : ↥V))
            = ∑ d ∈ P.support, MvPolynomial.monomial d (P.coeff d) := by
              apply Finset.sum_congr rfl
              intro d _hd
              rw [MvPolynomial.map_monomial, map_one, MvPolynomial.monomial_eq, map_one, one_mul,
                ← MvPolynomial.monomial_eq]
          _ = P := (MvPolynomial.as_sum P).symm
      rw [hP_sum]
    let ev_F0 : HomogeneousLocalization.Away 𝒜_F (MvPolynomial.X (0 : Fin (N' + 1))) →+*
        ↑(X_s.presheaf.obj (Opposite.op V₁_s)) :=
      (φ_s.appLE (weilProjBasicOpen F' N' 0) V₁_s hV₁s_le_D0).hom.comp
        (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X 0)).hom
    have hev_F0 : ∀ z : HomogeneousLocalization.Away 𝒜_F (MvPolynomial.X (0 : Fin (N' + 1))),
        ev_F0 z = (φ_s.appLE (weilProjBasicOpen F' N' 0) V₁_s hV₁s_le_D0).hom
          ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X 0)).hom z) :=
      fun _ => rfl
    change ev_F0 (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F 0) r P hP) = _
    rw [h_away_sum, map_sum]
    calc
      ∑ d ∈ P.support.attach, ev_F0 (term_away d.1 d.2)
        = ∑ d ∈ P.support.attach,
            MvPolynomial.eval₂Hom c₁_s (α₁ ∘ f) (MvPolynomial.monomial d.1 (P.coeff d.1)) := by
          apply Finset.sum_congr rfl
          intro d _hd
          dsimp only [term_away]
          rw [map_mul, hev_F0, hev_F0,
            hBaseConst 0 V₁ hV₁s_le_D0 (P.coeff d.1) (hC_F (P.coeff d.1)),
            hBaseMapQ 0 V₁ hV₁_le_D0 hV₁s_le_D0 r (MvPolynomial.monomial d.1 1)
              (h_mon_V d.1 d.2) (h_mon_F d.1 d.2),
            hV₁_eval_V r (MvPolynomial.monomial d.1 1) (h_mon_V d.1 d.2),
            MvPolynomial.eval₂Hom_monomial, MvPolynomial.eval₂Hom_monomial,
            map_one, one_mul, map_finsuppProd]
          congr 1
          refine Finsupp.prod_congr fun i _hi => ?_
          rw [map_pow]
          rfl
      _ = ∑ d ∈ P.support,
            MvPolynomial.eval₂Hom c₁_s (α₁ ∘ f) (MvPolynomial.monomial d (P.coeff d)) :=
          Finset.sum_attach P.support
            (fun d => MvPolynomial.eval₂Hom c₁_s (α₁ ∘ f) (MvPolynomial.monomial d (P.coeff d)))
      _ = MvPolynomial.eval₂Hom c₁_s (α₁ ∘ f) P := by
          rw [← map_sum, ← MvPolynomial.as_sum P]

  have hEval_U₀ : ∀ (hX0_F : (MvPolynomial.X (0 : Fin (N' + 1)) : MvPolynomial (Fin (N' + 1)) F') ∈ 𝒜_F 1)
      (heq₀ : W₀_s ≤ (TopologicalSpace.Opens.map q_s.base).obj U₀_s)
      (hu₀ : U₀_s ≤ (TopologicalSpace.Opens.map ι_Xns.base).obj (weilProjBasicOpen F' N' 0))
      (hv₁ : V₁_s ≤ W₀_s)
      (r : ℕ) (P : MvPolynomial (Fin (N' + 1)) F') (hP : P ∈ 𝒜_F (r • 1)),
      (X_s.presheaf.map (CategoryTheory.homOfLE hv₁).op).hom
        ((q_s.appLE U₀_s W₀_s heq₀).hom
          ((ι_Xns.appLE (weilProjBasicOpen F' N' 0) U₀_s hu₀).hom
            ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF
              (MvPolynomial.X (0 : Fin (N' + 1)))).hom
              (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ hX0_F r P hP)))) =
      MvPolynomial.eval₂Hom c₁_s (α₁ ∘ f) P := by
    intro hX0_F heq₀ hu₀ hv₁ r P hP
    have hX0_eq : hX0_F = hX_F 0 := Subsingleton.elim _ _
    subst hX0_eq
    rw [← hV₁s_eval_F r P hP]
    change (((ι_Xns.appLE (weilProjBasicOpen F' N' 0) U₀_s hu₀ ≫
      q_s.appLE U₀_s W₀_s heq₀) ≫ X_s.presheaf.map (CategoryTheory.homOfLE hv₁).op).hom) _ = _
    rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
      AlgebraicGeometry.Scheme.Hom.appLE_map]

  
  have hW_D0 : W_compl ≤ (TopologicalSpace.Opens.map φ.base).obj (weilProjBasicOpen ↥V N' 0) := by
    have h_eq : (TopologicalSpace.Opens.map φ.base).obj (weilProjBasicOpen ↥V N' 0) = W_compl := by
      rw [← AlgebraicGeometry.Scheme.Hom.toImage_imageι φ]
      change (TopologicalSpace.Opens.map q_img.base).obj
        ((TopologicalSpace.Opens.map ιP_next.base).obj (weilProjBasicOpen ↥V N' 0)) = W_compl
      rw [← hUnext₀_eq, hPre_Unext₀]
    exact le_of_eq h_eq.symm
  have hu_V0_X0 :
      ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
        (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
          (hX_V 0) 1 (MvPolynomial.X 0) (hX_V 0)) :
        ↑(P_V.left.presheaf.obj (Opposite.op (weilProjBasicOpen ↥V N' 0)))) = 1 := by
    let _ : GradedAlgebra 𝒜_V := gV
    have h_mk_one :
        @HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
          (hX_V 0) 1 (MvPolynomial.X 0) (hX_V 0) = 1 := by
      apply HomogeneousLocalization.val_injective
        (Submonoid.powers (MvPolynomial.X (0 : Fin (N' + 1)) : MvPolynomial (Fin (N' + 1)) ↥V))
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
      simp
    rw [h_mk_one]
    exact map_one _
  have hu_V0_X1 :
      (φ.appLE (weilProjBasicOpen ↥V N' 0) W_compl hW_D0).hom
        ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
          (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
            (hX_V 0) 1 (MvPolynomial.X 1) (hX_V 1))) = f₁_gl := by
    let u_01 := (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
      (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
        (hX_V 0) 1 (MvPolynomial.X 1) (hX_V 1))
    refine C.sheaf.eq_of_locally_eq₂
      (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ W_compl))
      (CategoryTheory.homOfLE (le_sup_right : C.basicOpen eZ ≤ W_compl))
      le_rfl _ _ ?_ ?_
    · change ((φ.appLE (weilProjBasicOpen ↥V N' 0) W_compl hW_D0 ≫
        C.presheaf.map (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ W_compl)).op).hom) u_01 =
        (C.presheaf.map (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ W_compl)).op).hom f₁_gl
      rw [AlgebraicGeometry.Scheme.Hom.appLE_map, hf₁_V₁]
      have h_ev := hV₁_eval_V 1 (MvPolynomial.X 1) (hX_V 1)
      simpa using h_ev
    · let U_Z : C.Opens := C.basicOpen eZ
      change ((φ.appLE (weilProjBasicOpen ↥V N' 0) W_compl hW_D0 ≫
        C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : U_Z ≤ W_compl)).op).hom) u_01 =
        (C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : U_Z ≤ W_compl)).op).hom f₁_gl
      rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
      let u_eZ : ↑(C.presheaf.obj (Opposite.op U_Z)) :=
        (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom (eZ ^ m₀)
      have hUnit_eZ : IsUnit u_eZ := by
        dsimp [u_eZ]
        rw [map_pow]
        exact (AlgebraicGeometry.RingedSpace.isUnit_res_basicOpen C.toRingedSpace eZ).pow m₀
      obtain ⟨u_unit, hu_unit⟩ := hUnit_eZ
      have hψZ_0 : ψ_Z (MvPolynomial.X 0) = (U_Z.topIso.inv).hom 1 := by
        have h_mul := hψZ_X 0
        rw [hfZ0] at h_mul
        change ψ_Z (MvPolynomial.X 0) * (U_Z.topIso.inv).hom u_eZ = (U_Z.topIso.inv).hom u_eZ at h_mul
        have hu_inv : (U_Z.topIso.inv).hom u_eZ * (U_Z.topIso.inv).hom (↑(u_unit⁻¹)) = 1 := by
          rw [← map_mul, ← hu_unit, Units.mul_inv, map_one]
        calc
          ψ_Z (MvPolynomial.X 0)
            = ψ_Z (MvPolynomial.X 0) * ((U_Z.topIso.inv).hom u_eZ *
                (U_Z.topIso.inv).hom (↑(u_unit⁻¹))) := by rw [hu_inv, mul_one]
          _ = (ψ_Z (MvPolynomial.X 0) * (U_Z.topIso.inv).hom u_eZ) *
                (U_Z.topIso.inv).hom (↑(u_unit⁻¹)) := (mul_assoc _ _ _).symm
          _ = 1 := by rw [h_mul, hu_inv]
          _ = (U_Z.topIso.inv).hom 1 := (map_one _).symm
      have hbo_one_UZ : C.basicOpen (1 : ↑(C.presheaf.obj (Opposite.op U_Z))) = U_Z :=
        sch_bo_unit C isUnit_one
      have hUZ_le_D0 : U_Z ≤ (TopologicalSpace.Opens.map φ.base).obj (weilProjBasicOpen ↥V N' 0) :=
        (le_sup_right : U_Z ≤ W_compl).trans hW_D0
      have h_le1 : C.basicOpen (1 : ↑(C.presheaf.obj (Opposite.op U_Z))) ≤
          (TopologicalSpace.Opens.map φ.base).obj (weilProjBasicOpen ↥V N' 0) := by
        rw [hbo_one_UZ]
        exact hUZ_le_D0
      let y_Q : ↑(C.presheaf.obj (Opposite.op U_Z)) := (U_Z.topIso.hom).hom (ψ_Z (MvPolynomial.X 1))
      have hyQ : ψ_Z (MvPolynomial.X 1) = (U_Z.topIso.inv).hom y_Q := by
        dsimp [y_Q]
        change _ = ((U_Z.topIso.hom ≫ U_Z.topIso.inv).hom) (ψ_Z (MvPolynomial.X 1))
        rw [U_Z.topIso.hom_inv_id]
        rfl
      have h_ev := (hOpenEval U_Z ψ_Z hψ_Z hφ_Z 0 1 hψZ_0).2 h_le1 1 (MvPolynomial.X 1)
        (hX_V 1) y_Q hyQ
      rw [map_one, one_pow, mul_one] at h_ev
      have h_ap := congrArg
        (C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_UZ.symm)).op).hom h_ev
      have h_lhs : (C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_UZ.symm)).op).hom
          ((φ.appLE (weilProjBasicOpen ↥V N' 0) (C.basicOpen 1) h_le1).hom u_01) =
          (φ.appLE (weilProjBasicOpen ↥V N' 0) U_Z hUZ_le_D0).hom u_01 := by
        change ((φ.appLE (weilProjBasicOpen ↥V N' 0) (C.basicOpen 1) h_le1 ≫
          C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_UZ.symm)).op).hom) u_01 = _
        rw [AlgebraicGeometry.Scheme.Hom.appLE_map]
      have h_rhs : (C.presheaf.map (CategoryTheory.homOfLE (le_of_eq hbo_one_UZ.symm)).op).hom
          ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le 1)).op).hom y_Q) = y_Q := by
        rw [res_comp C (le_of_eq hbo_one_UZ.symm) (C.basicOpen_le 1) le_rfl]
        change (C.presheaf.map (𝟙 (Opposite.op U_Z))).hom y_Q = y_Q
        rw [C.presheaf.map_id]
        rfl
      rw [h_lhs, h_rhs] at h_ap
      rw [h_ap]
      have h_yQ_mul : y_Q * u_eZ =
          (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom (f_Z 1) := by
        have h_ap_top := congrArg (U_Z.topIso.hom).hom (hψZ_X 1)
        rw [map_mul] at h_ap_top
        have h_inv_hom : ∀ z : ↑(C.presheaf.obj (Opposite.op U_Z)),
            (U_Z.topIso.hom).hom ((U_Z.topIso.inv).hom z) = z := by
          intro z
          change ((U_Z.topIso.inv ≫ U_Z.topIso.hom).hom) z = z
          rw [U_Z.topIso.inv_hom_id]
          rfl
        rw [h_inv_hom u_eZ, h_inv_hom] at h_ap_top
        exact h_ap_top
      have h_eq_mul : y_Q * u_eZ =
          (C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : U_Z ≤ W_compl)).op).hom f₁_gl * u_eZ :=
        h_yQ_mul.trans hf₁_Z.symm
      calc
        y_Q = y_Q * (↑u_unit * ↑(u_unit⁻¹)) := by rw [Units.mul_inv, mul_one]
        _ = (y_Q * u_eZ) * ↑(u_unit⁻¹) := by rw [hu_unit, mul_assoc]
        _ = ((C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : U_Z ≤ W_compl)).op).hom f₁_gl * u_eZ) *
              ↑(u_unit⁻¹) := by rw [h_eq_mul]
        _ = (C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : U_Z ≤ W_compl)).op).hom f₁_gl := by
              rw [← hu_unit, mul_assoc, Units.mul_inv, mul_one]

  
  have hSpanSplit : ∀ (U : X_s.Opens) (d u₀ u₁ : ↑(X_s.presheaf.obj (Opposite.op U))) (r : ℕ),
      d ^ r ∈ Ideal.span ({u₀, u₁} : Set ↑(X_s.presheaf.obj (Opposite.op U))) →
      X_s.basicOpen d = X_s.basicOpen (d * u₀) ⊔ X_s.basicOpen (d * u₁) := by
    intro U d u₀ u₁ r hmem
    apply le_antisymm
    · intro x hx
      have hxU : x ∈ U := X_s.basicOpen_le d hx
      have hd_unit : IsUnit ((X_s.presheaf.germ U x hxU).hom d) :=
        (AlgebraicGeometry.RingedSpace.mem_basicOpen X_s.toRingedSpace d x hxU).mp hx
      obtain ⟨a₀, a₁, ha_eq⟩ := Ideal.mem_span_pair.mp hmem
      let γ_x := (X_s.presheaf.germ U x hxU).hom
      have h_stalk_eq : γ_x a₀ * γ_x u₀ + γ_x a₁ * γ_x u₁ = (γ_x d) ^ r := by
        have := congrArg γ_x ha_eq
        simpa [map_add, map_mul, map_pow] using this
      have h_or : IsUnit (γ_x u₀) ∨ IsUnit (γ_x u₁) := by
        by_contra h_neither
        have hm₀_mem : γ_x u₀ ∈ IsLocalRing.maximalIdeal _ := by
          by_contra h_not
          exact h_neither (Or.inl (IsLocalRing.notMem_maximalIdeal.mp h_not))
        have hm₁_mem : γ_x u₁ ∈ IsLocalRing.maximalIdeal _ := by
          by_contra h_not
          exact h_neither (Or.inr (IsLocalRing.notMem_maximalIdeal.mp h_not))
        have h_sum_mem : γ_x a₀ * γ_x u₀ + γ_x a₁ * γ_x u₁ ∈ IsLocalRing.maximalIdeal _ :=
          Ideal.add_mem _ (Ideal.mul_mem_left _ _ hm₀_mem) (Ideal.mul_mem_left _ _ hm₁_mem)
        rw [h_stalk_eq] at h_sum_mem
        exact (IsLocalRing.notMem_maximalIdeal.mpr (hd_unit.pow r)) h_sum_mem
      rw [sch_bo_mul, sch_bo_mul]
      rcases h_or with hu₀_unit | hu₁_unit
      · exact Or.inl ⟨hx,
          (AlgebraicGeometry.RingedSpace.mem_basicOpen X_s.toRingedSpace u₀ x hxU).mpr hu₀_unit⟩
      · exact Or.inr ⟨hx,
          (AlgebraicGeometry.RingedSpace.mem_basicOpen X_s.toRingedSpace u₁ x hxU).mpr hu₁_unit⟩
    · rw [sch_bo_mul, sch_bo_mul]
      exact sup_le inf_le_left inf_le_left

  
  refine ⟨ι_Xns, hCl_ι, hSurj_qs, hAff_U₀, hPre_U₀, hW₀_decomp, hι_U₀, hKer_ι, hEval_U₀, ?_⟩

  
  intro c_shift hLc L_c D_c U₁_c W₁_c g_c g'_Z ĝ_Y
  have hAff_U₁c : AlgebraicGeometry.IsAffineOpen U₁_c :=
    (hShifted_proj L_c hLc).1.preimage ι_Xns
  have hW₀_φs : W₀_s = (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' 0) := by
    rw [← hPre_U₀, ← hι_U₀]
    rfl
  have hW₁_φs : W₁_c = (TopologicalSpace.Opens.map φ_s.base).obj D_c := rfl
  let ℓ_0c := (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X 0)).hom
    (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F 0) 1 L_c hLc)

  
  have hW₀s_le_D0 : W₀_s ≤ (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' 0) :=
    le_of_eq hW₀_φs
  have h_ℓ0_eval :
      (φ_s.appLE (weilProjBasicOpen F' N' 0) W₀_s hW₀s_le_D0).hom ℓ_0c =
      f₁_s - c_F' c_shift := by
    have h_f1_pull :
        (fst_g.appLE W_compl W₀_s le_rfl).hom
          ((φ.appLE (weilProjBasicOpen ↥V N' 0) W_compl hW_D0).hom
            ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
              (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
                (hX_V 0) 1 (MvPolynomial.X 1) (hX_V 1)))) = f₁_s := by
      rw [hu_V0_X1]
    have h_one_pull :
        (fst_g.appLE W_compl W₀_s le_rfl).hom
          ((φ.appLE (weilProjBasicOpen ↥V N' 0) W_compl hW_D0).hom
            ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
              (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
                (hX_V 0) 1 (MvPolynomial.X 0) (hX_V 0)))) = 1 := by
      have h_φ_one :
          (φ.appLE (weilProjBasicOpen ↥V N' 0) W_compl hW_D0).hom
            ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X 0)).hom
              (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
                (hX_V 0) 1 (MvPolynomial.X 0) (hX_V 0))) = 1 :=
        (congrArg (φ.appLE (weilProjBasicOpen ↥V N' 0) W_compl hW_D0).hom hu_V0_X0).trans
          (map_one _)
      exact (congrArg (fst_g.appLE W_compl W₀_s le_rfl).hom h_φ_one).trans (map_one _)
    exact (hLinEval 0 c_shift hLc W_compl hW_D0 hW₀s_le_D0).trans
      (congrArg₂ Sub.sub h_f1_pull (by rw [h_one_pull, mul_one]))
  have hInter_W₀W₁ : W₀_s ⊓ W₁_c = X_s.basicOpen (f₁_s - c_F' c_shift) := by
    rw [← h_ℓ0_eval]
    have h_bo := AlgebraicGeometry.Scheme.basicOpen_appLE φ_s W₀_s
      (weilProjBasicOpen F' N' 0) hW₀s_le_D0 ℓ_0c
    change X_s.basicOpen ((φ_s.appLE (weilProjBasicOpen F' N' 0) W₀_s hW₀s_le_D0).hom ℓ_0c) =
      W₀_s ⊓ (TopologicalSpace.Opens.map φ_s.base).obj (P_F.left.basicOpen ℓ_0c) at h_bo
    rw [(hShifted_proj L_c hLc).2.2.1 0] at h_bo
    change X_s.basicOpen _ =
      W₀_s ⊓ ((TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' 0) ⊓ W₁_c) at h_bo
    rw [← hW₀_φs, ← inf_assoc, inf_idem] at h_bo
    exact h_bo.symm

  
  have hSubchart_Y : ∀ a : Fin (N' + 1),
      X_s.basicOpen (α₀ eY * α₀ (f_Y a)) ⊓ W₁_c =
      X_s.basicOpen (α₀ eY * α₀ (f_Y a)) ⊓ X_s.basicOpen ĝ_Y := by
    intro a
    let U_Y : C.Opens := C.basicOpen eY
    let y_Y : Fin (N' + 1) → ↑(C.presheaf.obj (Opposite.op U_Y)) :=
      fun b => (C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eY)).op).hom (f_Y b)
    let O_a : C.Opens := C.basicOpen (y_Y a)
    let O_as : X_s.Opens := (TopologicalSpace.Opens.map fst_g.base).obj O_a
    have hOa_eq : O_a = C.basicOpen (eY * f_Y a) := by
      dsimp [O_a, y_Y]
      rw [sch_bo_res, sch_bo_mul]
    have hOas_eq : O_as = X_s.basicOpen (α₀ eY * α₀ (f_Y a)) := by
      dsimp [O_as]
      rw [hOa_eq, ← map_mul]
      have h1 := AlgebraicGeometry.Scheme.basicOpen_appLE fst_g V₀_s V₀ le_rfl (eY * f_Y a)
      change X_s.basicOpen (α₀ (eY * f_Y a)) =
        V₀_s ⊓ (TopologicalSpace.Opens.map fst_g.base).obj (C.basicOpen (eY * f_Y a)) at h1
      rw [h1]
      exact (inf_eq_right.mpr
        ((TopologicalSpace.Opens.map fst_g.base).monotone (C.basicOpen_le (eY * f_Y a)))).symm
    obtain ⟨hOa_le_Da, hOa_eval⟩ := hOpenEval U_Y ψ_Y hψ_Y hφ_Y a (y_Y a) (hψY_X a)
    have hOas_le_Da : O_as ≤ (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' a) :=
      hBasePre a O_a hOa_le_Da
    have hOas_V₀s : O_as ≤ V₀_s :=
      (TopologicalSpace.Opens.map fst_g.base).monotone
        ((C.basicOpen_le (y_Y a)).trans (C.basicOpen_le eY))
    let res_Oas : ↑(X_s.presheaf.obj (Opposite.op V₀_s)) →+*
        ↑(X_s.presheaf.obj (Opposite.op O_as)) :=
      (X_s.presheaf.map (CategoryTheory.homOfLE hOas_V₀s).op).hom
    let w_a : ↑(X_s.presheaf.obj (Opposite.op O_as)) := res_Oas (α₀ (f_Y a))
    have h_pull_yY : ∀ b : Fin (N' + 1),
        (fst_g.appLE O_a O_as le_rfl).hom
          ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le (y_Y a))).op).hom (y_Y b)) =
        res_Oas (α₀ (f_Y b)) := by
      intro b
      dsimp [y_Y, res_Oas, α₀]
      rw [res_comp C (C.basicOpen_le (y_Y a)) (C.basicOpen_le eY)
        ((C.basicOpen_le (y_Y a)).trans (C.basicOpen_le eY))]
      change ((C.presheaf.map (CategoryTheory.homOfLE _).op ≫ fst_g.appLE O_a O_as le_rfl).hom)
        (f_Y b) =
        ((fst_g.appLE V₀ V₀_s le_rfl ≫ X_s.presheaf.map (CategoryTheory.homOfLE hOas_V₀s).op).hom)
          (f_Y b)
      rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
    have h_c_Oas :
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of F')).inv ≫
          snd_g.appLE ⊤ O_as le_top).hom c_shift =
        res_Oas (c₀_s c_shift) :=
      (snd_c_res hOas_V₀s c_shift).symm
    let ℓ_ac := (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X a)).hom
      (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F a) 1 L_c hLc)
    have h_mul_w : ∀ b : Fin (N' + 1),
        (fst_g.appLE O_a O_as le_rfl).hom
          ((φ.appLE (weilProjBasicOpen ↥V N' a) O_a hOa_le_Da).hom
            ((@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_V gV (MvPolynomial.X a)).hom
              (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_V gV _ _
                (hX_V a) 1 (MvPolynomial.X b) (hX_V b)))) * w_a =
        res_Oas (α₀ (f_Y b)) := by
      intro b
      have h_ev := hOa_eval hOa_le_Da 1 (MvPolynomial.X b) (hX_V b) (y_Y b) (hψY_X b)
      rw [pow_one] at h_ev
      have h_ap := congrArg (fst_g.appLE O_a O_as le_rfl).hom h_ev
      rw [map_mul, h_pull_yY a, h_pull_yY b] at h_ap
      exact h_ap
    have h_ℓ_w :
        (φ_s.appLE (weilProjBasicOpen F' N' a) O_as hOas_le_Da).hom ℓ_ac * w_a =
        res_Oas ĝ_Y := by
      rw [hLinEval a c_shift hLc O_a hOa_le_Da hOas_le_Da, sub_mul, mul_assoc,
        h_mul_w 1, h_mul_w 0, h_c_Oas, hfY0, map_pow]
      dsimp [ĝ_Y]
      rw [map_sub, map_mul, map_pow]
    have hUnit_wa : IsUnit w_a := by
      have hOas_le_bo : O_as ≤ X_s.basicOpen (α₀ (f_Y a)) := by
        rw [hOas_eq, sch_bo_mul]
        exact inf_le_right
      have h_eq_res : w_a =
          (X_s.presheaf.map (CategoryTheory.homOfLE hOas_le_bo).op).hom
            ((X_s.presheaf.map (CategoryTheory.homOfLE (X_s.basicOpen_le (α₀ (f_Y a)))).op).hom
              (α₀ (f_Y a))) :=
        (res_comp X_s hOas_le_bo (X_s.basicOpen_le (α₀ (f_Y a))) hOas_V₀s (α₀ (f_Y a))).symm
      rw [h_eq_res]
      exact (AlgebraicGeometry.RingedSpace.isUnit_res_basicOpen X_s.toRingedSpace (α₀ (f_Y a))).map _
    have h_bo_eq :
        X_s.basicOpen ((φ_s.appLE (weilProjBasicOpen F' N' a) O_as hOas_le_Da).hom ℓ_ac * w_a) =
        X_s.basicOpen (res_Oas ĝ_Y) :=
      congrArg (fun z => X_s.basicOpen z) h_ℓ_w
    rw [sch_bo_mul, sch_bo_unit X_s hUnit_wa,
      inf_eq_left.mpr (X_s.basicOpen_le _), sch_bo_res] at h_bo_eq
    have h_bo_lhs :
        X_s.basicOpen ((φ_s.appLE (weilProjBasicOpen F' N' a) O_as hOas_le_Da).hom ℓ_ac) =
        O_as ⊓ W₁_c := by
      have h1 := AlgebraicGeometry.Scheme.basicOpen_appLE φ_s O_as
        (weilProjBasicOpen F' N' a) hOas_le_Da ℓ_ac
      change X_s.basicOpen _ =
        O_as ⊓ (TopologicalSpace.Opens.map φ_s.base).obj (P_F.left.basicOpen ℓ_ac) at h1
      rw [(hShifted_proj L_c hLc).2.2.1 a] at h1
      change X_s.basicOpen _ =
        O_as ⊓ ((TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' a) ⊓ W₁_c) at h1
      rw [← inf_assoc, inf_eq_left.mpr hOas_le_Da] at h1
      exact h1
    rw [h_bo_lhs, hOas_eq] at h_bo_eq
    exact h_bo_eq

  
  have hCov_Xs : V₀_s ⊔ V₁_s = ⊤ := by
    change (TopologicalSpace.Opens.map fst_g.base).obj (V₀ ⊔ V₁) = ⊤
    rw [hCov_V]
    rfl
  have hbo_h₀s : X_s.basicOpen (α₀ h₀) = V₀_s ⊓ V₁_s := by
    have h1 := AlgebraicGeometry.Scheme.basicOpen_appLE fst_g V₀_s V₀ le_rfl h₀
    change X_s.basicOpen (α₀ h₀) =
      V₀_s ⊓ (TopologicalSpace.Opens.map fst_g.base).obj (C.basicOpen h₀) at h1
    rw [hbo_h₀] at h1
    change X_s.basicOpen (α₀ h₀) = V₀_s ⊓ (V₀_s ⊓ V₁_s) at h1
    rw [h1, ← inf_assoc, inf_idem]
  have hV₀s_split : V₀_s = X_s.basicOpen (α₀ eZ) ⊔ X_s.basicOpen (α₀ eY) := by
    have h1_mem : (1 : ↑(X_s.presheaf.obj (Opposite.op V₀_s))) ^ 1 ∈
        Ideal.span ({α₀ eZ, α₀ eY} : Set ↑(X_s.presheaf.obj (Opposite.op V₀_s))) := by
      rw [pow_one, Ideal.mem_span_pair]
      refine ⟨1, 1, ?_⟩
      have h_ap := congrArg α₀ he_sum
      rw [map_add, map_one] at h_ap
      simpa using h_ap
    have h_sp := hSpanSplit V₀_s 1 (α₀ eZ) (α₀ eY) 1 h1_mem
    rw [sch_bo_unit X_s isUnit_one, one_mul, one_mul] at h_sp
    exact h_sp
  have hCov3 : V₁_s ⊔ X_s.basicOpen (α₀ eZ) ⊔ X_s.basicOpen (α₀ eY) = ⊤ := by
    rw [sup_assoc, ← hV₀s_split, sup_comm, hCov_Xs]
  have h_ru_Xs : (α₀ eY) ^ r_u ∈
      Ideal.span ({α₀ (f_Y 0), α₀ (f_Y 1)} : Set ↑(X_s.presheaf.obj (Opposite.op V₀_s))) := by
    obtain ⟨a₀, a₁, ha_eq⟩ := Ideal.mem_span_pair.mp hru
    rw [Ideal.mem_span_pair]
    refine ⟨α₀ a₀, α₀ a₁, ?_⟩
    have h_ap := congrArg α₀ ha_eq
    simpa [map_add, map_mul, map_pow] using h_ap
  have heY_split_fY :
      X_s.basicOpen (α₀ eY) =
      X_s.basicOpen (α₀ eY * α₀ (f_Y 0)) ⊔ X_s.basicOpen (α₀ eY * α₀ (f_Y 1)) :=
    hSpanSplit V₀_s (α₀ eY) (α₀ (f_Y 0)) (α₀ (f_Y 1)) r_u h_ru_Xs
  have heY_split_gY :
      X_s.basicOpen (α₀ eY) =
      X_s.basicOpen (α₀ eY * α₀ (f_Y 0)) ⊔ X_s.basicOpen (α₀ eY * ĝ_Y) := by
    apply hSpanSplit V₀_s (α₀ eY) (α₀ (f_Y 0)) ĝ_Y r_u
    refine (Ideal.span_le.mpr ?_) h_ru_Xs
    rintro x (rfl | h_eq1)
    · exact Ideal.subset_span (Or.inl rfl)
    · rw [Set.mem_singleton_iff.mp h_eq1]
      change α₀ (f_Y 1) ∈ Ideal.span ({α₀ (f_Y 0), ĝ_Y} : Set ↑(X_s.presheaf.obj (Opposite.op V₀_s)))
      rw [Ideal.mem_span_pair]
      refine ⟨c₀_s c_shift, 1, ?_⟩
      dsimp [ĝ_Y]
      rw [hfY0, map_pow]
      ring

  
  have hv₁_W₀ : V₁_s ≤ W₀_s := by rw [hW₀_decomp]; exact le_sup_left
  have hPiece1 : V₁_s ⊓ W₁_c = X_s.basicOpen g_c := by
    calc
      V₁_s ⊓ W₁_c = V₁_s ⊓ (W₀_s ⊓ W₁_c) := by rw [← inf_assoc, inf_eq_left.mpr hv₁_W₀]
      _ = V₁_s ⊓ X_s.basicOpen (f₁_s - c_F' c_shift) := by rw [hInter_W₀W₁]
      _ = X_s.basicOpen ((X_s.presheaf.map (CategoryTheory.homOfLE hv₁_W₀).op).hom
            (f₁_s - c_F' c_shift)) := (sch_bo_res X_s hv₁_W₀ _).symm
      _ = X_s.basicOpen g_c := by
          congr 1
          rw [map_sub]
          have h_f1 : (X_s.presheaf.map (CategoryTheory.homOfLE hv₁_W₀).op).hom f₁_s =
              α₁ (f 1) := by
            rw [← hf₁_V₁]
            dsimp [f₁_s, α₁]
            change ((fst_g.appLE W_compl W₀_s le_rfl ≫
              X_s.presheaf.map (CategoryTheory.homOfLE hv₁_W₀).op).hom) f₁_gl =
              ((C.presheaf.map (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ W_compl)).op ≫
                fst_g.appLE V₁ V₁_s le_rfl).hom) f₁_gl
            rw [AlgebraicGeometry.Scheme.Hom.appLE_map, AlgebraicGeometry.Scheme.Hom.map_appLE]
          have h_c1 : (X_s.presheaf.map (CategoryTheory.homOfLE hv₁_W₀).op).hom (c_F' c_shift) =
              c₁_s c_shift :=
            snd_c_res hv₁_W₀ c_shift
          rw [h_f1, h_c1]

  
  have heZ_W₀ : X_s.basicOpen (α₀ eZ) ≤ W₀_s := by rw [hW₀_decomp]; exact le_sup_right
  have hPiece2 : X_s.basicOpen (α₀ eZ) ⊓ W₁_c = X_s.basicOpen (α₀ eZ * g'_Z) := by
    let U_Zs : X_s.Opens := X_s.basicOpen (α₀ eZ)
    let res_UZs : ↑(X_s.presheaf.obj (Opposite.op V₀_s)) →+*
        ↑(X_s.presheaf.obj (Opposite.op U_Zs)) :=
      (X_s.presheaf.map (CategoryTheory.homOfLE (X_s.basicOpen_le (α₀ eZ))).op).hom
    let u_Zs : ↑(X_s.presheaf.obj (Opposite.op U_Zs)) := res_UZs ((α₀ eZ) ^ m₀)
    have hUnit_uZs : IsUnit u_Zs := by
      dsimp [u_Zs, res_UZs]
      rw [map_pow]
      exact (AlgebraicGeometry.RingedSpace.isUnit_res_basicOpen X_s.toRingedSpace (α₀ eZ)).pow m₀
    have h_s_mul :
        (X_s.presheaf.map (CategoryTheory.homOfLE heZ_W₀).op).hom (f₁_s - c_F' c_shift) * u_Zs =
        res_UZs g'_Z := by
      rw [map_sub, sub_mul]
      have h_UZs_eq : U_Zs = (TopologicalSpace.Opens.map fst_g.base).obj (C.basicOpen eZ) := by
        have h1 := AlgebraicGeometry.Scheme.basicOpen_appLE fst_g V₀_s V₀ le_rfl eZ
        change U_Zs = V₀_s ⊓ (TopologicalSpace.Opens.map fst_g.base).obj (C.basicOpen eZ) at h1
        rw [h1, inf_eq_right]
        exact (TopologicalSpace.Opens.map fst_g.base).monotone (C.basicOpen_le eZ)
      have h_le_UZ : U_Zs ≤ (TopologicalSpace.Opens.map fst_g.base).obj (C.basicOpen eZ) :=
        le_of_eq h_UZs_eq
      have h_f1_eZ :
          (X_s.presheaf.map (CategoryTheory.homOfLE heZ_W₀).op).hom f₁_s * u_Zs =
          res_UZs (α₀ (f_Z 1)) := by
        have h_ap := congrArg (fst_g.appLE (C.basicOpen eZ) U_Zs h_le_UZ).hom hf₁_Z
        rw [map_mul] at h_ap
        have hl1 : (fst_g.appLE (C.basicOpen eZ) U_Zs h_le_UZ).hom
            ((C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : C.basicOpen eZ ≤ W_compl)).op).hom
              f₁_gl) =
            (X_s.presheaf.map (CategoryTheory.homOfLE heZ_W₀).op).hom f₁_s := by
          dsimp [f₁_s]
          change ((C.presheaf.map (CategoryTheory.homOfLE (le_sup_right : C.basicOpen eZ ≤ W_compl)).op ≫
            fst_g.appLE (C.basicOpen eZ) U_Zs h_le_UZ).hom) f₁_gl =
            ((fst_g.appLE W_compl W₀_s le_rfl ≫
              X_s.presheaf.map (CategoryTheory.homOfLE heZ_W₀).op).hom) f₁_gl
          rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
        have hl2 : ∀ z : ↑(C.presheaf.obj (Opposite.op V₀)),
            (fst_g.appLE (C.basicOpen eZ) U_Zs h_le_UZ).hom
              ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op).hom z) =
            res_UZs (α₀ z) := by
          intro z
          dsimp [res_UZs, α₀]
          change ((C.presheaf.map (CategoryTheory.homOfLE (C.basicOpen_le eZ)).op ≫
            fst_g.appLE (C.basicOpen eZ) U_Zs h_le_UZ).hom) z =
            ((fst_g.appLE V₀ V₀_s le_rfl ≫
              X_s.presheaf.map (CategoryTheory.homOfLE (X_s.basicOpen_le (α₀ eZ))).op).hom) z
          rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
        rw [hl1, hl2 (eZ ^ m₀), hl2 (f_Z 1), map_pow] at h_ap
        exact h_ap
      have h_c_eZ :
          (X_s.presheaf.map (CategoryTheory.homOfLE heZ_W₀).op).hom (c_F' c_shift) =
          res_UZs (c₀_s c_shift) :=
        (snd_c_res heZ_W₀ c_shift).trans (snd_c_res (X_s.basicOpen_le (α₀ eZ)) c_shift).symm
      rw [h_f1_eZ, h_c_eZ]
      dsimp [g'_Z, u_Zs]
      rw [map_sub, map_mul]
    calc
      U_Zs ⊓ W₁_c = U_Zs ⊓ (W₀_s ⊓ W₁_c) := by rw [← inf_assoc, inf_eq_left.mpr heZ_W₀]
      _ = U_Zs ⊓ X_s.basicOpen (f₁_s - c_F' c_shift) := by rw [hInter_W₀W₁]
      _ = X_s.basicOpen ((X_s.presheaf.map (CategoryTheory.homOfLE heZ_W₀).op).hom
            (f₁_s - c_F' c_shift)) := (sch_bo_res X_s heZ_W₀ _).symm
      _ = X_s.basicOpen (((X_s.presheaf.map (CategoryTheory.homOfLE heZ_W₀).op).hom
            (f₁_s - c_F' c_shift)) * u_Zs) := by
          rw [sch_bo_mul, sch_bo_unit X_s hUnit_uZs, inf_eq_left.mpr (X_s.basicOpen_le _)]
      _ = X_s.basicOpen (res_UZs g'_Z) := by rw [h_s_mul]
      _ = U_Zs ⊓ X_s.basicOpen g'_Z := sch_bo_res X_s (X_s.basicOpen_le (α₀ eZ)) g'_Z
      _ = X_s.basicOpen (α₀ eZ * g'_Z) := (sch_bo_mul X_s (α₀ eZ) g'_Z).symm

  
  have hPiece3 : X_s.basicOpen (α₀ eY) ⊓ W₁_c = X_s.basicOpen (α₀ eY * ĝ_Y) := by
    calc
      X_s.basicOpen (α₀ eY) ⊓ W₁_c
        = (X_s.basicOpen (α₀ eY * α₀ (f_Y 0)) ⊔ X_s.basicOpen (α₀ eY * α₀ (f_Y 1))) ⊓ W₁_c := by
          rw [← heY_split_fY]
      _ = (X_s.basicOpen (α₀ eY * α₀ (f_Y 0)) ⊓ W₁_c) ⊔
            (X_s.basicOpen (α₀ eY * α₀ (f_Y 1)) ⊓ W₁_c) := inf_sup_right _ _ _
      _ = (X_s.basicOpen (α₀ eY * α₀ (f_Y 0)) ⊓ X_s.basicOpen ĝ_Y) ⊔
            (X_s.basicOpen (α₀ eY * α₀ (f_Y 1)) ⊓ X_s.basicOpen ĝ_Y) := by
          rw [hSubchart_Y 0, hSubchart_Y 1]
      _ = (X_s.basicOpen (α₀ eY * α₀ (f_Y 0)) ⊔ X_s.basicOpen (α₀ eY * α₀ (f_Y 1))) ⊓
            X_s.basicOpen ĝ_Y := (inf_sup_right _ _ _).symm
      _ = X_s.basicOpen (α₀ eY) ⊓ X_s.basicOpen ĝ_Y := by rw [← heY_split_fY]
      _ = X_s.basicOpen (α₀ eY * ĝ_Y) := (sch_bo_mul X_s (α₀ eY) ĝ_Y).symm

  
  have hW₁_decomp :
      W₁_c = X_s.basicOpen g_c ⊔ X_s.basicOpen (α₀ eZ * g'_Z) ⊔ X_s.basicOpen (α₀ eY * ĝ_Y) := by
    calc
      W₁_c = ⊤ ⊓ W₁_c := (top_inf_eq W₁_c).symm
      _ = (V₁_s ⊔ X_s.basicOpen (α₀ eZ) ⊔ X_s.basicOpen (α₀ eY)) ⊓ W₁_c := by rw [hCov3]
      _ = ((V₁_s ⊔ X_s.basicOpen (α₀ eZ)) ⊓ W₁_c) ⊔ (X_s.basicOpen (α₀ eY) ⊓ W₁_c) :=
          inf_sup_right _ _ _
      _ = (V₁_s ⊓ W₁_c) ⊔ (X_s.basicOpen (α₀ eZ) ⊓ W₁_c) ⊔ (X_s.basicOpen (α₀ eY) ⊓ W₁_c) := by
          rw [inf_sup_right]
      _ = X_s.basicOpen g_c ⊔ X_s.basicOpen (α₀ eZ * g'_Z) ⊔ X_s.basicOpen (α₀ eY * ĝ_Y) := by
          rw [hPiece1, hPiece2, hPiece3]

  
  have hOv₁ : X_s.basicOpen (α₀ h₀ * (α₀ eZ * g'_Z)) ≤ X_s.basicOpen g_c := by
    rw [sch_bo_mul, ← hPiece1]
    refine inf_le_inf (by rw [hbo_h₀s]; exact inf_le_right) ?_
    rw [hW₁_decomp]
    exact le_sup_right.trans le_sup_left
  have hOv₂ : X_s.basicOpen (α₀ h₀ * (α₀ eY * ĝ_Y)) ≤ X_s.basicOpen g_c := by
    rw [sch_bo_mul, ← hPiece1]
    refine inf_le_inf (by rw [hbo_h₀s]; exact inf_le_right) ?_
    rw [hW₁_decomp]
    exact le_sup_right

  
  have hW01_top : W₀_s ⊔ W₁_c = ⊤ := by
    apply top_unique
    rw [← hCov3]
    refine sup_le (sup_le (hv₁_W₀.trans le_sup_left) (heZ_W₀.trans le_sup_left)) ?_
    rw [heY_split_gY]
    refine sup_le ?_ ?_
    · rw [sch_bo_mul, hfY0, map_pow, sch_bo_pow X_s (α₀ h₀) m₀ hm₀, hbo_h₀s]
      exact inf_le_right.trans (inf_le_right.trans (hv₁_W₀.trans le_sup_left))
    · refine le_trans ?_ le_sup_right
      rw [hW₁_decomp]
      exact le_sup_right
  have hCov_U₀U₁ : U₀_s ⊔ U₁_c = ⊤ := by
    apply top_unique
    intro y _hy
    obtain ⟨x, rfl⟩ := q_s.surjective y
    have hx_top : x ∈ (⊤ : X_s.Opens) := trivial
    rw [← hW01_top, ← hPre_U₀] at hx_top
    exact hx_top

  
  refine ⟨hAff_U₁c, hCov_U₀U₁, hInter_W₀W₁, hW₁_decomp, hOv₁, hOv₂, ?_⟩
  intro hgc r P hP
  let U_gc : X_s.Opens := X_s.basicOpen g_c
  have hgc_D0 : U_gc ≤ (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' 0) :=
    (X_s.basicOpen_le g_c).trans hV₁s_le_D0
  have hgc_Dc : U_gc ≤ (TopologicalSpace.Opens.map φ_s.base).obj D_c := hgc
  have hgc_inter :
      U_gc ≤ (TopologicalSpace.Opens.map φ_s.base).obj (weilProjBasicOpen F' N' 0 ⊓ D_c) :=
    le_inf hgc_D0 hgc_Dc
  have h_coc := congrArg
    (φ_s.appLE (weilProjBasicOpen F' N' 0 ⊓ D_c) U_gc hgc_inter).hom
    ((hShifted_proj L_c hLc).2.2.2 0 r P hP)
  rw [map_mul, map_pow] at h_coc
  let u_Lc := (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF L_c).hom
    (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ hLc r P hP)
  let u_0P := (@AlgebraicGeometry.Proj.awayToSection _ _ _ _ _ 𝒜_F gF (MvPolynomial.X 0)).hom
    (@HomogeneousLocalization.Away.mk _ _ _ _ _ _ _ _ 𝒜_F gF _ _ (hX_F 0) r P hP)
  have h_fac1 :
      (φ_s.appLE (weilProjBasicOpen F' N' 0 ⊓ D_c) U_gc hgc_inter).hom
        ((P_F.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_right : weilProjBasicOpen F' N' 0 ⊓ D_c ≤ D_c)).op).hom
          u_Lc) =
      (X_s.presheaf.map (CategoryTheory.homOfLE hgc).op).hom
        ((q_s.appLE U₁_c W₁_c le_rfl).hom ((ι_Xns.app D_c).hom u_Lc)) := by
    change ((P_F.left.presheaf.map
      (CategoryTheory.homOfLE (inf_le_right : weilProjBasicOpen F' N' 0 ⊓ D_c ≤ D_c)).op ≫
      φ_s.appLE (weilProjBasicOpen F' N' 0 ⊓ D_c) U_gc hgc_inter).hom) u_Lc = _
    rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
    change (φ_s.appLE D_c U_gc hgc_Dc).hom u_Lc =
      (((ι_Xns.appLE D_c U₁_c le_rfl ≫ q_s.appLE U₁_c W₁_c le_rfl) ≫
        X_s.presheaf.map (CategoryTheory.homOfLE hgc).op).hom) u_Lc
    rw [AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
  have h_left_res : ∀ z : ↑(P_F.left.presheaf.obj (Opposite.op (weilProjBasicOpen F' N' 0))),
      (φ_s.appLE (weilProjBasicOpen F' N' 0 ⊓ D_c) U_gc hgc_inter).hom
        ((P_F.left.presheaf.map
          (CategoryTheory.homOfLE
            (inf_le_left : weilProjBasicOpen F' N' 0 ⊓ D_c ≤ weilProjBasicOpen F' N' 0)).op).hom z) =
      (X_s.presheaf.map (CategoryTheory.homOfLE (X_s.basicOpen_le g_c)).op).hom
        ((φ_s.appLE (weilProjBasicOpen F' N' 0) V₁_s hV₁s_le_D0).hom z) := by
    intro z
    change ((P_F.left.presheaf.map
      (CategoryTheory.homOfLE
        (inf_le_left : weilProjBasicOpen F' N' 0 ⊓ D_c ≤ weilProjBasicOpen F' N' 0)).op ≫
      φ_s.appLE (weilProjBasicOpen F' N' 0 ⊓ D_c) U_gc hgc_inter).hom) z =
      ((φ_s.appLE (weilProjBasicOpen F' N' 0) V₁_s hV₁s_le_D0 ≫
        X_s.presheaf.map (CategoryTheory.homOfLE (X_s.basicOpen_le g_c)).op).hom) z
    rw [AlgebraicGeometry.Scheme.Hom.map_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
  have hLc_eval_V₁s : MvPolynomial.eval₂Hom c₁_s (α₁ ∘ f) L_c = g_c := by
    dsimp [L_c, g_c]
    simp [hf0]
  rw [h_fac1, h_left_res ℓ_0c, h_left_res u_0P,
    hV₁s_eval_F 1 L_c hLc, hLc_eval_V₁s, hV₁s_eval_F r P hP] at h_coc
  exact h_coc

theorem weil_sup1_fiber_shifted_chart_ring_bijections (K : Type u) [Field K] [IsSepClosed K] (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
