            ((x_F⁻¹) ^ (d - (j : ℕ)) * x_F ^ (d - (j : ℕ))) * x_F ^ (j : ℕ) := by ring
      _ = ι (Polynomial.C (Q.coeff (j : ℕ))) * x_F ^ (j : ℕ) := by rw [hcancel, mul_one]
  have hEvalSelf : ∀ (d : ℕ) (Q : Polynomial K),
