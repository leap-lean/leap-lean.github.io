    have _ : Algebra.Etale N_bar B_bar := RingHom.etale_algebraMap.mp hEt₂
    let _ : Algebra (IsLocalRing.ResidueField R) B_bar :=
      (ψ₂.comp (algebraMap (IsLocalRing.ResidueField R) N_bar)).toAlgebra
    have _ : IsScalarTower (IsLocalRing.ResidueField R) N_bar B_bar :=
      ⟨fun c y z => by
        rw [Algebra.smul_def c y]
        change ψ₂ (algebraMap (IsLocalRing.ResidueField R) N_bar c * y) * z =
          ψ₂ (algebraMap (IsLocalRing.ResidueField R) N_bar c) * (ψ₂ y * z)
        rw [map_mul, mul_assoc]⟩
    have _ : q_B.asIdeal.LiesOver m_nod := Ideal.LiesOver.mk rfl
    let _ : Algebra (Localization.AtPrime m_nod) (Localization.AtPrime q_B.asIdeal) :=
      Localization.AtPrime.algebraOfLiesOver m_nod q_B.asIdeal
    let _ : IsScalarTower N_bar (Localization.AtPrime m_nod) (Localization.AtPrime q_B.asIdeal) :=
      Localization.AtPrime.instIsScalarTower m_nod q_B.asIdeal
    have hSurj_k₀_mnod :
        Function.Surjective (algebraMap (IsLocalRing.ResidueField R) m_nod.ResidueField) := by
      intro w
      obtain ⟨z, rfl⟩ := Ideal.algebraMap_residueField_surjective m_nod w
      refine ⟨ev_nod z, ?_⟩
      rw [IsScalarTower.algebraMap_apply (IsLocalRing.ResidueField R) N_bar
        m_nod.ResidueField (ev_nod z)]
      have h_diff_ker : z - algebraMap (IsLocalRing.ResidueField R) N_bar (ev_nod z) ∈ m_nod := by
        rw [← h_ker_eq_m, RingHom.mem_ker, map_sub]
        have hev_alg : ev_nod (algebraMap (IsLocalRing.ResidueField R) N_bar (ev_nod z)) =
            ev_nod z :=
          MvPolynomial.constantCoeff_C (Fin 2) (ev_nod z)
        rw [hev_alg, sub_self]
      have h_zero :
          algebraMap N_bar m_nod.ResidueField
            (z - algebraMap (IsLocalRing.ResidueField R) N_bar (ev_nod z)) = 0 := by
        rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField m_nod]
        exact h_diff_ker
      rw [map_sub, sub_eq_zero] at h_zero
      exact h_zero.symm
    have _ : Module.Finite (IsLocalRing.ResidueField R) m_nod.ResidueField :=
      Module.Finite.of_surjective
        (Algebra.linearMap (IsLocalRing.ResidueField R) m_nod.ResidueField) hSurj_k₀_mnod
    have _ : Module.Finite (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField :=
      Module.Finite.trans m_nod.ResidueField q_B.asIdeal.ResidueField
    have _ : Algebra.IsIntegral (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField :=
      Algebra.IsIntegral.of_finite (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField
    let e_res : IsLocalRing.ResidueField R ≃+* q_B.asIdeal.ResidueField :=
      RingEquiv.ofBijective
        (algebraMap (IsLocalRing.ResidueField R) q_B.asIdeal.ResidueField)
        IsAlgClosed.algebraMap_bijective_of_isIntegral
    let ε₀ : B_bar →+* IsLocalRing.ResidueField R :=
      e_res.symm.toRingHom.comp (algebraMap B_bar q_B.asIdeal.ResidueField)
    have hKer_ε₀ : RingHom.ker ε₀ = q_B.asIdeal := by
      ext b
      change e_res.symm (algebraMap B_bar q_B.asIdeal.ResidueField b) = 0 ↔ b ∈ q_B.asIdeal
      rw [RingEquiv.symm_apply_eq, map_zero, ← RingHom.mem_ker,
        Ideal.ker_algebraMap_residueField q_B.asIdeal]
    have hAug : ε₀.comp (ψ₂.comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C)) =
        RingHom.id (IsLocalRing.ResidueField R) := by
      ext c
      change e_res.symm
        (algebraMap B_bar q_B.asIdeal.ResidueField
          (algebraMap (IsLocalRing.ResidueField R) B_bar c)) = c
      rw [← IsScalarTower.algebraMap_apply (IsLocalRing.ResidueField R) B_bar
        q_B.asIdeal.ResidueField c]
      exact e_res.symm_apply_apply c
    have hX₀ : ∀ i : Fin 2, ε₀ (ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.X i))) = 0 := by
      intro i
      rw [← RingHom.mem_ker, hKer_ε₀]
      exact hX_mem i
    refine ⟨A_R, inferInstance, inferInstance, ι_C, p_A, B_bar, inferInstance, ψ₁, ψ₂, ε₀,
      hOpen_ιC, hComm_ιC, hp_A, hFlat_A, hFP_A, hEt₁, hEt₂, ?_, hAug, hX₀, ?_⟩
    · let c_nod : IsLocalRing.ResidueField R →+* N_bar :=
        (Ideal.Quotient.mk I_nod).comp MvPolynomial.C
      have h_spec_eq :
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ₁.comp (π_A.comp (algebraMap R A_R)))) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((ψ₂.comp c_nod).comp (IsLocalRing.residue R))) := by
        have lhs_eq :
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (ψ₁.comp (π_A.comp (algebraMap R A_R)))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
              (AlgebraicGeometry.Spec.map inl_ring ≫ (ι_C ≫ g_R)) := by
          rw [hComm_ιC, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have rhs_eq :
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((ψ₂.comp c_nod).comp (IsLocalRing.residue R))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) ≫ s₀ := by
          dsimp only [s₀]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        rw [lhs_eq, rhs_eq]
        calc
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
              (AlgebraicGeometry.Spec.map inl_ring ≫ (ι_C ≫ g_R))
            = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
                ((AlgebraicGeometry.Spec.map inl_ring ≫ ι_C) ≫ g_R) := by
              simp only [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
                ((ι_A0 ≫ CategoryTheory.Limits.pullback.fst g_R s₀) ≫ g_R) := by
              rw [← h_ιA0_fst]
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ ι_A0) ≫
                (CategoryTheory.Limits.pullback.fst g_R s₀ ≫ g_R) := by
              simp only [CategoryTheory.Category.assoc]
          _ = (ι_U ≫ e₁) ≫ (CategoryTheory.Limits.pullback.snd g_R s₀ ≫ s₀) := by
              rw [hψ₁_map, hf₁_fac, CategoryTheory.Limits.pullback.condition]
          _ = ι_U ≫ (e₁ ≫ CategoryTheory.Limits.pullback.snd g_R s₀) ≫ s₀ := by
              simp only [CategoryTheory.Category.assoc]
          _ = ι_U ≫ (e₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod)) ≫ s₀ := by
              rw [hComm_k₀]
          _ = (ι_U ≫ e₂) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) ≫ s₀ := by
              simp only [CategoryTheory.Category.assoc]
          _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_nod) ≫ s₀ := by
              rw [← hψ₂_map]
      have h_pre := congrArg (fun f => (AlgebraicGeometry.Spec.preimage f).hom) h_spec_eq
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at h_pre
      exact h_pre
    · rw [hKer_ε₀, ← Ideal.comap_comap, hComap_ψ₁]
      exact congrArg PrimeSpectrum.asIdeal hy_A_pA

  
  have hStage2 :
      ∀ (A A_bar B_bar : Type u) [CommRing A] [CommRing A_bar] [CommRing B_bar]
        (q : A →+* A_bar), Function.Surjective q →
        ∀ (ψ : A_bar →+* B_bar), RingHom.Etale ψ →
        ∃ (A' : Type u) (_ : CommRing A') (ι_A : A →+* A') (q' : A' →+* B_bar),
          RingHom.Etale ι_A ∧
          Function.Surjective q' ∧
          q'.comp ι_A = ψ.comp q ∧
          RingHom.ker q' = Ideal.map ι_A (RingHom.ker q) := by
    clear! R C_R pderiv_X_eq_ite pderiv_rename_of_injective pderiv_rename_of_ne
    intro A A_bar B_bar _ _ _ q hq ψ hEt
    let _ : Algebra A_bar B_bar := ψ.toAlgebra
    have _ : Algebra.Etale A_bar B_bar := RingHom.etale_algebraMap.mp hEt
    obtain ⟨r, P, hP_map⟩ := exists_fin_id_submersivePresentation A_bar B_bar
    have hmap_surj : Function.Surjective
        (MvPolynomial.map q : MvPolynomial (Fin r) A →+* MvPolynomial (Fin r) A_bar) :=
      MvPolynomial.map_surjective q hq
    choose g hg using fun j : Fin r => hmap_surj (P.relation j)
    let I₀ : Ideal (MvPolynomial (Fin r) A) := Ideal.span (Set.range g)
    let A₀ : Type u := MvPolynomial (Fin r) A ⧸ I₀
    let P₀ : Algebra.PreSubmersivePresentation A A₀ (Fin r) (Fin r) :=
      Algebra.PreSubmersivePresentation.naive (v := g) id Function.injective_id
    let δ₀ : A₀ := P₀.jacobian
    let A' : Type u := Localization.Away δ₀
    let ι_A : A →+* A' := algebraMap A A'
    have hEt_ιA : RingHom.Etale ι_A := by
      let Q_loc : Algebra.PreSubmersivePresentation A₀ A' Unit Unit :=
        Algebra.PreSubmersivePresentation.localizationAway A' δ₀
      let Q_comp : Algebra.PreSubmersivePresentation A A' (Unit ⊕ Fin r) (Unit ⊕ Fin r) :=
        Q_loc.comp P₀
      have hDim_comp : Q_comp.dimension = 0 := by
        rw [Algebra.PreSubmersivePresentation.dimension_comp_eq_dimension_add_dimension]
        have hd1 : Q_loc.dimension = 0 := by simp [Algebra.Presentation.dimension]
        have hd2 : P₀.dimension = 0 := by simp [Algebra.Presentation.dimension]
        omega
      have hUnit_δ₀ : IsUnit (algebraMap A₀ A' δ₀) :=
        IsLocalization.Away.algebraMap_isUnit δ₀
      have hJac_comp : IsUnit Q_comp.jacobian := by
        rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
          Algebra.PreSubmersivePresentation.localizationAway_jacobian, Algebra.smul_def]
        exact hUnit_δ₀.mul hUnit_δ₀
      let S_comp : Algebra.SubmersivePresentation A A' (Unit ⊕ Fin r) (Unit ⊕ Fin r) :=
        { toPreSubmersivePresentation := Q_comp
          jacobian_isUnit := hJac_comp }
      have hSm0 : Algebra.IsStandardSmoothOfRelativeDimension 0 A A' :=
        S_comp.isStandardSmoothOfRelativeDimension hDim_comp
      have hAlgEt : Algebra.Etale A A' :=
        Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr hSm0
      exact RingHom.etale_algebraMap.mpr hAlgEt
    let aeval_P : MvPolynomial (Fin r) A_bar →ₐ[A_bar] B_bar := MvPolynomial.aeval P.val
    have haeval_surj : Function.Surjective aeval_P := fun b => ⟨P.σ' b, P.aeval_val_σ' b⟩
    have haeval_ker : RingHom.ker aeval_P.toRingHom = Ideal.span (Set.range P.relation) := by
      rw [P.span_range_relation_eq_ker]
      ext p
      let _ : Algebra (MvPolynomial (Fin r) A_bar) B_bar := P.algebra
      change aeval_P p = 0 ↔ p ∈ RingHom.ker (algebraMap (MvPolynomial (Fin r) A_bar) B_bar)
      rw [RingHom.mem_ker, P.algebraMap_eq]
      rfl
    let Φ₀ : MvPolynomial (Fin r) A →+* B_bar := aeval_P.toRingHom.comp (MvPolynomial.map q)
    have hI₀_le : I₀ ≤ RingHom.ker Φ₀ := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker, Φ₀, RingHom.comp_apply, hg j]
      have hmem : P.relation j ∈ RingHom.ker aeval_P.toRingHom := by
        rw [haeval_ker]
        exact Ideal.subset_span ⟨j, rfl⟩
      exact hmem
    let q₀ : A₀ →+* B_bar := Ideal.Quotient.lift I₀ Φ₀ (fun p hp => hI₀_le hp)
    have hq₀_surj : Function.Surjective q₀ := by
      intro b
      obtain ⟨p_bar, hp_bar⟩ := haeval_surj b
      obtain ⟨p, hp⟩ := hmap_surj p_bar
      refine ⟨Ideal.Quotient.mk I₀ p, ?_⟩
      change aeval_P (MvPolynomial.map q p) = b
      rw [hp, hp_bar]
    have hq₀_alg : ∀ a : A, q₀ (algebraMap A A₀ a) = ψ (q a) := by
      intro a
      change aeval_P (MvPolynomial.map q (MvPolynomial.C a)) = ψ (q a)
      rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
      rfl
    have hP₀_rel : P₀.relation = g := rfl
    have hP₀_map : P₀.map = id := rfl
    have hMat_eq : (MvPolynomial.map q).mapMatrix P₀.jacobiMatrix = P.jacobiMatrix := by
      refine Matrix.ext fun i j => ?_
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply,
        hP₀_map, hP_map, id_eq, hP₀_rel]
      rw [← MvPolynomial.pderiv_map, hg j]
    have hq₀_δ₀ : q₀ δ₀ = P.jacobian := by
      let _ : Algebra (MvPolynomial (Fin r) A) A₀ := P₀.algebra
      let _ : Algebra (MvPolynomial (Fin r) A_bar) B_bar := P.algebra
      have hδ₀_det : δ₀ = Ideal.Quotient.mk I₀ P₀.jacobiMatrix.det := by
        dsimp only [δ₀]
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
        rfl
      have hP_det : P.jacobian = aeval_P P.jacobiMatrix.det := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, P.algebraMap_eq]
        rfl
      rw [hδ₀_det, hP_det]
      change aeval_P (MvPolynomial.map q P₀.jacobiMatrix.det) = aeval_P P.jacobiMatrix.det
      rw [(MvPolynomial.map q).map_det, hMat_eq]
    have hUnit_q₀_δ₀ : IsUnit (q₀ δ₀) := hq₀_δ₀ ▸ P.jacobian_isUnit
    let q' : A' →+* B_bar := IsLocalization.Away.lift δ₀ hUnit_q₀_δ₀
    have hq'_eq : ∀ x : A₀, q' (algebraMap A₀ A' x) = q₀ x :=
      fun x => IsLocalization.Away.lift_eq δ₀ hUnit_q₀_δ₀ x
    have hq'_surj : Function.Surjective q' := by
      intro b
      obtain ⟨x, rfl⟩ := hq₀_surj b
      exact ⟨algebraMap A₀ A' x, hq'_eq x⟩
    have hq'_comp : q'.comp ι_A = ψ.comp q := by
      ext a
      simp only [RingHom.comp_apply, ι_A]
      rw [IsScalarTower.algebraMap_apply A A₀ A' a, hq'_eq, hq₀_alg]
    have hq'_ker : RingHom.ker q' = Ideal.map ι_A (RingHom.ker q) := by
      apply le_antisymm
      · intro z hz
        obtain ⟨⟨x₀, ⟨_, k, rfl⟩⟩, hzk⟩ := IsLocalization.surj (Submonoid.powers δ₀) z
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x₀
        have hz0 : q' z = 0 := hz
        have hΦf0 : aeval_P (MvPolynomial.map q f) = 0 := by
          have h1 := congrArg q' hzk
          rw [map_mul, hz0, zero_mul, hq'_eq] at h1
          exact h1.symm
        have hmap_mem : MvPolynomial.map q f ∈ Ideal.map (MvPolynomial.map q) I₀ := by
          have hmem_ker : MvPolynomial.map q f ∈ Ideal.span (Set.range P.relation) := by
            rw [← haeval_ker]
            exact hΦf0
          have hspan_eq : Ideal.span (Set.range P.relation) = Ideal.map (MvPolynomial.map q) I₀ := by
            dsimp only [I₀]
            rw [Ideal.map_span]
            congr 1
            ext p_bar
            simp only [Set.mem_range, Set.mem_image]
            constructor
            · rintro ⟨j, rfl⟩
              exact ⟨g j, ⟨j, rfl⟩, hg j⟩
            · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
              exact ⟨j, (hg j).symm⟩
          rwa [hspan_eq] at hmem_ker
        obtain ⟨h, hh_I₀, hh_eq⟩ :=
          (Ideal.mem_map_iff_of_surjective (MvPolynomial.map q) hmap_surj).mp hmap_mem
        have hf_sub : f - h ∈ Ideal.map MvPolynomial.C (RingHom.ker q) := by
          rw [← MvPolynomial.ker_map, RingHom.mem_ker, map_sub, hh_eq, sub_self]
        have hx₀_mem : Ideal.Quotient.mk I₀ f ∈ Ideal.map (algebraMap A A₀) (RingHom.ker q) := by
          have hmk_eq : Ideal.Quotient.mk I₀ f = Ideal.Quotient.mk I₀ (f - h) := by
            rw [map_sub, Ideal.Quotient.eq_zero_iff_mem.mpr hh_I₀, sub_zero]
          rw [hmk_eq]
          have hmem1 : Ideal.Quotient.mk I₀ (f - h) ∈
              Ideal.map (Ideal.Quotient.mk I₀) (Ideal.map MvPolynomial.C (RingHom.ker q)) :=
            Ideal.mem_map_of_mem (Ideal.Quotient.mk I₀) hf_sub
          rwa [Ideal.map_map] at hmem1
        have hzk_mem : z * (algebraMap A₀ A' δ₀) ^ k ∈ Ideal.map ι_A (RingHom.ker q) := by
          have hmem2 : algebraMap A₀ A' (Ideal.Quotient.mk I₀ f) ∈
              Ideal.map (algebraMap A₀ A') (Ideal.map (algebraMap A A₀) (RingHom.ker q)) :=
            Ideal.mem_map_of_mem (algebraMap A₀ A') hx₀_mem
          rw [Ideal.map_map] at hmem2
          have halg_eq : (algebraMap A₀ A').comp (algebraMap A A₀) = ι_A := by
            ext a
            exact (IsScalarTower.algebraMap_apply A A₀ A' a).symm
          rw [halg_eq] at hmem2
          have hzk' : z * (algebraMap A₀ A' δ₀) ^ k = algebraMap A₀ A' (Ideal.Quotient.mk I₀ f) := by
            simpa using hzk
          rwa [hzk']
        obtain ⟨u_δ, hu_δ⟩ := IsLocalization.Away.algebraMap_isUnit (S := A') δ₀
        have hz_eq : z = (z * (algebraMap A₀ A' δ₀) ^ k) * (↑(u_δ⁻¹) : A') ^ k := by
          rw [← hu_δ, mul_assoc, ← mul_pow, Units.mul_inv, one_pow, mul_one]
        rw [hz_eq]
        exact Ideal.mul_mem_right _ _ hzk_mem
      · rw [Ideal.map_le_iff_le_comap]
        intro a ha
        simp only [Ideal.mem_comap, RingHom.mem_ker] at ha ⊢
        have h1 := RingHom.congr_fun hq'_comp a
        simp only [RingHom.comp_apply] at h1
        rw [h1, ha, map_zero]
    exact ⟨A', inferInstance, ι_A, q', hEt_ιA, hq'_surj, hq'_comp, hq'_ker⟩

  
  have hStage3 :
      ∀ (R₀ : Type u) [CommRing R₀] [IsLocalRing R₀]
        (A' : Type u) [CommRing A'] [Algebra R₀ A'] [Algebra.FiniteType R₀ A']
        (B_bar : Type u) [CommRing B_bar]
        (q' : A' →+* B_bar), Function.Surjective q' →
        RingHom.ker q' = Ideal.map (algebraMap R₀ A') (IsLocalRing.maximalIdeal R₀) →
        ∀ (ψ₂ : (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R₀) ⧸
            Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R₀)) *
              MvPolynomial.X 1}) →+* B_bar),
          RingHom.Etale ψ₂ →
        ∀ (ε₀ : B_bar →+* IsLocalRing.ResidueField R₀),
          q'.comp (algebraMap R₀ A') =
            (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp (IsLocalRing.residue R₀) →
          ε₀.comp (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
            RingHom.id (IsLocalRing.ResidueField R₀) →
          (∀ i : Fin 2, ε₀ (ψ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))) = 0) →
          ∃ (m : ℕ)
            (ψ_poly : MvPolynomial (Fin (2 + m)) R₀ →ₐ[R₀] A')
            (R_rel : Fin m → MvPolynomial (Fin (2 + m)) R₀)
            (F : MvPolynomial (Fin (2 + m)) R₀),
            let ε_poly : MvPolynomial (Fin (2 + m)) R₀ →+* IsLocalRing.ResidueField R₀ :=
              ε₀.comp (q'.comp ψ_poly.toRingHom)
            let I_def : Ideal (MvPolynomial (Fin (2 + m)) R₀) :=
              Ideal.span (insert F (Set.range R_rel))
            Function.Surjective ψ_poly ∧
            I_def ≤ RingHom.ker ψ_poly.toRingHom ∧
            RingHom.ker ψ_poly.toRingHom ≤
              I_def ⊔ (RingHom.ker ψ_poly.toRingHom ⊓
                Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R₀)) ∧
            ε_poly (MvPolynomial.X 0) = 0 ∧
            ε_poly (MvPolynomial.X 1) = 0 ∧
            ε_poly.comp MvPolynomial.C = IsLocalRing.residue R₀ ∧
            ε_poly ((Matrix.of fun (a b : Fin m) =>
              MvPolynomial.pderiv (Fin.natAdd 2 a) (R_rel b)).det) ≠ 0 ∧
            F - (MvPolynomial.X 0 : MvPolynomial (Fin (2 + m)) R₀) * MvPolynomial.X 1 ∈
              Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R₀) := by
    clear! R C_R hStage2
    intro R _ _ A' _ _ _ B_bar _ q' hq'_surj hq'_ker ψ₂ hEt₂ ε₀ hCompat' hAug hX₀
    classical
    let k₀ : Type u := IsLocalRing.ResidueField R
    let m_R : Ideal R := IsLocalRing.maximalIdeal R
    let res_R : R →+* k₀ := IsLocalRing.residue R
    let P₂ : Type u := MvPolynomial (Fin 2) k₀
    let I_nod : Ideal P₂ :=
      Ideal.span {(MvPolynomial.X 0 : P₂) * MvPolynomial.X 1}
    let N_bar : Type u := P₂ ⧸ I_nod
    let _ : Algebra N_bar B_bar := ψ₂.toAlgebra
    have _ : Algebra.Etale N_bar B_bar := RingHom.etale_algebraMap.mp hEt₂
    obtain ⟨s, P_B, hPB_map⟩ := exists_fin_id_submersivePresentation N_bar B_bar
    have h1_val_2s : (1 : Fin (2 + s)).1 = 1 := @Nat.mod_eq_of_lt 1 (2 + s) (by omega)
    let z_bar : Fin s → B_bar := P_B.val
    let h_bar : Fin s → MvPolynomial (Fin s) N_bar := P_B.relation
    let aeval_B : MvPolynomial (Fin s) N_bar →ₐ[N_bar] B_bar := MvPolynomial.aeval z_bar
    have haeval_B_surj : Function.Surjective aeval_B := fun b => ⟨P_B.σ' b, P_B.aeval_val_σ' b⟩
    have haeval_B_ker : RingHom.ker aeval_B.toRingHom = Ideal.span (Set.range h_bar) := by
      rw [P_B.span_range_relation_eq_ker]
      ext p
      let _ : Algebra (MvPolynomial (Fin s) N_bar) B_bar := P_B.algebra
      change aeval_B p = 0 ↔ p ∈ RingHom.ker (algebraMap (MvPolynomial (Fin s) N_bar) B_bar)
      rw [RingHom.mem_ker, P_B.algebraMap_eq]
      rfl
    let e_swap : Fin (2 + s) ≃ Fin s ⊕ Fin 2 :=
      finSumFinEquiv.symm.trans (Equiv.sumComm (Fin 2) (Fin s))
    have he_swap_0 : e_swap 0 = Sum.inr 0 := by
      have h0 : (0 : Fin (2 + s)) = finSumFinEquiv (Sum.inl (0 : Fin 2)) := by
        ext; simp [finSumFinEquiv_apply_left]
      rw [h0]
      simp [e_swap]
    have he_swap_1 : e_swap 1 = Sum.inr 1 := by
      have h1 : (1 : Fin (2 + s)) = finSumFinEquiv (Sum.inl (1 : Fin 2)) := by
        ext
        simp only [finSumFinEquiv_apply_left, Fin.val_castAdd]
        exact h1_val_2s
      rw [h1]
      simp [e_swap]
    have he_swap_natAdd : ∀ a : Fin s, e_swap (Fin.natAdd 2 a) = Sum.inl a := by
      intro a
      have ha : Fin.natAdd 2 a = finSumFinEquiv (Sum.inr a) :=
        (finSumFinEquiv_apply_right a).symm
      rw [ha]
      simp [e_swap]
    let E_iter : MvPolynomial (Fin (2 + s)) k₀ ≃+* MvPolynomial (Fin s) P₂ :=
      (MvPolynomial.renameEquiv k₀ e_swap).toRingEquiv.trans
        (MvPolynomial.sumRingEquiv k₀ (Fin s) (Fin 2))
    have hE_iter_C : ∀ c : k₀, E_iter (MvPolynomial.C c) = MvPolynomial.C (MvPolynomial.C c) := by
      intro c
      change (MvPolynomial.sumRingEquiv k₀ (Fin s) (Fin 2))
        (MvPolynomial.rename e_swap (MvPolynomial.C c)) = _
      rw [MvPolynomial.rename_C, MvPolynomial.sumRingEquiv_C]
    have hE_iter_X0 : E_iter (MvPolynomial.X 0) = MvPolynomial.C (MvPolynomial.X 0) := by
      change (MvPolynomial.sumRingEquiv k₀ (Fin s) (Fin 2))
        (MvPolynomial.rename e_swap (MvPolynomial.X 0)) = _
      rw [MvPolynomial.rename_X, he_swap_0, MvPolynomial.sumRingEquiv_X_inr]
    have hE_iter_X1 : E_iter (MvPolynomial.X 1) = MvPolynomial.C (MvPolynomial.X 1) := by
      change (MvPolynomial.sumRingEquiv k₀ (Fin s) (Fin 2))
        (MvPolynomial.rename e_swap (MvPolynomial.X 1)) = _
      rw [MvPolynomial.rename_X, he_swap_1, MvPolynomial.sumRingEquiv_X_inr]
    have hE_iter_Xnat : ∀ a : Fin s,
        E_iter (MvPolynomial.X (Fin.natAdd 2 a)) = MvPolynomial.X a := by
      intro a
      change (MvPolynomial.sumRingEquiv k₀ (Fin s) (Fin 2))
        (MvPolynomial.rename e_swap (MvPolynomial.X (Fin.natAdd 2 a))) = _
      rw [MvPolynomial.rename_X, he_swap_natAdd, MvPolynomial.sumRingEquiv_X_inl]
    have hE_iter_pderiv : ∀ (a : Fin s) (P : MvPolynomial (Fin (2 + s)) k₀),
        E_iter (MvPolynomial.pderiv (Fin.natAdd 2 a) P) = MvPolynomial.pderiv a (E_iter P) := by
      intro a P
      induction P using MvPolynomial.induction_on with
      | C c =>
        rw [MvPolynomial.pderiv_C, map_zero, hE_iter_C, MvPolynomial.pderiv_C]
      | add p q ihp ihq =>
        simp [map_add, ihp, ihq]
      | mul_X p idx ihp =>
        have hX_pderiv : E_iter (MvPolynomial.pderiv (Fin.natAdd 2 a) (MvPolynomial.X idx)) =
            MvPolynomial.pderiv a (E_iter (MvPolynomial.X idx)) := by
          by_cases hlt : idx.1 < 2
          · have h01 : idx = 0 ∨ idx = 1 := by
              by_cases h0 : idx.1 = 0
              · left; ext; simpa using h0
              · right; ext; rw [h1_val_2s]; omega
            have hne : idx ≠ Fin.natAdd 2 a := by
              intro heq
              have hv := congrArg Fin.val heq
              simp only [Fin.val_natAdd] at hv
              omega
            rw [pderiv_X_eq_ite, ite_eq_right_iff.mpr (fun h => absurd h hne), map_zero]
            rcases h01 with rfl | rfl
            · rw [hE_iter_X0, MvPolynomial.pderiv_C]
            · rw [hE_iter_X1, MvPolynomial.pderiv_C]
          · have hidx_lt : idx.1 < 2 + s := idx.2
            let a' : Fin s := ⟨idx.1 - 2, by omega⟩
            have hidx : idx = Fin.natAdd 2 a' := by
              ext; simp [a']; omega
            rw [hidx, hE_iter_Xnat, pderiv_X_eq_ite, pderiv_X_eq_ite]
            by_cases ha' : a' = a
            · subst ha'; simp
            · have hna : Fin.natAdd 2 a' ≠ Fin.natAdd 2 a := fun h =>
                ha' (Fin.natAdd_injective s 2 h)
              simp [ha', hna]
        rw [MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, map_mul E_iter,
          MvPolynomial.pderiv_mul, ihp, hX_pderiv]
    let Θ_s : MvPolynomial (Fin (2 + s)) k₀ →+* MvPolynomial (Fin s) N_bar :=
      (MvPolynomial.map (Ideal.Quotient.mk I_nod)).comp E_iter.toRingHom
    have hΘ_s_apply : ∀ P, Θ_s P = MvPolynomial.map (Ideal.Quotient.mk I_nod) (E_iter P) :=
      fun _ => rfl
    have hΘ_s_surj : Function.Surjective Θ_s :=
      (MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective).comp E_iter.surjective
    have hΘ_s_ker : RingHom.ker Θ_s =
        Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) k₀) * MvPolynomial.X 1} := by
      apply le_antisymm
      · intro P hP
        have hmap0 : MvPolynomial.map (Ideal.Quotient.mk I_nod) (E_iter P) = 0 := hP
        have hmem_map : E_iter P ∈ Ideal.map MvPolynomial.C I_nod := by
          have hker : E_iter P ∈ RingHom.ker (MvPolynomial.map (Ideal.Quotient.mk I_nod)) := hmap0
          rwa [MvPolynomial.ker_map, Ideal.mk_ker] at hker
        have hC_span : Ideal.map (MvPolynomial.C : P₂ →+* MvPolynomial (Fin s) P₂) I_nod =
            Ideal.span {E_iter (MvPolynomial.X 0 * MvPolynomial.X 1)} := by
          dsimp only [I_nod]
          rw [Ideal.map_span, Set.image_singleton]
          congr 2
          rw [map_mul E_iter, hE_iter_X0, hE_iter_X1, ← map_mul]
        rw [hC_span, Ideal.mem_span_singleton] at hmem_map
        rcases hmem_map with ⟨Q, hQ⟩
        rw [Ideal.mem_span_singleton]
        refine ⟨E_iter.symm Q, ?_⟩
        apply E_iter.injective
        rw [map_mul, E_iter.apply_symm_apply, hQ]
      · rw [Ideal.span_le]
        rintro _ rfl
        rw [SetLike.mem_coe, RingHom.mem_ker, hΘ_s_apply, map_mul, hE_iter_X0, hE_iter_X1,
          map_mul, MvPolynomial.map_C, MvPolynomial.map_C, ← map_mul, ← map_mul]
        have hzero : Ideal.Quotient.mk I_nod (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [hzero, map_zero]
    have hΘ_s_pderiv : ∀ (a : Fin s) (P : MvPolynomial (Fin (2 + s)) k₀),
        Θ_s (MvPolynomial.pderiv (Fin.natAdd 2 a) P) = MvPolynomial.pderiv a (Θ_s P) := by
      intro a P
      rw [hΘ_s_apply, hΘ_s_apply, hE_iter_pderiv, MvPolynomial.pderiv_map]
    choose h_tilde hh_tilde using fun b : Fin s => hΘ_s_surj (h_bar b)
    let π_2s : MvPolynomial (Fin (2 + s)) k₀ →+* B_bar := aeval_B.toRingHom.comp Θ_s
    have hπ_2s_surj : Function.Surjective π_2s := haeval_B_surj.comp hΘ_s_surj
    have hπ_2s_ker : RingHom.ker π_2s =
        Ideal.span (insert ((MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) k₀) * MvPolynomial.X 1)
          (Set.range h_tilde)) := by
      apply le_antisymm
      · intro P hP
        have haeval0 : aeval_B (Θ_s P) = 0 := hP
        have hmem_span : Θ_s P ∈ Ideal.map Θ_s (Ideal.span (Set.range h_tilde)) := by
          have h1 : Θ_s P ∈ Ideal.span (Set.range h_bar) := by
            rw [← haeval_B_ker]
            exact haeval0
          have hspan_eq : Ideal.span (Set.range h_bar) =
              Ideal.map Θ_s (Ideal.span (Set.range h_tilde)) := by
            rw [Ideal.map_span]
            congr 1
            ext q
            simp only [Set.mem_range, Set.mem_image]
            constructor
            · rintro ⟨b, rfl⟩; exact ⟨h_tilde b, ⟨b, rfl⟩, hh_tilde b⟩
            · rintro ⟨_, ⟨b, rfl⟩, rfl⟩; exact ⟨b, (hh_tilde b).symm⟩
          rwa [hspan_eq] at h1
        obtain ⟨Q, hQ_mem, hQ_eq⟩ :=
          (Ideal.mem_map_iff_of_surjective Θ_s hΘ_s_surj).mp hmem_span
        have hdiff : P - Q ∈
            Ideal.span {(MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) k₀) * MvPolynomial.X 1} := by
          rw [← hΘ_s_ker, RingHom.mem_ker, map_sub, hQ_eq, sub_self]
        have hP_eq : P = (P - Q) + Q := by ring
        rw [hP_eq, Ideal.span_insert]
        exact Submodule.add_mem_sup hdiff hQ_mem
      · rw [Ideal.span_le]
        intro P hP
        simp only [SetLike.mem_coe, RingHom.mem_ker, π_2s, RingHom.comp_apply]
        rcases Set.mem_insert_iff.mp hP with rfl | ⟨b, rfl⟩
        · have h0 : Θ_s (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 := by
            rw [← RingHom.mem_ker, hΘ_s_ker]
            exact Ideal.subset_span rfl
          rw [h0, map_zero]
        · rw [hh_tilde b]
          have hmem : h_bar b ∈ RingHom.ker aeval_B.toRingHom := by
            rw [haeval_B_ker]
            exact Ideal.subset_span ⟨b, rfl⟩
          exact hmem
    let J_s_k₀ : Matrix (Fin s) (Fin s) (MvPolynomial (Fin (2 + s)) k₀) :=
      Matrix.of fun (a b : Fin s) => MvPolynomial.pderiv (Fin.natAdd 2 a) (h_tilde b)
    have hπ_2s_jac : π_2s J_s_k₀.det = P_B.jacobian := by
      let _ : Algebra (MvPolynomial (Fin s) N_bar) B_bar := P_B.algebra
      have hPB_det : P_B.jacobian = aeval_B P_B.jacobiMatrix.det := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, P_B.algebraMap_eq]
        rfl
      rw [hPB_det]
      change aeval_B (Θ_s J_s_k₀.det) = aeval_B P_B.jacobiMatrix.det
      congr 1
      have hdet_map : Θ_s J_s_k₀.det = (J_s_k₀.map Θ_s).det := by
        simp only [Matrix.det_apply, Units.smul_def, map_sum, map_zsmul, map_prod, Matrix.map_apply]
      rw [hdet_map]
      congr 1
      refine Matrix.ext fun a b => ?_
      simp only [Matrix.map_apply, J_s_k₀, Matrix.of_apply,
        Algebra.PreSubmersivePresentation.jacobiMatrix_apply, hPB_map, id_eq]
      rw [hΘ_s_pderiv, hh_tilde b]

    obtain ⟨N, f_gen, hf_gen_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R) (S := A')).mp inferInstance
    let y_raw : Fin N → A' := fun j => f_gen (MvPolynomial.X j)
    obtain ⟨x₀, hx₀⟩ := hq'_surj (ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.X 0)))
    obtain ⟨x₁, hx₁⟩ := hq'_surj (ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.X 1)))
    choose z_lift hz_lift using fun i : Fin s => hq'_surj (z_bar i)
    let val_s : Fin (2 + s) → A' := fun idx =>
      if h0 : idx.1 = 0 then x₀
      else if h1 : idx.1 = 1 then x₁
      else z_lift ⟨idx.1 - 2, by have := idx.2; omega⟩
    have hval_s_0 : val_s 0 = x₀ := by simp [val_s]
    have hval_s_1 : val_s 1 = x₁ := by
      dsimp only [val_s]
      have hne0 : (1 : Fin (2 + s)).1 ≠ 0 := by rw [h1_val_2s]; decide
      rw [dif_neg hne0, dif_pos h1_val_2s]
    have hval_s_natAdd : ∀ i : Fin s, val_s (Fin.natAdd 2 i) = z_lift i := by
      intro i
      have hv : (Fin.natAdd 2 i).1 = 2 + i.1 := Fin.val_natAdd 2 i
      have hne0 : (Fin.natAdd 2 i).1 ≠ 0 := by omega
      have hne1 : (Fin.natAdd 2 i).1 ≠ 1 := by omega
      dsimp only [val_s]
      rw [dif_neg hne0, dif_neg hne1]
      congr 1
      ext
      simp
    let ψ_s : MvPolynomial (Fin (2 + s)) R →ₐ[R] A' := MvPolynomial.aeval val_s
    have hq'_ψs : q'.comp ψ_s.toRingHom = π_2s.comp (MvPolynomial.map res_R) := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          ψ_s, MvPolynomial.aeval_C, MvPolynomial.map_C]
        have h1 := RingHom.congr_fun hCompat' r
        simp only [RingHom.comp_apply] at h1
        rw [h1]
        change ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.C (res_R r))) =
          aeval_B (Θ_s (MvPolynomial.C (res_R r)))
        rw [hΘ_s_apply, hE_iter_C, MvPolynomial.map_C]
        dsimp only [aeval_B]
        rw [MvPolynomial.aeval_C]
        rfl
      · intro idx
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          ψ_s, MvPolynomial.aeval_X, MvPolynomial.map_X]
        by_cases hlt : idx.1 < 2
        · by_cases h0 : idx.1 = 0
          · have hidx0 : idx = 0 := by ext; simpa using h0
            rw [hidx0, hval_s_0, hx₀]
            change ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.X 0)) =
              aeval_B (Θ_s (MvPolynomial.X 0))
            rw [hΘ_s_apply, hE_iter_X0, MvPolynomial.map_C]
            dsimp only [aeval_B]
            rw [MvPolynomial.aeval_C]
            rfl
          · have hidx1 : idx = 1 := by ext; rw [h1_val_2s]; omega
            rw [hidx1, hval_s_1, hx₁]
            change ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.X 1)) =
              aeval_B (Θ_s (MvPolynomial.X 1))
            rw [hΘ_s_apply, hE_iter_X1, MvPolynomial.map_C]
            dsimp only [aeval_B]
            rw [MvPolynomial.aeval_C]
            rfl
        · have hidx_lt : idx.1 < 2 + s := idx.2
          let i : Fin s := ⟨idx.1 - 2, by omega⟩
          have hidx : idx = Fin.natAdd 2 i := by ext; simp [i]; omega
          rw [hidx, hval_s_natAdd, hz_lift]
          change z_bar i = aeval_B (Θ_s (MvPolynomial.X (Fin.natAdd 2 i)))
          rw [hΘ_s_apply, hE_iter_Xnat, MvPolynomial.map_X]
          dsimp only [aeval_B]
          rw [MvPolynomial.aeval_X]
    have hmap_res_s_surj : Function.Surjective
        (MvPolynomial.map res_R : MvPolynomial (Fin (2 + s)) R →+* MvPolynomial (Fin (2 + s)) k₀) :=
      MvPolynomial.map_surjective res_R IsLocalRing.residue_surjective
    have hq'_ψs_surj : Function.Surjective (q'.comp ψ_s.toRingHom) := by
      rw [hq'_ψs]
      exact hπ_2s_surj.comp hmap_res_s_surj
    choose P_shift hP_shift using fun j : Fin N => hq'_ψs_surj (q' (y_raw j))
    let y_shift : Fin N → A' := fun j => y_raw j - ψ_s (P_shift j)
    have hy_shift_ker : ∀ j : Fin N, q' (y_shift j) = 0 := by
      intro j
      dsimp only [y_shift]
      rw [map_sub, sub_eq_zero]
      exact (hP_shift j).symm
    let m : ℕ := s + N
    have h1_val_2m : (1 : Fin (2 + m)).1 = 1 := @Nat.mod_eq_of_lt 1 (2 + m) (by omega)
    let ι_2s : Fin (2 + s) → Fin (2 + m) := fun idx => ⟨idx.1, by have := idx.2; omega⟩
    have hι_2s_inj : Function.Injective ι_2s := by
      intro u₁ u₂ h
      exact Fin.ext (congrArg (Fin.val : Fin (2 + m) → ℕ) h)
    have hι_2s_0 : ι_2s 0 = 0 := by ext; simp [ι_2s]
    have hι_2s_1 : ι_2s 1 = 1 := by
      ext
      dsimp only [ι_2s]
      rw [h1_val_2s, h1_val_2m]
    have hι_2s_natAdd : ∀ i : Fin s,
        ι_2s (Fin.natAdd 2 i) = Fin.natAdd 2 (Fin.castAdd N i) := by
      intro i; ext; simp [ι_2s]
    let v_N : Fin N → Fin (2 + m) := fun j => Fin.natAdd 2 (Fin.natAdd s j)
    have hv_N_val : ∀ j : Fin N, (v_N j).1 = 2 + s + j.1 := by
      intro j; simp [v_N]; omega
    let val_poly : Fin (2 + m) → A' := fun idx =>
      if hlt : idx.1 < 2 + s then val_s ⟨idx.1, hlt⟩
      else y_shift ⟨idx.1 - (2 + s), by have := idx.2; omega⟩
    have hval_poly_ι : ∀ idx : Fin (2 + s), val_poly (ι_2s idx) = val_s idx := by
      intro idx
      dsimp only [val_poly, ι_2s]
      rw [dif_pos idx.2]
    have hval_poly_vN : ∀ j : Fin N, val_poly (v_N j) = y_shift j := by
      intro j
      have hnot : ¬ (v_N j).1 < 2 + s := by rw [hv_N_val]; omega
      dsimp only [val_poly]
      rw [dif_neg hnot]
      congr 1
      apply Fin.ext
      dsimp only
      rw [hv_N_val]
      omega
    let P_poly := MvPolynomial (Fin (2 + m)) R
    let ψ_poly : P_poly →ₐ[R] A' := MvPolynomial.aeval val_poly
    have hψ_poly_X : ∀ u : Fin (2 + m), ψ_poly (MvPolynomial.X u) = val_poly u :=
      fun u => MvPolynomial.aeval_X val_poly u
    have hψ_poly_C : ∀ r : R, ψ_poly (MvPolynomial.C r) = algebraMap R A' r :=
      fun r => MvPolynomial.aeval_C val_poly r
    have hψ_poly_rename : ψ_poly.comp (MvPolynomial.rename ι_2s) = ψ_s := by
      apply MvPolynomial.algHom_ext
      intro idx
      change ψ_poly (MvPolynomial.rename ι_2s (MvPolynomial.X idx)) = ψ_s (MvPolynomial.X idx)
      rw [MvPolynomial.rename_X, hψ_poly_X, hval_poly_ι]
      exact (MvPolynomial.aeval_X val_s idx).symm
    have hψ_poly_surj : Function.Surjective ψ_poly := by
      intro a'
      obtain ⟨Q, rfl⟩ := hf_gen_surj a'
      let lift_N : MvPolynomial (Fin N) R →ₐ[R] P_poly :=
        MvPolynomial.aeval fun j =>
          MvPolynomial.X (v_N j) + MvPolynomial.rename ι_2s (P_shift j)
      refine ⟨lift_N Q, ?_⟩
      have hcomp_eq : ψ_poly.comp lift_N = f_gen := by
        apply MvPolynomial.algHom_ext
        intro j
        simp only [AlgHom.comp_apply, lift_N, MvPolynomial.aeval_X, map_add,
          hψ_poly_X, hval_poly_vN]
        have hren : ψ_poly (MvPolynomial.rename ι_2s (P_shift j)) = ψ_s (P_shift j) :=
          AlgHom.congr_fun hψ_poly_rename (P_shift j)
        rw [hren]
        change y_raw j - ψ_s (P_shift j) + ψ_s (P_shift j) = y_raw j
        abel
      exact AlgHom.congr_fun hcomp_eq Q

    let J_m : Ideal P_poly := Ideal.map MvPolynomial.C m_R
    have hLift_Jm : ∀ u : P_poly, q' (ψ_poly u) = 0 → ∃ w ∈ J_m, ψ_poly w = ψ_poly u := by
      intro u hu
      have hmem_ker : ψ_poly u ∈ Ideal.map ψ_poly.toRingHom J_m := by
        have hmap_eq : Ideal.map ψ_poly.toRingHom J_m = Ideal.map (algebraMap R A') m_R := by
          dsimp only [J_m]
          rw [Ideal.map_map]
          have hcomp : ψ_poly.toRingHom.comp MvPolynomial.C = algebraMap R A' := by
            ext r; exact ψ_poly.commutes r
          rw [hcomp]
        rw [hmap_eq, ← hq'_ker]
        exact hu
      exact (Ideal.mem_map_iff_of_surjective ψ_poly.toRingHom hψ_poly_surj).mp hmem_ker

    have hψ_poly_X0 : ψ_poly (MvPolynomial.X 0) = x₀ := by
      rw [← hι_2s_0, hψ_poly_X, hval_poly_ι, hval_s_0]
    have hψ_poly_X1 : ψ_poly (MvPolynomial.X 1) = x₁ := by
      rw [← hι_2s_1, hψ_poly_X, hval_poly_ι, hval_s_1]
    have hX01_q' : q' (ψ_poly (MvPolynomial.X 0 * MvPolynomial.X 1)) = 0 := by
      rw [map_mul, map_mul, hψ_poly_X0, hψ_poly_X1, hx₀, hx₁, ← map_mul, ← map_mul]
      have hzero : Ideal.Quotient.mk I_nod (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [hzero, map_zero]
    obtain ⟨w_F, hw_F_mem, hw_F_eq⟩ := hLift_Jm (MvPolynomial.X 0 * MvPolynomial.X 1) hX01_q'
    let F : P_poly := MvPolynomial.X 0 * MvPolynomial.X 1 - w_F
    have hF_ker : ψ_poly F = 0 := by
      dsimp only [F]; rw [map_sub, hw_F_eq, sub_self]

    choose H_s hH_s using fun i : Fin s => hmap_res_s_surj (h_tilde i)
    let H_lift : Fin s → P_poly := fun i => MvPolynomial.rename ι_2s (H_s i)
    have hH_lift_q' : ∀ i : Fin s, q' (ψ_poly (H_lift i)) = 0 := by
      intro i
      have h1 : ψ_poly (H_lift i) = ψ_s (H_s i) := AlgHom.congr_fun hψ_poly_rename (H_s i)
      rw [h1]
      have h2 := RingHom.congr_fun hq'_ψs (H_s i)
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h2
      rw [h2, hH_s i]
      change aeval_B (Θ_s (h_tilde i)) = 0
      rw [hh_tilde i]
      have hmem : h_bar i ∈ RingHom.ker aeval_B.toRingHom := by
        rw [haeval_B_ker]; exact Ideal.subset_span ⟨i, rfl⟩
      exact hmem
    choose w_s hw_s_mem hw_s_eq using fun i : Fin s => hLift_Jm (H_lift i) (hH_lift_q' i)

    have hv_N_q' : ∀ j : Fin N, q' (ψ_poly (MvPolynomial.X (v_N j))) = 0 := by
      intro j
      rw [hψ_poly_X, hval_poly_vN, hy_shift_ker]
    choose w_N hw_N_mem hw_N_eq using fun j : Fin N =>
      hLift_Jm (MvPolynomial.X (v_N j)) (hv_N_q' j)

    let R_rel : Fin m → P_poly := fun b =>
      if hb : b.1 < s then H_lift ⟨b.1, hb⟩ - w_s ⟨b.1, hb⟩
      else MvPolynomial.X (v_N ⟨b.1 - s, by have := b.2; omega⟩) -
        w_N ⟨b.1 - s, by have := b.2; omega⟩
    have hR_rel_castAdd : ∀ i : Fin s, R_rel (Fin.castAdd N i) = H_lift i - w_s i := by
      intro i
      have hlt : (Fin.castAdd N i).1 < s := i.2
      dsimp only [R_rel]
      rw [dif_pos hlt]
      rfl
    have hR_rel_natAdd : ∀ j : Fin N,
        R_rel (Fin.natAdd s j) = MvPolynomial.X (v_N j) - w_N j := by
      intro j
      have hnot : ¬ (Fin.natAdd s j).1 < s := by simp
      dsimp only [R_rel]
      rw [dif_neg hnot]
      congr 2 <;> (ext; simp)
    have hR_rel_ker : ∀ b : Fin m, ψ_poly (R_rel b) = 0 := by
      intro b
      by_cases hb : b.1 < s
      · have hb_eq : b = Fin.castAdd N ⟨b.1, hb⟩ := by ext; rfl
        rw [hb_eq, hR_rel_castAdd, map_sub, hw_s_eq, sub_self]
      · have hb_lt : b.1 < s + N := b.2
        have hb_eq : b = Fin.natAdd s ⟨b.1 - s, by omega⟩ := by ext; simp; omega
        rw [hb_eq, hR_rel_natAdd, map_sub, hw_N_eq, sub_self]

    let ε_poly : P_poly →+* k₀ := ε₀.comp (q'.comp ψ_poly.toRingHom)
    let I_def : Ideal P_poly := Ideal.span (insert F (Set.range R_rel))
    refine ⟨m, ψ_poly, R_rel, F, hψ_poly_surj, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [Ideal.span_le]
      intro P hP
      rcases Set.mem_insert_iff.mp hP with rfl | ⟨b, rfl⟩
      · exact hF_ker
      · exact hR_rel_ker b
    · intro P hP_ker
      let ret_val : Fin (2 + m) → MvPolynomial (Fin (2 + s)) R := fun idx =>
        if hlt : idx.1 < 2 + s then MvPolynomial.X ⟨idx.1, hlt⟩ else 0
      let ρ_ret : P_poly →ₐ[R] MvPolynomial (Fin (2 + s)) R := MvPolynomial.aeval ret_val
      have hP_mod_ret : P - MvPolynomial.rename ι_2s (ρ_ret P) ∈ I_def ⊔ J_m := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
        have hhom_eq : Ideal.Quotient.mk (I_def ⊔ J_m) =
            (Ideal.Quotient.mk (I_def ⊔ J_m)).comp
              ((MvPolynomial.rename ι_2s).comp ρ_ret).toRingHom := by
          apply MvPolynomial.ringHom_ext'
          · ext r; simp
          · intro idx
            simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              AlgHom.comp_apply, ρ_ret, MvPolynomial.aeval_X]
            dsimp only [ret_val]
            split_ifs with hlt
            · rw [MvPolynomial.rename_X]
            · rw [map_zero, map_zero, Ideal.Quotient.eq_zero_iff_mem]
              have hidx_lt : idx.1 < 2 + (s + N) := idx.2
              let j : Fin N := ⟨idx.1 - (2 + s), by omega⟩
              have hidx_vN : idx = v_N j := by
                apply Fin.ext
                rw [hv_N_val]
                dsimp only [j]
                omega
              rw [hidx_vN]
              have hX_eq : (MvPolynomial.X (v_N j) : P_poly) = R_rel (Fin.natAdd s j) + w_N j := by
                rw [hR_rel_natAdd]; abel
              rw [hX_eq]
              exact Submodule.add_mem_sup
                (Ideal.subset_span (Set.mem_insert_of_mem F ⟨Fin.natAdd s j, rfl⟩))
                (hw_N_mem j)
        exact RingHom.congr_fun hhom_eq P
      let P₀ : MvPolynomial (Fin (2 + s)) R := ρ_ret P
      have hIdef_Jm_q' : ∀ u ∈ I_def ⊔ J_m, q' (ψ_poly u) = 0 := by
        intro u hu
        have hle : I_def ⊔ J_m ≤ RingHom.ker (q'.comp ψ_poly.toRingHom) := by
          apply sup_le
          · rw [Ideal.span_le]
            intro x hx
            simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply,
              AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
            rcases Set.mem_insert_iff.mp hx with rfl | ⟨b, rfl⟩
            · rw [hF_ker, map_zero]
            · rw [hR_rel_ker b, map_zero]
          · dsimp only [J_m]
            rw [Ideal.map_le_iff_le_comap]
            intro r hr
            simp only [Ideal.mem_comap, RingHom.mem_ker, RingHom.comp_apply,
              AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hψ_poly_C]
            rw [← RingHom.mem_ker, hq'_ker]
            exact Ideal.mem_map_of_mem (algebraMap R A') hr
        exact hle hu
      have hP₀_π2s : π_2s (MvPolynomial.map res_R P₀) = 0 := by
        have h1 := RingHom.congr_fun hq'_ψs P₀
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h1
        rw [← h1]
        have hren : ψ_s P₀ = ψ_poly (MvPolynomial.rename ι_2s P₀) :=
          (AlgHom.congr_fun hψ_poly_rename P₀).symm
        rw [hren]
        have hdiff0 : q' (ψ_poly (P - MvPolynomial.rename ι_2s P₀)) = 0 :=
          hIdef_Jm_q' _ hP_mod_ret
        have hP0 : ψ_poly P = 0 := hP_ker
        rw [map_sub, hP0, zero_sub, map_neg, neg_eq_zero] at hdiff0
        exact hdiff0
      have hmap_P₀_mem : MvPolynomial.map res_R P₀ ∈
          Ideal.map (MvPolynomial.map res_R)
            (Ideal.span (insert ((MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) R) * MvPolynomial.X 1)
              (Set.range H_s))) := by
        have hker_mem : MvPolynomial.map res_R P₀ ∈
            Ideal.span (insert ((MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) k₀) * MvPolynomial.X 1)
              (Set.range h_tilde)) := by
          rw [← hπ_2s_ker]
          exact hP₀_π2s
        have hspan_eq :
            Ideal.span (insert ((MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) k₀) * MvPolynomial.X 1)
              (Set.range h_tilde)) =
            Ideal.map (MvPolynomial.map res_R)
              (Ideal.span (insert ((MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) R) * MvPolynomial.X 1)
                (Set.range H_s))) := by
          rw [Ideal.map_span]
          congr 1
          ext q
          simp only [Set.mem_insert_iff, Set.mem_range, Set.mem_image]
          constructor
          · rintro (rfl | ⟨i, rfl⟩)
            · exact ⟨MvPolynomial.X 0 * MvPolynomial.X 1, Or.inl rfl, by simp⟩
            · exact ⟨H_s i, Or.inr ⟨i, rfl⟩, hH_s i⟩
          · rintro ⟨p, rfl | ⟨i, rfl⟩, rfl⟩
            · left; simp
            · right; exact ⟨i, (hH_s i).symm⟩
        rwa [hspan_eq] at hker_mem
      obtain ⟨Q₀, hQ₀_span, hQ₀_eq⟩ :=
        (Ideal.mem_map_iff_of_surjective _ hmap_res_s_surj).mp hmap_P₀_mem
      have hP₀_sub_Q₀ : P₀ - Q₀ ∈ Ideal.map MvPolynomial.C m_R := by
        dsimp only [m_R]
        rw [← IsLocalRing.ker_residue, ← MvPolynomial.ker_map]
        change MvPolynomial.map res_R (P₀ - Q₀) = 0
        rw [map_sub, hQ₀_eq, sub_self]
      have hren_Q₀ : MvPolynomial.rename ι_2s Q₀ ∈ I_def ⊔ J_m := by
        have hmap_le : Ideal.map (MvPolynomial.rename ι_2s).toRingHom
            (Ideal.span (insert ((MvPolynomial.X 0 : MvPolynomial (Fin (2 + s)) R) * MvPolynomial.X 1)
              (Set.range H_s))) ≤ I_def ⊔ J_m := by
          rw [Ideal.map_span, Ideal.span_le]
          rintro _ ⟨p, rfl | ⟨i, rfl⟩, rfl⟩
          · simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul,
              MvPolynomial.rename_X, hι_2s_0, hι_2s_1]
            have hF_eq : (MvPolynomial.X 0 : P_poly) * MvPolynomial.X 1 = F + w_F := by
              dsimp only [F]; abel
            rw [hF_eq]
            exact Submodule.add_mem_sup
              (Ideal.subset_span (Set.mem_insert F _))
              hw_F_mem
          · change H_lift i ∈ I_def ⊔ J_m
            have hHi_eq : H_lift i = R_rel (Fin.castAdd N i) + w_s i := by
              rw [hR_rel_castAdd]; abel
            rw [hHi_eq]
            exact Submodule.add_mem_sup
              (Ideal.subset_span (Set.mem_insert_of_mem F ⟨Fin.castAdd N i, rfl⟩))
              (hw_s_mem i)
        exact hmap_le (Ideal.mem_map_of_mem (MvPolynomial.rename ι_2s).toRingHom hQ₀_span)
      have hren_diff : MvPolynomial.rename ι_2s (P₀ - Q₀) ∈ J_m := by
        have h1 : MvPolynomial.rename ι_2s (P₀ - Q₀) ∈
            Ideal.map (MvPolynomial.rename (R := R) ι_2s).toRingHom (Ideal.map MvPolynomial.C m_R) :=
          Ideal.mem_map_of_mem (MvPolynomial.rename (R := R) ι_2s).toRingHom hP₀_sub_Q₀
        rw [Ideal.map_map] at h1
        have hcomp_C : (MvPolynomial.rename (R := R) ι_2s).toRingHom.comp MvPolynomial.C =
            (MvPolynomial.C : R →+* P_poly) := by
          ext r; simp
        rwa [hcomp_C] at h1
      have hP_sup : P ∈ I_def ⊔ J_m := by
        have hP_decomp : P = (P - MvPolynomial.rename ι_2s P₀) +
            MvPolynomial.rename ι_2s Q₀ + MvPolynomial.rename ι_2s (P₀ - Q₀) := by
          rw [map_sub]; abel
        rw [hP_decomp]
        exact add_mem (add_mem hP_mod_ret hren_Q₀) (Submodule.mem_sup_right hren_diff)
      obtain ⟨u, hu_I, v, hv_J, huv⟩ := Submodule.mem_sup.mp hP_sup
      have hu_ker : u ∈ RingHom.ker ψ_poly.toRingHom := by
        have hI_le : I_def ≤ RingHom.ker ψ_poly.toRingHom := by
          rw [Ideal.span_le]
          intro x hx
          rcases Set.mem_insert_iff.mp hx with rfl | ⟨b, rfl⟩
          · exact hF_ker
          · exact hR_rel_ker b
        exact hI_le hu_I
      have hv_ker : v ∈ RingHom.ker ψ_poly.toRingHom := by
        have hv_eq : v = P - u := by rw [← huv]; abel
        rw [hv_eq]
        exact sub_mem hP_ker hu_ker
      rw [← huv]
      exact Submodule.add_mem_sup hu_I ⟨hv_ker, hv_J⟩
    · change ε₀ (q' (ψ_poly (MvPolynomial.X 0))) = 0
      rw [hψ_poly_X0, hx₀]
      exact hX₀ 0
    · change ε₀ (q' (ψ_poly (MvPolynomial.X 1))) = 0
      rw [hψ_poly_X1, hx₁]
      exact hX₀ 1
    · ext r
      change ε₀ (q' (ψ_poly (MvPolynomial.C r))) = res_R r
      rw [hψ_poly_C]
      have h1 := RingHom.congr_fun hCompat' r
      simp only [RingHom.comp_apply] at h1
      rw [h1]
      have h2 := RingHom.congr_fun hAug (res_R r)
      simpa only [RingHom.comp_apply, RingHom.id_apply] using h2
    · let red_m : P_poly →+* MvPolynomial (Fin (2 + m)) k₀ := MvPolynomial.map res_R
      have hred_Jm : ∀ w ∈ J_m, red_m w = 0 := by
        intro w hw
        have hker : J_m = RingHom.ker red_m := by
          dsimp only [J_m, red_m, m_R, res_R]
          rw [MvPolynomial.ker_map, IsLocalRing.ker_residue]
        rwa [hker] at hw
      have hred_pderiv_Jm : ∀ (v : Fin (2 + m)) (w : P_poly),
          w ∈ J_m → red_m (MvPolynomial.pderiv v w) = 0 := by
        intro v w hw
        change MvPolynomial.map res_R (MvPolynomial.pderiv v w) = 0
        rw [← MvPolynomial.pderiv_map]
        change MvPolynomial.pderiv v (red_m w) = 0
        rw [hred_Jm w hw, map_zero]
      let J_mat : Matrix (Fin m) (Fin m) P_poly :=
        Matrix.of fun (a b : Fin m) => MvPolynomial.pderiv (Fin.natAdd 2 a) (R_rel b)
      let B₁₁ : Matrix (Fin s) (Fin s) (MvPolynomial (Fin (2 + m)) k₀) :=
        Matrix.of fun (a b : Fin s) =>
          MvPolynomial.rename ι_2s (MvPolynomial.pderiv (Fin.natAdd 2 a) (h_tilde b))
      have hBlocks : Matrix.reindex finSumFinEquiv.symm finSumFinEquiv.symm
          (red_m.mapMatrix J_mat) =
          Matrix.fromBlocks B₁₁ 0 0
            (1 : Matrix (Fin N) (Fin N) (MvPolynomial (Fin (2 + m)) k₀)) := by
        refine Matrix.ext fun row col => ?_
        rcases row with a | j₁ <;> rcases col with b | j₂
        · simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm,
            finSumFinEquiv_apply_left, RingHom.mapMatrix_apply, Matrix.map_apply, J_mat,
            Matrix.of_apply, Matrix.fromBlocks_apply₁₁, B₁₁]
          rw [hR_rel_castAdd, map_sub, map_sub, hred_pderiv_Jm _ _ (hw_s_mem b), sub_zero,
            ← hι_2s_natAdd]
          dsimp only [H_lift, red_m]
          rw [pderiv_rename_of_injective ι_2s hι_2s_inj, MvPolynomial.map_rename,
            ← MvPolynomial.pderiv_map, hH_s b]
        · simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm,
            finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, RingHom.mapMatrix_apply,
            Matrix.map_apply, J_mat, Matrix.of_apply, Matrix.fromBlocks_apply₁₂, Matrix.zero_apply]
          rw [hR_rel_natAdd, map_sub, map_sub, hred_pderiv_Jm _ _ (hw_N_mem j₂), sub_zero]
          have hne : v_N j₂ ≠ Fin.natAdd 2 (Fin.castAdd N a) := by
            intro heq
            have hv := congrArg Fin.val heq
            rw [hv_N_val] at hv
            simp only [Fin.val_natAdd, Fin.val_castAdd] at hv
            omega
          rw [pderiv_X_eq_ite, ite_eq_right_iff.mpr (fun h => absurd h hne), map_zero]
        · simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm,
            finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, RingHom.mapMatrix_apply,
            Matrix.map_apply, J_mat, Matrix.of_apply, Matrix.fromBlocks_apply₂₁, Matrix.zero_apply]
          rw [hR_rel_castAdd, map_sub, map_sub, hred_pderiv_Jm _ _ (hw_s_mem b), sub_zero]
          have hnot_range : ∀ u : Fin (2 + s), ι_2s u ≠ v_N j₁ := by
            intro u heq
            have hv := congrArg Fin.val heq
            rw [hv_N_val] at hv
            have hu2 := u.2
            dsimp only [ι_2s] at hv
            omega
          change red_m (MvPolynomial.pderiv (v_N j₁) (MvPolynomial.rename ι_2s (H_s b))) = 0
          rw [pderiv_rename_of_ne ι_2s (v_N j₁) hnot_range, map_zero]
        · simp only [Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_symm,
            finSumFinEquiv_apply_right, RingHom.mapMatrix_apply, Matrix.map_apply, J_mat,
            Matrix.of_apply, Matrix.fromBlocks_apply₂₂]
          rw [hR_rel_natAdd, map_sub, map_sub, hred_pderiv_Jm _ _ (hw_N_mem j₂), sub_zero]
          change red_m (MvPolynomial.pderiv (v_N j₁) (MvPolynomial.X (v_N j₂))) =
            (1 : Matrix (Fin N) (Fin N) _) j₁ j₂
          rw [pderiv_X_eq_ite, Matrix.one_apply]
          by_cases hj : j₁ = j₂
          · subst hj; simp
          · have hne : v_N j₂ ≠ v_N j₁ := by
              intro heq
              have hv := congrArg Fin.val heq
              rw [hv_N_val, hv_N_val] at hv
              exact hj (Fin.ext (by omega))
            simp [hj, hne]
      have hred_det : red_m J_mat.det = MvPolynomial.rename ι_2s J_s_k₀.det := by
        have hdet_red : red_m J_mat.det = (red_m.mapMatrix J_mat).det := by
          simp only [Matrix.det_apply, Units.smul_def, map_sum, map_zsmul, map_prod,
            RingHom.mapMatrix_apply, Matrix.map_apply]
        rw [hdet_red, ← Matrix.det_reindex_self finSumFinEquiv.symm, hBlocks,
          Matrix.det_fromBlocks_zero₁₂, Matrix.det_one, mul_one]
        simp only [Matrix.det_apply, Units.smul_def, map_sum, map_zsmul, map_prod,
          B₁₁, J_s_k₀, Matrix.of_apply]
      let π_m : MvPolynomial (Fin (2 + m)) k₀ →+* B_bar :=
        MvPolynomial.eval₂Hom
          (ψ₂.comp ((Ideal.Quotient.mk I_nod).comp MvPolynomial.C))
          (fun idx => if hlt : idx.1 < 2 + s then π_2s (MvPolynomial.X ⟨idx.1, hlt⟩) else 0)
      have hq'_ψpoly : q'.comp ψ_poly.toRingHom = π_m.comp red_m := by
        apply MvPolynomial.ringHom_ext'
        · ext r
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            hψ_poly_C, red_m, MvPolynomial.map_C, π_m, MvPolynomial.eval₂Hom_C]
          exact RingHom.congr_fun hCompat' r
        · intro idx
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            hψ_poly_X, red_m, MvPolynomial.map_X, π_m, MvPolynomial.eval₂Hom_X']
          dsimp only [val_poly]
          split_ifs with hlt
          · have h1 := RingHom.congr_fun hq'_ψs (MvPolynomial.X ⟨idx.1, hlt⟩)
            simpa only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
              ψ_s, MvPolynomial.aeval_X, MvPolynomial.map_X] using h1
          · exact hy_shift_ker ⟨idx.1 - (2 + s), by have := idx.2; omega⟩
      have hπm_rename : π_m.comp (MvPolynomial.rename ι_2s).toRingHom = π_2s := by
        apply MvPolynomial.ringHom_ext'
        · ext c
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.rename_C, π_m, MvPolynomial.eval₂Hom_C]
          change ψ₂ (Ideal.Quotient.mk I_nod (MvPolynomial.C c)) =
            aeval_B (Θ_s (MvPolynomial.C c))
          rw [hΘ_s_apply, hE_iter_C, MvPolynomial.map_C]
          dsimp only [aeval_B]
          rw [MvPolynomial.aeval_C]
          rfl
        · intro idx
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.rename_X, π_m, MvPolynomial.eval₂Hom_X', ι_2s, dif_pos idx.2]
      have hq'_det : q' (ψ_poly J_mat.det) = P_B.jacobian := by
        have h1 := RingHom.congr_fun hq'_ψpoly J_mat.det
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h1
        rw [h1, hred_det]
        have h2 := RingHom.congr_fun hπm_rename J_s_k₀.det
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at h2
        rw [h2, hπ_2s_jac]
      change ε₀ (q' (ψ_poly J_mat.det)) ≠ 0
      rw [hq'_det]
      exact (P_B.jacobian_isUnit.map ε₀).ne_zero
    · have hsub : F - MvPolynomial.X 0 * MvPolynomial.X 1 = -w_F := by
        dsimp only [F]; abel
      rw [hsub]
      exact neg_mem hw_F_mem

  
  have hStage4 :
      ∀ (R₀ : Type u) [CommRing R₀] (𝔪 : Ideal R₀) (n : ℕ)
        (A' : Type u) [CommRing A'] [Algebra R₀ A'] [Module.Flat R₀ A']
        [Algebra.FinitePresentation R₀ A']
        (ψ : MvPolynomial (Fin n) R₀ →ₐ[R₀] A'), Function.Surjective ψ →
        ∀ (I_def : Ideal (MvPolynomial (Fin n) R₀)),
          I_def ≤ RingHom.ker ψ.toRingHom →
          RingHom.ker ψ.toRingHom ≤
            I_def ⊔ (RingHom.ker ψ.toRingHom ⊓ Ideal.map MvPolynomial.C 𝔪) →
          ∃ (H_Δ : MvPolynomial (Fin n) R₀),
            H_Δ - 1 ∈ Ideal.map MvPolynomial.C 𝔪 ∧
            ∃ (Θ : Localization.Away (Ideal.Quotient.mk I_def H_Δ) ≃ₐ[R₀]
                Localization.Away (ψ H_Δ)),
              ∀ P : MvPolynomial (Fin n) R₀,
                Θ ((algebraMap (MvPolynomial (Fin n) R₀ ⧸ I_def)
                  (Localization.Away (Ideal.Quotient.mk I_def H_Δ))).comp
                    (Ideal.Quotient.mk I_def) P) =
                  algebraMap A' (Localization.Away (ψ H_Δ)) (ψ P) := by
    clear! R C_R pderiv_X_eq_ite pderiv_rename_of_injective pderiv_rename_of_ne
      exists_fin_id_submersivePresentation hStage2 hStage3
    intro R _ 𝔪 n A' _ _ _ _ ψ hψ_surj I_def hI_le hKer_mod
    let P_poly := MvPolynomial (Fin n) R
    let K : Ideal P_poly := RingHom.ker ψ.toRingHom
    let J : Ideal P_poly := Ideal.map MvPolynomial.C 𝔪
    have hK_fg : K.FG := Algebra.FinitePresentation.ker_fg_of_mvPolynomial ψ hψ_surj
    have hJ_decomp : ∀ v ∈ J, ∃ (l : ℕ) (r : Fin l → R) (s : Fin l → P_poly),
        (∀ i : Fin l, r i ∈ 𝔪) ∧ v = ∑ i : Fin l, r i • s i := by
      intro v hv
      change v ∈ Ideal.span (MvPolynomial.C '' (𝔪 : Set R)) at hv
      refine Submodule.span_induction ?_ ?_ ?_ ?_ hv
      · rintro _ ⟨c, hc, rfl⟩
        refine ⟨1, fun _ => c, fun _ => 1, fun _ => hc, ?_⟩
        simp [Algebra.smul_def]
        rfl
      · exact ⟨0, Fin.elim0, Fin.elim0, fun i => Fin.elim0 i, by simp⟩
      · rintro v₁ v₂ _ _ ⟨l₁, r₁, s₁, hr₁, rfl⟩ ⟨l₂, r₂, s₂, hr₂, rfl⟩
        refine ⟨l₁ + l₂, Fin.addCases r₁ r₂, Fin.addCases s₁ s₂, ?_, ?_⟩
        · intro i
          exact Fin.addCases (fun i₁ => by simp [hr₁ i₁]) (fun i₂ => by simp [hr₂ i₂]) i
        · rw [Fin.sum_univ_add]
          simp [Fin.addCases_left, Fin.addCases_right]
      · rintro p v₁ _ ⟨l₁, r₁, s₁, hr₁, rfl⟩
        refine ⟨l₁, r₁, fun i => p * s₁ i, hr₁, ?_⟩
        change p * ∑ i : Fin l₁, r₁ i • s₁ i = ∑ i : Fin l₁, r₁ i • (p * s₁ i)
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        exact mul_smul_comm (r₁ i) p (s₁ i)
    have hKJ_le : K ⊓ J ≤ J • K := by
      rintro v ⟨hvK, hvJ⟩
      obtain ⟨l, r, s, hr, hv_eq⟩ := hJ_decomp v hvJ
      have hsum_zero : ∑ i : Fin l, r i • ψ (s i) = 0 := by
        have h1 : ψ v = 0 := hvK
        rw [hv_eq, map_sum] at h1
        simpa only [AlgHom.map_smul_of_tower] using h1
      obtain ⟨k, a, y, hx_eq, h_rel⟩ :=
        @Module.Flat.isTrivialRelation_of_sum_smul_eq_zero R A' _ _ _ _ _ _ r (fun i => ψ (s i))
          hsum_zero
      choose s_tilde hs_tilde using fun j : Fin k => hψ_surj (y j)
      let k_vec : Fin l → P_poly := fun i => s i - ∑ j : Fin k, a i j • s_tilde j
      have hk_mem : ∀ i : Fin l, k_vec i ∈ K := by
        intro i
        change ψ (s i - ∑ j : Fin k, a i j • s_tilde j) = 0
        dsimp only at hx_eq
        rw [map_sub, map_sum, hx_eq i]
        simp only [AlgHom.map_smul_of_tower, hs_tilde]
        exact sub_self _
      have hv_k : v = ∑ i : Fin l, r i • k_vec i := by
        simp only [k_vec, smul_sub, Finset.sum_sub_distrib, ← hv_eq]
        symm
        rw [sub_eq_self]
        calc
          ∑ i : Fin l, r i • ∑ j : Fin k, a i j • s_tilde j
            = ∑ i : Fin l, ∑ j : Fin k, (r i * a i j) • s_tilde j := by
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [Finset.smul_sum]
                refine Finset.sum_congr rfl fun j _ => (mul_smul (r i) (a i j) (s_tilde j)).symm
          _ = ∑ j : Fin k, (∑ i : Fin l, r i * a i j) • s_tilde j := by
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl fun j _ => Finset.sum_smul.symm
          _ = 0 := by simp [h_rel]
      rw [hv_k]
      refine Submodule.sum_mem (J • K) fun i _ => ?_
      have hCr_mem : MvPolynomial.C (r i) ∈ J := Ideal.mem_map_of_mem MvPolynomial.C (hr i)
      have hsmul_eq : r i • k_vec i = (MvPolynomial.C (r i) : P_poly) • k_vec i := by
        rw [Algebra.smul_def, MvPolynomial.algebraMap_eq, smul_eq_mul]
      rw [hsmul_eq]
      exact Submodule.smul_mem_smul hCr_mem (hk_mem i)
    have hK_sup : K ≤ I_def ⊔ J • K := hKer_mod.trans (sup_le_sup_left hKJ_le I_def)
    obtain ⟨H_Δ, hHΔ_sub1, hHΔ_ann⟩ :=
      Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hK_fg le_rfl hK_sup
    refine ⟨H_Δ, hHΔ_sub1, ?_⟩
    let Q_def : Type u := P_poly ⧸ I_def
    let h_bar : Q_def := Ideal.Quotient.mk I_def H_Δ
    let A_def : Type u := Localization.Away h_bar
    let h' : A' := ψ H_Δ
    let A'_loc : Type u := Localization.Away h'
    let ψ_bar : Q_def →ₐ[R] A' := Ideal.Quotient.liftₐ I_def ψ (fun p hp => hI_le hp)
    have hψ_bar_surj : Function.Surjective ψ_bar := by
      intro a'
      obtain ⟨p, rfl⟩ := hψ_surj a'
      exact ⟨Ideal.Quotient.mk I_def p, rfl⟩
    have hψ_bar_ann : ∀ y : Q_def, ψ_bar y = 0 → h_bar * y = 0 := by
      intro y hy
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
      have hpK : p ∈ K := hy
      have hmem : H_Δ • p ∈ I_def := hHΔ_ann (Submodule.smul_mem_pointwise_smul p H_Δ K hpK)
      change Ideal.Quotient.mk I_def H_Δ * Ideal.Quotient.mk I_def p = 0
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      simpa only [smul_eq_mul] using hmem
    have hUnit_h' : IsUnit (((algebraMap A' A'_loc).comp ψ_bar.toRingHom) h_bar) := by
      change IsUnit (algebraMap A' A'_loc h')
      exact IsLocalization.Away.algebraMap_isUnit h'
    let Θ_ring : A_def →+* A'_loc := IsLocalization.Away.lift h_bar hUnit_h'
    have hΘ_eq : ∀ y : Q_def, Θ_ring (algebraMap Q_def A_def y) = algebraMap A' A'_loc (ψ_bar y) :=
      fun y => IsLocalization.Away.lift_eq h_bar hUnit_h' y
    let Θ_alg : A_def →ₐ[R] A'_loc :=
      { toRingHom := Θ_ring
        commutes' := fun r => by
          change Θ_ring (algebraMap R A_def r) = algebraMap R A'_loc r
          rw [IsScalarTower.algebraMap_apply R Q_def A_def r, hΘ_eq, AlgHom.commutes,
            ← IsScalarTower.algebraMap_apply R A' A'_loc r] }
    have hΘ_inj : Function.Injective Θ_alg := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro z hz
      obtain ⟨⟨y, ⟨_, d₁, rfl⟩⟩, hzd₁⟩ := IsLocalization.surj (Submonoid.powers h_bar) z
      have hΘ_y : algebraMap A' A'_loc (ψ_bar y) = 0 := by
        have h1 := congrArg Θ_ring hzd₁
        change Θ_alg (z * _) = Θ_ring (algebraMap Q_def A_def y) at h1
        have hz0 : Θ_alg z = 0 := hz
        rw [map_mul, hz0, zero_mul, hΘ_eq] at h1
        exact h1.symm
      obtain ⟨⟨_, d₂, rfl⟩, hd₂⟩ :=
        (IsLocalization.map_eq_zero_iff (Submonoid.powers h') A'_loc (ψ_bar y)).mp hΘ_y
      have hψ_bar_zero : ψ_bar (h_bar ^ d₂ * y) = 0 := by
        rw [map_mul, map_pow]
        exact hd₂
      have h_ann_Q : h_bar * (h_bar ^ d₂ * y) = 0 := hψ_bar_ann _ hψ_bar_zero
      have hzd_zero : z * (algebraMap Q_def A_def h_bar) ^ (d₁ + (d₂ + 1)) = 0 := by
        have hzd₁' : z * (algebraMap Q_def A_def h_bar) ^ d₁ = algebraMap Q_def A_def y := by
          simpa using hzd₁
        calc
          z * (algebraMap Q_def A_def h_bar) ^ (d₁ + (d₂ + 1))
            = (z * (algebraMap Q_def A_def h_bar) ^ d₁) *
                (algebraMap Q_def A_def h_bar) ^ (d₂ + 1) := by
                rw [pow_add, mul_assoc]
          _ = algebraMap Q_def A_def (y * h_bar ^ (d₂ + 1)) := by
                rw [hzd₁', ← map_pow, ← map_mul]
          _ = algebraMap Q_def A_def (h_bar * (h_bar ^ d₂ * y)) := by
                congr 1; ring
          _ = 0 := by rw [h_ann_Q, map_zero]
      have hUnit_pow : IsUnit ((algebraMap Q_def A_def h_bar) ^ (d₁ + (d₂ + 1))) :=
        (IsLocalization.Away.algebraMap_isUnit h_bar).pow _
      exact (hUnit_pow.mul_left_eq_zero).mp hzd_zero
    have hΘ_surj : Function.Surjective Θ_alg := by
      intro w
      obtain ⟨⟨a', ⟨_, d, rfl⟩⟩, hwd⟩ := IsLocalization.surj (Submonoid.powers h') w
      obtain ⟨y, rfl⟩ := hψ_bar_surj a'
      obtain ⟨u_bar, hu_bar⟩ := IsLocalization.Away.algebraMap_isUnit (S := A_def) h_bar
      let z : A_def := algebraMap Q_def A_def y * (↑(u_bar⁻¹) : A_def) ^ d
      refine ⟨z, ?_⟩
      have hUnit_h'_pow : IsUnit ((algebraMap A' A'_loc h') ^ d) :=
        (IsLocalization.Away.algebraMap_isUnit h').pow d
      apply hUnit_h'_pow.mul_right_cancel
      have h_hbar_eq : Θ_alg (algebraMap Q_def A_def h_bar) = algebraMap A' A'_loc h' :=
        hΘ_eq h_bar
      have h_mul_eq : Θ_alg (z * (algebraMap Q_def A_def h_bar) ^ d) =
          Θ_alg z * (algebraMap A' A'_loc h') ^ d := by
        rw [map_mul, map_pow, h_hbar_eq]
      calc
        Θ_alg z * (algebraMap A' A'_loc h') ^ d
          = Θ_alg (z * (algebraMap Q_def A_def h_bar) ^ d) := h_mul_eq.symm
        _ = Θ_alg (algebraMap Q_def A_def y) := by
              congr 1
              dsimp only [z]
              rw [← hu_bar, mul_assoc, ← mul_pow, Units.inv_mul, one_pow, mul_one]
        _ = algebraMap A' A'_loc (ψ_bar y) := hΘ_eq y
        _ = w * (algebraMap A' A'_loc h') ^ d := by
              simpa using hwd.symm
    let Θ : A_def ≃ₐ[R] A'_loc := AlgEquiv.ofBijective Θ_alg ⟨hΘ_inj, hΘ_surj⟩
    refine ⟨Θ, fun P => ?_⟩
    exact hΘ_eq (Ideal.Quotient.mk I_def P)

  
  clear pderiv_X_eq_ite pderiv_rename_of_injective pderiv_rename_of_ne
    exists_fin_id_submersivePresentation
  obtain ⟨A_R, instCommAR, instAlgAR, ι_C, p_A, B_bar, instCommB, ψ₁, ψ₂, ε₀,
      hOpen_ιC, hComm_ιC, hp_A, hFlat_AR, hFP_AR, hEt₁, hEt₂,
      hCompat_AR, hAug, hX₀, hpA_comap⟩ := hStage1
  let _ : CommRing A_R := instCommAR
  let _ : Algebra R A_R := instAlgAR
  let _ : CommRing B_bar := instCommB
  have _ : Module.Flat R A_R := hFlat_AR
  have _ : Algebra.FinitePresentation R A_R := hFP_AR
  have _ : AlgebraicGeometry.IsOpenImmersion ι_C := hOpen_ιC
  let I_A : Ideal A_R := Ideal.map (algebraMap R A_R) (IsLocalRing.maximalIdeal R)
  let q_A : A_R →+* (A_R ⧸ I_A) := Ideal.Quotient.mk I_A
  obtain ⟨A', instCommA', ι_A, q', hEt_ιA, hq'_surj, hq'_comp, hq'_ker_raw⟩ :=
    hStage2 A_R (A_R ⧸ I_A) B_bar q_A Ideal.Quotient.mk_surjective ψ₁ hEt₁
  let _ : CommRing A' := instCommA'
  let _ : Algebra A_R A' := ι_A.toAlgebra
  let _ : Algebra R A' := (ι_A.comp (algebraMap R A_R)).toAlgebra
  let _ : IsScalarTower R A_R A' := IsScalarTower.of_algebraMap_eq' rfl
  have _ : Algebra.Etale A_R A' := RingHom.etale_algebraMap.mp hEt_ιA
  have _ : Module.Flat R A' := Module.Flat.trans R A_R A'
  have _ : Algebra.FinitePresentation R A' := Algebra.FinitePresentation.trans R A_R A'
  have _ : Algebra.FiniteType R A' := inferInstance
  have hq'_ker : RingHom.ker q' = Ideal.map (algebraMap R A') (IsLocalRing.maximalIdeal R) := by
    rw [hq'_ker_raw, Ideal.mk_ker]
    dsimp only [I_A]
    rw [Ideal.map_map]
    rfl
  have hCompat' : q'.comp (algebraMap R A') =
      (ψ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)).comp (IsLocalRing.residue R) := by
    have halg : algebraMap R A' = ι_A.comp (algebraMap R A_R) := rfl
    rw [halg, ← RingHom.comp_assoc, hq'_comp, RingHom.comp_assoc]
    exact hCompat_AR
  obtain ⟨m, ψ_poly, R_rel, F, hψ_poly_surj, hI_le, hKer_mod,
      hε_X0, hε_X1, hε_C, hε_det, hF_mod⟩ :=
    hStage3 R A' B_bar q' hq'_surj hq'_ker ψ₂ hEt₂ ε₀ hCompat' hAug hX₀
  let P_poly := MvPolynomial (Fin (2 + m)) R
  let ε_poly : P_poly →+* IsLocalRing.ResidueField R := ε₀.comp (q'.comp ψ_poly.toRingHom)
  let q₀ : Ideal P_poly := RingHom.ker ε_poly
  let I_def : Ideal P_poly := Ideal.span (insert F (Set.range R_rel))
  obtain ⟨H_Δ, hHΔ_sub1, Θ, hΘ_eq⟩ :=
    hStage4 R (IsLocalRing.maximalIdeal R) (2 + m) A' ψ_poly hψ_poly_surj I_def hI_le hKer_mod
  have hq₀_prime : q₀.IsPrime := RingHom.ker_isPrime ε_poly
  have hker_le_q₀ : RingHom.ker ψ_poly.toRingHom ≤ q₀ := by
    intro P hP
    have hP0 : ψ_poly P = 0 := hP
    change ε₀ (q' (ψ_poly P)) = 0
    rw [hP0, map_zero, map_zero]
  have hI_le_q₀ : I_def ≤ q₀ := hI_le.trans hker_le_q₀
  have hR_mem : ∀ a : Fin m, R_rel a ∈ q₀ := fun a =>
    hI_le_q₀ (Ideal.subset_span (Set.mem_insert_of_mem F ⟨a, rfl⟩))
  have hF_mem : F ∈ q₀ := hI_le_q₀ (Ideal.subset_span (Set.mem_insert F _))
  have hq₀_comap : Ideal.comap MvPolynomial.C q₀ = IsLocalRing.maximalIdeal R := by
    ext r
    simp only [Ideal.mem_comap, q₀, RingHom.mem_ker, ε_poly, RingHom.comp_apply]
    have h1 := RingHom.congr_fun hε_C r
    simp only [RingHom.comp_apply] at h1
    rw [h1, ← RingHom.mem_ker, IsLocalRing.ker_residue]
  have hJm_le_q₀ : Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R) ≤ q₀ := by
    rw [Ideal.map_le_iff_le_comap, hq₀_comap]
  have hε_HΔ : ε_poly H_Δ = 1 := by
    have hsub0 : ε_poly (H_Δ - 1) = 0 := hJm_le_q₀ hHΔ_sub1
    rwa [map_sub, map_one, sub_eq_zero] at hsub0
  have hHΔ_not_mem : H_Δ ∉ q₀ := by
    change ε_poly H_Δ ≠ 0
    rw [hε_HΔ]
    exact one_ne_zero
  let A_def : Type u := Localization.Away (Ideal.Quotient.mk I_def H_Δ)
  let A'_loc : Type u := Localization.Away (ψ_poly H_Δ)
  let f_iso : AlgebraicGeometry.Spec (CommRingCat.of A_def) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A'_loc) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.symm.toRingHom)
  let f_iso_inv : AlgebraicGeometry.Spec (CommRingCat.of A'_loc) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A_def) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom Θ.toRingHom)
  have hf_iso_hom_inv : f_iso ≫ f_iso_inv = 𝟙 _ := by
    dsimp only [f_iso, f_iso_inv]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hid : Θ.symm.toRingHom.comp Θ.toRingHom = RingHom.id A_def := by
      ext x; exact Θ.symm_apply_apply x
    rw [hid]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of A_def)
  have hf_iso_inv_hom : f_iso_inv ≫ f_iso = 𝟙 _ := by
    dsimp only [f_iso, f_iso_inv]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hid : Θ.toRingHom.comp Θ.symm.toRingHom = RingHom.id A'_loc := by
      ext x; exact Θ.apply_symm_apply x
    rw [hid]
    exact AlgebraicGeometry.Spec.map_id (CommRingCat.of A'_loc)
  have _ : CategoryTheory.IsIso f_iso := ⟨⟨f_iso_inv, hf_iso_hom_inv, hf_iso_inv_hom⟩⟩
  let f_loc : AlgebraicGeometry.Spec (CommRingCat.of A'_loc) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A') :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A' A'_loc))
  have _ : Algebra.Etale A' A'_loc := Algebra.Etale.of_isLocalizationAway (ψ_poly H_Δ)
  have _ : AlgebraicGeometry.Etale f_loc :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr inferInstance)
  let f_et : AlgebraicGeometry.Spec (CommRingCat.of A') ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A_R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_A)
  have _ : AlgebraicGeometry.Etale f_et :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_ιA
  let e_C : AlgebraicGeometry.Spec (CommRingCat.of A_def) ⟶ C_R :=
    (f_iso ≫ f_loc ≫ f_et) ≫ ι_C
  have hEt_eC : AlgebraicGeometry.Etale e_C := inferInstance
  let α_def : A_R →+* A_def :=
    Θ.symm.toRingHom.comp ((algebraMap A' A'_loc).comp ι_A)
  have hf_chain : f_iso ≫ f_loc ≫ f_et =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_def) := by
    dsimp only [f_iso, f_loc, f_et, α_def]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
  have heC_eq : e_C = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_def) ≫ ι_C := by
    dsimp only [e_C]
    rw [hf_chain]
  have heC_gR : e_C ≫ g_R =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_def)) := by
    rw [heC_eq, CategoryTheory.Category.assoc, hComm_ιC,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext r
    simp only [RingHom.comp_apply, α_def]
    have halg_R : algebraMap A' A'_loc (ι_A (algebraMap R A_R r)) = algebraMap R A'_loc r := by
      change algebraMap A' A'_loc (algebraMap R A' r) = algebraMap R A'_loc r
      exact (IsScalarTower.algebraMap_apply R A' A'_loc r).symm
    change Θ.symm (algebraMap A' A'_loc (ι_A (algebraMap R A_R r))) = algebraMap R A_def r
    rw [halg_R]
    exact Θ.symm.commutes r
  have hUnit_ε_loc : IsUnit ((ε₀.comp q') (ψ_poly H_Δ)) := by
    change IsUnit (ε_poly H_Δ)
    rw [hε_HΔ]
    exact isUnit_one
  let ε_loc : A'_loc →+* IsLocalRing.ResidueField R :=
    IsLocalization.Away.lift (ψ_poly H_Δ) hUnit_ε_loc
  have hε_loc_eq : ∀ a' : A', ε_loc (algebraMap A' A'_loc a') = ε₀ (q' a') :=
    fun a' => IsLocalization.Away.lift_eq (ψ_poly H_Δ) hUnit_ε_loc a'
  let ε_def : A_def →+* IsLocalRing.ResidueField R := ε_loc.comp Θ.toRingHom
  let q_def : AlgebraicGeometry.Spec (CommRingCat.of A_def) :=
    ⟨RingHom.ker ε_def, RingHom.ker_isPrime ε_def⟩
  let π_def : P_poly →+* A_def :=
    (algebraMap (P_poly ⧸ I_def) A_def).comp (Ideal.Quotient.mk I_def)
  have hq_def_comap : Ideal.comap π_def q_def.asIdeal = q₀ := by
    ext P
    change ε_loc (Θ (π_def P)) = 0 ↔ ε_poly P = 0
    rw [hΘ_eq P, hε_loc_eq]
    rfl
  have hα_pA : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_def)).base q_def = p_A := by
    apply PrimeSpectrum.ext
    ext a
    change ε_loc (Θ (α_def a)) = 0 ↔ a ∈ p_A.asIdeal
    have hΘ_α : Θ (α_def a) = algebraMap A' A'_loc (ι_A a) := by
      dsimp only [α_def, RingHom.comp_apply]
      exact Θ.apply_symm_apply _
    rw [hΘ_α, hε_loc_eq]
    have hq'_ιA : q' (ι_A a) = ψ₁ (q_A a) := RingHom.congr_fun hq'_comp a
    rw [hq'_ιA, ← hpA_comap]
    rfl
  have heC_qdef : e_C.base q_def =
      (CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ := by
    rw [heC_eq]
    change ι_C.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_def)).base q_def) = _
    rw [hα_pA, hp_A]
  exact ⟨m, R_rel, F, H_Δ, q₀, hq₀_prime, hR_mem, hF_mem, hε_X0, hε_X1,
    hq₀_comap, hHΔ_not_mem, hε_det, hF_mod,
    e_C, q_def, hEt_eC, heC_gR, hq_def_comap, heC_qdef⟩

theorem weil_nodal_deformation_critical_minors_etale_and_smooth_fiber (R : Type u) [CommRing R] [IsLocalRing R]
    (m : ℕ)
    (R_rel : Fin m → MvPolynomial (Fin (2 + m)) R)
    (F H_Δ : MvPolynomial (Fin (2 + m)) R)
    (q₀ : Ideal (MvPolynomial (Fin (2 + m)) R)) [q₀.IsPrime]
    (hR_mem : ∀ a : Fin m, R_rel a ∈ q₀)
    (hX0_mem : (MvPolynomial.X 0 : MvPolynomial (Fin (2 + m)) R) ∈ q₀)
    (hX1_mem : (MvPolynomial.X 1 : MvPolynomial (Fin (2 + m)) R) ∈ q₀)
    (hq₀_comap : Ideal.comap MvPolynomial.C q₀ = IsLocalRing.maximalIdeal R)
    (hHΔ_not_mem : H_Δ ∉ q₀)
    (hJac_not_mem : (Matrix.of fun (a b : Fin m) => MvPolynomial.pderiv (Fin.natAdd 2 a) (R_rel b)).det ∉ q₀)
    (hF_mod : F - (MvPolynomial.X 0 : MvPolynomial (Fin (2 + m)) R) * MvPolynomial.X 1 ∈
      Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal R)) :
    let I_def : Ideal (MvPolynomial (Fin (2 + m)) R) :=
      Ideal.span (insert F (Set.range R_rel))
    let A_def : Type u := Localization.Away (Ideal.Quotient.mk I_def H_Δ)
    let π_def : MvPolynomial (Fin (2 + m)) R →+* A_def :=
      (algebraMap (MvPolynomial (Fin (2 + m)) R ⧸ I_def) A_def).comp (Ideal.Quotient.mk I_def)
    ∃ (M₀ M₁ Δ_crit : MvPolynomial (Fin (2 + m)) R),
      M₀ ∈ q₀ ∧
      M₁ ∈ q₀ ∧
      Δ_crit ∉ q₀ ∧
      (let I_crit : Ideal (MvPolynomial (Fin (2 + m)) R) :=
         Ideal.span (insert M₁ (insert M₀ (Set.range R_rel)))
       Algebra.Etale R (Localization.Away (Ideal.Quotient.mk I_crit (H_Δ * Δ_crit)))) ∧
      (∀ (K_R : Type u) [Field K_R] (φ_RK : R →+* K_R),
        letI : Algebra R K_R := φ_RK.toAlgebra
        ∀ (ψ_K : TensorProduct R K_R A_def →+* K_R)
          (P_K : Ideal (TensorProduct R K_R A_def)) [P_K.IsPrime],
          P_K = RingHom.ker ψ_K →
          (∀ c : K_R, ψ_K (c ⊗ₜ[R] 1) = c) →
          (ψ_K (1 ⊗ₜ[R] π_def M₀) ≠ 0 ∨ ψ_K (1 ⊗ₜ[R] π_def M₁) ≠ 0) →
          IsDomain (Localization.AtPrime P_K)) :=
by
  let _ := hR_mem
  let _ := hHΔ_not_mem
  intro I_def A_def π_def

  
  have h_part2 : ∀ (S : Type u) [CommRing S] (n : ℕ)
      (g : Fin n → MvPolynomial (Fin n) S)
      (h₀ : MvPolynomial (Fin n) S),
      let I_g : Ideal (MvPolynomial (Fin n) S) := Ideal.span (Set.range g)
      let Δ_g : MvPolynomial (Fin n) S :=
        (Matrix.of fun (i j : Fin n) => MvPolynomial.pderiv i (g j)).det
      Algebra.Etale S (Localization.Away (Ideal.Quotient.mk I_g (h₀ * Δ_g))) := by
    intro S _ n g h₀ I_g Δ_g
    let P_n := MvPolynomial (Fin n) S
    let P_succ := MvPolynomial (Fin (n + 1)) S
    let f : P_n := h₀ * Δ_g
    let Q_g := P_n ⧸ I_g
    let d_f : Q_g := Ideal.Quotient.mk I_g f
    let B := Localization.Away d_f
    let ι : P_n →ₐ[S] P_succ := MvPolynomial.rename Fin.succ
    let g' : Fin (n + 1) → P_succ :=
      Fin.cases (ι f * MvPolynomial.X 0 - 1) (fun j => ι (g j))
    let I_g' : Ideal P_succ := Ideal.span (Set.range g')
    let Q_g' := P_succ ⧸ I_g'
    let P_pre : Algebra.PreSubmersivePresentation S Q_g' (Fin (n + 1)) (Fin (n + 1)) :=
      Algebra.PreSubmersivePresentation.naive (v := g') id Function.injective_id
    have hpderiv0_ι : ∀ p : P_n, MvPolynomial.pderiv (0 : Fin (n + 1)) (ι p) = 0 := by
      intro p
      apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
      intro hmem
      have himg := MvPolynomial.vars_rename Fin.succ p hmem
      rcases Finset.mem_image.mp himg with ⟨k, _, hk⟩
      exact Fin.succ_ne_zero k hk
    let J_g : Matrix (Fin n) (Fin n) P_n :=
      Matrix.of fun (a b : Fin n) => MvPolynomial.pderiv a (g b)
    have hjac_det : P_pre.jacobiMatrix.det = ι h₀ * ι Δ_g * ι Δ_g := by
      rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
      have htail : ∑ k : Fin n,
          (-1) ^ (k.succ : ℕ) * P_pre.jacobiMatrix 0 k.succ *
            (P_pre.jacobiMatrix.submatrix Fin.succ k.succ.succAbove).det = 0 := by
        apply Finset.sum_eq_zero
        intro k _
        have h0k : P_pre.jacobiMatrix 0 k.succ = 0 := by
          rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
          change MvPolynomial.pderiv 0 (g' k.succ) = 0
          exact hpderiv0_ι (g k)
        rw [h0k]
        ring
      rw [htail, add_zero]
      have h00 : P_pre.jacobiMatrix 0 0 = ι h₀ * ι Δ_g := by
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        change MvPolynomial.pderiv 0 (ι f * MvPolynomial.X 0 - 1) = _
        rw [map_sub, Derivation.map_one_eq_zero, sub_zero, MvPolynomial.pderiv_mul,
          hpderiv0_ι f, zero_mul, zero_add, MvPolynomial.pderiv_X_self, mul_one]
        exact map_mul ι h₀ Δ_g
      have hsub : P_pre.jacobiMatrix.submatrix Fin.succ (0 : Fin (n + 1)).succAbove =
          ι.toRingHom.mapMatrix J_g := by
        refine Matrix.ext fun a b => ?_
        rw [Matrix.submatrix_apply, Fin.succAbove_zero,
          Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        exact MvPolynomial.pderiv_rename (Fin.succ_injective n) a (g b)
      rw [h00, hsub, ← RingHom.map_det ι.toRingHom J_g]
      change (-1) ^ (0 : ℕ) * (ι h₀ * ι Δ_g) * ι Δ_g = _
      ring
    have hjac_unit : IsUnit P_pre.jacobian := by
      rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
      let π' : P_succ →+* Q_g' := Ideal.Quotient.mk I_g'
      have halg_eq : (algebraMap P_pre.Ring Q_g' P_pre.jacobiMatrix.det : Q_g') =
          π' P_pre.jacobiMatrix.det := rfl
      rw [halg_eq, hjac_det]
      have hg0_mem : ι f * MvPolynomial.X 0 - 1 ∈ I_g' :=
        Ideal.subset_span ⟨0, rfl⟩
      have hg0_zero : π' (ι f * MvPolynomial.X 0 - 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hg0_mem
      have hinv_eq : π' (ι h₀) * π' (ι Δ_g) * π' (MvPolynomial.X 0) = 1 := by
        rw [map_sub, map_one, sub_eq_zero] at hg0_zero
        simpa [f, map_mul, mul_assoc] using hg0_zero
      refine isUnit_iff_exists_inv.mpr ⟨π' (ι h₀) * π' (MvPolynomial.X 0) ^ 2, ?_⟩
      calc
        π' (ι h₀ * ι Δ_g * ι Δ_g) * (π' (ι h₀) * π' (MvPolynomial.X 0) ^ 2) =
            (π' (ι h₀) * π' (ι Δ_g) * π' (MvPolynomial.X 0)) ^ 2 := by
          simp only [map_mul]
          ring
        _ = 1 := by rw [hinv_eq, one_pow]
    let P_sub : Algebra.SubmersivePresentation S Q_g' (Fin (n + 1)) (Fin (n + 1)) :=
      { toPreSubmersivePresentation := P_pre
        jacobian_isUnit := hjac_unit }
    let val_map : Fin (n + 1) → B :=
      Fin.cases (IsLocalization.Away.invSelf (S := B) d_f)
        (fun k => algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.X k)))
    let Ψ_poly : P_succ →ₐ[S] B := MvPolynomial.aeval val_map
    have hΨ_X0 : Ψ_poly (MvPolynomial.X 0) = IsLocalization.Away.invSelf (S := B) d_f := by
      change MvPolynomial.aeval val_map (MvPolynomial.X 0) = _
      rw [MvPolynomial.aeval_X]
      rfl
    have hΨ_Xsucc : ∀ k : Fin n,
        Ψ_poly (MvPolynomial.X k.succ) =
          algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.X k)) := by
      intro k
      change MvPolynomial.aeval val_map (MvPolynomial.X k.succ) = _
      rw [MvPolynomial.aeval_X]
      rfl
    have hΨ_ι : ∀ p : P_n, Ψ_poly (ι p) = algebraMap Q_g B (Ideal.Quotient.mk I_g p) := by
      have hcomp : Ψ_poly.comp ι =
          (IsScalarTower.toAlgHom S Q_g B).comp (Ideal.Quotient.mkₐ S I_g) := by
        apply MvPolynomial.algHom_ext
        intro k
        rw [AlgHom.comp_apply, AlgHom.comp_apply]
        change Ψ_poly (MvPolynomial.rename Fin.succ (MvPolynomial.X k)) =
          algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.X k))
        rw [MvPolynomial.rename_X]
        exact hΨ_Xsucc k
      intro p
      exact DFunLike.congr_fun hcomp p
    have hI_g'_le : I_g' ≤ RingHom.ker Ψ_poly.toRingHom := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe]
      refine Fin.cases ?_ ?_ j
      · change Ψ_poly (ι f * MvPolynomial.X 0 - 1) = 0
        calc
          Ψ_poly (ι f * MvPolynomial.X 0 - 1) =
              Ψ_poly (ι f) * Ψ_poly (MvPolynomial.X 0) - 1 := by
            rw [map_sub, map_mul, map_one]
          _ = algebraMap Q_g B d_f * IsLocalization.Away.invSelf (S := B) d_f - 1 := by
            rw [hΨ_ι f, hΨ_X0]
          _ = 0 := by rw [IsLocalization.Away.mul_invSelf, sub_self]
      · intro k
        change Ψ_poly (ι (g k)) = 0
        have hgk_mem : g k ∈ I_g := Ideal.subset_span ⟨k, rfl⟩
        rw [hΨ_ι (g k), Ideal.Quotient.eq_zero_iff_mem.mpr hgk_mem, map_zero]
    let Ψ : Q_g' →ₐ[S] B := Ideal.Quotient.liftₐ I_g' Ψ_poly (fun x hx => hI_g'_le hx)
    let π' : P_succ →+* Q_g' := Ideal.Quotient.mk I_g'
    let ι_quot : Q_g →+* Q_g' :=
      Ideal.Quotient.lift I_g (π'.comp ι.toRingHom) (by
        intro x hx
        have hle : I_g ≤ RingHom.ker (π'.comp ι.toRingHom) := by
          rw [Ideal.span_le]
          rintro _ ⟨k, rfl⟩
          simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, AlgHom.toRingHom_eq_coe]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨k.succ, rfl⟩)
        exact hle hx)
    have hdf_unit : IsUnit (ι_quot d_f) := by
      refine isUnit_iff_exists_inv.mpr ⟨π' (MvPolynomial.X 0), ?_⟩
      have hg0_zero : π' (ι f * MvPolynomial.X 0 - 1) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨0, rfl⟩)
      rw [map_sub, map_one, sub_eq_zero, map_mul] at hg0_zero
      exact hg0_zero
    let Ω_ring : B →+* Q_g' := IsLocalization.Away.lift d_f hdf_unit
    have hΩ_invSelf : Ω_ring (IsLocalization.Away.invSelf (S := B) d_f) = π' (MvPolynomial.X 0) := by
      have hmul : ι_quot d_f * Ω_ring (IsLocalization.Away.invSelf (S := B) d_f) =
          ι_quot d_f * π' (MvPolynomial.X 0) := by
        have h1 : ι_quot d_f * Ω_ring (IsLocalization.Away.invSelf (S := B) d_f) = 1 := by
          rw [← IsLocalization.Away.lift_eq (S := B) d_f hdf_unit d_f, ← map_mul,
            IsLocalization.Away.mul_invSelf, map_one]
        have hg0_zero : π' (ι f * MvPolynomial.X 0 - 1) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨0, rfl⟩)
        rw [map_sub, map_one, sub_eq_zero, map_mul] at hg0_zero
        exact h1.trans hg0_zero.symm
      exact hdf_unit.mul_left_cancel hmul
    let Ω : B →ₐ[S] Q_g' :=
      { toRingHom := Ω_ring
        commutes' := fun s => by
          change Ω_ring (algebraMap S B s) = algebraMap S Q_g' s
          rw [IsScalarTower.algebraMap_apply S Q_g B, IsLocalization.Away.lift_eq]
          change π' (MvPolynomial.rename Fin.succ (MvPolynomial.C s)) = π' (MvPolynomial.C s)
          rw [MvPolynomial.rename_C] }
    have hΩΨ : Ω.toRingHom.comp Ψ.toRingHom = RingHom.id Q_g' := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro s
        change Ω (Ψ (Ideal.Quotient.mk I_g' (MvPolynomial.C s))) =
          Ideal.Quotient.mk I_g' (MvPolynomial.C s)
        have hC : Ideal.Quotient.mk I_g' (MvPolynomial.C s) = algebraMap S Q_g' s := rfl
        rw [hC, AlgHom.commutes, AlgHom.commutes]
      · intro j
        refine Fin.cases ?_ ?_ j
        · change Ω_ring (Ψ_poly (MvPolynomial.X 0)) = π' (MvPolynomial.X 0)
          rw [hΨ_X0, hΩ_invSelf]
        · intro k
          change Ω_ring (Ψ_poly (MvPolynomial.X k.succ)) = π' (MvPolynomial.X k.succ)
          rw [hΨ_Xsucc k, IsLocalization.Away.lift_eq]
          change π' (MvPolynomial.rename Fin.succ (MvPolynomial.X k)) = _
          rw [MvPolynomial.rename_X]
    have hΨΩ : Ψ.toRingHom.comp Ω.toRingHom = RingHom.id B := by
      apply IsLocalization.ringHom_ext (Submonoid.powers d_f)
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro s
        change Ψ (Ω (algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.C s)))) =
          algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.C s))
        have hC : algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.C s)) = algebraMap S B s :=
          (IsScalarTower.algebraMap_apply S Q_g B s).symm
        rw [hC, AlgHom.commutes, AlgHom.commutes]
      · intro k
        change Ψ (Ω_ring (algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.X k)))) =
          algebraMap Q_g B (Ideal.Quotient.mk I_g (MvPolynomial.X k))
        rw [IsLocalization.Away.lift_eq]
        change Ψ_poly (ι (MvPolynomial.X k)) = _
        exact hΨ_ι (MvPolynomial.X k)
    let e_QB : Q_g' ≃ₐ[S] B :=
      AlgEquiv.ofAlgHom Ψ Ω
        (AlgHom.ext fun b => DFunLike.congr_fun hΨΩ b)
        (AlgHom.ext fun q => DFunLike.congr_fun hΩΨ q)
    let P_sub_B : Algebra.SubmersivePresentation S B (Fin (n + 1)) (Fin (n + 1)) :=
      P_sub.ofAlgEquiv e_QB
    have hdim : P_sub_B.dimension = 0 := Nat.sub_self _
    have _ : Algebra.IsStandardSmoothOfRelativeDimension 0 S B :=
      P_sub_B.isStandardSmoothOfRelativeDimension hdim
    change Algebra.Etale S B
    infer_instance

  
  have h_part4 : ∀ (K : Type u) [Field K]
      (C : Type u) [CommRing C] [Algebra (Polynomial K) C] [Algebra.Etale (Polynomial K) C]
      (ε : C →+* K) (Q : Ideal C) [Q.IsPrime],
      Q = RingHom.ker ε →
      (∀ c : K, ε (algebraMap (Polynomial K) C (Polynomial.C c)) = c) →
      IsDomain (Localization.AtPrime Q) := by
    intro K _ C _ _ _ ε Q _ hQ hε_C
    classical
    let φ_KC : Polynomial K →+* C := algebraMap (Polynomial K) C
    let c₀ : K := ε (φ_KC Polynomial.X)
    have hε_φ : ε.comp φ_KC = Polynomial.evalRingHom c₀ := by
      apply Polynomial.ringHom_ext'
      · ext c
        simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_C]
        exact hε_C c
      · simp only [RingHom.comp_apply, Polynomial.coe_evalRingHom, Polynomial.eval_X]
        rfl
    let p₀ : Ideal (Polynomial K) := Ideal.comap φ_KC Q
    have _ : p₀.IsPrime := Ideal.IsPrime.comap φ_KC
    have _ : Q.LiesOver p₀ := ⟨rfl⟩
    let ϖ : Polynomial K := Polynomial.X - Polynomial.C c₀
    have hϖ_ne : ϖ ≠ 0 := Polynomial.X_sub_C_ne_zero c₀
    have hp₀_span : p₀ = Ideal.span ({ϖ} : Set (Polynomial K)) := by
      ext f
      simp only [p₀, Ideal.mem_comap, hQ, RingHom.mem_ker, Ideal.mem_span_singleton]
      have hev : ε (φ_KC f) = Polynomial.eval c₀ f := DFunLike.congr_fun hε_φ f
      rw [hev]
      exact Polynomial.dvd_iff_isRoot.symm
    let R₀ := Localization.AtPrime p₀
    let S₀ := Localization.AtPrime Q
    let _ : Algebra R₀ S₀ := Localization.AtPrime.algebraOfLiesOver p₀ Q
    have _ : IsScalarTower (Polynomial K) R₀ S₀ := Localization.AtPrime.instIsScalarTower p₀ Q
    have _ : IsLocalHom (algebraMap R₀ S₀) := instIsLocalHomAtPrimeRingHomAlgebraMap p₀ Q
    have _ : IsNoetherianRing S₀ := by
      let _ : Algebra K C := (φ_KC.comp Polynomial.C).toAlgebra
      have _ : IsScalarTower K (Polynomial K) C := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.FiniteType K C :=
        Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType K (Polynomial K)) inferInstance
      have _ : IsNoetherianRing C := Algebra.FiniteType.isNoetherianRing K C
      exact IsLocalization.isNoetherianRing Q.primeCompl S₀ inferInstance
    have _ : Algebra.EssFiniteType (Polynomial K) S₀ := by
      have _ : Algebra.EssFiniteType C S₀ := Algebra.EssFiniteType.of_isLocalization S₀ Q.primeCompl
      exact Algebra.EssFiniteType.comp (Polynomial K) C S₀
    have _ : Algebra.EssFiniteType R₀ S₀ :=
      Algebra.EssFiniteType.of_comp (Polynomial K) R₀ S₀
    have _ : Algebra.FormallyUnramified (Polynomial K) S₀ := by
      have _ : Algebra.FormallyUnramified C S₀ :=
        Algebra.FormallyUnramified.of_isLocalization Q.primeCompl
      exact Algebra.FormallyUnramified.comp (Polynomial K) C S₀
    have _ : Algebra.FormallyUnramified R₀ S₀ :=
      Algebra.FormallyUnramified.of_restrictScalars (Polynomial K) R₀ S₀
    have _ : Module.Flat R₀ S₀ := by
      change Module.Flat (Localization.AtPrime p₀) (Localization.AtPrime Q)
      infer_instance
    let ϖ_R₀ : R₀ := algebraMap (Polynomial K) R₀ ϖ
    let π_S : S₀ := algebraMap R₀ S₀ ϖ_R₀
    have hm_R₀ : IsLocalRing.maximalIdeal R₀ = Ideal.span ({ϖ_R₀} : Set R₀) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p₀ R₀]
      conv_lhs => arg 2; rw [hp₀_span]
      rw [Ideal.map_span, Set.image_singleton]
    have hm_S₀ : IsLocalRing.maximalIdeal S₀ = Ideal.span ({π_S} : Set S₀) := by
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := R₀) (S := S₀), hm_R₀,
        Ideal.map_span, Set.image_singleton]
    have hϖ_R₀_ne : ϖ_R₀ ≠ 0 := by
      intro h0
      have hinj : Function.Injective (algebraMap (Polynomial K) R₀) :=
        IsLocalization.injective R₀ p₀.primeCompl_le_nonZeroDivisors
      exact hϖ_ne (hinj (h0.trans (map_zero _).symm))
    have hϖ_nzd : ϖ_R₀ ∈ nonZeroDivisors R₀ := mem_nonZeroDivisors_of_ne_zero hϖ_R₀_ne
    have hreg_S : IsSMulRegular S₀ ϖ_R₀ :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors hϖ_nzd
    have hπ_reg : ∀ z : S₀, π_S * z = 0 → z = 0 := by
      intro z hz
      have hsmul : ϖ_R₀ • z = (0 : S₀) := by
        rw [Algebra.smul_def]
        exact hz
      exact hreg_S (hsmul.trans (smul_zero ϖ_R₀).symm)
    have hπ_pow_reg : ∀ (k : ℕ) (z : S₀), π_S ^ k * z = 0 → z = 0 := by
      intro k
      induction k with
      | zero =>
        intro z hz
        simpa using hz
      | succ k ih =>
        intro z hz
        rw [pow_succ', mul_assoc] at hz
        exact ih z (hπ_reg (π_S ^ k * z) hz)
    have hkrull : ⨅ i : ℕ, (IsLocalRing.maximalIdeal S₀) ^ i = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal S₀)
        (IsLocalRing.maximalIdeal.isMaximal S₀).ne_top
    have _ : NoZeroDivisors S₀ := by
      refine ⟨fun {x y} hxy => ?_⟩
      by_contra hne
      have hx : x ≠ 0 := fun h0 => hne (Or.inl h0)
      have hy : y ≠ 0 := fun h0 => hne (Or.inr h0)
      have hx_not_bot : x ∉ (⊥ : Ideal S₀) := by
        rw [Ideal.mem_bot]
        exact hx
      rw [← hkrull, Ideal.mem_iInf] at hx_not_bot
      have hex : ∃ i : ℕ, x ∉ (IsLocalRing.maximalIdeal S₀) ^ i := by
        by_contra hall
        exact hx_not_bot fun i => Classical.not_not.mp fun hi => hall ⟨i, hi⟩
      let n : ℕ := Nat.find hex
      have hn_spec : x ∉ (IsLocalRing.maximalIdeal S₀) ^ n := Nat.find_spec hex
      have hn_ne0 : n ≠ 0 := by
        intro h0
        apply hn_spec
        rw [h0, pow_zero, Ideal.one_eq_top]
        exact Submodule.mem_top
      obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hn_ne0
      have hlt : k < n := by omega
      have hx_mem_k : x ∈ (IsLocalRing.maximalIdeal S₀) ^ k :=
        Classical.not_not.mp (Nat.find_min hex hlt)
      rw [hm_S₀, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hx_mem_k
      rcases hx_mem_k with ⟨u, rfl⟩
      have hu_not_max : u ∉ IsLocalRing.maximalIdeal S₀ := by
        intro hu_mem
        apply hn_spec
        rw [hk, hm_S₀, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        rw [hm_S₀, Ideal.mem_span_singleton] at hu_mem
        rcases hu_mem with ⟨v, rfl⟩
        exact ⟨v, by rw [pow_succ, mul_assoc]⟩
      have hu_unit : IsUnit u := (IsLocalRing.notMem_maximalIdeal (x := u)).mp hu_not_max
      have huy_zero : u * y = 0 := hπ_pow_reg k (u * y) (by simpa [mul_assoc] using hxy)
      exact hy (hu_unit.mul_right_eq_zero.mp huy_zero)
    exact NoZeroDivisors.to_isDomain S₀

  
  have h_build_fast : ∀ (K_R : Type u) [Field K_R] (φ_RK : R →+* K_R)
      (S_poly : Type u) [CommRing S_poly] [Algebra K_R S_poly]
      (I_def' : Ideal (MvPolynomial (Fin (2 + m)) R)),
      I_def' = Ideal.span (insert F (Set.range R_rel)) →
      ∀ (d_def : MvPolynomial (Fin (2 + m)) R ⧸ I_def'),
        d_def = Ideal.Quotient.mk I_def' H_Δ →
        ∀ (A : Type u) [CommRing A] [Algebra R A]
          [Algebra (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A]
          [IsScalarTower R (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A]
          [IsLocalization.Away d_def A]
          (B_K : Type u) [CommRing B_K]
          (inl_BK : K_R →+* B_K)
          (inr_BK : A →+* B_K),
          (∀ r : R, inl_BK (φ_RK r) = inr_BK (algebraMap R A r)) →
          (∀ {T : Type u} [CommRing T] (fK : K_R →+* T) (fA : A →+* T),
            (∀ r : R, fK (φ_RK r) = fA (algebraMap R A r)) →
            ∃ φ : B_K →+* T, (∀ c : K_R, φ (inl_BK c) = fK c) ∧ (∀ a : A, φ (inr_BK a) = fA a)) →
          (∀ {T : Type u} [CommRing T] {φ₁ φ₂ : B_K →+* T},
            (∀ c : K_R, φ₁ (inl_BK c) = φ₂ (inl_BK c)) →
            (∀ a : A, φ₁ (inr_BK a) = φ₂ (inr_BK a)) →
            φ₁ = φ₂) →
          ∀ (ψ_K : B_K →+* K_R)
            (P_K : Ideal B_K) [P_K.IsPrime],
            P_K = RingHom.ker ψ_K →
            (∀ c : K_R, ψ_K (inl_BK c) = c) →
            ∀ (Θ : MvPolynomial (Fin (2 + m)) K_R ≃ₐ[K_R] MvPolynomial (Fin (m + 1)) S_poly)
              (β : Fin (2 + m))
              (M_β : MvPolynomial (Fin (2 + m)) R),
              (∀ (i : Fin (m + 1)) (Q : MvPolynomial (Fin (2 + m)) K_R),
                MvPolynomial.pderiv i (Θ Q) =
                  Θ (MvPolynomial.pderiv (Fin.cases β (Fin.natAdd 2) i) Q)) →
              M_β = (Matrix.of fun (i j : Fin (m + 1)) =>
                MvPolynomial.pderiv (Fin.cases β (Fin.natAdd 2) i) (Fin.cases F R_rel j)).det →
              ∀ (m_β : B_K),
                m_β = inr_BK ((algebraMap (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A)
                  (Ideal.Quotient.mk I_def' M_β)) →
                ψ_K m_β ≠ 0 →
                ∀ (B_loc : Type u) [CommRing B_loc] [Algebra B_K B_loc]
                  [IsLocalization.Away m_β B_loc],
                  (∀ (P_β : Ideal B_loc) [P_β.IsPrime],
                    Ideal.comap (algebraMap B_K B_loc) P_β = P_K →
                    Nonempty (Localization.AtPrime P_K ≃+* Localization.AtPrime P_β)) →
                  ∀ (g_T : Fin (m + 1) → MvPolynomial (Fin (m + 1)) S_poly),
                    (∀ j, g_T j = Θ (MvPolynomial.map φ_RK (Fin.cases F R_rel j))) →
                    ∀ (h_T : MvPolynomial (Fin (m + 1)) S_poly),
                      h_T = Θ (MvPolynomial.map φ_RK H_Δ) →
                      ∀ (I_T : Ideal (MvPolynomial (Fin (m + 1)) S_poly)),
                        I_T = Ideal.span (Set.range g_T) →
                        ∀ (Δ_T : MvPolynomial (Fin (m + 1)) S_poly),
                          Δ_T = (Matrix.of fun (i j : Fin (m + 1)) => MvPolynomial.pderiv i (g_T j)).det →
                          ∀ (d_T : MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T),
                            d_T = Ideal.Quotient.mk I_T (h_T * Δ_T) →
                            ∀ (C_T : Type u) [CommRing C_T] [Algebra S_poly C_T]
                              [Algebra (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) C_T]
                              [IsScalarTower S_poly (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) C_T]
                              [IsLocalization.Away d_T C_T],
                              (∀ (ε : C_T →+* K_R) (Q : Ideal C_T) [Q.IsPrime],
                                Q = RingHom.ker ε →
                                (∀ c : K_R, ε (algebraMap S_poly C_T (algebraMap K_R S_poly c)) = c) →
                                IsDomain (Localization.AtPrime Q)) →
                              IsDomain (Localization.AtPrime P_K) := by
    intro K_R _ φ_RK S_poly _ _ I_def' hI_def d_def hd_def A _ _ _ _ _ B_K _ inl_BK inr_BK
      hBK_comm hBK_lift hBK_ext ψ_K P_K _ hPK hψ_c Θ β M_β hΘ_pd hM_eq m_β hm_β hψ_M
      B_loc _ _ _ h_loc_iso g_T hg_T h_T hh_T I_T hI_T Δ_T hΔ_T d_T hd_T C_T _ _ _ _ _ h_dom_S
    let π_def' : MvPolynomial (Fin (2 + m)) R →+* A :=
      (algebraMap (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A).comp (Ideal.Quotient.mk I_def')
    have hm_β_eq : m_β = inr_BK (π_def' M_β) := hm_β
    let map_RK : MvPolynomial (Fin (2 + m)) R →+* MvPolynomial (Fin (2 + m)) K_R :=
      MvPolynomial.map φ_RK
    let ρ : MvPolynomial (Fin (2 + m)) R →+* MvPolynomial (Fin (m + 1)) S_poly :=
      Θ.toRingHom.comp map_RK
    let π_T : MvPolynomial (Fin (m + 1)) S_poly →+* C_T :=
      (algebraMap (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) C_T).comp (Ideal.Quotient.mk I_T)
    have hΔ_T_eq : Δ_T = ρ M_β := by
      rw [hΔ_T, hM_eq, RingHom.map_det ρ]
      congr 1
      refine Matrix.ext fun i j => ?_
      change MvPolynomial.pderiv i (g_T j) =
        Θ (map_RK (MvPolynomial.pderiv (Fin.cases β (Fin.natAdd 2) i) (Fin.cases F R_rel j)))
      rw [hg_T j, hΘ_pd i (map_RK (Fin.cases F R_rel j))]
      congr 1
      exact MvPolynomial.pderiv_map
    let ι_loc : B_K →+* B_loc := algebraMap B_K B_loc
    have hψ_m_unit : IsUnit (ψ_K m_β) := IsUnit.mk0 (ψ_K m_β) hψ_M
    let ε_β : B_loc →+* K_R := IsLocalization.Away.lift m_β hψ_m_unit
    let P_β : Ideal B_loc := RingHom.ker ε_β
    have _ : P_β.IsPrime := RingHom.ker_isPrime ε_β
    have hcomap_Pβ : Ideal.comap ι_loc P_β = P_K := by
      ext z
      simp only [Ideal.mem_comap, P_β, hPK, RingHom.mem_ker, ι_loc]
      rw [IsLocalization.Away.lift_eq (S := B_loc) m_β hψ_m_unit z]
    obtain ⟨e_PK_Pβ⟩ := h_loc_iso P_β hcomap_Pβ

    have hI_def_le : I_def' ≤ RingHom.ker (π_T.comp ρ) := by
      rw [hI_def, Ideal.span_le]
      intro x hx
      simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, π_T]
      rcases Set.mem_insert_iff.mp hx with hxeq | ⟨a, rfl⟩
      · rw [hxeq]
        have hg0 : g_T 0 ∈ I_T := by rw [hI_T]; exact Ideal.subset_span ⟨0, rfl⟩
        have hρF : ρ F = g_T 0 := (hg_T 0).symm
        rw [hρF, Ideal.Quotient.eq_zero_iff_mem.mpr hg0, map_zero]
      · have hga : g_T a.succ ∈ I_T := by rw [hI_T]; exact Ideal.subset_span ⟨a.succ, rfl⟩
        have hρR : ρ (R_rel a) = g_T a.succ := (hg_T a.succ).symm
        rw [hρR, Ideal.Quotient.eq_zero_iff_mem.mpr hga, map_zero]
    let ρ_quot : (MvPolynomial (Fin (2 + m)) R ⧸ I_def') →+* C_T :=
      Ideal.Quotient.lift I_def' (π_T.comp ρ) (fun x hx => hI_def_le hx)
    have hd_T_inv : π_T h_T * π_T Δ_T * IsLocalization.Away.invSelf (S := C_T) d_T = 1 := by
      have hmul : π_T h_T * π_T Δ_T =
          algebraMap (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) C_T d_T := by
        simp [π_T, hd_T, map_mul]
      rw [hmul, IsLocalization.Away.mul_invSelf]
    have hh_T_unit : IsUnit (ρ_quot d_def) := by
      rw [hd_def]
      change IsUnit (π_T (Θ (MvPolynomial.map φ_RK H_Δ)))
      rw [← hh_T]
      refine isUnit_iff_exists_inv.mpr ⟨π_T Δ_T * IsLocalization.Away.invSelf (S := C_T) d_T, ?_⟩
      rw [← mul_assoc]
      exact hd_T_inv
    let α_A : A →+* C_T := IsLocalization.Away.lift d_def hh_T_unit
    have hα_π : ∀ P : MvPolynomial (Fin (2 + m)) R, α_A (π_def' P) = π_T (ρ P) := by
      intro P
      change α_A (algebraMap (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A
        (Ideal.Quotient.mk I_def' P)) = _
      rw [IsLocalization.Away.lift_eq (S := A) d_def hh_T_unit]
      rfl
    let κ_T : K_R →+* C_T := (algebraMap S_poly C_T).comp (algebraMap K_R S_poly)
    have hκ_eq_π : ∀ c : K_R, κ_T c = π_T (Θ (MvPolynomial.C c)) := by
      intro c
      have hΘc : Θ (MvPolynomial.C c) = MvPolynomial.C (algebraMap K_R S_poly c) :=
        Θ.commutes c
      rw [hΘc]
      change algebraMap S_poly C_T (algebraMap K_R S_poly c) =
        algebraMap (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) C_T
          (Ideal.Quotient.mk I_T (MvPolynomial.C (algebraMap K_R S_poly c)))
      rw [IsScalarTower.algebraMap_apply S_poly (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) C_T]
      rfl
    have hκ_α_comm : ∀ r : R, κ_T (φ_RK r) = α_A (algebraMap R A r) := by
      intro r
      have halg : algebraMap R A r = π_def' (MvPolynomial.C r) := by
        rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A]
        rfl
      rw [halg, hα_π]
      change κ_T (φ_RK r) = π_T (Θ (MvPolynomial.map φ_RK (MvPolynomial.C r)))
      rw [MvPolynomial.map_C, hκ_eq_π]
    obtain ⟨Φ_0, hΦ0_inl, hΦ0_inr⟩ := hBK_lift κ_T α_A hκ_α_comm
    have hm_β_unit : IsUnit (Φ_0 m_β) := by
      have hm_eq : Φ_0 m_β = π_T Δ_T := by
        rw [hm_β_eq, hΦ0_inr, hα_π, hΔ_T_eq]
      rw [hm_eq]
      refine isUnit_iff_exists_inv.mpr ⟨π_T h_T * IsLocalization.Away.invSelf (S := C_T) d_T, ?_⟩
      calc
        π_T Δ_T * (π_T h_T * IsLocalization.Away.invSelf (S := C_T) d_T) =
            π_T h_T * π_T Δ_T * IsLocalization.Away.invSelf (S := C_T) d_T := by ring
        _ = 1 := hd_T_inv
    let Φ : B_loc →+* C_T := IsLocalization.Away.lift m_β hm_β_unit

    let ω'_K : MvPolynomial (Fin (2 + m)) K_R →+* B_K :=
      MvPolynomial.eval₂Hom inl_BK (fun v => inr_BK (π_def' (MvPolynomial.X v)))
    have hω'_map : ∀ P : MvPolynomial (Fin (2 + m)) R, ω'_K (map_RK P) = inr_BK (π_def' P) := by
      have hcomp : ω'_K.comp map_RK = inr_BK.comp π_def' := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [RingHom.comp_apply, map_RK, MvPolynomial.map_C, ω'_K, MvPolynomial.eval₂Hom_C]
          have halg : π_def' (MvPolynomial.C r) = algebraMap R A r := by
            rw [IsScalarTower.algebraMap_apply R (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A]
            rfl
          rw [halg, hBK_comm]
        · intro v
          simp [map_RK, ω'_K]
      intro P
      exact DFunLike.congr_fun hcomp P
    let ω_T : MvPolynomial (Fin (m + 1)) S_poly →+* B_loc :=
      ι_loc.comp (ω'_K.comp Θ.symm.toRingHom)
    have hω_ρ : ∀ P : MvPolynomial (Fin (2 + m)) R, ω_T (ρ P) = ι_loc (inr_BK (π_def' P)) := by
      intro P
      change ι_loc (ω'_K (Θ.symm (Θ (map_RK P)))) = _
      rw [Θ.symm_apply_apply, hω'_map]
    have hI_T_le : I_T ≤ RingHom.ker ω_T := by
      rw [hI_T, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, RingHom.mem_ker]
      rw [hg_T j]
      change ω_T (ρ (Fin.cases F R_rel j)) = 0
      rw [hω_ρ]
      refine Fin.cases ?_ ?_ j
      · rw [Fin.cases_zero]
        have hF_mem : F ∈ I_def' := by rw [hI_def]; exact Ideal.subset_span (Set.mem_insert F _)
        have h0 : π_def' F = 0 := by
          simp only [π_def', RingHom.comp_apply]
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hF_mem, map_zero]
        rw [h0, map_zero, map_zero]
      · intro a
        rw [Fin.cases_succ]
        have hR_mem_def : R_rel a ∈ I_def' := by
          rw [hI_def]; exact Ideal.subset_span (Set.mem_insert_of_mem F ⟨a, rfl⟩)
        have h0 : π_def' (R_rel a) = 0 := by
          simp only [π_def', RingHom.comp_apply]
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hR_mem_def, map_zero]
        rw [h0, map_zero, map_zero]
    let ω_quot : (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) →+* B_loc :=
      Ideal.Quotient.lift I_T ω_T (fun x hx => hI_T_le hx)
    have hd_T_unit : IsUnit (ω_quot d_T) := by
      rw [hd_T]
      change IsUnit (ω_T (h_T * Δ_T))
      rw [map_mul, hh_T, hΔ_T_eq]
      change IsUnit (ω_T (ρ H_Δ) * ω_T (ρ M_β))
      rw [hω_ρ H_Δ, hω_ρ M_β]
      have hu1 : IsUnit (ι_loc (inr_BK (π_def' H_Δ))) := by
        have huA : IsUnit (π_def' H_Δ) := by
          change IsUnit (algebraMap (MvPolynomial (Fin (2 + m)) R ⧸ I_def') A
            (Ideal.Quotient.mk I_def' H_Δ))
          rw [← hd_def]
          exact isUnit_iff_exists_inv.mpr
            ⟨IsLocalization.Away.invSelf (S := A) d_def, IsLocalization.Away.mul_invSelf d_def⟩
        exact (huA.map inr_BK).map ι_loc
      have hu2 : IsUnit (ι_loc (inr_BK (π_def' M_β))) := by
        rw [← hm_β_eq]
        change IsUnit (algebraMap B_K B_loc m_β)
        exact isUnit_iff_exists_inv.mpr
          ⟨IsLocalization.Away.invSelf (S := B_loc) m_β, IsLocalization.Away.mul_invSelf m_β⟩
      exact hu1.mul hu2
    let Ω : C_T →+* B_loc := IsLocalization.Away.lift d_T hd_T_unit
    have hΩ_π : ∀ Z : MvPolynomial (Fin (m + 1)) S_poly, Ω (π_T Z) = ω_T Z := by
      intro Z
      change Ω (algebraMap (MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T) C_T
        (Ideal.Quotient.mk I_T Z)) = _
      rw [IsLocalization.Away.lift_eq (S := C_T) d_T hd_T_unit]
      rfl

    have hΩΦ : Ω.comp Φ = RingHom.id B_loc := by
      apply IsLocalization.ringHom_ext (Submonoid.powers m_β)
      have hΦ_comp : Φ.comp ι_loc = Φ_0 :=
        RingHom.ext fun z => IsLocalization.Away.lift_eq (S := B_loc) m_β hm_β_unit z
      rw [RingHom.comp_assoc, hΦ_comp, RingHom.id_comp]
      apply hBK_ext
      · intro c
        simp only [RingHom.comp_apply]
        rw [hΦ0_inl, hκ_eq_π, hΩ_π]
        change ι_loc (ω'_K (Θ.symm (Θ (MvPolynomial.C c)))) = _
        rw [Θ.symm_apply_apply]
        simp [ω'_K]
        rfl
      · have hext_A : (Ω.comp Φ_0).comp inr_BK = ι_loc.comp inr_BK := by
          apply IsLocalization.ringHom_ext (Submonoid.powers d_def)
          apply Ideal.Quotient.ringHom_ext
          refine RingHom.ext fun P => ?_
          change Ω (Φ_0 (inr_BK (π_def' P))) = ι_loc (inr_BK (π_def' P))
          rw [hΦ0_inr, hα_π, hΩ_π, hω_ρ]
        intro a
        exact DFunLike.congr_fun hext_A a
    have hΦΩ : Φ.comp Ω = RingHom.id C_T := by
      apply IsLocalization.ringHom_ext (Submonoid.powers d_T)
      apply Ideal.Quotient.ringHom_ext
      have h_on_PK' : (Φ.comp (ι_loc.comp ω'_K)) = π_T.comp Θ.toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [RingHom.comp_apply, ω'_K, MvPolynomial.eval₂Hom_C]
          rw [IsLocalization.Away.lift_eq (S := B_loc) m_β hm_β_unit, hΦ0_inl, hκ_eq_π]
          rfl
        · intro v
          simp only [RingHom.comp_apply, ω'_K, MvPolynomial.eval₂Hom_X']
          rw [IsLocalization.Away.lift_eq (S := B_loc) m_β hm_β_unit, hΦ0_inr, hα_π]
          change π_T (Θ (MvPolynomial.map φ_RK (MvPolynomial.X v))) = _
          rw [MvPolynomial.map_X]
          rfl
      refine RingHom.ext fun Z => ?_
      change Φ (Ω (π_T Z)) = π_T Z
      rw [hΩ_π]
      change (Φ.comp (ι_loc.comp ω'_K)) (Θ.symm Z) = π_T Z
      rw [h_on_PK']
      change π_T (Θ (Θ.symm Z)) = π_T Z
      rw [Θ.apply_symm_apply]
    let e_BC : B_loc ≃+* C_T :=
      { toFun := Φ
        invFun := Ω
        left_inv := fun x => DFunLike.congr_fun hΩΦ x
        right_inv := fun y => DFunLike.congr_fun hΦΩ y
        map_mul' := Φ.map_mul'
        map_add' := Φ.map_add' }
    let ε_T : C_T →+* K_R := ε_β.comp e_BC.symm.toRingHom
    let Q_T : Ideal C_T := RingHom.ker ε_T
    have _ : Q_T.IsPrime := RingHom.ker_isPrime ε_T
    have hSub_map : Submonoid.map e_BC.toRingHom.toMonoidHom P_β.primeCompl = Q_T.primeCompl := by
      ext y
      simp only [Submonoid.mem_map, RingEquiv.toRingHom_eq_coe,
        Ideal.mem_primeCompl_iff, P_β, Q_T, RingHom.mem_ker]
      constructor
      · rintro ⟨x, hx, rfl⟩
        change ε_β (e_BC.symm (e_BC x)) ≠ 0
        rw [e_BC.symm_apply_apply]
        exact hx
      · intro hy
        refine ⟨e_BC.symm y, hy, e_BC.apply_symm_apply y⟩
    let e_Pβ_QT : Localization.AtPrime P_β ≃+* Localization.AtPrime Q_T :=
      IsLocalization.ringEquivOfRingEquiv (M := P_β.primeCompl) (T := Q_T.primeCompl)
        (Localization.AtPrime P_β) (Localization.AtPrime Q_T) e_BC hSub_map
    have hε_T_C : ∀ c : K_R, ε_T (algebraMap S_poly C_T (algebraMap K_R S_poly c)) = c := by
      intro c
      have hc_eq : algebraMap S_poly C_T (algebraMap K_R S_poly c) = Φ (ι_loc (inl_BK c)) := by
        rw [IsLocalization.Away.lift_eq (S := B_loc) m_β hm_β_unit, hΦ0_inl]
        rfl
      rw [hc_eq]
      change ε_β (e_BC.symm (e_BC (ι_loc (inl_BK c)))) = c
      rw [e_BC.symm_apply_apply, IsLocalization.Away.lift_eq (S := B_loc) m_β hψ_m_unit]
      exact hψ_c c
    have _ : IsDomain (Localization.AtPrime Q_T) :=
      h_dom_S ε_T Q_T rfl hε_T_C
    let e_final : Localization.AtPrime P_K ≃+* Localization.AtPrime Q_T :=
      e_PK_Pβ.trans e_Pβ_QT
    exact Function.Injective.isDomain e_final.toRingHom e_final.injective

  
  have h_theta : ∀ (K_R : Type u) [Field K_R]
      (S_poly : Type u) [CommRing S_poly] [Algebra K_R S_poly]
      (T_var : S_poly)
      (aeval_X1 : S_poly →ₐ[K_R] MvPolynomial (Fin (2 + m)) K_R),
      aeval_X1 T_var = MvPolynomial.X 1 →
      (∀ (f₁ f₂ : S_poly →+* MvPolynomial (Fin (m + 1)) S_poly),
        (∀ c : K_R, f₁ (algebraMap K_R S_poly c) = f₂ (algebraMap K_R S_poly c)) →
        f₁ T_var = f₂ T_var →
        ∀ p : S_poly, f₁ p = f₂ p) →
      (∃ Θ₀ : MvPolynomial (Fin (2 + m)) K_R ≃ₐ[K_R] MvPolynomial (Fin (m + 1)) S_poly,
        ∀ (i : Fin (m + 1)) (Q : MvPolynomial (Fin (2 + m)) K_R),
          MvPolynomial.pderiv i (Θ₀ Q) =
            Θ₀ (MvPolynomial.pderiv (Fin.cases (0 : Fin (2 + m)) (Fin.natAdd 2) i) Q)) ∧
      (∃ Θ₁ : MvPolynomial (Fin (2 + m)) K_R ≃ₐ[K_R] MvPolynomial (Fin (m + 1)) S_poly,
        ∀ (i : Fin (m + 1)) (Q : MvPolynomial (Fin (2 + m)) K_R),
          MvPolynomial.pderiv i (Θ₁ Q) =
            Θ₁ (MvPolynomial.pderiv (Fin.cases (1 : Fin (2 + m)) (Fin.natAdd 2) i) Q)) := by
    intro K_R _ S_poly _ _ T_var aeval_X1 haeval_T h_poly_ext
    have h0_val : ((0 : Fin (2 + m)) : ℕ) = 0 := by
      change 0 % (2 + m) = 0; exact Nat.mod_eq_of_lt (by omega)
    have h1_val : ((1 : Fin (2 + m)) : ℕ) = 1 := by
      change 1 % (2 + m) = 1; exact Nat.mod_eq_of_lt (by omega)
    have h0_cast : (0 : Fin (2 + m)) = Fin.castAdd m (0 : Fin 2) := by ext; exact h0_val
    have h1_cast : (1 : Fin (2 + m)) = Fin.castAdd m (1 : Fin 2) := by ext; exact h1_val
    have h01_ne : (0 : Fin (2 + m)) ≠ 1 := by
      intro h; have hval := congrArg Fin.val h; rw [h0_val, h1_val] at hval; omega
    have hnatAdd_ne0 : ∀ a : Fin m, Fin.natAdd 2 a ≠ 0 := by
      intro a h; have hval := congrArg Fin.val h; rw [Fin.val_natAdd, h0_val] at hval; omega
    have hnatAdd_ne1 : ∀ a : Fin m, Fin.natAdd 2 a ≠ 1 := by
      intro a h; have hval := congrArg Fin.val h; rw [Fin.val_natAdd, h1_val] at hval; omega
    let θ₀_var : Fin (2 + m) → MvPolynomial (Fin (m + 1)) S_poly :=
      Fin.addCases (fun i : Fin 2 => if i = 0 then MvPolynomial.X 0 else MvPolynomial.C T_var)
        (fun a : Fin m => MvPolynomial.X a.succ)
    let Θ₀_fwd : MvPolynomial (Fin (2 + m)) K_R →ₐ[K_R] MvPolynomial (Fin (m + 1)) S_poly :=
      MvPolynomial.aeval θ₀_var
    let var_bwd : Fin (m + 1) → MvPolynomial (Fin (2 + m)) K_R :=
      Fin.cases (MvPolynomial.X 0) (fun a : Fin m => MvPolynomial.X (Fin.natAdd 2 a))
    let Θ₀_bwd_ring : MvPolynomial (Fin (m + 1)) S_poly →+* MvPolynomial (Fin (2 + m)) K_R :=
      MvPolynomial.eval₂Hom aeval_X1.toRingHom var_bwd
    let Θ₀_bwd : MvPolynomial (Fin (m + 1)) S_poly →ₐ[K_R] MvPolynomial (Fin (2 + m)) K_R :=
      { toRingHom := Θ₀_bwd_ring
        commutes' := fun c => by
          change Θ₀_bwd_ring (MvPolynomial.C (algebraMap K_R S_poly c)) = MvPolynomial.C c
          rw [MvPolynomial.eval₂Hom_C]; exact aeval_X1.commutes c }
    have hΘ₀_X0 : Θ₀_fwd (MvPolynomial.X 0) = MvPolynomial.X 0 := by
      change MvPolynomial.aeval θ₀_var (MvPolynomial.X 0) = _
      rw [MvPolynomial.aeval_X, h0_cast]; simp [θ₀_var]
    have hΘ₀_X1 : Θ₀_fwd (MvPolynomial.X 1) = MvPolynomial.C T_var := by
      change MvPolynomial.aeval θ₀_var (MvPolynomial.X 1) = _
      rw [MvPolynomial.aeval_X, h1_cast]; simp [θ₀_var]
    have hΘ₀_Xnat : ∀ a : Fin m, Θ₀_fwd (MvPolynomial.X (Fin.natAdd 2 a)) = MvPolynomial.X a.succ := by
      intro a; change MvPolynomial.aeval θ₀_var (MvPolynomial.X (Fin.natAdd 2 a)) = _
      rw [MvPolynomial.aeval_X]; simp [θ₀_var]
    have hΘ₀_left : Θ₀_bwd.comp Θ₀_fwd = AlgHom.id K_R (MvPolynomial (Fin (2 + m)) K_R) := by
      apply MvPolynomial.algHom_ext; intro v; rw [AlgHom.comp_apply, AlgHom.id_apply]
      refine @Fin.addCases 2 m (fun v => Θ₀_bwd (Θ₀_fwd (MvPolynomial.X v)) = MvPolynomial.X v) ?_ ?_ v
      · refine Fin.cases ?_ ?_
        · rw [← h0_cast, hΘ₀_X0]
          change MvPolynomial.eval₂Hom aeval_X1.toRingHom var_bwd (MvPolynomial.X 0) = _
          rw [MvPolynomial.eval₂Hom_X']; rfl
        · intro j; have hj : j = 0 := Subsingleton.elim j 0; subst hj
          change Θ₀_bwd (Θ₀_fwd (MvPolynomial.X (Fin.castAdd m 1))) = MvPolynomial.X (Fin.castAdd m 1)
          rw [← h1_cast, hΘ₀_X1]
          change MvPolynomial.eval₂Hom aeval_X1.toRingHom var_bwd (MvPolynomial.C T_var) = _
          rw [MvPolynomial.eval₂Hom_C]; exact haeval_T
      · intro a; rw [hΘ₀_Xnat a]
        change MvPolynomial.eval₂Hom aeval_X1.toRingHom var_bwd (MvPolynomial.X a.succ) = _
        rw [MvPolynomial.eval₂Hom_X']; rfl
    have hΘ₀_right_ring : Θ₀_fwd.toRingHom.comp Θ₀_bwd.toRingHom =
        RingHom.id (MvPolynomial (Fin (m + 1)) S_poly) := by
      apply MvPolynomial.ringHom_ext
      · intro p
        refine h_poly_ext ((Θ₀_fwd.toRingHom.comp Θ₀_bwd.toRingHom).comp MvPolynomial.C)
          MvPolynomial.C ?_ ?_ p
        · intro c; simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe]
          change Θ₀_fwd (Θ₀_bwd (algebraMap K_R (MvPolynomial (Fin (m + 1)) S_poly) c)) =
            algebraMap K_R (MvPolynomial (Fin (m + 1)) S_poly) c
          rw [AlgHom.commutes, AlgHom.commutes]
        · simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe]
          change Θ₀_fwd (MvPolynomial.eval₂Hom aeval_X1.toRingHom var_bwd
            (MvPolynomial.C T_var)) = MvPolynomial.C T_var
          rw [MvPolynomial.eval₂Hom_C]; change Θ₀_fwd (aeval_X1 T_var) = _
          rw [haeval_T, hΘ₀_X1]
      · intro j; simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe]
        refine Fin.cases ?_ ?_ j
        · change Θ₀_fwd (MvPolynomial.eval₂Hom aeval_X1.toRingHom var_bwd (MvPolynomial.X 0)) = _
          rw [MvPolynomial.eval₂Hom_X']; exact hΘ₀_X0
        · intro a
          change Θ₀_fwd (MvPolynomial.eval₂Hom aeval_X1.toRingHom var_bwd (MvPolynomial.X a.succ)) = _
          rw [MvPolynomial.eval₂Hom_X']; exact hΘ₀_Xnat a
    let Θ₀ : MvPolynomial (Fin (2 + m)) K_R ≃ₐ[K_R] MvPolynomial (Fin (m + 1)) S_poly :=
      AlgEquiv.ofAlgHom Θ₀_fwd Θ₀_bwd
        (AlgHom.ext fun z => DFunLike.congr_fun hΘ₀_right_ring z) hΘ₀_left
    have hΘ₀_pd : ∀ (i : Fin (m + 1)) (Q : MvPolynomial (Fin (2 + m)) K_R),
        MvPolynomial.pderiv i (Θ₀ Q) =
          Θ₀ (MvPolynomial.pderiv (Fin.cases (0 : Fin (2 + m)) (Fin.natAdd 2) i) Q) := by
      intro i
      let D_lhs : Derivation K_R (MvPolynomial (Fin (2 + m)) K_R) (MvPolynomial (Fin (2 + m)) K_R) :=
        { toFun := fun Q => Θ₀.symm (MvPolynomial.pderiv i (Θ₀ Q))
          map_add' := fun Q₁ Q₂ => by simp only [map_add]
          map_smul' := fun c Q => by
            dsimp; rw [Algebra.smul_def, map_mul, Θ₀.commutes c]
            have halg_PT : algebraMap K_R (MvPolynomial (Fin (m + 1)) S_poly) c =
                MvPolynomial.C (algebraMap K_R S_poly c) := rfl
            rw [halg_PT, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_C, zero_mul, zero_add,
              map_mul, ← halg_PT, Θ₀.symm.commutes c, ← Algebra.smul_def]
          map_one_eq_zero' := by dsimp; rw [map_one, Derivation.map_one_eq_zero, map_zero]
          leibniz' := fun Q₁ Q₂ => by
            dsimp
            rw [map_mul Θ₀, MvPolynomial.pderiv_mul, map_add Θ₀.symm,
              map_mul Θ₀.symm, map_mul Θ₀.symm, Θ₀.symm_apply_apply, Θ₀.symm_apply_apply]
            ring }
      let D_rhs : Derivation K_R (MvPolynomial (Fin (2 + m)) K_R) (MvPolynomial (Fin (2 + m)) K_R) :=
        (MvPolynomial.pderiv (Fin.cases (0 : Fin (2 + m)) (Fin.natAdd 2) i)).restrictScalars K_R
      have hD_eq : D_lhs = D_rhs := by
        apply MvPolynomial.derivation_ext; intro w
        change Θ₀.symm (MvPolynomial.pderiv i (Θ₀_fwd (MvPolynomial.X w))) =
          MvPolynomial.pderiv (Fin.cases (0 : Fin (2 + m)) (Fin.natAdd 2) i) (MvPolynomial.X w)
        refine @Fin.addCases 2 m
          (fun w => Θ₀.symm (MvPolynomial.pderiv i (Θ₀_fwd (MvPolynomial.X w))) =
            MvPolynomial.pderiv (Fin.cases (0 : Fin (2 + m)) (Fin.natAdd 2) i) (MvPolynomial.X w))
          ?_ ?_ w
        · refine Fin.cases ?_ ?_
          · rw [← h0_cast, hΘ₀_X0]; refine Fin.cases ?_ ?_ i
            · simp
            · intro a
              rw [MvPolynomial.pderiv_X_of_ne (Fin.succ_ne_zero a).symm,
                Fin.cases_succ, MvPolynomial.pderiv_X_of_ne (hnatAdd_ne0 a).symm, map_zero]
          · intro j; have hj : j = 0 := Subsingleton.elim j 0; subst hj
            change Θ₀.symm (MvPolynomial.pderiv i (Θ₀_fwd (MvPolynomial.X (Fin.castAdd m 1)))) =
              MvPolynomial.pderiv (Fin.cases 0 (Fin.natAdd 2) i) (MvPolynomial.X (Fin.castAdd m 1))
            rw [← h1_cast, hΘ₀_X1, MvPolynomial.pderiv_C, map_zero]
            refine Fin.cases ?_ ?_ i
            · rw [Fin.cases_zero, MvPolynomial.pderiv_X_of_ne h01_ne.symm]
            · intro a; rw [Fin.cases_succ, MvPolynomial.pderiv_X_of_ne (hnatAdd_ne1 a).symm]
        · intro b; rw [hΘ₀_Xnat b]; refine Fin.cases ?_ ?_ i
          · rw [MvPolynomial.pderiv_X_of_ne (Fin.succ_ne_zero b), map_zero,
              Fin.cases_zero, MvPolynomial.pderiv_X_of_ne (hnatAdd_ne0 b)]
          · intro a; rw [Fin.cases_succ]
            by_cases hab : a = b
            · subst hab; simp
            · have hsucc_ne : b.succ ≠ a.succ := fun h => hab (Fin.succ_injective m h).symm
              have hnat_ne : Fin.natAdd 2 b ≠ Fin.natAdd 2 a := by
                intro h; apply hab; ext
                have hval := congrArg Fin.val h; simp only [Fin.val_natAdd] at hval; omega
              rw [MvPolynomial.pderiv_X_of_ne hsucc_ne, map_zero, MvPolynomial.pderiv_X_of_ne hnat_ne]
      intro Q; have hQ := congrArg Θ₀ (DFunLike.congr_fun hD_eq Q)
      simpa [D_lhs, D_rhs] using hQ
    let τ : Equiv.Perm (Fin (2 + m)) := Equiv.swap 0 1
    refine ⟨⟨Θ₀, hΘ₀_pd⟩, ⟨(MvPolynomial.renameEquiv K_R τ).trans Θ₀, ?_⟩⟩
    intro i Q
    have hτ_idx : Fin.cases (0 : Fin (2 + m)) (Fin.natAdd 2) i =
        τ (Fin.cases (1 : Fin (2 + m)) (Fin.natAdd 2) i) := by
      refine Fin.cases ?_ ?_ i
      · simp [τ]
      · intro a; simp only [Fin.cases_succ, τ]
        exact (Equiv.swap_apply_of_ne_of_ne (hnatAdd_ne0 a) (hnatAdd_ne1 a)).symm
    change MvPolynomial.pderiv i (Θ₀ (MvPolynomial.rename τ Q)) =
      Θ₀ (MvPolynomial.rename τ (MvPolynomial.pderiv (Fin.cases 1 (Fin.natAdd 2) i) Q))
    rw [hΘ₀_pd i (MvPolynomial.rename τ Q), hτ_idx, MvPolynomial.pderiv_rename τ.injective]

  
  let M₀ : MvPolynomial (Fin (2 + m)) R :=
    (Matrix.of fun (i j : Fin (m + 1)) =>
      MvPolynomial.pderiv (Fin.cases (0 : Fin (2 + m)) (Fin.natAdd 2) i)
        (Fin.cases F R_rel j)).det
  let M₁ : MvPolynomial (Fin (2 + m)) R :=
    (Matrix.of fun (i j : Fin (m + 1)) =>
      MvPolynomial.pderiv (Fin.cases (1 : Fin (2 + m)) (Fin.natAdd 2) i)
        (Fin.cases F R_rel j)).det
  let g_crit : Fin (2 + m) → MvPolynomial (Fin (2 + m)) R :=
    Fin.addCases (fun i : Fin 2 => if i = 0 then M₁ else M₀) R_rel
  let Δ_crit : MvPolynomial (Fin (2 + m)) R :=
    (Matrix.of fun (i j : Fin (2 + m)) => MvPolynomial.pderiv i (g_crit j)).det
  have h_part1 : M₀ ∈ q₀ ∧ M₁ ∈ q₀ ∧ Δ_crit ∉ q₀ := by
    let P_poly := MvPolynomial (Fin (2 + m)) R
    let m_R := IsLocalRing.maximalIdeal R
    let k₀ := IsLocalRing.ResidueField R
    let red : P_poly →+* MvPolynomial (Fin (2 + m)) k₀ :=
      MvPolynomial.map (IsLocalRing.residue R)
    have hker_red : RingHom.ker red = Ideal.map MvPolynomial.C m_R := by
      dsimp [red, m_R]; rw [MvPolynomial.ker_map, IsLocalRing.ker_residue]
    have hker_le_q₀ : RingHom.ker red ≤ q₀ := by
      rw [hker_red, Ideal.map_le_iff_le_comap, hq₀_comap]
    have hpderiv_ker : ∀ (v : Fin (2 + m)) {D : P_poly},
        D ∈ RingHom.ker red → MvPolynomial.pderiv v D ∈ RingHom.ker red := by
      intro v D hD; rw [RingHom.mem_ker] at hD ⊢; dsimp [red] at hD ⊢
      rw [← MvPolynomial.pderiv_map, hD, map_zero]
    have h0_val : ((0 : Fin (2 + m)) : ℕ) = 0 := by
      change 0 % (2 + m) = 0; exact Nat.mod_eq_of_lt (by omega)
    have h1_val : ((1 : Fin (2 + m)) : ℕ) = 1 := by
      change 1 % (2 + m) = 1; exact Nat.mod_eq_of_lt (by omega)
    have h01_ne : (0 : Fin (2 + m)) ≠ 1 := by
      intro h; have hval := congrArg Fin.val h; rw [h0_val, h1_val] at hval; omega
    have hnatAdd_ne0 : ∀ a : Fin m, Fin.natAdd 2 a ≠ 0 := by
      intro a h; have hval := congrArg Fin.val h; rw [Fin.val_natAdd, h0_val] at hval; omega
    have hnatAdd_ne1 : ∀ a : Fin m, Fin.natAdd 2 a ≠ 1 := by
      intro a h; have hval := congrArg Fin.val h; rw [Fin.val_natAdd, h1_val] at hval; omega
    have hred_F : red F = MvPolynomial.X 0 * MvPolynomial.X 1 := by
      have hmem : F - MvPolynomial.X 0 * MvPolynomial.X 1 ∈ RingHom.ker red := by
        rw [hker_red]; exact hF_mod
      have hsub : red (F - MvPolynomial.X 0 * MvPolynomial.X 1) = 0 := hmem
      rw [map_sub, sub_eq_zero] at hsub; rw [hsub]; dsimp [red]
      rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
    let J_U : Matrix (Fin m) (Fin m) P_poly :=
      Matrix.of fun (a b : Fin m) => MvPolynomial.pderiv (Fin.natAdd 2 a) (R_rel b)
    let Δ_Jac : P_poly := J_U.det
    let NMat : Fin (2 + m) → Matrix (Fin (m + 1)) (Fin (m + 1)) P_poly :=
      fun β => Matrix.of fun (i j : Fin (m + 1)) =>
        MvPolynomial.pderiv (Fin.cases β (Fin.natAdd 2) i) (Fin.cases F R_rel j)
    have hred_NMat : ∀ β : Fin (2 + m),
        red (NMat β).det =
          MvPolynomial.pderiv β
              (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (2 + m)) k₀) *
            red Δ_Jac := by
      intro β
      rw [RingHom.map_det red (NMat β), Matrix.det_succ_column_zero, Fin.sum_univ_succ]
      have htail : ∑ a : Fin m,
          (-1) ^ (a.succ : ℕ) * (red.mapMatrix (NMat β)) a.succ 0 *
            ((red.mapMatrix (NMat β)).submatrix a.succ.succAbove Fin.succ).det = 0 := by
        apply Finset.sum_eq_zero; intro a _
        have hcol0 : (red.mapMatrix (NMat β)) a.succ 0 = 0 := by
          change red (MvPolynomial.pderiv (Fin.natAdd 2 a) F) = 0; dsimp [red]
          rw [← MvPolynomial.pderiv_map]; change MvPolynomial.pderiv (Fin.natAdd 2 a) (red F) = 0
          rw [hred_F, MvPolynomial.pderiv_mul,
            MvPolynomial.pderiv_X_of_ne (hnatAdd_ne0 a).symm,
            MvPolynomial.pderiv_X_of_ne (hnatAdd_ne1 a).symm]; simp
        rw [hcol0]; ring
      rw [htail, add_zero]
      have h00 : (red.mapMatrix (NMat β)) 0 0 =
          MvPolynomial.pderiv β
            (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin (2 + m)) k₀) := by
        change red (MvPolynomial.pderiv β F) = _; dsimp [red]
        rw [← MvPolynomial.pderiv_map]; change MvPolynomial.pderiv β (red F) = _; rw [hred_F]
      have hsub : (red.mapMatrix (NMat β)).submatrix (0 : Fin (m + 1)).succAbove Fin.succ =
          red.mapMatrix J_U := by refine Matrix.ext fun a b => ?_; simp [NMat, J_U]
      rw [h00, hsub, ← RingHom.map_det red J_U]; simp [Δ_Jac]
    have hred_M0 : red M₀ = red (MvPolynomial.X 1 * Δ_Jac) := by
      change red (NMat 0).det = _
      rw [hred_NMat 0, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self,
        MvPolynomial.pderiv_X_of_ne h01_ne.symm]; dsimp [red]; rw [map_mul, MvPolynomial.map_X]; ring
    have hred_M1 : red M₁ = red (MvPolynomial.X 0 * Δ_Jac) := by
      change red (NMat 1).det = _
      rw [hred_NMat 1, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_of_ne h01_ne,
        MvPolynomial.pderiv_X_self]; dsimp [red]; rw [map_mul, MvPolynomial.map_X]; ring
    let D₀ : P_poly := M₀ - MvPolynomial.X 1 * Δ_Jac
    let D₁ : P_poly := M₁ - MvPolynomial.X 0 * Δ_Jac
    have hD₀_ker : D₀ ∈ RingHom.ker red := by
      rw [RingHom.mem_ker]; dsimp [D₀]; rw [map_sub, hred_M0, sub_self]
    have hD₁_ker : D₁ ∈ RingHom.ker red := by
      rw [RingHom.mem_ker]; dsimp [D₁]; rw [map_sub, hred_M1, sub_self]
    have hM0_mem : M₀ ∈ q₀ := by
      have hEq : M₀ = D₀ + MvPolynomial.X 1 * Δ_Jac := by dsimp [D₀]; ring
      rw [hEq]; exact Ideal.add_mem q₀ (hker_le_q₀ hD₀_ker) (Ideal.mul_mem_right Δ_Jac q₀ hX1_mem)
    have hM1_mem : M₁ ∈ q₀ := by
      have hEq : M₁ = D₁ + MvPolynomial.X 0 * Δ_Jac := by dsimp [D₁]; ring
      rw [hEq]; exact Ideal.add_mem q₀ (hker_le_q₀ hD₁_ker) (Ideal.mul_mem_right Δ_Jac q₀ hX0_mem)
    let π_q₀ : P_poly →+* P_poly ⧸ q₀ := Ideal.Quotient.mk q₀
    have hπ_X0 : π_q₀ (MvPolynomial.X 0) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hX0_mem
    have hπ_X1 : π_q₀ (MvPolynomial.X 1) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hX1_mem
    have hπ_pderiv_M1 : ∀ v : Fin (2 + m),
        π_q₀ (MvPolynomial.pderiv v M₁) =
          π_q₀ (MvPolynomial.pderiv v (MvPolynomial.X 0)) * π_q₀ Δ_Jac := by
      intro v; have hEq : M₁ = MvPolynomial.X 0 * Δ_Jac + D₁ := by dsimp [D₁]; ring
      have hD1v : π_q₀ (MvPolynomial.pderiv v D₁) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hker_le_q₀ (hpderiv_ker v hD₁_ker))
      rw [hEq, map_add (MvPolynomial.pderiv v), MvPolynomial.pderiv_mul, map_add, map_add,
        map_mul, map_mul, hπ_X0, zero_mul, add_zero, hD1v, add_zero]
    have hπ_pderiv_M0 : ∀ v : Fin (2 + m),
        π_q₀ (MvPolynomial.pderiv v M₀) =
          π_q₀ (MvPolynomial.pderiv v (MvPolynomial.X 1)) * π_q₀ Δ_Jac := by
      intro v; have hEq : M₀ = MvPolynomial.X 1 * Δ_Jac + D₀ := by dsimp [D₀]; ring
      have hD0v : π_q₀ (MvPolynomial.pderiv v D₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hker_le_q₀ (hpderiv_ker v hD₀_ker))
      rw [hEq, map_add (MvPolynomial.pderiv v), MvPolynomial.pderiv_mul, map_add, map_add,
        map_mul, map_mul, hπ_X1, zero_mul, add_zero, hD0v, add_zero]
    have hg_crit_0 : g_crit 0 = M₁ := by
      have h0_cast : (0 : Fin (2 + m)) = Fin.castAdd m (0 : Fin 2) := by ext; exact h0_val
      rw [h0_cast]; simp [g_crit]
    have hg_crit_1 : g_crit 1 = M₀ := by
      have h1_cast : (1 : Fin (2 + m)) = Fin.castAdd m (1 : Fin 2) := by ext; exact h1_val
      rw [h1_cast]; simp [g_crit]
    have hg_crit_natAdd : ∀ b : Fin m, g_crit (Fin.natAdd 2 b) = R_rel b := fun b => by simp [g_crit]
    let J_crit : Matrix (Fin (2 + m)) (Fin (2 + m)) P_poly :=
      Matrix.of fun (i j : Fin (2 + m)) => MvPolynomial.pderiv i (g_crit j)
    let e : Fin (m + 2) ≃ Fin (2 + m) := finCongr (Nat.add_comm m 2)
    have he_0 : e 0 = 0 := by ext; simp [e]
    have he_1 : e ((0 : Fin (m + 1)).succ) = 1 := by ext; exact h1_val.symm
    have he_succ_succ : ∀ a : Fin m, e a.succ.succ = Fin.natAdd 2 a := by
      intro a; ext; simp [e]; omega
    have he_succ_ne0 : ∀ k : Fin (m + 1), e k.succ ≠ 0 := by
      intro k h; have hval := congrArg Fin.val h; simp [e] at hval
    let B₀ : Matrix (Fin ((m + 1) + 1)) (Fin ((m + 1) + 1)) (P_poly ⧸ q₀) :=
      Matrix.reindex e.symm e.symm (π_q₀.mapMatrix J_crit)
    have hB0_det : B₀.det = π_q₀ Δ_Jac * (B₀.submatrix Fin.succ Fin.succ).det := by
      rw [Matrix.det_succ_column_zero, Fin.sum_univ_succ]
      have htail : ∑ k : Fin (m + 1),
          (-1) ^ (k.succ : ℕ) * B₀ k.succ 0 * (B₀.submatrix k.succ.succAbove Fin.succ).det = 0 := by
        apply Finset.sum_eq_zero; intro k _
        have hcol : B₀ k.succ 0 = 0 := by
          change π_q₀ (MvPolynomial.pderiv (e k.succ) (g_crit (e 0))) = 0
          rw [he_0, hg_crit_0, hπ_pderiv_M1, MvPolynomial.pderiv_X_of_ne (he_succ_ne0 k).symm,
            map_zero, zero_mul]
        rw [hcol]; ring
      rw [htail, add_zero]
      have h00 : B₀ 0 0 = π_q₀ Δ_Jac := by
        change π_q₀ (MvPolynomial.pderiv (e 0) (g_crit (e 0))) = _
        rw [he_0, hg_crit_0, hπ_pderiv_M1, MvPolynomial.pderiv_X_self, map_one, one_mul]
      rw [h00]; simp [Fin.succAbove_zero]
    let B₁ : Matrix (Fin (m + 1)) (Fin (m + 1)) (P_poly ⧸ q₀) := B₀.submatrix Fin.succ Fin.succ
    have hB1_det : B₁.det = π_q₀ Δ_Jac * π_q₀ Δ_Jac := by
      rw [Matrix.det_succ_column_zero, Fin.sum_univ_succ]
      have htail : ∑ a : Fin m,
          (-1) ^ (a.succ : ℕ) * B₁ a.succ 0 * (B₁.submatrix a.succ.succAbove Fin.succ).det = 0 := by
        apply Finset.sum_eq_zero; intro a _
        have hcol : B₁ a.succ 0 = 0 := by
          change π_q₀ (MvPolynomial.pderiv (e a.succ.succ) (g_crit (e ((0 : Fin (m + 1)).succ)))) = 0
          rw [he_succ_succ, he_1, hg_crit_1, hπ_pderiv_M0,
            MvPolynomial.pderiv_X_of_ne (hnatAdd_ne1 a).symm, map_zero, zero_mul]
        rw [hcol]; ring
      rw [htail, add_zero]
      have h00 : B₁ 0 0 = π_q₀ Δ_Jac := by
        change π_q₀ (MvPolynomial.pderiv (e ((0 : Fin (m + 1)).succ))
          (g_crit (e ((0 : Fin (m + 1)).succ)))) = _
        rw [he_1, hg_crit_1, hπ_pderiv_M0, MvPolynomial.pderiv_X_self, map_one, one_mul]
      have hsub : B₁.submatrix (0 : Fin (m + 1)).succAbove Fin.succ = π_q₀.mapMatrix J_U := by
        refine Matrix.ext fun a b => ?_
        change π_q₀ (MvPolynomial.pderiv (e a.succ.succ) (g_crit (e b.succ.succ))) = _
        rw [he_succ_succ, he_succ_succ, hg_crit_natAdd]; rfl
      rw [h00, hsub, ← RingHom.map_det π_q₀ J_U]; simp [Δ_Jac]
    have hπ_Δcrit : π_q₀ Δ_crit = π_q₀ (Δ_Jac ^ 3) := by
      change π_q₀ J_crit.det = _
      rw [RingHom.map_det π_q₀ J_crit, ← Matrix.det_reindex_self e.symm (π_q₀.mapMatrix J_crit)]
      change B₀.det = _; rw [hB0_det]; change π_q₀ Δ_Jac * B₁.det = _; rw [hB1_det, map_pow]; ring
    have hΔ_not_mem : Δ_crit ∉ q₀ := by
      intro hmem
      have h0 : π_q₀ Δ_crit = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      rw [hπ_Δcrit] at h0
      have hpow : Δ_Jac ^ 3 ∈ q₀ := Ideal.Quotient.eq_zero_iff_mem.mp h0
      exact hJac_not_mem ((inferInstance : q₀.IsPrime).mem_of_pow_mem 3 hpow)
    exact ⟨hM0_mem, hM1_mem, hΔ_not_mem⟩

  
  refine ⟨M₀, M₁, Δ_crit, h_part1.1, h_part1.2.1, h_part1.2.2, ?_, ?_⟩
  · 
    dsimp only
    have hRange_crit : Set.range g_crit = insert M₁ (insert M₀ (Set.range R_rel)) := by
      ext P
      simp only [Set.mem_range, Set.mem_insert_iff]
      constructor
      · rintro ⟨v, rfl⟩
        refine @Fin.addCases 2 m
          (fun v => g_crit v = M₁ ∨ g_crit v = M₀ ∨ ∃ a, R_rel a = g_crit v) ?_ ?_ v
        · refine Fin.cases ?_ ?_
          · left; simp [g_crit]
          · intro j; have hj : j = 0 := Subsingleton.elim j 0; subst hj
            right; left; change g_crit (Fin.castAdd m 1) = M₀; simp [g_crit]
        · intro a; right; right; exact ⟨a, by simp [g_crit]⟩
      · rintro (rfl | rfl | ⟨a, rfl⟩)
        · exact ⟨Fin.castAdd m 0, by simp [g_crit]⟩
        · exact ⟨Fin.castAdd m 1, by simp [g_crit]⟩
        · exact ⟨Fin.natAdd 2 a, by simp [g_crit]⟩
    rw [← hRange_crit]
    exact h_part2 R (2 + m) g_crit H_Δ
  · 
    intro K_R _ φ_RK
    letI : Algebra R K_R := φ_RK.toAlgebra
    have hGenA : ∀ (A : Type u) [CommRing A] [Algebra R A]
        [Algebra (MvPolynomial (Fin (2 + m)) R ⧸ I_def) A]
        [IsScalarTower R (MvPolynomial (Fin (2 + m)) R ⧸ I_def) A]
        [IsLocalization.Away (Ideal.Quotient.mk I_def H_Δ) A],
        let π_A : MvPolynomial (Fin (2 + m)) R →+* A :=
          (algebraMap (MvPolynomial (Fin (2 + m)) R ⧸ I_def) A).comp (Ideal.Quotient.mk I_def)
        ∀ (ψ_K : TensorProduct R K_R A →+* K_R)
          (P_K : Ideal (TensorProduct R K_R A)) [P_K.IsPrime],
          P_K = RingHom.ker ψ_K →
          (∀ c : K_R, ψ_K (c ⊗ₜ[R] 1) = c) →
          (ψ_K (1 ⊗ₜ[R] π_A M₀) ≠ 0 ∨ ψ_K (1 ⊗ₜ[R] π_A M₁) ≠ 0) →
          IsDomain (Localization.AtPrime P_K) := by
      intro A _ _ _ _ _ π_A ψ_K P_K _ hPK hψ_c hM_ne
      let inl_BK : K_R →+* TensorProduct R K_R A := Algebra.TensorProduct.includeLeftRingHom
      let inr_BK : A →+* TensorProduct R K_R A :=
        (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R K_R A).toRingHom
      have hBK_comm : ∀ r : R, inl_BK (φ_RK r) = inr_BK (algebraMap R A r) :=
        fun r => ((Algebra.TensorProduct.includeRight :
          A →ₐ[R] TensorProduct R K_R A).commutes r).symm
      have hBK_lift : ∀ {T : Type u} [CommRing T] (fK : K_R →+* T) (fA : A →+* T),
          (∀ r : R, fK (φ_RK r) = fA (algebraMap R A r)) →
          ∃ φ : TensorProduct R K_R A →+* T,
            (∀ c : K_R, φ (inl_BK c) = fK c) ∧ (∀ a : A, φ (inr_BK a) = fA a) := by
        intro T _ fK fA hcomm
        letI : Algebra R T := (fK.comp φ_RK).toAlgebra
        let fK_alg : K_R →ₐ[R] T := { toRingHom := fK, commutes' := fun _ => rfl }
        let fA_alg : A →ₐ[R] T := { toRingHom := fA, commutes' := fun r => (hcomm r).symm }
        refine ⟨(Algebra.TensorProduct.productMap fK_alg fA_alg).toRingHom, ?_, ?_⟩
        · intro c; change fK c * fA 1 = fK c; rw [map_one, mul_one]
        · intro a; change fK 1 * fA a = fA a; rw [map_one, one_mul]
      have hBK_ext : ∀ {T : Type u} [CommRing T] {φ₁ φ₂ : TensorProduct R K_R A →+* T},
          (∀ c : K_R, φ₁ (inl_BK c) = φ₂ (inl_BK c)) →
          (∀ a : A, φ₁ (inr_BK a) = φ₂ (inr_BK a)) →
          φ₁ = φ₂ := by
        intro T _ φ₁ φ₂ hl hr
        refine RingHom.ext fun z => ?_
        induction z using TensorProduct.induction_on with
        | zero => simp only [map_zero]
        | tmul c a =>
          have hmul : (c ⊗ₜ[R] a : TensorProduct R K_R A) = inl_BK c * inr_BK a := by
            simp [inl_BK, inr_BK]
          rw [hmul, map_mul, map_mul, hl c, hr a]
        | add x y ihx ihy => simp only [map_add, ihx, ihy]
      have hAbs : ∀ (S_poly : Type u) [CommRing S_poly] [Algebra K_R S_poly]
          (T_var : S_poly)
          (aeval_X1 : S_poly →ₐ[K_R] MvPolynomial (Fin (2 + m)) K_R),
          aeval_X1 T_var = MvPolynomial.X 1 →
          (∀ (f₁ f₂ : S_poly →+* MvPolynomial (Fin (m + 1)) S_poly),
            (∀ c : K_R, f₁ (algebraMap K_R S_poly c) = f₂ (algebraMap K_R S_poly c)) →
            f₁ T_var = f₂ T_var →
            ∀ p : S_poly, f₁ p = f₂ p) →
          (∀ (C : Type u) [CommRing C] [Algebra S_poly C] [Algebra.Etale S_poly C]
            (ε : C →+* K_R) (Q : Ideal C) [Q.IsPrime],
            Q = RingHom.ker ε →
            (∀ c : K_R, ε (algebraMap S_poly C (algebraMap K_R S_poly c)) = c) →
            IsDomain (Localization.AtPrime Q)) →
          IsDomain (Localization.AtPrime P_K) := by
        intro S_poly _ _ T_var aeval_X1 haeval_T h_poly_ext h_dom_S
        obtain ⟨⟨Θ₀, hΘ₀_pd⟩, ⟨Θ₁, hΘ₁_pd⟩⟩ :=
          h_theta K_R S_poly T_var aeval_X1 haeval_T h_poly_ext
        have hRun : ∀ (Θ : MvPolynomial (Fin (2 + m)) K_R ≃ₐ[K_R] MvPolynomial (Fin (m + 1)) S_poly)
            (β : Fin (2 + m))
            (M_β : MvPolynomial (Fin (2 + m)) R),
            (∀ (i : Fin (m + 1)) (Q : MvPolynomial (Fin (2 + m)) K_R),
              MvPolynomial.pderiv i (Θ Q) =
                Θ (MvPolynomial.pderiv (Fin.cases β (Fin.natAdd 2) i) Q)) →
            M_β = (Matrix.of fun (i j : Fin (m + 1)) =>
              MvPolynomial.pderiv (Fin.cases β (Fin.natAdd 2) i) (Fin.cases F R_rel j)).det →
            ψ_K (1 ⊗ₜ[R] π_A M_β) ≠ 0 →
            IsDomain (Localization.AtPrime P_K) := by
          intro Θ β M_β hΘ_pd hM_eq hψ_M
          let m_β : TensorProduct R K_R A := 1 ⊗ₜ[R] π_A M_β
          let B_loc := Localization.Away m_β
          have h_loc_iso : ∀ (P_β : Ideal B_loc) [P_β.IsPrime],
              Ideal.comap (algebraMap (TensorProduct R K_R A) B_loc) P_β = P_K →
              Nonempty (Localization.AtPrime P_K ≃+* Localization.AtPrime P_β) := by
            intro P_β _ hcomap
            let e1 :=
              IsLocalization.localizationLocalizationAtPrimeIsoLocalization (Submonoid.powers m_β) P_β
            let P_comap := Ideal.comap (algebraMap (TensorProduct R K_R A) B_loc) P_β
            let e0 : Localization.AtPrime P_K ≃+* Localization.AtPrime P_comap :=
              IsLocalization.ringEquivOfRingEquiv (M := P_K.primeCompl)
                (T := P_comap.primeCompl)
                (Localization.AtPrime P_K)
                (Localization.AtPrime P_comap)
                (RingEquiv.refl (TensorProduct R K_R A))
                (by ext x; simp [P_comap, hcomap])
            exact ⟨e0.trans e1.toRingEquiv⟩
          let g_T : Fin (m + 1) → MvPolynomial (Fin (m + 1)) S_poly :=
            fun j => Θ (MvPolynomial.map φ_RK (Fin.cases F R_rel j))
          let h_T : MvPolynomial (Fin (m + 1)) S_poly := Θ (MvPolynomial.map φ_RK H_Δ)
          let I_T : Ideal (MvPolynomial (Fin (m + 1)) S_poly) := Ideal.span (Set.range g_T)
          let Δ_T : MvPolynomial (Fin (m + 1)) S_poly :=
            (Matrix.of fun (i j : Fin (m + 1)) => MvPolynomial.pderiv i (g_T j)).det
          let d_T : MvPolynomial (Fin (m + 1)) S_poly ⧸ I_T := Ideal.Quotient.mk I_T (h_T * Δ_T)
          let C_T := Localization.Away d_T
          have hEt_CT : Algebra.Etale S_poly C_T := h_part2 S_poly (m + 1) g_T h_T
          have hm_β_inr : m_β = inr_BK ((algebraMap (MvPolynomial (Fin (2 + m)) R ⧸ I_def) A)
              (Ideal.Quotient.mk I_def M_β)) := by
            simp [m_β, inr_BK, π_A]
          exact h_build_fast K_R φ_RK S_poly I_def rfl (Ideal.Quotient.mk I_def H_Δ) rfl
            A (TensorProduct R K_R A)
            inl_BK inr_BK hBK_comm hBK_lift hBK_ext ψ_K P_K hPK hψ_c
            Θ β M_β hΘ_pd hM_eq m_β hm_β_inr hψ_M B_loc h_loc_iso
            g_T (fun _ => rfl) h_T rfl I_T rfl Δ_T rfl d_T rfl C_T
            (fun ε Q _ hQ hε => @h_dom_S C_T _ _ hEt_CT ε Q _ hQ hε)
        rcases hM_ne with hM0_ne | hM1_ne
        · exact hRun Θ₀ (0 : Fin (2 + m)) M₀ hΘ₀_pd rfl hM0_ne
        · exact hRun Θ₁ (1 : Fin (2 + m)) M₁ hΘ₁_pd rfl hM1_ne
      refine hAbs (Polynomial K_R) Polynomial.X
        (Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin (2 + m)) K_R))
        (Polynomial.aeval_X _) ?_ ?_
      · intro f₁ f₂ hc hX p
        exact DFunLike.congr_fun (Polynomial.ringHom_ext' (RingHom.ext hc) hX) p
      · intro C _ _ _ ε Q _ hQ hε_C
        exact h_part4 K_R C ε Q hQ hε_C
    exact hGenA A_def

theorem weil_section_pullback_point_eq_and_etale_domain_stalk_unique_comp : (∀ (R K_R : Type u) [CommRing R] [Field K_R] (φ_RK : R →+* K_R)
      (C_R : AlgebraicGeometry.Scheme.{u})
      (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
      (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R),
      σ ≫ g_R = 𝟙 _ →
      let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK)
      ∀ (p : ↥(CategoryTheory.Limits.pullback g_R η_R))
        (pt : AlgebraicGeometry.Spec (CommRingCat.of K_R))
        (s_K : AlgebraicGeometry.Spec (CommRingCat.of K_R) ⟶
          CategoryTheory.Limits.pullback g_R η_R),
        (CategoryTheory.Limits.pullback.fst g_R η_R).base p = (η_R ≫ σ).base pt →
        s_K ≫ CategoryTheory.Limits.pullback.fst g_R η_R = η_R ≫ σ →
        p = s_K.base pt) ∧
    (∀ (X : AlgebraicGeometry.Scheme.{u}) (B : Type u) [CommRing B]
      (e : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ X),
      AlgebraicGeometry.Etale e →
      ∀ (P : Ideal B) [hP : P.IsPrime],
        IsDomain (Localization.AtPrime P) →
        ∀ (E₁ E₂ : Set ↥X),
          E₁ ∈ irreducibleComponents ↥X →
          E₂ ∈ irreducibleComponents ↥X →
          e.base ⟨P, hP⟩ ∈ E₁ →
          e.base ⟨P, hP⟩ ∈ E₂ →
          E₁ = E₂) :=
by
  refine ⟨?_, ?_⟩
  · intro R K_R _ _ φ_RK C_R g_R σ hσ η_R p pt s_K hp hs_K
    let S := AlgebraicGeometry.Spec (CommRingCat.of R)
    let T := AlgebraicGeometry.Spec (CommRingCat.of K_R)
    let fst := CategoryTheory.Limits.pullback.fst g_R η_R
    let snd := CategoryTheory.Limits.pullback.snd g_R η_R
    have h_cond : (η_R ≫ σ) ≫ g_R = 𝟙 T ≫ η_R := by
      rw [CategoryTheory.Category.assoc, hσ, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    let s_can : T ⟶ CategoryTheory.Limits.pullback g_R η_R :=
      CategoryTheory.Limits.pullback.lift (η_R ≫ σ) (𝟙 T) h_cond
    have h_can_fst : s_can ≫ fst = η_R ≫ σ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have h_can_snd : s_can ≫ snd = 𝟙 T :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have h_id_pb : CategoryTheory.IsPullback η_R (𝟙 T) (𝟙 S) η_R :=
      CategoryTheory.IsPullback.of_vert_isIso
        ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
    have h_outer : CategoryTheory.IsPullback η_R (s_can ≫ snd) (σ ≫ g_R) η_R := by
      rwa [h_can_snd, hσ]
    have h_top : CategoryTheory.IsPullback s_can η_R fst σ :=
      (CategoryTheory.IsPullback.of_bot h_outer h_can_fst.symm
        (CategoryTheory.IsPullback.of_hasPullback g_R η_R)).flip
    have h_eq_can : ∀ x : ↥(CategoryTheory.Limits.pullback g_R η_R),
        fst.base x = (η_R ≫ σ).base pt → x = s_can.base pt := by
      intro x hx
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at hx
      obtain ⟨t, ht, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback h_top x (η_R.base pt) hx
      have h_sub : t = pt := Subsingleton.elim t pt
      rw [← ht, h_sub]
    have hp_can : p = s_can.base pt := h_eq_can p hp
    have hsK_fst_pt : fst.base (s_K.base pt) = (η_R ≫ σ).base pt := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hs_K]
    have hsK_can : s_K.base pt = s_can.base pt := h_eq_can (s_K.base pt) hsK_fst_pt
    exact hp_can.trans hsK_can.symm
  · intro X B _ e he P hP hDom E₁ E₂ hE₁ hE₂ hxE₁ hxE₂
    let L := Localization.AtPrime P
    let u_P : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B L))
    let f_P : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ X := u_P ≫ e
    let c_P : ↥(AlgebraicGeometry.Spec (CommRingCat.of L)) := IsLocalRing.closedPoint L
    let x : ↥X := e.base ⟨P, hP⟩
    have hu_cP : u_P.base c_P = ⟨P, hP⟩ :=
      PrimeSpectrum.ext (IsLocalization.AtPrime.under_maximalIdeal L P)
    have hf_cP : f_P.base c_P = x := by
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply, hu_cP]
    have hFlat_alg : (algebraMap B L).Flat :=
      RingHom.flat_algebraMap_iff.mpr inferInstance
    have : AlgebraicGeometry.Flat u_P :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)).mpr hFlat_alg
    have : AlgebraicGeometry.Etale e := he
    have : AlgebraicGeometry.Flat f_P := inferInstance
    let ψ_stalk := (f_P.stalkMap c_P).hom
    have hFlat_ψ : ψ_stalk.Flat := AlgebraicGeometry.Flat.stalkMap f_P c_P
    have hInj_ψ : Function.Injective ψ_stalk := by
      let _ := ψ_stalk.toAlgebra
      have : Module.Flat ↑(X.presheaf.stalk (f_P.base c_P))
          ↑((AlgebraicGeometry.Spec (CommRingCat.of L)).presheaf.stalk c_P) := hFlat_ψ
      have : IsLocalHom (algebraMap ↑(X.presheaf.stalk (f_P.base c_P))
          ↑((AlgebraicGeometry.Spec (CommRingCat.of L)).presheaf.stalk c_P)) :=
        inferInstanceAs (IsLocalHom ψ_stalk)
      have hFaith : Module.FaithfullyFlat ↑(X.presheaf.stalk (f_P.base c_P))
          ↑((AlgebraicGeometry.Spec (CommRingCat.of L)).presheaf.stalk c_P) :=
        Module.FaithfullyFlat.of_flat_of_isLocalHom
      exact RingHom.FaithfullyFlat.injective hFaith
    let ι_L := (AlgebraicGeometry.stalkClosedPointIso (CommRingCat.of L)).hom
    have hInj_ιL : Function.Injective ι_L.hom :=
      (CategoryTheory.ConcreteCategory.bijective_of_isIso ι_L).1
    have hDom_fcP : IsDomain ↑(X.presheaf.stalk (f_P.base c_P)) :=
      Function.Injective.isDomain (ι_L.hom.comp ψ_stalk) (hInj_ιL.comp hInj_ψ)
    have hDom_x : IsDomain ↑(X.presheaf.stalk x) := hf_cP ▸ hDom_fcP
    obtain ⟨U, hU, hxU, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
    let A : Type u := ↑(X.presheaf.obj (Opposite.op U))
    let x_U : ↥U := ⟨x, hxU⟩
    let z₀ : PrimeSpectrum A := hU.primeIdealOf x_U
    let _ : Algebra A ↑(X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf x_U
    have : IsLocalization.AtPrime ↑(X.presheaf.stalk x) z₀.asIdeal :=
      hU.isLocalization_stalk x_U
    let q₀ : Ideal A := RingHom.ker (algebraMap A ↑(X.presheaf.stalk x))
    have hq₀ : q₀.IsPrime := RingHom.ker_isPrime (algebraMap A ↑(X.presheaf.stalk x))
    have hq₀_min : ∀ (q : Ideal A), q.IsPrime → q ≤ z₀.asIdeal → q₀ ≤ q := by
      intro q hq hqz a ha
      have ha0 : algebraMap A ↑(X.presheaf.stalk x) a = 0 := ha
      obtain ⟨m, hma⟩ :=
        (IsLocalization.map_eq_zero_iff z₀.asIdeal.primeCompl ↑(X.presheaf.stalk x) a).mp ha0
      have hmem : m.1 * a ∈ q := by
        rw [hma]
        exact q.zero_mem
      rcases hq.mem_or_mem hmem with hm | haq
      · exact False.elim (m.2 (hqz hm))
      · exact haq
    let j : PrimeSpectrum A → ↥X := hU.fromSpec.base
    have : AlgebraicGeometry.IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hj : Topology.IsOpenEmbedding j := hU.fromSpec.isOpenEmbedding
    have hj_z₀ : j z₀ = x := hU.fromSpec_primeIdealOf x_U
    have hE_char : ∀ E : Set ↥X,
        E ∈ irreducibleComponents ↥X → x ∈ E →
        E = closure (j '' PrimeSpectrum.zeroLocus (q₀ : Set A)) := by
      intro E hE hxE
      have hE_irr : IsIrreducible E := hE.1
      have hE_max : ∀ T : Set ↥X, IsIrreducible T → E ⊆ T → T ⊆ E := hE.2
      have hE_cl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
      have hE_clos : closure (j '' (j ⁻¹' E)) = E := by
        rw [Set.image_preimage_eq_inter_range]
        apply Set.Subset.antisymm
        · exact hE_cl.closure_subset_iff.mpr Set.inter_subset_left
        · intro y hyE
          rw [mem_closure_iff]
          intro O hO hyO
          obtain ⟨w, hwE, hwO, hwR⟩ :=
            hE_irr.isPreirreducible O (Set.range j) hO hj.isOpen_range
              ⟨y, hyE, hyO⟩ ⟨x, hxE, z₀, hj_z₀⟩
          exact ⟨w, hwO, hwE, hwR⟩
      have hjE_irr : IsIrreducible (j ⁻¹' E) := by
        refine ⟨⟨z₀, ?_⟩, ?_⟩
        · show j z₀ ∈ E
          rw [hj_z₀]
          exact hxE
        · intro W₁ W₂ hW₁ hW₂ ⟨w₁, hw₁E, hw₁W⟩ ⟨w₂, hw₂E, hw₂W⟩
          obtain ⟨v, hvE, ⟨u₁, hu₁W, rfl⟩, ⟨u₂, hu₂W, hju⟩⟩ :=
            hE_irr.isPreirreducible (j '' W₁) (j '' W₂)
              (hj.isOpenMap W₁ hW₁) (hj.isOpenMap W₂ hW₂)
              ⟨j w₁, hw₁E, w₁, hw₁W, rfl⟩ ⟨j w₂, hw₂E, w₂, hw₂W, rfl⟩
          have hu_eq : u₁ = u₂ := hj.toIsEmbedding.injective hju.symm
          refine ⟨u₁, hvE, hu₁W, ?_⟩
          rw [hu_eq]
          exact hu₂W
      have hjE_comp : j ⁻¹' E ∈ irreducibleComponents (PrimeSpectrum A) := by
        refine ⟨hjE_irr, ?_⟩
        intro S' hS' hsub
        have hS'_irr : IsIrreducible (closure (j '' S')) :=
          (hS'.image j hj.continuous.continuousOn).closure
        have hE_sub : E ⊆ closure (j '' S') := by
          rw [← hE_clos]
          exact closure_mono (Set.image_mono hsub)
        have hclos_sub : closure (j '' S') ⊆ E := hE_max (closure (j '' S')) hS'_irr hE_sub
        intro z hz
        exact hclos_sub (subset_closure ⟨z, hz, rfl⟩)
      rw [← PrimeSpectrum.zeroLocus_minimalPrimes] at hjE_comp
      obtain ⟨q, hq_min, hq_eq⟩ := hjE_comp
      dsimp only [Function.comp_apply] at hq_eq
      have hz₀_mem : z₀ ∈ PrimeSpectrum.zeroLocus (q : Set A) := by
        rw [hq_eq]
        show j z₀ ∈ E
        rw [hj_z₀]
        exact hxE
      have hq_le_z₀ : q ≤ z₀.asIdeal := by
        simpa [PrimeSpectrum.mem_zeroLocus] using hz₀_mem
      have hq₀_le_q : q₀ ≤ q := hq₀_min q hq_min.1.1 hq_le_z₀
      have hq_le_q₀ : q ≤ q₀ := hq_min.2 ⟨hq₀, bot_le⟩ hq₀_le_q
      have hq_eq_q₀ : q = q₀ := le_antisymm hq_le_q₀ hq₀_le_q
      rw [← hE_clos, ← hq_eq, hq_eq_q₀]
    exact (hE_char E₁ hE₁ hxE₁).trans (hE_char E₂ hE₂ hxE₂).symm

theorem weil_henselian_nodal_roof_nonsmooth_section_unique (R : Type u) [CommRing R] [HenselianLocalRing R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (K_R : Type u) [Field K_R]
    (φ_RK : R →+* K_R)
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (hFlat : AlgebraicGeometry.Flat g_R)
    (hProp : AlgebraicGeometry.IsProper g_R)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g_R)
    (y₀ : ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))))
    (hNode₀ : ∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
        (e₁ : U' ⟶ CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))
        (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin 2) (IsLocalRing.ResidueField R) ⧸ Ideal.span
            {(MvPolynomial.X 0 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) *
              (MvPolynomial.X 1 : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R))} ))),
      AlgebraicGeometry.Etale e₁ ∧
      AlgebraicGeometry.Etale e₂ ∧
      e₁.base u₀ = y₀ ∧
      (∀ i : Fin 2,
        Ideal.Quotient.mk _
          (MvPolynomial.X i : MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)) ∈
          (e₂.base u₀).asIdeal) ∧
      e₁ ≫ CategoryTheory.Limits.pullback.snd g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) =
        e₂ ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
            (MvPolynomial.C :
              IsLocalRing.ResidueField R →+*
                MvPolynomial (Fin 2) (IsLocalRing.ResidueField R)))))
    (σ₁ σ₂ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R)
    (hσ₁ : σ₁ ≫ g_R = 𝟙 _)
    (hσ₂ : σ₂ ≫ g_R = 𝟙 _)
    (hClose : ∀ m_R : AlgebraicGeometry.Spec (CommRingCat.of R),
      m_R.asIdeal = IsLocalRing.maximalIdeal R →
      σ₁.base m_R =
        (CategoryTheory.Limits.pullback.fst g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ ∧
      σ₂.base m_R =
        (CategoryTheory.Limits.pullback.fst g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀)
    (p₁ p₂ : ↥(CategoryTheory.Limits.pullback g_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK))))
    (hp₁_sec : ∃ pt₁ : AlgebraicGeometry.Spec (CommRingCat.of K_R),
      (CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK))).base p₁ =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK) ≫ σ₁).base pt₁)
    (hp₂_sec : ∃ pt₂ : AlgebraicGeometry.Spec (CommRingCat.of K_R),
      (CategoryTheory.Limits.pullback.fst g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK))).base p₂ =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK) ≫ σ₂).base pt₂)
    (hp₁_mult : ∃ E₁ ∈ irreducibleComponents
        ↥(CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK))),
      ∃ E₂ ∈ irreducibleComponents
        ↥(CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK))),
        E₁ ≠ E₂ ∧ p₁ ∈ E₁ ∧ p₁ ∈ E₂)
    (hp₂_mult : ∃ E₁ ∈ irreducibleComponents
        ↥(CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK))),
      ∃ E₂ ∈ irreducibleComponents
        ↥(CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK))),
        E₁ ≠ E₂ ∧ p₂ ∈ E₁ ∧ p₂ ∈ E₂) :
    p₁ = p₂ :=
by
  classical
  
  obtain ⟨m, R_rel, F, H_Δ, q₀, hq₀_prime, hR_mem, _hF_mem, hX0_mem, hX1_mem,
      hq₀_comap, hHΔ_not_mem, hJac_not_mem, hF_mod,
      e_C, q_def, hEt_eC, heC_gR, hq_def_comap, heC_qdef⟩ :=
    weil_flat_lfp_closed_nodal_roof_lift_presentation R hAlgRes C_R g_R hFlat hLFP y₀ hNode₀
  have _ : q₀.IsPrime := hq₀_prime
  let P_poly := MvPolynomial (Fin (2 + m)) R
  let I_def : Ideal P_poly := Ideal.span (insert F (Set.range R_rel))
  let A_def : Type u := Localization.Away (Ideal.Quotient.mk I_def H_Δ)
  let π_def : P_poly →+* A_def :=
    (algebraMap (P_poly ⧸ I_def) A_def).comp (Ideal.Quotient.mk I_def)
  obtain ⟨M₀, M₁, Δ_crit, hM0_mem, hM1_mem, hΔcrit_not_mem, hEt_Bcrit, hDom_KR⟩ :=
    weil_nodal_deformation_critical_minors_etale_and_smooth_fiber
      R m R_rel F H_Δ q₀ hR_mem hX0_mem hX1_mem hq₀_comap hHΔ_not_mem hJac_not_mem hF_mod

  
  let I_crit : Ideal P_poly := Ideal.span (insert M₁ (insert M₀ (Set.range R_rel)))
  let Q_crit := P_poly ⧸ I_crit
  let d_crit : Q_crit := Ideal.Quotient.mk I_crit (H_Δ * Δ_crit)
  let B_crit : Type u := Localization.Away d_crit
  have _ : Algebra.Etale R B_crit := hEt_Bcrit
  let π_B : P_poly →+* B_crit :=
    (algebraMap Q_crit B_crit).comp (Ideal.Quotient.mk I_crit)
  have hIcrit_le_q₀ : I_crit ≤ q₀ := by
    rw [Ideal.span_le]
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx'
    · exact hM1_mem
    · rcases Set.mem_insert_iff.mp hx' with rfl | ⟨a, rfl⟩
      · exact hM0_mem
      · exact hR_mem a
  let D₀ := P_poly ⧸ q₀
  let L₀ := FractionRing D₀
  let π_q₀ : P_poly →+* L₀ := (algebraMap D₀ L₀).comp (Ideal.Quotient.mk q₀)
  have hker_πq₀ : ∀ P : P_poly, π_q₀ P = 0 ↔ P ∈ q₀ := by
    intro P
    simp only [π_q₀, RingHom.comp_apply]
    rw [← map_zero (algebraMap D₀ L₀), (IsFractionRing.injective D₀ L₀).eq_iff,
      Ideal.Quotient.eq_zero_iff_mem]
  let πbar_q₀ : Q_crit →+* L₀ :=
    Ideal.Quotient.lift I_crit π_q₀ (fun P hP => (hker_πq₀ P).mpr (hIcrit_le_q₀ hP))
  have hd_crit_unit : IsUnit (πbar_q₀ d_crit) := by
    apply IsUnit.mk0
    intro h0
    have hmem : H_Δ * Δ_crit ∈ q₀ := (hker_πq₀ (H_Δ * Δ_crit)).mp h0
    rcases hq₀_prime.mem_or_mem hmem with h1 | h2
    · exact hHΔ_not_mem h1
    · exact hΔcrit_not_mem h2
  let ψ_crit : B_crit →+* L₀ := IsLocalization.Away.lift d_crit hd_crit_unit
  have hψ_crit_πB : ∀ P : P_poly, ψ_crit (π_B P) = π_q₀ P := by
    intro P
    change IsLocalization.Away.lift d_crit hd_crit_unit
      (algebraMap Q_crit B_crit (Ideal.Quotient.mk I_crit P)) = π_q₀ P
    rw [IsLocalization.Away.lift_eq]
    rfl
  let p_crit : Ideal B_crit := RingHom.ker ψ_crit
  have _ : p_crit.IsPrime := RingHom.ker_isPrime ψ_crit
  have hp_crit_comap : Ideal.comap (algebraMap R B_crit) p_crit = IsLocalRing.maximalIdeal R := by
    ext r
    simp only [p_crit, Ideal.mem_comap, RingHom.mem_ker]
    have halg : algebraMap R B_crit r = π_B (MvPolynomial.C r) := by
      simp only [π_B, RingHom.comp_apply]
      rw [IsScalarTower.algebraMap_apply R Q_crit B_crit]
      rfl
    rw [halg, hψ_crit_πB, hker_πq₀, ← hq₀_comap]
    rfl
  obtain ⟨h_crit, hh_crit_not_mem, hBij_crit⟩ :=
    weil_henselian_algClosed_etale_away_bijective R hAlgRes B_crit p_crit hp_crit_comap
  obtain ⟨⟨x_num, ⟨_, k₀, rfl⟩⟩, hx_num_eq⟩ :=
    IsLocalization.surj (Submonoid.powers d_crit) h_crit
  obtain ⟨H_num, hH_num_mk⟩ := Ideal.Quotient.mk_surjective x_num
  have hH_num_eq : h_crit * π_B (H_Δ * Δ_crit) ^ k₀ = π_B H_num := by
    simpa [π_B, d_crit, hH_num_mk] using hx_num_eq
  have hH_num_not_mem : H_num ∉ q₀ := by
    intro hmem
    have h0 : ψ_crit (π_B H_num) = 0 := by
      rw [hψ_crit_πB, (hker_πq₀ H_num).mpr hmem]
    rw [← hH_num_eq, map_mul, map_pow] at h0
    rcases mul_eq_zero.mp h0 with hh0 | hd0
    · exact hh_crit_not_mem hh0
    · have hd0' : ψ_crit (π_B (H_Δ * Δ_crit)) = 0 := eq_zero_of_pow_eq_zero hd0
      rw [hψ_crit_πB, hker_πq₀] at hd0'
      rcases hq₀_prime.mem_or_mem hd0' with h1 | h2
      · exact hHΔ_not_mem h1
      · exact hΔcrit_not_mem h2
  let H_inv : P_poly := H_Δ * Δ_crit * H_num
  have hH_inv_not_mem : H_inv ∉ q₀ := by
    intro hmem
    rcases hq₀_prime.mem_or_mem hmem with h12 | h3
    · rcases hq₀_prime.mem_or_mem h12 with h1 | h2
      · exact hHΔ_not_mem h1
      · exact hΔcrit_not_mem h2
    · exact hH_num_not_mem h3
  have hClear : ∀ P : P_poly, ∃ (r : R) (N_P : ℕ),
      H_inv ^ N_P * (P - MvPolynomial.C r) ∈ I_crit := by
    intro P
    obtain ⟨r, hr⟩ := hBij_crit.2 (algebraMap B_crit (Localization.Away h_crit) (π_B P))
    have halg_r : algebraMap R (Localization.Away h_crit) r =
        algebraMap B_crit (Localization.Away h_crit) (π_B (MvPolynomial.C r)) := by
      rw [IsScalarTower.algebraMap_apply R B_crit (Localization.Away h_crit)]
      congr 1
    have hsub_zero :
        algebraMap B_crit (Localization.Away h_crit) (π_B (P - MvPolynomial.C r)) = 0 := by
      rw [map_sub, map_sub, ← hr, halg_r, sub_self]
    obtain ⟨⟨_, k₁, rfl⟩, hk₁⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers h_crit) (Localization.Away h_crit) _).mp
        hsub_zero
    have hnum_pow : π_B (H_num ^ k₁) = h_crit ^ k₁ * π_B (H_Δ * Δ_crit) ^ (k₀ * k₁) := by
      rw [map_pow, ← hH_num_eq, mul_pow, ← pow_mul]
    have hB_zero : π_B (H_num ^ k₁ * (P - MvPolynomial.C r)) = 0 := by
      rw [map_mul, hnum_pow]
      calc
        h_crit ^ k₁ * π_B (H_Δ * Δ_crit) ^ (k₀ * k₁) * π_B (P - MvPolynomial.C r) =
            π_B (H_Δ * Δ_crit) ^ (k₀ * k₁) * (h_crit ^ k₁ * π_B (P - MvPolynomial.C r)) := by
          ring
        _ = 0 := by rw [hk₁, mul_zero]
    obtain ⟨⟨_, k₂, rfl⟩, hk₂⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers d_crit) B_crit _).mp hB_zero
    have hQ_zero :
        Ideal.Quotient.mk I_crit ((H_Δ * Δ_crit) ^ k₂ * (H_num ^ k₁ * (P - MvPolynomial.C r))) = 0 := by
      simpa [d_crit] using hk₂
    have hmem_k : (H_Δ * Δ_crit) ^ k₂ * (H_num ^ k₁ * (P - MvPolynomial.C r)) ∈ I_crit :=
      Ideal.Quotient.eq_zero_iff_mem.mp hQ_zero
    refine ⟨r, k₁ + k₂, ?_⟩
    have h_id : H_inv ^ (k₁ + k₂) * (P - MvPolynomial.C r) =
        ((H_Δ * Δ_crit) ^ k₁ * H_num ^ k₂) *
          ((H_Δ * Δ_crit) ^ k₂ * (H_num ^ k₁ * (P - MvPolynomial.C r))) := by
      dsimp [H_inv]
      ring
    rw [h_id]
    exact Ideal.mul_mem_left I_crit _ hmem_k

  
  let m_R_pt : AlgebraicGeometry.Spec (CommRingCat.of R) :=
    ⟨IsLocalRing.maximalIdeal R, inferInstance⟩
  have hClose_m : σ₁.base m_R_pt = e_C.base q_def ∧ σ₂.base m_R_pt = e_C.base q_def := by
    obtain ⟨h1, h2⟩ := hClose m_R_pt rfl
    exact ⟨h1.trans heC_qdef.symm, h2.trans heC_qdef.symm⟩
  have hLiftSec : ∀ (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R),
      σ ≫ g_R = 𝟙 _ →
      σ.base m_R_pt = e_C.base q_def →
      ∃ (α_hat : A_def →+* R),
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_hat) ≫ e_C = σ ∧
        α_hat.comp (algebraMap R A_def) = RingHom.id R ∧
        Ideal.comap α_hat (IsLocalRing.maximalIdeal R) = q_def.asIdeal := by
    intro σ hσ_sec hσ_m
    let P_σ := CategoryTheory.Limits.pullback σ e_C
    let π_σ := CategoryTheory.Limits.pullback.fst σ e_C
    let ρ_σ := CategoryTheory.Limits.pullback.snd σ e_C
    have hEt_πσ : AlgebraicGeometry.Etale π_σ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback σ e_C).flip hEt_eC
    obtain ⟨z_σ, hz_π, hz_ρ⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback m_R_pt q_def hσ_m
    obtain ⟨V_σ, hAff_Vσ, hz_Vσ, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z_σ) trivial
    let C_σ_cat := P_σ.presheaf.obj (Opposite.op V_σ)
    let C_σ : Type u := ↑C_σ_cat
    let f_V : AlgebraicGeometry.Spec C_σ_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
      hAff_Vσ.fromSpec ≫ π_σ
    let g_V : AlgebraicGeometry.Spec C_σ_cat ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_def) :=
      hAff_Vσ.fromSpec ≫ ρ_σ
    have hEt_fV : AlgebraicGeometry.Etale f_V := inferInstance
    let φ_R_Cσ : R →+* C_σ := (AlgebraicGeometry.Spec.preimage f_V).hom
    let φ_A_Cσ : A_def →+* C_σ := (AlgebraicGeometry.Spec.preimage g_V).hom
    have hf_V_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Cσ) = f_V :=
      AlgebraicGeometry.Spec.map_preimage f_V
    have hg_V_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A_Cσ) = g_V :=
      AlgebraicGeometry.Spec.map_preimage g_V
    have hEt_φR : φ_R_Cσ.Etale := by
      have hSpecEt : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Cσ)) := by
        rw [hf_V_eq]
        exact hEt_fV
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale) (Q := @RingHom.Etale)).mp hSpecEt
    let q_z_pt : AlgebraicGeometry.Spec C_σ_cat := hAff_Vσ.isoSpec.hom.base ⟨z_σ, hz_Vσ⟩
    have hfromSpec_qz : hAff_Vσ.fromSpec.base q_z_pt = z_σ := by
      rw [← hAff_Vσ.isoSpec_inv_ι]
      have h_inv : (hAff_Vσ.isoSpec.hom ≫ hAff_Vσ.isoSpec.inv).base ⟨z_σ, hz_Vσ⟩ = ⟨z_σ, hz_Vσ⟩ := by
        rw [hAff_Vσ.isoSpec.hom_inv_id]
        rfl
      change V_σ.ι.base (hAff_Vσ.isoSpec.inv.base (hAff_Vσ.isoSpec.hom.base ⟨z_σ, hz_Vσ⟩)) = z_σ
      have h_inv' : hAff_Vσ.isoSpec.inv.base (hAff_Vσ.isoSpec.hom.base ⟨z_σ, hz_Vσ⟩) = ⟨z_σ, hz_Vσ⟩ :=
        h_inv
      rw [h_inv']
      rfl
    have hqz_R_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Cσ)).base q_z_pt = m_R_pt := by
      rw [hf_V_eq]
      change π_σ.base (hAff_Vσ.fromSpec.base q_z_pt) = m_R_pt
      rw [hfromSpec_qz, hz_π]
    have hqz_A_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A_Cσ)).base q_z_pt = q_def := by
      rw [hg_V_eq]
      change ρ_σ.base (hAff_Vσ.fromSpec.base q_z_pt) = q_def
      rw [hfromSpec_qz, hz_ρ]
    have hqz_comap_R : Ideal.comap φ_R_Cσ q_z_pt.asIdeal = IsLocalRing.maximalIdeal R :=
      congrArg PrimeSpectrum.asIdeal hqz_R_pt
    have hqz_comap_A : Ideal.comap φ_A_Cσ q_z_pt.asIdeal = q_def.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hqz_A_pt
    let _ : Algebra R C_σ := φ_R_Cσ.toAlgebra
    have _ : Algebra.Etale R C_σ := hEt_φR
    have _ : q_z_pt.asIdeal.IsPrime := q_z_pt.isPrime
    obtain ⟨h_σ, hh_σ_not_mem, hBij_σ⟩ :=
      weil_henselian_algClosed_etale_away_bijective R hAlgRes C_σ q_z_pt.asIdeal hqz_comap_R
    let e_loc : R ≃+* Localization.Away h_σ :=
      RingEquiv.ofBijective (algebraMap R (Localization.Away h_σ)) hBij_σ
    let τ_Cσ : C_σ →+* R :=
      e_loc.symm.toRingHom.comp (algebraMap C_σ (Localization.Away h_σ))
    have hτ_φR : τ_Cσ.comp φ_R_Cσ = RingHom.id R := by
      ext r
      change e_loc.symm (algebraMap C_σ (Localization.Away h_σ) (φ_R_Cσ r)) = r
      have halg : algebraMap C_σ (Localization.Away h_σ) (φ_R_Cσ r) = e_loc r := by
        change algebraMap C_σ (Localization.Away h_σ) (algebraMap R C_σ r) =
          algebraMap R (Localization.Away h_σ) r
        exact (IsScalarTower.algebraMap_apply R C_σ (Localization.Away h_σ) r).symm
      rw [halg, e_loc.symm_apply_apply]
    let α_hat : A_def →+* R := τ_Cσ.comp φ_A_Cσ
    have hσ_hat_eC : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_hat) ≫ e_C = σ := by
      have hsplit : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_hat) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_Cσ) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_A_Cσ) := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hsplit, hg_V_eq]
      dsimp only [g_V]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc hAff_Vσ.fromSpec]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_Cσ) ≫ f_V ≫ σ = σ
      rw [← hf_V_eq, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hτ_φR]
      have hid : CommRingCat.ofHom (RingHom.id R) = 𝟙 (CommRingCat.of R) := rfl
      rw [hid, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
    have hα_alg : α_hat.comp (algebraMap R A_def) = RingHom.id R := by
      have hcomp_id : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α_hat.comp (algebraMap R A_def))) =
          AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of R)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, ← heC_gR,
          ← CategoryTheory.Category.assoc, hσ_hat_eC, hσ_sec, AlgebraicGeometry.Spec.map_id]
      have hpre := congrArg AlgebraicGeometry.Spec.preimage hcomp_id
      rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at hpre
      exact congrArg CommRingCat.Hom.hom hpre
    have hτ_comap : Ideal.comap τ_Cσ (IsLocalRing.maximalIdeal R) = q_z_pt.asIdeal := by
      let D_z := C_σ ⧸ q_z_pt.asIdeal
      let F_z := FractionRing D_z
      let π_z : C_σ →+* F_z := (algebraMap D_z F_z).comp (Ideal.Quotient.mk q_z_pt.asIdeal)
      have hker_πz : ∀ c : C_σ, π_z c = 0 ↔ c ∈ q_z_pt.asIdeal := by
        intro c
        simp only [π_z, RingHom.comp_apply]
        rw [← map_zero (algebraMap D_z F_z), (IsFractionRing.injective D_z F_z).eq_iff,
          Ideal.Quotient.eq_zero_iff_mem]
      have hh_unit : IsUnit (π_z h_σ) :=
        IsUnit.mk0 (π_z h_σ) (fun h0 => hh_σ_not_mem ((hker_πz h_σ).mp h0))
      let ψ_z : Localization.Away h_σ →+* F_z := IsLocalization.Away.lift h_σ hh_unit
      have hψ_z_eq : ∀ c : C_σ, ψ_z (algebraMap C_σ (Localization.Away h_σ) c) = π_z c :=
        fun c => IsLocalization.Away.lift_eq h_σ hh_unit c
      have hψ_eloc : ∀ r : R, ψ_z (e_loc r) = 0 ↔ r ∈ IsLocalRing.maximalIdeal R := by
        intro r
        have halg : e_loc r = algebraMap C_σ (Localization.Away h_σ) (φ_R_Cσ r) := by
          change algebraMap R (Localization.Away h_σ) r =
            algebraMap C_σ (Localization.Away h_σ) (algebraMap R C_σ r)
          exact IsScalarTower.algebraMap_apply R C_σ (Localization.Away h_σ) r
        rw [halg, hψ_z_eq, hker_πz, ← hqz_comap_R]
        rfl
      ext c
      simp only [Ideal.mem_comap]
      change e_loc.symm (algebraMap C_σ (Localization.Away h_σ) c) ∈ IsLocalRing.maximalIdeal R ↔
        c ∈ q_z_pt.asIdeal
      rw [← hψ_eloc, e_loc.apply_symm_apply, hψ_z_eq, hker_πz]
    have hα_comap : Ideal.comap α_hat (IsLocalRing.maximalIdeal R) = q_def.asIdeal := by
      dsimp only [α_hat]
      rw [← Ideal.comap_comap, hτ_comap, hqz_comap_A]
    exact ⟨α_hat, hσ_hat_eC, hα_alg, hα_comap⟩
  obtain ⟨α₁, hα₁_eC, hα₁_alg, hα₁_comap⟩ := hLiftSec σ₁ hσ₁ hClose_m.1
  obtain ⟨α₂, hα₂_eC, hα₂_alg, hα₂_comap⟩ := hLiftSec σ₂ hσ₂ hClose_m.2

  
  let η_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RK)
  let X_KR := CategoryTheory.Limits.pullback g_R η_R
  let _ : Algebra R K_R := φ_RK.toAlgebra
  let B_K : Type u := TensorProduct R K_R A_def
  let inl_BK : K_R →+* B_K := Algebra.TensorProduct.includeLeftRingHom
  let inr_BK : A_def →+* B_K := (Algebra.TensorProduct.includeRight : A_def →ₐ[R] B_K).toRingHom
  have hBK_comm : inl_BK.comp φ_RK = inr_BK.comp (algebraMap R A_def) := by
    have hpush := (CommRingCat.isPushout_tensorProduct R K_R A_def).w
    exact congrArg CommRingCat.Hom.hom hpush
  let e_K : AlgebraicGeometry.Spec (CommRingCat.of B_K) ⟶ X_KR :=
    CategoryTheory.Limits.pullback.lift
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr_BK) ≫ e_C)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inl_BK))
      (by
        rw [CategoryTheory.Category.assoc, heC_gR, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← hBK_comm, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp])
  have hPb_outer : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr_BK))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inl_BK))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A_def)))
      η_R :=
    CategoryTheory.Functor.map_isPullback AlgebraicGeometry.Scheme.Spec
      (CommRingCat.isPushout_tensorProduct R K_R A_def).op
  have hPb_eK : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr_BK))
      e_K
      e_C
      (CategoryTheory.Limits.pullback.fst g_R η_R) := by
    refine CategoryTheory.IsPullback.of_bot ?_
      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      (CategoryTheory.IsPullback.of_hasPullback g_R η_R)
    rw [CategoryTheory.Limits.pullback.lift_snd, heC_gR]
    exact hPb_outer
  have hEt_eK : AlgebraicGeometry.Etale e_K :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_eK hEt_eC
  have hSecData : ∀ (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R)
      (hσ_sec : σ ≫ g_R = 𝟙 _)
      (α_hat : A_def →+* R)
      (hα_eC : AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_hat) ≫ e_C = σ)
      (hα_alg : α_hat.comp (algebraMap R A_def) = RingHom.id R)
      (hα_comap : Ideal.comap α_hat (IsLocalRing.maximalIdeal R) = q_def.asIdeal)
      (p : ↥X_KR)
      (hp_sec : ∃ pt : AlgebraicGeometry.Spec (CommRingCat.of K_R),
        (CategoryTheory.Limits.pullback.fst g_R η_R).base p = (η_R ≫ σ).base pt)
      (hp_mult : ∃ E₁ ∈ irreducibleComponents ↥X_KR,
        ∃ E₂ ∈ irreducibleComponents ↥X_KR, E₁ ≠ E₂ ∧ p ∈ E₁ ∧ p ∈ E₂),
      let ω_alg : A_def →ₐ[R] K_R :=
        { toRingHom := φ_RK.comp α_hat
          commutes' := fun r => by
            change φ_RK ((α_hat.comp (algebraMap R A_def)) r) = φ_RK r
            rw [hα_alg]
            rfl }
      let ψ_K : B_K →+* K_R :=
        (Algebra.TensorProduct.productMap (AlgHom.id R K_R) ω_alg).toRingHom
      (∃ pt : AlgebraicGeometry.Spec (CommRingCat.of K_R),
        p = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K) ≫ e_K).base pt) ∧
      (φ_RK.comp α_hat) (π_def M₀) = 0 ∧
      (φ_RK.comp α_hat) (π_def M₁) = 0 ∧
      (φ_RK.comp α_hat) (π_def H_inv) ≠ 0 := by
    intro σ hσ_sec α_hat hα_eC hα_alg hα_comap p hp_sec hp_mult
    let ω_alg : A_def →ₐ[R] K_R :=
      { toRingHom := φ_RK.comp α_hat
        commutes' := fun r => by
          change φ_RK ((α_hat.comp (algebraMap R A_def)) r) = φ_RK r
          rw [hα_alg]
          rfl }
    let ψ_K : B_K →+* K_R :=
      (Algebra.TensorProduct.productMap (AlgHom.id R K_R) ω_alg).toRingHom
    let s_K : AlgebraicGeometry.Spec (CommRingCat.of K_R) ⟶ X_KR :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K) ≫ e_K
    have hψ_inr : ψ_K.comp inr_BK = φ_RK.comp α_hat := by
      ext a
      exact Algebra.TensorProduct.productMap_apply_tmul (AlgHom.id R K_R) ω_alg 1 a
        |>.trans (one_mul _)
    have hs_K_fst : s_K ≫ CategoryTheory.Limits.pullback.fst g_R η_R = η_R ≫ σ := by
      dsimp only [s_K, e_K]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hψ_inr, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hα_eC]
    obtain ⟨pt, hpt⟩ := hp_sec
    have hp_eq : p = s_K.base pt :=
      weil_section_pullback_point_eq_and_etale_domain_stalk_unique_comp.1
        R K_R φ_RK C_R g_R σ hσ_sec p pt s_K hpt hs_K_fst
    let P_K : Ideal B_K := RingHom.ker ψ_K
    have _ : P_K.IsPrime := RingHom.ker_isPrime ψ_K
    have hpt_bot : pt.asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top pt.asIdeal).resolve_right pt.isPrime.ne_top
    have hSpec_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K)).base pt =
        ⟨P_K, inferInstance⟩ := by
      apply PrimeSpectrum.ext
      ext b
      change b ∈ Ideal.comap ψ_K pt.asIdeal ↔ b ∈ RingHom.ker ψ_K
      rw [hpt_bot]
      rfl
    have hp_eK : p = e_K.base ⟨P_K, inferInstance⟩ := by
      rw [hp_eq]
      change e_K.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K)).base pt) = _
      rw [hSpec_pt]
    have hψ_inl : ∀ c : K_R, ψ_K (c ⊗ₜ[R] 1) = c := by
      intro c
      change Algebra.TensorProduct.productMap (AlgHom.id R K_R) ω_alg (c ⊗ₜ[R] 1) = c
      simp
    have hM_zero : (φ_RK.comp α_hat) (π_def M₀) = 0 ∧ (φ_RK.comp α_hat) (π_def M₁) = 0 := by
      by_contra hnot
      have hor : ψ_K (1 ⊗ₜ[R] π_def M₀) ≠ 0 ∨ ψ_K (1 ⊗ₜ[R] π_def M₁) ≠ 0 := by
        have h0 : ψ_K (1 ⊗ₜ[R] π_def M₀) = (φ_RK.comp α_hat) (π_def M₀) := by
          change Algebra.TensorProduct.productMap (AlgHom.id R K_R) ω_alg (1 ⊗ₜ[R] π_def M₀) = _
          simp [ω_alg]
        have h1 : ψ_K (1 ⊗ₜ[R] π_def M₁) = (φ_RK.comp α_hat) (π_def M₁) := by
          change Algebra.TensorProduct.productMap (AlgHom.id R K_R) ω_alg (1 ⊗ₜ[R] π_def M₁) = _
          simp [ω_alg]
        rw [h0, h1]
        by_cases hm0 : (φ_RK.comp α_hat) (π_def M₀) = 0
        · exact Or.inr (fun hm1 => hnot ⟨hm0, hm1⟩)
        · exact Or.inl hm0
      have hDom : IsDomain (Localization.AtPrime P_K) :=
        hDom_KR K_R φ_RK ψ_K P_K rfl hψ_inl hor
      obtain ⟨E₁, hE₁, E₂, hE₂, hE_ne, hp_E₁, hp_E₂⟩ := hp_mult
      rw [hp_eK] at hp_E₁ hp_E₂
      exact hE_ne (weil_section_pullback_point_eq_and_etale_domain_stalk_unique_comp.2
        X_KR B_K e_K hEt_eK P_K hDom E₁ E₂ hE₁ hE₂ hp_E₁ hp_E₂)
    have hHinv_ne : (φ_RK.comp α_hat) (π_def H_inv) ≠ 0 := by
      have hnot_qdef : π_def H_inv ∉ q_def.asIdeal := by
        intro hmem
        have : H_inv ∈ Ideal.comap π_def q_def.asIdeal := hmem
        rw [hq_def_comap] at this
        exact hH_inv_not_mem this
      have hnot_max : α_hat (π_def H_inv) ∉ IsLocalRing.maximalIdeal R := by
        intro hmem
        have : π_def H_inv ∈ Ideal.comap α_hat (IsLocalRing.maximalIdeal R) := hmem
        rw [hα_comap] at this
        exact hnot_qdef this
      have hunit_R : IsUnit (α_hat (π_def H_inv)) :=
        IsLocalRing.notMem_maximalIdeal.mp hnot_max
      exact (hunit_R.map φ_RK).ne_zero
    exact ⟨⟨pt, hp_eq⟩, hM_zero.1, hM_zero.2, hHinv_ne⟩

  obtain ⟨⟨pt₁, hp₁_eq⟩, hM0_1, hM1_1, hHinv_1⟩ :=
    hSecData σ₁ hσ₁ α₁ hα₁_eC hα₁_alg hα₁_comap p₁ hp₁_sec hp₁_mult
  obtain ⟨⟨pt₂, hp₂_eq⟩, hM0_2, hM1_2, hHinv_2⟩ :=
    hSecData σ₂ hσ₂ α₂ hα₂_eC hα₂_alg hα₂_comap p₂ hp₂_sec hp₂_mult

  
  let ω₁ : A_def →+* K_R := φ_RK.comp α₁
  let ω₂ : A_def →+* K_R := φ_RK.comp α₂
  have hIcrit_ker : ∀ (ω : A_def →+* K_R),
      ω (π_def M₀) = 0 → ω (π_def M₁) = 0 → I_crit ≤ RingHom.ker (ω.comp π_def) := by
    intro ω hm0 hm1
    rw [Ideal.span_le]
    intro x hx
    simp only [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply]
    rcases Set.mem_insert_iff.mp hx with rfl | hx'
    · exact hm1
    · rcases Set.mem_insert_iff.mp hx' with rfl | ⟨a, rfl⟩
      · exact hm0
      · have hRa_def : R_rel a ∈ I_def :=
          Ideal.subset_span (Set.mem_insert_of_mem F ⟨a, rfl⟩)
        have hπ_zero : π_def (R_rel a) = 0 := by
          simp only [π_def, RingHom.comp_apply]
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr hRa_def, map_zero]
        rw [hπ_zero, map_zero]
  have hω_eval : ∀ (ω : A_def →+* K_R),
      ω.comp (algebraMap R A_def) = φ_RK →
      ω (π_def M₀) = 0 →
      ω (π_def M₁) = 0 →
      ω (π_def H_inv) ≠ 0 →
      ∀ (P : P_poly) (r : R) (N_P : ℕ),
        H_inv ^ N_P * (P - MvPolynomial.C r) ∈ I_crit →
        ω (π_def P) = φ_RK r := by
    intro ω hω_alg hm0 hm1 hHne P r N_P hmem
    have hzero : (ω.comp π_def) (H_inv ^ N_P * (P - MvPolynomial.C r)) = 0 :=
      hIcrit_ker ω hm0 hm1 hmem
    simp only [RingHom.comp_apply, map_mul, map_pow, map_sub] at hzero
    have hC : ω (π_def (MvPolynomial.C r)) = φ_RK r := by
      have halg : π_def (MvPolynomial.C r) = algebraMap R A_def r := by
        simp only [π_def, RingHom.comp_apply]
        rw [IsScalarTower.algebraMap_apply R (P_poly ⧸ I_def) A_def]
        rfl
      rw [halg]
      exact DFunLike.congr_fun hω_alg r
    rw [hC] at hzero
    rcases mul_eq_zero.mp hzero with hpow | hsub
    · exact absurd (eq_zero_of_pow_eq_zero hpow) hHne
    · exact sub_eq_zero.mp hsub
  have hω₁_alg : ω₁.comp (algebraMap R A_def) = φ_RK := by
    dsimp only [ω₁]
    rw [RingHom.comp_assoc, hα₁_alg, RingHom.comp_id]
  have hω₂_alg : ω₂.comp (algebraMap R A_def) = φ_RK := by
    dsimp only [ω₂]
    rw [RingHom.comp_assoc, hα₂_alg, RingHom.comp_id]
  have hω_π : ω₁.comp π_def = ω₂.comp π_def := by
    refine RingHom.ext fun P => ?_
    obtain ⟨r, N_P, hmem⟩ := hClear P
    simp only [RingHom.comp_apply]
    rw [hω_eval ω₁ hω₁_alg hM0_1 hM1_1 hHinv_1 P r N_P hmem,
      hω_eval ω₂ hω₂_alg hM0_2 hM1_2 hHinv_2 P r N_P hmem]
  have hω_quot : ω₁.comp (algebraMap (P_poly ⧸ I_def) A_def) =
      ω₂.comp (algebraMap (P_poly ⧸ I_def) A_def) :=
    Ideal.Quotient.ringHom_ext hω_π
  have hω_eq : ω₁ = ω₂ :=
    IsLocalization.ringHom_ext (Submonoid.powers (Ideal.Quotient.mk I_def H_Δ)) hω_quot
  let ω_alg₁ : A_def →ₐ[R] K_R :=
    { toRingHom := ω₁
      commutes' := fun r => DFunLike.congr_fun hω₁_alg r }
  let ω_alg₂ : A_def →ₐ[R] K_R :=
    { toRingHom := ω₂
      commutes' := fun r => DFunLike.congr_fun hω₂_alg r }
  have hω_alg_eq : ω_alg₁ = ω_alg₂ :=
    AlgHom.ext fun a => DFunLike.congr_fun hω_eq a
  let ψ_K₁ : B_K →+* K_R :=
    (Algebra.TensorProduct.productMap (AlgHom.id R K_R) ω_alg₁).toRingHom
  let ψ_K₂ : B_K →+* K_R :=
    (Algebra.TensorProduct.productMap (AlgHom.id R K_R) ω_alg₂).toRingHom
  have hψ_eq : ψ_K₁ = ψ_K₂ := by
    dsimp only [ψ_K₁, ψ_K₂]
    rw [hω_alg_eq]
  have hpt_eq : pt₁ = pt₂ := by
    apply PrimeSpectrum.ext
    rw [(Ideal.eq_bot_or_top pt₁.asIdeal).resolve_right pt₁.isPrime.ne_top,
      (Ideal.eq_bot_or_top pt₂.asIdeal).resolve_right pt₂.isPrime.ne_top]
  calc
    p₁ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K₁) ≫ e_K).base pt₁ := hp₁_eq
    _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K₂) ≫ e_K).base pt₂ := by
      rw [hψ_eq, hpt_eq]
    _ = p₂ := hp₂_eq.symm

theorem weil_intermediate_prime_quotient_valuation_hensel_pkg (K : Type u) [Field K]
    (m : ℕ)
    (V : ValuationSubring K)
    (hMaxNeBot : IsLocalRing.maximalIdeal ↥V ≠ ⊥)
    (hPkg : IsValuationRingAlgPackage m V)
    (P : Ideal ↥V) [P.IsPrime]
    (hP_ne_bot : P ≠ ⊥)
    (hP_ne_max : P ≠ IsLocalRing.maximalIdeal ↥V) :
    let R : Type u := ↥V ⧸ P
    let k_P : Type u := P.ResidueField
    let k₀ : Type u := (IsLocalRing.maximalIdeal ↥V).ResidueField
    IsAlgClosed k_P ∧
    IsAlgClosed k₀ ∧
    ValuationRing R ∧
    IsIntegrallyClosed R ∧
    HenselianLocalRing R ∧
    (∃ m₀ : R, m₀ ≠ 0 ∧ ¬ IsUnit m₀) ∧
    (∃ π₀ : R, π₀ ≠ 0 ∧
      (∀ q : PrimeSpectrum R, q.asIdeal ≠ ⊥ ↔ π₀ ∈ q.asIdeal) ∧
      IsLocalization.Away π₀ k_P) ∧
    (∀ x : k_P,
      (∃ r : R, algebraMap R k_P r = x) ∨
      (x ≠ 0 ∧ ∃ r : R, algebraMap R k_P r = x⁻¹)) ∧
    ∃ ρ₀ : R →+* k₀,
      Function.Surjective ρ₀ ∧
      ρ₀.comp (Ideal.Quotient.mk P) = algebraMap ↥V k₀ ∧
      (∀ r : R, ρ₀ r = 0 ↔ ¬ IsUnit r) ∧
      ∀ (A : Type u) [CommRing A] [Algebra ↥V A] (I : Ideal A),
        Module.Free ↥V (A ⧸ I) →
        Module.Finite ↥V (A ⧸ I) →
        Nontrivial (A ⧸ I) →
        let I_P : Ideal A := Ideal.map (algebraMap ↥V A) P
        let B₀ : Type u := A ⧸ I_P
        let I_B : Ideal B₀ := Ideal.map (Ideal.Quotient.mk I_P) I
        ∀ (φ_R : R →+* B₀),
          φ_R.comp (Ideal.Quotient.mk P) = (Ideal.Quotient.mk I_P).comp (algebraMap ↥V A) →
          (∃ q_max : PrimeSpectrum B₀,
            I_B ≤ q_max.asIdeal ∧ Ideal.comap φ_R q_max.asIdeal = RingHom.ker ρ₀) ∧
          (∃ p_gen : PrimeSpectrum B₀,
            I_B ≤ p_gen.asIdeal ∧ Ideal.comap φ_R p_gen.asIdeal = ⊥) ∧
          (∀ q₀ : PrimeSpectrum B₀,
            I_B ≤ q₀.asIdeal →
            Ideal.comap φ_R q₀.asIdeal = RingHom.ker ρ₀ →
            ∃ p_P : PrimeSpectrum B₀,
              p_P ≤ q₀ ∧ I_B ≤ p_P.asIdeal ∧ Ideal.comap φ_R p_P.asIdeal = ⊥) ∧
          (∀ p₀ : PrimeSpectrum B₀,
            I_B ≤ p₀.asIdeal →
            Ideal.comap φ_R p₀.asIdeal = ⊥ →
            ∃ q_0 : PrimeSpectrum B₀,
              p₀ ≤ q_0 ∧ I_B ≤ q_0.asIdeal ∧ Ideal.comap φ_R q_0.asIdeal = RingHom.ker ρ₀) :=
by
  classical
  intro R k_P k₀
  obtain ⟨hFinSpecV, _hCardV, hHensV, _hDivV, hAlgRes, _hSatFG⟩ := hPkg
  have : HenselianLocalRing ↥V := hHensV
  let 𝔪_V : Ideal ↥V := IsLocalRing.maximalIdeal ↥V
  have hMax_mV : 𝔪_V.IsMaximal := IsLocalRing.maximalIdeal.isMaximal ↥V
  have : 𝔪_V.IsPrime := hMax_mV.isPrime
  
  have hAlg_kP : IsAlgClosed k_P := hAlgRes P hP_ne_bot
  have hAlg_k₀ : IsAlgClosed k₀ := hAlgRes 𝔪_V hMaxNeBot
  
  let π_P : ↥V →+* R := Ideal.Quotient.mk P
  have hSurjP : Function.Surjective π_P := Ideal.Quotient.mk_surjective
  have hValR : ValuationRing R := by
    rw [ValuationRing.iff_dvd_total]
    refine ⟨fun r₁ r₂ => ?_⟩
    obtain ⟨v₁, rfl⟩ := hSurjP r₁
    obtain ⟨v₂, rfl⟩ := hSurjP r₂
    rcases ValuationRing.dvd_total v₁ v₂ with h | h
    · exact Or.inl (π_P.map_dvd h)
    · exact Or.inr (π_P.map_dvd h)
  have : ValuationRing R := hValR
  have hICR : IsIntegrallyClosed R := by
    let : GCDMonoid R := IsBezout.toGCDDomain R
    exact GCDMonoid.toIsIntegrallyClosed
  
  have hP_le_max : P ≤ 𝔪_V := IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top ‹_›)
  have hUnit_iff : ∀ v : ↥V, IsUnit (π_P v) ↔ IsUnit v := by
    intro v
    refine ⟨fun hu => ?_, fun hv => hv.map π_P⟩
    rcases hu with ⟨u, hu_eq⟩
    obtain ⟨w, hw_eq⟩ := hSurjP ↑(u⁻¹)
    have hdiff_zero : π_P (v * w - 1) = 0 := by
      rw [map_sub, map_mul, map_one, ← hu_eq, hw_eq, Units.mul_inv, sub_self]
    have hdiff_P : v * w - 1 ∈ P := (Ideal.Quotient.eq_zero_iff_mem).mp hdiff_zero
    have hdiff_m : v * w - 1 ∈ 𝔪_V := hP_le_max hdiff_P
    have hvw_not_m : v * w ∉ 𝔪_V := by
      intro hvw_m
      have h1_m : (1 : ↥V) ∈ 𝔪_V := by
        have hsub : v * w - (v * w - 1) ∈ 𝔪_V := 𝔪_V.sub_mem hvw_m hdiff_m
        simpa using hsub
      exact hMax_mV.ne_top ((Ideal.eq_top_iff_one 𝔪_V).mpr h1_m)
    have hvw_unit : IsUnit (v * w) := IsLocalRing.notMem_maximalIdeal.mp hvw_not_m
    exact isUnit_of_mul_isUnit_left hvw_unit
  have hMemMax_iff : ∀ v : ↥V, π_P v ∈ IsLocalRing.maximalIdeal R ↔ v ∈ 𝔪_V := by
    intro v
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal]
    exact hUnit_iff v
  have hNotLe : ¬ (𝔪_V ≤ P) := fun hle => hP_ne_max (le_antisymm hP_le_max hle)
  obtain ⟨v₀, hv₀_m, hv₀_notP⟩ := SetLike.not_le_iff_exists.mp hNotLe
  let m₀ : R := π_P v₀
  have hm₀_ne : m₀ ≠ 0 := by
    intro h0
    exact hv₀_notP ((Ideal.Quotient.eq_zero_iff_mem).mp h0)
  have hm₀_nonunit : ¬ IsUnit m₀ := by
    rw [hUnit_iff]
    exact fun hu => (IsLocalRing.notMem_maximalIdeal.mpr hu) hv₀_m
  have hHensR : HenselianLocalRing R := by
    refine HenselianLocalRing.mk (fun f hf a₀ ha₀ hderiv => ?_)
    obtain ⟨w₀, rfl⟩ := hSurjP a₀
    have hf_lifts : f ∈ Polynomial.lifts π_P := by
      rw [Polynomial.mem_lifts]
      exact Polynomial.map_surjective π_P hSurjP f
    obtain ⟨F, hF_map, _hF_deg, hF_monic⟩ :=
      Polynomial.lifts_and_natDegree_eq_and_monic hf_lifts hf
    have hF_eval_eq : π_P (Polynomial.eval w₀ F) = Polynomial.eval (π_P w₀) f := by
      rw [← hF_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have hF_eval_m : Polynomial.eval w₀ F ∈ 𝔪_V := by
      rw [← hMemMax_iff, hF_eval_eq]
      exact ha₀
    have hF_deriv_eq :
        π_P (Polynomial.eval w₀ (Polynomial.derivative F)) =
          Polynomial.eval (π_P w₀) (Polynomial.derivative f) := by
      rw [← hF_map, Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have hF_deriv_unit : IsUnit (Polynomial.eval w₀ (Polynomial.derivative F)) := by
      rw [← hUnit_iff, hF_deriv_eq]
      exact hderiv
    obtain ⟨w, hw_root, hw_diff⟩ :=
      HenselianLocalRing.is_henselian F hF_monic w₀ hF_eval_m hF_deriv_unit
    refine ⟨π_P w, ?_, ?_⟩
    · change Polynomial.eval (π_P w) f = 0
      rw [← hF_map, Polynomial.eval_map, Polynomial.eval₂_at_apply, hw_root.eq_zero, map_zero]
    · rw [← map_sub, hMemMax_iff]
      exact hw_diff
  
  let α₀ : ↥V →+* k₀ := algebraMap ↥V k₀
  have hα₀_zero_iff : ∀ v : ↥V, α₀ v = 0 ↔ v ∈ 𝔪_V := by
    intro v
    have hfac : α₀ v = algebraMap (↥V ⧸ 𝔪_V) k₀ (Ideal.Quotient.mk 𝔪_V v) :=
      Ideal.algebraMap_quotient_residueField_mk 𝔪_V v
    rw [hfac]
    have hinj : Function.Injective (algebraMap (↥V ⧸ 𝔪_V) k₀) :=
      IsFractionRing.injective (↥V ⧸ 𝔪_V) k₀
    constructor
    · intro h0
      have hmk0 : Ideal.Quotient.mk 𝔪_V v = 0 :=
        hinj (h0.trans (map_zero (algebraMap (↥V ⧸ 𝔪_V) k₀)).symm)
      exact (Ideal.Quotient.eq_zero_iff_mem).mp hmk0
    · intro hv
      rw [(Ideal.Quotient.eq_zero_iff_mem).mpr hv, map_zero]
  let ρ₀ : R →+* k₀ :=
    Ideal.Quotient.lift P α₀ (fun v hv => (hα₀_zero_iff v).mpr (hP_le_max hv))
  have hρ₀_comp : ρ₀.comp π_P = α₀ := RingHom.ext (fun _ => rfl)
  have hSurj₀ : Function.Surjective ρ₀ := by
    intro x
    obtain ⟨v, rfl⟩ := Ideal.algebraMap_residueField_surjective 𝔪_V x
    exact ⟨π_P v, rfl⟩
  have hρ₀_ker : ∀ r : R, ρ₀ r = 0 ↔ ¬ IsUnit r := by
    intro r
    obtain ⟨v, rfl⟩ := hSurjP r
    change α₀ v = 0 ↔ ¬ IsUnit (π_P v)
    rw [hα₀_zero_iff, hUnit_iff, ← IsLocalRing.notMem_maximalIdeal, Classical.not_not]
  
  have : Finite (PrimeSpectrum ↥V) := Set.finite_univ_iff.mp hFinSpecV
  have : Finite (PrimeSpectrum R) :=
    Finite.of_injective (PrimeSpectrum.comap π_P)
      (PrimeSpectrum.comap_injective_of_surjective π_P hSurjP)
  let : Fintype (PrimeSpectrum R) := Fintype.ofFinite (PrimeSpectrum R)
  let S_nz : Finset (PrimeSpectrum R) :=
    Finset.univ.filter (fun q : PrimeSpectrum R => q.asIdeal ≠ ⊥)
  let r_fn : PrimeSpectrum R → R := fun q =>
    if h : q.asIdeal ≠ ⊥ then Classical.choose ((Submodule.ne_bot_iff q.asIdeal).mp h) else 1
  have hr_fn_spec : ∀ q : PrimeSpectrum R, q.asIdeal ≠ ⊥ → r_fn q ∈ q.asIdeal ∧ r_fn q ≠ 0 := by
    intro q hq
    dsimp only [r_fn]
    split_ifs
    exact Classical.choose_spec ((Submodule.ne_bot_iff q.asIdeal).mp hq)
  let π₀ : R := ∏ q ∈ S_nz, r_fn q
  have hπ₀_ne : π₀ ≠ 0 := by
    rw [Finset.prod_ne_zero_iff]
    intro q hq
    exact (hr_fn_spec q (Finset.mem_filter.mp hq).2).2
  have hπ₀_iff : ∀ q : PrimeSpectrum R, q.asIdeal ≠ ⊥ ↔ π₀ ∈ q.asIdeal := by
    intro q
    constructor
    · intro hq
      have hq_mem : q ∈ S_nz := Finset.mem_filter.mpr ⟨Finset.mem_univ q, hq⟩
      obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem r_fn hq_mem
      dsimp only [π₀]
      rw [hc]
      exact q.asIdeal.mul_mem_right c (hr_fn_spec q hq).1
    · intro hmem hbot
      rw [hbot, Ideal.mem_bot] at hmem
      exact hπ₀_ne hmem
  have hι_inj : Function.Injective (algebraMap R k_P) := IsFractionRing.injective R k_P
  have hLoc_π₀ : IsLocalization.Away π₀ k_P := by
    refine IsLocalization.Away.mk π₀ ?_ ?_ ?_
    · refine IsUnit.mk0 (algebraMap R k_P π₀) (fun h0 => hπ₀_ne ?_)
      exact hι_inj (h0.trans (map_zero (algebraMap R k_P)).symm)
    · intro z
      obtain ⟨⟨a, d⟩, hzd⟩ := IsLocalization.surj (nonZeroDivisors R) z
      have hd_ne : (d : R) ≠ 0 := nonZeroDivisors.ne_zero d.2
      have hπ₀_rad : π₀ ∈ (Ideal.span ({(d : R)} : Set R)).radical := by
        rw [Ideal.radical_eq_sInf, Ideal.mem_sInf]
        rintro J ⟨hdJ, hJ_prime⟩
        have hd_mem : (d : R) ∈ J := hdJ (Ideal.subset_span rfl)
        have hJ_ne_bot : J ≠ ⊥ := by
          intro hbot
          rw [hbot, Ideal.mem_bot] at hd_mem
          exact hd_ne hd_mem
        exact (hπ₀_iff ⟨J, hJ_prime⟩).mp hJ_ne_bot
      obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hπ₀_rad
      obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp hn
      refine ⟨n, a * u, ?_⟩
      calc
        z * (algebraMap R k_P π₀) ^ n
            = z * algebraMap R k_P (π₀ ^ n) := by rw [map_pow]
        _ = z * algebraMap R k_P ((d : R) * u) := by rw [hu]
        _ = (z * algebraMap R k_P (d : R)) * algebraMap R k_P u := by rw [map_mul, mul_assoc]
        _ = algebraMap R k_P a * algebraMap R k_P u := by rw [hzd]
        _ = algebraMap R k_P (a * u) := (map_mul _ a u).symm
    · intro a b hab
      exact ⟨0, by rw [hι_inj hab]⟩
  have hVal_kP : ∀ x : k_P,
      (∃ r : R, algebraMap R k_P r = x) ∨
      (x ≠ 0 ∧ ∃ r : R, algebraMap R k_P r = x⁻¹) := by
    intro x
    obtain ⟨⟨a, b⟩, hxb⟩ := IsLocalization.surj (nonZeroDivisors R) x
    have hb_ne : (b : R) ≠ 0 := nonZeroDivisors.ne_zero b.2
    have hιb_ne : algebraMap R k_P (b : R) ≠ 0 :=
      fun h0 => hb_ne (hι_inj (h0.trans (map_zero (algebraMap R k_P)).symm))
    rcases ValuationRing.dvd_total (b : R) a with ⟨r, hr⟩ | ⟨r, hr⟩
    · left
      refine ⟨r, ?_⟩
      apply mul_right_cancel₀ hιb_ne
      rw [hxb, hr, map_mul, mul_comm]
    · right
      have ha_ne : a ≠ 0 := by
        intro ha0
        rw [ha0, zero_mul] at hr
        exact hb_ne hr
      have hιa_ne : algebraMap R k_P a ≠ 0 :=
        fun h0 => ha_ne (hι_inj (h0.trans (map_zero (algebraMap R k_P)).symm))
      have hx_ne : x ≠ 0 := by
        intro hx0
        rw [hx0, zero_mul] at hxb
        exact hιa_ne hxb.symm
      have hmul1 : x * algebraMap R k_P r = 1 := by
        apply mul_left_cancel₀ hιa_ne
        calc
          algebraMap R k_P a * (x * algebraMap R k_P r)
              = x * (algebraMap R k_P a * algebraMap R k_P r) := by ring
          _ = x * algebraMap R k_P (a * r) := by rw [map_mul]
          _ = x * algebraMap R k_P (b : R) := by rw [← hr]
          _ = algebraMap R k_P a * 1 := by rw [hxb, mul_one]
      exact ⟨hx_ne, r, (inv_eq_of_mul_eq_one_right hmul1).symm⟩
  
  refine ⟨hAlg_kP, hAlg_k₀, hValR, hICR, hHensR, ⟨m₀, hm₀_ne, hm₀_nonunit⟩,
    ⟨π₀, hπ₀_ne, hπ₀_iff, hLoc_π₀⟩, hVal_kP,
    ⟨ρ₀, hSurj₀, hρ₀_comp, hρ₀_ker, ?_⟩⟩
  intro A _ _ I hFree hFin hNontriv I_P B₀ I_B φ_R hφ_R
  have : Module.Free ↥V (A ⧸ I) := hFree
  have : Module.Finite ↥V (A ⧸ I) := hFin
  have : Nontrivial (A ⧸ I) := hNontriv
  let : Algebra R B₀ := φ_R.toAlgebra
  let Q : Type u := B₀ ⧸ I_B
  let π_B : B₀ →+* Q := Ideal.Quotient.mk I_B
  let ψ_Q : R →+* Q := algebraMap R Q
  let q_Q : A →+* Q := π_B.comp (Ideal.Quotient.mk I_P)
  have hψ_def : ψ_Q = π_B.comp φ_R := rfl
  have hψ_alg : ∀ v : ↥V, ψ_Q (π_P v) = algebraMap ↥V Q v := by
    intro v
    exact congrArg π_B (RingHom.congr_fun hφ_R v)
  have hI_ker : ∀ a ∈ I, q_Q a = 0 := by
    intro a ha
    change π_B (Ideal.Quotient.mk I_P a) = 0
    exact (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.mem_map_of_mem _ ha)
  let f_AI : (A ⧸ I) →+* Q := Ideal.Quotient.lift I q_Q hI_ker
  have hf_AI_smul : ∀ (v : ↥V) (m : A ⧸ I), f_AI (v • m) = algebraMap ↥V Q v * f_AI m := by
    intro v m
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective m
    rw [Algebra.smul_def, map_mul]
    rfl
  let B_bilin : R →ₗ[↥V] (A ⧸ I) →ₗ[↥V] Q :=
    { toFun := fun r =>
        { toFun := fun m => ψ_Q r * f_AI m
          map_add' := fun m₁ m₂ => by rw [map_add, mul_add]
          map_smul' := fun v m => by
            rw [RingHom.id_apply, hf_AI_smul, Algebra.smul_def]
            ring }
      map_add' := fun r₁ r₂ => by
        ext m
        simp only [LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply, map_add, add_mul]
      map_smul' := fun v r => by
        ext m
        simp only [LinearMap.coe_mk, AddHom.coe_mk, RingHom.id_apply, LinearMap.smul_apply]
        have hvr : v • r = π_P v * r := Algebra.smul_def v r
        rw [hvr, map_mul, hψ_alg, Algebra.smul_def]
        ring }
  let T : Type u := TensorProduct ↥V R (A ⧸ I)
  let Φ₀ : T →ₗ[↥V] Q := TensorProduct.lift B_bilin
  have hsmulQ : ∀ (r : R) (y : Q), r • y = ψ_Q r * y := by
    intro r y
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    change π_B (r • b) = ψ_Q r * π_B b
    rw [Algebra.smul_def, map_mul]
    rfl
  let Φ : T →ₗ[R] Q :=
    { toFun := Φ₀
      map_add' := Φ₀.map_add
      map_smul' := fun r₀ z => by
        dsimp only [RingHom.id_apply]
        refine TensorProduct.inductionOn (motive := fun z => Φ₀ (r₀ • z) = r₀ • Φ₀ z) z
          (fun r m => ?_) (fun x y ihx ihy => ?_)
        · rw [TensorProduct.smul_tmul', smul_eq_mul, hsmulQ]
          dsimp only [Φ₀]
          rw [TensorProduct.lift.tmul, TensorProduct.lift.tmul]
          change ψ_Q (r₀ * r) * f_AI m = ψ_Q r₀ * (ψ_Q r * f_AI m)
          rw [map_mul, mul_assoc]
        · rw [smul_add, map_add, ihx, ihy, map_add, hsmulQ, hsmulQ, hsmulQ, mul_add] }
  
  let g_A : A →ₗ[↥V] T :=
    (TensorProduct.mk ↥V R (A ⧸ I) (1 : R)).comp (Submodule.mkQ (I.restrictScalars ↥V))
  have hg_A_apply : ∀ a : A, g_A a = (1 : R) ⊗ₜ[↥V] Ideal.Quotient.mk I a := fun _ => rfl
  have hker_IP : I_P.restrictScalars ↥V ≤ LinearMap.ker g_A := by
    intro x hx
    rw [LinearMap.mem_ker]
    have hmul_zero : ∀ b : A, g_A (b * x) = 0 := by
      change x ∈ Ideal.span (algebraMap ↥V A '' (P : Set ↥V)) at hx
      refine Submodule.span_induction (p := fun y _ => ∀ b : A, g_A (b * y) = 0)
        ?_ ?_ ?_ ?_ hx
      · rintro y ⟨p, hp, rfl⟩ b
        have hbp : b * algebraMap ↥V A p = p • b := by
          rw [Algebra.smul_def, mul_comm]
        rw [hbp, map_smul, hg_A_apply, TensorProduct.smul_tmul']
        have hp1 : p • (1 : R) = 0 := by
          rw [Algebra.smul_def, mul_one]
          exact (Ideal.Quotient.eq_zero_iff_mem).mpr hp
        rw [hp1, TensorProduct.zero_tmul]
      · intro b
        rw [mul_zero, map_zero]
      · intro y₁ y₂ _ _ ih₁ ih₂ b
        rw [mul_add, map_add, ih₁ b, ih₂ b, add_zero]
      · intro c y _ ih b
        change g_A (b * (c * y)) = 0
        rw [← mul_assoc]
        exact ih (b * c)
    simpa only [one_mul] using hmul_zero 1
  let g_B : B₀ →ₗ[↥V] T := Submodule.liftQ (I_P.restrictScalars ↥V) g_A hker_IP
  have hg_B_mk : ∀ a : A, g_B (Ideal.Quotient.mk I_P a) = (1 : R) ⊗ₜ[↥V] Ideal.Quotient.mk I a :=
    fun a => Submodule.liftQ_apply (I_P.restrictScalars ↥V) g_A a
  have hker_IB : I_B.restrictScalars ↥V ≤ LinearMap.ker g_B := by
    intro y hy
    rw [LinearMap.mem_ker]
    have hmul_zero : ∀ c : B₀, g_B (c * y) = 0 := by
      change y ∈ Ideal.span (Ideal.Quotient.mk I_P '' (I : Set A)) at hy
      refine Submodule.span_induction (p := fun z _ => ∀ c : B₀, g_B (c * z) = 0)
        ?_ ?_ ?_ ?_ hy
      · rintro z ⟨a, ha, rfl⟩ c
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
        rw [← map_mul, hg_B_mk]
        have hba : Ideal.Quotient.mk I (b * a) = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr (I.mul_mem_left b ha)
        rw [hba, TensorProduct.tmul_zero]
      · intro c
        rw [mul_zero, map_zero]
      · intro z₁ z₂ _ _ ih₁ ih₂ c
        rw [mul_add, map_add, ih₁ c, ih₂ c, add_zero]
      · intro d z _ ih c
        change g_B (c * (d * z)) = 0
        rw [← mul_assoc]
        exact ih (c * d)
    simpa only [one_mul] using hmul_zero 1
  let Ψ : Q →ₗ[↥V] T := Submodule.liftQ (I_B.restrictScalars ↥V) g_B hker_IB
  have hΨ_qQ : ∀ a : A, Ψ (q_Q a) = (1 : R) ⊗ₜ[↥V] Ideal.Quotient.mk I a :=
    fun a => Submodule.liftQ_apply (I_B.restrictScalars ↥V) g_B (Ideal.Quotient.mk I_P a)
  have hRightInv : Function.RightInverse Ψ Φ := by
    intro y
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
    change Φ (Ψ (q_Q a)) = q_Q a
    rw [hΨ_qQ]
    change ψ_Q 1 * f_AI (Ideal.Quotient.mk I a) = q_Q a
    rw [map_one, one_mul]
    rfl
  have hLeftInv : Function.LeftInverse Ψ Φ := by
    intro z
    refine TensorProduct.inductionOn (motive := fun z => Ψ (Φ z) = z) z
      (fun r m => ?_) (fun x y ihx ihy => ?_)
    · obtain ⟨v, rfl⟩ := hSurjP r
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective m
      change Ψ (ψ_Q (π_P v) * q_Q a) = π_P v ⊗ₜ[↥V] Ideal.Quotient.mk I a
      have hprod : ψ_Q (π_P v) * q_Q a = q_Q (v • a) := by
        rw [hψ_alg, Algebra.smul_def, map_mul]
        rfl
      rw [hprod, hΨ_qQ]
      have hmk_smul : Ideal.Quotient.mk I (v • a) = v • Ideal.Quotient.mk I a := by
        rw [Algebra.smul_def, map_mul, Algebra.smul_def]
        rfl
      rw [hmk_smul, TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
      rfl
    · rw [map_add, map_add, ihx, ihy]
  let e_Q : T ≃ₗ[R] Q :=
    LinearEquiv.ofBijective Φ ⟨hLeftInv.injective, hRightInv.surjective⟩
  
  have : Module.Free R Q := Module.Free.of_equiv e_Q
  have : Module.Finite R Q := Module.Finite.equiv e_Q
  have : Nontrivial Q := e_Q.symm.toEquiv.nontrivial
  have : Module.Flat R Q := Module.Flat.of_free
  have : Algebra.HasGoingDown R Q := Algebra.HasGoingDown.of_flat
  have : Module.FaithfullyFlat R Q := Module.FaithfullyFlat.instOfNontrivialOfFree R Q
  have : Algebra.IsIntegral R Q := Algebra.IsIntegral.of_finite R Q
  
  have hKerMax : (RingHom.ker ρ₀).IsMaximal := RingHom.ker_isMaximal_of_surjective ρ₀ hSurj₀
  have : (RingHom.ker ρ₀).IsPrime := hKerMax.isPrime
  have hKerNeBot : RingHom.ker ρ₀ ≠ ⊥ := by
    intro hbot
    have hm₀_mem : m₀ ∈ RingHom.ker ρ₀ := (RingHom.mem_ker).mpr ((hρ₀_ker m₀).mpr hm₀_nonunit)
    rw [hbot, Ideal.mem_bot] at hm₀_mem
    exact hm₀_ne hm₀_mem
  have hBotLtKer : (⊥ : Ideal R) < RingHom.ker ρ₀ := bot_lt_iff_ne_bot.mpr hKerNeBot
  
  have hSurj_πB : Function.Surjective π_B := Ideal.Quotient.mk_surjective
  have hKer_le : ∀ 𝔮 : Ideal B₀, I_B ≤ 𝔮 → RingHom.ker π_B ≤ 𝔮 := by
    intro 𝔮 h𝔮 x hx
    exact h𝔮 ((Ideal.Quotient.eq_zero_iff_mem).mp hx)
  have hPull_le : ∀ J : Ideal Q, I_B ≤ Ideal.comap π_B J := by
    intro J x hx
    rw [Ideal.mem_comap]
    have hx0 : π_B x = 0 := (Ideal.Quotient.eq_zero_iff_mem).mpr hx
    rw [hx0]
    exact J.zero_mem
  have hPull_comap : ∀ J : Ideal Q,
      Ideal.comap φ_R (Ideal.comap π_B J) = Ideal.under R J := by
    intro J
    rw [Ideal.comap_comap, ← hψ_def]
  have hPush_comap : ∀ 𝔮 : Ideal B₀, I_B ≤ 𝔮 → Ideal.comap π_B (Ideal.map π_B 𝔮) = 𝔮 := by
    intro 𝔮 h𝔮
    rw [Ideal.comap_map_of_surjective π_B hSurj_πB]
    refine sup_eq_left.mpr ?_
    intro x hx
    rw [Ideal.mem_comap, Ideal.mem_bot] at hx
    exact h𝔮 ((Ideal.Quotient.eq_zero_iff_mem).mp hx)
  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    obtain ⟨Q_max, hQ_prime, hQ_over⟩ :=
      Ideal.exists_isPrime_liesOver_of_faithfullyFlat (B := Q) (RingHom.ker ρ₀)
    refine ⟨⟨Ideal.comap π_B Q_max, hQ_prime.comap π_B⟩, hPull_le Q_max, ?_⟩
    rw [hPull_comap]
    exact hQ_over.over.symm
  · 
    obtain ⟨P_gen, hP_prime, hP_over⟩ :=
      Ideal.exists_isPrime_liesOver_of_faithfullyFlat (B := Q) (⊥ : Ideal R)
    refine ⟨⟨Ideal.comap π_B P_gen, hP_prime.comap π_B⟩, hPull_le P_gen, ?_⟩
    rw [hPull_comap]
    exact hP_over.over.symm
  · 
    intro q₀ hIB_q₀ hq₀_comap
    let q_bar : Ideal Q := Ideal.map π_B q₀.asIdeal
    have : q_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective hSurj_πB (hKer_le q₀.asIdeal hIB_q₀)
    have hq_bar_under : Ideal.under R q_bar = RingHom.ker ρ₀ := by
      rw [← hPull_comap q_bar, hPush_comap q₀.asIdeal hIB_q₀]
      exact hq₀_comap
    have hLt_under : (⊥ : Ideal R) < Ideal.under R q_bar := by
      rw [hq_bar_under]
      exact hBotLtKer
    obtain ⟨p_bar, hp_bar_le, hp_bar_prime, hp_bar_over⟩ :=
      Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt (p := (⊥ : Ideal R)) q_bar hLt_under
    refine ⟨⟨Ideal.comap π_B p_bar, hp_bar_prime.comap π_B⟩, ?_, hPull_le p_bar, ?_⟩
    · change Ideal.comap π_B p_bar ≤ q₀.asIdeal
      calc
        Ideal.comap π_B p_bar ≤ Ideal.comap π_B q_bar := Ideal.comap_mono hp_bar_le
        _ = q₀.asIdeal := hPush_comap q₀.asIdeal hIB_q₀
    · rw [hPull_comap]
      exact hp_bar_over.over.symm
  · 
    intro p₀ hIB_p₀ hp₀_comap
    let p_bar : Ideal Q := Ideal.map π_B p₀.asIdeal
    have : p_bar.IsPrime :=
      Ideal.map_isPrime_of_surjective hSurj_πB (hKer_le p₀.asIdeal hIB_p₀)
    have hp_bar_under : Ideal.under R p_bar ≤ RingHom.ker ρ₀ := by
      rw [← hPull_comap p_bar, hPush_comap p₀.asIdeal hIB_p₀, hp₀_comap]
      exact bot_le
    obtain ⟨q_bar, hq_bar_ge, hq_bar_prime, hq_bar_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (RingHom.ker ρ₀) p_bar hp_bar_under
    refine ⟨⟨Ideal.comap π_B q_bar, hq_bar_prime.comap π_B⟩, ?_, hPull_le q_bar, ?_⟩
    · change p₀.asIdeal ≤ Ideal.comap π_B q_bar
      calc
        p₀.asIdeal = Ideal.comap π_B p_bar := (hPush_comap p₀.asIdeal hIB_p₀).symm
        _ ≤ Ideal.comap π_B q_bar := Ideal.comap_mono hq_bar_ge
    · rw [hPull_comap]
      exact hq_bar_under

theorem weil_etale_stalk_isDomain_over_integrallyClosed (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
    [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
    (q : Ideal B) [q.IsPrime] :
    IsDomain (Localization.AtPrime q) :=
by
  classical
  let B_q : Type u := Localization.AtPrime q
  
  obtain ⟨f₁, hf₁_q, ⟨⟨P, x, hx_map, hlift_bij⟩⟩⟩ :=
    Algebra.IsEtaleAt.exists_isStandardEtale (R := A₀) q
  let S₁ : Type u := Localization.Away f₁
  let e_std : P.Ring ≃ₐ[A₀] S₁ := AlgEquiv.ofBijective (P.lift x hx_map) hlift_bij
  have hlift_X_x : (P.lift x hx_map) P.X = x := P.lift_X x hx_map
  have he_symm_x : e_std.symm x = P.X := by
    apply e_std.injective
    rw [e_std.apply_symm_apply]
    exact hlift_X_x.symm
  
  have hf₁_unit_Bq : IsUnit (algebraMap B B_q f₁) :=
    IsLocalization.map_units B_q (⟨f₁, hf₁_q⟩ : q.primeCompl)
  let ι₁ : S₁ →+* B_q := IsLocalization.Away.lift f₁ hf₁_unit_Bq
  have hι₁_B : ∀ b : B, ι₁ (algebraMap B S₁ b) = algebraMap B B_q b :=
    fun b => IsLocalization.Away.lift_eq f₁ hf₁_unit_Bq b
  have hι₁_A₀ : ∀ a : A₀, ι₁ (algebraMap A₀ S₁ a) = algebraMap A₀ B_q a := by
    intro a
    rw [IsScalarTower.algebraMap_apply A₀ B S₁, hι₁_B, ← IsScalarTower.algebraMap_apply A₀ B B_q]
  let θ : B_q := ι₁ x
  have hι₁_aeval : ∀ h : Polynomial A₀, ι₁ (Polynomial.aeval x h) = Polynomial.aeval θ h := by
    intro h
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂, Polynomial.aeval_def]
    congr 1
    ext a
    exact hι₁_A₀ a
  have hPf_θ : Polynomial.aeval θ P.f = 0 := by
    rw [← hι₁_aeval, hx_map.1, map_zero]
  have hPg_θ_unit : IsUnit (Polynomial.aeval θ P.g) := by
    rw [← hι₁_aeval]
    exact hx_map.2.map ι₁
  obtain ⟨p₁, p₂, n_c, hcond⟩ := P.cond
  have hPf'_θ_unit : IsUnit (Polynomial.aeval θ P.f.derivative) := by
    have h1 := congrArg (Polynomial.aeval θ) hcond
    simp only [map_add, map_mul, map_pow, hPf_θ, zero_mul, add_zero] at h1
    exact isUnit_of_mul_isUnit_left (h1.symm ▸ hPg_θ_unit.pow n_c)

  
  let I₀ : Ideal (Polynomial A₀) := Ideal.span ({P.f} : Set (Polynomial A₀))
  let C₀ : Type u := Polynomial A₀ ⧸ I₀
  let π₀ : Polynomial A₀ →+* C₀ := Ideal.Quotient.mk I₀
  let g₀ : C₀ := π₀ P.g
  let L₀ : Type u := Localization.Away g₀
  let y₀ : L₀ := algebraMap C₀ L₀ (π₀ Polynomial.X)
  have haeval_y₀ : ∀ h : Polynomial A₀, Polynomial.aeval y₀ h = algebraMap C₀ L₀ (π₀ h) := by
    intro h
    have hhom : (Polynomial.aeval y₀).toRingHom = (algebraMap C₀ L₀).comp π₀ := by
      apply Polynomial.ringHom_ext
      · intro a
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C, RingHom.comp_apply]
        rw [IsScalarTower.algebraMap_apply A₀ C₀ L₀]
        rfl
      · simp [y₀]
    exact RingHom.congr_fun hhom h
  have hy₀_map : P.HasMap y₀ := by
    refine ⟨?_, ?_⟩
    · rw [haeval_y₀]
      have hmem : P.f ∈ I₀ := Ideal.subset_span rfl
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
    · rw [haeval_y₀]
      exact IsLocalization.Away.algebraMap_isUnit g₀
  have hker_I₀ : ∀ h ∈ I₀, (Polynomial.aeval x).toRingHom h = 0 := by
    intro h hh
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hh
    simp [hx_map.1]
  let ψ_C : C₀ →+* S₁ := Ideal.Quotient.lift I₀ (Polynomial.aeval x).toRingHom hker_I₀
  have hψ_C_mk : ∀ h : Polynomial A₀, ψ_C (π₀ h) = Polynomial.aeval x h := fun _ => rfl
  have hψ_C_g₀_unit : IsUnit (ψ_C g₀) := by
    change IsUnit (Polynomial.aeval x P.g)
    exact hx_map.2
  let ψ_L : L₀ →+* S₁ := IsLocalization.Away.lift g₀ hψ_C_g₀_unit
  have hψ_L_eq : ∀ c : C₀, ψ_L (algebraMap C₀ L₀ c) = ψ_C c :=
    fun c => IsLocalization.Away.lift_eq g₀ hψ_C_g₀_unit c
  let ψ_Lₐ : L₀ →ₐ[A₀] S₁ :=
    { ψ_L with
      commutes' := fun a => by
        change ψ_L (algebraMap A₀ L₀ a) = algebraMap A₀ S₁ a
        rw [IsScalarTower.algebraMap_apply A₀ C₀ L₀, hψ_L_eq]
        exact (Polynomial.aeval_C x a) }
  have hψ_L_y₀ : ψ_L y₀ = x := by
    dsimp [y₀]
    rw [hψ_L_eq, hψ_C_mk, Polynomial.aeval_X]
  have hcomp_right : ψ_Lₐ.comp (P.lift y₀ hy₀_map) = P.lift x hx_map := by
    apply P.homEquiv.injective
    apply Subtype.ext
    change ψ_L ((P.lift y₀ hy₀_map) P.X) = (P.lift x hx_map) P.X
    rw [P.lift_X, P.lift_X, hψ_L_y₀]
  let φ_inv : S₁ →+* L₀ := ((P.lift y₀ hy₀_map).comp e_std.symm.toAlgHom).toRingHom
  have hφ_inv_ψ_L : φ_inv.comp ψ_L = RingHom.id L₀ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers g₀)
    apply RingHom.ext
    intro c
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective c
    change φ_inv (ψ_L (algebraMap C₀ L₀ (π₀ h))) = algebraMap C₀ L₀ (π₀ h)
    rw [hψ_L_eq, hψ_C_mk]
    have hhom : φ_inv.comp (Polynomial.aeval x).toRingHom = (algebraMap C₀ L₀).comp π₀ := by
      apply Polynomial.ringHom_ext
      · intro a
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_C, RingHom.comp_apply]
        change (P.lift y₀ hy₀_map) (e_std.symm (algebraMap A₀ S₁ a)) =
          algebraMap C₀ L₀ (π₀ (Polynomial.C a))
        rw [AlgEquiv.commutes, AlgHom.commutes, IsScalarTower.algebraMap_apply A₀ C₀ L₀]
        rfl
      · simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Polynomial.aeval_X, RingHom.comp_apply]
        change (P.lift y₀ hy₀_map) (e_std.symm x) = y₀
        rw [he_symm_x, P.lift_X]
    exact RingHom.congr_fun hhom h
  have hψ_L_φ_inv : ∀ u : S₁, ψ_L (φ_inv u) = u := by
    intro u
    change (ψ_Lₐ.comp (P.lift y₀ hy₀_map)) (e_std.symm u) = u
    rw [hcomp_right]
    exact e_std.apply_symm_apply u
  have hψ_L_inj : Function.Injective ψ_L :=
    Function.LeftInverse.injective (g := φ_inv) (fun z => by
      simpa using RingHom.congr_fun hφ_inv_ψ_L z)
  have hS₁_surj_poly : ∀ u : S₁, ∃ (h : Polynomial A₀) (m : ℕ),
      u * (Polynomial.aeval x P.g) ^ m = Polynomial.aeval x h := by
    intro u
    obtain ⟨⟨c, ⟨_, ⟨m, rfl⟩⟩⟩, hm_eq⟩ := IsLocalization.surj (Submonoid.powers g₀) (φ_inv u)
    dsimp only at hm_eq
    obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective c
    refine ⟨h, m, ?_⟩
    have h1 := congrArg ψ_L hm_eq
    rw [map_mul, hψ_L_φ_inv, hψ_L_eq, map_pow, hψ_C_mk, hψ_L_eq, hψ_C_mk] at h1
    exact h1
  have hBq_ker_poly : ∀ h : Polynomial A₀, Polynomial.aeval θ h = 0 →
      ∃ H : Polynomial A₀, IsUnit (Polynomial.aeval θ H) ∧ P.f ∣ H * h := by
    intro h hh_zero
    have hι₁_zero : ι₁ (Polynomial.aeval x h) = 0 := by
      rw [hι₁_aeval, hh_zero]
    obtain ⟨⟨b, ⟨_, ⟨k, rfl⟩⟩⟩, hk_eq⟩ :=
      IsLocalization.surj (Submonoid.powers f₁) (Polynomial.aeval x h)
    dsimp only at hk_eq
    have hb_Bq : algebraMap B B_q b = algebraMap B B_q 0 := by
      rw [map_zero, ← hι₁_B b, ← hk_eq, map_mul, hι₁_zero, zero_mul]
    obtain ⟨c, hc_eq⟩ := (IsLocalization.eq_iff_exists q.primeCompl B_q).mp hb_Bq
    rw [mul_zero] at hc_eq
    let w₁ : S₁ := algebraMap B S₁ (c.1 * f₁ ^ k)
    have hw₁_unit : IsUnit (ι₁ w₁) := by
      dsimp only [w₁]
      rw [hι₁_B, map_mul, map_pow]
      exact (IsLocalization.map_units B_q c).mul (hf₁_unit_Bq.pow k)
    have hw₁_ann : w₁ * Polynomial.aeval x h = 0 := by
      have hstep : w₁ * Polynomial.aeval x h =
          algebraMap B S₁ c.1 * (Polynomial.aeval x h * algebraMap B S₁ (f₁ ^ k)) := by
        dsimp only [w₁]
        rw [map_mul]
        ring
      rw [hstep, hk_eq, ← map_mul, hc_eq, map_zero]
    obtain ⟨h_w, m, hmw_eq⟩ := hS₁_surj_poly w₁
    have hhw_unit : IsUnit (Polynomial.aeval θ h_w) := by
      rw [← hι₁_aeval, ← hmw_eq, map_mul, map_pow, hι₁_aeval]
      exact hw₁_unit.mul (hPg_θ_unit.pow m)
    have hprod_S₁ : Polynomial.aeval x (h_w * h) = 0 := by
      rw [map_mul, ← hmw_eq, mul_right_comm, hw₁_ann, zero_mul]
    have hprod_L₀ : algebraMap C₀ L₀ (π₀ (h_w * h)) = algebraMap C₀ L₀ 0 := by
      apply hψ_L_inj
      rw [hψ_L_eq, hψ_C_mk, hprod_S₁, map_zero, map_zero]
    obtain ⟨⟨_, ⟨r, rfl⟩⟩, hr_eq⟩ :=
      (IsLocalization.eq_iff_exists (Submonoid.powers g₀) L₀).mp hprod_L₀
    dsimp only at hr_eq
    rw [mul_zero] at hr_eq
    have hmem_I₀ : P.g ^ r * (h_w * h) ∈ I₀ := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      change π₀ (P.g ^ r * (h_w * h)) = 0
      rw [map_mul, map_pow]
      exact hr_eq
    refine ⟨P.g ^ r * h_w, ?_, ?_⟩
    · rw [map_mul, map_pow]
      exact (hPg_θ_unit.pow r).mul hhw_unit
    · rw [mul_assoc]
      exact Ideal.mem_span_singleton.mp hmem_I₀

  
  let K₀ : Type u := FractionRing A₀
  let j₀ : A₀ →+* K₀ := algebraMap A₀ K₀
  have hj₀_inj : Function.Injective j₀ := IsFractionRing.injective A₀ K₀
  have hGaussLift : ∀ (M : Polynomial A₀) (G : Polynomial K₀),
      M.Monic → G.Monic → G ∣ Polynomial.map j₀ M →
      ∃ M₁ : Polynomial A₀,
        Polynomial.map j₀ M₁ = G ∧ M₁.natDegree = G.natDegree ∧ M₁.Monic := by
    intro M G hM hG hdvd
    have hlifts_ic : G ∈ Polynomial.lifts (algebraMap (↥(integralClosure A₀ K₀)) K₀) :=
      integralClosure.mem_lifts_of_monic_of_dvd_map K₀ hM hG hdvd
    rw [Polynomial.lifts_iff_coeff_lifts] at hlifts_ic
    have hlifts_A₀ : G ∈ Polynomial.lifts j₀ := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      obtain ⟨⟨c, hc_int⟩, hc_eq⟩ := hlifts_ic n
      obtain ⟨a, ha_eq⟩ := (IsIntegrallyClosed.isIntegral_iff (R := A₀) (K := K₀)).mp hc_int
      exact ⟨a, ha_eq.trans hc_eq⟩
    exact Polynomial.lifts_and_natDegree_eq_and_monic hlifts_A₀ hG

  have hIsolate : ∀ (d : ℕ) (M : Polynomial A₀),
      M.natDegree = d → M.Monic → ¬ IsUnit (Polynomial.aeval θ M) →
      ∃ P₁ Q₁ : Polynomial A₀,
        M = P₁ * Q₁ ∧ P₁.Monic ∧ Irreducible (Polynomial.map j₀ P₁) ∧
          ¬ IsUnit (Polynomial.aeval θ P₁) := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro M hd hM_monic hM_not_unit
      have hd_pos : 0 < d := by
        by_contra hd0
        have hd_zero : M.natDegree = 0 := by omega
        have hM_one : M = 1 := Polynomial.eq_one_of_monic_natDegree_zero hM_monic hd_zero
        rw [hM_one, map_one] at hM_not_unit
        exact hM_not_unit isUnit_one
      let F_M : Polynomial K₀ := Polynomial.map j₀ M
      have hFM_monic : F_M.Monic := hM_monic.map j₀
      have hFM_deg : F_M.natDegree = d := (hM_monic.natDegree_map j₀).trans hd
      have hFM_not_unit : ¬ IsUnit F_M := by
        intro hu
        have h0 := Polynomial.natDegree_eq_zero_of_isUnit hu
        omega
      by_cases hFM_irred : Irreducible F_M
      · exact ⟨M, 1, (mul_one M).symm, hM_monic, hFM_irred, hM_not_unit⟩
      · have hex_fac : ∃ G₁ G₂ : Polynomial K₀, F_M = G₁ * G₂ ∧ ¬ IsUnit G₁ ∧ ¬ IsUnit G₂ := by
          rw [irreducible_iff, not_and_or] at hFM_irred
          rcases hFM_irred with hnu | hnot_forall
          · exact False.elim (hnu hFM_not_unit)
          · push Not at hnot_forall
            exact hnot_forall
        obtain ⟨G₁, G₂, hFM_eq, hG₁_nu, hG₂_nu⟩ := hex_fac
        have hFM_ne_zero : F_M ≠ 0 := hFM_monic.ne_zero
        have hG₁_ne : G₁ ≠ 0 := left_ne_zero_of_mul (hFM_eq ▸ hFM_ne_zero)
        have hG₂_ne : G₂ ≠ 0 := right_ne_zero_of_mul (hFM_eq ▸ hFM_ne_zero)
        have hdeg_pos_of_nu : ∀ G : Polynomial K₀, G ≠ 0 → ¬ IsUnit G → 0 < G.natDegree := by
          intro G hG_ne hG_nu
          by_contra hle
          have h0 : G.natDegree = 0 := by omega
          have hC : G = Polynomial.C (G.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero h0
          have hc_ne : G.coeff 0 ≠ 0 := by
            intro hc0
            apply hG_ne
            rw [hC, hc0, map_zero]
          apply hG_nu
          rw [hC]
          exact (IsUnit.mk0 (G.coeff 0) hc_ne).map Polynomial.C
        have hG₁_deg_pos : 0 < G₁.natDegree := hdeg_pos_of_nu G₁ hG₁_ne hG₁_nu
        have hG₂_deg_pos : 0 < G₂.natDegree := hdeg_pos_of_nu G₂ hG₂_ne hG₂_nu
        let c₁ : K₀ := G₁.leadingCoeff
        let c₂ : K₀ := G₂.leadingCoeff
        have hc₁c₂ : c₁ * c₂ = 1 := by
          dsimp [c₁, c₂]
          rw [← Polynomial.leadingCoeff_mul, ← hFM_eq, hFM_monic.leadingCoeff]
        let F₁ : Polynomial K₀ := G₁ * Polynomial.C c₁⁻¹
        let F₂ : Polynomial K₀ := G₂ * Polynomial.C c₂⁻¹
        have hF₁_monic : F₁.Monic := Polynomial.monic_mul_leadingCoeff_inv hG₁_ne
        have hF₂_monic : F₂.Monic := Polynomial.monic_mul_leadingCoeff_inv hG₂_ne
        have hF₁F₂ : F₁ * F₂ = F_M := by
          dsimp [F₁, F₂]
          calc
            (G₁ * Polynomial.C c₁⁻¹) * (G₂ * Polynomial.C c₂⁻¹)
                = (G₁ * G₂) * (Polynomial.C c₁⁻¹ * Polynomial.C c₂⁻¹) := by ring
            _ = F_M * Polynomial.C (c₁⁻¹ * c₂⁻¹) := by rw [← hFM_eq, ← Polynomial.C_mul]
            _ = F_M * Polynomial.C ((c₂ * c₁)⁻¹) := by rw [mul_inv_rev]
            _ = F_M := by rw [mul_comm c₂ c₁, hc₁c₂, inv_one, map_one, mul_one]
        obtain ⟨M₁, hM₁_map, hM₁_deg, hM₁_monic⟩ :=
          hGaussLift M F₁ hM_monic hF₁_monic ⟨F₂, hF₁F₂.symm⟩
        obtain ⟨M₂, hM₂_map, hM₂_deg, hM₂_monic⟩ :=
          hGaussLift M F₂ hM_monic hF₂_monic ⟨F₁, by rw [mul_comm, hF₁F₂]⟩
        have hM_fac : M = M₁ * M₂ := by
          apply Polynomial.map_injective j₀ hj₀_inj
          rw [Polynomial.map_mul, hM₁_map, hM₂_map, hF₁F₂]
        have hF₁_deg : F₁.natDegree = G₁.natDegree := by
          dsimp [F₁]
          have hc₁_ne : c₁⁻¹ ≠ 0 := inv_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hG₁_ne)
          rw [Polynomial.natDegree_mul hG₁_ne (Polynomial.C_ne_zero.mpr hc₁_ne),
            Polynomial.natDegree_C, add_zero]
        have hF₂_deg : F₂.natDegree = G₂.natDegree := by
          dsimp [F₂]
          have hc₂_ne : c₂⁻¹ ≠ 0 := inv_ne_zero (Polynomial.leadingCoeff_ne_zero.mpr hG₂_ne)
          rw [Polynomial.natDegree_mul hG₂_ne (Polynomial.C_ne_zero.mpr hc₂_ne),
            Polynomial.natDegree_C, add_zero]
        have hM₁_pos : 0 < M₁.natDegree := by omega
        have hM₂_pos : 0 < M₂.natDegree := by omega
        have hdeg_sum : d = M₁.natDegree + M₂.natDegree := by
          rw [← hd, hM_fac, hM₁_monic.natDegree_mul hM₂_monic]
        have hM₁_lt : M₁.natDegree < d := by omega
        have hM₂_lt : M₂.natDegree < d := by omega
        have hnot_both_units :
            ¬ IsUnit (Polynomial.aeval θ M₁) ∨ ¬ IsUnit (Polynomial.aeval θ M₂) := by
          by_contra hboth
          push Not at hboth
          apply hM_not_unit
          rw [hM_fac, map_mul]
          exact hboth.1.mul hboth.2
        rcases hnot_both_units with hnu₁ | hnu₂
        · obtain ⟨P₁, Q', hM₁_eq, hP₁_mon, hP₁_irr, hP₁_nu⟩ :=
            ih M₁.natDegree hM₁_lt M₁ rfl hM₁_monic hnu₁
          refine ⟨P₁, Q' * M₂, ?_, hP₁_mon, hP₁_irr, hP₁_nu⟩
          rw [hM_fac, hM₁_eq, mul_assoc]
        · obtain ⟨P₁, Q', hM₂_eq, hP₁_mon, hP₁_irr, hP₁_nu⟩ :=
            ih M₂.natDegree hM₂_lt M₂ rfl hM₂_monic hnu₂
          refine ⟨P₁, M₁ * Q', ?_, hP₁_mon, hP₁_irr, hP₁_nu⟩
          rw [hM_fac, hM₂_eq, mul_left_comm]

  have hPf_not_unit : ¬ IsUnit (Polynomial.aeval θ P.f) := by
    rw [hPf_θ]
    exact not_isUnit_zero
  obtain ⟨P₁, Q₁, hPf_fac, hP₁_monic, hP₁_irred, hP₁_not_unit⟩ :=
    hIsolate P.f.natDegree P.f rfl P.monic_f hPf_not_unit
  
  have hP₁_mem_max : Polynomial.aeval θ P₁ ∈ IsLocalRing.maximalIdeal B_q := by
    by_contra hnot
    exact hP₁_not_unit (IsLocalRing.notMem_maximalIdeal.mp hnot)
  have hQ₁_θ_unit : IsUnit (Polynomial.aeval θ Q₁) := by
    by_contra hQ₁_nu
    have hQ₁_mem_max : Polynomial.aeval θ Q₁ ∈ IsLocalRing.maximalIdeal B_q := by
      by_contra hnot
      exact hQ₁_nu (IsLocalRing.notMem_maximalIdeal.mp hnot)
    have hderiv_eq : P.f.derivative = P₁.derivative * Q₁ + P₁ * Q₁.derivative := by
      rw [hPf_fac, Polynomial.derivative_mul]
    have hderiv_θ :
        Polynomial.aeval θ P.f.derivative =
          Polynomial.aeval θ P₁.derivative * Polynomial.aeval θ Q₁ +
            Polynomial.aeval θ P₁ * Polynomial.aeval θ Q₁.derivative := by
      rw [hderiv_eq, map_add, map_mul, map_mul]
    have hmem_max : Polynomial.aeval θ P.f.derivative ∈ IsLocalRing.maximalIdeal B_q := by
      rw [hderiv_θ]
      exact Ideal.add_mem _
        (Ideal.mul_mem_left _ _ hQ₁_mem_max)
        (Ideal.mul_mem_right _ _ hP₁_mem_max)
    exact (IsLocalRing.notMem_maximalIdeal.mpr hPf'_θ_unit) hmem_max
  have hP₁_θ_zero : Polynomial.aeval θ P₁ = 0 := by
    obtain ⟨u_Q, hu_Q⟩ := hQ₁_θ_unit
    have hmul0 : Polynomial.aeval θ P₁ * (u_Q : B_q) = 0 := by
      rw [hu_Q, ← map_mul, ← hPf_fac, hPf_θ]
    calc
      Polynomial.aeval θ P₁ = Polynomial.aeval θ P₁ * ((u_Q : B_q) * ↑(u_Q⁻¹)) := by
        rw [Units.mul_inv, mul_one]
      _ = (Polynomial.aeval θ P₁ * (u_Q : B_q)) * ↑(u_Q⁻¹) := (mul_assoc _ _ _).symm
      _ = 0 := by rw [hmul0, zero_mul]

  
  let I₁ : Ideal (Polynomial A₀) := Ideal.span ({P₁} : Set (Polynomial A₀))
  have hF₁_prime : Prime (Polynomial.map j₀ P₁) :=
    UniqueFactorizationMonoid.irreducible_iff_prime.mp hP₁_irred
  have hP₁_deg_pos : 0 < P₁.natDegree := by
    by_contra h0
    have hdeg0 : P₁.natDegree = 0 := by omega
    have hP₁_one : P₁ = 1 := Polynomial.eq_one_of_monic_natDegree_zero hP₁_monic hdeg0
    apply hP₁_irred.not_isUnit
    rw [hP₁_one, Polynomial.map_one]
    exact isUnit_one
  have hI₁_prime : I₁.IsPrime := by
    rw [Ideal.isPrime_iff]
    refine ⟨?_, ?_⟩
    · intro htop
      have h1 : (1 : Polynomial A₀) ∈ I₁ := htop ▸ Submodule.mem_top
      have hdvd1 : P₁ ∣ 1 := Ideal.mem_span_singleton.mp h1
      have hle0 : P₁.natDegree ≤ (1 : Polynomial A₀).natDegree :=
        Polynomial.natDegree_le_of_dvd hdvd1 one_ne_zero
      rw [Polynomial.natDegree_one] at hle0
      omega
    · intro g₁ g₂ hmul
      have hdvd : P₁ ∣ g₁ * g₂ := Ideal.mem_span_singleton.mp hmul
      have hdvd_map : Polynomial.map j₀ P₁ ∣ Polynomial.map j₀ g₁ * Polynomial.map j₀ g₂ := by
        rw [← Polynomial.map_mul]
        exact Polynomial.map_dvd j₀ hdvd
      rcases hF₁_prime.dvd_or_dvd hdvd_map with hd₁ | hd₂
      · left
        exact Ideal.mem_span_singleton.mpr ((Polynomial.map_dvd_map j₀ hj₀_inj hP₁_monic).mp hd₁)
      · right
        exact Ideal.mem_span_singleton.mpr ((Polynomial.map_dvd_map j₀ hj₀_inj hP₁_monic).mp hd₂)
  let D : Type u := Polynomial A₀ ⧸ I₁
  have : I₁.IsPrime := hI₁_prime
  have : IsDomain D := Ideal.Quotient.isDomain I₁
  let π_D : Polynomial A₀ →+* D := Ideal.Quotient.mk I₁
  have hker_I₁ : ∀ h ∈ I₁, (Polynomial.aeval θ).toRingHom h = 0 := by
    intro h hh
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hh
    simp [hP₁_θ_zero]
  let φ_D : D →+* B_q := Ideal.Quotient.lift I₁ (Polynomial.aeval θ).toRingHom hker_I₁
  have hφ_D_mk : ∀ h : Polynomial A₀, φ_D (π_D h) = Polynomial.aeval θ h := fun _ => rfl
  let _ : Algebra D B_q := φ_D.toAlgebra
  let Q_D : Ideal D := Ideal.comap φ_D (IsLocalRing.maximalIdeal B_q)
  have : Q_D.IsPrime := Ideal.comap_isPrime φ_D (IsLocalRing.maximalIdeal B_q)
  have hLoc_D : IsLocalization Q_D.primeCompl B_q := by
    refine ⟨?_, ?_, ?_⟩
    · intro s
      change IsUnit (φ_D s.1)
      exact IsLocalRing.notMem_maximalIdeal.mp s.2
    · intro z
      obtain ⟨⟨b, t⟩, hbt⟩ := IsLocalization.surj q.primeCompl z
      dsimp only at hbt
      obtain ⟨h_b, m₁, hmb⟩ := hS₁_surj_poly (algebraMap B S₁ b)
      obtain ⟨h_t, m₂, hmt⟩ := hS₁_surj_poly (algebraMap B S₁ t.1)
      have hmb_Bq : algebraMap B B_q b * (Polynomial.aeval θ P.g) ^ m₁ = Polynomial.aeval θ h_b := by
        have h1 := congrArg ι₁ hmb
        rw [map_mul, hι₁_B, map_pow, hι₁_aeval, hι₁_aeval] at h1
        exact h1
      have hmt_Bq : algebraMap B B_q t.1 * (Polynomial.aeval θ P.g) ^ m₂ = Polynomial.aeval θ h_t := by
        have h1 := congrArg ι₁ hmt
        rw [map_mul, hι₁_B, map_pow, hι₁_aeval, hι₁_aeval] at h1
        exact h1
      let u_D : D := π_D (P.g ^ m₂ * h_b)
      let v_D : D := π_D (P.g ^ m₁ * h_t)
      have hv_unit : IsUnit (φ_D v_D) := by
        dsimp [v_D]
        rw [hφ_D_mk, map_mul, map_pow, ← hmt_Bq]
        exact (hPg_θ_unit.pow m₁).mul
          ((IsLocalization.map_units B_q t).mul (hPg_θ_unit.pow m₂))
      have hv_mem : v_D ∈ Q_D.primeCompl :=
        IsLocalRing.notMem_maximalIdeal.mpr hv_unit
      refine ⟨⟨u_D, ⟨v_D, hv_mem⟩⟩, ?_⟩
      change z * φ_D v_D = φ_D u_D
      dsimp [u_D, v_D]
      rw [hφ_D_mk, hφ_D_mk, map_mul, map_pow, map_mul, map_pow, ← hmb_Bq, ← hmt_Bq]
      calc
        z * ((Polynomial.aeval θ P.g) ^ m₁ * (algebraMap B B_q t.1 * (Polynomial.aeval θ P.g) ^ m₂))
            = (z * algebraMap B B_q t.1) * ((Polynomial.aeval θ P.g) ^ m₁ * (Polynomial.aeval θ P.g) ^ m₂) := by ring
        _ = algebraMap B B_q b * ((Polynomial.aeval θ P.g) ^ m₁ * (Polynomial.aeval θ P.g) ^ m₂) := by rw [hbt]
        _ = (Polynomial.aeval θ P.g) ^ m₂ * (algebraMap B B_q b * (Polynomial.aeval θ P.g) ^ m₁) := by ring
    · intro d₁ d₂ hd_eq
      change φ_D d₁ = φ_D d₂ at hd_eq
      obtain ⟨h, hh_eq⟩ := Ideal.Quotient.mk_surjective (d₁ - d₂)
      have hh_zero : Polynomial.aeval θ h = 0 := by
        rw [← hφ_D_mk]
        rw [hh_eq, map_sub, hd_eq, sub_self]
      obtain ⟨H, hH_unit, hPf_dvd⟩ := hBq_ker_poly h hh_zero
      have hP₁_dvd : P₁ ∣ H * h := dvd_trans ⟨Q₁, hPf_fac⟩ hPf_dvd
      have hH_mem : π_D H ∈ Q_D.primeCompl := by
        change φ_D (π_D H) ∉ IsLocalRing.maximalIdeal B_q
        rw [hφ_D_mk]
        exact IsLocalRing.notMem_maximalIdeal.mpr hH_unit
      refine ⟨⟨π_D H, hH_mem⟩, ?_⟩
      dsimp only
      rw [← sub_eq_zero, ← mul_sub, ← hh_eq]
      change π_D H * π_D h = 0
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton.mpr hP₁_dvd
  exact IsLocalization.isDomain_of_le_nonZeroDivisors B_q
    (Ideal.primeCompl_le_nonZeroDivisors Q_D)

theorem weil_quotientBase_curve_smooth_unique_and_goingDown (V_ring : Type u) [CommRing V_ring]
    (P : Ideal V_ring) [P.IsPrime]
    (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [IsIntegrallyClosed R]
    (π_P : V_ring →+* R) (hSurjP : Function.Surjective π_P) (hKerP : RingHom.ker π_P = P)
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
    (k_P : Type u) [Field k_P] [IsAlgClosed k_P] [Algebra R k_P] [IsFractionRing R k_P]
    (π₀ : R) (hπ₀_ne : π₀ ≠ 0) [IsLocalization.Away π₀ k_P]
    (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (ρ₀ : R →+* k₀) (hSurj₀ : Function.Surjective ρ₀)
    (hKer₀ : RingHom.ker ρ₀ = IsLocalRing.maximalIdeal R)
    (C : AlgebraicGeometry.Scheme.{u})
    (g : C ⟶ AlgebraicGeometry.Spec (CommRingCat.of V_ring))
    (hFlat : AlgebraicGeometry.Flat g)
    (hProp : AlgebraicGeometry.IsProper g)
    (hLFP : AlgebraicGeometry.LocallyOfFinitePresentation g)
    (V₀ V₁ : C.Opens)
    (hAff₀ : AlgebraicGeometry.IsAffineOpen V₀)
    (hAff₁ : AlgebraicGeometry.IsAffineOpen V₁)
    (hCov : V₀ ⊔ V₁ = ⊤)
    (h₀ : ↑(C.presheaf.obj (Opposite.op V₀)))
    (t₀ : ↑(C.presheaf.obj (Opposite.op V₁)))
    (hBasic₀ : C.basicOpen h₀ = V₀ ⊓ V₁)
    (hBasic₁ : C.basicOpen t₀ = V₀ ⊓ V₁)
    (hInv01 :
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₀ ⊓ V₁ ≤ V₀)).op).hom h₀ *
      (C.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V₀ ⊓ V₁ ≤ V₁)).op).hom t₀ = 1)
    (hFin₀ : (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of V_ring)).inv ≫
        g.appLE ⊤ V₀ le_top).hom) h₀).Finite)
    (hFin₁ : (Polynomial.eval₂RingHom
      (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of V_ring)).inv ≫
        g.appLE ⊤ V₁ le_top).hom) t₀).Finite)
    (hSmInf : ∀ x : ↥V₀, x.1 ∉ (C.basicOpen h₀ : Set C) →
      ∃ V_sm : C.Opens, x.1 ∈ V_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g))
    (s_P : AlgebraicGeometry.Spec (CommRingCat.of k_P) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of V_ring))
    (hs_P : s_P =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R k_P)) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_P))
    (s₀ : AlgebraicGeometry.Spec (CommRingCat.of k₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of V_ring))
    (hs₀ : s₀ =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₀) ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_P))
    (hOverlap_P : ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s_P),
      (((CategoryTheory.Limits.pullback.fst g s_P).base ⁻¹' ((V₀ ⊓ V₁ : C.Opens) : Set C)) ∩ E).Nonempty)
    (hOverlap_Y : ∀ E ∈ irreducibleComponents ↥(CategoryTheory.Limits.pullback g s₀),
      (((CategoryTheory.Limits.pullback.fst g s₀).base ⁻¹' ((V₀ ⊓ V₁ : C.Opens) : Set C)) ∩ E).Nonempty)
    (hSemi_P : ∀ y : ↥(CategoryTheory.Limits.pullback g s_P),
      (∃ V_sm : (CategoryTheory.Limits.pullback g s_P).Opens,
        y ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V_sm.ι ≫ CategoryTheory.Limits.pullback.snd g s_P)) ∨
      (∃ (U' : AlgebraicGeometry.Scheme.{u}) (u₀ : U')
          (e₁ : U' ⟶ CategoryTheory.Limits.pullback g s_P)
          (e₂ : U' ⟶ AlgebraicGeometry.Spec (CommRingCat.of
            (MvPolynomial (Fin 2) k_P ⧸ Ideal.span
              {(MvPolynomial.X 0 : MvPolynomial (Fin 2) k_P) *
                (MvPolynomial.X 1 : MvPolynomial (Fin 2) k_P)}))),
        AlgebraicGeometry.Etale e₁ ∧
        AlgebraicGeometry.Etale e₂ ∧
        e₁.base u₀ = y ∧
        (∀ i : Fin 2, Ideal.Quotient.mk _ (MvPolynomial.X i : MvPolynomial (Fin 2) k_P) ∈
          (e₂.base u₀).asIdeal) ∧
        e₁ ≫ CategoryTheory.Limits.pullback.snd g s_P =
          e₂ ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp
              (MvPolynomial.C : k_P →+* MvPolynomial (Fin 2) k_P)))))
    (hEtaleStalkDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
      [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B] (q : Ideal B) [q.IsPrime],
      IsDomain (Localization.AtPrime q)) :
    let u_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_P)
    let C_R := CategoryTheory.Limits.pullback g u_R
    let fst_R := CategoryTheory.Limits.pullback.fst g u_R
    let g_R := CategoryTheory.Limits.pullback.snd g u_R
    let X_P := CategoryTheory.Limits.pullback g s_P
    let Y := CategoryTheory.Limits.pullback g s₀
    let R₀ := C.presheaf.obj (Opposite.op V₀)
    let R₁ := C.presheaf.obj (Opposite.op V₁)
    let φ₀ : V_ring →+* ↑R₀ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of V_ring)).inv ≫
        g.appLE ⊤ V₀ le_top).hom
    let φ₁ : V_ring →+* ↑R₁ :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of V_ring)).inv ≫
        g.appLE ⊤ V₁ le_top).hom
    let I₀_P : Ideal ↑R₀ := Ideal.map φ₀ P
