            intro j
            by_cases hj : j = a
            · subst hj
              have h1 : φ_loc X_a = 1 := by simp [φ_loc, hdehom_Xa]
              rw [h1]
              exact (Localization.mk_self (⟨X_a, Submonoid.mem_powers X_a⟩ : S_a)).symm
            · have h2 : φ_loc (MvPolynomial.X j) = (t_tilde j).val := by
                simp [φ_loc, dehom, w, dif_neg hj, α, valHom]
              rw [h2, HomogeneousLocalization.Away.val_mk]
              congr 1
              apply Subtype.ext
              exact pow_one X_a
          have hφ_prod : ∀ (d : Fin (N + 1) →₀ ℕ) (s_fin : Finset (Fin (N + 1))),
              φ_loc (∏ j ∈ s_fin, MvPolynomial.X j ^ d j) =
                Localization.mk (∏ j ∈ s_fin, MvPolynomial.X j ^ d j)
                  ⟨X_a ^ (∑ j ∈ s_fin, d j),
                    S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ s_fin, d j)⟩ := by
            intro d s_fin
            induction s_fin using Finset.induction_on with
            | empty => simp
            | @insert j s_fin hj ih =>
              rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul, map_pow, hφ_X j, ih,
                Localization.mk_pow, Localization.mk_mul]
              congr 1
              apply Subtype.ext
              change X_a ^ d j * X_a ^ (∑ i ∈ s_fin, d i) = X_a ^ (d j + ∑ i ∈ s_fin, d i)
              rw [← pow_add]
          have hφ_monomial : ∀ (d : Fin (N + 1) →₀ ℕ) (c : R),
              φ_loc (MvPolynomial.monomial d c) =
                Localization.mk (MvPolynomial.monomial d c)
                  ⟨X_a ^ (∑ j ∈ d.support, d j),
                    S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ d.support, d j)⟩ := by
            intro d c
            rw [MvPolynomial.monomial_eq, Finsupp.prod, map_mul, hφ_C c, hφ_prod d d.support,
              Localization.mk_mul]
            congr 1
            apply Subtype.ext
            exact one_mul _
          have hφ_homog : ∀ (n_deg : ℕ) (p : MvPolynomial (Fin (N + 1)) R),
              p.IsHomogeneous n_deg →
              φ_loc p = Localization.mk p
                ⟨X_a ^ n_deg, S_a.pow_mem (Submonoid.mem_powers X_a) n_deg⟩ := by
            intro n_deg p hp
            let y_n : S_a := ⟨X_a ^ n_deg, S_a.pow_mem (Submonoid.mem_powers X_a) n_deg⟩
            have hsum_eq : ∀ s_fin : Finset (Fin (N + 1) →₀ ℕ),
                (∀ d ∈ s_fin, (∑ j ∈ d.support, d j) = n_deg) →
                φ_loc (∑ d ∈ s_fin, MvPolynomial.monomial d (p.coeff d)) =
                  Localization.mk (∑ d ∈ s_fin, MvPolynomial.monomial d (p.coeff d)) y_n := by
              intro s_fin
              induction s_fin using Finset.induction_on with
              | empty =>
                intro _
                simp [Localization.mk_zero]
              | @insert d s_fin hd ih =>
                intro hs
                have hd_n : (∑ j ∈ d.support, d j) = n_deg :=
                  hs d (Finset.mem_insert_self d s_fin)
                have hs_n : ∀ d' ∈ s_fin, (∑ j ∈ d'.support, d' j) = n_deg :=
                  fun d' hd' => hs d' (Finset.mem_insert_of_mem hd')
                rw [Finset.sum_insert hd, map_add, hφ_monomial d (p.coeff d), ih hs_n]
                have hy_eq : (⟨X_a ^ (∑ j ∈ d.support, d j),
                    S_a.pow_mem (Submonoid.mem_powers X_a) (∑ j ∈ d.support, d j)⟩ : S_a) = y_n := by
                  apply Subtype.ext
                  exact congrArg (X_a ^ ·) hd_n
                rw [hy_eq, Localization.add_mk_self]
            have hp_supp : ∀ d ∈ p.support, (∑ j ∈ d.support, d j) = n_deg := by
              intro d hd
              have hdeg := hp (MvPolynomial.mem_support_iff.mp hd)
              simpa [Finsupp.weight_apply, Finsupp.sum, smul_eq_mul, mul_one] using hdeg
            conv_lhs => rw [MvPolynomial.as_sum p]
            conv_rhs => rw [MvPolynomial.as_sum p]
            exact hsum_eq p.support hp_supp
          obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
          obtain ⟨n_deg, hn⟩ := nd.den_mem
          dsimp only at hn
          have hXa_pow_ne : X_a ^ n_deg ≠ 0 := by
            intro hzero
            have hev : MvPolynomial.eval (fun _ => (1 : R)) (X_a ^ n_deg) = 0 := by
              rw [hzero, map_zero]
            have hev1 : MvPolynomial.eval (fun _ => (1 : R)) (X_a ^ n_deg) = 1 := by simp [X_a]
            exact one_ne_zero (hev1.symm.trans hev)
          have hex_coeff : ∃ d₀ : Fin (N + 1) →₀ ℕ, (X_a ^ n_deg).coeff d₀ ≠ 0 := by
            by_contra hall
            exact hXa_pow_ne (MvPolynomial.ext _ _ fun d₀ => by
              simp [Classical.not_not.mp fun h => hall ⟨d₀, h⟩])
          rcases hex_coeff with ⟨d₀, hd₀⟩
          have hden_hom1 : (X_a ^ n_deg).IsHomogeneous nd.deg := by
            rw [hn]
            exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
          have hden_hom2 : (X_a ^ n_deg).IsHomogeneous n_deg := by
            simpa using (MvPolynomial.isHomogeneous_X R a).pow n_deg
          have hdeg_eq : nd.deg = n_deg := (hden_hom1 hd₀).symm.trans (hden_hom2 hd₀)
          have hnum_hom : nd.num.1.IsHomogeneous n_deg := by
            rw [← hdeg_eq]
            exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
          apply HomogeneousLocalization.val_injective S_a
          have hβ_nd : β (HomogeneousLocalization.mk nd) = dehom nd.num.1 := by
            change β_loc (HomogeneousLocalization.mk nd).val = dehom nd.num.1
            rw [HomogeneousLocalization.val_mk, hβ_loc_mk]
          rw [hβ_nd]
          change φ_loc nd.num.1 = (HomogeneousLocalization.mk nd).val
          rw [hφ_homog n_deg nd.num.1 hnum_hom, HomogeneousLocalization.val_mk]
          congr 1
          apply Subtype.ext
          exact hn
      let e : MvPolynomial τ R ≃+* HomogeneousLocalization.Away 𝒜 X_a :=
        { α with
          invFun := β
          left_inv := hleft
          right_inv := hright }
      exact ⟨e, fun r => MvPolynomial.eval₂Hom_C ι_a _ r,
        fun b => MvPolynomial.eval₂Hom_X' ι_a _ b⟩
