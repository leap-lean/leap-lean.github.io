theorem weil_algClosed_smooth_and_nodal_etale_ring_local_structure (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
    (hEtDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
      ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g)) :
    let A_nod : Type u :=
      MvPolynomial (Fin 2) k₀ ⧸
        Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
    (∀ (D : Type u) [CommRing D] [IsDomain D] (φ_T : Polynomial k₀ →+* D),
      φ_T.Etale →
      (∃ p₁ p₂ : PrimeSpectrum D, p₁ ≠ p₂) ∧
      (∀ Z : Set (PrimeSpectrum D), IsClosed Z → Z ≠ Set.univ → Z.Finite)) ∧
    (∀ (C_r : Type u) [CommRing C_r] (φ_N : A_nod →+* C_r) (q_r : PrimeSpectrum C_r)
       (ψ_sm : Polynomial k₀ →+* C_r),
      φ_N.Etale →
      ψ_sm.Etale →
      (∀ i : Fin 2, φ_N (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_r.asIdeal) →
      ψ_sm.comp Polynomial.C = φ_N.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) →
      False) ∧
    (∀ (B₀ : Type u) [CommRing B₀] (φ₂_0 : A_nod →+* B₀) (q₀ : PrimeSpectrum B₀),
      φ₂_0.Etale →
      (∀ i : Fin 2, φ₂_0 (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q₀.asIdeal) →
      ∃ h : B₀,
        h ∉ q₀.asIdeal ∧
        let B' : Type u := Localization.Away h
        let ψ : B₀ →+* B' := algebraMap B₀ B'
        let φ₂ : A_nod →+* B' := ψ.comp φ₂_0
        ∃ u₀ : PrimeSpectrum B',
          PrimeSpectrum.comap ψ u₀ = q₀ ∧
          (∃ ev₀ : B' →+* k₀,
            ev₀.comp (φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = RingHom.id k₀ ∧
            RingHom.ker ev₀ = u₀.asIdeal) ∧
          PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} : Set B') ∪
            PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))} : Set B') =
            Set.univ ∧
          PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 0))} : Set B') ∩
            PrimeSpectrum.zeroLocus ({φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X 1))} : Set B') =
            {u₀} ∧
          (∀ u' : PrimeSpectrum B', u' ≠ u₀ →
            ∃ (f_sm : B') (ψ_sm : Polynomial k₀ →+* Localization.Away f_sm),
              f_sm ∉ u'.asIdeal ∧
              ψ_sm.Etale ∧
              ψ_sm.comp Polynomial.C =
                (algebraMap B' (Localization.Away f_sm)).comp
                  (φ₂.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))) ∧
          (∀ i : Fin 2,
            IsDomain (B' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))}) ∧
            ∃ θ_i : Polynomial k₀ →+*
                (B' ⧸ Ideal.span {φ₂ (Ideal.Quotient.mk _ (MvPolynomial.X i))}),
              θ_i.Etale)) :=
by
  classical
  intro A_nod
  letI : CommRing A_nod := inferInstance
  let I_nod : Ideal (MvPolynomial (Fin 2) k₀) :=
    Ideal.span ({MvPolynomial.X 0 * MvPolynomial.X 1} : Set (MvPolynomial (Fin 2) k₀))
  let mk_nod : MvPolynomial (Fin 2) k₀ →+* A_nod := Ideal.Quotient.mk I_nod
  let x_nod : Fin 2 → A_nod := fun i => mk_nod (MvPolynomial.X i)
  let c_nod : k₀ →+* A_nod := mk_nod.comp MvPolynomial.C

  
  
  
  have hPart1 : ∀ (D : Type u) [CommRing D] [IsDomain D] (φ_T : Polynomial k₀ →+* D),
      φ_T.Etale →
      (∃ p₁ p₂ : PrimeSpectrum D, p₁ ≠ p₂) ∧
      (∀ Z : Set (PrimeSpectrum D), IsClosed Z → Z ≠ Set.univ → Z.Finite) := by
    intro D _ _ φ_T hEt_T
    letI : Algebra (Polynomial k₀) D := φ_T.toAlgebra
    letI : Algebra k₀ D := (φ_T.comp Polynomial.C).toAlgebra
    haveI : IsScalarTower k₀ (Polynomial k₀) D := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : Algebra.Etale (Polynomial k₀) D := RingHom.etale_algebraMap.mpr hEt_T
    haveI : Algebra.FiniteType k₀ D :=
      Algebra.FiniteType.trans
        (inferInstance : Algebra.FiniteType k₀ (Polynomial k₀))
        (inferInstance : Algebra.FiniteType (Polynomial k₀) D)
    have hInj : Function.Injective φ_T := FaithfulSMul.algebraMap_injective (Polynomial k₀) D
    have h_bot_prime : (⊥ : Ideal D).IsPrime :=
      ⟨ne_of_lt bot_lt_top, fun {x y} hxy => by
        rw [Ideal.mem_bot] at hxy ⊢
        exact mul_eq_zero.mp hxy⟩
    constructor
    · 
      let p₁ : PrimeSpectrum D := ⟨⊥, h_bot_prime⟩
      obtain ⟨𝔪, h𝔪_max⟩ := Ideal.exists_maximal D
      let p₂ : PrimeSpectrum D := ⟨𝔪, h𝔪_max.isPrime⟩
      refine ⟨p₁, p₂, ?_⟩
      intro hEq
      have h_bot_eq : (⊥ : Ideal D) = 𝔪 := congrArg PrimeSpectrum.asIdeal hEq
      haveI h_bot_max : (⊥ : Ideal D).IsMaximal := h_bot_eq.symm ▸ h𝔪_max
      let L₀ := D ⧸ (⊥ : Ideal D)
      letI : Field L₀ := Ideal.Quotient.field (⊥ : Ideal D)
      let π₀ : D →+* L₀ := Ideal.Quotient.mk (⊥ : Ideal D)
      haveI : Algebra.FiniteType k₀ L₀ :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k₀ (⊥ : Ideal D))
          Ideal.Quotient.mk_surjective
      haveI : Module.Finite k₀ L₀ := Module.finite_of_isArtinianRing k₀ L₀
      haveI : Algebra.IsIntegral k₀ L₀ := Algebra.IsIntegral.of_finite k₀ L₀
      have hBij_L₀ : Function.Bijective (algebraMap k₀ L₀) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      obtain ⟨c, hc⟩ := hBij_L₀.2 (π₀ (φ_T Polynomial.X))
      have hc' : π₀ (φ_T (Polynomial.C c)) = π₀ (φ_T Polynomial.X) := hc
      have h_sub_mem : φ_T (Polynomial.C c) - φ_T Polynomial.X ∈ (⊥ : Ideal D) :=
        Ideal.Quotient.eq.mp hc'
      rw [Ideal.mem_bot, sub_eq_zero] at h_sub_mem
      have hCX : Polynomial.C c = Polynomial.X := hInj h_sub_mem
      have h01 := congrArg (fun P : Polynomial k₀ => P.coeff 1) hCX
      simp at h01
    · 
      have hIncomp : ∀ (q₁ q₂ : PrimeSpectrum D),
          q₁.asIdeal ≤ q₂.asIdeal →
          PrimeSpectrum.comap φ_T q₁ = PrimeSpectrum.comap φ_T q₂ →
          q₁ = q₂ := by
        intro q₁ q₂ hle hcomap
        let p : PrimeSpectrum (Polynomial k₀) := PrimeSpectrum.comap φ_T q₁
        haveI : Module.Finite p.asIdeal.ResidueField (p.asIdeal.Fiber D) :=
          Algebra.QuasiFinite.finite_fiber p.asIdeal
        haveI : IsArtinianRing (p.asIdeal.Fiber D) :=
          IsArtinianRing.of_finite p.asIdeal.ResidueField (p.asIdeal.Fiber D)
        let e_fib := PrimeSpectrum.preimageOrderIsoFiber (Polynomial k₀) D p
        have hq₁_in : q₁ ∈ PrimeSpectrum.comap (algebraMap (Polynomial k₀) D) ⁻¹' {p} := rfl
        have hq₂_in : q₂ ∈ PrimeSpectrum.comap (algebraMap (Polynomial k₀) D) ⁻¹' {p} :=
          hcomap.symm
        have h_ord : (⟨q₁, hq₁_in⟩ : ↑(PrimeSpectrum.comap (algebraMap (Polynomial k₀) D) ⁻¹' {p})) ≤
            ⟨q₂, hq₂_in⟩ := hle
        have h_fib_le : (e_fib ⟨q₁, hq₁_in⟩).asIdeal ≤ (e_fib ⟨q₂, hq₂_in⟩).asIdeal :=
          e_fib.monotone h_ord
        have h_fib_max : (e_fib ⟨q₁, hq₁_in⟩).asIdeal.IsMaximal :=
          (IsArtinianRing.isPrime_iff_isMaximal _).mp (e_fib ⟨q₁, hq₁_in⟩).isPrime
        have h_fib_eq : e_fib ⟨q₁, hq₁_in⟩ = e_fib ⟨q₂, hq₂_in⟩ :=
          PrimeSpectrum.ext (h_fib_max.eq_of_le (e_fib ⟨q₂, hq₂_in⟩).isPrime.ne_top h_fib_le)
        exact congrArg Subtype.val (e_fib.injective h_fib_eq)
      have hMaxOfNeBot : ∀ (P : Ideal D) [P.IsPrime], P ≠ ⊥ → P.IsMaximal := by
        intro P hP_prime hP_ne
        let qP : PrimeSpectrum D := ⟨P, hP_prime⟩
        let p₀ : PrimeSpectrum (Polynomial k₀) := PrimeSpectrum.comap φ_T qP
        have hp₀_ne : p₀.asIdeal ≠ ⊥ := by
          intro hp₀_bot
          have h_bot_comap : PrimeSpectrum.comap φ_T ⟨⊥, h_bot_prime⟩ = p₀ := by
            ext x
            simp only [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, Ideal.mem_bot, hp₀_bot]
            exact ⟨fun h => hInj (h.trans φ_T.map_zero.symm), fun h => h ▸ φ_T.map_zero⟩
          have h_eq := hIncomp ⟨⊥, h_bot_prime⟩ qP bot_le h_bot_comap
          exact hP_ne (congrArg PrimeSpectrum.asIdeal h_eq).symm
        have hp₀_max : p₀.asIdeal.IsMaximal := Ideal.IsPrime.isMaximal inferInstance hp₀_ne
        refine ⟨⟨hP_prime.ne_top, ?_⟩⟩
        intro J hPJ
        by_contra hJ_ne
        obtain ⟨Q, hQ_max, hJQ⟩ := Ideal.exists_le_maximal J hJ_ne
        let qQ : PrimeSpectrum D := ⟨Q, hQ_max.isPrime⟩
        have h_le_comap : p₀.asIdeal ≤ (PrimeSpectrum.comap φ_T qQ).asIdeal :=
          Ideal.comap_mono (hPJ.le.trans hJQ)
        have h_eq_comap : p₀ = PrimeSpectrum.comap φ_T qQ :=
          PrimeSpectrum.ext (hp₀_max.eq_of_le (PrimeSpectrum.comap φ_T qQ).isPrime.ne_top h_le_comap)
        have hPQ : qP = qQ := hIncomp qP qQ (hPJ.le.trans hJQ) h_eq_comap
        have hQ_eq_P : Q = P := (congrArg PrimeSpectrum.asIdeal hPQ).symm
        exact not_le_of_gt hPJ (hQ_eq_P ▸ hJQ)
      intro Z hZ_cl hZ_ne
      obtain ⟨I, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal _).mp hZ_cl
      have hEx_out : ∃ q_out : PrimeSpectrum D, q_out ∉ PrimeSpectrum.zeroLocus (I : Set D) := by
        by_contra! hAll
        exact hZ_ne (Set.eq_univ_of_forall hAll)
      obtain ⟨q_out, hq_out⟩ := hEx_out
      rw [PrimeSpectrum.mem_zeroLocus] at hq_out
      obtain ⟨f, hfI, hf_notMem⟩ := Set.not_subset.mp hq_out
      have hf_ne : f ≠ 0 := fun h0 => hf_notMem (h0 ▸ q_out.asIdeal.zero_mem)
      let If : Ideal D := Ideal.span ({f} : Set D)
      have hSub : PrimeSpectrum.zeroLocus (I : Set D) ⊆ PrimeSpectrum.zeroLocus (If : Set D) := by
        rw [PrimeSpectrum.zeroLocus_span]
        intro q hq x hx
        rw [Set.mem_singleton_iff] at hx
        exact hx ▸ hq hfI
      refine Set.Finite.subset ?_ hSub
      let R_f := D ⧸ If
      let π_f : D →+* R_f := Ideal.Quotient.mk If
      let e_zf := Ideal.primeSpectrumOrderIsoZeroLocusOfSurj π_f
        Ideal.Quotient.mk_surjective Ideal.mk_ker
      haveI : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing k₀ D
      haveI : IsNoetherianRing R_f := inferInstance
      have hMinFin : (minimalPrimes R_f).Finite := minimalPrimes.finite_of_isNoetherianRing R_f
      haveI : Finite ↥(minimalPrimes R_f) := hMinFin.to_subtype
      have hAllMin : ∀ Q : PrimeSpectrum R_f, Q.asIdeal ∈ minimalPrimes R_f := by
        intro Q
        refine ⟨⟨Q.isPrime, bot_le⟩, ?_⟩
        rintro J ⟨hJ_prime, _⟩ hJQ
        haveI : J.IsPrime := hJ_prime
        let PJ : Ideal D := Ideal.comap π_f J
        haveI : PJ.IsPrime := Ideal.comap_isPrime π_f J
        have hf_PJ : f ∈ PJ := by
          change π_f f ∈ J
          have h0 : π_f f = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [h0]
          exact J.zero_mem
        have hPJ_ne : PJ ≠ ⊥ := fun h0 => hf_ne (Ideal.mem_bot.mp (h0 ▸ hf_PJ))
        have hPJ_max : PJ.IsMaximal := hMaxOfNeBot PJ hPJ_ne
        have hPJ_le : PJ ≤ Ideal.comap π_f Q.asIdeal := Ideal.comap_mono hJQ
        have hPJ_eq : PJ = Ideal.comap π_f Q.asIdeal :=
          hPJ_max.eq_of_le (Ideal.comap_isPrime π_f Q.asIdeal).ne_top hPJ_le
        have hJ_eq : J = Q.asIdeal :=
          Ideal.comap_injective_of_surjective π_f Ideal.Quotient.mk_surjective hPJ_eq
        exact hJ_eq.ge
      haveI : Finite (PrimeSpectrum R_f) :=
        Finite.of_injective (fun Q : PrimeSpectrum R_f => (⟨Q.asIdeal, hAllMin Q⟩ : ↥(minimalPrimes R_f)))
          (fun Q₁ Q₂ h => PrimeSpectrum.ext (congrArg Subtype.val h))
      haveI : Finite ↥(PrimeSpectrum.zeroLocus (If : Set D)) := Finite.of_equiv _ e_zf.toEquiv
      exact Set.toFinite _

  
  
  
  have hPart2 : ∀ (C_r : Type u) [CommRing C_r] (φ_N : A_nod →+* C_r) (q_r : PrimeSpectrum C_r)
      (ψ_sm : Polynomial k₀ →+* C_r),
      φ_N.Etale →
      ψ_sm.Etale →
      (∀ i : Fin 2, φ_N (Ideal.Quotient.mk _ (MvPolynomial.X i)) ∈ q_r.asIdeal) →
      ψ_sm.comp Polynomial.C = φ_N.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) →
      False := by
    intro C_r _ φ_N q_r ψ_sm hEt_N hEt_sm hOrig hComm
    obtain ⟨𝔪, h𝔪_max, hq_le_𝔪⟩ := Ideal.exists_le_maximal q_r.asIdeal q_r.isPrime.ne_top
    let L := C_r ⧸ 𝔪
    letI : Field L := Ideal.Quotient.field 𝔪
    let π_L : C_r →+* L := Ideal.Quotient.mk 𝔪
    letI : Algebra k₀ C_r := (ψ_sm.comp Polynomial.C).toAlgebra
    letI : Algebra k₀ L := (π_L.comp (ψ_sm.comp Polynomial.C)).toAlgebra
    haveI : IsScalarTower k₀ C_r L := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have hX_zero_L : ∀ i : Fin 2, π_L (φ_N (x_nod i)) = 0 := fun i =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (hq_le_𝔪 (hOrig i))
    have hLiftDeriv : ∀ v : Fin 2 → L,
        ∃ D : Derivation k₀ C_r L, ∀ i : Fin 2, D (φ_N (x_nod i)) = v i := by
      intro v
      letI : Algebra A_nod C_r := φ_N.toAlgebra
      letI : Algebra A_nod L := (π_L.comp φ_N).toAlgebra
      haveI : IsScalarTower k₀ A_nod C_r := ⟨fun c a x => by
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
        change φ_N (mk_nod (c • p)) * x = ψ_sm (Polynomial.C c) * (φ_N (mk_nod p) * x)
        rw [Algebra.smul_def, map_mul, map_mul, mul_assoc]
        congr 1
        exact (RingHom.congr_fun hComm c).symm⟩
      haveI : IsScalarTower A_nod C_r L := ⟨fun a x y => by
        change π_L (φ_N a * x) * y = π_L (φ_N a) * (π_L x * y)
        rw [map_mul, mul_assoc]⟩
      haveI : IsScalarTower k₀ A_nod L := ⟨fun c a y => by
        obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
        change π_L (φ_N (mk_nod (c • p))) * y =
          π_L (ψ_sm (Polynomial.C c)) * (π_L (φ_N (mk_nod p)) * y)
        rw [Algebra.smul_def, map_mul, map_mul, map_mul, mul_assoc]
        congr 1
        exact congrArg π_L (RingHom.congr_fun hComm c).symm⟩
      haveI : Algebra.Etale A_nod C_r := RingHom.etale_algebraMap.mpr hEt_N
      have hδ_ex : ∃ δ : Derivation k₀ A_nod L, ∀ i : Fin 2, δ (x_nod i) = v i := by
        letI : Algebra (MvPolynomial (Fin 2) k₀) L := ((π_L.comp φ_N).comp mk_nod).toAlgebra
        haveI : IsScalarTower k₀ (MvPolynomial (Fin 2) k₀) L := ⟨fun c p y => by
          change π_L (φ_N (mk_nod (c • p))) * y =
            π_L (ψ_sm (Polynomial.C c)) * (π_L (φ_N (mk_nod p)) * y)
          rw [Algebra.smul_def, map_mul, map_mul, map_mul, mul_assoc]
          congr 1
          exact congrArg π_L (RingHom.congr_fun hComm c).symm⟩
        let d_v : Derivation k₀ (MvPolynomial (Fin 2) k₀) L := MvPolynomial.mkDerivation k₀ v
        have h_smul_X : ∀ (i : Fin 2) (y : L),
            (MvPolynomial.X i : MvPolynomial (Fin 2) k₀) • y = 0 := by
          intro i y
          change π_L (φ_N (x_nod i)) * y = 0
          rw [hX_zero_L i, zero_mul]
        have hd_prod : d_v (MvPolynomial.X 0 * MvPolynomial.X 1) = 0 := by
          rw [d_v.leibniz, h_smul_X 0, h_smul_X 1, add_zero]
        have hKer : I_nod.restrictScalars k₀ ≤ LinearMap.ker d_v.toLinearMap := by
          intro p hp
          change p ∈ I_nod at hp
          rw [Ideal.mem_span_singleton] at hp
          rcases hp with ⟨q, rfl⟩
          change d_v ((MvPolynomial.X 0 * MvPolynomial.X 1) * q) = 0
          rw [d_v.leibniz, hd_prod, smul_zero, add_zero, mul_smul, h_smul_X 0]
        let lin_v : A_nod →ₗ[k₀] L := Submodule.liftQ (I_nod.restrictScalars k₀) d_v.toLinearMap hKer
        have hlin_mk : ∀ p : MvPolynomial (Fin 2) k₀, lin_v (mk_nod p) = d_v p := fun p => rfl
        let δ_v : Derivation k₀ A_nod L :=
          { toLinearMap := lin_v
            map_one_eq_zero' := by
              change lin_v (mk_nod 1) = 0
              rw [hlin_mk, d_v.map_one_eq_zero]
            leibniz' := fun a b => by
              obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
              obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b
              change lin_v (mk_nod (p * q)) = mk_nod p • lin_v (mk_nod q) + mk_nod q • lin_v (mk_nod p)
              rw [hlin_mk, hlin_mk, hlin_mk, d_v.leibniz]
              rfl }
        refine ⟨δ_v, fun i => ?_⟩
        change lin_v (mk_nod (MvPolynomial.X i)) = v i
        rw [hlin_mk, MvPolynomial.mkDerivation_X]
      obtain ⟨δ, hδ⟩ := hδ_ex
      let f_v : Ω[A_nod⁄k₀] →ₗ[A_nod] L :=
        (KaehlerDifferential.linearMapEquivDerivation k₀ A_nod).symm δ
      let g_v : TensorProduct A_nod C_r Ω[A_nod⁄k₀] →ₗ[C_r] L :=
        LinearMap.liftBaseChange C_r f_v
      let e_et : TensorProduct A_nod C_r Ω[A_nod⁄k₀] ≃ₗ[C_r] Ω[C_r⁄k₀] :=
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k₀ A_nod C_r
      let D_v : Derivation k₀ C_r L :=
        (KaehlerDifferential.linearMapEquivDerivation k₀ C_r) (g_v.comp e_et.symm.toLinearMap)
      refine ⟨D_v, fun i => ?_⟩
      have h_eq : D_v (algebraMap A_nod C_r (x_nod i)) = δ (x_nod i) := by
        dsimp only [D_v]
        rw [KaehlerDifferential.linearMapEquivDerivation_apply_apply]
        dsimp only [LinearMap.comp_apply, g_v, e_et]
        rw [LinearEquiv.coe_toLinearMap,
          KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_symm_D_algebraMap,
          LinearMap.liftBaseChange_tmul, one_smul,
          ← KaehlerDifferential.linearMapEquivDerivation_apply_apply]
        dsimp only [f_v]
        rw [LinearEquiv.apply_symm_apply]
      exact h_eq.trans (hδ i)
    have hKillDeriv : ∀ D : Derivation k₀ C_r L, D (ψ_sm Polynomial.X) = 0 → D = 0 := by
      intro D hDX
      letI : Algebra (Polynomial k₀) C_r := ψ_sm.toAlgebra
      letI : Algebra (Polynomial k₀) L := (π_L.comp ψ_sm).toAlgebra
      haveI : IsScalarTower k₀ (Polynomial k₀) C_r := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : IsScalarTower (Polynomial k₀) C_r L := IsScalarTower.of_algebraMap_eq fun _ => rfl
      haveI : Algebra.Etale (Polynomial k₀) C_r := RingHom.etale_algebraMap.mpr hEt_sm
      have hVanish : ∀ P : Polynomial k₀, D (ψ_sm P) = 0 := by
        intro P
        refine Polynomial.induction_on P ?_ ?_ ?_
        · intro c
          exact D.map_algebraMap c
        · intro p q hp hq
          rw [map_add, map_add, hp, hq, add_zero]
        · intro n c ih
          rw [pow_succ, ← mul_assoc, map_mul, D.leibniz, hDX, ih, smul_zero, smul_zero, add_zero]
      let D_poly : Derivation (Polynomial k₀) C_r L :=
        { toFun := D
          map_add' := D.map_add'
          map_smul' := fun P x => by
            change D (ψ_sm P * x) = π_L (ψ_sm P) * D x
            rw [D.leibniz, hVanish P, smul_zero, add_zero]
            rfl
          map_one_eq_zero' := D.map_one_eq_zero'
          leibniz' := D.leibniz' }
      haveI : Subsingleton Ω[C_r⁄Polynomial k₀] :=
        Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
      have hD_poly_zero : D_poly = 0 := by
        apply (KaehlerDifferential.linearMapEquivDerivation (Polynomial k₀) C_r).symm.injective
        exact Subsingleton.elim _ _
      ext x
      have hDx : D_poly x = 0 := by rw [hD_poly_zero]; rfl
      exact hDx
    obtain ⟨D₀, hD₀⟩ := hLiftDeriv (fun i => if i = 0 then (1 : L) else 0)
    obtain ⟨D₁, hD₁⟩ := hLiftDeriv (fun i => if i = 1 then (1 : L) else 0)
    let t : C_r := ψ_sm Polynomial.X
    let α : L := D₀ t
    let β : L := D₁ t
    let D_comb : Derivation k₀ C_r L := β • D₀ - α • D₁
    have hComb_t : D_comb t = 0 := by
      change β * D₀ t - α * D₁ t = 0
      dsimp [α, β]
      ring
    have hComb_zero : D_comb = 0 := hKillDeriv D_comb hComb_t
    have hComb_X1 : D_comb (φ_N (x_nod 1)) = 0 := by
      rw [hComb_zero]
      rfl
    have hα_zero : α = 0 := by
      change β * D₀ (φ_N (x_nod 1)) - α * D₁ (φ_N (x_nod 1)) = 0 at hComb_X1
      rw [hD₀ 1, hD₁ 1] at hComb_X1
      simp at hComb_X1
      exact hComb_X1
    have hD₀_zero : D₀ = 0 := hKillDeriv D₀ hα_zero
    have h1_eq_0 : (1 : L) = 0 := by
      have h0 : D₀ (φ_N (x_nod 0)) = 0 := by rw [hD₀_zero]; rfl
      rw [hD₀ 0] at h0
      simp at h0
    exact one_ne_zero h1_eq_0

  
  
  
  
  let I_nod01 : Ideal A_nod := Ideal.span ({x_nod 0, x_nod 1} : Set A_nod)
  have he01_ex : ∃ e01 : k₀ ≃+* (A_nod ⧸ I_nod01),
      e01.toRingHom = (Ideal.Quotient.mk I_nod01).comp c_nod := by
    let f01 : k₀ →+* (A_nod ⧸ I_nod01) := (Ideal.Quotient.mk I_nod01).comp c_nod
    let ev00 : MvPolynomial (Fin 2) k₀ →+* k₀ := MvPolynomial.eval 0
    have hev00_ker : I_nod ≤ RingHom.ker ev00 := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_mul]
      simp [ev00]
    let ev_nod : A_nod →+* k₀ := Ideal.Quotient.lift I_nod ev00 hev00_ker
    have hev_nod_ker : I_nod01 ≤ RingHom.ker ev_nod := by
      rw [Ideal.span_le]
      intro y hy
      rcases Set.mem_insert_iff.mp hy with rfl | hy1
      · change ev00 (MvPolynomial.X 0) = 0; simp [ev00]
      · rw [Set.mem_singleton_iff] at hy1; subst hy1
        change ev00 (MvPolynomial.X 1) = 0; simp [ev00]
    let g01 : (A_nod ⧸ I_nod01) →+* k₀ := Ideal.Quotient.lift I_nod01 ev_nod hev_nod_ker
    have h_left : ∀ c : k₀, g01 (f01 c) = c := fun c => by
      change ev00 (MvPolynomial.C c) = c
      simp [ev00]
    have h_right_hom : f01.comp g01 = RingHom.id (A_nod ⧸ I_nod01) := by
      apply Ideal.Quotient.ringHom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext; intro c; exact congrArg f01 (h_left c)
      · intro i
        change f01 (ev00 (MvPolynomial.X i)) = Ideal.Quotient.mk I_nod01 (x_nod i)
        have hev_i : ev00 (MvPolynomial.X i) = 0 := by simp [ev00]
        rw [hev_i, map_zero]
        symm
        rw [Ideal.Quotient.eq_zero_iff_mem]
        fin_cases i
        · exact Ideal.subset_span (Set.mem_insert _ _)
        · exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    exact ⟨{ f01 with
      invFun := g01
      left_inv := h_left
      right_inv := fun x => RingHom.congr_fun h_right_hom x }, rfl⟩
  obtain ⟨e01, he01⟩ := he01_ex

  have he_br_ex : ∀ i : Fin 2,
      ∃ e_br : Polynomial k₀ ≃+* (A_nod ⧸ Ideal.span ({x_nod i} : Set A_nod)), True := by
    intro i
    let j : Fin 2 := if i = 0 then 1 else 0
    have hj_ne : j ≠ i := by fin_cases i <;> decide
    have hij_cases : ∀ m : Fin 2, m = i ∨ m = j := by
      intro m; fin_cases i <;> fin_cases m <;> decide
    let I_i : Ideal A_nod := Ideal.span ({x_nod i} : Set A_nod)
    let f_br : Polynomial k₀ →+* (A_nod ⧸ I_i) :=
      Polynomial.eval₂RingHom ((Ideal.Quotient.mk I_i).comp c_nod) (Ideal.Quotient.mk I_i (x_nod j))
    let ev_mv : MvPolynomial (Fin 2) k₀ →+* Polynomial k₀ :=
      MvPolynomial.eval₂Hom Polynomial.C (fun m => if m = i then 0 else Polynomial.X)
    have hev_mv_ker : I_nod ≤ RingHom.ker ev_mv := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_mul]
      fin_cases i <;> simp [ev_mv]
    let ev_br_nod : A_nod →+* Polynomial k₀ := Ideal.Quotient.lift I_nod ev_mv hev_mv_ker
    have hev_br_ker : I_i ≤ RingHom.ker ev_br_nod := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      change ev_mv (MvPolynomial.X i) = 0
      simp [ev_mv]
    let g_br : (A_nod ⧸ I_i) →+* Polynomial k₀ := Ideal.Quotient.lift I_i ev_br_nod hev_br_ker
    have h_gf : g_br.comp f_br = RingHom.id (Polynomial k₀) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        have hfC : f_br (Polynomial.C c) = Ideal.Quotient.mk I_i (c_nod c) :=
          Polynomial.eval₂_C _ _
        change g_br (f_br (Polynomial.C c)) = Polynomial.C c
        rw [hfC]
        change ev_mv (MvPolynomial.C c) = Polynomial.C c
        simp [ev_mv]
      · change g_br (f_br Polynomial.X) = Polynomial.X
        have hfX : f_br Polynomial.X = Ideal.Quotient.mk I_i (x_nod j) := by simp [f_br]
        rw [hfX]
        change ev_mv (MvPolynomial.X j) = Polynomial.X
        simp [ev_mv, hj_ne]
    have h_fg : f_br.comp g_br = RingHom.id (A_nod ⧸ I_i) := by
      apply Ideal.Quotient.ringHom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change f_br (ev_mv (MvPolynomial.C c)) = Ideal.Quotient.mk I_i (c_nod c)
        simp [ev_mv, f_br]
      · intro m
        change f_br (ev_mv (MvPolynomial.X m)) = Ideal.Quotient.mk I_i (x_nod m)
        rcases hij_cases m with rfl | rfl
        · simp only [ev_mv, MvPolynomial.eval₂Hom_X', ↓reduceIte, map_zero]
          symm
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        · simp [ev_mv, hj_ne, f_br]
    exact ⟨{ f_br with
      invFun := g_br
      left_inv := fun P => RingHom.congr_fun h_gf P
      right_inv := fun x => RingHom.congr_fun h_fg x }, trivial⟩

  have he_loc_ex : ∀ i : Fin 2,
      ∃ e_loc : Localization.Away (Polynomial.X : Polynomial k₀) ≃+* Localization.Away (x_nod i),
        ∀ c : k₀,
          e_loc (algebraMap (Polynomial k₀) (Localization.Away (Polynomial.X : Polynomial k₀))
            (Polynomial.C c)) =
          algebraMap A_nod (Localization.Away (x_nod i)) (c_nod c) := by
    intro i
    let j : Fin 2 := if i = 0 then 1 else 0
    have hj_ne : j ≠ i := by fin_cases i <;> decide
    have hij_cases : ∀ m : Fin 2, m = i ∨ m = j := by
      intro m; fin_cases i <;> fin_cases m <;> decide
    have h_xij_zero : x_nod i * x_nod j = 0 := by
      have h01_zero : x_nod 0 * x_nod 1 = 0 := by
        rw [← map_mul]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      fin_cases i
      · exact h01_zero
      · dsimp [j]; rw [mul_comm]; exact h01_zero
    let ι_i := algebraMap A_nod (Localization.Away (x_nod i))
    let ι_X := algebraMap (Polynomial k₀) (Localization.Away (Polynomial.X : Polynomial k₀))
    have h_unit_xi : IsUnit (ι_i (x_nod i)) := IsLocalization.Away.algebraMap_isUnit (x_nod i)
    have h_xj_loc_zero : ι_i (x_nod j) = 0 := by
      have h_mul : ι_i (x_nod i) * ι_i (x_nod j) = 0 := by
        rw [← map_mul, h_xij_zero, map_zero]
      exact h_unit_xi.mul_right_eq_zero.mp h_mul
    let Φ_base : Polynomial k₀ →+* Localization.Away (x_nod i) :=
      Polynomial.eval₂RingHom (ι_i.comp c_nod) (ι_i (x_nod i))
    have h_unit_ΦX : IsUnit (Φ_base Polynomial.X) := by
      simpa [Φ_base] using h_unit_xi
    let Φ_i : Localization.Away (Polynomial.X : Polynomial k₀) →+* Localization.Away (x_nod i) :=
      IsLocalization.Away.lift Polynomial.X h_unit_ΦX
    let Ψ_mv : MvPolynomial (Fin 2) k₀ →+* Localization.Away (Polynomial.X : Polynomial k₀) :=
      MvPolynomial.eval₂Hom (ι_X.comp Polynomial.C)
        (fun m => if m = i then ι_X Polynomial.X else 0)
    have hΨ_mv_ker : I_nod ≤ RingHom.ker Ψ_mv := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, map_mul]
      fin_cases i <;> simp [Ψ_mv]
    let Ψ_nod : A_nod →+* Localization.Away (Polynomial.X : Polynomial k₀) :=
      Ideal.Quotient.lift I_nod Ψ_mv hΨ_mv_ker
    have h_unit_Ψxi : IsUnit (Ψ_nod (x_nod i)) := by
      have h_eq : Ψ_nod (x_nod i) = ι_X Polynomial.X := by
        change Ψ_mv (MvPolynomial.X i) = ι_X Polynomial.X
        simp [Ψ_mv]
      rw [h_eq]
      exact IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial k₀)
    let Ψ_i : Localization.Away (x_nod i) →+* Localization.Away (Polynomial.X : Polynomial k₀) :=
      IsLocalization.Away.lift (x_nod i) h_unit_Ψxi
    have h_ΨΦ : Ψ_i.comp Φ_i = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial k₀))
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change Ψ_i (Φ_i (algebraMap (Polynomial k₀) (Localization.Away (Polynomial.X : Polynomial k₀))
          (Polynomial.C c))) = ι_X (Polynomial.C c)
        dsimp only [Φ_i, Ψ_i]
        rw [IsLocalization.Away.lift_eq]
        have h1 : Φ_base (Polynomial.C c) = algebraMap A_nod (Localization.Away (x_nod i)) (c_nod c) :=
          Polynomial.eval₂_C _ _
        rw [h1, IsLocalization.Away.lift_eq]
        change Ψ_mv (MvPolynomial.C c) = ι_X (Polynomial.C c)
        simp [Ψ_mv]
      · change Ψ_i (Φ_i (algebraMap (Polynomial k₀) (Localization.Away (Polynomial.X : Polynomial k₀))
          Polynomial.X)) = ι_X Polynomial.X
        dsimp only [Φ_i, Ψ_i]
        rw [IsLocalization.Away.lift_eq]
        have h1 : Φ_base Polynomial.X = algebraMap A_nod (Localization.Away (x_nod i)) (x_nod i) :=
          Polynomial.eval₂_X _ _
        rw [h1, IsLocalization.Away.lift_eq]
        change Ψ_mv (MvPolynomial.X i) = ι_X Polynomial.X
        simp [Ψ_mv]
    have h_ΦΨ : Φ_i.comp Ψ_i = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (x_nod i))
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change Φ_i (Ψ_i (algebraMap A_nod (Localization.Away (x_nod i))
          (mk_nod (MvPolynomial.C c)))) = ι_i (c_nod c)
        dsimp only [Φ_i, Ψ_i]
        rw [IsLocalization.Away.lift_eq]
        have h1 : Ψ_nod (mk_nod (MvPolynomial.C c)) =
            algebraMap (Polynomial k₀) (Localization.Away (Polynomial.X : Polynomial k₀))
              (Polynomial.C c) := by
          change Ψ_mv (MvPolynomial.C c) = _
          simp [Ψ_mv, ι_X]
        rw [h1, IsLocalization.Away.lift_eq]
        exact Polynomial.eval₂_C _ _
      · intro m
        change Φ_i (Ψ_i (algebraMap A_nod (Localization.Away (x_nod i))
          (mk_nod (MvPolynomial.X m)))) = ι_i (x_nod m)
        dsimp only [Φ_i, Ψ_i]
        rw [IsLocalization.Away.lift_eq]
        rcases hij_cases m with rfl | rfl
        · have h1 : Ψ_nod (mk_nod (MvPolynomial.X m)) =
              algebraMap (Polynomial k₀) (Localization.Away (Polynomial.X : Polynomial k₀))
                Polynomial.X := by
            change Ψ_mv (MvPolynomial.X m) = _
            simp [Ψ_mv, ι_X]
          rw [h1, IsLocalization.Away.lift_eq]
          exact Polynomial.eval₂_X _ _
        · have h1 : Ψ_nod (mk_nod (MvPolynomial.X j)) = 0 := by
            change Ψ_mv (MvPolynomial.X j) = 0
            simp [Ψ_mv, hj_ne]
          rw [h1, map_zero]
          exact h_xj_loc_zero.symm
    refine ⟨{ Φ_i with
      invFun := Ψ_i
      left_inv := fun z => RingHom.congr_fun h_ΨΦ z
      right_inv := fun z => RingHom.congr_fun h_ΦΨ z }, ?_⟩
    intro c
    change Φ_i (algebraMap (Polynomial k₀) (Localization.Away (Polynomial.X : Polynomial k₀))
      (Polynomial.C c)) = ι_i (c_nod c)
    dsimp only [Φ_i]
    rw [IsLocalization.Away.lift_eq]
    exact Polynomial.eval₂_C _ _

  
  have hTransfer : ∀ (B : Type u) [CommRing B] (φ : A_nod →+* B),
      φ.Etale →
      ((Ideal.Quotient.mk (Ideal.span ({φ (x_nod 0), φ (x_nod 1)} : Set B))).comp
        (φ.comp c_nod)).Etale ∧
      (∀ i : Fin 2,
        ∃ θ_i : Polynomial k₀ →+* (B ⧸ Ideal.span ({φ (x_nod i)} : Set B)), θ_i.Etale) ∧
      (∀ i : Fin 2,
        ∃ ψ_sm : Polynomial k₀ →+* Localization.Away (φ (x_nod i)),
          ψ_sm.Etale ∧
          ψ_sm.comp Polynomial.C =
            (algebraMap B (Localization.Away (φ (x_nod i)))).comp (φ.comp c_nod)) := by
    intro B _ φ hφ_et
    letI : Algebra A_nod B := φ.toAlgebra
    haveI : Algebra.Etale A_nod B := RingHom.etale_algebraMap.mpr hφ_et
    have hQuotEt : ∀ (I : Ideal A_nod) (J : Ideal B) (hIJ : Ideal.map φ I = J),
        ∃ f_IJ : (A_nod ⧸ I) →+* (B ⧸ J),
          @RingHom.Etale (A_nod ⧸ I) (B ⧸ J) _ _ f_IJ ∧
          ∀ a : A_nod, f_IJ (Ideal.Quotient.mk I a) = Ideal.Quotient.mk J (φ a) := by
      intro I J hIJ
      haveI : Algebra.Etale (A_nod ⧸ I) (TensorProduct A_nod (A_nod ⧸ I) B) :=
        Algebra.Etale.baseChange A_nod B (A_nod ⧸ I)
      let f_inc : @RingHom (A_nod ⧸ I) (TensorProduct A_nod (A_nod ⧸ I) B)
          (inferInstance : CommRing (A_nod ⧸ I)).toCommSemiring.toSemiring.toNonAssocSemiring
          (inferInstance : CommRing (TensorProduct A_nod (A_nod ⧸ I) B)).toCommSemiring.toSemiring.toNonAssocSemiring :=
        algebraMap (A_nod ⧸ I) (TensorProduct A_nod (A_nod ⧸ I) B)
      have h_inc_et : @RingHom.Etale (A_nod ⧸ I) (TensorProduct A_nod (A_nod ⧸ I) B) _ _ f_inc :=
        RingHom.etale_algebraMap.mpr inferInstance
      let e_tp : TensorProduct A_nod (A_nod ⧸ I) B ≃+* (B ⧸ J) :=
        (Algebra.TensorProduct.comm A_nod (A_nod ⧸ I) B).toRingEquiv.trans
          ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm.toRingEquiv.trans
            (Ideal.quotEquivOfEq hIJ))
      let f_e : @RingHom (TensorProduct A_nod (A_nod ⧸ I) B) (B ⧸ J)
          (inferInstance : CommRing (TensorProduct A_nod (A_nod ⧸ I) B)).toCommSemiring.toSemiring.toNonAssocSemiring
          (inferInstance : CommRing (B ⧸ J)).toCommSemiring.toSemiring.toNonAssocSemiring :=
        { toFun := e_tp
          map_one' := map_one e_tp
          map_mul' := map_mul e_tp
          map_zero' := map_zero e_tp
          map_add' := map_add e_tp }
      have h_e_et : @RingHom.Etale (TensorProduct A_nod (A_nod ⧸ I) B) (B ⧸ J) _ _ f_e :=
        @RingHom.Etale.of_bijective (TensorProduct A_nod (A_nod ⧸ I) B) (B ⧸ J) _ _ f_e e_tp.bijective
      let f_IJ : @RingHom (A_nod ⧸ I) (B ⧸ J)
          (inferInstance : CommRing (A_nod ⧸ I)).toCommSemiring.toSemiring.toNonAssocSemiring
          (inferInstance : CommRing (B ⧸ J)).toCommSemiring.toSemiring.toNonAssocSemiring :=
        f_e.comp f_inc
      have hf_IJ_et : @RingHom.Etale (A_nod ⧸ I) (B ⧸ J) _ _ f_IJ :=
        @RingHom.Etale.stableUnderComposition (A_nod ⧸ I) (TensorProduct A_nod (A_nod ⧸ I) B)
          (B ⧸ J) _ _ _ f_inc f_e h_inc_et h_e_et
      refine ⟨{ toFun := f_IJ
                map_one' := f_IJ.map_one'
                map_mul' := f_IJ.map_mul'
                map_zero' := f_IJ.map_zero'
                map_add' := f_IJ.map_add' },
        hf_IJ_et, ?_⟩
      intro a
      have h_tmul : ((Ideal.Quotient.mk I a : A_nod ⧸ I) ⊗ₜ[A_nod] (1 : B)) =
          (1 : A_nod ⧸ I) ⊗ₜ[A_nod] φ a := by
        have h1 : (Ideal.Quotient.mk I a : A_nod ⧸ I) = a • (1 : A_nod ⧸ I) := by
          change Ideal.Quotient.mk I a = Ideal.Quotient.mk I a * 1
          rw [mul_one]
        calc
          (Ideal.Quotient.mk I a : A_nod ⧸ I) ⊗ₜ[A_nod] (1 : B)
            = (a • (1 : A_nod ⧸ I)) ⊗ₜ[A_nod] (1 : B) := by rw [← h1]
          _ = (1 : A_nod ⧸ I) ⊗ₜ[A_nod] (a • (1 : B)) := by
            rw [TensorProduct.smul_tmul]
          _ = (1 : A_nod ⧸ I) ⊗ₜ[A_nod] φ a := by
            change (1 : A_nod ⧸ I) ⊗ₜ[A_nod] (φ a * 1) = _
            rw [mul_one]
      change (Ideal.quotEquivOfEq hIJ)
        ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm
          ((Algebra.TensorProduct.comm A_nod (A_nod ⧸ I) B)
            ((Ideal.Quotient.mk I a : A_nod ⧸ I) ⊗ₜ[A_nod] (1 : B)))) =
        Ideal.Quotient.mk J (φ a)
      rw [h_tmul, Algebra.TensorProduct.comm_tmul]
      have h_mk := Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk (A := A_nod) B I (φ a)
      have h_symm : (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B I).symm
          (φ a ⊗ₜ[A_nod] (1 : A_nod ⧸ I)) =
          Ideal.Quotient.mk (Ideal.map (algebraMap A_nod B) I) (φ a) := by
        rw [← h_mk, AlgEquiv.symm_apply_apply]
      rw [h_symm]
      rfl
    refine ⟨?_, ?_, ?_⟩
    · 
      have hMap01 : Ideal.map φ I_nod01 = Ideal.span ({φ (x_nod 0), φ (x_nod 1)} : Set B) := by
        dsimp [I_nod01]
        rw [Ideal.map_span, Set.image_pair]
      obtain ⟨f_01, hf_01_et, hf_01_mk⟩ := hQuotEt I_nod01 _ hMap01
      have he01_et : @RingHom.Etale k₀ (A_nod ⧸ I_nod01) _ _ e01.toRingHom :=
        @RingHom.Etale.of_bijective k₀ (A_nod ⧸ I_nod01) _ _ e01.toRingHom e01.bijective
      have h_comp_eq : f_01.comp e01.toRingHom =
          (Ideal.Quotient.mk (Ideal.span ({φ (x_nod 0), φ (x_nod 1)} : Set B))).comp
            (φ.comp c_nod) := by
        rw [he01]
        ext c
        exact hf_01_mk (c_nod c)
      rw [← h_comp_eq]
      exact RingHom.Etale.stableUnderComposition _ _ he01_et hf_01_et
    · 
      intro i
      have hMap_i : Ideal.map φ (Ideal.span ({x_nod i} : Set A_nod)) =
          Ideal.span ({φ (x_nod i)} : Set B) := by
        rw [Ideal.map_span, Set.image_singleton]
      obtain ⟨f_i, hf_i_et, _⟩ := hQuotEt (Ideal.span ({x_nod i} : Set A_nod)) _ hMap_i
      obtain ⟨e_br, _⟩ := he_br_ex i
      have he_br_et : @RingHom.Etale (Polynomial k₀) (A_nod ⧸ Ideal.span ({x_nod i} : Set A_nod)) _ _
          e_br.toRingHom :=
