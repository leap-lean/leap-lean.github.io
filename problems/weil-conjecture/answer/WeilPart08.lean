theorem weil_unstable_generic_p1_closure_reduced_nodal_and_boundary_lift (R : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [HenselianLocalRing R]
    [Finite (PrimeSpectrum R)]
    (hMaxR : IsLocalRing.maximalIdeal R ≠ ⊥)
    (K_R : Type u) [Field K_R] [IsAlgClosed K_R] [Algebra R K_R] [IsFractionRing R K_R]
    (hAlgRes : IsAlgClosed (IsLocalRing.ResidueField R))
    (M : ℕ)
    (C_R : AlgebraicGeometry.Scheme.{u})
    (g_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    (n : ℕ) (h3n : 3 ≤ n)
    (τ_R : Fin n → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ C_R))
    (ι_PR : C_R ⟶ (weilProjectiveSpaceOver R M).left)
    (hClPR : AlgebraicGeometry.IsClosedImmersion ι_PR)
    (hCommPR : ι_PR ≫ (weilProjectiveSpaceOver R M).hom = g_R)
    (hFlatR : AlgebraicGeometry.Flat g_R)
    (hPropR : AlgebraicGeometry.IsProper g_R)
    (hLFPR : AlgebraicGeometry.LocallyOfFinitePresentation g_R)
    (hSurjR : AlgebraicGeometry.Surjective g_R)
    (hSecR : ∀ j : Fin n, τ_R j ≫ g_R = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)))
    (hDisjR : _root_.Pairwise fun i j : Fin n =>
      Disjoint (Set.range (τ_R i).base) (Set.range (τ_R j).base))
    (hSmSecR : ∀ (j : Fin n) (b : AlgebraicGeometry.Spec (CommRingCat.of R)),
      ∃ V_sm : C_R.Opens,
        (τ_R j).base b ∈ V_sm ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1 (V_sm.ι ≫ g_R))
    (hGeomR : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of R)),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback g_R s) ∧
      ∀ y : ↥(CategoryTheory.Limits.pullback g_R s),
        HasSpreadSmoothOrNodalAt (CategoryTheory.Limits.pullback.snd g_R s) y)
    (hEtDom : ∀ (A₀ B : Type u) [CommRing A₀] [IsDomain A₀] [IsIntegrallyClosed A₀]
        [CommRing B] [Algebra A₀ B] [Algebra.Etale A₀ B]
        (q : PrimeSpectrum B),
      ∃ g : B, g ∉ q.asIdeal ∧ IsDomain (Localization.Away g))
    (hSmLift : ∀ (y₀ : ↥(CategoryTheory.Limits.pullback g_R
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))),
      (∃ V₀ : (CategoryTheory.Limits.pullback g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).Opens,
        y₀ ∈ V₀ ∧ AlgebraicGeometry.SmoothOfRelativeDimension 1
          (V₀.ι ≫ CategoryTheory.Limits.pullback.snd g_R
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))))) →
      ∃ W_sm : C_R.Opens,
        (CategoryTheory.Limits.pullback.fst g_R
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).base y₀ ∈ W_sm ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm.ι ≫ g_R))
    (hEtSec : ∀ (U : AlgebraicGeometry.Scheme.{u})
        (f : U ⟶ AlgebraicGeometry.Spec (CommRingCat.of R)),
      AlgebraicGeometry.Etale f →
      ∀ (u₀ : U),
        (f.base u₀).asIdeal = IsLocalRing.maximalIdeal R →
        ∃ (σ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ U),
          σ ≫ f = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) ∧
          ∀ b : AlgebraicGeometry.Spec (CommRingCat.of R),
            b.asIdeal = IsLocalRing.maximalIdeal R → σ.base b = u₀)
    (hP1Conn : ∀ (E_bar : AlgebraicGeometry.Scheme.{u})
        (ι_bar : E_bar ⟶ (weilProjectiveSpaceOver R M).left),
      AlgebraicGeometry.IsClosedImmersion ι_bar →
      AlgebraicGeometry.IsIntegral E_bar →
      (∃ isoP1 :
          CategoryTheory.Limits.pullback
            (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) ≅
          (weilProjectiveSpaceOver K_R 1).left,
        CategoryTheory.Limits.pullback.snd
            (ι_bar ≫ (weilProjectiveSpaceOver R M).hom)
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R K_R))) =
          isoP1.hom ≫ (weilProjectiveSpaceOver K_R 1).hom) →
