        exact CategoryTheory.epi_of_epi (CategoryTheory.Limits.cokernel.π v₀_U) d_right
      have _ : CategoryTheory.IsIso d_right := CategoryTheory.isIso_of_mono_of_epi d_right

      let e_cok : CategoryTheory.Limits.cokernel v₀_Y ≅ CategoryTheory.Limits.cokernel v₀_U :=
        CategoryTheory.Limits.cokernel.mapIso v₀_Y v₀_U (Φ₀.app I) (Φ₀.app Q) (Φ₀.hom.naturality v)
      exact ⟨(CategoryTheory.asIso d_left).symm ≪≫ e_cok ≪≫ CategoryTheory.asIso d_right⟩

    have hPos : ∀ (k : ℕ) (G : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}),
