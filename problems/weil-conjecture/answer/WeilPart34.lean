  have hStdChartOfSection : ∀ (K : Type u) [Field K]
      (s : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ P_base.left),
      ∃ (ι_chart : U₀ ⟶ P_base.left) (_ : AlgebraicGeometry.IsOpenImmersion ι_chart)
        (φ_s : Polynomial k →+* K),
        ι_chart ≫ P_base.hom = p_A1 ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_s) ≫ ι_chart = s := by
    intro K _ s
    obtain ⟨_, ι_aff, hOpen_aff, ψ_s, hι_hom, hψ_fac⟩ :=
      weil_projSpace_standard_affine_chart_and_isSeparated k 1 K (s ≫ e_P.hom.left)
    let e_alg : MvPolynomial (Fin 1) k ≃ₐ[k] Polynomial k := MvPolynomial.uniqueAlgEquiv k (Fin 1)
    let r₁ : MvPolynomial (Fin 1) k →+* Polynomial k := e_alg.toAlgHom.toRingHom
    let r₂ : Polynomial k →+* MvPolynomial (Fin 1) k := e_alg.symm.toAlgHom.toRingHom
    have hr₁₂ : r₁.comp r₂ = RingHom.id _ := RingHom.ext e_alg.apply_symm_apply
    have hr₂₁ : r₂.comp r₁ = RingHom.id _ := RingHom.ext e_alg.symm_apply_apply
    let f_iso : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) k)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₁)
    let g_iso : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) k)) ⟶ U₀ :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom r₂)
    have _ : CategoryTheory.IsIso f_iso :=
      ⟨⟨g_iso,
        by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hr₁₂,
             CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
        by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hr₂₁,
             CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
    have _ : AlgebraicGeometry.IsOpenImmersion ι_aff := hOpen_aff
    let ι_chart : U₀ ⟶ P_base.left := f_iso ≫ ι_aff ≫ e_P_left.inv
    have hOpen_chart : AlgebraicGeometry.IsOpenImmersion ι_chart := by
      dsimp [ι_chart]; infer_instance
    let φ_s : Polynomial k →+* K := ψ_s.comp r₂
    refine ⟨ι_chart, hOpen_chart, φ_s, ?_, ?_⟩
    · dsimp [ι_chart, f_iso, e_P_left, p_A1]
      rw [Category.assoc, Category.assoc, e_P.inv.w, hι_hom,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      exact e_alg.commutes c
    · change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_s.comp r₂)) ≫
          (f_iso ≫ ι_aff ≫ e_P_left.inv) = s
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
      have hg_f : g_iso ≫ f_iso = 𝟙 _ := by
        dsimp [g_iso, f_iso]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hr₂₁,
          CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫
              (g_iso ≫ (f_iso ≫ ι_aff ≫ e_P_left.inv))
          = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫
              ((g_iso ≫ f_iso) ≫ ι_aff ≫ e_P_left.inv) := by rw [Category.assoc]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_s) ≫ ι_aff) ≫ e_P_left.inv := by
              rw [hg_f, Category.id_comp, Category.assoc]
        _ = (s ≫ e_P_left.hom) ≫ e_P_left.inv := by rw [hψ_fac]; rfl
        _ = s := by rw [Category.assoc, e_P_left.hom_inv_id, Category.comp_id]

  have hGenMemOpen : ∀ (ι_chart : U₀ ⟶ P_base.left) [AlgebraicGeometry.IsOpenImmersion ι_chart],
