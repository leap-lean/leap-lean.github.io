      f_ab.hom.Etale → g_bc.hom.Etale →
      (CategoryTheory.CategoryStruct.comp f_ab g_bc).hom.Etale := by
    intro R_a R_b R_c f_ab g_bc hf hg
    haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f_ab) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
    haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g_bc) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg
    have hEt : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f_ab ≫ g_bc)) := by
      rw [AlgebraicGeometry.Spec.map_comp]
      infer_instance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt

  have hEtale_pushout : ∀ {A₀ B₀ C₀ P₀ : CommRingCat.{u}}
      {f : Quiver.Hom A₀ B₀} {g : Quiver.Hom A₀ C₀}
      {inl : Quiver.Hom B₀ P₀} {inr : Quiver.Hom C₀ P₀},
      CategoryTheory.IsPushout f g inl inr →
      (f.hom.Etale → inr.hom.Etale) ∧ (g.hom.Etale → inl.hom.Etale) := by
    intro A₀ B₀ C₀ P₀ f g inl inr hp
    have hpb := AlgebraicGeometry.isPullback_SpecMap_of_isPushout f g inl inr hp
    refine ⟨fun hf => ?_, fun hg => ?_⟩
    · have hf_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
      have hinr_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map inr) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb hf_et
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hinr_et
    · have hg_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hg
      have hinl_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map inl) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hg_et
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hinl_et

  have hEtale_of_comp : ∀ {R_a R_b R_c : CommRingCat.{u}}
      (f_ab : Quiver.Hom R_a R_b) (g_bc : Quiver.Hom R_b R_c),
      f_ab.hom.Etale → (CategoryTheory.CategoryStruct.comp f_ab g_bc).hom.Etale →
      g_bc.hom.Etale := by
    intro R_a R_b R_c f_ab g_bc hf hfg
    have hf_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f_ab) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
    have hfg_et : AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map g_bc) (AlgebraicGeometry.Spec.map f_ab)) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hfg
    have hg_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g_bc) :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale)
        (AlgebraicGeometry.Spec.map g_bc) (AlgebraicGeometry.Spec.map f_ab) hf_et hfg_et
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hg_et

  
  have hPolyPushout : ∀ {R_a S_a : Type u} [CommRing R_a] [CommRing S_a] (g : R_a →+* S_a),
      CategoryTheory.IsPushout
        (CommRingCat.ofHom (Polynomial.C : R_a →+* Polynomial R_a))
        (CommRingCat.ofHom g)
        (CommRingCat.ofHom (Polynomial.mapRingHom g))
        (CommRingCat.ofHom (Polynomial.C : S_a →+* Polynomial S_a)) := by
    intro R_a S_a _ _ g
    have hcomm :
        CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom (Polynomial.C : R_a →+* Polynomial R_a))
          (CommRingCat.ofHom (Polynomial.mapRingHom g)) =
        CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom g)
          (CommRingCat.ofHom (Polynomial.C : S_a →+* Polynomial S_a)) := by
      apply CommRingCat.hom_ext; ext r; simp
    exact CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom
          (Polynomial.eval₂RingHom s.inr.hom (s.inl.hom Polynomial.X)))
        (fun s => by
          apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · ext r
            have h := congrArg (fun k => k.hom r) s.condition
            simpa using h.symm
          · simp)
        (fun s => by apply CommRingCat.hom_ext; ext x; simp)
        (fun s m hm₁ hm₂ => by
          apply CommRingCat.hom_ext
          apply Polynomial.ringHom_ext'
          · ext x
            have h := congrArg (fun k => k.hom x) hm₂
            simpa using h
          · have h := congrArg (fun k => k.hom Polynomial.X) hm₁
            simpa using h))

  have hAwayPushout : ∀ {R_a S_a : Type u} [CommRing R_a] [CommRing S_a]
      (x : R_a) (g : R_a →+* S_a),
      CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap R_a (Localization.Away x)))
        (CommRingCat.ofHom g)
        (CommRingCat.ofHom (Localization.awayMap g x))
        (CommRingCat.ofHom (algebraMap S_a (Localization.Away (g x)))) := by
    intro R_a S_a _ _ x g
    have hcomm :
        CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom (algebraMap R_a (Localization.Away x)))
          (CommRingCat.ofHom (Localization.awayMap g x)) =
        CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom g)
          (CommRingCat.ofHom (algebraMap S_a (Localization.Away (g x)))) := by
      apply CommRingCat.hom_ext; ext r
      exact IsLocalization.Away.lift_eq x (IsLocalization.Away.algebraMap_isUnit (g x)) r
    have hUnit_s : ∀ s : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom (algebraMap R_a (Localization.Away x))) (CommRingCat.ofHom g),
        IsUnit (s.inr.hom (g x)) := by
      intro s
      have hx : s.inr.hom (g x) = s.inl.hom (algebraMap R_a (Localization.Away x) x) :=
        (congrArg (fun k => k.hom x) s.condition).symm
      rw [hx]
      exact (IsLocalization.Away.algebraMap_isUnit x).map s.inl.hom
    exact CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom (IsLocalization.Away.lift (g x) (hUnit_s s)))
        (fun s => by
          apply CommRingCat.hom_ext
          refine IsLocalization.ringHom_ext (Submonoid.powers x) ?_
          ext r
          have h := congrArg (fun k => k.hom r) s.condition
          have haw : Localization.awayMap g x (algebraMap R_a (Localization.Away x) r) =
              algebraMap S_a (Localization.Away (g x)) (g r) :=
            IsLocalization.Away.lift_eq x (IsLocalization.Away.algebraMap_isUnit (g x)) r
          change IsLocalization.Away.lift (g x) (hUnit_s s)
              (Localization.awayMap g x (algebraMap R_a (Localization.Away x) r)) =
            s.inl.hom (algebraMap R_a (Localization.Away x) r)
          rw [haw, IsLocalization.Away.lift_eq (g x) (hUnit_s s) (g r)]
          exact h.symm)
        (fun s => by
          apply CommRingCat.hom_ext; ext y
          exact IsLocalization.Away.lift_eq (g x) (hUnit_s s) y)
        (fun s m _ hm₂ => by
          apply CommRingCat.hom_ext
          refine IsLocalization.ringHom_ext (Submonoid.powers (g x)) ?_
          ext y
          have h := congrArg (fun k => k.hom y) hm₂
          change m.hom (algebraMap S_a (Localization.Away (g x)) y) =
            IsLocalization.Away.lift (g x) (hUnit_s s) (algebraMap S_a (Localization.Away (g x)) y)
          rw [IsLocalization.Away.lift_eq (g x) (hUnit_s s) y]
          exact h))

  
  have hUnderPushoutColim :
      ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
        [CategoryTheory.Limits.HasPushouts 𝒞]
        (ℐ₀ : Type u) [CategoryTheory.SmallCategory ℐ₀] [CategoryTheory.IsFiltered ℐ₀]
        (B : CategoryTheory.Functor ℐ₀ 𝒞)
        (c₀ : CategoryTheory.Limits.Cocone B) (_ : CategoryTheory.Limits.IsColimit c₀)
        (i₀ : ℐ₀) (E₀ E_inf : 𝒞)
        (f_E₀ : Quiver.Hom (B.obj i₀) E₀)
        (f_inf : Quiver.Hom c₀.pt E_inf)
        (g₀ : Quiver.Hom E₀ E_inf),
        CategoryTheory.IsPushout (c₀.ι.app i₀) f_E₀ f_inf g₀ →
        ∃ (E_diag : CategoryTheory.Functor (CategoryTheory.Under i₀) 𝒞)
          (inl_u : ∀ u : CategoryTheory.Under i₀, Quiver.Hom (B.obj u.right) (E_diag.obj u))
          (inr_u : ∀ u : CategoryTheory.Under i₀, Quiver.Hom E₀ (E_diag.obj u))
          (c_E : CategoryTheory.Limits.Cocone E_diag)
          (_ : CategoryTheory.Limits.IsColimit c_E)
          (e_E : CategoryTheory.Iso c_E.pt E_inf),
          (∀ u : CategoryTheory.Under i₀,
            CategoryTheory.IsPushout (B.map u.hom) f_E₀ (inl_u u) (inr_u u)) ∧
          (∀ {u₁ u₂ : CategoryTheory.Under i₀} (φ : Quiver.Hom u₁ u₂),
            CategoryTheory.CategoryStruct.comp (inl_u u₁) (E_diag.map φ) =
              CategoryTheory.CategoryStruct.comp (B.map φ.right) (inl_u u₂)) ∧
          (∀ u : CategoryTheory.Under i₀,
            CategoryTheory.CategoryStruct.comp (inl_u u)
              (CategoryTheory.CategoryStruct.comp (c_E.ι.app u) e_E.hom) =
              CategoryTheory.CategoryStruct.comp (c₀.ι.app u.right) f_inf) := by
    intro 𝒞 _ _ ℐ₀ _ _ B c₀ hc₀ i₀ E₀ E_inf f_E₀ f_inf g₀ hp₀
    let obj_u : CategoryTheory.Under i₀ → 𝒞 :=
      fun u => CategoryTheory.Limits.pushout (B.map u.hom) f_E₀
    let inl_u : ∀ u : CategoryTheory.Under i₀, B.obj u.right ⟶ obj_u u :=
      fun u => CategoryTheory.Limits.pushout.inl (B.map u.hom) f_E₀
    let inr_u : ∀ u : CategoryTheory.Under i₀, E₀ ⟶ obj_u u :=
      fun u => CategoryTheory.Limits.pushout.inr (B.map u.hom) f_E₀
    let map_u : ∀ {u₁ u₂ : CategoryTheory.Under i₀}, (u₁ ⟶ u₂) → (obj_u u₁ ⟶ obj_u u₂) :=
      fun {u₁ u₂} φ =>
        CategoryTheory.Limits.pushout.desc
          (B.map φ.right ≫ inl_u u₂) (inr_u u₂)
          (by
            rw [← CategoryTheory.Category.assoc, ← B.map_comp, CategoryTheory.Under.w φ]
            exact CategoryTheory.Limits.pushout.condition)
    have hmap_inl : ∀ {u₁ u₂ : CategoryTheory.Under i₀} (φ : u₁ ⟶ u₂),
        inl_u u₁ ≫ map_u φ = B.map φ.right ≫ inl_u u₂ :=
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _
    have hmap_inr : ∀ {u₁ u₂ : CategoryTheory.Under i₀} (φ : u₁ ⟶ u₂),
        inr_u u₁ ≫ map_u φ = inr_u u₂ :=
      fun _ => CategoryTheory.Limits.pushout.inr_desc _ _ _
    let E_diag : CategoryTheory.Functor (CategoryTheory.Under i₀) 𝒞 :=
      { obj := obj_u
        map := fun φ => map_u φ
        map_id := fun u => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [hmap_inl, CategoryTheory.Category.comp_id]
            have hid : (𝟙 u : u ⟶ u).right = 𝟙 u.right := rfl
            rw [hid, B.map_id, CategoryTheory.Category.id_comp]
          · rw [hmap_inr, CategoryTheory.Category.comp_id]
        map_comp := fun {u₁ u₂ u₃} φ₁ φ₂ => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [hmap_inl, ← CategoryTheory.Category.assoc, hmap_inl,
              CategoryTheory.Category.assoc, hmap_inl, ← CategoryTheory.Category.assoc,
              ← B.map_comp]
            rfl
          · rw [hmap_inr, ← CategoryTheory.Category.assoc, hmap_inr, hmap_inr] }
    let app_u : ∀ u : CategoryTheory.Under i₀, obj_u u ⟶ E_inf :=
      fun u =>
        CategoryTheory.Limits.pushout.desc (c₀.ι.app u.right ≫ f_inf) g₀
          (by
            rw [← CategoryTheory.Category.assoc, c₀.w u.hom]
            exact hp₀.w)
    have happ_inl : ∀ u : CategoryTheory.Under i₀,
        inl_u u ≫ app_u u = c₀.ι.app u.right ≫ f_inf :=
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _
    have happ_inr : ∀ u : CategoryTheory.Under i₀,
        inr_u u ≫ app_u u = g₀ :=
      fun _ => CategoryTheory.Limits.pushout.inr_desc _ _ _
    let c_E : CategoryTheory.Limits.Cocone E_diag :=
      { pt := E_inf
        ι :=
          { app := app_u
            naturality := fun {u₁ u₂} φ => by
              dsimp [E_diag]
              rw [CategoryTheory.Category.comp_id]
              apply CategoryTheory.Limits.pushout.hom_ext
              · rw [← CategoryTheory.Category.assoc, hmap_inl,
                  CategoryTheory.Category.assoc, happ_inl, happ_inl,
                  ← CategoryTheory.Category.assoc, c₀.w φ.right]
              · rw [← CategoryTheory.Category.assoc, hmap_inr, happ_inr, happ_inr] } }
    let hc_w : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.Cocone.whisker (CategoryTheory.Under.forget i₀) c₀) :=
      (CategoryTheory.Functor.Final.isColimitWhiskerEquiv
        (CategoryTheory.Under.forget i₀) c₀).symm hc₀
    let u₀ : CategoryTheory.Under i₀ := CategoryTheory.Under.mk (𝟙 i₀)
    let s_B_of : ∀ s : CategoryTheory.Limits.Cocone E_diag,
        CategoryTheory.Limits.Cocone
          (CategoryTheory.Functor.comp (CategoryTheory.Under.forget i₀) B) :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun u => inl_u u ≫ s.ι.app u
              naturality := fun {u₁ u₂} φ => by
                dsimp
                rw [CategoryTheory.Category.comp_id, ← s.w φ]
                dsimp [E_diag]
                rw [← CategoryTheory.Category.assoc, ← hmap_inl φ,
                  CategoryTheory.Category.assoc] } }
    have h_span : ∀ s : CategoryTheory.Limits.Cocone E_diag,
        c₀.ι.app i₀ ≫ hc_w.desc (s_B_of s) = f_E₀ ≫ (inr_u u₀ ≫ s.ι.app u₀) := by
      intro s
      have h1 : c₀.ι.app i₀ ≫ hc_w.desc (s_B_of s) = inl_u u₀ ≫ s.ι.app u₀ :=
        hc_w.fac (s_B_of s) u₀
      rw [h1]
      have hcond : B.map u₀.hom ≫ inl_u u₀ = f_E₀ ≫ inr_u u₀ :=
        CategoryTheory.Limits.pushout.condition
      have hid : B.map u₀.hom = 𝟙 (B.obj i₀) := B.map_id i₀
      rw [hid, CategoryTheory.Category.id_comp] at hcond
      rw [← CategoryTheory.Category.assoc, ← hcond]
    let d_of : ∀ s : CategoryTheory.Limits.Cocone E_diag, E_inf ⟶ s.pt :=
      fun s =>
        hp₀.isColimit.desc
          (CategoryTheory.Limits.PushoutCocone.mk
            (hc_w.desc (s_B_of s)) (inr_u u₀ ≫ s.ι.app u₀) (h_span s))
    have hd_inl : ∀ s : CategoryTheory.Limits.Cocone E_diag,
        f_inf ≫ d_of s = hc_w.desc (s_B_of s) :=
      fun s => hp₀.isColimit.fac _ CategoryTheory.Limits.WalkingSpan.left
    have hd_inr : ∀ s : CategoryTheory.Limits.Cocone E_diag,
        g₀ ≫ d_of s = inr_u u₀ ≫ s.ι.app u₀ :=
      fun s => hp₀.isColimit.fac _ CategoryTheory.Limits.WalkingSpan.right
    let hc_E : CategoryTheory.Limits.IsColimit c_E :=
      { desc := fun s => d_of s
        fac := fun s u => by
          change app_u u ≫ d_of s = s.ι.app u
          apply CategoryTheory.Limits.pushout.hom_ext
          · change inl_u u ≫ (app_u u ≫ d_of s) = inl_u u ≫ s.ι.app u
            rw [← CategoryTheory.Category.assoc, happ_inl, CategoryTheory.Category.assoc,
              hd_inl s]
            exact hc_w.fac (s_B_of s) u
          · change inr_u u ≫ (app_u u ≫ d_of s) = inr_u u ≫ s.ι.app u
            rw [← CategoryTheory.Category.assoc, happ_inr, hd_inr s]
            let φ_u : u₀ ⟶ u := CategoryTheory.Under.homMk u.hom
              (CategoryTheory.Category.id_comp u.hom)
            have hnat := s.w φ_u
            dsimp [E_diag] at hnat
            rw [← hnat, ← CategoryTheory.Category.assoc, hmap_inr]
        uniq := fun s m hm => by
          change m = d_of s
          have hf_m : f_inf ≫ m = f_inf ≫ d_of s := by
            rw [hd_inl s]
            apply hc_w.hom_ext
            intro u
            rw [hc_w.fac]
            change c₀.ι.app u.right ≫ (f_inf ≫ m) = inl_u u ≫ s.ι.app u
            rw [← CategoryTheory.Category.assoc, ← happ_inl u,
              CategoryTheory.Category.assoc, hm u]
          have hg_m : g₀ ≫ m = g₀ ≫ d_of s := by
            rw [hd_inr s, ← hm u₀, ← CategoryTheory.Category.assoc, happ_inr]
          apply hp₀.isColimit.hom_ext
          rintro (_ | (_ | _))
          · change (c₀.ι.app i₀ ≫ f_inf) ≫ m = (c₀.ι.app i₀ ≫ f_inf) ≫ d_of s
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hf_m]
          · exact hf_m
          · exact hg_m }
    exact ⟨E_diag, inl_u, inr_u, c_E, hc_E, CategoryTheory.Iso.refl E_inf,
      fun u => CategoryTheory.IsPushout.of_hasPushout (B.map u.hom) f_E₀,
      fun φ => hmap_inl φ,
      fun u => by
        change inl_u u ≫ (app_u u ≫ 𝟙 E_inf) = _
        rw [CategoryTheory.Category.comp_id, happ_inl]⟩

  
