        exact CategoryTheory.epi_of_epi (CategoryTheory.Limits.cokernel.π v₀_Y) d_left
      have _ : CategoryTheory.IsIso d_left := CategoryTheory.isIso_of_mono_of_epi d_left

      obtain ⟨δ_U, hcomp₁_U, _, hEx₁_U, hEx₂_U⟩ := hConnPre_U SC' hSE' 0
      have hRu1_zero : (CP_U 1).map SC'.f = 0 := (hInjZero_U (R_gU.obj I) 0).eq_of_tgt _ 0
      have _ : CategoryTheory.Epi δ_U := hEx₂_U.epi_f hRu1_zero
      let v₀_U := (CP_U 0).map (R_gU.map v)
      let d_right := CategoryTheory.Limits.cokernel.desc v₀_U δ_U hcomp₁_U
      have _ : CategoryTheory.Mono d_right :=
