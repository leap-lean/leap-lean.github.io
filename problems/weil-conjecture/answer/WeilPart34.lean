        rw [a₂.homEquiv_naturality_left, a₁.homEquiv_naturality_left, Category.assoc]
      let η : ∀ X : 𝒟₁, X ⟶ F₂.obj (F₁.obj X) := fun X => Φ X (F₂.obj (F₁.obj X)) (𝟙 _)
