            haveI : CategoryTheory.IsIso ((pb_of i_tilde).map ρ_inf) := hIso_pb_ρ
            rw [h_eq]
            exact CategoryTheory.IsIso.comp_isIso
          exact ⟨hz_X1, hIso_g⟩
      have hKz_zero :
          CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel K_z.f) ∧
          CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel K_z.g) ∧
          CategoryTheory.Limits.IsZero K_z.homology := by
        rcases hCases with ⟨hIso_f, hz_X3⟩ | ⟨hz_X1, hIso_g⟩
        · haveI : CategoryTheory.IsIso K_z.f := hIso_f
          have hKer : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel K_z.f) :=
            (CategoryTheory.Preadditive.mono_iff_isZero_kernel K_z.f).mp inferInstance
          have hg0 : K_z.g = 0 := hz_X3.eq_of_tgt _ _
          haveI : CategoryTheory.Epi K_z.g := ⟨fun _ _ _ => hz_X3.eq_of_src _ _⟩
          have hCoker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel K_z.g) :=
            (CategoryTheory.Preadditive.epi_iff_isZero_cokernel K_z.g).mp inferInstance
          have hEx : K_z.Exact := (CategoryTheory.ShortComplex.exact_iff_epi K_z hg0).mpr inferInstance
          exact ⟨hKer, hCoker, (CategoryTheory.ShortComplex.exact_iff_isZero_homology K_z).mp hEx⟩
        · haveI : CategoryTheory.IsIso K_z.g := hIso_g
          have hf0 : K_z.f = 0 := hz_X1.eq_of_src _ _
          haveI : CategoryTheory.Mono K_z.f := ⟨fun _ _ _ => hz_X1.eq_of_tgt _ _⟩
          have hKer : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel K_z.f) :=
            (CategoryTheory.Preadditive.mono_iff_isZero_kernel K_z.f).mp inferInstance
          have hCoker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel K_z.g) :=
            (CategoryTheory.Preadditive.epi_iff_isZero_cokernel K_z.g).mp inferInstance
          have hEx : K_z.Exact := (CategoryTheory.ShortComplex.exact_iff_mono K_z hf0).mpr inferInstance
          exact ⟨hKer, hCoker, (CategoryTheory.ShortComplex.exact_iff_isZero_homology K_z).mp hEx⟩
      exact ⟨CategoryTheory.Limits.IsZero.of_iso hKz_zero.1
          (CategoryTheory.Limits.PreservesKernel.iso (pb_of z_bar) ι_open),
        CategoryTheory.Limits.IsZero.of_iso hKz_zero.2.1
          (CategoryTheory.Limits.PreservesCokernel.iso (pb_of z_bar) ρ_inf),
        CategoryTheory.Limits.IsZero.of_iso hKz_zero.2.2
          (SC.mapHomologyIso (pb_of z_bar)).symm⟩
    have hSub_of_isZero_Sk : ∀ (G : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Limits.IsZero G → Subsingleton ↑(G.obj.obj (Opposite.op T_k)) := by
      intro G hZ
      have hid0 : 𝟙 (G.obj.obj (Opposite.op T_k)) = 0 := by
        have h1 : 𝟙 G = 0 := hZ.eq_of_src _ _
        exact congrArg (fun m : G ⟶ G => m.hom.app (Opposite.op T_k)) h1
      exact ⟨fun x y => by
        let A_Tk := G.obj.obj (Opposite.op T_k)
        have hx : x = 0 := congrArg (fun m : A_Tk ⟶ A_Tk => m.hom x) hid0
        have hy : y = 0 := congrArg (fun m : A_Tk ⟶ A_Tk => m.hom y) hid0
        exact hx.trans hy.symm⟩
    have hCons := (weil_algClosed_locallyFiniteType_kpoint_stalk_conservative k
      (@hc_all) (@hr_all) (@hLim_all) (@hAdd_all) P_succ P_succ_ov.hom).1
    have hZero_ker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel ι_open) :=
      hCons _ (fun z_bar hz_bar => hSub_of_isZero_Sk _ (hPointwise z_bar hz_bar).1)
    have hZero_coker : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel ρ_inf) :=
      hCons _ (fun z_bar hz_bar => hSub_of_isZero_Sk _ (hPointwise z_bar hz_bar).2.1)
    have hZero_hom : CategoryTheory.Limits.IsZero SC.homology :=
      hCons _ (fun z_bar hz_bar => hSub_of_isZero_Sk _ (hPointwise z_bar hz_bar).2.2)
    exact ⟨h0,
      { exact := (CategoryTheory.ShortComplex.exact_iff_isZero_homology SC).mpr hZero_hom
        mono_f := (CategoryTheory.Preadditive.mono_iff_isZero_kernel ι_open).mpr hZero_ker
        epi_g := (CategoryTheory.Preadditive.epi_iff_isZero_cokernel ρ_inf).mpr hZero_coker }⟩
  obtain ⟨h0, hSE⟩ := hPillar3
  exact ⟨S_inf, ι_open, ρ_inf, h0, hSE, hIso0, hz_Sinf⟩

theorem weil_polyP1_baseChange_localTorsion_higherDirectImage_iso (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (δ : ℕ)
    (V : (weilPolyP1Over k δ).left.Etale)
    [AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left] :
    let π_δ := CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
      (weilProjectiveSpaceOver k 1).hom
    let V_top := (weilEtaleSitePullback π_δ).obj V
    let L_V := weilEtaleLocalTorsionSheaf (weilPolyP1Over k δ).left ℓ V
    let L_Vtop := weilEtaleLocalTorsionSheaf (weilPolyP1Over k (δ + 1)).left ℓ V_top
    CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π_δ 1 L_Vtop) ∧
    (∀ b : ℕ, 3 ≤ b → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π_δ b L_Vtop)) ∧
    Nonempty (weilEtaleHigherDirectImage π_δ 2 L_Vtop ≅ L_V) :=
by
  intro π_δ V_top L_V L_Vtop
  have hPrime : Nat.Prime ℓ := Fact.out
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
  let hT_k : CategoryTheory.Limits.IsTerminal T_k := weilEtaleIdTerminalIsTerminal.{u} S_k
  let P_δ := weilPolyP1Over k δ
  let Pd : AlgebraicGeometry.Scheme.{u} := P_δ.left
  let P_1 := weilProjectiveSpaceOver k 1
  let P1 : AlgebraicGeometry.Scheme.{u} := P_1.left
  let P_succ_ov := weilPolyP1Over k (δ + 1)
  let P_succ : AlgebraicGeometry.Scheme.{u} := P_succ_ov.left
  let ρ_δ : P_succ ⟶ P1 := CategoryTheory.Limits.pullback.snd P_δ.hom P_1.hom
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : ℕ → AddCommGrpCat.{u} :=
    fun m => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))

  
  obtain ⟨ι_P1_std, _ι_aff_std, hPropP1, hIntP1, hProjP1, hSmP1, hOpen_ι, hComp_ι,
      ⟨s_inf_std, _, hs_hom_std, hDisj_std, hCov_std, _⟩, _, hPoly_all⟩ :=
    weil_polyP1_coord_compactification_and_properness k
  letI : AlgebraicGeometry.IsProper P_1.hom := hPropP1
  letI : AlgebraicGeometry.IsIntegral P1 := hIntP1
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 P_1.hom := hSmP1
  letI : AlgebraicGeometry.IsProper P_δ.hom := (hPoly_all δ).1
  have hProp_πδ : AlgebraicGeometry.IsProper π_δ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback P_δ.hom P_1.hom).flip hPropP1

  have h_fy_comp : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      {X : C} {M : AddCommGrpCat.{u}} {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (α : CategoryTheory.Sheaf.freeYoneda J X M ⟶ F) (f : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ f) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ f.hom.app (Opposite.op X) := by
    intro C _ J _ X M F G α f
    exact (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
      ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv_naturality_right α f)).trans
      (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)

  have hAM_tor : ℓ • (𝟙 (AM ℓ) : AM ℓ ⟶ AM ℓ) = 0 := by
    ext ⟨x⟩
    change ULift.up (ℓ • x) = ULift.up 0
    congr 1
    simp

  have hTor_const : ∀ Z : AlgebraicGeometry.Scheme.{u},
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z ℓ) = 0 := fun Z => by
    let J := Z.smallEtaleTopology
    change ℓ • (𝟙 ((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj (AM ℓ))) = 0
    rw [← (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).map_id,
      ← (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).map_nsmul, hAM_tor,
      (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).map_zero]

  have hTor_loc : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf Z ℓ W) = 0 := by
    intro Z W
    let J := Z.smallEtaleTopology
    let L_W := weilEtaleLocalTorsionSheaf Z ℓ W
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (ℓ • (𝟙 L_W : L_W ⟶ L_W)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_W) ≫
          (ℓ • (𝟙 L_W : L_W ⟶ L_W)).hom.app (Opposite.op W) :=
      (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.Category.id_comp (ℓ • (𝟙 L_W : L_W ⟶ L_W))).symm).trans
        (h_fy_comp J (𝟙 L_W) (ℓ • 𝟙 L_W))
    have h2 : (ℓ • (𝟙 L_W : L_W ⟶ L_W)).hom.app (Opposite.op W) =
        ℓ • (𝟙 (L_W.obj.obj (Opposite.op W))) := by
      change ((CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj (Opposite.op W)).map
        ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map (ℓ • (𝟙 L_W : L_W ⟶ L_W))) = _
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_nsmul,
        CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
      rfl
    have h3 : CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L_W ⟶ L_W) = 0 := by
      have h0 := (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
        (CategoryTheory.Category.id_comp (0 : L_W ⟶ L_W)).symm).trans
        (h_fy_comp J (𝟙 L_W) 0)
      have h0_app : (0 : L_W ⟶ L_W).hom.app (Opposite.op W) = 0 := by
        change ((CategoryTheory.evaluation (Opposite Z.Etale) AddCommGrpCat.{u}).obj (Opposite.op W)).map
          ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map (0 : L_W ⟶ L_W)) = 0
        rw [CategoryTheory.Functor.map_zero, CategoryTheory.Functor.map_zero]
      exact h0.trans ((congrArg (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_W) ≫ ·) h0_app).trans
        CategoryTheory.Limits.comp_zero)
    rw [h1, h2, CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_W)),
      ← CategoryTheory.Preadditive.nsmul_comp, hAM_tor, CategoryTheory.Limits.zero_comp, h3]

  have hExt_nsmul : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
      {X M : C} {q : ℕ} (w : CategoryTheory.Abelian.Ext.{u} X M q) (n : ℕ),
      w.comp (CategoryTheory.Abelian.Ext.mk₀ (n • 𝟙 M)) (Nat.add_zero q) = n • w := by
    intro C _ _ _ X M q w n
    induction n with
    | zero =>
      rw [zero_smul, zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]

  let postIso : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (b : ℕ)
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}},
      (G₁ ≅ G₂) → (G₁.H b ≃+ G₂.H b) := fun Z b {_ _} e =>
    let Fℤ := (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    { (CategoryTheory.Abelian.Ext.mk₀ e.hom).postcomp Fℤ (Nat.add_zero b) with
      invFun := (CategoryTheory.Abelian.Ext.mk₀ e.inv).postcomp Fℤ (Nat.add_zero b)
      left_inv := fun x => by
        change (x.comp (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero b)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero b) = x
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      right_inv := fun y => by
        change (y.comp (CategoryTheory.Abelian.Ext.mk₀ e.inv) (Nat.add_zero b)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e.hom) (Nat.add_zero b) = y
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id] }

  let addGrpIsoEquiv : ∀ {M₁ M₂ : AddCommGrpCat.{u}}, (M₁ ≅ M₂) → (↥M₁ ≃ ↥M₂) :=
    fun {M₁ M₂} e =>
      { toFun := e.hom.hom
        invFun := e.inv.hom
        left_inv := fun x => congrArg (fun φ : M₁ ⟶ M₁ => φ.hom x) e.hom_inv_id
        right_inv := fun y => congrArg (fun φ : M₂ ⟶ M₂ => φ.hom y) e.inv_hom_id }

  have hLocMap_id : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (W : Z.Etale),
      weilEtaleLocalTorsionMap Z m (𝟙 W) = 𝟙 _ := by
    intro Z m W
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    dsimp [weilEtaleLocalTorsionMap]
    refine (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _).trans ?_
    change _ ≫ (weilEtaleLocalTorsionSheaf Z m W).obj.map (𝟙 (Opposite.op W)) = _
    rw [CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]

  have hLocMap_comp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
      {W₁ W₂ W₃ : Z.Etale} (u₁ : W₁ ⟶ W₂) (u₂ : W₂ ⟶ W₃),
      weilEtaleLocalTorsionMap Z m u₁ ≫ weilEtaleLocalTorsionMap Z m u₂ =
        weilEtaleLocalTorsionMap Z m (u₁ ≫ u₂) := by
    intro Z m W₁ W₂ W₃ u₁ u₂
    let L₂ := weilEtaleLocalTorsionSheaf Z m W₂
    let L₃ := weilEtaleLocalTorsionSheaf Z m W₃
    let f₁ := weilEtaleLocalTorsionMap Z m u₁
    let f₂ := weilEtaleLocalTorsionMap Z m u₂
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have s1 := h_fy_comp Z.smallEtaleTopology f₁ f₂
    have s2 : CategoryTheory.Sheaf.freeYonedaHomEquiv f₁ =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L₂) ≫ L₂.obj.map (Opposite.op u₁) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have s3 : L₂.obj.map (Opposite.op u₁) ≫ f₂.hom.app (Opposite.op W₁) =
        f₂.hom.app (Opposite.op W₂) ≫ L₃.obj.map (Opposite.op u₁) :=
      f₂.hom.naturality (Opposite.op u₁)
    have s4 : CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L₂) ≫ f₂.hom.app (Opposite.op W₂) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv f₂ :=
      (h_fy_comp Z.smallEtaleTopology (𝟙 L₂) f₂).symm.trans
        (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.Category.id_comp f₂))
    have s5 : CategoryTheory.Sheaf.freeYonedaHomEquiv f₂ =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L₃) ≫ L₃.obj.map (Opposite.op u₂) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have s6 : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap Z m (u₁ ≫ u₂)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L₃) ≫ L₃.obj.map (Opposite.op (u₁ ≫ u₂)) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    rw [s1, s2, CategoryTheory.Category.assoc, s3, ← CategoryTheory.Category.assoc, s4, s5,
      CategoryTheory.Category.assoc, ← L₃.obj.map_comp]
    exact s6.symm

  have hCounitTermIso : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (m : ℕ),
      CategoryTheory.IsIso (weilEtaleLocalTorsionCounit Z m (weilEtaleIdTerminal.{u} Z)) := by
    intro Z m
    let T_Z := weilEtaleIdTerminal.{u} Z
    let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z
    let J := Z.smallEtaleTopology
    let L_TZ := weilEtaleLocalTorsionSheaf Z m T_Z
    let FM_Z := weilEtaleTorsionSheaf Z m
    let c_hom := weilEtaleLocalTorsionCounit Z m T_Z
    let adj_Z := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_Z
    let unit_app : AM m ⟶ FM_Z.obj.obj (Opposite.op T_Z) :=
      (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
        ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj (AM m))).app (Opposite.op T_Z))
    have h_unit : adj_Z.unit.app (AM m) = unit_app := by
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_Z).comp
        (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u})).unit.app (AM m) = unit_app
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.Category.id_comp]
      rfl
    have hc_hom : CategoryTheory.Sheaf.freeYonedaHomEquiv c_hom = adj_Z.unit.app (AM m) :=
      (CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply unit_app).trans h_unit.symm
    let c_inv : FM_Z ⟶ L_TZ :=
      (adj_Z.homEquiv (AM m) L_TZ).symm (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_TZ))
    refine ⟨⟨c_inv, ?_, ?_⟩⟩
    · apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 := h_fy_comp J c_hom c_inv
      have h2 : adj_Z.unit.app (AM m) ≫ c_inv.hom.app (Opposite.op T_Z) =
          adj_Z.homEquiv (AM m) L_TZ c_inv :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_Z (AM m) L_TZ c_inv).symm
      exact h1.trans ((congrArg (· ≫ c_inv.hom.app (Opposite.op T_Z)) hc_hom).trans
        (h2.trans ((adj_Z.homEquiv (AM m) L_TZ).apply_symm_apply _)))
    · apply (adj_Z.homEquiv (AM m) FM_Z).injective
      have h1 : adj_Z.homEquiv (AM m) FM_Z (c_inv ≫ c_hom) =
          adj_Z.homEquiv (AM m) L_TZ c_inv ≫ c_hom.hom.app (Opposite.op T_Z) :=
        adj_Z.homEquiv_naturality_right c_inv c_hom
      have h2 : adj_Z.homEquiv (AM m) L_TZ c_inv =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_TZ) :=
        (adj_Z.homEquiv (AM m) L_TZ).apply_symm_apply _
      have h3 : CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_TZ) ≫ c_hom.hom.app (Opposite.op T_Z) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_TZ ≫ c_hom) :=
        (h_fy_comp J (𝟙 L_TZ) c_hom).symm
      have h4 : adj_Z.unit.app (AM m) = adj_Z.homEquiv (AM m) FM_Z (𝟙 FM_Z) := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id]
        exact (CategoryTheory.Category.comp_id _).symm
      exact h1.trans ((congrArg (· ≫ c_hom.hom.app (Opposite.op T_Z)) h2).trans
        (h3.trans ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
          (CategoryTheory.Category.id_comp c_hom)).trans (hc_hom.trans h4))))

  
  obtain ⟨hFin_P1, hHge3_P1, _, hCard2_P1⟩ :=
    weil_etale_smooth_proj_curve_mod_prime_cohomology k P_1 hIntP1 hProjP1 ℓ hℓ

  have hH1_P1 : Subsingleton (weilEtaleTorsionH P1 ℓ 1) := by
    obtain ⟨_, ι_kum, p_kum, h0_kum, hp_kum, hEx_kum⟩ :=
      weil_etale_kummer_mod_prime_short_exact k P_1 ℓ hℓ
    obtain ⟨hDiv0, _, _⟩ :=
      weil_etale_smooth_proj_curve_gm_cohomology_and_divisor_iso k P_1 hProjP1 ℓ
    obtain ⟨ξ₁, hBij_ξ₁, _, _⟩ :=
