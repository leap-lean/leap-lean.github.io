        have hv_zero : (CP_Y' (k + 1)).map SC.g = 0 := (hInjZero_Y' I k).eq_of_src _ 0
        have hu_zero : (CP_Y' (k + 2)).map SC.f = 0 := (hInjZero_Y' I (k + 1)).eq_of_tgt _ 0
        have _ : CategoryTheory.Mono δ_Y := hEx₁_Y.mono_g hv_zero
        have _ : CategoryTheory.Epi δ_Y := hEx₂_Y.epi_f hu_zero
        have _ : CategoryTheory.IsIso δ_Y := CategoryTheory.isIso_of_mono_of_epi δ_Y

        obtain ⟨δ_U, _, _, hEx₁_U, hEx₂_U⟩ := hConnPre_U SC' hSE' (k + 1)
        have hRv_zero : (CP_U (k + 1)).map SC'.g = 0 := (hInjZero_U (R_gU.obj I) k).eq_of_src _ 0
        have hRu_zero : (CP_U (k + 2)).map SC'.f = 0 := (hInjZero_U (R_gU.obj I) (k + 1)).eq_of_tgt _ 0
        have _ : CategoryTheory.Mono δ_U := hEx₁_U.mono_g hRv_zero
        have _ : CategoryTheory.Epi δ_U := hEx₂_U.epi_f hRu_zero
