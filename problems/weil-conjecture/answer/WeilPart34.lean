              (adj_pre.homEquiv (ι_U.obj ℱ) (ι_Y'.obj 𝒢))
                ((shAdj_Y'.homEquiv (j_pre_bang.obj (ι_U.obj ℱ)) 𝒢) f) ≫ R_pre.map (ι_Y'.map v)
