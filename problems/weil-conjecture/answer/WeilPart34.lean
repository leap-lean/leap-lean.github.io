        rw [hcomp_eq]
        exact eqv_right.bijective.comp (hbij_mid.comp eqv_left.bijective)
      exact hbij
    refine ⟨B, hB_mem, ⟨AlgEquiv.ofBijective e_prod_hom he_prod_bij, he_prod_tmul⟩, ?_, ?_⟩
    · intro J _ _ ι_J _ B_J hBJ_mem ⟨e_J, he_J_tmul⟩
      let S_J := ∀ j : J, S (ι_J j)
      let f_res : ↥B →ₐ[R] ↥B_J :=
