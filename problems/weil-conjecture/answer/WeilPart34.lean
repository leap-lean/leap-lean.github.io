    obtain ⟨i₀, hu₀_ne⟩ := hex_i₀
    let e₀_id : ∀ i : I, L i := Pi.single i₀ 1
    have he₀_idem : e₀_id * e₀_id = e₀_id := by
      funext i
      change e₀_id i * e₀_id i = e₀_id i
      dsimp [e₀_id]
      rcases eq_or_ne i i₀ with rfl | hne
