        s₁ (IsLocalization.Away.algebraMap_isUnit (αEsh_hom β₁ s₁)) y).symm
    let π_β₁ : Quiver.Hom
        (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (s_lvl_Bt β₁)))) Z_R₁s :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Localization.awayMap (αEsh_hom β₁) s₁))) π_E₁
    have hZero_β₁ : WeilEtaleTrianglePullbackMapsTo
        π_β₁ π_E₁
        (AlgebraicGeometry.Spec.map
