      rw [MvPolynomial.map_C, MvPolynomial.aeval_C]
      change (algebraMap κ Ω a) ⊗ₜ[κ] (1 : R₁) = (1 : Ω) ⊗ₜ[κ] g_S (MvPolynomial.C a)
