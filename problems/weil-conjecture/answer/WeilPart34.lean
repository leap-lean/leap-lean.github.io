          rw [Finset.sum_eq_single k]
          · simp
          · intro i₀ _ hi₀k
            split_ifs with h
            · exact absurd h hi₀k
            · exact zero_mul _
          · intro hk; exact absurd (Finset.mem_univ k) hk
        have hu_ker : Δ_0 u = 0 := by
          funext l₁ l₂ k
          let α_assoc := Algebra.TensorProduct.assoc R R R (S l₀) (S l₁) (S l₂)
          apply α_assoc.symm.injective
          change α_assoc.symm (LinearMap.baseChange (S l₀) (inl_R l₁ l₂) (u k l₁) -
            ∑ j : Fin m, LinearMap.baseChange (S l₀) (mulRight_R (χ l₁ l₂ k j)) (u j l₂)) =
              α_assoc.symm 0
