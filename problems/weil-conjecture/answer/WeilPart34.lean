            have hr1 : TensorProduct.tmul R r' a = r' • TensorProduct.tmul R (1 : R') a := by
              rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
            have hr2 : TensorProduct.tmul R (1 : R') b * TensorProduct.tmul R r' s₂ =
