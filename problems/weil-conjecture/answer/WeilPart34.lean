      congrArg (fun γ => γ.app (Opposite.op U)) h_u₁
    have cR2 : η_sh₁.app (Opposite.op (B₁.obj U)) ≫ F₁.obj.map (e_B.inv.app U).op =
        η_sh₁.app (Opposite.op (B_h.obj (B₂.obj U))) :=
      (η_sh₁.naturality (e_B.inv.app U).op).symm.trans (CategoryTheory.Category.id_comp _)
    exact cL.trans ((CategoryTheory.eq_whisker cL1 _).trans
      (cL2.trans (cR2.symm.trans ((CategoryTheory.eq_whisker cR1.symm _).trans cR.symm))))

  have hAbsExtPostIso : ∀ {D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [CategoryTheory.HasExt.{u} D]
      (X G₁ G₂ : D) (c_G : G₁ ⟶ G₂) [CategoryTheory.IsIso c_G],
      ∃ Φ : CategoryTheory.Abelian.Ext.{u} X G₁ q ≃+ CategoryTheory.Abelian.Ext.{u} X G₂ q,
        ∀ x : CategoryTheory.Abelian.Ext.{u} X G₁ q,
          Φ x = (CategoryTheory.Abelian.Ext.mk₀.{u} c_G).postcomp X (Nat.add_zero q) x := by
    intro D _ _ _ X G₁ G₂ c_G _
    let f_fwd := (CategoryTheory.Abelian.Ext.mk₀.{u} c_G).postcomp X (Nat.add_zero q)
    let f_bwd := (CategoryTheory.Abelian.Ext.mk₀.{u} (CategoryTheory.inv c_G)).postcomp X (Nat.add_zero q)
    refine ⟨{ toFun := f_fwd
              invFun := f_bwd
              left_inv := fun x => ?_
              right_inv := fun y => ?_
              map_add' := f_fwd.map_add }, fun _ => rfl⟩
    · change (x.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c_G) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} (CategoryTheory.inv c_G)) (Nat.add_zero q) = x
      rw [CategoryTheory.Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) (Nat.add_zero 0)
            (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.hom_inv_id]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id x
    · change (y.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (CategoryTheory.inv c_G)) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} c_G) (Nat.add_zero q) = y
      rw [CategoryTheory.Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.add_zero 0)
            (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.IsIso.inv_hom_id]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id y

  have hAbsExtIntertwine : ∀ {C D : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
      [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
      [hExtC : CategoryTheory.HasExt.{u} C] [hExtD : CategoryTheory.HasExt.{u} D]
      (F : CategoryTheory.Functor C D) [F.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      {X₂ G₂ M₂ : C} {X₁ G₁ M₁ : D}
      (ιℤ : X₁ ⟶ F.obj X₂)
      (β : F.obj G₂ ⟶ G₁)
      (c₂ : G₂ ⟶ M₂) (c₁ : G₁ ⟶ M₁) (c_h : F.obj M₂ ⟶ M₁)
      (hcoc : F.map c₂ ≫ c_h = β ≫ c₁)
      (x₂ : CategoryTheory.Abelian.Ext.{u} X₂ G₂ q),
      (CategoryTheory.Abelian.Ext.mk₀.{u} c_h).postcomp X₁ (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp
          ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ M₂ q)
            ((CategoryTheory.Abelian.Ext.mk₀.{u} c₂).postcomp X₂ (Nat.add_zero q) x₂))
          (Nat.zero_add q)) =
      (CategoryTheory.Abelian.Ext.mk₀.{u} c₁).postcomp X₁ (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀.{u} β).postcomp X₁ (Nat.add_zero q)
          ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).precomp (F.obj G₂) (Nat.zero_add q)
            ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ G₂ q) x₂))) := by
    intro C D _ _ _ _ hExtC hExtD F _ _ _ X₂ G₂ M₂ X₁ G₁ M₁ ιℤ β c₂ c₁ c_h hcoc x₂
    let mapG := @CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ G₂ q
    let mapM := @CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ M₂ q
    have hmap : mapM (x₂.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) (Nat.add_zero q)) =
        (mapG x₂).comp (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂)) (Nat.add_zero q) :=
      (@CategoryTheory.Functor.mapExtAddHom_apply.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ M₂ q _).trans
        ((@CategoryTheory.Abelian.Ext.mapExactFunctor_comp.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD
          X₂ G₂ M₂ q 0 x₂ (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) q (Nat.add_zero q)).trans
          (congrArg₂
            (fun (a : CategoryTheory.Abelian.Ext.{u} (F.obj X₂) (F.obj G₂) q)
                 (b : CategoryTheory.Abelian.Ext.{u} (F.obj G₂) (F.obj M₂) 0) =>
              a.comp b (Nat.add_zero q))
            (@CategoryTheory.Functor.mapExtAddHom_apply.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ G₂ q x₂).symm
            (@CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD G₂ M₂ c₂)))
    let w : CategoryTheory.Abelian.Ext.{u} (F.obj X₂) (F.obj G₂) q := mapG x₂
    change ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp
          (mapM (x₂.comp (CategoryTheory.Abelian.Ext.mk₀.{u} c₂) (Nat.add_zero q)))
          (Nat.zero_add q)).comp (CategoryTheory.Abelian.Ext.mk₀.{u} c_h) (Nat.add_zero q) =
        (((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp w (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} β) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} c₁) (Nat.add_zero q)
    rw [hmap]
    have h1 : (CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp
        (w.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂)) (Nat.add_zero q)) (Nat.zero_add q) =
        ((CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp w (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂)) (Nat.add_zero q) :=
      (CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ) w
        (CategoryTheory.Abelian.Ext.mk₀.{u} (F.map c₂))
        (Nat.zero_add q) (Nat.add_zero q) (by omega)).symm
    rw [h1]
    set u := (CategoryTheory.Abelian.Ext.mk₀.{u} ιℤ).comp w (Nat.zero_add q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc u _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc u _ _ (Nat.add_zero q) (Nat.add_zero 0) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hcoc]

  have hTermPullIso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.IsIso
        ((weilEtaleIdTerminalIsTerminal.{u} Y₁).from
          ((weilEtaleSitePullback h).obj (weilEtaleIdTerminal.{u} Y₂))) := by
    intro Y₁ Y₂ h
    let T₁ := weilEtaleIdTerminal.{u} Y₁
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} Y₁
    let T₂ := weilEtaleIdTerminal.{u} Y₂
    let BT₂ := (weilEtaleSitePullback h).obj T₂
    have hBT₂_hom : BT₂.hom = CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h := rfl
    have hIso_snd : CategoryTheory.IsIso (CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h) :=
      CategoryTheory.Limits.pullback_snd_iso_of_left_iso (𝟙 Y₂) h
    let inv_snd := @CategoryTheory.inv _ _ _ _ (CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h) hIso_snd
    let τ_inv : T₁ ⟶ BT₂ :=
      CategoryTheory.MorphismProperty.Over.homMk inv_snd
        (by
          change inv_snd ≫ CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h = 𝟙 Y₁
          exact @CategoryTheory.IsIso.inv_hom_id _ _ _ _ _ hIso_snd)
    refine ⟨⟨τ_inv, ?_, hT₁.hom_ext _ _⟩⟩
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · change (hT₁.from BT₂).left ≫ inv_snd = 𝟙 BT₂.left
      have hfrom_left : (hT₁.from BT₂).left = BT₂.hom :=
        (CategoryTheory.Category.comp_id _).symm.trans
          (CategoryTheory.MorphismProperty.Over.w (hT₁.from BT₂))
      exact (congrArg (· ≫ inv_snd) (hfrom_left.trans hBT₂_hom)).trans
        (@CategoryTheory.IsIso.hom_inv_id _ _ _ _ _ hIso_snd)
    · exact Subsingleton.elim _ _

  let B₀ : CommRingCat.{u} := CommRingCat.of (ULift.{u} ℤ)
  let Z₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec B₀
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let G₀ : CategoryTheory.Sheaf Z₀.smallEtaleTopology AddCommGrpCat.{u} :=
    weilEtaleTorsionSheaf Z₀ ℓ
  let toRing : ∀ R : CommRingCat.{u}, B₀ ⟶ R :=
    fun R => CommRingCat.ofHom ((Int.castRingHom ↑R).comp ULift.ringEquiv.toRingHom)
  have htoRing_comp : ∀ {R₁ R₂ : CommRingCat.{u}} (g : R₁ ⟶ R₂), toRing R₁ ≫ g = toRing R₂ := by
    intro R₁ R₂ g; apply CommRingCat.hom_ext; ext ⟨n⟩; exact map_intCast g.hom n

  let α_ℤ : (CategoryTheory.Functor.const 𝒥).obj B₀ ⟶ B :=
    { app := fun j => toRing (B.obj j)
      naturality := fun j j' φ => by
        dsimp; rw [Category.id_comp]; exact (htoRing_comp (B.map φ)).symm }
  let f_inf : B₀ ⟶ c.pt := toRing c.pt
  have hα_inf : ∀ j : 𝒥, α_ℤ.app j ≫ c.ι.app j = f_inf := fun j => htoRing_comp (c.ι.app j)

  have hBridgeSys : ∃ (Φ : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (π : Y ⟶ Z₀),
        (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y.smallEtaleTopology).obj G₀).H q ≃+
        weilEtaleTorsionH Y ℓ q),
      ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        (π₁ : Y₁ ⟶ Z₀) (π₂ : Y₂ ⟶ Z₀) (h : Y₁ ⟶ Y₂) (h_eq : h ≫ π₂ = π₁)
        (x₂ : (((weilEtaleSitePullback π₂).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y₂.smallEtaleTopology).obj G₀).H q)
        (x₁ : (((weilEtaleSitePullback π₁).sheafPullback AddCommGrpCat.{u}
          Z₀.smallEtaleTopology Y₁.smallEtaleTopology).obj G₀).H q)
        (p_h : weilEtaleTorsionH Y₂ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q),
        WeilIsTorsionEtalePullback h ℓ q p_h →
        (WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq G₀ q x₂ x₁ ↔
          p_h (Φ π₂ x₂) = Φ π₁ x₁) := by
    let cM_of : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
        ((weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology).obj (weilEtaleTorsionSheaf Y₂ ℓ) ⟶
        weilEtaleTorsionSheaf Y₁ ℓ :=
      fun {Y₁ Y₂} h =>
        let B_h := weilEtaleSitePullback h
        let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        let P₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj AM
        let P₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj AM
        (adj_h.homEquiv (weilEtaleTorsionSheaf Y₂ ℓ) (weilEtaleTorsionSheaf Y₁ ℓ)).symm
          (((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
            P₂ (pf_h.obj (weilEtaleTorsionSheaf Y₁ ℓ))).symm
            (CategoryTheory.Functor.whiskerLeft B_h.op
              ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app P₁)))
    have hcM_iso : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
        CategoryTheory.IsIso (cM_of h) := fun {Y₁ Y₂} h =>
      (hAbsConstEqIso _ _ (weilEtaleSitePullback h)
        (weilEtaleIdTerminal Y₁) (weilEtaleIdTerminalIsTerminal Y₁)
        (weilEtaleIdTerminal Y₂) (weilEtaleIdTerminalIsTerminal Y₂) AM).2 (hTermPullIso h)
    have hΦ_ex : ∀ {Y : AlgebraicGeometry.Scheme.{u}} (π : Y ⟶ Z₀),
        ∃ Φ : (((weilEtaleSitePullback π).sheafPullback AddCommGrpCat.{u}
            Z₀.smallEtaleTopology Y.smallEtaleTopology).obj G₀).H q ≃+
          weilEtaleTorsionH Y ℓ q,
          ∀ x, Φ x = (CategoryTheory.Abelian.Ext.mk₀.{u} (cM_of π)).postcomp
            ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
            (Nat.add_zero q) x := fun {Y} π => by
      haveI := hcM_iso π
      exact hAbsExtPostIso
        ((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ)
        _ _ (cM_of π)
    refine ⟨fun π => (hΦ_ex π).choose,
      fun {Y₁ Y₂} π₁ π₂ h h_eq x₂ x₁ p_h hp_h => ?_⟩
    haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    haveI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    obtain ⟨hAdd_h, hLim_h, hColim_h, hcℤ_iso⟩ := hSite.1 h
    letI := hAdd_h
    letI := hLim_h
    letI := hColim_h
    let B₁ := weilEtaleSitePullback π₁
    let B₂ := weilEtaleSitePullback π₂
    let B_h := weilEtaleSitePullback h
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let pb₁ := B₁.sheafPullback AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₁.smallEtaleTopology
    let pb₂ := B₂.sheafPullback AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₂.smallEtaleTopology
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₂.smallEtaleTopology
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let Fℤ₁ := (CategoryTheory.constantSheaf Y₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ₂ := (CategoryTheory.constantSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Pℤ₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj Aℤ
    let Pℤ₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj Aℤ
    let η₁ := CategoryTheory.Functor.whiskerLeft B_h.op
      ((CategoryTheory.sheafificationAdjunction Y₁.smallEtaleTopology AddCommGrpCat.{u}).unit.app Pℤ₁)
    let uℤ := ((CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
      Pℤ₂ (pf_h.obj Fℤ₁)).symm η₁
    let cℤ := (adj_h.homEquiv Fℤ₂ Fℤ₁).symm uℤ
    let inv_cℤ := @CategoryTheory.inv _ _ _ _ cℤ hcℤ_iso
    let e_B : B₁ ≅ B₂ ⋙ B_h :=
      (CategoryTheory.MorphismProperty.Over.pullbackCongr h_eq.symm).trans
        (CategoryTheory.MorphismProperty.Over.pullbackComp h π₂)
    have : (B₂ ⋙ B_h).IsContinuous Z₀.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B₂ B_h
        Z₀.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
      AddCommGrpCat.{u} Z₀.smallEtaleTopology Y₁.smallEtaleTopology
    let β : pb_h.obj (pb₂.obj G₀) ⟶ pb₁.obj G₀ :=
      (adj_h.homEquiv (pb₂.obj G₀) (pb₁.obj G₀)).symm
        ((adj₂.homEquiv G₀ (pf_h.obj (pb₁.obj G₀))).symm
          (adj₁.unit.app G₀ ≫ e_pf.hom.app (pb₁.obj G₀)))
    let T₁ := weilEtaleIdTerminal Y₁
    let hT₁ := weilEtaleIdTerminalIsTerminal Y₁
    let T₂ := weilEtaleIdTerminal Y₂
    let hT₂ := weilEtaleIdTerminalIsTerminal Y₂
    have hcℤ_eq : cℤ =
        (adj_h.homEquiv Fℤ₂ Fℤ₁).symm
          (((CategoryTheory.constantSheafAdj Y₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).homEquiv
            Aℤ (pf_h.obj Fℤ₁)).symm
            ((CategoryTheory.constantSheafAdj Y₁.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app Aℤ ≫
              Fℤ₁.obj.map (hT₁.from (B_h.obj T₂)).op)) :=
      (hAbsConstEqIso Y₁.smallEtaleTopology Y₂.smallEtaleTopology B_h T₁ hT₁ T₂ hT₂ Aℤ).1
    have hcM_eq : cM_of h =
        (adj_h.homEquiv (weilEtaleTorsionSheaf Y₂ ℓ) (weilEtaleTorsionSheaf Y₁ ℓ)).symm
          (((CategoryTheory.constantSheafAdj Y₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).homEquiv
            AM (pf_h.obj (weilEtaleTorsionSheaf Y₁ ℓ))).symm
            ((CategoryTheory.constantSheafAdj Y₁.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app AM ≫
              (weilEtaleTorsionSheaf Y₁ ℓ).obj.map (hT₁.from (B_h.obj T₂)).op)) :=
      (hAbsConstEqIso Y₁.smallEtaleTopology Y₂.smallEtaleTopology B_h T₁ hT₁ T₂ hT₂ AM).1
    let p_can : weilEtaleTorsionH Y₂ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q :=
      ((CategoryTheory.Abelian.Ext.mk₀.{u} (cM_of h)).postcomp Fℤ₁ (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀.{u} inv_cℤ).precomp
          (pb_h.obj (weilEtaleTorsionSheaf Y₂ ℓ)) (Nat.zero_add q)).comp
          (@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ pb_h _ _ _ _ _
            Fℤ₂ (weilEtaleTorsionSheaf Y₂ ℓ) q))
    have hp_can : WeilIsTorsionEtalePullback h ℓ q p_can :=
      ⟨@hc_all Y₁ Y₂ h, @hr_all Y₁ Y₂ h, hAdd_h, hLim_h, hColim_h,
        T₁, hT₁, T₂, hT₂, inv_cℤ,
        (congrArg (inv_cℤ ≫ ·) hcℤ_eq.symm).trans (@CategoryTheory.IsIso.inv_hom_id _ _ _ _ cℤ hcℤ_iso),
        (congrArg (· ≫ inv_cℤ) hcℤ_eq.symm).trans (@CategoryTheory.IsIso.hom_inv_id _ _ _ _ cℤ hcℤ_iso),
        fun z => congrArg (fun m =>
          (CategoryTheory.Abelian.Ext.mk₀.{u} m).postcomp Fℤ₁ (Nat.add_zero q)
            ((CategoryTheory.Abelian.Ext.mk₀.{u} inv_cℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ pb_h _ _ _ _ _
                Fℤ₂ (weilEtaleTorsionSheaf Y₂ ℓ) q) z)
              (Nat.zero_add q))) hcM_eq⟩
    have hp_eq : p_h = p_can := hPullUniq h ℓ q p_h p_can hp_h hp_can
    have hcoc_M : pb_h.map (cM_of π₂) ≫ cM_of h = β ≫ cM_of π₁ :=
      hAbsMateBeta Z₀.smallEtaleTopology Y₁.smallEtaleTopology Y₂.smallEtaleTopology
        B₁ B₂ B_h e_B AM
    let tri_val :=
      (CategoryTheory.Abelian.Ext.mk₀.{u} β).postcomp Fℤ₁ (Nat.add_zero q)
        ((CategoryTheory.Abelian.Ext.mk₀.{u} inv_cℤ).precomp (pb_h.obj (pb₂.obj G₀)) (Nat.zero_add q)
          ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ pb_h _ _ _ _ _
            Fℤ₂ (pb₂.obj G₀) q) x₂))
    have hTriIff : WeilEtaleTrianglePullbackMapsTo π₁ π₂ h h_eq G₀ q x₂ x₁ ↔ tri_val = x₁ := by
      constructor
      · rintro ⟨_, _, _, _, _, _, heq⟩; exact heq
      · intro heq; exact ⟨@hc_all Y₁ Y₂ h, @hr_all Y₁ Y₂ h, hAdd_h, hLim_h, hColim_h, hcℤ_iso, heq⟩
    have hInter : p_can ((hΦ_ex π₂).choose x₂) = (hΦ_ex π₁).choose tri_val := by
      rw [(hΦ_ex π₂).choose_spec x₂, (hΦ_ex π₁).choose_spec tri_val]
      exact hAbsExtIntertwine pb_h inv_cℤ β (cM_of π₂) (cM_of π₁) (cM_of h) hcoc_M x₂
    rw [hTriIff, hp_eq, hInter]
    exact ⟨fun heq => congrArg (hΦ_ex π₁).choose heq, fun heq => (hΦ_ex π₁).choose.injective heq⟩

  obtain ⟨Φ, hBridge⟩ := hBridgeSys
  obtain ⟨hSurj_aff, hInj_aff⟩ := hAffq 𝒥 B₀ B α_ℤ c hc f_inf hα_inf G₀
  let p_j_map : ∀ j : 𝒥, AlgebraicGeometry.Spec (B.obj j) ⟶ Z₀ :=
    fun j => AlgebraicGeometry.Spec.map (α_ℤ.app j)
  let p_inf_map : AlgebraicGeometry.Spec c.pt ⟶ Z₀ :=
    AlgebraicGeometry.Spec.map f_inf
  let u_j_map : ∀ j : 𝒥, AlgebraicGeometry.Spec c.pt ⟶ AlgebraicGeometry.Spec (B.obj j) :=
    fun j => AlgebraicGeometry.Spec.map (c.ι.app j)

  constructor
  · intro ξ_inf
    obtain ⟨j, hu_j, s_j, hMaps_j⟩ := hSurj_aff ((Φ p_inf_map).symm ξ_inf)
    refine ⟨j, Φ (p_j_map j) s_j, fun p_j hp_j => ?_⟩
    have h1 := (hBridge p_inf_map (p_j_map j) (u_j_map j) hu_j s_j
      ((Φ p_inf_map).symm ξ_inf) p_j hp_j).mp hMaps_j
    exact h1.trans ((Φ p_inf_map).apply_symm_apply ξ_inf)
  · intro j ξ_j p_j hp_j hp_zero
    have hu_j : u_j_map j ≫ p_j_map j = p_inf_map := by
      dsimp [u_j_map, p_j_map, p_inf_map]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_inf j]
    let s_j := (Φ (p_j_map j)).symm ξ_j
    have hMaps0 : WeilEtaleTrianglePullbackMapsTo p_inf_map (p_j_map j) (u_j_map j) hu_j G₀ q s_j 0 := by
      apply (hBridge p_inf_map (p_j_map j) (u_j_map j) hu_j s_j 0 p_j hp_j).mpr
      rw [(Φ (p_j_map j)).apply_symm_apply, map_zero]
      exact hp_zero
    obtain ⟨j', φ, hφ_eq, hMaps_φ⟩ := hInj_aff j hu_j s_j hMaps0
    refine ⟨j', φ, fun p_φ hp_φ => ?_⟩
    have h1 := (hBridge (p_j_map j') (p_j_map j) (AlgebraicGeometry.Spec.map (B.map φ)) hφ_eq
      s_j 0 p_φ hp_φ).mp hMaps_φ
    rw [(Φ (p_j_map j)).apply_symm_apply, map_zero] at h1
    exact h1

theorem weil_val_ring_acyclic_hdi_isZero_iff_affine_etale_cover_kill (ℓ b : ℕ) [Fact (Nat.Prime ℓ)]
    {U Y : AlgebraicGeometry.Scheme.{u}} (j : U ⟶ Y) :
    (CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf U ℓ)) →
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
        (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b),
        ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
          (_ : ∀ a, AlgebraicGeometry.IsAffine (V a))
          (v : ∀ a, V a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (v a)),
          (⋃ a, Set.range (v a).base) = Set.univ ∧
          ∀ (a : I)
            (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j w) (v a)) ℓ b),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd j w) (v a)) ℓ b p_a →
            p_a ξ = 0) ∧
    ((∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
        (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b),
        ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
          (u : ∀ a, V a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (u a)),
          (⋃ a, Set.range (u a).base) = Set.univ ∧
          ∀ (a : I)
            (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j w) ℓ b →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j w) (u a)) ℓ b),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd j w) (u a)) ℓ b p_a →
            p_a ξ = 0) →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf U ℓ))) :=
by
  have hAbsSheafifyZeroIff : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
      (Q : Cᵒᵖ ⥤ AddCommGrpCat.{u})
      [CategoryTheory.Presheaf.IsLocallyInjective J (CategoryTheory.toSheafify J Q)],
      (CategoryTheory.Limits.IsZero
          ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj Q) →
        ∀ (W₀ : C) (s₀ : ↥(Q.obj (Opposite.op W₀))),
          ∃ R₀ ∈ J W₀, ∀ {Y₀ : C} (g : Y₀ ⟶ W₀), R₀.arrows g → (Q.map g.op).hom s₀ = 0) ∧
      ((∀ (E : C) (s : ↥(Q.obj (Opposite.op E))),
          ∃ R₀ ∈ J E, ∀ {Z : C} (g : Z ⟶ E), R₀.arrows g → (Q.map g.op).hom s = 0) →
        CategoryTheory.Limits.IsZero
          ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj Q)) := by
    clear * -
    intro C _ J _ Q _
    let F_sh := (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj Q
    let η_Q := CategoryTheory.toSheafify J Q
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    constructor
    · intro hZero W₀ s₀
      have hZeroSh : CategoryTheory.Limits.IsZero (CategoryTheory.sheafify J Q) :=
        (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map_isZero hZero
      have hη_app_zero : η_Q.app (Opposite.op W₀) = 0 :=
        congrArg (fun ν : Q ⟶ CategoryTheory.sheafify J Q => ν.app (Opposite.op W₀))
          (hZeroSh.eq_of_tgt η_Q 0)
      have hη_eq :
          (CategoryTheory.ConcreteCategory.hom (η_Q.app (Opposite.op W₀))) s₀ =
            (CategoryTheory.ConcreteCategory.hom (η_Q.app (Opposite.op W₀))) 0 := by
        change (η_Q.app (Opposite.op W₀)).hom s₀ = (η_Q.app (Opposite.op W₀)).hom 0
        rw [hη_app_zero, map_zero]
        rfl
      refine ⟨CategoryTheory.Presheaf.equalizerSieve (F := Q) (X := Opposite.op W₀) s₀ 0,
        CategoryTheory.Presheaf.equalizerSieve_mem J η_Q s₀ 0 hη_eq,
        fun {Y₀} g hg => ?_⟩
      have hg' : (Q.map g.op).hom s₀ = (Q.map g.op).hom 0 := hg
      exact hg'.trans (map_zero (Q.map g.op).hom)
    · intro hLocZero
      have hη_zero : η_Q = 0 := by
        ext ⟨E⟩ : 2
        apply AddCommGrpCat.ext
        intro s
        obtain ⟨R₀, hR₀_mem, hR₀_kill⟩ := hLocZero E s
        exact F_sh.isSeparated E R₀ hR₀_mem (η_Q.app (Opposite.op E) s) 0 (fun Z g hg => by
          change (F_sh.obj.map g.op) (η_Q.app (Opposite.op E) s) = (F_sh.obj.map g.op) 0
          rw [map_zero]
          have hnat := congrArg (fun k => k s) (η_Q.naturality g.op)
          have hlhs : (Q.map g.op ≫ η_Q.app (Opposite.op Z)) s = 0 := by
            change (η_Q.app (Opposite.op Z)).hom ((Q.map g.op).hom s) = 0
            rw [hR₀_kill g hg, map_zero]
          exact hnat.symm.trans hlhs)
      have htri : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map η_Q ≫
          adj_sh.counit.app F_sh = 𝟙 F_sh :=
        adj_sh.left_triangle_components Q
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero, ← htri, hη_zero,
        CategoryTheory.Functor.map_zero, CategoryTheory.Limits.zero_comp]

  have hPbCubeIso : ∀ {X₀ V_l : AlgebraicGeometry.Scheme.{u}}
      (w₀ : X₀ ⟶ Y) (v₀ : V_l ⟶ Y) (gl : V_l ⟶ X₀) (hgw : gl ≫ w₀ = v₀),
      ∃ e_ψ : CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w₀) gl ≅
          CategoryTheory.Limits.pullback v₀ j,
        ∀ (bg_l : CategoryTheory.Limits.pullback v₀ j ⟶ CategoryTheory.Limits.pullback w₀ j),
          bg_l ≫ CategoryTheory.Limits.pullback.fst w₀ j =
            CategoryTheory.Limits.pullback.fst v₀ j ≫ gl →
          bg_l ≫ CategoryTheory.Limits.pullback.snd w₀ j =
            CategoryTheory.Limits.pullback.snd v₀ j →
          e_ψ.hom ≫ bg_l =
            CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j w₀) gl ≫
              (CategoryTheory.Limits.pullbackSymmetry w₀ j).inv := by
    clear * -
    intro X₀ V_l w₀ v₀ gl hgw
    let fst₁ := CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j w₀) gl
    let snd₁ := CategoryTheory.Limits.pullback.snd (CategoryTheory.Limits.pullback.snd j w₀) gl
    let ψ_hom : CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w₀) gl ⟶
        CategoryTheory.Limits.pullback v₀ j :=
      CategoryTheory.Limits.pullback.lift snd₁
        (fst₁ ≫ CategoryTheory.Limits.pullback.fst j w₀)
        ((congrArg (snd₁ ≫ ·) hgw.symm).trans
          ((Category.assoc snd₁ gl w₀).symm.trans
            ((congrArg (· ≫ w₀) CategoryTheory.Limits.pullback.condition.symm).trans
              ((Category.assoc fst₁ (CategoryTheory.Limits.pullback.snd j w₀) w₀).trans
                ((congrArg (fst₁ ≫ ·) CategoryTheory.Limits.pullback.condition.symm).trans
                  (Category.assoc fst₁ (CategoryTheory.Limits.pullback.fst j w₀) j).symm)))))
    let m₀ : CategoryTheory.Limits.pullback v₀ j ⟶ CategoryTheory.Limits.pullback j w₀ :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.snd v₀ j)
        (CategoryTheory.Limits.pullback.fst v₀ j ≫ gl)
        (CategoryTheory.Limits.pullback.condition.symm.trans
          ((congrArg (CategoryTheory.Limits.pullback.fst v₀ j ≫ ·) hgw.symm).trans
            (Category.assoc (CategoryTheory.Limits.pullback.fst v₀ j) gl w₀).symm))
    let ψ_inv : CategoryTheory.Limits.pullback v₀ j ⟶
        CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w₀) gl :=
      CategoryTheory.Limits.pullback.lift m₀
        (CategoryTheory.Limits.pullback.fst v₀ j)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have h_sq : ∀ (bg_l : CategoryTheory.Limits.pullback v₀ j ⟶ CategoryTheory.Limits.pullback w₀ j),
        bg_l ≫ CategoryTheory.Limits.pullback.fst w₀ j =
          CategoryTheory.Limits.pullback.fst v₀ j ≫ gl →
        bg_l ≫ CategoryTheory.Limits.pullback.snd w₀ j =
          CategoryTheory.Limits.pullback.snd v₀ j →
        ψ_hom ≫ bg_l =
          fst₁ ≫ (CategoryTheory.Limits.pullbackSymmetry w₀ j).inv := by
      intro bg_l hB_fst hB_snd
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (Category.assoc ψ_hom bg_l (CategoryTheory.Limits.pullback.fst w₀ j)).trans
          ((congrArg (ψ_hom ≫ ·) hB_fst).trans
            ((Category.assoc ψ_hom (CategoryTheory.Limits.pullback.fst v₀ j) gl).symm.trans
              ((congrArg (· ≫ gl) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (CategoryTheory.Limits.pullback.condition.symm.trans
                  ((congrArg (fst₁ ≫ ·)
                      (CategoryTheory.Limits.pullbackSymmetry_inv_comp_fst w₀ j).symm).trans
                    (Category.assoc fst₁ (CategoryTheory.Limits.pullbackSymmetry w₀ j).inv
                      (CategoryTheory.Limits.pullback.fst w₀ j)).symm)))))
      · exact (Category.assoc ψ_hom bg_l (CategoryTheory.Limits.pullback.snd w₀ j)).trans
          ((congrArg (ψ_hom ≫ ·) hB_snd).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
              ((congrArg (fst₁ ≫ ·)
                  (CategoryTheory.Limits.pullbackSymmetry_inv_comp_snd w₀ j).symm).trans
                (Category.assoc fst₁ (CategoryTheory.Limits.pullbackSymmetry w₀ j).inv
                  (CategoryTheory.Limits.pullback.snd w₀ j)).symm)))
    exact ⟨{ hom := ψ_hom
             inv := ψ_inv
             hom_inv_id := by
               apply CategoryTheory.Limits.pullback.hom_ext
               · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
                 apply CategoryTheory.Limits.pullback.hom_ext
                 · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                     CategoryTheory.Limits.pullback.lift_snd]
                 · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                     CategoryTheory.Limits.pullback.lift_fst_assoc,
                     CategoryTheory.Limits.pullback.condition]
               · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                   CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
             inv_hom_id := by
               apply CategoryTheory.Limits.pullback.hom_ext
               · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                   CategoryTheory.Limits.pullback.lift_snd, Category.id_comp]
               · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                   CategoryTheory.Limits.pullback.lift_fst_assoc,
                   CategoryTheory.Limits.pullback.lift_fst, Category.id_comp] }, h_sq⟩

  have hSymEquivGen : ∀ (H : AlgebraicGeometry.Scheme.{u} → Type u) [∀ S, AddCommGroup (H S)]
      (Pull : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}, (S₁ ⟶ S₂) → (H S₂ →+ H S₁) → Prop)
      (P_U : (Opposite U.Etale) ⥤ AddCommGrpCat.{u}),
      (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂), ∃ p : H S₂ →+ H S₁, Pull h p) →
      (∀ {S : AlgebraicGeometry.Scheme.{u}} (p : H S →+ H S), Pull (𝟙 S) p → p = AddMonoidHom.id _) →
      (∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}} (h₁ : S₁ ⟶ S₂) (h₂ : S₂ ⟶ S₃)
        (p₁ : H S₂ →+ H S₁) (p₂ : H S₃ →+ H S₂) (p₁₂ : H S₃ →+ H S₁),
        Pull h₁ p₁ → Pull h₂ p₂ → Pull (h₁ ≫ h₂) p₁₂ → p₁₂ = p₁.comp p₂) →
      (∃ Θ : ∀ W : U.Etale, ↥(P_U.obj (Opposite.op W)) ≃+
          H ((AlgebraicGeometry.Scheme.Etale.forget U).obj W).left,
        ∀ {W₁ W₂ : U.Etale} (g : W₁ ⟶ W₂)
          (p_g : H ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₂).left →+
            H ((AlgebraicGeometry.Scheme.Etale.forget U).obj W₁).left),
          Pull ((AlgebraicGeometry.Scheme.Etale.forget U).map g).left p_g →
          ∀ z : ↥(P_U.obj (Opposite.op W₂)),
            Θ W₁ ((P_U.map g.op).hom z) = p_g (Θ W₂ z)) →
      let Q := CategoryTheory.Functor.comp (weilEtaleSitePullback j).op P_U
      ∀ (W₀ : Y.Etale),
        ∃ (E_W : ↥(Q.obj (Opposite.op W₀)) ≃+ H (CategoryTheory.Limits.pullback j W₀.hom)),
          ∀ {V₀ : Y.Etale} (g : V₀ ⟶ W₀) (s : ↥(Q.obj (Opposite.op W₀)))
            (p₁ : H (CategoryTheory.Limits.pullback j W₀.hom) →+
              H (CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j W₀.hom) g.left)),
            Pull (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j W₀.hom) g.left) p₁ →
            (p₁ (E_W s) = 0 ↔ (Q.map g.op).hom s = 0) := by
    clear * - hPbCubeIso
    intro H _ Pull P_U hPullEx₀ hPullId₀ hPullComp₀ hSlice₀ Q W₀
    have hPullIsoBij : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂)
        (p : H X₂ →+ H X₁), Pull e.hom p → Function.Bijective p := by
      intro X₁ X₂ e p hp
      obtain ⟨p_inv, hp_inv⟩ := hPullEx₀ e.inv
      obtain ⟨p₁, hp₁⟩ := hPullEx₀ (𝟙 X₁)
      obtain ⟨p₂, hp₂⟩ := hPullEx₀ (𝟙 X₂)
      have hp₁_id : Pull (𝟙 X₁) (AddMonoidHom.id _) := hPullId₀ p₁ hp₁ ▸ hp₁
      have hp₂_id : Pull (𝟙 X₂) (AddMonoidHom.id _) := hPullId₀ p₂ hp₂ ▸ hp₂
      have hid₁ : Pull (e.hom ≫ e.inv) (AddMonoidHom.id _) :=
        (congrArg (fun f => Pull f (AddMonoidHom.id _)) e.hom_inv_id).mpr hp₁_id
      have hid₂ : Pull (e.inv ≫ e.hom) (AddMonoidHom.id _) :=
        (congrArg (fun f => Pull f (AddMonoidHom.id _)) e.inv_hom_id).mpr hp₂_id
      have hc₁ := hPullComp₀ e.hom e.inv p p_inv (AddMonoidHom.id _) hp hp_inv hid₁
      have hc₂ := hPullComp₀ e.inv e.hom p_inv p (AddMonoidHom.id _) hp_inv hp hid₂
      exact ⟨Function.LeftInverse.injective (fun x => congrFun (congrArg DFunLike.coe hc₂.symm) x),
        Function.RightInverse.surjective (fun y => congrFun (congrArg DFunLike.coe hc₁.symm) y)⟩
    let B_j : CategoryTheory.Functor Y.Etale U.Etale := weilEtaleSitePullback j
    obtain ⟨Θ_U, hΘ_U⟩ := hSlice₀
    let e_sym : CategoryTheory.Limits.pullback W₀.hom j ≅ CategoryTheory.Limits.pullback j W₀.hom :=
      CategoryTheory.Limits.pullbackSymmetry W₀.hom j
    obtain ⟨p_sym, hp_sym⟩ := hPullEx₀ e_sym.inv
    have hbij_sym : Function.Bijective p_sym := hPullIsoBij e_sym.symm p_sym hp_sym
    let eqv_sym : H (CategoryTheory.Limits.pullback W₀.hom j) ≃+
        H (CategoryTheory.Limits.pullback j W₀.hom) :=
      AddEquiv.ofBijective p_sym hbij_sym
    let E_W := (Θ_U (B_j.obj W₀)).trans eqv_sym
    refine ⟨E_W, fun {V₀} g s p₁ hp₁ => ?_⟩
    let fst₁ := CategoryTheory.Limits.pullback.fst
      (CategoryTheory.Limits.pullback.snd j W₀.hom) g.left
    obtain ⟨e_ψ, he_ψ_sq⟩ := hPbCubeIso W₀.hom V₀.hom g.left (CategoryTheory.MorphismProperty.Over.w g)
    have hB_fst : (B_j.map g).left ≫ CategoryTheory.Limits.pullback.fst W₀.hom j =
        CategoryTheory.Limits.pullback.fst V₀.hom j ≫ g.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hB_snd : (B_j.map g).left ≫ CategoryTheory.Limits.pullback.snd W₀.hom j =
        CategoryTheory.Limits.pullback.snd V₀.hom j :=
      (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
        (Category.comp_id (CategoryTheory.Limits.pullback.snd V₀.hom j))
    have hsq : e_ψ.hom ≫ (B_j.map g).left = fst₁ ≫ e_sym.inv :=
      he_ψ_sq (B_j.map g).left hB_fst hB_snd
    obtain ⟨p_ψ, hp_ψ⟩ := hPullEx₀ e_ψ.hom
    have hbij_ψ : Function.Bijective p_ψ := hPullIsoBij e_ψ p_ψ hp_ψ
    obtain ⟨p_Bg, hp_Bg⟩ := hPullEx₀ (B_j.map g).left
    obtain ⟨p_tot, hp_tot⟩ := hPullEx₀ (fst₁ ≫ e_sym.inv)
    have htot1 : p_tot = p₁.comp p_sym :=
      hPullComp₀ fst₁ e_sym.inv p₁ p_sym p_tot hp₁ hp_sym hp_tot
    have hp_tot' : Pull (e_ψ.hom ≫ (B_j.map g).left) p_tot :=
      (congrArg (fun k => Pull k p_tot) hsq).mpr hp_tot
    have htot2 : p_tot = p_ψ.comp p_Bg :=
      hPullComp₀ e_ψ.hom (B_j.map g).left p_ψ p_Bg p_tot hp_ψ hp_Bg hp_tot'
    have hval : p₁ (E_W s) = p_ψ (Θ_U (B_j.obj V₀) ((Q.map g.op).hom s)) := by
      have h1 : p₁ (E_W s) = p_tot (Θ_U (B_j.obj W₀) s) :=
        (congrFun (congrArg DFunLike.coe htot1) (Θ_U (B_j.obj W₀) s)).symm
      have h2 : p_tot (Θ_U (B_j.obj W₀) s) = p_ψ (p_Bg (Θ_U (B_j.obj W₀) s)) :=
        congrFun (congrArg DFunLike.coe htot2) (Θ_U (B_j.obj W₀) s)
      have h3 : p_Bg (Θ_U (B_j.obj W₀) s) = Θ_U (B_j.obj V₀) ((Q.map g.op).hom s) :=
        (hΘ_U (B_j.map g) p_Bg hp_Bg s).symm
      exact h1.trans (h2.trans (congrArg p_ψ h3))
    refine ⟨fun h0 => ?_, fun h0 => ?_⟩
    · exact (Θ_U (B_j.obj V₀)).injective
        ((hbij_ψ.1 ((hval.symm.trans h0).trans (map_zero p_ψ).symm)).trans
          (map_zero (Θ_U (B_j.obj V₀))).symm)
    · exact hval.trans
        ((congrArg p_ψ ((congrArg (Θ_U (B_j.obj V₀)) h0).trans
          (map_zero (Θ_U (B_j.obj V₀))))).trans (map_zero p_ψ))

  have hSiteCoverIff : ∀ (H : AlgebraicGeometry.Scheme.{u} → Type u) [∀ S, AddCommGroup (H S)]
      (Pull : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}, (S₁ ⟶ S₂) → (H S₂ →+ H S₁) → Prop)
      (Q : (Opposite Y.Etale) ⥤ AddCommGrpCat.{u})
      (ZeroQ : Prop),
      (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂), ∃ p : H S₂ →+ H S₁, Pull h p) →
      (∀ (W₀ : Y.Etale),
        ∃ (E_W : ↥(Q.obj (Opposite.op W₀)) ≃+ H (CategoryTheory.Limits.pullback j W₀.hom)),
          ∀ {V₀ : Y.Etale} (g : V₀ ⟶ W₀) (s : ↥(Q.obj (Opposite.op W₀)))
            (p₁ : H (CategoryTheory.Limits.pullback j W₀.hom) →+
              H (CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j W₀.hom) g.left)),
            Pull (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j W₀.hom) g.left) p₁ →
            (p₁ (E_W s) = 0 ↔ (Q.map g.op).hom s = 0)) →
      ((ZeroQ → ∀ (W₀ : Y.Etale) (s₀ : ↥(Q.obj (Opposite.op W₀))),
         ∃ R₀ ∈ Y.smallEtaleTopology W₀,
           ∀ {Y₀ : Y.Etale} (g : Y₀ ⟶ W₀), R₀.arrows g → (Q.map g.op).hom s₀ = 0) ∧
       ((∀ (E : Y.Etale) (s : ↥(Q.obj (Opposite.op E))),
         ∃ R₀ ∈ Y.smallEtaleTopology E,
           ∀ {Z : Y.Etale} (g : Z ⟶ E), R₀.arrows g → (Q.map g.op).hom s = 0) → ZeroQ)) →
      (ZeroQ →
        ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
          (ξ : H (CategoryTheory.Limits.pullback j w)),
          ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
            (_ : ∀ a, AlgebraicGeometry.IsAffine (V a))
            (v : ∀ a, V a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (v a)),
            (⋃ a, Set.range (v a).base) = Set.univ ∧
            ∀ (a : I)
              (p_a : H (CategoryTheory.Limits.pullback j w) →+
                H (CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) (v a))),
              Pull (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j w) (v a)) p_a →
              p_a ξ = 0) ∧
      ((∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
          (ξ : H (CategoryTheory.Limits.pullback j w)),
          ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
            (u : ∀ a, V a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (u a)),
            (⋃ a, Set.range (u a).base) = Set.univ ∧
            ∀ (a : I)
              (p_a : H (CategoryTheory.Limits.pullback j w) →+
                H (CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) (u a))),
              Pull (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j w) (u a)) p_a →
              p_a ξ = 0) →
        ZeroQ) := by
    clear * -
    intro H _ Pull Q ZeroQ hPullEx₀ hSymEquiv hShZero
    classical
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hMemEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U₀ : Z.Etale)
        (R : CategoryTheory.Sieve U₀),
        R ∈ Z.smallEtaleTopology U₀ ↔
          ∀ (x : ↥U₀.left), ∃ (E : Z.Etale) (g : E ⟶ U₀) (y : ↥E.left),
            R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
      intro Z U₀ R
      have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Z (le_refl (@AlgebraicGeometry.Etale :
          CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
      have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) Z
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        inferInstance inferInstance inferInstance inferInstance U₀ R
      exact (iff_of_eq
        (congrArg (fun K : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ K U₀) heq)).trans hiff
    constructor
    · intro hZero W _ w _ ξ
      let W₀ : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w inferInstance
      obtain ⟨E_W₀, hE_W₀⟩ := hSymEquiv W₀
      let s₀ : ↥(Q.obj (Opposite.op W₀)) := E_W₀.symm ξ
      obtain ⟨R₀, hR₀_mem, hR₀_kill⟩ := hShZero.1 hZero W₀ s₀
      have hPoint : ∀ x : ↥W,
          ∃ (V_x : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine V_x)
            (v_x : V_x ⟶ W) (_ : AlgebraicGeometry.Etale v_x),
            x ∈ Set.range v_x.base ∧
            ∀ (p_x : H (CategoryTheory.Limits.pullback j w) →+
                H (CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd j w) v_x)),
              Pull (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j w) v_x) p_x →
              p_x ξ = 0 := by
        intro x
        obtain ⟨Y_x, g_x, y_x, hg_arr, hg_et, hg_pt⟩ := (hMemEtale Y W₀ R₀).mp hR₀_mem x
        obtain ⟨O_x, hAffO, hyO, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
            (x := y_x) (U := (⊤ : Y_x.left.Opens)) trivial
        let V_x : AlgebraicGeometry.Scheme.{u} := O_x.toScheme
        let v_x : V_x ⟶ W := O_x.ι ≫ g_x.left
        have hOx_et : AlgebraicGeometry.Etale O_x.ι := inferInstance
        have hv_et : AlgebraicGeometry.Etale v_x :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O_x.ι g_x.left hOx_et hg_et
        have hvY_et : AlgebraicGeometry.Etale (O_x.ι ≫ Y_x.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O_x.ι Y_x.hom hOx_et Y_x.prop
        let V₀_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ Y_x.hom) hvY_et
        let j_Ox : V₀_et ⟶ Y_x := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
        have hs₀_jx : (Q.map (j_Ox ≫ g_x).op).hom s₀ = 0 :=
          hR₀_kill (j_Ox ≫ g_x) (R₀.downward_closed hg_arr j_Ox)
        refine ⟨V_x, hAffO, v_x, hv_et, ⟨⟨y_x, hyO⟩, hg_pt⟩, fun p_x hp_x => ?_⟩
        exact (congrArg p_x (E_W₀.apply_symm_apply ξ).symm).trans
          ((hE_W₀ (j_Ox ≫ g_x) s₀ p_x hp_x).mpr hs₀_jx)
      refine ⟨↥W, fun x => (hPoint x).choose,
        fun x => (hPoint x).choose_spec.choose,
        fun x => (hPoint x).choose_spec.choose_spec.choose,
        fun x => (hPoint x).choose_spec.choose_spec.choose_spec.choose, ?_,
        fun x => (hPoint x).choose_spec.choose_spec.choose_spec.choose_spec.2⟩
      apply Set.eq_univ_of_forall
      intro x
      exact Set.mem_iUnion.mpr ⟨x, (hPoint x).choose_spec.choose_spec.choose_spec.choose_spec.1⟩
    · intro hKill
      apply hShZero.2
      intro E s
      have hE_et : AlgebraicGeometry.Etale E.hom := E.prop
      let R_zero : CategoryTheory.Sieve E :=
        { arrows := fun {Z} g => (Q.map g.op).hom s = 0
          downward_closed := fun {Z₁ Z₂} g hg k => by
            have hmap : Q.map (k ≫ g).op = Q.map g.op ≫ Q.map k.op :=
              Q.map_comp g.op k.op
            exact (congrArg (fun φ => φ.hom s) hmap).trans
              ((congrArg (Q.map k.op).hom hg).trans (map_zero (Q.map k.op).hom)) }
      refine ⟨R_zero, ?_, fun _ hg => hg⟩
      rw [hMemEtale Y E R_zero]
      intro x
      obtain ⟨O_x, hAffO, hxO, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x) (U := (⊤ : E.left.Opens)) trivial
      have hOx_et : AlgebraicGeometry.Etale O_x.ι := inferInstance
      have hW_et : AlgebraicGeometry.Etale (O_x.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_x.ι E.hom hOx_et hE_et
      let W_x : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ E.hom) hW_et
      let _ : AlgebraicGeometry.IsAffine W_x.left := hAffO
      let j_x : W_x ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
      obtain ⟨E_Wx, hE_Wx⟩ := hSymEquiv W_x
      let s_x : ↥(Q.obj (Opposite.op W_x)) := (Q.map j_x.op).hom s
      obtain ⟨I, V, u_cov, hu_et, hu_surj, hu_kill⟩ := hKill W_x.left W_x.hom (E_Wx s_x)
      have hmem_univ : (⟨x, hxO⟩ : ↥W_x.left) ∈ ⋃ a : I, Set.range (u_cov a).base := by
        rw [hu_surj]; trivial
      obtain ⟨a, y, hy⟩ := Set.mem_iUnion.mp hmem_univ
      have hvY_et : AlgebraicGeometry.Etale (u_cov a ≫ W_x.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (u_cov a) W_x.hom (hu_et a) W_x.prop
      let V_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (u_cov a ≫ W_x.hom) hvY_et
      let g_a : V_et ⟶ W_x := CategoryTheory.MorphismProperty.Over.homMk (u_cov a) rfl
      obtain ⟨p_a, hp_a⟩ := hPullEx₀
        (CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd j W_x.hom) (u_cov a))
      have hp_zero : p_a (E_Wx s_x) = 0 := hu_kill a p_a hp_a
      have hQ_ga : (Q.map g_a.op).hom s_x = 0 := (hE_Wx g_a s_x p_a hp_a).mp hp_zero
      refine ⟨V_et, g_a ≫ j_x, y, ?_, ?_, ?_⟩
      · have hmap : Q.map (g_a ≫ j_x).op = Q.map j_x.op ≫ Q.map g_a.op :=
          Q.map_comp j_x.op g_a.op
        exact (congrArg (fun φ => φ.hom s) hmap).trans hQ_ga
      · exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (u_cov a) O_x.ι (hu_et a) hOx_et
      · change O_x.ι.base ((u_cov a).base y) = x
        rw [hy]; rfl

