  have hK_jπ_acyc : ∀ (n p : ℕ), 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage (j ≫ π.left) p (K_syr n)) := by
    intro n p hp
    letI : CategoryTheory.Injective (I_syr n) := hInjI n
    exact weil_leray_sec_mod_prime_injective_higherDirectImage_isZero.{u}
      ℓ (j ≫ π.left) (I_syr n) p hp

  have hpfK_π_acyc : ∀ (n p : ℕ), 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π.left p (pf_j.obj (K_syr n))) := by
    intro n p hp
    letI : CategoryTheory.Injective (I_syr n) := hInjI n
    obtain ⟨I_P, hInjIP, ⟨e_KP⟩⟩ := hPushInj j (I_syr n)
    letI : CategoryTheory.Injective I_P := hInjIP
