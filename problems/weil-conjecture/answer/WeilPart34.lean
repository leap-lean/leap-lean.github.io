        (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ U₀)
        (H_z : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback (z ≫ ι_chart) Rq H_z →
        Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) = Nat.card ↥B_gen := by
    intro ι_chart _ hι_hom K _ _ z H_z hPB_Hz
    let φ_z : Polynomial k →+* K := (AlgebraicGeometry.Spec.preimage z).hom
    have hz_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_z) = z :=
      AlgebraicGeometry.Spec.map_preimage z
    by_cases hker : RingHom.ker φ_z = ⊥
    · have hz_bot : z.base (⊥ : PrimeSpectrum K) = (⊥ : PrimeSpectrum (Polynomial k)) := by
        rw [← hz_eq]
        apply PrimeSpectrum.ext
        exact hker
      have hmem : (z ≫ ι_chart).base (⊥ : PrimeSpectrum K) ∈ U_lc := by
        change ι_chart.base (z.base (⊥ : PrimeSpectrum K)) ∈ U_lc
        rw [hz_bot]
        exact hGenMemOpen ι_chart
      exact hGenStalkCard K (z ≫ ι_chart) hmem H_z hPB_Hz
    · obtain ⟨a, ha_fac⟩ := hPolyHomClosed K φ_z hker
      let u_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_z.comp Polynomial.C))
      let s_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U₀ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))
      have hz_fac : z = u_K ≫ s_a := by
        rw [← hz_eq, ha_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
      obtain ⟨hτ_iso, hτ_hom, hs₀_τ, hker_ητ, hτ_bot⟩ := hPolyTrans a
      let sh_pos : Polynomial k →+* Polynomial k :=
        (Polynomial.aeval (Polynomial.X + Polynomial.C a)).toRingHom
      let τ_a : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom sh_pos)
      have _ : CategoryTheory.IsIso τ_a := hτ_iso
      let ι_a : U₀ ⟶ P_base.left := τ_a ≫ ι_chart
      have _ : AlgebraicGeometry.IsOpenImmersion ι_a := by dsimp [ι_a]; infer_instance
      have hι_a_hom : ι_a ≫ P_base.hom = p_A1 := by
        dsimp [ι_a]; rw [Category.assoc, hι_hom, hτ_hom]
      let X₀_left := CategoryTheory.Limits.pullback f.left ι_a
      let fst_a := CategoryTheory.Limits.pullback.fst f.left ι_a
      let f₀_left := CategoryTheory.Limits.pullback.snd f.left ι_a
      let hpb_a := CategoryTheory.IsPullback.of_hasPullback f.left ι_a
      have _ : AlgebraicGeometry.IsProper f₀_left :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_a inferInstance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension d_rel f₀_left :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_a inferInstance
      let X₀_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (f₀_left ≫ p_A1)
      let f₀_ov : X₀_ov ⟶ U₀_ov := CategoryTheory.Over.homMk f₀_left rfl
      have _ : AlgebraicGeometry.IsProper f₀_ov.left := by
        change AlgebraicGeometry.IsProper f₀_left; infer_instance
      have _ : AlgebraicGeometry.SmoothOfRelativeDimension d_rel f₀_ov.left := by
        change AlgebraicGeometry.SmoothOfRelativeDimension d_rel f₀_left; infer_instance
      let g_a_ov : U₀_ov ⟶ P_base := CategoryTheory.Over.homMk ι_a hι_a_hom
      let g'_a_ov : X₀_ov ⟶ Z := CategoryTheory.Over.homMk fst_a (by
        change fst_a ≫ Z.hom = f₀_left ≫ p_A1
        rw [← CategoryTheory.Over.w f, ← Category.assoc, hpb_a.w, Category.assoc, hι_a_hom])
      let G₀_a := weilEtaleHigherDirectImage f₀_ov.left q (weilEtaleTorsionSheaf X₀_ov.left ℓ)
      have hPB_G₀a : WeilIsEtaleSheafPullback ι_a Rq G₀_a :=
        hPBC Z P_base U₀_ov X₀_ov f g_a_ov f₀_ov g'_a_ov inferInstance hpb_a _ _
          (hTorsSh Z.left) (hConstPB_ex fst_a _) q
      
      obtain ⟨H_η, hPB_Hη, -⟩ := hExPB_ex η G₀_a
      have hPB_η_Rq : WeilIsEtaleSheafPullback (η ≫ ι_a) Rq H_η :=
        (hCompPB_ex η ι_a Rq G₀_a H_η).1 hPB_G₀a hPB_Hη
      have hητ_bot : (η ≫ τ_a).base (⊥ : PrimeSpectrum Ω) =
          (⊥ : PrimeSpectrum (Polynomial k)) := by
        have hmap := AlgebraicGeometry.Spec.map_preimage (η ≫ τ_a)
        rw [← hmap]
        apply PrimeSpectrum.ext
        exact hker_ητ
      have hη_mem : (η ≫ ι_a).base (⊥ : PrimeSpectrum Ω) ∈ U_lc := by
        change ι_chart.base ((η ≫ τ_a).base (⊥ : PrimeSpectrum Ω)) ∈ U_lc
        rw [hητ_bot]
        exact hGenMemOpen ι_chart
      have hCard_Hη := (hGenStalkCard Ω (η ≫ ι_a) hη_mem H_η hPB_η_Rq).2
      obtain ⟨e_Hη⟩ := hStalkEvalAt U₀_ov X₀_ov f₀_ov Ω η H_η hPB_Hη
      have hCard_Xη : Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀_ov.left η) ℓ q) =
          Nat.card ↥B_gen :=
        (Nat.card_congr e_Hη.symm.toEquiv).trans hCard_Hη
      have hCard_Xs₀ :
          Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀_ov.left s₀) ℓ q) =
          Nat.card ↥B_gen :=
        (hOrigin X₀_ov f₀_ov q).1.trans hCard_Xη
      
      let s_base : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P_base.left := s₀ ≫ ι_a
      have hs_base_eq : s_base = s_a ≫ ι_chart := by
        dsimp [s_base, ι_a]; rw [← Category.assoc, hs₀_τ]
      have hs_base_hom : s_base ≫ P_base.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        dsimp [s_base, s₀, p_A1]
        rw [Category.assoc, hι_a_hom, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_evC : (Polynomial.evalRingHom (0 : k)).comp Polynomial.C = RingHom.id k := by
          ext c; simp
        rw [h_evC, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      obtain ⟨H_s, hPB_Hs0, -⟩ := hExPB_ex s₀ G₀_a
      have hPB_Hs : WeilIsEtaleSheafPullback s_base Rq H_s :=
        (hCompPB_ex s₀ ι_a Rq G₀_a H_s).1 hPB_G₀a hPB_Hs0
      have hPB_z_comp : WeilIsEtaleSheafPullback (u_K ≫ s_base) Rq H_z := by
        rwa [hs_base_eq, ← Category.assoc, ← hz_fac]
      have hPB_uK : WeilIsEtaleSheafPullback u_K H_s H_z :=
        (hCompPB_ex u_K s_base Rq H_s H_z).2 hPB_Hs hPB_z_comp
      have _ : HenselianLocalRing k := Field.henselian k
      have _ : IsSepClosed (IsLocalRing.ResidueField k) := hSepRes k
      obtain ⟨e_z_s⟩ :=
        (weil_strictly_henselian_spec_etale_eval_and_pullback k).2 K u_K
          (fun pt => Subsingleton.elim (u_K.base pt) (IsLocalRing.closedPoint k))
          H_s H_z hPB_uK
      obtain ⟨e_Hs_Xs₀⟩ := hStalkEvalAt U₀_ov X₀_ov f₀_ov k s₀ H_s hPB_Hs0
      
      let Z_s_left := CategoryTheory.Limits.pullback f.left s_base
      let fst_sb := CategoryTheory.Limits.pullback.fst f.left s_base
      let snd_sb := CategoryTheory.Limits.pullback.snd f.left s_base
      let hpb_sb := CategoryTheory.IsPullback.of_hasPullback f.left s_base
      have _ : AlgebraicGeometry.IsProper snd_sb :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_sb inferInstance
      let Z_s_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk snd_sb
      have _ : AlgebraicGeometry.IsProper Z_s_ov.hom := by
        change AlgebraicGeometry.IsProper snd_sb; infer_instance
      have hFin_Zsb : Finite (weilEtaleTorsionH Z_s_left ℓ q) :=
        hRatFiberFinite s_base hs_base_hom Z_s_ov fst_sb hpb_sb
      have hpb_pasted : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst f₀_ov.left s₀ ≫ fst_a)
          (CategoryTheory.Limits.pullback.snd f₀_ov.left s₀) f.left s_base :=
        (CategoryTheory.IsPullback.of_hasPullback f₀_ov.left s₀).paste_horiz hpb_a
      obtain ⟨e_iso_Xs₀⟩ := hIsoH hpb_pasted.isoPullback q
      let e_tot_z : H_z.H 0 ≃+ weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀_ov.left s₀) ℓ q :=
        e_z_s.trans e_Hs_Xs₀
      have hFin_Xs₀ : Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀_ov.left s₀) ℓ q) :=
        Finite.of_equiv _ e_iso_Xs₀.symm.toEquiv
      exact ⟨Finite.of_equiv _ e_tot_z.symm.toEquiv,
        (Nat.card_congr e_tot_z.toEquiv).trans hCard_Xs₀⟩

  
  obtain ⟨ι_uchart, hOpen_uchart, φ_ubar, hι_uhom, hφ_ufac⟩ :=
    hStdChartOfSection k u_bar
  have _ : AlgebraicGeometry.IsOpenImmersion ι_uchart := hOpen_uchart
  obtain ⟨H_ubar, hPB_Hubar, -⟩ := hExPB_ex u_bar Rq
  have hPB_Hubar' : WeilIsEtaleSheafPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ubar) ≫ ι_uchart) Rq H_ubar := by
    rwa [hφ_ufac]
  have hCard_Hubar : Nat.card (H_ubar.H 0) = Nat.card ↥B_gen :=
    (hChartCard ι_uchart hι_uhom k (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ubar))
      H_ubar hPB_Hubar').2
  obtain ⟨e_Hubar⟩ := hStalkEvalAt P_base Z f k u_bar H_ubar hPB_Hubar
  obtain ⟨e_Zu_pb⟩ := hIsoH hPb_u.isoPullback q
  have hCard_A0_eq : Nat.card ↥A₀ = Nat.card ↥B_gen :=
    (Nat.card_congr e_Zu_pb.toEquiv).trans
      ((Nat.card_congr e_Hubar.symm.toEquiv).trans hCard_Hubar)

  refine ⟨hFin_A0, fun x => ?_⟩
  let κ_x : Type u := ↥(P_base.left.residueField x)
  let s_x : AlgebraicGeometry.Spec (CommRingCat.of κ_x) ⟶ P_base.left :=
    P_base.left.fromSpecResidueField x
  have hs_x_pt : s_x.base (⊥ : PrimeSpectrum κ_x) = x := by
    have hmem : s_x.base (⊥ : PrimeSpectrum κ_x) ∈ Set.range ⇑s_x.base := ⟨_, rfl⟩
    rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField, Set.mem_singleton_iff] at hmem
  obtain ⟨ι_x, hOpen_ιx, φ_x, hι_xhom, hφ_xfac⟩ := hStdChartOfSection κ_x s_x
  have _ : AlgebraicGeometry.IsOpenImmersion ι_x := hOpen_ιx
  let pt_x : ↥U₀ := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_x)).base (⊥ : PrimeSpectrum κ_x)
  have hι_x_pt : ι_x.base pt_x = x := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_x) ≫ ι_x).base (⊥ : PrimeSpectrum κ_x) = x
    rw [hφ_xfac]
    exact hs_x_pt
  have hex_a : ∃ a : k,
      (pt_x = (⊥ : PrimeSpectrum (Polynomial k)) ∧ a = 0) ∨
      pt_x = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))).base
        (⊥ : PrimeSpectrum k) := by
    by_cases hbot : pt_x.asIdeal = ⊥
    · exact ⟨0, Or.inl ⟨PrimeSpectrum.ext hbot, rfl⟩⟩
    · obtain ⟨a, ha_ker⟩ := hPolyPrime pt_x hbot
      refine ⟨a, Or.inr ?_⟩
      apply PrimeSpectrum.ext
      change pt_x.asIdeal = Ideal.comap (Polynomial.evalRingHom a) ⊥
      exact ha_ker
  obtain ⟨a, ha_pt⟩ := hex_a
  obtain ⟨hτ_iso, hτ_hom, hs₀_τ, _, hτ_bot⟩ := hPolyTrans a
  let sh_pos : Polynomial k →+* Polynomial k :=
    (Polynomial.aeval (Polynomial.X + Polynomial.C a)).toRingHom
  let τ_a : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom sh_pos)
  have _ : CategoryTheory.IsIso τ_a := hτ_iso
  let ι_xa : U₀ ⟶ P_base.left := τ_a ≫ ι_x
  have _ : AlgebraicGeometry.IsOpenImmersion ι_xa := by dsimp [ι_xa]; infer_instance
  have hι_xa_hom : ι_xa ≫ P_base.hom = p_A1 := by
    dsimp [ι_xa]; rw [Category.assoc, hι_xhom, hτ_hom]
  let X₀_xa_left := CategoryTheory.Limits.pullback f.left ι_xa
  let fst_xa := CategoryTheory.Limits.pullback.fst f.left ι_xa
  let f₀_xa_left := CategoryTheory.Limits.pullback.snd f.left ι_xa
  let hpb_xa := CategoryTheory.IsPullback.of_hasPullback f.left ι_xa
  have _ : AlgebraicGeometry.IsProper f₀_xa_left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_xa inferInstance
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension d_rel f₀_xa_left :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_xa inferInstance
  let X₀_xa : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (f₀_xa_left ≫ p_A1)
  let f₀_xa : X₀_xa ⟶ U₀_ov := CategoryTheory.Over.homMk f₀_xa_left rfl
  have _ : AlgebraicGeometry.IsProper f₀_xa.left := by
    change AlgebraicGeometry.IsProper f₀_xa_left; infer_instance
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension d_rel f₀_xa.left := by
    change AlgebraicGeometry.SmoothOfRelativeDimension d_rel f₀_xa_left; infer_instance
  let g_xa_ov : U₀_ov ⟶ P_base := CategoryTheory.Over.homMk ι_xa hι_xa_hom
  let g'_xa_ov : X₀_xa ⟶ Z := CategoryTheory.Over.homMk fst_xa (by
    change fst_xa ≫ Z.hom = f₀_xa_left ≫ p_A1
    rw [← CategoryTheory.Over.w f, ← Category.assoc, hpb_xa.w, Category.assoc, hι_xa_hom])
  let G₀_xa := weilEtaleHigherDirectImage f₀_xa.left q (weilEtaleTorsionSheaf X₀_xa.left ℓ)
  have hPB_G₀xa : WeilIsEtaleSheafPullback ι_xa Rq G₀_xa :=
    hPBC Z P_base U₀_ov X₀_xa f g_xa_ov f₀_xa g'_xa_ov inferInstance hpb_xa _ _
      (hTorsSh Z.left) (hConstPB_ex fst_xa _) q
  let X_s₀ := CategoryTheory.Limits.pullback f₀_xa.left s₀
  let M₀ : AddCommGrpCat.{u} := AddCommGrpCat.of (weilEtaleTorsionH X_s₀ ℓ q)
  obtain ⟨H_s₀_x, hPB_Hs₀x, -⟩ := hExPB_ex s₀ G₀_xa
  have hPB_Hs₀x_Rq : WeilIsEtaleSheafPullback (s₀ ≫ ι_xa) Rq H_s₀_x :=
    (hCompPB_ex s₀ ι_xa Rq G₀_xa H_s₀_x).1 hPB_G₀xa hPB_Hs₀x
  obtain ⟨hFin_Hs₀x, hCard_Hs₀x⟩ := hChartCard ι_xa hι_xa_hom k s₀ H_s₀_x hPB_Hs₀x_Rq
  obtain ⟨e_Hs₀x_M0⟩ := hStalkEvalAt U₀_ov X₀_xa f₀_xa k s₀ H_s₀_x hPB_Hs₀x
  have hFin_M0 : Finite ↥M₀ := Finite.of_equiv _ e_Hs₀x_M0.toEquiv
  have _ : Finite ↥M₀ := hFin_M0
  have hCard_M0 : Nat.card ↥M₀ = Nat.card ↥B_gen :=
    (Nat.card_congr e_Hs₀x_M0.symm.toEquiv).trans hCard_Hs₀x
  obtain ⟨W₀, _, _, w₀, hEt_w₀, s_W, η_W, G_W, Φ, hs_W, hη_W, hDense_ηW, hPB_GW, hKer_ηW⟩ :=
    (hOrigin X₀_xa f₀_xa q).2 hFin_M0
  have _ : AlgebraicGeometry.Etale w₀ := hEt_w₀
  let w : W₀ ⟶ P_base.left := w₀ ≫ ι_xa
  have hw_et : AlgebraicGeometry.Etale w := by dsimp [w]; infer_instance
  have hPB_w : WeilIsEtaleSheafPullback w Rq G_W :=
    (hCompPB_ex w₀ ι_xa Rq G₀_xa G_W).1 hPB_G₀xa hPB_GW
  have hCard_W : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (z : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ W₀)
      (H_z : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback z G_W H_z →
      Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ Nat.card ↥M₀ := by
    intro K _ _ z H_z hPB_zG
    have hPB_zRq : WeilIsEtaleSheafPullback ((z ≫ w₀) ≫ ι_xa) Rq H_z := by
      rw [Category.assoc]
      exact (hCompPB_ex z w Rq G_W H_z).1 hPB_w hPB_zG
    obtain ⟨hFin_Hz, hEq_Hz⟩ := hChartCard ι_xa hι_xa_hom K (z ≫ w₀) H_z hPB_zRq
    exact ⟨hFin_Hz, le_of_eq (hEq_Hz.trans hCard_M0.symm)⟩
  have _ : CategoryTheory.IsIso Φ :=
    hPromoteIso W₀ Ω η_W hDense_ηW M₀ G_W Φ hKer_ηW hCard_W
  obtain ⟨e_MA⟩ :=
    hTorsIsoOfCardEq M₀ A₀ (hTorsH X_s₀) (hTorsH Z_u.left)
      (hCard_M0.trans hCard_A0_eq.symm)
  let C_W₀ := CategoryTheory.constantSheaf W₀.smallEtaleTopology AddCommGrpCat.{u}
  have hPB_final : WeilIsEtaleSheafPullback w Rq (C_W₀.obj A₀) :=
    hIsoPB_ex w Rq Rq G_W (C_W₀.obj A₀) hPB_w ⟨CategoryTheory.Iso.refl Rq⟩
      ⟨(CategoryTheory.asIso Φ).symm ≪≫ C_W₀.mapIso e_MA⟩
  refine ⟨W₀, w, hw_et, ?_, hPB_final⟩
  rcases ha_pt with ⟨hpt_bot, _⟩ | hpt_sa
  · refine ⟨η_W.base (⊥ : PrimeSpectrum Ω), ?_⟩
    have hη_bot : η.base (⊥ : PrimeSpectrum Ω) = (⊥ : PrimeSpectrum (Polynomial k)) := by
      apply PrimeSpectrum.ext
      change Ideal.comap (algebraMap (Polynomial k) Ω) ⊥ = ⊥
      ext p
      rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
      have hinj_Ω : Function.Injective (algebraMap (Polynomial k) Ω) :=
        (IsScalarTower.algebraMap_eq (Polynomial k) (FractionRing (Polynomial k)) Ω) ▸
          ((RingHom.injective (algebraMap (FractionRing (Polynomial k)) Ω)).comp
            (IsFractionRing.injective (Polynomial k) (FractionRing (Polynomial k))))
      exact ⟨fun h0 => hinj_Ω (h0.trans (map_zero _).symm), fun hp => by rw [hp, map_zero]⟩
    change (η_W ≫ w₀ ≫ τ_a ≫ ι_x).base (⊥ : PrimeSpectrum Ω) = x
    rw [← Category.assoc η_W w₀, hη_W]
    change ι_x.base (τ_a.base (η.base (⊥ : PrimeSpectrum Ω))) = x
    rw [hη_bot, hτ_bot, ← hpt_bot, hι_x_pt]
  · refine ⟨s_W.base (⊥ : PrimeSpectrum k), ?_⟩
    change (s_W ≫ w₀ ≫ τ_a ≫ ι_x).base (⊥ : PrimeSpectrum k) = x
    rw [← Category.assoc s_W w₀, hs_W, ← Category.assoc s₀ τ_a, hs₀_τ]
    change ι_x.base ((AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (Polynomial.evalRingHom a))).base (⊥ : PrimeSpectrum k)) = x
    rw [← hpt_sa, hι_x_pt]

theorem weil_sm_pencil_p1_base_cd2_and_frob_h2_tower (k : Type u) [Field k] [IsAlgClosed k]
    (P_over : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper P_over.hom]
    (hDim : topologicalKrullDim P_over.left ≤ (1 : WithBot ℕ∞))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (hH1 : Subsingleton (weilEtaleTorsionH P_over.left ℓ 1))
    (hH3 : ∀ p : ℕ, 3 ≤ p → Subsingleton (weilEtaleTorsionH P_over.left ℓ p))
    (hH2 : Nat.card (weilEtaleTorsionH P_over.left ℓ 2) = ℓ) :
    (∀ (r p : ℕ), 3 ≤ p →
      ∀ (𝒢 : CategoryTheory.Sheaf P_over.left.smallEtaleTopology AddCommGrpCat.{u}),
        (ℓ ^ r) • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
        Subsingleton (𝒢.H p)) ∧
    (∀ (r : ℕ) (A : AddCommGrpCat.{u}),
      Finite ↥A →
      (ℓ ^ r) • CategoryTheory.CategoryStruct.id A = 0 →
      Subsingleton
        (((CategoryTheory.constantSheaf P_over.left.smallEtaleTopology AddCommGrpCat.{u}).obj A).H 1)) ∧
    (∃ ω : ∀ r : ℕ, weilEtaleTorsionH P_over.left (ℓ ^ r) 2,
      (∀ r : ℕ, weilEtaleTorsionTransition P_over.left ℓ r 2 (ω (r + 1)) = ω r) ∧
      (∀ (r : ℕ) (A : AddCommGrpCat.{u}),
        Finite ↥A →
        (ℓ ^ r) • CategoryTheory.CategoryStruct.id A = 0 →
        ∀ z : ((CategoryTheory.constantSheaf P_over.left.smallEtaleTopology AddCommGrpCat.{u}).obj A).H 2,
          ∃ φ : AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r))) ⟶ A,
            ((CategoryTheory.Abelian.Ext.mk₀
              ((CategoryTheory.constantSheaf P_over.left.smallEtaleTopology AddCommGrpCat.{u}).map φ)).postcomp
              ((CategoryTheory.constantSheaf P_over.left.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              (Nat.add_zero 2)) (ω r) = z)) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  let S := P_over.left
  let J := S.smallEtaleTopology
  let 𝒜 := CategoryTheory.Sheaf J AddCommGrpCat.{u}
  let C : AddCommGrpCat.{u} ⥤ 𝒜 := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  have : C.Additive := by
    dsimp [C]
    unfold CategoryTheory.constantSheaf
    infer_instance
  have : CategoryTheory.Limits.PreservesFiniteLimits C := by
    dsimp [C]
    unfold CategoryTheory.constantSheaf
    infer_instance
  have : CategoryTheory.Limits.PreservesFiniteColimits C := by
    dsimp [C]
    unfold CategoryTheory.constantSheaf
    infer_instance
  let X₀ : 𝒜 := C.obj (AddCommGrpCat.of (ULift.{u} ℤ))
  let U := AddCommGrpCat.uliftFunctor.{u, 0}
  let AM : ℕ → AddCommGrpCat.{u} := fun n => U.obj (AddCommGrpCat.of (ZMod n))

  
  have hColimProper : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.IsProper B.hom] (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)] (q : ℕ),
      (∀ (ℬ : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ₀ B.left ℬ → Subsingleton (ℬ.H q)) →
      ∀ (ℱ : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ₀ • CategoryTheory.CategoryStruct.id ℱ = 0 → Subsingleton (ℱ.H q) := by
    intro k₀ _ _ B _ ℓ₀ hP q
    exact (weil_etale_noetherian_ind_godement_and_colimit_reduction k₀ B).1 ℓ₀ q
      (weil_etale_ordinary_godement_resolution B.left ℓ₀ hP.out.one_le)

  have hCurveVanish : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom],
      AlgebraicGeometry.IsIntegral C₀.left →
      IsProjectiveOverField k₀ C₀ →
      ∀ (ℓ₀ : ℕ) [Fact (Nat.Prime ℓ₀)], (ℓ₀ : k₀) ≠ 0 →
      ∀ (q : ℕ), 3 ≤ q → Subsingleton (weilEtaleTorsionH C₀.left ℓ₀ q) := by
    intro k₀ _ _ C₀ _ hIntC hProjC ℓ₀ _ hℓ₀ q hq
    exact (weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C₀ hIntC hProjC ℓ₀ hℓ₀).2.1 q hq

  have hModPrimeCD2 : ∀ (p : ℕ), 3 ≤ p →
      ∀ (𝒢 : 𝒜), ℓ • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ 𝒢 p) := by
    intro p hp 𝒢 h𝒢
    have hp_gt : 2 * 1 < p := by omega
    exact hColimProper k P_over ℓ p
      (fun ℬ hℬ => weil_etale_proper_constructible_cohomological_dim_le_two_mul
        weil_etale_proper_base_change_mod_prime hCurveVanish hColimProper
        k P_over 1 ℓ hℓ_k hDim ℬ hℬ p hp_gt)
      𝒢 h𝒢

  
  have hPostId : ∀ {Y : 𝒜} {q : ℕ} (x : CategoryTheory.Abelian.Ext.{u} X₀ Y q),
      ((CategoryTheory.Abelian.Ext.mk₀ (𝟙 Y)).postcomp X₀ (Nat.add_zero q)) x = x := by
    intro Y q x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 Y)) (Nat.add_zero q) = x
    exact CategoryTheory.Abelian.Ext.comp_mk₀_id x

  have hPostZero : ∀ {Y₁ Y₂ : 𝒜} {q : ℕ} (x : CategoryTheory.Abelian.Ext.{u} X₀ Y₁ q),
      ((CategoryTheory.Abelian.Ext.mk₀ (0 : Y₁ ⟶ Y₂)).postcomp X₀ (Nat.add_zero q)) x = 0 := by
    intro Y₁ Y₂ q x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : Y₁ ⟶ Y₂)) (Nat.add_zero q) = 0
    rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  have hPostAdd : ∀ {Y₁ Y₂ : 𝒜} {q : ℕ} (f₁ f₂ : Y₁ ⟶ Y₂)
      (x : CategoryTheory.Abelian.Ext.{u} X₀ Y₁ q),
      ((CategoryTheory.Abelian.Ext.mk₀ (f₁ + f₂)).postcomp X₀ (Nat.add_zero q)) x =
        ((CategoryTheory.Abelian.Ext.mk₀ f₁).postcomp X₀ (Nat.add_zero q)) x +
        ((CategoryTheory.Abelian.Ext.mk₀ f₂).postcomp X₀ (Nat.add_zero q)) x := by
    intro Y₁ Y₂ q f₁ f₂ x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (f₁ + f₂)) (Nat.add_zero q) = _
    rw [CategoryTheory.Abelian.Ext.mk₀_add]
    exact CategoryTheory.Abelian.Ext.comp_add x _ _ (Nat.add_zero q)

  have hPostComp : ∀ {Y₁ Y₂ Y₃ : 𝒜} {q : ℕ} (f : Y₁ ⟶ Y₂) (g : Y₂ ⟶ Y₃)
      (x : CategoryTheory.Abelian.Ext.{u} X₀ Y₁ q),
      ((CategoryTheory.Abelian.Ext.mk₀ (f ≫ g)).postcomp X₀ (Nat.add_zero q)) x =
        ((CategoryTheory.Abelian.Ext.mk₀ g).postcomp X₀ (Nat.add_zero q))
          (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp X₀ (Nat.add_zero q)) x) := by
    intro Y₁ Y₂ Y₃ q f g x
    change x.comp (CategoryTheory.Abelian.Ext.mk₀ (f ≫ g)) (Nat.add_zero q) =
      (x.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ g) (Nat.add_zero q)
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]

  have hPostNsmul : ∀ {Y₁ Y₂ : 𝒜} {q : ℕ} (k_n : ℕ) (f : Y₁ ⟶ Y₂)
      (x : CategoryTheory.Abelian.Ext.{u} X₀ Y₁ q),
      ((CategoryTheory.Abelian.Ext.mk₀ (k_n • f)).postcomp X₀ (Nat.add_zero q)) x =
        k_n • (((CategoryTheory.Abelian.Ext.mk₀ f).postcomp X₀ (Nat.add_zero q)) x) := by
    intro Y₁ Y₂ q k_n f x
    induction k_n with
    | zero => rw [zero_nsmul, zero_nsmul, hPostZero]
    | succ k_n ih => rw [succ_nsmul, succ_nsmul, hPostAdd, ih]

  have hExtNsmulZero : ∀ {Y : 𝒜} {q : ℕ} (n : ℕ),
      n • CategoryTheory.CategoryStruct.id Y = 0 →
      ∀ x : CategoryTheory.Abelian.Ext.{u} X₀ Y q, n • x = 0 := by
    intro Y q n hn x
    have h := hPostNsmul n (𝟙 Y) x
    change ((CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id Y)).postcomp
      X₀ (Nat.add_zero q)) x = _ at h
    rw [hn, hPostZero, hPostId] at h
    exact h.symm

  have hSubOfIdZero : ∀ {Y : 𝒜} (q : ℕ),
      CategoryTheory.CategoryStruct.id Y = 0 →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ Y q) := by
    intro Y q h0
    have hn : (1 : ℕ) • CategoryTheory.CategoryStruct.id Y = 0 := by
      rw [one_nsmul]; exact h0
    refine ⟨fun x y => ?_⟩
    have hx := hExtNsmulZero 1 hn x
    have hy := hExtNsmulZero 1 hn y
    rw [one_nsmul] at hx hy
    exact hx.trans hy.symm

  have hTorElem : ∀ {n : ℕ} {A : AddCommGrpCat.{u}},
      n • CategoryTheory.CategoryStruct.id A = 0 → ∀ x : ↥A, n • x = 0 := by
    intro n A hA x
    have h1 := congrArg (fun φ : A ⟶ A => φ.hom x) hA
    simpa using h1

  have hModSmul : ∀ {n : ℕ} {M : Type u} [AddCommGroup M] (hn : ∀ x : M, n • x = 0)
      (k_val : ℕ) (x : M), (k_val % n) • x = k_val • x := by
    intro n M _ hn k_val x
    conv_rhs => rw [← Nat.div_add_mod k_val n]
    rw [add_nsmul, mul_comm, mul_smul, hn x, smul_zero, zero_add]

  
  have hBezoutPrimeHom : ∀ {M : Type u} [AddCommGroup M] (b₀ : M),
      b₀ ≠ 0 → ℓ • b₀ = 0 →
      ∃ ψ : ZMod ℓ →+ M, Function.Injective ψ ∧ ∀ z : ZMod ℓ, ψ z = z.val • b₀ := by
    intro M _ b₀ hb_ne hb_tor
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have hmod_b₀ : ∀ n : ℕ, (n % ℓ) • b₀ = n • b₀ := by
      intro n
      conv_rhs => rw [← Nat.div_add_mod n ℓ]
      rw [add_nsmul, mul_comm, mul_smul, hb_tor, smul_zero, zero_add]
    let ψ : ZMod ℓ →+ M :=
      { toFun := fun z => z.val • b₀
        map_zero' := by rw [ZMod.val_zero, zero_nsmul]
        map_add' := fun x y => by rw [ZMod.val_add, hmod_b₀, add_nsmul] }
    refine ⟨ψ, (injective_iff_map_eq_zero ψ).mpr ?_, fun _ => rfl⟩
    intro z hz
    by_contra hz_ne
    have hval_ne : z.val ≠ 0 := fun hv =>
      hz_ne (by rw [← ZMod.natCast_zmod_val z, hv, Nat.cast_zero])
    have hval_pos : 0 < z.val := Nat.pos_of_ne_zero hval_ne
    have hval_lt : z.val < ℓ := ZMod.val_lt z
    have hndvd : ¬ (ℓ ∣ z.val) := Nat.not_dvd_of_pos_of_lt hval_pos hval_lt
    have hcop : Nat.Coprime ℓ z.val := (hPrime.coprime_iff_not_dvd).mpr hndvd
    have hbez := Nat.gcd_eq_gcd_ab ℓ z.val
    rw [hcop.gcd_eq_one, Nat.cast_one] at hbez
    have hb0_eq : b₀ = 0 := by
      calc b₀ = (1 : ℤ) • b₀ := (one_zsmul b₀).symm
        _ = ((ℓ : ℤ) * Nat.gcdA ℓ z.val + (z.val : ℤ) * Nat.gcdB ℓ z.val) • b₀ := by rw [← hbez]
        _ = (Nat.gcdA ℓ z.val * (ℓ : ℤ)) • b₀ + (Nat.gcdB ℓ z.val * (z.val : ℤ)) • b₀ := by
            rw [mul_comm (ℓ : ℤ), mul_comm (z.val : ℤ), add_zsmul]
        _ = Nat.gcdA ℓ z.val • ((ℓ : ℤ) • b₀) + Nat.gcdB ℓ z.val • ((z.val : ℤ) • b₀) := by
            rw [mul_zsmul, mul_zsmul]
        _ = Nat.gcdA ℓ z.val • (ℓ • b₀) + Nat.gcdB ℓ z.val • (z.val • b₀) := by
            rw [natCast_zsmul, natCast_zsmul]
        _ = 0 := by
            change Nat.gcdA ℓ z.val • (ℓ • b₀) + Nat.gcdB ℓ z.val • ψ z = 0
            rw [hb_tor, hz, smul_zero, smul_zero, add_zero]
    exact hb_ne hb0_eq

  
  have hCD2 : ∀ (r p : ℕ), 3 ≤ p →
      ∀ (𝒢 : 𝒜), (ℓ ^ r) • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ 𝒢 p) := by
    intro r
    induction r with
    | zero =>
      intro p _ 𝒢 h𝒢
      rw [pow_zero, one_nsmul] at h𝒢
      exact hSubOfIdZero p h𝒢
    | succ r ih =>
      intro p hp 𝒢 h𝒢
      let φ : 𝒢 ⟶ 𝒢 := ℓ • 𝟙 𝒢
      let K := CategoryTheory.Limits.kernel φ
      let Im := CategoryTheory.Limits.image φ
      have hcomp0 : CategoryTheory.Limits.kernel.ι φ ≫
          CategoryTheory.Limits.factorThruImage φ = 0 := by
        apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι φ)).mp
        simp
      let S_ex : CategoryTheory.ShortComplex 𝒜 :=
        CategoryTheory.ShortComplex.mk
          (CategoryTheory.Limits.kernel.ι φ)
          (CategoryTheory.Limits.factorThruImage φ) hcomp0
      have hIsKernel : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι
            (CategoryTheory.Limits.kernel.ι φ) hcomp0) := by
        refine CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
          (fun {W} u hu => CategoryTheory.Limits.kernel.lift φ u ?_)
          (fun {W} u hu => CategoryTheory.Limits.kernel.lift_ι φ u _)
          (fun {W} u hu m_hom hm_eq => ?_)
        · have : (u ≫ CategoryTheory.Limits.factorThruImage φ) ≫
              CategoryTheory.Limits.image.ι φ = 0 := by
            rw [hu, CategoryTheory.Limits.zero_comp]
          simpa using this
        · apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι φ)).mp
          rw [hm_eq, CategoryTheory.Limits.kernel.lift_ι]
      have hShortExact : S_ex.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel S_ex hIsKernel
          mono_f := inferInstance
          epi_g := inferInstance }
      have hK_tor : ℓ • CategoryTheory.CategoryStruct.id K = 0 := by
        apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.kernel.ι φ)).mp
        have hcomm : (ℓ • 𝟙 K) ≫ CategoryTheory.Limits.kernel.ι φ =
            CategoryTheory.Limits.kernel.ι φ ≫ φ := by simp [φ]
        rw [hcomm, CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
      have hIm_tor : (ℓ ^ r) • CategoryTheory.CategoryStruct.id Im = 0 := by
        apply (CategoryTheory.cancel_epi (CategoryTheory.Limits.factorThruImage φ)).mp
        have hcomm : CategoryTheory.Limits.factorThruImage φ ≫ ((ℓ ^ r) • 𝟙 Im) =
            ((ℓ ^ r) • 𝟙 𝒢) ≫ CategoryTheory.Limits.factorThruImage φ := by simp [Im]
        rw [hcomm, CategoryTheory.Limits.comp_zero]
        apply (CategoryTheory.cancel_mono (CategoryTheory.Limits.image.ι φ)).mp
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.image.fac,
          CategoryTheory.Limits.zero_comp]
        change ((ℓ ^ r) • 𝟙 𝒢) ≫ (ℓ • 𝟙 𝒢) = 0
        have hmul : ((ℓ ^ r) • 𝟙 𝒢) ≫ (ℓ • 𝟙 𝒢) = (ℓ * ℓ ^ r) • 𝟙 𝒢 := by
          simp [mul_smul]
        rw [hmul, ← pow_succ']
        exact h𝒢
      have hSubK : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ K p) :=
        hModPrimeCD2 p hp K hK_tor
      have hSubIm : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ Im p) :=
        ih p hp Im hIm_tor
      refine ⟨fun x y => ?_⟩
      have hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} X₀ 𝒢 p, z = 0 := by
        intro z
        have hmap0 : z.comp (CategoryTheory.Abelian.Ext.mk₀ S_ex.g) (Nat.add_zero p) = 0 :=
          Subsingleton.elim _ 0
        obtain ⟨x_K, hx_K⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀ hShortExact z hmap0
        have hx0 : x_K = 0 := Subsingleton.elim x_K 0
        rw [← hx_K, hx0]
        simp
      rw [hzero x, hzero y]

  
  have hPrimeOrderElem : ∀ {M : Type u} [AddCommGroup M] (k_r : ℕ) (a : M),
      a ≠ 0 → (ℓ ^ k_r) • a = 0 → ∃ b : M, b ≠ 0 ∧ ℓ • b = 0 := by
    intro M _ k_r
    induction k_r with
    | zero =>
      intro a ha_ne ha_tor
      rw [pow_zero, one_nsmul] at ha_tor
      exact absurd ha_tor ha_ne
    | succ k_r ih =>
      intro a ha_ne ha_tor
      rw [pow_succ, mul_smul] at ha_tor
      by_cases hℓa : ℓ • a = 0
      · exact ⟨a, ha_ne, hℓa⟩
      · exact ih (ℓ • a) hℓa ha_tor

  have hExt1Vanish : ∀ (r : ℕ) (A : AddCommGrpCat.{u}),
      Finite ↥A →
      (ℓ ^ r) • CategoryTheory.CategoryStruct.id A = 0 →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj A) 1) := by
    intro r
    have hCardInd : ∀ (n : ℕ) (A : AddCommGrpCat.{u}),
        Finite ↥A → Nat.card ↥A = n →
        (ℓ ^ r) • CategoryTheory.CategoryStruct.id A = 0 →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj A) 1) := by
      intro n
      induction n using Nat.strongRecOn with
      | ind n ih =>
        intro A hFinA hCardA hTorA
        by_cases hn1 : n ≤ 1
        · have hSubA : Subsingleton ↥A :=
            (Finite.card_le_one_iff_subsingleton).mp (hCardA ▸ hn1)
          have hidA : CategoryTheory.CategoryStruct.id A = 0 := by
            ext x
            exact Subsingleton.elim x 0
          have hidCA : CategoryTheory.CategoryStruct.id (C.obj A) = 0 := by
            rw [← C.map_id, hidA, C.map_zero]
          exact hSubOfIdZero 1 hidCA
        · have hn_gt1 : 1 < Nat.card ↥A := by omega
          have hNontrivA : Nontrivial ↥A := (Finite.one_lt_card_iff_nontrivial).mp hn_gt1
          obtain ⟨a₀, ha₀_ne⟩ := exists_ne (0 : ↥A)
          obtain ⟨b₀, hb₀_ne, hb₀_tor⟩ :=
            hPrimeOrderElem r a₀ ha₀_ne (hTorElem hTorA a₀)
          obtain ⟨ψ₀, hψ₀_inj, _⟩ := hBezoutPrimeHom b₀ hb₀_ne hb₀_tor
          let ι : AM ℓ ⟶ A := AddCommGrpCat.ofHom
            { toFun := fun z => ψ₀ z.down
              map_zero' := map_zero ψ₀
              map_add' := fun x y => map_add ψ₀ x.down y.down }
          have hι_inj : Function.Injective ι.hom := fun x y hxy =>
            ULift.ext _ _ (hψ₀_inj hxy)
          let H : AddSubgroup ↥A := AddMonoidHom.range ι.hom
          let Q : AddCommGrpCat.{u} := AddCommGrpCat.of (↥A ⧸ H)
          let π : A ⟶ Q := AddCommGrpCat.ofHom (QuotientAddGroup.mk' H)
          have hπ_surj : Function.Surjective π.hom := QuotientAddGroup.mk'_surjective H
          have hFinQ : Finite ↥Q := Finite.of_surjective π.hom hπ_surj
          have hTorQ : (ℓ ^ r) • CategoryTheory.CategoryStruct.id Q = 0 := by
            ext a
            change (ℓ ^ r) • QuotientAddGroup.mk' H a = 0
            rw [← map_nsmul, hTorElem hTorA a, map_zero]
          have hιπ_zero : ι ≫ π = 0 := by
            ext z
            change QuotientAddGroup.mk' H (ι.hom z) = 0
            exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨z, rfl⟩
          let SC₀ : CategoryTheory.ShortComplex AddCommGrpCat.{u} :=
            CategoryTheory.ShortComplex.mk ι π hιπ_zero
          have hSE₀ : SC₀.ShortExact :=
            { exact := (CategoryTheory.ShortComplex.ab_exact_iff SC₀).mpr fun a ha => by
                have ha_mem : a ∈ H := by
                  rw [← QuotientAddGroup.ker_mk' H]
                  exact ha
                exact ha_mem
              mono_f := (AddCommGrpCat.mono_iff_injective ι).mpr hι_inj
              epi_g := (AddCommGrpCat.epi_iff_surjective π).mpr hπ_surj }
          have hCardH : Nat.card ↥H = ℓ := by
            let e_H : ZMod ℓ ≃ ↥H := Equiv.ofBijective
              (fun z => ⟨ι.hom (ULift.up z), ⟨ULift.up z, rfl⟩⟩)
              ⟨fun x y hxy => by
                have h1 : ι.hom (ULift.up x) = ι.hom (ULift.up y) := congrArg Subtype.val hxy
                exact congrArg ULift.down (hι_inj h1),
               fun ⟨_, ⟨u, rfl⟩⟩ => ⟨u.down, rfl⟩⟩
            have : NeZero ℓ := ⟨hPrime.ne_zero⟩
            rw [← Nat.card_congr e_H, Nat.card_zmod]
          have hLagrange : n = Nat.card ↥Q * ℓ := by
            rw [← hCardA, ← hCardH]
            exact AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup H
          have hCardQ_lt : Nat.card ↥Q < n := by
            have hℓ2 : 2 ≤ ℓ := hPrime.two_le
            have hQ_pos : 0 < Nat.card ↥Q := by
              by_contra hQ0
              have : Nat.card ↥Q = 0 := by omega
              rw [this, zero_mul] at hLagrange
              omega
            nlinarith
          have hSubQ : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj Q) 1) :=
            ih (Nat.card ↥Q) hCardQ_lt Q hFinQ rfl hTorQ
          have hSE_C : (SC₀.map C).ShortExact := hSE₀.map_of_exact C
          refine ⟨fun x y => ?_⟩
          have hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} X₀ (C.obj A) 1, z = 0 := by
            intro z
            have hmap0 : z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC₀.map C).g)
                (Nat.add_zero 1) = 0 := @Subsingleton.elim _ hSubQ _ 0
            obtain ⟨w, hw⟩ :=
              CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀ hSE_C z hmap0
            have hw0 : w = 0 := @Subsingleton.elim _ hH1 w 0
            rw [← hw, hw0]
            simp
          rw [hzero x, hzero y]
    intro A hFinA hTorA
    exact hCardInd (Nat.card ↥A) A hFinA rfl hTorA

  
  let E : ℕ → Type u := fun n => CategoryTheory.Abelian.Ext.{u} X₀ (C.obj (AM n)) 2
  let liftHom : ∀ {m₁ m₂ : ℕ}, (ZMod m₁ →+ ZMod m₂) → (AM m₁ ⟶ AM m₂) :=
    fun φ => U.map (AddCommGrpCat.ofHom φ)
  let mapE : ∀ {m₁ m₂ : ℕ}, (ZMod m₁ →+ ZMod m₂) → (E m₁ →+ E m₂) :=
    fun φ => (CategoryTheory.Abelian.Ext.mk₀ (C.map (liftHom φ))).postcomp X₀ (Nat.add_zero 2)

  have hMapE_id : ∀ (n : ℕ) (x : E n), mapE (AddMonoidHom.id (ZMod n)) x = x := by
    intro n x
    dsimp only [mapE, liftHom]
    rw [AddCommGrpCat.ofHom_id, U.map_id, C.map_id]
    exact hPostId x

  have hMapE_comp : ∀ {m₁ m₂ m₃ : ℕ} (α : ZMod m₁ →+ ZMod m₂) (β : ZMod m₂ →+ ZMod m₃)
      (x : E m₁), mapE (β.comp α) x = mapE β (mapE α x) := by
    intro m₁ m₂ m₃ α β x
    dsimp only [mapE, liftHom]
    rw [AddCommGrpCat.ofHom_comp, U.map_comp, C.map_comp]
    exact hPostComp _ _ x

  have hMapE_nsmul_id : ∀ (n k_n : ℕ) (x : E n),
      mapE (k_n • AddMonoidHom.id (ZMod n)) x = k_n • x := by
    intro n k_n x
    have h1 : liftHom (k_n • AddMonoidHom.id (ZMod n)) = k_n • 𝟙 (AM n) := by
      have hof : AddCommGrpCat.ofHom (k_n • AddMonoidHom.id (ZMod n)) =
          k_n • 𝟙 (AddCommGrpCat.of (ZMod n)) := by
        ext z
        rfl
      dsimp only [liftHom]
      rw [hof, CategoryTheory.Functor.map_nsmul, U.map_id]
    dsimp only [mapE]
    rw [h1, CategoryTheory.Functor.map_nsmul, C.map_id, hPostNsmul, hPostId]

  have hAM_tor : ∀ n : ℕ, n • CategoryTheory.CategoryStruct.id (C.obj (AM n)) = 0 := by
    intro n
    have h0 : n • CategoryTheory.CategoryStruct.id (AddCommGrpCat.of (ZMod n)) = 0 := by
      ext z
      change n • z = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    have hU : n • CategoryTheory.CategoryStruct.id (AM n) = 0 := by
      dsimp [AM]
      rw [← U.map_id, ← CategoryTheory.Functor.map_nsmul, h0, U.map_zero]
    rw [← C.map_id, ← CategoryTheory.Functor.map_nsmul, hU, C.map_zero]

  have hSubE1 : Subsingleton (E 1) := by
    have h := hAM_tor 1
    rw [one_nsmul] at h
    exact hSubOfIdZero 2 h

  
  let μZMod : ∀ r : ℕ, ZMod ℓ →+ ZMod (ℓ ^ (r + 1)) := fun r =>
    letI : NeZero ℓ := ⟨hPrime.ne_zero⟩
    { toFun := fun x => ((x.val * ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1)))
      map_zero' := by simp
      map_add' := fun x y => by
        rw [ZMod.val_add]
        have hdiv : x.val + y.val = ℓ * ((x.val + y.val) / ℓ) + (x.val + y.val) % ℓ :=
          (Nat.div_add_mod (x.val + y.val) ℓ).symm
        have hmul : (x.val + y.val) * ℓ ^ r =
            ((x.val + y.val) / ℓ) * ℓ ^ (r + 1) + ((x.val + y.val) % ℓ) * ℓ ^ r := by
          calc (x.val + y.val) * ℓ ^ r
              = (ℓ * ((x.val + y.val) / ℓ) + (x.val + y.val) % ℓ) * ℓ ^ r := by rw [← hdiv]
            _ = ((x.val + y.val) / ℓ) * (ℓ * ℓ ^ r) + ((x.val + y.val) % ℓ) * ℓ ^ r := by ring
            _ = ((x.val + y.val) / ℓ) * ℓ ^ (r + 1) + ((x.val + y.val) % ℓ) * ℓ ^ r := by
                rw [← pow_succ']
        have hcast : (((x.val + y.val) * ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) =
            ((((x.val + y.val) % ℓ) * ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) := by
          rw [hmul, Nat.cast_add, Nat.cast_mul, ZMod.natCast_self, mul_zero, zero_add]
        rw [← hcast, add_mul, Nat.cast_add] }

  let πZMod : ∀ r : ℕ, ZMod (ℓ ^ (r + 1)) →+ ZMod (ℓ ^ r) := fun r =>
    (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom

  have hBocksteinSE : ∀ r : ℕ,
      ∃ (h0 : liftHom (μZMod r) ≫ liftHom (πZMod r) = 0),
        ((CategoryTheory.ShortComplex.mk (liftHom (μZMod r)) (liftHom (πZMod r)) h0).map C).ShortExact := by
    intro r
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hPrime.ne_zero⟩
    have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩
    have hμ_inj : Function.Injective (μZMod r) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      change ((x.val * ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) = 0 at hx
      have hdvd1 : ℓ ^ (r + 1) ∣ x.val * ℓ ^ r := (ZMod.natCast_eq_zero_iff _ _).mp hx
      rw [pow_succ'] at hdvd1
      have hdvd2 : ℓ ∣ x.val :=
        (Nat.mul_dvd_mul_iff_right (pow_pos hPrime.pos r)).mp hdvd1
      have hval0 : x.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd2 (ZMod.val_lt x)
      rw [← ZMod.natCast_zmod_val x, hval0, Nat.cast_zero]
    have hπ_surj : Function.Surjective (πZMod r) := by
      intro y
      refine ⟨(y.val : ZMod (ℓ ^ (r + 1))), ?_⟩
      change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
        (y.val : ZMod (ℓ ^ (r + 1))) = y
      rw [map_natCast, ZMod.natCast_zmod_val]
    have hcomp_zmod : ∀ x : ZMod ℓ, πZMod r (μZMod r x) = 0 := by
      intro x
      change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
        ((x.val * ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) = 0
      rw [map_natCast, Nat.cast_mul, ZMod.natCast_self, mul_zero]
    have h0 : liftHom (μZMod r) ≫ liftHom (πZMod r) = 0 := by
      ext z
      exact ULift.ext _ _ (hcomp_zmod z.down)
    let SC_r : CategoryTheory.ShortComplex AddCommGrpCat.{u} :=
      CategoryTheory.ShortComplex.mk (liftHom (μZMod r)) (liftHom (πZMod r)) h0
    have hSE_ab : SC_r.ShortExact :=
      { exact := (CategoryTheory.ShortComplex.ab_exact_iff SC_r).mpr fun y hy => by
          have hy0 : πZMod r y.down = 0 := congrArg ULift.down hy
          have hy_cast : (y.down.val : ZMod (ℓ ^ r)) = 0 := by
            have h1 : ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
                (y.down.val : ZMod (ℓ ^ (r + 1))) = (y.down.val : ZMod (ℓ ^ r)) :=
              map_natCast _ _
            rw [ZMod.natCast_zmod_val] at h1
            exact h1.symm.trans hy0
          obtain ⟨k_q, hk_q⟩ := (ZMod.natCast_eq_zero_iff _ _).mp hy_cast
          have hk_lt : k_q < ℓ := by
            have hlt : y.down.val < ℓ ^ (r + 1) := ZMod.val_lt y.down
            rw [hk_q, pow_succ] at hlt
            exact Nat.lt_of_mul_lt_mul_left hlt
          let x₀ : ZMod ℓ := (k_q : ZMod ℓ)
          have hx₀_val : x₀.val = k_q := ZMod.val_natCast_of_lt hk_lt
          refine ⟨ULift.up x₀, ULift.ext _ _ ?_⟩
          change ((x₀.val * ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) = y.down
          rw [hx₀_val, mul_comm, ← hk_q, ZMod.natCast_zmod_val]
        mono_f := (AddCommGrpCat.mono_iff_injective _).mpr fun x₁ x₂ h12 =>
          ULift.ext _ _ (hμ_inj (congrArg ULift.down h12))
        epi_g := (AddCommGrpCat.epi_iff_surjective _).mpr fun y => by
          obtain ⟨x, hx⟩ := hπ_surj y.down
          exact ⟨ULift.up x, ULift.ext _ _ hx⟩ }
    exact ⟨h0, hSE_ab.map_of_exact C⟩

  have hExt3_ℓ : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj (AM ℓ)) 3) :=
    hH3 3 (le_refl 3)

  have hTransSurj : ∀ (r : ℕ) (w : E (ℓ ^ r)), ∃ w' : E (ℓ ^ (r + 1)), mapE (πZMod r) w' = w := by
    intro r w
    obtain ⟨h0, hSE⟩ := hBocksteinSE r
    have hbdry : w.comp hSE.extClass (rfl : 2 + 1 = 3) = 0 := @Subsingleton.elim _ hExt3_ℓ _ 0
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀ hSE w (rfl : 2 + 1 = 3) hbdry

  have hFinEℓ : Finite (E ℓ) :=
    Nat.finite_of_card_ne_zero (by change Nat.card (weilEtaleTorsionH P_over.left ℓ 2) ≠ 0; rw [hH2]; exact hPrime.ne_zero)
  have hNontrivEℓ : Nontrivial (E ℓ) :=
    (Finite.one_lt_card_iff_nontrivial).mp
      (by change 1 < Nat.card (weilEtaleTorsionH P_over.left ℓ 2); rw [hH2]; exact hPrime.one_lt)
  obtain ⟨ω_base, hω_base_ne⟩ := exists_ne (0 : E ℓ)
  have hω_base_tor : ℓ • ω_base = 0 := hExtNsmulZero ℓ (hAM_tor ℓ) ω_base
  obtain ⟨ψ_E, hψ_E_inj, hψ_E_val⟩ := hBezoutPrimeHom ω_base hω_base_ne hω_base_tor
  have hBaseCyc : ∀ v : E ℓ, ∃ d : ℕ, v = d • ω_base := by
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    let _ : Fintype (E ℓ) := Fintype.ofFinite (E ℓ)
    have hCardEq : Fintype.card (ZMod ℓ) = Fintype.card (E ℓ) := by
      rw [ZMod.card, ← Nat.card_eq_fintype_card]
      exact hH2.symm
    have hBij : Function.Bijective ψ_E :=
      (Fintype.bijective_iff_injective_and_card ψ_E).mpr ⟨hψ_E_inj, hCardEq⟩
    intro v
    obtain ⟨z, rfl⟩ := hBij.2 v
    exact ⟨z.val, hψ_E_val z⟩

  let i1_ring : ZMod ℓ →+* ZMod (ℓ ^ 1) :=
    ZMod.castHom (dvd_of_eq (pow_one ℓ)) (ZMod (ℓ ^ 1))
  let j1_ring : ZMod (ℓ ^ 1) →+* ZMod ℓ :=
    ZMod.castHom (dvd_of_eq (pow_one ℓ).symm) (ZMod ℓ)
  have h_j1_i1 : j1_ring.toAddMonoidHom.comp i1_ring.toAddMonoidHom = AddMonoidHom.id _ := by
    have h : j1_ring.comp i1_ring = RingHom.id _ := RingHom.ext_zmod _ _
    exact congrArg RingHom.toAddMonoidHom h
  have h_i1_j1 : i1_ring.toAddMonoidHom.comp j1_ring.toAddMonoidHom = AddMonoidHom.id _ := by
    have h : i1_ring.comp j1_ring = RingHom.id _ := RingHom.ext_zmod _ _
    exact congrArg RingHom.toAddMonoidHom h

  let ω₁ : E (ℓ ^ 1) := mapE i1_ring.toAddMonoidHom ω_base
  let ω_pos : ∀ k : ℕ, E (ℓ ^ (k + 1)) :=
    Nat.rec ω₁ (fun k ω_k => Classical.choose (hTransSurj (k + 1) ω_k))
  let ω : ∀ r : ℕ, weilEtaleTorsionH P_over.left (ℓ ^ r) 2 := fun r =>
    match r with
    | 0 => 0
    | k + 1 => ω_pos k

  have hω_tr : ∀ r : ℕ, weilEtaleTorsionTransition P_over.left ℓ r 2 (ω (r + 1)) = ω r := by
    intro r
    change mapE (πZMod r) (ω (r + 1)) = ω r
    cases r with
    | zero => exact @Subsingleton.elim _ hSubE1 _ _
    | succ k => exact Classical.choose_spec (hTransSurj (k + 1) (ω_pos k))

  let pZMod : ∀ k : ℕ, ZMod (ℓ ^ (k + 1)) →+ ZMod ℓ := fun k =>
    (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero k)) (ZMod ℓ)).toAddMonoidHom

  have hω_proj_base : ∀ k : ℕ, mapE (pZMod k) (ω_pos k) = ω_base := by
    intro k
    induction k with
    | zero =>
      have hp0 : pZMod 0 = j1_ring.toAddMonoidHom := rfl
      change mapE (pZMod 0) (mapE i1_ring.toAddMonoidHom ω_base) = ω_base
      rw [hp0, ← hMapE_comp, h_j1_i1, hMapE_id]
    | succ k ih =>
      have hp_comp : (pZMod k).comp (πZMod (k + 1)) = pZMod (k + 1) := by
        have h : (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero k)) (ZMod ℓ)).comp
            (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (k + 1))) (ZMod (ℓ ^ (k + 1)))) =
            ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero (k + 1))) (ZMod ℓ) :=
          RingHom.ext_zmod _ _
        exact congrArg RingHom.toAddMonoidHom h
      rw [← hp_comp, hMapE_comp]
      change mapE (pZMod k) (weilEtaleTorsionTransition P_over.left ℓ (k + 1) 2 (ω (k + 2))) = ω_base
      rw [hω_tr (k + 1), ih]

  have hμ_comp_p : ∀ m : ℕ,
      (μZMod m).comp (pZMod m) = (ℓ ^ m) • AddMonoidHom.id (ZMod (ℓ ^ (m + 1))) := by
    intro m
    have : NeZero ℓ := ⟨hPrime.ne_zero⟩
    have : NeZero (ℓ ^ (m + 1)) := ⟨pow_ne_zero (m + 1) hPrime.ne_zero⟩
    ext x
    change (((pZMod m x).val * ℓ ^ m : ℕ) : ZMod (ℓ ^ (m + 1))) = (ℓ ^ m) • x
    have hp_val : (pZMod m x).val = x.val % ℓ := by
      have h1 : pZMod m x = (x.val : ZMod ℓ) := by
        conv_lhs => rw [← ZMod.natCast_zmod_val x]
        exact map_natCast (ZMod.castHom (dvd_pow_self ℓ (Nat.succ_ne_zero m)) (ZMod ℓ)) x.val
      rw [h1, ZMod.val_natCast]
    have hdiv : x.val = ℓ * (x.val / ℓ) + x.val % ℓ := (Nat.div_add_mod x.val ℓ).symm
    have hmul : x.val * ℓ ^ m = (x.val / ℓ) * ℓ ^ (m + 1) + (x.val % ℓ) * ℓ ^ m := by
      calc x.val * ℓ ^ m = (ℓ * (x.val / ℓ) + x.val % ℓ) * ℓ ^ m := by rw [← hdiv]
        _ = (x.val / ℓ) * (ℓ * ℓ ^ m) + (x.val % ℓ) * ℓ ^ m := by ring
        _ = (x.val / ℓ) * ℓ ^ (m + 1) + (x.val % ℓ) * ℓ ^ m := by rw [← pow_succ']
    have hcast : ((x.val * ℓ ^ m : ℕ) : ZMod (ℓ ^ (m + 1))) =
        (((x.val % ℓ) * ℓ ^ m : ℕ) : ZMod (ℓ ^ (m + 1))) := by
      rw [hmul, Nat.cast_add, Nat.cast_mul, ZMod.natCast_self, mul_zero, zero_add]
    rw [hp_val, ← hcast, Nat.cast_mul, ZMod.natCast_zmod_val, mul_comm, ← nsmul_eq_mul]

  have hω_pos_cyc : ∀ (k : ℕ) (u : E (ℓ ^ (k + 1))), ∃ c : ℕ, u = c • ω_pos k := by
    intro k
    induction k with
    | zero =>
      intro u
      obtain ⟨c, hc⟩ := hBaseCyc (mapE j1_ring.toAddMonoidHom u)
      refine ⟨c, ?_⟩
      calc u = mapE (AddMonoidHom.id _) u := (hMapE_id _ u).symm
        _ = mapE (i1_ring.toAddMonoidHom.comp j1_ring.toAddMonoidHom) u := by rw [h_i1_j1]
        _ = mapE i1_ring.toAddMonoidHom (mapE j1_ring.toAddMonoidHom u) := hMapE_comp _ _ u
        _ = mapE i1_ring.toAddMonoidHom (c • ω_base) := by rw [hc]
        _ = c • ω_pos 0 := map_nsmul _ c ω_base
    | succ k ih =>
      intro u
      let m := k + 1
      obtain ⟨c₀, hc₀⟩ := ih (mapE (πZMod m) u)
      have hdiff_ker : mapE (πZMod m) (u - c₀ • ω_pos m) = 0 := by
        rw [map_sub, map_nsmul, hc₀]
        change c₀ • ω_pos k - c₀ • weilEtaleTorsionTransition P_over.left ℓ m 2 (ω (m + 1)) = 0
        rw [hω_tr m, sub_self]
      obtain ⟨h0, hSE_m⟩ := hBocksteinSE m
      obtain ⟨v, hv⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ X₀ hSE_m (u - c₀ • ω_pos m) hdiff_ker
      obtain ⟨d, rfl⟩ := hBaseCyc v
      have hμ_ω : mapE (μZMod m) ω_base = (ℓ ^ m) • ω_pos m := by
        rw [← hω_proj_base m, ← hMapE_comp, hμ_comp_p m, hMapE_nsmul_id]
      have hv' : mapE (μZMod m) (d • ω_base) = u - c₀ • ω_pos m := hv
      rw [map_nsmul, hμ_ω, ← mul_smul] at hv'
      refine ⟨c₀ + d * ℓ ^ m, ?_⟩
      change u = (c₀ + d * ℓ ^ m) • ω_pos m
      rw [Nat.add_comm c₀ (d * ℓ ^ m), add_nsmul, hv', sub_add_cancel]

  have hω_cyc : ∀ (r : ℕ) (u : E (ℓ ^ r)), ∃ c : ℕ, u = c • ω r := by
    intro r
    cases r with
    | zero =>
      intro u
      exact ⟨0, by rw [zero_nsmul]; exact @Subsingleton.elim _ hSubE1 u 0⟩
    | succ k => exact hω_pos_cyc k

  
  have hExt2Surj : ∀ (m : ℕ), 1 ≤ m →
      ∀ (ω₀ : E m),
      (∀ u : E m, ∃ c : ℕ, u = c • ω₀) →
      (∀ K : AddCommGrpCat.{u},
        m • CategoryTheory.CategoryStruct.id K = 0 →
        Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj K) 3)) →
      ∀ (A : AddCommGrpCat.{u}),
        Finite ↥A →
        m • CategoryTheory.CategoryStruct.id A = 0 →
        ∀ z : CategoryTheory.Abelian.Ext.{u} X₀ (C.obj A) 2,
          ∃ φ : AM m ⟶ A,
            ((CategoryTheory.Abelian.Ext.mk₀ (C.map φ)).postcomp X₀ (Nat.add_zero 2)) ω₀ = z := by
    intro m hm ω₀ hCyc₀ hExt3_K A hFinA hTorA z
    by_cases hm1 : m = 1
    · subst hm1
      rw [one_nsmul] at hTorA
      have hidCA : CategoryTheory.CategoryStruct.id (C.obj A) = 0 := by
        rw [← C.map_id, hTorA, C.map_zero]
      have hSubCA2 : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj A) 2) :=
        hSubOfIdZero 2 hidCA
      refine ⟨0, ?_⟩
      rw [C.map_zero, hPostZero]
      exact Subsingleton.elim 0 z
    · have hm2 : 2 ≤ m := by omega
      have : NeZero m := ⟨by omega⟩
      have : Fact (1 < m) := ⟨by omega⟩
      let P : ℕ → AddCommGrpCat.{u} :=
        fun s => AddCommGrpCat.of (Fin s → ULift.{u} (ZMod m))
      have hPowSurj : ∀ (s : ℕ) (w : CategoryTheory.Abelian.Ext.{u} X₀ (C.obj (P s)) 2),
          ∃ ψ : AM m ⟶ P s,
            ((CategoryTheory.Abelian.Ext.mk₀ (C.map ψ)).postcomp X₀ (Nat.add_zero 2)) ω₀ = w := by
        intro s
        induction s with
        | zero =>
          intro w
          have hidP0 : CategoryTheory.CategoryStruct.id (P 0) = 0 := by
            apply CategoryTheory.ConcreteCategory.hom_ext
            intro f
            funext j
            exact Fin.elim0 j
          have hidCP0 : CategoryTheory.CategoryStruct.id (C.obj (P 0)) = 0 := by
            rw [← C.map_id, hidP0, C.map_zero]
          have hSub0 : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj (P 0)) 2) :=
            hSubOfIdZero 2 hidCP0
          refine ⟨0, ?_⟩
          rw [C.map_zero, hPostZero]
          exact Subsingleton.elim 0 w
        | succ s ihs =>
          intro w
          let i₁ : AM m ⟶ P (s + 1) := AddCommGrpCat.ofHom
            { toFun := fun a => Fin.cons a 0
              map_zero' := by
                funext j; refine Fin.cases rfl (fun _ => rfl) j
              map_add' := fun a₁ a₂ => by
                funext j; refine Fin.cases rfl (fun _ => (add_zero 0).symm) j }
          let p₁ : P (s + 1) ⟶ AM m := AddCommGrpCat.ofHom
            { toFun := fun f => f 0
              map_zero' := rfl
              map_add' := fun _ _ => rfl }
          let i₂ : P s ⟶ P (s + 1) := AddCommGrpCat.ofHom
            { toFun := fun g => Fin.cons 0 g
              map_zero' := by
                funext j; refine Fin.cases rfl (fun _ => rfl) j
              map_add' := fun g₁ g₂ => by
                funext j; refine Fin.cases (add_zero 0).symm (fun _ => rfl) j }
          let p₂ : P (s + 1) ⟶ P s := AddCommGrpCat.ofHom
            { toFun := fun f => Fin.tail f
              map_zero' := rfl
              map_add' := fun _ _ => rfl }
          have hSplitId : p₁ ≫ i₁ + p₂ ≫ i₂ = 𝟙 (P (s + 1)) := by
            apply CategoryTheory.ConcreteCategory.hom_ext
            intro f
            funext j
            refine Fin.cases ?_ (fun k => ?_) j
            · exact add_zero (f 0)
            · exact zero_add (f k.succ)
          obtain ⟨c, hc⟩ := hCyc₀
            (((CategoryTheory.Abelian.Ext.mk₀ (C.map p₁)).postcomp X₀ (Nat.add_zero 2)) w)
          obtain ⟨ψ₀, hψ₀⟩ := ihs
            (((CategoryTheory.Abelian.Ext.mk₀ (C.map p₂)).postcomp X₀ (Nat.add_zero 2)) w)
          let ψ : AM m ⟶ P (s + 1) := (c • 𝟙 (AM m)) ≫ i₁ + ψ₀ ≫ i₂
          refine ⟨ψ, ?_⟩
          dsimp only [ψ]
          rw [C.map_add, hPostAdd, C.map_comp, C.map_comp, hPostComp, hPostComp,
            CategoryTheory.Functor.map_nsmul, C.map_id, hPostNsmul, hPostId, ← hc, hψ₀,
            ← hPostComp, ← hPostComp, ← C.map_comp, ← C.map_comp, ← hPostAdd, ← C.map_add,
            hSplitId, C.map_id, hPostId]
      let _ : Fintype ↥A := Fintype.ofFinite ↥A
      let s := Fintype.card ↥A
      let e_A : Fin s ≃ ↥A := (Fintype.equivFin ↥A).symm
      let Φ_A : P s ⟶ A := AddCommGrpCat.ofHom
        { toFun := fun f => ∑ j : Fin s, (f j).down.val • e_A j
          map_zero' := by simp
          map_add' := fun f₁ f₂ => by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl fun j _ => ?_
            change ((f₁ j).down + (f₂ j).down).val • e_A j =
              (f₁ j).down.val • e_A j + (f₂ j).down.val • e_A j
            rw [ZMod.val_add, hModSmul (hTorElem hTorA) _ (e_A j), add_nsmul] }
      have hΦ_surj : Function.Surjective Φ_A.hom := by
        intro a
        let j₀ : Fin s := e_A.symm a
        let f_a : ↥(P s) := fun j => if j = j₀ then ULift.up 1 else ULift.up 0
        refine ⟨f_a, ?_⟩
        change (∑ j : Fin s, (f_a j).down.val • e_A j) = a
        have hsum : (∑ j : Fin s, (f_a j).down.val • e_A j) =
            ∑ j : Fin s, if j = j₀ then (1 : ZMod m).val • e_A j else 0 := by
          refine Finset.sum_congr rfl fun j _ => ?_
          dsimp [f_a]
          split_ifs
          · rfl
          · simp
        rw [hsum, Finset.sum_ite_eq' Finset.univ j₀]
        simp [ZMod.val_one m, j₀]
      let K_sub : AddSubgroup ↥(P s) := AddMonoidHom.ker Φ_A.hom
      let K : AddCommGrpCat.{u} := AddCommGrpCat.of ↥K_sub
      let ι_K : K ⟶ P s := AddCommGrpCat.ofHom K_sub.subtype
      have hιΦ_zero : ι_K ≫ Φ_A = 0 := by
        apply CategoryTheory.ConcreteCategory.hom_ext
        intro x
        exact x.2
      let SC_A : CategoryTheory.ShortComplex AddCommGrpCat.{u} :=
        CategoryTheory.ShortComplex.mk ι_K Φ_A hιΦ_zero
      have hSE_A : (SC_A.map C).ShortExact :=
        ({ exact := (CategoryTheory.ShortComplex.ab_exact_iff SC_A).mpr fun f hf => ⟨⟨f, hf⟩, rfl⟩
           mono_f := (AddCommGrpCat.mono_iff_injective ι_K).mpr Subtype.val_injective
           epi_g := (AddCommGrpCat.epi_iff_surjective Φ_A).mpr hΦ_surj } :
          SC_A.ShortExact).map_of_exact C
      have hK_tor : m • CategoryTheory.CategoryStruct.id K = 0 := by
        apply CategoryTheory.ConcreteCategory.hom_ext
        intro x
        apply Subtype.ext
        funext j
        apply ULift.ext
        change m • (x.1 j).down = 0
        rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
      have hSubK3 : Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj K) 3) :=
        hExt3_K K hK_tor
      have hbdry : z.comp hSE_A.extClass (rfl : 2 + 1 = 3) = 0 :=
        @Subsingleton.elim _ hSubK3 _ 0
      obtain ⟨w, hw⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ X₀ hSE_A z (rfl : 2 + 1 = 3) hbdry
      obtain ⟨ψ, hψ⟩ := hPowSurj s w
      refine ⟨ψ ≫ Φ_A, ?_⟩
      rw [C.map_comp, hPostComp, hψ]
      exact hw

  
  refine ⟨hCD2, hExt1Vanish, ⟨ω, hω_tr, fun r A hFinA hTorA z => ?_⟩⟩
  have hExt3_r : ∀ K : AddCommGrpCat.{u},
      (ℓ ^ r) • CategoryTheory.CategoryStruct.id K = 0 →
      Subsingleton (CategoryTheory.Abelian.Ext.{u} X₀ (C.obj K) 3) := by
    intro K hK
    have hCK : (ℓ ^ r) • CategoryTheory.CategoryStruct.id (C.obj K) = 0 := by
      rw [← C.map_id, ← CategoryTheory.Functor.map_nsmul, hK, C.map_zero]
    exact hCD2 r 3 (le_refl 3) (C.obj K) hCK
  exact hExt2Surj (ℓ ^ r) (Nat.one_le_pow r ℓ hPrime.pos) (ω r) (hω_cyc r) hExt3_r A hFinA hTorA z

theorem weil_sm_pencil_bc_push_exists_and_nat (sys : WeilEtaleSitePullbackSys.{u})
    {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (g : Quiver.Hom S' S)
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
    (h_sq : CategoryTheory.CategoryStruct.comp g' f =
      CategoryTheory.CategoryStruct.comp f' g) :
    letI := (sys g).hCont
    letI := (sys g').hCont
    letI := (sys g').hAdj
    letI := (sys g').hAdd_pb
    letI := (sys g').hLim_pb
    letI := (sys g').hColim_pb
    let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    let pb_g' := (weilEtaleSitePullback g').sheafPullback
      AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
    (∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      (∃ β, WeilIsSmPencilLerayBCPush f g f' g' h_sq F q β) ∧
      (∀ β₁ β₂,
        WeilIsSmPencilLerayBCPush f g f' g' h_sq F q β₁ →
        WeilIsSmPencilLerayBCPush f g f' g' h_sq F q β₂ →
        β₁ = β₂)) ∧
    (∀ {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : Quiver.Hom F₁ F₂) (q : ℕ) (β₁ β₂ : _),
      WeilIsSmPencilLerayBCPush f g f' g' h_sq F₁ q β₁ →
      WeilIsSmPencilLerayBCPush f g f' g' h_sq F₂ q β₂ →
      CategoryTheory.CategoryStruct.comp (weilEtaleHigherDirectImageMap f q φ) β₂ =
        CategoryTheory.CategoryStruct.comp β₁
          (pf_g.map (weilEtaleHigherDirectImageMap f' q (pb_g'.map φ)))) ∧
    (∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE : SC.ShortExact) (q : ℕ) (β₃ β₁ : _),
      WeilIsSmPencilLerayBCPush f g f' g' h_sq SC.X₃ q β₃ →
      WeilIsSmPencilLerayBCPush f g f' g' h_sq SC.X₁ (q + 1) β₁ →
      CategoryTheory.CategoryStruct.comp (weilSmPencilLerayConnHom f SC hSE q) β₁ =
        CategoryTheory.CategoryStruct.comp β₃
          (pf_g.map
            (weilSmPencilLerayConnHom f' (SC.map pb_g') (hSE.map_of_exact pb_g') q))) :=
by
  letI := (sys g).hCont
  letI := (sys g').hCont
  letI := (sys g').hAdj
  letI := (sys g').hAdd_pb
  letI := (sys g').hLim_pb
  letI := (sys g').hColim_pb
  let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous
    AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
  let pb_g' := (weilEtaleSitePullback g').sheafPullback
    AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
  have hWhiskerFree : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      {P₁ P₂ : C ⥤ Type u} {F : C ⥤ AddCommGrpCat.{u}}
      (β : P₁ ⟶ P₂) (α : P₂ ⋙ AddCommGrpCat.free ⟶ F),
      ((AddCommGrpCat.adj.whiskerRight C).homEquiv P₁ F)
        (CategoryTheory.Functor.whiskerRight β AddCommGrpCat.free ≫ α) =
      β ≫ ((AddCommGrpCat.adj.whiskerRight C).homEquiv P₂ F) α := by
    intro C _ P₁ P₂ F β α
    ext W x
    exact congrArg (fun m => m x)
      (AddCommGrpCat.adj.homEquiv_naturality_left (β.app W) (α.app W))
  have hRepHomLeft : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale}
      (v : V₂ ⟶ V₁) (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      (φ : weilPolyP1CohomologyRepSheaf Z V₁ ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z V₂ G
        (((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v)
            AddCommGrpCat.free)) ≫ φ) =
        (G.obj.map v.op) (weilPolyP1CohomologyRepHomEquiv Z V₁ G φ) := by
    intro Z V₁ V₂ v G φ
    dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_left, hWhiskerFree]
    exact (CategoryTheory.yonedaEquiv_naturality _ v).symm
  have hRepHomRight : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (V : Z.Etale) (m_hom : weilPolyP1CohomologyRepSheaf Z V ⟶ G₁) (ψ : G₁ ⟶ G₂),
      weilPolyP1CohomologyRepHomEquiv Z V G₂ (m_hom ≫ ψ) =
      (ψ.hom.app (Opposite.op V)) (weilPolyP1CohomologyRepHomEquiv Z V G₁ m_hom) := by
    intro Z G₁ G₂ V m_hom ψ
    dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
    let α₀ := ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology
      AddCommGrpCat.{u}).homEquiv _ G₁) m_hom
    change CategoryTheory.yonedaEquiv
      (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
        (CategoryTheory.yoneda.obj V) G₂.obj) (α₀ ≫ ψ.hom)) = _
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
    rfl
  have hRepPullNat :
      ∀ {U₁ U₂ : X.Etale} {U'₁ U'₂ : X'.Etale}
        (v : U₂ ⟶ U₁) (v' : U'₂ ⟶ U'₁)
        (w₁ : U'₁ ⟶ (weilEtaleSitePullback g').obj U₁)
        (w₂ : U'₂ ⟶ (weilEtaleSitePullback g').obj U₂),
        v' ≫ w₁ = w₂ ≫ (weilEtaleSitePullback g').map v →
        ((CategoryTheory.presheafToSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).map
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v')
            AddCommGrpCat.free)) ≫
          weilPolyP1CohomologyRepPullHom g' U₁ U'₁ w₁ =
        weilPolyP1CohomologyRepPullHom g' U₂ U'₂ w₂ ≫
          pb_g'.map
            ((CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).map
              (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v)
                AddCommGrpCat.free)) := by
    intro U₁ U₂ U'₁ U'₂ v v' w₁ w₂ h_comm
    apply (weilPolyP1CohomologyRepHomEquiv X' U'₂ _).injective
    let adj_g' := (weilEtaleSitePullback g').sheafAdjunctionContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology
    let s_pull : ∀ U_Y : X.Etale,
        ↑((pb_g'.obj (weilPolyP1CohomologyRepSheaf X U_Y)).obj.obj
          (Opposite.op ((weilEtaleSitePullback g').obj U_Y))) :=
      fun U_Y => ((adj_g'.unit.app (weilPolyP1CohomologyRepSheaf X U_Y)).hom.app
        (Opposite.op U_Y))
        (weilPolyP1CohomologyRepHomEquiv X U_Y (weilPolyP1CohomologyRepSheaf X U_Y)
          (CategoryTheory.CategoryStruct.id (weilPolyP1CohomologyRepSheaf X U_Y)))
    have h_pull_val : ∀ (U_Y : X.Etale) (U_W : X'.Etale)
        (w : U_W ⟶ (weilEtaleSitePullback g').obj U_Y),
        weilPolyP1CohomologyRepHomEquiv X' U_W
          (pb_g'.obj (weilPolyP1CohomologyRepSheaf X U_Y))
          (weilPolyP1CohomologyRepPullHom g' U_Y U_W w) =
          ((pb_g'.obj (weilPolyP1CohomologyRepSheaf X U_Y)).obj.map (Opposite.op w))
            (s_pull U_Y) :=
      fun U_Y U_W w =>
        Equiv.apply_symm_apply
          (weilPolyP1CohomologyRepHomEquiv X' U_W
            (pb_g'.obj (weilPolyP1CohomologyRepSheaf X U_Y)))
          (((pb_g'.obj (weilPolyP1CohomologyRepSheaf X U_Y)).obj.map (Opposite.op w))
            (s_pull U_Y))
    let f_rep := (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).map
      (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v)
        AddCommGrpCat.free)
    have h_nat_f := congrArg (fun m => m.hom (s_pull U₂))
      (((pb_g'.map f_rep).hom).naturality (Opposite.op w₂))
    rw [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp,
      AddMonoidHom.comp_apply, AddMonoidHom.comp_apply] at h_nat_f
    rw [hRepHomLeft, hRepHomRight, h_pull_val, h_pull_val]
    refine Eq.trans ?_ h_nat_f.symm
    have hop : Opposite.op w₁ ≫ v'.op =
        ((weilEtaleSitePullback g').map v).op ≫ Opposite.op w₂ :=
      congrArg Opposite.op h_comm
    rw [← Functor.map_comp_apply, hop, Functor.map_comp_apply]
    congr 1
    let R₁ := weilPolyP1CohomologyRepSheaf X U₁
    let R₂ := weilPolyP1CohomologyRepSheaf X U₂
    let ι₁ := weilPolyP1CohomologyRepHomEquiv X U₁ R₁ (𝟙 R₁)
    let ι₂ := weilPolyP1CohomologyRepHomEquiv X U₂ R₂ (𝟙 R₂)
    have eA :
        ((pb_g'.obj R₁).obj.map ((weilEtaleSitePullback g').map v).op) (s_pull U₁) =
          ((adj_g'.unit.app R₁).hom.app (Opposite.op U₂))
            ((R₁.obj.map v.op) ι₁) := by
      have h := congrArg (fun m => m.hom ι₁)
        (((adj_g'.unit.app R₁).hom).naturality v.op).symm
      rwa [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp,
        AddMonoidHom.comp_apply, AddMonoidHom.comp_apply] at h
    have eB : (R₁.obj.map v.op) ι₁ =
        (f_rep.hom.app (Opposite.op U₂)) ι₂ := by
      have hb1 := hRepHomLeft v R₁ (𝟙 R₁)
      have hb2 := hRepHomRight U₂ (𝟙 R₂) f_rep
      rw [CategoryTheory.Category.id_comp] at hb2
      rw [CategoryTheory.Category.comp_id] at hb1
      exact hb1.symm.trans hb2
    have eC : ((adj_g'.unit.app R₁).hom.app (Opposite.op U₂))
          ((f_rep.hom.app (Opposite.op U₂)) ι₂) =
        ((pb_g'.map f_rep).hom.app (Opposite.op ((weilEtaleSitePullback g').obj U₂)))
          (s_pull U₂) :=
      congrArg (fun m => (m.hom.app (Opposite.op U₂)).hom ι₂)
        (adj_g'.unit.naturality f_rep)
    exact eA.trans
      ((congrArg ((adj_g'.unit.app R₁).hom.app (Opposite.op U₂)) eB).trans eC)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_f := weilEtaleSitePullback f
  let B_g := weilEtaleSitePullback g
  let B_f' := weilEtaleSitePullback f'
  let B_g' := weilEtaleSitePullback g'
  let adj_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
  let adj_S' := CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology AddCommGrpCat.{u}
  let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_f B_g')
