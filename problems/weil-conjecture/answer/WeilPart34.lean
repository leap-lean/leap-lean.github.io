    · intro hz1_X1
      obtain ⟨h23_0, _, hexA_0, _⟩ := hex_both 0
      let δ₀ : pf.obj SC.X₃ ⟶ R_fn 1 SC.X₁ := (e_deg0 SC.X₃).inv ≫ Δ 0
