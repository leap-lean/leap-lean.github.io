  obtain ⟨_, _, _, hc_g'_pbc, _, hr_g'_pbc, _, hInj_f'⟩ := hPBC S' X' g f' g' hpb
  have hcg'_eq : hc_g'_pbc = (sys g').hCont := Subsingleton.elim _ _
  subst hcg'_eq
  have hrg'_eq : hr_g'_pbc = (sys g').hAdj := Subsingleton.elim _ _
  subst hrg'_eq
  have hAll : ∀ (q : ℕ) (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      CategoryTheory.IsIso (bc q G) := by
    intro q
    induction q with
    | zero =>
      intro G hG_tor
      exact hDegZero G hG_tor
    | succ m ih =>
      intro G hG_tor
      obtain ⟨I, hInjI, Q, u, v, huv, hUI_tor, hQ_tor, hSE⟩ := hModPrimeRes G hG_tor
      have : CategoryTheory.Injective I := hInjI
      let UI := U_sh.obj I
      let SC := CategoryTheory.ShortComplex.mk u v huv
      let hSE' := hSE.map_of_exact pb_g'
      obtain ⟨h0₂, h0₃, hex₂, hex₃⟩ := hLongExact f SC hSE m
      obtain ⟨h0₂', h0₃', hex₂', hex₃'⟩ := hLongExact f' (SC.map pb_g') hSE' m
      let Z₁ := pb_g.obj (weilEtaleHigherDirectImage f (m + 1) UI)
      let Z₂ := weilEtaleHigherDirectImage f' (m + 1) (pb_g'.obj UI)
      have hZ₁ : CategoryTheory.Limits.IsZero Z₁ :=
        pb_g.map_isZero (hInjZero_f I (m + 1) (Nat.succ_pos m))
      have hZ₂ : CategoryTheory.Limits.IsZero Z₂ :=
        hInj_f' I (m + 1) (Nat.succ_pos m)
      let S_top₂ := (CategoryTheory.ShortComplex.mk
        (weilEtaleHigherDirectImageMap f m v)
        (weilSingDevAlgBCConnHom f SC hSE m) h0₂).map pb_g
      let S_top₃ := (CategoryTheory.ShortComplex.mk
        (weilSingDevAlgBCConnHom f SC hSE m)
        (weilEtaleHigherDirectImageMap f (m + 1) u) h0₃).map pb_g
      have hex_top₂ : S_top₂.Exact := hex₂.map pb_g
      have hex_top₃ : S_top₃.Exact := hex₃.map pb_g
      have hex_top₄ : (CategoryTheory.ShortComplex.mk S_top₃.g (0 : Z₁ ⟶ Z₁)
          CategoryTheory.Limits.comp_zero).Exact :=
        CategoryTheory.ShortComplex.exact_of_isZero_X₂ _ hZ₁
      have hex_bot₄ : (CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap f' (m + 1) (pb_g'.map u)) (0 : Z₂ ⟶ Z₂)
          CategoryTheory.Limits.comp_zero).Exact :=
        CategoryTheory.ShortComplex.exact_of_isZero_X₂ _ hZ₂
      let R₁ := CategoryTheory.ComposableArrows.mk₄
        S_top₂.f S_top₂.g S_top₃.g (0 : Z₁ ⟶ Z₁)
      let R₂ := CategoryTheory.ComposableArrows.mk₄
        (weilEtaleHigherDirectImageMap f' m (pb_g'.map v))
        (weilSingDevAlgBCConnHom f' (SC.map pb_g') hSE' m)
        (weilEtaleHigherDirectImageMap f' (m + 1) (pb_g'.map u))
        (0 : Z₂ ⟶ Z₂)
      have hR₁_ex : R₁.Exact :=
        CategoryTheory.ComposableArrows.exact_of_δ₀ hex_top₂.exact_toComposableArrows
          (CategoryTheory.ComposableArrows.exact_of_δ₀ hex_top₃.exact_toComposableArrows
            hex_top₄.exact_toComposableArrows)
      have hR₂_ex : R₂.Exact :=
        CategoryTheory.ComposableArrows.exact_of_δ₀ hex₂'.exact_toComposableArrows
          (CategoryTheory.ComposableArrows.exact_of_δ₀ hex₃'.exact_toComposableArrows
            hex_bot₄.exact_toComposableArrows)
      have hc₀ : S_top₂.f ≫ bc m Q = bc m UI ≫ weilEtaleHigherDirectImageMap f' m (pb_g'.map v) :=
        hNat m v
      have hc₁ : S_top₂.g ≫ bc (m + 1) G =
          bc m Q ≫ weilSingDevAlgBCConnHom f' (SC.map pb_g') hSE' m :=
        hConnNat m SC hSE
      have hc₂ : S_top₃.g ≫ bc (m + 1) UI =
          bc (m + 1) G ≫ weilEtaleHigherDirectImageMap f' (m + 1) (pb_g'.map u) :=
        hNat (m + 1) u
      have hc₃ : (0 : Z₁ ⟶ Z₁) ≫ bc (m + 1) UI = bc (m + 1) UI ≫ (0 : Z₂ ⟶ Z₂) :=
        CategoryTheory.Limits.zero_comp.trans CategoryTheory.Limits.comp_zero.symm
      let Φ : R₁ ⟶ R₂ :=
        CategoryTheory.ComposableArrows.homMk₄
          (bc m UI) (bc m Q) (bc (m + 1) G) (bc (m + 1) UI) (bc (m + 1) UI)
          hc₀ hc₁ hc₂ hc₃
      haveI : CategoryTheory.IsIso (bc m UI) := ih UI hUI_tor
      haveI : CategoryTheory.IsIso (bc m Q) := ih Q hQ_tor
      haveI hIso₃ : CategoryTheory.IsIso (bc (m + 1) UI) :=
        ⟨⟨0, hZ₁.eq_of_src _ _, hZ₂.eq_of_src _ _⟩⟩
      exact CategoryTheory.Abelian.isIso_of_epi_of_isIso_of_isIso_of_mono hR₁_ex hR₂_ex Φ
        (inferInstance : CategoryTheory.Epi (bc m UI))
        (inferInstance : CategoryTheory.IsIso (bc m Q))
        hIso₃
        (inferInstance : CategoryTheory.Mono (bc (m + 1) UI))
  intro F q hF_tor
  exact hAll q F hF_tor

theorem weil_sm_pencil_sec_push_const_and_edge_compat (sys : WeilEtaleSitePullbackSys.{u})
    (hTerm : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
      {T₂ : Z₂.Etale},
      CategoryTheory.Limits.IsTerminal T₂ →
      CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback h).obj T₂)) :
    (∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      letI := (sys h).hCont
      letI := (sys h).hAdj
      let pb_h := (weilEtaleSitePullback h).sheafPullback
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf Z₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf Z₂.smallEtaleTopology AddCommGrpCat.{u}
      ∀ {A₁ A₂ : AddCommGrpCat.{u}} (φ : Quiver.Hom A₁ A₂),
        CategoryTheory.CategoryStruct.comp (pb_h.map (C₂.map φ))
            (weilEtaleConstPullbackHom h
              (weilEtaleIdTerminalIsTerminal.{u} Z₁)
              (weilEtaleIdTerminalIsTerminal.{u} Z₂) A₂) =
          CategoryTheory.CategoryStruct.comp
            (weilEtaleConstPullbackHom h
              (weilEtaleIdTerminalIsTerminal.{u} Z₁)
              (weilEtaleIdTerminalIsTerminal.{u} Z₂) A₁)
            (C₁.map φ)) ∧
    (∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) (q : ℕ)
        (SC₁ SC₂ : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
        (hSE₁ : SC₁.ShortExact) (hSE₂ : SC₂.ShortExact)
        (Φ : Quiver.Hom SC₁ SC₂),
      CategoryTheory.CategoryStruct.comp
          (weilSmPencilLerayConnHom f SC₁ hSE₁ q)
          (weilEtaleHigherDirectImageMap f (q + 1) Φ.τ₁) =
        CategoryTheory.CategoryStruct.comp
          (weilEtaleHigherDirectImageMap f q Φ.τ₃)
          (weilSmPencilLerayConnHom f SC₂ hSE₂ q)) ∧
    (∀ {X S S' X' : AlgebraicGeometry.Scheme.{u}}
        (f : Quiver.Hom X S) (g : Quiver.Hom S' S)
        (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
        (h_sq : CategoryTheory.CategoryStruct.comp g' f =
          CategoryTheory.CategoryStruct.comp f' g),
      letI := (sys g).hCont
      letI := (sys g').hCont
      letI := (sys g').hAdj
      letI := (sys g').hAdd_pb
      letI := (sys g').hLim_pb
      letI := (sys g').hColim_pb
      let T_S := weilEtaleIdTerminal.{u} S
      let T_S' := weilEtaleIdTerminal.{u} S'
      let hT_pull := hTerm g (weilEtaleIdTerminalIsTerminal.{u} S)
      ∀ (m q : ℕ) (β : _)
          (p_pull : weilEtaleTorsionH X m q →+ weilEtaleTorsionH X' m q)
          (y : weilEtaleTorsionH X m q),
        WeilIsSmPencilLerayBCPush f g f' g' h_sq (weilEtaleTorsionSheaf X m) q β →
        WeilIsTorsionEtalePullback g' m q p_pull →
        weilSmPencilLeraySecPush f g f' g' hT_pull m q β
          (weilOuterTrFibEdgeHom f T_S
            (hTerm f (weilEtaleIdTerminalIsTerminal.{u} S))
            (weilEtaleTorsionSheaf X m) q y) =
        weilOuterTrFibEdgeHom f' T_S'
          (hTerm f' (weilEtaleIdTerminalIsTerminal.{u} S'))
          (weilEtaleTorsionSheaf X' m) q (p_pull y)) :=
by
  
  have hUnitCoh : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {T T' : Y.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (A : AddCommGrpCat.{u}),
      let J := Y.smallEtaleTopology
      let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A ≫
        (C.obj A).obj.map (hT'.from T).op =
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A := by
    intro Y T T' hT hT' A J C
    let K : AddCommGrpCat.{u} ⥤ (Opposite Y.Etale ⥤ AddCommGrpCat.{u}) :=
      CategoryTheory.Functor.const (Opposite Y.Etale)
    let η_sh := (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit
    have h_u : ∀ {W : Y.Etale} (hW : CategoryTheory.Limits.IsTerminal W),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hW).unit.app A =
          (η_sh.app (K.obj A)).app (Opposite.op W) := by
      intro W hW
      dsimp [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    rw [h_u hT', h_u hT]
    have hnat := (η_sh.app (K.obj A)).naturality (hT'.from T).op
    dsimp [K] at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm

  have hHomEquivCoh : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {T T' : Y.Etale} (hT : CategoryTheory.Limits.IsTerminal T)
      (hT' : CategoryTheory.Limits.IsTerminal T') (A : AddCommGrpCat.{u})
      (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (φ : (CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ G),
      ((CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT').homEquiv
          A G φ) ≫
        G.obj.map (hT'.from T).op =
      (CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT).homEquiv
        A G φ := by
    intro Y T T' hT hT' A G φ
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    change (_ ≫ φ.hom.app (Opposite.op T')) ≫ G.obj.map (hT'.from T).op =
      _ ≫ φ.hom.app (Opposite.op T)
    rw [CategoryTheory.Category.assoc, ← φ.hom.naturality (hT'.from T).op,
      ← CategoryTheory.Category.assoc, hUnitCoh hT hT' A]

  have hConstIndep : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
      {T₁ T₁' : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT₁' : CategoryTheory.Limits.IsTerminal T₁')
      {T₂ T₂' : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (hT₂' : CategoryTheory.Limits.IsTerminal T₂')
      (A : AddCommGrpCat.{u}),
      letI := (sys h).hCont
      letI := (sys h).hAdj
      weilEtaleConstPullbackHom h hT₁ hT₂ A = weilEtaleConstPullbackHom h hT₁' hT₂' A := by
    intro S₁ S₂ h T₁ T₁' hT₁ hT₁' T₂ T₂' hT₂ hT₂' A
    letI := (sys h).hCont
    letI := (sys h).hAdj
    let B := weilEtaleSitePullback h
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let adj_h := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₁' := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁'
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let adj₂' := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂'
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    let τ' : B.obj T₂' ⟶ T₁' := hT₁'.from (B.obj T₂')
    let u₁ : T₁ ⟶ T₁' := hT₁'.from T₁
    let u₂ : T₂ ⟶ T₂' := hT₂'.from T₂
    apply (adj_h.homEquiv (C₂.obj A) (C₁.obj A)).injective
    apply (adj₂.homEquiv A (pf_h.obj (C₁.obj A))).injective
    have hLHS : (adj₂.homEquiv A (pf_h.obj (C₁.obj A)))
        ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
          (weilEtaleConstPullbackHom h hT₁ hT₂ A)) =
        adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op := by
      dsimp [weilEtaleConstPullbackHom]
      rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      rfl
    have hRHS : (adj₂.homEquiv A (pf_h.obj (C₁.obj A)))
        ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
          (weilEtaleConstPullbackHom h hT₁' hT₂' A)) =
        adj₁.unit.app A ≫ (C₁.obj A).obj.map τ.op := by
      rw [← hHomEquivCoh hT₂ hT₂' A (pf_h.obj (C₁.obj A))]
      have h_inner : (adj₂'.homEquiv A (pf_h.obj (C₁.obj A)))
          ((adj_h.homEquiv (C₂.obj A) (C₁.obj A))
            (weilEtaleConstPullbackHom h hT₁' hT₂' A)) =
          adj₁'.unit.app A ≫ (C₁.obj A).obj.map τ'.op := by
        dsimp [weilEtaleConstPullbackHom]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        rfl
      rw [h_inner]
      change (adj₁'.unit.app A ≫ (C₁.obj A).obj.map τ'.op) ≫
          (C₁.obj A).obj.map (B.map u₂).op = _
      have hcomm_T : B.map u₂ ≫ τ' = τ ≫ u₁ := hT₁'.hom_ext _ _
      rw [CategoryTheory.Category.assoc, ← (C₁.obj A).obj.map_comp, ← CategoryTheory.op_comp,
        hcomm_T, CategoryTheory.op_comp, (C₁.obj A).obj.map_comp, ← CategoryTheory.Category.assoc]
      exact congrArg (· ≫ (C₁.obj A).obj.map τ.op) (hUnitCoh hT₁ hT₁' A)
    exact hLHS.trans hRHS.symm

  refine ⟨?_, ?_, ?_⟩
  · 
    intro Z₁ Z₂ h
    letI := (sys h).hCont
    letI := (sys h).hAdj
    intro pb_h C₁ C₂ A₁ A₂ φ
    let B := weilEtaleSitePullback h
    let J₁ := Z₁.smallEtaleTopology
    let J₂ := Z₂.smallEtaleTopology
    let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let adj_h := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let T₁ := weilEtaleIdTerminal.{u} Z₁
    let T₂ := weilEtaleIdTerminal.{u} Z₂
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} Z₁
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} Z₂
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    apply (adj_h.homEquiv (C₂.obj A₁) (C₁.obj A₂)).injective
    apply (adj₂.homEquiv A₁ (pf_h.obj (C₁.obj A₂))).injective
    have hLHS :
        (adj₂.homEquiv A₁ (pf_h.obj (C₁.obj A₂)))
          ((adj_h.homEquiv (C₂.obj A₁) (C₁.obj A₂))
            (pb_h.map (C₂.map φ) ≫ weilEtaleConstPullbackHom h hT₁ hT₂ A₂)) =
        φ ≫ (adj₁.unit.app A₂ ≫ (C₁.obj A₂).obj.map τ.op) := by
      rw [adj_h.homEquiv_naturality_left]
      dsimp only [weilEtaleConstPullbackHom]
      rw [Equiv.apply_symm_apply, adj₂.homEquiv_naturality_left, Equiv.apply_symm_apply]
      rfl
    have hRHS :
        (adj₂.homEquiv A₁ (pf_h.obj (C₁.obj A₂)))
          ((adj_h.homEquiv (C₂.obj A₁) (C₁.obj A₂))
            (weilEtaleConstPullbackHom h hT₁ hT₂ A₁ ≫ C₁.map φ)) =
        (adj₁.unit.app A₁ ≫ (C₁.obj A₁).obj.map τ.op) ≫
          (C₁.map φ).hom.app (Opposite.op (B.obj T₂)) := by
      rw [adj_h.homEquiv_naturality_right]
      dsimp only [weilEtaleConstPullbackHom]
      rw [Equiv.apply_symm_apply, adj₂.homEquiv_naturality_right, Equiv.apply_symm_apply]
      rfl
    have hMid :
        φ ≫ (adj₁.unit.app A₂ ≫ (C₁.obj A₂).obj.map τ.op) =
        (adj₁.unit.app A₁ ≫ (C₁.obj A₁).obj.map τ.op) ≫
          (C₁.map φ).hom.app (Opposite.op (B.obj T₂)) :=
      (CategoryTheory.Category.assoc φ (adj₁.unit.app A₂) ((C₁.obj A₂).obj.map τ.op)).symm.trans
        ((congrArg (· ≫ (C₁.obj A₂).obj.map τ.op) (adj₁.unit.naturality φ)).trans
          ((CategoryTheory.Category.assoc (adj₁.unit.app A₁)
              ((C₁.map φ).hom.app (Opposite.op T₁)) ((C₁.obj A₂).obj.map τ.op)).trans
            ((congrArg (adj₁.unit.app A₁ ≫ ·) ((C₁.map φ).hom.naturality τ.op).symm).trans
              (CategoryTheory.Category.assoc (adj₁.unit.app A₁)
                ((C₁.obj A₁).obj.map τ.op)
                ((C₁.map φ).hom.app (Opposite.op (B.obj T₂)))).symm)))
    exact hLHS.trans (hMid.trans hRHS.symm)

  · 
    have h_ext : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u + 1} C]
        [CategoryTheory.Abelian C] [CategoryTheory.HasExt.{u} C]
        (q : ℕ) (Rep : C) (S₁ S₂ : CategoryTheory.ShortComplex C)
        (h₁ : S₁.ShortExact) (h₂ : S₂.ShortExact) (ψ : S₁ ⟶ S₂),
        AddCommGrpCat.ofHom (h₁.extClass.postcomp Rep (rfl : q + 1 = q + 1)) ≫
          (CategoryTheory.Abelian.extFunctorObj Rep (q + 1)).map ψ.τ₁ =
        (CategoryTheory.Abelian.extFunctorObj Rep q).map ψ.τ₃ ≫
          AddCommGrpCat.ofHom (h₂.extClass.postcomp Rep (rfl : q + 1 = q + 1)) := by
      intro C _ _ _ q Rep S₁ S₂ h₁ h₂ ψ
      rw [CategoryTheory.Abelian.extFunctorObj_map Rep (q + 1) ψ.τ₁,
        CategoryTheory.Abelian.extFunctorObj_map Rep q ψ.τ₃]
      ext x
      exact (CategoryTheory.Abelian.Ext.comp_assoc x h₁.extClass
          (CategoryTheory.Abelian.Ext.mk₀ ψ.τ₁) (rfl : q + 1 = q + 1) (Nat.add_zero 1)
          (by omega)).trans
        ((congrArg (fun e => x.comp e (rfl : q + 1 = q + 1))
            (CategoryTheory.ShortComplex.ShortExact.extClass_naturality h₁ h₂ ψ)).trans
          (CategoryTheory.Abelian.Ext.comp_assoc x (CategoryTheory.Abelian.Ext.mk₀ ψ.τ₃)
            h₂.extClass (Nat.add_zero q) (Nat.zero_add 1) (by omega)).symm)
    intro X S f q SC₁ SC₂ hSE₁ hSE₂ Φ
    let J_X := X.smallEtaleTopology
    let J_S := S.smallEtaleTopology
    let B := weilEtaleSitePullback f
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj B.op
    let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
    let F_S := W_B ⋙ Sh_S
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let L_tot := Free_PSh ⋙ CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
    let Z_fun : CategoryTheory.Functor X.Etale (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) :=
      CategoryTheory.yoneda ⋙ L_tot
    let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      fun W => Opposite.unop (Z_fun.op.obj W)
    let mk_δ : ∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
        (hSE : SC.ShortExact),
