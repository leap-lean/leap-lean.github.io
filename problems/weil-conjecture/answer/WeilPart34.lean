      AlgebraicGeometry.IsOpenImmersion.lift_fac U_lc.ι g_K hRange_lc
    obtain ⟨v₀, hv₀⟩ := hSurj_plc.surj (g_lc.base (⊥ : PrimeSpectrum K))
    have hv₀_base : p_lc.base v₀ = g_lc.base (⊥ : PrimeSpectrum K) := hv₀
    obtain ⟨z₀, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := p_lc) (g := g_lc)
        v₀ (⊥ : PrimeSpectrum K) hv₀_base
    let fst_lc := CategoryTheory.Limits.pullback.fst p_lc g_lc
    let snd_lc := CategoryTheory.Limits.pullback.snd p_lc g_lc
    let E_lc : S_K.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ snd_lc inferInstance
    obtain ⟨τ_lc, _, _⟩ := hCoverByTK K E_lc z₀
    let σ_lc : S_K ⟶ CategoryTheory.Limits.pullback p_lc g_lc := τ_lc.left
    have hσ_lc : σ_lc ≫ snd_lc = 𝟙 S_K := CategoryTheory.MorphismProperty.Over.w τ_lc
    let g_tilde : S_K ⟶ V_lc := σ_lc ≫ fst_lc
    have hg_tilde : g_tilde ≫ (p_lc ≫ U_lc.ι) = g_K := by
      dsimp [g_tilde]
      rw [← Category.assoc, Category.assoc σ_lc, CategoryTheory.Limits.pullback.condition,
        ← Category.assoc, hσ_lc, Category.id_comp, hg_lc]
    let C_K := CategoryTheory.constantSheaf S_K.smallEtaleTopology AddCommGrpCat.{u}
    have hPB_const : WeilIsEtaleSheafPullback g_K Rq (C_K.obj B_gen) := by
      rw [← hg_tilde]
      exact (hCompPB_ex g_tilde (p_lc ≫ U_lc.ι) Rq _ (C_K.obj B_gen)).1 hPB_lc
        (hConstPB_ex g_tilde B_gen)
    obtain ⟨e_HK⟩ := hUniquePB g_K Rq H_K (C_K.obj B_gen) hPB_HK hPB_const
    obtain ⟨e_H0⟩ := hIsoH0 e_HK
    let T_K := weilEtaleIdTerminal.{u} S_K
    let hT_K := weilEtaleIdTerminalIsTerminal.{u} S_K
    let e_CK_H0 : (C_K.obj B_gen).H 0 ≃+ ↥((C_K.obj B_gen).obj.obj (Opposite.op T_K)) :=
      CategoryTheory.Sheaf.H.equiv₀ (C_K.obj B_gen) hT_K
    let e_Bgen : ↥B_gen ≃ ↥((C_K.obj B_gen).obj.obj (Opposite.op T_K)) :=
      Equiv.ofBijective _ (hConstEvalBij K B_gen)
    let e_tot : H_K.H 0 ≃ ↥B_gen :=
      e_H0.toEquiv.trans (e_CK_H0.toEquiv.trans e_Bgen.symm)
    exact ⟨Finite.of_equiv ↥B_gen e_tot.symm, Nat.card_congr e_tot⟩

  
