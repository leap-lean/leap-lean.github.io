          ∀ (l₁ l₂ : I) (_ : Fin m), TensorProduct R' (S' l₁) (S' l₂) :=
        { toFun := fun y l₁ l₂ i =>
            inl_R' l₁ l₂ (y i l₁) - ∑ j : Fin m, mulRight_R' (ψ₁₂ l₁ l₂ (χ l₁ l₂ i j)) (y j l₂)
          map_add' := fun y₁ y₂ => by
            funext l₁ l₂ i
            change inl_R' l₁ l₂ (y₁ i l₁ + y₂ i l₁) -
                ∑ j : Fin m, mulRight_R' (ψ₁₂ l₁ l₂ (χ l₁ l₂ i j)) (y₁ j l₂ + y₂ j l₂) =
              (inl_R' l₁ l₂ (y₁ i l₁) - ∑ j : Fin m, mulRight_R' (ψ₁₂ l₁ l₂ (χ l₁ l₂ i j)) (y₁ j l₂)) +
                (inl_R' l₁ l₂ (y₂ i l₁) - ∑ j : Fin m, mulRight_R' (ψ₁₂ l₁ l₂ (χ l₁ l₂ i j)) (y₂ j l₂))
            simp only [map_add, Finset.sum_add_distrib, sub_add_sub_comm]
          map_smul' := fun r' y => by
            funext l₁ l₂ i
            change inl_R' l₁ l₂ (r' • y i l₁) -
                ∑ j : Fin m, mulRight_R' (ψ₁₂ l₁ l₂ (χ l₁ l₂ i j)) (r' • y j l₂) =
              r' • (inl_R' l₁ l₂ (y i l₁) - ∑ j : Fin m, mulRight_R' (ψ₁₂ l₁ l₂ (χ l₁ l₂ i j)) (y j l₂))
            simp only [map_smul, Finset.smul_sum, smul_sub] }
      have hδ'_iff : ∀ y : Fin m → ∀ l : I, S' l,
          δ' y = 0 ↔ ∃ w : TensorProduct R R' ↥B, ι_bc w = y := by
        intro y
        rw [← hΔ_exact y]
        refine ⟨fun h => ?_, fun h => ?_⟩
        · funext l₁ l₂ i
          apply (d_bc l₁ l₂).injective
