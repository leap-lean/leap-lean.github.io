    (hFieldCd : ∀ (κ₀ K : Type u) [Field κ₀] [IsSepClosed κ₀] [Field K] [Algebra κ₀ K],
      (ℓ : κ₀) ≠ 0 → Algebra.trdeg κ₀ K ≤ (1 : Cardinal.{u}) →
