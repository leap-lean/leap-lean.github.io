      exact ((weil_etale_higherDirectImage_shortExact_calculus (j ≫ π.left)).2.2
        (SC_Y n) (hSE_Y n) (hK_jπ_acyc n)).2.2 m hm (ih (m + 1) (by omega))

  have hEpi_pfπ_pfj_v : ∀ n : ℕ, CategoryTheory.Epi (pf_π.map (pf_j.map (v_syr n))) := by
    intro n
    have hSE_jπ : ((SC_Y n).map pf_jπ).ShortExact :=
      (((weil_etale_higherDirectImage_shortExact_calculus (j ≫ π.left)).2.2
        (SC_Y n) (hSE_Y n) (hK_jπ_acyc n)).1).2 (hZ_jπ_acyc n 1 (le_refl 1))
    have _ : CategoryTheory.Epi (pf_jπ.map (v_syr n)) := hSE_jπ.epi_g
    have hconj : pf_π.map (pf_j.map (v_syr n)) =
        e_pf_comp.hom.app (K_syr n) ≫ pf_jπ.map (v_syr n) ≫ e_pf_comp.inv.app (Z (n + 1)) := by
      change (pf_j ⋙ pf_π).map (v_syr n) = _
      rw [← CategoryTheory.Category.assoc, ← e_pf_comp.hom.naturality (v_syr n),
        CategoryTheory.Category.assoc, e_pf_comp.hom_inv_id_app, CategoryTheory.Category.comp_id]
    rw [hconj]
    have _ : CategoryTheory.Epi (pf_jπ.map (v_syr n) ≫ e_pf_comp.inv.app (Z (n + 1))) :=
      CategoryTheory.epi_comp _ _
    exact CategoryTheory.epi_comp _ _

  
  let R_syr : ℕ → CategoryTheory.Sheaf P.left.smallEtaleTopology AddCommGrpCat.{u} :=
    fun n => weilEtaleHigherDirectImage j 1 (Z n)
  let M_syr : ℕ → CategoryTheory.Sheaf P.left.smallEtaleTopology AddCommGrpCat.{u} :=
    fun n => CategoryTheory.Limits.cokernel (pf_j.map (u_syr n))
  let p_syr : ∀ n : ℕ, pf_j.obj (K_syr n) ⟶ M_syr n :=
    fun n => CategoryTheory.Limits.cokernel.π (pf_j.map (u_syr n))

  have hStepAB : ∀ n : ℕ,
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π.left 1 (pf_j.obj (Z n))) ∧
      (∀ q : ℕ, 1 ≤ q →
        Nonempty (weilEtaleHigherDirectImage π.left (q + 1) (pf_j.obj (Z n)) ≅
          weilEtaleHigherDirectImage π.left q (M_syr n))) ∧
      ∃ (ι_n : M_syr n ⟶ pf_j.obj (Z (n + 1)))
        (δ_n : pf_j.obj (Z (n + 1)) ⟶ R_syr n)
        (hι_δ : ι_n ≫ δ_n = 0),
        (CategoryTheory.ShortComplex.mk ι_n δ_n hι_δ).ShortExact ∧
        CategoryTheory.Epi (weilEtaleHigherDirectImageMap π.left 0 ι_n) := by
    intro n
    obtain ⟨hEx_pfj, hMono_pfj_u⟩ :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_j).mp
        inferInstance (SC_Y n) (hSE_Y n)
    have _ : CategoryTheory.Mono (pf_j.map (u_syr n)) := hMono_pfj_u
    have h_pfj_uv : pf_j.map (u_syr n) ≫ pf_j.map (v_syr n) = 0 := ((SC_Y n).map pf_j).zero
    have hp_cond : pf_j.map (u_syr n) ≫ p_syr n = 0 :=
      CategoryTheory.Limits.cokernel.condition (pf_j.map (u_syr n))
    let SC_A := CategoryTheory.ShortComplex.mk (pf_j.map (u_syr n)) (p_syr n) hp_cond
    have hSE_A : SC_A.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_cokernel (pf_j.map (u_syr n)))
        hMono_pfj_u inferInstance
    let ι_n : M_syr n ⟶ pf_j.obj (Z (n + 1)) :=
      CategoryTheory.Limits.cokernel.desc (pf_j.map (u_syr n)) (pf_j.map (v_syr n)) h_pfj_uv
    have hpι : p_syr n ≫ ι_n = pf_j.map (v_syr n) :=
      CategoryTheory.Limits.cokernel.π_desc _ _ _
    have hMono_ι : CategoryTheory.Mono ι_n :=
      (((SC_Y n).map pf_j).exact_iff_mono_cokernel_desc).mp hEx_pfj
    have _ : CategoryTheory.Mono ι_n := hMono_ι
    obtain ⟨⟨δ_n, hvδ, hEpi_δ, hEx_vδ⟩, _⟩ :=
      ((weil_etale_higherDirectImage_shortExact_calculus j).2.2
        (SC_Y n) (hSE_Y n) (hK_j_acyc n)).1
    have hι_δ : ι_n ≫ δ_n = 0 := by
      apply (cancel_epi (p_syr n)).mp
      rw [← CategoryTheory.Category.assoc, hpι, hvδ, CategoryTheory.Limits.comp_zero]
    let SC_B := CategoryTheory.ShortComplex.mk ι_n δ_n hι_δ
    have hEpi_klift_v :
        CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift δ_n (pf_j.map (v_syr n)) hvδ) :=
      ((CategoryTheory.ShortComplex.mk (pf_j.map (v_syr n)) δ_n hvδ).exact_iff_epi_kernel_lift).mp
        hEx_vδ
    have hklift_fac :
        p_syr n ≫ CategoryTheory.Limits.kernel.lift δ_n ι_n hι_δ =
          CategoryTheory.Limits.kernel.lift δ_n (pf_j.map (v_syr n)) hvδ := by
      apply (cancel_mono (CategoryTheory.Limits.kernel.ι δ_n)).mp
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι, hpι,
        CategoryTheory.Limits.kernel.lift_ι]
    have hEpi_klift_ι : CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift δ_n ι_n hι_δ) := by
      have _ : CategoryTheory.Epi (p_syr n ≫ CategoryTheory.Limits.kernel.lift δ_n ι_n hι_δ) := by
        rwa [hklift_fac]
      exact CategoryTheory.epi_of_epi (p_syr n) (CategoryTheory.Limits.kernel.lift δ_n ι_n hι_δ)
    have hSE_B : SC_B.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (SC_B.exact_iff_epi_kernel_lift.mpr hEpi_klift_ι) hMono_ι hEpi_δ
    have hpfπ_fac : pf_π.map (p_syr n) ≫ pf_π.map ι_n = pf_π.map (pf_j.map (v_syr n)) := by
      rw [← pf_π.map_comp, hpι]
    have hEpi_pfπ_ι : CategoryTheory.Epi (pf_π.map ι_n) := by
      have _ : CategoryTheory.Epi (pf_π.map (p_syr n) ≫ pf_π.map ι_n) := by
        rw [hpfπ_fac]
        exact hEpi_pfπ_pfj_v n
      exact CategoryTheory.epi_of_epi (pf_π.map (p_syr n)) (pf_π.map ι_n)
    have _ : CategoryTheory.Mono (pf_π.map ι_n) := pf_π.map_mono ι_n
    have _ : CategoryTheory.IsIso (pf_π.map ι_n) :=
      CategoryTheory.isIso_of_mono_of_epi (pf_π.map ι_n)
    have hEpi_pfπ_p : CategoryTheory.Epi (pf_π.map (p_syr n)) := by
      have hp_eq : pf_π.map (p_syr n) =
          pf_π.map (pf_j.map (v_syr n)) ≫ CategoryTheory.inv (pf_π.map ι_n) := by
        rw [← hpfπ_fac, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      have _ : CategoryTheory.Epi (pf_π.map (pf_j.map (v_syr n))) := hEpi_pfπ_pfj_v n
      rw [hp_eq]
      exact CategoryTheory.epi_comp _ _
    have hEpi_R0_ι : CategoryTheory.Epi (weilEtaleHigherDirectImageMap π.left 0 ι_n) :=
      (weil_leray_sec_higherDirectImage_x3_acyclic_iso π.left).1 ι_n hEpi_pfπ_ι
    have hCalc_A := (weil_etale_higherDirectImage_shortExact_calculus π.left).2.2
      SC_A hSE_A (hpfK_π_acyc n)
    obtain ⟨⟨δ_A0, hcomp_A0, hEpi_δA0, _⟩, _⟩ := hCalc_A.1
    have hδA0_zero : δ_A0 = 0 := by
      apply (cancel_epi (pf_π.map (p_syr n))).mp
      rw [CategoryTheory.Limits.comp_zero]
      exact hcomp_A0
    have hZ_R1_pfjZ :
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π.left 1 (pf_j.obj (Z n))) := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply (cancel_epi δ_A0).mp
      rw [hδA0_zero, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
    exact ⟨hZ_R1_pfjZ, hCalc_A.2.1, ι_n, δ_n, hι_δ, hSE_B, hEpi_R0_ι⟩

  have hRn_supp : ∀ n : ℕ,
      WeilIsEtaleSheafPullback i₀ (R_syr n) (weilEtaleHigherDirectImage π.left 0 (R_syr n)) ∧
      (∀ a : ℕ, 1 ≤ a →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π.left a (R_syr n))) := by
    intro n
    exact weil_leray_sec_retracted_closed_complement_support_and_acyclic.{u} k ℓ hPBC
      (fun f I _ p hp =>
        weil_leray_sec_mod_prime_injective_higherDirectImage_isZero.{u} ℓ f I p hp)
      P S π i₀ hi₀_sec Y' j hDisj hCompl (R_syr n)
      (hTorsR j 1 (Z n) (hℓZ n))
      (hOpenRestrZero_any P.left Y' j (Z n) 1 (le_refl 1))

  have hR0Rn_iso_R1Mn : ∀ n : ℕ,
      Nonempty (weilEtaleHigherDirectImage π.left 0 (R_syr n) ≅
        weilEtaleHigherDirectImage π.left 1 (M_syr n)) := by
    intro n
    obtain ⟨_, _, ι_n, δ_n, hι_δ, hSE_B, hEpi_R0_ι⟩ := hStepAB n
    exact ((weil_leray_sec_higherDirectImage_x3_acyclic_iso π.left).2
      (CategoryTheory.ShortComplex.mk ι_n δ_n hι_δ) hSE_B).1
      hEpi_R0_ι (hStepAB (n + 1)).1

  have hShiftDown : ∀ (n p : ℕ), 1 ≤ p →
      Nonempty (weilEtaleHigherDirectImage π.left (p + 1) (pf_j.obj (Z (n + 1))) ≅
        weilEtaleHigherDirectImage π.left (p + 2) (pf_j.obj (Z n))) := by
    intro n p hp
    obtain ⟨_, hShift_A, ι_n, δ_n, hι_δ, hSE_B, _⟩ := hStepAB n
    obtain ⟨e_A⟩ := hShift_A (p + 1) (by omega)
    obtain ⟨e_B⟩ := ((weil_leray_sec_higherDirectImage_x3_acyclic_iso π.left).2
      (CategoryTheory.ShortComplex.mk ι_n δ_n hι_δ) hSE_B).2 p
      ((hRn_supp n).2 p hp) ((hRn_supp n).2 (p + 1) (by omega))
    exact ⟨e_B.symm ≪≫ e_A.symm⟩

  have hChainLHS : ∀ (s q : ℕ), 1 ≤ q →
      Nonempty (weilEtaleHigherDirectImage j q (Z s) ≅
        weilEtaleHigherDirectImage j (q + s) (Z 0)) := by
    intro s
    induction s with
    | zero =>
      intro q _
      rw [Nat.add_zero]
      exact ⟨CategoryTheory.Iso.refl _⟩
    | succ s ih =>
      intro q hq
      obtain ⟨e_step⟩ := ((weil_etale_higherDirectImage_shortExact_calculus j).2.2
        (SC_Y s) (hSE_Y s) (hK_j_acyc s)).2.1 q hq
      obtain ⟨e_ih⟩ := ih (q + 1) (by omega)
      have hadd : (q + 1) + s = q + (s + 1) := by omega
      rw [hadd] at e_ih
      exact ⟨e_step.symm ≪≫ e_ih⟩

  have hChainRHS : ∀ (s p : ℕ), 1 ≤ p →
      Nonempty (weilEtaleHigherDirectImage π.left (p + 1) (pf_j.obj (Z s)) ≅
        weilEtaleHigherDirectImage π.left (p + 1 + s) (pf_j.obj (Z 0))) := by
    intro s
    induction s with
    | zero =>
      intro p _
      rw [Nat.add_zero]
      exact ⟨CategoryTheory.Iso.refl _⟩
    | succ s ih =>
      intro p hp
      obtain ⟨e_step⟩ := hShiftDown s p hp
      obtain ⟨e_ih⟩ := ih (p + 1) (by omega)
      have hadd : (p + 1) + 1 + s = p + 1 + (s + 1) := by omega
      rw [hadd] at e_ih
      exact ⟨e_step ≪≫ e_ih⟩

  obtain ⟨r, rfl⟩ : ∃ r : ℕ, b = r + 1 := ⟨b - 1, (Nat.sub_add_cancel hb).symm⟩

  have hIso_LHS : Nonempty (R_syr r ≅
      weilEtaleHigherDirectImage j (r + 1) (weilEtaleTorsionSheaf Y' ℓ)) := by
    obtain ⟨e_L⟩ := hChainLHS r 1 (le_refl 1)
    have h1r : 1 + r = r + 1 := Nat.add_comm 1 r
    rw [h1r] at e_L
    exact ⟨e_L⟩

  have hIso_RHS : Nonempty (weilEtaleHigherDirectImage π.left 0 (R_syr r) ≅
      weilEtaleHigherDirectImage π.left ((r + 1) + 1) (weilEtaleTorsionSheaf P.left ℓ)) := by
    obtain ⟨e_01⟩ := hR0Rn_iso_R1Mn r
    obtain ⟨e_12⟩ := (hStepAB r).2.1 1 (le_refl 1)
    obtain ⟨e_ch⟩ := hChainRHS r 1 (le_refl 1)
    have h2r : 1 + 1 + r = (r + 1) + 1 := by omega
    rw [h2r] at e_ch
    obtain ⟨e_tors0⟩ :=
      weil_leray_sec_open_conn_torsion_pushforward_iso.{u} P.left Y' j hConn hConnBasis ℓ
    obtain ⟨e_j0⟩ := (weil_etale_higherDirectImage_shortExact_calculus j).2.1 (Z 0)
    let e_pfZ0 : pf_j.obj (Z 0) ≅ weilEtaleTorsionSheaf P.left ℓ :=
      e_j0.symm ≪≫ e_tors0.symm
    obtain ⟨e_end⟩ :=
      ((weil_etale_higherDirectImage_shortExact_calculus π.left).1 _ _ ((r + 1) + 1)).1 ⟨e_pfZ0⟩
    exact ⟨e_01 ≪≫ e_12.symm ≪≫ e_ch ≪≫ e_end⟩

  exact hIsoPB i₀ (R_syr r)
    (weilEtaleHigherDirectImage j (r + 1) (weilEtaleTorsionSheaf Y' ℓ))
    (weilEtaleHigherDirectImage π.left 0 (R_syr r))
    (weilEtaleHigherDirectImage π.left ((r + 1) + 1) (weilEtaleTorsionSheaf P.left ℓ))
    (hRn_supp r).1 hIso_LHS hIso_RHS

theorem weil_codim1_purity_kummer_class_nonvanishing_and_pow_zero (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0) (δ : ℕ) :
    let S_δ := weilAffineSpaceOver k δ
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let κ_A1 : A1_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_δ := CategoryTheory.Limits.pullback S_δ.hom p_A1
    let U_δ := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
