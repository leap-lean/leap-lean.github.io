    intro V_et p_V p_σ hp_V hp_σ
    let τ_V : V_et ⟶ T_Y := hT_Y.from V_et
    let b_τ : (B_j.obj V_et).left ⟶ (B_j.obj T_Y).left := (B_j.map τ_V).left
    obtain ⟨p_Bτ, hp_Bτ⟩ := hPullEx b_τ ℓ 1
    obtain ⟨p_mid, hp_mid⟩ := hPullEx (b_τ ≫ π_U) ℓ 1
    have hΘ_step : Θ (B_j.obj V_et) ((Q₁.map τ_V.op).hom ξ_tilde₀) = p_Bτ (p_πU ξ₀) := by
      have h1 := hΘ_nat (B_j.map τ_V) p_Bτ hp_Bτ ξ_tilde₀
      exact h1.trans (congrArg p_Bτ ((Θ (B_j.obj T_Y)).apply_symm_apply (p_πU ξ₀)))
    have hmid_eq : p_mid = p_Bτ.comp p_πU :=
      hPullComp b_τ π_U ℓ 1 p_Bτ p_πU p_mid hp_Bτ hp_πU hp_mid
    have hb_hom : b_τ ≫ π_U = CategoryTheory.Limits.pullback.snd V_et.hom j_U :=
      CategoryTheory.MorphismProperty.Over.w (B_j.map τ_V)
    have hfst_eq : (CategoryTheory.Limits.pullbackSymmetry j_U V_et.hom).hom ≫ (b_τ ≫ π_U) =
        CategoryTheory.Limits.pullback.fst j_U V_et.hom :=
      (congrArg ((CategoryTheory.Limits.pullbackSymmetry j_U V_et.hom).hom ≫ ·) hb_hom).trans
        (CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd j_U V_et.hom)
    have hp_V' : WeilIsTorsionEtalePullback
        ((CategoryTheory.Limits.pullbackSymmetry j_U V_et.hom).hom ≫ (b_τ ≫ π_U)) ℓ 1 p_V :=
      hfst_eq.symm ▸ hp_V
    have hpV_eq : p_V = p_σ.comp p_mid :=
      hPullComp _ (b_τ ≫ π_U) ℓ 1 p_σ p_mid p_V hp_σ hp_mid hp_V'
    rw [hΘ_step, hpV_eq, hmid_eq]
    rfl

  have hZeroBridge : ∀ (V_et : Y.Etale),
      (Q₁.map (hT_Y.from V_et).op).hom ξ_tilde₀ = 0 →
      ∀ (p_V : weilEtaleTorsionH U ℓ 1 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_U V_et.hom) ℓ 1),
        WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.fst j_U V_et.hom) ℓ 1 p_V →
        p_V ξ₀ = 0 := by
    intro V_et h0 p_V hp_V
    obtain ⟨p_σ, hp_σ⟩ := hPullEx (CategoryTheory.Limits.pullbackSymmetry j_U V_et.hom).hom ℓ 1
    exact (hEval_ξ_tilde₀ V_et p_V p_σ hp_V hp_σ).trans
      ((congrArg (fun z => p_σ (Θ (B_j.obj V_et) z)) h0).trans
        ((congrArg p_σ (map_zero (Θ (B_j.obj V_et)))).trans (map_zero p_σ)))

  
  
  
  
  let fibOf : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (_z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
      CategoryTheory.Functor S.Etale (Type u) :=
    fun S Ω _ _ z =>
      { obj := fun E =>
          { e : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ E.left // e ≫ E.hom = z }
        map := fun {_ _} u =>
          TypeCat.ofHom fun e =>
            ⟨e.1 ≫ u.left,
              ((CategoryTheory.Category.assoc e.1 u.left _).trans
                (congrArg (e.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans e.2⟩
        map_id := fun _ => by
          ext ⟨e, _⟩
          exact CategoryTheory.Category.comp_id e
        map_comp := fun u v => by
          ext ⟨e, _⟩
          exact (CategoryTheory.Category.assoc e u.left v.left).symm }

  let pt : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (_z : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S),
      CategoryTheory.GrothendieckTopology.Point.{u} S.smallEtaleTopology :=
    fun S Ω _ _ z => by
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      letI : Unique ↥S_Ω := PrimeSpectrum.instUnique
      have : IsSepClosed Ω := inferInstance
      let fib_z := fibOf S Ω z
      have hJoint : ∀ {E : S.Etale}, ∀ R ∈ S.smallEtaleTopology E,
          ∀ (e : fib_z.obj E),
            ∃ (Y₀ : S.Etale) (u : Y₀ ⟶ E) (_ : R.arrows u) (e' : fib_z.obj Y₀),
              fib_z.map u e' = e := by
        intro E R hR e
        let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
          @AlgebraicGeometry.Etale
        have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck E := by
          rwa [← AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            (P := P) (Q := P) S (le_refl P)]
        obtain ⟨Y₀, u, y₀, huR, huP, hy₀⟩ :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P) (Q := P) (S := S) E R).mp hR' (e.1 default)
        have : AlgebraicGeometry.Etale u.left := huP
        let Z₀ := CategoryTheory.Limits.pullback u.left e.1
        let p : Z₀ ⟶ Y₀.left := CategoryTheory.Limits.pullback.fst u.left e.1
        let q : Z₀ ⟶ S_Ω := CategoryTheory.Limits.pullback.snd u.left e.1
        have hq_surj : Function.Surjective ⇑q := by
          intro s
          have hs : e.1 s = e.1 default := congrArg (⇑e.1) (Subsingleton.elim s default)
          obtain ⟨z₀, -, hz₀⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₀ s (hy₀.trans hs.symm)
          exact ⟨z₀, hz₀⟩
        have hsing_mem : CategoryTheory.Presieve.singleton q ∈
            (AlgebraicGeometry.Scheme.precoverage P).coverings S_Ω :=
          (AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P q).mpr ⟨hq_surj, inferInstance⟩
        have hcov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q) ∈
            AlgebraicGeometry.Scheme.etaleTopology S_Ω :=
          CategoryTheory.Precoverage.generate_mem_toGrothendieck hsing_mem
        obtain ⟨Z, f_Z, hf_Z, z_Z, hz_Z⟩ :=
          (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective _ hcov (𝟙 S_Ω)
        obtain ⟨Z', g_Z, q', hq'_sing, hfac⟩ := hf_Z
        cases hq'_sing
        change z_Z ≫ f_Z = 𝟙 S_Ω at hz_Z
        let σ : S_Ω ⟶ Z₀ := z_Z ≫ g_Z
        have hσ_q : σ ≫ q = 𝟙 S_Ω := by
          calc
            σ ≫ q = z_Z ≫ (g_Z ≫ q) := CategoryTheory.Category.assoc z_Z g_Z q
            _ = z_Z ≫ f_Z := by rw [hfac]
            _ = 𝟙 S_Ω := hz_Z
        let e'_mor : S_Ω ⟶ Y₀.left := σ ≫ p
        have he'_u : e'_mor ≫ u.left = e.1 := by
          calc
            e'_mor ≫ u.left = σ ≫ (p ≫ u.left) := CategoryTheory.Category.assoc σ p u.left
            _ = σ ≫ (q ≫ e.1) := by rw [CategoryTheory.Limits.pullback.condition]
            _ = (σ ≫ q) ≫ e.1 := (CategoryTheory.Category.assoc σ q e.1).symm
            _ = 𝟙 S_Ω ≫ e.1 := by rw [hσ_q]
            _ = e.1 := CategoryTheory.Category.id_comp e.1
        have he'_z : e'_mor ≫ Y₀.hom = z :=
          ((congrArg (e'_mor ≫ ·) (CategoryTheory.MorphismProperty.Over.w u).symm).trans
            ((CategoryTheory.Category.assoc e'_mor u.left E.hom).symm.trans
              (congrArg (· ≫ E.hom) he'_u))).trans e.2
        exact ⟨Y₀, u, huR, ⟨e'_mor, he'_z⟩, Subtype.ext he'_u⟩
      have hcof_or_empty : CategoryTheory.IsCofilteredOrEmpty fib_z.Elements := by
        refine CategoryTheory.IsCofilteredOrEmpty.mk ?_ ?_
        · intro X Y₀
          have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
          have : AlgebraicGeometry.Etale Y₀.1.hom := Y₀.1.prop
          let fst : CategoryTheory.Limits.pullback X.1.hom Y₀.1.hom ⟶ X.1.left :=
            CategoryTheory.Limits.pullback.fst X.1.hom Y₀.1.hom
          let snd : CategoryTheory.Limits.pullback X.1.hom Y₀.1.hom ⟶ Y₀.1.left :=
            CategoryTheory.Limits.pullback.snd X.1.hom Y₀.1.hom
          let E₁₂ : S.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ X.1.hom) inferInstance
          let l : S_Ω ⟶ E₁₂.left :=
            CategoryTheory.Limits.pullback.lift X.2.1 Y₀.2.1 (X.2.2.trans Y₀.2.2.symm)
          have hl : l ≫ E₁₂.hom = z :=
            ((CategoryTheory.Category.assoc l fst X.1.hom).symm.trans
              (congrArg (· ≫ X.1.hom)
                (CategoryTheory.Limits.pullback.lift_fst X.2.1 Y₀.2.1 _))).trans X.2.2
          let Z : fib_z.Elements := CategoryTheory.Functor.elementsMk fib_z E₁₂ ⟨l, hl⟩
          let pX : E₁₂ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk fst rfl
          let pY : E₁₂ ⟶ Y₀.1 :=
            CategoryTheory.MorphismProperty.Over.homMk snd
              CategoryTheory.Limits.pullback.condition.symm
          have hpX : fib_z.map pX Z.2 = X.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_fst X.2.1 Y₀.2.1 _)
          have hpY : fib_z.map pY Z.2 = Y₀.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_snd X.2.1 Y₀.2.1 _)
          exact ⟨Z, ⟨pX, hpX⟩, ⟨pY, hpY⟩, trivial⟩
        · intro X Y₀ u v
          have : AlgebraicGeometry.Etale X.1.hom := X.1.prop
          have : AlgebraicGeometry.Etale Y₀.1.hom := Y₀.1.prop
          let Δ := CategoryTheory.Limits.pullback.diagonal Y₀.1.hom
          have : AlgebraicGeometry.IsOpenImmersion Δ :=
            AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal Y₀.1.hom
          have huv_w : u.1.left ≫ Y₀.1.hom = v.1.left ≫ Y₀.1.hom :=
            (CategoryTheory.MorphismProperty.Over.w u.1).trans
              (CategoryTheory.MorphismProperty.Over.w v.1).symm
          let uv := CategoryTheory.Limits.pullback.lift u.1.left v.1.left huv_w
          let p₁ := CategoryTheory.Limits.pullback.fst Δ uv
          let j₀ : CategoryTheory.Limits.pullback Δ uv ⟶ X.1.left :=
            CategoryTheory.Limits.pullback.snd Δ uv
          let E₀ : S.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (j₀ ≫ X.1.hom) inferInstance
          have hu_pt : X.2.1 ≫ u.1.left = Y₀.2.1 := congrArg Subtype.val u.2
          have hv_pt : X.2.1 ≫ v.1.left = Y₀.2.1 := congrArg Subtype.val v.2
          let y_pt : S_Ω ⟶ Y₀.1.left := Y₀.2.1
          let x_pt : S_Ω ⟶ X.1.left := X.2.1
          have hpt_eq : y_pt ≫ Δ = x_pt ≫ uv := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · exact ((CategoryTheory.Category.assoc y_pt Δ _).trans
                ((congrArg (y_pt ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y₀.1.hom)).trans
                  (CategoryTheory.Category.comp_id y_pt))).trans
                (((CategoryTheory.Category.assoc x_pt uv _).trans
                  (congrArg (x_pt ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
                  hu_pt).symm
            · exact ((CategoryTheory.Category.assoc y_pt Δ _).trans
                ((congrArg (y_pt ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y₀.1.hom)).trans
                  (CategoryTheory.Category.comp_id y_pt))).trans
                (((CategoryTheory.Category.assoc x_pt uv _).trans
                  (congrArg (x_pt ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))).trans
                  hv_pt).symm
          let l₀ : S_Ω ⟶ E₀.left := CategoryTheory.Limits.pullback.lift y_pt x_pt hpt_eq
          have hl₀ : l₀ ≫ E₀.hom = z :=
            ((CategoryTheory.Category.assoc l₀ j₀ X.1.hom).symm.trans
              (congrArg (· ≫ X.1.hom)
                (CategoryTheory.Limits.pullback.lift_snd y_pt x_pt hpt_eq))).trans X.2.2
          let Z₀ : fib_z.Elements := CategoryTheory.Functor.elementsMk fib_z E₀ ⟨l₀, hl₀⟩
          let h_mor : E₀ ⟶ X.1 := CategoryTheory.MorphismProperty.Over.homMk j₀ rfl
          have hh_pt : fib_z.map h_mor Z₀.2 = X.2 :=
            Subtype.ext (CategoryTheory.Limits.pullback.lift_snd y_pt x_pt hpt_eq)
          let h_el : Z₀ ⟶ X := ⟨h_mor, hh_pt⟩
          refine ⟨Z₀, h_el, ?_⟩
          apply CategoryTheory.Functor.Elements.hom_ext
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          change j₀ ≫ u.1.left = j₀ ≫ v.1.left
          have hcond := CategoryTheory.Limits.pullback.condition (f := Δ) (g := uv)
          have h1 : p₁ = j₀ ≫ u.1.left :=
            ((CategoryTheory.Category.comp_id p₁).symm.trans
              (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_fst Y₀.1.hom).symm)).trans
              (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans
                (congrArg (· ≫ _) hcond)).trans
                ((CategoryTheory.Category.assoc j₀ uv _).trans
                  (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))))
          have h2 : p₁ = j₀ ≫ v.1.left :=
            ((CategoryTheory.Category.comp_id p₁).symm.trans
              (congrArg (p₁ ≫ ·) (CategoryTheory.Limits.pullback.diagonal_snd Y₀.1.hom).symm)).trans
              (((CategoryTheory.Category.assoc p₁ Δ _).symm.trans
                (congrArg (· ≫ _) hcond)).trans
                ((CategoryTheory.Category.assoc j₀ uv _).trans
                  (congrArg (j₀ ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
          exact h1.symm.trans h2
      have hne : Nonempty fib_z.Elements :=
        ⟨CategoryTheory.Functor.elementsMk fib_z
          (AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)) ⟨z, CategoryTheory.Category.comp_id z⟩⟩
      have hcof : CategoryTheory.IsCofiltered fib_z.Elements :=
        @CategoryTheory.IsCofiltered.mk _ _ hcof_or_empty hne
      have hism : CategoryTheory.InitiallySmall.{u} fib_z.Elements := by
        let ι_aff : CategoryTheory.Functor S.AffineEtale S.Etale :=
          AlgebraicGeometry.Scheme.AffineEtale.Spec S
        let M : Type u := CategoryTheory.SmallModel.{u} S.AffineEtale
        let e_M := CategoryTheory.equivSmallModel.{u} S.AffineEtale
        let Idx : Type u := Sigma fun (m : M) => fib_z.obj (ι_aff.obj (e_M.inverse.obj m))
        let φ : Idx → fib_z.Elements := fun p =>
          CategoryTheory.Functor.elementsMk fib_z (ι_aff.obj (e_M.inverse.obj p.1)) p.2
        have : Small.{u} ↑(Set.range φ) := small_range φ
        refine @CategoryTheory.initiallySmall_of_small_weakly_initial_set _ _ hcof_or_empty
          (Set.range φ) _ ?_
        intro X
        have hcov_aff : CategoryTheory.Sieve.coverByImage ι_aff X.1 ∈ S.smallEtaleTopology X.1 :=
          CategoryTheory.Functor.is_cover_of_isCoverDense ι_aff S.smallEtaleTopology X.1
        obtain ⟨Y₀, u, hu_cov, e_Y, he_Y⟩ := hJoint _ hcov_aff X.2
        obtain ⟨A, f₁, f₂, hf₁₂⟩ := hu_cov
        let e_A : fib_z.obj (ι_aff.obj A) := fib_z.map f₁ e_Y
        have he_A : fib_z.map f₂ e_A = X.2 := by
          dsimp [e_A]
          have hmap_comp := congrArg (fun k => k e_Y) (fib_z.map_comp f₁ f₂)
          dsimp at hmap_comp
          rw [← hmap_comp, hf₁₂, he_Y]
        let m : M := e_M.functor.obj A
        let θ : ι_aff.obj (e_M.inverse.obj m) ≅ ι_aff.obj A :=
          ι_aff.mapIso (e_M.unitIso.app A).symm
        let e_m : fib_z.obj (ι_aff.obj (e_M.inverse.obj m)) := fib_z.map θ.inv e_A
        have he_m : fib_z.map (θ.hom ≫ f₂) e_m = X.2 := by
          dsimp [e_m]
          have h1 := congrArg (fun k => k e_A) (fib_z.map_comp θ.inv (θ.hom ≫ f₂))
          dsimp at h1
          rw [← h1, ← CategoryTheory.Category.assoc, θ.inv_hom_id,
            CategoryTheory.Category.id_comp, he_A]
        exact ⟨φ ⟨m, e_m⟩, ⟨⟨m, e_m⟩, rfl⟩, ⟨⟨θ.hom ≫ f₂, he_m⟩⟩⟩
      exact CategoryTheory.GrothendieckTopology.Point.mk fib_z hcof hism hJoint

  have hRefine : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y)
      (E : Y.Etale)
      (x : (pt Y Ω z_bar).fiber.obj E)
      (s₁ s₂ : ↥(Q₁.obj (Opposite.op E))),
      ((pt Y Ω z_bar).toPresheafFiber E x Q₁) s₁ =
        ((pt Y Ω z_bar).toPresheafFiber E x Q₁) s₂ →
      ∃ (V : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine V)
        (g : V ⟶ E.left) (_ : AlgebraicGeometry.Etale g)
        (hv : AlgebraicGeometry.Etale (g ≫ E.hom))
        (z_tilde : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V),
        let V_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (g ≫ E.hom) hv
        let u_V : V_et ⟶ E := CategoryTheory.MorphismProperty.Over.homMk g rfl
        z_tilde ≫ g = x.1 ∧
        (Q₁.map u_V.op).hom s₁ = (Q₁.map u_V.op).hom s₂ := by
    intro Ω _ _ z_bar E x s₁ s₂ hGermEq
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have : Unique ↥S_Ω := PrimeSpectrum.instUnique
    let Φ := pt Y Ω z_bar
    obtain ⟨E', u, y, hy_eq, hsec_eq⟩ :=
      (Φ.toPresheafFiber_eq_iff' E x s₁ s₂).mp hGermEq
    have hy_mor : y.1 ≫ u.left = x.1 := congrArg Subtype.val hy_eq
    have _ : AlgebraicGeometry.Etale E'.hom := E'.prop
    have _ : AlgebraicGeometry.Etale E.hom := E.prop
    have _ : AlgebraicGeometry.Etale u.left := by
      refine CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        u.left E.hom E.prop ?_
      rw [CategoryTheory.MorphismProperty.Over.w u]
      exact E'.prop
    obtain ⟨O, hAffO, hyO, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := y.1.base default) (U := (⊤ : E'.left.Opens)) trivial
    let V : AlgebraicGeometry.Scheme.{u} := O.toScheme
    have hAffV : AlgebraicGeometry.IsAffine V := hAffO
    let g : V ⟶ E.left := O.ι ≫ u.left
    have hEt_g : AlgebraicGeometry.Etale g := by dsimp [g]; infer_instance
    have hv : AlgebraicGeometry.Etale (g ≫ E.hom) := inferInstance
    have hRange_y : Set.range y.1.base ⊆ Set.range O.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨pt_s, rfl⟩
      rw [Subsingleton.elim pt_s default]
      exact hyO
    let z_tilde : S_Ω ⟶ V := AlgebraicGeometry.IsOpenImmersion.lift O.ι y.1 hRange_y
    have hz_fac : z_tilde ≫ O.ι = y.1 :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι y.1 hRange_y
    have hz_g : z_tilde ≫ g = x.1 := by
      dsimp [g]
      rw [← CategoryTheory.Category.assoc, hz_fac, hy_mor]
    let V_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (g ≫ E.hom) hv
    let u_V : V_et ⟶ E := CategoryTheory.MorphismProperty.Over.homMk g rfl
    let j_O : V_et ⟶ E' := CategoryTheory.MorphismProperty.Over.homMk O.ι (by
      change O.ι ≫ E'.hom = (O.ι ≫ u.left) ≫ E.hom
      rw [CategoryTheory.Category.assoc, CategoryTheory.MorphismProperty.Over.w u])
    have hu_V_eq : u_V = j_O ≫ u :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
    refine ⟨V, hAffV, g, hEt_g, hv, z_tilde, hz_g, ?_⟩
    change (Q₁.map u_V.op) s₁ = (Q₁.map u_V.op) s₂
    rw [hu_V_eq, op_comp, Q₁.map_comp]
    exact congrArg (Q₁.map j_O.op) hsec_eq

  
  
  
  
  have hPi_id : ∀ (M : AddCommGrpCat.{u}) (I₁ I₂ : Type u) (f : I₂ → I₁) (g : I₁ → I₂),
      (∀ i : I₁, f (g i) = i) →
      CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (f s)) ≫
        CategoryTheory.Limits.Pi.lift (fun t : I₁ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (g t)) =
        𝟙 (∏ᶜ fun _ : I₁ => M) := by
    intro M I₁ I₂ f g hfg
    apply CategoryTheory.Limits.Pi.hom_ext
    intro t
    simp [hfg t]
  have hPi_map' : ∀ (M : AddCommGrpCat.{u}) (I₁ I₂ J₁ J₂ : Type u)
      (a₁ : J₁ → I₁) (a₂ : J₂ → I₂) (b₁ : I₂ → I₁) (b₂ : J₂ → J₁),
      (∀ s : J₂, a₁ (b₂ s) = b₁ (a₂ s)) →
      CategoryTheory.Limits.Pi.lift (fun s : J₁ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (a₁ s)) ≫
        CategoryTheory.Limits.Pi.map' b₂ (fun _ => 𝟙 M) =
      CategoryTheory.Limits.Pi.map' b₁ (fun _ => 𝟙 M) ≫
        CategoryTheory.Limits.Pi.lift (fun s : J₂ => CategoryTheory.Limits.Pi.π (fun _ : I₂ => M) (a₂ s)) := by
    intro M I₁ I₂ J₁ J₂ a₁ a₂ b₁ b₂ hcomm
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp [hcomm s]
  have hPi_map : ∀ {M M' : AddCommGrpCat.{u}} (φ : M ⟶ M') (I₁ I₂ : Type u) (a : I₂ → I₁),
      CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M) (a s)) ≫
        CategoryTheory.Limits.Pi.map (fun _ : I₂ => φ) =
      CategoryTheory.Limits.Pi.map (fun _ : I₁ => φ) ≫
        CategoryTheory.Limits.Pi.lift (fun s : I₂ => CategoryTheory.Limits.Pi.π (fun _ : I₁ => M') (a s)) := by
    intro M M' φ I₁ I₂ a
    apply CategoryTheory.Limits.Pi.hom_ext
    intro s
    simp

  have hStalkEquiv : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y)
      (H_z : CategoryTheory.Sheaf
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback z_bar R₁ H_z →
      Nonempty (↥((pt Y Ω z_bar).presheafFiber.obj Q₁) ≃+ H_z.H 0) := by
    intro Ω _ _ z_bar H_z hPB
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let Φ₀ := pt S_Ω Ω (𝟙 S_Ω)
    let Φ_Y := pt Y Ω z_bar
    let B := weilEtaleSitePullback z_bar
    let e₁ : ↥(Φ_Y.presheafFiber.obj Q₁) ≃+ ↥(Φ_Y.sheafFiber.obj R₁) :=
      ((Φ_Y.presheafToSheafCompSheafFiberIso AddCommGrpCat.{u}).app Q₁).symm.addCommGroupIsoToAddEquiv
    let α : ∀ (E₂ : Y.Etale), Φ₀.fiber.obj (B.obj E₂) ≃ Φ_Y.fiber.obj E₂ := fun E₂ =>
      let fst_E₂ : CategoryTheory.Limits.pullback E₂.hom z_bar ⟶ E₂.left :=
        CategoryTheory.Limits.pullback.fst E₂.hom z_bar
      let snd_E₂ : CategoryTheory.Limits.pullback E₂.hom z_bar ⟶ S_Ω :=
        CategoryTheory.Limits.pullback.snd E₂.hom z_bar
      { toFun := fun t =>
          let t_mor : S_Ω ⟶ CategoryTheory.Limits.pullback E₂.hom z_bar := t.1
          let ht_mor : t_mor ≫ snd_E₂ = 𝟙 S_Ω := t.2
          ⟨t_mor ≫ fst_E₂,
            ((CategoryTheory.Category.assoc t_mor fst_E₂ E₂.hom).trans
              (congrArg (t_mor ≫ ·)
                (CategoryTheory.Limits.pullback.condition (f := E₂.hom) (g := z_bar)))).trans
              (((CategoryTheory.Category.assoc t_mor snd_E₂ z_bar).symm.trans
                (congrArg (· ≫ z_bar) ht_mor)).trans
                (CategoryTheory.Category.id_comp z_bar))⟩
        invFun := fun s =>
          ⟨CategoryTheory.Limits.pullback.lift s.1 (𝟙 S_Ω)
            (s.2.trans (CategoryTheory.Category.id_comp z_bar).symm),
           CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
        left_inv := fun t => by
          apply Subtype.ext
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
          · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans t.2.symm
        right_inv := fun s => by
          apply Subtype.ext
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _ }
    have hα_symm : ∀ {E₂ E₂' : Y.Etale} (u : E₂ ⟶ E₂') (s : Φ_Y.fiber.obj E₂),
        Φ₀.fiber.map (B.map u) ((α E₂).symm s) = (α E₂').symm (Φ_Y.fiber.map u s) := by
      intro E₂ E₂' u s
      apply Subtype.ext
      let fst₁ : CategoryTheory.Limits.pullback E₂.hom z_bar ⟶ E₂.left :=
        CategoryTheory.Limits.pullback.fst E₂.hom z_bar
      let snd₁ : CategoryTheory.Limits.pullback E₂.hom z_bar ⟶ S_Ω :=
        CategoryTheory.Limits.pullback.snd E₂.hom z_bar
      let fst₂ : CategoryTheory.Limits.pullback E₂'.hom z_bar ⟶ E₂'.left :=
        CategoryTheory.Limits.pullback.fst E₂'.hom z_bar
      let snd₂ : CategoryTheory.Limits.pullback E₂'.hom z_bar ⟶ S_Ω :=
        CategoryTheory.Limits.pullback.snd E₂'.hom z_bar
      let l₁ : S_Ω ⟶ CategoryTheory.Limits.pullback E₂.hom z_bar :=
        CategoryTheory.Limits.pullback.lift s.1 (𝟙 S_Ω)
          (s.2.trans (CategoryTheory.Category.id_comp z_bar).symm)
      let l₂ : S_Ω ⟶ CategoryTheory.Limits.pullback E₂'.hom z_bar :=
        CategoryTheory.Limits.pullback.lift (s.1 ≫ u.left) (𝟙 S_Ω)
          (((CategoryTheory.Category.assoc s.1 u.left E₂'.hom).trans
            (congrArg (s.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans
            (s.2.trans (CategoryTheory.Category.id_comp z_bar).symm))
      let b_map : CategoryTheory.Limits.pullback E₂.hom z_bar ⟶
          CategoryTheory.Limits.pullback E₂'.hom z_bar :=
        (B.map u).left
      have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) z_bar :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
          (@AlgebraicGeometry.Etale) z_bar :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      have hB_map : b_map = CategoryTheory.Limits.pullback.lift
          (fst₁ ≫ u.left) snd₁
          (((CategoryTheory.Category.assoc fst₁ u.left E₂'.hom).trans
            (congrArg (fst₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u))).trans
            (CategoryTheory.Limits.pullback.condition (f := E₂.hom) (g := z_bar))) :=
        CategoryTheory.MorphismProperty.Over.pullback_map_left (@AlgebraicGeometry.Etale) ⊤ z_bar u
      change l₁ ≫ b_map = l₂
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact ((CategoryTheory.Category.assoc l₁ b_map fst₂).trans
          (congrArg (l₁ ≫ ·)
            ((congrArg (· ≫ fst₂) hB_map).trans
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)))).trans
          (((CategoryTheory.Category.assoc l₁ fst₁ u.left).symm.trans
            (congrArg (· ≫ u.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)
      · exact ((CategoryTheory.Category.assoc l₁ b_map snd₂).trans
          (congrArg (l₁ ≫ ·)
            ((congrArg (· ≫ snd₂) hB_map).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)))).trans
          ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    obtain ⟨hc, hr, ⟨e_pb⟩⟩ := hPB
    let pf := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B AddCommGrpCat.{u} _
      Y.smallEtaleTopology S_Ω.smallEtaleTopology hc
    let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _ B AddCommGrpCat.{u} _
      Y.smallEtaleTopology S_Ω.smallEtaleTopology hc hr
    let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B AddCommGrpCat.{u} _
      Y.smallEtaleTopology S_Ω.smallEtaleTopology hc hr
    let e_sky : (Φ₀.skyscraperSheafFunctor (A := AddCommGrpCat.{u})) ⋙ pf ≅
        (Φ_Y.skyscraperSheafFunctor (A := AddCommGrpCat.{u})) := by
      refine CategoryTheory.NatIso.ofComponents (fun M => ?_) (fun {M M'} φ => ?_)
      · refine
          { hom :=
              { hom :=
                  { app := fun j =>
                      CategoryTheory.Limits.Pi.lift fun (s : Φ_Y.fiber.obj j.unop) =>
                        CategoryTheory.Limits.Pi.π
                          (fun _ : Φ₀.fiber.obj (B.obj j.unop) => M) ((α j.unop).symm s)
                    naturality := fun {j₁ j₂} f => by
                      change (Φ₀.skyscraperPresheafFunctor.obj M).map (B.op.map f) ≫ _ =
                        _ ≫ (Φ_Y.skyscraperPresheafFunctor.obj M).map f
                      rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                        CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                      exact (hPi_map' M
                        (Φ₀.fiber.obj (B.obj j₁.unop)) (Φ₀.fiber.obj (B.obj j₂.unop))
                        (Φ_Y.fiber.obj j₁.unop) (Φ_Y.fiber.obj j₂.unop)
                        (α j₁.unop).symm (α j₂.unop).symm
                        (Φ₀.fiber.map (B.map f.unop)) (Φ_Y.fiber.map f.unop)
                        (fun s => (hα_symm f.unop s).symm)).symm } }
            inv :=
              { hom :=
                  { app := fun j =>
                      CategoryTheory.Limits.Pi.lift fun (t : Φ₀.fiber.obj (B.obj j.unop)) =>
                        CategoryTheory.Limits.Pi.π
                          (fun _ : Φ_Y.fiber.obj j.unop => M) (α j.unop t)
                    naturality := fun {j₁ j₂} f => by
                      change (Φ_Y.skyscraperPresheafFunctor.obj M).map f ≫ _ =
                        _ ≫ (Φ₀.skyscraperPresheafFunctor.obj M).map (B.op.map f)
                      rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map,
                        CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map]
                      refine (hPi_map' M
                        (Φ_Y.fiber.obj j₁.unop) (Φ_Y.fiber.obj j₂.unop)
                        (Φ₀.fiber.obj (B.obj j₁.unop)) (Φ₀.fiber.obj (B.obj j₂.unop))
                        (α j₁.unop) (α j₂.unop)
                        (Φ_Y.fiber.map f.unop) (Φ₀.fiber.map (B.map f.unop))
                        (fun t => ?_)).symm
                      apply (α j₁.unop).symm.injective
                      rw [(α j₁.unop).symm_apply_apply]
                      exact (congrArg (Φ₀.fiber.map (B.map f.unop))
                        ((α j₂.unop).symm_apply_apply t)).symm.trans
                        (hα_symm f.unop (α j₂.unop t)) } }
            hom_inv_id := by
              apply CategoryTheory.Sheaf.hom_ext
              ext j : 2
              exact hPi_id M (Φ₀.fiber.obj (B.obj j.unop)) (Φ_Y.fiber.obj j.unop)
                (α j.unop).symm (α j.unop) (α j.unop).symm_apply_apply
            inv_hom_id := by
              apply CategoryTheory.Sheaf.hom_ext
              ext j : 2
              exact hPi_id M (Φ_Y.fiber.obj j.unop) (Φ₀.fiber.obj (B.obj j.unop))
                (α j.unop) (α j.unop).symm (α j.unop).apply_symm_apply }
      · apply CategoryTheory.Sheaf.hom_ext
        ext j : 2
        change ((Φ₀.skyscraperPresheafFunctor.map φ).app (B.op.obj j)) ≫ _ =
          _ ≫ ((Φ_Y.skyscraperPresheafFunctor.map φ).app j)
        rw [CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app,
          CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app]
        exact (hPi_map φ (Φ₀.fiber.obj (B.obj j.unop)) (Φ_Y.fiber.obj j.unop)
          (α j.unop).symm).symm
    let adj_comp :=
      (adj.comp (Φ₀.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))).ofNatIsoRight e_sky
    let e_stalk : pb ⋙ (Φ₀.sheafFiber (A := AddCommGrpCat.{u})) ≅
        (Φ_Y.sheafFiber (A := AddCommGrpCat.{u})) :=
      adj_comp.leftAdjointUniq (Φ_Y.skyscraperSheafAdjunction (A := AddCommGrpCat.{u}))
    let iso_sheaf : Φ_Y.sheafFiber.obj R₁ ≅ Φ₀.sheafFiber.obj H_z :=
      (e_stalk.app R₁).symm ≪≫ (Φ₀.sheafFiber (A := AddCommGrpCat.{u})).mapIso e_pb
    let e₂ : ↥(Φ_Y.sheafFiber.obj R₁) ≃+ ↥(Φ₀.sheafFiber.obj H_z) :=
      iso_sheaf.addCommGroupIsoToAddEquiv
    let T_Ω : S_Ω.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S_Ω)
    let hT_Ω : CategoryTheory.Limits.IsTerminal T_Ω := termEtale S_Ω
    let pt₀ : Φ₀.fiber.obj T_Ω := ⟨𝟙 S_Ω, CategoryTheory.Category.comp_id (𝟙 S_Ω)⟩
    let ι₀ : ↥(H_z.obj.obj (Opposite.op T_Ω)) →+ ↥(Φ₀.sheafFiber.obj H_z) :=
      (Φ₀.toPresheafFiber T_Ω pt₀ H_z.obj).hom
    have hBij_ι₀ : Function.Bijective ι₀ := by
      constructor
      · intro s₁ s₂ hs
        have hs' : (Φ₀.toPresheafFiber T_Ω pt₀ H_z.obj) s₁ =
            (Φ₀.toPresheafFiber T_Ω pt₀ H_z.obj) s₂ := hs
        obtain ⟨E', u, pt', _, hsec⟩ :=
          (Φ₀.toPresheafFiber_eq_iff' T_Ω pt₀ s₁ s₂).mp hs'
        let m' : T_Ω ⟶ E' := CategoryTheory.MorphismProperty.Over.homMk pt'.1 pt'.2
        have hmu : m' ≫ u = 𝟙 T_Ω := hT_Ω.hom_ext (m' ≫ u) (𝟙 T_Ω)
        have happ := congrArg (H_z.obj.map m'.op) hsec
        have hcomp_s : ∀ s : ↥(H_z.obj.obj (Opposite.op T_Ω)),
            (H_z.obj.map m'.op) ((H_z.obj.map u.op) s) = s := by
          intro s
          change ((H_z.obj.map u.op ≫ H_z.obj.map m'.op)) s = s
          rw [← H_z.obj.map_comp, ← op_comp, hmu, op_id, H_z.obj.map_id]
          rfl
        rwa [hcomp_s s₁, hcomp_s s₂] at happ
      · intro p
        obtain ⟨E₀, pt_E, s, hs⟩ := Φ₀.toPresheafFiber_jointly_surjective p
        let m : T_Ω ⟶ E₀ := CategoryTheory.MorphismProperty.Over.homMk pt_E.1 pt_E.2
        have hm_pt : Φ₀.fiber.map m pt₀ = pt_E :=
          Subtype.ext (CategoryTheory.Category.id_comp pt_E.1)
        have hw := congrArg (fun φ : H_z.obj.obj (Opposite.op E₀) ⟶ Φ₀.presheafFiber.obj H_z.obj =>
            φ s) (Φ₀.toPresheafFiber_w m pt₀ H_z.obj)
        refine ⟨(H_z.obj.map m.op) s, ?_⟩
        change (H_z.obj.map m.op ≫ Φ₀.toPresheafFiber T_Ω pt₀ H_z.obj) s = p
        rw [hw, hm_pt]
        exact hs
    let e₃ : ↥(Φ₀.sheafFiber.obj H_z) ≃+ H_z.H 0 :=
      (AddEquiv.ofBijective ι₀ hBij_ι₀).symm.trans
        (CategoryTheory.Sheaf.H.equiv₀ H_z hT_Ω).symm
    exact ⟨e₁.trans (e₂.trans e₃)⟩

  
  
  
  
  intro W _ w _ ξ
  let W_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w inferInstance
  let σ_w_inv : (B_j.obj W_et).left ⟶ CategoryTheory.Limits.pullback j_U w :=
    (CategoryTheory.Limits.pullbackSymmetry w j_U).hom
  obtain ⟨p_σw_inv, hp_σw_inv⟩ := hPullEx σ_w_inv ℓ 1
  let ξ_tilde : ↥(Q₁.obj (Opposite.op W_et)) := (Θ (B_j.obj W_et)).symm (p_σw_inv ξ)
  let ξ₀_W : ↥(Q₁.obj (Opposite.op W_et)) := (Q₁.map (hT_Y.from W_et).op).hom ξ_tilde₀
  have hTors_ξ₀W : ℓ • ξ₀_W = 0 := by
    dsimp [ξ₀_W]
    rw [← map_nsmul, hTors_ξ_tilde₀, map_zero]

  have hPointwise : ∀ (x : ↥W),
      ∃ (V' : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine V')
        (g : V' ⟶ W) (_ : AlgebraicGeometry.Etale g)
        (hgw : AlgebraicGeometry.Etale (g ≫ w)) (c : ℕ),
        x ∈ Set.range g.base ∧
        (let V'_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (g ≫ w) hgw
         let u_g : V'_et ⟶ W_et := CategoryTheory.MorphismProperty.Over.homMk g rfl
         (Q₁.map u_g.op).hom ξ_tilde = c • (Q₁.map (hT_Y.from V'_et).op).hom ξ_tilde₀) := by
    intro x
    let Ω_x : Type u := AlgebraicClosure ↥(W.residueField x)
    let S_Ωx := AlgebraicGeometry.Spec (CommRingCat.of Ω_x)
    have : Unique ↥S_Ωx := PrimeSpectrum.instUnique
    let pt_def : ↥S_Ωx := default
    let z_tilde : S_Ωx ⟶ W :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(W.residueField x) Ω_x)) ≫
        W.fromSpecResidueField x
    let z_bar : S_Ωx ⟶ Y := z_tilde ≫ w
    have hz_tilde_pt : z_tilde.base pt_def = x := by
      have hmem : z_tilde.base pt_def ∈ Set.range (W.fromSpecResidueField x).base :=
        ⟨_, rfl⟩
      rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField x, Set.mem_singleton_iff] at hmem
    let Φ_x := pt Y Ω_x z_bar
    let M_x := ↥(Φ_x.presheafFiber.obj Q₁)
    let pt_W : Φ_x.fiber.obj W_et := ⟨z_tilde, rfl⟩
    let pt_TY : Φ_x.fiber.obj T_Y := ⟨z_bar, CategoryTheory.Category.comp_id z_bar⟩
    have hmap_pt : Φ_x.fiber.map (hT_Y.from W_et) pt_W = pt_TY := by
      apply Subtype.ext
      have hw_from : (hT_Y.from W_et).left = w :=
        (CategoryTheory.Category.comp_id (hT_Y.from W_et).left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w (hT_Y.from W_et))
      exact congrArg (z_tilde ≫ ·) hw_from
    let m_0 : M_x := (Φ_x.toPresheafFiber W_et pt_W Q₁) ξ₀_W
    let m_ξ : M_x := (Φ_x.toPresheafFiber W_et pt_W Q₁) ξ_tilde
    have hm0_eq_TY : m_0 = (Φ_x.toPresheafFiber T_Y pt_TY Q₁) ξ_tilde₀ := by
      have hw := congrArg (fun φ : Q₁.obj (Opposite.op T_Y) ⟶ Φ_x.presheafFiber.obj Q₁ => φ ξ_tilde₀)
        (Φ_x.toPresheafFiber_w (hT_Y.from W_et) pt_W Q₁)
      exact hw.trans (by rw [hmap_pt])
    have hTors_m0 : ℓ • m_0 = 0 :=
      ((map_nsmul (Φ_x.toPresheafFiber W_et pt_W Q₁).hom ℓ ξ₀_W).symm.trans
        (congrArg (Φ_x.toPresheafFiber W_et pt_W Q₁).hom hTors_ξ₀W)).trans
        (map_zero (Φ_x.toPresheafFiber W_et pt_W Q₁).hom)
    have hex_c : ∃ c_x : ℕ, m_ξ = c_x • m_0 := by
      by_cases hz_in : z_bar.base pt_def ∈ Set.range j_U.base
      · obtain ⟨H_z, hPB_z, hZero_Hz⟩ := hOpenZero Ω_x z_bar (fun pt_s => by
          rw [Subsingleton.elim pt_s pt_def]
          exact hz_in)
        obtain ⟨e_stalk⟩ := hStalkEquiv Ω_x z_bar H_z hPB_z
        have hSub_Hz : Subsingleton (H_z.H 0) :=
          ⟨fun α β => by
            have hid0 : CategoryTheory.CategoryStruct.id H_z = 0 := hZero_Hz.eq_of_tgt _ 0
            have hα : α = 0 := by
              rw [← CategoryTheory.Abelian.Ext.comp_mk₀_id α, hid0,
                CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
            have hβ : β = 0 := by
              rw [← CategoryTheory.Abelian.Ext.comp_mk₀_id β, hid0,
                CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
            exact hα.trans hβ.symm⟩
        have hSub_Mx : Subsingleton M_x := e_stalk.toEquiv.subsingleton
        exact ⟨0, hSub_Mx.elim _ _⟩
      · have hz_out_all : ∀ pt_s : ↥S_Ωx, z_bar.base pt_s ∉ Set.range j_U.base := by
          intro pt_s
          rw [Subsingleton.elim pt_s pt_def]
          exact hz_in
        obtain ⟨H_z, hPB_z⟩ := hExPB z_bar R₁
        obtain ⟨hFin_Hz, hCard_Hz⟩ := hBdryCard Ω_x z_bar hz_out_all H_z hPB_z
        obtain ⟨e_stalk⟩ := hStalkEquiv Ω_x z_bar H_z hPB_z
        have _ : Finite (H_z.H 0) := hFin_Hz
        have _ : Finite M_x := Finite.of_equiv _ e_stalk.symm.toEquiv
        have hCard_Mx : Nat.card M_x ≤ ℓ :=
          (Nat.card_congr e_stalk.toEquiv).trans_le hCard_Hz
        have hm0_ne : m_0 ≠ 0 := by
          intro hm0_zero
          have hGerm0 : (Φ_x.toPresheafFiber T_Y pt_TY Q₁) ξ_tilde₀ =
              (Φ_x.toPresheafFiber T_Y pt_TY Q₁) 0 := by
            rw [← hm0_eq_TY, hm0_zero, map_zero]
          obtain ⟨V₀, hAffV₀, g₀, hEt_g₀, hv₀, z_tilde₀, hz₀_g, hQ₀_eq⟩ :=
            hRefine Ω_x z_bar T_Y pt_TY ξ_tilde₀ 0 hGerm0
          have _ : AlgebraicGeometry.IsAffine V₀ := hAffV₀
          let V₀_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (g₀ ≫ T_Y.hom) hv₀
          let u_V₀ : V₀_et ⟶ T_Y := CategoryTheory.MorphismProperty.Over.homMk g₀ rfl
          have hu_from : u_V₀ = hT_Y.from V₀_et := hT_Y.hom_ext u_V₀ (hT_Y.from V₀_et)
          have hQ₀_zero : (Q₁.map (hT_Y.from V₀_et).op).hom ξ_tilde₀ = 0 := by
            rw [← hu_from, hQ₀_eq, map_zero]
          obtain ⟨p_V₀, hp_V₀⟩ :=
            hPullEx (CategoryTheory.Limits.pullback.fst j_U V₀_et.hom) ℓ 1
          have hp_zero : p_V₀ ξ₀ = 0 := hZeroBridge V₀_et hQ₀_zero p_V₀ hp_V₀
          have hz₀_hom : z_tilde₀ ≫ V₀_et.hom = z_bar :=
            (congrArg (z_tilde₀ ≫ ·) (CategoryTheory.Category.comp_id g₀)).trans hz₀_g
          exact @hBdryNeZero Ω_x _ _ z_bar hz_out_all V₀ hAffV₀ V₀_et.hom hv₀
            z_tilde₀ hz₀_hom p_V₀ hp_V₀ hp_zero
        have hPrime : Nat.Prime ℓ := Fact.out
        have : NeZero ℓ := ⟨hPrime.ne_zero⟩
        have hMod_smul : ∀ n : ℕ, n • m_0 = (n % ℓ) • m_0 := by
          intro n
          conv_lhs => rw [← Nat.div_add_mod n ℓ, add_nsmul, mul_nsmul,
            hTors_m0, smul_zero, zero_add]
        let φ : ZMod ℓ → M_x := fun a => a.val • m_0
        have hφ_nat : ∀ n : ℕ, φ (n : ZMod ℓ) = n • m_0 := by
          intro n
          dsimp [φ]
          rw [ZMod.val_natCast, ← hMod_smul]
        have hφ_add : ∀ a b : ZMod ℓ, φ (a + b) = φ a + φ b := by
          intro a b
          have hab : a + b = ((a.val + b.val : ℕ) : ZMod ℓ) := by
            rw [Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
          rw [hab, hφ_nat, add_nsmul]
        have hφ_mul : ∀ a b : ZMod ℓ, φ (a * b) = a.val • φ b := by
          intro a b
          have hab : a * b = ((a.val * b.val : ℕ) : ZMod ℓ) := by
            rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
          rw [hab, hφ_nat, mul_comm a.val b.val, mul_nsmul]
        have hInj_φ : Function.Injective φ := by
          intro a₁ a₂ h_eq
          by_contra hne
          have hd_ne : a₁ - a₂ ≠ 0 := sub_ne_zero.mpr hne
          have hφ_d : φ (a₁ - a₂) = 0 := by
            have hsum := hφ_add (a₁ - a₂) a₂
            rw [sub_add_cancel, h_eq] at hsum
            exact add_right_cancel (hsum.symm.trans (zero_add (φ a₂)).symm)
          have hφ_1 : φ 1 = m_0 := by
            dsimp [φ]
            rw [ZMod.val_one, one_nsmul]
          have hm0_z : m_0 = 0 := by
            calc
              m_0 = φ 1 := hφ_1.symm
              _ = φ ((a₁ - a₂)⁻¹ * (a₁ - a₂)) := by rw [inv_mul_cancel₀ hd_ne]
              _ = ((a₁ - a₂)⁻¹).val • φ (a₁ - a₂) := hφ_mul _ _
              _ = 0 := by rw [hφ_d, smul_zero]
          exact hm0_ne hm0_z
        have hCard_le : Nat.card M_x ≤ Nat.card (ZMod ℓ) := by
          rwa [Nat.card_zmod]
        have hSurj_φ : Function.Surjective φ :=
          (hInj_φ.bijective_of_nat_card_le hCard_le).2
        obtain ⟨c₀, hc₀⟩ := hSurj_φ m_ξ
        exact ⟨c₀.val, hc₀.symm⟩
    obtain ⟨c_x, hc_x⟩ := hex_c
    have hGerm_W : (Φ_x.toPresheafFiber W_et pt_W Q₁) ξ_tilde =
        (Φ_x.toPresheafFiber W_et pt_W Q₁) (c_x • ξ₀_W) := by
      change m_ξ = (Φ_x.toPresheafFiber W_et pt_W Q₁).hom (c_x • ξ₀_W)
      rw [map_nsmul]
      exact hc_x
    obtain ⟨V', hAffV', g, hEt_g, hgw, z_tilde', hz'_g, hQ_eq⟩ :=
      hRefine Ω_x z_bar W_et pt_W ξ_tilde (c_x • ξ₀_W) hGerm_W
    refine ⟨V', hAffV', g, hEt_g, hgw, c_x, ?_, ?_⟩
    · refine ⟨z_tilde'.base pt_def, ?_⟩
      change (z_tilde' ≫ g).base pt_def = x
      rw [hz'_g]
      exact hz_tilde_pt
    · intro V'_et u_g
      have hu_comp : u_g ≫ hT_Y.from W_et = hT_Y.from V'_et :=
        hT_Y.hom_ext _ _
      have h1 : (Q₁.map u_g.op).hom ξ_tilde =
          (Q₁.map u_g.op).hom (c_x • ξ₀_W) := hQ_eq
      have h2 : (Q₁.map u_g.op).hom (c_x • ξ₀_W) =
          c_x • (Q₁.map u_g.op).hom ξ₀_W :=
        map_nsmul (Q₁.map u_g.op).hom c_x ξ₀_W
      have h3 : (Q₁.map u_g.op).hom ξ₀_W =
          (Q₁.map (hT_Y.from V'_et).op).hom ξ_tilde₀ := by
        change (Q₁.map (hT_Y.from W_et).op ≫ Q₁.map u_g.op) ξ_tilde₀ =
          (Q₁.map (hT_Y.from V'_et).op) ξ_tilde₀
        rw [← Q₁.map_comp, ← op_comp, hu_comp]
      exact h1.trans (h2.trans (congrArg (c_x • ·) h3))

  choose V' hAffV' g hEt_g hgw c hMem hEqQ using hPointwise
  have _ : ∀ a : ↥W, AlgebraicGeometry.IsAffine (V' a) := hAffV'
  have _ : ∀ a : ↥W, AlgebraicGeometry.Etale (g a) := hEt_g
  refine ⟨↥W, V', hAffV', g, hEt_g, c, ?_, ?_⟩
  · exact Set.eq_univ_of_forall fun x => Set.mem_iUnion.mpr ⟨x, hMem x⟩
  · intro a h_a hh_fst hh_snd q_a r_a hq_a hr_a
    let V'_et : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (g a ≫ w) (hgw a)
    let u_g : V'_et ⟶ W_et := CategoryTheory.MorphismProperty.Over.homMk (g a) rfl
    let σ_w' : CategoryTheory.Limits.pullback j_U (g a ≫ w) ⟶ (B_j.obj V'_et).left :=
      (CategoryTheory.Limits.pullbackSymmetry j_U (g a ≫ w)).hom
    obtain ⟨p_σw', hp_σw'⟩ := hPullEx σ_w' ℓ 1
    let b_ug : (B_j.obj V'_et).left ⟶ (B_j.obj W_et).left := (B_j.map u_g).left
    obtain ⟨p_Bug, hp_Bug⟩ := hPullEx b_ug ℓ 1
    obtain ⟨p_mid2, hp_mid2⟩ := hPullEx (b_ug ≫ σ_w_inv) ℓ 1
    have hRHS_eval : p_σw' (Θ (B_j.obj V'_et) ((Q₁.map (hT_Y.from V'_et).op).hom ξ_tilde₀)) = r_a ξ₀ :=
      (hEval_ξ_tilde₀ V'_et r_a p_σw' hr_a hp_σw').symm
    have hLHS_Θ : Θ (B_j.obj V'_et) ((Q₁.map u_g.op).hom ξ_tilde) = p_Bug (p_σw_inv ξ) := by
      have h1 := hΘ_nat (B_j.map u_g) p_Bug hp_Bug ξ_tilde
      exact h1.trans (congrArg p_Bug ((Θ (B_j.obj W_et)).apply_symm_apply (p_σw_inv ξ)))
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) j_U :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) j_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have hb_ug_eq : b_ug = CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst (g a ≫ w) j_U ≫ u_g.left)
        (CategoryTheory.Limits.pullback.snd (g a ≫ w) j_U)
        (((CategoryTheory.Category.assoc _ u_g.left w).trans
          (congrArg (_ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u_g))).trans
          (CategoryTheory.Limits.pullback.condition (f := g a ≫ w) (g := j_U))) :=
      CategoryTheory.MorphismProperty.Over.pullback_map_left (@AlgebraicGeometry.Etale) ⊤ j_U u_g
    have h_a_eq : σ_w' ≫ (b_ug ≫ σ_w_inv) = h_a := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have h1 : σ_w_inv ≫ CategoryTheory.Limits.pullback.fst j_U w =
            CategoryTheory.Limits.pullback.snd w j_U :=
          CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst w j_U
        have h2 : b_ug ≫ CategoryTheory.Limits.pullback.snd w j_U =
            CategoryTheory.Limits.pullback.snd (g a ≫ w) j_U :=
          CategoryTheory.MorphismProperty.Over.w (B_j.map u_g)
        have h3 : σ_w' ≫ CategoryTheory.Limits.pullback.snd (g a ≫ w) j_U =
            CategoryTheory.Limits.pullback.fst j_U (g a ≫ w) :=
          CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd j_U (g a ≫ w)
        exact ((CategoryTheory.Category.assoc σ_w' (b_ug ≫ σ_w_inv) _).trans
          (congrArg (σ_w' ≫ ·)
            ((CategoryTheory.Category.assoc b_ug σ_w_inv _).trans
              ((congrArg (b_ug ≫ ·) h1).trans h2)))).trans (h3.trans hh_fst.symm)
      · have h1 : σ_w_inv ≫ CategoryTheory.Limits.pullback.snd j_U w =
            CategoryTheory.Limits.pullback.fst w j_U :=
          CategoryTheory.Limits.pullbackSymmetry_hom_comp_snd w j_U
        have h2 : b_ug ≫ CategoryTheory.Limits.pullback.fst w j_U =
            CategoryTheory.Limits.pullback.fst (g a ≫ w) j_U ≫ g a :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.fst w j_U) hb_ug_eq).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have h3 : σ_w' ≫ (CategoryTheory.Limits.pullback.fst (g a ≫ w) j_U ≫ g a) =
            CategoryTheory.Limits.pullback.snd j_U (g a ≫ w) ≫ g a :=
          (CategoryTheory.Category.assoc σ_w' _ (g a)).symm.trans
            (congrArg (· ≫ g a)
              (CategoryTheory.Limits.pullbackSymmetry_hom_comp_fst j_U (g a ≫ w)))
        exact ((CategoryTheory.Category.assoc σ_w' (b_ug ≫ σ_w_inv) _).trans
          (congrArg (σ_w' ≫ ·)
            ((CategoryTheory.Category.assoc b_ug σ_w_inv _).trans
              ((congrArg (b_ug ≫ ·) h1).trans h2)))).trans (h3.trans hh_snd.symm)
    have hq_a' : WeilIsTorsionEtalePullback (σ_w' ≫ (b_ug ≫ σ_w_inv)) ℓ 1 q_a :=
      h_a_eq.symm ▸ hq_a
    have hmid2_eq : p_mid2 = p_Bug.comp p_σw_inv :=
      hPullComp b_ug σ_w_inv ℓ 1 p_Bug p_σw_inv p_mid2 hp_Bug hp_σw_inv hp_mid2
    have hqa_eq : q_a = p_σw'.comp p_mid2 :=
      hPullComp σ_w' (b_ug ≫ σ_w_inv) ℓ 1 p_σw' p_mid2 q_a hp_σw' hp_mid2 hq_a'
    have hQ_a : (Q₁.map u_g.op).hom ξ_tilde =
        (c a) • (Q₁.map (hT_Y.from V'_et).op).hom ξ_tilde₀ := hEqQ a
    exact (congrArg (fun f : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_U w) ℓ 1 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_U (g a ≫ w)) ℓ 1 => f ξ)
        (hqa_eq.trans (congrArg (p_σw'.comp ·) hmid2_eq))).trans
      ((congrArg p_σw' hLHS_Θ.symm).trans
        ((congrArg (fun z => p_σw' (Θ (B_j.obj V'_et) z)) hQ_a).trans
          ((congrArg p_σw' (map_nsmul (Θ (B_j.obj V'_et)) (c a) _)).trans
            ((map_nsmul p_σw' (c a) _).trans
              (congrArg ((c a) • ·) hRHS_eval)))))

theorem weil_smooth_pencil_locConst_codim1_purity_and_kummer_zero (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hA1Vanish : ∀ (δ m : ℕ), 1 ≤ m →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (weilAffineSpaceOver k δ).hom
            (weilAffineSpaceOver k 1).hom)
          m
          (weilEtaleTorsionSheaf
            (CategoryTheory.Limits.pullback (weilAffineSpaceOver k δ).hom
              (weilAffineSpaceOver k 1).hom) ℓ)))
    (δ : ℕ) :
    let S_δ := weilAffineSpaceOver k δ
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let κ_A1 : A1_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_δ := CategoryTheory.Limits.pullback S_δ.hom p_A1
    let U_δ := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
    let j_δ : U_δ ⟶ Y_δ :=
      CategoryTheory.Limits.pullback.snd j_Gm
        (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
    (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y_δ) [AlgebraicGeometry.Etale w],
      ConnectedSpace ↥W → Nonempty ↥W →
      ConnectedSpace ↥(CategoryTheory.Limits.pullback j_δ w) ∧
      Nonempty ↥(CategoryTheory.Limits.pullback j_δ w)) ∧
    (∀ (b : ℕ), 2 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ))) ∧
    (∀ (W W₁ : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine W] [AlgebraicGeometry.IsAffine W₁]
        (w : W ⟶ Y_δ) (w₁ : W₁ ⟶ Y_δ)
        [AlgebraicGeometry.Etale w] [AlgebraicGeometry.Etale w₁]
        (π_W : W₁ ⟶ W)
        (π_WU : CategoryTheory.Limits.pullback j_δ w₁ ⟶ CategoryTheory.Limits.pullback j_δ w),
      π_W ≫ w ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 =
        w₁ ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 →
      π_W ≫ w ≫ CategoryTheory.Limits.pullback.snd S_δ.hom p_A1 =
        w₁ ≫ CategoryTheory.Limits.pullback.snd S_δ.hom p_A1 ≫ κ_A1 →
      π_WU ≫ CategoryTheory.Limits.pullback.snd j_δ w =
        CategoryTheory.Limits.pullback.snd j_δ w₁ ≫ π_W →
      ∀ (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w) ℓ 1)
        (p_WU : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w) ℓ 1 →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w₁) ℓ 1),
        WeilIsTorsionEtalePullback π_WU ℓ 1 p_WU →
        ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
          (_ : ∀ a, AlgebraicGeometry.IsAffine (V a))
          (v : ∀ a, V a ⟶ W₁) (_ : ∀ a, AlgebraicGeometry.Etale (v a)),
          (⋃ a, Set.range (v a).base) = Set.univ ∧
          ∀ (a : I)
            (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w₁) ℓ 1 →+
              weilEtaleTorsionH
                (CategoryTheory.Limits.pullback
                  (CategoryTheory.Limits.pullback.snd j_δ w₁) (v a)) ℓ 1),
            WeilIsTorsionEtalePullback
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.Limits.pullback.snd j_δ w₁) (v a)) ℓ 1 p_a →
            p_a (p_WU ξ) = 0) :=
by
  classical
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.LocallyOfFiniteType :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  intro S_δ A1_k Gm_k j_Gm κ_A1 p_A1 Y_δ U_δ j_δ

  
  have hSmoothIrred := weil_algClosed_smooth_etale_local_domain_and_connected_integral k
  obtain ⟨hExPB, _, hCompPB, hConstPB, _, _⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  obtain ⟨_, _, _, _, hTorsSh, _⟩ :=
    weil_etale_pullback_functoriality_and_iso_torsionH.{u} ℓ
  obtain ⟨_, _, _, hPBM_all⟩ := weil_canonical_and_projective_baseChange_models.{u}
  obtain ⟨π_P, _, hPBM_P1, _⟩ := hPBM_all 1
  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}

  
  let snoc_fn : Fin (δ + 1) → TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) :=
    Fin.snoc (α := fun _ => TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k))
      (fun i : Fin δ => TensorProduct.tmul k (MvPolynomial.X i) (1 : Polynomial k))
      (TensorProduct.tmul k (1 : MvPolynomial (Fin δ) k) Polynomial.X)
  let Φ_sp : MvPolynomial (Fin (δ + 1)) k →ₐ[k]
      TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) :=
    MvPolynomial.aeval snoc_fn
  let Ψ_sp : TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) →ₐ[k]
      MvPolynomial (Fin (δ + 1)) k :=
    Algebra.TensorProduct.lift (R := k) (S := k)
      (MvPolynomial.rename Fin.castSucc)
      (Polynomial.aeval (MvPolynomial.X (Fin.last δ)))
      (fun _ _ => Commute.all _ _)
  have hΨΦ : Ψ_sp.comp Φ_sp = AlgHom.id k (MvPolynomial (Fin (δ + 1)) k) := by
    apply MvPolynomial.algHom_ext
    intro j
    simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply, Φ_sp, MvPolynomial.aeval_X]
    refine Fin.lastCases ?_ (fun i => ?_) j
    · dsimp only [snoc_fn, Ψ_sp]
      rw [Fin.snoc_last, Algebra.TensorProduct.lift_tmul, map_one, one_mul, Polynomial.aeval_X]
    · dsimp only [snoc_fn, Ψ_sp]
      rw [Fin.snoc_castSucc, Algebra.TensorProduct.lift_tmul, map_one, mul_one,
        MvPolynomial.rename_X]
  have hΦΨ : Φ_sp.comp Ψ_sp =
      AlgHom.id k (TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k)) := by
    apply Algebra.TensorProduct.ext
    · apply MvPolynomial.algHom_ext
      intro i
      simp only [AlgHom.coe_comp, Function.comp_apply, AlgHom.id_apply,
        Algebra.TensorProduct.includeLeft_apply]
      dsimp only [Ψ_sp, Φ_sp, snoc_fn]
      rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one, MvPolynomial.rename_X,
        MvPolynomial.aeval_X, Fin.snoc_castSucc]
    · apply Polynomial.algHom_ext
      simp only [AlgHom.restrictScalars_apply, AlgHom.coe_comp, Function.comp_apply,
        AlgHom.id_apply, Algebra.TensorProduct.includeRight_apply]
      dsimp only [Ψ_sp, Φ_sp, snoc_fn]
      rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul, Polynomial.aeval_X,
        MvPolynomial.aeval_X, Fin.snoc_last]
  let e_sp : MvPolynomial (Fin (δ + 1)) k ≃ₐ[k]
      TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k) :=
    AlgEquiv.ofAlgHom Φ_sp Ψ_sp hΦΨ hΨΦ
  let e_spec_sp :
      AlgebraicGeometry.Spec
        (CommRingCat.of (TensorProduct k (MvPolynomial (Fin δ) k) (Polynomial k))) ≅
      (weilAffineSpaceOver k (δ + 1)).left :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sp.symm.toRingHom)
      hom_inv_id := by
        change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ =
          𝟙 (AlgebraicGeometry.Spec _)
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h : e_sp.toRingHom.comp e_sp.symm.toRingHom = RingHom.id _ :=
          RingHom.ext e_sp.apply_symm_apply
        rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        change AlgebraicGeometry.Spec.map _ ≫ AlgebraicGeometry.Spec.map _ =
          𝟙 (AlgebraicGeometry.Spec _)
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h : e_sp.symm.toRingHom.comp e_sp.toRingHom = RingHom.id _ :=
          RingHom.ext e_sp.symm_apply_apply
        rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  let e_Y : Y_δ ≅ (weilAffineSpaceOver k (δ + 1)).left :=
    AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin δ) k) (Polynomial k) ≪≫ e_spec_sp

  
  have _ : IrreducibleSpace ↥(weilAffineSpaceOver k (δ + 1)).left := by
    change IrreducibleSpace (PrimeSpectrum (MvPolynomial (Fin (δ + 1)) k))
    infer_instance
  have hIrred_Y : IrreducibleSpace ↥Y_δ :=
    Function.Surjective.irreducibleSpace e_Y.inv.continuous e_Y.inv.homeomorph.surjective
  have _ : IrreducibleSpace ↥Y_δ := hIrred_Y

  have hNe_U : Nonempty ↥U_δ := by
    let Sk := AlgebraicGeometry.Spec (CommRingCat.of k)
    let evS : MvPolynomial (Fin δ) k →+* k := MvPolynomial.eval 0
    let pt_S : Sk ⟶ S_δ.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom evS)
    have hpt_S : pt_S ≫ S_δ.hom = 𝟙 Sk := by
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom evS) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = 𝟙 Sk
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h : evS.comp MvPolynomial.C = RingHom.id k := RingHom.ext fun c => MvPolynomial.eval_C c
      rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    let ev1 : Polynomial k →+* k := Polynomial.evalRingHom 1
    have hUnit1 : IsUnit (ev1 Polynomial.X) := by
      change IsUnit (Polynomial.eval (1 : k) Polynomial.X)
      rw [Polynomial.eval_X]
      exact isUnit_one
    let evGm : Localization.Away (Polynomial.X : Polynomial k) →+* k :=
      IsLocalization.Away.lift (Polynomial.X : Polynomial k) hUnit1
    let pt_Gm : Sk ⟶ Gm_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom evGm)
    have hpt_Gm_j : pt_Gm ≫ j_Gm = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev1) := by
      dsimp [pt_Gm, j_Gm]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      refine congrArg AlgebraicGeometry.Spec.map (congrArg CommRingCat.ofHom (RingHom.ext fun p => ?_))
      exact IsLocalization.Away.lift_eq (Polynomial.X : Polynomial k) hUnit1 p
    have hpt_A1 : (pt_Gm ≫ j_Gm) ≫ p_A1 = 𝟙 Sk := by
      rw [hpt_Gm_j]
      dsimp [p_A1]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h : ev1.comp Polynomial.C = RingHom.id k := RingHom.ext fun c => Polynomial.eval_C
      rw [h, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    let pt_Y : Sk ⟶ Y_δ :=
      CategoryTheory.Limits.pullback.lift pt_S (pt_Gm ≫ j_Gm) (hpt_S.trans hpt_A1.symm)
    let pt_U : Sk ⟶ U_δ :=
      CategoryTheory.Limits.pullback.lift pt_Gm pt_Y
        (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    exact ⟨pt_U.base (⊥ : PrimeSpectrum k)⟩

  have hLFT_S : AlgebraicGeometry.LocallyOfFiniteType S_δ.hom := by
    change AlgebraicGeometry.LocallyOfFiniteType
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin δ) k)))
    rw [← MvPolynomial.algebraMap_eq]
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr
      ((RingHom.finiteType_algebraMap (A := k) (B := MvPolynomial (Fin δ) k)).mpr inferInstance)
  have _ : AlgebraicGeometry.LocallyOfFiniteType S_δ.hom := hLFT_S
  have _ : AlgebraicGeometry.IsAffine S_δ.left := by
    change AlgebraicGeometry.IsAffine
      (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin δ) k)))
    infer_instance

  have hOpenEtalePullbackConn :
      ∀ {Z U₀ W₀ : AlgebraicGeometry.Scheme.{u}} [IrreducibleSpace ↥Z] [Nonempty ↥U₀]
        (j₀ : U₀ ⟶ Z) [AlgebraicGeometry.IsOpenImmersion j₀]
        (w₀ : W₀ ⟶ Z) [AlgebraicGeometry.Etale w₀]
        [IrreducibleSpace ↥W₀],
        ConnectedSpace ↥(CategoryTheory.Limits.pullback j₀ w₀) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback j₀ w₀) := by
    intro Z U₀ W₀ _ hNeU₀ j₀ _ w₀ _ _
    obtain ⟨u₀⟩ := hNeU₀
    obtain ⟨x₀⟩ : Nonempty ↥W₀ := inferInstance
    have hOpen_j : IsOpen (Set.range j₀.base) := j₀.isOpenEmbedding.isOpen_range
    have hOpen_w : IsOpen (Set.range w₀.base) := by
      rw [← Set.image_univ]
      exact w₀.isOpenMap Set.univ isOpen_univ
    obtain ⟨_, -, ⟨u₁, hu₁⟩, ⟨x₁, hx₁⟩⟩ :=
      PreirreducibleSpace.isPreirreducible_univ (X := ↥Z)
        (Set.range j₀.base) (Set.range w₀.base) hOpen_j hOpen_w
        ⟨j₀.base u₀, trivial, ⟨u₀, rfl⟩⟩ ⟨w₀.base x₀, trivial, ⟨x₀, rfl⟩⟩
    obtain ⟨z₀, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u₁ x₁ (hu₁.trans hx₁.symm)
    have hNePb : Nonempty ↥(CategoryTheory.Limits.pullback j₀ w₀) := ⟨z₀⟩
    let snd_pb := CategoryTheory.Limits.pullback.snd j₀ w₀
    have _ : AlgebraicGeometry.IsOpenImmersion snd_pb := inferInstance
    have hPrePb : PreirreducibleSpace ↥(CategoryTheory.Limits.pullback j₀ w₀) := by
      rw [preirreducibleSpace_iff]
      intro V₁ V₂ hV₁ hV₂ ⟨z₁, _, hz₁⟩ ⟨z₂, _, hz₂⟩
      have hImg₁ : IsOpen (snd_pb.base '' V₁) := snd_pb.isOpenEmbedding.isOpenMap V₁ hV₁
      have hImg₂ : IsOpen (snd_pb.base '' V₂) := snd_pb.isOpenEmbedding.isOpenMap V₂ hV₂
      obtain ⟨_, -, ⟨q₁, hq₁, hsq₁⟩, ⟨q₂, hq₂, hsq₂⟩⟩ :=
        PreirreducibleSpace.isPreirreducible_univ (X := ↥W₀)
          (snd_pb.base '' V₁) (snd_pb.base '' V₂) hImg₁ hImg₂
          ⟨snd_pb.base z₁, trivial, ⟨z₁, hz₁, rfl⟩⟩
          ⟨snd_pb.base z₂, trivial, ⟨z₂, hz₂, rfl⟩⟩
      have hq_eq : q₁ = q₂ := snd_pb.isOpenEmbedding.injective (hsq₁.trans hsq₂.symm)
      subst hq_eq
      exact ⟨q₁, trivial, hq₁, hq₂⟩
    have _ : IrreducibleSpace ↥(CategoryTheory.Limits.pullback j₀ w₀) :=
      { toPreirreducibleSpace := hPrePb, toNonempty := hNePb }
    exact ⟨inferInstance, hNePb⟩

  have _ : AlgebraicGeometry.IsOpenImmersion j_Gm := by
    dsimp [j_Gm]; infer_instance
  have _ : AlgebraicGeometry.IsOpenImmersion j_δ := by
    dsimp [j_δ]; infer_instance
  have _ : Nonempty ↥U_δ := hNe_U

  
  have hClause1 :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y_δ) [AlgebraicGeometry.Etale w],
        ConnectedSpace ↥W → Nonempty ↥W →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback j_δ w) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback j_δ w) := by
    intro W _ w _ hConnW hNeW
    have _ : AlgebraicGeometry.Etale e_Y.hom := inferInstance
    have _ : AlgebraicGeometry.Etale (w ≫ e_Y.hom) := inferInstance
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 (w ≫ e_Y.hom) := inferInstance
    have _ : IrreducibleSpace ↥W :=
      (hSmoothIrred.2 (δ + 1) 0 (weilAffineSpaceOver k (δ + 1)).left W (𝟙 _) (w ≫ e_Y.hom) hConnW).1
    exact hOpenEtalePullbackConn j_δ w

  
  let P1_k := weilProjectiveSpaceOver k 1
  let P_δ := CategoryTheory.Limits.pullback S_δ.hom P1_k.hom
  let π_δ : P_δ ⟶ S_δ.left := CategoryTheory.Limits.pullback.fst S_δ.hom P1_k.hom
  obtain ⟨_, _, hProp_P1k, _, _, hSm_P1k, _, _, _, _, _⟩ :=
    weil_polyP1_coord_compactification_and_properness k
  have _ : AlgebraicGeometry.IsProper P1_k.hom := hProp_P1k
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 P1_k.hom := hSm_P1k
  have hpb_Pδ : CategoryTheory.IsPullback
      π_δ (CategoryTheory.Limits.pullback.snd S_δ.hom P1_k.hom) S_δ.hom P1_k.hom :=
    CategoryTheory.IsPullback.of_hasPullback S_δ.hom P1_k.hom
  have _ : AlgebraicGeometry.IsProper π_δ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Pδ.flip inferInstance
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 π_δ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_Pδ.flip inferInstance

  obtain ⟨ι₀_δ, ι_inf_δ, s₀_δ, i₀_δ, g_U, e_A1,
    ⟨hOpen_ι0, hOpen_ιinf, hOpen_gU, _, hCl_i0⟩,
    ⟨_, hιinf_π, _, hi₀_eq, hi₀_π⟩,
    ⟨hCov_P, hDisj_i0, hPb_charts⟩,
    ⟨hFact_Y, hFact_P⟩,
    he_A1_fst⟩ :=
    weil_codim1_purity_projLine_reciprocal_atlas_over_affineSpace k δ
  have _ : AlgebraicGeometry.IsOpenImmersion ι₀_δ := hOpen_ι0
  have _ : AlgebraicGeometry.IsOpenImmersion ι_inf_δ := hOpen_ιinf
  have _ : AlgebraicGeometry.IsOpenImmersion g_U := hOpen_gU
  have _ : AlgebraicGeometry.IsClosedImmersion i₀_δ := hCl_i0

  let P_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (π_δ ≫ S_δ.hom)
  have _ : AlgebraicGeometry.LocallyOfFiniteType P_ov.hom :=
    CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.LocallyOfFiniteType)
      π_δ S_δ.hom inferInstance hLFT_S
  let π_ov : P_ov ⟶ S_δ := CategoryTheory.Over.homMk π_δ rfl
  have _ : AlgebraicGeometry.IsProper π_ov.left := by
    change AlgebraicGeometry.IsProper π_δ; infer_instance

  obtain ⟨u₀_pt⟩ := hNe_U
  have hIrred_P : IrreducibleSpace ↥P_δ := by
    let p₀ : ↥P_δ := ι₀_δ.base (j_δ.base u₀_pt)
    have hp₀_0 : p₀ ∈ Set.range ι₀_δ.base := ⟨j_δ.base u₀_pt, rfl⟩
    have hp₀_inf : p₀ ∈ Set.range ι_inf_δ.base := by
      refine ⟨g_U.base u₀_pt, ?_⟩
      change (g_U ≫ ι_inf_δ).base u₀_pt = (j_δ ≫ ι₀_δ).base u₀_pt
      rw [hPb_charts.w]
    have hPre0 : IsPreirreducible (Set.range ι₀_δ.base) := by
      rw [← Set.image_univ]
      exact (PreirreducibleSpace.isPreirreducible_univ (X := ↥Y_δ)).image
        ι₀_δ.base ι₀_δ.continuous.continuousOn
    have hPreInf : IsPreirreducible (Set.range ι_inf_δ.base) := by
      rw [← Set.image_univ]
      exact (PreirreducibleSpace.isPreirreducible_univ (X := ↥Y_δ)).image
        ι_inf_δ.base ι_inf_δ.continuous.continuousOn
    have hOpen0 : IsOpen (Set.range ι₀_δ.base) := ι₀_δ.isOpenEmbedding.isOpen_range
    have hMeet0 : ∀ V : Set ↥P_δ, IsOpen V → (Set.univ ∩ V).Nonempty →
        (Set.range ι₀_δ.base ∩ V).Nonempty := by
      rintro V hV ⟨z, _, hzV⟩
      have hz : z ∈ Set.range ι₀_δ.base ∪ Set.range ι_inf_δ.base := by
        rw [hCov_P]; trivial
      rcases hz with hz0 | hz_inf
      · exact ⟨z, hz0, hzV⟩
      · obtain ⟨z', _, hz'V, hz'0⟩ :=
          hPreInf V (Set.range ι₀_δ.base) hV hOpen0 ⟨z, hz_inf, hzV⟩ ⟨p₀, hp₀_inf, hp₀_0⟩
        exact ⟨z', hz'0, hz'V⟩
    have hPreP : PreirreducibleSpace ↥P_δ := by
      rw [preirreducibleSpace_iff]
      intro V₁ V₂ hV₁ hV₂ hNe₁ hNe₂
      obtain ⟨z'', _, hz''⟩ :=
        hPre0 V₁ V₂ hV₁ hV₂ (hMeet0 V₁ hV₁ hNe₁) (hMeet0 V₂ hV₂ hNe₂)
      exact ⟨z'', trivial, hz''⟩
    exact { toPreirreducibleSpace := hPreP, toNonempty := ⟨p₀⟩ }
  have _ : IrreducibleSpace ↥P_δ := hIrred_P

  have hConn_P :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ P_δ) [AlgebraicGeometry.Etale w],
        ConnectedSpace ↥W → Nonempty ↥W →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback ι_inf_δ w) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback ι_inf_δ w) := by
    intro W _ w _ hConnW hNeW
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 0 w := inferInstance
    have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (w ≫ π_δ) := inferInstance
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (w ≫ π_δ) := by
      simpa using hSm01
    have _ : IrreducibleSpace ↥W :=
      (hSmoothIrred.2 δ 1 S_δ.left W (𝟙 _) (w ≫ π_δ) hConnW).1
    exact hOpenEtalePullbackConn ι_inf_δ w

  have hConnBasis_P :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ P_δ) [AlgebraicGeometry.Etale w] (x : ↥W),
        ∃ (O : W.Opens),
          AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O ∧ ConnectedSpace ↥O.toScheme := by
    intro W _ w _ x
    have hShrinkOnChart :
        ∀ (ι_ch : Y_δ ⟶ P_δ) [AlgebraicGeometry.IsOpenImmersion ι_ch],
          w.base x ∈ Set.range ι_ch.base →
          ∃ (O : W.Opens),
            AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O ∧ ConnectedSpace ↥O.toScheme := by
      intro ι_ch _ hx_ch
      let U_ch : W.Opens := (TopologicalSpace.Opens.map w.base).obj ι_ch.opensRange
      have hx_Uch : x ∈ U_ch := hx_ch
      obtain ⟨O₀, hAffO₀, hxO₀, hO₀_le⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hx_Uch
      have hRange_O₀ : Set.range (O₀.ι ≫ w).base ⊆ Set.range ι_ch.base := by
        rintro _ ⟨y, rfl⟩
        exact hO₀_le y.2
      let u₀ : O₀.toScheme ⟶ Y_δ :=
        AlgebraicGeometry.IsOpenImmersion.lift ι_ch (O₀.ι ≫ w) hRange_O₀
      have hu₀_fac : u₀ ≫ ι_ch = O₀.ι ≫ w :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac ι_ch (O₀.ι ≫ w) hRange_O₀
      have _ : AlgebraicGeometry.Etale u₀ :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) u₀ ι_ch
          (inferInstance : AlgebraicGeometry.Etale ι_ch) (by rw [hu₀_fac]; infer_instance)
      have _ : AlgebraicGeometry.Etale e_Y.hom := inferInstance
      let u₁ : O₀.toScheme ⟶ (weilAffineSpaceOver k (δ + 1)).left := u₀ ≫ e_Y.hom
      have _ : AlgebraicGeometry.Etale u₁ := inferInstance
      have _ : AlgebraicGeometry.IsAffine O₀.toScheme := hAffO₀
      let R₀ : CommRingCat.{u} := W.presheaf.obj (Opposite.op O₀)
      let x₀ : ↥O₀.toScheme := ⟨x, hxO₀⟩
      let p_x : PrimeSpectrum R₀ := hAffO₀.isoSpec.hom.base x₀
      obtain ⟨m_id, hm_max, hp_le_m⟩ :=
        Ideal.exists_le_maximal p_x.asIdeal p_x.isPrime.ne_top
      let p_m : PrimeSpectrum R₀ := ⟨m_id, hm_max.isPrime⟩
      have hCl_pm : IsClosed ({p_m} : Set (PrimeSpectrum R₀)) :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_m).mpr hm_max
      have hSpec_pm : p_x ⤳ p_m :=
        (PrimeSpectrum.le_iff_specializes p_x p_m).mp hp_le_m
      let x_m : ↥O₀.toScheme := hAffO₀.isoSpec.inv.base p_m
      have hx₀_inv : hAffO₀.isoSpec.inv.base p_x = x₀ := by
        change (hAffO₀.isoSpec.hom ≫ hAffO₀.isoSpec.inv).base x₀ = x₀
        rw [hAffO₀.isoSpec.hom_inv_id]
        rfl
      have hSpec_xm : x₀ ⤳ x_m := by
        rw [← hx₀_inv]
        exact hSpec_pm.map hAffO₀.isoSpec.inv.continuous
      have hCl_xm : IsClosed ({x_m} : Set ↥O₀.toScheme) := by
        have hSet : ({x_m} : Set ↥O₀.toScheme) =
            hAffO₀.isoSpec.hom.base ⁻¹' ({p_m} : Set (PrimeSpectrum R₀)) := by
          ext z
          simp only [Set.mem_singleton_iff]
          constructor
          · rintro rfl
            change (hAffO₀.isoSpec.inv ≫ hAffO₀.isoSpec.hom).base p_m = p_m
            rw [hAffO₀.isoSpec.inv_hom_id]
            rfl
          · intro hz
            have h1 := congrArg hAffO₀.isoSpec.inv.base hz
            change (hAffO₀.isoSpec.hom ≫ hAffO₀.isoSpec.inv).base z = x_m at h1
            rwa [hAffO₀.isoSpec.hom_inv_id] at h1
        rw [hSet]
        exact hCl_pm.preimage hAffO₀.isoSpec.hom.continuous
      obtain ⟨U₁, hAffU₁, hxm_U₁, hIntU₁⟩ :=
        hSmoothIrred.1 (δ + 1) O₀.toScheme u₁ x_m hCl_xm
      have hx₀_U₁ : x₀ ∈ U₁ := hSpec_xm.mem_open U₁.isOpen hxm_U₁
      have _ : AlgebraicGeometry.IsAffine U₁.toScheme := hAffU₁
      have _ : AlgebraicGeometry.IsIntegral U₁.toScheme := hIntU₁
      have _ : IrreducibleSpace ↥U₁.toScheme :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral U₁.toScheme
      have _ : ConnectedSpace ↥U₁.toScheme := inferInstance
      let f_open : U₁.toScheme ⟶ W := U₁.ι ≫ O₀.ι
      have _ : AlgebraicGeometry.IsOpenImmersion f_open := inferInstance
      let O : W.Opens := f_open.opensRange
      have hAffO : AlgebraicGeometry.IsAffineOpen O :=
        AlgebraicGeometry.isAffineOpen_opensRange f_open
      have hxO : x ∈ O := ⟨⟨x₀, hx₀_U₁⟩, rfl⟩
      have hConnO : ConnectedSpace ↥O.toScheme :=
        (AlgebraicGeometry.Scheme.Hom.isoOpensRange f_open).hom.homeomorph.surjective.connectedSpace
          (AlgebraicGeometry.Scheme.Hom.isoOpensRange f_open).hom.continuous
      exact ⟨O, hAffO, hxO, hConnO⟩
    have hwx : w.base x ∈ Set.range ι₀_δ.base ∪ Set.range ι_inf_δ.base := by
      rw [hCov_P]; trivial
    rcases hwx with hx0 | hx_inf
    · exact hShrinkOnChart ι₀_δ hx0
    · exact hShrinkOnChart ι_inf_δ hx_inf

  obtain ⟨hZeroIso, hEtaleBC, hOpenRestrZero, hSectionLeray⟩ :=
    weil_codim1_purity_section_complement_leray_iso k ℓ hPBC

  have hAcyc_P :
      ∀ (m : ℕ), 1 ≤ m →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage (ι_inf_δ ≫ π_ov.left) m (weilEtaleTorsionSheaf Y_δ ℓ)) := by
    intro m hm
    change CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage (ι_inf_δ ≫ π_δ) m (weilEtaleTorsionSheaf Y_δ ℓ))
    rw [hιinf_π, ← he_A1_fst]
    exact hZeroIso e_A1
      (CategoryTheory.Limits.pullback.fst S_δ.hom (weilAffineSpaceOver k 1).hom)
      m (hA1Vanish δ m hm)

  have hPB_ι0 : ∀ (b : ℕ),
      WeilIsEtaleSheafPullback ι₀_δ
        (weilEtaleHigherDirectImage ι_inf_δ b (weilEtaleTorsionSheaf Y_δ ℓ))
        (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ)) :=
    hEtaleBC P_δ Y_δ Y_δ U_δ ι_inf_δ ι₀_δ j_δ g_U hPb_charts

  have hPB_i0 : ∀ (b : ℕ), 1 ≤ b →
      WeilIsEtaleSheafPullback i₀_δ
        (weilEtaleHigherDirectImage ι_inf_δ b (weilEtaleTorsionSheaf Y_δ ℓ))
        (weilEtaleHigherDirectImage π_δ (b + 1) (weilEtaleTorsionSheaf P_δ ℓ)) :=
    hSectionLeray P_ov S_δ π_ov i₀_δ hi₀_π Y_δ ι_inf_δ hDisj_i0
      (fun Ω _ _ x_bar hx => hFact_P Ω x_bar hx) hConn_P hConnBasis_P hAcyc_P

  have hPB_s0 : ∀ (b : ℕ), 1 ≤ b →
      WeilIsEtaleSheafPullback s₀_δ
        (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ))
        (weilEtaleHigherDirectImage π_δ (b + 1) (weilEtaleTorsionSheaf P_δ ℓ)) := by
    intro b hb
    have hi0 := hPB_i0 b hb
    rw [hi₀_eq] at hi0
    exact (hCompPB s₀_δ ι₀_δ _ _ _).2 (hPB_ι0 b) hi0

  
  have hUniquePB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (G₁ G₂ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F G₁ →
      WeilIsEtaleSheafPullback h F G₂ →
      Nonempty (G₁ ≅ G₂) := by
    rintro X₁ X₂ h F G₁ G₂ ⟨_, _, ⟨e₁⟩⟩ ⟨_, _, ⟨e₂⟩⟩
    exact ⟨e₁.symm ≪≫ e₂⟩

  have hIsoH0 : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      {H₁ H₂ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}},
      (H₁ ≅ H₂) → Nonempty (H₁.H 0 ≃+ H₂.H 0) := by
    intro Y H₁ H₂ e
    let T_Y := weilEtaleIdTerminal.{u} Y
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y
    let e₁ : H₁.H 0 ≃+ ↥(H₁.obj.obj (Opposite.op T_Y)) := CategoryTheory.Sheaf.H.equiv₀ H₁ hT_Y
    let e₂ : H₂.H 0 ≃+ ↥(H₂.obj.obj (Opposite.op T_Y)) := CategoryTheory.Sheaf.H.equiv₀ H₂ hT_Y
    let e_mid : ↥(H₁.obj.obj (Opposite.op T_Y)) ≃+ ↥(H₂.obj.obj (Opposite.op T_Y)) :=
      { toFun := e.hom.hom.app (Opposite.op T_Y)
        invFun := e.inv.hom.app (Opposite.op T_Y)
        left_inv := fun s =>
          congrArg (fun ν : H₁ ⟶ H₁ => (ν.hom.app (Opposite.op T_Y)) s) e.hom_inv_id
        right_inv := fun t =>
          congrArg (fun ν : H₂ ⟶ H₂ => (ν.hom.app (Opposite.op T_Y)) t) e.inv_hom_id
        map_add' := map_add (e.hom.hom.app (Opposite.op T_Y)).hom }
    exact ⟨e₁.trans (e_mid.trans e₂.symm)⟩

  have hSepRes : ∀ (K : Type u) [Field K] [IsAlgClosed K],
      IsSepClosed (IsLocalRing.ResidueField K) := by
    intro K _ _
    have hbij : Function.Bijective (IsLocalRing.residue K) :=
      ⟨RingHom.injective (IsLocalRing.residue K), Ideal.Quotient.mk_surjective⟩
    let e : K ≃+* IsLocalRing.ResidueField K := RingEquiv.ofBijective (IsLocalRing.residue K) hbij
    have _ : IsAlgClosed (IsLocalRing.ResidueField K) :=
      IsAlgClosed.of_exists_root _ fun p _ hirr => by
        let p₀ : Polynomial K := p.map e.symm.toRingHom
        have hp₀_deg : p₀.degree ≠ 0 := by
          rw [Polynomial.degree_map_eq_of_injective e.symm.injective]
          exact ne_of_gt (Irreducible.degree_pos hirr)
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p₀ hp₀_deg
        refine ⟨e c, ?_⟩
        have hev : Polynomial.eval c p₀ = e.symm (Polynomial.eval (e c) p) := by
          dsimp [p₀]
          rw [Polynomial.eval_map]
          conv_lhs => rw [← e.symm_apply_apply c]
          exact (Polynomial.hom_eval₂ p (RingHom.id _) e.symm.toRingHom (e c)).symm
        have hc0 : e.symm (Polynomial.eval (e c) p) = 0 := hev.symm.trans hc
        simpa using congrArg e hc0
    infer_instance

  have hMemEtale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  have hCoverByTK : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (U : (AlgebraicGeometry.Spec (CommRingCat.of K)).Etale) (x : ↥U.left),
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      let T_K := weilEtaleIdTerminal.{u} S_K
      ∃ (f_x : T_K ⟶ U),
        AlgebraicGeometry.Etale f_x.left ∧
        f_x.left.base (⊥ : PrimeSpectrum K) = x := by
    intro K _ _ U x S_K T_K
    have _ : AlgebraicGeometry.Etale U.hom := U.prop
    obtain ⟨V_x, hAffV, hxV, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := x) (U := (⊤ : U.left.Opens)) trivial
    let R_V : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V_x)
    let B : Type u := ↑R_V
    let p_x : PrimeSpectrum B := hAffV.isoSpec.hom.base ⟨x, hxV⟩
    let j_V : AlgebraicGeometry.Spec R_V ⟶ U.left := hAffV.isoSpec.inv ≫ V_x.ι
    have hj_V_pt : j_V.base p_x = x := by
      dsimp [j_V, p_x]
      have h1 : hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩) = ⟨x, hxV⟩ := by
        change (hAffV.isoSpec.hom ≫ hAffV.isoSpec.inv).base ⟨x, hxV⟩ = ⟨x, hxV⟩
        rw [hAffV.isoSpec.hom_inv_id]
        rfl
      change V_x.ι.base (hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩)) = x
      rw [h1]
      rfl
    have _ : AlgebraicGeometry.Etale j_V := by dsimp [j_V]; infer_instance
    let φ_KB : CommRingCat.of K ⟶ R_V := AlgebraicGeometry.Spec.preimage (j_V ≫ U.hom)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_KB = j_V ≫ U.hom :=
      AlgebraicGeometry.Spec.map_preimage (j_V ≫ U.hom)
    have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_KB) := by
      rw [hSpec_φ]; infer_instance
    have hEt_hom : φ_KB.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec
    let _ : Algebra K B := φ_KB.hom.toAlgebra
    have _ : Algebra.Etale K B := RingHom.etale_algebraMap.mp hEt_hom
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K B).mp inferInstance
    have _ : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ : ∀ i, Field (L i) := hFieldL
    let _ : ∀ i, Algebra K (L i) := hAlgL
    have hex_i₀ : ∃ i₀ : I, Θ.symm (Pi.single i₀ 1) ∉ p_x.asIdeal := by
      by_contra! hall
      have hsum1 : (1 : ∀ i : I, L i) = ∑ i : I, Pi.single i (1 : L i) := by
        ext j; simp [Finset.sum_apply]
      have hB1 : (1 : B) = ∑ i : I, Θ.symm (Pi.single i 1) := by
        calc (1 : B) = Θ.symm 1 := (map_one Θ.symm).symm
          _ = ∑ i : I, Θ.symm (Pi.single i 1) := by rw [hsum1, map_sum]
      have hmem1 : (1 : B) ∈ p_x.asIdeal := by
        rw [hB1]
        exact Ideal.sum_mem p_x.asIdeal (fun i _ => hall i)
      exact p_x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hmem1)
    obtain ⟨i₀, hi₀_not_mem⟩ := hex_i₀
    have hSurj_i₀ : Function.Surjective (algebraMap K (L i₀)) := by
      intro y
      have _ : Module.Finite K (L i₀) := (hFinSep i₀).1
      have hy_int : _root_.IsIntegral K y := Algebra.IsIntegral.isIntegral y
      let m := minpoly K y
      have hm_deg : m.degree ≠ 0 :=
        ne_of_gt (Irreducible.degree_pos (minpoly.irreducible hy_int))
      obtain ⟨c, hc⟩ := IsAlgClosed.exists_root m hm_deg
      obtain ⟨q_pol, hq_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hc
      have hq_unit : IsUnit q_pol :=
        ((minpoly.irreducible hy_int).isUnit_or_isUnit hq_pol).resolve_left
          (Polynomial.not_isUnit_X_sub_C c)
      have hq_monic : q_pol.Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C c)
          (hq_pol ▸ minpoly.monic hy_int)
      have hq1 : q_pol = 1 := by
        have hd : q_pol.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hq_unit
        have hlc : q_pol.coeff 0 = 1 := by rw [← hd]; exact hq_monic.leadingCoeff
        rw [Polynomial.eq_C_of_natDegree_eq_zero hd, hlc, map_one]
      have hm_eq : m = Polynomial.X - Polynomial.C c := by rw [hq_pol, hq1, mul_one]
      have haeval : Polynomial.aeval y m = 0 := minpoly.aeval K y
      rw [hm_eq, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at haeval
      exact ⟨c, haeval.symm⟩
    let e_L : K ≃+* L i₀ :=
      RingEquiv.ofBijective (algebraMap K (L i₀)) ⟨RingHom.injective _, hSurj_i₀⟩
    let χ : B →+* K :=
      e_L.symm.toRingHom.comp ((Pi.evalRingHom L i₀).comp Θ.toRingHom)
    have hχ_comp : φ_KB ≫ CommRingCat.ofHom χ = 𝟙 (CommRingCat.of K) := by
      apply CommRingCat.hom_ext
      ext c
      change e_L.symm (Θ (algebraMap K B c) i₀) = c
      rw [Θ.commutes]
      exact e_L.symm_apply_apply c
    have hker_χ : RingHom.ker χ = p_x.asIdeal := by
      ext b
      rw [RingHom.mem_ker]
      have hχ_zero_iff : χ b = 0 ↔ Θ b i₀ = 0 := by
        change e_L.symm (Θ b i₀) = 0 ↔ Θ b i₀ = 0
        exact ⟨fun h => by simpa using congrArg e_L h, fun h => by simp [h]⟩
      rw [hχ_zero_iff]
      have hprod0 : Θ.symm (Pi.single i₀ 1) * (b - Θ.symm (Pi.single i₀ (Θ b i₀))) = 0 := by
        apply Θ.injective
        rw [map_mul, map_sub, Θ.apply_symm_apply, Θ.apply_symm_apply, map_zero]
        ext j
        by_cases hj : j = i₀
        · subst hj; simp
        · simp [Pi.single_eq_of_ne hj]
      have hdiff_mem : b - Θ.symm (Pi.single i₀ (Θ b i₀)) ∈ p_x.asIdeal := by
        have hmem0 : Θ.symm (Pi.single i₀ 1) * (b - Θ.symm (Pi.single i₀ (Θ b i₀))) ∈
            p_x.asIdeal := by
          rw [hprod0]; exact p_x.asIdeal.zero_mem
        exact (p_x.isPrime.mem_or_mem hmem0).resolve_left hi₀_not_mem
      constructor
      · intro hb0
        rw [hb0, Pi.single_zero, map_zero, sub_zero] at hdiff_mem
        exact hdiff_mem
      · intro hbp
        by_contra hne0
        have hsingle_mem : Θ.symm (Pi.single i₀ (Θ b i₀)) ∈ p_x.asIdeal := by
          have hsub := p_x.asIdeal.sub_mem hbp hdiff_mem
          simpa using hsub
        have hinv_prod : Θ.symm (Pi.single i₀ (Θ b i₀)) * Θ.symm (Pi.single i₀ (Θ b i₀)⁻¹) =
            Θ.symm (Pi.single i₀ 1) := by
          rw [← map_mul]
          congr 1
          ext j
          by_cases hj : j = i₀
          · subst hj; simp [mul_inv_cancel₀ hne0]
          · simp [Pi.single_eq_of_ne hj]
        exact hi₀_not_mem (hinv_prod ▸ p_x.asIdeal.mul_mem_right _ hsingle_mem)
    let σ_x : S_K ⟶ U.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ) ≫ j_V
    have hσ_hom : σ_x ≫ U.hom = 𝟙 S_K := by
      dsimp [σ_x]
      rw [Category.assoc, ← hSpec_φ, ← AlgebraicGeometry.Spec.map_comp, hχ_comp,
        AlgebraicGeometry.Spec.map_id]
    have hσ_et : AlgebraicGeometry.Etale σ_x :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) σ_x U.hom U.prop
        (by rw [hσ_hom]; infer_instance)
    let f_x : T_K ⟶ U := CategoryTheory.MorphismProperty.Over.homMk σ_x hσ_hom
    refine ⟨f_x, hσ_et, ?_⟩
    have hpt_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base (⊥ : PrimeSpectrum K) =
        p_x := by
      apply PrimeSpectrum.ext
      change Ideal.comap χ ⊥ = p_x.asIdeal
      exact hker_χ
    change j_V.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ)).base
      (⊥ : PrimeSpectrum K)) = x
    rw [hpt_eq, hj_V_pt]

  have hIsZeroOfSubsingletonH0 :
      ∀ (K : Type u) [Field K] [IsAlgClosed K]
        (H_K : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton (H_K.H 0) → CategoryTheory.Limits.IsZero H_K := by
    intro K _ _ H_K hSub
    let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    let T_K := weilEtaleIdTerminal.{u} S_K
    let hT_K := weilEtaleIdTerminalIsTerminal.{u} S_K
    let e₀ : H_K.H 0 ≃+ ↥(H_K.obj.obj (Opposite.op T_K)) := CategoryTheory.Sheaf.H.equiv₀ H_K hT_K
    have hSubTK : Subsingleton ↥(H_K.obj.obj (Opposite.op T_K)) := e₀.symm.toEquiv.subsingleton
    have hsZero : ∀ (U : S_K.Etale) (s : ↥(H_K.obj.obj (Opposite.op U))), s = 0 := by
      intro U s
      let R : CategoryTheory.Sieve U :=
        { arrows := fun Y f => ∃ (f₀ : T_K ⟶ U) (g : Y ⟶ T_K), g ≫ f₀ = f
          downward_closed := by
            rintro Y Z f ⟨f₀, g, rfl⟩ h
            exact ⟨f₀, h ≫ g, Category.assoc h g f₀⟩ }
      have hR_mem : R ∈ S_K.smallEtaleTopology U := by
        rw [hMemEtale]
        intro x
        obtain ⟨f_x, hf_et, hf_pt⟩ := hCoverByTK K U x
        exact ⟨T_K, f_x, (⊥ : PrimeSpectrum K), ⟨f_x, 𝟙 T_K, Category.id_comp f_x⟩, hf_et, hf_pt⟩
      exact H_K.isSeparated U R hR_mem s 0 (fun Y f hf => by
        rcases hf with ⟨f₀, g, rfl⟩
        change (H_K.obj.map (g ≫ f₀).op) s = (H_K.obj.map (g ≫ f₀).op) 0
        rw [map_zero, op_comp, H_K.obj.map_comp]
        change (H_K.obj.map g.op) ((H_K.obj.map f₀.op) s) = 0
        rw [hSubTK.elim ((H_K.obj.map f₀.op) s) 0, map_zero])
    exact
      { unique_to := fun Y =>
          ⟨{ default := 0
             uniq := fun f =>
               CategoryTheory.Sheaf.hom_ext
                 (CategoryTheory.NatTrans.ext
                   (funext fun W_op => AddCommGrpCat.ext fun s =>
                     ((congrArg (f.hom.app W_op) (hsZero W_op.unop s)).trans
                       (map_zero (f.hom.app W_op).hom)).trans
                       ((map_zero ((0 : H_K ⟶ Y).hom.app W_op).hom).symm.trans
                         (congrArg ((0 : H_K ⟶ Y).hom.app W_op) (hsZero W_op.unop s).symm)))) }⟩
        unique_from := fun Y =>
          ⟨{ default := 0
             uniq := fun f =>
               CategoryTheory.Sheaf.hom_ext
                 (CategoryTheory.NatTrans.ext
                   (funext fun W_op => AddCommGrpCat.ext fun y =>
                     (hsZero W_op.unop ((f.hom.app W_op) y)).trans
                       (hsZero W_op.unop (((0 : Y ⟶ H_K).hom.app W_op) y)).symm)) }⟩ }

  have hStalkP1Cohom :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S_δ.left)
        (m : ℕ)
        (H_s : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback s_bar
          (weilEtaleHigherDirectImage π_δ m (weilEtaleTorsionSheaf P_δ ℓ)) H_s →
        (3 ≤ m → Subsingleton (H_s.H 0)) ∧
        (m = 2 → Finite (H_s.H 0) ∧ Nat.card (H_s.H 0) = ℓ) := by
    intro Ω _ _ s_bar m H_s hPB_Hs
    let φ_kΩ : CommRingCat.of k ⟶ CommRingCat.of Ω :=
      AlgebraicGeometry.Spec.preimage (s_bar ≫ S_δ.hom)
    have hSpec_kΩ : AlgebraicGeometry.Spec.map φ_kΩ = s_bar ≫ S_δ.hom :=
      AlgebraicGeometry.Spec.map_preimage (s_bar ≫ S_δ.hom)
    let _ : Algebra k Ω := φ_kΩ.hom.toAlgebra
    have hφ_alg : CommRingCat.ofHom (algebraMap k Ω) = φ_kΩ := CommRingCat.hom_ext rfl
    have hℓ_Ω : (ℓ : Ω) ≠ 0 := by
      intro h0
      have hk0 : (ℓ : k) = 0 :=
        RingHom.injective φ_kΩ.hom ((map_natCast φ_kΩ.hom ℓ).trans (h0.trans (map_zero _).symm))
      exact hℓ hk0
    let P1_Ω := weilProjectiveSpaceOver Ω 1
    obtain ⟨_, _, _, hInt_P1Ω, hProj_P1Ω, hSm_P1Ω, _, _, _, _, _⟩ :=
      weil_polyP1_coord_compactification_and_properness Ω
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 P1_Ω.hom := hSm_P1Ω
    have hPBM_Ω : CategoryTheory.IsPullback (π_P k Ω) P1_Ω.hom P1_k.hom
        (AlgebraicGeometry.Spec.map φ_kΩ) := by
      have h0 : CategoryTheory.IsPullback (π_P k Ω) P1_Ω.hom P1_k.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k Ω))) :=
        hPBM_P1 k Ω
      rwa [hφ_alg] at h0
    let g'_Ω : P1_Ω.left ⟶ P_δ :=
      CategoryTheory.Limits.pullback.lift (P1_Ω.hom ≫ s_bar) (π_P k Ω) (by
        rw [Category.assoc, ← hSpec_kΩ, ← hPBM_Ω.w])
    have hPb_P1Ω : CategoryTheory.IsPullback g'_Ω P1_Ω.hom π_δ s_bar :=
      { w := CategoryTheory.Limits.pullback.lift_fst _ _ _
        isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
          (fun c => hPBM_Ω.lift (c.fst ≫ CategoryTheory.Limits.pullback.snd S_δ.hom P1_k.hom) c.snd
            (by rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition, ← Category.assoc,
                  c.condition, Category.assoc, ← hSpec_kΩ]))
          (fun c => by
            apply CategoryTheory.Limits.pullback.hom_ext
            · change (_ ≫ g'_Ω) ≫ π_δ = c.fst ≫ π_δ
              rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc,
                hPBM_Ω.lift_snd, c.condition]
            · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hPBM_Ω.lift_fst])
          (fun c => hPBM_Ω.lift_snd _ _ _)
          (fun c l hl₁ hl₂ => by
            apply hPBM_Ω.hom_ext
            · rw [hPBM_Ω.lift_fst, ← hl₁, Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
            · rw [hPBM_Ω.lift_snd, hl₂])⟩ }
    let S_Ω_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (s_bar ≫ S_δ.hom)
    let P1_Ω_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (P1_Ω.hom ≫ s_bar ≫ S_δ.hom)
    let g_ov : S_Ω_ov ⟶ S_δ := CategoryTheory.Over.homMk s_bar rfl
    let f'_ov : P1_Ω_ov ⟶ S_Ω_ov := CategoryTheory.Over.homMk P1_Ω.hom rfl
    let g'_ov : P1_Ω_ov ⟶ P_ov := CategoryTheory.Over.homMk g'_Ω (by
      change g'_Ω ≫ π_δ ≫ S_δ.hom = P1_Ω.hom ≫ s_bar ≫ S_δ.hom
      rw [← Category.assoc, hPb_P1Ω.w, Category.assoc])
    have hPB_pbc : WeilIsEtaleSheafPullback s_bar
        (weilEtaleHigherDirectImage π_δ m (weilEtaleTorsionSheaf P_δ ℓ))
        (weilEtaleHigherDirectImage P1_Ω.hom m (weilEtaleTorsionSheaf P1_Ω.left ℓ)) :=
      hPBC P_ov S_δ S_Ω_ov P1_Ω_ov π_ov g_ov f'_ov g'_ov inferInstance hPb_P1Ω _ _
        (hTorsSh P_δ) (hConstPB g'_Ω _) m
    obtain ⟨e_Hs⟩ := hUniquePB s_bar _ H_s _ hPB_Hs hPB_pbc
    obtain ⟨e₁⟩ := hIsoH0 e_Hs
    have _ : HenselianLocalRing Ω := Field.henselian Ω
    have _ : IsSepClosed (IsLocalRing.ResidueField Ω) := hSepRes Ω
    obtain ⟨e₂⟩ :=
      (weil_strictly_henselian_spec_etale_eval_and_pullback Ω).1 P1_Ω.left P1_Ω.hom m
        (weilEtaleTorsionSheaf P1_Ω.left ℓ)
    let e_tot : H_s.H 0 ≃+ weilEtaleTorsionH P1_Ω.left ℓ m := e₁.trans e₂
    obtain ⟨hFin_P1Ω, hSub3_P1Ω, _, hCard2_P1Ω⟩ :=
      weil_etale_smooth_proj_curve_mod_prime_cohomology Ω P1_Ω hInt_P1Ω hProj_P1Ω ℓ hℓ_Ω
    refine ⟨fun hm3 => ?_, fun hm2 => ?_⟩
    · have _ : Subsingleton (weilEtaleTorsionH P1_Ω.left ℓ m) := hSub3_P1Ω m hm3
      exact e_tot.toEquiv.subsingleton
    · subst hm2
      have _ : Finite (weilEtaleTorsionH P1_Ω.left ℓ 2) := hFin_P1Ω 2
      exact ⟨Finite.of_equiv _ e_tot.symm.toEquiv,
        (Nat.card_congr e_tot.toEquiv).trans hCard2_P1Ω⟩

  
  have hOpenStalkZero :
      ∀ (b : ℕ), 1 ≤ b →
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y_δ),
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
            z_bar.base pt ∈ Set.range j_δ.base) →
          ∃ (H_z : CategoryTheory.Sheaf
              (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
            WeilIsEtaleSheafPullback z_bar
              (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ)) H_z ∧
            CategoryTheory.Limits.IsZero H_z := by
    intro b hb Ω _ _ z_bar hz_in
    obtain ⟨G₀, hPB_G0, hZero_G0⟩ := hOpenRestrZero Y_δ U_δ j_δ b hb
    have hRange_z : Set.range z_bar.base ⊆ Set.range j_δ.base := by
      rintro _ ⟨pt, rfl⟩
      exact hz_in pt
    let u_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ U_δ :=
      AlgebraicGeometry.IsOpenImmersion.lift j_δ z_bar hRange_z
    have hu_fac : u_bar ≫ j_δ = z_bar :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_δ z_bar hRange_z
    obtain ⟨H_z, hPB_Hz0, _, hZero_Hz0⟩ := hExPB u_bar G₀
    have hPB_Hz : WeilIsEtaleSheafPullback z_bar
        (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ)) H_z := by
      rw [← hu_fac]
      exact (hCompPB u_bar j_δ _ G₀ H_z).1 hPB_G0 hPB_Hz0
    exact ⟨H_z, hPB_Hz, hZero_Hz0 hZero_G0⟩

  
  have hClause2 :
      ∀ (b : ℕ), 2 ≤ b →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ)) := by
    intro b hb
    have hb1 : 1 ≤ b := by omega
    have hb3 : 3 ≤ b + 1 := by omega
    apply weil_etale_geometric_point_stalk_conservativity Y_δ
      (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ))
    intro Ω _ _ z_bar
    by_cases hz : z_bar.base (⊥ : PrimeSpectrum Ω) ∈ Set.range j_δ.base
    · exact hOpenStalkZero b hb1 Ω z_bar (fun pt => by
        rw [Subsingleton.elim pt (⊥ : PrimeSpectrum Ω)]
        exact hz)
    · let s_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S_δ.left :=
        z_bar ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1
      have hz_fac : z_bar = s_bar ≫ s₀_δ :=
        hFact_Y Ω z_bar (fun pt => by
          rw [Subsingleton.elim pt (⊥ : PrimeSpectrum Ω)]
          exact hz)
      obtain ⟨H_s, hPB_Hs, -⟩ :=
        hExPB s_bar (weilEtaleHigherDirectImage π_δ (b + 1) (weilEtaleTorsionSheaf P_δ ℓ))
      have hPB_z : WeilIsEtaleSheafPullback z_bar
          (weilEtaleHigherDirectImage j_δ b (weilEtaleTorsionSheaf U_δ ℓ)) H_s := by
        rw [hz_fac]
        exact (hCompPB s_bar s₀_δ _ _ H_s).1 (hPB_s0 b hb1) hPB_Hs
      have hSub_Hs : Subsingleton (H_s.H 0) :=
        (hStalkP1Cohom Ω s_bar (b + 1) H_s hPB_Hs).1 hb3
      exact ⟨H_s, hPB_z, hIsZeroOfSubsingletonH0 Ω H_s hSub_Hs⟩

  
  obtain ⟨ξ_X, hKumZero, hKumNeZero⟩ :=
    weil_codim1_purity_kummer_class_nonvanishing_and_pow_zero k ℓ hℓ δ

  have hBdryCard1 :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y_δ),
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
          z_bar.base pt ∉ Set.range j_δ.base) →
        ∀ (H_z : CategoryTheory.Sheaf
            (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback z_bar
            (weilEtaleHigherDirectImage j_δ 1 (weilEtaleTorsionSheaf U_δ ℓ)) H_z →
          Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ ℓ := by
    intro Ω _ _ z_bar hz_not H_z hPB_Hz
    let s_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S_δ.left :=
      z_bar ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1
    have hz_fac : z_bar = s_bar ≫ s₀_δ := hFact_Y Ω z_bar hz_not
    obtain ⟨H_s, hPB_Hs, -⟩ :=
      hExPB s_bar (weilEtaleHigherDirectImage π_δ 2 (weilEtaleTorsionSheaf P_δ ℓ))
    have hPB_Hs_z : WeilIsEtaleSheafPullback z_bar
        (weilEtaleHigherDirectImage j_δ 1 (weilEtaleTorsionSheaf U_δ ℓ)) H_s := by
      rw [hz_fac]
      exact (hCompPB s_bar s₀_δ _ _ H_s).1 (hPB_s0 1 (le_refl 1)) hPB_Hs
    obtain ⟨e_Hzs⟩ := hUniquePB z_bar _ H_z H_s hPB_Hz hPB_Hs_z
    obtain ⟨e_H0⟩ := hIsoH0 e_Hzs
    obtain ⟨hFin_Hs, hCard_Hs⟩ := (hStalkP1Cohom Ω s_bar 2 H_s hPB_Hs).2 rfl
    have _ : Finite (H_s.H 0) := hFin_Hs
    exact ⟨Finite.of_equiv _ e_H0.symm.toEquiv,
      le_of_eq ((Nat.card_congr e_H0.toEquiv).trans hCard_Hs)⟩

  have hClause3 :
      ∀ (W W₁ : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine W] [AlgebraicGeometry.IsAffine W₁]
        (w : W ⟶ Y_δ) (w₁ : W₁ ⟶ Y_δ)
        [AlgebraicGeometry.Etale w] [AlgebraicGeometry.Etale w₁]
        (π_W : W₁ ⟶ W)
        (π_WU : CategoryTheory.Limits.pullback j_δ w₁ ⟶ CategoryTheory.Limits.pullback j_δ w),
        π_W ≫ w ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 =
          w₁ ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 →
        π_W ≫ w ≫ CategoryTheory.Limits.pullback.snd S_δ.hom p_A1 =
          w₁ ≫ CategoryTheory.Limits.pullback.snd S_δ.hom p_A1 ≫ κ_A1 →
        π_WU ≫ CategoryTheory.Limits.pullback.snd j_δ w =
          CategoryTheory.Limits.pullback.snd j_δ w₁ ≫ π_W →
        ∀ (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w) ℓ 1)
          (p_WU : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w) ℓ 1 →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w₁) ℓ 1),
          WeilIsTorsionEtalePullback π_WU ℓ 1 p_WU →
          ∃ (I : Type u) (V : I → AlgebraicGeometry.Scheme.{u})
            (_ : ∀ a, AlgebraicGeometry.IsAffine (V a))
            (v : ∀ a, V a ⟶ W₁) (_ : ∀ a, AlgebraicGeometry.Etale (v a)),
            (⋃ a, Set.range (v a).base) = Set.univ ∧
            ∀ (a : I)
              (p_a : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_δ w₁) ℓ 1 →+
                weilEtaleTorsionH
                  (CategoryTheory.Limits.pullback
                    (CategoryTheory.Limits.pullback.snd j_δ w₁) (v a)) ℓ 1),
              WeilIsTorsionEtalePullback
                (CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.Limits.pullback.snd j_δ w₁) (v a)) ℓ 1 p_a →
              p_a (p_WU ξ) = 0 := by
    intro W W₁ _ _ w w₁ _ _ π_W π_WU hFst hSnd hWU ξ p_WU hp_WU
    obtain ⟨I, V', hAffV', g, hEt_g, c, hCov_g, hSpan⟩ :=
      weil_codim1_purity_h1_local_span_of_stalk_card_prime Y_δ U_δ j_δ ℓ ξ_X
        (hOpenStalkZero 1 (le_refl 1)) hBdryCard1 hKumNeZero W w ξ
    have _ : ∀ a : I, AlgebraicGeometry.IsAffine (V' a) := hAffV'
    have _ : ∀ a : I, AlgebraicGeometry.Etale (g a) := hEt_g
    let V : I → AlgebraicGeometry.Scheme.{u} :=
      fun a => CategoryTheory.Limits.pullback (g a) π_W
    let v : ∀ a : I, V a ⟶ W₁ :=
      fun a => CategoryTheory.Limits.pullback.snd (g a) π_W
    have hAffV : ∀ a : I, AlgebraicGeometry.IsAffine (V a) := fun a => by
      dsimp [V]; infer_instance
    have hEt_v : ∀ a : I, AlgebraicGeometry.Etale (v a) := fun a => by
      dsimp [v]; infer_instance
    refine ⟨I, V, hAffV, v, hEt_v, ?_, ?_⟩
    · ext y₁
      simp only [Set.mem_iUnion, Set.mem_range, Set.mem_univ, iff_true]
      have hy_W : π_W.base y₁ ∈ ⋃ a : I, Set.range (g a).base := by
        rw [hCov_g]; trivial
      rw [Set.mem_iUnion] at hy_W
      obtain ⟨a, x', hx'⟩ := hy_W
      obtain ⟨z, -, hz_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x' y₁ hx'
      exact ⟨a, z, hz_snd⟩
    · intro a p_a hp_a
      let fst_aU := CategoryTheory.Limits.pullback.fst
        (CategoryTheory.Limits.pullback.snd j_δ w₁) (v a)
      let snd_aU := CategoryTheory.Limits.pullback.snd
        (CategoryTheory.Limits.pullback.snd j_δ w₁) (v a)
      let h_a : CategoryTheory.Limits.pullback j_δ (g a ≫ w) ⟶
          CategoryTheory.Limits.pullback j_δ w :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst j_δ (g a ≫ w))
          (CategoryTheory.Limits.pullback.snd j_δ (g a ≫ w) ≫ g a)
          (by rw [CategoryTheory.Limits.pullback.condition, Category.assoc])
      let π_VaU : CategoryTheory.Limits.pullback
          (CategoryTheory.Limits.pullback.snd j_δ w₁) (v a) ⟶
          CategoryTheory.Limits.pullback j_δ (g a ≫ w) :=
        CategoryTheory.Limits.pullback.lift
          (fst_aU ≫ π_WU ≫ CategoryTheory.Limits.pullback.fst j_δ w)
          (snd_aU ≫ CategoryTheory.Limits.pullback.fst (g a) π_W)
          (by
            calc
              (fst_aU ≫ π_WU ≫ CategoryTheory.Limits.pullback.fst j_δ w) ≫ j_δ
                = fst_aU ≫ π_WU ≫ (CategoryTheory.Limits.pullback.fst j_δ w ≫ j_δ) := by
                    simp only [Category.assoc]
              _ = fst_aU ≫ (π_WU ≫ CategoryTheory.Limits.pullback.snd j_δ w) ≫ w := by
                    rw [CategoryTheory.Limits.pullback.condition]; simp only [Category.assoc]
              _ = (fst_aU ≫ CategoryTheory.Limits.pullback.snd j_δ w₁) ≫ π_W ≫ w := by
                    rw [hWU]; simp only [Category.assoc]
              _ = snd_aU ≫ (v a ≫ π_W) ≫ w := by
                    dsimp [fst_aU, snd_aU]
                    rw [CategoryTheory.Limits.pullback.condition (f := CategoryTheory.Limits.pullback.snd j_δ w₁) (g := v a)]
                    simp only [Category.assoc]
              _ = (snd_aU ≫ CategoryTheory.Limits.pullback.fst (g a) π_W) ≫ (g a ≫ w) := by
                    dsimp [v]
                    rw [← CategoryTheory.Limits.pullback.condition (f := g a) (g := π_W)]
                    simp only [Category.assoc])
      have h_comm_VaU : π_VaU ≫ h_a = fst_aU ≫ π_WU := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [h_a, π_VaU]
          rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, Category.assoc]
        · dsimp [h_a, π_VaU]
          rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            Category.assoc, CategoryTheory.Limits.pullback.condition (f := g a) (g := π_W),
            ← Category.assoc]
          change (snd_aU ≫ v a) ≫ π_W = fst_aU ≫ π_WU ≫ CategoryTheory.Limits.pullback.snd j_δ w
          rw [← CategoryTheory.Limits.pullback.condition
                (f := CategoryTheory.Limits.pullback.snd j_δ w₁) (g := v a),
              Category.assoc, ← hWU]
      obtain ⟨q_a, hq_a⟩ := hPullEx h_a ℓ 1
      obtain ⟨r_a, hr_a⟩ := hPullEx (CategoryTheory.Limits.pullback.fst j_δ (g a ≫ w)) ℓ 1
      obtain ⟨p_πV, hp_πV⟩ := hPullEx π_VaU ℓ 1
      obtain ⟨p_tot, hp_tot⟩ := hPullEx (fst_aU ≫ π_WU) ℓ 1
      let f₁ := π_VaU ≫ CategoryTheory.Limits.pullback.fst j_δ (g a ≫ w)
      let f₂ := fst_aU ≫ CategoryTheory.Limits.pullback.fst j_δ w₁
      obtain ⟨p₁, hp₁⟩ := hPullEx f₁ ℓ 1
      have hp_tot1 : p_tot = p_a.comp p_WU :=
        hPullComp fst_aU π_WU ℓ 1 p_a p_WU p_tot hp_a hp_WU hp_tot
      have hp_tot2 : p_tot = p_πV.comp q_a := by
        have hp_tot' : WeilIsTorsionEtalePullback (π_VaU ≫ h_a) ℓ 1 p_tot := by
          rwa [h_comm_VaU]
        exact hPullComp π_VaU h_a ℓ 1 p_πV q_a p_tot hp_πV hq_a hp_tot'
      have hp₁_eq : p₁ = p_πV.comp r_a :=
        hPullComp π_VaU (CategoryTheory.Limits.pullback.fst j_δ (g a ≫ w)) ℓ 1
          p_πV r_a p₁ hp_πV hr_a hp₁
      have hq_span : q_a ξ = (c a) • r_a ξ_X :=
        hSpan a h_a (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) q_a r_a hq_a hr_a
      have hf₁_j : f₁ ≫ j_δ =
          fst_aU ≫ CategoryTheory.Limits.pullback.snd j_δ w₁ ≫ π_W ≫ w := by
        calc
          f₁ ≫ j_δ
            = (fst_aU ≫ π_WU ≫ CategoryTheory.Limits.pullback.fst j_δ w) ≫ j_δ := by
                dsimp [f₁, π_VaU]
                rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = fst_aU ≫ π_WU ≫ (CategoryTheory.Limits.pullback.fst j_δ w ≫ j_δ) := by
                simp only [Category.assoc]
          _ = fst_aU ≫ (π_WU ≫ CategoryTheory.Limits.pullback.snd j_δ w) ≫ w := by
                rw [CategoryTheory.Limits.pullback.condition]; simp only [Category.assoc]
          _ = fst_aU ≫ CategoryTheory.Limits.pullback.snd j_δ w₁ ≫ π_W ≫ w := by
                rw [hWU]; simp only [Category.assoc]
      have hf₂_j : f₂ ≫ j_δ = fst_aU ≫ CategoryTheory.Limits.pullback.snd j_δ w₁ ≫ w₁ := by
        dsimp [f₂]
        rw [Category.assoc, CategoryTheory.Limits.pullback.condition]
      have hf_fst :
          f₁ ≫ j_δ ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 =
          f₂ ≫ j_δ ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 := by
        rw [← Category.assoc f₁ j_δ, ← Category.assoc f₂ j_δ, hf₁_j, hf₂_j]
        simp only [Category.assoc, hFst]
      have hf_snd :
          f₁ ≫ j_δ ≫ CategoryTheory.Limits.pullback.snd S_δ.hom p_A1 =
          f₂ ≫ j_δ ≫ CategoryTheory.Limits.pullback.snd S_δ.hom p_A1 ≫ κ_A1 := by
        rw [← Category.assoc f₁ j_δ, ← Category.assoc f₂ j_δ, hf₁_j, hf₂_j]
        simp only [Category.assoc, hSnd]
      have hp₁_zero : p₁ ξ_X = 0 := hKumZero _ f₁ f₂ hf_fst hf_snd p₁ hp₁
      calc
        p_a (p_WU ξ)
          = (p_a.comp p_WU) ξ := rfl
        _ = p_tot ξ := by rw [← hp_tot1]
        _ = (p_πV.comp q_a) ξ := by rw [hp_tot2]
        _ = p_πV (q_a ξ) := rfl
        _ = p_πV ((c a) • r_a ξ_X) := by rw [hq_span]
        _ = (c a) • p_πV (r_a ξ_X) := map_nsmul p_πV (c a) (r_a ξ_X)
        _ = (c a) • p₁ ξ_X := by rw [hp₁_eq]; rfl
        _ = (c a) • 0 := by rw [hp₁_zero]
        _ = 0 := smul_zero (c a)

  exact ⟨hClause1, hClause2, hClause3⟩

theorem weil_origin_cosp_alg_val_ring_and_good_stage_colimit (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (M_max : Ideal ↥(integralClosure (Polynomial k)
      (AlgebraicClosure (FractionRing (Polynomial k)))))
    [M_max.IsMaximal]
    (hM : Ideal.comap
      (algebraMap (Polynomial k)
        ↥(integralClosure (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k)))))
      M_max = Ideal.span {Polynomial.X})
    [IsDomain (Localization.AtPrime M_max)]
    [HenselianLocalRing (Localization.AtPrime M_max)]
    [IsAlgClosed (IsLocalRing.ResidueField (Localization.AtPrime M_max))]
    (φ_R_Ω : Localization.AtPrime M_max →+*
      AlgebraicClosure (FractionRing (Polynomial k)))
    (hφ_B : ∀ b : ↥(integralClosure (Polynomial k)
        (AlgebraicClosure (FractionRing (Polynomial k)))),
      φ_R_Ω (algebraMap _ (Localization.AtPrime M_max) b) = b.1)
    (hφ_comp : φ_R_Ω.comp (algebraMap (Polynomial k) (Localization.AtPrime M_max)) =
      algebraMap (Polynomial k) (AlgebraicClosure (FractionRing (Polynomial k))))
    (hφ_inj : Function.Injective φ_R_Ω) :
    let P := Polynomial k
    let R_bar := Localization.AtPrime M_max
    (∃ (ℐ : Type u) (_ : CategoryTheory.SmallCategory ℐ) (_ : CategoryTheory.IsFiltered ℐ)
      (D : ℐ ⥤ CommRingCat.{u})
      (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D)
      (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
      (e_pt : c.pt ≅ CommRingCat.of R_bar),
      (∀ i : ℐ,
        (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom (algebraMap P R_bar) ∧
        Function.Injective ((c.ι.app i) ≫ e_pt.hom).hom) ∧
      (∀ i : ℐ,
        ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ)
          (ψ_i : Polynomial k →+* ↑(D.obj i)),
          1 ≤ e ∧
          ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
          (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
          ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
          ψ_i Polynomial.X = ϖ ∧
          ψ_i.Etale ∧
          ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁))
            (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
            (D.map θ).hom ϖ = β ^ ℓ ∧
            ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
            ψ₁ Polynomial.X = β ∧
            ψ₁.Etale)) ∧
    (∃ (ℐ_sh : Type u) (_ : CategoryTheory.SmallCategory ℐ_sh)
      (_ : CategoryTheory.IsFiltered ℐ_sh)
      (D_sh : ℐ_sh ⥤ CommRingCat.{u})
      (α_sh : (CategoryTheory.Functor.const ℐ_sh).obj (CommRingCat.of P) ⟶ D_sh)
      (R_sh : Type u) (_ : CommRing R_sh) (_ : IsDomain R_sh)
      (_ : HenselianLocalRing R_sh) (_ : IsAlgClosed (IsLocalRing.ResidueField R_sh))
      (f_sh : CommRingCat.of P ⟶ CommRingCat.of R_sh)
      (ι_sh : CommRingCat.of R_sh ⟶ CommRingCat.of R_bar)
      (c_sh : CategoryTheory.Limits.Cocone D_sh) (_ : CategoryTheory.Limits.IsColimit c_sh)
      (e_sh : c_sh.pt ≅ CommRingCat.of R_sh),
      f_sh ≫ ι_sh = CommRingCat.ofHom (algebraMap P R_bar) ∧
      Function.Injective ι_sh.hom ∧
      (∀ x : R_sh, ι_sh.hom x ∈ IsLocalRing.maximalIdeal R_bar ↔
        x ∈ IsLocalRing.maximalIdeal R_sh) ∧
      (∀ j : ℐ_sh,
        (α_sh.app j).hom.Etale ∧
        IsDomain ↑(D_sh.obj j) ∧
        (α_sh.app j) ≫ (c_sh.ι.app j) ≫ e_sh.hom = f_sh ∧
        Function.Injective (((c_sh.ι.app j) ≫ e_sh.hom) ≫ ι_sh).hom ∧
        ∃ χ_j : D_sh.obj j ⟶ CommRingCat.of k,
          (α_sh.app j) ≫ χ_j = CommRingCat.ofHom (Polynomial.evalRingHom 0))) :=
by
  classical
  intro P R_bar
  let K₀ := FractionRing P
  let Ω := AlgebraicClosure K₀
  let B_bar := integralClosure P Ω
  let t_bar : R_bar := algebraMap P R_bar Polynomial.X

  have hinj_P_Ω : Function.Injective (algebraMap P Ω) := by
    have h1 : Function.Injective (algebraMap P K₀) := IsFractionRing.injective P K₀
    have h2 : Function.Injective (algebraMap K₀ Ω) := RingHom.injective (algebraMap K₀ Ω)
    rw [IsScalarTower.algebraMap_eq P K₀ Ω]
    exact h2.comp h1

  have hinj_P_Bbar : Function.Injective (algebraMap P ↥B_bar) := fun p q hpq =>
    hinj_P_Ω (congrArg Subtype.val hpq)

  have hinj_P_Rbar : Function.Injective (algebraMap P R_bar) := by
    intro p q hpq
    apply hinj_P_Ω
    have h1 : (φ_R_Ω.comp (algebraMap P R_bar)) p = (φ_R_Ω.comp (algebraMap P R_bar)) q :=
      congrArg φ_R_Ω hpq
    rwa [hφ_comp] at h1

  have ht_max : t_bar ∈ IsLocalRing.maximalIdeal R_bar := by
    change algebraMap P R_bar Polynomial.X ∈ IsLocalRing.maximalIdeal R_bar
    rw [IsScalarTower.algebraMap_apply P ↥B_bar R_bar Polynomial.X,
      IsLocalization.AtPrime.to_map_mem_maximal_iff R_bar M_max]
    change Polynomial.X ∈ Ideal.comap (algebraMap P ↥B_bar) M_max
    rw [hM]
    exact Ideal.mem_span_singleton_self Polynomial.X

  have ht_ne : t_bar ≠ 0 := fun h0 =>
    Polynomial.X_ne_zero (hinj_P_Rbar (h0.trans (map_zero _).symm))

  let pHom : ∀ B : Subalgebra P R_bar, CommRingCat.of P ⟶ CommRingCat.of ↥B :=
    fun B => CommRingCat.ofHom
      { toFun := fun p => ⟨algebraMap P R_bar p, B.algebraMap_mem p⟩
        map_one' := Subtype.ext (map_one _)
        map_mul' := fun x y => Subtype.ext (map_mul _ x y)
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun x y => Subtype.ext (map_add _ x y) }

  
  have hRangeSubalg : ∀ (E_t : Type u) [CommRing E_t]
      (p_Et : P →+* E_t) (ρ_t : E_t →+* R_bar),
      Function.Injective ρ_t →
      ρ_t.comp p_Et = algebraMap P R_bar →
      ∃ (B_sub : Subalgebra P R_bar)
        (hom_cat : CommRingCat.of E_t ⟶ CommRingCat.of ↥B_sub),
        (∀ r : R_bar, r ∈ B_sub ↔ r ∈ Set.range ρ_t) ∧
        Function.Bijective hom_cat.hom ∧
        (∀ x : E_t, B_sub.val (hom_cat.hom x) = ρ_t x) ∧
        CommRingCat.ofHom p_Et ≫ hom_cat = pHom B_sub := by
    clear * -
    intro E_t _ p_Et ρ_t hρ_inj hρ_P
    let B_sub : Subalgebra P R_bar :=
      { carrier := Set.range ρ_t
        mul_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a * b, map_mul ρ_t a b⟩
        one_mem' := ⟨1, map_one ρ_t⟩
        add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a + b, map_add ρ_t a b⟩
        zero_mem' := ⟨0, map_zero ρ_t⟩
        algebraMap_mem' := fun p => ⟨p_Et p, RingHom.congr_fun hρ_P p⟩ }
    let hom_cat : CommRingCat.of E_t ⟶ CommRingCat.of ↥B_sub :=
      CommRingCat.ofHom
        { toFun := fun x => ⟨ρ_t x, ⟨x, rfl⟩⟩
          map_one' := Subtype.ext (map_one ρ_t)
          map_mul' := fun x y => Subtype.ext (map_mul ρ_t x y)
          map_zero' := Subtype.ext (map_zero ρ_t)
          map_add' := fun x y => Subtype.ext (map_add ρ_t x y) }
    have hbij : Function.Bijective hom_cat.hom := by
      refine ⟨?_, ?_⟩
      · intro x y hxy
        exact hρ_inj (congrArg Subtype.val hxy)
      · intro y
        rcases y.2 with ⟨x, hx⟩
        exact ⟨x, Subtype.ext hx⟩
    refine ⟨B_sub, hom_cat, fun _ => Iff.rfl, hbij, fun _ => rfl, ?_⟩
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro p
    apply Subtype.ext
    exact RingHom.congr_fun hρ_P p

  have hSumDegLt : ∀ {R₀ : Type u} [CommRing R₀] (m : ℕ) (f_c : Fin m → R₀),
      (∑ i : Fin m, Polynomial.C (f_c i) * Polynomial.X ^ i.1).degree < (m : WithBot ℕ) := by
    clear * -
    intro R₀ _ m f_c
    exact Finset.sum_induction _ (fun q_p : Polynomial R₀ => q_p.degree < (m : WithBot ℕ))
      (fun a b ha hb => (Polynomial.degree_add_le a b).trans_lt (max_lt ha hb))
      (WithBot.bot_lt_coe m)
      (fun i _ => (Polynomial.degree_C_mul_X_pow_le i.1 (f_c i)).trans_lt
        (WithBot.coe_lt_coe.mpr i.2))

  have hNonzeroConstOfEvalZero : ∀ {A B : Type u} [CommRing A] [CommRing B] [IsDomain B]
      (H : Polynomial A), H ≠ 0 → ∀ (f : A →+* B) (x : B), x ≠ 0 →
      Polynomial.eval₂ f x H = 0 →
      ∃ (a₀ : A) (b : B), a₀ ≠ 0 ∧ f a₀ + x * b = 0 := by
    clear * -
    intro A B _ _ _ H hH_ne f x hx_ne hev
    have hFactor : ∀ (d : ℕ) (G : Polynomial A), G.natDegree ≤ d → G ≠ 0 →
        ∃ (r : ℕ) (G₁ : Polynomial A), G = Polynomial.X ^ r * G₁ ∧ G₁.coeff 0 ≠ 0 := by
      intro d
      induction d with
      | zero =>
        intro G hdeg hG_ne
        refine ⟨0, G, by simp, ?_⟩
        intro hc0
        apply hG_ne
        rw [Polynomial.eq_C_of_natDegree_eq_zero (Nat.eq_zero_of_le_zero hdeg), hc0, map_zero]
      | succ d ih =>
        intro G hdeg hG_ne
        by_cases hc0 : G.coeff 0 = 0
        · obtain ⟨G', rfl⟩ := Polynomial.X_dvd_iff.mpr hc0
          have hG'_ne : G' ≠ 0 := right_ne_zero_of_mul hG_ne
          have hG'_deg : G'.natDegree ≤ d := by
            rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
            intro N hN
            have hlt : (Polynomial.X * G').natDegree < N + 1 :=
              lt_of_le_of_lt hdeg (Nat.succ_lt_succ hN)
            have h0 := Polynomial.coeff_eq_zero_of_natDegree_lt hlt
            rwa [Polynomial.coeff_X_mul] at h0
          obtain ⟨r, G₁, rfl, hG₁0⟩ := ih G' hG'_deg hG'_ne
          exact ⟨r + 1, G₁, by rw [pow_succ', mul_assoc], hG₁0⟩
        · exact ⟨0, G, by simp, hc0⟩
    obtain ⟨r, H₁, hH_eq, hH₁0⟩ := hFactor H.natDegree H (le_refl _) hH_ne
    have hev₁ : Polynomial.eval₂ f x H₁ = 0 := by
      rw [hH_eq, Polynomial.eval₂_mul, Polynomial.eval₂_X_pow] at hev
      exact (mul_eq_zero.mp hev).resolve_left (pow_ne_zero r hx_ne)
    have hsub0 : (H₁ - Polynomial.C (H₁.coeff 0)).coeff 0 = 0 := by simp
    obtain ⟨Q, hQ⟩ := Polynomial.X_dvd_iff.mpr hsub0
    have hH₁_split : H₁ = Polynomial.C (H₁.coeff 0) + Polynomial.X * Q :=
      eq_add_of_sub_eq' hQ
    rw [hH₁_split, Polynomial.eval₂_add, Polynomial.eval₂_C, Polynomial.eval₂_mul,
      Polynomial.eval₂_X] at hev₁
    exact ⟨H₁.coeff 0, Polynomial.eval₂ f x Q, hH₁0, hev₁⟩

  have hEpsBar : ∃ ε_bar : R_bar →+* k,
      RingHom.ker ε_bar = IsLocalRing.maximalIdeal R_bar ∧
      ε_bar.comp ((algebraMap P R_bar).comp Polynomial.C) = RingHom.id k ∧
      ε_bar.comp (algebraMap P R_bar) = Polynomial.evalRingHom 0 := by
    let κ_bar := IsLocalRing.ResidueField R_bar
    let res : R_bar →+* κ_bar := IsLocalRing.residue R_bar
    let ι_k : k →+* κ_bar := res.comp ((algebraMap P R_bar).comp Polynomial.C)
    have hres_P : res.comp (algebraMap P R_bar) = ι_k.comp (Polynomial.evalRingHom 0) := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp [ι_k]
      · change res t_bar = ι_k (Polynomial.eval 0 Polynomial.X)
        rw [Polynomial.eval_X, map_zero]
        exact (Ideal.Quotient.eq_zero_iff_mem).mpr ht_max
    have hB_in_k : ∀ d : ↥B_bar, ∃ c : k, res (algebraMap ↥B_bar R_bar d) = ι_k c := by
      intro d
      obtain ⟨G, hG_mon, hG_ev⟩ := d.2
      have hd_evB : Polynomial.eval₂ (algebraMap P ↥B_bar) d G = 0 := by
        apply Subtype.ext
        have h1 := Polynomial.hom_eval₂ G (algebraMap P ↥B_bar) B_bar.val.toRingHom d
        change (B_bar.val.toRingHom (Polynomial.eval₂ (algebraMap P ↥B_bar) d G)) = 0
        rw [h1]
        exact hG_ev
      have hd_ev_res : Polynomial.eval₂ (ι_k.comp (Polynomial.evalRingHom 0))
          (res (algebraMap ↥B_bar R_bar d)) G = 0 := by
        have hhom : (res.comp (algebraMap ↥B_bar R_bar)).comp (algebraMap P ↥B_bar) =
            ι_k.comp (Polynomial.evalRingHom 0) := by
          rw [← hres_P]
          apply RingHom.ext
          intro p
          exact congrArg res (IsScalarTower.algebraMap_apply P ↥B_bar R_bar p).symm
        rw [← hhom]
        change Polynomial.eval₂ ((res.comp (algebraMap ↥B_bar R_bar)).comp (algebraMap P ↥B_bar))
          ((res.comp (algebraMap ↥B_bar R_bar)) d) G = 0
        rw [← Polynomial.hom_eval₂ G (algebraMap P ↥B_bar) (res.comp (algebraMap ↥B_bar R_bar)) d,
          hd_evB, map_zero]
      let G_k : Polynomial k := G.map (Polynomial.evalRingHom 0)
      have hGk_mon : G_k.Monic := hG_mon.map (Polynomial.evalRingHom 0)
      have hGk_ev : Polynomial.eval₂ ι_k (res (algebraMap ↥B_bar R_bar d)) G_k = 0 := by
        dsimp [G_k]
        rwa [Polynomial.eval₂_map]
      obtain ⟨M_k, hMk⟩ := (Polynomial.splits_iff_exists_multiset).mp (IsAlgClosed.splits G_k)
      rw [hGk_mon.leadingCoeff, map_one, one_mul] at hMk
      rw [hMk, Polynomial.eval₂_multiset_prod, Multiset.map_map] at hGk_ev
      obtain ⟨c, _, hz0⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp hGk_ev)
      simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hz0
      exact ⟨c, sub_eq_zero.mp hz0⟩
    have hSurj_ιk : Function.Surjective ι_k := by
      intro y
      obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective y
      obtain ⟨⟨b, s⟩, hsx⟩ := IsLocalization.surj M_max.primeCompl r
      obtain ⟨c_b, hcb⟩ := hB_in_k b
      obtain ⟨c_s, hcs⟩ := hB_in_k s.1
      have hs_unit : IsUnit (res (algebraMap ↥B_bar R_bar s.1)) :=
        (IsLocalization.map_units R_bar s).map res
      have hcs_ne : ι_k c_s ≠ 0 := by
        rw [← hcs]
        exact hs_unit.ne_zero
      have hcs_k_ne : c_s ≠ 0 := fun h0 => hcs_ne (by rw [h0, map_zero])
      have hmul : res r * ι_k c_s = ι_k c_b := by
        rw [← hcs, ← hcb, ← map_mul, hsx]
      refine ⟨c_b * c_s⁻¹, ?_⟩
      apply mul_right_cancel₀ hcs_ne
      rw [← map_mul, mul_assoc, inv_mul_cancel₀ hcs_k_ne, mul_one, hmul]
    let e_res : k ≃+* κ_bar := RingEquiv.ofBijective ι_k ⟨RingHom.injective ι_k, hSurj_ιk⟩
    let ε_bar : R_bar →+* k := e_res.symm.toRingHom.comp res
    refine ⟨ε_bar, ?_, ?_, ?_⟩
    · ext x
      rw [RingHom.mem_ker]
      change e_res.symm (res x) = 0 ↔ x ∈ IsLocalRing.maximalIdeal R_bar
      have hiff : res x = 0 ↔ x ∈ IsLocalRing.maximalIdeal R_bar :=
        Ideal.Quotient.eq_zero_iff_mem
      rw [← hiff]
      exact ⟨fun h => by apply e_res.symm.injective; simpa only [map_zero] using h,
        fun h => by rw [h, map_zero]⟩
    · apply RingHom.ext
      intro c
      exact e_res.symm_apply_apply c
    · apply RingHom.ext
      intro p
      have hp := RingHom.congr_fun hres_P p
      change e_res.symm ((res.comp (algebraMap P R_bar)) p) = (Polynomial.evalRingHom 0) p
      rw [hp]
      exact e_res.symm_apply_apply _

  obtain ⟨ε_bar, hε_ker, hε_C, hε_P⟩ := hEpsBar

  
  have hShrink : ∀ (E : Type u) [CommRing E] (ψ_E : P →+* E) (ρ : E →+* R_bar),
      ψ_E.Etale →
      ρ.comp (ψ_E.comp Polynomial.C) = (algebraMap P R_bar).comp Polynomial.C →
      ρ (ψ_E Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar →
      ρ (ψ_E Polynomial.X) ≠ 0 →
      ∃ h : E,
        IsUnit (ρ h) ∧
        IsDomain (Localization.Away h) ∧
        ((algebraMap E (Localization.Away h)).comp ψ_E).Etale ∧
        ∃ ρ₁ : Localization.Away h →+* R_bar,
          ρ₁.comp (algebraMap E (Localization.Away h)) = ρ ∧
          Function.Injective ρ₁ := by
    intro E _ ψ_E ρ hEt hC hX_max hX_ne
    let φ : P →+* R_bar := ρ.comp ψ_E
    let ι_k : k →+* R_bar := (algebraMap P R_bar).comp Polynomial.C
    have hφ_inj : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro p hp0
      by_contra hp_ne
      obtain ⟨M, hM_sp⟩ := (Polynomial.splits_iff_exists_multiset).mp (IsAlgClosed.splits p)
      have hlc_ne : p.leadingCoeff ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp_ne
      have hlc_unit : IsUnit (ι_k p.leadingCoeff) := (Ne.isUnit hlc_ne).map ι_k
      have hφ_C : ∀ c : k, φ (Polynomial.C c) = ι_k c := RingHom.congr_fun hC
      have hprod0 : ((M.map (fun a => Polynomial.X - Polynomial.C a)).map φ).prod = 0 := by
        have h1 := congrArg φ hM_sp
        rw [hp0, map_mul, hφ_C, map_multiset_prod] at h1
        exact (mul_eq_zero.mp h1.symm).resolve_left hlc_unit.ne_zero
      rw [Multiset.map_map] at hprod0
      obtain ⟨a, _, ha_eq⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp hprod0)
      simp only [Function.comp_apply, map_sub, hφ_C] at ha_eq
      have hX_eq : ρ (ψ_E Polynomial.X) = ι_k a := sub_eq_zero.mp ha_eq
      by_cases ha0 : a = 0
      · rw [ha0, map_zero] at hX_eq
        exact hX_ne hX_eq
      · have hu_a : IsUnit (ρ (ψ_E Polynomial.X)) := by
          rw [hX_eq]
          exact (Ne.isUnit ha0).map ι_k
        exact (IsLocalRing.notMem_maximalIdeal.mpr hu_a) hX_max

    let q_E : Ideal E := Ideal.comap ρ (IsLocalRing.maximalIdeal R_bar)
    have hqE_prime : q_E.IsPrime := Ideal.IsPrime.comap ρ
    have hqE_max : q_E.IsMaximal := by
      let χ_E : E →+* k := ε_bar.comp ρ
      have hχ_surj : Function.Surjective χ_E := by
        intro c
        refine ⟨ψ_E (Polynomial.C c), ?_⟩
        change (ε_bar.comp (ρ.comp (ψ_E.comp Polynomial.C))) c = c
        rw [hC, hε_C, RingHom.id_apply]
      have hker_eq : RingHom.ker χ_E = q_E := by
        ext e
        change e ∈ Ideal.comap ρ (RingHom.ker ε_bar) ↔ e ∈ q_E
        rw [hε_ker]
      rw [← hker_eq]
      exact RingHom.ker_isMaximal_of_surjective χ_E hχ_surj

    have hex_h : ∃ h : E, IsUnit (ρ h) ∧ IsDomain (Localization.Away h) := by
      clear * - hEt hqE_prime hqE_max
      let R_E : CommRingCat.{u} := CommRingCat.of E
      let X_E : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec R_E
      let e_mv : MvPolynomial (Fin 1) k ≃ₐ[k] Polynomial k := MvPolynomial.uniqueAlgEquiv k (Fin 1)
      let φ_mv : MvPolynomial (Fin 1) k →+* ↑R_E := ψ_E.comp e_mv.toRingHom
      have hφ_mv_et : φ_mv.Etale :=
        RingHom.Etale.stableUnderComposition e_mv.toRingHom ψ_E
          (RingHom.Etale.of_bijective (f := e_mv.toRingHom) e_mv.bijective) hEt
      let u_E : X_E ⟶ (weilAffineSpaceOver k 1).left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_mv)
      have _ : AlgebraicGeometry.Etale u_E :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_mv_et
      let x_E : PrimeSpectrum ↑R_E := ⟨q_E, hqE_prime⟩
      have hx_closed : IsClosed ({x_E} : Set ↥X_E) :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal x_E).mpr hqE_max
      obtain ⟨U, _, hxU, hIntU⟩ :=
        (weil_algClosed_smooth_etale_local_domain_and_connected_integral k).1 1 X_E u_E x_E hx_closed
      obtain ⟨V_b, ⟨h, rfl⟩, hx_Vb, hVb_le⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp PrimeSpectrum.isBasis_basic_opens) hxU
      have hh_not_qE : (h : E) ∉ q_E := hx_Vb
      have hu_h : IsUnit (ρ (h : E)) := IsLocalRing.notMem_maximalIdeal.mp hh_not_qE
      let V_h : X_E.Opens := PrimeSpectrum.basicOpen h
      have hVh_le : V_h ≤ U := hVb_le
      have _ : Nonempty ↥V_h.toScheme := ⟨⟨x_E, hx_Vb⟩⟩
      have _ : AlgebraicGeometry.IsIntegral U.toScheme := hIntU
      have _ : AlgebraicGeometry.IsOpenImmersion (X_E.homOfLE hVh_le) :=
        AlgebraicGeometry.instIsOpenImmersionHomOfLE X_E hVh_le
      have _ : AlgebraicGeometry.IsIntegral V_h.toScheme :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion (X_E.homOfLE hVh_le)
      let e_away := AlgebraicGeometry.basicOpenIsoSpecAway (R := R_E) h
      have _ : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h))) :=
        ⟨e_away.hom.base ⟨x_E, hx_Vb⟩⟩
      have hInt_Away : AlgebraicGeometry.IsIntegral
          (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h))) :=
        AlgebraicGeometry.isIntegral_of_isOpenImmersion e_away.inv
      have hDom_E₁ : IsDomain (Localization.Away (h : E)) :=
        (AlgebraicGeometry.affine_isIntegral_iff
          (CommRingCat.of (Localization.Away h))).mp hInt_Away
      exact ⟨(h : E), hu_h, hDom_E₁⟩

    obtain ⟨h, hu_h, hDom_E₁⟩ := hex_h
    let E₁ := Localization.Away h
    let _ : IsDomain E₁ := hDom_E₁
    let ψ₁ : P →+* E₁ := (algebraMap E E₁).comp ψ_E
    have h_alg_et : Algebra.Etale E E₁ := @Algebra.Etale.of_isLocalizationAway E E₁ _ _ _ h _
    have hψ₁_et : ψ₁.Etale :=
      RingHom.Etale.stableUnderComposition ψ_E (algebraMap E E₁) hEt
        (RingHom.etale_algebraMap.mpr h_alg_et)
    have h_pow_units : ∀ y : ↥(Submonoid.powers h), IsUnit (ρ y.1) := by
      rintro ⟨_, n, rfl⟩
      rw [map_pow]
      exact hu_h.pow n
    let ρ₁ : E₁ →+* R_bar :=
      IsLocalization.lift (M := Submonoid.powers h) (S := E₁) (g := ρ) h_pow_units
    have hρ₁_comp : ρ₁.comp (algebraMap E E₁) = ρ := by
      apply RingHom.ext
      intro e
      exact IsLocalization.lift_eq (M := Submonoid.powers h) (S := E₁) h_pow_units e
    have hρ₁_ψ₁ : ρ₁.comp ψ₁ = φ := by
      rw [← RingHom.comp_assoc, hρ₁_comp]
    have hψ₁_inj : Function.Injective ψ₁ := by
      intro p q hpq
      apply hφ_inj
      rw [← hρ₁_ψ₁]
      exact congrArg ρ₁ hpq

    have hρ₁_inj : Function.Injective ρ₁ := by
      clear * - hNonzeroConstOfEvalZero hφ_inj hψ₁_et hψ₁_inj hρ₁_ψ₁
      let K₀ := FractionRing P
      rw [injective_iff_map_eq_zero]
      intro z hz0
      by_contra hz_ne
      let F_E₁ := FractionRing E₁
      have hinj_E₁_F : Function.Injective (algebraMap E₁ F_E₁) := IsFractionRing.injective E₁ F_E₁
      have hK_units : ∀ s : ↥(nonZeroDivisors P), IsUnit (((algebraMap E₁ F_E₁).comp ψ₁) s.1) := by
        intro s
        apply Ne.isUnit
        intro h0
        have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        have h1 : algebraMap E₁ F_E₁ (ψ₁ s.1) = algebraMap E₁ F_E₁ (ψ₁ 0) := by
          simpa only [RingHom.comp_apply, map_zero] using h0
        exact hs_ne (hψ₁_inj (hinj_E₁_F h1))
      let j_K : K₀ →+* F_E₁ :=
        IsLocalization.lift (M := nonZeroDivisors P) (S := K₀) hK_units
      have hj_K_eq : ∀ p : P, j_K (algebraMap P K₀ p) = algebraMap E₁ F_E₁ (ψ₁ p) :=
        IsLocalization.lift_eq (M := nonZeroDivisors P) (S := K₀) hK_units
      letI : Algebra P E₁ := ψ₁.toAlgebra
      haveI : Algebra.Etale P E₁ := RingHom.etale_algebraMap.mp hψ₁_et
      haveI : Algebra.Etale K₀ (TensorProduct P K₀ E₁) := Algebra.Etale.baseChange P E₁ K₀
      obtain ⟨I_K, hFin_IK, L_K, hField_LK, hAlg_LK, Θ_K, hFinSep_K⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K₀ (TensorProduct P K₀ E₁)).mp inferInstance
      letI : Finite I_K := hFin_IK
      letI : ∀ i, Field (L_K i) := hField_LK
      letI : ∀ i, Algebra K₀ (L_K i) := hAlg_LK
      haveI : ∀ i, Module.Finite K₀ (L_K i) := fun i => (hFinSep_K i).1
      haveI : Module.Finite K₀ (TensorProduct P K₀ E₁) :=
        Module.Finite.equiv Θ_K.symm.toLinearEquiv
      haveI : Algebra.IsIntegral K₀ (TensorProduct P K₀ E₁) :=
        Algebra.IsIntegral.of_finite K₀ (TensorProduct P K₀ E₁)
      letI : Algebra K₀ F_E₁ := j_K.toAlgebra
      let f_K : K₀ →ₐ[P] F_E₁ :=
        { j_K with
          commutes' := fun p => by
            change j_K ((algebraMap P K₀) p) = (algebraMap P F_E₁) p
            rw [hj_K_eq p, IsScalarTower.algebraMap_apply P E₁ F_E₁ p]
            rfl }
      let f_E₁ : E₁ →ₐ[P] F_E₁ := IsScalarTower.toAlgHom P E₁ F_E₁
      let Φ_P : TensorProduct P K₀ E₁ →ₐ[P] F_E₁ :=
        Algebra.TensorProduct.lift f_K f_E₁ (fun _ _ => Commute.all _ _)
      let Φ_K : TensorProduct P K₀ E₁ →ₐ[K₀] F_E₁ :=
        { Φ_P.toRingHom with
          commutes' := fun q => by
            have h1 : Φ_P (q ⊗ₜ[P] 1) = f_K q * f_E₁ 1 :=
              Algebra.TensorProduct.lift_tmul f_K f_E₁ (fun _ _ => Commute.all _ _) q 1
            exact h1.trans (by change j_K q * algebraMap E₁ F_E₁ 1 = j_K q; rw [map_one, mul_one]) }
      have hz_int : _root_.IsIntegral K₀ (algebraMap E₁ F_E₁ z) := by
        have h1 : Φ_K ((1 : K₀) ⊗ₜ[P] z) = algebraMap E₁ F_E₁ z := by
          have h2 : Φ_P ((1 : K₀) ⊗ₜ[P] z) = f_K 1 * f_E₁ z :=
            Algebra.TensorProduct.lift_tmul f_K f_E₁ (fun _ _ => Commute.all _ _) 1 z
          exact h2.trans (by
            change j_K 1 * algebraMap E₁ F_E₁ z = algebraMap E₁ F_E₁ z
            rw [map_one, one_mul])
        rw [← h1]
        exact _root_.IsIntegral.map Φ_K (Algebra.IsIntegral.isIntegral ((1 : K₀) ⊗ₜ[P] z))
      obtain ⟨Q, hQ_mon, hQ_ev⟩ := hz_int
      let m := Q.natDegree
      have hQ_sum : Q = Polynomial.X ^ m +
          ∑ i : Fin m, Polynomial.C (Q.coeff i.1) * Polynomial.X ^ i.1 := by
        conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow Q]
        rw [Finset.sum_range_succ, add_comm]
        have hlc : Q.coeff m = 1 := hQ_mon.coeff_natDegree
        dsimp [m] at hlc ⊢
        rw [hlc, map_one, one_mul,
          ← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (Q.coeff j) * Polynomial.X ^ j) m]
      have hQz : (algebraMap E₁ F_E₁ z) ^ m +
          ∑ i : Fin m, j_K (Q.coeff i.1) * (algebraMap E₁ F_E₁ z) ^ i.1 = 0 := by
        conv_lhs at hQ_ev => rw [hQ_sum]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow,
          Polynomial.eval₂_finsetSum] at hQ_ev
        simp_rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow] at hQ_ev
        exact hQ_ev
      let pairK : Fin m → P × ↥(nonZeroDivisors P) :=
        fun i => Classical.choose (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
      have hpairK : ∀ i : Fin m,
          Q.coeff i.1 * algebraMap P K₀ (pairK i).2.1 = algebraMap P K₀ (pairK i).1 :=
        fun i => Classical.choose_spec (IsLocalization.surj (nonZeroDivisors P) (Q.coeff i.1))
      let s_sub : ↥(nonZeroDivisors P) := ∏ i : Fin m, (pairK i).2
      let restK : Fin m → P := fun i => (∏ j ∈ Finset.univ.erase i, (pairK j).2).1
      have hs_fac : ∀ i : Fin m, s_sub.1 = (pairK i).2.1 * restK i := by
        intro i
        have h1 : (pairK i).2 * (∏ j ∈ Finset.univ.erase i, (pairK j).2) = s_sub :=
          Finset.mul_prod_erase Finset.univ (fun j => (pairK j).2) (Finset.mem_univ i)
        exact congrArg Subtype.val h1.symm
      let num_P : Fin m → P := fun i => (pairK i).1 * restK i
      have hnum_eq : ∀ i : Fin m,
          Q.coeff i.1 * algebraMap P K₀ s_sub.1 = algebraMap P K₀ (num_P i) := by
        intro i
        conv_lhs => rw [hs_fac i]
        rw [map_mul, ← mul_assoc, hpairK i, ← map_mul]
      let H : Polynomial P :=
        Polynomial.C s_sub.1 * Polynomial.X ^ m +
          ∑ i : Fin m, Polynomial.C (num_P i) * Polynomial.X ^ i.1
      have hH_ne : H ≠ 0 := by
        intro h0
        have hc_m : H.coeff m = s_sub.1 := by
          dsimp [H]
          rw [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow_self, mul_one,
            Polynomial.finsetSum_coeff]
          have hsum0 : (∑ i : Fin m, (Polynomial.C (num_P i) * Polynomial.X ^ i.1).coeff m) = 0 := by
            refine Finset.sum_eq_zero fun i _ => ?_
            rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
            simp [ne_of_gt i.2]
          rw [hsum0, add_zero]
        rw [h0, Polynomial.coeff_zero] at hc_m
        exact (mem_nonZeroDivisors_iff_ne_zero.mp s_sub.2) hc_m.symm
      have hH_ev : Polynomial.eval₂ ψ₁ z H = 0 := by
        apply hinj_E₁_F
        rw [map_zero]
        dsimp [H]
        rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow,
          Polynomial.eval₂_finsetSum]
        simp_rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
        rw [map_add, map_mul, map_pow, map_sum]
        have hterm : ∀ i : Fin m,
            algebraMap E₁ F_E₁ (ψ₁ (num_P i) * z ^ i.1) =
              algebraMap E₁ F_E₁ (ψ₁ s_sub.1) *
                (j_K (Q.coeff i.1) * (algebraMap E₁ F_E₁ z) ^ i.1) := by
          intro i
          rw [map_mul, map_pow, ← hj_K_eq (num_P i), ← hnum_eq i, map_mul, hj_K_eq s_sub.1]
          ring
        simp_rw [hterm, ← Finset.mul_sum]
        calc
          algebraMap E₁ F_E₁ (ψ₁ s_sub.1) * (algebraMap E₁ F_E₁ z) ^ m +
              algebraMap E₁ F_E₁ (ψ₁ s_sub.1) *
                ∑ i : Fin m, j_K (Q.coeff i.1) * (algebraMap E₁ F_E₁ z) ^ i.1 =
            algebraMap E₁ F_E₁ (ψ₁ s_sub.1) *
              ((algebraMap E₁ F_E₁ z) ^ m +
                ∑ i : Fin m, j_K (Q.coeff i.1) * (algebraMap E₁ F_E₁ z) ^ i.1) := by ring
          _ = 0 := by rw [hQz, mul_zero]
      obtain ⟨a₀, b, ha₀_ne, hab⟩ := hNonzeroConstOfEvalZero H hH_ne ψ₁ z hz_ne hH_ev
      have hρ_ab := congrArg ρ₁ hab
      rw [map_add, map_mul, hz0, zero_mul, add_zero, map_zero] at hρ_ab
      have hφ_a0 : φ a₀ = φ 0 := by
        rw [map_zero, ← hρ₁_ψ₁]
        exact hρ_ab
      exact ha₀_ne (hφ_inj hφ_a0)

    exact ⟨h, hu_h, hDom_E₁, hψ₁_et, ρ₁, hρ₁_comp, hρ₁_inj⟩

  
  have hIsolateFiber : ∀ (B₁ : Type u) [CommRing B₁] (θ₁ : P →+* B₁),
      θ₁.Etale →
      ∀ (p₁ : Ideal B₁) [p₁.IsPrime],
        θ₁ Polynomial.X ∈ p₁ →
        ∃ f₂ : B₁, f₂ ∉ p₁ ∧ ∀ b ∈ p₁, f₂ * b ∈ Ideal.span {θ₁ Polynomial.X} := by
    clear * -
    intro B₁ _ θ₁ hθ₁_et p₁ hp₁_prime hϖ₁_mem
    let ϖ₁ : B₁ := θ₁ Polynomial.X
    let I_ϖ : Ideal B₁ := Ideal.span {ϖ₁}
    have hI_le_p₁ : I_ϖ ≤ p₁ := (Ideal.span_singleton_le_iff_mem p₁).mpr hϖ₁_mem
    let Q := B₁ ⧸ I_ϖ
    let mkQ : B₁ →+* Q := Ideal.Quotient.mk I_ϖ
    letI : Algebra P B₁ := θ₁.toAlgebra
    haveI : Algebra.Etale P B₁ := RingHom.etale_algebraMap.mp hθ₁_et
    letI : Algebra P k := (Polynomial.evalRingHom 0).toAlgebra
    haveI : Algebra.Etale k (TensorProduct P k B₁) := Algebra.Etale.baseChange P B₁ k
    let e_ring : TensorProduct P k B₁ ≃+* Q := by
      have hf_left_comm : ∀ p : P,
          mkQ (θ₁ (Polynomial.C (Polynomial.eval 0 p))) = algebraMap P Q p := by
        intro p
        change mkQ (θ₁ (Polynomial.C (Polynomial.eval 0 p))) = mkQ (θ₁ p)
        have hroot : Polynomial.IsRoot (p - Polynomial.C (Polynomial.eval 0 p)) 0 := by
          rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_C, sub_self]
        obtain ⟨r_p, hr_p⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
        rw [map_zero, sub_zero] at hr_p
        apply Ideal.Quotient.eq.mpr
        have hdiff : θ₁ (Polynomial.C (Polynomial.eval 0 p)) - θ₁ p =
            -(ϖ₁ * θ₁ r_p) := by
          have h1 := congrArg θ₁ hr_p
          rw [map_sub, map_mul] at h1
          dsimp [ϖ₁]
          linear_combination -h1
        rw [hdiff]
        exact I_ϖ.neg_mem (Ideal.mul_mem_right (θ₁ r_p) I_ϖ (Ideal.mem_span_singleton_self ϖ₁))
      let f_left : k →ₐ[P] Q :=
        { toRingHom := mkQ.comp (θ₁.comp Polynomial.C)
          commutes' := hf_left_comm }
      let f_right : B₁ →ₐ[P] Q := Ideal.Quotient.mkₐ P I_ϖ
      let fwd_alg : TensorProduct P k B₁ →ₐ[P] Q :=
        Algebra.TensorProduct.lift f_left f_right (fun _ _ => mul_comm _ _)
      let fwd : TensorProduct P k B₁ →+* Q := fwd_alg.toRingHom
      let incR : B₁ →+* TensorProduct P k B₁ :=
        (Algebra.TensorProduct.includeRight (R := P) (A := k) (B := B₁)).toRingHom
      have hker_incR : I_ϖ ≤ RingHom.ker incR := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        have hinc : incR ϖ₁ = (1 : k) ⊗ₜ[P] ϖ₁ := rfl
        have hϖ_smul : ϖ₁ = (Polynomial.X : P) • (1 : B₁) := by
          change ϖ₁ = θ₁ Polynomial.X * 1
          rw [mul_one]
        rw [hinc, hϖ_smul, ← TensorProduct.smul_tmul]
        have hX0 : (Polynomial.X : P) • (1 : k) = 0 := by
          change (Polynomial.eval 0 Polynomial.X) * (1 : k) = 0
          simp
        rw [hX0, TensorProduct.zero_tmul]
      let bwd : Q →+* TensorProduct P k B₁ := Ideal.Quotient.lift I_ϖ incR hker_incR
      have h_fb : ∀ q : Q, fwd (bwd q) = q := by
        intro q
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective q
        have hbwd : bwd (mkQ b) = (1 : k) ⊗ₜ[P] b := rfl
        change fwd (bwd (mkQ b)) = mkQ b
        rw [hbwd]
        change f_left 1 * f_right b = mkQ b
        rw [map_one, one_mul]
        rfl
      have h_bf : ∀ t : TensorProduct P k B₁, bwd (fwd t) = t := by
        intro t
        refine TensorProduct.inductionOn t ?_ ?_
        · intro c b
          have hfwd : fwd (c ⊗ₜ[P] b) = mkQ (θ₁ (Polynomial.C c)) * mkQ b := rfl
          rw [hfwd, map_mul]
          have hb1 : bwd (mkQ (θ₁ (Polynomial.C c))) = (1 : k) ⊗ₜ[P] (θ₁ (Polynomial.C c)) := rfl
          have hb2 : bwd (mkQ b) = (1 : k) ⊗ₜ[P] b := rfl
          rw [hb1, hb2]
          have hC_smul : θ₁ (Polynomial.C c) = (Polynomial.C c : P) • (1 : B₁) := by
            change θ₁ (Polynomial.C c) = θ₁ (Polynomial.C c) * 1
            rw [mul_one]
          rw [hC_smul, ← TensorProduct.smul_tmul]
          have hCc : (Polynomial.C c : P) • (1 : k) = c := by
            change (Polynomial.eval 0 (Polynomial.C c)) * (1 : k) = c
            simp
          rw [hCc, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        · intro x y ihx ihy
          rw [map_add, map_add, ihx, ihy]
      exact
        { toFun := fwd
          invFun := bwd
          left_inv := h_bf
          right_inv := h_fb
          map_mul' := fwd.map_mul'
          map_add' := fwd.map_add' }
    letI : Algebra k Q := (e_ring.toRingHom.comp (algebraMap k (TensorProduct P k B₁))).toAlgebra
    have hAlgQ_apply : ∀ c : k, algebraMap k Q c = mkQ (θ₁ (Polynomial.C c)) := by
      intro c
      change e_ring ((algebraMap k (TensorProduct P k B₁)) c) = mkQ (θ₁ (Polynomial.C c))
      change mkQ (θ₁ (Polynomial.C c)) * mkQ 1 = mkQ (θ₁ (Polynomial.C c))
      rw [map_one, mul_one]
    have hQ_et_hom : (algebraMap k Q).Etale :=
      RingHom.Etale.stableUnderComposition
        (algebraMap k (TensorProduct P k B₁)) e_ring.toRingHom
        (RingHom.etale_algebraMap.mpr inferInstance)
        (RingHom.Etale.of_bijective (f := e_ring.toRingHom) e_ring.bijective)
    haveI : Algebra.Etale k Q := RingHom.etale_algebraMap.mp hQ_et_hom
    obtain ⟨I_idx, hFin_I, L_fib, hField_L, hAlg_L, Θ, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k Q).mp inferInstance
    letI : Finite I_idx := hFin_I
    letI : Fintype I_idx := Fintype.ofFinite I_idx
    letI : ∀ a, Field (L_fib a) := hField_L
    letI : ∀ a, Algebra k (L_fib a) := hAlg_L
    let liftIdem : I_idx → B₁ :=
      fun a => Classical.choose (Ideal.Quotient.mk_surjective (Θ.symm (Pi.single a 1)))
    have hliftIdem : ∀ a : I_idx, mkQ (liftIdem a) = Θ.symm (Pi.single a 1) :=
      fun a => Classical.choose_spec (Ideal.Quotient.mk_surjective (Θ.symm (Pi.single a 1)))
    have hex_a₀ : ∃ a₀ : I_idx, liftIdem a₀ ∉ p₁ := by
      by_contra! hall
      have hsum1_prod : (1 : ∀ a : I_idx, L_fib a) = ∑ a : I_idx, Pi.single a 1 := by
        ext j; simp [Finset.sum_apply]
      have hsum1_Q : mkQ (∑ a : I_idx, liftIdem a) = 1 := by
        rw [map_sum]
        simp_rw [hliftIdem]
        rw [← map_sum, ← hsum1_prod, map_one]
      have hdiff_I : (1 : B₁) - ∑ a : I_idx, liftIdem a ∈ I_ϖ :=
        Ideal.Quotient.eq.mp (by rw [map_one, hsum1_Q])
      have hmem1 : (1 : B₁) ∈ p₁ := by
        have hsum_p₁ : (∑ a : I_idx, liftIdem a) ∈ p₁ :=
          Ideal.sum_mem p₁ (fun a (_ : a ∈ (Finset.univ : Finset I_idx)) => hall a)
        have h1 := p₁.add_mem (hI_le_p₁ hdiff_I) hsum_p₁
        simpa only [sub_add_cancel] using h1
      exact hp₁_prime.ne_top ((Ideal.eq_top_iff_one p₁).mpr hmem1)
    obtain ⟨a₀, ha₀_not_p₁⟩ := hex_a₀
    haveI : Module.Finite k (L_fib a₀) := (hFinSep a₀).1
    haveI : Algebra.IsIntegral k (L_fib a₀) := Algebra.IsIntegral.of_finite k (L_fib a₀)
    have hbij_La₀ : Function.Bijective (algebraMap k (L_fib a₀)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    refine ⟨liftIdem a₀, ha₀_not_p₁, fun b hb => ?_⟩
    obtain ⟨c, hc⟩ := hbij_La₀.2 (Θ (mkQ b) a₀)
    have hprod_Q : mkQ (liftIdem a₀ * (b - θ₁ (Polynomial.C c))) = 0 := by
      apply Θ.injective
      rw [map_zero, map_mul, map_sub, hliftIdem a₀, map_mul, Θ.apply_symm_apply, map_sub]
      have hCc_Q : Θ (mkQ (θ₁ (Polynomial.C c))) = algebraMap k (∀ a, L_fib a) c := by
        rw [← hAlgQ_apply c]
        exact Θ.commutes c
      rw [hCc_Q]
      ext j
      by_cases hj : j = a₀
      · subst hj
        change (Pi.single j (1 : L_fib j) j) * (Θ (mkQ b) j - algebraMap k (L_fib j) c) = 0
        rw [Pi.single_eq_same, hc, sub_self, mul_zero]
      · change (Pi.single a₀ (1 : L_fib a₀) j) * _ = 0
        rw [Pi.single_eq_of_ne hj, zero_mul]
    have hprod_p₁ : liftIdem a₀ * (b - θ₁ (Polynomial.C c)) ∈ p₁ :=
      hI_le_p₁ (Ideal.Quotient.eq_zero_iff_mem.mp hprod_Q)
    have hsub_p₁ : b - θ₁ (Polynomial.C c) ∈ p₁ :=
      (hp₁_prime.mem_or_mem hprod_p₁).resolve_left ha₀_not_p₁
    have hc_p₁ : θ₁ (Polynomial.C c) ∈ p₁ := by
      have h1 := p₁.sub_mem hb hsub_p₁
      simpa only [sub_sub_cancel] using h1
    have hc0 : c = 0 := by
      by_contra hc_ne
      have hu_c : IsUnit (θ₁ (Polynomial.C c)) :=
        ((Ne.isUnit hc_ne).map Polynomial.C).map θ₁
      exact hp₁_prime.ne_top (Ideal.eq_top_of_isUnit_mem p₁ hc_p₁ hu_c)
    rw [hc0, map_zero, map_zero, sub_zero] at hprod_Q
    exact Ideal.Quotient.eq_zero_iff_mem.mp hprod_Q

  
  have hNormCurve : ∀ (A₀_t : Type u) [CommRing A₀_t] [IsDomain A₀_t]
      [Algebra k A₀_t] [Algebra P A₀_t] [Algebra.FiniteType k A₀_t]
      (j_A₀ : A₀_t →+* ↥B_bar),
      Function.Injective j_A₀ →
      j_A₀.comp (algebraMap P A₀_t) = algebraMap P ↥B_bar →
      (∀ c : k, algebraMap k A₀_t c = algebraMap P A₀_t (Polynomial.C c)) →
      ∃ (B_t : Type u) (_ : CommRing B_t) (_ : IsDomain B_t) (_ : IsIntegrallyClosed B_t)
        (_ : Algebra k B_t) (_ : Algebra.FiniteType k B_t)
        (p_Bt : P →+* B_t) (i_A₀ : A₀_t →+* B_t) (j_Bt : B_t →+* ↥B_bar),
        Function.Injective j_Bt ∧
        j_Bt.comp i_A₀ = j_A₀ ∧
        j_Bt.comp p_Bt = algebraMap P ↥B_bar ∧
        (∀ c : k, algebraMap k B_t c = p_Bt (Polynomial.C c)) ∧
        ringKrullDim B_t = ((1 : ℕ) : WithBot ℕ∞) ∧
        (Ideal.comap j_Bt M_max).height ≤ 1 := by
    clear * - hM hinj_P_Bbar hNonzeroConstOfEvalZero
    intro A₀_t _ _ _ _ _ j_A₀ hj_A₀_inj hj_A₀_P h_kP_A₀
    let K_A := FractionRing A₀_t
    obtain ⟨hFin_Bt, hIC_Bt⟩ :=
      weil_algClosed_finiteType_domain_integralClosure_finite k A₀_t K_A
    let B_sub := integralClosure A₀_t K_A
    haveI : Module.Finite A₀_t ↥B_sub := hFin_Bt
    haveI : IsIntegrallyClosed ↥B_sub := hIC_Bt
    have hA₀_units : ∀ y : ↥(nonZeroDivisors A₀_t), IsUnit ((B_bar.val.toRingHom.comp j_A₀) y.1) := by
      intro y
      apply Ne.isUnit
      intro h0
      have hy_ne : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have h1 : j_A₀ y.1 = 0 := Subtype.ext h0
      exact hy_ne (hj_A₀_inj (h1.trans (map_zero j_A₀).symm))
    let ι_KA : K_A →+* Ω :=
      IsLocalization.lift (M := nonZeroDivisors A₀_t) (S := K_A) hA₀_units
    have hι_KA_eq : ∀ a : A₀_t, ι_KA (algebraMap A₀_t K_A a) = (j_A₀ a).1 :=
      IsLocalization.lift_eq (M := nonZeroDivisors A₀_t) (S := K_A) hA₀_units
    have hBt_in_Bbar : ∀ b : ↥B_sub, ι_KA b.1 ∈ B_bar := by
      intro b
      obtain ⟨q, hq_mon, hq_ev⟩ := b.2
      let q_Bbar : Polynomial ↥B_bar := q.map j_A₀
      have hqB_mon : q_Bbar.Monic := hq_mon.map j_A₀
      have hqB_ev : Polynomial.aeval (ι_KA b.1) q_Bbar = 0 := by
        rw [Polynomial.aeval_def]
        dsimp [q_Bbar]
        rw [Polynomial.eval₂_map]
        have hcomp_eq : (algebraMap ↥B_bar Ω).comp j_A₀ = ι_KA.comp (algebraMap A₀_t K_A) :=
          RingHom.ext (fun a => (hι_KA_eq a).symm)
        change Polynomial.eval₂ ((algebraMap ↥B_bar Ω).comp j_A₀) (ι_KA b.1) q = 0
        rw [hcomp_eq, ← Polynomial.hom_eval₂, hq_ev, map_zero]
      exact _root_.isIntegral_trans (R := P) (A := ↥B_bar) (B := Ω)
        (x := ι_KA b.1) ⟨q_Bbar, hqB_mon, hqB_ev⟩
    let j_Bt : ↥B_sub →+* ↥B_bar :=
      { toFun := fun b => ⟨ι_KA b.1, hBt_in_Bbar b⟩
        map_one' := Subtype.ext (by change ι_KA 1 = 1; exact map_one ι_KA)
        map_mul' := fun x y => Subtype.ext (map_mul ι_KA x.1 y.1)
        map_zero' := Subtype.ext (by change ι_KA 0 = 0; exact map_zero ι_KA)
        map_add' := fun x y => Subtype.ext (map_add ι_KA x.1 y.1) }
    have hj_Bt_inj : Function.Injective j_Bt := by
      intro x y hxy
      apply Subtype.ext
      exact (RingHom.injective ι_KA) (congrArg Subtype.val hxy)
    let i_A₀ : A₀_t →+* ↥B_sub := algebraMap A₀_t ↥B_sub
    have hj_Bt_A₀ : j_Bt.comp i_A₀ = j_A₀ := by
      apply RingHom.ext
      intro a
      apply Subtype.ext
      exact hι_KA_eq a
    let p_Bt : P →+* ↥B_sub := i_A₀.comp (algebraMap P A₀_t)
    have hj_Bt_P : j_Bt.comp p_Bt = algebraMap P ↥B_bar := by
      rw [← RingHom.comp_assoc, hj_Bt_A₀, hj_A₀_P]
    have hinj_P_Bt : Function.Injective p_Bt := by
      intro p q hpq
      apply hinj_P_Bbar
      rw [← hj_Bt_P]
      exact congrArg j_Bt hpq
    have hp_Bt_int : p_Bt.IsIntegral := by
      intro b
      obtain ⟨G, hG_mon, hG_ev⟩ := (j_Bt b).2
      refine ⟨G, hG_mon, ?_⟩
      apply hj_Bt_inj
      rw [map_zero, Polynomial.hom_eval₂, hj_Bt_P]
      apply Subtype.ext
      have h1 := Polynomial.hom_eval₂ G (algebraMap P ↥B_bar) B_bar.val.toRingHom (j_Bt b)
      change B_bar.val.toRingHom (Polynomial.eval₂ (algebraMap P ↥B_bar) (j_Bt b) G) = 0
      rw [h1]
      exact hG_ev
    let p_L : Ideal ↥B_sub := Ideal.comap j_Bt M_max
    have hpL_prime : p_L.IsPrime := Ideal.IsPrime.comap j_Bt
    have hpL_comap : Ideal.comap p_Bt p_L = Ideal.span {Polynomial.X} := by
      ext p
      change j_Bt (p_Bt p) ∈ M_max ↔ p ∈ Ideal.span {Polynomial.X}
      rw [← RingHom.comp_apply, hj_Bt_P, ← Ideal.mem_comap, hM]
    have hKrull1 : Ring.KrullDimLE 1 ↥B_sub := by
      refine Ring.KrullDimLE.mk₁' ?_
      intro I hI_ne hI_prime
      letI : I.IsPrime := hI_prime
      obtain ⟨x, hx_I, hx_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI_ne
      obtain ⟨H, hH_mon, hH_ev⟩ := hp_Bt_int x
      obtain ⟨a₀, b, ha₀_ne, hab⟩ :=
        hNonzeroConstOfEvalZero H hH_mon.ne_zero p_Bt x hx_ne hH_ev
      have ha₀_mem : a₀ ∈ Ideal.comap p_Bt I := by
        change p_Bt a₀ ∈ I
        have heq : p_Bt a₀ = -(x * b) := eq_neg_of_add_eq_zero_left hab
        rw [heq]
        exact I.neg_mem (I.mul_mem_right b hx_I)
      have hcomap_ne : Ideal.comap p_Bt I ≠ ⊥ := by
        intro hbot
        rw [hbot, Ideal.mem_bot] at ha₀_mem
        exact ha₀_ne ha₀_mem
      have hcomap_max : (Ideal.comap p_Bt I).IsMaximal :=
        IsPrime.to_maximal_ideal hcomap_ne
      exact Ideal.isMaximal_of_isIntegral_of_isMaximal_comap p_Bt hp_Bt_int I hcomap_max
    have hDim_Bt : ringKrullDim ↥B_sub = ((1 : ℕ) : WithBot ℕ∞) := by
      have hle1 : ringKrullDim ↥B_sub ≤ ((1 : ℕ) : WithBot ℕ∞) :=
        Ring.krullDimLE_iff.mp hKrull1
      have hge0 : (0 : WithBot ℕ∞) ≤ ringKrullDim ↥B_sub :=
        ringKrullDim_nonneg_of_nontrivial
      have hnot_le0 : ¬ ringKrullDim ↥B_sub ≤ ((0 : ℕ) : WithBot ℕ∞) := by
        intro hle0
        haveI : Ring.KrullDimLE 0 ↥B_sub := Ring.krullDimLE_iff.mpr hle0
        have hField : IsField ↥B_sub := Ring.KrullDimLE.isField_of_isDomain
        have hx_ne : p_Bt Polynomial.X ≠ 0 := fun h0 =>
          Polynomial.X_ne_zero (hinj_P_Bt (h0.trans (map_zero _).symm))
        obtain ⟨inv_x, hinv_x⟩ := hField.mul_inv_cancel hx_ne
        have hu_x : IsUnit (p_Bt Polynomial.X) :=
          ⟨⟨p_Bt Polynomial.X, inv_x, hinv_x, mul_comm (p_Bt Polynomial.X) inv_x ▸ hinv_x⟩, rfl⟩
        have hx_pL : p_Bt Polynomial.X ∈ p_L := by
          change Polynomial.X ∈ Ideal.comap p_Bt p_L
          rw [hpL_comap]
          exact Ideal.mem_span_singleton_self Polynomial.X
        exact hpL_prime.ne_top (Ideal.eq_top_of_isUnit_mem p_L hx_pL hu_x)
      generalize hd : ringKrullDim ↥B_sub = d at hge0 hnot_le0 hle1
      induction d using WithBot.recBotCoe with
      | bot => exact absurd hge0 (WithBot.not_coe_le_bot 0)
      | coe a =>
        induction a using ENat.recTopCoe with
        | top =>
          have htop : (⊤ : ℕ∞) ≤ 1 := WithBot.coe_le_coe.mp hle1
          exact absurd (top_le_iff.mp htop) ENat.one_ne_top
        | coe n =>
          rcases n with _ | _ | n'
          · exact absurd (le_refl _) hnot_le0
          · rfl
          · have hle_nat : n' + 2 ≤ 1 := ENat.natCast_le_natCast.mp (WithBot.coe_le_coe.mp hle1)
            omega
    have hp_L_ht : p_L.height ≤ 1 := by
      have h1 := Ideal.height_le_ringKrullDim_of_ne_top hpL_prime.ne_top
      rw [hDim_Bt] at h1
      exact WithBot.coe_le_coe.mp h1
    have hFT_A₀_Bt : Algebra.FiniteType A₀_t ↥B_sub := Module.Finite.finiteType (R := A₀_t) ↥B_sub
    have hFT_k_Bt : Algebra.FiniteType k ↥B_sub :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k A₀_t) hFT_A₀_Bt
    refine ⟨↥B_sub, inferInstance, inferInstance, inferInstance, inferInstance, hFT_k_Bt,
      p_Bt, i_A₀, j_Bt, hj_Bt_inj, hj_Bt_A₀, hj_Bt_P, ?_, hDim_Bt, hp_L_ht⟩
    intro c
    rw [IsScalarTower.algebraMap_apply k A₀_t ↥B_sub c, h_kP_A₀ c]
    rfl

  
  let IsGoodStage : Subalgebra P R_bar → Prop := fun B =>
    ∃ (ϖ : ↑(CommRingCat.of ↥B)) (u : (↑(CommRingCat.of ↥B))ˣ) (e : ℕ)
      (ψ_cat : CommRingCat.of P ⟶ CommRingCat.of ↥B),
      1 ≤ e ∧
      B.val ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
      (pHom B).hom Polynomial.X = ↑u * ϖ ^ e ∧
      ψ_cat.hom.comp Polynomial.C = (pHom B).hom.comp Polynomial.C ∧
      ψ_cat.hom Polynomial.X = ϖ ∧
      ψ_cat.hom.Etale

  have hGoodFin : ∀ F : Finset R_bar,
      ∃ B : Subalgebra P R_bar,
        (F : Set R_bar) ⊆ (B : Set R_bar) ∧ IsGoodStage B := by
    intro F
    let pair : R_bar → ↥B_bar × ↥M_max.primeCompl :=
      fun w => Classical.choose (IsLocalization.surj M_max.primeCompl w)
    have hpair : ∀ w : R_bar,
        w * algebraMap ↥B_bar R_bar (pair w).2.1 = algebraMap ↥B_bar R_bar (pair w).1 :=
      fun w => Classical.choose_spec (IsLocalization.surj M_max.primeCompl w)
    let S₀ : Finset Ω := F.image (fun w => (pair w).1.1) ∪ F.image (fun w => (pair w).2.1.1)
    have hS₀_Bbar : (S₀ : Set Ω) ⊆ (B_bar : Set Ω) := by
      intro x hx
      rcases Finset.mem_union.mp hx with hx₁ | hx₂
      · obtain ⟨w, _, rfl⟩ := Finset.mem_image.mp hx₁
        exact (pair w).1.2
      · obtain ⟨w, _, rfl⟩ := Finset.mem_image.mp hx₂
        exact (pair w).2.1.2
    let A₀ : Subalgebra P Ω := Algebra.adjoin P (S₀ : Set Ω)
    have hA₀_le : A₀ ≤ B_bar := Algebra.adjoin_le hS₀_Bbar
    have hFT_P_A₀ : Algebra.FiniteType P ↥A₀ :=
      Algebra.FiniteType.adjoin_of_finite (Finset.finite_toSet S₀)
    have hFT_k_A₀ : Algebra.FiniteType k ↥A₀ :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k P) hFT_P_A₀
    haveI : Algebra.FiniteType k ↥A₀ := hFT_k_A₀
    let j_A₀ : ↥A₀ →+* ↥B_bar :=
      { toFun := fun a => ⟨a.1, hA₀_le a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have hj_A₀_inj : Function.Injective j_A₀ := fun x y hxy =>
      Subtype.ext (congrArg (Subtype.val : ↥B_bar → Ω) hxy)
    have hj_A₀_P : j_A₀.comp (algebraMap P ↥A₀) = algebraMap P ↥B_bar := by
      apply RingHom.ext; intro p; rfl
    have hkP_A₀ : ∀ c : k, algebraMap k ↥A₀ c = algebraMap P ↥A₀ (Polynomial.C c) := by
      intro c; apply Subtype.ext; exact IsScalarTower.algebraMap_apply k P Ω c

    obtain ⟨B_t, _, _, _, _, _, p_Bt, i_A₀, j_Bt, hj_Bt_inj, hj_Bt_A₀, hj_Bt_P, hkP_Bt,
      hDim_Bt, hp_L_ht⟩ := hNormCurve ↥A₀ j_A₀ hj_A₀_inj hj_A₀_P hkP_A₀
    let p_L : Ideal B_t := Ideal.comap j_Bt M_max
    have hpL_prime : p_L.IsPrime := Ideal.IsPrime.comap j_Bt
    letI : p_L.IsPrime := hpL_prime

    obtain ⟨f₁, hf₁_not_pL, hSm_B₁⟩ :=
      weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k 1 B_t
        hDim_Bt p_L hp_L_ht
    let B₁ := Localization.Away f₁
    have hf₁_ne : f₁ ≠ 0 := fun h0 => hf₁_not_pL (h0 ▸ p_L.zero_mem)
    have hDom_B₁ : IsDomain B₁ :=
      IsLocalization.isDomain_of_le_nonZeroDivisors B₁
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hf₁_ne))
    letI : IsDomain B₁ := hDom_B₁

    let g_Bt : B_t →+* R_bar := (algebraMap ↥B_bar R_bar).comp j_Bt
    have hf₁_not_M : j_Bt f₁ ∉ M_max := hf₁_not_pL
    have hf₁_units : ∀ y : ↥(Submonoid.powers f₁), IsUnit (g_Bt y.1) := by
      rintro ⟨_, n, rfl⟩
      rw [map_pow]
      exact (IsLocalization.map_units R_bar (⟨j_Bt f₁, hf₁_not_M⟩ : ↥M_max.primeCompl)).pow n
    let ρ₁ : B₁ →+* R_bar :=
      IsLocalization.lift (M := Submonoid.powers f₁) (S := B₁) (g := g_Bt) hf₁_units
    have hρ₁_Bt : ∀ b : B_t, ρ₁ (algebraMap B_t B₁ b) = g_Bt b :=
      IsLocalization.lift_eq (M := Submonoid.powers f₁) (S := B₁) hf₁_units
    have hρ₁_inj : Function.Injective ρ₁ := by
      rw [injective_iff_map_eq_zero]
      intro z hz0
      obtain ⟨⟨b, s⟩, hsx⟩ := IsLocalization.surj (Submonoid.powers f₁) z
      dsimp only at hsx
      have h1 := congrArg (fun x => φ_R_Ω (ρ₁ x)) hsx
      rw [map_mul, hz0, zero_mul, map_zero, hρ₁_Bt] at h1
      change 0 = φ_R_Ω (algebraMap ↥B_bar R_bar (j_Bt b)) at h1
      rw [hφ_B] at h1
      have hb0 : b = 0 := hj_Bt_inj (Subtype.ext (by rw [map_zero]; exact h1.symm))
      rw [hb0, map_zero] at hsx
      exact (IsLocalization.map_units B₁ s).mul_left_eq_zero.mp hsx

    let p₁ : Ideal B₁ := Ideal.comap ρ₁ (IsLocalRing.maximalIdeal R_bar)
    have hp₁_prime : p₁.IsPrime := Ideal.IsPrime.comap ρ₁
    letI : p₁.IsPrime := hp₁_prime
    haveI : Algebra.IsStandardSmoothOfRelativeDimension 1 k B₁ := hSm_B₁
    obtain ⟨γ_alg, hγ_et⟩ :=
      Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial 1 k B₁
    let γ_mv : MvPolynomial (Fin 1) k →+* B₁ := γ_alg.toRingHom
    have hγ_C : γ_mv.comp MvPolynomial.C = algebraMap k B₁ := γ_alg.comp_algebraMap
    let e_mv : MvPolynomial (Fin 1) k ≃ₐ[k] P := MvPolynomial.uniqueAlgEquiv k (Fin 1)
    let θ₀ : P →+* B₁ := γ_mv.comp e_mv.symm.toRingHom
    have hθ₀_et : θ₀.Etale :=
      RingHom.Etale.stableUnderComposition e_mv.symm.toRingHom γ_mv
        (RingHom.Etale.of_bijective (f := e_mv.symm.toRingHom) e_mv.symm.bijective) hγ_et
    have hθ₀_C : θ₀.comp Polynomial.C = algebraMap k B₁ := by
      apply RingHom.ext
      intro c
      have hc : e_mv.symm (Polynomial.C c) = MvPolynomial.C c := e_mv.symm.commutes c
      change γ_mv (e_mv.symm (Polynomial.C c)) = algebraMap k B₁ c
      rw [hc]
      exact RingHom.congr_fun hγ_C c
    have hρ₁_alg_k : ∀ c : k, ρ₁ (algebraMap k B₁ c) = algebraMap P R_bar (Polynomial.C c) := by
      intro c
      have h1 : algebraMap k B₁ c = algebraMap B_t B₁ (algebraMap k B_t c) :=
        IsScalarTower.algebraMap_apply k B_t B₁ c
      rw [h1, hρ₁_Bt, hkP_Bt c]
      have h2 : j_Bt (p_Bt (Polynomial.C c)) = algebraMap P ↥B_bar (Polynomial.C c) :=
        RingHom.congr_fun hj_Bt_P (Polynomial.C c)
      change algebraMap ↥B_bar R_bar (j_Bt (p_Bt (Polynomial.C c))) = _
      rw [h2, ← IsScalarTower.algebraMap_apply P ↥B_bar R_bar]

    let c₀ : k := ε_bar (ρ₁ (θ₀ Polynomial.X))
    let sh_neg : P →+* P := Polynomial.eval₂RingHom Polynomial.C (Polynomial.X - Polynomial.C c₀)
    let sh_pos : P →+* P := Polynomial.eval₂RingHom Polynomial.C (Polynomial.X + Polynomial.C c₀)
    have hsh_bij : Function.Bijective sh_neg := by
      have h1 : Function.LeftInverse sh_pos sh_neg := by
        intro p
        change (sh_pos.comp sh_neg) p = RingHom.id P p
        congr 1
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext; intro c
          change sh_pos (sh_neg (Polynomial.C c)) = Polynomial.C c
          dsimp [sh_pos, sh_neg]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.coe_eval₂RingHom,
            Polynomial.eval₂_C, Polynomial.eval₂_C]
        · change sh_pos (sh_neg Polynomial.X) = Polynomial.X
          dsimp [sh_pos, sh_neg]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.coe_eval₂RingHom,
            Polynomial.eval₂_X, Polynomial.eval₂_sub, Polynomial.eval₂_X,
            Polynomial.eval₂_C, add_sub_cancel_right]
      have h2 : Function.RightInverse sh_pos sh_neg := by
        intro p
        change (sh_neg.comp sh_pos) p = RingHom.id P p
        congr 1
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext; intro c
          change sh_neg (sh_pos (Polynomial.C c)) = Polynomial.C c
          dsimp [sh_pos, sh_neg]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.coe_eval₂RingHom,
            Polynomial.eval₂_C, Polynomial.eval₂_C]
        · change sh_neg (sh_pos Polynomial.X) = Polynomial.X
          dsimp [sh_pos, sh_neg]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.coe_eval₂RingHom,
            Polynomial.eval₂_X, Polynomial.eval₂_add, Polynomial.eval₂_X,
            Polynomial.eval₂_C, sub_add_cancel]
      exact ⟨h1.injective, h2.surjective⟩
    let θ₁ : P →+* B₁ := θ₀.comp sh_neg
    have hθ₁_et : θ₁.Etale :=
      RingHom.Etale.stableUnderComposition sh_neg θ₀
        (RingHom.Etale.of_bijective (f := sh_neg) hsh_bij) hθ₀_et
    have hθ₁_C : θ₁.comp Polynomial.C = algebraMap k B₁ := by
      apply RingHom.ext
      intro c
      change θ₀ (sh_neg (Polynomial.C c)) = algebraMap k B₁ c
      have hs : sh_neg (Polynomial.C c) = Polynomial.C c := by
        dsimp [sh_neg]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      rw [hs]
      exact RingHom.congr_fun hθ₀_C c
    let ϖ₁ : B₁ := θ₁ Polynomial.X
    have hϖ₁_mem : ϖ₁ ∈ p₁ := by
      change ρ₁ ϖ₁ ∈ IsLocalRing.maximalIdeal R_bar
      rw [← hε_ker, RingHom.mem_ker]
      have hshX : sh_neg Polynomial.X = Polynomial.X - Polynomial.C c₀ := by
        dsimp [sh_neg]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      dsimp [ϖ₁, θ₁]
      rw [hshX, map_sub, map_sub, map_sub]
      have hc₀_val : ε_bar (ρ₁ (θ₀ (Polynomial.C c₀))) = c₀ := by
        have h1 : θ₀ (Polynomial.C c₀) = algebraMap k B₁ c₀ := RingHom.congr_fun hθ₀_C c₀
        rw [h1, hρ₁_alg_k c₀]
        exact RingHom.congr_fun hε_C c₀
      rw [hc₀_val]
      exact sub_self c₀

    obtain ⟨f₂, hf₂_not_p₁, hf₂_mul⟩ := hIsolateFiber B₁ θ₁ hθ₁_et p₁ hϖ₁_mem
    have hu_f₂ : IsUnit (ρ₁ f₂) := IsLocalRing.notMem_maximalIdeal.mp hf₂_not_p₁

    let a_Bt : ↥F → B_t := fun w =>
      i_A₀ ⟨(pair w.1).1.1, Algebra.subset_adjoin
        (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem _ w.2)))⟩
    let s_Bt : ↥F → B_t := fun w =>
      i_A₀ ⟨(pair w.1).2.1.1, Algebra.subset_adjoin
        (Finset.mem_coe.mpr (Finset.mem_union_right _ (Finset.mem_image_of_mem _ w.2)))⟩
    let s_B₁ : ↥F → B₁ := fun w => algebraMap B_t B₁ (s_Bt w)
    let s_prod : B₁ := ∏ w : ↥F, s_B₁ w
    have hρ₁_sB₁ : ∀ w : ↥F, ρ₁ (s_B₁ w) = algebraMap ↥B_bar R_bar (pair w.1).2.1 := by
      intro w
      dsimp [s_B₁, s_Bt]
      rw [hρ₁_Bt]
      change algebraMap ↥B_bar R_bar ((j_Bt.comp i_A₀) _) = _
      rw [hj_Bt_A₀]
      rfl
    have hρ₁_aBt : ∀ w : ↥F,
        ρ₁ (algebraMap B_t B₁ (a_Bt w)) = algebraMap ↥B_bar R_bar (pair w.1).1 := by
      intro w
      dsimp [a_Bt]
      rw [hρ₁_Bt]
      change algebraMap ↥B_bar R_bar ((j_Bt.comp i_A₀) _) = _
      rw [hj_Bt_A₀]
      rfl
    have hu_sprod : IsUnit (ρ₁ s_prod) := by
      dsimp [s_prod]
      rw [map_prod]
      exact Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one
        (fun w _ => by rw [hρ₁_sB₁ w]; exact IsLocalization.map_units R_bar (pair w.1).2)

    
    have hFinishGood : ∀ (B₁_t : Type u) [CommRing B₁_t] [IsDomain B₁_t]
        (p_B₁ : P →+* B₁_t) (θ₁_t : P →+* B₁_t) (ρ₁_t : B₁_t →+* R_bar)
        (g₂_t f₂_t : B₁_t),
        Function.Injective ρ₁_t →
        ρ₁_t.comp p_B₁ = algebraMap P R_bar →
        (∀ c : k, ρ₁_t (θ₁_t (Polynomial.C c)) = algebraMap P R_bar (Polynomial.C c)) →
        θ₁_t.Etale →
        ρ₁_t (θ₁_t Polynomial.X) ∈ IsLocalRing.maximalIdeal R_bar →
        (∀ b : B₁_t, ρ₁_t b ∈ IsLocalRing.maximalIdeal R_bar →
          f₂_t * b ∈ Ideal.span {θ₁_t Polynomial.X}) →
        f₂_t ∣ g₂_t →
        IsUnit (ρ₁_t g₂_t) →
        (∀ w ∈ F, ∃ a_w s_w : B₁_t, s_w ∣ g₂_t ∧ IsUnit (ρ₁_t s_w) ∧ w * ρ₁_t s_w = ρ₁_t a_w) →
        ∃ B : Subalgebra P R_bar,
          (F : Set R_bar) ⊆ (B : Set R_bar) ∧ IsGoodStage B := by
      clear * - ht_max ht_ne hRangeSubalg
      intro B₁_t _ _ p_B₁ θ₁_t ρ₁_t g₂_t f₂_t hρ₁_inj hρ₁_P hθ₁_C_R hθ₁_et hϖ₁_max
        hf₂_mul hf₂_dvd hu_g₂ hF_div
      have hg₂_ne : g₂_t ≠ 0 := fun h0 => hu_g₂.ne_zero (by rw [h0, map_zero])
      let B₂ := Localization.Away g₂_t
      have hDom_B₂ : IsDomain B₂ :=
        IsLocalization.isDomain_of_le_nonZeroDivisors B₂
          (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hg₂_ne))
      letI : IsDomain B₂ := hDom_B₂
      let θ₂ : P →+* B₂ := (algebraMap B₁_t B₂).comp θ₁_t
      have h_et_B₁B₂ : Algebra.Etale B₁_t B₂ :=
        @Algebra.Etale.of_isLocalizationAway B₁_t B₂ _ _ _ g₂_t _
      have hθ₂_et : θ₂.Etale :=
        RingHom.Etale.stableUnderComposition θ₁_t (algebraMap B₁_t B₂) hθ₁_et
          (RingHom.etale_algebraMap.mpr h_et_B₁B₂)
      have hNoeth_B₂ : IsNoetherianRing B₂ := by
        letI : Algebra P B₂ := θ₂.toAlgebra
        haveI : Algebra.Etale P B₂ := RingHom.etale_algebraMap.mp hθ₂_et
        haveI : Algebra.FinitePresentation P B₂ := Algebra.Etale.finitePresentation
        exact Algebra.FiniteType.isNoetherianRing P B₂
      letI : IsNoetherianRing B₂ := hNoeth_B₂

      have hg₂_units : ∀ y : ↥(Submonoid.powers g₂_t), IsUnit (ρ₁_t y.1) := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow]
        exact hu_g₂.pow n
      let ρ₂ : B₂ →+* R_bar :=
        IsLocalization.lift (M := Submonoid.powers g₂_t) (S := B₂) (g := ρ₁_t) hg₂_units
      have hρ₂_B₁ : ∀ b : B₁_t, ρ₂ (algebraMap B₁_t B₂ b) = ρ₁_t b :=
        IsLocalization.lift_eq (M := Submonoid.powers g₂_t) (S := B₂) hg₂_units
      have hρ₂_inj : Function.Injective ρ₂ := by
        rw [injective_iff_map_eq_zero]
        intro z hz0
        obtain ⟨⟨b, s⟩, hsx⟩ := IsLocalization.surj (Submonoid.powers g₂_t) z
        dsimp only at hsx
        have h1 := congrArg ρ₂ hsx
        rw [map_mul, hz0, zero_mul, hρ₂_B₁] at h1
        have hb0 : b = 0 := hρ₁_inj (h1.symm.trans (map_zero ρ₁_t).symm)
        rw [hb0, map_zero] at hsx
        exact (IsLocalization.map_units B₂ s).mul_left_eq_zero.mp hsx

      have hF_in_B₂ : ∀ w ∈ F, ∃ y : B₂, ρ₂ y = w := by
        intro w hw
        obtain ⟨a_w, s_w, hdvd_s, hu_sw_R, h_eq_w⟩ := hF_div w hw
        have hu_g₂_B₂ : IsUnit (algebraMap B₁_t B₂ g₂_t) :=
          IsLocalization.map_units B₂ (⟨g₂_t, 1, pow_one g₂_t⟩ : ↥(Submonoid.powers g₂_t))
        obtain ⟨u_sw, hu_sw_val⟩ : IsUnit (algebraMap B₁_t B₂ s_w) :=
          isUnit_of_dvd_unit (map_dvd (algebraMap B₁_t B₂) hdvd_s) hu_g₂_B₂
        refine ⟨algebraMap B₁_t B₂ a_w * ↑(u_sw⁻¹), ?_⟩
        apply hu_sw_R.mul_left_inj.mp
        calc
          ρ₂ (algebraMap B₁_t B₂ a_w * ↑(u_sw⁻¹)) * ρ₁_t s_w =
              ρ₂ (algebraMap B₁_t B₂ a_w * (↑(u_sw⁻¹) * ↑u_sw)) := by
            rw [← hρ₂_B₁ s_w, ← hu_sw_val, ← map_mul, mul_assoc]
          _ = ρ₁_t a_w := by rw [Units.inv_mul, mul_one, hρ₂_B₁]
          _ = w * ρ₁_t s_w := h_eq_w.symm

      let ϖ₂ : B₂ := θ₂ Polynomial.X
      let p₂ : Ideal B₂ := Ideal.comap ρ₂ (IsLocalRing.maximalIdeal R_bar)
      have hp₂_prime : p₂.IsPrime := Ideal.IsPrime.comap ρ₂
      have hϖ₂_mem : ϖ₂ ∈ p₂ := by
        change ρ₂ (algebraMap B₁_t B₂ (θ₁_t Polynomial.X)) ∈ IsLocalRing.maximalIdeal R_bar
        rw [hρ₂_B₁]
        exact hϖ₁_max
      have hp₂_span : p₂ = Ideal.span {ϖ₂} := by
        apply le_antisymm
        · intro z hz
          obtain ⟨⟨b, ⟨_, n, rfl⟩⟩, hsx⟩ := IsLocalization.surj (Submonoid.powers g₂_t) z
          dsimp only at hsx
          have hb_p₁ : ρ₁_t b ∈ IsLocalRing.maximalIdeal R_bar := by
            have h1 := congrArg ρ₂ hsx
            rw [map_mul, hρ₂_B₁, hρ₂_B₁] at h1
            rw [← h1]
            exact Ideal.mul_mem_right _ _ hz
          obtain ⟨q_b, hq_b⟩ := Ideal.mem_span_singleton.mp (hf₂_mul b hb_p₁)
          obtain ⟨u_f₂_B₂, hu_f₂_B₂⟩ : IsUnit (algebraMap B₁_t B₂ f₂_t) :=
            isUnit_of_dvd_unit (map_dvd (algebraMap B₁_t B₂) hf₂_dvd)
              (IsLocalization.map_units B₂ (⟨g₂_t, 1, pow_one g₂_t⟩ : ↥(Submonoid.powers g₂_t)))
          obtain ⟨u_g₂n, hu_g₂n⟩ : IsUnit (algebraMap B₁_t B₂ (g₂_t ^ n)) :=
            IsLocalization.map_units B₂ (⟨g₂_t ^ n, n, rfl⟩ : ↥(Submonoid.powers g₂_t))
          rw [Ideal.mem_span_singleton]
          refine ⟨algebraMap B₁_t B₂ q_b * ↑(u_f₂_B₂⁻¹) * ↑(u_g₂n⁻¹), ?_⟩
          apply mul_right_cancel₀ u_g₂n.ne_zero
          apply mul_right_cancel₀ u_f₂_B₂.ne_zero
          have hz_eq : z * ↑u_g₂n = algebraMap B₁_t B₂ b := by rwa [hu_g₂n]
          have h1 : (↑(u_g₂n⁻¹) : B₂) * ↑u_g₂n = 1 := Units.inv_mul u_g₂n
          have h2 : (↑(u_f₂_B₂⁻¹) : B₂) * ↑u_f₂_B₂ = 1 := Units.inv_mul u_f₂_B₂
          calc
            z * ↑u_g₂n * ↑u_f₂_B₂ = algebraMap B₁_t B₂ (f₂_t * b) := by
              rw [hz_eq, hu_f₂_B₂, ← map_mul, mul_comm]
            _ = ϖ₂ * algebraMap B₁_t B₂ q_b := by
              rw [hq_b, map_mul]; rfl
            _ = ϖ₂ * algebraMap B₁_t B₂ q_b * ((↑(u_f₂_B₂⁻¹) : B₂) * ↑u_f₂_B₂) *
                  ((↑(u_g₂n⁻¹) : B₂) * ↑u_g₂n) := by
              rw [h2, h1, mul_one, mul_one]
            _ = ϖ₂ * (algebraMap B₁_t B₂ q_b * ↑(u_f₂_B₂⁻¹) * ↑(u_g₂n⁻¹)) *
                  ↑u_g₂n * ↑u_f₂_B₂ := by ring
        · exact (Ideal.span_singleton_le_iff_mem p₂).mpr hϖ₂_mem

      let p_B₂ : P →+* B₂ := (algebraMap B₁_t B₂).comp p_B₁
      have hρ₂_P : ρ₂.comp p_B₂ = algebraMap P R_bar := by
        apply RingHom.ext
        intro p
        change ρ₂ (algebraMap B₁_t B₂ (p_B₁ p)) = algebraMap P R_bar p
        rw [hρ₂_B₁]
        exact RingHom.congr_fun hρ₁_P p
      let X₂ : B₂ := p_B₂ Polynomial.X
      have hρ₂_X₂ : ρ₂ X₂ = t_bar := RingHom.congr_fun hρ₂_P Polynomial.X
      have hX₂_ne : X₂ ≠ 0 := fun h0 => ht_ne (by rw [← hρ₂_X₂, h0, map_zero])
      have hX₂_p₂ : X₂ ∈ p₂ := by
        change ρ₂ X₂ ∈ IsLocalRing.maximalIdeal R_bar
        rw [hρ₂_X₂]
        exact ht_max
      have hϖ₂_dvd1 : ϖ₂ ^ 1 ∣ X₂ := by
        rw [pow_one, ← Ideal.mem_span_singleton, ← hp₂_span]
        exact hX₂_p₂
      have hex_ndvd : ∃ m : ℕ, ¬ (ϖ₂ ^ m ∣ X₂) := by
        by_contra! hall
        have hϖ₂_ne : ϖ₂ ≠ 0 := by
          rcases hall 1 with ⟨q₁, hq₁⟩
          rw [pow_one] at hq₁
          exact left_ne_zero_of_mul (hq₁ ▸ hX₂_ne)
        let q_seq : ℕ → B₂ := fun m => Classical.choose (hall m)
        have hq_seq : ∀ m : ℕ, X₂ = ϖ₂ ^ m * q_seq m :=
          fun m => Classical.choose_spec (hall m)
        have hq_ne : ∀ m : ℕ, q_seq m ≠ 0 :=
          fun m h0 => hX₂_ne (by rw [hq_seq m, h0, mul_zero])
        have hq_step : ∀ m : ℕ, q_seq m = ϖ₂ * q_seq (m + 1) := by
          intro m
          apply mul_left_cancel₀ (pow_ne_zero m hϖ₂_ne)
          rw [← hq_seq m, hq_seq (m + 1), pow_succ, mul_assoc]
        let f_ord : ℕ →o Ideal B₂ :=
          { toFun := fun m => Ideal.span {q_seq m}
            monotone' := monotone_nat_of_le_succ fun m => by
              rw [Ideal.span_singleton_le_span_singleton]
              exact ⟨ϖ₂, by rw [hq_step m, mul_comm]⟩ }
        obtain ⟨N, hN⟩ := (monotone_stabilizes_iff_noetherian.mpr
          (inferInstance : IsNoetherian B₂ B₂)) f_ord
        have hle_N : Ideal.span ({q_seq (N + 1)} : Set B₂) ≤ Ideal.span {q_seq N} :=
          le_of_eq (hN (N + 1) (Nat.le_succ N)).symm
        obtain ⟨c_N, hc_N⟩ := Ideal.span_singleton_le_span_singleton.mp hle_N
        have h1_eq : q_seq (N + 1) * 1 = q_seq (N + 1) * (ϖ₂ * c_N) := by
          rw [mul_one]
          conv_lhs => rw [hc_N, hq_step N]
          ring
        have hc1 : ϖ₂ * c_N = 1 := (mul_left_cancel₀ (hq_ne (N + 1)) h1_eq).symm
        have hu_ϖ₂ : IsUnit ϖ₂ := ⟨⟨ϖ₂, c_N, hc1, mul_comm ϖ₂ c_N ▸ hc1⟩, rfl⟩
        exact hp₂_prime.ne_top (Ideal.eq_top_of_isUnit_mem p₂ hϖ₂_mem hu_ϖ₂)

      let m₀ : ℕ := Nat.find hex_ndvd
      have hm₀_spec : ¬ (ϖ₂ ^ m₀ ∣ X₂) := Nat.find_spec hex_ndvd
      have hm₀_ne0 : m₀ ≠ 0 := fun h0 => hm₀_spec (by rw [h0, pow_zero]; exact one_dvd X₂)
      have hm₀_ne1 : m₀ ≠ 1 := fun h1 => hm₀_spec (h1 ▸ hϖ₂_dvd1)
      have hm₀_ge2 : 2 ≤ m₀ := by omega
      let e : ℕ := m₀ - 1
      have he_ge1 : 1 ≤ e := by omega
      have hm₀_eq : m₀ = e + 1 := by omega
      have he_lt : e < m₀ := by omega
      have hdvd_e : ϖ₂ ^ e ∣ X₂ := of_not_not (Nat.find_min hex_ndvd he_lt)
      obtain ⟨u₂, hu₂_eq⟩ := hdvd_e
      have hu₂_not_p₂ : u₂ ∉ p₂ := by
        intro hu₂_mem
        rw [hp₂_span, Ideal.mem_span_singleton] at hu₂_mem
        rcases hu₂_mem with ⟨c_u, rfl⟩
        apply hm₀_spec
        rw [hm₀_eq, pow_succ]
        exact ⟨c_u, by rw [hu₂_eq]; ring⟩
      have hu_u₂_R : IsUnit (ρ₂ u₂) := IsLocalRing.notMem_maximalIdeal.mp hu₂_not_p₂

      
      have hStep3 : ∀ (B₂_t : Type u) [CommRing B₂_t]
          (p_B₂t : P →+* B₂_t) (θ₂_t : P →+* B₂_t) (ρ₂_t : B₂_t →+* R_bar)
          (ϖ₂_t u₂_t : B₂_t),
          Function.Injective ρ₂_t →
          ρ₂_t.comp p_B₂t = algebraMap P R_bar →
          (∀ c : k, ρ₂_t (θ₂_t (Polynomial.C c)) = algebraMap P R_bar (Polynomial.C c)) →
          θ₂_t.Etale →
          θ₂_t Polynomial.X = ϖ₂_t →
          ρ₂_t ϖ₂_t ∈ IsLocalRing.maximalIdeal R_bar →
          p_B₂t Polynomial.X = ϖ₂_t ^ e * u₂_t →
          IsUnit (ρ₂_t u₂_t) →
          (∀ w ∈ F, ∃ y : B₂_t, ρ₂_t y = w) →
          ∃ B : Subalgebra P R_bar,
            (F : Set R_bar) ⊆ (B : Set R_bar) ∧ IsGoodStage B := by
        clear * - he_ge1 hRangeSubalg
        intro B₂_t _ p_B₂t θ₂_t ρ₂_t ϖ₂_t u₂_t hρ₂_inj hρ₂_P hθ₂_C_R hθ₂_et hθ₂_X
          hϖ₂_max hu₂_eq hu_u₂_R hF_in_B₂
        let B₃ := Localization.Away u₂_t
        have hu₂_units : ∀ y : ↥(Submonoid.powers u₂_t), IsUnit (ρ₂_t y.1) := by
          rintro ⟨_, n, rfl⟩
          rw [map_pow]
          exact hu_u₂_R.pow n
        let ρ₃ : B₃ →+* R_bar :=
          IsLocalization.lift (M := Submonoid.powers u₂_t) (S := B₃) (g := ρ₂_t) hu₂_units
        have hρ₃_B₂ : ∀ b : B₂_t, ρ₃ (algebraMap B₂_t B₃ b) = ρ₂_t b :=
          IsLocalization.lift_eq (M := Submonoid.powers u₂_t) (S := B₃) hu₂_units
        have hρ₃_inj : Function.Injective ρ₃ := by
          rw [injective_iff_map_eq_zero]
          intro z hz0
          obtain ⟨⟨b, s⟩, hsx⟩ := IsLocalization.surj (Submonoid.powers u₂_t) z
          dsimp only at hsx
          have h1 := congrArg ρ₃ hsx
          rw [map_mul, hz0, zero_mul, hρ₃_B₂] at h1
          have hb0 : b = 0 := hρ₂_inj (h1.symm.trans (map_zero ρ₂_t).symm)
          rw [hb0, map_zero] at hsx
          exact (IsLocalization.map_units B₃ s).mul_left_eq_zero.mp hsx
        let θ₃ : P →+* B₃ := (algebraMap B₂_t B₃).comp θ₂_t
        have h_et_B₂B₃ : Algebra.Etale B₂_t B₃ :=
          @Algebra.Etale.of_isLocalizationAway B₂_t B₃ _ _ _ u₂_t _
        have hθ₃_et : θ₃.Etale :=
          RingHom.Etale.stableUnderComposition θ₂_t (algebraMap B₂_t B₃) hθ₂_et
            (RingHom.etale_algebraMap.mpr h_et_B₂B₃)
        let p_B₃ : P →+* B₃ := (algebraMap B₂_t B₃).comp p_B₂t
        have hρ₃_P : ρ₃.comp p_B₃ = algebraMap P R_bar := by
          apply RingHom.ext
          intro p
          change ρ₃ (algebraMap B₂_t B₃ (p_B₂t p)) = algebraMap P R_bar p
          rw [hρ₃_B₂]
          exact RingHom.congr_fun hρ₂_P p
        obtain ⟨B_sub, hom_cat, hB_range, hbij_cat, hval_cat, _⟩ :=
          hRangeSubalg B₃ p_B₃ ρ₃ hρ₃_inj hρ₃_P
        let ψ_cat : CommRingCat.of P ⟶ CommRingCat.of ↥B_sub :=
          CommRingCat.ofHom θ₃ ≫ hom_cat
        have hψ_B_et : ψ_cat.hom.Etale :=
          RingHom.Etale.stableUnderComposition θ₃ hom_cat.hom hθ₃_et
            (RingHom.Etale.of_bijective hbij_cat)
        let ϖ_B : ↑(CommRingCat.of ↥B_sub) := ψ_cat.hom Polynomial.X
        obtain ⟨u_B₃, hu_B₃⟩ : IsUnit (algebraMap B₂_t B₃ u₂_t) :=
          IsLocalization.map_units B₃ (⟨u₂_t, 1, pow_one u₂_t⟩ : ↥(Submonoid.powers u₂_t))
        let u_B : (↑(CommRingCat.of ↥B_sub))ˣ := Units.map hom_cat.hom.toMonoidHom u_B₃
        refine ⟨B_sub, ?_, ϖ_B, u_B, e, ψ_cat, he_ge1, ?_, ?_, ?_, rfl, hψ_B_et⟩
        · intro w hw
          obtain ⟨y, rfl⟩ := hF_in_B₂ w hw
          exact (hB_range _).mpr ⟨algebraMap B₂_t B₃ y, hρ₃_B₂ y⟩
        · change B_sub.val (hom_cat.hom (algebraMap B₂_t B₃ (θ₂_t Polynomial.X))) ∈
            IsLocalRing.maximalIdeal R_bar
          rw [hval_cat, hθ₂_X, hρ₃_B₂]
          exact hϖ₂_max
        · apply Subtype.ext
          change algebraMap P R_bar Polynomial.X =
            B_sub.val (hom_cat.hom ↑u_B₃) *
              (B_sub.val (hom_cat.hom (algebraMap B₂_t B₃ (θ₂_t Polynomial.X)))) ^ e
          rw [hval_cat, hval_cat, hu_B₃, hθ₂_X, hρ₃_B₂, hρ₃_B₂,
            ← RingHom.congr_fun hρ₂_P Polynomial.X, RingHom.comp_apply, hu₂_eq,
            map_mul, map_pow, mul_comm]
        · apply RingHom.ext
          intro c
          apply Subtype.ext
          change B_sub.val (hom_cat.hom (algebraMap B₂_t B₃ (θ₂_t (Polynomial.C c)))) =
            algebraMap P R_bar (Polynomial.C c)
          rw [hval_cat, hρ₃_B₂, hθ₂_C_R c]

      exact hStep3 B₂ p_B₂ θ₂ ρ₂ ϖ₂ u₂ hρ₂_inj hρ₂_P
        (fun c => by dsimp [θ₂]; rw [hρ₂_B₁, hθ₁_C_R c])
        hθ₂_et rfl hϖ₂_mem hu₂_eq hu_u₂_R hF_in_B₂

    let p_B₁ : P →+* B₁ := (algebraMap B_t B₁).comp p_Bt
    have hρ₁_P : ρ₁.comp p_B₁ = algebraMap P R_bar := by
      apply RingHom.ext
      intro p
      change ρ₁ (algebraMap B_t B₁ (p_Bt p)) = algebraMap P R_bar p
      rw [hρ₁_Bt]
      change algebraMap ↥B_bar R_bar ((j_Bt.comp p_Bt) p) = _
      rw [hj_Bt_P, ← IsScalarTower.algebraMap_apply P ↥B_bar R_bar]
    have hθ₁_C_R : ∀ c : k, ρ₁ (θ₁ (Polynomial.C c)) = algebraMap P R_bar (Polynomial.C c) := by
      intro c
      have h1 : θ₁ (Polynomial.C c) = algebraMap k B₁ c := RingHom.congr_fun hθ₁_C c
      rw [h1, hρ₁_alg_k c]
    let g₂ : B₁ := f₂ * s_prod
    have hu_g₂ : IsUnit (ρ₁ g₂) := by
      dsimp [g₂]; rw [map_mul]; exact hu_f₂.mul hu_sprod
    exact hFinishGood B₁ p_B₁ θ₁ ρ₁ g₂ f₂ hρ₁_inj hρ₁_P hθ₁_C_R hθ₁_et hϖ₁_mem
      hf₂_mul (dvd_mul_right f₂ s_prod) hu_g₂ (fun w hw => by
        let w' : ↥F := ⟨w, hw⟩
        refine ⟨algebraMap B_t B₁ (a_Bt w'), s_B₁ w',
          dvd_mul_of_dvd_right (Finset.dvd_prod_of_mem s_B₁ (Finset.mem_univ w')) f₂, ?_, ?_⟩
        · rw [hρ₁_sB₁ w']; exact IsLocalization.map_units R_bar (pair w).2
        · rw [hρ₁_sB₁ w', hρ₁_aBt w', hpair w])

  
  have hStageFG_aux : ∀ (E_t : Type u) [CommRing E_t] (ψ_t : P →+* E_t) (ι_t : E_t →+* R_bar),
      ψ_t.Etale →
      ι_t.comp (ψ_t.comp Polynomial.C) = (algebraMap P R_bar).comp Polynomial.C →
      ∃ S_i : Finset R_bar,
        ∀ B' : Subalgebra P R_bar, (S_i : Set R_bar) ⊆ (B' : Set R_bar) →
          Set.range ι_t ⊆ (B' : Set R_bar) := by
    clear * -
    intro E_t _ ψ_t ι_t hψ_et hC
    letI : Algebra P E_t := ψ_t.toAlgebra
    haveI : Algebra.Etale P E_t := RingHom.etale_algebraMap.mp hψ_et
    haveI : Algebra.FinitePresentation P E_t := Algebra.Etale.finitePresentation
    obtain ⟨S_raw, hS_raw⟩ := (inferInstance : Algebra.FiniteType P E_t).out
    let S_i : Finset R_bar := insert (ι_t (ψ_t Polynomial.X)) (S_raw.image ι_t)
    refine ⟨S_i, fun B' hSub => ?_⟩
    have hϖ_B' : ι_t (ψ_t Polynomial.X) ∈ B' :=
      hSub (Finset.mem_coe.mpr (Finset.mem_insert_self _ _))
    have hψ_in_B' : ∀ p : P, ι_t (ψ_t p) ∈ B' := by
      intro p
      induction p using Polynomial.induction_on' with
      | add p₁ p₂ ih₁ ih₂ =>
        rw [map_add, map_add]
        exact B'.add_mem ih₁ ih₂
      | monomial n c =>
        rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, map_mul, map_pow]
        have hC_eq : ι_t (ψ_t (Polynomial.C c)) = algebraMap P R_bar (Polynomial.C c) :=
          RingHom.congr_fun hC c
        rw [hC_eq]
        exact B'.mul_mem (B'.algebraMap_mem _) (B'.pow_mem hϖ_B' n)
    let B'_pull : Subalgebra P E_t :=
      { carrier := { x : E_t | ι_t x ∈ B' }
        mul_mem' := fun {a b} ha hb => by
          change ι_t (a * b) ∈ B'
          rw [map_mul]
          exact B'.mul_mem ha hb
        one_mem' := by
          change ι_t 1 ∈ B'
          rw [map_one]
          exact B'.one_mem
        add_mem' := fun {a b} ha hb => by
          change ι_t (a + b) ∈ B'
          rw [map_add]
          exact B'.add_mem ha hb
        zero_mem' := by
          change ι_t 0 ∈ B'
          rw [map_zero]
          exact B'.zero_mem
        algebraMap_mem' := hψ_in_B' }
    have hRaw_sub : (S_raw : Set E_t) ⊆ (B'_pull : Set E_t) := fun x hx =>
      hSub (Finset.mem_coe.mpr (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hx)))
    have hTop_le : (⊤ : Subalgebra P E_t) ≤ B'_pull := by
      rw [← hS_raw]
      exact Algebra.adjoin_le hRaw_sub
    rintro _ ⟨x, rfl⟩
    exact hTop_le (Algebra.mem_top (x := x))

  
  have hStandardEtaleStep : ∀ (A_t : Type u) [CommRing A_t]
      (ψ_At : P →+* A_t) (ι_At : A_t →+* R_bar)
      (F_t : Polynomial A_t) (r : R_bar),
      ψ_At.Etale →
      ι_At.comp ψ_At = algebraMap P R_bar →
      F_t.Monic →
      (F_t.map ι_At).eval r = 0 →
      IsUnit ((F_t.map ι_At).derivative.eval r) →
      ∃ C_lift : Subalgebra P R_bar, (pHom C_lift).hom.Etale ∧ r ∈ C_lift := by
    clear * - ht_max ht_ne hShrink hRangeSubalg
    intro A_t _ ψ_At ι_At F_t r hψ_et hι_P hFt_mon hr_root hr_deriv_unit
    have hBez : ∃ p₁ p₂ n, F_t.derivative * p₁ + F_t * p₂ = F_t.derivative ^ n :=
      ⟨1, 0, 1, by rw [mul_one, mul_zero, add_zero, pow_one]⟩
    let P_et : StandardEtalePair A_t :=
      StandardEtalePair.mk F_t hFt_mon F_t.derivative hBez
    haveI : Algebra.Etale A_t P_et.Ring := inferInstance
    letI : Algebra A_t R_bar := ι_At.toAlgebra
    have hr_hasMap : P_et.HasMap r := by
      refine ⟨?_, ?_⟩
      · change Polynomial.eval₂ ι_At r F_t = 0
        rw [← Polynomial.eval_map]
        exact hr_root
      · change IsUnit (Polynomial.eval₂ ι_At r F_t.derivative)
        rw [← Polynomial.eval_map, ← Polynomial.derivative_map]
        exact hr_deriv_unit
    let lam_et : P_et.Ring →ₐ[A_t] R_bar := P_et.lift r hr_hasMap
    let ψ_Pet : P →+* P_et.Ring := (algebraMap A_t P_et.Ring).comp ψ_At
    have hψ_Pet_et : ψ_Pet.Etale :=
      RingHom.Etale.stableUnderComposition ψ_At (algebraMap A_t P_et.Ring) hψ_et
        (RingHom.etale_algebraMap.mpr inferInstance)
    have hlam_P : lam_et.toRingHom.comp ψ_Pet = algebraMap P R_bar := by
      apply RingHom.ext
      intro p
      exact (lam_et.commutes (ψ_At p)).trans (RingHom.congr_fun hι_P p)
    have hlam_C : lam_et.toRingHom.comp (ψ_Pet.comp Polynomial.C) =
        (algebraMap P R_bar).comp Polynomial.C := by
      rw [← RingHom.comp_assoc, hlam_P]
    have hlam_X : lam_et.toRingHom (ψ_Pet Polynomial.X) = t_bar :=
      RingHom.congr_fun hlam_P Polynomial.X
    obtain ⟨h_et, _, _, hψ₁_et_sh, ρ₁_sh, hρ₁_sh_comp, hρ₁_sh_inj⟩ :=
      hShrink P_et.Ring ψ_Pet lam_et.toRingHom hψ_Pet_et hlam_C
        (hlam_X ▸ ht_max) (hlam_X ▸ ht_ne)
    let E₁_sh := Localization.Away h_et
    let ψ₁_sh : P →+* E₁_sh := (algebraMap P_et.Ring E₁_sh).comp ψ_Pet
    have hρ₁_sh_P : ρ₁_sh.comp ψ₁_sh = algebraMap P R_bar := by
      rw [← RingHom.comp_assoc, hρ₁_sh_comp, hlam_P]
    obtain ⟨C_lift, hom_cat, hC_range, hbij_cat, _, hcomp_cat⟩ :=
      hRangeSubalg E₁_sh ψ₁_sh ρ₁_sh hρ₁_sh_inj hρ₁_sh_P
    have hClift_et : (pHom C_lift).hom.Etale := by
      rw [← hcomp_cat]
      exact RingHom.Etale.stableUnderComposition ψ₁_sh hom_cat.hom hψ₁_et_sh
        (RingHom.Etale.of_bijective hbij_cat)
    refine ⟨C_lift, hClift_et, (hC_range r).mpr ⟨algebraMap P_et.Ring E₁_sh P_et.X,
      (RingHom.congr_fun hρ₁_sh_comp P_et.X).trans (P_et.lift_X r hr_hasMap)⟩⟩

  refine ⟨?_, ?_⟩
  · 
    let ℐ := { B : Subalgebra P R_bar // IsGoodStage B }
    let _ : Preorder ℐ := Subtype.preorder _
    obtain ⟨B₀, _, hGood₀⟩ := hGoodFin ∅
    haveI : Nonempty ℐ := ⟨⟨B₀, hGood₀⟩⟩
    have hStageFG : ∀ i : ℐ, ∃ S_i : Finset R_bar,
        ∀ B' : Subalgebra P R_bar, (S_i : Set R_bar) ⊆ (B' : Set R_bar) → i.1 ≤ B' := by
      intro i
      obtain ⟨_, _, _, ψ_cat, _, _, _, hψ_C, _, hψ_et⟩ := i.2
      have hC_R : (CommRingCat.ofHom i.1.val.toRingHom :
            CommRingCat.of ↥i.1 ⟶ CommRingCat.of R_bar).hom.comp
          (ψ_cat.hom.comp Polynomial.C) = (algebraMap P R_bar).comp Polynomial.C := by
        apply RingHom.ext
        intro c
        exact congrArg Subtype.val (RingHom.congr_fun hψ_C c)
      obtain ⟨S_i, hS_i⟩ := hStageFG_aux (↑(CommRingCat.of ↥i.1)) ψ_cat.hom
        (CommRingCat.ofHom i.1.val.toRingHom : CommRingCat.of ↥i.1 ⟶ CommRingCat.of R_bar).hom
        hψ_et hC_R
      exact ⟨S_i, fun B' hSub y hy => hS_i B' hSub ⟨(⟨y, hy⟩ : ↥i.1), rfl⟩⟩

    haveI : IsDirectedOrder ℐ :=
      ⟨fun i₁ i₂ => by
        obtain ⟨S₁, hS₁⟩ := hStageFG i₁
        obtain ⟨S₂, hS₂⟩ := hStageFG i₂
        obtain ⟨B₃, hSub₃, hGood₃⟩ := hGoodFin (S₁ ∪ S₂)
        exact ⟨⟨B₃, hGood₃⟩,
          hS₁ B₃ (Set.Subset.trans (by simp) hSub₃),
          hS₂ B₃ (Set.Subset.trans (by simp) hSub₃)⟩⟩
    letI : CategoryTheory.SmallCategory ℐ := Preorder.smallCategory ℐ
    letI : CategoryTheory.IsFiltered ℐ := CategoryTheory.isFiltered_of_directed_le_nonempty ℐ
    let D : ℐ ⥤ CommRingCat.{u} :=
      { obj := fun i => CommRingCat.of ↥i.1
        map := fun θ => CommRingCat.ofHom
          { toFun := fun x => ⟨x.1, (leOfHom θ) x.2⟩
            map_one' := rfl
            map_mul' := fun _ _ => rfl
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ => by apply CommRingCat.hom_ext; ext x; rfl
        map_comp := fun _ _ => by apply CommRingCat.hom_ext; ext x; rfl }
    let α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of P) ⟶ D :=
      { app := fun i => pHom i.1
        naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext p; rfl }
    let c : CategoryTheory.Limits.Cocone D :=
      { pt := CommRingCat.of R_bar
        ι :=
          { app := fun i => CommRingCat.ofHom i.1.val.toRingHom
            naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext x; rfl } }
    have hExhaust_Rbar : ∀ r : R_bar, ∃ i : ℐ, r ∈ i.1 := by
      intro r
      obtain ⟨B_r, hr_sub, hGood_r⟩ := hGoodFin {r}
      exact ⟨⟨B_r, hGood_r⟩, hr_sub (by simp)⟩
    let hc : CategoryTheory.Limits.IsColimit c :=
      { desc := fun s =>
          let iOf : R_bar → ℐ := fun r => Classical.choose (hExhaust_Rbar r)
          let memOf : ∀ r : R_bar, r ∈ (iOf r).1 :=
            fun r => Classical.choose_spec (hExhaust_Rbar r)
          have hIndep : ∀ (r : R_bar) (i : ℐ) (x : ↑(D.obj i)),
              x.1 = r → (s.ι.app i).hom x = (s.ι.app (iOf r)).hom ⟨r, memOf r⟩ := by
            intro r i x hx
            obtain ⟨m, him, hirm⟩ := directed_of (· ≤ ·) i (iOf r)
            have h1 := congrArg (fun g : D.obj i ⟶ s.pt => g.hom x) (s.w (homOfLE him))
            have h2 := congrArg (fun g : D.obj (iOf r) ⟶ s.pt => g.hom ⟨r, memOf r⟩)
              (s.w (homOfLE hirm))
            have heq_m : (D.map (homOfLE him)).hom x =
                (D.map (homOfLE hirm)).hom ⟨r, memOf r⟩ := Subtype.ext hx
            exact h1.symm.trans ((congrArg (s.ι.app m).hom heq_m).trans h2)
          let i₀ : ℐ := ⟨B₀, hGood₀⟩
          CommRingCat.ofHom
            { toFun := fun r => (s.ι.app (iOf r)).hom ⟨r, memOf r⟩
              map_one' := (hIndep 1 i₀ 1 rfl).symm.trans (map_one (s.ι.app i₀).hom)
              map_mul' := fun r₁ r₂ => by
                obtain ⟨m, hm₁, hm₂⟩ := directed_of (· ≤ ·) (iOf r₁) (iOf r₂)
                let x₁ : ↑(D.obj m) := ⟨r₁, hm₁ (memOf r₁)⟩
                let x₂ : ↑(D.obj m) := ⟨r₂, hm₂ (memOf r₂)⟩
                exact (hIndep (r₁ * r₂) m (x₁ * x₂) rfl).symm.trans
                  ((map_mul (s.ι.app m).hom x₁ x₂).trans
                    (congrArg₂ (· * ·) (hIndep r₁ m x₁ rfl) (hIndep r₂ m x₂ rfl)))
              map_zero' := (hIndep 0 i₀ 0 rfl).symm.trans (map_zero (s.ι.app i₀).hom)
              map_add' := fun r₁ r₂ => by
                obtain ⟨m, hm₁, hm₂⟩ := directed_of (· ≤ ·) (iOf r₁) (iOf r₂)
                let x₁ : ↑(D.obj m) := ⟨r₁, hm₁ (memOf r₁)⟩
                let x₂ : ↑(D.obj m) := ⟨r₂, hm₂ (memOf r₂)⟩
                exact (hIndep (r₁ + r₂) m (x₁ + x₂) rfl).symm.trans
                  ((map_add (s.ι.app m).hom x₁ x₂).trans
                    (congrArg₂ (· + ·) (hIndep r₁ m x₁ rfl) (hIndep r₂ m x₂ rfl))) }
        fac := fun s i => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro x
          let iOf : R_bar → ℐ := fun r => Classical.choose (hExhaust_Rbar r)
          let memOf : ∀ r : R_bar, r ∈ (iOf r).1 :=
            fun r => Classical.choose_spec (hExhaust_Rbar r)
          change (s.ι.app (iOf x.1)).hom ⟨x.1, memOf x.1⟩ = (s.ι.app i).hom x
          obtain ⟨m, him, hirm⟩ := directed_of (· ≤ ·) i (iOf x.1)
          have h1 := congrArg (fun g : D.obj i ⟶ s.pt => g.hom x) (s.w (homOfLE him))
          have h2 := congrArg (fun g : D.obj (iOf x.1) ⟶ s.pt => g.hom ⟨x.1, memOf x.1⟩)
            (s.w (homOfLE hirm))
          have heq_m : (D.map (homOfLE him)).hom x =
              (D.map (homOfLE hirm)).hom ⟨x.1, memOf x.1⟩ := rfl
          exact h2.symm.trans ((congrArg (s.ι.app m).hom heq_m.symm).trans h1)
        uniq := fun s m hm => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro r
          let i_r : ℐ := Classical.choose (hExhaust_Rbar r)
          let hr : r ∈ i_r.1 := Classical.choose_spec (hExhaust_Rbar r)
          exact congrArg (fun g : D.obj i_r ⟶ s.pt => g.hom ⟨r, hr⟩) (hm i_r) }
    refine ⟨ℐ, inferInstance, inferInstance, D, α, c, hc, CategoryTheory.Iso.refl _, ?_, ?_⟩
    · intro i
      refine ⟨?_, Subtype.val_injective⟩
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro p
      rfl
    · intro i
      obtain ⟨ϖ, u, e, ψ_cat_i, he, hϖ_max, hX_eq, hψ_C, hψ_X, hψ_et⟩ := i.2
      refine ⟨ϖ, u, e, ψ_cat_i.hom, he, hϖ_max, hX_eq, hψ_C, hψ_X, hψ_et, ?_⟩
      
      have hℓ_pos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
      obtain ⟨⟨a_B, s_B⟩, hsB⟩ := IsLocalization.surj M_max.primeCompl (i.1.val ϖ)
      dsimp only at hsB
      obtain ⟨β_Ω, hβ_Ω⟩ := IsAlgClosed.exists_pow_nat_eq (φ_R_Ω (i.1.val ϖ)) hℓ_pos
      have hw_mem : s_B.1.1 * β_Ω ∈ B_bar := by
        have hpow_eq : (s_B.1.1 * β_Ω) ^ ℓ = (s_B.1 ^ (ℓ - 1) * a_B).1 := by
          have hsB_Ω := congrArg φ_R_Ω hsB
          rw [map_mul, hφ_B, hφ_B] at hsB_Ω
          have hℓ_sub : ℓ = (ℓ - 1) + 1 := (Nat.sub_add_cancel hℓ_pos).symm
          calc
            (s_B.1.1 * β_Ω) ^ ℓ = s_B.1.1 ^ ℓ * β_Ω ^ ℓ := mul_pow _ _ ℓ
            _ = s_B.1.1 ^ ((ℓ - 1) + 1) * φ_R_Ω (i.1.val ϖ) := by
              rw [hβ_Ω]
              conv_lhs => rw [hℓ_sub]
            _ = s_B.1.1 ^ (ℓ - 1) * (φ_R_Ω (i.1.val ϖ) * s_B.1.1) := by
              rw [pow_succ]; ring
            _ = (s_B.1 ^ (ℓ - 1) * a_B).1 := by
              rw [hsB_Ω]; rfl
        let G_kum : Polynomial ↥B_bar :=
          Polynomial.X ^ ℓ - Polynomial.C (s_B.1 ^ (ℓ - 1) * a_B)
        have hG_mon : G_kum.Monic := Polynomial.monic_X_pow_sub_C _ hℓ_pos.ne'
        have hG_ev : Polynomial.aeval (s_B.1.1 * β_Ω) G_kum = 0 := by
          dsimp [G_kum]
          rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C]
          change (s_B.1.1 * β_Ω) ^ ℓ - (s_B.1 ^ (ℓ - 1) * a_B).1 = 0
          rw [hpow_eq, sub_self]
        exact _root_.isIntegral_trans (R := P) (A := ↥B_bar) (B := Ω)
          (x := s_B.1.1 * β_Ω) ⟨G_kum, hG_mon, hG_ev⟩
      let β_R : R_bar := IsLocalization.mk' R_bar ⟨s_B.1.1 * β_Ω, hw_mem⟩ s_B
      have hφ_βR : φ_R_Ω β_R = β_Ω := by
        have hsB_ne : s_B.1.1 ≠ 0 := fun h0 => s_B.2 (by
          have hs0 : s_B.1 = 0 := Subtype.ext h0
          rw [hs0]; exact M_max.zero_mem)
        apply mul_right_cancel₀ hsB_ne
        have hmk := congrArg φ_R_Ω (IsLocalization.mk'_spec R_bar ⟨s_B.1.1 * β_Ω, hw_mem⟩ s_B)
        rw [map_mul, hφ_B, hφ_B] at hmk
        exact hmk.trans (mul_comm _ _)
      have hβ_pow : β_R ^ ℓ = i.1.val ϖ := by
        apply hφ_inj
        rw [map_pow, hφ_βR, hβ_Ω]
      have hmR_prime : (IsLocalRing.maximalIdeal R_bar).IsPrime := inferInstance
      have hβ_max : β_R ∈ IsLocalRing.maximalIdeal R_bar :=
        hmR_prime.mem_of_pow_mem ℓ (hβ_pow.symm ▸ hϖ_max)
      have hβ_ne : β_R ≠ 0 := by
        intro h0
        have hϖ0 : i.1.val ϖ = 0 := by
          rw [← hβ_pow, h0, zero_pow hℓ_pos.ne']
        have ht0 : t_bar = 0 := by
          have h1 := congrArg i.1.val hX_eq
          change t_bar = i.1.val (↑u * ϖ ^ e) at h1
          rw [h1, map_mul, map_pow, hϖ0, zero_pow (by omega), mul_zero]
        exact ht_ne ht0

      let κ_ℓ : P →+* P := Polynomial.eval₂RingHom Polynomial.C (Polynomial.X ^ ℓ)
      let E_cat : CommRingCat.{u} :=
        CategoryTheory.Limits.pushout (CommRingCat.ofHom κ_ℓ) ψ_cat_i
      let inl_E : CommRingCat.of P ⟶ E_cat :=
        CategoryTheory.Limits.pushout.inl (CommRingCat.ofHom κ_ℓ) ψ_cat_i
      let inr_E : D.obj i ⟶ E_cat :=
        CategoryTheory.Limits.pushout.inr (CommRingCat.ofHom κ_ℓ) ψ_cat_i
      have hinl_et : inl_E.hom.Etale :=
        RingHom.Etale.isStableUnderBaseChange.pushout_inl RingHom.Etale.respectsIso
          (CommRingCat.ofHom κ_ℓ) ψ_cat_i hψ_et
      let ev_β : P →+* R_bar :=
        Polynomial.eval₂RingHom ((algebraMap P R_bar).comp Polynomial.C) β_R
      have h_sq_kum : CommRingCat.ofHom κ_ℓ ≫ CommRingCat.ofHom ev_β =
          ψ_cat_i ≫ CommRingCat.ofHom i.1.val.toRingHom := by
        apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          have hc := RingHom.congr_fun hψ_C c
          have hc_val : (ψ_cat_i.hom (Polynomial.C c)).1 =
              algebraMap P R_bar (Polynomial.C c) :=
            congrArg Subtype.val hc
          change ev_β (κ_ℓ (Polynomial.C c)) = (ψ_cat_i.hom (Polynomial.C c)).1
          have hκC : κ_ℓ (Polynomial.C c) = Polynomial.C c := by
            dsimp [κ_ℓ]
            rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          rw [hκC]
          dsimp [ev_β]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact hc_val.symm
        · change ev_β (κ_ℓ Polynomial.X) = (ψ_cat_i.hom Polynomial.X).1
          have hκX : κ_ℓ Polynomial.X = Polynomial.X ^ ℓ := by
            dsimp [κ_ℓ]
            rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
          rw [hκX]
          dsimp [ev_β]
          rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X_pow, hβ_pow, hψ_X]
          rfl
      let ρ_E : E_cat ⟶ CommRingCat.of R_bar :=
        CategoryTheory.Limits.pushout.desc (CommRingCat.ofHom ev_β)
          (CommRingCat.ofHom i.1.val.toRingHom) h_sq_kum
      have hinl_ρ : inl_E ≫ ρ_E = CommRingCat.ofHom ev_β :=
        CategoryTheory.Limits.pushout.inl_desc _ _ _
      have hinr_ρ : inr_E ≫ ρ_E = CommRingCat.ofHom i.1.val.toRingHom :=
        CategoryTheory.Limits.pushout.inr_desc _ _ _
      have hρ_C : ρ_E.hom.comp (inl_E.hom.comp Polynomial.C) =
          (algebraMap P R_bar).comp Polynomial.C := by
        apply RingHom.ext
        intro c
        have h1 : ρ_E.hom (inl_E.hom (Polynomial.C c)) = ev_β (Polynomial.C c) :=
          congrArg (fun g : CommRingCat.of P ⟶ CommRingCat.of R_bar =>
            g.hom (Polynomial.C c)) hinl_ρ
        rw [RingHom.comp_apply, RingHom.comp_apply, h1]
        dsimp [ev_β]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
        rfl
      have hρ_X : ρ_E.hom (inl_E.hom Polynomial.X) = β_R := by
        have h1 : ρ_E.hom (inl_E.hom Polynomial.X) = ev_β Polynomial.X :=
          congrArg (fun g : CommRingCat.of P ⟶ CommRingCat.of R_bar =>
            g.hom Polynomial.X) hinl_ρ
        rw [h1]
        dsimp [ev_β]
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

      obtain ⟨h_k, _, _, hψ₁_raw_et, ρ₁_k, hρ₁_k_comp, hρ₁_k_inj⟩ :=
        hShrink (↑E_cat) inl_E.hom ρ_E.hom hinl_et hρ_C (hρ_X ▸ hβ_max) (hρ_X ▸ hβ_ne)
      let E₁_k := Localization.Away h_k
      let p_E₁k : P →+* E₁_k :=
        (algebraMap (↑E_cat) E₁_k).comp (inr_E.hom.comp (pHom i.1).hom)
      have hρ₁k_P : ρ₁_k.comp p_E₁k = algebraMap P R_bar := by
        apply RingHom.ext
        intro p
        dsimp [p_E₁k]
        have h1 := RingHom.congr_fun hρ₁_k_comp (inr_E.hom ((pHom i.1).hom p))
        have h2 := congrArg (fun g : D.obj i ⟶ CommRingCat.of R_bar =>
          g.hom ((pHom i.1).hom p)) hinr_ρ
        exact h1.trans h2
      obtain ⟨B₁_sub, hom_k, hB₁_range, hbij_k, hval_k, _⟩ :=
        hRangeSubalg E₁_k p_E₁k ρ₁_k hρ₁_k_inj hρ₁k_P
      have hi_le_B₁ : i.1 ≤ B₁_sub := by
        intro y hy
        refine (hB₁_range y).mpr ⟨algebraMap (↑E_cat) E₁_k (inr_E.hom ⟨y, hy⟩), ?_⟩
        have h1 := RingHom.congr_fun hρ₁_k_comp (inr_E.hom ⟨y, hy⟩)
        have h2 := congrArg (fun g : D.obj i ⟶ CommRingCat.of R_bar => g.hom ⟨y, hy⟩) hinr_ρ
        exact h1.trans h2
      let ψ₁_raw : P →+* E₁_k := (algebraMap (↑E_cat) E₁_k).comp inl_E.hom
      let ψ₁_cat : CommRingCat.of P ⟶ CommRingCat.of ↥B₁_sub :=
        CommRingCat.ofHom ψ₁_raw ≫ hom_k
      have hψ₁_et : ψ₁_cat.hom.Etale :=
        RingHom.Etale.stableUnderComposition ψ₁_raw hom_k.hom hψ₁_raw_et
          (RingHom.Etale.of_bijective hbij_k)
      let β_sub : ↑(CommRingCat.of ↥B₁_sub) := ψ₁_cat.hom Polynomial.X
      have hβ_sub_val : B₁_sub.val β_sub = β_R := by
        change B₁_sub.val (hom_k.hom (algebraMap (↑E_cat) E₁_k (inl_E.hom Polynomial.X))) = β_R
        rw [hval_k]
        exact (RingHom.congr_fun hρ₁_k_comp _).trans hρ_X
      have hψ₁_C : ψ₁_cat.hom.comp Polynomial.C = (pHom B₁_sub).hom.comp Polynomial.C := by
        apply RingHom.ext
        intro c
        apply Subtype.ext
        change B₁_sub.val (hom_k.hom (algebraMap (↑E_cat) E₁_k (inl_E.hom (Polynomial.C c)))) =
          algebraMap P R_bar (Polynomial.C c)
        rw [hval_k]
        exact (RingHom.congr_fun hρ₁_k_comp _).trans (RingHom.congr_fun hρ_C c)
      let inc_u : ↑(D.obj i) →+* ↑(CommRingCat.of ↥B₁_sub) :=
        { toFun := fun x => ⟨x.1, hi_le_B₁ x.2⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      let u₁ : (↑(CommRingCat.of ↥B₁_sub))ˣ := Units.map inc_u.toMonoidHom u
      have hGood_B₁ : IsGoodStage B₁_sub := by
        refine ⟨β_sub, u₁, ℓ * e, ψ₁_cat, Nat.mul_pos hℓ_pos he, ?_, ?_, hψ₁_C, rfl, hψ₁_et⟩
        · rw [hβ_sub_val]; exact hβ_max
        · apply Subtype.ext
          have h1 := congrArg i.1.val hX_eq
          rw [map_mul, map_pow] at h1
          change i.1.val ((pHom i.1).hom Polynomial.X) =
            i.1.val ↑u * (B₁_sub.val β_sub) ^ (ℓ * e)
          rw [hβ_sub_val, pow_mul, hβ_pow]
          exact h1
      let i₁ : ℐ := ⟨B₁_sub, hGood_B₁⟩
      let θ : i ⟶ i₁ := homOfLE hi_le_B₁
      refine ⟨i₁, θ, β_sub, ψ₁_cat.hom, ?_, hψ₁_C, rfl, hψ₁_et⟩
      apply Subtype.ext
      change i.1.val ϖ = (B₁_sub.val β_sub) ^ ℓ
      rw [hβ_sub_val, hβ_pow]

  · 
    let ℐ_sh := { C : Subalgebra P R_bar // (pHom C).hom.Etale }
    let _ : Preorder ℐ_sh := Subtype.preorder _
    have hBot_et : (pHom (⊥ : Subalgebra P R_bar)).hom.Etale := by
      refine RingHom.Etale.of_bijective (f := (pHom ⊥).hom) ⟨?_, ?_⟩
      · intro p q hpq
        exact hinj_P_Rbar (congrArg Subtype.val hpq)
      · intro y
        obtain ⟨p, hp⟩ := Algebra.mem_bot.mp y.2
        exact ⟨p, Subtype.ext hp⟩
    let j_bot : ℐ_sh := ⟨⊥, hBot_et⟩
    haveI : Nonempty ℐ_sh := ⟨j_bot⟩
    have hDir_sh : ∀ j₁ j₂ : ℐ_sh, ∃ j₃ : ℐ_sh, j₁.1 ≤ j₃.1 ∧ j₂.1 ≤ j₃.1 := by
      intro j₁ j₂
      let E_cat : CommRingCat.{u} := CategoryTheory.Limits.pushout (pHom j₁.1) (pHom j₂.1)
      let inl_E : CommRingCat.of ↥j₁.1 ⟶ E_cat :=
        CategoryTheory.Limits.pushout.inl (pHom j₁.1) (pHom j₂.1)
      let inr_E : CommRingCat.of ↥j₂.1 ⟶ E_cat :=
        CategoryTheory.Limits.pushout.inr (pHom j₁.1) (pHom j₂.1)
      have hinl_et : inl_E.hom.Etale :=
        RingHom.Etale.isStableUnderBaseChange.pushout_inl RingHom.Etale.respectsIso
          (pHom j₁.1) (pHom j₂.1) j₂.2
      let ψ_E : P →+* ↑E_cat := inl_E.hom.comp (pHom j₁.1).hom
      have hψ_E_et : ψ_E.Etale :=
        RingHom.Etale.stableUnderComposition (pHom j₁.1).hom inl_E.hom j₁.2 hinl_et
      have h_sq_sh : pHom j₁.1 ≫ CommRingCat.ofHom j₁.1.val.toRingHom =
          pHom j₂.1 ≫ CommRingCat.ofHom j₂.1.val.toRingHom := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        rfl
      let ρ_E : E_cat ⟶ CommRingCat.of R_bar :=
        CategoryTheory.Limits.pushout.desc (CommRingCat.ofHom j₁.1.val.toRingHom)
          (CommRingCat.ofHom j₂.1.val.toRingHom) h_sq_sh
      have hinl_ρ : inl_E ≫ ρ_E = CommRingCat.ofHom j₁.1.val.toRingHom :=
        CategoryTheory.Limits.pushout.inl_desc _ _ _
      have hinr_ρ : inr_E ≫ ρ_E = CommRingCat.ofHom j₂.1.val.toRingHom :=
        CategoryTheory.Limits.pushout.inr_desc _ _ _
      have hρ_ψ : ρ_E.hom.comp ψ_E = algebraMap P R_bar := by
        apply RingHom.ext
        intro p
        have h1 := congrArg (fun g : CommRingCat.of ↥j₁.1 ⟶ CommRingCat.of R_bar =>
          g.hom ((pHom j₁.1).hom p)) hinl_ρ
        exact h1
      have hρ_C : ρ_E.hom.comp (ψ_E.comp Polynomial.C) =
          (algebraMap P R_bar).comp Polynomial.C := by
        rw [← RingHom.comp_assoc, hρ_ψ]
      have hρ_X : ρ_E.hom (ψ_E Polynomial.X) = t_bar :=
        RingHom.congr_fun hρ_ψ Polynomial.X
      obtain ⟨h, _, _, hψ₁_et, ρ₁, hρ₁_comp, hρ₁_inj⟩ :=
        hShrink (↑E_cat) ψ_E ρ_E.hom hψ_E_et hρ_C (hρ_X ▸ ht_max) (hρ_X ▸ ht_ne)
      let E₁ := Localization.Away h
      let ψ₁ : P →+* E₁ := (algebraMap (↑E_cat) E₁).comp ψ_E
      have hρ₁_ψ₁ : ρ₁.comp ψ₁ = algebraMap P R_bar := by
        rw [← RingHom.comp_assoc, hρ₁_comp, hρ_ψ]
      obtain ⟨C₃, hom_3, hC₃_range, hbij_3, _, hcomp_3⟩ :=
        hRangeSubalg E₁ ψ₁ ρ₁ hρ₁_inj hρ₁_ψ₁
      have hC₃_et : (pHom C₃).hom.Etale := by
        rw [← hcomp_3]
        exact RingHom.Etale.stableUnderComposition ψ₁ hom_3.hom hψ₁_et
          (RingHom.Etale.of_bijective hbij_3)
      refine ⟨⟨C₃, hC₃_et⟩, ?_, ?_⟩
      · intro y hy
        refine (hC₃_range y).mpr ⟨algebraMap (↑E_cat) E₁ (inl_E.hom ⟨y, hy⟩), ?_⟩
        exact (RingHom.congr_fun hρ₁_comp _).trans
          (congrArg (fun g : CommRingCat.of ↥j₁.1 ⟶ CommRingCat.of R_bar => g.hom ⟨y, hy⟩) hinl_ρ)
      · intro y hy
        refine (hC₃_range y).mpr ⟨algebraMap (↑E_cat) E₁ (inr_E.hom ⟨y, hy⟩), ?_⟩
        exact (RingHom.congr_fun hρ₁_comp _).trans
          (congrArg (fun g : CommRingCat.of ↥j₂.1 ⟶ CommRingCat.of R_bar => g.hom ⟨y, hy⟩) hinr_ρ)

    haveI : IsDirectedOrder ℐ_sh := ⟨hDir_sh⟩
    letI : CategoryTheory.SmallCategory ℐ_sh := Preorder.smallCategory ℐ_sh
    letI : CategoryTheory.IsFiltered ℐ_sh := CategoryTheory.isFiltered_of_directed_le_nonempty ℐ_sh
    let S_sh : Subalgebra P R_bar := ⨆ j : ℐ_sh, j.1
    let R_sh : Type u := ↥S_sh
    have hExhaust_sh : ∀ x : R_sh, ∃ j : ℐ_sh, x.1 ∈ j.1 := by
      intro x
      have hdir_K : Directed (· ≤ ·) (fun j : ℐ_sh => j.1) := fun j₁ j₂ => hDir_sh j₁ j₂
      have hmem : x.1 ∈ (⋃ j : ℐ_sh, (j.1 : Set R_bar)) := by
        rw [← Subalgebra.coe_iSup_of_directed hdir_K]
        exact x.2
      exact Set.mem_iUnion.mp hmem

    let D_sh : ℐ_sh ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of ↥j.1
        map := fun θ => CommRingCat.ofHom
          { toFun := fun x => ⟨x.1, (leOfHom θ) x.2⟩
            map_one' := rfl
            map_mul' := fun _ _ => rfl
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ => by apply CommRingCat.hom_ext; ext x; rfl
        map_comp := fun _ _ => by apply CommRingCat.hom_ext; ext x; rfl }
    let α_sh : (CategoryTheory.Functor.const ℐ_sh).obj (CommRingCat.of P) ⟶ D_sh :=
      { app := fun j => pHom j.1
        naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext p; rfl }
    let leg_sh : ∀ j : ℐ_sh, ↑(D_sh.obj j) →+* R_sh := fun j =>
      { toFun := fun x => ⟨x.1, (le_iSup (fun i : ℐ_sh => i.1) j) x.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let c_sh : CategoryTheory.Limits.Cocone D_sh :=
      { pt := CommRingCat.of R_sh
        ι :=
          { app := fun j => CommRingCat.ofHom (leg_sh j)
            naturality := fun _ _ _ => by apply CommRingCat.hom_ext; ext x; rfl } }
    let hc_sh : CategoryTheory.Limits.IsColimit c_sh :=
      { desc := fun s =>
          let jOf : R_sh → ℐ_sh := fun y => Classical.choose (hExhaust_sh y)
          let memOf : ∀ y : R_sh, y.1 ∈ (jOf y).1 :=
            fun y => Classical.choose_spec (hExhaust_sh y)
          have hIndep : ∀ (y : R_sh) (j : ℐ_sh) (x : ↑(D_sh.obj j)),
              x.1 = y.1 → (s.ι.app j).hom x = (s.ι.app (jOf y)).hom ⟨y.1, memOf y⟩ := by
            intro y j x hx
            obtain ⟨m, hjm, hjym⟩ := directed_of (· ≤ ·) j (jOf y)
            have h1 := congrArg (fun g : D_sh.obj j ⟶ s.pt => g.hom x) (s.w (homOfLE hjm))
            have h2 := congrArg (fun g : D_sh.obj (jOf y) ⟶ s.pt => g.hom ⟨y.1, memOf y⟩)
              (s.w (homOfLE hjym))
            have heq_m : (D_sh.map (homOfLE hjm)).hom x =
                (D_sh.map (homOfLE hjym)).hom ⟨y.1, memOf y⟩ := Subtype.ext hx
            exact h1.symm.trans ((congrArg (s.ι.app m).hom heq_m).trans h2)
          CommRingCat.ofHom
            { toFun := fun y => (s.ι.app (jOf y)).hom ⟨y.1, memOf y⟩
              map_one' := (hIndep 1 j_bot 1 rfl).symm.trans (map_one (s.ι.app j_bot).hom)
              map_mul' := fun y₁ y₂ => by
                obtain ⟨m, hm₁, hm₂⟩ := directed_of (· ≤ ·) (jOf y₁) (jOf y₂)
                let x₁ : ↑(D_sh.obj m) := ⟨y₁.1, hm₁ (memOf y₁)⟩
                let x₂ : ↑(D_sh.obj m) := ⟨y₂.1, hm₂ (memOf y₂)⟩
                exact (hIndep (y₁ * y₂) m (x₁ * x₂) rfl).symm.trans
                  ((map_mul (s.ι.app m).hom x₁ x₂).trans
                    (congrArg₂ (· * ·) (hIndep y₁ m x₁ rfl) (hIndep y₂ m x₂ rfl)))
              map_zero' := (hIndep 0 j_bot 0 rfl).symm.trans (map_zero (s.ι.app j_bot).hom)
              map_add' := fun y₁ y₂ => by
                obtain ⟨m, hm₁, hm₂⟩ := directed_of (· ≤ ·) (jOf y₁) (jOf y₂)
                let x₁ : ↑(D_sh.obj m) := ⟨y₁.1, hm₁ (memOf y₁)⟩
                let x₂ : ↑(D_sh.obj m) := ⟨y₂.1, hm₂ (memOf y₂)⟩
                exact (hIndep (y₁ + y₂) m (x₁ + x₂) rfl).symm.trans
                  ((map_add (s.ι.app m).hom x₁ x₂).trans
                    (congrArg₂ (· + ·) (hIndep y₁ m x₁ rfl) (hIndep y₂ m x₂ rfl))) }
        fac := fun s j => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro x
          let jOf : R_sh → ℐ_sh := fun y => Classical.choose (hExhaust_sh y)
          let memOf : ∀ y : R_sh, y.1 ∈ (jOf y).1 :=
            fun y => Classical.choose_spec (hExhaust_sh y)
          change (s.ι.app (jOf (leg_sh j x))).hom ⟨x.1, memOf (leg_sh j x)⟩ =
            (s.ι.app j).hom x
          obtain ⟨m, hjm, hjym⟩ := directed_of (· ≤ ·) j (jOf (leg_sh j x))
          have h1 := congrArg (fun g : D_sh.obj j ⟶ s.pt => g.hom x) (s.w (homOfLE hjm))
          have h2 := congrArg (fun g : D_sh.obj (jOf (leg_sh j x)) ⟶ s.pt =>
            g.hom ⟨x.1, memOf (leg_sh j x)⟩) (s.w (homOfLE hjym))
          have heq_m : (D_sh.map (homOfLE hjm)).hom x =
              (D_sh.map (homOfLE hjym)).hom ⟨x.1, memOf (leg_sh j x)⟩ := rfl
          exact h2.symm.trans ((congrArg (s.ι.app m).hom heq_m.symm).trans h1)
        uniq := fun s m hm => by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro y
          let j_y : ℐ_sh := Classical.choose (hExhaust_sh y)
          let hy : y.1 ∈ j_y.1 := Classical.choose_spec (hExhaust_sh y)
          have hleg_eq : leg_sh j_y ⟨y.1, hy⟩ = y := Subtype.ext rfl
          have hm_app := congrArg (fun g : D_sh.obj j_y ⟶ s.pt => g.hom ⟨y.1, hy⟩) (hm j_y)
          change m.hom y = (s.ι.app j_y).hom ⟨y.1, hy⟩
          conv_lhs => rw [← hleg_eq]
          exact hm_app }

    let f_sh : CommRingCat.of P ⟶ CommRingCat.of R_sh := pHom S_sh
    let ι_sh : CommRingCat.of R_sh ⟶ CommRingCat.of R_bar :=
      CommRingCat.ofHom S_sh.val.toRingHom

    
    have hInvInEtaleStage : ∀ (A_t : Type u) [CommRing A_t]
        (ψ_t : P →+* A_t) (ι_t : A_t →+* R_bar) (x_t : A_t),
        ψ_t.Etale →
        Function.Injective ι_t →
        ι_t.comp ψ_t = algebraMap P R_bar →
        IsUnit (ι_t x_t) →
        ∃ (C_sub : Subalgebra P R_bar) (inv_val : R_bar),
          (pHom C_sub).hom.Etale ∧ inv_val ∈ C_sub ∧ ι_t x_t * inv_val = 1 := by
      clear * - hRangeSubalg
      intro A_t _ ψ_t ι_t x_t hψ_et hι_inj hι_P hu_bar
      let C_x := Localization.Away x_t
      have hx_units : ∀ y : ↥(Submonoid.powers x_t), IsUnit (ι_t y.1) := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow]
        exact hu_bar.pow n
      let ρ_x : C_x →+* R_bar :=
        IsLocalization.lift (M := Submonoid.powers x_t) (S := C_x) (g := ι_t) hx_units
      have hρx_eq : ∀ a : A_t, ρ_x (algebraMap A_t C_x a) = ι_t a :=
        IsLocalization.lift_eq (M := Submonoid.powers x_t) (S := C_x) hx_units
      have hρx_inj : Function.Injective ρ_x := by
        rw [injective_iff_map_eq_zero]
        intro z hz0
        obtain ⟨⟨a, s⟩, hsx⟩ := IsLocalization.surj (Submonoid.powers x_t) z
        dsimp only at hsx
        have h1 := congrArg ρ_x hsx
        rw [map_mul, hz0, zero_mul, hρx_eq] at h1
        have ha0 : a = 0 := hι_inj (h1.symm.trans (map_zero ι_t).symm)
        rw [ha0, map_zero] at hsx
        exact (IsLocalization.map_units C_x s).mul_left_eq_zero.mp hsx
      have h_et_AtCx : Algebra.Etale A_t C_x :=
        @Algebra.Etale.of_isLocalizationAway A_t C_x _ _ _ x_t _
      let ψ_Cx : P →+* C_x := (algebraMap A_t C_x).comp ψ_t
      have hψ_Cx_et : ψ_Cx.Etale :=
        RingHom.Etale.stableUnderComposition ψ_t (algebraMap A_t C_x) hψ_et
          (RingHom.etale_algebraMap.mpr h_et_AtCx)
      have hρx_P : ρ_x.comp ψ_Cx = algebraMap P R_bar := by
        apply RingHom.ext
        intro p
        exact (hρx_eq (ψ_t p)).trans (RingHom.congr_fun hι_P p)
      obtain ⟨C_sub, hom_x, hCx_range, hbij_x, _, hcomp_x⟩ :=
        hRangeSubalg C_x ψ_Cx ρ_x hρx_inj hρx_P
      have hCsub_et : (pHom C_sub).hom.Etale := by
        rw [← hcomp_x]
        exact RingHom.Etale.stableUnderComposition ψ_Cx hom_x.hom hψ_Cx_et
          (RingHom.Etale.of_bijective hbij_x)
      refine ⟨C_sub, ρ_x (IsLocalization.Away.invSelf x_t), hCsub_et,
        (hCx_range _).mpr ⟨IsLocalization.Away.invSelf x_t, rfl⟩, ?_⟩
      rw [← hρx_eq x_t, ← map_mul, IsLocalization.Away.mul_invSelf, map_one]

    have hUnit_Rsh : ∀ x : R_sh, IsUnit x ↔ x.1 ∉ IsLocalRing.maximalIdeal R_bar := by
      intro x
      constructor
      · intro hx
        exact IsLocalRing.notMem_maximalIdeal.mpr (hx.map ι_sh.hom)
      · intro hx_not
        have hu_bar : IsUnit x.1 := IsLocalRing.notMem_maximalIdeal.mp hx_not
        obtain ⟨j, hxj⟩ := hExhaust_sh x
        let ι_j : ↑(CommRingCat.of ↥j.1) →+* R_bar :=
          (CommRingCat.ofHom j.1.val.toRingHom : CommRingCat.of ↥j.1 ⟶ CommRingCat.of R_bar).hom
        obtain ⟨C_sub, inv_val, hCsub_et, hinv_C, hmul1⟩ :=
          hInvInEtaleStage (↑(CommRingCat.of ↥j.1)) (pHom j.1).hom ι_j ⟨x.1, hxj⟩
            j.2 Subtype.val_injective (RingHom.ext fun _ => rfl) hu_bar
        let j_x : ℐ_sh := ⟨C_sub, hCsub_et⟩
        have hinv_S : inv_val ∈ S_sh := (le_iSup (fun i : ℐ_sh => i.1) j_x) hinv_C
        have hprod : x * ⟨inv_val, hinv_S⟩ = 1 := Subtype.ext hmul1
        exact ⟨⟨x, ⟨inv_val, hinv_S⟩, hprod, mul_comm x ⟨inv_val, hinv_S⟩ ▸ hprod⟩, rfl⟩

    have hLoc_Rsh : IsLocalRing R_sh := IsLocalRing.of_nonunits_add (fun a b ha hb => by
      rw [mem_nonunits_iff] at ha hb ⊢
      have ha_m : a.1 ∈ IsLocalRing.maximalIdeal R_bar := by
        by_contra hnot; exact ha ((hUnit_Rsh a).mpr hnot)
      have hb_m : b.1 ∈ IsLocalRing.maximalIdeal R_bar := by
        by_contra hnot; exact hb ((hUnit_Rsh b).mpr hnot)
      intro hab_u
      exact ((hUnit_Rsh (a + b)).mp hab_u) ((IsLocalRing.maximalIdeal R_bar).add_mem ha_m hb_m))

    
    have hHenselAndAlgClosed : ∀ (J_idx : Type u) [Preorder J_idx]
        (j₀ : J_idx) (hDir_J : ∀ j₁ j₂ : J_idx, ∃ j₃ : J_idx, j₁ ≤ j₃ ∧ j₂ ≤ j₃)
        (Obj_J : J_idx → Type u) [∀ j, CommRing (Obj_J j)]
        (map_J : ∀ {j₁ j₂ : J_idx}, j₁ ≤ j₂ → (Obj_J j₁ →+* Obj_J j₂))
        (ψ_J : ∀ j : J_idx, P →+* Obj_J j)
        (ι_J : ∀ j : J_idx, Obj_J j →+* R_bar)
        (R_s : Type u) [CommRing R_s] [IsDomain R_s] [IsLocalRing R_s]
        (p_Rs : P →+* R_s) (ι_Rs : R_s →+* R_bar)
        (leg_s : ∀ j : J_idx, Obj_J j →+* R_s),
        (∀ j : J_idx, (ψ_J j).Etale) →
        (∀ j : J_idx, (ι_J j).comp (ψ_J j) = algebraMap P R_bar) →
        Function.Injective ι_Rs →
        ι_Rs.comp p_Rs = algebraMap P R_bar →
        (∀ j : J_idx, ι_Rs.comp (leg_s j) = ι_J j) →
        (∀ {j₁ j₂ : J_idx} (hle : j₁ ≤ j₂) (x : Obj_J j₁),
          ι_J j₂ (map_J hle x) = ι_J j₁ x) →
        (∀ y : R_s, ∃ j : J_idx, ∃ x : Obj_J j, leg_s j x = y) →
        (∀ (C_sub : Subalgebra P R_bar), (pHom C_sub).hom.Etale →
          ∀ r ∈ C_sub, ∃ a : R_s, ι_Rs a = r) →
        (∀ y : R_s, IsUnit y ↔ ι_Rs y ∉ IsLocalRing.maximalIdeal R_bar) →
        (∀ y : R_s, ι_Rs y ∈ IsLocalRing.maximalIdeal R_bar ↔
          y ∈ IsLocalRing.maximalIdeal R_s) ∧
        IsAlgClosed (IsLocalRing.ResidueField R_s) ∧
        ∃ (_ : HenselianLocalRing R_s), True := by
      clear * - hε_ker hε_C hSumDegLt hStandardEtaleStep
      intro J_idx _ j₀ hDir_J Obj_J _ map_J ψ_J ι_J R_s _ _ _ p_Rs ι_Rs leg_s
        hψJ_et hιJ_P hι_inj hι_P hleg_comp hmap_val hSurj_leg hLift_mem hUnit_Rs
      have hι_max : ∀ y : R_s,
          ι_Rs y ∈ IsLocalRing.maximalIdeal R_bar ↔ y ∈ IsLocalRing.maximalIdeal R_s := by
        intro y
        conv_rhs => rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hUnit_Rs y, not_not]
      have hAlgClosed_Rs : IsAlgClosed (IsLocalRing.ResidueField R_s) := by
        let ε_sh : R_s →+* k := ε_bar.comp ι_Rs
        have hker_sh : IsLocalRing.maximalIdeal R_s ≤ RingHom.ker ε_sh := by
          intro x hx
          rw [RingHom.mem_ker]
          change ε_bar (ι_Rs x) = 0
          rw [← RingHom.mem_ker, hε_ker]
          exact (hι_max x).mpr hx
        let π_res : IsLocalRing.ResidueField R_s →+* k :=
          Ideal.Quotient.lift (IsLocalRing.maximalIdeal R_s) ε_sh hker_sh
        have hπ_inj : Function.Injective π_res := RingHom.injective π_res
        have hπ_surj : Function.Surjective π_res := by
          intro c
          refine ⟨IsLocalRing.residue R_s (p_Rs (Polynomial.C c)), ?_⟩
          change ε_bar ((ι_Rs.comp p_Rs) (Polynomial.C c)) = c
          rw [hι_P]
          exact RingHom.congr_fun hε_C c
        let e_res_sh : IsLocalRing.ResidueField R_s ≃+* k :=
          RingEquiv.ofBijective π_res ⟨hπ_inj, hπ_surj⟩
        refine IsAlgClosed.of_exists_root _ fun p _ hp_irr => ?_
        let p_k : Polynomial k := p.map π_res
        have hp_deg : p_k.degree ≠ 0 := by
          dsimp [p_k]
          rw [Polynomial.degree_map_eq_of_injective hπ_inj]
          exact ne_of_gt (Irreducible.degree_pos hp_irr)
        obtain ⟨c, hc⟩ := IsAlgClosed.exists_root p_k hp_deg
        refine ⟨e_res_sh.symm c, ?_⟩
        apply hπ_inj
        rw [map_zero]
        have hπ_symm : π_res (e_res_sh.symm c) = c := e_res_sh.apply_symm_apply c
        have hev : π_res (Polynomial.eval (e_res_sh.symm c) p) = Polynomial.eval c p_k := by
          dsimp [p_k]
          rw [Polynomial.eval_map]
          conv_rhs => rw [← hπ_symm]
          rw [← Polynomial.eval₂_id,
            Polynomial.hom_eval₂ p (RingHom.id _) π_res (e_res_sh.symm c),
            RingHom.comp_id]
        exact hev.trans hc

      have hFinBound_J : ∀ (m : ℕ) (g : Fin m → J_idx),
          ∃ j : J_idx, ∀ i : Fin m, g i ≤ j := by
        intro m
        induction m with
        | zero => exact fun _ => ⟨j₀, fun i => Fin.elim0 i⟩
        | succ m ih =>
          intro g
          obtain ⟨j_init, hj_init⟩ := ih (fun i => g i.castSucc)
          obtain ⟨j₁, hj_init_le, hlast_le⟩ := hDir_J j_init (g (Fin.last m))
          refine ⟨j₁, fun i => ?_⟩
          exact Fin.lastCases (motive := fun i => g i ≤ j₁) hlast_le
            (fun i' => le_trans (hj_init i') hj_init_le) i

      have hHensel_Rs : HenselianLocalRing R_s := HenselianLocalRing.mk
          (fun F hF_mon a₀ ha₀ hderiv => by
        let F_bar : Polynomial R_bar := F.map ι_Rs
        have hFbar_mon : F_bar.Monic := hF_mon.map ι_Rs
        have ha₀_bar : F_bar.eval (ι_Rs a₀) ∈ IsLocalRing.maximalIdeal R_bar := by
          have hev : F_bar.eval (ι_Rs a₀) = ι_Rs (F.eval a₀) := by
            dsimp [F_bar]
            rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
          rw [hev]
          exact (hι_max _).mpr ha₀
        have hderiv_bar : IsUnit (F_bar.derivative.eval (ι_Rs a₀)) := by
          have hder : F_bar.derivative = F.derivative.map ι_Rs :=
            Polynomial.derivative_map F ι_Rs
          rw [hder, Polynomial.eval_map, Polynomial.eval₂_at_apply]
          exact hderiv.map ι_Rs
        obtain ⟨r, hr_root, hr_diff⟩ :=
          HenselianLocalRing.is_henselian F_bar hFbar_mon (ι_Rs a₀) ha₀_bar hderiv_bar
        have hr_deriv_unit : IsUnit (F_bar.derivative.eval r) := by
          apply IsLocalRing.notMem_maximalIdeal.mp
          intro hmem
          have hres_eq : IsLocalRing.residue R_bar r = IsLocalRing.residue R_bar (ι_Rs a₀) :=
            Ideal.Quotient.eq.mpr hr_diff
          have hres_der : IsLocalRing.residue R_bar (F_bar.derivative.eval r) =
              IsLocalRing.residue R_bar (F_bar.derivative.eval (ι_Rs a₀)) := by
            rw [← Polynomial.eval₂_id, ← Polynomial.eval₂_id (x := ι_Rs a₀),
              Polynomial.hom_eval₂ F_bar.derivative (RingHom.id R_bar) (IsLocalRing.residue R_bar) r,
              Polynomial.hom_eval₂ F_bar.derivative (RingHom.id R_bar) (IsLocalRing.residue R_bar)
                (ι_Rs a₀),
              hres_eq]
          have hres0 : IsLocalRing.residue R_bar (F_bar.derivative.eval (ι_Rs a₀)) = 0 := by
            rw [← hres_der]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem
          exact (hderiv_bar.map (IsLocalRing.residue R_bar)).ne_zero hres0

        let n := F.natDegree
        let j_m : Fin n → J_idx := fun m => Classical.choose (hSurj_leg (F.coeff m.1))
        let x_m : ∀ m : Fin n, Obj_J (j_m m) :=
          fun m => Classical.choose (Classical.choose_spec (hSurj_leg (F.coeff m.1)))
        have hx_m : ∀ m : Fin n, leg_s (j_m m) (x_m m) = F.coeff m.1 :=
          fun m => Classical.choose_spec (Classical.choose_spec (hSurj_leg (F.coeff m.1)))
        obtain ⟨j, hj_all⟩ := hFinBound_J n j_m
        let c_j : Fin n → Obj_J j := fun m => map_J (hj_all m) (x_m m)
        have hleg_cj : ∀ m : Fin n, leg_s j (c_j m) = F.coeff m.1 := by
          intro m
          apply hι_inj
          have h1 := RingHom.congr_fun (hleg_comp j) (c_j m)
          have h2 := RingHom.congr_fun (hleg_comp (j_m m)) (x_m m)
          rw [RingHom.comp_apply] at h1 h2
          rw [h1, hmap_val (hj_all m) (x_m m), ← h2, hx_m m]
        let F_j : Polynomial (Obj_J j) :=
          Polynomial.X ^ n + ∑ m : Fin n, Polynomial.C (c_j m) * Polynomial.X ^ m.1
        have hFj_mon : F_j.Monic := Polynomial.monic_X_pow_add (hSumDegLt n c_j)
        have hFj_map_Rs : F_j.map (leg_s j) = F := by
          conv_rhs => rw [Polynomial.as_sum_range_C_mul_X_pow F]
          rw [Finset.sum_range_succ, add_comm]
          have hlc : F.coeff n = 1 := hF_mon.coeff_natDegree
          dsimp [n] at hlc ⊢
          rw [hlc, map_one, one_mul,
            ← Fin.sum_univ_eq_sum_range (fun m => Polynomial.C (F.coeff m) * Polynomial.X ^ m) n]
          dsimp [F_j]
          simp only [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_sum,
            Polynomial.map_mul, Polynomial.map_C]
          congr 1
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [hleg_cj m]
        have hFj_map_Rbar : F_j.map (ι_J j) = F_bar := by
          dsimp [F_bar]
          rw [← hFj_map_Rs, Polynomial.map_map, hleg_comp j]

        obtain ⟨C_lift, hClift_et, hr_C⟩ :=
          hStandardEtaleStep (Obj_J j) (ψ_J j) (ι_J j) F_j r (hψJ_et j) (hιJ_P j) hFj_mon
            (by rw [hFj_map_Rbar]; exact hr_root)
            (by rw [hFj_map_Rbar]; exact hr_deriv_unit)
        obtain ⟨a_sh, ha_sh⟩ := hLift_mem C_lift hClift_et r hr_C
        refine ⟨a_sh, ?_, ?_⟩
        · rw [Polynomial.IsRoot.def]
          apply hι_inj
          rw [map_zero, ← Polynomial.eval₂_id,
            Polynomial.hom_eval₂ F (RingHom.id R_s) ι_Rs a_sh,
            RingHom.comp_id, ← Polynomial.eval_map, ha_sh]
          exact hr_root
        · apply (hι_max (a_sh - a₀)).mp
          rw [map_sub, ha_sh]
          exact hr_diff)
      exact ⟨hι_max, hAlgClosed_Rs, hHensel_Rs, trivial⟩

    obtain ⟨hι_sh_max, hAlgClosed_Rsh, hHensel_Rsh, -⟩ :=
      @hHenselAndAlgClosed ℐ_sh _ j_bot hDir_sh
        (fun j => ↑(D_sh.obj j)) (fun _ => inferInstance)
        (fun hle => (D_sh.map (homOfLE hle)).hom)
        (fun j => (pHom j.1).hom)
        (fun j => (CommRingCat.ofHom j.1.val.toRingHom :
          CommRingCat.of ↥j.1 ⟶ CommRingCat.of R_bar).hom)
        R_sh _ _ hLoc_Rsh f_sh.hom ι_sh.hom leg_sh
        (fun j => j.2)
        (fun _ => RingHom.ext fun _ => rfl)
        Subtype.val_injective
        (RingHom.ext fun _ => rfl)
        (fun _ => RingHom.ext fun _ => rfl)
        (fun _ _ => rfl)
        (fun y => by
          obtain ⟨j, hy⟩ := hExhaust_sh y
          exact ⟨j, ⟨y.1, hy⟩, Subtype.ext rfl⟩)
        (fun C_sub hEt r hr =>
          ⟨⟨r, (le_iSup (fun i : ℐ_sh => i.1) ⟨C_sub, hEt⟩) hr⟩, rfl⟩)
        hUnit_Rsh

    refine ⟨ℐ_sh, inferInstance, inferInstance, D_sh, α_sh, R_sh, inferInstance, inferInstance,
      hHensel_Rsh, hAlgClosed_Rsh, f_sh, ι_sh, c_sh, hc_sh, CategoryTheory.Iso.refl _,
      ?_, Subtype.val_injective, hι_sh_max, ?_⟩
    · apply CommRingCat.hom_ext
      apply RingHom.ext
      intro p
      rfl
    · intro j
      refine ⟨j.2, inferInstance, ?_, Subtype.val_injective, ?_⟩
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        rfl
      · refine ⟨CommRingCat.ofHom (ε_bar.comp j.1.val.toRingHom), ?_⟩
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        exact RingHom.congr_fun hε_P p

theorem weil_val_ring_acyclic_etale_chart_stage_descent (k : Type u) [Field k]
    (d_rel ℓ : ℕ) (hℓ_pos : 1 ≤ ℓ)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial k →+* R_bar)
    (t_bar : R_bar) (ht_eq : p_R Polynomial.X = t_bar)
    (Ω : Type u) [Field Ω]
    (φ_R_Ω : R_bar →+* Ω)
    (hLoc_Ω : @IsLocalization.Away R_bar _ t_bar Ω _ φ_R_Ω.toAlgebra)
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D : ℐ ⥤ CommRingCat.{u})
    (α : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial k)) ⟶ D)
    (c : CategoryTheory.Limits.Cocone D) (hc : CategoryTheory.Limits.IsColimit c)
    (e_pt : c.pt ≅ CommRingCat.of R_bar)
    (hCocone_eq : ∀ i : ℐ, (α.app i) ≫ (c.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R)
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D.obj i)) (u : (↑(D.obj i))ˣ) (e : ℕ)
        (ψ_i : Polynomial k →+* ↑(D.obj i)),
        1 ≤ e ∧
        ((c.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
        (α.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D.obj i₁))
          (ψ₁ : Polynomial k →+* ↑(D.obj i₁)),
          (D.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale) :
    let S_d := weilAffineSpaceOver k d_rel
    let U₀ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ U₀ := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let κ_A1 : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Polynomial.aeval ((Polynomial.X : Polynomial k) ^ ℓ)).toRingHom))
    let p_A1 : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
    let U_d := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let j_d : U_d ⟶ Y_d :=
      CategoryTheory.Limits.pullback.snd j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let A_R := CategoryTheory.Limits.pullback S_d.hom g_k_R
    let A_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    let j_A : A_Ω ⟶ A_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R)
    ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ A_R) [AlgebraicGeometry.Etale w],
      ∃ (𝒥 : Type u) (_ : CategoryTheory.SmallCategory 𝒥) (_ : CategoryTheory.IsFiltered 𝒥)
        (E_diag E_loc : 𝒥 ⥤ CommRingCat.{u})
        (ι_loc : E_diag ⟶ E_loc)
        (c_E : CategoryTheory.Limits.Cocone E_diag) (_ : CategoryTheory.Limits.IsColimit c_E)
        (c_Eloc : CategoryTheory.Limits.Cocone E_loc) (_ : CategoryTheory.Limits.IsColimit c_Eloc)
        (ι_inf : c_E.pt ⟶ c_Eloc.pt)
        (e_W : AlgebraicGeometry.Spec c_E.pt ≅ W)
        (e_WU : AlgebraicGeometry.Spec c_Eloc.pt ≅ CategoryTheory.Limits.pullback j_A w),
        (∀ j : 𝒥, c_E.ι.app j ≫ ι_inf = ι_loc.app j ≫ c_Eloc.ι.app j) ∧
        e_WU.hom ≫ CategoryTheory.Limits.pullback.snd j_A w =
          AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom ∧
        ∀ j : 𝒥,
          ∃ (w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d)
            (_ : AlgebraicGeometry.Etale w_j)
            (ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅ CategoryTheory.Limits.pullback j_d w_j),
            ϕ_j.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
              AlgebraicGeometry.Spec.map (ι_loc.app j) ∧
            ∃ (j₁ : 𝒥) (θ_U : j ⟶ j₁)
              (w₁ : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶ Y_d)
              (_ : AlgebraicGeometry.Etale w₁)
              (ϕ₁ : AlgebraicGeometry.Spec (E_loc.obj j₁) ≅ CategoryTheory.Limits.pullback j_d w₁),
              ϕ₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁ =
                AlgebraicGeometry.Spec.map (ι_loc.app j₁) ∧
              let π_W : AlgebraicGeometry.Spec (E_diag.obj j₁) ⟶
                  AlgebraicGeometry.Spec (E_diag.obj j) :=
                AlgebraicGeometry.Spec.map (E_diag.map θ_U)
              let π_WU : CategoryTheory.Limits.pullback j_d w₁ ⟶
                  CategoryTheory.Limits.pullback j_d w_j :=
                ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫ ϕ_j.hom
              π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
                w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 ∧
              π_W ≫ w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
                w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 ≫ κ_A1 ∧
              π_WU ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
                CategoryTheory.Limits.pullback.snd j_d w₁ ≫ π_W :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hα_nat_apply : ∀ {i i' : ℐ} (θ : i ⟶ i') (p : Polynomial k),
      (D.map θ).hom ((α.app i).hom p) = (α.app i').hom p := by
    intro i i' θ p
    have h := (Category.id_comp (α.app i')).symm.trans (α.naturality θ)
    exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h) p).symm

  have hEtalePresDescent :
      ∀ (B_diag : ℐ ⥤ CommRingCat.{u})
        (c_B : CategoryTheory.Limits.Cocone B_diag)
        (_ : CategoryTheory.Limits.IsColimit c_B)
        (E_inf : CommRingCat.{u}) (f_E : c_B.pt ⟶ E_inf),
        f_E.hom.Etale →
        ∃ (i₀ : ℐ) (n : ℕ) (J₀ : Ideal (MvPolynomial (Fin n) ↑(B_diag.obj i₀)))
          (g₀ : CommRingCat.of (MvPolynomial (Fin n) ↑(B_diag.obj i₀) ⧸ J₀) ⟶ E_inf),
          (CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C) :
            B_diag.obj i₀ ⟶ CommRingCat.of (MvPolynomial (Fin n) ↑(B_diag.obj i₀) ⧸ J₀)).hom.Etale ∧
          CategoryTheory.IsPushout (c_B.ι.app i₀)
            (CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)) f_E g₀ := by
    intro B_diag c_B hc_B E_inf f_E hf_E
    let F_fgt := CategoryTheory.forget CommRingCat.{u}
    let hc_type : CategoryTheory.Limits.IsColimit (F_fgt.mapCocone c_B) :=
      CategoryTheory.Limits.isColimitOfPreserves F_fgt hc_B
    have hNonemptyℐ : Nonempty ℐ := CategoryTheory.IsFiltered.nonempty
    have hLiftSet₀ : ∀ {α₀ : Type} (S : Finset α₀) (x : α₀ → ↑c_B.pt),
        ∃ (i : ℐ) (y : α₀ → ↑(B_diag.obj i)),
          ∀ a ∈ S, (CommRingCat.Hom.hom (c_B.ι.app i)) (y a) = x a := by
      intro α₀ S x
      induction S using Finset.induction_on with
      | empty =>
        obtain ⟨i₀⟩ := hNonemptyℐ
        exact ⟨i₀, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' ha₀ ih =>
        obtain ⟨i₁, y₁, hy₁⟩ := ih
        obtain ⟨i₂, z, hz⟩ :=
          CategoryTheory.Limits.Types.jointly_surjective (B_diag ⋙ F_fgt) hc_type (x a₀)
        have hz' : (CommRingCat.Hom.hom (c_B.ι.app i₂)) z = x a₀ := hz
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun a => if a = a₀ then (CommRingCat.Hom.hom (B_diag.map u₂)) z
            else (CommRingCat.Hom.hom (B_diag.map u₁)) (y₁ a), ?_⟩
        intro a ha
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · simp only [↓reduceIte]
          have hw₂ := congrArg (fun fn => (CommRingCat.Hom.hom fn) z) (c_B.w u₂)
          exact hw₂.trans hz'
        · have hne : a ≠ a₀ := fun h => ha₀ (h ▸ haS')
          simp only [hne, ↓reduceIte]
          have hw₁ := congrArg (fun fn => (CommRingCat.Hom.hom fn) (y₁ a)) (c_B.w u₁)
          exact hw₁.trans (hy₁ a haS')
    have hZeroSet₀ : ∀ {α₀ : Type} (S : Finset α₀) (i₁ : ℐ) (y : α₀ → ↑(B_diag.obj i₁)),
        (∀ a ∈ S, (CommRingCat.Hom.hom (c_B.ι.app i₁)) (y a) = 0) →
        ∃ (i₀ : ℐ) (θ : i₁ ⟶ i₀), ∀ a ∈ S, (CommRingCat.Hom.hom (B_diag.map θ)) (y a) = 0 := by
      intro α₀ S i₁ y hy
      induction S using Finset.induction_on with
      | empty =>
        exact ⟨i₁, 𝟙 i₁, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert a₀ S' _ ih =>
        obtain ⟨i₂, θ₁, hθ₁⟩ := ih (fun a ha => hy a (Finset.mem_insert_of_mem ha))
        have h_eq₀ : (CategoryTheory.ConcreteCategory.hom ((F_fgt.mapCocone c_B).ι.app i₂))
            ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) =
          (CategoryTheory.ConcreteCategory.hom ((F_fgt.mapCocone c_B).ι.app i₂)) (0 : ↑(B_diag.obj i₂)) := by
          change (CommRingCat.Hom.hom (c_B.ι.app i₂)) ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) =
            (CommRingCat.Hom.hom (c_B.ι.app i₂)) 0
          rw [map_zero]
          have hw := congrArg (fun fn => (CommRingCat.Hom.hom fn) (y a₀)) (c_B.w θ₁)
          exact hw.trans (hy a₀ (Finset.mem_insert_self a₀ S'))
        obtain ⟨i₀, θ₂, hθ₂⟩ :=
          (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hc_type _ _).mp h_eq₀
        have hθ₂' : (CommRingCat.Hom.hom (B_diag.map θ₂)) ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) = 0 := by
          have h₁ : (CommRingCat.Hom.hom (B_diag.map θ₂)) ((CommRingCat.Hom.hom (B_diag.map θ₁)) (y a₀)) =
              (CommRingCat.Hom.hom (B_diag.map θ₂)) 0 := hθ₂
          rwa [map_zero] at h₁
        refine ⟨i₀, θ₁ ≫ θ₂, ?_⟩
        intro a ha
        rw [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
        rcases Finset.mem_insert.mp ha with rfl | haS'
        · exact hθ₂'
        · rw [hθ₁ a haS', map_zero]
    have hLiftPoly : ∀ {n : ℕ} (p : MvPolynomial (Fin n) ↑c_B.pt),
        ∃ (i : ℐ) (p_lift : MvPolynomial (Fin n) ↑(B_diag.obj i)),
          MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i)) p_lift = p := by
      intro n p
      obtain ⟨i, y, hy⟩ := hLiftSet₀ p.support (fun m => p.coeff m)
      refine ⟨i, ∑ m ∈ p.support, MvPolynomial.monomial m (y m), ?_⟩
      ext m
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_sum]
      simp only [MvPolynomial.coeff_monomial]
      by_cases hm : m ∈ p.support
      · rw [Finset.sum_eq_single m
          (fun x _ hxm => by simp only [hxm, ↓reduceIte])
          (fun h => absurd hm h)]
        simp only [↓reduceIte]
        exact hy m hm
      · have hsum0 : (∑ x ∈ p.support, if x = m then y x else 0) = 0 := by
          refine Finset.sum_eq_zero fun x hx => ?_
          have hxm : x ≠ m := fun h => hm (h ▸ hx)
          simp only [hxm, ↓reduceIte]
        rw [hsum0, map_zero, MvPolynomial.notMem_support_iff.mp hm]
    have hLiftPolyFam : ∀ {n r : ℕ} (F : Fin r → MvPolynomial (Fin n) ↑c_B.pt),
        ∃ (i : ℐ) (F_lift : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i)),
          ∀ s : Fin r, MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i)) (F_lift s) = F s := by
      intro n r F
      suffices ∀ (T : Finset (Fin r)),
          ∃ (i : ℐ) (F_lift : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i)),
            ∀ s ∈ T, MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i)) (F_lift s) = F s by
        obtain ⟨i, F_lift, hF⟩ := this Finset.univ
        exact ⟨i, F_lift, fun s => hF s (Finset.mem_univ s)⟩
      intro T
      induction T using Finset.induction_on with
      | empty =>
        obtain ⟨i₀⟩ := hNonemptyℐ
        exact ⟨i₀, fun _ => 0, fun _ h => False.elim (Finset.notMem_empty _ h)⟩
      | insert s₀ T' hs₀ ih =>
        obtain ⟨i₁, F₁, hF₁⟩ := ih
        obtain ⟨i₂, p₂, hp₂⟩ := hLiftPoly (F s₀)
        let i₃ := CategoryTheory.IsFiltered.max i₁ i₂
        let u₁ : i₁ ⟶ i₃ := CategoryTheory.IsFiltered.leftToMax i₁ i₂
        let u₂ : i₂ ⟶ i₃ := CategoryTheory.IsFiltered.rightToMax i₁ i₂
        refine ⟨i₃, fun s => if s = s₀ then MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map u₂)) p₂
            else MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map u₁)) (F₁ s), ?_⟩
        intro s hs
        rcases Finset.mem_insert.mp hs with rfl | hsT'
        · simp only [↓reduceIte, MvPolynomial.map_map]
          have hw₂ : (CommRingCat.Hom.hom (c_B.ι.app i₃)).comp (CommRingCat.Hom.hom (B_diag.map u₂)) =
              CommRingCat.Hom.hom (c_B.ι.app i₂) := by
            rw [← CommRingCat.hom_comp, c_B.w u₂]
          rw [hw₂, hp₂]
        · have hne : s ≠ s₀ := fun h => hs₀ (h ▸ hsT')
          simp only [hne, ↓reduceIte, MvPolynomial.map_map]
          have hw₁ : (CommRingCat.Hom.hom (c_B.ι.app i₃)).comp (CommRingCat.Hom.hom (B_diag.map u₁)) =
              CommRingCat.Hom.hom (c_B.ι.app i₁) := by
            rw [← CommRingCat.hom_comp, c_B.w u₁]
          rw [hw₁, hF₁ s hsT']
    let _ : Algebra ↑c_B.pt ↑E_inf := (CommRingCat.Hom.hom f_E).toAlgebra
    have halg_fE : algebraMap (↑c_B.pt) (↑E_inf) = CommRingCat.Hom.hom f_E := rfl
    have hEt_inf : Algebra.Etale (↑c_B.pt) (↑E_inf) := by
      rw [← RingHom.etale_algebraMap, halg_fE]
      exact hf_E
    have hStd_inf : Algebra.IsStandardSmoothOfRelativeDimension 0 (↑c_B.pt) (↑E_inf) :=
      Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hEt_inf
    obtain ⟨ι_v, σ_v, hFin_σ, hFin_ι, P, hdim⟩ := hStd_inf.out
    let n : ℕ := Nat.card ι_v
    let r : ℕ := Nat.card σ_v
    let e_ι : Fin n ≃ ι_v := (Finite.equivFin ι_v).symm
    let e_σ : Fin r ≃ σ_v := (Finite.equivFin σ_v).symm
    let P₀ : Algebra.SubmersivePresentation (↑c_B.pt) (↑E_inf) (Fin n) (Fin r) :=
      P.reindex e_ι e_σ
    have hdim₀ : P₀.dimension = 0 := by
      rw [← hdim]
      exact P.toPresentation.dimension_reindex e_ι e_σ
    let R_inf : Fin r → MvPolynomial (Fin n) ↑c_B.pt := P₀.relation
    let g_inf : Fin r → MvPolynomial (Fin n) ↑c_B.pt := P₀.jacobianRelations
    let h_inf : MvPolynomial (Fin n) ↑c_B.pt := P₀.σ ↑(P₀.jacobian_isUnit.unit⁻¹)
    have hBezout_inf : ∑ s : Fin r, g_inf s * R_inf s = P₀.jacobiMatrix.det * h_inf - 1 :=
      P₀.jacobianRelations_spec
    obtain ⟨i_R, R_lift_R, hR_lift_R⟩ := hLiftPolyFam R_inf
    obtain ⟨i_g, g_lift_g, hg_lift_g⟩ := hLiftPolyFam g_inf
    obtain ⟨i_h, h_lift_h, hh_lift_h⟩ := hLiftPoly h_inf
    let i_Rg := CategoryTheory.IsFiltered.max i_R i_g
    let u_R : i_R ⟶ i_Rg := CategoryTheory.IsFiltered.leftToMax i_R i_g
    let u_g : i_g ⟶ i_Rg := CategoryTheory.IsFiltered.rightToMax i_R i_g
    let i₁ := CategoryTheory.IsFiltered.max i_Rg i_h
    let u_Rg : i_Rg ⟶ i₁ := CategoryTheory.IsFiltered.leftToMax i_Rg i_h
    let u_h : i_h ⟶ i₁ := CategoryTheory.IsFiltered.rightToMax i_Rg i_h
    let R_tilde : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i₁) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map (u_R ≫ u_Rg))) (R_lift_R s)
    let g_tilde : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i₁) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map (u_g ≫ u_Rg))) (g_lift_g s)
    let h_tilde : MvPolynomial (Fin n) ↑(B_diag.obj i₁) :=
      MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map u_h)) h_lift_h
    have hR_tilde : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) (R_tilde s) = R_inf s := by
      intro s
      dsimp [R_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w (u_R ≫ u_Rg), hR_lift_R s]
    have hg_tilde : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) (g_tilde s) = g_inf s := by
      intro s
      dsimp [g_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w (u_g ≫ u_Rg), hg_lift_g s]
    have hh_tilde :
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) h_tilde = h_inf := by
      dsimp [h_tilde]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w u_h, hh_lift_h]
    let J_mat₁ : Matrix (Fin r) (Fin r) (MvPolynomial (Fin n) ↑(B_diag.obj i₁)) :=
      fun s₁ s₂ => MvPolynomial.pderiv (P₀.map s₁) (R_tilde s₂)
    have hJ_mat₁_map :
        (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁))).mapMatrix J_mat₁ =
          P₀.jacobiMatrix := by
      refine Matrix.ext fun s₁ s₂ => ?_
      change MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁))
        (MvPolynomial.pderiv (P₀.map s₁) (R_tilde s₂)) = P₀.jacobiMatrix s₁ s₂
      rw [← MvPolynomial.pderiv_map, hR_tilde s₂, P₀.jacobiMatrix_apply]
    have hJ_det₁_map :
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) J_mat₁.det =
          P₀.jacobiMatrix.det := by
      rw [RingHom.map_det (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁))) J_mat₁,
        hJ_mat₁_map]
    let Δ₁ : MvPolynomial (Fin n) ↑(B_diag.obj i₁) :=
      (∑ s : Fin r, g_tilde s * R_tilde s) - (J_mat₁.det * h_tilde - 1)
    have hΔ₁_map : MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) Δ₁ = 0 := by
      dsimp [Δ₁]
      rw [map_sub, map_sum, map_sub, map_mul, map_one, hJ_det₁_map, hh_tilde]
      have hsum_eq : (∑ s : Fin r,
          MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₁)) (g_tilde s * R_tilde s)) =
          ∑ s : Fin r, g_inf s * R_inf s := by
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [map_mul, hg_tilde s, hR_tilde s]
      rw [hsum_eq, hBezout_inf, sub_self]
    have hΔ₁_coeff : ∀ m ∈ Δ₁.support,
        (CommRingCat.Hom.hom (c_B.ι.app i₁)) (Δ₁.coeff m) = 0 := by
      intro m _
      rw [← MvPolynomial.coeff_map, hΔ₁_map]
      simp
    obtain ⟨i₀, θ, hθ_zero⟩ := hZeroSet₀ Δ₁.support i₁ (fun m => Δ₁.coeff m) hΔ₁_coeff
    have hΔ₀ : MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ)) Δ₁ = 0 := by
      ext m
      rw [MvPolynomial.coeff_map]
      have h0 : (0 : MvPolynomial (Fin n) ↑(B_diag.obj i₀)).coeff m = 0 := by simp
      rw [h0]
      by_cases hm : m ∈ Δ₁.support
      · exact hθ_zero m hm
      · rw [MvPolynomial.notMem_support_iff.mp hm, map_zero]
    let R₀ : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i₀) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ)) (R_tilde s)
    let g₀_poly : Fin r → MvPolynomial (Fin n) ↑(B_diag.obj i₀) :=
      fun s => MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ)) (g_tilde s)
    let h₀_poly : MvPolynomial (Fin n) ↑(B_diag.obj i₀) :=
      MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ)) h_tilde
    let J₀ : Ideal (MvPolynomial (Fin n) ↑(B_diag.obj i₀)) := Ideal.span (Set.range R₀)
    let Q₀ := MvPolynomial (Fin n) ↑(B_diag.obj i₀) ⧸ J₀
    let f₀ : B_diag.obj i₀ ⟶ CommRingCat.of Q₀ :=
      CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)
    let s₀ : Q₀ → MvPolynomial (Fin n) ↑(B_diag.obj i₀) :=
      Function.surjInv Ideal.Quotient.mk_surjective
    have hs₀ : ∀ x : Q₀, Ideal.Quotient.mk J₀ (s₀ x) = x :=
      Function.surjInv_eq Ideal.Quotient.mk_surjective
    let P_pre₀ : Algebra.PreSubmersivePresentation ↑(B_diag.obj i₀) Q₀ (Fin n) (Fin r) :=
      Algebra.PreSubmersivePresentation.naive (v := R₀) P₀.map P₀.map_inj s₀ hs₀
    let J_mat₀ : Matrix (Fin r) (Fin r) (MvPolynomial (Fin n) ↑(B_diag.obj i₀)) :=
      fun s₁ s₂ => MvPolynomial.pderiv (P₀.map s₁) (R₀ s₂)
    have hJ_mat₀_eq : P_pre₀.jacobiMatrix = J_mat₀ := by
      refine Matrix.ext fun s₁ s₂ => ?_
      exact Algebra.PreSubmersivePresentation.jacobiMatrix_naive (v := R₀)
        P₀.map P₀.map_inj s₀ hs₀ s₁ s₂
    have hJ_mat₁_to_0 :
        (MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ))).mapMatrix J_mat₁ = J_mat₀ := by
      refine Matrix.ext fun s₁ s₂ => ?_
      change MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ))
        (MvPolynomial.pderiv (P₀.map s₁) (R_tilde s₂)) =
        MvPolynomial.pderiv (P₀.map s₁)
          (MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ)) (R_tilde s₂))
      exact MvPolynomial.pderiv_map.symm
    have hJ_det₁_to_0 :
        MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ)) J_mat₁.det = J_mat₀.det := by
      rw [RingHom.map_det (MvPolynomial.map (CommRingCat.Hom.hom (B_diag.map θ))) J_mat₁,
        hJ_mat₁_to_0]
    have hBezout₀ : ∑ s : Fin r, g₀_poly s * R₀ s = J_mat₀.det * h₀_poly - 1 := by
      have hsub : (∑ s : Fin r, g₀_poly s * R₀ s) - (J_mat₀.det * h₀_poly - 1) = 0 := by
        rw [← hΔ₀]
        dsimp [Δ₁, g₀_poly, R₀, h₀_poly]
        rw [map_sub, map_sum, map_sub, map_mul, map_one, hJ_det₁_to_0]
        congr 1
        exact Finset.sum_congr rfl fun s _ => (map_mul _ _ _).symm
      exact sub_eq_zero.mp hsub
    have halg_pre₀_apply : ∀ p : MvPolynomial (Fin n) ↑(B_diag.obj i₀),
        (algebraMap P_pre₀.Ring Q₀) p = Ideal.Quotient.mk J₀ p := by
      have h_aeval : (MvPolynomial.aeval P_pre₀.val).toRingHom = Ideal.Quotient.mk J₀ := by
        apply MvPolynomial.ringHom_ext
        · intro b
          change (MvPolynomial.aeval P_pre₀.val) (MvPolynomial.C b) =
            Ideal.Quotient.mk J₀ (MvPolynomial.C b)
          rw [MvPolynomial.aeval_C]
          rfl
        · intro idx
          change (MvPolynomial.aeval P_pre₀.val) (MvPolynomial.X idx) =
            Ideal.Quotient.mk J₀ (MvPolynomial.X idx)
          rw [MvPolynomial.aeval_X]
          rfl
      intro p
      rw [P_pre₀.algebraMap_apply]
      exact congrArg (fun h : MvPolynomial (Fin n) ↑(B_diag.obj i₀) →+* Q₀ => h p) h_aeval
    have hJac_unit₀ : IsUnit P_pre₀.jacobian := by
      rw [P_pre₀.jacobian_eq_jacobiMatrix_det, halg_pre₀_apply, hJ_mat₀_eq]
      refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk J₀ h₀_poly) ?_
      rw [← map_mul, ← sub_eq_zero]
      have hmk1 : (1 : Q₀) = Ideal.Quotient.mk J₀ 1 := rfl
      rw [hmk1, ← map_sub, ← hBezout₀, map_sum]
      refine Finset.sum_eq_zero fun s _ => ?_
      have hs_mem : R₀ s ∈ J₀ := Ideal.subset_span ⟨s, rfl⟩
      rw [map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hs_mem, mul_zero]
    let P_sub₀ : Algebra.SubmersivePresentation ↑(B_diag.obj i₀) Q₀ (Fin n) (Fin r) :=
      { __ := P_pre₀, jacobian_isUnit := hJac_unit₀ }
    have hdim_sub₀ : P_sub₀.dimension = 0 := hdim₀
    have hStd₀ : Algebra.IsStandardSmoothOfRelativeDimension 0 ↑(B_diag.obj i₀) Q₀ :=
      P_sub₀.isStandardSmoothOfRelativeDimension hdim_sub₀
    have hEt_Q₀ : Algebra.Etale ↑(B_diag.obj i₀) Q₀ :=
      @Algebra.instEtaleOfIsStandardSmoothOfRelativeDimensionOfNatNat _ _ _ _ _ hStd₀
    have hf₀_et : f₀.hom.Etale := by
      change ((Ideal.Quotient.mk J₀).comp MvPolynomial.C).Etale
      have halg_Q₀ : algebraMap (↑(B_diag.obj i₀)) Q₀ = (Ideal.Quotient.mk J₀).comp MvPolynomial.C :=
        rfl
      rw [← halg_Q₀, RingHom.etale_algebraMap]
      exact hEt_Q₀
    let φ_inf : MvPolynomial (Fin n) ↑c_B.pt →+* ↑E_inf := (MvPolynomial.aeval P₀.val).toRingHom
    have hφ_ri : Function.RightInverse P₀.σ' ⇑φ_inf := fun x => P₀.aeval_val_σ' x
    have hker_φ : RingHom.ker φ_inf = Ideal.span (Set.range R_inf) := by
      change RingHom.ker (MvPolynomial.aeval P₀.val) = Ideal.span (Set.range P₀.relation)
      rw [← P₀.ker_eq_ker_aeval_val, P₀.span_range_relation_eq_ker]
    have hR₀_map_inf : ∀ s : Fin r,
        MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)) (R₀ s) = R_inf s := by
      intro s
      dsimp [R₀]
      rw [MvPolynomial.map_map, ← CommRingCat.hom_comp, c_B.w θ, hR_tilde s]
    have hJ₀_le : J₀ ≤ RingHom.ker (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)))) := by
      rw [Ideal.span_le]
      intro x hx
      obtain ⟨s, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, RingHom.comp_apply, hR₀_map_inf s]
      exact RingHom.mem_ker.mp (hker_φ.symm ▸ Ideal.subset_span ⟨s, rfl⟩)
    have hJ₀_zero : ∀ a ∈ J₀,
        (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)))) a = 0 :=
      fun a ha => hJ₀_le ha
    let g₀_bar : Q₀ →+* ↑E_inf :=
      Ideal.Quotient.lift J₀ (φ_inf.comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)))) hJ₀_zero
    let g₀ : CommRingCat.of Q₀ ⟶ E_inf := CommRingCat.ofHom g₀_bar
    have hw_push : c_B.ι.app i₀ ≫ f_E = f₀ ≫ g₀ := by
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro b
      change (CommRingCat.Hom.hom f_E) ((CommRingCat.Hom.hom (c_B.ι.app i₀)) b) =
        g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.C b))
      dsimp [g₀_bar]
      rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_C]
      dsimp [φ_inf]
      rw [MvPolynomial.aeval_C, halg_fE]
    let ψ_of : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        MvPolynomial (Fin n) ↑c_B.pt →+* ↑s.pt :=
      fun s => MvPolynomial.eval₂Hom (CommRingCat.Hom.hom s.inl)
        (fun idx => (CommRingCat.Hom.hom s.inr) (Ideal.Quotient.mk J₀ (MvPolynomial.X idx)))
    have hψ_comp : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        (ψ_of s).comp (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀))) =
          (CommRingCat.Hom.hom s.inr).comp (Ideal.Quotient.mk J₀) := by
      intro s
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [RingHom.comp_apply, MvPolynomial.map_C, ψ_of, MvPolynomial.eval₂Hom_C]
        exact congrArg (fun fn => (CommRingCat.Hom.hom fn) b) s.condition
      · intro idx
        simp only [RingHom.comp_apply, MvPolynomial.map_X, ψ_of, MvPolynomial.eval₂Hom_X']
    have hker_le_ψ : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        RingHom.ker φ_inf ≤ RingHom.ker (ψ_of s) := by
      intro s
      rw [hker_φ, Ideal.span_le]
      intro x hx
      obtain ⟨t, rfl⟩ := hx
      rw [SetLike.mem_coe, RingHom.mem_ker, ← hR₀_map_inf t]
      have h1 := congrArg (fun h => h (R₀ t)) (hψ_comp s)
      simp only [RingHom.comp_apply] at h1
      have ht_mem : R₀ t ∈ J₀ := Ideal.subset_span ⟨t, rfl⟩
      rw [h1, Ideal.Quotient.eq_zero_iff_mem.mpr ht_mem, map_zero]
    let desc_hom : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        ↑E_inf →+* ↑s.pt :=
      fun s => φ_inf.liftOfRightInverse P₀.σ' hφ_ri ⟨ψ_of s, hker_le_ψ s⟩
    let desc_fn : ∀ (s : CategoryTheory.Limits.PushoutCocone (c_B.ι.app i₀) f₀),
        E_inf ⟶ s.pt :=
      fun s => CommRingCat.ofHom (desc_hom s)
    refine ⟨i₀, n, J₀, g₀, hf₀_et, ?_⟩
    refine CategoryTheory.IsPushout.of_isColimit
      (CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_push desc_fn ?_ ?_ ?_)
    · intro s
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro a
      change desc_hom s ((CommRingCat.Hom.hom f_E) a) = (CommRingCat.Hom.hom s.inl) a
      have hfE_a : (CommRingCat.Hom.hom f_E) a = φ_inf (MvPolynomial.C a) := by
        dsimp [φ_inf]
        rw [MvPolynomial.aeval_C, halg_fE]
      rw [hfE_a]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]
      exact MvPolynomial.eval₂Hom_C _ _ a
    · intro s
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro q
      obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
      change desc_hom s (g₀_bar (Ideal.Quotient.mk J₀ p)) =
        (CommRingCat.Hom.hom s.inr) (Ideal.Quotient.mk J₀ p)
      have hg₀_p : g₀_bar (Ideal.Quotient.mk J₀ p) =
          φ_inf (MvPolynomial.map (CommRingCat.Hom.hom (c_B.ι.app i₀)) p) := by
        dsimp [g₀_bar]
        rw [Ideal.Quotient.lift_mk, RingHom.comp_apply]
      rw [hg₀_p]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]
      exact congrArg (fun h => h p) (hψ_comp s)
    · intro s m hm_inl hm_inr
      have hm_comp : (CommRingCat.Hom.hom m).comp φ_inf = ψ_of s := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_C]
          dsimp [φ_inf]
          rw [MvPolynomial.aeval_C, halg_fE]
          exact congrArg (fun fn => (CommRingCat.Hom.hom fn) a) hm_inl
        · intro idx
          simp only [RingHom.comp_apply, ψ_of, MvPolynomial.eval₂Hom_X']
          have hXk : φ_inf (MvPolynomial.X idx) =
              g₀_bar (Ideal.Quotient.mk J₀ (MvPolynomial.X idx)) := by
            dsimp [g₀_bar]
            rw [Ideal.Quotient.lift_mk, RingHom.comp_apply, MvPolynomial.map_X]
          rw [hXk]
          exact congrArg (fun fn => (CommRingCat.Hom.hom fn)
            (Ideal.Quotient.mk J₀ (MvPolynomial.X idx))) hm_inr
      apply CommRingCat.Hom.ext
      apply RingHom.ext
      intro e_el
      change (CommRingCat.Hom.hom m) e_el = desc_hom s e_el
      have he_el := hφ_ri e_el
      conv_lhs => rw [← he_el]
      conv_rhs => rw [← he_el]
      have hlhs : (CommRingCat.Hom.hom m) (φ_inf (P₀.σ' e_el)) = (ψ_of s) (P₀.σ' e_el) :=
        congrArg (fun h => h (P₀.σ' e_el)) hm_comp
      rw [hlhs]
      dsimp [desc_hom]
      rw [RingHom.liftOfRightInverse_comp_apply]

  have hPushMvPoly : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.map φ : MvPolynomial (Fin d_rel) A →+* MvPolynomial (Fin d_rel) B)))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : B →+* MvPolynomial (Fin d_rel) B)))
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : A →+* MvPolynomial (Fin d_rel) A)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro A B _ _ φ
    let f_mv : CommRingCat.of A ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) A) :=
      CommRingCat.ofHom MvPolynomial.C
    let g_mv : CommRingCat.of A ⟶ CommRingCat.of B := CommRingCat.ofHom φ
    let inl_mv : CommRingCat.of (MvPolynomial (Fin d_rel) A) ⟶
        CommRingCat.of (MvPolynomial (Fin d_rel) B) :=
      CommRingCat.ofHom (MvPolynomial.map φ)
    let inr_mv : CommRingCat.of B ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) B) :=
      CommRingCat.ofHom MvPolynomial.C
    have hcomm : f_mv ≫ inl_mv = g_mv ≫ inr_mv := by
      apply CommRingCat.hom_ext; apply RingHom.ext; intro a; exact MvPolynomial.map_C φ a
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_mv inr_mv hcomm) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m))))
        ?_ ?_ ?_
      · intro s; apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
        · intro a
          change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map φ (MvPolynomial.C a)) =
            s.inl.hom (MvPolynomial.C a)
          rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) a).symm
        · intro m
          change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map φ (MvPolynomial.X m)) =
            s.inl.hom (MvPolynomial.X m)
          rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
      · intro s; apply CommRingCat.hom_ext; apply RingHom.ext; intro b
        exact MvPolynomial.eval₂Hom_C s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m)) b
      · intro s m hm_l hm_r; apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
        · intro b
          change m.hom (MvPolynomial.C b) = MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.C b)
          rw [MvPolynomial.eval₂Hom_C]
          exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) b
        · intro idx
          change m.hom (MvPolynomial.X idx) = MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.X idx)
          rw [MvPolynomial.eval₂Hom_X']
          have hX := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l) (MvPolynomial.X idx)
          change m.hom (MvPolynomial.map φ (MvPolynomial.X idx)) = s.inl.hom (MvPolynomial.X idx) at hX
          rwa [MvPolynomial.map_X] at hX
    exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_mv g_mv inl_mv inr_mv
      (CategoryTheory.IsPushout.of_isColimit hColim)

  have hPushLocAway : ∀ {A B S_A S_B : Type u} [CommRing A] [CommRing B] [CommRing S_A] [CommRing S_B]
      [Algebra A S_A] [Algebra B S_B]
      (φ : A →+* B) (a : A) (b : B)
      [IsLocalization.Away a S_A] [IsLocalization.Away b S_B],
      (∀ {R : Type u} [CommRing R] (ρ : B →+* R), IsUnit (ρ (φ a)) ↔ IsUnit (ρ b)) →
      ∃ ψ : S_A →+* S_B,
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B S_B)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A S_A)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    intro A B S_A S_B _ _ _ _ _ _ φ a b _ _ hUnitIff
    let i_A : A →+* S_A := algebraMap A S_A
    let i_B : B →+* S_B := algebraMap B S_B
    have hu_B : IsUnit ((i_B.comp φ) a) :=
      (hUnitIff i_B).mpr (IsLocalization.Away.algebraMap_isUnit b)
    let ψ : S_A →+* S_B := IsLocalization.Away.lift a (g := i_B.comp φ) hu_B
    have hψ_comp : ψ.comp i_A = i_B.comp φ := by
      ext x; exact IsLocalization.Away.lift_eq a hu_B x
    let f_c : CommRingCat.of A ⟶ CommRingCat.of S_A := CommRingCat.ofHom i_A
    let g_c : CommRingCat.of A ⟶ CommRingCat.of B := CommRingCat.ofHom φ
    let inl_c : CommRingCat.of S_A ⟶ CommRingCat.of S_B := CommRingCat.ofHom ψ
    let inr_c : CommRingCat.of B ⟶ CommRingCat.of S_B := CommRingCat.ofHom i_B
    have hcomm : f_c ≫ inl_c = g_c ≫ inr_c := CommRingCat.hom_ext hψ_comp
    have hu_b_of : ∀ s : CategoryTheory.Limits.PushoutCocone f_c g_c, IsUnit (s.inr.hom b) := by
      intro s
      have hcond : s.inl.hom.comp i_A = s.inr.hom.comp φ := congrArg CommRingCat.Hom.hom s.condition
      have h1 : s.inl.hom (i_A a) = s.inr.hom (φ a) := DFunLike.congr_fun hcond a
      exact (hUnitIff s.inr.hom).mp (h1 ▸ (IsLocalization.Away.algebraMap_isUnit (S := S_A) a).map s.inl.hom)
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_c inr_c hcomm) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom (IsLocalization.Away.lift b (g := s.inr.hom) (hu_b_of s)))
        ?_ ?_ ?_
      · intro s
        apply CommRingCat.hom_ext
        apply IsLocalization.ringHom_ext (Submonoid.powers a)
        ext x
        have h1 : ψ (i_A x) = i_B (φ x) := DFunLike.congr_fun hψ_comp x
        change (IsLocalization.Away.lift b (hu_b_of s)) (ψ (i_A x)) = s.inl.hom (i_A x)
        rw [h1]
        exact (IsLocalization.Away.lift_eq b (hu_b_of s) (φ x)).trans
          (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) x).symm
      · intro s
        apply CommRingCat.hom_ext; ext x
        exact IsLocalization.Away.lift_eq b (hu_b_of s) x
      · intro s m _ hm_r
        apply CommRingCat.hom_ext
        apply IsLocalization.ringHom_ext (Submonoid.powers b)
        ext x
        exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) x).trans
          (IsLocalization.Away.lift_eq b (hu_b_of s) x).symm
    exact ⟨ψ, AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_c g_c inl_c inr_c
      (CategoryTheory.IsPushout.of_isColimit hColim)⟩

  have hLocFilteredColim : ∀ (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥] [CategoryTheory.IsFiltered 𝒥]
      (E_d : 𝒥 ⥤ CommRingCat.{u}) (c_d : CategoryTheory.Limits.Cocone E_d),
      CategoryTheory.Limits.IsColimit c_d →
      ∀ (x_lvl : ∀ j : 𝒥, ↑(E_d.obj j)) (x_pt : ↑c_d.pt),
        (∀ {j j' : 𝒥} (φ : j ⟶ j'), (E_d.map φ).hom (x_lvl j) = x_lvl j') →
        (∀ j : 𝒥, (c_d.ι.app j).hom (x_lvl j) = x_pt) →
        ∃ (E_l : 𝒥 ⥤ CommRingCat.{u})
          (ι_l : E_d ⟶ E_l)
          (c_l : CategoryTheory.Limits.Cocone E_l)
          (_ : CategoryTheory.Limits.IsColimit c_l)
          (ι_pt : c_d.pt ⟶ c_l.pt),
          (∀ j : 𝒥, c_d.ι.app j ≫ ι_pt = ι_l.app j ≫ c_l.ι.app j) ∧
          (∃ (hAlg_pt : Algebra ↑c_d.pt ↑c_l.pt) (_ : @IsLocalization.Away ↑c_d.pt _ x_pt ↑c_l.pt _ hAlg_pt),
            ι_pt = CommRingCat.ofHom (@algebraMap ↑c_d.pt ↑c_l.pt _ _ hAlg_pt)) ∧
          (∀ j : 𝒥, ∃ (hAlg_j : Algebra ↑(E_d.obj j) ↑(E_l.obj j))
            (_ : @IsLocalization.Away ↑(E_d.obj j) _ (x_lvl j) ↑(E_l.obj j) _ hAlg_j),
            ι_l.app j = CommRingCat.ofHom (@algebraMap ↑(E_d.obj j) ↑(E_l.obj j) _ _ hAlg_j)) := by
    intro 𝒥 _ _ E_d c_d hc_d x_lvl x_pt hx_map hx_pt
    have hMapEx : ∀ {j j' : 𝒥} (φ : j ⟶ j'),
        ∃ g : Localization.Away (x_lvl j) →+* Localization.Away (x_lvl j'),
          ∀ a : ↑(E_d.obj j),
            g (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) a) =
              algebraMap ↑(E_d.obj j') (Localization.Away (x_lvl j')) ((E_d.map φ).hom a) := by
      intro j j' φ
      have hu : IsUnit (((algebraMap ↑(E_d.obj j') (Localization.Away (x_lvl j'))).comp (E_d.map φ).hom) (x_lvl j)) := by
        change IsUnit (algebraMap ↑(E_d.obj j') (Localization.Away (x_lvl j')) ((E_d.map φ).hom (x_lvl j)))
        rw [hx_map φ]
        exact IsLocalization.Away.algebraMap_isUnit (x_lvl j')
      exact ⟨IsLocalization.Away.lift (x_lvl j) hu, IsLocalization.Away.lift_eq (x_lvl j) hu⟩
    have hLegEx : ∀ (j : 𝒥),
        ∃ g : Localization.Away (x_lvl j) →+* Localization.Away x_pt,
          ∀ a : ↑(E_d.obj j),
            g (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) a) =
              algebraMap ↑c_d.pt (Localization.Away x_pt) ((c_d.ι.app j).hom a) := by
      intro j
      have hu : IsUnit (((algebraMap ↑c_d.pt (Localization.Away x_pt)).comp (c_d.ι.app j).hom) (x_lvl j)) := by
        change IsUnit (algebraMap ↑c_d.pt (Localization.Away x_pt) ((c_d.ι.app j).hom (x_lvl j)))
        rw [hx_pt j]
        exact IsLocalization.Away.algebraMap_isUnit x_pt
      exact ⟨IsLocalization.Away.lift (x_lvl j) hu, IsLocalization.Away.lift_eq (x_lvl j) hu⟩
    let E_l : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := fun j => CommRingCat.of (Localization.Away (x_lvl j))
        map := fun φ => CommRingCat.ofHom (hMapEx φ).choose
        map_id := fun j => by
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j))
          ext x
          change (hMapEx (𝟙 j)).choose (algebraMap _ _ x) = algebraMap _ _ x
          rw [(hMapEx (𝟙 j)).choose_spec x, E_d.map_id]
          rfl
        map_comp := fun {j₁ j₂ j₃} φ₁ φ₂ => by
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j₁))
          ext x
          change (hMapEx (φ₁ ≫ φ₂)).choose (algebraMap _ _ x) =
            (hMapEx φ₂).choose ((hMapEx φ₁).choose (algebraMap _ _ x))
          rw [(hMapEx (φ₁ ≫ φ₂)).choose_spec x, (hMapEx φ₁).choose_spec x,
            (hMapEx φ₂).choose_spec ((E_d.map φ₁).hom x), E_d.map_comp]
          rfl }
    let ι_l : E_d ⟶ E_l :=
      { app := fun j => CommRingCat.ofHom (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)))
        naturality := fun j j' φ => by
          apply CommRingCat.hom_ext; ext x
          exact ((hMapEx φ).choose_spec x).symm }
    let pt_l : CommRingCat.{u} := CommRingCat.of (Localization.Away x_pt)
    let ι_pt : c_d.pt ⟶ pt_l := CommRingCat.ofHom (algebraMap ↑c_d.pt (Localization.Away x_pt))
    let c_l : CategoryTheory.Limits.Cocone E_l :=
      { pt := pt_l
        ι :=
          { app := fun j => CommRingCat.ofHom (hLegEx j).choose
            naturality := fun j j' φ => by
              dsimp [E_l]; rw [Category.comp_id]
              apply CommRingCat.hom_ext
              apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j))
              ext x
              change (hLegEx j').choose ((hMapEx φ).choose (algebraMap _ _ x)) =
                (hLegEx j).choose (algebraMap _ _ x)
              rw [(hMapEx φ).choose_spec x, (hLegEx j').choose_spec, (hLegEx j).choose_spec]
              exact congrArg (algebraMap ↑c_d.pt (Localization.Away x_pt))
                (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (c_d.w φ)) x) } }
    have hι_comm : ∀ j : 𝒥, c_d.ι.app j ≫ ι_pt = ι_l.app j ≫ c_l.ι.app j := by
      intro j; apply CommRingCat.hom_ext; ext x
      exact ((hLegEx j).choose_spec x).symm
    have hc_l : CategoryTheory.Limits.IsColimit c_l := by
      let j₀_arb : 𝒥 := Classical.choice CategoryTheory.IsFiltered.nonempty
      let toBaseCocone : ∀ s : CategoryTheory.Limits.Cocone E_l, CategoryTheory.Limits.Cocone E_d :=
        fun s =>
          { pt := s.pt
            ι :=
              { app := fun j => ι_l.app j ≫ s.ι.app j
                naturality := fun j j' φ => by
                  dsimp
                  rw [Category.comp_id, ← s.w φ, ← Category.assoc, ι_l.naturality φ, Category.assoc] } }
      have hDescEx : ∀ s : CategoryTheory.Limits.Cocone E_l,
          ∃ g : Localization.Away x_pt →+* ↑s.pt,
            ∀ a : ↑c_d.pt,
              g (algebraMap ↑c_d.pt (Localization.Away x_pt) a) = (hc_d.desc (toBaseCocone s)).hom a := by
        intro s
        let d₀ : c_d.pt ⟶ s.pt := hc_d.desc (toBaseCocone s)
        have hu_x : IsUnit (d₀.hom x_pt) := by
          have hfac0 : c_d.ι.app j₀_arb ≫ d₀ = ι_l.app j₀_arb ≫ s.ι.app j₀_arb :=
            hc_d.fac (toBaseCocone s) j₀_arb
          have hval := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hfac0) (x_lvl j₀_arb)
          change d₀.hom ((c_d.ι.app j₀_arb).hom (x_lvl j₀_arb)) =
            (s.ι.app j₀_arb).hom (algebraMap _ _ (x_lvl j₀_arb)) at hval
          rw [hx_pt j₀_arb] at hval; rw [hval]
          exact (IsLocalization.Away.algebraMap_isUnit (x_lvl j₀_arb)).map (s.ι.app j₀_arb).hom
        exact ⟨IsLocalization.Away.lift x_pt (g := d₀.hom) hu_x,
          IsLocalization.Away.lift_eq x_pt hu_x⟩
      refine
        { desc := fun s => CommRingCat.ofHom (hDescEx s).choose
          fac := fun s j => by
            apply CommRingCat.hom_ext
            apply IsLocalization.ringHom_ext (Submonoid.powers (x_lvl j))
            ext x
            change (hDescEx s).choose ((hLegEx j).choose (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) x)) =
              (s.ι.app j).hom (algebraMap ↑(E_d.obj j) (Localization.Away (x_lvl j)) x)
            rw [(hLegEx j).choose_spec x, (hDescEx s).choose_spec]
            exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hc_d.fac (toBaseCocone s) j)) x
          uniq := fun s m hm => by
            apply CommRingCat.hom_ext
            apply IsLocalization.ringHom_ext (Submonoid.powers x_pt)
            ext x
            change m.hom (algebraMap ↑c_d.pt (Localization.Away x_pt) x) =
              (hDescEx s).choose (algebraMap ↑c_d.pt (Localization.Away x_pt) x)
            rw [(hDescEx s).choose_spec x]
            have hm0 : ι_pt ≫ m = hc_d.desc (toBaseCocone s) := by
              apply hc_d.uniq (toBaseCocone s)
              intro j
              rw [← Category.assoc, hι_comm j, Category.assoc, hm j]
            exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm0) x }
    exact ⟨E_l, ι_l, c_l, hc_l, ι_pt, hι_comm,
      ⟨(inferInstance : Algebra ↑c_d.pt (Localization.Away x_pt)),
        (inferInstance : IsLocalization.Away x_pt (Localization.Away x_pt)), rfl⟩,
      fun j => ⟨(inferInstance : Algebra ↑(E_d.obj j) (Localization.Away (x_lvl j))),
        (inferInstance : IsLocalization.Away (x_lvl j) (Localization.Away (x_lvl j))), rfl⟩⟩

  have hUnderPushoutColim : ∀ (D_p : ℐ ⥤ CommRingCat.{u}) (c_p : CategoryTheory.Limits.Cocone D_p),
      CategoryTheory.Limits.IsColimit c_p →
      ∀ (E_inf : CommRingCat.{u}) (f_E : c_p.pt ⟶ E_inf), f_E.hom.Etale →
        ∃ (i₀ : ℐ)
          (E_d : CategoryTheory.Under i₀ ⥤ CommRingCat.{u})
          (f_st : ∀ j : CategoryTheory.Under i₀, D_p.obj j.right ⟶ E_d.obj j)
          (ι_E : E_d ⟶ (CategoryTheory.Functor.const (CategoryTheory.Under i₀)).obj E_inf)
          (_ : CategoryTheory.Limits.IsColimit ({ pt := E_inf, ι := ι_E } : CategoryTheory.Limits.Cocone E_d)),
          (∀ j : CategoryTheory.Under i₀, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f_st j))) ∧
          (∀ {j j' : CategoryTheory.Under i₀} (φ : j ⟶ j'),
            f_st j ≫ E_d.map φ = D_p.map φ.right ≫ f_st j') ∧
          (∀ j : CategoryTheory.Under i₀,
            f_st j ≫ ι_E.app j = c_p.ι.app j.right ≫ f_E) := by
    intro D_p c_p hc_p E_inf f_E hf_E_et
    obtain ⟨i₀, n₀, J₀, g₀, hf₀_et, hPush₀⟩ :=
      hEtalePresDescent D_p c_p hc_p E_inf f_E hf_E_et
    let E₀ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin n₀) ↑(D_p.obj i₀) ⧸ J₀)
    let f₀ : D_p.obj i₀ ⟶ E₀ := CommRingCat.ofHom ((Ideal.Quotient.mk J₀).comp MvPolynomial.C)
    let 𝒥 := CategoryTheory.Under i₀
    let _ : CategoryTheory.IsFiltered 𝒥 := CategoryTheory.IsFiltered.under i₀
    have : (CategoryTheory.Under.forget i₀).Final := CategoryTheory.Under.final_forget i₀
    let E_d : 𝒥 ⥤ CommRingCat.{u} :=
      { obj := fun j => CategoryTheory.Limits.pushout (D_p.map j.hom) f₀
        map := fun {j j'} φ =>
          CategoryTheory.Limits.pushout.desc
            (D_p.map φ.right ≫ CategoryTheory.Limits.pushout.inl (D_p.map j'.hom) f₀)
            (CategoryTheory.Limits.pushout.inr (D_p.map j'.hom) f₀)
            (by rw [← Category.assoc, ← D_p.map_comp, CategoryTheory.Under.w φ]
                exact CategoryTheory.Limits.pushout.condition)
        map_id := fun j => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc, Category.comp_id,
              show (𝟙 j : j ⟶ j).right = 𝟙 j.right from rfl, D_p.map_id, Category.id_comp]
          · rw [CategoryTheory.Limits.pushout.inr_desc, Category.comp_id]
        map_comp := fun {j₁ j₂ j₃} φ₁ φ₂ => by
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc_assoc,
              Category.assoc (D_p.map φ₁.right), CategoryTheory.Limits.pushout.inl_desc,
              CategoryTheory.Limits.pushout.inl_desc,
              show (φ₁ ≫ φ₂).right = φ₁.right ≫ φ₂.right from rfl,
              D_p.map_comp, Category.assoc]
          · rw [CategoryTheory.Limits.pushout.inr_desc_assoc,
              CategoryTheory.Limits.pushout.inr_desc,
              CategoryTheory.Limits.pushout.inr_desc] }
    let f_st : ∀ j : 𝒥, D_p.obj j.right ⟶ E_d.obj j :=
      fun j => CategoryTheory.Limits.pushout.inl (D_p.map j.hom) f₀
    have hf_st_et : ∀ j : 𝒥, AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (f_st j)) := by
      intro j
      have hf₀_spec_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f₀) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf₀_et
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (AlgebraicGeometry.isPullback_SpecMap_pushout (D_p.map j.hom) f₀).flip hf₀_spec_et
    let ι_E : E_d ⟶ (CategoryTheory.Functor.const 𝒥).obj E_inf :=
      { app := fun j =>
          CategoryTheory.Limits.pushout.desc (c_p.ι.app j.right ≫ f_E) g₀
            (by rw [← Category.assoc, c_p.w j.hom]; exact hPush₀.w)
        naturality := fun j j' φ => by
          dsimp [E_d]; rw [Category.comp_id]
          apply CategoryTheory.Limits.pushout.hom_ext
          · rw [CategoryTheory.Limits.pushout.inl_desc_assoc,
              CategoryTheory.Limits.pushout.inl_desc,
              Category.assoc, CategoryTheory.Limits.pushout.inl_desc,
              ← Category.assoc, c_p.w φ.right]
          · rw [CategoryTheory.Limits.pushout.inr_desc_assoc,
              CategoryTheory.Limits.pushout.inr_desc,
              CategoryTheory.Limits.pushout.inr_desc] }
    let c_E : CategoryTheory.Limits.Cocone E_d := { pt := E_inf, ι := ι_E }
    have hc_E : CategoryTheory.Limits.IsColimit c_E := by
      let hc_whisk :=
        (CategoryTheory.Functor.Final.isColimitWhiskerEquiv (CategoryTheory.Under.forget i₀) c_p).symm hc_p
      let j_id : 𝒥 := CategoryTheory.Under.mk (𝟙 i₀)
      let toWhiskCocone : ∀ s : CategoryTheory.Limits.Cocone E_d,
          CategoryTheory.Limits.Cocone (CategoryTheory.Under.forget i₀ ⋙ D_p) :=
        fun s =>
          { pt := s.pt
            ι :=
              { app := fun j => f_st j ≫ s.ι.app j
                naturality := fun j j' φ => by
                  dsimp [f_st, E_d]
                  rw [Category.comp_id, ← s.w φ, ← Category.assoc (CategoryTheory.Limits.pushout.inl _ _),
                    CategoryTheory.Limits.pushout.inl_desc, Category.assoc] } }
      have hcond0_of : ∀ s : CategoryTheory.Limits.Cocone E_d,
          c_p.ι.app i₀ ≫ hc_whisk.desc (toWhiskCocone s) =
            f₀ ≫ (CategoryTheory.Limits.pushout.inr (D_p.map j_id.hom) f₀ ≫ s.ι.app j_id) := by
        intro s
        have h1 : c_p.ι.app j_id.right ≫ hc_whisk.desc (toWhiskCocone s) =
            f_st j_id ≫ s.ι.app j_id := hc_whisk.fac (toWhiskCocone s) j_id
        dsimp [j_id, f_st] at h1 ⊢
        have hcond_id : CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀ =
            f₀ ≫ CategoryTheory.Limits.pushout.inr (D_p.map (𝟙 i₀)) f₀ := by
          calc
            CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀
                = 𝟙 _ ≫ CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀ :=
                (Category.id_comp _).symm
            _ = D_p.map (𝟙 i₀) ≫ CategoryTheory.Limits.pushout.inl (D_p.map (𝟙 i₀)) f₀ := by
                rw [D_p.map_id]
            _ = f₀ ≫ CategoryTheory.Limits.pushout.inr (D_p.map (𝟙 i₀)) f₀ :=
                CategoryTheory.Limits.pushout.condition
        rw [h1, hcond_id, Category.assoc]
      refine
        { desc := fun s =>
            hPush₀.desc (hc_whisk.desc (toWhiskCocone s))
              (CategoryTheory.Limits.pushout.inr (D_p.map j_id.hom) f₀ ≫ s.ι.app j_id)
              (hcond0_of s)
          fac := fun s j => by
            apply CategoryTheory.Limits.pushout.hom_ext
            · dsimp [c_E, ι_E]
              rw [CategoryTheory.Limits.pushout.inl_desc_assoc, Category.assoc, hPush₀.inl_desc]
              exact hc_whisk.fac (toWhiskCocone s) j
            · dsimp [c_E, ι_E]
              rw [CategoryTheory.Limits.pushout.inr_desc_assoc, hPush₀.inr_desc]
              let u_j : j_id ⟶ j := CategoryTheory.Under.homMk j.hom (Category.id_comp j.hom)
              have hw_u := s.w u_j
              dsimp [E_d] at hw_u ⊢
              rw [← hw_u, ← Category.assoc, CategoryTheory.Limits.pushout.inr_desc]
          uniq := fun s m hm => by
            apply hPush₀.hom_ext
            · rw [hPush₀.inl_desc]
              apply hc_whisk.uniq (toWhiskCocone s); intro j
              have h1 : c_p.ι.app j.right ≫ f_E = f_st j ≫ c_E.ι.app j :=
                (CategoryTheory.Limits.pushout.inl_desc _ _ _).symm
              change (c_p.ι.app j.right ≫ f_E) ≫ m = f_st j ≫ s.ι.app j
              rw [h1, Category.assoc, hm j]
            · rw [hPush₀.inr_desc]
              have h1 : g₀ = CategoryTheory.Limits.pushout.inr (D_p.map j_id.hom) f₀ ≫ c_E.ι.app j_id :=
                (CategoryTheory.Limits.pushout.inr_desc _ _ _).symm
              rw [h1, Category.assoc, hm j_id] }
    exact ⟨i₀, E_d, f_st, ι_E, hc_E, hf_st_et,
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _,
      fun _ => CategoryTheory.Limits.pushout.inl_desc _ _ _⟩

  have hUnitMulPow : ∀ {B : Type u} [CommRing B] (x ϖ : B) (u : Bˣ) (e : ℕ),
      1 ≤ e → x = ↑u * ϖ ^ e →
      ∀ {R : Type u} [CommRing R] (ρ : B →+* R), IsUnit (ρ ϖ) ↔ IsUnit (ρ x) := by
    intro B _ x ϖ u e he hx R _ ρ
    constructor
    · intro h; rw [hx, map_mul, map_pow]
      exact (Units.isUnit (Units.map ρ.toMonoidHom u)).mul (h.pow e)
    · rintro ⟨v, hv⟩
      obtain ⟨m, rfl⟩ : ∃ m : ℕ, e = m + 1 := ⟨e - 1, (Nat.sub_add_cancel he).symm⟩
      refine IsUnit.of_mul_eq_one (ρ ↑u * ρ ϖ ^ m * ↑v⁻¹) ?_
      have hmul : ρ ϖ * (ρ ↑u * ρ ϖ ^ m) = ρ x := by rw [hx, map_mul, map_pow, pow_succ']; ring
      rw [← mul_assoc, hmul, ← hv, Units.mul_inv]

  let D_poly : ℐ ⥤ CommRingCat.{u} :=
    { obj := fun i => CommRingCat.of (MvPolynomial (Fin d_rel) ↑(D.obj i))
      map := fun θ => CommRingCat.ofHom (MvPolynomial.map (D.map θ).hom)
      map_id := fun i => by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro p
        rw [D.map_id]; exact MvPolynomial.map_id p
      map_comp := fun θ₁ θ₂ => by
        apply CommRingCat.hom_ext; apply RingHom.ext; intro p
        rw [D.map_comp]
        exact (MvPolynomial.map_map (D.map θ₁).hom (D.map θ₂).hom p).symm }
  let C_inf : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin d_rel) R_bar)
  let c_poly : CategoryTheory.Limits.Cocone D_poly :=
    { pt := C_inf
      ι :=
        { app := fun i => CommRingCat.ofHom (MvPolynomial.map (c.ι.app i ≫ e_pt.hom).hom)
          naturality := fun i i' θ => by
            dsimp [D_poly]; rw [Category.comp_id]
            apply CommRingCat.hom_ext; apply RingHom.ext; intro p
            change MvPolynomial.map _ (MvPolynomial.map _ p) = MvPolynomial.map _ p
            rw [MvPolynomial.map_map]
            have hcw : D.map θ ≫ (c.ι.app i' ≫ e_pt.hom) = c.ι.app i ≫ e_pt.hom := by
              rw [← Category.assoc, c.w θ]
            exact congrFun (congrArg DFunLike.coe (congrArg MvPolynomial.map
              (congrArg CommRingCat.Hom.hom hcw))) p } }
  have hc_poly : CategoryTheory.Limits.IsColimit c_poly := by
    let i₀_arb : ℐ := Classical.choice CategoryTheory.IsFiltered.nonempty
    let c_map_i : ∀ i : ℐ, D.obj i ⟶ D_poly.obj i := fun i => CommRingCat.ofHom MvPolynomial.C
    have hc_map_nat : ∀ {i i' : ℐ} (θ : i ⟶ i'), D.map θ ≫ c_map_i i' = c_map_i i ≫ D_poly.map θ := by
      intro i i' θ; apply CommRingCat.hom_ext; apply RingHom.ext; intro a
      exact (MvPolynomial.map_C (D.map θ).hom a).symm
    let toDCocone : ∀ s : CategoryTheory.Limits.Cocone D_poly, CategoryTheory.Limits.Cocone D :=
      fun s =>
        { pt := s.pt
          ι :=
            { app := fun i => c_map_i i ≫ s.ι.app i
              naturality := fun i i' θ => by
                dsimp
                rw [Category.comp_id, ← Category.assoc, hc_map_nat θ, Category.assoc, s.w θ] } }
    refine
      { desc := fun s =>
          CommRingCat.ofHom
            (MvPolynomial.eval₂Hom (e_pt.inv ≫ hc.desc (toDCocone s)).hom
              (fun m => (s.ι.app i₀_arb).hom (MvPolynomial.X m)))
        fac := fun s i => by
          have hX_const : ∀ m : Fin d_rel,
              (s.ι.app i).hom (MvPolynomial.X m) = (s.ι.app i₀_arb).hom (MvPolynomial.X m) := by
            intro m
            let f₁ := CategoryTheory.IsFiltered.leftToMax i i₀_arb
            let f₂ := CategoryTheory.IsFiltered.rightToMax i i₀_arb
            have h1 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (s.w f₁)) (MvPolynomial.X m)
            have h2 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (s.w f₂)) (MvPolynomial.X m)
            change (s.ι.app _).hom (MvPolynomial.map _ (MvPolynomial.X m)) = _ at h1 h2
            rw [MvPolynomial.map_X] at h1 h2
            exact h1.symm.trans h2
          apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
          · intro a
            change MvPolynomial.eval₂Hom _ _ (MvPolynomial.map _ (MvPolynomial.C a)) =
              (s.ι.app i).hom (MvPolynomial.C a)
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            have hfac : (c.ι.app i ≫ e_pt.hom) ≫ (e_pt.inv ≫ hc.desc (toDCocone s)) =
                c_map_i i ≫ s.ι.app i := by
              rw [Category.assoc, e_pt.hom_inv_id_assoc]; exact hc.fac (toDCocone s) i
            exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hfac) a
          · intro m
            change MvPolynomial.eval₂Hom _ _ (MvPolynomial.map _ (MvPolynomial.X m)) =
              (s.ι.app i).hom (MvPolynomial.X m)
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', hX_const m]
        uniq := fun s g hg => by
          have hd_eq : CommRingCat.ofHom MvPolynomial.C ≫ g = e_pt.inv ≫ hc.desc (toDCocone s) := by
            rw [Iso.eq_inv_comp]; apply hc.uniq (toDCocone s); intro i
            dsimp [toDCocone]
            have hC_map : (c.ι.app i ≫ e_pt.hom) ≫ CommRingCat.ofHom MvPolynomial.C =
                c_map_i i ≫ c_poly.ι.app i := by
              apply CommRingCat.hom_ext; apply RingHom.ext; intro a
              exact (MvPolynomial.map_C _ a).symm
            rw [← Category.assoc (c.ι.app i), ← Category.assoc (c.ι.app i ≫ e_pt.hom),
              hC_map, Category.assoc, hg i]
          apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
          · intro r
            change g.hom (MvPolynomial.C r) = MvPolynomial.eval₂Hom _ _ (MvPolynomial.C r)
            rw [MvPolynomial.eval₂Hom_C]
            exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hd_eq) r
          · intro m
            change g.hom (MvPolynomial.X m) = MvPolynomial.eval₂Hom _ _ (MvPolynomial.X m)
            rw [MvPolynomial.eval₂Hom_X']
            have h1 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hg i₀_arb)) (MvPolynomial.X m)
            change g.hom (MvPolynomial.map _ (MvPolynomial.X m)) = _ at h1
            rwa [MvPolynomial.map_X] at h1 }

  intro S_d U₀ Gm_k j_Gm κ_A1 p_A1 Y_d U_d j_d g_k_R j_R A_R A_Ω j_A W _ w _
  have hpb_AR : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map (p_R.comp Polynomial.C))))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.C : R_bar →+* MvPolynomial (Fin d_rel) R_bar)))
      S_d.hom g_k_R :=
    hPushMvPoly (p_R.comp Polynomial.C)
  let e_AR : AlgebraicGeometry.Spec C_inf ≅ A_R := hpb_AR.isoPullback
  have he_AR_snd : e_AR.hom ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) :=
    hpb_AR.isoPullback_hom_snd

  let E_inf : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
  let e_W : AlgebraicGeometry.Spec E_inf ≅ W := W.isoSpec.symm
  let f_E : C_inf ⟶ E_inf := AlgebraicGeometry.Spec.preimage (e_W.hom ≫ w ≫ e_AR.inv)
  have hf_E_map : AlgebraicGeometry.Spec.map f_E = e_W.hom ≫ w ≫ e_AR.inv :=
    AlgebraicGeometry.Spec.map_preimage _
  have hf_E_et : f_E.hom.Etale := by
    apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
    rw [hf_E_map]; infer_instance

  obtain ⟨i₀, E_diag, f_stage, ι_E, hc_E, hf_stage_et, hf_stage_nat, hf_stage_pt⟩ :=
    hUnderPushoutColim D_poly c_poly hc_poly E_inf f_E hf_E_et
  let c_E : CategoryTheory.Limits.Cocone E_diag := { pt := E_inf, ι := ι_E }
  let 𝒥 : Type u := CategoryTheory.Under i₀
  let _ : CategoryTheory.IsFiltered 𝒥 := CategoryTheory.IsFiltered.under i₀

  let X_E : ∀ j : 𝒥, ↑(E_diag.obj j) :=
    fun j => (f_stage j).hom (MvPolynomial.C ((α.app j.right).hom Polynomial.X))
  let t_E : ↑E_inf := f_E.hom (MvPolynomial.C t_bar)
  have hX_E_map : ∀ {j j' : 𝒥} (φ : j ⟶ j'), (E_diag.map φ).hom (X_E j) = X_E j' := by
    intro j j' φ
    have h2 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hf_stage_nat φ))
      (MvPolynomial.C ((α.app j.right).hom Polynomial.X))
    change (E_diag.map φ).hom (X_E j) =
      (f_stage j').hom (MvPolynomial.map (D.map φ.right).hom
        (MvPolynomial.C ((α.app j.right).hom Polynomial.X))) at h2
    rw [h2, MvPolynomial.map_C, hα_nat_apply φ.right Polynomial.X]
  have hX_E_inf : ∀ j : 𝒥, (c_E.ι.app j).hom (X_E j) = t_E := by
    intro j
    have h2 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hf_stage_pt j))
      (MvPolynomial.C ((α.app j.right).hom Polynomial.X))
    change (c_E.ι.app j).hom (X_E j) =
      f_E.hom (MvPolynomial.map (c.ι.app j.right ≫ e_pt.hom).hom
        (MvPolynomial.C ((α.app j.right).hom Polynomial.X))) at h2
    rw [h2, MvPolynomial.map_C]
    have h3 := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hCocone_eq j.right)) Polynomial.X
    change (c.ι.app j.right ≫ e_pt.hom).hom ((α.app j.right).hom Polynomial.X) = p_R Polynomial.X at h3
    rw [h3, ht_eq]

  obtain ⟨E_loc, ι_loc, c_Eloc, hc_Eloc, ι_inf, hι_comm,
    ⟨hAlg_inf, hLoc_inf, hι_inf_eq⟩, hLoc_lvl_pkg⟩ :=
    hLocFilteredColim 𝒥 E_diag c_E hc_E X_E t_E hX_E_map hX_E_inf

  let φ_R_cE : R_bar →+* ↑E_inf := f_E.hom.comp MvPolynomial.C
  have hw_snd : e_W.hom ≫ w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_cE) := by
    have heW_w : e_W.hom ≫ w = AlgebraicGeometry.Spec.map f_E ≫ e_AR.hom := by
      rw [hf_E_map, Category.assoc, Category.assoc, e_AR.inv_hom_id, Category.comp_id]
    rw [← Category.assoc, heW_w, Category.assoc, he_AR_snd, ← AlgebraicGeometry.Spec.map_comp]
    exact congrArg AlgebraicGeometry.Spec.map rfl
  have hw_snd_inv : w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R =
      e_W.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_cE) := by
    rw [← hw_snd, ← Category.assoc, e_W.inv_hom_id, Category.id_comp]
  obtain ⟨ψ_inf, hpb_loc_inf₀⟩ := @hPushLocAway R_bar ↑c_E.pt Ω ↑c_Eloc.pt _ _ _ _
    φ_R_Ω.toAlgebra hAlg_inf φ_R_cE t_bar t_E hLoc_Ω hLoc_inf (fun _ => Iff.rfl)
  have hpb_loc_inf : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf))
      (AlgebraicGeometry.Spec.map ι_inf)
      j_R
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_cE)) := by
    rw [hι_inf_eq]; exact hpb_loc_inf₀
  have hpb_jA_pasted : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst j_A w ≫
        CategoryTheory.Limits.pullback.fst j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
      (CategoryTheory.Limits.pullback.snd j_A w)
      j_R (w ≫ CategoryTheory.Limits.pullback.snd S_d.hom g_k_R) :=
    (CategoryTheory.IsPullback.of_hasPullback j_A w).paste_horiz
      (CategoryTheory.IsPullback.of_hasPullback j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
  let e_WU : AlgebraicGeometry.Spec c_Eloc.pt ≅ CategoryTheory.Limits.pullback j_A w :=
    { hom := hpb_jA_pasted.lift
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf))
        (AlgebraicGeometry.Spec.map ι_inf ≫ e_W.hom)
        (by rw [Category.assoc, hw_snd]; exact hpb_loc_inf.w)
      inv := hpb_loc_inf.lift
        (CategoryTheory.Limits.pullback.fst j_A w ≫
          CategoryTheory.Limits.pullback.fst j_R (CategoryTheory.Limits.pullback.snd S_d.hom g_k_R))
        (CategoryTheory.Limits.pullback.snd j_A w ≫ e_W.inv)
        (by
          rw [Category.assoc (CategoryTheory.Limits.pullback.snd j_A w), ← hw_snd_inv,
              ← Category.assoc]
          exact hpb_jA_pasted.w)
      hom_inv_id := by apply hpb_loc_inf.hom_ext <;> simp
      inv_hom_id := by apply hpb_jA_pasted.hom_ext <;> simp }

  have hBuildChart : ∀ (j : 𝒥) (ϖ : ↑(D.obj j.right)) (u : (↑(D.obj j.right))ˣ) (e : ℕ)
      (ψ : Polynomial k →+* ↑(D.obj j.right)),
      1 ≤ e →
      (α.app j.right).hom Polynomial.X = ↑u * ϖ ^ e →
      ψ.comp Polynomial.C = (α.app j.right).hom.comp Polynomial.C →
      ψ Polynomial.X = ϖ →
      ψ.Etale →
      ∃ (w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d)
        (_ : AlgebraicGeometry.Etale w_j)
        (ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅ CategoryTheory.Limits.pullback j_d w_j),
        w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map (f_stage j) ≫
            (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (MvPolynomial.map ((α.app j.right).hom.comp Polynomial.C))) :
              _ ⟶ S_d.left) ∧
        w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (((f_stage j).hom.comp MvPolynomial.C).comp ψ)) ∧
        ϕ_j.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_j =
          AlgebraicGeometry.Spec.map (ι_loc.app j) := by
    intro j ϖ u e ψ he hX hψC hψX hψEt
    let c_k : k →+* ↑(D.obj j.right) := (α.app j.right).hom.comp Polynomial.C
    let pr_Sd : AlgebraicGeometry.Spec (D_poly.obj j.right) ⟶ S_d.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (MvPolynomial.map c_k))
    have hpb_mv : CategoryTheory.IsPullback pr_Sd
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.C : ↑(D.obj j.right) →+* MvPolynomial (Fin d_rel) ↑(D.obj j.right))))
        S_d.hom (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1) := by
      have hcomp_pA1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom c_k) := by
        dsimp [p_A1, c_k]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψC]
        rfl
      rw [hcomp_pA1]; exact hPushMvPoly c_k
    let q_j : AlgebraicGeometry.Spec (D_poly.obj j.right) ⟶ Y_d :=
      CategoryTheory.Limits.pullback.lift pr_Sd
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
        (by rw [Category.assoc]; exact hpb_mv.w)
    have hq_fst : q_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 = pr_Sd :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hq_snd : q_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hpb_q_outer : CategoryTheory.IsPullback
        (q_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
        S_d.hom (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ p_A1) := by
      rw [hq_fst]; exact hpb_mv
    have hpb_q : CategoryTheory.IsPullback q_j
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
      CategoryTheory.IsPullback.of_right hpb_q_outer hq_snd
        (CategoryTheory.IsPullback.of_hasPullback S_d.hom p_A1)
    have hq_et : AlgebraicGeometry.Etale q_j :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_q.flip
        ((AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψEt)
    let w_j : AlgebraicGeometry.Spec (E_diag.obj j) ⟶ Y_d :=
      AlgebraicGeometry.Spec.map (f_stage j) ≫ q_j
    have hw_j_et : AlgebraicGeometry.Etale w_j :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _ (hf_stage_et j) hq_et
    let toE : ↑(D.obj j.right) →+* ↑(E_diag.obj j) := (f_stage j).hom.comp MvPolynomial.C
    let γ_j : Polynomial k →+* ↑(E_diag.obj j) := toE.comp ψ
    have hw_fst : w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1 =
        AlgebraicGeometry.Spec.map (f_stage j) ≫ pr_Sd := by
      dsimp [w_j]; rw [Category.assoc, hq_fst]
    have hw_snd_j : w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_j) := by
      dsimp [w_j, γ_j, toE]
      rw [Category.assoc, hq_snd, ← Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    have hXE_fac : X_E j = ↑(Units.map toE.toMonoidHom u) * (γ_j Polynomial.X) ^ e := by
      change toE ((α.app j.right).hom Polynomial.X) = ↑(Units.map toE.toMonoidHom u) * (toE (ψ Polynomial.X)) ^ e
      rw [hX, hψX, map_mul, map_pow]; rfl
    obtain ⟨hAlg_j, hLoc_j, hι_j_eq⟩ := hLoc_lvl_pkg j
    obtain ⟨ψ_loc, hpb_loc_j₀⟩ := @hPushLocAway (Polynomial k) ↑(E_diag.obj j)
      (Localization.Away (Polynomial.X : Polynomial k)) ↑(E_loc.obj j)
      _ _ _ _ inferInstance hAlg_j γ_j Polynomial.X (X_E j) inferInstance hLoc_j
      (fun ρ => hUnitMulPow (X_E j) (γ_j Polynomial.X) (Units.map toE.toMonoidHom u) e he hXE_fac ρ)
    have hpb_loc_j : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc))
        (AlgebraicGeometry.Spec.map (ι_loc.app j))
        j_Gm
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_j)) := by
      rw [hι_j_eq]; exact hpb_loc_j₀
    have hpb_jd_pasted : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst j_d w_j ≫
          CategoryTheory.Limits.pullback.fst j_Gm (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
        (CategoryTheory.Limits.pullback.snd j_d w_j)
        j_Gm (w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) :=
      (CategoryTheory.IsPullback.of_hasPullback j_d w_j).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback j_Gm (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
    let ϕ_j : AlgebraicGeometry.Spec (E_loc.obj j) ≅ CategoryTheory.Limits.pullback j_d w_j :=
      { hom := hpb_jd_pasted.lift
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc))
          (AlgebraicGeometry.Spec.map (ι_loc.app j))
          (by rw [hw_snd_j]; exact hpb_loc_j.w)
        inv := hpb_loc_j.lift
          (CategoryTheory.Limits.pullback.fst j_d w_j ≫
            CategoryTheory.Limits.pullback.fst j_Gm (CategoryTheory.Limits.pullback.snd S_d.hom p_A1))
          (CategoryTheory.Limits.pullback.snd j_d w_j)
          (by rw [← hw_snd_j]; exact hpb_jd_pasted.w)
        hom_inv_id := by apply hpb_loc_j.hom_ext <;> simp
        inv_hom_id := by apply hpb_jd_pasted.hom_ext <;> simp }
    exact ⟨w_j, hw_j_et, ϕ_j, hw_fst, hw_snd_j, hpb_jd_pasted.lift_snd _ _ _⟩

  refine ⟨𝒥, inferInstance, inferInstance, E_diag, E_loc, ι_loc, c_E, hc_E, c_Eloc, hc_Eloc,
    ι_inf, e_W, e_WU, hι_comm, hpb_jA_pasted.lift_snd _ _ _, fun j => ?_⟩
  obtain ⟨ϖ, u, e, ψ_i, he, _, hX_i, hψC_i, hψX_i, hψEt_i, i₁, θ, β, ψ₁, hβ, hψ₁C, hψ₁X, hψ₁Et⟩ :=
    hStage j.right
  obtain ⟨w_j, hw_j, ϕ_j, hwj_fst, hwj_snd, hϕ_j_snd⟩ :=
    hBuildChart j ϖ u e ψ_i he hX_i hψC_i hψX_i hψEt_i
  let j₁ : 𝒥 := CategoryTheory.Under.mk (j.hom ≫ θ)
  let θ_U : j ⟶ j₁ := CategoryTheory.Under.homMk θ rfl
  let u₁ : (↑(D.obj i₁))ˣ := Units.map (D.map θ).hom.toMonoidHom u
  have he₁ : 1 ≤ ℓ * e := Nat.mul_pos hℓ_pos he
  have hX₁ : (α.app i₁).hom Polynomial.X = ↑u₁ * β ^ (ℓ * e) := by
    rw [← hα_nat_apply θ Polynomial.X, hX_i, map_mul, map_pow, hβ, ← pow_mul]
    rfl
  obtain ⟨w₁, hw₁, ϕ₁, hw₁_fst, hw₁_snd, hϕ₁_snd⟩ :=
    hBuildChart j₁ β u₁ (ℓ * e) ψ₁ he₁ hX₁ hψ₁C hψ₁X hψ₁Et
  refine ⟨w_j, hw_j, ϕ_j, hϕ_j_snd, j₁, θ_U, w₁, hw₁, ϕ₁, hϕ₁_snd, ?_, ?_, ?_⟩
  · change AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫
        (w_j ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1) =
      w₁ ≫ CategoryTheory.Limits.pullback.fst S_d.hom p_A1
    rw [hwj_fst, hw₁_fst]
    have hcomp_st : AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫ AlgebraicGeometry.Spec.map (f_stage j) =
        AlgebraicGeometry.Spec.map (f_stage j₁) ≫ AlgebraicGeometry.Spec.map (D_poly.map θ) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, hf_stage_nat θ_U]
      rfl
    refine (Category.assoc _ _ _).symm.trans ((CategoryTheory.eq_whisker hcomp_st _).trans
      ((Category.assoc _ _ _).trans (CategoryTheory.whisker_eq _ ?_)))
    change AlgebraicGeometry.Spec.map (D_poly.map θ) ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (MvPolynomial.map ((α.app j.right).hom.comp Polynomial.C))) =
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.map ((α.app i₁).hom.comp Polynomial.C)))
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1; apply CommRingCat.hom_ext; apply RingHom.ext; intro p
    change (MvPolynomial.map (D.map θ).hom)
        (MvPolynomial.map ((α.app j.right).hom.comp Polynomial.C) p) =
      MvPolynomial.map ((α.app i₁).hom.comp Polynomial.C) p
    rw [MvPolynomial.map_map]; congr 2; apply RingHom.ext; intro a
    exact hα_nat_apply θ (Polynomial.C a)
  · change AlgebraicGeometry.Spec.map (E_diag.map θ_U) ≫
        (w_j ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) =
      (w₁ ≫ CategoryTheory.Limits.pullback.snd S_d.hom p_A1) ≫ κ_A1
    rw [hwj_snd, hw₁_snd, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1; apply CommRingCat.hom_ext; apply Polynomial.ringHom_ext'
    · ext a
      have hc1 := DFunLike.congr_fun hψC_i a
      have hc2 := DFunLike.congr_fun hψ₁C a
      change (f_stage j ≫ E_diag.map θ_U).hom (MvPolynomial.C (ψ_i (Polynomial.C a))) =
        (f_stage j₁).hom (MvPolynomial.C (ψ₁ ((Polynomial.aeval (Polynomial.X ^ ℓ)) (Polynomial.C a))))
      rw [Polynomial.aeval_C, hf_stage_nat θ_U]
      change (f_stage j₁).hom (MvPolynomial.map (D.map θ).hom (MvPolynomial.C (ψ_i (Polynomial.C a)))) = _
      rw [MvPolynomial.map_C]; congr 2
      change (D.map θ).hom ((ψ_i.comp Polynomial.C) a) = (ψ₁.comp Polynomial.C) a
      rw [hc1, hc2]; exact hα_nat_apply θ (Polynomial.C a)
    · change (f_stage j ≫ E_diag.map θ_U).hom (MvPolynomial.C (ψ_i Polynomial.X)) =
        (f_stage j₁).hom (MvPolynomial.C (ψ₁ ((Polynomial.aeval (Polynomial.X ^ ℓ)) Polynomial.X)))
      rw [hf_stage_nat θ_U, hψX_i, Polynomial.aeval_X, map_pow, hψ₁X]
      change (f_stage j₁).hom (MvPolynomial.map (D.map θ).hom (MvPolynomial.C ϖ)) =
        (f_stage j₁).hom (MvPolynomial.C (β ^ ℓ))
      rw [MvPolynomial.map_C, hβ]
  · have hloc_nat : AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫
        AlgebraicGeometry.Spec.map (ι_loc.app j) =
        AlgebraicGeometry.Spec.map (ι_loc.app j₁) ≫ AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, ι_loc.naturality θ_U]
    calc
      (ϕ₁.inv ≫ AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫ ϕ_j.hom) ≫
          CategoryTheory.Limits.pullback.snd j_d w_j
          = ϕ₁.inv ≫ (AlgebraicGeometry.Spec.map (E_loc.map θ_U) ≫
              AlgebraicGeometry.Spec.map (ι_loc.app j)) := by
          rw [Category.assoc, Category.assoc, hϕ_j_snd]
      _ = ϕ₁.inv ≫ (AlgebraicGeometry.Spec.map (ι_loc.app j₁) ≫
            AlgebraicGeometry.Spec.map (E_diag.map θ_U)) := by rw [hloc_nat]
      _ = ϕ₁.inv ≫ ϕ₁.hom ≫ CategoryTheory.Limits.pullback.snd j_d w₁ ≫
            AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
          rw [← hϕ₁_snd, Category.assoc ϕ₁.hom]
      _ = CategoryTheory.Limits.pullback.snd j_d w₁ ≫ AlgebraicGeometry.Spec.map (E_diag.map θ_U) := by
          rw [← Category.assoc ϕ₁.inv ϕ₁.hom, ϕ₁.inv_hom_id, Category.id_comp]

theorem weil_val_ring_acyclic_noetherian_stage_deg_zero_bij (k : Type u) [Field k]
    (d_rel ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPur0 :
      let S_d := weilAffineSpaceOver k d_rel
      let U₀ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
      let Gm_k := AlgebraicGeometry.Spec
        (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
      let j_Gm : Gm_k ⟶ U₀ := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X : Polynomial k))))
      let p_A1 : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
      let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
      let U_d := CategoryTheory.Limits.pullback j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
      let j_d : U_d ⟶ Y_d :=
        CategoryTheory.Limits.pullback.snd j_Gm
          (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ Y_d) [AlgebraicGeometry.Etale w],
        ConnectedSpace ↥W → Nonempty ↥W →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback j_d w) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback j_d w)) :
    let S_d := weilAffineSpaceOver k d_rel
    let U₀ := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ U₀ := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let p_A1 : U₀ ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_d := CategoryTheory.Limits.pullback S_d.hom p_A1
    let U_d := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    let j_d : U_d ⟶ Y_d :=
      CategoryTheory.Limits.pullback.snd j_Gm
        (CategoryTheory.Limits.pullback.snd S_d.hom p_A1)
    ∀ (E E_loc : CommRingCat.{u})
      (w_E : AlgebraicGeometry.Spec E ⟶ Y_d) [AlgebraicGeometry.Etale w_E]
      (ι_E : E ⟶ E_loc)
      (ϕ_E : AlgebraicGeometry.Spec E_loc ≅ CategoryTheory.Limits.pullback j_d w_E),
      ϕ_E.hom ≫ CategoryTheory.Limits.pullback.snd j_d w_E =
        AlgebraicGeometry.Spec.map ι_E →
      ∀ (ψ_E : weilEtaleTorsionH (AlgebraicGeometry.Spec E) ℓ 0 →+
          weilEtaleTorsionH (AlgebraicGeometry.Spec E_loc) ℓ 0),
        WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map ι_E) ℓ 0 ψ_E →
        Function.Bijective ψ_E :=
by
  classical
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hℓ_pos : 1 ≤ ℓ := (Fact.out : Nat.Prime ℓ).pos

  have hPullIsoBij0 : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂)
      (p : weilEtaleTorsionH X₂ ℓ 0 →+ weilEtaleTorsionH X₁ ℓ 0),
      WeilIsTorsionEtalePullback e.hom ℓ 0 p → Function.Bijective p := by
    intro X₁ X₂ e p hp
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv ℓ 0
    obtain ⟨p_id₁, hp_id₁⟩ := hPullEx (𝟙 X₁) ℓ 0
    obtain ⟨p_id₂, hp_id₂⟩ := hPullEx (𝟙 X₂) ℓ 0
    have hid₁ : WeilIsTorsionEtalePullback (e.hom ≫ e.inv) ℓ 0 (AddMonoidHom.id _) := by
      rw [e.hom_inv_id]; rwa [hPullId ℓ 0 p_id₁ hp_id₁] at hp_id₁
    have hid₂ : WeilIsTorsionEtalePullback (e.inv ≫ e.hom) ℓ 0 (AddMonoidHom.id _) := by
      rw [e.inv_hom_id]; rwa [hPullId ℓ 0 p_id₂ hp_id₂] at hp_id₂
    have hc₁ := hPullComp e.hom e.inv ℓ 0 p p_inv (AddMonoidHom.id _) hp hp_inv hid₁
    have hc₂ := hPullComp e.inv e.hom ℓ 0 p_inv p (AddMonoidHom.id _) hp_inv hp hid₂
    exact ⟨Function.LeftInverse.injective (fun x => congrFun (congrArg DFunLike.coe hc₂.symm) x),
      Function.RightInverse.surjective (fun y => congrFun (congrArg DFunLike.coe hc₁.symm) y)⟩

  let specIso : ∀ {A₁ A₂ : CommRingCat.{u}}, (↑A₁ ≃+* ↑A₂) →
      (AlgebraicGeometry.Spec A₁ ≅ AlgebraicGeometry.Spec A₂) :=
    fun {A₁ A₂} eqv =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eqv.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eqv.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h1 : (CommRingCat.ofHom eqv.toRingHom : A₁ ⟶ A₂) ≫
              CommRingCat.ofHom eqv.symm.toRingHom = 𝟙 A₁ := by
            apply CommRingCat.hom_ext; ext x; exact eqv.symm_apply_apply x
          rw [h1, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h1 : (CommRingCat.ofHom eqv.symm.toRingHom : A₂ ⟶ A₁) ≫
              CommRingCat.ofHom eqv.toRingHom = 𝟙 A₂ := by
            apply CommRingCat.hom_ext; ext x; exact eqv.apply_symm_apply x
          rw [h1, AlgebraicGeometry.Spec.map_id] }

  let specIsoType : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂],
      (R₁ ≃+* R₂) →
      (AlgebraicGeometry.Spec (CommRingCat.of R₁) ≅ AlgebraicGeometry.Spec (CommRingCat.of R₂)) :=
    fun {R₁ R₂} _ _ eqv =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eqv.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom eqv.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h1 : (CommRingCat.ofHom eqv.toRingHom : CommRingCat.of R₁ ⟶ CommRingCat.of R₂) ≫
              CommRingCat.ofHom eqv.symm.toRingHom = 𝟙 _ := by
            apply CommRingCat.hom_ext; ext x; exact eqv.symm_apply_apply x
          rw [h1, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h1 : (CommRingCat.ofHom eqv.symm.toRingHom : CommRingCat.of R₂ ⟶ CommRingCat.of R₁) ≫
              CommRingCat.ofHom eqv.toRingHom = 𝟙 _ := by
            apply CommRingCat.hom_ext; ext y; exact eqv.apply_symm_apply y
          rw [h1, AlgebraicGeometry.Spec.map_id] }

  have hMemEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U₀ : Z.Etale)
      (R : CategoryTheory.Sieve U₀),
      R ∈ Z.smallEtaleTopology U₀ ↔
        ∀ (x : ↥U₀.left), ∃ (Y : Z.Etale) (g : Y ⟶ U₀) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro Z U₀ R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      Z (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) Z
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance U₀ R
    exact (iff_of_eq
      (congrArg (fun K : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ K U₀) heq)).trans hiff

  have hEmptySheafSub : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (W : Z.Etale),
      IsEmpty ↥W.left → Subsingleton ↥(ℱ.obj.obj (Opposite.op W)) := by
    intro Z ℱ W hEmp
    have hBot : (⊥ : CategoryTheory.Sieve W) ∈ Z.smallEtaleTopology W :=
      (hMemEtale Z W ⊥).mpr (fun x => IsEmpty.elim hEmp x)
    exact ⟨fun a b => ℱ.isSeparated W ⊥ hBot a b (fun _ _ hf => False.elim hf)⟩

  have hEmptyH0Sub : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      IsEmpty ↥Z → Subsingleton (weilEtaleTorsionH Z ℓ 0) := by
    intro Z hEmp
    let T_Z := weilEtaleIdTerminal.{u} Z
    let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z
    have : Subsingleton ↥((weilEtaleTorsionSheaf Z ℓ).obj.obj (Opposite.op T_Z)) :=
      hEmptySheafSub (weilEtaleTorsionSheaf Z ℓ) T_Z hEmp
    exact (CategoryTheory.Sheaf.H.equiv₀ (weilEtaleTorsionSheaf Z ℓ) hT_Z).toEquiv.subsingleton

  have hAbsPiNat : ∀ {C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u, u + 1} C₁]
      [CategoryTheory.Category.{u, u + 1} C₂]
      (J₁ : CategoryTheory.GrothendieckTopology C₁)
      (J₂ : CategoryTheory.GrothendieckTopology C₂)
      [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
      [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
      (B : CategoryTheory.Functor C₂ C₁)
      [B.IsContinuous J₂ J₁]
      [(B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint]
      (T₁ : C₁) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : C₂) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      {A₁ A₂ : AddCommGrpCat.{u}} (μ : A₁ ⟶ A₂),
      let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let C_sh₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C_sh₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
      let π₁ : P_pull.obj (C_sh₂.obj A₁) ⟶ C_sh₁.obj A₁ :=
        (adj_pull.homEquiv _ _).symm
          ((adj₂.homEquiv _ _).symm (adj₁.unit.app A₁ ≫ (C_sh₁.obj A₁).obj.map τ.op))
      let π₂ : P_pull.obj (C_sh₂.obj A₂) ⟶ C_sh₁.obj A₂ :=
        (adj_pull.homEquiv _ _).symm
          ((adj₂.homEquiv _ _).symm (adj₁.unit.app A₂ ≫ (C_sh₁.obj A₂).obj.map τ.op))
      P_pull.map (C_sh₂.map μ) ≫ π₂ = π₁ ≫ C_sh₁.map μ := by
    intro C₁ C₂ _ _ J₁ J₂ _ _ B _ _ T₁ hT₁ T₂ hT₂ A₁ A₂ μ
    dsimp only
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let P_pull := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let C_sh₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C_sh₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    let u₁ := (adj₂.homEquiv A₁ (P_push.obj (C_sh₁.obj A₁))).symm
      (adj₁.unit.app A₁ ≫ (C_sh₁.obj A₁).obj.map τ.op)
    let u₂ := (adj₂.homEquiv A₂ (P_push.obj (C_sh₁.obj A₂))).symm
      (adj₁.unit.app A₂ ≫ (C_sh₁.obj A₂).obj.map τ.op)
    let π₁ := (adj_pull.homEquiv _ _).symm u₁
    let π₂ := (adj_pull.homEquiv _ _).symm u₂
    apply (adj_pull.homEquiv (C_sh₂.obj A₁) (C_sh₁.obj A₂)).injective
    apply (adj₂.homEquiv A₁ (P_push.obj (C_sh₁.obj A₂))).injective
    have hL1 : (adj_pull.homEquiv _ _) (P_pull.map (C_sh₂.map μ) ≫ π₂) = C_sh₂.map μ ≫ u₂ :=
      (CategoryTheory.Adjunction.homEquiv_naturality_left adj_pull (C_sh₂.map μ) π₂).trans
        (CategoryTheory.whisker_eq _ ((adj_pull.homEquiv _ _).apply_symm_apply u₂))
    have hL2 : (adj₂.homEquiv _ _) (C_sh₂.map μ ≫ u₂) =
        μ ≫ (adj₁.unit.app A₂ ≫ (C_sh₁.obj A₂).obj.map τ.op) :=
      (CategoryTheory.Adjunction.homEquiv_naturality_left adj₂ μ u₂).trans
        (CategoryTheory.whisker_eq μ ((adj₂.homEquiv _ _).apply_symm_apply _))
    have hR1 : (adj_pull.homEquiv _ _) (π₁ ≫ C_sh₁.map μ) = u₁ ≫ P_push.map (C_sh₁.map μ) :=
      (CategoryTheory.Adjunction.homEquiv_naturality_right adj_pull π₁ (C_sh₁.map μ)).trans
        (CategoryTheory.eq_whisker ((adj_pull.homEquiv _ _).apply_symm_apply u₁) _)
    have hR2 : (adj₂.homEquiv _ _) (u₁ ≫ P_push.map (C_sh₁.map μ)) =
        (adj₁.unit.app A₁ ≫ (C_sh₁.obj A₁).obj.map τ.op) ≫
          (C_sh₁.map μ).hom.app (Opposite.op (B.obj T₂)) :=
      (CategoryTheory.Adjunction.homEquiv_naturality_right adj₂ u₁ (P_push.map (C_sh₁.map μ))).trans
        (CategoryTheory.eq_whisker ((adj₂.homEquiv _ _).apply_symm_apply _) _)
    have hmid : μ ≫ (adj₁.unit.app A₂ ≫ (C_sh₁.obj A₂).obj.map τ.op) =
        (adj₁.unit.app A₁ ≫ (C_sh₁.obj A₁).obj.map τ.op) ≫
          (C_sh₁.map μ).hom.app (Opposite.op (B.obj T₂)) := by
      have hn1 : μ ≫ adj₁.unit.app A₂ = adj₁.unit.app A₁ ≫ (C_sh₁.map μ).hom.app (Opposite.op T₁) :=
        adj₁.unit.naturality μ
      have hn2 : (C_sh₁.map μ).hom.app (Opposite.op T₁) ≫ (C_sh₁.obj A₂).obj.map τ.op =
          (C_sh₁.obj A₁).obj.map τ.op ≫ (C_sh₁.map μ).hom.app (Opposite.op (B.obj T₂)) :=
        ((C_sh₁.map μ).hom.naturality τ.op).symm
      exact (CategoryTheory.Category.assoc _ _ _).symm.trans
        ((CategoryTheory.eq_whisker hn1 _).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((CategoryTheory.whisker_eq _ hn2).trans
              (CategoryTheory.Category.assoc _ _ _).symm)))
    exact ((congrArg (adj₂.homEquiv _ _) hL1).trans hL2).trans
      (hmid.trans ((congrArg (adj₂.homEquiv _ _) hR1).trans hR2).symm)

  have hConnPullBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
      [ConnectedSpace ↥S₁] [ConnectedSpace ↥S₂]
      (h : S₁ ⟶ S₂) (p_h : weilEtaleTorsionH S₂ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0),
      WeilIsTorsionEtalePullback h ℓ 0 p_h → Function.Bijective p_h := by
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let q_mod : Aℤ ⟶ AM :=
      AddCommGrpCat.ofHom
        { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod ℓ)
          map_zero' := congrArg ULift.up Int.cast_zero
          map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
    let genH0 : ∀ S : AlgebraicGeometry.Scheme.{u}, weilEtaleTorsionH S ℓ 0 :=
      fun S => CategoryTheory.Abelian.Ext.mk₀.{u}
        ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map q_mod)
    have hAbsExt0Conj : ∀ {C D : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} C] [CategoryTheory.Abelian C]
        [CategoryTheory.Category.{u + 1, u + 1} D] [CategoryTheory.Abelian D]
        [hExtC : CategoryTheory.HasExt.{u} C] [hExtD : CategoryTheory.HasExt.{u} D]
        (F : CategoryTheory.Functor C D) [F.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits F]
        [CategoryTheory.Limits.PreservesFiniteColimits F]
        {X₂ Y₂ : C} {X₁ Y₁ : D}
        (f₂ : X₂ ⟶ Y₂) (ιX : X₁ ⟶ F.obj X₂) (πY : F.obj Y₂ ⟶ Y₁) (f₁ : X₁ ⟶ Y₁),
        (ιX ≫ F.map f₂) ≫ πY = f₁ →
        (CategoryTheory.Abelian.Ext.mk₀.{u} πY).postcomp X₁ (Nat.add_zero 0)
          ((CategoryTheory.Abelian.Ext.mk₀.{u} ιX).comp
            ((@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ Y₂ 0)
              (CategoryTheory.Abelian.Ext.mk₀.{u} f₂))
            (Nat.zero_add 0)) =
        CategoryTheory.Abelian.Ext.mk₀.{u} f₁ := by
      intro C D _ _ _ _ hExtC hExtD F _ _ _ X₂ Y₂ X₁ Y₁ f₂ ιX πY f₁ heq
      have hm : (@CategoryTheory.Functor.mapExtAddHom.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ Y₂ 0)
          (CategoryTheory.Abelian.Ext.mk₀.{u} f₂) =
          CategoryTheory.Abelian.Ext.mk₀.{u} (F.map f₂) :=
        (@CategoryTheory.Functor.mapExtAddHom_apply.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ Y₂ 0 _).trans
          (@CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀.{u, u} _ _ _ _ _ _ F _ _ _ hExtC hExtD X₂ Y₂ f₂)
      change ((CategoryTheory.Abelian.Ext.mk₀.{u} ιX).comp _ (Nat.zero_add 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀.{u} πY) (Nat.add_zero 0) = _
      rw [hm, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, heq]
    have hGenPull : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}}
        (h : S₁ ⟶ S₂) (p_h : weilEtaleTorsionH S₂ ℓ 0 →+ weilEtaleTorsionH S₁ ℓ 0),
        WeilIsTorsionEtalePullback h ℓ 0 p_h → p_h (genH0 S₂) = genH0 S₁ := by
      intro S₁ S₂ h p_h hp_h
      haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
      haveI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
          (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
      rcases hp_h with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, _, hp_eq⟩
      have := hCont
      have := hAdj
      have := hAdd
      have := hLim
      have := hColim
      let B : CategoryTheory.Functor S₂.Etale S₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
      let P_pull := B.sheafPullback AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
      let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
      let C₁ := CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}
      let adj₁ := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
      let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
      let πM : P_pull.obj (C₂.obj AM) ⟶ C₁.obj AM :=
        (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
          ((adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
            (adj₁.unit.app AM ≫ (C₁.obj AM).obj.map τ.op))
      have hnat := hAbsPiNat S₁.smallEtaleTopology S₂.smallEtaleTopology B T₁ hT₁ T₂ hT₂ q_mod
      have hconj : (ιℤ ≫ P_pull.map (C₂.map q_mod)) ≫ πM = C₁.map q_mod :=
        (CategoryTheory.Category.assoc ιℤ _ _).trans
          ((CategoryTheory.whisker_eq ιℤ hnat).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((CategoryTheory.eq_whisker hιπ _).trans (CategoryTheory.Category.id_comp _))))
      exact (hp_eq (genH0 S₂)).trans (hAbsExt0Conj P_pull (C₂.map q_mod) ιℤ πM (C₁.map q_mod) hconj)
    have hGenBij : ∀ (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S],
        Function.Bijective (fun c : ZMod ℓ => c.val • genH0 S) := by
      intro S _
      have hbij1 := (weil_etale_connected_unit_end_and_geom_point_lift S ℓ hℓ_pos).1
      let oneR := weilEtaleModuleUnit S ℓ
      let e_ext : (oneR ⟶ oneR) ≃+ weilEtaleModuleH S ℓ 0 :=
        (CategoryTheory.Abelian.Ext.addEquiv₀).symm
      obtain ⟨θ, hθ_comp, hθ_bij⟩ := (weil_etale_module_ext_comparison.{u}.1 S ℓ 0).1
      have hθ_one : θ (CategoryTheory.Abelian.Ext.mk₀.{u} (𝟙 oneR)) = genH0 S := by
        rcases hθ_comp with ⟨U, _, _, hAddU, hLimU, hColimU, T, hT, _, _, u_unit, _, βM, hαβ, _, hθ_eq⟩
        have := hAddU
        have := hLimU
        have := hColimU
        let R := ULift.{u, 0} (ZMod ℓ)
        let J := S.smallEtaleTopology
        let Cℤ := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
        let adjℤ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
        let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
        let ιM : AM ⟶ FgtMod.obj (ModuleCat.of R R) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
        let ιℤ_mod : Aℤ ⟶ FgtMod.obj (ModuleCat.of R R) :=
          CategoryTheory.CategoryStruct.comp
            (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
              Quiver.Hom Aℤ (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)))
            (CategoryTheory.CategoryStruct.comp
              (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod ℓ))))
              ιM)
        let ηℤ := (adjℤ.homEquiv Aℤ (U.obj oneR)).symm (ιℤ_mod ≫ u_unit)
        let αM := (adjℤ.homEquiv AM (U.obj oneR)).symm (ιM ≫ u_unit)
        have hq_ι : q_mod ≫ ιM = ιℤ_mod := AddCommGrpCat.ext fun ⟨_⟩ => rfl
        have hC_α : Cℤ.map q_mod ≫ αM = ηℤ := by
          apply (adjℤ.homEquiv Aℤ (U.obj oneR)).injective
          have h1 : (adjℤ.homEquiv Aℤ (U.obj oneR)) (Cℤ.map q_mod ≫ αM) =
              q_mod ≫ (ιM ≫ u_unit) :=
            (CategoryTheory.Adjunction.homEquiv_naturality_left adjℤ q_mod αM).trans
              (CategoryTheory.whisker_eq q_mod ((adjℤ.homEquiv _ _).apply_symm_apply _))
          have h2 : (adjℤ.homEquiv Aℤ (U.obj oneR)) ηℤ = ιℤ_mod ≫ u_unit :=
            (adjℤ.homEquiv _ _).apply_symm_apply _
          exact h1.trans (((CategoryTheory.Category.assoc _ _ _).symm.trans
            (CategoryTheory.eq_whisker hq_ι u_unit)).trans h2.symm)
        have hη_β : (ηℤ ≫ U.map (𝟙 oneR)) ≫ βM = Cℤ.map q_mod := by
          rw [U.map_id, CategoryTheory.Category.comp_id, ← hC_α,
            CategoryTheory.Category.assoc, hαβ, CategoryTheory.Category.comp_id]
        exact (hθ_eq (CategoryTheory.Abelian.Ext.mk₀.{u} (𝟙 oneR))).trans
          (hAbsExt0Conj U (𝟙 oneR) ηℤ βM (Cℤ.map q_mod) hη_β)
      have hfn_eq : (fun c : ZMod ℓ => c.val • genH0 S) =
          θ ∘ e_ext ∘ (fun c : ZMod ℓ => c.val • 𝟙 oneR) := by
        funext c; dsimp
        rw [map_nsmul, map_nsmul]
        change c.val • genH0 S = c.val • θ (CategoryTheory.Abelian.Ext.mk₀.{u} (𝟙 oneR))
        rw [hθ_one]
      rw [hfn_eq]
      exact hθ_bij.comp (e_ext.bijective.comp hbij1)
    intro S₁ S₂ _ _ h p_h hp_h
    have hcomp_eq : p_h ∘ (fun c : ZMod ℓ => c.val • genH0 S₂) =
        (fun c : ZMod ℓ => c.val • genH0 S₁) := by
      funext c; dsimp; rw [map_nsmul, hGenPull h p_h hp_h]
    exact (Function.Bijective.of_comp_iff p_h (hGenBij S₂)).mp (hcomp_eq.symm ▸ hGenBij S₁)

  have hCohPresheaf0Equiv : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      (J : CategoryTheory.GrothendieckTopology C)
      [CategoryTheory.HasSheafify J AddCommGrpCat.{u}]
      [CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J AddCommGrpCat.{u})]
      (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      ∃ (ε : ∀ W : C, ↥((G.cohomologyPresheaf 0).obj (Opposite.op W)) ≃ ↥(G.obj.obj (Opposite.op W))),
        ∀ {W₁ W₂ : C} (u : W₁ ⟶ W₂) (z : ↥((G.cohomologyPresheaf 0).obj (Opposite.op W₂))),
          ε W₁ (((G.cohomologyPresheaf 0).map u.op).hom z) = (G.obj.map u.op).hom (ε W₂ z) := by
    intro C _ J _ _ G
    let P_free : C → (Cᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      fun W => CategoryTheory.yoneda.obj W ⋙ AddCommGrpCat.free
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let adj_free := AddCommGrpCat.adj.{u}.whiskerRight Cᵒᵖ
    let hom₀Equiv : ∀ W : C, ↥((G.cohomologyPresheaf 0).obj (Opposite.op W)) ≃
        (((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj (P_free W)) ⟶ G) :=
      fun _ => CategoryTheory.Abelian.Ext.homEquiv₀
    let tailEquiv : ∀ W : C,
        (((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj (P_free W)) ⟶ G) ≃
          ↥(G.obj.obj (Opposite.op W)) :=
      fun W =>
        (adj_sh.homEquiv (P_free W) G).trans
          ((adj_free.homEquiv (CategoryTheory.yoneda.obj W) G.obj).trans CategoryTheory.yonedaEquiv)
    let ε : ∀ W : C, ↥((G.cohomologyPresheaf 0).obj (Opposite.op W)) ≃ ↥(G.obj.obj (Opposite.op W)) :=
      fun W => (hom₀Equiv W).trans (tailEquiv W)
    refine ⟨ε, fun {W₁ W₂} u z => ?_⟩
    obtain ⟨φ, rfl⟩ :
        ∃ φ : ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj (P_free W₂)) ⟶ G,
          CategoryTheory.Abelian.Ext.mk₀.{u} φ = z :=
      ⟨hom₀Equiv W₂ z, (CategoryTheory.Abelian.Ext.homEquiv₀).symm_apply_apply z⟩
    let φ_u : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj (P_free W₁) ⟶
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj (P_free W₂) :=
      (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map
        (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free)
    have hmap_z : ((G.cohomologyPresheaf 0).map u.op).hom (CategoryTheory.Abelian.Ext.mk₀.{u} φ) =
        CategoryTheory.Abelian.Ext.mk₀.{u} (φ_u ≫ φ) :=
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ φ_u φ
    have h1 : ε W₁ (((G.cohomologyPresheaf 0).map u.op).hom (CategoryTheory.Abelian.Ext.mk₀.{u} φ)) =
        tailEquiv W₁ (φ_u ≫ φ) :=
      (congrArg (ε W₁) hmap_z).trans
        (congrArg (tailEquiv W₁)
          ((CategoryTheory.Abelian.Ext.homEquiv₀).apply_symm_apply (φ_u ≫ φ)))
    have h2 : ε W₂ (CategoryTheory.Abelian.Ext.mk₀.{u} φ) = tailEquiv W₂ φ :=
      congrArg (tailEquiv W₂) ((CategoryTheory.Abelian.Ext.homEquiv₀).apply_symm_apply φ)
    have h_sh : (adj_sh.homEquiv (P_free W₁) G) (φ_u ≫ φ) =
        CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free ≫
          (adj_sh.homEquiv (P_free W₂) G) φ :=
      CategoryTheory.Adjunction.homEquiv_naturality_left adj_sh _ φ
    have h_fr : (adj_free.homEquiv (CategoryTheory.yoneda.obj W₁) G.obj)
          (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u) AddCommGrpCat.free ≫
            (adj_sh.homEquiv (P_free W₂) G) φ) =
        CategoryTheory.yoneda.map u ≫
          (adj_free.homEquiv (CategoryTheory.yoneda.obj W₂) G.obj)
            ((adj_sh.homEquiv (P_free W₂) G) φ) :=
      CategoryTheory.Adjunction.homEquiv_naturality_left adj_free (CategoryTheory.yoneda.map u) _
    have h_yon : CategoryTheory.yonedaEquiv
          (CategoryTheory.yoneda.map u ≫
            (adj_free.homEquiv (CategoryTheory.yoneda.obj W₂) G.obj)
              ((adj_sh.homEquiv (P_free W₂) G) φ)) =
        (G.obj.map u.op).hom (tailEquiv W₂ φ) :=
      (CategoryTheory.yonedaEquiv_naturality _ u).symm
    exact h1.trans
      (((congrArg (fun α => CategoryTheory.yonedaEquiv
          ((adj_free.homEquiv (CategoryTheory.yoneda.obj W₁) G.obj) α)) h_sh).trans
        (congrArg CategoryTheory.yonedaEquiv h_fr)).trans
        (h_yon.trans (congrArg (G.obj.map u.op).hom h2.symm)))

  have hBinProdBij : ∀ (F : Fin 2 → Type u) [∀ b, CommRing (F b)]
      (p : ∀ b : Fin 2,
        weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (∀ i : Fin 2, F i))) ℓ 0 →+
          weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (F b))) ℓ 0),
      (∀ b : Fin 2,
        WeilIsTorsionEtalePullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom F b))) ℓ 0 (p b)) →
      Function.Bijective (fun x => (p 0 x, p 1 x)) := by
    intro F _ p hp
    let R_pi := ∀ b : Fin 2, F b
    let S := AlgebraicGeometry.Spec (CommRingCat.of R_pi)
    let π : ∀ b : Fin 2, AlgebraicGeometry.Spec (CommRingCat.of (F b)) ⟶ S :=
      fun b => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom F b))
    have hLoc_pi : ∀ b : Fin 2,
        @IsLocalization.Away R_pi _ (Pi.single b (1 : F b)) (F b) _ (Pi.evalRingHom F b).toAlgebra := by
      intro b
      letI : Algebra R_pi (F b) := (Pi.evalRingHom F b).toAlgebra
      refine
        { map_units := by
            rintro ⟨_, n, rfl⟩
            change IsUnit ((Pi.single b (1 : F b) ^ n) b)
            rw [Pi.pow_apply, Pi.single_eq_same, one_pow]
            exact isUnit_one
          surj := fun y =>
            ⟨(Pi.single b y, 1), by
              change y * (Pi.evalRingHom F b) 1 = (Pi.evalRingHom F b) (Pi.single b y)
              rw [map_one, mul_one, Pi.evalRingHom_apply, Pi.single_eq_same]⟩
          exists_of_eq := fun {x₁ x₂} hxy =>
            ⟨⟨Pi.single b 1, Submonoid.mem_powers _⟩, by
              ext j
              change (Pi.single b (1 : F b) * x₁) j = (Pi.single b (1 : F b) * x₂) j
              rw [Pi.mul_apply, Pi.mul_apply]
              by_cases hj : j = b
              · rw [hj]; simp [(show x₁ b = x₂ b from hxy)]
              · simp [Pi.single_eq_of_ne hj]⟩ }
    haveI : ∀ b : Fin 2, AlgebraicGeometry.IsOpenImmersion (π b) := fun b => by
      letI : Algebra R_pi (F b) := (Pi.evalRingHom F b).toAlgebra
      letI : IsLocalization.Away (Pi.single b (1 : F b)) (F b) := hLoc_pi b
      exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization (Pi.single b (1 : F b))
    constructor
    · intro x₁ x₂ h_eq
      have h0 : p 0 (x₁ - x₂) = 0 := by rw [map_sub, sub_eq_zero]; exact (Prod.mk.inj h_eq).1
      have h1 : p 1 (x₁ - x₂) = 0 := by rw [map_sub, sub_eq_zero]; exact (Prod.mk.inj h_eq).2
      have hdiff0 : x₁ - x₂ = 0 :=
        weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.{u}.2 2 ℓ 0 F (x₁ - x₂) fun j => by
          fin_cases j
          · exact ⟨p 0, hp 0, h0⟩
          · exact ⟨p 1, hp 1, h1⟩
      exact sub_eq_zero.mp hdiff0
    · rintro ⟨y₀, y₁⟩
      let G := weilEtaleTorsionSheaf S ℓ
      obtain ⟨Θ, hΘ⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.{u}.1 S ℓ 0
      obtain ⟨ε, hε⟩ := hCohPresheaf0Equiv S.smallEtaleTopology G
      let T_S := weilEtaleIdTerminal.{u} S
      let W_b : ∀ b : Fin 2, S.Etale :=
        fun b => CategoryTheory.MorphismProperty.Over.mk ⊤ (π b) inferInstance
      let u_b : ∀ b : Fin 2, W_b b ⟶ T_S :=
        fun b => CategoryTheory.MorphismProperty.Over.homMk (π b) (Category.comp_id _)
      let s₀ : ↥(G.obj.obj (Opposite.op (W_b 0))) := ε (W_b 0) ((Θ (W_b 0)).symm y₀)
      let s₁ : ↥(G.obj.obj (Opposite.op (W_b 1))) := ε (W_b 1) ((Θ (W_b 1)).symm y₁)
      let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
      let homOfElem : ∀ {U : S.Etale}, ↥(G.obj.obj (Opposite.op U)) → (Aℤ ⟶ G.obj.obj (Opposite.op U)) :=
        fun s => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • s
            map_zero' := zero_zsmul s
            map_add' := fun a b => add_zsmul s a.down b.down }
      have hDisjOverlap : ∀ (Z : S.Etale) (g₀ : Z ⟶ W_b 0) (g₁ : Z ⟶ W_b 1),
          IsEmpty ↥Z.left := by
        intro Z g₀ g₁
        refine ⟨fun z => ?_⟩
        have hcomp : g₀.left ≫ π 0 = g₁.left ≫ π 1 :=
          (CategoryTheory.MorphismProperty.Over.w g₀).trans
            (CategoryTheory.MorphismProperty.Over.w g₁).symm
        let pt_S : PrimeSpectrum R_pi := (g₀.left ≫ π 0).base z
        have hpt_eq : pt_S = (g₁.left ≫ π 1).base z := congrArg (fun m => m.base z) hcomp
        have hnot0 : Pi.single 0 (1 : F 0) ∉ pt_S.asIdeal := by
          change (Pi.evalRingHom F 0) (Pi.single 0 1) ∉ (g₀.left.base z).asIdeal
          rw [Pi.evalRingHom_apply, Pi.single_eq_same]
          exact fun h1 => (g₀.left.base z).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
        have hnot1 : Pi.single 1 (1 : F 1) ∉ pt_S.asIdeal := by
          rw [hpt_eq]
          change (Pi.evalRingHom F 1) (Pi.single 1 1) ∉ (g₁.left.base z).asIdeal
          rw [Pi.evalRingHom_apply, Pi.single_eq_same]
          exact fun h1 => (g₁.left.base z).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
        have hprod : (Pi.single 0 (1 : F 0) : R_pi) * Pi.single 1 (1 : F 1) = 0 := by
          ext j; fin_cases j <;> simp
        have hmem0 : (Pi.single 0 (1 : F 0) : R_pi) * Pi.single 1 (1 : F 1) ∈ pt_S.asIdeal := by
          rw [hprod]; exact pt_S.asIdeal.zero_mem
        exact (pt_S.isPrime.mem_or_mem hmem0).elim hnot0 hnot1
      let R_cov : CategoryTheory.Sieve T_S :=
        { arrows := fun {Z} f => (∃ g₀ : Z ⟶ W_b 0, g₀ ≫ u_b 0 = f) ∨ (∃ g₁ : Z ⟶ W_b 1, g₁ ≫ u_b 1 = f)
          downward_closed := by
            rintro Z₁ Z₂ f (⟨g₀, rfl⟩ | ⟨g₁, rfl⟩) k
            · exact Or.inl ⟨k ≫ g₀, Category.assoc k g₀ (u_b 0)⟩
            · exact Or.inr ⟨k ≫ g₁, Category.assoc k g₁ (u_b 1)⟩ }
      have hR_cov_mem : R_cov ∈ S.smallEtaleTopology T_S := by
        rw [hMemEtale S T_S R_cov]
        intro pt
        have hsum1 : (Pi.single 0 (1 : F 0) : R_pi) + Pi.single 1 (1 : F 1) = 1 := by
          ext j; fin_cases j <;> simp
        by_cases h0_in : (Pi.single 0 (1 : F 0) : R_pi) ∈ pt.asIdeal
        · have h1_notin : (Pi.single 1 (1 : F 1) : R_pi) ∉ pt.asIdeal := fun h1_in =>
            pt.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr (hsum1 ▸ pt.asIdeal.add_mem h0_in h1_in))
          letI : Algebra R_pi (F 1) := (Pi.evalRingHom F 1).toAlgebra
          letI : IsLocalization.Away (Pi.single 1 (1 : F 1)) (F 1) := hLoc_pi 1
          have hmem_range : pt ∈ Set.range (PrimeSpectrum.comap (algebraMap R_pi (F 1))) := by
            rw [PrimeSpectrum.localization_away_comap_range (F 1) (Pi.single 1 (1 : F 1))]
            exact h1_notin
          obtain ⟨q₁, hq₁⟩ := hmem_range
          exact ⟨W_b 1, u_b 1, q₁, Or.inr ⟨𝟙 _, Category.id_comp _⟩, inferInstance, hq₁⟩
        · letI : Algebra R_pi (F 0) := (Pi.evalRingHom F 0).toAlgebra
          letI : IsLocalization.Away (Pi.single 0 (1 : F 0)) (F 0) := hLoc_pi 0
          have hmem_range : pt ∈ Set.range (PrimeSpectrum.comap (algebraMap R_pi (F 0))) := by
            rw [PrimeSpectrum.localization_away_comap_range (F 0) (Pi.single 0 (1 : F 0))]
            exact h0_in
          obtain ⟨q₀, hq₀⟩ := hmem_range
          exact ⟨W_b 0, u_b 0, q₀, Or.inl ⟨𝟙 _, Category.id_comp _⟩, inferInstance, hq₀⟩
      let fam : ∀ {Z : S.Etale} (f : Z ⟶ T_S), R_cov.arrows f → (Aℤ ⟶ G.obj.obj (Opposite.op Z)) :=
        fun {Z} f hf =>
          if h0 : ∃ g₀ : Z ⟶ W_b 0, g₀ ≫ u_b 0 = f then
            homOfElem s₀ ≫ G.obj.map h0.choose.op
          else
            homOfElem s₁ ≫ G.obj.map (hf.resolve_left h0).choose.op
      have hfam_0 : ∀ {Z : S.Etale} (f : Z ⟶ T_S) (hf : R_cov.arrows f) (g₀ : Z ⟶ W_b 0),
          g₀ ≫ u_b 0 = f → fam f hf = homOfElem s₀ ≫ G.obj.map g₀.op := by
        intro Z f hf g₀ hg₀
        have hex0 : ∃ g₀' : Z ⟶ W_b 0, g₀' ≫ u_b 0 = f := ⟨g₀, hg₀⟩
        dsimp [fam]; simp only [hex0, ↓reduceDIte]
        have heq_g : hex0.choose = g₀ := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext
          · have h1 : hex0.choose.left ≫ π 0 = g₀.left ≫ π 0 :=
              (congrArg (fun m => m.left) hex0.choose_spec).trans
                (congrArg (fun m => m.left) hg₀).symm
            exact (cancel_mono (π 0)).mp h1
          · exact Subsingleton.elim _ _
        rw [heq_g]
      have hfam_1 : ∀ {Z : S.Etale} (f : Z ⟶ T_S) (hf : R_cov.arrows f) (g₁ : Z ⟶ W_b 1),
          g₁ ≫ u_b 1 = f → fam f hf = homOfElem s₁ ≫ G.obj.map g₁.op := by
        intro Z f hf g₁ hg₁
        dsimp [fam]
        split_ifs with hex0
        · have : Subsingleton ↥(G.obj.obj (Opposite.op Z)) :=
            hEmptySheafSub G Z (hDisjOverlap Z hex0.choose g₁)
          exact AddCommGrpCat.ext fun _ => Subsingleton.elim _ _
        · have heq_g : (hf.resolve_left hex0).choose = g₁ := by
            apply CategoryTheory.MorphismProperty.Comma.Hom.ext
            · have h1 : (hf.resolve_left hex0).choose.left ≫ π 1 = g₁.left ≫ π 1 :=
                (congrArg (fun m => m.left) (hf.resolve_left hex0).choose_spec).trans
                  (congrArg (fun m => m.left) hg₁).symm
              exact (cancel_mono (π 1)).mp h1
            · exact Subsingleton.elim _ _
          rw [heq_g]
      have hfam_compat : ∀ {Z₁ Z₂ : S.Etale} (k_m : Z₁ ⟶ Z₂) (f₁ : Z₁ ⟶ T_S) (f₂ : Z₂ ⟶ T_S)
          (hf₁ : R_cov.arrows f₁) (hf₂ : R_cov.arrows f₂),
          k_m ≫ f₂ = f₁ → fam f₁ hf₁ = fam f₂ hf₂ ≫ G.obj.map k_m.op := by
        intro Z₁ Z₂ k_m f₁ f₂ hf₁ hf₂ hkf
        rcases hf₂ with ⟨g₀, hg₀⟩ | ⟨g₁, hg₁⟩
        · rw [hfam_0 f₂ (Or.inl ⟨g₀, hg₀⟩) g₀ hg₀,
              hfam_0 f₁ hf₁ (k_m ≫ g₀) (by rw [Category.assoc, hg₀, hkf]),
              Category.assoc, ← G.obj.map_comp, ← op_comp]
        · rw [hfam_1 f₂ (Or.inr ⟨g₁, hg₁⟩) g₁ hg₁,
              hfam_1 f₁ hf₁ (k_m ≫ g₁) (by rw [Category.assoc, hg₁, hkf]),
              Category.assoc, ← G.obj.map_comp, ← op_comp]
      have hfam_presieve_compat :
          CategoryTheory.Presieve.FamilyOfElements.Compatible
            (P := G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ))
            (R := (R_cov : CategoryTheory.Presieve T_S))
            (fun {Z} f hf => fam f hf) := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm_g
        have h1 := hfam_compat g₁ (g₁ ≫ f₁) f₁ (R_cov.downward_closed hf₁ g₁) hf₁ rfl
        have h2 := hfam_compat g₂ (g₁ ≫ f₁) f₂ (R_cov.downward_closed hf₁ g₁) hf₂ hcomm_g.symm
        exact h1.symm.trans h2
      let hSheafFor := G.property Aℤ R_cov hR_cov_mem
      let amalg : Aℤ ⟶ G.obj.obj (Opposite.op T_S) :=
        hSheafFor.amalgamate (fun {Z} f hf => fam f hf) hfam_presieve_compat
      have hamalg : ∀ {Z : S.Etale} (f : Z ⟶ T_S) (hf : R_cov.arrows f),
          amalg ≫ G.obj.map f.op = fam f hf :=
        fun f hf => hSheafFor.valid_glue hfam_presieve_compat f hf
      let s_top : ↥(G.obj.obj (Opposite.op T_S)) := amalg.hom (ULift.up (1 : ℤ))
      let z_top : ↥((G.cohomologyPresheaf 0).obj (Opposite.op T_S)) := (ε T_S).symm s_top
      have hz_res0 : ((G.cohomologyPresheaf 0).map (u_b 0).op).hom z_top = (Θ (W_b 0)).symm y₀ := by
        apply (ε (W_b 0)).injective
        rw [hε (u_b 0) z_top, (ε T_S).apply_symm_apply]
        have h0 := congrArg (fun m => m.hom (ULift.up (1 : ℤ)))
          (hamalg (u_b 0) (Or.inl ⟨𝟙 _, Category.id_comp _⟩))
        rw [hfam_0 (u_b 0) (Or.inl ⟨𝟙 _, Category.id_comp _⟩) (𝟙 _) (Category.id_comp _),
          op_id, G.obj.map_id, Category.comp_id] at h0
        change (G.obj.map (u_b 0).op).hom s_top = s₀
        exact h0.trans (one_zsmul s₀)
      have hz_res1 : ((G.cohomologyPresheaf 0).map (u_b 1).op).hom z_top = (Θ (W_b 1)).symm y₁ := by
        apply (ε (W_b 1)).injective
        rw [hε (u_b 1) z_top, (ε T_S).apply_symm_apply]
        have h1 := congrArg (fun m => m.hom (ULift.up (1 : ℤ)))
          (hamalg (u_b 1) (Or.inr ⟨𝟙 _, Category.id_comp _⟩))
        rw [hfam_1 (u_b 1) (Or.inr ⟨𝟙 _, Category.id_comp _⟩) (𝟙 _) (Category.id_comp _),
          op_id, G.obj.map_id, Category.comp_id] at h1
        change (G.obj.map (u_b 1).op).hom s_top = s₁
        exact h1.trans (one_zsmul s₁)
      refine ⟨Θ T_S z_top, Prod.ext ?_ ?_⟩
      · exact (hΘ (u_b 0) (p 0) (hp 0) z_top).symm.trans
          ((congrArg (Θ (W_b 0)) hz_res0).trans ((Θ (W_b 0)).apply_symm_apply y₀))
      · exact (hΘ (u_b 1) (p 1) (hp 1) z_top).symm.trans
          ((congrArg (Θ (W_b 1)) hz_res1).trans ((Θ (W_b 1)).apply_symm_apply y₁))

  let idempPairFam : ∀ {B : Type u} [CommRing B], B → B → Fin 2 → Type u
    | _, _, e₁, _, ⟨0, _⟩ => Localization.Away e₁
    | _, _, _, e₂, ⟨_ + 1, _⟩ => Localization.Away e₂
  letI instIdempPairFam : ∀ {B : Type u} [CommRing B] (e₁ e₂ : B) (b : Fin 2),
      CommRing (idempPairFam e₁ e₂ b)
    | _, _, _, _, ⟨0, _⟩ => inferInstance
    | _, _, _, _, ⟨_ + 1, _⟩ => inferInstance

  have hIdempAwayEquiv : ∀ {B : Type u} [CommRing B] (e e₁ e₂ : B),
      e * e = e → e₁ * e₁ = e₁ → e₂ * e₂ = e₂ → e₁ * e₂ = 0 → e₁ + e₂ = e →
      ∃ (Θ_eqv : Localization.Away e ≃+* (∀ b : Fin 2, idempPairFam e₁ e₂ b)),
        (∀ x : B, (Pi.evalRingHom (idempPairFam e₁ e₂) 0) (Θ_eqv (algebraMap B (Localization.Away e) x)) =
          algebraMap B (Localization.Away e₁) x) ∧
        (∀ x : B, (Pi.evalRingHom (idempPairFam e₁ e₂) 1) (Θ_eqv (algebraMap B (Localization.Away e) x)) =
          algebraMap B (Localization.Away e₂) x) := by
    intro B _ e e₁ e₂ he he₁ he₂ he12 he_sum
    let F := idempPairFam e₁ e₂
    have hIdempLoc : ∀ (c : B), c * c = c →
        algebraMap B (Localization.Away c) c = 1 ∧
        Function.Surjective (algebraMap B (Localization.Away c)) ∧
        ∀ x : B, algebraMap B (Localization.Away c) x = 0 ↔ c * x = 0 := by
      intro c hc
      have hc_eq1 : algebraMap B (Localization.Away c) c = 1 := by
        rw [← sub_eq_zero, ← map_one (algebraMap B (Localization.Away c)), ← map_sub]
        exact (IsLocalization.map_eq_zero_iff (Submonoid.powers c) (Localization.Away c) (c - 1)).mpr
          ⟨⟨c, 1, pow_one c⟩, by dsimp; linear_combination hc⟩
      have hc_pow : ∀ (n : ℕ), 1 ≤ n → c ^ n = c := by
        intro n hn
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, (Nat.sub_add_cancel hn).symm⟩
        induction m with
        | zero => exact pow_one c
        | succ m ih => rw [pow_succ, ih (Nat.succ_pos m), hc]
      refine ⟨hc_eq1, fun z => ?_, fun x => ?_⟩
      · obtain ⟨⟨x, ⟨_, n, rfl⟩⟩, hzx⟩ := IsLocalization.surj (Submonoid.powers c) z
        refine ⟨x, ?_⟩
        dsimp at hzx
        rw [map_pow, hc_eq1, one_pow, mul_one] at hzx
        exact hzx.symm
      · rw [IsLocalization.map_eq_zero_iff (Submonoid.powers c) (Localization.Away c) x]
        constructor
        · rintro ⟨⟨_, n, rfl⟩, hnx⟩
          dsimp at hnx
          rcases Nat.eq_zero_or_pos n with rfl | hpos
          · rw [pow_zero, one_mul] at hnx; rw [hnx, mul_zero]
          · rwa [hc_pow n hpos] at hnx
        · intro hcx
          exact ⟨⟨c, 1, pow_one c⟩, hcx⟩
    obtain ⟨he_1, he_surj, he_ker⟩ := hIdempLoc e he
    obtain ⟨he₁_1, he₁_surj, he₁_ker⟩ := hIdempLoc e₁ he₁
    obtain ⟨he₂_1, he₂_surj, he₂_ker⟩ := hIdempLoc e₂ he₂
    have hu₁ : IsUnit (algebraMap B (Localization.Away e₁) e) := by
      have h1 : algebraMap B (Localization.Away e₁) e = 1 := by
        rw [← he_sum, map_add, he₁_1, (he₁_ker e₂).mpr he12, add_zero]
      rw [h1]; exact isUnit_one
    have hu₂ : IsUnit (algebraMap B (Localization.Away e₂) e) := by
      have h1 : algebraMap B (Localization.Away e₂) e = 1 := by
        rw [← he_sum, map_add, he₂_1, (he₂_ker e₁).mpr (by rw [mul_comm]; exact he12), zero_add]
      rw [h1]; exact isUnit_one
    let ρ₁ : Localization.Away e →+* Localization.Away e₁ := IsLocalization.Away.lift e hu₁
    let ρ₂ : Localization.Away e →+* Localization.Away e₂ := IsLocalization.Away.lift e hu₂
    let Φ_hom : Localization.Away e →+* (∀ b : Fin 2, idempPairFam e₁ e₂ b) :=
      { toFun := fun z b =>
          match b with
          | ⟨0, _⟩ => ρ₁ z
          | ⟨_ + 1, _⟩ => ρ₂ z
        map_one' := by
          ext ⟨_ | _, _⟩
          · exact map_one ρ₁
          · exact map_one ρ₂
        map_mul' := fun x y => by
          ext ⟨_ | _, _⟩
          · exact map_mul ρ₁ x y
          · exact map_mul ρ₂ x y
        map_zero' := by
          ext ⟨_ | _, _⟩
          · exact map_zero ρ₁
          · exact map_zero ρ₂
        map_add' := fun x y => by
          ext ⟨_ | _, _⟩
          · exact map_add ρ₁ x y
          · exact map_add ρ₂ x y }
    have hΦ_bij : Function.Bijective Φ_hom := by
      refine ⟨(injective_iff_map_eq_zero Φ_hom).mpr fun z hz => ?_, fun w => ?_⟩
      · obtain ⟨x, rfl⟩ := he_surj z
        have hz0 : algebraMap B (Localization.Away e₁) x = 0 :=
          (IsLocalization.Away.lift_eq e hu₁ x).symm.trans (congrFun hz 0)
        have hz1 : algebraMap B (Localization.Away e₂) x = 0 :=
          (IsLocalization.Away.lift_eq e hu₂ x).symm.trans (congrFun hz 1)
        have hx1 : e₁ * x = 0 := (he₁_ker x).mp hz0
        have hx2 : e₂ * x = 0 := (he₂_ker x).mp hz1
        exact (he_ker x).mpr (by rw [← he_sum, add_mul, hx1, hx2, add_zero])
      · obtain ⟨x₁, hx₁⟩ := he₁_surj (w 0)
        obtain ⟨x₂, hx₂⟩ := he₂_surj (w 1)
        refine ⟨algebraMap B (Localization.Away e) (e₁ * x₁ + e₂ * x₂), ?_⟩
        ext ⟨b_val, hb_lt⟩
        rcases b_val with _ | _ | b_rest
        · change ρ₁ (algebraMap B _ (e₁ * x₁ + e₂ * x₂)) = w 0
          rw [IsLocalization.Away.lift_eq e hu₁, map_add, map_mul, map_mul, he₁_1, one_mul,
            (he₁_ker e₂).mpr he12, zero_mul, add_zero, hx₁]
        · change ρ₂ (algebraMap B _ (e₁ * x₁ + e₂ * x₂)) = w 1
          rw [IsLocalization.Away.lift_eq e hu₂, map_add, map_mul, map_mul, he₂_1, one_mul,
            (he₂_ker e₁).mpr (mul_comm e₂ e₁ ▸ he12), zero_mul, zero_add, hx₂]
        · omega
    exact ⟨RingEquiv.ofBijective Φ_hom hΦ_bij,
      fun x => IsLocalization.Away.lift_eq e hu₁ x,
      fun x => IsLocalization.Away.lift_eq e hu₂ x⟩

  intro S_d U₀ Gm_k j_Gm p_A1 Y_d U_d j_d E E_loc w_E _ ι_E ϕ_E hϕ_E ψ_E hψ_E

  have hNoeth_E : IsNoetherianRing ↑E := by
    let P_Y := MvPolynomial (Fin d_rel) (Polynomial k)
    let f_mv : CommRingCat.of k ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) k) :=
      CommRingCat.ofHom MvPolynomial.C
    let g_mv : CommRingCat.of k ⟶ CommRingCat.of (Polynomial k) :=
      CommRingCat.ofHom Polynomial.C
    let inl_mv : CommRingCat.of (MvPolynomial (Fin d_rel) k) ⟶ CommRingCat.of P_Y :=
      CommRingCat.ofHom (MvPolynomial.map Polynomial.C)
    let inr_mv : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of P_Y :=
      CommRingCat.ofHom MvPolynomial.C
    have hcomm : f_mv ≫ inl_mv = g_mv ≫ inr_mv := by
      apply CommRingCat.hom_ext; apply RingHom.ext; intro a; exact MvPolynomial.map_C Polynomial.C a
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk inl_mv inr_mv hcomm) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm
        (fun s => CommRingCat.ofHom
          (MvPolynomial.eval₂Hom s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m))))
        (fun s => by
          apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
          · intro a
            change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map Polynomial.C (MvPolynomial.C a)) =
              s.inl.hom (MvPolynomial.C a)
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) a).symm
          · intro m
            change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map Polynomial.C (MvPolynomial.X m)) =
              s.inl.hom (MvPolynomial.X m)
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X'])
        (fun s => by
          apply CommRingCat.hom_ext; apply RingHom.ext; intro b
          exact MvPolynomial.eval₂Hom_C s.inr.hom (fun m => s.inl.hom (MvPolynomial.X m)) b)
        (fun s m hm_l hm_r => by
          apply CommRingCat.hom_ext; apply MvPolynomial.ringHom_ext
          · intro b
            change m.hom (MvPolynomial.C b) = MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.C b)
            rw [MvPolynomial.eval₂Hom_C]
            exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) b
          · intro idx
            change m.hom (MvPolynomial.X idx) = MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.X idx)
            rw [MvPolynomial.eval₂Hom_X']
            have hX := DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_l) (MvPolynomial.X idx)
            change m.hom (MvPolynomial.map Polynomial.C (MvPolynomial.X idx)) = s.inl.hom (MvPolynomial.X idx) at hX
            rwa [MvPolynomial.map_X] at hX)
    let e_Yd : AlgebraicGeometry.Spec (CommRingCat.of P_Y) ≅ Y_d :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout f_mv g_mv inl_mv inr_mv
        (CategoryTheory.IsPushout.of_isColimit hColim)).isoPullback
    let γ_Y : CommRingCat.of P_Y ⟶ E := AlgebraicGeometry.Spec.preimage (w_E ≫ e_Yd.inv)
    have hγ_spec : AlgebraicGeometry.Spec.map γ_Y = w_E ≫ e_Yd.inv :=
      AlgebraicGeometry.Spec.map_preimage _
    have hγ_et : γ_Y.hom.Etale := by
      apply (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
      rw [hγ_spec]; infer_instance
    letI : Algebra P_Y ↑E := γ_Y.hom.toAlgebra
    haveI : Algebra.Etale P_Y ↑E := RingHom.etale_algebraMap.mp hγ_et
    haveI : Algebra.FinitePresentation P_Y ↑E := Algebra.Etale.finitePresentation
    haveI : Algebra.FiniteType P_Y ↑E := Algebra.FiniteType.of_finitePresentation
    exact Algebra.FiniteType.isNoetherianRing P_Y ↑E
  haveI : IsNoetherianRing ↑E := hNoeth_E

  have hLiftAwayEx : ∀ (c : ↑E),
      ∃ g : CommRingCat.of (Localization.Away c) ⟶ CommRingCat.of (Localization.Away (ι_E.hom c)),
        ∀ x : ↑E, g.hom (algebraMap ↑E (Localization.Away c) x) =
          algebraMap ↑E_loc (Localization.Away (ι_E.hom c)) (ι_E.hom x) := by
    intro c
    have hu : IsUnit (((algebraMap ↑E_loc (Localization.Away (ι_E.hom c))).comp ι_E.hom) c) :=
      IsLocalization.Away.algebraMap_isUnit (ι_E.hom c)
    exact ⟨CommRingCat.ofHom (IsLocalization.Away.lift c hu), IsLocalization.Away.lift_eq c hu⟩
  let liftAwayHom : ∀ (c : ↑E),
      CommRingCat.of (Localization.Away c) ⟶ CommRingCat.of (Localization.Away (ι_E.hom c)) :=
    fun c => (hLiftAwayEx c).choose
  have hLiftAwayEq : ∀ (c : ↑E) (x : ↑E),
      (liftAwayHom c).hom (algebraMap ↑E (Localization.Away c) x) =
        algebraMap ↑E_loc (Localization.Away (ι_E.hom c)) (ι_E.hom x) :=
    fun c x => (hLiftAwayEx c).choose_spec x

  have hOpenChartForIdemp : ∀ (e : ↑E),
      let W_e := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away e))
      let i_e : E ⟶ CommRingCat.of (Localization.Away e) :=
        CommRingCat.ofHom (algebraMap ↑E (Localization.Away e))
      let u_e : W_e ⟶ Y_d := AlgebraicGeometry.Spec.map i_e ≫ w_E
      AlgebraicGeometry.Etale u_e ∧
      ∃ (e_pb : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ι_E.hom e))) ≅
          CategoryTheory.Limits.pullback j_d u_e),
        e_pb.hom ≫ CategoryTheory.Limits.pullback.snd j_d u_e =
          AlgebraicGeometry.Spec.map (liftAwayHom e) := by
    intro e W_e i_e u_e
    haveI : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map i_e) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization e
    have hu_et : AlgebraicGeometry.Etale u_e :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) _ _ inferInstance inferInstance
    let e' : ↑E_loc := ι_E.hom e
    let i_eloc : E_loc ⟶ CommRingCat.of (Localization.Away e') :=
      CommRingCat.ofHom (algebraMap ↑E_loc (Localization.Away e'))
    let ι_e := liftAwayHom e
    have hcomm_e : i_e ≫ ι_e = ι_E ≫ i_eloc := by
      apply CommRingCat.hom_ext; ext x
      exact hLiftAwayEq e x
    have hu_s_of : ∀ s : CategoryTheory.Limits.PushoutCocone i_e ι_E, IsUnit (s.inr.hom e') := by
      intro s
      have hcond : s.inl.hom.comp i_e.hom = s.inr.hom.comp ι_E.hom :=
        congrArg CommRingCat.Hom.hom s.condition
      have h1 : s.inl.hom (i_e.hom e) = s.inr.hom e' := DFunLike.congr_fun hcond e
      exact h1 ▸ (IsLocalization.Away.algebraMap_isUnit e).map s.inl.hom
    have hColim_e : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk ι_e i_eloc hcomm_e) := by
      refine CategoryTheory.Limits.PushoutCocone.IsColimit.mk hcomm_e
        (fun s => CommRingCat.ofHom (IsLocalization.Away.lift e' (g := s.inr.hom) (hu_s_of s)))
        (fun s => by
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers e)
          ext x
          have h1 : ι_e.hom (i_e.hom x) = i_eloc.hom (ι_E.hom x) :=
            DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hcomm_e) x
          change (IsLocalization.Away.lift e' (hu_s_of s)) (ι_e.hom (i_e.hom x)) = s.inl.hom (i_e.hom x)
          rw [h1]
          exact (IsLocalization.Away.lift_eq e' (hu_s_of s) (ι_E.hom x)).trans
            (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) x).symm)
        (fun s => by
          apply CommRingCat.hom_ext; ext x; exact IsLocalization.Away.lift_eq e' (hu_s_of s) x)
        (fun s m _ hm_r => by
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers e')
          ext x
          exact (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom hm_r) x).trans
            (IsLocalization.Away.lift_eq e' (hu_s_of s) x).symm)
    have hpb_spec := AlgebraicGeometry.isPullback_SpecMap_of_isPushout i_e ι_E ι_e i_eloc
      (CategoryTheory.IsPushout.of_isColimit hColim_e)
    have hpb_ue : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst j_d u_e)
        (CategoryTheory.Limits.pullback.snd j_d u_e) j_d (AlgebraicGeometry.Spec.map i_e ≫ w_E) :=
      CategoryTheory.IsPullback.of_hasPullback j_d u_e
    have hpb_wE_raw := CategoryTheory.IsPullback.of_hasPullback j_d w_E
    have hpb_wE : CategoryTheory.IsPullback
        (ϕ_E.hom ≫ CategoryTheory.Limits.pullback.fst j_d w_E)
        (AlgebraicGeometry.Spec.map ι_E) j_d w_E := by
      have hw : (ϕ_E.hom ≫ CategoryTheory.Limits.pullback.fst j_d w_E) ≫ j_d =
          AlgebraicGeometry.Spec.map ι_E ≫ w_E := by
        rw [Category.assoc, hpb_wE_raw.w, ← Category.assoc, hϕ_E]
      refine CategoryTheory.IsPullback.of_iso hpb_wE_raw ϕ_E.symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
        ?_ ?_ ?_ ?_
      · simp
      · simp [← hϕ_E]
      · simp
      · simp
    have hpb_pasted : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map i_eloc ≫ ϕ_E.hom ≫ CategoryTheory.Limits.pullback.fst j_d w_E)
        (AlgebraicGeometry.Spec.map ι_e) j_d (AlgebraicGeometry.Spec.map i_e ≫ w_E) :=
      hpb_spec.flip.paste_horiz hpb_wE
    refine ⟨hu_et,
      { hom := hpb_ue.lift _ _ hpb_pasted.w
        inv := hpb_pasted.lift _ _ hpb_ue.w
        hom_inv_id := by apply hpb_pasted.hom_ext <;> simp
        inv_hom_id := by apply hpb_ue.hom_ext <;> simp },
      hpb_ue.lift_snd _ _ _⟩

  let O_of : ↑E → TopologicalSpace.Opens (PrimeSpectrum ↑E) :=
    fun e => PrimeSpectrum.basicOpen (1 - e)
  have hMemOof : ∀ (c : ↑E), c * c = c → ∀ p : PrimeSpectrum ↑E, p ∈ O_of c ↔ c ∈ p.asIdeal := by
    intro c hc p
    change 1 - c ∉ p.asIdeal ↔ c ∈ p.asIdeal
    constructor
    · intro hnot
      have h0 : c * (1 - c) ∈ p.asIdeal := by
        have hmul : c * (1 - c) = 0 := by linear_combination -hc
        rw [hmul]; exact p.asIdeal.zero_mem
      exact (p.isPrime.mem_or_mem h0).resolve_right hnot
    · intro hmem h1c
      have h1 : (1 : ↑E) ∈ p.asIdeal := by
        have hsum : c + (1 - c) = 1 := add_sub_cancel c 1
        rw [← hsum]; exact p.asIdeal.add_mem hmem h1c
      exact p.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have hPeirce : ∀ (U_open : TopologicalSpace.Opens (PrimeSpectrum ↑E))
      (e : ↑E), O_of e = U_open → e * e = e →
      ∀ (ψ_e : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away e))) ℓ 0 →+
          weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ι_E.hom e)))) ℓ 0),
        WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (liftAwayHom e)) ℓ 0 ψ_e →
        Function.Bijective ψ_e := by
    intro U_open
    refine @WellFounded.induction _ _ wellFounded_gt
      (fun U_cur => ∀ (e : ↑E), O_of e = U_cur → e * e = e →
        ∀ (ψ_e : weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away e))) ℓ 0 →+
            weilEtaleTorsionH (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ι_E.hom e)))) ℓ 0),
          WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (liftAwayHom e)) ℓ 0 ψ_e →
          Function.Bijective ψ_e)
      U_open
      (fun U_cur ih e hOe he ψ_e hψ_e => ?_)
    let W_e := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away e))
    let U_e := AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ι_E.hom e)))
    by_cases hEmp : IsEmpty ↥W_e
    · have hEmpU : IsEmpty ↥U_e :=
        ⟨fun pt => hEmp.false ((AlgebraicGeometry.Spec.map (liftAwayHom e)).base pt)⟩
      have : Subsingleton (weilEtaleTorsionH W_e ℓ 0) := hEmptyH0Sub W_e hEmp
      have : Subsingleton (weilEtaleTorsionH U_e ℓ 0) := hEmptyH0Sub U_e hEmpU
      exact ⟨fun _ _ _ => Subsingleton.elim _ _, fun y => ⟨0, Subsingleton.elim _ y⟩⟩
    · rw [not_isEmpty_iff] at hEmp
      by_cases hConn : ConnectedSpace ↥W_e
      · obtain ⟨hu_et, e_pb, he_pb_snd⟩ := hOpenChartForIdemp e
        let u_e : W_e ⟶ Y_d :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↑E (Localization.Away e))) ≫ w_E
        haveI : AlgebraicGeometry.Etale u_e := hu_et
        obtain ⟨hConn_pb, _⟩ := hPur0 W_e u_e hConn hEmp
        obtain ⟨p_snd, hp_snd⟩ := hPullEx (CategoryTheory.Limits.pullback.snd j_d u_e) ℓ 0
        have hbij_snd : Function.Bijective p_snd := hConnPullBij _ p_snd hp_snd
        obtain ⟨p_epb, hp_epb⟩ := hPullEx e_pb.hom ℓ 0
        have hbij_epb : Function.Bijective p_epb := hPullIsoBij0 e_pb p_epb hp_epb
        have hψ_comp : WeilIsTorsionEtalePullback
            (e_pb.hom ≫ CategoryTheory.Limits.pullback.snd j_d u_e) ℓ 0 ψ_e :=
          (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ 0 ψ_e) he_pb_snd).mpr hψ_e
        have heq_ψ : ψ_e = p_epb.comp p_snd :=
          hPullComp _ _ ℓ 0 p_epb p_snd ψ_e hp_epb hp_snd hψ_comp
        rw [heq_ψ]
        exact hbij_epb.comp hbij_snd
      · have hNotPre : ¬ PreconnectedSpace (PrimeSpectrum (Localization.Away e)) := fun hPre =>
          hConn { toPreconnectedSpace := hPre, toNonempty := hEmp }
        rw [preconnectedSpace_iff_clopen] at hNotPre
        push Not at hNotPre
        obtain ⟨C_set, hClopen_C, hC_ne, hC_ne_univ⟩ := hNotPre
        let s_clopen : TopologicalSpace.Clopens (PrimeSpectrum (Localization.Away e)) := ⟨C_set, hClopen_C⟩
        let f_sub := (PrimeSpectrum.isIdempotentElemEquivClopens (R := Localization.Away e)).symm s_clopen
        let f_bar : Localization.Away e := f_sub.1
        have hf_idem : f_bar * f_bar = f_bar := f_sub.2
        have hf_open : (PrimeSpectrum.basicOpen f_bar : Set (PrimeSpectrum (Localization.Away e))) = C_set :=
          congrArg SetLike.coe (PrimeSpectrum.basicOpen_isIdempotentElemEquivClopens_symm s_clopen)
        have he_eq1 : algebraMap ↑E (Localization.Away e) e = 1 := by
          rw [← sub_eq_zero, ← map_one (algebraMap ↑E (Localization.Away e)), ← map_sub]
          exact (IsLocalization.map_eq_zero_iff (Submonoid.powers e) (Localization.Away e) (e - 1)).mpr
            ⟨⟨e, 1, pow_one e⟩, by dsimp; linear_combination he⟩
        obtain ⟨⟨a, ⟨_, n_a, rfl⟩⟩, hfa⟩ := IsLocalization.surj (Submonoid.powers e) f_bar
        have hf_eq_a : f_bar = algebraMap ↑E (Localization.Away e) (e * a) := by
          dsimp at hfa
          rw [map_pow, he_eq1, one_pow, mul_one] at hfa
          rw [hfa, map_mul, he_eq1, one_mul]
        let e₁ : ↑E := e * a
        let e₂ : ↑E := e - e₁
        have hee₁ : e * e₁ = e₁ := by dsimp [e₁]; rw [← mul_assoc, he]
        have he₁e : e₁ * e = e₁ := by rw [mul_comm, hee₁]
        have he₁_idem : e₁ * e₁ = e₁ := by
          have hmap0 : algebraMap ↑E (Localization.Away e) (e₁ * e₁ - e₁) = 0 := by
            rw [map_sub, map_mul, ← hf_eq_a, hf_idem, sub_self]
          obtain ⟨⟨_, m, rfl⟩, hm0⟩ :=
            (IsLocalization.map_eq_zero_iff (Submonoid.powers e) (Localization.Away e) (e₁ * e₁ - e₁)).mp hmap0
          dsimp at hm0
          have hpow_ann : ∀ k_p : ℕ, e ^ k_p * (e₁ * e₁ - e₁) = e₁ * e₁ - e₁ := by
            intro k_p
            induction k_p with
            | zero => simp
            | succ k_p ihk =>
              rw [pow_succ', mul_assoc, ihk]
              linear_combination (e₁ - 1) * hee₁
          rw [hpow_ann m] at hm0
          exact sub_eq_zero.mp hm0
        have he₂_idem : e₂ * e₂ = e₂ := by
          dsimp [e₂]; linear_combination he + he₁_idem - hee₁ - he₁e
        have he12 : e₁ * e₂ = 0 := by
          dsimp [e₂]; linear_combination he₁e - he₁_idem
        have he_sum : e₁ + e₂ = e := add_sub_cancel e₁ e
        have hee₂ : e * e₂ = e₂ := by
          dsimp [e₂]; linear_combination he - hee₁
        have hlt₁ : U_cur < O_of e₁ := by
          rw [← hOe]
          refine lt_of_le_of_ne (fun p hp => ?_) (fun heq => ?_)
          · rw [hMemOof e₁ he₁_idem]; rw [hMemOof e he] at hp
            rw [← he₁e]; exact p.asIdeal.mul_mem_left e₁ hp
          · obtain ⟨q, hq_not_C⟩ := Set.nonempty_compl.mpr hC_ne_univ
            have hq_not_bo : q ∉ (PrimeSpectrum.basicOpen f_bar : Set _) := by rwa [hf_open]
            have hf_in_q : f_bar ∈ q.asIdeal := by
              by_contra hnot; exact hq_not_bo hnot
            rw [hf_eq_a] at hf_in_q
            let p := PrimeSpectrum.comap (algebraMap ↑E (Localization.Away e)) q
            have hp_in_1 : p ∈ O_of e₁ := (hMemOof e₁ he₁_idem p).mpr hf_in_q
            have hp_not_e : p ∉ O_of e := by
              rw [hMemOof e he]
              intro he_in_p
              have h1_in_q : (1 : Localization.Away e) ∈ q.asIdeal := by
                rw [← he_eq1]; exact he_in_p
              exact q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_in_q)
            exact hp_not_e (heq.symm ▸ hp_in_1)
        have hlt₂ : U_cur < O_of e₂ := by
          rw [← hOe]
          refine lt_of_le_of_ne (fun p hp => ?_) (fun heq => ?_)
          · rw [hMemOof e₂ he₂_idem]; rw [hMemOof e he] at hp
            rw [← hee₂]; exact p.asIdeal.mul_mem_right e₂ hp
          · obtain ⟨q, hq_in_C⟩ := hC_ne
            have hq_bo : q ∈ PrimeSpectrum.basicOpen f_bar := by rwa [← SetLike.mem_coe, hf_open]
            have hf_notin_q : f_bar ∉ q.asIdeal := hq_bo
            have h1f_in_q : 1 - f_bar ∈ q.asIdeal := by
              have hmul0 : f_bar * (1 - f_bar) ∈ q.asIdeal := by
                have hm : f_bar * (1 - f_bar) = 0 := by linear_combination -hf_idem
                rw [hm]; exact q.asIdeal.zero_mem
              exact (q.isPrime.mem_or_mem hmul0).resolve_left hf_notin_q
            have he2_eq : algebraMap ↑E (Localization.Away e) e₂ = 1 - f_bar := by
              dsimp [e₂]; rw [map_sub, he_eq1, ← hf_eq_a]
            let p := PrimeSpectrum.comap (algebraMap ↑E (Localization.Away e)) q
            have hp_in_2 : p ∈ O_of e₂ := (hMemOof e₂ he₂_idem p).mpr (by change _ ∈ q.asIdeal; rwa [he2_eq])
            have hp_not_e : p ∉ O_of e := by
              rw [hMemOof e he]
              intro he_in_p
              have h1_in_q : (1 : Localization.Away e) ∈ q.asIdeal := by rw [← he_eq1]; exact he_in_p
              exact q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_in_q)
            exact hp_not_e (heq.symm ▸ hp_in_2)
        obtain ⟨ψ₁, hψ₁⟩ := hPullEx (AlgebraicGeometry.Spec.map (liftAwayHom e₁)) ℓ 0
        obtain ⟨ψ₂, hψ₂⟩ := hPullEx (AlgebraicGeometry.Spec.map (liftAwayHom e₂)) ℓ 0
        have hbij₁ : Function.Bijective ψ₁ := ih (O_of e₁) hlt₁ e₁ rfl he₁_idem ψ₁ hψ₁
        have hbij₂ : Function.Bijective ψ₂ := ih (O_of e₂) hlt₂ e₂ rfl he₂_idem ψ₂ hψ₂
        obtain ⟨Θ_top, hΘ_top0, hΘ_top1⟩ := hIdempAwayEquiv e e₁ e₂ he he₁_idem he₂_idem he12 he_sum
        have he'_idem : ι_E.hom e * ι_E.hom e = ι_E.hom e := by rw [← map_mul, he]
        have he₁'_idem : ι_E.hom e₁ * ι_E.hom e₁ = ι_E.hom e₁ := by rw [← map_mul, he₁_idem]
        have he₂'_idem : ι_E.hom e₂ * ι_E.hom e₂ = ι_E.hom e₂ := by rw [← map_mul, he₂_idem]
        have he12' : ι_E.hom e₁ * ι_E.hom e₂ = 0 := by rw [← map_mul, he12, map_zero]
        have he_sum' : ι_E.hom e₁ + ι_E.hom e₂ = ι_E.hom e := by rw [← map_add, he_sum]
        obtain ⟨Θ_bot, hΘ_bot0, hΘ_bot1⟩ :=
          hIdempAwayEquiv (ι_E.hom e) (ι_E.hom e₁) (ι_E.hom e₂) he'_idem he₁'_idem he₂'_idem he12' he_sum'
        let iso_top : W_e ≅ AlgebraicGeometry.Spec (CommRingCat.of (∀ b : Fin 2, idempPairFam e₁ e₂ b)) :=
          specIsoType Θ_top
        let iso_bot : U_e ≅
            AlgebraicGeometry.Spec (CommRingCat.of (∀ b : Fin 2, idempPairFam (ι_E.hom e₁) (ι_E.hom e₂) b)) :=
          specIsoType Θ_bot
        obtain ⟨p_top_iso, hp_top_iso⟩ := hPullEx iso_top.inv ℓ 0
        have hbij_top_iso : Function.Bijective p_top_iso := hPullIsoBij0 iso_top.symm p_top_iso hp_top_iso
        obtain ⟨p_bot_iso, hp_bot_iso⟩ := hPullEx iso_bot.inv ℓ 0
        have hbij_bot_iso : Function.Bijective p_bot_iso := hPullIsoBij0 iso_bot.symm p_bot_iso hp_bot_iso
        let p_top_ev : ∀ b : Fin 2, _ := fun b =>
          (hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) b))) ℓ 0).choose
        have hp_top_ev : ∀ b : Fin 2, _ := fun b =>
          (hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) b))) ℓ 0).choose_spec
        let p_bot_ev : ∀ b : Fin 2, _ := fun b =>
          (hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) b))) ℓ 0).choose
        have hp_bot_ev : ∀ b : Fin 2, _ := fun b =>
          (hPullEx (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) b))) ℓ 0).choose_spec
        have hbij_Ptop := hBinProdBij (idempPairFam e₁ e₂) p_top_ev hp_top_ev
        have hbij_Pbot := hBinProdBij (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) p_bot_ev hp_bot_ev
        have hsq0 : AlgebraicGeometry.Spec.map (liftAwayHom e₁) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) 0)) ≫ iso_top.inv =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) 0)) ≫
              iso_bot.inv ≫ AlgebraicGeometry.Spec.map (liftAwayHom e) := by
          dsimp [iso_top, iso_bot, specIsoType]
          simp only [← AlgebraicGeometry.Spec.map_comp]
          congr 1
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers e)
          ext x
          change (liftAwayHom e₁).hom ((Pi.evalRingHom (idempPairFam e₁ e₂) 0) (Θ_top (algebraMap _ _ x))) =
            (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) 0) (Θ_bot ((liftAwayHom e).hom (algebraMap _ _ x)))
          rw [hΘ_top0 x, hLiftAwayEq e₁ x, hLiftAwayEq e x]
          exact (hΘ_bot0 (ι_E.hom x)).symm
        have hsq1 : AlgebraicGeometry.Spec.map (liftAwayHom e₂) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) 1)) ≫ iso_top.inv =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) 1)) ≫
              iso_bot.inv ≫ AlgebraicGeometry.Spec.map (liftAwayHom e) := by
          dsimp [iso_top, iso_bot, specIsoType]
          simp only [← AlgebraicGeometry.Spec.map_comp]
          congr 1
          apply CommRingCat.hom_ext
          apply IsLocalization.ringHom_ext (Submonoid.powers e)
          ext x
          change (liftAwayHom e₂).hom ((Pi.evalRingHom (idempPairFam e₁ e₂) 1) (Θ_top (algebraMap _ _ x))) =
            (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) 1) (Θ_bot ((liftAwayHom e).hom (algebraMap _ _ x)))
          rw [hΘ_top1 x, hLiftAwayEq e₂ x, hLiftAwayEq e x]
          exact (hΘ_bot1 (ι_E.hom x)).symm
        have hcomm_fn :
            ((fun y => (p_bot_ev 0 y, p_bot_ev 1 y)) ∘ p_bot_iso) ∘ ψ_e =
              (Prod.map ψ₁ ψ₂) ∘ ((fun x => (p_top_ev 0 x, p_top_ev 1 x)) ∘ p_top_iso) := by
          funext x
          dsimp
          apply Prod.ext
          · obtain ⟨p_mid_l, hp_mid_l⟩ := hPullEx
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) 0)) ≫ iso_top.inv) ℓ 0
            have hml := hPullComp _ _ ℓ 0 (p_top_ev 0) p_top_iso p_mid_l (hp_top_ev 0) hp_top_iso hp_mid_l
            obtain ⟨p_mid_r, hp_mid_r⟩ := hPullEx
              (iso_bot.inv ≫ AlgebraicGeometry.Spec.map (liftAwayHom e)) ℓ 0
            have hmr := hPullComp _ _ ℓ 0 p_bot_iso ψ_e p_mid_r hp_bot_iso hψ_e hp_mid_r
            obtain ⟨p_tot, hp_tot⟩ := hPullEx
              (AlgebraicGeometry.Spec.map (liftAwayHom e₁) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) 0)) ≫ iso_top.inv) ℓ 0
            have htot_l := hPullComp _ _ ℓ 0 ψ₁ p_mid_l p_tot hψ₁ hp_mid_l hp_tot
            have hp_tot_r : WeilIsTorsionEtalePullback
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) 0)) ≫
                  iso_bot.inv ≫ AlgebraicGeometry.Spec.map (liftAwayHom e)) ℓ 0 p_tot :=
              (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ 0 p_tot) hsq0.symm).mpr hp_tot
            have htot_r := hPullComp _ _ ℓ 0 (p_bot_ev 0) p_mid_r p_tot (hp_bot_ev 0) hp_mid_r hp_tot_r
            calc
              p_bot_ev 0 (p_bot_iso (ψ_e x)) = p_bot_ev 0 (p_mid_r x) := by rw [hmr]; rfl
              _ = p_tot x := (congrFun (congrArg DFunLike.coe htot_r) x).symm
              _ = ψ₁ (p_mid_l x) := congrFun (congrArg DFunLike.coe htot_l) x
              _ = ψ₁ (p_top_ev 0 (p_top_iso x)) := by rw [hml]; rfl
          · obtain ⟨p_mid_l, hp_mid_l⟩ := hPullEx
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) 1)) ≫ iso_top.inv) ℓ 0
            have hml := hPullComp _ _ ℓ 0 (p_top_ev 1) p_top_iso p_mid_l (hp_top_ev 1) hp_top_iso hp_mid_l
            obtain ⟨p_mid_r, hp_mid_r⟩ := hPullEx
              (iso_bot.inv ≫ AlgebraicGeometry.Spec.map (liftAwayHom e)) ℓ 0
            have hmr := hPullComp _ _ ℓ 0 p_bot_iso ψ_e p_mid_r hp_bot_iso hψ_e hp_mid_r
            obtain ⟨p_tot, hp_tot⟩ := hPullEx
              (AlgebraicGeometry.Spec.map (liftAwayHom e₂) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam e₁ e₂) 1)) ≫ iso_top.inv) ℓ 0
            have htot_l := hPullComp _ _ ℓ 0 ψ₂ p_mid_l p_tot hψ₂ hp_mid_l hp_tot
            have hp_tot_r : WeilIsTorsionEtalePullback
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (idempPairFam (ι_E.hom e₁) (ι_E.hom e₂)) 1)) ≫
                  iso_bot.inv ≫ AlgebraicGeometry.Spec.map (liftAwayHom e)) ℓ 0 p_tot :=
              (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ 0 p_tot) hsq1.symm).mpr hp_tot
            have htot_r := hPullComp _ _ ℓ 0 (p_bot_ev 1) p_mid_r p_tot (hp_bot_ev 1) hp_mid_r hp_tot_r
            calc
              p_bot_ev 1 (p_bot_iso (ψ_e x)) = p_bot_ev 1 (p_mid_r x) := by rw [hmr]; rfl
              _ = p_tot x := (congrFun (congrArg DFunLike.coe htot_r) x).symm
              _ = ψ₂ (p_mid_l x) := congrFun (congrArg DFunLike.coe htot_l) x
              _ = ψ₂ (p_top_ev 1 (p_top_iso x)) := by rw [hml]; rfl
        exact (Function.Bijective.of_comp_iff' (hbij_Pbot.comp hbij_bot_iso) ψ_e).mp
          (hcomm_fn.symm ▸ (hbij₁.prodMap hbij₂).comp (hbij_Ptop.comp hbij_top_iso))

  obtain ⟨ψ_one, hψ_one⟩ := hPullEx (AlgebraicGeometry.Spec.map (liftAwayHom (1 : ↑E))) ℓ 0
  have hbij_one : Function.Bijective ψ_one :=
    hPeirce (O_of (1 : ↑E)) (1 : ↑E) rfl (mul_one 1) ψ_one hψ_one
  let eqv_E : ↑E ≃+* Localization.Away (1 : ↑E) :=
    (IsLocalization.atOne ↑E (Localization.Away (1 : ↑E))).toRingEquiv
  have hLoc1_Eloc : IsLocalization.Away (1 : ↑E_loc) (Localization.Away (ι_E.hom 1)) := by
    convert (inferInstance : IsLocalization.Away (ι_E.hom 1) (Localization.Away (ι_E.hom 1)))
    exact (map_one ι_E.hom).symm
  let eqv_Eloc : ↑E_loc ≃+* Localization.Away (ι_E.hom 1) :=
    (@IsLocalization.atOne ↑E_loc _ (Localization.Away (ι_E.hom 1)) _ _ hLoc1_Eloc).toRingEquiv
  let iso_E : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (1 : ↑E))) ≅
      AlgebraicGeometry.Spec E :=
    specIso (A₁ := CommRingCat.of (Localization.Away (1 : ↑E))) (A₂ := E) eqv_E.symm
  let iso_Eloc : AlgebraicGeometry.Spec E_loc ≅
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (ι_E.hom 1))) :=
    specIso (A₁ := E_loc) (A₂ := CommRingCat.of (Localization.Away (ι_E.hom 1))) eqv_Eloc
  have hsq_one : iso_Eloc.hom ≫ AlgebraicGeometry.Spec.map (liftAwayHom (1 : ↑E)) ≫ iso_E.hom =
      AlgebraicGeometry.Spec.map ι_E := by
    dsimp [iso_E, iso_Eloc, specIso]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    ext x
    change eqv_Eloc.symm ((liftAwayHom (1 : ↑E)).hom (eqv_E x)) = ι_E.hom x
    have heqv_E_x : eqv_E x = algebraMap ↑E (Localization.Away (1 : ↑E)) x := rfl
    rw [heqv_E_x, hLiftAwayEq (1 : ↑E) x]
    exact eqv_Eloc.symm_apply_apply (ι_E.hom x)
  obtain ⟨p_isoE, hp_isoE⟩ := hPullEx iso_E.hom ℓ 0
  have hbij_isoE : Function.Bijective p_isoE := hPullIsoBij0 iso_E p_isoE hp_isoE
  obtain ⟨p_isoEloc, hp_isoEloc⟩ := hPullEx iso_Eloc.hom ℓ 0
  have hbij_isoEloc : Function.Bijective p_isoEloc := hPullIsoBij0 iso_Eloc p_isoEloc hp_isoEloc
  obtain ⟨p_mid, hp_mid⟩ := hPullEx
    (AlgebraicGeometry.Spec.map (liftAwayHom (1 : ↑E)) ≫ iso_E.hom) ℓ 0
  have hmid := hPullComp _ _ ℓ 0 ψ_one p_isoE p_mid hψ_one hp_isoE hp_mid
  have hψ_E' : WeilIsTorsionEtalePullback
      (iso_Eloc.hom ≫ AlgebraicGeometry.Spec.map (liftAwayHom (1 : ↑E)) ≫ iso_E.hom) ℓ 0 ψ_E :=
    (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ 0 ψ_E) hsq_one).mpr hψ_E
  have htot := hPullComp _ _ ℓ 0 p_isoEloc p_mid ψ_E hp_isoEloc hp_mid hψ_E'
  rw [htot, hmid]
  exact hbij_isoEloc.comp (hbij_one.comp hbij_isoE)

theorem weil_val_ring_acyclic_filtered_colimit_torsionH (ℓ q : ℕ)
    (𝒥 : Type u) [CategoryTheory.SmallCategory 𝒥] [CategoryTheory.IsFiltered 𝒥]
    (B : 𝒥 ⥤ CommRingCat.{u})
    (c : CategoryTheory.Limits.Cocone B) (hc : CategoryTheory.Limits.IsColimit c) :
    (∀ (ξ_inf : weilEtaleTorsionH (AlgebraicGeometry.Spec c.pt) ℓ q),
      ∃ (j : 𝒥) (ξ_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q),
        ∀ (p_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q →+
            weilEtaleTorsionH (AlgebraicGeometry.Spec c.pt) ℓ q),
          WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (c.ι.app j)) ℓ q p_j →
          p_j ξ_j = ξ_inf) ∧
    (∀ (j : 𝒥) (ξ_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q)
      (p_j : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q →+
        weilEtaleTorsionH (AlgebraicGeometry.Spec c.pt) ℓ q),
      WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (c.ι.app j)) ℓ q p_j →
      p_j ξ_j = 0 →
      ∃ (j' : 𝒥) (φ : j ⟶ j'),
        ∀ (p_φ : weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j)) ℓ q →+
            weilEtaleTorsionH (AlgebraicGeometry.Spec (B.obj j')) ℓ q),
          WeilIsTorsionEtalePullback (AlgebraicGeometry.Spec.map (B.map φ)) ℓ q p_φ →
          p_φ ξ_j = 0) :=
by
  classical
  obtain ⟨hPullEx, hPullId, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hPullUniq : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂) (m i : ℕ)
      (p₁ p₂ : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i),
      WeilIsTorsionEtalePullback h m i p₁ →
      WeilIsTorsionEtalePullback h m i p₂ →
      p₁ = p₂ := by
    intro S₁ S₂ h m i p₁ p₂ hp₁ hp₂
    obtain ⟨p_id, hp_id⟩ := hPullEx (𝟙 S₁) m i
    have hp_id' : WeilIsTorsionEtalePullback (𝟙 S₁) m i (AddMonoidHom.id _) :=
      hPullId m i p_id hp_id ▸ hp_id
    have hp₂' : WeilIsTorsionEtalePullback (𝟙 S₁ ≫ h) m i p₂ :=
      (CategoryTheory.Category.id_comp h).symm ▸ hp₂
    exact ((hPullComp (𝟙 S₁) h m i (AddMonoidHom.id _) p₁ p₂ hp_id' hp₁ hp₂').trans
      (AddMonoidHom.id_comp p₁)).symm
  obtain ⟨hc_all, hr_all, hSite⟩ :=
    weil_etale_site_pullback_rightAdjoint_and_exact_package.{u}
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  have hAffq : WeilAffineFilteredRingColimitAtDegreeHolds.{u} (@hc_all) (@hr_all) q :=
    weil_affine_filtered_ring_colimit_all_degrees_of_deg_zero.{u} (@hc_all) (@hr_all) hSite
      weil_filtered_colimit_etale_presentation_and_cover_descent.{u}
      (weil_affine_filtered_ring_colimit_degree_zero.{u} (@hc_all) (@hr_all) hSite
        weil_filtered_colimit_etale_presentation_and_cover_descent.{u}) q

  have hAbsConstEqIso : ∀ {C₁ C₂ : Type (u + 1)}
      [CategoryTheory.Category.{u, u + 1} C₁]
      [CategoryTheory.Category.{u, u + 1} C₂]
      (J₁ : CategoryTheory.GrothendieckTopology C₁)
      (J₂ : CategoryTheory.GrothendieckTopology C₂)
      [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
      [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
      (B_h : CategoryTheory.Functor C₂ C₁)
      [B_h.IsContinuous J₂ J₁]
      [(B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint]
      (T₁ : C₁) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : C₂) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let pb_h := B_h.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let P₁ := (CategoryTheory.Functor.const (Opposite C₁)).obj A
      let P₂ := (CategoryTheory.Functor.const (Opposite C₂)).obj A
      let F₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj A
      let F₂ := (CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}).obj A
      let adj_sh₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
      let adj_sh₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
      let adj_c₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj_c₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : B_h.obj T₂ ⟶ T₁ := hT₁.from (B_h.obj T₂)
      let c_A : pb_h.obj F₂ ⟶ F₁ :=
        (adj_h.homEquiv F₂ F₁).symm
          ((adj_sh₂.homEquiv P₂ (pf_h.obj F₁)).symm
            (CategoryTheory.Functor.whiskerLeft B_h.op (adj_sh₁.unit.app P₁)))
      let π_A : pb_h.obj F₂ ⟶ F₁ :=
        (adj_h.homEquiv F₂ F₁).symm
          ((adj_c₂.homEquiv A (pf_h.obj F₁)).symm
            (adj_c₁.unit.app A ≫ F₁.obj.map τ.op))
      c_A = π_A ∧ (CategoryTheory.IsIso τ → CategoryTheory.IsIso c_A) := by
    intro C₁ C₂ _ _ J₁ J₂ _ _ B_h _ _ T₁ hT₁ T₂ hT₂ A
    dsimp only
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let pb_h := B_h.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let P₁ := (CategoryTheory.Functor.const (Opposite C₁)).obj A
    let P₂ := (CategoryTheory.Functor.const (Opposite C₂)).obj A
    let F₁ := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj A
    let F₂ := (CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}).obj A
    let adj_sh₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let adj_c₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj_c₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
