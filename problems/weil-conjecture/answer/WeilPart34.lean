          let Z_emp_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk f'_emp
          let f_ov : P_δ ⟶ P_succ_ov := CategoryTheory.Over.homMk i_tilde hi_hom
          let g_ov : S_k_ov ⟶ P_succ_ov := CategoryTheory.Over.homMk z_bar hz_bar
          let f'_ov : Z_emp_ov ⟶ S_k_ov :=
            CategoryTheory.Over.homMk f'_emp (CategoryTheory.Category.comp_id _)
