                      (AddCommGrpCat.ofHom (DFinsupp.singleAddHom
                        (fun α : Quiver.Hom (M_gU.obj W₀.unop) V =>
                          ↥(P.obj (Opposite.op (sliceObj (M_gU.obj W₀.unop) α))))
                        (α_of W₀.unop)))
                  naturality := fun {U₁ U₂} g => by
                    apply AddCommGrpCat.ext
                    intro y
                    dsimp [R_pre, j_pre_bang, j_pre_bang_obj]
                    simp only [DFinsupp.liftAddHom_apply_single, AddMonoidHom.comp_apply,
                      DFinsupp.singleAddHom_apply]
                    have hg_α : CategoryTheory.CategoryStruct.comp (M_gU.map g.unop) (α_of U₁.unop) =
                        α_of U₂.unop :=
                      CategoryTheory.MorphismProperty.Comma.Hom.ext
                        (CategoryTheory.MorphismProperty.Over.w g.unop) (Subsingleton.elim _ _)
                    have h_comm : CategoryTheory.CategoryStruct.comp (e_of U₂.unop) g.unop =
                        CategoryTheory.CategoryStruct.comp (eqSliceHom hg_α)
                          (CategoryTheory.CategoryStruct.comp (slicePre (M_gU.map g.unop) (α_of U₁.unop))
                            (e_of U₁.unop)) :=
                      CategoryTheory.MorphismProperty.Comma.Hom.ext
                        ((CategoryTheory.Category.id_comp _).trans
                          ((CategoryTheory.Category.comp_id _).symm.trans
                            (CategoryTheory.Category.id_comp _).symm))
                        (Subsingleton.elim _ _)
                    have hmap_eq : (P.map (e_of U₂.unop).op).hom ((P.map g).hom y) =
                        (P.map (eqSliceHom hg_α).op).hom
                          ((P.map (slicePre (M_gU.map g.unop) (α_of U₁.unop)).op).hom
                            ((P.map (e_of U₁.unop).op).hom y)) := by
                      have h1 := congrArg (fun k => (P.map k.op).hom y) h_comm
                      simpa only [CategoryTheory.op_comp, P.map_comp, AddCommGrpCat.hom_comp,
                        AddMonoidHom.comp_apply, Quiver.Hom.op_unop] using h1
                    rw [hmap_eq]
                    exact hSingleEq P hg_α _ }
              naturality := fun {P₁ P₂} φ => by
                ext W₀ : 2
                apply AddCommGrpCat.ext
                intro y
                dsimp [R_pre, j_pre_bang, j_pre_bang_obj]
                simp only [DFinsupp.singleAddHom_apply, DFinsupp.mapRange.addMonoidHom_apply,
                  DFinsupp.mapRange_single]
                have hnat := congrArg (fun m => m.hom y) (φ.naturality (e_of W₀.unop).op)
                have hnat' : (P₂.map (e_of W₀.unop).op).hom ((φ.app W₀).hom y) =
                    (φ.app (Opposite.op (sliceObj (M_gU.obj W₀.unop) (α_of W₀.unop)))).hom
                      ((P₁.map (e_of W₀.unop).op).hom y) := by
                  simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, Opposite.op_unop] using hnat.symm
                exact congrArg
                  (DFinsupp.single (β := fun γ : Quiver.Hom (M_gU.obj W₀.unop) V =>
                    ↥(P₂.obj (Opposite.op (sliceObj (M_gU.obj W₀.unop) γ))))
                    (α_of W₀.unop))
                  hnat' }
          counit :=
            { app := fun Q =>
                { app := fun W => AddCommGrpCat.ofHom
                    (DFinsupp.liftAddHom fun α : Quiver.Hom W.unop V =>
                      (Q.map (θ_of W.unop α).op).hom)
                  naturality := fun {W₁ W₂} f => by
                    apply CategoryTheory.ConcreteCategory.hom_ext
                    refine DFunLike.congr_fun (DFinsupp.addHom_ext' fun α₁ => AddMonoidHom.ext fun y => ?_)
                    dsimp [R_pre, j_pre_bang, j_pre_bang_obj]
                    simp only [AddMonoidHom.comp_apply,
                      DFinsupp.singleAddHom_apply, DFinsupp.liftAddHom_apply_single]
                    have hθ : CategoryTheory.CategoryStruct.comp
                        (θ_of W₂.unop (CategoryTheory.CategoryStruct.comp f.unop α₁))
                        (M_gU.map (slicePre f.unop α₁)) =
                        CategoryTheory.CategoryStruct.comp f.unop (θ_of W₁.unop α₁) :=
                      CategoryTheory.MorphismProperty.Comma.Hom.ext
                        ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.comp_id _).symm)
                        (Subsingleton.elim _ _)
                    have h1 := congrArg (fun k => (Q.map k.op).hom y) hθ
                    simpa only [CategoryTheory.op_comp, Q.map_comp, AddCommGrpCat.hom_comp,
                      AddMonoidHom.comp_apply, Quiver.Hom.op_unop] using h1 }
              naturality := fun {Q₁ Q₂} ψ => by
                ext W : 2
                apply CategoryTheory.ConcreteCategory.hom_ext
                refine DFunLike.congr_fun (DFinsupp.addHom_ext' fun α => AddMonoidHom.ext fun y => ?_)
                dsimp [R_pre, j_pre_bang, j_pre_bang_obj]
