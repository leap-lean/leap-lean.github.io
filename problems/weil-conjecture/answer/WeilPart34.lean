                (shAdj_Y'.homEquiv (j_pre_bang.obj (ι_U.obj ℱ)) 𝒢).symm
                  ((adj_pre.homEquiv (ι_U.obj ℱ) (ι_Y'.obj 𝒢)).symm g')
            rw [adj_pre.homEquiv_naturality_left_symm (ι_U.map u) g',
