        have hspec : AlgebraicGeometry.Spec.map (β₁_cat ≫ γ_cat) =
            AlgebraicGeometry.Spec.map α₁_cat := by
          rw [AlgebraicGeometry.Spec.map_comp, hγ_map,
            AlgebraicGeometry.Spec.map_preimage e_X_inv_pr₁]
          change (Φ ≫ e_X.hom) ≫ (e_X.inv ≫ pr₁) = p₁_succ
          rw [Category.assoc, ← Category.assoc e_X.hom, e_X.hom_inv_id, Category.id_comp]
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _
        exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hspec)
      have hγ_β₂ : γ.comp β₂ = α₂ := by
        have hspec : AlgebraicGeometry.Spec.map (β₂_cat ≫ γ_cat) =
            AlgebraicGeometry.Spec.map α₂_cat := by
          rw [AlgebraicGeometry.Spec.map_comp, hγ_map,
            AlgebraicGeometry.Spec.map_preimage e_X_inv_pr₂]
          change (Φ ≫ e_X.hom) ≫ (e_X.inv ≫ pr₂) = p₂_succ
          rw [Category.assoc, ← Category.assoc e_X.hom, e_X.hom_inv_id, Category.id_comp]
          exact CategoryTheory.Limits.pullback.lift_snd _ _ _
        exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hspec)
      have hβ_γ_cat : β_cat ≫ γ_cat = 𝟙 (CommRingCat.of R_succ) := by
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext'
        · refine RingHom.ext fun c => ?_
          change γ (β (MvPolynomial.C c)) = MvPolynomial.C c
          rw [hβ_C_apply]
          have hc := RingHom.congr_fun hγ_β₁ (MvPolynomial.C c)
          change γ (β₁ (MvPolynomial.C c)) =
            (MvPolynomial.rename (R := k) Fin.castSucc) (MvPolynomial.C c) at hc
          rw [hc, MvPolynomial.rename_C]
        · intro j
          refine Fin.lastCases ?_ ?_ j
          · change γ (β (MvPolynomial.X (Fin.last δ))) = MvPolynomial.X (Fin.last δ)
            rw [hβ_X_apply]
            dsimp [v_snoc]
            rw [Fin.snoc_last]
            have hj := RingHom.congr_fun hγ_β₂ (MvPolynomial.X 0)
            change γ (β₂ (MvPolynomial.X 0)) =
              (MvPolynomial.rename (R := k) (fun _ : Fin 1 => Fin.last δ)) (MvPolynomial.X 0) at hj
            rw [hj, MvPolynomial.rename_X]
          · intro i
            change γ (β (MvPolynomial.X i.castSucc)) = MvPolynomial.X i.castSucc
            rw [hβ_X_apply]
            dsimp [v_snoc]
            rw [Fin.snoc_castSucc]
            have hi := RingHom.congr_fun hγ_β₁ (MvPolynomial.X i)
            change γ (β₁ (MvPolynomial.X i)) =
              (MvPolynomial.rename (R := k) Fin.castSucc) (MvPolynomial.X i) at hi
            rw [hi, MvPolynomial.rename_X]
      dsimp [Ψ, Spec_succ]
      rw [← Category.assoc, ← hγ_map, ← AlgebraicGeometry.Spec.map_comp, hβ_γ_cat]
      exact AlgebraicGeometry.Spec.map_id (CommRingCat.of R_succ)
    have _ : CategoryTheory.IsIso Ψ := ⟨⟨Φ, hΨ_Φ, hΦ_Ψ⟩⟩
    have hEt_snd : AlgebraicGeometry.Etale q_W' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback u pr₁) inferInstance
    let B_W' : Type u := ↑Γ(W', ⊤)
    let Γ_W' : CommRingCat.{u} := CommRingCat.of B_W'
    let e_W' : W' ≅ AlgebraicGeometry.Spec Γ_W' := W'.isoSpec
    let h_spec : AlgebraicGeometry.Spec Γ_W' ⟶ Spec_succ :=
      e_W'.inv ≫ q_W' ≫ Ψ
    have hEt_spec : AlgebraicGeometry.Etale h_spec :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        e_W'.inv (q_W' ≫ Ψ) inferInstance
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          q_W' Ψ hEt_snd inferInstance)
    let θ_hom : CommRingCat.of R_succ ⟶ Γ_W' := AlgebraicGeometry.Spec.preimage h_spec
    have hSpec_θ : AlgebraicGeometry.Spec.map θ_hom = h_spec :=
      AlgebraicGeometry.Spec.map_preimage h_spec
    have hEt_θ : θ_hom.hom.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (hSpec_θ.symm ▸ hEt_spec)
    let _ : Algebra R_succ B_W' := θ_hom.hom.toAlgebra
    have _ : Algebra.Etale R_succ B_W' := RingHom.etale_algebraMap.mp hEt_θ
    have hStrict : StrictMono (PrimeSpectrum.comap (algebraMap R_succ B_W')) := by
      intro q₁ q₂ hlt
      have hle : PrimeSpectrum.comap (algebraMap R_succ B_W') q₁ ≤
          PrimeSpectrum.comap (algebraMap R_succ B_W') q₂ :=
        fun _ hr => hlt.le hr
      refine lt_of_le_of_ne hle ?_
      intro heq
      let p := PrimeSpectrum.comap (algebraMap R_succ B_W') q₂
      let q₁_fib : ↑(PrimeSpectrum.comap (algebraMap R_succ B_W') ⁻¹' {p}) := ⟨q₁, heq⟩
      let q₂_fib : ↑(PrimeSpectrum.comap (algebraMap R_succ B_W') ⁻¹' {p}) := ⟨q₂, rfl⟩
      have hlt_fib : q₁_fib < q₂_fib := hlt
      let e_fib := PrimeSpectrum.preimageOrderIsoFiber R_succ B_W' p
      have hlt_img : e_fib q₁_fib < e_fib q₂_fib := e_fib.strictMono hlt_fib
      let K_p := p.asIdeal.ResidueField
      let F_p := p.asIdeal.Fiber B_W'
      obtain ⟨I, _, L, hFieldL, _, Θ, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K_p F_p).mp inferInstance
      let _ : ∀ i, Field (L i) := hFieldL
      have hnot_le : ¬ (e_fib q₂_fib).asIdeal ≤ (e_fib q₁_fib).asIdeal := hlt_img.not_ge
      rw [SetLike.not_le_iff_exists] at hnot_le
      obtain ⟨x, hx₂, hx₁⟩ := hnot_le
      let y_pi : ∀ i : I, L i := fun i => (Θ x i)⁻¹
      let e_pi : ∀ i : I, L i := fun i => if Θ x i = 0 then 1 else 0
      have hex0 : Θ.symm e_pi * x = 0 := by
        apply Θ.injective
        rw [map_mul, Θ.apply_symm_apply, map_zero]
        ext i
        dsimp [e_pi]
        split_ifs with h0
        · simp [h0]
        · simp
      have hyx1 : Θ.symm y_pi * x + Θ.symm e_pi = 1 := by
        apply Θ.injective
        rw [map_add, map_mul, Θ.apply_symm_apply, Θ.apply_symm_apply, map_one]
        ext i
        dsimp [y_pi, e_pi]
        split_ifs with h0
        · simp [h0]
        · simp [inv_mul_cancel₀ h0]
      have he_mem₁ : Θ.symm e_pi ∈ (e_fib q₁_fib).asIdeal := by
        have hmul_mem : Θ.symm e_pi * x ∈ (e_fib q₁_fib).asIdeal := by
          rw [hex0]; exact (e_fib q₁_fib).asIdeal.zero_mem
        exact ((e_fib q₁_fib).isPrime.mem_or_mem hmul_mem).resolve_right hx₁
      have he_mem₂ : Θ.symm e_pi ∈ (e_fib q₂_fib).asIdeal := hlt_img.le he_mem₁
      have h1_mem₂ : (1 : F_p) ∈ (e_fib q₂_fib).asIdeal := by
        rw [← hyx1]
        exact (e_fib q₂_fib).asIdeal.add_mem ((e_fib q₂_fib).asIdeal.mul_mem_left _ hx₂) he_mem₂
      exact (e_fib q₂_fib).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem₂)
    have hDim_le : ringKrullDim B_W' ≤ ringKrullDim R_succ :=
      Order.krullDim_le_of_strictMono _ hStrict
    have hDim_R : ringKrullDim R_succ = ((δ + 1 : ℕ) : WithBot ℕ∞) := by
      dsimp [R_succ]
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    have hHomeo : topologicalKrullDim W' = topologicalKrullDim ↥(AlgebraicGeometry.Spec Γ_W') :=
      IsHomeomorph.topologicalKrullDim_eq _
        (AlgebraicGeometry.Scheme.Hom.homeomorph e_W'.hom).isHomeomorph
    have hSpec_dim : topologicalKrullDim ↥(AlgebraicGeometry.Spec Γ_W') = ringKrullDim B_W' :=
      PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim B_W'
    have hDim_W' : topologicalKrullDim W' ≤ ((δ + 1 : ℕ) : WithBot ℕ∞) := by
      rw [hHomeo, hSpec_dim, ← hDim_R]
      exact hDim_le
    let W'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk f_W'
    have _ : AlgebraicGeometry.IsAffine W'_ov.left := hAff_W'
    have _ : AlgebraicGeometry.LocallyOfFiniteType W'_ov.hom := hLFT_fW'
    have hSub_high : Subsingleton (weilEtaleTorsionH W' ℓ m) :=
      weil_affine_etale_cohomological_dimension k (δ + 1) ℓ m
        (Nat.Prime.pos Fact.out) (IsUnit.mk0 (ℓ : k) hℓ) W'_ov hDim_W' hm_gt
    intro y
    exact ⟨0, hSub_high.elim (p_W_star 0) y⟩

theorem weil_codim1_purity_projLine_reciprocal_atlas_over_affineSpace (k : Type u) [Field k] (δ : ℕ) :
    let S_δ := weilAffineSpaceOver k δ
    let P1_k := weilProjectiveSpaceOver k 1
    let A1_k := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))
    let Gm_k := AlgebraicGeometry.Spec
      (CommRingCat.of (Localization.Away (Polynomial.X : Polynomial k)))
    let j_Gm : Gm_k ⟶ A1_k := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k))))
    let p_A1 : A1_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
    let Y_δ := CategoryTheory.Limits.pullback S_δ.hom p_A1
    let U_δ := CategoryTheory.Limits.pullback j_Gm
      (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
    let j_δ : U_δ ⟶ Y_δ :=
      CategoryTheory.Limits.pullback.snd j_Gm
        (CategoryTheory.Limits.pullback.snd S_δ.hom p_A1)
    let P_δ := CategoryTheory.Limits.pullback S_δ.hom P1_k.hom
    let π_δ : P_δ ⟶ S_δ.left := CategoryTheory.Limits.pullback.fst S_δ.hom P1_k.hom
    ∃ (ι₀_δ ι_inf_δ : Y_δ ⟶ P_δ)
      (s₀_δ : S_δ.left ⟶ Y_δ)
      (i₀_δ : S_δ.left ⟶ P_δ)
      (g_U : U_δ ⟶ Y_δ)
      (e_A1 : Y_δ ≅ CategoryTheory.Limits.pullback S_δ.hom (weilAffineSpaceOver k 1).hom),
      (AlgebraicGeometry.IsOpenImmersion ι₀_δ ∧
        AlgebraicGeometry.IsOpenImmersion ι_inf_δ ∧
        AlgebraicGeometry.IsOpenImmersion g_U ∧
        AlgebraicGeometry.IsClosedImmersion s₀_δ ∧
        AlgebraicGeometry.IsClosedImmersion i₀_δ) ∧
      (ι₀_δ ≫ π_δ = CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ∧
        ι_inf_δ ≫ π_δ = CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 ∧
        s₀_δ ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 = 𝟙 S_δ.left ∧
        i₀_δ = s₀_δ ≫ ι₀_δ ∧
        i₀_δ ≫ π_δ = 𝟙 S_δ.left) ∧
      (Set.range ι₀_δ.base ∪ Set.range ι_inf_δ.base = Set.univ ∧
        Disjoint (Set.range i₀_δ.base) (Set.range ι_inf_δ.base) ∧
        CategoryTheory.IsPullback j_δ g_U ι₀_δ ι_inf_δ) ∧
      ((∀ (Ω : Type u) [Field Ω]
          (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y_δ),
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
            z_bar.base pt ∉ Set.range j_δ.base) →
          z_bar = (z_bar ≫ CategoryTheory.Limits.pullback.fst S_δ.hom p_A1) ≫ s₀_δ) ∧
        (∀ (Ω : Type u) [Field Ω]
          (x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P_δ),
          (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
            x_bar.base pt ∉ Set.range ι_inf_δ.base) →
          x_bar = (x_bar ≫ π_δ) ≫ i₀_δ)) ∧
      e_A1.hom ≫ CategoryTheory.Limits.pullback.fst S_δ.hom (weilAffineSpaceOver k 1).hom =
        CategoryTheory.Limits.pullback.fst S_δ.hom p_A1 :=
by
  classical
  intro S_δ P1_k A1_k Gm_k j_Gm p_A1 Y_δ U_δ j_δ P_δ π_δ
  let Sk := AlgebraicGeometry.Spec (CommRingCat.of k)

  
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  let φ₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
  have hφ₀_bij : Function.Bijective φ₀ := by
    refine ⟨?_, ?_⟩
    · intro c₁ c₂ hc
      apply MvPolynomial.C_injective (σ := Fin (1 + 1)) (R := k)
      exact congrArg Subtype.val hc
    · intro y
      have hy : (y : MvPolynomial (Fin (1 + 1)) k) ∈
          (1 : Submodule k (MvPolynomial (Fin (1 + 1)) k)) := by
        simpa only [𝒜, MvPolynomial.homogeneousSubmodule_zero] using y.2
      rw [Submodule.mem_one] at hy
      obtain ⟨c, hc⟩ := hy
      exact ⟨c, Subtype.ext hc⟩
  let e₀_zero : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective φ₀ hφ₀_bij
  have : CategoryTheory.IsIso (CommRingCat.ofHom φ₀) :=
    ⟨⟨CommRingCat.ofHom e₀_zero.symm.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun c => e₀_zero.symm_apply_apply c),
      CommRingCat.hom_ext (RingHom.ext fun y => e₀_zero.apply_symm_apply y)⟩⟩
  have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) :=
    inferInstance
  have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
    IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0))
      (A := MvPolynomial (Fin (1 + 1)) k) fun _ => rfl
  have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k)
  have hProp_P1 : AlgebraicGeometry.IsProper P1_k.hom := by
    dsimp [P1_k, weilProjectiveSpaceOver]
    infer_instance
  have : AlgebraicGeometry.IsProper P1_k.hom := hProp_P1
  have : AlgebraicGeometry.IsSeparated P1_k.hom := inferInstance
  have : AlgebraicGeometry.IsSeparated π_δ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback S_δ.hom P1_k.hom).flip inferInstance

  
  have hX_mem : ∀ i : Fin (1 + 1), (MvPolynomial.X i : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 1 :=
    fun i => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i)

  have hCoordEquiv : ∀ (i j : Fin (1 + 1)), i ≠ j →
      ∃ (e : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i)),
        e.toRingHom.comp Polynomial.C =
          (HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X i))).comp φ₀ ∧
        e Polynomial.X =
          HomogeneousLocalization.Away.isLocalizationElem (hX_mem i) (hX_mem j) ∧
        ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • 1)),
          e.symm (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF) =
            MvPolynomial.aeval
              (fun l : Fin (1 + 1) => if l = i then (1 : Polynomial k) else Polynomial.X) F := by
    intro i j hij
    let Xi : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X i
    let Xj : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X j
    let Ri := HomogeneousLocalization.Away 𝒜 Xi
    let κ_i : k →+* Ri :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi)).comp φ₀
    let t_i : Ri := HomogeneousLocalization.Away.isLocalizationElem (hX_mem i) (hX_mem j)
    let ψ_i : Polynomial k →+* Ri := Polynomial.eval₂RingHom κ_i t_i
    let ev_i_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] Polynomial k :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = i then (1 : Polynomial k) else Polynomial.X)
    let ev_i : MvPolynomial (Fin (1 + 1)) k →+* Polynomial k := ev_i_alg.toRingHom
    have hev_Xi_eq : ev_i Xi = 1 := by
      change ev_i_alg (MvPolynomial.X i) = 1
      dsimp [ev_i_alg]
      rw [MvPolynomial.aeval_X]
      simp
    have hev_Xi : IsUnit (ev_i Xi) := by
      rw [hev_Xi_eq]
      exact isUnit_one
    let ev_i_loc : Localization.Away Xi →+* Polynomial k :=
      IsLocalization.Away.lift Xi hev_Xi
    let ι_loc : MvPolynomial (Fin (1 + 1)) k →+* Localization.Away Xi :=
      algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away Xi)
    let val_hom : Ri →+* Localization.Away Xi := algebraMap Ri (Localization.Away Xi)
    let φ_i : Ri →+* Polynomial k := ev_i_loc.comp val_hom
    have h_val_apply : ∀ z : Ri, val_hom z = z.val :=
      fun z => HomogeneousLocalization.algebraMap_apply z
    have h_val_zero : ∀ a : ↥(𝒜 0),
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi) a).val =
          ι_loc (a : MvPolynomial (Fin (1 + 1)) k) := by
      intro a
      change Localization.mk (a : MvPolynomial (Fin (1 + 1)) k) 1 =
        ι_loc (a : MvPolynomial (Fin (1 + 1)) k)
      exact Localization.mk_one_eq_algebraMap (a : MvPolynomial (Fin (1 + 1)) k)
    have h_mk_eval : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • 1)),
        φ_i (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF) = ev_i F := by
      intro m F hF
      have hz_val : (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val *
          ι_loc (Xi ^ m) = ι_loc F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers Xi)
          (Localization.Away Xi) F ⟨Xi ^ m, ⟨m, rfl⟩⟩
      have h_mul := congrArg ev_i_loc hz_val
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
        map_pow, hev_Xi_eq, one_pow, mul_one] at h_mul
      change ev_i_loc (val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF)) = ev_i F
      rw [h_val_apply]
      exact h_mul
    have h_ti_eq_mk : t_i = HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) 1 (Xj ^ 1)
        (by simpa using hX_mem j) := rfl
    have h_left : φ_i.comp ψ_i = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext
      · intro c
        change φ_i (Polynomial.eval₂ κ_i t_i (Polynomial.C c)) = Polynomial.C c
        rw [Polynomial.eval₂_C]
        change ev_i_loc (val_hom (κ_i c)) = Polynomial.C c
        rw [h_val_apply]
        change ev_i_loc ((HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers Xi) (φ₀ c)).val) = Polynomial.C c
        rw [h_val_zero]
        change ev_i_loc (ι_loc (algebraMap k (MvPolynomial (Fin (1 + 1)) k) c)) = Polynomial.C c
        rw [IsLocalization.Away.lift_eq]
        exact ev_i_alg.commutes c
      · change φ_i (Polynomial.eval₂ κ_i t_i Polynomial.X) = Polynomial.X
        rw [Polynomial.eval₂_X, h_ti_eq_mk, h_mk_eval]
        change ev_i_alg (Xj ^ 1) = Polynomial.X
        rw [pow_one]
        dsimp [ev_i_alg, Xj]
        rw [MvPolynomial.aeval_X]
        simp [hij.symm]
    have h_right : ∀ z : Ri, ψ_i (φ_i z) = z := by
      intro z
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem i) z
      rw [h_mk_eval m F hF, HomogeneousLocalization.ext_iff_val]
      let θ_i : MvPolynomial (Fin (1 + 1)) k →+* Localization.Away Xi :=
        val_hom.comp (ψ_i.comp ev_i)
      have hθ_C : ∀ c : k, θ_i (MvPolynomial.C c) = ι_loc (MvPolynomial.C c) := by
        intro c
        change val_hom (ψ_i (ev_i_alg (MvPolynomial.C c))) = ι_loc (MvPolynomial.C c)
        rw [MvPolynomial.aeval_C]
        change val_hom (Polynomial.eval₂ κ_i t_i (Polynomial.C c)) = ι_loc (MvPolynomial.C c)
        rw [Polynomial.eval₂_C, h_val_apply]
        exact h_val_zero (φ₀ c)
      have hθ_X : ∀ l : Fin (1 + 1),
          θ_i (MvPolynomial.X l) * ι_loc Xi = ι_loc (MvPolynomial.X l) := by
        intro l
        by_cases hli : l = i
        · subst hli
          change val_hom (ψ_i (ev_i_alg (MvPolynomial.X l))) * ι_loc (MvPolynomial.X l) = _
          have hev_l : ev_i_alg (MvPolynomial.X l) = 1 := by
            dsimp [ev_i_alg]
            rw [MvPolynomial.aeval_X]
            simp
          rw [hev_l, map_one, map_one, one_mul]
        · have hlj : l = j := by
            fin_cases i <;> fin_cases j <;> fin_cases l <;> simp_all
          subst hlj
          change val_hom (ψ_i (ev_i_alg (MvPolynomial.X l))) * ι_loc Xi = ι_loc (MvPolynomial.X l)
          have hev_l : ev_i_alg (MvPolynomial.X l) = Polynomial.X := by
            dsimp [ev_i_alg]
            rw [MvPolynomial.aeval_X]
            simp [hli]
          rw [hev_l]
          change val_hom (Polynomial.eval₂ κ_i t_i Polynomial.X) * ι_loc Xi =
            ι_loc (MvPolynomial.X l)
          rw [Polynomial.eval₂_X, h_val_apply, h_ti_eq_mk,
            HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
          have hspec := IsLocalization.mk'_spec' (M := Submonoid.powers Xi)
            (Localization.Away Xi) (MvPolynomial.X l ^ 1) ⟨Xi ^ 1, ⟨1, rfl⟩⟩
          simpa only [pow_one] using hspec
      have hθ_X_pow : ∀ (l : Fin (1 + 1)) (e : ℕ),
          θ_i (MvPolynomial.X l ^ e) * ι_loc Xi ^ e = ι_loc (MvPolynomial.X l ^ e) := by
        intro l e
        rw [map_pow, map_pow, ← mul_pow, hθ_X l]
      have hF_hom : F.IsHomogeneous m := by
        have hF' : F ∈ 𝒜 m := by simpa using hF
        exact (MvPolynomial.mem_homogeneousSubmodule m F).mp hF'
      have hθ_F : θ_i F * ι_loc (Xi ^ m) = ι_loc F := by
        conv_lhs => rw [MvPolynomial.as_sum F]
        conv_rhs => rw [MvPolynomial.as_sum F]
        rw [map_sum, Finset.sum_mul, map_sum]
        apply Finset.sum_congr rfl
        intro s hs
        have hs_deg : s 0 + s 1 = m := by
          have hw := hF_hom (MvPolynomial.mem_support_iff.mp hs)
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hw
        rw [MvPolynomial.monomial_eq, Finsupp.prod_pow, Fin.prod_univ_two]
        generalize F.coeff s = cs
        simp only [map_mul, map_pow]
        calc
          (θ_i (MvPolynomial.C cs) *
              (θ_i (MvPolynomial.X 0) ^ s 0 * θ_i (MvPolynomial.X 1) ^ s 1)) *
              ι_loc Xi ^ m
            = θ_i (MvPolynomial.C cs) *
                ((θ_i (MvPolynomial.X 0) ^ s 0 * ι_loc Xi ^ s 0) *
                 (θ_i (MvPolynomial.X 1) ^ s 1 * ι_loc Xi ^ s 1)) := by
                rw [← hs_deg, pow_add]; ring
          _ = ι_loc (MvPolynomial.C cs) *
                (ι_loc (MvPolynomial.X 0) ^ s 0 * ι_loc (MvPolynomial.X 1) ^ s 1) := by
                rw [hθ_C]
                have h0 := hθ_X_pow 0 (s 0)
                have h1 := hθ_X_pow 1 (s 1)
                simp only [map_pow] at h0 h1
                rw [h0, h1]
      have hz_val : (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val *
          ι_loc (Xi ^ m) = ι_loc F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers Xi)
          (Localization.Away Xi) F ⟨Xi ^ m, ⟨m, rfl⟩⟩
      have hUnit_pow : IsUnit (ι_loc (Xi ^ m)) :=
        IsLocalization.map_units (M := Submonoid.powers Xi)
          (Localization.Away Xi) ⟨Xi ^ m, ⟨m, rfl⟩⟩
      have h_eq_val : θ_i F = (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val :=
        hUnit_pow.mul_right_cancel (hθ_F.trans hz_val.symm)
      change (ψ_i (ev_i F)).val = (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF).val
      rw [← h_val_apply]
      exact h_eq_val
    let e_i : Polynomial k ≃+* Ri :=
      RingEquiv.ofRingHom ψ_i φ_i (RingHom.ext h_right) h_left
    refine ⟨e_i, ?_, ?_, ?_⟩
    · apply RingHom.ext
      intro c
      change Polynomial.eval₂ κ_i t_i (Polynomial.C c) = κ_i c
      exact Polynomial.eval₂_C _ _
    · change Polynomial.eval₂ κ_i t_i Polynomial.X = t_i
      exact Polynomial.eval₂_X _ _
    · intro m F hF
      exact h_mk_eval m F hF

  have h10 : (1 : Fin (1 + 1)) ≠ 0 := by decide
  have h01 : (0 : Fin (1 + 1)) ≠ 1 := by decide
  obtain ⟨e₁, he₁_C, he₁_X, he₁_symm⟩ := hCoordEquiv 1 0 h10
  obtain ⟨e₀, he₀_C, he₀_X, he₀_symm⟩ := hCoordEquiv 0 1 h01

  let away₀ := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one
  let away₁ := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one
  let spec_e₀ : A1_k ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)
  let spec_e₁ : A1_k ⟶ AlgebraicGeometry.Spec
      (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)
  let chart₀ : A1_k ⟶ P1_k.left := spec_e₀ ≫ away₀
  let chart_inf : A1_k ⟶ P1_k.left := spec_e₁ ≫ away₁

  have : CategoryTheory.IsIso (CommRingCat.ofHom e₀.symm.toRingHom) :=
    ⟨⟨CommRingCat.ofHom e₀.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun x => e₀.apply_symm_apply x),
      CommRingCat.hom_ext (RingHom.ext fun x => e₀.symm_apply_apply x)⟩⟩
  have : CategoryTheory.IsIso (CommRingCat.ofHom e₁.symm.toRingHom) :=
    ⟨⟨CommRingCat.ofHom e₁.toRingHom,
      CommRingCat.hom_ext (RingHom.ext fun x => e₁.apply_symm_apply x),
      CommRingCat.hom_ext (RingHom.ext fun x => e₁.symm_apply_apply x)⟩⟩
  have : CategoryTheory.IsIso spec_e₀ := inferInstance
  have : CategoryTheory.IsIso spec_e₁ := inferInstance
  have hOpen_chart₀ : AlgebraicGeometry.IsOpenImmersion chart₀ := by
    change AlgebraicGeometry.IsOpenImmersion
      (spec_e₀ ≫ AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one)
    infer_instance
  have hOpen_chart_inf : AlgebraicGeometry.IsOpenImmersion chart_inf := by
    change AlgebraicGeometry.IsOpenImmersion
      (spec_e₁ ≫ AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one)
    infer_instance
  have : AlgebraicGeometry.IsOpenImmersion chart₀ := hOpen_chart₀
  have : AlgebraicGeometry.IsOpenImmersion chart_inf := hOpen_chart_inf

  have hchart₀ : chart₀ ≫ P1_k.hom = p_A1 := by
    change (spec_e₀ ≫ away₀) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc away₀ (AlgebraicGeometry.Proj.toSpecZero 𝒜),
      AlgebraicGeometry.Proj.awayι_toSpecZero]
    dsimp only [spec_e₀]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    apply RingHom.ext
    intro c
    have hc := congrArg (fun f : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0) =>
      e₀.symm (f c)) he₀_C
    simpa [φ₀] using hc.symm

  have hchart_inf : chart_inf ≫ P1_k.hom = p_A1 := by
    change (spec_e₁ ≫ away₁) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₀)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc away₁ (AlgebraicGeometry.Proj.toSpecZero 𝒜),
      AlgebraicGeometry.Proj.awayι_toSpecZero]
    dsimp only [spec_e₁]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    apply congrArg AlgebraicGeometry.Spec.map
    apply congrArg CommRingCat.ofHom
    apply RingHom.ext
    intro c
    have hc := congrArg (fun f : k →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1) =>
      e₁.symm (f c)) he₁_C
    simpa [φ₀] using hc.symm

  have hRange_chart₀ : Set.range chart₀.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    have hSurj : Function.Surjective spec_e₀.base :=
      (TopCat.epi_iff_surjective spec_e₀.base).mp inferInstance
    have h_eq1 : Set.range chart₀.base = Set.range away₀.base := by
      ext x
      refine ⟨fun ⟨y, hy⟩ => ⟨spec_e₀.base y, hy⟩, fun ⟨z, hz⟩ => ?_⟩
      obtain ⟨y, rfl⟩ := hSurj z
      exact ⟨y, hz⟩
    exact h_eq1.trans (congrArg SetLike.coe
      (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one))

  have hRange_chart_inf : Set.range chart_inf.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    have hSurj : Function.Surjective spec_e₁.base :=
      (TopCat.epi_iff_surjective spec_e₁.base).mp inferInstance
    have h_eq1 : Set.range chart_inf.base = Set.range away₁.base := by
      ext x
      refine ⟨fun ⟨y, hy⟩ => ⟨spec_e₁.base y, hy⟩, fun ⟨z, hz⟩ => ?_⟩
      obtain ⟨y, rfl⟩ := hSurj z
      exact ⟨y, hz⟩
    exact h_eq1.trans (congrArg SetLike.coe
      (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one))

  have hCover_P1 : Set.range chart₀.base ∪ Set.range chart_inf.base = Set.univ := by
    ext p
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    rw [hRange_chart₀, hRange_chart_inf]
    by_contra hp
    rw [not_or] at hp
    rcases hp with ⟨hp0, hp1⟩
    have hX0_in : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) k) ∈ p.asHomogeneousIdeal := by
      by_contra hnot
      exact hp0 ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 0) p).mpr hnot)
    have hX1_in : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k) ∈ p.asHomogeneousIdeal := by
      by_contra hnot
      exact hp1 ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 1) p).mpr hnot)
    apply p.not_irrelevant_le
    intro F hF_irr
    let J : _root_.Ideal (MvPolynomial (Fin (1 + 1)) k) :=
      _root_.Ideal.span {MvPolynomial.X 0, MvPolynomial.X 1}
    have hJ_le_p : J ≤ p.asHomogeneousIdeal.toIdeal := by
      rw [_root_.Ideal.span_le]
      rintro g (rfl | rfl)
      · exact hX0_in
      · exact hX1_in
    have hJ_le_irr : J ≤ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
      rw [_root_.Ideal.span_le]
      rintro g (rfl | rfl)
      · exact HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 zero_lt_one (hX_mem 0)
      · exact HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 zero_lt_one (hX_mem 1)
    let ev00 : MvPolynomial (Fin (1 + 1)) k →ₐ[k] k := MvPolynomial.aeval 0
    have hF_mod_J : ∀ G : MvPolynomial (Fin (1 + 1)) k,
        G - MvPolynomial.C (ev00 G) ∈ J := by
      intro G
      induction G using MvPolynomial.induction_on with
      | C c =>
        have hc : ev00 (MvPolynomial.C c) = c := MvPolynomial.aeval_C 0 c
        rw [hc, sub_self]
        exact J.zero_mem
      | add g₁ g₂ hg₁ hg₂ =>
        have h_add : (g₁ + g₂) - MvPolynomial.C (ev00 (g₁ + g₂)) =
            (g₁ - MvPolynomial.C (ev00 g₁)) + (g₂ - MvPolynomial.C (ev00 g₂)) := by
          rw [map_add, MvPolynomial.C_add]; ring
        rw [h_add]
        exact J.add_mem hg₁ hg₂
      | mul_X g l _ =>
        have hl : ev00 (g * MvPolynomial.X l) = 0 := by
          change MvPolynomial.aeval 0 (g * MvPolynomial.X l) = 0
          rw [map_mul, MvPolynomial.aeval_X, Pi.zero_apply, mul_zero]
        rw [hl, map_zero, sub_zero]
        have hXl_J : (MvPolynomial.X l : MvPolynomial (Fin (1 + 1)) k) ∈ J := by
          apply _root_.Ideal.subset_span
          fin_cases l <;> simp
        exact J.mul_mem_left g hXl_J
    have hC_irr : MvPolynomial.C (ev00 F) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
      have hsub : F - (F - MvPolynomial.C (ev00 F)) = MvPolynomial.C (ev00 F) := by ring
      rw [← HomogeneousIdeal.mem_iff, ← hsub]
      exact (HomogeneousIdeal.irrelevant 𝒜).toIdeal.sub_mem hF_irr (hJ_le_irr (hF_mod_J F))
    have hC_mem0 : (MvPolynomial.C (ev00 F) : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 0 :=
      (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ _)
    have hC_eq0 : (MvPolynomial.C (ev00 F) : MvPolynomial (Fin (1 + 1)) k) = 0 := by
      have hproj := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 _).mp hC_irr
      simpa [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hC_mem0] using hproj
    have hF_in_J : F ∈ J := by
      have h_mem := hF_mod_J F
      rwa [hC_eq0, sub_zero] at h_mem
    exact hJ_le_p hF_in_J

  have hPre_0_inf_basic : chart₀.base ⁻¹' (Set.range chart_inf.base) =
      (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) : Set (PrimeSpectrum (Polynomial k))) := by
    ext q
    change chart₀.base q ∈ Set.range chart_inf.base ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [hRange_chart_inf]
    have h_away_pre := SetLike.ext_iff.mp
      (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem 0) zero_lt_one (hX_mem 1) zero_lt_one)
      (spec_e₀.base q)
    change away₀.base (spec_e₀.base q) ∈ AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) ↔ _ at h_away_pre
    rw [← he₀_X] at h_away_pre
    exact h_away_pre.trans (not_congr (by
      change e₀.symm (e₀ Polynomial.X) ∈ (q : PrimeSpectrum (Polynomial k)).asIdeal ↔ _
      rw [e₀.symm_apply_apply]))

  let R_loc := Localization.Away (Polynomial.X : Polynomial k)
  let ι_R : Polynomial k →+* R_loc := algebraMap (Polynomial k) R_loc
  have hRange_jGm : Set.range j_Gm.base =
      (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) :
        Set (PrimeSpectrum (Polynomial k))) :=
    PrimeSpectrum.localization_away_comap_range R_loc (Polynomial.X : Polynomial k)

  have hPre_0_inf : chart₀.base ⁻¹' (Set.range chart_inf.base) = Set.range j_Gm.base :=
    hPre_0_inf_basic.trans hRange_jGm.symm

  let ev₀ : Polynomial k →+* k := Polynomial.evalRingHom 0
  let s₀ : Sk ⟶ A1_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)

  have hDisj_0_inf : Disjoint (Set.range (s₀ ≫ chart₀).base) (Set.range chart_inf.base) := by
    rw [Set.disjoint_left]
    rintro y ⟨pt, rfl⟩ hy_inf
    have h_pre : s₀.base pt ∈ chart₀.base ⁻¹' (Set.range chart_inf.base) := hy_inf
    rw [hPre_0_inf_basic] at h_pre
    change Polynomial.X ∉ (PrimeSpectrum.comap ev₀ (pt : PrimeSpectrum k)).asIdeal at h_pre
    apply h_pre
    change ev₀ Polynomial.X ∈ (pt : PrimeSpectrum k).asIdeal
    have hevX : ev₀ Polynomial.X = 0 := Polynomial.eval_X
    rw [hevX]
    exact (pt : PrimeSpectrum k).asIdeal.zero_mem

  let x_inv : R_loc := IsLocalization.Away.invSelf (S := R_loc) (Polynomial.X : Polynomial k)
  have hx_mul_inv : ι_R Polynomial.X * x_inv = 1 :=
    IsLocalization.Away.mul_invSelf (S := R_loc) (Polynomial.X : Polynomial k)
  have hx_inv_mul : x_inv * ι_R Polynomial.X = 1 := by rw [mul_comm, hx_mul_inv]
  have hx_inv_unit : IsUnit x_inv := ⟨⟨x_inv, ι_R Polynomial.X, hx_inv_mul, hx_mul_inv⟩, rfl⟩
  have hX_loc_unit : IsUnit (ι_R Polynomial.X) :=
    ⟨⟨ι_R Polynomial.X, x_inv, hx_mul_inv, hx_inv_mul⟩, rfl⟩
  let τ_pre : Polynomial k →+* R_loc := Polynomial.eval₂RingHom (ι_R.comp Polynomial.C) x_inv
  have hτ_pre_X : IsUnit (τ_pre Polynomial.X) := by
    change IsUnit (Polynomial.eval₂ (ι_R.comp Polynomial.C) x_inv Polynomial.X)
    rw [Polynomial.eval₂_X]
    exact hx_inv_unit
  let τ_inv : R_loc →+* R_loc :=
    IsLocalization.Away.lift (Polynomial.X : Polynomial k) hτ_pre_X
  have hτ_lift_eq : ∀ p : Polynomial k, τ_inv (ι_R p) = τ_pre p :=
    fun p => IsLocalization.Away.lift_eq (Polynomial.X : Polynomial k) hτ_pre_X p
  have hτ_C : ∀ c : k, τ_inv (ι_R (Polynomial.C c)) = ι_R (Polynomial.C c) := by
    intro c
    rw [hτ_lift_eq]
    change Polynomial.eval₂ (ι_R.comp Polynomial.C) x_inv (Polynomial.C c) = ι_R (Polynomial.C c)
    exact Polynomial.eval₂_C _ _
  have hτ_X : τ_inv (ι_R Polynomial.X) = x_inv := by
    rw [hτ_lift_eq]
    change Polynomial.eval₂ (ι_R.comp Polynomial.C) x_inv Polynomial.X = x_inv
    exact Polynomial.eval₂_X _ _
  have hτ_x_inv : τ_inv x_inv = ι_R Polynomial.X := by
    apply hx_inv_unit.mul_right_cancel
    calc
      τ_inv x_inv * x_inv
        = τ_inv x_inv * τ_inv (ι_R Polynomial.X) := by rw [hτ_X]
      _ = τ_inv (x_inv * ι_R Polynomial.X) := (map_mul τ_inv _ _).symm
      _ = τ_inv 1 := by rw [hx_inv_mul]
      _ = 1 := map_one τ_inv
      _ = ι_R Polynomial.X * x_inv := hx_mul_inv.symm
  have hτ_inv_sq : τ_inv.comp τ_inv = RingHom.id R_loc := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial k))
    apply Polynomial.ringHom_ext
    · intro c
      change τ_inv (τ_inv (ι_R (Polynomial.C c))) = ι_R (Polynomial.C c)
      rw [hτ_C, hτ_C]
    · change τ_inv (τ_inv (ι_R Polynomial.X)) = ι_R Polynomial.X
      rw [hτ_X, hτ_x_inv]

  let σ_Gm : Gm_k ⟶ Gm_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv)
  have hσ_inv : σ_Gm ≫ σ_Gm = 𝟙 Gm_k := by
    dsimp only [σ_Gm, Gm_k]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hτ_inv_sq,
      CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  have hσ_pA1 : σ_Gm ≫ j_Gm ≫ p_A1 = j_Gm ≫ p_A1 := by
    have h_j_p : j_Gm ≫ p_A1 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_R.comp Polynomial.C)) := by
      dsimp only [j_Gm, p_A1, ι_R, R_loc]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    rw [h_j_p]
    dsimp only [σ_Gm]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun c => hτ_C c))

  have hGlue_inf_0 : j_Gm ≫ chart_inf = σ_Gm ≫ j_Gm ≫ chart₀ := by
    let M : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X 1 * MvPolynomial.X 0
    have hM_mem : M ∈ 𝒜 (1 + 1) := SetLike.mul_mem_graded (hX_mem 1) (hX_mem 0)
    have hx₁ : M = MvPolynomial.X 1 * MvPolynomial.X 0 := rfl
    have hx₀ : M = MvPolynomial.X 0 * MvPolynomial.X 1 := mul_comm _ _
    let ρ₁ := HomogeneousLocalization.awayMap 𝒜 (hX_mem 0) hx₁
    let ρ₀ := HomogeneousLocalization.awayMap 𝒜 (hX_mem 1) hx₀
    let ev_M1_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] R_loc :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = 1 then (1 : R_loc) else ι_R Polynomial.X)
    let ev_M0_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] R_loc :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = 0 then (1 : R_loc) else ι_R Polynomial.X)
    have hM1_ev : ev_M1_alg M = ι_R Polynomial.X := by
      dsimp [M, ev_M1_alg]
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      simp [h01]
    have hM0_ev : ev_M0_alg M = ι_R Polynomial.X := by
      dsimp [M, ev_M0_alg]
      rw [map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_X]
      simp [h10]
    have hUnit_M1 : IsUnit (ev_M1_alg.toRingHom M) := by
      change IsUnit (ev_M1_alg M)
      rw [hM1_ev]
      exact hX_loc_unit
    have hUnit_M0 : IsUnit (ev_M0_alg.toRingHom M) := by
      change IsUnit (ev_M0_alg M)
      rw [hM0_ev]
      exact hX_loc_unit
    let L_M1 : Localization.Away M →+* R_loc :=
      IsLocalization.Away.lift M hUnit_M1
    let L_M0 : Localization.Away M →+* R_loc :=
      IsLocalization.Away.lift M hUnit_M0
    let val_M : HomogeneousLocalization.Away 𝒜 M →+* Localization.Away M :=
      algebraMap (HomogeneousLocalization.Away 𝒜 M) (Localization.Away M)
    let f₁_inv : HomogeneousLocalization.Away 𝒜 M →+* R_loc := L_M1.comp val_M
    let f₀_inv : HomogeneousLocalization.Away 𝒜 M →+* R_loc := L_M0.comp val_M
    have hf₁_mk : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • (1 + 1))),
        f₁_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF) * (ι_R Polynomial.X) ^ m =
          ev_M1_alg F := by
      intro m F hF
      have hw_val : (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF).val *
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) (M ^ m) =
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers M)
          (Localization.Away M) F ⟨M ^ m, ⟨m, rfl⟩⟩
      have h_app := congrArg L_M1 hw_val
      have hL_eq : ∀ G : MvPolynomial (Fin (1 + 1)) k,
          L_M1 (algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) G) = ev_M1_alg G :=
        fun G => IsLocalization.Away.lift_eq M hUnit_M1 G
      rw [map_mul, hL_eq, hL_eq, map_pow, hM1_ev] at h_app
      change L_M1 (val_M (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
        (ι_R Polynomial.X) ^ m = ev_M1_alg F
      rw [HomogeneousLocalization.algebraMap_apply]
      exact h_app
    have hf₀_mk : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • (1 + 1))),
        f₀_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF) * (ι_R Polynomial.X) ^ m =
          ev_M0_alg F := by
      intro m F hF
      have hw_val : (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF).val *
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) (M ^ m) =
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk', mul_comm]
        exact IsLocalization.mk'_spec' (M := Submonoid.powers M)
          (Localization.Away M) F ⟨M ^ m, ⟨m, rfl⟩⟩
      have h_app := congrArg L_M0 hw_val
      have hL_eq : ∀ G : MvPolynomial (Fin (1 + 1)) k,
          L_M0 (algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) G) = ev_M0_alg G :=
        fun G => IsLocalization.Away.lift_eq M hUnit_M0 G
      rw [map_mul, hL_eq, hL_eq, map_pow, hM0_ev] at h_app
      change L_M0 (val_M (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
        (ι_R Polynomial.X) ^ m = ev_M0_alg F
      rw [HomogeneousLocalization.algebraMap_apply]
      exact h_app
    have hUnit_Xpow : ∀ m : ℕ, IsUnit ((ι_R Polynomial.X) ^ m) :=
      fun m => hX_loc_unit.pow m
    have h_ev1_hom : ι_R.comp (MvPolynomial.aeval
        (fun l : Fin (1 + 1) => if l = 1 then (1 : Polynomial k) else Polynomial.X)).toRingHom =
        ev_M1_alg.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.C c)) = ev_M1_alg (MvPolynomial.C c)
        rw [MvPolynomial.aeval_C]
        dsimp [ev_M1_alg]
        rw [MvPolynomial.aeval_C]
        rfl
      · intro l
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.X l)) = ev_M1_alg (MvPolynomial.X l)
        dsimp [ev_M1_alg]
        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        split_ifs <;> simp
    have h_rel1 : f₁_inv.comp ρ₁ = ι_R.comp e₁.symm.toRingHom := by
      apply RingHom.ext
      intro z
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem 1) z
      apply (hUnit_Xpow m).mul_right_cancel
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe]
      rw [HomogeneousLocalization.awayMap_mk, hf₁_mk, he₁_symm m F hF]
      have h_ev_eq : ι_R ((MvPolynomial.aeval
          (fun l : Fin (1 + 1) => if l = 1 then (1 : Polynomial k) else Polynomial.X)) F) =
          ev_M1_alg F :=
        DFunLike.congr_fun h_ev1_hom F
      rw [h_ev_eq, map_mul, map_pow]
      have hX0_ev : ev_M1_alg (MvPolynomial.X 0) = ι_R Polynomial.X := by
        dsimp [ev_M1_alg]
        rw [MvPolynomial.aeval_X]
        simp [h01]
      rw [hX0_ev]
    have h_ev0_hom : ι_R.comp (MvPolynomial.aeval
        (fun l : Fin (1 + 1) => if l = 0 then (1 : Polynomial k) else Polynomial.X)).toRingHom =
        ev_M0_alg.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.C c)) = ev_M0_alg (MvPolynomial.C c)
        rw [MvPolynomial.aeval_C]
        dsimp [ev_M0_alg]
        rw [MvPolynomial.aeval_C]
        rfl
      · intro l
        change ι_R (MvPolynomial.aeval _ (MvPolynomial.X l)) = ev_M0_alg (MvPolynomial.X l)
        dsimp [ev_M0_alg]
        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X]
        split_ifs <;> simp
    have h_rel0 : f₀_inv.comp ρ₀ = ι_R.comp e₀.symm.toRingHom := by
      apply RingHom.ext
      intro z
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem 0) z
      apply (hUnit_Xpow m).mul_right_cancel
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
        RingHom.coe_coe]
      rw [HomogeneousLocalization.awayMap_mk, hf₀_mk, he₀_symm m F hF]
      have h_ev_eq : ι_R ((MvPolynomial.aeval
          (fun l : Fin (1 + 1) => if l = 0 then (1 : Polynomial k) else Polynomial.X)) F) =
          ev_M0_alg F :=
        DFunLike.congr_fun h_ev0_hom F
      rw [h_ev_eq, map_mul, map_pow]
      have hX1_ev : ev_M0_alg (MvPolynomial.X 1) = ι_R Polynomial.X := by
        dsimp [ev_M0_alg]
        rw [MvPolynomial.aeval_X]
        simp [h10]
      rw [hX1_ev]
    have h_rel_tau : f₁_inv = τ_inv.comp f₀_inv := by
      apply RingHom.ext
      intro w
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hM_mem w
      apply (hUnit_Xpow m).mul_right_cancel
      simp only [RingHom.coe_comp, Function.comp_apply]
      rw [hf₁_mk m F hF]
      have h_tau0 := congrArg τ_inv (hf₀_mk m F hF)
      rw [map_mul, map_pow, hτ_X] at h_tau0
      have h_mul2 := congrArg (· * (ι_R Polynomial.X) ^ (2 * m)) h_tau0
      have h_cancel_lhs : (τ_inv (f₀_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
          x_inv ^ m) * (ι_R Polynomial.X) ^ (2 * m) =
          τ_inv (f₀_inv (HomogeneousLocalization.Away.mk 𝒜 hM_mem m F hF)) *
            (ι_R Polynomial.X) ^ m := by
        have h2m : 2 * m = m + m := Nat.two_mul m
        rw [h2m, pow_add, ← mul_assoc, mul_assoc _ (x_inv ^ m) _, ← mul_pow, hx_inv_mul,
          one_pow, mul_one]
      rw [h_cancel_lhs] at h_mul2
      rw [h_mul2]
      have hF_hom : F.IsHomogeneous (2 * m) := by
        have hF' : F ∈ 𝒜 (2 * m) := by
          have hm2 : m • (1 + 1) = 2 * m := by simp; ring
          exact hm2 ▸ hF
        exact (MvPolynomial.mem_homogeneousSubmodule (2 * m) F).mp hF'
      conv_lhs => rw [MvPolynomial.as_sum F]
      conv_rhs => rw [MvPolynomial.as_sum F]
      rw [map_sum, map_sum, map_sum, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro s hs
      have hs_deg : s 0 + s 1 = 2 * m := by
        have hw := hF_hom (MvPolynomial.mem_support_iff.mp hs)
        simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using hw
      rw [MvPolynomial.monomial_eq, Finsupp.prod_pow, Fin.prod_univ_two]
      generalize F.coeff s = cs
      dsimp only [ev_M1_alg, ev_M0_alg]
      simp only [map_mul, map_pow, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
      have hC_eq : algebraMap k R_loc cs = ι_R (Polynomial.C cs) := rfl
      have h01' : ¬ ((0 : Fin (1 + 1)) = 1) := h01
      have h10' : ¬ ((1 : Fin (1 + 1)) = 0) := h10
      simp only [h01', h10', ↓reduceIte, hC_eq, hτ_C, hτ_X, map_one, one_pow,
        mul_one, one_mul, ← hs_deg, pow_add]
      calc
        ι_R (Polynomial.C cs) * (ι_R Polynomial.X) ^ s 0 =
          ι_R (Polynomial.C cs) * (ι_R Polynomial.X) ^ s 0 *
            (x_inv * ι_R Polynomial.X) ^ s 1 := by rw [hx_inv_mul, one_pow, mul_one]
        _ = (ι_R (Polynomial.C cs) * x_inv ^ s 1) *
            ((ι_R Polynomial.X) ^ s 0 * (ι_R Polynomial.X) ^ s 1) := by rw [mul_pow]; ring
    have h_away_M1 := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem 1) zero_lt_one (hX_mem 0) hx₁
    have h_away_M0 := AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hX_mem 0) zero_lt_one (hX_mem 1) hx₀
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom) ≫ away₁) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) ≫ away₀)
    rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_R)),
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← h_rel1,
      CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
    dsimp only [away₁]
    rw [h_away_M1, h_rel_tau, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc]
    congr 1
    dsimp only [away₀]
    rw [← h_away_M0, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, h_rel0, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc]

  have hGlue_0_inf : j_Gm ≫ chart₀ = σ_Gm ≫ j_Gm ≫ chart_inf := by
    calc
      j_Gm ≫ chart₀
        = 𝟙 Gm_k ≫ (j_Gm ≫ chart₀) := (CategoryTheory.Category.id_comp _).symm
      _ = (σ_Gm ≫ σ_Gm) ≫ (j_Gm ≫ chart₀) := by rw [hσ_inv]
      _ = σ_Gm ≫ (σ_Gm ≫ j_Gm ≫ chart₀) := by simp only [CategoryTheory.Category.assoc]
      _ = σ_Gm ≫ j_Gm ≫ chart_inf := by rw [← hGlue_inf_0]

  
  let fst_Y := CategoryTheory.Limits.pullback.fst S_δ.hom p_A1
  let snd_Y := CategoryTheory.Limits.pullback.snd S_δ.hom p_A1

  have hs₀_pA1 : s₀ ≫ p_A1 = 𝟙 Sk := by
    dsimp only [s₀, p_A1, Sk]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_id : ev₀.comp Polynomial.C = RingHom.id k := by
      apply RingHom.ext
      intro c
      change Polynomial.eval 0 (Polynomial.C c) = c
      exact Polynomial.eval_C
    rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  let s₀_δ : S_δ.left ⟶ Y_δ :=
    CategoryTheory.Limits.pullback.lift (𝟙 S_δ.left) (S_δ.hom ≫ s₀) (by
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs₀_pA1,
        CategoryTheory.Category.comp_id])
  have hs₀_fst : s₀_δ ≫ fst_Y = 𝟙 S_δ.left :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hs₀_snd : s₀_δ ≫ snd_Y = S_δ.hom ≫ s₀ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  have : AlgebraicGeometry.IsAffineHom p_A1 := by
    dsimp only [p_A1]; infer_instance
  have : AlgebraicGeometry.IsSeparated p_A1 :=
    AlgebraicGeometry.IsSeparated.of_isAffineHom p_A1
  have : AlgebraicGeometry.IsSeparated fst_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback S_δ.hom p_A1).flip inferInstance
  have : AlgebraicGeometry.IsClosedImmersion (s₀_δ ≫ fst_Y) := by
    rw [hs₀_fst]; infer_instance
  have hCl_s₀ : AlgebraicGeometry.IsClosedImmersion s₀_δ :=
    AlgebraicGeometry.IsClosedImmersion.of_comp s₀_δ fst_Y

  have hFact_Y : ∀ (Ω : Type u) [Field Ω]
      (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y_δ),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        z_bar.base pt ∉ Set.range j_δ.base) →
      z_bar = (z_bar ≫ fst_Y) ≫ s₀_δ := by
    intro Ω _ z_bar hz
    let pt₀ : PrimeSpectrum Ω := ⊥
    have hz_not_jGm : (z_bar ≫ snd_Y).base pt₀ ∉ Set.range j_Gm.base := by
      rintro ⟨g₀, hg₀⟩
      have hg₀' : j_Gm.base g₀ = snd_Y.base (z_bar.base pt₀) := hg₀
      obtain ⟨u₀, -, hu₀_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback g₀ (z_bar.base pt₀) hg₀'
      exact hz pt₀ ⟨u₀, hu₀_snd⟩
    let φ_hom : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of Ω :=
      AlgebraicGeometry.Spec.preimage (z_bar ≫ snd_Y)
    have hSpec_φ : AlgebraicGeometry.Spec.map φ_hom = z_bar ≫ snd_Y :=
      AlgebraicGeometry.Spec.map_preimage (z_bar ≫ snd_Y)
    let φ : Polynomial k →+* Ω := φ_hom.hom
    have hφ_ofHom : CommRingCat.ofHom φ = φ_hom := CommRingCat.hom_ext rfl
    have hX_zero : φ Polynomial.X = 0 := by
      rw [← hSpec_φ, ← hφ_ofHom, hRange_jGm] at hz_not_jGm
      change ¬ (Polynomial.X ∉ (PrimeSpectrum.comap φ pt₀).asIdeal) at hz_not_jGm
      rw [not_not] at hz_not_jGm
      change φ Polynomial.X ∈ (⊥ : _root_.Ideal Ω) at hz_not_jGm
      rwa [_root_.Ideal.mem_bot] at hz_not_jGm
    have hφ_eq : φ = (φ.comp Polynomial.C).comp ev₀ := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.coe_comp, Function.comp_apply, ev₀]
        change φ (Polynomial.C c) = φ (Polynomial.C (Polynomial.eval 0 (Polynomial.C c)))
        rw [Polynomial.eval_C]
      · simp only [RingHom.coe_comp, Function.comp_apply, ev₀]
        change φ Polynomial.X = φ (Polynomial.C (Polynomial.eval 0 Polynomial.X))
        rw [Polynomial.eval_X, map_zero, map_zero, hX_zero]
    have hsnd_eq : z_bar ≫ snd_Y = (z_bar ≫ fst_Y) ≫ s₀_δ ≫ snd_Y := by
      have h1 : z_bar ≫ snd_Y =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp Polynomial.C)) ≫ s₀ := by
        conv_lhs => rw [← hSpec_φ, ← hφ_ofHom, hφ_eq]
        dsimp only [s₀]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ.comp Polynomial.C)) =
          (z_bar ≫ snd_Y) ≫ p_A1 := by
        rw [← hSpec_φ, ← hφ_ofHom]
        dsimp only [p_A1]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [h1, h2, CategoryTheory.Category.assoc z_bar snd_Y p_A1,
        ← CategoryTheory.Limits.pullback.condition (f := S_δ.hom) (g := p_A1),
        hs₀_snd]
      dsimp only [fst_Y]
      simp only [CategoryTheory.Category.assoc]
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hs₀_fst, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc]
      exact hsnd_eq

  let e_mv1 : MvPolynomial (Fin 1) k ≃ₐ[k] Polynomial k :=
    MvPolynomial.uniqueAlgEquiv k (Fin 1)
  let A1_mv1 := weilAffineSpaceOver k 1
  let f_to_mv1 : A1_k ⟶ A1_mv1.left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.toRingHom)
  let f_from_mv1 : A1_mv1.left ⟶ A1_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.symm.toRingHom)
  have hf_to_hom : f_to_mv1 ≫ A1_mv1.hom = p_A1 := by
    dsimp only [f_to_mv1, p_A1, A1_mv1, weilAffineSpaceOver]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin 1) k))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun c => e_mv1.commutes c))
  have hf_from_hom : f_from_mv1 ≫ p_A1 = A1_mv1.hom := by
    dsimp only [f_from_mv1, p_A1, A1_mv1, weilAffineSpaceOver]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin 1) k)))
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg AlgebraicGeometry.Spec.map
      (congrArg CommRingCat.ofHom (RingHom.ext fun c => e_mv1.symm.commutes c))
  have hf_to_from : f_to_mv1 ≫ f_from_mv1 = 𝟙 A1_k := by
    dsimp only [f_to_mv1, f_from_mv1, A1_k, A1_mv1, weilAffineSpaceOver]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.symm.toRingHom) =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_id : e_mv1.toRingHom.comp e_mv1.symm.toRingHom = RingHom.id (Polynomial k) :=
      RingHom.ext e_mv1.apply_symm_apply
    rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
  have hf_from_to : f_from_mv1 ≫ f_to_mv1 = 𝟙 A1_mv1.left := by
    dsimp only [f_to_mv1, f_from_mv1, A1_mv1, weilAffineSpaceOver]
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.symm.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_mv1.toRingHom) =
      𝟙 (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) k)))
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_id : e_mv1.symm.toRingHom.comp e_mv1.toRingHom = RingHom.id (MvPolynomial (Fin 1) k) :=
      RingHom.ext e_mv1.symm_apply_apply
    rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]

  let fst_mv1 := CategoryTheory.Limits.pullback.fst S_δ.hom A1_mv1.hom
  let snd_mv1 := CategoryTheory.Limits.pullback.snd S_δ.hom A1_mv1.hom
  let e_A1 : Y_δ ≅ CategoryTheory.Limits.pullback S_δ.hom A1_mv1.hom :=
    { hom := CategoryTheory.Limits.pullback.lift fst_Y (snd_Y ≫ f_to_mv1) (by
        rw [CategoryTheory.Category.assoc, hf_to_hom, CategoryTheory.Limits.pullback.condition])
      inv := CategoryTheory.Limits.pullback.lift fst_mv1 (snd_mv1 ≫ f_from_mv1) (by
        rw [CategoryTheory.Category.assoc, hf_from_hom, CategoryTheory.Limits.pullback.condition])
      hom_inv_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc, hf_to_from, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp]
      inv_hom_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc, hf_from_to, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp] }
  have he_A1_fst : e_A1.hom ≫ fst_mv1 = fst_Y :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _

  
  let snd_P := CategoryTheory.Limits.pullback.snd S_δ.hom P1_k.hom
  let fst_U := CategoryTheory.Limits.pullback.fst j_Gm snd_Y

  let ι₀_δ : Y_δ ⟶ P_δ :=
    CategoryTheory.Limits.pullback.lift fst_Y (snd_Y ≫ chart₀) (by
      rw [CategoryTheory.Category.assoc, hchart₀, CategoryTheory.Limits.pullback.condition])
  let ι_inf_δ : Y_δ ⟶ P_δ :=
    CategoryTheory.Limits.pullback.lift fst_Y (snd_Y ≫ chart_inf) (by
      rw [CategoryTheory.Category.assoc, hchart_inf, CategoryTheory.Limits.pullback.condition])
  let i₀_δ : S_δ.left ⟶ P_δ := s₀_δ ≫ ι₀_δ

  have hι0_π : ι₀_δ ≫ π_δ = fst_Y := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hιinf_π : ι_inf_δ ≫ π_δ = fst_Y := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hι0_snd : ι₀_δ ≫ snd_P = snd_Y ≫ chart₀ := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hιinf_snd : ι_inf_δ ≫ snd_P = snd_Y ≫ chart_inf := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hi₀_eq : i₀_δ = s₀_δ ≫ ι₀_δ := rfl
  have hi₀_π : i₀_δ ≫ π_δ = 𝟙 S_δ.left := by
    dsimp only [i₀_δ]
    rw [CategoryTheory.Category.assoc, hι0_π, hs₀_fst]

  have : AlgebraicGeometry.IsClosedImmersion (i₀_δ ≫ π_δ) := by
    rw [hi₀_π]; infer_instance
  have hCl_i₀ : AlgebraicGeometry.IsClosedImmersion i₀_δ :=
    AlgebraicGeometry.IsClosedImmersion.of_comp i₀_δ π_δ

  have hPb_P : CategoryTheory.IsPullback π_δ snd_P S_δ.hom P1_k.hom :=
    CategoryTheory.IsPullback.of_hasPullback S_δ.hom P1_k.hom
  have hPb_Y : CategoryTheory.IsPullback fst_Y snd_Y S_δ.hom p_A1 :=
    CategoryTheory.IsPullback.of_hasPullback S_δ.hom p_A1

  have hOuter₀ : CategoryTheory.IsPullback (ι₀_δ ≫ π_δ) snd_Y S_δ.hom (chart₀ ≫ P1_k.hom) := by
    rwa [hι0_π, hchart₀]
  have hPb₀ : CategoryTheory.IsPullback ι₀_δ snd_Y snd_P chart₀ :=
    CategoryTheory.IsPullback.of_right hOuter₀ hι0_snd hPb_P

  have hOuter_inf : CategoryTheory.IsPullback (ι_inf_δ ≫ π_δ) snd_Y S_δ.hom (chart_inf ≫ P1_k.hom) := by
    rwa [hιinf_π, hchart_inf]
  have hPb_inf : CategoryTheory.IsPullback ι_inf_δ snd_Y snd_P chart_inf :=
    CategoryTheory.IsPullback.of_right hOuter_inf hιinf_snd hPb_P

  have hOpen_ι0 : AlgebraicGeometry.IsOpenImmersion ι₀_δ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb₀.flip inferInstance
  have hOpen_ιinf : AlgebraicGeometry.IsOpenImmersion ι_inf_δ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_inf.flip inferInstance
  have : AlgebraicGeometry.IsOpenImmersion ι₀_δ := hOpen_ι0
  have : AlgebraicGeometry.IsOpenImmersion ι_inf_δ := hOpen_ιinf

  have hRange_pb : ∀ (ι_ch : Y_δ ⟶ P_δ) (chart : A1_k ⟶ P1_k.left),
      CategoryTheory.IsPullback ι_ch snd_Y snd_P chart →
      Set.range ι_ch.base = snd_P.base ⁻¹' (Set.range chart.base) := by
    intro ι_ch chart hPb
    ext p
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨snd_Y.base y, ?_⟩
      change (snd_Y ≫ chart).base y = (ι_ch ≫ snd_P).base y
      rw [hPb.w]
    · rintro ⟨q, hq⟩
      obtain ⟨z, hz_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback p q hq.symm
      refine ⟨hPb.isoPullback.inv.base z, ?_⟩
      have h_inv_fst : (hPb.isoPullback.inv ≫ ι_ch).base z =
          (CategoryTheory.Limits.pullback.fst snd_P chart).base z :=
        congrArg (fun m => m.base z) hPb.isoPullback_inv_fst
      exact h_inv_fst.trans hz_fst

  have hRange_ι0 : Set.range ι₀_δ.base = snd_P.base ⁻¹' (Set.range chart₀.base) :=
    hRange_pb ι₀_δ chart₀ hPb₀
  have hRange_ιinf : Set.range ι_inf_δ.base = snd_P.base ⁻¹' (Set.range chart_inf.base) :=
    hRange_pb ι_inf_δ chart_inf hPb_inf

  have hRange_jδ : Set.range j_δ.base = snd_Y.base ⁻¹' (Set.range j_Gm.base) := by
    ext y
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨u, rfl⟩
      refine ⟨fst_U.base u, ?_⟩
      change (fst_U ≫ j_Gm).base u = (j_δ ≫ snd_Y).base u
      rw [CategoryTheory.Limits.pullback.condition]
    · rintro ⟨g, hg⟩
      obtain ⟨u, -, hu_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback g y hg
      exact ⟨u, hu_snd⟩

  have hCov_Pδ : Set.range ι₀_δ.base ∪ Set.range ι_inf_δ.base = Set.univ := by
    rw [hRange_ι0, hRange_ιinf, ← Set.preimage_union, hCover_P1, Set.preimage_univ]

  have hDisj_i0_inf : Disjoint (Set.range i₀_δ.base) (Set.range ι_inf_δ.base) := by
    rw [Set.disjoint_left]
    rintro p ⟨s, rfl⟩ hp_inf
    rw [hRange_ιinf] at hp_inf
    have hi0_snd : i₀_δ ≫ snd_P = S_δ.hom ≫ s₀ ≫ chart₀ := by
      dsimp only [i₀_δ]
      rw [CategoryTheory.Category.assoc, hι0_snd, ← CategoryTheory.Category.assoc, hs₀_snd,
        CategoryTheory.Category.assoc]
    have hp_0 : snd_P.base (i₀_δ.base s) ∈ Set.range (s₀ ≫ chart₀).base :=
      ⟨S_δ.hom.base s, (congrArg (fun m => m.base s) hi0_snd).symm⟩
    exact Set.disjoint_left.mp hDisj_0_inf hp_0 hp_inf

  have : AlgebraicGeometry.IsOpenImmersion j_Gm := by
    dsimp only [j_Gm]; infer_instance
  have : AlgebraicGeometry.IsOpenImmersion j_δ := by
    dsimp only [j_δ]; infer_instance

  let g_U : U_δ ⟶ Y_δ :=
    CategoryTheory.Limits.pullback.lift (j_δ ≫ fst_Y) (fst_U ≫ σ_Gm ≫ j_Gm) (by
      calc
        (j_δ ≫ fst_Y) ≫ S_δ.hom
          = j_δ ≫ (fst_Y ≫ S_δ.hom) := CategoryTheory.Category.assoc _ _ _
        _ = j_δ ≫ (snd_Y ≫ p_A1) := by rw [CategoryTheory.Limits.pullback.condition]
        _ = (j_δ ≫ snd_Y) ≫ p_A1 := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (fst_U ≫ j_Gm) ≫ p_A1 := by
            rw [CategoryTheory.Limits.pullback.condition (f := j_Gm) (g := snd_Y)]
        _ = fst_U ≫ (j_Gm ≫ p_A1) := CategoryTheory.Category.assoc _ _ _
        _ = fst_U ≫ (σ_Gm ≫ j_Gm ≫ p_A1) := congrArg (fst_U ≫ ·) hσ_pA1.symm
        _ = (fst_U ≫ σ_Gm ≫ j_Gm) ≫ p_A1 := by simp only [CategoryTheory.Category.assoc])

  let σ_U : U_δ ⟶ U_δ :=
    CategoryTheory.Limits.pullback.lift (fst_U ≫ σ_Gm) g_U (by
      dsimp only [g_U]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd])

  have hσU_fst : σ_U ≫ fst_U = fst_U ≫ σ_Gm :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hσU_snd : σ_U ≫ j_δ = g_U :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hσU_gU : σ_U ≫ g_U = j_δ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · dsimp only [g_U]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← CategoryTheory.Category.assoc, hσU_snd, CategoryTheory.Limits.pullback.lift_fst]
    · dsimp only [g_U]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc, hσU_fst, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc σ_Gm σ_Gm j_Gm, hσ_inv,
        CategoryTheory.Category.id_comp,
        CategoryTheory.Limits.pullback.condition (f := j_Gm) (g := snd_Y)]
  have hσU_sq : σ_U ≫ σ_U = 𝟙 U_δ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hσU_fst, ← CategoryTheory.Category.assoc, hσU_fst,
        CategoryTheory.Category.assoc, hσ_inv, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    · change (σ_U ≫ σ_U) ≫ j_δ = 𝟙 U_δ ≫ j_δ
      rw [CategoryTheory.Category.assoc, hσU_snd, hσU_gU, CategoryTheory.Category.id_comp]

  have : CategoryTheory.IsIso σ_U := ⟨⟨σ_U, hσU_sq, hσU_sq⟩⟩
  have : AlgebraicGeometry.IsOpenImmersion σ_U := inferInstance
  have hOpen_gU : AlgebraicGeometry.IsOpenImmersion g_U := by
    rw [← hσU_snd]
    exact AlgebraicGeometry.IsOpenImmersion.comp σ_U j_δ

  have hComm_charts : j_δ ≫ ι₀_δ = g_U ≫ ι_inf_δ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hι0_π, CategoryTheory.Category.assoc, hιinf_π]
      dsimp only [g_U]
      rw [CategoryTheory.Limits.pullback.lift_fst]
    · rw [CategoryTheory.Category.assoc, hι0_snd, CategoryTheory.Category.assoc, hιinf_snd]
      dsimp only [g_U]
      rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.lift _ _ _) snd_Y chart_inf,
        CategoryTheory.Limits.pullback.lift_snd,
        ← CategoryTheory.Category.assoc j_δ snd_Y chart₀,
        ← CategoryTheory.Limits.pullback.condition (f := j_Gm) (g := snd_Y),
        CategoryTheory.Category.assoc fst_U j_Gm chart₀, hGlue_0_inf]
      simp only [CategoryTheory.Category.assoc]

  have hOpens_charts :
      (TopologicalSpace.Opens.map ι₀_δ.base).obj ι_inf_δ.opensRange = j_δ.opensRange := by
    apply SetLike.ext
    intro y
    change ι₀_δ.base y ∈ Set.range ι_inf_δ.base ↔ y ∈ Set.range j_δ.base
    rw [hRange_ιinf, hRange_jδ]
    change snd_P.base (ι₀_δ.base y) ∈ Set.range chart_inf.base ↔
      snd_Y.base y ∈ Set.range j_Gm.base
    have h_pt : snd_P.base (ι₀_δ.base y) = chart₀.base (snd_Y.base y) :=
      congrArg (fun m => m.base y) hι0_snd
    rw [h_pt, ← Set.mem_preimage, hPre_0_inf]

  have hPb_charts : CategoryTheory.IsPullback j_δ g_U ι₀_δ ι_inf_δ :=
    (AlgebraicGeometry.IsOpenImmersion.isPullback g_U j_δ ι_inf_δ ι₀_δ
      hComm_charts hOpens_charts).flip

  have hFact_P : ∀ (Ω : Type u) [Field Ω]
      (x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P_δ),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        x_bar.base pt ∉ Set.range ι_inf_δ.base) →
      x_bar = (x_bar ≫ π_δ) ≫ i₀_δ := by
    intro Ω _ x_bar hx
    have hSub_x : Set.range x_bar.base ⊆ Set.range ι₀_δ.base := by
      rintro _ ⟨pt, rfl⟩
      have hcov : x_bar.base pt ∈ Set.range ι₀_δ.base ∪ Set.range ι_inf_δ.base := by
        rw [hCov_Pδ]; trivial
      exact hcov.resolve_right (hx pt)
    let z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y_δ :=
      AlgebraicGeometry.IsOpenImmersion.lift ι₀_δ x_bar hSub_x
    have hz_fac : z_bar ≫ ι₀_δ = x_bar :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac ι₀_δ x_bar hSub_x
    have hz_not_j : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        z_bar.base pt ∉ Set.range j_δ.base := by
      intro pt ⟨u, hu⟩
      apply hx pt
      refine ⟨g_U.base u, ?_⟩
      calc
        ι_inf_δ.base (g_U.base u)
          = (g_U ≫ ι_inf_δ).base u := rfl
        _ = (j_δ ≫ ι₀_δ).base u := by rw [← hComm_charts]
        _ = ι₀_δ.base (j_δ.base u) := rfl
        _ = ι₀_δ.base (z_bar.base pt) := by rw [hu]
        _ = (z_bar ≫ ι₀_δ).base pt := rfl
        _ = x_bar.base pt := by rw [hz_fac]
    have hz_eq := hFact_Y Ω z_bar hz_not_j
    calc
      x_bar
        = z_bar ≫ ι₀_δ := hz_fac.symm
      _ = ((z_bar ≫ fst_Y) ≫ s₀_δ) ≫ ι₀_δ := by rw [← hz_eq]
      _ = (z_bar ≫ (ι₀_δ ≫ π_δ)) ≫ (s₀_δ ≫ ι₀_δ) := by
          rw [hι0_π, CategoryTheory.Category.assoc]
      _ = ((z_bar ≫ ι₀_δ) ≫ π_δ) ≫ i₀_δ := by
          dsimp only [i₀_δ]
          rw [CategoryTheory.Category.assoc z_bar ι₀_δ π_δ]
      _ = (x_bar ≫ π_δ) ≫ i₀_δ := by rw [hz_fac]

  exact ⟨ι₀_δ, ι_inf_δ, s₀_δ, i₀_δ, g_U, e_A1,
    ⟨hOpen_ι0, hOpen_ιinf, hOpen_gU, hCl_s₀, hCl_i₀⟩,
    ⟨hι0_π, hιinf_π, hs₀_fst, hi₀_eq, hi₀_π⟩,
    ⟨hCov_Pδ, hDisj_i0_inf, hPb_charts⟩,
    ⟨hFact_Y, hFact_P⟩,
    he_A1_fst⟩

theorem weil_leray_sec_etale_baseChange_higherDirectImage (P₀ Y' Y U : AlgebraicGeometry.Scheme.{u})
    (j : Y' ⟶ P₀) (ι : Y ⟶ P₀) (j_U : U ⟶ Y) (g_U : U ⟶ Y')
    [AlgebraicGeometry.Etale ι] [AlgebraicGeometry.Etale g_U]
    (hPb : CategoryTheory.IsPullback j_U g_U ι j)
    (F : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})
    (F_U : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
    (hPB_F : WeilIsEtaleSheafPullback g_U F F_U) (b : ℕ) :
    WeilIsEtaleSheafPullback ι
      (weilEtaleHigherDirectImage j b F)
      (weilEtaleHigherDirectImage j_U b F_U) :=
by
  
  have hInjEmbed : ∀ (G : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}),
      ∃ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})),
        SC.X₁ = G ∧ CategoryTheory.Injective SC.X₂ ∧ SC.ShortExact := by
    intro G
    classical
    let u : G ⟶ CategoryTheory.Injective.under G := CategoryTheory.Injective.ι G
    let S : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.ShortComplex.mk u (CategoryTheory.Limits.cokernel.π u)
        (CategoryTheory.Limits.cokernel.condition u)
    have hS : S.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' (CategoryTheory.ShortComplex.exact_cokernel u)
        inferInstance inferInstance
    exact ⟨S, rfl, inferInstance, hS⟩

  
  have hSchemeCalc : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      Nonempty (CategoryTheory.Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology 0 ≅
        CategoryTheory.sheafToPresheaf Z.smallEtaleTopology AddCommGrpCat.{u}) ∧
      (∀ (I : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
          [CategoryTheory.Injective I] (k : ℕ),
        CategoryTheory.Limits.IsZero (I.cohomologyPresheaf (k + 1))) ∧
      (∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}))
          (_hSE : SC.ShortExact) (q : ℕ),
        ∃ (δ_pre : SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1))
          (hcomp₁ : (CategoryTheory.Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology q).map SC.g ≫ δ_pre = 0)
          (hcomp₂ : δ_pre ≫ (CategoryTheory.Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology (q + 1)).map SC.f = 0),
          (CategoryTheory.ShortComplex.mk
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology q).map SC.g)
            δ_pre hcomp₁).Exact ∧
          (CategoryTheory.ShortComplex.mk
            δ_pre
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor Z.smallEtaleTopology (q + 1)).map SC.f)
            hcomp₂).Exact) := by
    intro Z
    let J_Z := Z.smallEtaleTopology
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale)
      AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
    let Sh_Z := CategoryTheory.presheafToSheaf J_Z AddCommGrpCat.{u}
    let U_Z := CategoryTheory.sheafToPresheaf J_Z AddCommGrpCat.{u}
    let L_tot := Free_PSh ⋙ Sh_Z
    let R_tot := U_Z ⋙ Fgt_PSh
    let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite Z.Etale) AddCommGrpCat.adj
    let adj_sh := CategoryTheory.sheafificationAdjunction J_Z AddCommGrpCat.{u}
    let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh
    let Z_fun : Z.Etale ⥤ CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} :=
      CategoryTheory.yoneda ⋙ L_tot
    let Z_obj : Opposite Z.Etale → CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} :=
      fun W => Opposite.unop (Z_fun.op.obj W)
    let CP_Z : ℕ → CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} ⥤
        CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u} :=
      fun n => CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Z n
    refine ⟨?_, ?_, ?_⟩
    · let CP₀ := CP_Z 0
      let e_raw : ∀ (W : Opposite Z.Etale) (G : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}),
          CategoryTheory.Abelian.Ext (Z_obj W) G 0 ≃ ↑((U_Z.obj G).obj W) :=
        fun W G =>
          CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
            ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) G).trans
              CategoryTheory.yonedaEquiv)
      have he_add : ∀ (W : Opposite Z.Etale) (G : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u})
          (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) G 0),
          e_raw W G (α₁ + α₂) = e_raw W G α₁ + e_raw W G α₂ := by
        intro W G α₁ α₂
        let V := Opposite.unop W
        let u₁ : Z_obj W ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
        let u₂ : Z_obj W ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
        have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
          map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
        let ψ : (Z_obj W ⟶ G) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_Z.obj G) :=
          fun u => adj_sh.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) G u
