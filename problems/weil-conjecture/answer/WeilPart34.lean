        (CategoryTheory.Limits.pullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ A)))
          (weilProjectiveSpaceOver κ 1).hom).smallEtaleTopology
        AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 → Subsingleton (F.H b)) :
    let X_A := CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ A)))
      (weilProjectiveSpaceOver κ 1).hom
    let loc_A : Polynomial A →+* Localization.Away (Polynomial.X : Polynomial A) :=
      algebraMap (Polynomial A) (Localization.Away (Polynomial.X : Polynomial A))
    let inv_A : Polynomial A →+* Localization.Away (Polynomial.X : Polynomial A) :=
      Polynomial.eval₂RingHom (loc_A.comp Polynomial.C)
        (IsLocalization.Away.invSelf (Polynomial.X : Polynomial A))
    ∃ (j₀ j₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))) X_A)
      (_ : AlgebraicGeometry.IsOpenImmersion j₀)
      (_ : AlgebraicGeometry.IsOpenImmersion j₁)
      (i_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A)) X_A)
      (_ : AlgebraicGeometry.IsClosedImmersion i_inf),
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_A))
        j₁ j₀ ∧
      ∀ (ℱ_A : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))).smallEtaleTopology
          AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id ℱ_A = 0 →
        ∀ (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ))),
          WeilAltCdStalkZeroAt X_A (weilAltCdHigherDirectImage j₀ b ℱ_A)
            ((CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Polynomial.eval₂RingHom τ_A.toRingHom 0)))
              j₁).base pt) →
          Subsingleton (ℱ_A.H b) :=
by
  intro X_A loc_A inv_A
  let ev0_A : Polynomial A →+* A := Polynomial.eval₂RingHom (RingHom.id A) 0

  
  have hAtlas :
      ∃ (j₀ j₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))) X_A)
        (_ : AlgebraicGeometry.IsOpenImmersion j₀)
        (_ : AlgebraicGeometry.IsOpenImmersion j₁)
        (i_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of A)) X_A)
        (_ : AlgebraicGeometry.IsClosedImmersion i_inf)
        (_ : AlgebraicGeometry.Scheme.IsSeparated X_A),
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_A))
          j₁ j₀ ∧
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_A)) j₁ = i_inf ∧
        Set.range j₀.base = (Set.range i_inf.base)ᶜ := by
    have hExistsPreimagePb : ∀ {P X Y Z : AlgebraicGeometry.Scheme.{u}}
        {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
        (hpb : CategoryTheory.IsPullback fst snd f g)
        (x : ↥X) (y : ↥Y), f.base x = g.base y →
        ∃ z : ↥P, fst.base z = x ∧ snd.base z = y := by
      intro P X Y Z fst snd f g hpb x y hxy
      obtain ⟨w, hw₁, hw₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x y hxy
      refine ⟨hpb.isoPullback.inv.base w, ?_, ?_⟩
      · change (hpb.isoPullback.inv ≫ fst).base w = x
        rw [hpb.isoPullback_inv_fst]
        exact hw₁
      · change (hpb.isoPullback.inv ≫ snd).base w = y
        rw [hpb.isoPullback_inv_snd]
        exact hw₂
    have hOpenPb : ∀ {W U V Z : AlgebraicGeometry.Scheme.{u}}
        (p : W ⟶ U) (q : W ⟶ V) (f : U ⟶ Z) (g : V ⟶ Z)
        [AlgebraicGeometry.IsOpenImmersion f]
        [AlgebraicGeometry.IsOpenImmersion g]
        [AlgebraicGeometry.IsOpenImmersion p],
        p ≫ f = q ≫ g →
        Set.range p.base = f.base ⁻¹' Set.range g.base →
        CategoryTheory.IsPullback p q f g := by
      intro W U V Z p q f g _ _ _ hpq hrange
      let G : Z.Opens := g.opensRange
      let F_G : U.Opens := (TopologicalSpace.Opens.map f.base).obj G
      have hpb₀ : CategoryTheory.IsPullback F_G.ι (f ∣_ G) f G.ι :=
        (AlgebraicGeometry.isPullback_morphismRestrict f G).flip
      have hrange_W : Set.range F_G.ι.base = Set.range p.base := by
        have h1 : F_G.ι.opensRange = F_G := AlgebraicGeometry.Scheme.Opens.opensRange_ι F_G
        have h2 : Set.range F_G.ι.base = (F_G : Set ↥U) := congrArg SetLike.coe h1
        exact h2.trans hrange.symm
      have hrange_V : Set.range G.ι.base = Set.range g.base := by
        have h1 : G.ι.opensRange = G := AlgebraicGeometry.Scheme.Opens.opensRange_ι G
        exact congrArg SetLike.coe h1
      let e_W : (F_G : AlgebraicGeometry.Scheme.{u}) ≅ W :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq F_G.ι p hrange_W
      let e_V : (G : AlgebraicGeometry.Scheme.{u}) ≅ V :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq G.ι g hrange_V
      have heW : e_W.hom ≫ p = F_G.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac F_G.ι p hrange_W
      have heV : e_V.hom ≫ g = G.ι :=
        AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac G.ι g hrange_V
      refine hpb₀.of_iso e_W (CategoryTheory.Iso.refl U) e_V (CategoryTheory.Iso.refl Z)
        ?_ ?_ ?_ ?_
      · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id, heW]
      · apply (CategoryTheory.cancel_mono g).mp
        rw [CategoryTheory.Category.assoc, heV, ← hpb₀.w, ← heW,
          CategoryTheory.Category.assoc, hpq, CategoryTheory.Category.assoc]
      · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
        exact (CategoryTheory.Category.id_comp f).symm
      · rw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id, heV]

    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) κ
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let P₁ := weilProjectiveSpaceOver κ 1
    let T : Fin 2 → MvPolynomial (Fin 2) κ := MvPolynomial.X
    have hT_mem : ∀ i : Fin 2, T i ∈ 𝒜 1 := by
      intro i
      rw [MvPolynomial.mem_homogeneousSubmodule]
      exact MvPolynomial.isHomogeneous_X κ i
    let D : Fin 2 → (AlgebraicGeometry.Proj 𝒜).Opens :=
      fun i => AlgebraicGeometry.Proj.basicOpen 𝒜 (T i)
    have hadj : Algebra.adjoin ↥(𝒜 0) (Set.range T) = ⊤ := by
      rw [eq_top_iff]
      rintro F -
      induction F using MvPolynomial.induction_on with
      | C c =>
        have hc0 : MvPolynomial.C c ∈ 𝒜 0 := by
          rw [MvPolynomial.mem_homogeneousSubmodule]
          exact MvPolynomial.isHomogeneous_C (Fin 2) c
        exact Subalgebra.algebraMap_mem (Algebra.adjoin ↥(𝒜 0) (Set.range T))
          (⟨MvPolynomial.C c, hc0⟩ : ↥(𝒜 0))
      | add p q hp hq => exact add_mem hp hq
      | mul_X p i hp => exact mul_mem hp (Algebra.subset_adjoin ⟨i, rfl⟩)
    have hiSup : (⨆ i : Fin 2, D i) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜 T (fun i => ⟨1, hT_mem i⟩) hadj
    have hD_cov : ((D 0 : Set ↥(AlgebraicGeometry.Proj 𝒜)) ∪
        (D 1 : Set ↥(AlgebraicGeometry.Proj 𝒜))) = Set.univ := by
      have hsup : D 0 ⊔ D 1 = ⊤ := by
        apply le_antisymm le_top
        rw [← hiSup, iSup_le_iff]
        intro i
        fin_cases i
        · exact le_sup_left
        · exact le_sup_right
      exact congrArg SetLike.coe hsup

    have hChartEquiv : ∀ (i j : Fin 2), i ≠ j →
        ∃ e_i : Polynomial κ ≃+* HomogeneousLocalization.Away 𝒜 (T i),
          e_i Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hT_mem i) (hT_mem j) ∧
          e_i.symm (HomogeneousLocalization.Away.isLocalizationElem (hT_mem i) (hT_mem j)) =
            Polynomial.X ∧
          (∀ c : κ, e_i (Polynomial.C c) =
            (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T i)))
              (algebraMap κ ↥(𝒜 0) c)) ∧
          e_i.symm.toRingHom.comp
            ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T i))).comp
              (algebraMap κ ↥(𝒜 0))) = algebraMap κ (Polynomial κ) := by
      intro i j hij
      let R_i := HomogeneousLocalization.Away 𝒜 (T i)
      let S_i := Submonoid.powers (T i)
      let σ_i : κ →+* R_i :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜 S_i).comp (algebraMap κ ↥(𝒜 0))
      let t_ij : R_i := HomogeneousLocalization.Away.isLocalizationElem (hT_mem i) (hT_mem j)
      have ht_val : t_ij.val = Localization.mk (T j) ⟨T i, Submonoid.mem_powers (T i)⟩ := by
        dsimp [t_ij, HomogeneousLocalization.Away.isLocalizationElem]
        congr 1
        · exact pow_one _
        · exact Subtype.ext (pow_one _)
      let φ_i : Polynomial κ →+* R_i := Polynomial.eval₂RingHom σ_i t_ij
      let ev_ij : MvPolynomial (Fin 2) κ →+* Polynomial κ :=
        MvPolynomial.eval₂Hom Polynomial.C (fun m : Fin 2 => if m = i then 1 else Polynomial.X)
      have hev_Ti : ev_ij (T i) = 1 := by
        dsimp [ev_ij, T]
        rw [MvPolynomial.eval₂_X]
        simp
      have hev_Tj : ev_ij (T j) = Polynomial.X := by
        dsimp [ev_ij, T]
        rw [MvPolynomial.eval₂_X]
        simp [hij.symm]
      have hev_pow : ∀ y : S_i, ev_ij y.1 = 1 := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow, hev_Ti, one_pow]
      have hg_unit : ∀ y : S_i, IsUnit (ev_ij y.1) := by
        intro y
        rw [hev_pow y]
        exact isUnit_one
      let lift_ij : Localization S_i →+* Polynomial κ := IsLocalization.lift hg_unit
      have hlift_mk : ∀ (F : MvPolynomial (Fin 2) κ) (y : S_i),
          lift_ij (Localization.mk F y) = ev_ij F := by
        intro F y
        rw [Localization.mk_eq_mk'_apply, IsLocalization.lift_mk'_spec]
        rw [hev_pow y, one_mul]
      let ψ_i : R_i →+* Polynomial κ := lift_ij.comp (algebraMap R_i (Localization S_i))
      have hψ_val : ∀ z : R_i, ψ_i z = lift_ij z.val := by
        intro z
        change lift_ij (algebraMap R_i (Localization S_i) z) = lift_ij z.val
        rw [HomogeneousLocalization.algebraMap_apply]
      have hσ_val : ∀ c : κ, (σ_i c).val = Localization.mk (MvPolynomial.C c) (1 : S_i) := by
        intro c
        have h1 : (σ_i c).val =
            algebraMap (MvPolynomial (Fin 2) κ) (Localization S_i) (algebraMap κ ↥(𝒜 0) c).1 := by
          change algebraMap R_i (Localization S_i)
            (algebraMap ↥(𝒜 0) R_i (algebraMap κ ↥(𝒜 0) c)) = _
          rw [← IsScalarTower.algebraMap_apply]
          rfl
        rw [h1]
        rfl
      have hleft_inv : ∀ p : Polynomial κ, ψ_i (φ_i p) = p := by
        have hcomp : ψ_i.comp φ_i = RingHom.id (Polynomial κ) := by
          apply Polynomial.ringHom_ext
          · intro c
            change ψ_i (Polynomial.eval₂ σ_i t_ij (Polynomial.C c)) = Polynomial.C c
            rw [Polynomial.eval₂_C, hψ_val, hσ_val, hlift_mk]
            exact MvPolynomial.eval₂Hom_C _ _ c
          · change ψ_i (Polynomial.eval₂ σ_i t_ij Polynomial.X) = Polynomial.X
            rw [Polynomial.eval₂_X, hψ_val, ht_val, hlift_mk, hev_Tj]
        intro p
        exact congrArg (fun f => f p) hcomp
      have hright_inv : ∀ z : R_i, φ_i (ψ_i z) = z := by
        intro z
        apply HomogeneousLocalization.val_injective S_i
        refine Quotient.inductionOn' z (fun nd => ?_)
        change (φ_i (ψ_i (HomogeneousLocalization.mk nd))).val =
          (HomogeneousLocalization.mk nd).val
        rcases nd with ⟨d, ⟨F, hF_mem⟩, ⟨den, hden_mem_sub⟩, hden_mem⟩
        have hF : F.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d F).mp hF_mem
        have hden_hom : den.IsHomogeneous d :=
          (MvPolynomial.mem_homogeneousSubmodule d den).mp hden_mem_sub
        have hden_ex : ∃ m : ℕ, T i ^ m = den := hden_mem
        obtain ⟨m, hm_eq⟩ := hden_ex
        have hm_d : m = d := by
          have hTi_ne : T i ^ m ≠ 0 := pow_ne_zero m (MvPolynomial.X_ne_zero i)
          have hTi_hom : (T i ^ m).IsHomogeneous m := MvPolynomial.isHomogeneous_X_pow i m
          rw [hm_eq] at hTi_ne hTi_hom
          exact MvPolynomial.IsHomogeneous.inj_right hTi_hom hden_hom hTi_ne
        subst hm_d
        have hpow_m : T i ^ m ∈ S_i := pow_mem (Submonoid.mem_powers (T i)) m
        have hmk_val : (HomogeneousLocalization.mk
            ⟨m, ⟨F, hF_mem⟩, ⟨den, hden_mem_sub⟩, hden_mem⟩).val =
            Localization.mk F ⟨T i ^ m, hpow_m⟩ := by
          rw [HomogeneousLocalization.val_mk]
          congr 1
          exact Subtype.ext hm_eq.symm
        rw [hψ_val, hmk_val, hlift_mk]
        have hmon_decomp : ∀ s : Fin 2 →₀ ℕ, ∀ c : κ,
            MvPolynomial.monomial s c = MvPolynomial.C c * T i ^ s i * T j ^ s j := by
          intro s c
          rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
            Fin.prod_univ_two]
          dsimp [T]
          fin_cases i <;> fin_cases j
          · exact False.elim (hij rfl)
          · change MvPolynomial.C c * (MvPolynomial.X 0 ^ s 0 * MvPolynomial.X 1 ^ s 1) =
              MvPolynomial.C c * MvPolynomial.X 0 ^ s 0 * MvPolynomial.X 1 ^ s 1
            ring
          · change MvPolynomial.C c * (MvPolynomial.X 0 ^ s 0 * MvPolynomial.X 1 ^ s 1) =
              MvPolynomial.C c * MvPolynomial.X 1 ^ s 1 * MvPolynomial.X 0 ^ s 0
            ring
          · exact False.elim (hij rfl)
        have hval_hom : ∀ y : R_i, y.val = algebraMap R_i (Localization S_i) y :=
          fun y => (HomogeneousLocalization.algebraMap_apply y).symm
        rw [hval_hom, MvPolynomial.as_sum F, map_sum, map_sum, map_sum]
        have hsum_mk : ∀ (S_fin : Finset (Fin 2 →₀ ℕ))
            (g : (Fin 2 →₀ ℕ) → MvPolynomial (Fin 2) κ),
            (∑ s ∈ S_fin, Localization.mk (g s) ⟨T i ^ m, hpow_m⟩) =
              Localization.mk (∑ s ∈ S_fin, g s) ⟨T i ^ m, hpow_m⟩ := by
          intro S_fin g
          induction S_fin using Finset.induction_on with
          | empty => simp [Localization.mk_zero]
          | insert a S' ha ih =>
            rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
        rw [← hsum_mk]
        apply Finset.sum_congr rfl
        intro s hs
        have hc_ne : F.coeff s ≠ 0 := MvPolynomial.mem_support_iff.mp hs
        have hdeg_s : s i + s j = m := by
          have hmon_ne : MvPolynomial.monomial s (F.coeff s) ≠ 0 :=
            MvPolynomial.monomial_eq_zero.not.mpr hc_ne
          have hmon_hom1 : (MvPolynomial.monomial s (F.coeff s)).IsHomogeneous m :=
            MvPolynomial.isWeightedHomogeneous_monomial 1 s (F.coeff s) (hF hc_ne)
          have hmon_hom2 : (MvPolynomial.monomial s (F.coeff s)).IsHomogeneous (s i + s j) := by
            rw [hmon_decomp]
            have h0i : (MvPolynomial.C (F.coeff s) * T i ^ s i).IsHomogeneous (0 + s i) :=
              (MvPolynomial.isHomogeneous_C (Fin 2) _).mul
                (MvPolynomial.isHomogeneous_X_pow i (s i))
            rw [zero_add] at h0i
            exact h0i.mul (MvPolynomial.isHomogeneous_X_pow j (s j))
          exact MvPolynomial.IsHomogeneous.inj_right hmon_hom2 hmon_hom1 hmon_ne
        have hev_mon : ev_ij (MvPolynomial.monomial s (F.coeff s)) =
            Polynomial.C (F.coeff s) * Polynomial.X ^ s j := by
          rw [hmon_decomp s (F.coeff s), map_mul, map_mul, map_pow, map_pow,
            hev_Ti, hev_Tj, one_pow, mul_one]
          congr 1
          exact MvPolynomial.eval₂Hom_C _ _ (F.coeff s)
        rw [hev_mon, hmon_decomp s (F.coeff s)]
        have hφ_mon : φ_i (Polynomial.C (F.coeff s) * Polynomial.X ^ s j) =
            σ_i (F.coeff s) * t_ij ^ s j := by
          rw [map_mul, map_pow]
          congr 1
          · exact Polynomial.eval₂_C _ _
          · congr 1
            exact Polynomial.eval₂_X _ _
        rw [hφ_mon, map_mul, map_pow, ← hval_hom, ← hval_hom, hσ_val, ht_val]
        have hpow_mk : ∀ n : ℕ,
            (Localization.mk (T j) (⟨T i, Submonoid.mem_powers (T i)⟩ : S_i)) ^ n =
              Localization.mk (T j ^ n) ⟨T i ^ n, pow_mem (Submonoid.mem_powers (T i)) n⟩ := by
          intro n
          induction n with
          | zero =>
            rw [pow_zero, ← Localization.mk_one]
            congr 1
          | succ n ih =>
            rw [pow_succ, ih, Localization.mk_mul]
            congr 1
        rw [hpow_mk (s j), Localization.mk_mul, one_mul]
        rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_one, one_mul]
        rw [← hdeg_s, pow_add]
        ring
      let e_i : Polynomial κ ≃+* R_i :=
        { φ_i with
          invFun := ψ_i
          left_inv := hleft_inv
          right_inv := hright_inv }
      have he_X : e_i Polynomial.X = t_ij := Polynomial.eval₂_X _ _
      have he_symm_t : e_i.symm t_ij = Polynomial.X := by
        rw [← he_X, RingEquiv.symm_apply_apply]
      have he_C : ∀ c : κ, e_i (Polynomial.C c) = σ_i c :=
        fun c => Polynomial.eval₂_C _ _
      have he_symm_comm : e_i.symm.toRingHom.comp σ_i = algebraMap κ (Polynomial κ) := by
        apply RingHom.ext
        intro c
        change e_i.symm (σ_i c) = Polynomial.C c
        rw [← he_C c, RingEquiv.symm_apply_apply]
      exact ⟨e_i, he_X, he_symm_t, he_C, he_symm_comm⟩

    obtain ⟨e₀, he₀_X, he₀_symm_t, he₀_C, he₀_symm_comm⟩ :=
      hChartEquiv 0 1 (by decide)
    obtain ⟨e₁, he₁_X, he₁_symm_t, he₁_C, he₁_symm_comm⟩ :=
      hChartEquiv 1 0 (by decide)

    let ι₀_raw : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (T 0))) ⟶
        AlgebraicGeometry.Proj 𝒜 :=
      AlgebraicGeometry.Proj.awayι 𝒜 (T 0) (hT_mem 0) zero_lt_one
    let ι₁_raw : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (T 1))) ⟶
        AlgebraicGeometry.Proj 𝒜 :=
      AlgebraicGeometry.Proj.awayι 𝒜 (T 1) (hT_mem 1) zero_lt_one
    let ι₀_κ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ)) ⟶ AlgebraicGeometry.Proj 𝒜 :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) ≫ ι₀_raw
    let ι₁_κ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ)) ⟶ AlgebraicGeometry.Proj 𝒜 :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom) ≫ ι₁_raw

    have hSpecIso : ∀ {B₁ B₂ : Type u} [CommRing B₁] [CommRing B₂] (e : B₁ ≃+* B₂),
        CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom)) := by
      intro B₁ B₂ _ _ e
      refine ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom), ?_, ?_⟩⟩
      · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hid : e.toRingHom.comp e.symm.toRingHom = RingHom.id B₂ :=
          RingHom.ext e.apply_symm_apply
        rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hid : e.symm.toRingHom.comp e.toRingHom = RingHom.id B₁ :=
          RingHom.ext e.symm_apply_apply
        rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)) :=
      hSpecIso e₀.symm
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)) :=
      hSpecIso e₁.symm
    have : AlgebraicGeometry.IsOpenImmersion ι₀_κ := inferInstance
    have : AlgebraicGeometry.IsOpenImmersion ι₁_κ := inferInstance

    have hRange_ι₀_κ : Set.range ι₀_κ.base = (D 0 : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
      have hsurj : Function.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)).base :=
        (TopCat.homeoOfIso
          (AlgebraicGeometry.Scheme.forgetToTop.mapIso
            (CategoryTheory.asIso
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom))))).surjective
      have h1 : Set.range ι₀_κ.base = Set.range ι₀_raw.base := by
        change Set.range (ι₀_raw.base ∘
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)).base) = _
        exact hsurj.range_comp ι₀_raw.base
      have h2 : ι₀_raw.opensRange = D 0 :=
        AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (T 0) (hT_mem 0) zero_lt_one
      exact h1.trans (congrArg SetLike.coe h2)
    have hRange_ι₁_κ : Set.range ι₁_κ.base = (D 1 : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
      have hsurj : Function.Surjective
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)).base :=
        (TopCat.homeoOfIso
          (AlgebraicGeometry.Scheme.forgetToTop.mapIso
            (CategoryTheory.asIso
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom))))).surjective
      have h1 : Set.range ι₁_κ.base = Set.range ι₁_raw.base := by
        change Set.range (ι₁_raw.base ∘
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)).base) = _
        exact hsurj.range_comp ι₁_raw.base
      have h2 : ι₁_raw.opensRange = D 1 :=
        AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (T 1) (hT_mem 1) zero_lt_one
      exact h1.trans (congrArg SetLike.coe h2)

    have hHom_ι₀_κ : ι₀_κ ≫ P₁.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ (Polynomial κ))) := by
      dsimp [ι₀_κ, ι₀_raw, P₁, weilProjectiveSpaceOver]
      rw [CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜 (T 0) (hT_mem 0) zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      exact congrArg AlgebraicGeometry.Spec.map (congrArg CommRingCat.ofHom he₀_symm_comm)
    have hHom_ι₁_κ : ι₁_κ ≫ P₁.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ (Polynomial κ))) := by
      dsimp [ι₁_κ, ι₁_raw, P₁, weilProjectiveSpaceOver]
      rw [CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero_assoc 𝒜 (T 1) (hT_mem 1) zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      exact congrArg AlgebraicGeometry.Spec.map (congrArg CommRingCat.ofHom he₁_symm_comm)

    have hPre_ι₁_D0 : (TopologicalSpace.Opens.map ι₁_κ.base).obj (D 0) =
        PrimeSpectrum.basicOpen (Polynomial.X : Polynomial κ) := by
      have h1 : (TopologicalSpace.Opens.map ι₁_raw.base).obj (D 0) =
          PrimeSpectrum.basicOpen
            (HomogeneousLocalization.Away.isLocalizationElem (hT_mem 1) (hT_mem 0)) :=
        AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hT_mem 1) zero_lt_one
          (hT_mem 0) zero_lt_one
      have h2 : (TopologicalSpace.Opens.map ι₁_κ.base).obj (D 0) =
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)).base).obj
            ((TopologicalSpace.Opens.map ι₁_raw.base).obj (D 0)) := rfl
      rw [h2, h1, AlgebraicGeometry.SpecMap_preimage_basicOpen]
      change PrimeSpectrum.basicOpen
        (e₁.symm (HomogeneousLocalization.Away.isLocalizationElem (hT_mem 1) (hT_mem 0))) = _
      rw [he₁_symm_t]

    let L_κ := Localization.Away (Polynomial.X : Polynomial κ)
    let loc_κ : Polynomial κ →+* L_κ := algebraMap (Polynomial κ) L_κ
    let inv_κ : Polynomial κ →+* L_κ :=
      Polynomial.eval₂RingHom (loc_κ.comp Polynomial.C)
        (IsLocalization.Away.invSelf (Polynomial.X : Polynomial κ))
    have hOv_κ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_κ) ≫ ι₁_κ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_κ) ≫ ι₀_κ := by
      have hT01_mem : T 0 * T 1 ∈ 𝒜 2 := SetLike.mul_mem_graded (hT_mem 0) (hT_mem 1)
      let R₀₁ := HomogeneousLocalization.Away 𝒜 (T 0 * T 1)
      let S₀₁ := Submonoid.powers (T 0 * T 1)
      let ev₀₁ : MvPolynomial (Fin 2) κ →+* L_κ :=
        MvPolynomial.eval₂Hom (loc_κ.comp Polynomial.C)
          (Fin.cases (loc_κ Polynomial.X) (fun _ => 1))
      have hev₀₁_T0 : ev₀₁ (T 0) = loc_κ Polynomial.X := by
        dsimp [ev₀₁, T]
        rw [MvPolynomial.eval₂_X]
        rfl
      have hev₀₁_T1 : ev₀₁ (T 1) = 1 := by
        dsimp [ev₀₁, T]
        rw [MvPolynomial.eval₂_X]
        rfl
      have hev₀₁_pow : ∀ y : S₀₁, IsUnit (ev₀₁ y.1) := by
        rintro ⟨_, n, rfl⟩
        rw [map_pow, map_mul, hev₀₁_T0, hev₀₁_T1, mul_one]
        exact (IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial κ)).pow n
      let lift₀₁ : Localization S₀₁ →+* L_κ := IsLocalization.lift hev₀₁_pow
      let ψ₀₁ : R₀₁ →+* L_κ := lift₀₁.comp (algebraMap R₀₁ (Localization S₀₁))
      have hψ₀₁_mk : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) κ) (ha : a ∈ 𝒜 (n • 2)),
          ψ₀₁ (HomogeneousLocalization.Away.mk 𝒜 hT01_mem n a ha) =
            ev₀₁ a * (IsLocalization.Away.invSelf (Polynomial.X : Polynomial κ)) ^ n := by
        intro n a ha
        change lift₀₁ (algebraMap R₀₁ (Localization S₀₁)
          (HomogeneousLocalization.Away.mk 𝒜 hT01_mem n a ha)) = _
        rw [HomogeneousLocalization.algebraMap_apply]
        change lift₀₁ (Localization.mk a
          ⟨(T 0 * T 1) ^ n, pow_mem (Submonoid.mem_powers (T 0 * T 1)) n⟩) = _
        rw [Localization.mk_eq_mk'_apply, IsLocalization.lift_mk'_spec]
        change ev₀₁ a = ev₀₁ ((T 0 * T 1) ^ n) *
          (ev₀₁ a * (IsLocalization.Away.invSelf (Polynomial.X : Polynomial κ)) ^ n)
        rw [map_pow, map_mul, hev₀₁_T0, hev₀₁_T1, mul_one,
          mul_comm (loc_κ Polynomial.X ^ n), mul_assoc, ← mul_pow,
          mul_comm (IsLocalization.Away.invSelf (Polynomial.X : Polynomial κ)) (loc_κ Polynomial.X),
          IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial κ), one_pow, mul_one]
      let aw₁ : HomogeneousLocalization.Away 𝒜 (T 1) →+* R₀₁ :=
        HomogeneousLocalization.awayMap 𝒜 (hT_mem 0) (mul_comm (T 0) (T 1))
      let aw₀ : HomogeneousLocalization.Away 𝒜 (T 0) →+* R₀₁ :=
        HomogeneousLocalization.awayMap 𝒜 (hT_mem 1) rfl
      have haw₁_comp : (ψ₀₁.comp aw₁).comp e₁.toRingHom = loc_κ := by
        apply Polynomial.ringHom_ext
        · intro c
          change ψ₀₁ (aw₁ (e₁ (Polynomial.C c))) = loc_κ (Polynomial.C c)
          rw [he₁_C c]
          have hmk0 : (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T 1)))
              (algebraMap κ ↥(𝒜 0) c) =
              HomogeneousLocalization.Away.mk 𝒜 (hT_mem 1) 0 (MvPolynomial.C c)
                (by rw [zero_smul, MvPolynomial.mem_homogeneousSubmodule];
                    exact MvPolynomial.isHomogeneous_C _ c) := by
            apply HomogeneousLocalization.val_injective (Submonoid.powers (T 1))
            have hL : ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T 1)))
                (algebraMap κ ↥(𝒜 0) c)).val =
                Localization.mk (MvPolynomial.C c) (1 : Submonoid.powers (T 1)) := by
              change algebraMap (HomogeneousLocalization.Away 𝒜 (T 1))
                (Localization (Submonoid.powers (T 1)))
                (algebraMap ↥(𝒜 0) _ (algebraMap κ ↥(𝒜 0) c)) = _
              rw [← IsScalarTower.algebraMap_apply]
              rfl
            rw [hL]
            change Localization.mk (MvPolynomial.C c) (1 : Submonoid.powers (T 1)) =
              Localization.mk (MvPolynomial.C c)
                ⟨T 1 ^ 0, pow_mem (Submonoid.mem_powers (T 1)) 0⟩
            rfl
          rw [hmk0, HomogeneousLocalization.awayMap_mk, hψ₀₁_mk]
          simp only [pow_zero, mul_one]
          exact MvPolynomial.eval₂Hom_C _ _ c
        · change ψ₀₁ (aw₁ (e₁ Polynomial.X)) = loc_κ Polynomial.X
          rw [he₁_X]
          have hmk1 : HomogeneousLocalization.Away.isLocalizationElem (hT_mem 1) (hT_mem 0) =
              HomogeneousLocalization.Away.mk 𝒜 (hT_mem 1) 1 (T 0)
                (by rw [one_smul]; exact hT_mem 0) := by
            apply HomogeneousLocalization.val_injective (Submonoid.powers (T 1))
            change Localization.mk (T 0 ^ 1) ⟨T 1 ^ 1, pow_mem (Submonoid.mem_powers (T 1)) 1⟩ =
              Localization.mk (T 0) ⟨T 1 ^ 1, pow_mem (Submonoid.mem_powers (T 1)) 1⟩
            congr 1
            exact pow_one _
          rw [hmk1, HomogeneousLocalization.awayMap_mk, hψ₀₁_mk]
          rw [pow_one, pow_one, map_mul, hev₀₁_T0, mul_assoc,
            IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial κ), mul_one]
      have haw₀_comp : (ψ₀₁.comp aw₀).comp e₀.toRingHom = inv_κ := by
        apply Polynomial.ringHom_ext
        · intro c
          change ψ₀₁ (aw₀ (e₀ (Polynomial.C c))) = inv_κ (Polynomial.C c)
          rw [he₀_C c]
          have hmk0 : (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T 0)))
              (algebraMap κ ↥(𝒜 0) c) =
              HomogeneousLocalization.Away.mk 𝒜 (hT_mem 0) 0 (MvPolynomial.C c)
                (by rw [zero_smul, MvPolynomial.mem_homogeneousSubmodule];
                    exact MvPolynomial.isHomogeneous_C _ c) := by
            apply HomogeneousLocalization.val_injective (Submonoid.powers (T 0))
            have hL : ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (T 0)))
                (algebraMap κ ↥(𝒜 0) c)).val =
                Localization.mk (MvPolynomial.C c) (1 : Submonoid.powers (T 0)) := by
              change algebraMap (HomogeneousLocalization.Away 𝒜 (T 0))
                (Localization (Submonoid.powers (T 0)))
                (algebraMap ↥(𝒜 0) _ (algebraMap κ ↥(𝒜 0) c)) = _
              rw [← IsScalarTower.algebraMap_apply]
              rfl
            rw [hL]
            change Localization.mk (MvPolynomial.C c) (1 : Submonoid.powers (T 0)) =
              Localization.mk (MvPolynomial.C c)
                ⟨T 0 ^ 0, pow_mem (Submonoid.mem_powers (T 0)) 0⟩
            rfl
          rw [hmk0, HomogeneousLocalization.awayMap_mk, hψ₀₁_mk]
          simp only [pow_zero, mul_one, inv_κ, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
          exact MvPolynomial.eval₂Hom_C _ _ c
        · change ψ₀₁ (aw₀ (e₀ Polynomial.X)) = inv_κ Polynomial.X
          rw [he₀_X]
          have hmk1 : HomogeneousLocalization.Away.isLocalizationElem (hT_mem 0) (hT_mem 1) =
              HomogeneousLocalization.Away.mk 𝒜 (hT_mem 0) 1 (T 1)
                (by rw [one_smul]; exact hT_mem 1) := by
            apply HomogeneousLocalization.val_injective (Submonoid.powers (T 0))
            change Localization.mk (T 1 ^ 1) ⟨T 0 ^ 1, pow_mem (Submonoid.mem_powers (T 0)) 1⟩ =
              Localization.mk (T 1) ⟨T 0 ^ 1, pow_mem (Submonoid.mem_powers (T 0)) 1⟩
            congr 1
            exact pow_one _
          rw [hmk1, HomogeneousLocalization.awayMap_mk, hψ₀₁_mk]
          simp only [pow_one, map_mul, hev₀₁_T1, one_mul, inv_κ,
            Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      have hmor₁ : CommRingCat.ofHom e₁.symm.toRingHom ≫ CommRingCat.ofHom loc_κ =
          CommRingCat.ofHom aw₁ ≫ CommRingCat.ofHom ψ₀₁ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        have h1 := congrArg (fun f => f (e₁.symm z)) haw₁_comp.symm
        change loc_κ (e₁.symm z) = ψ₀₁ (aw₁ (e₁ (e₁.symm z))) at h1
        rw [e₁.apply_symm_apply] at h1
        exact h1
      have hmor₀ : CommRingCat.ofHom e₀.symm.toRingHom ≫ CommRingCat.ofHom inv_κ =
          CommRingCat.ofHom aw₀ ≫ CommRingCat.ofHom ψ₀₁ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        have h1 := congrArg (fun f => f (e₀.symm z)) haw₀_comp.symm
        change inv_κ (e₀.symm z) = ψ₀₁ (aw₀ (e₀ (e₀.symm z))) at h1
        rw [e₀.apply_symm_apply] at h1
        exact h1
      have hSpec₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom aw₁) ≫ ι₁_raw =
          AlgebraicGeometry.Proj.awayι 𝒜 (T 0 * T 1) hT01_mem (by decide) :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hT_mem 1) zero_lt_one (hT_mem 0)
          (mul_comm (T 0) (T 1))
      have hSpec₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom aw₀) ≫ ι₀_raw =
          AlgebraicGeometry.Proj.awayι 𝒜 (T 0 * T 1) hT01_mem (by decide) :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 (hT_mem 0) zero_lt_one (hT_mem 1) rfl
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_κ) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom) ≫ ι₁_raw) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_κ) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) ≫ ι₀_raw)
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        hmor₁, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hSpec₁,
        ← hSpec₀, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← hmor₀, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]

    let s_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ A))
    let p₁ : X_A ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      CategoryTheory.Limits.pullback.fst s_A P₁.hom
    let p₂ : X_A ⟶ P₁.left :=
      CategoryTheory.Limits.pullback.snd s_A P₁.hom

    have hSep_P₁_hom : AlgebraicGeometry.IsSeparated P₁.hom := by
      dsimp [P₁, weilProjectiveSpaceOver]
      infer_instance
    have : AlgebraicGeometry.IsSeparated p₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback s_A P₁.hom).flip hSep_P₁_hom
    have hSep_XA : AlgebraicGeometry.Scheme.IsSeparated X_A := by
      have hterm : p₁ ≫ CategoryTheory.Limits.terminal.from
          (AlgebraicGeometry.Spec (CommRingCat.of A)) =
          CategoryTheory.Limits.terminal.from X_A :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      have hsep_comp : AlgebraicGeometry.IsSeparated
          (CategoryTheory.Limits.terminal.from X_A) := by
        rw [← hterm]
        infer_instance
      exact AlgebraicGeometry.Scheme.IsSeparated.mk hsep_comp
    have : AlgebraicGeometry.Scheme.IsSeparated X_A := hSep_XA

    let inl_P : CommRingCat.of A ⟶ CommRingCat.of (Polynomial A) :=
      CommRingCat.ofHom Polynomial.C
    let inr_P : CommRingCat.of (Polynomial κ) ⟶ CommRingCat.of (Polynomial A) :=
      CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap κ A))
    have hPolyPushout : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap κ A))
        (CommRingCat.ofHom (algebraMap κ (Polynomial κ)))
        inl_P inr_P := by
      have hw : CommRingCat.ofHom (algebraMap κ A) ≫ inl_P =
          CommRingCat.ofHom (algebraMap κ (Polynomial κ)) ≫ inr_P := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro c
        change Polynomial.C (algebraMap κ A c) =
          (Polynomial.mapRingHom (algebraMap κ A)) (Polynomial.C c)
        simp
      refine CategoryTheory.IsPushout.of_isColimit (c := CategoryTheory.Limits.PushoutCocone.mk inl_P inr_P hw) ?_
      refine CategoryTheory.Limits.PushoutCocone.isColimitAux' _ (fun sc => ?_)
      let desc_hom : Polynomial A →+* ↑sc.pt :=
        Polynomial.eval₂RingHom sc.inl.hom (sc.inr.hom Polynomial.X)
      refine ⟨CommRingCat.ofHom desc_hom, ?_, ?_, ?_⟩
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        exact Polynomial.eval₂_C _ _
      · apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext
        · intro c
          have hsc := congrArg (fun φ => φ.hom c) sc.condition
          change desc_hom (Polynomial.map (algebraMap κ A) (Polynomial.C c)) =
            sc.inr.hom (Polynomial.C c)
          rw [Polynomial.map_C]
          exact (Polynomial.eval₂_C _ _).trans hsc
        · change desc_hom (Polynomial.map (algebraMap κ A) Polynomial.X) =
            sc.inr.hom Polynomial.X
          rw [Polynomial.map_X]
          exact Polynomial.eval₂_X _ _
      · intro m hm_inl hm_inr
        let m' : CommRingCat.of (Polynomial A) ⟶ sc.pt := m
        apply CommRingCat.hom_ext
        apply Polynomial.ringHom_ext
        · intro a
          have ha := congrArg (fun φ => φ.hom a) hm_inl
          exact ha.trans (Polynomial.eval₂_C _ _).symm
        · have hX := congrArg (fun φ => φ.hom Polynomial.X) hm_inr
          change m'.hom Polynomial.X = desc_hom Polynomial.X
          have hdescX : desc_hom Polynomial.X = sc.inr.hom Polynomial.X :=
            Polynomial.eval₂_X _ _
          have hmX : (inr_P ≫ m').hom Polynomial.X = m'.hom Polynomial.X := by
            change m'.hom (Polynomial.map (algebraMap κ A) Polynomial.X) = m'.hom Polynomial.X
            rw [Polynomial.map_X]
          exact (hmX.symm.trans hX).trans hdescX.symm

    have hSpecPolyPb : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map inr_P)
        (AlgebraicGeometry.Spec.map inl_P)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ (Polynomial κ))))
        s_A :=
      (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPolyPushout).flip

    let ι₀_P1 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ)) ⟶ P₁.left := ι₀_κ
    let ι₁_P1 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ)) ⟶ P₁.left := ι₁_κ
    have hOpen_ι₀ : AlgebraicGeometry.IsOpenImmersion ι₀_P1 := ‹AlgebraicGeometry.IsOpenImmersion ι₀_κ›
    have hOpen_ι₁ : AlgebraicGeometry.IsOpenImmersion ι₁_P1 := ‹AlgebraicGeometry.IsOpenImmersion ι₁_κ›
    let D_P1 : Fin 2 → P₁.left.Opens := D
    have hHom_ι₀_P1 : ι₀_P1 ≫ P₁.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ (Polynomial κ))) := hHom_ι₀_κ
    have hHom_ι₁_P1 : ι₁_P1 ≫ P₁.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap κ (Polynomial κ))) := hHom_ι₁_κ
    have hRange_ι₀_P1 : Set.range ι₀_P1.base = (D_P1 0 : Set ↥P₁.left) := hRange_ι₀_κ
    have hRange_ι₁_P1 : Set.range ι₁_P1.base = (D_P1 1 : Set ↥P₁.left) := hRange_ι₁_κ
    have hD_P1_cov : (D_P1 0 : Set ↥P₁.left) ∪ (D_P1 1 : Set ↥P₁.left) = Set.univ := hD_cov
    have hOv_P1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_κ) ≫ ι₁_P1 =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_κ) ≫ ι₀_P1 := hOv_κ
    have hPre_ι₁_D0_P1 : (TopologicalSpace.Opens.map ι₁_P1.base).obj (D_P1 0) =
        PrimeSpectrum.basicOpen (Polynomial.X : Polynomial κ) := hPre_ι₁_D0

    have hcomm_j₀ : AlgebraicGeometry.Spec.map inl_P ≫ s_A =
        (AlgebraicGeometry.Spec.map inr_P ≫ ι₀_P1) ≫ P₁.hom := by
      rw [CategoryTheory.Category.assoc, hHom_ι₀_P1]
      exact hSpecPolyPb.w.symm
    have hcomm_j₁ : AlgebraicGeometry.Spec.map inl_P ≫ s_A =
        (AlgebraicGeometry.Spec.map inr_P ≫ ι₁_P1) ≫ P₁.hom := by
      rw [CategoryTheory.Category.assoc, hHom_ι₁_P1]
      exact hSpecPolyPb.w.symm

    let j₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) ⟶ X_A :=
      CategoryTheory.Limits.pullback.lift (AlgebraicGeometry.Spec.map inl_P)
        (AlgebraicGeometry.Spec.map inr_P ≫ ι₀_P1) hcomm_j₀
    let j₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) ⟶ X_A :=
      CategoryTheory.Limits.pullback.lift (AlgebraicGeometry.Spec.map inl_P)
        (AlgebraicGeometry.Spec.map inr_P ≫ ι₁_P1) hcomm_j₁

    have hPb_j₀ : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map inr_P) j₀ ι₀_P1 p₂ := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback s_A P₁.hom).flip
      · have hf₁ : j₀ ≫ p₁ = AlgebraicGeometry.Spec.map inl_P :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [hf₁, hHom_ι₀_P1]
        exact hSpecPolyPb
      · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    have hPb_j₁ : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map inr_P) j₁ ι₁_P1 p₂ := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback s_A P₁.hom).flip
      · have hf₁ : j₁ ≫ p₁ = AlgebraicGeometry.Spec.map inl_P :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [hf₁, hHom_ι₁_P1]
        exact hSpecPolyPb
      · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm

    have hj₀_open : AlgebraicGeometry.IsOpenImmersion j₀ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_j₀ hOpen_ι₀
    have hj₁_open : AlgebraicGeometry.IsOpenImmersion j₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_j₁ hOpen_ι₁
    have : AlgebraicGeometry.IsOpenImmersion j₀ := hj₀_open
    have : AlgebraicGeometry.IsOpenImmersion j₁ := hj₁_open

    have hRange_j₀ : Set.range j₀.base = p₂.base ⁻¹' (D_P1 0 : Set ↥P₁.left) := by
      rw [← hRange_ι₀_P1]
      ext x
      constructor
      · rintro ⟨q, rfl⟩
        have hcomm : j₀ ≫ p₂ = AlgebraicGeometry.Spec.map inr_P ≫ ι₀_P1 :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        exact ⟨(AlgebraicGeometry.Spec.map inr_P).base q,
          (congrArg (fun φ => φ.base q) hcomm).symm⟩
      · rintro ⟨y, hy⟩
        obtain ⟨z, _, hz⟩ := hExistsPreimagePb hPb_j₀ y x hy
        exact ⟨z, hz⟩
    have hRange_j₁ : Set.range j₁.base = p₂.base ⁻¹' (D_P1 1 : Set ↥P₁.left) := by
      rw [← hRange_ι₁_P1]
      ext x
      constructor
      · rintro ⟨q, rfl⟩
        have hcomm : j₁ ≫ p₂ = AlgebraicGeometry.Spec.map inr_P ≫ ι₁_P1 :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        exact ⟨(AlgebraicGeometry.Spec.map inr_P).base q,
          (congrArg (fun φ => φ.base q) hcomm).symm⟩
      · rintro ⟨y, hy⟩
        obtain ⟨z, _, hz⟩ := hExistsPreimagePb hPb_j₁ y x hy
        exact ⟨z, hz⟩
    have hCov_XA : Set.range j₀.base ∪ Set.range j₁.base = Set.univ := by
      rw [hRange_j₀, hRange_j₁, ← Set.preimage_union, hD_P1_cov, Set.preimage_univ]

    have hOv_A_comm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A) ≫ j₁ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_A) ≫ j₀ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        have hf₁ : j₁ ≫ p₁ = AlgebraicGeometry.Spec.map inl_P :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hf₀ : j₀ ≫ p₁ = AlgebraicGeometry.Spec.map inl_P :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [hf₁, hf₀, ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 2
        ext a
        simp [loc_A, inv_A]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        have hs₁ : j₁ ≫ p₂ = AlgebraicGeometry.Spec.map inr_P ≫ ι₁_P1 :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have hs₀ : j₀ ≫ p₂ = AlgebraicGeometry.Spec.map inr_P ≫ ι₀_P1 :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        rw [hs₁, hs₀, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        have hUnit_X : IsUnit ((loc_A.comp inr_P.hom) Polynomial.X) := by
          change IsUnit (loc_A (Polynomial.map (algebraMap κ A) Polynomial.X))
          rw [Polynomial.map_X]
          exact IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial A)
        let away_κA : L_κ →+* Localization.Away (Polynomial.X : Polynomial A) :=
          IsLocalization.Away.lift (Polynomial.X : Polynomial κ) hUnit_X
        have haw_eq : ∀ p : Polynomial κ, away_κA (loc_κ p) = loc_A (inr_P.hom p) :=
          fun p => IsLocalization.Away.lift_eq (Polynomial.X : Polynomial κ) hUnit_X p
        have hloc_comm : away_κA.comp loc_κ = loc_A.comp inr_P.hom :=
          RingHom.ext haw_eq
        have hinv_comm : away_κA.comp inv_κ = inv_A.comp inr_P.hom := by
          apply Polynomial.ringHom_ext
          · intro c
            change away_κA (inv_κ (Polynomial.C c)) = inv_A (inr_P.hom (Polynomial.C c))
            have h1 : inv_κ (Polynomial.C c) = loc_κ (Polynomial.C c) := by simp [inv_κ]
            have h2 : inr_P.hom (Polynomial.C c) = Polynomial.C (algebraMap κ A c) := by
              simp [inr_P]
            rw [h1, haw_eq, h2]
            simp [inv_A]
          · change away_κA (inv_κ Polynomial.X) = inv_A (inr_P.hom Polynomial.X)
            have h1 : inv_κ Polynomial.X =
                IsLocalization.Away.invSelf (Polynomial.X : Polynomial κ) := by simp [inv_κ]
            have h2 : inr_P.hom Polynomial.X = Polynomial.X := by simp [inr_P]
            rw [h1, h2]
            have h3 : inv_A Polynomial.X =
                IsLocalization.Away.invSelf (Polynomial.X : Polynomial A) := by simp [inv_A]
            rw [h3]
            apply (IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial A)).mul_left_cancel
            have hmul_κ : loc_κ Polynomial.X *
                IsLocalization.Away.invSelf (Polynomial.X : Polynomial κ) = 1 :=
              IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial κ)
            have hmul_app := congrArg away_κA hmul_κ
            rw [map_mul, map_one, haw_eq Polynomial.X] at hmul_app
            have hX_map : inr_P.hom Polynomial.X = Polynomial.X := by simp [inr_P]
            rw [hX_map] at hmul_app
            exact hmul_app.trans (IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial A)).symm
        have hmor₁ : inr_P ≫ CommRingCat.ofHom loc_A =
            CommRingCat.ofHom loc_κ ≫ CommRingCat.ofHom away_κA := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hloc_comm]
        have hmor₀ : inr_P ≫ CommRingCat.ofHom inv_A =
            CommRingCat.ofHom inv_κ ≫ CommRingCat.ofHom away_κA := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hinv_comm]
        rw [hmor₁, hmor₀, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hOv_P1]

    have hLocRange_A : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A)).base =
        (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial A)).1 := by
      change Set.range (PrimeSpectrum.comap loc_A) =
        (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial A) : Set (PrimeSpectrum (Polynomial A)))
      exact PrimeSpectrum.localization_away_comap_range
        (Localization.Away (Polynomial.X : Polynomial A)) (Polynomial.X : Polynomial A)

    have hRange_loc_A : Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A)).base =
        j₁.base ⁻¹' Set.range j₀.base := by
      have h2 : j₁.base ⁻¹' Set.range j₀.base =
          (j₁ ≫ p₂).base ⁻¹' (D_P1 0 : Set ↥P₁.left) := by
        rw [hRange_j₀]
        rfl
      have hs₁ : j₁ ≫ p₂ = AlgebraicGeometry.Spec.map inr_P ≫ ι₁_P1 :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h3 : (AlgebraicGeometry.Spec.map inr_P ≫ ι₁_P1).base ⁻¹'
          (D_P1 0 : Set ↥P₁.left) =
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map inr_P).base).obj
            ((TopologicalSpace.Opens.map ι₁_P1.base).obj (D_P1 0)) : Set _) := rfl
      rw [hLocRange_A, h2, hs₁, h3, hPre_ι₁_D0_P1, AlgebraicGeometry.SpecMap_preimage_basicOpen]
      have hX_map : inr_P.hom Polynomial.X = Polynomial.X := by simp [inr_P]
      rw [hX_map]
      rfl

    have hPb_ov : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_A))
        j₁ j₀ :=
      hOpenPb _ _ _ _ hOv_A_comm hRange_loc_A

    let i₁ : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev0_A)
    let i_inf : AlgebraicGeometry.Spec (CommRingCat.of A) ⟶ X_A := i₁ ≫ j₁
    have hi_inf_sec : i_inf ≫ p₁ =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of A)) := by
      dsimp [i_inf, i₁]
      rw [CategoryTheory.Category.assoc]
      have hf₁ : j₁ ≫ p₁ = AlgebraicGeometry.Spec.map inl_P :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [hf₁, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      have hid : ev0_A.comp Polynomial.C = RingHom.id A := by
        ext a
        exact Polynomial.eval₂_C _ _
      rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    have hi_inf_closed : AlgebraicGeometry.IsClosedImmersion i_inf := by
      have : AlgebraicGeometry.IsClosedImmersion (i_inf ≫ p₁) := by
        rw [hi_inf_sec]
        infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp i_inf p₁

    have hRange_i₁ : Set.range i₁.base =
        (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A)).base)ᶜ := by
      have hsurj : Function.Surjective ev0_A :=
        fun a => ⟨Polynomial.C a, Polynomial.eval₂_C _ _⟩
      have h1 : Set.range i₁.base =
          (PrimeSpectrum.zeroLocus (RingHom.ker ev0_A : Set (Polynomial A)) :
            Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)))) :=
        range_comap_of_surjective A ev0_A hsurj
      have hker : RingHom.ker ev0_A = Ideal.span {(Polynomial.X : Polynomial A)} := by
        ext P
        rw [RingHom.mem_ker, Ideal.mem_span_singleton]
        constructor
        · intro hP0
          refine ⟨P.divX, ?_⟩
          have hdiv := Polynomial.X_mul_divX_add P
          have hev := congrArg ev0_A hdiv
          rw [map_add, map_mul, hP0] at hev
          have hX0 : ev0_A Polynomial.X = 0 := Polynomial.eval₂_X (RingHom.id A) 0
          have hC0 : ev0_A (Polynomial.C (P.coeff 0)) = P.coeff 0 :=
            Polynomial.eval₂_C _ _
          rw [hX0, zero_mul, zero_add, hC0] at hev
          rw [hev, Polynomial.C_0, add_zero] at hdiv
          exact hdiv.symm
        · rintro ⟨Q, rfl⟩
          simp [ev0_A]
      rw [h1, hker, hLocRange_A]
      ext q
      change (Ideal.span {(Polynomial.X : Polynomial A)} : Set (Polynomial A)) ⊆ q.asIdeal ↔
        q ∉ PrimeSpectrum.basicOpen (Polynomial.X : Polynomial A)
      simp [Ideal.span_le, PrimeSpectrum.mem_basicOpen]

    have hRange_compl : Set.range j₀.base = (Set.range i_inf.base)ᶜ := by
      ext x
      simp only [Set.mem_compl_iff]
      constructor
      · intro hx0 ⟨p, hp⟩
        rcases hx0 with ⟨q₀, rfl⟩
        have hcomm : j₁.base (i₁.base p) = j₀.base q₀ := hp
        obtain ⟨z, hz₁, _⟩ := hExistsPreimagePb hPb_ov (i₁.base p) q₀ hcomm
        have hmem_loc : i₁.base p ∈
            Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A)).base := ⟨z, hz₁⟩
        have hmem_i₁ : i₁.base p ∈ Set.range i₁.base := ⟨p, rfl⟩
        rw [hRange_i₁] at hmem_i₁
        exact hmem_i₁ hmem_loc
      · intro hnot_inf
        by_contra hnot_j₀
        have hx_cov : x ∈ Set.range j₀.base ∪ Set.range j₁.base := by
          rw [hCov_XA]
          trivial
        rcases hx_cov with hx0 | ⟨q₁, rfl⟩
        · exact hnot_j₀ hx0
        · have hnot_loc : q₁ ∉
              Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom loc_A)).base := by
            rintro ⟨z, rfl⟩
            apply hnot_j₀
            refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom inv_A)).base z, ?_⟩
            exact (congrArg (fun φ => φ.base z) hOv_A_comm).symm
          have hmem_i₁ : q₁ ∈ Set.range i₁.base := by
            rw [hRange_i₁]
            exact hnot_loc
          rcases hmem_i₁ with ⟨p, rfl⟩
          exact hnot_inf ⟨p, rfl⟩

    exact ⟨j₀, j₁, hj₀_open, hj₁_open, i_inf, hi_inf_closed, hSep_XA,
      hPb_ov, rfl, hRange_compl⟩

  
  have hOpenRPush : ∀ {Y S : AlgebraicGeometry.Scheme.{u}}
      (j : Quiver.Hom Y S) [AlgebraicGeometry.IsOpenImmersion j]
      (ℓ₀ r : ℕ)
      (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}),
      (ℓ₀ • CategoryTheory.CategoryStruct.id ℱ = 0 →
        ℓ₀ • CategoryTheory.CategoryStruct.id (weilAltCdHigherDirectImage j r ℱ) = 0) ∧
      (1 ≤ r →
        ∀ (U : S.Etale),
          Set.range U.hom.base ⊆ Set.range j.base →
          Subsingleton ↥((weilAltCdHigherDirectImage j r ℱ).obj.obj (Opposite.op U))) := by
    intro Y S j _ ℓ₀ r ℱ
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) j :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) j :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_j : CategoryTheory.Functor S.Etale Y.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j
    refine ⟨?_, ?_⟩
    · intro hℓ₀
      have hExtTorsion : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
          [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
          (X₀ Y₀ : C_ab) (r₀ : ℕ),
          ℓ₀ • CategoryTheory.CategoryStruct.id Y₀ = 0 →
          ∀ z : CategoryTheory.Abelian.Ext.{u} X₀ Y₀ r₀, ℓ₀ • z = 0 := by
        intro C_ab _ _ _ X₀ Y₀ r₀ hY z
        have hnsmul : ∀ c : ℕ,
            c • z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (c • CategoryTheory.CategoryStruct.id Y₀))
              (Nat.add_zero r₀) := by
          intro c
          induction c with
          | zero =>
            rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
              CategoryTheory.Abelian.Ext.comp_zero]
          | succ c ih =>
            rw [succ_nsmul, succ_nsmul, ih, CategoryTheory.Abelian.Ext.mk₀_add,
              CategoryTheory.Abelian.Ext.comp_add, CategoryTheory.Abelian.Ext.comp_mk₀_id]
        rw [hnsmul ℓ₀, hY, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      let P : CategoryTheory.Functor (S.Etale)ᵒᵖ AddCommGrpCat.{u} :=
        CategoryTheory.Functor.comp B_j.op (CategoryTheory.Sheaf.cohomologyPresheaf ℱ r)
      have hP : ℓ₀ • CategoryTheory.CategoryStruct.id P = 0 := by
        ext opU z
        simp only [CategoryTheory.NatTrans.app_nsmul, CategoryTheory.NatTrans.id_app,
          CategoryTheory.NatTrans.app_zero, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id,
          AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
          AddMonoidHom.zero_apply]
        dsimp [P, CategoryTheory.Sheaf.cohomologyPresheaf,
          CategoryTheory.Sheaf.cohomologyPresheafFunctor] at z ⊢
        exact hExtTorsion _ ℱ r hℓ₀ z
      let Shf := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
      change ℓ₀ • CategoryTheory.CategoryStruct.id (Shf.obj P) = 0
      rw [← Shf.map_id, ← CategoryTheory.Functor.map_nsmul, hP, CategoryTheory.Functor.map_zero]
    · intro hr U hU_range
      obtain ⟨k, rfl⟩ : ∃ k : ℕ, r = k + 1 := ⟨r - 1, by omega⟩
      clear hr
      let J_Y := Y.smallEtaleTopology
      let F_left :=
        (CategoryTheory.Functor.whiskeringRight (Y.Etale)ᵒᵖ (Type u) AddCommGrpCat.{u}).obj
          AddCommGrpCat.free ⋙
        CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}
      let L_fun : Y.Etale ⥤ CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
        CategoryTheory.yoneda ⋙ F_left
      let adj_free := AddCommGrpCat.adj.{u}.whiskerRight (Y.Etale)ᵒᵖ
      let adj_shf := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
      let adj_tot := adj_free.comp adj_shf
      let Φ : ∀ (W : Y.Etale) (M : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
          (L_fun.obj W ⟶ M) ≃ ↥(M.obj.obj (Opposite.op W)) :=
        fun W M => (adj_tot.homEquiv (CategoryTheory.yoneda.obj W) M).trans CategoryTheory.yonedaEquiv
      have hΦ_nat_M : ∀ (W : Y.Etale) {M₁ M₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
          (π : M₁ ⟶ M₂) (g : L_fun.obj W ⟶ M₁),
          Φ W M₂ (g ≫ π) = (π.hom.app (Opposite.op W)).hom (Φ W M₁ g) := by
        intro W M₁ M₂ π g
        dsimp [Φ]
        rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        rfl
      have hΦ_nat_W : ∀ {W' W : Y.Etale} (u : W' ⟶ W)
          (M : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (g : L_fun.obj W ⟶ M),
          Φ W' M (L_fun.map u ≫ g) = (M.obj.map (Opposite.op u)).hom (Φ W M g) := by
        intro W' W u M g
        dsimp [Φ]
        have hmap : L_fun.map u = F_left.map (CategoryTheory.yoneda.map u) := rfl
        rw [hmap, CategoryTheory.Adjunction.homEquiv_naturality_left]
        let α := adj_tot.homEquiv (CategoryTheory.yoneda.obj W) M g
        change (CategoryTheory.yoneda.map u ≫ α).app (Opposite.op W') (𝟙 W') =
          (M.obj.map (Opposite.op u)).hom (α.app (Opposite.op W) (𝟙 W))
        have hnat := CategoryTheory.congr_fun (α.naturality (Opposite.op u)) (𝟙 W)
        dsimp at hnat ⊢
        rw [CategoryTheory.Category.comp_id] at hnat
        rw [CategoryTheory.Category.id_comp]
        exact hnat
      have hEfface : ∀ (m : ℕ) (𝒢 : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
          (W : Y.Etale) (z : ↥((𝒢.cohomologyPresheaf (m + 1)).obj (Opposite.op W))),
          ∃ R_W ∈ J_Y W, ∀ {W' : Y.Etale} (u : W' ⟶ W),
            R_W.arrows u → (𝒢.cohomologyPresheaf (m + 1)).map (Opposite.op u) z = 0 := by
        intro m
        induction m with
        | zero =>
          intro 𝒢 W z
          let ι : 𝒢 ⟶ CategoryTheory.Injective.under 𝒢 := CategoryTheory.Injective.ι 𝒢
          let I := CategoryTheory.Injective.under 𝒢
          let Q := CategoryTheory.Limits.cokernel ι
          let π : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
          have hιπ : ι ≫ π = 0 := CategoryTheory.Limits.cokernel.condition ι
          have hSE : (CategoryTheory.ShortComplex.mk ι π hιπ).ShortExact :=
            CategoryTheory.ShortComplex.ShortExact.mk'
              (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
                (CategoryTheory.Limits.cokernelIsCokernel ι))
              inferInstance inferInstance
          change CategoryTheory.Abelian.Ext.{u} (L_fun.obj W) 𝒢 1 at z
          have hz_I : z.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero 1) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y₀, hy₀⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (L_fun.obj W) hSE z hz_I
              (Nat.zero_add 1)
          obtain ⟨g, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective (L_fun.obj W) Q).2 y₀
          let q₀ : ↥(Q.obj.obj (Opposite.op W)) := Φ W Q g
          have : CategoryTheory.Presheaf.IsLocallySurjective J_Y π.hom :=
            (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
          have hR_mem : CategoryTheory.Presheaf.imageSieve π.hom q₀ ∈ J_Y W :=
            CategoryTheory.Presheaf.imageSieve_mem J_Y π.hom q₀
          refine ⟨CategoryTheory.Presheaf.imageSieve π.hom q₀, hR_mem, ?_⟩
          intro W' u hu
          obtain ⟨i', hi'⟩ := hu
          let g' : L_fun.obj W' ⟶ I := (Φ W' I).symm i'
