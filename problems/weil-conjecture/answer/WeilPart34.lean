        Equiv.apply_symm_apply _ _
      have h_nat := congrArg (fun m => m.hom s_p0) (((η_id_hom R₀).hom).naturality u_eid.op)
      have h_step : ((η_id_hom R₀).hom.app (Opposite.op U'))
