  have hPolyTrans : ∀ (a : k),
      let sh_pos : Polynomial k →+* Polynomial k :=
        (Polynomial.aeval (Polynomial.X + Polynomial.C a)).toRingHom
      let τ_a : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom sh_pos)
      let s_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U₀ :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))
      CategoryTheory.IsIso τ_a ∧
      τ_a ≫ p_A1 = p_A1 ∧
      s₀ ≫ τ_a = s_a ∧
      RingHom.ker ((AlgebraicGeometry.Spec.preimage (η ≫ τ_a)).hom) = ⊥ ∧
      τ_a.base (⊥ : PrimeSpectrum (Polynomial k)) = (⊥ : PrimeSpectrum (Polynomial k)) := by
    intro a sh_pos τ_a s_a
    let sh_neg : Polynomial k →+* Polynomial k :=
      (Polynomial.aeval (Polynomial.X - Polynomial.C a)).toRingHom
    have hcomp1 : sh_pos.comp sh_neg = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [sh_pos, sh_neg]
      · simp [sh_pos, sh_neg]
    have hcomp2 : sh_neg.comp sh_pos = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext'
      · ext c; simp [sh_pos, sh_neg]
      · simp [sh_pos, sh_neg]
    let τ_inv : U₀ ⟶ U₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom sh_neg)
    have hτ_iso : CategoryTheory.IsIso τ_a :=
      ⟨⟨τ_inv,
        by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp1,
             CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
        by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp2,
             CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
    refine ⟨hτ_iso, ?_, ?_, ?_, ?_⟩
    · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      ext c
      simp [sh_pos]
    · rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply Polynomial.ringHom_ext'
      · ext c; simp [sh_pos]
      · simp [sh_pos]
    · have hpre : AlgebraicGeometry.Spec.preimage (η ≫ τ_a) =
          CommRingCat.ofHom ((algebraMap (Polynomial k) Ω).comp sh_pos) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_preimage, CommRingCat.ofHom_comp,
          AlgebraicGeometry.Spec.map_comp]
      rw [hpre]
      ext p
      rw [RingHom.mem_ker, Ideal.mem_bot]
      change algebraMap (Polynomial k) Ω (sh_pos p) = 0 ↔ p = 0
      have hinj_Ω : Function.Injective (algebraMap (Polynomial k) Ω) :=
        (IsScalarTower.algebraMap_eq (Polynomial k) (FractionRing (Polynomial k)) Ω) ▸
          ((RingHom.injective (algebraMap (FractionRing (Polynomial k)) Ω)).comp
            (IsFractionRing.injective (Polynomial k) (FractionRing (Polynomial k))))
      constructor
      · intro h0
        have hsp0 : sh_pos p = 0 := hinj_Ω (h0.trans (map_zero _).symm)
        have hp := congrArg sh_neg hsp0
        have hlhs : sh_neg (sh_pos p) = p := DFunLike.congr_fun hcomp2 p
        rw [hlhs, map_zero] at hp
        exact hp
      · rintro rfl; simp
    · apply PrimeSpectrum.ext
      change Ideal.comap sh_pos ⊥ = ⊥
      ext p
      rw [Ideal.mem_comap, Ideal.mem_bot, Ideal.mem_bot]
      exact ⟨fun h0 => by
        have hp := congrArg sh_neg h0
        have hlhs : sh_neg (sh_pos p) = p := DFunLike.congr_fun hcomp2 p
        rwa [hlhs, map_zero] at hp,
        fun hp => by rw [hp, map_zero]⟩

  have hStalkEvalAt : ∀ (S₀ X₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
