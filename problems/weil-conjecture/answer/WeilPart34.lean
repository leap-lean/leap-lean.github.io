        fun l₁ l₂ => TensorProduct.AlgebraTensorModule.distribBaseChange R R' (S l₁) (S l₂)
      have hd_inl : ∀ (l₁ l₂ : I) (v : S' l₁),
          d_bc l₁ l₂ (LinearMap.baseChange R' (inl_R l₁ l₂) v) =
            TensorProduct.tmul R' v (1 : S' l₂) := by
        intro l₁ l₂
        let fL : S' l₁ →ₗ[R'] TensorProduct R' (S' l₁) (S' l₂) :=
          (d_bc l₁ l₂).toLinearMap.comp (LinearMap.baseChange R' (inl_R l₁ l₂))
        let fR : S' l₁ →ₗ[R'] TensorProduct R' (S' l₁) (S' l₂) :=
          (Algebra.TensorProduct.includeLeft : S' l₁ →ₐ[R'] TensorProduct R' (S' l₁) (S' l₂)).toLinearMap
        have hf : fL = fR := by
          apply LinearMap.restrictScalars_injective R
          refine TensorProduct.ext' fun r' s₁ => ?_
          exact TensorProduct.AlgebraTensorModule.distribBaseChange_tmul R R' s₁ (1 : S l₂) r'
        exact fun v => LinearMap.congr_fun hf v
      have hd_mul : ∀ (l₁ l₂ : I) (c : TensorProduct R (S l₁) (S l₂)) (v : S' l₂),
          d_bc l₁ l₂ (LinearMap.baseChange R' (mulRight_R c) v) =
            ψ₁₂ l₁ l₂ c * TensorProduct.tmul R' (1 : S' l₁) v := by
        intro l₁ l₂ c
        let fL : S' l₂ →ₗ[R'] TensorProduct R' (S' l₁) (S' l₂) :=
          (d_bc l₁ l₂).toLinearMap.comp (LinearMap.baseChange R' (mulRight_R c))
        let fR : S' l₂ →ₗ[R'] TensorProduct R' (S' l₁) (S' l₂) :=
          (LinearMap.mulLeft R' (ψ₁₂ l₁ l₂ c)).comp
            (Algebra.TensorProduct.includeRight : S' l₂ →ₐ[R'] TensorProduct R' (S' l₁) (S' l₂)).toLinearMap
        have h_on_tmul : ∀ (r' : R') (s₂ : S l₂),
            d_bc l₁ l₂ (TensorProduct.tmul R r' (c * TensorProduct.tmul R (1 : S l₁) s₂)) =
              ψ₁₂ l₁ l₂ c * TensorProduct.tmul R' (1 : S' l₁) (TensorProduct.tmul R r' s₂) := by
          intro r' s₂
          let gL : TensorProduct R (S l₁) (S l₂) →ₗ[R] TensorProduct R' (S' l₁) (S' l₂) :=
            ((d_bc l₁ l₂).toLinearMap.restrictScalars R).comp
              ((TensorProduct.mk R R' _ r').comp (LinearMap.mulRight R (TensorProduct.tmul R 1 s₂)))
          let gR : TensorProduct R (S l₁) (S l₂) →ₗ[R] TensorProduct R' (S' l₁) (S' l₂) :=
            ((LinearMap.mulRight R' (TensorProduct.tmul R' (1 : S' l₁) (TensorProduct.tmul R r' s₂))).restrictScalars R).comp
