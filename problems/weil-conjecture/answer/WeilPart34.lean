          (CommRingCat.ofHom (Localization.awayMap g_CA Polynomial.X))
          (CommRingCat.ofHom (Localization.awayMap h_C s_CA)) =
        CommRingCat.ofHom (Localization.awayMap (h_C.comp g_CA) Polynomial.X) := by
      dsimp only [s_CA, RingHom.comp_apply]
      apply CommRingCat.hom_ext
      refine IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial A)) ?_
      refine RingHom.ext (fun p => ?_)
      have haw₁ : Localization.awayMap g_CA Polynomial.X
          (algebraMap (Polynomial A) (Localization.Away (Polynomial.X : Polynomial A)) p) =
          algebraMap C_A (Localization.Away (g_CA Polynomial.X)) (g_CA p) :=
        IsLocalization.Away.lift_eq
          (g := (algebraMap C_A (Localization.Away (g_CA Polynomial.X))).comp g_CA)
          (Polynomial.X : Polynomial A)
          (IsLocalization.Away.algebraMap_isUnit (g_CA Polynomial.X)) p
      have haw₂ : Localization.awayMap h_C (g_CA Polynomial.X)
          (algebraMap C_A (Localization.Away (g_CA Polynomial.X)) (g_CA p)) =
          algebraMap C'_A (Localization.Away (h_C (g_CA Polynomial.X))) (h_C (g_CA p)) :=
        IsLocalization.Away.lift_eq
