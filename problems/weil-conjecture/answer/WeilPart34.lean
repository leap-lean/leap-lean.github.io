          (algebraMap (Polynomial A) (Localization.Away (Polynomial.X : Polynomial A)) p) =
          algebraMap C'_A (Localization.Away (h_C (g_CA Polynomial.X))) (h_C (g_CA p)) :=
        IsLocalization.Away.lift_eq
          (g := (algebraMap C'_A (Localization.Away ((h_C.comp g_CA) Polynomial.X))).comp
