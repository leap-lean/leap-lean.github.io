      let d_left := CategoryTheory.Limits.cokernel.desc v₀_Y (W_Mg.map δ_Y) hw_comp
      have _ : CategoryTheory.Mono d_left :=
        ((CategoryTheory.ShortComplex.mk v₀_Y (W_Mg.map δ_Y) hw_comp).exact_iff_mono_cokernel_desc).mp hEx_w
      have _ : CategoryTheory.Epi d_left := by
        have hfac : CategoryTheory.Limits.cokernel.π v₀_Y ≫ d_left = W_Mg.map δ_Y :=
