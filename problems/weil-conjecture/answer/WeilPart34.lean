        rw [Ideal.mem_span_singleton]
        refine ⟨ι_H γ y * ↑(hu_g.unit⁻¹), ?_⟩
        calc ι_H γ x = (ι_H γ x * ι_H γ g) * ↑(hu_g.unit⁻¹) := by
              rw [mul_assoc, IsUnit.mul_val_inv hu_g, mul_one]
          _ = (s_H * ι_H γ y) * ↑(hu_g.unit⁻¹) := by rw [h_rel_H]
          _ = s_H * (ι_H γ y * ↑(hu_g.unit⁻¹)) := mul_assoc _ _ _
      · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hs_in_𝔪)

    
    have hKrull : (⨅ n : ℕ, 𝔪_H ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔪_H (IsLocalRing.maximalIdeal.isMaximal H).ne_top
    have hFactor : ∀ a : H, a ≠ 0 → ∃ (m : ℕ) (u : H), IsUnit u ∧ a = u * s_H ^ m := by
      classical
      intro a ha
      have hex : ∃ k : ℕ, a ∉ 𝔪_H ^ (k + 1) := by
        by_contra hall
        rw [not_exists] at hall
        have ha_bot : a ∈ (⨅ n : ℕ, 𝔪_H ^ n) := by
          rw [Submodule.mem_iInf]
          intro n
          rcases n with _ | k
          · rw [pow_zero, Ideal.one_eq_top]
            exact Submodule.mem_top
          · exact not_not.mp (hall k)
        rw [hKrull, Submodule.mem_bot] at ha_bot
        exact ha ha_bot
      let m := Nat.find hex
      have hm_not : a ∉ 𝔪_H ^ (m + 1) := Nat.find_spec hex
      have hm_mem : a ∈ 𝔪_H ^ m := by
        rcases eq_or_ne m 0 with h0 | hne
        · rw [h0, pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hne
          have hlt : k < m := by omega
          have hmin := Nat.find_min hex hlt
          rw [hk]
          exact not_not.mp hmin
      rw [h𝔪_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hm_mem
      rcases hm_mem with ⟨u, hu_eq⟩
      have hu_unit : IsUnit u := by
        by_contra hnu
        have hu_mem : u ∈ 𝔪_H := (h_mem_𝔪 u).mpr ((hUnitH u).mpr hnu)
        rw [h𝔪_eq, Ideal.mem_span_singleton] at hu_mem
        rcases hu_mem with ⟨v, rfl⟩
        apply hm_not
        rw [h𝔪_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        refine ⟨v, ?_⟩
        rw [hu_eq]
        ring
      exact ⟨m, u, hu_unit, by rw [hu_eq, mul_comm]⟩

    have hNoZeroDiv : NoZeroDivisors H := by
      refine ⟨fun {a b} hab => ?_⟩
      by_contra h_both
      rw [not_or] at h_both
      rcases h_both with ⟨ha, hb⟩
      obtain ⟨m, u, hu, rfl⟩ := hFactor a ha
      obtain ⟨n, v, hv, rfl⟩ := hFactor b hb
      have huv : IsUnit (u * v) := hu.mul hv
      have hprod : (u * v) * s_H ^ (m + n) = 0 := by
        calc (u * v) * s_H ^ (m + n) = (u * s_H ^ m) * (v * s_H ^ n) := by ring
          _ = 0 := hab
      have hs0 : s_H ^ (m + n) = 0 := by
        calc s_H ^ (m + n) = ↑(huv.unit⁻¹) * ((u * v) * s_H ^ (m + n)) := by
              rw [← mul_assoc, IsUnit.val_inv_mul huv, one_mul]
          _ = 0 := by rw [hprod, mul_zero]
      exact hs_pow_ne (m + n) hs0

    have hDomH : IsDomain H :=
      @NoZeroDivisors.to_isDomain H _ inferInstance hNoZeroDiv
    haveI : IsDomain H := hDomH
    let K := FractionRing H

    have hAwayK : IsLocalization.Away s_H K :=
      { map_units := by
          rintro ⟨_, n, rfl⟩
          have hne : algebraMap H K (s_H ^ n) ≠ 0 := fun h0 =>
            hs_pow_ne n (IsFractionRing.injective H K (h0.trans (map_zero _).symm))
          exact IsUnit.mk0 _ hne
        surj := fun z => by
          obtain ⟨⟨x, b⟩, hzb⟩ := IsLocalization.surj (nonZeroDivisors H) z
          have hb_ne : (b : H) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
          obtain ⟨m, u, hu, hb_eq⟩ := hFactor b.1 hb_ne
          let u_inv : H := ↑(hu.unit⁻¹)
          refine ⟨(u_inv * x, ⟨s_H ^ m, m, rfl⟩), ?_⟩
          dsimp
          have hu_inv_mul : u_inv * u = 1 := IsUnit.val_inv_mul hu
          calc z * algebraMap H K (s_H ^ m)
              = z * algebraMap H K ((u_inv * u) * s_H ^ m) := by rw [hu_inv_mul, one_mul]
            _ = z * (algebraMap H K u_inv * algebraMap H K (u * s_H ^ m)) := by
                rw [mul_assoc u_inv u (s_H ^ m), map_mul]
            _ = algebraMap H K u_inv * (z * algebraMap H K (u * s_H ^ m)) :=
                mul_left_comm z (algebraMap H K u_inv) _
            _ = algebraMap H K u_inv * (z * algebraMap H K b.1) := by rw [← hb_eq]
            _ = algebraMap H K u_inv * algebraMap H K x := by rw [hzb]
            _ = algebraMap H K (u_inv * x) := (map_mul _ _ _).symm
        exists_of_eq := fun {x y} hxy => by
          have heq : x = y := IsFractionRing.injective H K hxy
          exact ⟨1, by rw [heq]⟩ }

    
    have hTrdegK : Algebra.trdeg κ K ≤ (1 : Cardinal.{u}) := by
      letI : Algebra R₀ H := f_H.toRingHom.toAlgebra
      haveI : IsScalarTower κ R₀ H :=
        ⟨fun c r a => by
          simp only [Algebra.smul_def, map_mul, mul_assoc]
          have hc : algebraMap R₀ H (algebraMap κ R₀ c) = algebraMap κ H c := f_H.commutes c
          rw [hc]⟩
      have hg_eq : ∀ r : R₀, algebraMap R₀ K r = algebraMap H K (f_H r) :=
        fun r => IsScalarTower.algebraMap_apply R₀ H K r
      have hg_inj : Function.Injective (algebraMap R₀ K) := by
        intro r₁ r₂ hr
        rw [hg_eq r₁, hg_eq r₂] at hr
        exact hf_inj (IsFractionRing.injective H K hr)
      haveI : IsScalarTower κ R₀ K :=
        ⟨fun c r z => by
          simp only [Algebra.smul_def, map_mul, mul_assoc]
          rw [hg_eq (algebraMap κ R₀ c), f_H.commutes c,
            ← IsScalarTower.algebraMap_apply κ H K c]⟩
      haveI : FaithfulSMul κ R₀ :=
        (faithfulSMul_iff_algebraMap_injective κ R₀).mpr Polynomial.C_injective
      haveI : FaithfulSMul R₀ K :=
        (faithfulSMul_iff_algebraMap_injective R₀ K).mpr hg_inj
      haveI : Module.IsTorsionFree R₀ K :=
        Module.IsTorsionFree.of_smul_eq_zero fun r z hrz => by
          rw [Algebra.smul_def] at hrz
          rcases mul_eq_zero.mp hrz with hr0 | hz0
          · exact Or.inl (hg_inj (hr0.trans (map_zero (algebraMap R₀ K)).symm))
          · exact Or.inr hz0
      let F₀ := FractionRing R₀
      let ψ₀ : F₀ →+* K := IsFractionRing.lift (K := F₀) hg_inj
      letI : Algebra F₀ K := ψ₀.toAlgebra
      haveI : IsScalarTower R₀ F₀ K :=
        ⟨fun r w z => by
          simp only [Algebra.smul_def, map_mul, mul_assoc]
          have hr : algebraMap F₀ K (algebraMap R₀ F₀ r) = algebraMap R₀ K r :=
            IsFractionRing.lift_algebraMap (K := F₀) hg_inj r
          rw [hr]⟩
      have hAlg_H : Algebra.IsAlgebraic R₀ H := by
        refine ⟨fun a => ?_⟩
        obtain ⟨γ, x, rfl⟩ := h_surj a
        let D_γ : Type u := ↑(D_H.obj γ)
        letI : Algebra R₀ D_γ := (α_H.app γ).hom.toAlgebra
        haveI : Algebra.Etale R₀ D_γ := RingHom.etale_algebraMap.mp (hEt γ)
        let E_γ := TensorProduct R₀ F₀ D_γ
        haveI : Algebra.Etale F₀ E_γ := Algebra.Etale.baseChange R₀ D_γ F₀
        haveI : Module.Finite F₀ E_γ := Algebra.FormallyUnramified.finite_of_free F₀ E_γ
        haveI : Algebra.IsIntegral F₀ E_γ := Algebra.IsIntegral.of_finite F₀ E_γ
        have hInt_x : IsIntegral F₀ ((1 : F₀) ⊗ₜ[R₀] x : E_γ) :=
          Algebra.IsIntegral.isIntegral ((1 : F₀) ⊗ₜ[R₀] x)
        let φ_γ : D_γ →ₐ[R₀] K :=
          { (algebraMap H K).comp (ι_H γ) with
            commutes' := fun P => by
              have hfP := congrArg (fun k => k.hom P) (hf_H γ)
              change ι_H γ ((α_H.app γ).hom P) = f_H P at hfP
              change algebraMap H K (ι_H γ ((α_H.app γ).hom P)) = algebraMap R₀ K P
              rw [hfP, ← hg_eq P] }
        let Ψ_γ : E_γ →ₐ[F₀] K :=
          Algebra.TensorProduct.productLeftAlgHom (Algebra.ofId F₀ K) φ_γ
        have hΨ_x : Ψ_γ ((1 : F₀) ⊗ₜ[R₀] x) = algebraMap H K (ι_H γ x) := by
          dsimp [Ψ_γ, Algebra.TensorProduct.productLeftAlgHom]
          rw [Algebra.TensorProduct.lift_tmul]
          simp [φ_γ]
        have hInt_K : IsIntegral F₀ (algebraMap H K (ι_H γ x)) := by
          rw [← hΨ_x]
          exact hInt_x.map Ψ_γ
        have hAlg_F₀ : IsAlgebraic F₀ (algebraMap H K (ι_H γ x)) := hInt_K.isAlgebraic
        have hAlg_R₀_K : IsAlgebraic R₀ (algebraMap H K (ι_H γ x)) :=
          (IsFractionRing.isAlgebraic_iff R₀ F₀ K).mpr hAlg_F₀
        rcases hAlg_R₀_K with ⟨Q, hQ_ne, hQ_eval⟩
        refine ⟨Q, hQ_ne, ?_⟩
        have h_aeval : Polynomial.aeval (algebraMap H K (ι_H γ x)) Q =
            algebraMap H K (Polynomial.aeval (ι_H γ x) Q) := by
          simpa using Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom R₀ H K) (ι_H γ x) Q
        rw [h_aeval] at hQ_eval
        exact IsFractionRing.injective H K (hQ_eval.trans (map_zero _).symm)
      haveI : Algebra.IsAlgebraic R₀ H := hAlg_H
      haveI : Algebra.IsAlgebraic R₀ K :=
        (IsFractionRing.isAlgebraic_iff' R₀ H K).mp inferInstance
      have htr0 : Algebra.trdeg R₀ K = 0 := trdeg_eq_zero
      have htr1 : Algebra.trdeg κ R₀ = 1 := Polynomial.trdeg_of_isDomain
      have htr_sum : Algebra.trdeg κ R₀ + Algebra.trdeg R₀ K = Algebra.trdeg κ K :=
        trdeg_add_eq κ R₀ (A := K)
      rw [← htr_sum, htr1, htr0, add_zero]
    exact ⟨hDomH, hAwayK, hTrdegK⟩

theorem weil_aff_cd_etale_baseChange_algClosed_krullDim_le (κ K Ω : Type u) [Field κ] [Field K] [Field Ω] [Algebra κ K]
    (d : ℕ)
    (R₁ : Type u) [CommRing R₁] [Algebra κ R₁] [Algebra.FiniteType κ R₁] [Nontrivial R₁]
    (hDimR₁ : ringKrullDim R₁ ≤ (d : WithBot ℕ∞))
    (R₁K B'' B''_Ω : Type u) [CommRing R₁K] [CommRing B''] [CommRing B''_Ω]
    [Algebra K R₁K] [Algebra K B''] [Algebra Ω B''_Ω]
    (g_R₁ : R₁ →+* R₁K) (f_et : R₁K →ₐ[K] B'')
    (φ_Ω : K →+* Ω) (ι_Ω : B'' →+* B''_Ω)
    (hPush₁ : CategoryTheory.IsPushout
      (CommRingCat.ofHom (algebraMap κ R₁))
      (CommRingCat.ofHom (algebraMap κ K))
      (CommRingCat.ofHom g_R₁)
      (CommRingCat.ofHom (algebraMap K R₁K)))
    (hf_et : f_et.toRingHom.Etale)
    (hPush₂ : CategoryTheory.IsPushout
      (CommRingCat.ofHom (algebraMap K B''))
      (CommRingCat.ofHom φ_Ω)
      (CommRingCat.ofHom ι_Ω)
      (CommRingCat.ofHom (algebraMap Ω B''_Ω))) :
    AlgebraicGeometry.LocallyOfFiniteType
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω B''_Ω))) ∧
    topologicalKrullDim (AlgebraicGeometry.Spec (CommRingCat.of B''_Ω)) ≤ (d : WithBot ℕ∞) :=
by
  let _ : Algebra κ Ω := (φ_Ω.comp (algebraMap κ K)).toAlgebra
  have hScalar : φ_Ω.comp (algebraMap κ K) = algebraMap κ Ω := rfl
  let R₁Ω := TensorProduct κ Ω R₁
  let inc_R : R₁ →+* R₁Ω := Algebra.TensorProduct.includeRight.toRingHom
  have hp_tp : CategoryTheory.IsPushout
      (CommRingCat.ofHom (algebraMap κ Ω))
      (CommRingCat.ofHom (algebraMap κ R₁))
      (CommRingCat.ofHom (algebraMap Ω R₁Ω))
      (CommRingCat.ofHom inc_R) :=
    CommRingCat.isPushout_tensorProduct κ Ω R₁
  have hκΩ_mor : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (algebraMap κ K)) (CommRingCat.ofHom φ_Ω) =
      CommRingCat.ofHom (algebraMap κ Ω) := by
    rw [← CommRingCat.ofHom_comp, hScalar]
  have hcomm₁ : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (algebraMap κ R₁)) (CommRingCat.ofHom inc_R) =
      CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (algebraMap κ K))
        (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_Ω)
          (CommRingCat.ofHom (algebraMap Ω R₁Ω))) := by
    rw [← CategoryTheory.Category.assoc, hκΩ_mor]
    exact hp_tp.flip.w
  let cocone₁ := CategoryTheory.Limits.PushoutCocone.mk
    (CommRingCat.ofHom inc_R)
    (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_Ω)
      (CommRingCat.ofHom (algebraMap Ω R₁Ω)))
    hcomm₁
  let u_mor : CommRingCat.of R₁K ⟶ CommRingCat.of R₁Ω := hPush₁.isColimit.desc cocone₁
  let u_R₁K : R₁K →+* R₁Ω := u_mor.hom
  have hu_inl : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom g_R₁) (CommRingCat.ofHom u_R₁K) = CommRingCat.ofHom inc_R :=
    hPush₁.isColimit.fac cocone₁ CategoryTheory.Limits.WalkingSpan.left
  have hu_inr : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (algebraMap K R₁K)) (CommRingCat.ofHom u_R₁K) =
      CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_Ω)
        (CommRingCat.ofHom (algebraMap Ω R₁Ω)) :=
    hPush₁.isColimit.fac cocone₁ CategoryTheory.Limits.WalkingSpan.right
  have hp_outer₁ : CategoryTheory.IsPushout
      (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom (algebraMap κ K)) (CommRingCat.ofHom φ_Ω))
      (CommRingCat.ofHom (algebraMap κ R₁))
      (CommRingCat.ofHom (algebraMap Ω R₁Ω))
      (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom g_R₁) (CommRingCat.ofHom u_R₁K)) := by
    rw [hκΩ_mor, hu_inl]
    exact hp_tp
  have hp_mid : CategoryTheory.IsPushout
      (CommRingCat.ofHom (algebraMap K R₁K))
      (CommRingCat.ofHom φ_Ω)
      (CommRingCat.ofHom u_R₁K)
      (CommRingCat.ofHom (algebraMap Ω R₁Ω)) :=
    (CategoryTheory.IsPushout.of_left hp_outer₁ hu_inr.symm hPush₁.flip).flip
  have hf_alg : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (algebraMap K R₁K)) (CommRingCat.ofHom f_et.toRingHom) =
      CommRingCat.ofHom (algebraMap K B'') := by
    rw [← CommRingCat.ofHom_comp]
    exact congrArg CommRingCat.ofHom (RingHom.ext f_et.commutes)
  have hcomm₂ : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (algebraMap K R₁K))
      (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_et.toRingHom) (CommRingCat.ofHom ι_Ω)) =
      CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom φ_Ω)
        (CommRingCat.ofHom (algebraMap Ω B''_Ω)) := by
    rw [← CategoryTheory.Category.assoc, hf_alg]
    exact hPush₂.w
  let cocone₂ := CategoryTheory.Limits.PushoutCocone.mk
    (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_et.toRingHom) (CommRingCat.ofHom ι_Ω))
    (CommRingCat.ofHom (algebraMap Ω B''_Ω))
    hcomm₂
  let ψ_mor : CommRingCat.of R₁Ω ⟶ CommRingCat.of B''_Ω := hp_mid.isColimit.desc cocone₂
  let ψ_Ω : R₁Ω →ₐ[Ω] B''_Ω :=
    { ψ_mor.hom with
      commutes' := fun c => congrArg (fun k => k.hom c)
        (hp_mid.isColimit.fac cocone₂ CategoryTheory.Limits.WalkingSpan.right) }
  have hψ_inl : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom u_R₁K) (CommRingCat.ofHom ψ_Ω.toRingHom) =
      CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom f_et.toRingHom) (CommRingCat.ofHom ι_Ω) :=
    hp_mid.isColimit.fac cocone₂ CategoryTheory.Limits.WalkingSpan.left
  have hψ_inr : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (algebraMap Ω R₁Ω)) (CommRingCat.ofHom ψ_Ω.toRingHom) =
      CommRingCat.ofHom (algebraMap Ω B''_Ω) :=
    hp_mid.isColimit.fac cocone₂ CategoryTheory.Limits.WalkingSpan.right
  have hp_outer₂ : CategoryTheory.IsPushout
      (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom (algebraMap K R₁K))
        (CommRingCat.ofHom f_et.toRingHom))
      (CommRingCat.ofHom φ_Ω)
      (CommRingCat.ofHom ι_Ω)
      (CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom (algebraMap Ω R₁Ω))
        (CommRingCat.ofHom ψ_Ω.toRingHom)) := by
    rw [hf_alg, hψ_inr]
    exact hPush₂
  have hp_right : CategoryTheory.IsPushout
      (CommRingCat.ofHom f_et.toRingHom)
      (CommRingCat.ofHom u_R₁K)
      (CommRingCat.ofHom ι_Ω)
      (CommRingCat.ofHom ψ_Ω.toRingHom) :=
    CategoryTheory.IsPushout.of_left hp_outer₂ hψ_inl.symm hp_mid
  have hpb_right := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hp_right
  have hf_et_spec : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_et.toRingHom)) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf_et
  have hψ_et_spec : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω.toRingHom)) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_right hf_et_spec
  have hψ_et : ψ_Ω.toRingHom.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hψ_et_spec
  have hLFT : AlgebraicGeometry.LocallyOfFiniteType
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap Ω B''_Ω))) := by
    have hFT_R₁Ω : Algebra.FiniteType Ω R₁Ω := Algebra.FiniteType.baseChange Ω
    have hFT_tot : Algebra.FiniteType Ω B''_Ω := by
      let _ : Algebra R₁Ω B''_Ω := ψ_Ω.toRingHom.toAlgebra
      have _ : IsScalarTower Ω R₁Ω B''_Ω :=
        IsScalarTower.of_algebraMap_eq' ψ_Ω.comp_algebraMap.symm
      have _ : Algebra.Etale R₁Ω B''_Ω := RingHom.etale_algebraMap.mp hψ_et
      have _ : Algebra.FiniteType R₁Ω B''_Ω := Algebra.FiniteType.of_finitePresentation
      exact Algebra.FiniteType.trans hFT_R₁Ω inferInstance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr (RingHom.finiteType_algebraMap.mpr hFT_tot)
  obtain ⟨n, g_S, hgS_inj, hgS_fin⟩ := @exists_finite_inj_algHom_of_fg κ R₁ _ _ _ _ _
  let P_κ := MvPolynomial (Fin n) κ
  let P_Ω := MvPolynomial (Fin n) Ω
  have hgS_int : g_S.toRingHom.IsIntegral := RingHom.Finite.to_isIntegral hgS_fin
  have hDim_Pκ_le_d : ringKrullDim P_κ ≤ (d : WithBot ℕ∞) := by
    let _ : Algebra P_κ R₁ := g_S.toRingHom.toAlgebra
    have _ : Module.Finite P_κ R₁ := RingHom.finite_algebraMap.mp hgS_fin
    have _ : Algebra.IsIntegral P_κ R₁ := Algebra.IsIntegral.of_finite P_κ R₁
    have hLift : ∀ (m : ℕ) (l : LTSeries (PrimeSpectrum P_κ)), l.length = m →
        ∃ (q : LTSeries (PrimeSpectrum R₁)),
          q.length = m ∧ Ideal.under P_κ (q.last).asIdeal = (l.last).asIdeal := by
      intro m
      induction m with
      | zero =>
        intro l _
        have hbot : Ideal.under P_κ (⊥ : Ideal R₁) ≤ (l.last).asIdeal := by
          intro a ha
          have ha0 : g_S a = 0 := ha
          have ha_eq : a = 0 := hgS_inj (ha0.trans (map_zero g_S).symm)
          rw [ha_eq]
          exact (l.last).asIdeal.zero_mem
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (l.last).asIdeal (⊥ : Ideal R₁) hbot
        let q₀ : LTSeries (PrimeSpectrum R₁) := RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩
        exact ⟨q₀, rfl, hQ₀_under⟩
      | succ m ih =>
        intro l hl
        let l' := l.eraseLast
        have hl'_len : l'.length = m := by
          change l.length - 1 = m
          omega
        have hl'_lt : (l'.last).asIdeal < (l.last).asIdeal := by
          have hstep := l.step ⟨m, by omega⟩
          have h1 : l'.last = l ⟨m, by omega⟩ := by
            dsimp [l', RelSeries.eraseLast, RelSeries.last]
            congr 1
            ext
            dsimp
            omega
          have h2 : l.last = l ⟨m + 1, by omega⟩ := by
            dsimp [RelSeries.last]
            congr 1
            ext
            dsimp
            omega
          rw [h1, h2]
          exact hstep
        obtain ⟨q', hq'_len, hq'_under⟩ := ih l' hl'_len
        have hq'_le : Ideal.under P_κ (q'.last).asIdeal ≤ (l.last).asIdeal := by
