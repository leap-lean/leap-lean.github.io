    rw [CategoryTheory.Category.comp_id]
    exact (AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ (hPolyPushout g)).flip

  refine ⟨W_poly g_C, p_poly g_C, π_poly g_C, hPb_poly g_C, fun ξ => ?_⟩

  obtain ⟨CA, hRingCA, inl_CA, inr_CA, hp_CA⟩ :=
    hOpaquePushout (CommRingCat.ofHom f_A.toRingHom) (CommRingCat.ofHom g_C)
  letI : CommRing CA := hRingCA
  have hEt_inl_CA : inl_CA.hom.Etale := (hEtale_pushout hp_CA).2 hg_C
  have h_σ_comm : CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom f_A.toRingHom) (CommRingCat.ofHom τ_A.toRingHom) =
      CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom g_C) (CommRingCat.ofHom τ_C) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hτ_C]
    exact congrArg CommRingCat.ofHom (congrArg AlgHom.toRingHom hσ_A)
  obtain ⟨τ_CA_push, hτ_CA_inl, hτ_CA_inr⟩ :=
    hPushoutDesc hp_CA (CommRingCat.ofHom τ_A.toRingHom) (CommRingCat.ofHom τ_C) h_σ_comm
  letI : Algebra A CA := inl_CA.hom.toAlgebra
  haveI : Algebra.Etale A CA := RingHom.etale_algebraMap.mp hEt_inl_CA
  obtain ⟨σ_CA, hσ_CA⟩ := hA.2.2.2.2 CA τ_CA_push.hom
    (fun a => congrArg (fun k => k.hom a) hτ_CA_inl)
  have hPolyMapComp : ∀ {R_1 R_2 R_3 : Type u} [CommRing R_1] [CommRing R_2] [CommRing R_3]
      (b_hom : R_2 →+* R_3) (a_hom : R_1 →+* R_2),
      (Polynomial.mapRingHom b_hom).comp (Polynomial.mapRingHom a_hom) =
        Polynomial.mapRingHom (b_hom.comp a_hom) := by
    intros
    apply Polynomial.ringHom_ext' <;> simp

  let φ_A : Quiver.Hom (CommRingCat.of C) (CommRingCat.of A) :=
    CategoryTheory.CategoryStruct.comp inr_CA (CommRingCat.ofHom σ_CA.toRingHom)
  have hφ_A_gC : CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom g_C) φ_A =
      CommRingCat.ofHom f_A.toRingHom := by
    apply CommRingCat.hom_ext
    ext r
    have hpw : inr_CA.hom (g_C r) = inl_CA.hom (f_A r) :=
      (congrArg (fun k => k.hom r) hp_CA.w).symm
    change σ_CA (inr_CA.hom (g_C r)) = f_A r
    rw [hpw]
    exact σ_CA.commutes (f_A r)
  have hφ_A_τ : CategoryTheory.CategoryStruct.comp φ_A (CommRingCat.ofHom τ_A.toRingHom) =
      CommRingCat.ofHom τ_C := by
    apply CommRingCat.hom_ext
    ext x
    have hinr := congrArg (fun k => k.hom x) hτ_CA_inr
    dsimp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, φ_A] at hinr ⊢
    exact (hσ_CA (inr_CA.hom x)).trans hinr

  have hfp_gC : (CommRingCat.Hom.hom (CommRingCat.ofHom g_C)).FinitePresentation :=
    @Algebra.Etale.finitePresentation R₁ C _ _ g_C.toAlgebra hg_C
  have h_compat_D : ∀ i : ℐ,
      CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom g_C)
        (CategoryTheory.CategoryStruct.comp φ_A e_pt.inv) =
        CategoryTheory.CategoryStruct.comp (α.app i) (c.ι.app i) := by
    intro i
    apply (cancel_mono e_pt.hom).mp
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      e_pt.inv_hom_id, CategoryTheory.Category.comp_id, hφ_A_gC,
      CategoryTheory.Category.assoc, hf_A i]
  obtain ⟨i₀, φ₀, hφ₀_α, hφ₀_colim⟩ :=
    RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
      (CommRingCat.of R₁) D α (CommRingCat.ofHom g_C) c hc hfp_gC
      (CategoryTheory.CategoryStruct.comp φ_A e_pt.inv) h_compat_D

  let m_i₀ : Quiver.Hom (AlgebraicGeometry.Spec (D_poly.obj i₀)) (W_poly g_C) :=
    AlgebraicGeometry.Spec.map
      (CategoryTheory.CategoryStruct.comp
        (CommRingCat.ofHom (Polynomial.mapRingHom φ₀.hom))
        (e_poly_lvl i₀).inv)
  have hm_i₀_π : CategoryTheory.CategoryStruct.comp m_i₀ (π_poly g_C) =
      AlgebraicGeometry.Spec.map (α_poly.app i₀) := by
    dsimp [m_i₀, π_poly]
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1
    rw [← CategoryTheory.Category.assoc, ← CommRingCat.ofHom_comp,
      hPolyMapComp]
    have hgφ : φ₀.hom.comp g_C = (α.app i₀).hom :=
      congrArg CommRingCat.Hom.hom hφ₀_α
    rw [hgφ, ← hα_poly i₀, CategoryTheory.Category.assoc,
      (e_poly_lvl i₀).hom_inv_id, CategoryTheory.Category.comp_id]
  let ξ_i₀ := weilSliceColimTrianglePullHom (@hc_all) (@hr_all) hSite
    (AlgebraicGeometry.Spec.map (α_poly.app i₀)) (π_poly g_C) m_i₀ hm_i₀_π ℱ₀ b ξ
  let f_poly_inf : Quiver.Hom
      (CommRingCat.of (Polynomial R₁)) c_poly.pt :=
    CategoryTheory.CategoryStruct.comp
      (CommRingCat.ofHom (Polynomial.mapRingHom f_A.toRingHom))
      e_poly_colim.inv
  have hZero_i₀_inf : WeilEtaleTrianglePullbackMapsTo
      (AlgebraicGeometry.Spec.map f_poly_inf)
      (AlgebraicGeometry.Spec.map (α_poly.app i₀))
      (AlgebraicGeometry.Spec.map (c_poly.ι.app i₀))
      (by rw [← AlgebraicGeometry.Spec.map_comp, hf_poly i₀]) ℱ₀ b ξ_i₀ 0 := by
    rw [hMapsTo_iff]
    let m_to_A : Quiver.Hom
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A)))
        (AlgebraicGeometry.Spec (D_poly.obj i₀)) :=
      AlgebraicGeometry.Spec.map
        (CategoryTheory.CategoryStruct.comp (c_poly.ι.app i₀) e_poly_colim.hom)
    have hm_to_A_π : CategoryTheory.CategoryStruct.comp m_to_A
        (AlgebraicGeometry.Spec.map (α_poly.app i₀)) = π_A := by
      dsimp only [m_to_A, π_A]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        hf_poly i₀, CategoryTheory.Category.assoc, e_poly_colim.inv_hom_id,
        CategoryTheory.Category.comp_id]
    let m_colim_A : Quiver.Hom
        (AlgebraicGeometry.Spec c_poly.pt)
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))) :=
      AlgebraicGeometry.Spec.map e_poly_colim.inv
    have hm_colim_A_π : CategoryTheory.CategoryStruct.comp m_colim_A π_A =
        AlgebraicGeometry.Spec.map f_poly_inf := by
      dsimp only [m_colim_A, π_A, f_poly_inf]
      rw [← AlgebraicGeometry.Spec.map_comp]
    have hm_eq : CategoryTheory.CategoryStruct.comp m_colim_A m_to_A =
        AlgebraicGeometry.Spec.map (c_poly.ι.app i₀) := by
      dsimp only [m_colim_A, m_to_A]
      rw [← AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        e_poly_colim.hom_inv_id]
      congr 1
    have heq_comp := (hPullComp π_A (AlgebraicGeometry.Spec.map (α_poly.app i₀))
      (AlgebraicGeometry.Spec.map f_poly_inf) m_to_A m_colim_A
      (AlgebraicGeometry.Spec.map (c_poly.ι.app i₀)) hm_to_A_π hm_colim_A_π
      (by rw [← AlgebraicGeometry.Spec.map_comp, hf_poly i₀]) hm_eq ℱ₀ b ξ_i₀).symm
    have hzero_A : weilSliceColimTrianglePullHom (@hc_all) (@hr_all) hSite
        π_A (AlgebraicGeometry.Spec.map (α_poly.app i₀)) m_to_A hm_to_A_π ℱ₀ b ξ_i₀ = 0 :=
      @Subsingleton.elim _ hSub_FA _ 0
    rw [heq_comp, hzero_A, map_zero]

  obtain ⟨i₁, θ, hθ_eq, hZero_i₁⟩ :=
    (hAffAll b ℐ (CommRingCat.of (Polynomial R₁)) D_poly α_poly c_poly hc_poly
      f_poly_inf hf_poly ℱ₀).2 i₀ _ ξ_i₀ hZero_i₀_inf
  let h_C : C →+* ↑(D.obj i₁) := (CategoryTheory.CategoryStruct.comp φ₀ (D.map θ)).hom
  have h_gC_hC : CategoryTheory.CategoryStruct.comp (CommRingCat.ofHom g_C)
      (CategoryTheory.CategoryStruct.comp φ₀ (D.map θ)) = α.app i₁ := by
    rw [← CategoryTheory.Category.assoc, hφ₀_α]
    have hnat := α.naturality θ
    dsimp at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm
  have hh_C_et : h_C.Etale :=
    hEtale_of_comp (CommRingCat.ofHom g_C) (CategoryTheory.CategoryStruct.comp φ₀ (D.map θ))
      hg_C (by rw [h_gC_hC]; exact hEt_D i₁)
  let τ_C' : ↑(D.obj i₁) →+* κ := τ_lvl i₁
  have hτ_C'_comp : τ_C'.comp h_C = τ_C := by
    ext x
    change τ_lvl i₁ ((D.map θ).hom (φ₀.hom x)) = τ_C x
    rw [← hτ_A i₁ ((D.map θ).hom (φ₀.hom x))]
    have hc_w : (c.ι.app i₁ ≫ e_pt.hom).hom ((D.map θ).hom (φ₀.hom x)) =
        (c.ι.app i₀ ≫ e_pt.hom).hom (φ₀.hom x) := by
      have hw := congrArg (fun k => (k ≫ e_pt.hom).hom (φ₀.hom x)) (c.w θ)
      simpa only [CategoryTheory.Category.assoc, CommRingCat.hom_comp,
        RingHom.comp_apply] using hw
    change τ_A ((c.ι.app i₁ ≫ e_pt.hom).hom ((D.map θ).hom (φ₀.hom x))) = τ_C x
    rw [hc_w]
    have h_col : (c.ι.app i₀ ≫ e_pt.hom).hom (φ₀.hom x) = φ_A.hom x := by
      have h_iso : CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp φ₀ (c.ι.app i₀)) e_pt.hom = φ_A := by
        rw [← hφ₀_colim, CategoryTheory.Category.assoc, e_pt.inv_hom_id,
          CategoryTheory.Category.comp_id]
      exact congrArg (fun k => k.hom x)
        ((CategoryTheory.Category.assoc φ₀ (c.ι.app i₀) e_pt.hom).symm.trans h_iso)
    rw [h_col]
    exact congrArg (fun k => k.hom x) hφ_A_τ

  let u_W_poly : Quiver.Hom (W_poly (h_C.comp g_C)) (W_poly g_C) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom h_C))
  have hu_W_poly_π : CategoryTheory.CategoryStruct.comp u_W_poly (π_poly g_C) =
      π_poly (h_C.comp g_C) := by
    dsimp only [u_W_poly, π_poly]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      hPolyMapComp]
  have hu_W_poly_p : CategoryTheory.CategoryStruct.comp u_W_poly (p_poly g_C) =
      CategoryTheory.CategoryStruct.comp (p_poly (h_C.comp g_C))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom h_C)) := by
    dsimp only [u_W_poly, p_poly, W_poly]
    rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      (hPolyPushout h_C).w]
  have hm_zero_poly : WeilEtaleTrianglePullbackMapsTo
      (π_poly (h_C.comp g_C)) (π_poly g_C) u_W_poly hu_W_poly_π ℱ₀ b ξ 0 := by
    rw [hMapsTo_iff]
    let m_inv₁ : Quiver.Hom (W_poly (h_C.comp g_C))
        (AlgebraicGeometry.Spec (D_poly.obj i₁)) :=
      AlgebraicGeometry.Spec.map (e_poly_lvl i₁).hom
    have hm_inv₁_π : CategoryTheory.CategoryStruct.comp m_inv₁
        (AlgebraicGeometry.Spec.map (α_poly.app i₁)) =
        π_poly (h_C.comp g_C) := by
      dsimp only [m_inv₁, π_poly, W_poly]
      rw [← AlgebraicGeometry.Spec.map_comp, hα_poly i₁]
      congr 2
      exact congrArg Polynomial.mapRingHom (congrArg CommRingCat.Hom.hom h_gC_hC).symm
    have hm_mor_eq : CategoryTheory.CategoryStruct.comp m_inv₁
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (D_poly.map θ)) m_i₀) = u_W_poly := by
      dsimp only [m_inv₁, m_i₀, u_W_poly, W_poly]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      have h_step : CategoryTheory.CategoryStruct.comp (e_poly_lvl i₀).inv
          (CategoryTheory.CategoryStruct.comp (D_poly.map θ) (e_poly_lvl i₁).hom) =
          CommRingCat.ofHom (Polynomial.mapRingHom (D.map θ).hom) := by
        rw [hD_poly_map θ, ← CategoryTheory.Category.assoc,
          (e_poly_lvl i₀).inv_hom_id, CategoryTheory.Category.id_comp]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_step,
        ← CommRingCat.ofHom_comp, hPolyMapComp]
    have heq_1 := (hPullComp (AlgebraicGeometry.Spec.map (α_poly.app i₁))
      (π_poly g_C) (π_poly (h_C.comp g_C))
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (D_poly.map θ)) m_i₀)
      m_inv₁ u_W_poly
      (by rw [CategoryTheory.Category.assoc, hm_i₀_π, hθ_eq])
      hm_inv₁_π hu_W_poly_π hm_mor_eq ℱ₀ b ξ).symm
    have heq_2 := (hPullComp (AlgebraicGeometry.Spec.map (α_poly.app i₀))
      (π_poly g_C) (AlgebraicGeometry.Spec.map (α_poly.app i₁))
      m_i₀ (AlgebraicGeometry.Spec.map (D_poly.map θ))
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (D_poly.map θ)) m_i₀)
      hm_i₀_π hθ_eq (by rw [CategoryTheory.Category.assoc, hm_i₀_π, hθ_eq])
      rfl ℱ₀ b ξ).symm
    have hzero_θ := (hMapsTo_iff _ _ _ _ _ _ _ _).mp hZero_i₁
    dsimp only [ξ_i₀] at hzero_θ
    let φ_inv₁ := weilSliceColimTrianglePullHom (@hc_all) (@hr_all) hSite
      (π_poly (h_C.comp g_C))
      (AlgebraicGeometry.Spec.map (α_poly.app i₁))
      m_inv₁ hm_inv₁_π ℱ₀ b
    have hzero_i₁_step : weilSliceColimTrianglePullHom (@hc_all) (@hr_all) hSite
        (AlgebraicGeometry.Spec.map (α_poly.app i₁))
        (π_poly g_C)
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (D_poly.map θ)) m_i₀)
        (by rw [CategoryTheory.Category.assoc, hm_i₀_π, hθ_eq]) ℱ₀ b ξ = 0 :=
      heq_2.trans hzero_θ
    exact heq_1.trans ((congrArg (⇑φ_inv₁) hzero_i₁_step).trans φ_inv₁.map_zero)
  exact ⟨↑(D.obj i₁), inferInstance, h_C, τ_C', W_poly (h_C.comp g_C),
    p_poly (h_C.comp g_C), π_poly (h_C.comp g_C), u_W_poly, hu_W_poly_π,
    hh_C_et, hτ_C'_comp, hPb_poly (h_C.comp g_C), hu_W_poly_p, hm_zero_poly⟩

theorem weil_affine_etale_cohomological_dimension (k : Type u) [Field k] [IsAlgClosed k]
    (d n q : ℕ) (hn : 1 ≤ n) (hUnit : IsUnit (n : k))
    (U : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsAffine U.left]
    [AlgebraicGeometry.LocallyOfFiniteType U.hom]
    (hDim : topologicalKrullDim U.left ≤ (d : WithBot ℕ∞))
    (hq : d < q) :
    Subsingleton (weilEtaleTorsionH U.left n q) :=
by
  have hAffineSpaceProps : ∀ (k₀ : Type u) [Field k₀] (s : ℕ),
      AlgebraicGeometry.IsAffine (weilAffineSpaceOver k₀ s).left ∧
      AlgebraicGeometry.LocallyOfFiniteType (weilAffineSpaceOver k₀ s).hom ∧
      AlgebraicGeometry.QuasiCompact (weilAffineSpaceOver k₀ s).hom ∧
      AlgebraicGeometry.IsSeparated (weilAffineSpaceOver k₀ s).hom ∧
      topologicalKrullDim (weilAffineSpaceOver k₀ s).left ≤ (s : WithBot ℕ∞) := by
    intro k₀ _ s
    have hAff : AlgebraicGeometry.IsAffine (weilAffineSpaceOver k₀ s).left := by
      dsimp [weilAffineSpaceOver]; infer_instance
    have _ : AlgebraicGeometry.IsAffineHom (weilAffineSpaceOver k₀ s).hom :=
      AlgebraicGeometry.isAffineHom_of_isAffine (weilAffineSpaceOver k₀ s).hom
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType (weilAffineSpaceOver k₀ s).hom := by
      dsimp [weilAffineSpaceOver]
      rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)]
      change RingHom.FiniteType (algebraMap k₀ (MvPolynomial (Fin s) k₀))
      exact RingHom.finiteType_algebraMap.mpr inferInstance
    have hQC : AlgebraicGeometry.QuasiCompact (weilAffineSpaceOver k₀ s).hom := inferInstance
    have hSep : AlgebraicGeometry.IsSeparated (weilAffineSpaceOver k₀ s).hom := inferInstance
    have hDim_s : topologicalKrullDim (weilAffineSpaceOver k₀ s).left ≤ (s : WithBot ℕ∞) := by
      change topologicalKrullDim (PrimeSpectrum (MvPolynomial (Fin s) k₀)) ≤ (s : WithBot ℕ∞)
      rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim,
        MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k₀, zero_add,
        ENat.card_eq_coe_fintype_card, Fintype.card_fin]
      rfl
    exact ⟨hAff, hLFT, hQC, hSep, hDim_s⟩

  have hProperP1 : ∀ (κ₀ : Type u) [Field κ₀],
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver κ₀ 1).hom := by
    intro κ₀ _
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) κ₀
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have _ : IsScalarTower κ₀ (↥(𝒜 0)) (MvPolynomial (Fin 2) κ₀) :=
      ⟨fun c a p => smul_mul_assoc c a.1 p⟩
    have _ : Algebra.FiniteType (↥(𝒜 0)) (MvPolynomial (Fin 2) κ₀) :=
      Algebra.FiniteType.of_restrictScalars_finiteType κ₀ (↥(𝒜 0)) (MvPolynomial (Fin 2) κ₀)
    have _ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
    let φ₀ : κ₀ →+* ↥(𝒜 0) := algebraMap κ₀ ↥(𝒜 0)
    have hbij : Function.Bijective φ₀ := by
      refine ⟨fun c₁ c₂ h => ?_, fun x => ?_⟩
      · have hval : (φ₀ c₁).1 = (φ₀ c₂).1 := congrArg Subtype.val h
        exact MvPolynomial.C_injective (Fin 2) κ₀ hval
      · refine ⟨MvPolynomial.constantCoeff x.1, Subtype.ext ?_⟩
        have hx : MvPolynomial.IsHomogeneous x.1 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 x.1).mp x.2
        have hc : (MvPolynomial.homogeneousComponent 0) x.1 = x.1 :=
          MvPolynomial.homogeneousComponent_of_mem hx
        rw [MvPolynomial.homogeneousComponent_zero] at hc
        exact hc
    let e₀ : κ₀ ≃+* ↥(𝒜 0) := RingEquiv.ofBijective φ₀ hbij
    let f₀ : CommRingCat.of κ₀ ⟶ CommRingCat.of ↥(𝒜 0) := CommRingCat.ofHom φ₀
    let g₀ : CommRingCat.of ↥(𝒜 0) ⟶ CommRingCat.of κ₀ := CommRingCat.ofHom e₀.symm.toRingHom
    have _ : CategoryTheory.IsIso f₀ :=
      ⟨⟨g₀, CommRingCat.hom_ext (RingHom.ext e₀.left_inv),
        CommRingCat.hom_ext (RingHom.ext e₀.right_inv)⟩⟩
    have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f₀) := inferInstance
    have _ : AlgebraicGeometry.IsProper (AlgebraicGeometry.Spec.map f₀) := inferInstance
    change AlgebraicGeometry.IsProper
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫ AlgebraicGeometry.Spec.map f₀)
    infer_instance

  have hColimProperAll : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.IsProper B.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ),
      (∀ (ℬ : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsConstructibleModPrimeSheaf ℓ B.left ℬ → Subsingleton (ℬ.H r)) →
      ∀ (𝒜 : CategoryTheory.Sheaf B.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id 𝒜 = 0 → Subsingleton (𝒜.H r) := by
    intro k₀ _ _ B _ ℓ hFactℓ r hConstr 𝒜 h𝒜_tor
    have hPrime : Nat.Prime ℓ := hFactℓ.out
    exact (weil_etale_noetherian_ind_godement_and_colimit_reduction k₀ B).1 ℓ r
      (weil_etale_ordinary_godement_resolution B.left ℓ hPrime.pos) hConstr 𝒜 h𝒜_tor

  have hCurveVanishAll : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
      AlgebraicGeometry.IsIntegral C.left →
      IsProjectiveOverField k₀ C →
      ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], (ℓ : k₀) ≠ 0 →
      ∀ (q' : ℕ), 3 ≤ q' → Subsingleton (weilEtaleTorsionH C.left ℓ q') := by
    intro k₀ _ _ C _ hIntC hProjC ℓ _ hℓ₀ q' hq'
    exact (weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀).2.1 q' hq'

  have hP1StrictLocal : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
      (κ₀ : Type u) [Field κ₀] [IsAlgClosed κ₀], (ℓ : κ₀) ≠ 0 →
      ∀ (A : Type u) [CommRing A] [Algebra κ₀ A] (τ_A : A →ₐ[κ₀] κ₀),
        WeilIsStrictLocalNoetherianAlgClosedRing κ₀ A τ_A →
        ∀ (p : ℕ), 3 ≤ p →
