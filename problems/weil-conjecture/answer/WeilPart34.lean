                    TensorProduct.tmul R a (TensorProduct.tmul R (1 : S l₁) d) := by
                rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
              rw [hprod, map_mul]
              rfl
            exact fun z => LinearMap.congr_fun hf z
          have h_rhs_sum : α_assoc.symm (∑ j : Fin m,
              LinearMap.baseChange (S l₀) (mulRight_R (χ l₁ l₂ k j)) (u j l₂)) =
                ∑ j : Fin m, ι₂₃ (χ l₁ l₂ k j) * ι₁₃ (u j l₂) := by
            rw [map_sum]
            exact Finset.sum_congr rfl fun j _ => h_mul_eq (χ l₁ l₂ k j) (u j l₂)
          rw [h_inl_eq, h_rhs_sum]
          dsimp [u]
          simp_rw [map_sum, map_mul]
          have hy_12 : ∀ i₀ : Fin m,
              ι₁₂ (TensorProduct.tmul R (y i₀) (1 : S l₁)) =
                TensorProduct.tmul R (TensorProduct.tmul R (y i₀) (1 : S l₁)) (1 : S l₂) :=
            fun _ => rfl
          have hy_13 : ∀ i₀ : Fin m,
              ι₁₃ (TensorProduct.tmul R (y i₀) (1 : S l₂)) =
                TensorProduct.tmul R (TensorProduct.tmul R (y i₀) (1 : S l₁)) (1 : S l₂) :=
            fun _ => rfl
          simp_rw [hy_12, hy_13, Finset.mul_sum, ← mul_assoc]
          rw [Finset.sum_comm]
          apply sub_eq_zero.mpr
          refine Finset.sum_congr rfl fun i₀ _ => ?_
          rw [← Finset.sum_mul]
          congr 1
          symm
          calc ∑ j : Fin m, ι₂₃ (χ l₁ l₂ k j) * ι₁₃ (χ l₀ l₂ i₀ j)
              = ∑ j : Fin m, ι₁₃ (χ l₀ l₂ i₀ j) * ι₂₃ (χ l₁ l₂ k j) :=
                Finset.sum_congr rfl fun j _ => mul_comm _ _
            _ = ∑ j : Fin m,
