                TensorProduct.tmul R (μ₀ v) (1 : S l₂) := by
            let fL : TensorProduct R (S l₀) (S l₀) →ₗ[R] TensorProduct R (S l₀) (S l₂) :=
              C_l₂.toLinearMap.comp
                ((LinearMap.baseChange (S l₀) (inl_R l₀ l₂)).restrictScalars R)
            let fR : TensorProduct R (S l₀) (S l₀) →ₗ[R] TensorProduct R (S l₀) (S l₂) :=
