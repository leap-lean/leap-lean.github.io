        have h2 : (α_h.hom.app (Opposite.op (M_E.obj U₀)))
            ((η_S₂.app (Opposite.op (M_E.obj U₀))) a) =
            (η_S₁.app (Opposite.op (B_h.obj (M_E.obj U₀)))) a :=
          congrArg (fun ν : const_S₂ ⟶ (pf_h.obj G₁).obj =>
            (ν.app (Opposite.op (M_E.obj U₀))) a) hα_h_sh
        exact (congrArg (α_h.hom.app (Opposite.op (M_E.obj U₀))) h1).trans h2
      have hrhs : ((η_W ≫ (CategoryTheory.sheafToPresheaf J_W AddCommGrpCat.{u}).map
            (α_h' ≫ pf_h'.map θ_w' ≫ ε_sq)).app (Opposite.op U₀)) a =
          (η_S₁.app (Opposite.op (B_h.obj (M_E.obj U₀)))) a := by
        have h1 : ((η_W ≫ α_h'.hom).app (Opposite.op U₀)) a =
            (η_W'.app (Opposite.op (B_h'.obj U₀))) a :=
          congrArg (fun ν : const_W ⟶ (pf_h'.obj G_W').obj =>
            (ν.app (Opposite.op U₀)) a) hα_h'_sh
        have h2 : (θ_w'.hom.app (Opposite.op (B_h'.obj U₀)))
            ((η_W'.app (Opposite.op (B_h'.obj U₀))) a) =
            (η_S₁.app (Opposite.op (M_w'.obj (B_h'.obj U₀)))) a :=
