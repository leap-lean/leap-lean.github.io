          map_mul' := fun _ _ => Subtype.ext rfl
          map_zero' := Subtype.ext rfl
          map_add' := fun _ _ => Subtype.ext rfl
          commutes' := fun _ => Subtype.ext rfl }
      have h_lTensor_bij : Function.Bijective (f_res.toLinearMap.lTensor S_J) := by
        let eqv_left : TensorProduct R S_J ↥B ≃ₗ[R] ∀ j : J, TensorProduct R (S (ι_J j)) ↥B :=
          (Algebra.TensorProduct.comm R S_J ↥B).toLinearEquiv.trans
            (((TensorProduct.piRight R ↥B ↥B (fun j : J => S (ι_J j))).restrictScalars R).trans
