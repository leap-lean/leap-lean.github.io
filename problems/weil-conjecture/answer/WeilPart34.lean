      hPBC Z P_base S_pt Z_s f g_s f'_s g'_s inferInstance hPb_s _ _ (hTorsSh Z.left) hPB_tors q
    obtain ⟨F'_s, hPB_F's, hCons_F's⟩ := hSerre.2.2.1 S_pt P_base g_s Rq
    obtain ⟨e_Fs⟩ := hUniquePB s Rq F'_s
