  have hCounitIso : ∀ (H : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.IsIso (adj_i.counit.app H) := by
    intro H
    let M := pb_i.obj (pf_i.obj H)
    let ε_H : M ⟶ H := adj_i.counit.app H
    let Θ : ∀ {K : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}},
        (M ⟶ K) → (H ⟶ K) :=
      fun {K} h => e_pf.inv.app H ≫ pf_π.map (adj_i.homEquiv (pf_i.obj H) K h) ≫ e_pf.hom.app K
    have hΘ_nat : ∀ {K K' : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}}
        (h : M ⟶ K) (g : K ⟶ K'), Θ (h ≫ g) = Θ h ≫ g := by
      intro K K' h g
      dsimp [Θ]
      rw [adj_i.homEquiv_naturality_right, pf_π.map_comp, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc]
      have hnat := e_pf.hom.naturality g
      change pf_π.map (pf_i.map g) ≫ e_pf.hom.app K' = e_pf.hom.app K ≫ g at hnat
      rw [hnat]
      simp only [CategoryTheory.Category.assoc]
    let s_H : H ⟶ M := Θ (𝟙 M)
    have hs_comp : ∀ {K : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}}
        (h : M ⟶ K), s_H ≫ h = Θ h := by
      intro K h
      dsimp [s_H]
      rw [← hΘ_nat (𝟙 M) h, CategoryTheory.Category.id_comp]
    have hs_ε : s_H ≫ ε_H = 𝟙 H := by
      rw [hs_comp ε_H]
      dsimp [Θ, ε_H]
      have h_eqv : adj_i.homEquiv (pf_i.obj H) H (adj_i.counit.app H) = 𝟙 (pf_i.obj H) := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        exact adj_i.right_triangle_components H
      rw [h_eqv, pf_π.map_id, CategoryTheory.Category.id_comp, e_pf.inv_hom_id_app]
      rfl
    have _ : CategoryTheory.Epi s_H := by
      refine ⟨fun {K} h₁ h₂ heq => ?_⟩
      let h : M ⟶ K := h₁ - h₂
      have hsh0 : s_H ≫ h = 0 := by
        dsimp [h]
        rw [CategoryTheory.Preadditive.comp_sub, heq, sub_self]
      rw [hs_comp h] at hsh0
      have hpf0 : pf_π.map (adj_i.homEquiv (pf_i.obj H) K h) = 0 := by
        have h1 := congrArg (fun m => e_pf.hom.app H ≫ m ≫ e_pf.inv.app K) hsh0
        dsimp [Θ] at h1
        simp only [CategoryTheory.Category.assoc, e_pf.hom_inv_id_app_assoc,
          e_pf.hom_inv_id_app, CategoryTheory.Limits.comp_zero,
          CategoryTheory.Limits.zero_comp] at h1
        exact (CategoryTheory.Category.comp_id _).symm.trans h1
      have hφ0 : adj_i.homEquiv (pf_i.obj H) K h = 0 := hFaithful_pfπ _ hpf0
      have hh0 : h = 0 := by
        apply (adj_i.homEquiv (pf_i.obj H) K).injective
        rw [hφ0, CategoryTheory.Adjunction.homEquiv_unit, pf_i.map_zero,
          CategoryTheory.Limits.comp_zero]
      exact sub_eq_zero.mp hh0
    have hε_s : ε_H ≫ s_H = 𝟙 M := by
      apply (CategoryTheory.cancel_epi s_H).mp
      rw [← CategoryTheory.Category.assoc, hs_ε, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
    exact ⟨⟨s_H, hε_s, hs_ε⟩⟩

  
  
  
  have hEmptyVanish : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}} [hEmp : IsEmpty ↥W₁]
      (h : W₁ ⟶ W₂)
      (F₀ : CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h q F₀) := by
    intro W₁ W₂ hEmp h F₀ q
    have hIdF₀ : CategoryTheory.CategoryStruct.id F₀ = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opE
      apply AddCommGrpCat.ext
      intro s
      let E : W₁.Etale := opE.unop
      have hEmpE : IsEmpty ↥E.left := ⟨fun y => hEmp.elim (E.hom.base y)⟩
      have hBot : (⊥ : CategoryTheory.Sieve E) ∈ W₁.smallEtaleTopology E :=
        (hMemEt E ⊥).mpr (fun y => hEmpE.elim y)
      exact F₀.isSeparated E ⊥ hBot s 0 (fun _ _ hg => False.elim hg)
    let B_h : CategoryTheory.Functor W₂.Etale W₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
    let P_pre : CategoryTheory.Functor (Opposite W₂.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B_h.op (CategoryTheory.Sheaf.cohomologyPresheaf F₀ q)
    have hZ_pre : CategoryTheory.Limits.IsZero P_pre := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply CategoryTheory.NatTrans.ext
      funext opV
      apply AddCommGrpCat.ext
      intro α
      let α' : CategoryTheory.Abelian.Ext _ F₀ q := α
      change α' = 0
      calc α' = α'.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F₀))
              (Nat.add_zero q) := (CategoryTheory.Abelian.Ext.comp_mk₀_id α').symm
        _ = α'.comp (CategoryTheory.Abelian.Ext.mk₀ 0) (Nat.add_zero q) := by rw [hIdF₀]
        _ = 0 := by
            rw [CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
    exact (CategoryTheory.presheafToSheaf W₂.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
      hZ_pre

  have hIdVan_tors : ∀ (W : AlgebraicGeometry.Scheme.{u}) (b : ℕ)
