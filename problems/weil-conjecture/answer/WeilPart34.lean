                rw [Finset.sum_eq_single k]
                · simp
                · intro k' _ hkk'
                  split_ifs with h
                  · exact absurd h hkk'
                  · exact mul_zero _
                · intro hk; exact absurd (Finset.mem_univ k) hk
        obtain ⟨w, hw⟩ := (hΔ_exact u).mp hu_ker
        refine ⟨w, ?_⟩
        funext k
        rw [he_via_ι w k, hw, hu_diag k]
    let e_prod_hom : TensorProduct R S_prod ↥B →ₐ[S_prod] (Fin m → S_prod) :=
      Algebra.TensorProduct.lift
        (Algebra.ofId S_prod (Fin m → S_prod))
        (AlgHom.pi fun i : Fin m => (Pi.evalAlgHom R (fun _ : Fin m => S_prod) i).comp B.val)
        (fun _ _ => Commute.all _ _)
    have he_prod_tmul : ∀ (s : S_prod) (b : ↥B),
        e_prod_hom (TensorProduct.tmul R s b) = fun i l => s l * b.1 i l := by
      intro s b
      rfl
    have he_prod_bij : Function.Bijective e_prod_hom := by
      let eqv_left : TensorProduct R S_prod ↥B ≃ₗ[R] ∀ l₀ : I, TensorProduct R (S l₀) ↥B :=
        (Algebra.TensorProduct.comm R S_prod ↥B).toLinearEquiv.trans
          (((TensorProduct.piRight R ↥B ↥B S).restrictScalars R).trans
            (LinearEquiv.piCongrRight fun l₀ =>
              (Algebra.TensorProduct.comm R ↥B (S l₀)).toLinearEquiv))
