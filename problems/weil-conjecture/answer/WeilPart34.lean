      (Algebra.Etale.iff_exists_algEquiv_prod k_p F_p).mp inferInstance
    let _ : Finite I := hFinI
    let _ : ∀ i : I, Field (Ai i) := hFieldAi
    let _ : ∀ i : I, Algebra k_p (Ai i) := hAlgAi
    have _ : ∀ i : I, Module.Finite k_p (Ai i) := fun i => (hFin_i i).1
    have _ : Module.Finite k_p ((i : I) → Ai i) := Module.Finite.pi
    have _ : Module.Finite k_p F_p := Module.Finite.equiv e_prod.symm.toLinearEquiv
    have _ : Ring.KrullDimLE 0 F_p := (Module.finite_iff_krullDimLE_zero k_p F_p).mp inferInstance
    let x₁ : ↑(PrimeSpectrum.comap (algebraMap R₁Ω B''_Ω) ⁻¹' {p}) := ⟨P₁, rfl⟩
    let x₂ : ↑(PrimeSpectrum.comap (algebraMap R₁Ω B''_Ω) ⁻¹' {p}) := ⟨P₂, heq.symm⟩
    have hx_lt : x₁ < x₂ := hP
    let Θ := PrimeSpectrum.preimageOrderIsoFiber R₁Ω B''_Ω p
    have hΘ_lt : Θ x₁ < Θ x₂ := Θ.strictMono hx_lt
    have _ : (Θ x₁).asIdeal.IsMaximal := Ideal.isMaximal_of_isPrime (Θ x₁).asIdeal
    have hMax : IsMax (Θ x₁) := PrimeSpectrum.isMax_iff.mpr inferInstance
    exact IsMax.not_lt hMax hΘ_lt
  have hDim_P_eq : ringKrullDim P_Ω = ringKrullDim P_κ := by
    dsimp [P_Ω, P_κ]
    rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field Ω,
      MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field κ]
  refine ⟨hLFT, ?_⟩
  change topologicalKrullDim (PrimeSpectrum B''_Ω) ≤ (d : WithBot ℕ∞)
  rw [PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim]
  exact hDim_B''_le.trans (hDim_R₁Ω_le.trans (hDim_P_eq.le.trans hDim_Pκ_le_d))

