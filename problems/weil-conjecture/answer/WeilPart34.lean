      · exact hh₂.symm
      · exact Subsingleton.elim _ _
    rw [ha_fac, hb_fac, op_comp, op_comp, op_comp,
      𝒢.obj.map_comp, 𝒢.obj.map_comp, 𝒢.obj.map_comp]
    exact congrArg (𝒢.obj.map h_et.op).hom hsec_D
  exact asm_s5 P 𝒢 A₀ T hT (Fin n₀ ⊕ Fin n₁) S_dom w_all hw_all hCov_dom ψ_all hψ_all e_A
    r hr q_idemp hq_idem hq_orth hq_ne hq_vanish hq_sec

theorem weil_projLine_sc_laurent_glued_etale_alg_idempotents (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (B₀ B₁ B₀₁ S₀ S₁ R₀₁_inv : Type u)
    [CommRing B₀] [CommRing B₁] [CommRing B₀₁]
    [CommRing S₀] [IsReduced S₀] [CommRing S₁] [IsReduced S₁] [CommRing R₀₁_inv]
    [Algebra k B₀] [Algebra (Polynomial k) B₀] [IsScalarTower k (Polynomial k) B₀]
    [Algebra k B₁] [Algebra (Polynomial k) B₁] [IsScalarTower k (Polynomial k) B₁]
    [Algebra k B₀₁] [Algebra (Localization.Away (Polynomial.X : Polynomial k)) B₀₁]
    [IsScalarTower k (Localization.Away (Polynomial.X : Polynomial k)) B₀₁]
    [Algebra (Polynomial k) S₀] [Module.FaithfullyFlat (Polynomial k) S₀]
    [Algebra (Polynomial k) S₁] [Module.FaithfullyFlat (Polynomial k) S₁]
    [Algebra k R₀₁_inv] [Algebra (Polynomial k) R₀₁_inv] [IsScalarTower k (Polynomial k) R₀₁_inv]
    (e_inv : R₀₁_inv ≃ₐ[k] Localization.Away (Polynomial.X : Polynomial k))
    (he_inv : ∀ s : Polynomial k,
      e_inv (algebraMap (Polynomial k) R₀₁_inv s) =
        (Polynomial.aeval (IsLocalization.Away.invSelf
          (S := Localization.Away (Polynomial.X : Polynomial k))
          (Polynomial.X : Polynomial k))).toRingHom s)
    (e₀ : TensorProduct (Polynomial k) S₀ B₀ ≃ₐ[S₀] (Fin m → S₀))
    (e₁ : TensorProduct (Polynomial k) S₁ B₁ ≃ₐ[S₁] (Fin m → S₁))
    (φ₀ : B₀ →ₐ[k] B₀₁)
    (φ₁ : B₁ →ₐ[k] B₀₁)
    (hφ₀ : ∀ (r : Polynomial k) (b₀ : B₀),
      φ₀ (r • b₀) =
        algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)) r • φ₀ b₀)
    (hφ₁ : ∀ (s : Polynomial k) (b₁ : B₁),
      φ₁ (s • b₁) =
        (Polynomial.aeval (IsLocalization.Away.invSelf
          (S := Localization.Away (Polynomial.X : Polynomial k))
          (Polynomial.X : Polynomial k))).toRingHom s • φ₁ b₁)
    (f₀_lin : TensorProduct (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)) B₀ →+
      B₀₁)
    (hf₀_tmul : ∀ (r₀₁ : Localization.Away (Polynomial.X : Polynomial k)) (b₀ : B₀),
      f₀_lin (TensorProduct.tmul (Polynomial k) r₀₁ b₀) = r₀₁ • φ₀ b₀)
    (hf₀_bij : Function.Bijective f₀_lin)
    (f₁_lin : TensorProduct (Polynomial k) R₀₁_inv B₁ →+ B₀₁)
    (hf₁_tmul : ∀ (r' : R₀₁_inv) (b₁ : B₁),
      f₁_lin (TensorProduct.tmul (Polynomial k) r' b₁) = e_inv r' • φ₁ b₁)
    (hf₁_bij : Function.Bijective f₁_lin) :
    ∃ (r : ℕ) (p : Fin r → B₀ × B₁),
      m ≤ r ∧
      (∀ i : Fin r, φ₀ (p i).1 = φ₁ (p i).2) ∧
      (∀ i : Fin r, p i ≠ 0) ∧
      (∀ i : Fin r, p i * p i = p i) ∧
      (∀ i j : Fin r, i ≠ j → p i * p j = 0) ∧
      (∑ i : Fin r, p i) = 1 :=
by
  classical
  let _ := he_inv
  
  have h_part1 : ∀ (B S : Type u) [CommRing B] [CommRing S] [IsReduced S]
      [Algebra (Polynomial k) B]
      [Algebra (Polynomial k) S] [Module.FaithfullyFlat (Polynomial k) S]
      (_ : TensorProduct (Polynomial k) S B ≃ₐ[S] (Fin m → S)),
      IsReduced B ∧
      ∃ (v : Module.Basis (Fin m) (Polynomial k) B) (d : k),
        d ≠ 0 ∧
        (Matrix.of fun a b : Fin m =>
          LinearMap.trace (Polynomial k) B
            (Algebra.lmul (Polynomial k) B (v a * v b))).det = Polynomial.C d := by
    intro B S _ _ _ _ _ _ e
    let R₀ := Polynomial k
    have h_pure_inj : ∀ {M : Type u} [AddCommGroup M] [Module R₀ M] (m₀ : M),
        (1 : S) ⊗ₜ[R₀] m₀ = (0 : TensorProduct R₀ S M) → m₀ = 0 := by
      intro M _ _ m₀ hm₀
      let f : R₀ →ₗ[R₀] M := LinearMap.toSpanSingleton R₀ M m₀
      have hf0 : LinearMap.lTensor S f = 0 := by
        apply TensorProduct.ext'
        intro s r
        rw [LinearMap.lTensor_tmul, LinearMap.zero_apply]
        change s ⊗ₜ[R₀] (r • m₀) = 0
        rw [← TensorProduct.smul_tmul, ← mul_one (r • s), ← smul_eq_mul,
          ← TensorProduct.smul_tmul', hm₀, smul_zero]
      have hf : f = 0 := (Module.FaithfullyFlat.zero_iff_lTensor_zero R₀ S f).mpr hf0
      have h1 := LinearMap.congr_fun hf (1 : R₀)
      simpa [f, LinearMap.toSpanSingleton_apply] using h1
    have : Nontrivial S := ⟨⟨0, 1, fun h01 => by
      have h1 : (1 : S) ⊗ₜ[R₀] (1 : R₀) = 0 := by rw [← h01, TensorProduct.zero_tmul]
      exact one_ne_zero (h_pure_inj (1 : R₀) h1)⟩⟩
    let ι_B : B →ₐ[R₀] (Fin m → S) :=
      (e.toAlgHom.restrictScalars R₀).comp Algebra.TensorProduct.includeRight
    have hι_apply : ∀ b : B, ι_B b = e ((1 : S) ⊗ₜ[R₀] b) := fun _ => rfl
    have hι_inj : Function.Injective ι_B := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      rw [hι_apply] at hb
      exact h_pure_inj b (e.injective (hb.trans (map_zero e).symm))
    have hRedB : IsReduced B := ⟨fun b ⟨n, hbn⟩ => by
      apply hι_inj
      rw [map_zero]
      funext i
      have hi : (ι_B b i) ^ n = 0 := by
        change ((ι_B b) ^ n) i = 0
        rw [← map_pow, hbn, map_zero, Pi.zero_apply]
      exact IsReduced.eq_zero _ ⟨n, hi⟩⟩
    have : Module.Flat R₀ S := Module.FaithfullyFlat.toFlat
    have : Module.IsTorsionFree R₀ S := Module.Flat.isTorsionFree
    have : Module.IsTorsionFree R₀ B :=
      Function.Injective.moduleIsTorsionFree ι_B hι_inj (fun r b => map_smul ι_B r b)
    have h_ex : ∀ i : Fin m, ∃ F : Finset (S × B),
        e.symm (Pi.single i 1) = ∑ p ∈ F, p.1 ⊗ₜ[R₀] p.2 :=
      fun i => TensorProduct.exists_finset _
    choose F hF using h_ex
    let G : Finset B := Finset.univ.biUnion (fun i => (F i).image Prod.snd)
    let N : Submodule R₀ B := Submodule.span R₀ (G : Set B)
    have hmkQ_lTensor : LinearMap.lTensor S N.mkQ = 0 := by
      have h_basis_zero : ∀ (i : Fin m) (s : S),
          LinearMap.lTensor S N.mkQ (s • e.symm (Pi.single i 1)) = 0 := by
        intro i s
        rw [hF i, Finset.smul_sum, map_sum]
        refine Finset.sum_eq_zero fun p hp => ?_
        rw [TensorProduct.smul_tmul', LinearMap.lTensor_tmul]
        have hpG : p.2 ∈ G :=
          Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, Finset.mem_image_of_mem Prod.snd hp⟩
        have hpN : N.mkQ p.2 = 0 :=
          (Submodule.Quotient.mk_eq_zero N).mpr (Submodule.subset_span hpG)
        rw [hpN, TensorProduct.tmul_zero]
      apply LinearMap.ext
      intro w
      have hw_decomp : w = ∑ i : Fin m, (e w i) • e.symm (Pi.single i 1) := by
        apply e.injective
        rw [map_sum]
        funext j
        simp [Finset.sum_apply, Pi.single_apply]
      rw [hw_decomp, map_sum, LinearMap.zero_apply]
      exact Finset.sum_eq_zero fun i _ => h_basis_zero i (e w i)
    have hmkQ0 : N.mkQ = 0 :=
      (Module.FaithfullyFlat.zero_iff_lTensor_zero R₀ S N.mkQ).mpr hmkQ_lTensor
    have hN_top : N = ⊤ := by
      rw [eq_top_iff]
      intro b _
      have hb0 : N.mkQ b = 0 := LinearMap.congr_fun hmkQ0 b
      exact (Submodule.Quotient.mk_eq_zero N).mp hb0
    have : Module.Finite R₀ B := ⟨⟨G, hN_top⟩⟩
    have : Module.Free R₀ B := Module.free_of_finite_type_torsion_free'
    have h_rk : Module.finrank R₀ B = m := by
      calc Module.finrank R₀ B
          = Module.finrank S (TensorProduct R₀ S B) :=
              (Module.finrank_baseChange (S := R₀) (R := S) (M' := B)).symm
        _ = Module.finrank S (Fin m → S) := LinearEquiv.finrank_eq e.toLinearEquiv
        _ = m := by rw [Module.finrank_pi, Fintype.card_fin]
    let v : Module.Basis (Fin m) R₀ B := Module.finBasisOfFinrankEq R₀ B h_rk
    let u_S : Module.Basis (Fin m) S (Fin m → S) := (v.baseChange S).map e.toLinearEquiv
    have hu_S : ∀ a : Fin m, u_S a = ι_B (v a) := by
      intro a
      simp [u_S, hι_apply, Module.Basis.map_apply, Module.Basis.baseChange_apply]
    let e_std : Module.Basis (Fin m) S (Fin m → S) := Pi.basisFun S (Fin m)
    have htrace_B : ∀ x : B,
        algebraMap R₀ S (LinearMap.trace R₀ B (Algebra.lmul R₀ B x)) =
          ∑ i : Fin m, ι_B x i := by
      intro x
      have h1 : algebraMap R₀ S (LinearMap.trace R₀ B (Algebra.lmul R₀ B x)) =
          LinearMap.trace S (Fin m → S) (Algebra.lmul S (Fin m → S) (ι_B x)) := by
        rw [LinearMap.trace_eq_matrix_trace R₀ v (Algebra.lmul R₀ B x),
          LinearMap.trace_eq_matrix_trace S u_S (Algebra.lmul S (Fin m → S) (ι_B x))]
        simp only [Matrix.trace, Matrix.diag, map_sum, LinearMap.toMatrix_apply]
        refine Finset.sum_congr rfl fun c _ => ?_
        change algebraMap R₀ S ((v.repr (x * v c)) c) = (u_S.repr (ι_B x * u_S c)) c
        have h_exp : ι_B (x * v c) =
            ∑ d : Fin m, algebraMap R₀ S ((v.repr (x * v c)) d) • u_S d := by
          conv_lhs => rw [← v.sum_repr (x * v c)]
          rw [map_sum]
          refine Finset.sum_congr rfl fun d _ => ?_
          rw [map_smul, hu_S, IsScalarTower.algebraMap_smul]
        have h_mul : ι_B x * u_S c = ι_B (x * v c) := by rw [hu_S, map_mul]
        rw [h_mul, h_exp, map_sum, Finsupp.finsetSum_apply]
        have h_term : ∀ d : Fin m,
            (u_S.repr (algebraMap R₀ S ((v.repr (x * v c)) d) • u_S d)) c =
              if d = c then algebraMap R₀ S ((v.repr (x * v c)) d) else 0 := by
          intro d
          rw [u_S.repr.map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
            Finsupp.single_apply]
        simp_rw [h_term]
        simp
      have h2 : LinearMap.trace S (Fin m → S) (Algebra.lmul S (Fin m → S) (ι_B x)) =
          ∑ i : Fin m, ι_B x i := by
        rw [LinearMap.trace_eq_matrix_trace S e_std (Algebra.lmul S (Fin m → S) (ι_B x))]
        simp only [Matrix.trace, Matrix.diag, LinearMap.toMatrix_apply]
        refine Finset.sum_congr rfl fun i _ => ?_
        change (e_std.repr (ι_B x * e_std i)) i = ι_B x i
        simp [e_std, Pi.basisFun_apply, Pi.basisFun_repr]
      exact h1.trans h2
    let T : Matrix (Fin m) (Fin m) R₀ :=
      Matrix.of fun a b : Fin m => LinearMap.trace R₀ B (Algebra.lmul R₀ B (v a * v b))
    let P_S : Matrix (Fin m) (Fin m) S := Matrix.of fun a i : Fin m => u_S a i
    have hT_map : (algebraMap R₀ S).mapMatrix T = P_S * P_S.transpose := by
      ext a b
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.mul_apply]
      change algebraMap R₀ S (LinearMap.trace R₀ B (Algebra.lmul R₀ B (v a * v b))) =
        ∑ j : Fin m, u_S a j * u_S b j
      rw [htrace_B (v a * v b)]
      simp [map_mul, hu_S]
    have hPS_tr : P_S.transpose = e_std.toMatrix u_S := by
      ext i a
      simp [P_S, Module.Basis.toMatrix_apply, e_std, Pi.basisFun_repr]
    have hPS_unit : IsUnit P_S.det := by
      have hmul : P_S.transpose * u_S.toMatrix e_std = 1 := by
        rw [hPS_tr, Module.Basis.toMatrix_mul_toMatrix, Module.Basis.toMatrix_self]
      have hdet1 : P_S.det * (u_S.toMatrix e_std).det = 1 := by
        calc P_S.det * (u_S.toMatrix e_std).det
            = P_S.transpose.det * (u_S.toMatrix e_std).det := by rw [Matrix.det_transpose]
          _ = (P_S.transpose * u_S.toMatrix e_std).det := (Matrix.det_mul _ _).symm
          _ = 1 := by rw [hmul, Matrix.det_one]
      exact ⟨⟨P_S.det, (u_S.toMatrix e_std).det, hdet1, mul_comm P_S.det _ ▸ hdet1⟩, rfl⟩
    have hTdet_S_unit : IsUnit (algebraMap R₀ S T.det) := by
      rw [RingHom.map_det, hT_map, Matrix.det_mul, Matrix.det_transpose]
      exact hPS_unit.mul hPS_unit
    have hTdet_unit : IsUnit T.det := by
      rcases hTdet_S_unit with ⟨u₀, hu₀⟩
      let I : Ideal R₀ := Ideal.span {T.det}
      let q_I : R₀ →ₗ[R₀] R₀ ⧸ I := Submodule.mkQ I
      have hq_lTensor : LinearMap.lTensor S q_I = 0 := by
        apply TensorProduct.ext'
        intro s r
        rw [LinearMap.lTensor_tmul, LinearMap.zero_apply]
        have hs : s = T.det • (↑u₀⁻¹ * s) := by
          rw [Algebra.smul_def, ← hu₀, ← mul_assoc, Units.mul_inv, one_mul]
        conv_lhs => rw [hs]
        rw [TensorProduct.smul_tmul]
        have hqr : q_I (T.det • r) = 0 := by
          refine (Submodule.Quotient.mk_eq_zero I).mpr ?_
          rw [smul_eq_mul, Ideal.mem_span_singleton]
          exact dvd_mul_right T.det r
        rw [← map_smul, hqr, TensorProduct.tmul_zero]
      have hq0 : q_I = 0 :=
        (Module.FaithfullyFlat.zero_iff_lTensor_zero R₀ S q_I).mpr hq_lTensor
      have h1_mem : (1 : R₀) ∈ I :=
        (Submodule.Quotient.mk_eq_zero I).mp (LinearMap.congr_fun hq0 1)
      exact isUnit_iff_dvd_one.mpr (Ideal.mem_span_singleton.mp h1_mem)
    obtain ⟨d, hd_unit, hd_eq⟩ := Polynomial.isUnit_iff.mp hTdet_unit
    exact ⟨hRedB, v, d, hd_unit.ne_zero, hd_eq.symm⟩

  obtain ⟨hRed₀, v₀, d₀, hd₀, hdet₀⟩ := h_part1 B₀ S₀ e₀
  obtain ⟨hRed₁, v₁, d₁, _hd₁, hdet₁⟩ := h_part1 B₁ S₁ e₁

  
  let R₀ := Polynomial k
  let R₀₁ := Localization.Away (Polynomial.X : R₀)
  let j₀ : R₀ →+* R₀₁ := algebraMap R₀ R₀₁
  let X_inv : R₀₁ := IsLocalization.Away.invSelf (S := R₀₁) (Polynomial.X : R₀)
  let j₁ : R₀ →+* R₀₁ := (Polynomial.aeval X_inv).toRingHom
  have hj₀_inj : Function.Injective j₀ := by
    refine @IsLocalization.injective R₀ _ (Submonoid.powers (Polynomial.X : R₀)) R₀₁ _ _ _ ?_
    rw [Submonoid.powers_le]
    exact mem_nonZeroDivisors_of_ne_zero Polynomial.X_ne_zero
  have hX_mul_inv : j₀ Polynomial.X * X_inv = 1 :=
    IsLocalization.Away.mul_invSelf (S := R₀₁) (Polynomial.X : R₀)
  have hj₁_X : j₁ Polynomial.X = X_inv := Polynomial.aeval_X X_inv
  have hj₁_C : ∀ α : k, j₁ (Polynomial.C α) = j₀ (Polynomial.C α) := fun α => by
    change Polynomial.aeval X_inv (Polynomial.C α) = j₀ (algebraMap k R₀ α)
    rw [Polynomial.aeval_C, IsScalarTower.algebraMap_apply k R₀ R₀₁]

  have h_part2 : ∃ (M M_inv : Matrix (Fin m) (Fin m) R₀₁) (c : k),
      c ≠ 0 ∧
      M_inv * M = 1 ∧
      M.det = j₀ (Polynomial.C c) ∧
      ∀ (x₀ : B₀) (x₁ : B₁),
        φ₀ x₀ = φ₁ x₁ ↔
          M.mulVec (fun b => j₀ (v₀.repr x₀ b)) = (fun a => j₁ (v₁.repr x₁ a)) := by
    let L₀ : (Fin m → R₀₁) →ₗ[R₀₁] B₀₁ :=
      { toFun := fun c => ∑ b : Fin m, c b • φ₀ (v₀ b)
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun r c => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum, RingHom.id_apply] }
    have hL₀_eq : (L₀ : (Fin m → R₀₁) → B₀₁) =
        f₀_lin ∘ (v₀.baseChange R₀₁).equivFun.symm := by
      funext c
      simp only [L₀, LinearMap.coe_mk, AddHom.coe_mk, Function.comp_apply,
        Module.Basis.equivFun_symm_apply, map_sum, Module.Basis.baseChange_apply,
        TensorProduct.smul_tmul', smul_eq_mul, mul_one, hf₀_tmul]
    have hL₀_bij : Function.Bijective L₀ := by
      rw [hL₀_eq]
      exact hf₀_bij.comp (v₀.baseChange R₀₁).equivFun.symm.bijective
    let w₀ : Module.Basis (Fin m) R₀₁ B₀₁ :=
      Module.Basis.ofEquivFun (LinearEquiv.ofBijective L₀ hL₀_bij).symm
    have hw₀ : ∀ b : Fin m, w₀ b = φ₀ (v₀ b) := by
      intro b
      rw [Module.Basis.coe_ofEquivFun]
      simp [L₀, Pi.single_apply]
    let L₁ : (Fin m → R₀₁) →ₗ[R₀₁] B₀₁ :=
      { toFun := fun c => ∑ a : Fin m, c a • φ₁ (v₁ a)
        map_add' := fun c₁ c₂ => by
          simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
        map_smul' := fun r c => by
          simp only [Pi.smul_apply, smul_eq_mul, mul_smul, Finset.smul_sum, RingHom.id_apply] }
    let e_pi_inv : (Fin m → R₀₁) ≃ (Fin m → R₀₁_inv) :=
      Equiv.piCongrRight (fun _ => e_inv.symm.toEquiv)
    have hL₁_eq : (L₁ : (Fin m → R₀₁) → B₀₁) =
        f₁_lin ∘ (v₁.baseChange R₀₁_inv).equivFun.symm ∘ e_pi_inv := by
      funext c
      simp only [L₁, LinearMap.coe_mk, AddHom.coe_mk, Function.comp_apply, e_pi_inv,
        Equiv.piCongrRight_apply, Pi.map_apply, AlgEquiv.toEquiv_eq_coe, EquivLike.coe_coe,
        Module.Basis.equivFun_symm_apply, map_sum, Module.Basis.baseChange_apply,
        TensorProduct.smul_tmul', smul_eq_mul, mul_one, hf₁_tmul, AlgEquiv.apply_symm_apply]
    have hL₁_bij : Function.Bijective L₁ := by
      rw [hL₁_eq]
      exact hf₁_bij.comp ((v₁.baseChange R₀₁_inv).equivFun.symm.bijective.comp e_pi_inv.bijective)
    let w₁ : Module.Basis (Fin m) R₀₁ B₀₁ :=
      Module.Basis.ofEquivFun (LinearEquiv.ofBijective L₁ hL₁_bij).symm
    have hw₁ : ∀ a : Fin m, w₁ a = φ₁ (v₁ a) := by
      intro a
      rw [Module.Basis.coe_ofEquivFun]
      simp [L₁, Pi.single_apply]
    let M : Matrix (Fin m) (Fin m) R₀₁ := w₁.toMatrix w₀
    let M_inv : Matrix (Fin m) (Fin m) R₀₁ := w₀.toMatrix w₁
    have hM_inv : M_inv * M = 1 := by
      dsimp [M, M_inv]
      rw [Module.Basis.toMatrix_mul_toMatrix, Module.Basis.toMatrix_self]
    have hGlued : ∀ (x₀ : B₀) (x₁ : B₁),
        φ₀ x₀ = φ₁ x₁ ↔
          M.mulVec (fun b => j₀ (v₀.repr x₀ b)) = (fun a => j₁ (v₁.repr x₁ a)) := by
      intro x₀ x₁
      have hx₀ : (w₁.repr (φ₀ x₀) : Fin m → R₀₁) = M.mulVec (fun b => j₀ (v₀.repr x₀ b)) := by
        have hsum₀ : φ₀ x₀ = ∑ b : Fin m, j₀ (v₀.repr x₀ b) • w₀ b := by
          conv_lhs => rw [← v₀.sum_repr x₀]
          rw [map_sum]
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [hφ₀, hw₀]
        funext a
        rw [hsum₀, map_sum, Finsupp.finsetSum_apply, Matrix.mulVec, dotProduct]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [map_smul, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, mul_comm]
        rfl
      have hx₁ : (w₁.repr (φ₁ x₁) : Fin m → R₀₁) = fun a => j₁ (v₁.repr x₁ a) := by
        have hsum₁ : φ₁ x₁ = ∑ a' : Fin m, j₁ (v₁.repr x₁ a') • w₁ a' := by
          conv_lhs => rw [← v₁.sum_repr x₁]
          rw [map_sum]
          refine Finset.sum_congr rfl fun a' _ => ?_
          rw [hφ₁, hw₁]
        funext a
        rw [hsum₁, map_sum, Finsupp.finsetSum_apply]
        simp [map_smul, Module.Basis.repr_self, Finsupp.single_apply]
      constructor
      · intro h
        have h' : (w₁.repr (φ₀ x₀) : Fin m → R₀₁) = w₁.repr (φ₁ x₁) := by rw [h]
        rwa [hx₀, hx₁] at h'
      · intro h
        apply w₁.repr.injective
        ext a
        exact (congrFun hx₀ a).trans ((congrFun h a).trans (congrFun hx₁ a).symm)
    have htr₀ : ∀ x₀ : B₀,
        LinearMap.trace R₀₁ B₀₁ (Algebra.lmul R₀₁ B₀₁ (φ₀ x₀)) =
          j₀ (LinearMap.trace R₀ B₀ (Algebra.lmul R₀ B₀ x₀)) := by
      intro x₀
      rw [LinearMap.trace_eq_matrix_trace R₀₁ w₀ (Algebra.lmul R₀₁ B₀₁ (φ₀ x₀)),
        LinearMap.trace_eq_matrix_trace R₀ v₀ (Algebra.lmul R₀ B₀ x₀)]
      simp only [Matrix.trace, Matrix.diag, map_sum, LinearMap.toMatrix_apply]
      refine Finset.sum_congr rfl fun c _ => ?_
      change (w₀.repr (φ₀ x₀ * w₀ c)) c = j₀ ((v₀.repr (x₀ * v₀ c)) c)
      have hexp : φ₀ x₀ * w₀ c = ∑ d : Fin m, j₀ ((v₀.repr (x₀ * v₀ c)) d) • w₀ d := by
        rw [hw₀, ← map_mul]
        conv_lhs => rw [← v₀.sum_repr (x₀ * v₀ c)]
        rw [map_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [hφ₀, hw₀]
      rw [hexp, map_sum]
      simp [map_smul, Module.Basis.repr_self, Finsupp.single_apply]
    have htr₁ : ∀ x₁ : B₁,
        LinearMap.trace R₀₁ B₀₁ (Algebra.lmul R₀₁ B₀₁ (φ₁ x₁)) =
          j₁ (LinearMap.trace R₀ B₁ (Algebra.lmul R₀ B₁ x₁)) := by
      intro x₁
      rw [LinearMap.trace_eq_matrix_trace R₀₁ w₁ (Algebra.lmul R₀₁ B₀₁ (φ₁ x₁)),
        LinearMap.trace_eq_matrix_trace R₀ v₁ (Algebra.lmul R₀ B₁ x₁)]
      simp only [Matrix.trace, Matrix.diag, map_sum, LinearMap.toMatrix_apply]
      refine Finset.sum_congr rfl fun c _ => ?_
      change (w₁.repr (φ₁ x₁ * w₁ c)) c = j₁ ((v₁.repr (x₁ * v₁ c)) c)
      have hexp : φ₁ x₁ * w₁ c = ∑ d : Fin m, j₁ ((v₁.repr (x₁ * v₁ c)) d) • w₁ d := by
        rw [hw₁, ← map_mul]
        conv_lhs => rw [← v₁.sum_repr (x₁ * v₁ c)]
        rw [map_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [hφ₁, hw₁]
      rw [hexp, map_sum]
      simp [map_smul, Module.Basis.repr_self, Finsupp.single_apply]
    let T₀ : Matrix (Fin m) (Fin m) R₀ :=
      Matrix.of fun a b : Fin m => LinearMap.trace R₀ B₀ (Algebra.lmul R₀ B₀ (v₀ a * v₀ b))
    let T₁ : Matrix (Fin m) (Fin m) R₀ :=
      Matrix.of fun a b : Fin m => LinearMap.trace R₀ B₁ (Algebra.lmul R₀ B₁ (v₁ a * v₁ b))
    let tr₀₁ : B₀₁ →ₗ[R₀₁] R₀₁ :=
      (LinearMap.trace R₀₁ B₀₁).comp (Algebra.lmul R₀₁ B₀₁).toLinearMap
    have htr₀₁_apply : ∀ y : B₀₁,
        tr₀₁ y = LinearMap.trace R₀₁ B₀₁ (Algebra.lmul R₀₁ B₀₁ y) := fun _ => rfl
    have h_tr_w₁ : ∀ a₁ a₂ : Fin m, tr₀₁ (w₁ a₁ * w₁ a₂) = j₁ (T₁ a₁ a₂) := by
      intro a₁ a₂
      rw [htr₀₁_apply, hw₁, hw₁, ← map_mul, htr₁]
      rfl
    have h_smul_mul : ∀ (r₁ r₂ : R₀₁) (y₁ y₂ : B₀₁),
        (r₁ • y₁) * (r₂ • y₂) = (r₁ * r₂) • (y₁ * y₂) := by
      intro r₁ r₂ y₁ y₂
      simp only [Algebra.smul_def, map_mul]
      ring
    have h_comm3 : ∀ x y z : R₀₁, x * y * z = x * z * y := fun x y z => by ring
    have hT_rel : j₀.mapMatrix T₀ = M.transpose * j₁.mapMatrix T₁ * M := by
      ext b₁ b₂
      have hw₀_exp : ∀ b : Fin m, w₀ b = ∑ a : Fin m, M a b • w₁ a := by
        intro b
        simp [M, Module.Basis.toMatrix_apply]
      have h_entry : j₀ (T₀ b₁ b₂) = tr₀₁ (w₀ b₁ * w₀ b₂) := by
        dsimp only [T₀, Matrix.of_apply]
        rw [htr₀₁_apply, ← htr₀ (v₀ b₁ * v₀ b₂), map_mul, hw₀, hw₀]
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, h_entry, hw₀_exp b₁, hw₀_exp b₂,
        Finset.sum_mul]
      simp only [Finset.mul_sum, map_sum]
      rw [Matrix.mul_apply]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, RingHom.mapMatrix_apply,
        Matrix.map_apply]
      change ∑ a₁ : Fin m, ∑ a₂ : Fin m, tr₀₁ (M a₁ b₁ • w₁ a₁ * M a₂ b₂ • w₁ a₂) =
        ∑ a₂ : Fin m, (∑ a₁ : Fin m, M a₁ b₁ * j₁ (T₁ a₁ a₂)) * M a₂ b₂
      have hrhs_sum : (∑ a₂ : Fin m, (∑ a₁ : Fin m, M a₁ b₁ * j₁ (T₁ a₁ a₂)) * M a₂ b₂) =
          ∑ a₂ : Fin m, ∑ a₁ : Fin m, (M a₁ b₁ * j₁ (T₁ a₁ a₂)) * M a₂ b₂ :=
        Finset.sum_congr rfl fun a₂ _ => Finset.sum_mul _ _ _
      rw [hrhs_sum, Finset.sum_comm]
      refine Finset.sum_congr rfl fun a₂ _ => Finset.sum_congr rfl fun a₁ _ => ?_
      exact (congrArg tr₀₁ (h_smul_mul (M a₁ b₁) (M a₂ b₂) (w₁ a₁) (w₁ a₂))).trans
        ((tr₀₁.map_smul (M a₁ b₁ * M a₂ b₂) (w₁ a₁ * w₁ a₂)).trans
          ((congrArg (fun t => (M a₁ b₁ * M a₂ b₂) * t) (h_tr_w₁ a₁ a₂)).trans
            (h_comm3 (M a₁ b₁) (M a₂ b₂) (j₁ (T₁ a₁ a₂)))))
    have hdet_rel : M.det ^ 2 * j₀ (Polynomial.C d₁) = j₀ (Polynomial.C d₀) := by
      have h1 := congrArg Matrix.det hT_rel
      rw [← RingHom.map_det, hdet₀, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose,
        ← RingHom.map_det, hdet₁, hj₁_C d₁] at h1
      linear_combination -h1
    have hu_inv : M_inv.det * M.det = 1 := by
      rw [← Matrix.det_mul, hM_inv, Matrix.det_one]
    obtain ⟨n, p, hp⟩ := IsLocalization.Away.surj (Polynomial.X : R₀) M.det
    obtain ⟨n', q, hq⟩ := IsLocalization.Away.surj (Polynomial.X : R₀) M_inv.det
    have hpq_X : p * q = Polynomial.X ^ (n + n') := by
      apply hj₀_inj
      rw [map_mul, ← hp, ← hq, map_pow]
      calc (M.det * j₀ Polynomial.X ^ n) * (M_inv.det * j₀ Polynomial.X ^ n')
          = (M_inv.det * M.det) * (j₀ Polynomial.X ^ n * j₀ Polynomial.X ^ n') := by ring
        _ = j₀ Polynomial.X ^ (n + n') := by rw [hu_inv, one_mul, pow_add]
    have hp_ne : p ≠ 0 := fun h0 => by
      rw [h0, zero_mul] at hpq_X
      exact pow_ne_zero (n + n') Polynomial.X_ne_zero hpq_X.symm
    have hq_ne : q ≠ 0 := fun h0 => by
      rw [h0, mul_zero] at hpq_X
      exact pow_ne_zero (n + n') Polynomial.X_ne_zero hpq_X.symm
    have hdeg_sum : p.natDegree + q.natDegree = n + n' := by
      have h1 := congrArg Polynomial.natDegree hpq_X
      rwa [Polynomial.natDegree_mul hp_ne hq_ne, Polynomial.natDegree_X_pow] at h1
    have htdeg_sum : p.natTrailingDegree + q.natTrailingDegree = n + n' := by
      have h1 := congrArg Polynomial.natTrailingDegree hpq_X
      rwa [Polynomial.natTrailingDegree_mul hp_ne hq_ne, Polynomial.natTrailingDegree_X_pow] at h1
    have hp_le : p.natTrailingDegree ≤ p.natDegree := Polynomial.natTrailingDegree_le_natDegree p
    have hq_le : q.natTrailingDegree ≤ q.natDegree := Polynomial.natTrailingDegree_le_natDegree q
    have hp_eq_deg : p.natTrailingDegree = p.natDegree := by omega
    let δ := p.natDegree
    let c := p.coeff δ
    have hp_mon : p = Polynomial.C c * Polynomial.X ^ δ := by
      ext i
      rw [Polynomial.coeff_C_mul_X_pow]
      split_ifs with hi
      · subst hi; rfl
      · rcases lt_or_gt_of_ne hi with hlt | hgt
        · exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree (hp_eq_deg.symm ▸ hlt)
        · exact Polynomial.coeff_eq_zero_of_natDegree_lt hgt
    have h_poly_eq : Polynomial.C (c ^ 2 * d₁) * Polynomial.X ^ (2 * δ) =
        Polynomial.C d₀ * Polynomial.X ^ (2 * n) := by
      apply hj₀_inj
      have hp' : M.det * j₀ Polynomial.X ^ n = j₀ (Polynomial.C c * Polynomial.X ^ δ) := by
        rwa [hp_mon] at hp
      calc j₀ (Polynomial.C (c ^ 2 * d₁) * Polynomial.X ^ (2 * δ))
          = (j₀ (Polynomial.C c * Polynomial.X ^ δ)) ^ 2 * j₀ (Polynomial.C d₁) := by
              rw [Polynomial.C_mul, Polynomial.C_pow]
              simp only [map_mul, map_pow]
              ring
        _ = (M.det * j₀ Polynomial.X ^ n) ^ 2 * j₀ (Polynomial.C d₁) := by rw [← hp']
        _ = (M.det ^ 2 * j₀ (Polynomial.C d₁)) * j₀ Polynomial.X ^ (2 * n) := by ring
        _ = j₀ (Polynomial.C d₀) * j₀ Polynomial.X ^ (2 * n) := by rw [hdet_rel]
        _ = j₀ (Polynomial.C d₀ * Polynomial.X ^ (2 * n)) := by rw [map_mul, map_pow]
    have h_coeff := congrArg (fun f => Polynomial.coeff f (2 * n)) h_poly_eq
    rw [Polynomial.coeff_C_mul_X_pow, Polynomial.coeff_C_mul_X_pow,
      ite_eq_left_iff.mpr (fun h => absurd rfl h)] at h_coeff
    have h2n_eq : 2 * n = 2 * δ := by
      by_contra hne
      simp [hne] at h_coeff
      exact hd₀ h_coeff.symm
    have hδ_eq : δ = n := by omega
    simp only [h2n_eq, ↓reduceIte] at h_coeff
    have hc_ne : c ≠ 0 := by
      intro hc0
      rw [hc0, zero_pow (by decide), zero_mul] at h_coeff
      exact hd₀ h_coeff.symm
    have hM_det : M.det = j₀ (Polynomial.C c) := by
      have hp_n : M.det * j₀ Polynomial.X ^ n = j₀ (Polynomial.C c) * j₀ Polynomial.X ^ n := by
        rw [hp, hp_mon, hδ_eq, map_mul, map_pow]
      have hinv_n : j₀ Polynomial.X ^ n * X_inv ^ n = 1 := by
        rw [← mul_pow, hX_mul_inv, one_pow]
      calc M.det = M.det * 1 := (mul_one _).symm
        _ = M.det * (j₀ Polynomial.X ^ n * X_inv ^ n) := by rw [← hinv_n]
        _ = (M.det * j₀ Polynomial.X ^ n) * X_inv ^ n := (mul_assoc _ _ _).symm
        _ = (j₀ (Polynomial.C c) * j₀ Polynomial.X ^ n) * X_inv ^ n := by rw [hp_n]
        _ = j₀ (Polynomial.C c) * (j₀ Polynomial.X ^ n * X_inv ^ n) := mul_assoc _ _ _
        _ = j₀ (Polynomial.C c) := by rw [hinv_n, mul_one]
    exact ⟨M, M_inv, c, hc_ne, hM_inv, hM_det, hGlued⟩

  obtain ⟨M, M_inv, c, hc, hM_inv, hdetM, hGlued⟩ := h_part2

  
  let C : Subalgebra k (B₀ × B₁) :=
    { carrier := { x : B₀ × B₁ | φ₀ x.1 = φ₁ x.2 }
      mul_mem' := fun {x y} hx hy => by
        change φ₀ (x.1 * y.1) = φ₁ (x.2 * y.2)
        rw [map_mul, map_mul, hx, hy]
      one_mem' := by
        change φ₀ 1 = φ₁ 1
        rw [map_one, map_one]
      add_mem' := fun {x y} hx hy => by
        change φ₀ (x.1 + y.1) = φ₁ (x.2 + y.2)
        rw [map_add, map_add, hx, hy]
      zero_mem' := by
        change φ₀ 0 = φ₁ 0
        rw [map_zero, map_zero]
      algebraMap_mem' := fun r => by
        change φ₀ (algebraMap k B₀ r) = φ₁ (algebraMap k B₁ r)
        rw [AlgHom.commutes, AlgHom.commutes] }
  have : IsReduced ↥C := ⟨fun x ⟨n, hxn⟩ => by
    apply Subtype.ext
    have hval : (x.1 : B₀ × B₁) ^ n = 0 := congrArg Subtype.val hxn
    have hx1 : x.1.1 = 0 := IsReduced.eq_zero _ ⟨n, congrArg Prod.fst hval⟩
    have hx2 : x.1.2 = 0 := IsReduced.eq_zero _ ⟨n, congrArg Prod.snd hval⟩
    exact Prod.ext hx1 hx2⟩
  let E_prod : (B₀ × B₁) ≃ₗ[k] ((Fin m → Polynomial k) × (Fin m → Polynomial k)) :=
    ((v₀.equivFun).restrictScalars k).prodCongr ((v₁.equivFun).restrictScalars k)
  let W : Submodule k ((Fin m → Polynomial k) × (Fin m → Polynomial k)) :=
    Submodule.map E_prod.toLinearMap (Subalgebra.toSubmodule C)
  have hW : ∀ fg : (Fin m → Polynomial k) × (Fin m → Polynomial k),
      fg ∈ W ↔
        M.mulVec (fun b => j₀ (fg.1 b)) = (fun a => j₁ (fg.2 a)) := by
    intro fg
    have hmem : fg ∈ W ↔ φ₀ (v₀.equivFun.symm fg.1) = φ₁ (v₁.equivFun.symm fg.2) := by
      constructor
      · rintro ⟨x, hxC, rfl⟩
        have hx1 : v₀.equivFun.symm (E_prod x).1 = x.1 := v₀.equivFun.symm_apply_apply x.1
        have hx2 : v₁.equivFun.symm (E_prod x).2 = x.2 := v₁.equivFun.symm_apply_apply x.2
        change φ₀ (v₀.equivFun.symm (E_prod x).1) = φ₁ (v₁.equivFun.symm (E_prod x).2)
        rw [hx1, hx2]
        exact hxC
      · intro hφ
        refine ⟨(v₀.equivFun.symm fg.1, v₁.equivFun.symm fg.2), hφ, ?_⟩
        exact Prod.ext (v₀.equivFun.apply_symm_apply fg.1) (v₁.equivFun.apply_symm_apply fg.2)
    rw [hmem, hGlued]
    have h1 : (fun b => v₀.repr (v₀.equivFun.symm fg.1) b) = fg.1 := by
      funext b
      change v₀.equivFun (v₀.equivFun.symm fg.1) b = fg.1 b
      rw [v₀.equivFun.apply_symm_apply]
    have h2 : (fun a => v₁.repr (v₁.equivFun.symm fg.2) a) = fg.2 := by
      funext a
      change v₁.equivFun (v₁.equivFun.symm fg.2) a = fg.2 a
      rw [v₁.equivFun.apply_symm_apply]
    simp_rw [congrFun h1, congrFun h2]

  
  have h_part3 : FiniteDimensional k ↥W ∧ m ≤ Module.finrank k ↥W := by
    let revPoly : ℕ → Polynomial k →ₗ[k] Polynomial k := fun D =>
      { toFun := fun p => ∑ d ∈ Finset.range (D + 1), Polynomial.monomial (D - d) (p.coeff d)
        map_add' := fun p q => by
          simp only [Polynomial.coeff_add, map_add, Finset.sum_add_distrib]
        map_smul' := fun r p => by
          simp only [Polynomial.coeff_smul, RingHom.id_apply, Finset.smul_sum,
            Polynomial.smul_monomial] }
    have hrev_deg : ∀ (D : ℕ) (p : Polynomial k), (revPoly D p).natDegree ≤ D := by
      intro D p
      dsimp [revPoly]
      refine (Polynomial.natDegree_sum_le _ _).trans ?_
      rw [Finset.fold_max_le]
      refine ⟨Nat.zero_le D, fun d _ =>
        (Polynomial.natDegree_monomial_le (a := p.coeff d)).trans (Nat.sub_le D d)⟩
    have hrev_coeff : ∀ (D k₀ : ℕ) (p : Polynomial k), k₀ ≤ D →
        (revPoly D p).coeff k₀ = p.coeff (D - k₀) := by
      intro D k₀ p hk₀
      dsimp [revPoly]
      rw [Polynomial.finsetSum_coeff]
      have hmem : D - k₀ ∈ Finset.range (D + 1) := Finset.mem_range.mpr (by omega)
      rw [Finset.sum_eq_single (D - k₀)]
      · have heq : D - (D - k₀) = k₀ := by omega
        simp [heq]
      · intro d hd _
        have hd_le : d < D + 1 := Finset.mem_range.mp hd
        have hne' : ¬ (D - d = k₀) := by omega
        simp [Polynomial.coeff_monomial, hne']
      · intro hnot
        exact absurd hmem hnot
    have hrev_invol : ∀ (D : ℕ) (p : Polynomial k),
        p.natDegree ≤ D → revPoly D (revPoly D p) = p := by
      intro D p hp
      ext d
      by_cases hd : d ≤ D
      · rw [hrev_coeff D d (revPoly D p) hd, hrev_coeff D (D - d) p (Nat.sub_le D d)]
        congr 1
        omega
      · have hgt : D < d := lt_of_not_ge hd
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt ((hrev_deg D _).trans_lt hgt),
          Polynomial.coeff_eq_zero_of_natDegree_lt (hp.trans_lt hgt)]
    have hrev_laurent : ∀ (D : ℕ) (p : Polynomial k), p.natDegree ≤ D →
        j₀ Polynomial.X ^ D * j₁ p = j₀ (revPoly D p) := by
      intro D p hp
      have hp_sum : p = ∑ d ∈ Finset.range (D + 1), Polynomial.monomial d (p.coeff d) := by
        ext i
        rw [Polynomial.finsetSum_coeff]
        by_cases hi : i < D + 1
        · rw [Finset.sum_eq_single i]
          · simp
          · intro d _ hne
            simp [Polynomial.coeff_monomial, hne]
          · intro hnot
            exact absurd (Finset.mem_range.mpr hi) hnot
        · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
          refine (Finset.sum_eq_zero fun d hd => ?_).symm
          have hd_lt : d < D + 1 := Finset.mem_range.mp hd
          have hne : ¬ (d = i) := by omega
          simp [Polynomial.coeff_monomial, hne]
      conv_lhs => rw [hp_sum]
      dsimp [revPoly]
      rw [map_sum, Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl fun d hd => ?_
      have hd_le : d ≤ D := Nat.lt_succ_iff.mp (Finset.mem_range.mp hd)
      rw [← Polynomial.C_mul_X_pow_eq_monomial, ← Polynomial.C_mul_X_pow_eq_monomial,
        map_mul, map_pow, hj₁_C, hj₁_X, map_mul, map_pow]
      have hD_split : D = (D - d) + d := (Nat.sub_add_cancel hd_le).symm
      have hpow_id : j₀ Polynomial.X ^ D * X_inv ^ d = j₀ Polynomial.X ^ (D - d) := by
        calc j₀ Polynomial.X ^ D * X_inv ^ d
            = (j₀ Polynomial.X ^ (D - d) * j₀ Polynomial.X ^ d) * X_inv ^ d := by
                rw [← pow_add, ← hD_split]
          _ = j₀ Polynomial.X ^ (D - d) * (j₀ Polynomial.X * X_inv) ^ d := by
                rw [mul_assoc, ← mul_pow]
          _ = j₀ Polynomial.X ^ (D - d) := by rw [hX_mul_inv, one_pow, mul_one]
      calc j₀ Polynomial.X ^ D * (j₀ (Polynomial.C (p.coeff d)) * X_inv ^ d)
          = j₀ (Polynomial.C (p.coeff d)) * (j₀ Polynomial.X ^ D * X_inv ^ d) := by ring
        _ = j₀ (Polynomial.C (p.coeff d)) * j₀ Polynomial.X ^ (D - d) := by rw [hpow_id]
    have hrev_laurent_symm : ∀ (D : ℕ) (p : Polynomial k), p.natDegree ≤ D →
        j₀ Polynomial.X ^ D * j₁ (revPoly D p) = j₀ p := by
      intro D p hp
      rw [hrev_laurent D (revPoly D p) (hrev_deg D p), hrev_invol D p hp]
    have hj₁_inj : Function.Injective j₁ := by
      rw [injective_iff_map_eq_zero]
      intro p hp0
      let D := p.natDegree
      have h0 : j₀ (revPoly D p) = 0 := by
        rw [← hrev_laurent D p (le_refl D), hp0, mul_zero]
      have hrev0 : revPoly D p = 0 := hj₀_inj (h0.trans (map_zero j₀).symm)
      rw [← hrev_invol D p (le_refl D), hrev0, map_zero]
    
    have h_surj_inv : ∀ b a : Fin m, ∃ (n' : ℕ) (p' : Polynomial k),
        M_inv b a * j₀ Polynomial.X ^ n' = j₀ p' :=
      fun b a => IsLocalization.Away.surj (Polynomial.X : R₀) (M_inv b a)
    choose n_inv p_inv hp_inv using h_surj_inv
    let D_inv : Fin m → Fin m → ℕ := fun b a => (p_inv b a).natDegree
    let N : ℕ := Finset.univ.sup (fun ba : Fin m × Fin m => D_inv ba.1 ba.2)
    let Q' : Matrix (Fin m) (Fin m) (Polynomial k) := Matrix.of fun b a =>
      Polynomial.X ^ (N - D_inv b a) *
        (revPoly (D_inv b a) (p_inv b a) * Polynomial.X ^ (n_inv b a))
    have hMinv_Q' : ∀ b a : Fin m, M_inv b a = j₀ Polynomial.X ^ N * j₁ (Q' b a) := by
      intro b a
      have hD_le : D_inv b a ≤ N :=
        Finset.le_sup (f := fun ba : Fin m × Fin m => D_inv ba.1 ba.2) (Finset.mem_univ (b, a))
      have hD_split : N = D_inv b a + (N - D_inv b a) := (Nat.add_sub_of_le hD_le).symm
      have h1 : M_inv b a =
          j₀ Polynomial.X ^ (D_inv b a) *
            j₁ (revPoly (D_inv b a) (p_inv b a) * Polynomial.X ^ (n_inv b a)) := by
        have hinv_n : j₀ Polynomial.X ^ (n_inv b a) * X_inv ^ (n_inv b a) = 1 := by
          rw [← mul_pow, hX_mul_inv, one_pow]
        calc M_inv b a = M_inv b a * (j₀ Polynomial.X ^ (n_inv b a) * X_inv ^ (n_inv b a)) := by
              rw [hinv_n, mul_one]
          _ = (M_inv b a * j₀ Polynomial.X ^ (n_inv b a)) * X_inv ^ (n_inv b a) :=
              (mul_assoc _ _ _).symm
          _ = j₀ (p_inv b a) * X_inv ^ (n_inv b a) := by rw [hp_inv b a]
          _ = (j₀ Polynomial.X ^ (D_inv b a) * j₁ (revPoly (D_inv b a) (p_inv b a))) *
                j₁ (Polynomial.X ^ (n_inv b a)) := by
              rw [← hrev_laurent_symm (D_inv b a) (p_inv b a) (le_refl _), map_pow, hj₁_X]
          _ = j₀ Polynomial.X ^ (D_inv b a) *
                j₁ (revPoly (D_inv b a) (p_inv b a) * Polynomial.X ^ (n_inv b a)) := by
              rw [map_mul, mul_assoc]
      have hpad : j₀ Polynomial.X ^ N * j₁ (Polynomial.X ^ (N - D_inv b a)) =
          j₀ Polynomial.X ^ (D_inv b a) := by
        rw [map_pow, hj₁_X]
        calc j₀ Polynomial.X ^ N * X_inv ^ (N - D_inv b a)
            = (j₀ Polynomial.X ^ (D_inv b a) * j₀ Polynomial.X ^ (N - D_inv b a)) *
                X_inv ^ (N - D_inv b a) := by rw [← pow_add, ← hD_split]
          _ = j₀ Polynomial.X ^ (D_inv b a) * (j₀ Polynomial.X * X_inv) ^ (N - D_inv b a) := by
                rw [mul_assoc, ← mul_pow]
          _ = j₀ Polynomial.X ^ (D_inv b a) := by rw [hX_mul_inv, one_pow, mul_one]
      dsimp [Q']
      rw [map_mul, ← mul_assoc, hpad, h1]
    have hdeg_bound : ∀ fg ∈ W, ∀ (b : Fin m) (d : ℕ), N < d → (fg.1 b).coeff d = 0 := by
      intro fg hfg b d hd
      have hM_eq := (hW fg).mp hfg
      have hfb_eq : j₀ (fg.1 b) = j₀ Polynomial.X ^ N * j₁ (∑ a : Fin m, Q' b a * fg.2 a) := by
        have hmul := congrArg (M_inv.mulVec) hM_eq
        rw [Matrix.mulVec_mulVec, hM_inv, Matrix.one_mulVec] at hmul
        have hb := congrFun hmul b
        rw [hb, Matrix.mulVec, dotProduct, map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [hMinv_Q' b a, map_mul, mul_assoc]
      let h_b : Polynomial k := ∑ a : Fin m, Q' b a * fg.2 a
      let L : ℕ := h_b.natDegree
      have hpoly_eq : fg.1 b * Polynomial.X ^ L = Polynomial.X ^ N * revPoly L h_b := by
        apply hj₀_inj
        calc j₀ (fg.1 b * Polynomial.X ^ L)
            = j₀ (fg.1 b) * j₀ Polynomial.X ^ L := by rw [map_mul, map_pow]
          _ = (j₀ Polynomial.X ^ N * j₁ h_b) * j₀ Polynomial.X ^ L := by rw [hfb_eq]
          _ = j₀ Polynomial.X ^ N * (j₀ Polynomial.X ^ L * j₁ h_b) := by ring
          _ = j₀ Polynomial.X ^ N * j₀ (revPoly L h_b) := by rw [hrev_laurent L h_b (le_refl L)]
          _ = j₀ (Polynomial.X ^ N * revPoly L h_b) := by rw [map_mul, map_pow]
      have hcoeff_eq := congrArg (fun f => Polynomial.coeff f (d + L)) hpoly_eq
      rw [Polynomial.coeff_mul_X_pow] at hcoeff_eq
      have hrhs_deg : (Polynomial.X ^ N * revPoly L h_b).natDegree < d + L := by
        calc (Polynomial.X ^ N * revPoly L h_b).natDegree
            ≤ (Polynomial.X ^ N : Polynomial k).natDegree + (revPoly L h_b).natDegree :=
                Polynomial.natDegree_mul_le
          _ ≤ N + L := by
                rw [Polynomial.natDegree_X_pow]
                exact Nat.add_le_add_left (hrev_deg L h_b) N
          _ < d + L := by omega
      rwa [Polynomial.coeff_eq_zero_of_natDegree_lt hrhs_deg] at hcoeff_eq
    let π_N : ↥W →ₗ[k] (Fin m → Fin (N + 1) → k) :=
      { toFun := fun w b d => (w.1.1 b).coeff d.1
        map_add' := fun w₁ w₂ => by funext b d; simp [Polynomial.coeff_add]
        map_smul' := fun r w => by funext b d; simp [Polynomial.coeff_smul] }
    have hπ_inj : Function.Injective π_N := by
      rw [injective_iff_map_eq_zero]
      intro w hw0
      apply Subtype.ext
      have hf0 : w.1.1 = 0 := by
        funext b
        ext d
        by_cases hd : d < N + 1
        · exact congrFun (congrFun hw0 b) ⟨d, hd⟩
        · exact hdeg_bound w.1 w.2 b d (by omega)
      have hg0 : w.1.2 = 0 := by
        have hM_eq := (hW w.1).mp w.2
        rw [hf0] at hM_eq
        have h0vec : (fun b : Fin m => j₀ ((0 : Fin m → Polynomial k) b)) = 0 := by
          funext b; simp [map_zero]
        rw [h0vec, Matrix.mulVec_zero] at hM_eq
        funext a
        have ha : j₁ (w.1.2 a) = 0 := (congrFun hM_eq a).symm
        exact hj₁_inj (ha.trans (map_zero j₁).symm)
      exact Prod.ext hf0 hg0
    have hFD_W : FiniteDimensional k ↥W := FiniteDimensional.of_injective π_N hπ_inj
    refine ⟨hFD_W, ?_⟩
    
    have h_surj_M : ∀ a b : Fin m, ∃ (n : ℕ) (p : Polynomial k),
        M a b * j₀ Polynomial.X ^ n = j₀ p :=
      fun a b => IsLocalization.Away.surj (Polynomial.X : R₀) (M a b)
    choose n_M p_M hp_M using h_surj_M
    let A : ℕ := Finset.univ.sup (fun ab : Fin m × Fin m => n_M ab.1 ab.2)
    let P : Matrix (Fin m) (Fin m) (Polynomial k) :=
      Matrix.of fun a b => p_M a b * Polynomial.X ^ (A - n_M a b)
    have hP_map : j₀.mapMatrix P = (j₀ Polynomial.X ^ A) • M := by
      ext a b
      have hn_le : n_M a b ≤ A :=
        Finset.le_sup (f := fun ab : Fin m × Fin m => n_M ab.1 ab.2) (Finset.mem_univ (a, b))
      have hA_split : A = n_M a b + (A - n_M a b) := (Nat.add_sub_of_le hn_le).symm
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, P, Matrix.of_apply, map_mul, map_pow,
        Matrix.smul_apply, smul_eq_mul, ← hp_M a b]
      calc (M a b * j₀ Polynomial.X ^ n_M a b) * j₀ Polynomial.X ^ (A - n_M a b)
          = M a b * (j₀ Polynomial.X ^ n_M a b * j₀ Polynomial.X ^ (A - n_M a b)) :=
              mul_assoc _ _ _
        _ = j₀ Polynomial.X ^ A * M a b := by rw [← pow_add, ← hA_split, mul_comm]
    have hP_det : P.det = Polynomial.C c * Polynomial.X ^ (m * A) := by
      apply hj₀_inj
      rw [RingHom.map_det, hP_map, Matrix.det_smul, Fintype.card_fin, hdetM, map_mul, map_pow,
        ← pow_mul, mul_comm A m, mul_comm]
    have hP_det_ne : P.det ≠ 0 := by
      intro h0
      have hc0 : (Polynomial.C c * Polynomial.X ^ (m * A)).coeff (m * A) =
          (0 : Polynomial k).coeff (m * A) :=
        congrArg (fun f => Polynomial.coeff f (m * A)) (hP_det.symm.trans h0)
      simp only [Polynomial.coeff_C_mul_X_pow, ↓reduceIte, Polynomial.coeff_zero] at hc0
      exact hc hc0
    let b_std : Module.Basis (Fin m) (Polynomial k) (Fin m → Polynomial k) :=
      Pi.basisFun (Polynomial k) (Fin m)
    let L_P : (Fin m → Polynomial k) →ₗ[Polynomial k] (Fin m → Polynomial k) :=
      Matrix.mulVecLin P
    have hL_P_inj : Function.Injective L_P := by
      rw [injective_iff_map_eq_zero]
      intro f hf0
      have hadj : (P.adjugate * P).mulVec f = 0 := by
        rw [← Matrix.mulVec_mulVec, show P.mulVec f = 0 from hf0, Matrix.mulVec_zero]
      rw [Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec] at hadj
      funext b
      have hb : P.det * f b = 0 := congrFun hadj b
      exact (mul_eq_zero.mp hb).resolve_left hP_det_ne
    let N_im : Submodule (Polynomial k) (Fin m → Polynomial k) := LinearMap.range L_P
    let e_L : (Fin m → Polynomial k) ≃ₗ[Polynomial k] ↥N_im :=
      LinearEquiv.ofInjective L_P hL_P_inj
    let e_N : Module.Basis (Fin m) (Polynomial k) ↥N_im := b_std.map e_L
    have hrk_eq : Module.finrank (Polynomial k) ↥N_im =
        Module.finrank (Polynomial k) (Fin m → Polynomial k) := e_L.symm.finrank_eq
    obtain ⟨b', a, ab', hab'⟩ := Submodule.exists_smith_normal_form_of_rank_eq b_std hrk_eq
    let Q₁ : Matrix (Fin m) (Fin m) (Polynomial k) := b_std.toMatrix b'
    let Q₂ : Matrix (Fin m) (Fin m) (Polynomial k) := ab'.toMatrix e_N
    have hP_snf : P = Q₁ * Matrix.diagonal a * Q₂ := by
      funext k₀ j
      have heN_coe : (e_N j : Fin m → Polynomial k) = P.mulVec (Pi.single j 1) := by
        change P.mulVec (b_std j) = P.mulVec (Pi.single j 1)
        rw [Pi.basisFun_apply]
      have hPj : P k₀ j = (e_N j : Fin m → Polynomial k) k₀ := by
        rw [heN_coe]
        simp [Matrix.mulVec, dotProduct, Pi.single_apply]
      have heN_sum : (e_N j : Fin m → Polynomial k) = ∑ i : Fin m, (Q₂ i j * a i) • b' i := by
        have h1 : e_N j = ∑ i : Fin m, Q₂ i j • ab' i := by
          simp [Q₂, Module.Basis.toMatrix_apply]
        have h2 := congrArg (Subtype.val : ↥N_im → Fin m → Polynomial k) h1
        rw [Submodule.coe_sum] at h2
        refine h2.trans (Finset.sum_congr rfl fun i _ => ?_)
        rw [Submodule.coe_smul_of_tower, hab' i, smul_smul]
      have hb'_coord : ∀ i : Fin m, (b' i) k₀ = Q₁ k₀ i := fun _ => rfl
      rw [hPj, heN_sum, Finset.sum_apply, Matrix.mul_apply]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Pi.smul_apply, hb'_coord i, smul_eq_mul, Matrix.mul_diagonal]
      ring
    have hQ₁_unit : IsUnit Q₁.det := by
      have hmul : Q₁ * b'.toMatrix b_std = 1 := by
        dsimp [Q₁]
        rw [Module.Basis.toMatrix_mul_toMatrix, Module.Basis.toMatrix_self]
      have hdet1 : Q₁.det * (b'.toMatrix b_std).det = 1 := by
        rw [← Matrix.det_mul, hmul, Matrix.det_one]
      exact ⟨⟨Q₁.det, (b'.toMatrix b_std).det, hdet1, mul_comm Q₁.det _ ▸ hdet1⟩, rfl⟩
    have hQ₂_unit : IsUnit Q₂.det := by
      have hmul : Q₂ * e_N.toMatrix ab' = 1 := by
        dsimp [Q₂]
        rw [Module.Basis.toMatrix_mul_toMatrix, Module.Basis.toMatrix_self]
      have hdet1 : Q₂.det * (e_N.toMatrix ab').det = 1 := by
        rw [← Matrix.det_mul, hmul, Matrix.det_one]
      exact ⟨⟨Q₂.det, (e_N.toMatrix ab').det, hdet1, mul_comm Q₂.det _ ▸ hdet1⟩, rfl⟩
    obtain ⟨c_u, hc_u_unit, hc_u_eq⟩ := Polynomial.isUnit_iff.mp (hQ₁_unit.mul hQ₂_unit)
    have hprod_a : Polynomial.C c_u * (∏ i : Fin m, a i) =
        Polynomial.C c * Polynomial.X ^ (m * A) := by
      have h1 := congrArg Matrix.det hP_snf
      rw [hP_det, Matrix.det_mul, Matrix.det_mul, Matrix.det_diagonal] at h1
      calc Polynomial.C c_u * (∏ i : Fin m, a i)
          = (Q₁.det * Q₂.det) * (∏ i : Fin m, a i) := by rw [hc_u_eq]
        _ = Q₁.det * (∏ i : Fin m, a i) * Q₂.det := by ring
        _ = Polynomial.C c * Polynomial.X ^ (m * A) := h1.symm
    have ha_ne : ∀ i : Fin m, a i ≠ 0 := by
      intro i hi0
      have hprod0 : (∏ j : Fin m, a j) = 0 :=
        Finset.prod_eq_zero (Finset.mem_univ i) hi0
      rw [hprod0, mul_zero] at hprod_a
      exact hP_det_ne (hP_det.trans hprod_a.symm)
    have hsum_deg_a : (∑ i : Fin m, (a i).natDegree) = m * A := by
      have h1 := congrArg Polynomial.natDegree hprod_a
      rwa [Polynomial.natDegree_C_mul hc_u_unit.ne_zero,
        Polynomial.natDegree_prod _ _ (fun i _ => ha_ne i),
        Polynomial.natDegree_C_mul hc, Polynomial.natDegree_X_pow] at h1
    let E_A : (Fin m → Fin (A + 1) → k) →ₗ[k] (Fin m → Polynomial k) :=
      { toFun := fun γ i => ∑ d : Fin (A + 1), Polynomial.monomial d.1 (γ i d)
        map_add' := fun γ₁ γ₂ => by
          funext i
          simp only [Pi.add_apply, map_add, Finset.sum_add_distrib]
        map_smul' := fun r γ => by
          funext i
          simp only [Pi.smul_apply, RingHom.id_apply, Finset.smul_sum, Polynomial.smul_monomial] }
    have hEA_deg : ∀ (γ : Fin m → Fin (A + 1) → k) (i : Fin m), (E_A γ i).natDegree ≤ A := by
      intro γ i
      dsimp [E_A]
      refine (Polynomial.natDegree_sum_le _ _).trans ?_
      rw [Finset.fold_max_le]
      refine ⟨Nat.zero_le A, fun d _ =>
        (Polynomial.natDegree_monomial_le (a := γ i d)).trans (Nat.lt_succ_iff.mp d.2)⟩
    have hEA_inj : Function.Injective E_A := by
      rw [injective_iff_map_eq_zero]
      intro γ hγ0
      funext i d
      rw [Pi.zero_apply, Pi.zero_apply]
      have hi : E_A γ i = (0 : Polynomial k) := congrFun hγ0 i
      have hc_d : (E_A γ i).coeff d.1 = 0 := by rw [hi, Polynomial.coeff_zero]
      dsimp [E_A] at hc_d
      rw [Polynomial.finsetSum_coeff, Finset.sum_eq_single d] at hc_d
      · simpa [Polynomial.coeff_monomial] using hc_d
      · intro d' _ hne
        have hne' : ¬ (d'.1 = d.1) := Fin.val_ne_of_ne hne
        simp [Polynomial.coeff_monomial, hne']
      · intro hnot
        exact absurd (Finset.mem_univ d) hnot
    have hFin_Adjoin : ∀ i : Fin m, Module.Finite k (AdjoinRoot (a i)) :=
      fun i => Module.Finite.of_basis (AdjoinRoot.powerBasisAux (ha_ne i))
    have hrk_Ya : Module.finrank k (∀ i : Fin m, AdjoinRoot (a i)) = m * A := by
      rw [Module.finrank_pi_fintype k]
      have h_each : ∀ i : Fin m, Module.finrank k (AdjoinRoot (a i)) = (a i).natDegree := by
        intro i
        rw [Module.finrank_eq_card_basis (AdjoinRoot.powerBasisAux (ha_ne i)), Fintype.card_fin]
      simp_rw [h_each]
      exact hsum_deg_a
    let Ψ : (Fin m → Polynomial k) →ₗ[k] (∀ i : Fin m, AdjoinRoot (a i)) :=
      { toFun := fun x i => AdjoinRoot.mk (a i) (b'.repr x i)
        map_add' := fun x y => by
          funext i
          simp only [Pi.add_apply, map_add, Finsupp.add_apply]
        map_smul' := fun r x => by
          funext i
          rw [Pi.smul_apply]
          have hsmul_x : r • x = (algebraMap k (Polynomial k) r) • x :=
            (IsScalarTower.algebraMap_smul (Polynomial k) r x).symm
          rw [hsmul_x, map_smul, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul,
            ← Polynomial.C_eq_algebraMap, map_mul, AdjoinRoot.mk_C, Algebra.smul_def]
          rfl }
    let Φ : (Fin m → Fin (A + 1) → k) →ₗ[k] (∀ i : Fin m, AdjoinRoot (a i)) := Ψ.comp E_A
    have hrk_UA : Module.finrank k (Fin m → Fin (A + 1) → k) = m * (A + 1) := by
      rw [Module.finrank_pi_fintype k]
      simp [Fintype.card_fin]
    have hrk_ker : m ≤ Module.finrank k ↥(LinearMap.ker Φ) := by
      have h_rn := LinearMap.finrank_range_add_finrank_ker Φ
      have h_rle := Submodule.finrank_le (LinearMap.range Φ)
      rw [hrk_UA, Nat.mul_add, Nat.mul_one] at h_rn
      rw [hrk_Ya] at h_rle
      omega
    have hker_mem_Nim : ∀ γ ∈ LinearMap.ker Φ, E_A γ ∈ N_im := by
      intro γ hγ
      have hdvd : ∀ i : Fin m, ∃ q_i : Polynomial k, b'.repr (E_A γ) i = q_i * a i := by
        intro i
        have hi0 : AdjoinRoot.mk (a i) (b'.repr (E_A γ) i) = 0 :=
          congrFun (LinearMap.mem_ker.mp hγ) i
        obtain ⟨q_i, hq_i⟩ := AdjoinRoot.mk_eq_zero.mp hi0
        exact ⟨q_i, by rw [hq_i, mul_comm]⟩
      choose q_a hq_a using hdvd
      rw [← b'.sum_repr (E_A γ)]
      refine Submodule.sum_mem N_im fun i _ => ?_
      rw [hq_a i, mul_smul, ← hab' i]
      exact Submodule.smul_mem N_im (q_a i) (ab' i).2
    let f_ker : ↥(LinearMap.ker Φ) →ₗ[k] (Fin m → Polynomial k) :=
      { toFun := fun γ => e_L.symm ⟨E_A γ.1, hker_mem_Nim γ.1 γ.2⟩
        map_add' := fun γ₁ γ₂ => by
          rw [← e_L.symm.map_add]; congr 1; apply Subtype.ext; exact map_add E_A γ₁.1 γ₂.1
        map_smul' := fun r γ => by
          have hsmul_sub : (⟨E_A (r • γ.1), hker_mem_Nim (r • γ.1) (r • γ).2⟩ : ↥N_im) =
              (algebraMap k (Polynomial k) r) • ⟨E_A γ.1, hker_mem_Nim γ.1 γ.2⟩ := by
            apply Subtype.ext
            change E_A (r • γ.1) = (algebraMap k (Polynomial k) r) • E_A γ.1
            rw [map_smul, IsScalarTower.algebraMap_smul]
          simp only [Submodule.coe_smul_of_tower, RingHom.id_apply]
          rw [hsmul_sub, e_L.symm.map_smul, IsScalarTower.algebraMap_smul] }
    let g_ker : ↥(LinearMap.ker Φ) →ₗ[k] (Fin m → Polynomial k) :=
      { toFun := fun γ i => revPoly A (E_A γ.1 i)
        map_add' := fun γ₁ γ₂ => by
          funext i
          simp only [Submodule.coe_add, map_add, Pi.add_apply]
        map_smul' := fun r γ => by
          funext i
          simp only [Submodule.coe_smul_of_tower, map_smul, Pi.smul_apply, RingHom.id_apply] }
    have hfg_mem_W : ∀ γ : ↥(LinearMap.ker Φ), (f_ker γ, g_ker γ) ∈ W := by
      intro γ
      rw [hW]
      have hPf : P.mulVec (f_ker γ) = E_A γ.1 := by
        change L_P (e_L.symm ⟨E_A γ.1, hker_mem_Nim γ.1 γ.2⟩) = E_A γ.1
        exact congrArg Subtype.val (e_L.apply_symm_apply ⟨E_A γ.1, hker_mem_Nim γ.1 γ.2⟩)
      funext i
      have h_scaled : j₀ Polynomial.X ^ A * (M.mulVec (fun b => j₀ (f_ker γ b)) i) =
          j₀ Polynomial.X ^ A * j₁ (g_ker γ i) := by
        have hlhs : j₀ Polynomial.X ^ A * (M.mulVec (fun b => j₀ (f_ker γ b)) i) =
            j₀ (P.mulVec (f_ker γ) i) := by
          simp only [Matrix.mulVec, dotProduct, Finset.mul_sum, map_sum, map_mul]
          refine Finset.sum_congr rfl fun b _ => ?_
          have hPib := congrFun (congrFun hP_map i) b
          simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.smul_apply,
            smul_eq_mul] at hPib
          rw [hPib, mul_assoc]
        rw [hlhs, congrFun hPf i]
        exact (hrev_laurent_symm A (E_A γ.1 i) (hEA_deg γ.1 i)).symm
      have hinv_A : X_inv ^ A * j₀ Polynomial.X ^ A = 1 := by
        rw [mul_comm, ← mul_pow, hX_mul_inv, one_pow]
      calc M.mulVec (fun b => j₀ (f_ker γ b)) i
          = (X_inv ^ A * j₀ Polynomial.X ^ A) * (M.mulVec (fun b => j₀ (f_ker γ b)) i) := by
              rw [hinv_A, one_mul]
        _ = X_inv ^ A * (j₀ Polynomial.X ^ A * (M.mulVec (fun b => j₀ (f_ker γ b)) i)) :=
              mul_assoc _ _ _
        _ = X_inv ^ A * (j₀ Polynomial.X ^ A * j₁ (g_ker γ i)) := by rw [h_scaled]
        _ = (X_inv ^ A * j₀ Polynomial.X ^ A) * j₁ (g_ker γ i) := (mul_assoc _ _ _).symm
        _ = j₁ (g_ker γ i) := by rw [hinv_A, one_mul]
    let ι_ker : ↥(LinearMap.ker Φ) →ₗ[k] ↥W :=
      { toFun := fun γ => ⟨(f_ker γ, g_ker γ), hfg_mem_W γ⟩
        map_add' := fun γ₁ γ₂ => by apply Subtype.ext; simp [map_add]
        map_smul' := fun r γ => by apply Subtype.ext; simp [map_smul] }
    have hι_ker_inj : Function.Injective ι_ker := by
      rw [injective_iff_map_eq_zero]
      intro γ hγ0
      have hf0 : f_ker γ = 0 := congrArg (Prod.fst ∘ Subtype.val) hγ0
      have hEA0 : E_A γ.1 = 0 := by
        have h1 : e_L (f_ker γ) = ⟨E_A γ.1, hker_mem_Nim γ.1 γ.2⟩ :=
          e_L.apply_symm_apply _
        rw [hf0, map_zero] at h1
        exact (congrArg Subtype.val h1).symm
      exact Subtype.ext (hEA_inj (hEA0.trans (map_zero E_A).symm))
    exact hrk_ker.trans (LinearMap.finrank_le_finrank_of_injective hι_ker_inj)

  obtain ⟨hFD_W, hm_W⟩ := h_part3
  let e_CW : ↥C ≃ₗ[k] ↥W := E_prod.submoduleMap (Subalgebra.toSubmodule C)
  have : FiniteDimensional k ↥C := FiniteDimensional.of_injective e_CW.toLinearMap e_CW.injective
  have hm_C : m ≤ Module.finrank k ↥C := by
    rwa [e_CW.finrank_eq]

  
  have h_rec : ∀ (n : ℕ), 1 ≤ n →
      ∀ (E : Type u) [CommRing E] [IsReduced E] [Algebra k E] [FiniteDimensional k E],
        Module.finrank k E = n →
        ∃ q : Fin n → E,
          (∀ i, q i ≠ 0) ∧
          (∀ i, q i * q i = q i) ∧
          (∀ i j, i ≠ j → q i * q j = 0) ∧
          (∑ i, q i) = 1 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn E _ _ _ _ hrkE
      have hNontrivE : Nontrivial E := by
        by_contra hnot
        rw [not_nontrivial_iff_subsingleton] at hnot
        have h0 : Module.finrank k E = 0 := Module.finrank_zero_of_subsingleton
        omega
      rcases eq_or_lt_of_le hn with rfl | hn_gt1
      · refine ⟨fun _ => 1, fun _ => one_ne_zero, fun _ => mul_one 1, ?_, ?_⟩
        · intro i j hij
          exact absurd (Subsingleton.elim i j) hij
        · exact Fin.sum_univ_one _
      · have hex_x : ∃ x : E, x ∉ Set.range (algebraMap k E) := by
          by_contra hall
          have hall' : ∀ x : E, x ∈ Set.range (algebraMap k E) := by
            intro x; by_contra hx; exact hall ⟨x, hx⟩
          have htop : LinearMap.range (Algebra.linearMap k E) = ⊤ := by
            rw [eq_top_iff]
            intro x _
            exact hall' x
          have hle1 : Module.finrank k E ≤ 1 := by
            calc Module.finrank k E
                = Module.finrank k ↥(⊤ : Submodule k E) := (finrank_top k E).symm
              _ = Module.finrank k ↥(LinearMap.range (Algebra.linearMap k E)) := by rw [htop]
              _ ≤ Module.finrank k k := LinearMap.finrank_range_le (Algebra.linearMap k E)
              _ = 1 := Module.finrank_self k
          omega
        obtain ⟨x, hx_not_mem⟩ := hex_x
        have : Algebra.IsIntegral k E := Algebra.IsIntegral.of_finite k E
        have hx_int : IsIntegral k x := Algebra.IsIntegral.isIntegral x
        let μ : Polynomial k := minpoly k x
        have hμ_monic : μ.Monic := minpoly.monic hx_int
        have hμ_ne : μ ≠ 0 := hμ_monic.ne_zero
        have hμ_deg_pos : 0 < μ.natDegree := minpoly.natDegree_pos hx_int
        have hμ_deg_ne0 : μ.degree ≠ 0 := by
          rw [Polynomial.degree_eq_natDegree hμ_ne]
          exact Nat.cast_ne_zero.mpr (by omega)
        obtain ⟨α, hα_root⟩ := IsAlgClosed.exists_root μ hμ_deg_ne0
        let a : ℕ := Polynomial.rootMultiplicity α μ
        have ha_pos : 0 < a := (Polynomial.rootMultiplicity_pos hμ_ne).mpr hα_root
        obtain ⟨Q, hμ_fac⟩ := Polynomial.pow_rootMultiplicity_dvd μ α
        let P_α : Polynomial k := (Polynomial.X - Polynomial.C α) ^ a
        have hP_monic : P_α.Monic := (Polynomial.monic_X_sub_C α).pow a
        have hP_ne : P_α ≠ 0 := hP_monic.ne_zero
        have hQ_ne : Q ≠ 0 := by
          intro hQ0
          rw [hQ0, mul_zero] at hμ_fac
          exact hμ_ne hμ_fac
        have hQ_monic : Q.Monic := by
          rw [Polynomial.Monic]
          have hlc : μ.leadingCoeff = P_α.leadingCoeff * Q.leadingCoeff := by
            rw [hμ_fac, Polynomial.leadingCoeff_mul]
          rwa [hμ_monic.leadingCoeff, hP_monic.leadingCoeff, one_mul, eq_comm] at hlc
        have h_not_dvd_Q : ¬ (Polynomial.X - Polynomial.C α ∣ Q) := by
          rintro ⟨R, rfl⟩
          have hdvd_succ : (Polynomial.X - Polynomial.C α) ^ (a + 1) ∣ μ := by
            refine ⟨R, ?_⟩
            rw [hμ_fac, pow_succ, mul_assoc]
          exact Polynomial.pow_rootMultiplicity_not_dvd hμ_ne α hdvd_succ
        have h_coprime : IsCoprime P_α Q :=
          ((Polynomial.irreducible_X_sub_C α).coprime_iff_not_dvd.mpr h_not_dvd_Q).pow_left
        have hQ_deg_pos : 1 ≤ Q.natDegree := by
          by_contra hle0
          have hQ0 : Q.natDegree = 0 := by omega
          have hQ1 : Q = 1 := by
            rw [Polynomial.eq_C_of_natDegree_eq_zero hQ0]
            have hlc : Q.coeff 0 = 1 := by
              have h := hQ_monic.leadingCoeff
              rwa [Polynomial.leadingCoeff, hQ0] at h
            rw [hlc, map_one]
          have hμ_eq_P : μ = P_α := by rw [hμ_fac, hQ1, mul_one]
          have hx_pow0 : (x - algebraMap k E α) ^ a = 0 := by
            have hev : Polynomial.aeval x μ = 0 := minpoly.aeval k x
            rw [hμ_eq_P] at hev
            simpa [P_α, map_pow, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] using hev
          have hx_sub0 : x - algebraMap k E α = 0 :=
            IsReduced.eq_zero _ ⟨a, hx_pow0⟩
          exact hx_not_mem ⟨α, (sub_eq_zero.mp hx_sub0).symm⟩
        have hP_deg : P_α.natDegree = a := by
          dsimp [P_α]
          rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C, mul_one]
        have hμ_deg_sum : μ.natDegree = a + Q.natDegree := by
          rw [hμ_fac, Polynomial.natDegree_mul hP_ne hQ_ne, hP_deg]
        obtain ⟨U, V, hUV⟩ := h_coprime
        let e₁ : E := Polynomial.aeval x (U * P_α)
        let e₂ : E := Polynomial.aeval x (V * Q)
        have he_sum : e₁ + e₂ = 1 := by
          dsimp [e₁, e₂]
          rw [← map_add, hUV, map_one]
        have he_mul : e₁ * e₂ = 0 := by
          dsimp [e₁, e₂]
          have hmul_poly : (U * P_α) * (V * Q) = (U * V) * μ := by
            rw [hμ_fac]; ring
          rw [← map_mul, hmul_poly, map_mul, minpoly.aeval k x, mul_zero]
        have he₁_ne : e₁ ≠ 0 := by
          intro he₁0
          have he₂1 : e₂ = 1 := by rw [← he_sum, he₁0, zero_add]
          have hP_eval0 : Polynomial.aeval x P_α = 0 := by
            calc Polynomial.aeval x P_α = e₂ * Polynomial.aeval x P_α := by rw [he₂1, one_mul]
              _ = Polynomial.aeval x (V * μ) := by
                    dsimp [e₂]; rw [← map_mul, hμ_fac]; congr 1; ring
              _ = 0 := by rw [map_mul, minpoly.aeval k x, mul_zero]
          have hdvd_P : μ ∣ P_α := minpoly.dvd k x hP_eval0
          have hle := Polynomial.natDegree_le_of_dvd hdvd_P hP_ne
          omega
        have he₂_ne : e₂ ≠ 0 := by
          intro he₂0
          have he₁1 : e₁ = 1 := by rw [← he_sum, he₂0, add_zero]
          have hQ_eval0 : Polynomial.aeval x Q = 0 := by
            calc Polynomial.aeval x Q = e₁ * Polynomial.aeval x Q := by rw [he₁1, one_mul]
              _ = Polynomial.aeval x (U * μ) := by
                    dsimp [e₁]; rw [← map_mul, hμ_fac]; congr 1; ring
              _ = 0 := by rw [map_mul, minpoly.aeval k x, mul_zero]
          have hdvd_Q : μ ∣ Q := minpoly.dvd k x hQ_eval0
          have hle := Polynomial.natDegree_le_of_dvd hdvd_Q hQ_ne
          omega
        let I₁ : Ideal E := Ideal.span {e₂}
        let I₂ : Ideal E := Ideal.span {e₁}
        let E₁ : Type u := E ⧸ I₁
        let E₂ : Type u := E ⧸ I₂
        let π₁ : E →ₐ[k] E₁ := Ideal.Quotient.mkₐ k I₁
        let π₂ : E →ₐ[k] E₂ := Ideal.Quotient.mkₐ k I₂
        have hπ₁_e₂ : π₁ e₂ = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span rfl)
        have hπ₂_e₁ : π₂ e₁ = 0 :=
          (Ideal.Quotient.eq_zero_iff_mem).mpr (Ideal.subset_span rfl)
        have hπ₁_e₁ : π₁ e₁ = 1 := by
          have h1 := congrArg π₁ he_sum
          rwa [map_add, hπ₁_e₂, add_zero, map_one] at h1
        have hπ₂_e₂ : π₂ e₂ = 1 := by
          have h1 := congrArg π₂ he_sum
          rwa [map_add, hπ₂_e₁, zero_add, map_one] at h1
        let φ_prod : E →ₐ[k] E₁ × E₂ := AlgHom.prod π₁ π₂
        have hφ_inj : Function.Injective φ_prod := by
          rw [injective_iff_map_eq_zero]
          intro z hz0
          have hz₁ : z ∈ I₁ :=
            (Ideal.Quotient.eq_zero_iff_mem).mp (congrArg Prod.fst hz0)
          have hz₂ : z ∈ I₂ :=
            (Ideal.Quotient.eq_zero_iff_mem).mp (congrArg Prod.snd hz0)
          obtain ⟨r₁, hr₁⟩ := Ideal.mem_span_singleton.mp hz₁
          obtain ⟨r₂, hr₂⟩ := Ideal.mem_span_singleton.mp hz₂
          have hze₁ : z * e₁ = 0 := by
            rw [hr₁]
            calc (e₂ * r₁) * e₁ = r₁ * (e₁ * e₂) := by ring
              _ = 0 := by rw [he_mul, mul_zero]
          have hze₂ : z * e₂ = 0 := by
            rw [hr₂]
            calc (e₁ * r₂) * e₂ = r₂ * (e₁ * e₂) := by ring
              _ = 0 := by rw [he_mul, mul_zero]
          calc z = z * 1 := (mul_one z).symm
            _ = z * (e₁ + e₂) := by rw [← he_sum]
            _ = z * e₁ + z * e₂ := mul_add z e₁ e₂
            _ = 0 := by rw [hze₁, hze₂, add_zero]
        have hφ_surj : Function.Surjective φ_prod := by
          rintro ⟨u₁, u₂⟩
          obtain ⟨y₁, rfl⟩ := Ideal.Quotient.mk_surjective u₁
          obtain ⟨y₂, rfl⟩ := Ideal.Quotient.mk_surjective u₂
          refine ⟨y₁ * e₁ + y₂ * e₂, ?_⟩
          apply Prod.ext
          · change π₁ (y₁ * e₁ + y₂ * e₂) = Ideal.Quotient.mk I₁ y₁
            rw [map_add, map_mul, map_mul, hπ₁_e₁, hπ₁_e₂, mul_one, mul_zero, add_zero]
            rfl
          · change π₂ (y₁ * e₁ + y₂ * e₂) = Ideal.Quotient.mk I₂ y₂
            rw [map_add, map_mul, map_mul, hπ₂_e₁, hπ₂_e₂, mul_zero, mul_one, zero_add]
            rfl
        let e_prod : E ≃ₐ[k] E₁ × E₂ := AlgEquiv.ofBijective φ_prod ⟨hφ_inj, hφ_surj⟩
        have he_prod_e₁ : e_prod e₁ = (1, 0) := Prod.ext hπ₁_e₁ hπ₂_e₁
        have he_prod_e₂ : e_prod e₂ = (0, 1) := Prod.ext hπ₁_e₂ hπ₂_e₂
        have : IsReduced E₁ := ⟨fun y₁ ⟨m₀, hm₀⟩ => by
          have h_nil : (e_prod.symm (y₁, 0)) ^ (m₀ + 1) = 0 := by
            rw [← map_pow]
            have hprod0 : ((y₁, (0 : E₂)) ^ (m₀ + 1)) = 0 := by
              ext
              · simp [pow_succ, hm₀]
              · simp
            rw [hprod0, map_zero]
          have hsymm0 : e_prod.symm (y₁, 0) = 0 := IsReduced.eq_zero _ ⟨m₀ + 1, h_nil⟩
          have hpair0 : (y₁, (0 : E₂)) = (0, 0) := by
            have h1 := congrArg e_prod hsymm0
            simpa using h1
          exact congrArg Prod.fst hpair0⟩
        have : IsReduced E₂ := ⟨fun y₂ ⟨m₀, hm₀⟩ => by
          have h_nil : (e_prod.symm (0, y₂)) ^ (m₀ + 1) = 0 := by
            rw [← map_pow]
            have hprod0 : (((0 : E₁), y₂) ^ (m₀ + 1)) = 0 := by
              ext
              · simp
              · simp [pow_succ, hm₀]
            rw [hprod0, map_zero]
          have hsymm0 : e_prod.symm (0, y₂) = 0 := IsReduced.eq_zero _ ⟨m₀ + 1, h_nil⟩
          have hpair0 : ((0 : E₁), y₂) = (0, 0) := by
            have h1 := congrArg e_prod hsymm0
            simpa using h1
          exact congrArg Prod.snd hpair0⟩
        have : Nontrivial E₁ := ⟨⟨0, 1, fun h01 => by
          have h1 : e_prod e₁ = 0 := by rw [he_prod_e₁, ← h01]; rfl
          exact he₁_ne (e_prod.injective (h1.trans (map_zero e_prod).symm))⟩⟩
        have : Nontrivial E₂ := ⟨⟨0, 1, fun h01 => by
          have h1 : e_prod e₂ = 0 := by rw [he_prod_e₂, ← h01]; rfl
          exact he₂_ne (e_prod.injective (h1.trans (map_zero e_prod).symm))⟩⟩
        have : FiniteDimensional k E₁ := Module.Finite.of_surjective π₁.toLinearMap
          Ideal.Quotient.mk_surjective
        have : FiniteDimensional k E₂ := Module.Finite.of_surjective π₂.toLinearMap
          Ideal.Quotient.mk_surjective
        let n₁ := Module.finrank k E₁
        let n₂ := Module.finrank k E₂
        have hn₁_pos : 1 ≤ n₁ := Module.finrank_pos
        have hn₂_pos : 1 ≤ n₂ := Module.finrank_pos
        have hn_sum : n₁ + n₂ = n := by
          calc n₁ + n₂ = Module.finrank k (E₁ × E₂) := (Module.finrank_prod).symm
            _ = Module.finrank k E := e_prod.symm.toLinearEquiv.finrank_eq
            _ = n := hrkE
        obtain ⟨q₁, hq₁_ne, hq₁_idem, hq₁_orth, hq₁_sum⟩ :=
          ih n₁ (by omega) hn₁_pos E₁ rfl
        obtain ⟨q₂, hq₂_ne, hq₂_idem, hq₂_orth, hq₂_sum⟩ :=
          ih n₂ (by omega) hn₂_pos E₂ rfl
        let q_sum : Fin n₁ ⊕ Fin n₂ → E := fun s =>
          match s with
          | Sum.inl i => e_prod.symm (q₁ i, 0)
          | Sum.inr j => e_prod.symm (0, q₂ j)
        have hq_sum_ne : ∀ s, q_sum s ≠ 0 := by
          rintro (i | j) h0
          · have h1 := congrArg e_prod h0
            simp only [q_sum, AlgEquiv.apply_symm_apply, map_zero] at h1
            exact hq₁_ne i (congrArg Prod.fst h1)
          · have h1 := congrArg e_prod h0
            simp only [q_sum, AlgEquiv.apply_symm_apply, map_zero] at h1
            exact hq₂_ne j (congrArg Prod.snd h1)
        have hq_sum_idem : ∀ s, q_sum s * q_sum s = q_sum s := by
          rintro (i | j)
          · simp only [q_sum, ← map_mul]
            congr 1
            exact Prod.ext (hq₁_idem i) (mul_zero 0)
          · simp only [q_sum, ← map_mul]
            congr 1
            exact Prod.ext (mul_zero 0) (hq₂_idem j)
        have hq_sum_orth : ∀ s t, s ≠ t → q_sum s * q_sum t = 0 := by
          rintro (i | j) (i' | j') hst
          · have hii' : i ≠ i' := fun h => hst (congrArg Sum.inl h)
            simp only [q_sum, ← map_mul]
            rw [show ((q₁ i, (0 : E₂)) * (q₁ i', (0 : E₂))) = 0 from
              Prod.ext (hq₁_orth i i' hii') (mul_zero 0), map_zero]
          · simp only [q_sum, ← map_mul]
            rw [show ((q₁ i, (0 : E₂)) * ((0 : E₁), q₂ j')) = 0 from
              Prod.ext (mul_zero _) (zero_mul _), map_zero]
          · simp only [q_sum, ← map_mul]
            rw [show (((0 : E₁), q₂ j) * (q₁ i', (0 : E₂))) = 0 from
              Prod.ext (zero_mul _) (mul_zero _), map_zero]
          · have hjj' : j ≠ j' := fun h => hst (congrArg Sum.inr h)
            simp only [q_sum, ← map_mul]
            rw [show (((0 : E₁), q₂ j) * ((0 : E₁), q₂ j')) = 0 from
              Prod.ext (mul_zero 0) (hq₂_orth j j' hjj'), map_zero]
        have hq_sum_one : (∑ s : Fin n₁ ⊕ Fin n₂, q_sum s) = 1 := by
          rw [Fintype.sum_sum_type]
          simp only [q_sum, ← map_sum, ← map_add]
          have hpair1 : (∑ x : Fin n₁, (q₁ x, (0 : E₂))) +
              (∑ x : Fin n₂, ((0 : E₁), q₂ x)) = 1 := by
            apply Prod.ext
            · simp [Prod.fst_sum, hq₁_sum]
            · simp [Prod.snd_sum, hq₂_sum]
          rw [hpair1, map_one]
        let eqv : Fin n ≃ Fin n₁ ⊕ Fin n₂ :=
          (finCongr hn_sum.symm).trans finSumFinEquiv.symm
        refine ⟨fun i => q_sum (eqv i), fun i => hq_sum_ne (eqv i),
          fun i => hq_sum_idem (eqv i),
          fun i j hij => hq_sum_orth (eqv i) (eqv j) (eqv.injective.ne hij), ?_⟩
        rw [Equiv.sum_comp eqv q_sum]
        exact hq_sum_one

  
  obtain ⟨q, hq_ne, hq_idem, hq_orth, hq_sum⟩ :=
    h_rec (Module.finrank k ↥C) (hm.trans hm_C) ↥C rfl
  refine ⟨Module.finrank k ↥C, fun i => (q i).1, hm_C, fun i => (q i).2,
    fun i h0 => hq_ne i (Subtype.ext h0),
    fun i => congrArg Subtype.val (hq_idem i),
    fun i j hij => congrArg Subtype.val (hq_orth i j hij), ?_⟩
  change (∑ i : Fin (Module.finrank k ↥C), C.val (q i)) = C.val 1
  rw [← map_sum, hq_sum]

theorem weil_smooth_pencil_projLine_geom_and_simply_connected (F : Type u) [Field F] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F) :
    let k := AlgebraicClosure F
    let D₀ := weilProjectiveSpaceOver F 1
    let P_bar := weilBaseChangeOver F k D₀
    let P₁_k := weilProjectiveSpaceOver k 1
    (AlgebraicGeometry.GeometricallyIrreducible D₀.hom ∧
      AlgebraicGeometry.IsProper D₀.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 D₀.hom) ∧
    (AlgebraicGeometry.IsIntegral P₁_k.left ∧
      IsProjectiveOverField k P₁_k ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁_k.hom) ∧
    (∃ e_P : P_bar ≅ P₁_k,
      ∀ q : ℕ, Nonempty (weilEtaleTorsionH P_bar.left ℓ q ≃+ weilEtaleTorsionH P₁_k.left ℓ q)) ∧
    (∀ (𝒢 : CategoryTheory.Sheaf P_bar.left.smallEtaleTopology AddCommGrpCat.{u})
       (A₀ : AddCommGrpCat.{u}) [Finite ↥A₀],
      (∀ x : ↥P_bar.left,
        ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ P_bar.left),
          AlgebraicGeometry.Etale w ∧
          x ∈ Set.range w.base ∧
          WeilIsEtaleSheafPullback w 𝒢
            ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)) →
      ∀ (T : P_bar.left.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
        Finite ↥(𝒢.obj.obj (Opposite.op T)) ∧
        CategoryTheory.IsIso
          ((CategoryTheory.constantSheafAdj P_bar.left.smallEtaleTopology
            AddCommGrpCat.{u} hT).counit.app 𝒢)) ∧
    Subsingleton (weilEtaleTorsionH P_bar.left ℓ 1) :=
by
  intro k D₀ P_bar P₁_k
  have hℓ_prime : Nat.Prime ℓ := Fact.out
  have hℓ_k : (ℓ : k) ≠ 0 := by
    intro h0
