        Nonempty ((M_gU.op ⋙ G.cohomologyPresheaf 1) ≅ (R_gU.obj G).cohomologyPresheaf 1) := by
      intro G
      obtain ⟨SC, hSC_X1, hI, hSE⟩ := hInjEmbed G
      subst hSC_X1
      let I := SC.X₂
      let Q := SC.X₃
      let v := SC.g
      let _ : CategoryTheory.Injective I := hI
      let _ : CategoryTheory.Injective (R_gU.obj I) := hInj_R I hI
      let SC' := SC.map R_gU
      have hSE' : SC'.ShortExact := hMapSE hSE

      obtain ⟨δ_Y, hcomp₁_Y, _, hEx₁_Y, hEx₂_Y⟩ := hConnPre_Y' SC hSE 0
      have hu1_zero : (CP_Y' 1).map SC.f = 0 := (hInjZero_Y' I 0).eq_of_tgt _ 0
      have _ : CategoryTheory.Epi δ_Y := hEx₂_Y.epi_f hu1_zero
      let v₀_Y := W_Mg.map ((CP_Y' 0).map v)
      have hw_comp : v₀_Y ≫ W_Mg.map δ_Y = 0 := by
        dsimp [v₀_Y]
        rw [← W_Mg.map_comp, hcomp₁_Y, W_Mg.map_zero]
      have hEx_w : (CategoryTheory.ShortComplex.mk v₀_Y (W_Mg.map δ_Y) hw_comp).Exact :=
