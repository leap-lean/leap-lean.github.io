                  CommRingCat.ofHom (algebraMap ↑(B.obj i) (Localization.Away (s_lvl i))) ≫
                    s.ι.app i
                naturality := fun {i j} θ => by
                  dsimp
                  rw [CategoryTheory.Category.comp_id]
