          { toFun := fun g j => e_at (ι_J j) (g j)
            map_add' := fun g₁ g₂ => funext fun j => map_add (e_at (ι_J j)) (g₁ j) (g₂ j)
            map_smul' := fun r g => funext fun j =>
              ((e_at (ι_J j)).toLinearMap.restrictScalars R).map_smul r (g j) }
