    apply (eqv₀_X H₂).injective
    have hL : eqv₀_X H₂ (Θ₀ H₂ (((CategoryTheory.Abelian.Ext.mk₀ (pf.map φ)).postcomp
        Fℤ_S (Nat.add_zero 0)) z)) =
