        { homEquiv := fun ℱ 𝒢 =>
            ((shAdj_Y'.homEquiv (j_pre_bang.obj (ι_U.obj ℱ)) 𝒢).trans
              (adj_pre.homEquiv (ι_U.obj ℱ) (ι_Y'.obj 𝒢))).trans
              (ff_sheaf_U ℱ (R_gU.obj 𝒢))
          homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} u g => by
            let g' : ι_U.obj ℱ ⟶ R_pre.obj (ι_Y'.obj 𝒢) := g.hom
            change (shAdj_Y'.homEquiv (j_pre_bang.obj (ι_U.obj ℱ')) 𝒢).symm
                ((adj_pre.homEquiv (ι_U.obj ℱ') (ι_Y'.obj 𝒢)).symm (ι_U.map u ≫ g')) =
