import WeilPart33
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_aff_cd_strictLocal_vanishing_and_colimit_stalk_zero (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSite : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (hSliceIso : WeilEtaleSliceCohomologyIsoHolds.{u} (@hc_all) (@hr_all) hSite)
    (κ : Type u) [Field κ] [IsAlgClosed κ] :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
        ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
    (∀ (A : Type u) [CommRing A] [Algebra κ A] (τ_A : A →ₐ[κ] κ),
      WeilIsStrictLocalNoetherianAlgClosedRing κ A τ_A →
      ∀ (q : ℕ), 1 ≤ q →
      ∀ (𝒢 : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of A)).smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton (𝒢.H q)) ∧
    (∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S)
      (B₀ : Type u) [CommRing B₀] [Algebra κ B₀]
      (j_chart : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₀)) S)
      [AlgebraicGeometry.IsOpenImmersion j_chart]
      (τ₀ : B₀ →ₐ[κ] κ)
      (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ)))
      (b : ℕ)
      (ℱ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (C : Type u) [CommRing C] (g_C : B₀ →+* C) (τ_C : C →+* κ),
        g_C.Etale → τ_C.comp g_C = τ₀.toRingHom →
        ∃ (W_C : AlgebraicGeometry.Scheme.{u})
          (p_C : Quiver.Hom W_C (AlgebraicGeometry.Spec (CommRingCat.of C)))
          (π_C : Quiver.Hom W_C X),
          CategoryTheory.IsPullback p_C π_C
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_C)) j_chart) f ∧
          ∀ (ξ : (((weilEtaleSitePullback π_C).sheafPullback AddCommGrpCat.{u}
              X.smallEtaleTopology W_C.smallEtaleTopology).obj ℱ).H b),
            ∃ (C' : Type u) (_ : CommRing C') (h_C : C →+* C') (τ_C' : C' →+* κ)
              (W_C' : AlgebraicGeometry.Scheme.{u})
              (p_C' : Quiver.Hom W_C' (AlgebraicGeometry.Spec (CommRingCat.of C')))
              (π_C' : Quiver.Hom W_C' X)
              (u_W : Quiver.Hom W_C' W_C)
              (hu_W : CategoryTheory.CategoryStruct.comp u_W π_C = π_C'),
              h_C.Etale ∧
              τ_C'.comp h_C = τ_C ∧
              CategoryTheory.IsPullback p_C' π_C'
                (CategoryTheory.CategoryStruct.comp
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (h_C.comp g_C))) j_chart) f ∧
              CategoryTheory.CategoryStruct.comp u_W p_C =
                CategoryTheory.CategoryStruct.comp p_C'
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom h_C)) ∧
              WeilEtaleTrianglePullbackMapsTo π_C' π_C u_W hu_W ℱ b ξ 0) →
      WeilAltCdStalkZeroAt S (weilAltCdHigherDirectImage f b ℱ)
        ((CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom)) j_chart).base pt)) :=
by
  classical
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  have hNull : ∀ (K F : Type u) [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
      [Algebra.FiniteType K F], Function.Bijective (algebraMap K F) := by
    intro K F _ _ _ _ _
    obtain ⟨n₀, g, hg_inj, hg_fin⟩ := exists_finite_inj_algHom_of_fg K F
    let _ : Algebra (MvPolynomial (Fin n₀) K) F := g.toRingHom.toAlgebra
    have _ : Algebra.IsIntegral (MvPolynomial (Fin n₀) K) F :=
      Algebra.isIntegral_def.mpr hg_fin.to_isIntegral
    have hIsField_mv : IsField (MvPolynomial (Fin n₀) K) :=
      (Algebra.IsIntegral.isField_iff_isField (R := MvPolynomial (Fin n₀) K) (S := F) hg_inj).mpr
        (Field.toIsField F)
    have _ : IsEmpty (Fin n₀) := ⟨fun i => by
      have hX_ne : (MvPolynomial.X i : MvPolynomial (Fin n₀) K) ≠ 0 := MvPolynomial.X_ne_zero i
      obtain ⟨q_inv, hq_inv⟩ := hIsField_mv.mul_inv_cancel hX_ne
      have hc := congrArg MvPolynomial.constantCoeff hq_inv
      rw [map_mul, MvPolynomial.constantCoeff_X, zero_mul, map_one] at hc
      exact zero_ne_one hc⟩
    let _ : IsScalarTower K (MvPolynomial (Fin n₀) K) F :=
      IsScalarTower.of_algebraMap_eq' g.comp_algebraMap.symm
    have _ : Algebra.IsIntegral K (MvPolynomial (Fin n₀) K) := ⟨fun p => by
      rw [MvPolynomial.eq_C_of_isEmpty p, MvPolynomial.C_eq_algebraMap]
      exact isIntegral_algebraMap⟩
    have _ : Algebra.IsIntegral K F :=
      Algebra.IsIntegral.trans (R := K) (A := MvPolynomial (Fin n₀) K) (B := F)
    exact IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K) (K := F)

  have hStrictLocalSieve : ∀ (A : Type u) [CommRing A] [Algebra κ A] (τ_A : A →ₐ[κ] κ),
      WeilIsStrictLocalNoetherianAlgClosedRing κ A τ_A →
      ∀ (R : CategoryTheory.Sieve
          (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of A)))),
        R ∈ (AlgebraicGeometry.Spec (CommRingCat.of A)).smallEtaleTopology
          (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of A))) →
        R.arrows (CategoryTheory.CategoryStruct.id
          (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of A)))) := by
    intro A _ _ τ_A hA R hR
    rcases hA with ⟨_, hLocA, hKerA, _, hSecA⟩
    let _ : IsLocalRing A := hLocA
    let S_A := AlgebraicGeometry.Spec (CommRingCat.of A)
    let T_A : S_A.Etale := weilEtaleIdTerminal.{u} S_A
    let q_κ : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ)) := IsLocalRing.closedPoint κ
    have hq_κ_zero : ∀ c : κ, c ∈ q_κ.asIdeal ↔ c = 0 := by
      intro c
      constructor
      · intro hc
        by_contra hc_ne
        exact q_κ.isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem q_κ.asIdeal hc (IsUnit.mk0 c hc_ne))
      · rintro rfl
        exact q_κ.asIdeal.zero_mem
    let x_m : ↥S_A := (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)).base q_κ
    have hx_m_ideal : x_m.asIdeal = IsLocalRing.maximalIdeal A := by
      ext a
      have hmem : a ∈ x_m.asIdeal ↔ τ_A a ∈ q_κ.asIdeal := Iff.rfl
      rw [hmem, hq_κ_zero, hKerA a, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hJS :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S_A (le_refl P_et)
    have hR' : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck T_A := by
      change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S_A T_A at hR
      rwa [hJS] at hR
    have hR'' := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) T_A R).mp hR'
    obtain ⟨Y, u, y, hRu, _, hy⟩ := hR'' (x_m : ↥T_A.left)
    have hy_hom : Y.hom.base y = x_m := by
      let u_sch : Quiver.Hom Y.left S_A := u.left
      have hu_eq : u_sch = Y.hom :=
        (CategoryTheory.Category.comp_id u_sch).symm.trans
          (CategoryTheory.MorphismProperty.Over.w u)
      exact (congrArg (fun k : Quiver.Hom Y.left S_A => k.base y) hu_eq.symm).trans hy
    obtain ⟨R_C, j_W, hj_W_open, ⟨𝔮, h𝔮⟩, _⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : Y.left.Opens)) (x := y) trivial
    let _ : AlgebraicGeometry.IsOpenImmersion j_W := hj_W_open
    let C : Type u := ↑R_C
    let g_sch : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of C)) S_A :=
      CategoryTheory.CategoryStruct.comp j_W Y.hom
    have _ : AlgebraicGeometry.Etale Y.hom := Y.prop
    have hg_sch_et : AlgebraicGeometry.Etale g_sch := inferInstance
    let g_mor : Quiver.Hom (CommRingCat.of A) (CommRingCat.of C) :=
      AlgebraicGeometry.Spec.preimage g_sch
    have hg_map : AlgebraicGeometry.Spec.map g_mor = g_sch :=
      AlgebraicGeometry.Spec.map_preimage g_sch
    let g_AC : A →+* C := g_mor.hom
    have hg_AC : g_AC.Etale := by
      have hSpecEt : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_AC)) := by
        change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g_mor)
        rwa [hg_map]
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hSpecEt
    let _ : Algebra A C := g_AC.toAlgebra
    have _ : Algebra.Etale A C := RingHom.etale_algebraMap.mp hg_AC
    have h𝔮_map : (AlgebraicGeometry.Spec.map g_mor).base 𝔮 = x_m := by
      rw [hg_map]
      change Y.hom.base (j_W.base 𝔮) = x_m
      rw [h𝔮, hy_hom]
    have hcomap_𝔮 : Ideal.comap g_AC 𝔮.asIdeal = IsLocalRing.maximalIdeal A := by
      rw [← hx_m_ideal, ← h𝔮_map]
      rfl
    obtain ⟨𝔪, h𝔪, h𝔮𝔪⟩ := Ideal.exists_le_maximal 𝔮.asIdeal 𝔮.isPrime.ne_top
    have hcomap_𝔪_le : IsLocalRing.maximalIdeal A ≤ Ideal.comap g_AC 𝔪 := by
      rw [← hcomap_𝔮]
      exact Ideal.comap_mono h𝔮𝔪
    have hcomap_𝔪_ne : Ideal.comap g_AC 𝔪 ≠ ⊤ := by
      intro htop
      have h1 : (1 : A) ∈ Ideal.comap g_AC 𝔪 := htop ▸ Submodule.mem_top
      rw [Ideal.mem_comap, map_one] at h1
      exact h𝔪.ne_top (Ideal.eq_top_of_isUnit_mem 𝔪 h1 isUnit_one)
    have hcomap_𝔪 : Ideal.comap g_AC 𝔪 = IsLocalRing.maximalIdeal A :=
      ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hcomap_𝔪_ne hcomap_𝔪_le).symm
    let F : Type u := C ⧸ 𝔪
    let _ : Field F := @Ideal.Quotient.field C _ 𝔪 h𝔪
    let q_𝔪 : C →+* F := Ideal.Quotient.mk 𝔪
    let _ : Algebra κ F := (q_𝔪.comp (g_AC.comp (algebraMap κ A))).toAlgebra
    have hFT_AC : Algebra.FiniteType A C :=
      RingHom.finiteType_algebraMap.mp
        (RingHom.FiniteType.of_finitePresentation
          (RingHom.finitePresentation_algebraMap.mpr
            (Algebra.Etale.finitePresentation (R := A) (A := C))))
    obtain ⟨S_C, hS_C⟩ := hFT_AC.out
    let S_F : Finset F := S_C.image q_𝔪
    have hScalar_eq : ∀ a : A, q_𝔪 (g_AC a) = algebraMap κ F (τ_A a) := by
      intro a
      have hker : τ_A (a - algebraMap κ A (τ_A a)) = 0 := by
        rw [map_sub, τ_A.commutes]
        exact sub_self (τ_A a)
      have hmem_m : a - algebraMap κ A (τ_A a) ∈ IsLocalRing.maximalIdeal A := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← hKerA]
        exact hker
      rw [← hcomap_𝔪, Ideal.mem_comap, map_sub] at hmem_m
      have hq_sub : q_𝔪 (g_AC a - g_AC (algebraMap κ A (τ_A a))) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hmem_m
      rw [map_sub, sub_eq_zero] at hq_sub
      exact hq_sub
    have _ : Algebra.FiniteType κ F := by
      refine ⟨⟨S_F, top_unique fun z _ => ?_⟩⟩
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective z
      have hc_top : c ∈ Algebra.adjoin A (S_C : Set C) := hS_C ▸ Algebra.mem_top
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hc_top
      · intro s hs
        exact Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_image_of_mem q_𝔪 (Finset.mem_coe.mp hs)))
      · intro a
        change q_𝔪 (g_AC a) ∈ Algebra.adjoin κ (S_F : Set F)
        rw [hScalar_eq a]
        exact Subalgebra.algebraMap_mem _ _
      · intro c₁ c₂ _ _ ih₁ ih₂
        rw [map_add]
        exact Subalgebra.add_mem _ ih₁ ih₂
      · intro c₁ c₂ _ _ ih₁ ih₂
        rw [map_mul]
        exact Subalgebra.mul_mem _ ih₁ ih₂
    let e_κF : κ ≃+* F := RingEquiv.ofBijective (algebraMap κ F) (hNull κ F)
    let τ_C : C →+* κ := e_κF.symm.toRingHom.comp q_𝔪
    have hτ_C_ext : ∀ a : A, τ_C (algebraMap A C a) = τ_A a := by
      intro a
      change e_κF.symm (q_𝔪 (g_AC a)) = τ_A a
      rw [hScalar_eq a]
      exact e_κF.symm_apply_apply (τ_A a)
    obtain ⟨σ_C, _⟩ := hSecA C τ_C hτ_C_ext
    let s_sch : Quiver.Hom T_A.left Y.left :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_C.toRingHom)) j_W
    have hs_hom : CategoryTheory.CategoryStruct.comp s_sch Y.hom = T_A.hom := by
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_C.toRingHom) ≫ j_W) ≫ Y.hom =
        CategoryTheory.CategoryStruct.id S_A
      rw [CategoryTheory.Category.assoc]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_C.toRingHom) ≫ g_sch = _
      rw [← hg_map, ← AlgebraicGeometry.Spec.map_comp]
      have hcomp_id : CategoryTheory.CategoryStruct.comp g_mor
          (CommRingCat.ofHom σ_C.toRingHom) = CategoryTheory.CategoryStruct.id (CommRingCat.of A) :=
        CommRingCat.hom_ext (RingHom.ext σ_C.commutes)
      rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
    let s_et : Quiver.Hom T_A Y :=
      CategoryTheory.MorphismProperty.Over.homMk s_sch hs_hom trivial
    have hs_u : CategoryTheory.CategoryStruct.comp s_et u = CategoryTheory.CategoryStruct.id T_A :=
      (weilEtaleIdTerminalIsTerminal.{u} S_A).hom_ext _ _
    have hRs := R.downward_closed hRu s_et
    rwa [hs_u] at hRs

  have hTrivSieveVanish : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      (∀ (R : CategoryTheory.Sieve (weilEtaleIdTerminal.{u} Z)),
        R ∈ Z.smallEtaleTopology (weilEtaleIdTerminal.{u} Z) →
        R.arrows (CategoryTheory.CategoryStruct.id (weilEtaleIdTerminal.{u} Z))) →
      ∀ (q : ℕ), 1 ≤ q →
      ∀ (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton (𝒢.H q) := by
    intro Z hTriv q hq 𝒢
    let J := Z.smallEtaleTopology
    let T_Z : Z.Etale := weilEtaleIdTerminal.{u} Z
    let hT_Z := weilEtaleIdTerminalIsTerminal.{u} Z
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_Z
    have hLift : ∀ {M₁ M₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (π : Quiver.Hom M₁ M₂) [CategoryTheory.Epi π] (g : Quiver.Hom Fℤ M₂),
        ∃ f : Quiver.Hom Fℤ M₁, CategoryTheory.CategoryStruct.comp f π = g := by
      intro M₁ M₂ π _ g
      have _ : CategoryTheory.Presheaf.IsLocallySurjective J π.hom :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
      let φ₂ : Quiver.Hom Aℤ (M₂.obj.obj (Opposite.op T_Z)) := (adj_c.homEquiv Aℤ M₂) g
      let m₂ : ↥(M₂.obj.obj (Opposite.op T_Z)) := φ₂.hom (ULift.up 1)
      have hMem : CategoryTheory.Presheaf.imageSieve π.hom m₂ ∈ J T_Z :=
        CategoryTheory.Presheaf.imageSieve_mem J π.hom m₂
      obtain ⟨m₁, hm₁⟩ := hTriv _ hMem
      have hm₁' : (π.hom.app (Opposite.op T_Z)).hom m₁ = m₂ :=
        hm₁.trans (congrArg (fun φ => φ.hom m₂) (M₂.obj.map_id (Opposite.op T_Z)))
      let φ₁ : Quiver.Hom Aℤ (M₁.obj.obj (Opposite.op T_Z)) :=
        AddCommGrpCat.ofHom
          { toFun := fun n => n.down • m₁
            map_zero' := zero_zsmul m₁
            map_add' := fun a b => add_zsmul m₁ a.down b.down }
      have hφ_comp : CategoryTheory.CategoryStruct.comp φ₁ (π.hom.app (Opposite.op T_Z)) = φ₂ := by
        apply AddCommGrpCat.ext
        intro n
        have hn : n = n.down • (ULift.up (1 : ℤ) : ↥Aℤ) :=
          ULift.ext _ _ (by change n.down = n.down * 1; ring)
        change (π.hom.app (Opposite.op T_Z)).hom (n.down • m₁) = φ₂.hom n
        rw [map_zsmul, hm₁']
        conv_rhs => rw [hn, map_zsmul]
      let f : Quiver.Hom Fℤ M₁ := (adj_c.homEquiv Aℤ M₁).symm φ₁
      refine ⟨f, (adj_c.homEquiv Aℤ M₂).injective ?_⟩
      rw [adj_c.homEquiv_naturality_right]
      change CategoryTheory.CategoryStruct.comp ((adj_c.homEquiv Aℤ M₁) f)
        (π.hom.app (Opposite.op T_Z)) = φ₂
      rw [Equiv.apply_symm_apply, hφ_comp]
    have h_sc_zero : ∀ {T : CategoryTheory.ShortComplex AddCommGrpCat.{u}},
        T.Exact → CategoryTheory.CategoryStruct.comp T.f T.g = 0 :=
      fun {T} _ => T.zero
    have hmk₀_comp_extClass :
        ∀ {S_c : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J AddCommGrpCat.{u})}
          (hS_c : S_c.ShortExact) (f : Quiver.Hom Fℤ S_c.X₂),
          ((CategoryTheory.Abelian.Ext.mk₀ f).comp
            (CategoryTheory.Abelian.Ext.mk₀ S_c.g) (Nat.add_zero 0)).comp
            hS_c.extClass (Nat.zero_add 1) = 0 := by
      intro S_c hS_c f
      have h0 := h_sc_zero (CategoryTheory.Abelian.Ext.covariant_sequence_exact₃'
        Fℤ hS_c 0 1 (Nat.zero_add 1))
      have hap := congrArg (fun (φ : AddCommGrpCat.of (CategoryTheory.Abelian.Ext Fℤ S_c.X₂ 0) ⟶
        AddCommGrpCat.of (CategoryTheory.Abelian.Ext Fℤ S_c.X₁ 1)) =>
        φ.hom (CategoryTheory.Abelian.Ext.mk₀ f)) h0
      simpa [CategoryTheory.Abelian.Ext.postcomp] using hap
    obtain ⟨r, rfl⟩ : ∃ r : ℕ, q = r + 1 := ⟨q - 1, (Nat.sub_add_cancel hq).symm⟩
    clear hq
    revert 𝒢
    induction r with
    | zero =>
      intro 𝒢
      let I := CategoryTheory.Injective.under 𝒢
      let ι : Quiver.Hom 𝒢 I := CategoryTheory.Injective.ι 𝒢
      let Q := CategoryTheory.Limits.cokernel ι
      let π : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π ι
      let SC := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hSG : SC.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      refine ⟨fun x₁ x₂ => ?_⟩
      suffices hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} Fℤ 𝒢 1, z = 0 by
        rw [hzero x₁, hzero x₂]
      intro z
      have hz_ι : z.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero 1) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSG z hz_ι (Nat.zero_add 1)
      obtain ⟨g, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective Fℤ Q).2 y
      obtain ⟨f, hf⟩ := hLift π g
      rw [← hf, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact hmk₀_comp_extClass hSG f
    | succ r ih =>
      intro 𝒢
      let I := CategoryTheory.Injective.under 𝒢
      let ι : Quiver.Hom 𝒢 I := CategoryTheory.Injective.ι 𝒢
      let Q := CategoryTheory.Limits.cokernel ι
      let π : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π ι
      let SC := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hSG : SC.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι
          mono_f := inferInstance
          epi_g := inferInstance }
      have hSubQ : Subsingleton (CategoryTheory.Abelian.Ext.{u} Fℤ Q (r + 1)) := ih Q
      refine ⟨fun x₁ x₂ => ?_⟩
      suffices hzero : ∀ z : CategoryTheory.Abelian.Ext.{u} Fℤ 𝒢 (r + 2), z = 0 by
        rw [hzero x₁, hzero x₂]
      intro z
      have hz_ι : z.comp (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero (r + 2)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨w, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSG z hz_ι rfl
      have hw0 : w = 0 := @Subsingleton.elim _ hSubQ w 0
      rw [hw0, CategoryTheory.Abelian.Ext.zero_comp]

  have hOpenChartRef : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      (B₀ : Type u) [CommRing B₀] [Algebra κ B₀]
      (j_chart : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₀)) S)
      [AlgebraicGeometry.IsOpenImmersion j_chart]
      (τ₀ : B₀ →ₐ[κ] κ)
      (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of κ))),
      let x₀ : ↥S := (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom)) j_chart).base pt
      let Ω : Type u := AlgebraicClosure ↥(S.residueField x₀)
      let gx₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x₀) Ω)))
          (S.fromSpecResidueField x₀)
      ∀ (U U₁ : S.Etale) (v₁ : Quiver.Hom U₁ U)
        (u : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) U.left)
        (z₁ : ↥U₁.left),
        CategoryTheory.CategoryStruct.comp u U.hom = gx₀ →
        AlgebraicGeometry.Etale v₁.left →
        v₁.left.base z₁ = u.base (IsLocalRing.closedPoint Ω) →
        ∃ (e_κΩ : κ ≃+* Ω)
          (C : Type u) (_ : CommRing C) (g_C : B₀ →+* C) (τ_C : C →+* κ)
          (j_W : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of C)) U₁.left),
          AlgebraicGeometry.Etale j_W ∧
          g_C.Etale ∧
          τ_C.comp g_C = τ₀.toRingHom ∧
          CategoryTheory.CategoryStruct.comp j_W U₁.hom =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_C)) j_chart ∧
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_κΩ.toRingHom))
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_C))
              (CategoryTheory.CategoryStruct.comp j_W v₁.left)) = u := by
    intro S B₀ _ _ j_chart _ τ₀ pt x₀ Ω gx₀ U U₁ v₁ u z₁ hu hv₁_et hz₁
    let s₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of κ)) S :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom)) j_chart
    have hpt_eq : IsLocalRing.closedPoint κ = pt := Subsingleton.elim _ _
    have hx₀_eq : s₀.base (IsLocalRing.closedPoint κ) = x₀ := by
      change s₀.base (IsLocalRing.closedPoint κ) = s₀.base pt
      rw [hpt_eq]
    let δ₀ : Quiver.Hom (S.residueField x₀) (CommRingCat.of κ) :=
      CategoryTheory.CategoryStruct.comp
        (S.residueFieldCongr hx₀_eq.symm).hom
        (AlgebraicGeometry.Scheme.descResidueField
          (AlgebraicGeometry.Scheme.stalkClosedPointTo s₀))
    have hδ₀_fac : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map δ₀) (S.fromSpecResidueField x₀) = s₀ := by
      dsimp [δ₀]
      rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.residueFieldCongr_fromSpecResidueField,
        AlgebraicGeometry.Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField]
    have hFrom_range :
        Set.range (S.fromSpecResidueField x₀).base ⊆ Set.range j_chart.base := by
      rintro _ ⟨q, rfl⟩
      rw [AlgebraicGeometry.Scheme.fromSpecResidueField_apply]
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom)).base pt, rfl⟩
    let r_aff : Quiver.Hom (AlgebraicGeometry.Spec (S.residueField x₀))
        (AlgebraicGeometry.Spec (CommRingCat.of B₀)) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_chart (S.fromSpecResidueField x₀) hFrom_range
    have hr_aff_fac : CategoryTheory.CategoryStruct.comp r_aff j_chart =
        S.fromSpecResidueField x₀ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_chart (S.fromSpecResidueField x₀) hFrom_range
    have hSpec_eq : CategoryTheory.CategoryStruct.comp (AlgebraicGeometry.Spec.map δ₀) r_aff =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) := by
      apply (cancel_mono j_chart).mp
      rw [CategoryTheory.Category.assoc, hr_aff_fac, hδ₀_fac]
    have hRing_eq : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.preimage r_aff) δ₀ = CommRingCat.ofHom τ₀.toRingHom := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, hSpec_eq]
    have hδ₀_surj : Function.Surjective δ₀.hom := by
      intro c
      refine ⟨(AlgebraicGeometry.Spec.preimage r_aff).hom (algebraMap κ B₀ c), ?_⟩
      have hc := congrArg (fun k => k.hom (algebraMap κ B₀ c)) hRing_eq
      simpa using hc.trans (τ₀.commutes c)
    let e_res : ↥(S.residueField x₀) ≃+* κ :=
      RingEquiv.ofBijective δ₀.hom ⟨δ₀.hom.injective, hδ₀_surj⟩
    let ψ_κΩ : κ →+* Ω := (algebraMap ↥(S.residueField x₀) Ω).comp e_res.symm.toRingHom
    let _ : Algebra κ Ω := ψ_κΩ.toAlgebra
    have _ : Algebra.IsIntegral ↥(S.residueField x₀) Ω := Algebra.IsAlgebraic.isIntegral
    have _ : Algebra.IsIntegral κ Ω := ⟨fun ω => by
      have hω_int : IsIntegral ↥(S.residueField x₀) ω := Algebra.IsIntegral.isIntegral ω
      let p := minpoly ↥(S.residueField x₀) ω
      refine ⟨p.map e_res.toRingHom, (minpoly.monic hω_int).map e_res.toRingHom, ?_⟩
      rw [Polynomial.eval₂_map]
      have hcomp : ψ_κΩ.comp e_res.toRingHom = algebraMap ↥(S.residueField x₀) Ω := by
        ext y
        change algebraMap ↥(S.residueField x₀) Ω (e_res.symm (e_res y)) = _
        rw [e_res.symm_apply_apply]
      change Polynomial.eval₂ (ψ_κΩ.comp e_res.toRingHom) ω p = 0
      rw [hcomp]
      exact minpoly.aeval ↥(S.residueField x₀) ω⟩
    have hBij_κΩ : Function.Bijective ψ_κΩ :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ) (K := Ω)
    let e_κΩ : κ ≃+* Ω := RingEquiv.ofBijective ψ_κΩ hBij_κΩ
    have hδ₀_e : CategoryTheory.CategoryStruct.comp δ₀ (CommRingCat.ofHom e_κΩ.toRingHom) =
        CommRingCat.ofHom (algebraMap ↥(S.residueField x₀) Ω) := by
      apply CommRingCat.hom_ext
      ext y
      change ψ_κΩ (e_res y) = algebraMap ↥(S.residueField x₀) Ω y
      change algebraMap ↥(S.residueField x₀) Ω (e_res.symm (e_res y)) = _
      rw [e_res.symm_apply_apply]
    have hgx₀_eq : gx₀ = CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_κΩ.toRingHom)) s₀ := by
      dsimp [gx₀]
      rw [← hδ₀_e, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hδ₀_fac]
      rfl
    let g_aff : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
        (AlgebraicGeometry.Spec (CommRingCat.of B₀)) :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_κΩ.toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom))
    have hg_aff_chart : CategoryTheory.CategoryStruct.comp g_aff j_chart = gx₀ := by
      dsimp [g_aff, s₀] at *
      rw [CategoryTheory.Category.assoc, hgx₀_eq]

    let v₁_sch : Quiver.Hom U₁.left U.left := v₁.left
    let P_Ω := CategoryTheory.Limits.pullback u v₁_sch
    let pr₁ : Quiver.Hom P_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      CategoryTheory.Limits.pullback.fst u v₁_sch
    let pr₂ : Quiver.Hom P_Ω U₁.left := CategoryTheory.Limits.pullback.snd u v₁_sch
    have _ : AlgebraicGeometry.Etale pr₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback u v₁_sch).flip hv₁_et
    obtain ⟨p_Ω, _, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := u) (g := v₁_sch) (IsLocalRing.closedPoint Ω) z₁ hz₁.symm
    obtain ⟨R_Ω, j_Ω, hj_Ω_open, ⟨q₀_Ω, _⟩, _⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : P_Ω.Opens)) (x := p_Ω) trivial
    let _ : AlgebraicGeometry.IsOpenImmersion j_Ω := hj_Ω_open
    have _ : Nontrivial ↑R_Ω :=
      PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨q₀_Ω⟩
    let g_Ω_sch : Quiver.Hom (AlgebraicGeometry.Spec R_Ω)
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      CategoryTheory.CategoryStruct.comp j_Ω pr₁
    have hg_Ω_et : AlgebraicGeometry.Etale g_Ω_sch := inferInstance
    let ψ_Ω_mor : Quiver.Hom (CommRingCat.of Ω) R_Ω :=
      AlgebraicGeometry.Spec.preimage g_Ω_sch
    have hψ_Ω_map : AlgebraicGeometry.Spec.map ψ_Ω_mor = g_Ω_sch :=
      AlgebraicGeometry.Spec.map_preimage g_Ω_sch
    let ψ_Ω : Ω →+* ↑R_Ω := ψ_Ω_mor.hom
    have hψ_Ω_et : ψ_Ω.Etale := by
      have hSpecEt : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω)) := by
        change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map ψ_Ω_mor)
        rwa [hψ_Ω_map]
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hSpecEt
    let _ : Algebra Ω ↑R_Ω := ψ_Ω.toAlgebra
    have _ : Algebra.Etale Ω ↑R_Ω := RingHom.etale_algebraMap.mp hψ_Ω_et
    have _ : Algebra.FiniteType Ω ↑R_Ω :=
      RingHom.finiteType_algebraMap.mp
        (RingHom.FiniteType.of_finitePresentation
          (RingHom.finitePresentation_algebraMap.mpr
            (Algebra.Etale.finitePresentation (R := Ω) (A := ↑R_Ω))))
    obtain ⟨𝔪_Ω, h𝔪_Ω, _⟩ := Ideal.exists_le_maximal (⊥ : Ideal ↑R_Ω) bot_ne_top
    let F_Ω : Type u := ↑R_Ω ⧸ 𝔪_Ω
    let _ : Field F_Ω := @Ideal.Quotient.field ↑R_Ω _ 𝔪_Ω h𝔪_Ω
    have _ : Algebra.FiniteType Ω F_Ω :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω 𝔪_Ω) Ideal.Quotient.mk_surjective
    let e_ΩF : Ω ≃+* F_Ω := RingEquiv.ofBijective (algebraMap Ω F_Ω) (hNull Ω F_Ω)
    let σ_Ω : ↑R_Ω →+* Ω := e_ΩF.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪_Ω)
    have hσ_Ω_id : CategoryTheory.CategoryStruct.comp ψ_Ω_mor (CommRingCat.ofHom σ_Ω) =
        CategoryTheory.CategoryStruct.id (CommRingCat.of Ω) := by
      apply CommRingCat.hom_ext
      ext ω
      change e_ΩF.symm (algebraMap Ω F_Ω ω) = ω
      exact e_ΩF.symm_apply_apply ω
    have hsec_Ω : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_Ω)) g_Ω_sch =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
      rw [← hψ_Ω_map, ← AlgebraicGeometry.Spec.map_comp, hσ_Ω_id,
        AlgebraicGeometry.Spec.map_id]
    let s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) P_Ω :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_Ω)) j_Ω
    have hs_Ω_pr₁ : CategoryTheory.CategoryStruct.comp s_Ω pr₁ =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      (CategoryTheory.Category.assoc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_Ω)) j_Ω pr₁).trans hsec_Ω
    let u₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) U₁.left :=
      CategoryTheory.CategoryStruct.comp s_Ω pr₂
    have hu₁_v₁ : CategoryTheory.CategoryStruct.comp u₁ v₁.left = u :=
      calc CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp s_Ω pr₂) v₁_sch
          = CategoryTheory.CategoryStruct.comp s_Ω
              (CategoryTheory.CategoryStruct.comp pr₂ v₁_sch) :=
            CategoryTheory.Category.assoc s_Ω pr₂ v₁_sch
        _ = CategoryTheory.CategoryStruct.comp s_Ω
              (CategoryTheory.CategoryStruct.comp pr₁ u) :=
            congrArg (CategoryTheory.CategoryStruct.comp s_Ω)
              (CategoryTheory.Limits.pullback.condition (f := u) (g := v₁_sch)).symm
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp s_Ω pr₁) u :=
            (CategoryTheory.Category.assoc s_Ω pr₁ u).symm
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.id _) u :=
            congrArg (fun k => CategoryTheory.CategoryStruct.comp k u) hs_Ω_pr₁
        _ = u := CategoryTheory.Category.id_comp u
    have hu₁_hom : CategoryTheory.CategoryStruct.comp u₁ U₁.hom = gx₀ := by
      rw [← CategoryTheory.MorphismProperty.Over.w v₁, ← CategoryTheory.Category.assoc,
        hu₁_v₁, hu]

    let q_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := IsLocalRing.closedPoint Ω
    let O₁ : U₁.left.Opens :=
      (TopologicalSpace.Opens.map U₁.hom.base).obj j_chart.opensRange
    have hq_in_O₁ : u₁.base q_Ω ∈ O₁ := by
      change U₁.hom.base (u₁.base q_Ω) ∈ Set.range j_chart.base
      have hbase : U₁.hom.base (u₁.base q_Ω) = gx₀.base q_Ω := by
        change (u₁ ≫ U₁.hom).base q_Ω = gx₀.base q_Ω
        rw [hu₁_hom]
      rw [hbase]
      dsimp [gx₀]
      change (S.fromSpecResidueField x₀).base _ ∈ Set.range j_chart.base
      rw [AlgebraicGeometry.Scheme.fromSpecResidueField_apply]
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom)).base pt, rfl⟩
    obtain ⟨R_C, j_W, hj_W_open, hq_in_jW, hRange_jW⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := O₁) (x := u₁.base q_Ω) hq_in_O₁
    let _ : AlgebraicGeometry.IsOpenImmersion j_W := hj_W_open
    let C : Type u := ↑R_C
    have hj_W_et : AlgebraicGeometry.Etale j_W := inferInstance
    have hjW_hom_range :
        Set.range (CategoryTheory.CategoryStruct.comp j_W U₁.hom).base ⊆
          Set.range j_chart.base := by
      rintro _ ⟨w, rfl⟩
      exact hRange_jW ⟨w, rfl⟩
    let g_C_sch : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of C))
        (AlgebraicGeometry.Spec (CommRingCat.of B₀)) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_chart
        (CategoryTheory.CategoryStruct.comp j_W U₁.hom) hjW_hom_range
    have hg_C_fac : CategoryTheory.CategoryStruct.comp g_C_sch j_chart =
        CategoryTheory.CategoryStruct.comp j_W U₁.hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_chart
        (CategoryTheory.CategoryStruct.comp j_W U₁.hom) hjW_hom_range
    have _ : AlgebraicGeometry.Etale U₁.hom := U₁.prop
    have hjW_U₁_et : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp j_W U₁.hom) :=
      inferInstance
    have _ : AlgebraicGeometry.Etale g_C_sch :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale) g_C_sch j_chart inferInstance
        (hg_C_fac.symm ▸ hjW_U₁_et)
    let g_C_mor : Quiver.Hom (CommRingCat.of B₀) (CommRingCat.of C) :=
      AlgebraicGeometry.Spec.preimage g_C_sch
    have hg_C_map : AlgebraicGeometry.Spec.map g_C_mor = g_C_sch :=
      AlgebraicGeometry.Spec.map_preimage g_C_sch
    let g_C : B₀ →+* C := g_C_mor.hom
    have hg_C_et : g_C.Etale := by
      have hSpecEt : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_C)) := by
        change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map g_C_mor)
        rwa [hg_C_map]
      exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hSpecEt
    have hj_W_hom : CategoryTheory.CategoryStruct.comp j_W U₁.hom =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_C)) j_chart := by
      change j_W ≫ U₁.hom = AlgebraicGeometry.Spec.map g_C_mor ≫ j_chart
      rw [hg_C_map, hg_C_fac]
    have hu₁_range : Set.range u₁.base ⊆ Set.range j_W.base := by
      rintro _ ⟨q, rfl⟩
      have hq_eq : q = q_Ω := Subsingleton.elim q q_Ω
      rw [hq_eq]
      exact hq_in_jW
    let u_C : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
        (AlgebraicGeometry.Spec (CommRingCat.of C)) :=
      AlgebraicGeometry.IsOpenImmersion.lift j_W u₁ hu₁_range
    have hu_C_fac : CategoryTheory.CategoryStruct.comp u_C j_W = u₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_W u₁ hu₁_range
    let φ_C_mor : Quiver.Hom (CommRingCat.of C) (CommRingCat.of Ω) :=
      AlgebraicGeometry.Spec.preimage u_C
    have hφ_C_map : AlgebraicGeometry.Spec.map φ_C_mor = u_C :=
      AlgebraicGeometry.Spec.map_preimage u_C
    let φ_C : C →+* Ω := φ_C_mor.hom
    let τ_C : C →+* κ := e_κΩ.symm.toRingHom.comp φ_C
    have hu_C_g : CategoryTheory.CategoryStruct.comp u_C g_C_sch = g_aff := by
      apply (cancel_mono j_chart).mp
      rw [CategoryTheory.Category.assoc, hg_C_fac, ← CategoryTheory.Category.assoc,
        hu_C_fac, hu₁_hom, hg_aff_chart]
    have hφ_g_eq : φ_C.comp g_C = e_κΩ.toRingHom.comp τ₀.toRingHom := by
      have hmor : CategoryTheory.CategoryStruct.comp g_C_mor φ_C_mor =
          CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom τ₀.toRingHom) (CommRingCat.ofHom e_κΩ.toRingHom) := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
          hφ_C_map, hg_C_map, hu_C_g]
      exact congrArg CommRingCat.Hom.hom hmor
    have hτ_C_comp : τ_C.comp g_C = τ₀.toRingHom := by
      ext b
      change e_κΩ.symm (φ_C (g_C b)) = τ₀ b
      have hb := congrArg (fun fn => fn b) hφ_g_eq
      dsimp at hb
      rw [hb]
      exact e_κΩ.symm_apply_apply (τ₀ b)
    have hu_C_split : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_κΩ.toRingHom))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_C)) = u_C := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← hφ_C_map]
      congr 1
      apply CommRingCat.hom_ext
      ext c
      exact e_κΩ.apply_symm_apply (φ_C c)
    have hu_fac : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_κΩ.toRingHom))
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_C))
          (CategoryTheory.CategoryStruct.comp j_W v₁.left)) = u := by
      rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_κΩ.toRingHom)),
        hu_C_split, ← CategoryTheory.Category.assoc, hu_C_fac, hu₁_v₁]
    exact ⟨e_κΩ, C, inferInstance, g_C, τ_C, j_W, hj_W_et, hg_C_et, hτ_C_comp, hj_W_hom, hu_fac⟩

  refine ⟨fun A _ _ τ_A hA q hq 𝒢 =>
