    apply (adj_S.homEquiv Q₁ G₂).injective
    rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
      CategoryTheory.Adjunction.homEquiv_naturality_right]
    exact h
  refine ⟨?_, ?_, ?_⟩
  · intro F q
    let P_X : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B_f.op (CategoryTheory.Sheaf.cohomologyPresheaf F q)
    let R_tgt := pf_g.obj (weilEtaleHigherDirectImage f' q (pb_g'.obj F))
    let P_X' : CategoryTheory.Functor (Opposite S'.Etale) AddCommGrpCat.{u} :=
