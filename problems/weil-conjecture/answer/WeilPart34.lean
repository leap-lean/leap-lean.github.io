            (Algebra.TensorProduct.map μ₀ (AlgHom.id R (S l₂))).comp
              (Algebra.TensorProduct.assoc R R R (S l₀) (S l₀) (S l₂)).symm.toAlgHom
          have hC_inl : ∀ v : TensorProduct R (S l₀) (S l₀),
