        | add x₁ x₂ _ _ ih₁ ih₂ =>
          rw [map_add]
          exact add_mem ih₁ ih₂
        | mul x₁ x₂ _ _ ih₁ ih₂ =>
          rw [map_mul]
          exact mul_mem ih₁ ih₂
      obtain ⟨n₀, g₀, hg₀_inj, hg₀_fin⟩ := exists_finite_inj_algHom_of_fg κ F
      letI : Algebra (MvPolynomial (Fin n₀) κ) F := g₀.toRingHom.toAlgebra
      have : Algebra.IsIntegral (MvPolynomial (Fin n₀) κ) F := ⟨hg₀_fin.to_isIntegral⟩
      have hIsField_Mv : IsField (MvPolynomial (Fin n₀) κ) :=
        (Algebra.IsIntegral.isField_iff_isField (R := MvPolynomial (Fin n₀) κ) (S := F) hg₀_inj).mpr
          (Field.toIsField F)
      have : IsEmpty (Fin n₀) := by
        refine ⟨fun i => ?_⟩
        obtain ⟨p, hp⟩ := hIsField_Mv.mul_inv_cancel (MvPolynomial.X_ne_zero (R := κ) i)
        have hcc := congrArg MvPolynomial.constantCoeff hp
        rw [map_mul, MvPolynomial.constantCoeff_X, zero_mul, map_one] at hcc
        exact zero_ne_one hcc
      have : Algebra.IsIntegral κ (MvPolynomial (Fin n₀) κ) := by
        refine ⟨fun P => ?_⟩
        have hP_eq : P = algebraMap κ (MvPolynomial (Fin n₀) κ) (MvPolynomial.constantCoeff P) := by
          induction P using MvPolynomial.induction_on with
          | C c =>
            change MvPolynomial.C c = MvPolynomial.C (MvPolynomial.constantCoeff (MvPolynomial.C c))
            rw [MvPolynomial.constantCoeff_C]
          | add p₁ p₂ ih₁ ih₂ =>
            rw [map_add, map_add, ← ih₁, ← ih₂]
          | mul_X p₁ i =>
            exact IsEmpty.elim inferInstance i
        rw [hP_eq]
        exact isIntegral_algebraMap
      letI : IsScalarTower κ (MvPolynomial (Fin n₀) κ) F :=
        IsScalarTower.of_algebraMap_eq (fun c => (g₀.commutes c).symm)
      have : Algebra.IsIntegral κ F :=
        Algebra.IsIntegral.trans (R := κ) (A := MvPolynomial (Fin n₀) κ) (B := F)
      have hBij_κF : Function.Bijective (algebraMap κ F) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral (k := κ) (K := F)
      let e_κF := RingEquiv.ofBijective (algebraMap κ F) hBij_κF
      let τ_C : C →+* κ := e_κF.symm.toRingHom.comp (Ideal.Quotient.mk 𝔪)
      have hτ_CA : ∀ a : A, τ_C (algebraMap A C a) = τ_A a := by
        intro a
        apply e_κF.injective
        change e_κF (e_κF.symm (Ideal.Quotient.mk 𝔪 (φ_AC a))) = e_κF (τ_A a)
        rw [e_κF.apply_symm_apply, hmk_φ a]
        rfl
      obtain ⟨σ_C, _⟩ := hA.2.2.2.2 C τ_C hτ_CA
      let i_tilde : S_A ⟶ V_sch :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_C.toRingHom) ≫ hW.fromSpec ≫ p_V
      have hi_tilde_vhom : i_tilde ≫ v_hom = i_inf := by
        dsimp [i_tilde]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc hW.fromSpec]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_C.toRingHom) ≫
            (g_et ≫ i_inf) = i_inf
        rw [← hSpec_φ, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hid : φ_cat ≫ CommRingCat.ofHom σ_C.toRingHom =
            CategoryTheory.CategoryStruct.id (CommRingCat.of A) := by
          apply CommRingCat.hom_ext
          ext a
          exact σ_C.commutes a
        rw [hid, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
      let U₀ : S.Etale :=
        AlgebraicGeometry.Scheme.Etale.mk j₀
      let u₀ : U₀ ⟶ T_S :=
        CategoryTheory.MorphismProperty.Over.homMk j₀
          (CategoryTheory.Category.comp_id j₀) trivial
      have hs_u₀ : ℋ.obj.map (Opposite.op u₀) s = 0 :=
        @Subsingleton.elim _ (hZeroOnOpen U₀ Set.Subset.rfl) _ 0
      let R_zero : CategoryTheory.Sieve T_S :=
        CategoryTheory.Sieve.mk (fun _ f => ℋ.obj.map (Opposite.op f) s = 0)
          (fun {W₁ W₂ f} hf g =>
            (congrArg (fun φ => φ.hom s)
              (ℋ.obj.map_comp (Opposite.op f) (Opposite.op g))).trans
              ((congrArg (ℋ.obj.map (Opposite.op g)).hom hf).trans (map_zero _)))
      have hR_mem : R_zero ∈ S.smallEtaleTopology T_S := by
        let T_S' : P_et.Over ⊤ S := T_S
        let R_zero' : CategoryTheory.Sieve T_S' := R_zero
        have hMemPre : R_zero' ∈
            (AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et S) T_S' := by
          rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology,
            AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology]
          · intro x
            have hx_univ : (x : ↥S) ∈ Set.range j₀.base ∪ Set.range i_inf.base := by
              rw [hCov]
              trivial
            rcases hx_univ with ⟨y, hy⟩ | ⟨p, hp⟩
            · refine ⟨U₀, u₀, y, hs_u₀, ?_, hy⟩
              change AlgebraicGeometry.Etale j₀
              infer_instance
            · refine ⟨V, v, i_tilde.base p, hs_v, ?_, ?_⟩
              · change AlgebraicGeometry.Etale ((Fgt.map v).left : V_sch ⟶ S)
                rw [hv_left]
                exact hEt_vhom
              · have hbase : ((Fgt.map v).left : V_sch ⟶ S).base (i_tilde.base p) =
                    (i_tilde ≫ v_hom).base p := by
                  rw [hv_left]
                  rfl
                exact hbase.trans ((congrArg (fun φ => φ.base p) hi_tilde_vhom).trans hp)
          · exact le_rfl
        exact hMemPre
      have hSepAll := CategoryTheory.Presheaf.IsSheaf.isSeparated ℋ.property
      apply hSepAll T_S R_zero hR_mem s 0
      intro W' f hf
      change ℋ.obj.map (Opposite.op f) s = ℋ.obj.map (Opposite.op f) 0
      rw [hf, map_zero]
    have hSubSec : Subsingleton ↥(ℋ.obj.obj (Opposite.op T_S)) :=
      subsingleton_of_forall_eq 0 hSecZero
    let adj_const := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    refine ⟨fun z₁ z₂ => ?_⟩
    apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
    apply (adj_const.homEquiv Aℤ ℋ).injective
    ext x
    exact @Subsingleton.elim _ hSubSec _ _

  
  have hLerayCollapse : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
      (b₀ : ℕ), 1 ≤ b₀ →
      ∀ (ℱ : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
        (∀ [_hCont : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology],
          Subsingleton ((((weilAltCdSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
            S₂.smallEtaleTopology S₁.smallEtaleTopology).obj ℱ).H b₀)) →
        (∀ (r q : ℕ), 1 ≤ r → 1 ≤ q →
          Subsingleton ((weilAltCdHigherDirectImage h r ℱ).H q)) →
        Subsingleton ((weilAltCdHigherDirectImage h b₀ ℱ).H 0) →
        Subsingleton (ℱ.H b₀) := by
    intro S₁ S₂ h b₀ hb₀ ℱ hPushVanish hHigherVanish hTopH0
    obtain ⟨hCont, _, _, _, _, _, _, hInjPush, e₀, he₀_nat⟩ := hAdjH0 h
    have : (weilAltCdSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology := hCont
    let P_push := (weilAltCdSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    let Fℤ₁ := (CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let Fℤ₂ := (CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hSubIso : ∀ {G₁ G₂ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u}}
        (isoG : G₁ ≅ G₂) (q : ℕ),
        Subsingleton (G₂.H q) → Subsingleton (G₁.H q) := by
      intro G₁ G₂ isoG q hSub₂
      refine subsingleton_of_forall_eq 0 (fun w => ?_)
      have hw₂ : w.comp (CategoryTheory.Abelian.Ext.mk₀ isoG.hom) (Nat.add_zero q) = 0 :=
        @Subsingleton.elim _ hSub₂ _ 0
      have hid := CategoryTheory.Abelian.Ext.comp_mk₀_id w
      rw [← isoG.hom_inv_id, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ isoG.hom isoG.inv,
        ← CategoryTheory.Abelian.Ext.comp_assoc w (CategoryTheory.Abelian.Ext.mk₀ isoG.hom)
          (CategoryTheory.Abelian.Ext.mk₀ isoG.inv) (Nat.add_zero q) (Nat.add_zero 0)
          (Nat.add_zero q),
        hw₂, CategoryTheory.Abelian.Ext.zero_comp] at hid
      exact hid.symm
    have hPush_b : Subsingleton ((P_push.obj ℱ).H b₀) := @hPushVanish hCont
    clear hPushVanish
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, b₀ = n + 1 := ⟨b₀ - 1, by omega⟩
    clear hb₀
    have hMain : ∀ (k : ℕ)
        (ℱ₀ : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton ((P_push.obj ℱ₀).H (k + 1)) →
        (∀ (r q : ℕ), 1 ≤ r → 1 ≤ q → Subsingleton ((weilAltCdHigherDirectImage h r ℱ₀).H q)) →
        Subsingleton ((weilAltCdHigherDirectImage h (k + 1) ℱ₀).H 0) →
        Subsingleton (ℱ₀.H (k + 1)) := by
      intro k
      induction k with
      | zero =>
        intro ℱ₀ hPush_1 hHigher₀ hTop₀
        let j_I : ℱ₀ ⟶ CategoryTheory.Injective.under ℱ₀ := CategoryTheory.Injective.ι ℱ₀
        let I := CategoryTheory.Injective.under ℱ₀
        let Q := CategoryTheory.Limits.cokernel j_I
        let p_I : I ⟶ Q := CategoryTheory.Limits.cokernel.π j_I
        have hjp_I : j_I ≫ p_I = 0 := CategoryTheory.Limits.cokernel.condition j_I
        have hSE : (CategoryTheory.ShortComplex.mk j_I p_I hjp_I).ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
              (CategoryTheory.Limits.cokernelIsCokernel j_I))
            inferInstance inferInstance
        obtain ⟨_, ℬ, π_B, ι_B, δ_B, h₁, h₂, hfac, hSE₁, hSE₂⟩ :=
          hInjStep h ℱ₀ I Q j_I p_I hjp_I hSE
        refine subsingleton_of_forall_eq 0 (fun z => ?_)
        have hz_I : z.comp (CategoryTheory.Abelian.Ext.mk₀ j_I) (Nat.add_zero 1) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y₀, hy₀⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ₁ hSE z hz_I (Nat.zero_add 1)
        let w₀ : (P_push.obj Q).H 0 := (e₀ Q).symm y₀
        have hw₀_δ : w₀.comp (CategoryTheory.Abelian.Ext.mk₀ δ_B) (Nat.add_zero 0) = 0 :=
          @Subsingleton.elim _ hTop₀ _ 0
        obtain ⟨b_el, hb_el⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ₂ hSE₂ w₀ hw₀_δ
        have hb_ext : b_el.comp hSE₁.extClass (Nat.zero_add 1) = 0 :=
          @Subsingleton.elim _ hPush_1 _ 0
        obtain ⟨x₀, hx₀⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ₂ hSE₁ b_el (Nat.zero_add 1) hb_ext
        have hx₀_p : x₀.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map p_I)) (Nat.add_zero 0) = w₀ := by
          rw [← hfac, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ π_B ι_B,
            ← CategoryTheory.Abelian.Ext.comp_assoc x₀
              (CategoryTheory.Abelian.Ext.mk₀ π_B) (CategoryTheory.Abelian.Ext.mk₀ ι_B)
              (Nat.add_zero 0) (Nat.add_zero 0) (Nat.add_zero 0),
            hx₀, hb_el]
        have hy₀_eq : y₀ = (e₀ I x₀).comp (CategoryTheory.Abelian.Ext.mk₀ p_I) (Nat.add_zero 0) := by
          have h1 := he₀_nat p_I x₀
          rw [hx₀_p, AddEquiv.apply_symm_apply] at h1
          exact h1
        rw [← hy₀, hy₀_eq,
          CategoryTheory.Abelian.Ext.comp_assoc (e₀ I x₀)
            (CategoryTheory.Abelian.Ext.mk₀ p_I) hSE.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
          hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      | succ m ih =>
        intro ℱ₀ hPush_m2 hHigher₀ hTop₀
        let j_I : ℱ₀ ⟶ CategoryTheory.Injective.under ℱ₀ := CategoryTheory.Injective.ι ℱ₀
        let I := CategoryTheory.Injective.under ℱ₀
        let Q := CategoryTheory.Limits.cokernel j_I
        let p_I : I ⟶ Q := CategoryTheory.Limits.cokernel.π j_I
        have hjp_I : j_I ≫ p_I = 0 := CategoryTheory.Limits.cokernel.condition j_I
        have hSE : (CategoryTheory.ShortComplex.mk j_I p_I hjp_I).ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_of_g_is_cokernel _
              (CategoryTheory.Limits.cokernelIsCokernel j_I))
            inferInstance inferInstance
        obtain ⟨hIso, ℬ, π_B, ι_B, δ_B, h₁, h₂, _, hSE₁, hSE₂⟩ :=
          hInjStep h ℱ₀ I Q j_I p_I hjp_I hSE
        have : CategoryTheory.Injective (P_push.obj I) := hInjPush I inferInstance
        have hSub_ℬ : Subsingleton (ℬ.H (m + 1)) := by
          refine subsingleton_of_forall_eq 0 (fun u => ?_)
          have hu0 : u.comp hSE₁.extClass (rfl : (m + 1) + 1 = (m + 1) + 1) = 0 :=
            @Subsingleton.elim _ hPush_m2 _ 0
          obtain ⟨v, hv⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ₂ hSE₁ u
              (rfl : (m + 1) + 1 = (m + 1) + 1) hu0
          have hv0 : v = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective v
          rw [← hv, hv0, CategoryTheory.Abelian.Ext.zero_comp]
        have hSub_PQ : Subsingleton ((P_push.obj Q).H (m + 1)) := by
          refine subsingleton_of_forall_eq 0 (fun w => ?_)
          have hw_δ : w.comp (CategoryTheory.Abelian.Ext.mk₀ δ_B) (Nat.add_zero (m + 1)) = 0 :=
            @Subsingleton.elim _ (hHigher₀ 1 (m + 1) (le_refl 1) (Nat.succ_pos m)) _ 0
          obtain ⟨u, hu⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ₂ hSE₂ w hw_δ
          have hu0 : u = 0 := @Subsingleton.elim _ hSub_ℬ u 0
          rw [← hu, hu0, CategoryTheory.Abelian.Ext.zero_comp]
        have hHigherQ : ∀ (r q : ℕ), 1 ≤ r → 1 ≤ q →
            Subsingleton ((weilAltCdHigherDirectImage h r Q).H q) := by
          intro r q hr hq
          obtain ⟨iso_r⟩ := hIso r hr
          exact hSubIso iso_r q (hHigher₀ (r + 1) q (by omega) hq)
        have hTopQ : Subsingleton ((weilAltCdHigherDirectImage h (m + 1) Q).H 0) := by
          obtain ⟨iso_m⟩ := hIso (m + 1) (Nat.succ_pos m)
          exact hSubIso iso_m 0 hTop₀
        have hSub_Q : Subsingleton (Q.H (m + 1)) := ih Q hSub_PQ hHigherQ hTopQ
        refine subsingleton_of_forall_eq 0 (fun z => ?_)
        have hz_I : z.comp (CategoryTheory.Abelian.Ext.mk₀ j_I) (Nat.add_zero ((m + 1) + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y, hy⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ₁ hSE z hz_I
            (rfl : (m + 1) + 1 = (m + 1) + 1)
        have hy0 : y = 0 := @Subsingleton.elim _ hSub_Q y 0
        rw [← hy, hy0, CategoryTheory.Abelian.Ext.zero_comp]
    exact hMain n ℱ hPush_b hHigherVanish hTopH0

  
  obtain ⟨j₀, j₁, hj₀, hj₁, i_inf, hi_inf, hSep_XA, hPb_ov, hi_eq, hRange_compl⟩ := hAtlas
  have : AlgebraicGeometry.IsOpenImmersion j₀ := hj₀
  have : AlgebraicGeometry.IsOpenImmersion j₁ := hj₁
  have : AlgebraicGeometry.IsClosedImmersion i_inf := hi_inf
  have : AlgebraicGeometry.Scheme.IsSeparated X_A := hSep_XA
  refine ⟨j₀, j₁, hj₀, hj₁, i_inf, hi_inf, hPb_ov, fun ℱ_A hℓ_ℱ pt hStalk => ?_⟩
  have hb1 : 1 ≤ b := by omega
  refine hLerayCollapse j₀ b hb1 ℱ_A ?_ ?_ ?_
  · intro hCont
    obtain ⟨hCont', _, _, _, hAdd_push, _, _, _, _⟩ := hAdjH0 j₀
    have hEqCont : hCont' = hCont := Subsingleton.elim _ _
    subst hEqCont
    let P_push := (weilAltCdSitePullback j₀).sheafPushforwardContinuous AddCommGrpCat.{u}
      X_A.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))).smallEtaleTopology
    have : P_push.Additive := hAdd_push
    apply hP1Vanish (P_push.obj ℱ_A)
    rw [← P_push.map_id, ← CategoryTheory.Functor.map_nsmul, hℓ_ℱ,
      CategoryTheory.Functor.map_zero]
  · intro r q hr hq
    refine hClosedSupp i_inf ℓ q (fun 𝒢 _ => hSpecAVanish q hq 𝒢)
      (weilAltCdHigherDirectImage j₀ r ℱ_A)
      ((hOpenRPush j₀ ℓ r ℱ_A).1 hℓ_ℱ)
      (fun U hU => ?_)
    rw [← hRange_compl] at hU
    exact (hOpenRPush j₀ ℓ r ℱ_A).2 hr U hU
  · have hCov : Set.range j₀.base ∪ Set.range i_inf.base = Set.univ := by
      rw [hRange_compl]
      exact Set.compl_union_self _
    have hev_comp : Polynomial.eval₂RingHom τ_A.toRingHom 0 =
        τ_A.toRingHom.comp ev0_A := by
      apply Polynomial.ringHom_ext
      · intro a
        simp [ev0_A]
      · simp [ev0_A]
    have hmor_Q : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.eval₂RingHom τ_A.toRingHom 0))) j₁ =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_A.toRingHom)) i_inf := by
      rw [hev_comp, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, hi_eq]
    rw [hmor_Q] at hStalk
    exact hStrictLocalH0 j₀ i_inf hCov pt
      (weilAltCdHigherDirectImage j₀ b ℱ_A)
      ((hOpenRPush j₀ ℓ b ℱ_A).2 hb1) hStalk

theorem weil_aff_cd_strictLocal_dvr_field_and_colimit_helpers : (∀ (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
      (R₀ A : Type u) [CommRing R₀] [CommRing A] (f_A : R₀ →+* A)
      (D : CategoryTheory.Functor ℐ CommRingCat.{u})
      (α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R₀)) D)
      (c : CategoryTheory.Limits.Cocone D) (_ : CategoryTheory.Limits.IsColimit c)
      (e_pt : CategoryTheory.Iso c.pt (CommRingCat.of A)),
      (∀ i : ℐ, CategoryTheory.CategoryStruct.comp (α.app i)
        (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom) = CommRingCat.ofHom f_A) →
      ∃ (D_poly : CategoryTheory.Functor ℐ CommRingCat.{u})
        (α_poly : Quiver.Hom
          ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial R₀))) D_poly)
        (c_poly : CategoryTheory.Limits.Cocone D_poly)
        (_ : CategoryTheory.Limits.IsColimit c_poly)
        (e_lvl : ∀ i : ℐ,
          CategoryTheory.Iso (D_poly.obj i) (CommRingCat.of (Polynomial ↑(D.obj i))))
        (e_colim : CategoryTheory.Iso c_poly.pt (CommRingCat.of (Polynomial A))),
        (∀ i : ℐ,
          CategoryTheory.CategoryStruct.comp (α_poly.app i) (e_lvl i).hom =
            CommRingCat.ofHom (Polynomial.mapRingHom (CommRingCat.Hom.hom (α.app i)))) ∧
        (∀ {i j : ℐ} (θ : Quiver.Hom i j),
          CategoryTheory.CategoryStruct.comp (D_poly.map θ) (e_lvl j).hom =
            CategoryTheory.CategoryStruct.comp (e_lvl i).hom
              (CommRingCat.ofHom (Polynomial.mapRingHom (CommRingCat.Hom.hom (D.map θ))))) ∧
        (∀ i : ℐ,
          CategoryTheory.CategoryStruct.comp (c_poly.ι.app i) e_colim.hom =
            CategoryTheory.CategoryStruct.comp (e_lvl i).hom
              (CommRingCat.ofHom (Polynomial.mapRingHom
                (CommRingCat.Hom.hom (CategoryTheory.CategoryStruct.comp (c.ι.app i) e_pt.hom))))) ∧
        (∀ i : ℐ,
          CategoryTheory.CategoryStruct.comp (α_poly.app i) (c_poly.ι.app i) =
            CategoryTheory.CategoryStruct.comp
              (CommRingCat.ofHom (Polynomial.mapRingHom f_A)) e_colim.inv)) ∧
    (∀ (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
      (B₀ R_inf : Type u) [CommRing B₀] [CommRing R_inf]
