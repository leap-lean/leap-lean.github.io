      let J₁ := Z₁.smallEtaleTopology
      let J₂ := Z₂.smallEtaleTopology
      let G₁ := weilEtaleTorsionSheaf Z₁ ℓ
      let G₂ := weilEtaleTorsionSheaf Z₂ ℓ
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hTZ₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hTZ₂
      let τ_f := hTZ₁.from (B_f.obj TZ₂)
      let α_f : G₂ ⟶ pf_f.obj G₁ :=
        (adj₂.homEquiv AM (pf_f.obj G₁)).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (G₁.obj.map τ_f.op))
      let const₁ := (CategoryTheory.Functor.const (Z₁.Etale)ᵒᵖ).obj AM
      let const₂ := (CategoryTheory.Functor.const (Z₂.Etale)ᵒᵖ).obj AM
      let η₁ := CategoryTheory.toSheafify J₁ const₁
      let η₂ := CategoryTheory.toSheafify J₂ const₂
      η₂ ≫ α_f.hom = CategoryTheory.Functor.whiskerLeft B_f.op η₁ := by
    intro Z₁ Z₂ f _hc_f TZ₁ hTZ₁ TZ₂ hTZ₂ B_f J₁ J₂ G₁ G₂ pf_f adj₁ adj₂ τ_f α_f
      const₁ const₂ η₁ η₂
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let α_tilde : G₂ ⟶ pf_f.obj G₁ :=
      (adj_sh₂.homEquiv const₂ (pf_f.obj G₁)).symm (CategoryTheory.Functor.whiskerLeft B_f.op η₁)
    have hη_tilde : η₂ ≫ α_tilde.hom = CategoryTheory.Functor.whiskerLeft B_f.op η₁ :=
      (adj_sh₂.homEquiv const₂ (pf_f.obj G₁)).apply_symm_apply
        (CategoryTheory.Functor.whiskerLeft B_f.op η₁)
    have hα_eq : α_f = α_tilde := by
      apply (adj₂.homEquiv AM (pf_f.obj G₁)).injective
      have hlhs : (adj₂.homEquiv AM (pf_f.obj G₁)) α_f =
          η₁.app (Opposite.op TZ₁) ≫ G₁.obj.map τ_f.op :=
        (adj₂.homEquiv AM (pf_f.obj G₁)).apply_symm_apply _
      have hrhs : (adj₂.homEquiv AM (pf_f.obj G₁)) α_tilde =
          η₁.app (Opposite.op (B_f.obj TZ₂)) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj₂ AM (pf_f.obj G₁) α_tilde).trans
          (congrArg (fun ν : const₂ ⟶ (pf_f.obj G₁).obj => ν.app (Opposite.op TZ₂)) hη_tilde)
      have hnat : η₁.app (Opposite.op TZ₁) ≫ G₁.obj.map τ_f.op =
          η₁.app (Opposite.op (B_f.obj TZ₂)) :=
        (η₁.naturality τ_f.op).symm.trans (CategoryTheory.Category.id_comp _)
      exact hlhs.trans (hnat.trans hrhs.symm)
    exact (congrArg (fun β : G₂ ⟶ pf_f.obj G₁ => η₂ ≫ β.hom) hα_eq).trans hη_tilde

  
  
  
  let sliceEtale : ∀ {Z' Z : AlgebraicGeometry.Scheme.{u}} (_w : Z' ⟶ Z),
      AlgebraicGeometry.Etale _w → CategoryTheory.Functor Z'.Etale Z.Etale :=
    fun {_ _} _ hw => CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hw

  have hSliceCont : ∀ {Z' Z : AlgebraicGeometry.Scheme.{u}} (w : Z' ⟶ Z)
      (hw : AlgebraicGeometry.Etale w),
      (sliceEtale w hw).IsContinuous Z'.smallEtaleTopology Z.smallEtaleTopology := by
    intro Z' Z w hw
    let M_w := sliceEtale w hw
    have hCompat : CategoryTheory.CompatiblePreserving Z.smallEtaleTopology M_w := by
      refine ⟨fun ℱ {V₀} {T_pr} {x} hx {Y₁ Y₂ W_ov} f₁ f₂ {g₁ g₂} hg₁ hg₂ hcomm => ?_⟩
      have hleft : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hcomm
      have hEt_comp : (f₁.left ≫ Y₁.hom) ≫ w = W_ov.hom :=
        (CategoryTheory.Category.assoc f₁.left Y₁.hom w).trans
          (CategoryTheory.MorphismProperty.Over.w f₁)
      have hEt' : AlgebraicGeometry.Etale (f₁.left ≫ Y₁.hom) :=
        CategoryTheory.MorphismProperty.of_postcomp P_et
          (f₁.left ≫ Y₁.hom) w hw (hEt_comp.symm ▸ W_ov.prop)
      let W' : Z'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) hEt'
      have hf₂_w : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom :=
        (congrArg (f₂.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
          ((CategoryTheory.Category.assoc f₂.left g₂.left V₀.hom).symm.trans
            ((congrArg (· ≫ V₀.hom) hleft.symm).trans
              ((CategoryTheory.Category.assoc f₁.left g₁.left V₀.hom).trans
                (congrArg (f₁.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁)))))
      let f₁_lift : W' ⟶ Y₁ :=
        CategoryTheory.MorphismProperty.Over.homMk (f₁.left : W'.left ⟶ Y₁.left) rfl
      let f₂_lift : W' ⟶ Y₂ :=
        CategoryTheory.MorphismProperty.Over.homMk (f₂.left : W'.left ⟶ Y₂.left) hf₂_w
      have hcomm' : f₁_lift ≫ g₁ = f₂_lift ≫ g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hleft (Subsingleton.elim _ _)
      have hx_eq := hx f₁_lift f₂_lift hg₁ hg₂ hcomm'
      let ε_W : W_ov ⟶ M_w.obj W' :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 W_ov.left : W_ov.left ⟶ (M_w.obj W').left)
          ((CategoryTheory.Category.id_comp ((f₁.left ≫ Y₁.hom) ≫ w)).trans hEt_comp)
      have hε₁ : ε_W ≫ M_w.map f₁_lift = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₁.left) (Subsingleton.elim _ _)
      have hε₂ : ε_W ≫ M_w.map f₂_lift = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₂.left) (Subsingleton.elim _ _)
      have hmap := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map ε_W.op)) hx_eq
      change (CategoryTheory.ConcreteCategory.hom
          (ℱ.obj.map (M_w.map f₁_lift).op ≫ ℱ.obj.map ε_W.op)) (x g₁ hg₁) =
        (CategoryTheory.ConcreteCategory.hom
          (ℱ.obj.map (M_w.map f₂_lift).op ≫ ℱ.obj.map ε_W.op)) (x g₂ hg₂) at hmap
      rw [← ℱ.obj.map_comp, ← ℱ.obj.map_comp, ← hop_comp, ← hop_comp, hε₁, hε₂] at hmap
      exact hmap
    have hCov : CategoryTheory.CoverPreserving
        Z'.smallEtaleTopology Z.smallEtaleTopology M_w := by
      refine ⟨fun {U₀} {S_cov} hS => ?_⟩
      refine (hMemEtale Z (M_w.obj U₀) (S_cov.functorPushforward M_w)).mpr fun x => ?_
      obtain ⟨Y₀, g₀, y₀, hg_S, hg_et, hg_pt⟩ := (hMemEtale Z' U₀ S_cov).mp hS x
      exact ⟨M_w.obj Y₀, M_w.map g₀, y₀,
        ⟨Y₀, g₀, 𝟙 (M_w.obj Y₀), hg_S, (CategoryTheory.Category.id_comp _).symm⟩,
        hg_et, hg_pt⟩
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  have hSliceCocont : ∀ {Z' Z : AlgebraicGeometry.Scheme.{u}} (w : Z' ⟶ Z)
      (hw : AlgebraicGeometry.Etale w),
      (sliceEtale w hw).IsCocontinuous Z'.smallEtaleTopology Z.smallEtaleTopology := by
    intro Z' Z w hw
    let M_w := sliceEtale w hw
    refine ⟨fun {U₀} {R} hR => ?_⟩
    refine (hMemEtale Z' U₀ (R.functorPullback M_w)).mpr fun x => ?_
    obtain ⟨Y₀, u₀, y₀, hu_R, hu_et, hu_pt⟩ := (hMemEtale Z (M_w.obj U₀) R).mp hR x
    have hY'_et : AlgebraicGeometry.Etale (u₀.left ≫ U₀.hom) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        u₀.left U₀.hom hu_et U₀.prop
    let Y' : Z'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (u₀.left ≫ U₀.hom) hY'_et
    let u' : Y' ⟶ U₀ := CategoryTheory.MorphismProperty.Over.homMk u₀.left rfl
    let e_Y : M_w.obj Y' ⟶ Y₀ :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 Y₀.left : (M_w.obj Y').left ⟶ Y₀.left)
        ((CategoryTheory.Category.id_comp Y₀.hom).trans
          ((CategoryTheory.MorphismProperty.Over.w u₀).symm.trans
            (CategoryTheory.Category.assoc u₀.left U₀.hom w).symm))
    have hmap_u' : M_w.map u' = e_Y ≫ u₀ :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (CategoryTheory.Category.id_comp u₀.left).symm (Subsingleton.elim _ _)
    refine ⟨Y', u', y₀, ?_, hu_et, hu_pt⟩
    change R.arrows (M_w.map u')
    rw [hmap_u']
    exact R.downward_closed hu_R e_Y

  have hSliceThetaIso : ∀ {Z' Z : AlgebraicGeometry.Scheme.{u}} (w : Z' ⟶ Z)
      (hw : AlgebraicGeometry.Etale w),
      let M_w := sliceEtale w hw
      letI : M_w.IsContinuous Z'.smallEtaleTopology Z.smallEtaleTopology := hSliceCont w hw
      let J' := Z'.smallEtaleTopology
      let J := Z.smallEtaleTopology
      let G' := weilEtaleTorsionSheaf Z' ℓ
      let G := weilEtaleTorsionSheaf Z ℓ
      let res_w := M_w.sheafPushforwardContinuous AddCommGrpCat.{u} J' J
      let const' := (CategoryTheory.Functor.const (Z'.Etale)ᵒᵖ).obj AM
      let constZ := (CategoryTheory.Functor.const (Z.Etale)ᵒᵖ).obj AM
      let η' := CategoryTheory.toSheafify J' const'
      let ηZ := CategoryTheory.toSheafify J constZ
      let θ_w : G' ⟶ res_w.obj G :=
        ((CategoryTheory.sheafificationAdjunction J' AddCommGrpCat.{u}).homEquiv
          const' (res_w.obj G)).symm (CategoryTheory.Functor.whiskerLeft M_w.op ηZ)
      (η' ≫ θ_w.hom = CategoryTheory.Functor.whiskerLeft M_w.op ηZ) ∧
      CategoryTheory.IsIso θ_w := by
    intro Z' Z w hw M_w J' J G' G res_w const' constZ η' ηZ θ_w
    have : M_w.IsContinuous J' J := hSliceCont w hw
    have : M_w.IsCocontinuous J' J := hSliceCocont w hw
    let adj_sh' := CategoryTheory.sheafificationAdjunction J' AddCommGrpCat.{u}
    have hη_θ : η' ≫ θ_w.hom = CategoryTheory.Functor.whiskerLeft M_w.op ηZ :=
      (adj_sh'.homEquiv const' (res_w.obj G)).apply_symm_apply
        (CategoryTheory.Functor.whiskerLeft M_w.op ηZ)
    refine ⟨hη_θ, ?_⟩
    have hInj : ∀ U₀ : Z'.Etale, Function.Injective (θ_w.hom.app (Opposite.op U₀)) := by
      intro U₀
      rw [injective_iff_map_eq_zero]
      intro s hs0
      have hImg : CategoryTheory.Presheaf.imageSieve η' s ∈ J' U₀ :=
        CategoryTheory.Presheaf.imageSieve_mem J' η' s
      refine G'.isSeparated U₀ (CategoryTheory.Presheaf.imageSieve η' s) hImg s 0
        (fun V₀ g₀ hg₀ => ?_)
      change (G'.obj.map g₀.op) s = (G'.obj.map g₀.op) 0
      rw [map_zero]
      obtain ⟨a, ha⟩ := hg₀
      have hηZ_zero : (ηZ.app (Opposite.op (M_w.obj V₀))) a =
          (ηZ.app (Opposite.op (M_w.obj V₀))) 0 := by
        rw [map_zero]
        have h1 : (ηZ.app (Opposite.op (M_w.obj V₀))) a =
            (θ_w.hom.app (Opposite.op V₀)) ((η'.app (Opposite.op V₀)) a) :=
          (congrArg (fun ν : const' ⟶ (res_w.obj G).obj => (ν.app (Opposite.op V₀)) a) hη_θ).symm
        rw [h1, ha]
        have hnat := congrArg (fun k => k s) (θ_w.hom.naturality g₀.op)
        exact hnat.trans
          ((congrArg ((res_w.obj G).obj.map g₀.op) hs0).trans (map_zero _))
      let S_eq := CategoryTheory.Presheaf.equalizerSieve
        (F := constZ) (X := Opposite.op (M_w.obj V₀)) a 0
      have hSeq_mem : S_eq ∈ J (M_w.obj V₀) :=
        CategoryTheory.Presheaf.equalizerSieve_mem J ηZ a 0 hηZ_zero
      have hSpull_mem : S_eq.functorPullback M_w ∈ J' V₀ :=
        M_w.cover_lift J' J hSeq_mem
      refine G'.isSeparated V₀ (S_eq.functorPullback M_w) hSpull_mem
        ((G'.obj.map g₀.op) s) 0 (fun V' k₀ hk₀ => ?_)
      change (G'.obj.map k₀.op) ((G'.obj.map g₀.op) s) = (G'.obj.map k₀.op) 0
      rw [map_zero]
      have ha0 : (a : ↥AM) = 0 := hk₀
      have hnat' := congrArg (fun m => m a) (η'.naturality k₀.op)
      exact (congrArg (G'.obj.map k₀.op) ha.symm).trans
        (hnat'.symm.trans
          ((congrArg (η'.app (Opposite.op V')).hom ha0).trans
            (map_zero (η'.app (Opposite.op V')).hom)))
    have _ : ∀ W_op : (Z'.Etale)ᵒᵖ, CategoryTheory.Mono (θ_w.hom.app W_op) :=
      fun W_op => (AddCommGrpCat.mono_iff_injective _).mpr (hInj W_op.unop)
    have hMono_hom : CategoryTheory.Mono θ_w.hom :=
      (CategoryTheory.NatTrans.mono_iff_mono_app θ_w.hom).mpr inferInstance
    have _ : CategoryTheory.Mono θ_w :=
      (CategoryTheory.sheafToPresheaf J' AddCommGrpCat.{u}).mono_of_mono_map hMono_hom
    have hSurj : CategoryTheory.Sheaf.IsLocallySurjective θ_w := by
      refine ⟨fun {U₀} t => ?_⟩
      let R_img := CategoryTheory.Presheaf.imageSieve ηZ t
      have hR_mem : R_img ∈ J (M_w.obj U₀) :=
        CategoryTheory.Presheaf.imageSieve_mem J ηZ t
      have hRpull_mem : R_img.functorPullback M_w ∈ J' U₀ :=
        M_w.cover_lift J' J hR_mem
      refine J'.superset_covering (fun V₀ k₀ hk₀ => ?_) hRpull_mem
      obtain ⟨a, ha⟩ := hk₀
      refine ⟨(η'.app (Opposite.op V₀)) a, ?_⟩
      have h1 : (θ_w.hom.app (Opposite.op V₀)) ((η'.app (Opposite.op V₀)) a) =
          (ηZ.app (Opposite.op (M_w.obj V₀))) a :=
        congrArg (fun ν : const' ⟶ (res_w.obj G).obj => (ν.app (Opposite.op V₀)) a) hη_θ
      exact h1.trans ha
    have _ : CategoryTheory.Epi θ_w := CategoryTheory.Sheaf.epi_of_isLocallySurjective θ_w
    exact CategoryTheory.isIso_of_mono_of_epi θ_w

  
  
  
  have hSquareBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
      [_hc : (weilEtaleSitePullback h).IsContinuous
        S₂.smallEtaleTopology S₁.smallEtaleTopology]
      {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (E : S₂.Etale)
      {W' : AlgebraicGeometry.Scheme.{u}} (w' : W' ⟶ S₁) (h' : W' ⟶ E.left),
      CategoryTheory.IsPullback w' h' h E.hom →
      ∀ (ψ₀ : weilEtaleTorsionH E.left ℓ 0 →+ weilEtaleTorsionH W' ℓ 0),
        WeilIsTorsionEtalePullback h' ℓ 0 ψ₀ →
        Function.Bijective ψ₀ →
        let G₁ := weilEtaleTorsionSheaf S₁ ℓ
        let G₂ := weilEtaleTorsionSheaf S₂ ℓ
        let pf_h := (weilEtaleSitePullback h).sheafPushforwardContinuous
          AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
        let adj₁ := CategoryTheory.constantSheafAdj S₁.smallEtaleTopology AddCommGrpCat.{u} hT₁
        let adj₂ := CategoryTheory.constantSheafAdj S₂.smallEtaleTopology AddCommGrpCat.{u} hT₂
        let τ := hT₁.from ((weilEtaleSitePullback h).obj T₂)
        let α_h : G₂ ⟶ pf_h.obj G₁ :=
          (adj₂.homEquiv AM (pf_h.obj G₁)).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (G₁.obj.map (Opposite.op τ)))
        Function.Bijective (α_h.hom.app (Opposite.op E)) := by
    intro S₁ S₂ h _hc T₁ hT₁ T₂ hT₂ E W' w' h' hpb ψ₀ hψ₀ hBij₀
      G₁ G₂ pf_h adj₁ adj₂ τ α_h
    let W := E.left
    
    rcases hψ₀ with ⟨hc', hr', hAdd', hLim', hColim', TW', hTW', TW, hTW,
      ιℤ', hιπ', hπι', hψ₀_eq⟩
    have := hc'
    have := hr'
    have := hAdd'
    have := hLim'
    have := hColim'
    let B_h' : CategoryTheory.Functor W.Etale W'.Etale := weilEtaleSitePullback h'
    let J_W := W.smallEtaleTopology
    let J_W' := W'.smallEtaleTopology
    let G_W := weilEtaleTorsionSheaf W ℓ
    let G_W' := weilEtaleTorsionSheaf W' ℓ
    let Fℤ_W := (CategoryTheory.constantSheaf J_W AddCommGrpCat.{u}).obj Aℤ
    let Fℤ_W' := (CategoryTheory.constantSheaf J_W' AddCommGrpCat.{u}).obj Aℤ
    let pf_h' := B_h'.sheafPushforwardContinuous AddCommGrpCat.{u} J_W J_W'
    let pb_h' := B_h'.sheafPullback AddCommGrpCat.{u} J_W J_W'
    let adj_pull' := B_h'.sheafAdjunctionContinuous AddCommGrpCat.{u} J_W J_W'
    let adj_TW' := CategoryTheory.constantSheafAdj J_W' AddCommGrpCat.{u} hTW'
    let adj_TW := CategoryTheory.constantSheafAdj J_W AddCommGrpCat.{u} hTW
    let τ' := hTW'.from (B_h'.obj TW)
    let πℤ' : pb_h'.obj Fℤ_W ⟶ Fℤ_W' :=
      (adj_pull'.homEquiv Fℤ_W Fℤ_W').symm
        ((adj_TW.homEquiv Aℤ (pf_h'.obj Fℤ_W')).symm
          (CategoryTheory.CategoryStruct.comp (adj_TW'.unit.app Aℤ)
            (Fℤ_W'.obj.map (Opposite.op τ'))))
    let α_h' : G_W ⟶ pf_h'.obj G_W' :=
      (adj_TW.homEquiv AM (pf_h'.obj G_W')).symm
        (CategoryTheory.CategoryStruct.comp (adj_TW'.unit.app AM)
          (G_W'.obj.map (Opposite.op τ')))
    let πM' : pb_h'.obj G_W ⟶ G_W' := (adj_pull'.homEquiv G_W G_W').symm α_h'
    have hExtMk₀Equiv : ∀ {C_ab : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C_ab]
        [CategoryTheory.Abelian C_ab] [CategoryTheory.HasExt.{u} C_ab]
        {Y₁ Y₂ : C_ab} (g : Y₁ ⟶ Y₂),
        CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
      intro C_ab _ _ _ Y₁ Y₂ g
      have hg := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
        (CategoryTheory.Abelian.Ext.addEquiv₀.symm g)
      rw [AddEquiv.apply_symm_apply] at hg
      rw [hg, AddEquiv.apply_symm_apply]
    let Φ_Hom : (Fℤ_W ⟶ G_W) → (Fℤ_W' ⟶ G_W') :=
      fun f => ιℤ' ≫ pb_h'.map f ≫ πM'
    have hΦ_eq : ∀ f : Fℤ_W ⟶ G_W,
        CategoryTheory.Abelian.Ext.addEquiv₀
          (ψ₀ (CategoryTheory.Abelian.Ext.addEquiv₀.symm f)) = Φ_Hom f := by
      intro f
      have hf_symm : CategoryTheory.Abelian.Ext.addEquiv₀.symm f =
          CategoryTheory.Abelian.Ext.mk₀ f := by
        apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
        rw [AddEquiv.apply_symm_apply, hExtMk₀Equiv]
      rw [hψ₀_eq, hf_symm]
      change CategoryTheory.Abelian.Ext.addEquiv₀
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ').comp
          ((pb_h'.mapExtAddHom Fℤ_W G_W 0) (CategoryTheory.Abelian.Ext.mk₀ f))
          (Nat.zero_add 0)).comp (CategoryTheory.Abelian.Ext.mk₀ πM') (Nat.add_zero 0)) = _
      rw [CategoryTheory.Functor.mapExtAddHom_apply pb_h' Fℤ_W G_W 0,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hExtMk₀Equiv, CategoryTheory.Category.assoc]
    have hBij_ΦHom : Function.Bijective Φ_Hom := by
      have hfun : Φ_Hom =
          ⇑(CategoryTheory.Abelian.Ext.addEquiv₀ : G_W'.H 0 ≃+ (Fℤ_W' ⟶ G_W')) ∘
            ⇑ψ₀ ∘ ⇑(CategoryTheory.Abelian.Ext.addEquiv₀ : G_W.H 0 ≃+ (Fℤ_W ⟶ G_W)).symm :=
        funext fun f => (hΦ_eq f).symm
      rw [hfun]
      exact CategoryTheory.Abelian.Ext.addEquiv₀.bijective.comp
        (hBij₀.comp CategoryTheory.Abelian.Ext.addEquiv₀.symm.bijective)
    let e_ι : (Fℤ_W' ⟶ G_W') ≃ (pb_h'.obj Fℤ_W ⟶ G_W') :=
      { toFun := fun g => πℤ' ≫ g
        invFun := fun k => ιℤ' ≫ k
        left_inv := fun g =>
          (CategoryTheory.Category.assoc ιℤ' πℤ' g).symm.trans
            ((congrArg (· ≫ g) hιπ').trans (CategoryTheory.Category.id_comp g))
        right_inv := fun k =>
          (CategoryTheory.Category.assoc πℤ' ιℤ' k).symm.trans
            ((congrArg (· ≫ k) hπι').trans (CategoryTheory.Category.id_comp k)) }
    have hBij_postα : Function.Bijective (fun f : Fℤ_W ⟶ G_W => f ≫ α_h') := by
      let eqv := adj_pull'.homEquiv Fℤ_W G_W'
      have hfun : (fun f : Fℤ_W ⟶ G_W => f ≫ α_h') = ⇑eqv ∘ ⇑e_ι ∘ Φ_Hom :=
        funext fun f =>
          eqv.symm.injective
            ((adj_pull'.homEquiv_naturality_left_symm f α_h').trans
              ((e_ι.right_inv (pb_h'.map f ≫ πM')).symm.trans
                (eqv.symm_apply_apply (e_ι (Φ_Hom f))).symm))
      exact Eq.mp (congrArg Function.Bijective hfun.symm)
        (eqv.bijective.comp (e_ι.bijective.comp hBij_ΦHom))
    let evZ : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃ ↥M := fun M =>
      { toFun := fun u => u.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
        left_inv := fun u => by
          apply AddCommGrpCat.ext
          rintro ⟨z⟩
          change z • u.hom (ULift.up (1 : ℤ)) = u.hom (ULift.up z)
          have hz : z • (ULift.up (1 : ℤ) : ↥Aℤ) = ULift.up z :=
            ULift.ext _ _ (by change z • (1 : ℤ) = z; simp)
          rw [← map_zsmul u.hom z (ULift.up (1 : ℤ)), hz]
        right_inv := fun m => one_zsmul m }
    let e_tot : ∀ (ℱ : CategoryTheory.Sheaf J_W AddCommGrpCat.{u}),
