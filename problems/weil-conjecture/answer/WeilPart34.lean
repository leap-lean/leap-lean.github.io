            WeilIsEtaleSheafPullback x_bar F_P Q_x ∧ CategoryTheory.Limits.IsZero Q_x := by
        intro F_P hZ_pbi
        have hPB_i : WeilIsEtaleSheafPullback i₀ F_P (pb_i.obj F_P) :=
          ⟨hc_i, hr_i, ⟨CategoryTheory.Iso.refl _⟩⟩
        obtain ⟨Q_x, hPB_sx, _, hZ_Qx_imp⟩ := hExPB (x_bar ≫ π.left) (pb_i.obj F_P)
        have hPB_x : WeilIsEtaleSheafPullback x_bar F_P Q_x := by
          rw [hx_fac]
          exact (hCompPB (x_bar ≫ π.left) i₀ F_P (pb_i.obj F_P) Q_x).1 hPB_i hPB_sx
        exact ⟨Q_x, hPB_x, hZ_Qx_imp hZ_pbi⟩
      exact ⟨hComplZero (CategoryTheory.Limits.kernel η_G) hZero_pbi_ker,
        hComplZero (CategoryTheory.Limits.cokernel η_G) hZero_pbi_coker⟩
  have hZero_ker_η : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel η_G) :=
    weil_etale_geometric_point_stalk_conservativity P.left (CategoryTheory.Limits.kernel η_G)
      (fun Ω _ _ x_bar => (hKerCokerStalkZero Ω x_bar).1)
  have hZero_coker_η : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel η_G) :=
    weil_etale_geometric_point_stalk_conservativity P.left (CategoryTheory.Limits.cokernel η_G)
      (fun Ω _ _ x_bar => (hKerCokerStalkZero Ω x_bar).2)
  have _ : CategoryTheory.Mono η_G :=
    (CategoryTheory.Preadditive.mono_iff_isZero_kernel η_G).mpr hZero_ker_η
  have _ : CategoryTheory.Epi η_G :=
    (CategoryTheory.Preadditive.epi_iff_isZero_cokernel η_G).mpr hZero_coker_η
  have _ : CategoryTheory.IsIso η_G := CategoryTheory.isIso_of_mono_of_epi η_G
  refine ⟨?_, ?_⟩
  · obtain ⟨e_R0_π⟩ := (weil_etale_higherDirectImage_shortExact_calculus π.left).2.1 G
    let e_RHS : H_G ≅ weilEtaleHigherDirectImage π.left 0 G :=
      (e_pf.app H_G).symm ≪≫ (pf_π.mapIso (CategoryTheory.asIso η_G)).symm ≪≫ e_R0_π.symm
    exact hIsoPB i₀ G G H_G (weilEtaleHigherDirectImage π.left 0 G)
      hPB_HG ⟨CategoryTheory.Iso.refl G⟩ ⟨e_RHS⟩
  · intro a ha
    obtain ⟨d, rfl⟩ : ∃ d : ℕ, a = d + 1 := ⟨a - 1, (Nat.sub_add_cancel ha).symm⟩
    have hZ_pfi := hPiAcycPush d H_G hℓHG
    obtain ⟨e_Ra⟩ := ((weil_etale_higherDirectImage_shortExact_calculus π.left).1
      G (pf_i.obj H_G) (d + 1)).1 ⟨CategoryTheory.asIso η_G⟩
    exact hZ_pfi.of_iso e_Ra

theorem weil_leray_sec_higherDirectImage_x3_acyclic_iso {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) :
    (∀ [_hc : (weilEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology]
        {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}} (φ : F₁ ⟶ F₂),
      CategoryTheory.Epi
        (((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
          S.smallEtaleTopology X.smallEtaleTopology).map φ) →
      CategoryTheory.Epi (weilEtaleHigherDirectImageMap f 0 φ)) ∧
    (∀ (SC : CategoryTheory.ShortComplex
          (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})),
      SC.ShortExact →
      (CategoryTheory.Epi (weilEtaleHigherDirectImageMap f 0 SC.f) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f 1 SC.X₂) →
        Nonempty (weilEtaleHigherDirectImage f 0 SC.X₃ ≅
          weilEtaleHigherDirectImage f 1 SC.X₁)) ∧
      (∀ (q : ℕ),
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f q SC.X₃) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f (q + 1) SC.X₃) →
        Nonempty (weilEtaleHigherDirectImage f (q + 1) SC.X₁ ≅
          weilEtaleHigherDirectImage f (q + 1) SC.X₂))) :=
by
  let J_X := X.smallEtaleTopology
  let J_S := S.smallEtaleTopology
  let B_f := weilEtaleSitePullback f
  let W_S : CategoryTheory.Functor
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
      (CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) :=
    (CategoryTheory.Functor.whiskeringLeft (Opposite S.Etale) (Opposite X.Etale)
      AddCommGrpCat.{u}).obj B_f.op
  let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
  let U_S := CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}
  let E_S := W_S.comp Sh_S
  let Φ_dir : ℕ → CategoryTheory.Functor
      (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
    fun q => (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).comp E_S
  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let L_tot := Free_PSh ⋙ Sh_X
  let R_tot := U_X ⋙ Fgt_PSh
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite X.Etale) AddCommGrpCat.adj
  let adj_shX := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_shX
  let Z_fun : X.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  refine ⟨?_, ?_⟩
  · intro _hc F₁ F₂ φ hEpi_pf
    let _ : B_f.IsContinuous J_S J_X := _hc
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X
    let e_raw : ∀ (W : Opposite X.Etale) (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        CategoryTheory.Abelian.Ext (Z_obj W) G 0 ≃ ↑((U_X.obj G).obj W) :=
      fun W G =>
        CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) G).trans
            CategoryTheory.yonedaEquiv)
    have he_add : ∀ (W : Opposite X.Etale) (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) G 0),
        e_raw W G (α₁ + α₂) = e_raw W G α₁ + e_raw W G α₂ := by
      intro W G α₁ α₂
      let V := Opposite.unop W
      let u₁ : Z_obj W ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
      let u₂ : Z_obj W ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
      have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
        map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
      let ψ : (Z_obj W ⟶ G) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj G) :=
        fun u => adj_shX.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) G u
      have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
        dsimp [ψ]
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
          CategoryTheory.Adjunction.homEquiv_unit]
        have hmap : U_X.map (u₁ + u₂) = U_X.map u₁ + U_X.map u₂ := rfl
        rw [hmap, CategoryTheory.Preadditive.comp_add]
      let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj G) →
          ↑((U_X.obj G).obj W) :=
        fun τ => CategoryTheory.yonedaEquiv
          (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_X.obj G) τ)
      let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
      have hyon : ∀ (τ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj G),
          eval_hom τ = (τ.app W) g₀ := by
        intro τ
        dsimp [eval_hom]
        rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) G 0),
          e_raw W G α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
        intro α
        dsimp [e_raw, eval_hom, ψ, adj_tot]
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        rfl
      rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
        CategoryTheory.NatTrans.app_add]
      rfl
    let e_add : ∀ (W : Opposite X.Etale) (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj G).obj W) ≃+
          ↑((U_X.obj G).obj W) :=
      fun W G => AddEquiv.mk' (e_raw W G) (he_add W G)
    let θ_comp : ∀ (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (W : Opposite X.Etale),
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj G).obj W ≅
          (U_X.obj G).obj W :=
      fun G W =>
        { hom := AddCommGrpCat.ofHom (e_add W G).toAddMonoidHom
          inv := AddCommGrpCat.ofHom (e_add W G).symm.toAddMonoidHom
          hom_inv_id := by ext x; exact (e_add W G).symm_apply_apply x
          inv_hom_id := by ext y; exact (e_add W G).apply_symm_apply y }
    let θ_obj : ∀ (G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj G ≅ U_X.obj G :=
      fun G => CategoryTheory.NatIso.ofComponents (fun W => θ_comp G W) (by
        intro W₁ W₂ ω
        have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj G).map ω =
            ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app G := rfl
        rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) G]
        ext α
        let u : Z_obj W₁ ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        change e_raw W₂ G
            ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
          ((U_X.obj G).map ω) (e_raw W₁ G α)
        rw [hα]
        have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
        rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        dsimp [e_raw]
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
          CategoryTheory.Adjunction.homEquiv_naturality_left,
          ← CategoryTheory.yonedaEquiv_naturality',
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rfl)
    let θ_zero : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ U_X :=
      CategoryTheory.NatIso.ofComponents θ_obj (by
        intro G₁ G₂ τ
        ext W α
        have hmap_τ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map τ).app W =
            (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map τ := rfl
        let u : Z_obj W ⟶ G₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        change e_raw W G₂
            ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map τ).app W) α) =
          ((U_X.map τ).app W) (e_raw W G₁ α)
        rw [hmap_τ_mor, CategoryTheory.Abelian.extFunctorObj_map, hα]
        have hpost : ((CategoryTheory.Abelian.Ext.mk₀ τ).postcomp (Z_obj W) (Nat.add_zero 0))
            (CategoryTheory.Abelian.Ext.mk₀ u) =
            CategoryTheory.Abelian.Ext.mk₀ (u ≫ τ) :=
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u τ
        change e_raw W G₂ (((CategoryTheory.Abelian.Ext.mk₀ τ).postcomp (Z_obj W) (Nat.add_zero 0))
            (CategoryTheory.Abelian.Ext.mk₀ u)) = _
        rw [hpost]
        dsimp [e_raw]
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
          CategoryTheory.Adjunction.homEquiv_naturality_right,
          CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rfl)
    let e_pre_S : U_X.comp W_S ≅ pf_f.comp U_S :=
      CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _)
        (fun {_ _} _ => by ext W x; rfl)
    let e_counit_S : U_S.comp Sh_S ≅
        CategoryTheory.Functor.id (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
      CategoryTheory.asIso (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).counit
    let ε₀_iso : Φ_dir 0 ≅ pf_f :=
      CategoryTheory.Functor.isoWhiskerRight θ_zero E_S ≪≫
        (CategoryTheory.Functor.associator U_X W_S Sh_S).symm ≪≫
        CategoryTheory.Functor.isoWhiskerRight e_pre_S Sh_S ≪≫
        CategoryTheory.Functor.associator pf_f U_S Sh_S ≪≫
        CategoryTheory.Functor.isoWhiskerLeft pf_f e_counit_S ≪≫
        CategoryTheory.Functor.rightUnitor pf_f
    let e₀ : pf_f ≅ Φ_dir 0 := ε₀_iso.symm
    let e_app : ∀ G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        pf_f.obj G ≅ weilEtaleHigherDirectImage f 0 G :=
      fun G => e₀.app G
    have hnat : pf_f.map φ ≫ (e_app F₂).hom =
        (e_app F₁).hom ≫ weilEtaleHigherDirectImageMap f 0 φ :=
      e₀.hom.naturality φ
    have hfac : weilEtaleHigherDirectImageMap f 0 φ =
        (e_app F₁).inv ≫ (pf_f.map φ ≫ (e_app F₂).hom) := by
      calc
        weilEtaleHigherDirectImageMap f 0 φ
          = 𝟙 (weilEtaleHigherDirectImage f 0 F₁) ≫ weilEtaleHigherDirectImageMap f 0 φ :=
            (CategoryTheory.Category.id_comp _).symm
        _ = ((e_app F₁).inv ≫ (e_app F₁).hom) ≫ weilEtaleHigherDirectImageMap f 0 φ := by
            rw [(e_app F₁).inv_hom_id]
        _ = (e_app F₁).inv ≫ ((e_app F₁).hom ≫ weilEtaleHigherDirectImageMap f 0 φ) :=
            CategoryTheory.Category.assoc _ _ _
        _ = (e_app F₁).inv ≫ (pf_f.map φ ≫ (e_app F₂).hom) := by
            rw [hnat]
    rw [hfac]
    have _ : CategoryTheory.Epi (pf_f.map φ) := hEpi_pf
    have _ : CategoryTheory.Epi (pf_f.map φ ≫ (e_app F₂).hom) :=
      CategoryTheory.epi_comp (pf_f.map φ) (e_app F₂).hom
    exact CategoryTheory.epi_comp (e_app F₁).inv (pf_f.map φ ≫ (e_app F₂).hom)
  · intro SC hSE
    have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
        (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})),
        (∀ (W : Opposite X.Etale),
          (K.map ((CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
        K.Exact := by
      intro K hW
      rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
        CategoryTheory.Functor.isZero_iff]
      intro W
      let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
      have hZW : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
        (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
      exact hZW.of_iso (K.mapLeftHomologyIso evW).symm
    have hZeroFlankedIso : ∀ {A B C D : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}}
        (u : A ⟶ B) (v : B ⟶ C) (w : C ⟶ D)
        (huv : u ≫ v = 0) (hvw : v ≫ w = 0),
        (CategoryTheory.ShortComplex.mk u v huv).Exact →
        (CategoryTheory.ShortComplex.mk v w hvw).Exact →
        u = 0 → w = 0 → CategoryTheory.IsIso v := by
      intro A B C D u v w huv hvw hEx₁ hEx₂ hu hw
      have _ : CategoryTheory.Mono v := hEx₁.mono_g hu
      have _ : CategoryTheory.Epi v := hEx₂.epi_f hw
      exact CategoryTheory.isIso_of_mono_of_epi v
    have hMid_S : ∀ (n : ℕ),
        ∃ (hfg : weilEtaleHigherDirectImageMap f n SC.f ≫
            weilEtaleHigherDirectImageMap f n SC.g = 0),
          (CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f n SC.f)
            (weilEtaleHigherDirectImageMap f n SC.g) hfg).Exact := by
      intro n
      have hf_app : ∀ (W : Opposite X.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.f).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero n)) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) n SC.f
      have hg_app : ∀ (W : Opposite X.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.g).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero n)) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) n SC.g
      have hfg_pre :
          (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.f ≫
            (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.g = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE n
        have hz : AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero n)) ≫
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero n)) = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W, hg_app W]
        exact congrArg (fun φ => φ x) hz
      let M_pre := CategoryTheory.ShortComplex.mk
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.f)
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.g) hfg_pre
      have hM_pre_ex : M_pre.Exact := by
        apply hPresheafExact M_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE n
        let eW : M_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [M_pre, evW]; rw [hf_app W]; ext x; rfl)
            (by dsimp [M_pre, evW]; rw [hg_app W]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have hfg_S : weilEtaleHigherDirectImageMap f n SC.f ≫
          weilEtaleHigherDirectImageMap f n SC.g = 0 := by
        change E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.f) ≫
          E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X n).map SC.g) = 0
        rw [← E_S.map_comp, hfg_pre, E_S.map_zero]
      exact ⟨hfg_S, (hM_pre_ex.map W_S).map Sh_S⟩
    let δ_pre : ∀ (q : ℕ),
        SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1) :=
      fun q =>
        { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
          naturality := by
            intro W₁ W₂ ω
            have hL : (SC.X₃.cohomologyPresheaf q).map ω =
                ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
            have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
                ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
            rw [hL, hR,
              CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
              CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
            ext α
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
              (Nat.zero_add q) rfl (by omega) }
    let δ_S : ∀ (q : ℕ),
        weilEtaleHigherDirectImage f q SC.X₃ ⟶
          weilEtaleHigherDirectImage f (q + 1) SC.X₁ :=
      fun q => E_S.map (δ_pre q)
    have hConn_S : ∀ (q : ℕ),
        ∃ (h0_left : weilEtaleHigherDirectImageMap f q SC.g ≫ δ_S q = 0)
          (h0_right : δ_S q ≫ weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0),
          (CategoryTheory.ShortComplex.mk
            (weilEtaleHigherDirectImageMap f q SC.g) (δ_S q) h0_left).Exact ∧
          (CategoryTheory.ShortComplex.mk
            (δ_S q) (weilEtaleHigherDirectImageMap f (q + 1) SC.f) h0_right).Exact := by
      intro q
      have hg_app : ∀ (W : Opposite X.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) q SC.g
      have hf_app : ∀ (W : Opposite X.Etale),
          (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f).app W) =
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) :=
        fun W => CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) (q + 1) SC.f
      have hcomp₁_pre :
          (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g ≫ δ_pre q = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        have hz : AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero q)) ≫
            AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hg_app W]
        exact congrArg (fun φ => φ x) hz
      have hcomp₂_pre :
          δ_pre q ≫ (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        have hz : AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
            AddCommGrpCat.ofHom
              ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero (q + 1))) = 0 :=
          (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf_app W]
        exact congrArg (fun φ => φ x) hz
      let A_pre := CategoryTheory.ShortComplex.mk
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g) (δ_pre q) hcomp₁_pre
      let B_pre := CategoryTheory.ShortComplex.mk
        (δ_pre q) ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f) hcomp₂_pre
      have hA_pre_ex : A_pre.Exact := by
        apply hPresheafExact A_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        let eW : A_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [A_pre, evW]; rw [hg_app W]; ext x; rfl)
            (by dsimp [A_pre, evW, δ_pre]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have hB_pre_ex : B_pre.Exact := by
        apply hPresheafExact B_pre
        intro W
        let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        let eW : B_pre.map evW ≅ _ :=
          CategoryTheory.ShortComplex.isoMk
            (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
            (by dsimp [B_pre, evW, δ_pre]; ext x; rfl)
            (by dsimp [B_pre, evW]; rw [hf_app W]; ext x; rfl)
        exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
      have h0_left : weilEtaleHigherDirectImageMap f q SC.g ≫ δ_S q = 0 := by
        change E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g) ≫
          E_S.map (δ_pre q) = 0
        rw [← E_S.map_comp, hcomp₁_pre, E_S.map_zero]
      have h0_right : δ_S q ≫ weilEtaleHigherDirectImageMap f (q + 1) SC.f = 0 := by
        change E_S.map (δ_pre q) ≫
          E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f) = 0
        rw [← E_S.map_comp, hcomp₂_pre, E_S.map_zero]
      exact ⟨h0_left, h0_right, (hA_pre_ex.map W_S).map Sh_S, (hB_pre_ex.map W_S).map Sh_S⟩
    refine ⟨?_, ?_⟩
    · intro hEpi0 hZ1_X2
      obtain ⟨hfg0, _⟩ := hMid_S 0
      obtain ⟨h0_left0, h0_right0, hEx_left0, hEx_right0⟩ := hConn_S 0
      have _ : CategoryTheory.Epi (weilEtaleHigherDirectImageMap f 0 SC.f) := hEpi0
      have hg0 : weilEtaleHigherDirectImageMap f 0 SC.g = 0 := by
        apply (CategoryTheory.cancel_epi (weilEtaleHigherDirectImageMap f 0 SC.f)).mp
        rw [CategoryTheory.Limits.comp_zero]
        exact hfg0
      have hf1 : weilEtaleHigherDirectImageMap f 1 SC.f = 0 :=
        hZ1_X2.eq_of_tgt (weilEtaleHigherDirectImageMap f 1 SC.f) 0
      have _ : CategoryTheory.IsIso (δ_S 0) :=
        hZeroFlankedIso (weilEtaleHigherDirectImageMap f 0 SC.g) (δ_S 0)
          (weilEtaleHigherDirectImageMap f 1 SC.f) h0_left0 h0_right0
          hEx_left0 hEx_right0 hg0 hf1
      exact ⟨CategoryTheory.asIso (δ_S 0)⟩
    · intro q hZq hZq1
      obtain ⟨hfg_q1, hEx_mid_q1⟩ := hMid_S (q + 1)
      obtain ⟨_, h0_right_q, _, hEx_right_q⟩ := hConn_S q
      have hδ0 : δ_S q = 0 := hZq.eq_of_src (δ_S q) 0
      have hg_q1 : weilEtaleHigherDirectImageMap f (q + 1) SC.g = 0 :=
        hZq1.eq_of_tgt (weilEtaleHigherDirectImageMap f (q + 1) SC.g) 0
      have _ : CategoryTheory.IsIso (weilEtaleHigherDirectImageMap f (q + 1) SC.f) :=
        hZeroFlankedIso (δ_S q) (weilEtaleHigherDirectImageMap f (q + 1) SC.f)
          (weilEtaleHigherDirectImageMap f (q + 1) SC.g) h0_right_q hfg_q1
          hEx_right_q hEx_mid_q1 hδ0 hg_q1
      exact ⟨CategoryTheory.asIso (weilEtaleHigherDirectImageMap f (q + 1) SC.f)⟩

theorem weil_codim1_purity_section_complement_leray_iso (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ) :
    (∀ {X X' B : AlgebraicGeometry.Scheme.{u}} (e : X ≅ X') (f' : X' ⟶ B) (m : ℕ),
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f' m (weilEtaleTorsionSheaf X' ℓ)) →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage (e.hom ≫ f') m (weilEtaleTorsionSheaf X ℓ))) ∧
    (∀ (P₀ Y' Y U : AlgebraicGeometry.Scheme.{u})
        (j : Y' ⟶ P₀) (ι : Y ⟶ P₀) (j_U : U ⟶ Y) (g_U : U ⟶ Y')
        [AlgebraicGeometry.Etale ι] [AlgebraicGeometry.Etale g_U],
      CategoryTheory.IsPullback j_U g_U ι j →
      ∀ (b : ℕ),
        WeilIsEtaleSheafPullback ι
          (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf Y' ℓ))
          (weilEtaleHigherDirectImage j_U b (weilEtaleTorsionSheaf U ℓ))) ∧
    (∀ (Z U₀ : AlgebraicGeometry.Scheme.{u}) (j₀ : U₀ ⟶ Z)
        [AlgebraicGeometry.IsOpenImmersion j₀] (b : ℕ),
      1 ≤ b →
      ∃ (G₀ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback j₀
          (weilEtaleHigherDirectImage j₀ b (weilEtaleTorsionSheaf U₀ ℓ)) G₀ ∧
        CategoryTheory.Limits.IsZero G₀) ∧
    (∀ (P S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType P.hom]
        [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        [AlgebraicGeometry.IsAffine S.left]
        (π : P ⟶ S) [AlgebraicGeometry.IsProper π.left]
        (i₀ : S.left ⟶ P.left) [AlgebraicGeometry.IsClosedImmersion i₀]
        (_ : i₀ ≫ π.left = 𝟙 S.left)
        (Y' : AlgebraicGeometry.Scheme.{u}) (j : Y' ⟶ P.left)
        [AlgebraicGeometry.IsOpenImmersion j],
      Disjoint (Set.range i₀.base) (Set.range j.base) →
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P.left),
        (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
          x_bar.base pt ∉ Set.range j.base) →
        x_bar = (x_bar ≫ π.left) ≫ i₀) →
      (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ P.left) [AlgebraicGeometry.Etale w],
        ConnectedSpace ↥W → Nonempty ↥W →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback j w) ∧
        Nonempty ↥(CategoryTheory.Limits.pullback j w)) →
      (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
          (w : W ⟶ P.left) [AlgebraicGeometry.Etale w] (x : ↥W),
        ∃ (O : W.Opens),
          AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O ∧ ConnectedSpace ↥O.toScheme) →
      (∀ (m : ℕ), 1 ≤ m →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage (j ≫ π.left) m (weilEtaleTorsionSheaf Y' ℓ))) →
      ∀ (b : ℕ), 1 ≤ b →
        WeilIsEtaleSheafPullback i₀
          (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf Y' ℓ))
          (weilEtaleHigherDirectImage π.left (b + 1) (weilEtaleTorsionSheaf P.left ℓ))) :=
by
  classical
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  obtain ⟨hExPB, hIsoPB, _, _, _, _⟩ := weil_etale_pullback_exact_and_pseudofunctor.{u} ℓ
  obtain ⟨_, hConstPB, _, _, hTorsSh, hTorsR⟩ :=
    weil_etale_pullback_functoriality_and_iso_torsionH.{u} ℓ
  have hIdVan :=
    (weil_etale_higherDirectImage_idVanish_isoPush_and_shortExact.{u} k ℓ
      (weil_etale_constructible_mod_prime_serre_and_local.{u} k ℓ)).1
  obtain ⟨hSiteRes, _, _, hInjPres, hPushInj, _⟩ :=
    weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ

  have hUniquePB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (F : CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u})
      (G₁ G₂ : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback h F G₁ →
      WeilIsEtaleSheafPullback h F G₂ →
      Nonempty (G₁ ≅ G₂) := by
    rintro X₁ X₂ h F G₁ G₂ ⟨hc₁, hr₁, ⟨e₁⟩⟩ ⟨hc₂, hr₂, ⟨e₂⟩⟩
    have h_hc : hc₁ = hc₂ := Subsingleton.elim _ _
    subst h_hc
    have h_hr : hr₁ = hr₂ := Subsingleton.elim _ _
    subst h_hr
    exact ⟨e₁.symm ≪≫ e₂⟩

  have hIdPB : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback (CategoryTheory.CategoryStruct.id Z) F F := by
    intro Z F
    obtain ⟨hc_id, hr_id, _, _, _⟩ := hSiteRes (CategoryTheory.CategoryStruct.id Z)
    let B_id : CategoryTheory.Functor Z.Etale Z.Etale :=
      weilEtaleSitePullback (CategoryTheory.CategoryStruct.id Z)
    let pf_id := B_id.sheafPushforwardContinuous AddCommGrpCat.{u}
      Z.smallEtaleTopology Z.smallEtaleTopology
    let adj_id := B_id.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z.smallEtaleTopology Z.smallEtaleTopology
    let e_Bid : B_id ≅ CategoryTheory.Functor.id Z.Etale :=
      CategoryTheory.NatIso.ofComponents
        (fun E => by
          have h_id_comm : CategoryTheory.CategoryStruct.id E.left ≫ E.hom =
              E.hom ≫ CategoryTheory.CategoryStruct.id Z :=
            (CategoryTheory.Category.id_comp E.hom).trans
              (CategoryTheory.Category.comp_id E.hom).symm
          let iso_left :
              CategoryTheory.Limits.pullback E.hom (CategoryTheory.CategoryStruct.id Z) ≅
                E.left :=
            { hom := CategoryTheory.Limits.pullback.fst E.hom (CategoryTheory.CategoryStruct.id Z)
              inv := CategoryTheory.Limits.pullback.lift
                (CategoryTheory.CategoryStruct.id E.left) E.hom h_id_comm
              hom_inv_id := by
                apply CategoryTheory.Limits.pullback.hom_ext
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
                    CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
                · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
                    CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
                    CategoryTheory.Category.id_comp]
              inv_hom_id := CategoryTheory.Limits.pullback.lift_fst _ _ _ }
          refine CategoryTheory.MorphismProperty.Over.isoMk iso_left ?_
          change CategoryTheory.Limits.pullback.fst E.hom (CategoryTheory.CategoryStruct.id Z) ≫
              E.hom =
            CategoryTheory.Limits.pullback.snd E.hom (CategoryTheory.CategoryStruct.id Z)
          rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id])
        (fun {E₁ E₂} u => by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact CategoryTheory.Limits.pullback.lift_fst _ _ _)
    let e_pf1 : pf_id ≅ (CategoryTheory.Functor.id Z.Etale).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z.smallEtaleTopology Z.smallEtaleTopology :=
      CategoryTheory.Functor.sheafPushforwardContinuousIso e_Bid AddCommGrpCat.{u}
        Z.smallEtaleTopology Z.smallEtaleTopology
    let e_pf2 : (CategoryTheory.Functor.id Z.Etale).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z.smallEtaleTopology Z.smallEtaleTopology ≅
        CategoryTheory.Functor.id (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.NatIso.ofComponents
        (fun _𝒢 =>
          { hom := CategoryTheory.ObjectProperty.homMk (CategoryTheory.CategoryStruct.id _)
            inv := CategoryTheory.ObjectProperty.homMk (CategoryTheory.CategoryStruct.id _)
            hom_inv_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun _ =>
              CategoryTheory.Category.id_comp _))
            inv_hom_id := CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun _ =>
              CategoryTheory.Category.id_comp _)) })
        (fun {_ _} _ => CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun _ =>
          (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)))
    let e_pb_id :=
      (adj_id.ofNatIsoRight (e_pf1 ≪≫ e_pf2)).leftAdjointUniq CategoryTheory.Adjunction.id
    exact ⟨hc_id, hr_id, ⟨e_pb_id.app F⟩⟩

  have hClause2 : ∀ (P₀ Y' Y U : AlgebraicGeometry.Scheme.{u})
      (j : Y' ⟶ P₀) (ι : Y ⟶ P₀) (j_U : U ⟶ Y) (g_U : U ⟶ Y')
      [AlgebraicGeometry.Etale ι] [AlgebraicGeometry.Etale g_U],
      CategoryTheory.IsPullback j_U g_U ι j →
      ∀ (b : ℕ),
        WeilIsEtaleSheafPullback ι
          (weilEtaleHigherDirectImage j b (weilEtaleTorsionSheaf Y' ℓ))
          (weilEtaleHigherDirectImage j_U b (weilEtaleTorsionSheaf U ℓ)) := by
    intro P₀ Y' Y U j ι j_U g_U _ _ hPb b
    exact weil_leray_sec_etale_baseChange_higherDirectImage.{u} P₀ Y' Y U j ι j_U g_U hPb
      (weilEtaleTorsionSheaf Y' ℓ) (weilEtaleTorsionSheaf U ℓ) (hConstPB g_U _) b

  have hClause1 : ∀ {X X' B : AlgebraicGeometry.Scheme.{u}} (e : X ≅ X') (f' : X' ⟶ B) (m : ℕ),
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f' m (weilEtaleTorsionSheaf X' ℓ)) →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage (e.hom ≫ f') m (weilEtaleTorsionSheaf X ℓ)) := by
    intro X X' B e f' m hZero
    have hPb1 : CategoryTheory.IsPullback (e.hom ≫ f') e.hom (𝟙 B) f' :=
      { w := CategoryTheory.Category.comp_id (e.hom ≫ f')
        isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
          (fun c => c.snd ≫ e.inv)
          (fun c => by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e.inv e.hom f',
              e.inv_hom_id, CategoryTheory.Category.id_comp, ← c.condition,
              CategoryTheory.Category.comp_id])
          (fun c => by
            rw [CategoryTheory.Category.assoc, e.inv_hom_id, CategoryTheory.Category.comp_id])
          (fun c l _ hl₂ => by
            rw [← hl₂, CategoryTheory.Category.assoc, e.hom_inv_id,
              CategoryTheory.Category.comp_id])⟩ }
    have hPB_B := hClause2 B X' B X f' (𝟙 B) (e.hom ≫ f') e.hom hPb1 m
    obtain ⟨G₁, hPB_G₁, _, hZero_G₁⟩ :=
      hExPB (𝟙 B) (weilEtaleHigherDirectImage f' m (weilEtaleTorsionSheaf X' ℓ))
    obtain ⟨e_G⟩ := hUniquePB (𝟙 B) _ G₁ _ hPB_G₁ hPB_B
    exact (hZero_G₁ hZero).of_iso e_G.symm

  have hOpenRestrZero_any : ∀ (Z U₀ : AlgebraicGeometry.Scheme.{u}) (j₀ : U₀ ⟶ Z)
      [AlgebraicGeometry.IsOpenImmersion j₀]
      (F₀ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}) (b : ℕ),
      1 ≤ b →
      ∃ (G₀ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback j₀ (weilEtaleHigherDirectImage j₀ b F₀) G₀ ∧
        CategoryTheory.Limits.IsZero G₀ := by
    intro Z U₀ j₀ _ F₀ b hb
    have hPb_self : CategoryTheory.IsPullback (𝟙 U₀) (𝟙 U₀) j₀ j₀ :=
      { w := rfl
        isLimit' := ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk _
          (fun c => c.fst)
          (fun c => CategoryTheory.Category.comp_id c.fst)
          (fun c => (CategoryTheory.Category.comp_id c.fst).trans ((cancel_mono j₀).mp c.condition))
          (fun c l hl₁ _ => (hl₁.symm.trans (CategoryTheory.Category.comp_id l)).symm)⟩ }
    have hPB_self := weil_leray_sec_etale_baseChange_higherDirectImage.{u}
      Z U₀ U₀ U₀ j₀ j₀ (𝟙 U₀) (𝟙 U₀) hPb_self F₀ F₀ (hIdPB U₀ F₀) b
    have hb_eq : (b - 1) + 1 = b := Nat.sub_add_cancel hb
    have hZ_id : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage (𝟙 U₀) b F₀) := by
      rw [← hb_eq]
      exact hIdVan U₀ F₀ (b - 1)
    exact ⟨weilEtaleHigherDirectImage (𝟙 U₀) b F₀, hPB_self, hZ_id⟩

  have hClause3 : ∀ (Z U₀ : AlgebraicGeometry.Scheme.{u}) (j₀ : U₀ ⟶ Z)
      [AlgebraicGeometry.IsOpenImmersion j₀] (b : ℕ),
      1 ≤ b →
      ∃ (G₀ : CategoryTheory.Sheaf U₀.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback j₀
          (weilEtaleHigherDirectImage j₀ b (weilEtaleTorsionSheaf U₀ ℓ)) G₀ ∧
        CategoryTheory.Limits.IsZero G₀ :=
    fun Z U₀ j₀ _ b hb => hOpenRestrZero_any Z U₀ j₀ (weilEtaleTorsionSheaf U₀ ℓ) b hb

  refine ⟨hClause1, hClause2, hClause3, ?_⟩
  intro P S _ _ _ π _ i₀ _ hi₀_sec Y' j _ hDisj hCompl hConn hConnBasis hAcyc b hb

  let R_ℓ := ULift.{u, 0} (ZMod ℓ)
  let U_sh := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
    CategoryTheory.Sheaf.composeAndSheafify Z.smallEtaleTopology
      (CategoryTheory.forget₂ (ModuleCat.{u, u} R_ℓ) AddCommGrpCat.{u})

  obtain ⟨hc_j, hr_j, _, _, hAdd_pfj⟩ := hSiteRes j
  obtain ⟨hc_π, hr_π, _, _, hAdd_pfπ⟩ := hSiteRes π.left
  obtain ⟨hc_jπ, hr_jπ, _, _, hAdd_pfjπ⟩ := hSiteRes (j ≫ π.left)

  let B_j : CategoryTheory.Functor P.left.Etale Y'.Etale := weilEtaleSitePullback j
  let B_π : CategoryTheory.Functor S.left.Etale P.left.Etale := weilEtaleSitePullback π.left
  let B_jπ : CategoryTheory.Functor S.left.Etale Y'.Etale := weilEtaleSitePullback (j ≫ π.left)

  let pf_j := B_j.sheafPushforwardContinuous AddCommGrpCat.{u}
    P.left.smallEtaleTopology Y'.smallEtaleTopology
  let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u}
    S.left.smallEtaleTopology P.left.smallEtaleTopology
  let pf_jπ := B_jπ.sheafPushforwardContinuous AddCommGrpCat.{u}
    S.left.smallEtaleTopology Y'.smallEtaleTopology

  letI : pf_j.Additive := hAdd_pfj
  letI : CategoryTheory.Limits.PreservesFiniteLimits pf_j := ⟨fun _ _ _ => inferInstance⟩
  letI : pf_π.Additive := hAdd_pfπ
  letI : CategoryTheory.Limits.PreservesFiniteLimits pf_π := ⟨fun _ _ _ => inferInstance⟩

  let α_jπ : B_jπ ≅ B_π ⋙ B_j := CategoryTheory.MorphismProperty.Over.pullbackComp j π.left
  have _ : (B_π ⋙ B_j).IsContinuous S.left.smallEtaleTopology Y'.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp B_π B_j
      S.left.smallEtaleTopology P.left.smallEtaleTopology Y'.smallEtaleTopology
  let e_iso_jπ := CategoryTheory.Functor.sheafPushforwardContinuousIso α_jπ AddCommGrpCat.{u}
    S.left.smallEtaleTopology Y'.smallEtaleTopology
  let e_comp_jπ := CategoryTheory.Functor.sheafPushforwardContinuousComp B_π B_j AddCommGrpCat.{u}
    S.left.smallEtaleTopology P.left.smallEtaleTopology Y'.smallEtaleTopology
  let e_pf_comp : pf_j ⋙ pf_π ≅ pf_jπ := e_comp_jπ ≪≫ e_iso_jπ.symm

  
  let SyzObj : Type (u + 1) :=
    { F : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u} //
      ℓ • CategoryTheory.CategoryStruct.id F = 0 }
  let nextSyz : SyzObj → SyzObj := fun F =>
    let h := hInjPres Y' F.1 F.2
    ⟨h.choose_spec.choose_spec.choose,
      h.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.1⟩
  let Z_syr : ℕ → SyzObj :=
    Nat.rec ⟨weilEtaleTorsionSheaf Y' ℓ, hTorsSh Y'⟩ (fun _ prev => nextSyz prev)
  let Z : ℕ → CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u} :=
    fun n => (Z_syr n).1
  have hℓZ : ∀ n : ℕ, ℓ • CategoryTheory.CategoryStruct.id (Z n) = 0 :=
    fun n => (Z_syr n).2
  let I_syr : ∀ _n : ℕ, CategoryTheory.Sheaf Y'.smallEtaleTopology (ModuleCat.{u, u} R_ℓ) :=
    fun n => (hInjPres Y' (Z n) (hℓZ n)).choose
  have hInjI : ∀ n : ℕ, CategoryTheory.Injective (I_syr n) :=
    fun n => (hInjPres Y' (Z n) (hℓZ n)).choose_spec.choose
  let K_syr : ℕ → CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u} :=
    fun n => (U_sh Y').obj (I_syr n)
  let u_syr : ∀ n : ℕ, Z n ⟶ K_syr n :=
    fun n => (hInjPres Y' (Z n) (hℓZ n)).choose_spec.choose_spec.choose_spec.choose
  let v_syr : ∀ n : ℕ, K_syr n ⟶ Z (n + 1) :=
    fun n =>
      (hInjPres Y' (Z n) (hℓZ n)).choose_spec.choose_spec.choose_spec.choose_spec.choose
  have huv_syr : ∀ n : ℕ, u_syr n ≫ v_syr n = 0 :=
    fun n =>
      (hInjPres Y' (Z n) (hℓZ n)).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.choose
  let SC_Y : ∀ _n : ℕ,
      CategoryTheory.ShortComplex (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun n => CategoryTheory.ShortComplex.mk (u_syr n) (v_syr n) (huv_syr n)
  have hSE_Y : ∀ n : ℕ, (SC_Y n).ShortExact :=
