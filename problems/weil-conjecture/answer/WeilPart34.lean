          have hfst₂ : (B_h'.map g).left ≫ CategoryTheory.Limits.pullback.fst U₂.hom h' =
              CategoryTheory.Limits.pullback.fst U₁.hom h' ≫ g.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          exact (CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom
              (B_h.map (M_E.map g)).left _).trans
            ((congrArg ((hSqU U₁).isoPullback.hom ≫ ·) hfst₁).trans
              ((CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom _ g.left).symm.trans
                ((congrArg (· ≫ g.left) (hSqU U₁).isoPullback_hom_fst).trans
                  (hfst₂.symm.trans
                    ((congrArg ((B_h'.map g).left ≫ ·) (hSqU U₂).isoPullback_hom_fst.symm).trans
                      (CategoryTheory.Category.assoc (B_h'.map g).left
                        (hSqU U₂).isoPullback.hom _).symm)))))
        · have hsnd₁ : (B_h.map (M_E.map g)).left ≫
              CategoryTheory.Limits.pullback.snd (U₂.hom ≫ E.hom) h =
              CategoryTheory.Limits.pullback.snd (U₁.hom ≫ E.hom) h :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hsnd₂ : (B_h'.map g).left ≫ CategoryTheory.Limits.pullback.snd U₂.hom h' =
              CategoryTheory.Limits.pullback.snd U₁.hom h' :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          exact (CategoryTheory.Category.assoc (hSqU U₁).isoPullback.hom
              (B_h.map (M_E.map g)).left _).trans
            ((congrArg ((hSqU U₁).isoPullback.hom ≫ ·) hsnd₁).trans
              ((hSqU U₁).isoPullback_hom_snd.trans
                ((congrArg (· ≫ w') hsnd₂.symm).trans
                  ((CategoryTheory.Category.assoc (B_h'.map g).left _ w').trans
                    ((congrArg ((B_h'.map g).left ≫ ·) (hSqU U₂).isoPullback_hom_snd.symm).trans
                      (CategoryTheory.Category.assoc (B_h'.map g).left
                        (hSqU U₂).isoPullback.hom _).symm)))))
      exact (CategoryTheory.Category.id_comp (B_h.map (M_E.map g) ≫ δ_U U₂)).symm.trans
        ((congrArg (· ≫ (B_h.map (M_E.map g) ≫ δ_U U₂)) (e_δ U₁).hom_inv_id.symm).trans
          ((CategoryTheory.Category.assoc (e_δ U₁).hom (e_δ U₁).inv _).trans
            ((congrArg ((e_δ U₁).hom ≫ ·)
              ((CategoryTheory.Category.assoc (e_δ U₁).inv _ (δ_U U₂)).symm.trans
                ((congrArg (· ≫ δ_U U₂) hinv_nat).trans
                  ((CategoryTheory.Category.assoc (M_w'.map (B_h'.map g))
                    (e_δ U₂).inv (e_δ U₂).hom).trans
                    ((congrArg (M_w'.map (B_h'.map g) ≫ ·) (e_δ U₂).inv_hom_id).trans
                      (CategoryTheory.Category.comp_id _)))))))))
    let ε_sq_pre : (pf_h'.obj (res_w'.obj G₁)).obj ⟶ (res_E.obj (pf_h.obj G₁)).obj :=
      { app := fun U_op => G₁.obj.map (δ_U U_op.unop).op
        naturality := fun {U₁_op U₂_op} g_op => by
          change G₁.obj.map (M_w'.map (B_h'.map g_op.unop)).op ≫
