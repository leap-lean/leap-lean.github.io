      have hw₂ : CategoryTheory.CategoryStruct.comp f₂_left Y₂.hom = w_Z := by
        calc
          CategoryTheory.CategoryStruct.comp f₂_left Y₂.hom
              = CategoryTheory.CategoryStruct.comp f₂_left (CategoryTheory.CategoryStruct.comp g₂.left W.hom) :=
                congrArg (CategoryTheory.CategoryStruct.comp f₂_left) (CategoryTheory.MorphismProperty.Over.w g₂).symm
          _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f₂_left g₂.left) W.hom :=
                (CategoryTheory.Category.assoc f₂_left g₂.left W.hom).symm
          _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp f₁_left g₁.left) W.hom :=
                congrArg (fun k => CategoryTheory.CategoryStruct.comp k W.hom) hfg_left.symm
          _ = CategoryTheory.CategoryStruct.comp f₁_left (CategoryTheory.CategoryStruct.comp g₁.left W.hom) :=
                CategoryTheory.Category.assoc f₁_left g₁.left W.hom
          _ = w_Z := congrArg (CategoryTheory.CategoryStruct.comp f₁_left) (CategoryTheory.MorphismProperty.Over.w g₁)
