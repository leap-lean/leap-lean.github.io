    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hop_comp : ∀ {C : Type _} [CategoryTheory.Category C] {A B D : C}
      (g₁ : A ⟶ B) (g₂ : B ⟶ D),
      (g₁ ≫ g₂).op = g₂.op ≫ g₁.op := fun _ _ => rfl

  have hMemEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale)
      (R : CategoryTheory.Sieve U),
      R ∈ Z.smallEtaleTopology U ↔
        ∀ (x : ↥U.left), ∃ (Y : Z.Etale) (g : Y ⟶ U) (y : ↥Y.left),
          R.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
    intro Z U R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      Z (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) Z
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance U R
    exact (iff_of_eq
      (congrArg (fun K : CategoryTheory.GrothendieckTopology Z.Etale => R ∈ K U) heq)).trans hiff

  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  have hSerre := weil_etale_constructible_mod_prime_serre_and_local _k ℓ
  have hIdVanish :=
    (weil_etale_higherDirectImage_idVanish_isoPush_and_shortExact _k ℓ hSerre).1

  have hKillOnW : ∀ (W : AlgebraicGeometry.Scheme.{u}) (ξ : weilEtaleTorsionH W ℓ m),
      let T_W := weilEtaleIdTerminal.{u} W
      ∃ R_W ∈ W.smallEtaleTopology T_W,
        ∀ {V₁ : W.Etale} (h₁ : V₁ ⟶ T_W)
          (p_h₁ : weilEtaleTorsionH W ℓ m →+ weilEtaleTorsionH V₁.left ℓ m),
          R_W.arrows h₁ →
          WeilIsTorsionEtalePullback h₁.left ℓ m p_h₁ →
          p_h₁ ξ = 0 := by
    intro W ξ T_W
    clear hSurj
    obtain ⟨b, rfl⟩ : ∃ b : ℕ, m = b + 1 := ⟨m - 1, (Nat.sub_add_cancel hm).symm⟩
    let G_W := weilEtaleTorsionSheaf W ℓ
    let J_W := W.smallEtaleTopology
    let B_id : CategoryTheory.Functor W.Etale W.Etale :=
      weilEtaleSitePullback (CategoryTheory.CategoryStruct.id W)
    let P_W : CategoryTheory.Functor (Opposite W.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B_id.op (G_W.cohomologyPresheaf (b + 1))
    have hZeroId : CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id W) (b + 1) G_W) :=
      hIdVanish W G_W b
    have hZeroSh : CategoryTheory.Limits.IsZero (CategoryTheory.sheafify J_W P_W) :=
      (CategoryTheory.sheafToPresheaf J_W AddCommGrpCat.{u}).map_isZero hZeroId
    let η_W := CategoryTheory.toSheafify J_W P_W
    have hη_W_zero : η_W = 0 := hZeroSh.eq_of_tgt η_W 0
    obtain ⟨Θ_W, hΘ_W⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1 W ℓ (b + 1)
    let u_id : B_id.obj T_W ⟶ T_W :=
      (weilEtaleIdTerminalIsTerminal.{u} W).from (B_id.obj T_W)
    let z₀ : ↥((G_W.cohomologyPresheaf (b + 1)).obj (Opposite.op T_W)) :=
      (Θ_W T_W).symm ξ
    let t₀ : ↥(P_W.obj (Opposite.op T_W)) :=
      ((G_W.cohomologyPresheaf (b + 1)).map u_id.op).hom z₀
    have hη_app_zero : η_W.app (Opposite.op T_W) = 0 :=
      congrArg (fun ν : P_W ⟶ CategoryTheory.sheafify J_W P_W => ν.app (Opposite.op T_W))
        hη_W_zero
    have hη_eq :
        (CategoryTheory.ConcreteCategory.hom (η_W.app (Opposite.op T_W))) t₀ =
          (CategoryTheory.ConcreteCategory.hom (η_W.app (Opposite.op T_W))) 0 := by
      rw [hη_app_zero]
      simp
    let R_W : CategoryTheory.Sieve T_W :=
      CategoryTheory.Presheaf.equalizerSieve (F := P_W) (X := Opposite.op T_W) t₀ 0
    have hRW_mem : R_W ∈ J_W T_W :=
      CategoryTheory.Presheaf.equalizerSieve_mem J_W η_W t₀ 0 hη_eq
    refine ⟨R_W, hRW_mem, fun {V₁} h₁ p_h₁ hh₁_arr hp_h₁ => ?_⟩
    have ht₀_zero : (P_W.map h₁.op).hom t₀ = 0 :=
      hh₁_arr.trans (map_zero (P_W.map h₁.op).hom)
    let w₁ : B_id.obj V₁ ⟶ T_W := B_id.map h₁ ≫ u_id
    have hcomp_w₁ : (G_W.cohomologyPresheaf (b + 1)).map w₁.op =
        (G_W.cohomologyPresheaf (b + 1)).map u_id.op ≫
          (G_W.cohomologyPresheaf (b + 1)).map (B_id.map h₁).op :=
      (congrArg (G_W.cohomologyPresheaf (b + 1)).map (hop_comp (B_id.map h₁) u_id)).trans
        ((G_W.cohomologyPresheaf (b + 1)).map_comp u_id.op (B_id.map h₁).op)
    have hw₁_zero : ((G_W.cohomologyPresheaf (b + 1)).map w₁.op).hom z₀ = 0 :=
      (congrArg (fun φ => φ.hom z₀) hcomp_w₁).trans ht₀_zero
    obtain ⟨p_w₁, hp_w₁⟩ := hPullEx w₁.left ℓ (b + 1)
    have hp_w₁_zero : p_w₁ ξ = 0 :=
      (congrArg p_w₁ ((Θ_W T_W).apply_symm_apply ξ).symm).trans
        ((hΘ_W w₁ p_w₁ hp_w₁ z₀).symm.trans
          ((congrArg (Θ_W (B_id.obj V₁)) hw₁_zero).trans (map_zero (Θ_W (B_id.obj V₁)))))
    have hw₁_left : w₁.left =
        CategoryTheory.Limits.pullback.snd V₁.hom (CategoryTheory.CategoryStruct.id W) :=
      (CategoryTheory.Category.comp_id w₁.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w w₁)
    have hh₁_left : h₁.left = V₁.hom :=
      (CategoryTheory.Category.comp_id h₁.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w h₁)
    let σ_V₁ : V₁.left ⟶ (B_id.obj V₁).left :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.CategoryStruct.id V₁.left) V₁.hom
        ((CategoryTheory.Category.id_comp V₁.hom).trans
          (CategoryTheory.Category.comp_id V₁.hom).symm)
    have hσ_w₁ : σ_V₁ ≫ w₁.left = h₁.left :=
      (congrArg (σ_V₁ ≫ ·) hw₁_left).trans
        ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans hh₁_left.symm)
    obtain ⟨p_σ, hp_σ⟩ := hPullEx σ_V₁ ℓ (b + 1)
    have hp_h₁_comp : WeilIsTorsionEtalePullback (σ_V₁ ≫ w₁.left) ℓ (b + 1) p_h₁ :=
      Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ (b + 1) p_h₁) hσ_w₁.symm) hp_h₁
    have hp_h₁_eq : p_h₁ = p_σ.comp p_w₁ :=
      hPullComp σ_V₁ w₁.left ℓ (b + 1) p_σ p_w₁ p_h₁ hp_σ hp_w₁ hp_h₁_comp
    exact (congrFun (congrArg DFunLike.coe hp_h₁_eq) ξ).trans
      ((congrArg p_σ hp_w₁_zero).trans (map_zero p_σ))

  let J_S := S.smallEtaleTopology
  let G_X := weilEtaleTorsionSheaf X ℓ
  let B_f : CategoryTheory.Functor S.Etale X.Etale := weilEtaleSitePullback f
  let Q : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
    CategoryTheory.Functor.comp B_f.op (G_X.cohomologyPresheaf m)
  obtain ⟨Θ_X, hΘ_X⟩ := weil_alt_cd_etale_slice_torsionH_and_pi_vanishing.1 X ℓ m

  have hAffZero : ∀ (W₀ : S.Etale) [AlgebraicGeometry.IsAffine W₀.left]
      (s₀ : ↥(Q.obj (Opposite.op W₀))),
      ∃ R₀ ∈ J_S W₀,
        ∀ {V₀ : S.Etale} (g : V₀ ⟶ W₀), R₀.arrows g → (Q.map g.op).hom s₀ = 0 := by
    intro W₀ _ s₀
    let W : AlgebraicGeometry.Scheme.{u} := W₀.left
    let u : W ⟶ S := W₀.hom
    haveI : AlgebraicGeometry.IsAffine W := inferInstance
    haveI : AlgebraicGeometry.Etale u := W₀.prop
    let ξ' : weilEtaleTorsionH (CategoryTheory.Limits.pullback u f) ℓ m :=
      Θ_X (B_f.obj W₀) s₀
    obtain ⟨p_W, hp_W, hSurj_pW⟩ := hSurj W u
    obtain ⟨ξ, hξ⟩ := hSurj_pW ξ'
    let T_W := weilEtaleIdTerminal.{u} W
    obtain ⟨R_W, hRW_mem, hRW_kill⟩ := hKillOnW W ξ
    let R₀ : CategoryTheory.Sieve W₀ :=
      { arrows := fun {V₀} g => (Q.map g.op).hom s₀ = 0
        downward_closed := fun {V₀ V₀'} g hg k => by
          have hmap : Q.map (k ≫ g).op = Q.map g.op ≫ Q.map k.op :=
            (congrArg Q.map (hop_comp k g)).trans (Q.map_comp g.op k.op)
          exact (congrArg (fun φ => φ.hom s₀) hmap).trans
            ((congrArg (Q.map k.op).hom hg).trans (map_zero (Q.map k.op).hom)) }
    refine ⟨R₀, ?_, fun g hg => hg⟩
    rw [hMemEtale S W₀ R₀]
    intro x
    obtain ⟨V₁, h₁, y, hh₁_R, hh₁_et, hh₁_pt⟩ := (hMemEtale W T_W R_W).mp hRW_mem x
    have hv₀_et : AlgebraicGeometry.Etale (h₁.left ≫ u) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        h₁.left u hh₁_et W₀.prop
    let V₀ : S.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (h₁.left ≫ u) hv₀_et
    let g₀ : V₀ ⟶ W₀ :=
      CategoryTheory.MorphismProperty.Over.homMk h₁.left rfl
    refine ⟨V₀, g₀, y, ?_, hh₁_et, hh₁_pt⟩
    change (Q.map g₀.op).hom s₀ = 0
    have hsq : (B_f.map g₀).left ≫ CategoryTheory.Limits.pullback.fst u f =
        CategoryTheory.Limits.pullback.fst V₀.hom f ≫ h₁.left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    obtain ⟨p_Bg₀, hp_Bg₀⟩ := hPullEx (B_f.map g₀).left ℓ m
    obtain ⟨p_fstV₀, hp_fstV₀⟩ := hPullEx (CategoryTheory.Limits.pullback.fst V₀.hom f) ℓ m
    obtain ⟨p_h₁, hp_h₁⟩ := hPullEx h₁.left ℓ m
    obtain ⟨p_ψ, hp_ψ⟩ :=
      hPullEx ((B_f.map g₀).left ≫ CategoryTheory.Limits.pullback.fst u f) ℓ m
    have hp_ψ_1 : p_ψ = p_Bg₀.comp p_W :=
      hPullComp (B_f.map g₀).left (CategoryTheory.Limits.pullback.fst u f) ℓ m
        p_Bg₀ p_W p_ψ hp_Bg₀ hp_W hp_ψ
    have hp_ψ_rhs : WeilIsTorsionEtalePullback
        (CategoryTheory.Limits.pullback.fst V₀.hom f ≫ h₁.left) ℓ m p_ψ :=
      Eq.mp (congrArg (fun k => WeilIsTorsionEtalePullback k ℓ m p_ψ) hsq) hp_ψ
    have hp_ψ_2 : p_ψ = p_fstV₀.comp p_h₁ :=
      hPullComp (CategoryTheory.Limits.pullback.fst V₀.hom f) h₁.left ℓ m
        p_fstV₀ p_h₁ p_ψ hp_fstV₀ hp_h₁ hp_ψ_rhs
    have hp_h₁_ξ : p_h₁ ξ = 0 := hRW_kill h₁ p_h₁ hh₁_R hp_h₁
    have hΘ_zero : Θ_X (B_f.obj V₀) ((Q.map g₀.op).hom s₀) = 0 :=
      (hΘ_X (B_f.map g₀) p_Bg₀ hp_Bg₀ s₀).trans
        ((congrArg p_Bg₀ hξ.symm).trans
          ((congrFun (congrArg DFunLike.coe hp_ψ_1.symm) ξ).trans
            ((congrFun (congrArg DFunLike.coe hp_ψ_2) ξ).trans
              ((congrArg p_fstV₀ hp_h₁_ξ).trans (map_zero p_fstV₀)))))
    exact (Θ_X (B_f.obj V₀)).injective (hΘ_zero.trans (map_zero (Θ_X (B_f.obj V₀))).symm)

  let F_sh := (CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}).obj Q
  let η_Q := CategoryTheory.toSheafify J_S Q
  let adj_sh := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
  have hη_zero : η_Q = 0 := by
    ext U_op : 2
    apply AddCommGrpCat.ext
    intro s
    let U := Opposite.unop U_op
    have hU_et : AlgebraicGeometry.Etale U.hom := U.prop
    let R_zero : CategoryTheory.Sieve U :=
      { arrows := fun {Y} g => (Q.map g.op).hom s = 0
        downward_closed := fun {Y Z} g hg k => by
          have hmap : Q.map (k ≫ g).op = Q.map g.op ≫ Q.map k.op :=
            (congrArg Q.map (hop_comp k g)).trans (Q.map_comp g.op k.op)
          exact (congrArg (fun φ => φ.hom s) hmap).trans
            ((congrArg (Q.map k.op).hom hg).trans (map_zero (Q.map k.op).hom)) }
    have hR_mem : R_zero ∈ J_S U := by
      rw [hMemEtale S U R_zero]
      intro x
      obtain ⟨O_x, hAffO, hxO, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x) (U := (⊤ : U.left.Opens)) trivial
      have hW_et : AlgebraicGeometry.Etale (O_x.ι ≫ U.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_x.ι U.hom inferInstance hU_et
      let W_x : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ U.hom) hW_et
      haveI : AlgebraicGeometry.IsAffine W_x.left := hAffO
      let j_x : W_x ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl
      obtain ⟨R_x, hRx_mem, hRx_zero⟩ := hAffZero W_x ((Q.map j_x.op).hom s)
      obtain ⟨Y, f_y, y, hfy_R, hfy_et, hfy_pt⟩ :=
        (hMemEtale S W_x R_x).mp hRx_mem ⟨x, hxO⟩
      refine ⟨Y, f_y ≫ j_x, y, ?_, ?_, ?_⟩
      · have hmap : Q.map (f_y ≫ j_x).op = Q.map j_x.op ≫ Q.map f_y.op :=
          (congrArg Q.map (hop_comp f_y j_x)).trans (Q.map_comp j_x.op f_y.op)
        exact (congrArg (fun φ => φ.hom s) hmap).trans (hRx_zero f_y hfy_R)
      · have hOx_et : AlgebraicGeometry.Etale O_x.ι := inferInstance
        exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          f_y.left O_x.ι hfy_et hOx_et
      · change O_x.ι.base (f_y.left.base y) = x
        rw [hfy_pt]
        rfl
    exact F_sh.isSeparated U R_zero hR_mem (η_Q.app (Opposite.op U) s) 0 (fun Y g hg => by
      change (F_sh.obj.map g.op) (η_Q.app (Opposite.op U) s) = (F_sh.obj.map g.op) 0
      rw [map_zero]
      have hnat := congrArg (fun k => k s) (η_Q.naturality g.op)
      have hlhs : (Q.map g.op ≫ η_Q.app (Opposite.op Y)) s = 0 := by
        change (η_Q.app (Opposite.op Y)).hom ((Q.map g.op).hom s) = 0
        rw [hg, map_zero]
      exact hnat.symm.trans hlhs)
  have hid_zero : 𝟙 F_sh = 0 := by
    have htri : (CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}).map η_Q ≫
        adj_sh.counit.app F_sh = 𝟙 F_sh :=
      adj_sh.left_triangle_components Q
    rw [← htri, hη_zero, CategoryTheory.Functor.map_zero, CategoryTheory.Limits.zero_comp]
  rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
  exact hid_zero

theorem weil_polyP1_affine_etale_verdier_card_eq (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (δ i : ℕ) (hi : i ≤ 2 * δ)
    (V : (weilPolyP1Over k δ).left.Etale)
    [AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left] :
    let W := ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left
    Finite (weilEtaleTorsionH W ℓ i) ∧
    Finite (weilEtaleLocalTorsionH (weilPolyP1Over k δ).left ℓ V (2 * δ - i)) ∧
    Nat.card (weilEtaleTorsionH W ℓ i) =
      Nat.card (weilEtaleLocalTorsionH (weilPolyP1Over k δ).left ℓ V (2 * δ - i)) :=
by
  classical
  dsimp only
  let P_δ := weilPolyP1Over k δ
  let W := ((AlgebraicGeometry.Scheme.Etale.forget P_δ.left).obj V).left
  have hPrime : Nat.Prime ℓ := Fact.out
  have hm : 1 ≤ ℓ := hPrime.pos
  have : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have hℓ_char : ℓ ≠ ringChar k := by
    rintro rfl
    exact hℓ ringChar.Nat.cast_ringChar
  have hUnit_ℓ : IsUnit (ℓ : k) := IsUnit.mk0 (ℓ : k) hℓ
  have : NeZero (ℓ : k) := ⟨hℓ⟩
  
  have hdeg_cyc : (Polynomial.cyclotomic ℓ k).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic]
    have htot : Nat.totient ℓ = ℓ - 1 := Nat.totient_prime hPrime
    have h2 : 2 ≤ ℓ := hPrime.two_le
    have hpos : 0 < Nat.totient ℓ := by omega
    exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hpos)
  obtain ⟨z₁, hz₁_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ k) hdeg_cyc
  have hz₁_prim : IsPrimitiveRoot z₁ ℓ :=
    (Polynomial.isRoot_cyclotomic_iff (R := k) (n := ℓ)).mp hz₁_root
  have hz₁_pow : z₁ ^ ℓ = 1 := hz₁_prim.pow_eq_one
  have hz₁_ne : z₁ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hPrime.ne_zero] at hz₁_pow
    exact zero_ne_one hz₁_pow
  let u₁ : kˣ := Units.mk0 z₁ hz₁_ne
  have hu₁_prim : IsPrimitiveRoot ((u₁ : kˣ) : k) (ℓ ^ 1) := by
    simpa [u₁, pow_one] using hz₁_prim
  have hu₁_pow : u₁ ^ ℓ = 1 := by
    ext
    simpa [u₁, Units.val_pow_eq_pow_val] using hz₁_pow
  have hStep : ∀ (s : ℕ) (u : kˣ),
      IsPrimitiveRoot ((u : kˣ) : k) (ℓ ^ (s + 1)) →
      ∃ v : kˣ, IsPrimitiveRoot ((v : kˣ) : k) (ℓ ^ (s + 2)) ∧ v ^ ℓ = u := by
    intro s u hu
    let Q : Polynomial k := Polynomial.X ^ ℓ - Polynomial.C ((u : kˣ) : k)
    have hdegQ : Q.degree ≠ 0 := by
      dsimp [Q]
      rw [Polynomial.degree_X_pow_sub_C hPrime.pos ((u : kˣ) : k)]
      exact Nat.cast_ne_zero.mpr hPrime.ne_zero
    obtain ⟨w, hw_root⟩ := IsAlgClosed.exists_root Q hdegQ
    have hw_pow : w ^ ℓ = ((u : kˣ) : k) := by
      have hev : Polynomial.eval w Q = 0 := hw_root
      simp only [Q, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C, sub_eq_zero] at hev
      exact hev
    have hw_ne : w ≠ 0 := by
      intro hw0
      rw [hw0, zero_pow hPrime.ne_zero] at hw_pow
      exact u.ne_zero hw_pow.symm
    let v : kˣ := Units.mk0 w hw_ne
    have hv_pow : v ^ ℓ = u := by
      ext
      simpa [v, Units.val_pow_eq_pow_val] using hw_pow
    have hw_prim : IsPrimitiveRoot w (ℓ ^ (s + 2)) := by
      refine IsPrimitiveRoot.mk ?_ ?_
      · have hexp : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
        rw [hexp, pow_mul, hw_pow]
        exact hu.pow_eq_one
      · intro m_exp hm_exp
        have hexp2 : ℓ ^ (s + 2) = ℓ * ℓ ^ (s + 1) := by ring
        have hw_top : w ^ (ℓ ^ (s + 2)) = 1 := by
          rw [hexp2, pow_mul, hw_pow]
          exact hu.pow_eq_one
        have hord_top : orderOf w ∣ ℓ ^ (s + 2) := orderOf_dvd_of_pow_eq_one hw_top
        have hord_m : orderOf w ∣ m_exp := orderOf_dvd_of_pow_eq_one hm_exp
        obtain ⟨j, _, hord_eq⟩ := (Nat.dvd_prime_pow hPrime).mp hord_top
        by_cases hj : j ≤ s + 1
        · exfalso
          have hdvd_prev : orderOf w ∣ ℓ ^ (s + 1) := by
            rw [hord_eq]
            exact pow_dvd_pow ℓ hj
          obtain ⟨q_div, hq_div⟩ := hdvd_prev
          have hw_prev : w ^ (ℓ ^ (s + 1)) = 1 := by
            rw [hq_div, pow_mul, pow_orderOf_eq_one, one_pow]
