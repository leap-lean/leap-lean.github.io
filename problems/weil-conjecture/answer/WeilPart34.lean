        Nonempty ((CategoryTheory.Abelian.Ext W₀ SC.X₃ 0 ⧸
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp W₀ (Nat.add_zero 0)).range) ≃+
          CategoryTheory.Abelian.Ext W₀ SC.X₁ 1) := by
