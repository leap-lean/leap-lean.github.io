theorem weil_sm_pencil_bc_push_mod_prime_pbc_isIso (sys : WeilEtaleSitePullbackSys.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (g : Quiver.Hom S' S)
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
    (hPBC : WeilCanonicalModPrimePBC ℓ f)
    (hpb : CategoryTheory.IsPullback g' f' f g) :
    letI := (sys g).hCont
    letI := (sys g).hAdj
    letI := (sys g').hCont
    letI := (sys g').hAdj
    letI := (sys g').hAdd_pb
    letI := (sys g').hLim_pb
    letI := (sys g').hColim_pb
    let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    let pb_g' := (weilEtaleSitePullback g').sheafPullback
      AddCommGrpCat.{u} X.smallEtaleTopology X'.smallEtaleTopology
    let adj_g := (weilEtaleSitePullback g).sheafAdjunctionContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    ∀ (β_sys : ∀ (q : ℕ) (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        Quiver.Hom (weilEtaleHigherDirectImage f q G)
          (pf_g.obj (weilEtaleHigherDirectImage f' q (pb_g'.obj G)))),
      (∀ (q : ℕ) (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsSmPencilLerayBCPush f g f' g' hpb.w G q (β_sys q G)) →
      (∀ (q : ℕ) {G₁ G₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom G₁ G₂),
        CategoryTheory.CategoryStruct.comp (weilEtaleHigherDirectImageMap f q φ) (β_sys q G₂) =
          CategoryTheory.CategoryStruct.comp (β_sys q G₁)
            (pf_g.map (weilEtaleHigherDirectImageMap f' q (pb_g'.map φ)))) →
      (∀ (q : ℕ)
          (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
          (hSE : SC.ShortExact),
        CategoryTheory.CategoryStruct.comp (weilSmPencilLerayConnHom f SC hSE q)
            (β_sys (q + 1) SC.X₁) =
          CategoryTheory.CategoryStruct.comp (β_sys q SC.X₃)
            (pf_g.map
              (weilSmPencilLerayConnHom f' (SC.map pb_g') (hSE.map_of_exact pb_g') q))) →
      ∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        CategoryTheory.IsIso
          ((adj_g.homEquiv (weilEtaleHigherDirectImage f q F)
            (weilEtaleHigherDirectImage f' q (pb_g'.obj F))).symm (β_sys q F)) :=
by
  letI := (sys g).hCont
  letI := (sys g).hAdj
  letI := (sys g').hCont
  letI := (sys g').hAdj
  letI := (sys g').hAdd_pb
  letI := (sys g').hLim_pb
  letI := (sys g').hColim_pb
  intro pf_g pb_g' adj_g β_sys hβ_spec hβ_nat hβ_conn
  let pb_g := (weilEtaleSitePullback g).sheafPullback
    AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
  haveI : pb_g.Additive := (sys g).hAdd_pb
  haveI : CategoryTheory.Limits.PreservesFiniteLimits pb_g := (sys g).hLim_pb
  haveI : CategoryTheory.Limits.PreservesFiniteColimits pb_g := (sys g).hColim_pb
  let bc : ∀ (q : ℕ) (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      pb_g.obj (weilEtaleHigherDirectImage f q G) ⟶
        weilEtaleHigherDirectImage f' q (pb_g'.obj G) :=
    fun q G =>
      (adj_g.homEquiv (weilEtaleHigherDirectImage f q G)
        (weilEtaleHigherDirectImage f' q (pb_g'.obj G))).symm (β_sys q G)
  
  have hConnEq : ∀ {Y B : AlgebraicGeometry.Scheme.{u}} (π : Quiver.Hom Y B)
      (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q : ℕ),
      weilSmPencilLerayConnHom π SC hSE q = weilSingDevAlgBCConnHom π SC hSE q := by
    intro Y B π SC hSE q
    unfold weilSmPencilLerayConnHom weilSingDevAlgBCConnHom
    congr 2
  have hPushBridge : ∀ (q : ℕ)
      (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsSingDevAlgBCBCPush f g f' g' hpb.w G q (β_sys q G) :=
    fun q G W₀ =>
      let adj_sh := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
      let P_X := CategoryTheory.Functor.comp (weilEtaleSitePullback f).op
        (CategoryTheory.Sheaf.cohomologyPresheaf G q)
      let R_tgt := pf_g.obj (weilEtaleHigherDirectImage f' q (pb_g'.obj G))
      (congrArg (fun k => k.app (Opposite.op W₀))
        (adj_sh.homEquiv_unit P_X R_tgt (β_sys q G))).symm.trans
        ((hβ_spec q G W₀).trans (AddCommGrpCat.ext fun _ => rfl))
  have hNat : ∀ (q : ℕ) {G₁ G₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : G₁ ⟶ G₂),
      pb_g.map (weilEtaleHigherDirectImageMap f q φ) ≫ bc q G₂ =
        bc q G₁ ≫ weilEtaleHigherDirectImageMap f' q (pb_g'.map φ) := by
    intro q G₁ G₂ φ
    apply (adj_g.homEquiv _ _).injective
    dsimp only [bc]
    rw [adj_g.homEquiv_naturality_left, adj_g.homEquiv_naturality_right,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact hβ_nat q φ
  have hConnNat : ∀ (q : ℕ)
      (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}))
      (hSE : SC.ShortExact),
      pb_g.map (weilSingDevAlgBCConnHom f SC hSE q) ≫ bc (q + 1) SC.X₁ =
        bc q SC.X₃ ≫
          weilSingDevAlgBCConnHom f' (SC.map pb_g') (hSE.map_of_exact pb_g') q := by
    intro q SC hSE
    rw [← hConnEq f SC hSE q, ← hConnEq f' (SC.map pb_g') (hSE.map_of_exact pb_g') q]
    apply (adj_g.homEquiv _ _).injective
    dsimp only [bc]
    rw [adj_g.homEquiv_naturality_left, adj_g.homEquiv_naturality_right,
      Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    exact hβ_conn q SC hSE
  
  have hDegZero : ∀ (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id G = 0 →
      CategoryTheory.IsIso (bc 0 G) := by
    have hWhiskerFree : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
        {P₁ P₂ : C ⥤ Type u} {F₀ : C ⥤ AddCommGrpCat.{u}}
        (β : P₁ ⟶ P₂) (α : P₂ ⋙ AddCommGrpCat.free ⟶ F₀),
        ((AddCommGrpCat.adj.whiskerRight C).homEquiv P₁ F₀)
          (CategoryTheory.Functor.whiskerRight β AddCommGrpCat.free ≫ α) =
        β ≫ ((AddCommGrpCat.adj.whiskerRight C).homEquiv P₂ F₀) α := by
      intro C _ P₁ P₂ F₀ β α
      ext W x
      exact congrArg (fun m => m x)
        (AddCommGrpCat.adj.homEquiv_naturality_left (β.app W) (α.app W))
    have hRepLeft : ∀ {Z : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : Z.Etale}
        (v : V₂ ⟶ V₁) (M : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        (φ : weilPolyP1CohomologyRepSheaf Z V₁ ⟶ M),
        weilPolyP1CohomologyRepHomEquiv Z V₂ M
          (((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map
            (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v)
              AddCommGrpCat.free)) ≫ φ) =
          (M.obj.map v.op) (weilPolyP1CohomologyRepHomEquiv Z V₁ M φ) := by
      intro Z V₁ V₂ v M φ
      dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left, hWhiskerFree]
      exact (CategoryTheory.yonedaEquiv_naturality _ v).symm
    have hRepRight : ∀ {Z : AlgebraicGeometry.Scheme.{u}}
        {G₁ G₂ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (V : Z.Etale) (m_hom : weilPolyP1CohomologyRepSheaf Z V ⟶ G₁) (ψ : G₁ ⟶ G₂),
        weilPolyP1CohomologyRepHomEquiv Z V G₂ (m_hom ≫ ψ) =
        (ψ.hom.app (Opposite.op V)) (weilPolyP1CohomologyRepHomEquiv Z V G₁ m_hom) := by
      intro Z G₁ G₂ V m_hom ψ
      dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      let α₀ := ((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology
        AddCommGrpCat.{u}).homEquiv _ G₁) m_hom
      change CategoryTheory.yonedaEquiv
        (((AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)).homEquiv
          (CategoryTheory.yoneda.obj V) G₂.obj) (α₀ ≫ ψ.hom)) = _
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      rfl
    have hRepAdd : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
        (M : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        (ψ₁ ψ₂ : weilPolyP1CohomologyRepSheaf Z V ⟶ M),
        weilPolyP1CohomologyRepHomEquiv Z V M (ψ₁ + ψ₂) =
          weilPolyP1CohomologyRepHomEquiv Z V M ψ₁ +
            weilPolyP1CohomologyRepHomEquiv Z V M ψ₂ := by
      intro Z V M ψ₁ ψ₂
      let shAdj := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
      let P_V := CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free
      let z₀ : ↑(P_V.obj (Opposite.op V)) :=
        (AddCommGrpCat.adj.unit.app (V ⟶ V)) (𝟙 V)
      let u₀ : ↑((weilPolyP1CohomologyRepSheaf Z V).obj.obj (Opposite.op V)) :=
        ((shAdj.unit.app P_V).app (Opposite.op V)).hom z₀
      have hEval : ∀ (α : weilPolyP1CohomologyRepSheaf Z V ⟶ M),
          weilPolyP1CohomologyRepHomEquiv Z V M α =
            (α.hom.app (Opposite.op V)).hom u₀ := by
        intro α
        dsimp only [weilPolyP1CohomologyRepHomEquiv, Equiv.trans_apply]
        have h_sh := shAdj.homEquiv_unit P_V M α
        rw [h_sh]
        rfl
      rw [hEval (ψ₁ + ψ₂), hEval ψ₁, hEval ψ₂]
      rfl
    let ε_pre : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (M : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Sheaf.cohomologyPresheaf M 0 ≅ M.obj :=
      fun Z M =>
