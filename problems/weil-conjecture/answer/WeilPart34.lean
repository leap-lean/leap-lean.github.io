                    simp_rw [hχ_idem l₁ l₂ k']
                    exact hχ_rowSum l₁ l₂ k'
                  rw [this, map_one]
                · have : ∑ j : Fin m, χ l₁ l₂ k' j * χ l₁ l₂ k j = 0 :=
                    Finset.sum_eq_zero fun j _ => hχ_colOrth l₁ l₂ k' k j hkk'
                  rw [this, map_zero]
