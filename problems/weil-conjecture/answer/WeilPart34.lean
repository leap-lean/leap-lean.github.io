                refine Finset.sum_congr rfl fun i _ => by rw [hsum_zero i]
            _ = 0 := by simp
        exact hι_inj (hu_zero.trans (map_zero ι_0).symm)
      · intro y
        let u : Fin m → ∀ l₂ : I, TensorProduct R (S l₀) (S l₂) :=
