          left_triangle := by
            ext P : 2
            ext W : 2
            apply CategoryTheory.ConcreteCategory.hom_ext
            refine DFunLike.congr_fun (DFinsupp.addHom_ext' fun α => AddMonoidHom.ext fun y => ?_)
            dsimp [R_pre, j_pre_bang, j_pre_bang_obj]
            simp only [AddMonoidHom.comp_apply, DFinsupp.singleAddHom_apply,
              DFinsupp.liftAddHom_apply_single, DFinsupp.mapRange.addMonoidHom_apply,
              DFinsupp.mapRange_single]
            have hθα : CategoryTheory.CategoryStruct.comp (θ_of W.unop α)
                (α_of (sliceObj W.unop α)) = α :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
            have h_id_slice : CategoryTheory.CategoryStruct.comp (eqSliceHom hθα)
                (CategoryTheory.CategoryStruct.comp
                  (slicePre (θ_of W.unop α) (α_of (sliceObj W.unop α)))
                  (e_of (sliceObj W.unop α))) =
                CategoryTheory.CategoryStruct.id (sliceObj W.unop α) :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                ((CategoryTheory.Category.id_comp _).trans (CategoryTheory.Category.id_comp _))
                (Subsingleton.elim _ _)
            have hmap_id : (P.map (eqSliceHom hθα).op).hom
                ((P.map (slicePre (θ_of W.unop α) (α_of (sliceObj W.unop α))).op).hom
                  ((P.map (e_of (sliceObj W.unop α)).op).hom y)) = y := by
              have h1 := congrArg (fun k => (P.map k.op).hom y) h_id_slice
              have hid_op : (CategoryTheory.CategoryStruct.id (sliceObj W.unop α)).op =
                  CategoryTheory.CategoryStruct.id (Opposite.op (sliceObj W.unop α)) := rfl
              simpa only [CategoryTheory.op_comp, hid_op, P.map_comp, P.map_id,
                AddCommGrpCat.hom_comp, AddCommGrpCat.hom_id, AddMonoidHom.comp_apply,
                AddMonoidHom.id_apply] using h1
            exact (hSingleEq P hθα _).symm.trans
              (congrArg (DFinsupp.single (β := fun γ : Quiver.Hom W.unop V =>
                ↥(P.obj (Opposite.op (sliceObj W.unop γ)))) α) hmap_id)
          right_triangle := by
            ext Q : 2
            ext W₀ : 2
            apply AddCommGrpCat.ext
            intro y
            dsimp [R_pre, j_pre_bang, j_pre_bang_obj]
            simp only [DFinsupp.liftAddHom_apply_single, DFinsupp.singleAddHom_apply]
            have h_id_jv : CategoryTheory.CategoryStruct.comp (θ_of (M_gU.obj W₀.unop) (α_of W₀.unop))
                (M_gU.map (e_of W₀.unop)) =
                CategoryTheory.CategoryStruct.id (M_gU.obj W₀.unop) :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
            have hmap_comp : Q.map (M_gU.map (e_of W₀.unop)).op ≫
                Q.map (θ_of (M_gU.obj W₀.unop) (α_of W₀.unop)).op =
                𝟙 (Q.obj (Opposite.op (M_gU.obj W₀.unop))) := by
              rw [← Q.map_comp, ← CategoryTheory.op_comp, h_id_jv]
              exact Q.map_id (Opposite.op (M_gU.obj W₀.unop))
            exact congrArg (fun m => m.hom y) hmap_comp }
    have _ : j_pre_bang.PreservesMonomorphisms :=
      { preserves := fun {P₁ P₂} φ hφ => by
          have _ : CategoryTheory.Mono φ := hφ
          have h_app_mono : ∀ (W : Opposite Y'.Etale), CategoryTheory.Mono ((j_pre_bang.map φ).app W) := by
            intro W
            rw [AddCommGrpCat.mono_iff_injective]
            refine (injective_iff_map_eq_zero _).mpr ?_
            intro x hx
            ext α
            have hU_mono : CategoryTheory.Mono (φ.app (Opposite.op (sliceObj W.unop α))) :=
              (CategoryTheory.NatTrans.mono_iff_mono_app φ).mp hφ _
            have hU_inj : Function.Injective (φ.app (Opposite.op (sliceObj W.unop α))).hom :=
              (AddCommGrpCat.mono_iff_injective _).mp hU_mono
            have hxα : ((φ.app (Opposite.op (sliceObj W.unop α))).hom) (x α) = 0 := by
              have h0 := congrArg (fun z : Π₀ (γ : Quiver.Hom W.unop V),
                  ↥(P₂.obj (Opposite.op (sliceObj W.unop γ))) => z α) hx
