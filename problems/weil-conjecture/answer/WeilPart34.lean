    weil_canonical_and_projective_baseChange_models.1 k P1 hProj_P1
  let e_P_left : P_base.left ≅ P1.left := (CategoryTheory.Over.forget _).mapIso e_P
  have _ : AlgebraicGeometry.IsProper P_base.hom := by
    have _ : AlgebraicGeometry.IsProper e_P.hom.left := by
      change AlgebraicGeometry.IsProper e_P_left.hom
      infer_instance
    rw [← e_P.hom.w]
    infer_instance
  have hInt_Pbase : AlgebraicGeometry.IsIntegral P_base.left := by
    have _ : AlgebraicGeometry.IsIntegral P1.left := hInt_P1
    have hRed : AlgebraicGeometry.IsReduced P_base.left :=
      AlgebraicGeometry.isReduced_of_isOpenImmersion e_P_left.hom
    have _ : IrreducibleSpace ↥P1.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral P1.left
    have hPre : IsPreirreducible (Set.univ : Set ↥P_base.left) := by
      intro U V hU hV ⟨y₁, _, hy₁⟩ ⟨y₂, _, hy₂⟩
      have hx₁ : e_P_left.hom.base y₁ ∈ e_P_left.inv.base ⁻¹' U := by
        change (e_P_left.hom ≫ e_P_left.inv).base y₁ ∈ U
        rwa [e_P_left.hom_inv_id]
      have hx₂ : e_P_left.hom.base y₂ ∈ e_P_left.inv.base ⁻¹' V := by
        change (e_P_left.hom ≫ e_P_left.inv).base y₂ ∈ V
