      ((p : ℕ) : A) = 0 → ∃ φ : A →+* A, ∀ x : A, φ x = x ^ p := by
    intro p hp A _ hA
    refine ⟨{
      toFun := fun x => x ^ p
      map_one' := one_pow p
      map_mul' := fun x y => mul_pow x y p
      map_zero' := zero_pow hp.ne_zero
      map_add' := fun x y => ?_
