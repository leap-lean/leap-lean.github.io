  have hGenStalkCard : ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (g_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ P_base.left),
      g_K.base (⊥ : PrimeSpectrum K) ∈ U_lc →
      ∀ (H_K : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of K)).smallEtaleTopology AddCommGrpCat.{u}),
