        have heq_1 := (hPullComp (AlgebraicGeometry.Spec.map (α_Btloc.app β₁))
          (CategoryTheory.CategoryStruct.id _)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Localization.awayMap (αEsh_hom β₁) s₁)))
          (AlgebraicGeometry.Spec.map (α_Btloc.app β₁))
          (AlgebraicGeometry.Spec.map (e_Btloc_lvl β₁).hom)
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Localization.awayMap (αEsh_hom β₁) s₁)))
          (CategoryTheory.Category.comp_id _) hm_mor_eq
          (CategoryTheory.Category.comp_id _) hm_mor_eq G_E₁ b ζ₁_E₁).symm
        have heq_2 := (hPullComp (AlgebraicGeometry.Spec.map (α_Btloc.app i_β₀))
