    CategoryTheory.Iso.trans
      (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g' f))
      (CategoryTheory.Iso.trans
        (CategoryTheory.MorphismProperty.Over.pullbackCongr h_sq)
        (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))
  have hAdjS : ∀ {Q₁ Q₂ : Opposite S.Etale ⥤ AddCommGrpCat.{u}}
      {G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (u : Q₁ ⟶ Q₂)
      (g₁ : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Q₁ ⟶ G₁)
      (g₂ : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Q₂ ⟶ G₂)
      (w : G₁ ⟶ G₂),
      u ≫ (adj_S.homEquiv Q₂ G₂) g₂ = (adj_S.homEquiv Q₁ G₁) g₁ ≫ w.hom →
      (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map u ≫ g₂ =
