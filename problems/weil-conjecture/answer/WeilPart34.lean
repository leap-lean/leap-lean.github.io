      refine ⟨?_, ?_⟩
      · intro w₁ w₂ hw_eq
        have hw0 : e_at l₀ (w₁ - w₂) = 0 := by rw [map_sub, hw_eq, sub_self]
        suffices h0 : w₁ - w₂ = 0 from sub_eq_zero.mp h0
        set w := w₁ - w₂
        set u := ι_0 w
        have hu_ker : Δ_0 u = 0 := (hΔ_exact u).2 ⟨w, rfl⟩
        have hμ_zero : ∀ i : Fin m, μ₀ (u i l₀) = 0 := by
          intro i
          rw [← he_via_ι w i, hw0]
          rfl
        have hu_zero : u = 0 := by
          funext k l₂
          let C_l₂ : TensorProduct R (S l₀) (TensorProduct R (S l₀) (S l₂)) →ₐ[R]
