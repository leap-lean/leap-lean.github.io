        · funext l₁ l₂ i
          have h0 := congrArg (d_bc l₁ l₂) (congrFun (congrFun (congrFun h l₁) l₂) i)
          change d_bc l₁ l₂ (LinearMap.baseChange R' (inl_R l₁ l₂) (y i l₁) -
              ∑ j : Fin m, LinearMap.baseChange R' (mulRight_R (χ l₁ l₂ i j)) (y j l₂)) =
            d_bc l₁ l₂ 0 at h0
          rw [map_zero, map_sub, map_sum, hd_inl] at h0
          simp_rw [hd_mul] at h0
          exact h0
      let ι_hom : TensorProduct R R' ↥B →ₐ[R'] (Fin m → ∀ l : I, S' l) :=
