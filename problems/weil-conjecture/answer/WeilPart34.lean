        naturality := fun {W₁ W₂} u => by
          let u₀ := Opposite.unop u
          let W₁₀ := Opposite.unop W₁
          let W₂₀ := Opposite.unop W₂
          have h_rep_comm := hRepPullNat (B_f.map u₀) (B_f'.map (B_g.map u₀))
