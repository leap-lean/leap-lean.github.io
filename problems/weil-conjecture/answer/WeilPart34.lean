                refine Finset.sum_congr rfl fun j _ => ?_
                rw [hχ_cocycle l₀ l₁ l₂ i₀ j]
            _ = ∑ k' : Fin m,
                  ι₁₂ (χ l₀ l₁ i₀ k') * ι₂₃ (∑ j : Fin m, χ l₁ l₂ k' j * χ l₁ l₂ k j) := by
                simp_rw [Finset.sum_mul, mul_assoc, ← map_mul]
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl fun k' _ => by rw [← Finset.mul_sum, map_sum]
            _ = ∑ k' : Fin m,
