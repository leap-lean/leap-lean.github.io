            ε_sq_pre.app (Opposite.op T_W0)) :=
      (CategoryTheory.Category.id_comp (α_h.hom.app (Opposite.op (M_E.obj T_W0)))).symm.trans
        ((congrArg (· ≫ α_h.hom.app (Opposite.op (M_E.obj T_W0)))
          (@CategoryTheory.IsIso.inv_hom_id _ _ _ _
            (θ_E.hom.app (Opposite.op T_W0)) hIso_θE_app).symm).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            (congrArg ((@CategoryTheory.inv _ _ _ _
              (θ_E.hom.app (Opposite.op T_W0)) hIso_θE_app) ≫ ·) hComm_T0)))
    have hIso_MT0 : CategoryTheory.IsIso (α_h.hom.app (Opposite.op (M_E.obj T_W0))) :=
      Eq.ndrec (motive := fun k => CategoryTheory.IsIso k)
        (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _
          (@CategoryTheory.IsIso.inv_isIso _ _ _ _ _ hIso_θE_app)
          (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_αh'_T0
            (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_θw'_app hIso_ε_T0)))
        hα_MT0_eq.symm
    let e_MT0_E : M_E.obj T_W0 ≅ E :=
      { hom := CategoryTheory.MorphismProperty.Over.homMk
          (𝟙 E.left : (M_E.obj T_W0).left ⟶ E.left)
          (CategoryTheory.Category.id_comp E.hom).symm
        inv := CategoryTheory.MorphismProperty.Over.homMk
          (𝟙 E.left : E.left ⟶ (M_E.obj T_W0).left)
          ((CategoryTheory.Category.id_comp _).trans
            (CategoryTheory.Category.id_comp E.hom))
        hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)
        inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _) }
    have hIso_E : CategoryTheory.IsIso (α_h.hom.app (Opposite.op E)) :=
      (CategoryTheory.NatTrans.isIso_app_iff_of_iso α_h.hom e_MT0_E.op).mpr hIso_MT0
    exact (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).mp hIso_E

  
  
  
  have hOpenAffIso : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
      (α : ℱ₁ ⟶ ℱ₂),
      (∀ x : ↥X, ∃ (V : X.Opens) (_ : x ∈ V),
        ∀ (E : X.Etale) [AlgebraicGeometry.IsAffine E.left] (v : E.left ⟶ V.toScheme),
          AlgebraicGeometry.Etale v → v ≫ V.ι = E.hom →
          Function.Bijective (α.hom.app (Opposite.op E))) →
      CategoryTheory.IsIso α := by
    intro ℱ₁ ℱ₂ α hLoc
    let J_X := X.smallEtaleTopology
    have hChart : ∀ (D : X.Etale) (d : ↥D.left),
        ∃ (E_d : X.Etale) (g_d : E_d ⟶ D) (y_d : ↥E_d.left),
          AlgebraicGeometry.Etale g_d.left ∧
          g_d.left.base y_d = d ∧
          Function.Bijective (α.hom.app (Opposite.op E_d)) := by
      intro D d
      obtain ⟨V, hxV, hV_bij⟩ := hLoc (D.hom.base d)
