      exact ⟨AlgEquiv.ofBijective f_res hf_bij, fun _ _ _ => rfl⟩
    · intro R' _ _ _ S' ψ₁₂
      let E₁_bc : TensorProduct R R' M₁ ≃ₗ[R'] (Fin m → ∀ l : I, S' l) :=
        (TensorProduct.piRight R R' R' (fun _ : Fin m => S_prod)).trans
          (LinearEquiv.piCongrRight fun _ => TensorProduct.piRight R R' R' S)
      let Δ_bc : (Fin m → ∀ l : I, S' l) →ₗ[R']
          ∀ (l₁ l₂ : I) (_ : Fin m), TensorProduct R R' (TensorProduct R (S l₁) (S l₂)) :=
        { toFun := fun u l₁ l₂ i =>
            LinearMap.baseChange R' (inl_R l₁ l₂) (u i l₁) -
              ∑ j : Fin m, LinearMap.baseChange R' (mulRight_R (χ l₁ l₂ i j)) (u j l₂)
          map_add' := fun u v => by
            funext l₁ l₂ i
            change LinearMap.baseChange R' (inl_R l₁ l₂) (u i l₁ + v i l₁) -
                ∑ j : Fin m, LinearMap.baseChange R' (mulRight_R (χ l₁ l₂ i j)) (u j l₂ + v j l₂) =
              (LinearMap.baseChange R' (inl_R l₁ l₂) (u i l₁) -
                ∑ j : Fin m, LinearMap.baseChange R' (mulRight_R (χ l₁ l₂ i j)) (u j l₂)) +
              (LinearMap.baseChange R' (inl_R l₁ l₂) (v i l₁) -
                ∑ j : Fin m, LinearMap.baseChange R' (mulRight_R (χ l₁ l₂ i j)) (v j l₂))
            simp only [map_add, Finset.sum_add_distrib, sub_add_sub_comm]
          map_smul' := fun t u => by
            funext l₁ l₂ i
            change LinearMap.baseChange R' (inl_R l₁ l₂) (t • u i l₁) -
                ∑ j : Fin m, LinearMap.baseChange R' (mulRight_R (χ l₁ l₂ i j)) (t • u j l₂) =
              t • (LinearMap.baseChange R' (inl_R l₁ l₂) (u i l₁) -
                ∑ j : Fin m, LinearMap.baseChange R' (mulRight_R (χ l₁ l₂ i j)) (u j l₂))
            simp only [map_smul, Finset.smul_sum, smul_sub] }
      let ι_bc : TensorProduct R R' ↥B →ₗ[R'] (Fin m → ∀ l : I, S' l) :=
        E₁_bc.toLinearMap.comp (LinearMap.baseChange R' B.val.toLinearMap)
      obtain ⟨hι_tmul, hι_inj, hΔ_exact⟩ :
          (∀ (t : R') (b : ↥B) (i : Fin m) (l : I),
            ι_bc (TensorProduct.tmul R t b) i l = TensorProduct.tmul R t (b.1 i l)) ∧
          Function.Injective ι_bc ∧
          (∀ u : Fin m → ∀ l : I, S' l, Δ_bc u = 0 ↔ ∃ w : TensorProduct R R' ↥B, ι_bc w = u) :=
        hFlatBC R'
      let d_bc : ∀ l₁ l₂ : I,
          TensorProduct R R' (TensorProduct R (S l₁) (S l₂)) ≃ₗ[R']
