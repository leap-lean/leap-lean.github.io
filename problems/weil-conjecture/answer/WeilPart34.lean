        CategoryTheory.MorphismProperty.Comma.Hom.ext hfg_left (Subsingleton.elim _ _)
      have hx_eq := hx f₁_lift f₂_lift hg₁ hg₂ h_lift_eq
      let ι_Z : Quiver.Hom Z (M_h.obj Z_lift) :=
        CategoryTheory.MorphismProperty.Over.homMk (CategoryTheory.CategoryStruct.id Z.left)
