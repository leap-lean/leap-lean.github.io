        i_β₀ _ ζ_iβ₀ hZero_iβ₀_inf
    have h_lvl_β₁ : CategoryTheory.CategoryStruct.comp (α_Btloc.app β₁) (e_Btloc_lvl β₁).hom =
        CommRingCat.ofHom (Localization.awayMap (αEsh_hom β₁) s₁) := by
