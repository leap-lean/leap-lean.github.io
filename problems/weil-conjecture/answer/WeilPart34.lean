      fun ℱ => (adj_TW.homEquiv Aℤ ℱ).trans (evZ (ℱ.obj.obj (Opposite.op TW)))
    have hBij_appTW : Function.Bijective (α_h'.hom.app (Opposite.op TW)) := by
      have hfun : (α_h'.hom.app (Opposite.op TW) :
            ↥(G_W.obj.obj (Opposite.op TW)) → ↥((pf_h'.obj G_W').obj.obj (Opposite.op TW))) =
          ⇑(e_tot (pf_h'.obj G_W')) ∘
            (fun f : Fℤ_W ⟶ G_W => f ≫ α_h') ∘ ⇑(e_tot G_W).symm :=
        funext fun m => by
          let u_m := (evZ (G_W.obj.obj (Opposite.op TW))).symm m
          let f_m := (adj_TW.homEquiv Aℤ G_W).symm u_m
