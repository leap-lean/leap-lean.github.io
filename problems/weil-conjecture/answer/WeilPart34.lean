          refine TensorProduct.ext' fun r' b => ?_
          funext i l
          change algebraMap R' (S' l) r' * TensorProduct.tmul R (1 : R') (b.1 i l) =
            TensorProduct.tmul R r' (b.1 i l)
          change TensorProduct.tmul R r' (1 : S l) * TensorProduct.tmul R (1 : R') (b.1 i l) = _
