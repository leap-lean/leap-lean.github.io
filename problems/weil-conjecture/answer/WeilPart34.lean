                (φ.app (Opposite.op (sliceObj W.unop γ))).hom) x) α = 0 at h0
              rwa [DFinsupp.mapRange.addMonoidHom_apply, DFinsupp.mapRange_apply] at h0
            exact hU_inj (hxα.trans (map_zero _).symm)
          exact @CategoryTheory.NatTrans.mono_of_mono_app _ _ _ _ _ _ (j_pre_bang.map φ) h_app_mono }
    let ι_U := CategoryTheory.sheafToPresheaf U.smallEtaleTopology AddCommGrpCat.{u}
    let ι_Y' := CategoryTheory.sheafToPresheaf Y'.smallEtaleTopology AddCommGrpCat.{u}
    let a_Y' := CategoryTheory.presheafToSheaf Y'.smallEtaleTopology AddCommGrpCat.{u}
    let shAdj_Y' := CategoryTheory.sheafificationAdjunction Y'.smallEtaleTopology AddCommGrpCat.{u}
    let j_bang : CategoryTheory.Functor
        (CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.Functor.comp ι_U (CategoryTheory.Functor.comp j_pre_bang a_Y')
    have _ : j_bang.PreservesMonomorphisms := inferInstance
    let ff_sheaf_U : ∀ (ℱ 𝒢 : CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u}),
