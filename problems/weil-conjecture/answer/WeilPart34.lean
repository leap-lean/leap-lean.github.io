          have h_nat_η := η'.naturality (Opposite.op (B_g.map u₀))
          ext s
          let s₀ : CategoryTheory.Abelian.Ext
              (weilPolyP1CohomologyRepSheaf X (B_f.obj W₁₀)) F q := s
          let φ_u' : weilPolyP1CohomologyRepSheaf X' (B_f'.obj (B_g.obj W₂₀)) ⟶
              weilPolyP1CohomologyRepSheaf X' (B_f'.obj (B_g.obj W₁₀)) :=
            (CategoryTheory.presheafToSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).map
              (CategoryTheory.Functor.whiskerRight
                (CategoryTheory.yoneda.map (B_f'.map (B_g.map u₀))) AddCommGrpCat.free)
          let φ_u : weilPolyP1CohomologyRepSheaf X (B_f.obj W₂₀) ⟶
              weilPolyP1CohomologyRepSheaf X (B_f.obj W₁₀) :=
            (CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).map
              (CategoryTheory.Functor.whiskerRight
                (CategoryTheory.yoneda.map (B_f.map u₀)) AddCommGrpCat.free)
          have h_step_ext :
              (CategoryTheory.Abelian.Ext.mk₀ φ_u').comp
                ((CategoryTheory.Abelian.Ext.mk₀
                  (weilPolyP1CohomologyRepPullHom g' (B_f.obj W₁₀)
                    (B_f'.obj (B_g.obj W₁₀)) (e_fun.inv.app W₁₀))).comp
                  (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g' s₀) (Nat.zero_add q))
                (Nat.zero_add q) =
              (CategoryTheory.Abelian.Ext.mk₀
                (weilPolyP1CohomologyRepPullHom g' (B_f.obj W₂₀)
                  (B_f'.obj (B_g.obj W₂₀)) (e_fun.inv.app W₂₀))).comp
                (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g'
                  ((CategoryTheory.Abelian.Ext.mk₀ φ_u).comp s₀ (Nat.zero_add q)))
                (Nat.zero_add q) := by
            rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
                (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h_rep_comm,
              ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
              CategoryTheory.Abelian.Ext.comp_assoc _ _ _
                (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q)]
          have h_step :
              (((CategoryTheory.Sheaf.cohomologyPresheaf (pb_g'.obj F) q).map
                (Opposite.op (B_f'.map (B_g.map u₀)))).hom)
                ((CategoryTheory.Abelian.Ext.mk₀
