        intro y
        have h1 : y ∈ B' ↔ ∃ w : TensorProduct R R' ↥B, ι_hom w = y := ι_hom.mem_range
        simp_rw [h1, hι_eq]
        rw [← hδ'_iff y]
        refine ⟨fun h l₁ l₂ i => sub_eq_zero.mp (congrFun (congrFun (congrFun h l₁) l₂) i),
