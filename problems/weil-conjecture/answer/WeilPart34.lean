                  ((congrArg (fun k => (𝒢.obj.map k.op).hom (s_glob (i_x y)))
                    (h_from_y.trans h_from_x)).trans
                    (hMapComp 𝒢.obj ((L_x x).map q_x) (r_x x) (s_glob (i_x y))).symm))))
        have h_sec := h_eq1.trans h_eq2
        have h_lc := congrArg (fun s => (ψ_x x V_x s) z) h_sec
        have h_lhs := congrFun (hψ_nat x q_x ((𝒢.obj.map (r_x x).op).hom (s_glob (i_x x)))) z
        have h_rhs := congrFun (hψ_nat x q_x ((𝒢.obj.map (r_x x).op).hom (s_glob (i_x y)))) z
        dsimp only [L_x, top_x, r_x, Function.comp_apply] at h_lc h_lhs h_rhs
        rw [h_lhs, h_rhs, hψ_glob x (i_x x), hψ_glob x (i_x y)] at h_lc
        exact (π_x x).injective h_lc
      let i₀ := i_x x₀
      let O₁ : Set ↥P := ⋃ (x : ↥P) (_ : i_x x = i₀), Set.range (w_x x).base
      let O₂ : Set ↥P := ⋃ (x : ↥P) (_ : i_x x ≠ i₀), Set.range (w_x x).base
      have hO₁_open : IsOpen O₁ := isOpen_iUnion fun x => isOpen_iUnion fun _ => by
        have : AlgebraicGeometry.Etale (w_x x) := hw_x x
        exact (w_x x).isOpenMap.isOpen_range
      have hO₂_open : IsOpen O₂ := isOpen_iUnion fun x => isOpen_iUnion fun _ => by
        have : AlgebraicGeometry.Etale (w_x x) := hw_x x
        exact (w_x x).isOpenMap.isOpen_range
      have hDisj : Disjoint O₁ O₂ := by
        rw [Set.disjoint_left]
        intro p hp₁ hp₂
        simp only [O₁, O₂, Set.mem_iUnion] at hp₁ hp₂
        rcases hp₁ with ⟨x, hx_eq, hpx⟩
        rcases hp₂ with ⟨y, hy_ne, hpy⟩
        exact hy_ne ((hOverlap_idx hpx hpy).symm.trans hx_eq)
      have hCov_P : (Set.univ : Set ↥P) ⊆ O₁ ∪ O₂ := by
        intro x _
        by_cases h : i_x x = i₀
        · exact Or.inl (Set.mem_iUnion₂.mpr ⟨x, h, hx_x x⟩)
        · exact Or.inr (Set.mem_iUnion₂.mpr ⟨x, h, hx_x x⟩)
      have hNe_O₁ : ((Set.univ : Set ↥P) ∩ O₁).Nonempty :=
        ⟨x₀, trivial, Set.mem_iUnion₂.mpr ⟨x₀, rfl, hx_x x₀⟩⟩
      have hSub_O₁ : (Set.univ : Set ↥P) ⊆ O₁ :=
        IsPreconnected.subset_left_of_subset_union hO₁_open hO₂_open hDisj hCov_P hNe_O₁
          isPreconnected_univ
      have hi_all : ∀ x : ↥P, i_x x = i₀ := by
        intro x
        by_contra hne
        exact Set.disjoint_left.mp hDisj (hSub_O₁ trivial)
          (Set.mem_iUnion₂.mpr ⟨x, hne, hx_x x⟩)
      
      let e_T : T ≅ weilEtaleIdTerminal.{u} P :=
        CategoryTheory.Limits.IsTerminal.uniqueUpToIso hT (weilEtaleIdTerminalIsTerminal.{u} P)
      have hT_inj : Function.Injective T.hom.base := by
        intro t₁ t₂ ht
        have he_hom : e_T.hom.left = T.hom :=
          (CategoryTheory.Category.comp_id e_T.hom.left).symm.trans
            (CategoryTheory.MorphismProperty.Over.w e_T.hom)
        have he_id : T.hom ≫ e_T.inv.left = 𝟙 T.left :=
          he_hom ▸ congrArg (fun k => k.left) e_T.hom_inv_id
        have h1 : e_T.inv.left.base (T.hom.base t₁) = e_T.inv.left.base (T.hom.base t₂) :=
          congrArg e_T.inv.left.base ht
        have h2 : (T.hom ≫ e_T.inv.left).base t₁ = (T.hom ≫ e_T.inv.left).base t₂ :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply T.hom e_T.inv.left t₁).trans
            (h1.trans (AlgebraicGeometry.Scheme.Hom.comp_apply T.hom e_T.inv.left t₂).symm)
        exact (congrArg (fun k => k.base t₁) he_id).symm.trans
          (h2.trans (congrArg (fun k => k.base t₂) he_id))
      let S_T : CategoryTheory.Sieve T :=
        { arrows := fun {_} f =>
            (𝒢.obj.map f.op).hom (s_glob i₀) = (𝒢.obj.map f.op).hom g
          downward_closed := fun {_ _} {f} hf h =>
            (hMapComp 𝒢.obj h f (s_glob i₀)).symm.trans
              ((congrArg (𝒢.obj.map h.op).hom hf).trans (hMapComp 𝒢.obj h f g)) }
      have hST_mem : S_T ∈ P.smallEtaleTopology T := by
        rw [hMem_etale]
        intro t
        let x := T.hom.base t
        obtain ⟨u, hu⟩ := hx_x x
        have hr_arrow : S_T.arrows (r_x x) := by
          change (𝒢.obj.map (r_x x).op).hom (s_glob i₀) = (𝒢.obj.map (r_x x).op).hom g
          rw [← hi_all x, hi_x x]
        have hr_pt : (r_x x).left.base u = t := by
          apply hT_inj
          have h1 : ((r_x x).left ≫ T.hom).base u = T.hom.base ((r_x x).left.base u) :=
            AlgebraicGeometry.Scheme.Hom.comp_apply (r_x x).left T.hom u
          have h2 : (r_x x).left ≫ T.hom = w_x x :=
            (CategoryTheory.MorphismProperty.Over.w (r_x x)).trans
              (CategoryTheory.Category.id_comp (w_x x))
          exact h1.symm.trans ((congrArg (fun k => k.base u) h2).trans hu)
        exact ⟨(L_x x).obj (top_x x), r_x x, u, hr_arrow, hEtale_of_hom (r_x x), hr_pt⟩
      exact ⟨i₀, (h𝒢_sheafFor S_T hST_mem).isSeparatedFor.ext (fun _ _ hf => hf)⟩

    have hBij_s : Function.Bijective s_glob := ⟨hInj_s, hSurj_s⟩
    let e_glob : Fin (Nat.card ↥A₀) ≃ ↥(𝒢.obj.obj (Opposite.op T)) :=
      Equiv.ofBijective s_glob hBij_s
    have hFin_T : Finite ↥(𝒢.obj.obj (Opposite.op T)) :=
      Finite.of_equiv (Fin (Nat.card ↥A₀)) e_glob

    
    let adj := CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u} hT
    let M_T : AddCommGrpCat.{u} := 𝒢.obj.obj (Opposite.op T)
    let C_T := (CategoryTheory.constantSheaf P.smallEtaleTopology AddCommGrpCat.{u}).obj M_T
    let η : M_T ⟶ C_T.obj.obj (Opposite.op T) := adj.unit.app M_T
    let ε : C_T ⟶ 𝒢 := adj.counit.app 𝒢

    have hRightTri : ∀ m : ↥M_T, (ε.hom.app (Opposite.op T)).hom (η.hom m) = m := by
      intro m
      have hrt := adj.right_triangle_components 𝒢
      exact congrArg (fun k : M_T ⟶ M_T => k.hom m) hrt

    obtain ⟨Φ_P, hΦP_nat, hΦP_unit⟩ := hConstRepr P T hT M_T

    have hε_const : ∀ (Z : P.Etale) (m : ↥M_T),
        (ε.hom.app (Opposite.op Z)).hom ((Φ_P Z).symm (LocallyConstant.const ↥Z.left m)) =
          (𝒢.obj.map (hT.from Z).op).hom m := by
      intro Z m
      have hΦ_from : Φ_P Z ((C_T.obj.map (hT.from Z).op).hom (η.hom m)) =
          LocallyConstant.const ↥Z.left m := by
        refine LocallyConstant.ext fun z => ?_
        have h1 := congrFun (hΦP_nat (hT.from Z) (η.hom m)) z
        dsimp only [Function.comp_apply] at h1
        rw [h1, hΦP_unit m]
        rfl
      have hsymm : (Φ_P Z).symm (LocallyConstant.const ↥Z.left m) =
          (C_T.obj.map (hT.from Z).op).hom (η.hom m) := by
        rw [← hΦ_from, (Φ_P Z).symm_apply_apply]
      exact (congrArg (ε.hom.app (Opposite.op Z)).hom hsymm).trans
        ((hNatApp ε.hom (hT.from Z) (η.hom m)).trans
          (congrArg (𝒢.obj.map (hT.from Z).op).hom (hRightTri m)))

    have hSliceBij : ∀ (x : ↥P) (V : (W_x x).Etale),
        Function.Bijective ⇑(ε.hom.app (Opposite.op ((L_x x).obj V))).hom := by
      intro x V
      let τ_x : ↥M_T ≃ ↥A₀ := e_glob.symm.trans (π_x x)
      let mapLC : ∀ {A B : Type u}, (A ≃ B) → LocallyConstant ↥V.left A → LocallyConstant ↥V.left B :=
        fun e φ =>
          ⟨e ∘ ⇑φ, fun S => by
            rw [Set.preimage_comp]
            exact φ.isLocallyConstant (e ⁻¹' S)⟩
      have hmapLC_bij : Function.Bijective (mapLC τ_x) := by
        refine ⟨fun φ₁ φ₂ h => ?_, fun ψ => ⟨mapLC τ_x.symm ψ, ?_⟩⟩
        · refine LocallyConstant.ext fun v => τ_x.injective ?_
          exact LocallyConstant.congr_fun h v
        · exact LocallyConstant.ext fun v => τ_x.apply_symm_apply (ψ v)
      have hComp_eq : (⇑(ψ_x x V) ∘ ⇑(ε.hom.app (Opposite.op ((L_x x).obj V))).hom ∘
          ⇑(Φ_P ((L_x x).obj V)).symm) = mapLC τ_x := by
        funext φ
        refine LocallyConstant.ext fun v => ?_
        dsimp only [Function.comp_apply]
        let m : ↥M_T := φ v
        let i : Fin (Nat.card ↥A₀) := e_glob.symm m
        have hi_eq : s_glob i = m := e_glob.apply_symm_apply m
        let O_m : V.left.Opens := ⟨φ ⁻¹' {m}, φ.isLocallyConstant {m}⟩
        let V₀ : (W_x x).Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (O_m.ι ≫ V.hom)
            (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
              O_m.ι V.hom inferInstance V.prop)
        let j₀ : V₀ ⟶ V := CategoryTheory.MorphismProperty.Over.homMk O_m.ι rfl
        let u₀ : V₀ ⟶ top_x x := (weilEtaleIdTerminalIsTerminal.{u} (W_x x)).from V₀
        let v₀ : ↥V₀.left := ⟨v, rfl⟩
        have hC_res : (C_T.obj.map ((L_x x).map j₀).op).hom ((Φ_P ((L_x x).obj V)).symm φ) =
            (Φ_P ((L_x x).obj V₀)).symm (LocallyConstant.const ↥((L_x x).obj V₀).left m) := by
          apply (Φ_P ((L_x x).obj V₀)).injective
          rw [(Φ_P ((L_x x).obj V₀)).apply_symm_apply]
          refine LocallyConstant.ext fun z => ?_
          have h1 := congrFun (hΦP_nat ((L_x x).map j₀) ((Φ_P ((L_x x).obj V)).symm φ)) z
          dsimp only [Function.comp_apply] at h1
          rw [h1, (Φ_P ((L_x x).obj V)).apply_symm_apply]
          exact z.2
        have hj₀_eval : (ψ_x x V₀ ((𝒢.obj.map ((L_x x).map j₀).op).hom
            ((ε.hom.app (Opposite.op ((L_x x).obj V))).hom ((Φ_P ((L_x x).obj V)).symm φ)))) v₀ =
            (ψ_x x V ((ε.hom.app (Opposite.op ((L_x x).obj V))).hom
              ((Φ_P ((L_x x).obj V)).symm φ))) v :=
          congrFun (hψ_nat x j₀
            ((ε.hom.app (Opposite.op ((L_x x).obj V))).hom ((Φ_P ((L_x x).obj V)).symm φ))) v₀
        have h_mid : (𝒢.obj.map ((L_x x).map j₀).op).hom
            ((ε.hom.app (Opposite.op ((L_x x).obj V))).hom ((Φ_P ((L_x x).obj V)).symm φ)) =
            (𝒢.obj.map ((L_x x).map u₀).op).hom ((𝒢.obj.map (r_x x).op).hom (s_glob i)) :=
          (hNatApp ε.hom ((L_x x).map j₀) _).symm.trans
            ((congrArg (ε.hom.app (Opposite.op ((L_x x).obj V₀))).hom hC_res).trans
              ((hε_const ((L_x x).obj V₀) m).trans
                ((congrArg (𝒢.obj.map (hT.from ((L_x x).obj V₀)).op).hom hi_eq.symm).trans
                  ((congrArg (fun k => (𝒢.obj.map k.op).hom (s_glob i))
                    (hT.hom_ext (hT.from ((L_x x).obj V₀)) ((L_x x).map u₀ ≫ r_x x))).trans
                    (hMapComp 𝒢.obj ((L_x x).map u₀) (r_x x) (s_glob i)).symm))))
        have hu₀_eval := congrFun (hψ_nat x u₀ ((𝒢.obj.map (r_x x).op).hom (s_glob i))) v₀
        dsimp only [L_x, top_x, r_x, Function.comp_apply] at hj₀_eval h_mid hu₀_eval ⊢
        rw [← hj₀_eval, h_mid, hu₀_eval, hψ_glob x i]
        rfl
      rw [← hComp_eq] at hmapLC_bij
      have h1 := (Function.Bijective.of_comp_iff' (ψ_x x V).bijective _).mp hmapLC_bij
      exact (Function.Bijective.of_comp_iff _ (Φ_P ((L_x x).obj V)).symm.bijective).mp h1

    
    have hC_T_type : CategoryTheory.Presheaf.IsSheaf P.smallEtaleTopology
        (C_T.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf P.smallEtaleTopology C_T.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) C_T.property
    have hCT_sheafFor := (CategoryTheory.isSheaf_iff_isSheaf_of_type P.smallEtaleTopology
      (C_T.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp hC_T_type

    have hAllBij : ∀ U : P.Etale, Function.Bijective ⇑(ε.hom.app (Opposite.op U)).hom := by
      intro U
      let S_U : CategoryTheory.Sieve U :=
        { arrows := fun {Y} _ =>
            ∀ {Z : P.Etale} (g : Z ⟶ Y), Function.Bijective ⇑(ε.hom.app (Opposite.op Z)).hom
          downward_closed := fun {_ _} {_} hf h _ g => hf (g ≫ h) }
      have hSU_mem : S_U ∈ P.smallEtaleTopology U := by
        rw [hMem_etale]
        intro u
        let x := U.hom.base u
        obtain ⟨y, hy⟩ := hx_x x
        have : AlgebraicGeometry.Etale U.hom := U.prop
        have : AlgebraicGeometry.Etale (w_x x) := hw_x x
        let fst_x := CategoryTheory.Limits.pullback.fst U.hom (w_x x)
        let snd_x := CategoryTheory.Limits.pullback.snd U.hom (w_x x)
        let V_u : (W_x x).Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ snd_x inferInstance
        let p_u : (L_x x).obj V_u ⟶ U :=
          CategoryTheory.MorphismProperty.Over.homMk fst_x
            CategoryTheory.Limits.pullback.condition
        obtain ⟨z, hz_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u y hy.symm
        have hp_arrow : S_U.arrows p_u := by
          intro Z g
          let Z_tilde : (W_x x).Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ (g.left ≫ snd_x)
              (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
                g.left snd_x (hEtale_of_hom g) V_u.prop)
          let α_hom : Z ⟶ (L_x x).obj Z_tilde :=
            CategoryTheory.MorphismProperty.Over.homMk (𝟙 Z.left)
              ((CategoryTheory.Category.id_comp _).trans
                ((CategoryTheory.Category.assoc g.left snd_x (w_x x)).trans
                  (CategoryTheory.MorphismProperty.Over.w g)))
          let α_inv : (L_x x).obj Z_tilde ⟶ Z :=
            CategoryTheory.MorphismProperty.Over.homMk (𝟙 Z.left)
              ((CategoryTheory.Category.id_comp _).trans
                ((CategoryTheory.Category.assoc g.left snd_x (w_x x)).trans
                  (CategoryTheory.MorphismProperty.Over.w g)).symm)
          let iso_α : Z ≅ (L_x x).obj Z_tilde :=
            { hom := α_hom
              inv := α_inv
              hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext
                (CategoryTheory.Category.id_comp _)
              inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext
                (CategoryTheory.Category.id_comp _) }
          let eC := isoToAddEquiv (C_T.obj.mapIso iso_α.op)
          let eG := isoToAddEquiv (𝒢.obj.mapIso iso_α.op)
          have hbij_C : Function.Bijective ⇑(C_T.obj.map α_hom.op).hom :=
            ⟨fun a b h => eC.injective h, fun b => ⟨eC.symm b, eC.apply_symm_apply b⟩⟩
          have hbij_G : Function.Bijective ⇑(𝒢.obj.map α_hom.op).hom :=
            ⟨fun a b h => eG.injective h, fun b => ⟨eG.symm b, eG.apply_symm_apply b⟩⟩
          have hcomm_fn : (⇑(ε.hom.app (Opposite.op Z)).hom ∘ ⇑(C_T.obj.map α_hom.op).hom) =
              (⇑(𝒢.obj.map α_hom.op).hom ∘
                ⇑(ε.hom.app (Opposite.op ((L_x x).obj Z_tilde))).hom) :=
            funext fun c => hNatApp ε.hom α_hom c
          have h_rhs_bij : Function.Bijective
              (⇑(𝒢.obj.map α_hom.op).hom ∘
                ⇑(ε.hom.app (Opposite.op ((L_x x).obj Z_tilde))).hom) :=
            hbij_G.comp (hSliceBij x Z_tilde)
          rw [← hcomm_fn] at h_rhs_bij
          exact (Function.Bijective.of_comp_iff _ hbij_C).mp h_rhs_bij
        exact ⟨(L_x x).obj V_u, p_u, z, hp_arrow, hEtale_of_hom p_u, hz_fst⟩
      refine ⟨?_, ?_⟩
      · 
        intro c₁ c₂ hc
        refine (hCT_sheafFor S_U hSU_mem).isSeparatedFor.ext ?_
        intro Y f hf
        apply (hf (𝟙 Y)).1
        exact (hNatApp ε.hom f c₁).trans
          ((congrArg (𝒢.obj.map f.op).hom hc).trans (hNatApp ε.hom f c₂).symm)
      · 
        intro s
        have hex : ∀ {Y : P.Etale} (f : Y ⟶ U), S_U.arrows f →
            ∃ c : ↥(C_T.obj.obj (Opposite.op Y)),
              (ε.hom.app (Opposite.op Y)).hom c = (𝒢.obj.map f.op).hom s :=
          fun {Y} f hf => (hf (𝟙 Y)).2 ((𝒢.obj.map f.op).hom s)
        let c_fam : CategoryTheory.Presieve.FamilyOfElements
            (C_T.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) S_U.arrows :=
          fun Y f hf => Classical.choose (hex f hf)
        have hc_spec : ∀ {Y : P.Etale} (f : Y ⟶ U) (hf : S_U.arrows f),
            (ε.hom.app (Opposite.op Y)).hom (c_fam f hf) = (𝒢.obj.map f.op).hom s :=
          fun f hf => Classical.choose_spec (hex f hf)
        have hc_compat : c_fam.Compatible := by
          intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hgf
          apply (hf₁ g₁).1
          exact (hNatApp ε.hom g₁ (c_fam f₁ hf₁)).trans
            ((congrArg (𝒢.obj.map g₁.op).hom (hc_spec f₁ hf₁)).trans
              ((hMapComp 𝒢.obj g₁ f₁ s).trans
                ((congrArg (fun k => (𝒢.obj.map k.op).hom s) hgf).trans
                  ((hMapComp 𝒢.obj g₂ f₂ s).symm.trans
                    ((congrArg (𝒢.obj.map g₂.op).hom (hc_spec f₂ hf₂).symm).trans
                      (hNatApp ε.hom g₂ (c_fam f₂ hf₂)).symm)))))
        let c_top := (hCT_sheafFor S_U hSU_mem).amalgamate c_fam hc_compat
        refine ⟨c_top, (h𝒢_sheafFor S_U hSU_mem).isSeparatedFor.ext ?_⟩
        intro Y f hf
        have hglue : (C_T.obj.map f.op).hom c_top = c_fam f hf :=
          (hCT_sheafFor S_U hSU_mem).valid_glue hc_compat f hf
        exact (hNatApp ε.hom f c_top).symm.trans
          ((congrArg (ε.hom.app (Opposite.op Y)).hom hglue).trans (hc_spec f hf))

    have hIso_ε_hom : CategoryTheory.IsIso ε.hom := by
      rw [CategoryTheory.NatTrans.isIso_iff_isIso_app]
      intro U_op
      let e_U := AddEquiv.ofBijective (ε.hom.app U_op).hom (hAllBij (Opposite.unop U_op))
      refine ⟨⟨AddCommGrpCat.ofHom e_U.symm.toAddMonoidHom, ?_, ?_⟩⟩
      · apply AddCommGrpCat.ext; intro x; exact e_U.symm_apply_apply x
      · apply AddCommGrpCat.ext; intro y; exact e_U.apply_symm_apply y

    have hIso_ε : CategoryTheory.IsIso ε := by
      have : CategoryTheory.IsIso
          ((CategoryTheory.sheafToPresheaf P.smallEtaleTopology AddCommGrpCat.{u}).map ε) :=
        hIso_ε_hom
      exact CategoryTheory.isIso_of_reflects_iso ε
        (CategoryTheory.sheafToPresheaf P.smallEtaleTopology AddCommGrpCat.{u})

    exact ⟨hFin_T, hIso_ε⟩

theorem weil_projLine_sc_internal_alg_descent_and_idempotent_sections (k : Type u) [Field k]
    (P : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥P] [Nonempty ↥P]
    (u₀ u₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P)
    [AlgebraicGeometry.IsOpenImmersion u₀]
    [AlgebraicGeometry.IsOpenImmersion u₁]
    (hCovP : Set.range u₀.base ∪ Set.range u₁.base = Set.univ)
    (hPbP : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)))))
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Polynomial.aeval (IsLocalization.Away.invSelf
          (S := Localization.Away (Polynomial.X : Polynomial k))
          (Polynomial.X : Polynomial k))).toRingHom))
      u₀ u₁)
    (𝒢 : CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u})
    (A₀ : AddCommGrpCat.{u}) [Finite ↥A₀]
    (T : P.Etale) (hT : CategoryTheory.Limits.IsTerminal T)
    (hLoc : ∀ x : ↥P,
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W)
        (_ : AlgebraicGeometry.IsIntegral W)
