                (IntermediateField.inclusion (le_refl F.1))
                (AlgHom.id K₀ R_s) =
              AlgHom.id K₀ (TensorProduct K₀ ↥F.1 R_s) := by
            apply Algebra.TensorProduct.ext <;> ext x <;> rfl
          exact congrArg AlgHom.toRingHom hAlgEq
        map_comp := fun {F₁ F₂ F₃} θ₁ θ₂ => by
          apply CommRingCat.hom_ext
          have hAlgEq :
              Algebra.TensorProduct.map
                (IntermediateField.inclusion (CategoryTheory.leOfHom (θ₁ ≫ θ₂)))
                (AlgHom.id K₀ R_s) =
              (Algebra.TensorProduct.map
                (IntermediateField.inclusion (CategoryTheory.leOfHom θ₂))
                (AlgHom.id K₀ R_s)).comp
                (Algebra.TensorProduct.map
                  (IntermediateField.inclusion (CategoryTheory.leOfHom θ₁))
                  (AlgHom.id K₀ R_s)) := by
            apply Algebra.TensorProduct.ext <;> ext x <;> rfl
          exact congrArg AlgHom.toRingHom hAlgEq }
    let α : Quiver.Hom ((CategoryTheory.Functor.const ℐ).obj (CommRingCat.of R_s)) B :=
      { app := fun F => CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight :
            R_s →ₐ[K₀] TensorProduct K₀ ↥F.1 R_s).toRingHom
        naturality := fun {F₁ F₂} θ => by
          apply CommRingCat.hom_ext
          ext s
          simp [B] }
    have hPush_eq : ∀ k : K₀, ι₀ (i₀ k) = j₀ (algebraMap K₀ Ω₀ k) :=
      fun k => congrArg (fun f => f.hom k) hp₀.w
    let ι_alg : R_s →ₐ[K₀] R_Ω := { ι₀ with commutes' := hPush_eq }
    let j_F : ∀ F : ℐ, ↥F.1 →ₐ[K₀] R_Ω :=
      fun F => { j₀.comp F.1.val.toRingHom with commutes' := fun _ => rfl }
    let c : CategoryTheory.Limits.Cocone B :=
      { pt := CommRingCat.of R_Ω
        ι :=
          { app := fun F => CommRingCat.ofHom
              (Algebra.TensorProduct.productMap (j_F F) ι_alg).toRingHom
            naturality := fun {F₁ F₂} θ => by
              apply CommRingCat.hom_ext
              have hAlgEq :
                  (Algebra.TensorProduct.productMap (j_F F₂) ι_alg).comp
                    (Algebra.TensorProduct.map
                      (IntermediateField.inclusion (CategoryTheory.leOfHom θ))
                      (AlgHom.id K₀ R_s)) =
                  Algebra.TensorProduct.productMap (j_F F₁) ι_alg := by
                apply Algebra.TensorProduct.ext <;> ext x <;> rfl
              exact congrArg AlgHom.toRingHom hAlgEq } }
    let F_adj : Ω₀ → ℐ := fun x =>
      ⟨IntermediateField.adjoin K₀ {x},
        IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (R := K₀) x)⟩
    let x_adj : ∀ x : Ω₀, ↥(F_adj x).1 :=
      fun x => ⟨x, IntermediateField.mem_adjoin_simple_self K₀ x⟩
    have h_c_inl : ∀ (F : ℐ) (r : R_s),
        (c.ι.app F).hom ((1 : ↥F.1) ⊗ₜ[K₀] r) = ι₀ r := by
      intro F r
      change (Algebra.TensorProduct.productMap (j_F F) ι_alg) ((1 : ↥F.1) ⊗ₜ[K₀] r) = ι₀ r
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
      rfl
    have h_c_inr : ∀ (F : ℐ) (y : ↥F.1),
        (c.ι.app F).hom (y ⊗ₜ[K₀] (1 : R_s)) = j₀ y.1 := by
      intro F y
      change (Algebra.TensorProduct.productMap (j_F F) ι_alg) (y ⊗ₜ[K₀] (1 : R_s)) = j₀ y.1
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    have hExistsUnique : ∀ s : CategoryTheory.Limits.Cocone B,
        ∃! d : Quiver.Hom c.pt s.pt, ∀ F : ℐ, c.ι.app F ≫ d = s.ι.app F := by
      intro s
      let u_S : R_s →+* ↑s.pt := (α.app F_bot ≫ s.ι.app F_bot).hom
      have hu_S_all : ∀ (F : ℐ) (r : R_s),
          (s.ι.app F).hom ((1 : ↥F.1) ⊗ₜ[K₀] r) = u_S r := by
        intro F r
        let θ₀ : Quiver.Hom F_bot F := CategoryTheory.homOfLE (bot_le : F_bot.1 ≤ F.1)
        have hw := congrArg (fun k => k.hom ((1 : ↥F_bot.1) ⊗ₜ[K₀] r)) (s.w θ₀)
        simpa [B, u_S, α] using hw
      let v_fun : Ω₀ → ↑s.pt :=
        fun x => (s.ι.app (F_adj x)).hom ((x_adj x) ⊗ₜ[K₀] (1 : R_s))
      have hv_all : ∀ (F : ℐ) (y : ↥F.1),
          (s.ι.app F).hom (y ⊗ₜ[K₀] (1 : R_s)) = v_fun y.1 := by
        intro F y
        have hle : (F_adj y.1).1 ≤ F.1 :=
          IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr y.2)
        let θ_y : Quiver.Hom (F_adj y.1) F := CategoryTheory.homOfLE hle
        have hw := congrArg (fun k => k.hom ((x_adj y.1) ⊗ₜ[K₀] (1 : R_s))) (s.w θ_y)
        have hincl : IntermediateField.inclusion hle (x_adj y.1) = y := Subtype.ext rfl
        simpa [B, v_fun, hincl] using hw
      have hv_Ω_ex : ∃ v_Ω : Ω₀ →+* ↑s.pt, ∀ x : Ω₀, v_Ω x = v_fun x := by
        refine ⟨{
          toFun := v_fun
          map_one' := by
            have h1 : (s.ι.app F_bot).hom ((1 : ↥F_bot.1) ⊗ₜ[K₀] (1 : R_s)) = v_fun 1 :=
              hv_all F_bot 1
            rw [← h1, ← Algebra.TensorProduct.one_def, map_one]
          map_mul' := fun x y => by
            haveI : FiniteDimensional K₀ ↥(F_adj x).1 := (F_adj x).2
            haveI : FiniteDimensional K₀ ↥(F_adj y).1 := (F_adj y).2
            let F_xy : ℐ := ⟨(F_adj x).1 ⊔ (F_adj y).1,
              IntermediateField.finiteDimensional_sup _ _⟩
            let x' : ↥F_xy.1 := ⟨x, SetLike.le_def.mp le_sup_left (x_adj x).2⟩
            let y' : ↥F_xy.1 := ⟨y, SetLike.le_def.mp le_sup_right (x_adj y).2⟩
            have hxy : (s.ι.app F_xy).hom ((x' * y') ⊗ₜ[K₀] (1 : R_s)) = v_fun (x * y) :=
              hv_all F_xy (x' * y')
            have hx : (s.ι.app F_xy).hom (x' ⊗ₜ[K₀] (1 : R_s)) = v_fun x :=
              hv_all F_xy x'
            have hy : (s.ι.app F_xy).hom (y' ⊗ₜ[K₀] (1 : R_s)) = v_fun y :=
              hv_all F_xy y'
            rw [← hxy, ← hx, ← hy, ← map_mul]
            congr 1
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          map_zero' := by
            have h0 : (s.ι.app F_bot).hom ((0 : ↥F_bot.1) ⊗ₜ[K₀] (1 : R_s)) = v_fun 0 :=
              hv_all F_bot 0
            rw [← h0, TensorProduct.zero_tmul, map_zero]
          map_add' := fun x y => by
            haveI : FiniteDimensional K₀ ↥(F_adj x).1 := (F_adj x).2
            haveI : FiniteDimensional K₀ ↥(F_adj y).1 := (F_adj y).2
            let F_xy : ℐ := ⟨(F_adj x).1 ⊔ (F_adj y).1,
              IntermediateField.finiteDimensional_sup _ _⟩
            let x' : ↥F_xy.1 := ⟨x, SetLike.le_def.mp le_sup_left (x_adj x).2⟩
            let y' : ↥F_xy.1 := ⟨y, SetLike.le_def.mp le_sup_right (x_adj y).2⟩
            have hxy : (s.ι.app F_xy).hom ((x' + y') ⊗ₜ[K₀] (1 : R_s)) = v_fun (x + y) :=
              hv_all F_xy (x' + y')
            have hx : (s.ι.app F_xy).hom (x' ⊗ₜ[K₀] (1 : R_s)) = v_fun x :=
              hv_all F_xy x'
            have hy : (s.ι.app F_xy).hom (y' ⊗ₜ[K₀] (1 : R_s)) = v_fun y :=
              hv_all F_xy y'
            rw [← hxy, ← hx, ← hy, TensorProduct.add_tmul, map_add]
        }, fun _ => rfl⟩
      obtain ⟨v_Ω, hv_Ω⟩ := hv_Ω_ex
      have h_uv_comm : CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom i₀) (CommRingCat.ofHom u_S) =
          CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom (algebraMap K₀ Ω₀)) (CommRingCat.ofHom v_Ω) := by
        apply CommRingCat.hom_ext
        ext k
        change u_S (i₀ k) = v_Ω (algebraMap K₀ Ω₀ k)
        rw [hv_Ω]
        have hk_v : (s.ι.app F_bot).hom
            ((algebraMap K₀ ↥F_bot.1 k) ⊗ₜ[K₀] (1 : R_s)) =
            v_fun (algebraMap K₀ Ω₀ k) :=
          hv_all F_bot (algebraMap K₀ ↥F_bot.1 k)
        rw [← hk_v, ← hu_S_all F_bot (i₀ k)]
        congr 1
        rw [Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul,
          ← Algebra.algebraMap_eq_smul_one]
        rfl
      obtain ⟨d_mor, hd_inl_hom, hd_inr_hom⟩ :
          ∃ d_mor : Quiver.Hom (CommRingCat.of R_Ω) s.pt,
            CommRingCat.ofHom ι₀ ≫ d_mor = CommRingCat.ofHom u_S ∧
            CommRingCat.ofHom j₀ ≫ d_mor = CommRingCat.ofHom v_Ω :=
        ⟨hp₀.desc (CommRingCat.ofHom u_S) (CommRingCat.ofHom v_Ω) h_uv_comm,
          hp₀.inl_desc _ _ _, hp₀.inr_desc _ _ _⟩
      refine ⟨d_mor, ?_, ?_⟩
      · intro F
        have hd_inl : ∀ r : R_s, d_mor.hom (ι₀ r) = u_S r :=
          fun r => congrArg (fun k => k.hom r) hd_inl_hom
        have hd_inr : ∀ x : Ω₀, d_mor.hom (j₀ x) = v_fun x :=
          fun x => (congrArg (fun k => k.hom x) hd_inr_hom).trans (hv_Ω x)
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul y r =>
          have hyr : y ⊗ₜ[K₀] r = (y ⊗ₜ[K₀] (1 : R_s)) * ((1 : ↥F.1) ⊗ₜ[K₀] r) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
          rw [hyr, map_mul, map_mul, hv_all F y, hu_S_all F r]
          change d_mor.hom ((c.ι.app F).hom (y ⊗ₜ[K₀] 1)) *
              d_mor.hom ((c.ι.app F).hom (1 ⊗ₜ[K₀] r)) = _
          rw [h_c_inr F y, h_c_inl F r, hd_inr y.1, hd_inl r]
        | add z₁ z₂ h₁ h₂ =>
          rw [map_add, map_add, h₁, h₂]
      · intro m hm
        apply hp₀.hom_ext
        · rw [hd_inl_hom]
          apply CommRingCat.hom_ext
          ext r
          have hm_bot := congrArg (fun k => k.hom ((1 : ↥F_bot.1) ⊗ₜ[K₀] r)) (hm F_bot)
          change m.hom ((c.ι.app F_bot).hom (1 ⊗ₜ[K₀] r)) = _ at hm_bot
          rw [h_c_inl F_bot r] at hm_bot
          exact hm_bot
        · rw [hd_inr_hom]
          apply CommRingCat.hom_ext
          ext x
          have hm_x := congrArg
            (fun k => k.hom ((x_adj x) ⊗ₜ[K₀] (1 : R_s))) (hm (F_adj x))
          change m.hom ((c.ι.app (F_adj x)).hom ((x_adj x) ⊗ₜ[K₀] 1)) = _ at hm_x
          rw [h_c_inr (F_adj x) (x_adj x)] at hm_x
          exact hm_x.trans (hv_Ω x).symm
    let hc : CategoryTheory.Limits.IsColimit c :=
      CategoryTheory.Limits.IsColimit.ofExistsUnique hExistsUnique
    refine ⟨ℐ, inferInstance, inferInstance, B, α, c, hc, CategoryTheory.Iso.refl _, ?_, ?_⟩
    · intro F
      erw [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      apply CommRingCat.hom_ext
      ext s
      exact h_c_inl F s
    · intro F
      haveI : FiniteDimensional K₀ ↥F.1 := F.2
      haveI : IsPurelyInseparable K₀ ↥F.1 :=
        IntermediateField.isPurelyInseparable_tower_bot K₀ Ω₀ F.1
      haveI : IsPurelyInseparable.HasExponent K₀ ↥F.1 :=
        IsPurelyInseparable.hasExponent_of_finiteDimensional
      let r : ℕ := IsPurelyInseparable.exponent K₀ ↥F.1
      let c_K : ℕ := ringChar K₀
      haveI : CharP R_s c_K := (Algebra.charP_iff K₀ R_s c_K).mp inferInstance
      have hp_F := CommRingCat.isPushout_tensorProduct K₀ ↥F.1 R_s
      rcases CharP.char_is_prime_or_zero K₀ c_K with hp | hc0
      · right
        letI : Fact (Nat.Prime c_K) := ⟨hp⟩
        haveI : ExpChar K₀ c_K := expChar_prime K₀ c_K
        have hS_p : ((c_K : ℕ) : R_s) = 0 := CharP.cast_eq_zero R_s c_K
        obtain ⟨φ_S, hφ_S⟩ := hPowRingHom hp R_s hS_p
        let φ_iter : ℕ → (R_s →+* R_s) :=
          fun k => Nat.rec (RingHom.id R_s) (fun _ φ_prev => φ_S.comp φ_prev) k
        have hφ_iter : ∀ (k : ℕ) (s : R_s), φ_iter k s = s ^ (c_K ^ k) := by
          intro k
          induction k with
          | zero =>
            intro s
            simp [φ_iter]
          | succ k ih =>
            intro s
            change φ_S (φ_iter k s) = s ^ (c_K ^ (k + 1))
            rw [hφ_S, ih s, ← pow_mul, ← pow_succ]
        let τ_r : ↥F.1 →+* K₀ :=
          IsPurelyInseparable.iterateFrobenius K₀ ↥F.1 c_K (le_refl r)
        have h_comm : CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom (algebraMap K₀ ↥F.1))
            (CommRingCat.ofHom (i₀.comp τ_r)) =
            CategoryTheory.CategoryStruct.comp
              (CommRingCat.ofHom (algebraMap K₀ R_s))
              (CommRingCat.ofHom (φ_iter r)) := by
          apply CommRingCat.hom_ext
          ext a
          dsimp
          rw [IsPurelyInseparable.iterateFrobenius_algebraMap ↥F.1 c_K (le_refl r) a,
            map_pow, hAlg_S, hφ_iter r (i₀ a)]
        let ψ_mor := hp_F.desc (CommRingCat.ofHom (i₀.comp τ_r))
          (CommRingCat.ofHom (φ_iter r)) h_comm
        refine ⟨c_K, r, ψ_mor.hom, hp, hS_p, fun s => ?_⟩
        have hinr := congrArg (fun k => k.hom s) (hp_F.inr_desc _ _ h_comm)
        exact hinr.trans (hφ_iter r s)
      · left
        haveI : CharP K₀ 0 := hc0 ▸ (inferInstance : CharP K₀ c_K)
        haveI : CharZero K₀ := CharP.charP_to_charZero K₀
        haveI : ExpChar K₀ 1 := ExpChar.zero
        let τ_r : ↥F.1 →+* K₀ :=
          IsPurelyInseparable.iterateFrobenius K₀ ↥F.1 1 (le_refl r)
        have h_comm : CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom (algebraMap K₀ ↥F.1))
            (CommRingCat.ofHom (i₀.comp τ_r)) =
            CategoryTheory.CategoryStruct.comp
              (CommRingCat.ofHom (algebraMap K₀ R_s))
              (CommRingCat.ofHom (RingHom.id R_s)) := by
          apply CommRingCat.hom_ext
          ext a
          dsimp
          rw [IsPurelyInseparable.iterateFrobenius_algebraMap ↥F.1 1 (le_refl r) a,
            one_pow, pow_one, hAlg_S]
        let ψ_mor := hp_F.desc (CommRingCat.ofHom (i₀.comp τ_r))
          (CommRingCat.ofHom (RingHom.id R_s)) h_comm
        refine ⟨ψ_mor.hom, ?_⟩
        ext s
        exact congrArg (fun k => k.hom s) (hp_F.inr_desc _ _ h_comm)

  
  have hS3 : ∀ (p : ℕ), Nat.Prime p →
      ∀ (R₀ A₀ B₀ : Type u) [CommRing R₀] [CommRing A₀] [CommRing B₀],
        ((p : ℕ) : R₀) = 0 →
        ∀ (f : R₀ →+* A₀), f.Etale →
        ∀ (φ_R : R₀ →+* R₀), (∀ r : R₀, φ_R r = r ^ p) →
        ∀ (φ_A : A₀ →+* A₀), (∀ a : A₀, φ_A a = a ^ p) →
        ∀ (inl : A₀ →+* B₀) (inr : R₀ →+* B₀),
          CategoryTheory.IsPushout
            (CommRingCat.ofHom f)
            (CommRingCat.ofHom φ_R)
            (CommRingCat.ofHom inl)
            (CommRingCat.ofHom inr) →
          ∀ (μ : B₀ →+* A₀),
            μ.comp inl = φ_A →
            μ.comp inr = f →
            Function.Bijective μ := by
    intro p hp R₀ A₀ B₀ _ _ _ hR_p f hf φ_R hφ_R φ_A hφ_A inl inr hPush_rel μ hμ_inl hμ_inr
    have hB_p : ((p : ℕ) : B₀) = 0 := by
      rw [← map_natCast inr, hR_p, map_zero]
    obtain ⟨φ_B, hφ_B⟩ := hPowRingHom hp B₀ hB_p
    have h_inl_μ_hom :
        CommRingCat.ofHom (inl.comp μ) = CommRingCat.ofHom φ_B := by
      apply hPush_rel.hom_ext
      · apply CommRingCat.hom_ext
        ext a
        dsimp
        have h1 : μ (inl a) = a ^ p :=
          (congrArg (fun k => k a) hμ_inl).trans (hφ_A a)
        rw [h1, map_pow, hφ_B]
      · apply CommRingCat.hom_ext
        ext r
        dsimp
        have h1 : μ (inr r) = f r := congrArg (fun k => k r) hμ_inr
        have h2 : inl (f r) = inr (φ_R r) := congrArg (fun k => k.hom r) hPush_rel.w
        rw [h1, h2, hφ_R r, map_pow, hφ_B]
    have h_inl_μ : ∀ b : B₀, inl (μ b) = b ^ p := fun b =>
      (congrArg (fun k => k.hom b) h_inl_μ_hom).trans (hφ_B b)
    have h_μ_inl : ∀ a : A₀, μ (inl a) = a ^ p := fun a =>
      (congrArg (fun k => k a) hμ_inl).trans (hφ_A a)
    have hf_spec_et : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hf
    have hPb_spec := AlgebraicGeometry.isPullback_SpecMap_of_isPushout
      (CommRingCat.ofHom f) (CommRingCat.ofHom φ_R)
      (CommRingCat.ofHom inl) (CommRingCat.ofHom inr) hPush_rel
    have hinr_spec_et : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr)) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_spec hf_spec_et
    have hcomp_spec : CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr)) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom f) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hμ_inr]
    have hμ_spec_et : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ)) :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr))
        hinr_spec_et (hcomp_spec.symm ▸ hf_spec_et)
    have hμ_et : μ.Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale)).mp hμ_spec_et
    letI : Algebra B₀ A₀ := μ.toAlgebra
    have hAlg_BA : algebraMap B₀ A₀ = μ := rfl
    haveI : Algebra.Etale B₀ A₀ := RingHom.etale_algebraMap.mp hμ_et
    haveI : Algebra.IsIntegral B₀ A₀ := by
      refine ⟨fun a => ?_⟩
      refine ⟨Polynomial.X ^ p - Polynomial.C (inl a),
        Polynomial.monic_X_pow_sub_C (inl a) hp.ne_zero, ?_⟩
      simp [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
        hAlg_BA, h_μ_inl a]
    haveI : Module.Finite B₀ A₀ := Algebra.IsIntegral.finite
    let P_of : ∀ (q_id : Ideal B₀) [q_id.IsMaximal], Ideal A₀ :=
      fun q_id _ => Ideal.comap inl q_id
    haveI hP_prime : ∀ (q_id : Ideal B₀) [hq : q_id.IsMaximal], (P_of q_id).IsPrime :=
      fun q_id hq => by
        haveI : q_id.IsPrime := hq.isPrime
        exact Ideal.IsPrime.comap inl
    let R_loc : ∀ (q_id : Ideal B₀) [q_id.IsMaximal], Type u :=
      fun q_id _ => Localization.AtPrime q_id
    let S_loc : ∀ (q_id : Ideal B₀) [q_id.IsMaximal], Type u :=
      fun q_id _ => Localization.AtPrime (P_of q_id)
    have hqp : ∀ (q_id : Ideal B₀) [hq : q_id.IsMaximal], q_id = Ideal.comap μ (P_of q_id) := by
      intro q_id hq
      ext b
      simp only [P_of, Ideal.mem_comap]
      rw [h_inl_μ b]
      exact (hq.isPrime.pow_mem_iff_mem p hp.pos).symm
    letI instCR_R : ∀ (q_id : Ideal B₀) [q_id.IsMaximal], CommRing (R_loc q_id) :=
      fun _ _ => inferInstance
    letI instAlg_BR : ∀ (q_id : Ideal B₀) [q_id.IsMaximal], Algebra B₀ (R_loc q_id) :=
      fun _ _ => inferInstance
    letI instCR_S : ∀ (q_id : Ideal B₀) [q_id.IsMaximal], CommRing (S_loc q_id) :=
      fun _ _ => inferInstance
