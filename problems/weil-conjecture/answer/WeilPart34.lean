        rw [CategoryTheory.Category.assoc, hi_fst, ← CategoryTheory.Category.assoc, hfrobH_fst,
          CategoryTheory.Category.assoc, hfrobX_fst, hi_fst]
      · change (frobH ≫ i_bar) ≫ snd_X = (i_bar ≫ frobX) ≫ snd_X
        rw [CategoryTheory.Category.assoc, hi_snd, hfrobH_snd,
          CategoryTheory.Category.assoc, hfrobX_snd, ← CategoryTheory.Category.assoc, hi_snd]
    
    obtain ⟨hPullEx, _, hPullComp, hPullTrans, hPullFrob⟩ :=
      weil_etale_torsion_pullback_functoriality
    let p : ∀ r : ℕ,
        weilEtaleTorsionH X_bar (ℓ ^ r) (2 * m) →+ weilEtaleTorsionH H_bar (ℓ ^ r) (2 * m) :=
      fun r => Classical.choose (hPullEx i_bar (ℓ ^ r) (2 * m))
    have hp : ∀ r : ℕ, WeilIsTorsionEtalePullback i_bar (ℓ ^ r) (2 * m) (p r) :=
      fun r => Classical.choose_spec (hPullEx i_bar (ℓ ^ r) (2 * m))
    have hp_trans : ∀ r : ℕ,
        (weilEtaleTorsionTransition H_bar ℓ r (2 * m)).comp (p (r + 1)) =
          (p r).comp (weilEtaleTorsionTransition X_bar ℓ r (2 * m)) :=
      fun r => hPullTrans i_bar ℓ r (2 * m) (p (r + 1)) (p r) (hp (r + 1)) (hp r)
    have hX_frob_trans : ∀ r : ℕ,
        (weilEtaleTorsionTransition X_bar ℓ r (2 * m)).comp (M_X.frobTorsion (r + 1)) =
          (M_X.frobTorsion r).comp (weilEtaleTorsionTransition X_bar ℓ r (2 * m)) := by
      intro r
      obtain ⟨f_succ, hf_succ⟩ := hPullEx (weilGeomFrobHom F X) (ℓ ^ (r + 1)) (2 * m)
      obtain ⟨f_r, hf_r⟩ := hPullEx (weilGeomFrobHom F X) (ℓ ^ r) (2 * m)
      have heq_succ : M_X.frobTorsion (r + 1) = f_succ :=
        hPullFrob F X (ℓ ^ (r + 1)) (2 * m) (M_X.frobTorsion (r + 1)) f_succ
          (M_X.hfrobTorsion (r + 1)) hf_succ
      have heq_r : M_X.frobTorsion r = f_r :=
        hPullFrob F X (ℓ ^ r) (2 * m) (M_X.frobTorsion r) f_r
          (M_X.hfrobTorsion r) hf_r
      rw [heq_succ, heq_r]
      exact hPullTrans (weilGeomFrobHom F X) ℓ r (2 * m) f_succ f_r hf_succ hf_r
    have hp_frob : ∀ (r : ℕ) (u : weilEtaleTorsionH X_bar (ℓ ^ r) (2 * m)),
        p r ((⇑(M_X.frobTorsion r))^[1] u) = M_H.frobTorsion r (p r u) := by
      intro r u
      obtain ⟨fX, hfX⟩ := hPullEx (weilGeomFrobHom F X) (ℓ ^ r) (2 * m)
      obtain ⟨fH, hfH⟩ := hPullEx (weilGeomFrobHom F H) (ℓ ^ r) (2 * m)
      have heqX : M_X.frobTorsion r = fX :=
        hPullFrob F X (ℓ ^ r) (2 * m) (M_X.frobTorsion r) fX (M_X.hfrobTorsion r) hfX
      have heqH : M_H.frobTorsion r = fH :=
        hPullFrob F H (ℓ ^ r) (2 * m) (M_H.frobTorsion r) fH (M_H.hfrobTorsion r) hfH
      obtain ⟨q_comp, hq_comp⟩ :=
        hPullEx (CategoryTheory.CategoryStruct.comp (weilGeomFrobHom F H) i_bar) (ℓ ^ r) (2 * m)
      have hq1 : q_comp = fH.comp (p r) :=
        hPullComp (weilGeomFrobHom F H) i_bar (ℓ ^ r) (2 * m) fH (p r) q_comp hfH (hp r) hq_comp
      have hq_comp' : WeilIsTorsionEtalePullback
          (CategoryTheory.CategoryStruct.comp i_bar (weilGeomFrobHom F X)) (ℓ ^ r) (2 * m) q_comp :=
        hFrob_comm ▸ hq_comp
      have hq2 : q_comp = (p r).comp fX :=
        hPullComp i_bar (weilGeomFrobHom F X) (ℓ ^ r) (2 * m) (p r) fX q_comp (hp r) hfX hq_comp'
      change p r (M_X.frobTorsion r u) = M_H.frobTorsion r (p r u)
      rw [heqX, heqH]
      exact DFunLike.congr_fun (hq2.symm.trans hq1) u
    have hModInj : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m' j : ℕ)
        (θ : weilCupPDModH W m' j →+ weilEtaleTorsionH W m' j),
        WeilCupPDIsModComparison W m' j θ → Function.Injective θ := by
      intro W m' j θ hθ
      obtain ⟨⟨θ₀, hθ₀, hbij₀⟩, hUniq⟩ := weil_cupPD_mod_comparison_bijective_unique W m' j
      rw [hUniq θ θ₀ hθ hθ₀]
      exact hbij₀.1
    have hModEx : ∀ (W : AlgebraicGeometry.Scheme.{u}) (m' j : ℕ),
        ∃ θ : weilCupPDModH W m' j →+ weilEtaleTorsionH W m' j,
          WeilCupPDIsModComparison W m' j θ := by
      intro W m' j
      obtain ⟨⟨θ₀, hθ₀, _⟩, _⟩ := weil_cupPD_mod_comparison_bijective_unique W m' j
      exact ⟨θ₀, hθ₀⟩
    have hp_ker : ∀ (r : ℕ) (u : weilEtaleTorsionH X_bar (ℓ ^ r) (2 * m)),
        p r u = 0 → (1 : ℕ) • u = 0 := by
      intro r u hpu
      let n : ℕ := ℓ ^ r
      have hPrime : Nat.Prime ℓ := Fact.out
      have hn : 1 ≤ n := Nat.one_le_pow r ℓ hPrime.pos
      have hchar_k : CharP k (ringChar F) :=
        (RingHom.charP_iff_charP (algebraMap F k) (ringChar F)).mp inferInstance
      have hℓ_k_ne : (ℓ : k) ≠ 0 := by
        intro h0
        have hdvd : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar F) ℓ).mp h0
        rcases CharP.char_is_prime_or_zero k (ringChar F) with hp_char | hz_char
        · exact hℓ ((Nat.prime_dvd_prime_iff_eq hp_char hPrime).mp hdvd).symm
        · rw [hz_char, zero_dvd_iff] at hdvd
          exact hPrime.ne_zero hdvd
      have hn_k_ne : ((n : ℕ) : k) ≠ 0 := by
        dsimp [n]
        rw [Nat.cast_pow]
        exact pow_ne_zero r hℓ_k_ne
      have hUnit : IsUnit (n : k) := Ne.isUnit hn_k_ne
      have : NeZero n := ⟨by omega⟩
      have : NeZero (n : k) := ⟨hn_k_ne⟩
      have : IsSepClosed k := IsSepClosed.of_isAlgClosed k
      have : HasEnoughRootsOfUnity k n := IsSepClosed.hasEnoughRootsOfUnity k n
      obtain ⟨ζ_val, hPrim_val⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot k n
      let ζ : kˣ := Units.mk0 ζ_val (hPrim_val.ne_zero (by omega))
      have hPrim : IsPrimitiveRoot ((ζ : kˣ) : k) n := hPrim_val
      let d_X : ℕ := 2 * m + 1
      have hi : 2 * m ≤ 2 * d_X := by omega
      let q₂ : ℕ := 2 * d_X - 2 * m
      have hq₂ : d_X < q₂ := by omega
      have hc : 2 * m + q₂ = 2 * d_X := Nat.add_sub_of_le hi
      obtain ⟨θ_X, hθ_X, hbij_X⟩ := (weil_cupPD_mod_comparison_bijective_unique X_bar n (2 * m)).1
      let eθ_X : weilCupPDModH X_bar n (2 * m) ≃+ weilEtaleTorsionH X_bar n (2 * m) :=
        AddEquiv.ofBijective θ_X hbij_X
      let a : weilCupPDModH X_bar n (2 * m) := eθ_X.symm u
      have hθa : θ_X a = u := eθ_X.apply_symm_apply u
      have hpa : p r (θ_X a) = 0 := by rw [hθa]; exact hpu
      let U_et : X_bar.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U_bar.ι
        (inferInstance : AlgebraicGeometry.Etale U_bar.ι)
      obtain ⟨a_loc, ha_loc⟩ :=
        weil_wl_closed_compl_zero_bdry_lift hModInj hModEx i_bar hCl_bar U_bar hU_bar_eq
          n (2 * m) (p r) (hp r) θ_X hθ_X a hpa
      let U_bar_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        CategoryTheory.Over.mk (U_bar.ι ≫ X_bar_ov.hom)
      have : AlgebraicGeometry.IsAffine U_bar_ov.left := hU_bar_aff
      have : AlgebraicGeometry.LocallyOfFiniteType U_bar_ov.hom := hLFT
      have : Subsingleton (weilEtaleTorsionH (U_bar : AlgebraicGeometry.Scheme.{u}) n q₂) :=
        weil_affine_etale_cohomological_dimension k d_X n q₂ hn hUnit U_bar_ov hDimU hq₂
      obtain ⟨θ_U, _, hbij_U⟩ :=
        (weil_cupPD_mod_comparison_bijective_unique (U_bar : AlgebraicGeometry.Scheme.{u}) n q₂).1
      have hVanU : Subsingleton (weilCupPDModH (U_bar : AlgebraicGeometry.Scheme.{u}) n q₂) :=
        ⟨fun x₁ x₂ => hbij_U.1 (Subsingleton.elim (θ_U x₁) (θ_U x₂))⟩
      have : Subsingleton (CategoryTheory.Abelian.Ext.{u}
          (weilCupPDLocalFreeSheaf X_bar n U_et) (weilCupPDModUnit X_bar n) q₂) :=
        hOpenImmVanish X_bar U_bar n q₂ hVanU
      have ha_orth : ∀ b : weilCupPDModH X_bar n q₂,
          CategoryTheory.Abelian.Ext.comp a b hc = 0 := by
        intro b
        rw [← ha_loc]
        rw [CategoryTheory.Abelian.Ext.comp_assoc a_loc
          (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalCounit X_bar n U_et)) b
          (Nat.add_zero (2 * m)) (Nat.zero_add q₂) hc]
        have hkb0 : (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalCounit X_bar n U_et)).comp b
            (Nat.zero_add q₂) = 0 :=
          Subsingleton.elim _ 0
        rw [hkb0, CategoryTheory.Abelian.Ext.comp_zero]
      have hGod : WeilCupPDHasTruncatedGodement X_bar d_X n :=
        weil_cupPD_truncated_godement_complex k X_bar_ov d_X n hn hUnit hDimX_le
      obtain ⟨τ, hEff⟩ :=
        weil_cupPD_smooth_proper_trace_and_local_effacement k X_bar_ov hIntX d_X n hn hUnit ζ hPrim
      have ha0 : a = 0 :=
        weil_cupPD_verdier_left_nondegenerate_of_effacement X_bar d_X (2 * m) n hi hn τ hGod hEff
          a ha_orth
      have hu0 : u = 0 := by
        rw [← hθa, ha0, map_zero]
      rw [one_smul, hu0]
    
    obtain ⟨f_lin, hf_inj, hf_inter⟩ :=
      weil_ell_adic_model_linear_map_of_torsion_pullback F X F H ℓ 1 (2 * m) 1 (le_refl 1)
        M_X M_H p hp_trans hX_frob_trans hp_frob hp_ker
    let L := AlgebraicClosure (Padic ℓ)
    obtain ⟨g_inv, hg_inv⟩ :=
      LinearMap.exists_leftInverse_of_injective f_lin (LinearMap.ker_eq_bot.mpr hf_inj)
    let Φ_L : Module.End L (TensorProduct (Padic ℓ) L M_X.V) := LinearMap.baseChange L M_X.frob
    let Ψ_L : Module.End L (TensorProduct (Padic ℓ) L M_H.V) := LinearMap.baseChange L M_H.frob
    let f_L := LinearMap.baseChange L f_lin
    let g_L := LinearMap.baseChange L g_inv
    have hg_L : g_L ∘ₗ f_L = LinearMap.id := by
      rw [← LinearMap.baseChange_comp, hg_inv, LinearMap.baseChange_id]
    have hf_L : Function.Injective f_L := by
      intro x y hxy
      have hgx := congrArg g_L hxy
      simpa only [← LinearMap.comp_apply, hg_L, LinearMap.id_apply] using hgx
    have hInter_comp : f_lin ∘ₗ M_X.frob = M_H.frob ∘ₗ f_lin :=
      LinearMap.ext fun v => by simpa only [pow_one, LinearMap.comp_apply] using hf_inter v
    have hInter_L : f_L ∘ₗ Φ_L = Ψ_L ∘ₗ f_L := by
      rw [← LinearMap.baseChange_comp, hInter_comp, LinearMap.baseChange_comp]
    have hα_roots : α ∈ (Φ_L.charpoly).roots := by
      rw [LinearMap.charpoly_baseChange, ← Polynomial.aroots_def]
      exact hα
    have hα_isRoot : (Φ_L.charpoly).IsRoot α :=
      (Polynomial.mem_roots (LinearMap.charpoly_monic Φ_L).ne_zero).mp hα_roots
    have hα_eigen : Φ_L.HasEigenvalue α :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly Φ_L α).mpr hα_isRoot
    obtain ⟨v, hv⟩ := hα_eigen.exists_hasEigenvector
    have hw_ne : f_L v ≠ 0 := fun h0 => hv.2 (hf_L (h0.trans (map_zero f_L).symm))
    have hw_eq : Ψ_L (f_L v) = α • (f_L v) := by
      calc
        Ψ_L (f_L v) = (Ψ_L ∘ₗ f_L) v := rfl
        _ = (f_L ∘ₗ Φ_L) v := by rw [← hInter_L]
        _ = f_L (Φ_L v) := rfl
        _ = f_L (α • v) := by rw [hv.apply_eq_smul]
        _ = α • f_L v := map_smul f_L α v
    have hw_eigenvec : Ψ_L.HasEigenvector α (f_L v) :=
      ⟨Module.End.mem_eigenspace_iff.mpr hw_eq, hw_ne⟩
    have hw_eigenval : Ψ_L.HasEigenvalue α :=
      Module.End.hasEigenvalue_of_hasEigenvector hw_eigenvec
    have hw_isRoot : (Ψ_L.charpoly).IsRoot α :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly Ψ_L α).mp hw_eigenval
    have hw_roots : α ∈ (Ψ_L.charpoly).roots :=
      (Polynomial.mem_roots (LinearMap.charpoly_monic Ψ_L).ne_zero).mpr hw_isRoot
    rw [Polynomial.aroots_def, ← LinearMap.charpoly_baseChange]
    exact hw_roots

theorem weil_projLine_sc_two_chart_laurent_atlas (k : Type u) [Field k] :
    let P₁_k := weilProjectiveSpaceOver k 1
    let R₀ := Polynomial k
    let R₀₁ := Localization.Away (Polynomial.X : Polynomial k)
    let j₀ : R₀ →+* R₀₁ := algebraMap R₀ R₀₁
    let j₁ : R₀ →+* R₀₁ :=
      (Polynomial.aeval (IsLocalization.Away.invSelf (S := R₀₁) (Polynomial.X : Polynomial k))).toRingHom
    ∃ (u₀ u₁ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ P₁_k.left),
      AlgebraicGeometry.IsOpenImmersion u₀ ∧
      AlgebraicGeometry.IsOpenImmersion u₁ ∧
      u₀ ≫ P₁_k.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      u₁ ≫ P₁_k.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
      Set.range u₀.base ∪ Set.range u₁.base = Set.univ ∧
      CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₁))
        u₀ u₁ :=
by
  intro P₁_k R₀ R₀₁ j₀ j₁
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  dsimp [P₁_k, weilProjectiveSpaceOver]
  have hX₀ : (MvPolynomial.X 0 : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k 0)
  have hX₁ : (MvPolynomial.X 1 : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k 1)
  let M : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X 1 * MvPolynomial.X 0

  
  have hVarEquiv : ∀ (i j : Fin (1 + 1)), i ≠ j →
      let Xi : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X i
      let Xj : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X j
      let hXi : Xi ∈ 𝒜 1 := (MvPolynomial.mem_homogeneousSubmodule 1 Xi).mpr (MvPolynomial.isHomogeneous_X k i)
      let hXj : Xj ∈ 𝒜 1 := (MvPolynomial.mem_homogeneousSubmodule 1 Xj).mpr (MvPolynomial.isHomogeneous_X k j)
      ∃ (e : R₀ ≃+* HomogeneousLocalization.Away 𝒜 Xi),
        e.toRingHom.comp Polynomial.C =
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi)).comp (algebraMap k ↥(𝒜 0)) ∧
        e Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem hXi hXj := by
    intro i j hij Xi Xj hXi hXj
    let Ri := HomogeneousLocalization.Away 𝒜 Xi
    let φ₀ := algebraMap k ↥(𝒜 0)
    let κi : k →+* Ri := (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi)).comp φ₀
    let ti : Ri := HomogeneousLocalization.Away.isLocalizationElem hXi hXj
    let ψi : R₀ →+* Ri := Polynomial.eval₂RingHom κi ti
    let ev_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] R₀ :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = i then (1 : R₀) else Polynomial.X)
    let ev : MvPolynomial (Fin (1 + 1)) k →+* R₀ := ev_alg.toRingHom
    have hev_Xi : ev Xi = 1 := by
      change ev_alg (MvPolynomial.X i) = 1
      simp [ev_alg]
    have hev_Xj : ev Xj = Polynomial.X := by
      change ev_alg (MvPolynomial.X j) = Polynomial.X
      simp [ev_alg, hij.symm]
    have hev_unit : IsUnit (ev Xi) := hev_Xi ▸ isUnit_one
    let ev_loc : Localization.Away Xi →+* R₀ := IsLocalization.Away.lift Xi hev_unit
    let ι_loc : MvPolynomial (Fin (1 + 1)) k →+* Localization.Away Xi :=
      algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away Xi)
    let val_hom : Ri →+* Localization.Away Xi := algebraMap Ri (Localization.Away Xi)
    let φi : Ri →+* R₀ := ev_loc.comp val_hom
    have h_val_mk_spec : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • 1)),
        (HomogeneousLocalization.Away.mk 𝒜 hXi m F hF).val * ι_loc (Xi ^ m) = ι_loc F := by
      intro m F hF
      rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      exact IsLocalization.mk'_spec (M := Submonoid.powers Xi) (Localization.Away Xi) F
        ⟨Xi ^ m, _root_.pow_mem (Submonoid.mem_powers Xi) m⟩
    have h_mk : ∀ (m : ℕ) (F : MvPolynomial (Fin (1 + 1)) k) (hF : F ∈ 𝒜 (m • 1)),
        φi (HomogeneousLocalization.Away.mk 𝒜 hXi m F hF) = ev F := by
      intro m F hF
      have h1 := congrArg ev_loc (h_val_mk_spec m F hF)
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
        map_pow, hev_Xi, one_pow, mul_one] at h1
      exact h1
    have h_val_κ : ∀ c : k, (κi c).val = ι_loc (MvPolynomial.C c) := by
      intro c
      change (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi) (φ₀ c)).val =
        ι_loc (MvPolynomial.C c)
      change Localization.mk (φ₀ c).1 1 = ι_loc (MvPolynomial.C c)
      rw [Localization.mk_one_eq_algebraMap]
      rfl
    have h_ψ_C : ∀ c : k, ψi (Polynomial.C c) = κi c := by
      intro c
      dsimp [ψi]
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    have h_ψ_X : ψi Polynomial.X = ti := by
      dsimp [ψi]
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have h_left : φi.comp ψi = RingHom.id R₀ := by
      apply Polynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, RingHom.id_apply, h_ψ_C c]
        change ev_loc (val_hom (κi c)) = Polynomial.C c
        rw [HomogeneousLocalization.algebraMap_apply, h_val_κ c, IsLocalization.Away.lift_eq]
        exact ev_alg.commutes c
      · rw [RingHom.comp_apply, RingHom.id_apply, h_ψ_X]
        dsimp [ti]
        rw [HomogeneousLocalization.Away.isLocalizationElem, h_mk, pow_one, hev_Xj]
    have h_right : ∀ z : Ri, ψi (φi z) = z := by
      intro z
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hXi z
      rw [h_mk m F hF, HomogeneousLocalization.ext_iff_val]
      let θ : MvPolynomial (Fin (1 + 1)) k →+* Localization.Away Xi := val_hom.comp (ψi.comp ev)
      change θ F = (HomogeneousLocalization.Away.mk 𝒜 hXi m F hF).val
      have h_unit_m : IsUnit (ι_loc (Xi ^ m)) :=
        IsLocalization.map_units (Localization.Away Xi)
          (⟨Xi ^ m, _root_.pow_mem (Submonoid.mem_powers Xi) m⟩ : Submonoid.powers Xi)
      apply h_unit_m.mul_right_cancel
      rw [h_val_mk_spec m F hF, map_pow]
      have hθ_C : ∀ c : k, θ (MvPolynomial.C c) = ι_loc (MvPolynomial.C c) := by
        intro c
        have hev_c : ev (MvPolynomial.C c) = Polynomial.C c := ev_alg.commutes c
        change (ψi (ev (MvPolynomial.C c))).val = ι_loc (MvPolynomial.C c)
        rw [hev_c, h_ψ_C c]
        exact h_val_κ c
      have hti_spec : ti.val * ι_loc Xi = ι_loc Xj := by
        have h1 : ti.val * ι_loc (Xi ^ 1) = ι_loc (Xj ^ 1) :=
          h_val_mk_spec 1 (Xj ^ 1) _
        simpa only [pow_one] using h1
      have hθ_X : ∀ l : Fin (1 + 1), θ (MvPolynomial.X l) * ι_loc Xi = ι_loc (MvPolynomial.X l) := by
        intro l
        by_cases hl : l = i
        · subst hl
          change (ψi (ev Xi)).val * ι_loc Xi = ι_loc Xi
          rw [hev_Xi, map_one, HomogeneousLocalization.val_one, one_mul]
        · have hlj : l = j := by
            fin_cases i <;> fin_cases j <;> fin_cases l <;> simp_all
          subst hlj
          change (ψi (ev Xj)).val * ι_loc Xi = ι_loc Xj
          rw [hev_Xj, h_ψ_X]
          exact hti_spec
      have hθ_X_pow : ∀ (l : Fin (1 + 1)) (d : ℕ),
          θ (MvPolynomial.X l ^ d) * (ι_loc Xi) ^ d = ι_loc (MvPolynomial.X l ^ d) := by
        intro l d
        rw [map_pow, map_pow, ← mul_pow, hθ_X l]
      have hF' : F ∈ 𝒜 m := by simpa using hF
      have hF_hom : F.IsHomogeneous m := (MvPolynomial.mem_homogeneousSubmodule m F).mp hF'
      conv_lhs => rw [MvPolynomial.as_sum F]
      conv_rhs => rw [MvPolynomial.as_sum F]
      rw [map_sum, Finset.sum_mul, map_sum]
      refine Finset.sum_congr rfl fun s hs => ?_
      have hs_ne : F.coeff s ≠ 0 := MvPolynomial.mem_support_iff.mp hs
      have hs_deg : (Finsupp.weight 1) s = m := hF_hom hs_ne
      have hs_sum : s 0 + s 1 = m := by
        rw [← hs_deg, Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => zero_mul _)]
        simp [Fin.sum_univ_two]
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
      rw [← hs_sum, pow_add, map_mul, map_mul, map_mul, map_mul, hθ_C]
      calc
        ι_loc (MvPolynomial.C (F.coeff s)) *
            (θ (MvPolynomial.X 0 ^ s 0) * θ (MvPolynomial.X 1 ^ s 1)) *
            (ι_loc Xi ^ s 0 * ι_loc Xi ^ s 1) =
          ι_loc (MvPolynomial.C (F.coeff s)) *
            ((θ (MvPolynomial.X 0 ^ s 0) * ι_loc Xi ^ s 0) *
              (θ (MvPolynomial.X 1 ^ s 1) * ι_loc Xi ^ s 1)) := by ring
        _ = ι_loc (MvPolynomial.C (F.coeff s)) *
              (ι_loc (MvPolynomial.X 0 ^ s 0) * ι_loc (MvPolynomial.X 1 ^ s 1)) := by
          rw [hθ_X_pow 0 (s 0), hθ_X_pow 1 (s 1)]
    let e : R₀ ≃+* Ri := RingEquiv.ofRingHom ψi φi (RingHom.ext h_right) h_left
    refine ⟨e, ?_, ?_⟩
    · apply RingHom.ext
      intro c
      exact h_ψ_C c
    · exact h_ψ_X

  
  have hMulHom : ∃ (f_M : HomogeneousLocalization.Away 𝒜 M →+* R₀₁),
      (∀ c : k,
        f_M (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers M) (algebraMap k ↥(𝒜 0) c)) =
          j₀ (Polynomial.C c)) ∧
      f_M (HomogeneousLocalization.awayMap 𝒜 hX₀
        (rfl : M = MvPolynomial.X 1 * MvPolynomial.X 0)
        (HomogeneousLocalization.Away.isLocalizationElem hX₁ hX₀)) = j₀ Polynomial.X ∧
      f_M (HomogeneousLocalization.awayMap 𝒜 hX₁
        (mul_comm (MvPolynomial.X 1) (MvPolynomial.X 0) : M = MvPolynomial.X 0 * MvPolynomial.X 1)
        (HomogeneousLocalization.Away.isLocalizationElem hX₀ hX₁)) = j₁ Polynomial.X := by
    let x_inv : R₀₁ := IsLocalization.Away.invSelf (S := R₀₁) (Polynomial.X : R₀)
    have hx_mul_inv : j₀ Polynomial.X * x_inv = 1 :=
      IsLocalization.Away.mul_invSelf (S := R₀₁) (Polynomial.X : R₀)
    have hx_inv_mul : x_inv * j₀ Polynomial.X = 1 := mul_comm x_inv (j₀ Polynomial.X) ▸ hx_mul_inv
    have hX_unit : IsUnit (j₀ Polynomial.X) := ⟨⟨j₀ Polynomial.X, x_inv, hx_mul_inv, hx_inv_mul⟩, rfl⟩
    let ev_M1 : MvPolynomial (Fin (1 + 1)) k →ₐ[k] R₀₁ :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = 1 then (1 : R₀₁) else j₀ Polynomial.X)
    have hevM_X1 : ev_M1 (MvPolynomial.X 1) = 1 := by simp [ev_M1]
    have hevM_X0 : ev_M1 (MvPolynomial.X 0) = j₀ Polynomial.X := by simp [ev_M1]
    have hevM_M : ev_M1.toRingHom M = j₀ Polynomial.X := by
      change ev_M1 (MvPolynomial.X 1 * MvPolynomial.X 0) = j₀ Polynomial.X
      rw [map_mul, hevM_X1, hevM_X0, one_mul]
    have hUnit_M : IsUnit (ev_M1.toRingHom M) := hevM_M ▸ hX_unit
    let L_M1 : Localization.Away M →+* R₀₁ := IsLocalization.Away.lift M hUnit_M
    let f_M : HomogeneousLocalization.Away 𝒜 M →+* R₀₁ :=
      L_M1.comp (algebraMap (HomogeneousLocalization.Away 𝒜 M) (Localization.Away M))
    have hf_mk : ∀ {hM' : M ∈ 𝒜 (1 + 1)} (n : ℕ) (F : MvPolynomial (Fin (1 + 1)) k)
        (hF : F ∈ 𝒜 (n • (1 + 1))),
        f_M (HomogeneousLocalization.Away.mk 𝒜 hM' n F hF) * (j₀ Polynomial.X) ^ n = ev_M1 F := by
      intro hM' n F hF
      have hspec : (HomogeneousLocalization.Away.mk 𝒜 hM' n F hF).val *
          algebraMap _ (Localization.Away M) (M ^ n) =
          algebraMap _ (Localization.Away M) F := by
        rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
        exact IsLocalization.mk'_spec (M := Submonoid.powers M) (Localization.Away M) F
          ⟨M ^ n, _root_.pow_mem (Submonoid.mem_powers M) n⟩
      have h1 := congrArg L_M1 hspec
      rw [map_mul, IsLocalization.Away.lift_eq, IsLocalization.Away.lift_eq,
        map_pow, hevM_M] at h1
      exact h1
    have hf_mk1 : ∀ {hM' : M ∈ 𝒜 (1 + 1)} (F : MvPolynomial (Fin (1 + 1)) k)
        (hF : F ∈ 𝒜 (1 • (1 + 1))),
        f_M (HomogeneousLocalization.Away.mk 𝒜 hM' 1 F hF) * j₀ Polynomial.X = ev_M1 F :=
      fun F hF => by simpa only [pow_one] using hf_mk 1 F hF
    refine ⟨f_M, ?_, ?_, ?_⟩
    · intro c
      change L_M1 (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers M)
        (algebraMap k ↥(𝒜 0) c)).val = j₀ (Polynomial.C c)
      have hval : (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers M)
          (algebraMap k ↥(𝒜 0) c)).val =
          algebraMap (MvPolynomial (Fin (1 + 1)) k) (Localization.Away M) (MvPolynomial.C c) := by
        change Localization.mk (algebraMap k ↥(𝒜 0) c).1 1 = _
        rw [Localization.mk_one_eq_algebraMap]
        rfl
      rw [hval, IsLocalization.Away.lift_eq]
      exact ev_M1.commutes c
    · rw [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.awayMap_mk]
      apply hX_unit.mul_right_cancel
      rw [hf_mk1]
      simp [hevM_X0]
    · rw [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.awayMap_mk]
      apply hX_unit.mul_right_cancel
      rw [hf_mk1]
      have hj1_X : j₁ Polynomial.X = x_inv := by
        dsimp [j₁, x_inv]
        exact Polynomial.aeval_X _
      rw [hj1_X, hx_inv_mul]
      simp [hevM_X1]

  
  obtain ⟨e₁, he₁_C, he₁_X⟩ := hVarEquiv 1 0 (by decide)
  obtain ⟨e₀, he₀_C, he₀_X⟩ := hVarEquiv 0 1 (by decide)
  let away₁ := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX₁ zero_lt_one
  let away₀ := AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX₀ zero_lt_one
  let spec_e₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom)
  let spec_e₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom)
  let u₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ AlgebraicGeometry.Proj 𝒜 := spec_e₁ ≫ away₁
  let u₁ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ AlgebraicGeometry.Proj 𝒜 := spec_e₀ ≫ away₀

  have he₁_symm_comp : e₁.symm.toRingHom.comp e₁.toRingHom = RingHom.id R₀ :=
    RingHom.ext e₁.symm_apply_apply
  have he₁_comp_symm : e₁.toRingHom.comp e₁.symm.toRingHom = RingHom.id _ :=
    RingHom.ext e₁.apply_symm_apply
  have he₀_symm_comp : e₀.symm.toRingHom.comp e₀.toRingHom = RingHom.id R₀ :=
    RingHom.ext e₀.symm_apply_apply
  have he₀_comp_symm : e₀.toRingHom.comp e₀.symm.toRingHom = RingHom.id _ :=
    RingHom.ext e₀.apply_symm_apply
  letI : CategoryTheory.IsIso spec_e₁ :=
    ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.toRingHom),
      by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.toRingHom) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          he₁_symm_comp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
      by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₁.symm.toRingHom) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          he₁_comp_symm, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
  letI : CategoryTheory.IsIso spec_e₀ :=
    ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.toRingHom),
      by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.toRingHom) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          he₀_symm_comp, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
      by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀.symm.toRingHom) = _
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          he₀_comp_symm, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
  have hu₀_open : AlgebraicGeometry.IsOpenImmersion u₀ := by dsimp [u₀, away₁]; infer_instance
  have hu₁_open : AlgebraicGeometry.IsOpenImmersion u₁ := by dsimp [u₁, away₀]; infer_instance
  letI : AlgebraicGeometry.IsOpenImmersion u₀ := hu₀_open
  letI : AlgebraicGeometry.IsOpenImmersion u₁ := hu₁_open

  have hu₀_hom : u₀ ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    dsimp [u₀, away₁]
    rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX₁ zero_lt_one),
      AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp]
    dsimp [spec_e₁]
    rw [← AlgebraicGeometry.Spec.map_comp, Category.assoc,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply congrArg CommRingCat.ofHom
    apply RingHom.ext
    intro c
    have hc := congrArg e₁.symm (DFunLike.congr_fun he₁_C c)
    simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      e₁.symm_apply_apply] using hc.symm

  have hu₁_hom : u₁ ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    dsimp [u₁, away₀]
    rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX₀ zero_lt_one),
      AlgebraicGeometry.Proj.awayι_toSpecZero, ← AlgebraicGeometry.Spec.map_comp]
    dsimp [spec_e₀]
    rw [← AlgebraicGeometry.Spec.map_comp, Category.assoc,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply congrArg CommRingCat.ofHom
    apply RingHom.ext
    intro c
    have hc := congrArg e₀.symm (DFunLike.congr_fun he₀_C c)
    simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      e₀.symm_apply_apply] using hc.symm

  have hSurj₁ : Function.Surjective spec_e₁.base :=
    (TopCat.epi_iff_surjective spec_e₁.base).mp inferInstance
  have hSurj₀ : Function.Surjective spec_e₀.base :=
    (TopCat.epi_iff_surjective spec_e₀.base).mp inferInstance

  have hRange₀ : Set.range u₀.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1) : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    change Set.range (away₁.base ∘ spec_e₁.base) = _
    rw [Set.range_comp, hSurj₁.range_eq, Set.image_univ,
      ← AlgebraicGeometry.Scheme.Hom.coe_opensRange, AlgebraicGeometry.Proj.opensRange_awayι]

  have hRange₁ : Set.range u₁.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0) : Set ↥(AlgebraicGeometry.Proj 𝒜)) := by
    change Set.range (away₀.base ∘ spec_e₀.base) = _
    rw [Set.range_comp, hSurj₀.range_eq, Set.image_univ,
      ← AlgebraicGeometry.Scheme.Hom.coe_opensRange, AlgebraicGeometry.Proj.opensRange_awayι]

  have hCov : Set.range u₀.base ∪ Set.range u₁.base = Set.univ := by
    rw [hRange₀, hRange₁]
    letI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (1 + 1)) k)
        (fun _ => rfl)
    have h_adj : Algebra.adjoin ↥(𝒜 0)
        (Set.range (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) k)) = ⊤ := by
      rw [eq_top_iff]
      intro p _
      have hp : p ∈ Algebra.adjoin k
          (Set.range (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) k)) := by
        rw [MvPolynomial.adjoin_range_X]
        trivial
      have hle : Algebra.adjoin k
          (Set.range (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) k)) ≤
          (Algebra.adjoin ↥(𝒜 0)
            (Set.range (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) k))).restrictScalars k :=
        Algebra.adjoin_le Algebra.subset_adjoin
      exact hle hp
    have hTop := AlgebraicGeometry.Proj.iSup_basicOpen_eq_top' 𝒜
      (MvPolynomial.X : Fin (1 + 1) → MvPolynomial (Fin (1 + 1)) k)
      (fun i => ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k i)⟩)
      h_adj
    ext p
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    have hp : p ∈ (⨆ i : Fin (1 + 1), AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X i)) := by
      rw [hTop]
      trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hp
    obtain ⟨i, hi⟩ := hp
    fin_cases i
    · right; exact hi
    · left; exact hi

  obtain ⟨f_M, hfM_C, hfM_1, hfM_0⟩ := hMulHom
  let ρ₁ := HomogeneousLocalization.awayMap 𝒜 hX₀ (rfl : M = MvPolynomial.X 1 * MvPolynomial.X 0)
  let ρ₀ := HomogeneousLocalization.awayMap 𝒜 hX₁
    (mul_comm (MvPolynomial.X 1) (MvPolynomial.X 0) : M = MvPolynomial.X 0 * MvPolynomial.X 1)
  have h_rel₁_e : (f_M.comp ρ₁).comp e₁.toRingHom = j₀ := by
    apply Polynomial.ringHom_ext
    · intro c
      have hec := DFunLike.congr_fun he₁_C c
      simp only [RingHom.comp_apply] at hec ⊢
      rw [hec, HomogeneousLocalization.awayMap_fromZeroRingHom, hfM_C c]
    · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [he₁_X, hfM_1]
  have h_rel₁ : f_M.comp ρ₁ = j₀.comp e₁.symm.toRingHom := by
    ext z
    have h := DFunLike.congr_fun h_rel₁_e (e₁.symm z)
    simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      e₁.apply_symm_apply] using h
  have h_rel₀_e : (f_M.comp ρ₀).comp e₀.toRingHom = j₁ := by
    apply Polynomial.ringHom_ext
    · intro c
      have hec := DFunLike.congr_fun he₀_C c
      simp only [RingHom.comp_apply] at hec ⊢
      rw [hec, HomogeneousLocalization.awayMap_fromZeroRingHom, hfM_C c]
      dsimp [j₀, j₁]
      exact (Polynomial.aeval_C _ c).symm
    · simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      rw [he₀_X, hfM_0]
  have h_rel₀ : f_M.comp ρ₀ = j₁.comp e₀.symm.toRingHom := by
    ext z
    have h := DFunLike.congr_fun h_rel₀_e (e₀.symm z)
    simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe,
      e₀.apply_symm_apply] using h

  let iU := AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₀)
  let g_j₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom j₁)
  have h_comm : iU ≫ u₀ = g_j₁ ≫ u₁ := by
    have hL : iU ≫ u₀ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_M) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₁) ≫ away₁) := by
      dsimp [iU, u₀, spec_e₁]
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (j₀.comp e₁.symm.toRingHom)) ≫ away₁ = _
      rw [← h_rel₁, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
    have hR : g_j₁ ≫ u₁ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_M) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ρ₀) ≫ away₀) := by
      dsimp [g_j₁, u₁, spec_e₀]
      rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (j₁.comp e₀.symm.toRingHom)) ≫ away₀ = _
      rw [← h_rel₀, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc]
    rw [hL, hR]
    dsimp [ρ₁, ρ₀, away₁, away₀]
    rw [AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 hX₁ zero_lt_one hX₀
        (rfl : M = MvPolynomial.X 1 * MvPolynomial.X 0),
      AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 hX₀ zero_lt_one hX₁
        (mul_comm (MvPolynomial.X 1) (MvPolynomial.X 0) : M = MvPolynomial.X 0 * MvPolynomial.X 1)]

  have h_pre : (u₀.base ⁻¹' (Set.range u₁.base) : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀))) =
      (PrimeSpectrum.basicOpen (Polynomial.X : R₀) : Set (PrimeSpectrum R₀)) := by
    rw [hRange₁]
    ext q
    have hpre_away := SetLike.ext_iff.mp
      (AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hX₁ zero_lt_one hX₀ zero_lt_one)
      (spec_e₁.base q)
    let y : PrimeSpectrum (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1)) := spec_e₁.base q
    let q' : PrimeSpectrum R₀ := q
    have hy_eq : y = PrimeSpectrum.comap e₁.symm.toRingHom q' :=
      AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom e₁.symm.toRingHom) q
    have h2 : y ∈ PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem hX₁ hX₀) ↔
        q' ∈ PrimeSpectrum.basicOpen (Polynomial.X : R₀) := by
      rw [← he₁_X, hy_eq]
      change e₁.symm (e₁ Polynomial.X) ∉ q'.asIdeal ↔ Polynomial.X ∉ q'.asIdeal
      rw [e₁.symm_apply_apply]
    exact hpre_away.trans h2

  letI : AlgebraicGeometry.IsOpenImmersion iU := by dsimp [iU]; infer_instance
  have h_opens : (TopologicalSpace.Opens.map u₀.base).obj u₁.opensRange = iU.opensRange := by
    apply TopologicalSpace.Opens.ext
    change u₀.base ⁻¹' (u₁.opensRange : Set ↥(AlgebraicGeometry.Proj 𝒜)) =
      (iU.opensRange : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R₀)))
    rw [AlgebraicGeometry.Scheme.Hom.coe_opensRange, h_pre,
      AlgebraicGeometry.Scheme.Hom.coe_opensRange]
    symm
    exact PrimeSpectrum.localization_away_comap_range R₀₁ (Polynomial.X : R₀)

  have hPb : CategoryTheory.IsPullback iU g_j₁ u₀ u₁ :=
    (AlgebraicGeometry.IsOpenImmersion.isPullback g_j₁ iU u₁ u₀ h_comm h_opens).flip

  exact ⟨u₀, u₁, hu₀_open, hu₁_open, hu₀_hom, hu₁_hom, hCov, hPb⟩

theorem weil_projLine_sc_curveClGroup_deg_eq_zero (k : Type u) [Field k] [IsAlgClosed k]
    [AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left]
    (hDVR : ∀ x : { x : ↥(weilProjectiveSpaceOver k 1).left //
        IsClosed ({x} : Set ↥(weilProjectiveSpaceOver k 1).left) },
      ∃ hDom : IsDomain ↑((weilProjectiveSpaceOver k 1).left.presheaf.stalk x.1),
        @IsDiscreteValuationRing ↑((weilProjectiveSpaceOver k 1).left.presheaf.stalk x.1) _ hDom)
    (ι_P1 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      (weilProjectiveSpaceOver k 1).left)
    [AlgebraicGeometry.IsOpenImmersion ι_P1]
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ (weilProjectiveSpaceOver k 1).left)
    (hDisj : Disjoint (Set.range ι_P1.base) (Set.range s_inf.base))
    (hUniv : Set.range ι_P1.base ∪ Set.range s_inf.base = Set.univ)
    (deg_Cl : weilCurveClGroup (weilProjectiveSpaceOver k 1).left →+ ℤ)
    (hdeg : ∀ D : ({ x : ↥(weilProjectiveSpaceOver k 1).left //
        IsClosed ({x} : Set ↥(weilProjectiveSpaceOver k 1).left) } →₀ ℤ),
      deg_Cl (QuotientAddGroup.mk'
        (weilCurvePrincipalSubgroup (weilProjectiveSpaceOver k 1).left) D) =
        D.sum (fun _ n => n)) :
    ∀ c : weilCurveClGroup (weilProjectiveSpaceOver k 1).left, deg_Cl c = 0 → c = 0 :=
by
  classical
  let X := (weilProjectiveSpaceOver k 1).left
  let Pt := { x : ↥X // IsClosed ({x} : Set ↥X) }
  let U : X.Opens := ι_P1.opensRange
  have hAffU : AlgebraicGeometry.IsAffineOpen U := AlgebraicGeometry.isAffineOpen_opensRange ι_P1
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := default
  let p_inf : ↥X := s_inf.base pt₀
  have hrange_inf : Set.range s_inf.base = ({p_inf} : Set ↥X) := by
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff]
    refine ⟨?_, fun hz => ⟨pt₀, hz.symm⟩⟩
    rintro ⟨w, rfl⟩
    rw [Subsingleton.elim w pt₀]
  have hU_coe : (U : Set ↥X) = Set.range ι_P1.base := ι_P1.coe_opensRange
  have hcompl_U : ((U : Set ↥X))ᶜ = ({p_inf} : Set ↥X) := by
    rw [hU_coe, ← hrange_inf]
    ext z
    simp only [Set.mem_compl_iff]
    refine ⟨fun hz => ?_, fun hz => Set.disjoint_right.mp hDisj hz⟩
    have hmem : z ∈ Set.range ι_P1.base ∪ Set.range s_inf.base := by
      rw [hUniv]
      trivial
    exact hmem.resolve_left hz
  have hClosed_inf : IsClosed ({p_inf} : Set ↥X) := by
    rw [← hcompl_U]
    exact U.isOpen.isClosed_compl
  let x_inf : Pt := ⟨p_inf, hClosed_inf⟩
  have hPart : ∀ x : Pt, x = x_inf ∨ x.1 ∈ U := by
    intro x
    by_cases hx : x = x_inf
    · exact Or.inl hx
    · right
      have hx1 : x.1 ≠ p_inf := fun h => hx (Subtype.ext h)
      have hnot : x.1 ∉ ((U : Set ↥X))ᶜ := by
        rw [hcompl_U, Set.mem_singleton_iff]
        exact hx1
      rw [Set.mem_compl_iff, not_not] at hnot
      exact hnot
  let S := ↑(X.presheaf.obj (Opposite.op U))
  let iso_S : X.presheaf.obj (Opposite.op U) ≅ CommRingCat.of (Polynomial k) :=
    (AlgebraicGeometry.Scheme.Opens.topIso U).symm ≪≫
      AlgebraicGeometry.Scheme.Γ.mapIso ι_P1.isoOpensRange.op ≪≫
      AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (Polynomial k))
  let e_S : S ≃+* Polynomial k := iso_S.commRingCatIsoToRingEquiv
  let : IsDomain S := e_S.toMulEquiv.isDomain (Polynomial k)
  let : IsPrincipalIdealRing S :=
    IsPrincipalIdealRing.of_surjective e_S.symm.toRingHom e_S.symm.surjective
  let t_S : S := e_S.symm Polynomial.X
  have ht_ne : t_S ≠ 0 := by
    intro h0
    apply Polynomial.X_ne_zero (R := k)
    have h1 := congrArg e_S h0
    rwa [e_S.apply_symm_apply, map_zero] at h1
  have ht_not_unit : ¬ IsUnit t_S := by
    intro hu
    have hu' : IsUnit (e_S t_S) := hu.map e_S.toRingHom
    rw [e_S.apply_symm_apply] at hu'
    exact Polynomial.not_isUnit_X hu'
  let : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) :=
    Nonempty.map ι_P1.isoOpensRange.hom.base inferInstance
  let K := ↑X.functionField
  let : IsFractionRing S K :=
    AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X U hAffU
  have hDVR_pow : ∀ (R : Type u) [CommRing R] (hDom : IsDomain R)
      (hDVR_R : @IsDiscreteValuationRing R _ hDom) (r : R), r ≠ 0 →
      ∃ n : ℕ, Ideal.span ({r} : Set R) =
        (@IsLocalRing.maximalIdeal R _ (@IsDiscreteValuationRing.toIsLocalRing R _ hDom hDVR_R)) ^ n := by
    intro R _ hDom hDVR_R r hr
    let : IsDomain R := hDom
    let : IsDiscreteValuationRing R := hDVR_R
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hmax : IsLocalRing.maximalIdeal R = Ideal.span ({ϖ} : Set R) :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    have hne_bot : Ideal.span ({r} : Set R) ≠ ⊥ := by
      intro hbot
      have hr_mem : r ∈ Ideal.span ({r} : Set R) := Ideal.subset_span (Set.mem_singleton r)
      rw [hbot, Ideal.mem_bot] at hr_mem
      exact hr hr_mem
    obtain ⟨n, hn⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hne_bot hϖ
    refine ⟨n, ?_⟩
    rw [hn, ← Ideal.span_singleton_pow, ← hmax]
  let mk' := QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X)
  have hSingle : ∀ Q : Pt,
      mk' (Finsupp.single Q (1 : ℤ)) = mk' (Finsupp.single x_inf (1 : ℤ)) := by
    intro Q
    by_cases hQ_ne : Q = x_inf
    · rw [hQ_ne]
    · have hqU : Q.1 ∈ U := (hPart Q).resolve_left hQ_ne
      let y_Q : ↥U := ⟨Q.1, hqU⟩
      let p_Q : PrimeSpectrum S := hAffU.primeIdealOf y_Q
      have hpre_Q : hAffU.fromSpec.base ⁻¹' ({Q.1} : Set ↥X) = ({p_Q} : Set (PrimeSpectrum S)) := by
        ext p
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        refine ⟨fun hp => ?_, fun hp => ?_⟩
        · apply hAffU.fromSpec.isOpenEmbedding.injective
          exact hp.trans (hAffU.fromSpec_primeIdealOf y_Q).symm
        · rw [hp]
          exact hAffU.fromSpec_primeIdealOf y_Q
      have hClosed_pQ : IsClosed ({p_Q} : Set (PrimeSpectrum S)) := by
        have hpre := Q.2.preimage hAffU.fromSpec.continuous
        rwa [hpre_Q] at hpre
      have hpQ_max : p_Q.asIdeal.IsMaximal :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_Q).mp hClosed_pQ
      have hpQ_ne_bot : p_Q.asIdeal ≠ ⊥ := by
        intro hbot
        have hbot_max : (⊥ : Ideal S).IsMaximal := hbot ▸ hpQ_max
        have ht_span_ne_bot : Ideal.span ({t_S} : Set S) ≠ ⊥ := by
          intro hsb
          have hmem : t_S ∈ Ideal.span ({t_S} : Set S) := Ideal.subset_span (Set.mem_singleton t_S)
          rw [hsb, Ideal.mem_bot] at hmem
          exact ht_ne hmem
        have ht_span_ne_top : Ideal.span ({t_S} : Set S) ≠ ⊤ := by
          intro hst
          exact ht_not_unit (Ideal.span_singleton_eq_top.mp hst)
        exact ht_span_ne_bot (hbot_max.eq_of_le ht_span_ne_top bot_le).symm
      let s_g : S := Submodule.IsPrincipal.generator p_Q.asIdeal
      have hs_span : Ideal.span ({s_g} : Set S) = p_Q.asIdeal :=
        Submodule.IsPrincipal.span_singleton_generator p_Q.asIdeal
      have hs_ne : s_g ≠ 0 := by
        intro hs0
        apply hpQ_ne_bot
        rw [← hs_span, hs0, Set.singleton_zero, Ideal.span_zero]
      have hf₀_ne : algebraMap S K s_g ≠ 0 := by
        intro h0
        exact hs_ne (IsFractionRing.injective S K (h0.trans (map_zero (algebraMap S K)).symm))
      let f : Units K := Units.mk0 (algebraMap S K s_g) hf₀_ne
      let R_inf := ↑(X.presheaf.stalk x_inf.1)
      obtain ⟨hDom_inf, hDVR_inf⟩ := hDVR x_inf
      let : IsDomain R_inf := hDom_inf
      obtain ⟨a_inf, b_inf, hb_inf_mem, hdiv_inf⟩ :=
        IsFractionRing.div_surjective (A := R_inf) (f : K)
      have hb_inf_ne : b_inf ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_inf_mem
      have hbK_ne : algebraMap R_inf K b_inf ≠ 0 :=
        IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hb_inf_mem
      have hab_inf : algebraMap R_inf K a_inf = (f : K) * algebraMap R_inf K b_inf :=
        (div_eq_iff hbK_ne).mp hdiv_inf
      have ha_inf_ne : a_inf ≠ 0 := by
        intro ha0
        have h0 : algebraMap R_inf K a_inf = 0 := by rw [ha0, map_zero]
        exact mul_ne_zero f.ne_zero hbK_ne (hab_inf.symm.trans h0)
      obtain ⟨na_inf, hna_inf⟩ := hDVR_pow R_inf hDom_inf hDVR_inf a_inf ha_inf_ne
      obtain ⟨nb_inf, hnb_inf⟩ := hDVR_pow R_inf hDom_inf hDVR_inf b_inf hb_inf_ne
      let m_inf : ℤ := (na_inf : ℤ) - (nb_inf : ℤ)
      let D_g : Pt →₀ ℤ := Finsupp.single Q (1 : ℤ) + Finsupp.single x_inf m_inf
      have hDg_mem : D_g ∈ weilCurvePrincipalSubgroup X := by
        apply AddSubgroup.subset_closure
        refine ⟨f, fun x => ?_⟩
        by_cases hx_inf : x = x_inf
        · subst hx_inf
          refine ⟨a_inf, b_inf, na_inf, nb_inf, ha_inf_ne, hb_inf_ne, hab_inf, hna_inf, hnb_inf, ?_⟩
          simp only [D_g, Finsupp.add_apply, Finsupp.single_eq_of_ne (Ne.symm hQ_ne),
            Finsupp.single_eq_same, zero_add]
          rfl
        · have hxU : x.1 ∈ U := (hPart x).resolve_left hx_inf
          let y_x : ↥U := ⟨x.1, hxU⟩
          let p_x : PrimeSpectrum S := hAffU.primeIdealOf y_x
          let Rx := ↑(X.presheaf.stalk y_x.1)
          obtain ⟨hDom_x, _⟩ := hDVR x
          let : IsDomain Rx := hDom_x
          let : IsLocalization.AtPrime Rx p_x.asIdeal := hAffU.isLocalization_stalk y_x
          let a_x : Rx := algebraMap S Rx s_g
          have hab_x : algebraMap Rx K a_x = (f : K) * algebraMap Rx K (1 : Rx) := by
            have hsc : algebraMap Rx K a_x = algebraMap S K s_g :=
              (IsScalarTower.algebraMap_apply S Rx K s_g).symm
            rw [hsc, map_one, mul_one]
            rfl
          have ha_x_ne : a_x ≠ 0 := by
            intro ha0
            have h0 : algebraMap Rx K a_x = 0 := by rw [ha0, map_zero]
            have h1 : (f : K) = 0 := by
              rw [map_one, mul_one] at hab_x
              exact hab_x.symm.trans h0
            exact f.ne_zero h1
          have hb_x_ne : (1 : Rx) ≠ 0 := one_ne_zero
          have hb_x_span : Ideal.span ({(1 : Rx)} : Set Rx) = (IsLocalRing.maximalIdeal Rx) ^ 0 := by
            rw [Ideal.span_singleton_one, pow_zero, Ideal.one_eq_top]
          by_cases hxQ : x = Q
          · subst hxQ
            refine ⟨a_x, 1, 1, 0, ha_x_ne, hb_x_ne, hab_x, ?_, hb_x_span, ?_⟩
            · dsimp [a_x]
              rw [← Set.image_singleton, ← Ideal.map_span, hs_span, pow_one]
              exact IsLocalization.AtPrime.map_eq_maximalIdeal p_Q.asIdeal (↑Rx)
            · simp only [D_g, Finsupp.add_apply, Finsupp.single_eq_same,
                Finsupp.single_eq_of_ne hQ_ne, add_zero]
              norm_num
          · refine ⟨a_x, 1, 0, 0, ha_x_ne, hb_x_ne, hab_x, ?_, hb_x_span, ?_⟩
            · have hx1_ne : x.1 ≠ Q.1 := fun h => hxQ (Subtype.ext h)
              have hpx_ne : p_x ≠ p_Q := by
                intro hp
                have hbase := congrArg hAffU.fromSpec.base hp
                rw [hAffU.fromSpec_primeIdealOf y_x, hAffU.fromSpec_primeIdealOf y_Q] at hbase
                exact hx1_ne hbase
              have hpx_ideal_ne : p_x.asIdeal ≠ p_Q.asIdeal :=
                fun hi => hpx_ne (PrimeSpectrum.ext hi)
              have hs_not_mem : s_g ∉ p_x.asIdeal := by
                intro hmem
                have hle : p_Q.asIdeal ≤ p_x.asIdeal := by
                  rw [← hs_span]
                  exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem)
                exact hpx_ideal_ne (hpQ_max.eq_of_le p_x.isPrime.ne_top hle).symm
              have ha_unit : IsUnit a_x :=
                IsLocalization.map_units Rx (⟨s_g, hs_not_mem⟩ : p_x.asIdeal.primeCompl)
              rw [Ideal.span_singleton_eq_top.mpr ha_unit, pow_zero, Ideal.one_eq_top]
            · simp only [D_g, Finsupp.add_apply, Finsupp.single_eq_of_ne hxQ,
                Finsupp.single_eq_of_ne hx_inf, add_zero]
              norm_num
      have hmk0 : mk' D_g = 0 := (QuotientAddGroup.eq_zero_iff D_g).mpr hDg_mem
      have hdeg0 : deg_Cl (mk' D_g) = 0 := by rw [hmk0, map_zero]
      rw [hdeg D_g] at hdeg0
      have hsum_Dg : D_g.sum (fun _ n => n) = 1 + m_inf := by
        dsimp [D_g]
        rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl, Finsupp.sum_single_index rfl]
      rw [hsum_Dg] at hdeg0
      have hm_inf_eq : m_inf = -1 := by omega
      have hDg_sub : D_g = Finsupp.single Q (1 : ℤ) - Finsupp.single x_inf (1 : ℤ) := by
        dsimp [D_g]
        rw [hm_inf_eq, Finsupp.single_neg, sub_eq_add_neg]
      rw [hDg_sub, map_sub] at hmk0
      exact sub_eq_zero.mp hmk0
  have hDecomp : ∀ E : Pt →₀ ℤ,
      mk' E = (E.sum (fun _ n => n)) • mk' (Finsupp.single x_inf (1 : ℤ)) := by
    intro E
    refine Finsupp.induction_linear E ?_ ?_ ?_
    · rw [map_zero, Finsupp.sum_zero_index, zero_zsmul]
    · intro E₁ E₂ hE₁ hE₂
      rw [map_add, hE₁, hE₂, ← add_zsmul,
        Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)]
    · intro Q n
      have hsn : Finsupp.single Q n = n • Finsupp.single Q (1 : ℤ) := by
        rw [Finsupp.smul_single', mul_one]
      rw [Finsupp.sum_single_index rfl]
      conv_lhs => rw [hsn]
      rw [map_zsmul, hSingle Q]
  intro c hc
  obtain ⟨D, rfl⟩ := QuotientAddGroup.mk'_surjective (weilCurvePrincipalSubgroup X) c
  have hsum0 : D.sum (fun _ n => n) = 0 := by
    rw [← hdeg D]
    exact hc
  rw [hDecomp D, hsum0, zero_zsmul]

theorem weil_projLine_sc_etale_pullback_and_constant_counit (P : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥P] [Nonempty ↥P]
    (𝒢 : CategoryTheory.Sheaf P.smallEtaleTopology AddCommGrpCat.{u})
    (A₀ : AddCommGrpCat.{u}) [Finite ↥A₀] :
    (∀ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ P) (hw : AlgebraicGeometry.Etale w),
      WeilIsEtaleSheafPullback w 𝒢
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) →
      ∃ ψ : ∀ V : W.Etale,
          ↥(𝒢.obj.obj (Opposite.op ((weilAffGeomPbcSliceMap hw).obj V))) ≃+
            LocallyConstant ↥V.left ↥A₀,
        ∀ {V₁ V₂ : W.Etale} (g : V₁ ⟶ V₂)
          (s : ↥(𝒢.obj.obj (Opposite.op ((weilAffGeomPbcSliceMap hw).obj V₂)))),
          ⇑(ψ V₁ ((𝒢.obj.map ((weilAffGeomPbcSliceMap hw).map g).op).hom s)) =
            ⇑(ψ V₂ s) ∘ g.left.base) ∧
    (∀ (T : P.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
      (∃ s_glob : Fin (Nat.card ↥A₀) → ↥(𝒢.obj.obj (Opposite.op T)),
        ∀ x : ↥P,
          ∃ (W : AlgebraicGeometry.Scheme.{u}) (_ : ConnectedSpace ↥W) (_ : Nonempty ↥W)
            (w : W ⟶ P) (hw : AlgebraicGeometry.Etale w)
            (_ : x ∈ Set.range w.base)
            (ψ : ∀ V : W.Etale,
              ↥(𝒢.obj.obj (Opposite.op ((weilAffGeomPbcSliceMap hw).obj V))) ≃+
                LocallyConstant ↥V.left ↥A₀)
            (π_W : Fin (Nat.card ↥A₀) ≃ ↥A₀),
            (∀ {V₁ V₂ : W.Etale} (g : V₁ ⟶ V₂)
              (s : ↥(𝒢.obj.obj (Opposite.op ((weilAffGeomPbcSliceMap hw).obj V₂)))),
              ⇑(ψ V₁ ((𝒢.obj.map ((weilAffGeomPbcSliceMap hw).map g).op).hom s)) =
                ⇑(ψ V₂ s) ∘ g.left.base) ∧
            (∀ i : Fin (Nat.card ↥A₀),
              ψ (weilEtaleIdTerminal.{u} W)
                ((𝒢.obj.map
                  (hT.from ((weilAffGeomPbcSliceMap hw).obj (weilEtaleIdTerminal.{u} W))).op).hom
                  (s_glob i)) =
                LocallyConstant.const ↥W (π_W i))) →
      Finite ↥(𝒢.obj.obj (Opposite.op T)) ∧
      CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj P.smallEtaleTopology AddCommGrpCat.{u} hT).counit.app
          𝒢)) :=
by
  
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hMapComp : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      (F : 𝒞ᵒᵖ ⥤ AddCommGrpCat.{u}) {X Y Z : 𝒞} (f : X ⟶ Y) (g : Y ⟶ Z)
      (s : ↥(F.obj (Opposite.op Z))),
      (F.map f.op).hom ((F.map g.op).hom s) = (F.map (f ≫ g).op).hom s := by
    intro 𝒞 _ F X Y Z f g s
    exact congrArg (fun k : F.obj (Opposite.op Z) ⟶ F.obj (Opposite.op X) => k.hom s)
      (F.map_comp g.op f.op).symm

  have hMapId : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      (F : 𝒞ᵒᵖ ⥤ AddCommGrpCat.{u}) {X : 𝒞} (s : ↥(F.obj (Opposite.op X))),
      (F.map (𝟙 X).op).hom s = s := by
    intro 𝒞 _ F X s
    exact congrArg (fun k : F.obj (Opposite.op X) ⟶ F.obj (Opposite.op X) => k.hom s)
      (F.map_id (Opposite.op X))

  have hNatApp : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒞]
      {F G : 𝒞ᵒᵖ ⥤ AddCommGrpCat.{u}} (τ : F ⟶ G) {X Y : 𝒞} (f : X ⟶ Y)
      (s : ↥(F.obj (Opposite.op Y))),
      (τ.app (Opposite.op X)).hom ((F.map f.op).hom s) =
        (G.map f.op).hom ((τ.app (Opposite.op Y)).hom s) := by
    intro 𝒞 _ F G τ X Y f s
    exact congrArg (fun k : F.obj (Opposite.op Y) ⟶ G.obj (Opposite.op X) => k.hom s)
      (τ.naturality f.op)

  let isoToAddEquiv : ∀ {A B : AddCommGrpCat.{u}}, (A ≅ B) → (↥A ≃+ ↥B) := fun {A B} e =>
    { toFun := e.hom.hom
      invFun := e.inv.hom
      left_inv := fun x => congrArg (fun k : A ⟶ A => k.hom x) e.hom_inv_id
      right_inv := fun y => congrArg (fun k : B ⟶ B => k.hom y) e.inv_hom_id
      map_add' := map_add e.hom.hom }

  have hEtale_of_hom : ∀ {Y : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : Y.Etale} (f : U₁ ⟶ U₂),
      AlgebraicGeometry.Etale f.left := by
    intro Y U₁ U₂ f
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      f.left U₂.hom U₂.prop ((CategoryTheory.MorphismProperty.Over.w f).symm ▸ U₁.prop)

  have hMem_etale : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (U : Y.Etale) (R : CategoryTheory.Sieve U),
      R ∈ Y.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (Z : Y.Etale) (f : Z ⟶ U) (z : ↥Z.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base z = x := by
    intro Y U R
    exact (Eq.to_iff (congrArg (fun G => R ∈ G U)
      (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) Y le_rfl))).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R)

  have hSubsingleton_of_isEmpty : ∀ {Y : AlgebraicGeometry.Scheme.{u}}
      (ℱ : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (Z : Y.Etale), IsEmpty ↥Z.left → Subsingleton ↥(ℱ.obj.obj (Opposite.op Z)) := by
    intro Y ℱ Z hEmp
    have hbot : (⊥ : CategoryTheory.Sieve Z) ∈ Y.smallEtaleTopology Z :=
      (hMem_etale Y Z ⊥).mpr (fun x => (IsEmpty.false x).elim)
    have hℱ_type : CategoryTheory.Presheaf.IsSheaf Y.smallEtaleTopology
        (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf Y.smallEtaleTopology ℱ.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) ℱ.property
    have hSep := ((CategoryTheory.isSheaf_iff_isSheaf_of_type Y.smallEtaleTopology
      (ℱ.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp hℱ_type ⊥ hbot).isSeparatedFor
    exact ⟨fun a b => hSep.ext (fun _ _ hf => False.elim hf)⟩

  
  have hConstRepr : ∀ (Y : AlgebraicGeometry.Scheme.{u})
      (T_Y : Y.Etale) (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
      (M : AddCommGrpCat.{u}),
      ∃ Φ : ∀ V : Y.Etale,
          ↥(((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj M).obj.obj
            (Opposite.op V)) ≃+ LocallyConstant ↥V.left ↥M,
        (∀ {V₁ V₂ : Y.Etale} (g : V₁ ⟶ V₂)
          (s : ↥(((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj M).obj.obj
            (Opposite.op V₂))),
          ⇑(Φ V₁
            ((((CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}).obj M).obj.map
              g.op).hom s)) =
            ⇑(Φ V₂ s) ∘ g.left.base) ∧
        (∀ m : ↥M,
          Φ T_Y
            (((CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y).unit.app
              M).hom m) =
            LocallyConstant.const ↥T_Y.left m) := by
    intro Y T_Y hT_Y M
    let J := Y.smallEtaleTopology
    let C_M := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj M
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_Y
    let η : M ⟶ C_M.obj.obj (Opposite.op T_Y) := adj.unit.app M
    let L_pre : (Y.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥(Opposite.unop U).left ↥M)
        map := fun {U₁ U₂} f => AddCommGrpCat.ofHom
          { toFun := fun s =>
              ⟨⇑s ∘ (Opposite.unop f).left.base,
                fun S => by
                  rw [Set.preimage_comp]
                  exact (Opposite.unop f).left.continuous.isOpen_preimage _ (s.isLocallyConstant S)⟩
            map_zero' := LocallyConstant.ext fun _ => rfl
            map_add' := fun _ _ => LocallyConstant.ext fun _ => rfl }
        map_id := fun _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
        map_comp := fun _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
    let asLC : ∀ {V : Y.Etale},
        (L_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}).obj (Opposite.op V) →
          LocallyConstant ↥V.left ↥M :=
      fun t => t
    have hL_sheaf : CategoryTheory.Presheaf.IsSheaf J L_pre := by
      apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J L_pre
        (CategoryTheory.forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
      intro U R hR x_fam hx_compat
      have hOverlap : ∀ {Y₁ Y₂ : Y.Etale} {f₁ : Y₁ ⟶ U} {f₂ : Y₂ ⟶ U}
          (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂) (y₁ : ↥Y₁.left) (y₂ : ↥Y₂.left),
          f₁.left.base y₁ = f₂.left.base y₂ →
          asLC (x_fam f₁ hf₁) y₁ = asLC (x_fam f₂ hf₂) y₂ := by
        intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
        have : AlgebraicGeometry.Etale f₁.left := hEtale_of_hom f₁
        have : AlgebraicGeometry.Etale f₂.left := hEtale_of_hom f₂
        let p₁ := CategoryTheory.Limits.pullback.fst f₁.left f₂.left
        let p₂ := CategoryTheory.Limits.pullback.snd f₁.left f₂.left
        let W₁₂ : Y.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ Y₁.hom)
            (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
              p₁ Y₁.hom inferInstance Y₁.prop)
        let g₁ : W₁₂ ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl
        let g₂ : W₁₂ ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk p₂
          (((CategoryTheory.Category.assoc p₂ f₂.left U.hom).trans
            (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w f₂))).symm.trans
            ((congrArg (· ≫ U.hom) CategoryTheory.Limits.pullback.condition.symm).trans
              ((CategoryTheory.Category.assoc p₁ f₁.left U.hom).trans
                (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w f₁)))))
        have hg_eq : g₁ ≫ f₁ = g₂ ≫ f₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy
        have hcomp_z : asLC (x_fam f₁ hf₁) (p₁.base z) = asLC (x_fam f₂ hf₂) (p₂.base z) :=
          LocallyConstant.congr_fun (hx_compat g₁ g₂ hf₁ hf₂ hg_eq) z
        rwa [hz₁, hz₂] at hcomp_z
      have hCov := (hMem_etale Y U R).mp hR
      choose Y_u f_u y_u hf_u het_u hy_u using hCov
      let s_fun : ↥U.left → ↥M := fun u => asLC (x_fam (f_u u) (hf_u u)) (y_u u)
      have hs_agree : ∀ {Z : Y.Etale} (f : Z ⟶ U) (hf : R.arrows f) (z : ↥Z.left),
          s_fun (f.left.base z) = asLC (x_fam f hf) z := by
        intro Z f hf z
        exact hOverlap (hf_u (f.left.base z)) hf (y_u (f.left.base z)) z (hy_u (f.left.base z))
      have hs_loc : IsLocallyConstant s_fun := by
        rw [IsLocallyConstant.iff_isOpen_fiber]
        intro m
        have hfib_eq : s_fun ⁻¹' {m} =
            ⋃ u : ↥U.left, (f_u u).left.base '' (asLC (x_fam (f_u u) (hf_u u)) ⁻¹' {m}) := by
          ext w
          simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_image]
          constructor
          · intro hw
            exact ⟨w, y_u w, hw, hy_u w⟩
          · rintro ⟨u, y, hy, rfl⟩
            exact (hs_agree (f_u u) (hf_u u) y).trans hy
        rw [hfib_eq]
        refine isOpen_iUnion fun u => ?_
        have : AlgebraicGeometry.Etale (f_u u).left := het_u u
        exact (f_u u).left.isOpenMap _ ((asLC (x_fam (f_u u) (hf_u u))).isLocallyConstant {m})
      let s_top : LocallyConstant ↥U.left ↥M := ⟨s_fun, hs_loc⟩
      refine ⟨s_top, ?_, ?_⟩
      · intro Z f hf
        exact LocallyConstant.ext fun z => hs_agree f hf z
      · intro s' hs'
        refine LocallyConstant.ext fun u => ?_
        have h1 : asLC s' ((f_u u).left.base (y_u u)) = s_fun u :=
          LocallyConstant.congr_fun (hs' (f_u u) (hf_u u)) (y_u u)
        exact (congrArg (asLC s') (hy_u u)).symm.trans h1
    let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨L_pre, hL_sheaf⟩
    let c_hom : M ⟶ L_sh.obj.obj (Opposite.op T_Y) :=
      AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥T_Y.left) (Y := ↥M))
    let Φ_mor : C_M ⟶ L_sh := (adj.homEquiv M L_sh).symm c_hom
    have hΦ_unit_hom : η ≫ Φ_mor.hom.app (Opposite.op T_Y) = c_hom := by
      have h1 := (adj.homEquiv M L_sh).apply_symm_apply c_hom
      rwa [CategoryTheory.Adjunction.homEquiv_unit] at h1
    have hΦ_unit : ∀ m : ↥M,
        (Φ_mor.hom.app (Opposite.op T_Y)).hom (η.hom m) = LocallyConstant.const ↥T_Y.left m := by
      intro m
      exact congrArg (fun k : M ⟶ L_sh.obj.obj (Opposite.op T_Y) => k.hom m) hΦ_unit_hom
    have hC_type : CategoryTheory.Presheaf.IsSheaf J
        (C_M.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J C_M.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) C_M.property
    have hC_sheafFor := (CategoryTheory.isSheaf_iff_isSheaf_of_type J
      (C_M.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp hC_type
    have hConstSec_eq : ∀ (Z : Y.Etale) (m₁ m₂ : ↥M),
        (Nonempty ↥Z.left → m₁ = m₂) →
        (C_M.obj.map (hT_Y.from Z).op).hom (η.hom m₁) =
          (C_M.obj.map (hT_Y.from Z).op).hom (η.hom m₂) := by
      intro Z m₁ m₂ hm
      by_cases hne : Nonempty ↥Z.left
      · rw [hm hne]
      · have hEmp : IsEmpty ↥Z.left := not_nonempty_iff.mp hne
        have := hSubsingleton_of_isEmpty C_M Z hEmp
        exact Subsingleton.elim _ _
    let constSieve : ∀ (U : Y.Etale), LocallyConstant ↥U.left ↥M → CategoryTheory.Sieve U :=
      fun U s =>
        { arrows := fun {Z} f => ∃ m : ↥M, ∀ z : ↥Z.left, s (f.left.base z) = m
          downward_closed := fun {Z Z'} {f} ⟨m, hm⟩ g =>
            ⟨m, fun z' => hm (g.left.base z')⟩ }
    have hConstSieve_mem : ∀ (U : Y.Etale) (s : LocallyConstant ↥U.left ↥M),
        constSieve U s ∈ J U := by
      intro U s
      rw [hMem_etale]
      intro x
      let O : U.left.Opens := ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
      let W_x : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ U.hom)
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O.ι U.hom inferInstance U.prop)
      let j_x : W_x ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
      exact ⟨W_x, j_x, ⟨x, rfl⟩, ⟨s x, fun z => z.2⟩, inferInstance, rfl⟩
    let constFam : ∀ (U : Y.Etale) (s : LocallyConstant ↥U.left ↥M),
        CategoryTheory.Presieve.FamilyOfElements
          (C_M.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) (constSieve U s).arrows :=
      fun U s Z _ hf => (C_M.obj.map (hT_Y.from Z).op).hom (η.hom (Classical.choose hf))
    have hConstFam_compat : ∀ (U : Y.Etale) (s : LocallyConstant ↥U.left ↥M),
        (constFam U s).Compatible := by
      intro U s Z₁ Z₂ Z₀ g₁ g₂ f₁ f₂ hf₁ hf₂ hgf
      have hlhs : (C_M.obj.map g₁.op).hom
          ((C_M.obj.map (hT_Y.from Z₁).op).hom (η.hom (Classical.choose hf₁))) =
          (C_M.obj.map (hT_Y.from Z₀).op).hom (η.hom (Classical.choose hf₁)) :=
        (hMapComp C_M.obj g₁ (hT_Y.from Z₁) _).trans
          (congrArg (fun k => (C_M.obj.map k.op).hom _)
            (hT_Y.hom_ext (g₁ ≫ hT_Y.from Z₁) (hT_Y.from Z₀)))
      have hrhs : (C_M.obj.map g₂.op).hom
          ((C_M.obj.map (hT_Y.from Z₂).op).hom (η.hom (Classical.choose hf₂))) =
          (C_M.obj.map (hT_Y.from Z₀).op).hom (η.hom (Classical.choose hf₂)) :=
        (hMapComp C_M.obj g₂ (hT_Y.from Z₂) _).trans
          (congrArg (fun k => (C_M.obj.map k.op).hom _)
            (hT_Y.hom_ext (g₂ ≫ hT_Y.from Z₂) (hT_Y.from Z₀)))
      refine hlhs.trans ((hConstSec_eq Z₀ _ _ ?_).trans hrhs.symm)
      rintro ⟨z₀⟩
      have hm₁ := Classical.choose_spec hf₁ (g₁.left.base z₀)
      have hm₂ := Classical.choose_spec hf₂ (g₂.left.base z₀)
      have hpt : f₁.left.base (g₁.left.base z₀) = f₂.left.base (g₂.left.base z₀) :=
        (AlgebraicGeometry.Scheme.Hom.comp_apply g₁.left f₁.left z₀).symm.trans
          ((congrArg (fun k => k.left.base z₀) hgf).trans
            (AlgebraicGeometry.Scheme.Hom.comp_apply g₂.left f₂.left z₀))
      exact hm₁.symm.trans ((congrArg s hpt).trans hm₂)
    let ψ_fun : ∀ (U : Y.Etale), LocallyConstant ↥U.left ↥M → ↥(C_M.obj.obj (Opposite.op U)) :=
      fun U s =>
        (hC_sheafFor (constSieve U s) (hConstSieve_mem U s)).amalgamate
          (constFam U s) (hConstFam_compat U s)
    have hψ_spec : ∀ {U Z : Y.Etale} (s : LocallyConstant ↥U.left ↥M) (f : Z ⟶ U) (m : ↥M),
        (∀ z : ↥Z.left, s (f.left.base z) = m) →
        (C_M.obj.map f.op).hom (ψ_fun U s) = (C_M.obj.map (hT_Y.from Z).op).hom (η.hom m) := by
      intro U Z s f m hm
      have hf : (constSieve U s).arrows f := ⟨m, hm⟩
      have hglue : (C_M.obj.map f.op).hom (ψ_fun U s) =
          (C_M.obj.map (hT_Y.from Z).op).hom (η.hom (Classical.choose hf)) :=
        (hC_sheafFor (constSieve U s) (hConstSieve_mem U s)).valid_glue
          (hConstFam_compat U s) f hf
      refine hglue.trans (hConstSec_eq Z _ _ ?_)
      rintro ⟨z₀⟩
      exact (Classical.choose_spec hf z₀).symm.trans (hm z₀)
    have hψ_zero : ∀ U : Y.Etale, ψ_fun U 0 = 0 := by
      intro U
      have h1 := (hMapId C_M.obj (ψ_fun U 0)).symm.trans
        (hψ_spec (U := U) 0 (𝟙 U) 0 (fun _ => rfl))
      rw [map_zero, map_zero] at h1
      exact h1
    have hψ_add : ∀ (U : Y.Etale) (s₁ s₂ : LocallyConstant ↥U.left ↥M),
        ψ_fun U (s₁ + s₂) = ψ_fun U s₁ + ψ_fun U s₂ := by
      intro U s₁ s₂
      let S₁₂ : CategoryTheory.Sieve U := constSieve U s₁ ⊓ constSieve U s₂
      have hS₁₂ : S₁₂ ∈ J U := by
        rw [hMem_etale]
        intro x
        let O : U.left.Opens :=
          ⟨s₁ ⁻¹' {s₁ x} ∩ s₂ ⁻¹' {s₂ x},
            (s₁.isLocallyConstant {s₁ x}).inter (s₂.isLocallyConstant {s₂ x})⟩
        let W_x : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            O.ι U.hom inferInstance U.prop)
        let j_x : W_x ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
        exact ⟨W_x, j_x, ⟨x, rfl, rfl⟩,
          ⟨⟨s₁ x, fun z => z.2.1⟩, ⟨s₂ x, fun z => z.2.2⟩⟩, inferInstance, rfl⟩
      refine (hC_sheafFor S₁₂ hS₁₂).isSeparatedFor.ext ?_
      intro Z f ⟨⟨m₁, hm₁⟩, ⟨m₂, hm₂⟩⟩
      have hlhs := hψ_spec (s₁ + s₂) f (m₁ + m₂) (fun z => by
        change s₁ (f.left.base z) + s₂ (f.left.base z) = m₁ + m₂
        rw [hm₁ z, hm₂ z])
      have hrhs : (C_M.obj.map f.op).hom (ψ_fun U s₁ + ψ_fun U s₂) =
          (C_M.obj.map (hT_Y.from Z).op).hom (η.hom (m₁ + m₂)) := by
        rw [map_add, hψ_spec s₁ f m₁ hm₁, hψ_spec s₂ f m₂ hm₂, ← map_add, ← map_add]
      exact hlhs.trans hrhs.symm
    have hψ_nat : ∀ {V₁ V₂ : Y.Etale} (g : V₁ ⟶ V₂) (s : LocallyConstant ↥V₂.left ↥M),
        (C_M.obj.map g.op).hom (ψ_fun V₂ s) = ψ_fun V₁ ((L_pre.map g.op).hom s) := by
      intro V₁ V₂ g s
      let s₁ : LocallyConstant ↥V₁.left ↥M := (L_pre.map g.op).hom s
      refine (hC_sheafFor (constSieve V₁ s₁) (hConstSieve_mem V₁ s₁)).isSeparatedFor.ext ?_
      intro Z f ⟨m, hm⟩
      exact (hMapComp C_M.obj f g (ψ_fun V₂ s)).trans
        ((hψ_spec s (f ≫ g) m (fun z => hm z)).trans (hψ_spec s₁ f m hm).symm)
    have hψ_constT : ∀ m : ↥M, ψ_fun T_Y (LocallyConstant.const ↥T_Y.left m) = η.hom m := by
      intro m
      exact (hMapId C_M.obj _).symm.trans
        ((hψ_spec (LocallyConstant.const ↥T_Y.left m) (𝟙 T_Y) m (fun _ => rfl)).trans
          ((congrArg (fun k => (C_M.obj.map k.op).hom (η.hom m))
            (hT_Y.hom_ext (hT_Y.from T_Y) (𝟙 T_Y))).trans (hMapId C_M.obj (η.hom m))))
    let Ψ_mor : L_sh ⟶ C_M := CategoryTheory.ObjectProperty.homMk
      { app := fun U => AddCommGrpCat.ofHom
          { toFun := ψ_fun (Opposite.unop U)
            map_zero' := hψ_zero (Opposite.unop U)
            map_add' := hψ_add (Opposite.unop U) }
        naturality := fun {U₂ U₁} f =>
          AddCommGrpCat.ext fun s => (hψ_nat (Opposite.unop f) s).symm }
    have hΦΨ : Φ_mor ≫ Ψ_mor = 𝟙 C_M := by
      apply (adj.homEquiv M C_M).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      apply AddCommGrpCat.ext
      intro m
      change ψ_fun T_Y ((Φ_mor.hom.app (Opposite.op T_Y)).hom (η.hom m)) = η.hom m
      rw [hΦ_unit m, hψ_constT m]
    have hΨΦ : Ψ_mor ≫ Φ_mor = 𝟙 L_sh := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      apply AddCommGrpCat.ext
      intro s
      refine LocallyConstant.ext fun x => ?_
      let U := Opposite.unop U_op
      let m := s x
      let O : U.left.Opens := ⟨s ⁻¹' {m}, s.isLocallyConstant {m}⟩
      let W_x : Y.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ U.hom)
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O.ι U.hom inferInstance U.prop)
      let j_x : W_x ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
      let z_x : ↥W_x.left := ⟨x, rfl⟩
      have hj_nat : ((Φ_mor.hom.app (Opposite.op W_x)).hom
          ((C_M.obj.map j_x.op).hom (ψ_fun U s))) z_x =
          ((Φ_mor.hom.app (Opposite.op U)).hom (ψ_fun U s)) x :=
        LocallyConstant.congr_fun (hNatApp Φ_mor.hom j_x (ψ_fun U s)) z_x
      have hT_nat : ((Φ_mor.hom.app (Opposite.op W_x)).hom
          ((C_M.obj.map (hT_Y.from W_x).op).hom (η.hom m))) z_x =
          ((Φ_mor.hom.app (Opposite.op T_Y)).hom (η.hom m)) ((hT_Y.from W_x).left.base z_x) :=
        LocallyConstant.congr_fun (hNatApp Φ_mor.hom (hT_Y.from W_x) (η.hom m)) z_x
      change ((Φ_mor.hom.app (Opposite.op U)).hom (ψ_fun U s)) x = m
      rw [← hj_nat, hψ_spec s j_x m (fun z => z.2), hT_nat, hΦ_unit m]
      rfl
    let iso_CL : C_M ≅ L_sh :=
      { hom := Φ_mor
        inv := Ψ_mor
        hom_inv_id := hΦΨ
        inv_hom_id := hΨΦ }
    let Φ_equiv : ∀ V : Y.Etale,
        ↥(C_M.obj.obj (Opposite.op V)) ≃+ LocallyConstant ↥V.left ↥M :=
      fun V => isoToAddEquiv
        (((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).mapIso iso_CL).app (Opposite.op V))
    refine ⟨Φ_equiv, ?_, ?_⟩
    · intro V₁ V₂ g s
      exact congrArg DFunLike.coe (hNatApp Φ_mor.hom g s)
    · intro m
      exact hΦ_unit m

  
  have hSlicePullback : ∀ {W : AlgebraicGeometry.Scheme.{u}} (w : W ⟶ P)
      (hw : AlgebraicGeometry.Etale w)
      (ℱ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      WeilIsEtaleSheafPullback w 𝒢 ℱ →
      ∃ θ : ∀ V : W.Etale,
          ↥(𝒢.obj.obj (Opposite.op ((weilAffGeomPbcSliceMap hw).obj V))) ≃+
            ↥(ℱ.obj.obj (Opposite.op V)),
        ∀ {V₁ V₂ : W.Etale} (g : V₁ ⟶ V₂)
          (s : ↥(𝒢.obj.obj (Opposite.op ((weilAffGeomPbcSliceMap hw).obj V₂)))),
