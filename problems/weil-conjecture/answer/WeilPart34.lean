    change Order.krullDim (PrimeSpectrum P_κ) ≤ ((d : ℕ∞) : WithBot ℕ∞)
    rw [Order.krullDim_eq_iSup_length, WithBot.coe_le_coe]
    apply iSup_le
    intro l
