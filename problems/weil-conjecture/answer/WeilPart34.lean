      refine ⟨fun x₁ x₂ => ?_⟩
      suffices hz0 : ∀ z : CategoryTheory.Abelian.Ext Fℤ (SC_ab.map C_U).X₂ q, z = 0 by
        rw [hz0 x₁, hz0 x₂]
      intro z
      have hzg : z.comp (CategoryTheory.Abelian.Ext.mk₀ (SC_ab.map C_U).g) (Nat.add_zero q) = 0 :=
        @Subsingleton.elim (weilEtaleTorsionH U.left ℓ q) hSub_ℓ _ 0
      obtain ⟨w, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE_sh z hzg
      have hw0 : w = 0 := @Subsingleton.elim (weilEtaleTorsionH U.left n' q) hSub_n' w 0
      rw [hw0, CategoryTheory.Abelian.Ext.zero_comp]

theorem weil_weak_lefschetz_hyperplane_eigenvalue (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible X.hom]
    [AlgebraicGeometry.IsProper X.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) X.hom]
    (H : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible H.hom]
    [AlgebraicGeometry.IsProper H.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m) H.hom]
    (i_H : H ⟶ X)
    (hCl : AlgebraicGeometry.IsClosedImmersion i_H.left)
    (hAff : 1 ≤ m → ∃ U_aff : X.left.Opens,
      (U_aff : Set X.left) = (Set.range i_H.left.base)ᶜ ∧
      AlgebraicGeometry.IsAffineOpen U_aff)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (M_X : WeilEllAdicCohomologyModel F X ℓ (2 * m))
    (M_H : WeilEllAdicCohomologyModel F H ℓ (2 * m))
    (α : AlgebraicClosure (Padic ℓ))
    (hα : α ∈ ((M_X.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ))) :
    α ∈ ((M_H.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) :=
by
  classical
  
  have hOpenImmVanish :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (n q₂ : ℕ),
        Subsingleton (weilCupPDModH (U : AlgebraicGeometry.Scheme.{u}) n q₂) →
        let U_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι
          (inferInstance : AlgebraicGeometry.Etale U.ι)
        Subsingleton (CategoryTheory.Abelian.Ext.{u}
          (weilCupPDLocalFreeSheaf S n U_et) (weilCupPDModUnit S n) q₂) := by
    intro S U n q₂ hVan U_et
    let U₀ : AlgebraicGeometry.Scheme.{u} := (U : AlgebraicGeometry.Scheme.{u})
    let R : Type u := ULift.{u, 0} (ZMod n)
    let ModR := ModuleCat.{u, u} R
    let R_mod : ModR := ModuleCat.of R R
    let P_et : MorphismProperty Scheme.{u} := @AlgebraicGeometry.Etale
    have hEt_ι : P_et U.ι := inferInstance
    have : MorphismProperty.IsStableUnderComposition P_et :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have : MorphismProperty.HasPullbacksAlong P_et U.ι :=
      MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : MorphismProperty.IsStableUnderBaseChangeAlong P_et U.ι :=
      MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let E : U₀.Etale ⥤ S.Etale := MorphismProperty.Over.map (P := P_et) ⊤ hEt_ι
    let B : S.Etale ⥤ U₀.Etale := MorphismProperty.Over.pullback P_et ⊤ U.ι
    let adj_EB : E ⊣ B := MorphismProperty.Over.mapPullbackAdj P_et ⊤ U.ι hEt_ι trivial
    have hContB : B.IsContinuous S.smallEtaleTopology U₀.smallEtaleTopology := by
      let FgtU := Scheme.Etale.forget U₀
      let FgtS := Scheme.Etale.forget S
      have : Limits.PreservesLimits (CategoryTheory.Over.pullback U.ι) :=
        (CategoryTheory.Over.mapPullbackAdj U.ι).rightAdjoint_preservesLimits
      have : Limits.PreservesFiniteLimits (B ⋙ FgtU) := by
        change Limits.PreservesFiniteLimits (FgtS ⋙ CategoryTheory.Over.pullback U.ι)
        infer_instance
      have hLimB : Limits.PreservesFiniteLimits B :=
        Limits.preservesFiniteLimits_of_reflects_of_preserves B FgtU
      have hFlatB : RepresentablyFlat B := flat_of_preservesFiniteLimits B
      apply Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat U₀.smallEtaleTopology B)
      refine ⟨fun {V} {R_sieve} hR => ?_⟩
      have hJS := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S (le_refl P_et)
      have hJU := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology U₀ (le_refl P_et)
      have hR' : R_sieve ∈ (Scheme.smallPretopology P_et P_et).toGrothendieck V := by
        change R_sieve ∈ Scheme.smallGrothendieckTopology P_et S V at hR
        rwa [hJS] at hR
      have hR'' := (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) V R_sieve).mp hR'
      suffices hgoal : R_sieve.functorPushforward B ∈
          (Scheme.smallPretopology P_et P_et).toGrothendieck (B.obj V) by
        change R_sieve.functorPushforward B ∈ Scheme.smallGrothendieckTopology P_et U₀ (B.obj V)
        rwa [hJU]
      refine (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et)
        (B.obj V) (R_sieve.functorPushforward B)).mpr fun x => ?_
      let v_hom : (FgtS.obj V).left ⟶ S := (FgtS.obj V).hom
      let fst_V : Limits.pullback v_hom U.ι ⟶ (FgtS.obj V).left := Limits.pullback.fst v_hom U.ι
      let snd_V : Limits.pullback v_hom U.ι ⟶ U₀ := Limits.pullback.snd v_hom U.ι
      obtain ⟨Y, f, w, hRf, hf_et, hw⟩ := hR'' (fst_V x)
      let y_hom : (FgtS.obj Y).left ⟶ S := (FgtS.obj Y).hom
      let f_sch : (FgtS.obj Y).left ⟶ (FgtS.obj V).left := (FgtS.map f).left
      let fst_Y : Limits.pullback y_hom U.ι ⟶ (FgtS.obj Y).left := Limits.pullback.fst y_hom U.ι
      let snd_Y : Limits.pullback y_hom U.ι ⟶ U₀ := Limits.pullback.snd y_hom U.ι
      let u_over : FgtS.obj Y ⟶ FgtS.obj V := FgtS.map f
      let bf_sch : Limits.pullback y_hom U.ι ⟶ Limits.pullback v_hom U.ι :=
        ((CategoryTheory.Over.pullback U.ι).map u_over).left
      have hbf_fst : bf_sch ≫ fst_V = fst_Y ≫ f_sch := Limits.pullback.lift_fst _ _ _
      have hbf_snd : bf_sch ≫ snd_V = snd_Y := Limits.pullback.lift_snd _ _ _
      have hfy : f_sch ≫ v_hom = y_hom := CategoryTheory.Over.w u_over
      have h_outer : IsPullback (bf_sch ≫ snd_V) fst_Y U.ι (f_sch ≫ v_hom) := by
        rw [hbf_snd, hfy]
        exact (IsPullback.of_hasPullback y_hom U.ι).flip
      have hpb : IsPullback bf_sch fst_Y fst_V f_sch :=
        IsPullback.of_right h_outer hbf_fst (IsPullback.of_hasPullback v_hom U.ι).flip
      obtain ⟨z, hz_fst, -⟩ := Scheme.Pullback.exists_preimage_pullback x w (hw.symm : fst_V x = f_sch w)
      have hbf_et : P_et bf_sch :=
        MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hf_et
      have hpush_arrow : (R_sieve.functorPushforward B).arrows (B.map f) :=
        ⟨Y, f, 𝟙 (B.obj Y), hRf, (Category.id_comp _).symm⟩
      refine ⟨B.obj Y, B.map f, hpb.isoPullback.inv z, hpush_arrow, hbf_et, ?_⟩
      have hinv_fst : hpb.isoPullback.inv ≫ bf_sch = Limits.pullback.fst fst_V f_sch :=
        hpb.isoPullback_inv_fst
      change (hpb.isoPullback.inv ≫ bf_sch) z = x
      rw [hinv_fst]
      exact hz_fst
    have hContE : E.IsContinuous U₀.smallEtaleTopology S.smallEtaleTopology := by
      have hCompatE : CompatiblePreserving S.smallEtaleTopology E := by
        refine ⟨fun ℱ {Z} {T} {x} hx {Y₁ Y₂} {X} f₁ f₂ {g₁} {g₂} hg₁ hg₂ hcomm => ?_⟩
        have hf₁_et : P_et f₁.left :=
          MorphismProperty.of_postcomp P_et (W' := P_et) f₁.left (E.obj Y₁).hom
            (E.obj Y₁).prop ((MorphismProperty.Over.w f₁).symm ▸ X.prop)
        have hX_U_et : P_et (f₁.left ≫ Y₁.hom) :=
          MorphismProperty.comp_mem P_et f₁.left Y₁.hom hf₁_et Y₁.prop
        let X_U : U₀.Etale := MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) hX_U_et
        let f₁_U : X_U ⟶ Y₁ := MorphismProperty.Over.homMk f₁.left rfl trivial
        have hf₂_hom : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom := by
          apply (cancel_mono U.ι).mp
          calc
            (f₂.left ≫ Y₂.hom) ≫ U.ι = f₂.left ≫ (Y₂.hom ≫ U.ι) := Category.assoc _ _ _
            _ = X.hom := MorphismProperty.Over.w f₂
            _ = f₁.left ≫ (Y₁.hom ≫ U.ι) := (MorphismProperty.Over.w f₁).symm
            _ = (f₁.left ≫ Y₁.hom) ≫ U.ι := (Category.assoc _ _ _).symm
        let f₂_U : X_U ⟶ Y₂ := MorphismProperty.Over.homMk f₂.left hf₂_hom trivial
        have hcomm_U : f₁_U ≫ g₁ = f₂_U ≫ g₂ := by
          apply MorphismProperty.Over.Hom.ext
          exact congrArg (fun k => k.left) hcomm
        let e_X : X ⟶ E.obj X_U :=
          MorphismProperty.Over.homMk (𝟙 X.left)
            ((Category.id_comp _).trans
              ((Category.assoc f₁.left Y₁.hom U.ι).trans (MorphismProperty.Over.w f₁)))
            trivial
        have he₁ : e_X ≫ E.map f₁_U = f₁ :=
          MorphismProperty.Over.Hom.ext (Category.id_comp f₁.left)
        have he₂ : e_X ≫ E.map f₂_U = f₂ :=
          MorphismProperty.Over.Hom.ext (Category.id_comp f₂.left)
        have h_eq := hx f₁_U f₂_U hg₁ hg₂ hcomm_U
        have h_ap := congrArg (ℱ.obj.map e_X.op) h_eq
        change ℱ.obj.map f₁.op (x g₁ hg₁) = ℱ.obj.map f₂.op (x g₂ hg₂)
        rw [← he₁, ← he₂, op_comp, op_comp, ℱ.obj.map_comp, ℱ.obj.map_comp]
        exact h_ap
      apply Functor.isContinuous_of_coverPreserving hCompatE
      refine ⟨fun {W} {R_sieve} hR => ?_⟩
      have hJU := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology U₀ (le_refl P_et)
      have hJS := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S (le_refl P_et)
      have hR' : R_sieve ∈ (Scheme.smallPretopology P_et P_et).toGrothendieck W := by
        change R_sieve ∈ Scheme.smallGrothendieckTopology P_et U₀ W at hR
        rwa [hJU] at hR
      have hR'' := (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) W R_sieve).mp hR'
      suffices hgoal : R_sieve.functorPushforward E ∈
          (Scheme.smallPretopology P_et P_et).toGrothendieck (E.obj W) by
        change R_sieve.functorPushforward E ∈ Scheme.smallGrothendieckTopology P_et S (E.obj W)
        rwa [hJS]
      refine (Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et)
        (E.obj W) (R_sieve.functorPushforward E)).mpr fun x => ?_
      obtain ⟨Y, f, w, hRf, hf_et, hw⟩ := hR'' x
      have hpush_arrow : (R_sieve.functorPushforward E).arrows (E.map f) :=
        ⟨Y, f, 𝟙 (E.obj Y), hRf, (Category.id_comp _).symm⟩
      exact ⟨E.obj Y, E.map f, w, hpush_arrow, hf_et, hw⟩
    have := hContB
    have := hContE
    let Res : Sheaf S.smallEtaleTopology ModR ⥤ Sheaf U₀.smallEtaleTopology ModR :=
      E.sheafPushforwardContinuous ModR U₀.smallEtaleTopology S.smallEtaleTopology
    let Push : Sheaf U₀.smallEtaleTopology ModR ⥤ Sheaf S.smallEtaleTopology ModR :=
      B.sheafPushforwardContinuous ModR S.smallEtaleTopology U₀.smallEtaleTopology
    let preE : (S.Etaleᵒᵖ ⥤ ModR) ⥤ (U₀.Etaleᵒᵖ ⥤ ModR) :=
      { obj := fun P => E.op ⋙ P
        map := fun u => Functor.whiskerLeft E.op u
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    let preB : (U₀.Etaleᵒᵖ ⥤ ModR) ⥤ (S.Etaleᵒᵖ ⥤ ModR) :=
      { obj := fun Q => B.op ⋙ Q
        map := fun u => Functor.whiskerLeft B.op u
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    let adj_pre_EB : preE ⊣ preB :=
      Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun P =>
                { app := fun V => P.map (adj_EB.counit.app (Opposite.unop V)).op
                  naturality := fun {V₁ V₂} f => by
                    change P.map f ≫ P.map (adj_EB.counit.app (Opposite.unop V₂)).op =
                      P.map (adj_EB.counit.app (Opposite.unop V₁)).op ≫
                        P.map (E.map (B.map f.unop)).op
                    rw [← Functor.map_comp, ← Functor.map_comp]
                    congr 1
                    exact Quiver.Hom.unop_inj (adj_EB.counit.naturality f.unop).symm }
              naturality := fun {P₁ P₂} u =>
                NatTrans.ext (funext fun V =>
                  (u.naturality (adj_EB.counit.app (Opposite.unop V)).op).symm) }
          counit :=
            { app := fun Q =>
                { app := fun W => Q.map (adj_EB.unit.app (Opposite.unop W)).op
                  naturality := fun {W₁ W₂} f => by
                    change Q.map (B.map (E.map f.unop)).op ≫
                        Q.map (adj_EB.unit.app (Opposite.unop W₂)).op =
                      Q.map (adj_EB.unit.app (Opposite.unop W₁)).op ≫ Q.map f
                    rw [← Functor.map_comp, ← Functor.map_comp]
                    congr 1
                    exact Quiver.Hom.unop_inj (adj_EB.unit.naturality f.unop).symm }
              naturality := fun {Q₁ Q₂} u =>
                NatTrans.ext (funext fun W =>
                  (u.naturality (adj_EB.unit.app (Opposite.unop W)).op).symm) }
          left_triangle :=
            NatTrans.ext (funext fun P => NatTrans.ext (funext fun W => by
              change P.map (adj_EB.counit.app (E.obj (Opposite.unop W))).op ≫
                P.map (E.map (adj_EB.unit.app (Opposite.unop W))).op =
                𝟙 (P.obj (Opposite.op (E.obj (Opposite.unop W))))
              have htri : E.map (adj_EB.unit.app (Opposite.unop W)) ≫
                  adj_EB.counit.app (E.obj (Opposite.unop W)) = 𝟙 _ :=
                adj_EB.left_triangle_components (Opposite.unop W)
              rw [← Functor.map_comp, ← op_comp, htri, op_id]
              exact P.map_id _))
          right_triangle :=
            NatTrans.ext (funext fun Q => NatTrans.ext (funext fun V => by
              change Q.map (B.map (adj_EB.counit.app (Opposite.unop V))).op ≫
                Q.map (adj_EB.unit.app (B.obj (Opposite.unop V))).op =
                𝟙 (Q.obj (Opposite.op (B.obj (Opposite.unop V))))
              have htri : adj_EB.unit.app (B.obj (Opposite.unop V)) ≫
                  B.map (adj_EB.counit.app (Opposite.unop V)) = 𝟙 _ :=
                adj_EB.right_triangle_components (Opposite.unop V)
              rw [← Functor.map_comp, ← op_comp, htri, op_id]
              exact Q.map_id _)) }
    let adj_Res_Push : Res ⊣ Push :=
      Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun ℱ => { hom := adj_pre_EB.unit.app ℱ.obj }
              naturality := fun {ℱ₁ ℱ₂} u =>
                ObjectProperty.hom_ext _ (adj_pre_EB.unit.naturality u.hom) }
          counit :=
            { app := fun 𝒢 => { hom := adj_pre_EB.counit.app 𝒢.obj }
              naturality := fun {𝒢₁ 𝒢₂} u =>
                ObjectProperty.hom_ext _ (adj_pre_EB.counit.naturality u.hom) }
          left_triangle :=
            NatTrans.ext (funext fun ℱ => ObjectProperty.hom_ext _
              (congrArg (fun η => η.app ℱ.obj) adj_pre_EB.left_triangle))
          right_triangle :=
            NatTrans.ext (funext fun 𝒢 => ObjectProperty.hom_ext _
              (congrArg (fun η => η.app 𝒢.obj) adj_pre_EB.right_triangle)) }
    have : Limits.PreservesFiniteColimits Res := by
      have := adj_Res_Push.leftAdjoint_preservesColimits
      infer_instance
    let adj1 := (sheafificationAdjunction S.smallEtaleTopology ModR).comp adj_Res_Push
    let e_right : sheafToPresheaf U₀.smallEtaleTopology ModR ⋙ preB ≅
        Push ⋙ sheafToPresheaf S.smallEtaleTopology ModR :=
      NatIso.ofComponents (fun _ => Iso.refl _)
        (fun _ => NatTrans.ext (funext fun _ => (Category.comp_id _).trans (Category.id_comp _).symm))
    let adj2 := (adj_pre_EB.comp (sheafificationAdjunction U₀.smallEtaleTopology ModR)).ofNatIsoRight e_right
    let e_res_sh : presheafToSheaf S.smallEtaleTopology ModR ⋙ Res ≅
        preE ⋙ presheafToSheaf U₀.smallEtaleTopology ModR :=
      adj1.leftAdjointUniq adj2
    let iso_Res_unit : Res.obj (weilCupPDModUnit S n) ≅ weilCupPDModUnit U₀ n :=
      e_res_sh.app ((Functor.const S.Etaleᵒᵖ).obj R_mod)
    let InOpen : S.Etale → Prop := fun V => Set.range V.hom.base ⊆ Set.range U.ι.base
    let liftHom : ∀ (V : S.Etale), InOpen V → (V.left ⟶ U₀) :=
      fun V h => AlgebraicGeometry.IsOpenImmersion.lift U.ι V.hom h
    have hlift_fac : ∀ (V : S.Etale) (h : InOpen V), liftHom V h ≫ U.ι = V.hom :=
      fun V h => AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι V.hom h
    have hlift_et : ∀ (V : S.Etale) (h : InOpen V), P_et (liftHom V h) :=
      fun V h => MorphismProperty.of_postcomp P_et (W' := P_et) (liftHom V h) U.ι
        hEt_ι ((hlift_fac V h).symm ▸ V.prop)
    let liftObj : ∀ (V : S.Etale), InOpen V → U₀.Etale :=
      fun V h => MorphismProperty.Over.mk ⊤ (liftHom V h) (hlift_et V h)
    have inOpen_of_hom : ∀ {V₁ V₂ : S.Etale} (u : V₁ ⟶ V₂), InOpen V₂ → InOpen V₁ := by
      intro V₁ V₂ u h₂ y hy
      rcases hy with ⟨x, rfl⟩
      have hw : V₁.hom.base x = V₂.hom.base (u.left.base x) := by
        change (V₁.hom) x = (u.left ≫ V₂.hom) x
        rw [MorphismProperty.Over.w u]
      rw [hw]
      exact h₂ ⟨u.left.base x, rfl⟩
    have hliftMap_w : ∀ {V₁ V₂ : S.Etale} (u : V₁ ⟶ V₂) (h₁ : InOpen V₁) (h₂ : InOpen V₂),
        u.left ≫ (liftObj V₂ h₂).hom = (liftObj V₁ h₁).hom := by
      intro V₁ V₂ u h₁ h₂
      change u.left ≫ liftHom V₂ h₂ = liftHom V₁ h₁
      apply (cancel_mono U.ι).mp
      rw [Category.assoc, hlift_fac V₂ h₂, MorphismProperty.Over.w u, hlift_fac V₁ h₁]
    let liftMap : ∀ {V₁ V₂ : S.Etale} (u : V₁ ⟶ V₂) (h₁ : InOpen V₁) (h₂ : InOpen V₂),
        liftObj V₁ h₁ ⟶ liftObj V₂ h₂ :=
      fun {V₁ V₂} u h₁ h₂ => MorphismProperty.Over.homMk u.left (hliftMap_w u h₁ h₂) trivial
    have hliftMap_id : ∀ (V : S.Etale) (h : InOpen V),
        liftMap (𝟙 V) h h = 𝟙 (liftObj V h) :=
      fun _ _ => MorphismProperty.Over.Hom.ext rfl
    have hliftMap_comp : ∀ {V₁ V₂ V₃ : S.Etale} (u : V₁ ⟶ V₂) (v : V₂ ⟶ V₃)
        (h₁ : InOpen V₁) (h₂ : InOpen V₂) (h₃ : InOpen V₃),
        liftMap (u ≫ v) h₁ h₃ = liftMap u h₁ h₂ ≫ liftMap v h₂ h₃ :=
      fun _ _ _ _ _ => MorphismProperty.Over.Hom.ext rfl
    let Z₀ : ModR := ModuleCat.of R PUnit.{u + 1}
    have hSubZ₀ : ∀ (X₀ : ModR), Subsingleton (Z₀ ⟶ X₀) :=
      fun X₀ => ⟨fun f g => ModuleCat.hom_ext (LinearMap.ext fun p => by
        have hp : p = 0 := Subsingleton.elim p 0
        rw [hp, map_zero, map_zero])⟩
    have hSubToZ₀ : ∀ (X₀ : ModR), Subsingleton (X₀ ⟶ Z₀) :=
      fun X₀ => ⟨fun f g => ModuleCat.hom_ext (LinearMap.ext fun _ => Subsingleton.elim _ _)⟩
    let L_pre_obj : (U₀.Etaleᵒᵖ ⥤ ModR) → S.Etaleᵒᵖ → ModR :=
      fun P opV =>
        if h : InOpen (Opposite.unop opV) then
          P.obj (Opposite.op (liftObj (Opposite.unop opV) h))
        else Z₀
    let fromLPre : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) (opV : S.Etaleᵒᵖ) (h : InOpen (Opposite.unop opV)),
        L_pre_obj P opV ⟶ P.obj (Opposite.op (liftObj (Opposite.unop opV) h)) :=
      fun P opV h => eqToHom (by simp only [L_pre_obj, h, ↓reduceDIte])
    let toLPre : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) (opV : S.Etaleᵒᵖ) (h : InOpen (Opposite.unop opV)),
        P.obj (Opposite.op (liftObj (Opposite.unop opV) h)) ⟶ L_pre_obj P opV :=
      fun P opV h => eqToHom (by simp only [L_pre_obj, h, ↓reduceDIte])
    have hFromTo : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) (opV : S.Etaleᵒᵖ) (h : InOpen (Opposite.unop opV)),
        fromLPre P opV h ≫ toLPre P opV h = 𝟙 (L_pre_obj P opV) :=
      fun _ _ _ => (eqToHom_trans _ _).trans (eqToHom_refl _ _)
    have hToFrom : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) (opV : S.Etaleᵒᵖ) (h : InOpen (Opposite.unop opV)),
        toLPre P opV h ≫ fromLPre P opV h = 𝟙 _ :=
      fun _ _ _ => (eqToHom_trans _ _).trans (eqToHom_refl _ _)
    have hSubNeg : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) (opV : S.Etaleᵒᵖ)
        (_ : ¬ InOpen (Opposite.unop opV)) {Y : ModR} (a b : L_pre_obj P opV ⟶ Y), a = b :=
      fun P opV h {Y} a b => by
        have hZ : L_pre_obj P opV = Z₀ := by simp only [L_pre_obj, h, ↓reduceDIte]
        exact (cancel_epi (eqToHom hZ.symm)).mp ((hSubZ₀ Y).elim _ _)
    have hSubToNeg : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) (opV : S.Etaleᵒᵖ)
        (_ : ¬ InOpen (Opposite.unop opV)) {W : ModR} (a b : W ⟶ L_pre_obj P opV), a = b :=
      fun P opV h {W} a b => by
        have hZ : L_pre_obj P opV = Z₀ := by simp only [L_pre_obj, h, ↓reduceDIte]
        exact (cancel_mono (eqToHom hZ)).mp ((hSubToZ₀ W).elim _ _)
    let L_pre_map : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) {opV₂ opV₁ : S.Etaleᵒᵖ} (f : opV₂ ⟶ opV₁),
        L_pre_obj P opV₂ ⟶ L_pre_obj P opV₁ :=
      fun P {opV₂ opV₁} f =>
        if h₂ : InOpen (Opposite.unop opV₂) then
          let h₁ : InOpen (Opposite.unop opV₁) := inOpen_of_hom f.unop h₂
          fromLPre P opV₂ h₂ ≫ P.map (liftMap f.unop h₁ h₂).op ≫ toLPre P opV₁ h₁
        else 0
    have hLpre_map_pos : ∀ (P : U₀.Etaleᵒᵖ ⥤ ModR) {opV₂ opV₁ : S.Etaleᵒᵖ} (f : opV₂ ⟶ opV₁)
        (h₂ : InOpen (Opposite.unop opV₂)),
        L_pre_map P f = fromLPre P opV₂ h₂ ≫
          P.map (liftMap f.unop (inOpen_of_hom f.unop h₂) h₂).op ≫
          toLPre P opV₁ (inOpen_of_hom f.unop h₂) :=
      fun P {opV₂ opV₁} f h₂ => by simp only [L_pre_map, h₂, ↓reduceDIte]
    let L_pre_nat_app : ∀ {P₁ P₂ : U₀.Etaleᵒᵖ ⥤ ModR} (α_nat : P₁ ⟶ P₂) (opV : S.Etaleᵒᵖ),
        L_pre_obj P₁ opV ⟶ L_pre_obj P₂ opV :=
      fun {P₁ P₂} α_nat opV =>
        if h : InOpen (Opposite.unop opV) then
          fromLPre P₁ opV h ≫ α_nat.app (Opposite.op (liftObj (Opposite.unop opV) h)) ≫
            toLPre P₂ opV h
        else 0
    have hLpre_nat_pos : ∀ {P₁ P₂ : U₀.Etaleᵒᵖ ⥤ ModR} (α_nat : P₁ ⟶ P₂) (opV : S.Etaleᵒᵖ)
        (h : InOpen (Opposite.unop opV)),
        L_pre_nat_app α_nat opV =
          fromLPre P₁ opV h ≫ α_nat.app (Opposite.op (liftObj (Opposite.unop opV) h)) ≫
            toLPre P₂ opV h :=
      fun {P₁ P₂} α_nat opV h => by simp only [L_pre_nat_app, h, ↓reduceDIte]
    let L_pre : (U₀.Etaleᵒᵖ ⥤ ModR) ⥤ (S.Etaleᵒᵖ ⥤ ModR) :=
      { obj := fun P =>
          { obj := L_pre_obj P
            map := fun f => L_pre_map P f
            map_id := fun opV => by
              by_cases h : InOpen (Opposite.unop opV)
              · rw [hLpre_map_pos P (𝟙 opV) h]
                have hid : (𝟙 opV).unop = 𝟙 (Opposite.unop opV) := rfl
                rw [hid, hliftMap_id, op_id, P.map_id, Category.id_comp, hFromTo]
              · exact hSubNeg P opV h _ _
            map_comp := fun {opV₃ opV₂ opV₁} f g => by
              by_cases h₃ : InOpen (Opposite.unop opV₃)
              · have h₂ : InOpen (Opposite.unop opV₂) := inOpen_of_hom f.unop h₃
                have h₁ : InOpen (Opposite.unop opV₁) := inOpen_of_hom g.unop h₂
                have h₁' : InOpen (Opposite.unop opV₁) := inOpen_of_hom (f ≫ g).unop h₃
                rw [hLpre_map_pos P (f ≫ g) h₃, hLpre_map_pos P f h₃, hLpre_map_pos P g h₂]
                have hmap : liftMap (f ≫ g).unop h₁' h₃ =
                    liftMap g.unop h₁ h₂ ≫ liftMap f.unop h₂ h₃ :=
                  hliftMap_comp g.unop f.unop h₁ h₂ h₃
                rw [hmap, op_comp, P.map_comp]
                simp only [Category.assoc]
                rw [← Category.assoc (toLPre P opV₂ h₂), hToFrom, Category.id_comp]
              · exact hSubNeg P opV₃ h₃ _ _ }
        map := fun {P₁ P₂} α_nat =>
          { app := fun opV => L_pre_nat_app α_nat opV
            naturality := fun {opV₂ opV₁} f => by
              by_cases h₂ : InOpen (Opposite.unop opV₂)
              · have h₁ : InOpen (Opposite.unop opV₁) := inOpen_of_hom f.unop h₂
                change L_pre_map P₁ f ≫ L_pre_nat_app α_nat opV₁ =
                  L_pre_nat_app α_nat opV₂ ≫ L_pre_map P₂ f
                rw [hLpre_map_pos P₁ f h₂, hLpre_nat_pos α_nat opV₁ h₁,
                  hLpre_nat_pos α_nat opV₂ h₂, hLpre_map_pos P₂ f h₂]
                simp only [Category.assoc]
                rw [← Category.assoc (toLPre P₁ opV₁ h₁), hToFrom, Category.id_comp,
                  ← Category.assoc (toLPre P₂ opV₂ h₂), hToFrom, Category.id_comp,
                  ← Category.assoc (P₁.map _), α_nat.naturality (liftMap f.unop h₁ h₂).op,
                  Category.assoc]
              · exact hSubNeg P₁ opV₂ h₂ _ _ }
        map_id := fun P => NatTrans.ext (funext fun opV => by
          by_cases h : InOpen (Opposite.unop opV)
          · change L_pre_nat_app (𝟙 P) opV = 𝟙 (L_pre_obj P opV)
            rw [hLpre_nat_pos (𝟙 P) opV h, NatTrans.id_app, Category.id_comp, hFromTo]
          · exact hSubNeg P opV h _ _)
        map_comp := fun {P₁ P₂ P₃} α_nat β_nat => NatTrans.ext (funext fun opV => by
          by_cases h : InOpen (Opposite.unop opV)
          · change L_pre_nat_app (α_nat ≫ β_nat) opV =
              L_pre_nat_app α_nat opV ≫ L_pre_nat_app β_nat opV
            rw [hLpre_nat_pos (α_nat ≫ β_nat) opV h, hLpre_nat_pos α_nat opV h,
              hLpre_nat_pos β_nat opV h, NatTrans.comp_app]
            simp only [Category.assoc]
            rw [← Category.assoc (toLPre P₂ opV h), hToFrom, Category.id_comp]
          · exact hSubNeg P₁ opV h _ _) }
    have : L_pre.PreservesMonomorphisms :=
      { preserves := fun {P₁ P₂} α_nat _ => by
          rw [NatTrans.mono_iff_mono_app]
          intro opV
          by_cases h : InOpen (Opposite.unop opV)
          · change Mono (L_pre_nat_app α_nat opV)
            rw [hLpre_nat_pos α_nat opV h]
            have : Mono (α_nat.app (Opposite.op (liftObj (Opposite.unop opV) h))) := inferInstance
            have : Mono (fromLPre P₁ opV h) := inferInstance
            have : Mono (toLPre P₂ opV h) := inferInstance
            exact mono_comp _ _
          · exact ⟨fun {W} u v _ => hSubToNeg P₁ opV h u v⟩ }
    have hEW : ∀ W : U₀.Etale, InOpen (E.obj W) := by
      intro W y hy
      rcases hy with ⟨x, rfl⟩
      exact ⟨W.hom.base x, rfl⟩
    let isoLiftEW : ∀ W : U₀.Etale, liftObj (E.obj W) (hEW W) ≅ W :=
      fun W => MorphismProperty.Over.isoMk (Iso.refl W.left)
        ((Category.id_comp W.hom).trans
          ((cancel_mono U.ι).mp (hlift_fac (E.obj W) (hEW W))).symm)
    let homToELift : ∀ (V : S.Etale) (h : InOpen V), V ⟶ E.obj (liftObj V h) :=
      fun V h => MorphismProperty.Over.homMk (𝟙 V.left)
        ((Category.id_comp _).trans (hlift_fac V h)) trivial
    let counitMapPre : ∀ {P : U₀.Etaleᵒᵖ ⥤ ModR} {Q : S.Etaleᵒᵖ ⥤ ModR}
        (β : P ⟶ preE.obj Q) (opV : S.Etaleᵒᵖ), L_pre_obj P opV ⟶ Q.obj opV :=
      fun {P Q} β opV =>
        if h : InOpen (Opposite.unop opV) then
          fromLPre P opV h ≫ β.app (Opposite.op (liftObj (Opposite.unop opV) h)) ≫
            Q.map (homToELift (Opposite.unop opV) h).op
        else 0
    have hcounitMapPre_pos : ∀ {P : U₀.Etaleᵒᵖ ⥤ ModR} {Q : S.Etaleᵒᵖ ⥤ ModR}
        (β : P ⟶ preE.obj Q) (opV : S.Etaleᵒᵖ) (h : InOpen (Opposite.unop opV)),
        counitMapPre β opV =
          fromLPre P opV h ≫ β.app (Opposite.op (liftObj (Opposite.unop opV) h)) ≫
            Q.map (homToELift (Opposite.unop opV) h).op :=
      fun {P Q} β opV h => by simp only [counitMapPre, h, ↓reduceDIte]
    let adj_Lpre : L_pre ⊣ preE :=
      Adjunction.mkOfHomEquiv
        { homEquiv := fun P Q =>
            { toFun := fun α_nat =>
                { app := fun opW =>
                    let W := Opposite.unop opW
                    P.map (isoLiftEW W).hom.op ≫ toLPre P (Opposite.op (E.obj W)) (hEW W) ≫
                      α_nat.app (Opposite.op (E.obj W))
                  naturality := fun {opW₂ opW₁} g => by
                    let W₂ := Opposite.unop opW₂
                    let W₁ := Opposite.unop opW₁
                    have hcomm_lift : (isoLiftEW W₁).hom ≫ g.unop =
                        liftMap (E.map g.unop) (hEW W₁) (hEW W₂) ≫ (isoLiftEW W₂).hom :=
                      MorphismProperty.Over.Hom.ext
                        ((Category.id_comp g.unop.left).trans (Category.comp_id g.unop.left).symm)
                    have hnat_α := α_nat.naturality (E.map g.unop).op
                    change L_pre_map P (E.map g.unop).op ≫ α_nat.app (Opposite.op (E.obj W₁)) =
                      α_nat.app (Opposite.op (E.obj W₂)) ≫ Q.map (E.map g.unop).op at hnat_α
                    rw [hLpre_map_pos P (E.map g.unop).op (hEW W₂)] at hnat_α
                    have h_eq1 : P.map (liftMap (E.map g.unop) (hEW W₁) (hEW W₂)).op ≫
                        toLPre P (Opposite.op (E.obj W₁)) (hEW W₁) ≫
                          α_nat.app (Opposite.op (E.obj W₁)) =
                        toLPre P (Opposite.op (E.obj W₂)) (hEW W₂) ≫
                          α_nat.app (Opposite.op (E.obj W₂)) ≫ Q.map (E.map g.unop).op := by
                      have hpre := congrArg (toLPre P (Opposite.op (E.obj W₂)) (hEW W₂) ≫ ·) hnat_α
                      simp only [Category.assoc] at hpre
                      rwa [← Category.assoc (toLPre P (Opposite.op (E.obj W₂)) (hEW W₂)),
                        hToFrom, Category.id_comp] at hpre
                    have hg_eq : g = g.unop.op := rfl
                    change (P.map g ≫ P.map (isoLiftEW W₁).hom.op) ≫
                        toLPre P (Opposite.op (E.obj W₁)) (hEW W₁) ≫
                          α_nat.app (Opposite.op (E.obj W₁)) =
                      P.map (isoLiftEW W₂).hom.op ≫ toLPre P (Opposite.op (E.obj W₂)) (hEW W₂) ≫
                        α_nat.app (Opposite.op (E.obj W₂)) ≫ Q.map (E.map g.unop).op
                    rw [hg_eq, ← P.map_comp, ← op_comp, hcomm_lift, op_comp, P.map_comp,
                      Category.assoc, h_eq1]
                    rfl }
              invFun := fun β =>
                { app := fun opV => counitMapPre β opV
                  naturality := fun {opV₂ opV₁} f => by
                    by_cases h₂ : InOpen (Opposite.unop opV₂)
                    · have h₁ : InOpen (Opposite.unop opV₁) := inOpen_of_hom f.unop h₂
                      change L_pre_map P f ≫ counitMapPre β opV₁ = counitMapPre β opV₂ ≫ Q.map f
                      rw [hLpre_map_pos P f h₂, hcounitMapPre_pos β opV₁ h₁,
                        hcounitMapPre_pos β opV₂ h₂]
                      simp only [Category.assoc]
                      rw [← Category.assoc (toLPre P opV₁ h₁), hToFrom, Category.id_comp]
                      have hnat_β := β.naturality (liftMap f.unop h₁ h₂).op
                      have hcomm_E : f.unop ≫ homToELift (Opposite.unop opV₂) h₂ =
                          homToELift (Opposite.unop opV₁) h₁ ≫ E.map (liftMap f.unop h₁ h₂) :=
                        MorphismProperty.Over.Hom.ext
                          ((Category.comp_id f.unop.left).trans (Category.id_comp f.unop.left).symm)
                      have hf_eq : f = f.unop.op := rfl
                      rw [← Category.assoc (P.map _), hnat_β, Category.assoc]
                      change fromLPre P opV₂ h₂ ≫
                          (β.app _ ≫ Q.map (E.map (liftMap f.unop h₁ h₂)).op ≫
                            Q.map (homToELift (Opposite.unop opV₁) h₁).op) =
                        fromLPre P opV₂ h₂ ≫
                          (β.app _ ≫ Q.map (homToELift (Opposite.unop opV₂) h₂).op ≫ Q.map f)
                      rw [hf_eq, ← Q.map_comp, ← Q.map_comp, ← op_comp, ← op_comp, hcomm_E]
                      rfl
                    · exact hSubNeg P opV₂ h₂ _ _ }
              left_inv := fun α_nat => NatTrans.ext (funext fun opV => by
                let V := Opposite.unop opV
                by_cases h : InOpen V
                · change counitMapPre _ opV = α_nat.app opV
                  rw [hcounitMapPre_pos _ opV h]
                  dsimp only
                  let W₀ := liftObj V h
                  let opEW₀ := Opposite.op (E.obj W₀)
                  have hnat_α := α_nat.naturality (homToELift V h).op
                  change L_pre_map P (homToELift V h).op ≫ α_nat.app opV =
                    α_nat.app opEW₀ ≫ Q.map (homToELift V h).op at hnat_α
                  have hlmap : liftMap (homToELift V h) h (hEW W₀) = (isoLiftEW W₀).inv :=
                    MorphismProperty.Over.Hom.ext rfl
                  calc
                    fromLPre P opV h ≫
                        (P.map (isoLiftEW W₀).hom.op ≫ toLPre P opEW₀ (hEW W₀) ≫
                          α_nat.app opEW₀) ≫ Q.map (homToELift V h).op
                      = fromLPre P opV h ≫ P.map (isoLiftEW W₀).hom.op ≫
                          toLPre P opEW₀ (hEW W₀) ≫
                          (α_nat.app opEW₀ ≫ Q.map (homToELift V h).op) := by
                          simp only [Category.assoc]
                    _ = fromLPre P opV h ≫ P.map (isoLiftEW W₀).hom.op ≫
                          toLPre P opEW₀ (hEW W₀) ≫
                          (L_pre_map P (homToELift V h).op ≫ α_nat.app opV) := by
                          rw [← hnat_α]
                    _ = fromLPre P opV h ≫ P.map (isoLiftEW W₀).hom.op ≫
                          (toLPre P opEW₀ (hEW W₀) ≫ fromLPre P opEW₀ (hEW W₀)) ≫
                          P.map (liftMap (homToELift V h) h (hEW W₀)).op ≫
                          toLPre P opV h ≫ α_nat.app opV := by
                          rw [hLpre_map_pos P (homToELift V h).op (hEW W₀)]
                          simp only [Category.assoc]; rfl
                    _ = fromLPre P opV h ≫
                          (P.map (isoLiftEW W₀).hom.op ≫ P.map (isoLiftEW W₀).inv.op) ≫
                          toLPre P opV h ≫ α_nat.app opV := by
                          rw [hToFrom, Category.id_comp, hlmap]
                          simp only [Category.assoc]
                    _ = (fromLPre P opV h ≫ toLPre P opV h) ≫ α_nat.app opV := by
                          rw [← P.map_comp, ← op_comp, (isoLiftEW W₀).inv_hom_id, op_id, P.map_id,
                            Category.id_comp, Category.assoc]
                    _ = α_nat.app opV := by rw [hFromTo, Category.id_comp]
                · exact hSubNeg P opV h _ _)
              right_inv := fun β => NatTrans.ext (funext fun opW => by
                let W := Opposite.unop opW
                dsimp only
                rw [hcounitMapPre_pos β (Opposite.op (E.obj W)) (hEW W)]
                rw [← Category.assoc (toLPre P (Opposite.op (E.obj W)) (hEW W)),
                  hToFrom, Category.id_comp]
                have hnat_β := β.naturality (isoLiftEW W).hom.op
                rw [← Category.assoc (P.map _), hnat_β, Category.assoc]
                change β.app opW ≫ Q.map (E.map (isoLiftEW W).hom).op ≫
                    Q.map (homToELift (E.obj W) (hEW W)).op = β.app opW
                rw [← Q.map_comp, ← op_comp]
                have hcomp_id : homToELift (E.obj W) (hEW W) ≫ E.map (isoLiftEW W).hom = 𝟙 (E.obj W) :=
                  MorphismProperty.Over.Hom.ext (Category.id_comp (𝟙 W.left))
                have hqid : Q.map (𝟙 (Opposite.op (E.obj W))) = 𝟙 (Q.obj (Opposite.op (E.obj W))) :=
                  Q.map_id (Opposite.op (E.obj W))
                rw [hcomp_id, op_id, hqid]
                exact Category.comp_id _) }
          homEquiv_naturality_left_symm := fun {P' P Q} γ β => NatTrans.ext (funext fun opV => by
            by_cases h : InOpen (Opposite.unop opV)
            · change counitMapPre _ opV = L_pre_nat_app γ opV ≫ counitMapPre β opV
              rw [hcounitMapPre_pos _ opV h, hLpre_nat_pos γ opV h, hcounitMapPre_pos β opV h]
              simp only [NatTrans.comp_app, Category.assoc]
              rw [← Category.assoc (toLPre P opV h), hToFrom, Category.id_comp]
            · exact hSubNeg P' opV h _ _)
          homEquiv_naturality_right := fun {P Q Q'} α_nat δ => NatTrans.ext (funext fun opW => by
            dsimp only [preE]
            simp only [NatTrans.comp_app]; rfl) }
    let j_shriek : Sheaf U₀.smallEtaleTopology ModR ⥤ Sheaf S.smallEtaleTopology ModR :=
      sheafToPresheaf U₀.smallEtaleTopology ModR ⋙ L_pre ⋙ presheafToSheaf S.smallEtaleTopology ModR
    have : (sheafToPresheaf U₀.smallEtaleTopology ModR).PreservesMonomorphisms := inferInstance
    have : (presheafToSheaf S.smallEtaleTopology ModR).PreservesMonomorphisms := inferInstance
    have : j_shriek.PreservesMonomorphisms := by
      dsimp only [j_shriek]
      infer_instance
    let adj_j_Res : j_shriek ⊣ Res :=
      Adjunction.mkOfHomEquiv
        { homEquiv := fun ℱ 𝒢 =>
            ((sheafificationAdjunction S.smallEtaleTopology ModR).homEquiv
              (L_pre.obj ℱ.obj) 𝒢).trans
              ((adj_Lpre.homEquiv ℱ.obj 𝒢.obj).trans
                { toFun := fun β => { hom := β }
                  invFun := fun β => β.hom
                  left_inv := fun _ => rfl
                  right_inv := fun _ => rfl })
          homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} f g => by
            dsimp only [Equiv.symm_trans_apply, j_shriek, Functor.comp_map]
            have h1 := adj_Lpre.homEquiv_naturality_left_symm f.hom g.hom
            have h2 := (sheafificationAdjunction S.smallEtaleTopology ModR).homEquiv_naturality_left_symm
              (L_pre.map f.hom) ((adj_Lpre.homEquiv ℱ.obj 𝒢.obj).symm g.hom)
            exact (congrArg ((sheafificationAdjunction S.smallEtaleTopology ModR).homEquiv _ _).symm h1).trans h2
          homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} f g => by
            apply ObjectProperty.hom_ext
            dsimp only [Equiv.trans_apply, j_shriek]
            have h1 := (sheafificationAdjunction S.smallEtaleTopology ModR).homEquiv_naturality_right f g
            exact congrArg (adj_Lpre.homEquiv ℱ.obj 𝒢'.obj) h1 }
    let T_U : U₀.Etale := MorphismProperty.Over.mk ⊤ (𝟙 U₀) (inferInstance : P_et (𝟙 U₀))
    have hT_U : Limits.IsTerminal T_U :=
      Limits.IsTerminal.ofUniqueHom
        (fun W => MorphismProperty.Over.homMk W.hom (Category.comp_id W.hom) trivial)
        (fun W m_hom => MorphismProperty.Over.Hom.ext
          ((MorphismProperty.Over.w m_hom).symm.trans (Category.comp_id m_hom.left)).symm)
    let adj_constU := constantSheafAdj U₀.smallEtaleTopology ModR hT_U
    let iso_ETU : E.obj T_U ≅ U_et :=
      MorphismProperty.Over.isoMk (Iso.refl U₀)
        ((Category.id_comp U.ι).trans (Category.id_comp U.ι).symm)
    let e_sec_ETU : ∀ 𝒢 : Sheaf S.smallEtaleTopology ModR,
        (R_mod ⟶ ((sheafSections U₀.smallEtaleTopology ModR).obj (Opposite.op T_U)).obj (Res.obj 𝒢)) ≃
          (R_mod ⟶ 𝒢.obj.obj (Opposite.op U_et)) :=
      fun 𝒢 =>
