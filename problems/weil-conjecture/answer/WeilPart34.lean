theorem weil_codim1_purity_h1_local_span_of_stalk_card_prime (Y U : AlgebraicGeometry.Scheme.{u})
    (j_U : U ⟶ Y) [AlgebraicGeometry.IsOpenImmersion j_U]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (ξ₀ : weilEtaleTorsionH U ℓ 1)
    (hOpenZero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
