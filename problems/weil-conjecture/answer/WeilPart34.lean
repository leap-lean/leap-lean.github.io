      have hΨΦ : ∀ {X Y : 𝒟₁} (f : F₂.obj (F₁.obj X) ⟶ Y), Ψ X Y (Φ X Y f) = f := by
        intro X Y f
        dsimp only [Φ, Ψ]
        rw [Category.assoc, (v Y).hom_inv_id, Category.comp_id,
