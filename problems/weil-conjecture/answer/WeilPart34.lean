      let G₀ := L₂.obj (L₁.obj R₀)
      rw [← CategoryTheory.Adjunction.homEquiv_unit adj₁₂ R₀ G₀ (η_hom R₀)]
      change (adj₁₂.homEquiv R₀ G₀)
        ((adj₁₂.homEquiv R₀ G₀).symm
          (((adj₁.homEquiv R₀ (R₂.obj G₀))
            ((adj₂.homEquiv (L₁.obj R₀) G₀) (𝟙 G₀))) ≫ (e_R G₀).inv)) = _
      have h_u2 : (adj₂.homEquiv (L₁.obj R₀) G₀) (𝟙 G₀) = adj₂.unit.app (L₁.obj R₀) :=
        (CategoryTheory.Adjunction.homEquiv_unit adj₂ (L₁.obj R₀) G₀ (𝟙 G₀)).trans
          ((congrArg (adj₂.unit.app (L₁.obj R₀) ≫ ·) (R₂.map_id G₀)).trans
            (Category.comp_id _))
      rw [Equiv.apply_symm_apply, h_u2,
        CategoryTheory.Adjunction.homEquiv_unit adj₁ R₀ (R₂.obj G₀),
        Category.assoc]

  have hAdjIdMateGen :
      ∀ {𝒞₀ : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞₀]
        {L : 𝒞₀ ⥤ 𝒞₀} {R : 𝒞₀ ⥤ 𝒞₀}
        (adj : L ⊣ R)
        (e_R : ∀ H : 𝒞₀, R.obj H ≅ H)
        (_he_R_nat : ∀ {H H' : 𝒞₀} (k : H ⟶ H'),
          k ≫ (e_R H').inv = (e_R H).inv ≫ R.map k),
        ∃ (η_id_hom : ∀ F : 𝒞₀, L.obj F ⟶ F)
          (η_id_inv : ∀ F : 𝒞₀, F ⟶ L.obj F),
          (∀ F, η_id_hom F ≫ η_id_inv F = 𝟙 (L.obj F)) ∧
          (∀ F, η_id_inv F ≫ η_id_hom F = 𝟙 F) ∧
          (∀ {F' F : 𝒞₀} (k : F' ⟶ F), L.map k ≫ η_id_hom F = η_id_hom F' ≫ k) ∧
          (∀ {F : 𝒞₀} (c : L.obj F ⟶ F),
            adj.homEquiv F F c = (e_R F).inv → η_id_inv F ≫ c = 𝟙 F) ∧
          (∀ R₀ : 𝒞₀, adj.unit.app R₀ ≫ R.map (η_id_hom R₀) = (e_R R₀).inv) := by
    clear * -
    intro 𝒞₀ _ L R adj e_R he_R_nat
    let Θ_id : ∀ (F H : 𝒞₀), (F ⟶ H) ≃ (L.obj F ⟶ H) :=
      fun F H =>
        { toFun := fun u => (adj.homEquiv F H).symm (u ≫ (e_R H).inv)
          invFun := fun v => (adj.homEquiv F H v) ≫ (e_R H).hom
          left_inv := fun u => by
            dsimp only
            rw [Equiv.apply_symm_apply, Category.assoc, (e_R H).inv_hom_id, Category.comp_id]
          right_inv := fun v => by
            dsimp only
            rw [Category.assoc, (e_R H).hom_inv_id, Category.comp_id, Equiv.symm_apply_apply] }
    have hΘ_id_right : ∀ {F H H' : 𝒞₀} (u : F ⟶ H) (k : H ⟶ H'),
        Θ_id F H' (u ≫ k) = Θ_id F H u ≫ k := by
      intro F H H' u k
      change (adj.homEquiv F H').symm ((u ≫ k) ≫ (e_R H').inv) =
        (adj.homEquiv F H).symm (u ≫ (e_R H).inv) ≫ k
      rw [Category.assoc u k, he_R_nat k, ← Category.assoc u,
        CategoryTheory.Adjunction.homEquiv_naturality_right_symm]
    have hΘ_id_left : ∀ {F' F H : 𝒞₀} (k : F' ⟶ F) (u : F ⟶ H),
        Θ_id F' H (k ≫ u) = L.map k ≫ Θ_id F H u := by
      intro F' F H k u
      change (adj.homEquiv F' H).symm ((k ≫ u) ≫ (e_R H).inv) =
        L.map k ≫ (adj.homEquiv F H).symm (u ≫ (e_R H).inv)
      rw [Category.assoc k u, CategoryTheory.Adjunction.homEquiv_naturality_left_symm]
    let η_id_hom : ∀ F : 𝒞₀, L.obj F ⟶ F := fun F => Θ_id F F (𝟙 F)
    let η_id_inv : ∀ F : 𝒞₀, F ⟶ L.obj F := fun F => (Θ_id F (L.obj F)).symm (𝟙 _)
    have hΘ_id_eq : ∀ {F H : 𝒞₀} (u : F ⟶ H), Θ_id F H u = η_id_hom F ≫ u := by
      intro F H u
      conv_lhs => rw [← Category.id_comp u]
      exact hΘ_id_right (𝟙 F) u
    have hη_id_hom_inv : ∀ F, η_id_hom F ≫ η_id_inv F = 𝟙 (L.obj F) := by
      intro F
      rw [← hΘ_id_eq (η_id_inv F)]
      exact (Θ_id F (L.obj F)).apply_symm_apply (𝟙 _)
    have hη_id_inv_hom : ∀ F, η_id_inv F ≫ η_id_hom F = 𝟙 F := by
      intro F
      apply (Θ_id F F).injective
      rw [hΘ_id_eq, ← Category.assoc, hη_id_hom_inv F, Category.id_comp]
    have hη_id_nat : ∀ {F' F : 𝒞₀} (k : F' ⟶ F), L.map k ≫ η_id_hom F = η_id_hom F' ≫ k := by
      intro F' F k
      rw [← hΘ_id_left k (𝟙 F), Category.comp_id, hΘ_id_eq]
    refine ⟨η_id_hom, η_id_inv, hη_id_hom_inv, hη_id_inv_hom, hη_id_nat, ?_, ?_⟩
    · intro F c hc
      have hc_eq : c = η_id_hom F := by
        apply (adj.homEquiv F F).injective
        change adj.homEquiv F F c =
          adj.homEquiv F F ((adj.homEquiv F F).symm (𝟙 F ≫ (e_R F).inv))
        rw [Equiv.apply_symm_apply, Category.id_comp, hc]
      rw [hc_eq]
      exact hη_id_inv_hom F
    · intro R₀
      rw [← CategoryTheory.Adjunction.homEquiv_unit adj R₀ R₀ (η_id_hom R₀)]
      change (adj.homEquiv R₀ R₀)
        ((adj.homEquiv R₀ R₀).symm (𝟙 R₀ ≫ (e_R R₀).inv)) = _
      rw [Equiv.apply_symm_apply, Category.id_comp]

  have hWhiskerFree : ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
      {P₁ P₂ : C ⥤ Type u} {F : C ⥤ AddCommGrpCat.{u}}
      (β : P₁ ⟶ P₂) (α : P₂ ⋙ AddCommGrpCat.free ⟶ F),
      ((AddCommGrpCat.adj.whiskerRight C).homEquiv P₁ F)
        (CategoryTheory.Functor.whiskerRight β AddCommGrpCat.free ≫ α) =
      β ≫ ((AddCommGrpCat.adj.whiskerRight C).homEquiv P₂ F) α := by
    clear * -
    intro C _ P₁ P₂ F β α
    ext W x
    exact congrArg (fun m => m x)
      (AddCommGrpCat.adj.homEquiv_naturality_left (β.app W) (α.app W))

  have hSiteRepNatL :
      ∀ {𝒮 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒮]
        (J : CategoryTheory.GrothendieckTopology 𝒮)
        [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
        {V₁ V₂ : 𝒮} (v : V₂ ⟶ V₁)
        (G : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (φ : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
          (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V₁) AddCommGrpCat.free) ⟶ G),
        let siteEquiv : ∀ (V : 𝒮) (H : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
            ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
              (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) ⟶ H) ≃
              ↑(H.obj.obj (Opposite.op V)) :=
          fun V H =>
            Equiv.trans
              ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv
                (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H)
              (Equiv.trans
                ((AddCommGrpCat.adj.whiskerRight (Opposite 𝒮)).homEquiv
                  (CategoryTheory.yoneda.obj V) H.obj)
                CategoryTheory.yonedaEquiv)
        siteEquiv V₂ G
          (((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map
            (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v)
              AddCommGrpCat.free)) ≫ φ) =
          (G.obj.map v.op) (siteEquiv V₁ G φ) := by
    clear * - hWhiskerFree
    intro 𝒮 _ J _ V₁ V₂ v G φ siteEquiv
    dsimp only [siteEquiv, Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_left, hWhiskerFree]
    exact (CategoryTheory.yonedaEquiv_naturality _ v).symm

  have hSiteRepNatR :
      ∀ {𝒮 : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} 𝒮]
        (J : CategoryTheory.GrothendieckTopology 𝒮)
        [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
        {G₁ G₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (V : 𝒮)
        (m_hom : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
          (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) ⟶ G₁)
        (ψ : G₁ ⟶ G₂),
        let siteEquiv : ∀ (W : 𝒮) (H : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
            ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
              (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj W) AddCommGrpCat.free) ⟶ H) ≃
              ↑(H.obj.obj (Opposite.op W)) :=
          fun W H =>
            Equiv.trans
              ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv
                (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj W) AddCommGrpCat.free) H)
              (Equiv.trans
                ((AddCommGrpCat.adj.whiskerRight (Opposite 𝒮)).homEquiv
                  (CategoryTheory.yoneda.obj W) H.obj)
                CategoryTheory.yonedaEquiv)
        siteEquiv V G₂ (m_hom ≫ ψ) =
          (ψ.hom.app (Opposite.op V)) (siteEquiv V G₁ m_hom) := by
    clear * -
    intro 𝒮 _ J _ G₁ G₂ V m_hom ψ siteEquiv
    dsimp only [siteEquiv, Equiv.trans_apply]
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
    let α₀ := ((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ G₁) m_hom
    change CategoryTheory.yonedaEquiv
      (((AddCommGrpCat.adj.whiskerRight (Opposite 𝒮)).homEquiv
        (CategoryTheory.yoneda.obj V) G₂.obj) (α₀ ≫ ψ.hom)) = _
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
    rfl

  have hSiteCompCoh :
      ∀ {𝒮₀ 𝒮₁ 𝒮₂ : Type (u + 1)}
        [CategoryTheory.Category.{u, u + 1} 𝒮₀]
        [CategoryTheory.Category.{u, u + 1} 𝒮₁]
        [CategoryTheory.Category.{u, u + 1} 𝒮₂]
        (J₀ : CategoryTheory.GrothendieckTopology 𝒮₀)
        (J₁ : CategoryTheory.GrothendieckTopology 𝒮₁)
        (J₂ : CategoryTheory.GrothendieckTopology 𝒮₂)
        [CategoryTheory.HasWeakSheafify J₀ AddCommGrpCat.{u}]
        [CategoryTheory.HasWeakSheafify J₁ AddCommGrpCat.{u}]
        [CategoryTheory.HasWeakSheafify J₂ AddCommGrpCat.{u}]
        (B₁ : CategoryTheory.Functor 𝒮₀ 𝒮₁)
        (B₂ : CategoryTheory.Functor 𝒮₁ 𝒮₂)
        (B₁₂ : CategoryTheory.Functor 𝒮₀ 𝒮₂)
        [B₁.IsContinuous J₀ J₁]
        [B₂.IsContinuous J₁ J₂]
        [B₁₂.IsContinuous J₀ J₂]
        [(B₁.sheafPushforwardContinuous AddCommGrpCat.{u} J₀ J₁).IsRightAdjoint]
        [(B₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂).IsRightAdjoint]
        [(B₁₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₀ J₂).IsRightAdjoint]
        {T₀ : 𝒮₀} (hT₀ : CategoryTheory.Limits.IsTerminal T₀)
        {T₁ : 𝒮₁} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : 𝒮₂} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (e_B : CategoryTheory.Iso B₁₂ (CategoryTheory.Functor.comp B₁ B₂)),
        let pb₁ := B₁.sheafPullback AddCommGrpCat.{u} J₀ J₁
        let pb₂ := B₂.sheafPullback AddCommGrpCat.{u} J₁ J₂
        let pb₁₂ := B₁₂.sheafPullback AddCommGrpCat.{u} J₀ J₂
        let pf₁ := B₁.sheafPushforwardContinuous AddCommGrpCat.{u} J₀ J₁
        let pf₂ := B₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
        let pf₁₂ := B₁₂.sheafPushforwardContinuous AddCommGrpCat.{u} J₀ J₂
        let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u} J₀ J₁
        let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u} J₁ J₂
        let adj₁₂ := B₁₂.sheafAdjunctionContinuous AddCommGrpCat.{u} J₀ J₂
        let C₀ := CategoryTheory.constantSheaf J₀ AddCommGrpCat.{u}
        let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
        let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
        let adj_c₀ := CategoryTheory.constantSheafAdj J₀ AddCommGrpCat.{u} hT₀
        let adj_c₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
        let adj_c₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
        let siteRep₀ : 𝒮₀ → CategoryTheory.Sheaf J₀ AddCommGrpCat.{u} :=
          fun V => (CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).obj
            (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free)
        let siteRep₁ : 𝒮₁ → CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} :=
          fun V => (CategoryTheory.presheafToSheaf J₁ AddCommGrpCat.{u}).obj
            (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free)
        let siteEquiv₀ : ∀ (V : 𝒮₀) (H : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u}),
            (siteRep₀ V ⟶ H) ≃ ↑(H.obj.obj (Opposite.op V)) :=
          fun V H =>
            Equiv.trans
              ((CategoryTheory.sheafificationAdjunction J₀ AddCommGrpCat.{u}).homEquiv
                (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H)
              (Equiv.trans
                ((AddCommGrpCat.adj.whiskerRight (Opposite 𝒮₀)).homEquiv
                  (CategoryTheory.yoneda.obj V) H.obj)
                CategoryTheory.yonedaEquiv)
        let siteEquiv₁ : ∀ (V : 𝒮₁) (H : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
            (siteRep₁ V ⟶ H) ≃ ↑(H.obj.obj (Opposite.op V)) :=
          fun V H =>
            Equiv.trans
              ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).homEquiv
                (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H)
              (Equiv.trans
                ((AddCommGrpCat.adj.whiskerRight (Opposite 𝒮₁)).homEquiv
                  (CategoryTheory.yoneda.obj V) H.obj)
                CategoryTheory.yonedaEquiv)
        let siteEquiv₂ : ∀ (V : 𝒮₂) (H : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}),
            ((CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}).obj
              (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) ⟶ H) ≃
              ↑(H.obj.obj (Opposite.op V)) :=
          fun V H =>
            Equiv.trans
              ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
                (CategoryTheory.Functor.comp (CategoryTheory.yoneda.obj V) AddCommGrpCat.free) H)
              (Equiv.trans
                ((AddCommGrpCat.adj.whiskerRight (Opposite 𝒮₂)).homEquiv
                  (CategoryTheory.yoneda.obj V) H.obj)
                CategoryTheory.yonedaEquiv)
        ∃ (η_hom : ∀ F : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u},
            Quiver.Hom (pb₁₂.obj F) (pb₂.obj (pb₁.obj F)))
          (η_inv : ∀ F : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u},
            Quiver.Hom (pb₂.obj (pb₁.obj F)) (pb₁₂.obj F)),
          (∀ F, CategoryTheory.CategoryStruct.comp (η_hom F) (η_inv F) =
            CategoryTheory.CategoryStruct.id (pb₁₂.obj F)) ∧
          (∀ F, CategoryTheory.CategoryStruct.comp (η_inv F) (η_hom F) =
            CategoryTheory.CategoryStruct.id (pb₂.obj (pb₁.obj F))) ∧
          (∀ {F' F : CategoryTheory.Sheaf J₀ AddCommGrpCat.{u}} (k : Quiver.Hom F' F),
            CategoryTheory.CategoryStruct.comp (pb₁₂.map k) (η_hom F) =
              CategoryTheory.CategoryStruct.comp (η_hom F') (pb₂.map (pb₁.map k))) ∧
          (∀ (A : AddCommGrpCat.{u}),
            let c₁ : pb₁.obj (C₀.obj A) ⟶ C₁.obj A :=
              (adj₁.homEquiv (C₀.obj A) (C₁.obj A)).symm
                ((adj_c₀.homEquiv A (pf₁.obj (C₁.obj A))).symm
                  (CategoryTheory.CategoryStruct.comp (adj_c₁.unit.app A)
                    ((C₁.obj A).obj.map (hT₁.from (B₁.obj T₀)).op)))
            let c₂ : pb₂.obj (C₁.obj A) ⟶ C₂.obj A :=
              (adj₂.homEquiv (C₁.obj A) (C₂.obj A)).symm
                ((adj_c₁.homEquiv A (pf₂.obj (C₂.obj A))).symm
                  (CategoryTheory.CategoryStruct.comp (adj_c₂.unit.app A)
                    ((C₂.obj A).obj.map (hT₂.from (B₂.obj T₁)).op)))
            let c₁₂ : pb₁₂.obj (C₀.obj A) ⟶ C₂.obj A :=
              (adj₁₂.homEquiv (C₀.obj A) (C₂.obj A)).symm
                ((adj_c₀.homEquiv A (pf₁₂.obj (C₂.obj A))).symm
                  (CategoryTheory.CategoryStruct.comp (adj_c₂.unit.app A)
                    ((C₂.obj A).obj.map (hT₂.from (B₁₂.obj T₀)).op)))
            CategoryTheory.CategoryStruct.comp (η_inv (C₀.obj A)) c₁₂ =
              CategoryTheory.CategoryStruct.comp (pb₂.map c₁) c₂) ∧
          (∀ (U₀ : 𝒮₀) (U₁ : 𝒮₁) (U₂ U₁₂ : 𝒮₂)
              (u₁ : Quiver.Hom U₁ (B₁.obj U₀))
              (u₂ : Quiver.Hom U₂ (B₂.obj U₁))
              (u₁₂ : Quiver.Hom U₁₂ (B₁₂.obj U₀))
              (v : Quiver.Hom U₁₂ U₂),
            CategoryTheory.CategoryStruct.comp u₁₂ (e_B.hom.app U₀) =
              CategoryTheory.CategoryStruct.comp v
                (CategoryTheory.CategoryStruct.comp u₂ (B₂.map u₁)) →
            let R₀ := siteRep₀ U₀
            let R₁ := siteRep₁ U₁
            let ρ₁ := (siteEquiv₁ U₁ (pb₁.obj R₀)).symm
              (((pb₁.obj R₀).obj.map (Opposite.op u₁))
                (((adj₁.unit.app R₀).hom.app (Opposite.op U₀))
                  (siteEquiv₀ U₀ R₀ (CategoryTheory.CategoryStruct.id R₀))))
            let ρ₂ := (siteEquiv₂ U₂ (pb₂.obj R₁)).symm
              (((pb₂.obj R₁).obj.map (Opposite.op u₂))
                (((adj₂.unit.app R₁).hom.app (Opposite.op U₁))
                  (siteEquiv₁ U₁ R₁ (CategoryTheory.CategoryStruct.id R₁))))
            let ρ₁₂ := (siteEquiv₂ U₁₂ (pb₁₂.obj R₀)).symm
              (((pb₁₂.obj R₀).obj.map (Opposite.op u₁₂))
                (((adj₁₂.unit.app R₀).hom.app (Opposite.op U₀))
                  (siteEquiv₀ U₀ R₀ (CategoryTheory.CategoryStruct.id R₀))))
            CategoryTheory.CategoryStruct.comp ρ₁₂ (η_hom R₀) =
              CategoryTheory.CategoryStruct.comp
                ((CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}).map
                  (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map v)
                    AddCommGrpCat.free))
                (CategoryTheory.CategoryStruct.comp ρ₂ (pb₂.map ρ₁))) := by
    clear * - hAdjCompMateGen hSiteRepNatL hSiteRepNatR
    intro 𝒮₀ 𝒮₁ 𝒮₂ _ _ _ J₀ J₁ J₂ _ _ _ B₁ B₂ B₁₂ _ _ _ _ _ _ T₀ hT₀ T₁ hT₁ T₂ hT₂ e_B
      pb₁ pb₂ pb₁₂ pf₁ pf₂ pf₁₂ adj₁ adj₂ adj₁₂ C₀ C₁ C₂ adj_c₀ adj_c₁ adj_c₂
      siteRep₀ siteRep₁ siteEquiv₀ siteEquiv₁ siteEquiv₂
    have : (CategoryTheory.Functor.comp B₁ B₂).IsContinuous J₀ J₂ :=
      CategoryTheory.Functor.isContinuous_comp B₁ B₂ J₀ J₁ J₂
    let e_pf_top := CategoryTheory.Functor.sheafPushforwardContinuousIso e_B
      AddCommGrpCat.{u} J₀ J₂
    let e_pf' : ∀ H : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u},
        pf₁₂.obj H ≅ pf₁.obj (pf₂.obj H) :=
      fun H =>
        { hom := e_pf_top.hom.app H
          inv := e_pf_top.inv.app H
          hom_inv_id := e_pf_top.hom_inv_id_app H
          inv_hom_id := e_pf_top.inv_hom_id_app H }
