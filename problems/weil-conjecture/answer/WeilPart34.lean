      S'.smallEtaleTopology X'.smallEtaleTopology

    have hCoverBySmallAff : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale) (x : ↥U.left),
        ∃ (a : CategoryTheory.SmallModel.{u} Z.AffineEtale)
          (g : ((CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse ⋙
            AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj a ⟶ U)
          (y : ↥(((CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse ⋙
            AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj a).left),
          AlgebraicGeometry.Etale g.left ∧ g.left.base y = x := by
      intro Z U x
      obtain ⟨V_x, hAffV, hxV, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := x) (U := (⊤ : U.left.Opens)) trivial
      let R_V : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op V_x)
      let j_V : AlgebraicGeometry.Spec R_V ⟶ U.left := hAffV.isoSpec.inv ≫ V_x.ι
      have hj_et : AlgebraicGeometry.Etale j_V := by dsimp [j_V]; infer_instance
      have hjU_et : AlgebraicGeometry.Etale (j_V ≫ U.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          j_V U.hom hj_et U.prop
      have : AlgebraicGeometry.Etale (j_V ≫ U.hom) := hjU_et
      let A_x : Z.AffineEtale :=
        AlgebraicGeometry.Scheme.AffineEtale.mk (R := R_V) (j_V ≫ U.hom)
      let a_x : CategoryTheory.SmallModel.{u} Z.AffineEtale :=
        (CategoryTheory.equivSmallModel.{u} Z.AffineEtale).functor.obj A_x
      let e_a : (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_x ≅
          ((CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse ⋙
            AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj a_x :=
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).mapIso
          ((CategoryTheory.equivSmallModel.{u} Z.AffineEtale).unitIso.app A_x)
      let u_x : (AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_x ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk j_V rfl
      let g_x := e_a.inv ≫ u_x
      let e_left : ((AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj A_x).left ≅
          (((CategoryTheory.equivSmallModel.{u} Z.AffineEtale).inverse ⋙
            AlgebraicGeometry.Scheme.AffineEtale.Spec Z).obj a_x).left :=
        (AlgebraicGeometry.Scheme.Etale.forget Z ⋙ CategoryTheory.Over.forget Z).mapIso e_a
      have he_et : AlgebraicGeometry.Etale e_left.inv := inferInstance
      have hg_et : AlgebraicGeometry.Etale g_x.left :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          e_left.inv j_V he_et hj_et
      let p_x : PrimeSpectrum ↑R_V := hAffV.isoSpec.hom.base ⟨x, hxV⟩
      let y_x := e_left.hom.base p_x
      refine ⟨a_x, g_x, y_x, hg_et, ?_⟩
      have hj_pt : j_V.base p_x = x := by
        dsimp [j_V, p_x]
        have h1 : hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩) = ⟨x, hxV⟩ := by
          change (hAffV.isoSpec.hom ≫ hAffV.isoSpec.inv).base ⟨x, hxV⟩ = ⟨x, hxV⟩
          rw [hAffV.isoSpec.hom_inv_id]
          rfl
        change V_x.ι.base (hAffV.isoSpec.inv.base (hAffV.isoSpec.hom.base ⟨x, hxV⟩)) = x
        rw [h1]
        rfl
      have he_pt : e_left.inv.base y_x = p_x := by
        dsimp [y_x]
        change (e_left.hom ≫ e_left.inv).base p_x = p_x
        rw [e_left.hom_inv_id]
        rfl
      change j_V.base (e_left.inv.base y_x) = x
      rw [he_pt, hj_pt]

    let g_S : CategoryTheory.SmallModel.{u} S'.AffineEtale ⥤ S'.Etale :=
      (CategoryTheory.equivSmallModel.{u} S'.AffineEtale).inverse ⋙
        AlgebraicGeometry.Scheme.AffineEtale.Spec S'
    let g_X : CategoryTheory.SmallModel.{u} X'.AffineEtale ⥤ X'.Etale :=
      (CategoryTheory.equivSmallModel.{u} X'.AffineEtale).inverse ⋙
        AlgebraicGeometry.Scheme.AffineEtale.Spec X'
    let treeS : ℕ → Σ (T : Type u), (T → S'.Etale) :=
      Nat.rec
        ⟨ULift.{u} Unit ⊕ CategoryTheory.SmallModel.{u} S'.AffineEtale,
          Sum.elim (fun _ => ⊤_ S'.Etale) g_S.obj⟩
        (fun _ ih =>
          ⟨ih.1 ⊕ (Σ (a b c : ih.1), (ih.2 a ⟶ ih.2 c) × (ih.2 b ⟶ ih.2 c)),
            Sum.elim ih.2 (fun p => CategoryTheory.Limits.pullback p.2.2.2.1 p.2.2.2.2)⟩)
    let shiftBy : ∀ (d m : ℕ), (treeS m).1 → (treeS (m + d)).1 :=
      Nat.rec (fun _ t => t) (fun _ ih m t => Sum.inl (ih m t))
    have hShiftBy_ev : ∀ (d m : ℕ) (t : (treeS m).1),
        (treeS (m + d)).2 (shiftBy d m t) = (treeS m).2 t := by
      intro d
      induction d with
      | zero => intro m t; rfl
      | succ d ih => intro m t; exact ih m t
    let castTree : ∀ {a b : ℕ}, a = b → (treeS a).1 → (treeS b).1 :=
      fun h t => Eq.ndrec (motive := fun k => (treeS k).1) t h
    have hCastTree_ev : ∀ {a b : ℕ} (h : a = b) (t : (treeS a).1),
        (treeS b).2 (castTree h t) = (treeS a).2 t := by
      rintro a _ rfl t; rfl
    let liftS : ∀ (N m : ℕ), m ≤ N → (treeS m).1 → (treeS N).1 :=
      fun N m h t => castTree (Nat.add_sub_of_le h) (shiftBy (N - m) m t)
    have hLiftS_ev : ∀ (N m : ℕ) (h : m ≤ N) (t : (treeS m).1),
        (treeS N).2 (liftS N m h t) = (treeS m).2 t :=
      fun N m h t => (hCastTree_ev (Nat.add_sub_of_le h) _).trans (hShiftBy_ev (N - m) m t)
    let IdxS : Type u := Σ n : ℕ, (treeS n).1
    let evS : IdxS → S'.Etale := fun p => (treeS p.1).2 p.2
    let CS : Type u := CategoryTheory.InducedCategory S'.Etale evS
    let IS : CS ⥤ S'.Etale := CategoryTheory.inducedFunctor evS
    have : IS.Full := (CategoryTheory.fullyFaithfulInducedFunctor evS).full
    have : IS.Faithful := (CategoryTheory.fullyFaithfulInducedFunctor evS).faithful
    have : IS.ReflectsIsomorphisms := inferInstance
    have : CategoryTheory.CreatesLimitsOfShape
        (CategoryTheory.Discrete PEmpty.{1}) IS := by
      refine ⟨fun {K} => ?_⟩
      let t₀ : CS := (⟨0, Sum.inl (ULift.up ())⟩ : IdxS)
      let l : CategoryTheory.Limits.Cone (K ⋙ IS) :=
        { pt := ⊤_ S'.Etale
          π := { app := fun ⟨x⟩ => PEmpty.elim x
                 naturality := fun ⟨x⟩ => PEmpty.elim x } }
      let hl : CategoryTheory.Limits.IsLimit l :=
        { lift := fun s => CategoryTheory.Limits.terminal.from s.pt
          fac := fun _ ⟨x⟩ => PEmpty.elim x
          uniq := fun _ _ _ => CategoryTheory.Limits.terminal.hom_ext _ _ }
      exact CategoryTheory.createsLimitOfFullyFaithfulOfIso' hl t₀ (CategoryTheory.Iso.refl _)
    have : CategoryTheory.CreatesLimitsOfShape
        CategoryTheory.Limits.WalkingCospan IS := by
      refine ⟨fun {K} => ?_⟩
      let x : IdxS := K.obj CategoryTheory.Limits.WalkingCospan.left
      let y : IdxS := K.obj CategoryTheory.Limits.WalkingCospan.right
      let z : IdxS := K.obj CategoryTheory.Limits.WalkingCospan.one
      let u : IS.obj x ⟶ IS.obj z := IS.map (K.map CategoryTheory.Limits.WalkingCospan.Hom.inl)
      let v : IS.obj y ⟶ IS.obj z := IS.map (K.map CategoryTheory.Limits.WalkingCospan.Hom.inr)
      let N : ℕ := max x.1 (max y.1 z.1)
      have hx_le : x.1 ≤ N := Nat.le_max_left _ _
      have hy_le : y.1 ≤ N := le_trans (Nat.le_max_left _ _) (Nat.le_max_right _ _)
      have hz_le : z.1 ≤ N := le_trans (Nat.le_max_right _ _) (Nat.le_max_right _ _)
      let x' : (treeS N).1 := liftS N x.1 hx_le x.2
      let y' : (treeS N).1 := liftS N y.1 hy_le y.2
      let z' : (treeS N).1 := liftS N z.1 hz_le z.2
      have hx : (treeS N).2 x' = IS.obj x := hLiftS_ev N x.1 hx_le x.2
      have hy : (treeS N).2 y' = IS.obj y := hLiftS_ev N y.1 hy_le y.2
      have hz : (treeS N).2 z' = IS.obj z := hLiftS_ev N z.1 hz_le z.2
      let u' : (treeS N).2 x' ⟶ (treeS N).2 z' :=
        CategoryTheory.eqToHom hx ≫ u ≫ CategoryTheory.eqToHom hz.symm
      let v' : (treeS N).2 y' ⟶ (treeS N).2 z' :=
        CategoryTheory.eqToHom hy ≫ v ≫ CategoryTheory.eqToHom hz.symm
      let w : CS := (⟨N + 1, Sum.inr ⟨x', y', z', u', v'⟩⟩ : IdxS)
      have hpb_uv : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst u' v' ≫ CategoryTheory.eqToHom hx)
          (CategoryTheory.Limits.pullback.snd u' v' ≫ CategoryTheory.eqToHom hy) u v := by
        refine CategoryTheory.IsPullback.of_iso
          (CategoryTheory.IsPullback.of_hasPullback u' v')
          (CategoryTheory.Iso.refl _)
          (CategoryTheory.eqToIso hx)
          (CategoryTheory.eqToIso hy)
          (CategoryTheory.eqToIso hz) ?_ ?_ ?_ ?_
        · simp
        · simp
        · simp [u']
        · simp [v']
      let e_w_pb : IS.obj w ≅ CategoryTheory.Limits.pullback u v := hpb_uv.isoPullback
      let e_pb_lim : CategoryTheory.Limits.pullback u v ≅ CategoryTheory.Limits.limit (K ⋙ IS) :=
        CategoryTheory.Limits.HasLimit.isoOfNatIso
          (CategoryTheory.Limits.diagramIsoCospan (K ⋙ IS)).symm
      exact CategoryTheory.createsLimitOfFullyFaithfulOfIso w (e_w_pb ≪≫ e_pb_lim)
    have : CategoryTheory.Limits.CreatesFiniteLimits IS :=
      CategoryTheory.Limits.createsFiniteLimitsOfCreatesTerminalAndPullbacks IS
    have : CategoryTheory.Limits.HasTerminal CS :=
      CategoryTheory.hasLimitsOfShape_of_hasLimitsOfShape_createsLimitsOfShape IS
    have : CategoryTheory.Limits.HasPullbacks CS :=
      CategoryTheory.hasLimitsOfShape_of_hasLimitsOfShape_createsLimitsOfShape IS
    have : CategoryTheory.Limits.HasFiniteLimits CS :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits IS :=
      CategoryTheory.Limits.preservesFiniteLimits_of_createsFiniteLimits_and_hasFiniteLimits IS
    have : IS.IsCoverDense S'.smallEtaleTopology := by
      refine ⟨fun U => (hMemEtale S' U _).mpr fun x => ?_⟩
      obtain ⟨a, g_a, y, hg_et, hgy⟩ := hCoverBySmallAff S' U x
      exact ⟨g_S.obj a, g_a, y,
        ⟨(⟨0, Sum.inr a⟩ : IdxS), 𝟙 _, g_a, CategoryTheory.Category.id_comp g_a⟩, hg_et, hgy⟩

    let IdxX : Type u := CategoryTheory.SmallModel.{u} X'.AffineEtale ⊕ IdxS
    let evX : IdxX → X'.Etale := Sum.elim g_X.obj (fun s => B_f.obj (evS s))
    let CX : Type u := CategoryTheory.InducedCategory X'.Etale evX
    let IX : CX ⥤ X'.Etale := CategoryTheory.inducedFunctor evX
    have : IX.Full := (CategoryTheory.fullyFaithfulInducedFunctor evX).full
    have : IX.Faithful := (CategoryTheory.fullyFaithfulInducedFunctor evX).faithful
    have : IX.IsCoverDense X'.smallEtaleTopology := by
      refine ⟨fun U => (hMemEtale X' U _).mpr fun x => ?_⟩
      obtain ⟨a, g_a, y, hg_et, hgy⟩ := hCoverBySmallAff X' U x
      exact ⟨g_X.obj a, g_a, y,
        ⟨(Sum.inl a : IdxX), 𝟙 _, g_a, CategoryTheory.Category.id_comp g_a⟩, hg_et, hgy⟩

    let B_tilde : CS ⥤ CX :=
      { obj := fun s => (Sum.inr s : IdxX)
        map := fun {s₁ s₂} φ => CategoryTheory.InducedCategory.homMk (B_f.map φ.hom)
        map_id := fun s =>
          congrArg CategoryTheory.InducedCategory.homMk (B_f.map_id (evS s))
        map_comp := fun φ ψ =>
          congrArg CategoryTheory.InducedCategory.homMk (B_f.map_comp φ.hom ψ.hom) }
    have hComm_B : B_tilde ⋙ IX = IS ⋙ B_f := rfl
    have : CategoryTheory.Limits.PreservesFiniteLimits (B_tilde ⋙ IX) := by
      rw [hComm_B]
      exact CategoryTheory.Limits.comp_preservesFiniteLimits IS B_f
    have : CategoryTheory.Limits.PreservesFiniteLimits B_tilde :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B_tilde IX
    have : CategoryTheory.RepresentablyFlat B_tilde :=
      CategoryTheory.flat_of_preservesFiniteLimits B_tilde

    let J_CS := IS.inducedTopology S'.smallEtaleTopology
    let J_CX := IX.inducedTopology X'.smallEtaleTopology
    have hCov_Bt : CategoryTheory.CoverPreserving J_CS J_CX B_tilde := by
      refine ⟨fun {U} R hR => ?_⟩
      change R ∈ (IS.inducedTopology S'.smallEtaleTopology) U at hR
      change CategoryTheory.Sieve.functorPushforward B_tilde R ∈
        (IX.inducedTopology X'.smallEtaleTopology) (B_tilde.obj U)
      rw [← IS.restrictedTopology_eq_inducedTopology] at hR
      rw [← IX.restrictedTopology_eq_inducedTopology]
      rw [CategoryTheory.Functor.mem_restrictedTopology_iff] at hR ⊢
      rw [← CategoryTheory.Sieve.functorPushforward_comp]
      change CategoryTheory.Sieve.functorPushforward (IS ⋙ B_f) R ∈
        X'.smallEtaleTopology (B_f.obj (IS.obj U))
      rw [CategoryTheory.Sieve.functorPushforward_comp]
      exact hCov_Bf.cover_preserve hR
    have : B_tilde.IsContinuous J_CS J_CX :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving
        (CategoryTheory.compatiblePreservingOfFlat J_CX B_tilde) hCov_Bt

    let E_S := IS.sheafInducedTopologyEquivOfIsCoverDense S'.smallEtaleTopology AddCommGrpCat.{u}
    let E_X := IX.sheafInducedTopologyEquivOfIsCoverDense X'.smallEtaleTopology AddCommGrpCat.{u}
    let pf_t := B_tilde.sheafPushforwardContinuous AddCommGrpCat.{u} J_CS J_CX
    let pb_t := B_tilde.sheafPullback AddCommGrpCat.{u} J_CS J_CX
    let adj_t := B_tilde.sheafAdjunctionContinuous AddCommGrpCat.{u} J_CS J_CX
    have : CategoryTheory.Limits.PreservesFiniteLimits pb_t :=
      CategoryTheory.Functor.SmallCategories.instPreservesFiniteLimitsSheafSheafPullbackOfRepresentablyFlat
        B_tilde AddCommGrpCat.{u} J_CS J_CX

    let e_comm : (E_X.inverse ⋙ pf_t) ≅ (pf_f ⋙ E_S.inverse) :=
      CategoryTheory.NatIso.ofComponents
        (fun H =>
          { hom :=
              { hom :=
                  { app := fun W => 𝟙 (H.obj.obj (Opposite.op (B_f.obj (evS W.unop))))
                    naturality := fun _ _ _ =>
                      (CategoryTheory.Category.comp_id _).trans
                        (CategoryTheory.Category.id_comp _).symm } }
            inv :=
              { hom :=
                  { app := fun W => 𝟙 (H.obj.obj (Opposite.op (B_f.obj (evS W.unop))))
                    naturality := fun _ _ _ =>
                      (CategoryTheory.Category.comp_id _).trans
                        (CategoryTheory.Category.id_comp _).symm } }
            hom_inv_id := by ext W x; rfl
            inv_hom_id := by ext W x; rfl })
        (fun {H₁ H₂} φ => by ext W x; rfl)

    let R_comp : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u} :=
      E_X.inverse ⋙ pf_t ⋙ E_S.functor
    let e_pf : R_comp ≅ pf_f :=
      (CategoryTheory.Functor.isoWhiskerRight e_comm E_S.functor) ≪≫
        (CategoryTheory.Functor.associator pf_f E_S.inverse E_S.functor) ≪≫
        (CategoryTheory.Functor.isoWhiskerLeft pf_f E_S.counitIso) ≪≫
        CategoryTheory.Functor.rightUnitor pf_f

    let L_comp : CategoryTheory.Sheaf S'.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u} :=
      E_S.inverse ⋙ pb_t ⋙ E_X.functor
    let adj_mid : (E_S.inverse ⋙ pb_t) ⊣ (pf_t ⋙ E_S.functor) :=
      E_S.symm.toAdjunction.comp adj_t
    let adj_R : L_comp ⊣ R_comp :=
      adj_mid.comp E_X.toAdjunction
    let adj_f : L_comp ⊣ pf_f :=
      adj_R.ofNatIsoRight e_pf
    have : CategoryTheory.Limits.PreservesFiniteLimits E_S.inverse := inferInstance
    have : CategoryTheory.Limits.PreservesFiniteLimits E_X.functor := inferInstance
    have : CategoryTheory.Limits.PreservesFiniteLimits (E_S.inverse ⋙ pb_t) :=
      CategoryTheory.Limits.comp_preservesFiniteLimits E_S.inverse pb_t
    have : CategoryTheory.Limits.PreservesFiniteLimits L_comp :=
      CategoryTheory.Limits.comp_preservesFiniteLimits (E_S.inverse ⋙ pb_t) E_X.functor
    have : L_comp.PreservesMonomorphisms := inferInstance
    have hr_pf : pf_f.IsRightAdjoint := adj_f.isRightAdjoint
    have hAdd_pf : pf_f.Additive :=
      CategoryTheory.Functor.additive_of_preserves_binary_products pf_f
    have hLim_pf : CategoryTheory.Limits.PreservesFiniteLimits pf_f :=
      ⟨fun _ _ _ => inferInstance⟩
    exact ⟨hr_pf, hAdd_pf, hLim_pf, fun I _ =>
      @CategoryTheory.Injective.injective_of_adjoint _ _ _ _ L_comp pf_f inferInstance adj_f I
        inferInstance⟩

  
  
  
  have hAddEquiv0_mk0 : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      {A B : 𝒞} (g : A ⟶ B),
      CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ g) = g := by
    intro 𝒞 _ _ _ A B g
    have h1 := CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply
      (CategoryTheory.Abelian.Ext.addEquiv₀.symm g)
    rw [AddEquiv.apply_symm_apply] at h1
    rw [h1, AddEquiv.apply_symm_apply]

  have hAddEquiv0_pre : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      {A₁ A₂ B : 𝒞} (ψ : A₁ ⟶ A₂) (α : CategoryTheory.Abelian.Ext A₂ B 0),
      CategoryTheory.Abelian.Ext.addEquiv₀
        ((CategoryTheory.Abelian.Ext.mk₀ ψ).comp α (Nat.zero_add 0)) =
        ψ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α := by
    intro 𝒞 _ _ _ A₁ A₂ B ψ α
    conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α]
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hAddEquiv0_mk0]

  have hAddEquiv0_post : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      {A B₁ B₂ : 𝒞} (φ : B₁ ⟶ B₂) (α : CategoryTheory.Abelian.Ext A B₁ 0),
      CategoryTheory.Abelian.Ext.addEquiv₀
        (α.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
        CategoryTheory.Abelian.Ext.addEquiv₀ α ≫ φ := by
    intro 𝒞 _ _ _ A B₁ B₂ φ α
    conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α]
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hAddEquiv0_mk0]

  have hSiteHDI : ∀ {C_X C_S : Type (u + 1)}
      [CategoryTheory.Category.{u, u + 1} C_X] [CategoryTheory.Category.{u, u + 1} C_S]
      (J_X : CategoryTheory.GrothendieckTopology C_X)
      (J_S : CategoryTheory.GrothendieckTopology C_S)
      [CategoryTheory.HasSheafify J_X AddCommGrpCat.{u}]
      [CategoryTheory.HasSheafify J_S AddCommGrpCat.{u}]
      [CategoryTheory.Limits.PreservesFiniteLimits
        (CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u})]
      [CategoryTheory.HasExt.{u} (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})]
      (B : C_S ⥤ C_X) [B.IsContinuous J_S J_X]
      [CategoryTheory.Limits.PreservesFiniteLimits
        (B.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X)],
      let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X
      let R_fn : ℕ → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} →
          CategoryTheory.Sheaf J_S AddCommGrpCat.{u} :=
        fun q H => (CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}).obj
          (CategoryTheory.Functor.comp B.op (CategoryTheory.Sheaf.cohomologyPresheaf H q))
      (∀ (H : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}), Nonempty (R_fn 0 H ≅ pf.obj H)) ∧
      (∀ (J : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) [CategoryTheory.Injective J]
          (p : ℕ), 1 ≤ p → CategoryTheory.Limits.IsZero (R_fn p J)) ∧
      (∀ (SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u}))
          (hSE : SC.ShortExact),
          (∀ (p : ℕ), 1 ≤ p → CategoryTheory.Limits.IsZero (R_fn p SC.X₂)) →
          ((∃ (δ₀ : pf.obj SC.X₃ ⟶ R_fn 1 SC.X₁) (hcomp : pf.map SC.g ≫ δ₀ = 0),
              CategoryTheory.Epi δ₀ ∧
              (CategoryTheory.ShortComplex.mk (pf.map SC.g) δ₀ hcomp).Exact) ∧
            (CategoryTheory.Limits.IsZero (R_fn 1 SC.X₁) → (SC.map pf).ShortExact)) ∧
          (∀ (q : ℕ), 1 ≤ q → Nonempty (R_fn (q + 1) SC.X₁ ≅ R_fn q SC.X₃))) := by
    intro C_X C_S _ _ J_X J_S _ _ _ _ B _ _ pf R_fn
    let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
    let R_map : ∀ (q : ℕ) {H₁ H₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : H₁ ⟶ H₂),
        R_fn q H₁ ⟶ R_fn q H₂ :=
      fun q {_ _} φ => Sh_S.map (CategoryTheory.Functor.whiskerLeft B.op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map φ))

    have hInjHDI : ∀ (J : CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        [CategoryTheory.Injective J] (p : ℕ), 1 ≤ p →
        CategoryTheory.Limits.IsZero (R_fn p J) := by
      intro J _ p hp
      obtain ⟨p', rfl⟩ : ∃ p' : ℕ, p = p' + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
      have hPreZero : CategoryTheory.Limits.IsZero
          (CategoryTheory.Functor.comp B.op (J.cohomologyPresheaf (p' + 1))) := by
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        ext W x
        exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x
      exact Sh_S.map_isZero hPreZero

    obtain ⟨e_deg0, he_deg0_nat⟩ : ∃ (e_deg0 : ∀ (H : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        R_fn 0 H ≅ pf.obj H),
        ∀ {H₁ H₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : H₁ ⟶ H₂),
          (e_deg0 H₁).inv ≫ R_map 0 φ ≫ (e_deg0 H₂).hom = pf.map φ := by
      let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite C_X)
        (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
      let U_forget := (CategoryTheory.Functor.whiskeringRight (Opposite C_X)
        AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
      let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
      let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
      let Z_fun : C_X ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
        CategoryTheory.yoneda ⋙ Free_PSh ⋙ Sh_X
      let adj_shX := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
      let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite C_X) AddCommGrpCat.adj
      let ev_gen : ∀ (V : C_X), AddCommGrpCat.free.obj (V ⟶ V) :=
        fun V => (AddCommGrpCat.adj.unit.app (V ⟶ V)) (𝟙 V)
      let e_eqvV : ∀ (H : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (V : C_X),
          ((H.cohomologyPresheaf 0).obj (Opposite.op V) ≅ H.obj.obj (Opposite.op V)) := fun H V =>
        let e1 := CategoryTheory.Abelian.Ext.addEquiv₀ (X := Z_fun.obj V) (Y := H)
        let e2 := adj_shX.homEquiv ((CategoryTheory.yoneda ⋙ Free_PSh).obj V) H
        let e3 := adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_X.obj H)
        let e4 := CategoryTheory.yonedaEquiv (F := U_forget.obj (U_X.obj H)) (X := V)
        let eqv : CategoryTheory.Abelian.Ext (Z_fun.obj V) H 0 ≃ ↥(H.obj.obj (Opposite.op V)) :=
          e1.toEquiv.trans (e2.trans (e3.trans e4))
        have h_apply : ∀ (α : CategoryTheory.Abelian.Ext (Z_fun.obj V) H 0),
            eqv α = ((e2 (e1 α)).app (Opposite.op V)) (ev_gen V) := by
          intro α
          dsimp only [eqv, Equiv.trans_apply]
          rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
          rfl
        have h_add : ∀ α β, eqv (α + β) = eqv α + eqv β := by
          intro α β
          rw [h_apply, h_apply, h_apply, map_add]
          have h2 : e2 (e1 α + e1 β) = e2 (e1 α) + e2 (e1 β) := by
            dsimp [e2]
            rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
              CategoryTheory.Adjunction.homEquiv_unit, U_X.map_add,
              CategoryTheory.Preadditive.comp_add]
          rw [h2]
          rfl
        AddEquiv.toAddCommGrpIso { eqv with map_add' := h_add }
      let θ_pre : ∀ (H : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          H.cohomologyPresheaf 0 ≅ H.obj := fun H =>
        CategoryTheory.NatIso.ofComponents (fun W => e_eqvV H W.unop) (fun {W₁ W₂} ω => by
          have hL : (H.cohomologyPresheaf 0).map ω =
              ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app H := rfl
          rw [hL, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) H]
          apply AddCommGrpCat.ext
          intro (α : CategoryTheory.Abelian.Ext (Z_fun.obj W₁.unop) H 0)
          have hf_eq : CategoryTheory.Abelian.Ext.addEquiv₀
              ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)).comp α (Nat.zero_add 0)) =
              Z_fun.map ω.unop ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α :=
            hAddEquiv0_pre (Z_fun.map ω.unop) α
          change CategoryTheory.yonedaEquiv (F := U_forget.obj (U_X.obj H))
              (adj_free.homEquiv _ (U_X.obj H) (adj_shX.homEquiv _ H
                (CategoryTheory.Abelian.Ext.addEquiv₀
                  ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map ω.unop)).comp α (Nat.zero_add 0))))) =
            (U_forget.obj (U_X.obj H)).map ω.unop.op
              (CategoryTheory.yonedaEquiv (F := U_forget.obj (U_X.obj H))
                (adj_free.homEquiv _ (U_X.obj H) (adj_shX.homEquiv _ H
                  (CategoryTheory.Abelian.Ext.addEquiv₀ α))))
          rw [hf_eq]
          have hsh_nat : adj_shX.homEquiv _ H
              (Z_fun.map ω.unop ≫ CategoryTheory.Abelian.Ext.addEquiv₀ α) =
              Free_PSh.map (CategoryTheory.yoneda.map ω.unop) ≫
                adj_shX.homEquiv _ H (CategoryTheory.Abelian.Ext.addEquiv₀ α) :=
            adj_shX.homEquiv_naturality_left (Free_PSh.map (CategoryTheory.yoneda.map ω.unop)) _
          rw [hsh_nat]
          have hfr_nat : adj_free.homEquiv _ (U_X.obj H)
              (Free_PSh.map (CategoryTheory.yoneda.map ω.unop) ≫
                adj_shX.homEquiv _ H (CategoryTheory.Abelian.Ext.addEquiv₀ α)) =
              CategoryTheory.yoneda.map ω.unop ≫
                adj_free.homEquiv _ (U_X.obj H)
                  (adj_shX.homEquiv _ H (CategoryTheory.Abelian.Ext.addEquiv₀ α)) :=
            adj_free.homEquiv_naturality_left (CategoryTheory.yoneda.map ω.unop) _
          rw [hfr_nat]
          exact (CategoryTheory.yonedaEquiv_naturality _ ω.unop).symm)
      have hθ_mor : ∀ {H₁ H₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : H₁ ⟶ H₂),
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ) ≫
            (θ_pre H₂).hom = (θ_pre H₁).hom ≫ φ.hom := by
        intro H₁ H₂ φ
        ext W α
        let α' : CategoryTheory.Abelian.Ext (Z_fun.obj W.unop) H₁ 0 := α
        have h_post : CategoryTheory.Abelian.Ext.addEquiv₀
            (α'.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
            CategoryTheory.Abelian.Ext.addEquiv₀ α' ≫ φ :=
          hAddEquiv0_post φ α'
        change CategoryTheory.yonedaEquiv (F := U_forget.obj (U_X.obj H₂))
            (adj_free.homEquiv _ (U_X.obj H₂) (adj_shX.homEquiv _ H₂
              (CategoryTheory.Abelian.Ext.addEquiv₀
                (α'.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0))))) =
          (φ.hom.app (Opposite.op W.unop))
            (CategoryTheory.yonedaEquiv (F := U_forget.obj (U_X.obj H₁))
              (adj_free.homEquiv _ (U_X.obj H₁) (adj_shX.homEquiv _ H₁
                (CategoryTheory.Abelian.Ext.addEquiv₀ α'))))
        rw [h_post, adj_shX.homEquiv_naturality_right, adj_free.homEquiv_naturality_right]
        rfl
      let adj_shS := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
      have hIsoCounit : ∀ (G₀ : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}),
          CategoryTheory.IsIso (adj_shS.counit.app G₀) :=
        fun G₀ => @CategoryTheory.Adjunction.instIsIsoAppCounitOfFullOfFaithful _ _ _ _ _ _
          adj_shS
          (CategoryTheory.fullyFaithfulSheafToPresheaf J_S AddCommGrpCat.{u}).full
          (CategoryTheory.fullyFaithfulSheafToPresheaf J_S AddCommGrpCat.{u}).faithful
          G₀
      let e_deg0 : ∀ (H : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          R_fn 0 H ≅ pf.obj H := fun H =>
        (Sh_S.mapIso (CategoryTheory.Functor.isoWhiskerLeft B.op (θ_pre H))) ≪≫
          @CategoryTheory.asIso _ _ _ _ (adj_shS.counit.app (pf.obj H)) (hIsoCounit (pf.obj H))
      refine ⟨e_deg0, fun {H₁ H₂} φ => ?_⟩
      let m₁ : B.op ⋙ H₁.cohomologyPresheaf 0 ⟶ B.op ⋙ H₂.cohomologyPresheaf 0 :=
        CategoryTheory.Functor.whiskerLeft B.op
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ)
      let t₁ : B.op ⋙ H₁.cohomologyPresheaf 0 ⟶ (pf.obj H₁).obj :=
        CategoryTheory.Functor.whiskerLeft B.op (θ_pre H₁).hom
      let t₂ : B.op ⋙ H₂.cohomologyPresheaf 0 ⟶ (pf.obj H₂).obj :=
        CategoryTheory.Functor.whiskerLeft B.op (θ_pre H₂).hom
      let c₁ : Sh_S.obj ((pf.obj H₁).obj) ⟶ pf.obj H₁ := adj_shS.counit.app (pf.obj H₁)
      let c₂ : Sh_S.obj ((pf.obj H₂).obj) ⟶ pf.obj H₂ := adj_shS.counit.app (pf.obj H₂)
      have h_sq_pre : m₁ ≫ t₂ = t₁ ≫ (pf.map φ).hom := by
        ext W α
        exact congrArg (fun ν => ν.app (B.op.obj W) α) (hθ_mor φ)
      have h_hom_comm : R_map 0 φ ≫ (e_deg0 H₂).hom = (e_deg0 H₁).hom ≫ pf.map φ :=
        ((CategoryTheory.Category.assoc (Sh_S.map m₁) (Sh_S.map t₂) c₂).symm.trans
          (congrArg (· ≫ c₂) (Sh_S.map_comp m₁ t₂).symm)).trans
          ((congrArg (fun k => Sh_S.map k ≫ c₂) h_sq_pre).trans
            ((congrArg (· ≫ c₂) (Sh_S.map_comp t₁ (pf.map φ).hom)).trans
              ((CategoryTheory.Category.assoc (Sh_S.map t₁) (Sh_S.map (pf.map φ).hom) c₂).trans
                ((congrArg (Sh_S.map t₁ ≫ ·) (adj_shS.counit.naturality (pf.map φ))).trans
                  (CategoryTheory.Category.assoc (Sh_S.map t₁) c₁ (pf.map φ)).symm))))
      exact (congrArg ((e_deg0 H₁).inv ≫ ·) h_hom_comm).trans
        (CategoryTheory.Iso.inv_hom_id_assoc (e_deg0 H₁) (pf.map φ))

    refine ⟨fun H => ⟨e_deg0 H⟩, hInjHDI, fun SC hSE hAcyc => ?_⟩
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite C_X)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Z_fun : C_X ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      CategoryTheory.yoneda ⋙ Free_PSh ⋙
        CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
    let Z_obj : Opposite C_X → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      fun W => Opposite.unop (Z_fun.op.obj W)
    let δ_pre : ∀ (q : ℕ), SC.X₃.cohomologyPresheaf q ⟶ SC.X₁.cohomologyPresheaf (q + 1) :=
      fun q =>
        { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
          naturality := fun {W₁ W₂} ω => by
            have hL : (SC.X₃.cohomologyPresheaf q).map ω =
                ((CategoryTheory.Abelian.extFunctor q).map (Z_fun.op.map ω)).app SC.X₃ := rfl
            have hR : (SC.X₁.cohomologyPresheaf (q + 1)).map ω =
                ((CategoryTheory.Abelian.extFunctor (q + 1)).map (Z_fun.op.map ω)).app SC.X₁ := rfl
            rw [hL, hR,
              CategoryTheory.Abelian.extFunctor_map_app q (Z_fun.op.map ω) SC.X₃,
              CategoryTheory.Abelian.extFunctor_map_app (q + 1) (Z_fun.op.map ω) SC.X₁]
            ext α
            exact CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
              (Nat.zero_add q) rfl (by omega) }
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite C_S) (Opposite C_X)
      AddCommGrpCat.{u}).obj B.op
    let Δ : ∀ q : ℕ, R_fn q SC.X₃ ⟶ R_fn (q + 1) SC.X₁ :=
      fun q => Sh_S.map (CategoryTheory.Functor.whiskerLeft B.op (δ_pre q))
    have hex_both : ∀ (q : ℕ),
        ∃ (h23 : R_map q SC.g ≫ Δ q = 0)
          (h31 : Δ q ≫ R_map (q + 1) SC.f = 0),
          (CategoryTheory.ShortComplex.mk (R_map q SC.g) (Δ q) h23).Exact ∧
          (CategoryTheory.ShortComplex.mk (Δ q) (R_map (q + 1) SC.f) h31).Exact := by
      intro q
      have h23_pre : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g) ≫
          δ_pre q = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        exact congrArg (fun φ => φ x) hz
      have h31_pre : δ_pre q ≫
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f) = 0 := by
        ext W x
        have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        have hz := (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
        exact congrArg (fun φ => φ x) hz
      let A_pre := CategoryTheory.ShortComplex.mk
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q).map SC.g) (δ_pre q) h23_pre
      let B_pre := CategoryTheory.ShortComplex.mk (δ_pre q)
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (q + 1)).map SC.f) h31_pre
      have hEx_A : A_pre.Exact := by
        rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
          CategoryTheory.Functor.isZero_iff]
        intro W
        let evW := (CategoryTheory.evaluation (Opposite C_X) AddCommGrpCat.{u}).obj W
        have hexW : (A_pre.map evW).Exact :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE q (q + 1) rfl
        rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology] at hexW
        exact CategoryTheory.Limits.IsZero.of_iso hexW (A_pre.mapLeftHomologyIso evW).symm
      have hEx_B : B_pre.Exact := by
        rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
          CategoryTheory.Functor.isZero_iff]
        intro W
        let evW := (CategoryTheory.evaluation (Opposite C_X) AddCommGrpCat.{u}).obj W
        have hexW : (B_pre.map evW).Exact :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE q (q + 1) rfl
        rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology] at hexW
        exact CategoryTheory.Limits.IsZero.of_iso hexW (B_pre.mapLeftHomologyIso evW).symm
      let F_push := W_B ⋙ Sh_S
      have hEx_A_sh : (A_pre.map F_push).Exact := hEx_A.map F_push
      have hEx_B_sh : (B_pre.map F_push).Exact := hEx_B.map F_push
      exact ⟨(A_pre.map F_push).zero, (B_pre.map F_push).zero, hEx_A_sh, hEx_B_sh⟩
    have hEpi_Δ : ∀ q : ℕ, CategoryTheory.Epi (Δ q) := by
      intro q
      obtain ⟨_, h31, _, hexB⟩ := hex_both q
      have hf0 : R_map (q + 1) SC.f = 0 := (hAcyc (q + 1) (by omega)).eq_of_tgt _ 0
      exact (CategoryTheory.ShortComplex.exact_iff_epi _ hf0).mp hexB
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · obtain ⟨h23_0, _, hexA_0, _⟩ := hex_both 0
      have : CategoryTheory.Epi (Δ 0) := hEpi_Δ 0
      let δ₀ : pf.obj SC.X₃ ⟶ R_fn 1 SC.X₁ := (e_deg0 SC.X₃).inv ≫ Δ 0
      have hEpi_δ₀ : CategoryTheory.Epi δ₀ := CategoryTheory.epi_comp _ _
      have hcomp : pf.map SC.g ≫ δ₀ = 0 := by
        dsimp [δ₀]
        rw [← he_deg0_nat SC.g, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Iso.hom_inv_id_assoc, h23_0, CategoryTheory.Limits.comp_zero]
      have hex_δ₀ : (CategoryTheory.ShortComplex.mk (pf.map SC.g) δ₀ hcomp).Exact := by
        let iso_sc : CategoryTheory.ShortComplex.mk (R_map 0 SC.g) (Δ 0) h23_0 ≅
            CategoryTheory.ShortComplex.mk (pf.map SC.g) δ₀ hcomp :=
