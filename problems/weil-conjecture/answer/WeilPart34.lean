      have h_comp_map : R₀.obj.map (v ≫ u_eid ≫ e_Y.hom.app U₀).op =
          R₀.obj.map (e_Y.hom.app U₀).op ≫ R₀.obj.map u_eid.op ≫ R₀.obj.map v.op := by
        rw [op_comp, op_comp, R₀.obj.map_comp, R₀.obj.map_comp, Category.assoc]
      exact h1.trans
        ((congrArg (fun x => (R₀.obj.map v.op) (((η_id_hom R₀).hom.app (Opposite.op U')) x))
