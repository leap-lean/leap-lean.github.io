              (LinearMap.baseChange (S l₀) (inl_R l₁ l₂) (u i l₁) -
                ∑ j : Fin m, LinearMap.baseChange (S l₀) (mulRight_R (χ l₁ l₂ i j)) (u j l₂)) +
              (LinearMap.baseChange (S l₀) (inl_R l₁ l₂) (v i l₁) -
                ∑ j : Fin m, LinearMap.baseChange (S l₀) (mulRight_R (χ l₁ l₂ i j)) (v j l₂))
            simp only [map_add, Finset.sum_add_distrib, sub_add_sub_comm]
          map_smul' := fun t u => by
            funext l₁ l₂ i
            change LinearMap.baseChange (S l₀) (inl_R l₁ l₂) (t • u i l₁) -
                ∑ j : Fin m, LinearMap.baseChange (S l₀) (mulRight_R (χ l₁ l₂ i j)) (t • u j l₂) =
              t • (LinearMap.baseChange (S l₀) (inl_R l₁ l₂) (u i l₁) -
                ∑ j : Fin m, LinearMap.baseChange (S l₀) (mulRight_R (χ l₁ l₂ i j)) (u j l₂))
            simp only [map_smul, Finset.smul_sum, smul_sub] }
      let ι_0 : TensorProduct R (S l₀) ↥B →ₗ[S l₀]
          (Fin m → ∀ l : I, TensorProduct R (S l₀) (S l)) :=
        E₁.toLinearMap.comp (LinearMap.baseChange (S l₀) B.val.toLinearMap)
      obtain ⟨hι_tmul, hι_inj, hΔ_exact⟩ :
          (∀ (t : S l₀) (b : ↥B) (i : Fin m) (l : I),
            ι_0 (TensorProduct.tmul R t b) i l = TensorProduct.tmul R t (b.1 i l)) ∧
          Function.Injective ι_0 ∧
          (∀ u : Fin m → ∀ l : I, TensorProduct R (S l₀) (S l),
