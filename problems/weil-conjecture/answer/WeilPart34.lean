    let η_sh := CategoryTheory.toSheafify J P
    have : CategoryTheory.Presheaf.IsLocallyInjective J η_sh := inferInstance
    have : CategoryTheory.Presheaf.IsLocallySurjective J η_sh := inferInstance
    constructor
    · intro x y hxy
