  have hCohomIso : Nonempty
      ((M_gU.op ⋙ F.cohomologyPresheaf b) ≅ (R_gU.obj F).cohomologyPresheaf b) := by
    let W_Mg : (CategoryTheory.Functor (Opposite Y'.Etale) AddCommGrpCat.{u}) ⥤
        (CategoryTheory.Functor (Opposite U.Etale) AddCommGrpCat.{u}) :=
      (CategoryTheory.Functor.whiskeringLeft (Opposite U.Etale) (Opposite Y'.Etale)
        AddCommGrpCat.{u}).obj M_gU.op
    let CP_Y' : ℕ → CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Functor (Opposite Y'.Etale) AddCommGrpCat.{u} :=
      fun n => CategoryTheory.Sheaf.cohomologyPresheafFunctor Y'.smallEtaleTopology n
    let CP_U : ℕ → CategoryTheory.Sheaf U.smallEtaleTopology AddCommGrpCat.{u} ⥤
        CategoryTheory.Functor (Opposite U.Etale) AddCommGrpCat.{u} :=
      fun n => CategoryTheory.Sheaf.cohomologyPresheafFunctor U.smallEtaleTopology n

    obtain ⟨⟨τ_Y'⟩, hInjZero_Y', hConnPre_Y'⟩ := hSchemeCalc Y'
    obtain ⟨⟨τ_U⟩, hInjZero_U, hConnPre_U⟩ := hSchemeCalc U

    have hMapSE : ∀ {SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u})},
        SC.ShortExact → (SC.map R_gU).ShortExact := by
      intro SC hSE
      let _ : R_gU.Additive := hAdd_R
      let _ : CategoryTheory.Limits.PreservesFiniteLimits R_gU := hLim_R
      let _ : CategoryTheory.Limits.PreservesFiniteColimits R_gU := hColim_R
      exact hSE.map_of_exact R_gU

    let e_R_pre : (CategoryTheory.sheafToPresheaf Y'.smallEtaleTopology AddCommGrpCat.{u} ⋙ W_Mg) ≅
        (R_gU ⋙ CategoryTheory.sheafToPresheaf U.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _)
        (by intro _ _ _; ext _ _; rfl)
    let Φ₀ : (CP_Y' 0 ⋙ W_Mg) ≅ (R_gU ⋙ CP_U 0) :=
      CategoryTheory.Functor.isoWhiskerRight τ_Y' W_Mg ≪≫
        e_R_pre ≪≫
        CategoryTheory.Functor.isoWhiskerLeft R_gU τ_U.symm

