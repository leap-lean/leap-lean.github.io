        obtain ⟨e_Q⟩ := ih Q
        exact ⟨(W_Mg.mapIso (CategoryTheory.asIso δ_Y)).symm ≪≫ e_Q ≪≫ CategoryTheory.asIso δ_U⟩

    rcases b with _ | k
    · exact ⟨Φ₀.app F⟩
    · exact hPos k F

  
  rcases hPB_F with ⟨hc_gU', hr_gU', ⟨e_F0⟩⟩
  obtain rfl : hc_gU' = hc_gU := Subsingleton.elim _ _
  obtain rfl : hr_gU' = hr_gU := Subsingleton.elim _ _

  let P_coh := CategoryTheory.Sheaf.cohomologyPresheaf F b
  let Sh_Y := CategoryTheory.presheafToSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  let B_j := weilEtaleSitePullback j
  let B_jU := weilEtaleSitePullback j_U

  obtain ⟨e₁⟩ := hSh_ι (B_j.op ⋙ P_coh)
  obtain ⟨α_cart⟩ := hCartIso
  let α_op : (M_ι.op ⋙ B_j.op) ≅ (B_jU.op ⋙ M_gU.op) := CategoryTheory.NatIso.op α_cart
  let e₂ : Sh_Y.obj (M_ι.op ⋙ (B_j.op ⋙ P_coh)) ≅ Sh_Y.obj (B_jU.op ⋙ (M_gU.op ⋙ P_coh)) :=
    Sh_Y.mapIso
      ((CategoryTheory.Functor.associator M_ι.op B_j.op P_coh).symm ≪≫
        CategoryTheory.Functor.isoWhiskerRight α_op P_coh ≪≫
        CategoryTheory.Functor.associator B_jU.op M_gU.op P_coh)
  obtain ⟨β_coh⟩ := hCohomIso
  let e₃ : Sh_Y.obj (B_jU.op ⋙ (M_gU.op ⋙ P_coh)) ≅ weilEtaleHigherDirectImage j_U b (R_gU.obj F) :=
    Sh_Y.mapIso (CategoryTheory.Functor.isoWhiskerLeft B_jU.op β_coh)
  let e₄ : weilEtaleHigherDirectImage j_U b (R_gU.obj F) ≅ weilEtaleHigherDirectImage j_U b F_U :=
    Sh_Y.mapIso (CategoryTheory.Functor.isoWhiskerLeft B_jU.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor U.smallEtaleTopology b).mapIso
        (e_RgU.app F ≪≫ e_F0)))

  exact ⟨hc_ι, hr_ι, ⟨e₁ ≪≫ e₂ ≪≫ e₃ ≪≫ e₄⟩⟩

theorem weil_leray_sec_open_conn_torsion_pushforward_iso (P₀ Y' : AlgebraicGeometry.Scheme.{u}) (j : Y' ⟶ P₀)
    [AlgebraicGeometry.IsOpenImmersion j]
    (hConn : ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ P₀) [AlgebraicGeometry.Etale w],
      ConnectedSpace ↥W → Nonempty ↥W →
      ConnectedSpace ↥(CategoryTheory.Limits.pullback j w) ∧
      Nonempty ↥(CategoryTheory.Limits.pullback j w))
    (hConnBasis : ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (w : W ⟶ P₀) [AlgebraicGeometry.Etale w] (x : ↥W),
      ∃ (O : W.Opens),
        AlgebraicGeometry.IsAffineOpen O ∧ x ∈ O ∧ ConnectedSpace ↥O.toScheme)
    (m : ℕ) :
    Nonempty (weilEtaleTorsionSheaf P₀ m ≅
      weilEtaleHigherDirectImage j 0 (weilEtaleTorsionSheaf Y' m)) :=
by
  classical
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  have h_etale_term : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id S)) := by
    intro S
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial) ?_
    intro U m_hom
    apply (AlgebraicGeometry.Scheme.Etale.forget S).map_injective
    apply CategoryTheory.Over.OverMorphism.ext
    exact (CategoryTheory.Category.comp_id m_hom.left).symm.trans
      (CategoryTheory.MorphismProperty.Over.w m_hom)

  
  have h_mem_etale : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have heq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl (@AlgebraicGeometry.Etale :
        CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}))
    have hiff := @AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) S
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      inferInstance inferInstance inferInstance inferInstance W R
    exact (iff_of_eq
      (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J W) heq)).trans hiff

  
  have h_mor_etale : ∀ {S : AlgebraicGeometry.Scheme.{u}} {Y₁ Y₂ : S.Etale} (u : Y₁ ⟶ Y₂),
      AlgebraicGeometry.Etale u.left := by
    intro S Y₁ Y₂ u
    have hw : u.left ≫ Y₂.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w u
    have hcomp : AlgebraicGeometry.Etale (u.left ≫ Y₂.hom) := hw.symm ▸ Y₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
      u.left Y₂.hom Y₂.prop hcomp

  
  have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) j :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.Etale) j :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_j : CategoryTheory.Functor P₀.Etale Y'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ j
  have hc_j : B_j.IsContinuous P₀.smallEtaleTopology Y'.smallEtaleTopology := by
    have : CategoryTheory.Limits.HasTerminal P₀.Etale := (h_etale_term P₀).hasTerminal
    have : CategoryTheory.Limits.HasPullbacks P₀.Etale :=
      CategoryTheory.MorphismProperty.Over.hasPullbacks (@AlgebraicGeometry.Etale) P₀
    have : CategoryTheory.Limits.HasFiniteLimits P₀.Etale :=
      CategoryTheory.Limits.hasFiniteLimits_of_hasTerminal_and_pullbacks
    have : CategoryTheory.Limits.PreservesFiniteLimits B_j :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
        (@AlgebraicGeometry.Etale) j
    have : CategoryTheory.RepresentablyFlat B_j :=
      CategoryTheory.flat_of_preservesFiniteLimits B_j
    have hCompat_B : CategoryTheory.CompatiblePreserving Y'.smallEtaleTopology B_j :=
      CategoryTheory.compatiblePreservingOfFlat Y'.smallEtaleTopology B_j
    have hCover_B :
        CategoryTheory.CoverPreserving P₀.smallEtaleTopology Y'.smallEtaleTopology B_j := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro U S hS
      have hS' := (h_mem_etale P₀ U S).mp hS
      refine (h_mem_etale Y' (B_j.obj U) _).mpr ?_
      intro z
      let fst_U : (B_j.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom j
      obtain ⟨Y, f_Y, y, hfS, hfEt, hy⟩ := hS' (fst_U.base z)
      have h_outer : CategoryTheory.IsPullback
          ((B_j.map f_Y).left ≫ CategoryTheory.Limits.pullback.snd U.hom j)
          (CategoryTheory.Limits.pullback.fst Y.hom j) j (f_Y.left ≫ U.hom) := by
        have hw₁ : (B_j.map f_Y).left ≫ CategoryTheory.Limits.pullback.snd U.hom j =
            CategoryTheory.Limits.pullback.snd Y.hom j :=
          CategoryTheory.MorphismProperty.Over.w (B_j.map f_Y)
        have hw₂ : f_Y.left ≫ U.hom = Y.hom := CategoryTheory.MorphismProperty.Over.w f_Y
        rw [hw₁, hw₂]
        exact (CategoryTheory.IsPullback.of_hasPullback Y.hom j).flip
      have h_comm_left : (B_j.map f_Y).left ≫ fst_U =
          CategoryTheory.Limits.pullback.fst Y.hom j ≫ f_Y.left := by
        dsimp [B_j, fst_U, CategoryTheory.MorphismProperty.Over.pullback]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd U.hom j) fst_U j U.hom :=
        (CategoryTheory.IsPullback.of_hasPullback U.hom j).flip
      have hp_left : CategoryTheory.IsPullback
          (B_j.map f_Y).left (CategoryTheory.Limits.pullback.fst Y.hom j) fst_U f_Y.left :=
        CategoryTheory.IsPullback.of_right h_outer h_comm_left h_right
      let e_pb := hp_left.isoPullback
      obtain ⟨p, hp_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hy.symm
      refine ⟨B_j.obj Y, B_j.map f_Y, e_pb.inv.base p, ?_, ?_, ?_⟩
      · exact ⟨Y, f_Y, 𝟙 (B_j.obj Y), hfS, (CategoryTheory.Category.id_comp _).symm⟩
      · exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hp_left.flip hfEt
      · have heq : e_pb.inv ≫ (B_j.map f_Y).left =
            CategoryTheory.Limits.pullback.fst fst_U f_Y.left := by
          rw [CategoryTheory.Iso.inv_comp_eq]
          exact (CategoryTheory.IsPullback.isoPullback_hom_fst hp_left).symm
        calc
          (B_j.map f_Y).left.base (e_pb.inv.base p) =
            (e_pb.inv ≫ (B_j.map f_Y).left).base p := rfl
          _ = (CategoryTheory.Limits.pullback.fst fst_U f_Y.left).base p := by rw [heq]
          _ = z := hp_fst
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat_B hCover_B
  have : B_j.IsContinuous P₀.smallEtaleTopology Y'.smallEtaleTopology := hc_j
  let pf_j := B_j.sheafPushforwardContinuous AddCommGrpCat.{u}
    P₀.smallEtaleTopology Y'.smallEtaleTopology

  
  have h_hdi0 : ∀ (F : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}),
      Nonempty (weilEtaleHigherDirectImage j 0 F ≅ pf_j.obj F) := by
    intro F
    let J_X := Y'.smallEtaleTopology
    let J_S := P₀.smallEtaleTopology
    let W_B : CategoryTheory.Functor
        (CategoryTheory.Functor (Opposite Y'.Etale) AddCommGrpCat.{u})
        (CategoryTheory.Functor (Opposite P₀.Etale) AddCommGrpCat.{u}) :=
      (CategoryTheory.Functor.whiskeringLeft (Opposite P₀.Etale) (Opposite Y'.Etale)
        AddCommGrpCat.{u}).obj B_j.op
    let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
    let E_S := W_B.comp Sh_S
    let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y'.Etale)
      (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
    let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite Y'.Etale)
      AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
    let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
    let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
    let L_tot := Free_PSh ⋙ Sh_X
    let R_tot := U_X ⋙ Fgt_PSh
    let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite Y'.Etale) AddCommGrpCat.adj
    let adj_sh_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
    let adj_tot : L_tot ⊣ R_tot := adj_free.comp adj_sh_X
    let Z_fun : Y'.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      CategoryTheory.yoneda ⋙ L_tot
    let Z_obj : Opposite Y'.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      fun W => Opposite.unop (Z_fun.op.obj W)
    let e_raw : ∀ (W : Opposite Y'.Etale),
        CategoryTheory.Abelian.Ext (Z_obj W) F 0 ≃ ↑((U_X.obj F).obj W) :=
      fun W =>
        CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
          ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) F).trans
            CategoryTheory.yonedaEquiv)
    have he_add : ∀ (W : Opposite Y'.Etale)
        (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
        e_raw W (α₁ + α₂) = e_raw W α₁ + e_raw W α₂ := by
      intro W α₁ α₂
      let V := Opposite.unop W
      let u₁ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
      let u₂ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
      have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
        map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
      let ψ : (Z_obj W ⟶ F) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F) :=
        fun u => adj_sh_X.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) F u
      have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
        dsimp [ψ]
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
          CategoryTheory.Adjunction.homEquiv_unit]
        have hmap : U_X.map (u₁ + u₂) = U_X.map u₁ + U_X.map u₂ := rfl
        rw [hmap, CategoryTheory.Preadditive.comp_add]
      let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F) →
          ↑((U_X.obj F).obj W) :=
        fun φ => CategoryTheory.yonedaEquiv
          (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_X.obj F) φ)
      let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
      have hyon : ∀ (φ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_X.obj F),
          eval_hom φ = (φ.app W) g₀ := by
        intro φ
        dsimp [eval_hom]
        rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
          e_raw W α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
        intro α
        dsimp [e_raw, eval_hom, ψ, adj_tot]
        rw [CategoryTheory.Adjunction.comp_homEquiv]
        rfl
      rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
        CategoryTheory.NatTrans.app_add]
      rfl
    let e_add : ∀ (W : Opposite Y'.Etale),
        ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W) ≃+
          ↑((U_X.obj F).obj W) :=
      fun W => AddEquiv.mk' (e_raw W) (he_add W)
    let θ_comp : ∀ (W : Opposite Y'.Etale),
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).obj W ≅
          (U_X.obj F).obj W :=
      fun W =>
        { hom := AddCommGrpCat.ofHom (e_add W).toAddMonoidHom
          inv := AddCommGrpCat.ofHom (e_add W).symm.toAddMonoidHom
          hom_inv_id := by ext x; exact (e_add W).symm_apply_apply x
          inv_hom_id := by ext y; exact (e_add W).apply_symm_apply y }
    let θ_F : (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F ≅ U_X.obj F :=
      CategoryTheory.NatIso.ofComponents (fun W => θ_comp W) (by
        intro W₁ W₂ ω
        have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).map ω =
            ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F := rfl
        rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F]
        ext α
        let u : Z_obj W₁ ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α
        have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
        change e_raw W₂
            ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
          ((U_X.obj F).map ω) (e_raw W₁ α)
        rw [hα]
        have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
        rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        dsimp [e_raw]
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
          CategoryTheory.Adjunction.homEquiv_naturality_left,
          ← CategoryTheory.yonedaEquiv_naturality',
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
        rfl)
    let e_counit : Sh_S.obj ((pf_j.obj F).obj) ≅ pf_j.obj F :=
      CategoryTheory.asIso
        ((CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).counit.app (pf_j.obj F))
    exact ⟨E_S.mapIso θ_F ≪≫ e_counit⟩

  
  have h_unit_iso_conn : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u})
      (E₀ : Z.Etale) [ConnectedSpace ↥E₀.left],
      CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Z.Etale)).obj A)).app (Opposite.op E₀)) := by
    intro Z A E₀ _
    let P_A : CategoryTheory.Functor (Opposite Z.Etale) AddCommGrpCat.{u} :=
      { obj := fun E => AddCommGrpCat.of (LocallyConstant ↥E.unop.left ↥A)
        map := fun {E₁ E₂} f =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom (Z := ↥A) f.unop.left.base.hom)
        map_id := fun _ => by
          apply AddCommGrpCat.ext
          intro g
          ext x
          rfl
        map_comp := fun _ _ => by
          apply AddCommGrpCat.ext
          intro h
          ext x
          rfl }
    let P_const := (CategoryTheory.Functor.const (Opposite Z.Etale)).obj A
    let θ_A : P_const ⟶ P_A :=
      { app := fun E =>
          AddCommGrpCat.ofHom (LocallyConstant.constAddMonoidHom (X := ↥E.unop.left) (Y := ↥A))
        naturality := fun _ _ _ => by
          apply AddCommGrpCat.ext
          intro a
          ext x
          rfl }
    have hP_sheaf : CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology P_A := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro E S hS
      have hcov := (h_mem_etale Z E S).mp hS
      let eval_c : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w : S.arrows.category) (_ : ↥c.pt), LocallyConstant ↥w.obj.left.left ↥A :=
        fun c w m_pt => (c.π.app (Opposite.op w)).hom m_pt
      have h_ov : ∀ (c : CategoryTheory.Limits.Cone (S.arrows.diagram.op ⋙ P_A))
          (w₁ w₂ : S.arrows.category) (m_pt : ↥c.pt)
          (y₁ : ↥w₁.obj.left.left) (y₂ : ↥w₂.obj.left.left),
          w₁.obj.hom.left.base y₁ = w₂.obj.hom.left.base y₂ →
          eval_c c w₁ m_pt y₁ = eval_c c w₂ m_pt y₂ := by
        intro c w₁ w₂ m_pt y₁ y₂ hy_eq
        let u₁ : w₁.obj.left ⟶ E := w₁.obj.hom
        let u₂ : w₂.obj.left ⟶ E := w₂.obj.hom
        have hu₂_et : AlgebraicGeometry.Etale u₂.left := h_mor_etale u₂
        let Z_sch := CategoryTheory.Limits.pullback u₁.left u₂.left
        let p₁ : Z_sch ⟶ w₁.obj.left.left := CategoryTheory.Limits.pullback.fst u₁.left u₂.left
        let p₂ : Z_sch ⟶ w₂.obj.left.left := CategoryTheory.Limits.pullback.snd u₁.left u₂.left
        have hp₁_et : AlgebraicGeometry.Etale p₁ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback u₁.left u₂.left).flip hu₂_et
        have hZ_et : AlgebraicGeometry.Etale (p₁ ≫ w₁.obj.left.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            p₁ w₁.obj.left.hom hp₁_et w₁.obj.left.prop
        let Z_et : Z.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁.obj.left.hom) hZ_et
        let q₁ : Z_et ⟶ w₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hq₂_w : p₂ ≫ w₂.obj.left.hom = Z_et.hom :=
          (congrArg (p₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₂).symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ E.hom) CategoryTheory.Limits.pullback.condition.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  (congrArg (p₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w u₁)))))
        let q₂ : Z_et ⟶ w₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hq₂_w trivial
        have hq_comm : q₁ ≫ u₁ = q₂ ≫ u₂ := by
          apply (AlgebraicGeometry.Scheme.Etale.forget Z).map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let w₁₂ : S.arrows.category :=
          ⟨CategoryTheory.Over.mk (q₁ ≫ u₁), S.downward_closed w₁.property q₁⟩
        let mor₁ : w₁₂ ⟶ w₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₁ rfl)
        let mor₂ : w₁₂ ⟶ w₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk q₂ hq_comm.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
        have hev₁ : eval_c c w₁ m_pt (p₁.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₁.op)
        have hev₂ : eval_c c w₂ m_pt (p₂.base z) = eval_c c w₁₂ m_pt z :=
          congrArg (fun φ => (φ.hom m_pt : LocallyConstant ↥Z_sch ↥A) z) (c.w mor₂.op)
        rw [← hz₁, ← hz₂, hev₁, hev₂]
      refine ⟨{
        lift := fun c =>
          let g_fn : ↥c.pt → ↥E.left → ↥A := fun m_pt x =>
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            eval_c c w_x m_pt y_x
          have hg_eq : ∀ (m_pt : ↥c.pt) (w : S.arrows.category) (y : ↥w.obj.left.left),
              g_fn m_pt (w.obj.hom.left.base y) = eval_c c w m_pt y := by
            intro m_pt w y
            let x := w.obj.hom.left.base y
            let ch := hcov x
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            exact h_ov c w_x w m_pt y_x y hy_x
          have hg_lc : ∀ m_pt : ↥c.pt, IsLocallyConstant (g_fn m_pt) := by
            intro m_pt
            rw [IsLocallyConstant.iff_isOpen_fiber]
            intro a
            rw [isOpen_iff_forall_mem_open]
            intro x hx
            let ch := hcov x
            let Y_x := ch.choose
            let u_x := ch.choose_spec.choose
            let y_x := ch.choose_spec.choose_spec.choose
            let hu_x := ch.choose_spec.choose_spec.choose_spec.1
            let hEt_x := ch.choose_spec.choose_spec.choose_spec.2.1
            let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
            let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
            let f_x : LocallyConstant ↥Y_x.left ↥A := eval_c c w_x m_pt
            let O : Set ↥Y_x.left := f_x ⁻¹' {a}
            have hO_open : IsOpen O := f_x.isLocallyConstant {a}
            have : AlgebraicGeometry.Etale u_x.left := hEt_x
            have hu_open : IsOpen (u_x.left.base '' O) := u_x.left.isOpenMap O hO_open
            refine ⟨u_x.left.base '' O, ?_, hu_open, ⟨y_x, ?_, hy_x⟩⟩
            · rintro _ ⟨y', hy', rfl⟩
              change g_fn m_pt (w_x.obj.hom.left.base y') = a
              rw [hg_eq m_pt w_x y']
              exact hy'
            · change f_x y_x = a
              have hfx : f_x y_x = g_fn m_pt x := rfl
              rw [hfx]
              exact hx
          AddCommGrpCat.ofHom
            { toFun := fun m_pt => ⟨g_fn m_pt, hg_lc m_pt⟩
              map_zero' := by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have h0 : eval_c c w_x 0 = 0 := map_zero (c.π.app (Opposite.op w_x)).hom
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) h0
              map_add' := fun m₁ m₂ => by
                apply LocallyConstant.ext
                intro x
                let ch := hcov x
                let u_x := ch.choose_spec.choose
                let y_x := ch.choose_spec.choose_spec.choose
                let hu_x := ch.choose_spec.choose_spec.choose_spec.1
                let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
                have hadd : eval_c c w_x (m₁ + m₂) = eval_c c w_x m₁ + eval_c c w_x m₂ :=
                  map_add (c.π.app (Opposite.op w_x)).hom m₁ m₂
                exact congrArg (fun f : LocallyConstant ↥w_x.obj.left.left ↥A => f y_x) hadd }
        fac := fun c j_idx => by
          apply AddCommGrpCat.ext
          intro m_pt
          change _ = eval_c c j_idx.unop m_pt
          ext y
          let x := j_idx.unop.obj.hom.left.base y
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          exact h_ov c w_x j_idx.unop m_pt y_x y hy_x
        uniq := fun c k hk => by
          apply AddCommGrpCat.ext
          intro m_pt
          let km : LocallyConstant ↥E.left ↥A := k.hom m_pt
          change km = _
          apply LocallyConstant.ext
          intro x
          let ch := hcov x
          let u_x := ch.choose_spec.choose
          let y_x := ch.choose_spec.choose_spec.choose
          let hu_x := ch.choose_spec.choose_spec.choose_spec.1
          let hy_x := ch.choose_spec.choose_spec.choose_spec.2.2
          let w_x : S.arrows.category := ⟨CategoryTheory.Over.mk u_x, hu_x⟩
          have hkx := congrArg
            (fun φ => (φ.hom m_pt : LocallyConstant ↥w_x.obj.left.left ↥A) y_x)
            (hk (Opposite.op w_x))
          change km (u_x.left.base y_x) = eval_c c w_x m_pt y_x at hkx
          rw [hy_x] at hkx
          exact hkx
      }⟩
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallyInjective.mk ?_
      intro E a₁ a₂ ha
      by_cases hEmp : IsEmpty ↥E.unop.left
      · have hbot : ⊥ ∈ Z.smallEtaleTopology E.unop := by
          let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme :=
            @AlgebraicGeometry.Etale
          let E' : P.Over ⊤ Z := E.unop
          change (⊥ : CategoryTheory.Sieve E') ∈
            ((CategoryTheory.MorphismProperty.Over.forget P ⊤ Z).restrictedTopology
              (AlgebraicGeometry.Scheme.overGrothendieckTopology P Z)) E'
          rw [CategoryTheory.Functor.mem_restrictedTopology_iff]
          exact (CategoryTheory.GrothendieckTopology.mem_over_iff _ _).mpr
            (CategoryTheory.GrothendieckTopology.superset_covering _ bot_le
              (AlgebraicGeometry.Scheme.bot_mem_grothendieckTopology E.unop.left))
        exact Z.smallEtaleTopology.superset_covering bot_le hbot
      · obtain ⟨x₀⟩ := not_isEmpty_iff.mp hEmp
        have ha_eq : a₁ = a₂ := congrArg (fun f : LocallyConstant ↥E.unop.left ↥A => f x₀) ha
        subst ha_eq
        have htop : CategoryTheory.Presheaf.equalizerSieve
            (F := P_const) (X := E) a₁ a₁ = ⊤ := by
          apply CategoryTheory.Sieve.id_mem_iff_eq_top.mp
          rfl
        rw [htop]
        exact Z.smallEtaleTopology.top_mem E.unop
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective Z.smallEtaleTopology θ_A := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
      intro E f
      refine (h_mem_etale Z E (CategoryTheory.Presheaf.imageSieve θ_A f)).mpr ?_
      intro x
      let f_lc : LocallyConstant ↥E.left ↥A := f
      let a : ↥A := f_lc x
      let O_a : E.left.Opens := ⟨f_lc ⁻¹' {a}, f_lc.isLocallyConstant {a}⟩
      have hY_et : AlgebraicGeometry.Etale (O_a.ι ≫ E.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          O_a.ι E.hom inferInstance E.prop
      let Y_a : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_a.ι ≫ E.hom) hY_et
      let u_a : Y_a ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_a.ι rfl trivial
      refine ⟨Y_a, u_a, ⟨x, rfl⟩, ?_, inferInstance, rfl⟩
      refine ⟨a, ?_⟩
      ext y
      exact y.2.symm
    have hW_θ : Z.smallEtaleTopology.W θ_A :=
      (Z.smallEtaleTopology.W_iff_isLocallyBijective θ_A).mpr ⟨hLocInj, hLocSurj⟩
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A) :=
      (Z.smallEtaleTopology.W_iff θ_A).mp hW_θ
    let ℒ_A : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} := ⟨P_A, hP_sheaf⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let Υ_A : (CategoryTheory.constantSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ ℒ_A :=
      (adj_sh.homEquiv P_const ℒ_A).symm θ_A
    have hΥ_eq : Υ_A =
        (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map θ_A ≫
          adj_sh.counit.app ℒ_A := by
      dsimp [Υ_A]
      exact CategoryTheory.Adjunction.homEquiv_counit adj_sh P_const ℒ_A θ_A
    have hIso_counit : CategoryTheory.IsIso (adj_sh.counit.app ℒ_A) := inferInstance
    have : CategoryTheory.IsIso Υ_A := by
      rw [hΥ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    let Γ_E₀ := (CategoryTheory.sheafSections Z.smallEtaleTopology AddCommGrpCat.{u}).obj
      (Opposite.op E₀)
    have hIso_ΥE₀ : CategoryTheory.IsIso (Υ_A.hom.app (Opposite.op E₀)) := by
      change CategoryTheory.IsIso (Γ_E₀.map Υ_A)
      infer_instance
    have h_unit_Υ : adj_sh.unit.app P_const ≫ Υ_A.hom = θ_A := by
      have h1 := (adj_sh.homEquiv P_const ℒ_A).apply_symm_apply θ_A
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
      exact h1
    have h_comp_E₀ :
        (adj_sh.unit.app P_const).app (Opposite.op E₀) ≫ Υ_A.hom.app (Opposite.op E₀) =
          θ_A.app (Opposite.op E₀) :=
      congrArg (fun η => η.app (Opposite.op E₀)) h_unit_Υ
    have h_bij : Function.Bijective ⇑(θ_A.app (Opposite.op E₀)).hom := by
      refine ⟨?_, ?_⟩
      · intro a₁ a₂ ha
        obtain ⟨v₀⟩ : Nonempty ↥E₀.left := ConnectedSpace.toNonempty
        exact congrArg (fun f : LocallyConstant ↥E₀.left ↥A => f v₀) ha
      · intro f
        have : PreconnectedSpace ↥E₀.left := ConnectedSpace.toPreconnectedSpace
        have : Nonempty ↥A := ⟨0⟩
        obtain ⟨a, rfl⟩ := LocallyConstant.exists_eq_const f
        exact ⟨a, rfl⟩
    have hIso_θ : CategoryTheory.IsIso (θ_A.app (Opposite.op E₀)) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (θ_A.app (Opposite.op E₀))).mpr h_bij
    rw [← h_comp_E₀] at hIso_θ
    exact @CategoryTheory.IsIso.of_isIso_comp_right _ _ _ _ _
      ((adj_sh.unit.app P_const).app (Opposite.op E₀)) (Υ_A.hom.app (Opposite.op E₀))
      hIso_ΥE₀ hIso_θ

  
  have h_basis : ∀ (E : P₀.Etale) (x : ↥E.left),
      ∃ (O_et : P₀.Etale) (f_O : O_et ⟶ E) (y : ↥O_et.left),
        AlgebraicGeometry.Etale f_O.left ∧
        f_O.left.base y = x ∧
        ConnectedSpace ↥O_et.left ∧
        ConnectedSpace ↥(B_j.obj O_et).left := by
    intro E x
    obtain ⟨U_x, hAff_Ux, hx_Ux, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := (⊤ : E.left.Opens)) trivial
    have : AlgebraicGeometry.IsAffine U_x.toScheme := hAff_Ux
    have hEt_Ux : AlgebraicGeometry.Etale (U_x.ι ≫ E.hom) :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        U_x.ι E.hom inferInstance E.prop
    obtain ⟨O, hAff_O, hx_O, hConn_O⟩ :=
      hConnBasis U_x.toScheme (U_x.ι ≫ E.hom) ⟨x, hx_Ux⟩
    have : AlgebraicGeometry.IsAffine O.toScheme := hAff_O
    let y₀ : ↥O.toScheme := ⟨⟨x, hx_Ux⟩, hx_O⟩
    let u_O : O.toScheme ⟶ E.left := O.ι ≫ U_x.ι
    have hEt_uO : AlgebraicGeometry.Etale u_O :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        O.ι U_x.ι inferInstance inferInstance
    let w_O : O.toScheme ⟶ P₀ := u_O ≫ E.hom
    have hEt_wO : AlgebraicGeometry.Etale w_O :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        u_O E.hom hEt_uO E.prop
    let O_et : P₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w_O hEt_wO
    let f_O : O_et ⟶ E := CategoryTheory.MorphismProperty.Over.homMk u_O rfl trivial
    obtain ⟨hConn_jw, -⟩ := hConn O.toScheme w_O hConn_O ⟨y₀⟩
    let e_symm := CategoryTheory.Limits.pullbackSymmetry j w_O
    have hSurj_symm : Function.Surjective e_symm.hom.base := by
      intro z
      refine ⟨e_symm.inv.base z, ?_⟩
      change (e_symm.inv ≫ e_symm.hom).base z = z
      rw [e_symm.inv_hom_id]
      rfl
    have hConn_wj : ConnectedSpace ↥(CategoryTheory.Limits.pullback w_O j) :=
      @Function.Surjective.connectedSpace _ _ _ hConn_jw _ _ hSurj_symm e_symm.hom.continuous
    exact ⟨O_et, f_O, y₀, hEt_uO, rfl, hConn_O, hConn_wj⟩

  
  let A_m : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C_P := CategoryTheory.constantSheaf P₀.smallEtaleTopology AddCommGrpCat.{u}
  let C_Y := CategoryTheory.constantSheaf Y'.smallEtaleTopology AddCommGrpCat.{u}
  let constP := (CategoryTheory.Functor.const (Opposite P₀.Etale)).obj A_m
  let constY := (CategoryTheory.Functor.const (Opposite Y'.Etale)).obj A_m
  let adj_P := CategoryTheory.sheafificationAdjunction P₀.smallEtaleTopology AddCommGrpCat.{u}
  let adj_Y := CategoryTheory.sheafificationAdjunction Y'.smallEtaleTopology AddCommGrpCat.{u}
  let η_P : constP ⟶ (C_P.obj A_m).obj := adj_P.unit.app constP
  let η_Y : constY ⟶ (C_Y.obj A_m).obj := adj_Y.unit.app constY
  let u_pre : constP ⟶ (pf_j.obj (C_Y.obj A_m)).obj :=
    CategoryTheory.Functor.whiskerLeft B_j.op η_Y
  let u_sh : C_P.obj A_m ⟶ pf_j.obj (C_Y.obj A_m) :=
    (adj_P.homEquiv constP (pf_j.obj (C_Y.obj A_m))).symm u_pre
  have hu_fac : η_P ≫ u_sh.hom = u_pre := by
    have h1 := (adj_P.homEquiv constP (pf_j.obj (C_Y.obj A_m))).apply_symm_apply u_pre
    rw [CategoryTheory.Adjunction.homEquiv_unit] at h1
    exact h1
  have hu_iso_on_conn : ∀ (O_et : P₀.Etale),
      ConnectedSpace ↥O_et.left →
      ConnectedSpace ↥(B_j.obj O_et).left →
      CategoryTheory.IsIso (u_sh.hom.app (Opposite.op O_et)) := by
    intro O_et hC1 hC2
    have : ConnectedSpace ↥O_et.left := hC1
    have : ConnectedSpace ↥(B_j.obj O_et).left := hC2
    have : CategoryTheory.IsIso (η_P.app (Opposite.op O_et)) :=
      h_unit_iso_conn P₀ A_m O_et
    have : CategoryTheory.IsIso (u_pre.app (Opposite.op O_et)) :=
      h_unit_iso_conn Y' A_m (B_j.obj O_et)
    have hfac_O : η_P.app (Opposite.op O_et) ≫ u_sh.hom.app (Opposite.op O_et) =
        u_pre.app (Opposite.op O_et) :=
      congrArg (fun τ => τ.app (Opposite.op O_et)) hu_fac
    exact CategoryTheory.IsIso.of_isIso_fac_left hfac_O

  have hMono_ush : CategoryTheory.Mono u_sh := by
    have hMono_hom : CategoryTheory.Mono u_sh.hom := by
      rw [CategoryTheory.NatTrans.mono_iff_mono_app]
      intro W_op
      obtain ⟨E⟩ := W_op
      rw [AddCommGrpCat.mono_iff_injective, injective_iff_map_eq_zero]
      intro s hs
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      have hSheaf_ℤ : CategoryTheory.Presieve.IsSheaf P₀.smallEtaleTopology
          ((C_P.obj A_m).obj.comp (CategoryTheory.coyoneda.obj (Opposite.op Aℤ))) :=
        (C_P.obj A_m).property Aℤ
      let homOfSec : ↥((C_P.obj A_m).obj.obj (Opposite.op E)) →
          (Aℤ ⟶ (C_P.obj A_m).obj.obj (Opposite.op E)) :=
        fun z => AddCommGrpCat.ofHom
          { toFun := fun n => n.down • z
            map_zero' := zero_zsmul z
            map_add' := fun a b => add_zsmul z a.down b.down }
      let R_E : CategoryTheory.Sieve E :=
        { arrows := fun {_} g => ((C_P.obj A_m).obj.map g.op).hom s = 0
          downward_closed := fun {_ _} g hg h => by
            change ((C_P.obj A_m).obj.map (g.op ≫ h.op)).hom s = 0
            rw [(C_P.obj A_m).obj.map_comp]
            change ((C_P.obj A_m).obj.map h.op).hom (((C_P.obj A_m).obj.map g.op).hom s) = 0
            rw [hg, map_zero] }
      have hRE_mem : R_E ∈ P₀.smallEtaleTopology E := by
        refine (h_mem_etale P₀ E R_E).mpr (fun x => ?_)
        obtain ⟨O_et, f_O, y, hEt_fO, hy, hC1, hC2⟩ := h_basis E x
        have hIso_O : CategoryTheory.IsIso (u_sh.hom.app (Opposite.op O_et)) :=
          hu_iso_on_conn O_et hC1 hC2
        have hInj_O : Function.Injective ⇑(u_sh.hom.app (Opposite.op O_et)).hom :=
          ((CategoryTheory.ConcreteCategory.isIso_iff_bijective
            (u_sh.hom.app (Opposite.op O_et))).mp hIso_O).1
        refine ⟨O_et, f_O, y, ?_, hEt_fO, hy⟩
        apply hInj_O
        rw [map_zero]
        have hnat := congrArg (fun φ => φ.hom s) (u_sh.hom.naturality f_O.op)
        change (u_sh.hom.app (Opposite.op O_et)).hom
            (((C_P.obj A_m).obj.map f_O.op).hom s) =
          ((pf_j.obj (C_Y.obj A_m)).obj.map f_O.op).hom
            ((u_sh.hom.app (Opposite.op E)).hom s) at hnat
        rw [hnat, hs, map_zero]
      have hSep := (hSheaf_ℤ R_E hRE_mem).isSeparatedFor
      have heq_hom : homOfSec s = (0 : Aℤ ⟶ (C_P.obj A_m).obj.obj (Opposite.op E)) := by
        refine hSep.ext (fun V g hg => ?_)
        apply AddCommGrpCat.ext
        intro ⟨n⟩
        change ((C_P.obj A_m).obj.map g.op).hom (n • s) =
          ((C_P.obj A_m).obj.map g.op).hom 0
        rw [map_zero, map_zsmul, hg, zsmul_zero]
      have h1 := CategoryTheory.ConcreteCategory.congr_hom heq_hom (ULift.up (1 : ℤ))
      simpa [homOfSec] using h1
    exact (CategoryTheory.sheafToPresheaf P₀.smallEtaleTopology AddCommGrpCat.{u}).mono_of_mono_map
      hMono_hom

  have hEpi_ush : CategoryTheory.Epi u_sh := by
    refine (CategoryTheory.Sheaf.isLocallySurjective_iff_epi'
      (A := AddCommGrpCat.{u}) u_sh).mp ?_
    rw [← CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
    refine CategoryTheory.Presheaf.IsLocallySurjective.mk ?_
    intro E t
    refine (h_mem_etale P₀ E (CategoryTheory.Presheaf.imageSieve u_sh.hom t)).mpr ?_
    intro x
    obtain ⟨O_et, f_O, y, hEt_fO, hy, hC1, hC2⟩ := h_basis E x
    have hIso_O : CategoryTheory.IsIso (u_sh.hom.app (Opposite.op O_et)) :=
      hu_iso_on_conn O_et hC1 hC2
    refine ⟨O_et, f_O, y, ?_, hEt_fO, hy⟩
    refine ⟨(CategoryTheory.inv (u_sh.hom.app (Opposite.op O_et))).hom
        (((pf_j.obj (C_Y.obj A_m)).obj.map f_O.op).hom t), ?_⟩
    change (CategoryTheory.inv (u_sh.hom.app (Opposite.op O_et)) ≫
        u_sh.hom.app (Opposite.op O_et)).hom
        (((pf_j.obj (C_Y.obj A_m)).obj.map f_O.op).hom t) =
      ((pf_j.obj (C_Y.obj A_m)).obj.map f_O.op).hom t
    rw [CategoryTheory.IsIso.inv_hom_id]
    rfl

  have : CategoryTheory.IsIso u_sh := CategoryTheory.isIso_of_mono_of_epi u_sh
  obtain ⟨e_hdi0⟩ := h_hdi0 (weilEtaleTorsionSheaf Y' m)
  exact ⟨CategoryTheory.asIso u_sh ≪≫ e_hdi0.symm⟩

theorem weil_leray_sec_mod_prime_injective_higherDirectImage_isZero (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {X B : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ B)
    (I : CategoryTheory.Sheaf X.smallEtaleTopology
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
    [CategoryTheory.Injective I] (p : ℕ) (hp : 1 ≤ p) :
    CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage f p
        ((CategoryTheory.Sheaf.composeAndSheafify X.smallEtaleTopology
          (CategoryTheory.forget₂
            (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
            AddCommGrpCat.{u})).obj I)) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  let _ : NeZero ℓ := ⟨hℓ_ne⟩
  rcases p with _ | n
  · omega
  let J_X := X.smallEtaleTopology
  let R_ℓ := ULift.{u, 0} (ZMod ℓ)
  let Fgt := CategoryTheory.forget₂ (ModuleCat.{u, u} R_ℓ) AddCommGrpCat.{u}
  let U_I := (CategoryTheory.Sheaf.composeAndSheafify J_X Fgt).obj I
  let φ_ring : ℤ →+* R_ℓ := Int.castRingHom R_ℓ

  let e_Z := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
  let adj_ext := ModuleCat.extendRestrictScalarsAdj.{u} φ_ring
  let iso_fgt :
      (ModuleCat.restrictScalars φ_ring).comp
        (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}) ≅ Fgt :=
    CategoryTheory.NatIso.ofComponents
      (fun M =>
        { hom := AddCommGrpCat.ofHom (RestrictScalars.addEquiv ℤ R_ℓ M).toAddMonoidHom
          inv := AddCommGrpCat.ofHom (RestrictScalars.addEquiv ℤ R_ℓ M).symm.toAddMonoidHom
          hom_inv_id := rfl
          inv_hom_id := rfl })
      (fun _ => rfl)
  let L_0 := e_Z.symm.functor.comp (ModuleCat.extendScalars φ_ring)
  let adj_fgt : L_0 ⊣ Fgt :=
    (e_Z.symm.toAdjunction.comp adj_ext).ofNatIsoRight iso_fgt

  have hSheaf_Fgt : ∀ (K : CategoryTheory.Sheaf J_X (ModuleCat.{u, u} R_ℓ)),
      CategoryTheory.Presheaf.IsSheaf J_X (K.obj.comp Fgt) := by
    intro K E
    let iso_coy :
        (K.obj.comp (CategoryTheory.coyoneda.obj (Opposite.op (L_0.obj E)))) ≅
          ((K.obj.comp Fgt).comp (CategoryTheory.coyoneda.obj (Opposite.op E))) :=
      CategoryTheory.NatIso.ofComponents
        (fun W => (adj_fgt.homEquiv E (K.obj.obj W)).toIso)
        (fun {W₁ W₂} u => by
          apply CategoryTheory.ConcreteCategory.hom_ext
          intro g
          exact adj_fgt.homEquiv_naturality_right g (K.obj.map u))
    exact CategoryTheory.Presieve.isSheaf_iso J_X iso_coy (K.property (L_0.obj E))

  let G₀ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := ⟨I.obj.comp Fgt, hSheaf_Fgt I⟩
  let e_UI : G₀ ≅ U_I := CategoryTheory.sheafificationIso G₀

  have h_nsmul_app : ∀ {F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (m : ℕ)
      (W : (X.Etale)ᵒᵖ) (x : ↑(F.obj.obj W)),
      ((m • CategoryTheory.CategoryStruct.id F).hom.app W).hom x = m • x := by
    intro F m W x
    induction m with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul]
      change (((m • CategoryTheory.CategoryStruct.id F).hom.app W).hom +
          ((CategoryTheory.CategoryStruct.id F).hom.app W).hom) x = _
      rw [AddMonoidHom.add_apply, ih]
      rfl

  have hℓ_cast_R : ((ℓ : ℕ) : R_ℓ) = 0 :=
    ULift.ext _ _ (CharP.cast_eq_zero (ZMod ℓ) ℓ)

  have hG₀_tor : ℓ • CategoryTheory.CategoryStruct.id G₀ = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W
    apply AddCommGrpCat.ext
    intro (x : ↑(I.obj.obj W))
    rw [h_nsmul_app]
    change ℓ • x = (0 : ↑(I.obj.obj W))
    rw [← Nat.cast_smul_eq_nsmul R_ℓ ℓ x, hℓ_cast_R, zero_smul]

  let J : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Injective.under G₀
  let ι : G₀ ⟶ J := CategoryTheory.Injective.ι G₀
  let m_J : J ⟶ J := ℓ • CategoryTheory.CategoryStruct.id J
  let H : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := CategoryTheory.Limits.kernel m_J
  let κ : H ⟶ J := CategoryTheory.Limits.kernel.ι m_J

  have hι_mJ : ι ≫ m_J = 0 := by
    dsimp [m_J]
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp ι, ← CategoryTheory.Preadditive.nsmul_comp,
      hG₀_tor, CategoryTheory.Limits.zero_comp]

  let α₀ : G₀ ⟶ H := CategoryTheory.Limits.kernel.lift m_J ι hι_mJ
  have hα₀_mono : CategoryTheory.Mono α₀ := by
    have hfac : α₀ ≫ κ = ι := CategoryTheory.Limits.kernel.lift_ι m_J ι hι_mJ
    have _ : CategoryTheory.Mono (α₀ ≫ κ) := by
      rw [hfac]
      infer_instance
    exact CategoryTheory.mono_of_mono α₀ κ

  have hH_tor : ℓ • CategoryTheory.CategoryStruct.id H = 0 := by
    apply (cancel_mono κ).mp
    rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Preadditive.nsmul_comp,
      CategoryTheory.Category.id_comp, ← CategoryTheory.Category.comp_id κ,
      ← CategoryTheory.Preadditive.comp_nsmul]
    exact CategoryTheory.Limits.kernel.condition m_J

  have hH_el_tor : ∀ (W : (X.Etale)ᵒᵖ) (x : ↑(H.obj.obj W)), ℓ • x = 0 := by
    intro W x
    rw [← h_nsmul_app ℓ W x, hH_tor]
    rfl

  have hH_mod_nsmul : ∀ (W : (X.Etale)ᵒᵖ) (m : ℕ) (x : ↑(H.obj.obj W)),
      m • x = (m % ℓ) • x := by
    intro W m x
    conv_lhs => rw [← Nat.div_add_mod m ℓ]
    rw [add_nsmul, mul_nsmul', hH_el_tor W ((m / ℓ) • x), zero_add]

  let instMod : ∀ (W : (X.Etale)ᵒᵖ), Module R_ℓ ↑(H.obj.obj W) := fun W =>
    { smul := fun r x => r.down.val • x
      one_smul := fun x => by
        change (1 : ZMod ℓ).val • x = x
        rw [ZMod.val_one_eq_one_mod ℓ, ← hH_mod_nsmul W 1 x, one_nsmul]
      mul_smul := fun r s x => by
        change (r.down * s.down).val • x = r.down.val • (s.down.val • x)
        rw [ZMod.val_mul, ← hH_mod_nsmul W (r.down.val * s.down.val) x, mul_nsmul']
      smul_zero := fun r => nsmul_zero _
      smul_add := fun r x y => nsmul_add x y r.down.val
      add_smul := fun r s x => by
        change (r.down + s.down).val • x = r.down.val • x + s.down.val • x
        rw [ZMod.val_add, ← hH_mod_nsmul W (r.down.val + s.down.val) x, add_nsmul]
      zero_smul := fun x => by
        change (0 : ZMod ℓ).val • x = 0
        rw [ZMod.val_zero, zero_nsmul] }

  have hR_val_cast : ∀ (r : R_ℓ), ((r.down.val : ℕ) : R_ℓ) = r :=
    fun r => ULift.ext _ _ (ZMod.natCast_zmod_val r.down)

  let liftLin : ∀ {M₁ M₂ : Type u} [AddCommGroup M₁] [Module R_ℓ M₁]
      [AddCommGroup M₂] [Module R_ℓ M₂] (g : M₁ →+ M₂), M₁ →ₗ[R_ℓ] M₂ :=
    fun g =>
      { toAddHom := g.toAddHom
        map_smul' := fun r x => by
          dsimp
          rw [← hR_val_cast r, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, map_nsmul] }

  let P_H : CategoryTheory.Functor (X.Etale)ᵒᵖ (ModuleCat.{u, u} R_ℓ) :=
    { obj := fun W => @ModuleCat.of R_ℓ _ ↑(H.obj.obj W) _ (instMod W)
      map := fun {W₁ W₂} u =>
        letI : Module R_ℓ ↑(H.obj.obj W₁) := instMod W₁
        letI : Module R_ℓ ↑(H.obj.obj W₂) := instMod W₂
        ModuleCat.ofHom (liftLin (H.obj.map u).hom)
      map_id := fun W => by
        let _ : Module R_ℓ ↑(H.obj.obj W) := instMod W
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        change ((H.obj.map (𝟙 W)).hom) x = x
        rw [H.obj.map_id]
        rfl
      map_comp := fun {W₁ W₂ W₃} u v => by
        let _ : Module R_ℓ ↑(H.obj.obj W₁) := instMod W₁
        let _ : Module R_ℓ ↑(H.obj.obj W₂) := instMod W₂
        let _ : Module R_ℓ ↑(H.obj.obj W₃) := instMod W₃
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro x
        change ((H.obj.map (u ≫ v)).hom) x = ((H.obj.map v).hom) (((H.obj.map u).hom) x)
        rw [H.obj.map_comp]
        rfl }

  have hPH_sheaf : CategoryTheory.Presheaf.IsSheaf J_X P_H :=
    CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J_X P_H Fgt H.property

  let H_mod : CategoryTheory.Sheaf J_X (ModuleCat.{u, u} R_ℓ) := ⟨P_H, hPH_sheaf⟩

  let α_mod : I ⟶ H_mod :=
    { hom :=
        { app := fun W =>
            letI : Module R_ℓ ↑(H.obj.obj W) := instMod W
            ModuleCat.ofHom (liftLin (α₀.hom.app W).hom)
          naturality := fun {W₁ W₂} u => by
            let _ : Module R_ℓ ↑(H.obj.obj W₁) := instMod W₁
            let _ : Module R_ℓ ↑(H.obj.obj W₂) := instMod W₂
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro x
            have hnat := α₀.hom.naturality u
            exact ConcreteCategory.congr_hom hnat x } }

  have hα_mod_mono : CategoryTheory.Mono α_mod := by
    refine ⟨fun {K} g₁ g₂ hg => ?_⟩
    let K_ab : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := ⟨K.obj.comp Fgt, hSheaf_Fgt K⟩
    let g₁_ab : K_ab ⟶ G₀ := ⟨CategoryTheory.Functor.whiskerRight g₁.hom Fgt⟩
    let g₂_ab : K_ab ⟶ G₀ := ⟨CategoryTheory.Functor.whiskerRight g₂.hom Fgt⟩
    have hg_ab : g₁_ab ≫ α₀ = g₂_ab ≫ α₀ := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W
      apply AddCommGrpCat.ext
      intro x
      have hW : (g₁ ≫ α_mod).hom.app W = (g₂ ≫ α_mod).hom.app W := by rw [hg]
      exact ConcreteCategory.congr_hom hW x
    have heq_ab : g₁_ab = g₂_ab := (cancel_mono α₀).mp hg_ab
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    have hW_ab : g₁_ab.hom.app W = g₂_ab.hom.app W := by rw [heq_ab]
    exact ConcreteCategory.congr_hom hW_ab x

  let _ : CategoryTheory.Mono α_mod := hα_mod_mono
  let ρ_mod : H_mod ⟶ I :=
    CategoryTheory.Injective.factorThru (CategoryTheory.CategoryStruct.id I) α_mod
  have hαρ_mod : α_mod ≫ ρ_mod = CategoryTheory.CategoryStruct.id I :=
    CategoryTheory.Injective.comp_factorThru (CategoryTheory.CategoryStruct.id I) α_mod

  let ρ₀ : H ⟶ G₀ := ⟨CategoryTheory.Functor.whiskerRight ρ_mod.hom Fgt⟩
  have hαρ₀ : α₀ ≫ ρ₀ = CategoryTheory.CategoryStruct.id G₀ := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W
    apply AddCommGrpCat.ext
    intro x
    have hW : (α_mod ≫ ρ_mod).hom.app W = (CategoryTheory.CategoryStruct.id I).hom.app W := by
      rw [hαρ_mod]
    exact ConcreteCategory.congr_hom hW x

  let α : U_I ⟶ H := e_UI.inv ≫ α₀
  let ρ : H ⟶ U_I := ρ₀ ≫ e_UI.hom
  have hαρ : α ≫ ρ = CategoryTheory.CategoryStruct.id U_I := by
    dsimp [α, ρ]
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc α₀ ρ₀ e_UI.hom,
      hαρ₀, CategoryTheory.Category.id_comp, e_UI.inv_hom_id]

  
  let sh := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let P_free : X.Etale → CategoryTheory.Functor (X.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    fun V => (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
  let Z_free : X.Etale → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
    fun V => sh.obj (P_free V)

  have h_nsmul_pre : ∀ {P : CategoryTheory.Functor (X.Etale)ᵒᵖ AddCommGrpCat.{u}}
      (m : ℕ) (T : (X.Etale)ᵒᵖ) (z : ↑(P.obj T)),
      ((m • CategoryTheory.CategoryStruct.id P).app T).hom z = m • z := by
    intro P m T z
    induction m with
    | zero =>
      rw [zero_nsmul, zero_nsmul]
      rfl
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul]
      change (((m • CategoryTheory.CategoryStruct.id P).app T).hom +
          ((CategoryTheory.CategoryStruct.id P).app T).hom) z = _
      rw [AddMonoidHom.add_apply, ih]
      rfl

  have hMono_Z : ∀ (V : X.Etale),
      CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (Z_free V)) := by
    intro V
    have hMono_app : ∀ (T : (X.Etale)ᵒᵖ),
        CategoryTheory.Mono ((ℓ • CategoryTheory.CategoryStruct.id (P_free V)).app T) := by
      intro T
      rw [AddCommGrpCat.mono_iff_injective]
      intro (a : FreeAbelianGroup (T.unop ⟶ V)) (b : FreeAbelianGroup (T.unop ⟶ V)) hab
      have hab' : ℓ • a = ℓ • b := by
        have ha := h_nsmul_pre (P := P_free V) ℓ T a
        have hb := h_nsmul_pre (P := P_free V) ℓ T b
        exact ha.symm.trans (hab.trans hb)
      let e_fs := FreeAbelianGroup.equivFinsupp (T.unop ⟶ V)
      have hfs : ℓ • e_fs a = ℓ • e_fs b := by
        calc
          ℓ • e_fs a = e_fs (ℓ • a) := (map_nsmul e_fs ℓ a).symm
          _ = e_fs (ℓ • b) := congrArg e_fs hab'
          _ = ℓ • e_fs b := map_nsmul e_fs ℓ b
      exact e_fs.injective (nsmul_right_injective hℓ_ne hfs)
    have hMono_pre : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (P_free V)) :=
      CategoryTheory.NatTrans.mono_of_mono_app _
    have h_sh_map : sh.map (ℓ • CategoryTheory.CategoryStruct.id (P_free V)) =
        ℓ • CategoryTheory.CategoryStruct.id (Z_free V) := by
      rw [CategoryTheory.Functor.map_nsmul, sh.map_id]
    rw [← h_sh_map]
    exact sh.map_mono _

  have hDiv : ∀ (V : X.Etale) (g : Z_free V ⟶ J), ∃ (h : Z_free V ⟶ J), h ≫ m_J = g := by
    intro V g
    let _ : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id (Z_free V)) := hMono_Z V
    let h : Z_free V ⟶ J :=
      CategoryTheory.Injective.factorThru g (ℓ • CategoryTheory.CategoryStruct.id (Z_free V))
    refine ⟨h, ?_⟩
    dsimp [m_J]
    rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp h, ← CategoryTheory.Preadditive.nsmul_comp]
    exact CategoryTheory.Injective.comp_factorThru g
      (ℓ • CategoryTheory.CategoryStruct.id (Z_free V))

  let adj_tot :=
    (CategoryTheory.Adjunction.whiskerRight (X.Etale)ᵒᵖ AddCommGrpCat.adj).comp
      (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u})

  have hSurj_sec : ∀ (W : (X.Etale)ᵒᵖ) (s : ↑(J.obj.obj W)),
      ∃ (t : ↑(J.obj.obj W)), (m_J.hom.app W).hom t = s := by
    intro W s
    let e_sec : (Z_free W.unop ⟶ J) ≃ ↑(J.obj.obj W) :=
      (adj_tot.homEquiv (CategoryTheory.yoneda.obj W.unop) J).trans CategoryTheory.yonedaEquiv
    obtain ⟨h, hh⟩ := hDiv W.unop (e_sec.symm s)
    refine ⟨e_sec h, ?_⟩
    have h1 : e_sec (h ≫ m_J) = s := by
      rw [hh, Equiv.apply_symm_apply]
    have h2 : e_sec (h ≫ m_J) = (m_J.hom.app W).hom (e_sec h) := by
      dsimp [e_sec]
      rw [adj_tot.homEquiv_naturality_right]
      exact CategoryTheory.yonedaEquiv_comp _ _
    exact h2.symm.trans h1

  have hEpi_mJ : CategoryTheory.Epi m_J := by
    refine ⟨fun {F} φ₁ φ₂ hφ => ?_⟩
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext W
    apply AddCommGrpCat.ext
    intro s
    obtain ⟨t, rfl⟩ := hSurj_sec W s
    have hW : (m_J ≫ φ₁).hom.app W = (m_J ≫ φ₂).hom.app W := by rw [hφ]
    exact ConcreteCategory.congr_hom hW t

  let SC := CategoryTheory.ShortComplex.mk κ m_J (CategoryTheory.Limits.kernel.condition m_J)
  have hSC_exact : SC.Exact := by
    rw [CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift]
    have hlift_eq : CategoryTheory.Limits.kernel.lift SC.g SC.f SC.zero =
        CategoryTheory.CategoryStruct.id H := by
      apply (cancel_mono κ).mp
      rw [CategoryTheory.Limits.kernel.lift_ι, CategoryTheory.Category.id_comp]
    rw [hlift_eq]
    infer_instance

  have hSE : SC.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' hSC_exact inferInstance hEpi_mJ

  
  have hExt_H_zero : ∀ (V : X.Etale) (x : CategoryTheory.Abelian.Ext (Z_free V) H (n + 1)),
      x = 0 := by
    intro V x
    have hx_f : x.comp (CategoryTheory.Abelian.Ext.mk₀ SC.f) (Nat.add_zero (n + 1)) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, rfl⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Z_free V) hSE x hx_f
        (rfl : n + 1 = n + 1)
    rcases n with _ | k
    · let g : Z_free V ⟶ J := CategoryTheory.Abelian.Ext.homEquiv₀ x₃
      have hg_eq : CategoryTheory.Abelian.Ext.mk₀ g = x₃ := by
        rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
      obtain ⟨h, hh⟩ := hDiv V g
      rw [← hg_eq, ← hh]
      change (CategoryTheory.Abelian.Ext.mk₀ (h ≫ SC.g)).comp hSE.extClass (Nat.zero_add 1) = 0
      rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc h SC.g hSE.extClass,
        hSE.comp_extClass]
      exact CategoryTheory.Abelian.Ext.comp_zero (CategoryTheory.Abelian.Ext.mk₀ h) H 1 1
        (Nat.zero_add 1)
    · have hx₃ : x₃ = 0 := CategoryTheory.Abelian.Ext.eq_zero_of_injective x₃
      rw [hx₃]
      exact CategoryTheory.Abelian.Ext.zero_comp (Z_free V) (k + 1) hSE.extClass (k + 1 + 1) rfl

  have hZero_H_pre : CategoryTheory.Limits.IsZero (H.cohomologyPresheaf (n + 1)) := by
    apply CategoryTheory.Functor.isZero
    intro W
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply AddCommGrpCat.ext
    intro (x : CategoryTheory.Abelian.Ext (Z_free W.unop) H (n + 1))
    exact hExt_H_zero W.unop x

  have hZero_UI_pre : CategoryTheory.Limits.IsZero (U_I.cohomologyPresheaf (n + 1)) := by
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    let CF := CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X (n + 1)
    have hCF_id : CategoryTheory.CategoryStruct.id (U_I.cohomologyPresheaf (n + 1)) =
        CF.map α ≫ CategoryTheory.CategoryStruct.id (H.cohomologyPresheaf (n + 1)) ≫ CF.map ρ := by
      change CategoryTheory.CategoryStruct.id (CF.obj U_I) = _
      rw [← CF.map_id U_I, CategoryTheory.Category.id_comp, ← CF.map_comp, hαρ]
    rw [hCF_id, hZero_H_pre.eq_of_src (CategoryTheory.CategoryStruct.id _) 0,
      CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  dsimp [weilEtaleHigherDirectImage]
  apply (CategoryTheory.presheafToSheaf B.smallEtaleTopology AddCommGrpCat.{u}).map_isZero
  apply CategoryTheory.Functor.isZero
  intro W
  exact (CategoryTheory.Functor.isZero_iff _).mp hZero_UI_pre _

theorem weil_leray_sec_retracted_closed_complement_support_and_acyclic (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hModInjAcyc : ∀ {X B : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ B)
        (I : CategoryTheory.Sheaf X.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))))
        [CategoryTheory.Injective I] (p : ℕ),
      1 ≤ p →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage f p
          ((CategoryTheory.Sheaf.composeAndSheafify X.smallEtaleTopology
            (CategoryTheory.forget₂
              (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
              AddCommGrpCat.{u})).obj I)))
    (P S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType P.hom]
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    [AlgebraicGeometry.IsAffine S.left]
    (π : P ⟶ S) [AlgebraicGeometry.IsProper π.left]
    (i₀ : S.left ⟶ P.left) [AlgebraicGeometry.IsClosedImmersion i₀]
    (hi₀_sec : i₀ ≫ π.left = 𝟙 S.left)
    (Y' : AlgebraicGeometry.Scheme.{u}) (j : Y' ⟶ P.left)
    [AlgebraicGeometry.IsOpenImmersion j]
    (hDisj : Disjoint (Set.range i₀.base) (Set.range j.base))
    (hCompl : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (x_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P.left),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        x_bar.base pt ∉ Set.range j.base) →
      x_bar = (x_bar ≫ π.left) ≫ i₀)
