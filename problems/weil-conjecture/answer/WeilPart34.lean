      rw [hreb₁ (π_ov (h_C.comp g_CA)) (π_ov g_CA)
        (CategoryTheory.CategoryStruct.comp (π_ov (h_C.comp g_CA)) π_A)
        (CategoryTheory.CategoryStruct.comp (π_ov g_CA) π_A)
        rfl rfl u_W_CA hu_W_π (by rw [← CategoryTheory.Category.assoc, hu_W_π]) ξ 0]
