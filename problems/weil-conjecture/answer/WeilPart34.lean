    (hBdryCard : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        z_bar.base pt ∉ Set.range j_U.base) →
      ∀ (H_z : CategoryTheory.Sheaf
          (AlgebraicGeometry.Spec (CommRingCat.of Ω)).smallEtaleTopology AddCommGrpCat.{u}),
        WeilIsEtaleSheafPullback z_bar
          (weilEtaleHigherDirectImage j_U 1 (weilEtaleTorsionSheaf U ℓ)) H_z →
        Finite (H_z.H 0) ∧ Nat.card (H_z.H 0) ≤ ℓ)
    (hBdryNeZero : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y),
      (∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)),
        z_bar.base pt ∉ Set.range j_U.base) →
      ∀ (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V]
        (v : V ⟶ Y) [AlgebraicGeometry.Etale v]
        (z_tilde : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V),
        z_tilde ≫ v = z_bar →
        ∀ (p_V : weilEtaleTorsionH U ℓ 1 →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback j_U v) ℓ 1),
          WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.fst j_U v) ℓ 1 p_V →
          p_V ξ₀ ≠ 0) :
    ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
      (w : W ⟶ Y) [AlgebraicGeometry.Etale w]
      (ξ : weilEtaleTorsionH (CategoryTheory.Limits.pullback j_U w) ℓ 1),
      ∃ (I : Type u) (V' : I → AlgebraicGeometry.Scheme.{u})
        (_ : ∀ a, AlgebraicGeometry.IsAffine (V' a))
        (g : ∀ a, V' a ⟶ W) (_ : ∀ a, AlgebraicGeometry.Etale (g a))
        (c : I → ℕ),
        (⋃ a, Set.range (g a).base) = Set.univ ∧
