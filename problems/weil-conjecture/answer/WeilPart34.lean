          (AlgebraicGeometry.Spec.map (α_Btloc.app β₁))
          (AlgebraicGeometry.Spec.map (e_Btloc_lvl β₁).hom) hm_mor_eq G_E₁ b
        have hzero_β₁_step : weilSliceColimTrianglePullHom (@hc_all) (@hr_all) hSite
            (AlgebraicGeometry.Spec.map (α_Btloc.app β₁))
            (CategoryTheory.CategoryStruct.id _)
            (AlgebraicGeometry.Spec.map (α_Btloc.app β₁))
            (CategoryTheory.Category.comp_id _) G_E₁ b ζ₁_E₁ = 0 :=
