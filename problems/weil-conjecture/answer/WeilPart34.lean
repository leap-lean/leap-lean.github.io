        obtain ⟨Q, hQ_ge, hQ_prime, hQ_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (l.last).asIdeal (q'.last).asIdeal hq'_le
        let Q_pt : PrimeSpectrum R₁ := ⟨Q, hQ_prime⟩
