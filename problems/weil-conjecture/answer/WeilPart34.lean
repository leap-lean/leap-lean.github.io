        g.appTop ≫ Y.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op).hom
      rw [← map_natCast ρ, hR_p, map_zero]
    have hΦ_Z_eq : Φ_Z = schFrob Z (hOverZ_p (𝟙 Z)) :=
      (hSchFrob_Spec R₀ hR_p φ_R hφ_R (hOverZ_p (𝟙 Z))).symm
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) Φ_Z :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) Φ_Z :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp' hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp' hg)
    let B_Φ : CategoryTheory.Functor Z.Etale Z.Etale := weilEtaleSitePullback Φ_Z
    let d_mor : ∀ U : Z.Etale, Quiver.Hom U.left (B_Φ.obj U).left :=
      fun U =>
        CategoryTheory.Limits.pullback.lift
          (schFrob U.left (hOverZ_p U.hom))
          U.hom
          (by
            rw [hΦ_Z_eq]
            exact hSchFrob_nat (hOverZ_p U.hom) (hOverZ_p (𝟙 Z)) U.hom)
    have hd_isIso : ∀ U : Z.Etale, CategoryTheory.IsIso (d_mor U) := by
      intro U
      let X : AlgebraicGeometry.Scheme.{u} := U.left
      let g : Quiver.Hom X Z := U.hom
      have hg_et : AlgebraicGeometry.Etale g := U.prop
      let fst : Quiver.Hom (B_Φ.obj U).left X := CategoryTheory.Limits.pullback.fst g Φ_Z
      let snd : Quiver.Hom (B_Φ.obj U).left Z := CategoryTheory.Limits.pullback.snd g Φ_Z
      have hd_fst : d_mor U ≫ fst = schFrob X (hOverZ_p g) :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hd_snd : d_mor U ≫ snd = g :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      let W_cov : X.affineOpens → (B_Φ.obj U).left.Opens :=
        fun V => (TopologicalSpace.Opens.map fst.base).obj V.1
      have hW_sup : iSup W_cov = ⊤ := by
        rw [eq_top_iff]
        intro y _
        have hy_top : fst.base y ∈ (⊤ : X.Opens) := trivial
        rw [← AlgebraicGeometry.iSup_affineOpens_eq_top X,
          TopologicalSpace.Opens.mem_iSup] at hy_top
        rcases hy_top with ⟨V, hVy⟩
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨V, hVy⟩
      change CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme.{u} (d_mor U)
      refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top W_cov hW_sup (fun V => ?_)
      change CategoryTheory.IsIso (d_mor U ∣_ W_cov V)
      let V_pre : X.Opens := (TopologicalSpace.Opens.map (d_mor U).base).obj (W_cov V)
      have h_pre : V_pre = V.1 := by
        ext x
        change fst.base ((d_mor U).base x) ∈ V.1 ↔ x ∈ V.1
        have h_pt : fst.base ((d_mor U).base x) = (d_mor U ≫ fst).base x := rfl
        rw [h_pt, hd_fst, hSchFrob_base X (hOverZ_p g)]
        rfl
      let e_pre : V_pre.toScheme ≅ V.1.toScheme := X.isoOfEq h_pre
      let m_V : Quiver.Hom V.1.toScheme (W_cov V).toScheme :=
        e_pre.inv ≫ (d_mor U ∣_ W_cov V)
      have hm_V_ι : m_V ≫ (W_cov V).ι = V.1.ι ≫ d_mor U := by
        dsimp [m_V, e_pre]
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
          ← CategoryTheory.Category.assoc]
        have h_inv_ι : (X.isoOfEq h_pre).inv ≫ V_pre.ι = V.1.ι := by
          rw [← AlgebraicGeometry.Scheme.isoOfEq_hom_ι X h_pre,
            ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.id_comp]
        rw [h_inv_ι]
      have hPb_top : CategoryTheory.IsPullback (fst ∣_ V.1) (W_cov V).ι V.1.ι fst :=
        AlgebraicGeometry.isPullback_morphismRestrict fst V.1
      have hPb_bot : CategoryTheory.IsPullback fst snd g Φ_Z :=
        CategoryTheory.IsPullback.of_hasPullback g Φ_Z
      have hPb_W : CategoryTheory.IsPullback (fst ∣_ V.1) ((W_cov V).ι ≫ snd) (V.1.ι ≫ g) Φ_Z :=
        hPb_top.paste_vert hPb_bot
      let A_V : Type u := ↑(X.presheaf.obj (Opposite.op V.1))
      have hAV_p : ((p : ℕ) : A_V) = 0 := hOverZ_p g V.1
      let φ_AV : A_V →+* A_V := powRingHom hAV_p
      let e_V : V.1.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of A_V) := V.2.isoSpec
      let f_V_mor : Quiver.Hom (CommRingCat.of R₀) (CommRingCat.of A_V) :=
        AlgebraicGeometry.Spec.preimage (e_V.inv ≫ V.1.ι ≫ g)
      let f_V : R₀ →+* A_V := f_V_mor.hom
      have hSpec_fV : AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_V) =
          e_V.inv ≫ V.1.ι ≫ g := by
        have h1 : CommRingCat.ofHom f_V = f_V_mor := CommRingCat.ofHom_hom f_V_mor
        rw [h1]
        exact AlgebraicGeometry.Spec.map_preimage _
      have hfV_et : f_V.Etale := by
        have hSpec_et : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_V)) := by
          rw [hSpec_fV]
          haveI : AlgebraicGeometry.Etale g := hg_et
          infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.Etale)).mp hSpec_et
      let P_BV : CommRingCat.{u} :=
        CategoryTheory.Limits.pushout (CommRingCat.ofHom f_V) (CommRingCat.ofHom φ_R)
      let B_V : Type u := ↑P_BV
      let inl_V : A_V →+* B_V :=
        (CategoryTheory.Limits.pushout.inl (CommRingCat.ofHom f_V) (CommRingCat.ofHom φ_R)).hom
      let inr_V : R₀ →+* B_V :=
        (CategoryTheory.Limits.pushout.inr (CommRingCat.ofHom f_V) (CommRingCat.ofHom φ_R)).hom
      have hp_V : CategoryTheory.IsPushout
          (CommRingCat.ofHom f_V) (CommRingCat.ofHom φ_R)
          (CommRingCat.ofHom inl_V) (CommRingCat.ofHom inr_V) := by
        have hp₀ := CategoryTheory.IsPushout.of_hasPushout
          (CommRingCat.ofHom f_V) (CommRingCat.ofHom φ_R)
        simpa only [inl_V, inr_V, CommRingCat.ofHom_hom] using hp₀
      have h_fV_frob : CategoryTheory.CategoryStruct.comp
          (CommRingCat.ofHom f_V) (CommRingCat.ofHom φ_AV) =
          CategoryTheory.CategoryStruct.comp
            (CommRingCat.ofHom φ_R) (CommRingCat.ofHom f_V) := by
        apply CommRingCat.hom_ext
        ext r
        dsimp [φ_AV, powRingHom]
        rw [hφ_R r, map_pow]
      let μ_V_mor := hp_V.desc (CommRingCat.ofHom φ_AV) (CommRingCat.ofHom f_V) h_fV_frob
      let μ_V : B_V →+* A_V := μ_V_mor.hom
      have hμ_inl : μ_V.comp inl_V = φ_AV :=
        congrArg CommRingCat.Hom.hom (hp_V.inl_desc _ _ h_fV_frob)
      have hμ_inr : μ_V.comp inr_V = f_V :=
        congrArg CommRingCat.Hom.hom (hp_V.inr_desc _ _ h_fV_frob)
      have hBij_μ : Function.Bijective μ_V :=
        hS3 p hp R₀ A_V B_V hR_p f_V hfV_et φ_R hφ_R φ_AV (fun _ => rfl)
          inl_V inr_V hp_V μ_V hμ_inl hμ_inr
      have hIso_μ_spec : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_V)) :=
        (AlgebraicGeometry.isIso_SpecMap_iff (f := CommRingCat.ofHom μ_V)).mpr hBij_μ
      have hPb_BV : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inl_V))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr_V))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f_V))
          Φ_Z :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hp_V
      let to_W : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_V)) (W_cov V).toScheme :=
        hPb_W.lift
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inl_V) ≫ e_V.inv)
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom inr_V))
          (by
            rw [CategoryTheory.Category.assoc, ← hSpec_fV]
            exact hPb_BV.w)
      let from_W : Quiver.Hom (W_cov V).toScheme (AlgebraicGeometry.Spec (CommRingCat.of B_V)) :=
        hPb_BV.lift
          ((fst ∣_ V.1) ≫ e_V.hom)
          ((W_cov V).ι ≫ snd)
          (by
            rw [CategoryTheory.Category.assoc, hSpec_fV, ← CategoryTheory.Category.assoc e_V.hom,
              e_V.hom_inv_id, CategoryTheory.Category.id_comp]
            exact hPb_W.w)
      let e_W : AlgebraicGeometry.Spec (CommRingCat.of B_V) ≅ (W_cov V).toScheme :=
        { hom := to_W
          inv := from_W
          hom_inv_id := by
            apply hPb_BV.hom_ext
            · dsimp [to_W, from_W]
              rw [CategoryTheory.Category.assoc, hPb_BV.lift_fst,
                ← CategoryTheory.Category.assoc, hPb_W.lift_fst,
                CategoryTheory.Category.assoc, e_V.inv_hom_id,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            · dsimp [to_W, from_W]
              rw [CategoryTheory.Category.assoc, hPb_BV.lift_snd, hPb_W.lift_snd,
                CategoryTheory.Category.id_comp]
          inv_hom_id := by
            apply hPb_W.hom_ext
            · dsimp [to_W, from_W]
              rw [CategoryTheory.Category.assoc, hPb_W.lift_fst,
                ← CategoryTheory.Category.assoc, hPb_BV.lift_fst,
                CategoryTheory.Category.assoc, e_V.hom_inv_id,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            · dsimp [to_W, from_W]
              rw [CategoryTheory.Category.assoc, hPb_W.lift_snd, hPb_BV.lift_snd,
                CategoryTheory.Category.id_comp] }
      have hm_V_eq : m_V =
          e_V.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_V) ≫ e_W.hom := by
        apply hPb_W.hom_ext
        · have h_lhs : m_V ≫ (fst ∣_ V.1) = schFrob V.1.toScheme (hOverZ_p (V.1.ι ≫ g)) := by
            apply (cancel_mono V.1.ι).mp
            rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
              ← CategoryTheory.Category.assoc, hm_V_ι, CategoryTheory.Category.assoc, hd_fst]
            exact (hSchFrob_nat (hOverZ_p (V.1.ι ≫ g)) (hOverZ_p g) V.1.ι).symm
          rw [h_lhs]
          dsimp [e_W, to_W]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hPb_W.lift_fst,
            ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom μ_V)),
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hμ_inl]
          have hSpec_AV := hSchFrob_Spec A_V hAV_p φ_AV (fun _ => rfl)
            (hOverZ_p (e_V.inv ≫ V.1.ι ≫ g))
          rw [← hSpec_AV]
          have hnat_eV := hSchFrob_nat (hOverZ_p (V.1.ι ≫ g))
            (hOverZ_p (e_V.inv ≫ V.1.ι ≫ g)) e_V.hom
          rw [← CategoryTheory.Category.assoc e_V.hom, ← hnat_eV,
            CategoryTheory.Category.assoc, e_V.hom_inv_id, CategoryTheory.Category.comp_id]
        · have h_lhs : m_V ≫ ((W_cov V).ι ≫ snd) = V.1.ι ≫ g := by
            rw [← CategoryTheory.Category.assoc, hm_V_ι, CategoryTheory.Category.assoc, hd_snd]
          rw [h_lhs]
          dsimp [e_W, to_W]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hPb_W.lift_snd,
            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hμ_inr, hSpec_fV,
            ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id, CategoryTheory.Category.id_comp]
      have hIso_mV : CategoryTheory.IsIso m_V := by
        rw [hm_V_eq]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ e_V.hom _
          (CategoryTheory.Iso.isIso_hom e_V)
          (@CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ e_W.hom hIso_μ_spec
            (CategoryTheory.Iso.isIso_hom e_W))
      have hd_res_eq : d_mor U ∣_ W_cov V = e_pre.hom ≫ m_V := by
        dsimp [m_V]
        rw [← CategoryTheory.Category.assoc, e_pre.hom_inv_id, CategoryTheory.Category.id_comp]
      rw [hd_res_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ e_pre.hom m_V
        (CategoryTheory.Iso.isIso_hom e_pre) hIso_mV
    refine ⟨CategoryTheory.NatIso.ofComponents
      (fun U => by
        haveI : CategoryTheory.IsIso (d_mor U) := hd_isIso U
        exact CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.asIso (d_mor U))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      (fun {U₁ U₂} w => by
        let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
        let w_left : Quiver.Hom U₁.left U₂.left := (Fgt.map w).left
        have hw_comm : w_left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w w
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · change w_left ≫ d_mor U₂ = d_mor U₁ ≫ (Fgt.map (B_Φ.map w)).left
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hmap_fst :
                (Fgt.map (B_Φ.map w)).left ≫ CategoryTheory.Limits.pullback.fst U₂.hom Φ_Z =
                CategoryTheory.Limits.pullback.fst U₁.hom Φ_Z ≫ w_left :=
              CategoryTheory.Limits.pullback.lift_fst _ _ _
            exact (CategoryTheory.Category.assoc w_left (d_mor U₂) _).trans
              ((congrArg (w_left ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((hSchFrob_nat (hOverZ_p U₁.hom) (hOverZ_p U₂.hom) w_left).symm.trans
              ((congrArg (· ≫ w_left) (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
              ((CategoryTheory.Category.assoc (d_mor U₁) _ w_left).trans
              ((congrArg (d_mor U₁ ≫ ·) hmap_fst.symm).trans
              (CategoryTheory.Category.assoc _ _ _).symm)))))
          · have hmap_snd :
                (Fgt.map (B_Φ.map w)).left ≫ CategoryTheory.Limits.pullback.snd U₂.hom Φ_Z =
                CategoryTheory.Limits.pullback.snd U₁.hom Φ_Z := by
              have hs := CategoryTheory.Limits.pullback.lift_snd
                (CategoryTheory.Limits.pullback.fst U₁.hom Φ_Z ≫ w_left)
                (CategoryTheory.Limits.pullback.snd U₁.hom Φ_Z ≫ 𝟙 Z)
                (by
                  rw [CategoryTheory.Category.assoc, hw_comm,
                    CategoryTheory.Category.assoc, CategoryTheory.Category.id_comp]
                  exact CategoryTheory.Limits.pullback.condition)
              exact hs.trans (CategoryTheory.Category.comp_id _)
            exact (CategoryTheory.Category.assoc w_left (d_mor U₂) _).trans
              ((congrArg (w_left ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              (hw_comm.trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).symm.trans
              ((congrArg (d_mor U₁ ≫ ·) hmap_snd.symm).trans
              (CategoryTheory.Category.assoc _ _ _).symm))))
        · exact Subsingleton.elim _ _)⟩

  
  have hMapExtBij : ∀ {𝒞 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞]
      [CategoryTheory.HasExt.{u} 𝒞]
      [CategoryTheory.EnoughInjectives 𝒞]
      (G : 𝒞 ⥤ 𝒞)
      [G.Additive]
      [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (_ : 𝟭 𝒞 ≅ G)
      (X : 𝒞) (n : ℕ) (Y : 𝒞),
      Function.Bijective (G.mapExtAddHom X Y n) := by
    intro 𝒞 _ _ _ _ G _ _ _ e X n
    induction n with
    | zero =>
      intro Y
      have hmk_XY := CategoryTheory.Abelian.Ext.mk₀_bijective (C := 𝒞) X Y
      have hmk_G := CategoryTheory.Abelian.Ext.mk₀_bijective (C := 𝒞) (G.obj X) (G.obj Y)
      have hG_map_bij : Function.Bijective (fun f : X ⟶ Y => G.map f) := by
        refine ⟨fun f₁ f₂ hf => ?_, fun g => ?_⟩
        · have hnat₁ := e.hom.naturality f₁
          have hnat₂ := e.hom.naturality f₂
          dsimp at hnat₁ hnat₂
          have heq : f₁ ≫ e.hom.app Y = f₂ ≫ e.hom.app Y :=
            hnat₁.trans ((congrArg (e.hom.app X ≫ ·) hf).trans hnat₂.symm)
          exact (cancel_mono (e.hom.app Y)).mp heq
        · refine ⟨e.hom.app X ≫ g ≫ e.inv.app Y, ?_⟩
          apply (cancel_epi (e.hom.app X)).mp
          have hnat := e.hom.naturality (e.hom.app X ≫ g ≫ e.inv.app Y)
          dsimp at hnat
          rw [← hnat, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
            e.inv_hom_id_app, CategoryTheory.Category.comp_id]
      refine ⟨fun z₁ z₂ hz => ?_, fun z' => ?_⟩
      · obtain ⟨f₁, rfl⟩ := hmk_XY.2 z₁
        obtain ⟨f₂, rfl⟩ := hmk_XY.2 z₂
        change CategoryTheory.Abelian.Ext.mapExactFunctor G
          (CategoryTheory.Abelian.Ext.mk₀.{u} f₁) =
          CategoryTheory.Abelian.Ext.mapExactFunctor G
            (CategoryTheory.Abelian.Ext.mk₀.{u} f₂) at hz
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀] at hz
        exact congrArg CategoryTheory.Abelian.Ext.mk₀.{u} (hG_map_bij.1 (hmk_G.1 hz))
      · obtain ⟨g, rfl⟩ := hmk_G.2 z'
        obtain ⟨f, rfl⟩ := hG_map_bij.2 g
        refine ⟨CategoryTheory.Abelian.Ext.mk₀.{u} f, ?_⟩
        change CategoryTheory.Abelian.Ext.mapExactFunctor G
          (CategoryTheory.Abelian.Ext.mk₀.{u} f) = _
        exact CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ G f
    | succ n ih =>
      intro Y
      let I : 𝒞 := CategoryTheory.Injective.under Y
      let ι : Y ⟶ I := CategoryTheory.Injective.ι Y
      let Q : 𝒞 := CategoryTheory.Limits.cokernel ι
      let π_cok : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι
      let S : CategoryTheory.ShortComplex 𝒞 :=
        CategoryTheory.ShortComplex.mk ι π_cok (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_of_g_is_cokernel S
            (CategoryTheory.Limits.cokernelIsCokernel ι) }
      have hGS : (S.map G).ShortExact := hS.map_of_exact G
      haveI : CategoryTheory.Injective (G.obj I) :=
        CategoryTheory.Injective.of_iso (e.app I) inferInstance
      haveI : CategoryTheory.Injective (S.map G).X₂ := ‹CategoryTheory.Injective (G.obj I)›
      cases n with
      | zero =>
        refine ⟨fun z₁ z₂ hz => ?_, fun z' => ?_⟩
        · suffices h0 : ∀ z : CategoryTheory.Abelian.Ext.{u} X Y 1,
              G.mapExtAddHom X Y 1 z = 0 → z = 0 by
            have hsub : G.mapExtAddHom X Y 1 (z₁ - z₂) = 0 := by
              rw [map_sub, hz, sub_self]
            exact sub_eq_zero.mp (h0 (z₁ - z₂) hsub)
          intro z hz0
          have hz_ι : z.comp (CategoryTheory.Abelian.Ext.mk₀.{u} S.f) (Nat.add_zero 1) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y, rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS z hz_ι (Nat.zero_add 1)
          have hGy_ext : (G.mapExtAddHom X Q 0 y).comp hGS.extClass (Nat.zero_add 1) = 0 := by
            have hmap := CategoryTheory.Abelian.Ext.mapExactFunctor_comp G y hS.extClass
              (Nat.zero_add 1)
            rw [CategoryTheory.Abelian.Ext.mapExactFunctor_extClass G hS] at hmap
            exact hmap.symm.trans hz0
          obtain ⟨w', hw'⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ (G.obj X) hGS
              (G.mapExtAddHom X Q 0 y) (Nat.zero_add 1) hGy_ext
          obtain ⟨w, rfl⟩ := (ih I).2 w'
          have hwy : w.comp (CategoryTheory.Abelian.Ext.mk₀.{u} S.g) (Nat.add_zero 0) = y := by
            apply (ih Q).1
            change CategoryTheory.Abelian.Ext.mapExactFunctor G _ = _
            rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
            exact hw'
          rw [← hwy, CategoryTheory.Abelian.Ext.comp_assoc w
            (CategoryTheory.Abelian.Ext.mk₀.{u} S.g) hS.extClass
            (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
            hS.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
        · have hz'_ι : z'.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (S.map G).f)
              (Nat.add_zero 1) = 0 := by
            change z'.comp (CategoryTheory.Abelian.Ext.mk₀.{u} (G.map ι)) (Nat.add_zero 1) = 0
            exact CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y', rfl⟩ :=
            CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (G.obj X) hGS z' hz'_ι
              (Nat.zero_add 1)
          obtain ⟨y, rfl⟩ := (ih Q).2 y'
