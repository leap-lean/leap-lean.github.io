        have hf : fL = fR := by
          apply LinearMap.restrictScalars_injective R
          refine TensorProduct.ext' fun r' s₂ => h_on_tmul r' s₂
        exact fun v => LinearMap.congr_fun hf v
      let inl_R' : ∀ l₁ l₂ : I, S' l₁ →ₗ[R'] TensorProduct R' (S' l₁) (S' l₂) :=
        fun l₁ l₂ => (Algebra.TensorProduct.includeLeft : S' l₁ →ₐ[R'] _).toLinearMap
