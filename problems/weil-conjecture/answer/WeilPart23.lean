    have hle_U'W' : U' ≤ W' := fun _ hz => hle_UW hz
    let res_A : A_W →+* A_U := (C_bar.left.presheaf.map (CategoryTheory.homOfLE hle_UW).op).hom
    let res_B : B_W →+* B_U := (C'_bar.left.presheaf.map (CategoryTheory.homOfLE hle_U'W').op).hom
    let φ_U : A_U →+* B_U := (bar_p.left.app U).hom
    have hNat_AU : ∀ a : A_W, φ_U (res_A a) = res_B ((bar_p.left.app W).hom a) := by
      intro a
      have hnat := AlgebraicGeometry.Scheme.Hom.naturality bar_p.left
        (CategoryTheory.homOfLE hle_UW).op
      exact congrArg (fun f : A_W_cat ⟶ B_U_cat => f.hom a) hnat
    let _ : Algebra A_W A_U := res_A.toAlgebra
    have : IsLocalization.Away g A_U := hW.isLocalization_basicOpen g
    let _ : Algebra B_W B_U := res_B.toAlgebra
    have : IsLocalization.Away g' B_U :=
      hW'.isLocalization_of_eq_basicOpen g' (CategoryTheory.homOfLE hle_U'W') hU'_eq
    have hg_ne : g ≠ 0 := fun h0 => hg_not_mem (h0 ▸ (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.zero_mem)
    have hg'_ne : g' ≠ 0 := fun h0 => hg_ne (hInj_φW (h0.trans (map_zero _).symm))
    have hinj_resB : Function.Injective res_B :=
      IsLocalization.injective B_U
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hg'_ne))
    let M_U : Type u := Fin ℓ → A_U
    let e₀ : M_U →+ B_U :=
      { toFun := fun m => ∑ i : Fin ℓ, φ_U (m i) * res_B (v i)
        map_zero' := by
          change ∑ i : Fin ℓ, φ_U (0 : A_U) * res_B (v i) = 0
          simp only [map_zero, zero_mul, Finset.sum_const_zero]
        map_add' := fun m₁ m₂ => by
          change ∑ i : Fin ℓ, φ_U (m₁ i + m₂ i) * res_B (v i) =
            (∑ i : Fin ℓ, φ_U (m₁ i) * res_B (v i)) + ∑ i : Fin ℓ, φ_U (m₂ i) * res_B (v i)
          simp only [map_add, add_mul, Finset.sum_add_distrib] }
    have he₀_bij : Function.Bijective e₀ := by
      refine ⟨?_, ?_⟩
      · intro m₁ m₂ hm_eq
        have hm0 : e₀ (m₁ - m₂) = 0 := by rw [map_sub, hm_eq, sub_self]
        suffices hdiff : m₁ - m₂ = 0 by exact sub_eq_zero.mp hdiff
        set m := m₁ - m₂
        let N : ℕ := Finset.univ.sup (fun i : Fin ℓ => (IsLocalization.Away.sec g (m i)).2)
        let c : Fin ℓ → A_W := fun i =>
          g ^ (N - (IsLocalization.Away.sec g (m i)).2) * (IsLocalization.Away.sec g (m i)).1
        have hclear : ∀ i : Fin ℓ, res_A (g ^ N) * m i = res_A (c i) := by
          intro i
          let k_i : ℕ := (IsLocalization.Away.sec g (m i)).2
          let q_i : ℕ := N - k_i
          have hle_i : k_i ≤ N :=
            Finset.le_sup (f := fun j : Fin ℓ => (IsLocalization.Away.sec g (m j)).2)
