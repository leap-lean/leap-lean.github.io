        have hval_L : (e_L_idx.symm j).val = j.val := rfl
        have hgen_L : pb_L.gen = AdjoinRoot.root P_f := AdjoinRoot.powerBasis_gen hIrred.ne_zero
        rw [hj, PowerBasis.basis_eq_pow, hval_L, hgen_L, Algebra.smul_def,
