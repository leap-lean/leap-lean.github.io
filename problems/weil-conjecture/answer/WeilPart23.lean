      rwa [hhom]

    let ε_loc : ∀ b : Fin (m + 1), (D₀ b).toScheme ⟶ P_tilde.left :=
      fun b => s_chart b ≫ (eΨ b).hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι
    have hε_loc_p₂ : ∀ b : Fin (m + 1), ε_loc b ≫ p₂.left = (D₀ b).ι := by
      intro b
      calc ε_loc b ≫ p₂.left
          = s_chart b ≫ (eΨ b).hom ≫ ((p₂.left ⁻¹ᵁ D₀ b).ι ≫ p₂.left) := by
              dsimp [ε_loc]; simp only [CategoryTheory.Category.assoc]
        _ = s_chart b ≫ ((eΨ b).hom ≫ (p₂.left ∣_ D₀ b)) ≫ (D₀ b).ι := by
              rw [← AlgebraicGeometry.morphismRestrict_ι p₂.left (D₀ b)]
              simp only [CategoryTheory.Category.assoc]
        _ = (s_chart b ≫ CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) ≫
              (D₀ b).ι := by
              rw [heΨ_p₂ b, CategoryTheory.Category.assoc]
        _ = (D₀ b).ι := by
              rw [hs_chart_sec b, CategoryTheory.Category.id_comp]
    have hε_loc_p₁ : ∀ b : Fin (m + 1), ε_loc b ≫ p₁.left = (D₀ b).ι ≫ B₀.hom ≫ p₀_pt :=
      hs_chart_p₁

    let covB₀ : B₀.left.OpenCover := B₀.left.openCoverOfIsOpenCover D₀ hCovD₀
    have hε_glue : ∀ (b₁ b₂ : covB₀.I₀),
        CategoryTheory.Limits.pullback.fst (covB₀.f b₁) (covB₀.f b₂) ≫ ε_loc b₁ =
          CategoryTheory.Limits.pullback.snd (covB₀.f b₁) (covB₀.f b₂) ≫ ε_loc b₂ := by
      intro (b₁ : Fin (m + 1)) (b₂ : Fin (m + 1))
      change CategoryTheory.Limits.pullback.fst (D₀ b₁).ι (D₀ b₂).ι ≫ ε_loc b₁ =
        CategoryTheory.Limits.pullback.snd (D₀ b₁).ι (D₀ b₂).ι ≫ ε_loc b₂
      have hcond : CategoryTheory.Limits.pullback.fst (D₀ b₁).ι (D₀ b₂).ι ≫ (D₀ b₁).ι =
          CategoryTheory.Limits.pullback.snd (D₀ b₁).ι (D₀ b₂).ι ≫ (D₀ b₂).ι :=
        CategoryTheory.Limits.pullback.condition
      rw [← CategoryTheory.cancel_mono ι_inc]
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (CategoryTheory.Limits.pullback.fst (D₀ b₁).ι (D₀ b₂).ι ≫ ε_loc b₁) ≫ p₁.left =
          (CategoryTheory.Limits.pullback.snd (D₀ b₁).ι (D₀ b₂).ι ≫ ε_loc b₂) ≫ p₁.left
        rw [CategoryTheory.Category.assoc, hε_loc_p₁ b₁,
          CategoryTheory.Category.assoc, hε_loc_p₁ b₂,
          ← CategoryTheory.Category.assoc _ (D₀ b₁).ι, hcond, CategoryTheory.Category.assoc]
      · change (CategoryTheory.Limits.pullback.fst (D₀ b₁).ι (D₀ b₂).ι ≫ ε_loc b₁) ≫ p₂.left =
          (CategoryTheory.Limits.pullback.snd (D₀ b₁).ι (D₀ b₂).ι ≫ ε_loc b₂) ≫ p₂.left
        rw [CategoryTheory.Category.assoc, hε_loc_p₂ b₁,
          CategoryTheory.Category.assoc, hε_loc_p₂ b₂, hcond]
    let ε_left : B₀.left ⟶ P_tilde.left := covB₀.glueMorphisms ε_loc hε_glue
    have hε_chart : ∀ b : Fin (m + 1), (D₀ b).ι ≫ ε_left = ε_loc b :=
      fun b => covB₀.ι_glueMorphisms ε_loc hε_glue b
    have hε_p₂_left : ε_left ≫ p₂.left = 𝟙 B₀.left := by
      apply covB₀.hom_ext
      intro (b : Fin (m + 1))
      change (D₀ b).ι ≫ ε_left ≫ p₂.left = (D₀ b).ι ≫ 𝟙 B₀.left
      rw [← CategoryTheory.Category.assoc, hε_chart b, hε_loc_p₂ b, CategoryTheory.Category.comp_id]
    have hε_p₁_left : ε_left ≫ p₁.left = B₀.hom ≫ p₀_pt := by
      apply covB₀.hom_ext
      intro (b : Fin (m + 1))
      change (D₀ b).ι ≫ ε_left ≫ p₁.left = (D₀ b).ι ≫ B₀.hom ≫ p₀_pt
      rw [← CategoryTheory.Category.assoc, hε_chart b, hε_loc_p₁ b]
    have hε_w : ε_left ≫ P_tilde.hom = B₀.hom := by
      change ε_left ≫ p₁.left ≫ P_amb.hom = B₀.hom
      rw [← CategoryTheory.Category.assoc, hε_p₁_left, CategoryTheory.Category.assoc,
        hp₀_hom, CategoryTheory.Category.comp_id]
    let ε_p₀ : B₀ ⟶ P_tilde := CategoryTheory.Over.homMk ε_left hε_w
    have hSec_ε : ε_p₀ ≫ p₂ = 𝟙 B₀ := by
      ext1
      exact hε_p₂_left

    let U_tilde : P_tilde.left.Opens := p₁.left ⁻¹ᵁ U_proj
    have hRange_le_compl : Set.range ε_p₀.left.base ⊆ ((U_tilde : Set ↥P_tilde.left)ᶜ) := by
      rintro _ ⟨b₀, rfl⟩
      change p₁.left.base (ε_left.base b₀) ∉ U_proj
      have heq_pt : p₁.left.base (ε_left.base b₀) = p₀_pt.base (B₀.hom.base b₀) := by
        change (ε_left ≫ p₁.left).base b₀ = (B₀.hom ≫ p₀_pt).base b₀
        rw [hε_p₁_left]
      rw [heq_pt]
      exact hp₀_range ⟨B₀.hom.base b₀, rfl⟩

    have hCompl_exc : ((U_tilde : Set ↥P_tilde.left)ᶜ) = Set.range ε_p₀.left.base := by
      refine Set.Subset.antisymm ?_ hRange_le_compl
      intro z hz
      have hb_iSup : p₂.left.base z ∈ ⨆ b : Fin (m + 1), D₀ b := by
        rw [hCovD₀]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hb_iSup
      obtain ⟨b, hb⟩ := hb_iSup
      let z₀ : ↥(p₂.left ⁻¹ᵁ D₀ b).toScheme := ⟨z, hb⟩
      obtain ⟨R_b, hRing_Rb, hAlg_Rb,
          (e_base : (D₀ b).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of R_b)),
          (e_top : (pr_p₀ ⁻¹ᵁ D₀ b).toScheme ≅
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_b))),
          (he_base : e_base.inv ≫ (D₀ b).ι ≫ B₀.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_b))),
          (he_top : e_top.inv ≫ (pr_p₀ ∣_ D₀ b) ≫ e_base.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))⟩ :=
        hLinPolyCharts pr_p₀ hPr b
      let _ : CommRing R_b := hRing_Rb
      let _ : Algebra k R_b := hAlg_Rb
      let g_Rb : AlgebraicGeometry.Spec (CommRingCat.of R_b) ⟶ S_k :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_b))
      have he_base_hom : e_base.hom ≫ g_Rb = (D₀ b).ι ≫ B₀.hom := by
        change e_base.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_b)) = _
        rw [← he_base, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
          CategoryTheory.Category.id_comp]
      let E'_b := CategoryTheory.Limits.pullback g_Rb P₁.hom
      let e_Eb_hom : CategoryTheory.Limits.pullback ((D₀ b).ι ≫ B₀.hom) P₁.hom ⟶ E'_b :=
        CategoryTheory.Limits.pullback.map ((D₀ b).ι ≫ B₀.hom) P₁.hom g_Rb P₁.hom
          e_base.hom (𝟙 P₁.left) (𝟙 S_k)
          (by rw [he_base_hom, CategoryTheory.Category.comp_id])
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      let e_Eb_inv : E'_b ⟶ CategoryTheory.Limits.pullback ((D₀ b).ι ≫ B₀.hom) P₁.hom :=
        CategoryTheory.Limits.pullback.map g_Rb P₁.hom ((D₀ b).ι ≫ B₀.hom) P₁.hom
          e_base.inv (𝟙 P₁.left) (𝟙 S_k)
          (by rw [he_base, CategoryTheory.Category.comp_id])
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      have he_Eb_1 : e_Eb_hom ≫ e_Eb_inv = 𝟙 _ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [e_Eb_hom, e_Eb_inv]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · calc (e_Eb_hom ≫ e_Eb_inv) ≫ CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom
              = e_Eb_hom ≫
                  (e_Eb_inv ≫ CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom) :=
                CategoryTheory.Category.assoc _ _ _
            _ = e_Eb_hom ≫ (CategoryTheory.Limits.pullback.snd g_Rb P₁.hom ≫ 𝟙 P₁.left) := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = (e_Eb_hom ≫ CategoryTheory.Limits.pullback.snd g_Rb P₁.hom) ≫ 𝟙 P₁.left :=
                (CategoryTheory.Category.assoc _ _ _).symm
            _ = (CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom ≫ 𝟙 P₁.left) ≫
                  𝟙 P₁.left := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = 𝟙 _ ≫ CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom := by
                rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id,
                  CategoryTheory.Category.id_comp]
      have he_Eb_2 : e_Eb_inv ≫ e_Eb_hom = 𝟙 _ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [e_Eb_hom, e_Eb_inv]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        · calc (e_Eb_inv ≫ e_Eb_hom) ≫ CategoryTheory.Limits.pullback.snd g_Rb P₁.hom
              = e_Eb_inv ≫ (e_Eb_hom ≫ CategoryTheory.Limits.pullback.snd g_Rb P₁.hom) :=
                CategoryTheory.Category.assoc _ _ _
            _ = e_Eb_inv ≫
                  (CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom ≫ 𝟙 P₁.left) := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = (e_Eb_inv ≫ CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom) ≫
                  𝟙 P₁.left :=
                (CategoryTheory.Category.assoc _ _ _).symm
            _ = (CategoryTheory.Limits.pullback.snd g_Rb P₁.hom ≫ 𝟙 P₁.left) ≫ 𝟙 P₁.left := by
                rw [CategoryTheory.Limits.pullback.lift_snd]
            _ = 𝟙 _ ≫ CategoryTheory.Limits.pullback.snd g_Rb P₁.hom := by
                rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id,
                  CategoryTheory.Category.id_comp]
      let e_Eb : CategoryTheory.Limits.pullback ((D₀ b).ι ≫ B₀.hom) P₁.hom ≅ E'_b :=
        ⟨e_Eb_hom, e_Eb_inv, he_Eb_1, he_Eb_2⟩
      let ψ_b : E'_b ≅ (p₂.left ⁻¹ᵁ D₀ b).toScheme := e_Eb.symm ≪≫ eΨ b
      have hψ_p₂ : ψ_b.hom ≫ (p₂.left ∣_ D₀ b) =
          CategoryTheory.Limits.pullback.fst g_Rb P₁.hom ≫ e_base.inv := by
        change (e_Eb_inv ≫ (eΨ b).hom) ≫ (p₂.left ∣_ D₀ b) = _
        rw [CategoryTheory.Category.assoc, heΨ_p₂ b]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      let s'_b : AlgebraicGeometry.Spec (CommRingCat.of R_b) ⟶ E'_b :=
        e_base.inv ≫ s_chart b ≫ e_Eb.hom
      have hs'_sec : s'_b ≫ CategoryTheory.Limits.pullback.fst g_Rb P₁.hom =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R_b)) := by
        dsimp [s'_b, e_Eb, e_Eb_hom]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.assoc (s_chart b),
          hs_chart_sec b, CategoryTheory.Category.id_comp, CategoryTheory.Iso.inv_hom_id]
      have hs'_ψ : s'_b ≫ ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι =
          e_base.inv ≫ (D₀ b).ι ≫ ε_left := by
        calc s'_b ≫ ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι
            = e_base.inv ≫ s_chart b ≫ (e_Eb_hom ≫ e_Eb_inv) ≫
                (eΨ b).hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι := by
              dsimp [s'_b, ψ_b, e_Eb]; simp only [CategoryTheory.Category.assoc]
          _ = e_base.inv ≫ ε_loc b := by
              rw [he_Eb_1, CategoryTheory.Category.id_comp]
          _ = e_base.inv ≫ (D₀ b).ι ≫ ε_left := by rw [hε_chart b]
      let W'_b : E'_b.Opens := (ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι) ⁻¹ᵁ U_tilde
      have hs'_disj : Set.range s'_b.base ⊆ ((W'_b : Set ↥E'_b)ᶜ) := by
        rintro _ ⟨x_R, rfl⟩
        change (s'_b ≫ ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι).base x_R ∉ U_tilde
        rw [hs'_ψ]
        exact hRange_le_compl ⟨(e_base.inv ≫ (D₀ b).ι).base x_R, rfl⟩

      let inv_p₁ : (U_proj : AlgebraicGeometry.Scheme.{u}) ⟶ U_tilde.toScheme :=
        @CategoryTheory.inv _ _ _ _ (p₁.left ∣_ U_proj) hIso_p₁'
      have h_hom_inv_p₁ : (p₁.left ∣_ U_proj) ≫ inv_p₁ = 𝟙 U_tilde.toScheme :=
        @CategoryTheory.IsIso.hom_inv_id _ _ _ _ (p₁.left ∣_ U_proj) hIso_p₁'
      have h_inv_p₁_comp : inv_p₁ ≫ U_tilde.ι ≫ p₂.left = pr_p₀ := hComp_pr'
      have hUtilde_p₂ : U_tilde.ι ≫ p₂.left = (p₁.left ∣_ U_proj) ≫ pr_p₀ := by
        rw [← h_inv_p₁_comp, ← CategoryTheory.Category.assoc, h_hom_inv_p₁,
          CategoryTheory.Category.id_comp]
      let α₁ : W'_b.toScheme ⟶ P_tilde.left := W'_b.ι ≫ ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι
      let α₂ : (pr_p₀ ⁻¹ᵁ D₀ b).toScheme ⟶ P_tilde.left :=
        (pr_p₀ ⁻¹ᵁ D₀ b).ι ≫ inv_p₁ ≫ U_tilde.ι
      have : AlgebraicGeometry.IsOpenImmersion α₁ := by dsimp [α₁]; infer_instance
      have : AlgebraicGeometry.IsOpenImmersion α₂ := by
        have : CategoryTheory.IsIso (p₁.left ∣_ U_proj) := hIso_p₁'
        have : CategoryTheory.IsIso inv_p₁ := by dsimp [inv_p₁]; infer_instance
        dsimp [α₂]; infer_instance
      have hRange_α : Set.range α₁.base = Set.range α₂.base := by
        ext y
        constructor
        · rintro ⟨w, rfl⟩
          have hy_U : α₁.base w ∈ U_tilde := w.2
          have hy_D : α₁.base w ∈ p₂.left ⁻¹ᵁ D₀ b := by
            change α₁.base w ∈ ((p₂.left ⁻¹ᵁ D₀ b : P_tilde.left.Opens) : Set ↥P_tilde.left)
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι (p₂.left ⁻¹ᵁ D₀ b)]
            exact ⟨ψ_b.hom.base (W'_b.ι.base w), rfl⟩
          let u₁ : ↥U_tilde.toScheme := ⟨α₁.base w, hy_U⟩
          let v₀ : ↥(U_proj : AlgebraicGeometry.Scheme.{u}) := (p₁.left ∣_ U_proj).base u₁
          have hinv_v₀ : inv_p₁.base v₀ = u₁ := by
            change ((p₁.left ∣_ U_proj) ≫ inv_p₁).base u₁ = u₁
            rw [h_hom_inv_p₁]
            rfl
          have hv₀_D : v₀ ∈ pr_p₀ ⁻¹ᵁ D₀ b := by
            change ((p₁.left ∣_ U_proj) ≫ pr_p₀).base u₁ ∈ D₀ b
            rw [← hUtilde_p₂]
            exact hy_D
          refine ⟨⟨v₀, hv₀_D⟩, ?_⟩
          change U_tilde.ι.base (inv_p₁.base v₀) = α₁.base w
          rw [hinv_v₀]
          rfl
        · rintro ⟨v, rfl⟩
          have hy_U : α₂.base v ∈ U_tilde := by
            change α₂.base v ∈ (U_tilde : Set ↥P_tilde.left)
            rw [← AlgebraicGeometry.Scheme.Opens.range_ι U_tilde]
            exact ⟨inv_p₁.base ((pr_p₀ ⁻¹ᵁ D₀ b).ι.base v), rfl⟩
          have hy_D : α₂.base v ∈ p₂.left ⁻¹ᵁ D₀ b := by
            change ((pr_p₀ ⁻¹ᵁ D₀ b).ι ≫ inv_p₁ ≫ U_tilde.ι ≫ p₂.left).base v ∈ D₀ b
            rw [h_inv_p₁_comp]
            exact v.2
          let u₀ : ↥(p₂.left ⁻¹ᵁ D₀ b).toScheme := ⟨α₂.base v, hy_D⟩
          let w₀ : ↥E'_b := ψ_b.inv.base u₀
          have hψ_w₀ : (ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι).base w₀ = α₂.base v := by
            change (p₂.left ⁻¹ᵁ D₀ b).ι.base ((ψ_b.inv ≫ ψ_b.hom).base u₀) = α₂.base v
            rw [ψ_b.inv_hom_id]
            rfl
          have hw₀_W : w₀ ∈ W'_b := by
            change (ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι).base w₀ ∈ U_tilde
            rw [hψ_w₀]
            exact hy_U
          refine ⟨⟨w₀, hw₀_W⟩, ?_⟩
          exact hψ_w₀
      obtain ⟨e_α, _, he_α_inv⟩ := hIsoOfOpenRangeEq α₁ α₂ hRange_α
      let eW : W'_b.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_b)) :=
        e_α ≪≫ e_top
      have heW : eW.inv ≫ W'_b.ι ≫ CategoryTheory.Limits.pullback.fst g_Rb P₁.hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
        rw [← CategoryTheory.cancel_mono e_base.inv, ← CategoryTheory.cancel_mono (D₀ b).ι]
        calc ((eW.inv ≫ W'_b.ι ≫ CategoryTheory.Limits.pullback.fst g_Rb P₁.hom) ≫
                e_base.inv) ≫ (D₀ b).ι
            = e_top.inv ≫ e_α.inv ≫ W'_b.ι ≫
                (CategoryTheory.Limits.pullback.fst g_Rb P₁.hom ≫ e_base.inv) ≫ (D₀ b).ι := by
              dsimp [eW]; simp only [CategoryTheory.Category.assoc]
          _ = e_top.inv ≫ e_α.inv ≫ W'_b.ι ≫
                (ψ_b.hom ≫ (p₂.left ∣_ D₀ b)) ≫ (D₀ b).ι := by
              rw [← hψ_p₂]
          _ = e_top.inv ≫ (e_α.inv ≫ α₁) ≫ p₂.left := by
              dsimp [α₁]
              rw [CategoryTheory.Category.assoc (ψ_b.hom),
                AlgebraicGeometry.morphismRestrict_ι p₂.left (D₀ b)]
              simp only [CategoryTheory.Category.assoc]
          _ = e_top.inv ≫ α₂ ≫ p₂.left := by rw [he_α_inv]
          _ = e_top.inv ≫ (pr_p₀ ⁻¹ᵁ D₀ b).ι ≫ (inv_p₁ ≫ U_tilde.ι ≫ p₂.left) := by
              dsimp [α₂]; simp only [CategoryTheory.Category.assoc]
          _ = e_top.inv ≫ ((pr_p₀ ⁻¹ᵁ D₀ b).ι ≫ pr_p₀) := by rw [h_inv_p₁_comp]
          _ = e_top.inv ≫ (pr_p₀ ∣_ D₀ b) ≫ (D₀ b).ι := by
              rw [← AlgebraicGeometry.morphismRestrict_ι pr_p₀ (D₀ b)]
          _ = ((e_top.inv ≫ (pr_p₀ ∣_ D₀ b) ≫ e_base.hom) ≫ e_base.inv) ≫ (D₀ b).ι := by
              simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
          _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫ e_base.inv) ≫
                (D₀ b).ι := by
              rw [he_top]
      have hW_compl :=
        weil_projLine_pullback_open_polynomial_compl_eq_section_range
          k R_b W'_b s'_b hs'_sec hs'_disj eW heW
      let w_z : ↥E'_b := ψ_b.inv.base z₀
      have hψ_wz : (ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι).base w_z = z := by
        change (p₂.left ⁻¹ᵁ D₀ b).ι.base ((ψ_b.inv ≫ ψ_b.hom).base z₀) = z
        rw [ψ_b.inv_hom_id]
        rfl
      have hw_not_W : w_z ∈ ((W'_b : Set ↥E'_b)ᶜ) := by
        change (ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι).base w_z ∉ U_tilde
        rw [hψ_wz]
        exact hz
      rw [hW_compl] at hw_not_W
      obtain ⟨x_R, hx_R⟩ := hw_not_W
      refine ⟨(e_base.inv ≫ (D₀ b).ι).base x_R, ?_⟩
      change (e_base.inv ≫ (D₀ b).ι ≫ ε_left).base x_R = z
      rw [← hs'_ψ]
      change (ψ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι).base (s'_b.base x_R) = z
      rw [hx_R, hψ_wz]

    refine ⟨pr_p₀, P_tilde, p₁, p₂, ε_p₀, e_Dbase,
      hPr, hUproj, hIntPt, hProjPt, hProp_p₁, hProp_p₂, hSm_p₂,
      he_Dbase_hom, hCompl_exc, hIso_p₁', hComp_pr', hSec_ε, ?_, ?_⟩
    · intro g_pt hg_hom hg_range
      rw [hp₀_uniq g_pt hg_hom hg_range]
      exact hε_p₁_left.symm
    · intro K _ _ s
      let S_K := AlgebraicGeometry.Spec (CommRingCat.of K)
      have hNonempty_K : Nonempty ↥S_K :=
        (PrimeSpectrum.nonempty_iff_nontrivial (R := K)).mpr inferInstance
      let pt_K : ↥S_K := Classical.choice hNonempty_K
      have hSub_K : Subsingleton ↥S_K := by
        change Subsingleton (PrimeSpectrum K)
        infer_instance
      have hs_iSup : s.base pt_K ∈ ⨆ b : Fin (m + 1), D₀ b := by
        rw [hCovD₀]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hs_iSup
      obtain ⟨b, hb_s⟩ := hs_iSup
      have hs_range : Set.range s.base ⊆ Set.range (D₀ b).ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨q, rfl⟩
        rw [hSub_K.elim q pt_K]
        exact hb_s
      let s_D : S_K ⟶ (D₀ b).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (D₀ b).ι s hs_range
      have hs_D_fac : s_D ≫ (D₀ b).ι = s :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (D₀ b).ι s hs_range
      have hPb_res : CategoryTheory.IsPullback
          ((eΨ b).hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι)
          (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom)
          p₂.left (D₀ b).ι := by
        have hPb_top : CategoryTheory.IsPullback
            (eΨ b).hom ((eΨ b).hom ≫ (p₂.left ∣_ D₀ b))
            (p₂.left ∣_ D₀ b) (𝟙 (D₀ b).toScheme) :=
          CategoryTheory.IsPullback.of_horiz_isIso
            (CategoryTheory.CommSq.mk (CategoryTheory.Category.comp_id _).symm)
        have hPb_pasted := hPb_top.paste_horiz
          (AlgebraicGeometry.isPullback_morphismRestrict p₂.left (D₀ b)).flip
        rwa [CategoryTheory.Category.id_comp, heΨ_p₂ b] at hPb_pasted
      have hPb_fib1 : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) s_D ≫
            (eΨ b).hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι)
          (CategoryTheory.Limits.pullback.snd
            (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) s_D)
          p₂.left s := by
        rw [← hs_D_fac]
        exact (CategoryTheory.IsPullback.of_hasPullback
          (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) s_D).paste_horiz hPb_res
      have hPb_fib2 : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) s_D ≫
            CategoryTheory.Limits.pullback.snd ((D₀ b).ι ≫ B₀.hom) P₁.hom)
          (CategoryTheory.Limits.pullback.snd
            (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) s_D)
          P₁.hom (s ≫ B₀.hom) := by
        have hEq_s : s ≫ B₀.hom = s_D ≫ ((D₀ b).ι ≫ B₀.hom) := by
          rw [← CategoryTheory.Category.assoc, hs_D_fac]
        rw [hEq_s]
        exact (CategoryTheory.IsPullback.of_hasPullback
          (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) s_D).paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback ((D₀ b).ι ≫ B₀.hom) P₁.hom).flip
      let e_fib : CategoryTheory.Limits.pullback p₂.left s ≅
          CategoryTheory.Limits.pullback P₁.hom (s ≫ B₀.hom) :=
        hPb_fib1.isoPullback.symm ≪≫ hPb_fib2.isoPullback
      let h_homeo : ↥(CategoryTheory.Limits.pullback p₂.left s) ≃ₜ
          ↥(CategoryTheory.Limits.pullback P₁.hom (s ≫ B₀.hom)) :=
        TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e_fib)
      obtain ⟨hIrred_P₁K, hDim_P₁K⟩ := hP₁Fib K (s ≫ B₀.hom)
      have hIrred_fib : IrreducibleSpace ↥(CategoryTheory.Limits.pullback p₂.left s) := by
        have hUniv : (Set.univ : Set ↥(CategoryTheory.Limits.pullback p₂.left s)) =
            h_homeo.symm '' (Set.univ : Set ↥(CategoryTheory.Limits.pullback P₁.hom (s ≫ B₀.hom))) := by
          ext x
          exact ⟨fun _ => ⟨h_homeo x, trivial, h_homeo.symm_apply_apply x⟩, fun _ => trivial⟩
        have hPre : IsPreirreducible
            (Set.univ : Set ↥(CategoryTheory.Limits.pullback p₂.left s)) := by
          rw [hUniv]
          exact hIrred_P₁K.isIrreducible_univ.isPreirreducible.image
            h_homeo.symm h_homeo.symm.continuous.continuousOn
        exact @IrreducibleSpace.mk ↥(CategoryTheory.Limits.pullback p₂.left s) _ ⟨hPre⟩
          ⟨h_homeo.symm (Classical.choice hIrred_P₁K.toNonempty)⟩
      have hDim_fib : topologicalKrullDim ↥(CategoryTheory.Limits.pullback p₂.left s) =
          (1 : WithBot ℕ∞) :=
        (h_homeo.isHomeomorph.topologicalKrullDim_eq).trans hDim_P₁K
      let σ_s : S_K ⟶ CategoryTheory.Limits.pullback p₂.left s :=
        CategoryTheory.Limits.pullback.lift (s ≫ ε_left) (𝟙 S_K)
          (by rw [CategoryTheory.Category.assoc, hε_p₂_left, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp])
      refine ⟨hIrred_fib, hDim_fib, ⟨σ_s.base pt_K, ?_⟩⟩
      have hfst_z₀ : (CategoryTheory.Limits.pullback.fst p₂.left s).base (σ_s.base pt_K) =
          ε_left.base (s.base pt_K) := by
        change (σ_s ≫ CategoryTheory.Limits.pullback.fst p₂.left s).base pt_K = _
        rw [CategoryTheory.Limits.pullback.lift_fst]
        rfl
      rw [hfst_z₀]
      exact hRange_le_compl ⟨s.base pt_K, rfl⟩

  · intro Z₁ Z₂ Y S ι₁ ι₂ f hCl₁ hCl₂ hDisj hFin₁ hEt₁ hFin₂ hEt₂ hSurj₂
    have : AlgebraicGeometry.IsClosedImmersion ι₁ := hCl₁
    have : AlgebraicGeometry.IsClosedImmersion ι₂ := hCl₂
    have : AlgebraicGeometry.IsFinite (ι₁ ≫ f) := hFin₁
    have : AlgebraicGeometry.IsFinite (ι₂ ≫ f) := hFin₂
    let Z_tot : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.coprod Z₁ Z₂
    let ι_tot : Z_tot ⟶ Y := CategoryTheory.Limits.coprod.desc ι₁ ι₂
    have hcomp_tot : ι_tot ≫ f = CategoryTheory.Limits.coprod.desc (ι₁ ≫ f) (ι₂ ≫ f) := by
      apply CategoryTheory.Limits.coprod.hom_ext
      · simp [ι_tot]
      · simp [ι_tot]
    refine ⟨Z_tot, ι_tot, ?_, ?_, ?_, ?_, ?_⟩
    · let O₁ : Y.Opens := ⟨(Set.range ι₂.base)ᶜ, ι₂.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      let O₂ : Y.Opens := ⟨(Set.range ι₁.base)ᶜ, ι₁.isClosedEmbedding.isClosed_range.isOpen_compl⟩
      have hSupO : iSup (fun b : Bool => cond b O₁ O₂) = ⊤ := by
        rw [eq_top_iff]
        intro y _
        rw [TopologicalSpace.Opens.mem_iSup]
        by_cases hy : y ∈ Set.range ι₂.base
        · refine ⟨false, ?_⟩
          change y ∉ Set.range ι₁.base
          exact Set.disjoint_right.mp hDisj hy
        · exact ⟨true, hy⟩
      refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
        (P := @AlgebraicGeometry.IsClosedImmersion) (fun b : Bool => cond b O₁ O₂) hSupO ?_
      intro b
      cases b
      · change AlgebraicGeometry.IsClosedImmersion (ι_tot ∣_ O₂)
        have hRange₂ : Set.range (CategoryTheory.Limits.coprod.inr : Z₂ ⟶ Z_tot).base =
            Set.range (ι_tot ⁻¹ᵁ O₂).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          ext z
          constructor
          · rintro ⟨z₂, rfl⟩
            change ι_tot.base ((CategoryTheory.Limits.coprod.inr : Z₂ ⟶ Z_tot).base z₂) ∉
              Set.range ι₁.base
            have heq : ι_tot.base ((CategoryTheory.Limits.coprod.inr : Z₂ ⟶ Z_tot).base z₂) =
                ι₂.base z₂ := by
              change (CategoryTheory.Limits.coprod.inr ≫ ι_tot).base z₂ = ι₂.base z₂
              rw [CategoryTheory.Limits.coprod.inr_desc]
            rw [heq]
            exact Set.disjoint_right.mp hDisj ⟨z₂, rfl⟩
          · intro hz
            have hs : (AlgebraicGeometry.coprodMk Z₁ Z₂) ((AlgebraicGeometry.coprodMk Z₁ Z₂).symm z) = z :=
              (AlgebraicGeometry.coprodMk Z₁ Z₂).apply_symm_apply z
            rcases hsym : (AlgebraicGeometry.coprodMk Z₁ Z₂).symm z with z₁ | z₂ <;>
              rw [hsym] at hs
            · rw [AlgebraicGeometry.coprodMk_inl] at hs
              exfalso
              apply hz
              rw [← hs]
              change (CategoryTheory.Limits.coprod.inl ≫ ι_tot).base z₁ ∈ Set.range ι₁.base
              rw [CategoryTheory.Limits.coprod.inl_desc]
              exact ⟨z₁, rfl⟩
            · rw [AlgebraicGeometry.coprodMk_inr] at hs
              exact ⟨z₂, hs⟩
        obtain ⟨e₂, he₂_hom, _⟩ :=
          hIsoOfOpenRangeEq (CategoryTheory.Limits.coprod.inr : Z₂ ⟶ Z_tot) (ι_tot ⁻¹ᵁ O₂).ι hRange₂
        have hcomp₂ : (e₂.hom ≫ (ι_tot ∣_ O₂)) ≫ O₂.ι = ι₂ := by
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            ← CategoryTheory.Category.assoc, he₂_hom, CategoryTheory.Limits.coprod.inr_desc]
        have : AlgebraicGeometry.IsClosedImmersion (e₂.hom ≫ (ι_tot ∣_ O₂)) := by
          have : AlgebraicGeometry.IsClosedImmersion ((e₂.hom ≫ (ι_tot ∣_ O₂)) ≫ O₂.ι) := by
            rw [hcomp₂]; exact hCl₂
          exact AlgebraicGeometry.IsClosedImmersion.of_comp (e₂.hom ≫ (ι_tot ∣_ O₂)) O₂.ι
        have heq_res₂ : ι_tot ∣_ O₂ = e₂.inv ≫ (e₂.hom ≫ (ι_tot ∣_ O₂)) := by simp
        rw [heq_res₂]
        infer_instance
      · change AlgebraicGeometry.IsClosedImmersion (ι_tot ∣_ O₁)
        have hRange₁ : Set.range (CategoryTheory.Limits.coprod.inl : Z₁ ⟶ Z_tot).base =
            Set.range (ι_tot ⁻¹ᵁ O₁).ι.base := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          ext z
          constructor
          · rintro ⟨z₁, rfl⟩
            change ι_tot.base ((CategoryTheory.Limits.coprod.inl : Z₁ ⟶ Z_tot).base z₁) ∉
              Set.range ι₂.base
            have heq : ι_tot.base ((CategoryTheory.Limits.coprod.inl : Z₁ ⟶ Z_tot).base z₁) =
                ι₁.base z₁ := by
              change (CategoryTheory.Limits.coprod.inl ≫ ι_tot).base z₁ = ι₁.base z₁
              rw [CategoryTheory.Limits.coprod.inl_desc]
            rw [heq]
            exact Set.disjoint_left.mp hDisj ⟨z₁, rfl⟩
          · intro hz
            have hs : (AlgebraicGeometry.coprodMk Z₁ Z₂) ((AlgebraicGeometry.coprodMk Z₁ Z₂).symm z) = z :=
              (AlgebraicGeometry.coprodMk Z₁ Z₂).apply_symm_apply z
            rcases hsym : (AlgebraicGeometry.coprodMk Z₁ Z₂).symm z with z₁ | z₂ <;>
              rw [hsym] at hs
            · rw [AlgebraicGeometry.coprodMk_inl] at hs
              exact ⟨z₁, hs⟩
            · rw [AlgebraicGeometry.coprodMk_inr] at hs
              exfalso
              apply hz
              rw [← hs]
              change (CategoryTheory.Limits.coprod.inr ≫ ι_tot).base z₂ ∈ Set.range ι₂.base
              rw [CategoryTheory.Limits.coprod.inr_desc]
              exact ⟨z₂, rfl⟩
        obtain ⟨e₁, he₁_hom, _⟩ :=
          hIsoOfOpenRangeEq (CategoryTheory.Limits.coprod.inl : Z₁ ⟶ Z_tot) (ι_tot ⁻¹ᵁ O₁).ι hRange₁
        have hcomp₁ : (e₁.hom ≫ (ι_tot ∣_ O₁)) ≫ O₁.ι = ι₁ := by
          rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
            ← CategoryTheory.Category.assoc, he₁_hom, CategoryTheory.Limits.coprod.inl_desc]
        have : AlgebraicGeometry.IsClosedImmersion (e₁.hom ≫ (ι_tot ∣_ O₁)) := by
          have : AlgebraicGeometry.IsClosedImmersion ((e₁.hom ≫ (ι_tot ∣_ O₁)) ≫ O₁.ι) := by
            rw [hcomp₁]; exact hCl₁
          exact AlgebraicGeometry.IsClosedImmersion.of_comp (e₁.hom ≫ (ι_tot ∣_ O₁)) O₁.ι
        have heq_res₁ : ι_tot ∣_ O₁ = e₁.inv ≫ (e₁.hom ≫ (ι_tot ∣_ O₁)) := by simp
        rw [heq_res₁]
        infer_instance
    · ext y
      constructor
      · rintro ⟨z, rfl⟩
        have hs : (AlgebraicGeometry.coprodMk Z₁ Z₂) ((AlgebraicGeometry.coprodMk Z₁ Z₂).symm z) = z :=
          (AlgebraicGeometry.coprodMk Z₁ Z₂).apply_symm_apply z
        rcases hsym : (AlgebraicGeometry.coprodMk Z₁ Z₂).symm z with z₁ | z₂ <;>
          rw [hsym] at hs
        · rw [AlgebraicGeometry.coprodMk_inl] at hs
          left
          refine ⟨z₁, ?_⟩
          rw [← hs]
          change ι₁.base z₁ = (CategoryTheory.Limits.coprod.inl ≫ ι_tot).base z₁
          rw [CategoryTheory.Limits.coprod.inl_desc]
        · rw [AlgebraicGeometry.coprodMk_inr] at hs
          right
          refine ⟨z₂, ?_⟩
          rw [← hs]
          change ι₂.base z₂ = (CategoryTheory.Limits.coprod.inr ≫ ι_tot).base z₂
          rw [CategoryTheory.Limits.coprod.inr_desc]
      · rintro (⟨z₁, rfl⟩ | ⟨z₂, rfl⟩)
        · refine ⟨(CategoryTheory.Limits.coprod.inl : Z₁ ⟶ Z_tot).base z₁, ?_⟩
          change (CategoryTheory.Limits.coprod.inl ≫ ι_tot).base z₁ = ι₁.base z₁
          rw [CategoryTheory.Limits.coprod.inl_desc]
        · refine ⟨(CategoryTheory.Limits.coprod.inr : Z₂ ⟶ Z_tot).base z₂, ?_⟩
          change (CategoryTheory.Limits.coprod.inr ≫ ι_tot).base z₂ = ι₂.base z₂
          rw [CategoryTheory.Limits.coprod.inr_desc]
    · change AlgebraicGeometry.IsFinite (ι_tot ≫ f)
      rw [hcomp_tot]
      infer_instance
    · change AlgebraicGeometry.Etale (ι_tot ≫ f)
      have : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Etale) :=
        AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
          (P := @AlgebraicGeometry.Etale) (Q := @RingHom.Etale)
      rw [AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_openCover
        (P := @AlgebraicGeometry.Etale) (AlgebraicGeometry.coprodOpenCover.{u, 0} Z₁ Z₂)]
      rintro (⟨⟩ | ⟨⟩)
      · change AlgebraicGeometry.Etale (CategoryTheory.Limits.coprod.inl ≫ (ι_tot ≫ f))
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.coprod.inl_desc]
        exact hEt₁
      · change AlgebraicGeometry.Etale (CategoryTheory.Limits.coprod.inr ≫ (ι_tot ≫ f))
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.coprod.inr_desc]
        exact hEt₂
    · refine ⟨fun s => ?_⟩
      obtain ⟨z₂, hz₂⟩ := hSurj₂.surj s
      refine ⟨(CategoryTheory.Limits.coprod.inr : Z₂ ⟶ Z_tot).base z₂, ?_⟩
      change (CategoryTheory.Limits.coprod.inr ≫ (ι_tot ≫ f)).base z₂ = s
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.coprod.inr_desc]
      exact hz₂

theorem weil_algClosed_smooth_etale_local_domain_and_connected_integral (F : Type u) [Field F] [IsAlgClosed F] :
    (∀ (d : ℕ) (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine X]
        (u : Quiver.Hom X (weilAffineSpaceOver F d).left) [AlgebraicGeometry.Etale u]
        (x : ↥X),
      IsClosed ({x} : Set ↥X) →
      ∃ U : X.Opens,
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧ AlgebraicGeometry.IsIntegral U.toScheme) ∧
    (∀ (d n : ℕ) (B Y : AlgebraicGeometry.Scheme.{u})
        (u_B : Quiver.Hom B (weilAffineSpaceOver F d).left) [AlgebraicGeometry.Etale u_B]
        (f : Quiver.Hom Y B) [AlgebraicGeometry.SmoothOfRelativeDimension n f],
      ConnectedSpace ↥Y →
      IrreducibleSpace ↥Y ∧ AlgebraicGeometry.IsIntegral Y) :=
by
  classical

  
  have hInitForm : ∀ (k a b : ℕ) (p q : MvPolynomial (Fin k) F),
      p ∈ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin k) F →+* F)) ^ a →
      p ∉ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin k) F →+* F)) ^ (a + 1) →
      q ∈ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin k) F →+* F)) ^ b →
      q ∉ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin k) F →+* F)) ^ (b + 1) →
      p * q ∉ (RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin k) F →+* F)) ^ (a + b + 1) := by
    intro k a b p q hp_a hp_a1 hq_b hq_b1
    set I₀ : Ideal (MvPolynomial (Fin k) F) :=
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin k) F →+* F)
    let D : ℕ → Ideal (MvPolynomial (Fin k) F) := fun r =>
      { carrier := {f | ∀ d ∈ f.support, r ≤ Finsupp.degree d}
        zero_mem' := by simp
        add_mem' := fun {f₁ f₂} hf₁ hf₂ d hd => by
          rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_add] at hd
          by_cases h1 : f₁.coeff d = 0
          · rw [h1, zero_add] at hd
            exact hf₂ d (MvPolynomial.mem_support_iff.mpr hd)
          · exact hf₁ d (MvPolynomial.mem_support_iff.mpr h1)
        smul_mem' := fun c {f} hf d hd => by
          rw [smul_eq_mul, MvPolynomial.mem_support_iff, MvPolynomial.coeff_mul] at hd
          obtain ⟨⟨d₁, d₂⟩, hanti, hmul⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
          have hadd : d₁ + d₂ = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hanti
          have hd₂ : d₂ ∈ f.support :=
            MvPolynomial.mem_support_iff.mpr (right_ne_zero_of_mul hmul)
          rw [← hadd, map_add]
          exact le_trans (hf d₂ hd₂) (Nat.le_add_left _ _) }
    have hI₀_le_D1 : I₀ ≤ D 1 := by
      intro f hf d hd
      have hf0 : f.coeff 0 = 0 := by
        rw [← MvPolynomial.constantCoeff_eq]
        exact hf
      have hd_ne : d ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hd) hf0
      obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hd_ne
      have hdi : 1 ≤ d i := Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi)
      rw [Finsupp.degree_apply]
      exact le_trans hdi (Finset.single_le_sum (fun _ _ => Nat.zero_le _) hi)
    have hPow_le_D : ∀ r : ℕ, I₀ ^ r ≤ D r := by
      intro r
      induction r with
      | zero =>
        rw [pow_zero]
        intro f _ d _
        exact Nat.zero_le _
      | succ r ih =>
        rw [pow_succ]
        refine Submodule.mul_le.mpr ?_
        intro f hf g hg d hd
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_mul] at hd
        obtain ⟨⟨d₁, d₂⟩, hanti, hmul⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd
        have hadd : d₁ + d₂ = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hanti
        have h1 : r ≤ Finsupp.degree d₁ :=
          ih hf d₁ (MvPolynomial.mem_support_iff.mpr (left_ne_zero_of_mul hmul))
        have h2 : 1 ≤ Finsupp.degree d₂ :=
          hI₀_le_D1 hg d₂ (MvPolynomial.mem_support_iff.mpr (right_ne_zero_of_mul hmul))
        rw [← hadd, map_add]
        omega
    have hMon_mem : ∀ (d : Fin k →₀ ℕ) (c : F),
        MvPolynomial.monomial d c ∈ I₀ ^ Finsupp.degree d := by
      intro d
      refine Finsupp.induction₂ (motive := fun d => ∀ c : F,
        MvPolynomial.monomial d c ∈ I₀ ^ Finsupp.degree d) d ?_ ?_
      · intro c
        rw [map_zero, pow_zero, Ideal.one_eq_top]
        trivial
      · intro i m s _ _ ih c
        rw [MvPolynomial.monomial_add_single, map_add, Finsupp.degree_single, pow_add]
        have hXi : (MvPolynomial.X i : MvPolynomial (Fin k) F) ∈ I₀ :=
          MvPolynomial.constantCoeff_X F i
        exact Ideal.mul_mem_mul (ih c) (Ideal.pow_mem_pow hXi m)
    have hD_le_Pow : ∀ r : ℕ, D r ≤ I₀ ^ r := by
      intro r f hf
      rw [MvPolynomial.as_sum f]
      refine Submodule.sum_mem (I₀ ^ r) (fun d hd => ?_)
      exact Ideal.pow_le_pow_right (hf d hd) (hMon_mem d (f.coeff d))
    have hEq_D : ∀ r : ℕ, I₀ ^ r = D r := fun r => le_antisymm (hPow_le_D r) (hD_le_Pow r)
    have hComp : ∀ (r : ℕ) (f : MvPolynomial (Fin k) F),
        f ∈ I₀ ^ r → f ∉ I₀ ^ (r + 1) →
        let f_r := MvPolynomial.homogeneousComponent r f
        f_r ∈ I₀ ^ r ∧ f - f_r ∈ I₀ ^ (r + 1) ∧ f_r ≠ 0 := by
      intro r f hfr hfr1
      set f_r := MvPolynomial.homogeneousComponent r f
      have hfr_in : f_r ∈ I₀ ^ r := by
        rw [hEq_D r]
        intro d hd
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_homogeneousComponent] at hd
        by_cases hdeg : Finsupp.degree d = r
        · omega
        · rw [if_neg hdeg] at hd
          exact absurd rfl hd
      have hsub_in : f - f_r ∈ I₀ ^ (r + 1) := by
        rw [hEq_D (r + 1)]
        intro d hd
        rw [MvPolynomial.mem_support_iff, MvPolynomial.coeff_sub,
          MvPolynomial.coeff_homogeneousComponent] at hd
        by_cases hdeg : Finsupp.degree d = r
        · rw [if_pos hdeg, sub_self] at hd
          exact absurd rfl hd
        · rw [if_neg hdeg, sub_zero] at hd
          have hge : r ≤ Finsupp.degree d := by
            rw [hEq_D r] at hfr
            exact hfr d (MvPolynomial.mem_support_iff.mpr hd)
          omega
      have hfr_ne : f_r ≠ 0 := by
        intro h0
        apply hfr1
        simpa [h0] using hsub_in
      exact ⟨hfr_in, hsub_in, hfr_ne⟩
    obtain ⟨hp_in, hp_sub, hp_ne⟩ := hComp a p hp_a hp_a1
    obtain ⟨hq_in, hq_sub, hq_ne⟩ := hComp b q hq_b hq_b1
    set p_a := MvPolynomial.homogeneousComponent a p
    set q_b := MvPolynomial.homogeneousComponent b q
    have hpq_ne : p_a * q_b ≠ 0 := mul_ne_zero hp_ne hq_ne
    have hex_d₀ : ∃ d₀, (p_a * q_b).coeff d₀ ≠ 0 := by
      by_contra! h0
      exact hpq_ne (MvPolynomial.ext _ _ fun d => by simp [h0 d])
    obtain ⟨d₀, hd₀⟩ := hex_d₀
    have hpq_not_in : p_a * q_b ∉ I₀ ^ (a + b + 1) := by
      rw [hEq_D (a + b + 1)]
      intro hmem
      have hge := hmem d₀ (MvPolynomial.mem_support_iff.mpr hd₀)
      rw [MvPolynomial.coeff_mul] at hd₀
      obtain ⟨⟨d₁, d₂⟩, hanti, hmul⟩ := Finset.exists_ne_zero_of_sum_ne_zero hd₀
      have hadd : d₁ + d₂ = d₀ := Finset.HasAntidiagonal.mem_antidiagonal.mp hanti
      have hd₁_ne : p_a.coeff d₁ ≠ 0 := left_ne_zero_of_mul hmul
      have hd₂_ne : q_b.coeff d₂ ≠ 0 := right_ne_zero_of_mul hmul
      have hdeg₁ : Finsupp.degree d₁ = a := by
        dsimp [p_a] at hd₁_ne
        rw [MvPolynomial.coeff_homogeneousComponent] at hd₁_ne
        by_contra hne
        rw [if_neg hne] at hd₁_ne
        exact hd₁_ne rfl
      have hdeg₂ : Finsupp.degree d₂ = b := by
        dsimp [q_b] at hd₂_ne
        rw [MvPolynomial.coeff_homogeneousComponent] at hd₂_ne
        by_contra hne
        rw [if_neg hne] at hd₂_ne
        exact hd₂_ne rfl
      have hdeg₀ : Finsupp.degree d₀ = a + b := by
        rw [← hadd, map_add, hdeg₁, hdeg₂]
      omega
    have hdiff_in : p * q - p_a * q_b ∈ I₀ ^ (a + b + 1) := by
      have heq : p * q - p_a * q_b = p_a * (q - q_b) + (p - p_a) * q := by ring
      rw [heq]
      have h1 : p_a * (q - q_b) ∈ I₀ ^ (a + b + 1) := by
        have hexp : a + b + 1 = a + (b + 1) := by omega
        rw [hexp, pow_add]
        exact Ideal.mul_mem_mul hp_in hq_sub
      have h2 : (p - p_a) * q ∈ I₀ ^ (a + b + 1) := by
        have hexp : a + b + 1 = (a + 1) + b := by omega
        rw [hexp, pow_add]
        exact Ideal.mul_mem_mul hp_sub hq_b
      exact Ideal.add_mem _ h1 h2
    intro hpq_in
    apply hpq_not_in
    have hpaqb : p_a * q_b = p * q - (p * q - p_a * q_b) := by ring
    rw [hpaqb]
    exact Ideal.sub_mem _ hpq_in hdiff_in

  
  have hMaxDom : ∀ (k : ℕ) (S : Type u) [CommRing S]
      (φ : MvPolynomial (Fin k) F →+* S),
      φ.Etale →
      ∀ (m : Ideal S) [m.IsMaximal],
        IsDomain (Localization.AtPrime m) ∧ IsNoetherianRing S := by
    intro k S _ φ hφ m _
    let R := MvPolynomial (Fin k) F
    let I₀ : Ideal R := RingHom.ker (MvPolynomial.constantCoeff : R →+* F)
    let S_m := Localization.AtPrime m
    let m_S : Ideal S_m := IsLocalRing.maximalIdeal S_m
    have hNull : IsNoetherianRing S ∧
        ∃ ε : S →+* F, ε.comp (φ.comp MvPolynomial.C) = RingHom.id F ∧ RingHom.ker ε = m := by
      letI : Algebra R S := φ.toAlgebra
      haveI : Algebra.Etale R S := hφ.toAlgebra
      letI : Algebra F S := (φ.comp MvPolynomial.C).toAlgebra
      haveI : IsScalarTower F R S := IsScalarTower.of_algebraMap_eq' rfl
      haveI : Algebra.FiniteType F R := inferInstance
      haveI : Algebra.FiniteType R S := inferInstance
      haveI : Algebra.FiniteType F S :=
        Algebra.FiniteType.trans ‹Algebra.FiniteType F R› ‹Algebra.FiniteType R S›
      have hNoethS : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing F S
      obtain ⟨n_mv, q_mv, hq_surj⟩ :=
        Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType F S›
      let q_hom : MvPolynomial (Fin n_mv) F →+* S := q_mv.toRingHom
      have hq_hom_surj : Function.Surjective q_hom := hq_surj
      let m_mv : Ideal (MvPolynomial (Fin n_mv) F) := Ideal.comap q_hom m
      have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
      obtain ⟨a_pt, ha_pt⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
      let ev_hom : MvPolynomial (Fin n_mv) F →+* F := (MvPolynomial.aeval a_pt).toRingHom
      have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
        intro f_p hf_p
        rw [RingHom.mem_ker] at hf_p
        have hmem : f_p ∈ m_mv := by
          change q_hom f_p ∈ m
          rw [hf_p]
          exact m.zero_mem
        rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
        exact hmem
      let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
      let ε : S →+* F :=
        (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
      have hε_C : ε.comp (φ.comp MvPolynomial.C) = RingHom.id F := by
        ext c
        change ε (algebraMap F S c) = c
        have hq_C : q_hom (MvPolynomial.C c) = algebraMap F S c := q_mv.commutes c
        rw [← hq_C]
        dsimp [ε]
        have heq_q : e_quot.symm (q_hom (MvPolynomial.C c)) =
            Ideal.Quotient.mk (RingHom.ker q_hom) (MvPolynomial.C c) := by
          apply e_quot.injective
          simp [e_quot]
        rw [heq_q, Ideal.Quotient.lift_mk]
        exact (MvPolynomial.aeval a_pt).commutes c
      have hm_le_ker : m ≤ RingHom.ker ε := by
        intro s hs
        obtain ⟨f_p, rfl⟩ := hq_hom_surj s
        rw [RingHom.mem_ker]
        have hf_mv : f_p ∈ m_mv := hs
        rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hf_mv
        dsimp [ε]
        have heq_q : e_quot.symm (q_hom f_p) =
            Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
          apply e_quot.injective
          simp [e_quot]
        rw [heq_q, Ideal.Quotient.lift_mk]
        exact hf_mv
      have hker_eq : RingHom.ker ε = m :=
        (Ideal.IsMaximal.eq_of_le ‹m.IsMaximal› (RingHom.ker_ne_top ε) hm_le_ker).symm
      exact ⟨hNoethS, ε, hε_C, hker_eq⟩
    obtain ⟨hNoethS, ε, hε_C, hε_ker⟩ := hNull
    haveI : IsNoetherianRing S := hNoethS
    haveI : IsNoetherianRing S_m := IsLocalization.isNoetherianRing m.primeCompl S_m hNoethS
    let a_shift : Fin k → F := fun i => ε (φ (MvPolynomial.X i))
    let τ_sub_alg : R →ₐ[F] R :=
      MvPolynomial.aeval (fun i : Fin k => MvPolynomial.X i - MvPolynomial.C (a_shift i))
    let τ_add_alg : R →ₐ[F] R :=
      MvPolynomial.aeval (fun i : Fin k => MvPolynomial.X i + MvPolynomial.C (a_shift i))
    have hτ_1 : τ_add_alg.comp τ_sub_alg = AlgHom.id F R := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, MvPolynomial.aeval_X, map_sub, MvPolynomial.aeval_X,
        ← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_eq]
      exact add_sub_cancel_right _ _
    have hτ_2 : τ_sub_alg.comp τ_add_alg = AlgHom.id F R := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, MvPolynomial.aeval_X, map_add, MvPolynomial.aeval_X,
        ← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_eq]
      exact sub_add_cancel _ _
    have hτ_bij : Function.Bijective τ_sub_alg.toRingHom := by
      refine ⟨fun p₁ p₂ h => ?_, fun p => ⟨τ_add_alg p, AlgHom.congr_fun hτ_2 p⟩⟩
      have h' := congrArg τ_add_alg h
      simpa using (AlgHom.congr_fun hτ_1 p₁).symm.trans (h'.trans (AlgHom.congr_fun hτ_1 p₂))
    let φ₀ : R →+* S := φ.comp τ_sub_alg.toRingHom
    have hφ₀_et : φ₀.Etale :=
      RingHom.Etale.stableUnderComposition τ_sub_alg.toRingHom φ
        (RingHom.Etale.of_bijective hτ_bij) hφ
    let ψ : R →+* S_m := (algebraMap S S_m).comp φ₀
    have hε_φ₀ : ε.comp φ₀ = MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro c
        change ε (φ (τ_sub_alg (MvPolynomial.C c))) = MvPolynomial.constantCoeff (MvPolynomial.C c)
        rw [← MvPolynomial.algebraMap_eq, τ_sub_alg.commutes c,
          MvPolynomial.algebraMap_eq, MvPolynomial.constantCoeff_C]
        exact RingHom.congr_fun hε_C c
      · intro i
        change ε (φ (τ_sub_alg (MvPolynomial.X i))) = MvPolynomial.constantCoeff (MvPolynomial.X i)
        have hτX : τ_sub_alg (MvPolynomial.X i) =
            MvPolynomial.X i - MvPolynomial.C (a_shift i) :=
          MvPolynomial.aeval_X _ i
        have hεCa : ε (φ (MvPolynomial.C (a_shift i))) = a_shift i :=
          RingHom.congr_fun hε_C (a_shift i)
        rw [hτX, map_sub, map_sub, hεCa, MvPolynomial.constantCoeff_X]
        exact sub_self (a_shift i)
    have hε_units : ∀ y : m.primeCompl, IsUnit (ε y.1) := by
      intro y
      have hy_ne : ε y.1 ≠ 0 := by
        intro h0
        exact y.2 (hε_ker ▸ h0)
      exact IsUnit.mk0 (ε y.1) hy_ne
    let ε_loc : S_m →+* F := IsLocalization.lift (M := m.primeCompl) (g := ε) hε_units
    have hε_loc_comp : ε_loc.comp (algebraMap S S_m) = ε :=
      RingHom.ext fun s => IsLocalization.lift_eq hε_units s
    have hε_ψ : ε_loc.comp ψ = MvPolynomial.constantCoeff := by
      change (ε_loc.comp (algebraMap S S_m)).comp φ₀ = MvPolynomial.constantCoeff
      rw [hε_loc_comp]
      exact hε_φ₀
    have hε_surj : Function.Surjective ε_loc := by
      intro c
      refine ⟨ψ (MvPolynomial.C c), ?_⟩
      change (ε_loc.comp ψ) (MvPolynomial.C c) = c
      rw [hε_ψ, MvPolynomial.constantCoeff_C]
    have hker_εloc : RingHom.ker ε_loc = m_S :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective ε_loc hε_surj)

    letI : Algebra R S := φ₀.toAlgebra
    haveI : Algebra.Etale R S := hφ₀_et.toAlgebra
    haveI : Algebra.FormallyEtale R S := inferInstance
    haveI : Algebra.FormallyEtale S S_m := Algebra.FormallyEtale.of_isLocalization m.primeCompl
    haveI : Algebra.FormallyEtale R S_m := Algebra.FormallyEtale.comp R S S_m
    have hψ_alg : algebraMap R S_m = ψ := IsScalarTower.algebraMap_eq R S S_m

    let J : Ideal S_m := Ideal.map ψ I₀
    have hJ_le : J ≤ m_S := by
      refine Ideal.map_le_iff_le_comap.mpr ?_
      intro p hp
      rw [← hker_εloc]
      change (ε_loc.comp ψ) p = 0
      rw [hε_ψ]
      exact hp
    let L : Ideal S_m := J ⊔ m_S ^ 2
    let Q := S_m ⧸ L
    let M : Ideal Q := Ideal.map (Ideal.Quotient.mk L) m_S
    have hM2 : M ^ 2 = ⊥ := by
      dsimp [M]
      rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
      exact le_sup_right
    have hg₂_comm_hom :
        ((Ideal.Quotient.mk L).comp (ψ.comp MvPolynomial.C)).comp (ε_loc.comp ψ) =
          (Ideal.Quotient.mk L).comp ψ := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp [hε_ψ]
      · intro i
        have hXi_I₀ : (MvPolynomial.X i : R) ∈ I₀ := MvPolynomial.constantCoeff_X F i
        have hψXi_L : ψ (MvPolynomial.X i) ∈ L :=
          (le_sup_left : J ≤ L) (Ideal.mem_map_of_mem ψ hXi_I₀)
        have hmk0 : Ideal.Quotient.mk L (ψ (MvPolynomial.X i)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hψXi_L
        change Ideal.Quotient.mk L (ψ (MvPolynomial.C ((ε_loc.comp ψ) (MvPolynomial.X i)))) =
          Ideal.Quotient.mk L (ψ (MvPolynomial.X i))
        rw [hε_ψ, MvPolynomial.constantCoeff_X, map_zero, map_zero, map_zero, hmk0]
    let g₁ : S_m →ₐ[R] Q := Ideal.Quotient.mkₐ R L
    let g₂ : S_m →ₐ[R] Q :=
      { toRingHom := ((Ideal.Quotient.mk L).comp (ψ.comp MvPolynomial.C)).comp ε_loc
        commutes' := fun p => by
          have halgQ : algebraMap R Q p = Ideal.Quotient.mk L (ψ p) := by
            rw [IsScalarTower.algebraMap_apply R S_m Q p, hψ_alg]
            rfl
          rw [halgQ]
          change (((Ideal.Quotient.mk L).comp (ψ.comp MvPolynomial.C)).comp ε_loc)
            (algebraMap R S_m p) = Ideal.Quotient.mk L (ψ p)
          rw [hψ_alg]
          exact RingHom.congr_fun hg₂_comm_hom p }
    have hg_comp : (Ideal.Quotient.mkₐ R M).comp g₁ = (Ideal.Quotient.mkₐ R M).comp g₂ := by
      apply AlgHom.ext
      intro (z : S_m)
      change Ideal.Quotient.mk M (g₁ z) = Ideal.Quotient.mk M (g₂ z)
      rw [Ideal.Quotient.eq]
      have hz_mem : z - ψ (MvPolynomial.C (ε_loc z)) ∈ m_S := by
        rw [← hker_εloc, RingHom.mem_ker, map_sub]
        have hc : ε_loc (ψ (MvPolynomial.C (ε_loc z))) = ε_loc z := by
          change (ε_loc.comp ψ) (MvPolynomial.C (ε_loc z)) = ε_loc z
          rw [hε_ψ, MvPolynomial.constantCoeff_C]
        rw [hc, sub_self]
      change Ideal.Quotient.mk L (z - ψ (MvPolynomial.C (ε_loc z))) ∈ M
      exact Ideal.mem_map_of_mem (Ideal.Quotient.mk L) hz_mem
    have hg_eq : g₁ = g₂ := (Algebra.FormallyEtale.comp_bijective R S_m M hM2).1 hg_comp
    have hm_le_L : m_S ≤ J ⊔ m_S • m_S := by
      have hm_le_L' : m_S ≤ L := by
        intro z hz
        have hz0 : ε_loc z = 0 := by rwa [← hker_εloc] at hz
        have hmk : Ideal.Quotient.mk L z = 0 := by
          change g₁ z = 0
          rw [hg_eq]
          change Ideal.Quotient.mk L (ψ (MvPolynomial.C (ε_loc z))) = 0
          rw [hz0, map_zero, map_zero, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk
      simpa only [L, pow_two, Ideal.smul_eq_mul] using hm_le_L'
    have hm_le_J : m_S ≤ J :=
      @Submodule.le_of_le_smul_of_le_jacobson_bot S_m S_m _ _ _ m_S J m_S
        (Ideal.fg_of_isNoetherianRing m_S)
        (IsLocalRing.maximalIdeal_le_jacobson (R := S_m) ⊥)
        hm_le_L
    have hJ_eq : J = m_S := le_antisymm hJ_le hm_le_J

    have hSurj_ψ : ∀ (r : ℕ) (z : S_m), ∃ p : R, z - ψ p ∈ m_S ^ r := by
      intro r
      induction r with
      | zero =>
        intro z
        refine ⟨0, ?_⟩
        rw [pow_zero, Ideal.one_eq_top]
        trivial
      | succ r ih =>
        intro z
        obtain ⟨p₀, hp₀⟩ := ih z
        have hm_pow : m_S ^ r = Ideal.map ψ (I₀ ^ r) := by
          rw [← hJ_eq, Ideal.map_pow]
        have hw_span : z - ψ p₀ ∈ Submodule.span S_m (ψ '' ((I₀ ^ r : Ideal R) : Set R)) := by
          rwa [hm_pow] at hp₀
        have hSpanStep :
            ∀ {u : S_m} (hu : u ∈ Submodule.span S_m (ψ '' ((I₀ ^ r : Ideal R) : Set R))),
              ∃ q : R, u - ψ q ∈ m_S ^ (r + 1) := by
          intro u hu
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hu
          · rintro _ ⟨g, hg, rfl⟩
            exact ⟨g, by simp⟩
          · exact ⟨0, by simp⟩
          · intro u₁ u₂ _ _ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
            refine ⟨q₁ + q₂, ?_⟩
            have heq : (u₁ + u₂) - ψ (q₁ + q₂) = (u₁ - ψ q₁) + (u₂ - ψ q₂) := by
              rw [map_add]; ring
            rw [heq]
            exact Ideal.add_mem _ hq₁ hq₂
          · intro s u₀ hu₀ ⟨q₀, hq₀⟩
            let c := ε_loc s
            have hs_m : s - ψ (MvPolynomial.C c) ∈ m_S := by
              rw [← hker_εloc, RingHom.mem_ker, map_sub]
              have hc : ε_loc (ψ (MvPolynomial.C c)) = c := by
                change (ε_loc.comp ψ) (MvPolynomial.C c) = c
                rw [hε_ψ, MvPolynomial.constantCoeff_C]
              rw [hc, sub_self]
            have hu₀_mr : u₀ ∈ m_S ^ r := by
              rw [hm_pow]
              exact hu₀
            refine ⟨MvPolynomial.C c * q₀, ?_⟩
            have heq : s • u₀ - ψ (MvPolynomial.C c * q₀) =
                (s - ψ (MvPolynomial.C c)) * u₀ + ψ (MvPolynomial.C c) * (u₀ - ψ q₀) := by
              rw [smul_eq_mul, map_mul]; ring
            rw [heq]
            have h1 : (s - ψ (MvPolynomial.C c)) * u₀ ∈ m_S ^ (r + 1) := by
              rw [pow_succ']
              exact Ideal.mul_mem_mul hs_m hu₀_mr
            have h2 : ψ (MvPolynomial.C c) * (u₀ - ψ q₀) ∈ m_S ^ (r + 1) :=
              Ideal.mul_mem_left _ _ hq₀
            exact Ideal.add_mem _ h1 h2
        obtain ⟨q, hq⟩ := hSpanStep hw_span
        refine ⟨p₀ + q, ?_⟩
        have heq : z - ψ (p₀ + q) = (z - ψ p₀) - ψ q := by
          rw [map_add]; ring
        rw [heq]
        exact hq

    have hLift : ∀ s : ℕ,
        ∃ ψ_s : S_m →ₐ[R] (R ⧸ I₀ ^ (s + 1)),
          ∀ z ∈ m_S,
            Ideal.Quotient.factor
              (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.zero_le s))) (ψ_s z) = 0 := by
      intro s
      induction s with
      | zero =>
        have hψ₀_comm_hom :
            ((Ideal.Quotient.mk (I₀ ^ 1)).comp MvPolynomial.C).comp (ε_loc.comp ψ) =
              Ideal.Quotient.mk (I₀ ^ 1) := by
          apply MvPolynomial.ringHom_ext
          · intro c
            simp [hε_ψ]
          · intro i
            have hXi : (MvPolynomial.X i : R) ∈ I₀ ^ 1 := by
              rw [pow_one]
              exact MvPolynomial.constantCoeff_X F i
            have hmk0 : Ideal.Quotient.mk (I₀ ^ 1) (MvPolynomial.X i) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr hXi
            change Ideal.Quotient.mk (I₀ ^ 1)
              (MvPolynomial.C ((ε_loc.comp ψ) (MvPolynomial.X i))) =
              Ideal.Quotient.mk (I₀ ^ 1) (MvPolynomial.X i)
            rw [hε_ψ, MvPolynomial.constantCoeff_X, map_zero, map_zero, hmk0]
        let ψ_0 : S_m →ₐ[R] (R ⧸ I₀ ^ 1) :=
          { toRingHom := ((Ideal.Quotient.mk (I₀ ^ 1)).comp MvPolynomial.C).comp ε_loc
            commutes' := fun p => by
              change (((Ideal.Quotient.mk (I₀ ^ 1)).comp MvPolynomial.C).comp ε_loc)
                (algebraMap R S_m p) = Ideal.Quotient.mk (I₀ ^ 1) p
              rw [hψ_alg]
              exact RingHom.congr_fun hψ₀_comm_hom p }
        refine ⟨ψ_0, fun z hz => ?_⟩
        have hz0 : ε_loc z = 0 := by rwa [← hker_εloc] at hz
        have hψ0_z : ψ_0 z = 0 := by
          change Ideal.Quotient.mk (I₀ ^ 1) (MvPolynomial.C (ε_loc z)) = 0
          rw [hz0, map_zero, map_zero]
        rw [hψ0_z, map_zero]
      | succ s ih =>
        obtain ⟨ψ_s, hψ_s⟩ := ih
        have hle : I₀ ^ (s + 2) ≤ I₀ ^ (s + 1) :=
          Ideal.pow_le_pow_right (Nat.le_succ (s + 1))
        let π_s : (R ⧸ I₀ ^ (s + 2)) →ₐ[R] (R ⧸ I₀ ^ (s + 1)) :=
          { toRingHom := Ideal.Quotient.factor hle
            commutes' := fun _ => rfl }
        have hπ_surj : Function.Surjective π_s.toRingHom := fun x => by
          obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
          exact ⟨Ideal.Quotient.mk (I₀ ^ (s + 2)) p, rfl⟩
        let K_s : Ideal (R ⧸ I₀ ^ (s + 2)) := RingHom.ker π_s.toRingHom
        have hKs2 : K_s ^ 2 = ⊥ := by
          have hKs_le : K_s ≤ Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 2))) (I₀ ^ (s + 1)) := by
            intro x hx
            obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
            have hp : p ∈ I₀ ^ (s + 1) :=
              Ideal.Quotient.eq_zero_iff_mem.mp hx
            exact Ideal.mem_map_of_mem _ hp
          have hpow_le : K_s ^ 2 ≤
              (Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 2))) (I₀ ^ (s + 1))) ^ 2 :=
            Ideal.pow_right_mono hKs_le 2
          rw [← Ideal.map_pow, ← pow_mul] at hpow_le
          have hexp : s + 2 ≤ (s + 1) * 2 := by omega
          have hbot : Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 2))) (I₀ ^ ((s + 1) * 2)) = ⊥ := by
            rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
            exact Ideal.pow_le_pow_right hexp
          exact eq_bot_iff.mpr (hpow_le.trans (le_of_eq hbot))
        let e_ring := RingHom.quotientKerEquivOfSurjective hπ_surj
        let e_inv : (R ⧸ I₀ ^ (s + 1)) →ₐ[R] ((R ⧸ I₀ ^ (s + 2)) ⧸ K_s) :=
          { toRingHom := e_ring.symm.toRingHom
            commutes' := fun r => by
              apply e_ring.injective
              change e_ring (e_ring.symm (algebraMap R (R ⧸ I₀ ^ (s + 1)) r)) =
                e_ring (Ideal.Quotient.mk K_s (algebraMap R (R ⧸ I₀ ^ (s + 2)) r))
              rw [e_ring.apply_symm_apply]
              rfl }
        obtain ⟨ψ_next, hψ_next⟩ :=
          (Algebra.FormallyEtale.comp_bijective R S_m K_s hKs2).2 (e_inv.comp ψ_s)
        refine ⟨ψ_next, fun z hz => ?_⟩
        have hπ_eq : π_s (ψ_next z) = ψ_s z := by
          have hz_comp := AlgHom.congr_fun hψ_next z
          have hz' := congrArg e_ring hz_comp
          exact hz'.trans (e_ring.apply_symm_apply (ψ_s z))
        have hfac_comp :
            Ideal.Quotient.factor
              (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.zero_le (s + 1)))) (ψ_next z) =
            Ideal.Quotient.factor
              (Ideal.pow_le_pow_right (Nat.succ_le_succ (Nat.zero_le s))) (π_s (ψ_next z)) := by
          obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (ψ_next z)
          rw [← hp]
          rfl
        rw [hfac_comp, hπ_eq]
        exact hψ_s z hz

    have hComap_ψ : ∀ r : ℕ, Ideal.comap ψ (m_S ^ r) = I₀ ^ r := by
      intro r
      cases r with
      | zero =>
        simp
      | succ s =>
        apply le_antisymm
        · obtain ⟨ψ_s, hψ_s⟩ := hLift s
          have hm_map : Ideal.map ψ_s.toRingHom m_S ≤
              Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 1))) I₀ := by
            refine Ideal.map_le_iff_le_comap.mpr ?_
            intro z hz
            obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (ψ_s z)
            have h0 := hψ_s z hz
            rw [← hp] at h0
            have hp_I₀ : p ∈ I₀ := by
              have hp1 : p ∈ I₀ ^ 1 := Ideal.Quotient.eq_zero_iff_mem.mp h0
              rwa [pow_one] at hp1
            change ψ_s z ∈ Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 1))) I₀
            rw [← hp]
            exact Ideal.mem_map_of_mem _ hp_I₀
          have hm_pow_bot : Ideal.map ψ_s.toRingHom (m_S ^ (s + 1)) = ⊥ := by
            have hle_pow : Ideal.map ψ_s.toRingHom (m_S ^ (s + 1)) ≤
                (Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 1))) I₀) ^ (s + 1) := by
              rw [Ideal.map_pow]
              exact Ideal.pow_right_mono hm_map (s + 1)
            rw [← Ideal.map_pow] at hle_pow
            have hbot : Ideal.map (Ideal.Quotient.mk (I₀ ^ (s + 1))) (I₀ ^ (s + 1)) = ⊥ := by
              rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
            exact eq_bot_iff.mpr (hle_pow.trans (le_of_eq hbot))
          intro p hp
          have hψp_mem : ψ_s.toRingHom (ψ p) ∈ Ideal.map ψ_s.toRingHom (m_S ^ (s + 1)) :=
            Ideal.mem_map_of_mem _ hp
          rw [hm_pow_bot, Ideal.mem_bot] at hψp_mem
          have hcomm : ψ_s.toRingHom (ψ p) = Ideal.Quotient.mk (I₀ ^ (s + 1)) p := by
            rw [← RingHom.congr_fun hψ_alg p]
            exact ψ_s.commutes p
          rw [hcomm] at hψp_mem
          exact Ideal.Quotient.eq_zero_iff_mem.mp hψp_mem
        · have hmap_eq : Ideal.map ψ (I₀ ^ (s + 1)) = m_S ^ (s + 1) := by
            rw [Ideal.map_pow]
            change J ^ (s + 1) = m_S ^ (s + 1)
            rw [hJ_eq]
          rw [← hmap_eq]
          exact Ideal.le_comap_map

    have hKrull : (⨅ r : ℕ, m_S ^ r) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing m_S (IsLocalRing.maximalIdeal.isMaximal S_m).ne_top
    haveI : NoZeroDivisors S_m := ⟨by
      intro x y hxy
      by_contra! hne
      obtain ⟨hx_ne, hy_ne⟩ := hne
      have hx_ex : ∃ r : ℕ, x ∉ m_S ^ r := by
        by_contra! hall
        have hx_bot : x ∈ (⨅ r : ℕ, m_S ^ r) := Ideal.mem_iInf.mpr hall
        rw [hKrull, Ideal.mem_bot] at hx_bot
        exact hx_ne hx_bot
      have hy_ex : ∃ r : ℕ, y ∉ m_S ^ r := by
        by_contra! hall
        have hy_bot : y ∈ (⨅ r : ℕ, m_S ^ r) := Ideal.mem_iInf.mpr hall
        rw [hKrull, Ideal.mem_bot] at hy_bot
        exact hy_ne hy_bot
      let rx := Nat.find hx_ex
      let ry := Nat.find hy_ex
      have hrx_ne : rx ≠ 0 := by
        intro h0
        have hspec : x ∉ m_S ^ rx := Nat.find_spec hx_ex
        rw [h0, pow_zero, Ideal.one_eq_top] at hspec
        exact hspec trivial
      have hry_ne : ry ≠ 0 := by
        intro h0
        have hspec : y ∉ m_S ^ ry := Nat.find_spec hy_ex
        rw [h0, pow_zero, Ideal.one_eq_top] at hspec
        exact hspec trivial
      let a := rx - 1
      let b := ry - 1
      have hrx_eq : rx = a + 1 := by omega
      have hry_eq : ry = b + 1 := by omega
      have hx_not : x ∉ m_S ^ (a + 1) := hrx_eq ▸ Nat.find_spec hx_ex
      have hy_not : y ∉ m_S ^ (b + 1) := hry_eq ▸ Nat.find_spec hy_ex
      have hx_in : x ∈ m_S ^ a := by
        by_contra hnot
        exact Nat.find_min hx_ex (by omega : a < rx) hnot
      have hy_in : y ∈ m_S ^ b := by
        by_contra hnot
        exact Nat.find_min hy_ex (by omega : b < ry) hnot
      let N := a + b + 1
      obtain ⟨p, hp_N⟩ := hSurj_ψ N x
      obtain ⟨q, hq_N⟩ := hSurj_ψ N y
      have hp_a : p ∈ I₀ ^ a := by
        rw [← hComap_ψ a]
        change ψ p ∈ m_S ^ a
        have hsub : x - ψ p ∈ m_S ^ a :=
          Ideal.pow_le_pow_right (by omega : a ≤ N) hp_N
        have heq : ψ p = x - (x - ψ p) := by ring
        rw [heq]
        exact Ideal.sub_mem _ hx_in hsub
      have hp_a1 : p ∉ I₀ ^ (a + 1) := by
        rw [← hComap_ψ (a + 1)]
        intro hmem
        apply hx_not
        have hsub : x - ψ p ∈ m_S ^ (a + 1) :=
          Ideal.pow_le_pow_right (by omega : a + 1 ≤ N) hp_N
        have heq : x = (x - ψ p) + ψ p := by ring
        rw [heq]
        exact Ideal.add_mem _ hsub hmem
      have hq_b : q ∈ I₀ ^ b := by
        rw [← hComap_ψ b]
        change ψ q ∈ m_S ^ b
        have hsub : y - ψ q ∈ m_S ^ b :=
          Ideal.pow_le_pow_right (by omega : b ≤ N) hq_N
        have heq : ψ q = y - (y - ψ q) := by ring
        rw [heq]
        exact Ideal.sub_mem _ hy_in hsub
      have hq_b1 : q ∉ I₀ ^ (b + 1) := by
        rw [← hComap_ψ (b + 1)]
        intro hmem
        apply hy_not
        have hsub : y - ψ q ∈ m_S ^ (b + 1) :=
          Ideal.pow_le_pow_right (by omega : b + 1 ≤ N) hq_N
        have heq : y = (y - ψ q) + ψ q := by ring
        rw [heq]
        exact Ideal.add_mem _ hsub hmem
      have hpq_not : p * q ∉ I₀ ^ N := hInitForm k a b p q hp_a hp_a1 hq_b hq_b1
      rw [← hComap_ψ N] at hpq_not
      apply hpq_not
      change ψ (p * q) ∈ m_S ^ N
      have hdiff : x * y - ψ (p * q) ∈ m_S ^ N := by
        have heq : x * y - ψ (p * q) = (x - ψ p) * y + ψ p * (y - ψ q) := by
          rw [map_mul]; ring
        rw [heq]
        exact Ideal.add_mem _ (Ideal.mul_mem_right y _ hp_N) (Ideal.mul_mem_left _ (ψ p) hq_N)
      rw [hxy, zero_sub] at hdiff
      exact (Ideal.neg_mem_iff _).mp hdiff⟩
    exact ⟨NoZeroDivisors.to_isDomain S_m, hNoethS⟩

  
  have hAwayDom : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B]
      (p : Ideal B) [p.IsPrime],
      (∀ (m : Ideal B) [m.IsMaximal], IsDomain (Localization.AtPrime m)) →
      ∃ f₀ : B, f₀ ∉ p ∧ IsDomain (Localization.Away f₀) := by
    intro B _ _ p hp_prime hMax
    obtain ⟨m, hm_max, hp_le_m⟩ := Ideal.exists_le_maximal p hp_prime.ne_top
    letI : m.IsMaximal := hm_max
    let S_loc := Localization.AtPrime m
    haveI : IsDomain S_loc := hMax m
    let K : Ideal B := RingHom.ker (algebraMap B S_loc)
    obtain ⟨S_fin, hS_span⟩ := Ideal.fg_of_isNoetherianRing K
    have hAnn : ∀ b : B, b ∈ K → ∃ t : m.primeCompl, t.1 * b = 0 := fun b hb =>
      (IsLocalization.map_eq_zero_iff m.primeCompl S_loc b).mp hb
    let t_fn : B → m.primeCompl := fun b =>
      if hb : b ∈ K then Classical.choose (hAnn b hb) else 1
    let f_sub : m.primeCompl := ∏ b ∈ S_fin, t_fn b
    let f₀ : B := f_sub.1
    have hf₀_p : f₀ ∉ p := fun hfp => f_sub.2 (hp_le_m hfp)
    let Ann_f₀ : Ideal B :=
      { carrier := {x : B | f₀ * x = 0}
        zero_mem' := mul_zero f₀
        add_mem' := fun {x₁ x₂} hx₁ hx₂ => by dsimp at *; rw [mul_add, hx₁, hx₂, add_zero]
        smul_mem' := fun c {x} hx => by
          dsimp at *
          rw [← mul_assoc, mul_comm f₀ c, mul_assoc, hx, mul_zero] }
    have hK_le_Ann : K ≤ Ann_f₀ := by
      rw [← hS_span, Ideal.span_le]
      intro b hb_mem
      have hb_K : b ∈ K := hS_span ▸ Ideal.subset_span hb_mem
      have ht_b : (t_fn b).1 * b = 0 := by
        dsimp [t_fn]
        rw [dif_pos hb_K]
        exact Classical.choose_spec (hAnn b hb_K)
      have hf₀_val : f₀ = ∏ x ∈ S_fin, (t_fn x).1 :=
        Submonoid.coe_finset_prod m.primeCompl t_fn S_fin
      obtain ⟨q_b, hq_b⟩ := Finset.dvd_prod_of_mem (fun x => (t_fn x).1) hb_mem
      change f₀ * b = 0
      rw [hf₀_val, hq_b, mul_comm ((t_fn b).1) q_b, mul_assoc, ht_b, mul_zero]
    have hu_f₀ : IsUnit (algebraMap B S_loc f₀) := IsLocalization.map_units S_loc f_sub
    let θ : Localization.Away f₀ →+* S_loc := IsLocalization.Away.lift f₀ hu_f₀
    have hθ_inj : Function.Injective θ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨n, a, hza⟩ := IsLocalization.Away.surj f₀ z
      have ha_zero : algebraMap B S_loc a = 0 := by
        rw [← IsLocalization.Away.lift_eq (S := Localization.Away f₀) f₀ hu_f₀ a]
        change θ (algebraMap B (Localization.Away f₀) a) = 0
        rw [← hza, map_mul, hz, zero_mul]
      have hf₀a : f₀ * a = 0 := hK_le_Ann ha_zero
      have hza1 : z * (algebraMap B (Localization.Away f₀) f₀) ^ (n + 1) = 0 := by
        rw [pow_succ, ← mul_assoc, hza, ← map_mul, mul_comm a f₀, hf₀a, map_zero]
      have hu_pow : IsUnit ((algebraMap B (Localization.Away f₀) f₀) ^ (n + 1)) :=
        (IsLocalization.Away.algebraMap_isUnit f₀).pow (n + 1)
      exact hu_pow.mul_left_eq_zero.mp hza1
    exact ⟨f₀, hf₀_p, Function.Injective.isDomain θ hθ_inj⟩

  
  have hAffShrink : ∀ (k : ℕ) (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine X]
      (u : Quiver.Hom X (weilAffineSpaceOver F k).left) [AlgebraicGeometry.Etale u]
      (x : ↥X),
      ∃ U : X.Opens,
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧ AlgebraicGeometry.IsIntegral U.toScheme := by
    intro k X _ u _ x
    have hTop : AlgebraicGeometry.IsAffineOpen (⊤ : X.Opens) :=
      AlgebraicGeometry.isAffineOpen_top X
    let B_cat := X.presheaf.obj (Opposite.op (⊤ : X.Opens))
    let g_X : AlgebraicGeometry.Spec B_cat ⟶ (weilAffineSpaceOver F k).left :=
      hTop.fromSpec ≫ u
    have hEt_gX : AlgebraicGeometry.Etale g_X := by
      change AlgebraicGeometry.Etale (hTop.fromSpec ≫ u)
      infer_instance
    let φ_X : CommRingCat.of (MvPolynomial (Fin k) F) ⟶ B_cat :=
      AlgebraicGeometry.Spec.preimage g_X
    have hφX_spec : AlgebraicGeometry.Spec.map φ_X = g_X :=
      AlgebraicGeometry.Spec.map_preimage g_X
    have hφX_et : φ_X.hom.Etale := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
        hφX_spec]
      exact hEt_gX
    have hNoethB : IsNoetherianRing ↑B_cat := by
      letI : Algebra (MvPolynomial (Fin k) F) ↑B_cat := φ_X.hom.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin k) F) ↑B_cat := hφX_et.toAlgebra
      letI : Algebra F ↑B_cat := (φ_X.hom.comp MvPolynomial.C).toAlgebra
      haveI : IsScalarTower F (MvPolynomial (Fin k) F) ↑B_cat :=
        IsScalarTower.of_algebraMap_eq' rfl
      haveI : Algebra.FiniteType F (MvPolynomial (Fin k) F) := inferInstance
      haveI : Algebra.FiniteType (MvPolynomial (Fin k) F) ↑B_cat := inferInstance
      haveI : Algebra.FiniteType F ↑B_cat :=
        Algebra.FiniteType.trans
          ‹Algebra.FiniteType F (MvPolynomial (Fin k) F)›
          ‹Algebra.FiniteType (MvPolynomial (Fin k) F) ↑B_cat›
      exact Algebra.FiniteType.isNoetherianRing F ↑B_cat
    haveI : IsNoetherianRing ↑B_cat := hNoethB
    let px := hTop.primeIdealOf ⟨x, trivial⟩
    obtain ⟨f₀, hf₀_px, hDomAway⟩ :=
      hAwayDom (↑B_cat) px.asIdeal (fun m _ => (hMaxDom k (↑B_cat) φ_X.hom hφX_et m).1)
    let U : X.Opens := X.basicOpen f₀
    have hAff_U : AlgebraicGeometry.IsAffineOpen U := hTop.basicOpen f₀
    have hx_U : x ∈ U := by
      have hfrom : hTop.fromSpec.base px = x := hTop.fromSpec_primeIdealOf ⟨x, trivial⟩
      rw [← hfrom]
      have hmem_pre : px ∈ (PrimeSpectrum.basicOpen f₀).carrier :=
        (PrimeSpectrum.mem_basicOpen f₀ px).mpr hf₀_px
      change px ∈ ((TopologicalSpace.Opens.map hTop.fromSpec.base).obj (X.basicOpen f₀)).carrier
      rwa [congrArg TopologicalSpace.Opens.carrier (hTop.fromSpec_preimage_basicOpen f₀)]
    haveI : IsLocalization.Away f₀ ↑(X.presheaf.obj (Opposite.op U)) :=
      hTop.isLocalization_basicOpen f₀
    letI : Algebra ↑B_cat ↑(X.presheaf.obj (Opposite.op U)) :=
      (X.presheaf.map (CategoryTheory.homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
    let e_loc : ↑(X.presheaf.obj (Opposite.op U)) ≃ₐ[↑B_cat] Localization.Away f₀ :=
      IsLocalization.algEquiv (Submonoid.powers f₀)
        ↑(X.presheaf.obj (Opposite.op U)) (Localization.Away f₀)
    haveI : IsDomain ↑(X.presheaf.obj (Opposite.op U)) :=
      Function.Injective.isDomain e_loc.toRingHom e_loc.injective
    haveI : Nonempty ↥U.toScheme := ⟨⟨x, hx_U⟩⟩
    have hInt_U : AlgebraicGeometry.IsIntegral U.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion hAff_U.isoSpec.hom
    exact ⟨U, hAff_U, hx_U, hInt_U⟩

  
  have hSmChart : ∀ (d n : ℕ) (B Y : AlgebraicGeometry.Scheme.{u})
      (u_B : Quiver.Hom B (weilAffineSpaceOver F d).left) [AlgebraicGeometry.Etale u_B]
      (f : Quiver.Hom Y B) [AlgebraicGeometry.SmoothOfRelativeDimension n f]
      (y : ↥Y),
      ∃ (V : Y.Opens) (u_V : Quiver.Hom V.toScheme (weilAffineSpaceOver F (n + d)).left),
        AlgebraicGeometry.IsAffineOpen V ∧ y ∈ V ∧ AlgebraicGeometry.Etale u_V := by
    intro d n B Y u_B _ f hSm y
    obtain ⟨U_B, hAff_UB, V, hAff_V, hy_V, he, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff n f).mp hSm y
    obtain ⟨ψ₁, _, hψ₁_et⟩ := hStd.exists_etale_mvPolynomial
    let g_B : AlgebraicGeometry.Spec (B.presheaf.obj (Opposite.op U_B)) ⟶
        (weilAffineSpaceOver F d).left :=
      hAff_UB.fromSpec ≫ u_B
    have hEt_gB : AlgebraicGeometry.Etale g_B := by
      change AlgebraicGeometry.Etale (hAff_UB.fromSpec ≫ u_B)
      infer_instance
    let φ_B : CommRingCat.of (MvPolynomial (Fin d) F) ⟶ B.presheaf.obj (Opposite.op U_B) :=
      AlgebraicGeometry.Spec.preimage g_B
    have hφB_spec : AlgebraicGeometry.Spec.map φ_B = g_B :=
      AlgebraicGeometry.Spec.map_preimage g_B
    have hφB_et : φ_B.hom.Etale := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
        hφB_spec]
      exact hEt_gB
    letI : Algebra (MvPolynomial (Fin d) F) ↑(B.presheaf.obj (Opposite.op U_B)) :=
      φ_B.hom.toAlgebra
    let p_left := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin d) F)
        (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))))
    let p_right := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin d) F)
        ↑(B.presheaf.obj (Opposite.op U_B))))
    haveI : AlgebraicGeometry.Etale p_right :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφB_et
    haveI : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst p_left p_right) :=
      inferInstance
    let e₁ : MvPolynomial (Fin (n + d)) F ≃+* MvPolynomial (Fin n ⊕ Fin d) F :=
      (MvPolynomial.renameEquiv F finSumFinEquiv.symm).toRingEquiv
    let e₂ : MvPolynomial (Fin n ⊕ Fin d) F ≃+*
        MvPolynomial (Fin n) (MvPolynomial (Fin d) F) :=
      (MvPolynomial.sumAlgEquiv F (Fin n) (Fin d)).toRingEquiv
    let e₁₂ : MvPolynomial (Fin (n + d)) F ≃+*
        MvPolynomial (Fin n) (MvPolynomial (Fin d) F) :=
      e₁.trans e₂
    let f₁₂_fwd : CommRingCat.of (MvPolynomial (Fin (n + d)) F) ⟶
        CommRingCat.of (MvPolynomial (Fin n) (MvPolynomial (Fin d) F)) :=
      CommRingCat.ofHom e₁₂.toRingHom
    let f₁₂_bwd : CommRingCat.of (MvPolynomial (Fin n) (MvPolynomial (Fin d) F)) ⟶
        CommRingCat.of (MvPolynomial (Fin (n + d)) F) :=
      CommRingCat.ofHom e₁₂.symm.toRingHom
    haveI : CategoryTheory.IsIso f₁₂_fwd :=
      ⟨⟨f₁₂_bwd,
        CommRingCat.hom_ext (RingHom.ext e₁₂.symm_apply_apply),
        CommRingCat.hom_ext (RingHom.ext e₁₂.apply_symm_apply)⟩⟩
    haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f₁₂_fwd) := inferInstance
    let e₃ : TensorProduct (MvPolynomial (Fin d) F)
        (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))
        ↑(B.presheaf.obj (Opposite.op U_B)) ≃+*
        TensorProduct (MvPolynomial (Fin d) F)
          ↑(B.presheaf.obj (Opposite.op U_B))
          (MvPolynomial (Fin n) (MvPolynomial (Fin d) F)) :=
      (Algebra.TensorProduct.comm
        (MvPolynomial (Fin d) F)
        (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))
        ↑(B.presheaf.obj (Opposite.op U_B))).toRingEquiv
    let e₄ : TensorProduct (MvPolynomial (Fin d) F)
        ↑(B.presheaf.obj (Opposite.op U_B))
        (MvPolynomial (Fin n) (MvPolynomial (Fin d) F)) ≃+*
        MvPolynomial (Fin n) ↑(B.presheaf.obj (Opposite.op U_B)) :=
      (MvPolynomial.scalarRTensorAlgEquiv
        (R := MvPolynomial (Fin d) F)
        (N := ↑(B.presheaf.obj (Opposite.op U_B)))
        (σ := Fin n)).toRingEquiv
    let e₃₄ : TensorProduct (MvPolynomial (Fin d) F)
        (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))
        ↑(B.presheaf.obj (Opposite.op U_B)) ≃+*
        MvPolynomial (Fin n) ↑(B.presheaf.obj (Opposite.op U_B)) :=
      e₃.trans e₄
    let f₃₄_fwd : CommRingCat.of
        (TensorProduct (MvPolynomial (Fin d) F)
          (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))
          ↑(B.presheaf.obj (Opposite.op U_B))) ⟶
        CommRingCat.of (MvPolynomial (Fin n) ↑(B.presheaf.obj (Opposite.op U_B))) :=
      CommRingCat.ofHom e₃₄.toRingHom
    let f₃₄_bwd : CommRingCat.of (MvPolynomial (Fin n) ↑(B.presheaf.obj (Opposite.op U_B))) ⟶
        CommRingCat.of
          (TensorProduct (MvPolynomial (Fin d) F)
            (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))
            ↑(B.presheaf.obj (Opposite.op U_B))) :=
      CommRingCat.ofHom e₃₄.symm.toRingHom
    haveI : CategoryTheory.IsIso f₃₄_fwd :=
      ⟨⟨f₃₄_bwd,
        CommRingCat.hom_ext (RingHom.ext e₃₄.symm_apply_apply),
        CommRingCat.hom_ext (RingHom.ext e₃₄.apply_symm_apply)⟩⟩
    haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f₃₄_fwd) := inferInstance
    haveI : AlgebraicGeometry.Etale hAff_V.isoSpec.hom := inferInstance
    haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ₁_et
    haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f₃₄_fwd) := inferInstance
    let m₄ := (AlgebraicGeometry.pullbackSpecIso
      (MvPolynomial (Fin d) F)
      (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))
      ↑(B.presheaf.obj (Opposite.op U_B))).inv
    haveI : AlgebraicGeometry.Etale m₄ := inferInstance
    let m₅ := CategoryTheory.Limits.pullback.fst p_left p_right
    haveI : AlgebraicGeometry.Etale m₅ := inferInstance
    have hEt_6 : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f₁₂_fwd) := inferInstance
    let m₆ : AlgebraicGeometry.Spec
        (CommRingCat.of (MvPolynomial (Fin n) (MvPolynomial (Fin d) F))) ⟶
        (weilAffineSpaceOver F (n + d)).left :=
      AlgebraicGeometry.Spec.map f₁₂_fwd
    haveI : AlgebraicGeometry.Etale m₆ := hEt_6
    let m₅₆ := m₅ ≫ m₆
    haveI : AlgebraicGeometry.Etale m₅₆ := by
      change AlgebraicGeometry.Etale (m₅ ≫ m₆)
      infer_instance
    let m₄₅₆ := m₄ ≫ m₅₆
    haveI : AlgebraicGeometry.Etale m₄₅₆ := by
      change AlgebraicGeometry.Etale (m₄ ≫ m₅₆)
      infer_instance
    let m₃₄₅₆ := AlgebraicGeometry.Spec.map f₃₄_fwd ≫ m₄₅₆
    haveI : AlgebraicGeometry.Etale m₃₄₅₆ := by
      change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f₃₄_fwd ≫ m₄₅₆)
      infer_instance
    let m₂₃₄₅₆ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ m₃₄₅₆
    haveI : AlgebraicGeometry.Etale m₂₃₄₅₆ := by
      change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫ m₃₄₅₆)
      infer_instance
    let u_V : V.toScheme ⟶ (weilAffineSpaceOver F (n + d)).left :=
      hAff_V.isoSpec.hom ≫ m₂₃₄₅₆
    have hEt_uV : AlgebraicGeometry.Etale u_V := by
      change AlgebraicGeometry.Etale (hAff_V.isoSpec.hom ≫ m₂₃₄₅₆)
      infer_instance
    exact ⟨V, u_V, hAff_V, hy_V, hEt_uV⟩

  
  have hConnGlob : ∀ (Y : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥Y],
      (∀ y : ↥Y, ∃ W : Y.Opens, y ∈ W ∧ AlgebraicGeometry.IsIntegral W.toScheme) →
      IrreducibleSpace ↥Y ∧ AlgebraicGeometry.IsIntegral Y := by
    intro Y hConn hLoc
    let W_of : ↥Y → Y.Opens := fun y => Classical.choose (hLoc y)
    have hW_mem : ∀ y : ↥Y, y ∈ W_of y := fun y => (Classical.choose_spec (hLoc y)).1
    have hW_int : ∀ y : ↥Y, AlgebraicGeometry.IsIntegral (W_of y).toScheme :=
      fun y => (Classical.choose_spec (hLoc y)).2
    have hW_pre : ∀ y : ↥Y, IsPreirreducible ((W_of y : Y.Opens) : Set ↥Y) := by
      intro y
      letI := hW_int y
      have hIrredW : IrreducibleSpace ↥(W_of y).toScheme :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral (W_of y).toScheme
      have hpre_univ : IsPreirreducible (Set.univ : Set ↥(W_of y).toScheme) :=
        hIrredW.isIrreducible_univ.isPreirreducible
      have himg : (W_of y).ι.base '' (Set.univ : Set ↥(W_of y).toScheme) =
          ((W_of y : Y.Opens) : Set ↥Y) := by
        rw [Set.image_univ, AlgebraicGeometry.Scheme.Opens.range_ι]
      rw [← himg]
      exact hpre_univ.image (W_of y).ι.base (W_of y).ι.continuous.continuousOn
    have hIrred : IrreducibleSpace ↥Y := by
      refine @IrreducibleSpace.mk ↥Y _ ⟨fun U₁ U₂ hU₁ hU₂ hne₁ hne₂ => ?_⟩ hConn.toNonempty
      obtain ⟨u₁, _, hu₁⟩ := hne₁
      obtain ⟨u₂, _, hu₂⟩ := hne₂
      let C : Set ↥Y :=
        {z : ↥Y | ∃ O : Set ↥Y, IsOpen O ∧ z ∈ O ∧ IsPreirreducible O ∧ (O ∩ U₁).Nonempty}
      have hC_open : IsOpen C := by
        rw [isOpen_iff_forall_mem_open]
        rintro z ⟨O, hO_open, hz_O, hO_pre, hO_U₁⟩
        exact ⟨O, fun z' hz' => ⟨O, hO_open, hz', hO_pre, hO_U₁⟩, hO_open, hz_O⟩
      have hC_closed : IsClosed C := by
        rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
        intro z hz_not
        refine ⟨((W_of z : Y.Opens) : Set ↥Y), ?_, (W_of z).isOpen, hW_mem z⟩
        intro w hw_Wz hw_C
        obtain ⟨O_w, hOw_open, hw_Ow, hOw_pre, hOw_U₁⟩ := hw_C
        obtain ⟨q, _, hq_Wz, hq_U₁⟩ :=
          hOw_pre ((W_of z : Y.Opens) : Set ↥Y) U₁ (W_of z).isOpen hU₁
            ⟨w, hw_Ow, hw_Wz⟩ hOw_U₁
        exact hz_not ⟨((W_of z : Y.Opens) : Set ↥Y), (W_of z).isOpen, hW_mem z,
          hW_pre z, ⟨q, hq_Wz, hq_U₁⟩⟩
      have hC_ne : C.Nonempty :=
        ⟨u₁, ((W_of u₁ : Y.Opens) : Set ↥Y), (W_of u₁).isOpen, hW_mem u₁,
          hW_pre u₁, ⟨u₁, hW_mem u₁, hu₁⟩⟩
      have hC_univ : C = Set.univ := IsClopen.eq_univ ⟨hC_closed, hC_open⟩ hC_ne
      have hu₂_C : u₂ ∈ C := by rw [hC_univ]; trivial
      obtain ⟨O₂, _, hu₂_O₂, hO₂_pre, hO₂_U₁⟩ := hu₂_C
      obtain ⟨q, _, hq_U₁, hq_U₂⟩ :=
        hO₂_pre U₁ U₂ hU₁ hU₂ hO₂_U₁ ⟨u₂, hu₂_O₂, hu₂⟩
      exact ⟨q, trivial, hq_U₁, hq_U₂⟩
    haveI : IrreducibleSpace ↥Y := hIrred
    have hStalkRed : ∀ y : ↥Y, IsReduced ↑(Y.presheaf.stalk y) := by
      intro y
      letI := hW_int y
      let y_W : ↥(W_of y).toScheme := ⟨y, hW_mem y⟩
      haveI : IsReduced ↑((W_of y).toScheme.presheaf.stalk y_W) :=
        AlgebraicGeometry.isReduced_stalk_of_isReduced (W_of y).toScheme y_W
      let sm := AlgebraicGeometry.Scheme.Hom.stalkMap (W_of y).ι y_W
      haveI : CategoryTheory.IsIso sm := inferInstance
      let e_stalk : ↑(Y.presheaf.stalk ((W_of y).ι.base y_W)) ≃+*
          ↑((W_of y).toScheme.presheaf.stalk y_W) :=
        (CategoryTheory.asIso sm).commRingCatIsoToRingEquiv
      have hRed' : IsReduced ↑(Y.presheaf.stalk ((W_of y).ι.base y_W)) :=
        isReduced_of_injective e_stalk.toRingHom e_stalk.injective
      have hy_eq : (W_of y).ι.base y_W = y :=
        AlgebraicGeometry.Scheme.Opens.ι_apply (W_of y) y_W
      rwa [hy_eq] at hRed'
    haveI : AlgebraicGeometry.IsReduced Y :=
      @AlgebraicGeometry.isReduced_of_isReduced_stalk Y hStalkRed
    exact ⟨hIrred, AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y⟩

  
  refine ⟨?_, ?_⟩
  · intro d X _ u _ x _
    exact hAffShrink d X u x
  · intro d n B Y u_B _ f _ hConn
    letI : ConnectedSpace ↥Y := hConn
    refine hConnGlob Y (fun y => ?_)
    obtain ⟨V_y, u_Vy, hAff_Vy, hy_Vy, hEt_uVy⟩ := hSmChart d n B Y u_B f y
    haveI : AlgebraicGeometry.IsAffine V_y.toScheme := hAff_Vy
    haveI : AlgebraicGeometry.Etale u_Vy := hEt_uVy
    obtain ⟨U_y, _, hy_Uy, hInt_Uy⟩ := hAffShrink (n + d) V_y.toScheme u_Vy ⟨y, hy_Vy⟩
    letI : AlgebraicGeometry.IsIntegral U_y.toScheme := hInt_Uy
    let j_y : U_y.toScheme ⟶ Y := U_y.ι ≫ V_y.ι
    haveI : AlgebraicGeometry.IsOpenImmersion j_y := inferInstance
    let W_y : Y.Opens := j_y.opensRange
    have hy_Wy : y ∈ W_y := ⟨⟨⟨y, hy_Vy⟩, hy_Uy⟩, rfl⟩
    haveI : Nonempty ↥W_y.toScheme := ⟨⟨y, hy_Wy⟩⟩
    have hInt_Wy : AlgebraicGeometry.IsIntegral W_y.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion j_y.isoOpensRange.inv
    exact ⟨W_y, hy_Wy, hInt_Wy⟩

theorem weil_alt_finite_etale_sheet_split_of_connected {W₀ U₀ : AlgebraicGeometry.Scheme.{u}}
    [ConnectedSpace ↥U₀] [Nonempty ↥U₀]
    (f : Quiver.Hom W₀ U₀)
    [AlgebraicGeometry.IsFinite f]
    [AlgebraicGeometry.Etale f]
    [AlgebraicGeometry.Surjective f] :
    ∃ δ : ℕ, 1 ≤ δ ∧ WeilAltIsEtaleSheetSplit δ f :=
by
  let specIsoOfRingEquiv : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (e : R₁ ≃+* R₂),
      AlgebraicGeometry.Spec (CommRingCat.of R₁) ≅ AlgebraicGeometry.Spec (CommRingCat.of R₂) :=
    fun e =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h : CommRingCat.ofHom e.toRingHom ≫ CommRingCat.ofHom e.symm.toRingHom = 𝟙 _ := by
            ext x; exact e.symm_apply_apply x
          rw [h, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp]
          have h : CommRingCat.ofHom e.symm.toRingHom ≫ CommRingCat.ofHom e.toRingHom = 𝟙 _ := by
            ext x; exact e.apply_symm_apply x
          rw [h, AlgebraicGeometry.Spec.map_id] }
  have specIso_hom : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (e : R₁ ≃+* R₂),
      (specIsoOfRingEquiv e).hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom) :=
    fun _ => rfl
  have specIso_inv : ∀ {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (e : R₁ ≃+* R₂),
      (specIsoOfRingEquiv e).inv = AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom) :=
    fun _ => rfl

  have hSelfSplit : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S]
      [Module.Finite R S] [Algebra.Etale R S],
      ∃ (Q : Type u) (_ : CommRing Q) (_ : Algebra S Q),
        Module.Finite S Q ∧ Algebra.Etale S Q ∧
        Nonempty (TensorProduct R S S ≃ₐ[S] S × Q) ∧
        ∀ q : PrimeSpectrum S,
          1 + Module.rankAtStalk Q q =
            Module.rankAtStalk S (PrimeSpectrum.comap (algebraMap R S) q) := by
    intro R S _ _ _ _ _
    let S' := TensorProduct R S S
    have : Module.Finite S S' := Module.Finite.base_change R S S
    have : Algebra.Etale S S' := Algebra.Etale.baseChange R S S
    let μ : S' →ₐ[S] S :=
      { (Algebra.TensorProduct.lmul' R (S := S)).toRingHom with
        commutes' := fun s => by
          change Algebra.TensorProduct.lmul' R (S := S) (s ⊗ₜ[R] (1 : S)) = s
          simp }
    have hμ_surj : Function.Surjective μ := fun s =>
      ⟨s ⊗ₜ[R] (1 : S), by
        change Algebra.TensorProduct.lmul' R (S := S) (s ⊗ₜ[R] (1 : S)) = s
        simp⟩
    let I : Ideal S' := KaehlerDifferential.ideal R S
    have hker : RingHom.ker μ.toRingHom = I := rfl
    have hker' : RingHom.ker μ = I := rfl
    have hFG : I.FG := by
      rw [← hker]
      exact Algebra.FinitePresentation.ker_fG_of_surjective μ hμ_surj
    have hSubCot : Subsingleton I.Cotangent :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    have hIdemI : IsIdempotentElem I := by
      change I * I = I
      rw [← sq]
      apply le_antisymm (Ideal.pow_le_self two_ne_zero)
      intro x hx
      exact (Ideal.mem_toCotangent_ker I (x := ⟨x, hx⟩)).mp
        (Subsingleton.elim (I.toCotangent ⟨x, hx⟩) 0)
    obtain ⟨e, he, hI_eq⟩ := (Ideal.isIdempotentElem_iff_of_fg I hFG).mp hIdemI
    let f_e : S' := 1 - e
    have hf_e : IsIdempotentElem f_e := he.one_sub
    have hef_add : e + f_e = 1 := add_sub_cancel e 1
    have hef_mul : e * f_e = 0 := by rw [mul_sub, mul_one, he.eq, sub_self]
    let Q := S' ⧸ Ideal.span ({f_e} : Set S')
    have hspan_eq_ker : Ideal.span ({e} : Set S') = RingHom.ker μ := by
      rw [hker', hI_eq]
    have e_quotI : (S' ⧸ Ideal.span ({e} : Set S')) ≃ₐ[S] S :=
      (Ideal.quotientEquivAlgOfEq S hspan_eq_ker).trans
        (Ideal.quotientKerAlgEquivOfSurjective hμ_surj)
    let e_split : S' ≃ₐ[S] S × Q :=
      (AlgEquiv.prodQuotientOfIsIdempotentElem S he hf_e hef_add hef_mul).trans
        (e_quotI.prodCongr AlgEquiv.refl)
    have hFinQ : Module.Finite S Q :=
      Module.Finite.of_surjective
        (Ideal.Quotient.mkₐ S (Ideal.span ({f_e} : Set S'))).toLinearMap
        Ideal.Quotient.mk_surjective
    have hFP_Q : Algebra.FinitePresentation S Q :=
      Algebra.FinitePresentation.of_surjective
        (f := Ideal.Quotient.mkₐ S (Ideal.span ({f_e} : Set S')))
        Ideal.Quotient.mk_surjective
        (by
          have hmk : RingHom.ker (Ideal.Quotient.mkₐ S (Ideal.span ({f_e} : Set S'))).toRingHom =
              Ideal.span ({f_e} : Set S') := Ideal.mk_ker
          rw [hmk]
          exact Submodule.fg_span_singleton f_e)
    let F_bool : Bool → Type u := fun b => if b then S else Q
    let : ∀ b : Bool, CommRing (F_bool b) := fun b => by
      cases b <;> dsimp [F_bool] <;> infer_instance
    let : ∀ b : Bool, Algebra S (F_bool b) := fun b => by
      cases b <;> dsimp [F_bool] <;> infer_instance
    let e_bool : (S × Q) ≃ₐ[S] (∀ b : Bool, F_bool b) :=
      { toFun := fun p b => match b with | true => p.1 | false => p.2
        invFun := fun g => (g true, g false)
        left_inv := fun ⟨_, _⟩ => rfl
        right_inv := fun g => funext fun b => by cases b <;> rfl
        map_mul' := fun _ _ => funext fun b => by cases b <;> rfl
        map_add' := fun _ _ => funext fun b => by cases b <;> rfl
        commutes' := fun _ => funext fun b => by cases b <;> rfl }
    have hFE_prod : Algebra.FormallyEtale S (S × Q) :=
      (Algebra.FormallyEtale.iff_of_equiv e_split).mp inferInstance
    have hFE_pi : Algebra.FormallyEtale S (∀ b : Bool, F_bool b) :=
      (Algebra.FormallyEtale.iff_of_equiv e_bool).mp hFE_prod
    have hFE_Q : Algebra.FormallyEtale S Q :=
      (Algebra.FormallyEtale.pi_iff F_bool).mp hFE_pi false
    have hEtQ : Algebra.Etale S Q := @Algebra.Etale.mk S Q _ _ _ hFE_Q hFP_Q
    have : Module.Finite S Q := hFinQ
    have : Algebra.Etale S Q := hEtQ
    refine ⟨Q, inferInstance, inferInstance, hFinQ, hEtQ, ⟨e_split⟩, fun q => ?_⟩
    have : Nontrivial S := PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨q⟩
    have h1 : Module.rankAtStalk S (PrimeSpectrum.comap (algebraMap R S) q) =
        Module.rankAtStalk S' q := by
      simpa using (Module.rankAtStalk_baseChange (R := R) (S := S) (M := S) q).symm
    have h2 : Module.rankAtStalk S' q = Module.rankAtStalk (S × Q) q :=
      congrFun (Module.rankAtStalk_eq_of_equiv e_split.toLinearEquiv) q
    have h3 : Module.rankAtStalk (S × Q) q =
        Module.rankAtStalk S q + Module.rankAtStalk Q q :=
      congrFun (Module.rankAtStalk_prod S Q) q
    have h4 : Module.rankAtStalk S q = 1 :=
      congrFun (Module.rankAtStalk_self (R := S)) q
    omega

  have hPiTriv : ∀ (δ : ℕ) (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
      [Module.Finite A B] [Algebra.Etale A B],
      (∀ p : PrimeSpectrum A, Module.rankAtStalk B p = δ) →
      ∀ p₀ : PrimeSpectrum A,
        ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C),
          Algebra.Etale A C ∧
          (∃ q₀ : PrimeSpectrum C, PrimeSpectrum.comap (algebraMap A C) q₀ = p₀) ∧
          Nonempty (TensorProduct A C B ≃ₐ[C] (Fin δ → C)) := by
    intro δ
    induction δ with
    | zero =>
      intro A B _ _ _ _ _ hRank p₀
      have : Module.FinitePresentation A B :=
        Module.FinitePresentation.of_finite_of_finitePresentation A B
      have hRankZero : Module.rankAtStalk (R := A) B = 0 := funext hRank
      have : Subsingleton B :=
        (Module.rankAtStalk_eq_zero_iff_subsingleton (R := A) (M := B)).mp hRankZero
      have : Subsingleton (TensorProduct A A B) :=
        (Algebra.TensorProduct.lid A B).toEquiv.subsingleton
      let e₀ : TensorProduct A A B ≃ₐ[A] (Fin 0 → A) :=
        { toFun := fun _ => 0
          invFun := fun _ => 0
          left_inv := fun _ => Subsingleton.elim _ _
          right_inv := fun _ => Subsingleton.elim _ _
          map_mul' := fun _ _ => Subsingleton.elim _ _
          map_add' := fun _ _ => Subsingleton.elim _ _
          commutes' := fun _ => Subsingleton.elim _ _ }
      exact ⟨A, inferInstance, inferInstance, inferInstance, ⟨p₀, rfl⟩, ⟨e₀⟩⟩
    | succ r ih =>
      intro A B _ _ _ _ _ hRank p₀
      let K := p₀.asIdeal.ResidueField
      have hp₀_comap : PrimeSpectrum.comap (algebraMap A K) ⊥ = p₀ := by
        ext1
        exact Ideal.ker_algebraMap_residueField p₀.asIdeal
      have : Module.Finite K (TensorProduct A K B) := Module.Finite.base_change A K B
      have : Algebra.Etale K (TensorProduct A K B) := Algebra.Etale.baseChange A B K
      have : Module.FinitePresentation K (TensorProduct A K B) :=
        Module.FinitePresentation.of_finite_of_finitePresentation K (TensorProduct A K B)
      have hRkK : Module.rankAtStalk (R := K) (TensorProduct A K B) ⊥ = r + 1 := by
        have hb := Module.rankAtStalk_baseChange (R := A) (S := K) (M := B) (⊥ : PrimeSpectrum K)
        rw [hp₀_comap, hRank p₀] at hb
        exact hb
      have hNotSub : ¬ Subsingleton (TensorProduct A K B) := by
        intro hSub
        have h0 : Module.rankAtStalk (R := K) (TensorProduct A K B) = 0 :=
          (Module.rankAtStalk_eq_zero_iff_subsingleton (R := K) (M := TensorProduct A K B)).mpr hSub
        have h0_bot : Module.rankAtStalk (R := K) (TensorProduct A K B) ⊥ = 0 := congrFun h0 ⊥
        omega
      have : Nontrivial (TensorProduct A K B) := not_subsingleton_iff_nontrivial.mp hNotSub
      obtain ⟨𝔮⟩ := PrimeSpectrum.nonempty_iff_nontrivial.mpr (inferInstance : Nontrivial (TensorProduct A K B))
      let q_B : PrimeSpectrum B :=
        PrimeSpectrum.comap (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).toRingHom 𝔮
      have hq_B : PrimeSpectrum.comap (algebraMap A B) q_B = p₀ := by
        have hcomp :
            ((Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).toRingHom).comp
              (algebraMap A B) =
            (algebraMap K (TensorProduct A K B)).comp (algebraMap A K) := by
          ext a
          exact (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).commutes a
        change PrimeSpectrum.comap
          (((Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A K B).toRingHom).comp
            (algebraMap A B)) 𝔮 = p₀
        rw [hcomp]
        change PrimeSpectrum.comap (algebraMap A K)
          (PrimeSpectrum.comap (algebraMap K (TensorProduct A K B)) 𝔮) = p₀
        have hbot : PrimeSpectrum.comap (algebraMap K (TensorProduct A K B)) 𝔮 = ⊥ :=
          Subsingleton.elim _ _
        rw [hbot, hp₀_comap]
      obtain ⟨Q, hCommQ, hAlgBQ, hFinQ, hEtQ, ⟨e_split⟩, hRkQ_step⟩ := hSelfSplit A B
      let : CommRing Q := hCommQ
      let : Algebra B Q := hAlgBQ
      have : Module.Finite B Q := hFinQ
      have : Algebra.Etale B Q := hEtQ
      have hRkQ : ∀ q : PrimeSpectrum B, Module.rankAtStalk Q q = r := by
        intro q
        have hstep := hRkQ_step q
        rw [hRank (PrimeSpectrum.comap (algebraMap A B) q)] at hstep
        omega
      obtain ⟨C, hCommC, hAlgBC, hEtBC, ⟨q₀, hq₀⟩, ⟨e_rest⟩⟩ := ih B Q hRkQ q_B
      let : CommRing C := hCommC
      let : Algebra B C := hAlgBC
      have : Algebra.Etale B C := hEtBC
      let : Algebra A C := RingHom.toAlgebra ((algebraMap B C).comp (algebraMap A B))
      have : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq' rfl
      have hEtAC : Algebra.Etale A C := Algebra.Etale.comp A B C
      have hq₀_A : PrimeSpectrum.comap (algebraMap A C) q₀ = p₀ := by
        change PrimeSpectrum.comap ((algebraMap B C).comp (algebraMap A B)) q₀ = p₀
        change PrimeSpectrum.comap (algebraMap A B) (PrimeSpectrum.comap (algebraMap B C) q₀) = p₀
        rw [hq₀, hq_B]
      let e_bc_split : TensorProduct B C (TensorProduct A B B) ≃ₐ[C] TensorProduct B C (B × Q) :=
        AlgEquiv.ofRingEquiv
          (f := (Algebra.TensorProduct.congr (AlgEquiv.refl : C ≃ₐ[B] C) e_split).toRingEquiv)
          (fun c => by
            change (Algebra.TensorProduct.congr (AlgEquiv.refl : C ≃ₐ[B] C) e_split) (c ⊗ₜ[B] 1) =
              c ⊗ₜ[B] 1
            simp)
      let e_cons : (C × (Fin r → C)) ≃ₐ[C] (Fin (r + 1) → C) :=
        { toFun := fun p => Fin.cons p.1 p.2
          invFun := fun g => (g 0, Fin.tail g)
          left_inv := fun ⟨c, g⟩ => by simp
          right_inv := fun g => by simp
          map_mul' := fun p₁ p₂ => funext (Fin.cases rfl (fun _ => rfl))
          map_add' := fun p₁ p₂ => funext (Fin.cases rfl (fun _ => rfl))
          commutes' := fun c => funext (Fin.cases rfl (fun _ => rfl)) }
      let e_total : TensorProduct A C B ≃ₐ[C] (Fin (r + 1) → C) :=
        (Algebra.TensorProduct.cancelBaseChange A B C C B).symm.trans
          (e_bc_split.trans
            ((Algebra.TensorProduct.prodRight B C C B Q).trans
              (((Algebra.TensorProduct.rid B C C).prodCongr e_rest).trans e_cons)))
      exact ⟨C, hCommC, inferInstance, hEtAC, ⟨q₀, hq₀_A⟩, ⟨e_total⟩⟩

  have hAffPullback : ∀ (U : U₀.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      let W := (TopologicalSpace.Opens.map f.base).obj U
      let hW : AlgebraicGeometry.IsAffineOpen W := hU.preimage f
      CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map (f.app U))
        hW.fromSpec hU.fromSpec f := by
    intro U hU W hW
    apply AlgebraicGeometry.IsOpenImmersion.isPullback
    · rw [f.app_eq_appLE]
      exact (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hU hW le_rfl).symm
    · rw [hU.opensRange_fromSpec, hW.opensRange_fromSpec]

  have hChartLE : ∀ {V U : U₀.Opens} (hV : AlgebraicGeometry.IsAffineOpen V)
      (hU : AlgebraicGeometry.IsAffineOpen U) (hle : V ≤ U) (u : ↥U₀) (hu : u ∈ V),
      letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U))
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U))) :=
          (f.app U).hom.toAlgebra
      letI : Algebra ↑(U₀.presheaf.obj (Opposite.op V))
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj V))) :=
          (f.app V).hom.toAlgebra
      Module.rankAtStalk
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj V)))
        (hV.primeIdealOf ⟨u, hu⟩) =
      Module.rankAtStalk
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U)))
        (hU.primeIdealOf ⟨u, hle hu⟩) := by
    intro V U hV hU hle u hu
    let W_U := (TopologicalSpace.Opens.map f.base).obj U
    let W_V := (TopologicalSpace.Opens.map f.base).obj V
    have hWU : AlgebraicGeometry.IsAffineOpen W_U := hU.preimage f
    have hWV : AlgebraicGeometry.IsAffineOpen W_V := hV.preimage f
    have hleW : W_V ≤ W_U := (TopologicalSpace.Opens.map f.base).monotone hle
    let resU := U₀.presheaf.map (CategoryTheory.homOfLE hle).op
    let resW := W₀.presheaf.map (CategoryTheory.homOfLE hleW).op
    have hmapW : AlgebraicGeometry.Spec.map resW ≫ hWU.fromSpec = hWV.fromSpec :=
      hWU.map_fromSpec hWV (CategoryTheory.homOfLE hleW).op
    have hmapU : AlgebraicGeometry.Spec.map resU ≫ hU.fromSpec = hV.fromSpec :=
      hU.map_fromSpec hV (CategoryTheory.homOfLE hle).op
    have hpU := hAffPullback U hU
    have hpV := hAffPullback V hV
    have hcommLeft :
        AlgebraicGeometry.Spec.map resW ≫ AlgebraicGeometry.Spec.map (f.app U) =
          AlgebraicGeometry.Spec.map (f.app V) ≫ AlgebraicGeometry.Spec.map resU := by
      rw [← cancel_mono hU.fromSpec]
      calc
        AlgebraicGeometry.Spec.map resW ≫ AlgebraicGeometry.Spec.map (f.app U) ≫ hU.fromSpec
            = AlgebraicGeometry.Spec.map resW ≫ hWU.fromSpec ≫ f := by rw [hpU.w]
        _ = (AlgebraicGeometry.Spec.map resW ≫ hWU.fromSpec) ≫ f := (Category.assoc _ _ _).symm
        _ = hWV.fromSpec ≫ f := by rw [hmapW]
        _ = AlgebraicGeometry.Spec.map (f.app V) ≫ hV.fromSpec := hpV.w.symm
        _ = AlgebraicGeometry.Spec.map (f.app V) ≫ AlgebraicGeometry.Spec.map resU ≫ hU.fromSpec := by
            rw [hmapU]
    have hpV' : CategoryTheory.IsPullback (AlgebraicGeometry.Spec.map (f.app V))
        (AlgebraicGeometry.Spec.map resW ≫ hWU.fromSpec)
        (AlgebraicGeometry.Spec.map resU ≫ hU.fromSpec) f := by
      rwa [hmapW, hmapU]
    have hpLeft : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map resW)
        (AlgebraicGeometry.Spec.map (f.app V))
        (AlgebraicGeometry.Spec.map (f.app U))
        (AlgebraicGeometry.Spec.map resU) :=
      (CategoryTheory.IsPullback.of_bot hpV' hcommLeft.symm hpU).flip
    let A_U : Type u := ↑(U₀.presheaf.obj (Opposite.op U))
    let A_V : Type u := ↑(U₀.presheaf.obj (Opposite.op V))
    let B_U : Type u := ↑(W₀.presheaf.obj (Opposite.op W_U))
    let B_V : Type u := ↑(W₀.presheaf.obj (Opposite.op W_V))
    let : Algebra A_U B_U := (f.app U).hom.toAlgebra
    let : Algebra A_V B_V := (f.app V).hom.toAlgebra
    let : Algebra A_U A_V := resU.hom.toAlgebra
    have : Module.Finite A_U B_U := AlgebraicGeometry.IsFinite.finite_app f U hU
    have hEtU : (f.app U).hom.Etale := by
      rw [f.app_eq_appLE]
      exact AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) f inferInstance
        ⟨U, hU⟩ ⟨W_U, hWU⟩ le_rfl
    have : Algebra.Etale A_U B_U := RingHom.etale_algebraMap.mp hEtU
    let e_spec : AlgebraicGeometry.Spec (W₀.presheaf.obj (Opposite.op W_V)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A_U A_V B_U)) :=
      hpLeft.isoPullback ≪≫
        AlgebraicGeometry.pullbackSpecIso A_U B_U A_V ≪≫
        specIsoOfRingEquiv (Algebra.TensorProduct.comm A_U B_U A_V).toRingEquiv
    have he_snd : e_spec.inv ≫ AlgebraicGeometry.Spec.map (f.app V) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A_V (TensorProduct A_U A_V B_U))) := by
      dsimp only [e_spec, Iso.trans_inv]
      rw [specIso_inv, Category.assoc, Category.assoc, CategoryTheory.IsPullback.isoPullback_inv_snd]
      erw [AlgebraicGeometry.pullbackSpecIso_inv_snd A_U B_U A_V]
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
    have he_snd' : AlgebraicGeometry.Spec.map (f.app V) =
        e_spec.hom ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap A_V (TensorProduct A_U A_V B_U))) :=
      (Iso.inv_comp_eq e_spec).mp he_snd
    let e_ring : CommRingCat.of (TensorProduct A_U A_V B_U) ≅ W₀.presheaf.obj (Opposite.op W_V) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct A_U A_V B_U))).symm ≪≫
        AlgebraicGeometry.Scheme.Γ.mapIso e_spec.op ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso (W₀.presheaf.obj (Opposite.op W_V))
    have he_alg : CommRingCat.ofHom (algebraMap A_V (TensorProduct A_U A_V B_U)) ≫ e_ring.hom =
        f.app V := by
      have happ : (AlgebraicGeometry.Spec.map (f.app V)).appTop =
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap A_V (TensorProduct A_U A_V B_U)))).appTop ≫
            e_spec.hom.appTop := by
        rw [he_snd', AlgebraicGeometry.Scheme.Hom.comp_appTop]
      have hnat₁ := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap A_V (TensorProduct A_U A_V B_U)))
      have hnat₂ := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality (f.app V)
      rw [← cancel_mono (AlgebraicGeometry.Scheme.ΓSpecIso (W₀.presheaf.obj (Opposite.op W_V))).inv]
      dsimp only [e_ring, Iso.trans_hom, Iso.symm_hom]
      change (CommRingCat.ofHom (algebraMap A_V (TensorProduct A_U A_V B_U)) ≫
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of (TensorProduct A_U A_V B_U))).inv ≫
            e_spec.hom.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (W₀.presheaf.obj (Opposite.op W_V))).hom)) ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (W₀.presheaf.obj (Opposite.op W_V))).inv =
        f.app V ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (W₀.presheaf.obj (Opposite.op W_V))).inv
      simp only [Category.assoc]
      rw [Iso.hom_inv_id, Category.comp_id, reassoc_of% hnat₁, ← happ]
      exact hnat₂.symm
    let e_lin : TensorProduct A_U A_V B_U ≃ₗ[A_V] B_V :=
      { e_ring.commRingCatIsoToRingEquiv with
        map_smul' := fun a x => by
          simp only [RingHom.id_apply, Algebra.smul_def]
          change e_ring.hom.hom (algebraMap A_V (TensorProduct A_U A_V B_U) a * x) =
            algebraMap A_V B_V a * e_ring.hom.hom x
          rw [map_mul]
          congr 1
          exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom he_alg) a }
    have hp_comap : PrimeSpectrum.comap (algebraMap A_U A_V) (hV.primeIdealOf ⟨u, hu⟩) =
        hU.primeIdealOf ⟨u, hle hu⟩ := by
      apply hU.fromSpec.isOpenEmbedding.injective
      have h1 : hU.fromSpec.base ((AlgebraicGeometry.Spec.map resU).base (hV.primeIdealOf ⟨u, hu⟩)) =
          hV.fromSpec.base (hV.primeIdealOf ⟨u, hu⟩) := by
        change (AlgebraicGeometry.Spec.map resU ≫ hU.fromSpec).base (hV.primeIdealOf ⟨u, hu⟩) = _
        rw [hmapU]
      rw [hV.fromSpec_primeIdealOf ⟨u, hu⟩, ← hU.fromSpec_primeIdealOf ⟨u, hle hu⟩] at h1
      exact h1
    calc
      Module.rankAtStalk B_V (hV.primeIdealOf ⟨u, hu⟩)
          = Module.rankAtStalk (TensorProduct A_U A_V B_U) (hV.primeIdealOf ⟨u, hu⟩) :=
            congrFun (Module.rankAtStalk_eq_of_equiv e_lin.symm) _
      _ = Module.rankAtStalk B_U
            (PrimeSpectrum.comap (algebraMap A_U A_V) (hV.primeIdealOf ⟨u, hu⟩)) :=
            Module.rankAtStalk_baseChange (R := A_U) (S := A_V) (M := B_U) _
      _ = Module.rankAtStalk B_U (hU.primeIdealOf ⟨u, hle hu⟩) := by rw [hp_comap]

  have hChartEq : ∀ {U₁ U₂ : U₀.Opens} (hU₁ : AlgebraicGeometry.IsAffineOpen U₁)
      (hU₂ : AlgebraicGeometry.IsAffineOpen U₂) (u : ↥U₀) (hu₁ : u ∈ U₁) (hu₂ : u ∈ U₂),
      letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U₁))
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U₁))) :=
          (f.app U₁).hom.toAlgebra
      letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U₂))
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U₂))) :=
          (f.app U₂).hom.toAlgebra
      Module.rankAtStalk
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U₁)))
        (hU₁.primeIdealOf ⟨u, hu₁⟩) =
      Module.rankAtStalk
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U₂)))
        (hU₂.primeIdealOf ⟨u, hu₂⟩) := by
    intro U₁ U₂ hU₁ hU₂ u hu₁ hu₂
    obtain ⟨g, hg_le, hg_mem⟩ := hU₁.exists_basicOpen_le (⟨u, hu₂⟩ : ↥U₂) hu₁
    have hV : AlgebraicGeometry.IsAffineOpen (U₀.basicOpen g) := hU₁.basicOpen g
    exact (hChartLE hV hU₁ (U₀.basicOpen_le g) u hg_mem).symm.trans
      (hChartLE hV hU₂ hg_le u hg_mem)

  have hChooseAff : ∀ u : ↥U₀, ∃ U : U₀.Opens, AlgebraicGeometry.IsAffineOpen U ∧ u ∈ U := by
    intro u
    obtain ⟨U, hU, hu, _⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp U₀.isBasis_affineOpens)
        (show u ∈ (⊤ : U₀.Opens) from trivial)
    exact ⟨U, hU, hu⟩

  let rk : ↥U₀ → ℕ := fun u =>
    let U := Classical.choose (hChooseAff u)
    let hU := (Classical.choose_spec (hChooseAff u)).1
    let hu := (Classical.choose_spec (hChooseAff u)).2
    letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U))
      ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U))) :=
        (f.app U).hom.toAlgebra
    Module.rankAtStalk
      ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U)))
      (hU.primeIdealOf ⟨u, hu⟩)

  have hrk_eq : ∀ (U : U₀.Opens) (hU : AlgebraicGeometry.IsAffineOpen U) (u : ↥U₀) (hu : u ∈ U),
      letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U))
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U))) :=
          (f.app U).hom.toAlgebra
      rk u = Module.rankAtStalk
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U)))
        (hU.primeIdealOf ⟨u, hu⟩) := by
    intro U hU u hu
    exact hChartEq (Classical.choose_spec (hChooseAff u)).1 hU u
      (Classical.choose_spec (hChooseAff u)).2 hu

  have hLocConst_rk : IsLocallyConstant rk := by
    rw [IsLocallyConstant.iff_exists_open]
    intro u
    obtain ⟨U, hU, hu⟩ := hChooseAff u
    let W := (TopologicalSpace.Opens.map f.base).obj U
    have hW : AlgebraicGeometry.IsAffineOpen W := hU.preimage f
    let A_U : Type u := ↑(U₀.presheaf.obj (Opposite.op U))
    let B_U : Type u := ↑(W₀.presheaf.obj (Opposite.op W))
    let : Algebra A_U B_U := (f.app U).hom.toAlgebra
    have : Module.Finite A_U B_U := AlgebraicGeometry.IsFinite.finite_app f U hU
    have hEtU : (f.app U).hom.Etale := by
      rw [f.app_eq_appLE]
      exact AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) f inferInstance
        ⟨U, hU⟩ ⟨W, hW⟩ le_rfl
    have : Algebra.Etale A_U B_U := RingHom.etale_algebraMap.mp hEtU
    have : Module.FinitePresentation A_U B_U :=
      Module.FinitePresentation.of_finite_of_finitePresentation A_U B_U
    have hLC_BU : IsLocallyConstant (Module.rankAtStalk (R := A_U) B_U) :=
      Module.isLocallyConstant_rankAtStalk
    have hCont_p : Continuous (fun x : ↥U => hU.primeIdealOf x) :=
      hU.isoSpec.hom.base.hom.continuous
    have hLC_on_U : IsLocallyConstant (fun x : ↥U => Module.rankAtStalk (R := A_U) B_U (hU.primeIdealOf x)) :=
      hLC_BU.comp_continuous hCont_p
    obtain ⟨O, hO_open, hxO, hO_const⟩ :=
      (IsLocallyConstant.iff_exists_open _).mp hLC_on_U ⟨u, hu⟩
    refine ⟨Subtype.val '' O, U.isOpen.isOpenMap_subtype_val O hO_open, ⟨⟨u, hu⟩, hxO, rfl⟩, ?_⟩
    rintro _ ⟨y, hyO, rfl⟩
    rw [hrk_eq U hU y.1 y.2, hrk_eq U hU u hu]
    exact hO_const y hyO

  obtain ⟨u₀⟩ := (inferInstance : Nonempty ↥U₀)
  let δ : ℕ := rk u₀
  have hrk_const : ∀ u : ↥U₀, rk u = δ :=
    fun u => IsLocallyConstant.iff_is_const.mp hLocConst_rk u u₀

  have hRankChart : ∀ (U : U₀.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      letI : Algebra ↑(U₀.presheaf.obj (Opposite.op U))
        ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U))) :=
          (f.app U).hom.toAlgebra
      ∀ p : PrimeSpectrum ↑(U₀.presheaf.obj (Opposite.op U)),
        Module.rankAtStalk
          ↑(W₀.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U))) p = δ := by
    intro U hU p
    let u_p : ↥U₀ := hU.fromSpec.base p
    have hu_p : u_p ∈ U := by
      have hmem : u_p ∈ Set.range hU.fromSpec.base := ⟨p, rfl⟩
      rwa [← AlgebraicGeometry.Scheme.Hom.coe_opensRange, hU.opensRange_fromSpec] at hmem
    have hp_eq : hU.primeIdealOf ⟨u_p, hu_p⟩ = p := by
      apply hU.fromSpec.isOpenEmbedding.injective
      exact hU.fromSpec_primeIdealOf ⟨u_p, hu_p⟩
    rw [← hp_eq, ← hrk_eq U hU u_p hu_p, hrk_const u_p]

  have hδ_pos : 1 ≤ δ := by
    obtain ⟨U, hU, hu₀⟩ := hChooseAff u₀
    let W := (TopologicalSpace.Opens.map f.base).obj U
    have hW : AlgebraicGeometry.IsAffineOpen W := hU.preimage f
    let A_U : Type u := ↑(U₀.presheaf.obj (Opposite.op U))
    let B_U : Type u := ↑(W₀.presheaf.obj (Opposite.op W))
    let : Algebra A_U B_U := (f.app U).hom.toAlgebra
    have : Module.Finite A_U B_U := AlgebraicGeometry.IsFinite.finite_app f U hU
    have hEtU : (f.app U).hom.Etale := by
      rw [f.app_eq_appLE]
      exact AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) f inferInstance
        ⟨U, hU⟩ ⟨W, hW⟩ le_rfl
    have : Algebra.Etale A_U B_U := RingHom.etale_algebraMap.mp hEtU
    have : Module.FinitePresentation A_U B_U :=
      Module.FinitePresentation.of_finite_of_finitePresentation A_U B_U
    obtain ⟨w₀, hw₀_eq⟩ := (inferInstance : AlgebraicGeometry.Surjective f).surj u₀
    have hw₀ : w₀ ∈ W := by
      show f.base w₀ ∈ U
      rw [hw₀_eq]
      exact hu₀
    have hNontriv : Nontrivial B_U :=
      PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨hW.primeIdealOf ⟨w₀, hw₀⟩⟩
    by_contra hlt
    have hδ0 : δ = 0 := by omega
    have hRankZero : Module.rankAtStalk (R := A_U) B_U = 0 := by
      ext p
      rw [hRankChart U hU p, hδ0]
      rfl
    have : Subsingleton B_U :=
      (Module.rankAtStalk_eq_zero_iff_subsingleton (R := A_U) (M := B_U)).mp hRankZero
    exact false_of_nontrivial_of_subsingleton B_U

  refine ⟨δ, hδ_pos, fun u => ?_⟩
  obtain ⟨U, hU, hu⟩ := hChooseAff u
  let W := (TopologicalSpace.Opens.map f.base).obj U
  have hW : AlgebraicGeometry.IsAffineOpen W := hU.preimage f
  let A : Type u := ↑(U₀.presheaf.obj (Opposite.op U))
  let B : Type u := ↑(W₀.presheaf.obj (Opposite.op W))
  let : Algebra A B := (f.app U).hom.toAlgebra
  have : Module.Finite A B := AlgebraicGeometry.IsFinite.finite_app f U hU
  have hEtAB_hom : (f.app U).hom.Etale := by
    rw [f.app_eq_appLE]
    exact AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale) f inferInstance
      ⟨U, hU⟩ ⟨W, hW⟩ le_rfl
  have : Algebra.Etale A B := RingHom.etale_algebraMap.mp hEtAB_hom

  obtain ⟨C, hCommC, hAlgAC, hEtAC, ⟨q₀, hq₀⟩, ⟨e_pi⟩⟩ :=
    hPiTriv δ A B (hRankChart U hU) (hU.primeIdealOf ⟨u, hu⟩)
  let : CommRing C := hCommC
  let : Algebra A C := hAlgAC
  have : Algebra.Etale A C := hEtAC

  let V : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of C)
  let v₀ : V ⟶ AlgebraicGeometry.Spec (U₀.presheaf.obj (Opposite.op U)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C))
  let v : V ⟶ U₀ := v₀ ≫ hU.fromSpec

  have hEt_v₀ : AlgebraicGeometry.Etale v₀ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
      (RingHom.etale_algebraMap.mpr hEtAC)
  have hEt_v : AlgebraicGeometry.Etale v := inferInstance

  have hu_range : u ∈ Set.range v.base := by
    refine ⟨q₀, ?_⟩
    change hU.fromSpec.base (PrimeSpectrum.comap (algebraMap A C) q₀) = u
    rw [hq₀]
    exact hU.fromSpec_primeIdealOf ⟨u, hu⟩

  have hp_aff := hAffPullback U hU
  have hp_v₀ : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map (f.app U)) v₀)
      (CategoryTheory.Limits.pullback.snd (AlgebraicGeometry.Spec.map (f.app U)) v₀)
      (AlgebraicGeometry.Spec.map (f.app U)) v₀ :=
    CategoryTheory.IsPullback.of_hasPullback (AlgebraicGeometry.Spec.map (f.app U)) v₀
  have hp_paste : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst (AlgebraicGeometry.Spec.map (f.app U)) v₀ ≫ hW.fromSpec)
      (CategoryTheory.Limits.pullback.snd (AlgebraicGeometry.Spec.map (f.app U)) v₀)
      f v :=
    (hp_v₀.flip.paste_vert hp_aff).flip
  let e_pb₁ : CategoryTheory.Limits.pullback f v ≅
      CategoryTheory.Limits.pullback (AlgebraicGeometry.Spec.map (f.app U)) v₀ :=
    hp_paste.isoPullback.symm
  let R_pi := Fin δ → C
  let Ψ : CategoryTheory.Limits.pullback f v ≅ AlgebraicGeometry.Spec (CommRingCat.of R_pi) :=
    e_pb₁ ≪≫
      AlgebraicGeometry.pullbackSpecIso A B C ≪≫
      specIsoOfRingEquiv (Algebra.TensorProduct.comm A B C).toRingEquiv ≪≫
      specIsoOfRingEquiv e_pi.toRingEquiv

  have hΨ_snd : Ψ.hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C R_pi)) =
      CategoryTheory.Limits.pullback.snd f v := by
    dsimp only [Ψ, e_pb₁, Iso.trans_hom]
    rw [specIso_hom, specIso_hom, Category.assoc, Category.assoc, Category.assoc]
    have hcomm_pi :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_pi.toRingEquiv.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C R_pi)) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap C (TensorProduct A C B))) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
      ext c
      exact e_pi.symm.commutes c
    rw [hcomm_pi]
    have hcomm_swap :
        AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Algebra.TensorProduct.comm A B C).toRingEquiv.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap C (TensorProduct A C B))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A B C).toRingHom) := by
      rw [← AlgebraicGeometry.Spec.map_comp]
      congr 1
    rw [hcomm_swap, ← Category.assoc hp_paste.isoPullback.symm.hom, Category.assoc]
    erw [AlgebraicGeometry.pullbackSpecIso_hom_snd A B C]
    exact hp_paste.isoPullback_inv_snd

  let e_id : Fin δ → R_pi := fun j => Pi.single j (1 : C)
  let π_eval : Fin δ → (R_pi →+* C) := fun j => Pi.evalRingHom (fun _ => C) j
  let τ : Fin δ → (V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_pi)) :=
    fun j => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_eval j))
  let σ : Fin δ → (V ⟶ CategoryTheory.Limits.pullback f v) :=
    fun j => τ j ≫ Ψ.inv

  have hLoc : ∀ j : Fin δ,
      @IsLocalization.Away R_pi _ (e_id j) C _ ((π_eval j).toAlgebra) := by
    intro j
    let : Algebra R_pi C := (π_eval j).toAlgebra
    refine
      { map_units := by
          rintro ⟨_, n, rfl⟩
          change IsUnit (π_eval j ((e_id j) ^ n))
          rw [map_pow]
          have h1 : π_eval j (e_id j) = 1 := by
            change e_id j j = 1
            simp [e_id]
          rw [h1, one_pow]
          exact isUnit_one
        surj := fun c => ⟨((fun _ => c), 1), by simp; rfl⟩
        exists_of_eq := by
          intro x y hxy
          refine ⟨⟨e_id j, 1, pow_one _⟩, ?_⟩
          ext k
          by_cases hkj : k = j
          · subst hkj
            change e_id k k * x k = e_id k k * y k
            have h1 : e_id k k = 1 := by simp [e_id]
            rw [h1]
            exact congrArg ((1 : C) * ·) hxy
          · change e_id j k * x k = e_id j k * y k
            have h0 : e_id j k = 0 := by simp [e_id, hkj]
            rw [h0, zero_mul, zero_mul] }

  have hRange_τ : ∀ j : Fin δ,
      Set.range (τ j).base = (PrimeSpectrum.basicOpen (e_id j) : Set (PrimeSpectrum R_pi)) := by
    intro j
    let : Algebra R_pi C := (π_eval j).toAlgebra
    have : IsLocalization.Away (e_id j) C := hLoc j
    exact PrimeSpectrum.localization_away_comap_range C (e_id j)

  refine ⟨V, v, σ, hEt_v, hu_range, ?_, ?_, ?_, ?_⟩
  · intro j
    dsimp [σ, τ]
    rw [← hΨ_snd, Category.assoc, ← Category.assoc Ψ.inv, Ψ.inv_hom_id, Category.id_comp,
      ← AlgebraicGeometry.Spec.map_comp]
    have hcomp_id :
        CommRingCat.ofHom (algebraMap C R_pi) ≫ CommRingCat.ofHom (π_eval j) =
          𝟙 (CommRingCat.of C) := by
      ext c
      rfl
    rw [hcomp_id, AlgebraicGeometry.Spec.map_id]
  · intro j
    let : Algebra R_pi C := (π_eval j).toAlgebra
    have : IsLocalization.Away (e_id j) C := hLoc j
    have : AlgebraicGeometry.IsOpenImmersion (τ j) :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization (R := R_pi) (S := C) (e_id j)
    exact inferInstance
  · intro i j hij
    rw [Set.disjoint_left]
    rintro _ ⟨x, rfl⟩ ⟨y, hy⟩
    have hτ_eq : (τ i).base x = (τ j).base y := by
      have h1 : Ψ.hom.base (Ψ.inv.base ((τ i).base x)) =
          Ψ.hom.base (Ψ.inv.base ((τ j).base y)) := congrArg Ψ.hom.base hy.symm
      have hinv_hom : ∀ z, Ψ.hom.base (Ψ.inv.base z) = z := fun z => by
        change (Ψ.inv ≫ Ψ.hom).base z = z
        rw [Ψ.inv_hom_id]
        rfl
      rwa [hinv_hom, hinv_hom] at h1
    let p_spec : PrimeSpectrum R_pi := (τ i).base x
    have hp_i : p_spec ∈ (PrimeSpectrum.basicOpen (e_id i) : Set (PrimeSpectrum R_pi)) := by
      rw [← hRange_τ i]
      exact ⟨x, rfl⟩
    have hp_j : p_spec ∈ (PrimeSpectrum.basicOpen (e_id j) : Set (PrimeSpectrum R_pi)) := by
      rw [← hRange_τ j]
      exact ⟨y, hτ_eq.symm⟩
    have hmul_zero : e_id i * e_id j = 0 := by
      ext k
      by_cases hki : k = i
      · subst hki
        change e_id k k * e_id j k = 0
        have h1 : e_id k k = 1 := by simp [e_id]
        have h0 : e_id j k = 0 := by simp [e_id, hij]
        rw [h1, h0, mul_zero]
      · change e_id i k * e_id j k = 0
        have h0 : e_id i k = 0 := by simp [e_id, hki]
        rw [h0, zero_mul]
    have hmem_mul : e_id i * e_id j ∈ p_spec.asIdeal := by
      rw [hmul_zero]
      exact p_spec.asIdeal.zero_mem
    rcases p_spec.isPrime.mem_or_mem hmem_mul with hi_in | hj_in
    · exact hp_i hi_in
    · exact hp_j hj_in
  · ext z
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    let p_z : PrimeSpectrum R_pi := Ψ.hom.base z
    have hsum_one : (∑ j : Fin δ, e_id j) = 1 := by
      ext k
      change (∑ j ∈ Finset.univ, e_id j) k = (1 : C)
      rw [Finset.sum_apply]
      simp [e_id, Pi.single_apply]
    by_contra hnone
    simp only [not_exists] at hnone
    have hall_mem : ∀ j : Fin δ, e_id j ∈ p_z.asIdeal := by
      intro j
      by_contra hj_not
      have hp_basic : p_z ∈ (PrimeSpectrum.basicOpen (e_id j) : Set (PrimeSpectrum R_pi)) :=
        hj_not
      rw [← hRange_τ j] at hp_basic
      rcases hp_basic with ⟨x, hx⟩
      apply hnone j
      refine ⟨x, ?_⟩
      change Ψ.inv.base ((τ j).base x) = z
      rw [hx]
      change (Ψ.hom ≫ Ψ.inv).base z = z
      rw [Ψ.hom_inv_id]
      rfl
    have hone_mem : (1 : R_pi) ∈ p_z.asIdeal := by
      rw [← hsum_one]
      exact Ideal.sum_mem p_z.asIdeal (fun j _ => hall_mem j)
    exact p_z.isPrime.ne_top (p_z.asIdeal.eq_top_iff_one.mpr hone_mem)

theorem weil_algClosed_affine_closed_point_section_and_pullback_lift (k : Type u) [Field k] [IsAlgClosed k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (p_W : Quiver.Hom W S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W]
        (x : ↥W),
      IsClosed ({x} : Set ↥W) →
      ∃ s : Quiver.Hom S_k W,
        CategoryTheory.CategoryStruct.comp s p_W = CategoryTheory.CategoryStruct.id S_k ∧
        Set.range s.base = {x}) ∧
    (∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (p_W : Quiver.Hom W S_k)
        (s : Quiver.Hom S_k W),
      CategoryTheory.CategoryStruct.comp s p_W = CategoryTheory.CategoryStruct.id S_k →
      ∃ x : ↥W, Set.range s.base = {x} ∧ IsClosed ({x} : Set ↥W)) ∧
    (∀ (V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V]
        (p_V : Quiver.Hom V S_k)
        (s₁ s₂ : Quiver.Hom S_k V),
      CategoryTheory.CategoryStruct.comp s₁ p_V = CategoryTheory.CategoryStruct.id S_k →
      CategoryTheory.CategoryStruct.comp s₂ p_V = CategoryTheory.CategoryStruct.id S_k →
      Set.range s₁.base = Set.range s₂.base →
      s₁ = s₂) ∧
    (∀ (V_et V : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V]
        (p_V : Quiver.Hom V S_k) [AlgebraicGeometry.LocallyOfFiniteType p_V]
        (v : Quiver.Hom V_et V) [AlgebraicGeometry.Etale v]
        (b : ↥V),
      IsClosed ({b} : Set ↥V) →
      b ∈ Set.range v.base →
      ∃ (W_aff : V_et.Opens) (w₀ : ↥W_aff.toScheme),
        AlgebraicGeometry.IsAffineOpen W_aff ∧
        IsClosed ({w₀} : Set ↥W_aff.toScheme) ∧
        v.base (W_aff.ι.base w₀) = b) :=
by
  classical
  intro S_k
  have hNonempty_k : Nonempty ↥S_k :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := k)).mpr inferInstance
  let pt_k : ↥S_k := Classical.choice hNonempty_k
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := by
    ext c
    simp only [Ideal.mem_bot]
    constructor
    · intro hc
      by_contra hne
      exact (pt_k : PrimeSpectrum k).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hne))
    · rintro rfl
      exact (pt_k : PrimeSpectrum k).asIdeal.zero_mem
  have hRange_Sk : ∀ {X : AlgebraicGeometry.Scheme.{u}} (f : S_k ⟶ X),
      Set.range f.base = {f.base pt_k} := by
    intro X f
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨y, rfl⟩
      rw [hSub_k.elim y pt_k]
    · rintro rfl
      exact ⟨pt_k, rfl⟩
  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W]
        (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_B : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_B (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_k := by
      dsimp [s]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_k : PrimeSpectrum k).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_hom_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k) = x
    rw [hs_pt_spec]
    change (e_W.hom ≫ e_W.inv).base x = x
    rw [e_W.hom_inv_id]
    rfl
  have hClosedOfSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) (s : S_k ⟶ W),
        s ≫ p_W = 𝟙 S_k →
        IsClosed ({s.base pt_k} : Set ↥W) := by
    intro W _ p_W s hs
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    let ψ : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s ≫ e_W.hom)
    have hφψ : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_W.hom, e_W.hom_inv_id,
        CategoryTheory.Category.id_comp, hs, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ.hom := fun c =>
      ⟨φ_k.hom c, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφψ⟩
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := (AlgebraicGeometry.Spec.map ψ).base pt_k
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_max : q_spec.asIdeal.IsMaximal := by
      change (Ideal.comap ψ.hom (pt_k : PrimeSpectrum k).asIdeal).IsMaximal
      rw [hpt_bot]
      haveI : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      exact Ideal.comap_isMaximal_of_surjective ψ.hom hψ_surj
    have hq_cl : IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mpr hq_max
    have hpre : ({s.base pt_k} : Set ↥W) =
        e_W.hom.base ⁻¹' ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) := by
      have hq_eq : q_pt = e_W.hom.base (s.base pt_k) := by
        dsimp [q_pt, ψ]
        rw [AlgebraicGeometry.Spec.map_preimage]
        rfl
      rw [hq_eq]
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; rfl
      · intro hz
        have hz' := congrArg e_W.inv.base hz
        change (e_W.hom ≫ e_W.inv).base z = (e_W.hom ≫ e_W.inv).base (s.base pt_k) at hz'
        rwa [e_W.hom_inv_id] at hz'
    rw [hpre]
    exact hq_cl.preimage e_W.hom.continuous
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro W _ p_W _ x hx
    obtain ⟨s, hs_sec, hs_pt⟩ := hClosedPtSection p_W x hx
    refine ⟨s, hs_sec, ?_⟩
    rw [hRange_Sk s, hs_pt]
  · intro W _ p_W s hs
    exact ⟨s.base pt_k, hRange_Sk s, hClosedOfSection p_W s hs⟩
  · intro V _ p_V s₁ s₂ hs₁ hs₂ hrange
    rw [hRange_Sk s₁, hRange_Sk s₂, Set.singleton_eq_singleton_iff] at hrange
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hrange
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp
  · intro V_et V _ p_V _ v _ b hb_cl hb_mem
    obtain ⟨y_et, hy_et⟩ := hb_mem
    obtain ⟨W_aff, hAff_W, hy_W, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (show y_et ∈ (⊤ : V_et.Opens) from trivial)
    haveI : AlgebraicGeometry.IsAffine W_aff.toScheme := hAff_W
    let u_W : W_aff.toScheme ⟶ V := W_aff.ι ≫ v
    haveI : AlgebraicGeometry.Etale u_W := inferInstance
    haveI : AlgebraicGeometry.LocallyOfFiniteType u_W := inferInstance
    let y_W : ↥W_aff.toScheme := ⟨y_et, hy_W⟩
    obtain ⟨s_b, hs_b_sec, hs_b_pt⟩ := hClosedPtSection p_V b hb_cl
    have hu_eq : u_W.base y_W = s_b.base pt_k := hy_et.trans hs_b_pt.symm
    obtain ⟨z_P, -, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := u_W) (g := s_b) y_W pt_k hu_eq
    let P := CategoryTheory.Limits.pullback u_W s_b
    let p₁ : P ⟶ W_aff.toScheme := CategoryTheory.Limits.pullback.fst u_W s_b
    let p₂ : P ⟶ S_k := CategoryTheory.Limits.pullback.snd u_W s_b
    haveI : AlgebraicGeometry.IsAffine P := inferInstance
    haveI : AlgebraicGeometry.LocallyOfFiniteType p₂ := inferInstance
    let e_P := P.isoSpec
    let R_P := P.presheaf.obj (Opposite.op ⊤)
    let z_spec : PrimeSpectrum ↑R_P := e_P.hom.base z_P
    obtain ⟨m_P, hm_P, -⟩ := Ideal.exists_le_maximal z_spec.asIdeal z_spec.isPrime.ne_top
    let q_max_spec : PrimeSpectrum ↑R_P := ⟨m_P, hm_P.isPrime⟩
    let q_max_pt : ↥(AlgebraicGeometry.Spec R_P) := q_max_spec
    let z_max : ↥P := e_P.inv.base q_max_pt
    have hq_max_cl : IsClosed ({q_max_pt} : Set ↥(AlgebraicGeometry.Spec R_P)) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_max_spec).mpr hm_P
    have hz_max_pre : ({z_max} : Set ↥P) =
        e_P.hom.base ⁻¹' ({q_max_pt} : Set ↥(AlgebraicGeometry.Spec R_P)) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_P.inv ≫ e_P.hom).base q_max_pt = q_max_pt
        rw [e_P.inv_hom_id]
        rfl
      · intro hz
        dsimp [z_max]
        rw [← hz]
        change z = (e_P.hom ≫ e_P.inv).base z
        rw [e_P.hom_inv_id]
        rfl
    have hz_max_cl : IsClosed ({z_max} : Set ↥P) := by
      rw [hz_max_pre]
      exact hq_max_cl.preimage e_P.hom.continuous
    obtain ⟨s_P, hs_P_sec, -⟩ := hClosedPtSection p₂ z_max hz_max_cl
    let s_W : S_k ⟶ W_aff.toScheme := s_P ≫ p₁
    have hs_W_u : s_W ≫ u_W = s_b := by
      dsimp [s_W, p₁]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hs_P_sec, CategoryTheory.Category.id_comp]
    have hs_W_sec : s_W ≫ (u_W ≫ p_V) = 𝟙 S_k := by
      rw [← CategoryTheory.Category.assoc, hs_W_u, hs_b_sec]
    let w₀ : ↥W_aff.toScheme := s_W.base pt_k
    have hw₀_cl : IsClosed ({w₀} : Set ↥W_aff.toScheme) :=
      hClosedOfSection (u_W ≫ p_V) s_W hs_W_sec
    have hw₀_map : v.base (W_aff.ι.base w₀) = b := by
      have hcomp : v.base (W_aff.ι.base w₀) = (s_W ≫ u_W).base pt_k := rfl
      rw [hcomp, hs_W_u, hs_b_pt]
    exact ⟨W_aff, w₀, hAff_W, hw₀_cl, hw₀_map⟩

theorem weil_proper_connected_geom_fibers_connectedSpace (Y V : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥V]
    (f : Quiver.Hom Y V) [AlgebraicGeometry.IsProper f]
    (hConn : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback f s)) :
    ConnectedSpace ↥Y :=
by
  have hFib : ∀ v : ↥V, _root_.IsConnected ((⇑f) ⁻¹' ({v} : Set ↥V)) := by
    intro v
    let s : AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ↥(V.residueField v))) ⟶ V :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap ↥(V.residueField v) (AlgebraicClosure ↥(V.residueField v)))) ≫
      V.fromSpecResidueField v
    haveI : ConnectedSpace ↥(CategoryTheory.Limits.pullback f s) :=
      hConn (AlgebraicClosure ↥(V.residueField v)) s
    have hs_range : Set.range (⇑s) = ({v} : Set ↥V) := by
      ext w
      simp only [Set.mem_range, Set.mem_singleton_iff]
      constructor
      · rintro ⟨z, rfl⟩
        change (V.fromSpecResidueField v)
          ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥(V.residueField v) (AlgebraicClosure ↥(V.residueField v))))) z) = v
        exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply v _
      · intro hw
        rw [hw]
        obtain ⟨z₀⟩ :
            Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ↥(V.residueField v)))) :=
          inferInstance
        refine ⟨z₀, ?_⟩
        change (V.fromSpecResidueField v)
          ((AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥(V.residueField v) (AlgebraicClosure ↥(V.residueField v))))) z₀) = v
        exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply v _
    let p₁ := CategoryTheory.Limits.pullback.fst f s
    have hp₁_range : Set.range (⇑p₁) = (⇑f) ⁻¹' ({v} : Set ↥V) := by
      rw [AlgebraicGeometry.Scheme.Pullback.range_fst, hs_range]
    rw [← hp₁_range]
    exact _root_.isConnected_range p₁.continuous
  obtain ⟨v₀⟩ : Nonempty ↥V := inferInstance
  obtain ⟨y₀, -⟩ := (hFib v₀).nonempty
  rw [connectedSpace_iff_clopen]
  refine ⟨⟨y₀⟩, fun U hU => ?_⟩
  have hClosedMap : IsClosedMap (⇑f) := f.isClosedMap
  let A : Set ↥V := (⇑f) '' U
  let B : Set ↥V := (⇑f) '' Uᶜ
  have hClosedA : IsClosed A := hClosedMap U hU.isClosed
  have hClosedB : IsClosed B := hClosedMap Uᶜ hU.compl.isClosed
  have hAB : A = Bᶜ := by
    ext v
    simp only [A, B, Set.mem_image, Set.mem_compl_iff, not_exists, not_and]
    constructor
    · rintro ⟨y₁, hy₁U, rfl⟩ y₂ hy₂Uc hy₂f
      rcases disjoint_or_subset_of_isClopen (hFib (f y₁)).isPreconnected hU with hDisj | hSub
      · have hy₁_mem : y₁ ∈ (⇑f) ⁻¹' ({f y₁} : Set ↥V) := by
          rw [Set.mem_preimage, Set.mem_singleton_iff]
        exact Set.disjoint_left.mp hDisj hy₁_mem hy₁U
      · have hy₂_mem : y₂ ∈ (⇑f) ⁻¹' ({f y₁} : Set ↥V) := by
          rw [Set.mem_preimage, Set.mem_singleton_iff]
          exact hy₂f
        exact hy₂Uc (hSub hy₂_mem)
    · intro hvB
      obtain ⟨y, hyf⟩ := (hFib v).nonempty
      rw [Set.mem_preimage, Set.mem_singleton_iff] at hyf
      by_cases hyU : y ∈ U
      · exact ⟨y, hyU, hyf⟩
      · exfalso
        exact hvB y hyU hyf
  have hOpenA : IsOpen A := by
    rw [hAB]
    exact hClosedB.isOpen_compl
  have hClopenA : IsClopen A := ⟨hClosedA, hOpenA⟩
  rcases isClopen_iff.mp hClopenA with hA_empty | hA_univ
  · left
    ext y
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hyU
    have hfy : f y ∈ A := ⟨y, hyU, rfl⟩
    rw [hA_empty] at hfy
    exact hfy
  · right
    ext y
    simp only [Set.mem_univ, iff_true]
    by_contra hyU
    have hfyB : f y ∈ B := ⟨y, hyU, rfl⟩
    have hfyA : f y ∈ A := by rw [hA_univ]; trivial
    rw [hAB] at hfyA
    exact hfyA hfyB

theorem weil_etale_sheet_split_closed_bdry_pullback_and_affine_compl (O₀ S₀ Z_tot V_et V₁ Y₁ : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine S₀] [AlgebraicGeometry.IsAffine V₁]
    (V'₀ : S₀.Opens)
    (π₀ : Quiver.Hom O₀ S₀)
    (ι_tot : Quiver.Hom Z_tot O₀) [AlgebraicGeometry.IsClosedImmersion ι_tot]
    (U_open : O₀.Opens)
    (hU_compl : (U_open : Set ↥O₀) = (Set.range ι_tot.base)ᶜ)
    (hAff_U : AlgebraicGeometry.IsAffineOpen U_open)
    (v_et : Quiver.Hom V_et V'₀.toScheme)
    (j₁ : Quiver.Hom V₁ V_et)
    (q_Y₁ : Quiver.Hom Y₁ O₀)
    (f_bar₁ : Quiver.Hom Y₁ V₁) [AlgebraicGeometry.IsSeparated f_bar₁]
    (hPb_Y₁ : CategoryTheory.IsPullback q_Y₁ f_bar₁ π₀
      (CategoryTheory.CategoryStruct.comp j₁
        (CategoryTheory.CategoryStruct.comp v_et V'₀.ι)))
    (s_pts : ℕ)
    (σ_et : Fin s_pts → Quiver.Hom V_et
      (CategoryTheory.Limits.pullback
        ((CategoryTheory.CategoryStruct.comp ι_tot π₀) ∣_ V'₀) v_et))
    (hσ_et_sec : ∀ a : Fin s_pts,
      CategoryTheory.CategoryStruct.comp (σ_et a)
        (CategoryTheory.Limits.pullback.snd
          ((CategoryTheory.CategoryStruct.comp ι_tot π₀) ∣_ V'₀) v_et) =
        CategoryTheory.CategoryStruct.id V_et)
    (hσ_et_open : ∀ a : Fin s_pts, AlgebraicGeometry.IsOpenImmersion (σ_et a))
    (hσ_et_disj : ∀ a b : Fin s_pts, a ≠ b →
      Disjoint (Set.range (σ_et a).base) (Set.range (σ_et b).base))
    (hσ_et_univ : (⋃ a : Fin s_pts, Set.range (σ_et a).base) = Set.univ) :
    let W₁_open : Y₁.Opens := q_Y₁ ⁻¹ᵁ U_open
    ∃ σ : Fin s_pts → Quiver.Hom V₁ Y₁,
      (∀ a : Fin s_pts,
        CategoryTheory.CategoryStruct.comp (σ a) f_bar₁ =
          CategoryTheory.CategoryStruct.id V₁) ∧
      (∀ a : Fin s_pts, AlgebraicGeometry.IsClosedImmersion (σ a)) ∧
      (_root_.Pairwise fun a b : Fin s_pts =>
        Disjoint (Set.range (σ a).base) (Set.range (σ b).base)) ∧
      ((W₁_open : Set ↥Y₁) = (⋃ a : Fin s_pts, Set.range (σ a).base)ᶜ) ∧
      AlgebraicGeometry.IsAffineOpen W₁_open ∧
      CategoryTheory.IsPullback (q_Y₁ ∣_ U_open)
        (CategoryTheory.CategoryStruct.comp W₁_open.ι f_bar₁)
        (CategoryTheory.CategoryStruct.comp U_open.ι π₀)
        (CategoryTheory.CategoryStruct.comp j₁
          (CategoryTheory.CategoryStruct.comp v_et V'₀.ι)) :=
by
  let _ := hσ_et_open
  have hRange_of_isPullback :
      ∀ {P X Y Z : AlgebraicGeometry.Scheme.{u}}
        {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z},
        CategoryTheory.IsPullback fst snd f g →
        Set.range fst.base = f.base ⁻¹' Set.range g.base := by
    intro P X Y Z fst snd f g hPb
    ext x
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨p, rfl⟩
      refine ⟨snd.base p, ?_⟩
      have hw : (fst ≫ f).base p = (snd ≫ g).base p :=
        congrArg (fun m : P ⟶ Z => m.base p) hPb.w
      simpa only [AlgebraicGeometry.Scheme.Hom.comp_apply] using hw.symm
    · rintro ⟨y, hy⟩
      obtain ⟨p, hp₁, _⟩ :=
        AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb x y hy.symm
      exact ⟨p, hp₁⟩
  intro W₁_open
  let v_to_S₀ : V₁ ⟶ S₀ :=
    CategoryTheory.CategoryStruct.comp j₁ (CategoryTheory.CategoryStruct.comp v_et V'₀.ι)
  have hPb_W₁ : CategoryTheory.IsPullback (q_Y₁ ∣_ U_open)
      (CategoryTheory.CategoryStruct.comp W₁_open.ι f_bar₁)
      (CategoryTheory.CategoryStruct.comp U_open.ι π₀)
      v_to_S₀ :=
    (AlgebraicGeometry.isPullback_morphismRestrict q_Y₁ U_open).paste_vert hPb_Y₁
  have hAff_W₁ : AlgebraicGeometry.IsAffineOpen W₁_open := by
    have : AlgebraicGeometry.IsAffine U_open.toScheme := hAff_U
    have : AlgebraicGeometry.IsAffine
        (CategoryTheory.Limits.pullback (U_open.ι ≫ π₀) v_to_S₀) :=
      AlgebraicGeometry.Scheme.Pullback.isAffine_of_isAffine_isAffine_isAffine
        (U_open.ι ≫ π₀) v_to_S₀
    exact AlgebraicGeometry.IsAffine.of_isIso hPb_W₁.isoPullback.hom
  let f_Z : Z_tot ⟶ S₀ := CategoryTheory.CategoryStruct.comp ι_tot π₀
  let P_et : AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.pullback (f_Z ∣_ V'₀) v_et
  let p_et_fst : P_et ⟶ (f_Z ⁻¹ᵁ V'₀).toScheme :=
    CategoryTheory.Limits.pullback.fst (f_Z ∣_ V'₀) v_et
  let p_et_snd : P_et ⟶ V_et :=
    CategoryTheory.Limits.pullback.snd (f_Z ∣_ V'₀) v_et
  let P₁ : AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.pullback p_et_snd j₁
  let q₁ : P₁ ⟶ P_et := CategoryTheory.Limits.pullback.fst p_et_snd j₁
  let snd₁ : P₁ ⟶ V₁ := CategoryTheory.Limits.pullback.snd p_et_snd j₁
  have hPb_1 : CategoryTheory.IsPullback q₁ snd₁ p_et_snd j₁ :=
    CategoryTheory.IsPullback.of_hasPullback p_et_snd j₁
  let τ : Fin s_pts → (V₁ ⟶ P₁) := fun a =>
    CategoryTheory.Limits.pullback.lift (j₁ ≫ σ_et a) (𝟙 V₁) (by
      rw [CategoryTheory.Category.assoc, hσ_et_sec a,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hτ_fst : ∀ a : Fin s_pts, τ a ≫ q₁ = j₁ ≫ σ_et a := fun a =>
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hτ_snd : ∀ a : Fin s_pts, τ a ≫ snd₁ = 𝟙 V₁ := fun a =>
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_τ : ∀ a : Fin s_pts, CategoryTheory.IsPullback (τ a) j₁ q₁ (σ_et a) := by
    intro a
    refine (CategoryTheory.IsPullback.of_bot ?_ (hτ_fst a).symm hPb_1).flip
    rw [hτ_snd a, hσ_et_sec a]
    exact CategoryTheory.IsPullback.of_vert_isIso
      ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
  have hRange_τ : ∀ a : Fin s_pts,
      Set.range (τ a).base = q₁.base ⁻¹' Set.range (σ_et a).base := fun a =>
    hRange_of_isPullback (hPb_τ a)
  have hPb_2 : CategoryTheory.IsPullback p_et_fst p_et_snd (f_Z ∣_ V'₀) v_et :=
    CategoryTheory.IsPullback.of_hasPullback (f_Z ∣_ V'₀) v_et
  have hPb_3 : CategoryTheory.IsPullback (f_Z ⁻¹ᵁ V'₀).ι (f_Z ∣_ V'₀) f_Z V'₀.ι :=
    (AlgebraicGeometry.isPullback_morphismRestrict f_Z V'₀).flip
  let z₁ : P₁ ⟶ Z_tot := (q₁ ≫ p_et_fst) ≫ (f_Z ⁻¹ᵁ V'₀).ι
  have hPb_P₁_Z : CategoryTheory.IsPullback z₁ snd₁ f_Z v_to_S₀ := by
    have h := (hPb_1.paste_horiz hPb_2).paste_horiz hPb_3
    simpa only [z₁, v_to_S₀, CategoryTheory.Category.assoc] using h
  let ι_Z1 : P₁ ⟶ Y₁ :=
    hPb_Y₁.lift (z₁ ≫ ι_tot) snd₁
      ((CategoryTheory.Category.assoc z₁ ι_tot π₀).trans hPb_P₁_Z.w)
  have hι_Z1_q : ι_Z1 ≫ q_Y₁ = z₁ ≫ ι_tot := hPb_Y₁.lift_fst _ _ _
  have hι_Z1_f : ι_Z1 ≫ f_bar₁ = snd₁ := hPb_Y₁.lift_snd _ _ _
  have hPb_Z1 : CategoryTheory.IsPullback z₁ ι_Z1 ι_tot q_Y₁ := by
    refine CategoryTheory.IsPullback.of_bot ?_ hι_Z1_q.symm hPb_Y₁
    rw [hι_Z1_f]
    exact hPb_P₁_Z
  have hCl_ιZ1 : AlgebraicGeometry.IsClosedImmersion ι_Z1 :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsClosedImmersion) hPb_Z1 inferInstance
  have hInj_ιZ1 : Function.Injective ι_Z1.base :=
    ι_Z1.isClosedEmbedding.injective
  have hRange_ιZ1 : Set.range ι_Z1.base = q_Y₁.base ⁻¹' Set.range ι_tot.base :=
    hRange_of_isPullback hPb_Z1.flip
  let σ : Fin s_pts → (V₁ ⟶ Y₁) := fun a => τ a ≫ ι_Z1
  have hσ_sec : ∀ a : Fin s_pts, σ a ≫ f_bar₁ = 𝟙 V₁ := by
    intro a
    dsimp only [σ]
    rw [CategoryTheory.Category.assoc, hι_Z1_f, hτ_snd a]
  have hσ_cl : ∀ a : Fin s_pts, AlgebraicGeometry.IsClosedImmersion (σ a) := by
    intro a
    have : AlgebraicGeometry.IsClosedImmersion (σ a ≫ f_bar₁) := by
      rw [hσ_sec a]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp (σ a) f_bar₁
  have hRange_σ : ∀ a : Fin s_pts,
      Set.range (σ a).base = ι_Z1.base '' Set.range (τ a).base := by
    intro a
    ext y
    simp only [σ, Set.mem_range, Set.mem_image]
    constructor
    · rintro ⟨v, rfl⟩
      exact ⟨(τ a).base v, ⟨v, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
      exact ⟨v, rfl⟩
  have hσ_disj : _root_.Pairwise fun a b : Fin s_pts =>
      Disjoint (Set.range (σ a).base) (Set.range (σ b).base) := by
    intro a b hab
    rw [hRange_σ a, hRange_σ b]
    apply Set.disjoint_image_of_injective hInj_ιZ1
    rw [hRange_τ a, hRange_τ b]
    exact (hσ_et_disj a b hab).preimage q₁.base
  have hUnion_σ :
      (⋃ a : Fin s_pts, Set.range (σ a).base) = q_Y₁.base ⁻¹' Set.range ι_tot.base := by
    calc
      (⋃ a : Fin s_pts, Set.range (σ a).base)
        = ⋃ a : Fin s_pts, ι_Z1.base '' (q₁.base ⁻¹' Set.range (σ_et a).base) := by
            refine Set.iUnion_congr fun a => ?_
            rw [hRange_σ a, hRange_τ a]
      _ = ι_Z1.base '' (⋃ a : Fin s_pts, q₁.base ⁻¹' Set.range (σ_et a).base) :=
            (Set.image_iUnion).symm
      _ = ι_Z1.base '' (q₁.base ⁻¹' (⋃ a : Fin s_pts, Set.range (σ_et a).base)) := by
            rw [← Set.preimage_iUnion]
      _ = ι_Z1.base '' (q₁.base ⁻¹' Set.univ) := by
            rw [hσ_et_univ]
      _ = Set.range ι_Z1.base := by
            rw [Set.preimage_univ, Set.image_univ]
      _ = q_Y₁.base ⁻¹' Set.range ι_tot.base := hRange_ιZ1
  have hW₁_compl : (W₁_open : Set ↥Y₁) = (⋃ a : Fin s_pts, Set.range (σ a).base)ᶜ := by
    change q_Y₁.base ⁻¹' (U_open : Set ↥O₀) = _
    rw [hU_compl, Set.preimage_compl, hUnion_σ]
  exact ⟨σ, hσ_sec, hσ_cl, hσ_disj, hW₁_compl, hAff_W₁, hPb_W₁⟩

theorem weil_algClosed_etale_boundary_split_elementary_fibration (k : Type u) [Field k] [IsAlgClosed k] (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (Y_bar V_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_bar : Quiver.Hom Y_bar V_bar)
    (V₀ : V_bar.left.Opens)
    (u_V₀ : Quiver.Hom V₀.toScheme (weilAffineSpaceOver k δ).left)
    (b₀ : ↥V₀.toScheme)
    (Z_tot : AlgebraicGeometry.Scheme.{u})
    (ι_tot : Quiver.Hom Z_tot (π_bar.left ⁻¹ᵁ V₀ : Y_bar.left.Opens).toScheme)
    (U_open : (π_bar.left ⁻¹ᵁ V₀ : Y_bar.left.Opens).toScheme.Opens)
    (j_U : Quiver.Hom U_open.toScheme W₀)
    (x_U : ↥U_open.toScheme)
    (hProp_bar : AlgebraicGeometry.IsProper Y_bar.hom ∧ IsProjectiveOverField k Y_bar ∧
      AlgebraicGeometry.IsProper V_bar.hom ∧ AlgebraicGeometry.IsProper π_bar.left)
    (hBase_V₀ : AlgebraicGeometry.IsAffineOpen V₀ ∧ AlgebraicGeometry.Etale u_V₀ ∧
      CategoryTheory.CategoryStruct.comp u_V₀ (weilAffineSpaceOver k δ).hom =
        CategoryTheory.CategoryStruct.comp V₀.ι V_bar.hom ∧
      IsClosed ({b₀} : Set ↥V₀.toScheme))
    (hSm_V₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (π_bar.left ∣_ V₀))
    (hConn_V₀ : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V₀.toScheme),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback (π_bar.left ∣_ V₀) s))
    (hBdry_tot : AlgebraicGeometry.IsClosedImmersion ι_tot ∧
      AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp ι_tot (π_bar.left ∣_ V₀)) ∧
      AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp ι_tot (π_bar.left ∣_ V₀)) ∧
      AlgebraicGeometry.Surjective (CategoryTheory.CategoryStruct.comp ι_tot (π_bar.left ∣_ V₀)))
    (hOpen_compl :
      (U_open : Set ↥(π_bar.left ⁻¹ᵁ V₀ : Y_bar.left.Opens).toScheme) =
        (Set.range ι_tot.base)ᶜ ∧
      AlgebraicGeometry.IsAffineOpen U_open)
    (hMap_jU : AlgebraicGeometry.Etale j_U ∧
      CategoryTheory.CategoryStruct.comp j_U p_W₀ =
        CategoryTheory.CategoryStruct.comp U_open.ι
          (CategoryTheory.CategoryStruct.comp
            (π_bar.left ⁻¹ᵁ V₀ : Y_bar.left.Opens).ι Y_bar.hom) ∧
      j_U.base x_U = x₀ ∧
      IsClosed ({x_U} : Set ↥U_open.toScheme) ∧
      (π_bar.left ∣_ V₀).base (U_open.ι.base x_U) = b₀) :
    Nonempty (WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀) :=
by
  classical
  obtain ⟨hProp_Ybar, hProj_Ybar, hProp_Vbar, hProp_πbar⟩ := hProp_bar
  obtain ⟨hAff_V₀, hEt_uV₀, hComp_uV₀, hb₀_cl⟩ := hBase_V₀
  obtain ⟨hCl_tot, hFin_tot, hEt_tot, hSurj_tot⟩ := hBdry_tot
  obtain ⟨hU_compl, hAff_Uopen⟩ := hOpen_compl
  obtain ⟨hEt_jU, hComp_jU, hx_U_map, hx_U_cl, hx_U_fib⟩ := hMap_jU
  have : AlgebraicGeometry.IsProper Y_bar.hom := hProp_Ybar
  have : AlgebraicGeometry.IsProper V_bar.hom := hProp_Vbar
  have : AlgebraicGeometry.IsProper π_bar.left := hProp_πbar
  have : AlgebraicGeometry.IsAffine V₀.toScheme := hAff_V₀
  have : AlgebraicGeometry.Etale u_V₀ := hEt_uV₀
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (π_bar.left ∣_ V₀) := hSm_V₀
  have : AlgebraicGeometry.IsClosedImmersion ι_tot := hCl_tot
  have : AlgebraicGeometry.IsAffine U_open.toScheme := hAff_Uopen
  have : AlgebraicGeometry.Etale j_U := hEt_jU

  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let O₀ : Y_bar.left.Opens := π_bar.left ⁻¹ᵁ V₀
  let π₀ : O₀.toScheme ⟶ V₀.toScheme := π_bar.left ∣_ V₀
  let f_Z : Z_tot ⟶ V₀.toScheme := ι_tot ≫ π₀
  have : AlgebraicGeometry.IsFinite f_Z := hFin_tot
  have : AlgebraicGeometry.Etale f_Z := hEt_tot
  have : AlgebraicGeometry.Surjective f_Z := hSurj_tot

  obtain ⟨hShrink_k, hSmConnInt_k⟩ :=
    weil_algClosed_smooth_etale_local_domain_and_connected_integral k
  obtain ⟨hSecOfClosed, hClosedOfSec, hSecEq, hEtLiftClosed⟩ :=
    weil_algClosed_affine_closed_point_section_and_pullback_lift k

  have hConnOfIso :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (e : X ≅ Y),
        ConnectedSpace ↥Y → ConnectedSpace ↥X := by
    intro X Y e hY
    have hUniv : (Set.univ : Set ↥X) = e.inv.base '' (Set.univ : Set ↥Y) := by
      ext x
      refine ⟨fun _ => ⟨e.hom.base x, trivial, ?_⟩, fun _ => trivial⟩
      change (e.hom ≫ e.inv).base x = x
      rw [e.hom_inv_id]
      rfl
    have hPre : _root_.IsPreconnected (Set.univ : Set ↥X) := by
      rw [hUniv]
      exact (@isPreconnected_univ ↥Y _ hY.toPreconnectedSpace).image
        e.inv.base e.inv.continuous.continuousOn
    exact @ConnectedSpace.mk ↥X _ ⟨hPre⟩ ⟨e.inv.base (Classical.choice hY.toNonempty)⟩

  have hClosedPreOpen :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (j : X ⟶ Y) [AlgebraicGeometry.IsOpenImmersion j]
        (x : ↥X), IsClosed ({j.base x} : Set ↥Y) → IsClosed ({x} : Set ↥X) := by
    intro X Y j _ x hx
    have hpre : ({x} : Set ↥X) = j.base ⁻¹' ({j.base x} : Set ↥Y) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      exact ⟨fun h => congrArg j.base h, fun h => j.isOpenEmbedding.injective h⟩
    rw [hpre]
    exact hx.preimage j.continuous

  have hRangeSingletonComp :
      ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (b : ↥B),
        Set.range f.base = {b} → Set.range (f ≫ g).base = {g.base b} := by
    intro A B C f g b hf
    have hb_mem : b ∈ Set.range f.base := by rw [hf]; exact Set.mem_singleton b
    obtain ⟨a₀, ha₀⟩ := hb_mem
    ext c
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨a, rfl⟩
      have hfa : f.base a = b := by
        have hm : f.base a ∈ ({b} : Set ↥B) := by rw [← hf]; exact ⟨a, rfl⟩
        exact Set.mem_singleton_iff.mp hm
      change g.base (f.base a) = g.base b
      rw [hfa]
    · rintro rfl
      refine ⟨a₀, ?_⟩
      change g.base (f.base a₀) = g.base b
      rw [ha₀]

  
  obtain ⟨V'₀, hAff_V'₀, hb'₀_mem, hInt_V'₀⟩ :=
    hShrink_k δ V₀.toScheme u_V₀ b₀ hb₀_cl
  have : AlgebraicGeometry.IsAffine V'₀.toScheme := hAff_V'₀
  have : AlgebraicGeometry.IsIntegral V'₀.toScheme := hInt_V'₀
  have : IrreducibleSpace ↥V'₀.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral V'₀.toScheme
  let b'₀ : ↥V'₀.toScheme := ⟨b₀, hb'₀_mem⟩
  have hb'₀_cl : IsClosed ({b'₀} : Set ↥V'₀.toScheme) :=
    hClosedPreOpen V'₀.ι b'₀ (by
      have hι : V'₀.ι.base b'₀ = b₀ := AlgebraicGeometry.Scheme.Opens.ι_apply V'₀ b'₀
      rwa [hι])

  have hPb_fZ_V'₀ : CategoryTheory.IsPullback (f_Z ∣_ V'₀) (f_Z ⁻¹ᵁ V'₀).ι V'₀.ι f_Z :=
    AlgebraicGeometry.isPullback_morphismRestrict f_Z V'₀
  have : AlgebraicGeometry.IsFinite (f_Z ∣_ V'₀) :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsFinite) hPb_fZ_V'₀.flip hFin_tot
  have : AlgebraicGeometry.Etale (f_Z ∣_ V'₀) :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.Etale) hPb_fZ_V'₀.flip hEt_tot
  have : AlgebraicGeometry.Surjective (f_Z ∣_ V'₀) :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.Surjective) hPb_fZ_V'₀.flip hSurj_tot

  obtain ⟨s_pts, hs_pts_pos, hSplit⟩ :=
    weil_alt_finite_etale_sheet_split_of_connected (f_Z ∣_ V'₀)
  obtain ⟨V_et, v_et, σ_et, hEt_vet, hb'₀_range, hσ_et_sec, hσ_et_open, hσ_et_disj, hσ_et_univ⟩ :=
    hSplit b'₀
  have : AlgebraicGeometry.Etale v_et := hEt_vet

  let p_V'₀ : V'₀.toScheme ⟶ S_k := V'₀.ι ≫ V₀.ι ≫ V_bar.hom
  obtain ⟨V_aff, w₀, hAff_Vaff, hw₀_cl, hw₀_map⟩ :=
    hEtLiftClosed V_et V'₀.toScheme p_V'₀ v_et b'₀ hb'₀_cl hb'₀_range
  have : AlgebraicGeometry.IsAffine V_aff.toScheme := hAff_Vaff

  let u_aff : V_aff.toScheme ⟶ (weilAffineSpaceOver k δ).left :=
    V_aff.ι ≫ v_et ≫ V'₀.ι ≫ u_V₀
  have : AlgebraicGeometry.Etale u_aff := by
    dsimp [u_aff]; infer_instance
  obtain ⟨U₁, hAff_U₁, hw₀_U₁, hInt_U₁⟩ :=
    hShrink_k δ V_aff.toScheme u_aff w₀ hw₀_cl

  let V₁_sch : AlgebraicGeometry.Scheme.{u} := U₁.toScheme
  let j₁ : V₁_sch ⟶ V_et := U₁.ι ≫ V_aff.ι
  have : AlgebraicGeometry.Etale j₁ := by
    dsimp [j₁]; infer_instance
  let v_to_V₀ : V₁_sch ⟶ V₀.toScheme := j₁ ≫ (v_et ≫ V'₀.ι)
  have hEt_v_to_V₀ : AlgebraicGeometry.Etale v_to_V₀ := by
    dsimp [v_to_V₀]; infer_instance
  have : AlgebraicGeometry.Etale v_to_V₀ := hEt_v_to_V₀
  have hEt_V₁hom : AlgebraicGeometry.Etale (v_to_V₀ ≫ V₀.ι) := inferInstance
  let V₁ : V_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (v_to_V₀ ≫ V₀.ι) hEt_V₁hom
  let Fgt_V : V_bar.left.Etale ⥤ CategoryTheory.Over V_bar.left :=
    AlgebraicGeometry.Scheme.Etale.forget V_bar.left
  have hAff_V₁ : AlgebraicGeometry.IsAffine (Fgt_V.obj V₁).left := hAff_U₁
  have hInt_V₁ : AlgebraicGeometry.IsIntegral (Fgt_V.obj V₁).left := hInt_U₁
  have : AlgebraicGeometry.IsAffine (Fgt_V.obj V₁).left := hAff_V₁
  have : AlgebraicGeometry.IsIntegral (Fgt_V.obj V₁).left := hInt_V₁
  have : IrreducibleSpace ↥(Fgt_V.obj V₁).left :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral (Fgt_V.obj V₁).left
  have : AlgebraicGeometry.Etale (Fgt_V.obj V₁).hom := hEt_V₁hom

  let u_V₁ : (Fgt_V.obj V₁).left ⟶ (weilAffineSpaceOver k δ).left :=
    v_to_V₀ ≫ u_V₀
  have hEt_uV₁ : AlgebraicGeometry.Etale u_V₁ := by
    change AlgebraicGeometry.Etale (v_to_V₀ ≫ u_V₀)
    infer_instance
  have : AlgebraicGeometry.Etale u_V₁ := hEt_uV₁
  have hComp_uV₁ : u_V₁ ≫ (weilAffineSpaceOver k δ).hom =
      (Fgt_V.obj V₁).hom ≫ V_bar.hom := by
    change (v_to_V₀ ≫ u_V₀) ≫ (weilAffineSpaceOver k δ).hom =
      (v_to_V₀ ≫ V₀.ι) ≫ V_bar.hom
    exact (CategoryTheory.Category.assoc v_to_V₀ u_V₀ (weilAffineSpaceOver k δ).hom).trans
      ((congrArg (v_to_V₀ ≫ ·) hComp_uV₀).trans
        (CategoryTheory.Category.assoc v_to_V₀ V₀.ι V_bar.hom).symm)

  let v_to_V₀' : (Fgt_V.obj V₁).left ⟶ V₀.toScheme := v_to_V₀
  have hEt_v_to_V₀' : AlgebraicGeometry.Etale v_to_V₀' := hEt_v_to_V₀
  let j₁' : (Fgt_V.obj V₁).left ⟶ V_et := j₁

  let v₁ : ↥(Fgt_V.obj V₁).left := (⟨w₀, hw₀_U₁⟩ : ↥U₁.toScheme)
  have hv₁_cl : IsClosed ({v₁} : Set ↥(Fgt_V.obj V₁).left) :=
    hClosedPreOpen U₁.ι (⟨w₀, hw₀_U₁⟩ : ↥U₁.toScheme) (by
      have hι : U₁.ι.base ⟨w₀, hw₀_U₁⟩ = w₀ :=
        AlgebraicGeometry.Scheme.Opens.ι_apply U₁ ⟨w₀, hw₀_U₁⟩
      rwa [hι])
  have hv₁_to_b₀ : v_to_V₀'.base v₁ = b₀ := by
    change V'₀.ι.base (v_et.base (V_aff.ι.base (U₁.ι.base ⟨w₀, hw₀_U₁⟩))) = b₀
    rw [AlgebraicGeometry.Scheme.Opens.ι_apply U₁ ⟨w₀, hw₀_U₁⟩, hw₀_map]
    exact AlgebraicGeometry.Scheme.Opens.ι_apply V'₀ b'₀

  let p_V₁ : (Fgt_V.obj V₁).left ⟶ S_k := (Fgt_V.obj V₁).hom ≫ V_bar.hom
  obtain ⟨s_v₁, hs_v₁_sec, hs_v₁_range⟩ :=
    hSecOfClosed (Fgt_V.obj V₁).left p_V₁ v₁ hv₁_cl

  
  let Y₁ : AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.pullback π_bar.left (Fgt_V.obj V₁).hom
  let g_Y₁ : Y₁ ⟶ Y_bar.left :=
    CategoryTheory.Limits.pullback.fst π_bar.left (Fgt_V.obj V₁).hom
  let f_bar₁ : Y₁ ⟶ (Fgt_V.obj V₁).left :=
    CategoryTheory.Limits.pullback.snd π_bar.left (Fgt_V.obj V₁).hom
  have hComm_Y₁ : g_Y₁ ≫ π_bar.left = f_bar₁ ≫ (Fgt_V.obj V₁).hom :=
    CategoryTheory.Limits.pullback.condition
  have hLift_id : CategoryTheory.Limits.pullback.lift g_Y₁ f_bar₁ hComm_Y₁ = 𝟙 Y₁ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
    · rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
  have hOpen_Y₁ : AlgebraicGeometry.IsOpenImmersion
      (CategoryTheory.Limits.pullback.lift g_Y₁ f_bar₁ hComm_Y₁) := by
    rw [hLift_id]; infer_instance
  have hClosed_Y₁ : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift g_Y₁ f_bar₁ hComm_Y₁) := by
    rw [hLift_id]; infer_instance

  have hPb_π₀ : CategoryTheory.IsPullback O₀.ι π₀ π_bar.left V₀.ι :=
    (AlgebraicGeometry.isPullback_morphismRestrict π_bar.left V₀).flip
  let q_Y₁ : Y₁ ⟶ O₀.toScheme :=
    hPb_π₀.lift g_Y₁ (f_bar₁ ≫ v_to_V₀')
      (hComm_Y₁.trans (CategoryTheory.Category.assoc f_bar₁ v_to_V₀' V₀.ι).symm)
  have hq_Y₁_ι : q_Y₁ ≫ O₀.ι = g_Y₁ := hPb_π₀.lift_fst _ _ _
  have hq_Y₁_π₀ : q_Y₁ ≫ π₀ = f_bar₁ ≫ v_to_V₀' := hPb_π₀.lift_snd _ _ _
  have hPb_Y₁ : CategoryTheory.IsPullback q_Y₁ f_bar₁ π₀ v_to_V₀' := by
    refine CategoryTheory.IsPullback.of_right ?_ hq_Y₁_π₀ hPb_π₀
    rw [hq_Y₁_ι]
    exact CategoryTheory.IsPullback.of_hasPullback π_bar.left (Fgt_V.obj V₁).hom

  have hProp_f₁ : AlgebraicGeometry.IsProper f_bar₁ := by
    dsimp [f_bar₁]; infer_instance
  have : AlgebraicGeometry.IsProper f_bar₁ := hProp_f₁
  have hEt_gY₁ : AlgebraicGeometry.Etale g_Y₁ := by
    dsimp [g_Y₁]; infer_instance
  have : AlgebraicGeometry.Etale g_Y₁ := hEt_gY₁
  have hSm_f₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_bar₁ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
      hPb_Y₁ hSm_V₀
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_bar₁ := hSm_f₁

  have hConn_fib :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (Fgt_V.obj V₁).left),
        ConnectedSpace ↥(CategoryTheory.Limits.pullback f_bar₁ s) := by
    intro Ω _ _ s
    have hPb_s : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_bar₁ s)
        (CategoryTheory.Limits.pullback.snd f_bar₁ s)
        f_bar₁ s :=
      CategoryTheory.IsPullback.of_hasPullback f_bar₁ s
    have hPb_tot : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f_bar₁ s ≫ q_Y₁)
        (CategoryTheory.Limits.pullback.snd f_bar₁ s)
        π₀ (s ≫ v_to_V₀') :=
      hPb_s.paste_horiz hPb_Y₁
    exact hConnOfIso hPb_tot.isoPullback (hConn_V₀ Ω (s ≫ v_to_V₀'))

  have hFibIrredInt :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (Fgt_V.obj V₁).left),
        IrreducibleSpace ↥(CategoryTheory.Limits.pullback f_bar₁ s) ∧
        AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f_bar₁ s) := by
    intro Ω _ _ s
    let e_Ω0 : MvPolynomial (Fin 0) Ω ≃ₐ[Ω] Ω :=
      MvPolynomial.isEmptyAlgEquiv Ω (Fin 0)
    let f_Ω0 : CommRingCat.of (MvPolynomial (Fin 0) Ω) ⟶ CommRingCat.of Ω :=
      CommRingCat.ofHom e_Ω0.toRingHom
    let g_Ω0 : CommRingCat.of Ω ⟶ CommRingCat.of (MvPolynomial (Fin 0) Ω) :=
      CommRingCat.ofHom e_Ω0.symm.toRingHom
    have hfg_Ω0 : f_Ω0 ≫ g_Ω0 = 𝟙 _ :=
      CommRingCat.hom_ext (RingHom.ext fun p => e_Ω0.symm_apply_apply p)
    have hgf_Ω0 : g_Ω0 ≫ f_Ω0 = 𝟙 _ :=
      CommRingCat.hom_ext (RingHom.ext fun c => e_Ω0.apply_symm_apply c)
    have : CategoryTheory.IsIso f_Ω0 := ⟨⟨g_Ω0, hfg_Ω0, hgf_Ω0⟩⟩
    let u_Ω0 : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilAffineSpaceOver Ω 0).left :=
      AlgebraicGeometry.Spec.map f_Ω0
    have : CategoryTheory.IsIso u_Ω0 := by
      change CategoryTheory.IsIso (AlgebraicGeometry.Spec.map f_Ω0)
      infer_instance
    have : AlgebraicGeometry.Etale u_Ω0 := inferInstance
    have hSm_snd : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (CategoryTheory.Limits.pullback.snd f_bar₁ s) :=
      (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f_bar₁ s) hSm_f₁
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (CategoryTheory.Limits.pullback.snd f_bar₁ s) := hSm_snd
    exact (weil_algClosed_smooth_etale_local_domain_and_connected_integral Ω).2
      0 1 (AlgebraicGeometry.Spec (CommRingCat.of Ω))
      (CategoryTheory.Limits.pullback f_bar₁ s) u_Ω0
      (CategoryTheory.Limits.pullback.snd f_bar₁ s) (hConn_fib Ω s)

  have hConn_Y₁ : ConnectedSpace ↥Y₁ :=
    weil_proper_connected_geom_fibers_connectedSpace Y₁ (Fgt_V.obj V₁).left f_bar₁ hConn_fib
  have hInt_Y₁ : AlgebraicGeometry.IsIntegral Y₁ :=
    (hSmConnInt_k δ 1 (Fgt_V.obj V₁).left Y₁ u_V₁ f_bar₁ hConn_Y₁).2

  
  let W₁_open : Y₁.Opens := q_Y₁ ⁻¹ᵁ U_open
  obtain ⟨σ, hσ_sec, hσ_cl, hσ_disj, hW₁_compl, hAff_W₁open, hPb_W₁⟩ :=
    weil_etale_sheet_split_closed_bdry_pullback_and_affine_compl
      O₀.toScheme V₀.toScheme Z_tot V_et (Fgt_V.obj V₁).left Y₁
      V'₀ π₀ ι_tot U_open hU_compl hAff_Uopen
      v_et j₁' q_Y₁ f_bar₁ hPb_Y₁ s_pts σ_et
      hσ_et_sec hσ_et_open hσ_et_disj hσ_et_univ
  have : AlgebraicGeometry.IsAffine W₁_open.toScheme := hAff_W₁open

  let Fgt_Y : Y_bar.left.Etale ⥤ CategoryTheory.Over Y_bar.left :=
    AlgebraicGeometry.Scheme.Etale.forget Y_bar.left
  have hEt_W₁hom : AlgebraicGeometry.Etale (W₁_open.ι ≫ g_Y₁) := inferInstance
  let W₁ : Y_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (W₁_open.ι ≫ g_Y₁) hEt_W₁hom
  have : AlgebraicGeometry.IsAffine (Fgt_Y.obj W₁).left := hAff_W₁open
  let e_W₁ : (Fgt_Y.obj W₁).left ≅ W₁_open.toScheme :=
    CategoryTheory.Iso.refl W₁_open.toScheme
  have he_W₁_hom : e_W₁.hom ≫ (W₁_open.ι ≫ g_Y₁) = (Fgt_Y.obj W₁).hom :=
    CategoryTheory.Category.id_comp _

  have hEt_qU : AlgebraicGeometry.Etale (q_Y₁ ∣_ U_open) :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.Etale) hPb_W₁.flip hEt_v_to_V₀'
  have : AlgebraicGeometry.Etale (q_Y₁ ∣_ U_open) := hEt_qU
  let j_W₁ : (Fgt_Y.obj W₁).left ⟶ W₀ := (q_Y₁ ∣_ U_open) ≫ j_U
  have hEt_jW₁ : AlgebraicGeometry.Etale j_W₁ := by
    change AlgebraicGeometry.Etale ((q_Y₁ ∣_ U_open) ≫ j_U)
    infer_instance
  have hComp_jW₁ : j_W₁ ≫ p_W₀ = (Fgt_Y.obj W₁).hom ≫ Y_bar.hom := by
    change ((q_Y₁ ∣_ U_open) ≫ j_U) ≫ p_W₀ = (W₁_open.ι ≫ g_Y₁) ≫ Y_bar.hom
    calc
      ((q_Y₁ ∣_ U_open) ≫ j_U) ≫ p_W₀
        = (q_Y₁ ∣_ U_open) ≫ (j_U ≫ p_W₀) := CategoryTheory.Category.assoc _ _ _
      _ = (q_Y₁ ∣_ U_open) ≫ (U_open.ι ≫ (O₀.ι ≫ Y_bar.hom)) := by rw [hComp_jU]
      _ = ((q_Y₁ ∣_ U_open) ≫ U_open.ι) ≫ (O₀.ι ≫ Y_bar.hom) :=
          (CategoryTheory.Category.assoc _ _ _).symm
      _ = (W₁_open.ι ≫ q_Y₁) ≫ (O₀.ι ≫ Y_bar.hom) := by
          rw [AlgebraicGeometry.morphismRestrict_ι q_Y₁ U_open]
      _ = W₁_open.ι ≫ ((q_Y₁ ≫ O₀.ι) ≫ Y_bar.hom) := by
          simp only [CategoryTheory.Category.assoc]
      _ = (W₁_open.ι ≫ g_Y₁) ≫ Y_bar.hom := by
          rw [hq_Y₁_ι, CategoryTheory.Category.assoc]

  let p_U : U_open.toScheme ⟶ S_k := U_open.ι ≫ (O₀.ι ≫ Y_bar.hom)
  obtain ⟨s_xU, hs_xU_sec, hs_xU_range⟩ :=
    hSecOfClosed U_open.toScheme p_U x_U hx_U_cl
  have hπ₀_k : (U_open.ι ≫ π₀) ≫ (V₀.ι ≫ V_bar.hom) = p_U := by
    dsimp [p_U]
    calc
      (U_open.ι ≫ π₀) ≫ (V₀.ι ≫ V_bar.hom)
        = U_open.ι ≫ ((π₀ ≫ V₀.ι) ≫ V_bar.hom) := by
            simp only [CategoryTheory.Category.assoc]
      _ = U_open.ι ≫ ((O₀.ι ≫ π_bar.left) ≫ V_bar.hom) := by
          rw [AlgebraicGeometry.morphismRestrict_ι π_bar.left V₀]
      _ = U_open.ι ≫ (O₀.ι ≫ (π_bar.left ≫ V_bar.hom)) := by
          simp only [CategoryTheory.Category.assoc]
      _ = U_open.ι ≫ (O₀.ι ≫ Y_bar.hom) := by
          rw [CategoryTheory.Over.w π_bar]
  have hs_xU_V₀_sec : (s_xU ≫ (U_open.ι ≫ π₀)) ≫ (V₀.ι ≫ V_bar.hom) = 𝟙 S_k := by
    rw [CategoryTheory.Category.assoc, hπ₀_k]
    exact hs_xU_sec
  have hs_v₁_V₀_sec : (s_v₁ ≫ v_to_V₀') ≫ (V₀.ι ≫ V_bar.hom) = 𝟙 S_k := by
    refine (CategoryTheory.Category.assoc s_v₁ v_to_V₀' (V₀.ι ≫ V_bar.hom)).trans ?_
    refine (congrArg (s_v₁ ≫ ·) (CategoryTheory.Category.assoc v_to_V₀' V₀.ι V_bar.hom).symm).trans ?_
    exact hs_v₁_sec
  have hs_V₀_range_eq :
      Set.range (s_xU ≫ (U_open.ι ≫ π₀)).base = Set.range (s_v₁ ≫ v_to_V₀').base := by
    rw [hRangeSingletonComp s_xU (U_open.ι ≫ π₀) x_U hs_xU_range,
      hRangeSingletonComp s_v₁ v_to_V₀' v₁ hs_v₁_range]
    congr 1
    exact hx_U_fib.trans hv₁_to_b₀.symm
  have hs_eq_V₀ : s_xU ≫ (U_open.ι ≫ π₀) = s_v₁ ≫ v_to_V₀' :=
    hSecEq V₀.toScheme (V₀.ι ≫ V_bar.hom)
      (s_xU ≫ (U_open.ι ≫ π₀)) (s_v₁ ≫ v_to_V₀')
      hs_xU_V₀_sec hs_v₁_V₀_sec hs_V₀_range_eq

  let s_x₁ : S_k ⟶ W₁_open.toScheme := hPb_W₁.lift s_xU s_v₁ hs_eq_V₀
  have hs_x₁_fst : s_x₁ ≫ (q_Y₁ ∣_ U_open) = s_xU := hPb_W₁.lift_fst _ _ _
  have hs_x₁_snd : s_x₁ ≫ (W₁_open.ι ≫ f_bar₁) = s_v₁ := hPb_W₁.lift_snd _ _ _
  let s_x₁' : S_k ⟶ (Fgt_Y.obj W₁).left := s_x₁
  have hs_x₁_sec : s_x₁' ≫ ((Fgt_Y.obj W₁).hom ≫ Y_bar.hom) = 𝟙 S_k := by
    rw [← hComp_jW₁]
    change s_x₁ ≫ (((q_Y₁ ∣_ U_open) ≫ j_U) ≫ p_W₀) = 𝟙 S_k
    rw [CategoryTheory.Category.assoc (q_Y₁ ∣_ U_open), hComp_jU,
      ← CategoryTheory.Category.assoc s_x₁, hs_x₁_fst]
    exact hs_xU_sec
  obtain ⟨x₁, hs_x₁_range, hx₁_cl⟩ :=
    hClosedOfSec (Fgt_Y.obj W₁).left ((Fgt_Y.obj W₁).hom ≫ Y_bar.hom) s_x₁' hs_x₁_sec
  have hx₁_qU : (q_Y₁ ∣_ U_open).base x₁ = x_U := by
    have hr := hRangeSingletonComp s_x₁ (q_Y₁ ∣_ U_open) x₁ hs_x₁_range
    rw [hs_x₁_fst, hs_xU_range] at hr
    exact Set.singleton_eq_singleton_iff.mp hr.symm
  have hx₁_map : j_W₁.base x₁ = x₀ := by
    change j_U.base ((q_Y₁ ∣_ U_open).base x₁) = x₀
    rw [hx₁_qU, hx_U_map]
  have hx₁_fib : f_bar₁.base (W₁_open.ι.base (e_W₁.hom.base x₁)) = v₁ := by
    have hr := hRangeSingletonComp s_x₁ (W₁_open.ι ≫ f_bar₁) x₁ hs_x₁_range
    rw [hs_x₁_snd, hs_v₁_range] at hr
    exact Set.singleton_eq_singleton_iff.mp hr.symm

  
  let C_fib_left : AlgebraicGeometry.Scheme.{u} :=
    CategoryTheory.Limits.pullback f_bar₁ s_v₁
  let ι_Cfib : C_fib_left ⟶ Y₁ :=
    CategoryTheory.Limits.pullback.fst f_bar₁ s_v₁
  let C_fib : CategoryTheory.Over S_k :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_bar₁ s_v₁)
  let U_fib : C_fib.left.Opens :=
    (TopologicalSpace.Opens.map ι_Cfib.base).obj W₁_open
  have hPb_Cfib : CategoryTheory.IsPullback ι_Cfib C_fib.hom f_bar₁ s_v₁ :=
    CategoryTheory.IsPullback.of_hasPullback f_bar₁ s_v₁
  have hSm_Cfib : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_fib.hom :=
    (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
      hPb_Cfib hSm_f₁
  have hInt_Cfib : AlgebraicGeometry.IsIntegral C_fib.left :=
    (hFibIrredInt k s_v₁).2

  have hProj_Cfib : IsProjectiveOverField k C_fib := by
    have hCl_sv₁_Vbar : AlgebraicGeometry.IsClosedImmersion
        (s_v₁ ≫ (Fgt_V.obj V₁).hom) := by
      have : AlgebraicGeometry.IsClosedImmersion
          ((s_v₁ ≫ (Fgt_V.obj V₁).hom) ≫ V_bar.hom) := by
        rw [CategoryTheory.Category.assoc, hs_v₁_sec]
        infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp
        (s_v₁ ≫ (Fgt_V.obj V₁).hom) V_bar.hom
    have hPb_C_Ybar : CategoryTheory.IsPullback
        (ι_Cfib ≫ g_Y₁) C_fib.hom π_bar.left (s_v₁ ≫ (Fgt_V.obj V₁).hom) :=
      hPb_Cfib.paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback π_bar.left (Fgt_V.obj V₁).hom)
    have hCl_C_Ybar : AlgebraicGeometry.IsClosedImmersion (ι_Cfib ≫ g_Y₁) :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.IsClosedImmersion) hPb_C_Ybar.flip hCl_sv₁_Vbar
    have : AlgebraicGeometry.IsClosedImmersion (ι_Cfib ≫ g_Y₁) := hCl_C_Ybar
    obtain ⟨N_proj, ι_proj, hCl_proj⟩ := hProj_Ybar
    have : AlgebraicGeometry.IsClosedImmersion ι_proj.left := hCl_proj
    have hC_proj_w :
        ((ι_Cfib ≫ g_Y₁) ≫ ι_proj.left) ≫ (weilProjectiveSpaceOver k N_proj).hom =
          C_fib.hom := by
      calc
        ((ι_Cfib ≫ g_Y₁) ≫ ι_proj.left) ≫ (weilProjectiveSpaceOver k N_proj).hom
          = (ι_Cfib ≫ g_Y₁) ≫ (ι_proj.left ≫ (weilProjectiveSpaceOver k N_proj).hom) :=
              CategoryTheory.Category.assoc _ _ _
        _ = (ι_Cfib ≫ g_Y₁) ≫ Y_bar.hom := by rw [CategoryTheory.Over.w ι_proj]
        _ = (ι_Cfib ≫ g_Y₁) ≫ (π_bar.left ≫ V_bar.hom) := by
              rw [← CategoryTheory.Over.w π_bar]
        _ = ((ι_Cfib ≫ g_Y₁) ≫ π_bar.left) ≫ V_bar.hom :=
              (CategoryTheory.Category.assoc _ _ _).symm
        _ = (C_fib.hom ≫ (s_v₁ ≫ (Fgt_V.obj V₁).hom)) ≫ V_bar.hom := by
              rw [hPb_C_Ybar.w]
        _ = C_fib.hom ≫ ((s_v₁ ≫ (Fgt_V.obj V₁).hom) ≫ V_bar.hom) :=
              CategoryTheory.Category.assoc _ _ _
        _ = C_fib.hom ≫ 𝟙 S_k := by
              rw [CategoryTheory.Category.assoc, hs_v₁_sec]
        _ = C_fib.hom := CategoryTheory.Category.comp_id _
    exact ⟨N_proj, CategoryTheory.Over.homMk ((ι_Cfib ≫ g_Y₁) ≫ ι_proj.left) hC_proj_w,
      show AlgebraicGeometry.IsClosedImmersion ((ι_Cfib ≫ g_Y₁) ≫ ι_proj.left) from inferInstance⟩

  have hCl_sv₁ : AlgebraicGeometry.IsClosedImmersion s_v₁ := by
    have : AlgebraicGeometry.IsClosedImmersion (s_v₁ ≫ p_V₁) := by
      rw [hs_v₁_sec]; infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp s_v₁ p_V₁
  have hCl_ιCfib : AlgebraicGeometry.IsClosedImmersion ι_Cfib :=
    CategoryTheory.MorphismProperty.of_isPullback
      (P := @AlgebraicGeometry.IsClosedImmersion) hPb_Cfib.flip hCl_sv₁
  have : AlgebraicGeometry.IsClosedImmersion ι_Cfib := hCl_ιCfib
  have hAff_Ufib : AlgebraicGeometry.IsAffineOpen U_fib :=
    hAff_W₁open.preimage ι_Cfib

  have hNonempty_Sk : Nonempty ↥S_k :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := k)).mpr inferInstance
  let pt_k : ↥S_k := Classical.choice hNonempty_Sk

  have hNe_Ufib : Nonempty ↥U_fib := by
    let c_in : S_k ⟶ C_fib.left :=
      CategoryTheory.Limits.pullback.lift (s_x₁ ≫ W₁_open.ι) (𝟙 S_k) (by
        rw [CategoryTheory.Category.assoc, hs_x₁_snd, CategoryTheory.Category.id_comp])
    refine ⟨⟨c_in.base pt_k, ?_⟩⟩
    change (c_in ≫ ι_Cfib).base pt_k ∈ W₁_open
    rw [CategoryTheory.Limits.pullback.lift_fst]
    exact (s_x₁.base pt_k).2

  have hProper_Ufib : (U_fib : Set ↥C_fib.left) ≠ Set.univ := by
    intro hUniv
    let a₀ : Fin s_pts := ⟨0, hs_pts_pos⟩
    let c_out : S_k ⟶ C_fib.left :=
      CategoryTheory.Limits.pullback.lift (s_v₁ ≫ σ a₀) (𝟙 S_k) (by
        rw [CategoryTheory.Category.assoc, hσ_sec a₀,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hmem : c_out.base pt_k ∈ (U_fib : Set ↥C_fib.left) := by
      rw [hUniv]; trivial
    have hW_mem : ι_Cfib.base (c_out.base pt_k) ∈ (W₁_open : Set ↥Y₁) := hmem
    rw [hW₁_compl] at hW_mem
    apply hW_mem
    refine Set.mem_iUnion.mpr ⟨a₀, s_v₁.base pt_k, ?_⟩
    change (s_v₁ ≫ σ a₀).base pt_k = (c_out ≫ ι_Cfib).base pt_k
    rw [CategoryTheory.Limits.pullback.lift_fst]

  exact ⟨{
    Y_bar := Y_bar
    V_bar := V_bar
    π_bar := π_bar
    V₁ := V₁
    u_V₁ := u_V₁
    v₁ := v₁
    s_v₁ := s_v₁
    Y₁ := Y₁
    f_bar₁ := f_bar₁
    g_Y₁ := g_Y₁
    s_pts := s_pts
    σ := σ
    W₁_open := W₁_open
    W₁ := W₁
    e_W₁ := e_W₁
    j_W₁ := j_W₁
    x₁ := x₁
    C_fib := C_fib
    ι_Cfib := ι_Cfib
    U_fib := U_fib
    hProp_Ybar := hProp_Ybar
    hProj_Ybar := hProj_Ybar
    hProp_Vbar := hProp_Vbar
    hProp_πbar := hProp_πbar
    hAff_V₁ := hAff_V₁
    hInt_V₁ := hInt_V₁
    hEt_uV₁ := hEt_uV₁
    hComp_uV₁ := hComp_uV₁
    hv₁_cl := hv₁_cl
    hs_v₁_range := hs_v₁_range
    hs_v₁_sec := hs_v₁_sec
    hInt_Y₁ := hInt_Y₁
    hProp_f₁ := hProp_f₁
    hSm_f₁ := hSm_f₁
    hComm_Y₁ := hComm_Y₁
    hOpen_Y₁ := hOpen_Y₁
    hClosed_Y₁ := hClosed_Y₁
    hIrred_fib := fun Ω _ _ s => (hFibIrredInt Ω s).1
    hs_pts_pos := hs_pts_pos
    hσ_sec := hσ_sec
    hσ_cl := hσ_cl
    hσ_disj := hσ_disj
    hW₁_compl := hW₁_compl
    hAff_W₁open := hAff_W₁open
    he_W₁_hom := he_W₁_hom
    hEt_jW₁ := hEt_jW₁
    hComp_jW₁ := hComp_jW₁
    hx₁_map := hx₁_map
    hx₁_cl := hx₁_cl
    hx₁_fib := hx₁_fib
    hInt_Cfib := hInt_Cfib
    hProj_Cfib := hProj_Cfib
    hSm_Cfib := hSm_Cfib
    hPb_Cfib := hPb_Cfib
    hU_fib_eq := rfl
    hAff_Ufib := hAff_Ufib
    hNe_Ufib := hNe_Ufib
    hProper_Ufib := hProper_Ufib
  }⟩

theorem weil_algClosed_pointed_elementary_curve_fibration (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
    (u₀ : Quiver.Hom W₀ (weilAffineSpaceOver k (δ + 1)).left) [AlgebraicGeometry.Etale u₀]
    (x₀ : ↥W₀) (hx₀ : IsClosed ({x₀} : Set ↥W₀)) :
    Nonempty (WeilElementaryFibrationPkg k δ W₀
      (CategoryTheory.CategoryStruct.comp u₀ (weilAffineSpaceOver k (δ + 1)).hom) x₀) :=
by
  classical
  let _ := hℓ
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let p_W₀ : W₀ ⟶ S_k := u₀ ≫ (weilAffineSpaceOver k (δ + 1)).hom

  
  have hProperProjSpace :
      ∀ N : ℕ, AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
    intro N
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
      intro z
      have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
      rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
      obtain ⟨c, hc⟩ := hz0
      exact ⟨c, Subtype.ext hc⟩
    have : Nontrivial ↥(𝒜 0) :=
      ⟨⟨0, 1, fun h =>
        zero_ne_one (congrArg Subtype.val h : (0 : MvPolynomial (Fin (N + 1)) k) = 1)⟩⟩
    have hBij0 : Function.Bijective (algebraMap k ↥(𝒜 0)) :=
      ⟨RingHom.injective (algebraMap k ↥(𝒜 0)), hSurj0⟩
    let e0 := RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hBij0
    have : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) := by
      have : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
        ⟨⟨CommRingCat.ofHom e0.symm.toRingHom,
          CommRingCat.hom_ext (RingHom.ext e0.symm_apply_apply),
          CommRingCat.hom_ext (RingHom.ext e0.apply_symm_apply)⟩⟩
      infer_instance
    dsimp [weilProjectiveSpaceOver]
    infer_instance

  have hProperOfProj :
      ∀ (Y : CategoryTheory.Over S_k),
        IsProjectiveOverField k Y → AlgebraicGeometry.IsProper Y.hom := by
    rintro Y ⟨N, ι, hCl⟩
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := hProperProjSpace N
