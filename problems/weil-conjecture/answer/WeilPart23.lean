    apply (adj₁.homEquiv A (C₁.obj A)).injective
    rw [Adjunction.homEquiv_naturality_right]
    have hα : adj₁.homEquiv A (R_ab.obj (C₂.obj A)) α_A =
        adj₂.unit.app A ≫ (C₂.obj A).obj.map μ₁₂.op :=
      Equiv.apply_symm_apply _ _
    let u_app : ∀ U : E₂,
        (C₂.obj A).obj.obj (Opposite.op U) ⟶ (C₁.obj A).obj.obj (Opposite.op (G.obj U)) :=
      fun U => u_std_A.hom.app (Opposite.op U)
    have hu_T₂ : adj₂.unit.app A ≫ u_app T₂ =
        adj₁.unit.app A ≫ (C₁.obj A).obj.map τ_std.op :=
