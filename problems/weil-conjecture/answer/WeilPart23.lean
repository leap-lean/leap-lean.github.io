    let to_B : C_U → B := fun c => Classical.choose (hCU_to_B c)
    have hto_B : ∀ c : C_U, τ (to_B c) = ψ c := fun c => Classical.choose_spec (hCU_to_B c)
    let from_B : B → C_U := fun b => Classical.choose (hB_to_CU b)
    have hfrom_B : ∀ b : B, ψ (from_B b) = τ b := fun b => Classical.choose_spec (hB_to_CU b)
    let Ξ : C_U ≃+* B :=
      { toFun := to_B
        invFun := from_B
        left_inv := fun c => hInj_ψ ((hfrom_B (to_B c)).trans (hto_B c))
