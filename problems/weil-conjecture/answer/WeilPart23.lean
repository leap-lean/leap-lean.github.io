    have hη_inv : η_pull.inv = (adj_RP.leftAdjointUniq adj_pull).hom := rfl
    have hmate : adj_RP.homEquiv (C₂.obj A) (C₁.obj A) π_tilde = u_std_A := by
      dsimp only [π_tilde, π_std_A]
      rw [hη_inv, Adjunction.homEquiv_naturality_right,
