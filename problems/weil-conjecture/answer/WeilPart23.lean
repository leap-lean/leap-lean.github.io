    refine ⟨?_, ?_⟩
    · exact Finite.of_injective
        (fun z : ↥Z₀ => (⟨i_Z z, hRange ▸ ⟨z, rfl⟩⟩ : ↥S))
        (fun z₁ z₂ h => hEmb.injective (congrArg Subtype.val h))
