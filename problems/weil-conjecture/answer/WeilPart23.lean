        (F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp
        (((CategoryTheory.sheafCompose J (CategoryTheory.forget AddCommGrpCat.{u})).obj F).property)
      have hMem : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Z_c f_c) ∈ J W := by
        rw [hMemJ_iff]
        intro x
