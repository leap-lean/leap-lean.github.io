                mkQ (MvPolynomial.rename ι_old (MvPolynomial.X β)) := by
                rw [hf, MvPolynomial.rename_X]
          _ = mkQ (MvPolynomial.rename ι_old (P * MvPolynomial.X β)) := by
                simp only [map_mul]
