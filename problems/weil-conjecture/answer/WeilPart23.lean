      let T_C : C_bar.left.Etale := weilEtaleIdTerminal.{u} C_bar.left
      let hT_C : CategoryTheory.Limits.IsTerminal T_C := weilEtaleIdTerminalIsTerminal.{u} C_bar.left
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
