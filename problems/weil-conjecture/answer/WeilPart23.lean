      intro W
      apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp W.smallEtaleTopology
        (weilAltLocConstPresheaf W m) (CategoryTheory.forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
      intro U R hR
