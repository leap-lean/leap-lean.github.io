          rw [← (C.obj AM).obj.map_comp, ← (C.obj AM).obj.map_comp, ← op_comp, ← op_comp, hcomm])
      have hw₁ : Ψ_fun U (g₁ + g₂) = w := huniq₁₂ (Ψ_fun U (g₁ + g₂)) (fun _ _ _ => rfl)
      have hw₂ : Ψ_fun U g₁ + Ψ_fun U g₂ = w := by
        apply huniq₁₂ (Ψ_fun U g₁ + Ψ_fun U g₂)
        rintro V f ⟨⟨a₁, ha₁⟩, ⟨a₂, ha₂⟩⟩
        have ha₁₂ : ∀ y : ↥V.left, (g₁ + g₂) (f.left y) = a₁ + a₂ := by
