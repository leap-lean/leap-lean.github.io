            (by
              change p₂ ≫ (Fgt.obj Z₂).hom = p₁ ≫ (Fgt.obj Z₁).hom
              have hw₁ : m₁ ≫ (Fgt.obj W).hom = (Fgt.obj Z₁).hom :=
