    rwa [hF_cast1, hF_last1] at hCh
  have hEt_Wπ : AlgebraicGeometry.Etale (W_π_et.ι ≫ π.left) :=
    (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero (W_π_et.ι ≫ π.left)).mpr hSm0_Wπ

  let K_π : Set P_amb.left := π.left.base '' ((W_π_et : Set V_norm.left)ᶜ)
  have hClosed_Kπ : IsClosed K_π :=
    AlgebraicGeometry.Scheme.Hom.isClosedMap π.left _ W_π_et.isOpen.isClosed_compl
  let U_et_π : P_amb.left.Opens := ⟨K_πᶜ, hClosed_Kπ.isOpen_compl⟩

  have hSub_et_π : ((U_proj : Set P_amb.left)ᶜ) ⊆ (U_et_π : Set P_amb.left) := by
    rintro y hy_not ⟨x, hx_not_Wπ, rfl⟩
    have hx_S₀ : x ∈ S₀ := hy_not
    obtain ⟨hxMm, hxFm⟩ := (hS₀_iff x).mp hx_S₀
    have hx_Wreg : x ∈ W_reg := by
      by_contra hx_sing
      have hIn : ι_V.left.base x ∈ Y_sing ∩ M_m := ⟨⟨x, hx_sing, rfl⟩, hxMm⟩
      rw [hEmpty_SingMm] at hIn
      exact hIn
    have hx_not_Flast : ι_V.left.base x ∉ weilProjHyperplaneSet k N F_last_form := by
      intro hxFlast
      have hIn : ι_V.left.base x ∈
          ((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ∩
            weilProjHyperplaneSet k N F_last_form :=
        ⟨⟨⟨⟨x, trivial, rfl⟩, hxMm⟩, hxFm⟩, hxFlast⟩
      rw [hEmpty_TotAll] at hIn
      exact hIn
    have hx_Fm1 : ∀ i : Fin (m + 1), ι_V.left.base x ∈ weilProjHyperplaneSet k N (F_m1 i) := by
      refine Fin.lastCases ?_ (fun j => ?_)
      · simpa [F_m1] using hxFm
      · simpa [F_m1] using hxMm j
    exact hx_not_Wπ (hWπ_mem x hx_Wreg hx_not_Flast hx_Fm1)

  have hPre_et_π : π.left ⁻¹ᵁ U_et_π ≤ W_π_et := by
    intro x hx
    by_contra hx_not
    exact hx ⟨x, hx_not, rfl⟩
  have hPb_et_π := hRestrictSub π.left W_π_et U_et_π hPre_et_π
  have hEt_π : AlgebraicGeometry.Etale (π.left ∣_ U_et_π) :=
    CategoryTheory.MorphismProperty.of_isPullback (P := @AlgebraicGeometry.Etale)
      hPb_et_π.flip hEt_Wπ

  
  obtain ⟨W_V, hWV_mem, hWV_G, hWV_sm⟩ :=
    weil_transversalLinearSlice_relative_smooth_chart k N 1 m
      V_norm ι_V hClV W_reg F_init hSlV_m F_m_form hFm_hom

  obtain ⟨hWU, hChart_WV'⟩ := hChart_WV W_V (by rwa [hF_m_eq])
  rw [hF_init_eq, hF_m_eq] at hChart_WV'
  have hSm1_WV : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (V_norm.left.homOfLE hWU ≫ (π.left ∣_ U_proj) ≫ pr_p₀) :=
    hWV_sm _ hChart_WV'

  let j_sm₀ : W_V.toScheme ⟶ U_φ₁.toScheme := V_norm.left.homOfLE hWU
  let W_sm₀ : U_φ₁.toScheme.Opens := j_sm₀.opensRange

  have hSm_Wsm₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1
      (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
    have hEq : W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀ =
        j_sm₀.isoOpensRange.inv ≫ (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
      calc W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀
          = (j_sm₀.isoOpensRange.inv ≫ j_sm₀.isoOpensRange.hom) ≫
              W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀ := by
              rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = j_sm₀.isoOpensRange.inv ≫ (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
              rw [CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι_assoc]
    rw [hEq]
    have : AlgebraicGeometry.SmoothOfRelativeDimension 0 j_sm₀.isoOpensRange.inv := inferInstance
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := hSm1_WV
    have : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
        (j_sm₀.isoOpensRange.inv ≫ (j_sm₀ ≫ (π.left ∣_ U_proj) ≫ pr_p₀)) := inferInstance
    simpa using this

  have hb_star_sm :
      ∀ x : ↥U_φ₁.toScheme,
        ((π.left ∣_ U_proj) ≫ pr_p₀).base x = b_star → x ∈ W_sm₀ := by
    intro x hEq
    obtain ⟨hxNotFm, hxMm_raw⟩ := (hb_star_iff x).mp hEq
    rw [hF_m_eq] at hxNotFm
    have hxMm : ∀ j : Fin m, ι_V.left.base x.1 ∈ weilProjHyperplaneSet k N (F_init j) := by
      intro j
      have h := hxMm_raw j
      rwa [congrFun hF_init_eq j] at h
    have hx_Wreg : x.1 ∈ W_reg := by
      by_contra hx_sing
      have hIn : ι_V.left.base x.1 ∈ Y_sing ∩ M_m := ⟨⟨x.1, hx_sing, rfl⟩, hxMm⟩
      rw [hEmpty_SingMm] at hIn
      exact hIn
    have hx_WV : x.1 ∈ W_V := hWV_mem x.1 hx_Wreg hxNotFm hxMm
    refine ⟨⟨x.1, hx_WV⟩, ?_⟩
    apply Subtype.ext
    exact AlgebraicGeometry.Scheme.homOfLE_apply hWU ⟨x.1, hx_WV⟩

  
  obtain ⟨W_et₀, hWet_mem, hWet_G, hWet_sm⟩ :=
    weil_transversalLinearSlice_relative_smooth_chart k N 0 m
      Z_over ι_Z_proj hClZ_proj U_sm_div F_init hSlZ_m F_m_form hFm_hom

  have hSm0_Wet₀ : AlgebraicGeometry.SmoothOfRelativeDimension 0
      (W_et₀.ι ≫ j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
    apply hWet_sm
    rw [hιZ_left_eq]
    have hCh := hChart_Zdiv W_et₀ (by rw [← hιZ_left_eq, hF_m_eq]; exact hWet_G)
    rwa [hF_init_eq, hF_m_eq] at hCh
  have hEt_Wet₀ : AlgebraicGeometry.Etale
      (W_et₀.ι ≫ j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀) :=
    (AlgebraicGeometry.Etale.iff_smoothOfRelativeDimension_zero _).mpr hSm0_Wet₀

  have hb_star_et :
      ∀ z : Z_div,
        (j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀).base z = b_star → z ∈ W_et₀ := by
    intro z hEq
    have hEq' : ((π.left ∣_ U_proj) ≫ pr_p₀).base (j_div.base z) = b_star := hEq
    obtain ⟨hzNotFm, hzMm_raw⟩ := (hb_star_iff (j_div.base z)).mp hEq'
    have hj_val : (j_div.base z).1 = ι_div.base z := by
      rw [← AlgebraicGeometry.Scheme.Opens.ι_apply U_φ₁ (j_div.base z)]
      change (j_div ≫ U_φ₁.ι).base z = ι_div.base z
      rw [hj_div_ι]
    have hz_eq : ι_Z_proj.left.base z = ι_V.left.base (ι_div.base z) := by
      rw [hιZ_left_eq]
      rfl
    rw [hj_val, hF_m_eq, ← hz_eq] at hzNotFm
    have hzMm : ∀ j : Fin m,
        ι_Z_proj.left.base z ∈ weilProjHyperplaneSet k N (F_init j) := by
      intro j
      have h := hzMm_raw j
      rw [hj_val, congrFun hF_init_eq j, ← hz_eq] at h
      exact h
    have hz_Usm : z ∈ U_sm_div := by
      by_contra hz_sing
      have hIn : ι_V.left.base (ι_div.base z) ∈ Y_divSing ∩ M_m := by
        refine ⟨⟨ι_div.base z, ⟨z, hz_sing, rfl⟩, rfl⟩, fun j => ?_⟩
        rw [← hz_eq]
        exact hzMm j
      rw [hEmpty_DivSingMm] at hIn
      exact hIn
    exact hWet_mem z hz_Usm hzNotFm hzMm

  
  
  
  have hx_proj : π.left.base x_norm ∈ U_proj := by
    rw [hPre_Uproj x_norm]
    refine ⟨Fin.last m, ?_⟩
    rw [hF_m_eq]
    exact hq_not_Fm

  have hx_bstar :
      ((π.left ∣_ U_proj) ≫ pr_p₀).base ⟨x_norm, hx_proj⟩ = b_star := by
    rw [hb_star_iff ⟨x_norm, hx_proj⟩]
    refine ⟨?_, ?_⟩
    · change q_star ∉ weilProjHyperplaneSet k N (F (Fin.last m).castSucc)
      rwa [hF_m_eq]
    · intro j
      change q_star ∈ weilProjHyperplaneSet k N (F (j.castSucc).castSucc)
      rw [congrFun hF_init_eq j]
      exact hq_Finit j

  have hb_Dbase : b_star ∈ D_base := by
    have hx_WV : x_norm ∈ W_V := hWV_mem x_norm (hU_le_reg hx_in) hq_not_Fm hq_Finit
    obtain ⟨hW_sub, hdeg_W, hsub_W, hG_W, hT_W, hpos_W, hψ_eq⟩ := hChart_WV'
    have hHomEq :
        (V_norm.left.homOfLE hWU).base ⟨x_norm, hx_WV⟩ =
          (⟨x_norm, hx_proj⟩ : ↥U_φ₁.toScheme) := by
      apply Subtype.ext
      exact AlgebraicGeometry.Scheme.homOfLE_apply hWU ⟨x_norm, hx_WV⟩
    have hb_eq :
        b_star = (V_norm.left.homOfLE hWU ≫ (π.left ∣_ U_proj) ≫ pr_p₀).base ⟨x_norm, hx_WV⟩ := by
      change b_star = ((π.left ∣_ U_proj) ≫ pr_p₀).base
        ((V_norm.left.homOfLE hWU).base ⟨x_norm, hx_WV⟩)
      rw [hHomEq, hx_bstar]
    rw [hb_eq, hψ_eq]
    have hMemRange :
        (V_norm.left.homOfLE hW_sub ≫
          (ι_V.left ∣_ AlgebraicGeometry.Proj.basicOpen 𝒜_N F_m_form) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N F_m_form hG_W hpos_W).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (HomogeneousLocalization.map
              { toRingHom := MvPolynomial.eval₂Hom MvPolynomial.C (Fin.snoc F_init F_m_form),
                map_mem := @hdeg_W }
              hsub_W)) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X (Fin.last m)) hT_W hpos_W).base
            ⟨x_norm, hx_WV⟩ ∈
          (AlgebraicGeometry.Proj.awayι 𝒜_m (MvPolynomial.X (Fin.last m)) hT_W hpos_W).opensRange :=
      ⟨_, rfl⟩
    rwa [AlgebraicGeometry.Proj.opensRange_awayι 𝒜_m (MvPolynomial.X (Fin.last m)) hT_W hpos_W]
      at hMemRange

  have hx_amb : π.left.base x_norm ∈ D_amb := by
    obtain ⟨_, _, hPr_charts⟩ := hPr
    let u_x : ↥U_proj := (π.left ∣_ U_proj).base ⟨x_norm, hx_proj⟩
    have hpr_ux : pr_p₀.base u_x ∈ D_base := by
      have heq : pr_p₀.base u_x = b_star := hx_bstar
      rwa [heq]
    have hu_amb : u_x.1 ∈ D_amb := ((hPr_charts (Fin.last m)).1 u_x).mp hpr_ux
    have hu_val : u_x.1 = π.left.base x_norm := by
      rw [← AlgebraicGeometry.Scheme.Opens.ι_apply U_proj u_x]
      change ((π.left ∣_ U_proj) ≫ U_proj.ι).base ⟨x_norm, hx_proj⟩ = π.left.base x_norm
      rw [AlgebraicGeometry.morphismRestrict_ι π.left U_proj]
      rfl
    rwa [hu_val] at hu_amb

  have hb_cl : IsClosed ({b_star} : Set ↥B₀.left) := by
    have hDim_xn : topologicalKrullDim ↥({x_norm} : Set ↥V_norm.left) ≤ (0 : WithBot ℕ∞) :=
      hSubDim0
    obtain ⟨q_xn, hq_xn_hom, pt_xn, hpt_xn⟩ :=
      hRatLift V_norm ι_V hClV {x_norm} hx_cl hDim_xn x_norm (Set.mem_singleton x_norm)
    have : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      change Subsingleton (PrimeSpectrum k)
      infer_instance
    have hRange_qxn : Set.range q_xn.base ⊆ Set.range U_φ₁.ι.base := by
      rw [U_φ₁.range_ι]
      rintro _ ⟨pt, rfl⟩
      rw [Subsingleton.elim pt pt_xn, hpt_xn]
      exact hx_proj
    let q_xn' : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ U_φ₁.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_φ₁.ι q_xn hRange_qxn
    have hq_xn'_fac : q_xn' ≫ U_φ₁.ι = q_xn :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_φ₁.ι q_xn hRange_qxn
    let s_b : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ B₀.left :=
      q_xn' ≫ (π.left ∣_ U_proj) ≫ pr_p₀
    have hs_b_hom : s_b ≫ B₀.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
      calc s_b ≫ B₀.hom
          = q_xn' ≫ (π.left ∣_ U_proj) ≫ (pr_p₀ ≫ B₀.hom) := by
              simp only [s_b, CategoryTheory.Category.assoc]
        _ = q_xn' ≫ ((π.left ∣_ U_proj) ≫ U_proj.ι) ≫ P_amb.hom := by
              rw [hPr.1, CategoryTheory.Category.assoc]
        _ = (q_xn' ≫ U_φ₁.ι) ≫ (π.left ≫ P_amb.hom) := by
              rw [AlgebraicGeometry.morphismRestrict_ι π.left U_proj]
              simp only [U_φ₁, CategoryTheory.Category.assoc]
        _ = q_xn ≫ V_norm.hom := by
              rw [hq_xn'_fac, CategoryTheory.Over.w π]
        _ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := hq_xn_hom
    have : AlgebraicGeometry.IsClosedImmersion (s_b ≫ B₀.hom) := by
      rw [hs_b_hom]
      infer_instance
    have : AlgebraicGeometry.IsSeparated B₀.hom := by
      dsimp [B₀, weilProjectiveSpaceOver]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion s_b :=
      AlgebraicGeometry.IsClosedImmersion.of_comp s_b B₀.hom
    have hsb_pt : s_b.base pt_xn = b_star := by
      have hq'_pt : q_xn'.base pt_xn = ⟨x_norm, hx_proj⟩ := by
        apply U_φ₁.ι.isOpenEmbedding.injective
        change (q_xn' ≫ U_φ₁.ι).base pt_xn = x_norm
        rw [hq_xn'_fac]
        exact hpt_xn
      change ((π.left ∣_ U_proj) ≫ pr_p₀).base (q_xn'.base pt_xn) = b_star
      rw [hq'_pt]
      exact hx_bstar
    have hRange_sb : Set.range s_b.base = {b_star} := by
      ext y
      refine ⟨?_, ?_⟩
      · rintro ⟨pt, rfl⟩
        rw [Subsingleton.elim pt pt_xn, hsb_pt]
        exact rfl
      · rintro rfl
        exact ⟨pt_xn, hsb_pt⟩
    rw [← hRange_sb]
    exact s_b.isClosedEmbedding.isClosed_range

  exact ⟨π, U_et_π, q_sec, Z_div, ι_div, j_div, Z_low, b_star, W_sm₀, W_et₀,
    ⟨hFin_π, hSurj_π⟩,
    ⟨hSub_et_π, hEt_π⟩,
    ⟨hq_sec_hom, hq_sec_range⟩,
    hPt_lift,
    ⟨hCl_div, hRed_div, hClosed_low, hZ_decomp, hj_div_ι, hZ_low_sub, hFin_div⟩,
    hb_star_low,
    ⟨hb_star_sm, hSm_Wsm₀⟩,
    ⟨hb_star_et, hEt_Wet₀⟩,
    ⟨hb_Dbase, hb_cl⟩,
    ⟨hx_amb, hx_proj, hx_bstar⟩⟩

theorem weil_proj_basicOpen_dehomog_and_linearProj_polynomial_chart (k : Type u) [Field k] (m : ℕ) :
    let B₀ := weilProjectiveSpaceOver k m
    let U_proj := weilProjCenterComplOpen k m
    let 𝒜_m := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
    letI : GradedAlgebra 𝒜_m := MvPolynomial.gradedAlgebra
    let D_base := AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X (Fin.last m))
    (∃ e_Dbase : CategoryTheory.Iso D_base.toScheme (weilAffineSpaceOver k m).left,
      CategoryTheory.CategoryStruct.comp e_Dbase.hom (weilAffineSpaceOver k m).hom =
        CategoryTheory.CategoryStruct.comp D_base.ι B₀.hom) ∧
    (∀ (pr_p₀ : Quiver.Hom (U_proj : AlgebraicGeometry.Scheme.{u}) B₀.left),
      IsCenterComplLinearProjection k m pr_p₀ →
      ∀ (b : Fin (m + 1)),
        let D₀_b := AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X b)
        ∃ (R_b : Type u) (_ : CommRing R_b) (_ : Algebra k R_b)
          (e_base : CategoryTheory.Iso D₀_b.toScheme (AlgebraicGeometry.Spec (CommRingCat.of R_b)))
          (e_top : CategoryTheory.Iso (pr_p₀ ⁻¹ᵁ D₀_b).toScheme
            (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_b)))),
          (CategoryTheory.CategoryStruct.comp e_base.inv
            (CategoryTheory.CategoryStruct.comp D₀_b.ι B₀.hom) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R_b))) ∧
          (CategoryTheory.CategoryStruct.comp e_top.inv
            (CategoryTheory.CategoryStruct.comp (pr_p₀ ∣_ D₀_b) e_base.hom) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))) :=
by
  letI instGraded : ∀ n : ℕ, GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin n) k) :=
    fun _ => MvPolynomial.gradedAlgebra
  
  have hDehomog : ∀ (N : ℕ) (a : Fin (N + 1))
      (ha : MvPolynomial.X a ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1),
      ∃ (e : MvPolynomial {r : Fin (N + 1) // r ≠ a} k ≃+*
          HomogeneousLocalization.Away
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X a)),
        (∀ c : k, e (MvPolynomial.C c) =
          HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
            (Submonoid.powers (MvPolynomial.X a))
            (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) c)) ∧
        (∀ (r : Fin (N + 1)) (hr : r ≠ a)
            (hr_mem : MvPolynomial.X r ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1),
          e (MvPolynomial.X ⟨r, hr⟩) =
            HomogeneousLocalization.Away.isLocalizationElem ha hr_mem) := by
    intro N a ha
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let τ := {r : Fin (N + 1) // r ≠ a}
    let P := MvPolynomial (Fin (N + 1)) k
    let Pτ := MvPolynomial τ k
    let Xa : P := MvPolynomial.X a
    let S : Submonoid P := Submonoid.powers Xa
    let Ra := HomogeneousLocalization.Away 𝒜 Xa
    have hX : ∀ j : Fin (N + 1), (MvPolynomial.X j : P) ∈ 𝒜 1 :=
      fun j => (MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X j)).mpr
        (MvPolynomial.isHomogeneous_X k j)
    let ι_k : k →+* Ra :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 S).comp (algebraMap k ↥(𝒜 0))
    let u : τ → Ra := fun r => HomogeneousLocalization.Away.isLocalizationElem ha (hX r.1)
    let α : Pτ →+* Ra := MvPolynomial.eval₂Hom ι_k u
    have hα_C : ∀ c : k, α (MvPolynomial.C c) = ι_k c :=
      fun c => MvPolynomial.eval₂Hom_C ι_k u c
    have hα_X : ∀ r : τ, α (MvPolynomial.X r) = u r :=
      fun r => MvPolynomial.eval₂Hom_X' ι_k u r
    have hval_ι : ∀ c : k, HomogeneousLocalization.val (ι_k c) =
        Localization.mk (MvPolynomial.C c) (1 : ↥S) := fun c => rfl
    let w : Fin (N + 1) → Pτ := fun j => if hj : j = a then 1 else MvPolynomial.X ⟨j, hj⟩
    let dehom : P →+* Pτ := MvPolynomial.eval₂Hom MvPolynomial.C w
    have hdehom_C : ∀ c : k, dehom (MvPolynomial.C c) = MvPolynomial.C c :=
      fun c => MvPolynomial.eval₂Hom_C MvPolynomial.C w c
    have hdehom_X : ∀ j : Fin (N + 1), dehom (MvPolynomial.X j) = w j :=
      fun j => MvPolynomial.eval₂Hom_X' MvPolynomial.C w j
    have hdehom_S : ∀ y : ↥S, dehom y.1 = 1 := by
      rintro ⟨_, ⟨n, rfl⟩⟩
      rw [map_pow, hdehom_X a]
      simp only [w, ↓reduceDIte, one_pow]
    have hunit_S : ∀ y : ↥S, IsUnit (dehom y.1) := by
      intro y
      rw [hdehom_S y]
      exact isUnit_one
    let β_loc : Localization S →+* Pτ := IsLocalization.lift (S := Localization S) hunit_S
    have hβ_mk : ∀ (p : P) (y : ↥S), β_loc (Localization.mk p y) = dehom p := by
      intro p y
      rw [Localization.mk_eq_mk']
      exact (IsLocalization.lift_mk'_spec (S := Localization S) hunit_S p (dehom p) y).mpr
        (by rw [hdehom_S y, one_mul])
    let valHom : Ra →+* Localization S :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let β : Ra →+* Pτ := β_loc.comp valHom
    have hleft_hom : β.comp α = RingHom.id Pτ := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        simp only [RingHom.comp_apply, hα_C]
        change β_loc (HomogeneousLocalization.val (ι_k c)) = MvPolynomial.C c
        rw [hval_ι c, hβ_mk, hdehom_C]
      · rintro ⟨j, hj⟩
        simp only [RingHom.comp_apply, hα_X]
        change β_loc (HomogeneousLocalization.val (u ⟨j, hj⟩)) = MvPolynomial.X ⟨j, hj⟩
        dsimp [u, HomogeneousLocalization.Away.isLocalizationElem]
        rw [hβ_mk, pow_one, hdehom_X]
        simp only [w, hj, ↓reduceDIte]
    have hleft : Function.LeftInverse β α := fun q => RingHom.congr_fun hleft_hom q
    have hright : Function.RightInverse β α := by
      let φ : P →+* Localization S := valHom.comp (α.comp dehom)
      let s : ℕ → ↥S := fun n => ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩
      have hs0 : s 0 = 1 := Subtype.ext (pow_zero Xa)
      have hs_add : ∀ n₁ n₂ : ℕ, s n₁ * s n₂ = s (n₁ + n₂) :=
        fun n₁ n₂ => Subtype.ext (pow_add Xa n₁ n₂).symm
      have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        change HomogeneousLocalization.val (α (dehom (MvPolynomial.C c))) = _
        rw [hdehom_C, hα_C, hval_ι]
      have hφ_X : ∀ j : Fin (N + 1), φ (MvPolynomial.X j) =
          Localization.mk (MvPolynomial.X j) (s 1) := by
        intro j
        change HomogeneousLocalization.val (α (dehom (MvPolynomial.X j))) = _
        rw [hdehom_X]
        dsimp [w]
        split_ifs with hj
        · rw [hj, map_one]
          change HomogeneousLocalization.val (1 : Ra) = _
          rw [HomogeneousLocalization.val_one]
          have hs1 : s 1 = ⟨Xa, Submonoid.mem_powers Xa⟩ := Subtype.ext (pow_one Xa)
          rw [hs1]
          exact (Localization.mk_self (a := ⟨Xa, Submonoid.mem_powers Xa⟩)).symm
        · rw [hα_X]
          dsimp [u, HomogeneousLocalization.Away.isLocalizationElem]
          exact congrArg₂ Localization.mk (pow_one _) (Subtype.ext rfl)
      have hφ_Xpow : ∀ (j : Fin (N + 1)) (e : ℕ),
          φ (MvPolynomial.X j ^ e) = Localization.mk (MvPolynomial.X j ^ e) (s e) := by
        intro j e
        induction e with
        | zero => rw [pow_zero, map_one, hs0, Localization.mk_one]
        | succ e ih => rw [pow_succ, map_mul, ih, hφ_X j, Localization.mk_mul, hs_add]
      have hφ_prod : ∀ (d : Fin (N + 1) →₀ ℕ) (F : Finset (Fin (N + 1))),
          φ (∏ j ∈ F, MvPolynomial.X j ^ d j) =
            Localization.mk (∏ j ∈ F, MvPolynomial.X j ^ d j) (s (∑ j ∈ F, d j)) := by
        intro d F
        classical
        induction F using Finset.induction_on with
        | empty => rw [Finset.prod_empty, Finset.sum_empty, map_one, hs0, Localization.mk_one]
        | @insert j F hj ih =>
          rw [Finset.prod_insert hj, Finset.sum_insert hj, map_mul,
            hφ_Xpow j (d j), ih, Localization.mk_mul, hs_add]
      have hφ_mon : ∀ (d : Fin (N + 1) →₀ ℕ) (c : k),
          φ (MvPolynomial.monomial d c) =
            Localization.mk (MvPolynomial.monomial d c) (s (∑ j ∈ d.support, d j)) := by
        intro d c
        have hdp : (d.prod fun j e => (MvPolynomial.X j : P) ^ e) =
            ∏ j ∈ d.support, (MvPolynomial.X j : P) ^ d j := by
          simp only [Finsupp.prod]
        calc
          φ (MvPolynomial.monomial d c) =
              φ (MvPolynomial.C c * ∏ j ∈ d.support, MvPolynomial.X j ^ d j) := by
            rw [MvPolynomial.monomial_eq, hdp]
          _ = Localization.mk (MvPolynomial.C c) 1 *
              Localization.mk (∏ j ∈ d.support, MvPolynomial.X j ^ d j)
                (s (∑ j ∈ d.support, d j)) := by
            rw [map_mul, hφ_C c, hφ_prod d d.support]
          _ = Localization.mk (MvPolynomial.monomial d c) (s (∑ j ∈ d.support, d j)) := by
            rw [Localization.mk_mul, one_mul, ← hdp, ← MvPolynomial.monomial_eq]
      intro z
      obtain ⟨n, p, hp, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 ha z
      have hp_n : p ∈ 𝒜 n := by simpa using hp
      have hp_hom : MvPolynomial.IsHomogeneous p n :=
        (MvPolynomial.mem_homogeneousSubmodule n p).mp hp_n
      apply HomogeneousLocalization.val_injective S
      have hβ_z : β (HomogeneousLocalization.Away.mk 𝒜 ha n p hp) = dehom p := by
        change β_loc (HomogeneousLocalization.val (HomogeneousLocalization.Away.mk 𝒜 ha n p hp)) = _
        rw [HomogeneousLocalization.Away.val_mk, hβ_mk]
      rw [hβ_z, HomogeneousLocalization.Away.val_mk]
      change φ p = Localization.mk p ⟨Xa ^ n, _⟩
      have hsum : ∀ (F : Finset (Fin (N + 1) →₀ ℕ)), F ⊆ p.support →
          φ (∑ d ∈ F, MvPolynomial.monomial d (p.coeff d)) =
            Localization.mk (∑ d ∈ F, MvPolynomial.monomial d (p.coeff d)) (s n) := by
        intro F
        classical
        induction F using Finset.induction_on with
        | empty =>
          intro _
          rw [Finset.sum_empty, map_zero, Localization.mk_zero]
        | @insert d F hd ih =>
          intro hF
          have hd_mem : d ∈ p.support := hF (Finset.mem_insert_self d F)
          have hd_wt : ∑ j ∈ d.support, d j = n := by
            have h1 := hp_hom (MvPolynomial.mem_support_iff.mp hd_mem)
            simpa [Finsupp.weight_apply, Finsupp.sum] using h1
          rw [Finset.sum_insert hd, map_add, hφ_mon d (p.coeff d), hd_wt,
            ih (Finset.Subset.trans (Finset.subset_insert d F) hF),
            Localization.add_mk_self]
      have hp_eq := hsum p.support Finset.Subset.rfl
      rw [← MvPolynomial.as_sum p] at hp_eq
      exact hp_eq.trans (congrArg (Localization.mk p) (Subtype.ext rfl))
    let e : Pτ ≃+* Ra :=
      { α with
        invFun := β
        left_inv := hleft
        right_inv := hright }
    refine ⟨e, fun c => hα_C c, fun r hr hr_mem => ?_⟩
    exact hα_X ⟨r, hr⟩

  
  have hChartIso : ∀ (N : ℕ) (a : Fin (N + 1))
      (ha : MvPolynomial.X a ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1)
      (A : Type u) [CommRing A] [Algebra k A]
      (θ : A ≃+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X a)),
      (∀ c : k, θ (algebraMap k A c) =
        HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (Submonoid.powers (MvPolynomial.X a))
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) c)) →
      ∃ (e_chart : CategoryTheory.Iso
          (AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X a)).toScheme
          (AlgebraicGeometry.Spec (CommRingCat.of A))),
        e_chart.hom =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
            (MvPolynomial.X a) ha zero_lt_one).hom ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.toRingHom) ∧
        e_chart.inv =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.symm.toRingHom) ≫
            (AlgebraicGeometry.Proj.basicOpenIsoSpec
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
              (MvPolynomial.X a) ha zero_lt_one).inv ∧
        (e_chart.inv ≫
          ((AlgebraicGeometry.Proj.basicOpen
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X a)).ι ≫
            (weilProjectiveSpaceOver k N).hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))) := by
    intro N a ha A _ _ θ hθ_k
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let D_a := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X a)
    let isoSpec : AlgebraicGeometry.Spec
        (CommRingCat.of (HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X a))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
          congr 1
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro z
          exact θ.apply_symm_apply z
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
          congr 1
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro z
          exact θ.symm_apply_apply z }
    let e_chart : CategoryTheory.Iso D_a.toScheme (AlgebraicGeometry.Spec (CommRingCat.of A)) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X a) ha zero_lt_one ≪≫ isoSpec
    refine ⟨e_chart, rfl, rfl, ?_⟩
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.symm.toRingHom) ≫
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X a) ha zero_lt_one).inv) ≫
      (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X a)).ι ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A))
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X a) ha zero_lt_one).inv,
      AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι,
      ← CategoryTheory.Category.assoc
        (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X a) ha zero_lt_one),
      AlgebraicGeometry.Proj.awayι_toSpecZero,
      ← AlgebraicGeometry.Spec.map_comp,
      ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro c
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
    rw [← hθ_k c]
    exact θ.symm_apply_apply (algebraMap k A c)

  
  intro B₀ U_proj 𝒜_m D_base
  let 𝒜_m1 := MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k
