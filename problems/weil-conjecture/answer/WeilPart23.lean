      let U₂ : C'_bar.left.Opens := (TopologicalSpace.Opens.map bar_p.left.base).obj V₂
      ∀ (hcov_U : U₁ ⊔ U₂ = ⊤)
        (_ : AlgebraicGeometry.IsAffineOpen V₁)
        (_ : AlgebraicGeometry.IsAffineOpen U₁)
        (M₁ : Type u) (_ : AddCommGroup M₁)
        (_ : Module ↑(C_bar.left.presheaf.obj (Opposite.op V₁)) M₁)
        (bM₁ : Module.Basis (Fin ℓ) ↑(C_bar.left.presheaf.obj (Opposite.op V₁)) M₁)
        (eM₁ : M₁ ≃+ ↑(C'_bar.left.presheaf.obj (Opposite.op U₁))),
        (∀ (b : ↑(C_bar.left.presheaf.obj (Opposite.op V₁))) (m : M₁),
          eM₁ (b • m) = (bar_p.left.app V₁).hom b * eM₁ m) →
        ∀ (g₁ : ↑(C'_bar.left.presheaf.obj (Opposite.op U₁)))
          (L_g : M₁ →ₗ[↑(C_bar.left.presheaf.obj (Opposite.op V₁))] M₁),
          (∀ m : M₁, eM₁ (L_g m) = g₁ * eM₁ m) →
          ∀ (u_U : Units ↑(C'_bar.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂))))
            (u_V : Units ↑(C_bar.left.presheaf.obj (Opposite.op (V₁ ⊓ V₂)))),
            (u_U : ↑(C'_bar.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) =
              (C'_bar.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom g₁ →
            (u_V : ↑(C_bar.left.presheaf.obj (Opposite.op (V₁ ⊓ V₂)))) =
              (C_bar.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
                (((LinearMap.toMatrix bM₁ bM₁) L_g).det) →
            g_gm_shriek (δ_MV C'_bar U₁ U₂ hcov_U u_U) = δ_MV C_bar V₁ V₂ hcov_V u_V) :
    ∃ u₀ : weilEtaleTorsionH C'_bar.left ℓ 2, g_shriek u₀ ≠ 0 :=
by
  
  have hDescendDeg :
      ∀ {Q G C : Type u} [AddCommGroup Q] [AddCommGroup G] [AddCommGroup C]
        (δ : Q →+ G) (Φ : Q →+ C) (deg : C →+ ℤ),
        Function.Surjective δ →
        (∀ q : Q, δ q = 0 → Φ q = 0) →
        ∃ deg_G : G →+ ℤ, ∀ q : Q, deg_G (δ q) = deg (Φ q) := by
    intro Q G C _ _ _ δ Φ deg hsurj hker
    have hker_le : δ.ker ≤ Φ.ker := fun q hq => hker q hq
    let e_δ : (Q ⧸ δ.ker) ≃+ G := QuotientAddGroup.quotientKerEquivOfSurjective δ hsurj
    let Φ_bar : (Q ⧸ δ.ker) →+ C := QuotientAddGroup.lift δ.ker Φ hker_le
    refine ⟨deg.comp (Φ_bar.comp e_δ.symm.toAddMonoidHom), fun q => ?_⟩
    have he : e_δ.symm (δ q) = QuotientAddGroup.mk' δ.ker q :=
      e_δ.symm_apply_eq.mpr rfl
    change deg (Φ_bar (e_δ.symm (δ q))) = deg (Φ q)
    rw [he]
    rfl

  
  have hPigeonholeNeZero :
      ∀ {G H₂ : Type u} [AddCommGroup G] [AddCommGroup H₂]
        (δ : G →+ H₂) (κ_G : G →+ H₂) (deg_G : G →+ ℤ) (ξ : G),
        Function.Surjective δ →
        (∀ g_el : G, δ g_el = 0 ↔ ∃ v : G, ℓ • v = g_el) →
        (∀ z : H₂, ℓ • z = 0) →
        Nat.card H₂ = ℓ →
        Function.Surjective κ_G →
        deg_G ξ = 1 →
        κ_G ξ ≠ 0 := by
    intro G H₂ _ _ δ κ_G deg_G ξ hsurj_δ hker_δ hℓ_kill hCard hsurj_κ hdeg_ξ
    have hPrime : Nat.Prime ℓ := Fact.out
    let R_ℓ : AddSubgroup G := (zsmulAddGroupHom (ℓ : ℤ) : G →+ G).range
    have hker_eq : δ.ker = R_ℓ := by
      ext g_el
      rw [AddMonoidHom.mem_ker, hker_δ g_el]
      constructor
      · rintro ⟨v, rfl⟩
        exact ⟨v, natCast_zsmul v ℓ⟩
      · rintro ⟨v, hv⟩
        exact ⟨v, (natCast_zsmul v ℓ).symm.trans hv⟩
    let e_kum : (G ⧸ R_ℓ) ≃+ H₂ :=
      (QuotientAddGroup.quotientAddEquivOfEq hker_eq.symm).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective δ hsurj_δ)
    have hCard_quot : Nat.card (G ⧸ R_ℓ) = ℓ :=
      (Nat.card_congr e_kum.toEquiv).trans hCard
    have hR_le_ker : R_ℓ ≤ κ_G.ker := by
      rintro _ ⟨η, rfl⟩
      change κ_G ((ℓ : ℤ) • η) = 0
      rw [natCast_zsmul, map_nsmul]
      exact hℓ_kill (κ_G η)
    let κ_bar : (G ⧸ R_ℓ) →+ H₂ := QuotientAddGroup.lift R_ℓ κ_G hR_le_ker
    have hsurj_κbar : Function.Surjective κ_bar := by
      intro z
      obtain ⟨η, rfl⟩ := hsurj_κ z
      exact ⟨QuotientAddGroup.mk' R_ℓ η, rfl⟩
    have : Finite (G ⧸ R_ℓ) :=
      Nat.finite_of_card_ne_zero (hCard_quot.symm ▸ hPrime.ne_zero)
    have hbij_κbar : Function.Bijective κ_bar :=
      (Nat.bijective_iff_surjective_and_card κ_bar).mpr
        ⟨hsurj_κbar, hCard_quot.trans hCard.symm⟩
    intro hκ_zero
    have hmk_zero : QuotientAddGroup.mk' R_ℓ ξ = 0 := by
      apply hbij_κbar.1
      change κ_G ξ = κ_bar 0
      rw [hκ_zero, map_zero]
    have hξ_mem : ξ ∈ R_ℓ := (QuotientAddGroup.eq_zero_iff ξ).mp hmk_zero
    rcases hξ_mem with ⟨η, hη⟩
    change (ℓ : ℤ) • η = ξ at hη
    have hdeg_mul : (ℓ : ℤ) * deg_G η = 1 := by
      calc
        (ℓ : ℤ) * deg_G η = deg_G ((ℓ : ℤ) • η) := by
          simp only [map_zsmul, zsmul_eq_mul, Int.cast_id]
        _ = deg_G ξ := by rw [hη]
        _ = 1 := hdeg_ξ
    have hdvd_int : (ℓ : ℤ) ∣ (1 : ℤ) := ⟨deg_G η, hdeg_mul.symm⟩
    have hdvd_nat : ℓ ∣ 1 := Int.ofNat_dvd.mp hdvd_int
    have hle_one : ℓ ≤ 1 := Nat.le_of_dvd zero_lt_one hdvd_nat
    have htwo_le : 2 ≤ ℓ := hPrime.two_le
    omega

  
  have hDVR_of_loc :
      ∀ {R S : Type u} [CommRing R] [IsDomain R] (P : Ideal R) [P.IsMaximal]
        [CommRing S] [Algebra R S] [IsLocalization.AtPrime S P]
        (hDomS : IsDomain S) (_ : @IsDiscreteValuationRing S _ hDomS),
        IsDiscreteValuationRing (Localization.AtPrime P) := by
    intro R S _ _ P _ _ _ _ hDomS hDVRS
    have : IsDomain S := hDomS
    have : IsDiscreteValuationRing S := hDVRS
    let e : S ≃+* Localization.AtPrime P :=
      (IsLocalization.algEquiv P.primeCompl S (Localization.AtPrime P)).toRingEquiv
    have hMaxMap : ∀ {A₁ A₂ : Type u} [CommRing A₁] [IsLocalRing A₁]
        [CommRing A₂] [IsLocalRing A₂] (f : A₁ ≃+* A₂),
        Ideal.map f.toRingHom (IsLocalRing.maximalIdeal A₁) = IsLocalRing.maximalIdeal A₂ := by
      intro A₁ A₂ _ _ _ _ f
      exact (IsLocalRing.isMaximal_iff A₂).mp (Ideal.map_isMaximal_of_equiv f)
    have hPIR : IsPrincipalIdealRing (Localization.AtPrime P) :=
      ⟨fun I => by
        obtain ⟨a, ha⟩ := IsPrincipalIdealRing.principal (Ideal.comap e.toRingHom I)
        refine ⟨e a, ?_⟩
        ext x
        rw [Submodule.mem_span_singleton]
        constructor
        · intro hx
          have hx' : e.symm x ∈ Ideal.comap e.toRingHom I := by
            change e (e.symm x) ∈ I
            simpa using hx
          rw [ha, Submodule.mem_span_singleton] at hx'
          rcases hx' with ⟨c, hc⟩
          refine ⟨e c, ?_⟩
          calc
            e c • e a = e c * e a := smul_eq_mul _ _
            _ = e (c * a) := (e.map_mul c a).symm
            _ = e (e.symm x) := by rw [← smul_eq_mul, ← hc]
            _ = x := e.apply_symm_apply x
        · rintro ⟨c, rfl⟩
          have ha_mem : a ∈ Ideal.comap e.toRingHom I := by
            rw [ha]
            exact Submodule.mem_span_singleton_self a
          exact Ideal.mul_mem_left I c ha_mem⟩
    refine @IsDiscreteValuationRing.mk _ _ _ hPIR inferInstance ?_
    intro hbot
    have hbotS : IsLocalRing.maximalIdeal S = ⊥ := by
      have h1 := congrArg (Ideal.map e.symm.toRingHom) hbot
      rw [hMaxMap e.symm, Ideal.map_bot] at h1
      exact h1
    exact IsDiscreteValuationRing.not_a_field S hbotS

  have hSpan_to_loc :
      ∀ {R S : Type u} [CommRing R] (P : Ideal R) [P.IsMaximal]
        [CommRing S] [IsLocalRing S] [Algebra R S] [IsLocalization.AtPrime S P]
        (x : R),
        Ideal.span ({algebraMap R (Localization.AtPrime P) x} : Set (Localization.AtPrime P)) =
          IsLocalRing.maximalIdeal (Localization.AtPrime P) →
        Ideal.span ({algebraMap R S x} : Set S) = IsLocalRing.maximalIdeal S := by
    intro R S _ P _ _ _ _ _ x hspan
    let e : Localization.AtPrime P ≃ₐ[R] S :=
      IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P) S
    have hMax :
        Ideal.map e.toRingEquiv.toRingHom (IsLocalRing.maximalIdeal (Localization.AtPrime P)) =
