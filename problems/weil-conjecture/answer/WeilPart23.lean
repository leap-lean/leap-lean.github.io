          _ = eΨ_b.hom ≫ ((p₂.left ⁻¹ᵁ D₀ b).ι ≫ p₂.left) := by
                rw [AlgebraicGeometry.morphismRestrict_ι p₂.left (D₀ b)]
          _ = (eΨ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι ≫ ι_inc) ≫
                CategoryTheory.Limits.pullback.snd P_amb.hom B₀.hom := by
