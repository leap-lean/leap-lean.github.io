  obtain ⟨hSC₁, hAdd_U₁, hLim_U₁, hColim_U₁, βM₁, _hαβ_M₁, hβα_M₁, hθ₁_eq⟩ :=
    step3_strictify Y₁ T₁ hT₁ θ₁ hθ₁
  obtain ⟨hSC₂, hAdd_U₂, hLim_U₂, hColim_U₂, βM₂, hαβ_M₂, _hβα_M₂, hθ₂_eq⟩ :=
    step3_strictify Y₂ T₂ hT₂ θ₂ hθ₂

  letI : J₁.HasSheafCompose FgtMod := hSC₁
  letI : J₂.HasSheafCompose FgtMod := hSC₂
  let U_std₁ := CategoryTheory.sheafCompose J₁ FgtMod
  let U_std₂ := CategoryTheory.sheafCompose J₂ FgtMod
  letI : U_std₁.Additive := hAdd_U₁
  letI : Limits.PreservesFiniteLimits U_std₁ := hLim_U₁
  letI : Limits.PreservesFiniteColimits U_std₁ := hColim_U₁
  letI : U_std₂.Additive := hAdd_U₂
  letI : Limits.PreservesFiniteLimits U_std₂ := hLim_U₂
  letI : Limits.PreservesFiniteColimits U_std₂ := hColim_U₂

  let u_std₁ : FgtMod.obj R_mod ⟶ (U_std₁.obj one₁).obj.obj (Opposite.op T₁) :=
