  have hadj_Rp_nsmul :
      ∀ {ℱ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        {𝒢 : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
        (n : ℕ) (h : R_p.obj ℱ ⟶ 𝒢),
        (adj_Rp.homEquiv ℱ 𝒢) (n • h) = n • (adj_Rp.homEquiv ℱ 𝒢) h := by
