by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have h1_le : 1 ≤ ℓ := hPrime.pos
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  haveI : NeZero ℓ := ⟨hℓ_ne⟩

  
  have hLagrange :
      let ν : ZMod ℓ → k := fun a => ((ζ : Units k) : k) ^ a.val
      ∃ Ψ : ∀ (Y : AlgebraicGeometry.Scheme.{u})
          (_ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤))),
          LocallyConstant ↥Y (ZMod ℓ) → ↑(Y.presheaf.obj (Opposite.op ⊤)),
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤))),
          Function.Injective (Ψ Y κ)) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
            (v : ↑(Y.presheaf.obj (Opposite.op ⊤))),
          v ^ ℓ = 1 → ∃ g : LocallyConstant ↥Y (ZMod ℓ), Ψ Y κ g = v) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤))),
          Ψ Y κ 0 = 1 ∧
          ∀ g₁ g₂ : LocallyConstant ↥Y (ZMod ℓ),
            Ψ Y κ (g₁ + g₂) = Ψ Y κ g₁ * Ψ Y κ g₂ ∧ (Ψ Y κ g₁) ^ ℓ = 1) ∧
        (∀ {Y' Y : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y' Y)
            (κ' : k →+* ↑(Y'.presheaf.obj (Opposite.op ⊤)))
            (κ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤))),
          (∀ c : k, (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f)) (κ c) = κ' c) →
          ∀ (g : LocallyConstant ↥Y (ZMod ℓ)) (g' : LocallyConstant ↥Y' (ZMod ℓ)),
            (∀ x : ↥Y', g' x = g (f.base x)) →
            Ψ Y' κ' g' = (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f)) (Ψ Y κ g)) ∧
        (∀ (Y : AlgebraicGeometry.Scheme.{u}) (κ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
            (a : ZMod ℓ),
          Ψ Y κ (LocallyConstant.const ↥Y a) = κ (ν a)) := by
    intro ν
    set z : k := ((ζ : Units k) : k)
    have hz_pow : z ^ ℓ = 1 := hζ.pow_eq_one
    have hν_inj : Function.Injective ν := by
      intro a b hab
      exact ZMod.val_injective ℓ (hζ.pow_inj (ZMod.val_lt a) (ZMod.val_lt b) hab)
    have hν_0 : ν 0 = 1 := by
      simp [ν, ZMod.val_zero]
    have hν_add : ∀ a b : ZMod ℓ, ν (a + b) = ν a * ν b := by
      intro a b
      calc
        ν (a + b) = z ^ ((a.val + b.val) % ℓ) := by
          dsimp [ν]
          rw [ZMod.val_add]
        _ = (z ^ ℓ) ^ ((a.val + b.val) / ℓ) * z ^ ((a.val + b.val) % ℓ) := by
          rw [hz_pow, one_pow, one_mul]
        _ = z ^ (ℓ * ((a.val + b.val) / ℓ) + (a.val + b.val) % ℓ) := by
          rw [pow_add, pow_mul]
        _ = z ^ (a.val + b.val) := by
          rw [Nat.div_add_mod]
        _ = ν a * ν b := pow_add z a.val b.val
    have hν_pow : ∀ a : ZMod ℓ, (ν a) ^ ℓ = 1 := by
      intro a
      dsimp [ν]
      rw [← pow_mul, mul_comm, pow_mul, hz_pow, one_pow]
    have hIdemp : ∀ (R : Type u) [CommRing R] (φ : k →+* R) (v : R),
        v ^ ℓ = 1 →
        ∃ e : ZMod ℓ → R,
          (Finset.univ : Finset (ZMod ℓ)).sum e = 1 ∧
          (∀ a b : ZMod ℓ, a ≠ b → e a * e b = 0) ∧
          (∀ a : ZMod ℓ, v * e a = φ (ν a) * e a) := by
      let P : Polynomial k :=
        (Finset.univ : Finset (ZMod ℓ)).prod (fun b => Polynomial.X - Polynomial.C (ν b))
      have hcop : Set.Pairwise (↑(Finset.univ : Finset (ZMod ℓ)))
          (fun a b => IsCoprime (Polynomial.X - Polynomial.C (ν a))
            (Polynomial.X - Polynomial.C (ν b))) :=
        fun _ _ _ _ hab => Polynomial.pairwise_coprime_X_sub_C hν_inj hab
      have hP_dvd_of_eval : ∀ F : Polynomial k,
          (∀ m : ZMod ℓ, Polynomial.eval (ν m) F = 0) → P ∣ F := by
        intro F hF
        apply Finset.prod_dvd_of_coprime hcop
        intro m _
        exact Polynomial.dvd_iff_isRoot.mpr (hF m)
      have hP_dvd_Q : P ∣ (Polynomial.X ^ ℓ - 1 : Polynomial k) := by
        apply hP_dvd_of_eval
        intro m
        simp [hν_pow m]
      have hP_monic : P.Monic :=
        Polynomial.monic_prod_of_monic _ _ (fun b _ => Polynomial.monic_X_sub_C (ν b))
      have hP_deg : P.natDegree = ℓ := by
        rw [Polynomial.natDegree_prod_of_monic _ _ (fun b _ => Polynomial.monic_X_sub_C (ν b))]
        simp [ZMod.card]
      have hQ_monic : (Polynomial.X ^ ℓ - (1 : Polynomial k)).Monic := by
        rw [← map_one Polynomial.C]
        exact Polynomial.monic_X_pow_sub_C (1 : k) hℓ_ne
      have hQ_deg : (Polynomial.X ^ ℓ - (1 : Polynomial k)).natDegree = ℓ := by
        rw [← map_one Polynomial.C]
        exact Polynomial.natDegree_X_pow_sub_C
      have hP_eq : P = Polynomial.X ^ ℓ - 1 := by
        obtain ⟨C_quot, hC_quot⟩ := hP_dvd_Q
        have hC_ne : C_quot ≠ 0 := by
          rintro rfl
          rw [mul_zero] at hC_quot
          exact hQ_monic.ne_zero hC_quot
        have hdeg_sum : ℓ = ℓ + C_quot.natDegree := by
          have h1 := congrArg Polynomial.natDegree hC_quot
          rwa [hQ_deg, Polynomial.natDegree_mul hP_monic.ne_zero hC_ne, hP_deg] at h1
        have hC_deg0 : C_quot.natDegree = 0 := by omega
        have hC_const : C_quot = Polynomial.C (C_quot.coeff 0) :=
          Polynomial.eq_C_of_natDegree_eq_zero hC_deg0
        have hc0 : C_quot.coeff 0 = 1 := by
          have hlc := congrArg Polynomial.leadingCoeff hC_quot
