    have h1 := CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app
      adj_pull adj_Rp (C_X.obj Aℤ)
    have h2 : (adj_pull.homEquiv (C_X.obj Aℤ) (C_Y.obj Aℤ)) πℤ =
        (adj_Rp.homEquiv (C_X.obj Aℤ) (C_Y.obj Aℤ)) (η_iso.inv.app (C_X.obj Aℤ) ≫ πℤ) := by
      have h_id : η_iso.hom.app (C_X.obj Aℤ) ≫ (η_iso.inv.app (C_X.obj Aℤ) ≫ πℤ) = πℤ :=
