      let e_cl : E_b ≅ (ι_inc ⁻¹ᵁ Q_b).toScheme := ⟨u_cl, v_cl, huv_cl, hvu_cl⟩
      have hRange_open : Set.range (ι_inc ⁻¹ᵁ Q_b).ι.base =
