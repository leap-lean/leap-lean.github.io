        fun f hf => sec f hf
      let Yx : ↥U.left → W.Etale := fun x => Classical.choose (hR x)
      let fx : ∀ x : ↥U.left, Yx x ⟶ U := fun x => Classical.choose (Classical.choose_spec (hR x))
      let yx : ∀ x : ↥U.left, ↥(Yx x).left :=
