      change Polynomial.eval₂ (algebraMap F L) (ζ_L * AdjoinRoot.root P_f) P_f = 0
      dsimp [P_f]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
