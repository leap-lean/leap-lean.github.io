    let ρ_X := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ)
      hXβ₀ hpos).hom ≫ ι_X.left.app D_β₀).hom
    let ψ_M := (ι_M.left.app (ν₂.left ⁻¹ᵁ D_β₀)).hom
    have hcomp_app : ι_X.left.app D_β₀ = ν₂.left.app D_β₀ ≫ ι_M.left.app (ν₂.left ⁻¹ᵁ D_β₀) :=
      AlgebraicGeometry.Scheme.Hom.comp_app ι_M.left ν₂.left D_β₀
    have hρ_apply : ∀ z, ρ_X z = ψ_M (ρ_i z) := by
      intro z
      have h1 := congrArg
        (fun h => ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ)
          hXβ₀ hpos).hom ≫ h).hom z) hcomp_app
      exact h1
    let ι₀_k := (HomogeneousLocalization.fromZeroRingHom 𝒜_N
      (Submonoid.powers (MvPolynomial.X β₀.succ))).comp (algebraMap k ↥(𝒜_N 0))
    let g_m : Fin N' → HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X β₀.succ) :=
      fun m => HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
          ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, ⟨1, pow_one _⟩⟩
    let ev_X := MvPolynomial.eval₂Hom (ρ_X.comp ι₀_k) (fun m => ρ_X (g_m m))
    let ev_i := MvPolynomial.eval₂Hom (ρ_i.comp ι₀_k) (fun m => ρ_i (g_m m))
    have hev_apply : ∀ Q : MvPolynomial (Fin N') k, ev_X Q = ψ_M (ev_i Q) := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C c =>
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        exact hρ_apply (ι₀_k c)
      | add p q hp hq =>
        rw [map_add, map_add, map_add, hp, hq]
        exact rfl
      | mul_X p m hp =>
        rw [map_mul, map_mul, map_mul, hp, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
          hρ_apply (g_m m)]
        exact rfl
    intro s
    obtain ⟨t, ht⟩ := hSurj_app s
    obtain ⟨P_m, hPm⟩ := hSurj_ν₂ t
    exact ⟨P_m, (hev_apply P_m).trans ((congrArg ψ_M hPm).trans ht)⟩

  
  
  
