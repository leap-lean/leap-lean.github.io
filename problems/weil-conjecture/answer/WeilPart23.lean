            (hEt_hom W₁)).sheafPushforwardContinuous
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left.smallEtaleTopology
          S.smallEtaleTopology).map (weilCupPDLocalFreeMap S ℓ v) =
      α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left hv ≫
        ((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
            hv).sheafPushforwardContinuous
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left.smallEtaleTopology
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left.smallEtaleTopology).map
          (δ_slice W₂) ≫
        ζ_v.hom.app (weilCupPDLocalFreeSheaf S ℓ W₂) := by
    apply ((CategoryTheory.constantSheafAdj
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
        (weilEtaleIdTerminalIsTerminal.{u}
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left)).homEquiv
      (ModuleCat.of (ULift.{u, 0} (ZMod ℓ)) (ULift.{u, 0} (ZMod ℓ))) _).injective
    have hL3 : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap S ℓ v) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂)) ≫
          (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map (Opposite.op v) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have hL4 :
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂)) ≫
          (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map (Opposite.op v)) ≫
          (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map (Opposite.op (τ_slice W₁).hom) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂)) ≫
          (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map
            (Opposite.op ((τ_slice W₁).hom ≫ v)) := by
      rw [CategoryTheory.Category.assoc,
        ← (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map_comp, hop_comp]
    have hLHS :=
      (hAdj_δ_map W₁ (weilCupPDLocalFreeMap S ℓ v)).trans
        ((congrArg (· ≫ (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map
            (Opposite.op (τ_slice W₁).hom)) hL3).trans hL4)
    have hRHS := hCompAdj (weilCupPDLocalFreeSheaf S ℓ W₂) W₂
      (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂)))
      (τ_slice W₂).hom (δ_slice W₂) (hδ_slice_eq W₂)
    have hHomEq : (τ_slice W₁).hom ≫ v =
        e_Sigma.inv.app
          (weilEtaleIdTerminal.{u}
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left) ≫
          (weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom
              (hEt_hom W₂)).map
            ((weilEtaleIdTerminalIsTerminal.{u}
                ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left).from
              ((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
                  hv).obj
                (weilEtaleIdTerminal.{u}
                  ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left))) ≫
          (τ_slice W₂).hom := by
      refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
      have h_id_v :
          𝟙 ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left ≫
            ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left =
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left :=
        CategoryTheory.Category.id_comp _
      have hL_hom :
          (τ_slice W₁).hom.left ≫ ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left =
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left :=
        (congrArg (· ≫ ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left)
          (hτ_hom_left W₁)).trans h_id_v
      have hR_inner :
          (𝟙 ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left ≫
              ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left) ≫
            (τ_slice W₂).hom.left =
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left :=
        (congrArg (· ≫ (τ_slice W₂).hom.left) h_id_v).trans
          ((congrArg (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫ ·)
              (hτ_hom_left W₂)).trans
            (CategoryTheory.Category.comp_id _))
      exact hL_hom.trans
        (((congrArg (· ≫ _)
            (he_inv_left (weilEtaleIdTerminal.{u}
              ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left))).trans
          ((congrArg (𝟙 ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left ≫ ·)
              hR_inner).trans
            h_id_v)).symm)
    exact (hLHS.trans
      (congrArg (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂)) ≫
        (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map ·) (congrArg Opposite.op hHomEq))).trans
      hRHS.symm

  have hRight_α :
      α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left hv ≫
        ((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
            hv).sheafPushforwardContinuous
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left.smallEtaleTopology
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left.smallEtaleTopology).map
          (α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom (hEt_hom W₂)) ≫
        ζ_v.hom.app (weilCupPDModUnit S ℓ) =
      α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom (hEt_hom W₁) := by
    apply ((CategoryTheory.constantSheafAdj
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
        (weilEtaleIdTerminalIsTerminal.{u}
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left)).homEquiv
      (ModuleCat.of (ULift.{u, 0} (ZMod ℓ)) (ULift.{u, 0} (ZMod ℓ))) _).injective
    have hLHS_α := hCompAdj (weilCupPDModUnit S ℓ) (weilEtaleIdTerminal.{u} S)
      ((CategoryTheory.constantSheafAdj S.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
          (weilEtaleIdTerminalIsTerminal.{u} S)).unit.app
        (ModuleCat.of (ULift.{u, 0} (ZMod ℓ)) (ULift.{u, 0} (ZMod ℓ))))
      ((weilEtaleIdTerminalIsTerminal.{u} S).from
        ((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom
            (hEt_hom W₂)).obj
          (weilEtaleIdTerminal.{u}
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left)))
      (α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom (hEt_hom W₂))
      (hα_mod_eq ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom (hEt_hom W₂))
    have hRHS_α := hα_mod_eq ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom (hEt_hom W₁)
    have hHomEq_α := (weilEtaleIdTerminalIsTerminal.{u} S).hom_ext
      (e_Sigma.inv.app
          (weilEtaleIdTerminal.{u}
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left) ≫
        (weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom
            (hEt_hom W₂)).map
          ((weilEtaleIdTerminalIsTerminal.{u}
              ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left).from
            ((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
                hv).obj
              (weilEtaleIdTerminal.{u}
                ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left))) ≫
        (weilEtaleIdTerminalIsTerminal.{u} S).from
          ((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom
              (hEt_hom W₂)).obj
            (weilEtaleIdTerminal.{u}
              ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left)))
      ((weilEtaleIdTerminalIsTerminal.{u} S).from
        ((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom
            (hEt_hom W₁)).obj
          (weilEtaleIdTerminal.{u}
            ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left)))
    exact (hLHS_α.trans
      (congrArg (_ ≫ (weilCupPDModUnit S ℓ).obj.map ·)
        (congrArg Opposite.op hHomEq_α))).trans hRHS_α.symm

  rw [hΦ_def W₁ q, hΓ_def W₁ (weilCupPDModUnit S ℓ) q,
    hr_q_def, hΦ_def W₂ q, hΓ_def W₂ (weilCupPDModUnit S ℓ) q]
  exact hExtSquare
    (((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom
        (hEt_hom W₁)).sheafPushforwardContinuous
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left.smallEtaleTopology
      S.smallEtaleTopology))
    (((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom
        (hEt_hom W₂)).sheafPushforwardContinuous
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left.smallEtaleTopology
      S.smallEtaleTopology))
    (((weilEtalePostcomp ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
        hv).sheafPushforwardContinuous
      (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left.smallEtaleTopology
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left.smallEtaleTopology))
    ζ_v
    (weilCupPDLocalFreeMap S ℓ v)
    (δ_slice W₁) (δ_slice W₂)
    (α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom (hEt_hom W₁))
    (β_mod ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).hom (hEt_hom W₁))
    (α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom (hEt_hom W₂))
    (β_mod ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).hom (hEt_hom W₂))
    (α_mod ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left hv)
    (β_mod ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left hv)
    hLeft_δ hRight_α
    (hαβ_mod _ _) (hβα_mod _ _) (hβα_mod _ _)
    q ξ

theorem weil_etale_mod_restriction_eq_torsion_pullback {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom Y₁ Y₂) (hh : AlgebraicGeometry.Etale h)
    (ℓ q : ℕ)
    (r_q : weilCupPDModH Y₂ ℓ q →+ weilCupPDModH Y₁ ℓ q)
    (hr_q : WeilIsEtaleModRestriction h hh ℓ q r_q)
    (θ₁ : weilEtaleModuleH Y₁ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q)
    (hθ₁ : WeilIsModuleToTorsionComparison Y₁ ℓ q θ₁)
    (θ₂ : weilEtaleModuleH Y₂ ℓ q →+ weilEtaleTorsionH Y₂ ℓ q)
    (hθ₂ : WeilIsModuleToTorsionComparison Y₂ ℓ q θ₂)
    (p_q : weilEtaleTorsionH Y₂ ℓ q →+ weilEtaleTorsionH Y₁ ℓ q)
    (hp_q : WeilIsTorsionEtalePullback h ℓ q p_q)
    (x : weilCupPDModH Y₂ ℓ q) :
    θ₁ (r_q x) = p_q (θ₂ x) :=
by
  
  
  
  have step1_constAdj_unit_ab : ∀ {C_site : Type (u + 1)} [Category.{u} C_site]
      (J : GrothendieckTopology C_site)
      [HasWeakSheafify J AddCommGrpCat.{u}]
      {T T' : C_site} (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal T')
      (α : T' ⟶ T) (A : AddCommGrpCat.{u}),
      (constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A =
        (constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A ≫
          (((constantSheaf J AddCommGrpCat.{u}).obj A).obj.map α.op) := by
    intro C_site _ J _ T T' hT hT' α A
    let u := (sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      ((Functor.const C_siteᵒᵖ).obj A)
    have hnat := u.naturality α.op
    change 𝟙 A ≫ u.app (Opposite.op T') =
      u.app (Opposite.op T) ≫ (((constantSheaf J AddCommGrpCat.{u}).obj A).obj.map α.op) at hnat
    rw [Category.id_comp] at hnat
    change 𝟙 A ≫ u.app (Opposite.op T') =
      (𝟙 A ≫ u.app (Opposite.op T)) ≫ (((constantSheaf J AddCommGrpCat.{u}).obj A).obj.map α.op)
    rw [Category.id_comp, Category.id_comp]
    exact hnat

  have step1_constAdj_unit_mod : ∀ {C_site : Type (u + 1)} [Category.{u} C_site]
      (J : GrothendieckTopology C_site)
      [HasWeakSheafify J (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))]
      {T T' : C_site} (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal T')
      (α : T' ⟶ T) (A : ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))),
      (constantSheafAdj J (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))) hT').unit.app A =
        (constantSheafAdj J (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))) hT).unit.app A ≫
          (((constantSheaf J (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))).obj A).obj.map α.op) := by
    intro C_site _ J _ T T' hT hT' α A
    let M := ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))
    let u := (sheafificationAdjunction J M).unit.app ((Functor.const C_siteᵒᵖ).obj A)
    have hnat := u.naturality α.op
    change 𝟙 A ≫ u.app (Opposite.op T') =
      u.app (Opposite.op T) ≫ (((constantSheaf J M).obj A).obj.map α.op) at hnat
    rw [Category.id_comp] at hnat
    change 𝟙 A ≫ u.app (Opposite.op T') =
      (𝟙 A ≫ u.app (Opposite.op T)) ≫ (((constantSheaf J M).obj A).obj.map α.op)
    rw [Category.id_comp, Category.id_comp]
    exact hnat

  have step1_constAdj_homEquiv_symm : ∀ {C_site : Type (u + 1)} [Category.{u} C_site]
      (J : GrothendieckTopology C_site)
      [HasWeakSheafify J AddCommGrpCat.{u}]
      {T T' : C_site} (hT : Limits.IsTerminal T) (hT' : Limits.IsTerminal T')
      (β : T' ⟶ T) (A : AddCommGrpCat.{u}) (𝒢 : Sheaf J AddCommGrpCat.{u})
      (g : A ⟶ 𝒢.obj.obj (Opposite.op T)),
      ((constantSheafAdj J AddCommGrpCat.{u} hT').homEquiv A 𝒢).symm (g ≫ 𝒢.obj.map β.op) =
        ((constantSheafAdj J AddCommGrpCat.{u} hT).homEquiv A 𝒢).symm g := by
    intro C_site _ J _ T T' hT hT' β A 𝒢 g
    let adj := constantSheafAdj J AddCommGrpCat.{u} hT
    let adj' := constantSheafAdj J AddCommGrpCat.{u} hT'
    apply (adj'.homEquiv A 𝒢).injective
    rw [Equiv.apply_symm_apply, Adjunction.homEquiv_unit]
    let k := (adj.homEquiv A 𝒢).symm g
    change g ≫ 𝒢.obj.map β.op = adj'.unit.app A ≫ k.hom.app (Opposite.op T')
    rw [step1_constAdj_unit_ab J hT hT' β A, Category.assoc, k.hom.naturality β.op, ← Category.assoc]
    have hk : adj.unit.app A ≫ k.hom.app (Opposite.op T) = g :=
      (Adjunction.homEquiv_unit adj A 𝒢 k).symm.trans (Equiv.apply_symm_apply _ g)
    rw [hk]

  
  
  
  have step2_extComp : ∀ {C₁ C₂ C₃ : Type (u + 1)}
      [Category.{u + 1, u + 1} C₁] [Abelian C₁] [HasExt.{u} C₁] [EnoughInjectives C₁]
      [Category.{u + 1, u + 1} C₂] [Abelian C₂] [HasExt.{u} C₂]
      [Category.{u + 1, u + 1} C₃] [Abelian C₃] [HasExt.{u} C₃]
      (F : C₁ ⥤ C₂) [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      (G : C₂ ⥤ C₃) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      [(F ⋙ G).Additive] [Limits.PreservesFiniteLimits (F ⋙ G)]
      [Limits.PreservesFiniteColimits (F ⋙ G)]
      {X Y : C₁} {n : ℕ} (z : Abelian.Ext.{u} X Y n),
      Abelian.Ext.mapExactFunctor (F ⋙ G) z =
        Abelian.Ext.mapExactFunctor G (Abelian.Ext.mapExactFunctor F z) := by
    intro C₁ C₂ C₃ _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ _ _ _ X Y n z
    induction n generalizing Y with
    | zero =>
      have hz : Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ z) = z :=
        Abelian.Ext.addEquiv₀.left_inv z
      rw [← hz, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      let I : C₁ := Injective.under Y
      let ι : Y ⟶ I := Injective.ι Y
      let S : ShortComplex C₁ := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : z.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨w, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS z hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_comp, ih w,
        Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.mapExactFunctor_extClass]

  have step2_extIso : ∀ {C₁ C₂ : Type (u + 1)}
      [Category.{u + 1, u + 1} C₁] [Abelian C₁] [HasExt.{u} C₁] [EnoughInjectives C₁]
      [Category.{u + 1, u + 1} C₂] [Abelian C₂] [HasExt.{u} C₂]
      (F G : C₁ ⥤ C₂)
      [F.Additive] [Limits.PreservesFiniteLimits F] [Limits.PreservesFiniteColimits F]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (e : F ≅ G) {X Y : C₁} {n : ℕ} (z : Abelian.Ext.{u} X Y n),
      Abelian.Ext.mapExactFunctor G z =
        (Abelian.Ext.mk₀ (e.inv.app X)).comp
          ((Abelian.Ext.mapExactFunctor F z).comp
            (Abelian.Ext.mk₀ (e.hom.app Y)) (Nat.add_zero n))
          (Nat.zero_add n) := by
    intro C₁ C₂ _ _ _ _ _ _ _ F G _ _ _ _ _ _ e X Y n z
    induction n generalizing Y with
    | zero =>
      let f : X ⟶ Y := Abelian.Ext.addEquiv₀ z
      have hz : Abelian.Ext.mk₀ f = z := Abelian.Ext.addEquiv₀.left_inv z
      rw [← hz, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      rw [e.hom.naturality f, ← Category.assoc, e.inv_hom_id_app, Category.id_comp]
    | succ k ih =>
      let I : C₁ := Injective.under Y
      let ι : Y ⟶ I := Injective.ι Y
      let S : ShortComplex C₁ := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hzero : z.comp (Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨w, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS z hzero rfl
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        ih w, Abelian.Ext.mapExactFunctor_extClass, Abelian.Ext.mapExactFunctor_extClass]
      let φ : S.map F ⟶ S.map G :=
        { τ₁ := e.hom.app S.X₁
          τ₂ := e.hom.app S.X₂
          τ₃ := e.hom.app S.X₃
          comm₁₂ := (e.hom.naturality S.f).symm
          comm₂₃ := (e.hom.naturality S.g).symm }
      have hnat := ShortComplex.ShortExact.extClass_naturality
        (hS.map_of_exact F) (hS.map_of_exact G) φ
      change (hS.map_of_exact F).extClass.comp (Abelian.Ext.mk₀ (e.hom.app Y)) (Nat.add_zero 1) =
        (Abelian.Ext.mk₀ (e.hom.app S.X₃)).comp (hS.map_of_exact G).extClass (Nat.zero_add 1) at hnat
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ rfl, hnat,
        ← Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ rfl,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (e.inv.app X)) _ _
