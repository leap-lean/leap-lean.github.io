      have heΨ_ι : eΨ_b.hom ≫ (p₂.left ⁻¹ᵁ D₀ b).ι ≫ ι_inc = Φ_b ≫ Q_b.ι := by
        change (u_cl ≫ e_op.hom) ≫ (p₂.left ⁻¹ᵁ D₀ b).ι ≫ ι_inc = Φ_b ≫ Q_b.ι
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_op.hom, he_op_hom,
