    have hπ_tilde_eq : π_tilde = R_ab.map u_std_A ≫ adj_RP.counit.app (C₁.obj A) := by
      have hsymm : (adj_RP.homEquiv (C₂.obj A) (C₁.obj A)).symm u_std_A = π_tilde := by
        rw [← hmate]
        exact Equiv.symm_apply_apply _ _
