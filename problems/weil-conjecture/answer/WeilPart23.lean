      let α := CategoryTheory.Limits.biprod.lift
        (weilEtaleLocalTorsionMap S m i₁) (-weilEtaleLocalTorsionMap S m i₂)
      let β := CategoryTheory.Limits.biprod.desc
        (weilEtaleLocalTorsionMap S m j₁) (weilEtaleLocalTorsionMap S m j₂)
