      let V₂ : C_bar.left.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ W₂.ι
          (inferInstance : AlgebraicGeometry.Etale W₂.ι)
      let V₁₂ : C_bar.left.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (W₁ ⊓ W₂).ι
          (inferInstance : AlgebraicGeometry.Etale (W₁ ⊓ W₂).ι)
      let j₁ : Quiver.Hom V₁₂ V₁ :=
        CategoryTheory.MorphismProperty.Over.homMk (C_bar.left.homOfLE inf_le_left)
