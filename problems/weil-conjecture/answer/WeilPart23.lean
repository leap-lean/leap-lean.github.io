            Y.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op ≫
              (W.topIso.inv ≫ (p_open W).appTop) := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hpb_fst,
          AlgebraicGeometry.Scheme.Hom.comp_appTop, hι_top, Category.assoc]
      exact congrArg (fun φ => φ.hom r) hcat

    have hInj_p : Function.Injective p.appTop.hom := by
      intro r₁ r₂ hr
      apply hInj_open ⊤
      have h1 := hj_app ⊤ r₁
      have h2 := hj_app ⊤ r₂
      have hid : CategoryTheory.homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤) = 𝟙 _ :=
        Subsingleton.elim _ _
      have hop_id : (CategoryTheory.homOfLE (le_top : (⊤ : Y.Opens) ≤ ⊤)).op = 𝟙 _ := by
        rw [hid]; rfl
      rw [hop_id, Y.presheaf.map_id] at h1 h2
      exact h1.symm.trans ((congrArg (j_open ⊤).appTop.hom hr).trans h2)

    have hInj_units :
        Function.Injective (Units.map p.appTop.hom.toMonoidHom) := by
      intro u₁ u₂ hu
      exact Units.ext (hInj_p (congrArg Units.val hu))

    have hGlueSec :
        ∀ (t : ↑(P.presheaf.obj (Opposite.op ⊤)))
          (c : ∀ i : ι, ↑(Y.presheaf.obj (Opposite.op (V i)))),
          (∀ i : ι, α_open (V i) (c i) = (j_open (V i)).appTop.hom t) →
          ∃ c_top : ↑(Y.presheaf.obj (Opposite.op ⊤)),
            p.appTop.hom c_top = t := by
      intro t c hc
      have hCompat : TopCat.Presheaf.IsCompatible Y.presheaf V c := by
        intro i₁ i₂
        let W : Y.Opens := V i₁ ⊓ V i₂
        have hk_j : ∀ {V' U : Y.Opens} (hVU : V' ≤ U), k_open hVU ≫ j_open U = j_open V' := by
          intro V' U hVU
          apply CategoryTheory.Limits.pullback.hom_ext
          · dsimp only [k_open, j_open]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              Category.assoc, Y.homOfLE_ι, CategoryTheory.Limits.pullback.lift_fst]
          · simp only [k_open, j_open, Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, Category.comp_id]
        apply hInj_open W
        have hL :
            α_open W ((Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : W ≤ V i₁)).op).hom (c i₁)) =
              (j_open W).appTop.hom t := by
          rw [← hResCompat inf_le_left (c i₁), hc i₁]
          have hcat : (j_open (V i₁)).appTop ≫ (k_open (inf_le_left : W ≤ V i₁)).appTop =
              (j_open W).appTop := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hk_j inf_le_left]
          exact congrArg (fun φ => φ.hom t) hcat
        have hR :
            α_open W ((Y.presheaf.map (CategoryTheory.homOfLE (inf_le_right : W ≤ V i₂)).op).hom (c i₂)) =
              (j_open W).appTop.hom t := by
          rw [← hResCompat inf_le_right (c i₂), hc i₂]
          have hcat : (j_open (V i₂)).appTop ≫ (k_open (inf_le_right : W ≤ V i₂)).appTop =
              (j_open W).appTop := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hk_j inf_le_right]
          exact congrArg (fun φ => φ.hom t) hcat
        exact hL.trans hR.symm
      have hle_iSup : (⊤ : Y.Opens) ≤ iSup V := by
        intro y _
        exact TopologicalSpace.Opens.mem_iSup.mpr (hcov y)
      obtain ⟨c_top, hc_top, -⟩ :=
        Y.sheaf.existsUnique_gluing' V ⊤ (fun i => CategoryTheory.homOfLE le_top)
          hle_iSup c hCompat
      refine ⟨c_top, ?_⟩
      have hTop : TopologicalSpace.IsOpenCover V := eq_top_iff.mpr hle_iSup
      let 𝒰_Y : Y.OpenCover := Y.openCoverOfIsOpenCover V hTop
      let 𝒰_P : P.OpenCover := AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft 𝒰_Y f η_X
      apply AlgebraicGeometry.Scheme.OpenCover.ext_elem (U := ⊤) _ _ 𝒰_P
      intro (i : ι)
      have hf_eq : 𝒰_P.f i = j_open (V i) :=
        AlgebraicGeometry.Scheme.Pullback.openCoverOfLeft_f 𝒰_Y f η_X i
      rw [hf_eq]
      change (j_open (V i)).appTop.hom (p.appTop.hom c_top) = (j_open (V i)).appTop.hom t
      have hc_top' :
          (Y.presheaf.map (CategoryTheory.homOfLE (le_top : V i ≤ ⊤)).op).hom c_top = c i :=
        hc_top i
      rw [hj_app (V i) c_top, hc_top', hc i]

    refine ⟨hInj_units, fun s hLoc => ?_⟩
    let u_fam : ∀ i : ι, Units ↑(Y.presheaf.obj (Opposite.op (V i))) :=
      fun i => Classical.choose (hLoc i)
    have hu_fam :
        ∀ i : ι,
          Units.map (α_open (V i)).toMonoidHom (u_fam i) =
            Units.map (j_open (V i)).appTop.hom.toMonoidHom s :=
      fun i => Classical.choose_spec (hLoc i)
    have ha_loc : ∀ i : ι, α_open (V i) (u_fam i).val = (j_open (V i)).appTop.hom s.val :=
      fun i => congrArg Units.val (hu_fam i)
    have hb_loc :
        ∀ i : ι, α_open (V i) (u_fam i)⁻¹.val = (j_open (V i)).appTop.hom (s⁻¹).val := by
      intro i
      have hinv := congrArg Inv.inv (hu_fam i)
      rw [← map_inv, ← map_inv] at hinv
      exact congrArg Units.val hinv
    obtain ⟨a_top, ha_top⟩ := hGlueSec s.val (fun i => (u_fam i).val) ha_loc
    obtain ⟨b_top, hb_top⟩ := hGlueSec (s⁻¹).val (fun i => (u_fam i)⁻¹.val) hb_loc
    have hab : a_top * b_top = 1 :=
      hInj_p (by rw [map_mul, ha_top, hb_top, Units.mul_inv, map_one])
    exact ⟨⟨a_top, b_top, hab, mul_comm b_top a_top ▸ hab⟩, Units.ext ha_top⟩

theorem weil_pinned_curve_etale_stalk_dvr_valuation_package (k : Type u) [Field k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
