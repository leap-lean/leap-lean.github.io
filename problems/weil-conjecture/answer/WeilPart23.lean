  let FM₁ := Cℤ₁.obj AM
  let FM₂ := Cℤ₂.obj AM
  let one₁ := weilCupPDModUnit Y₁ ℓ
  let one₂ := weilCupPDModUnit Y₂ ℓ
  let T₁ := weilEtaleIdTerminal.{u} Y₁
  let T₂ := weilEtaleIdTerminal.{u} Y₂
  let hT₁ := weilEtaleIdTerminalIsTerminal.{u} Y₁
  let hT₂ := weilEtaleIdTerminalIsTerminal.{u} Y₂
  let adjR₁ := CategoryTheory.constantSheafAdj J₁ (ModuleCat.{u, u} R) hT₁
  let adjR₂ := CategoryTheory.constantSheafAdj J₂ (ModuleCat.{u, u} R) hT₂
  let adjℤ₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
  let adjℤ₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
  let Sigma_h := weilEtalePostcomp h hh

  rcases hr_q with ⟨hc, hAdd_Rsh, hLim_Rsh, hColim_Rsh, β_h, _hαβ_h, hβα_h, hr_eq⟩
  letI : Sigma_h.IsContinuous J₁ J₂ := hc
  let R_sh := Sigma_h.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂
  letI : R_sh.Additive := hAdd_Rsh
  letI : Limits.PreservesFiniteLimits R_sh := hLim_Rsh
  letI : Limits.PreservesFiniteColimits R_sh := hColim_Rsh
  let μ₁₂ : Sigma_h.obj T₁ ⟶ T₂ := hT₂.from (Sigma_h.obj T₁)
  let α_h : one₁ ⟶ R_sh.obj one₂ :=
    (adjR₁.homEquiv R_mod (R_sh.obj one₂)).symm
