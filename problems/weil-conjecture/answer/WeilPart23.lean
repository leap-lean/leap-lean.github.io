            (weilEtaleLocalTorsionCounitH Pd_succ n_mod U (2 * (δ + 1)) z)) =
        (fun x : weilEtaleLocalTorsionH Pd n_mod V (2 * δ) =>
          tr_Pd δ (r₀ + 1)
            (weilEtaleLocalTorsionCounitH Pd n_mod V (2 * δ) x)) ∘ φ_bij := by
      funext z
      dsimp only [Function.comp_apply]
      rw [hTr_ind (weilEtaleLocalTorsionCounitH Pd_succ n_mod U (2 * (δ + 1)) z)]
      congr 1
      have hNat := hEdge_nat Pd_succ π_fst L_U (weilEtaleTorsionSheaf Pd_succ n_mod)
        (weilEtaleLocalTorsionCounit Pd_succ n_mod U) hTor_LU hTor_std hz_LU hz_std z
      change (CategoryTheory.Abelian.Ext.mk₀ (Tr_rel δ (r₀ + 1))).postcomp Fℤ_base
          (Nat.add_zero (2 * δ))
          (E_edge Pd_succ π_fst (weilEtaleTorsionSheaf Pd_succ n_mod) hTor_std hz_std
            ((CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit Pd_succ n_mod U)).postcomp
              Fℤ_succ (Nat.add_zero (2 * (δ + 1))) z)) =
        weilEtaleLocalTorsionCounitH Pd n_mod V (2 * δ) (φ_bij z)
      rw [hNat]
      have he_H : E_edge Pd_succ π_fst L_U hTor_LU hz_LU z = e_H (φ_bij z) :=
        (e_H.apply_symm_apply _).symm
      rw [he_H]
      symm
      change (φ_bij z).comp
          (CategoryTheory.Abelian.Ext.mk₀
            (weilEtaleLocalTorsionCounit (weilPolyP1Over k δ).left (ℓ ^ (r₀ + 1)) V))
          (Nat.add_zero (2 * δ)) =
        (((φ_bij z).comp (CategoryTheory.Abelian.Ext.mk₀ e_LV.hom) (Nat.add_zero (2 * δ))).comp
          (CategoryTheory.Abelian.Ext.mk₀
            (weilPolyP1HigherDirectImageMap π_fst 2
              (weilEtaleLocalTorsionCounit (weilPolyP1Over k (δ + 1)).left (ℓ ^ (r₀ + 1)) U)))
          (Nat.add_zero (2 * δ))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (Tr_rel δ (r₀ + 1))) (Nat.add_zero (2 * δ))
      rw [← hCounit_eq, hPost_comp, hPost_comp]
    change Function.Bijective (fun z : weilEtaleLocalTorsionH Pd_succ n_mod U (2 * (δ + 1)) =>
      tr_Pd (δ + 1) (r₀ + 1)
        (weilEtaleLocalTorsionCounitH Pd_succ n_mod U (2 * (δ + 1)) z))
    rw [hFun_eq]
    exact hBij_V.comp φ_bij.bijective

theorem weil_etale_polyP1_pinned_kummer_model_trace (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (ζ : ℕ → kˣ)
    (hPrim : ∀ r : ℕ, IsPrimitiveRoot ((ζ r : kˣ) : k) (ℓ ^ r))
    (hPow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ) :
    ∃ (ι_aff : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
      (tr_Pd : ∀ (δ r : ℕ),
        weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r)),
      WeilIsPolyP1ModelTracePkg k ℓ Ψ ι_aff tr_Pd :=
by
  classical
  obtain ⟨ι_P1, ι_aff, hCoord⟩ := weil_polyP1_coord_compactification_and_properness k
  have hCD_pkg := weil_polyP1_torsion_cohomological_dim_vanishing k ℓ hℓ
  obtain ⟨tr_Pd, hBij, hTrans, hTrace⟩ :=
    weil_polyP1_kummer_leray_trace_tower k ℓ hℓ ζ hPrim hPow ι_P1 ι_aff hCoord
      (fun δ r F q hTor hq => (hCD_pkg δ r).1 F q hTor hq)
  refine ⟨ι_aff, tr_Pd, ?_, ?_, hTrans, ?_, ?_, ?_⟩
  · intro δ
    have hδ := hCoord.2.2.2.2.2.2.2.2 δ
    exact ⟨hδ.1, hδ.2.1, hδ.2.2.1⟩
  · intro r
    exact hBij 0 r
  · intro δ r q U hAff hq
    exact (hCD_pkg δ r).2 q U hAff hq
  · intro δ j U₁ U₂ u₁ u₂ e h hu₁ hu₂ hcomp₁ hcomp₂ hagree r z
    cases δ with
    | zero => exact Fin.elim0 j
    | succ m =>
      let P := weilPolyP1Over k (m + 1)
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget P.left
      let W₁ := (Fgt.obj U₁).left
      let W₂ := (Fgt.obj U₂).left
      have hProp : AlgebraicGeometry.IsProper P.hom := h.1
      have hAff₁ : AlgebraicGeometry.IsAffine W₁ := h.2.2.1
      have he_over :
          CategoryTheory.CategoryStruct.comp e.hom
            (CategoryTheory.CategoryStruct.comp (Fgt.obj U₂).hom P.hom) =
          CategoryTheory.CategoryStruct.comp (Fgt.obj U₁).hom P.hom := h.2.2.2
      have hAff₂ : AlgebraicGeometry.IsAffine W₂ :=
        (AlgebraicGeometry.IsAffine.iff_of_isIso e.hom).mp hAff₁
      obtain ⟨α_j, β_j, hβ_over, hαβ, hα_pr, hSwapTr⟩ :=
        weil_polyP1_pinned_coord_swap_trace_invariance k ℓ hℓ ζ hPrim hPow Ψ hΨ
          ι_P1 ι_aff hCoord tr_Pd hBij hTrace m j
      have hEt_U₁ : AlgebraicGeometry.Etale (Fgt.obj U₁).hom := U₁.prop
      have hEt_U₂ : AlgebraicGeometry.Etale (Fgt.obj U₂).hom := U₂.prop
      have hEt_β : AlgebraicGeometry.Etale β_j.hom := inferInstance
      have hEt₁' : AlgebraicGeometry.Etale ((Fgt.obj U₁).hom ≫ β_j.hom) := inferInstance
      have hEt₂' : AlgebraicGeometry.Etale ((Fgt.obj U₂).hom ≫ β_j.hom) := inferInstance
      let U'₁ : P.left.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((Fgt.obj U₁).hom ≫ β_j.hom) hEt₁'
      let U'₂ : P.left.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((Fgt.obj U₂).hom ≫ β_j.hom) hEt₂'
      let e₀₁ : CategoryTheory.Iso (Fgt.obj U₁).left (Fgt.obj U'₁).left :=
        CategoryTheory.Iso.refl W₁
      let e₀₂ : CategoryTheory.Iso (Fgt.obj U₂).left (Fgt.obj U'₂).left :=
        CategoryTheory.Iso.refl W₂
      let e' : CategoryTheory.Iso (Fgt.obj U'₁).left (Fgt.obj U'₂).left := e
      let e_top : CategoryTheory.Iso (Fgt.obj U₁).left (Fgt.obj U'₂).left := e
      have h₀₁ : WeilIsAffineRoofIso k P P U₁ U'₁ e₀₁ := by
        refine ⟨hProp, hProp, hAff₁, ?_⟩
        change 𝟙 W₁ ≫ (((Fgt.obj U₁).hom ≫ β_j.hom) ≫ P.hom) = (Fgt.obj U₁).hom ≫ P.hom
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hβ_over]
      have h₀₂ : WeilIsAffineRoofIso k P P U₂ U'₂ e₀₂ := by
        refine ⟨hProp, hProp, hAff₂, ?_⟩
        change 𝟙 W₂ ≫ (((Fgt.obj U₂).hom ≫ β_j.hom) ≫ P.hom) = (Fgt.obj U₂).hom ≫ P.hom
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hβ_over]
      have h' : WeilIsAffineRoofIso k P P U'₁ U'₂ e' := by
        refine ⟨hProp, hProp, hAff₁, ?_⟩
        change e.hom ≫ (((Fgt.obj U₂).hom ≫ β_j.hom) ≫ P.hom) =
          ((Fgt.obj U₁).hom ≫ β_j.hom) ≫ P.hom
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hβ_over]
        exact he_over
      have h_top : WeilIsAffineRoofIso k P P U₁ U'₂ e_top := by
        refine ⟨hProp, hProp, hAff₁, ?_⟩
        change e.hom ≫ (((Fgt.obj U₂).hom ≫ β_j.hom) ≫ P.hom) = (Fgt.obj U₁).hom ≫ P.hom
        rw [CategoryTheory.Category.assoc, hβ_over]
        exact he_over
      have he_left : CategoryTheory.Iso.trans e₀₁ e' = e_top := by
        ext1
        exact CategoryTheory.Category.id_comp e.hom
      have he_right : CategoryTheory.Iso.trans e e₀₂ = e_top := by
        ext1
        exact CategoryTheory.Category.comp_id e.hom
      have h₁₃_left : WeilIsAffineRoofIso k P P U₁ U'₂ (CategoryTheory.Iso.trans e₀₁ e') :=
        he_left.symm ▸ h_top
      have h₁₃_right : WeilIsAffineRoofIso k P P U₁ U'₂ (CategoryTheory.Iso.trans e e₀₂) :=
        he_right.symm ▸ h_top
      have hΨ_eq :
          ∀ (eA eB : CategoryTheory.Iso (Fgt.obj U₁).left (Fgt.obj U'₂).left)
            (hA : WeilIsAffineRoofIso k P P U₁ U'₂ eA)
            (hB : WeilIsAffineRoofIso k P P U₁ U'₂ eB),
            eA = eB →
            Ψ P P U₁ U'₂ eA hA r (2 * (m + 1)) z =
              Ψ P P U₁ U'₂ eB hB r (2 * (m + 1)) z := by
        intro eA eB hA hB hEq
        subst hEq
        rfl
      have hEt_α : AlgebraicGeometry.Etale α_j.hom := inferInstance
      let u₁_hom : W₁ ⟶ (weilAffineSpaceOver k (m + 1)).left := u₁
      let u₂_hom : W₂ ⟶ (weilAffineSpaceOver k (m + 1)).left := u₂
      have hEt_u₁ : AlgebraicGeometry.Etale u₁_hom := hu₁
      have hEt_u₂ : AlgebraicGeometry.Etale u₂_hom := hu₂
      let u'₁ : Quiver.Hom (Fgt.obj U'₁).left (weilAffineSpaceOver k (m + 1)).left :=
        u₁_hom ≫ α_j.hom
      let u'₂ : Quiver.Hom (Fgt.obj U'₂).left (weilAffineSpaceOver k (m + 1)).left :=
        u₂_hom ≫ α_j.hom
      have hu'₁ : AlgebraicGeometry.Etale u'₁ :=
        (inferInstance : AlgebraicGeometry.Etale (u₁_hom ≫ α_j.hom))
      have hu'₂ : AlgebraicGeometry.Etale u'₂ :=
        (inferInstance : AlgebraicGeometry.Etale (u₂_hom ≫ α_j.hom))
      have hcomp'₁ :
          CategoryTheory.CategoryStruct.comp u'₁ (ι_aff (m + 1)) = (Fgt.obj U'₁).hom := by
        change (u₁ ≫ α_j.hom) ≫ ι_aff (m + 1) = (Fgt.obj U₁).hom ≫ β_j.hom
        rw [CategoryTheory.Category.assoc, hαβ, ← CategoryTheory.Category.assoc, hcomp₁]
      have hcomp'₂ :
          CategoryTheory.CategoryStruct.comp u'₂ (ι_aff (m + 1)) = (Fgt.obj U'₂).hom := by
        change (u₂ ≫ α_j.hom) ≫ ι_aff (m + 1) = (Fgt.obj U₂).hom ≫ β_j.hom
        rw [CategoryTheory.Category.assoc, hαβ, ← CategoryTheory.Category.assoc, hcomp₂]
      have hagree' :
          ∀ (i : Fin (m + 1)), i ≠ Fin.last m →
            let pr_i : Quiver.Hom (weilAffineSpaceOver k (m + 1)).left
                (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k)).toRingHom)
            CategoryTheory.CategoryStruct.comp u'₁ pr_i =
              CategoryTheory.CategoryStruct.comp e'.hom
                (CategoryTheory.CategoryStruct.comp u'₂ pr_i) := by
        intro i hi
        dsimp only
        let pr_i : Quiver.Hom (weilAffineSpaceOver k (m + 1)).left
            (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k)).toRingHom)
        let i' : Fin (m + 1) := Equiv.swap j (Fin.last m) i
        have hi' : i' ≠ j := by
          intro h_eq
          apply hi
          have h_app := congrArg (Equiv.swap j (Fin.last m)) h_eq
          rw [Equiv.swap_apply_self, Equiv.swap_apply_left] at h_app
          exact h_app
        let pr_i' : Quiver.Hom (weilAffineSpaceOver k (m + 1)).left
            (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (MvPolynomial.X i' : MvPolynomial (Fin (m + 1)) k)).toRingHom)
        have hpr₁ : α_j.hom ≫ pr_i = pr_i' := hα_pr i
        change (u₁ ≫ α_j.hom) ≫ pr_i = e.hom ≫ ((u₂ ≫ α_j.hom) ≫ pr_i)
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hpr₁]
        exact hagree i' hi'
      have hcomm₁ :
          CategoryTheory.CategoryStruct.comp (Fgt.obj U₁).hom β_j.hom =
            CategoryTheory.CategoryStruct.comp e₀₁.hom (Fgt.obj U'₁).hom := by
        change (Fgt.obj U₁).hom ≫ β_j.hom = 𝟙 W₁ ≫ ((Fgt.obj U₁).hom ≫ β_j.hom)
        exact (CategoryTheory.Category.id_comp _).symm
      have hcomm₂ :
          CategoryTheory.CategoryStruct.comp (Fgt.obj U₂).hom β_j.hom =
            CategoryTheory.CategoryStruct.comp e₀₂.hom (Fgt.obj U'₂).hom := by
        change (Fgt.obj U₂).hom ≫ β_j.hom = 𝟙 W₂ ≫ ((Fgt.obj U₂).hom ≫ β_j.hom)
        exact (CategoryTheory.Category.id_comp _).symm
      have hStep1 := hSwapTr U₁ U'₁ e₀₁ h₀₁ hcomm₁ r z
      have hStep2 :=
        weil_polyP1_pinned_last_coord_norm_invariance k ℓ hℓ ζ hPrim hPow Ψ hΨ
          ι_P1 ι_aff hCoord tr_Pd hBij hTrace m U'₁ U'₂ u'₁ u'₂ e' h'
          hu'₁ hu'₂ hcomp'₁ hcomp'₂ hagree' r
          (Ψ P P U₁ U'₁ e₀₁ h₀₁ r (2 * (m + 1)) z)
      have hTrans1 :
          Ψ P P U'₁ U'₂ e' h' r (2 * (m + 1))
              (Ψ P P U₁ U'₁ e₀₁ h₀₁ r (2 * (m + 1)) z) =
            Ψ P P U₁ U'₂ (CategoryTheory.Iso.trans e₀₁ e') h₁₃_left r (2 * (m + 1)) z :=
        DFunLike.congr_fun
          (hΨ.2.1 P P P U₁ U'₁ U'₂ e₀₁ e' h₀₁ h' h₁₃_left r (2 * (m + 1))) z
      have hTransEq :
          Ψ P P U₁ U'₂ (CategoryTheory.Iso.trans e₀₁ e') h₁₃_left r (2 * (m + 1)) z =
            Ψ P P U₁ U'₂ (CategoryTheory.Iso.trans e e₀₂) h₁₃_right r (2 * (m + 1)) z :=
        hΨ_eq (CategoryTheory.Iso.trans e₀₁ e') (CategoryTheory.Iso.trans e e₀₂)
          h₁₃_left h₁₃_right (he_left.trans he_right.symm)
      have hTrans2 :
          Ψ P P U₁ U'₂ (CategoryTheory.Iso.trans e e₀₂) h₁₃_right r (2 * (m + 1)) z =
            Ψ P P U₂ U'₂ e₀₂ h₀₂ r (2 * (m + 1))
              (Ψ P P U₁ U₂ e h r (2 * (m + 1)) z) :=
        (DFunLike.congr_fun
          (hΨ.2.1 P P P U₁ U₂ U'₂ e e₀₂ h h₀₂ h₁₃_right r (2 * (m + 1))) z).symm
      have hStep3 :=
        (hSwapTr U₂ U'₂ e₀₂ h₀₂ hcomm₂ r (Ψ P P U₁ U₂ e h r (2 * (m + 1)) z)).symm
      rw [hStep1, hStep2, hTrans1, hTransEq, hTrans2, hStep3]
  · exact weil_polyP1_pinned_connected_curve_fibration_bijective k ℓ hℓ ζ hPrim hPow Ψ hΨ
      ι_P1 ι_aff hCoord tr_Pd hBij hTrace

theorem weil_etale_pinned_steinitz_chart_invariance_and_gluing (k : Type u) [Field k] [IsAlgClosed k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt : AlgebraicGeometry.IsIntegral X.left)
    [AlgebraicGeometry.IsProper X.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (ι_aff : ∀ δ : ℕ, Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (tr_Pd : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r))
    (hModel : WeilIsPolyP1ModelTracePkg k ℓ Ψ ι_aff tr_Pd) :
    WeilChartTraceIndependent k ℓ Ψ ι_aff tr_Pd ∧
    ∃ tr : ∀ r : ℕ, weilEtaleTorsionH X.left (ℓ ^ r) (2 * d) →+ ZMod (ℓ ^ r),
      (∀ (r : ℕ) (w : weilEtaleTorsionH X.left (ℓ ^ (r + 1)) (2 * d)),
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r)) (tr (r + 1) w) =
          tr r (weilEtaleTorsionTransition X.left ℓ r (2 * d) w)) ∧
      (∀ (U : X.left.Etale)
        (widetilde_U : (weilPolyP1Over k d).left.Etale)
        (u : Quiver.Hom ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).left
          (weilAffineSpaceOver k d).left)
        (e : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).left
          ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k d).left).obj widetilde_U).left)
        (hRoof : WeilIsAffineRoofIso k X (weilPolyP1Over k d) U widetilde_U e),
        AlgebraicGeometry.Etale u →
        CategoryTheory.CategoryStruct.comp e.hom
            ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k d).left).obj widetilde_U).hom =
          CategoryTheory.CategoryStruct.comp u (ι_aff d) →
        ∀ (r : ℕ) (z : weilEtaleLocalTorsionH X.left (ℓ ^ r) U (2 * d)),
          tr r (weilEtaleLocalTorsionCounitH X.left (ℓ ^ r) U (2 * d) z) =
            tr_Pd d r (weilEtaleLocalTorsionCounitH (weilPolyP1Over k d).left (ℓ ^ r) widetilde_U (2 * d)
              (Ψ X (weilPolyP1Over k d) U widetilde_U e hRoof r (2 * d) z))) :=
by
  classical
  have s1_steinitz : ∀ (k : Type u) [Field k] (δ : ℕ) (A : Type u) [CommRing A]
      (φ₁ φ₂ : MvPolynomial (Fin δ) k →+* A)
      (_hC : φ₁.comp MvPolynomial.C = φ₂.comp MvPolynomial.C)
      (_hEt₁ : φ₁.Etale) (_hEt₂ : φ₂.Etale),
      ∃ (M : ℕ) (g : Fin M → A),
        Ideal.span (Set.range g) = ⊤ ∧
        ∀ a : Fin M,
          ∃ (K : ℕ) (ψ : Fin (K + 1) → (MvPolynomial (Fin δ) k →+* Localization.Away (g a))),
            ψ 0 = (algebraMap A (Localization.Away (g a))).comp φ₁ ∧
            ψ (Fin.last K) = (algebraMap A (Localization.Away (g a))).comp φ₂ ∧
            (∀ s : Fin (K + 1),
              (ψ s).comp MvPolynomial.C =
                ((algebraMap A (Localization.Away (g a))).comp φ₁).comp MvPolynomial.C ∧
              (ψ s).Etale) ∧
            (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j →
              ψ (Fin.castSucc s) (MvPolynomial.X i) = ψ s.succ (MvPolynomial.X i)) := by
    clear! k d ℓ
    intro k _ δ A _ φ₁ φ₂ hC hEt₁ hEt₂
    classical
    by_cases hSub : Subsingleton A
    · refine ⟨0, Fin.elim0, ?_, fun a => Fin.elim0 a⟩
      rw [Ideal.eq_top_iff_one, hSub.elim (1 : A) 0]
      exact Submodule.zero_mem _
    have hNontriv : Nontrivial A := not_subsingleton_iff_nontrivial.mp hSub
    by_cases hδ0 : δ = 0
    · subst hδ0
      have hφ_eq : φ₁ = φ₂ :=
        MvPolynomial.ringHom_ext (fun c => RingHom.congr_fun hC c) (fun i => Fin.elim0 i)
      refine ⟨1, fun _ => 1, ?_, fun _ => ?_⟩
      · rw [Ideal.eq_top_iff_one]
        exact Ideal.subset_span ⟨0, rfl⟩
      · let ι : A →+* Localization.Away (1 : A) := algebraMap A (Localization.Away (1 : A))
        have hEt_ι : ι.Etale := by
          dsimp [ι]
          rw [RingHom.etale_algebraMap]
          have : Algebra.FormallyEtale A (Localization.Away (1 : A)) :=
            Algebra.FormallyEtale.of_isLocalization (Submonoid.powers (1 : A))
          have : Algebra.FinitePresentation A (Localization.Away (1 : A)) :=
            @Algebra.FinitePresentation.of_isLocalizationAway A A (Localization.Away (1 : A))
              _ _ _ _ _ _ _ (1 : A) _ inferInstance
          exact Algebra.Etale.mk
        refine ⟨0, fun _ => ι.comp φ₁, rfl, ?_, fun _ => ⟨rfl, ?_⟩, fun s => Fin.elim0 s⟩
        · change ι.comp φ₁ = ι.comp φ₂
          rw [hφ_eq]
        · exact RingHom.Etale.stableUnderComposition _ _ hEt₁ hEt_ι
    let P := MvPolynomial (Fin δ) k
    let alg_kA : Algebra k A := (φ₁.comp MvPolynomial.C).toAlgebra
    have hBasisOfEtale : ∀ (φ : P →+* A),
        φ.comp MvPolynomial.C = φ₁.comp MvPolynomial.C →
        φ.Etale →
        Algebra.Smooth k A ∧
        ∃ b : Module.Basis (Fin δ) A Ω[A⁄k],
          ∀ i : Fin δ, b i = KaehlerDifferential.D k A (φ (MvPolynomial.X i)) := by
      intro φ hφC hφEt
      let _ : Algebra P A := φ.toAlgebra
      have _ : IsScalarTower k P A := IsScalarTower.of_algebraMap_eq' (by
        ext c
        exact (RingHom.congr_fun hφC c).symm)
      have _ : Algebra.Etale P A := RingHom.etale_algebraMap.mp hφEt
      have hSm : Algebra.Smooth k A := Algebra.Smooth.comp k P A
      let bP : Module.Basis (Fin δ) P Ω[P⁄k] := KaehlerDifferential.mvPolynomialBasis k (Fin δ)
      let e_PA : TensorProduct P A Ω[P⁄k] ≃ₗ[A] Ω[A⁄k] :=
        KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k P A
      let bA : Module.Basis (Fin δ) A Ω[A⁄k] := (bP.baseChange A).map e_PA
      refine ⟨hSm, bA, fun i => ?_⟩
      change e_PA ((bP.baseChange A) i) = KaehlerDifferential.D k A (algebraMap P A (MvPolynomial.X i))
      rw [Module.Basis.baseChange_apply]
      have hbP_i : bP i = KaehlerDifferential.D k P (MvPolynomial.X i) := by
        dsimp [bP]
        exact KaehlerDifferential.mvPolynomialBasis_apply k (Fin δ) i
      rw [hbP_i]
      change KaehlerDifferential.mapBaseChange k P A (1 ⊗ₜ[P] KaehlerDifferential.D k P (MvPolynomial.X i)) = _
      rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
    obtain ⟨hSm_kA, b₁, hb₁⟩ := hBasisOfEtale φ₁ rfl hEt₁
    obtain ⟨_, b₂, hb₂⟩ := hBasisOfEtale φ₂ hC.symm hEt₂
    have _ : Algebra.Smooth k A := hSm_kA
    let J : (Fin δ → A) → Matrix (Fin δ) (Fin δ) A :=
      fun w => Matrix.of fun r i => b₁.repr (KaehlerDifferential.D k A (w i)) r
    let u₁_vec : Fin δ → A := fun i => φ₁ (MvPolynomial.X i)
    let u₂_vec : Fin δ → A := fun i => φ₂ (MvPolynomial.X i)
    have hJ_u₁ : J u₁_vec = 1 := by
      ext r i
      simp only [J, u₁_vec, Matrix.of_apply, ← hb₁ i, Module.Basis.repr_self,
        Finsupp.single_apply, Matrix.one_apply]
      by_cases hri : i = r
      · subst hri; simp
      · have hne : r ≠ i := fun h => hri h.symm
        simp [hri, hne]
    have hDet_u₁ : (J u₁_vec).det = 1 := by rw [hJ_u₁, Matrix.det_one]
    have hUnit_u₂ : IsUnit (J u₂_vec).det := by
      let J₂_inv : Matrix (Fin δ) (Fin δ) A := Matrix.of fun i s => b₂.repr (b₁ s) i
      have hmul : J u₂_vec * J₂_inv = 1 := by
        ext r s
        simp only [J, J₂_inv, u₂_vec, Matrix.mul_apply, Matrix.of_apply, ← hb₂, Matrix.one_apply]
        have hlin : (∑ i : Fin δ, b₁.repr (b₂ i) r * b₂.repr (b₁ s) i) =
            b₁.repr (∑ i : Fin δ, b₂.repr (b₁ s) i • b₂ i) r := by
          rw [map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_smul, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, mul_comm]
        rw [hlin, Module.Basis.sum_repr b₂ (b₁ s), Module.Basis.repr_self, Finsupp.single_apply]
        by_cases hrs : s = r
        · subst hrs; simp
        · have hne : r ≠ s := fun h => hrs h.symm
          simp [hrs, hne]
      have hdet_mul : (J u₂_vec).det * J₂_inv.det = 1 := by
        rw [← Matrix.det_mul, hmul, Matrix.det_one]
      exact ⟨⟨(J u₂_vec).det, J₂_inv.det, hdet_mul, mul_comm (J u₂_vec).det J₂_inv.det ▸ hdet_mul⟩, rfl⟩
    have hLocEtale : ∀ (f : A) (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away f S]
        (w : Fin δ → A),
        IsUnit (algebraMap A S (J w).det) →
        ∃ ψ_w : P →+* S,
          ψ_w.comp MvPolynomial.C = ((algebraMap A S).comp φ₁).comp MvPolynomial.C ∧
          (∀ i : Fin δ, ψ_w (MvPolynomial.X i) = algebraMap A S (w i)) ∧
          ψ_w.Etale := by
      intro f S _ _ _ w hUnit_w
      let _ : Algebra k S := ((algebraMap A S).comp (algebraMap k A)).toAlgebra
      have _ : IsScalarTower k A S := IsScalarTower.of_algebraMap_eq' rfl
      have _ : Algebra.FormallyEtale A S :=
        Algebra.FormallyEtale.of_isLocalization (Submonoid.powers f)
      have _ : Algebra.FinitePresentation A S :=
        @Algebra.FinitePresentation.of_isLocalizationAway A A S _ _ _ _ _ _ _ f _ inferInstance
      have _ : Algebra.Etale A S := Algebra.Etale.mk
      have _ : Algebra.Smooth k S := Algebra.Smooth.comp k A S
      let ψ_alg : P →ₐ[k] S := MvPolynomial.aeval (fun i => algebraMap A S (w i))
      refine ⟨ψ_alg.toRingHom, ?_, fun i => MvPolynomial.aeval_X _ i, ?_⟩
      · ext c
        exact ψ_alg.commutes c
      · let _ : Algebra P S := ψ_alg.toRingHom.toAlgebra
        have _ : IsScalarTower k P S := IsScalarTower.of_algebraMap_eq' (by
          ext c
          exact (ψ_alg.commutes c).symm)
        have _ : Algebra.FinitePresentation P S :=
          Algebra.FinitePresentation.of_restrict_scalars_finitePresentation k P S
        let b_dom : Module.Basis (Fin δ) S (TensorProduct P S Ω[P⁄k]) :=
          (KaehlerDifferential.mvPolynomialBasis k (Fin δ)).baseChange S
        let e_AS : TensorProduct A S Ω[A⁄k] ≃ₗ[S] Ω[S⁄k] :=
          KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale k A S
        let b_cod : Module.Basis (Fin δ) S Ω[S⁄k] := (b₁.baseChange S).map e_AS
        let L : TensorProduct P S Ω[P⁄k] →ₗ[S] Ω[S⁄k] :=
          KaehlerDifferential.mapBaseChange k P S
        have hb_cod_apply : ∀ r : Fin δ,
            b_cod r = KaehlerDifferential.D k S (algebraMap A S (u₁_vec r)) := by
          intro r
          change e_AS ((b₁.baseChange S) r) = _
          rw [Module.Basis.baseChange_apply, hb₁ r]
          change KaehlerDifferential.mapBaseChange k A S
            (1 ⊗ₜ[A] KaehlerDifferential.D k A (u₁_vec r)) = _
          rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
        have hMat_L : LinearMap.toMatrix b_dom b_cod L = (J w).map (algebraMap A S) := by
          ext r i
          rw [LinearMap.toMatrix_apply, Matrix.map_apply]
          have hLb : L (b_dom i) = ∑ s : Fin δ, algebraMap A S (J w s i) • b_cod s := by
            have hdom_i : b_dom i = 1 ⊗ₜ[P] KaehlerDifferential.D k P (MvPolynomial.X i) := by
              dsimp [b_dom]
              rw [Module.Basis.baseChange_apply, KaehlerDifferential.mvPolynomialBasis_apply]
            have hLw : L (b_dom i) = KaehlerDifferential.D k S (algebraMap A S (w i)) := by
              rw [hdom_i]
              change KaehlerDifferential.mapBaseChange k P S
                (1 ⊗ₜ[P] KaehlerDifferential.D k P (MvPolynomial.X i)) = _
              rw [KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
              congr 1
              exact MvPolynomial.aeval_X (fun j => algebraMap A S (w j)) i
            rw [hLw, ← KaehlerDifferential.map_D k k A S (w i),
              ← Module.Basis.sum_repr b₁ (KaehlerDifferential.D k A (w i)), map_sum]
            refine Finset.sum_congr rfl fun s _ => ?_
            rw [map_smul, hb₁ s, KaehlerDifferential.map_D, ← hb_cod_apply s,
              algebra_compatible_smul S]
            rfl
          rw [hLb, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
          simp only [map_smul, Finsupp.coe_smul, Pi.smul_apply, Module.Basis.repr_self,
            Finsupp.single_apply, smul_eq_mul, mul_ite, mul_one, mul_zero,
            Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
        have hdet_map : ((J w).map (algebraMap A S)).det = algebraMap A S (J w).det :=
          (RingHom.map_det (algebraMap A S) (J w)).symm
        have hIsUnit_M : IsUnit (LinearMap.toMatrix b_dom b_cod L) := by
          rw [Matrix.isUnit_iff_isUnit_det, hMat_L, hdet_map]
          exact hUnit_w
        obtain ⟨uM, huM⟩ := hIsUnit_M
        let M_inv : Matrix (Fin δ) (Fin δ) S := ↑uM⁻¹
        have hM_mul1 : LinearMap.toMatrix b_dom b_cod L * M_inv = 1 := by
          rw [← huM]; exact Units.mul_inv uM
        have hM_mul2 : M_inv * LinearMap.toMatrix b_dom b_cod L = 1 := by
          rw [← huM]; exact Units.inv_mul uM
        let L_inv : Ω[S⁄k] →ₗ[S] TensorProduct P S Ω[P⁄k] := Matrix.toLin b_cod b_dom M_inv
        have hL_id1 : L.comp L_inv = LinearMap.id := by
          apply (LinearMap.toMatrix b_cod b_cod).injective
          rw [LinearMap.toMatrix_comp b_cod b_dom b_cod, LinearMap.toMatrix_toLin, hM_mul1,
            LinearMap.toMatrix_id]
        have hL_id2 : L_inv.comp L = LinearMap.id := by
          apply (LinearMap.toMatrix b_dom b_dom).injective
          rw [LinearMap.toMatrix_comp b_dom b_cod b_dom, LinearMap.toMatrix_toLin, hM_mul2,
            LinearMap.toMatrix_id]
        have hL_bij : Function.Bijective L :=
          ⟨fun x y hxy => by
            have := congrArg L_inv hxy
            simpa [LinearMap.comp_apply] using
              (LinearMap.congr_fun hL_id2 x).symm.trans (this.trans (LinearMap.congr_fun hL_id2 y)),
           fun y => ⟨L_inv y, LinearMap.congr_fun hL_id1 y⟩⟩
        have hSub_Ω : Subsingleton Ω[S⁄P] := by
          refine subsingleton_of_forall_eq 0 fun ω => ?_
          obtain ⟨x, rfl⟩ := KaehlerDifferential.map_surjective k P S ω
          obtain ⟨y, rfl⟩ := hL_bij.2 x
          exact (KaehlerDifferential.exact_mapBaseChange_map k P S (L y)).mpr ⟨y, rfl⟩
        have hSub_H1_kS : Subsingleton (Algebra.H1Cotangent k S) :=
          ((Algebra.formallySmooth_iff k S).mp inferInstance).2
        have hSub_H1 : Subsingleton (Algebra.H1Cotangent P S) := by
          refine subsingleton_of_forall_eq 0 fun z => ?_
          have hLz : L (Algebra.H1Cotangent.δ k P S z) = 0 :=
            (Algebra.H1Cotangent.exact_δ_mapBaseChange k P S (Algebra.H1Cotangent.δ k P S z)).mpr ⟨z, rfl⟩
          have hδz : Algebra.H1Cotangent.δ k P S z = 0 :=
            hL_bij.1 (hLz.trans (map_zero L).symm)
          obtain ⟨u, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ k P S z).mp hδz
          rw [hSub_H1_kS.elim u 0, map_zero]
        have _ : Algebra.FormallyEtale P S := Algebra.FormallyEtale.mk hSub_Ω hSub_H1
        have _ : Algebra.Etale P S := Algebra.Etale.mk
        exact RingHom.etale_algebraMap.mpr inferInstance
    let D_set : (Fin δ → A) → Finset (Fin δ) :=
      fun w => Finset.univ.filter (fun i => w i ≠ u₂_vec i)
    have hPrepend : ∀ {w₀ w₁ : Fin δ → A} {K : ℕ} {W : Fin (K + 1) → Fin δ → A}
        (Q : (Fin δ → A) → Prop) (j₀ : Fin δ),
        Q w₀ →
        (∀ i : Fin δ, i ≠ j₀ → w₀ i = w₁ i) →
        W 0 = w₁ →
        W (Fin.last K) = u₂_vec →
        (∀ s : Fin (K + 1), Q (W s)) →
        (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j → W s.castSucc i = W s.succ i) →
        ∃ (K' : ℕ) (W' : Fin (K' + 1) → Fin δ → A),
          W' 0 = w₀ ∧
          W' (Fin.last K') = u₂_vec ∧
          (∀ s : Fin (K' + 1), Q (W' s)) ∧
          (∀ s : Fin K', ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j → W' s.castSucc i = W' s.succ i) := by
      intro w₀ w₁ K W Q j₀ hQw₀ hw₀₁ hW0 hWK hQW hStepW
      let W_ext : Fin ((K + 1) + 1) → Fin δ → A := fun s =>
        if h0 : s.val = 0 then w₀
        else W ⟨s.val - 1, Nat.sub_lt_right_of_lt_add (Nat.pos_of_ne_zero h0) s.isLt⟩
      have hW_ext_zero : W_ext 0 = w₀ := rfl
      have hW_ext_succ : ∀ t : Fin (K + 1), W_ext t.succ = W t := fun _ => rfl
      refine ⟨K + 1, W_ext, hW_ext_zero, ?_, ?_, ?_⟩
      · rw [← Fin.succ_last K, hW_ext_succ, hWK]
      · intro s
        refine Fin.cases ?_ ?_ s
        · rw [hW_ext_zero]; exact hQw₀
        · intro t; rw [hW_ext_succ]; exact hQW t
      · intro s
        refine Fin.cases ?_ ?_ s
        · refine ⟨j₀, fun i hi => ?_⟩
          rw [Fin.castSucc_zero, hW_ext_zero, hW_ext_succ, hW0]
          exact hw₀₁ i hi
        · intro t
          obtain ⟨j, hj⟩ := hStepW t
          refine ⟨j, fun i hi => ?_⟩
          rw [Fin.castSucc_succ, hW_ext_succ, hW_ext_succ]
          exact hj i hi
    have hChainAtMax : ∀ (𝔪 : Ideal A) [𝔪.IsMaximal],
        ∃ (K : ℕ) (W : Fin (K + 1) → Fin δ → A),
          W 0 = u₁_vec ∧
          W (Fin.last K) = u₂_vec ∧
          (∀ s : Fin (K + 1), (J (W s)).det ∉ 𝔪) ∧
          (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j → W s.castSucc i = W s.succ i) := by
      intro 𝔪 h𝔪
      let F := A ⧸ 𝔪
      let _ : Field F := Ideal.Quotient.field 𝔪
      let π : A →+* F := Ideal.Quotient.mk 𝔪
      let M_bar : (Fin δ → A) → Matrix (Fin δ) (Fin δ) F := fun w => (J w).map π
      have hDet_bar : ∀ w : Fin δ → A, (M_bar w).det = π (J w).det :=
        fun w => (RingHom.map_det π (J w)).symm
      have hDet_u₂_bar : (M_bar u₂_vec).det ≠ 0 := by
        rw [hDet_bar]
        exact (hUnit_u₂.map π).ne_zero
      have hPivot : ∀ (w : Fin δ → A) (j : Fin δ) (c : Fin δ → F),
          (M_bar w).det ≠ 0 →
          (∀ r : Fin δ, M_bar u₂_vec r j = (M_bar w).mulVec c r) →
          c j ≠ 0 →
          (M_bar (Function.update w j (u₂_vec j))).det ≠ 0 := by
        intro w j c hdet_w hc hcj
        let w' := Function.update w j (u₂_vec j)
        let E : Matrix (Fin δ) (Fin δ) F :=
          Matrix.of fun s i => if i = j then c s else if s = i then 1 else 0
        let E_inv : Matrix (Fin δ) (Fin δ) F :=
          Matrix.of fun s i =>
            if i = j then (if s = j then (c j)⁻¹ else -(c s * (c j)⁻¹))
            else (if s = i then 1 else 0)
        have hMw' : M_bar w' = M_bar w * E := by
          ext r i
          simp only [M_bar, J, w', E, Matrix.map_apply, Matrix.mul_apply, Matrix.of_apply]
          by_cases hij : i = j
          · subst hij
            simp only [Function.update_self, ↓reduceIte]
            exact hc r
          · simp only [Function.update_of_ne hij, hij, ↓reduceIte, mul_ite, mul_one, mul_zero,
              Finset.sum_ite_eq', Finset.mem_univ]
        have hEE_inv : E * E_inv = 1 := by
          ext r i
          simp only [E, E_inv, Matrix.mul_apply, Matrix.of_apply, Matrix.one_apply]
          by_cases hij : i = j
          · subst hij
            simp only [↓reduceIte]
            rw [Fintype.sum_eq_add_sum_compl i]
            simp only [↓reduceIte]
            by_cases hri : r = i
            · subst hri
              simp only [↓reduceIte]
              have hsum0 : ∑ x ∈ ({r} : Finset (Fin δ))ᶜ,
                  (if x = r then c r else if r = x then 1 else 0) *
                    (if x = r then (c r)⁻¹ else -(c x * (c r)⁻¹)) = 0 := by
                refine Finset.sum_eq_zero fun x hx => ?_
                rw [Finset.mem_compl, Finset.mem_singleton] at hx
                have hrx : r ≠ x := fun h => hx h.symm
                simp [hx, hrx]
              rw [hsum0, add_zero]
              exact mul_inv_cancel₀ hcj
            · simp only [hri, ↓reduceIte]
              have hr_mem : r ∈ ({i} : Finset (Fin δ))ᶜ :=
                Finset.mem_compl.mpr (Finset.notMem_singleton.mpr hri)
              have hsum_r : ∑ x ∈ ({i} : Finset (Fin δ))ᶜ,
                  (if x = i then c r else if r = x then 1 else 0) *
                    (if x = i then (c i)⁻¹ else -(c x * (c i)⁻¹)) = -(c r * (c i)⁻¹) := by
                rw [Finset.sum_eq_single r]
                · simp [hri]
                · intro x hx hxr
                  rw [Finset.mem_compl, Finset.mem_singleton] at hx
                  have hrx : r ≠ x := fun h => hxr h.symm
                  simp [hx, hrx]
                · intro hr_not; exact absurd hr_mem hr_not
              rw [hsum_r, add_neg_cancel]
          · simp only [hij, ↓reduceIte]
            rw [Finset.sum_eq_single i]
            · simp [hij]
            · intro x _ hxi
              simp [hxi]
            · intro hi_not
              exact absurd (Finset.mem_univ i) hi_not
        have hdet_mul : E.det * E_inv.det = 1 := by
          rw [← Matrix.det_mul, hEE_inv, Matrix.det_one]
        have hdetE : E.det ≠ 0 := left_ne_zero_of_mul_eq_one hdet_mul
        change (M_bar w').det ≠ 0
        rw [hMw', Matrix.det_mul]
        exact mul_ne_zero hdet_w hdetE
      have hInd : ∀ (n : ℕ) (w : Fin δ → A),
          (D_set w).card = n →
          (M_bar w).det ≠ 0 →
          ∃ (K : ℕ) (W : Fin (K + 1) → Fin δ → A),
            W 0 = w ∧
            W (Fin.last K) = u₂_vec ∧
            (∀ s : Fin (K + 1), (M_bar (W s)).det ≠ 0) ∧
            (∀ s : Fin K, ∃ j : Fin δ, ∀ i : Fin δ, i ≠ j → W s.castSucc i = W s.succ i) := by
        intro n
        induction n using Nat.strongRecOn with
        | ind n ih =>
          intro w hcard hdet_w
          by_cases hEmp : (D_set w).Nonempty
          · obtain ⟨j, hj⟩ := hEmp
            have hUnit_Mw : IsUnit (M_bar w) :=
              (Matrix.isUnit_iff_isUnit_det (M_bar w)).mpr (IsUnit.mk0 _ hdet_w)
            obtain ⟨uMw, huMw⟩ := hUnit_Mw
            let Mw_inv : Matrix (Fin δ) (Fin δ) F := ↑uMw⁻¹
            have hMw_mul : M_bar w * Mw_inv = 1 := by rw [← huMw]; exact Units.mul_inv uMw
            let c : Fin δ → F := Mw_inv.mulVec (fun r => M_bar u₂_vec r j)
            have hc_eq : ∀ r : Fin δ, M_bar u₂_vec r j = (M_bar w).mulVec c r := by
              intro r
              dsimp [c]
              rw [Matrix.mulVec_mulVec, hMw_mul, Matrix.one_mulVec]
            by_cases hcj : c j ≠ 0
            · let w' := Function.update w j (u₂_vec j)
              have hdet_w' : (M_bar w').det ≠ 0 := hPivot w j c hdet_w hc_eq hcj
              have hsub_D : D_set w' ⊆ (D_set w).erase j := by
                intro i hi
                simp only [D_set, Finset.mem_filter, Finset.mem_univ, true_and] at hi
                rw [Finset.mem_erase]
                have hij : i ≠ j := by
                  intro heq; subst heq
                  exact hi (Function.update_self i (u₂_vec i) w)
                dsimp [w'] at hi
                rw [Function.update_of_ne hij] at hi
                exact ⟨hij, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩
              have hlt_card : (D_set w').card < n := by
                calc
                  (D_set w').card ≤ ((D_set w).erase j).card := Finset.card_le_card hsub_D
                  _ < (D_set w).card := Finset.card_erase_lt_of_mem hj
                  _ = n := hcard
              obtain ⟨K', W', hW'0, hW'K, hdetW', hStepW'⟩ :=
                ih (D_set w').card hlt_card w' rfl hdet_w'
              exact hPrepend (fun v => (M_bar v).det ≠ 0) j hdet_w
                (fun i hi => (Function.update_of_ne hi (u₂_vec j) w).symm)
                hW'0 hW'K hdetW' hStepW'
            · rw [not_not] at hcj
              have hEx_m : ∃ m ∈ D_set w, c m ≠ 0 := by
                by_contra hAll0
                have hAll : ∀ m ∈ D_set w, c m = 0 := fun m hm => by
                  by_contra hne
                  exact hAll0 ⟨m, hm, hne⟩
                let y : Fin δ → F := fun s =>
                  if s = j then 1 else if s ∈ D_set w then 0 else -c s
                have hy0 : (M_bar u₂_vec).mulVec y = 0 := by
                  ext r
                  rw [Pi.zero_apply, Matrix.mulVec, dotProduct]
                  rw [Fintype.sum_eq_add_sum_compl j]
                  have hyj : y j = 1 := by simp [y]
                  rw [hyj, mul_one, hc_eq r, Matrix.mulVec, dotProduct]
                  have hsplit : (∑ x : Fin δ, M_bar w r x * c x) +
                      (∑ x ∈ ({j} : Finset (Fin δ))ᶜ, M_bar u₂_vec r x * y x) =
                      ∑ x : Fin δ, (M_bar w r x * c x +
                        if x = j then 0 else M_bar u₂_vec r x * y x) := by
                    rw [Finset.sum_add_distrib]
                    congr 1
                    rw [Fintype.sum_eq_add_sum_compl j]
                    simp only [↓reduceIte, zero_add]
                    refine Finset.sum_congr rfl fun x hx => ?_
                    rw [Finset.mem_compl, Finset.mem_singleton] at hx
                    simp [hx]
                  rw [hsplit]
                  refine Finset.sum_eq_zero fun s _ => ?_
                  by_cases hsj : s = j
                  · subst hsj; simp [hcj]
                  · by_cases hsD : s ∈ D_set w
                    · have hcs : c s = 0 := hAll s hsD
                      simp [y, hsj, hsD, hcs]
                    · have hws : w s = u₂_vec s := by
                        simp only [D_set, Finset.mem_filter, Finset.mem_univ, true_and,
                          not_not] at hsD
                        exact hsD
                      have hMs : M_bar w r s = M_bar u₂_vec r s := by
