      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      rcases U_op with ⟨U⟩
      apply AddCommGrpCat.ext
      intro (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
      apply Subtype.ext
      apply LocallyConstant.ext
      intro (x : ↥U.left)
      have hnat := congrArg
        (fun φ : L_V.obj.obj (Opposite.op U) ⟶ L0_sh.obj.obj (Opposite.op (W_g U g x)) =>
          φ.hom (θ_fun U g))
        (Θ_hom.hom.naturality (j_g U g x).op)
      have hev : (((Θ_hom.hom.app (Opposite.op (W_g U g x))).hom
          ((L_V.obj.map (j_g U g x).op).hom (θ_fun U g))) :
            ↥(weilAltZeroBdrySubgroup C''.left V' m (W_g U g x))).1 ⟨x, hOg_mem U g x⟩ =
        (((Θ_hom.hom.app (Opposite.op U)).hom (θ_fun U g)) :
          ↥(weilAltZeroBdrySubgroup C''.left V' m U)).1 x :=
        congrArg (fun k : ↥(weilAltZeroBdrySubgroup C''.left V' m (W_g U g x)) =>
