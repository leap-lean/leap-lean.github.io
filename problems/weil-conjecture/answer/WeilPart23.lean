          (fun x : ↑(P_W.presheaf.obj (Opposite.op (V₁ ⊔ V₂))) =>
            ((P_W.presheaf.map (CategoryTheory.homOfLE (le_sup_left : V₁ ≤ V₁ ⊔ V₂)).op).hom x,
             (P_W.presheaf.map (CategoryTheory.homOfLE (le_sup_right : V₂ ≤ V₁ ⊔ V₂)).op).hom x)) := by
      intro V₁ V₂ hbot
      let hLim := TopCat.Sheaf.isProductOfDisjoint P_W.sheaf V₁ V₂ hbot
      let X₁ := P_W.presheaf.obj (Opposite.op V₁)
      let X₂ := P_W.presheaf.obj (Opposite.op V₂)
      let Z₁₂ := P_W.presheaf.obj (Opposite.op (V₁ ⊔ V₂))
      let p₁ : Z₁₂ ⟶ X₁ := P_W.presheaf.map (CategoryTheory.homOfLE le_sup_left).op
      let p₂ : Z₁₂ ⟶ X₂ := P_W.presheaf.map (CategoryTheory.homOfLE le_sup_right).op
      let P_XY := CommRingCat.of (↑X₁ × ↑X₂)
      let fst_XY : P_XY ⟶ X₁ := CommRingCat.ofHom (RingHom.fst ↑X₁ ↑X₂)
      let snd_XY : P_XY ⟶ X₂ := CommRingCat.ofHom (RingHom.snd ↑X₁ ↑X₂)
      let φ : Z₁₂ ⟶ P_XY := CommRingCat.ofHom (RingHom.prod p₁.hom p₂.hom)
      let ψ : P_XY ⟶ Z₁₂ := CategoryTheory.Limits.BinaryFan.IsLimit.lift hLim fst_XY snd_XY
      have hψ₁ : ψ ≫ p₁ = fst_XY := hLim.fac _ ⟨CategoryTheory.Limits.WalkingPair.left⟩
      have hψ₂ : ψ ≫ p₂ = snd_XY := hLim.fac _ ⟨CategoryTheory.Limits.WalkingPair.right⟩
      have hφψ : φ ≫ ψ = 𝟙 Z₁₂ := by
        apply CategoryTheory.Limits.BinaryFan.IsLimit.hom_ext hLim
        · change (φ ≫ ψ) ≫ p₁ = 𝟙 Z₁₂ ≫ p₁
          rw [CategoryTheory.Category.assoc, hψ₁, CategoryTheory.Category.id_comp]
          rfl
        · change (φ ≫ ψ) ≫ p₂ = 𝟙 Z₁₂ ≫ p₂
          rw [CategoryTheory.Category.assoc, hψ₂, CategoryTheory.Category.id_comp]
          rfl
      have hψφ : ψ.hom ∘ φ.hom = id := by
        funext x
        exact congrArg (fun f : Z₁₂ ⟶ Z₁₂ => f.hom x) hφψ
      have hφψ_pt : ∀ pair : ↑X₁ × ↑X₂, φ.hom (ψ.hom pair) = pair := by
        intro pair
        apply Prod.ext
        · exact congrArg (fun f : P_XY ⟶ X₁ => f.hom pair) hψ₁
        · exact congrArg (fun f : P_XY ⟶ X₂ => f.hom pair) hψ₂
      exact Function.bijective_iff_has_inverse.mpr ⟨ψ.hom, congrFun hψφ, hφψ_pt⟩

    let V_part : ℕ → P_W.Opens := fun k => ⨆ (j : Fin d) (_ : j.1 < k), U_sh j
    have hLe_part : ∀ (k : ℕ) (j : Fin d), j.1 < k → U_sh j ≤ V_part k := by
      intro k j hj
      exact le_iSup₂ (f := fun (j : Fin d) (_ : j.1 < k) => U_sh j) j hj

    have hInd : ∀ (k : ℕ), k ≤ d →
        Function.Bijective
          (fun x : ↑(P_W.presheaf.obj (Opposite.op (V_part k))) =>
            fun j : { j : Fin d // j.1 < k } =>
              (P_W.presheaf.map (CategoryTheory.homOfLE (hLe_part k j.1 j.2)).op).hom x) := by
      intro k
      induction k with
      | zero =>
        intro _
        have hV0 : V_part 0 = ⊥ :=
          eq_bot_iff.mpr (iSup₂_le fun j hj => (Nat.not_lt_zero j.1 hj).elim)
        have hSubDom : Subsingleton ↑(P_W.presheaf.obj (Opposite.op (V_part 0))) := by
          rw [hV0]
          exact hSubBot
        have hSubCod : Subsingleton
            (∀ j : { j : Fin d // j.1 < 0 }, ↑(P_W.presheaf.obj (Opposite.op (U_sh j.1)))) :=
          ⟨fun f₁ f₂ => funext fun j => (Nat.not_lt_zero j.1.1 j.2).elim⟩
        refine ⟨fun x₁ x₂ _ => hSubDom.elim x₁ x₂, fun f => ⟨0, hSubCod.elim _ f⟩⟩
      | succ k ih =>
        intro hk
        let jk : Fin d := ⟨k, hk⟩
        have hjk_val : jk.1 = k := rfl
        have hVk_eq : V_part (k + 1) = V_part k ⊔ U_sh jk := by
          apply le_antisymm
          · refine iSup₂_le fun j hj => ?_
            rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hlt | heq
            · exact le_sup_of_le_left (hLe_part k j hlt)
            · have hjeq : j = jk := Fin.ext (heq.trans hjk_val.symm)
              rw [hjeq]
              exact le_sup_right
          · exact sup_le
              (iSup₂_le fun j hj => hLe_part (k + 1) j (Nat.lt_succ_of_lt hj))
              (hLe_part (k + 1) jk (by rw [hjk_val]; exact Nat.lt_succ_self k))
        have hVk_disj : V_part k ⊓ U_sh jk = ⊥ := by
          rw [eq_bot_iff]
          intro z hz
          obtain ⟨hz₁, hz₂⟩ := hz
          change z ∈ ((V_part k : P_W.Opens) : Set ↥P_W) at hz₁
          dsimp only [V_part] at hz₁
          rw [TopologicalSpace.Opens.coe_iSup] at hz₁
          obtain ⟨j, hj₁⟩ := Set.mem_iUnion.mp hz₁
          rw [TopologicalSpace.Opens.coe_iSup] at hj₁
          obtain ⟨hj, hzj⟩ := Set.mem_iUnion.mp hj₁
          have hj_ne : j ≠ jk := fun heq =>
            Nat.ne_of_lt hj ((congrArg Fin.val heq).trans hjk_val)
          exact Set.disjoint_left.mp (hDisj hj_ne) hzj hz₂
        have hSplitBij := hBinProdBij (V_part k) (U_sh jk) hVk_disj
        have ih_k := ih (Nat.le_of_succ_le hk)
        let R_k1 := P_W.presheaf.obj (Opposite.op (V_part (k + 1)))
        let R_sup := P_W.presheaf.obj (Opposite.op (V_part k ⊔ U_sh jk))
        let e_dom : ↑R_k1 ≃ ↑R_sup :=
          { toFun := (P_W.presheaf.map (CategoryTheory.eqToHom (by rw [hVk_eq])).op).hom
            invFun := (P_W.presheaf.map (CategoryTheory.eqToHom (by rw [hVk_eq])).op).hom
            left_inv := fun x =>
              congrArg (fun f : R_k1 ⟶ R_k1 => CommRingCat.Hom.hom f x)
                ((P_W.presheaf.map_comp _ _).symm.trans
                  ((congrArg P_W.presheaf.map (Subsingleton.elim _ _)).trans
                    (P_W.presheaf.map_id _)))
            right_inv := fun x =>
              congrArg (fun f : R_sup ⟶ R_sup => CommRingCat.Hom.hom f x)
                ((P_W.presheaf.map_comp _ _).symm.trans
                  ((congrArg P_W.presheaf.map (Subsingleton.elim _ _)).trans
                    (P_W.presheaf.map_id _))) }
        let e_pair : ↑R_sup ≃
            ↑(P_W.presheaf.obj (Opposite.op (V_part k))) ×
              ↑(P_W.presheaf.obj (Opposite.op (U_sh jk))) :=
          Equiv.ofBijective _ hSplitBij
        let e_left : ↑(P_W.presheaf.obj (Opposite.op (V_part k))) ≃
            (∀ j : { j : Fin d // j.1 < k }, ↑(P_W.presheaf.obj (Opposite.op (U_sh j.1)))) :=
          Equiv.ofBijective _ ih_k
        let e_pi :
            ((∀ j : { j : Fin d // j.1 < k }, ↑(P_W.presheaf.obj (Opposite.op (U_sh j.1)))) ×
              ↑(P_W.presheaf.obj (Opposite.op (U_sh jk)))) ≃
            (∀ j : { j : Fin d // j.1 < k + 1 }, ↑(P_W.presheaf.obj (Opposite.op (U_sh j.1)))) :=
          { toFun := fun pair j =>
              if hlt : j.1.1 < k then pair.1 ⟨j.1, hlt⟩
              else
                have hj_lt : j.1.1 < k + 1 := j.2
                have heq : j.1 = jk := Fin.ext (by rw [hjk_val]; omega)
                (P_W.presheaf.map (CategoryTheory.eqToHom (by rw [heq])).op).hom pair.2
            invFun := fun f =>
              (fun j => f ⟨j.1, Nat.lt_succ_of_lt j.2⟩,
               f ⟨jk, by rw [hjk_val]; exact Nat.lt_succ_self k⟩)
            left_inv := fun ⟨f_l, f_r⟩ => by
              apply Prod.ext
              · funext ⟨j, hj⟩
                dsimp only
                split_ifs
                rfl
              · dsimp only
                have hnot : ¬ jk.1 < k := by rw [hjk_val]; exact Nat.lt_irrefl k
                split_ifs
                let R_jk := P_W.presheaf.obj (Opposite.op (U_sh jk))
                exact congrArg (fun g : R_jk ⟶ R_jk => CommRingCat.Hom.hom g f_r)
                  (P_W.presheaf.map_id _)
            right_inv := fun f => by
              funext ⟨j, hj⟩
              dsimp only
              split_ifs with hlt
              · rfl
              · have heq : j = jk := Fin.ext (by rw [hjk_val]; omega)
                subst heq
                let R_jk := P_W.presheaf.obj (Opposite.op (U_sh jk))
                exact congrArg (fun g : R_jk ⟶ R_jk => CommRingCat.Hom.hom g (f ⟨jk, hj⟩))
                  (P_W.presheaf.map_id _) }
        let E_tot := ((e_dom.trans e_pair).trans (e_left.prodCongr (Equiv.refl _))).trans e_pi
        have hFunEq :
            (fun x : ↑R_k1 =>
              fun j : { j : Fin d // j.1 < k + 1 } =>
                (P_W.presheaf.map (CategoryTheory.homOfLE (hLe_part (k + 1) j.1 j.2)).op).hom x) =
            E_tot := by
          funext x ⟨j, hj⟩
          dsimp only [E_tot, Equiv.trans_apply, Equiv.prodCongr_apply, Equiv.refl_apply,
            e_pi, e_left, e_pair, e_dom, Equiv.ofBijective_apply, Equiv.coe_fn_mk]
          let R_j := P_W.presheaf.obj (Opposite.op (U_sh j))
          split_ifs with hlt
          · let m₁ := (CategoryTheory.eqToHom (by rw [hVk_eq]) : V_part k ⊔ U_sh jk ⟶ V_part (k + 1)).op
            let m₂ := (CategoryTheory.homOfLE (le_sup_left : V_part k ≤ V_part k ⊔ U_sh jk)).op
            let m₃ := (CategoryTheory.homOfLE (hLe_part k j hlt)).op
            let m_tot := (CategoryTheory.homOfLE (hLe_part (k + 1) j hj)).op
            have hcomp : m_tot = m₁ ≫ m₂ ≫ m₃ := Subsingleton.elim _ _
            have hmap : P_W.presheaf.map m_tot =
                P_W.presheaf.map m₁ ≫ P_W.presheaf.map m₂ ≫ P_W.presheaf.map m₃ :=
              (congrArg P_W.presheaf.map hcomp).trans
                ((P_W.presheaf.map_comp m₁ (m₂ ≫ m₃)).trans
                  (congrArg (P_W.presheaf.map m₁ ≫ ·) (P_W.presheaf.map_comp m₂ m₃)))
            exact congrArg (fun g : R_k1 ⟶ R_j => CommRingCat.Hom.hom g x) hmap
          · have heq : j = jk := Fin.ext (by rw [hjk_val]; omega)
            let m₁ := (CategoryTheory.eqToHom (by rw [hVk_eq]) : V_part k ⊔ U_sh jk ⟶ V_part (k + 1)).op
            let m₂ := (CategoryTheory.homOfLE (le_sup_right : U_sh jk ≤ V_part k ⊔ U_sh jk)).op
            let m₃ := (CategoryTheory.eqToHom (by rw [heq]) : U_sh j ⟶ U_sh jk).op
            let m_tot := (CategoryTheory.homOfLE (hLe_part (k + 1) j hj)).op
            have hcomp : m_tot = m₁ ≫ m₂ ≫ m₃ := Subsingleton.elim _ _
            have hmap : P_W.presheaf.map m_tot =
                P_W.presheaf.map m₁ ≫ P_W.presheaf.map m₂ ≫ P_W.presheaf.map m₃ :=
              (congrArg P_W.presheaf.map hcomp).trans
                ((P_W.presheaf.map_comp m₁ (m₂ ≫ m₃)).trans
                  (congrArg (P_W.presheaf.map m₁ ≫ ·) (P_W.presheaf.map_comp m₂ m₃)))
            exact congrArg (fun g : R_k1 ⟶ R_j => CommRingCat.Hom.hom g x) hmap
        rw [hFunEq]
        exact E_tot.bijective

    have hVd_top : V_part d = ⊤ := by
      refine top_unique fun z _ => ?_
      have hz : z ∈ (⋃ j : Fin d, Set.range (s' j).base) := by
        rw [hUniv]
        trivial
      obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hz
      exact hLe_part d j j.2 hj

    have hChartIso : ∀ j : Fin d,
        ∃ ρ_j : P_W.presheaf.obj (Opposite.op (U_sh j)) ≅ W.presheaf.obj (Opposite.op ⊤),
          P_W.presheaf.map (CategoryTheory.homOfLE (le_top : U_sh j ≤ ⊤)).op ≫ ρ_j.hom =
            (s' j).appTop := by
      intro j
      let e_or : W ≅ (U_sh j).toScheme := (s' j).isoOpensRange
      let iso_app : (U_sh j).toScheme.presheaf.obj (Opposite.op ⊤) ≅ W.presheaf.obj (Opposite.op ⊤) :=
        { hom := e_or.hom.appTop
          inv := e_or.inv.appTop
          hom_inv_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_or.inv_hom_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop]
          inv_hom_id := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_or.hom_inv_id,
              AlgebraicGeometry.Scheme.Hom.id_appTop] }
      refine ⟨(U_sh j).topIso.symm.trans iso_app, ?_⟩
      have hfac : (s' j).appTop = (U_sh j).ι.appTop ≫ e_or.hom.appTop := by
        conv_lhs => rw [← (s' j).isoOpensRange_hom_ι]
        exact AlgebraicGeometry.Scheme.Hom.comp_appTop e_or.hom (U_sh j).ι
      have htop : P_W.presheaf.map (CategoryTheory.homOfLE (le_top : U_sh j ≤ ⊤)).op ≫
          (U_sh j).topIso.inv = (U_sh j).ι.appTop :=
        (P_W.presheaf.map_comp _ _).symm.trans
          ((congrArg P_W.presheaf.map (Subsingleton.elim _ _)).trans
            (AlgebraicGeometry.Scheme.Opens.ι_appTop (U_sh j)).symm)
      change P_W.presheaf.map (CategoryTheory.homOfLE (le_top : U_sh j ≤ ⊤)).op ≫
          ((U_sh j).topIso.inv ≫ e_or.hom.appTop) = (s' j).appTop
      rw [← CategoryTheory.Category.assoc, htop, hfac]

    let ρ : ∀ j : Fin d, P_W.presheaf.obj (Opposite.op (U_sh j)) ≅ W.presheaf.obj (Opposite.op ⊤) :=
      fun j => Classical.choose (hChartIso j)
    have hρ : ∀ j : Fin d,
        P_W.presheaf.map (CategoryTheory.homOfLE (le_top : U_sh j ≤ ⊤)).op ≫ (ρ j).hom =
          (s' j).appTop :=
      fun j => Classical.choose_spec (hChartIso j)

    let Ξ_hom : B_W →+* (Fin d → R_W) :=
      RingHom.pi fun j : Fin d => ((s' j).appTop).hom
    have hΞ_bij : Function.Bijective Ξ_hom := by
      let R_vd := P_W.presheaf.obj (Opposite.op (V_part d))
      let R_top := P_W.presheaf.obj (Opposite.op (⊤ : P_W.Opens))
      let e_top : B_W ≃ ↑R_vd :=
        { toFun := (P_W.presheaf.map (CategoryTheory.eqToHom (by rw [hVd_top])).op).hom
          invFun := (P_W.presheaf.map (CategoryTheory.eqToHom (by rw [hVd_top])).op).hom
          left_inv := fun x =>
            congrArg (fun f : R_top ⟶ R_top => CommRingCat.Hom.hom f x)
              ((P_W.presheaf.map_comp _ _).symm.trans
                ((congrArg P_W.presheaf.map (Subsingleton.elim _ _)).trans
                  (P_W.presheaf.map_id _)))
          right_inv := fun x =>
            congrArg (fun f : R_vd ⟶ R_vd => CommRingCat.Hom.hom f x)
              ((P_W.presheaf.map_comp _ _).symm.trans
                ((congrArg P_W.presheaf.map (Subsingleton.elim _ _)).trans
                  (P_W.presheaf.map_id _))) }
      let e_ind : ↑R_vd ≃ (∀ j : { j : Fin d // j.1 < d }, ↑(P_W.presheaf.obj (Opposite.op (U_sh j.1)))) :=
        Equiv.ofBijective _ (hInd d (le_refl d))
      let e_coord : (∀ j : { j : Fin d // j.1 < d }, ↑(P_W.presheaf.obj (Opposite.op (U_sh j.1)))) ≃
          (Fin d → R_W) :=
        { toFun := fun f j => (ρ j).hom.hom (f ⟨j, j.2⟩)
          invFun := fun g j => (ρ j.1).inv.hom (g j.1)
          left_inv := fun f => by
            funext ⟨j, hj⟩
            let R_j := P_W.presheaf.obj (Opposite.op (U_sh j))
            exact congrArg (fun h : R_j ⟶ R_j => CommRingCat.Hom.hom h (f ⟨j, hj⟩)) (ρ j).hom_inv_id
          right_inv := fun g => by
            funext j
            let R_topW := W.presheaf.obj (Opposite.op (⊤ : W.Opens))
            exact congrArg (fun h : R_topW ⟶ R_topW => CommRingCat.Hom.hom h (g j)) (ρ j).inv_hom_id }
      let E_Ξ := (e_top.trans e_ind).trans e_coord
      have hEq_Ξ : (Ξ_hom : B_W → (Fin d → R_W)) = E_Ξ := by
        funext x j
        dsimp only [Ξ_hom, RingHom.pi_apply, E_Ξ, Equiv.trans_apply, e_coord, e_ind, e_top,
          Equiv.ofBijective_apply]
        let R_j := P_W.presheaf.obj (Opposite.op (U_sh j))
        have hmap : P_W.presheaf.map (CategoryTheory.eqToHom (by rw [hVd_top])).op ≫
            P_W.presheaf.map (CategoryTheory.homOfLE (hLe_part d j j.2)).op =
            P_W.presheaf.map (CategoryTheory.homOfLE (le_top : U_sh j ≤ ⊤)).op :=
          (P_W.presheaf.map_comp _ _).symm.trans
            (congrArg P_W.presheaf.map (Subsingleton.elim _ _))
        have h1 : (ρ j).hom.hom
            ((P_W.presheaf.map (CategoryTheory.homOfLE (hLe_part d j j.2)).op).hom
              ((P_W.presheaf.map (CategoryTheory.eqToHom (by rw [hVd_top])).op).hom x)) =
            (ρ j).hom.hom
              ((P_W.presheaf.map (CategoryTheory.homOfLE (le_top : U_sh j ≤ ⊤)).op).hom x) :=
          congrArg (fun h : R_top ⟶ R_j => (ρ j).hom.hom (CommRingCat.Hom.hom h x)) hmap
        exact (congrArg (fun h : R_top ⟶ W.presheaf.obj (Opposite.op ⊤) =>
          CommRingCat.Hom.hom h x) (hρ j)).symm.trans h1.symm
      rw [hEq_Ξ]
      exact E_Ξ.bijective

    let Ξ_W : B_W ≃+* (Fin d → R_W) := RingEquiv.ofBijective Ξ_hom hΞ_bij
    let M : Type u := Fin d → R_W
    let bM : Module.Basis (Fin d) R_W M := Pi.basisFun R_W (Fin d)
    let eM : M ≃+ B_W := Ξ_W.symm.toAddEquiv
    let diag_fn : Fin d → R_W := fun j => if j = j₀ then r₀ else 1
    let L : M →ₗ[R_W] M :=
      { toFun := fun m j => diag_fn j * m j
        map_add' := fun m₁ m₂ => funext fun j => mul_add (diag_fn j) (m₁ j) (m₂ j)
        map_smul' := fun c m => funext fun j => by
          change diag_fn j * (c * m j) = c * (diag_fn j * m j)
          exact mul_left_comm (diag_fn j) c (m j) }

    refine ⟨M, inferInstance, inferInstance, bM, eM, L, ?_, ?_, ?_⟩
    · intro c m
      apply Ξ_W.injective
      have hL : Ξ_W (eM (c • m)) = c • m := Ξ_W.apply_symm_apply (c • m)
      have hR : Ξ_W (eM m) = m := Ξ_W.apply_symm_apply m
      rw [hL, map_mul, hR]
      funext j
      dsimp only [Pi.smul_apply, smul_eq_mul, Pi.mul_apply]
      have hsec_j : ((s' j).appTop).hom ((p_W.appTop).hom c) = c :=
        congrArg (fun h : W.presheaf.obj (Opposite.op ⊤) ⟶ W.presheaf.obj (Opposite.op ⊤) =>
          CommRingCat.Hom.hom h c)
          ((AlgebraicGeometry.Scheme.Hom.comp_appTop (s' j) p_W).symm.trans
            ((congrArg AlgebraicGeometry.Scheme.Hom.appTop (hSec j)).trans
              AlgebraicGeometry.Scheme.Hom.id_appTop))
      change c * m j = ((s' j).appTop).hom ((p_W.appTop).hom c) * m j
      rw [hsec_j]
    · intro m
      apply Ξ_W.injective
      have hL : Ξ_W (eM (L m)) = L m := Ξ_W.apply_symm_apply (L m)
      have hR : Ξ_W (eM m) = m := Ξ_W.apply_symm_apply m
      rw [hL, map_mul, hR]
      funext j
      dsimp only [L, LinearMap.coe_mk, AddHom.coe_mk, Pi.mul_apply, diag_fn]
      change (if j = j₀ then r₀ else 1) * m j = ((s' j).appTop).hom u_B * m j
      split_ifs with hj
      · subst hj
        rw [hu_j₀]
      · rw [hu_ne j hj]
    · have hMat : (LinearMap.toMatrix bM bM) L = Matrix.diagonal diag_fn := by
        ext i j
        rw [LinearMap.toMatrix_apply, Pi.basisFun_repr, Pi.basisFun_apply]
        dsimp only [L, LinearMap.coe_mk, AddHom.coe_mk, Matrix.diagonal_apply]
        split_ifs with hij
        · subst hij
          simp
        · rw [Pi.single_eq_of_ne hij, mul_zero]
      rw [hMat, Matrix.det_diagonal]
      dsimp only [diag_fn]
      simp [Finset.prod_ite_eq', Finset.mem_univ]
  have hPart2 :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (U_open : S.Opens) (n : ℕ)
        (T_S : S.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S),
        let U_et : S.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ U_open.ι
            (inferInstance : AlgebraicGeometry.Etale U_open.ι)
        let AM : AddCommGrpCat.{u} :=
          AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
        ∃ (hShL : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltLocConstPresheaf S n))
