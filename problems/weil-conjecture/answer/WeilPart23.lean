      obtain ⟨w, _, huniq₁₂⟩ := hC_glue U R₁₂ hR₁₂
        (fun _ f _ => ((C.obj AM).obj.map f.op).hom (Ψ_fun U (g₁ + g₂)))
        (fun _ _ _ u₁ u₂ f₁ f₂ _ _ hcomm => by
          change ((C.obj AM).obj.map f₁.op ≫ (C.obj AM).obj.map u₁.op).hom _ =
