    exact hL0.trans (hLHS.trans (hRHS_chain.symm.trans hR0.symm))

  let Z_obj := U_std₂.obj one₂
  have hEq_L : (ιℤ_pull ≫ P_pull.map ηℤ₂) ≫ η_pull.hom.app Z_obj =
      (ηℤ₁ ≫ U_std₁.map α_h) ≫ e_one₂.hom := by
    have hα_Aℤ : α_ab Aℤ = ιℤ_pull ≫ η_pull.hom.app Fℤ₂ := by
      calc
        α_ab Aℤ
          = α_ab Aℤ ≫ 𝟙 (R_h_ab.obj Fℤ₂) := (Category.comp_id _).symm
        _ = α_ab Aℤ ≫ (η_pull.inv.app Fℤ₂ ≫ η_pull.hom.app Fℤ₂) := by
            rw [η_pull.inv_hom_id_app]
        _ = α_ab Aℤ ≫ (η_pull.inv.app Fℤ₂ ≫ 𝟙 (P_pull.obj Fℤ₂) ≫ η_pull.hom.app Fℤ₂) := by
            rw [Category.id_comp]
        _ = α_ab Aℤ ≫ (η_pull.inv.app Fℤ₂ ≫ (π'_of Aℤ ≫ ιℤ_pull) ≫ η_pull.hom.app Fℤ₂) := by
            rw [hπι_pull]
        _ = (α_ab Aℤ ≫ η_pull.inv.app Fℤ₂ ≫ π'_of Aℤ) ≫ (ιℤ_pull ≫ η_pull.hom.app Fℤ₂) := by
            simp only [Category.assoc]
        _ = ιℤ_pull ≫ η_pull.hom.app Fℤ₂ := by
            rw [hα_π'_id Aℤ, Category.id_comp]
    calc
      (ιℤ_pull ≫ P_pull.map ηℤ₂) ≫ η_pull.hom.app Z_obj
        = ιℤ_pull ≫ (P_pull.map ηℤ₂ ≫ η_pull.hom.app Z_obj) := Category.assoc _ _ _
      _ = ιℤ_pull ≫ (η_pull.hom.app Fℤ₂ ≫ R_h_ab.map ηℤ₂) := by rw [η_pull.hom.naturality ηℤ₂]
      _ = (ιℤ_pull ≫ η_pull.hom.app Fℤ₂) ≫ R_h_ab.map ηℤ₂ := (Category.assoc _ _ _).symm
      _ = α_ab Aℤ ≫ R_h_ab.map ηℤ₂ := by rw [← hα_Aℤ]
      _ = (ηℤ₁ ≫ U_std₁.map α_h) ≫ e_one₂.hom := (hγ_intertwine ιℤ_mod).symm

  have hEq_R : η_pull.inv.app Z_obj ≫ P_pull.map βM₂ ≫ π'_of AM =
      e_one₂.inv ≫ (U_std₁.map β_h ≫ βM₁) := by
    have hnat : η_pull.inv.app Z_obj ≫ P_pull.map βM₂ =
        R_h_ab.map βM₂ ≫ η_pull.inv.app FM₂ := (η_pull.inv.naturality βM₂).symm
    rw [← Category.assoc, hnat, Category.assoc]
    have hαM_int : (αM₁ ≫ U_std₁.map α_h) ≫ e_one₂.hom = α_ab AM ≫ R_h_ab.map αM₂ :=
      hγ_intertwine ιM_mod
    have hU_βα : U_std₁.map β_h ≫ U_std₁.map α_h = 𝟙 (U_std₁.obj (R_sh.obj one₂)) := by
      rw [← U_std₁.map_comp, hβα_h, U_std₁.map_id]
    have hR_αβ : R_h_ab.map αM₂ ≫ R_h_ab.map βM₂ = 𝟙 (R_h_ab.obj FM₂) := by
      rw [← R_h_ab.map_comp, hαβ_M₂, R_h_ab.map_id]
    symm
    calc
      e_one₂.inv ≫ (U_std₁.map β_h ≫ βM₁)
        = (e_one₂.inv ≫ (U_std₁.map β_h ≫ βM₁)) ≫ 𝟙 FM₁ :=
            (Category.comp_id _).symm
      _ = (e_one₂.inv ≫ (U_std₁.map β_h ≫ βM₁)) ≫
            (α_ab AM ≫ η_pull.inv.app FM₂ ≫ π'_of AM) := by
            rw [hα_π'_id AM]
      _ = e_one₂.inv ≫ U_std₁.map β_h ≫ βM₁ ≫ α_ab AM ≫ 𝟙 (R_h_ab.obj FM₂) ≫
            (η_pull.inv.app FM₂ ≫ π'_of AM) := by
            rw [Category.id_comp]; simp only [Category.assoc]
      _ = e_one₂.inv ≫ U_std₁.map β_h ≫ βM₁ ≫ (α_ab AM ≫ R_h_ab.map αM₂) ≫
            R_h_ab.map βM₂ ≫ (η_pull.inv.app FM₂ ≫ π'_of AM) := by
            rw [← hR_αβ]; simp only [Category.assoc]
