        (((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (Nat.add_zero i))
          (Nat.zero_add i))) (Nat.zero_add i)).comp
        (Abelian.Ext.mk₀ b) (Nat.add_zero i) =
      (Abelian.Ext.mk₀ (a ≫ a')).comp (y.comp (Abelian.Ext.mk₀ (b' ≫ b)) (Nat.add_zero i))
