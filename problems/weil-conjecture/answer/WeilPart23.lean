  letI : Limits.PreservesFiniteColimits P_pull := hColim_P

  obtain ⟨adj_SB⟩ := step4a_adjSB
  obtain ⟨η_pull, hα_π'_id⟩ := step4b_mateIso J₁ J₂ Sigma_h B_h adj_SB hT₁ hT₂ hT'₁ hT'₂
  letI : R_h_ab.Additive := Functor.additive_of_iso η_pull
