      have hg_comm : g_tilde₁ ≫ u_lift u₁ = g_tilde₂ ≫ u_lift u₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hhcomm_left
      have hx_eq := hx_compat g_tilde₁ g_tilde₂
        (hu_lift_mem u₁ hu₁) (hu_lift_mem u₂ hu₂) hg_comm
      have he₁ : g₁ ≫ (e_lift u₁).inv = (e_lift u₀).inv ≫ M_p.map g_tilde₁ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (CategoryTheory.Category.comp_id (g₁.left : Z₀.left ⟶ Y₁.left)).trans
          (CategoryTheory.Category.id_comp (g₁.left : Z₀.left ⟶ Y₁.left)).symm
      have he₂ : g₂ ≫ (e_lift u₂).inv = (e_lift u₀).inv ≫ M_p.map g_tilde₂ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (CategoryTheory.Category.comp_id (g₂.left : Z₀.left ⟶ Y₂.left)).trans
          (CategoryTheory.Category.id_comp (g₂.left : Z₀.left ⟶ Y₂.left)).symm
      change G.obj.map g₁.op (G.obj.map (e_lift u₁).inv.op (x_fam (u_lift u₁) (hu_lift_mem u₁ hu₁))) =
        G.obj.map g₂.op (G.obj.map (e_lift u₂).inv.op (x_fam (u_lift u₂) (hu_lift_mem u₂ hu₂)))
      calc
        G.obj.map g₁.op (G.obj.map (e_lift u₁).inv.op (x_fam (u_lift u₁) (hu_lift_mem u₁ hu₁)))
          = (G.obj.map (e_lift u₁).inv.op ≫ G.obj.map g₁.op)
              (x_fam (u_lift u₁) (hu_lift_mem u₁ hu₁)) := rfl
        _ = G.obj.map (g₁ ≫ (e_lift u₁).inv).op
              (x_fam (u_lift u₁) (hu_lift_mem u₁ hu₁)) := by
              rw [op_comp, CategoryTheory.Functor.map_comp]
        _ = G.obj.map ((e_lift u₀).inv ≫ M_p.map g_tilde₁).op
              (x_fam (u_lift u₁) (hu_lift_mem u₁ hu₁)) := by rw [he₁]
        _ = G.obj.map (e_lift u₀).inv.op
              (G.obj.map (M_p.map g_tilde₁).op
                (x_fam (u_lift u₁) (hu_lift_mem u₁ hu₁))) := by
              rw [op_comp, CategoryTheory.Functor.map_comp]; rfl
        _ = G.obj.map (e_lift u₀).inv.op
              (G.obj.map (M_p.map g_tilde₂).op
                (x_fam (u_lift u₂) (hu_lift_mem u₂ hu₂))) := by
              exact congrArg (G.obj.map (e_lift u₀).inv.op) hx_eq
        _ = G.obj.map ((e_lift u₀).inv ≫ M_p.map g_tilde₂).op
              (x_fam (u_lift u₂) (hu_lift_mem u₂ hu₂)) := by
              rw [op_comp, CategoryTheory.Functor.map_comp]; rfl
        _ = G.obj.map (g₂ ≫ (e_lift u₂).inv).op
              (x_fam (u_lift u₂) (hu_lift_mem u₂ hu₂)) := by rw [← he₂]
        _ = G.obj.map g₂.op (G.obj.map (e_lift u₂).inv.op
              (x_fam (u_lift u₂) (hu_lift_mem u₂ hu₂))) := by
              rw [op_comp, CategoryTheory.Functor.map_comp]; rfl
    have hG_for := hG_sheaf S_R hSR
    let t : G.obj.obj (Opposite.op (M_p.obj W)) := hG_for.amalgamate y_fam hy_compat
    refine ⟨t, ?_, ?_⟩
    · intro V f_V hf_V
      let u_f : M_p.obj V ⟶ M_p.obj W := M_p.map f_V
      have hu_f : S_R.arrows u_f :=
        CategoryTheory.Sieve.image_mem_functorPushforward M_p R hf_V
      have ht_glue : G.obj.map u_f.op t = y_fam u_f hu_f :=
        hG_for.valid_glue hy_compat u_f hu_f
      let i_V : V ⟶ Z_lift u_f :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 V.left)
          ((CategoryTheory.Category.id_comp ((f_V.left : V.left ⟶ W.left) ≫ W.hom)).trans
            (CategoryTheory.MorphismProperty.Over.w f_V))
          trivial
      have hi_fac : i_V ≫ u_lift u_f = 𝟙 V ≫ f_V :=
        CategoryTheory.MorphismProperty.Over.Hom.ext rfl
      have hx_i := hx_compat i_V (𝟙 V) (hu_lift_mem u_f hu_f) hf_V hi_fac
      have he_i : (e_lift u_f).inv = M_p.map i_V :=
        CategoryTheory.MorphismProperty.Over.Hom.ext rfl
      change G.obj.map u_f.op t = x_fam f_V hf_V
      rw [ht_glue]
      dsimp [y_fam]
      rw [he_i]
      change (M_p.op ⋙ G.obj).map i_V.op (x_fam (u_lift u_f) (hu_lift_mem u_f hu_f)) = x_fam f_V hf_V
      rw [hx_i, op_id, CategoryTheory.Functor.map_id]
      rfl
    · intro t' ht'
      refine hG_for.isSeparatedFor.ext fun Z u hu => ?_
      have hu_fac : (e_lift u).inv ≫ M_p.map (u_lift u) = u :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Category.id_comp (u.left : Z.left ⟶ W.left))
      change G.obj.map u.op t' = G.obj.map u.op t
      have ht_glue : G.obj.map u.op t = y_fam u hu :=
        hG_for.valid_glue hy_compat u hu
      rw [ht_glue]
      dsimp [y_fam]
      calc
        G.obj.map u.op t'
          = G.obj.map ((e_lift u).inv ≫ M_p.map (u_lift u)).op t' := by rw [hu_fac]
        _ = G.obj.map (e_lift u).inv.op (G.obj.map (M_p.map (u_lift u)).op t') := by
              rw [op_comp, CategoryTheory.Functor.map_comp]; rfl
        _ = G.obj.map (e_lift u).inv.op (x_fam (u_lift u) (hu_lift_mem u hu)) := by
              exact congrArg (G.obj.map (e_lift u).inv.op)
                (ht' (u_lift u) (hu_lift_mem u hu))

  have := hCont_M
  let R_p := M_p.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J

  let adj_Rp : R_p ⊣ P_push :=
    CategoryTheory.Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun ℱ =>
              { hom :=
                  { app := fun U_op => ℱ.obj.map (adj_site.counit.app U_op.unop).op
                    naturality := fun ⟨U₁⟩ ⟨U₂⟩ ⟨g⟩ => by
                      change ℱ.obj.map g.op ≫ ℱ.obj.map (adj_site.counit.app U₂).op =
                        ℱ.obj.map (adj_site.counit.app U₁).op ≫
                          ℱ.obj.map (M_p.map (B.map g)).op
