  letI : Limits.PreservesFiniteColimits R_h_ab := Limits.preservesFiniteColimits_of_natIso η_pull

  have hCommIso : ∃ e_comm : R_sh ⋙ U_std₁ ≅ U_std₂ ⋙ R_h_ab,
