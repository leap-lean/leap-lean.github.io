          _ = (D₀ b).ι ≫ B₀.hom ≫ p₀_pt := by rw [hp₀_eq]

    let eΨ := fun b => Classical.choose (hChartData b)
    let s_chart := fun b => Classical.choose (Classical.choose_spec (hChartData b))
    have heΨ_p₂ : ∀ b : Fin (m + 1),
