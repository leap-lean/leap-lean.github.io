            (Fgt.map (f_of pt)).left.base (y_of pt) = pt :=
        fun pt => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hSurj pt)))
      let val_fn : ↥(Fgt.obj W).left → ULift.{u} (ZMod n) :=
        fun pt => fn_of (f_of pt) (hf_of pt).1 (y_of pt)
      have hval_eq : ∀ {Z : S.Etale} (f : Z ⟶ W) (hf : R.arrows f) (y : ↥(Fgt.obj Z).left),
