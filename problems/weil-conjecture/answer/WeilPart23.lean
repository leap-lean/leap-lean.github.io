          rw [← map_pow, hclear i, hc0 i, map_zero]
        exact hu_g.mul_right_eq_zero.mp hmi0
      · intro z
        let b : B_W := (IsLocalization.Away.sec g' z).1
        let n : ℕ := (IsLocalization.Away.sec g' z).2
        have hsec_z : z * res_B (g' ^ n) = res_B b := IsLocalization.Away.sec_spec g' z
        obtain ⟨c, hc_span⟩ := hv_span b
        have hc_span' : g' * b = ∑ i : Fin ℓ, (bar_p.left.app W).hom (c i) * v i := hc_span
        let u_g : A_Uˣ := (IsLocalization.Away.algebraMap_isUnit g).unit
        have hug_val : (u_g : A_U) = res_A g := rfl
        let m : M_U := fun i => ((u_g ^ (n + 1))⁻¹ : A_Uˣ).val * res_A (c i)
        refine ⟨m, ?_⟩
        let u_BU : B_Uˣ := Units.map φ_U.toMonoidHom (u_g ^ (n + 1))
        have hu_BU_val : (u_BU : B_U) = res_B (g' ^ (n + 1)) := by
          change φ_U ((u_g : A_U) ^ (n + 1)) = res_B (g' ^ (n + 1))
          rw [hug_val, map_pow, hNat_AU, ← map_pow]
