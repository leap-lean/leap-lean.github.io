        _ = res_U a := by rw [bA.sum_repr]
        _ = a₁ * φ₁ (res_V (b₀ ^ k_exp)) := by
              dsimp only at hk_eq
              rw [halg_AA₁] at hk_eq
              rw [← hk_eq, map_pow, ← hcomm_res, ← map_pow, ← map_pow]
  let eF_lin : (Fin ℓ → B₁) ≃ₗ[B₁] A₁ := LinearEquiv.ofBijective F_bas hF_bij
  let bM₁ : Module.Basis (Fin ℓ) B₁ A₁ := (Pi.basisFun B₁ (Fin ℓ)).map eF_lin
  have hbM₁_apply : ∀ i : Fin ℓ, bM₁ i = res_U (bA i) := by
    intro i
