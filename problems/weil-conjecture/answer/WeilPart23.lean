        (CategoryTheory.forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
      have hShL_type := (CategoryTheory.isSheaf_iff_isSheaf_of_type J
        (weilAltLocConstPresheaf S n ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp
        (((CategoryTheory.sheafCompose J (CategoryTheory.forget AddCommGrpCat.{u})).obj
          ⟨weilAltLocConstPresheaf S n, hShL⟩).property)
      intro W R hR x_fam hCompat
      let xL : CategoryTheory.Presieve.FamilyOfElements
          (weilAltLocConstPresheaf S n ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R.arrows :=
        fun {_} f hf => (x_fam f hf : ↥(weilAltZeroBdrySubgroup S U_open n _)).1
      have hCompatL : xL.Compatible := by
        intro Z₁ Z₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hg
        exact congrArg Subtype.val (hCompat g₁ g₂ hf₁ hf₂ hg)
      obtain ⟨t₀, ht₀_res, ht₀_uniq⟩ := hShL_type R hR xL hCompatL
      let t₀_fn : LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n)) := t₀
      have ht₀_bdry : t₀_fn ∈ weilAltZeroBdrySubgroup S U_open n W := by
        intro x hx
        obtain ⟨Z, f, y, hf, _, rfl⟩ := (hMemJ_iff W R).mp hR x
        have hy_val : t₀_fn ((Fgt.map f).left.base y) =
            (x_fam f hf : ↥(weilAltZeroBdrySubgroup S U_open n Z)).1 y :=
          congrArg (fun fn : LocallyConstant _ _ => fn y) (ht₀_res f hf)
        rw [hy_val]
        apply (x_fam f hf : ↥(weilAltZeroBdrySubgroup S U_open n Z)).2 y
        intro hmem
        apply hx
        have hw_f : (Fgt.map f).left ≫ (Fgt.obj W).hom = (Fgt.obj Z).hom :=
          CategoryTheory.MorphismProperty.Over.w f
        have hpt : (Fgt.obj W).hom.base ((Fgt.map f).left.base y) =
            (Fgt.obj Z).hom.base y :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply (Fgt.map f).left
            (Fgt.obj W).hom y).symm.trans
            (congrArg (fun k : Quiver.Hom (Fgt.obj Z).left S => k.base y) hw_f)
        rwa [hpt]
      refine ⟨⟨t₀_fn, ht₀_bdry⟩, fun {_} f hf => Subtype.ext (ht₀_res f hf), ?_⟩
      intro t' ht'
      exact Subtype.ext (ht₀_uniq (t' : ↥(weilAltZeroBdrySubgroup S U_open n W)).1
        (fun {_} f hf => congrArg Subtype.val (ht' f hf)))

    have hSubOfEmpty : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale),
