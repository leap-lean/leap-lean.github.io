  let C_X := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let B : CategoryTheory.Functor V₀.Etale V'_sch.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ p
