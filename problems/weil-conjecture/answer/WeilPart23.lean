    refine ⟨hFinDim, hRank, hSep, hRoot_pow, σ_L, hσL_root, ?_⟩
    intro A _ _ _ _ _ _ ũ g hfg
    let Q_ũ : Polynomial A := (Polynomial.X : Polynomial A) ^ ℓ - Polynomial.C ũ.val
    let C_U : Type u := AdjoinRoot Q_ũ
    have hMonic_Q : Q_ũ.Monic := Polynomial.monic_X_pow_sub_C ũ.val hPrime.ne_zero
    let pb_A : PowerBasis A C_U := AdjoinRoot.powerBasis' hMonic_Q
    have hDim_A : pb_A.dim = ℓ := by
      dsimp [pb_A, Q_ũ]
      rw [AdjoinRoot.powerBasis'_dim, Polynomial.natDegree_X_pow_sub_C]
    let α_AL : A →+* L := (algebraMap F L).comp (algebraMap A F)
