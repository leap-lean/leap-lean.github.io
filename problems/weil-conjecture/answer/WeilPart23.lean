    have hc_B : B_g.IsContinuous X.smallEtaleTopology V'_sch.smallEtaleTopology := by
      refine CategoryTheory.Functor.isContinuous_of_coverPreserving ?_ ?_
      · refine ⟨fun ℱ {U T x} hx {U₁ U₂ W} f₁ f₂ {g₁ g₂} hg₁ hg₂ h => ?_⟩
        let fh₁ : Sigma_g.obj W ⟶ U₁ := (adj_SB.homEquiv W U₁).symm f₁
        let fh₂ : Sigma_g.obj W ⟶ U₂ := (adj_SB.homEquiv W U₂).symm f₂
        have hfh_comm : fh₁ ≫ g₁ = fh₂ ≫ g₂ := by
          apply (adj_SB.homEquiv W U).injective
          have hn₁ : (adj_SB.homEquiv W U) (fh₁ ≫ g₁) = f₁ ≫ B_g.map g₁ :=
            (adj_SB.homEquiv_naturality_right fh₁ g₁).trans
              (congrArg (· ≫ B_g.map g₁) (Equiv.apply_symm_apply _ f₁))
          have hn₂ : (adj_SB.homEquiv W U) (fh₂ ≫ g₂) = f₂ ≫ B_g.map g₂ :=
            (adj_SB.homEquiv_naturality_right fh₂ g₂).trans
              (congrArg (· ≫ B_g.map g₂) (Equiv.apply_symm_apply _ f₂))
          exact hn₁.trans (h.trans hn₂.symm)
        let fh₁_left : (FgtV'.obj W).left ⟶ (FgtX.obj U₁).left := (FgtX.map fh₁).left
        let fh₂_left : (FgtV'.obj W).left ⟶ (FgtX.obj U₂).left := (FgtX.map fh₂).left
        let g₁_left : (FgtX.obj U₁).left ⟶ (FgtX.obj U).left := (FgtX.map g₁).left
        let g₂_left : (FgtX.obj U₂).left ⟶ (FgtX.obj U).left := (FgtX.map g₂).left
        have hfh_left : fh₁_left ≫ g₁_left = fh₂_left ≫ g₂_left :=
          congrArg (fun m : Sigma_g.obj W ⟶ U => (FgtX.map m).left) hfh_comm
        have hEt_g₂ : AlgebraicGeometry.Etale g₂_left := hEt_of_etale_hom g₂
        have hEt_fst12 : AlgebraicGeometry.Etale
            (CategoryTheory.Limits.pullback.fst g₁_left g₂_left) :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback g₁_left g₂_left).flip hEt_g₂
        let U₁₂ : X.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.Limits.pullback.fst g₁_left g₂_left ≫ (FgtX.obj U₁).hom)
            (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
              _ (FgtX.obj U₁).hom hEt_fst12 U₁.prop)
        let p₁ : U₁₂ ⟶ U₁ :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.fst g₁_left g₂_left) rfl trivial
        let p₂ : U₁₂ ⟶ U₂ :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.snd g₁_left g₂_left)
            ((congrArg (CategoryTheory.Limits.pullback.snd g₁_left g₂_left ≫ ·)
              (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
              ((CategoryTheory.Category.assoc _ g₂_left _).symm.trans
                ((congrArg (· ≫ (FgtX.obj U).hom)
                  CategoryTheory.Limits.pullback.condition.symm).trans
                  ((CategoryTheory.Category.assoc _ g₁_left _).trans
                    (congrArg (CategoryTheory.Limits.pullback.fst g₁_left g₂_left ≫ ·)
                      (CategoryTheory.MorphismProperty.Over.w g₁))))))
            trivial
        have hp_comm : p₁ ≫ g₁ = p₂ ≫ g₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        let lift_fh : (FgtV'.obj W).left ⟶ CategoryTheory.Limits.pullback g₁_left g₂_left :=
          CategoryTheory.Limits.pullback.lift fh₁_left fh₂_left hfh_left
        let fh₁₂ : Sigma_g.obj W ⟶ U₁₂ :=
          CategoryTheory.MorphismProperty.Over.homMk lift_fh
            ((CategoryTheory.Category.assoc lift_fh _ (FgtX.obj U₁).hom).symm.trans
              ((congrArg (· ≫ (FgtX.obj U₁).hom)
                (CategoryTheory.Limits.pullback.lift_fst fh₁_left fh₂_left hfh_left)).trans
                (CategoryTheory.MorphismProperty.Over.w fh₁)))
            trivial
        have hfh₁₂_1 : fh₁₂ ≫ p₁ = fh₁ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext
            (CategoryTheory.Limits.pullback.lift_fst fh₁_left fh₂_left hfh_left)
        have hfh₁₂_2 : fh₁₂ ≫ p₂ = fh₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext
            (CategoryTheory.Limits.pullback.lift_snd fh₁_left fh₂_left hfh_left)
        let f₁₂ : W ⟶ B_g.obj U₁₂ := (adj_SB.homEquiv W U₁₂) fh₁₂
        have hf₁₂_1 : f₁₂ ≫ B_g.map p₁ = f₁ :=
          (adj_SB.homEquiv_naturality_right fh₁₂ p₁).symm.trans
            ((congrArg (adj_SB.homEquiv W U₁) hfh₁₂_1).trans
              (Equiv.apply_symm_apply _ f₁))
        have hf₁₂_2 : f₁₂ ≫ B_g.map p₂ = f₂ :=
          (adj_SB.homEquiv_naturality_right fh₁₂ p₂).symm.trans
            ((congrArg (adj_SB.homEquiv W U₂) hfh₁₂_2).trans
              (Equiv.apply_symm_apply _ f₂))
        have hx_eq := hx p₁ p₂ hg₁ hg₂ hp_comm
        have hL : ℱ.obj.map f₁.op (x g₁ hg₁) =
            ℱ.obj.map f₁₂.op (ℱ.obj.map (B_g.map p₁).op (x g₁ hg₁)) :=
          (congrArg (fun m : W ⟶ B_g.obj U₁ => ℱ.obj.map m.op (x g₁ hg₁)) hf₁₂_1.symm).trans
            (ℱ.obj.map_comp_apply (B_g.map p₁).op f₁₂.op (x g₁ hg₁))
        have hR : ℱ.obj.map f₂.op (x g₂ hg₂) =
            ℱ.obj.map f₁₂.op (ℱ.obj.map (B_g.map p₂).op (x g₂ hg₂)) :=
          (congrArg (fun m : W ⟶ B_g.obj U₂ => ℱ.obj.map m.op (x g₂ hg₂)) hf₁₂_2.symm).trans
