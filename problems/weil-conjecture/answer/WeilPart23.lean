          dsimp [m_i]
          rw [hsplit, map_mul, ← mul_assoc, hsurj_i i, ← map_mul]
        let num_CU : C_U := ∑ i : Fin pb_L.dim,
          algebraMap A C_U (m_i i) * (AdjoinRoot.root Q_ũ) ^ i.val
        refine ⟨⟨num_CU, ⟨algebraMap A C_U D, mem_nonZeroDivisors_iff_ne_zero.mpr hDCU_ne⟩⟩, ?_⟩
