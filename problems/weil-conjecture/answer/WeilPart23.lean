        ((CategoryTheory.sheafForget (D := AddCommGrpCat.{u}) W.smallEtaleTopology).obj 𝒢).property
    have hFor : CategoryTheory.Presieve.IsSheafFor P_G
        (CategoryTheory.Presieve.ofArrows X_i π_i) :=
      CategoryTheory.Presieve.IsSheaf.isSheafFor hShP
        (CategoryTheory.Presieve.ofArrows X_i π_i) hMem
    rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hFor
    exact hFor sec (fun i₁ i₂ Z₀ f₁ f₂ hf => hCompat i₁ i₂ Z₀ f₁ f₂ hf)

  have hUnitNat : ∀ (W : AlgebraicGeometry.Scheme.{u})
      (T : W.Etale) (hT : CategoryTheory.Limits.IsTerminal T)
      (A : AddCommGrpCat.{u}) (U : W.Etale),
      (CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT).unit.app A ≫
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj.map
