    have hu : (CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT).unit.app A =
        (((CategoryTheory.sheafificationAdjunction W.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite W.Etale)).obj A)).app (Opposite.op T)) := by
      dsimp [CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
