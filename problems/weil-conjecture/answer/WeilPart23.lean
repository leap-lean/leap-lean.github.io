        weil_algClosed_pointed_proj_closedSet_avoidance_poly k N' 5 q_star hq_pt Y₅ hClosedY₅
      obtain ⟨Δ_V, hΔV_ne, hΔV_eval⟩ :=
        weil_pointed_veronese_transversalSlice_eliminant k N' (m + 1 - r) r (by omega)
          q_star hq_0 hq_pt V_norm ι_V hClV W_reg Fr hSlV hVer_V
      obtain ⟨Δ_Z, hΔZ_ne, hΔZ_eval⟩ :=
        weil_pointed_veronese_transversalSlice_eliminant k N' (m - r) r (by omega)
          q_star hq_0 hq_pt Z_over ι_Z_proj hClZ_proj U_sm_div Fr hSlZ hVer_Z
      let Δ_tot : MvPolynomial (Fin (N' + 1)) k :=
        MvPolynomial.X 0 * Δ_closed * Δ_V * Δ_Z
      have hΔtot_ne : Δ_tot ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero (MvPolynomial.X_ne_zero 0) hΔc_ne) hΔV_ne) hΔZ_ne
      have hex_c' : ∃ c' : Fin (N' + 1) → k, MvPolynomial.eval c' Δ_tot ≠ 0 := by
        by_contra! hAll0
        apply hΔtot_ne
        rw [MvPolynomial.funext_iff]
        intro c'
        simpa using hAll0 c'
      obtain ⟨c', hc'_ne⟩ := hex_c'
      simp only [Δ_tot, map_mul, MvPolynomial.eval_X] at hc'_ne
      have hc'0_ne : c' 0 ≠ 0 :=
        left_ne_zero_of_mul (left_ne_zero_of_mul (left_ne_zero_of_mul hc'_ne))
      have hEv_c : MvPolynomial.eval c' Δ_closed ≠ 0 :=
        right_ne_zero_of_mul (left_ne_zero_of_mul (left_ne_zero_of_mul hc'_ne))
      have hEv_V : MvPolynomial.eval c' Δ_V ≠ 0 :=
        right_ne_zero_of_mul (left_ne_zero_of_mul hc'_ne)
      have hEv_Z : MvPolynomial.eval c' Δ_Z ≠ 0 :=
        right_ne_zero_of_mul hc'_ne
      let F_new : MvPolynomial (Fin (N + 1)) k :=
        ∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ
      have hFnew_hom : F_new ∈ 𝒜_N 1 := by
        refine Submodule.sum_mem _ fun β _ => ?_
        change (MvPolynomial.C (c' β) * MvPolynomial.X β.succ).IsHomogeneous 1
        simpa using (MvPolynomial.isHomogeneous_C (Fin (N + 1)) (c' β)).mul
          (MvPolynomial.isHomogeneous_X k β.succ)
      have hFnew_ne : F_new ≠ 0 := by
        intro h0
        let v₀ : Fin (N + 1) → k := fun α => if α = (0 : Fin (N' + 1)).succ then 1 else 0
        have hev := congrArg (MvPolynomial.eval v₀) h0
        simp only [F_new, map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
          map_zero, v₀, Fin.succ_inj] at hev
        have hsum :
            (∑ x : Fin (N' + 1), c' x * if x = 0 then (1 : k) else 0) = c' 0 := by
          simp
        rw [hsum] at hev
        exact hc'0_ne hev
      have hq_Fnew : q_star ∈ weilProjHyperplaneSet k N F_new := by
        rw [hMemHyp_qstar]
        exact q_star.asHomogeneousIdeal.toIdeal.sum_mem fun β _ =>
          q_star.asHomogeneousIdeal.toIdeal.mul_mem_left _ ((hMemHyp_qstar _).mp (hq_pt β))
      have hDrop := hΔc_eval c' hEv_c
      refine ⟨Fin.snoc Fr F_new, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · refine Fin.lastCases ?_ (fun j => ?_)
        · simpa using hq_Fnew
        · simpa using hq_Fr j
      · have hd_max : topologicalKrullDim
            ↥((Y_tot ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            max (topologicalKrullDim ↥(Y_tot ∩ M_slice r Fr)) ((1 : ℕ) : WithBot ℕ∞) :=
          (hDrop 0).2
        have h1_le : ((1 : ℕ) : WithBot ℕ∞) ≤ ((m + 1 - r : ℕ) : WithBot ℕ∞) :=
          WithBot.coe_le_coe.mpr (Nat.cast_le.mpr (by omega))
        have hd_bound : topologicalKrullDim
            ↥((Y_tot ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) +
              ((1 : ℕ) : WithBot ℕ∞) ≤ ((m + 1 - r : ℕ) : WithBot ℕ∞) :=
          hd_max.trans (max_le hTotU h1_le)
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        have hdiff := hWB_le_diff _ 1 (m + 1 - r) (by omega) hd_bound
        have hsub : m + 1 - r - 1 = m + 1 - (r + 1) := by omega
        rwa [hsub] at hdiff
      · rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        have he_pos : 1 ≤ m + 1 - r := by omega
        have hLow := (hHypBounds (Y_tot ∩ M_slice r Fr) (hClosed_Ytot.inter hClosedMr)
          (m + 1 - r) he_pos hTotL F_new hFnew_hom hFnew_ne).2
        have hsub : m + 1 - r - 1 = m + 1 - (r + 1) := by omega
        rwa [hsub] at hLow
      · have hd : topologicalKrullDim
            ↥((Y_div ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_div ∩ M_slice r Fr) :=
          (hDrop 1).1 (fun h => hq_not_Ydiv h.1)
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hDivU
      · have hd : topologicalKrullDim
            ↥((Y_sing ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_sing ∩ M_slice r Fr) :=
          (hDrop 2).1 (fun h => hq_not_Ysing h.1)
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hSingU
      · have hd : topologicalKrullDim
            ↥((Y_low ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_low ∩ M_slice r Fr) :=
          (hDrop 3).1 (fun h => hq_not_Ylow h.1)
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hLowU
      · have hd : topologicalKrullDim
            ↥((Y_divSing ∩ M_slice r Fr) ∩ weilProjHyperplaneSet k N F_new) + 1 ≤
            topologicalKrullDim ↥(Y_divSing ∩ M_slice r Fr) :=
          (hDrop 4).1 (fun h => hq_not_YdivSing h.1)
        rw [hSetEqDim (by rw [hM_snoc, ← Set.inter_assoc])]
        exact hWB_step _ _ _ r hd hDivSingU
      · have h0 := hΔV_eval c' hEv_V
        have hsub : m + 1 - r - 1 = m + 1 - (r + 1) := by omega
        rwa [hsub] at h0
      · have h1 := hΔZ_eval c' hEv_Z
        have hsub : m - r - 1 = m - (r + 1) := by omega
        rwa [hsub] at h1

  obtain ⟨F_init, hq_Finit, hDim_TotMm, hTotL_m, hDivU_m, hSingU_m, hLowU_m, hDivSingU_m,
      hSlV_m, hSlZ_m⟩ := hFlag m le_rfl
  let M_m := M_slice m F_init
  have hClosed_Mm : IsClosed M_m := hM_closed m F_init

  have hSub_m1 : m + 1 - m = 1 := by omega
  rw [hSub_m1] at hDim_TotMm hTotL_m hSlV_m
  rw [Nat.sub_self] at hSlZ_m

  have hDim_DivMm : topologicalKrullDim ↥(Y_div ∩ M_m) ≤ (0 : WithBot ℕ∞) := by
    have h := hWB_le_diff _ m m le_rfl hDivU_m
    rwa [Nat.sub_self] at h

  have hEmpty_SingMm : Y_sing ∩ M_m = ∅ :=
    hWB_empty_of_lt _ m (m - 1) (by omega) hSingU_m
  have hEmpty_LowMm : Y_low ∩ M_m = ∅ :=
    hWB_empty_of_lt _ m (m - 1) (by omega) hLowU_m
  have hEmpty_DivSingMm : Y_divSing ∩ M_m = ∅ :=
    hWB_empty_of_lt _ m (m - 1) (by omega) hDivSingU_m

  
  
  
  let Y₃_step : Fin 3 → Set (weilProjectiveSpaceOver k N).left := fun a =>
    if a.1 = 0 then Y_tot ∩ M_m
    else if a.1 = 1 then Y_div ∩ M_m
    else {q_star}
  have hClosedY₃ : ∀ a : Fin 3, IsClosed (Y₃_step a) := by
    intro a
    dsimp only [Y₃_step]
    split_ifs
    · exact hClosed_Ytot.inter hClosed_Mm
    · exact hClosed_Ydiv.inter hClosed_Mm
    · exact hClosed_qstar

  obtain ⟨F_m_form, hFm_hom, hFm_ne, hDrop_m, hNext_m⟩ :=
    hBertiniStep 3 1 Y₃_step hClosedY₃
      (fun _ => V_norm) (fun _ => ι_V) (fun _ => hClV) (fun _ => W_reg)
      (fun _ => 1) (fun _ => m) (fun _ => le_rfl) (fun _ => F_init) (fun _ => hSlV_m)

  have hSlV_m1 : IsTransversalLinearSlice k N V_norm ι_V W_reg 0 (m + 1)
      (Fin.snoc F_init F_m_form) := by
    simpa using hNext_m 0

  have hDim_TotCenter :
      topologicalKrullDim ↥((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ≤
        (0 : WithBot ℕ∞) := by
    have hd : topologicalKrullDim ↥((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) + 1 ≤
        topologicalKrullDim ↥(Y_tot ∩ M_m) := hDrop_m 0
    have h0 : topologicalKrullDim ↥((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) + 1 ≤
        ((1 : ℕ) : WithBot ℕ∞) :=
      hd.trans hDim_TotMm
    exact hWB_le_diff _ 1 1 le_rfl h0

  have hNonempty_TotCenter :
      ((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form).Nonempty :=
    (hHypBounds (Y_tot ∩ M_m) (hClosed_Ytot.inter hClosed_Mm)
      1 le_rfl hTotL_m F_m_form hFm_hom hFm_ne).1

  have hEmpty_DivCenter :
      (Y_div ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form = ∅ := by
    have hd : topologicalKrullDim ↥((Y_div ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) + 1 ≤
        topologicalKrullDim ↥(Y_div ∩ M_m) := hDrop_m 1
    have h1 : topologicalKrullDim ↥((Y_div ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) +
        ((1 : ℕ) : WithBot ℕ∞) ≤ ((0 : ℕ) : WithBot ℕ∞) :=
      hd.trans hDim_DivMm
    exact hWB_empty_of_lt _ 1 0 (by omega) h1

  have hq_not_Fm : q_star ∉ weilProjHyperplaneSet k N F_m_form := by
    have hd : topologicalKrullDim
        ↥(({q_star} : Set (weilProjectiveSpaceOver k N).left) ∩
          weilProjHyperplaneSet k N F_m_form) + 1 ≤
        topologicalKrullDim ↥({q_star} : Set (weilProjectiveSpaceOver k N).left) :=
      hDrop_m 2
    have hDim_qs :
        topologicalKrullDim ↥({q_star} : Set (weilProjectiveSpaceOver k N).left) ≤
          (0 : WithBot ℕ∞) := hSubDim0
    have h1 : topologicalKrullDim
        ↥(({q_star} : Set (weilProjectiveSpaceOver k N).left) ∩
          weilProjHyperplaneSet k N F_m_form) + ((1 : ℕ) : WithBot ℕ∞) ≤
