    have hChartData : ∀ b : Fin (m + 1),
        ∃ (eΨ_b : CategoryTheory.Limits.pullback ((D₀ b).ι ≫ B₀.hom) P₁.hom ≅
            (p₂.left ⁻¹ᵁ D₀ b).toScheme)
          (s_b : (D₀ b).toScheme ⟶
            CategoryTheory.Limits.pullback ((D₀ b).ι ≫ B₀.hom) P₁.hom),
