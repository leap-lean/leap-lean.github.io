  have step4b_mateIso : ∀ {E₁ E₂ : Type (u + 1)} [Category.{u} E₁] [Category.{u} E₂]
      (J₁ : GrothendieckTopology E₁) (J₂ : GrothendieckTopology E₂)
      [HasWeakSheafify J₁ AddCommGrpCat.{u}] [HasWeakSheafify J₂ AddCommGrpCat.{u}]
      (F : E₁ ⥤ E₂) (G : E₂ ⥤ E₁)
      [F.IsContinuous J₁ J₂] [G.IsContinuous J₂ J₁]
      [(G.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁).IsRightAdjoint]
      (adj_FG : F ⊣ G)
      {T₁ : E₁} (hT₁ : Limits.IsTerminal T₁)
      {T₂ : E₂} (hT₂ : Limits.IsTerminal T₂)
      {T'₁ : E₁} (hT'₁ : Limits.IsTerminal T'₁)
      {T'₂ : E₂} (hT'₂ : Limits.IsTerminal T'₂),
      let R_ab := F.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂
      let P_push := G.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
      let P_pull := G.sheafPullback AddCommGrpCat.{u} J₂ J₁
      let adj_pull := G.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let adj'₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT'₁
      let adj'₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT'₂
      let μ₁₂ : F.obj T₁ ⟶ T₂ := hT₂.from (F.obj T₁)
      let τ' : G.obj T'₂ ⟶ T'₁ := hT'₁.from (G.obj T'₂)
      ∃ η_pull : P_pull ≅ R_ab,
        ∀ A : AddCommGrpCat.{u},
          (adj₁.homEquiv A (R_ab.obj (C₂.obj A))).symm
              (adj₂.unit.app A ≫ (C₂.obj A).obj.map μ₁₂.op) ≫
            η_pull.inv.app (C₂.obj A) ≫
            (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm
