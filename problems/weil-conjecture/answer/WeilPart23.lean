              (fun y => (hOg_val U₂ gu x y.1 y.2).trans (gu.2 x hx)) }
    let Θ_inv : L0_sh ⟶ L_V := CategoryTheory.ObjectProperty.homMk Θ_inv_pre

    have hΘ_hom_inv : Θ_hom ≫ Θ_inv = CategoryTheory.CategoryStruct.id L_V := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquivComp Θ_hom Θ_inv]
      have hc : CategoryTheory.Sheaf.freeYonedaHomEquiv Θ_hom = γ₀ :=
        Equiv.apply_symm_apply _ _
      rw [hc]
      apply AddCommGrpCat.ext
      intro a
