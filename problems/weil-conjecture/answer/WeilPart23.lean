        have hz_repr := pb_L.basis.sum_repr z
        have hroot_w : AdjoinRoot.root P_f = w * algebraMap F L g.val := by
          dsimp [w]
          rw [mul_assoc, ← map_mul, Units.inv_mul, map_one, mul_one]
        let q_i : Fin pb_L.dim → F := fun i => pb_L.basis.repr z i * g.val ^ i.val
