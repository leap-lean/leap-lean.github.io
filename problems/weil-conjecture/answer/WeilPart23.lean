                  AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι_assoc]
          _ = j_sm₁.isoOpensRange.inv ≫ W_sm₀.ι ≫
                (CategoryTheory.inv (φ_bar.left ∣_ U_φ) ≫ (φ_bar.left ⁻¹ᵁ U_φ).ι ≫ π_bar.left) := by
                dsimp [j_sm₁]; simp only [CategoryTheory.Category.assoc]
          _ = j_sm₁.isoOpensRange.inv ≫ (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := by
                rw [hOpenId]
      rw [hEq]
      have : AlgebraicGeometry.SmoothOfRelativeDimension 0 j_sm₁.isoOpensRange.inv := inferInstance
      have : AlgebraicGeometry.SmoothOfRelativeDimension 1
          (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀) := hSm_Wsm₀
      have : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
          (j_sm₁.isoOpensRange.inv ≫ (W_sm₀.ι ≫ (π.left ∣_ U_proj) ≫ pr_p₀)) := inferInstance
      simpa using this

    let W_sm_tot : Y_bar.left.Opens := W_exc ⊔ W_sm₁
    have hSm_Wtot : AlgebraicGeometry.SmoothOfRelativeDimension 1 (W_sm_tot.ι ≫ π_bar.left) :=
      hSmoothSup π_bar.left W_exc W_sm₁ hSm_Wexc hSm_Wsm₁

    let K_sm : Set ↥B₀.left := π_bar.left.base '' ((W_sm_tot : Set ↥Y_bar.left)ᶜ)
    let K_et : Set ↥B₀.left := (ιZ₁ ≫ π_bar.left).base '' ((W_et₀ : Set ↥Z_div)ᶜ)
    let K_low : Set ↥B₀.left := π_bar.left.base '' (φ_bar.left.base ⁻¹' Z_low)

    have hClosed_Ksm : IsClosed K_sm :=
      AlgebraicGeometry.Scheme.Hom.isClosedMap π_bar.left _ W_sm_tot.isOpen.isClosed_compl
    have hClosed_Ket : IsClosed K_et :=
      AlgebraicGeometry.Scheme.Hom.isClosedMap (ιZ₁ ≫ π_bar.left) _ W_et₀.isOpen.isClosed_compl
    have hClosed_Klow : IsClosed K_low :=
      AlgebraicGeometry.Scheme.Hom.isClosedMap π_bar.left _
        (hClosed_low.preimage φ_bar.left.continuous)

    have hb_not_Ksm : b_star ∉ K_sm := by
      rintro ⟨v, hv_not, hv_eq⟩
      by_cases hvU : v ∈ φ_bar.left ⁻¹ᵁ U_φ
      · let v₀ : ↥(φ_bar.left ⁻¹ᵁ U_φ).toScheme := ⟨v, hvU⟩
        let x_pt : ↥U_φ.toScheme := (φ_bar.left ∣_ U_φ).base v₀
        have h_inv_x : (CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base x_pt = v₀ := by
          change ((φ_bar.left ∣_ U_φ) ≫ CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base v₀ = v₀
          rw [CategoryTheory.IsIso.hom_inv_id]
          rfl
        have hx_b : ((π.left ∣_ U_proj) ≫ pr_p₀).base x_pt = b_star := by
          rw [← hOpenId]
          change π_bar.left.base ((φ_bar.left ⁻¹ᵁ U_φ).ι.base
            ((CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base x_pt)) = b_star
          rw [h_inv_x]
          exact hv_eq
        have hx_sm : x_pt ∈ W_sm₀ := hb_star_sm x_pt hx_b
        have hv_sm₁ : v ∈ W_sm₁ := by
          refine ⟨⟨x_pt, hx_sm⟩, ?_⟩
          change (φ_bar.left ⁻¹ᵁ U_φ).ι.base
            ((CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base (W_sm₀.ι.base ⟨x_pt, hx_sm⟩)) = v
          have hι_w : W_sm₀.ι.base ⟨x_pt, hx_sm⟩ = x_pt :=
            AlgebraicGeometry.Scheme.Opens.ι_apply W_sm₀ ⟨x_pt, hx_sm⟩
          rw [hι_w, h_inv_x]
          exact AlgebraicGeometry.Scheme.Opens.ι_apply (φ_bar.left ⁻¹ᵁ U_φ) v₀
        exact hv_not (Or.inr hv_sm₁)
      · have hv_exc : v ∈ W_exc := hSub_et_π hvU
        exact hv_not (Or.inl hv_exc)

    have hb_not_Ket : b_star ∉ K_et := by
      rintro ⟨z, hz_not, hz_eq⟩
      have hz_b : (j_div ≫ (π.left ∣_ U_proj) ≫ pr_p₀).base z = b_star := by
        rwa [← hιZ₁_πbar]
      exact hz_not (hb_star_et z hz_b)

    have hb_not_Klow : b_star ∉ K_low := by
      rintro ⟨v, hv_low, hv_eq⟩
      have hvU : v ∈ φ_bar.left ⁻¹ᵁ U_φ := hZ_low_sub hv_low
      let v₀ : ↥(φ_bar.left ⁻¹ᵁ U_φ).toScheme := ⟨v, hvU⟩
      let x_pt : ↥U_φ.toScheme := (φ_bar.left ∣_ U_φ).base v₀
      have h_inv_x : (CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base x_pt = v₀ := by
        change ((φ_bar.left ∣_ U_φ) ≫ CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base v₀ = v₀
        rw [CategoryTheory.IsIso.hom_inv_id]
        rfl
      have hx_val : x_pt.1 ∈ Z_low := by
        have hι : U_φ.ι.base x_pt = φ_bar.left.base v := by
          change ((φ_bar.left ∣_ U_φ) ≫ U_φ.ι).base v₀ = φ_bar.left.base v
          rw [AlgebraicGeometry.morphismRestrict_ι φ_bar.left U_φ]
          rfl
        have hcoe : U_φ.ι.base x_pt = x_pt.1 := AlgebraicGeometry.Scheme.Opens.ι_apply U_φ x_pt
        rwa [← hcoe, hι]
      have hx_b : ((π.left ∣_ U_proj) ≫ pr_p₀).base x_pt = b_star := by
        rw [← hOpenId]
        change π_bar.left.base ((φ_bar.left ⁻¹ᵁ U_φ).ι.base
          ((CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base x_pt)) = b_star
        rw [h_inv_x]
        exact hv_eq
      exact hb_star_low x_pt hx_val hx_b

    let U₀ : B₀.left.Opens :=
      ⟨(K_sm ∪ K_et ∪ K_low)ᶜ,
        ((hClosed_Ksm.union hClosed_Ket).union hClosed_Klow).isOpen_compl⟩
    have hb_U₀ : b_star ∈ U₀ := by
      rintro ((h₁ | h₂) | h₃)
      · exact hb_not_Ksm h₁
      · exact hb_not_Ket h₂
      · exact hb_not_Klow h₃

    have hPre_sm : π_bar.left ⁻¹ᵁ U₀ ≤ W_sm_tot := by
      intro v hv
      by_contra hv_not
      exact hv (Or.inl (Or.inl ⟨v, hv_not, rfl⟩))
    have hSm_πbar_U₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (π_bar.left ∣_ U₀) :=
      (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
        (hRestrictSub π_bar.left W_sm_tot U₀ hPre_sm).flip hSm_Wtot

    
    have hConn_πbar :=
      weil_algClosed_proper_curve_connected_fibers_of_section
        k δ hδ U₀ ⟨⟨b_star, hb_U₀⟩⟩ Y_bar hIntYbar hProjYbar hDimYbar π_bar
        hProp_πbar hSurj_πbar hSm_πbar_U₀ σ_exc hSec_exc
        (fun K _ _ s E hE => (hFibComp K s E hE).1)

    
    have hε_sec : ε_p₀.left ≫ p₂.left = 𝟙 B₀.left :=
      congrArg CategoryTheory.CommaMorphism.left hSec_ε
    have hCl_ε : AlgebraicGeometry.IsClosedImmersion ε_p₀.left := by
      have : AlgebraicGeometry.IsClosedImmersion (ε_p₀.left ≫ p₂.left) := by
        rw [hε_sec]; infer_instance
      exact AlgebraicGeometry.IsClosedImmersion.of_comp ε_p₀.left p₂.left
    have : AlgebraicGeometry.IsClosedImmersion ε_p₀.left := hCl_ε

    let E_tot : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback q_tilde ε_p₀.left
    let ι_E : E_tot ⟶ Y_bar.left := CategoryTheory.Limits.pullback.fst q_tilde ε_p₀.left
    let f_E : E_tot ⟶ B₀.left := CategoryTheory.Limits.pullback.snd q_tilde ε_p₀.left
    have hCl_E : AlgebraicGeometry.IsClosedImmersion ι_E := by
      dsimp [ι_E]; infer_instance
    have : AlgebraicGeometry.IsClosedImmersion ι_E := hCl_E
    have hιE_πbar : ι_E ≫ π_bar.left = f_E := by
      change ι_E ≫ q_tilde ≫ p₂.left = f_E
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, hε_sec, CategoryTheory.Category.comp_id]

    have hPb_E_top : CategoryTheory.IsPullback ι_E f_E q_tilde ε_p₀.left :=
      CategoryTheory.IsPullback.of_hasPullback q_tilde ε_p₀.left
    have hPb_Ybar_flip : CategoryTheory.IsPullback q_tilde φ_bar.left p₁.left π.left :=
      (CategoryTheory.IsPullback.of_hasPullback π.left p₁.left).flip
    have hPb_E_vert : CategoryTheory.IsPullback
        f_E (ι_E ≫ φ_bar.left) (ε_p₀.left ≫ p₁.left) π.left :=
      hPb_E_top.flip.paste_vert hPb_Ybar_flip
    have hFin_fE : AlgebraicGeometry.IsFinite f_E :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.IsFinite) hPb_E_vert.flip hFin_π

    have hRange_εp₁ : Set.range (ε_p₀.left ≫ p₁.left).base ⊆ Set.range U_et_π.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨b, rfl⟩
      rw [← h_sec_comm]
      change (q_sec ≫ π.left).base (B₀.hom.base b) ∈ (U_et_π : Set ↥P_amb.left)
      exact hSub_et_π (hq_sec_range ⟨B₀.hom.base b, rfl⟩)
    let g_et_B : B₀.left ⟶ U_et_π.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_et_π.ι (ε_p₀.left ≫ p₁.left) hRange_εp₁
    have hg_et_B : g_et_B ≫ U_et_π.ι = ε_p₀.left ≫ p₁.left :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_et_π.ι (ε_p₀.left ≫ p₁.left) hRange_εp₁

    have hRange_Eφ : Set.range (ι_E ≫ φ_bar.left).base ⊆
        Set.range (π.left ⁻¹ᵁ U_et_π).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨e, rfl⟩
      change ((ι_E ≫ φ_bar.left) ≫ π.left).base e ∈ (U_et_π : Set ↥P_amb.left)
      rw [← hPb_E_vert.w]
      change (ε_p₀.left ≫ p₁.left).base (f_E.base e) ∈ (U_et_π : Set ↥P_amb.left)
      have hmem := hRange_εp₁ ⟨f_E.base e, rfl⟩
      rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hmem
    let top_et_E : E_tot ⟶ (π.left ⁻¹ᵁ U_et_π).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (π.left ⁻¹ᵁ U_et_π).ι (ι_E ≫ φ_bar.left) hRange_Eφ
    have htop_et_E : top_et_E ≫ (π.left ⁻¹ᵁ U_et_π).ι = ι_E ≫ φ_bar.left :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (π.left ⁻¹ᵁ U_et_π).ι (ι_E ≫ φ_bar.left) hRange_Eφ
    have hcomm_et_E : f_E ≫ g_et_B = top_et_E ≫ (π.left ∣_ U_et_π) := by
      rw [← CategoryTheory.cancel_mono U_et_π.ι, CategoryTheory.Category.assoc, hg_et_B,
        CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
        ← CategoryTheory.Category.assoc top_et_E, htop_et_E]
      exact hPb_E_vert.w
    have hPb_E_et : CategoryTheory.IsPullback f_E top_et_E g_et_B (π.left ∣_ U_et_π) := by
      refine CategoryTheory.IsPullback.of_bot ?_ hcomm_et_E
        (AlgebraicGeometry.isPullback_morphismRestrict π.left U_et_π)
      rw [htop_et_E, hg_et_B]
      exact hPb_E_vert
    have hEt_fE : AlgebraicGeometry.Etale f_E :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.Etale) hPb_E_et.flip hEt_π

    let s_E : B₀.left ⟶ E_tot :=
      CategoryTheory.Limits.pullback.lift σ_exc_left (𝟙 B₀.left)
        (by
          dsimp [σ_exc_left, q_tilde]
          rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp])
    have hSurj_fE : AlgebraicGeometry.Surjective f_E := by
      refine ⟨fun b => ⟨s_E.base b, ?_⟩⟩
      change (s_E ≫ f_E).base b = b
      rw [CategoryTheory.Limits.pullback.lift_snd]
      rfl

    have hRange_E :
        Set.range ι_E.base = ((φ_bar.left ⁻¹ᵁ U_φ : Y_bar.left.Opens) : Set ↥Y_bar.left)ᶜ := by
      ext y
      have h_comm_y : π.left.base (φ_bar.left.base y) = p₁.left.base (q_tilde.base y) :=
        congrArg (fun g : Y_bar.left ⟶ P_amb.left => g.base y)
          (CategoryTheory.Limits.pullback.condition (f := π.left) (g := p₁.left))
      constructor
      · rintro ⟨e, rfl⟩
        change π.left.base (φ_bar.left.base (ι_E.base e)) ∉ U_proj
        rw [h_comm_y]
        have hqe : q_tilde.base (ι_E.base e) = ε_p₀.left.base (f_E.base e) := by
          change (ι_E ≫ q_tilde).base e = (f_E ≫ ε_p₀.left).base e
          rw [CategoryTheory.Limits.pullback.condition]
        have hmem_range : q_tilde.base (ι_E.base e) ∈ Set.range ε_p₀.left.base :=
          ⟨f_E.base e, hqe.symm⟩
        rw [← hCompl_exc] at hmem_range
        exact hmem_range
      · intro hy_not
        have hp₁_not : q_tilde.base y ∈
            (((TopologicalSpace.Opens.map p₁.left.base).obj U_proj : Set ↥P_tilde.left)ᶜ) := by
          change p₁.left.base (q_tilde.base y) ∉ U_proj
          rwa [← h_comm_y]
        rw [hCompl_exc] at hp₁_not
        obtain ⟨b, hb⟩ := hp₁_not
        obtain ⟨e, he_fst, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := q_tilde) (g := ε_p₀.left) y b hb.symm
        exact ⟨e, he_fst⟩

    
    obtain ⟨V₀, hAff_V₀, hb_V₀, hV₀_le⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := b_star) (U := U₀ ⊓ D_base) ⟨hb_U₀, hb_Dbase⟩
    have hV₀_le_U₀ : V₀ ≤ U₀ := fun z hz => (hV₀_le hz).1
    have hV₀_le_Dbase : V₀ ≤ D_base := fun z hz => (hV₀_le hz).2

    let e_Dbase' : D_base.toScheme ≅ (weilAffineSpaceOver k δ).left := e_Dbase
    have he_Dbase'_hom : e_Dbase'.hom ≫ (weilAffineSpaceOver k δ).hom = D_base.ι ≫ B₀.hom :=
      he_Dbase_hom
    let u_V₀ : V₀.toScheme ⟶ (weilAffineSpaceOver k δ).left :=
      B₀.left.homOfLE hV₀_le_Dbase ≫ e_Dbase'.hom
    have hEt_uV₀ : AlgebraicGeometry.Etale u_V₀ := by
      dsimp [u_V₀]; infer_instance
    have hComp_uV₀ : u_V₀ ≫ (weilAffineSpaceOver k δ).hom = V₀.ι ≫ B₀.hom := by
      dsimp [u_V₀]
      rw [CategoryTheory.Category.assoc, he_Dbase'_hom,
        AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    let b₀ : ↥V₀.toScheme := ⟨b_star, hb_V₀⟩
    have hb₀_cl : IsClosed ({b₀} : Set ↥V₀.toScheme) := by
      have hpre : ({b₀} : Set ↥V₀.toScheme) = V₀.ι.base ⁻¹' ({b_star} : Set ↥B₀.left) := by
        ext z
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        exact ⟨fun h => congrArg V₀.ι.base h, fun h => V₀.ι.isOpenEmbedding.injective h⟩
      rw [hpre]
      exact hb_star_cl.preimage V₀.ι.continuous

    
    have hPre_sm_V₀ : π_bar.left ⁻¹ᵁ V₀ ≤ W_sm_tot :=
      fun v hv => hPre_sm (hV₀_le_U₀ hv)
    have hSm_V₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 (π_bar.left ∣_ V₀) :=
      (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
        (hRestrictSub π_bar.left W_sm_tot V₀ hPre_sm_V₀).flip hSm_Wtot

    have hConn_V₀ :
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V₀.toScheme),
          ConnectedSpace ↥(CategoryTheory.Limits.pullback (π_bar.left ∣_ V₀) s) := by
      intro Ω _ _ s
      have hPb1 : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst (π_bar.left ∣_ V₀) s)
          (CategoryTheory.Limits.pullback.snd (π_bar.left ∣_ V₀) s)
          (π_bar.left ∣_ V₀) s :=
        CategoryTheory.IsPullback.of_hasPullback (π_bar.left ∣_ V₀) s
      have hPb2 : CategoryTheory.IsPullback
          (π_bar.left ∣_ V₀) (π_bar.left ⁻¹ᵁ V₀).ι V₀.ι π_bar.left :=
        AlgebraicGeometry.isPullback_morphismRestrict π_bar.left V₀
      have hPb_tot : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.fst (π_bar.left ∣_ V₀) s ≫ (π_bar.left ⁻¹ᵁ V₀).ι)
          (CategoryTheory.Limits.pullback.snd (π_bar.left ∣_ V₀) s)
          π_bar.left (s ≫ V₀.ι) :=
        hPb1.paste_horiz hPb2.flip
      exact hConnOfIso hPb_tot.isoPullback (hConn_πbar Ω (s ≫ V₀.ι))

    
    let O_V₀ : Y_bar.left.Opens := π_bar.left ⁻¹ᵁ V₀
    let ι₁_V₀ : (ιZ₁ ⁻¹ᵁ O_V₀).toScheme ⟶ O_V₀.toScheme := ιZ₁ ∣_ O_V₀
    let ι₂_V₀ : (ι_E ⁻¹ᵁ O_V₀).toScheme ⟶ O_V₀.toScheme := ι_E ∣_ O_V₀
    have hCl_ι₁V₀ : AlgebraicGeometry.IsClosedImmersion ι₁_V₀ := by
      dsimp [ι₁_V₀]; infer_instance
    have hCl_ι₂V₀ : AlgebraicGeometry.IsClosedImmersion ι₂_V₀ := by
      dsimp [ι₂_V₀]; infer_instance

    have hPb_ι₁V₀ : CategoryTheory.IsPullback
        (ι₁_V₀ ≫ (π_bar.left ∣_ V₀)) (ιZ₁ ⁻¹ᵁ O_V₀).ι V₀.ι (ιZ₁ ≫ π_bar.left) :=
      (AlgebraicGeometry.isPullback_morphismRestrict ιZ₁ O_V₀).paste_horiz
        (AlgebraicGeometry.isPullback_morphismRestrict π_bar.left V₀)
    have hPb_ι₂V₀ : CategoryTheory.IsPullback
        (ι₂_V₀ ≫ (π_bar.left ∣_ V₀)) (ι_E ⁻¹ᵁ O_V₀).ι V₀.ι (ι_E ≫ π_bar.left) :=
      (AlgebraicGeometry.isPullback_morphismRestrict ι_E O_V₀).paste_horiz
        (AlgebraicGeometry.isPullback_morphismRestrict π_bar.left V₀)

    have hFin_ι₁V₀ : AlgebraicGeometry.IsFinite (ι₁_V₀ ≫ (π_bar.left ∣_ V₀)) :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.IsFinite) hPb_ι₁V₀.flip hFin_Z₁
    have hPre_et_V₀ : ιZ₁ ⁻¹ᵁ O_V₀ ≤ W_et₀ := by
      intro z hz
      by_contra hz_not
      exact (hV₀_le_U₀ hz) (Or.inl (Or.inr ⟨z, hz_not, rfl⟩))
    have hEt_W_Z₁ : AlgebraicGeometry.Etale (W_et₀.ι ≫ (ιZ₁ ≫ π_bar.left)) := by
      rw [hιZ₁_πbar]; exact hEt_Wet₀
    have hPb_ι₁_et : CategoryTheory.IsPullback
        (ι₁_V₀ ≫ (π_bar.left ∣_ V₀))
        (Z_div.homOfLE hPre_et_V₀)
        V₀.ι (W_et₀.ι ≫ (ιZ₁ ≫ π_bar.left)) := by
      have h1 : CategoryTheory.IsPullback
          (ι₁_V₀ ≫ (π_bar.left ∣_ V₀)) (Z_div.homOfLE hPre_et_V₀ ≫ W_et₀.ι)
          V₀.ι (ιZ₁ ≫ π_bar.left) := by
        rw [Z_div.homOfLE_ι hPre_et_V₀]
        exact hPb_ι₁V₀
      have hcomm : (ι₁_V₀ ≫ (π_bar.left ∣_ V₀)) ≫ V₀.ι =
          Z_div.homOfLE hPre_et_V₀ ≫ (W_et₀.ι ≫ (ιZ₁ ≫ π_bar.left)) :=
        h1.w.trans (CategoryTheory.Category.assoc _ _ _)
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
          (fun s => h1.lift s.fst (s.snd ≫ W_et₀.ι)
            (s.condition.trans
              (CategoryTheory.Category.assoc s.snd W_et₀.ι (ιZ₁ ≫ π_bar.left)).symm))
          (fun s => h1.lift_fst _ _ _)
          (fun s => (CategoryTheory.cancel_mono W_et₀.ι).mp
            ((CategoryTheory.Category.assoc _ _ _).trans (h1.lift_snd _ _ _)))
          (fun s m hm₁ hm₂ => h1.hom_ext
            (hm₁.trans (h1.lift_fst _ _ _).symm)
            (((CategoryTheory.Category.assoc m _ _).symm.trans
              (congrArg (· ≫ W_et₀.ι) hm₂)).trans (h1.lift_snd _ _ _).symm)))
    have hEt_ι₁V₀ : AlgebraicGeometry.Etale (ι₁_V₀ ≫ (π_bar.left ∣_ V₀)) :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.Etale) hPb_ι₁_et.flip hEt_W_Z₁

    have hFin_ιE : AlgebraicGeometry.IsFinite (ι_E ≫ π_bar.left) := by
      rwa [hιE_πbar]
    have hEt_ιE : AlgebraicGeometry.Etale (ι_E ≫ π_bar.left) := by
      rwa [hιE_πbar]
    have hSurj_ιE : AlgebraicGeometry.Surjective (ι_E ≫ π_bar.left) := by
      rwa [hιE_πbar]
    have hFin_ι₂V₀ : AlgebraicGeometry.IsFinite (ι₂_V₀ ≫ (π_bar.left ∣_ V₀)) :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.IsFinite) hPb_ι₂V₀.flip hFin_ιE
    have hEt_ι₂V₀ : AlgebraicGeometry.Etale (ι₂_V₀ ≫ (π_bar.left ∣_ V₀)) :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.Etale) hPb_ι₂V₀.flip hEt_ιE
    have hSurj_ι₂V₀ : AlgebraicGeometry.Surjective (ι₂_V₀ ≫ (π_bar.left ∣_ V₀)) :=
      CategoryTheory.MorphismProperty.of_isPullback
        (P := @AlgebraicGeometry.Surjective) hPb_ι₂V₀.flip hSurj_ιE

    have hRange_ι₁V₀ :
        Set.range ι₁_V₀.base = {w : ↥O_V₀.toScheme | w.1 ∈ Set.range ιZ₁.base} := by
      ext w
      constructor
      · rintro ⟨z, rfl⟩
        refine ⟨(ιZ₁ ⁻¹ᵁ O_V₀).ι.base z, ?_⟩
        change ((ιZ₁ ⁻¹ᵁ O_V₀).ι ≫ ιZ₁).base z = O_V₀.ι.base (ι₁_V₀.base z)
        rw [← AlgebraicGeometry.morphismRestrict_ι ιZ₁ O_V₀]
        rfl
      · rintro ⟨z, hz⟩
        have hz_mem : z ∈ ιZ₁ ⁻¹ᵁ O_V₀ := by
          change ιZ₁.base z ∈ (O_V₀ : Set ↥Y_bar.left)
          rw [hz]
          exact w.2
        refine ⟨⟨z, hz_mem⟩, ?_⟩
        apply O_V₀.ι.isOpenEmbedding.injective
        change (ι₁_V₀ ≫ O_V₀.ι).base ⟨z, hz_mem⟩ = w.1
        rw [AlgebraicGeometry.morphismRestrict_ι ιZ₁ O_V₀]
        exact hz

    have hRange_ι₂V₀ :
        Set.range ι₂_V₀.base = {w : ↥O_V₀.toScheme | w.1 ∈ Set.range ι_E.base} := by
      ext w
      constructor
      · rintro ⟨z, rfl⟩
        refine ⟨(ι_E ⁻¹ᵁ O_V₀).ι.base z, ?_⟩
        change ((ι_E ⁻¹ᵁ O_V₀).ι ≫ ι_E).base z = O_V₀.ι.base (ι₂_V₀.base z)
        rw [← AlgebraicGeometry.morphismRestrict_ι ι_E O_V₀]
        rfl
      · rintro ⟨z, hz⟩
        have hz_mem : z ∈ ι_E ⁻¹ᵁ O_V₀ := by
          change ι_E.base z ∈ (O_V₀ : Set ↥Y_bar.left)
          rw [hz]
          exact w.2
        refine ⟨⟨z, hz_mem⟩, ?_⟩
        apply O_V₀.ι.isOpenEmbedding.injective
        change (ι₂_V₀ ≫ O_V₀.ι).base ⟨z, hz_mem⟩ = w.1
        rw [AlgebraicGeometry.morphismRestrict_ι ι_E O_V₀]
        exact hz

    have hDisj_V₀ : Disjoint (Set.range ι₁_V₀.base) (Set.range ι₂_V₀.base) := by
      rw [Set.disjoint_left, hRange_ι₁V₀, hRange_ι₂V₀]
      rintro w ⟨z, hz⟩ hw_E
      rw [hRange_E] at hw_E
      apply hw_E
      rw [← hz]
      change ιZ₁.base z ∈ ((φ_bar.left ⁻¹ᵁ U_φ : Y_bar.left.Opens) : Set ↥Y_bar.left)
      rw [← (φ_bar.left ⁻¹ᵁ U_φ).range_ι]
      exact ⟨(CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base (j_div.base z), rfl⟩

    obtain ⟨Z_tot, ι_tot, hCl_tot, hRange_tot, hFin_tot, hEt_tot, hSurj_tot⟩ :=
      hDisjCoprod _ _ O_V₀.toScheme V₀.toScheme ι₁_V₀ ι₂_V₀ (π_bar.left ∣_ V₀)
        hCl_ι₁V₀ hCl_ι₂V₀ hDisj_V₀
        hFin_ι₁V₀ hEt_ι₁V₀ hFin_ι₂V₀ hEt_ι₂V₀ hSurj_ι₂V₀

    
    have : AlgebraicGeometry.IsClosedImmersion ι_tot := hCl_tot
    let U_open : O_V₀.toScheme.Opens :=
      ⟨(Set.range ι_tot.base)ᶜ, ι_tot.isClosedEmbedding.isClosed_range.isOpen_compl⟩

    have : AlgebraicGeometry.IsAffine U_in.toScheme := hAffUin
    let g_amb : U_in.toScheme ⟶ P_amb.left := U_in.ι ≫ π.left
    have hAffHom_gamb : AlgebraicGeometry.IsAffineHom g_amb := by
      have : AlgebraicGeometry.IsAffineHom (g_amb ≫ P_amb.hom) :=
        hAffHomToSpec (g_amb ≫ P_amb.hom)
      exact AlgebraicGeometry.IsAffineHom.of_comp g_amb P_amb.hom
    have : AlgebraicGeometry.IsAffineHom g_amb := hAffHom_gamb
    have hAff_Damb : AlgebraicGeometry.IsAffineOpen D_amb := by
      let : GradedAlgebra 𝒜_m1 := MvPolynomial.gradedAlgebra
      let iso_raw := @AlgebraicGeometry.Proj.basicOpenIsoSpec _ _ _ _ _ 𝒜_m1
        MvPolynomial.gradedAlgebra (MvPolynomial.X (Fin.last δ).castSucc) 1
        (MvPolynomial.isHomogeneous_X k (Fin.last δ).castSucc) zero_lt_one
      let iso_Damb : D_amb.toScheme ≅ _ := iso_raw
      exact AlgebraicGeometry.IsAffine.of_isIso iso_Damb.hom
    let U_1 : U_in.toScheme.Opens := g_amb ⁻¹ᵁ D_amb
    have hAff_U1 : AlgebraicGeometry.IsAffineOpen U_1 := hAff_Damb.preimage g_amb
    have : AlgebraicGeometry.IsAffine U_1.toScheme := hAff_U1

    obtain ⟨_, _, hPr_charts⟩ := hPr
    obtain ⟨hPr_last_iff, _, hDamb_le_Uproj, _, _, _⟩ := hPr_charts (Fin.last δ)

    have hRange_U1_Uφ : Set.range (U_1.ι ≫ U_in.ι).base ⊆ Set.range U_φ.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨u₁, rfl⟩
      exact hDamb_le_Uproj u₁.2
    let ι_U1_Uφ : U_1.toScheme ⟶ U_φ.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U_φ.ι (U_1.ι ≫ U_in.ι) hRange_U1_Uφ
    have hι_U1_Uφ : ι_U1_Uφ ≫ U_φ.ι = U_1.ι ≫ U_in.ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U_φ.ι (U_1.ι ≫ U_in.ι) hRange_U1_Uφ
    have hOpen_U1_Uφ : AlgebraicGeometry.IsOpenImmersion ι_U1_Uφ := by
      have : AlgebraicGeometry.IsOpenImmersion (ι_U1_Uφ ≫ U_φ.ι) := by
        rw [hι_U1_Uφ]; infer_instance
      exact AlgebraicGeometry.IsOpenImmersion.of_comp ι_U1_Uφ U_φ.ι
    have : AlgebraicGeometry.IsOpenImmersion ι_U1_Uφ := hOpen_U1_Uφ

    let g_base : U_1.toScheme ⟶ B₀.left := ι_U1_Uφ ≫ (π.left ∣_ U_proj) ≫ pr_p₀
    have hAffHom_gbase : AlgebraicGeometry.IsAffineHom g_base := by
      have : AlgebraicGeometry.IsAffineHom (g_base ≫ B₀.hom) :=
        hAffHomToSpec (g_base ≫ B₀.hom)
      exact AlgebraicGeometry.IsAffineHom.of_comp g_base B₀.hom
    have : AlgebraicGeometry.IsAffineHom g_base := hAffHom_gbase
    let U_2 : U_1.toScheme.Opens := g_base ⁻¹ᵁ V₀
    have hAff_U2 : AlgebraicGeometry.IsAffineOpen U_2 := hAff_V₀.preimage g_base
    have : AlgebraicGeometry.IsAffine U_2.toScheme := hAff_U2

    let α_U2 : U_2.toScheme ⟶ Y_bar.left :=
      U_2.ι ≫ ι_U1_Uφ ≫ CategoryTheory.inv (φ_bar.left ∣_ U_φ) ≫ (φ_bar.left ⁻¹ᵁ U_φ).ι
    have : AlgebraicGeometry.IsOpenImmersion α_U2 := by
      dsimp [α_U2]; infer_instance
    have hα_φbar : α_U2 ≫ φ_bar.left = U_2.ι ≫ U_1.ι ≫ U_in.ι := by
      calc α_U2 ≫ φ_bar.left
          = U_2.ι ≫ ι_U1_Uφ ≫ CategoryTheory.inv (φ_bar.left ∣_ U_φ) ≫
              ((φ_bar.left ⁻¹ᵁ U_φ).ι ≫ φ_bar.left) := by
              dsimp [α_U2]; simp only [CategoryTheory.Category.assoc]
        _ = U_2.ι ≫ ι_U1_Uφ ≫ CategoryTheory.inv (φ_bar.left ∣_ U_φ) ≫
              (φ_bar.left ∣_ U_φ) ≫ U_φ.ι := by
              rw [AlgebraicGeometry.morphismRestrict_ι φ_bar.left U_φ]
        _ = U_2.ι ≫ (ι_U1_Uφ ≫ U_φ.ι) := by
              rw [← CategoryTheory.Category.assoc (CategoryTheory.inv (φ_bar.left ∣_ U_φ)),
                CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = U_2.ι ≫ U_1.ι ≫ U_in.ι := by
              rw [hι_U1_Uφ]
    have hα_πbar : α_U2 ≫ π_bar.left = U_2.ι ≫ g_base := by
      calc α_U2 ≫ π_bar.left
          = U_2.ι ≫ ι_U1_Uφ ≫
              (CategoryTheory.inv (φ_bar.left ∣_ U_φ) ≫ (φ_bar.left ⁻¹ᵁ U_φ).ι ≫ π_bar.left) := by
              dsimp [α_U2]; simp only [CategoryTheory.Category.assoc]
        _ = U_2.ι ≫ g_base := by
              rw [hOpenId]

    have hRange_α_eq :
        Set.range α_U2.base = Set.range (U_open.ι ≫ O_V₀.ι).base := by
      ext y
      constructor
      · rintro ⟨u₂, rfl⟩
        have hy_OV₀ : α_U2.base u₂ ∈ O_V₀ := by
          change (α_U2 ≫ π_bar.left).base u₂ ∈ V₀
          rw [hα_πbar]
          exact u₂.2
        let w : ↥O_V₀.toScheme := ⟨α_U2.base u₂, hy_OV₀⟩
        have hw_Uopen : w ∈ U_open := by
          change w ∉ Set.range ι_tot.base
          rw [hRange_tot, hRange_ι₁V₀, hRange_ι₂V₀]
          rintro (hw_Z₁ | hw_E)
          · obtain ⟨z, hz⟩ := hw_Z₁
            have hx_div : φ_bar.left.base (α_U2.base u₂) ∈ Set.range ι_div.base := by
              refine ⟨z, ?_⟩
              calc ι_div.base z
                  = (ιZ₁ ≫ φ_bar.left).base z := by rw [hιZ₁_φbar]
                _ = φ_bar.left.base (ιZ₁.base z) := rfl
                _ = φ_bar.left.base (α_U2.base u₂) := by rw [hz]
            have hx_Uin : φ_bar.left.base (α_U2.base u₂) ∈ (U_in : Set ↥V_norm.left) := by
              change (α_U2 ≫ φ_bar.left).base u₂ ∈ (U_in : Set ↥V_norm.left)
              rw [hα_φbar, ← U_in.range_ι]
              exact ⟨U_1.ι.base (U_2.ι.base u₂), rfl⟩
            have hx_not_Uin : φ_bar.left.base (α_U2.base u₂) ∈ (U_in : Set ↥V_norm.left)ᶜ := by
              rw [hZ_decomp]
              exact Or.inl hx_div
            exact hx_not_Uin hx_Uin
          · rw [hRange_E] at hw_E
            apply hw_E
            change α_U2.base u₂ ∈ ((φ_bar.left ⁻¹ᵁ U_φ : Y_bar.left.Opens) : Set ↥Y_bar.left)
            rw [← (φ_bar.left ⁻¹ᵁ U_φ).range_ι]
            exact ⟨(CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base
              (ι_U1_Uφ.base (U_2.ι.base u₂)), rfl⟩
        refine ⟨⟨w, hw_Uopen⟩, ?_⟩
        rfl
      · rintro ⟨⟨w, hw_Uopen⟩, rfl⟩
        have hw_not_tot : w ∉ Set.range ι_tot.base := hw_Uopen
        rw [hRange_tot, hRange_ι₁V₀, hRange_ι₂V₀] at hw_not_tot
        have hw_not_Z₁ : w.1 ∉ Set.range ιZ₁.base := fun h => hw_not_tot (Or.inl h)
        have hw_not_E : w.1 ∉ Set.range ι_E.base := fun h => hw_not_tot (Or.inr h)
        rw [hRange_E, Set.mem_compl_iff, Classical.not_not] at hw_not_E
        let v₀ : ↥(φ_bar.left ⁻¹ᵁ U_φ).toScheme := ⟨w.1, hw_not_E⟩
        let x_Uφ : ↥U_φ.toScheme := (φ_bar.left ∣_ U_φ).base v₀
        have h_inv_x : (CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base x_Uφ = v₀ := by
          change ((φ_bar.left ∣_ U_φ) ≫ CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base v₀ = v₀
          rw [CategoryTheory.IsIso.hom_inv_id]
          rfl
        have hx_val : x_Uφ.1 = φ_bar.left.base w.1 := by
          have hι : U_φ.ι.base x_Uφ = φ_bar.left.base w.1 := by
            change ((φ_bar.left ∣_ U_φ) ≫ U_φ.ι).base v₀ = φ_bar.left.base w.1
            rw [AlgebraicGeometry.morphismRestrict_ι φ_bar.left U_φ]
            rfl
          rwa [AlgebraicGeometry.Scheme.Opens.ι_apply U_φ x_Uφ] at hι
        have hx_b : ((π.left ∣_ U_proj) ≫ pr_p₀).base x_Uφ = π_bar.left.base w.1 := by
          rw [← hOpenId]
          change π_bar.left.base ((φ_bar.left ⁻¹ᵁ U_φ).ι.base
            ((CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base x_Uφ)) = π_bar.left.base w.1
          rw [h_inv_x]
          rfl
        have hx_V₀ : ((π.left ∣_ U_proj) ≫ pr_p₀).base x_Uφ ∈ V₀ := by
          rw [hx_b]
          exact w.2
        have hx_Dbase : pr_p₀.base ((π.left ∣_ U_proj).base x_Uφ) ∈ D_base :=
          hV₀_le_Dbase hx_V₀
        have hx_Damb : x_Uφ.1 ∈ π.left ⁻¹ᵁ D_amb := by
          have h1 := (hPr_last_iff ((π.left ∣_ U_proj).base x_Uφ)).mp hx_Dbase
          have hι1 : U_proj.ι.base ((π.left ∣_ U_proj).base x_Uφ) =
              π.left.base (U_φ.ι.base x_Uφ) := by
            change ((π.left ∣_ U_proj) ≫ U_proj.ι).base x_Uφ = (U_φ.ι ≫ π.left).base x_Uφ
            rw [AlgebraicGeometry.morphismRestrict_ι π.left U_proj]
          have hι2 : U_proj.ι.base ((π.left ∣_ U_proj).base x_Uφ) =
              ((π.left ∣_ U_proj).base x_Uφ).1 :=
            AlgebraicGeometry.Scheme.Opens.ι_apply U_proj ((π.left ∣_ U_proj).base x_Uφ)
          have hι3 : U_φ.ι.base x_Uφ = x_Uφ.1 :=
            AlgebraicGeometry.Scheme.Opens.ι_apply U_φ x_Uφ
          have hπ_val : ((π.left ∣_ U_proj).base x_Uφ).1 = π.left.base x_Uφ.1 :=
            hι2.symm.trans (hι1.trans (congrArg π.left.base hι3))
          change π.left.base x_Uφ.1 ∈ D_amb
          rwa [← hπ_val]
        have hx_not_div : x_Uφ.1 ∉ Set.range ι_div.base := by
          rintro ⟨z, hz⟩
          apply hw_not_Z₁
          refine ⟨z, ?_⟩
          have hj_eq : j_div.base z = x_Uφ := by
            apply U_φ.ι.isOpenEmbedding.injective
            change (j_div ≫ U_φ.ι).base z = U_φ.ι.base x_Uφ
            rw [hj_div_ι, hz]
            exact (AlgebraicGeometry.Scheme.Opens.ι_apply U_φ x_Uφ).symm
          change (φ_bar.left ⁻¹ᵁ U_φ).ι.base
            ((CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base (j_div.base z)) = w.1
          rw [hj_eq, h_inv_x]
          rfl
        have hx_not_low : x_Uφ.1 ∉ Z_low := by
          intro hlow
          rw [hx_val] at hlow
          exact (hV₀_le_U₀ w.2) (Or.inr ⟨w.1, hlow, rfl⟩)
        have hx_Uin : x_Uφ.1 ∈ U_in := by
          by_contra hx_not_in
          have hmem : x_Uφ.1 ∈ (U_in : Set ↥V_norm.left)ᶜ := hx_not_in
          rw [hZ_decomp] at hmem
          rcases hmem with h1 | h2
          · exact hx_not_div h1
          · exact hx_not_low h2
        let u_in : ↥U_in.toScheme := ⟨x_Uφ.1, hx_Uin⟩
        let u_1 : ↥U_1.toScheme := ⟨u_in, hx_Damb⟩
        have hu1_Uφ : ι_U1_Uφ.base u_1 = x_Uφ := by
          apply U_φ.ι.isOpenEmbedding.injective
          change (ι_U1_Uφ ≫ U_φ.ι).base u_1 = U_φ.ι.base x_Uφ
          rw [hι_U1_Uφ]
          rfl
        have hu1_V₀ : g_base.base u_1 ∈ V₀ := by
          change ((π.left ∣_ U_proj) ≫ pr_p₀).base (ι_U1_Uφ.base u_1) ∈ V₀
          rw [hu1_Uφ]
          exact hx_V₀
        let u_2 : ↥U_2.toScheme := ⟨u_1, hu1_V₀⟩
        refine ⟨u_2, ?_⟩
        change (φ_bar.left ⁻¹ᵁ U_φ).ι.base
          ((CategoryTheory.inv (φ_bar.left ∣_ U_φ)).base (ι_U1_Uφ.base u_1)) = w.1
        rw [hu1_Uφ, h_inv_x]
        rfl

    obtain ⟨e_U2, he_U2_hom, he_U2_inv⟩ :=
      hIsoOfOpenRangeEq α_U2 (U_open.ι ≫ O_V₀.ι) hRange_α_eq
    have hAff_Uopen : AlgebraicGeometry.IsAffineOpen U_open :=
      AlgebraicGeometry.IsAffine.of_isIso e_U2.inv

    let j_U : U_open.toScheme ⟶ W₀ := e_U2.inv ≫ U_2.ι ≫ U_1.ι ≫ j_in
    have : AlgebraicGeometry.Etale j_in := hEt_jin
    have hEt_jU : AlgebraicGeometry.Etale j_U := by
      dsimp [j_U]; infer_instance
    have hComp_jU : j_U ≫ p_W₀ = U_open.ι ≫ O_V₀.ι ≫ Y_bar.hom := by
      calc j_U ≫ p_W₀
          = e_U2.inv ≫ U_2.ι ≫ U_1.ι ≫ (j_in ≫ p_W₀) := by
              dsimp [j_U, p_W₀]; simp only [CategoryTheory.Category.assoc]
        _ = e_U2.inv ≫ (U_2.ι ≫ U_1.ι ≫ U_in.ι) ≫ V_norm.hom := by
              rw [hComp_jin]; simp only [CategoryTheory.Category.assoc]
        _ = e_U2.inv ≫ (α_U2 ≫ φ_bar.left) ≫ V_norm.hom := by
              rw [← hα_φbar]
        _ = (e_U2.inv ≫ α_U2) ≫ Y_bar.hom := by
              simp only [CategoryTheory.Category.assoc]; rfl
        _ = U_open.ι ≫ O_V₀.ι ≫ Y_bar.hom := by
              rw [he_U2_inv, CategoryTheory.Category.assoc]

    
    let x_1 : ↥U_1.toScheme := ⟨⟨x_norm, hx_in⟩, hx_amb⟩
    have hx1_Uφ : ι_U1_Uφ.base x_1 = ⟨x_norm, hx_proj⟩ := by
      apply U_φ.ι.isOpenEmbedding.injective
      change (ι_U1_Uφ ≫ U_φ.ι).base x_1 = x_norm
      rw [hι_U1_Uφ]
      rfl
    have hx1_b : g_base.base x_1 = b_star := by
      change ((π.left ∣_ U_proj) ≫ pr_p₀).base (ι_U1_Uφ.base x_1) = b_star
      rw [hx1_Uφ]
      exact hx_bstar
    have hx1_V₀ : g_base.base x_1 ∈ V₀ := by
      rw [hx1_b]; exact hb_V₀
    let x_2 : ↥U_2.toScheme := ⟨x_1, hx1_V₀⟩
    let x_U : ↥U_open.toScheme := e_U2.hom.base x_2

    have hx_U_inv : e_U2.inv.base x_U = x_2 := by
      change (e_U2.hom ≫ e_U2.inv).base x_2 = x_2
      rw [e_U2.hom_inv_id]
      rfl
    have hx_U_map : j_U.base x_U = x₀ := by
      change j_in.base (U_1.ι.base (U_2.ι.base (e_U2.inv.base x_U))) = x₀
      rw [hx_U_inv]
      exact hx_jin
    have hx_U_cl : IsClosed ({x_U} : Set ↥U_open.toScheme) := by
      let j_to_Vn : U_open.toScheme ⟶ V_norm.left := e_U2.inv ≫ U_2.ι ≫ U_1.ι ≫ U_in.ι
      have : AlgebraicGeometry.IsOpenImmersion j_to_Vn := by
        dsimp [j_to_Vn]; infer_instance
      have hpre : ({x_U} : Set ↥U_open.toScheme) =
          j_to_Vn.base ⁻¹' ({x_norm} : Set ↥V_norm.left) := by
        ext z
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl
          change U_in.ι.base (U_1.ι.base (U_2.ι.base (e_U2.inv.base x_U))) = x_norm
          rw [hx_U_inv]
          rfl
        · intro hz
          apply j_to_Vn.isOpenEmbedding.injective
          refine hz.trans ?_
          change x_norm = U_in.ι.base (U_1.ι.base (U_2.ι.base (e_U2.inv.base x_U)))
          rw [hx_U_inv]
          rfl
      rw [hpre]
      exact hx_norm_cl.preimage j_to_Vn.continuous
    have hx_U_fib : (π_bar.left ∣_ V₀).base (U_open.ι.base x_U) = b₀ := by
      apply V₀.ι.isOpenEmbedding.injective
      change (U_open.ι ≫ (π_bar.left ∣_ V₀) ≫ V₀.ι).base x_U = b_star
      rw [AlgebraicGeometry.morphismRestrict_ι π_bar.left V₀, ← CategoryTheory.Category.assoc]
      change ((e_U2.hom ≫ (U_open.ι ≫ O_V₀.ι)) ≫ π_bar.left).base x_2 = b_star
      rw [he_U2_hom, hα_πbar]
      exact hx1_b

    exact weil_algClosed_etale_boundary_split_elementary_fibration
      k δ W₀ p_W₀ x₀ Y_bar B₀ π_bar V₀ u_V₀ b₀ Z_tot ι_tot U_open j_U x_U
      ⟨hProp_Ybar, hProjYbar, hProp_B₀, hProp_πbar⟩
      ⟨hAff_V₀, hEt_uV₀, hComp_uV₀, hb₀_cl⟩
      hSm_V₀ hConn_V₀
      ⟨hCl_tot, hFin_tot, hEt_tot, hSurj_tot⟩
      ⟨rfl, hAff_Uopen⟩
      ⟨hEt_jU, hComp_jU, hx_U_map, hx_U_cl, hx_U_fib⟩

theorem weil_etale_local_freeYoneda_mod_to_torsion_ext_iso (S : AlgebraicGeometry.Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ θ_loc : ∀ (W : S.Etale) (q : ℕ),
        weilCupPDLocalModH S ℓ W q →+ weilEtaleLocalTorsionH S ℓ W q,
      (∀ (W : S.Etale) (q : ℕ), Function.Bijective (θ_loc W q)) ∧
      (∀ {W₁ W₂ : S.Etale} (v : Quiver.Hom W₁ W₂) (q : ℕ)
          (z : weilCupPDLocalModH S ℓ W₁ q),
        θ_loc W₂ q
          (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S ℓ v))
            (Nat.add_zero q)) =
          weilEtaleLocalTorsionMapH S ℓ v q (θ_loc W₁ q z)) :=
by
  have hPrime : Nat.Prime ℓ := Fact.out
  have hℓ_ne : ℓ ≠ 0 := hPrime.ne_zero
  have : NeZero ℓ := ⟨hℓ_ne⟩

  
  have hCoprodMono : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C]
      [Limits.HasCoproducts.{u} C] [AB4OfSize.{u, u + 1, u + 1} C]
      (Idx : Type u) (F : Idx → C) (n : ℕ),
      (∀ p : Idx, Mono (n • 𝟙 (F p))) → Mono (n • 𝟙 (Limits.sigmaObj F)) := by
    intro C _ _ _ _ Idx F n hMono
    let D : Discrete Idx ⥤ C := Discrete.functor F
    let φ : D ⟶ D := Discrete.natTrans (fun j => n • 𝟙 (F j.as))
    have : ∀ j : Discrete Idx, Mono (φ.app j) := fun j => hMono j.as
    have : Mono φ := NatTrans.mono_of_mono_app φ
    have : HasExactColimitsOfShape (Discrete Idx) C := AB4OfSize.ofShape Idx
    exact Limits.colim.map_mono' φ (Limits.colimit.isColimit D)
      (Limits.colimit.isColimit D) (n • 𝟙 (Limits.sigmaObj F)) (fun j => by
        dsimp only [D, φ, Discrete.functor_obj_eq_as, Discrete.natTrans_app]
        change Limits.colimit.ι D j ≫ (n • 𝟙 (Limits.colimit D)) =
          (n • 𝟙 (F j.as)) ≫ Limits.colimit.ι D j
        rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])

  have hGrothCover : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C]
      [IsGrothendieckAbelian.{u} C]
      (I : Type u) (G : I → C),
      (∀ {E₁ E₂ : C} (f₁ f₂ : E₁ ⟶ E₂),
        (∀ (x : I) (h : G x ⟶ E₁), h ≫ f₁ = h ≫ f₂) → f₁ = f₂) →
      (∀ (x : I) (n : ℕ), n ≠ 0 → Mono (n • 𝟙 (G x))) →
      ∀ E : C, ∃ (P : C) (π : P ⟶ E), Epi π ∧ ∀ (n : ℕ), n ≠ 0 → Mono (n • 𝟙 P) := by
    intro C _ _ _ I G hSep hTF_G E
    have : LocallySmall.{u} C := IsGrothendieckAbelian.locallySmall
    have : Limits.HasColimitsOfSize.{0, u} C :=
      let _ : Limits.HasColimitsOfSize.{u, u} C := IsGrothendieckAbelian.hasColimits C
      Limits.hasColimitsOfSizeShrink.{0, u, u, u} C
    have : Limits.HasCoproducts.{u} C := inferInstance
    let Idx : Type u := Σ x : I, Shrink.{u} (G x ⟶ E)
    let P : C := Limits.sigmaObj (fun p : Idx => G p.1)
    let π : P ⟶ E := Limits.Sigma.desc (fun p : Idx => (equivShrink (G p.1 ⟶ E)).symm p.2)
    have hEpi : Epi π := ⟨fun {Z} k₁ k₂ hk => hSep k₁ k₂ (fun x h => by
      let p : Idx := ⟨x, equivShrink (G x ⟶ E) h⟩
      have hp := congrArg (Limits.Sigma.ι (fun q : Idx => G q.1) p ≫ ·) hk
      dsimp only [P, π] at hp
      rw [← Category.assoc, Limits.Sigma.ι_comp_desc, ← Category.assoc, Limits.Sigma.ι_comp_desc,
        Equiv.symm_apply_apply] at hp
      exact hp)⟩
    exact ⟨P, π, hEpi, fun n hn => hCoprodMono Idx (fun p => G p.1) n (fun p => hTF_G p.1 n hn)⟩

  
  have hSnakeExt : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C]
      (m : ℕ) (Z₀ : C),
      m • 𝟙 Z₀ = 0 →
      (∀ {B₁ B₂ : C} (j : B₁ ⟶ B₂) [Mono j],
        m • 𝟙 B₁ = 0 → m • 𝟙 B₂ = 0 → ∀ g₀ : B₁ ⟶ Z₀, ∃ h : B₂ ⟶ Z₀, j ≫ h = g₀) →
      ∀ {S_ex : ShortComplex C}, S_ex.ShortExact → Mono (m • 𝟙 S_ex.X₃) →
        ∀ g₀ : S_ex.X₁ ⟶ Z₀, ∃ h : S_ex.X₂ ⟶ Z₀, S_ex.f ≫ h = g₀ := by
    intro C _ _ m Z₀ hZ₀_tors hZ₀_ext S_ex hS_ex hMono_m g₀
    let μ₁ : S_ex.X₁ ⟶ S_ex.X₁ := m • 𝟙 S_ex.X₁
    let μ₂ : S_ex.X₂ ⟶ S_ex.X₂ := m • 𝟙 S_ex.X₂
    let μ₃ : S_ex.X₃ ⟶ S_ex.X₃ := m • 𝟙 S_ex.X₃
    let c₁ : C := Limits.cokernel μ₁
    let c₂ : C := Limits.cokernel μ₂
    let π₁ : S_ex.X₁ ⟶ c₁ := Limits.cokernel.π μ₁
    let π₂ : S_ex.X₂ ⟶ c₂ := Limits.cokernel.π μ₂
    have hcomm_f : μ₁ ≫ S_ex.f = S_ex.f ≫ μ₂ := by
      dsimp [μ₁, μ₂]
      rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
    have hcomm_g : μ₂ ≫ S_ex.g = S_ex.g ≫ μ₃ := by
      dsimp [μ₂, μ₃]
      rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
    have hdesc_f : μ₁ ≫ (S_ex.f ≫ π₂) = 0 := by
      rw [← Category.assoc, hcomm_f, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let f_bar : c₁ ⟶ c₂ := Limits.cokernel.desc μ₁ (S_ex.f ≫ π₂) hdesc_f
    have hf_bar : π₁ ≫ f_bar = S_ex.f ≫ π₂ := Limits.cokernel.π_desc _ _ _
    have hm_c₁ : m • 𝟙 c₁ = 0 := by
      rw [← cancel_epi π₁, Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
        ← Category.id_comp π₁, ← Preadditive.nsmul_comp]
      exact Limits.cokernel.condition μ₁
    have hm_c₂ : m • 𝟙 c₂ = 0 := by
      rw [← cancel_epi π₂, Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero,
        ← Category.id_comp π₂, ← Preadditive.nsmul_comp]
      exact Limits.cokernel.condition μ₂
    have : Mono f_bar := by
      apply Abelian.Pseudoelement.mono_of_zero_of_map_zero
      intro x hx
      obtain ⟨a, rfl⟩ := Abelian.Pseudoelement.pseudo_surjective_of_epi π₁ x
      have hπ₂fa : Abelian.Pseudoelement.pseudoApply π₂
          (Abelian.Pseudoelement.pseudoApply S_ex.f a) = 0 := by
        rw [← Abelian.Pseudoelement.comp_apply, ← hf_bar, Abelian.Pseudoelement.comp_apply]
        exact hx
      obtain ⟨b, hb⟩ :=
        Abelian.Pseudoelement.pseudo_exact_of_exact (ShortComplex.exact_cokernel μ₂) _ hπ₂fa
      have hμ₃gb : Abelian.Pseudoelement.pseudoApply μ₃
          (Abelian.Pseudoelement.pseudoApply S_ex.g b) = 0 := by
        rw [← Abelian.Pseudoelement.comp_apply, ← hcomm_g, Abelian.Pseudoelement.comp_apply, hb,
          ← Abelian.Pseudoelement.comp_apply, S_ex.zero, Abelian.Pseudoelement.zero_apply]
      have : Mono μ₃ := hMono_m
      have hgb : Abelian.Pseudoelement.pseudoApply S_ex.g b = 0 :=
        Abelian.Pseudoelement.zero_of_map_zero μ₃
          (Abelian.Pseudoelement.pseudo_injective_of_mono μ₃) _ hμ₃gb
      obtain ⟨d, rfl⟩ := Abelian.Pseudoelement.pseudo_exact_of_exact hS_ex.exact b hgb
      have hf_eq : Abelian.Pseudoelement.pseudoApply S_ex.f
          (Abelian.Pseudoelement.pseudoApply μ₁ d) =
          Abelian.Pseudoelement.pseudoApply S_ex.f a := by
        rw [← Abelian.Pseudoelement.comp_apply, hcomm_f, Abelian.Pseudoelement.comp_apply]
        exact hb
      have : Mono S_ex.f := hS_ex.mono_f
      have hd_eq : Abelian.Pseudoelement.pseudoApply μ₁ d = a :=
        Abelian.Pseudoelement.pseudo_injective_of_mono S_ex.f hf_eq
      rw [← hd_eq, ← Abelian.Pseudoelement.comp_apply, Limits.cokernel.condition,
        Abelian.Pseudoelement.zero_apply]
    have hμ₁_g₀ : μ₁ ≫ g₀ = 0 := by
      dsimp [μ₁]
      rw [Preadditive.nsmul_comp, Category.id_comp, ← Category.comp_id g₀,
        ← Preadditive.comp_nsmul, hZ₀_tors, Limits.comp_zero]
    let g₀_bar : c₁ ⟶ Z₀ := Limits.cokernel.desc μ₁ g₀ hμ₁_g₀
    have hg₀_bar : π₁ ≫ g₀_bar = g₀ := Limits.cokernel.π_desc _ _ _
    obtain ⟨h_bar, hh_bar⟩ := hZ₀_ext f_bar hm_c₁ hm_c₂ g₀_bar
    refine ⟨π₂ ≫ h_bar, ?_⟩
    rw [← Category.assoc, ← hf_bar, Category.assoc, hh_bar, hg₀_bar]

  
  have hAbstractEfface : ∀ {C : Type (u + 1)} [Category.{u + 1, u + 1} C] [Abelian C]
      [HasExt.{u} C] [EnoughInjectives C]
      (TF : C → Prop),
      (∀ {K' P : C} (ι : K' ⟶ P) [Mono ι], TF P → TF K') →
      (∀ E : C, ∃ (P : C) (π : P ⟶ E), Epi π ∧ TF P) →
      ∀ (Z₀ : C),
        (∀ {S_ex : ShortComplex C}, S_ex.ShortExact → TF S_ex.X₃ →
          ∀ g₀ : S_ex.X₁ ⟶ Z₀, ∃ h : S_ex.X₂ ⟶ Z₀, S_ex.f ≫ h = g₀) →
        ∀ (q : ℕ) (K : C), TF K → ∀ ω : Abelian.Ext.{u} K Z₀ (q + 1), ω = 0 := by
    intro C _ _ _ _ TF hTF_sub hCoverTF Z₀ hExtZ₀
    have hKernelShortExact : ∀ {P E : C} (π : P ⟶ E) [Epi π],
        (ShortComplex.mk (Limits.kernel.ι π) π (Limits.kernel.condition π)).ShortExact := by
      intro P E π _
      exact { exact := ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel π) }
    have hCokernelShortExact : ∀ {Z I : C} (i : Z ⟶ I) [Mono i],
        (ShortComplex.mk i (Limits.cokernel.π i) (Limits.cokernel.condition i)).ShortExact := by
      intro Z I i _
      exact { exact := ShortComplex.exact_cokernel i }
    have hExt1AsShortExact : ∀ (Z K : C) (ω : Abelian.Ext.{u} K Z 1),
        ∃ (Q : C) (j : Z ⟶ Q) (π_K : Q ⟶ K) (h0 : j ≫ π_K = 0)
          (hS : (ShortComplex.mk j π_K h0).ShortExact),
          hS.extClass = ω := by
      intro Z K ω
      let I : C := Injective.under Z
      let i : Z ⟶ I := Injective.ι Z
      let p : I ⟶ Limits.cokernel i := Limits.cokernel.π i
      let S_Z := ShortComplex.mk i p (Limits.cokernel.condition i)
      have hS_Z : S_Z.ShortExact := hCokernelShortExact i
      have : Injective S_Z.X₂ := by dsimp [S_Z, I]; infer_instance
      have hω_I : ω.comp (Abelian.Ext.mk₀ S_Z.f) (Nat.add_zero 1) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨u₀, hu₀⟩ := Abelian.Ext.covariant_sequence_exact₁ K hS_Z ω hω_I (Nat.zero_add 1)
      obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective K S_Z.X₃).2 u₀
      let Q : C := Limits.pullback p φ
      let π_I : Q ⟶ I := Limits.pullback.fst p φ
      let π_K : Q ⟶ K := Limits.pullback.snd p φ
      have hj_cond : i ≫ p = (0 : Z ⟶ K) ≫ φ := by
        rw [Limits.cokernel.condition, Limits.zero_comp]
      let j : Z ⟶ Q := Limits.pullback.lift i 0 hj_cond
      have hj_I : j ≫ π_I = i := Limits.pullback.lift_fst i 0 hj_cond
      have hj_K : j ≫ π_K = 0 := Limits.pullback.lift_snd i 0 hj_cond
      have : Mono (j ≫ π_I) := by rw [hj_I]; infer_instance
      have : Mono j := mono_of_mono j π_I
      have : Epi π_K := Abelian.epi_pullback_of_epi_f p φ
      let S_pb := ShortComplex.mk j π_K hj_K
      have hKer_j : Limits.IsLimit (Limits.KernelFork.ofι j hj_K) := by
        refine Limits.KernelFork.IsLimit.ofι _ _
          (fun {W} w hw => hS_Z.fIsKernel.lift (Limits.KernelFork.ofι (w ≫ π_I) (by
            dsimp [S_Z]
            rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hw, Limits.zero_comp])))
          (fun {W} w hw => by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, hj_I]
              exact hS_Z.fIsKernel.fac _ Limits.WalkingParallelPair.zero
            · rw [Category.assoc, hj_K, Limits.comp_zero, hw])
          (fun {W} w hw m hm => by
            let l : W ⟶ Z := hS_Z.fIsKernel.lift (Limits.KernelFork.ofι (w ≫ π_I) (by
              dsimp [S_Z]
              rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hw,
                Limits.zero_comp]))
            have hl : l ≫ j = w := by
              apply Limits.pullback.hom_ext
              · rw [Category.assoc, hj_I]
                exact hS_Z.fIsKernel.fac _ Limits.WalkingParallelPair.zero
              · rw [Category.assoc, hj_K, Limits.comp_zero, hw]
            exact (cancel_mono j).mp (hm.trans hl.symm))
      have hS_pb : S_pb.ShortExact :=
        { exact := ShortComplex.exact_of_f_is_kernel S_pb hKer_j }
      let Φ : S_pb ⟶ S_Z :=
        { τ₁ := 𝟙 Z
          τ₂ := π_I
          τ₃ := φ
          comm₁₂ := by dsimp only [S_pb, S_Z]; rw [Category.id_comp]; exact hj_I.symm
          comm₂₃ := by dsimp only [S_pb, S_Z]; exact Limits.pullback.condition }
      have hnat := ShortComplex.ShortExact.extClass_naturality hS_pb hS_Z Φ
      dsimp only [Φ] at hnat
      rw [Abelian.Ext.comp_mk₀_id] at hnat
      exact ⟨Q, j, π_K, hj_K, hS_pb, hnat.trans hu₀⟩
    let Z_seq : ℕ → C :=
      @Nat.rec (fun _ => C) Z₀ (fun _ Z_cur => Limits.cokernel (Injective.ι Z_cur))
    have hDeg1 : ∀ (r : ℕ) (K : C), TF K → ∀ ω : Abelian.Ext.{u} K (Z_seq r) 1, ω = 0 := by
      intro r
      induction r with
      | zero =>
        intro K hTF_K ω
        obtain ⟨Q, j, π_K, h0, hS_pb, rfl⟩ := hExt1AsShortExact Z₀ K ω
        obtain ⟨h, hh⟩ := hExtZ₀ hS_pb hTF_K (𝟙 Z₀)
        have h1 : hS_pb.extClass =
            (hS_pb.extClass.comp (Abelian.Ext.mk₀ (ShortComplex.mk j π_K h0).f)
              (Nat.add_zero 1)).comp (Abelian.Ext.mk₀ h) (Nat.add_zero 1) := by
          calc
            hS_pb.extClass = hS_pb.extClass.comp (Abelian.Ext.mk₀ (𝟙 Z₀)) (Nat.add_zero 1) :=
              (Abelian.Ext.comp_mk₀_id _).symm
            _ = hS_pb.extClass.comp (Abelian.Ext.mk₀ ((ShortComplex.mk j π_K h0).f ≫ h))
                  (Nat.add_zero 1) := by rw [hh]
            _ = (hS_pb.extClass.comp (Abelian.Ext.mk₀ (ShortComplex.mk j π_K h0).f)
                  (Nat.add_zero 1)).comp (Abelian.Ext.mk₀ h) (Nat.add_zero 1) := by
              rw [← Abelian.Ext.mk₀_comp_mk₀,
                Abelian.Ext.comp_assoc hS_pb.extClass _ _ (Nat.add_zero 1) (Nat.add_zero 0)
                  (Nat.add_zero 1)]
        rw [h1, hS_pb.extClass_comp, Abelian.Ext.zero_comp]
      | succ r ih_r =>
        intro K hTF_K ω
        let Z_r : C := Z_seq r
        let I_r : C := Injective.under Z_r
        let i_r : Z_r ⟶ I_r := Injective.ι Z_r
        let p_r : I_r ⟶ Z_seq (r + 1) := Limits.cokernel.π i_r
        let S_r := ShortComplex.mk i_r p_r (Limits.cokernel.condition i_r)
        have : Mono i_r := inferInstance
        have hS_r : S_r.ShortExact := hCokernelShortExact i_r
        obtain ⟨Q, j, π_K, h0, hS_pb, rfl⟩ := hExt1AsShortExact (Z_seq (r + 1)) K ω
        obtain ⟨P, α, hEpi_α, hTF_P⟩ := hCoverTF Q
        have : Epi α := hEpi_α
        have : Epi π_K := hS_pb.epi_g
        let π : P ⟶ K := α ≫ π_K
        have : Epi π := epi_comp α π_K
        let K' : C := Limits.kernel π
        let ι : K' ⟶ P := Limits.kernel.ι π
        have hTF_K' : TF K' := hTF_sub ι hTF_P
        let S_top := ShortComplex.mk ι π (Limits.kernel.condition π)
        have hS_top : S_top.ShortExact := hKernelShortExact π
        have h_ια : (ι ≫ α) ≫ (ShortComplex.mk j π_K h0).g = 0 := by
          dsimp only
          rw [Category.assoc]
          exact Limits.kernel.condition π
        let β : K' ⟶ Z_seq (r + 1) :=
          hS_pb.fIsKernel.lift (Limits.KernelFork.ofι (ι ≫ α) h_ια)
        have hβ : β ≫ j = ι ≫ α :=
          hS_pb.fIsKernel.fac (Limits.KernelFork.ofι (ι ≫ α) h_ια) Limits.WalkingParallelPair.zero
        let Ψ : S_top ⟶ ShortComplex.mk j π_K h0 :=
          { τ₁ := β
            τ₂ := α
            τ₃ := 𝟙 K
            comm₁₂ := hβ
            comm₂₃ := (Category.comp_id π).symm }
        have hnat := ShortComplex.ShortExact.extClass_naturality hS_top hS_pb Ψ
        dsimp only [Ψ] at hnat
        rw [Abelian.Ext.mk₀_id_comp] at hnat
        have hβ_ext : (Abelian.Ext.mk₀ β).comp hS_r.extClass (Nat.zero_add 1) = 0 :=
          ih_r K' hTF_K' _
        obtain ⟨v₀, hv₀⟩ :=
          Abelian.Ext.covariant_sequence_exact₃ K' hS_r (Abelian.Ext.mk₀ β) (Nat.zero_add 1) hβ_ext
        have : Injective S_r.X₂ := by dsimp [S_r, I_r]; infer_instance
        have hv_I : hS_top.extClass.comp v₀ (Nat.add_zero 1) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        rw [← hnat, ← hv₀,
          ← Abelian.Ext.comp_assoc hS_top.extClass v₀ (Abelian.Ext.mk₀ S_r.g)
            (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1),
          hv_I, Abelian.Ext.zero_comp]
    have hAll : ∀ (q r : ℕ) (K : C), TF K → ∀ ω : Abelian.Ext.{u} K (Z_seq r) (q + 1), ω = 0 := by
      intro q
      induction q with
      | zero => exact hDeg1
      | succ q ih_q =>
        intro r K hTF_K ω
        let Z_r : C := Z_seq r
        let I_r : C := Injective.under Z_r
        let i_r : Z_r ⟶ I_r := Injective.ι Z_r
        let p_r : I_r ⟶ Z_seq (r + 1) := Limits.cokernel.π i_r
        let S_r := ShortComplex.mk i_r p_r (Limits.cokernel.condition i_r)
        have : Mono i_r := inferInstance
        have hS_r : S_r.ShortExact := hCokernelShortExact i_r
        have : Injective S_r.X₂ := by dsimp [S_r, I_r]; infer_instance
        have hω_I : ω.comp (Abelian.Ext.mk₀ S_r.f) (Nat.add_zero (q + 2)) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨u, rfl⟩ :=
          Abelian.Ext.covariant_sequence_exact₁ K hS_r ω hω_I (rfl : (q + 1) + 1 = q + 2)
        rw [ih_q (r + 1) K hTF_K u, Abelian.Ext.zero_comp]
    intro q K hTF_K ω
    exact hAll q 0 K hTF_K ω

  
  have hExactExtBij : ∀ {C₁ C₂ : Type (u + 1)}
      [Category.{u + 1, u + 1} C₁] [Abelian C₁] [HasExt.{u} C₁] [EnoughInjectives C₁]
      [Category.{u + 1, u + 1} C₂] [Abelian C₂] [HasExt.{u} C₂]
      (G : C₁ ⥤ C₂) [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (X₁ : C₁) (X₂ : C₂) (η : X₂ ⟶ G.obj X₁),
      (∀ Y : C₁, Function.Bijective (fun f : X₁ ⟶ Y => η ≫ G.map f)) →
      (∀ (ℐ : C₁) [Injective ℐ] (q : ℕ) (ω : Abelian.Ext.{u} X₂ (G.obj ℐ) (q + 1)), ω = 0) →
      ∀ (Y : C₁) (q : ℕ),
        Function.Bijective
          (((Abelian.Ext.mk₀ η).precomp (G.obj Y) (Nat.zero_add q)).comp
            (G.mapExtAddHom X₁ Y q)) := by
    intro C₁ C₂ _ _ _ _ _ _ _ G _ _ _ X₁ X₂ η hBij0 hVan Y q
    let GenMap : ∀ (W : C₁) (k : ℕ), Abelian.Ext.{u} X₁ W k →+ Abelian.Ext.{u} X₂ (G.obj W) k :=
      fun W k =>
        ((Abelian.Ext.mk₀ η).precomp (G.obj W) (Nat.zero_add k)).comp (G.mapExtAddHom X₁ W k)
    have hGen_apply : ∀ {W : C₁} {k : ℕ} (x : Abelian.Ext.{u} X₁ W k),
        GenMap W k x =
          (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor G x) (Nat.zero_add k) :=
      fun _ => rfl
    have hGen_post : ∀ {W₁ W₂ : C₁} (f : W₁ ⟶ W₂) (k : ℕ) (x : Abelian.Ext.{u} X₁ W₁ k),
        GenMap W₂ k (x.comp (Abelian.Ext.mk₀ f) (Nat.add_zero k)) =
          (GenMap W₁ k x).comp (Abelian.Ext.mk₀ (G.map f)) (Nat.add_zero k) := by
      intro W₁ W₂ f k x
      rw [hGen_apply, hGen_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) _ _ (Nat.zero_add k) (Nat.add_zero k)
          (Nat.zero_add k)]
    have hGen_delta : ∀ {S_mod : ShortComplex C₁} (hS : S_mod.ShortExact) (k : ℕ)
        (y : Abelian.Ext.{u} X₁ S_mod.X₃ k),
        GenMap S_mod.X₁ (k + 1) (y.comp hS.extClass rfl) =
          (GenMap S_mod.X₃ k y).comp (hS.map_of_exact G).extClass rfl := by
      intro S_mod hS k y
      rw [hGen_apply, hGen_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_extClass G hS,
        Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ η) _ _ (Nat.zero_add k) rfl (Nat.zero_add (k + 1))]
    have hInd : ∀ (k : ℕ) (W : C₁), Function.Bijective (GenMap W k) := by
      intro k
      induction k with
      | zero =>
        intro W
        have hcomm : ∀ f : X₁ ⟶ W,
            GenMap W 0 (Abelian.Ext.mk₀ f) = Abelian.Ext.mk₀ (η ≫ G.map f) := by
          intro f
          change (Abelian.Ext.mk₀ η).comp (Abelian.Ext.mapExactFunctor G (Abelian.Ext.mk₀ f))
            (Nat.zero_add 0) = Abelian.Ext.mk₀ (η ≫ G.map f)
          rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀]
        refine ⟨?_, ?_⟩
        · intro x₁ x₂ hx
          obtain ⟨f₁, rfl⟩ := (Abelian.Ext.mk₀_bijective X₁ W).2 x₁
          obtain ⟨f₂, rfl⟩ := (Abelian.Ext.mk₀_bijective X₁ W).2 x₂
          rw [hcomm, hcomm] at hx
          exact congrArg Abelian.Ext.mk₀
            ((hBij0 W).1 ((Abelian.Ext.mk₀_bijective X₂ (G.obj W)).1 hx))
        · intro z
          obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective X₂ (G.obj W)).2 z
          obtain ⟨f, rfl⟩ := (hBij0 W).2 g
          exact ⟨Abelian.Ext.mk₀ f, hcomm f⟩
      | succ k ih_k =>
        intro W
        let ℐ : C₁ := Injective.under W
        let i_W : W ⟶ ℐ := Injective.ι W
        let Q_W : C₁ := Limits.cokernel i_W
        let p_W : ℐ ⟶ Q_W := Limits.cokernel.π i_W
        let S_W := ShortComplex.mk i_W p_W (Limits.cokernel.condition i_W)
        have hS_W : S_W.ShortExact := { exact := ShortComplex.exact_cokernel i_W }
        let hSG_W := hS_W.map_of_exact G
        refine ⟨?_, ?_⟩
        · rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
          intro x hx
          rw [AddMonoidHom.mem_ker] at hx
          have hx_I : x.comp (Abelian.Ext.mk₀ S_W.f) (Nat.add_zero (k + 1)) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y, rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X₁ hS_W x hx_I rfl
          rw [hGen_delta hS_W k y] at hx
          obtain ⟨w', hw'⟩ :=
            Abelian.Ext.covariant_sequence_exact₃ X₂ hSG_W (GenMap Q_W k y) rfl hx
          obtain ⟨w, rfl⟩ := (ih_k ℐ).2 w'
          have hpost : GenMap Q_W k (w.comp (Abelian.Ext.mk₀ p_W) (Nat.add_zero k)) =
              GenMap Q_W k y := by
            rw [hGen_post p_W k w]
            exact hw'
          have hy_eq : w.comp (Abelian.Ext.mk₀ p_W) (Nat.add_zero k) = y := (ih_k Q_W).1 hpost
          rw [← hy_eq,
            Abelian.Ext.comp_assoc w (Abelian.Ext.mk₀ S_W.g) hS_W.extClass
              (Nat.add_zero k) (Nat.zero_add 1) rfl,
            hS_W.comp_extClass, Abelian.Ext.comp_zero]
          rfl
        · intro z
          have hz_I : z.comp (Abelian.Ext.mk₀ (S_W.map G).f) (Nat.add_zero (k + 1)) = 0 :=
            hVan ℐ k _
          obtain ⟨y', rfl⟩ := Abelian.Ext.covariant_sequence_exact₁ X₂ hSG_W z hz_I rfl
          obtain ⟨y, rfl⟩ := (ih_k Q_W).2 y'
          exact ⟨y.comp hS_W.extClass rfl, hGen_delta hS_W k y⟩
    exact hInd q Y

  
  let R : Type u := ULift.{u, 0} (ZMod ℓ)
  let J := S.smallEtaleTopology
  let R_mod : ModuleCat.{u, u} R := ModuleCat.of R R
  let FgtMod : ModuleCat.{u, u} R ⥤ AddCommGrpCat.{u} :=
    CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let Fℤ : Sheaf J AddCommGrpCat.{u} := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
  let oneR : Sheaf J (ModuleCat.{u, u} R) := weilCupPDModUnit S ℓ

  have hℓ_R : (ℓ : R) = 0 := ULift.ext _ _ (CharP.cast_eq_zero (ZMod ℓ) ℓ)
  have hr_nat : ∀ r : R, (r.down.val : R) = r :=
    fun r => ULift.ext _ _ (ZMod.natCast_zmod_val r.down)
  have hMod_tors : ∀ (M : ModuleCat.{u, u} R) (m : M), ℓ • m = 0 := by
    intro M m
    rw [← Nat.cast_smul_eq_nsmul R ℓ m, hℓ_R, zero_smul]
  have hMod_smul : ∀ (M : ModuleCat.{u, u} R) (r : R) (m : M), r • m = r.down.val • m := by
    intro M r m
    conv_lhs => rw [← hr_nat r]
    exact Nat.cast_smul_eq_nsmul R r.down.val m

  let mkRMod : ∀ (G : Type u) [AddCommGroup G], (∀ x : G, ℓ • x = 0) → ModuleCat.{u, u} R :=
    fun G _ hG =>
      letI : Module (ZMod ℓ) G := AddCommGroup.zmodModule hG
      letI : Module R G := Module.compHom G (ULift.ringEquiv : R ≃+* ZMod ℓ).toRingHom
      ModuleCat.of R G

  let mkRHom : ∀ {M₁ M₂ : ModuleCat.{u, u} R} (f : ↑M₁ →+ ↑M₂), (M₁ ⟶ M₂) :=
    fun {M₁ M₂} f => ModuleCat.ofHom
      { toAddHom := f.toAddHom
        map_smul' := fun r x => by
          change f (r • x) = r • f x
          rw [hMod_smul M₁ r x, hMod_smul M₂ r (f x), map_nsmul] }

  let multSub : ∀ A : AddCommGrpCat.{u}, AddSubgroup A :=
    fun A => (zsmulAddGroupHom (ℓ : ℤ) : A →+ A).range
  have hQuot_tors : ∀ (A : AddCommGrpCat.{u}) (q : A ⧸ multSub A), ℓ • q = 0 := by
    intro A q
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (multSub A) q
    rw [← map_nsmul]
    change QuotientAddGroup.mk (ℓ • a) = 0
    rw [QuotientAddGroup.eq_zero_iff]
    exact ⟨a, natCast_zsmul a ℓ⟩
  let L_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
    { obj := fun A => mkRMod (A ⧸ multSub A) (hQuot_tors A)
      map := fun {A B} f => mkRHom (QuotientAddGroup.map (multSub A) (multSub B) f.hom (by
        rintro _ ⟨a, rfl⟩
        exact ⟨f.hom a, by
          change (ℓ : ℤ) • f.hom a = f.hom ((ℓ : ℤ) • a)
          rw [map_zsmul]⟩))
      map_id := fun A => by
        apply ModuleCat.hom_ext; apply DFunLike.ext; intro q
        obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (multSub A) q
        rfl
      map_comp := fun {A B C} f g => by
        apply ModuleCat.hom_ext; apply DFunLike.ext; intro q
        obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (multSub A) q
        rfl }
  let eModL : ∀ (A : AddCommGrpCat.{u}) (M : ModuleCat.{u, u} R),
      (L_mod.obj A ⟶ M) ≃ (A ⟶ FgtMod.obj M) :=
    fun A M =>
      { toFun := fun ψ => AddCommGrpCat.ofHom
          (ψ.hom.toAddMonoidHom.comp (QuotientAddGroup.mk' (multSub A)))
        invFun := fun g => mkRHom (QuotientAddGroup.lift (multSub A) g.hom (by
          rintro _ ⟨a, rfl⟩
          change g.hom ((ℓ : ℤ) • a) = 0
          rw [natCast_zsmul, map_nsmul, hMod_tors M (g.hom a)]))
        left_inv := fun ψ => by
          apply ModuleCat.hom_ext; apply DFunLike.ext; intro q
          obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective (multSub A) q
          rfl
        right_inv := fun g => AddCommGrpCat.ext (fun _ => rfl) }

  let torsSub : ∀ A : AddCommGrpCat.{u}, AddSubgroup A :=
    fun A => (zsmulAddGroupHom (ℓ : ℤ) : A →+ A).ker
  have hTorsSub : ∀ (A : AddCommGrpCat.{u}) (x : ↥(torsSub A)), ℓ • x = 0 := by
    intro A x
    apply Subtype.ext
    have hx : (ℓ : ℤ) • x.1 = 0 := x.2
    rw [natCast_zsmul] at hx
    exact hx
  let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
    { obj := fun A => mkRMod ↥(torsSub A) (hTorsSub A)
      map := fun {A B} f => mkRHom
        { toFun := fun x => ⟨f.hom x.1, by
            change (ℓ : ℤ) • f.hom x.1 = 0
            rw [← map_zsmul]
            exact (congrArg f.hom x.2).trans (map_zero f.hom)⟩
          map_zero' := Subtype.ext (map_zero f.hom)
          map_add' := fun x y => Subtype.ext (map_add f.hom x.1 y.1) }
      map_id := fun _ => ModuleCat.hom_ext (DFunLike.ext _ _ fun _ => rfl)
      map_comp := fun _ _ => ModuleCat.hom_ext (DFunLike.ext _ _ fun _ => rfl) }
  let eModR : ∀ (M : ModuleCat.{u, u} R) (A : AddCommGrpCat.{u}),
      (FgtMod.obj M ⟶ A) ≃ (M ⟶ C_mod.obj A) :=
    fun M A =>
      { toFun := fun g => mkRHom
          { toFun := fun m => ⟨g.hom m, by
              change (ℓ : ℤ) • g.hom m = 0
              rw [natCast_zsmul, ← map_nsmul, hMod_tors M m, map_zero]⟩
            map_zero' := Subtype.ext (map_zero g.hom)
            map_add' := fun x y => Subtype.ext (map_add g.hom x y) }
        invFun := fun ψ => AddCommGrpCat.ofHom
          ((torsSub A).subtype.comp ψ.hom.toAddMonoidHom)
        left_inv := fun _ => AddCommGrpCat.ext (fun _ => rfl)
        right_inv := fun _ => ModuleCat.hom_ext (DFunLike.ext _ _ fun _ => rfl) }

  have hIsSheaf_U : ∀ ℱ : Sheaf J (ModuleCat.{u, u} R), Presheaf.IsSheaf J (ℱ.obj ⋙ FgtMod) := by
    intro ℱ B
    refine Presieve.isSheaf_iso J ?_ (ℱ.property (L_mod.obj B))
    exact NatIso.ofComponents
      (fun V => (eModL B (ℱ.obj.obj V)).toIso)
      (fun {V₁ V₂} u => by ext g; exact AddCommGrpCat.ext (fun _ => rfl))
  let U : Sheaf J (ModuleCat.{u, u} R) ⥤ Sheaf J AddCommGrpCat.{u} :=
    { obj := fun ℱ => ⟨ℱ.obj ⋙ FgtMod, hIsSheaf_U ℱ⟩
      map := fun f => { hom := Functor.whiskerRight f.hom FgtMod }
      map_id := fun _ => by apply Sheaf.hom_ext; ext V x; rfl
      map_comp := fun _ _ => by apply Sheaf.hom_ext; ext V x; rfl }

  have hIsSheaf_C : ∀ 𝒢 : Sheaf J AddCommGrpCat.{u}, Presheaf.IsSheaf J (𝒢.obj ⋙ C_mod) := by
    intro 𝒢 M
    refine Presieve.isSheaf_iso J ?_ (𝒢.property (FgtMod.obj M))
    exact NatIso.ofComponents
      (fun V => (eModR M (𝒢.obj.obj V)).toIso)
      (fun {V₁ V₂} u => by ext ψ; exact ModuleCat.hom_ext (DFunLike.ext _ _ fun _ => rfl))
  let C_sh : Sheaf J AddCommGrpCat.{u} ⥤ Sheaf J (ModuleCat.{u, u} R) :=
    { obj := fun 𝒢 => ⟨𝒢.obj ⋙ C_mod, hIsSheaf_C 𝒢⟩
      map := fun f => { hom := Functor.whiskerRight f.hom C_mod }
      map_id := fun _ => by apply Sheaf.hom_ext; ext V x; rfl
      map_comp := fun _ _ => by apply Sheaf.hom_ext; ext V x; rfl }

  let eShR : ∀ (ℱ : Sheaf J (ModuleCat.{u, u} R)) (𝒢 : Sheaf J AddCommGrpCat.{u}),
      (U.obj ℱ ⟶ 𝒢) ≃ (ℱ ⟶ C_sh.obj 𝒢) :=
    fun ℱ 𝒢 =>
      { toFun := fun φ =>
          { hom :=
              { app := fun V => eModR (ℱ.obj.obj V) (𝒢.obj.obj V) (φ.hom.app V)
                naturality := fun {V₁ V₂} u => by
                  apply ModuleCat.hom_ext; apply DFunLike.ext; intro m
                  apply Subtype.ext
                  exact congrArg (fun k : FgtMod.obj (ℱ.obj.obj V₁) ⟶ 𝒢.obj.obj V₂ => k.hom m)
                    (φ.hom.naturality u) } }
        invFun := fun ψ =>
          { hom :=
              { app := fun V => (eModR (ℱ.obj.obj V) (𝒢.obj.obj V)).symm (ψ.hom.app V)
                naturality := fun {V₁ V₂} u => by
                  apply AddCommGrpCat.ext; intro m
                  exact congrArg Subtype.val
                    (congrArg (fun k : ℱ.obj.obj V₁ ⟶ C_mod.obj (𝒢.obj.obj V₂) => k.hom m)
                      (ψ.hom.naturality u)) } }
        left_inv := fun _ => by apply Sheaf.hom_ext; ext V m; rfl
        right_inv := fun _ => by apply Sheaf.hom_ext; ext V m; rfl }

  let adj_UC : U ⊣ C_sh := Adjunction.mkOfHomEquiv
    { homEquiv := eShR
      homEquiv_naturality_left_symm := fun _ _ => by apply Sheaf.hom_ext; ext V m; rfl
      homEquiv_naturality_right := fun _ _ => by apply Sheaf.hom_ext; ext V m; rfl }

  let L_pre : (Opposite S.Etale ⥤ AddCommGrpCat.{u}) ⥤ (Opposite S.Etale ⥤ ModuleCat.{u, u} R) :=
    (Functor.whiskeringRight (Opposite S.Etale) AddCommGrpCat.{u} (ModuleCat.{u, u} R)).obj L_mod
  let L_sh : Sheaf J AddCommGrpCat.{u} ⥤ Sheaf J (ModuleCat.{u, u} R) :=
    sheafToPresheaf J AddCommGrpCat.{u} ⋙ L_pre ⋙ presheafToSheaf J (ModuleCat.{u, u} R)
  let adj_shR := sheafificationAdjunction J (ModuleCat.{u, u} R)
  let ePreL : ∀ (P : Opposite S.Etale ⥤ AddCommGrpCat.{u}) (Q : Opposite S.Etale ⥤ ModuleCat.{u, u} R),
      (L_pre.obj P ⟶ Q) ≃ (P ⟶ Q ⋙ FgtMod) :=
    fun P Q =>
      { toFun := fun α =>
          { app := fun V => eModL (P.obj V) (Q.obj V) (α.app V)
            naturality := fun {V₁ V₂} u => by
              apply AddCommGrpCat.ext; intro x
              exact congrArg (fun k : L_mod.obj (P.obj V₁) ⟶ Q.obj V₂ =>
                k.hom (QuotientAddGroup.mk' _ x)) (α.naturality u) }
        invFun := fun β =>
          { app := fun V => (eModL (P.obj V) (Q.obj V)).symm (β.app V)
            naturality := fun {V₁ V₂} u => by
              apply ModuleCat.hom_ext; apply DFunLike.ext; intro q
              obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective _ q
              exact congrArg (fun k : P.obj V₁ ⟶ FgtMod.obj (Q.obj V₂) => k.hom x)
                (β.naturality u) }
        left_inv := fun α =>
          NatTrans.ext (funext fun V => (eModL (P.obj V) (Q.obj V)).left_inv (α.app V))
        right_inv := fun β =>
          NatTrans.ext (funext fun V => (eModL (P.obj V) (Q.obj V)).right_inv (β.app V)) }
  let eShL : ∀ (𝒢 : Sheaf J AddCommGrpCat.{u}) (ℱ : Sheaf J (ModuleCat.{u, u} R)),
      (L_sh.obj 𝒢 ⟶ ℱ) ≃ (𝒢 ⟶ U.obj ℱ) :=
    fun 𝒢 ℱ =>
      (adj_shR.homEquiv (L_pre.obj 𝒢.obj) ℱ).trans
        ((ePreL 𝒢.obj ℱ.obj).trans
          { toFun := fun β => { hom := β }
            invFun := fun φ => φ.hom
            left_inv := fun _ => rfl
            right_inv := fun _ => rfl })
  let adj_LU : L_sh ⊣ U := Adjunction.mkOfHomEquiv
    { homEquiv := eShL
      homEquiv_naturality_left_symm := fun {𝒢' 𝒢 ℱ} h φ => by
        apply (eShL 𝒢' ℱ).injective
        rw [Equiv.apply_symm_apply]
        apply Sheaf.hom_ext
        have hnat := adj_shR.homEquiv_naturality_left (L_pre.map h.hom) ((eShL 𝒢 ℱ).symm φ)
        have hsymm : adj_shR.homEquiv (L_pre.obj 𝒢.obj) ℱ ((eShL 𝒢 ℱ).symm φ) =
            (ePreL 𝒢.obj ℱ.obj).symm φ.hom :=
          Equiv.apply_symm_apply _ _
        change h.hom ≫ φ.hom = ePreL 𝒢'.obj ℱ.obj
          (adj_shR.homEquiv (L_pre.obj 𝒢'.obj) ℱ
            ((presheafToSheaf J (ModuleCat.{u, u} R)).map (L_pre.map h.hom) ≫
              (eShL 𝒢 ℱ).symm φ))
        rw [hnat, hsymm]
        ext V x
        rfl
      homEquiv_naturality_right := fun {𝒢 ℱ ℱ'} ψ g => by
        apply Sheaf.hom_ext
        dsimp only [eShL, Equiv.trans_apply]
        have hnat := adj_shR.homEquiv_naturality_right ψ g
        ext V x
        exact congrArg (fun η : L_pre.obj 𝒢.obj ⟶ ℱ'.obj =>
          (η.app V).hom (QuotientAddGroup.mk' _ x)) hnat }

  have : Limits.PreservesColimitsOfSize.{0, 0} U := adj_UC.leftAdjoint_preservesColimits
  have hFinColimU : Limits.PreservesFiniteColimits U := inferInstance
  have : Limits.PreservesLimitsOfSize.{0, 0} U := adj_LU.rightAdjoint_preservesLimits
  have hFinLimU : Limits.PreservesFiniteLimits U := inferInstance
  have : Limits.PreservesBinaryBiproducts U :=
    Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts U
  have hAddU : U.Additive := Functor.additive_of_preservesBinaryBiproducts U
  have : Limits.PreservesLimitsOfSize.{0, 0} C_sh := adj_UC.rightAdjoint_preservesLimits
  have hFinLimC : Limits.PreservesFiniteLimits C_sh := inferInstance

  let T : S.Etale := weilEtaleIdTerminal.{u} S
  let hT : Limits.IsTerminal T := weilEtaleIdTerminalIsTerminal.{u} S
  let adjℤ := constantSheafAdj J AddCommGrpCat.{u} hT
  let adjR := constantSheafAdj J (ModuleCat.{u, u} R) hT
  let ιℤ : Aℤ ⟶ FgtMod.obj R_mod := AddCommGrpCat.ofHom
    { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod ℓ)
      map_zero' := congrArg ULift.up Int.cast_zero
      map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  let ηℤ : Fℤ ⟶ U.obj oneR :=
    (adjℤ.homEquiv Aℤ (U.obj oneR)).symm (ιℤ ≫ FgtMod.map (adjR.unit.app R_mod))

  have hBij0 : ∀ ℱ : Sheaf J (ModuleCat.{u, u} R),
      Function.Bijective (fun f : oneR ⟶ ℱ => ηℤ ≫ U.map f) := by
    intro ℱ
    let M_T : ModuleCat.{u, u} R := ℱ.obj.obj (Opposite.op T)
    let evR : (R_mod ⟶ M_T) ≃ ↑M_T :=
      { toFun := fun ψ => ψ.hom (1 : R)
        invFun := fun m => ModuleCat.ofHom
          { toFun := fun r => r • m
            map_add' := fun r₁ r₂ => add_smul r₁ r₂ m
            map_smul' := fun r₁ r₂ => mul_smul r₁ r₂ m }
        left_inv := fun ψ => by
          apply ModuleCat.hom_ext; apply LinearMap.ext; intro r
          change r • ψ.hom 1 = ψ.hom r
          rw [← ψ.hom.map_smul, smul_eq_mul, mul_one]
        right_inv := fun m => one_smul R m }
    let evZ : (Aℤ ⟶ FgtMod.obj M_T) ≃ ↑M_T :=
      { toFun := fun g => g.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun z => z.down • m
            map_zero' := zero_zsmul m
            map_add' := fun z₁ z₂ => add_zsmul m z₁.down z₂.down }
        left_inv := fun g => by
          apply AddCommGrpCat.ext; intro z
          have hz : z = z.down • ULift.up (1 : ℤ) := ULift.ext _ _ (mul_one z.down).symm
          change z.down • g.hom (ULift.up 1) = g.hom z
          conv_rhs => rw [hz]
          exact (map_zsmul g.hom z.down (ULift.up 1)).symm
        right_inv := fun m => one_zsmul m }
    let eDom : (oneR ⟶ ℱ) ≃ ↑M_T := (adjR.homEquiv R_mod ℱ).trans evR
    let eCod : (Fℤ ⟶ U.obj ℱ) ≃ ↑M_T := (adjℤ.homEquiv Aℤ (U.obj ℱ)).trans evZ
    have hEq : ∀ f : oneR ⟶ ℱ, eCod (ηℤ ≫ U.map f) = eDom f := by
      intro f
      dsimp only [eCod, eDom, Equiv.trans_apply]
      have hnat : adjℤ.homEquiv Aℤ (U.obj ℱ) (ηℤ ≫ U.map f) =
          ιℤ ≫ FgtMod.map (adjR.homEquiv R_mod ℱ f) := by
        rw [adjℤ.homEquiv_naturality_right ηℤ (U.map f)]
        have hη : adjℤ.homEquiv Aℤ (U.obj oneR) ηℤ = ιℤ ≫ FgtMod.map (adjR.unit.app R_mod) :=
          Equiv.apply_symm_apply _ _
        rw [hη, Category.assoc]
        change ιℤ ≫ (FgtMod.map (adjR.unit.app R_mod) ≫ FgtMod.map (f.hom.app (Opposite.op T))) = _
        rw [← FgtMod.map_comp]
        congr 2
      rw [hnat]
      dsimp only [evZ, evR, Equiv.coe_fn_mk]
      change (adjR.homEquiv R_mod ℱ f).hom (ιℤ.hom (ULift.up 1)) = (adjR.homEquiv R_mod ℱ f).hom 1
      have hι1 : ιℤ.hom (ULift.up 1) = (1 : R) := ULift.ext _ _ Int.cast_one
      rw [hι1]
    refine ⟨fun f₁ f₂ hf => eDom.injective (by rw [← hEq, ← hEq]; exact congrArg eCod hf),
      fun g => ?_⟩
    refine ⟨eDom.symm (eCod g), eCod.injective ?_⟩
    rw [hEq, Equiv.apply_symm_apply]

  have hTorsInj : ∀ (ℐ : Sheaf J (ModuleCat.{u, u} R)) [Injective ℐ],
      ℓ • 𝟙 (U.obj ℐ) = 0 ∧
      ∀ {B₁ B₂ : Sheaf J AddCommGrpCat.{u}} (j : B₁ ⟶ B₂) [Mono j],
        ℓ • 𝟙 B₁ = 0 → ℓ • 𝟙 B₂ = 0 →
        ∀ g₀ : B₁ ⟶ U.obj ℐ, ∃ h : B₂ ⟶ U.obj ℐ, j ≫ h = g₀ := by
    intro ℐ _
    have hℓ_ℐ : ℓ • 𝟙 ℐ = 0 := by
      apply Sheaf.hom_ext
      ext V x
      let EV : Sheaf J (ModuleCat.{u, u} R) ⥤ ModuleCat.{u, u} R :=
        sheafToPresheaf J (ModuleCat.{u, u} R) ⋙
          (evaluation (Opposite S.Etale) (ModuleCat.{u, u} R)).obj V
      change (EV.map (ℓ • 𝟙 ℐ)).hom x = 0
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      have h_app : ∀ n : ℕ, (n • 𝟙 (EV.obj ℐ)).hom x = n • x := by
        intro n; induction n with
        | zero => simp
        | succ n ih => rw [succ_nsmul, succ_nsmul, ModuleCat.hom_add, LinearMap.add_apply, ih]; rfl
      rw [h_app ℓ]
      exact hMod_tors (EV.obj ℐ) x
    have hℓ_Uℐ : ℓ • 𝟙 (U.obj ℐ) = 0 := by
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hℓ_ℐ, U.map_zero]
    refine ⟨hℓ_Uℐ, ?_⟩
    intro B₁ B₂ j _ hB₁ hB₂ g₀
    have hSecTors : ∀ {B : Sheaf J AddCommGrpCat.{u}}, ℓ • 𝟙 B = 0 →
        ∀ (V : Opposite S.Etale) (x : B.obj.obj V), (ℓ : ℤ) • x = 0 := by
      intro B hB V x
      rw [natCast_zsmul]
      let EV : Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        sheafToPresheaf J AddCommGrpCat.{u} ⋙
          (evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj V
      have happ : (EV.map (ℓ • 𝟙 B)).hom x = 0 := by rw [hB, EV.map_zero]; rfl
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id] at happ
      have h_n : ∀ (A : AddCommGrpCat.{u}) (n : ℕ) (y : A), (n • 𝟙 A).hom y = n • y := by
        intro A n y; induction n with
        | zero => simp
        | succ n ih =>
          rw [succ_nsmul, succ_nsmul]
          change (n • 𝟙 A).hom y + y = _
          rw [ih]
      rwa [h_n (EV.obj B) ℓ x] at happ
    let liftB : ∀ (B : Sheaf J AddCommGrpCat.{u}), ℓ • 𝟙 B = 0 → (B ⟶ U.obj (C_sh.obj B)) :=
      fun B hB =>
        { hom :=
            { app := fun V => AddCommGrpCat.ofHom
                { toFun := fun x => ⟨x, hSecTors hB V x⟩
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
              naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => rfl) } }
    let ε₁_inv := liftB B₁ hB₁
    let ε₂_inv := liftB B₂ hB₂
    have hj_lift : j ≫ ε₂_inv = ε₁_inv ≫ U.map (C_sh.map j) := by
      apply Sheaf.hom_ext; ext V x; rfl
    let η_ℐ_inv : C_sh.obj (U.obj ℐ) ⟶ ℐ :=
      { hom :=
          { app := fun V => mkRHom (torsSub ((U.obj ℐ).obj.obj V)).subtype
            naturality := fun _ _ _ => ModuleCat.hom_ext (DFunLike.ext _ _ fun _ => rfl) } }
    have hg₀_eq : ε₁_inv ≫ U.map (C_sh.map g₀ ≫ η_ℐ_inv) = g₀ := by
      apply Sheaf.hom_ext; ext V x; rfl
    have : Mono (C_sh.map j) := C_sh.map_mono j
    let h_tilde : C_sh.obj B₂ ⟶ ℐ := Injective.factorThru (C_sh.map g₀ ≫ η_ℐ_inv) (C_sh.map j)
    have hh_tilde : C_sh.map j ≫ h_tilde = C_sh.map g₀ ≫ η_ℐ_inv :=
      Injective.comp_factorThru (C_sh.map g₀ ≫ η_ℐ_inv) (C_sh.map j)
    refine ⟨ε₂_inv ≫ U.map h_tilde, ?_⟩
    rw [← Category.assoc, hj_lift, Category.assoc, ← U.map_comp, hh_tilde, hg₀_eq]

  have hEquivZ_comp : ∀ {W : S.Etale} {F G : Sheaf J AddCommGrpCat.{u}}
      (α : weilEtaleLocalTorsionSheaf S ℓ W ⟶ F) (g : F ⟶ G),
      Sheaf.freeYonedaHomEquiv (α ≫ g) =
        Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro W F G α g
    let α' : (presheafToSheaf J AddCommGrpCat.{u}).obj (Presheaf.freeYoneda W AM) ⟶ F := α
    calc
      Presheaf.freeYonedaHomEquiv
          (((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = Presheaf.freeYonedaHomEquiv
            (((sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (sheafToPresheaf J AddCommGrpCat.{u}).map g) := by
            rw [Adjunction.homEquiv_naturality_right]
      _ = Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            Presheaf.freeYonedaHomEquiv_comp _ _

  have hEquivR_comp : ∀ {W : S.Etale} {F G : Sheaf J (ModuleCat.{u, u} R)}
      (α : weilCupPDLocalFreeSheaf S ℓ W ⟶ F) (g : F ⟶ G),
      Sheaf.freeYonedaHomEquiv (α ≫ g) =
        Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro W F G α g
    let α' : (presheafToSheaf J (ModuleCat.{u, u} R)).obj (Presheaf.freeYoneda W R_mod) ⟶ F := α
    calc
      Presheaf.freeYonedaHomEquiv
          (((sheafificationAdjunction J (ModuleCat.{u, u} R)).homEquiv _ G) (α' ≫ g))
        = Presheaf.freeYonedaHomEquiv
            (((sheafificationAdjunction J (ModuleCat.{u, u} R)).homEquiv _ F) α' ≫
              (sheafToPresheaf J (ModuleCat.{u, u} R)).map g) := by
            rw [Adjunction.homEquiv_naturality_right]
      _ = Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            Presheaf.freeYonedaHomEquiv_comp _ _

  let ι_M : AM ⟶ FgtMod.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ι_M_inv : FgtMod.obj R_mod ⟶ AM := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let α_loc : ∀ W : S.Etale,
      weilEtaleLocalTorsionSheaf S ℓ W ⟶ U.obj (weilCupPDLocalFreeSheaf S ℓ W) :=
    fun W => Sheaf.freeYonedaHomEquiv.symm
      (ι_M ≫ FgtMod.map (Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W))))

  let ePrecompM : ∀ X : AddCommGrpCat.{u}, (FgtMod.obj R_mod ⟶ X) ≃ (AM ⟶ X) :=
    fun X =>
      { toFun := fun f => ι_M ≫ f
        invFun := fun g => ι_M_inv ≫ g
        left_inv := fun _ => AddCommGrpCat.ext (fun _ => rfl)
        right_inv := fun _ => AddCommGrpCat.ext (fun _ => rfl) }

  let eLoc : ∀ (W : S.Etale) (𝒢 : Sheaf J AddCommGrpCat.{u}),
      (U.obj (weilCupPDLocalFreeSheaf S ℓ W) ⟶ 𝒢) ≃ (weilEtaleLocalTorsionSheaf S ℓ W ⟶ 𝒢) :=
    fun W 𝒢 =>
      (eShR (weilCupPDLocalFreeSheaf S ℓ W) 𝒢).trans
        (Sheaf.freeYonedaHomEquiv.trans
          (((eModR R_mod (𝒢.obj.obj (Opposite.op W))).symm).trans
            ((ePrecompM (𝒢.obj.obj (Opposite.op W))).trans Sheaf.freeYonedaHomEquiv.symm)))

  have heLoc_eq : ∀ (W : S.Etale) (𝒢 : Sheaf J AddCommGrpCat.{u})
      (φ : U.obj (weilCupPDLocalFreeSheaf S ℓ W) ⟶ 𝒢),
      eLoc W 𝒢 φ = α_loc W ≫ φ := by
    intro W 𝒢 φ
    apply Sheaf.freeYonedaHomEquiv.injective
    rw [hEquivZ_comp (α_loc W) φ]
    have hα : Sheaf.freeYonedaHomEquiv (α_loc W) =
        ι_M ≫ FgtMod.map (Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W))) :=
      Equiv.apply_symm_apply _ _
    rw [hα]
    dsimp only [eLoc, ePrecompM, Equiv.trans_apply, Equiv.coe_fn_mk]
    rw [Equiv.apply_symm_apply]
    have hR : Sheaf.freeYonedaHomEquiv (eShR (weilCupPDLocalFreeSheaf S ℓ W) 𝒢 φ) =
        Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W)) ≫
          (eShR (weilCupPDLocalFreeSheaf S ℓ W) 𝒢 φ).hom.app (Opposite.op W) := by
      simpa using hEquivR_comp (𝟙 (weilCupPDLocalFreeSheaf S ℓ W))
        (eShR (weilCupPDLocalFreeSheaf S ℓ W) 𝒢 φ)
    rw [hR]
    apply AddCommGrpCat.ext; intro x
    rfl

  let β_loc : ∀ W : S.Etale,
      U.obj (weilCupPDLocalFreeSheaf S ℓ W) ⟶ weilEtaleLocalTorsionSheaf S ℓ W :=
    fun W => (eLoc W (weilEtaleLocalTorsionSheaf S ℓ W)).symm
      (𝟙 (weilEtaleLocalTorsionSheaf S ℓ W))

  have hIso_loc : ∀ W : S.Etale,
      α_loc W ≫ β_loc W = 𝟙 (weilEtaleLocalTorsionSheaf S ℓ W) ∧
      β_loc W ≫ α_loc W = 𝟙 (U.obj (weilCupPDLocalFreeSheaf S ℓ W)) := by
    intro W
    have h1 : α_loc W ≫ β_loc W = 𝟙 (weilEtaleLocalTorsionSheaf S ℓ W) := by
      rw [← heLoc_eq W _ (β_loc W)]
      exact Equiv.apply_symm_apply _ _
    refine ⟨h1, ?_⟩
    apply (eLoc W (U.obj (weilCupPDLocalFreeSheaf S ℓ W))).injective
    rw [heLoc_eq, heLoc_eq, ← Category.assoc, h1, Category.id_comp, Category.comp_id]

  have hβ_nat : ∀ {W₁ W₂ : S.Etale} (v : W₁ ⟶ W₂),
      U.map (weilCupPDLocalFreeMap S ℓ v) ≫ β_loc W₂ =
        β_loc W₁ ≫ weilEtaleLocalTorsionMap S ℓ v := by
    intro W₁ W₂ v
    have hα_nat : α_loc W₁ ≫ U.map (weilCupPDLocalFreeMap S ℓ v) =
        weilEtaleLocalTorsionMap S ℓ v ≫ α_loc W₂ := by
      apply Sheaf.freeYonedaHomEquiv.injective
      rw [hEquivZ_comp (α_loc W₁) (U.map (weilCupPDLocalFreeMap S ℓ v)),
        hEquivZ_comp (weilEtaleLocalTorsionMap S ℓ v) (α_loc W₂)]
      have hα₁ : Sheaf.freeYonedaHomEquiv (α_loc W₁) =
          ι_M ≫ FgtMod.map (Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₁))) :=
        Equiv.apply_symm_apply _ _
      have hα₂ : Sheaf.freeYonedaHomEquiv (α_loc W₂) =
          ι_M ≫ FgtMod.map (Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂))) :=
        Equiv.apply_symm_apply _ _
      have hv_R : Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap S ℓ v) =
          Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂)) ≫
            (weilCupPDLocalFreeSheaf S ℓ W₂).obj.map (Opposite.op v) :=
        Equiv.apply_symm_apply _ _
      have hv_Z : Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S ℓ v) =
          Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S ℓ W₂)) ≫
            (weilEtaleLocalTorsionSheaf S ℓ W₂).obj.map (Opposite.op v) :=
        Equiv.apply_symm_apply _ _
      have hLHS : Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₁)) ≫
          (weilCupPDLocalFreeMap S ℓ v).hom.app (Opposite.op W₁) =
          Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap S ℓ v) := by
        rw [← hEquivR_comp (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₁)) (weilCupPDLocalFreeMap S ℓ v),
          Category.id_comp]
      calc
        Sheaf.freeYonedaHomEquiv (α_loc W₁) ≫
            (U.map (weilCupPDLocalFreeMap S ℓ v)).hom.app (Opposite.op W₁)
          = ι_M ≫ (FgtMod.map (Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₁))) ≫
              FgtMod.map ((weilCupPDLocalFreeMap S ℓ v).hom.app (Opposite.op W₁))) := by
            rw [hα₁, Category.assoc]; rfl
        _ = ι_M ≫ FgtMod.map (Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap S ℓ v)) := by
            rw [← FgtMod.map_comp, hLHS]
        _ = (ι_M ≫ FgtMod.map (Sheaf.freeYonedaHomEquiv (𝟙 (weilCupPDLocalFreeSheaf S ℓ W₂)))) ≫
              (U.obj (weilCupPDLocalFreeSheaf S ℓ W₂)).obj.map (Opposite.op v) := by
            rw [hv_R, FgtMod.map_comp, Category.assoc]; rfl
        _ = Sheaf.freeYonedaHomEquiv (α_loc W₂) ≫
              (U.obj (weilCupPDLocalFreeSheaf S ℓ W₂)).obj.map (Opposite.op v) := by rw [← hα₂]
        _ = (Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S ℓ W₂)) ≫
              (α_loc W₂).hom.app (Opposite.op W₂)) ≫
              (U.obj (weilCupPDLocalFreeSheaf S ℓ W₂)).obj.map (Opposite.op v) := by
            rw [← hEquivZ_comp (𝟙 (weilEtaleLocalTorsionSheaf S ℓ W₂)) (α_loc W₂),
              Category.id_comp]
        _ = Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S ℓ W₂)) ≫
              ((weilEtaleLocalTorsionSheaf S ℓ W₂).obj.map (Opposite.op v) ≫
                (α_loc W₂).hom.app (Opposite.op W₁)) := by
            rw [Category.assoc, (α_loc W₂).hom.naturality (Opposite.op v)]
        _ = Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S ℓ v) ≫
              (α_loc W₂).hom.app (Opposite.op W₁) := by
            rw [← Category.assoc, ← hv_Z]
    calc
      U.map (weilCupPDLocalFreeMap S ℓ v) ≫ β_loc W₂
        = (β_loc W₁ ≫ α_loc W₁) ≫ U.map (weilCupPDLocalFreeMap S ℓ v) ≫ β_loc W₂ := by
            rw [(hIso_loc W₁).2, Category.id_comp]
      _ = β_loc W₁ ≫ (α_loc W₁ ≫ U.map (weilCupPDLocalFreeMap S ℓ v)) ≫ β_loc W₂ := by
            simp only [Category.assoc]
      _ = β_loc W₁ ≫ weilEtaleLocalTorsionMap S ℓ v ≫ (α_loc W₂ ≫ β_loc W₂) := by
            rw [hα_nat, Category.assoc]
      _ = β_loc W₁ ≫ weilEtaleLocalTorsionMap S ℓ v := by
            rw [(hIso_loc W₂).1, Category.comp_id]

  
  let TF : Sheaf J AddCommGrpCat.{u} → Prop :=
    fun K => ∀ n : ℕ, n ≠ 0 → Mono (n • 𝟙 K)
  have hTF_sub : ∀ {K' P : Sheaf J AddCommGrpCat.{u}} (ι : K' ⟶ P) [Mono ι],
      TF P → TF K' := by
    intro K' P ι _ hTF_P n hn
    have : Mono (n • 𝟙 P) := hTF_P n hn
    have hcomm : (n • 𝟙 K') ≫ ι = ι ≫ (n • 𝟙 P) := by
      rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
    have : Mono ((n • 𝟙 K') ≫ ι) := by rw [hcomm]; exact mono_comp _ _
    exact mono_of_mono (n • 𝟙 K') ι

  have hMono_Aℤ : ∀ n : ℕ, n ≠ 0 → Mono (n • 𝟙 Aℤ) := by
    intro n hn
    have h_app : ∀ (z : Aℤ), (n • 𝟙 Aℤ).hom z = ULift.up ((n : ℤ) * z.down) := by
      intro z
      induction n with
      | zero => exact absurd rfl hn
      | succ k ih =>
        by_cases hk : k = 0
        · subst hk; apply ULift.ext; simp
        · rw [succ_nsmul]
          change (k • 𝟙 Aℤ).hom z + z = _
          rw [ih hk]
          apply ULift.ext
          change (k : ℤ) * z.down + z.down = ((k + 1 : ℕ) : ℤ) * z.down
          push_cast; ring
    refine ⟨fun {Z} g₁ g₂ hg => AddCommGrpCat.ext (fun x => ?_)⟩
    have hx := congrArg (fun k : Z ⟶ Aℤ => (k.hom x).down) hg
    change ((n • 𝟙 Aℤ).hom (g₁.hom x)).down = ((n • 𝟙 Aℤ).hom (g₂.hom x)).down at hx
    rw [h_app, h_app] at hx
    exact ULift.ext _ _ (mul_left_cancel₀ (Nat.cast_ne_zero.mpr hn) hx)

  have hTF_Fℤ : TF Fℤ := by
    intro n hn
    let Pℤ : Opposite S.Etale ⥤ AddCommGrpCat.{u} := (Functor.const (Opposite S.Etale)).obj Aℤ
    have : ∀ V : Opposite S.Etale, Mono ((n • 𝟙 Pℤ).app V) := fun _ => hMono_Aℤ n hn
    have : Mono (n • 𝟙 Pℤ) := NatTrans.mono_of_mono_app (n • 𝟙 Pℤ)
    let Shf := presheafToSheaf J AddCommGrpCat.{u}
    have : Limits.PreservesBinaryBiproducts Shf :=
      Limits.preservesBinaryBiproducts_of_preservesBinaryProducts Shf
    have : Shf.Additive := Functor.additive_of_preservesBinaryBiproducts Shf
    have hEq : n • 𝟙 Fℤ = Shf.map (n • 𝟙 Pℤ) := by
      change n • 𝟙 (Shf.obj Pℤ) = Shf.map (n • 𝟙 Pℤ)
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [hEq]
    exact Shf.map_mono (n • 𝟙 Pℤ)

  let J_aff := AlgebraicGeometry.Scheme.AffineEtale.topology S
  let eAffSh := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
  let eSm := CategoryTheory.equivSmallModel.{u} S.AffineEtale
  let I : Type u := CategoryTheory.SmallModel.{u} S.AffineEtale
  let G_aff : I → Sheaf J_aff AddCommGrpCat.{u} :=
    fun x => Sheaf.freeYoneda J_aff (eSm.inverse.obj x) Aℤ
  let G_et : I → Sheaf J AddCommGrpCat.{u} := fun x => eAffSh.functor.obj (G_aff x)

  have hTF_Get : ∀ (x : I) (n : ℕ), n ≠ 0 → Mono (n • 𝟙 (G_et x)) := by
    intro x n hn
    let W_x := eSm.inverse.obj x
    let P_x := Presheaf.freeYoneda W_x Aℤ
    have : ∀ V : Opposite S.AffineEtale, Mono ((n • 𝟙 P_x).app V) := by
      intro V
      let IdxV : Type u := Opposite.unop V ⟶ W_x
      let D : Discrete IdxV ⥤ AddCommGrpCat.{u} := Discrete.functor (fun _ => Aℤ)
      let φ : D ⟶ D := Discrete.natTrans (fun _ => n • 𝟙 Aℤ)
      have : ∀ j : Discrete IdxV, Mono (φ.app j) := fun _ => hMono_Aℤ n hn
      have : Mono φ := NatTrans.mono_of_mono_app φ
      have : HasExactColimitsOfShape (Discrete IdxV) AddCommGrpCat.{u} := AB4OfSize.ofShape IdxV
      have hPV : P_x.obj V = Limits.sigmaObj (fun _ : IdxV => Aℤ) :=
        Presheaf.freeYoneda_obj W_x Aℤ V
      change Mono (n • 𝟙 (P_x.obj V))
      rw [hPV]
      exact Limits.colim.map_mono' φ
        (Limits.colimit.isColimit D)
        (Limits.colimit.isColimit D)
        (n • 𝟙 (Limits.sigmaObj (fun _ : IdxV => Aℤ)))
        (fun j => by
          dsimp only [D, φ, Discrete.functor_obj_eq_as, Discrete.natTrans_app]
          change Limits.colimit.ι D j ≫ (n • 𝟙 (Limits.colimit D)) =
            (n • 𝟙 Aℤ) ≫ Limits.colimit.ι D j
          rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
    have : Mono (n • 𝟙 P_x) := NatTrans.mono_of_mono_app (n • 𝟙 P_x)
    let Shf_aff := presheafToSheaf J_aff AddCommGrpCat.{u}
    have : Limits.PreservesBinaryBiproducts Shf_aff :=
      Limits.preservesBinaryBiproducts_of_preservesBinaryProducts Shf_aff
    have : Shf_aff.Additive := Functor.additive_of_preservesBinaryBiproducts Shf_aff
    have hEq1 : n • 𝟙 (G_aff x) = Shf_aff.map (n • 𝟙 P_x) := by
      change n • 𝟙 (Shf_aff.obj P_x) = Shf_aff.map (n • 𝟙 P_x)
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have : Mono (n • 𝟙 (G_aff x)) := by rw [hEq1]; exact Shf_aff.map_mono (n • 𝟙 P_x)
    have : Limits.PreservesBinaryBiproducts eAffSh.functor :=
      Limits.preservesBinaryBiproducts_of_preservesBinaryProducts eAffSh.functor
    have : eAffSh.functor.Additive := Functor.additive_of_preservesBinaryBiproducts eAffSh.functor
    have hEq2 : n • 𝟙 (G_et x) = eAffSh.functor.map (n • 𝟙 (G_aff x)) := by
      change n • 𝟙 (eAffSh.functor.obj (G_aff x)) = eAffSh.functor.map (n • 𝟙 (G_aff x))
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [hEq2]
    exact eAffSh.functor.map_mono (n • 𝟙 (G_aff x))

  have hEquivAff_comp : ∀ {W : S.AffineEtale} {F G : Sheaf J_aff AddCommGrpCat.{u}}
      (α : Sheaf.freeYoneda J_aff W Aℤ ⟶ F) (g : F ⟶ G),
      Sheaf.freeYonedaHomEquiv (α ≫ g) =
        Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro W F G α g
    let α' : (presheafToSheaf J_aff AddCommGrpCat.{u}).obj (Presheaf.freeYoneda W Aℤ) ⟶ F := α
    calc
      Presheaf.freeYonedaHomEquiv
          (((sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = Presheaf.freeYonedaHomEquiv
            (((sheafificationAdjunction J_aff AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (sheafToPresheaf J_aff AddCommGrpCat.{u}).map g) := by
            rw [Adjunction.homEquiv_naturality_right]
      _ = Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            Presheaf.freeYonedaHomEquiv_comp _ _

  have hSep : ∀ {E₁ E₂ : Sheaf J AddCommGrpCat.{u}} (f₁ f₂ : E₁ ⟶ E₂),
      (∀ (x : I) (h : G_et x ⟶ E₁), h ≫ f₁ = h ≫ f₂) → f₁ = f₂ := by
    intro E₁ E₂ f₁ f₂ hEq
    apply eAffSh.inverse.map_injective
    let E₁' := eAffSh.inverse.obj E₁
    let E₂' := eAffSh.inverse.obj E₂
    let g₁ : E₁' ⟶ E₂' := eAffSh.inverse.map f₁
    let g₂ : E₁' ⟶ E₂' := eAffSh.inverse.map f₂
    have hEq_aff : ∀ (x : I) (h' : G_aff x ⟶ E₁'), h' ≫ g₁ = h' ≫ g₂ := by
      intro x h'
      let h : G_et x ⟶ E₁ := eAffSh.functor.map h' ≫ eAffSh.counitIso.hom.app E₁
      have hh := hEq x h
      have hnat₁ : eAffSh.counitIso.hom.app E₁ ≫ f₁ =
          eAffSh.functor.map g₁ ≫ eAffSh.counitIso.hom.app E₂ :=
        (eAffSh.counitIso.hom.naturality f₁).symm
      have hnat₂ : eAffSh.counitIso.hom.app E₁ ≫ f₂ =
          eAffSh.functor.map g₂ ≫ eAffSh.counitIso.hom.app E₂ :=
        (eAffSh.counitIso.hom.naturality f₂).symm
      have hc₁ : h ≫ f₁ = eAffSh.functor.map (h' ≫ g₁) ≫ eAffSh.counitIso.hom.app E₂ := by
        dsimp only [h]
        rw [Category.assoc, hnat₁, ← Category.assoc, ← eAffSh.functor.map_comp]
      have hc₂ : h ≫ f₂ = eAffSh.functor.map (h' ≫ g₂) ≫ eAffSh.counitIso.hom.app E₂ := by
        dsimp only [h]
        rw [Category.assoc, hnat₂, ← Category.assoc, ← eAffSh.functor.map_comp]
      rw [hc₁, hc₂, cancel_mono] at hh
      exact eAffSh.functor.map_injective hh
    apply Sheaf.hom_ext
    ext V_op a
    let U_aff : S.AffineEtale := Opposite.unop V_op
    let x : I := eSm.functor.obj U_aff
    let W_x : S.AffineEtale := eSm.inverse.obj x
    let τ : U_aff ≅ W_x := eSm.unitIso.app U_aff
    let a' : E₁'.obj.obj (Opposite.op W_x) := (E₁'.obj.map (Opposite.op τ.inv)).hom a
    have ha' : (E₁'.obj.map (Opposite.op τ.hom)).hom a' = a := by
      dsimp only [a']
      have hcomp : Opposite.op τ.inv ≫ Opposite.op τ.hom = 𝟙 (Opposite.op U_aff) := by
        change Opposite.op (τ.hom ≫ τ.inv) = Opposite.op (𝟙 U_aff)
        rw [τ.hom_inv_id]
      change (E₁'.obj.map (Opposite.op τ.inv) ≫ E₁'.obj.map (Opposite.op τ.hom)).hom a = a
      rw [← E₁'.obj.map_comp, hcomp, E₁'.obj.map_id]
      rfl
    let ψ_a' : Aℤ ⟶ E₁'.obj.obj (Opposite.op W_x) := AddCommGrpCat.ofHom
      { toFun := fun z => z.down • a'
        map_zero' := zero_zsmul a'
        map_add' := fun z₁ z₂ => add_zsmul a' z₁.down z₂.down }
    let h' : G_aff x ⟶ E₁' := Sheaf.freeYonedaHomEquiv.symm ψ_a'
    have hh' := congrArg Sheaf.freeYonedaHomEquiv (hEq_aff x h')
    rw [hEquivAff_comp h' g₁, hEquivAff_comp h' g₂, Equiv.apply_symm_apply] at hh'
    have hev := congrArg (fun k : Aℤ ⟶ E₂'.obj.obj (Opposite.op W_x) => k.hom (ULift.up (1 : ℤ))) hh'
    change (g₁.hom.app (Opposite.op W_x)).hom ((1 : ℤ) • a') =
      (g₂.hom.app (Opposite.op W_x)).hom ((1 : ℤ) • a') at hev
    rw [one_zsmul] at hev
    have hnat₁ := congrArg
      (fun k : E₁'.obj.obj (Opposite.op W_x) ⟶ E₂'.obj.obj (Opposite.op U_aff) => k.hom a')
      (g₁.hom.naturality (Opposite.op τ.hom))
    have hnat₂ := congrArg
      (fun k : E₁'.obj.obj (Opposite.op W_x) ⟶ E₂'.obj.obj (Opposite.op U_aff) => k.hom a')
      (g₂.hom.naturality (Opposite.op τ.hom))
    change (g₁.hom.app (Opposite.op U_aff)).hom ((E₁'.obj.map (Opposite.op τ.hom)).hom a') =
      (E₂'.obj.map (Opposite.op τ.hom)).hom ((g₁.hom.app (Opposite.op W_x)).hom a') at hnat₁
    change (g₂.hom.app (Opposite.op U_aff)).hom ((E₁'.obj.map (Opposite.op τ.hom)).hom a') =
      (E₂'.obj.map (Opposite.op τ.hom)).hom ((g₂.hom.app (Opposite.op W_x)).hom a') at hnat₂
    rw [ha'] at hnat₁ hnat₂
    change (g₁.hom.app (Opposite.op U_aff)).hom a = (g₂.hom.app (Opposite.op U_aff)).hom a
    rw [hnat₁, hnat₂, hev]

  have hCoverTF : ∀ E : Sheaf J AddCommGrpCat.{u},
      ∃ (P : Sheaf J AddCommGrpCat.{u}) (π : P ⟶ E), Epi π ∧ TF P :=
    hGrothCover I G_et hSep hTF_Get

  have hVanU : ∀ (ℐ : Sheaf J (ModuleCat.{u, u} R)) [Injective ℐ] (q : ℕ)
      (ω : Abelian.Ext.{u} Fℤ (U.obj ℐ) (q + 1)), ω = 0 := by
    intro ℐ _ q ω
    obtain ⟨h1, h2⟩ := hTorsInj ℐ
    exact hAbstractEfface TF hTF_sub hCoverTF (U.obj ℐ)
      (fun hS hTF_X3 g₀ => hSnakeExt ℓ (U.obj ℐ) h1 h2 hS (hTF_X3 ℓ hℓ_ne) g₀)
      q Fℤ hTF_Fℤ ω

  
  let GenMap : ∀ (Y : Sheaf J (ModuleCat.{u, u} R)) (q : ℕ),
      Abelian.Ext.{u} oneR Y q →+ Abelian.Ext.{u} Fℤ (U.obj Y) q :=
    fun Y q => ((Abelian.Ext.mk₀ ηℤ).precomp (U.obj Y) (Nat.zero_add q)).comp
      (U.mapExtAddHom oneR Y q)
  have hGen_bij : ∀ (Y : Sheaf J (ModuleCat.{u, u} R)) (q : ℕ), Function.Bijective (GenMap Y q) :=
    fun Y q => hExactExtBij U oneR Fℤ ηℤ hBij0 hVanU Y q
  have hGen_post : ∀ {Y₁ Y₂ : Sheaf J (ModuleCat.{u, u} R)} (f : Y₁ ⟶ Y₂) (q : ℕ)
      (x : Abelian.Ext.{u} oneR Y₁ q),
      GenMap Y₂ q (x.comp (Abelian.Ext.mk₀ f) (Nat.add_zero q)) =
        (GenMap Y₁ q x).comp (Abelian.Ext.mk₀ (U.map f)) (Nat.add_zero q) := by
    intro Y₁ Y₂ f q x
    change (Abelian.Ext.mk₀ ηℤ).comp
        (Abelian.Ext.mapExactFunctor U (x.comp (Abelian.Ext.mk₀ f) (Nat.add_zero q)))
        (Nat.zero_add q) =
      ((Abelian.Ext.mk₀ ηℤ).comp (Abelian.Ext.mapExactFunctor U x) (Nat.zero_add q)).comp
        (Abelian.Ext.mk₀ (U.map f)) (Nat.add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ηℤ) _ _ (Nat.zero_add q) (Nat.add_zero q)
        (Nat.zero_add q)]

  let postβ : ∀ (W : S.Etale) (q : ℕ),
      Abelian.Ext.{u} Fℤ (U.obj (weilCupPDLocalFreeSheaf S ℓ W)) q →+
        weilEtaleLocalTorsionH S ℓ W q :=
    fun W q => (Abelian.Ext.mk₀ (β_loc W)).postcomp Fℤ (Nat.add_zero q)
  let θ_loc : ∀ (W : S.Etale) (q : ℕ),
      weilCupPDLocalModH S ℓ W q →+ weilEtaleLocalTorsionH S ℓ W q :=
    fun W q => (postβ W q).comp (GenMap (weilCupPDLocalFreeSheaf S ℓ W) q)

  have hpostβ_bij : ∀ (W : S.Etale) (q : ℕ), Function.Bijective (postβ W q) := by
    intro W q
    let postα : weilEtaleLocalTorsionH S ℓ W q →
        Abelian.Ext.{u} Fℤ (U.obj (weilCupPDLocalFreeSheaf S ℓ W)) q :=
      (Abelian.Ext.mk₀ (α_loc W)).postcomp Fℤ (Nat.add_zero q)
    refine Function.bijective_iff_has_inverse.mpr ⟨postα, ?_, ?_⟩
    · intro x
      change (x.comp (Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero q)).comp
        (Abelian.Ext.mk₀ (α_loc W)) (Nat.add_zero q) = x
      rw [Abelian.Ext.comp_assoc x _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
        Abelian.Ext.mk₀_comp_mk₀, (hIso_loc W).2, Abelian.Ext.comp_mk₀_id]
    · intro y
      change (y.comp (Abelian.Ext.mk₀ (α_loc W)) (Nat.add_zero q)).comp
        (Abelian.Ext.mk₀ (β_loc W)) (Nat.add_zero q) = y
      rw [Abelian.Ext.comp_assoc y _ _ (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
        Abelian.Ext.mk₀_comp_mk₀, (hIso_loc W).1, Abelian.Ext.comp_mk₀_id]

  refine ⟨θ_loc, fun W q => (hpostβ_bij W q).comp (hGen_bij (weilCupPDLocalFreeSheaf S ℓ W) q), ?_⟩
  intro W₁ W₂ v q z
  change (GenMap (weilCupPDLocalFreeSheaf S ℓ W₂) q
      (z.comp (Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S ℓ v)) (Nat.add_zero q))).comp
    (Abelian.Ext.mk₀ (β_loc W₂)) (Nat.add_zero q) =
    ((GenMap (weilCupPDLocalFreeSheaf S ℓ W₁) q z).comp
      (Abelian.Ext.mk₀ (β_loc W₁)) (Nat.add_zero q)).comp
    (Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S ℓ v)) (Nat.add_zero q)
  rw [hGen_post (weilCupPDLocalFreeMap S ℓ v) q z,
    Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ (U.map (weilCupPDLocalFreeMap S ℓ v)))
      (Abelian.Ext.mk₀ (β_loc W₂)) (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q),
    Abelian.Ext.mk₀_comp_mk₀, hβ_nat v, ← Abelian.Ext.mk₀_comp_mk₀,
    ← Abelian.Ext.comp_assoc _ (Abelian.Ext.mk₀ (β_loc W₁))
      (Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S ℓ v))
      (Nat.add_zero q) (Nat.add_zero 0) (Nat.add_zero q)]

theorem weil_etale_abstract_exact_functor_ext_package : (∀ {C₁ C₂ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁]
        [CategoryTheory.HasExt.{u} C₁] [CategoryTheory.EnoughInjectives C₁]
        [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂]
        [CategoryTheory.HasExt.{u} C₂]
        (G : CategoryTheory.Functor C₁ C₂) [G.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        (X₁ : C₁) (X₂ : C₂) (η : Quiver.Hom X₂ (G.obj X₁)),
      (∀ Y : C₁, Function.Bijective
        (fun f : Quiver.Hom X₁ Y => CategoryTheory.CategoryStruct.comp η (G.map f))) →
      (∀ (ℐ : C₁) [CategoryTheory.Injective ℐ] (q : ℕ)
          (ω : CategoryTheory.Abelian.Ext.{u} X₂ (G.obj ℐ) (q + 1)), ω = 0) →
      ∀ (Y : C₁) (q : ℕ),
        Function.Bijective
          (((CategoryTheory.Abelian.Ext.mk₀ η).precomp (G.obj Y) (Nat.zero_add q)).comp
            (G.mapExtAddHom X₁ Y q))) ∧
    (∀ {C₁ C₂ C₃ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁]
        [CategoryTheory.HasExt.{u} C₁] [CategoryTheory.EnoughInjectives C₁]
        [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂]
        [CategoryTheory.HasExt.{u} C₂]
        [CategoryTheory.Category.{u + 1, u + 1} C₃] [CategoryTheory.Abelian C₃]
        [CategoryTheory.HasExt.{u} C₃]
        (F : CategoryTheory.Functor C₁ C₂) [F.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits F]
        [CategoryTheory.Limits.PreservesFiniteColimits F]
        (G : CategoryTheory.Functor C₂ C₃) [G.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        (q : ℕ) {X Y : C₁}
        (x : CategoryTheory.Abelian.Ext.{u} X Y q),
      CategoryTheory.Abelian.Ext.mapExactFunctor (CategoryTheory.Functor.comp F G) x =
        CategoryTheory.Abelian.Ext.mapExactFunctor G
          (CategoryTheory.Abelian.Ext.mapExactFunctor F x)) ∧
    (∀ {C₁ C₂ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1, u + 1} C₁] [CategoryTheory.Abelian C₁]
        [CategoryTheory.HasExt.{u} C₁] [CategoryTheory.EnoughInjectives C₁]
        [CategoryTheory.Category.{u + 1, u + 1} C₂] [CategoryTheory.Abelian C₂]
        [CategoryTheory.HasExt.{u} C₂]
        {F G : CategoryTheory.Functor C₁ C₂} [F.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits F]
        [CategoryTheory.Limits.PreservesFiniteColimits F]
        [G.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        (e : CategoryTheory.Iso F G) (q : ℕ) {X Y : C₁}
        (x : CategoryTheory.Abelian.Ext.{u} X Y q),
      (CategoryTheory.Abelian.Ext.mk₀ (e.inv.app X)).comp
        ((CategoryTheory.Abelian.Ext.mapExactFunctor F x).comp
          (CategoryTheory.Abelian.Ext.mk₀ (e.hom.app Y)) (Nat.add_zero q))
        (Nat.zero_add q) =
        CategoryTheory.Abelian.Ext.mapExactFunctor G x) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro C₁ C₂ _ _ _ _ _ _ _ G _ _ _ X₁ X₂ η hBij0 hVan
    let GenMap : ∀ (Y : C₁) (q : ℕ),
        CategoryTheory.Abelian.Ext.{u} X₁ Y q →+
          CategoryTheory.Abelian.Ext.{u} X₂ (G.obj Y) q :=
      fun Y q =>
        ((CategoryTheory.Abelian.Ext.mk₀ η).precomp (G.obj Y) (Nat.zero_add q)).comp
          (G.mapExtAddHom X₁ Y q)
    have hGen_post : ∀ {Y₁ Y₂ : C₁} (f : Y₁ ⟶ Y₂) (q : ℕ)
        (x : CategoryTheory.Abelian.Ext.{u} X₁ Y₁ q),
        GenMap Y₂ q (x.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)) =
          (GenMap Y₁ q x).comp (CategoryTheory.Abelian.Ext.mk₀ (G.map f)) (Nat.add_zero q) := by
      intro Y₁ Y₂ f q x
      change (CategoryTheory.Abelian.Ext.mk₀ η).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G
            (x.comp (CategoryTheory.Abelian.Ext.mk₀ f) (Nat.add_zero q)))
          (Nat.zero_add q) =
        ((CategoryTheory.Abelian.Ext.mk₀ η).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G x) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (G.map f)) (Nat.add_zero q)
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ η)
        (CategoryTheory.Abelian.Ext.mapExactFunctor G x)
        (CategoryTheory.Abelian.Ext.mk₀ (G.map f))
        (Nat.zero_add q)).symm
    have hGen_delta : ∀ {S_mod : CategoryTheory.ShortComplex C₁}
        (hS_mod : S_mod.ShortExact) (q : ℕ)
        (y : CategoryTheory.Abelian.Ext.{u} X₁ S_mod.X₃ q),
        GenMap S_mod.X₁ (q + 1) (y.comp hS_mod.extClass rfl) =
          (GenMap S_mod.X₃ q y).comp (hS_mod.map_of_exact G).extClass rfl := by
      intro S_mod hS_mod q y
      change (CategoryTheory.Abelian.Ext.mk₀ η).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G
            (y.comp hS_mod.extClass rfl))
          (Nat.zero_add (q + 1)) =
        ((CategoryTheory.Abelian.Ext.mk₀ η).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor G y) (Nat.zero_add q)).comp
          (hS_mod.map_of_exact G).extClass rfl
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
      exact (CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ η)
        (CategoryTheory.Abelian.Ext.mapExactFunctor G y)
        (hS_mod.map_of_exact G).extClass
        (Nat.zero_add q) rfl (Nat.zero_add (q + 1))).symm
    have hAllQ : ∀ (q : ℕ) (Y : C₁), Function.Bijective (GenMap Y q) := by
      intro q
      induction q with
      | zero =>
        intro Y
        have hGen0_comm : (GenMap Y 0 : _ → _) ∘ CategoryTheory.Abelian.Ext.mk₀ =
            CategoryTheory.Abelian.Ext.mk₀ ∘ (fun f : X₁ ⟶ Y => η ≫ G.map f) := by
          funext f
          change (CategoryTheory.Abelian.Ext.mk₀ η).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor G
                (CategoryTheory.Abelian.Ext.mk₀ f))
              (Nat.zero_add 0) =
            CategoryTheory.Abelian.Ext.mk₀ (η ≫ G.map f)
          rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
          exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ η (G.map f)
        have hCompBij : Function.Bijective ((GenMap Y 0 : _ → _) ∘ CategoryTheory.Abelian.Ext.mk₀) := by
          rw [hGen0_comm]
          exact (CategoryTheory.Abelian.Ext.mk₀_bijective _ _).comp (hBij0 Y)
        exact (Function.Bijective.of_comp_iff (GenMap Y 0)
          (CategoryTheory.Abelian.Ext.mk₀_bijective _ _)).mp hCompBij
      | succ q ih_q =>
        intro Y
        let ℐ := CategoryTheory.Injective.under Y
        let i_Y : Y ⟶ ℐ := CategoryTheory.Injective.ι Y
        let p_Y : ℐ ⟶ CategoryTheory.Limits.cokernel i_Y := CategoryTheory.Limits.cokernel.π i_Y
        let S_Y := CategoryTheory.ShortComplex.mk i_Y p_Y (CategoryTheory.Limits.cokernel.condition i_Y)
        have hS_Y : S_Y.ShortExact :=
          CategoryTheory.ShortComplex.ShortExact.mk'
            (CategoryTheory.ShortComplex.exact_cokernel i_Y) inferInstance inferInstance
        let hSG_Y := hS_Y.map_of_exact G
        refine ⟨?_, ?_⟩
        · rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
          intro x hx
          rw [AddMonoidHom.mem_ker] at hx
          have hx_i : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (q + 1)) = 0 :=
            CategoryTheory.Abelian.Ext.eq_zero_of_injective _
          obtain ⟨y, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X₁ hS_Y x hx_i rfl
          rw [hGen_delta hS_Y q y] at hx
          obtain ⟨w', hw'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃
            X₂ hSG_Y (GenMap S_Y.X₃ q y) rfl hx
          obtain ⟨w, rfl⟩ := (ih_q ℐ).2 w'
          have h_post := hGen_post p_Y q w
          change (GenMap ℐ q w).comp (CategoryTheory.Abelian.Ext.mk₀ (G.map p_Y))
            (Nat.add_zero q) = GenMap (CategoryTheory.Limits.cokernel i_Y) q y at hw'
          rw [← h_post] at hw'
          have hy_eq : w.comp (CategoryTheory.Abelian.Ext.mk₀ p_Y) (Nat.add_zero q) = y :=
            (ih_q S_Y.X₃).1 hw'
          rw [← hy_eq, CategoryTheory.Abelian.Ext.comp_assoc w
            (CategoryTheory.Abelian.Ext.mk₀ S_Y.g) hS_Y.extClass
            (Nat.add_zero q) (Nat.zero_add 1) rfl,
            hS_Y.comp_extClass]
          exact CategoryTheory.Abelian.Ext.comp_zero w S_Y.X₁ 1 (q + 1) rfl
        · intro z
          have hz_i : z.comp (CategoryTheory.Abelian.Ext.mk₀ (S_Y.map G).f)
              (Nat.add_zero (q + 1)) = 0 :=
            hVan ℐ q _
          obtain ⟨y', rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
            X₂ hSG_Y z hz_i rfl
          obtain ⟨y, rfl⟩ := (ih_q S_Y.X₃).2 y'
          exact ⟨y.comp hS_Y.extClass rfl, hGen_delta hS_Y q y⟩
    intro Y q
    exact hAllQ q Y
  · intro C₁ C₂ C₃ _ _ _ _ _ _ _ _ _ _ F _ _ _ G _ _ _ q
    induction q with
    | zero =>
      intro X Y x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X Y).2 x
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ q ih =>
      intro X Y x
      let ℐ := CategoryTheory.Injective.under Y
      let i_Y : Y ⟶ ℐ := CategoryTheory.Injective.ι Y
      let p_Y : ℐ ⟶ CategoryTheory.Limits.cokernel i_Y := CategoryTheory.Limits.cokernel.π i_Y
      let S_Y := CategoryTheory.ShortComplex.mk i_Y p_Y (CategoryTheory.Limits.cokernel.condition i_Y)
      have hS_Y : S_Y.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel i_Y) inferInstance inferInstance
      have hx_i : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS_Y x hx_i rfl
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ih y]
  · intro C₁ C₂ _ _ _ _ _ _ _ F G _ _ _ _ _ _ e q
    induction q with
    | zero =>
      intro X Y x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X Y).2 x
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        e.hom.naturality f, ← CategoryTheory.Category.assoc,
        e.inv_hom_id_app X, CategoryTheory.Category.id_comp]
    | succ q ih =>
      intro X Y x
      let ℐ := CategoryTheory.Injective.under Y
      let i_Y : Y ⟶ ℐ := CategoryTheory.Injective.ι Y
      let p_Y : ℐ ⟶ CategoryTheory.Limits.cokernel i_Y := CategoryTheory.Limits.cokernel.π i_Y
      let S_Y := CategoryTheory.ShortComplex.mk i_Y p_Y (CategoryTheory.Limits.cokernel.condition i_Y)
      have hS_Y : S_Y.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel i_Y) inferInstance inferInstance
      have hx_i : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (q + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS_Y x hx_i rfl
      let φ_e : S_Y.map F ⟶ S_Y.map G :=
        { τ₁ := e.hom.app S_Y.X₁
          τ₂ := e.hom.app S_Y.X₂
          τ₃ := e.hom.app S_Y.X₃
          comm₁₂ := (e.hom.naturality S_Y.f).symm
          comm₂₃ := (e.hom.naturality S_Y.g).symm }
      have hnat_e := CategoryTheory.ShortComplex.ShortExact.extClass_naturality
        (hS_Y.map_of_exact F) (hS_Y.map_of_exact G) φ_e
      dsimp only [φ_e] at hnat_e
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        hnat_e,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mapExactFunctor F y)
          (CategoryTheory.Abelian.Ext.mk₀ (e.hom.app S_Y.X₃))
          (hS_Y.map_of_exact G).extClass
          (Nat.add_zero q) (Nat.zero_add 1) rfl,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (e.inv.app X)) _
          (hS_Y.map_of_exact G).extClass
          (Nat.zero_add q) rfl (Nat.zero_add (q + 1)),
        ih y]

theorem weil_etale_postcomp_continuous_and_const_unit_iso {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom Y₁ Y₂) (hh : AlgebraicGeometry.Etale h) (m : ℕ) :
    let R := ULift.{u, 0} (ZMod m)
    let R_mod := ModuleCat.of R R
    let J₁ := Y₁.smallEtaleTopology
    let J₂ := Y₂.smallEtaleTopology
    let Sigma_h := weilEtalePostcomp h hh
    let one₁ := weilCupPDModUnit Y₁ m
    let one₂ := weilCupPDModUnit Y₂ m
    let T₁ := weilEtaleIdTerminal.{u} Y₁
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} Y₁
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} Y₂
    let adj₁ := CategoryTheory.constantSheafAdj J₁ (ModuleCat.{u, u} R) hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ (ModuleCat.{u, u} R) hT₂
    ∃ (hc : Sigma_h.IsContinuous J₁ J₂),
      letI := hc
      let R_sh := Sigma_h.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂
      R_sh.Additive ∧
      CategoryTheory.Limits.PreservesFiniteColimits R_sh ∧
      let α_h : Quiver.Hom one₁ (R_sh.obj one₂) :=
        (adj₁.homEquiv R_mod (R_sh.obj one₂)).symm
          (CategoryTheory.CategoryStruct.comp (adj₂.unit.app R_mod)
            (one₂.obj.map (Opposite.op (hT₂.from (Sigma_h.obj T₁)))))
      ∃ (β_h : Quiver.Hom (R_sh.obj one₂) one₁),
        CategoryTheory.CategoryStruct.comp α_h β_h = CategoryTheory.CategoryStruct.id one₁ ∧
        CategoryTheory.CategoryStruct.comp β_h α_h = CategoryTheory.CategoryStruct.id (R_sh.obj one₂) :=
by
  intro R R_mod J₁ J₂ Sigma_h one₁ one₂ T₁ hT₁ hT₂ adj₁ adj₂
  let T₂ := weilEtaleIdTerminal.{u} Y₂
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have hc : Sigma_h.IsContinuous J₁ J₂ := by
    refine CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.CompatiblePreserving.mk ?_)
      (CategoryTheory.CoverPreserving.mk ?_)
    · intro ℱ Z T x hx V₁ V₂ X f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hf12_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun k => k.left) hfg
      have hf₁_w : f₁.left ≫ (V₁.hom ≫ h) = X.hom :=
        CategoryTheory.MorphismProperty.Over.w f₁
      have hg₁_w : g₁.left ≫ Z.hom = V₁.hom :=
        CategoryTheory.MorphismProperty.Over.w g₁
      have hg₂_w : g₂.left ≫ Z.hom = V₂.hom :=
        CategoryTheory.MorphismProperty.Over.w g₂
      have hEt_V₁h : AlgebraicGeometry.Etale (V₁.hom ≫ h) :=
        CategoryTheory.MorphismProperty.comp_mem P_et V₁.hom h V₁.prop hh
      have hEt_comp_f₁ : AlgebraicGeometry.Etale (f₁.left ≫ (V₁.hom ≫ h)) := by
        rw [hf₁_w]
        exact X.prop
      have hEt_f₁ : AlgebraicGeometry.Etale f₁.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          f₁.left (V₁.hom ≫ h) hEt_V₁h hEt_comp_f₁
      have hEt_Xtilde : AlgebraicGeometry.Etale (f₁.left ≫ V₁.hom) :=
        CategoryTheory.MorphismProperty.comp_mem P_et f₁.left V₁.hom hEt_f₁ V₁.prop
      let X_tilde : Y₁.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ V₁.hom) hEt_Xtilde
      have hf₂_hom : f₂.left ≫ V₂.hom = f₁.left ≫ V₁.hom :=
        (congrArg (f₂.left ≫ ·) hg₂_w.symm).trans
          ((CategoryTheory.Category.assoc f₂.left g₂.left Z.hom).symm.trans
            ((congrArg (· ≫ Z.hom) hf12_left.symm).trans
              ((CategoryTheory.Category.assoc f₁.left g₁.left Z.hom).trans
                (congrArg (f₁.left ≫ ·) hg₁_w))))
      let f₁_tilde : X_tilde ⟶ V₁ :=
        CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂_tilde : X_tilde ⟶ V₂ :=
        CategoryTheory.MorphismProperty.Over.homMk f₂.left hf₂_hom trivial
      have hf_tilde_eq : f₁_tilde ≫ g₁ = f₂_tilde ≫ g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hf12_left (Subsingleton.elim _ _)
      have hcompat := hx f₁_tilde f₂_tilde hg₁ hg₂ hf_tilde_eq
      let κ : X ⟶ Sigma_h.obj X_tilde :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 X.left)
          ((CategoryTheory.Category.id_comp _).trans
            ((CategoryTheory.Category.assoc f₁.left V₁.hom h).trans hf₁_w))
          trivial
      have hκ₁ : κ ≫ Sigma_h.map f₁_tilde = f₁ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₁.left) (Subsingleton.elim _ _)
      have hκ₂ : κ ≫ Sigma_h.map f₂_tilde = f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (CategoryTheory.Category.id_comp f₂.left) (Subsingleton.elim _ _)
      rw [← hκ₁, ← hκ₂, CategoryTheory.op_comp, CategoryTheory.op_comp,
        ℱ.obj.map_comp, ℱ.obj.map_comp,
        CategoryTheory.ConcreteCategory.comp_apply,
        CategoryTheory.ConcreteCategory.comp_apply]
      exact congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map κ.op)) hcompat
    · intro U S_cov hS_cov
      have hJ₁ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y₁ (le_refl P_et)
      have hJ₂ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Y₂ (le_refl P_et)
      have hS_pre : S_cov ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U := by
        change S_cov ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₁ U at hS_cov
        rwa [hJ₁] at hS_cov
      have hS_pts :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) U S_cov).mp hS_pre
      suffices hgoal : S_cov.functorPushforward Sigma_h ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck (Sigma_h.obj U) by
        change S_cov.functorPushforward Sigma_h ∈
          AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₂ (Sigma_h.obj U)
        rwa [hJ₂]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (Sigma_h.obj U) (S_cov.functorPushforward Sigma_h)).mpr fun z => ?_
      obtain ⟨V, u, y, hu_S, hu_et, hy⟩ := hS_pts z
      exact ⟨Sigma_h.obj V, Sigma_h.map u, y,
        ⟨V, u, 𝟙 (Sigma_h.obj V), hu_S, (CategoryTheory.Category.id_comp _).symm⟩,
        hu_et, hy⟩

  have : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_h : Y₂.Etale ⥤ Y₁.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ h

  let adj_SigmaB : Sigma_h ⊣ B_h :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun Z U =>
          { toFun := fun f =>
              CategoryTheory.MorphismProperty.Over.homMk
                (CategoryTheory.Limits.pullback.lift f.left Z.hom
                  (CategoryTheory.MorphismProperty.Over.w f))
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)
                trivial
            invFun := fun k =>
              CategoryTheory.MorphismProperty.Over.homMk
                (k.left ≫ CategoryTheory.Limits.pullback.fst U.hom h)
                ((CategoryTheory.Category.assoc k.left
                    (CategoryTheory.Limits.pullback.fst U.hom h) U.hom).trans
                  ((congrArg (k.left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                    ((CategoryTheory.Category.assoc k.left
                        (CategoryTheory.Limits.pullback.snd U.hom h) h).symm.trans
                      (congrArg (· ≫ h) (CategoryTheory.MorphismProperty.Over.w k)))))
                trivial
            left_inv := fun f =>
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                (CategoryTheory.Limits.pullback.lift_fst _ _ _) (Subsingleton.elim _ _)
            right_inv := fun k =>
              CategoryTheory.MorphismProperty.Comma.Hom.ext
                (CategoryTheory.Limits.pullback.hom_ext
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)
                  ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                    (CategoryTheory.MorphismProperty.Over.w k).symm))
                (Subsingleton.elim _ _) }
        homEquiv_naturality_left_symm := fun {Z' Z U} f k =>
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            (CategoryTheory.Category.assoc f.left k.left _) (Subsingleton.elim _ _)
        homEquiv_naturality_right := fun {Z U U'} f g =>
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            (CategoryTheory.Limits.pullback.hom_ext
              ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                ((CategoryTheory.Category.assoc (CategoryTheory.Limits.pullback.lift f.left Z.hom _)
                    ((B_h.map g).left) _).trans
                  ((congrArg
                      (CategoryTheory.Limits.pullback.lift f.left Z.hom
                        (CategoryTheory.MorphismProperty.Over.w f) ≫ ·)
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    ((CategoryTheory.Category.assoc _ _ g.left).symm.trans
                      (congrArg (· ≫ g.left)
                        (CategoryTheory.Limits.pullback.lift_fst _ _ _))))).symm)
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                ((CategoryTheory.Category.assoc
                    (CategoryTheory.Limits.pullback.lift f.left Z.hom _)
                    ((B_h.map g).left) _).trans
                  ((congrArg
                      (CategoryTheory.Limits.pullback.lift f.left Z.hom
                        (CategoryTheory.MorphismProperty.Over.w f) ≫ ·)
                      (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                    (CategoryTheory.Limits.pullback.lift_snd _ _ _))).symm))
            (Subsingleton.elim _ _) }

  have hc_B : B_h.IsContinuous J₂ J₁ := by
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Y₂
    have : CategoryTheory.Limits.PreservesLimits (CategoryTheory.Over.pullback h) :=
      (CategoryTheory.Over.mapPullbackAdj h).rightAdjoint_preservesLimits
    have : CategoryTheory.Limits.PreservesFiniteLimits (B_h ⋙ Fgt₁) := by
      change CategoryTheory.Limits.PreservesFiniteLimits (Fgt₂ ⋙ CategoryTheory.Over.pullback h)
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits B_h :=
      CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B_h Fgt₁
    have : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    refine CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.compatiblePreservingOfFlat J₁ B_h)
      (CategoryTheory.CoverPreserving.mk ?_)
    intro V R_cov hR_cov
    have hJ₂ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      Y₂ (le_refl P_et)
    have hJ₁ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      Y₁ (le_refl P_et)
    have hR' : R_cov ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck V := by
      change R_cov ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₂ V at hR_cov
      rwa [hJ₂] at hR_cov
    have hR'' :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) V R_cov).mp hR'
    suffices hgoal : R_cov.functorPushforward B_h ∈
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck (B_h.obj V) by
      change R_cov.functorPushforward B_h ∈
        AlgebraicGeometry.Scheme.smallGrothendieckTopology P_et Y₁ (B_h.obj V)
      rwa [hJ₁]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) (B_h.obj V) (R_cov.functorPushforward B_h)).mpr fun x => ?_
    let v_hom : (Fgt₂.obj V).left ⟶ Y₂ := (Fgt₂.obj V).hom
    let fst_V : CategoryTheory.Limits.pullback v_hom h ⟶ (Fgt₂.obj V).left :=
      CategoryTheory.Limits.pullback.fst v_hom h
    let snd_V : CategoryTheory.Limits.pullback v_hom h ⟶ Y₁ :=
      CategoryTheory.Limits.pullback.snd v_hom h
    obtain ⟨W_et, f_et, w, hRf, hf_et, hw⟩ := hR'' (fst_V x)
    let y_hom : (Fgt₂.obj W_et).left ⟶ Y₂ := (Fgt₂.obj W_et).hom
    let f_sch : (Fgt₂.obj W_et).left ⟶ (Fgt₂.obj V).left := (Fgt₂.map f_et).left
    let fst_Y : CategoryTheory.Limits.pullback y_hom h ⟶ (Fgt₂.obj W_et).left :=
      CategoryTheory.Limits.pullback.fst y_hom h
    let snd_Y : CategoryTheory.Limits.pullback y_hom h ⟶ Y₁ :=
      CategoryTheory.Limits.pullback.snd y_hom h
    let u_over : Fgt₂.obj W_et ⟶ Fgt₂.obj V := Fgt₂.map f_et
    let bf_sch : CategoryTheory.Limits.pullback y_hom h ⟶ CategoryTheory.Limits.pullback v_hom h :=
      ((CategoryTheory.Over.pullback h).map u_over).left
    have hbf_fst : bf_sch ≫ fst_V = fst_Y ≫ f_sch :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hbf_snd : bf_sch ≫ snd_V = snd_Y :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hfy : f_sch ≫ v_hom = y_hom := CategoryTheory.Over.w u_over
    have h_outer : CategoryTheory.IsPullback (bf_sch ≫ snd_V) fst_Y h (f_sch ≫ v_hom) := by
      rw [hbf_snd, hfy]
      exact (CategoryTheory.IsPullback.of_hasPullback y_hom h).flip
    have hpb : CategoryTheory.IsPullback bf_sch fst_Y fst_V f_sch :=
      CategoryTheory.IsPullback.of_right h_outer hbf_fst
        (CategoryTheory.IsPullback.of_hasPullback v_hom h).flip
    obtain ⟨z, hz_fst, -⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x w
      (hw.symm : fst_V x = f_sch w)
    have hbf_et : P_et bf_sch :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip hf_et
    have hpush_arrow : (R_cov.functorPushforward B_h).arrows (B_h.map f_et) :=
      ⟨W_et, f_et, 𝟙 (B_h.obj W_et), hRf, (CategoryTheory.Category.id_comp _).symm⟩
    refine ⟨B_h.obj W_et, B_h.map f_et, hpb.isoPullback.inv z, hpush_arrow, hbf_et, ?_⟩
    have hinv_fst : hpb.isoPullback.inv ≫ bf_sch = CategoryTheory.Limits.pullback.fst fst_V f_sch :=
      hpb.isoPullback_inv_fst
    change (hpb.isoPullback.inv ≫ bf_sch) z = x
    rw [hinv_fst]
    exact hz_fst

  have : Sigma_h.IsContinuous J₁ J₂ := hc
  have : B_h.IsContinuous J₂ J₁ := hc_B
  let R_sh := Sigma_h.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂
  let P_push := B_h.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₂ J₁
  let adj_RP : R_sh ⊣ P_push :=
    CategoryTheory.Adjunction.mkOfUnitCounit
      { unit :=
          { app := fun ℱ =>
              { hom :=
                  { app := fun V => ℱ.obj.map (adj_SigmaB.counit.app (Opposite.unop V)).op
                    naturality := fun {V₁ V₂} f => by
                      change ℱ.obj.map f ≫ ℱ.obj.map (adj_SigmaB.counit.app (Opposite.unop V₂)).op =
                        ℱ.obj.map (adj_SigmaB.counit.app (Opposite.unop V₁)).op ≫
                          ℱ.obj.map (Sigma_h.map (B_h.map f.unop)).op
                      rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
                      congr 1
                      exact Quiver.Hom.unop_inj (adj_SigmaB.counit.naturality f.unop).symm } }
            naturality := fun {ℱ₁ ℱ₂} u =>
              CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V =>
                (u.hom.naturality (adj_SigmaB.counit.app (Opposite.unop V)).op).symm)) }
        counit :=
          { app := fun ℋ =>
              { hom :=
                  { app := fun U => ℋ.obj.map (adj_SigmaB.unit.app (Opposite.unop U)).op
                    naturality := fun {U₁ U₂} f => by
                      change ℋ.obj.map (B_h.map (Sigma_h.map f.unop)).op ≫
                          ℋ.obj.map (adj_SigmaB.unit.app (Opposite.unop U₂)).op =
                        ℋ.obj.map (adj_SigmaB.unit.app (Opposite.unop U₁)).op ≫ ℋ.obj.map f
                      rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp]
                      congr 1
                      exact Quiver.Hom.unop_inj (adj_SigmaB.unit.naturality f.unop).symm } }
            naturality := fun {ℋ₁ ℋ₂} u =>
              CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U =>
                (u.hom.naturality (adj_SigmaB.unit.app (Opposite.unop U)).op).symm)) }
        left_triangle :=
          CategoryTheory.NatTrans.ext (funext fun ℱ =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun U => by
              change ℱ.obj.map (adj_SigmaB.counit.app (Sigma_h.obj (Opposite.unop U))).op ≫
                ℱ.obj.map (Sigma_h.map (adj_SigmaB.unit.app (Opposite.unop U))).op =
                𝟙 (ℱ.obj.obj (Opposite.op (Sigma_h.obj (Opposite.unop U))))
              rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp,
                adj_SigmaB.left_triangle_components (Opposite.unop U)]
              exact ℱ.obj.map_id _)))
        right_triangle :=
          CategoryTheory.NatTrans.ext (funext fun ℋ =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V => by
              change ℋ.obj.map (B_h.map (adj_SigmaB.counit.app (Opposite.unop V))).op ≫
                ℋ.obj.map (adj_SigmaB.unit.app (B_h.obj (Opposite.unop V))).op =
                𝟙 (ℋ.obj.obj (Opposite.op (B_h.obj (Opposite.unop V))))
              rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.op_comp,
                adj_SigmaB.right_triangle_components (Opposite.unop V)]
              exact ℋ.obj.map_id _))) }

  have hAdd : R_sh.Additive :=
    CategoryTheory.Functor.Additive.mk (fun {ℱ₁ ℱ₂} {f g} =>
      CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun _ => rfl)))
  have hColim : CategoryTheory.Limits.PreservesFiniteColimits R_sh := by
    have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} R_sh :=
      adj_RP.leftAdjoint_preservesColimits
    infer_instance

  have hop_eq : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀]
      {A B : C₀} (f : A ⟶ B),
      (Opposite.op f : Opposite.op B ⟶ Opposite.op A) = f.op :=
    fun f => (Quiver.Hom.op_unop (Opposite.op f)).symm.trans
      (congrArg Quiver.Hom.op Quiver.Hom.unop_op')

  have : CategoryTheory.Limits.PreservesLimitsOfSize.{0, 0} B_h :=
    adj_SigmaB.rightAdjoint_preservesLimits
  have hBT₂ : CategoryTheory.Limits.IsTerminal (B_h.obj T₂) :=
    CategoryTheory.Limits.IsTerminal.isTerminalObj B_h T₂ hT₂
  let τ_iso : B_h.obj T₂ ≅ T₁ :=
    CategoryTheory.Limits.IsTerminal.uniqueUpToIso hBT₂ hT₁

  let post_τ : ∀ 𝒢 : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R),
      (R_mod ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂))) ≃
        (R_mod ⟶ 𝒢.obj.obj (Opposite.op T₁)) :=
    fun 𝒢 =>
      { toFun := fun ψ => ψ ≫ 𝒢.obj.map τ_iso.inv.op
        invFun := fun ψ => ψ ≫ 𝒢.obj.map τ_iso.hom.op
        left_inv := fun ψ => by
          dsimp only
          rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
            τ_iso.hom_inv_id, CategoryTheory.op_id, 𝒢.obj.map_id, CategoryTheory.Category.comp_id]
        right_inv := fun ψ => by
          dsimp only
          rw [CategoryTheory.Category.assoc, ← 𝒢.obj.map_comp, ← CategoryTheory.op_comp,
            τ_iso.inv_hom_id, CategoryTheory.op_id, 𝒢.obj.map_id, CategoryTheory.Category.comp_id] }

  let eConstR : ∀ 𝒢 : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R),
      (R_sh.obj one₂ ⟶ 𝒢) ≃ (one₁ ⟶ 𝒢) :=
    fun 𝒢 =>
      (adj_RP.homEquiv one₂ 𝒢).trans
        ((adj₂.homEquiv R_mod (P_push.obj 𝒢)).trans
          ((post_τ 𝒢).trans (adj₁.homEquiv R_mod 𝒢).symm))

  let α_h : Quiver.Hom one₁ (R_sh.obj one₂) :=
    (adj₁.homEquiv R_mod (R_sh.obj one₂)).symm
      (CategoryTheory.CategoryStruct.comp (adj₂.unit.app R_mod)
        (one₂.obj.map (Opposite.op (hT₂.from (Sigma_h.obj T₁)))))

  have heConstR_apply : ∀ (𝒢 : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R))
      (φ : R_sh.obj one₂ ⟶ 𝒢),
      eConstR 𝒢 φ = α_h ≫ φ := by
    intro 𝒢 φ
    apply (adj₁.homEquiv R_mod 𝒢).injective
    let u₂ : R_mod ⟶ one₂.obj.obj (Opposite.op T₂) := adj₂.unit.app R_mod
    let c₂ : one₂.obj.obj (Opposite.op T₂) ⟶
        one₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj T₂))) :=
      one₂.obj.map (adj_SigmaB.counit.app T₂).op
    let φ_BT₂ : one₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj T₂))) ⟶
        𝒢.obj.obj (Opposite.op (B_h.obj T₂)) :=
      φ.hom.app (Opposite.op (B_h.obj T₂))
    let φ_T₁ : one₂.obj.obj (Opposite.op (Sigma_h.obj T₁)) ⟶
        𝒢.obj.obj (Opposite.op T₁) :=
      φ.hom.app (Opposite.op T₁)
    let g_τ : 𝒢.obj.obj (Opposite.op (B_h.obj T₂)) ⟶ 𝒢.obj.obj (Opposite.op T₁) :=
      𝒢.obj.map τ_iso.inv.op
    let s_τ : one₂.obj.obj (Opposite.op (Sigma_h.obj (B_h.obj T₂))) ⟶
        one₂.obj.obj (Opposite.op (Sigma_h.obj T₁)) :=
      one₂.obj.map (Sigma_h.map τ_iso.inv).op
    let m_T₂ : one₂.obj.obj (Opposite.op T₂) ⟶
        one₂.obj.obj (Opposite.op (Sigma_h.obj T₁)) :=
      one₂.obj.map (hT₂.from (Sigma_h.obj T₁)).op
    have h1 : adj₁.homEquiv R_mod 𝒢 (eConstR 𝒢 φ) =
        post_τ 𝒢 (adj₂.homEquiv R_mod (P_push.obj 𝒢) (adj_RP.homEquiv one₂ 𝒢 φ)) :=
      Equiv.apply_symm_apply (adj₁.homEquiv R_mod 𝒢) _
    have h2 : (adj₂.homEquiv R_mod (P_push.obj 𝒢) (adj_RP.homEquiv one₂ 𝒢 φ) :
          R_mod ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂))) =
        u₂ ≫ ((adj_RP.homEquiv one₂ 𝒢 φ).hom.app (Opposite.op T₂) :
          one₂.obj.obj (Opposite.op T₂) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂))) :=
      CategoryTheory.Adjunction.homEquiv_unit adj₂ R_mod (P_push.obj 𝒢)
        (adj_RP.homEquiv one₂ 𝒢 φ)
    have h3 : ((adj_RP.homEquiv one₂ 𝒢 φ).hom.app (Opposite.op T₂) :
          one₂.obj.obj (Opposite.op T₂) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂))) =
        c₂ ≫ φ_BT₂ :=
      congrArg
        (fun k : one₂ ⟶ P_push.obj 𝒢 =>
          (k.hom.app (Opposite.op T₂) :
            one₂.obj.obj (Opposite.op T₂) ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂))))
        (CategoryTheory.Adjunction.homEquiv_unit adj_RP one₂ 𝒢 φ)
    have hLHS : adj₁.homEquiv R_mod 𝒢 (eConstR 𝒢 φ) = (u₂ ≫ (c₂ ≫ φ_BT₂)) ≫ g_τ :=
      h1.trans
        (congrArg (fun m : R_mod ⟶ 𝒢.obj.obj (Opposite.op (B_h.obj T₂)) => m ≫ g_τ)
          (h2.trans (congrArg (u₂ ≫ ·) h3)))
    have hRHS : adj₁.homEquiv R_mod 𝒢 (α_h ≫ φ) = (u₂ ≫ m_T₂) ≫ φ_T₁ := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        show adj₁.homEquiv R_mod (R_sh.obj one₂) α_h =
          adj₂.unit.app R_mod ≫ one₂.obj.map (Opposite.op (hT₂.from (Sigma_h.obj T₁))) from
          Equiv.apply_symm_apply _ _,
        hop_eq (hT₂.from (Sigma_h.obj T₁))]
      rfl
    have hφ_nat : φ_BT₂ ≫ g_τ = s_τ ≫ φ_T₁ :=
      (φ.hom.naturality τ_iso.inv.op).symm
    have hc_s : c₂ ≫ s_τ = m_T₂ := by
      dsimp only [c₂, s_τ, m_T₂]
      rw [← one₂.obj.map_comp, ← CategoryTheory.op_comp,
        show Sigma_h.map τ_iso.inv ≫ adj_SigmaB.counit.app T₂ =
          hT₂.from (Sigma_h.obj T₁) from hT₂.hom_ext _ _]
    calc
      adj₁.homEquiv R_mod 𝒢 (eConstR 𝒢 φ)
        = (u₂ ≫ (c₂ ≫ φ_BT₂)) ≫ g_τ := hLHS
      _ = u₂ ≫ c₂ ≫ (φ_BT₂ ≫ g_τ) := by simp only [CategoryTheory.Category.assoc]
      _ = u₂ ≫ (c₂ ≫ s_τ) ≫ φ_T₁ := by rw [hφ_nat, ← CategoryTheory.Category.assoc c₂]
      _ = (u₂ ≫ m_T₂) ≫ φ_T₁ := by rw [hc_s, CategoryTheory.Category.assoc]
      _ = adj₁.homEquiv R_mod 𝒢 (α_h ≫ φ) := hRHS.symm

  let β_h : Quiver.Hom (R_sh.obj one₂) one₁ :=
    (eConstR one₁).symm (CategoryTheory.CategoryStruct.id one₁)
  have hαβ : CategoryTheory.CategoryStruct.comp α_h β_h =
      CategoryTheory.CategoryStruct.id one₁ :=
    (heConstR_apply one₁ β_h).symm.trans (Equiv.apply_symm_apply (eConstR one₁) _)
  have hβα : CategoryTheory.CategoryStruct.comp β_h α_h =
      CategoryTheory.CategoryStruct.id (R_sh.obj one₂) := by
    apply (eConstR (R_sh.obj one₂)).injective
    rw [heConstR_apply, heConstR_apply, ← CategoryTheory.Category.assoc, hαβ,
      CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
  exact ⟨hc, hAdd, hColim, β_h, hαβ, hβα⟩

theorem weil_etale_postcomp_left_adjoint_ab4_preserves_limits_and_injectives {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
    (h : Quiver.Hom Y₁ Y₂) (hh : AlgebraicGeometry.Etale h) (m : ℕ)
    (hc : (weilEtalePostcomp h hh).IsContinuous
      Y₁.smallEtaleTopology Y₂.smallEtaleTopology) :
    let R := ULift.{u, 0} (ZMod m)
    letI := hc
    let R_sh := (weilEtalePostcomp h hh).sheafPushforwardContinuous
      (ModuleCat.{u, u} R) Y₁.smallEtaleTopology Y₂.smallEtaleTopology
    CategoryTheory.Limits.PreservesFiniteLimits R_sh ∧
    ∀ (ℐ : CategoryTheory.Sheaf Y₂.smallEtaleTopology (ModuleCat.{u, u} R))
      [CategoryTheory.Injective ℐ],
      CategoryTheory.Injective (R_sh.obj ℐ) :=
by
  have hop_eq : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀] {X Y : C₀}
      (f : X ⟶ Y),
      (Opposite.op f : Opposite.op Y ⟶ Opposite.op X) = f.op := by
    intro C₀ _ X Y f
    calc
      (Opposite.op f : Opposite.op Y ⟶ Opposite.op X)
        = (Opposite.op f : Opposite.op Y ⟶ Opposite.op X).unop.op := (Quiver.Hom.op_unop _).symm
      _ = f.op := congrArg Quiver.Hom.op Quiver.Hom.unop_op'
  have hop_comp : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀] {X Y Z : C₀}
      (f : X ⟶ Y) (g : Y ⟶ Z),
      @CategoryTheory.CategoryStruct.comp C₀ᵒᵖ _
        (Opposite.op Z) (Opposite.op Y) (Opposite.op X)
        (Opposite.op g) (Opposite.op f) =
        Opposite.op (f ≫ g) := by
    intro C₀ _ X Y Z f g
    rw [hop_eq f, hop_eq g, hop_eq (f ≫ g), ← CategoryTheory.op_comp]
  have hop_id : ∀ {C₀ : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C₀] (X : C₀),
      (Opposite.op (𝟙 X) : Opposite.op X ⟶ Opposite.op X) = 𝟙 (Opposite.op X) := by
    intro C₀ _ X
    rw [hop_eq, CategoryTheory.op_id]

  have hAbstractIndexedSiteAdj :
      ∀ {C₁ C₂ : Type (u + 1)}
        [CategoryTheory.Category.{u, u + 1} C₁]
        [CategoryTheory.Category.{u, u + 1} C₂]
        (J₁ : CategoryTheory.GrothendieckTopology C₁)
        (J₂ : CategoryTheory.GrothendieckTopology C₂)
        (R : Type u) [CommRing R]
        [CategoryTheory.HasSheafify J₂ (ModuleCat.{u, u} R)]
        (F : C₁ ⥤ C₂) [F.IsContinuous J₁ J₂]
        (W : C₂)
        (Z_obj : ∀ V : C₂, (V ⟶ W) → C₁)
        (u_tilde : ∀ {V' V : C₂} (u : V' ⟶ V) (φ : V ⟶ W),
          Z_obj V' (u ≫ φ) ⟶ Z_obj V φ)
        (π_Z : ∀ Z : C₁, F.obj Z ⟶ W)
        (e_Z : ∀ Z : C₁, Z_obj (F.obj Z) (π_Z Z) ⟶ Z)
        (κ_Vφ : ∀ (V : C₂) (φ : V ⟶ W), V ⟶ F.obj (Z_obj V φ))
        (h_ut_id : ∀ (V : C₂) (φ : V ⟶ W),
          u_tilde (𝟙 V) φ =
            CategoryTheory.eqToHom (congrArg (Z_obj V) (CategoryTheory.Category.id_comp φ)))
        (h_ut_comp : ∀ {V₃ V₂ V₁ : C₂} (g : V₃ ⟶ V₂) (f : V₂ ⟶ V₁) (φ : V₁ ⟶ W),
          CategoryTheory.eqToHom (congrArg (Z_obj V₃) (CategoryTheory.Category.assoc g f φ)) ≫
            (u_tilde g (f ≫ φ) ≫ u_tilde f φ) = u_tilde (g ≫ f) φ)
        (h_F_π : ∀ {Z₂ Z₁ : C₁} (u : Z₂ ⟶ Z₁), F.map u ≫ π_Z Z₁ = π_Z Z₂)
        (h_ut_e : ∀ {Z₂ Z₁ : C₁} (u : Z₂ ⟶ Z₁),
          u_tilde (F.map u) (π_Z Z₁) ≫ e_Z Z₁ =
            CategoryTheory.eqToHom (congrArg (Z_obj (F.obj Z₂)) (h_F_π u)) ≫ (e_Z Z₂ ≫ u))
        (h_κ_F : ∀ {V₂ V₁ : C₂} (g : V₂ ⟶ V₁) (φ : V₁ ⟶ W),
          κ_Vφ V₂ (g ≫ φ) ≫ F.map (u_tilde g φ) = g ≫ κ_Vφ V₁ φ)
        (h_κ_π : ∀ (V : C₂) (φ : V ⟶ W), κ_Vφ V φ ≫ π_Z (Z_obj V φ) = φ)
        (h_ut_κ_e : ∀ (V : C₂) (φ : V ⟶ W),
          u_tilde (κ_Vφ V φ) (π_Z (Z_obj V φ)) ≫ e_Z (Z_obj V φ) =
            CategoryTheory.eqToHom (congrArg (Z_obj V) (h_κ_π V φ)))
        (h_κ_Fe : ∀ Z : C₁, κ_Vφ (F.obj Z) (π_Z Z) ≫ F.map (e_Z Z) = 𝟙 (F.obj Z)),
        let R_sh := F.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₁ J₂
        CategoryTheory.Limits.PreservesFiniteLimits R_sh ∧
        ∀ (ℐ : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R))
          [CategoryTheory.Injective ℐ],
          CategoryTheory.Injective (R_sh.obj ℐ) := by
    intro C₁ C₂ _ _ J₁ J₂ R _ _ F _ W Z_obj u_tilde π_Z e_Z κ_Vφ
      h_ut_id h_ut_comp h_F_π h_ut_e h_κ_F h_κ_π h_ut_κ_e h_κ_Fe R_sh

    let fam : (C₁ᵒᵖ ⥤ ModuleCat.{u, u} R) → ∀ V : C₂, (V ⟶ W) → ModuleCat.{u, u} R :=
      fun P_pre V ψ => P_pre.obj (Opposite.op (Z_obj V ψ))

    have hIdxEq :
        ∀ {V : C₂} (P_pre : C₁ᵒᵖ ⥤ ModuleCat.{u, u} R) {ψ₁ ψ₂ : V ⟶ W} (hψ : ψ₁ = ψ₂),
          P_pre.map (Opposite.op (CategoryTheory.eqToHom (congrArg (Z_obj V) hψ))) ≫
            CategoryTheory.Limits.Sigma.ι (fam P_pre V) ψ₁ =
          CategoryTheory.Limits.Sigma.ι (fam P_pre V) ψ₂ := by
      intro V P_pre ψ₁ ψ₂ hψ
      subst hψ
      rw [CategoryTheory.eqToHom_refl, hop_id, P_pre.map_id, CategoryTheory.Category.id_comp]

    let L_pre_obj : (C₁ᵒᵖ ⥤ ModuleCat.{u, u} R) → (C₂ᵒᵖ ⥤ ModuleCat.{u, u} R) :=
      fun P_pre =>
        { obj := fun V_op => CategoryTheory.Limits.sigmaObj (fam P_pre V_op.unop)
          map := fun {V₁_op V₂_op} f =>
            CategoryTheory.Limits.Sigma.desc
              (fun φ : V₁_op.unop ⟶ W =>
                P_pre.map (Opposite.op (u_tilde f.unop φ)) ≫
                  CategoryTheory.Limits.Sigma.ι (fam P_pre V₂_op.unop) (f.unop ≫ φ))
          map_id := fun V_op => by
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro φ
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.comp_id]
            change P_pre.map (Opposite.op (u_tilde (𝟙 V_op.unop) φ)) ≫
              CategoryTheory.Limits.Sigma.ι (fam P_pre V_op.unop) (𝟙 V_op.unop ≫ φ) =
              CategoryTheory.Limits.Sigma.ι (fam P_pre V_op.unop) φ
            rw [h_ut_id V_op.unop φ]
            exact hIdxEq P_pre (CategoryTheory.Category.id_comp φ)
          map_comp := fun {V₁_op V₂_op V₃_op} f₁ f₂ => by
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro φ
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc,
              ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.Sigma.ι_comp_desc,
              CategoryTheory.Category.assoc,
              CategoryTheory.Limits.Sigma.ι_comp_desc]
            change P_pre.map (Opposite.op (u_tilde (f₂.unop ≫ f₁.unop) φ)) ≫
              CategoryTheory.Limits.Sigma.ι (fam P_pre V₃_op.unop) ((f₂.unop ≫ f₁.unop) ≫ φ) =
              P_pre.map (Opposite.op (u_tilde f₁.unop φ)) ≫
                P_pre.map (Opposite.op (u_tilde f₂.unop (f₁.unop ≫ φ))) ≫
                CategoryTheory.Limits.Sigma.ι (fam P_pre V₃_op.unop) (f₂.unop ≫ f₁.unop ≫ φ)
            rw [← h_ut_comp f₂.unop f₁.unop φ, ← hop_comp, ← hop_comp,
              P_pre.map_comp, P_pre.map_comp, CategoryTheory.Category.assoc,
              CategoryTheory.Category.assoc,
              hIdxEq P_pre (CategoryTheory.Category.assoc f₂.unop f₁.unop φ)] }

    let L_pre : (C₁ᵒᵖ ⥤ ModuleCat.{u, u} R) ⥤ (C₂ᵒᵖ ⥤ ModuleCat.{u, u} R) :=
      { obj := L_pre_obj
        map := fun {P_pre₁ P_pre₂} μ =>
          { app := fun V_op =>
              CategoryTheory.Limits.Sigma.desc
                (fun φ : V_op.unop ⟶ W =>
                  μ.app (Opposite.op (Z_obj V_op.unop φ)) ≫
                    CategoryTheory.Limits.Sigma.ι (fam P_pre₂ V_op.unop) φ)
            naturality := fun {V₁_op V₂_op} f => by
              apply CategoryTheory.Limits.Sigma.hom_ext
              intro φ
              calc
                CategoryTheory.Limits.Sigma.ι (fam P_pre₁ V₁_op.unop) φ ≫
                    ((L_pre_obj P_pre₁).map f ≫
                      CategoryTheory.Limits.Sigma.desc
                        (fun ψ : V₂_op.unop ⟶ W =>
                          μ.app (Opposite.op (Z_obj V₂_op.unop ψ)) ≫
                            CategoryTheory.Limits.Sigma.ι (fam P_pre₂ V₂_op.unop) ψ))
                  = (P_pre₁.map (Opposite.op (u_tilde f.unop φ)) ≫
                      μ.app (Opposite.op (Z_obj V₂_op.unop (f.unop ≫ φ)))) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre₂ V₂_op.unop) (f.unop ≫ φ) := by
                    rw [← CategoryTheory.Category.assoc,
                      CategoryTheory.Limits.Sigma.ι_comp_desc,
                      CategoryTheory.Category.assoc,
                      CategoryTheory.Limits.Sigma.ι_comp_desc,
                      ← CategoryTheory.Category.assoc]
                _ = (μ.app (Opposite.op (Z_obj V₁_op.unop φ)) ≫
                      P_pre₂.map (Opposite.op (u_tilde f.unop φ))) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre₂ V₂_op.unop) (f.unop ≫ φ) := by
                    rw [μ.naturality (Opposite.op (u_tilde f.unop φ))]
                _ = CategoryTheory.Limits.Sigma.ι (fam P_pre₁ V₁_op.unop) φ ≫
                      (CategoryTheory.Limits.Sigma.desc
                        (fun ψ : V₁_op.unop ⟶ W =>
                          μ.app (Opposite.op (Z_obj V₁_op.unop ψ)) ≫
                            CategoryTheory.Limits.Sigma.ι (fam P_pre₂ V₁_op.unop) ψ) ≫
                        (L_pre_obj P_pre₂).map f) := by
                    symm
                    rw [← CategoryTheory.Category.assoc,
                      CategoryTheory.Limits.Sigma.ι_comp_desc,
                      CategoryTheory.Category.assoc,
                      CategoryTheory.Limits.Sigma.ι_comp_desc,
                      ← CategoryTheory.Category.assoc] }
        map_id := fun P_pre => by
          ext V_op : 2
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro φ
          rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.NatTrans.id_app,
            CategoryTheory.Category.id_comp, CategoryTheory.NatTrans.id_app,
            CategoryTheory.Category.comp_id]
        map_comp := fun {P_pre₁ P_pre₂ P_pre₃} μ₁ μ₂ => by
          ext V_op : 2
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro φ
          calc
            CategoryTheory.Limits.Sigma.ι (fam P_pre₁ V_op.unop) φ ≫
                CategoryTheory.Limits.Sigma.desc
                  (fun ψ : V_op.unop ⟶ W =>
                    (μ₁ ≫ μ₂).app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre₃ V_op.unop) ψ)
              = (μ₁.app (Opposite.op (Z_obj V_op.unop φ)) ≫
                  μ₂.app (Opposite.op (Z_obj V_op.unop φ))) ≫
                  CategoryTheory.Limits.Sigma.ι (fam P_pre₃ V_op.unop) φ := by
                rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.NatTrans.comp_app]
            _ = CategoryTheory.Limits.Sigma.ι (fam P_pre₁ V_op.unop) φ ≫
                  (CategoryTheory.Limits.Sigma.desc
                    (fun ψ : V_op.unop ⟶ W =>
                      μ₁.app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                        CategoryTheory.Limits.Sigma.ι (fam P_pre₂ V_op.unop) ψ) ≫
                  CategoryTheory.Limits.Sigma.desc
                    (fun ψ : V_op.unop ⟶ W =>
                      μ₂.app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                        CategoryTheory.Limits.Sigma.ι (fam P_pre₃ V_op.unop) ψ)) := by
                symm
                rw [← CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.Sigma.ι_comp_desc,
                  CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.Sigma.ι_comp_desc,
                  ← CategoryTheory.Category.assoc] }

    have : L_pre.PreservesMonomorphisms :=
      ⟨fun {P_pre₁ P_pre₂} μ hMono => by
        have : ∀ V_op : C₂ᵒᵖ, CategoryTheory.Mono ((L_pre.map μ).app V_op) := fun V_op => by
          let IdxV : Type u := V_op.unop ⟶ W
          have : CategoryTheory.HasExactColimitsOfShape
              (CategoryTheory.Discrete IdxV) (ModuleCat.{u, u} R) :=
            CategoryTheory.AB4OfSize.ofShape IdxV
          let D₁ : CategoryTheory.Discrete IdxV ⥤ ModuleCat.{u, u} R :=
            CategoryTheory.Discrete.functor (fam P_pre₁ V_op.unop)
          let D₂ : CategoryTheory.Discrete IdxV ⥤ ModuleCat.{u, u} R :=
            CategoryTheory.Discrete.functor (fam P_pre₂ V_op.unop)
          let φ_nat : D₁ ⟶ D₂ :=
            { app := fun ⟨φ⟩ => μ.app (Opposite.op (Z_obj V_op.unop φ))
              naturality := fun {i j} f => by
                rcases i with ⟨p⟩
                rcases j with ⟨q⟩
                rcases CategoryTheory.Discrete.eq_of_hom f with rfl
                rw [Subsingleton.elim f (𝟙 _), D₁.map_id, D₂.map_id,
                  CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id] }
          have : ∀ j : CategoryTheory.Discrete IdxV, CategoryTheory.Mono (φ_nat.app j) :=
            fun ⟨φ⟩ => (CategoryTheory.NatTrans.mono_iff_mono_app μ).mp hMono _
          have : CategoryTheory.Mono φ_nat := CategoryTheory.NatTrans.mono_of_mono_app φ_nat
          exact CategoryTheory.Limits.colim.map_mono' φ_nat
            (CategoryTheory.Limits.colimit.isColimit D₁)
            (CategoryTheory.Limits.colimit.isColimit D₂)
            ((L_pre.map μ).app V_op)
            (fun ⟨φ⟩ => CategoryTheory.Limits.Sigma.ι_comp_desc _ φ)
        exact CategoryTheory.NatTrans.mono_of_mono_app (L_pre.map μ)⟩

    let R_pre : (C₂ᵒᵖ ⥤ ModuleCat.{u, u} R) ⥤ (C₁ᵒᵖ ⥤ ModuleCat.{u, u} R) :=
      (CategoryTheory.Functor.whiskeringLeft C₁ᵒᵖ C₂ᵒᵖ (ModuleCat.{u, u} R)).obj F.op

    let ePreLR : ∀ (P_pre : C₁ᵒᵖ ⥤ ModuleCat.{u, u} R) (Q_pre : C₂ᵒᵖ ⥤ ModuleCat.{u, u} R),
        (L_pre.obj P_pre ⟶ Q_pre) ≃ (P_pre ⟶ R_pre.obj Q_pre) := fun P_pre Q_pre =>
      { toFun := fun α =>
          { app := fun Z_op =>
              P_pre.map (Opposite.op (e_Z Z_op.unop)) ≫
                CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z_op.unop)) (π_Z Z_op.unop) ≫
                α.app (Opposite.op (F.obj Z_op.unop))
            naturality := fun {Z₁_op Z₂_op} f => by
              let Z₁ := Z₁_op.unop
              let Z₂ := Z₂_op.unop
              let u : Z₂ ⟶ Z₁ := f.unop
              symm
              calc
                (P_pre.map (Opposite.op (e_Z Z₁)) ≫
                    CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₁)) (π_Z Z₁) ≫
                    α.app (Opposite.op (F.obj Z₁))) ≫
                    Q_pre.map (F.map u).op
                  = P_pre.map (Opposite.op (e_Z Z₁)) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₁)) (π_Z Z₁) ≫
                      (α.app (Opposite.op (F.obj Z₁)) ≫ Q_pre.map (F.map u).op) := by
                    simp only [CategoryTheory.Category.assoc]
                _ = P_pre.map (Opposite.op (e_Z Z₁)) ≫
                      (CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₁)) (π_Z Z₁) ≫
                        (L_pre.obj P_pre).map (F.map u).op) ≫
                      α.app (Opposite.op (F.obj Z₂)) := by
                    rw [← α.naturality (F.map u).op, CategoryTheory.Category.assoc]
                _ = (P_pre.map (Opposite.op (e_Z Z₁)) ≫
                      P_pre.map (Opposite.op (u_tilde (F.map u) (π_Z Z₁)))) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₂))
                        (F.map u ≫ π_Z Z₁) ≫
                      α.app (Opposite.op (F.obj Z₂)) := by
                    have hDesc :
                        CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₁)) (π_Z Z₁) ≫
                          (L_pre.obj P_pre).map (F.map u).op =
                        P_pre.map (Opposite.op (u_tilde (F.map u) (π_Z Z₁))) ≫
                          CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₂))
                            (F.map u ≫ π_Z Z₁) :=
                      CategoryTheory.Limits.Sigma.ι_comp_desc _ (π_Z Z₁)
                    rw [hDesc]
                    simp only [CategoryTheory.Category.assoc]
                _ = P_pre.map (Opposite.op (u_tilde (F.map u) (π_Z Z₁) ≫ e_Z Z₁)) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₂))
                        (F.map u ≫ π_Z Z₁) ≫
                      α.app (Opposite.op (F.obj Z₂)) := by
                    rw [← P_pre.map_comp, hop_comp]
                _ = P_pre.map (Opposite.op u) ≫ P_pre.map (Opposite.op (e_Z Z₂)) ≫
                      (P_pre.map
                          (Opposite.op
                            (CategoryTheory.eqToHom (congrArg (Z_obj (F.obj Z₂)) (h_F_π u)))) ≫
                        CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₂))
                          (F.map u ≫ π_Z Z₁)) ≫
                      α.app (Opposite.op (F.obj Z₂)) := by
                    rw [h_ut_e u, ← hop_comp, ← hop_comp, P_pre.map_comp, P_pre.map_comp]
                    simp only [CategoryTheory.Category.assoc]
                _ = P_pre.map f ≫
                      P_pre.map (Opposite.op (e_Z Z₂)) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj Z₂)) (π_Z Z₂) ≫
                      α.app (Opposite.op (F.obj Z₂)) := by
                    rw [hIdxEq P_pre (h_F_π u), hop_eq u, Quiver.Hom.op_unop] }
        invFun := fun β =>
          { app := fun V_op =>
              CategoryTheory.Limits.Sigma.desc
                (fun φ : V_op.unop ⟶ W =>
                  β.app (Opposite.op (Z_obj V_op.unop φ)) ≫
                    Q_pre.map (κ_Vφ V_op.unop φ).op)
            naturality := fun {V₁_op V₂_op} f => by
              apply CategoryTheory.Limits.Sigma.hom_ext
              intro φ
              let V₁ := V₁_op.unop
              let V₂ := V₂_op.unop
              let g : V₂ ⟶ V₁ := f.unop
              calc
                CategoryTheory.Limits.Sigma.ι (fam P_pre V₁) φ ≫
                    ((L_pre.obj P_pre).map f ≫
                      CategoryTheory.Limits.Sigma.desc
                        (fun ψ : V₂ ⟶ W =>
                          β.app (Opposite.op (Z_obj V₂ ψ)) ≫ Q_pre.map (κ_Vφ V₂ ψ).op))
                  = (CategoryTheory.Limits.Sigma.ι (fam P_pre V₁) φ ≫
                      (L_pre.obj P_pre).map f) ≫
                      CategoryTheory.Limits.Sigma.desc
                        (fun ψ : V₂ ⟶ W =>
                          β.app (Opposite.op (Z_obj V₂ ψ)) ≫ Q_pre.map (κ_Vφ V₂ ψ).op) :=
                    (CategoryTheory.Category.assoc _ _ _).symm
                _ = P_pre.map (Opposite.op (u_tilde g φ)) ≫
                      (CategoryTheory.Limits.Sigma.ι (fam P_pre V₂) (g ≫ φ) ≫
                        CategoryTheory.Limits.Sigma.desc
                          (fun ψ : V₂ ⟶ W =>
                            β.app (Opposite.op (Z_obj V₂ ψ)) ≫ Q_pre.map (κ_Vφ V₂ ψ).op)) := by
                    have h1 :
                        CategoryTheory.Limits.Sigma.ι (fam P_pre V₁) φ ≫
                          (L_pre.obj P_pre).map f =
                        P_pre.map (Opposite.op (u_tilde g φ)) ≫
                          CategoryTheory.Limits.Sigma.ι (fam P_pre V₂) (g ≫ φ) :=
                      CategoryTheory.Limits.Sigma.ι_comp_desc _ φ
                    rw [h1, CategoryTheory.Category.assoc]
                _ = (P_pre.map (Opposite.op (u_tilde g φ)) ≫
                      β.app (Opposite.op (Z_obj V₂ (g ≫ φ)))) ≫
                      Q_pre.map (κ_Vφ V₂ (g ≫ φ)).op := by
                    rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.assoc]
                _ = β.app (Opposite.op (Z_obj V₁ φ)) ≫
                      (Q_pre.map (F.map (u_tilde g φ)).op ≫
                        Q_pre.map (κ_Vφ V₂ (g ≫ φ)).op) := by
                    rw [β.naturality (Opposite.op (u_tilde g φ))]
                    exact CategoryTheory.Category.assoc _ _ _
                _ = β.app (Opposite.op (Z_obj V₁ φ)) ≫
                      (Q_pre.map (κ_Vφ V₁ φ).op ≫ Q_pre.map f) := by
                    rw [← Q_pre.map_comp, ← CategoryTheory.op_comp, h_κ_F g φ,
                      CategoryTheory.op_comp, Q_pre.map_comp, Quiver.Hom.op_unop]
                _ = CategoryTheory.Limits.Sigma.ι (fam P_pre V₁) φ ≫
                      (CategoryTheory.Limits.Sigma.desc
                        (fun ψ : V₁ ⟶ W =>
                          β.app (Opposite.op (Z_obj V₁ ψ)) ≫ Q_pre.map (κ_Vφ V₁ ψ).op) ≫
                        Q_pre.map f) := by
                    rw [← CategoryTheory.Category.assoc (β.app _),
                      ← CategoryTheory.Limits.Sigma.ι_comp_desc
                        (fun ψ : V₁ ⟶ W =>
                          β.app (Opposite.op (Z_obj V₁ ψ)) ≫ Q_pre.map (κ_Vφ V₁ ψ).op) φ,
                      CategoryTheory.Category.assoc] }
        left_inv := fun α => by
          ext V_op : 2
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro φ
          let V := V_op.unop
          dsimp only
          calc
            CategoryTheory.Limits.Sigma.ι (fam P_pre V) φ ≫
                CategoryTheory.Limits.Sigma.desc
                  (fun ψ : V ⟶ W =>
                    (P_pre.map (Opposite.op (e_Z (Z_obj V ψ))) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj (Z_obj V ψ)))
                        (π_Z (Z_obj V ψ)) ≫
                      α.app (Opposite.op (F.obj (Z_obj V ψ)))) ≫
                      Q_pre.map (κ_Vφ V ψ).op)
              = P_pre.map (Opposite.op (e_Z (Z_obj V φ))) ≫
                  CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj (Z_obj V φ)))
                    (π_Z (Z_obj V φ)) ≫
                  (α.app (Opposite.op (F.obj (Z_obj V φ))) ≫ Q_pre.map (κ_Vφ V φ).op) := by
                rw [CategoryTheory.Limits.Sigma.ι_comp_desc]
                simp only [CategoryTheory.Category.assoc]
            _ = P_pre.map (Opposite.op (e_Z (Z_obj V φ))) ≫
                  (CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj (Z_obj V φ)))
                    (π_Z (Z_obj V φ)) ≫
                    (L_pre.obj P_pre).map (κ_Vφ V φ).op) ≫
                  α.app V_op := by
                rw [← α.naturality (κ_Vφ V φ).op, CategoryTheory.Category.assoc]
            _ = (P_pre.map (Opposite.op (e_Z (Z_obj V φ))) ≫
                  P_pre.map (Opposite.op (u_tilde (κ_Vφ V φ) (π_Z (Z_obj V φ))))) ≫
                  CategoryTheory.Limits.Sigma.ι (fam P_pre V)
                    (κ_Vφ V φ ≫ π_Z (Z_obj V φ)) ≫
                  α.app V_op := by
                have hDesc :
                    CategoryTheory.Limits.Sigma.ι (fam P_pre (F.obj (Z_obj V φ)))
                      (π_Z (Z_obj V φ)) ≫
                      (L_pre.obj P_pre).map (κ_Vφ V φ).op =
                    P_pre.map (Opposite.op (u_tilde (κ_Vφ V φ) (π_Z (Z_obj V φ)))) ≫
                      CategoryTheory.Limits.Sigma.ι (fam P_pre V)
                        (κ_Vφ V φ ≫ π_Z (Z_obj V φ)) :=
                  CategoryTheory.Limits.Sigma.ι_comp_desc _ (π_Z (Z_obj V φ))
                rw [hDesc]
                simp only [CategoryTheory.Category.assoc]
            _ = (P_pre.map
                  (Opposite.op (CategoryTheory.eqToHom (congrArg (Z_obj V) (h_κ_π V φ)))) ≫
                  CategoryTheory.Limits.Sigma.ι (fam P_pre V)
                    (κ_Vφ V φ ≫ π_Z (Z_obj V φ))) ≫
                  α.app V_op := by
                rw [← P_pre.map_comp, hop_comp, h_ut_κ_e V φ, CategoryTheory.Category.assoc]
            _ = CategoryTheory.Limits.Sigma.ι (fam P_pre V) φ ≫ α.app V_op := by
                rw [hIdxEq P_pre (h_κ_π V φ)]
        right_inv := fun β => by
          ext Z_op : 2
          dsimp only
          rw [CategoryTheory.Limits.Sigma.ι_comp_desc,
            ← CategoryTheory.Category.assoc,
            β.naturality (Opposite.op (e_Z Z_op.unop))]
          change (β.app Z_op ≫ Q_pre.map (F.map (e_Z Z_op.unop)).op) ≫
            Q_pre.map (κ_Vφ (F.obj Z_op.unop) (π_Z Z_op.unop)).op = β.app Z_op
          rw [CategoryTheory.Category.assoc, ← Q_pre.map_comp, ← CategoryTheory.op_comp,
            h_κ_Fe Z_op.unop, CategoryTheory.op_id]
          exact (congrArg (β.app Z_op ≫ ·)
            (Q_pre.map_id (Opposite.op (F.obj Z_op.unop)))).trans
            (CategoryTheory.Category.comp_id (β.app Z_op)) }

    let fgt₁ := CategoryTheory.sheafToPresheaf J₁ (ModuleCat.{u, u} R)
    let shf₂ := CategoryTheory.presheafToSheaf J₂ (ModuleCat.{u, u} R)
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction J₂ (ModuleCat.{u, u} R)
    let L_sh : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R) ⥤
        CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R) :=
      fgt₁ ⋙ L_pre ⋙ shf₂
    let eSh₁ : ∀ (ℱ : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R))
        (𝒢 : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R)),
        (fgt₁.obj ℱ ⟶ R_pre.obj 𝒢.obj) ≃ (ℱ ⟶ R_sh.obj 𝒢) := fun ℱ 𝒢 =>
      { toFun := fun η => ⟨η⟩
        invFun := fun f => f.hom
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }

    let adj_LR : L_sh ⊣ R_sh :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun ℱ 𝒢 =>
            (adj_sh₂.homEquiv (L_pre.obj (fgt₁.obj ℱ)) 𝒢).trans
              ((ePreLR (fgt₁.obj ℱ) 𝒢.obj).trans (eSh₁ ℱ 𝒢))
          homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} u w => by
            apply (adj_sh₂.homEquiv (L_pre.obj (fgt₁.obj ℱ')) 𝒢).injective
            change (adj_sh₂.homEquiv (L_pre.obj (fgt₁.obj ℱ')) 𝒢)
                ((adj_sh₂.homEquiv (L_pre.obj (fgt₁.obj ℱ')) 𝒢).symm
                  ((ePreLR (fgt₁.obj ℱ') 𝒢.obj).symm
                    ((eSh₁ ℱ' 𝒢).symm (u ≫ w)))) =
              (adj_sh₂.homEquiv (L_pre.obj (fgt₁.obj ℱ')) 𝒢)
                (shf₂.map (L_pre.map (fgt₁.map u)) ≫
                  (adj_sh₂.homEquiv (L_pre.obj (fgt₁.obj ℱ)) 𝒢).symm
                    ((ePreLR (fgt₁.obj ℱ) 𝒢.obj).symm
                      ((eSh₁ ℱ 𝒢).symm w)))
            rw [Equiv.apply_symm_apply, adj_sh₂.homEquiv_naturality_left,
              Equiv.apply_symm_apply]
            ext V_op : 2
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro φ
            change CategoryTheory.Limits.Sigma.ι (fam ℱ'.obj V_op.unop) φ ≫
                CategoryTheory.Limits.Sigma.desc
                  (fun ψ : V_op.unop ⟶ W =>
                    (u.hom.app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                      w.hom.app (Opposite.op (Z_obj V_op.unop ψ))) ≫
                      𝒢.obj.map (κ_Vφ V_op.unop ψ).op) =
              CategoryTheory.Limits.Sigma.ι (fam ℱ'.obj V_op.unop) φ ≫
                (CategoryTheory.Limits.Sigma.desc
                  (fun ψ : V_op.unop ⟶ W =>
                    u.hom.app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                      CategoryTheory.Limits.Sigma.ι (fam ℱ.obj V_op.unop) ψ) ≫
                CategoryTheory.Limits.Sigma.desc
                  (fun ψ : V_op.unop ⟶ W =>
                    w.hom.app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                      𝒢.obj.map (κ_Vφ V_op.unop ψ).op))
            calc
              CategoryTheory.Limits.Sigma.ι (fam ℱ'.obj V_op.unop) φ ≫
                  CategoryTheory.Limits.Sigma.desc
                    (fun ψ : V_op.unop ⟶ W =>
                      (u.hom.app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                        w.hom.app (Opposite.op (Z_obj V_op.unop ψ))) ≫
                        𝒢.obj.map (κ_Vφ V_op.unop ψ).op)
                = u.hom.app (Opposite.op (Z_obj V_op.unop φ)) ≫
                    (w.hom.app (Opposite.op (Z_obj V_op.unop φ)) ≫
                      𝒢.obj.map (κ_Vφ V_op.unop φ).op) := by
                  exact (CategoryTheory.Limits.Sigma.ι_comp_desc
                    (fun ψ : V_op.unop ⟶ W =>
                      (u.hom.app (Opposite.op (Z_obj V_op.unop ψ)) ≫
                        w.hom.app (Opposite.op (Z_obj V_op.unop ψ))) ≫
                        𝒢.obj.map (κ_Vφ V_op.unop ψ).op) φ).trans
                    (CategoryTheory.Category.assoc
