  let ηℤ₁ := (adjℤ₁.homEquiv Aℤ (U_std₁.obj one₁)).symm (ιℤ_mod ≫ u_std₁)
  let ηℤ₂ := (adjℤ₂.homEquiv Aℤ (U_std₂.obj one₂)).symm (ιℤ_mod ≫ u_std₂)
  let αM₁ := (adjℤ₁.homEquiv AM (U_std₁.obj one₁)).symm (ιM_mod ≫ u_std₁)
  let αM₂ := (adjℤ₂.homEquiv AM (U_std₂.obj one₂)).symm (ιM_mod ≫ u_std₂)

  let R_h_ab := Sigma_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₁ J₂

  letI : MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
