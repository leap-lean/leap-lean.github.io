    let lvlOpen : ∀ (W : S.Etale) (s : LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n)))
        (y : ↥(Fgt.obj W).left), ((Fgt.obj W).left).Opens :=
      fun _ s y => ⟨s ⁻¹' ({s y} : Set (ULift.{u} (ZMod n))), s.isLocallyConstant {s y}⟩

    have hΦ_inv_ex : ∀ (W : S.Etale)
        (s : LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n))),
        ∃! t : ↥(FM.obj.obj (Opposite.op W)),
