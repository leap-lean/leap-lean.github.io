                by_cases hx : U.hom x ∈ (V' : Set ↥C''.left)
                · have hsub_V : Set.range ⇑((O_gh x).ι ≫ (U.hom : U.left ⟶ C''.left)) ⊆
                      Set.range ⇑V'.ι := by
                    rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                    rintro _ ⟨y, rfl⟩
                    rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
                    exact hOg_inV U g x y.1 hx y.2.1
                  let u_gh : W_gh x ⟶ V''_et :=
                    CategoryTheory.MorphismProperty.Over.homMk
                      (@AlgebraicGeometry.IsOpenImmersion.lift _ _ C''.left V'.ι
                        ((O_gh x).ι ≫ (U.hom : U.left ⟶ C''.left)) hOpenV hsub_V)
                      (@AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ C''.left V'.ι
                        ((O_gh x).ι ≫ (U.hom : U.left ⟶ C''.left)) hOpenV hsub_V)
                      trivial
                  have hc_g := hθ_inV (j_gh x) u_gh g (g.1 x) (fun y => hOg_val U g x y.1 y.2.1)
                  have hc_h := hθ_inV (j_gh x) u_gh h (h.1 x) (fun y => hOg_val U h x y.1 y.2.2)
                  have hc_gh := hθ_inV (j_gh x) u_gh (g + h) (g.1 x + h.1 x)
                    (fun y => (LocallyConstant.add_apply g.1 h.1 y.1).trans
                      (congrArg₂ (· + ·) (hOg_val U g x y.1 y.2.1) (hOg_val U h x y.1 y.2.2)))
                  have h_add_ξ : (L_V.obj.map u_gh.op).hom (ξ₀.hom (g.1 x)) +
                      (L_V.obj.map u_gh.op).hom (ξ₀.hom (h.1 x)) =
                      (L_V.obj.map u_gh.op).hom (ξ₀.hom (g.1 x + h.1 x)) := by
                    let a₁ : ↥AM := g.1 x
                    let a₂ : ↥AM := h.1 x
                    change (L_V.obj.map u_gh.op).hom (ξ₀.hom a₁) +
                        (L_V.obj.map u_gh.op).hom (ξ₀.hom a₂) =
                      (L_V.obj.map u_gh.op).hom (ξ₀.hom (a₁ + a₂))
                    rw [ξ₀.hom.map_add, (L_V.obj.map u_gh.op).hom.map_add]
                  exact (congrArg₂ (· + ·) hc_g hc_h).trans (h_add_ξ.trans hc_gh.symm)
                · have hg0 : ∀ y : ↥(W_gh x).left, g.1 ((j_gh x).left y) = 0 :=
                    fun y => (hOg_val U g x y.1 y.2.1).trans (g.2 x hx)
                  have hh0 : ∀ y : ↥(W_gh x).left, h.1 ((j_gh x).left y) = 0 :=
                    fun y => (hOg_val U h x y.1 y.2.2).trans (h.2 x hx)
                  have hgh0 : ∀ y : ↥(W_gh x).left, (g + h).1 ((j_gh x).left y) = 0 :=
