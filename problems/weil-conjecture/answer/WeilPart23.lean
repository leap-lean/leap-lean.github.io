      exact (hs₀_uniq s₁ (fun _ _ hf => False.elim hf)).trans
        (hs₀_uniq s₂ (fun _ _ hf => False.elim hf)).symm
    let openSub : ∀ (U : S.Etale) (O : U.left.Opens), S.Etale :=
      fun U O =>
        haveI : AlgebraicGeometry.Etale U.hom := U.prop
        CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ U.hom) inferInstance
    let openSubHom : ∀ (U : S.Etale) (O : U.left.Opens), openSub U O ⟶ U :=
      fun U O => CategoryTheory.MorphismProperty.Over.homMk O.ι rfl
    let S_lvl : ∀ (U : S.Etale), LocallyConstant ↥U.left (ZMod ℓ) → CategoryTheory.Sieve U :=
      fun U g =>
        { arrows := fun V f => ∃ a : ZMod ℓ, ∀ y : ↥V.left, g (f.left y) = a
          downward_closed := by
            rintro V V' f ⟨a, ha⟩ f'
            refine ⟨a, fun z => ?_⟩
            change g ((f'.left ≫ f.left) z) = a
            rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
            exact ha (f'.left z) }
    have hS_lvl_mem : ∀ (U : S.Etale) (g : LocallyConstant ↥U.left (ZMod ℓ)),
        S_lvl U g ∈ J U := by
      intro U g
      refine (hJ_iff U (S_lvl U g)).mpr (fun x => ?_)
      let O : U.left.Opens := ⟨g ⁻¹' {g x}, g.isLocallyConstant {g x}⟩
      refine ⟨openSub U O, openSubHom U O, ⟨x, rfl⟩, ⟨g x, fun y => y.2⟩, ?_, rfl⟩
      change AlgebraicGeometry.Etale O.ι
      infer_instance
    have hη_lvl_indep : ∀ {U V : S.Etale} {g : LocallyConstant ↥U.left (ZMod ℓ)}
        (f : V ⟶ U) {a₁ a₂ : ZMod ℓ},
        (∀ y : ↥V.left, g (f.left y) = a₁) →
        (∀ y : ↥V.left, g (f.left y) = a₂) →
        (η_sh.app (Opposite.op V)).hom (ULift.up a₁) =
