          (D₀ b).ι ≫ B₀.hom ≫ p₀_pt :=
      fun b => (Classical.choose_spec (Classical.choose_spec (hChartData b))).2.2

    obtain ⟨hSmP₁, hP₁Fib⟩ := weil_projLine_smooth_and_baseChange_krullDim_one k

    have hSm_p₂ : AlgebraicGeometry.SmoothOfRelativeDimension 1 p₂.left := by
      rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
      intro z
      have hb_iSup : p₂.left.base z ∈ ⨆ b : Fin (m + 1), D₀ b := by
        rw [hCovD₀]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hb_iSup
      obtain ⟨b, hb⟩ := hb_iSup
      let W_b : P_tilde.left.Opens := p₂.left ⁻¹ᵁ D₀ b
      let j : W_b.toScheme ⟶ P_tilde.left := W_b.ι
      have hSm_fst : AlgebraicGeometry.SmoothOfRelativeDimension 1
          (CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) :=
        (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1).of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback ((D₀ b).ι ≫ B₀.hom) P₁.hom).flip hSmP₁
      have hSm_res : AlgebraicGeometry.SmoothOfRelativeDimension 1 (p₂.left ∣_ D₀ b) := by
        have heq_res : p₂.left ∣_ D₀ b =
            (eΨ b).inv ≫ CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom := by
          rw [← heΨ_p₂ b, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
            CategoryTheory.Category.id_comp]
        rw [heq_res]
        have : AlgebraicGeometry.SmoothOfRelativeDimension 0 (eΨ b).inv := inferInstance
        have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1)
            ((eΨ b).inv ≫ CategoryTheory.Limits.pullback.fst ((D₀ b).ι ≫ B₀.hom) P₁.hom) :=
          inferInstance
        rwa [Nat.zero_add] at h01
      have hSm_Wb : AlgebraicGeometry.SmoothOfRelativeDimension 1 (j ≫ p₂.left) := by
        change AlgebraicGeometry.SmoothOfRelativeDimension 1 ((p₂.left ⁻¹ᵁ D₀ b).ι ≫ p₂.left)
        rw [← AlgebraicGeometry.morphismRestrict_ι p₂.left (D₀ b)]
        have : AlgebraicGeometry.SmoothOfRelativeDimension 0 (D₀ b).ι := inferInstance
        have h10 : AlgebraicGeometry.SmoothOfRelativeDimension (1 + 0)
