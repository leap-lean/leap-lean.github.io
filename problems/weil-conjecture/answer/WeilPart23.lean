      have hvu_cl : v_cl ≫ u_cl = 𝟙 (ι_inc ⁻¹ᵁ Q_b).toScheme := by
        rw [← CategoryTheory.cancel_mono (ι_inc ∣_ Q_b), CategoryTheory.Category.assoc, hu_cl, hv_cl,
