    rw [map_mul φ_z] at h_app
    have hr_y : φ_z r_y = (v' : ↑(V₀.toScheme.presheaf.stalk z)) := by
      have h_inv : (V₀.stalkIso z).inv = V₀.ι.stalkMap z :=
        AlgebraicGeometry.Scheme.Opens.stalkIso_inv V₀ z
      have h_id : (V₀.stalkIso z).hom ≫ V₀.ι.stalkMap z = 𝟙 _ := by
        rw [← h_inv, CategoryTheory.Iso.hom_inv_id]
      exact congrArg (fun ψ => CommRingCat.Hom.hom ψ (v' : _)) h_id
    rw [hr_y] at h_app
    exact h_app

