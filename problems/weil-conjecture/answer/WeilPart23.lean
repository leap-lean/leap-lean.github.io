            (CategoryTheory.Limits.pullback.snd (FgtX.map u₀).left
              (CategoryTheory.Limits.pullback.fst (FgtX.obj U).hom g) ≫
              CategoryTheory.Limits.pullback.snd (FgtX.obj U).hom g)
            (by
              have hu₀_w : (FgtX.map u₀).left ≫ (FgtX.obj U).hom = (FgtX.obj U₀).hom :=
                CategoryTheory.MorphismProperty.Over.w u₀
