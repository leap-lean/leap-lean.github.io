      rw [hFac_ab, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc (Ψ_M y')
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap X ℓ v_X))
          (CategoryTheory.Abelian.Ext.mk₀ counit_T_ab)
          (Nat.add_zero 2) (Nat.add_zero 0) (Nat.add_zero 2)]
      change (weilEtaleLocalTorsionMapH X ℓ v_X 2 (Ψ_M y')).comp
        (CategoryTheory.Abelian.Ext.mk₀ counit_T_ab) (Nat.add_zero 2) = 0
      rw [hab_v0, CategoryTheory.Abelian.Ext.zero_comp]
    rw [hΨM_counit y', hy'] at hcounit_ab0
    exact hu₀_ne hcounit_ab0

theorem weil_etale_curve_open_prime_kummer_cyclic_cover (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C_bar.left]
    (hProjC : IsProjectiveOverField k C_bar)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom]
    (hKum : ∀ Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)),
      CategoryTheory.Presheaf.IsSheaf Y.left.smallEtaleTopology (weilEtaleGmPresheaf Y.left) ∧
      ∃ (ι_kum : weilEtaleTorsionSheaf Y.left ℓ ⟶ weilEtaleGmSheaf Y.left)
        (p_kum : weilEtaleGmSheaf Y.left ⟶ weilEtaleGmSheaf Y.left)
        (h0 : ι_kum ≫ p_kum = 0),
        p_kum = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y.left) ∧
        (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact)
    (hProjCurveH2 : ∀ (C' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C'.left],
      IsProjectiveOverField k C' →
      ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C'.hom],
        Nonempty ((weilEtaleGmSheaf C'.left).H 1 ≃+ weilCurveClGroup C'.left) ∧
        Subsingleton ((weilEtaleGmSheaf C'.left).H 2) ∧
        Nat.card (weilCupPDModH C'.left ℓ 2) = ℓ)
    (V : C_bar.left.Opens) (V_et : C_bar.left.Etale)
    (e_V : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj V_et).left
      V.toScheme)
    (hNe_V : Nonempty ↥V)
    (he_V : CategoryTheory.CategoryStruct.comp e_V.hom V.ι =
      ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj V_et).hom)
    (s : weilEtaleTorsionH V.toScheme ℓ 1) (hs_ne : s ≠ 0) :
    ∃ (V'_et : C_bar.left.Etale)
      (p_et : Quiver.Hom V'_et V_et)
      (σ_et : Quiver.Hom V'_et V'_et),
      let L := weilCupPDLocalFreeSheaf C_bar.left ℓ V_et
      let M := weilCupPDLocalFreeSheaf C_bar.left ℓ V'_et
      let π : Quiver.Hom M L := weilCupPDLocalFreeMap C_bar.left ℓ p_et
      let τ : Quiver.Hom M M :=
        weilCupPDLocalFreeMap C_bar.left ℓ σ_et - CategoryTheory.CategoryStruct.id M
      let V'_sch := ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj V'_et).left
      (∃ p₁ : weilEtaleTorsionH V.toScheme ℓ 1 →+ weilEtaleTorsionH V'_sch ℓ 1,
        WeilIsTorsionEtalePullback
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).map p_et).left e_V.hom)
          ℓ 1 p₁ ∧
        p₁ s = 0) ∧
      CategoryTheory.Epi π ∧
      (∃ h0 : CategoryTheory.CategoryStruct.comp τ π = 0,
        (CategoryTheory.ShortComplex.mk τ π h0).Exact) ∧
      Nat.card (CategoryTheory.Abelian.Ext.{u} M (weilCupPDModUnit C_bar.left ℓ) 0) = ℓ ∧
      Nat.card (weilCupPDLocalModH C_bar.left ℓ V'_et 2) = ℓ ∧
      (∃ z_M : weilCupPDLocalModH C_bar.left ℓ V'_et 2,
        z_M.comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalCounit C_bar.left ℓ V'_et))
          (Nat.add_zero 2) ≠ 0) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  let X : AlgebraicGeometry.Scheme.{u} := C_bar.left

  
  have hOpenGeom :
      ∀ (C_cur : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C_cur.left],
        IsProjectiveOverField k C_cur →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_cur.hom]
          (U_cur : C_cur.left.Opens),
          Nonempty ↥U_cur →
          AlgebraicGeometry.IsProper C_cur.hom ∧
          CompactSpace ↥C_cur.left ∧
          C_cur.left.IsSeparated ∧
          TopologicalSpace.NoetherianSpace ↥C_cur.left ∧
          AlgebraicGeometry.IsIntegral U_cur.toScheme ∧
          CompactSpace ↥U_cur.toScheme ∧
          U_cur.toScheme.IsSeparated ∧
          AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_cur.ι ≫ C_cur.hom) := by
    intro C_cur _ hProjCur _ U_cur hNeCur
    have hPropCur : AlgebraicGeometry.IsProper C_cur.hom := by
      rcases hProjCur with ⟨N, ι, hClosed_ι⟩
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let α₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
      have hα₀_bij : Function.Bijective α₀ := by
        constructor
        · intro c₁ c₂ hc
          exact MvPolynomial.C_injective (Fin (N + 1)) k (congrArg Subtype.val hc)
        · rintro ⟨p, hp⟩
          have hp' : p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := hp
          rw [MvPolynomial.homogeneousSubmodule_zero] at hp'
          obtain ⟨c, rfl⟩ := Submodule.mem_one.mp hp'
          exact ⟨c, Subtype.ext rfl⟩
      let e₀ : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective α₀ hα₀_bij
      have : CategoryTheory.IsIso (CommRingCat.ofHom α₀) :=
        ⟨⟨CommRingCat.ofHom e₀.symm.toRingHom,
          CommRingCat.hom_ext (RingHom.ext e₀.symm_apply_apply),
          CommRingCat.hom_ext (RingHom.ext e₀.apply_symm_apply)⟩⟩
      have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)) :=
        inferInstance
      have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (N + 1)) k)
          fun _ => rfl
      have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
      have : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
      have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
        dsimp [weilProjectiveSpaceOver]
        infer_instance
      have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed_ι
      rw [← CategoryTheory.Over.w ι]
      infer_instance
    have : AlgebraicGeometry.IsProper C_cur.hom := hPropCur
    have hCompCur : CompactSpace ↥C_cur.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace C_cur.hom
    have hSepSpec : (AlgebraicGeometry.Spec (CommRingCat.of k)).IsSeparated := inferInstance
    have : AlgebraicGeometry.IsSeparated
        (CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k))) :=
      hSepSpec.isSeparated_terminal_from
    have hTermCur : C_cur.hom ≫
        CategoryTheory.Limits.terminal.from (AlgebraicGeometry.Spec (CommRingCat.of k)) =
        CategoryTheory.Limits.terminal.from C_cur.left :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    have hSepCur : C_cur.left.IsSeparated := by
      refine AlgebraicGeometry.Scheme.IsSeparated.mk ?_
      rw [← hTermCur]
      infer_instance
    have : AlgebraicGeometry.IsLocallyNoetherian C_cur.left :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian C_cur.hom
    have : AlgebraicGeometry.IsNoetherian C_cur.left :=
      (AlgebraicGeometry.isNoetherian_iff C_cur.left).mpr ⟨inferInstance, hCompCur⟩
    have hNoethCur : TopologicalSpace.NoetherianSpace ↥C_cur.left :=
      AlgebraicGeometry.IsNoetherian.noetherianSpace
    have hIntU : AlgebraicGeometry.IsIntegral U_cur.toScheme := by
      have : IrreducibleSpace ↥C_cur.left :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral C_cur.left
      have _ : PreirreducibleSpace ↥U_cur.toScheme :=
        { isPreirreducible_univ := fun O₁ O₂ hO₁ hO₂ ⟨x₁, _, hx₁⟩ ⟨x₂, _, hx₂⟩ => by
            have hEmb := U_cur.ι.isOpenEmbedding
            obtain ⟨z, ⟨y₁, hy₁, rfl⟩, ⟨y₂, hy₂, hz_eq⟩⟩ :=
              nonempty_preirreducible_inter
                (hEmb.isOpenMap O₁ hO₁) (hEmb.isOpenMap O₂ hO₂)
                ⟨U_cur.ι.base x₁, x₁, hx₁, rfl⟩
                ⟨U_cur.ι.base x₂, x₂, hx₂, rfl⟩
            have hy_eq : y₁ = y₂ := hEmb.injective hz_eq.symm
            subst hy_eq
            exact ⟨y₁, trivial, hy₁, hy₂⟩ }
      have : IrreducibleSpace ↥U_cur.toScheme := ⟨hNeCur⟩
      exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced U_cur.toScheme
    have hCompU : CompactSpace ↥U_cur.toScheme := by
      have hCompSet : IsCompact (Set.range U_cur.ι.base) :=
        TopologicalSpace.NoetherianSpace.isCompact (Set.range U_cur.ι.base)
      exact ⟨U_cur.ι.isOpenEmbedding.isInducing.isCompact_iff.mpr
        (by simpa [Set.image_univ] using hCompSet)⟩
    have hSepU : U_cur.toScheme.IsSeparated := by
      have : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from C_cur.left) :=
        hSepCur.isSeparated_terminal_from
      have hTermU : U_cur.ι ≫ CategoryTheory.Limits.terminal.from C_cur.left =
          CategoryTheory.Limits.terminal.from U_cur.toScheme :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      refine AlgebraicGeometry.Scheme.IsSeparated.mk ?_
      rw [← hTermU]
      infer_instance
    have hSmU : AlgebraicGeometry.SmoothOfRelativeDimension 1 (U_cur.ι ≫ C_cur.hom) := by
      have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (U_cur.ι ≫ C_cur.hom) :=
        inferInstance
      simpa using h01
    exact ⟨hPropCur, hCompCur, hSepCur, hNoethCur, hIntU, hCompU, hSepU, hSmU⟩

  obtain ⟨hPropC, hCompC, hSepC, _, hIntV, hCompV, hSepV, hSmV⟩ :=
    hOpenGeom C_bar hProjC V hNe_V
  have : CompactSpace ↥C_bar.left := hCompC
  have : C_bar.left.IsSeparated := hSepC
  have : AlgebraicGeometry.IsIntegral V.toScheme := hIntV
  have : CompactSpace ↥V.toScheme := hCompV
  have : V.toScheme.IsSeparated := hSepV
  let V_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (V.ι ≫ C_bar.hom)
  have : AlgebraicGeometry.IsIntegral V_ov.left := hIntV
  have : CompactSpace ↥V_ov.left := hCompV
  have : V_ov.left.IsSeparated := hSepV
  have : AlgebraicGeometry.SmoothOfRelativeDimension 1 V_ov.hom := hSmV
  have hDimC : topologicalKrullDim C_bar.left = (1 : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k 1 C_bar inferInstance
  have hDim_V : topologicalKrullDim V_ov.left = (1 : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k 1 V_ov hIntV

  
  have hGmSheaf := weil_etale_gm_isSheaf_and_proj_H0_divisible.{u}.1
  obtain ⟨hKSheaf_V, Div_sh, ι_gm, div_mor, h0_div, valDiv, hSE_div, hValProp, -, -⟩ :=
    weil_etale_curve_weil_divisor_short_exact k V_ov hGmSheaf
  have hSub_H1K : Subsingleton ((weilEtaleKSheaf V_ov.left).H 1) := by
    apply weil_etale_qc_sep_cech_vanishing_implies_H_subsingleton V_ov.left
      (weilEtaleKSheaf V_ov.left) _ 1 le_rfl
    intro U W _ _ _ w _ p_cech c hc
    let isoK : weilEtaleKPresheaf V_ov.left ≅ (weilEtaleKSheaf V_ov.left).obj :=
      CategoryTheory.isoSheafify V_ov.left.smallEtaleTopology hKSheaf_V
    have hDiffInv : ∀ (m : ℕ)
        (x : ↥((weilEtaleKSheaf V_ov.left).obj.obj (Opposite.op (weilEtaleCechObj w m)))),
        (isoK.inv.app (Opposite.op (weilEtaleCechObj w (m + 1)))).hom
          (weilEtaleCechDiff (weilEtaleKSheaf V_ov.left).obj w m x) =
        weilEtaleCechDiff (weilEtaleKPresheaf V_ov.left) w m
          ((isoK.inv.app (Opposite.op (weilEtaleCechObj w m))).hom x) := by
      intro m x
      dsimp [weilEtaleCechDiff]
      rw [AddMonoidHom.finsetSum_apply, AddMonoidHom.finsetSum_apply, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [AddMonoidHom.smul_apply, AddMonoidHom.smul_apply, map_zsmul]
      congr 1
      exact congrArg (fun φ => φ.hom x) (isoK.inv.naturality (weilEtaleCechFace w m j).op)
    have hDiffHom : ∀ (m : ℕ)
        (x : ↥((weilEtaleKPresheaf V_ov.left).obj (Opposite.op (weilEtaleCechObj w m)))),
        (isoK.hom.app (Opposite.op (weilEtaleCechObj w (m + 1)))).hom
          (weilEtaleCechDiff (weilEtaleKPresheaf V_ov.left) w m x) =
        weilEtaleCechDiff (weilEtaleKSheaf V_ov.left).obj w m
          ((isoK.hom.app (Opposite.op (weilEtaleCechObj w m))).hom x) := by
      intro m x
      dsimp [weilEtaleCechDiff]
      rw [AddMonoidHom.finsetSum_apply, AddMonoidHom.finsetSum_apply, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [AddMonoidHom.smul_apply, AddMonoidHom.smul_apply, map_zsmul]
      congr 1
      exact congrArg (fun φ => φ.hom x) (isoK.hom.naturality (weilEtaleCechFace w m j).op)
    let c₀ := (isoK.inv.app (Opposite.op (weilEtaleCechObj w (p_cech + 1)))).hom c
    have hc₀ : weilEtaleCechDiff (weilEtaleKPresheaf V_ov.left) w (p_cech + 1) c₀ = 0 := by
      rw [← hDiffInv (p_cech + 1) c, hc, map_zero]
    obtain ⟨b₀, hb₀⟩ :=
      weil_etale_curve_generic_gm_cech_vanishing k V_ov
        (fun E L _ _ _ _ _ _ _ n hn =>
          weil_tsen_c1_galois_units_cohomology_vanishing k E L n hn)
        U W w p_cech c₀ hc₀
    refine ⟨(isoK.hom.app (Opposite.op (weilEtaleCechObj w p_cech))).hom b₀, ?_⟩
    rw [← hDiffHom p_cech b₀, hb₀]
    exact congrArg (fun φ => φ.hom c)
      (isoK.inv_hom_id_app (Opposite.op (weilEtaleCechObj w (p_cech + 1))))

  obtain ⟨_, ι_kum, p_kum, h0_kum, hp_kum, hSE_kum⟩ := hKum V_ov
  have hDiv_torsFree :
      ∀ (W_sh : CategoryTheory.Sheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u})
        (d_mor : W_sh ⟶ Div_sh), ℓ • d_mor = 0 → d_mor = 0 := by
    intro W_sh d_mor hd_zero
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext U_op
    rcases U_op with ⟨U⟩
    let EV : CategoryTheory.Sheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u} ⥤
        AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite V_ov.left.Etale) AddCommGrpCat.{u}).obj
          (Opposite.op U)
    change EV.map d_mor = 0
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro w
    change (EV.map d_mor).hom w = 0
    have h_ev0 : (EV.map (ℓ • d_mor)).hom w = 0 := by
      rw [hd_zero, EV.map_zero]
      rfl
    rw [CategoryTheory.Functor.map_nsmul] at h_ev0
    have h_nsmul_w : ∀ (n : ℕ) (f_hom : EV.obj W_sh ⟶ EV.obj Div_sh),
        (n • f_hom).hom w = n • f_hom.hom w := by
      intro n f_hom
      induction n with
      | zero => simp
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih]
    rw [h_nsmul_w ℓ (EV.map d_mor)] at h_ev0
    apply (hValProp U).1
    rw [map_zero]
    ext y
    have hy0 : (valDiv U (ℓ • (EV.map d_mor).hom w)) y = 0 := by
      rw [h_ev0, map_zero, Pi.zero_apply]
    rw [map_nsmul, Pi.smul_apply, nsmul_eq_mul] at hy0
    rcases mul_eq_zero.mp hy0 with hℓ0 | hval0
    · exact absurd (Int.ofNat_eq_zero.mp hℓ0) hPrime.ne_zero
    · exact hval0

  let Fℤ_V := (CategoryTheory.constantSheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let T_sh := weilEtaleTorsionSheaf V_ov.left ℓ
  let Gm_sh := weilEtaleGmSheaf V_ov.left
  let K_sh := weilEtaleKSheaf V_ov.left
  have : CategoryTheory.Mono ι_kum := hSE_kum.mono_f
  have : CategoryTheory.Mono ι_gm := hSE_div.mono_f
  let j_kum : T_sh ⟶ K_sh := ι_kum ≫ ι_gm
  have : CategoryTheory.Mono j_kum := CategoryTheory.mono_comp ι_kum ι_gm
  let ψ_K : K_sh ⟶ K_sh := ℓ • CategoryTheory.CategoryStruct.id K_sh
  have hj_ψ : j_kum ≫ ψ_K = 0 := by
    dsimp [j_kum, ψ_K]
    have h1 : ι_gm ≫ (ℓ • CategoryTheory.CategoryStruct.id K_sh) = p_kum ≫ ι_gm := by
      rw [hp_kum, CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
        CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp]
    rw [CategoryTheory.Category.assoc, h1, ← CategoryTheory.Category.assoc,
      h0_kum, CategoryTheory.Limits.zero_comp]
  have hk_lift : ∀ {W_sh : CategoryTheory.Sheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u}}
      (k_mor : W_sh ⟶ K_sh), k_mor ≫ ψ_K = 0 →
      ∃ t_mor : W_sh ⟶ T_sh, t_mor ≫ j_kum = k_mor := by
    intro W_sh k_mor hk
    have hk_div : k_mor ≫ div_mor = 0 := by
      apply hDiv_torsFree W_sh (k_mor ≫ div_mor)
      have h1 : ℓ • (k_mor ≫ div_mor) = (k_mor ≫ ψ_K) ≫ div_mor := by
        dsimp [ψ_K]
        rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
          CategoryTheory.Preadditive.nsmul_comp]
      rw [h1, hk, CategoryTheory.Limits.zero_comp]
    let g_mor : W_sh ⟶ Gm_sh := hSE_div.exact.lift k_mor hk_div
    have hg_fac : g_mor ≫ ι_gm = k_mor :=
      CategoryTheory.ShortComplex.Exact.lift_f hSE_div.exact k_mor hk_div
    have hg_kum : g_mor ≫ p_kum = 0 := by
      rw [← CategoryTheory.cancel_mono ι_gm, CategoryTheory.Limits.zero_comp,
        CategoryTheory.Category.assoc, hp_kum, CategoryTheory.Preadditive.nsmul_comp,
        CategoryTheory.Category.id_comp, CategoryTheory.Preadditive.comp_nsmul, hg_fac]
      have hk' : ℓ • k_mor = k_mor ≫ ψ_K := by
        dsimp [ψ_K]
        rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
      rw [hk', hk]
    let t_mor : W_sh ⟶ T_sh := hSE_kum.exact.lift g_mor hg_kum
    have ht_fac : t_mor ≫ ι_kum = g_mor :=
      CategoryTheory.ShortComplex.Exact.lift_f hSE_kum.exact g_mor hg_kum
    exact ⟨t_mor, by dsimp [j_kum]; rw [← CategoryTheory.Category.assoc, ht_fac, hg_fac]⟩
  let Q_sh := CategoryTheory.Abelian.image ψ_K
  let q_K : K_sh ⟶ Q_sh := CategoryTheory.Abelian.factorThruImage ψ_K
  let i_Q : Q_sh ⟶ K_sh := CategoryTheory.Abelian.image.ι ψ_K
  have hfac_Q : q_K ≫ i_Q = ψ_K := CategoryTheory.Abelian.image.fac ψ_K
  have h0_jq : j_kum ≫ q_K = 0 := by
    rw [← CategoryTheory.cancel_mono i_Q, CategoryTheory.Limits.zero_comp,
      CategoryTheory.Category.assoc, hfac_Q]
    exact hj_ψ
  let hKer_jq : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι j_kum h0_jq) :=
    CategoryTheory.Limits.KernelFork.IsLimit.ofι j_kum h0_jq
      (fun k_mor hk => Classical.choose
        (hk_lift k_mor (by rw [← hfac_Q, ← CategoryTheory.Category.assoc, hk,
          CategoryTheory.Limits.zero_comp])))
      (fun k_mor hk => Classical.choose_spec
        (hk_lift k_mor (by rw [← hfac_Q, ← CategoryTheory.Category.assoc, hk,
          CategoryTheory.Limits.zero_comp])))
      (fun k_mor hk m hm => by
        rw [← CategoryTheory.cancel_mono j_kum, hm]
        exact (Classical.choose_spec
          (hk_lift k_mor (by rw [← hfac_Q, ← CategoryTheory.Category.assoc, hk,
