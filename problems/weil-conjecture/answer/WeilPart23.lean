      have hy : y = 0 :=
        (congrArg (fun f : M_W ⟶ M_W => AddCommGrpCat.Hom.hom f y) hid).symm
      exact hx.trans hy.symm

    have hGlueArrows : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale)
