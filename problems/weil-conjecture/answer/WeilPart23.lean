  letI : Algebra k F := φ_k_F_cat.hom.toAlgebra
  let P_f : Polynomial F := (Polynomial.X : Polynomial F) ^ ℓ - Polynomial.C f.val
  have hEt_FL : Algebra.Etale F (AdjoinRoot P_f) := (hEtQ F f).1

  have hFieldKum :
      ∃ hIrred : Irreducible P_f,
