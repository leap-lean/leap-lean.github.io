        exact hL.trans ((congrArg (ℱ.obj.map f₁₂.op) hx_eq).trans hR.symm)
      · refine ⟨fun {U S} hS => ?_⟩
        rw [hJX] at hS
        rw [hJV']
        refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (B_g.obj U) _).mpr ?_
        intro z
        let x_U : ↥(FgtX.obj U).left :=
          (CategoryTheory.Limits.pullback.fst (FgtX.obj U).hom g).base z
        obtain ⟨U₀, u₀, y₀, hu₀, -, hy₀⟩ :=
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U S).mp hS x_U
        obtain ⟨p₀, -, hp₀_snd⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := (FgtX.map u₀).left)
            (g := CategoryTheory.Limits.pullback.fst (FgtX.obj U).hom g) y₀ z hy₀
        let ψ : CategoryTheory.Limits.pullback (FgtX.map u₀).left
