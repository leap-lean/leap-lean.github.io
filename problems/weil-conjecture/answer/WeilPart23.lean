      ((Adjunction.homEquiv_unit adjR₁ R_mod (R_sh.obj one₂) α_h).symm.trans
        (Equiv.apply_symm_apply _ _)).trans
        (congrArg (fun m => adjR₂.unit.app R_mod ≫ one₂.obj.map m) hμ_op)
    have hLHS : (ι₀ ≫ FgtMod.map (adjR₁.unit.app R_mod)) ≫
          FgtMod.map (α_h.hom.app (Opposite.op T₁)) =
        (ι₀ ≫ FgtMod.map (adjR₂.unit.app R_mod)) ≫ FgtMod.map (one₂.obj.map μ₁₂.op) :=
