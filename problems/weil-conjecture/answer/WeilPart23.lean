                    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
                      CategoryTheory.MorphismProperty.Over.w j_V]
                    exact z.2⟩)) :=
by
  classical
  let : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  let η_C := C.left.fromSpecStalk (genericPoint ↥C.left)
  let T_C : C.left.Etale := weilEtaleIdTerminal.{u} C.left

  
  have hOrdEx :
      ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
        (F : Type u) [Field F] [Algebra R F] [IsFractionRing R F],
        ∃ ord : Additive (Units F) →+ ℤ,
          (∀ u : Units F,
            ∃ (a b : R) (na nb : ℕ),
              a ≠ 0 ∧ b ≠ 0 ∧
              algebraMap R F a = (u : F) * algebraMap R F b ∧
              Ideal.span ({a} : Set R) = IsLocalRing.maximalIdeal R ^ na ∧
              Ideal.span ({b} : Set R) = IsLocalRing.maximalIdeal R ^ nb ∧
              ord (Additive.ofMul u) = (na : ℤ) - (nb : ℤ)) ∧
          (∀ (u : Units F) (a b : R) (na nb : ℕ),
            a ≠ 0 → b ≠ 0 →
            algebraMap R F a = (u : F) * algebraMap R F b →
            Ideal.span ({a} : Set R) = IsLocalRing.maximalIdeal R ^ na →
            Ideal.span ({b} : Set R) = IsLocalRing.maximalIdeal R ^ nb →
            ord (Additive.ofMul u) = (na : ℤ) - (nb : ℤ)) ∧
          (∀ (u : Units F) (c d : R),
            c ≠ 0 → d ≠ 0 →
            (u : F) * algebraMap R F d = algebraMap R F c →
            (ord (Additive.ofMul u) ≠ 0 → c * d ∈ IsLocalRing.maximalIdeal R) ∧
            (c * d ∉ IsLocalRing.maximalIdeal R → ord (Additive.ofMul u) = 0) ∧
            (Ideal.span ({c} : Set R) = IsLocalRing.maximalIdeal R →
              d ∉ IsLocalRing.maximalIdeal R → ord (Additive.ofMul u) = 1)) ∧
          (∀ u : Units F,
            ord (Additive.ofMul u) = 0 ↔
              u ∈ Set.range (Units.map (algebraMap R F).toMonoidHom)) := by
    intro R _ _ _ F _ _ _
    let m := IsLocalRing.maximalIdeal R
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hm_eq : m = Ideal.span ({ϖ} : Set R) := hϖ.maximalIdeal_eq
    have hm_pow : ∀ n : ℕ, m ^ n = Ideal.span ({ϖ ^ n} : Set R) := fun n => by
      rw [hm_eq, Ideal.span_singleton_pow]
    have hpow_le_inj : ∀ {n₁ n₂ : ℕ}, n₁ ≤ n₂ → m ^ n₁ = m ^ n₂ → n₁ = n₂ := by
      intro n₁ n₂ hle h_eq
      by_contra hne
      obtain ⟨d, hd⟩ :=
        Nat.exists_eq_succ_of_ne_zero (Nat.sub_ne_zero_of_lt (lt_of_le_of_ne hle hne))
      have hn₂ : n₂ = n₁ + (d + 1) := by omega
      have hmem : ϖ ^ n₁ ∈ Ideal.span ({ϖ ^ n₂} : Set R) := by
        rw [← hm_pow n₂, ← h_eq, hm_pow n₁]
        exact Ideal.mem_span_singleton_self _
      rw [Ideal.mem_span_singleton] at hmem
      rcases hmem with ⟨c, hc⟩
      have hc' : ϖ ^ n₁ * 1 = ϖ ^ n₁ * (ϖ * (ϖ ^ d * c)) := by
        calc
          ϖ ^ n₁ * 1 = ϖ ^ n₁ := mul_one _
          _ = ϖ ^ n₂ * c := hc
          _ = ϖ ^ (n₁ + (d + 1)) * c := by rw [hn₂]
          _ = ϖ ^ n₁ * (ϖ * (ϖ ^ d * c)) := by ring
      have h1 : 1 = ϖ * (ϖ ^ d * c) := mul_left_cancel₀ (pow_ne_zero n₁ hϖ.ne_zero) hc'
      have hu_ϖ : IsUnit ϖ := ⟨⟨ϖ, ϖ ^ d * c, h1.symm, by rw [mul_comm]; exact h1.symm⟩, rfl⟩
      exact hϖ.not_isUnit hu_ϖ
    have hpow_inj : ∀ {n₁ n₂ : ℕ}, m ^ n₁ = m ^ n₂ → n₁ = n₂ := fun {n₁ n₂} h => by
      rcases le_total n₁ n₂ with hle | hle
      · exact hpow_le_inj hle h
      · exact (hpow_le_inj hle h.symm).symm
    have hex_pow : ∀ a : R, a ≠ 0 → ∃ n : ℕ, Ideal.span ({a} : Set R) = m ^ n := by
      intro a ha
      obtain ⟨n, hn⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha hϖ
      exact ⟨n, by rw [hm_pow n, Ideal.span_singleton_eq_span_singleton.mpr hn]⟩
    have hRep : ∀ u : Units F, ∃ (a b : R) (na nb : ℕ),
        a ≠ 0 ∧ b ≠ 0 ∧ algebraMap R F a = (u : F) * algebraMap R F b ∧
        Ideal.span ({a} : Set R) = m ^ na ∧ Ideal.span ({b} : Set R) = m ^ nb := by
      intro u
      obtain ⟨a, b_sub, hb_mem, hab⟩ := IsFractionRing.div_surjective (A := R) (u : F)
      have hb : b_sub ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_mem
      have hinj : Function.Injective (algebraMap R F) := IsFractionRing.injective R F
      have hFb : algebraMap R F b_sub ≠ 0 :=
        fun h => hb (hinj (h.trans (map_zero _).symm))
      have heq : algebraMap R F a = (u : F) * algebraMap R F b_sub :=
        (div_eq_iff hFb).mp hab
      have ha : a ≠ 0 := by
        intro h0; rw [h0, map_zero] at heq
        exact mul_ne_zero u.ne_zero hFb heq.symm
      obtain ⟨na, hna⟩ := hex_pow a ha
      obtain ⟨nb, hnb⟩ := hex_pow b_sub hb
      exact ⟨a, b_sub, na, nb, ha, hb, heq, hna, hnb⟩
    let a_of (u : Units F) : R := (hRep u).choose
    let b_of (u : Units F) : R := (hRep u).choose_spec.choose
    let na_of (u : Units F) : ℕ := (hRep u).choose_spec.choose_spec.choose
    let nb_of (u : Units F) : ℕ := (hRep u).choose_spec.choose_spec.choose_spec.choose
    have h_of : ∀ u : Units F,
        a_of u ≠ 0 ∧ b_of u ≠ 0 ∧
        algebraMap R F (a_of u) = (u : F) * algebraMap R F (b_of u) ∧
        Ideal.span ({a_of u} : Set R) = m ^ na_of u ∧
        Ideal.span ({b_of u} : Set R) = m ^ nb_of u :=
      fun u => (hRep u).choose_spec.choose_spec.choose_spec.choose_spec
    let ord_fun : Units F → ℤ := fun u => (na_of u : ℤ) - (nb_of u : ℤ)
    have hUniq : ∀ (u : Units F) (a' b' : R) (na' nb' : ℕ),
        a' ≠ 0 → b' ≠ 0 →
        algebraMap R F a' = (u : F) * algebraMap R F b' →
        Ideal.span ({a'} : Set R) = m ^ na' →
        Ideal.span ({b'} : Set R) = m ^ nb' →
        ord_fun u = (na' : ℤ) - (nb' : ℤ) := by
      intro u a' b' na' nb' _ _ heq' hsa' hsb'
      obtain ⟨_, _, heq, hsa, hsb⟩ := h_of u
      have h_cross : algebraMap R F (a_of u * b') = algebraMap R F (a' * b_of u) := by
        rw [map_mul, map_mul, heq, heq']; ring
      have h_eqR : a_of u * b' = a' * b_of u := IsFractionRing.injective R F h_cross
      have h_span : m ^ (na_of u + nb') = m ^ (na' + nb_of u) := by
        rw [pow_add, pow_add, ← hsa, ← hsb', ← hsa', ← hsb,
          Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_mul_span_singleton, h_eqR]
      have h_nat := hpow_inj h_span
      change (na_of u : ℤ) - (nb_of u : ℤ) = (na' : ℤ) - (nb' : ℤ)
      omega
    have h_mul : ∀ u₁ u₂ : Units F, ord_fun (u₁ * u₂) = ord_fun u₁ + ord_fun u₂ := by
      intro u₁ u₂
      obtain ⟨ha₁, hb₁, heq₁, hsa₁, hsb₁⟩ := h_of u₁
      obtain ⟨ha₂, hb₂, heq₂, hsa₂, hsb₂⟩ := h_of u₂
