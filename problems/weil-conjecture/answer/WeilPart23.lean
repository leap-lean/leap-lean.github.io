        (MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h : Y₂.Etale ⥤ Y₁.Etale)) := by
    intro _ _
    letI : MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale : MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
