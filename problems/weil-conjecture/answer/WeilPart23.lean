        γ₂.hom.app (Opposite.op T₂) ≫ (U_std₂.obj one₂).obj.map μ₁₂.op :=
      γ₂.hom.naturality μ₁₂.op
    have hγ₂_ev : adjℤ₂.unit.app A ≫ γ₂.hom.app (Opposite.op T₂) = ι₀ ≫ u_std₂ :=
      (Adjunction.homEquiv_unit adjℤ₂ A (U_std₂.obj one₂) γ₂).symm.trans
