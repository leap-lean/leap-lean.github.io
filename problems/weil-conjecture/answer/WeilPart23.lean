    apply (adj₂.homEquiv Aℤ (P_push.obj (R_p.obj K_sh))).injective
    apply h_Aℤ_hom_ext
    
    let ψ_w : Aℤ ⟶ ((CategoryTheory.sheafSections J AddCommGrpCat.{u}).obj (Opposite.op T₂)).obj
        (P_push.obj (R_p.obj K_sh)) :=
      φ_w ≫ (R_p.obj K_sh).obj.map τ.op
    have hLHS_mor :
        (adj₂.homEquiv Aℤ (P_push.obj (R_p.obj K_sh)))
          ((adj_Rp.homEquiv (C_X.obj Aℤ) (R_p.obj K_sh)) (ℓ • w_hat_R)) =
        ℓ • ψ_w := by
      rw [hadj_Rp_nsmul ℓ w_hat_R, h_constAdj_nsmul hT₂ ℓ _]
      congr 1
      dsimp [w_hat_R, ψ_w]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right, h_uniq_equiv,
        CategoryTheory.Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply]
      change (adj₁.unit.app Aℤ ≫ (C_Y.obj Aℤ).obj.map τ.op) ≫ w_mor.hom.app (Opposite.op (B.obj T₂)) =
        φ_w ≫ (R_p.obj K_sh).obj.map τ.op
      rw [CategoryTheory.Category.assoc, w_mor.hom.naturality τ.op,
        ← CategoryTheory.Category.assoc]
      have hw_mor_eq : adj₁.unit.app Aℤ ≫ w_mor.hom.app (Opposite.op T₁) = φ_w :=
        (CategoryTheory.Adjunction.homEquiv_unit adj₁ Aℤ (R_p.obj K_sh) w_mor).symm.trans
          (Equiv.apply_symm_apply (adj₁.homEquiv Aℤ (R_p.obj K_sh)) φ_w)
      rw [hw_mor_eq]
    have hLHS_val :
        ((adj₂.homEquiv Aℤ (P_push.obj (R_p.obj K_sh)))
          ((adj_Rp.homEquiv (C_X.obj Aℤ) (R_p.obj K_sh)) (ℓ • w_hat_R))).hom (ULift.up (1 : ℤ)) =
        (K_sh.obj.map (M_p.map τ ≫ m₁ ≫ j_p).op).hom z_f := by
      rw [hLHS_mor, h_hom_nsmul]
      change ℓ • (K_sh.obj.map (M_p.map τ).op).hom ((1 : ℤ) • w_T₁) = _
      rw [one_zsmul]
      dsimp [w_T₁]
      rw [← map_nsmul, ← map_nsmul, hw_sh]
      simp only [CategoryTheory.Functor.map_comp]
      rfl
    
    let u₂_X : T₂ ⟶ T_V := hT_V.from T₂
    have hadj₂_TV :
        (adj₂.homEquiv Aℤ K_sh) f_qi =
          (adj_TV.homEquiv Aℤ K_sh) f_qi ≫ K_sh.obj.map u₂_X.op := by
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      change adj₂.unit.app Aℤ ≫ f_qi.hom.app (Opposite.op T₂) =
        (adj_TV.unit.app Aℤ ≫ f_qi.hom.app (Opposite.op T_V)) ≫ K_sh.obj.map u₂_X.op
      rw [CategoryTheory.Category.assoc, ← f_qi.hom.naturality u₂_X.op,
        ← CategoryTheory.Category.assoc]
      congr 1
      let Pℤ := (CategoryTheory.Functor.const (Opposite V₀.Etale)).obj Aℤ
      let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
      have hu_T₂ : adj₂.unit.app Aℤ = (shAdj.unit.app Pℤ).app (Opposite.op T₂) := by
        dsimp [adj₂, CategoryTheory.constantSheafAdj]
        rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
          CategoryTheory.Category.id_comp]
        rfl
      have hu_TV : adj_TV.unit.app Aℤ = (shAdj.unit.app Pℤ).app (Opposite.op T_V) := by
        dsimp [adj_TV, CategoryTheory.constantSheafAdj]
        rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
          CategoryTheory.Category.id_comp]
        rfl
      rw [hu_T₂, hu_TV]
      have hnat_u := (shAdj.unit.app Pℤ).naturality u₂_X.op
      dsimp [Pℤ] at hnat_u
      rw [CategoryTheory.Category.id_comp] at hnat_u
      exact hnat_u
    have hRHS_mor :
        (adj₂.homEquiv Aℤ (P_push.obj (R_p.obj K_sh)))
          ((adj_Rp.homEquiv (C_X.obj Aℤ) (R_p.obj K_sh)) (R_p.map f_qi)) =
        (adj_TV.homEquiv Aℤ K_sh) f_qi ≫
          K_sh.obj.map (adj_site.counit.app T₂ ≫ u₂_X).op := by
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      change (adj₂.homEquiv Aℤ (P_push.obj (R_p.obj K_sh)))
          (adj_Rp.unit.app (C_X.obj Aℤ) ≫ (R_p ⋙ P_push).map f_qi) = _
      rw [← adj_Rp.unit.naturality f_qi, CategoryTheory.Functor.id_map,
        CategoryTheory.Adjunction.homEquiv_naturality_right]
      change (adj₂.homEquiv Aℤ K_sh) f_qi ≫ K_sh.obj.map (adj_site.counit.app T₂).op = _
      rw [hadj₂_TV, CategoryTheory.Category.assoc]
      congr 1
      rw [op_comp, CategoryTheory.Functor.map_comp]
    have hRHS_val :
        ((adj₂.homEquiv Aℤ (P_push.obj (R_p.obj K_sh)))
          ((adj_Rp.homEquiv (C_X.obj Aℤ) (R_p.obj K_sh)) (R_p.map f_qi))).hom (ULift.up (1 : ℤ)) =
        (K_sh.obj.map (adj_site.counit.app T₂ ≫ u₂_X).op).hom z_f := by
      rw [hRHS_mor]
      rfl
    rw [hLHS_val, hRHS_val]
    have h_term_eq : M_p.map τ ≫ m₁ ≫ j_p = adj_site.counit.app T₂ ≫ u₂_X :=
      hT_V.hom_ext _ _
    rw [h_term_eq]

  
  let w_hat_P : P_pull.obj (C_X.obj Aℤ) ⟶ P_pull.obj K_sh :=
    η_iso.hom.app (C_X.obj Aℤ) ≫ w_hat_R ≫ η_iso.inv.app K_sh
  have hw_hat_P_mul : ℓ • w_hat_P = P_pull.map q_mor ≫ P_pull.map i_Q := by
    dsimp [w_hat_P]
    rw [← CategoryTheory.Preadditive.comp_nsmul, ← CategoryTheory.Preadditive.nsmul_comp,
      h_w_hat_R_mul, ← CategoryTheory.Functor.map_comp, η_iso.inv.naturality (q_mor ≫ i_Q)]
    exact CategoryTheory.Iso.hom_inv_id_assoc (η_iso.app (C_X.obj Aℤ)) (P_pull.map (q_mor ≫ i_Q))
  have hw_hat_P_fac : (w_hat_P ≫ P_pull.map q_K) ≫ P_pull.map i_Q =
      P_pull.map q_mor ≫ P_pull.map i_Q := by
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.map_comp, hfac_Q,
      CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id, hw_hat_P_mul]
  have : CategoryTheory.Mono (P_pull.map i_Q) := P_pull.map_mono i_Q
  have hP_qmor_fac : P_pull.map q_mor = w_hat_P ≫ P_pull.map q_K :=
    (CategoryTheory.cancel_mono (P_pull.map i_Q)).mp hw_hat_P_fac.symm

  have hExt_pull_zero :
      (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull _ _ _ _ _
        (C_X.obj Aℤ) (C_X.obj AM) 1) s = 0 := by
    rw [← hq_s, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_pull hSE_jq]
    let S_jq := CategoryTheory.ShortComplex.mk j_kum q_K h0_jq
    let hSE_pull : (S_jq.map P_pull).ShortExact := hSE_jq.map_of_exact P_pull
    change (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map q_mor)).comp hSE_pull.extClass
      (Nat.zero_add 1) = 0
    have hmap_g : P_pull.map q_K = (S_jq.map P_pull).g := rfl
    rw [hP_qmor_fac, hmap_g, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ w_hat_P)
        (CategoryTheory.Abelian.Ext.mk₀ (S_jq.map P_pull).g)
        hSE_pull.extClass (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
      hSE_pull.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]

  rw [hp₁_eq s, hExt_pull_zero, CategoryTheory.Abelian.Ext.comp_zero, map_zero]

theorem weil_curve_krullDim_one_dedekind_cover_and_local_unit_factor (k : Type u) [Field k]
    (ℓ : ℕ)
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C_bar.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom]
    (hDimC : topologicalKrullDim C_bar.left = (1 : WithBot ℕ∞))
    (hStalkDVR_C : ∀ x : { x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) },
      ∃ hDom : IsDomain ↑(C_bar.left.presheaf.stalk x.1),
        @IsDiscreteValuationRing ↑(C_bar.left.presheaf.stalk x.1) _ hDom)
    (V : C_bar.left.Opens) (hNe_V : Nonempty ↥V)
    [AlgebraicGeometry.IsIntegral V.toScheme]
    (f : Units ↑V.toScheme.functionField)
    (hf_val : ∀ y : { y : ↥V.toScheme // IsClosed ({y} : Set ↥V.toScheme) },
      let Ry := ↑(V.toScheme.presheaf.stalk y.1)
      ∃ (u_y : Units Ry) (g_y : Units ↑V.toScheme.functionField),
        (f : ↑V.toScheme.functionField) =
          algebraMap Ry ↑V.toScheme.functionField (u_y : Ry) *
            (g_y : ↑V.toScheme.functionField) ^ ℓ) :
    (∀ (W : C_bar.left.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) →
      IsDedekindDomain ↑(C_bar.left.presheaf.obj (Opposite.op W))) ∧
    ∃ (φ_ZV : ↑C_bar.left.functionField ≃+* ↑V.toScheme.functionField),
      (∀ (U : C_bar.left.Opens) (_hUV : U ≤ V)
         (hNeU : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}))
         (hNeUV : Nonempty ↥(((TopologicalSpace.Opens.map V.ι.base).obj U) : AlgebraicGeometry.Scheme.{u}))
         (a : ↑(C_bar.left.presheaf.obj (Opposite.op U))),
        φ_ZV ((@AlgebraicGeometry.Scheme.germToFunctionField C_bar.left _ U hNeU).hom a) =
          (@AlgebraicGeometry.Scheme.germToFunctionField V.toScheme _
            ((TopologicalSpace.Opens.map V.ι.base).obj U) hNeUV).hom
            ((V.ι.app U).hom a)) ∧
      (∀ x : ↥V.toScheme,
        ∃ (U_x : C_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_x)
          (_hUx_V : U_x ≤ V) (_hx_U : V.ι.base x ∈ U_x)
          (hNe_Ux : Nonempty ↥(U_x : AlgebraicGeometry.Scheme.{u}))
          (ũ_x : Units ↑(C_bar.left.presheaf.obj (Opposite.op U_x)))
          (g_x : Units ↑V.toScheme.functionField),
          f.val =
            φ_ZV ((@AlgebraicGeometry.Scheme.germToFunctionField C_bar.left _ U_x hNe_Ux).hom
              ũ_x.val) * g_x.val ^ ℓ) :=
by
  let Z : AlgebraicGeometry.Scheme.{u} := C_bar.left
  let V₀ : AlgebraicGeometry.Scheme.{u} := V.toScheme
  have : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
  have : IrreducibleSpace ↥V₀ := AlgebraicGeometry.irreducibleSpace_of_isIntegral V₀
  let η_Z : ↥Z := genericPoint ↥Z
  let η_V : ↥V₀ := genericPoint ↥V₀

  
  have hDichot : ∀ z : ↥Z, z ≠ η_Z → IsClosed ({z} : Set ↥Z) := by
    intro z hz_ne
    by_contra hz_not_cl
    have hnot_sub : ¬ closure ({z} : Set ↥Z) ⊆ {z} :=
      fun hsub => hz_not_cl (closure_subset_iff_isClosed.mp hsub)
    obtain ⟨w, hw_cl, hw_not_mem⟩ := Set.not_subset.mp hnot_sub
    have hwz : w ≠ z := Set.mem_singleton_iff.not.mp hw_not_mem
    let C₀ : TopologicalSpace.IrreducibleCloseds ↥Z :=
      ⟨closure ({w} : Set ↥Z), isIrreducible_singleton.closure, isClosed_closure⟩
    let C₁ : TopologicalSpace.IrreducibleCloseds ↥Z :=
      ⟨closure ({z} : Set ↥Z), isIrreducible_singleton.closure, isClosed_closure⟩
    let C₂ : TopologicalSpace.IrreducibleCloseds ↥Z :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥Z, isClosed_univ⟩
    have h01_le : C₀ ≤ C₁ :=
      closure_minimal (Set.singleton_subset_iff.mpr hw_cl) isClosed_closure
    have h01_lt : C₀ < C₁ := lt_of_le_of_ne h01_le fun h_eq => by
      have h_carrier : (C₀ : Set ↥Z) = (C₁ : Set ↥Z) := congrArg SetLike.coe h_eq
      have hz_in_w : z ∈ closure ({w} : Set ↥Z) := by
        change z ∈ (C₀ : Set ↥Z)
        rw [h_carrier]
        exact subset_closure (Set.mem_singleton z)
      have hinsep : Inseparable z w :=
        inseparable_iff_mem_closure.mpr ⟨hz_in_w, hw_cl⟩
      exact hwz ((t0Space_iff_inseparable ↥Z).mp inferInstance z w hinsep).symm
    have h12_le : C₁ ≤ C₂ := Set.subset_univ _
    have h12_lt : C₁ < C₂ := lt_of_le_of_ne h12_le fun h_eq => by
      have hz_gen : IsGenericPoint z Set.univ := congrArg SetLike.coe h_eq
      exact hz_ne (hz_gen.eq (genericPoint_spec ↥Z))
    let s : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Z) :=
      RelSeries.mk 2 ![C₀, C₁, C₂] fun i => by
        fin_cases i
        · simpa using h01_lt
        · simpa using h12_lt
    have hlen : (2 : WithBot ℕ∞) ≤ topologicalKrullDim ↥Z :=
      Order.LTSeries.length_le_krullDim s
    rw [hDimC] at hlen
    exact absurd hlen (by decide)

  have hj_emb : Topology.IsOpenEmbedding V.ι.base := V.ι.isOpenEmbedding
  have hGen_V : V.ι.base η_V = η_Z := by
    have hgen : IsGenericPoint (V.ι.base η_V) Set.univ := by
      change closure ({V.ι.base η_V} : Set ↥Z) = Set.univ
      refine Set.eq_univ_of_forall fun x => mem_closure_iff.mpr fun O hO hxO => ?_
      obtain ⟨v₀, hv₀⟩ := hNe_V
      let y₀ : ↥V₀ := ⟨v₀, hv₀⟩
      obtain ⟨_, _, hx_O, y₁, rfl⟩ :=
        (IrreducibleSpace.isIrreducible_univ ↥Z).2 O (Set.range V.ι.base)
          hO hj_emb.isOpen_range ⟨x, Set.mem_univ x, hxO⟩
          ⟨V.ι.base y₀, Set.mem_univ _, y₀, rfl⟩
      have hη_in : η_V ∈ V.ι.base ⁻¹' O :=
        ((genericPoint_spec ↥V₀).mem_open_set_iff (hj_emb.continuous.isOpen_preimage O hO)).mpr
          ⟨y₁, Set.mem_univ y₁, hx_O⟩
      exact ⟨V.ι.base η_V, hη_in, Set.mem_singleton _⟩
    exact hgen.eq (genericPoint_spec ↥Z)

  have hNonCl_V : ∀ x : ↥V₀, ¬ IsClosed ({x} : Set ↥V₀) → V.ι.base x = η_Z := by
    intro x hnx
    by_contra hne
    have hcl_Z : IsClosed ({V.ι.base x} : Set ↥Z) := hDichot (V.ι.base x) hne
    have hpre : V.ι.base ⁻¹' ({V.ι.base x} : Set ↥Z) = ({x} : Set ↥V₀) := by
      ext y
      simp [hj_emb.injective.eq_iff]
    have hcl_V : IsClosed ({x} : Set ↥V₀) := hpre ▸ hcl_Z.preimage hj_emb.continuous
    exact hnx hcl_V

  
  have : AlgebraicGeometry.Smooth C_bar.hom :=
    @AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 _ _ C_bar.hom inferInstance
  have : AlgebraicGeometry.IsLocallyNoetherian Z :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian C_bar.hom
  have hDedZ : ∀ (W : Z.Opens),
      AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) →
      IsDedekindDomain ↑(Z.presheaf.obj (Opposite.op W)) := by
    intro W hW hNeW
    have : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := hNeW
    have : Nonempty ↥W := by
      obtain ⟨w⟩ := hNeW
      exact ⟨w⟩
    let A_W : Type u := ↑(Z.presheaf.obj (Opposite.op W))
    have hDom_AW : IsDomain A_W := AlgebraicGeometry.IsIntegral.component_integral W
    have hNoeth_AW : IsNoetherianRing A_W :=
      AlgebraicGeometry.IsLocallyNoetherian.component_noetherian ⟨W, hW⟩
    have hEmb_W : Topology.IsOpenEmbedding hW.fromSpec.base := hW.fromSpec.isOpenEmbedding
    have hClosed_of_ne_bot : ∀ (y : PrimeSpectrum A_W), y.asIdeal ≠ ⊥ →
        IsClosed ({hW.fromSpec y} : Set ↥Z) := by
      intro y hy_ne
      obtain ⟨r, hr_mem, hr_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hy_ne
      let q₀ : PrimeSpectrum A_W := ⟨⊥, Ideal.isPrime_bot⟩
      have hq₀_mem : q₀ ∈ PrimeSpectrum.basicOpen r :=
        (PrimeSpectrum.mem_basicOpen r q₀).mpr (by simpa [q₀] using hr_ne)
      have hy_not_mem : y ∉ PrimeSpectrum.basicOpen r :=
        fun hmem => (PrimeSpectrum.mem_basicOpen r y).mp hmem hr_mem
      let O : Set ↥Z := hW.fromSpec.base '' (PrimeSpectrum.basicOpen r : Set (PrimeSpectrum A_W))
      have hO_open : IsOpen O :=
        hEmb_W.isOpenMap _ PrimeSpectrum.isOpen_basicOpen
      have hη_in_O : η_Z ∈ O :=
        ((genericPoint_spec ↥Z).mem_open_set_iff hO_open).mpr
          ⟨hW.fromSpec.base q₀, Set.mem_univ _, q₀, hq₀_mem, rfl⟩
      have hz_ne_η : hW.fromSpec y ≠ η_Z := by
        intro heq
        rw [← heq] at hη_in_O
        obtain ⟨q', hq'_mem, hq'_eq⟩ := hη_in_O
        exact hy_not_mem (hEmb_W.injective hq'_eq ▸ hq'_mem)
      exact hDichot (hW.fromSpec y) hz_ne_η
    have hDimLE1_AW : Ring.DimensionLEOne A_W := Ring.DimensionLEOne.mk fun {p} hp_ne hp_prime => by
      let y : PrimeSpectrum A_W := ⟨p, hp_prime⟩
      have hcl_Z : IsClosed ({hW.fromSpec y} : Set ↥Z) := hClosed_of_ne_bot y hp_ne
      have hpre : hW.fromSpec.base ⁻¹' ({hW.fromSpec y} : Set ↥Z) = ({y} : Set (PrimeSpectrum A_W)) := by
        ext q
        change hW.fromSpec.base q = hW.fromSpec.base y ↔ q = y
        exact hEmb_W.injective.eq_iff
      have hcl_y : IsClosed ({y} : Set (PrimeSpectrum A_W)) :=
        hpre ▸ hcl_Z.preimage hEmb_W.continuous
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal y).mp hcl_y
    have hIC_AW : IsIntegrallyClosed A_W :=
      IsIntegrallyClosed.of_localization_maximal fun p hp_ne hp_max => by
        let y : PrimeSpectrum A_W := ⟨p, hp_max.isPrime⟩
        have hz_W : hW.fromSpec y ∈ W := by
          change hW.fromSpec y ∈ (W : Set ↥Z)
          rw [← hW.range_fromSpec]
          exact ⟨y, rfl⟩
        have hz_cl : IsClosed ({hW.fromSpec y} : Set ↥Z) := hClosed_of_ne_bot y hp_ne
        obtain ⟨hDom_z, hDVR_z⟩ := hStalkDVR_C ⟨hW.fromSpec y, hz_cl⟩
        have : IsDomain ↑(Z.presheaf.stalk (hW.fromSpec y)) := hDom_z
        have : IsDiscreteValuationRing ↑(Z.presheaf.stalk (hW.fromSpec y)) := hDVR_z
        let _ : Algebra A_W ↑(Z.presheaf.stalk (hW.fromSpec y)) :=
          TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨hW.fromSpec y, hz_W⟩
        have : IsLocalization.AtPrime ↑(Z.presheaf.stalk (hW.fromSpec y)) p :=
          hW.isLocalization_stalk' y hz_W
        exact IsIntegrallyClosed.of_equiv
          (IsLocalization.algEquiv p.primeCompl ↑(Z.presheaf.stalk (hW.fromSpec y))
            (Localization.AtPrime p)).toRingEquiv
    exact (isDedekindDomain_iff A_W (FractionRing A_W)).mpr
      ⟨hDom_AW, hNoeth_AW, hDimLE1_AW, (isIntegrallyClosed_iff (FractionRing A_W)).mp hIC_AW⟩

  
  let mkStalkIso : ∀ (z₀ : ↥Z), V.ι.base η_V = z₀ →
      (Z.presheaf.stalk z₀ ≅ V₀.presheaf.stalk η_V) :=
    fun z₀ hz₀ =>
      (CategoryTheory.eqToIso (congrArg Z.presheaf.stalk hz₀.symm)).trans
        (CategoryTheory.asIso (V.ι.stalkMap η_V))
  have hmk_germ : ∀ (z₀ : ↥Z) (hz₀ : V.ι.base η_V = z₀) (U : Z.Opens) (hz₀_U : z₀ ∈ U),
      Z.presheaf.germ U z₀ hz₀_U ≫ (mkStalkIso z₀ hz₀).hom =
        V.ι.app U ≫ V₀.presheaf.germ ((TopologicalSpace.Opens.map V.ι.base).obj U) η_V
          (by change V.ι.base η_V ∈ U; rwa [hz₀]) := by
    rintro _ rfl U hz₀_U
    change Z.presheaf.germ U (V.ι.base η_V) hz₀_U ≫
        ((CategoryTheory.eqToIso rfl).trans (CategoryTheory.asIso (V.ι.stalkMap η_V))).hom = _
    rw [CategoryTheory.Iso.trans_hom, CategoryTheory.eqToIso_refl, CategoryTheory.Iso.refl_hom,
      CategoryTheory.Category.id_comp, CategoryTheory.asIso_hom]
    exact V.ι.germ_stalkMap U η_V hz₀_U

  let φ_ZV : ↑Z.functionField ≃+* ↑V₀.functionField :=
    (mkStalkIso η_Z hGen_V).commRingCatIsoToRingEquiv

  have hφ_ZV : ∀ (U : Z.Opens) (_hUV : U ≤ V)
      (hNeU : Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}))
      (hNeUV : Nonempty ↥(((TopologicalSpace.Opens.map V.ι.base).obj U) : AlgebraicGeometry.Scheme.{u}))
      (a : ↑(Z.presheaf.obj (Opposite.op U))),
      φ_ZV ((@AlgebraicGeometry.Scheme.germToFunctionField Z _ U hNeU).hom a) =
        (@AlgebraicGeometry.Scheme.germToFunctionField V₀ _
          ((TopologicalSpace.Opens.map V.ι.base).obj U) hNeUV).hom
          ((V.ι.app U).hom a) := by
    intro U _hUV hNeU hNeUV a
    obtain ⟨u₀⟩ := hNeU
    have hηZ_U : η_Z ∈ U :=
      ((genericPoint_spec ↥Z).mem_open_set_iff U.isOpen).mpr ⟨u₀.1, Set.mem_univ u₀.1, u₀.2⟩
    have hcomm := hmk_germ η_Z hGen_V U hηZ_U
    dsimp [φ_ZV, AlgebraicGeometry.Scheme.germToFunctionField]
    exact congrArg (fun φ : Z.presheaf.obj (Opposite.op U) ⟶ V₀.presheaf.stalk η_V => φ.hom a) hcomm

  
  have hStalkAlg_germ : ∀ (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
      (O : X.Opens) (p : ↥X) (hp : p ∈ O) (hNeO : Nonempty ↥(O : AlgebraicGeometry.Scheme.{u}))
      (s : ↑(X.presheaf.obj (Opposite.op O))),
      algebraMap ↑(X.presheaf.stalk p) ↑X.functionField ((X.presheaf.germ O p hp).hom s) =
        (@AlgebraicGeometry.Scheme.germToFunctionField X _ O hNeO).hom s := by
    intro X _ O p hp hNeO s
    have : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    have : Nonempty ↥O := ⟨⟨p, hp⟩⟩
    have : Nonempty ↥(O : AlgebraicGeometry.Scheme.{u}) := hNeO
    let _ : Algebra ↑(X.presheaf.obj (Opposite.op O)) ↑(X.presheaf.stalk p) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨p, hp⟩
    have : IsScalarTower ↑(X.presheaf.obj (Opposite.op O)) ↑(X.presheaf.stalk p) ↑X.functionField :=
      AlgebraicGeometry.functionField_isScalarTower X O ⟨p, hp⟩
    have hηX_O : genericPoint ↥X ∈ O :=
      ((genericPoint_spec ↥X).mem_open_set_iff O.isOpen).mpr ⟨p, Set.mem_univ p, hp⟩
    have hg1 : (X.presheaf.germ O p hp).hom s =
        algebraMap ↑(X.presheaf.obj (Opposite.op O)) ↑(X.presheaf.stalk p) s := by
      rw [TopCat.Presheaf.stalk_open_algebraMap X.presheaf ⟨p, hp⟩]
    have hg2 : (@AlgebraicGeometry.Scheme.germToFunctionField X _ O hNeO).hom s =
        algebraMap ↑(X.presheaf.obj (Opposite.op O)) ↑X.functionField s := by
      rw [TopCat.Presheaf.stalk_open_algebraMap X.presheaf ⟨genericPoint ↥X, hηX_O⟩]
    rw [hg1, ← IsScalarTower.algebraMap_apply, hg2]

  have hUnitV : ∀ x : ↥V₀,
      ∃ (U_x : Z.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_x)
        (_hUx_V : U_x ≤ V) (_hx_U : V.ι.base x ∈ U_x)
        (hNe_Ux : Nonempty ↥(U_x : AlgebraicGeometry.Scheme.{u}))
        (ũ_x : Units ↑(Z.presheaf.obj (Opposite.op U_x)))
        (g_x : Units ↑V₀.functionField),
        f.val =
          φ_ZV ((@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom
            ũ_x.val) * g_x.val ^ ℓ := by
    intro x
    by_cases hx_cl : IsClosed ({x} : Set ↥V₀)
    · 
      obtain ⟨u_x, g_x, hf_eq⟩ := hf_val ⟨x, hx_cl⟩
      let z_x : ↥Z := V.ι.base x
      have hz_V : z_x ∈ V := x.2
      let e_x : ↑(Z.presheaf.stalk z_x) ≃+* ↑(V₀.presheaf.stalk x) :=
        (CategoryTheory.asIso (V.ι.stalkMap x)).commRingCatIsoToRingEquiv
      let u_Zx : Units ↑(Z.presheaf.stalk z_x) :=
        Units.map e_x.symm.toRingHom.toMonoidHom u_x
      have hu_Zx_map : (V.ι.stalkMap x).hom u_Zx.val = u_x.val :=
        e_x.apply_symm_apply u_x.val
      obtain ⟨O₁, hz_O₁, s₁, hs₁⟩ := TopCat.Presheaf.exists_germ_eq Z.presheaf u_Zx.val
      obtain ⟨O₂, hz_O₂, s₂, hs₂⟩ := TopCat.Presheaf.exists_germ_eq Z.presheaf (u_Zx⁻¹).val
      let O₀ : Z.Opens := (O₁ ⊓ O₂) ⊓ V
      have hz_O₀ : z_x ∈ O₀ := ⟨⟨hz_O₁, hz_O₂⟩, hz_V⟩
      have hO₀_O₁ : O₀ ≤ O₁ := inf_le_left.trans inf_le_left
      have hO₀_O₂ : O₀ ≤ O₂ := inf_le_left.trans inf_le_right
      have hO₀_V : O₀ ≤ V := inf_le_right
      let t₁ : ↑(Z.presheaf.obj (Opposite.op O₀)) :=
        (Z.presheaf.map (CategoryTheory.homOfLE hO₀_O₁).op).hom s₁
      let t₂ : ↑(Z.presheaf.obj (Opposite.op O₀)) :=
        (Z.presheaf.map (CategoryTheory.homOfLE hO₀_O₂).op).hom s₂
      have ht₁_germ : (Z.presheaf.germ O₀ z_x hz_O₀).hom t₁ = u_Zx.val := by
        have hres := congrArg (fun φ : Z.presheaf.obj (Opposite.op O₁) ⟶ Z.presheaf.stalk z_x => φ.hom s₁)
          (Z.presheaf.germ_res (CategoryTheory.homOfLE hO₀_O₁) z_x hz_O₀)
        exact hres.trans hs₁
      have ht₂_germ : (Z.presheaf.germ O₀ z_x hz_O₀).hom t₂ = (u_Zx⁻¹).val := by
        have hres := congrArg (fun φ : Z.presheaf.obj (Opposite.op O₂) ⟶ Z.presheaf.stalk z_x => φ.hom s₂)
          (Z.presheaf.germ_res (CategoryTheory.homOfLE hO₀_O₂) z_x hz_O₀)
        exact hres.trans hs₂
      have : Nonempty ↥O₀ := ⟨⟨z_x, hz_O₀⟩⟩
      have hNe_O₀ : Nonempty ↥(O₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨z_x, hz_O₀⟩⟩
      have ht_mul_germ :
          (Z.presheaf.germ O₀ z_x hz_O₀).hom (t₁ * t₂) =
            (Z.presheaf.germ O₀ z_x hz_O₀).hom 1 := by
        rw [map_mul, map_one, ht₁_germ, ht₂_germ, Units.mul_inv]
      have ht_mul : t₁ * t₂ = 1 := by
        apply AlgebraicGeometry.Scheme.germToFunctionField_injective Z O₀
        rw [← hStalkAlg_germ Z O₀ z_x hz_O₀ hNe_O₀, ← hStalkAlg_germ Z O₀ z_x hz_O₀ hNe_O₀,
          ht_mul_germ]
      let u_O₀ : Units ↑(Z.presheaf.obj (Opposite.op O₀)) :=
        { val := t₁
          inv := t₂
          val_inv := ht_mul
          inv_val := mul_comm t₂ t₁ ▸ ht_mul }
      obtain ⟨U_x, hAff_Ux, hz_Ux, hUx_O₀⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hz_O₀
      have hUx_le_O₀ : U_x ≤ O₀ := hUx_O₀
      have hUx_V : U_x ≤ V := hUx_le_O₀.trans hO₀_V
      have hNe_Ux : Nonempty ↥(U_x : AlgebraicGeometry.Scheme.{u}) := ⟨⟨z_x, hz_Ux⟩⟩
      let ũ_x : Units ↑(Z.presheaf.obj (Opposite.op U_x)) :=
        Units.map (Z.presheaf.map (CategoryTheory.homOfLE hUx_le_O₀).op).hom.toMonoidHom u_O₀
      have hũ_germ : (Z.presheaf.germ U_x z_x hz_Ux).hom ũ_x.val = u_Zx.val := by
        have hres := congrArg (fun φ : Z.presheaf.obj (Opposite.op O₀) ⟶ Z.presheaf.stalk z_x => φ.hom t₁)
          (Z.presheaf.germ_res (CategoryTheory.homOfLE hUx_le_O₀) z_x hz_Ux)
        exact hres.trans ht₁_germ
      let U_V : V₀.Opens := (TopologicalSpace.Opens.map V.ι.base).obj U_x
      have hx_UV : x ∈ U_V := hz_Ux
      have hNe_UV : Nonempty ↥(U_V : AlgebraicGeometry.Scheme.{u}) := ⟨⟨x, hx_UV⟩⟩
      refine ⟨U_x, hAff_Ux, hUx_V, hz_Ux, hNe_Ux, ũ_x, g_x, ?_⟩
      have hstk_eq :
          (V₀.presheaf.germ U_V x hx_UV).hom ((V.ι.app U_x).hom ũ_x.val) = u_x.val := by
        have hnat := congrArg
          (fun φ : Z.presheaf.obj (Opposite.op U_x) ⟶ V₀.presheaf.stalk x => φ.hom ũ_x.val)
          (V.ι.germ_stalkMap U_x x hz_Ux).symm
        exact hnat.trans ((congrArg (V.ι.stalkMap x).hom hũ_germ).trans hu_Zx_map)
      calc
        f.val = algebraMap ↑(V₀.presheaf.stalk x) ↑V₀.functionField u_x.val * g_x.val ^ ℓ := hf_eq
        _ = algebraMap ↑(V₀.presheaf.stalk x) ↑V₀.functionField
              ((V₀.presheaf.germ U_V x hx_UV).hom ((V.ι.app U_x).hom ũ_x.val)) *
              g_x.val ^ ℓ := by rw [hstk_eq]
        _ = (@AlgebraicGeometry.Scheme.germToFunctionField V₀ _ U_V hNe_UV).hom
              ((V.ι.app U_x).hom ũ_x.val) * g_x.val ^ ℓ := by
            rw [hStalkAlg_germ V₀ U_V x hx_UV hNe_UV]
        _ = φ_ZV ((@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom ũ_x.val) *
              g_x.val ^ ℓ := by
            rw [← hφ_ZV U_x hUx_V hNe_Ux hNe_UV ũ_x.val]
    · 
      have hx_gen : V.ι.base x = η_Z := hNonCl_V x hx_cl
      obtain ⟨v₀, hv₀⟩ := hNe_V
      obtain ⟨U₁, hAff_U₁, hv₀_U₁, hU₁_V_sub⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hv₀
      have hU₁_V : U₁ ≤ V := hU₁_V_sub
      have : Nonempty ↥U₁ := ⟨⟨v₀, hv₀_U₁⟩⟩
      have hNe_U₁ : Nonempty ↥(U₁ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨v₀, hv₀_U₁⟩⟩
      let A₁ : Type u := ↑(Z.presheaf.obj (Opposite.op U₁))
      have : IsDomain A₁ := AlgebraicGeometry.IsIntegral.component_integral U₁
      have : IsFractionRing A₁ ↑Z.functionField :=
        AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z U₁ hAff_U₁
      let f_Z : Units ↑Z.functionField :=
        Units.map φ_ZV.symm.toRingHom.toMonoidHom f
      obtain ⟨⟨n₀, ⟨d₀, hd₀_nzd⟩⟩, hfrac⟩ :=
        IsLocalization.surj (nonZeroDivisors A₁) f_Z.val
      have hd₀_ne : d₀ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hd₀_nzd
      have hd₀_K_ne : algebraMap A₁ ↑Z.functionField d₀ ≠ 0 :=
        fun h0 => hd₀_ne (IsFractionRing.injective A₁ ↑Z.functionField
          (h0.trans (map_zero (algebraMap A₁ ↑Z.functionField)).symm))
      have hn₀_ne : n₀ ≠ 0 := by
        intro hn0
        rw [hn0, map_zero] at hfrac
        exact (mul_ne_zero f_Z.ne_zero hd₀_K_ne) hfrac
      have hprod_ne : n₀ * d₀ ≠ 0 := mul_ne_zero hn₀_ne hd₀_ne
      let U_x : Z.Opens := Z.basicOpen (n₀ * d₀)
      have hAff_Ux : AlgebraicGeometry.IsAffineOpen U_x := hAff_U₁.basicOpen (n₀ * d₀)
      have hUx_U₁ : U_x ≤ U₁ := Z.basicOpen_le (n₀ * d₀)
      have hUx_V : U_x ≤ V := hUx_U₁.trans hU₁_V
      let q_bot : PrimeSpectrum A₁ := ⟨⊥, Ideal.isPrime_bot⟩
      have hq_bot_mem : q_bot ∈ PrimeSpectrum.basicOpen (n₀ * d₀) :=
        (PrimeSpectrum.mem_basicOpen (n₀ * d₀) q_bot).mpr (by simpa [q_bot] using hprod_ne)
      have hpt_Ux : hAff_U₁.fromSpec.base q_bot ∈ U_x := by
        change q_bot ∈ (TopologicalSpace.Opens.map hAff_U₁.fromSpec.base).obj (Z.basicOpen (n₀ * d₀))
        rw [hAff_U₁.fromSpec_preimage_basicOpen (n₀ * d₀)]
        exact hq_bot_mem
      have hηZ_Ux : η_Z ∈ U_x :=
        ((genericPoint_spec ↥Z).mem_open_set_iff U_x.isOpen).mpr
          ⟨hAff_U₁.fromSpec.base q_bot, Set.mem_univ _, hpt_Ux⟩
      have hx_Ux : V.ι.base x ∈ U_x := hx_gen ▸ hηZ_Ux
      have hNe_Ux : Nonempty ↥(U_x : AlgebraicGeometry.Scheme.{u}) := ⟨⟨V.ι.base x, hx_Ux⟩⟩
      let A_x : Type u := ↑(Z.presheaf.obj (Opposite.op U_x))
      have : IsLocalization.Away (n₀ * d₀) A_x := hAff_U₁.isLocalization_basicOpen (n₀ * d₀)
      have hu_prod_isUnit : IsUnit (algebraMap A₁ A_x (n₀ * d₀)) :=
        IsLocalization.Away.algebraMap_isUnit (n₀ * d₀)
      let u_prod : Units A_x := hu_prod_isUnit.unit
      have hu_prod_val : u_prod.val = algebraMap A₁ A_x n₀ * algebraMap A₁ A_x d₀ := by
        change algebraMap A₁ A_x (n₀ * d₀) = _
        exact map_mul (algebraMap A₁ A_x) n₀ d₀
      have hn_mul : algebraMap A₁ A_x n₀ * (algebraMap A₁ A_x d₀ * (u_prod⁻¹).val) = 1 := by
        rw [← mul_assoc, ← hu_prod_val, Units.mul_inv]
      have hd_mul : algebraMap A₁ A_x d₀ * (algebraMap A₁ A_x n₀ * (u_prod⁻¹).val) = 1 := by
        rw [← mul_assoc, mul_comm (algebraMap A₁ A_x d₀) (algebraMap A₁ A_x n₀),
          ← hu_prod_val, Units.mul_inv]
      let u_n : Units A_x :=
        { val := algebraMap A₁ A_x n₀
          inv := algebraMap A₁ A_x d₀ * (u_prod⁻¹).val
          val_inv := hn_mul
          inv_val := mul_comm _ (algebraMap A₁ A_x n₀) ▸ hn_mul }
      let u_d : Units A_x :=
        { val := algebraMap A₁ A_x d₀
          inv := algebraMap A₁ A_x n₀ * (u_prod⁻¹).val
          val_inv := hd_mul
          inv_val := mul_comm _ (algebraMap A₁ A_x d₀) ▸ hd_mul }
      let ũ_x : Units A_x := u_n * u_d⁻¹
      have hũ_eq : ũ_x.val * algebraMap A₁ A_x d₀ = algebraMap A₁ A_x n₀ := by
        change (u_n.val * (u_d⁻¹).val) * u_d.val = u_n.val
        rw [mul_assoc, Units.inv_mul, mul_one]
      have hres_germ : ∀ s : A₁,
          (@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom (algebraMap A₁ A_x s) =
            algebraMap A₁ ↑Z.functionField s := by
        intro s
        have hηZ_U₁ : η_Z ∈ U₁ := hUx_U₁ hηZ_Ux
        have h1 : (@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom
            ((Z.presheaf.map (CategoryTheory.homOfLE hUx_U₁).op).hom s) =
            (Z.presheaf.germ U₁ η_Z hηZ_U₁).hom s :=
          congrArg (fun φ : Z.presheaf.obj (Opposite.op U₁) ⟶ Z.presheaf.stalk η_Z => φ.hom s)
            (Z.presheaf.germ_res (CategoryTheory.homOfLE hUx_U₁) η_Z hηZ_Ux)
        have h2 : (Z.presheaf.germ U₁ η_Z hηZ_U₁).hom s = algebraMap A₁ ↑Z.functionField s := by
          rw [TopCat.Presheaf.stalk_open_algebraMap Z.presheaf ⟨η_Z, hηZ_U₁⟩]
        exact h1.trans h2
      have hgerm_ũ :
          (@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom ũ_x.val = f_Z.val := by
        apply mul_right_cancel₀ hd₀_K_ne
        calc
          (@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom ũ_x.val *
              algebraMap A₁ ↑Z.functionField d₀
            = (@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom
                (ũ_x.val * algebraMap A₁ A_x d₀) := by
                rw [map_mul, hres_germ d₀]
          _ = (@AlgebraicGeometry.Scheme.germToFunctionField Z _ U_x hNe_Ux).hom
                (algebraMap A₁ A_x n₀) := by rw [hũ_eq]
          _ = algebraMap A₁ ↑Z.functionField n₀ := hres_germ n₀
          _ = f_Z.val * algebraMap A₁ ↑Z.functionField d₀ := hfrac.symm
      refine ⟨U_x, hAff_Ux, hUx_V, hx_Ux, hNe_Ux, ũ_x, 1, ?_⟩
      rw [hgerm_ũ]
      change f.val = φ_ZV (φ_ZV.symm f.val) * (1 : ↑V₀.functionField) ^ ℓ
      rw [φ_ZV.apply_symm_apply, one_pow, mul_one]

  exact ⟨hDedZ, φ_ZV, hφ_ZV, hUnitV⟩

theorem weil_normalization_deck_equivariant_chart (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] [QuasiSeparatedSpace ↥Z]
    (V : Z.Opens)
    (L : Type u) [Field L]
    (ψ_K : ↑Z.functionField →+* L)
    (σ_L : L →+* L) (hσ_K : σ_L.comp ψ_K = ψ_K)
    (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of L)) Z)
    [AlgebraicGeometry.QuasiCompact ξ] [AlgebraicGeometry.QuasiSeparated ξ]
    (hξ_eq : ξ = CategoryTheory.CategoryStruct.comp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K))
      (Z.fromSpecStalk (genericPoint ↥Z))) :
    ∃ (σ_V' : AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map
          (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj V) ⟶
      AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map
          (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj V)),
      σ_V' ≫ (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ ∣_ V) =
        (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ ∣_ V) ∧
      ∀ (W : Z.Opens), AlgebraicGeometry.IsAffineOpen W →
        ∀ (hNeW : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})),
          ∃ (τ_W : ↑((AlgebraicGeometry.Scheme.Hom.normalization ξ).presheaf.obj
              (Opposite.op ((TopologicalSpace.Opens.map
                (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj W))) →+* L),
            Function.Injective τ_W ∧
            τ_W.comp ((AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).app W).hom =
              ψ_K.comp (@AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW).hom ∧
            (∀ z : L,
              (ψ_K.comp (@AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW).hom).IsIntegralElem z ↔
                ∃ b, τ_W b = z) ∧
            (W ≤ V →
              ∃ (e_WV : ↑((AlgebraicGeometry.Scheme.Hom.normalization ξ).presheaf.obj
                  (Opposite.op ((TopologicalSpace.Opens.map
                    (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj W))) ≃+*
                ↑((AlgebraicGeometry.Scheme.Opens.toScheme
                    ((TopologicalSpace.Opens.map
                      (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).base).obj V)).presheaf.obj
                  (Opposite.op ((TopologicalSpace.Opens.map
                    (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ ∣_ V).base).obj
                    ((TopologicalSpace.Opens.map V.ι.base).obj W)))))
                (hσ_U : ((TopologicalSpace.Opens.map
                    (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ ∣_ V).base).obj
                    ((TopologicalSpace.Opens.map V.ι.base).obj W)) ≤
                  (TopologicalSpace.Opens.map σ_V'.base).obj
                    ((TopologicalSpace.Opens.map
                      (AlgebraicGeometry.Scheme.Hom.fromNormalization ξ ∣_ V).base).obj
                      ((TopologicalSpace.Opens.map V.ι.base).obj W))),
                (∀ a : ↑(Z.presheaf.obj (Opposite.op W)),
                  e_WV (((AlgebraicGeometry.Scheme.Hom.fromNormalization ξ).app W).hom a) =
                    ((AlgebraicGeometry.Scheme.Hom.fromNormalization ξ ∣_ V).app
                      ((TopologicalSpace.Opens.map V.ι.base).obj W)).hom ((V.ι.app W).hom a)) ∧
                (∀ b,
                  τ_W (e_WV.symm ((σ_V'.appLE _ _ hσ_U).hom (e_WV b))) =
                    σ_L (τ_W b))) :=
by
  have h_appLE_congr : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : S₁ ⟶ S₂} (h : f₁ = f₂)
      (U : S₂.Opens) (U' : S₁.Opens)
      (e₁ : U' ≤ (TopologicalSpace.Opens.map f₁.base).obj U)
      (e₂ : U' ≤ (TopologicalSpace.Opens.map f₂.base).obj U),
      f₁.appLE U U' e₁ = f₂.appLE U U' e₂ := by
    rintro _ _ _ _ rfl _ _ _ _
    rfl
  let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of L)
  let η_Z := Z.fromSpecStalk (genericPoint ↥Z)
  let g_K : X₀ ⟶ AlgebraicGeometry.Spec (Z.presheaf.stalk (genericPoint ↥Z)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_K)
  let g_σ : X₀ ⟶ X₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_L)
  have hSub_KZ : Subsingleton ↥(AlgebraicGeometry.Spec (Z.presheaf.stalk (genericPoint ↥Z))) := by
    change Subsingleton (PrimeSpectrum ↑Z.functionField)
    infer_instance
  have hξ_gen : ∀ pt : ↥X₀, ξ.base pt = genericPoint ↥Z := by
    intro pt
    rw [hξ_eq, AlgebraicGeometry.Scheme.Hom.comp_apply]
    change η_Z.base (g_K.base pt) = genericPoint ↥Z
    rw [hSub_KZ.elim (g_K.base pt) (IsLocalRing.closedPoint ↑(Z.presheaf.stalk (genericPoint ↥Z)))]
    exact AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint
  have hσ_ξ : g_σ ≫ ξ = ξ := by
    rw [hξ_eq, ← CategoryTheory.Category.assoc]
    congr 1
    dsimp [g_σ, g_K]
    rw [← AlgebraicGeometry.Spec.map_comp]
    congr 1
    ext x
    exact DFunLike.congr_fun hσ_K x

  let Y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.normalization ξ
  let bar_p₀ : Y ⟶ Z := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
  let η_to : X₀ ⟶ Y := AlgebraicGeometry.Scheme.Hom.toNormalization ξ
  have hη_p₀ : η_to ≫ bar_p₀ = ξ := AlgebraicGeometry.Scheme.Hom.toNormalization_fromNormalization ξ
  have H_fac : ξ = (g_σ ≫ η_to) ≫ bar_p₀ := by
    rw [CategoryTheory.Category.assoc, hη_p₀, hσ_ξ]
  let bar_σ : Y ⟶ Y := AlgebraicGeometry.Scheme.Hom.normalizationDesc ξ (g_σ ≫ η_to) bar_p₀ H_fac
  have hbar_p : bar_σ ≫ bar_p₀ = bar_p₀ :=
    AlgebraicGeometry.Scheme.Hom.normalizationDesc_comp ξ (g_σ ≫ η_to) bar_p₀ H_fac
  have hη_σ : η_to ≫ bar_σ = g_σ ≫ η_to :=
    AlgebraicGeometry.Scheme.Hom.toNormalization_normalizationDesc ξ (g_σ ≫ η_to) bar_p₀ H_fac

  let V' : Y.Opens := (TopologicalSpace.Opens.map bar_p₀.base).obj V
  let p : V'.toScheme ⟶ V.toScheme := bar_p₀ ∣_ V
  have hrange : Set.range (V'.ι ≫ bar_σ).base ⊆ Set.range V'.ι.base := by
    rw [AlgebraicGeometry.Scheme.Opens.range_ι V']
    rintro _ ⟨y, rfl⟩
    have hyV' : V'.ι.base y ∈ (V' : Set ↥Y) := by
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι V']
      exact ⟨y, rfl⟩
    change bar_p₀.base ((V'.ι ≫ bar_σ).base y) ∈ V
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.Category.assoc, hbar_p,
      AlgebraicGeometry.Scheme.Hom.comp_apply]
    exact hyV'
  let σ_V' : V'.toScheme ⟶ V'.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift V'.ι (V'.ι ≫ bar_σ) hrange
  have hσ_ι : σ_V' ≫ V'.ι = V'.ι ≫ bar_σ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac V'.ι (V'.ι ≫ bar_σ) hrange
  have hσ_p : σ_V' ≫ p = p := by
    apply (CategoryTheory.cancel_mono V.ι).mp
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι bar_p₀ V,
      ← CategoryTheory.Category.assoc, hσ_ι, CategoryTheory.Category.assoc, hbar_p]

  refine ⟨σ_V', hσ_p, fun W hW hNeW => ?_⟩
  have ⟨w₀⟩ := hNeW
  have hw₀_mem : W.ι.base w₀ ∈ (W : Set ↥Z) := by
    rw [← AlgebraicGeometry.Scheme.Opens.range_ι W]
    exact ⟨w₀, rfl⟩
  have hgen_W : genericPoint ↥Z ∈ W :=
    ((genericPoint_spec ↥Z).mem_open_set_iff W.isOpen).mpr ⟨W.ι.base w₀, trivial, hw₀_mem⟩
  have he_ξ : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map ξ.base).obj W := by
    intro pt _
    change ξ.base pt ∈ W
    rw [hξ_gen pt]
    exact hgen_W
  have hξ_app_W : (ξ.appLE W ⊤ he_ξ ≫
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom).hom =
      ψ_K.comp (@AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW).hom := by
    have he_ηZ : (⊤ : (AlgebraicGeometry.Spec (Z.presheaf.stalk (genericPoint ↥Z))).Opens) ≤
        (TopologicalSpace.Opens.map η_Z.base).obj W := by
      intro q _
      change η_Z.base q ∈ W
      rw [hSub_KZ.elim q (IsLocalRing.closedPoint ↑(Z.presheaf.stalk (genericPoint ↥Z))),
        AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint]
      exact hgen_W
    have he_gK : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map g_K.base).obj ⊤ :=
      fun _ _ => trivial
    have h_split : ξ.appLE W ⊤ he_ξ = η_Z.appLE W ⊤ he_ηZ ≫ g_K.appLE ⊤ ⊤ he_gK := by
      rw [h_appLE_congr hξ_eq W ⊤ he_ξ
        ((TopologicalSpace.Opens.map g_K.base).monotone he_ηZ |> le_trans he_gK)]
      exact (AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE g_K η_Z W ⊤ ⊤ he_ηZ he_gK).symm
    have h_ηZ_app : η_Z.appLE W ⊤ he_ηZ =
        @AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW ≫
          (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.stalk (genericPoint ↥Z))).inv := by
      have happLE_ηZ : η_Z.appLE W ⊤ he_ηZ =
          η_Z.app W ≫
            (AlgebraicGeometry.Spec (Z.presheaf.stalk (genericPoint ↥Z))).presheaf.map
              (CategoryTheory.homOfLE he_ηZ).op := by
        rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app η_Z,
          AlgebraicGeometry.Scheme.Hom.appLE_map]
      have h_map_top : ∀ (g_op :
          Opposite.op (⊤ : (AlgebraicGeometry.Spec (Z.presheaf.stalk (genericPoint ↥Z))).Opens) ⟶
            Opposite.op ⊤),
          (AlgebraicGeometry.Spec (Z.presheaf.stalk (genericPoint ↥Z))).presheaf.map g_op = 𝟙 _ :=
        fun g_op => by
          rw [Subsingleton.elim g_op (𝟙 _), CategoryTheory.Functor.map_id]
      rw [happLE_ηZ, AlgebraicGeometry.Scheme.fromSpecStalk_app hgen_W,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← CategoryTheory.Functor.map_comp, h_map_top, CategoryTheory.Category.comp_id]
    have h_gK_app : g_K.appLE ⊤ ⊤ he_gK = g_K.appTop :=
      AlgebraicGeometry.Scheme.Hom.appLE_eq_app g_K
    have h_inv_nat :
        (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.stalk (genericPoint ↥Z))).inv ≫
          (g_K.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom) =
          CommRingCat.ofHom ψ_K :=
      (CategoryTheory.Iso.inv_comp_eq
        (AlgebraicGeometry.Scheme.ΓSpecIso (Z.presheaf.stalk (genericPoint ↥Z)))).mpr
        (AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ψ_K))
    have h_cat_xi : ξ.appLE W ⊤ he_ξ ≫
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom =
        @AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW ≫
          CommRingCat.ofHom ψ_K :=
      (congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom) h_split).trans
        ((congrArg (· ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom)
            (congrArg₂ CategoryTheory.CategoryStruct.comp h_ηZ_app h_gK_app)).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (@AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW ≫ ·)
                (CategoryTheory.Category.assoc _ _ _)).trans
              (congrArg (@AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW ≫ ·)
                h_inv_nat))))
    exact congrArg CommRingCat.Hom.hom h_cat_xi

  let A_W_cat : CommRingCat.{u} := Z.presheaf.obj (Opposite.op W)
  let A_W : Type u := ↑A_W_cat
  let W' : Y.Opens := (TopologicalSpace.Opens.map bar_p₀.base).obj W
  let B_W_cat : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W')
  let B_W : Type u := ↑B_W_cat
  let α_W : A_W →+* L := ψ_K.comp (@AlgebraicGeometry.Scheme.germToFunctionField Z _ W hNeW).hom
  have he_η : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map η_to.base).obj W' := by
    intro pt _
    change bar_p₀.base (η_to.base pt) ∈ W
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hη_p₀, hξ_gen pt]
    exact hgen_W
  let τ_W_cat : B_W_cat ⟶ CommRingCat.of L :=
    η_to.appLE W' ⊤ he_η ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom
  let τ_W : B_W →+* L := τ_W_cat.hom

  have hComp_τ : τ_W.comp (bar_p₀.app W).hom = α_W := by
    have h_cat : bar_p₀.app W ≫ τ_W_cat =
        ξ.appLE W ⊤ he_ξ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom := by
      dsimp [τ_W_cat]
      rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.appLE_eq_app bar_p₀,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE η_to bar_p₀ W W' ⊤ le_rfl he_η,
        h_appLE_congr hη_p₀ W ⊤ _ he_ξ]
    exact (congrArg CommRingCat.Hom.hom h_cat).trans hξ_app_W

  have hEqv_bar : ∀ (hσ_W' : W' ≤ (TopologicalSpace.Opens.map bar_σ.base).obj W') (b : B_W),
      τ_W ((bar_σ.appLE W' W' hσ_W').hom b) = σ_L (τ_W b) := by
    intro hσ_W' b
    have he_gσ : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map g_σ.base).obj ⊤ :=
      fun _ _ => trivial
    have h_gσ_app : g_σ.appLE ⊤ ⊤ he_gσ = g_σ.appTop :=
      AlgebraicGeometry.Scheme.Hom.appLE_eq_app g_σ
    have h_cat : bar_σ.appLE W' W' hσ_W' ≫ τ_W_cat = τ_W_cat ≫ CommRingCat.ofHom σ_L := by
      dsimp [τ_W_cat]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE η_to bar_σ W' W' ⊤ hσ_W' he_η,
        h_appLE_congr hη_σ W' ⊤ _
          ((TopologicalSpace.Opens.map g_σ.base).monotone he_η |> le_trans he_gσ),
        ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE g_σ η_to W' ⊤ ⊤ he_η he_gσ,
        h_gσ_app,
        CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.ΓSpecIso_naturality (CommRingCat.ofHom σ_L),
        ← CategoryTheory.Category.assoc]
    exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_cat) b

  have hξW_top : (TopologicalSpace.Opens.map ξ.base).obj W = ⊤ := top_unique he_ξ
  let U_ξ : X₀.Opens := (TopologicalSpace.Opens.map ξ.base).obj W
  let S_W_cat : CommRingCat.{u} := X₀.presheaf.obj (Opposite.op U_ξ)
  let S_W : Type u := ↑S_W_cat
  letI alg_AW_SW : Algebra A_W S_W := (ξ.app W).hom.toAlgebra
  letI alg_AW_L : Algebra A_W L := α_W.toAlgebra
  let e_L_cat : S_W_cat ≅ CommRingCat.of L :=
    X₀.presheaf.mapIso (CategoryTheory.eqToIso hξW_top.symm).op ≪≫
      AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)
  have h_eL_comp : (ξ.app W ≫ e_L_cat.hom).hom = α_W := by
    have h_hom_eq : (CategoryTheory.eqToIso hξW_top.symm).op.hom =
        (CategoryTheory.homOfLE he_ξ).op :=
      congrArg Opposite.op (Subsingleton.elim _ _)
    have h_cat : ξ.app W ≫ e_L_cat.hom =
        ξ.appLE W ⊤ he_ξ ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L)).hom := by
      dsimp only [e_L_cat, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
      rw [h_hom_eq, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Scheme.Hom.appLE_eq_app ξ,
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    exact (congrArg CommRingCat.Hom.hom h_cat).trans hξ_app_W
  let e_L_alg : S_W ≃ₐ[A_W] L :=
    AlgEquiv.ofRingEquiv (f := e_L_cat.commRingCatIsoToRingEquiv) (fun a => by
      change (ξ.app W ≫ e_L_cat.hom).hom a = α_W a
      exact DFunLike.congr_fun h_eL_comp a)
  let β_W : ↥(integralClosure A_W S_W) ≃ₐ[A_W] ↥(integralClosure A_W L) :=
    AlgEquiv.mapIntegralClosure e_L_alg
  let ν_W : B_W_cat ≅ CommRingCat.of ↥(integralClosure A_W S_W) :=
    AlgebraicGeometry.Scheme.Hom.normalizationObjIso ξ hW
  let Φ_W : B_W ≃+* ↥(integralClosure A_W L) :=
    ν_W.commRingCatIsoToRingEquiv.trans β_W.toRingEquiv
  have hτ_eq_Φ : ∀ b : B_W, τ_W b = (Φ_W b).1 := by
    have h_to := AlgebraicGeometry.Scheme.Hom.toNormalization_app_preimage ξ ⟨W, hW⟩
    change η_to.app W' = _ at h_to
    have happLE_η : η_to.appLE W' ⊤ he_η =
        η_to.app W' ≫ X₀.presheaf.map (CategoryTheory.homOfLE he_η).op := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app η_to,
        AlgebraicGeometry.Scheme.Hom.appLE_map]
    have h_τ_cat : τ_W_cat =
        ν_W.hom ≫ CommRingCat.ofHom (integralClosure A_W S_W).val.toRingHom ≫ e_L_cat.hom := by
      dsimp only [τ_W_cat, e_L_cat, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
      rw [happLE_η, h_to, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc]
      congr 2
    intro b
    have hb1 : τ_W b = e_L_cat.hom.hom ((ν_W.hom.hom b).1) :=
      DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_τ_cat) b
    rw [hb1]
    exact (AlgEquiv.coe_mapIntegralClosure e_L_alg (ν_W.hom.hom b)).symm

  have hInj_τ : Function.Injective τ_W := by
    intro b₁ b₂ hb
    apply Φ_W.injective
    apply Subtype.ext
    rw [← hτ_eq_Φ b₁, ← hτ_eq_Φ b₂]
    exact hb
  have hInt_τ : ∀ z : L, α_W.IsIntegralElem z ↔ ∃ b : B_W, τ_W b = z := by
    intro z
    constructor
    · intro hz
      have hz' : z ∈ integralClosure A_W L := (mem_integralClosure_iff A_W L).mpr hz
      refine ⟨Φ_W.symm ⟨z, hz'⟩, ?_⟩
      rw [hτ_eq_Φ, Φ_W.apply_symm_apply]
    · rintro ⟨b, rfl⟩
      rw [hτ_eq_Φ]
      exact (mem_integralClosure_iff A_W L).mp (Φ_W b).2

  refine ⟨τ_W, hInj_τ, hComp_τ, hInt_τ, fun hWV => ?_⟩
  let U_V : V.toScheme.Opens := (TopologicalSpace.Opens.map V.ι.base).obj W
  let U'_V : V'.toScheme.Opens := (TopologicalSpace.Opens.map p.base).obj U_V
  have hσ_U : U'_V ≤ (TopologicalSpace.Opens.map σ_V'.base).obj U'_V := by
    intro z hz
    change p.base (σ_V'.base z) ∈ U_V
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hσ_p]
    exact hz
  have hσ_W' : W' ≤ (TopologicalSpace.Opens.map bar_σ.base).obj W' := by
    intro y hy
    change bar_p₀.base (bar_σ.base y) ∈ W
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hbar_p]
    exact hy
  have hp_ι : p ≫ V.ι = V'.ι ≫ bar_p₀ := AlgebraicGeometry.morphismRestrict_ι bar_p₀ V
  have he_W' : U'_V ≤ (TopologicalSpace.Opens.map V'.ι.base).obj W' := by
    intro z hz
    have hzW : V.ι.base (p.base z) ∈ W := hz
    change bar_p₀.base (V'.ι.base z) ∈ W
    rwa [← AlgebraicGeometry.Scheme.Hom.comp_apply, ← hp_ι,
      AlgebraicGeometry.Scheme.Hom.comp_apply]
  have h_img : V'.ι.opensFunctor.obj U'_V = W' := by
    ext y
    change y ∈ V'.ι.base '' (U'_V : Set ↥V'.toScheme) ↔ y ∈ W'
    constructor
    · rintro ⟨z, hz, rfl⟩
      exact he_W' hz
    · intro hy
      have hyV : bar_p₀.base y ∈ V := hWV hy
      have hy_range : y ∈ Set.range V'.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι V']
        exact hyV
      obtain ⟨z, rfl⟩ := hy_range
      refine ⟨z, ?_, rfl⟩
      change V.ι.base (p.base z) ∈ W
      rwa [← AlgebraicGeometry.Scheme.Hom.comp_apply, hp_ι,
        AlgebraicGeometry.Scheme.Hom.comp_apply]

  let E_WV : B_W_cat ≅ V'.toScheme.presheaf.obj (Opposite.op U'_V) :=
    Y.presheaf.mapIso (CategoryTheory.eqToIso h_img).op ≪≫
      AlgebraicGeometry.Scheme.Hom.appIso V'.ι U'_V
  let e_WV : B_W ≃+* ↑(V'.toScheme.presheaf.obj (Opposite.op U'_V)) :=
    E_WV.commRingCatIsoToRingEquiv
  have hE_hom : E_WV.hom = V'.ι.appLE W' U'_V he_W' := by
    have he_pre : U'_V ≤
        (TopologicalSpace.Opens.map V'.ι.base).obj (V'.ι.opensFunctor.obj U'_V) := by
      rw [h_img]
      exact he_W'
    dsimp only [E_WV, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
    rw [AlgebraicGeometry.Scheme.Hom.appIso_hom, ← AlgebraicGeometry.Scheme.Hom.appLE_eq_app V'.ι]
    have h_map_eq : ∀ (g :
        Opposite.op ((TopologicalSpace.Opens.map V'.ι.base).obj (V'.ι.opensFunctor.obj U'_V)) ⟶
          Opposite.op U'_V),
        V'.toScheme.presheaf.map g =
          V'.toScheme.presheaf.map (CategoryTheory.homOfLE he_pre).op :=
      fun _ => congrArg V'.toScheme.presheaf.map (congrArg Opposite.op (Subsingleton.elim _ _))
    rw [h_map_eq, AlgebraicGeometry.Scheme.Hom.appLE_map]
    exact AlgebraicGeometry.Scheme.Hom.map_appLE' V'.ι he_W' h_img

  refine ⟨e_WV, hσ_U, ?_, ?_⟩
  · intro a
    have h_sec : bar_p₀.app W ≫ E_WV.hom = V.ι.app W ≫ p.app U_V := by
      rw [hE_hom, ← AlgebraicGeometry.Scheme.Hom.appLE_eq_app bar_p₀,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V'.ι bar_p₀ W W' U'_V le_rfl he_W',
        h_appLE_congr hp_ι.symm W U'_V _ le_rfl,
        ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE p V.ι W U_V U'_V le_rfl le_rfl,
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app V.ι,
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app p]
    exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_sec) a
  · intro b
    have h_conj : E_WV.hom ≫ σ_V'.appLE U'_V U'_V hσ_U ≫ E_WV.inv =
        bar_σ.appLE W' W' hσ_W' := by
      have h_inter : E_WV.hom ≫ σ_V'.appLE U'_V U'_V hσ_U =
          bar_σ.appLE W' W' hσ_W' ≫ E_WV.hom := by
        rw [hE_hom,
          AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE σ_V' V'.ι W' U'_V U'_V he_W' hσ_U,
          h_appLE_congr hσ_ι W' U'_V _
            ((TopologicalSpace.Opens.map V'.ι.base).monotone hσ_W' |> le_trans he_W'),
          ← AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE V'.ι bar_σ W' W' U'_V hσ_W' he_W']
      rw [← CategoryTheory.Category.assoc, h_inter, CategoryTheory.Category.assoc,
        E_WV.hom_inv_id, CategoryTheory.Category.comp_id]
    have hb_eq : e_WV.symm ((σ_V'.appLE U'_V U'_V hσ_U).hom (e_WV b)) =
        (bar_σ.appLE W' W' hσ_W').hom b :=
      DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_conj) b
    rw [hb_eq]
    exact hEqv_bar hσ_W' b

theorem weil_kummer_open_etale_and_pullback_cyclic_sheets (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (ζ : k)
    (hEtQ : ∀ (R : Type u) [CommRing R] [Algebra k R] (u : Units R),
      let Q_u : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C u.val
      Algebra.Etale R (AdjoinRoot Q_u) ∧
      Module.Finite R (AdjoinRoot Q_u) ∧
      ∃ σ_R : AdjoinRoot Q_u →ₐ[R] AdjoinRoot Q_u,
        σ_R (AdjoinRoot.root Q_u) =
          algebraMap R (AdjoinRoot Q_u) (algebraMap k R ζ) * AdjoinRoot.root Q_u)
    (hCRT : ∀ (R : Type u) [CommRing R] [Algebra k R] (v : Units R),
      let Q_v : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C (v ^ ℓ).val
      ∃ Φ : AdjoinRoot Q_v ≃ₐ[R] (ZMod ℓ → R),
        ∀ (σ_R : AdjoinRoot Q_v →ₐ[R] AdjoinRoot Q_v),
          σ_R (AdjoinRoot.root Q_v) =
            algebraMap R (AdjoinRoot Q_v) (algebraMap k R ζ) * AdjoinRoot.root Q_v →
          ∀ (z : AdjoinRoot Q_v) (i : ZMod ℓ), Φ (σ_R z) i = Φ z (i + 1))
    (hPiEval : ∀ (R : Type u) [CommRing R],
      let S : Type u := ZMod ℓ → R
      let e_sh : ZMod ℓ →
          (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of S)) :=
        fun i => AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod ℓ => R) i))
      (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (e_sh i)) ∧
      (_root_.Pairwise fun i j : ZMod ℓ =>
        Disjoint (Set.range (e_sh i).base) (Set.range (e_sh j).base)) ∧
      (⋃ i : ZMod ℓ, Set.range (e_sh i).base) = Set.univ)
    (V₀ V'₀ : AlgebraicGeometry.Scheme.{u})
    (p : V'₀ ⟶ V₀)
    (σ_V' : V'₀ ⟶ V'₀) (hσ_p : σ_V' ≫ p = p)
    (hLocalKummer : ∀ x : ↥V₀,
      ∃ (U_V : V₀.Opens) (_ : AlgebraicGeometry.IsAffineOpen U_V) (_ : x ∈ U_V),
        let U'_V : V'₀.Opens := (TopologicalSpace.Opens.map p.base).obj U_V
        let A := ↑(V₀.presheaf.obj (Opposite.op U_V))
        let B := ↑(V'₀.presheaf.obj (Opposite.op U'_V))
        AlgebraicGeometry.IsAffineOpen U'_V ∧
        ∃ (φ_kA : k →+* A) (ũ : Units A)
          (Ξ : AdjoinRoot ((Polynomial.X : Polynomial A) ^ ℓ - Polynomial.C ũ.val) ≃+* B)
          (hσ_U : U'_V ≤ (TopologicalSpace.Opens.map σ_V'.base).obj U'_V),
          let Q_ũ : Polynomial A := (Polynomial.X : Polynomial A) ^ ℓ - Polynomial.C ũ.val
          Ξ.toRingHom.comp (algebraMap A (AdjoinRoot Q_ũ)) = (p.app U_V).hom ∧
          Ξ.symm ((σ_V'.appLE U'_V U'_V hσ_U).hom (Ξ (AdjoinRoot.root Q_ũ))) =
            algebraMap A (AdjoinRoot Q_ũ) (φ_kA ζ) * AdjoinRoot.root Q_ũ) :
    AlgebraicGeometry.Etale p ∧
    AlgebraicGeometry.Surjective p ∧
    (∀ x : ↥V₀,
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W)
        (w : W ⟶ V₀) (_ : AlgebraicGeometry.Etale w)
        (w₀ : ↥W) (_ : w.base w₀ = x)
        (s_sh : ZMod ℓ → (W ⟶ CategoryTheory.Limits.pullback p w)),
        (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (s_sh i)) ∧
        (∀ i : ZMod ℓ,
          s_sh i ≫ CategoryTheory.Limits.pullback.snd p w =
            CategoryTheory.CategoryStruct.id W) ∧
        (∀ i : ZMod ℓ,
          s_sh i ≫ CategoryTheory.Limits.pullback.fst p w ≫ σ_V' =
            s_sh (i + 1) ≫ CategoryTheory.Limits.pullback.fst p w) ∧
        (_root_.Pairwise fun i j : ZMod ℓ =>
          Disjoint (Set.range (s_sh i).base) (Set.range (s_sh j).base)) ∧
        (⋃ i : ZMod ℓ, Set.range (s_sh i).base) = Set.univ) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hAff_pb : ∀ (U_V : V₀.Opens) (hAff_U : AlgebraicGeometry.IsAffineOpen U_V)
      (hAff_U' : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map p.base).obj U_V)),
      let U'_V : V'₀.Opens := (TopologicalSpace.Opens.map p.base).obj U_V
      (hAff_U'.fromSpec ≫ p =
        AlgebraicGeometry.Spec.map (p.app U_V) ≫ hAff_U.fromSpec) ∧
      CategoryTheory.IsPullback
        hAff_U'.fromSpec
        (AlgebraicGeometry.Spec.map (p.app U_V))
        p
        hAff_U.fromSpec ∧
      (p ∣_ U_V) =
        hAff_U'.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (p.app U_V) ≫
          hAff_U.isoSpec.inv := by
    intro U_V hAff_U hAff_U'
    let U'_V : V'₀.Opens := (TopologicalSpace.Opens.map p.base).obj U_V
    have hsq : hAff_U'.fromSpec ≫ p =
        AlgebraicGeometry.Spec.map (p.app U_V) ≫ hAff_U.fromSpec := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app p]
      exact (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p hAff_U hAff_U' le_rfl).symm
    have h_range : ∀ s : CategoryTheory.Limits.PullbackCone p hAff_U.fromSpec,
        Set.range s.fst.base ⊆ Set.range hAff_U'.fromSpec.base := by
      intro s _ hy
      obtain ⟨t, rfl⟩ := hy
      rw [hAff_U'.range_fromSpec]
      change p.base (s.fst.base t) ∈ (U_V : Set ↥V₀)
      have hcond : p.base (s.fst.base t) = hAff_U.fromSpec.base (s.snd.base t) :=
        congrArg (fun g : s.pt ⟶ V₀ => g.base t) s.condition
      rw [hcond, ← hAff_U.range_fromSpec]
      exact ⟨s.snd.base t, rfl⟩
    have hpb : CategoryTheory.IsPullback
        hAff_U'.fromSpec
        (AlgebraicGeometry.Spec.map (p.app U_V))
        p
        hAff_U.fromSpec := by
      refine ⟨⟨hsq⟩, ⟨CategoryTheory.Limits.PullbackCone.IsLimit.mk hsq
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift hAff_U'.fromSpec s.fst (h_range s))
        ?_ ?_ ?_⟩⟩
      · intro s
        exact AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_U'.fromSpec s.fst (h_range s)
      · intro s
        apply (CategoryTheory.cancel_mono hAff_U.fromSpec).mp
        calc
          (AlgebraicGeometry.IsOpenImmersion.lift hAff_U'.fromSpec s.fst (h_range s) ≫
              AlgebraicGeometry.Spec.map (p.app U_V)) ≫ hAff_U.fromSpec
            = AlgebraicGeometry.IsOpenImmersion.lift hAff_U'.fromSpec s.fst (h_range s) ≫
                (AlgebraicGeometry.Spec.map (p.app U_V) ≫ hAff_U.fromSpec) :=
              CategoryTheory.Category.assoc _ _ _
          _ = AlgebraicGeometry.IsOpenImmersion.lift hAff_U'.fromSpec s.fst (h_range s) ≫
                (hAff_U'.fromSpec ≫ p) := by rw [← hsq]
          _ = (AlgebraicGeometry.IsOpenImmersion.lift hAff_U'.fromSpec s.fst (h_range s) ≫
                hAff_U'.fromSpec) ≫ p := (CategoryTheory.Category.assoc _ _ _).symm
          _ = s.fst ≫ p :=
              congrArg (· ≫ p)
                (AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_U'.fromSpec s.fst (h_range s))
          _ = s.snd ≫ hAff_U.fromSpec := s.condition
      · intro s m hm₁ _
        exact (CategoryTheory.cancel_mono hAff_U'.fromSpec).mp
          (hm₁.trans
            (AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_U'.fromSpec s.fst (h_range s)).symm)
    have hres : (p ∣_ U_V) =
        hAff_U'.isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (p.app U_V) ≫
          hAff_U.isoSpec.inv := by
      rw [← CategoryTheory.cancel_mono U_V.ι, AlgebraicGeometry.morphismRestrict_ι p U_V,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        hAff_U.isoSpec_inv_ι, ← hsq, ← hAff_U'.isoSpec_inv_ι]
      simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_assoc]
    exact ⟨hsq, hpb, hres⟩

  have hKummerAlg : ∀ (A : Type u) [CommRing A] [Nontrivial A]
      (φ_kA : k →+* A) (ũ : Units A),
      let Q_ũ : Polynomial A := (Polynomial.X : Polynomial A) ^ ℓ - Polynomial.C ũ.val
      let R : Type u := AdjoinRoot Q_ũ
      RingHom.Etale (algebraMap A R) ∧
      Function.Surjective (PrimeSpectrum.comap (algebraMap A R)) ∧
      ∃ (ψ₁ ψ₂ : R →+* (ZMod ℓ → R)),
        CategoryTheory.IsPushout
          (CommRingCat.ofHom (algebraMap A R))
          (CommRingCat.ofHom (algebraMap A R))
          (CommRingCat.ofHom ψ₁)
          (CommRingCat.ofHom ψ₂) ∧
        (∀ i : ZMod ℓ,
          (Pi.evalRingHom (fun _ : ZMod ℓ => R) i).comp ψ₂ = RingHom.id R) ∧
        (∀ (σ_conj : R →+* R),
          σ_conj.comp (algebraMap A R) = algebraMap A R →
          σ_conj (AdjoinRoot.root Q_ũ) =
            algebraMap A R (φ_kA ζ) * AdjoinRoot.root Q_ũ →
          ∀ i : ZMod ℓ,
            (Pi.evalRingHom (fun _ : ZMod ℓ => R) i).comp (ψ₁.comp σ_conj) =
              (Pi.evalRingHom (fun _ : ZMod ℓ => R) (i + 1)).comp ψ₁) := by
    intro A _ _ φ_kA ũ
    let Q_ũ : Polynomial A := (Polynomial.X : Polynomial A) ^ ℓ - Polynomial.C ũ.val
    let R : Type u := AdjoinRoot Q_ũ
    let _ : Algebra k A := φ_kA.toAlgebra
    obtain ⟨hEt_AR_alg, hFin_AR, _⟩ := hEtQ A ũ
    have hEt_AR : RingHom.Etale (algebraMap A R) := RingHom.etale_algebraMap.mpr hEt_AR_alg
    have hMonic : Q_ũ.Monic := Polynomial.monic_X_pow_sub_C ũ.val hPrime.ne_zero
    let pb : PowerBasis A R := AdjoinRoot.powerBasis' hMonic
    have hNatDeg : Q_ũ.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C
    have hDim : pb.dim = ℓ := (AdjoinRoot.powerBasis'_dim hMonic).trans hNatDeg
    let i₀ : Fin pb.dim := ⟨0, hDim.symm ▸ hPrime.pos⟩
    have hpb0 : pb.basis i₀ = 1 := by
      rw [pb.basis_eq_pow i₀]
      exact pow_zero pb.gen
    have hInj_AR : Function.Injective (algebraMap A R) := by
      intro a₁ a₂ ha
      have hrepr : ∀ a : A, pb.basis.repr (algebraMap A R a) i₀ = a := fun a => by
        rw [Algebra.algebraMap_eq_smul_one, ← hpb0, LinearEquiv.map_smul,
          Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
          Finsupp.single_eq_same]
      exact (hrepr a₁).symm.trans ((congrArg (fun z => pb.basis.repr z i₀) ha).trans (hrepr a₂))
    have : Module.Finite A R := hFin_AR
    have : Algebra.IsIntegral A R := Algebra.IsIntegral.of_finite A R
    have hInt_AR : (algebraMap A R).IsIntegral := algebraMap_isIntegral_iff.mpr inferInstance
    have hSurj_AR : Function.Surjective (PrimeSpectrum.comap (algebraMap A R)) :=
      RingHom.IsIntegral.comap_surjective hInt_AR hInj_AR
    let r₀ : R := AdjoinRoot.root Q_ũ
    have hr₀_pow : r₀ ^ ℓ = algebraMap A R ũ.val := by
      have hev := AdjoinRoot.eval₂_root Q_ũ
      simp only [Q_ũ, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
        sub_eq_zero] at hev
      exact hev
    have hexp : (ℓ - 1) + 1 = ℓ := Nat.sub_add_cancel hPrime.pos
    let v_inv : R := r₀ ^ (ℓ - 1) * algebraMap A R (ũ⁻¹).val
    have hv_mul : r₀ * v_inv = 1 := by
      dsimp [v_inv]
      rw [← mul_assoc, ← pow_succ', hexp, hr₀_pow, ← map_mul, Units.mul_inv, map_one]
    let v : Units R :=
      { val := r₀
        inv := v_inv
        val_inv := hv_mul
        inv_val := mul_comm v_inv r₀ ▸ hv_mul }
    have hv_pow_val : (v ^ ℓ).val = algebraMap A R ũ.val := hr₀_pow
    let _ : Algebra k R := ((algebraMap A R).comp φ_kA).toAlgebra
    let Q_v : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C (v ^ ℓ).val
    let ι₂ : R →+* AdjoinRoot Q_v := algebraMap R (AdjoinRoot Q_v)
    have hev_ι₁ : Polynomial.eval₂ (ι₂.comp (algebraMap A R)) (AdjoinRoot.root Q_v) Q_ũ = 0 := by
      have hev := AdjoinRoot.eval₂_root Q_v
      simp only [Q_v, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at hev
      simp only [Q_ũ, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      change (AdjoinRoot.root Q_v) ^ ℓ - ι₂ (algebraMap A R ũ.val) = 0
      rw [← hv_pow_val]
      exact hev
    let ι₁ : R →+* AdjoinRoot Q_v :=
      AdjoinRoot.lift (ι₂.comp (algebraMap A R)) (AdjoinRoot.root Q_v) hev_ι₁
    obtain ⟨Φ, hΦ_eq⟩ := hCRT R v
    let ψ₁ : R →+* (ZMod ℓ → R) := Φ.toRingHom.comp ι₁
    let ψ₂ : R →+* (ZMod ℓ → R) := Φ.toRingHom.comp ι₂
    have hw_push : CommRingCat.ofHom (algebraMap A R) ≫ CommRingCat.ofHom ψ₁ =
        CommRingCat.ofHom (algebraMap A R) ≫ CommRingCat.ofHom ψ₂ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      change Φ (ι₁ (AdjoinRoot.of Q_ũ a)) = Φ (ι₂ (algebraMap A R a))
      rw [AdjoinRoot.lift_of]
      rfl
    have h_ev_s : ∀ s : CategoryTheory.Limits.PushoutCocone
        (CommRingCat.ofHom (algebraMap A R)) (CommRingCat.ofHom (algebraMap A R)),
        Polynomial.eval₂ s.inr.hom (s.inl.hom r₀) Q_v = 0 := by
      intro s
      simp only [Q_v, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      rw [← map_pow, hr₀_pow, hv_pow_val]
      have hcond : s.inl.hom (algebraMap A R ũ.val) = s.inr.hom (algebraMap A R ũ.val) :=
        congrArg (fun f : CommRingCat.of A ⟶ s.pt => f.hom ũ.val) s.condition
      rw [hcond, sub_self]
    have hPush : CategoryTheory.IsPushout
        (CommRingCat.ofHom (algebraMap A R))
        (CommRingCat.ofHom (algebraMap A R))
        (CommRingCat.ofHom ψ₁)
        (CommRingCat.ofHom ψ₂) := by
      refine ⟨⟨hw_push⟩, ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk hw_push
        (fun s => CommRingCat.ofHom
          ((AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s)).comp Φ.symm.toRingHom))
        ?_ ?_ ?_⟩⟩
      · intro s
        apply CommRingCat.hom_ext
        have hcomp : ((AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s)).comp
            Φ.symm.toRingHom).comp ψ₁ = s.inl.hom := by
          apply AdjoinRoot.ringHom_ext
          · apply RingHom.ext
            intro a
            change AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s)
              (Φ.symm (Φ (ι₁ (AdjoinRoot.of Q_ũ a)))) = s.inl.hom (AdjoinRoot.of Q_ũ a)
            rw [Φ.symm_apply_apply, AdjoinRoot.lift_of]
            change AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s)
              (AdjoinRoot.of Q_v (algebraMap A R a)) = s.inl.hom (algebraMap A R a)
            rw [AdjoinRoot.lift_of]
            exact (congrArg (fun f : CommRingCat.of A ⟶ s.pt => f.hom a) s.condition).symm
          · change AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s)
              (Φ.symm (Φ (ι₁ (AdjoinRoot.root Q_ũ)))) = s.inl.hom (AdjoinRoot.root Q_ũ)
            rw [Φ.symm_apply_apply, AdjoinRoot.lift_root, AdjoinRoot.lift_root]
        exact hcomp
      · intro s
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        change AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s)
          (Φ.symm (Φ (AdjoinRoot.of Q_v r))) = s.inr.hom r
        rw [Φ.symm_apply_apply, AdjoinRoot.lift_of]
      · intro s m hm₁ hm₂
        have hm_Φ : m.hom.comp Φ.toRingHom =
            AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s) := by
          apply AdjoinRoot.ringHom_ext
          · apply RingHom.ext
            intro r
            have hr : m.hom (ψ₂ r) = s.inr.hom r :=
              congrArg (fun f : CommRingCat.of R ⟶ s.pt => f.hom r) hm₂
            change m.hom (ψ₂ r) =
              AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s) (AdjoinRoot.of Q_v r)
            rw [hr, AdjoinRoot.lift_of]
          · have hroot : m.hom (ψ₁ r₀) = s.inl.hom r₀ :=
              congrArg (fun f : CommRingCat.of R ⟶ s.pt => f.hom r₀) hm₁
            change m.hom (Φ (AdjoinRoot.root Q_v)) =
              AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s) (AdjoinRoot.root Q_v)
            have hι₁_r₀ : m.hom (Φ (AdjoinRoot.root Q_v)) = m.hom (ψ₁ r₀) := by
              change m.hom (Φ (AdjoinRoot.root Q_v)) = m.hom (Φ (ι₁ (AdjoinRoot.root Q_ũ)))
              rw [AdjoinRoot.lift_root]
            exact (hι₁_r₀.trans hroot).trans (AdjoinRoot.lift_root (h := h_ev_s s)).symm
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro z
        change m.hom z =
          AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s) (Φ.symm z)
        have hz : z = Φ (Φ.symm z) := (Φ.apply_symm_apply z).symm
        calc
          m.hom z = m.hom (Φ (Φ.symm z)) := congrArg m.hom hz
          _ = (m.hom.comp Φ.toRingHom) (Φ.symm z) := rfl
          _ = AdjoinRoot.lift s.inr.hom (s.inl.hom r₀) (h_ev_s s) (Φ.symm z) :=
              congrArg (fun f : AdjoinRoot Q_v →+* s.pt => f (Φ.symm z)) hm_Φ
    refine ⟨hEt_AR, hSurj_AR, ψ₁, ψ₂, hPush, ?_, ?_⟩
    · intro i
      apply RingHom.ext
      intro r
      change Φ (algebraMap R (AdjoinRoot Q_v) r) i = r
      rw [Φ.commutes r]
      rfl
    · intro σ_conj hσ_A hσ_r₀ i
      obtain ⟨_, _, σ_R, hσ_R⟩ := hEtQ R (v ^ ℓ)
      have hι₁_σ : ι₁.comp σ_conj = σ_R.toRingHom.comp ι₁ := by
        apply AdjoinRoot.ringHom_ext
        · apply RingHom.ext
          intro a
          have ha : σ_conj (AdjoinRoot.of Q_ũ a) = AdjoinRoot.of Q_ũ a :=
            congrArg (fun f : A →+* R => f a) hσ_A
          change ι₁ (σ_conj (AdjoinRoot.of Q_ũ a)) = σ_R (ι₁ (AdjoinRoot.of Q_ũ a))
          rw [ha, AdjoinRoot.lift_of]
          exact (σ_R.commutes (algebraMap A R a)).symm
        · change ι₁ (σ_conj (AdjoinRoot.root Q_ũ)) = σ_R (ι₁ (AdjoinRoot.root Q_ũ))
          rw [hσ_r₀, map_mul, AdjoinRoot.lift_root]
          have h_of : ι₁ (algebraMap A R (φ_kA ζ)) =
              algebraMap R (AdjoinRoot Q_v) (algebraMap k R ζ) := by
            change ι₁ (AdjoinRoot.of Q_ũ (φ_kA ζ)) = _
            rw [AdjoinRoot.lift_of]
            rfl
          rw [h_of, hσ_R]
      apply RingHom.ext
      intro y
      change Φ ((ι₁.comp σ_conj) y) i = Φ (ι₁ y) (i + 1)
      rw [hι₁_σ]
      exact hΦ_eq σ_R hσ_R (ι₁ y) i

  have hEtale_p : AlgebraicGeometry.Etale p := by
    let U_cov : ↥V₀ → V₀.Opens := fun x => (hLocalKummer x).choose
    have hSup : (⨆ x : ↥V₀, U_cov x) = ⊤ :=
      eq_top_iff.mpr fun y _ =>
        TopologicalSpace.Opens.mem_iSup.mpr ⟨y, (hLocalKummer y).choose_spec.choose_spec.choose⟩
    have hHasRHP : AlgebraicGeometry.HasRingHomProperty @AlgebraicGeometry.Etale.{u}
        (fun {R S : Type u} [CommRing R] [CommRing S] => RingHom.Etale) := inferInstance
    have : AlgebraicGeometry.IsZariskiLocalAtTarget @AlgebraicGeometry.Etale.{u} :=
      @AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtTarget
        @AlgebraicGeometry.Etale.{u} _ hHasRHP
    refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
      (P := @AlgebraicGeometry.Etale.{u}) U_cov hSup (fun x => ?_)
    let U_V : V₀.Opens := U_cov x
    have hAff_U : AlgebraicGeometry.IsAffineOpen U_V := (hLocalKummer x).choose_spec.choose
    obtain ⟨hAff_U', φ_kA, ũ, Ξ, _, hΞ_A, _⟩ :=
      (hLocalKummer x).choose_spec.choose_spec.choose_spec
    let U'_V : V'₀.Opens := (TopologicalSpace.Opens.map p.base).obj U_V
    let A_cat : CommRingCat.{u} := V₀.presheaf.obj (Opposite.op U_V)
    let B_cat : CommRingCat.{u} := V'₀.presheaf.obj (Opposite.op U'_V)
    let A : Type u := ↑A_cat
    let B : Type u := ↑B_cat
    let Q_ũ : Polynomial A := (Polynomial.X : Polynomial A) ^ ℓ - Polynomial.C ũ.val
    let R : Type u := AdjoinRoot Q_ũ
    let _ : Algebra k A := φ_kA.toAlgebra
    have hEt_AR : RingHom.Etale (algebraMap A R) :=
      RingHom.etale_algebraMap.mpr (hEtQ A ũ).1
    have : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_AR
    let e_Ξ : CommRingCat.of R ≅ B_cat :=
      { hom := CommRingCat.ofHom Ξ.toRingHom
        inv := CommRingCat.ofHom Ξ.symm.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun z => Ξ.symm_apply_apply z)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun b => Ξ.apply_symm_apply b) }
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map e_Ξ.hom) :=
      ⟨⟨AlgebraicGeometry.Spec.map e_Ξ.inv,
        by rw [← AlgebraicGeometry.Spec.map_comp, e_Ξ.inv_hom_id, AlgebraicGeometry.Spec.map_id],
        by rw [← AlgebraicGeometry.Spec.map_comp, e_Ξ.hom_inv_id, AlgebraicGeometry.Spec.map_id]⟩⟩
    have happ_fac : p.app U_V = CommRingCat.ofHom (algebraMap A R) ≫ e_Ξ.hom :=
      CommRingCat.hom_ext (RingHom.ext fun a => (congrArg (fun f : A →+* B => f a) hΞ_A).symm)
    have hSpec_fac : AlgebraicGeometry.Spec.map (p.app U_V) =
        AlgebraicGeometry.Spec.map e_Ξ.hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R)) := by
      rw [happ_fac, AlgebraicGeometry.Spec.map_comp]
    have hres_eq := (hAff_pb U_V hAff_U hAff_U').2.2
    rw [hres_eq, hSpec_fac]
    infer_instance

  have hPointwise : ∀ x : ↥V₀,
      (∃ y : ↥V'₀, p.base y = x) ∧
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W)
        (w : W ⟶ V₀) (_ : AlgebraicGeometry.Etale w)
        (w₀ : ↥W) (_ : w.base w₀ = x)
        (s_sh : ZMod ℓ → (W ⟶ CategoryTheory.Limits.pullback p w)),
        (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (s_sh i)) ∧
        (∀ i : ZMod ℓ,
          s_sh i ≫ CategoryTheory.Limits.pullback.snd p w =
            CategoryTheory.CategoryStruct.id W) ∧
        (∀ i : ZMod ℓ,
          s_sh i ≫ CategoryTheory.Limits.pullback.fst p w ≫ σ_V' =
            s_sh (i + 1) ≫ CategoryTheory.Limits.pullback.fst p w) ∧
        (_root_.Pairwise fun i j : ZMod ℓ =>
          Disjoint (Set.range (s_sh i).base) (Set.range (s_sh j).base)) ∧
        (⋃ i : ZMod ℓ, Set.range (s_sh i).base) = Set.univ := by
    intro x
    obtain ⟨U_V, hAff_U, hx_U, hAff_U', φ_kA, ũ, Ξ, hσ_U, hΞ_A, hΞ_σ⟩ := hLocalKummer x
    let U'_V : V'₀.Opens := (TopologicalSpace.Opens.map p.base).obj U_V
    let A_cat : CommRingCat.{u} := V₀.presheaf.obj (Opposite.op U_V)
    let B_cat : CommRingCat.{u} := V'₀.presheaf.obj (Opposite.op U'_V)
    let A : Type u := ↑A_cat
    let B : Type u := ↑B_cat
    let Q_ũ : Polynomial A := (Polynomial.X : Polynomial A) ^ ℓ - Polynomial.C ũ.val
    let R : Type u := AdjoinRoot Q_ũ
    let q_A : PrimeSpectrum A := hAff_U.primeIdealOf ⟨x, hx_U⟩
    have : Nontrivial A := (PrimeSpectrum.nonempty_iff_nontrivial (R := A)).mp ⟨q_A⟩
    obtain ⟨hsq_U, hpb_U, _⟩ := hAff_pb U_V hAff_U hAff_U'
    obtain ⟨hEt_AR, hSurj_AR, ψ₁, ψ₂, hPush, hSnd, hShift_cond⟩ := hKummerAlg A φ_kA ũ
    obtain ⟨q_R, hq_R⟩ := hSurj_AR q_A
    have hSurj_x : ∃ y : ↥V'₀, p.base y = x := by
      let q_B : PrimeSpectrum B := PrimeSpectrum.comap Ξ.symm.toRingHom q_R
      have hcomap_B : (AlgebraicGeometry.Spec.map (p.app U_V)).base q_B = q_A := by
        change PrimeSpectrum.comap (p.app U_V).hom q_B = q_A
        rw [← hq_R]
        ext a
        change Ξ.symm ((p.app U_V).hom a) ∈ q_R.asIdeal ↔ algebraMap A R a ∈ q_R.asIdeal
        have ha : (p.app U_V).hom a = Ξ (algebraMap A R a) :=
          (congrArg (fun f : A →+* B => f a) hΞ_A).symm
        rw [ha, Ξ.symm_apply_apply]
      refine ⟨hAff_U'.fromSpec.base q_B, ?_⟩
      have h1 : p.base (hAff_U'.fromSpec.base q_B) =
          hAff_U.fromSpec.base ((AlgebraicGeometry.Spec.map (p.app U_V)).base q_B) :=
        congrArg (fun g : AlgebraicGeometry.Spec B_cat ⟶ V₀ => g.base q_B) hsq_U
      exact h1.trans
        ((congrArg hAff_U.fromSpec.base hcomap_B).trans (hAff_U.fromSpec_primeIdealOf ⟨x, hx_U⟩))
    let R_cat : CommRingCat.{u} := CommRingCat.of R
    let S_cat : CommRingCat.{u} := CommRingCat.of (ZMod ℓ → R)
    let φ_AR : A →+* R := algebraMap A R
    let W : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec R_cat
    have : AlgebraicGeometry.IsAffine W := inferInstance
    have : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_AR
    let w : W ⟶ V₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR) ≫ hAff_U.fromSpec
    have hEt_w : AlgebraicGeometry.Etale w := inferInstance
    let w₀ : ↥W := q_R
    have hw₀ : w.base w₀ = x := by
      change hAff_U.fromSpec.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR)).base q_R) = x
      exact (congrArg hAff_U.fromSpec.base hq_R).trans (hAff_U.fromSpec_primeIdealOf ⟨x, hx_U⟩)
    let e_Ξ : R_cat ≅ B_cat :=
      { hom := CommRingCat.ofHom Ξ.toRingHom
        inv := CommRingCat.ofHom Ξ.symm.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun z => Ξ.symm_apply_apply z)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun b => Ξ.apply_symm_apply b) }
    have hpb_1 : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR)) :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
    have h_mid_comm : AlgebraicGeometry.Spec.map e_Ξ.inv ≫
        AlgebraicGeometry.Spec.map (p.app U_V) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR) ≫
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of A)) := by
      rw [CategoryTheory.Category.comp_id, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      change Ξ.symm ((p.app U_V).hom a) = φ_AR a
      have ha : (p.app U_V).hom a = Ξ (φ_AR a) :=
        (congrArg (fun f : A →+* B => f a) hΞ_A).symm
      rw [ha, Ξ.symm_apply_apply]
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map e_Ξ.inv) :=
      ⟨⟨AlgebraicGeometry.Spec.map e_Ξ.hom,
        by rw [← AlgebraicGeometry.Spec.map_comp, e_Ξ.hom_inv_id, AlgebraicGeometry.Spec.map_id],
        by rw [← AlgebraicGeometry.Spec.map_comp, e_Ξ.inv_hom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
    have hpb_2 : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map e_Ξ.inv)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR))
        (AlgebraicGeometry.Spec.map (p.app U_V))
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of A))) :=
      CategoryTheory.IsPullback.of_horiz_isIso ⟨h_mid_comm⟩
    let π₁ : B →+* (ZMod ℓ → R) := ψ₁.comp Ξ.symm.toRingHom
    have hπ₁_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₁) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₁) ≫
          AlgebraicGeometry.Spec.map e_Ξ.inv :=
      AlgebraicGeometry.Spec.map_comp (CommRingCat.ofHom Ξ.symm.toRingHom) (CommRingCat.ofHom ψ₁)
    have hpb_12 : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₁))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂))
        (AlgebraicGeometry.Spec.map (p.app U_V))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AR)) := by
      have hp := hpb_1.paste_horiz hpb_2
      rwa [← hπ₁_map, CategoryTheory.Category.comp_id] at hp
    have hpb_total : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₁) ≫ hAff_U'.fromSpec)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₂))
        p
        w :=
      hpb_12.paste_horiz hpb_U
    let Ψ_pb : AlgebraicGeometry.Spec S_cat ≅ CategoryTheory.Limits.pullback p w :=
      hpb_total.isoPullback
    obtain ⟨hOpen_e, hDisj_e, hUniv_e⟩ := hPiEval R
    let e_sh : ZMod ℓ → (W ⟶ AlgebraicGeometry.Spec S_cat) :=
      fun i => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod ℓ => R) i))
    let s_sh : ZMod ℓ → (W ⟶ CategoryTheory.Limits.pullback p w) :=
      fun i => e_sh i ≫ Ψ_pb.hom
    let σ_conj : R →+* R :=
      Ξ.symm.toRingHom.comp (((σ_V'.appLE U'_V U'_V hσ_U).hom).comp Ξ.toRingHom)
    have happLE_congr : ∀ {f₁ f₂ : V'₀ ⟶ V₀} (_h : f₁ = f₂)
        (e₁ : U'_V ≤ (TopologicalSpace.Opens.map f₁.base).obj U_V)
        (e₂ : U'_V ≤ (TopologicalSpace.Opens.map f₂.base).obj U_V),
        f₁.appLE U_V U'_V e₁ = f₂.appLE U_V U'_V e₂ := by
      rintro _ _ rfl _ _
      rfl
    have hσ_A : σ_conj.comp φ_AR = φ_AR := by
      have hcomp_app : p.app U_V ≫ σ_V'.appLE U'_V U'_V hσ_U = p.app U_V := by
        calc
          p.app U_V ≫ σ_V'.appLE U'_V U'_V hσ_U
            = (σ_V' ≫ p).appLE U_V U'_V hσ_U :=
              (AlgebraicGeometry.Scheme.Hom.comp_appLE σ_V' p U_V U'_V hσ_U).symm
          _ = p.appLE U_V U'_V le_rfl := happLE_congr hσ_p hσ_U le_rfl
          _ = p.app U_V := AlgebraicGeometry.Scheme.Hom.appLE_eq_app p
      apply RingHom.ext
      intro a
      have ha_app : (σ_V'.appLE U'_V U'_V hσ_U).hom ((p.app U_V).hom a) = (p.app U_V).hom a :=
        congrArg (fun f : A_cat ⟶ B_cat => f.hom a) hcomp_app
      have ha_Ξ : (p.app U_V).hom a = Ξ (φ_AR a) :=
        (congrArg (fun f : A →+* B => f a) hΞ_A).symm
      change Ξ.symm ((σ_V'.appLE U'_V U'_V hσ_U).hom (Ξ (φ_AR a))) = φ_AR a
      rw [← ha_Ξ, ha_app, ha_Ξ, Ξ.symm_apply_apply]
    have hShift := hShift_cond σ_conj hσ_A hΞ_σ
    refine ⟨hSurj_x, W, inferInstance, w, hEt_w, w₀, hw₀, s_sh, ?_, ?_, ?_, ?_, ?_⟩
    · intro i
      have : AlgebraicGeometry.IsOpenImmersion (e_sh i) := hOpen_e i
      exact inferInstance
    · intro i
      dsimp [s_sh, e_sh]
      rw [CategoryTheory.Category.assoc, CategoryTheory.IsPullback.isoPullback_hom_snd,
        ← AlgebraicGeometry.Spec.map_comp]
      have hid_ring : CommRingCat.ofHom ψ₂ ≫
          CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod ℓ => R) i) = 𝟙 R_cat :=
        CommRingCat.hom_ext (RingHom.ext fun r => congrArg (fun f : R →+* R => f r) (hSnd i))
      rw [hid_ring, AlgebraicGeometry.Spec.map_id]
    · intro i
      dsimp [s_sh, e_sh]
      have hσ_fromSpec : hAff_U'.fromSpec ≫ σ_V' =
          AlgebraicGeometry.Spec.map (σ_V'.appLE U'_V U'_V hσ_U) ≫ hAff_U'.fromSpec :=
        (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec σ_V' hAff_U' hAff_U' hσ_U).symm
      rw [CategoryTheory.Category.assoc (e_sh i),
        ← CategoryTheory.Category.assoc Ψ_pb.hom,
        CategoryTheory.IsPullback.isoPullback_hom_fst,
        CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₁)),
        hσ_fromSpec,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π₁)),
        ← CategoryTheory.Category.assoc (e_sh i),
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc (e_sh (i + 1)),
        CategoryTheory.IsPullback.isoPullback_hom_fst,
        ← CategoryTheory.Category.assoc (e_sh (i + 1)),
        ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro b
      change (Pi.evalRingHom (fun _ : ZMod ℓ => R) i)
          (ψ₁ (Ξ.symm ((σ_V'.appLE U'_V U'_V hσ_U).hom b))) =
        (Pi.evalRingHom (fun _ : ZMod ℓ => R) (i + 1)) (ψ₁ (Ξ.symm b))
      have hb : b = Ξ (Ξ.symm b) := (Ξ.apply_symm_apply b).symm
      conv_lhs => rw [hb]
      exact congrArg (fun f : R →+* R => f (Ξ.symm b)) (hShift i)
    · intro i j hij
      have hInj_Ψ : Function.Injective Ψ_pb.hom.base := by
        intro z₁ z₂ hz
        have h1 : (Ψ_pb.hom ≫ Ψ_pb.inv).base z₁ = z₁ :=
          congrArg (fun g : AlgebraicGeometry.Spec S_cat ⟶ AlgebraicGeometry.Spec S_cat => g.base z₁)
            Ψ_pb.hom_inv_id
        have h2 : (Ψ_pb.hom ≫ Ψ_pb.inv).base z₂ = z₂ :=
          congrArg (fun g : AlgebraicGeometry.Spec S_cat ⟶ AlgebraicGeometry.Spec S_cat => g.base z₂)
            Ψ_pb.hom_inv_id
        exact h1.symm.trans ((congrArg Ψ_pb.inv.base hz).trans h2)
      have hrange : ∀ m : ZMod ℓ,
          Set.range (s_sh m).base = Ψ_pb.hom.base '' Set.range (e_sh m).base := by
        intro m
        ext z
        constructor
        · rintro ⟨q, rfl⟩
          exact ⟨(e_sh m).base q, ⟨q, rfl⟩, rfl⟩
        · rintro ⟨_, ⟨q, rfl⟩, rfl⟩
          exact ⟨q, rfl⟩
      rw [hrange i, hrange j]
      exact Set.disjoint_image_of_injective hInj_Ψ (hDisj_e hij)
    · refine Set.eq_univ_iff_forall.mpr (fun z => ?_)
      have hz₀ : Ψ_pb.inv.base z ∈ (⋃ i : ZMod ℓ, Set.range (e_sh i).base) := by
        rw [hUniv_e]
        trivial
      obtain ⟨i, q, hq⟩ := Set.mem_iUnion.mp hz₀
      refine Set.mem_iUnion.mpr ⟨i, q, ?_⟩
      change Ψ_pb.hom.base ((e_sh i).base q) = z
      rw [hq]
      exact congrArg (fun g : CategoryTheory.Limits.pullback p w ⟶ CategoryTheory.Limits.pullback p w =>
        g.base z) Ψ_pb.inv_hom_id

  exact ⟨hEtale_p, ⟨fun x => (hPointwise x).1⟩, fun x => (hPointwise x).2⟩

theorem weil_kummer_prime_curve_normalization_cyclic_cover (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C_bar.left]
    (hProjC : IsProjectiveOverField k C_bar)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom]
    (hDimC : topologicalKrullDim C_bar.left = (1 : WithBot ℕ∞))
    (hStalkDVR_C : ∀ x : { x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) },
      ∃ hDom : IsDomain ↑(C_bar.left.presheaf.stalk x.1),
        @IsDiscreteValuationRing ↑(C_bar.left.presheaf.stalk x.1) _ hDom)
    (hProjFin : ∀ {Y Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))}
      (g : Y ⟶ Z),
      AlgebraicGeometry.IsIntegral Y.left →
      AlgebraicGeometry.IsIntegral Z.left →
      IsProjectiveOverField k Z →
      AlgebraicGeometry.IsFinite g.left →
      AlgebraicGeometry.Surjective g.left →
      IsProjectiveOverField k Y ∧
      topologicalKrullDim Y.left = topologicalKrullDim Z.left)
    (hSmNormal : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
      [Algebra k A] [Algebra.FiniteType k A],
      ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) →
      ∀ (p : Ideal A) [p.IsPrime], p.height ≤ 1 →
        ∃ h : A, h ∉ p ∧ Algebra.IsStandardSmoothOfRelativeDimension 1 k (Localization.Away h))
    (V : C_bar.left.Opens) (hNe_V : Nonempty ↥V)
    [AlgebraicGeometry.IsIntegral V.toScheme]
    (s_f : ↥((weilEtaleKPresheaf V.toScheme).obj
      (Opposite.op (weilEtaleIdTerminal.{u} V.toScheme))))
    (f : Units ↑V.toScheme.functionField)
    (hf_not_pow : ∀ g : Units ↑V.toScheme.functionField, g ^ ℓ ≠ f)
    (hf_val : ∀ y : { y : ↥V.toScheme // IsClosed ({y} : Set ↥V.toScheme) },
      let Ry := ↑(V.toScheme.presheaf.stalk y.1)
      ∃ (u_y : Units Ry) (g_y : Units ↑V.toScheme.functionField),
        (f : ↑V.toScheme.functionField) =
          algebraMap Ry ↑V.toScheme.functionField (u_y : Ry) *
            (g_y : ↑V.toScheme.functionField) ^ ℓ)
    (hs_f :
      let V₀ := V.toScheme
      let η_V := V₀.fromSpecStalk (genericPoint ↥V₀)
      let π_gen :=
        ((CategoryTheory.Over.pullback η_V).obj
          ((AlgebraicGeometry.Scheme.Etale.forget V₀).obj (weilEtaleIdTerminal.{u} V₀))).hom
      Additive.ofMul (Units.map
        ((AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk (genericPoint ↥V₀))).inv ≫
          π_gen.appTop).hom.toMonoidHom f) = s_f) :
    ∃ (C'_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (_ : AlgebraicGeometry.IsIntegral C'_bar.left)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension 1 C'_bar.hom)
      (bar_p : C'_bar ⟶ C_bar)
      (_ : AlgebraicGeometry.IsFinite bar_p.left)
      (_ : AlgebraicGeometry.Surjective bar_p.left),
      IsProjectiveOverField k C'_bar ∧
      (∀ x : ↥C_bar.left,
        ∃ (U : C_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U) (_ : x ∈ U)
          (M_U : Type u) (_ : AddCommGroup M_U)
          (_ : Module ↑(C_bar.left.presheaf.obj (Opposite.op U)) M_U)
          (_ : Module.Basis (Fin ℓ) ↑(C_bar.left.presheaf.obj (Opposite.op U)) M_U)
          (e_U : M_U ≃+ ↑(C'_bar.left.presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map bar_p.left.base).obj U)))),
          ∀ (r : ↑(C_bar.left.presheaf.obj (Opposite.op U))) (m : M_U),
            e_U (r • m) = (bar_p.left.app U).hom r * e_U m) ∧
      (let V'_open : C'_bar.left.Opens := (TopologicalSpace.Opens.map bar_p.left.base).obj V
       let p : V'_open.toScheme ⟶ V.toScheme := bar_p.left ∣_ V
       ∃ (σ_V' : V'_open.toScheme ⟶ V'_open.toScheme)
         (hp_et : AlgebraicGeometry.Etale p),
         AlgebraicGeometry.Surjective p ∧
         σ_V' ≫ p = p ∧
         (∀ x : ↥V.toScheme,
           ∃ (W : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W)
             (w : W ⟶ V.toScheme) (_ : AlgebraicGeometry.Etale w)
             (w₀ : ↥W) (_ : w.base w₀ = x)
             (s_sh : ZMod ℓ → (W ⟶ CategoryTheory.Limits.pullback p w)),
             (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (s_sh i)) ∧
             (∀ i : ZMod ℓ,
               s_sh i ≫ CategoryTheory.Limits.pullback.snd p w =
                 CategoryTheory.CategoryStruct.id W) ∧
             (∀ i : ZMod ℓ,
               s_sh i ≫ CategoryTheory.Limits.pullback.fst p w ≫ σ_V' =
                 s_sh (i + 1) ≫ CategoryTheory.Limits.pullback.fst p w) ∧
             (_root_.Pairwise fun i j : ZMod ℓ =>
               Disjoint (Set.range (s_sh i).base) (Set.range (s_sh j).base)) ∧
             (⋃ i : ZMod ℓ, Set.range (s_sh i).base) = Set.univ) ∧
         (let U_p : V.toScheme.Etale :=
            CategoryTheory.MorphismProperty.Over.mk ⊤ p hp_et
          let j_p : U_p ⟶ weilEtaleIdTerminal.{u} V.toScheme :=
            CategoryTheory.MorphismProperty.Over.homMk p
              (CategoryTheory.Category.comp_id p) trivial
          ∃ w_K : ↥((weilEtaleKPresheaf V.toScheme).obj (Opposite.op U_p)),
            ℓ • w_K = ((weilEtaleKPresheaf V.toScheme).map j_p.op).hom s_f)) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have : NeZero (ℓ : k) := ⟨hℓ⟩
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let Z : AlgebraicGeometry.Scheme.{u} := C_bar.left
  let V₀ : AlgebraicGeometry.Scheme.{u} := V.toScheme
  let F : Type u := ↑V₀.functionField
  have : IrreducibleSpace ↥Z := AlgebraicGeometry.irreducibleSpace_of_isIntegral Z
  have : IrreducibleSpace ↥V₀ := AlgebraicGeometry.irreducibleSpace_of_isIntegral V₀

  
  haveI hPropC : AlgebraicGeometry.IsProper C_bar.hom := by
    rcases hProjC with ⟨N, ι, hClosed_ι⟩
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let α₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
    have hα₀_bij : Function.Bijective α₀ := by
      constructor
      · intro c₁ c₂ hc
        exact MvPolynomial.C_injective (Fin (N + 1)) k (congrArg Subtype.val hc)
      · rintro ⟨p, hp⟩
        have hp' : p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := hp
        rw [MvPolynomial.homogeneousSubmodule_zero] at hp'
        obtain ⟨c, rfl⟩ := Submodule.mem_one.mp hp'
        exact ⟨c, Subtype.ext rfl⟩
    let e₀ : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective α₀ hα₀_bij
    have : CategoryTheory.IsIso (CommRingCat.ofHom α₀) :=
      ⟨⟨CommRingCat.ofHom e₀.symm.toRingHom,
        CommRingCat.hom_ext (RingHom.ext e₀.symm_apply_apply),
        CommRingCat.hom_ext (RingHom.ext e₀.apply_symm_apply)⟩⟩
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)) :=
      inferInstance
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (N + 1)) k)
        fun _ => rfl
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
    have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion ι.left := hClosed_ι
    rw [← CategoryTheory.Over.w ι]
    infer_instance
  have hSepC : Z.IsSeparated := by
    have hSepSpec : S_k.IsSeparated := inferInstance
    have : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S_k) :=
      hSepSpec.isSeparated_terminal_from
    have hTermC : C_bar.hom ≫ CategoryTheory.Limits.terminal.from S_k =
        CategoryTheory.Limits.terminal.from Z :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    refine AlgebraicGeometry.Scheme.IsSeparated.mk ?_
    rw [← hTermC]
    infer_instance
  have : QuasiSeparatedSpace ↥Z := inferInstance

  
  have hdeg_cyc : (Polynomial.cyclotomic ℓ k).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic, Nat.totient_prime hPrime]
    have h2 : 2 ≤ ℓ := hPrime.two_le
    exact Nat.cast_ne_zero.mpr (by omega)
  obtain ⟨ζ, hζ_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ k) hdeg_cyc
  have hζ : IsPrimitiveRoot ζ ℓ :=
    (Polynomial.isRoot_cyclotomic_iff (R := k) (n := ℓ)).mp hζ_root
  have hζ_pow : ζ ^ ℓ = 1 := hζ.pow_eq_one

  
  have hEtQ : ∀ (R : Type u) [CommRing R] [Algebra k R] (u : Units R),
      let Q_u : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C u.val
      Algebra.Etale R (AdjoinRoot Q_u) ∧
      Module.Finite R (AdjoinRoot Q_u) ∧
      ∃ σ_R : AdjoinRoot Q_u →ₐ[R] AdjoinRoot Q_u,
        σ_R (AdjoinRoot.root Q_u) =
          algebraMap R (AdjoinRoot Q_u) (algebraMap k R ζ) * AdjoinRoot.root Q_u := by
    intro R _ _ u
    let Q_u : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C u.val
    have hMonic : Q_u.Monic := Polynomial.monic_X_pow_sub_C u.val hPrime.ne_zero
    have hFin : Module.Finite R (AdjoinRoot Q_u) := (AdjoinRoot.powerBasis' hMonic).finite
    let c_ℓ : R := algebraMap k R (ℓ : k)⁻¹
    have hc_ℓ : (ℓ : R) * c_ℓ = 1 := by
      have hcast : (ℓ : R) = algebraMap k R (ℓ : k) := (map_natCast (algebraMap k R) ℓ).symm
      rw [hcast]
      dsimp [c_ℓ]
      rw [← map_mul, mul_inv_cancel₀ hℓ, map_one]
    let u_inv : R := (u⁻¹).val
    have hu_mul : u.val * u_inv = 1 := Units.mul_inv u
    let p₁ : Polynomial R := Polynomial.C (c_ℓ * u_inv) * Polynomial.X
    let p₂ : Polynomial R := Polynomial.C (-u_inv)
    have hBezout : Q_u.derivative * p₁ + Q_u * p₂ = (1 : Polynomial R) ^ 1 := by
      have hderiv : Q_u.derivative = Polynomial.C (ℓ : R) * Polynomial.X ^ (ℓ - 1) := by
        dsimp [Q_u]
        rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero, Polynomial.C_eq_natCast]
      have hexp : (ℓ - 1) + 1 = ℓ := Nat.sub_add_cancel hPrime.pos
      have hX_pow : (Polynomial.X : Polynomial R) ^ (ℓ - 1) * Polynomial.X = Polynomial.X ^ ℓ := by
        rw [← pow_succ, hexp]
      rw [hderiv, pow_one]
      dsimp [Q_u, p₁, p₂]
      calc
        (Polynomial.C (ℓ : R) * Polynomial.X ^ (ℓ - 1)) *
            (Polynomial.C (c_ℓ * u_inv) * Polynomial.X) +
          (Polynomial.X ^ ℓ - Polynomial.C u.val) * Polynomial.C (-u_inv)
          = (Polynomial.C (ℓ : R) * Polynomial.C (c_ℓ * u_inv)) *
              (Polynomial.X ^ (ℓ - 1) * Polynomial.X) +
            Polynomial.C (-u_inv) * Polynomial.X ^ ℓ -
            Polynomial.C u.val * Polynomial.C (-u_inv) := by ring
        _ = Polynomial.C (((ℓ : R) * c_ℓ) * u_inv) * Polynomial.X ^ ℓ +
            Polynomial.C (-u_inv) * Polynomial.X ^ ℓ -
            Polynomial.C (-(u.val * u_inv)) := by
              rw [hX_pow, ← Polynomial.C_mul, ← mul_assoc ((ℓ : R)) c_ℓ u_inv,
                ← Polynomial.C_mul, mul_neg]
        _ = 1 := by
              rw [hc_ℓ, one_mul, hu_mul, map_neg, map_neg, map_one]
              ring
    let P : StandardEtalePair R := StandardEtalePair.mk Q_u hMonic 1 ⟨p₁, p₂, 1, hBezout⟩
    let x₀ : AdjoinRoot Q_u := AdjoinRoot.root Q_u
    have hx₀ : P.HasMap x₀ := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval x₀ Q_u = 0
        rw [Polynomial.aeval_def]
        exact AdjoinRoot.eval₂_root Q_u
      · change IsUnit (Polynomial.aeval x₀ (1 : Polynomial R))
        rw [map_one]
        exact isUnit_one
    let α : P.Ring →ₐ[R] AdjoinRoot Q_u := P.lift x₀ hx₀
    have hP_eval : Polynomial.eval₂ (Algebra.ofId R P.Ring).toRingHom P.X Q_u = 0 := by
      change Polynomial.eval₂ (algebraMap R P.Ring) P.X Q_u = 0
      rw [← Polynomial.aeval_def]
      exact P.hasMap_X.1
    let β : AdjoinRoot Q_u →ₐ[R] P.Ring :=
      AdjoinRoot.liftAlgHom Q_u (Algebra.ofId R P.Ring) P.X hP_eval
    have hβ_root : β (AdjoinRoot.root Q_u) = P.X :=
      AdjoinRoot.liftAlgHom_root Q_u (Algebra.ofId R P.Ring) P.X hP_eval
    have hαβ : α.comp β = AlgHom.id R (AdjoinRoot Q_u) := by
      apply AdjoinRoot.algHom_ext
      exact (congrArg α hβ_root).trans (P.lift_X x₀ hx₀)
    have hβα : β.comp α = AlgHom.id R P.Ring := by
      apply (P.homEquiv (S := P.Ring)).injective
      apply Subtype.ext
      rw [P.homEquiv_apply_coe, P.homEquiv_apply_coe, AlgHom.comp_apply, P.lift_X, AlgHom.id_apply]
      exact hβ_root
    let e_std : P.Ring ≃ₐ[R] AdjoinRoot Q_u :=
      AlgEquiv.ofAlgHom α β hαβ hβα
    have hPres : Nonempty (StandardEtalePresentation R (AdjoinRoot Q_u)) :=
      ⟨StandardEtalePresentation.mk P x₀ hx₀ e_std.bijective⟩
    have : Algebra.IsStandardEtale R (AdjoinRoot Q_u) := ⟨hPres⟩
    have hEt : Algebra.Etale R (AdjoinRoot Q_u) := inferInstance
    let ζ_Q : AdjoinRoot Q_u := algebraMap R (AdjoinRoot Q_u) (algebraMap k R ζ)
    have hσ_root :
        Polynomial.eval₂ (Algebra.ofId R (AdjoinRoot Q_u)).toRingHom (ζ_Q * x₀) Q_u = 0 := by
      change Polynomial.eval₂ (algebraMap R (AdjoinRoot Q_u)) (ζ_Q * x₀) Q_u = 0
      dsimp [Q_u]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, mul_pow]
      have hζQ_pow : ζ_Q ^ ℓ = 1 := by
        dsimp [ζ_Q]
        rw [← map_pow, ← map_pow, hζ_pow, map_one, map_one]
      have hx₀_pow : x₀ ^ ℓ = algebraMap R (AdjoinRoot Q_u) u.val := by
        have h0 := AdjoinRoot.eval₂_root Q_u
        dsimp [Q_u] at h0
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at h0
        exact sub_eq_zero.mp h0
      rw [hζQ_pow, one_mul, hx₀_pow]
      exact sub_self _
    let σ_R : AdjoinRoot Q_u →ₐ[R] AdjoinRoot Q_u :=
      AdjoinRoot.liftAlgHom Q_u (Algebra.ofId R (AdjoinRoot Q_u)) (ζ_Q * x₀) hσ_root
    exact ⟨hEt, hFin, σ_R, AdjoinRoot.liftAlgHom_root Q_u _ _ _⟩

  
  have hCRT : ∀ (R : Type u) [CommRing R] [Algebra k R] (v : Units R),
      let Q_v : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C (v ^ ℓ).val
      ∃ Φ : AdjoinRoot Q_v ≃ₐ[R] (ZMod ℓ → R),
        ∀ (σ_R : AdjoinRoot Q_v →ₐ[R] AdjoinRoot Q_v),
          σ_R (AdjoinRoot.root Q_v) =
            algebraMap R (AdjoinRoot Q_v) (algebraMap k R ζ) * AdjoinRoot.root Q_v →
          ∀ (z : AdjoinRoot Q_v) (i : ZMod ℓ), Φ (σ_R z) i = Φ z (i + 1) := by
    intro R _ _ v
    let Q_v : Polynomial R := (Polynomial.X : Polynomial R) ^ ℓ - Polynomial.C (v ^ ℓ).val
    let r : ZMod ℓ → R := fun i => algebraMap k R (ζ ^ i.val) * v.val
    let I : ZMod ℓ → Ideal (Polynomial R) := fun i =>
      Ideal.span {Polynomial.X - Polynomial.C (r i)}
    have hζ_inj : Function.Injective (fun i : ZMod ℓ => ζ ^ i.val) := by
      intro i j hij
      apply ZMod.val_injective
      exact hζ.pow_inj i.val_lt j.val_lt hij
    have hCoprime : _root_.Pairwise (fun i j : ZMod ℓ => IsCoprime (I i) (I j)) := by
      intro i j hij
      have hζ_diff : ζ ^ j.val - ζ ^ i.val ≠ 0 :=
        sub_ne_zero.mpr (fun h => hij (hζ_inj h.symm))
      let c_ij : R := algebraMap k R (ζ ^ j.val - ζ ^ i.val)⁻¹ * (v⁻¹).val
      have hc_mul : c_ij * (r j - r i) = 1 := by
        dsimp [c_ij, r]
        calc
          (algebraMap k R (ζ ^ j.val - ζ ^ i.val)⁻¹ * (v⁻¹).val) *
              (algebraMap k R (ζ ^ j.val) * v.val - algebraMap k R (ζ ^ i.val) * v.val)
            = (algebraMap k R (ζ ^ j.val - ζ ^ i.val)⁻¹ *
                algebraMap k R (ζ ^ j.val - ζ ^ i.val)) *
              ((v⁻¹).val * v.val) := by
                rw [map_sub]
                ring
          _ = 1 := by
                rw [← map_mul, inv_mul_cancel₀ hζ_diff, map_one, Units.inv_mul, one_mul]
      rw [Ideal.isCoprime_span_singleton_iff]
      refine ⟨Polynomial.C c_ij, -Polynomial.C c_ij, ?_⟩
      calc
        Polynomial.C c_ij * (Polynomial.X - Polynomial.C (r i)) +
            -Polynomial.C c_ij * (Polynomial.X - Polynomial.C (r j))
          = Polynomial.C c_ij * (Polynomial.C (r j) - Polynomial.C (r i)) := by ring
        _ = Polynomial.C (c_ij * (r j - r i)) := by
              rw [← Polynomial.C_sub, ← Polynomial.C_mul]
        _ = 1 := by rw [hc_mul, map_one]
    have hPoly_k : (Polynomial.X ^ ℓ - 1 : Polynomial k) =
        ∏ i : ZMod ℓ, (Polynomial.X - Polynomial.C (ζ ^ i.val)) := by
      let P₀ : Polynomial k := Polynomial.X ^ ℓ - 1
      let P₁ : Polynomial k := ∏ i : ZMod ℓ, (Polynomial.X - Polynomial.C (ζ ^ i.val))
      have hP₀_monic : P₀.Monic := by
        have h1 : P₀ = Polynomial.X ^ ℓ - Polynomial.C (1 : k) := by simp [P₀]
        rw [h1]
        exact Polynomial.monic_X_pow_sub_C 1 hPrime.ne_zero
      have hP₁_monic : P₁.Monic :=
        Polynomial.monic_prod_of_monic Finset.univ _ (fun i _ => Polynomial.monic_X_sub_C _)
      have hP₀_deg : P₀.natDegree = ℓ := by
        have h1 : P₀ = Polynomial.X ^ ℓ - Polynomial.C (1 : k) := by simp [P₀]
        rw [h1]
        exact Polynomial.natDegree_X_pow_sub_C
      have hP₁_deg : P₁.natDegree = ℓ := by
        dsimp [P₁]
        rw [Polynomial.natDegree_prod_of_monic Finset.univ _ (fun i _ => Polynomial.monic_X_sub_C _)]
        simp only [Polynomial.natDegree_X_sub_C, Finset.sum_const, Finset.card_univ, ZMod.card,
          smul_eq_mul, mul_one]
      by_contra hne
      have hdiff_ne : P₀ - P₁ ≠ 0 := sub_ne_zero.mpr hne
      have hdeg_lt : (P₀ - P₁).degree < (ℓ : WithBot ℕ) := by
        have h1 : P₀.degree = (ℓ : WithBot ℕ) := by
          rw [Polynomial.degree_eq_natDegree hP₀_monic.ne_zero, hP₀_deg]
        have h2 : P₁.degree = (ℓ : WithBot ℕ) := by
          rw [Polynomial.degree_eq_natDegree hP₁_monic.ne_zero, hP₁_deg]
        have hlead : P₀.leadingCoeff = P₁.leadingCoeff := by
          rw [hP₀_monic.leadingCoeff, hP₁_monic.leadingCoeff]
        rw [← h1]
        exact Polynomial.degree_sub_lt_left (h1.trans h2.symm) hP₀_monic.ne_zero hlead
      have hnat_lt : (P₀ - P₁).natDegree < ℓ := by
        have h := Polynomial.degree_eq_natDegree hdiff_ne
        rw [h] at hdeg_lt
        exact WithBot.coe_lt_coe.mp hdeg_lt
      let S_roots : Finset k := Finset.univ.image (fun i : ZMod ℓ => ζ ^ i.val)
      have hcard_S : S_roots.card = ℓ := by
        dsimp [S_roots]
        rw [Finset.card_image_of_injective _ hζ_inj, Finset.card_univ, ZMod.card]
      have heval_zero : ∀ x ∈ S_roots, (P₀ - P₁).eval x = 0 := by
        intro x hx
        obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
        rw [Polynomial.eval_sub]
        have he0 : P₀.eval (ζ ^ i.val) = 0 := by
          dsimp [P₀]
          rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_one,
            ← pow_mul, mul_comm i.val ℓ, pow_mul, hζ_pow, one_pow, sub_self]
        have he1 : P₁.eval (ζ ^ i.val) = 0 := by
          dsimp [P₁]
          rw [Polynomial.eval_prod]
          refine Finset.prod_eq_zero (Finset.mem_univ i) ?_
          simp
        rw [he0, he1, sub_self]
      exact hdiff_ne (Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero'
        (P₀ - P₁) S_roots heval_zero (hcard_S.symm ▸ hnat_lt))
    have hQv_prod : Q_v = ∏ i : ZMod ℓ, (Polynomial.X - Polynomial.C (r i)) := by
      have hmap_R := congrArg (Polynomial.map (algebraMap k R)) hPoly_k
      rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_one,
        Polynomial.map_prod] at hmap_R
      let subst_hom : Polynomial R →+* Polynomial R :=
        Polynomial.eval₂RingHom Polynomial.C (Polynomial.C (v⁻¹).val * Polynomial.X)
      have hsubst := congrArg subst_hom hmap_R
      rw [map_sub, map_pow, map_one, map_prod] at hsubst
      have h_X : subst_hom Polynomial.X = Polynomial.C (v⁻¹).val * Polynomial.X :=
        Polynomial.eval₂_X Polynomial.C _
      rw [h_X] at hsubst
      have hmul := congrArg (fun p => Polynomial.C (v ^ ℓ).val * p) hsubst
      have hLHS : Polynomial.C (v ^ ℓ).val *
          ((Polynomial.C (v⁻¹).val * Polynomial.X) ^ ℓ - 1) = Q_v := by
        have hv_pow : (v ^ ℓ).val * ((v⁻¹).val ^ ℓ) = 1 := by
          rw [Units.val_pow_eq_pow_val, ← mul_pow, Units.mul_inv, one_pow]
        rw [mul_pow, ← Polynomial.C_pow, mul_sub, mul_one, ← mul_assoc, ← Polynomial.C_mul,
          hv_pow, map_one, one_mul]
      have hcard_prod : (∏ _i : ZMod ℓ, Polynomial.C v.val) = Polynomial.C (v ^ ℓ).val := by
        rw [Finset.prod_const, Finset.card_univ, ZMod.card, ← Polynomial.C_pow,
          Units.val_pow_eq_pow_val]
      have hRHS : Polynomial.C (v ^ ℓ).val *
          (∏ i : ZMod ℓ, subst_hom (Polynomial.map (algebraMap k R)
            (Polynomial.X - Polynomial.C (ζ ^ i.val)))) =
          ∏ i : ZMod ℓ, (Polynomial.X - Polynomial.C (r i)) := by
        rw [← hcard_prod, ← Finset.prod_mul_distrib]
        refine Finset.prod_congr rfl (fun i _ => ?_)
        rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, map_sub, h_X]
        have hC : subst_hom (Polynomial.C (algebraMap k R (ζ ^ i.val))) =
            Polynomial.C (algebraMap k R (ζ ^ i.val)) :=
          Polynomial.eval₂_C Polynomial.C _
        rw [hC, mul_sub, ← mul_assoc, ← Polynomial.C_mul, Units.mul_inv, map_one, one_mul,
          ← Polynomial.C_mul]
        dsimp [r]
        rw [mul_comm v.val]
      exact hLHS.symm.trans (hmul.trans hRHS)
    have hSpan_prod : ∀ (s : Finset (ZMod ℓ)),
        Ideal.span {∏ i ∈ s, (Polynomial.X - Polynomial.C (r i))} = ∏ i ∈ s, I i := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · simp
      · intro a s ha ih
        rw [Finset.prod_insert ha, Finset.prod_insert ha,
          ← Ideal.span_singleton_mul_span_singleton, ih]
    have hProd_eq_inf : ∀ (s : Finset (ZMod ℓ)),
        ∏ i ∈ s, I i = ⨅ i ∈ s, I i := by
      intro s
      refine Finset.induction_on s ?_ ?_
      · simp
      · intro a s ha ih
        rw [Finset.prod_insert ha, Finset.iInf_insert, ← ih]
        refine Ideal.mul_eq_inf_of_isCoprime ?_
        exact IsCoprime.prod_right (fun b hb => hCoprime (fun hab => ha (hab ▸ hb)))
    have hIdeal_eq : Ideal.span {Q_v} = ⨅ i : ZMod ℓ, I i := by
      rw [hQv_prod, hSpan_prod Finset.univ, hProd_eq_inf Finset.univ]
      simp
    let e₁_ring : AdjoinRoot Q_v ≃+* (Polynomial R ⧸ ⨅ i : ZMod ℓ, I i) :=
      Ideal.quotEquivOfEq hIdeal_eq
    let e₂_ring : (Polynomial R ⧸ ⨅ i : ZMod ℓ, I i) ≃+*
        (∀ i : ZMod ℓ, Polynomial R ⧸ I i) :=
      Ideal.quotientInfRingEquivPiQuotient I hCoprime
    let e₃_alg : (∀ i : ZMod ℓ, Polynomial R ⧸ I i) ≃ₐ[R] (ZMod ℓ → R) :=
      AlgEquiv.piCongrRight (fun i => Polynomial.quotientSpanXSubCAlgEquiv (r i))
    let Φ_ring : AdjoinRoot Q_v ≃+* (ZMod ℓ → R) :=
      (e₁_ring.trans e₂_ring).trans e₃_alg.toRingEquiv
    have hΦ_comm : ∀ c : R, Φ_ring (algebraMap R (AdjoinRoot Q_v) c) =
        algebraMap R (ZMod ℓ → R) c := by
      intro c
      funext i
      change (Polynomial.quotientSpanXSubCAlgEquiv (r i))
        (Ideal.Quotient.mk (I i) (Polynomial.C c)) = c
      exact (Polynomial.quotientSpanXSubCAlgEquiv (r i)).commutes c
    let Φ : AdjoinRoot Q_v ≃ₐ[R] (ZMod ℓ → R) :=
      AlgEquiv.ofRingEquiv (f := Φ_ring) hΦ_comm
    have hΦ_root : ∀ i : ZMod ℓ, Φ (AdjoinRoot.root Q_v) i = r i := by
      intro i
      change (Polynomial.quotientSpanXSubCAlgEquiv (r i))
        (Ideal.Quotient.mk (I i) Polynomial.X) = r i
      exact (Polynomial.quotientSpanXSubCAlgEquiv_mk (r i) Polynomial.X).trans Polynomial.eval_X
    have hζ_shift : ∀ i : ZMod ℓ, ζ ^ (i + 1).val = ζ * ζ ^ i.val := by
      intro i
      have h1_lt : 1 < ℓ := hPrime.one_lt
      have hval_one : (1 : ZMod ℓ).val = 1 := ZMod.val_one_eq_one_mod ℓ ▸ Nat.mod_eq_of_lt h1_lt
      rw [ZMod.val_add, hval_one]
      by_cases hlt : i.val + 1 < ℓ
      · rw [Nat.mod_eq_of_lt hlt, pow_succ']
      · have heq : i.val + 1 = ℓ := by
          have hi_lt : i.val < ℓ := i.val_lt
          omega
        rw [heq, Nat.mod_self, pow_zero, ← hζ_pow]
        exact (congrArg (ζ ^ ·) heq.symm).trans (pow_succ' ζ i.val)
    refine ⟨Φ, ?_⟩
    intro σ_R hσ_root z i
    let L_hom : AdjoinRoot Q_v →ₐ[R] R :=
      (Pi.evalAlgHom R (fun _ : ZMod ℓ => R) i).comp (Φ.toAlgHom.comp σ_R)
    let R_hom : AdjoinRoot Q_v →ₐ[R] R :=
      (Pi.evalAlgHom R (fun _ : ZMod ℓ => R) (i + 1)).comp Φ.toAlgHom
    have hLR : L_hom = R_hom := by
      apply AdjoinRoot.algHom_ext
      change Φ (σ_R (AdjoinRoot.root Q_v)) i = Φ (AdjoinRoot.root Q_v) (i + 1)
      rw [hσ_root, map_mul, Φ.commutes (algebraMap k R ζ), Pi.mul_apply, Pi.algebraMap_apply,
        Algebra.algebraMap_self, RingHom.id_apply, hΦ_root i, hΦ_root (i + 1)]
      dsimp [r]
      rw [← mul_assoc, ← map_mul, ← hζ_shift i]
    exact AlgHom.congr_fun hLR z

  
  have hPiEval : ∀ (R : Type u) [CommRing R],
      let S : Type u := ZMod ℓ → R
      let e_sh : ZMod ℓ →
          (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of S)) :=
        fun i => AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod ℓ => R) i))
      (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (e_sh i)) ∧
      (_root_.Pairwise fun i j : ZMod ℓ =>
        Disjoint (Set.range (e_sh i).base) (Set.range (e_sh j).base)) ∧
      (⋃ i : ZMod ℓ, Set.range (e_sh i).base) = Set.univ := by
    intro R _
    let S : Type u := ZMod ℓ → R
    let e_sh : ZMod ℓ →
        (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of S)) :=
      fun i => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ZMod ℓ => R) i))
    let ev_spec : ZMod ℓ → PrimeSpectrum R → PrimeSpectrum S :=
      fun i => PrimeSpectrum.comap (Pi.evalRingHom (fun _ : ZMod ℓ => R) i)
    have he_base : ∀ (i : ZMod ℓ) (q : ↥(AlgebraicGeometry.Spec (CommRingCat.of R))),
        (e_sh i).base q = ev_spec i q := fun _ _ => rfl
    refine ⟨?_, ?_, ?_⟩
    · intro i
      dsimp [e_sh, S]
      infer_instance
    · intro i j hij
      rw [Set.disjoint_left]
      rintro P ⟨q₁, rfl⟩ ⟨q₂, hq₂⟩
      rw [he_base i q₁, he_base j q₂] at hq₂
      let δ_i : S := Pi.single i (1 : R)
      have hnot : δ_i ∉ (ev_spec i q₁).asIdeal := by
        change δ_i i ∉ (q₁ : PrimeSpectrum R).asIdeal
        dsimp [δ_i]
        rw [Pi.single_eq_same]
        exact (q₁ : PrimeSpectrum R).isPrime.one_notMem
      have hyes : δ_i ∈ (ev_spec j q₂).asIdeal := by
        change δ_i j ∈ (q₂ : PrimeSpectrum R).asIdeal
        dsimp [δ_i]
        rw [Pi.single_eq_of_ne hij.symm]
        exact (q₂ : PrimeSpectrum R).asIdeal.zero_mem
      rw [← hq₂] at hnot
      exact hnot hyes
    · apply Set.eq_univ_of_forall
      intro P
      let P_spec : PrimeSpectrum S := P
      let δ : ZMod ℓ → S := fun i => Pi.single i (1 : R)
      have hsum_one : ∑ i : ZMod ℓ, δ i = (1 : S) := by
        funext k
        rw [Finset.sum_apply]
        dsimp [δ]
        simp only [Pi.single_apply, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
        rfl
