        exact congrArg
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ·)
          (congrArg ((V.ι ≫ C_bar.hom).appTop ≫ ·)
            (V₀.presheaf.germ_res (CategoryTheory.homOfLE (le_top : U_V ≤ ⊤))
              (genericPoint ↥V₀) hgen_in_UV))
      exact congrArg CommRingCat.Hom.hom hcat
    have : IsScalarTower k A_V F := IsScalarTower.of_algebraMap_eq' hTower_k_AV_F.symm

    let ũ_V : Units A_V := Units.map (V.ι.app U_x).hom.toMonoidHom ũ_x
    have hf_UV : f.val = algebraMap A_V F ũ_V.val * g_x.val ^ ℓ := by
      rw [hf_Ux]
      congr 1
      exact hφ_ZV U_x hUx_V hNe_Ux hNe_UV ũ_x.val

    let Q_ũV : Polynomial A_V := (Polynomial.X : Polynomial A_V) ^ ℓ - Polynomial.C ũ_V.val
    let C_UV : Type u := AdjoinRoot Q_ũV
    have hEt_CUV : Algebra.Etale A_V C_UV := (hEtQ A_V ũ_V).1
    obtain ⟨⟨ψ_CUV, hInj_ψCUV⟩, hIso_CUV⟩ := hUnramIso A_V ũ_V g_x hf_UV
    have : IsDomain C_UV := Function.Injective.isDomain ψ_CUV hInj_ψCUV
    have : IrreducibleSpace (PrimeSpectrum C_UV) := PrimeSpectrum.irreducibleSpace
    have : ConnectedSpace (PrimeSpectrum C_UV) :=
      IrreducibleSpace.connectedSpace (PrimeSpectrum C_UV)
    have hIC_CUV : IsIntegrallyClosed C_UV :=
      (weil_connected_etale_dedekind_domain_and_separable_frac A_V C_UV).2.1

    obtain ⟨τ_Ux, hInj_τUx, hτUx_comp, hτUx_int, hτUx_V⟩ := hTauChart U_x hAff_Ux hNe_Ux
    obtain ⟨e_UxV, hσ_U, he_app, he_σ⟩ := hτUx_V hUx_V
    let B_V : Type u := ↑(V'_open.toScheme.presheaf.obj (Opposite.op U'_V))
    let τ_V : B_V →+* L := τ_Ux.comp e_UxV.symm.toRingHom
    have hInj_τV : Function.Injective τ_V := hInj_τUx.comp e_UxV.symm.injective
    have hα_Ux_eq : ψ_K.comp (Z.germToFunctionField U_x).hom =
        ((algebraMap F L).comp (algebraMap A_V F)).comp e_UV_ring.toRingHom := by
      ext a
      change algebraMap F L (φ_ZV ((Z.germToFunctionField U_x).hom a)) =
        algebraMap F L ((V₀.germToFunctionField U_V).hom ((V.ι.app U_x).hom a))
      rw [hφ_ZV U_x hUx_V hNe_Ux hNe_UV a]
    have hτV_comp : τ_V.comp (p.app U_V).hom = (algebraMap F L).comp (algebraMap A_V F) := by
      ext a_V
      let a : A_Ux := e_UV_ring.symm a_V
      have ha : (V.ι.app U_x).hom a = a_V := e_UV_ring.apply_symm_apply a_V
      have happ_eq : e_UxV ((bar_p₀.app U_x).hom a) = (p.app U_V).hom a_V :=
        (he_app a).trans (congrArg (p.app U_V).hom ha)
      have hsymm : e_UxV.symm ((p.app U_V).hom a_V) = (bar_p₀.app U_x).hom a :=
        (congrArg e_UxV.symm happ_eq.symm).trans (e_UxV.symm_apply_apply _)
      have h0 : τ_V ((p.app U_V).hom a_V) = τ_Ux ((bar_p₀.app U_x).hom a) :=
        congrArg τ_Ux hsymm
      have h1 : τ_Ux ((bar_p₀.app U_x).hom a) = (ψ_K.comp (Z.germToFunctionField U_x).hom) a :=
        congrArg (fun φ : A_Ux →+* L => φ a) hτUx_comp
      have h2 : (ψ_K.comp (Z.germToFunctionField U_x).hom) a =
          ((algebraMap F L).comp (algebraMap A_V F)) a_V :=
        (congrArg (fun φ : A_Ux →+* L => φ a) hα_Ux_eq).trans
          (congrArg ((algebraMap F L).comp (algebraMap A_V F)) ha)
      exact (h0.trans h1).trans h2
    have hτV_int : ∀ z : L,
        ((algebraMap F L).comp (algebraMap A_V F)).IsIntegralElem z ↔
          ∃ b : B_V, τ_V b = z := by
      intro z
      have hInt_eq : ((algebraMap F L).comp (algebraMap A_V F)).IsIntegralElem z ↔
          (ψ_K.comp (Z.germToFunctionField U_x).hom).IsIntegralElem z := by
        rw [hα_Ux_eq]
        constructor
        · rintro ⟨P, hPm, hPe⟩
          refine ⟨P.map e_UV_ring.symm.toRingHom, hPm.map _, ?_⟩
          rw [Polynomial.eval₂_map]
          have hhom : (((algebraMap F L).comp (algebraMap A_V F)).comp e_UV_ring.toRingHom).comp
              e_UV_ring.symm.toRingHom =
              (algebraMap F L).comp (algebraMap A_V F) := by
            ext c
            simp
          rwa [hhom]
        · rintro ⟨P, hPm, hPe⟩
          refine ⟨P.map e_UV_ring.toRingHom, hPm.map _, ?_⟩
          rwa [Polynomial.eval₂_map]
      rw [hInt_eq, hτUx_int z]
      constructor
      · rintro ⟨b₀, rfl⟩
        exact ⟨e_UxV b₀, congrArg τ_Ux (e_UxV.symm_apply_apply b₀)⟩
      · rintro ⟨b, rfl⟩
        exact ⟨e_UxV.symm b, rfl⟩
    have hτV_σ : ∀ b : B_V, τ_V ((σ_V'.appLE U'_V U'_V hσ_U).hom b) = σ_L (τ_V b) := by
      intro b
      have h1 : (σ_V'.appLE U'_V U'_V hσ_U).hom (e_UxV (e_UxV.symm b)) =
          (σ_V'.appLE U'_V U'_V hσ_U).hom b :=
        congrArg (σ_V'.appLE U'_V U'_V hσ_U).hom (e_UxV.apply_symm_apply b)
      have h2 : τ_V ((σ_V'.appLE U'_V U'_V hσ_U).hom (e_UxV (e_UxV.symm b))) =
          σ_L (τ_V b) :=
        he_σ (e_UxV.symm b)
      exact (congrArg τ_V h1.symm).trans h2
    obtain ⟨Ξ, hΞ_A, hΞ_σ⟩ :=
      hIso_CUV hIC_CUV B_V (p.app U_V).hom τ_V (σ_V'.appLE U'_V U'_V hσ_U).hom
        hInj_τV hτV_comp hτV_int hτV_σ
    exact ⟨U_V, hAff_UV, hx_UV, hAff_U'V, φ_k_AV_cat.hom, ũ_V, Ξ, hσ_U, hΞ_A, hΞ_σ⟩

  obtain ⟨hp_et, hp_surj, hSheets_V⟩ :=
    weil_kummer_open_etale_and_pullback_cyclic_sheets k ℓ ζ hEtQ hCRT hPiEval
      V₀ V'_open.toScheme p σ_V' hσ_p hLocalKummer

  
  have hw_K_exists :
      let U_p : V₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ p hp_et
      let j_p : U_p ⟶ weilEtaleIdTerminal.{u} V₀ :=
        CategoryTheory.MorphismProperty.Over.homMk p (CategoryTheory.Category.comp_id p) trivial
      ∃ w_K : ↥((weilEtaleKPresheaf V₀).obj (Opposite.op U_p)),
        ℓ • w_K = ((weilEtaleKPresheaf V₀).map j_p.op).hom s_f := by
    let U_p : V₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ p hp_et
    let j_p : U_p ⟶ weilEtaleIdTerminal.{u} V₀ :=
      CategoryTheory.MorphismProperty.Over.homMk p (CategoryTheory.Category.comp_id p) trivial
    let x₀ : ↥V₀ := ⟨v₀_pt, hv₀_pt⟩
    obtain ⟨U₀, hAff_U₀, hU₀_V, hx₀_U₀, hNe_U₀, _, _, _⟩ := hUnitV x₀
    haveI : Nonempty ↥(U₀ : AlgebraicGeometry.Scheme.{u}) := hNe_U₀
    let U₀_V : V₀.Opens := (TopologicalSpace.Opens.map V.ι.base).obj U₀
    haveI hNe_U₀V : Nonempty ↥(U₀_V : AlgebraicGeometry.Scheme.{u}) := ⟨⟨x₀, hx₀_U₀⟩⟩
    let A_U₀ : Type u := ↑(Z.presheaf.obj (Opposite.op U₀))
    let _ : IsDedekindDomain A_U₀ := hDedZ U₀ hAff_U₀ hNe_U₀
    let _ : Algebra A_U₀ K_Z := (Z.germToFunctionField U₀).hom.toAlgebra
    have : IsFractionRing A_U₀ K_Z :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z U₀ hAff_U₀
    obtain ⟨⟨n₀, ⟨d₀, hd₀_nzd⟩⟩, hfrac_Z⟩ :=
      IsLocalization.surj (nonZeroDivisors A_U₀) (φ_ZV.symm f.val)
    have hd₀_ne : d₀ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hd₀_nzd
    have hgerm_d₀_ne : (Z.germToFunctionField U₀).hom d₀ ≠ 0 := fun h0 =>
      hd₀_ne (AlgebraicGeometry.Scheme.germToFunctionField_injective Z U₀
        (h0.trans (map_zero _).symm))
    let d_sec : ↑(V₀.presheaf.obj (Opposite.op U₀_V)) := (V.ι.app U₀).hom d₀
    let n_sec : ↑(V₀.presheaf.obj (Opposite.op U₀_V)) := (V.ι.app U₀).hom n₀
    have hd_sec_ne : (V₀.germToFunctionField U₀_V).hom d_sec ≠ 0 := by
      rw [← hφ_ZV U₀ hU₀_V hNe_U₀ hNe_U₀V d₀]
      exact fun h0 => hgerm_d₀_ne (φ_ZV.injective (h0.trans (map_zero φ_ZV).symm))
    have hf_frac : f.val * (V₀.germToFunctionField U₀_V).hom d_sec =
        (V₀.germToFunctionField U₀_V).hom n_sec := by
      rw [← hφ_ZV U₀ hU₀_V hNe_U₀ hNe_U₀V d₀, ← hφ_ZV U₀ hU₀_V hNe_U₀ hNe_U₀V n₀]
      have h := congrArg φ_ZV hfrac_Z
      rw [map_mul, φ_ZV.apply_symm_apply] at h
      exact h
    obtain ⟨τ_U₀, hInj_τ0, hτ0_comp, hτ0_int, hτ0_V⟩ := hTauChart U₀ hAff_U₀ hNe_U₀
    obtain ⟨e_U₀V, _, he0_app, _⟩ := hτ0_V hU₀_V
    let α₀ : A_U₀ →+* L := ψ_K.comp (Z.germToFunctionField U₀).hom
    let y₀ : L := α₀ d₀ * AdjoinRoot.root P_f
    have hexp : (ℓ - 1) + 1 = ℓ := Nat.sub_add_cancel hPrime.pos
    have hy₀_pow : y₀ ^ ℓ = α₀ (d₀ ^ (ℓ - 1) * n₀) := by
      dsimp [y₀]
      have hα_frac : algebraMap F L f.val * α₀ d₀ = α₀ n₀ := by
        dsimp [α₀, ψ_K]
        rw [← map_mul (algebraMap F L)]
        congr 1
        have h := congrArg φ_ZV hfrac_Z
        rwa [map_mul, φ_ZV.apply_symm_apply] at h
      calc
        (α₀ d₀ * AdjoinRoot.root P_f) ^ ℓ
          = α₀ d₀ ^ ((ℓ - 1) + 1) * (AdjoinRoot.root P_f) ^ ℓ := by
              rw [mul_pow, hexp]
        _ = α₀ d₀ ^ (ℓ - 1) * (algebraMap F L f.val * α₀ d₀) := by
              rw [pow_succ, hRoot_pow]
              ring
        _ = α₀ (d₀ ^ (ℓ - 1) * n₀) := by
              rw [hα_frac, map_mul, map_pow]
    have hy₀_int : α₀.IsIntegralElem y₀ := by
      refine ⟨(Polynomial.X : Polynomial A_U₀) ^ ℓ - Polynomial.C (d₀ ^ (ℓ - 1) * n₀),
        Polynomial.monic_X_pow_sub_C _ hPrime.ne_zero, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hy₀_pow, sub_self]
    obtain ⟨b0_norm, hb0_norm⟩ := (hτ0_int y₀).mp hy₀_int
    have hb0_norm_pow : b0_norm ^ ℓ = (bar_p₀.app U₀).hom (d₀ ^ (ℓ - 1) * n₀) := by
      apply hInj_τ0
      rw [map_pow, hb0_norm, hy₀_pow]
      exact (congrArg (fun φ : A_U₀ →+* L => φ (d₀ ^ (ℓ - 1) * n₀)) hτ0_comp).symm
    let U'₀_V : V'_open.toScheme.Opens := (TopologicalSpace.Opens.map p.base).obj U₀_V
    let b_V : ↑(V'_open.toScheme.presheaf.obj (Opposite.op U'₀_V)) := e_U₀V b0_norm
    have hb_V_pow : b_V ^ ℓ = (p.app U₀_V).hom (d_sec ^ (ℓ - 1) * n_sec) := by
      have h1 : b_V ^ ℓ = e_U₀V (b0_norm ^ ℓ) := (map_pow e_U₀V b0_norm ℓ).symm
      have h2 : e_U₀V (b0_norm ^ ℓ) =
          e_U₀V ((bar_p₀.app U₀).hom (d₀ ^ (ℓ - 1) * n₀)) :=
        congrArg e_U₀V hb0_norm_pow
      have h3 : e_U₀V ((bar_p₀.app U₀).hom (d₀ ^ (ℓ - 1) * n₀)) =
          (p.app U₀_V).hom ((V.ι.app U₀).hom (d₀ ^ (ℓ - 1) * n₀)) :=
        he0_app (d₀ ^ (ℓ - 1) * n₀)
      have h4 : (V.ι.app U₀).hom (d₀ ^ (ℓ - 1) * n₀) = d_sec ^ (ℓ - 1) * n_sec := by
        rw [map_mul, map_pow]
      exact ((h1.trans h2).trans h3).trans (congrArg (p.app U₀_V).hom h4)

    let η_V := V₀.fromSpecStalk (genericPoint ↥V₀)
    let P_gen := CategoryTheory.Limits.pullback p η_V
    let π_1 := CategoryTheory.Limits.pullback.fst p η_V
    let π_2 := CategoryTheory.Limits.pullback.snd p η_V
    let K_V_cat : CommRingCat.{u} := V₀.presheaf.stalk (genericPoint ↥V₀)
    let R_pb_cat : CommRingCat.{u} := P_gen.presheaf.obj (Opposite.op ⊤)
    let R_pb : Type u := ↑R_pb_cat
    have hgen_UV : genericPoint ↥V₀ ∈ U₀_V :=
      ((genericPoint_spec ↥V₀).mem_open_set_iff U₀_V.isOpen).mpr ⟨x₀, trivial, hx₀_U₀⟩
    have hη_gen : ∀ pt : ↥(AlgebraicGeometry.Spec K_V_cat), η_V.base pt = genericPoint ↥V₀ := by
      intro pt
      have hSub : Subsingleton ↥(AlgebraicGeometry.Spec K_V_cat) := by
        change Subsingleton (PrimeSpectrum F)
        infer_instance
      rw [hSub.elim pt (IsLocalRing.closedPoint F)]
      exact V₀.fromSpecStalk_closedPoint
    have he_η : (⊤ : (AlgebraicGeometry.Spec K_V_cat).Opens) ≤
        (TopologicalSpace.Opens.map η_V.base).obj U₀_V := by
      intro pt _
      change η_V.base pt ∈ U₀_V
      rw [hη_gen pt]
      exact hgen_UV
    have he_1 : (⊤ : P_gen.Opens) ≤ (TopologicalSpace.Opens.map π_1.base).obj U'₀_V := by
      intro z _
      change p.base (π_1.base z) ∈ U₀_V
      have hcond : p.base (π_1.base z) = η_V.base (π_2.base z) :=
        congrArg (fun g : P_gen ⟶ V₀ => g.base z)
          (CategoryTheory.Limits.pullback.condition (f := p) (g := η_V))
      rw [hcond, hη_gen (π_2.base z)]
      exact hgen_UV
    let β₁_cat : V'_open.toScheme.presheaf.obj (Opposite.op U'₀_V) ⟶ R_pb_cat :=
      π_1.appLE U'₀_V ⊤ he_1
    let β₁ : ↑(V'_open.toScheme.presheaf.obj (Opposite.op U'₀_V)) →+* R_pb := β₁_cat.hom
    let β₂_cat : K_V_cat ⟶ R_pb_cat :=
      (AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv ≫ π_2.appTop
    let β₂ : F →+* R_pb := β₂_cat.hom
    have happLE_congr : ∀ {f₁ f₂ : P_gen ⟶ V₀} (_h : f₁ = f₂)
        (e₁ : ⊤ ≤ (TopologicalSpace.Opens.map f₁.base).obj U₀_V)
        (e₂ : ⊤ ≤ (TopologicalSpace.Opens.map f₂.base).obj U₀_V),
        f₁.appLE U₀_V ⊤ e₁ = f₂.appLE U₀_V ⊤ e₂ := by
      rintro _ _ rfl _ _
      rfl
    have hβ_compat : ∀ s : ↑(V₀.presheaf.obj (Opposite.op U₀_V)),
        β₁ ((p.app U₀_V).hom s) = β₂ ((V₀.germToFunctionField U₀_V).hom s) := by
      intro s
      have h1 : p.app U₀_V ≫ β₁_cat = (π_1 ≫ p).appLE U₀_V ⊤ he_1 :=
        (AlgebraicGeometry.Scheme.Hom.comp_appLE π_1 p U₀_V ⊤ he_1).symm
      have he_2 : (⊤ : P_gen.Opens) ≤ (TopologicalSpace.Opens.map π_2.base).obj ⊤ :=
        fun _ _ => trivial
      have h2 : η_V.appLE U₀_V ⊤ he_η ≫ π_2.appLE ⊤ ⊤ he_2 =
          (π_2 ≫ η_V).appLE U₀_V ⊤ _ :=
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE π_2 η_V U₀_V ⊤ ⊤ he_η he_2
      have h3 : (π_1 ≫ p).appLE U₀_V ⊤ he_1 =
          η_V.appLE U₀_V ⊤ he_η ≫ π_2.appLE ⊤ ⊤ he_2 :=
        (happLE_congr (CategoryTheory.Limits.pullback.condition (f := p) (g := η_V)) he_1 _).trans
          h2.symm
      have h4 : η_V.appLE U₀_V ⊤ he_η =
          V₀.germToFunctionField U₀_V ≫ (AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv := by
        have happ : η_V.appLE U₀_V ⊤ he_η =
            η_V.app U₀_V ≫ (AlgebraicGeometry.Spec K_V_cat).presheaf.map
              (CategoryTheory.homOfLE he_η).op := by
          rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app η_V,
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        rw [happ]
        dsimp [η_V]
        rw [AlgebraicGeometry.Scheme.fromSpecStalk_app hgen_UV]
        change V₀.presheaf.germ U₀_V (genericPoint ↥V₀) hgen_UV ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv ≫
            ((AlgebraicGeometry.Spec K_V_cat).presheaf.map (CategoryTheory.homOfLE le_top).op ≫
              (AlgebraicGeometry.Spec K_V_cat).presheaf.map (CategoryTheory.homOfLE he_η).op) = _
        rw [← CategoryTheory.Functor.map_comp, ← op_comp]
        have hid : CategoryTheory.homOfLE he_η ≫ CategoryTheory.homOfLE le_top =
            𝟙 (⊤ : (AlgebraicGeometry.Spec K_V_cat).Opens) := Subsingleton.elim _ _
        rw [hid, op_id, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
      have h5 : π_2.appLE ⊤ ⊤ he_2 = π_2.appTop :=
        AlgebraicGeometry.Scheme.Hom.appLE_eq_app π_2
      have hcat : p.app U₀_V ≫ β₁_cat = V₀.germToFunctionField U₀_V ≫ β₂_cat := by
        rw [h1, h3, h4, h5, CategoryTheory.Category.assoc]
      exact congrArg (fun φ : V₀.presheaf.obj (Opposite.op U₀_V) ⟶ R_pb_cat => φ.hom s) hcat
    let d_K : F := (V₀.germToFunctionField U₀_V).hom d_sec
    let n_K : F := (V₀.germToFunctionField U₀_V).hom n_sec
    have hf_eq : f.val = n_K * d_K⁻¹ := by
      apply mul_right_cancel₀ hd_sec_ne
      rw [mul_assoc, inv_mul_cancel₀ hd_sec_ne, mul_one]
      exact hf_frac
    let t_pb : R_pb := β₁ b_V * β₂ (d_K⁻¹)
    have ht_pow : t_pb ^ ℓ = β₂ f.val := by
      dsimp [t_pb]
      rw [mul_pow, ← map_pow, ← map_pow, hb_V_pow, hβ_compat, map_mul, map_pow, ← map_mul]
      congr 1
      change d_K ^ (ℓ - 1) * n_K * (d_K⁻¹) ^ ℓ = f.val
      have hd_pow : d_K ^ (ℓ - 1) * (d_K⁻¹) ^ ℓ = d_K⁻¹ := by
        have hp1 : (d_K⁻¹) ^ ℓ = (d_K⁻¹) ^ (ℓ - 1) * d_K⁻¹ :=
          (congrArg (d_K⁻¹ ^ ·) hexp.symm).trans (pow_succ d_K⁻¹ (ℓ - 1))
        rw [hp1, ← mul_assoc, ← mul_pow, mul_inv_cancel₀ hd_sec_ne, one_pow, one_mul]
      calc
        d_K ^ (ℓ - 1) * n_K * (d_K⁻¹) ^ ℓ
          = n_K * (d_K ^ (ℓ - 1) * (d_K⁻¹) ^ ℓ) := by ring
        _ = n_K * d_K⁻¹ := by rw [hd_pow]
        _ = f.val := hf_eq.symm
    let t_inv : R_pb := t_pb ^ (ℓ - 1) * β₂ (f⁻¹).val
    have ht_mul : t_pb * t_inv = 1 := by
      dsimp [t_inv]
      rw [← mul_assoc, ← pow_succ', hexp, ht_pow, ← map_mul, Units.mul_inv, map_one]
    let u_pb : Units R_pb :=
      { val := t_pb
        inv := t_inv
        val_inv := ht_mul
        inv_val := by rw [mul_comm]; exact ht_mul }
    have hu_pb_pow : u_pb ^ ℓ = Units.map β₂.toMonoidHom f := by
      ext
      exact ht_pow

    let F_pb_cov :=
      AlgebraicGeometry.Scheme.Etale.forget V₀ ⋙ CategoryTheory.Over.pullback η_V
    have hOver_w : (F_pb_cov.map j_p).left ≫
        (F_pb_cov.obj (weilEtaleIdTerminal.{u} V₀)).hom =
        (F_pb_cov.obj U_p).hom :=
      CategoryTheory.Over.w (F_pb_cov.map j_p)
    have happTop_w :
        ((F_pb_cov.obj (weilEtaleIdTerminal.{u} V₀)).hom).appTop ≫
          ((F_pb_cov.map j_p).left).appTop = π_2.appTop := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hOver_w]
      rfl
    have hhom_eq : β₂_cat =
        ((AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv ≫
          ((F_pb_cov.obj (weilEtaleIdTerminal.{u} V₀)).hom).appTop) ≫
          ((F_pb_cov.map j_p).left).appTop :=
      (congrArg ((AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv ≫ ·) happTop_w.symm).trans
        (CategoryTheory.Category.assoc _ _ _).symm
    have hval_eq : u_pb.val ^ ℓ =
        (((F_pb_cov.map j_p).left).appTop).hom
          (((AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv ≫
            ((F_pb_cov.obj (weilEtaleIdTerminal.{u} V₀)).hom).appTop).hom f.val) :=
      ht_pow.trans (congrArg (fun φ : K_V_cat ⟶ R_pb_cat => φ.hom f.val) hhom_eq)
    have hunits_eq :
        (u_pb ^ ℓ : Units ↥((F_pb_cov.obj U_p).left.presheaf.obj (Opposite.op ⊤))) =
        Units.map (((F_pb_cov.map j_p).left).appTop).hom.toMonoidHom
          (Units.map ((AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv ≫
            ((F_pb_cov.obj (weilEtaleIdTerminal.{u} V₀)).hom).appTop).hom.toMonoidHom f) :=
      Units.ext hval_eq
    let w_K : ↥((weilEtaleKPresheaf V₀).obj (Opposite.op U_p)) := Additive.ofMul u_pb
    refine ⟨w_K, ?_⟩
    have hsmul : ℓ • w_K = Additive.ofMul (u_pb ^ ℓ :
        Units ↥((F_pb_cov.obj U_p).left.presheaf.obj (Opposite.op ⊤))) :=
      (ofMul_pow ℓ (u_pb : Units ↥((F_pb_cov.obj U_p).left.presheaf.obj (Opposite.op ⊤)))).symm
    have hmap_sf : ((weilEtaleKPresheaf V₀).map j_p.op).hom s_f =
        Additive.ofMul (Units.map (((F_pb_cov.map j_p).left).appTop).hom.toMonoidHom
          (Units.map ((AlgebraicGeometry.Scheme.ΓSpecIso K_V_cat).inv ≫
            ((F_pb_cov.obj (weilEtaleIdTerminal.{u} V₀)).hom).appTop).hom.toMonoidHom f)) :=
      congrArg ((weilEtaleKPresheaf V₀).map j_p.op).hom hs_f.symm
    exact (hsmul.trans (congrArg Additive.ofMul hunits_eq)).trans hmap_sf.symm

  exact ⟨C'_bar, hIntY, hSmC', bar_p, hFin_p0, hSurj_p0, hProjC', hFree_p,
    σ_V', hp_et, hp_surj, hσ_p, hSheets_V, hw_K_exists⟩

theorem weil_etale_cyclic_sheet_freeYoneda_telescoping_exact (X : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (V_et V'_et : X.Etale)
    [AlgebraicGeometry.IsOpenImmersion ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_et).hom]
    (p_et : Quiver.Hom V'_et V_et)
    (σ_et : Quiver.Hom V'_et V'_et)
    (hσ_p : CategoryTheory.CategoryStruct.comp σ_et p_et = p_et)
    (h0 : CategoryTheory.CategoryStruct.comp
      (weilCupPDLocalFreeMap X ℓ σ_et -
        CategoryTheory.CategoryStruct.id (weilCupPDLocalFreeSheaf X ℓ V'_et))
      (weilCupPDLocalFreeMap X ℓ p_et) = 0)
    (hEnd_V' : Function.Bijective (fun c : ZMod ℓ =>
      c.val • CategoryTheory.CategoryStruct.id
        (weilCupPDModUnit ((AlgebraicGeometry.Scheme.Etale.forget X).obj V'_et).left ℓ)))
    (hSheets : ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget X).obj V_et).left,
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W)
        (w : W ⟶ ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_et).left)
        (_ : AlgebraicGeometry.Etale w)
        (w₀ : ↥W) (_ : w.base w₀ = x)
        (s_sh : ZMod ℓ →
          (W ⟶ CategoryTheory.Limits.pullback
            ((AlgebraicGeometry.Scheme.Etale.forget X).map p_et).left w)),
        (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (s_sh i)) ∧
        (∀ i : ZMod ℓ,
          s_sh i ≫ CategoryTheory.Limits.pullback.snd
              ((AlgebraicGeometry.Scheme.Etale.forget X).map p_et).left w =
            CategoryTheory.CategoryStruct.id W) ∧
        (∀ i : ZMod ℓ,
          s_sh i ≫ CategoryTheory.Limits.pullback.fst
              ((AlgebraicGeometry.Scheme.Etale.forget X).map p_et).left w ≫
              ((AlgebraicGeometry.Scheme.Etale.forget X).map σ_et).left =
            s_sh (i + 1) ≫ CategoryTheory.Limits.pullback.fst
              ((AlgebraicGeometry.Scheme.Etale.forget X).map p_et).left w) ∧
        (_root_.Pairwise fun i j : ZMod ℓ =>
          Disjoint (Set.range (s_sh i).base) (Set.range (s_sh j).base)) ∧
        (⋃ i : ZMod ℓ, Set.range (s_sh i).base) = Set.univ) :
    let L := weilCupPDLocalFreeSheaf X ℓ V_et
    let M := weilCupPDLocalFreeSheaf X ℓ V'_et
    let π : Quiver.Hom M L := weilCupPDLocalFreeMap X ℓ p_et
    let τ : Quiver.Hom M M :=
      weilCupPDLocalFreeMap X ℓ σ_et - CategoryTheory.CategoryStruct.id M
    (CategoryTheory.ShortComplex.mk τ π h0).Exact ∧
    Nat.card (CategoryTheory.Abelian.Ext.{u} M (weilCupPDModUnit X ℓ) 0) = ℓ :=
by
  classical
  let _ := hσ_p
  let R := ULift.{u, 0} (ZMod ℓ)
  let RM := ModuleCat.of R R
  let L := weilCupPDLocalFreeSheaf X ℓ V_et
  let M := weilCupPDLocalFreeSheaf X ℓ V'_et
  let π : Quiver.Hom M L := weilCupPDLocalFreeMap X ℓ p_et
  let τ : Quiver.Hom M M :=
    weilCupPDLocalFreeMap X ℓ σ_et - CategoryTheory.CategoryStruct.id M
  have : NeZero ℓ := ⟨(Fact.out : Nat.Prime ℓ).ne_zero⟩
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
      (@AlgebraicGeometry.Etale)).toIsStableUnderComposition

  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S U₁ U₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom) := by
      rw [hvw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom U₂.prop hEt_comp

  have hEquiv_comp :
      ∀ {W_et : X.Etale}
        {F G : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)}
        (α : weilCupPDLocalFreeSheaf X ℓ W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro W_et F G α g
    let α' : (CategoryTheory.presheafToSheaf X.smallEtaleTopology (ModuleCat.{u, u} R)).obj
        (CategoryTheory.Presheaf.freeYoneda W_et RM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction X.smallEtaleTopology
            (ModuleCat.{u, u} R)).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction X.smallEtaleTopology
              (ModuleCat.{u, u} R)).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf X.smallEtaleTopology
                (ModuleCat.{u, u} R)).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hmap_equiv :
      ∀ {U₁ U₂ : X.Etale} (u : U₁ ⟶ U₂)
        {F : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)}
        (α : weilCupPDLocalFreeSheaf X ℓ U₂ ⟶ F),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap X ℓ u ≫ α) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ F.obj.map (Opposite.op u) := by
    intro U₁ U₂ u F α
    let F₂ := weilCupPDLocalFreeSheaf X ℓ U₂
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap X ℓ u ≫ α)
        = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap X ℓ u) ≫
            α.hom.app (Opposite.op U₁) :=
            hEquiv_comp (weilCupPDLocalFreeMap X ℓ u) α
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 F₂) ≫ F₂.obj.map (Opposite.op u)) ≫
            α.hom.app (Opposite.op U₁) := by
            have hv : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap X ℓ u) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 F₂) ≫ F₂.obj.map (Opposite.op u) :=
              Equiv.apply_symm_apply _ _
            rw [hv]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 F₂) ≫
            (F₂.obj.map (Opposite.op u) ≫ α.hom.app (Opposite.op U₁)) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 F₂) ≫
            (α.hom.app (Opposite.op U₂) ≫ F.obj.map (Opposite.op u)) := by
            rw [α.hom.naturality (Opposite.op u)]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 F₂) ≫ α.hom.app (Opposite.op U₂)) ≫
            F.obj.map (Opposite.op u) := by
            rw [← CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ F.obj.map (Opposite.op u) := by
            rw [← hEquiv_comp (𝟙 F₂) α, CategoryTheory.Category.id_comp]

  have hRM_ext :
      ∀ {E : ModuleCat.{u, u} R} {φ₁ φ₂ : RM ⟶ E},
        φ₁.hom (ULift.up 1) = φ₂.hom (ULift.up 1) → φ₁ = φ₂ := by
    intro E φ₁ φ₂ h1
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro r
    have hr : r = r • (ULift.up 1 : R) := ULift.ext _ _ (mul_one r.down).symm
    calc
      φ₁.hom r = φ₁.hom (r • (ULift.up 1 : R)) := congrArg φ₁.hom hr
      _ = r • φ₁.hom (ULift.up 1) := φ₁.hom.map_smul r (ULift.up 1)
      _ = r • φ₂.hom (ULift.up 1) := by rw [h1]
      _ = φ₂.hom (r • (ULift.up 1 : R)) := (φ₂.hom.map_smul r (ULift.up 1)).symm
      _ = φ₂.hom r := congrArg φ₂.hom hr.symm

  refine ⟨?_, ?_⟩
  · 
    have hDescent :
        ∀ (F : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R))
          (s' : ↑(F.obj.obj (Opposite.op V'_et))),
          (F.obj.map (Opposite.op σ_et)).hom s' = s' →
          ∃! s : ↑(F.obj.obj (Opposite.op V_et)),
            (F.obj.map (Opposite.op p_et)).hom s = s' := by
      intro F s' hs'
      let appMap : ∀ {A B : X.Etale}, (A ⟶ B) → ↑(F.obj.obj (Opposite.op B)) →
          ↑(F.obj.obj (Opposite.op A)) :=
        fun f t => (F.obj.map (Opposite.op f)).hom t
      have hcomp_map :
          ∀ {A B C : X.Etale} (a : A ⟶ B) (b : B ⟶ C)
            (t : ↑(F.obj.obj (Opposite.op C))),
            appMap a (appMap b t) = appMap (a ≫ b) t := by
        intro A B C a b t
        dsimp [appMap]
        have hop : Opposite.op (a ≫ b) =
            (Opposite.op b ≫ Opposite.op a : Opposite.op C ⟶ Opposite.op A) := rfl
        rw [hop, CategoryTheory.Functor.map_comp]
        rfl
      have hF_cat : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology
          (F.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) :=
        CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf X.smallEtaleTopology F.obj
          (CategoryTheory.forget (ModuleCat.{u, u} R)) F.property
      have hF_type : CategoryTheory.Presieve.IsSheaf X.smallEtaleTopology
          (F.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) :=
        (CategoryTheory.isSheaf_iff_isSheaf_of_type X.smallEtaleTopology _).mp hF_cat
      have hJ_eq : X.smallEtaleTopology = X.smallEtalePretopology.toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X le_rfl
      let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
      let ι_idx := ↥(Fgt.obj V_et).left
      let p_map := (Fgt.map p_et).left
      let σ_map := (Fgt.map σ_et).left
      let W_sch : ι_idx → AlgebraicGeometry.Scheme.{u} := fun x => Classical.choose (hSheets x)
      let w_map : ∀ x : ι_idx, W_sch x ⟶ (Fgt.obj V_et).left :=
        fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (hSheets x)))
      have hw_et : ∀ x : ι_idx, AlgebraicGeometry.Etale (w_map x) :=
        fun x => Classical.choose (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (hSheets x))))
      let w_pt : ∀ x : ι_idx, ↥(W_sch x) :=
        fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (hSheets x)))))
      have hw_pt : ∀ x : ι_idx, (w_map x).base (w_pt x) = x :=
        fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hSheets x))))))
      let s_map : ∀ x : ι_idx, ZMod ℓ → (W_sch x ⟶ CategoryTheory.Limits.pullback p_map (w_map x)) :=
        fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hSheets x)))))))
      have hs_spec : ∀ x : ι_idx,
          (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (s_map x i)) ∧
          (∀ i : ZMod ℓ, s_map x i ≫ CategoryTheory.Limits.pullback.snd p_map (w_map x) =
            CategoryTheory.CategoryStruct.id (W_sch x)) ∧
          (∀ i : ZMod ℓ, s_map x i ≫ CategoryTheory.Limits.pullback.fst p_map (w_map x) ≫ σ_map =
            s_map x (i + 1) ≫ CategoryTheory.Limits.pullback.fst p_map (w_map x)) ∧
          (_root_.Pairwise fun i j : ZMod ℓ =>
            Disjoint (Set.range (s_map x i).base) (Set.range (s_map x j).base)) ∧
          (⋃ i : ZMod ℓ, Set.range (s_map x i).base) = Set.univ :=
        fun x => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hSheets x)))))))
      let Y_cov : ι_idx → X.Etale := fun x =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ (w_map x ≫ (Fgt.obj V_et).hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            (w_map x) (Fgt.obj V_et).hom (hw_et x) V_et.prop)
      let v_cov : ∀ x : ι_idx, Y_cov x ⟶ V_et := fun x =>
        CategoryTheory.MorphismProperty.Over.homMk (w_map x) rfl trivial
      let u_left : ∀ x : ι_idx, ZMod ℓ → (W_sch x ⟶ (Fgt.obj V'_et).left) := fun x i =>
        s_map x i ≫ CategoryTheory.Limits.pullback.fst p_map (w_map x)
      have hu_fac : ∀ (x : ι_idx) (i : ZMod ℓ), u_left x i ≫ p_map = w_map x := by
        intro x i
        dsimp [u_left]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
          ← CategoryTheory.Category.assoc, (hs_spec x).2.1 i, CategoryTheory.Category.id_comp]
      let u_cov : ∀ (x : ι_idx), ZMod ℓ → (Y_cov x ⟶ V'_et) := fun x i =>
        CategoryTheory.MorphismProperty.Over.homMk (u_left x i)
          (by
            have hp_w : p_map ≫ (Fgt.obj V_et).hom = (Fgt.obj V'_et).hom :=
              CategoryTheory.MorphismProperty.Over.w p_et
            change u_left x i ≫ (Fgt.obj V'_et).hom = w_map x ≫ (Fgt.obj V_et).hom
            rw [← hp_w, ← CategoryTheory.Category.assoc, hu_fac x i])
          trivial
      have huv_eq : ∀ (x : ι_idx) (i : ZMod ℓ), u_cov x i ≫ p_et = v_cov x :=
        fun x i => CategoryTheory.MorphismProperty.Over.Hom.ext (hu_fac x i)
      have hu_shift : ∀ (x : ι_idx) (i : ZMod ℓ), u_cov x i ≫ σ_et = u_cov x (i + 1) :=
        fun x i => CategoryTheory.MorphismProperty.Over.Hom.ext ((hs_spec x).2.2.1 i)
      have hInv_nat : ∀ (x : ι_idx) (k : ℕ),
          appMap (u_cov x (k : ZMod ℓ)) s' = appMap (u_cov x 0) s' := by
        intro x k
        induction k with
        | zero =>
          exact congrArg (fun j : ZMod ℓ => appMap (u_cov x j) s') Nat.cast_zero
        | succ k ih =>
          calc
            appMap (u_cov x ((k + 1 : ℕ) : ZMod ℓ)) s'
              = appMap (u_cov x ((k : ZMod ℓ) + 1)) s' :=
                congrArg (fun j : ZMod ℓ => appMap (u_cov x j) s') (Nat.cast_succ k)
            _ = appMap (u_cov x (k : ZMod ℓ) ≫ σ_et) s' :=
                congrArg (fun f_m => appMap f_m s') (hu_shift x (k : ZMod ℓ)).symm
            _ = appMap (u_cov x (k : ZMod ℓ)) (appMap σ_et s') :=
                (hcomp_map (u_cov x (k : ZMod ℓ)) σ_et s').symm
            _ = appMap (u_cov x (k : ZMod ℓ)) s' :=
                congrArg (appMap (u_cov x (k : ZMod ℓ))) hs'
            _ = appMap (u_cov x 0) s' := ih
      have hInv : ∀ (x : ι_idx) (i : ZMod ℓ),
          appMap (u_cov x i) s' = appMap (u_cov x 0) s' := by
        intro x i
        exact (congrArg (fun j : ZMod ℓ => appMap (u_cov x j) s')
          (ZMod.natCast_zmod_val i).symm).trans (hInv_nat x i.val)
      have hSieve_V : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y_cov v_cov) ∈
          X.smallEtaleTopology V_et := by
        rw [hJ_eq]
        refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology V_et _).mpr ?_
        intro x
        exact ⟨Y_cov x, v_cov x, w_pt x,
          CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows Y_cov v_cov)
            (Y_cov x) (v_cov x) (CategoryTheory.Presieve.ofArrows.mk x),
          hw_et x, hw_pt x⟩
      let sec : ∀ x : ι_idx, ↑(F.obj.obj (Opposite.op (Y_cov x))) :=
        fun x => appMap (u_cov x 0) s'
      have hcompat : CategoryTheory.Presieve.Arrows.Compatible
          (F.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) v_cov sec := by
        intro x y Z g₁ g₂ hcomm
        change appMap g₁ (sec x) = appMap g₂ (sec y)
        let Z_sch : AlgebraicGeometry.Scheme.{u} := (Fgt.obj Z).left
        let g₁_left : Z_sch ⟶ W_sch x := (Fgt.map g₁).left
        let g₂_left : Z_sch ⟶ W_sch y := (Fgt.map g₂).left
        have hcomm_left : g₁_left ≫ w_map x = g₂_left ≫ w_map y :=
          congrArg (fun m : Z ⟶ V_et => (Fgt.map m).left) hcomm
        have hγ_cond : (g₁_left ≫ u_left x 0) ≫ p_map = g₂_left ≫ w_map y :=
          (CategoryTheory.Category.assoc g₁_left (u_left x 0) p_map).trans
            ((congrArg (g₁_left ≫ ·) (hu_fac x 0)).trans hcomm_left)
        let γ : Z_sch ⟶ CategoryTheory.Limits.pullback p_map (w_map y) :=
          CategoryTheory.Limits.pullback.lift (g₁_left ≫ u_left x 0) g₂_left hγ_cond
        let O_sh : ZMod ℓ → Z_sch.Opens := fun i =>
          have : AlgebraicGeometry.IsOpenImmersion (s_map y i) := (hs_spec y).1 i
          (TopologicalSpace.Opens.map γ.base).obj (s_map y i).opensRange
        let Z_sh : ZMod ℓ → X.Etale := fun i =>
          CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_sh i).ι ≫ (Fgt.obj Z).hom)
            (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
              (O_sh i).ι (Fgt.obj Z).hom inferInstance Z.prop)
        let ι_sh : ∀ i : ZMod ℓ, Z_sh i ⟶ Z := fun i =>
          CategoryTheory.MorphismProperty.Over.homMk (O_sh i).ι rfl trivial
        have hSieve_Z : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Z_sh ι_sh) ∈
            X.smallEtaleTopology Z := by
          rw [hJ_eq]
          refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology Z _).mpr ?_
          intro z
          have hz_univ : γ.base z ∈ (⋃ i : ZMod ℓ, Set.range (s_map y i).base) := by
            rw [(hs_spec y).2.2.2.2]
            trivial
          obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz_univ
          have : AlgebraicGeometry.IsOpenImmersion (s_map y i) := (hs_spec y).1 i
          have hz_O : z ∈ O_sh i := by
