  have step3_strictify : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (T_S : S.Etale) (hT_S : Limits.IsTerminal T_S)
      (θ : weilEtaleModuleH S ℓ q →+ weilEtaleTorsionH S ℓ q),
      WeilIsModuleToTorsionComparison S ℓ q θ →
      let R := ULift.{u, 0} (ZMod ℓ)
      let R_mod := ModuleCat.of R R
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
      let ιM_mod : AM ⟶ FgtMod.obj R_mod := AddCommGrpCat.ofHom (AddMonoidHom.id R)
      let ιℤ_mod : Aℤ ⟶ FgtMod.obj R_mod :=
        (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
          Aℤ ⟶ AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)) ≫
          (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod ℓ))) ≫
            ιM_mod)
      ∃ (hHasSC : S.smallEtaleTopology.HasSheafCompose FgtMod),
        letI := hHasSC
        let U_std := CategoryTheory.sheafCompose S.smallEtaleTopology FgtMod
        ∃ (hAdd : U_std.Additive)
          (hLim : Limits.PreservesFiniteLimits U_std)
          (hColim : Limits.PreservesFiniteColimits U_std),
          letI := hAdd; letI := hLim; letI := hColim
          let one_S := weilEtaleModuleUnit S ℓ
          let Cℤ_S := CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}
          let adjR_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT_S
          let adjℤ_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
          let u_std : FgtMod.obj R_mod ⟶ (U_std.obj one_S).obj.obj (Opposite.op T_S) :=
            FgtMod.map (adjR_S.unit.app R_mod)
