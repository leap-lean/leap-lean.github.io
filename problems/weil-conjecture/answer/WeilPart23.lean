    have hx_Fm : ι_V.left.base x ∈ weilProjHyperplaneSet k N F_m_form := by
      have h := hAll (Fin.last m).castSucc
      rwa [hF_m_eq] at h
    have hx_Flast : ι_V.left.base x ∈ weilProjHyperplaneSet k N F_last_form := by
      have h := hAll (Fin.last (m + 1))
      rwa [hF_last1] at h
    have hIn : ι_V.left.base x ∈
        ((Y_tot ∩ M_m) ∩ weilProjHyperplaneSet k N F_m_form) ∩
          weilProjHyperplaneSet k N F_last_form :=
      ⟨⟨⟨hx_tot, hx_Mm⟩, hx_Fm⟩, hx_Flast⟩
    rw [hEmpty_TotAll] at hIn
    exact hIn

  
  
  
  obtain ⟨hIntP, _, hDimP, _⟩ :=
    weil_projectiveSpace_integral_krullDim_and_dim_zero_iso k (m + 1)

  obtain ⟨π, b_star, hFin_π, hSurj_π, hPre_Uproj, hChart_π, hb_star_iff,
      hChart_WV, hDiv_pkg⟩ :=
    weil_proj_basepointFree_linear_projection_package k m N hm V_norm
      hIntVn hDimVn hIntP hDimP ι_V hClV pr_p₀ hPr F hF_hom hF_bp
  have : AlgebraicGeometry.IsFinite π.left := hFin_π

  let U_φ₁ : V_norm.left.Opens := π.left ⁻¹ᵁ U_proj
  let S₀ : Set V_norm.left := (U_φ₁ : Set V_norm.left)ᶜ
  have hClosed_S₀ : IsClosed S₀ := U_φ₁.isOpen.isClosed_compl

  have hS₀_iff :
      ∀ x : V_norm.left,
        x ∈ S₀ ↔
          (∀ j : Fin m, ι_V.left.base x ∈ weilProjHyperplaneSet k N (F_init j)) ∧
