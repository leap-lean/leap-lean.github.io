    have hG_sheaf := (CategoryTheory.isSheaf_iff_isSheaf_of_type J G.obj).mp G.property
    intro W R hR x_fam hx_compat
    let S_R : CategoryTheory.Sieve (M_p.obj W) := R.functorPushforward M_p
    have hSR : S_R ∈ J (M_p.obj W) := by
