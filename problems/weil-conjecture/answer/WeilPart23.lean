          have hterm : g₁ ≫ hT_S.from _ = g₂ ≫ hT_S.from _ := hT_S.hom_ext _ _
          let src := FM.obj.obj (Opposite.op T_S)
          let dst := FM.obj.obj (Opposite.op Z)
          have hmap_eq : FM.obj.map (Opposite.op (hT_S.from (openEtObj W (lvlOpen W s y₁)))) ≫
              FM.obj.map (Opposite.op g₁) =
              FM.obj.map (Opposite.op (hT_S.from (openEtObj W (lvlOpen W s y₂)))) ≫
              FM.obj.map (Opposite.op g₂) :=
            (FM.obj.map_comp _ _).symm.trans
              ((congrArg FM.obj.map (congrArg Opposite.op hterm)).trans (FM.obj.map_comp _ _))
          exact (congrArg (fun a => (FM.obj.map (Opposite.op g₁)).hom
              ((FM.obj.map (Opposite.op (hT_S.from (openEtObj W (lvlOpen W s y₁))))).hom
                ((adj_S.unit.app AM).hom a))) hsy).trans
            (congrArg (fun f : src ⟶ dst =>
              AddCommGrpCat.Hom.hom f ((adj_S.unit.app AM).hom (s y₂))) hmap_eq)

    let φ_inv_fn : ∀ (W : S.Etale),
        LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n)) → ↥(FM.obj.obj (Opposite.op W)) :=
      fun W s => Classical.choose (hΦ_inv_ex W s)
    have hφ_inv_spec : ∀ (W : S.Etale)
        (s : LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n)))
        (y : ↥(Fgt.obj W).left),
        (FM.obj.map (Opposite.op (openEtHom W (lvlOpen W s y)))).hom (φ_inv_fn W s) =
          (FM.obj.map (Opposite.op (hT_S.from (openEtObj W (lvlOpen W s y))))).hom
            ((adj_S.unit.app AM).hom (s y)) :=
      fun W s => (Classical.choose_spec (hΦ_inv_ex W s)).1

    have hφ_inv_res_open : ∀ (W : S.Etale)
        (s : LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n)))
        (O : ((Fgt.obj W).left).Opens) (a : ULift.{u} (ZMod n)),
        (∀ z : ↥O.toScheme, s z.1 = a) →
        (FM.obj.map (Opposite.op (openEtHom W O))).hom (φ_inv_fn W s) =
          (FM.obj.map (Opposite.op (hT_S.from (openEtObj W O)))).hom ((adj_S.unit.app AM).hom a) := by
      intro W s O a hOa
      by_cases hEmp : IsEmpty ↥(Fgt.obj (openEtObj W O)).left
      · exact (hSubOfEmpty FM (openEtObj W O) hEmp).elim _ _
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmp
        have hle : O ≤ lvlOpen W s z₀.1 := fun x hx => (hOa ⟨x, hx⟩).trans (hOa z₀).symm
        let inc_mor : openEtObj W O ⟶ openEtObj W (lvlOpen W s z₀.1) :=
          CategoryTheory.MorphismProperty.Over.homMk
            (((Fgt.obj W).left).homOfLE hle)
            (by
              change ((Fgt.obj W).left).homOfLE hle ≫ (lvlOpen W s z₀.1).ι ≫ (Fgt.obj W).hom =
                O.ι ≫ (Fgt.obj W).hom
              rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι])
            trivial
        have hfac : inc_mor ≫ openEtHom W (lvlOpen W s z₀.1) = openEtHom W O :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (AlgebraicGeometry.Scheme.homOfLE_ι _ hle)
        have ha : s z₀.1 = a := hOa z₀
        let M_W := FM.obj.obj (Opposite.op W)
        let M_O := FM.obj.obj (Opposite.op (openEtObj W O))
        let M_T := FM.obj.obj (Opposite.op T_S)
        have h1 : (FM.obj.map (Opposite.op (openEtHom W O))).hom (φ_inv_fn W s) =
            (FM.obj.map (Opposite.op inc_mor)).hom
              ((FM.obj.map (Opposite.op (openEtHom W (lvlOpen W s z₀.1)))).hom (φ_inv_fn W s)) :=
          congrArg (fun f : M_W ⟶ M_O => AddCommGrpCat.Hom.hom f (φ_inv_fn W s))
            ((congrArg FM.obj.map (congrArg Opposite.op hfac.symm)).trans (FM.obj.map_comp _ _))
        have h2 := congrArg (FM.obj.map (Opposite.op inc_mor)).hom (hφ_inv_spec W s z₀.1)
        have hterm : inc_mor ≫ hT_S.from _ = hT_S.from _ := hT_S.hom_ext _ _
        have h3 : (FM.obj.map (Opposite.op inc_mor)).hom
            ((FM.obj.map (Opposite.op (hT_S.from (openEtObj W (lvlOpen W s z₀.1))))).hom
              ((adj_S.unit.app AM).hom (s z₀.1))) =
            (FM.obj.map (Opposite.op (hT_S.from (openEtObj W O)))).hom
              ((adj_S.unit.app AM).hom a) :=
          (congrArg (fun b => (FM.obj.map (Opposite.op inc_mor)).hom
              ((FM.obj.map (Opposite.op (hT_S.from (openEtObj W (lvlOpen W s z₀.1))))).hom
                ((adj_S.unit.app AM).hom b))) ha).trans
            (congrArg (fun f : M_T ⟶ M_O => AddCommGrpCat.Hom.hom f ((adj_S.unit.app AM).hom a))
              ((FM.obj.map_comp _ _).symm.trans (congrArg FM.obj.map (congrArg Opposite.op hterm))))
        exact h1.trans (h2.trans h3)

    let Φ_inv : ℒ_S ⟶ FM :=
      { hom :=
          { app := fun W_op =>
              let W := Opposite.unop W_op
              AddCommGrpCat.ofHom
                { toFun := φ_inv_fn W
                  map_zero' := by
                    refine ((Classical.choose_spec (hΦ_inv_ex W 0)).2 0 ?_).symm
                    intro y
                    change (FM.obj.map _).hom 0 = (FM.obj.map _).hom ((adj_S.unit.app AM).hom 0)
                    rw [map_zero, map_zero, map_zero]
                  map_add' := fun s₁ s₂ => by
                    let O_sum : ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
                      fun y => lvlOpen W s₁ y ⊓ lvlOpen W s₂ y
                    let M_W := FM.obj.obj (Opposite.op W)
                    have hUniq := hGlueArrows FM W (fun y => openEtObj W (O_sum y))
                      (fun y => openEtHom W (O_sum y))
                      (fun x => ⟨x, ⟨x, ⟨rfl, rfl⟩⟩, rfl⟩)
                    apply (hUniq (fun y =>
                      (FM.obj.map (Opposite.op (openEtHom W (O_sum y)))).hom
                        (φ_inv_fn W (s₁ + s₂)))
                      (fun y₁ y₂ Z g₁ g₂ hg =>
                        congrArg (fun f : M_W ⟶ FM.obj.obj (Opposite.op Z) =>
                          AddCommGrpCat.Hom.hom f (φ_inv_fn W (s₁ + s₂)))
                          ((FM.obj.map_comp _ _).symm.trans
                            ((congrArg FM.obj.map (congrArg Opposite.op hg)).trans
                              (FM.obj.map_comp _ _))))).unique
                    · intro y
                      rfl
                    · intro y
                      have hsum := hφ_inv_res_open W (s₁ + s₂) (O_sum y) (s₁ y + s₂ y)
                        (fun z => congrArg₂ (· + ·) z.2.1 z.2.2)
                      have h1 := hφ_inv_res_open W s₁ (O_sum y) (s₁ y) (fun z => z.2.1)
                      have h2 := hφ_inv_res_open W s₂ (O_sum y) (s₂ y) (fun z => z.2.2)
                      exact (map_add (FM.obj.map (Opposite.op (openEtHom W (O_sum y)))).hom _ _).trans
                        ((congrArg₂ (· + ·) h1 h2).trans
                          ((map_add (FM.obj.map (Opposite.op (hT_S.from (openEtObj W (O_sum y))))).hom _ _).symm.trans
                            ((congrArg (FM.obj.map (Opposite.op (hT_S.from (openEtObj W (O_sum y))))).hom
                              (map_add (adj_S.unit.app AM).hom (s₁ y) (s₂ y)).symm).trans hsum.symm))) }
            naturality := fun {W₁_op W₂_op} f_op => by
              let W₁ := Opposite.unop W₁_op
              let W₂ := Opposite.unop W₂_op
              let u : W₂ ⟶ W₁ := f_op.unop
              ext s
              let s₁ : LocallyConstant ↥(Fgt.obj W₁).left (ULift.{u} (ZMod n)) := s
              change φ_inv_fn W₂ ((ℒ_S.obj.map (Opposite.op u)).hom s₁) =
                (FM.obj.map (Opposite.op u)).hom (φ_inv_fn W₁ s₁)
              let s₂ : LocallyConstant ↥(Fgt.obj W₂).left (ULift.{u} (ZMod n)) :=
                (ℒ_S.obj.map (Opposite.op u)).hom s₁
              refine ((Classical.choose_spec (hΦ_inv_ex W₂ s₂)).2 _ fun z => ?_).symm
              let y := (Fgt.map u).left.base z
              let O₂ := lvlOpen W₂ s₂ z
              let O₁ := lvlOpen W₁ s₁ y
              have hrange : Set.range (O₂.ι ≫ (Fgt.map u).left).base ⊆ Set.range O₁.ι.base := by
                rintro _ ⟨w, rfl⟩
                rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                exact w.2
              let lift_sch : O₂.toScheme ⟶ O₁.toScheme :=
                AlgebraicGeometry.IsOpenImmersion.lift O₁.ι (O₂.ι ≫ (Fgt.map u).left) hrange
              have hlift_fac : lift_sch ≫ O₁.ι = O₂.ι ≫ (Fgt.map u).left :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac O₁.ι (O₂.ι ≫ (Fgt.map u).left) hrange
              have hwu : (Fgt.map u).left ≫ (Fgt.obj W₁).hom = (Fgt.obj W₂).hom :=
                CategoryTheory.MorphismProperty.Over.w u
              let lift_et : openEtObj W₂ O₂ ⟶ openEtObj W₁ O₁ :=
                CategoryTheory.MorphismProperty.Over.homMk lift_sch
                  (by
                    change lift_sch ≫ O₁.ι ≫ (Fgt.obj W₁).hom = O₂.ι ≫ (Fgt.obj W₂).hom
                    rw [← CategoryTheory.Category.assoc, hlift_fac, CategoryTheory.Category.assoc, hwu])
                  trivial
              have hcomm_et : openEtHom W₂ O₂ ≫ u = lift_et ≫ openEtHom W₁ O₁ :=
                CategoryTheory.MorphismProperty.Over.Hom.ext hlift_fac.symm
              let M₁ := FM.obj.obj (Opposite.op W₁)
              let M_O₂ := FM.obj.obj (Opposite.op (openEtObj W₂ O₂))
              let M_T := FM.obj.obj (Opposite.op T_S)
              have hL : (FM.obj.map (Opposite.op (openEtHom W₂ O₂))).hom
                  ((FM.obj.map (Opposite.op u)).hom (φ_inv_fn W₁ s₁)) =
                  (FM.obj.map (Opposite.op lift_et)).hom
                    ((FM.obj.map (Opposite.op (openEtHom W₁ O₁))).hom (φ_inv_fn W₁ s₁)) :=
                congrArg (fun g : M₁ ⟶ M_O₂ => AddCommGrpCat.Hom.hom g (φ_inv_fn W₁ s₁))
                  ((FM.obj.map_comp _ _).symm.trans
                    ((congrArg FM.obj.map (congrArg Opposite.op hcomm_et)).trans
                      (FM.obj.map_comp _ _)))
              have hterm : lift_et ≫ hT_S.from _ = hT_S.from _ := hT_S.hom_ext _ _
              exact hL.trans
                ((congrArg (FM.obj.map (Opposite.op lift_et)).hom (hφ_inv_spec W₁ s₁ y)).trans
                  (congrArg (fun g : M_T ⟶ M_O₂ => AddCommGrpCat.Hom.hom g ((adj_S.unit.app AM).hom (s₁ y)))
                    ((FM.obj.map_comp _ _).symm.trans
                      (congrArg FM.obj.map (congrArg Opposite.op hterm))))) } }

    have hΦ_hom_inv : Φ_hom ≫ Φ_inv = 𝟙 FM := by
      apply (adj_S.homEquiv AM FM).injective
      have h1 : adj_S.homEquiv AM FM (Φ_hom ≫ Φ_inv) =
          adj_S.homEquiv AM ℒ_S Φ_hom ≫ Φ_inv.hom.app (Opposite.op T_S) :=
        adj_S.homEquiv_naturality_right Φ_hom Φ_inv
      have h2 : adj_S.homEquiv AM FM (𝟙 FM) = adj_S.unit.app AM :=
        (adj_S.homEquiv_unit AM FM (𝟙 FM)).trans (CategoryTheory.Category.comp_id _)
      rw [h1, h2]
      have h3 : adj_S.homEquiv AM ℒ_S Φ_hom = weilAltLocConstConstHom S T_S n :=
        Equiv.apply_symm_apply _ _
      rw [h3]
      ext a
      change φ_inv_fn T_S (LocallyConstant.const ↥(Fgt.obj T_S).left a) =
        (adj_S.unit.app AM).hom a
      refine ((Classical.choose_spec (hΦ_inv_ex T_S _)).2 _ fun y => ?_).symm
      have hterm : openEtHom T_S (lvlOpen T_S (LocallyConstant.const _ a) y) =
          hT_S.from _ := hT_S.hom_ext _ _
      exact congrArg (fun u => (FM.obj.map (Opposite.op u)).hom ((adj_S.unit.app AM).hom a)) hterm

    have hΦ_inv_hom : Φ_inv ≫ Φ_hom = 𝟙 ℒ_S := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W_op
      let W := Opposite.unop W_op
      ext s
      let sW : LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n)) := s
      apply LocallyConstant.ext
      intro y
      let O_y := lvlOpen W sW y
      let W_y := openEtObj W O_y
      let pt_y : ↥(Fgt.obj W_y).left := ⟨y, rfl⟩
      let j_y := openEtHom W O_y
      let src := FM.obj.obj (Opposite.op W)
      let dst := ℒ_S.obj.obj (Opposite.op W_y)
      have hnat := congrArg (fun g : src ⟶ dst =>
          LocallyConstant.toFun (AddCommGrpCat.Hom.hom g (φ_inv_fn W sW)) pt_y)
        (Φ_hom.hom.naturality (Opposite.op j_y))
      change LocallyConstant.toFun ((Φ_hom.hom.app (Opposite.op W_y)).hom
          ((FM.obj.map (Opposite.op j_y)).hom (φ_inv_fn W sW))) pt_y =
        LocallyConstant.toFun ((Φ_hom.hom.app (Opposite.op W)).hom (φ_inv_fn W sW)) y at hnat
      exact hnat.symm.trans
        (congrArg (fun z => LocallyConstant.toFun
            ((Φ_hom.hom.app (Opposite.op W_y)).hom z) pt_y)
          (hφ_inv_spec W sW y) |>.trans
          (congrArg (fun fn : LocallyConstant ↥(Fgt.obj W_y).left (ULift.{u} (ZMod n)) => fn pt_y)
            (hΦ_const W_y (sW y))))

    let Φ_S : FM ≅ ℒ_S :=
      { hom := Φ_hom, inv := Φ_inv, hom_inv_id := hΦ_hom_inv, inv_hom_id := hΦ_inv_hom }
    let 𝒦_S : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      ⟨weilAltZeroBdrySubpresheaf S U_open n, hSh0⟩
    let L_U : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleLocalTorsionSheaf S n U_et
    let ξ_U : AM ⟶ L_U.obj.obj (Opposite.op U_et) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U)

    have hEquiv_comp : ∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (α : L_U ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U_et) := by
      intro F G α g
      let α' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda U_et AM) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map g) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U_et) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

    let η_U : AM ⟶ 𝒦_S.obj.obj (Opposite.op U_et) :=
      AddCommGrpCat.ofHom
        { toFun := fun a =>
            ⟨LocallyConstant.const ↥(Fgt.obj U_et).left a,
             fun x hx => (hx x.2).elim⟩
          map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
          map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
    let Ψ_hom : L_U ⟶ 𝒦_S := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm η_U

    have hΨ_gen : ∀ a : ULift.{u} (ZMod n),
        ((CategoryTheory.Sheaf.freeYonedaHomEquiv Ψ_hom).hom a).1 =
          LocallyConstant.const ↥(Fgt.obj U_et).left a := by
      intro a
      have heq : CategoryTheory.Sheaf.freeYonedaHomEquiv Ψ_hom = η_U :=
        Equiv.apply_symm_apply _ _
      exact congrArg (fun f : AM ⟶ 𝒦_S.obj.obj (Opposite.op U_et) =>
        (AddCommGrpCat.Hom.hom f a).1) heq

    have hΨ_eval : ∀ (W : S.Etale) (u : W ⟶ U_et) (a : ULift.{u} (ZMod n)),
        ((Ψ_hom.hom.app (Opposite.op W)).hom ((L_U.obj.map (Opposite.op u)).hom (ξ_U.hom a))).1 =
          LocallyConstant.const ↥(Fgt.obj W).left a := by
      intro W u a
      let src := L_U.obj.obj (Opposite.op U_et)
      let dst := 𝒦_S.obj.obj (Opposite.op W)
      have hnat := congrArg (fun f : src ⟶ dst => (AddCommGrpCat.Hom.hom f (ξ_U.hom a)).1)
        (Ψ_hom.hom.naturality (Opposite.op u))
      change ((Ψ_hom.hom.app (Opposite.op W)).hom ((L_U.obj.map (Opposite.op u)).hom (ξ_U.hom a))).1 =
        ((𝒦_S.obj.map (Opposite.op u)).hom
          ((Ψ_hom.hom.app (Opposite.op U_et)).hom (ξ_U.hom a))).1 at hnat
      refine hnat.trans ?_
      have hid_eq : ξ_U ≫ Ψ_hom.hom.app (Opposite.op U_et) = η_U :=
        (hEquiv_comp (𝟙 L_U) Ψ_hom).symm.trans
          ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.Category.id_comp Ψ_hom)).trans (Equiv.apply_symm_apply _ _))
      have ha := congrArg (fun f : AM ⟶ 𝒦_S.obj.obj (Opposite.op U_et) =>
        (AddCommGrpCat.Hom.hom f a).1) hid_eq
      change ((Ψ_hom.hom.app (Opposite.op U_et)).hom (ξ_U.hom a)).1 =
        LocallyConstant.const ↥(Fgt.obj U_et).left a at ha
      apply LocallyConstant.ext
      intro w
      exact congrArg (fun fn : LocallyConstant _ _ => fn ((Fgt.map u).left.base w)) ha

    let liftToUSch : ∀ (W : S.Etale) (O : ((Fgt.obj W).left).Opens),
        (Set.range (O.ι ≫ (Fgt.obj W).hom).base ⊆ Set.range U_open.ι.base) →
        (O.toScheme ⟶ U_open.toScheme) :=
      fun W O hsub => AlgebraicGeometry.IsOpenImmersion.lift U_open.ι (O.ι ≫ (Fgt.obj W).hom) hsub

    let liftToU : ∀ (W : S.Etale) (O : ((Fgt.obj W).left).Opens),
        (Set.range (O.ι ≫ (Fgt.obj W).hom).base ⊆ Set.range U_open.ι.base) →
        (openEtObj W O ⟶ U_et) :=
      fun W O hsub =>
        CategoryTheory.MorphismProperty.Over.homMk
          (liftToUSch W O hsub)
          (AlgebraicGeometry.IsOpenImmersion.lift_fac U_open.ι (O.ι ≫ (Fgt.obj W).hom) hsub)
          trivial

    have hSubRange_of_ne : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W))
        (y : ↥(Fgt.obj W).left), s.1 y ≠ 0 →
        Set.range ((lvlOpen W s.1 y).ι ≫ (Fgt.obj W).hom).base ⊆ Set.range U_open.ι.base := by
      intro W s y hne x hx
      rcases hx with ⟨z, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      by_contra hnot
      have hz0 : s.1 z.1 = 0 := s.2 z.1 hnot
      exact hne (z.2.symm.trans hz0)

    let localSecU : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W))
        (y : ↥(Fgt.obj W).left), ↥(L_U.obj.obj (Opposite.op (openEtObj W (lvlOpen W s.1 y)))) :=
      fun W s y =>
        if h0 : s.1 y = 0 then 0
        else (L_U.obj.map (Opposite.op (liftToU W (lvlOpen W s.1 y)
          (hSubRange_of_ne W s y h0)))).hom (ξ_U.hom (s.1 y))

    have hlocalSecU_zero : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W))
        (y : ↥(Fgt.obj W).left), s.1 y = 0 → localSecU W s y = 0 := by
      intro W s y h0
      exact dite_eq_left_of_eq_true (eq_true h0)

    have hlocalSecU_ne : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W))
        (y : ↥(Fgt.obj W).left) (h0 : s.1 y ≠ 0),
        localSecU W s y =
          (L_U.obj.map (Opposite.op (liftToU W (lvlOpen W s.1 y)
            (hSubRange_of_ne W s y h0)))).hom (ξ_U.hom (s.1 y)) := by
      intro W s y h0
      exact dite_eq_right_of_eq_false (eq_false h0)

    have hΨ_inv_ex : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W)),
        ∃! t : ↥(L_U.obj.obj (Opposite.op W)),
          ∀ y : ↥(Fgt.obj W).left,
            (L_U.obj.map (Opposite.op (openEtHom W (lvlOpen W s.1 y)))).hom t =
              localSecU W s y := by
      intro W s
      apply hGlueArrows L_U W (fun y => openEtObj W (lvlOpen W s.1 y))
        (fun y => openEtHom W (lvlOpen W s.1 y))
      · intro x
        exact ⟨x, ⟨x, rfl⟩, rfl⟩
      · intro y₁ y₂ Z g₁ g₂ hg
        by_cases hEmp : IsEmpty ↥(Fgt.obj Z).left
        · exact (hSubOfEmpty L_U Z hEmp).elim _ _
        · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmp
          let z₁ := (Fgt.map g₁).left.base z₀
          let z₂ := (Fgt.map g₂).left.base z₀
          have hz_eq : z₁.1 = z₂.1 :=
            congrArg (fun u : Z ⟶ W => (Fgt.map u).left.base z₀) hg
          have hsy : s.1 y₁ = s.1 y₂ :=
            z₁.2.symm.trans ((congrArg s.1 hz_eq).trans z₂.2)
          by_cases h0₁ : s.1 y₁ = 0
          · have h0₂ : s.1 y₂ = 0 := hsy ▸ h0₁
            exact (congrArg (L_U.obj.map (Opposite.op g₁)).hom
                (hlocalSecU_zero W s y₁ h0₁)).trans
              ((map_zero (L_U.obj.map (Opposite.op g₁)).hom).trans
                ((map_zero (L_U.obj.map (Opposite.op g₂)).hom).symm.trans
                  (congrArg (L_U.obj.map (Opposite.op g₂)).hom
                    (hlocalSecU_zero W s y₂ h0₂).symm)))
          · have h0₂ : s.1 y₂ ≠ 0 := hsy ▸ h0₁
            let u₁ := liftToU W (lvlOpen W s.1 y₁) (hSubRange_of_ne W s y₁ h0₁)
            let u₂ := liftToU W (lvlOpen W s.1 y₂) (hSubRange_of_ne W s y₂ h0₂)
            have hu_eq : g₁ ≫ u₁ = g₂ ≫ u₂ := by
              apply CategoryTheory.MorphismProperty.Over.Hom.ext
              let g₁_sch : (Fgt.obj Z).left ⟶ (lvlOpen W s.1 y₁).toScheme := (Fgt.map g₁).left
              let g₂_sch : (Fgt.obj Z).left ⟶ (lvlOpen W s.1 y₂).toScheme := (Fgt.map g₂).left
              have hf₁ : liftToUSch W (lvlOpen W s.1 y₁) (hSubRange_of_ne W s y₁ h0₁) ≫ U_open.ι =
                  (lvlOpen W s.1 y₁).ι ≫ (Fgt.obj W).hom :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
              have hf₂ : liftToUSch W (lvlOpen W s.1 y₂) (hSubRange_of_ne W s y₂ h0₂) ≫ U_open.ι =
                  (lvlOpen W s.1 y₂).ι ≫ (Fgt.obj W).hom :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
              have hg_left : g₁_sch ≫ (lvlOpen W s.1 y₁).ι = g₂_sch ≫ (lvlOpen W s.1 y₂).ι :=
                congrArg (fun u : Z ⟶ W => (Fgt.map u).left) hg
              refine (CategoryTheory.cancel_mono U_open.ι).mp ?_
              change (g₁_sch ≫ liftToUSch W (lvlOpen W s.1 y₁) _) ≫ U_open.ι =
                (g₂_sch ≫ liftToUSch W (lvlOpen W s.1 y₂) _) ≫ U_open.ι
              rw [CategoryTheory.Category.assoc, hf₁, ← CategoryTheory.Category.assoc, hg_left,
                CategoryTheory.Category.assoc, ← hf₂, CategoryTheory.Category.assoc]
            let src := L_U.obj.obj (Opposite.op U_et)
            let dst := L_U.obj.obj (Opposite.op Z)
            exact (congrArg (L_U.obj.map (Opposite.op g₁)).hom
                (hlocalSecU_ne W s y₁ h0₁)).trans
              ((congrArg (fun a => (L_U.obj.map (Opposite.op g₁)).hom
                  ((L_U.obj.map (Opposite.op u₁)).hom (ξ_U.hom a))) hsy).trans
                ((congrArg (fun f : src ⟶ dst => AddCommGrpCat.Hom.hom f (ξ_U.hom (s.1 y₂)))
                  ((L_U.obj.map_comp _ _).symm.trans
                    ((congrArg L_U.obj.map (congrArg Opposite.op hu_eq)).trans
                      (L_U.obj.map_comp _ _)))).trans
                  (congrArg (L_U.obj.map (Opposite.op g₂)).hom
                    (hlocalSecU_ne W s y₂ h0₂).symm)))

    let ψ_inv_fn : ∀ (W : S.Etale),
        ↥(weilAltZeroBdrySubgroup S U_open n W) → ↥(L_U.obj.obj (Opposite.op W)) :=
      fun W s => Classical.choose (hΨ_inv_ex W s)
    have hψ_inv_spec : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W))
        (y : ↥(Fgt.obj W).left),
        (L_U.obj.map (Opposite.op (openEtHom W (lvlOpen W s.1 y)))).hom (ψ_inv_fn W s) =
          localSecU W s y :=
      fun W s => (Classical.choose_spec (hΨ_inv_ex W s)).1

    have hψ_inv_res_inU : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W))
        (O : ((Fgt.obj W).left).Opens) (a : ULift.{u} (ZMod n))
        (hsub : Set.range (O.ι ≫ (Fgt.obj W).hom).base ⊆ Set.range U_open.ι.base),
        (∀ z : ↥O.toScheme, s.1 z.1 = a) →
        (L_U.obj.map (Opposite.op (openEtHom W O))).hom (ψ_inv_fn W s) =
          (L_U.obj.map (Opposite.op (liftToU W O hsub))).hom (ξ_U.hom a) := by
      intro W s O a hsub hOa
      by_cases hEmp : IsEmpty ↥(Fgt.obj (openEtObj W O)).left
      · exact (hSubOfEmpty L_U (openEtObj W O) hEmp).elim _ _
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmp
        have hle : O ≤ lvlOpen W s.1 z₀.1 := fun x hx => (hOa ⟨x, hx⟩).trans (hOa z₀).symm
        let inc_mor : openEtObj W O ⟶ openEtObj W (lvlOpen W s.1 z₀.1) :=
          CategoryTheory.MorphismProperty.Over.homMk
            (((Fgt.obj W).left).homOfLE hle)
            (by
              change ((Fgt.obj W).left).homOfLE hle ≫ (lvlOpen W s.1 z₀.1).ι ≫ (Fgt.obj W).hom =
                O.ι ≫ (Fgt.obj W).hom
              rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι])
            trivial
        have hfac : inc_mor ≫ openEtHom W (lvlOpen W s.1 z₀.1) = openEtHom W O :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (AlgebraicGeometry.Scheme.homOfLE_ι _ hle)
        have ha : s.1 z₀.1 = a := hOa z₀
        let M_W := L_U.obj.obj (Opposite.op W)
        let M_O := L_U.obj.obj (Opposite.op (openEtObj W O))
        let M_U := L_U.obj.obj (Opposite.op U_et)
        have h1 : (L_U.obj.map (Opposite.op (openEtHom W O))).hom (ψ_inv_fn W s) =
            (L_U.obj.map (Opposite.op inc_mor)).hom (localSecU W s z₀.1) :=
          (congrArg (fun f : M_W ⟶ M_O => AddCommGrpCat.Hom.hom f (ψ_inv_fn W s))
            ((congrArg L_U.obj.map (congrArg Opposite.op hfac.symm)).trans
              (L_U.obj.map_comp _ _))).trans
            (congrArg (L_U.obj.map (Opposite.op inc_mor)).hom (hψ_inv_spec W s z₀.1))
        by_cases h0 : s.1 z₀.1 = 0
        · have ha0 : a = 0 := ha.symm.trans h0
          exact h1.trans
            ((congrArg (L_U.obj.map (Opposite.op inc_mor)).hom (hlocalSecU_zero W s z₀.1 h0)).trans
              ((map_zero _).trans
                ((map_zero (L_U.obj.map (Opposite.op (liftToU W O hsub))).hom).symm.trans
                  (congrArg (L_U.obj.map (Opposite.op (liftToU W O hsub))).hom
                    ((congrArg ξ_U.hom ha0).trans (map_zero ξ_U.hom)).symm))))
        · let u_big := liftToU W (lvlOpen W s.1 z₀.1) (hSubRange_of_ne W s z₀.1 h0)
          have hu_eq : inc_mor ≫ u_big = liftToU W O hsub := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            refine (CategoryTheory.cancel_mono U_open.ι).mp ?_
            have hf₁ : liftToUSch W (lvlOpen W s.1 z₀.1) (hSubRange_of_ne W s z₀.1 h0) ≫ U_open.ι =
                (lvlOpen W s.1 z₀.1).ι ≫ (Fgt.obj W).hom :=
              AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
            have hf₂ : liftToUSch W O hsub ≫ U_open.ι = O.ι ≫ (Fgt.obj W).hom :=
              AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
            change (((Fgt.obj W).left).homOfLE hle ≫ liftToUSch W (lvlOpen W s.1 z₀.1) _) ≫ U_open.ι =
              liftToUSch W O hsub ≫ U_open.ι
            rw [CategoryTheory.Category.assoc, hf₁, ← CategoryTheory.Category.assoc,
              AlgebraicGeometry.Scheme.homOfLE_ι, hf₂]
          exact h1.trans
            ((congrArg (L_U.obj.map (Opposite.op inc_mor)).hom (hlocalSecU_ne W s z₀.1 h0)).trans
              ((congrArg (fun b => (L_U.obj.map (Opposite.op inc_mor)).hom
                  ((L_U.obj.map (Opposite.op u_big)).hom (ξ_U.hom b))) ha).trans
                (congrArg (fun f : M_U ⟶ M_O => AddCommGrpCat.Hom.hom f (ξ_U.hom a))
                  ((L_U.obj.map_comp _ _).symm.trans
                    (congrArg L_U.obj.map (congrArg Opposite.op hu_eq))))))

    have hψ_inv_res_zero : ∀ (W : S.Etale) (s : ↥(weilAltZeroBdrySubgroup S U_open n W))
        (O : ((Fgt.obj W).left).Opens),
        (∀ z : ↥O.toScheme, s.1 z.1 = 0) →
        (L_U.obj.map (Opposite.op (openEtHom W O))).hom (ψ_inv_fn W s) = 0 := by
      intro W s O hO0
      by_cases hEmp : IsEmpty ↥(Fgt.obj (openEtObj W O)).left
      · exact (hSubOfEmpty L_U (openEtObj W O) hEmp).elim _ _
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmp
        have hle : O ≤ lvlOpen W s.1 z₀.1 := fun x hx => (hO0 ⟨x, hx⟩).trans (hO0 z₀).symm
        let inc_mor : openEtObj W O ⟶ openEtObj W (lvlOpen W s.1 z₀.1) :=
          CategoryTheory.MorphismProperty.Over.homMk
            (((Fgt.obj W).left).homOfLE hle)
            (by
              change ((Fgt.obj W).left).homOfLE hle ≫ (lvlOpen W s.1 z₀.1).ι ≫ (Fgt.obj W).hom =
                O.ι ≫ (Fgt.obj W).hom
              rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι])
            trivial
        have hfac : inc_mor ≫ openEtHom W (lvlOpen W s.1 z₀.1) = openEtHom W O :=
          CategoryTheory.MorphismProperty.Over.Hom.ext (AlgebraicGeometry.Scheme.homOfLE_ι _ hle)
        have h0 : s.1 z₀.1 = 0 := hO0 z₀
        let M_W := L_U.obj.obj (Opposite.op W)
        let M_O := L_U.obj.obj (Opposite.op (openEtObj W O))
        exact (congrArg (fun f : M_W ⟶ M_O => AddCommGrpCat.Hom.hom f (ψ_inv_fn W s))
            ((congrArg L_U.obj.map (congrArg Opposite.op hfac.symm)).trans
              (L_U.obj.map_comp _ _))).trans
          ((congrArg (L_U.obj.map (Opposite.op inc_mor)).hom
            ((hψ_inv_spec W s z₀.1).trans (hlocalSecU_zero W s z₀.1 h0))).trans
            (map_zero _))

    let Ψ_inv : 𝒦_S ⟶ L_U :=
      { hom :=
          { app := fun W_op =>
              let W := Opposite.unop W_op
              AddCommGrpCat.ofHom
                { toFun := ψ_inv_fn W
                  map_zero' := by
                    refine ((Classical.choose_spec (hΨ_inv_ex W 0)).2 0 ?_).symm
                    intro y
                    exact (map_zero _).trans (hlocalSecU_zero W 0 y rfl).symm
                  map_add' := fun s₁ s₂ => by
                    let U_pre : ((Fgt.obj W).left).Opens :=
                      (TopologicalSpace.Opens.map (Fgt.obj W).hom.base).obj U_open
                    let O_add : ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
                      fun y =>
                        if (Fgt.obj W).hom.base y ∈ (U_open : Set ↥S) then
                          (lvlOpen W s₁.1 y ⊓ lvlOpen W s₂.1 y) ⊓ U_pre
                        else
                          lvlOpen W s₁.1 y ⊓ lvlOpen W s₂.1 y
                    have hCov_add : ∀ x : ↥(Fgt.obj W).left,
                        ∃ (y : ↥(Fgt.obj W).left) (z : ↥(Fgt.obj (openEtObj W (O_add y))).left),
                          (Fgt.map (openEtHom W (O_add y))).left.base z = x := by
                      intro x
                      refine ⟨x, ⟨x, ?_⟩, rfl⟩
                      dsimp only [O_add]
                      split_ifs with hxU
                      · exact ⟨⟨rfl, rfl⟩, hxU⟩
                      · exact ⟨rfl, rfl⟩
                    let M_W := L_U.obj.obj (Opposite.op W)
                    apply (hGlueArrows L_U W (fun y => openEtObj W (O_add y))
                      (fun y => openEtHom W (O_add y)) hCov_add
                      (fun y => (L_U.obj.map (Opposite.op (openEtHom W (O_add y)))).hom
                        (ψ_inv_fn W (s₁ + s₂)))
                      (fun y₁ y₂ Z g₁ g₂ hg =>
                        congrArg (fun f : M_W ⟶ L_U.obj.obj (Opposite.op Z) =>
                          AddCommGrpCat.Hom.hom f (ψ_inv_fn W (s₁ + s₂)))
                          ((L_U.obj.map_comp _ _).symm.trans
                            ((congrArg L_U.obj.map (congrArg Opposite.op hg)).trans
                              (L_U.obj.map_comp _ _))))).unique
                    · intro y
                      rfl
                    · intro y
                      by_cases hyU : (Fgt.obj W).hom.base y ∈ (U_open : Set ↥S)
                      · have hO_eq : O_add y = (lvlOpen W s₁.1 y ⊓ lvlOpen W s₂.1 y) ⊓ U_pre := by
                          dsimp only [O_add]
                          split_ifs with h
                          · rfl
                          · exact (h hyU).elim
                        have hsub : Set.range ((O_add y).ι ≫ (Fgt.obj W).hom).base ⊆
                            Set.range U_open.ι.base := by
                          rintro _ ⟨z, rfl⟩
                          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                          let xz : ↥(Fgt.obj W).left := z.1
                          have hz : xz ∈ O_add y := z.2
                          rw [hO_eq] at hz
                          exact hz.2
                        have hc₁ : ∀ z : ↥(O_add y).toScheme, s₁.1 z.1 = s₁.1 y := by
                          intro z
                          let xz : ↥(Fgt.obj W).left := z.1
                          have hz : xz ∈ O_add y := z.2
                          rw [hO_eq] at hz
                          exact hz.1.1
                        have hc₂ : ∀ z : ↥(O_add y).toScheme, s₂.1 z.1 = s₂.1 y := by
                          intro z
                          let xz : ↥(Fgt.obj W).left := z.1
                          have hz : xz ∈ O_add y := z.2
                          rw [hO_eq] at hz
                          exact hz.1.2
                        have hsum := hψ_inv_res_inU W (s₁ + s₂) (O_add y) (s₁.1 y + s₂.1 y) hsub
                          (fun z => congrArg₂ (· + ·) (hc₁ z) (hc₂ z))
                        have h1 := hψ_inv_res_inU W s₁ (O_add y) (s₁.1 y) hsub hc₁
                        have h2 := hψ_inv_res_inU W s₂ (O_add y) (s₂.1 y) hsub hc₂
                        exact (map_add (L_U.obj.map (Opposite.op (openEtHom W (O_add y)))).hom _ _).trans
                          ((congrArg₂ (· + ·) h1 h2).trans
                            ((map_add (L_U.obj.map (Opposite.op (liftToU W (O_add y) hsub))).hom _ _).symm.trans
                              ((congrArg (L_U.obj.map (Opposite.op (liftToU W (O_add y) hsub))).hom
                                (map_add ξ_U.hom (s₁.1 y) (s₂.1 y)).symm).trans hsum.symm)))
                      · have hO_eq : O_add y = lvlOpen W s₁.1 y ⊓ lvlOpen W s₂.1 y := by
                          dsimp only [O_add]
                          split_ifs with h
                          · exact (hyU h).elim
                          · rfl
                        have hy1 : s₁.1 y = 0 := s₁.2 y hyU
                        have hy2 : s₂.1 y = 0 := s₂.2 y hyU
                        have hc₁ : ∀ z : ↥(O_add y).toScheme, s₁.1 z.1 = 0 := by
                          intro z
                          let xz : ↥(Fgt.obj W).left := z.1
                          have hz : xz ∈ O_add y := z.2
                          rw [hO_eq] at hz
                          exact hz.1.trans hy1
                        have hc₂ : ∀ z : ↥(O_add y).toScheme, s₂.1 z.1 = 0 := by
                          intro z
                          let xz : ↥(Fgt.obj W).left := z.1
                          have hz : xz ∈ O_add y := z.2
                          rw [hO_eq] at hz
                          exact hz.2.trans hy2
                        have hsum := hψ_inv_res_zero W (s₁ + s₂) (O_add y)
                          (fun z => (congrArg₂ (· + ·) (hc₁ z) (hc₂ z)).trans (add_zero 0))
                        have h1 := hψ_inv_res_zero W s₁ (O_add y) hc₁
                        have h2 := hψ_inv_res_zero W s₂ (O_add y) hc₂
                        exact (map_add (L_U.obj.map (Opposite.op (openEtHom W (O_add y)))).hom _ _).trans
                          ((congrArg₂ (· + ·) h1 h2).trans ((add_zero 0).trans hsum.symm)) }
            naturality := fun {W₁_op W₂_op} f_op => by
              let W₁ := Opposite.unop W₁_op
              let W₂ := Opposite.unop W₂_op
              let u : W₂ ⟶ W₁ := f_op.unop
              ext s
              let s₁ : ↥(weilAltZeroBdrySubgroup S U_open n W₁) := s
              change ψ_inv_fn W₂ ((𝒦_S.obj.map (Opposite.op u)).hom s₁) =
                (L_U.obj.map (Opposite.op u)).hom (ψ_inv_fn W₁ s₁)
              let s₂ : ↥(weilAltZeroBdrySubgroup S U_open n W₂) :=
                (𝒦_S.obj.map (Opposite.op u)).hom s₁
              refine ((Classical.choose_spec (hΨ_inv_ex W₂ s₂)).2 _ fun z => ?_).symm
              let y := (Fgt.map u).left.base z
              let O₂ := lvlOpen W₂ s₂.1 z
              let O₁ := lvlOpen W₁ s₁.1 y
              have hrange : Set.range (O₂.ι ≫ (Fgt.map u).left).base ⊆ Set.range O₁.ι.base := by
                rintro _ ⟨w, rfl⟩
                rw [AlgebraicGeometry.Scheme.Opens.range_ι]
                exact w.2
              let lift_sch : O₂.toScheme ⟶ O₁.toScheme :=
                AlgebraicGeometry.IsOpenImmersion.lift O₁.ι (O₂.ι ≫ (Fgt.map u).left) hrange
              have hlift_fac : lift_sch ≫ O₁.ι = O₂.ι ≫ (Fgt.map u).left :=
                AlgebraicGeometry.IsOpenImmersion.lift_fac O₁.ι (O₂.ι ≫ (Fgt.map u).left) hrange
              have hwu : (Fgt.map u).left ≫ (Fgt.obj W₁).hom = (Fgt.obj W₂).hom :=
                CategoryTheory.MorphismProperty.Over.w u
              let lift_et : openEtObj W₂ O₂ ⟶ openEtObj W₁ O₁ :=
                CategoryTheory.MorphismProperty.Over.homMk lift_sch
                  (by
                    change lift_sch ≫ O₁.ι ≫ (Fgt.obj W₁).hom = O₂.ι ≫ (Fgt.obj W₂).hom
                    rw [← CategoryTheory.Category.assoc, hlift_fac, CategoryTheory.Category.assoc, hwu])
                  trivial
              have hcomm_et : openEtHom W₂ O₂ ≫ u = lift_et ≫ openEtHom W₁ O₁ :=
                CategoryTheory.MorphismProperty.Over.Hom.ext hlift_fac.symm
              let M₁ := L_U.obj.obj (Opposite.op W₁)
              let M_O₂ := L_U.obj.obj (Opposite.op (openEtObj W₂ O₂))
              let M_U := L_U.obj.obj (Opposite.op U_et)
              have hL : (L_U.obj.map (Opposite.op (openEtHom W₂ O₂))).hom
                  ((L_U.obj.map (Opposite.op u)).hom (ψ_inv_fn W₁ s₁)) =
                  (L_U.obj.map (Opposite.op lift_et)).hom (localSecU W₁ s₁ y) :=
                (congrArg (fun g : M₁ ⟶ M_O₂ => AddCommGrpCat.Hom.hom g (ψ_inv_fn W₁ s₁))
                  ((L_U.obj.map_comp _ _).symm.trans
                    ((congrArg L_U.obj.map (congrArg Opposite.op hcomm_et)).trans
                      (L_U.obj.map_comp _ _)))).trans
                  (congrArg (L_U.obj.map (Opposite.op lift_et)).hom (hψ_inv_spec W₁ s₁ y))
              have hsy_eq : s₂.1 z = s₁.1 y := rfl
              by_cases h0 : s₁.1 y = 0
              · exact hL.trans
                  ((congrArg (L_U.obj.map (Opposite.op lift_et)).hom
                    (hlocalSecU_zero W₁ s₁ y h0)).trans
                    ((map_zero _).trans (hlocalSecU_zero W₂ s₂ z (hsy_eq.trans h0)).symm))
              · have hz_ne : s₂.1 z ≠ 0 := fun hz0 => h0 (hsy_eq.symm.trans hz0)
                let u₁ := liftToU W₁ O₁ (hSubRange_of_ne W₁ s₁ y h0)
                let u₂ := liftToU W₂ O₂ (hSubRange_of_ne W₂ s₂ z hz_ne)
                have hu_eq : lift_et ≫ u₁ = u₂ := by
                  apply CategoryTheory.MorphismProperty.Over.Hom.ext
                  refine (CategoryTheory.cancel_mono U_open.ι).mp ?_
                  have hf₁ : liftToUSch W₁ O₁ (hSubRange_of_ne W₁ s₁ y h0) ≫ U_open.ι =
                      O₁.ι ≫ (Fgt.obj W₁).hom :=
                    AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
                  have hf₂ : liftToUSch W₂ O₂ (hSubRange_of_ne W₂ s₂ z hz_ne) ≫ U_open.ι =
                      O₂.ι ≫ (Fgt.obj W₂).hom :=
                    AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
                  change (lift_sch ≫ liftToUSch W₁ O₁ _) ≫ U_open.ι = liftToUSch W₂ O₂ _ ≫ U_open.ι
                  rw [CategoryTheory.Category.assoc, hf₁, ← CategoryTheory.Category.assoc,
                    hlift_fac, CategoryTheory.Category.assoc, hwu, hf₂]
                exact hL.trans
                  ((congrArg (L_U.obj.map (Opposite.op lift_et)).hom
                    (hlocalSecU_ne W₁ s₁ y h0)).trans
                    ((congrArg (fun g : M_U ⟶ M_O₂ => AddCommGrpCat.Hom.hom g (ξ_U.hom (s₁.1 y)))
                      ((L_U.obj.map_comp _ _).symm.trans
                        (congrArg L_U.obj.map (congrArg Opposite.op hu_eq)))).trans
                      ((congrArg (fun b => (L_U.obj.map (Opposite.op u₂)).hom (ξ_U.hom b))
                        hsy_eq.symm).trans
                        (hlocalSecU_ne W₂ s₂ z hz_ne).symm))) } }

    have hΨ_hom_inv : Ψ_hom ≫ Ψ_inv = 𝟙 L_U := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (Ψ_hom ≫ Ψ_inv) =
          η_U ≫ Ψ_inv.hom.app (Opposite.op U_et) :=
        (hEquiv_comp Ψ_hom Ψ_inv).trans
          (congrArg (· ≫ Ψ_inv.hom.app (Opposite.op U_et)) (Equiv.apply_symm_apply _ _))
      rw [h1]
      ext a
      change ψ_inv_fn U_et (η_U.hom a) = ξ_U.hom a
      refine ((Classical.choose_spec (hΨ_inv_ex U_et (η_U.hom a))).2 _ fun y => ?_).symm
      have hval : (η_U.hom a).1 y = a := rfl
      by_cases ha0 : a = 0
      · exact (congrArg (L_U.obj.map _).hom
            ((congrArg ξ_U.hom ha0).trans (map_zero ξ_U.hom))).trans
          ((map_zero _).trans (hlocalSecU_zero U_et (η_U.hom a) y (hval.trans ha0)).symm)
      · have hy_ne : (η_U.hom a).1 y ≠ 0 := hval ▸ ha0
        let u_y := liftToU U_et (lvlOpen U_et (η_U.hom a).1 y) (hSubRange_of_ne U_et _ y hy_ne)
        have hu_eq : openEtHom U_et (lvlOpen U_et (η_U.hom a).1 y) = u_y := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          refine (CategoryTheory.cancel_mono U_open.ι).mp ?_
          exact (AlgebraicGeometry.IsOpenImmersion.lift_fac U_open.ι _ _).symm
        exact (congrArg (fun g => (L_U.obj.map (Opposite.op g)).hom (ξ_U.hom a)) hu_eq).trans
          (hlocalSecU_ne U_et (η_U.hom a) y hy_ne).symm

    have hΨ_inv_hom : Ψ_inv ≫ Ψ_hom = 𝟙 𝒦_S := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext W_op
      let W := Opposite.unop W_op
      ext s
      let sW : ↥(weilAltZeroBdrySubgroup S U_open n W) := s
      apply Subtype.ext
      apply LocallyConstant.ext
      intro y
      let O_y := lvlOpen W sW.1 y
      let W_y := openEtObj W O_y
      let pt_y : ↥(Fgt.obj W_y).left := ⟨y, rfl⟩
      let j_y := openEtHom W O_y
      let src := L_U.obj.obj (Opposite.op W)
      let dst := 𝒦_S.obj.obj (Opposite.op W_y)
