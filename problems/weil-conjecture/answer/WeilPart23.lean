        (ι_kum₂.hom.app (Opposite.op T_X₂)).hom ((adj_X₂.unit.app AM).hom (ULift.up a)) =
          ((shAdj₂.unit.app (weilEtaleGmPresheaf X₂.left)).app (Opposite.op T_X₂)).hom
            (Additive.ofMul ((Units.map σ₂.toMonoidHom ζ) ^ a.val))) →
      (∀ (U : X₂.left.Etale) (u : Units ↑(U.left.presheaf.obj (Opposite.op ⊤))),
        (ι_gm₂.hom.app (Opposite.op U)).hom
            (((shAdj₂.unit.app (weilEtaleGmPresheaf X₂.left)).app (Opposite.op U)).hom
