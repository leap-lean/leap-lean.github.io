    intro Y V₀ hV₀ z m hm v'
    let z_sub : ↥V₀ := z
    let D := ↑(Y.presheaf.obj (Opposite.op V₀))
    let Ry := ↑(Y.presheaf.stalk z_sub.1)
    let : Algebra D Ry := TopCat.Presheaf.algebra_section_stalk Y.presheaf z_sub
    have := hV₀.isLocalization_stalk z_sub
    let p : Ideal D := (hV₀.primeIdealOf z_sub).asIdeal
    have hp_eq_m : p = m := by
      rw [← hm]
      ext d
      change d ∈ p ↔ algebraMap D Ry d ∈ IsLocalRing.maximalIdeal Ry
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        IsLocalization.AtPrime.isUnit_to_map_iff Ry p d, Ideal.mem_primeCompl_iff, not_not]
    let r_y : Ry := (V₀.stalkIso z).hom.hom (v' : ↑(V₀.toScheme.presheaf.stalk z))
    obtain ⟨⟨a, b_sub⟩, hab⟩ := IsLocalization.surj p.primeCompl r_y
    dsimp only at hab
    have hb_not : (b_sub : D) ∉ m := by
      rw [← hp_eq_m]
      exact b_sub.2
    refine ⟨a, (b_sub : D), hb_not, ?_⟩
    let φ_z : Ry →+* ↑(V₀.toScheme.presheaf.stalk z) := (V₀.ι.stalkMap z).hom
    have h_app : φ_z (r_y * (Y.presheaf.germ V₀ z_sub.1 z_sub.2).hom (b_sub : D)) =
        φ_z ((Y.presheaf.germ V₀ z_sub.1 z_sub.2).hom a) :=
