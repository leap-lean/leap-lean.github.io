        rwa [hz₁, hz₂] at hcz_pt
      let Y_of : ↥(Fgt.obj W).left → S.Etale := fun pt => Classical.choose (hSurj pt)
      let f_of : ∀ pt : ↥(Fgt.obj W).left, Y_of pt ⟶ W :=
        fun pt => Classical.choose (Classical.choose_spec (hSurj pt))
      let y_of : ∀ pt : ↥(Fgt.obj W).left, ↥(Fgt.obj (Y_of pt)).left :=
        fun pt => Classical.choose (Classical.choose_spec (Classical.choose_spec (hSurj pt)))
      have hf_of : ∀ pt : ↥(Fgt.obj W).left,
