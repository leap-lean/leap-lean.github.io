        let P_ov := CategoryTheory.Limits.pullback m₁ m₂
        let p₁ : P_ov ⟶ (Fgt.obj Z₁).left := CategoryTheory.Limits.pullback.fst m₁ m₂
        let p₂ : P_ov ⟶ (Fgt.obj Z₂).left := CategoryTheory.Limits.pullback.snd m₁ m₂
        let Z_ov : S.Etale :=
