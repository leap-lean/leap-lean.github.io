  obtain ⟨Θ, hΘ_comm⟩ := hBlock3

  
  
  
  let X' := C''.left
  let J := X'.smallEtaleTopology
  let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let ε' := weilEtaleLocalTorsionCounit X' m V''_et
  let Ξ : CategoryTheory.Iso (weilEtaleLocalTorsionSheaf X' m V''_et) K :=
