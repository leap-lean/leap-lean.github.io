        fun f hf y => hFibEq _ f (hf_of _).1 hf _ y (hf_of _).2.2
      have hLC : IsLocallyConstant val_fn := by
        intro T_set
        have hpre : val_fn ⁻¹' T_set =
            ⋃ pt : ↥(Fgt.obj W).left,
