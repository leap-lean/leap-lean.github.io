    haveI : AlgebraicGeometry.IsOpenImmersion g₁ := by dsimp [g₁]; infer_instance
    haveI : AlgebraicGeometry.IsOpenImmersion g₂ := by dsimp [g₂]; infer_instance
    have hg₂_ι : g₂ ≫ U_proj'.ι = D₁_b.ι :=
