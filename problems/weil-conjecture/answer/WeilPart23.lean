                      rw [← hnat] } }
            naturality := fun ℱ₁ ℱ₂ φ => by
              apply CategoryTheory.Sheaf.hom_ext
              apply CategoryTheory.NatTrans.ext
              funext U_op
              exact (φ.hom.naturality (adj_site.counit.app U_op.unop).op).symm }
        counit :=
          { app := fun 𝒢 =>
              { hom :=
                  { app := fun W_op => 𝒢.obj.map (adj_site.unit.app W_op.unop).op
                    naturality := fun ⟨W₁⟩ ⟨W₂⟩ ⟨g⟩ => by
                      change 𝒢.obj.map (B.map (M_p.map g)).op ≫
                          𝒢.obj.map (adj_site.unit.app W₂).op =
                        𝒢.obj.map (adj_site.unit.app W₁).op ≫ 𝒢.obj.map g.op
                      rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp,
