              map_add' := by
                rcases U_op with ⟨U⟩
                intro (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
                      (h : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
                let O_gh : ↥U.left → U.left.Opens := fun x => O_g U g x ⊓ O_g U h x
                let W_gh : ↥U.left → C''.left.Etale := fun x =>
                  CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_gh x).ι ≫ U.hom)
                    (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
                let j_gh : ∀ x : ↥U.left, W_gh x ⟶ U :=
                  fun x => CategoryTheory.MorphismProperty.Over.homMk (O_gh x).ι rfl trivial
                have h_cov_gh : ∀ x : ↥U.left, ∃ (i : ↥U.left) (y : ↥(W_gh i).left),
