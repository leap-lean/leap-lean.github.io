    (g_shriek : weilEtaleTorsionH C'_bar.left ℓ 2 →+ weilEtaleTorsionH C_bar.left ℓ 2)
    (g_gm_shriek : (weilEtaleGmSheaf C'_bar.left).H 1 →+ (weilEtaleGmSheaf C_bar.left).H 1)
    (hκ_comm : ∀ ξ : (weilEtaleGmSheaf C'_bar.left).H 1,
