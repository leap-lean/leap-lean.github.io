                  (C.left.presheaf.stalk (genericPoint ↥C.left))).inv ≫
                (CategoryTheory.Limits.pullback.snd T_C.hom η_C).appTop).hom.toMonoidHom f)
        let Rx := ↑(C.left.presheaf.stalk x.1)
        let mx := IsLocalRing.maximalIdeal Rx
        (∃ (a b : Rx) (na nb : ℕ),
