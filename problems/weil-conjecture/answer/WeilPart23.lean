            αM_S ≫ βM_S = 𝟙 (Cℤ_S.obj AM) ∧
            βM_S ≫ αM_S = 𝟙 (U_std.obj one_S) ∧
            ∀ y : weilEtaleModuleH S ℓ q,
              θ y = ((Abelian.Ext.mk₀ ηℤ_S).comp
                (Abelian.Ext.mapExactFunctor U_std y) (Nat.zero_add q)).comp
                (Abelian.Ext.mk₀ βM_S) (Nat.add_zero q) := by
    intro S T_S hT_S θ hθ R R_mod Aℤ AM FgtMod ιM_mod ιℤ_mod
    rcases hθ with ⟨U, hU_obj, hU_map, hAdd, hLim, hColim,
      T_m, hT_m, _, _, u_unit, hu_unit, βM, hαβ, hβα, hθ_eq⟩
    have hHasSC : S.smallEtaleTopology.HasSheafCompose FgtMod :=
      ⟨fun P hP => by
        have hEq : (U.obj ⟨P, hP⟩).obj = P ⋙ FgtMod := hU_obj ⟨P, hP⟩
        exact hEq ▸ (U.obj ⟨P, hP⟩).property⟩
    letI : S.smallEtaleTopology.HasSheafCompose FgtMod := hHasSC
    let U_std := CategoryTheory.sheafCompose S.smallEtaleTopology FgtMod
    have sheaf_eq_of_obj_eq : ∀ {C : Type (u + 1)} [Category.{u} C] {J : GrothendieckTopology C}
        {A : Type (u + 1)} [Category.{u} A] {ℱ₁ ℱ₂ : Sheaf J A},
        ℱ₁.obj = ℱ₂.obj → ℱ₁ = ℱ₂ := by
      intro C _ J A _ ⟨o₁, _⟩ ⟨o₂, _⟩ h_eq
      change o₁ = o₂ at h_eq
      subst h_eq
      rfl
    have hU_eq : U = U_std := by
      have hmap := @hU_map
      rcases U with ⟨oU, mU, iU, cU⟩
      have ho : oU = U_std.obj := funext fun ℱ => sheaf_eq_of_obj_eq (hU_obj ℱ)
      subst ho
      refine CategoryTheory.Functor.ext (fun _ => rfl) (fun ℱ₁ ℱ₂ u => ?_)
      rw [eqToHom_refl, eqToHom_refl, Category.id_comp, Category.comp_id]
      exact CategoryTheory.Sheaf.hom_ext (NatTrans.ext (funext fun W => eq_of_heq (hmap u W)))
    subst hU_eq
    have hu_eq : u_unit =
        FgtMod.map ((CategoryTheory.constantSheafAdj S.smallEtaleTopology
          (ModuleCat.{u, u} R) hT_m).unit.app R_mod) := eq_of_heq hu_unit
    subst hu_eq
    let e_m : T_m ⟶ T_S := hT_S.from T_m
    let one_S := weilEtaleModuleUnit S ℓ
    let adjR_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT_S
    let adjR_m := CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT_m
    let adjℤ_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
    let adjℤ_m := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_m
    have halign : ∀ {A : AddCommGrpCat.{u}} (ι₀ : A ⟶ FgtMod.obj R_mod),
        (adjℤ_m.homEquiv A (U_std.obj one_S)).symm (ι₀ ≫ FgtMod.map (adjR_m.unit.app R_mod)) =
          (adjℤ_S.homEquiv A (U_std.obj one_S)).symm (ι₀ ≫ FgtMod.map (adjR_S.unit.app R_mod)) := by
      intro A ι₀
      have hunR : adjR_m.unit.app R_mod = adjR_S.unit.app R_mod ≫ one_S.obj.map e_m.op :=
        step1_constAdj_unit_mod S.smallEtaleTopology hT_S hT_m e_m R_mod
      have hmapR : (ι₀ ≫ FgtMod.map (adjR_m.unit.app R_mod) :
          A ⟶ (U_std.obj one_S).obj.obj (Opposite.op T_m)) =
          (ι₀ ≫ FgtMod.map (adjR_S.unit.app R_mod)) ≫ (U_std.obj one_S).obj.map e_m.op := by
        change ι₀ ≫ FgtMod.map (adjR_m.unit.app R_mod) =
          (ι₀ ≫ FgtMod.map (adjR_S.unit.app R_mod)) ≫ FgtMod.map (one_S.obj.map e_m.op)
        rw [hunR, FgtMod.map_comp, ← Category.assoc]
      exact (congrArg (adjℤ_m.homEquiv A (U_std.obj one_S)).symm hmapR).trans
        (step1_constAdj_homEquiv_symm S.smallEtaleTopology hT_S hT_m e_m A (U_std.obj one_S) _)
    refine ⟨hHasSC, hAdd, hLim, hColim, βM, ?_, ?_, ?_⟩
    · exact (congrArg (· ≫ βM) (halign ιM_mod)).symm.trans hαβ
    · exact (congrArg (βM ≫ ·) (halign ιM_mod)).symm.trans hβα
    · intro y
      refine (hθ_eq y).trans ?_
      change (((Abelian.Ext.mk₀ _).comp
          (Abelian.Ext.mapExactFunctor U_std y) (Nat.zero_add q)).comp
          (Abelian.Ext.mk₀ βM) (Nat.add_zero q)) = _
      exact congrArg
        (fun f => ((Abelian.Ext.mk₀ f).comp
          (Abelian.Ext.mapExactFunctor U_std y) (Nat.zero_add q)).comp
          (Abelian.Ext.mk₀ βM) (Nat.add_zero q))
        (halign ιℤ_mod)

  
  
  
  have step4a_adjSB : ∀
