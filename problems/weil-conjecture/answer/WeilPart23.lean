      Fin.addCases (motive := fun _ => MvPolynomial (Fin ((s₀ + 1) + ν + d)) k) q₁ f_lift₁
    let M_pt : Matrix (Fin (n₁ + 1)) (Fin (n₁ + 1)) R₁ :=
      Matrix.of fun a b : Fin (n₁ + 1) =>
        φ₁ (MvPolynomial.pderiv (col b)
          (Fin.snoc (α := fun _ => MvPolynomial (Fin ((s₀ + 1) + ν + d)) k) H_base f_pt a))
    let M_prod : Matrix (Fin (n₁ + 1)) (Fin (n₁ + 1)) R₁ :=
      Matrix.of fun a b : Fin (n₁ + 1) =>
        φ₁ (MvPolynomial.pderiv (col b)
          (Fin.snoc (α := fun _ => MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
            H_base (U_poly * f_pt) a))
    have hπ_fpt : π (φ₁ f_pt) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hfpt_mem
    have hMat_upd :
        π.mapMatrix M_prod =
          (π.mapMatrix M_pt).updateRow (Fin.last n₁)
            (π (φ₁ U_poly) • (π.mapMatrix M_pt (Fin.last n₁))) := by
      ext a b
      refine Fin.lastCases ?_ (fun i₀ => ?_) a
      · rw [Matrix.updateRow_self, Pi.smul_apply, smul_eq_mul]
        simp only [M_prod, M_pt, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
          Fin.snoc_last, MvPolynomial.pderiv_mul, map_add, map_mul, hπ_fpt,
          mul_zero, zero_add]
      · rw [Matrix.updateRow_ne (Fin.castSucc_ne_last i₀)]
        simp only [M_prod, M_pt, RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply,
          Fin.snoc_castSucc]
    have hπ_det : π M_prod.det = π (φ₁ U_poly * M_pt.det) := by
      rw [RingHom.map_det, hMat_upd, Matrix.det_updateRow_smul,
        Matrix.updateRow_eq_self, ← RingHom.map_det, ← map_mul]
    have hU_notMem : φ₁ U_poly ∉ 𝔭 := by
      intro hMem
      exact (Ideal.IsPrime.ne_top ‹𝔭.IsPrime›)
        (Ideal.eq_top_of_isUnit_mem 𝔭 hMem hUnit_U)
    have hProd_notMem : φ₁ U_poly * M_pt.det ∉ 𝔭 :=
      Ideal.IsPrime.mul_notMem ‹𝔭.IsPrime› hU_notMem hDet_pt
    intro hMem_prod
    apply hProd_notMem
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    rw [← hπ_det]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hMem_prod
  exact ⟨φ₁, q₁, f_lift₁, hSurj₁, hφ₁_C, hKer₁, hf_lift₁, hDet_q₁, hDet_qf₁, hScale₁⟩

theorem weil_pointed_veronese_chart_overlap_refinement (k : Type u) [Field k]
    (N' : ℕ)
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : Quiver.Hom X (weilProjectiveSpaceOver k (N' + 1)))
    (hClX : AlgebraicGeometry.IsClosedImmersion ι_X.left)
    (α₀ : Fin (N' + 1 + 1))
    (V₀ : X.left.Opens)
    (hAffV₀ : AlgebraicGeometry.IsAffineOpen V₀)
    (hV₀α : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k) :=
        MvPolynomial.gradedAlgebra
      V₀ ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k) (MvPolynomial.X α₀)))
    (κ₀ : k →+* ↑(X.left.presheaf.obj (Opposite.op V₀)))
    (hκ₀ : V₀.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀) = V₀.ι ≫ X.hom)
    (x : ↥X.left) (hxV₀ : x ∈ V₀)
    (β₀ : Fin (N' + 1))
    (hXβ₀ : (MvPolynomial.X β₀.succ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k 1)
    (hpos : 0 < 1)
    (hx_Dβ₀ : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k) :=
        MvPolynomial.gradedAlgebra
      ι_X.left.base x ∈ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k) (MvPolynomial.X β₀.succ))
    (hSurj_ev :
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
      letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      let D_β₀ := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X β₀.succ)
      let ρ_X := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ) hXβ₀ hpos).hom ≫
        ι_X.left.app D_β₀).hom
      Function.Surjective
        (MvPolynomial.eval₂Hom
          (ρ_X.comp
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
              (Submonoid.powers (MvPolynomial.X β₀.succ))).comp (algebraMap k ↥(𝒜_N 0))))
          (fun m : Fin N' =>
            ρ_X (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
                ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, ⟨1, pow_one _⟩⟩)))) :
    let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
    letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
    ∃ (g₀ : ↑(X.left.presheaf.obj (Opposite.op V₀)))
      (hAffW : AlgebraicGeometry.IsAffineOpen (X.left.basicOpen g₀))
      (_hxW : x ∈ X.left.basicOpen g₀)
      (hWα : X.left.basicOpen g₀ ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀)))
      (x'_coord : Fin N' → ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen g₀))))
      (P_h : MvPolynomial (Fin N') k)
      (u_rat : ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen g₀)))),
      (∀ (z : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α₀))
         (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
         (hpos' : 0 < 1),
        algebraMap ↑(X.left.presheaf.obj (Opposite.op V₀))
          ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen g₀)))
          (((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀) hXα hpos').hom ≫
            ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀))
              V₀ hV₀α).hom z) =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀) hXα hpos').hom ≫
            ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀))
              (X.left.basicOpen g₀) hWα).hom z) ∧
      (∀ (κ₁ : k →+* ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen g₀)))),
        κ₁ = (algebraMap ↑(X.left.presheaf.obj (Opposite.op V₀))
          ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen g₀)))).comp κ₀ →
        ((X.left.basicOpen g₀).toSpecΓ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₁) =
          (X.left.basicOpen g₀).ι ≫ X.hom) ∧
        IsUnit (MvPolynomial.eval₂ κ₁ x'_coord P_h) ∧
        (∀ r : ↑(X.left.presheaf.obj (Opposite.op (X.left.basicOpen g₀))),
          ∃ (e : ℕ) (A : MvPolynomial (Fin N') k),
            r * (MvPolynomial.eval₂ κ₁ x'_coord P_h) ^ e =
              MvPolynomial.eval₂ κ₁ x'_coord A) ∧
        IsUnit u_rat ∧
        (∀ (c' : Fin (N' + 1) → k)
           (hFc' : (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ) ∈ 𝒜_N 1)
           (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
           (hpos' : 0 < 1),
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀) hXα hpos').hom ≫
            ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀))
              (X.left.basicOpen g₀) hWα).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ, hFc'⟩,
                ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) =
            u_rat * (κ₁ (c' β₀) +
              ∑ m : Fin N', κ₁ (c' (β₀.succAbove m)) * x'_coord m)) ∧
        (∀ (y : ↥(X.left.basicOpen g₀)) (c' : Fin (N' + 1) → k),
          ι_X.left.base y.1 ∈ weilProjHyperplaneSet k (N' + 1)
            (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ) →
          κ₁ (c' β₀) + ∑ m : Fin N', κ₁ (c' (β₀.succAbove m)) * x'_coord m ∈
            (hAffW.primeIdealOf y).asIdeal)) ∧
      (∀ (y : ↥(X.left.basicOpen g₀)) (G : MvPolynomial (Fin (N' + 1 + 1)) k)
         (hG : G ∈ 𝒜_N 1)
         (hXα : (MvPolynomial.X α₀ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
         (hpos' : 0 < 1),
        ι_X.left.base y.1 ∈ weilProjHyperplaneSet k (N' + 1) G →
        ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀) hXα hpos').hom ≫
          ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀))
            (X.left.basicOpen g₀) hWα).hom
          (HomogeneousLocalization.mk
            ⟨1, ⟨G, hG⟩, ⟨MvPolynomial.X α₀, hXα⟩, ⟨1, pow_one _⟩⟩) ∈
          (hAffW.primeIdealOf y).asIdeal) :=
by
  classical
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
  let : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  let f_X : X.left ⟶ AlgebraicGeometry.Proj 𝒜_N := ι_X.left
  have : AlgebraicGeometry.IsClosedImmersion f_X := hClX
  have hf_w :
      f_X ≫ (AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))) = X.hom :=
    CategoryTheory.Over.w ι_X

  
  let D_α₀ : (AlgebraicGeometry.Proj 𝒜_N).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀)
  let D_β₀ : (AlgebraicGeometry.Proj 𝒜_N).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X β₀.succ)
  let O_α₀ : X.left.Opens := (TopologicalSpace.Opens.map f_X.base).obj D_α₀
  let O_β₀ : X.left.Opens := (TopologicalSpace.Opens.map f_X.base).obj D_β₀
  have hAff_Dβ₀ : AlgebraicGeometry.IsAffineOpen D_β₀ :=
    AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_N (MvPolynomial.X β₀.succ) hXβ₀ hpos
  have hAffOβ : AlgebraicGeometry.IsAffineOpen O_β₀ :=
    AlgebraicGeometry.IsAffineHom.isAffine_preimage (f := f_X) D_β₀ hAff_Dβ₀
  obtain ⟨g₀, h_β₀, h_open, hxW⟩ :=
    AlgebraicGeometry.exists_basicOpen_le_affine_inter hAffV₀ hAffOβ x ⟨hxV₀, hx_Dβ₀⟩
  let W : X.left.Opens := X.left.basicOpen g₀
  let W₁ : X.left.Opens := X.left.basicOpen h_β₀
  have hAffW : AlgebraicGeometry.IsAffineOpen W := hAffV₀.basicOpen g₀
  have hWα : W ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj D_α₀ :=
    (X.left.basicOpen_le g₀).trans hV₀α
  have hV₀α_f : V₀ ≤ O_α₀ := hV₀α
  have hWα_f : W ≤ O_α₀ := hWα
  have hWβ : W ≤ O_β₀ := h_open.le.trans (X.left.basicOpen_le h_β₀)

  let ρ_X : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X β₀.succ) →+*
      ↑(X.left.presheaf.obj (Opposite.op O_β₀)) :=
    ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ) hXβ₀ hpos).hom ≫
      f_X.app D_β₀).hom
  let c_hom_β : k →+* HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X β₀.succ) :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜_N
      (Submonoid.powers (MvPolynomial.X β₀.succ))).comp (algebraMap k ↥(𝒜_N 0))
  let ev_β₀ : MvPolynomial (Fin N') k →+* ↑(X.left.presheaf.obj (Opposite.op O_β₀)) :=
    MvPolynomial.eval₂Hom (ρ_X.comp c_hom_β)
      (fun m : Fin N' =>
        ρ_X (HomogeneousLocalization.mk
          ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
            ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, Submonoid.mem_powers (MvPolynomial.X β₀.succ)⟩))
  have hSurj_ev' : Function.Surjective ev_β₀ := hSurj_ev
  obtain ⟨P_h, hPh_eq⟩ := hSurj_ev' h_β₀

  have : IsLocalization.Away h_β₀ ↑(X.left.presheaf.obj (Opposite.op W₁)) :=
    hAffOβ.isLocalization_basicOpen h_β₀
  let res_Wβ : ↑(X.left.presheaf.obj (Opposite.op O_β₀)) →+*
      ↑(X.left.presheaf.obj (Opposite.op W)) :=
    (X.left.presheaf.map (CategoryTheory.homOfLE hWβ).op).hom
  let res_map : ↑(X.left.presheaf.obj (Opposite.op W₁)) →+*
      ↑(X.left.presheaf.obj (Opposite.op W)) :=
    (X.left.presheaf.map (CategoryTheory.homOfLE h_open.le).op).hom
  let res_inv : ↑(X.left.presheaf.obj (Opposite.op W)) →+*
      ↑(X.left.presheaf.obj (Opposite.op W₁)) :=
    (X.left.presheaf.map (CategoryTheory.homOfLE h_open.ge).op).hom
  have hres_id : ∀ r : ↑(X.left.presheaf.obj (Opposite.op W)), res_map (res_inv r) = r := by
    intro r
    have h_id_op :
        (CategoryTheory.homOfLE h_open.ge).op ≫ (CategoryTheory.homOfLE h_open.le).op =
          𝟙 (Opposite.op W) :=
      Subsingleton.elim _ _
    change (X.left.presheaf.map (CategoryTheory.homOfLE h_open.ge).op ≫
      X.left.presheaf.map (CategoryTheory.homOfLE h_open.le).op).hom r = r
    rw [← CategoryTheory.Functor.map_comp, h_id_op, CategoryTheory.Functor.map_id]
    rfl
  have hres_fac : ∀ a : ↑(X.left.presheaf.obj (Opposite.op O_β₀)),
      res_Wβ a = res_map (algebraMap ↑(X.left.presheaf.obj (Opposite.op O_β₀))
        ↑(X.left.presheaf.obj (Opposite.op W₁)) a) := by
    intro a
    change (X.left.presheaf.map (CategoryTheory.homOfLE hWβ).op).hom a =
      (X.left.presheaf.map (CategoryTheory.homOfLE (X.left.basicOpen_le h_β₀)).op ≫
        X.left.presheaf.map (CategoryTheory.homOfLE h_open.le).op).hom a
    rw [← CategoryTheory.Functor.map_comp]
    rfl
  have hUnit_Ph_res : IsUnit (res_Wβ (ev_β₀ P_h)) := by
    rw [hPh_eq, hres_fac]
    exact (IsLocalization.Away.algebraMap_isUnit (S := ↑(X.left.presheaf.obj (Opposite.op W₁)))
      h_β₀).map res_map
  have hSurj_Ph_res : ∀ r : ↑(X.left.presheaf.obj (Opposite.op W)),
      ∃ (e : ℕ) (A : MvPolynomial (Fin N') k),
        r * (res_Wβ (ev_β₀ P_h)) ^ e = res_Wβ (ev_β₀ A) := by
    intro r
    obtain ⟨⟨y₀, ⟨_, e, rfl⟩⟩, hy₀⟩ :=
      IsLocalization.surj (Submonoid.powers h_β₀) (res_inv r)
    obtain ⟨A, hA⟩ := hSurj_ev' y₀
    refine ⟨e, A, ?_⟩
    have h_ap := congrArg res_map hy₀
    simp only [map_mul, map_pow] at h_ap
    rw [hres_id r, ← hres_fac, ← hres_fac, ← hPh_eq, ← hA] at h_ap
    exact h_ap

  
  have hDehom_pt : ∀ (c' : Fin (N' + 1) → k)
      (hFc' : (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ) ∈ 𝒜_N 1),
      (HomogeneousLocalization.mk
        ⟨1, ⟨∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ, hFc'⟩,
          ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, Submonoid.mem_powers (MvPolynomial.X β₀.succ)⟩ :
        HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X β₀.succ)) =
        c_hom_β (c' β₀) +
          ∑ m : Fin N',
            c_hom_β (c' (β₀.succAbove m)) *
              HomogeneousLocalization.mk
                ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
                  ⟨MvPolynomial.X β₀.succ, hXβ₀⟩,
                  Submonoid.mem_powers (MvPolynomial.X β₀.succ)⟩ := by
    intro c' hFc'
    let g_den : MvPolynomial (Fin (N' + 1 + 1)) k := MvPolynomial.X β₀.succ
    let S_g : Submonoid (MvPolynomial (Fin (N' + 1 + 1)) k) := Submonoid.powers g_den
    have hc_val : ∀ r : k, (c_hom_β r).val = Localization.mk (MvPolynomial.C r) 1 := by
      intro r
      change (HomogeneousLocalization.fromZeroRingHom 𝒜_N S_g ((algebraMap k ↥(𝒜_N 0)) r)).val =
        Localization.mk (MvPolynomial.C r) 1
      have ha : (((algebraMap k ↥(𝒜_N 0)) r) : MvPolynomial (Fin (N' + 1 + 1)) k) =
          MvPolynomial.C r := by
        rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul]
        change r • (1 : MvPolynomial (Fin (N' + 1 + 1)) k) = MvPolynomial.C r
        rw [Algebra.smul_def, mul_one, MvPolynomial.algebraMap_eq]
      change (HomogeneousLocalization.mk ⟨0, (algebraMap k ↥(𝒜_N 0)) r, 1, S_g.one_mem⟩).val = _
      rw [HomogeneousLocalization.val_mk, ha]
      rfl
    let ξ : Fin (N' + 1) → HomogeneousLocalization.Away 𝒜_N g_den := fun β =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X β.succ, MvPolynomial.isHomogeneous_X k β.succ⟩,
          ⟨g_den, hXβ₀⟩, Submonoid.mem_powers g_den⟩
    have hξ_β₀ : ξ β₀ = 1 := by
      apply HomogeneousLocalization.val_injective S_g
      rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_one]
      exact Localization.mk_self (⟨g_den, Submonoid.mem_powers g_den⟩ : S_g)
    have h_split :
        (∑ β : Fin (N' + 1), c_hom_β (c' β) * ξ β) =
          c_hom_β (c' β₀) + ∑ m : Fin N', c_hom_β (c' (β₀.succAbove m)) * ξ (β₀.succAbove m) := by
      rw [Fin.sum_univ_succAbove (fun β : Fin (N' + 1) => c_hom_β (c' β) * ξ β) β₀,
        hξ_β₀, mul_one]
    rw [← h_split]
    apply HomogeneousLocalization.val_injective S_g
    have h_val_sum : ∀ (s : Finset (Fin (N' + 1)))
        (u : Fin (N' + 1) → HomogeneousLocalization.Away 𝒜_N g_den),
        (∑ j ∈ s, u j).val = ∑ j ∈ s, (u j).val := by
      intro s u
      induction s using Finset.induction_on with
      | empty => simp [HomogeneousLocalization.val_zero]
      | insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha, HomogeneousLocalization.val_add, ih]
    have h_mk_sum : ∀ (s : Finset (Fin (N' + 1)))
        (p : Fin (N' + 1) → MvPolynomial (Fin (N' + 1 + 1)) k) (d : S_g),
        (∑ j ∈ s, Localization.mk (p j) d) = Localization.mk (∑ j ∈ s, p j) d := by
      intro s p d
      induction s using Finset.induction_on with
      | empty => simp [Localization.mk_zero]
      | insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha, ih, Localization.add_mk_self]
    rw [HomogeneousLocalization.val_mk, h_val_sum]
    have h_term : ∀ β : Fin (N' + 1),
        (c_hom_β (c' β) * ξ β).val =
          Localization.mk (MvPolynomial.C (c' β) * MvPolynomial.X β.succ)
            (⟨g_den, Submonoid.mem_powers g_den⟩ : S_g) := by
      intro β
      rw [HomogeneousLocalization.val_mul, hc_val, HomogeneousLocalization.val_mk,
        Localization.mk_mul]
      exact congrArg (Localization.mk _) (Subtype.ext (one_mul g_den))
    simp_rw [h_term]
    rw [h_mk_sum]

  have hXα₀ : (MvPolynomial.X α₀ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1 :=
    MvPolynomial.isHomogeneous_X k α₀
  let f_den : MvPolynomial (Fin (N' + 1 + 1)) k := MvPolynomial.X α₀
  let g_den : MvPolynomial (Fin (N' + 1 + 1)) k := MvPolynomial.X β₀.succ
  let ι₁ := HomogeneousLocalization.awayMap 𝒜_N hXβ₀ (rfl : f_den * g_den = f_den * g_den)
  let ι₂ := HomogeneousLocalization.awayMap 𝒜_N hXα₀
    (mul_comm f_den g_den : f_den * g_den = g_den * f_den)
  have h_mk_away : ∀ {d_den : MvPolynomial (Fin (N' + 1 + 1)) k} (hd : d_den ∈ 𝒜_N 1)
      (a : MvPolynomial (Fin (N' + 1 + 1)) k) (ha : a ∈ 𝒜_N 1),
      (HomogeneousLocalization.mk
        ⟨1, ⟨a, ha⟩, ⟨d_den, hd⟩, Submonoid.mem_powers d_den⟩ :
        HomogeneousLocalization.Away 𝒜_N d_den) =
      HomogeneousLocalization.Away.mk 𝒜_N hd 1 a (by simpa only [one_smul] using ha) := by
    intro d_den hd a ha
    apply HomogeneousLocalization.val_injective (Submonoid.powers d_den)
    rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.Away.val_mk]
    exact congrArg (Localization.mk a) (Subtype.ext (pow_one d_den).symm)
  have hUnit_alg :
      ι₁ (HomogeneousLocalization.mk ⟨1, ⟨g_den, hXβ₀⟩, ⟨f_den, hXα₀⟩, Submonoid.mem_powers f_den⟩) *
        ι₂ (HomogeneousLocalization.mk ⟨1, ⟨f_den, hXα₀⟩, ⟨g_den, hXβ₀⟩, Submonoid.mem_powers g_den⟩) =
        1 := by
    apply HomogeneousLocalization.val_injective (Submonoid.powers (f_den * g_den))
    rw [h_mk_away hXα₀ g_den hXβ₀, h_mk_away hXβ₀ f_den hXα₀,
      HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
      HomogeneousLocalization.val_mul, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul, HomogeneousLocalization.val_one]
    set s₁ : Submonoid.powers (f_den * g_den) := ⟨(f_den * g_den) ^ 1, ⟨1, rfl⟩⟩
    have hnum : (g_den * g_den ^ 1) * (f_den * f_den ^ 1) = ((s₁ * s₁ : Submonoid.powers (f_den * g_den)) :
        MvPolynomial (Fin (N' + 1 + 1)) k) := by
      simp only [s₁, Submonoid.coe_mul, pow_one]
      ring
    change Localization.mk ((g_den * g_den ^ 1) * (f_den * f_den ^ 1)) (s₁ * s₁) = 1
    rw [hnum]
    exact Localization.mk_self (s₁ * s₁)
  have hMul_alg : ∀ (G : MvPolynomial (Fin (N' + 1 + 1)) k) (hG : G ∈ 𝒜_N 1),
      ι₁ (HomogeneousLocalization.mk ⟨1, ⟨G, hG⟩, ⟨f_den, hXα₀⟩, Submonoid.mem_powers f_den⟩) =
        ι₁ (HomogeneousLocalization.mk ⟨1, ⟨g_den, hXβ₀⟩, ⟨f_den, hXα₀⟩, Submonoid.mem_powers f_den⟩) *
          ι₂ (HomogeneousLocalization.mk ⟨1, ⟨G, hG⟩, ⟨g_den, hXβ₀⟩, Submonoid.mem_powers g_den⟩) := by
    intro G hG
    apply HomogeneousLocalization.val_injective (Submonoid.powers (f_den * g_den))
    rw [h_mk_away hXα₀ G hG, h_mk_away hXα₀ g_den hXβ₀, h_mk_away hXβ₀ G hG,
      HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
      HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
      HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, Localization.mk_mul]
    set s₁ : Submonoid.powers (f_den * g_den) := ⟨(f_den * g_den) ^ 1, ⟨1, rfl⟩⟩
    change Localization.mk (G * g_den ^ 1) s₁ =
      Localization.mk ((g_den * g_den ^ 1) * (G * f_den ^ 1)) (s₁ * s₁)
    rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [s₁, Submonoid.coe_one, Submonoid.coe_mul, pow_one]
    ring

  
  have hSpec_sq : ∀ (γ : Fin (N' + 1 + 1))
      (hWγ : W ≤ (TopologicalSpace.Opens.map f_X.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ))),
      W.toSpecΓ ≫
        AlgebraicGeometry.Spec.map
          (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X γ) ≫
            f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)) W hWγ) =
        f_X.resLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)) W hWγ ≫
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (MvPolynomial.X γ) := by
    intro γ hWγ
    rw [AlgebraicGeometry.Spec.map_comp,
      AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE_assoc]
    rfl

  have hκ_agree : ∀ (γ : Fin (N' + 1 + 1))
      (hXγ : (MvPolynomial.X γ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
      (hWγ : W ≤ (TopologicalSpace.Opens.map f_X.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)))
      (κ_W : k →+* ↑(X.left.presheaf.obj (Opposite.op W))),
      W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_W) = W.ι ≫ X.hom →
      κ_W = ((AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X γ) ≫
        f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)) W hWγ).hom).comp
          ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
            (Submonoid.powers (MvPolynomial.X γ))).comp (algebraMap k ↥(𝒜_N 0))) := by
    intro γ hXγ hWγ κ_W hκ_W
    let D_γ := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)
    let ψ_γ := AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X γ) ≫ f_X.appLE D_γ W hWγ
    let c_hom_γ := (HomogeneousLocalization.fromZeroRingHom 𝒜_N
      (Submonoid.powers (MvPolynomial.X γ))).comp (algebraMap k ↥(𝒜_N 0))
    have h_rhs :
        W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_γ.hom.comp c_hom_γ)) =
          W.ι ≫ X.hom := by
      have h_hom_eq :
          CommRingCat.ofHom (ψ_γ.hom.comp c_hom_γ) =
            CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)) ≫
              CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜_N
                (Submonoid.powers (MvPolynomial.X γ))) ≫ ψ_γ := rfl
      rw [h_hom_eq, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
      calc W.toSpecΓ ≫
            ((AlgebraicGeometry.Spec.map ψ_γ ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X γ))))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))))
          = (W.toSpecΓ ≫ AlgebraicGeometry.Spec.map ψ_γ) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X γ)))) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
              simp only [CategoryTheory.Category.assoc]
        _ = f_X.resLE D_γ W hWγ ≫
              AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (MvPolynomial.X γ) ≫
              (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X γ) hXγ zero_lt_one ≫
                AlgebraicGeometry.Proj.toSpecZero 𝒜_N) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
              rw [hSpec_sq γ hWγ,
                ← AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (MvPolynomial.X γ) hXγ zero_lt_one]
              simp only [CategoryTheory.Category.assoc]
              rfl
        _ = f_X.resLE D_γ W hWγ ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X γ) hXγ zero_lt_one).hom ≫
              ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X γ) hXγ zero_lt_one).inv ≫
                D_γ.ι) ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0))) := by
              rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_N (MvPolynomial.X γ) hXγ zero_lt_one,
                ← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (MvPolynomial.X γ) hXγ zero_lt_one]
              simp only [CategoryTheory.Category.assoc]
              rfl
        _ = (f_X.resLE D_γ W hWγ ≫ D_γ.ι) ≫
              (AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))) := by
              simp only [CategoryTheory.Iso.hom_inv_id_assoc, CategoryTheory.Category.assoc]
        _ = W.ι ≫ X.hom := by
              rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι, CategoryTheory.Category.assoc, hf_w]
    have : CategoryTheory.IsIso W.toSpecΓ := by
      rw [← hAffW.isoSpec_hom]
      infer_instance
    have h_eq_spec :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ_W) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_γ.hom.comp c_hom_γ)) :=
      (CategoryTheory.cancel_epi W.toSpecΓ).mp (hκ_W.trans h_rhs.symm)
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective h_eq_spec)

  have hHyp_mem : ∀ (γ : Fin (N' + 1 + 1))
      (hXγ : (MvPolynomial.X γ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
      (hWγ : W ≤ (TopologicalSpace.Opens.map f_X.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)))
      (y : ↥W)
      (G : MvPolynomial (Fin (N' + 1 + 1)) k)
      (hG : G ∈ 𝒜_N 1),
      f_X.base y.1 ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_N G →
      (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X γ) ≫
        f_X.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)) W hWγ).hom
        (HomogeneousLocalization.mk
          ⟨1, ⟨G, hG⟩, ⟨MvPolynomial.X γ, hXγ⟩, Submonoid.mem_powers (MvPolynomial.X γ)⟩) ∈
        (hAffW.primeIdealOf y).asIdeal := by
    intro γ hXγ hWγ y G hG hy_not
    let D_γ := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X γ)
    let ψ_γ := AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X γ) ≫ f_X.appLE D_γ W hWγ
    let t : HomogeneousLocalization.NumDenSameDeg 𝒜_N (Submonoid.powers (MvPolynomial.X γ)) :=
      ⟨1, ⟨G, hG⟩, ⟨MvPolynomial.X γ, hXγ⟩, Submonoid.mem_powers (MvPolynomial.X γ)⟩
    let u : ↥D_γ := (f_X.resLE D_γ W hWγ).base y
    have hu_val : u.1 = f_X.base y.1 := by
      rw [← AlgebraicGeometry.Scheme.Opens.ι_apply D_γ u]
      change (f_X.resLE D_γ W hWγ ≫ D_γ.ι).base y = f_X.base y.1
      rw [AlgebraicGeometry.Scheme.Hom.resLE_comp_ι]
      rfl
    have hu_not_pre :
        u ∉ (TopologicalSpace.Opens.map
          (AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec 𝒜_N (MvPolynomial.X γ)).base).obj
            (PrimeSpectrum.basicOpen (HomogeneousLocalization.mk t)) := by
      rw [AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec_preimage_basicOpen 𝒜_N t]
      change u.1 ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_N G
      rwa [hu_val]
    have h_pt_eq :
        ((AlgebraicGeometry.ProjectiveSpectrum.Proj.toSpec 𝒜_N (MvPolynomial.X γ)).base u) =
          (AlgebraicGeometry.Spec.map ψ_γ).base (hAffW.primeIdealOf y) := by
      change ((f_X.resLE D_γ W hWγ ≫
        AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_N (MvPolynomial.X γ)).base y) = _
      rw [← hSpec_sq γ hWγ]
      change (AlgebraicGeometry.Spec.map ψ_γ).base (W.toSpecΓ.base y) = _
      rw [← hAffW.isoSpec_hom]
      rfl
    have h_not_bo :
        (AlgebraicGeometry.Spec.map ψ_γ).base (hAffW.primeIdealOf y) ∉
          PrimeSpectrum.basicOpen (HomogeneousLocalization.mk t) := by
      rw [← h_pt_eq]
      exact hu_not_pre
    change PrimeSpectrum.comap ψ_γ.hom (hAffW.primeIdealOf y) ∉
      PrimeSpectrum.basicOpen (HomogeneousLocalization.mk t) at h_not_bo
    rw [PrimeSpectrum.mem_basicOpen, not_not] at h_not_bo
    exact h_not_bo

  let D₁₂ : (AlgebraicGeometry.Proj 𝒜_N).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜_N (f_den * g_den)
  have hW₁₂ : W ≤ (TopologicalSpace.Opens.map f_X.base).obj D₁₂ := by
    intro z hz
    change f_X.base z ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (f_den * g_den)
    rw [AlgebraicGeometry.Proj.basicOpen_mul]
    exact ⟨hWα_f hz, hWβ hz⟩
  let ψ_α := AlgebraicGeometry.Proj.awayToSection 𝒜_N f_den ≫ f_X.appLE D_α₀ W hWα_f
  let ψ_β := AlgebraicGeometry.Proj.awayToSection 𝒜_N g_den ≫ f_X.appLE D_β₀ W hWβ
  let ψ₁₂_mor := AlgebraicGeometry.Proj.awayToSection 𝒜_N (f_den * g_den) ≫ f_X.appLE D₁₂ W hW₁₂
  let ψ₁₂ := ψ₁₂_mor.hom
  have hψ₁₂_1 : ∀ z₁ : HomogeneousLocalization.Away 𝒜_N f_den,
      ψ_α.hom z₁ = ψ₁₂ (ι₁ z₁) := by
    intro z₁
    have h_mor : CommRingCat.ofHom ι₁ ≫ ψ₁₂_mor = ψ_α := by
      dsimp [ψ₁₂_mor, ψ_α]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜_N hXβ₀ (rfl : f_den * g_den = f_den * g_den),
        CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.map_appLE]
    exact (congrArg (fun φ => φ.hom z₁) h_mor).symm
  have hψ₁₂_2 : ∀ z₂ : HomogeneousLocalization.Away 𝒜_N g_den,
      ψ_β.hom z₂ = ψ₁₂ (ι₂ z₂) := by
    intro z₂
    have h_mor : CommRingCat.ofHom ι₂ ≫ ψ₁₂_mor = ψ_β := by
      dsimp [ψ₁₂_mor, ψ_β]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayMap_awayToSection 𝒜_N hXα₀
          (mul_comm f_den g_den : f_den * g_den = g_den * f_den),
        CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.map_appLE]
    exact (congrArg (fun φ => φ.hom z₂) h_mor).symm

  
  let x'_coord : Fin N' → ↑(X.left.presheaf.obj (Opposite.op W)) := fun m =>
    ψ_β.hom (HomogeneousLocalization.mk
      ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
        ⟨g_den, hXβ₀⟩, Submonoid.mem_powers g_den⟩)
  let u_rat : ↑(X.left.presheaf.obj (Opposite.op W)) :=
    ψ_α.hom (HomogeneousLocalization.mk ⟨1, ⟨g_den, hXβ₀⟩, ⟨f_den, hXα₀⟩, Submonoid.mem_powers f_den⟩)

  refine ⟨g₀, hAffW, hxW, hWα, x'_coord, P_h, u_rat, ?_, ?_, ?_⟩
  · 
    intro z hXα hpos'
    rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_N (MvPolynomial.X α₀) hXα hpos']
    change ((AlgebraicGeometry.Proj.awayToSection 𝒜_N f_den ≫ f_X.appLE D_α₀ V₀ hV₀α_f) ≫
      X.left.presheaf.map (CategoryTheory.homOfLE (X.left.basicOpen_le g₀)).op).hom z =
      (AlgebraicGeometry.Proj.awayToSection 𝒜_N f_den ≫ f_X.appLE D_α₀ W hWα_f).hom z
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.Hom.appLE_map]
  · 
    intro κ₁ hκ₁_eq
    have hSpec_κ₁ : W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₁) = W.ι ≫ X.hom := by
      rw [hκ₁_eq]
      have h_hom :
          CommRingCat.ofHom ((algebraMap ↑(X.left.presheaf.obj (Opposite.op V₀))
            ↑(X.left.presheaf.obj (Opposite.op W))).comp κ₀) =
          CommRingCat.ofHom κ₀ ≫
            X.left.presheaf.map (CategoryTheory.homOfLE (X.left.basicOpen_le g₀)).op := rfl
      rw [h_hom, AlgebraicGeometry.Spec.map_comp, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_presheaf_map,
        CategoryTheory.Category.assoc, hκ₀, AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
    have hκ₁_β : κ₁ = ψ_β.hom.comp c_hom_β :=
      hκ_agree β₀.succ hXβ₀ hWβ κ₁ hSpec_κ₁
    have hres_ρ : res_Wβ.comp ρ_X = ψ_β.hom := by
      change ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N g_den hXβ₀ hpos).hom ≫
        f_X.app D_β₀ ≫ X.left.presheaf.map (CategoryTheory.homOfLE hWβ).op).hom = ψ_β.hom
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_N g_den hXβ₀ hpos,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE, AlgebraicGeometry.Scheme.Hom.appLE_map]
    have hev_eq : MvPolynomial.eval₂Hom κ₁ x'_coord = res_Wβ.comp ev_β₀ := by
      apply MvPolynomial.ringHom_ext'
      · ext r
        simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C, RingHom.comp_apply,
          ev_β₀, hκ₁_β]
        exact (RingHom.congr_fun hres_ρ (c_hom_β r)).symm
      · intro m
        simp only [MvPolynomial.eval₂Hom_X', RingHom.comp_apply, ev_β₀]
        exact (RingHom.congr_fun hres_ρ _).symm
    have heval₂_eq : ∀ A : MvPolynomial (Fin N') k,
        MvPolynomial.eval₂ κ₁ x'_coord A = res_Wβ (ev_β₀ A) :=
      fun A => RingHom.congr_fun hev_eq A
    have hUnit_urat : IsUnit u_rat := by
      let u_inv : ↑(X.left.presheaf.obj (Opposite.op W)) :=
        ψ_β.hom (HomogeneousLocalization.mk ⟨1, ⟨f_den, hXα₀⟩, ⟨g_den, hXβ₀⟩, Submonoid.mem_powers g_den⟩)
      refine IsUnit.of_mul_eq_one u_inv ?_
      dsimp [u_rat, u_inv]
      rw [hψ₁₂_1, hψ₁₂_2, ← map_mul, hUnit_alg, map_one]
    have hL_eq : ∀ (c' : Fin (N' + 1) → k)
        (hFc' : (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ) ∈ 𝒜_N 1),
        ψ_β.hom (HomogeneousLocalization.mk
          ⟨1, ⟨∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ, hFc'⟩,
            ⟨g_den, hXβ₀⟩, Submonoid.mem_powers g_den⟩) =
          κ₁ (c' β₀) + ∑ m : Fin N', κ₁ (c' (β₀.succAbove m)) * x'_coord m := by
      intro c' hFc'
      rw [hDehom_pt c' hFc', map_add, map_sum, hκ₁_β]
      congr 1
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [map_mul]
      rfl
    refine ⟨hSpec_κ₁, ?_, ?_, hUnit_urat, ?_, ?_⟩
    · 
      rw [heval₂_eq]
      exact hUnit_Ph_res
    · 
      intro r
      obtain ⟨e, A, hA⟩ := hSurj_Ph_res r
      refine ⟨e, A, ?_⟩
      rwa [heval₂_eq, heval₂_eq]
    · 
      intro c' hFc' hXα hpos'
      rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_N (MvPolynomial.X α₀) hXα hpos']
      change ψ_α.hom (HomogeneousLocalization.mk
        ⟨1, ⟨∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ, hFc'⟩,
          ⟨f_den, hXα₀⟩, Submonoid.mem_powers f_den⟩) = _
      rw [hψ₁₂_1, hMul_alg _ hFc', map_mul, ← hψ₁₂_1, ← hψ₁₂_2, hL_eq c' hFc']
    · 
      intro y c' hy_mem
      have hFc' : (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ) ∈ 𝒜_N 1 :=
        Submodule.sum_mem _ fun β _ => MvPolynomial.isHomogeneous_C_mul_X (c' β) β.succ
      rw [← hL_eq c' hFc']
      exact hHyp_mem β₀.succ hXβ₀ hWβ y _ hFc' hy_mem
  · 
    intro y G hG hXα hpos' hy_mem
    rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom 𝒜_N (MvPolynomial.X α₀) hXα hpos']
    exact hHyp_mem α₀ hXα hWα_f y G hG hy_mem

theorem weil_pointed_veronese_transversalSlice_eliminant (k : Type u) [Field k]
    (N' d ν : ℕ) (hd : 1 ≤ d)
    (q_star : ↥(weilProjectiveSpaceOver k (N' + 1)).left)
    (hq_0 : letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k) :=
        MvPolynomial.gradedAlgebra
      q_star ∈ AlgebraicGeometry.Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k) (MvPolynomial.X 0))
    (hq_pt : ∀ β : Fin (N' + 1),
      q_star ∈ weilProjHyperplaneSet k (N' + 1) (MvPolynomial.X β.succ))
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_X : Quiver.Hom X (weilProjectiveSpaceOver k (N' + 1)))
    (hClX : AlgebraicGeometry.IsClosedImmersion ι_X.left)
    (U : X.left.Opens)
    (F_prev : Fin ν → MvPolynomial (Fin (N' + 1 + 1)) k)
    (hSlice : IsTransversalLinearSlice k (N' + 1) X ι_X U d ν F_prev)
    (hVeronese :
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
      letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      ∀ x : ↥X.left, x ∈ U → ι_X.left.base x ≠ q_star →
        ∃ (β₀ : Fin (N' + 1))
          (hXβ₀ : (MvPolynomial.X β₀.succ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
          (hpos : 0 < 1),
          let D_β₀ := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X β₀.succ)
          let ρ_X := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ) hXβ₀ hpos).hom ≫
            ι_X.left.app D_β₀).hom
          ι_X.left.base x ∈ D_β₀ ∧
          Function.Surjective
            (MvPolynomial.eval₂Hom
              (ρ_X.comp
                ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
                  (Submonoid.powers (MvPolynomial.X β₀.succ))).comp (algebraMap k ↥(𝒜_N 0))))
              (fun m : Fin N' =>
                ρ_X (HomogeneousLocalization.mk
                  ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
                    ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, ⟨1, pow_one _⟩⟩)))) :
    ∃ Δ_trans : MvPolynomial (Fin (N' + 1)) k,
      Δ_trans ≠ 0 ∧
      ∀ c' : Fin (N' + 1) → k,
        MvPolynomial.eval c' Δ_trans ≠ 0 →
        IsTransversalLinearSlice k (N' + 1) X ι_X U (d - 1) (ν + 1)
          (Fin.snoc F_prev
            (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ)) :=
by
  classical
  let _ := hq_0
  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
  let : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
  let F_pt : (Fin (N' + 1) → k) → MvPolynomial (Fin (N' + 1 + 1)) k :=
    fun c' => ∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ
  have hFpt_hom : ∀ c' : Fin (N' + 1) → k, F_pt c' ∈ 𝒜_N 1 := by
    intro c'
    exact Submodule.sum_mem _ fun β _ => MvPolynomial.isHomogeneous_C_mul_X (c' β) β.succ
  have hSchemePkg :=
    weil_bertini_scheme_chart_cover_and_advance k (N' + 1) X ι_X hClX U d ν F_prev hSlice
  rcases hSchemePkg.1 with ⟨m_charts, α₀, V, hAffV, hVU, hVα, s, φ, q, f_lift,
    x_coord, P_h, hCov, hCharts⟩
  let hAdvance := hSchemePkg.2
  let K : Set ↥X.left :=
    {x : ↥X.left | x ∈ U ∧ ∀ j : Fin ν, ι_X.left.base x ∈ weilProjHyperplaneSet k (N' + 1) (F_prev j)}
  let K0 : Set ↥X.left := {x : ↥X.left | x ∈ K ∧ ι_X.left.base x ≠ q_star}
  let WitnessAt (c' : Fin (N' + 1) → k) (x : ↥X.left) : Prop :=
    ∃ (α₀_w : Fin (N' + 1 + 1)) (V_w : X.left.Opens)
      (hAffV_w : AlgebraicGeometry.IsAffineOpen V_w) (hxV_w : x ∈ V_w) (_ : V_w ≤ U)
      (hVα_w : letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
        V_w ≤ (TopologicalSpace.Opens.map ι_X.left.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀_w)))
      (s_w : ℕ)
      (φ_w : MvPolynomial (Fin (s_w + ν + d)) k →+* ↑(X.left.presheaf.obj (Opposite.op V_w)))
      (q_w : Fin s_w → MvPolynomial (Fin (s_w + ν + d)) k)
      (f_lift_w : Fin ν → MvPolynomial (Fin (s_w + ν + d)) k)
      (f_new_lift_w : MvPolynomial (Fin (s_w + ν + d)) k)
      (γ₀_w : Fin d),
      letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      Function.Surjective φ_w ∧
      (V_w.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_w) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = V_w.ι ≫ X.hom) ∧
      RingHom.ker φ_w = Ideal.span (Set.range q_w) ∧
      (∀ (j : Fin ν)
          (hFj : F_prev j ∈ 𝒜_N 1)
          (hXα : (MvPolynomial.X α₀_w : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
          (hpos : 0 < 1),
        φ_w (f_lift_w j) =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀_w) hXα hpos).hom ≫
            ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀_w))
              V_w hVα_w).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨F_prev j, hFj⟩, ⟨MvPolynomial.X α₀_w, hXα⟩, ⟨1, pow_one _⟩⟩)) ∧
      (∀ (hFn : F_pt c' ∈ 𝒜_N 1)
          (hXα : (MvPolynomial.X α₀_w : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
          (hpos : 0 < 1),
        φ_w f_new_lift_w =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀_w) hXα hpos).hom ≫
            ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α₀_w))
              V_w hVα_w).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨F_pt c', hFn⟩, ⟨MvPolynomial.X α₀_w, hXα⟩, ⟨1, pow_one _⟩⟩)) ∧
      IsUnit (Matrix.det (Matrix.of fun a b : Fin s_w =>
        φ_w (MvPolynomial.pderiv (Fin.castAdd d (Fin.castAdd ν b)) (q_w a)))) ∧
      Matrix.det (Matrix.of fun a b : Fin (s_w + ν + 1) =>
        φ_w (MvPolynomial.pderiv
          (Fin.snoc (α := fun _ => Fin (s_w + ν + d)) (Fin.castAdd d) (Fin.natAdd (s_w + ν) γ₀_w) b)
          (Fin.snoc (α := fun _ => MvPolynomial (Fin (s_w + ν + d)) k)
            (Fin.addCases (motive := fun _ => MvPolynomial (Fin (s_w + ν + d)) k) q_w f_lift_w)
            f_new_lift_w a))) ∉
        (hAffV_w.primeIdealOf ⟨x, hxV_w⟩).asIdeal

  
  have hBasePkg : ∃ Δ_star : MvPolynomial (Fin (N' + 1)) k,
      Δ_star ≠ 0 ∧
      ∀ (c' : Fin (N' + 1) → k) (x : ↥X.left),
        MvPolynomial.eval c' Δ_star ≠ 0 →
        x ∈ K →
        ι_X.left.base x = q_star →
        WitnessAt c' x := by
    by_cases hex_star : ∃ x_star : ↥X.left, x_star ∈ K ∧ ι_X.left.base x_star = q_star
    · rcases hex_star with ⟨x_star, hx_star_K, hx_star_eq⟩
      obtain ⟨i_star, hx_star_V⟩ := hCov x_star hx_star_K.1 hx_star_K.2
      obtain ⟨hSurj_s, hSpec_s, hKer_s, hf_lift_s, hDet_q_s, hDet_qf_s,
        hUnit_Ph_s, hLoc_Ph_s, hLin_s, hHyp_s⟩ := hCharts i_star
      have hα_star : α₀ i_star = 0 := by
        have hq_in : q_star ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N
            (MvPolynomial.X (α₀ i_star)) :=
          hx_star_eq ▸ hVα i_star hx_star_V
        rcases Fin.eq_zero_or_eq_succ (α₀ i_star) with h0 | ⟨β, hβ⟩
        · exact h0
        · rw [hβ] at hq_in
          exact False.elim (hq_pt β hq_in)
      let R_star := ↑(X.left.presheaf.obj (Opposite.op (V i_star)))
      obtain ⟨Ψ_star, v_star, U_star, hΨ_star, hUv_star, hSchur_star⟩ :=
        weil_bertini_tangent_frame_and_schur_det k (N' + 1) (s i_star) ν d R_star
          (φ i_star) hSurj_s (q i_star) hKer_s (f_lift i_star) hDet_qf_s
          (α₀ i_star) (x_coord i_star) (P_h i_star) hUnit_Ph_s hLoc_Ph_s
      let 𝔭_star : Ideal R_star :=
        ((hAffV i_star).primeIdealOf ⟨x_star, hx_star_V⟩).asIdeal
      haveI : 𝔭_star.IsPrime :=
        ((hAffV i_star).primeIdealOf ⟨x_star, hx_star_V⟩).isPrime
      have hf_mem_star : ∀ j : Fin ν, (φ i_star) (f_lift i_star j) ∈ 𝔭_star := by
        intro j
        have hFj : F_prev j ∈ 𝒜_N 1 := hSlice.1 j
        have hXα : (MvPolynomial.X (α₀ i_star) : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1 :=
          MvPolynomial.isHomogeneous_X k (α₀ i_star)
        rw [hf_lift_s j hFj hXα zero_lt_one]
        exact hHyp_s ⟨x_star, hx_star_V⟩ (F_prev j) hFj hXα zero_lt_one (hx_star_K.2 j)
      obtain ⟨Δ_star, γ₀_star, hΔ_star_ne, hΔ_star_good⟩ :=
        weil_pointed_tangent_frame_single_prime_eliminant k N' d ν hd R_star
          ((φ i_star).comp MvPolynomial.C) (fun j => (φ i_star) (f_lift i_star j))
          v_star U_star hUv_star 𝔭_star hf_mem_star
      refine ⟨Δ_star, hΔ_star_ne, fun c' x hEval hxK hx_eq => ?_⟩
      have hx_eq_star : x = x_star := by
        haveI : AlgebraicGeometry.IsClosedImmersion ι_X.left := hClX
        exact (AlgebraicGeometry.Scheme.Hom.isClosedEmbedding ι_X.left).injective
          (hx_eq.trans hx_star_eq.symm)
      subst hx_eq_star
      let c : Fin (N' + 1 + 1) → k := Fin.cons 0 c'
      have hFc_eq :
          (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a) = F_pt c' := by
        rw [Fin.sum_univ_succ]
        simp [c, F_pt]
      let f_new_lift_star : MvPolynomial (Fin (s i_star + ν + d)) k :=
        MvPolynomial.C (c (α₀ i_star)) +
          ∑ m : Fin (N' + 1), MvPolynomial.C (c ((α₀ i_star).succAbove m)) * Ψ_star m
      refine ⟨α₀ i_star, V i_star, hAffV i_star, hx_star_V, hVU i_star, hVα i_star,
        s i_star, φ i_star, q i_star, f_lift i_star, f_new_lift_star, γ₀_star,
        hSurj_s, hSpec_s, hKer_s, hf_lift_s, ?_, hDet_q_s, ?_⟩
      · intro hFn hXα hpos
        have hFc : (∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a) ∈ 𝒜_N 1 :=
          hFc_eq.symm ▸ hFn
        have hmk_eq :
            (HomogeneousLocalization.mk
              ⟨1, ⟨∑ a : Fin (N' + 1 + 1), MvPolynomial.C (c a) * MvPolynomial.X a, hFc⟩,
                ⟨MvPolynomial.X (α₀ i_star), hXα⟩, ⟨1, pow_one _⟩⟩ :
              HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X (α₀ i_star))) =
            (HomogeneousLocalization.mk
              ⟨1, ⟨F_pt c', hFn⟩, ⟨MvPolynomial.X (α₀ i_star), hXα⟩, ⟨1, pow_one _⟩⟩ :
              HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X (α₀ i_star))) := by
          apply HomogeneousLocalization.val_injective
          simp only [HomogeneousLocalization.val_mk, hFc_eq]
        rw [← hmk_eq, hLin_s c hFc hXα hpos]
        dsimp [f_new_lift_star]
        rw [map_add, map_sum]
        congr 1
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [map_mul, hΨ_star m]
      · change Matrix.det _ ∉ 𝔭_star
        rw [hSchur_star c γ₀_star]
        have hDet_notMem :
            Matrix.det (Matrix.of fun a b : Fin (s i_star + ν) =>
              (φ i_star) (MvPolynomial.pderiv (Fin.castAdd d b)
                (Fin.addCases (q i_star) (f_lift i_star) a))) ∉ 𝔭_star := by
          intro hMem
          exact ( Ideal.IsPrime.ne_top ‹𝔭_star.IsPrime› )
            (Ideal.eq_top_of_isUnit_mem 𝔭_star hMem hDet_qf_s)
        have hSum_eq :
            (∑ m : Fin (N' + 1),
              (φ i_star) (MvPolynomial.C (c ((α₀ i_star).succAbove m))) * v_star m γ₀_star) =
            ∑ m : Fin (N' + 1),
              ((φ i_star).comp MvPolynomial.C) (c' m) * v_star m γ₀_star := by
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [hα_star, Fin.succAbove_zero]
          simp [c]
        rw [hSum_eq]
        exact Ideal.IsPrime.mul_notMem ‹𝔭_star.IsPrime› hDet_notMem (hΔ_star_good c' hEval)
    · refine ⟨1, one_ne_zero, fun c' x _ hxK hx_eq => ?_⟩
      exact False.elim (hex_star ⟨x, hxK, hx_eq⟩)

  obtain ⟨Δ_star, hΔ_star_ne, hStar_good⟩ := hBasePkg

  
  have hComp_K0 : IsCompact K0 := by
    have hK0_eq :
        K0 = ⋃ i : Fin m_charts, (V i).ι.base '' ((V i).ι.base ⁻¹' K0) := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_image, Set.mem_preimage]
      refine ⟨fun hx => ?_, ?_⟩
      · obtain ⟨i, hxi⟩ := hCov x hx.1.1 hx.1.2
        refine ⟨i, ⟨x, hxi⟩, ?_, (V i).ι_apply ⟨x, hxi⟩⟩
        rw [(V i).ι_apply ⟨x, hxi⟩]
        exact hx
      · rintro ⟨i, y, hy, rfl⟩
        exact hy
    rw [hK0_eq]
    refine isCompact_iUnion fun i => ?_
    let R_i := ↑(X.left.presheaf.obj (Opposite.op (V i)))
    haveI : IsNoetherianRing R_i :=
      isNoetherianRing_of_surjective (MvPolynomial (Fin (s i + ν + d)) k) R_i
        (φ i) (hCharts i).1
    have hNoeth : TopologicalSpace.NoetherianSpace
        ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (V i)))) := by
      change TopologicalSpace.NoetherianSpace (PrimeSpectrum R_i)
      exact PrimeSpectrum.instNoetherianSpace R_i
    let S_i : Set ↥(V i).toScheme := (V i).ι.base ⁻¹' K0
    let T_i : Set ↥(AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (V i)))) :=
      ((hAffV i).isoSpec.hom).base '' S_i
    have hComp_Ti : IsCompact T_i := @TopologicalSpace.NoetherianSpace.isCompact _ _ hNoeth T_i
    let g_inv : AlgebraicGeometry.Spec (X.left.presheaf.obj (Opposite.op (V i))) ⟶ X.left :=
      (hAffV i).isoSpec.inv ≫ (V i).ι
    have hImg_eq : g_inv.base '' T_i = (V i).ι.base '' S_i := by
      rw [show T_i = ((hAffV i).isoSpec.hom).base '' S_i from rfl, ← Set.image_comp]
      congr 1
      ext p
      change (((hAffV i).isoSpec.hom ≫ (hAffV i).isoSpec.inv ≫ (V i).ι).base p) =
        (V i).ι.base p
      rw [CategoryTheory.Iso.hom_inv_id_assoc]
    rw [← hImg_eq]
    exact hComp_Ti.image g_inv.continuous

  
  have hPointwise : ∀ z : ↥K0,
      ∃ (W_z : X.left.Opens) (Δ_z : MvPolynomial (Fin (N' + 1)) k),
        z.1 ∈ W_z ∧
        Δ_z ≠ 0 ∧
        ∀ (c' : Fin (N' + 1) → k) (y : ↥X.left),
          MvPolynomial.eval c' Δ_z ≠ 0 →
          y ∈ W_z →
          y ∈ K →
          ι_X.left.base y ∈ weilProjHyperplaneSet k (N' + 1) (F_pt c') →
          WitnessAt c' y := by
    intro z
    obtain ⟨i₀, hzV₀⟩ := hCov z.1 z.2.1.1 z.2.1.2
    obtain ⟨hSurj₀, hSpec₀, hKer₀, hf_lift₀, hDet_q₀, hDet_qf₀, _, _, _, _⟩ := hCharts i₀
    obtain ⟨β₀, hXβ₀, hpos_β, hz_Dβ₀, hSurj_ev⟩ := hVeronese z.1 z.2.1.1 z.2.2
    let R₀ := ↑(X.left.presheaf.obj (Opposite.op (V i₀)))
    let κ₀ : k →+* R₀ := (φ i₀).comp MvPolynomial.C
    have hκ₀ :
        (V i₀).toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom κ₀) =
          (V i₀).ι ≫ X.hom := by
      dsimp [κ₀]
      rw [AlgebraicGeometry.Spec.map_comp]
      simpa only [CategoryTheory.Category.assoc] using hSpec₀
    obtain ⟨g₀, hAffW, hzW, hWα, x'_coord, P_h, u_rat, hResα, hκ₁_pkg, hHypα⟩ :=
      weil_pointed_veronese_chart_overlap_refinement k N' X ι_X hClX (α₀ i₀)
        (V i₀) (hAffV i₀) (hVα i₀) κ₀ hκ₀ z.1 hzV₀ β₀ hXβ₀ hpos_β hz_Dβ₀ hSurj_ev
    let W := X.left.basicOpen g₀
    let R₁ := ↑(X.left.presheaf.obj (Opposite.op W))
    have hWU : W ≤ U := (X.left.basicOpen_le g₀).trans (hVU i₀)
    haveI : IsLocalization.Away g₀ R₁ := (hAffV i₀).isLocalization_basicOpen g₀
    obtain ⟨φ₁, q₁, f_lift₁, hSurj₁, hC₁, hKer₁, hf_lift₁, hDet_q₁, hDet_qf₁, hScale₁⟩ :=
      weil_mvPolynomial_normalized_away_localization k (s i₀) ν d R₀ R₁ g₀
        (φ i₀) hSurj₀ (q i₀) hKer₀ (f_lift i₀) hDet_q₀ hDet_qf₀
    let κ₁ : k →+* R₁ := φ₁.comp MvPolynomial.C
    obtain ⟨hSpec_κ₁, hUnit_Ph₁, hLoc_Ph₁, hUnit_urat, hOverlap_urat, hHyp_pt⟩ :=
      hκ₁_pkg κ₁ hC₁
    have hSpec₁ :
        W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) = W.ι ≫ X.hom := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      exact hSpec_κ₁
    have hf_lift₁_sec : ∀ (j : Fin ν)
        (hFj : F_prev j ∈ 𝒜_N 1)
        (hXα : (MvPolynomial.X (α₀ i₀) : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
        (hpos : 0 < 1),
        φ₁ (f_lift₁ j) =
          ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X (α₀ i₀)) hXα hpos).hom ≫
            ι_X.left.appLE (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X (α₀ i₀)))
              W hWα).hom
            (HomogeneousLocalization.mk
              ⟨1, ⟨F_prev j, hFj⟩, ⟨MvPolynomial.X (α₀ i₀), hXα⟩, ⟨1, pow_one _⟩⟩) := by
      intro j hFj hXα hpos
      rw [hf_lift₁ j, hf_lift₀ j hFj hXα hpos]
      exact hResα _ hXα hpos
    obtain ⟨Ψ₁, v₁, U_bar₁, hΨ₁, hUv₁, hSchur₁⟩ :=
      weil_bertini_tangent_frame_and_schur_det k N' (s i₀ + 1) ν d R₁
        φ₁ hSurj₁ q₁ hKer₁ f_lift₁ hDet_qf₁ β₀ x'_coord P_h hUnit_Ph₁ hLoc_Ph₁
    let I_sl : Ideal R₁ := Ideal.span (Set.range (fun j : Fin ν => φ₁ (f_lift₁ j)))
    let S := R₁ ⧸ I_sl
    let π_S : R₁ →+* S := Ideal.Quotient.mk I_sl
    let ψ : MvPolynomial (Fin (((s i₀ + 1) + ν) + d)) k →+* S := π_S.comp φ₁
    have hSurj_ψ : Function.Surjective ψ := Ideal.Quotient.mk_surjective.comp hSurj₁
    let H : Fin ((s i₀ + 1) + ν) → MvPolynomial (Fin (((s i₀ + 1) + ν) + d)) k :=
      Fin.addCases q₁ f_lift₁
    have hH_zero : ∀ a : Fin ((s i₀ + 1) + ν), ψ (H a) = 0 := by
      refine Fin.addCases (fun a_q => ?_) (fun j => ?_)
      · dsimp [ψ, H]
        rw [Fin.addCases_left]
        have hker : q₁ a_q ∈ RingHom.ker φ₁ := by
          rw [hKer₁]
          exact Ideal.subset_span ⟨a_q, rfl⟩
        rw [RingHom.mem_ker.mp hker, map_zero]
      · dsimp [ψ, H]
        rw [Fin.addCases_right]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
    have hDet_H : IsUnit (Matrix.det (Matrix.of fun a b : Fin ((s i₀ + 1) + ν) =>
        ψ (MvPolynomial.pderiv (Fin.castAdd d b) (H a)))) := by
      have hMat_eq :
          (Matrix.of fun a b : Fin ((s i₀ + 1) + ν) =>
            ψ (MvPolynomial.pderiv (Fin.castAdd d b) (H a))) =
          π_S.mapMatrix (Matrix.of fun a b : Fin ((s i₀ + 1) + ν) =>
            φ₁ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q₁ f_lift₁ a))) := by
        ext a b
        rfl
      rw [hMat_eq, ← RingHom.map_det]
      exact hDet_qf₁.map π_S
    obtain ⟨Δ_z, hΔ_z_ne, hΔ_z_good⟩ :=
      weil_bertini_trdeg_bad_incidence_eliminant k N' ((s i₀ + 1) + ν) d S
        ψ hSurj_ψ H hH_zero hDet_H β₀ (fun m => π_S (x'_coord m)) (v₁.map π_S) U_bar₁ hUv₁
    obtain ⟨U_poly, hU_poly⟩ := hSurj₁ u_rat
    have hUnit_Upoly : IsUnit (φ₁ U_poly) := hU_poly.symm ▸ hUnit_urat
    refine ⟨W, Δ_z, hzW, hΔ_z_ne, fun c' y hEval_z hyW hyK hyNew => ?_⟩
    let y_pt : ↥W := ⟨y, hyW⟩
    let 𝔭_y : Ideal R₁ := (hAffW.primeIdealOf y_pt).asIdeal
    haveI : 𝔭_y.IsPrime := (hAffW.primeIdealOf y_pt).isPrime
    have hI_le_p : I_sl ≤ 𝔭_y := by
      rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      have hFj : F_prev j ∈ 𝒜_N 1 := hSlice.1 j
      have hXα : (MvPolynomial.X (α₀ i₀) : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1 :=
        MvPolynomial.isHomogeneous_X k (α₀ i₀)
      change φ₁ (f_lift₁ j) ∈ 𝔭_y
      rw [hf_lift₁_sec j hFj hXα zero_lt_one]
      exact hHypα y_pt (F_prev j) hFj hXα zero_lt_one (hyK.2 j)
    have hKer_π_le : RingHom.ker π_S ≤ 𝔭_y := by
      rw [Ideal.mk_ker]
      exact hI_le_p
    let 𝔮_ideal : Ideal S := Ideal.map π_S 𝔭_y
    have h𝔮_prime : 𝔮_ideal.IsPrime :=
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective hKer_π_le
    have hcomap_𝔮 : Ideal.comap π_S 𝔮_ideal = 𝔭_y := by
      dsimp [𝔮_ideal]
      rw [Ideal.comap_map_of_surjective' π_S Ideal.Quotient.mk_surjective,
        sup_eq_left.mpr hKer_π_le]
    let 𝔮_y : PrimeSpectrum S := ⟨𝔮_ideal, h𝔮_prime⟩
    let f_pt : MvPolynomial (Fin ((s i₀ + 1) + ν + d)) k :=
      MvPolynomial.C (c' β₀) +
        ∑ m : Fin N', MvPolynomial.C (c' (β₀.succAbove m)) * Ψ₁ m
    have hφ₁_fpt :
        φ₁ f_pt =
          κ₁ (c' β₀) + ∑ m : Fin N', κ₁ (c' (β₀.succAbove m)) * x'_coord m := by
      dsimp [f_pt, κ₁]
      rw [map_add, map_sum]
      congr 1
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [map_mul, hΨ₁ m]
    have hfpt_mem_p : φ₁ f_pt ∈ 𝔭_y := by
      rw [hφ₁_fpt]
      exact hHyp_pt y_pt c' hyNew
    have hfpt_mem_q :
        ψ (MvPolynomial.C (c' β₀)) +
          ∑ m : Fin N', ψ (MvPolynomial.C (c' (β₀.succAbove m))) * π_S (x'_coord m) ∈
          𝔮_y.asIdeal := by
      have hπ_eq :
          π_S (φ₁ f_pt) =
            ψ (MvPolynomial.C (c' β₀)) +
              ∑ m : Fin N', ψ (MvPolynomial.C (c' (β₀.succAbove m))) * π_S (x'_coord m) := by
        simp only [hφ₁_fpt, ψ, κ₁, RingHom.comp_apply, map_add, map_sum, map_mul]
      rw [← hπ_eq]
      change π_S (φ₁ f_pt) ∈ 𝔮_ideal
      rw [← Ideal.mem_comap, hcomap_𝔮]
      exact hfpt_mem_p
    obtain ⟨γ₀, hγ₀_notMem_q⟩ := hΔ_z_good c' 𝔮_y hEval_z hfpt_mem_q
    have hSum_notMem_p :
        ∑ m : Fin N', φ₁ (MvPolynomial.C (c' (β₀.succAbove m))) * v₁ m γ₀ ∉ 𝔭_y := by
      intro hMem_p
      apply hγ₀_notMem_q
      have hπ_sum :
          π_S (∑ m : Fin N', φ₁ (MvPolynomial.C (c' (β₀.succAbove m))) * v₁ m γ₀) =
            ∑ m : Fin N', ψ (MvPolynomial.C (c' (β₀.succAbove m))) * (v₁.map π_S) m γ₀ := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [map_mul]
        rfl
      rw [← hπ_sum]
      change π_S _ ∈ 𝔮_ideal
      rw [← Ideal.mem_comap, hcomap_𝔮]
      exact hMem_p
    have hDet_qf₁_notMem :
        Matrix.det (Matrix.of fun a b : Fin ((s i₀ + 1) + ν) =>
          φ₁ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q₁ f_lift₁ a))) ∉ 𝔭_y := by
      intro hMem
      exact (Ideal.IsPrime.ne_top ‹𝔭_y.IsPrime›)
        (Ideal.eq_top_of_isUnit_mem 𝔭_y hMem hDet_qf₁)
    have hDet_fpt_notMem :
        Matrix.det (Matrix.of fun a b : Fin ((s i₀ + 1) + ν + 1) =>
          φ₁ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin ((s i₀ + 1) + ν + d))
              (Fin.castAdd d) (Fin.natAdd ((s i₀ + 1) + ν) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin ((s i₀ + 1) + ν + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin ((s i₀ + 1) + ν + d)) k)
                q₁ f_lift₁)
              f_pt a))) ∉ 𝔭_y := by
      rw [hSchur₁ c' γ₀]
      exact Ideal.IsPrime.mul_notMem ‹𝔭_y.IsPrime› hDet_qf₁_notMem hSum_notMem_p
    let f_new_lift : MvPolynomial (Fin ((s i₀ + 1) + ν + d)) k := U_poly * f_pt
    have hDet_prod_notMem :
        Matrix.det (Matrix.of fun a b : Fin ((s i₀ + 1) + ν + 1) =>
          φ₁ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin ((s i₀ + 1) + ν + d))
              (Fin.castAdd d) (Fin.natAdd ((s i₀ + 1) + ν) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin ((s i₀ + 1) + ν + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin ((s i₀ + 1) + ν + d)) k)
                q₁ f_lift₁)
              f_new_lift a))) ∉ 𝔭_y :=
      hScale₁ U_poly f_pt γ₀ 𝔭_y hUnit_Upoly hfpt_mem_p hDet_fpt_notMem
    refine ⟨α₀ i₀, W, hAffW, hyW, hWU, hWα, s i₀ + 1, φ₁, q₁, f_lift₁, f_new_lift, γ₀,
      hSurj₁, hSpec₁, hKer₁, hf_lift₁_sec, ?_, hDet_q₁, hDet_prod_notMem⟩
    intro hFn hXα hpos
    dsimp [f_new_lift]
    rw [map_mul, hU_poly, hφ₁_fpt]
    exact (hOverlap_urat c' hFn hXα hpos).symm

  choose W_z Δ_z hW_mem hΔ_z_ne hW_good using hPointwise

  
  obtain ⟨t, ht_cov⟩ :=
    hComp_K0.elim_finite_subcover (fun z : ↥K0 => (W_z z : Set ↥X.left))
      (fun z => (W_z z).isOpen)
      (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hW_mem ⟨x, hx⟩⟩)
  let Δ_trans : MvPolynomial (Fin (N' + 1)) k := Δ_star * ∏ z ∈ t, Δ_z z
  have hΔ_trans_ne : Δ_trans ≠ 0 :=
    mul_ne_zero hΔ_star_ne (Finset.prod_ne_zero_iff.mpr fun z _ => hΔ_z_ne z)
  refine ⟨Δ_trans, hΔ_trans_ne, fun c' hEval => ?_⟩
  have hEval_mul : MvPolynomial.eval c' Δ_star * MvPolynomial.eval c' (∏ z ∈ t, Δ_z z) ≠ 0 := by
    rw [← map_mul]
    exact hEval
  have hEval_star : MvPolynomial.eval c' Δ_star ≠ 0 := left_ne_zero_of_mul hEval_mul
  have hEval_prod : ∀ z ∈ t, MvPolynomial.eval c' (Δ_z z) ≠ 0 := by
    have hp : MvPolynomial.eval c' (∏ z ∈ t, Δ_z z) ≠ 0 := right_ne_zero_of_mul hEval_mul
    rwa [map_prod, Finset.prod_ne_zero_iff] at hp
  refine hAdvance hd (F_pt c') (hFpt_hom c') (fun x hxU hxPrev hxNew => ?_)
  have hxK : x ∈ K := ⟨hxU, hxPrev⟩
  by_cases hx_eq : ι_X.left.base x = q_star
  · exact hStar_good c' x hEval_star hxK hx_eq
  · have hxK0 : x ∈ K0 := ⟨hxK, hx_eq⟩
    have hx_in_union := ht_cov hxK0
    simp only [Set.mem_iUnion] at hx_in_union
    rcases hx_in_union with ⟨z, hz_mem_t, hx_Wz⟩
    exact hW_good z c' x (hEval_prod z hz_mem_t) hx_Wz hxK hxNew

theorem weil_algClosed_pointed_veronese_linear_projection (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntVn : AlgebraicGeometry.IsIntegral V_norm.left)
    (hProjVn : IsProjectiveOverField k V_norm)
    (hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞))
    (W_reg U_in : V_norm.left.Opens)
    (hSmWreg : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1)
      (CategoryTheory.CategoryStruct.comp W_reg.ι V_norm.hom))
    (hDimSing : topologicalKrullDim ↥((W_reg : Set ↥V_norm.left)ᶜ) + 2 ≤
      ((m + 1 : ℕ) : WithBot ℕ∞))
    (hU_le_reg : U_in ≤ W_reg)
    (x_norm : ↥V_norm.left)
    (hx_in : x_norm ∈ U_in)
    (hx_cl : IsClosed ({x_norm} : Set ↥V_norm.left))
    (pr_p₀ : Quiver.Hom
      ((weilProjCenterComplOpen k m :
        (weilProjectiveSpaceOver k (m + 1)).left.Opens) : AlgebraicGeometry.Scheme.{u})
      (weilProjectiveSpaceOver k m).left)
    (hPr : IsCenterComplLinearProjection k m pr_p₀) :
    let P_amb := weilProjectiveSpaceOver k (m + 1)
    let B₀ := weilProjectiveSpaceOver k m
    let U_proj := weilProjCenterComplOpen k m
    let 𝒜_m := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
    let 𝒜_m1 := MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k
    letI : GradedAlgebra 𝒜_m := MvPolynomial.gradedAlgebra
    letI : GradedAlgebra 𝒜_m1 := MvPolynomial.gradedAlgebra
    let D_base := AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X (Fin.last m))
    let D_amb := AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X (Fin.last m).castSucc)
    ∃ (π : Quiver.Hom V_norm P_amb)
      (U_et_π : P_amb.left.Opens)
      (q_sec : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V_norm.left)
      (Z_div : AlgebraicGeometry.Scheme.{u})
      (ι_div : Quiver.Hom Z_div V_norm.left)
      (j_div : Quiver.Hom Z_div (π.left ⁻¹ᵁ U_proj : V_norm.left.Opens).toScheme)
      (Z_low : Set ↥V_norm.left)
      (b_star : ↥B₀.left)
      (W_sm₀ : (π.left ⁻¹ᵁ U_proj : V_norm.left.Opens).toScheme.Opens)
      (W_et₀ : Z_div.Opens),
      (AlgebraicGeometry.IsFinite π.left ∧ AlgebraicGeometry.Surjective π.left) ∧
      (((U_proj : Set ↥P_amb.left)ᶜ) ⊆ (U_et_π : Set ↥P_amb.left) ∧
        AlgebraicGeometry.Etale (π.left ∣_ U_et_π)) ∧
      (CategoryTheory.CategoryStruct.comp q_sec V_norm.hom =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
        Set.range (CategoryTheory.CategoryStruct.comp q_sec π.left).base ⊆
          ((U_proj : Set ↥P_amb.left)ᶜ)) ∧
      (∀ x : ↥V_norm.left, π.left.base x ∉ U_proj →
        ∃ q_x : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V_norm.left,
          CategoryTheory.CategoryStruct.comp q_x V_norm.hom =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
          x ∈ Set.range q_x.base) ∧
      (AlgebraicGeometry.IsClosedImmersion ι_div ∧
        AlgebraicGeometry.IsReduced Z_div ∧
        IsClosed Z_low ∧
        ((U_in : Set ↥V_norm.left)ᶜ = Set.range ι_div.base ∪ Z_low) ∧
        (CategoryTheory.CategoryStruct.comp j_div
          (π.left ⁻¹ᵁ U_proj : V_norm.left.Opens).ι = ι_div) ∧
        (Z_low ⊆ ((π.left ⁻¹ᵁ U_proj : V_norm.left.Opens) : Set ↥V_norm.left)) ∧
        AlgebraicGeometry.IsFinite
          (CategoryTheory.CategoryStruct.comp j_div
            (CategoryTheory.CategoryStruct.comp (π.left ∣_ U_proj) pr_p₀))) ∧
      (∀ x : ↥(π.left ⁻¹ᵁ U_proj : V_norm.left.Opens).toScheme,
        x.1 ∈ Z_low →
          (CategoryTheory.CategoryStruct.comp (π.left ∣_ U_proj) pr_p₀).base x ≠ b_star) ∧
      ((∀ x : ↥(π.left ⁻¹ᵁ U_proj : V_norm.left.Opens).toScheme,
          (CategoryTheory.CategoryStruct.comp (π.left ∣_ U_proj) pr_p₀).base x = b_star →
            x ∈ W_sm₀) ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1
          (CategoryTheory.CategoryStruct.comp W_sm₀.ι
            (CategoryTheory.CategoryStruct.comp (π.left ∣_ U_proj) pr_p₀))) ∧
      ((∀ z : ↥Z_div,
          (CategoryTheory.CategoryStruct.comp j_div
            (CategoryTheory.CategoryStruct.comp (π.left ∣_ U_proj) pr_p₀)).base z = b_star →
            z ∈ W_et₀) ∧
        AlgebraicGeometry.Etale
          (CategoryTheory.CategoryStruct.comp W_et₀.ι
            (CategoryTheory.CategoryStruct.comp j_div
              (CategoryTheory.CategoryStruct.comp (π.left ∣_ U_proj) pr_p₀)))) ∧
      (b_star ∈ D_base ∧ IsClosed ({b_star} : Set ↥B₀.left)) ∧
      ∃ (hx_amb : π.left.base x_norm ∈ D_amb)
        (hx_proj : π.left.base x_norm ∈ U_proj),
        (CategoryTheory.CategoryStruct.comp (π.left ∣_ U_proj) pr_p₀).base ⟨x_norm, hx_proj⟩ =
          b_star :=
by
  classical
  let P_amb := weilProjectiveSpaceOver k (m + 1)
  let B₀ := weilProjectiveSpaceOver k m
  let U_proj := weilProjCenterComplOpen k m
  let 𝒜_m := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
  let 𝒜_m1 := MvPolynomial.homogeneousSubmodule (Fin (m + 1 + 1)) k
  let : GradedAlgebra 𝒜_m := MvPolynomial.gradedAlgebra
  let : GradedAlgebra 𝒜_m1 := MvPolynomial.gradedAlgebra
  let D_base := AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X (Fin.last m))
  let D_amb := AlgebraicGeometry.Proj.basicOpen 𝒜_m1 (MvPolynomial.X (Fin.last m).castSucc)

  
  
  
  have hSubDim0 :
      ∀ {α : Type u} [TopologicalSpace α] [Subsingleton α],
        topologicalKrullDim α ≤ (0 : WithBot ℕ∞) := by
    intro α _ _
    change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds α)),
      (p.length : WithBot ℕ∞) ≤ ((0 : ℕ) : WithBot ℕ∞)
    apply iSup_le
    intro p
    by_cases hlen : p.length = 0
    · rw [hlen]
    · exfalso
      have hpos : 0 < p.length := Nat.pos_of_ne_zero hlen
      have hlt : p ⟨0, Nat.succ_pos _⟩ < p ⟨1, Nat.succ_lt_succ hpos⟩ :=
        p.step ⟨0, hpos⟩
      obtain ⟨y₀, hy₀⟩ := (p ⟨0, Nat.succ_pos _⟩).isIrreducible.nonempty
      have hsub : (p ⟨1, Nat.succ_lt_succ hpos⟩ : Set α) ⊆
          (p ⟨0, Nat.succ_pos _⟩ : Set α) := by
        intro z _
        rw [Subsingleton.elim z y₀]
        exact hy₀
      exact not_le_of_gt hlt hsub

  have hWB_sing :
      ∀ (d : WithBot ℕ∞),
        d + 2 ≤ ((m + 1 : ℕ) : WithBot ℕ∞) →
        d ≤ ((m - 1 : ℕ) : WithBot ℕ∞) := by
    intro d h
    cases d with
    | bot => exact bot_le
    | coe a =>
      cases a with
      | top =>
        have h' : (⊤ : ℕ∞) ≤ ((m + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h
        exact absurd (top_le_iff.mp h') (ENat.natCast_ne_top (m + 1))
      | coe n =>
        have h' : ((n + 2 : ℕ) : ℕ∞) ≤ ((m + 1 : ℕ) : ℕ∞) := WithBot.coe_le_coe.mp h
        have hn : n + 2 ≤ m + 1 := Nat.cast_le.mp h'
        have hn' : n ≤ m - 1 := by omega
        exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hn')

  have hWB_step :
      ∀ (x y B : WithBot ℕ∞) (r : ℕ),
        x + 1 ≤ y →
        y + ((r : ℕ) : WithBot ℕ∞) ≤ B →
        x + ((r + 1 : ℕ) : WithBot ℕ∞) ≤ B := by
    intro x y B r hxy hyB
    have h1 : (x + 1) + ((r : ℕ) : WithBot ℕ∞) ≤ y + ((r : ℕ) : WithBot ℕ∞) :=
      add_le_add hxy le_rfl
    have h2 : x + (1 + ((r : ℕ) : WithBot ℕ∞)) ≤ B := by
      rw [← add_assoc]
      exact h1.trans hyB
    have h3 : (1 : WithBot ℕ∞) + ((r : ℕ) : WithBot ℕ∞) = ((r + 1 : ℕ) : WithBot ℕ∞) := by
      rw [add_comm, ← Nat.cast_one, ← Nat.cast_add]
    rwa [h3] at h2

  have hWB_le_diff :
      ∀ (d : WithBot ℕ∞) (r b : ℕ), r ≤ b →
        d + ((r : ℕ) : WithBot ℕ∞) ≤ ((b : ℕ) : WithBot ℕ∞) →
        d ≤ ((b - r : ℕ) : WithBot ℕ∞) := by
    intro d r b _ h
    cases d with
    | bot => exact bot_le
    | coe a =>
      cases a with
      | top =>
        have h' : (⊤ : ℕ∞) ≤ (b : ℕ∞) := WithBot.coe_le_coe.mp h
        exact absurd (top_le_iff.mp h') (ENat.natCast_ne_top b)
      | coe n =>
        have h' : ((n + r : ℕ) : ℕ∞) ≤ (b : ℕ∞) := WithBot.coe_le_coe.mp h
        have hn : n + r ≤ b := Nat.cast_le.mp h'
        have hn' : n ≤ b - r := by omega
        exact WithBot.coe_le_coe.mpr (Nat.cast_le.mpr hn')

  have hWB_empty_of_lt :
      ∀ {α : Type u} [TopologicalSpace α] (S : Set α) (e b : ℕ), b < e →
        topologicalKrullDim ↥S + ((e : ℕ) : WithBot ℕ∞) ≤ ((b : ℕ) : WithBot ℕ∞) →
        S = ∅ := by
    intro α _ S e b _ hdim
    ext z
    simp only [Set.mem_empty_iff_false, iff_false]
    intro hz
    let z' : ↥S := ⟨z, hz⟩
    let c₀ : TopologicalSpace.IrreducibleCloseds ↥S :=
      ⟨closure ({z'} : Set ↥S), isIrreducible_singleton.closure, isClosed_closure⟩
    have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥S) := ⟨c₀⟩
    have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥S := Order.krullDim_nonneg
    have h1 : (0 : WithBot ℕ∞) + ((e : ℕ) : WithBot ℕ∞) ≤ ((b : ℕ) : WithBot ℕ∞) :=
      (add_le_add h0 le_rfl).trans hdim
    rw [zero_add] at h1
    exact absurd (Nat.cast_le.mp h1) (by omega)

  have hSetEqDim :
      ∀ {α : Type u} [TopologicalSpace α] {A B : Set α},
        A = B → topologicalKrullDim ↥A = topologicalKrullDim ↥B := by
    rintro α _ A B rfl
    rfl

  have hEmbDim :
