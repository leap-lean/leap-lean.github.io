          fn_of f₁ hf₁ y₁ = fn_of f₂ hf₂ y₂ := by
        intro Z₁ Z₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
        let m₁ : (Fgt.obj Z₁).left ⟶ (Fgt.obj W).left := (Fgt.map f₁).left
        let m₂ : (Fgt.obj Z₂).left ⟶ (Fgt.obj W).left := (Fgt.map f₂).left
