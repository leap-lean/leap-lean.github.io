  have hSurj₁ : Function.Surjective φ₁ := by
    intro r₁
    obtain ⟨⟨y₀, _, e, rfl⟩, hy_eq⟩ := IsLocalization.surj (Submonoid.powers g₀) r₁
    obtain ⟨Y₀, rfl⟩ := hSurj₀ y₀
    refine ⟨MvPolynomial.rename ι_old Y₀ * MvPolynomial.X z_slot ^ e, ?_⟩
    have hy_eq' : r₁ * algebraMap R₀ R₁ (g₀ ^ e) = algebraMap R₀ R₁ (φ₀ Y₀) := hy_eq
