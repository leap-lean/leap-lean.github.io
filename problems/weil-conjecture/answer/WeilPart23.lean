        (∀ s : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op U)),
          div_val U s = 0 →
          let u : Units E :=
            Units.map
              (CategoryTheory.Limits.pullback.map
                (CategoryTheory.CategoryStruct.comp V₀.ι U.hom) η_C U.hom η_C
                V₀.ι (CategoryTheory.CategoryStruct.id _) (CategoryTheory.CategoryStruct.id _)
                (by rw [CategoryTheory.Category.comp_id])
                (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])).appTop.hom.toMonoidHom
              (Additive.toMul s)
          ∀ m : Ideal D, m.IsMaximal → m ≠ ⊥ →
            (∃ a₁ b₁ : D, b₁ ∉ m ∧ (u : E) * α b₁ = α a₁) ∧
            (∃ a₂ b₂ : D, b₂ ∉ m ∧ ((u⁻¹ : Units E) : E) * α b₂ = α a₂)) ∧
        (∀ (D_fn : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } → ℤ)
           (u₀ : ↥U.left) (_ : u₀ ∈ V₀)
           (V_fin : U.left.Opens) (_ : u₀ ∈ V_fin),
          { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) } |
            y.1 ∈ V_fin ∧ D_fn y ≠ 0 }.Finite →
          ∃ (V : U.left.Opens) (_ : u₀ ∈ V),
            let W_V : C.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
              (CategoryTheory.CategoryStruct.comp V.ι U.hom)
              (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
            let j_V : W_V ⟶ U := CategoryTheory.MorphismProperty.Over.homMk V.ι rfl trivial
            ∃ s_V : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op W_V)),
              ∀ z : { y : ↥W_V.left // IsClosed ({W_V.hom.base y} : Set ↥C.left) },
                div_val W_V s_V z =
