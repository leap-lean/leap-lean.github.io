      ∀ (s₁ : ↥(ℱ.obj.obj (Opposite.op V₁)))
        (f_q : Quiver.Hom Fℤ_C 𝒬),
        (ℱ.obj.map (Opposite.op j₁)).hom s₁ =
          (ι_sh.hom.app (Opposite.op V₁₂)).hom ((η_gm.app (Opposite.op V₁₂)).hom u_pre) →
        (𝒬.obj.map (Opposite.op (hT_C.from V₁))).hom
            ((f_q.hom.app (Opposite.op T_C)).hom ((adj_c.unit.app Aℤ).hom (ULift.up 1))) =
          (π_sh.hom.app (Opposite.op V₁)).hom s₁ →
        (𝒬.obj.map (Opposite.op (hT_C.from V₂))).hom
            ((f_q.hom.app (Opposite.op T_C)).hom ((adj_c.unit.app Aℤ).hom (ULift.up 1))) = 0 →
