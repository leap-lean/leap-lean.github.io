      h ≫ X₂.hom = X₁.hom →
      ∀ (h_gen : h.base (genericPoint ↥X₁.left) = genericPoint ↥X₂.left),
        let φ_h : ↑X₂.left.functionField →+* ↑X₁.left.functionField :=
