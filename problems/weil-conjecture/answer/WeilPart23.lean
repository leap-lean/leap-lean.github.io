    have hNo_root_pow : ∀ b : F, b ^ ℓ ≠ f.val := by
      intro b hb
      have hb_ne : b ≠ 0 := by
        intro h0
        rw [h0, zero_pow hPrime.ne_zero] at hb
        exact f.ne_zero hb.symm
      refine hf_not_pow (Units.mk0 b hb_ne) ?_
      ext
      simpa [Units.val_pow_eq_pow_val] using hb
    have hIrred : Irreducible P_f := X_pow_sub_C_irreducible_of_prime hPrime hNo_root_pow
    refine ⟨hIrred, ?_⟩
    have : Fact (Irreducible P_f) := ⟨hIrred⟩
    let L : Type u := AdjoinRoot P_f
    let pb_L : PowerBasis F L := AdjoinRoot.powerBasis hIrred.ne_zero
    have hDim_L : pb_L.dim = ℓ := by
      dsimp [pb_L, P_f]
      rw [AdjoinRoot.powerBasis_dim, Polynomial.natDegree_X_pow_sub_C]
    have hFinDim : FiniteDimensional F L := pb_L.finite
    have hRank : Module.finrank F L = ℓ := by
      rw [pb_L.finrank, hDim_L]
    have hSep : Algebra.IsSeparable F L := Algebra.FormallyUnramified.isSeparable F L
    have hRoot_pow : (AdjoinRoot.root P_f) ^ ℓ = algebraMap F L f.val := by
      have h0 := AdjoinRoot.eval₂_root P_f
      dsimp [P_f] at h0
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C] at h0
      exact sub_eq_zero.mp h0
    let ζ_L : L := algebraMap F L (algebraMap k F ζ)
    have hζL_pow : ζ_L ^ ℓ = 1 := by
      dsimp [ζ_L]
      rw [← map_pow, ← map_pow, hζ_pow, map_one, map_one]
    have hσL_eval : Polynomial.eval₂ (Algebra.ofId F L).toRingHom
