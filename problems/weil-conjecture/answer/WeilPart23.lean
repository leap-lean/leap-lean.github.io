        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X b.castSucc) hb₁ hpos).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_map) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) hb₀' hpos).inv ≫
          D₀_b.ι := h_chart
    clear_value φ_map
    have hRange : Set.range g₁.base = Set.range g₂.base := by
      ext u
      constructor
      · intro hu
        rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hu
        have hu₁ : (u : ↥U_proj).1 ∈ D₁_b := (hiff u).mp hu
        let x : ↥D₁_b.toScheme := ⟨(u : ↥U_proj).1, hu₁⟩
        refine ⟨x, ?_⟩
        apply U_proj'.ι.isOpenEmbedding.injective
        calc
          U_proj'.ι.base (g₂.base x) = (g₂ ≫ U_proj'.ι).base x :=
            (AlgebraicGeometry.Scheme.Hom.comp_apply g₂ U_proj'.ι x).symm
          _ = D₁_b.ι.base x := by rw [hg₂_ι]
          _ = U_proj'.ι.base u := rfl
      · rintro ⟨x, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        have hgx : (g₂.base x : ↥U_proj).1 = (x : ↥D₁_b).1 := by
          change U_proj'.ι.base (g₂.base x) = D₁_b.ι.base x
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hg₂_ι]
        have hx₁ : (g₂.base x : ↥U_proj).1 ∈ D₁_b := by
          rw [hgx]
          exact (x : ↥D₁_b).2
        exact (hiff (g₂.base x)).mpr hx₁
    let f_to : (pr' ⁻¹ᵁ D₀_b).toScheme ⟶ D₁_b.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift g₂ g₁ (le_of_eq hRange)
    let f_inv : D₁_b.toScheme ⟶ (pr' ⁻¹ᵁ D₀_b).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift g₁ g₂ (le_of_eq hRange.symm)
    have hf_to : f_to ≫ g₂ = g₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac g₂ g₁ (le_of_eq hRange)
    have hf_inv : f_inv ≫ g₁ = g₂ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac g₁ g₂ (le_of_eq hRange.symm)
    let e_open : (pr' ⁻¹ᵁ D₀_b).toScheme ≅ D₁_b.toScheme :=
      { hom := f_to
        inv := f_inv
        hom_inv_id := by
          rw [← CategoryTheory.cancel_mono g₁, CategoryTheory.Category.assoc, hf_inv, hf_to,
            CategoryTheory.Category.id_comp]
        inv_hom_id := by
          rw [← CategoryTheory.cancel_mono g₂, CategoryTheory.Category.assoc, hf_to, hf_inv,
            CategoryTheory.Category.id_comp] }
    let isoSpec₁ : AlgebraicGeometry.Spec
        (CommRingCat.of (HomogeneousLocalization.Away 𝒜_m1 (MvPolynomial.X b.castSucc))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_b)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
          congr 1
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro z
          exact θ₁_ring.apply_symm_apply z
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_id]
          congr 1
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro z
          exact θ₁_ring.symm_apply_apply z }
    let e₁ : D₁_b.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_b)) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X b.castSucc) hb₁ hpos ≪≫ isoSpec₁
    let e_top' : CategoryTheory.Iso (pr' ⁻¹ᵁ D₀_b).toScheme
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_b))) :=
      e_open ≪≫ e₁
    let e_top : CategoryTheory.Iso (pr_p₀ ⁻¹ᵁ D₀_b).toScheme
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R_b))) :=
      e_top'
    refine ⟨R_b, inferInstance, inferInstance, e_base, e_top, he_base_struct, ?_⟩
    change e_top'.inv ≫ ((pr' ∣_ D₀_b) ≫ e_base.hom) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
    haveI : CategoryTheory.IsIso e_base.inv := e_base.isIso_inv
    rw [← CategoryTheory.cancel_mono e_base.inv, ← CategoryTheory.cancel_mono D₀_b.ι]
    have hhb₀ : hb₀' = hX_m b := Subsingleton.elim _ _
    have hhpos : hpos = zero_lt_one := Subsingleton.elim _ _
    have he_top_inv : e_top'.inv =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X b.castSucc) hb₁ hpos).inv ≫
          f_inv := rfl
    have hLHS : ((e_top'.inv ≫ ((pr' ∣_ D₀_b) ≫ e_base.hom)) ≫ e_base.inv) ≫ D₀_b.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_map) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) (hX_m b) zero_lt_one).inv ≫
          D₀_b.ι := by
      calc
        ((e_top'.inv ≫ ((pr' ∣_ D₀_b) ≫ e_base.hom)) ≫ e_base.inv) ≫ D₀_b.ι =
            e_top'.inv ≫ (pr' ∣_ D₀_b) ≫ (e_base.hom ≫ e_base.inv) ≫ D₀_b.ι := by
          simp only [CategoryTheory.Category.assoc]
        _ = e_top'.inv ≫ ((pr' ∣_ D₀_b) ≫ D₀_b.ι) := by
          rw [e_base.hom_inv_id, CategoryTheory.Category.id_comp]
        _ = e_top'.inv ≫ (g₁ ≫ pr') := by
          rw [AlgebraicGeometry.morphismRestrict_ι]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom) ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X b.castSucc) hb₁ hpos).inv ≫
              (f_inv ≫ g₁) ≫ pr' := by
          rw [he_top_inv]
          simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom) ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m1 (MvPolynomial.X b.castSucc) hb₁ hpos).inv ≫
              (g₂ ≫ pr') := by
          rw [hf_inv]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_map) ≫
              (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) (hX_m b) zero_lt_one).inv ≫
              D₀_b.ι := by
          rw [h_chart', Iso.inv_hom_id_assoc, hhb₀, hhpos]
    have hRHS : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫ e_base.inv) ≫ D₀_b.ι) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀_ring.symm.toRingHom) ≫
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_m (MvPolynomial.X b) (hX_m b) zero_lt_one).inv ≫
          D₀_b.ι := by
      rw [he_base_inv]
      simp only [CategoryTheory.Category.assoc]
      rfl
    rw [hLHS, hRHS]
    have h_spec_sq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_map) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e₀_ring.symm.toRingHom) := by
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro z
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      have hz : z = e₀_ring (e₀_ring.symm z) := (e₀_ring.apply_symm_apply z).symm
      conv_lhs => rw [hz]
      have h_app := RingHom.congr_fun h_ring_fwd (e₀_ring.symm z)
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe] at h_app
      rw [h_app]
      exact θ₁_ring.symm_apply_apply (Polynomial.C (e₀_ring.symm z))
    rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₁_ring.symm.toRingHom)),
      h_spec_sq, CategoryTheory.Category.assoc]

theorem weil_projLine_pullback_open_polynomial_compl_eq_section_range (k : Type u) [Field k]
    (R : Type u) [CommRing R] [Algebra k R]
    (W : (CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
      (weilProjectiveSpaceOver k 1).hom).Opens)
    (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R))
      (CategoryTheory.Limits.pullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
        (weilProjectiveSpaceOver k 1).hom))
    (hs_sec : CategoryTheory.CategoryStruct.comp s
      (CategoryTheory.Limits.pullback.fst
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
        (weilProjectiveSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of R)))
    (hs_disj : Set.range s.base ⊆ ((W : Set ↥(CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
      (weilProjectiveSpaceOver k 1).hom))ᶜ))
    (eW : CategoryTheory.Iso W.toScheme (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial R))))
    (heW : CategoryTheory.CategoryStruct.comp eW.inv
      (CategoryTheory.CategoryStruct.comp W.ι
        (CategoryTheory.Limits.pullback.fst
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
          (weilProjectiveSpaceOver k 1).hom)) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)) :
    ((W : Set ↥(CategoryTheory.Limits.pullback
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R)))
      (weilProjectiveSpaceOver k 1).hom))ᶜ) = Set.range s.base :=
by
  classical
  
  have hLiftInv : ∀ {A₀ B₀ : Type u} [CommRing A₀] [CommRing B₀]
      (f : A₀ →+* B₀) (r : A₀) (v : B₀) (hv : f r * v = 1),
      ∃ L : Localization.Away r →+* B₀,
        (∀ a : A₀, L (algebraMap A₀ (Localization.Away r) a) = f a) ∧
        L (IsLocalization.Away.invSelf (S := Localization.Away r) r) = v ∧
        (∀ (a : A₀) (j : ℕ) (hj : r ^ j ∈ Submonoid.powers r),
          L (Localization.mk a ⟨r ^ j, hj⟩) = f a * v ^ j) := by
    intro A₀ B₀ _ _ f r v hv
    have hu : IsUnit (f r) := ⟨⟨f r, v, hv, by rw [mul_comm]; exact hv⟩, rfl⟩
    refine ⟨Localization.awayLift f r hu, ?_, ?_, ?_⟩
    · intro a
      exact IsLocalization.Away.lift_eq (S := Localization.Away r) r hu a
    · have h1 : Localization.awayLift f r hu
          (algebraMap A₀ (Localization.Away r) r *
            IsLocalization.Away.invSelf (S := Localization.Away r) r) = 1 := by
        rw [IsLocalization.Away.mul_invSelf, map_one]
      rw [map_mul, IsLocalization.Away.lift_eq (S := Localization.Away r) r hu r] at h1
      calc Localization.awayLift f r hu (IsLocalization.Away.invSelf r)
          = (v * f r) * Localization.awayLift f r hu (IsLocalization.Away.invSelf r) := by
            rw [mul_comm v (f r), hv, one_mul]
        _ = v * (f r * Localization.awayLift f r hu (IsLocalization.Away.invSelf r)) := by
            rw [mul_assoc]
        _ = v := by rw [h1, mul_one]
    · intro a j _
      exact Localization.awayLift_mk f r a v hv j

  
  have hMemBasic : ∀ {A₀ : Type u} [CommRing A₀] (f : A₀)
      (p : ↥(AlgebraicGeometry.Spec (CommRingCat.of A₀))),
      p ∈ (PrimeSpectrum.basicOpen f : (AlgebraicGeometry.Spec (CommRingCat.of A₀)).Opens) ↔
        f ∉ (p : PrimeSpectrum A₀).asIdeal :=
    fun f p => PrimeSpectrum.mem_basicOpen f p

  have hSpecBase : ∀ {A₀ B₀ : Type u} [CommRing A₀] [CommRing B₀] (φ : A₀ →+* B₀)
      (p : ↥(AlgebraicGeometry.Spec (CommRingCat.of B₀))) (a : A₀),
      a ∈ (((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base p :
        PrimeSpectrum A₀).asIdeal) ↔
        φ a ∈ (p : PrimeSpectrum B₀).asIdeal :=
    fun _ _ _ => Iff.rfl

  
  
  
  let P₁ := weilProjectiveSpaceOver k 1
  have hP₁Atlas :
      ∃ (U₀ U₁ : P₁.left.Opens)
        (e_U0 : U₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
        (e_U1 : U₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))),
        U₀ ⊔ U₁ = ⊤ ∧
        e_U0.inv ≫ U₀.ι ≫ P₁.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        e_U1.inv ≫ U₁.ι ≫ P₁.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
        (e_U0.inv ≫ U₀.ι) ⁻¹ᵁ U₁ = PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) ∧
        (e_U1.inv ≫ U₁.ι) ⁻¹ᵁ U₀ = PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)))) ≫
          e_U0.inv ≫ U₀.ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.eval₂RingHom
              ((algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))).comp
                Polynomial.C)
              (IsLocalization.Away.invSelf (Polynomial.X : Polynomial k)))) ≫
          e_U1.inv ≫ U₁.ι := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin 2) k
    let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let U_P₁ : Fin 2 → P₁.left.Opens :=
      fun β => (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X β) : P₁.left.Opens)

    have hCov_iSup : (⨆ β : Fin 2, U_P₁ β) = ⊤ := by
      apply AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜 (fun β : Fin 2 => MvPolynomial.X β)
      rw [HomogeneousIdeal.irrelevant_eq_span, Ideal.span_le]
      rintro p hp
      simp only [Set.mem_iUnion, SetLike.mem_coe] at hp
      obtain ⟨i, hi, hp_hom⟩ := hp
      rw [MvPolynomial.mem_homogeneousSubmodule] at hp_hom
      have hrange : Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) k) =
          MvPolynomial.X '' (Set.univ : Set (Fin 2)) := Set.image_univ.symm
      rw [hrange, SetLike.mem_coe, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      by_contra h_all
      have h_all' : ∀ m_idx : Fin 2, m m_idx = 0 := fun j =>
        Classical.not_not.mp fun hne0 => h_all ⟨j, Set.mem_univ j, hne0⟩
      have hm_coeff : p.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      have hm_zero : m = 0 := by
        ext j
        exact h_all' j
      have hdeg : (Finsupp.weight 1) m = i := hp_hom hm_coeff
      rw [hm_zero, map_zero] at hdeg
      omega

    have hCov_sup : U_P₁ 0 ⊔ U_P₁ 1 = ⊤ := by
      rw [eq_top_iff]
      intro z _
      have hz : z ∈ ⨆ β : Fin 2, U_P₁ β := by rw [hCov_iSup]; trivial
      rw [TopologicalSpace.Opens.mem_iSup] at hz
      obtain ⟨β, hβ⟩ := hz
      fin_cases β
      · exact Or.inl hβ
      · exact Or.inr hβ

    have hAlg0_val : ∀ c : k, ((algebraMap k ↥(𝒜 0) c) : MvPolynomial (Fin 2) k) = MvPolynomial.C c := by
      intro c
      rw [Algebra.algebraMap_eq_smul_one]
      change c • (1 : MvPolynomial (Fin 2) k) = MvPolynomial.C c
      rw [MvPolynomial.smul_eq_C_mul, mul_one]

    have hChartEquiv : ∀ (β β' : Fin 2), β' ≠ β →
        let Xβ : MvPolynomial (Fin 2) k := MvPolynomial.X β
        let Xβ' : MvPolynomial (Fin 2) k := MvPolynomial.X β'
        let hXβ : Xβ ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k β
        let hXβ' : Xβ' ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k β'
        ∃ (α_β : Polynomial k →+* HomogeneousLocalization.Away 𝒜 Xβ)
          (β_β : HomogeneousLocalization.Away 𝒜 Xβ →+* Polynomial k),
          β_β.comp α_β = RingHom.id (Polynomial k) ∧
          α_β.comp β_β = RingHom.id (HomogeneousLocalization.Away 𝒜 Xβ) ∧
          (∀ c : k, α_β (Polynomial.C c) =
            HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xβ)
              (algebraMap k ↥(𝒜 0) c)) ∧
          α_β Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem hXβ hXβ' := by
      intro β β' hne Xβ Xβ' hXβ hXβ'
      let Hβ := HomogeneousLocalization.Away 𝒜 Xβ
      let α_β : Polynomial k →+* Hβ :=
        Polynomial.eval₂RingHom
          ((HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xβ)).comp
            (algebraMap k ↥(𝒜 0)))
          (HomogeneousLocalization.Away.isLocalizationElem hXβ hXβ')
      let ev_β : MvPolynomial (Fin 2) k →+* Polynomial k :=
        MvPolynomial.eval₂Hom Polynomial.C (fun j : Fin 2 => if j = β then 1 else Polynomial.X)
      have hev_Xβ : ev_β Xβ = 1 := by
        dsimp only [ev_β, Xβ]
        rw [MvPolynomial.eval₂Hom_X']
        simp
      have hev_Xβ' : ev_β Xβ' = Polynomial.X := by
        dsimp only [ev_β, Xβ']
        rw [MvPolynomial.eval₂Hom_X']
        simp [hne]
      have hev_C : ∀ c : k, ev_β (MvPolynomial.C c) = Polynomial.C c := by
        intro c
        dsimp only [ev_β]
        exact MvPolynomial.eval₂Hom_C _ _ c
      obtain ⟨L_β, hL_alg, _, hL_mk⟩ := hLiftInv ev_β Xβ 1 (by rw [hev_Xβ, mul_one])
      let valHom_β : Hβ →+* Localization.Away Xβ :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      let β_β : Hβ →+* Polynomial k := L_β.comp valHom_β
      have hα_C : ∀ c : k, α_β (Polynomial.C c) =
          HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xβ)
            (algebraMap k ↥(𝒜 0) c) := by
        intro c
        dsimp [α_β]
        exact Polynomial.eval₂_C _ _
      have hα_X : α_β Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem hXβ hXβ' := by
        dsimp [α_β]
        exact Polynomial.eval₂_X _ _
      have hfrom0_val : ∀ a0 : ↥(𝒜 0),
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xβ) a0).val =
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) a0.1 :=
        fun _ => rfl
      have hleft : β_β.comp α_β = RingHom.id (Polynomial k) := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change L_β (α_β (Polynomial.C c)).val = Polynomial.C c
          rw [hα_C c, hfrom0_val, hL_alg, hAlg0_val, hev_C]
        · change L_β (α_β Polynomial.X).val = Polynomial.X
          rw [hα_X]
          have hiso_mk : HomogeneousLocalization.Away.isLocalizationElem hXβ hXβ' =
              HomogeneousLocalization.Away.mk 𝒜 hXβ 1 (Xβ' ^ 1)
                (by simpa [one_smul, pow_one] using hXβ') := rfl
          rw [hiso_mk, HomogeneousLocalization.Away.val_mk, hL_mk, pow_one, pow_one, mul_one, hev_Xβ']
      have hright : α_β.comp β_β = RingHom.id Hβ := by
        apply RingHom.ext
        intro z
        apply HomogeneousLocalization.val_injective
        obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hXβ z
        let s_pow : ∀ m : ℕ, Submonoid.powers Xβ :=
          fun m => ⟨Xβ ^ m, (Submonoid.powers Xβ).pow_mem (Submonoid.mem_powers Xβ) m⟩
        have hz_val : (HomogeneousLocalization.Away.mk 𝒜 hXβ n a ha).val =
            Localization.mk a (s_pow n) :=
          HomogeneousLocalization.Away.val_mk 𝒜 n hXβ a ha
        have hβz : β_β (HomogeneousLocalization.Away.mk 𝒜 hXβ n a ha) = ev_β a := by
          change L_β (HomogeneousLocalization.Away.mk 𝒜 hXβ n a ha).val = ev_β a
          rw [hz_val, hL_mk, one_pow, mul_one]
        change (α_β (β_β (HomogeneousLocalization.Away.mk 𝒜 hXβ n a ha))).val =
          (HomogeneousLocalization.Away.mk 𝒜 hXβ n a ha).val
        rw [hβz, hz_val]
        let Φ : MvPolynomial (Fin 2) k →+* Localization.Away Xβ := valHom_β.comp (α_β.comp ev_β)
        let uX : Localization.Away Xβ := algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) Xβ
        let invX : Localization.Away Xβ := IsLocalization.Away.invSelf (S := Localization.Away Xβ) Xβ
        have hu_inv : uX * invX = 1 := IsLocalization.Away.mul_invSelf Xβ
        have hmk_mul : ∀ (p : MvPolynomial (Fin 2) k) (m : ℕ),
            Localization.mk p (s_pow m) * uX ^ m =
              algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) p := by
          intro p m
          have hu_pow : uX ^ m = Localization.mk (Xβ ^ m) 1 := by
            rw [← map_pow]
            rfl
          rw [hu_pow, Localization.mk_mul, mul_one]
          change Localization.mk (p * Xβ ^ m) (s_pow m) = Localization.mk p 1
          rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          exact ⟨1, by simp [s_pow, mul_comm]⟩
        have hΦ_Xβ' : Φ Xβ' * uX =
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) Xβ' := by
          change (α_β (ev_β Xβ')).val * uX = _
          rw [hev_Xβ', hα_X]
          have hiso_mk : HomogeneousLocalization.Away.isLocalizationElem hXβ hXβ' =
              HomogeneousLocalization.Away.mk 𝒜 hXβ 1 (Xβ' ^ 1)
                (by simpa [one_smul, pow_one] using hXβ') := rfl
          rw [hiso_mk, HomogeneousLocalization.Away.val_mk]
          simpa [s_pow, pow_one] using hmk_mul Xβ' 1
        have hΦ_Xβ : Φ Xβ = 1 := by
          change (α_β (ev_β Xβ)).val = 1
          rw [hev_Xβ, map_one, HomogeneousLocalization.val_one]
        have hΦ_C : ∀ c : k, Φ (MvPolynomial.C c) =
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) (MvPolynomial.C c) := by
          intro c
          change (α_β (ev_β (MvPolynomial.C c))).val = _
          rw [hev_C, hα_C, hfrom0_val, hAlg0_val]
        have h_monom : ∀ d ∈ a.support,
            Φ (MvPolynomial.monomial d (a.coeff d)) * uX ^ n =
              algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ)
                (MvPolynomial.monomial d (a.coeff d)) := by
          intro d hd
          have hd_coeff : a.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
          rw [MvPolynomial.mem_homogeneousSubmodule] at ha
          have hd_decomp : d = d β • Finsupp.single β 1 + d β' • Finsupp.single β' 1 := by
            ext j
            fin_cases β <;> fin_cases β' <;> fin_cases j <;> simp at hne ⊢
          have hd_sum2 : d β + d β' = n := by
            have h1 : (Finsupp.weight 1) d = n • 1 := ha hd_coeff
            rw [hd_decomp, map_add, map_nsmul, map_nsmul] at h1
            have hw1 : ∀ j : Fin 2, (Finsupp.weight (1 : Fin 2 → ℕ)) (Finsupp.single j 1) = 1 := by
              intro j
              simp [Finsupp.weight_apply]
            rw [hw1 β, hw1 β'] at h1
            simpa [nsmul_eq_mul] using h1
          have hmon_single : ∀ (j : Fin 2) (m : ℕ),
              MvPolynomial.monomial (m • Finsupp.single j 1) (1 : k) =
                (MvPolynomial.X j : MvPolynomial (Fin 2) k) ^ m := by
            intro j m
            rw [MvPolynomial.X_pow_eq_monomial]
            simp
          have hmon_eq : MvPolynomial.monomial d (a.coeff d) =
              MvPolynomial.C (a.coeff d) * Xβ ^ (d β) * Xβ' ^ (d β') := by
            conv_lhs => rw [← mul_one (a.coeff d), ← MvPolynomial.C_mul_monomial, hd_decomp]
            have h11 : MvPolynomial.monomial (d β • Finsupp.single β 1 + d β' • Finsupp.single β' 1) (1 : k) =
                MvPolynomial.monomial (d β • Finsupp.single β 1) (1 : k) *
                  MvPolynomial.monomial (d β' • Finsupp.single β' 1) (1 : k) := by
              rw [MvPolynomial.monomial_mul_monomial, one_mul]
            rw [h11, hmon_single β (d β), hmon_single β' (d β'), ← hd_decomp, ← mul_assoc]
          rw [hmon_eq, ← hd_sum2, pow_add, map_mul, map_mul, map_pow, map_pow,
            hΦ_C, hΦ_Xβ, one_pow, mul_one]
          calc (algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) (MvPolynomial.C (a.coeff d)) *
                Φ Xβ' ^ d β') * (uX ^ d β * uX ^ d β')
              = algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) (MvPolynomial.C (a.coeff d)) *
                uX ^ d β * (Φ Xβ' * uX) ^ d β' := by
                  rw [mul_pow]; ring
            _ = algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ)
                  (MvPolynomial.C (a.coeff d) * Xβ ^ d β * Xβ' ^ d β') := by
                  rw [hΦ_Xβ']
                  simp [uX, map_mul, map_pow]
        have hΦ_mul : Φ a * uX ^ n =
            algebraMap (MvPolynomial (Fin 2) k) (Localization.Away Xβ) a := by
          conv_lhs => rw [MvPolynomial.as_sum a]
          conv_rhs => rw [MvPolynomial.as_sum a]
          rw [map_sum, Finset.sum_mul, map_sum]
          exact Finset.sum_congr rfl h_monom
        have h_eq_mul : Φ a * uX ^ n = Localization.mk a (s_pow n) * uX ^ n :=
          hΦ_mul.trans (hmk_mul a n).symm
        have h_u_inv_pow : uX ^ n * invX ^ n = 1 := by
          rw [← mul_pow, hu_inv, one_pow]
        calc Φ a = (Φ a * uX ^ n) * invX ^ n := by rw [mul_assoc, h_u_inv_pow, mul_one]
          _ = (Localization.mk a (s_pow n) * uX ^ n) * invX ^ n := by rw [h_eq_mul]
          _ = Localization.mk a (s_pow n) := by rw [mul_assoc, h_u_inv_pow, mul_one]
      exact ⟨α_β, β_β, hleft, hright, hα_C, hα_X⟩

    obtain ⟨α₀, β₀, hleft₀, hright₀, hα₀_C, hα₀_X⟩ := hChartEquiv 0 1 (by decide)
    obtain ⟨α₁, β₁, hleft₁, hright₁, hα₁_C, hα₁_X⟩ := hChartEquiv 1 0 (by decide)
    let hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin 2) k) ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k 0
    let hX1 : (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) ∈ 𝒜 1 := MvPolynomial.isHomogeneous_X k 1
    let iso_spec₀ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hright₀,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hleft₀,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let iso_spec₁ : AlgebraicGeometry.Spec (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₁)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hright₁,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hleft₁,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let e₀ : (U_P₁ 0).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one ≪≫ iso_spec₀
    let e₁ : (U_P₁ 1).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one ≪≫ iso_spec₁

    have he₀_ι : e₀.inv ≫ (U_P₁ 0).ι =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one :
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P₁.left) := by
      change (iso_spec₀.inv ≫ (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one).inv) ≫
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)).ι = _
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
      rfl
    have he₁_ι : e₁.inv ≫ (U_P₁ 1).ι =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁) ≫
          AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one :
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P₁.left) := by
      change (iso_spec₁.inv ≫ (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one).inv) ≫
        (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1)).ι = _
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
      rfl

    have he₀_hom : e₀.inv ≫ (U_P₁ 0).ι ≫ P₁.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      rw [← CategoryTheory.Category.assoc, he₀_ι]
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro c
      change β₀ (HomogeneousLocalization.fromZeroRingHom 𝒜 _ (algebraMap k ↥(𝒜 0) c)) = Polynomial.C c
      rw [← hα₀_C c]
      exact RingHom.congr_fun hleft₀ (Polynomial.C c)

    have he₁_hom : e₁.inv ≫ (U_P₁ 1).ι ≫ P₁.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      rw [← CategoryTheory.Category.assoc, he₁_ι]
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one) ≫
        (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero_assoc,
        ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro c
      change β₁ (HomogeneousLocalization.fromZeroRingHom 𝒜 _ (algebraMap k ↥(𝒜 0) c)) = Polynomial.C c
      rw [← hα₁_C c]
      exact RingHom.congr_fun hleft₁ (Polynomial.C c)

    have hpre₀₁ : (e₀.inv ≫ (U_P₁ 0).ι) ⁻¹ᵁ U_P₁ 1 =
        PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) := by
      rw [he₀_ι]
      change (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀)).base).obj
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1))) = _
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hX0 zero_lt_one hX1 zero_lt_one,
        AlgebraicGeometry.SpecMap_preimage_basicOpen]
      change PrimeSpectrum.basicOpen (β₀ (HomogeneousLocalization.Away.isLocalizationElem hX0 hX1)) = _
      rw [← hα₀_X, show β₀ (α₀ Polynomial.X) = Polynomial.X from RingHom.congr_fun hleft₀ Polynomial.X]

    have hpre₁₀ : (e₁.inv ≫ (U_P₁ 1).ι) ⁻¹ᵁ U_P₁ 0 =
        PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) := by
      rw [he₁_ι]
      change (TopologicalSpace.Opens.map (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁)).base).obj
          ((TopologicalSpace.Opens.map (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0))) = _
      rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 hX1 zero_lt_one hX0 zero_lt_one,
        AlgebraicGeometry.SpecMap_preimage_basicOpen]
      change PrimeSpectrum.basicOpen (β₁ (HomogeneousLocalization.Away.isLocalizationElem hX1 hX0)) = _
      rw [← hα₁_X, show β₁ (α₁ Polynomial.X) = Polynomial.X from RingHom.congr_fun hleft₁ Polynomial.X]

    have hTrans_k :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)))) ≫
          e₀.inv ≫ (U_P₁ 0).ι =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.eval₂RingHom
              ((algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))).comp
                Polynomial.C)
              (IsLocalization.Away.invSelf (Polynomial.X : Polynomial k)))) ≫
          e₁.inv ≫ (U_P₁ 1).ι := by
      let S₀₁ : MvPolynomial (Fin 2) k := MvPolynomial.X 0 * MvPolynomial.X 1
      let LocX := Localization.Away (Polynomial.X : Polynomial k)
      let ev₀₁ : MvPolynomial (Fin 2) k →+* LocX :=
        MvPolynomial.eval₂Hom ((algebraMap (Polynomial k) LocX).comp Polynomial.C)
          (fun j : Fin 2 => if j = 0 then 1 else algebraMap (Polynomial k) LocX Polynomial.X)
      have hev₀₁_0 : ev₀₁ (MvPolynomial.X 0) = 1 := by
        dsimp only [ev₀₁]
        rw [MvPolynomial.eval₂Hom_X']
        simp
      have hev₀₁_1 : ev₀₁ (MvPolynomial.X 1) = algebraMap (Polynomial k) LocX Polynomial.X := by
        dsimp only [ev₀₁]
        rw [MvPolynomial.eval₂Hom_X']
        have h10 : (1 : Fin 2) ≠ 0 := by decide
        simp [h10]
      have hev₀₁ : ev₀₁ S₀₁ * IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial k) = 1 := by
        change ev₀₁ (MvPolynomial.X 0 * MvPolynomial.X 1) * _ = 1
        rw [map_mul, hev₀₁_0, hev₀₁_1, one_mul]
        exact IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial k)
      obtain ⟨L₀₁, hL₀₁_alg, _, hL₀₁_mk⟩ :=
        hLiftInv ev₀₁ S₀₁ (IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial k)) hev₀₁
      let ω : HomogeneousLocalization.Away 𝒜 S₀₁ →+* LocX :=
        { toFun := fun z => L₀₁ z.val
          map_one' := by rw [HomogeneousLocalization.val_one, map_one]
          map_mul' := fun x y => by rw [HomogeneousLocalization.val_mul, map_mul]
          map_zero' := by rw [HomogeneousLocalization.val_zero, map_zero]
          map_add' := fun x y => by rw [HomogeneousLocalization.val_add, map_add] }
      have hω₀ : (algebraMap (Polynomial k) LocX).comp β₀ =
          ω.comp (HomogeneousLocalization.awayMap 𝒜 hX1 (rfl : S₀₁ = MvPolynomial.X 0 * MvPolynomial.X 1)) := by
        have h_pre : ((algebraMap (Polynomial k) LocX).comp β₀).comp α₀ =
            (ω.comp (HomogeneousLocalization.awayMap 𝒜 hX1 (rfl : S₀₁ = MvPolynomial.X 0 * MvPolynomial.X 1))).comp α₀ := by
          rw [RingHom.comp_assoc, hleft₀, RingHom.comp_id]
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            change algebraMap (Polynomial k) LocX (Polynomial.C c) =
              ω ((HomogeneousLocalization.awayMap 𝒜 hX1 rfl) (α₀ (Polynomial.C c)))
            rw [hα₀_C, HomogeneousLocalization.awayMap_fromZeroRingHom]
            change _ = L₀₁ (algebraMap (MvPolynomial (Fin 2) k) (Localization.Away S₀₁)
              (algebraMap k ↥(𝒜 0) c).1)
            rw [hL₀₁_alg, hAlg0_val]
            dsimp only [ev₀₁]
            rw [MvPolynomial.eval₂Hom_C]
            rfl
          · change algebraMap (Polynomial k) LocX Polynomial.X =
              ω ((HomogeneousLocalization.awayMap 𝒜 hX1 rfl) (α₀ Polynomial.X))
            rw [hα₀_X]
            have hiso_mk : HomogeneousLocalization.Away.isLocalizationElem hX0 hX1 =
                HomogeneousLocalization.Away.mk 𝒜 hX0 1 (MvPolynomial.X 1 ^ 1)
                  (by simpa [one_smul, pow_one] using hX1) := rfl
            rw [hiso_mk, HomogeneousLocalization.awayMap_mk]
            change _ = L₀₁ (HomogeneousLocalization.Away.mk 𝒜 _ 1
              (MvPolynomial.X 1 ^ 1 * MvPolynomial.X 1 ^ 1) _).val
            rw [HomogeneousLocalization.Away.val_mk, hL₀₁_mk, pow_one, pow_one, map_mul,
              hev₀₁_1, mul_assoc, IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial k), mul_one]
        calc (algebraMap (Polynomial k) LocX).comp β₀
            = (((algebraMap (Polynomial k) LocX).comp β₀).comp α₀).comp β₀ := by
                rw [RingHom.comp_assoc, hright₀, RingHom.comp_id]
          _ = ((ω.comp (HomogeneousLocalization.awayMap 𝒜 hX1 rfl)).comp α₀).comp β₀ := by
                rw [h_pre]
          _ = ω.comp (HomogeneousLocalization.awayMap 𝒜 hX1 rfl) := by
                rw [RingHom.comp_assoc, hright₀, RingHom.comp_id]
      let τ_k : Polynomial k →+* LocX :=
        Polynomial.eval₂RingHom ((algebraMap (Polynomial k) LocX).comp Polynomial.C)
          (IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial k))
      have hω₁ : τ_k.comp β₁ =
          ω.comp (HomogeneousLocalization.awayMap 𝒜 hX0
            (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1) : S₀₁ = MvPolynomial.X 1 * MvPolynomial.X 0)) := by
        have h_pre : (τ_k.comp β₁).comp α₁ =
            (ω.comp (HomogeneousLocalization.awayMap 𝒜 hX0
              (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1)))).comp α₁ := by
          rw [RingHom.comp_assoc, hleft₁, RingHom.comp_id]
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro c
            change τ_k (Polynomial.C c) =
              ω ((HomogeneousLocalization.awayMap 𝒜 hX0 _) (α₁ (Polynomial.C c)))
            rw [show τ_k (Polynomial.C c) = algebraMap (Polynomial k) LocX (Polynomial.C c) from
              Polynomial.eval₂_C _ _, hα₁_C, HomogeneousLocalization.awayMap_fromZeroRingHom]
            change _ = L₀₁ (algebraMap (MvPolynomial (Fin 2) k) (Localization.Away S₀₁)
              (algebraMap k ↥(𝒜 0) c).1)
            rw [hL₀₁_alg, hAlg0_val]
            dsimp only [ev₀₁]
            rw [MvPolynomial.eval₂Hom_C]
            rfl
          · change τ_k Polynomial.X =
              ω ((HomogeneousLocalization.awayMap 𝒜 hX0 _) (α₁ Polynomial.X))
            rw [show τ_k Polynomial.X = IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial k) from
              Polynomial.eval₂_X _ _, hα₁_X]
            have hiso_mk : HomogeneousLocalization.Away.isLocalizationElem hX1 hX0 =
                HomogeneousLocalization.Away.mk 𝒜 hX1 1 (MvPolynomial.X 0 ^ 1)
                  (by simpa [one_smul, pow_one] using hX0) := rfl
            rw [hiso_mk, HomogeneousLocalization.awayMap_mk]
            change _ = L₀₁ (HomogeneousLocalization.Away.mk 𝒜 _ 1
              (MvPolynomial.X 0 ^ 1 * MvPolynomial.X 0 ^ 1) _).val
            rw [HomogeneousLocalization.Away.val_mk, hL₀₁_mk, pow_one, pow_one, map_mul,
              hev₀₁_0, one_mul, one_mul]
        calc τ_k.comp β₁
            = ((τ_k.comp β₁).comp α₁).comp β₁ := by
                rw [RingHom.comp_assoc, hright₁, RingHom.comp_id]
          _ = ((ω.comp (HomogeneousLocalization.awayMap 𝒜 hX0 _)).comp α₁).comp β₁ := by
                rw [h_pre]
          _ = ω.comp (HomogeneousLocalization.awayMap 𝒜 hX0 _) := by
                rw [RingHom.comp_assoc, hright₁, RingHom.comp_id]
      rw [he₀_ι, he₁_ι]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) LocX)) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₀) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) hX0 zero_lt_one) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_k) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β₁) ≫
            AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) hX1 zero_lt_one)
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hω₀, hω₁,
        CommRingCat.ofHom_comp, CommRingCat.ofHom_comp,
        AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 hX0 zero_lt_one hX1
          (rfl : S₀₁ = MvPolynomial.X 0 * MvPolynomial.X 1),
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜 hX1 zero_lt_one hX0
          (mul_comm (MvPolynomial.X 0) (MvPolynomial.X 1) : S₀₁ = MvPolynomial.X 1 * MvPolynomial.X 0)]

    exact ⟨U_P₁ 0, U_P₁ 1, e₀, e₁, hCov_sup, he₀_hom, he₁_hom, hpre₀₁, hpre₁₀, hTrans_k⟩

  
  
  
  have hBaseChange :
      ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
        (E_A E_B : AlgebraicGeometry.Scheme.{u})
        (p_A : E_A ⟶ AlgebraicGeometry.Spec (CommRingCat.of A))
        (p_B : E_B ⟶ AlgebraicGeometry.Spec (CommRingCat.of B))
        (f_B : E_B ⟶ E_A),
        CategoryTheory.IsPullback f_B p_B p_A
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B))) →
        ∀ (W₀ : E_A.Opens)
          (e_W₀ : W₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial A))),
          e_W₀.inv ≫ W₀.ι ≫ p_A = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
          ∃ (e_WB : (f_B ⁻¹ᵁ W₀).toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B))),
            e_WB.inv ≫ (f_B ⁻¹ᵁ W₀).ι ≫ p_B =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
            e_WB.inv ≫ (f_B ⁻¹ᵁ W₀).ι ≫ f_B =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap A B))) ≫
                e_W₀.inv ≫ W₀.ι := by
    intro A B _ _ _ E_A E_B p_A p_B f_B hPb W₀ e_W₀ he_W₀
    let π_AB := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B))
    let π_polyA := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))
    let W_B : E_B.Opens := f_B ⁻¹ᵁ W₀
    have hW_pA : W₀.ι ≫ p_A = e_W₀.hom ≫ π_polyA := by
      change W₀.ι ≫ p_A = e_W₀.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
      rw [← he_W₀, ← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
        CategoryTheory.Category.id_comp]
    have hTop : CategoryTheory.IsPullback (f_B ∣_ W₀) W_B.ι W₀.ι f_B :=
      AlgebraicGeometry.isPullback_morphismRestrict f_B W₀
    have hSq : CategoryTheory.IsPullback (W_B.ι ≫ p_B) (f_B ∣_ W₀) π_AB (W₀.ι ≫ p_A) :=
      (hTop.paste_vert hPb).flip
    have hcomm_hom : (W_B.ι ≫ p_B) ≫ π_AB = ((f_B ∣_ W₀) ≫ e_W₀.hom) ≫ π_polyA := by
      rw [CategoryTheory.Category.assoc (f_B ∣_ W₀), ← hW_pA]
      exact hSq.w
    have hcomm_inv : CategoryTheory.Limits.pullback.fst π_AB π_polyA ≫ π_AB =
        (CategoryTheory.Limits.pullback.snd π_AB π_polyA ≫ e_W₀.inv) ≫ (W₀.ι ≫ p_A) := by
      rw [hW_pA, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_W₀.inv,
        CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp,
        CategoryTheory.Limits.pullback.condition]
    let iso_pb : W_B.toScheme ≅ CategoryTheory.Limits.pullback π_AB π_polyA :=
      { hom := CategoryTheory.Limits.pullback.lift (W_B.ι ≫ p_B) ((f_B ∣_ W₀) ≫ e_W₀.hom) hcomm_hom
        inv := hSq.lift (CategoryTheory.Limits.pullback.fst π_AB π_polyA)
          (CategoryTheory.Limits.pullback.snd π_AB π_polyA ≫ e_W₀.inv) hcomm_inv
        hom_inv_id := by
          apply hSq.hom_ext
          · rw [CategoryTheory.Category.assoc, hSq.lift_fst, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, hSq.lift_snd,
              ← CategoryTheory.Category.assoc _ _ e_W₀.inv, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hSq.lift_fst, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc _ _ e_W₀.hom, hSq.lift_snd,
              CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    let e_alg : TensorProduct A B (Polynomial A) ≃ₐ[B] Polynomial B := (polyEquivTensor' A B).symm
    let iso_poly : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A B (Polynomial A))) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_alg.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_alg.symm.toRingHom.comp e_alg.toRingHom = RingHom.id _ :=
            RingHom.ext e_alg.symm_apply_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : e_alg.toRingHom.comp e_alg.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_alg.apply_symm_apply
          rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let e_WB : W_B.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B)) :=
      iso_pb ≪≫ AlgebraicGeometry.pullbackSpecIso A B (Polynomial A) ≪≫ iso_poly
    refine ⟨e_WB, ?_, ?_⟩
    · change (iso_poly.inv ≫ (AlgebraicGeometry.pullbackSpecIso A B (Polynomial A)).inv ≫ iso_pb.inv) ≫
        (W_B.ι ≫ p_B) = _
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hSq.lift_fst]
      dsimp only [π_AB, π_polyA, iso_poly]
      rw [AlgebraicGeometry.pullbackSpecIso_inv_fst A B (Polynomial A),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro b
      change e_alg (b ⊗ₜ[A] 1) = Polynomial.C b
      exact e_alg.commutes b
    · have hiso_pb_f : iso_pb.inv ≫ W_B.ι ≫ f_B =
          CategoryTheory.Limits.pullback.snd π_AB π_polyA ≫ e_W₀.inv ≫ W₀.ι := by
        rw [← AlgebraicGeometry.morphismRestrict_ι f_B W₀, ← CategoryTheory.Category.assoc,
          hSq.lift_snd, CategoryTheory.Category.assoc]
      change (iso_poly.inv ≫ (AlgebraicGeometry.pullbackSpecIso A B (Polynomial A)).inv ≫ iso_pb.inv) ≫
        (W_B.ι ≫ f_B) = _
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hiso_pb_f,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.pullbackSpecIso A B (Polynomial A)).inv,
        AlgebraicGeometry.pullbackSpecIso_inv_snd A B (Polynomial A),
        ← CategoryTheory.Category.assoc iso_poly.inv]
      dsimp only [iso_poly]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      congr 1
      congr 1
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro a
        change e_alg (1 ⊗ₜ[A] Polynomial.C a) = (Polynomial.mapRingHom (algebraMap A B)) (Polynomial.C a)
        rw [Polynomial.coe_mapRingHom, Polynomial.map_C]
        apply e_alg.symm.injective
        rw [e_alg.symm_apply_apply]
        dsimp only [e_alg]
        change 1 ⊗ₜ[A] algebraMap A (Polynomial A) a =
          polyEquivTensor' A B (Polynomial.C (algebraMap A B a))
        rw [← Algebra.TensorProduct.tmul_one_eq_one_tmul]
        exact ((polyEquivTensor' A B).commutes (algebraMap A B a)).symm
      · change e_alg (1 ⊗ₜ[A] Polynomial.X) = (Polynomial.mapRingHom (algebraMap A B)) Polynomial.X
        rw [Polynomial.coe_mapRingHom, Polynomial.map_X]
        apply e_alg.symm.injective
        rw [e_alg.symm_apply_apply]
        simp [e_alg, polyEquivTensor']

  
  
  
  have hTwoChartCompl :
      ∀ (L : Type u) [Field L]
        (P : AlgebraicGeometry.Scheme.{u})
        (p_L : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of L))
        (V₀ V₁ : P.Opens),
        V₀ ⊔ V₁ = ⊤ →
        ∀ (e₀ : V₀.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L)))
          (e₁ : V₁.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L))),
          e₀.inv ≫ V₀.ι ≫ p_L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
          e₁.inv ≫ V₁.ι ≫ p_L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
          (e₀.inv ≫ V₀.ι) ⁻¹ᵁ V₁ = PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) →
          (e₁.inv ≫ V₁.ι) ⁻¹ᵁ V₀ = PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) →
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap (Polynomial L) (Localization.Away (Polynomial.X : Polynomial L)))) ≫
            e₀.inv ≫ V₀.ι =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (Polynomial.eval₂RingHom
                ((algebraMap (Polynomial L) (Localization.Away (Polynomial.X : Polynomial L))).comp
                  Polynomial.C)
                (IsLocalization.Away.invSelf (Polynomial.X : Polynomial L)))) ≫
            e₁.inv ≫ V₁.ι →
          ∀ (σ_L : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ P),
            σ_L ≫ p_L = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of L)) →
            ∃ (ι_w : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L)) ⟶ P),
              AlgebraicGeometry.IsOpenImmersion ι_w ∧
              ι_w ≫ p_L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) ∧
              Set.range ι_w.base = (Set.range σ_L.base)ᶜ := by
    intro L _ P p_L V₀ V₁ hCov e₀ e₁ he₀_p he₁_p hpre₀₁ hpre₁₀ hTrans σ_L hσ_sec
    let S_L := AlgebraicGeometry.Spec (CommRingCat.of L)
    let W_src := AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L))
    let pt_L : ↥S_L := (⊥ : PrimeSpectrum L)
    have hSub_L : Subsingleton ↥S_L := by
      change Subsingleton (PrimeSpectrum L)
      infer_instance
    let q_inf : ↥P := σ_L.base pt_L
    have hRange_σ : Set.range σ_L.base = {q_inf} := by
      ext y
      constructor
      · rintro ⟨u, rfl⟩
        rw [hSub_L.elim u pt_L, Set.mem_singleton_iff]
      · rintro rfl
        exact ⟨pt_L, rfl⟩

    let j₀ : W_src ⟶ P := e₀.inv ≫ V₀.ι
    let j₁ : W_src ⟶ P := e₁.inv ≫ V₁.ι
    have : CategoryTheory.IsIso e₀.inv := e₀.isIso_inv
    have : CategoryTheory.IsIso e₁.inv := e₁.isIso_inv
    have hOpen_j₀ : AlgebraicGeometry.IsOpenImmersion j₀ := by dsimp [j₀]; infer_instance
    have hOpen_j₁ : AlgebraicGeometry.IsOpenImmersion j₁ := by dsimp [j₁]; infer_instance
    have : AlgebraicGeometry.IsOpenImmersion j₀ := hOpen_j₀
    have : AlgebraicGeometry.IsOpenImmersion j₁ := hOpen_j₁

    have hRange_j₀ : Set.range j₀.base = (V₀ : Set ↥P) := by
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι V₀]
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        exact ⟨e₀.inv.base x, rfl⟩
      · rintro ⟨u, rfl⟩
        refine ⟨e₀.hom.base u, ?_⟩
        change V₀.ι.base ((e₀.hom ≫ e₀.inv).base u) = V₀.ι.base u
        rw [e₀.hom_inv_id]
        rfl

    have hRange_j₁ : Set.range j₁.base = (V₁ : Set ↥P) := by
      rw [← AlgebraicGeometry.Scheme.Opens.range_ι V₁]
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        exact ⟨e₁.inv.base x, rfl⟩
      · rintro ⟨u, rfl⟩
        refine ⟨e₁.hom.base u, ?_⟩
        change V₁.ι.base ((e₁.hom ≫ e₁.inv).base u) = V₁.ι.base u
        rw [e₁.hom_inv_id]
        rfl

    
    let m_pt : L → ↥W_src :=
      fun a => (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom a))).base pt_L
    have hLinearZero : ∀ (a : L) (q : ↥W_src),
        Polynomial.X - Polynomial.C a ∈ (q : PrimeSpectrum (Polynomial L)).asIdeal ↔ q = m_pt a := by
      intro a q
      constructor
      · intro hXa
        apply PrimeSpectrum.ext
        ext f
        have hroot : Polynomial.IsRoot (f - Polynomial.C (f.eval a)) a := by
          simp [Polynomial.IsRoot]
        obtain ⟨k_pol, hk_pol⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
        have hsub_mem : f - Polynomial.C (f.eval a) ∈ (q : PrimeSpectrum (Polynomial L)).asIdeal := by
          rw [hk_pol]
          exact (q : PrimeSpectrum (Polynomial L)).asIdeal.mul_mem_right k_pol hXa
        have hf_iff : f ∈ (q : PrimeSpectrum (Polynomial L)).asIdeal ↔
            Polynomial.C (f.eval a) ∈ (q : PrimeSpectrum (Polynomial L)).asIdeal := by
          constructor
          · intro hf
            have h1 := (q : PrimeSpectrum (Polynomial L)).asIdeal.sub_mem hf hsub_mem
            simpa using h1
          · intro hC
            have h1 := (q : PrimeSpectrum (Polynomial L)).asIdeal.add_mem hsub_mem hC
            simpa using h1
        rw [hf_iff]
        change Polynomial.C (f.eval a) ∈ (q : PrimeSpectrum (Polynomial L)).asIdeal ↔
          f.eval a ∈ (⊥ : Ideal L)
        rw [Ideal.mem_bot]
        constructor
        · intro hC
          by_contra hne0
          have hunit_mem : (1 : Polynomial L) ∈ (q : PrimeSpectrum (Polynomial L)).asIdeal := by
            have hmul : Polynomial.C (f.eval a) * Polynomial.C (f.eval a)⁻¹ = 1 := by
              rw [← Polynomial.C_mul, mul_inv_cancel₀ hne0, Polynomial.C_1]
            rw [← hmul]
            exact (q : PrimeSpectrum (Polynomial L)).asIdeal.mul_mem_right _ hC
          exact (q : PrimeSpectrum (Polynomial L)).isPrime.ne_top
            (Ideal.eq_top_of_isUnit_mem _ hunit_mem isUnit_one)
        · intro hev0
          rw [hev0, Polynomial.C_0]
          exact (q : PrimeSpectrum (Polynomial L)).asIdeal.zero_mem
      · rintro rfl
        change (Polynomial.evalRingHom a) (Polynomial.X - Polynomial.C a) ∈ (⊥ : Ideal L)
        rw [Ideal.mem_bot]
        simp

    have hZeroX : ∀ q : ↥W_src,
        q ∉ (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) ↔ q = m_pt 0 := by
      intro q
      rw [hMemBasic, Classical.not_not, ← hLinearZero 0 q]
      simp

    
    by_cases hq₀ : q_inf ∈ V₀
    · by_cases hq₁ : q_inf ∈ V₁
      · 
        have hσ_sub₀ : Set.range σ_L.base ⊆ Set.range j₀.base := by
          rw [hRange_σ, hRange_j₀, Set.singleton_subset_iff]
          exact hq₀
        let σ₀ : S_L ⟶ W_src := AlgebraicGeometry.IsOpenImmersion.lift j₀ σ_L hσ_sub₀
        have hσ₀_fac : σ₀ ≫ j₀ = σ_L := AlgebraicGeometry.IsOpenImmersion.lift_fac j₀ σ_L hσ_sub₀
        have hσ₀_p : σ₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) = 𝟙 S_L := by
          calc σ₀ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
              = σ₀ ≫ (j₀ ≫ p_L) := by
                  dsimp only [j₀]
                  rw [CategoryTheory.Category.assoc, he₀_p]
            _ = (σ₀ ≫ j₀) ≫ p_L := (CategoryTheory.Category.assoc _ _ _).symm
            _ = 𝟙 S_L := by rw [hσ₀_fac, hσ_sec]
        let χ₀_hom : CommRingCat.of (Polynomial L) ⟶ CommRingCat.of L :=
          AlgebraicGeometry.Spec.preimage σ₀
        have hmap_χ₀ : AlgebraicGeometry.Spec.map χ₀_hom = σ₀ :=
          AlgebraicGeometry.Spec.map_preimage σ₀
        have hχ₀_C : χ₀_hom.hom.comp Polynomial.C = RingHom.id L := by
          have h1 : CommRingCat.ofHom Polynomial.C ≫ χ₀_hom = 𝟙 (CommRingCat.of L) := by
            apply AlgebraicGeometry.Spec.map_injective
            rw [AlgebraicGeometry.Spec.map_comp, hmap_χ₀, hσ₀_p, AlgebraicGeometry.Spec.map_id]
          ext a
          exact congrArg (fun φ : CommRingCat.of L ⟶ CommRingCat.of L => φ.hom a) h1
        let c : L := χ₀_hom.hom Polynomial.X
        have hχ₀_eq : χ₀_hom.hom = Polynomial.evalRingHom c := by
          apply Polynomial.ringHom_ext'
          · rw [hχ₀_C]
            ext a
            simp
          · simp [c]
        have hσ₀_pt : σ₀.base pt_L = m_pt c := by
          rw [← hmap_χ₀]
          have hch : χ₀_hom = CommRingCat.ofHom (Polynomial.evalRingHom c) :=
            CommRingCat.hom_ext hχ₀_eq
          rw [hch]
        have hj₀_mc : j₀.base (m_pt c) = q_inf := by
          rw [← hσ₀_pt]
          change (σ₀ ≫ j₀).base pt_L = q_inf
          rw [hσ₀_fac]

        have hmc_in_X : m_pt c ∈ (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) := by
          rw [← hpre₀₁]
          change j₀.base (m_pt c) ∈ V₁
          rw [hj₀_mc]
          exact hq₁
        have hc_ne : c ≠ 0 := by
          rw [hMemBasic] at hmc_in_X
          intro hc0
          apply hmc_in_X
          change (Polynomial.evalRingHom c) Polynomial.X ∈ (⊥ : Ideal L)
          rw [Ideal.mem_bot]
          simp [hc0]

        
        let LocX := Localization.Away (Polynomial.X : Polynomial L)
        let τ_L : Polynomial L →+* LocX :=
          Polynomial.eval₂RingHom ((algebraMap (Polynomial L) LocX).comp Polynomial.C)
            (IsLocalization.Away.invSelf (Polynomial.X : Polynomial L))
        have hZeroH1 : ∀ q : ↥W_src,
            q ∉ (PrimeSpectrum.basicOpen (1 - Polynomial.C c * Polynomial.X) : W_src.Opens) ↔
              q = m_pt c⁻¹ := by
          intro q
          rw [hMemBasic, Classical.not_not, ← hLinearZero c⁻¹ q]
          have hfac : 1 - Polynomial.C c * Polynomial.X =
              Polynomial.C (-c) * (Polynomial.X - Polynomial.C c⁻¹) := by
            rw [mul_sub, ← Polynomial.C_mul, neg_mul, mul_inv_cancel₀ hc_ne,
              Polynomial.C_neg, Polynomial.C_neg, Polynomial.C_1]
            ring
          have hinv_fac : Polynomial.X - Polynomial.C c⁻¹ =
              Polynomial.C (-c)⁻¹ * (1 - Polynomial.C c * Polynomial.X) := by
            rw [hfac, ← mul_assoc, ← Polynomial.C_mul, inv_mul_cancel₀ (neg_ne_zero.mpr hc_ne),
              Polynomial.C_1, one_mul]
          constructor
          · intro hmem
            rw [hinv_fac]
            exact (q : PrimeSpectrum (Polynomial L)).asIdeal.mul_mem_left _ hmem
          · intro hmem
            rw [hfac]
            exact (q : PrimeSpectrum (Polynomial L)).asIdeal.mul_mem_left _ hmem

        have hj₁_mcinv : j₁.base (m_pt c⁻¹) = q_inf := by
          have hmc_range : (m_pt c : PrimeSpectrum (Polynomial L)) ∈
              Set.range (PrimeSpectrum.comap (algebraMap (Polynomial L) LocX)) := by
            rw [PrimeSpectrum.localization_away_comap_range LocX (Polynomial.X : Polynomial L)]
            exact hmc_in_X
          obtain ⟨m_loc, hm_loc⟩ := hmc_range
          let m_loc_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of LocX)) := m_loc
          have hloc_j₀ :
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) LocX)) ≫ j₀).base
                m_loc_pt = q_inf := by
            change j₀.base (PrimeSpectrum.comap (algebraMap (Polynomial L) LocX) m_loc) = q_inf
            rw [hm_loc]
            exact hj₀_mc
          rw [hTrans] at hloc_j₀
          let q₁_pt : ↥W_src :=
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L)).base m_loc_pt
          have hq₁_j₁ : j₁.base q₁_pt = q_inf := hloc_j₀
          have hq₁_eq : q₁_pt = m_pt c⁻¹ := by
            rw [← hZeroH1 q₁_pt, hMemBasic, Classical.not_not, hSpecBase]
            have hτ_val : τ_L (1 - Polynomial.C c * Polynomial.X) =
                algebraMap (Polynomial L) LocX (Polynomial.X - Polynomial.C c) *
                  IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial L) := by
              have hτ_C : τ_L (Polynomial.C c) = algebraMap (Polynomial L) LocX (Polynomial.C c) :=
                Polynomial.eval₂_C _ _
              have hτ_X : τ_L Polynomial.X = IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial L) :=
                Polynomial.eval₂_X _ _
              have hτ_1 : τ_L (1 - Polynomial.C c * Polynomial.X) =
                  1 - algebraMap (Polynomial L) LocX (Polynomial.C c) *
                    IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial L) := by
                rw [map_sub, map_one, map_mul, hτ_C, hτ_X]
              rw [hτ_1, map_sub, sub_mul, IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial L)]
            rw [hτ_val]
            apply (m_loc_pt : PrimeSpectrum LocX).asIdeal.mul_mem_right
            have hm_xc : Polynomial.X - Polynomial.C c ∈
                (PrimeSpectrum.comap (algebraMap (Polynomial L) LocX) m_loc).asIdeal := by
              rw [hm_loc]
              exact (hLinearZero c (m_pt c)).mpr rfl
            exact hm_xc
          rw [← hq₁_eq]
          exact hq₁_j₁

        
        have hLocIso : ∀ (f : Polynomial L) (U_f : W_src.Opens),
            U_f = PrimeSpectrum.basicOpen f →
            ∃ (e_f : U_f.toScheme ≅ AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f))),
              e_f.hom ≫ AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away f))) = U_f.ι ∧
              e_f.inv ≫ U_f.ι =
                AlgebraicGeometry.Spec.map
                  (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away f))) := by
          intro f U_f hU_f
          let loc_f : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)) ⟶ W_src :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away f)))
          have : AlgebraicGeometry.IsOpenImmersion loc_f :=
            AlgebraicGeometry.IsOpenImmersion.of_isLocalization f
          have hrange : Set.range U_f.ι.base = Set.range loc_f.base := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι, hU_f]
            exact (PrimeSpectrum.localization_away_comap_range (Localization.Away f) f).symm
          exact ⟨AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq U_f.ι loc_f hrange,
            AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac U_f.ι loc_f hrange,
            AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_inv_fac U_f.ι loc_f hrange⟩

        let g₀ : Polynomial L := Polynomial.X
        let g₁ : Polynomial L := 1 + Polynomial.C c * Polynomial.X
        let h₀ : Polynomial L := Polynomial.X - Polynomial.C c
        let h₁ : Polynomial L := 1 - Polynomial.C c * Polynomial.X
        let A₀ : W_src.Opens := PrimeSpectrum.basicOpen g₀
        let A₁ : W_src.Opens := PrimeSpectrum.basicOpen g₁

        have hCov_A : A₀ ⊔ A₁ = ⊤ := by
          rw [eq_top_iff]
          intro q _
          by_cases hqA₀ : q ∈ A₀
          · exact Or.inl hqA₀
          · right
            change q ∉ (PrimeSpectrum.basicOpen g₀ : W_src.Opens) at hqA₀
            change q ∈ (PrimeSpectrum.basicOpen g₁ : W_src.Opens)
            rw [hMemBasic] at hqA₀ ⊢
            rw [Classical.not_not] at hqA₀
            intro hqA₁
            have h1_mem : (1 : Polynomial L) ∈ (q : PrimeSpectrum (Polynomial L)).asIdeal := by
              have hsub : g₁ - Polynomial.C c * g₀ = 1 := by
                dsimp [g₀, g₁]; ring
              rw [← hsub]
              exact (q : PrimeSpectrum (Polynomial L)).asIdeal.sub_mem hqA₁
                ((q : PrimeSpectrum (Polynomial L)).asIdeal.mul_mem_left _ hqA₀)
            exact (q : PrimeSpectrum (Polynomial L)).isPrime.ne_top
              (Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one)

        obtain ⟨e_g0, he_g0_hom, he_g0_inv⟩ := hLocIso g₀ A₀ rfl
        obtain ⟨e_g1, he_g1_hom, he_g1_inv⟩ := hLocIso g₁ A₁ rfl

        
        let F₀ : Polynomial L →+* Localization.Away g₀ :=
          Polynomial.eval₂RingHom
            ((algebraMap (Polynomial L) (Localization.Away g₀)).comp Polynomial.C)
            (algebraMap (Polynomial L) (Localization.Away g₀) (Polynomial.C c) +
              IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀)
        let G₀ : Polynomial L →+* Localization.Away h₀ :=
          Polynomial.eval₂RingHom
            ((algebraMap (Polynomial L) (Localization.Away h₀)).comp Polynomial.C)
            (IsLocalization.Away.invSelf (S := Localization.Away h₀) h₀)
        have hF₀_C : ∀ a : L, F₀ (Polynomial.C a) =
            algebraMap (Polynomial L) (Localization.Away g₀) (Polynomial.C a) :=
          fun _ => Polynomial.eval₂_C _ _
        have hF₀_X : F₀ Polynomial.X =
            algebraMap (Polynomial L) (Localization.Away g₀) (Polynomial.C c) +
              IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀ :=
          Polynomial.eval₂_X _ _
        have hG₀_C : ∀ a : L, G₀ (Polynomial.C a) =
            algebraMap (Polynomial L) (Localization.Away h₀) (Polynomial.C a) :=
          fun _ => Polynomial.eval₂_C _ _
        have hG₀_X : G₀ Polynomial.X =
            IsLocalization.Away.invSelf (S := Localization.Away h₀) h₀ :=
          Polynomial.eval₂_X _ _
        have hF₀_h₀ : F₀ h₀ * algebraMap (Polynomial L) (Localization.Away g₀) g₀ = 1 := by
          dsimp only [h₀]
          rw [map_sub, hF₀_X, hF₀_C, add_sub_cancel_left, mul_comm, IsLocalization.Away.mul_invSelf]
        have hG₀_g₀ : G₀ g₀ * algebraMap (Polynomial L) (Localization.Away h₀) h₀ = 1 := by
          dsimp only [g₀]
          rw [hG₀_X, mul_comm, IsLocalization.Away.mul_invSelf]
        obtain ⟨tilde_F₀, hTF₀_alg, hTF₀_inv, _⟩ :=
          hLiftInv F₀ h₀ (algebraMap (Polynomial L) (Localization.Away g₀) g₀) hF₀_h₀
        obtain ⟨tilde_G₀, hTG₀_alg, hTG₀_inv, _⟩ :=
          hLiftInv G₀ g₀ (algebraMap (Polynomial L) (Localization.Away h₀) h₀) hG₀_g₀
        have hGF₀ : tilde_G₀.comp tilde_F₀ = RingHom.id (Localization.Away h₀) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers h₀)
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro a
            change tilde_G₀ (tilde_F₀ (algebraMap _ _ (Polynomial.C a))) = algebraMap _ _ (Polynomial.C a)
            rw [hTF₀_alg, hF₀_C, hTG₀_alg, hG₀_C]
          · change tilde_G₀ (tilde_F₀ (algebraMap _ _ Polynomial.X)) = algebraMap _ _ Polynomial.X
            rw [hTF₀_alg, hF₀_X, map_add, hTG₀_alg, hG₀_C, hTG₀_inv]
            dsimp only [h₀]
            rw [map_sub, add_sub_cancel]
        have hFG₀ : tilde_F₀.comp tilde_G₀ = RingHom.id (Localization.Away g₀) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers g₀)
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro a
            change tilde_F₀ (tilde_G₀ (algebraMap _ _ (Polynomial.C a))) = algebraMap _ _ (Polynomial.C a)
            rw [hTG₀_alg, hG₀_C, hTF₀_alg, hF₀_C]
          · change tilde_F₀ (tilde_G₀ (algebraMap _ _ Polynomial.X)) = algebraMap _ _ Polynomial.X
            rw [hTG₀_alg, hG₀_X, hTF₀_inv]

        
        let F₁ : Polynomial L →+* Localization.Away g₁ :=
          Polynomial.eval₂RingHom
            ((algebraMap (Polynomial L) (Localization.Away g₁)).comp Polynomial.C)
            (algebraMap (Polynomial L) (Localization.Away g₁) Polynomial.X *
              IsLocalization.Away.invSelf (S := Localization.Away g₁) g₁)
        let G₁ : Polynomial L →+* Localization.Away h₁ :=
          Polynomial.eval₂RingHom
            ((algebraMap (Polynomial L) (Localization.Away h₁)).comp Polynomial.C)
            (algebraMap (Polynomial L) (Localization.Away h₁) Polynomial.X *
              IsLocalization.Away.invSelf (S := Localization.Away h₁) h₁)
        have hF₁_C : ∀ a : L, F₁ (Polynomial.C a) =
            algebraMap (Polynomial L) (Localization.Away g₁) (Polynomial.C a) :=
          fun _ => Polynomial.eval₂_C _ _
        have hF₁_X : F₁ Polynomial.X =
            algebraMap (Polynomial L) (Localization.Away g₁) Polynomial.X *
              IsLocalization.Away.invSelf (S := Localization.Away g₁) g₁ :=
          Polynomial.eval₂_X _ _
        have hG₁_C : ∀ a : L, G₁ (Polynomial.C a) =
            algebraMap (Polynomial L) (Localization.Away h₁) (Polynomial.C a) :=
          fun _ => Polynomial.eval₂_C _ _
        have hG₁_X : G₁ Polynomial.X =
            algebraMap (Polynomial L) (Localization.Away h₁) Polynomial.X *
              IsLocalization.Away.invSelf (S := Localization.Away h₁) h₁ :=
          Polynomial.eval₂_X _ _
        have hF₁_h₁ : F₁ h₁ * algebraMap (Polynomial L) (Localization.Away g₁) g₁ = 1 := by
          dsimp only [h₁]
          rw [map_sub, map_one, map_mul, hF₁_C, hF₁_X, sub_mul, one_mul]
          have hmul : (algebraMap (Polynomial L) (Localization.Away g₁) (Polynomial.C c) *
              (algebraMap (Polynomial L) (Localization.Away g₁) Polynomial.X *
                IsLocalization.Away.invSelf (S := Localization.Away g₁) g₁)) *
              algebraMap (Polynomial L) (Localization.Away g₁) g₁ =
              algebraMap (Polynomial L) (Localization.Away g₁) (Polynomial.C c * Polynomial.X) := by
            calc _ = algebraMap (Polynomial L) (Localization.Away g₁) (Polynomial.C c * Polynomial.X) *
                  (algebraMap (Polynomial L) (Localization.Away g₁) g₁ *
                    IsLocalization.Away.invSelf (S := Localization.Away g₁) g₁) := by
                  rw [map_mul]; ring
              _ = _ := by rw [IsLocalization.Away.mul_invSelf, mul_one]
          rw [hmul, ← map_sub]
          have hsub : g₁ - Polynomial.C c * Polynomial.X = 1 := by dsimp [g₁]; ring
          rw [hsub, map_one]
        have hG₁_g₁ : G₁ g₁ * algebraMap (Polynomial L) (Localization.Away h₁) h₁ = 1 := by
          dsimp only [g₁]
          rw [map_add, map_one, map_mul, hG₁_C, hG₁_X, add_mul, one_mul]
          have hmul : (algebraMap (Polynomial L) (Localization.Away h₁) (Polynomial.C c) *
              (algebraMap (Polynomial L) (Localization.Away h₁) Polynomial.X *
                IsLocalization.Away.invSelf (S := Localization.Away h₁) h₁)) *
              algebraMap (Polynomial L) (Localization.Away h₁) h₁ =
              algebraMap (Polynomial L) (Localization.Away h₁) (Polynomial.C c * Polynomial.X) := by
            calc _ = algebraMap (Polynomial L) (Localization.Away h₁) (Polynomial.C c * Polynomial.X) *
                  (algebraMap (Polynomial L) (Localization.Away h₁) h₁ *
                    IsLocalization.Away.invSelf (S := Localization.Away h₁) h₁) := by
                  rw [map_mul]; ring
              _ = _ := by rw [IsLocalization.Away.mul_invSelf, mul_one]
          rw [hmul, ← map_add]
          have hadd : h₁ + Polynomial.C c * Polynomial.X = 1 := by dsimp [h₁]; ring
          rw [hadd, map_one]
        obtain ⟨tilde_F₁, hTF₁_alg, hTF₁_inv, _⟩ :=
          hLiftInv F₁ h₁ (algebraMap (Polynomial L) (Localization.Away g₁) g₁) hF₁_h₁
        obtain ⟨tilde_G₁, hTG₁_alg, hTG₁_inv, _⟩ :=
          hLiftInv G₁ g₁ (algebraMap (Polynomial L) (Localization.Away h₁) h₁) hG₁_g₁
        have hGF₁ : tilde_G₁.comp tilde_F₁ = RingHom.id (Localization.Away h₁) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers h₁)
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro a
            change tilde_G₁ (tilde_F₁ (algebraMap _ _ (Polynomial.C a))) = algebraMap _ _ (Polynomial.C a)
            rw [hTF₁_alg, hF₁_C, hTG₁_alg, hG₁_C]
          · change tilde_G₁ (tilde_F₁ (algebraMap _ _ Polynomial.X)) = algebraMap _ _ Polynomial.X
            rw [hTF₁_alg, hF₁_X, map_mul, hTG₁_alg, hG₁_X, hTG₁_inv, mul_assoc,
              mul_comm (IsLocalization.Away.invSelf h₁), IsLocalization.Away.mul_invSelf, mul_one]
        have hFG₁ : tilde_F₁.comp tilde_G₁ = RingHom.id (Localization.Away g₁) := by
          apply IsLocalization.ringHom_ext (Submonoid.powers g₁)
          apply Polynomial.ringHom_ext'
          · apply RingHom.ext
            intro a
            change tilde_F₁ (tilde_G₁ (algebraMap _ _ (Polynomial.C a))) = algebraMap _ _ (Polynomial.C a)
            rw [hTG₁_alg, hG₁_C, hTF₁_alg, hF₁_C]
          · change tilde_F₁ (tilde_G₁ (algebraMap _ _ Polynomial.X)) = algebraMap _ _ Polynomial.X
            rw [hTG₁_alg, hG₁_X, map_mul, hTF₁_alg, hF₁_X, hTF₁_inv, mul_assoc,
              mul_comm (IsLocalization.Away.invSelf g₁), IsLocalization.Away.mul_invSelf, mul_one]

        
        let φ₀ : A₀.toScheme ⟶ P := e_g0.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀) ≫ j₀
        let φ₁ : A₁.toScheme ⟶ P := e_g1.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁) ≫ j₁

        let iso_α₀ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀)) ≅
            AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h₀)) :=
          { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom tilde_F₀)
            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom tilde_G₀)
            hom_inv_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hFG₀,
                CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
            inv_hom_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hGF₀,
                CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
        let iso_α₁ : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₁)) ≅
            AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h₁)) :=
          { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom tilde_F₁)
            inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom tilde_G₁)
            hom_inv_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hFG₁,
                CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
            inv_hom_id := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hGF₁,
                CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }

        have hF₀_fac : F₀ = tilde_F₀.comp (algebraMap (Polynomial L) (Localization.Away h₀)) :=
          RingHom.ext fun f => (hTF₀_alg f).symm
        have hF₁_fac : F₁ = tilde_F₁.comp (algebraMap (Polynomial L) (Localization.Away h₁)) :=
          RingHom.ext fun f => (hTF₁_alg f).symm

        have hφ₀_open : AlgebraicGeometry.IsOpenImmersion φ₀ := by
          have hSpecF₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀) =
              iso_α₀.hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₀))) := by
            dsimp only [iso_α₀]
            rw [hF₀_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
          have : CategoryTheory.IsIso e_g0.hom := e_g0.isIso_hom
          have : CategoryTheory.IsIso iso_α₀.hom := iso_α₀.isIso_hom
          have : AlgebraicGeometry.IsOpenImmersion
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₀)))) :=
            AlgebraicGeometry.IsOpenImmersion.of_isLocalization h₀
          dsimp only [φ₀]
          rw [hSpecF₀]
          infer_instance

        have hφ₁_open : AlgebraicGeometry.IsOpenImmersion φ₁ := by
          have hSpecF₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁) =
              iso_α₁.hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₁))) := by
            dsimp only [iso_α₁]
            rw [hF₁_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
          have : CategoryTheory.IsIso e_g1.hom := e_g1.isIso_hom
          have : CategoryTheory.IsIso iso_α₁.hom := iso_α₁.isIso_hom
          have : AlgebraicGeometry.IsOpenImmersion
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₁)))) :=
            AlgebraicGeometry.IsOpenImmersion.of_isLocalization h₁
          dsimp only [φ₁]
          rw [hSpecF₁]
          infer_instance

        
        have hov_inf : W_src.homOfLE (inf_le_left : A₀ ⊓ A₁ ≤ A₀) ≫ φ₀ =
            W_src.homOfLE (inf_le_right : A₀ ⊓ A₁ ≤ A₁) ≫ φ₁ := by
          let g₀₁ : Polynomial L := g₀ * g₁
          let A₀₁ : W_src.Opens := PrimeSpectrum.basicOpen g₀₁
          let R₀₁ := Localization.Away g₀₁
          obtain ⟨e_g01, _, he_g01_inv⟩ := hLocIso g₀₁ A₀₁ rfl
          have hA₀₁_eq : A₀ ⊓ A₁ = A₀₁ :=
            (PrimeSpectrum.basicOpen_mul g₀ g₁).symm
          let iso_A₀₁ : (A₀ ⊓ A₁).toScheme ≅ A₀₁.toScheme :=
            W_src.isoOfEq hA₀₁_eq
          suffices h_eq : e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_left ≫ φ₀ =
              e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_right ≫ φ₁ by
            calc W_src.homOfLE inf_le_left ≫ φ₀
                = iso_A₀₁.hom ≫ e_g01.hom ≫
                    (e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_left ≫ φ₀) := by
                    rw [← CategoryTheory.Category.assoc e_g01.hom, e_g01.hom_inv_id,
                      CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc iso_A₀₁.hom,
                      iso_A₀₁.hom_inv_id, CategoryTheory.Category.id_comp]
              _ = iso_A₀₁.hom ≫ e_g01.hom ≫
                    (e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_right ≫ φ₁) := by
                    rw [h_eq]
              _ = W_src.homOfLE inf_le_right ≫ φ₁ := by
                    rw [← CategoryTheory.Category.assoc e_g01.hom, e_g01.hom_inv_id,
                      CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc iso_A₀₁.hom,
                      iso_A₀₁.hom_inv_id, CategoryTheory.Category.id_comp]

          let v₀ : R₀₁ := algebraMap (Polynomial L) R₀₁ g₁ * IsLocalization.Away.invSelf (S := R₀₁) g₀₁
          let v₁ : R₀₁ := algebraMap (Polynomial L) R₀₁ g₀ * IsLocalization.Away.invSelf (S := R₀₁) g₀₁
          have hv₀ : algebraMap (Polynomial L) R₀₁ g₀ * v₀ = 1 := by
            dsimp only [v₀]
            rw [← mul_assoc, ← map_mul]
            exact IsLocalization.Away.mul_invSelf g₀₁
          have hv₁ : algebraMap (Polynomial L) R₀₁ g₁ * v₁ = 1 := by
            dsimp only [v₁]
            rw [← mul_assoc, ← map_mul, mul_comm g₁ g₀]
            exact IsLocalization.Away.mul_invSelf g₀₁
          obtain ⟨M₀, hM₀_alg, hM₀_inv, _⟩ := hLiftInv (algebraMap (Polynomial L) R₀₁) g₀ v₀ hv₀
          obtain ⟨M₁, hM₁_alg, hM₁_inv, _⟩ := hLiftInv (algebraMap (Polynomial L) R₀₁) g₁ v₁ hv₁

          have hchart₀ : e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_left ≫ e_g0.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom M₀) := by
            have : AlgebraicGeometry.IsOpenImmersion
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₀)))) :=
              AlgebraicGeometry.IsOpenImmersion.of_isLocalization g₀
            rw [← CategoryTheory.cancel_mono
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₀))))]
            calc (e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_left ≫ e_g0.hom) ≫ _
                = e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_left ≫ A₀.ι := by
                    simp only [CategoryTheory.Category.assoc, he_g0_hom]
              _ = e_g01.inv ≫ iso_A₀₁.inv ≫ (A₀ ⊓ A₁).ι := by
                    rw [AlgebraicGeometry.Scheme.homOfLE_ι]
              _ = e_g01.inv ≫ A₀₁.ι := by
                    have h1 : iso_A₀₁.inv ≫ (A₀ ⊓ A₁).ι = A₀₁.ι := by
                      rw [← AlgebraicGeometry.Scheme.isoOfEq_hom_ι W_src hA₀₁_eq,
                        ← CategoryTheory.Category.assoc, iso_A₀₁.inv_hom_id,
                        CategoryTheory.Category.id_comp]
                    rw [h1]
              _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) R₀₁)) := he_g01_inv
              _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom M₀) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₀))) := by
                    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
                    congr 2
                    exact RingHom.ext fun p => (hM₀_alg p).symm

          have hchart₁ : e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_right ≫ e_g1.hom =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom M₁) := by
            have : AlgebraicGeometry.IsOpenImmersion
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₁)))) :=
              AlgebraicGeometry.IsOpenImmersion.of_isLocalization g₁
            rw [← CategoryTheory.cancel_mono
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₁))))]
            calc (e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_right ≫ e_g1.hom) ≫ _
                = e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_right ≫ A₁.ι := by
                    simp only [CategoryTheory.Category.assoc, he_g1_hom]
              _ = e_g01.inv ≫ iso_A₀₁.inv ≫ (A₀ ⊓ A₁).ι := by
                    rw [AlgebraicGeometry.Scheme.homOfLE_ι]
              _ = e_g01.inv ≫ A₀₁.ι := by
                    have h1 : iso_A₀₁.inv ≫ (A₀ ⊓ A₁).ι = A₀₁.ι := by
                      rw [← AlgebraicGeometry.Scheme.isoOfEq_hom_ι W_src hA₀₁_eq,
                        ← CategoryTheory.Category.assoc, iso_A₀₁.inv_hom_id,
                        CategoryTheory.Category.id_comp]
                    rw [h1]
              _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) R₀₁)) := he_g01_inv
              _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom M₁) ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₁))) := by
                    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
                    congr 2
                    exact RingHom.ext fun p => (hM₁_alg p).symm

          have hprod_unit : (M₀.comp F₀) Polynomial.X * (M₁.comp F₁) Polynomial.X = 1 := by
            change M₀ (F₀ Polynomial.X) * M₁ (F₁ Polynomial.X) = 1
            rw [hF₀_X, map_add, hM₀_alg, hM₀_inv, hF₁_X, map_mul, hM₁_alg, hM₁_inv]
            have hstep1 : (algebraMap (Polynomial L) R₀₁ (Polynomial.C c) + v₀) *
                algebraMap (Polynomial L) R₀₁ g₀ =
                algebraMap (Polynomial L) R₀₁ g₁ := by
              rw [add_mul, mul_comm v₀, hv₀, ← map_mul,
                ← map_one (algebraMap (Polynomial L) R₀₁), ← map_add]
              congr 1
              dsimp [g₀, g₁]; ring
            calc (algebraMap (Polynomial L) R₀₁ (Polynomial.C c) + v₀) *
                  (algebraMap (Polynomial L) R₀₁ Polynomial.X * v₁)
                = ((algebraMap (Polynomial L) R₀₁ (Polynomial.C c) + v₀) *
                    algebraMap (Polynomial L) R₀₁ g₀) * v₁ := by
                    dsimp only [g₀]; ring
              _ = algebraMap (Polynomial L) R₀₁ g₁ * v₁ := by rw [hstep1]
              _ = 1 := hv₁

          obtain ⟨Λ, hΛ_alg, hΛ_inv, _⟩ :=
            hLiftInv (M₀.comp F₀) Polynomial.X ((M₁.comp F₁) Polynomial.X) hprod_unit
          have hΛ₀ : Λ.comp (algebraMap (Polynomial L) LocX) = M₀.comp F₀ :=
            RingHom.ext hΛ_alg
          have hΛ₁ : Λ.comp τ_L = M₁.comp F₁ := by
            apply Polynomial.ringHom_ext'
            · apply RingHom.ext
              intro a
              change Λ (τ_L (Polynomial.C a)) = M₁ (F₁ (Polynomial.C a))
              rw [show τ_L (Polynomial.C a) = algebraMap (Polynomial L) LocX (Polynomial.C a) from
                Polynomial.eval₂_C _ _, hΛ_alg]
              change M₀ (F₀ (Polynomial.C a)) = M₁ (F₁ (Polynomial.C a))
              rw [hF₀_C, hM₀_alg, hF₁_C, hM₁_alg]
            · change Λ (τ_L Polynomial.X) = M₁ (F₁ Polynomial.X)
              rw [show τ_L Polynomial.X = IsLocalization.Away.invSelf (S := LocX) (Polynomial.X : Polynomial L) from
                Polynomial.eval₂_X _ _, hΛ_inv]
              rfl

          calc e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_left ≫ φ₀
              = (e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_left ≫ e_g0.hom) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀) ≫ j₀ := by
                  dsimp only [φ₀]; simp only [CategoryTheory.Category.assoc]
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom M₀) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀)) ≫ j₀ := by
                  rw [hchart₀, CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (M₀.comp F₀)) ≫ j₀ := by
                  rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Λ) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) LocX)) ≫ j₀) := by
                  rw [← hΛ₀, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
                    CategoryTheory.Category.assoc]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Λ) ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫ j₁) := by
                  rw [hTrans]
            _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (M₁.comp F₁)) ≫ j₁ := by
                  rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                    ← CommRingCat.ofHom_comp, hΛ₁]
            _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom M₁) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁)) ≫ j₁ := by
                  rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
            _ = (e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_right ≫ e_g1.hom) ≫
                  AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁) ≫ j₁ := by
                  rw [← hchart₁, CategoryTheory.Category.assoc]
            _ = e_g01.inv ≫ iso_A₀₁.inv ≫ W_src.homOfLE inf_le_right ≫ φ₁ := by
                  dsimp only [φ₁]; simp only [CategoryTheory.Category.assoc]

        
        let cov_fn : Bool → W_src.Opens := fun b => cond b A₀ A₁
        have hSup_cov : (⨆ b : Bool, cov_fn b) = ⊤ := by
          rw [eq_top_iff]
          intro q _
          have hq : q ∈ A₀ ⊔ A₁ := by rw [hCov_A]; trivial
          rw [TopologicalSpace.Opens.mem_iSup]
          rcases hq with h0 | h1
          · exact ⟨true, h0⟩
          · exact ⟨false, h1⟩
        let covW : W_src.OpenCover := W_src.openCoverOfIsOpenCover cov_fn hSup_cov
        let φ_cov : ∀ b : covW.I₀, covW.X b ⟶ P := fun b =>
          match b with
          | true => φ₀
          | false => φ₁
        have hglue_cov : ∀ (b₁ b₂ : covW.I₀),
            CategoryTheory.Limits.pullback.fst (covW.f b₁) (covW.f b₂) ≫ φ_cov b₁ =
              CategoryTheory.Limits.pullback.snd (covW.f b₁) (covW.f b₂) ≫ φ_cov b₂ := by
          intro b₁ b₂
          cases b₁ <;> cases b₂
          · 
            change CategoryTheory.Limits.pullback.fst A₁.ι A₁.ι ≫ φ₁ =
              CategoryTheory.Limits.pullback.snd A₁.ι A₁.ι ≫ φ₁
            have h1 : CategoryTheory.Limits.pullback.fst A₁.ι A₁.ι =
                CategoryTheory.Limits.pullback.snd A₁.ι A₁.ι := by
              rw [← CategoryTheory.cancel_mono A₁.ι, CategoryTheory.Limits.pullback.condition]
            rw [h1]
          · 
            change CategoryTheory.Limits.pullback.fst A₁.ι A₀.ι ≫ φ₁ =
              CategoryTheory.Limits.pullback.snd A₁.ι A₀.ι ≫ φ₀
            have hsub : Set.range (CategoryTheory.Limits.pullback.fst A₁.ι A₀.ι ≫ A₁.ι).base ⊆
                Set.range (A₀ ⊓ A₁).ι.base := by
              rw [AlgebraicGeometry.Scheme.Opens.range_ι]
              rintro _ ⟨z, rfl⟩
              refine ⟨?_, (CategoryTheory.Limits.pullback.fst A₁.ι A₀.ι).base z |>.2⟩
              change (CategoryTheory.Limits.pullback.fst A₁.ι A₀.ι ≫ A₁.ι).base z ∈ A₀
              rw [CategoryTheory.Limits.pullback.condition]
              exact (CategoryTheory.Limits.pullback.snd A₁.ι A₀.ι).base z |>.2
            let u_ft := AlgebraicGeometry.IsOpenImmersion.lift (A₀ ⊓ A₁).ι
              (CategoryTheory.Limits.pullback.fst A₁.ι A₀.ι ≫ A₁.ι) hsub
            have hu_ft : u_ft ≫ (A₀ ⊓ A₁).ι =
                CategoryTheory.Limits.pullback.fst A₁.ι A₀.ι ≫ A₁.ι :=
              AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
            have hfst_eq : CategoryTheory.Limits.pullback.fst A₁.ι A₀.ι =
                u_ft ≫ W_src.homOfLE inf_le_right := by
              rw [← CategoryTheory.cancel_mono A₁.ι, CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.homOfLE_ι, hu_ft]
            have hsnd_eq : CategoryTheory.Limits.pullback.snd A₁.ι A₀.ι =
                u_ft ≫ W_src.homOfLE inf_le_left := by
              rw [← CategoryTheory.cancel_mono A₀.ι, CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.homOfLE_ι, hu_ft, CategoryTheory.Limits.pullback.condition]
            rw [hfst_eq, hsnd_eq, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hov_inf]
          · 
            change CategoryTheory.Limits.pullback.fst A₀.ι A₁.ι ≫ φ₀ =
              CategoryTheory.Limits.pullback.snd A₀.ι A₁.ι ≫ φ₁
            have hsub : Set.range (CategoryTheory.Limits.pullback.fst A₀.ι A₁.ι ≫ A₀.ι).base ⊆
                Set.range (A₀ ⊓ A₁).ι.base := by
              rw [AlgebraicGeometry.Scheme.Opens.range_ι]
              rintro _ ⟨z, rfl⟩
              refine ⟨(CategoryTheory.Limits.pullback.fst A₀.ι A₁.ι).base z |>.2, ?_⟩
              change (CategoryTheory.Limits.pullback.fst A₀.ι A₁.ι ≫ A₀.ι).base z ∈ A₁
              rw [CategoryTheory.Limits.pullback.condition]
              exact (CategoryTheory.Limits.pullback.snd A₀.ι A₁.ι).base z |>.2
            let u_tf := AlgebraicGeometry.IsOpenImmersion.lift (A₀ ⊓ A₁).ι
              (CategoryTheory.Limits.pullback.fst A₀.ι A₁.ι ≫ A₀.ι) hsub
            have hu_tf : u_tf ≫ (A₀ ⊓ A₁).ι =
                CategoryTheory.Limits.pullback.fst A₀.ι A₁.ι ≫ A₀.ι :=
              AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
            have hfst_eq : CategoryTheory.Limits.pullback.fst A₀.ι A₁.ι =
                u_tf ≫ W_src.homOfLE inf_le_left := by
              rw [← CategoryTheory.cancel_mono A₀.ι, CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.homOfLE_ι, hu_tf]
            have hsnd_eq : CategoryTheory.Limits.pullback.snd A₀.ι A₁.ι =
                u_tf ≫ W_src.homOfLE inf_le_right := by
              rw [← CategoryTheory.cancel_mono A₁.ι, CategoryTheory.Category.assoc,
                AlgebraicGeometry.Scheme.homOfLE_ι, hu_tf, CategoryTheory.Limits.pullback.condition]
            rw [hfst_eq, hsnd_eq, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hov_inf]
          · 
            change CategoryTheory.Limits.pullback.fst A₀.ι A₀.ι ≫ φ₀ =
              CategoryTheory.Limits.pullback.snd A₀.ι A₀.ι ≫ φ₀
            have h1 : CategoryTheory.Limits.pullback.fst A₀.ι A₀.ι =
                CategoryTheory.Limits.pullback.snd A₀.ι A₀.ι := by
              rw [← CategoryTheory.cancel_mono A₀.ι, CategoryTheory.Limits.pullback.condition]
            rw [h1]

        let ι_w : W_src ⟶ P := covW.glueMorphisms φ_cov hglue_cov
        have hι_A₀ : A₀.ι ≫ ι_w = φ₀ := covW.ι_glueMorphisms φ_cov hglue_cov true
        have hι_A₁ : A₁.ι ≫ ι_w = φ₁ := covW.ι_glueMorphisms φ_cov hglue_cov false

        
        have hι_pL : ι_w ≫ p_L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
          apply covW.hom_ext
          intro b
          cases b
          · change A₁.ι ≫ ι_w ≫ p_L = A₁.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
            rw [← CategoryTheory.Category.assoc, hι_A₁]
            dsimp only [φ₁, j₁]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Category.assoc, he₁_p,
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hF₁_compC : F₁.comp Polynomial.C =
                (algebraMap (Polynomial L) (Localization.Away g₁)).comp Polynomial.C :=
              RingHom.ext hF₁_C
            rw [hF₁_compC, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              ← CategoryTheory.Category.assoc, he_g1_hom]
          · change A₀.ι ≫ ι_w ≫ p_L = A₀.ι ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
            rw [← CategoryTheory.Category.assoc, hι_A₀]
            dsimp only [φ₀, j₀]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Category.assoc, he₀_p,
              ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
            have hF₀_compC : F₀.comp Polynomial.C =
                (algebraMap (Polynomial L) (Localization.Away g₀)).comp Polynomial.C :=
              RingHom.ext hF₀_C
            rw [hF₀_compC, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
              ← CategoryTheory.Category.assoc, he_g0_hom]

        
        have hpre_ι₀ : ι_w ⁻¹ᵁ V₀ = A₀ := by
          ext x
          constructor
          · intro hx
            by_contra hx_notA₀
            have hx_A₁ : x ∈ A₁ := by
              have htop : x ∈ A₀ ⊔ A₁ := by rw [hCov_A]; trivial
              rcases htop with h0 | h1
              · exact False.elim (hx_notA₀ h0)
              · exact h1
            have hx_g₀ : g₀ ∈ (x : PrimeSpectrum (Polynomial L)).asIdeal := by
              change x ∉ (PrimeSpectrum.basicOpen g₀ : W_src.Opens) at hx_notA₀
              rw [hMemBasic, Classical.not_not] at hx_notA₀
              exact hx_notA₀
            have hιx : ι_w.base x = φ₁.base ⟨x, hx_A₁⟩ := by
              rw [← hι_A₁]
              rfl
            have hφ₁_in_V₀ : φ₁.base ⟨x, hx_A₁⟩ ∈ V₀ := by
              rw [← hιx]
              exact hx
            let q_loc : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₁))) :=
              e_g1.hom.base ⟨x, hx_A₁⟩
            have hq_loc_x : (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₁)))).base q_loc = x := by
              change (e_g1.hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₁)))).base ⟨x, hx_A₁⟩ = x
              rw [he_g1_hom]
              rfl
            have h_in_basicX : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁)).base q_loc ∈
                (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) := by
              rw [← hpre₁₀]
              exact hφ₁_in_V₀
            rw [hMemBasic, hSpecBase] at h_in_basicX
            apply h_in_basicX
            rw [hF₁_X]
            apply (q_loc : PrimeSpectrum (Localization.Away g₁)).asIdeal.mul_mem_right
            rw [← hSpecBase (algebraMap (Polynomial L) (Localization.Away g₁)) q_loc Polynomial.X, hq_loc_x]
            exact hx_g₀
          · intro hx_A₀
            have hιx : ι_w.base x = φ₀.base ⟨x, hx_A₀⟩ := by
              rw [← hι_A₀]
              rfl
            change ι_w.base x ∈ (V₀ : Set ↥P)
            rw [hιx, ← hRange_j₀]
            exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀)).base (e_g0.hom.base ⟨x, hx_A₀⟩), rfl⟩

        have hpre_ι₁ : ι_w ⁻¹ᵁ V₁ = A₁ := by
          ext x
          constructor
          · intro hx
            by_contra hx_notA₁
            have hx_A₀ : x ∈ A₀ := by
              have htop : x ∈ A₀ ⊔ A₁ := by rw [hCov_A]; trivial
              rcases htop with h0 | h1
              · exact h0
              · exact False.elim (hx_notA₁ h1)
            have hx_g₁ : g₁ ∈ (x : PrimeSpectrum (Polynomial L)).asIdeal := by
              change x ∉ (PrimeSpectrum.basicOpen g₁ : W_src.Opens) at hx_notA₁
              rw [hMemBasic, Classical.not_not] at hx_notA₁
              exact hx_notA₁
            have hιx : ι_w.base x = φ₀.base ⟨x, hx_A₀⟩ := by
              rw [← hι_A₀]
              rfl
            have hφ₀_in_V₁ : φ₀.base ⟨x, hx_A₀⟩ ∈ V₁ := by
              rw [← hιx]
              exact hx
            let q_loc : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g₀))) :=
              e_g0.hom.base ⟨x, hx_A₀⟩
            have hq_loc_x : (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₀)))).base q_loc = x := by
              change (e_g0.hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away g₀)))).base ⟨x, hx_A₀⟩ = x
              rw [he_g0_hom]
              rfl
            have h_in_basicX : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀)).base q_loc ∈
                (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) := by
              rw [← hpre₀₁]
              exact hφ₀_in_V₁
            rw [hMemBasic, hSpecBase] at h_in_basicX
            apply h_in_basicX
            have hF₀_id : F₀ Polynomial.X =
                algebraMap (Polynomial L) (Localization.Away g₀) g₁ *
                  IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀ := by
              calc F₀ Polynomial.X
                  = F₀ Polynomial.X * (algebraMap (Polynomial L) (Localization.Away g₀) g₀ *
                      IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀) := by
                      rw [IsLocalization.Away.mul_invSelf, mul_one]
                _ = (F₀ Polynomial.X * algebraMap (Polynomial L) (Localization.Away g₀) g₀) *
                      IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀ := by
                      rw [mul_assoc]
                _ = algebraMap (Polynomial L) (Localization.Away g₀) g₁ *
                      IsLocalization.Away.invSelf (S := Localization.Away g₀) g₀ := by
                      congr 1
                      rw [hF₀_X, add_mul, mul_comm (IsLocalization.Away.invSelf g₀),
                        IsLocalization.Away.mul_invSelf, ← map_mul,
                        ← map_one (algebraMap (Polynomial L) (Localization.Away g₀)), ← map_add]
                      congr 1
                      dsimp [g₀, g₁]; ring
            rw [hF₀_id]
            apply (q_loc : PrimeSpectrum (Localization.Away g₀)).asIdeal.mul_mem_right
            rw [← hSpecBase (algebraMap (Polynomial L) (Localization.Away g₀)) q_loc g₁, hq_loc_x]
            exact hx_g₁
          · intro hx_A₁
            have hιx : ι_w.base x = φ₁.base ⟨x, hx_A₁⟩ := by
              rw [← hι_A₁]
              rfl
            change ι_w.base x ∈ (V₁ : Set ↥P)
            rw [hιx, ← hRange_j₁]
            exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁)).base (e_g1.hom.base ⟨x, hx_A₁⟩), rfl⟩

        
        have hOpen_ιw : AlgebraicGeometry.IsOpenImmersion ι_w := by
          let V_cov : Bool → P.Opens := fun b => cond b V₀ V₁
          have hSup_V : (⨆ b : Bool, V_cov b) = ⊤ := by
            rw [eq_top_iff]
            intro y _
            have hy : y ∈ V₀ ⊔ V₁ := by rw [hCov]; trivial
            rw [TopologicalSpace.Opens.mem_iSup]
            rcases hy with h0 | h1
            · exact ⟨true, h0⟩
            · exact ⟨false, h1⟩
          refine AlgebraicGeometry.IsZariskiLocalAtTarget.of_iSup_eq_top
            (P := @AlgebraicGeometry.IsOpenImmersion) V_cov hSup_V ?_
          intro b
          cases b
          · change AlgebraicGeometry.IsOpenImmersion (ι_w ∣_ V₁)
            let iso_p₁ := W_src.isoOfEq hpre_ι₁.symm
            have hcomp₁ : (iso_p₁.hom ≫ (ι_w ∣_ V₁)) ≫ V₁.ι = φ₁ := by
              rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
                ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι, hι_A₁]
            have : AlgebraicGeometry.IsOpenImmersion ((iso_p₁.hom ≫ (ι_w ∣_ V₁)) ≫ V₁.ι) := by
              rw [hcomp₁]; exact hφ₁_open
            have : AlgebraicGeometry.IsOpenImmersion (iso_p₁.hom ≫ (ι_w ∣_ V₁)) :=
              AlgebraicGeometry.IsOpenImmersion.of_comp (iso_p₁.hom ≫ (ι_w ∣_ V₁)) V₁.ι
            have : CategoryTheory.IsIso iso_p₁.inv := iso_p₁.isIso_inv
            have heq₁ : ι_w ∣_ V₁ = iso_p₁.inv ≫ (iso_p₁.hom ≫ (ι_w ∣_ V₁)) := by
              rw [← CategoryTheory.Category.assoc, iso_p₁.inv_hom_id, CategoryTheory.Category.id_comp]
            rw [heq₁]
            infer_instance
          · change AlgebraicGeometry.IsOpenImmersion (ι_w ∣_ V₀)
            let iso_p₀ := W_src.isoOfEq hpre_ι₀.symm
            have hcomp₀ : (iso_p₀.hom ≫ (ι_w ∣_ V₀)) ≫ V₀.ι = φ₀ := by
              rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι,
                ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι, hι_A₀]
            have : AlgebraicGeometry.IsOpenImmersion ((iso_p₀.hom ≫ (ι_w ∣_ V₀)) ≫ V₀.ι) := by
              rw [hcomp₀]; exact hφ₀_open
            have : AlgebraicGeometry.IsOpenImmersion (iso_p₀.hom ≫ (ι_w ∣_ V₀)) :=
              AlgebraicGeometry.IsOpenImmersion.of_comp (iso_p₀.hom ≫ (ι_w ∣_ V₀)) V₀.ι
            have : CategoryTheory.IsIso iso_p₀.inv := iso_p₀.isIso_inv
            have heq₀ : ι_w ∣_ V₀ = iso_p₀.inv ≫ (iso_p₀.hom ≫ (ι_w ∣_ V₀)) := by
              rw [← CategoryTheory.Category.assoc, iso_p₀.inv_hom_id, CategoryTheory.Category.id_comp]
            rw [heq₀]
            infer_instance

        
        have hRange_φ₀ : Set.range φ₀.base = (V₀ : Set ↥P) \ {q_inf} := by
          have hSpecF₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀) =
              iso_α₀.hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₀))) := by
            dsimp only [iso_α₀]
            rw [hF₀_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
          ext y
          constructor
          · rintro ⟨u, rfl⟩
            refine ⟨?_, ?_⟩
            · rw [← hRange_j₀]
              exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀)).base (e_g0.hom.base u), rfl⟩
            · intro hy_q
              rw [Set.mem_singleton_iff, ← hj₀_mc] at hy_q
              have h_eq_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀)).base (e_g0.hom.base u) =
                  m_pt c :=
                j₀.isOpenEmbedding.injective hy_q
              have h_in_range : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀)).base (e_g0.hom.base u) :
                  PrimeSpectrum (Polynomial L)) ∈
                  Set.range (PrimeSpectrum.comap (algebraMap (Polynomial L) (Localization.Away h₀))) := by
                rw [hSpecF₀]
                exact ⟨iso_α₀.hom.base (e_g0.hom.base u), rfl⟩
              rw [h_eq_pt, PrimeSpectrum.localization_away_comap_range (Localization.Away h₀) h₀] at h_in_range
              have hm_not : m_pt c ∉ (PrimeSpectrum.basicOpen h₀ : W_src.Opens) := by
                rw [hMemBasic, Classical.not_not]
                exact (hLinearZero c (m_pt c)).mpr rfl
              exact hm_not h_in_range
          · rintro ⟨hy_V₀, hy_ne⟩
            rw [← hRange_j₀] at hy_V₀
            obtain ⟨q₀, rfl⟩ := hy_V₀
            have hq₀_ne : q₀ ≠ m_pt c := by
              rintro rfl
              exact hy_ne (Set.mem_singleton_iff.mpr hj₀_mc)
            let q₀_ps : PrimeSpectrum (Polynomial L) := q₀
            have hq₀_basic : q₀_ps ∈ (PrimeSpectrum.basicOpen h₀ : Set (PrimeSpectrum (Polynomial L))) := by
              rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
              intro hh₀
              exact hq₀_ne ((hLinearZero c q₀).mp hh₀)
            rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h₀) h₀] at hq₀_basic
            obtain ⟨z_h₀, hz_h₀⟩ := hq₀_basic
            let z_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h₀))) := z_h₀
            let u₀ : ↥A₀.toScheme := e_g0.inv.base (iso_α₀.inv.base z_pt)
            refine ⟨u₀, ?_⟩
            change j₀.base ((e_g0.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₀)).base u₀) = j₀.base q₀
            rw [hSpecF₀]
            congr 1
            change (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₀)))).base
              (iso_α₀.hom.base (e_g0.hom.base (e_g0.inv.base (iso_α₀.inv.base z_pt)))) = q₀
            have he1 : e_g0.hom.base (e_g0.inv.base (iso_α₀.inv.base z_pt)) = iso_α₀.inv.base z_pt := by
              change (e_g0.inv ≫ e_g0.hom).base (iso_α₀.inv.base z_pt) = _
              rw [e_g0.inv_hom_id]; rfl
            have he2 : iso_α₀.hom.base (iso_α₀.inv.base z_pt) = z_pt := by
              change (iso_α₀.inv ≫ iso_α₀.hom).base z_pt = _
              rw [iso_α₀.inv_hom_id]; rfl
            rw [he1, he2]
            exact hz_h₀

        have hRange_φ₁ : Set.range φ₁.base = (V₁ : Set ↥P) \ {q_inf} := by
          have hSpecF₁ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁) =
              iso_α₁.hom ≫ AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₁))) := by
            dsimp only [iso_α₁]
            rw [hF₁_fac, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
          ext y
          constructor
          · rintro ⟨u, rfl⟩
            refine ⟨?_, ?_⟩
            · rw [← hRange_j₁]
              exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁)).base (e_g1.hom.base u), rfl⟩
            · intro hy_q
              rw [Set.mem_singleton_iff, ← hj₁_mcinv] at hy_q
              have h_eq_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁)).base (e_g1.hom.base u) =
                  m_pt c⁻¹ :=
                j₁.isOpenEmbedding.injective hy_q
              have h_in_range : ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁)).base (e_g1.hom.base u) :
                  PrimeSpectrum (Polynomial L)) ∈
                  Set.range (PrimeSpectrum.comap (algebraMap (Polynomial L) (Localization.Away h₁))) := by
                rw [hSpecF₁]
                exact ⟨iso_α₁.hom.base (e_g1.hom.base u), rfl⟩
              rw [h_eq_pt, PrimeSpectrum.localization_away_comap_range (Localization.Away h₁) h₁] at h_in_range
              have hm_not : m_pt c⁻¹ ∉ (PrimeSpectrum.basicOpen h₁ : W_src.Opens) :=
                (hZeroH1 (m_pt c⁻¹)).mpr rfl
              exact hm_not h_in_range
          · rintro ⟨hy_V₁, hy_ne⟩
            rw [← hRange_j₁] at hy_V₁
            obtain ⟨q₁, rfl⟩ := hy_V₁
            have hq₁_ne : q₁ ≠ m_pt c⁻¹ := by
              rintro rfl
              exact hy_ne (Set.mem_singleton_iff.mpr hj₁_mcinv)
            let q₁_ps : PrimeSpectrum (Polynomial L) := q₁
            have hq₁_basic : q₁_ps ∈ (PrimeSpectrum.basicOpen h₁ : Set (PrimeSpectrum (Polynomial L))) := by
              rw [SetLike.mem_coe]
              by_contra hnot
              exact hq₁_ne ((hZeroH1 q₁).mp hnot)
            rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away h₁) h₁] at hq₁_basic
            obtain ⟨z_h₁, hz_h₁⟩ := hq₁_basic
            let z_pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h₁))) := z_h₁
            let u₁ : ↥A₁.toScheme := e_g1.inv.base (iso_α₁.inv.base z_pt)
            refine ⟨u₁, ?_⟩
            change j₁.base ((e_g1.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom F₁)).base u₁) = j₁.base q₁
            rw [hSpecF₁]
            congr 1
            change (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (Polynomial L) (Localization.Away h₁)))).base
              (iso_α₁.hom.base (e_g1.hom.base (e_g1.inv.base (iso_α₁.inv.base z_pt)))) = q₁
            have he1 : e_g1.hom.base (e_g1.inv.base (iso_α₁.inv.base z_pt)) = iso_α₁.inv.base z_pt := by
              change (e_g1.inv ≫ e_g1.hom).base (iso_α₁.inv.base z_pt) = _
              rw [e_g1.inv_hom_id]; rfl
            have he2 : iso_α₁.hom.base (iso_α₁.inv.base z_pt) = z_pt := by
              change (iso_α₁.inv ≫ iso_α₁.hom).base z_pt = _
              rw [iso_α₁.inv_hom_id]; rfl
            rw [he1, he2]
            exact hz_h₁

        have hRange_ιw : Set.range ι_w.base = (Set.range σ_L.base)ᶜ := by
          rw [hRange_σ]
          have hunion : Set.range ι_w.base = Set.range φ₀.base ∪ Set.range φ₁.base := by
            ext y
            constructor
            · rintro ⟨x, rfl⟩
              have hx : x ∈ A₀ ⊔ A₁ := by rw [hCov_A]; trivial
              rcases hx with hx0 | hx1
              · left
                refine ⟨⟨x, hx0⟩, ?_⟩
                rw [← hι_A₀]; rfl
              · right
                refine ⟨⟨x, hx1⟩, ?_⟩
                rw [← hι_A₁]; rfl
            · rintro (⟨u₀, rfl⟩ | ⟨u₁, rfl⟩)
              · refine ⟨A₀.ι.base u₀, ?_⟩
                change (A₀.ι ≫ ι_w).base u₀ = φ₀.base u₀
                rw [hι_A₀]
              · refine ⟨A₁.ι.base u₁, ?_⟩
                change (A₁.ι ≫ ι_w).base u₁ = φ₁.base u₁
                rw [hι_A₁]
          rw [hunion, hRange_φ₀, hRange_φ₁]
          ext y
          simp only [Set.mem_union, Set.mem_sdiff, Set.mem_singleton_iff, Set.mem_compl_iff]
          constructor
          · rintro (⟨_, hne⟩ | ⟨_, hne⟩) <;> exact hne
          · intro hne
            have hy : y ∈ V₀ ⊔ V₁ := by rw [hCov]; trivial
            rcases hy with hy0 | hy1
            · exact Or.inl ⟨hy0, hne⟩
            · exact Or.inr ⟨hy1, hne⟩

        exact ⟨ι_w, hOpen_ιw, hι_pL, hRange_ιw⟩

      · 
        refine ⟨j₁, hOpen_j₁, he₁_p, ?_⟩
        rw [hRange_j₁, hRange_σ]
        ext y
        simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
        constructor
        · intro hy₁ hyeq
          subst hyeq
          exact hq₁ hy₁
        · intro hy_ne
          by_contra hy_not₁
          have hy₀ : y ∈ V₀ := by
            have htop : y ∈ V₀ ⊔ V₁ := by rw [hCov]; trivial
            rcases htop with h0 | h1
            · exact h0
            · exact False.elim (hy_not₁ h1)
          let y₀_pt : ↥W_src := e₀.hom.base ⟨y, hy₀⟩
          let q₀_pt : ↥W_src := e₀.hom.base ⟨q_inf, hq₀⟩
          have hy₀_j : j₀.base y₀_pt = y := by
            change V₀.ι.base ((e₀.hom ≫ e₀.inv).base ⟨y, hy₀⟩) = y
            rw [e₀.hom_inv_id]; rfl
          have hq₀_j : j₀.base q₀_pt = q_inf := by
            change V₀.ι.base ((e₀.hom ≫ e₀.inv).base ⟨q_inf, hq₀⟩) = q_inf
            rw [e₀.hom_inv_id]; rfl
          have hy₀_notX : y₀_pt ∉ (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) := by
            rw [← hpre₀₁]
            change j₀.base y₀_pt ∉ V₁
            rw [hy₀_j]; exact hy_not₁
          have hq₀_notX : q₀_pt ∉ (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) := by
            rw [← hpre₀₁]
            change j₀.base q₀_pt ∉ V₁
            rw [hq₀_j]; exact hq₁
          have heq_pts : y₀_pt = q₀_pt :=
            ((hZeroX y₀_pt).mp hy₀_notX).trans ((hZeroX q₀_pt).mp hq₀_notX).symm
          exact hy_ne (hy₀_j.symm.trans ((congrArg j₀.base heq_pts).trans hq₀_j))

    · 
      refine ⟨j₀, hOpen_j₀, he₀_p, ?_⟩
      rw [hRange_j₀, hRange_σ]
      ext y
      simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
      constructor
      · intro hy₀ hyeq
        subst hyeq
        exact hq₀ hy₀
      · intro hy_ne
        by_contra hy_not₀
        have hy₁ : y ∈ V₁ := by
          have htop : y ∈ V₀ ⊔ V₁ := by rw [hCov]; trivial
          rcases htop with h0 | h1
          · exact False.elim (hy_not₀ h0)
          · exact h1
        have hq₁ : q_inf ∈ V₁ := by
          have htop : q_inf ∈ V₀ ⊔ V₁ := by rw [hCov]; trivial
          rcases htop with h0 | h1
          · exact False.elim (hq₀ h0)
          · exact h1
        let y₁_pt : ↥W_src := e₁.hom.base ⟨y, hy₁⟩
        let q₁_pt : ↥W_src := e₁.hom.base ⟨q_inf, hq₁⟩
        have hy₁_j : j₁.base y₁_pt = y := by
          change V₁.ι.base ((e₁.hom ≫ e₁.inv).base ⟨y, hy₁⟩) = y
          rw [e₁.hom_inv_id]; rfl
        have hq₁_j : j₁.base q₁_pt = q_inf := by
          change V₁.ι.base ((e₁.hom ≫ e₁.inv).base ⟨q_inf, hq₁⟩) = q_inf
          rw [e₁.hom_inv_id]; rfl
        have hy₁_notX : y₁_pt ∉ (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) := by
          rw [← hpre₁₀]
          change j₁.base y₁_pt ∉ V₀
          rw [hy₁_j]; exact hy_not₀
        have hq₁_notX : q₁_pt ∉ (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) : W_src.Opens) := by
          rw [← hpre₁₀]
          change j₁.base q₁_pt ∉ V₀
          rw [hq₁_j]; exact hq₀
        have heq_pts : y₁_pt = q₁_pt :=
          ((hZeroX y₁_pt).mp hy₁_notX).trans ((hZeroX q₁_pt).mp hq₁_notX).symm
        exact hy_ne (hy₁_j.symm.trans ((congrArg j₁.base heq_pts).trans hq₁_j))

  
  
  
  have hPolyOpenSurj :
      ∀ (L : Type u) [Field L]
        (j : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L)) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L))),
        AlgebraicGeometry.IsOpenImmersion j →
        j ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) →
        Set.range j.base = Set.univ := by
    intro L _ j hj_open hj_over
    let ψ_hom := AlgebraicGeometry.Spec.preimage j
    let ψ : Polynomial L →+* Polynomial L := ψ_hom.hom
    have hmap_ψ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) = j :=
      AlgebraicGeometry.Spec.map_preimage j
    have hψ_C : ψ.comp Polynomial.C = Polynomial.C := by
      have h1 : CommRingCat.ofHom Polynomial.C ≫ ψ_hom = CommRingCat.ofHom Polynomial.C := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage, hj_over]
      apply RingHom.ext
      intro a
      exact congrArg (fun φ : CommRingCat.of L ⟶ CommRingCat.of (Polynomial L) => φ.hom a) h1
    let g : Polynomial L := ψ Polynomial.X
    have hψ_comp : ∀ f : Polynomial L, ψ f = f.comp g := by
      have h_eq : ψ = (Polynomial.aeval (R := L) g).toRingHom := by
        apply Polynomial.ringHom_ext'
        · rw [hψ_C]
          apply RingHom.ext
          intro a
          exact ((Polynomial.aeval (R := L) g).commutes a).symm
        · exact (Polynomial.aeval_X g).symm
      intro f
      rw [h_eq, Polynomial.comp_eq_aeval]
      rfl

    rw [← hmap_ψ] at hj_open ⊢
    have : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) := hj_open
    let O_ps : Set (PrimeSpectrum (Polynomial L)) := Set.range (PrimeSpectrum.comap ψ)
    have hO_open : IsOpen O_ps :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)).isOpenEmbedding.isOpen_range

    
    let η : PrimeSpectrum (Polynomial L) := ⊥
    have hη_in_O : η ∈ O_ps := by
      let q₀ : PrimeSpectrum (Polynomial L) := PrimeSpectrum.comap ψ η
      have hq₀_in_O : q₀ ∈ O_ps := ⟨η, rfl⟩
      have h_le : η ≤ q₀ := bot_le
      have h_cl : q₀ ∈ closure ({η} : Set (PrimeSpectrum (Polynomial L))) :=
        (PrimeSpectrum.le_iff_mem_closure η q₀).mp h_le
      obtain ⟨_, hy_O, hy_sing⟩ := mem_closure_iff.mp h_cl O_ps hO_open hq₀_in_O
      rw [Set.mem_singleton_iff] at hy_sing
      exact hy_sing ▸ hy_O
    obtain ⟨p₀, hp₀⟩ := hη_in_O
    have hg_deg : 1 ≤ g.natDegree := by
      by_contra hlt
      have hg0 : g.natDegree = 0 := by omega
      obtain ⟨a, ha⟩ := Polynomial.natDegree_eq_zero.mp hg0
      have hmem0 : Polynomial.X - Polynomial.C a ∈ (PrimeSpectrum.comap ψ p₀).asIdeal := by
        change ψ (Polynomial.X - Polynomial.C a) ∈ p₀.asIdeal
        have hψ_a : ψ (Polynomial.C a) = Polynomial.C a := RingHom.congr_fun hψ_C a
        rw [map_sub, show ψ Polynomial.X = g from rfl, ← ha, hψ_a, sub_self]
        exact p₀.asIdeal.zero_mem
      rw [hp₀] at hmem0
      have hbot : Polynomial.X - Polynomial.C a = 0 := Ideal.mem_bot.mp hmem0
      exact Polynomial.X_sub_C_ne_zero a hbot

    
    obtain ⟨I, hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal O_psᶜ).mp hO_open.isClosed_compl
    obtain ⟨h, hh⟩ := IsPrincipalIdealRing.principal I
    have hI_eq : I = Ideal.span ({h} : Set (Polynomial L)) := hh
    have hCompl_h : O_psᶜ = PrimeSpectrum.zeroLocus ({h} : Set (Polynomial L)) := by
      rw [hI, hI_eq, PrimeSpectrum.zeroLocus_span]

    have hUnit_ψh : IsUnit (ψ h) := by
      by_contra hnot_u
      have hne_top : Ideal.span ({ψ h} : Set (Polynomial L)) ≠ ⊤ := by
        rwa [Ne, Ideal.span_singleton_eq_top]
      obtain ⟨M, hM_max, hle_M⟩ := Ideal.exists_le_maximal _ hne_top
      let q_M : PrimeSpectrum (Polynomial L) := ⟨M, hM_max.isPrime⟩
      have h_in_O : PrimeSpectrum.comap ψ q_M ∈ O_ps := ⟨q_M, rfl⟩
      have h_in_Z : PrimeSpectrum.comap ψ q_M ∈ PrimeSpectrum.zeroLocus ({h} : Set (Polynomial L)) := by
        rw [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff]
        exact hle_M (Ideal.subset_span (Set.mem_singleton (ψ h)))
      rw [← hCompl_h] at h_in_Z
      exact h_in_Z h_in_O

    have hh_deg0 : h.natDegree = 0 := by
      have hdeg_comp : (ψ h).natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hUnit_ψh
      rw [hψ_comp h, Polynomial.natDegree_comp] at hdeg_comp
      rcases mul_eq_zero.mp hdeg_comp with hh0 | hg0
      · exact hh0
      · omega
    obtain ⟨c₀, hc₀⟩ := Polynomial.natDegree_eq_zero.mp hh_deg0
    have hUnit_h : IsUnit h := by
      have hψ_h_eq : ψ h = h := by
        rw [← hc₀]
        exact RingHom.congr_fun hψ_C c₀
      rwa [← hψ_h_eq]

    change O_ps = Set.univ
    rw [← compl_inj_iff, Set.compl_univ, hCompl_h]
    ext q
    simp only [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff, Set.mem_empty_iff_false, iff_false]
    intro hh_in_q
    exact q.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q.asIdeal hh_in_q hUnit_h)

  
  
  
  refine Set.Subset.antisymm ?_ hs_disj
  intro z hz
  have hz_notW : z ∉ W := hz

  obtain ⟨U₀, U₁, e_U0, e_U1, hCov_U, he_U0_hom, he_U1_hom, hpre_U01, hpre_U10, hTrans_k⟩ := hP₁Atlas

  let g_R := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k R))
  let E_R := CategoryTheory.Limits.pullback g_R P₁.hom
  let π_R := CategoryTheory.Limits.pullback.fst g_R P₁.hom
  let snd_R := CategoryTheory.Limits.pullback.snd g_R P₁.hom

  let x : PrimeSpectrum R := π_R.base z
  let L : Type u := x.asIdeal.ResidueField
  let alg_kL : Algebra k L := ((algebraMap R L).comp (algebraMap k R)).toAlgebra
  let _ : Algebra k L := alg_kL
  let S_L := AlgebraicGeometry.Spec (CommRingCat.of L)
  let pt_L : ↥S_L := (⊥ : PrimeSpectrum L)
  let ξ_x : S_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R L))
  let g_L : S_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k L))

  have hξ_pt : ξ_x.base pt_L = x := by
    apply PrimeSpectrum.ext
    ext r
    change algebraMap R L r ∈ (⊥ : Ideal L) ↔ r ∈ x.asIdeal
    rw [Ideal.mem_bot, Ideal.algebraMap_residueField_eq_zero]

  have hξ_g : ξ_x ≫ g_R = g_L := by
    dsimp only [ξ_x, g_R, g_L]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]

  let E_L := CategoryTheory.Limits.pullback g_L P₁.hom
  let p_L := CategoryTheory.Limits.pullback.fst g_L P₁.hom
  let snd_L := CategoryTheory.Limits.pullback.snd g_L P₁.hom

  have hcomm_fx : (p_L ≫ ξ_x) ≫ g_R = snd_L ≫ P₁.hom := by
    rw [CategoryTheory.Category.assoc, hξ_g]
    exact CategoryTheory.Limits.pullback.condition

  let f_x : E_L ⟶ E_R := CategoryTheory.Limits.pullback.lift (p_L ≫ ξ_x) snd_L hcomm_fx
  have hfx_fst : f_x ≫ π_R = p_L ≫ ξ_x := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hfx_snd : f_x ≫ snd_R = snd_L := CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hPb_fx : CategoryTheory.IsPullback f_x p_L π_R ξ_x := by
    have hOuter : CategoryTheory.IsPullback (f_x ≫ snd_R) p_L P₁.hom (ξ_x ≫ g_R) := by
      rw [hfx_snd, hξ_g]
      exact (CategoryTheory.IsPullback.of_hasPullback g_L P₁.hom).flip
    exact CategoryTheory.IsPullback.of_right hOuter hfx_fst
      (CategoryTheory.IsPullback.of_hasPullback g_R P₁.hom).flip

  
  have hz_eq_pt : π_R.base z = ξ_x.base pt_L := hξ_pt.symm
  obtain ⟨z_L, hfx_zL, _⟩ :=
    AlgebraicGeometry.Scheme.exists_preimage_of_isPullback hPb_fx z pt_L hz_eq_pt
  let W_L : E_L.Opens := f_x ⁻¹ᵁ W
  have hzL_notWL : z_L ∉ W_L := by
    change f_x.base z_L ∉ W
    rw [hfx_zL]
    exact hz_notW

  
  have hσ_comm : (ξ_x ≫ s) ≫ π_R = 𝟙 S_L ≫ ξ_x := by
    rw [CategoryTheory.Category.assoc, hs_sec, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.id_comp]
  let σ_L : S_L ⟶ E_L := hPb_fx.lift (ξ_x ≫ s) (𝟙 S_L) hσ_comm
  have hσ_fx : σ_L ≫ f_x = ξ_x ≫ s := hPb_fx.lift_fst _ _ _
  have hσ_sec : σ_L ≫ p_L = 𝟙 S_L := hPb_fx.lift_snd _ _ _
  have hσ_disj : Set.range σ_L.base ⊆ ((W_L : Set ↥E_L)ᶜ) := by
    rintro _ ⟨u, rfl⟩
    change f_x.base (σ_L.base u) ∉ W
    have heq : f_x.base (σ_L.base u) = s.base (ξ_x.base u) := by
      change (σ_L ≫ f_x).base u = (ξ_x ≫ s).base u
      rw [hσ_fx]
    rw [heq]
    exact hs_disj ⟨ξ_x.base u, rfl⟩

  
  obtain ⟨e_WL, he_WL_p, _⟩ := hBaseChange R L E_R E_L π_R p_L f_x hPb_fx W eW heW
  let j_L : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial L)) ⟶ E_L := e_WL.inv ≫ W_L.ι
  have : CategoryTheory.IsIso e_WL.inv := e_WL.isIso_inv
  have hjL_open : AlgebraicGeometry.IsOpenImmersion j_L := by dsimp [j_L]; infer_instance
  have hjL_p : j_L ≫ p_L = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    dsimp [j_L]
    rw [CategoryTheory.Category.assoc]
    exact he_WL_p
  have hRange_jL : Set.range j_L.base = (W_L : Set ↥E_L) := by
    rw [← AlgebraicGeometry.Scheme.Opens.range_ι W_L]
    ext y
    constructor
    · rintro ⟨q, rfl⟩
      exact ⟨e_WL.inv.base q, rfl⟩
    · rintro ⟨u, rfl⟩
      refine ⟨e_WL.hom.base u, ?_⟩
      change W_L.ι.base ((e_WL.hom ≫ e_WL.inv).base u) = W_L.ι.base u
      rw [e_WL.hom_inv_id]; rfl

  
  have hPb_kL : CategoryTheory.IsPullback snd_L p_L P₁.hom g_L :=
    (CategoryTheory.IsPullback.of_hasPullback g_L P₁.hom).flip
  obtain ⟨e_V0, he_V0_p, he_V0_snd⟩ := hBaseChange k L P₁.left E_L P₁.hom p_L snd_L hPb_kL U₀ e_U0 he_U0_hom
  obtain ⟨e_V1, he_V1_p, he_V1_snd⟩ := hBaseChange k L P₁.left E_L P₁.hom p_L snd_L hPb_kL U₁ e_U1 he_U1_hom
  let V₀ : E_L.Opens := snd_L ⁻¹ᵁ U₀
  let V₁ : E_L.Opens := snd_L ⁻¹ᵁ U₁

  have hCov_VL : V₀ ⊔ V₁ = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have hy : snd_L.base y ∈ U₀ ⊔ U₁ := by rw [hCov_U]; trivial
    rcases hy with h0 | h1
    · exact Or.inl h0
    · exact Or.inr h1

  have hpre_V01 : (e_V0.inv ≫ V₀.ι) ⁻¹ᵁ V₁ = PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) := by
    have h1 : (e_V0.inv ≫ V₀.ι) ⁻¹ᵁ V₁ = (e_V0.inv ≫ V₀.ι ≫ snd_L) ⁻¹ᵁ U₁ := by
      ext q; rfl
    rw [h1, he_V0_snd]
    change (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k L)))).base).obj
        ((e_U0.inv ≫ U₀.ι) ⁻¹ᵁ U₁) = _
    rw [hpre_U01, AlgebraicGeometry.SpecMap_preimage_basicOpen]
    change PrimeSpectrum.basicOpen ((Polynomial.mapRingHom (algebraMap k L)) Polynomial.X) = _
    rw [Polynomial.coe_mapRingHom, Polynomial.map_X]

  have hpre_V10 : (e_V1.inv ≫ V₁.ι) ⁻¹ᵁ V₀ = PrimeSpectrum.basicOpen (Polynomial.X : Polynomial L) := by
    have h1 : (e_V1.inv ≫ V₁.ι) ⁻¹ᵁ V₀ = (e_V1.inv ≫ V₁.ι ≫ snd_L) ⁻¹ᵁ U₀ := by
      ext q; rfl
    rw [h1, he_V1_snd]
    change (TopologicalSpace.Opens.map
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k L)))).base).obj
        ((e_U1.inv ≫ U₁.ι) ⁻¹ᵁ U₀) = _
    rw [hpre_U10, AlgebraicGeometry.SpecMap_preimage_basicOpen]
    change PrimeSpectrum.basicOpen ((Polynomial.mapRingHom (algebraMap k L)) Polynomial.X) = _
    rw [Polynomial.coe_mapRingHom, Polynomial.map_X]

  have hTrans_L :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial L) (Localization.Away (Polynomial.X : Polynomial L)))) ≫
        e_V0.inv ≫ V₀.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.eval₂RingHom
            ((algebraMap (Polynomial L) (Localization.Away (Polynomial.X : Polynomial L))).comp
              Polynomial.C)
            (IsLocalization.Away.invSelf (Polynomial.X : Polynomial L)))) ≫
        e_V1.inv ≫ V₁.ι := by
    let LocXk := Localization.Away (Polynomial.X : Polynomial k)
    let LocXL := Localization.Away (Polynomial.X : Polynomial L)
    let τ_L : Polynomial L →+* LocXL :=
      Polynomial.eval₂RingHom ((algebraMap (Polynomial L) LocXL).comp Polynomial.C)
        (IsLocalization.Away.invSelf (Polynomial.X : Polynomial L))
    let τ_k : Polynomial k →+* LocXk :=
      Polynomial.eval₂RingHom ((algebraMap (Polynomial k) LocXk).comp Polynomial.C)
        (IsLocalization.Away.invSelf (Polynomial.X : Polynomial k))
    have hτL_C : ∀ a : L, τ_L (Polynomial.C a) = algebraMap (Polynomial L) LocXL (Polynomial.C a) :=
      fun _ => Polynomial.eval₂_C _ _
    have hτL_X : τ_L Polynomial.X = IsLocalization.Away.invSelf (S := LocXL) (Polynomial.X : Polynomial L) :=
      Polynomial.eval₂_X _ _
    have hτk_C : ∀ a : k, τ_k (Polynomial.C a) = algebraMap (Polynomial k) LocXk (Polynomial.C a) :=
      fun _ => Polynomial.eval₂_C _ _
    have hτk_X : τ_k Polynomial.X = IsLocalization.Away.invSelf (S := LocXk) (Polynomial.X : Polynomial k) :=
      Polynomial.eval₂_X _ _
    apply CategoryTheory.Limits.pullback.hom_ext
    · change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) LocXL)) ≫
          e_V0.inv ≫ V₀.ι) ≫ p_L =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫ e_V1.inv ≫ V₁.ι) ≫ p_L
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc (e_V0.inv), he_V0_p,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc (e_V1.inv), he_V1_p,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro c
      exact (hτL_C c).symm
    · change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) LocXL)) ≫
          e_V0.inv ≫ V₀.ι) ≫ snd_L =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫ e_V1.inv ≫ V₁.ι) ≫ snd_L
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc (e_V0.inv), he_V0_snd,
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc (e_V1.inv), he_V1_snd]
      let map_kL : Polynomial k →+* LocXL :=
        (algebraMap (Polynomial L) LocXL).comp (Polynomial.mapRingHom (algebraMap k L))
      have hmap_kL_X : map_kL Polynomial.X *
          IsLocalization.Away.invSelf (S := LocXL) (Polynomial.X : Polynomial L) = 1 := by
        change algebraMap (Polynomial L) LocXL ((Polynomial.mapRingHom (algebraMap k L)) Polynomial.X) * _ = 1
        rw [Polynomial.coe_mapRingHom, Polynomial.map_X]
        exact IsLocalization.Away.mul_invSelf (Polynomial.X : Polynomial L)
      obtain ⟨M_kL, hM_alg, hM_inv, _⟩ :=
        hLiftInv map_kL (Polynomial.X : Polynomial k)
          (IsLocalization.Away.invSelf (S := LocXL) (Polynomial.X : Polynomial L)) hmap_kL_X
      have hM₀ : M_kL.comp (algebraMap (Polynomial k) LocXk) =
          (algebraMap (Polynomial L) LocXL).comp (Polynomial.mapRingHom (algebraMap k L)) :=
        RingHom.ext hM_alg
      have hM₁ : M_kL.comp τ_k = τ_L.comp (Polynomial.mapRingHom (algebraMap k L)) := by
        apply Polynomial.ringHom_ext'
        · apply RingHom.ext
          intro c
          change M_kL (τ_k (Polynomial.C c)) = τ_L ((Polynomial.mapRingHom (algebraMap k L)) (Polynomial.C c))
          rw [hτk_C c, hM_alg]
          change algebraMap (Polynomial L) LocXL ((Polynomial.mapRingHom (algebraMap k L)) (Polynomial.C c)) = _
          rw [Polynomial.coe_mapRingHom, Polynomial.map_C]
          exact (hτL_C (algebraMap k L c)).symm
        · change M_kL (τ_k Polynomial.X) = τ_L ((Polynomial.mapRingHom (algebraMap k L)) Polynomial.X)
          rw [hτk_X, hM_inv, Polynomial.coe_mapRingHom, Polynomial.map_X]
          exact hτL_X.symm
      calc AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) LocXL)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k L))) ≫
              e_U0.inv ≫ U₀.ι
          = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial L) LocXL)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k L)))) ≫
              (e_U0.inv ≫ U₀.ι) := by
              simp only [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom ((algebraMap (Polynomial L) LocXL).comp
                (Polynomial.mapRingHom (algebraMap k L)))) ≫
              (e_U0.inv ≫ U₀.ι) := by
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (M_kL.comp (algebraMap (Polynomial k) LocXk))) ≫
              (e_U0.inv ≫ U₀.ι) := by
              rw [← hM₀]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_kL) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) LocXk)) ≫
                e_U0.inv ≫ U₀.ι) := by
              symm
              rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom M_kL) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_k) ≫ e_U1.inv ≫ U₁.ι) := by
              rw [hTrans_k]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (M_kL.comp τ_k)) ≫
              (e_U1.inv ≫ U₁.ι) := by
              rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (τ_L.comp (Polynomial.mapRingHom (algebraMap k L)))) ≫
              (e_U1.inv ≫ U₁.ι) := by
              rw [hM₁]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_L) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom (algebraMap k L))) ≫
              e_U1.inv ≫ U₁.ι := by
              symm
              rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
                ← CommRingCat.ofHom_comp]

  
  obtain ⟨ι_w, hOpen_ιw, hιw_p, hRange_ιw⟩ :=
    hTwoChartCompl L E_L p_L V₀ V₁ hCov_VL e_V0 e_V1 he_V0_p he_V1_p hpre_V01 hpre_V10 hTrans_L σ_L hσ_sec
  have : AlgebraicGeometry.IsOpenImmersion ι_w := hOpen_ιw
  have : AlgebraicGeometry.IsOpenImmersion j_L := hjL_open

  have hjL_sub_ιw : Set.range j_L.base ⊆ Set.range ι_w.base := by
    rw [hRange_jL, hRange_ιw]
    intro y hy hσ
    exact hσ_disj hσ hy

  let tilde_j := AlgebraicGeometry.IsOpenImmersion.lift ι_w j_L hjL_sub_ιw
  have htilde_fac : tilde_j ≫ ι_w = j_L :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac ι_w j_L hjL_sub_ιw
  have : AlgebraicGeometry.IsOpenImmersion (tilde_j ≫ ι_w) := by
    rw [htilde_fac]; exact hjL_open
  have htilde_open : AlgebraicGeometry.IsOpenImmersion tilde_j :=
    AlgebraicGeometry.IsOpenImmersion.of_comp tilde_j ι_w
  have htilde_over : tilde_j ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
    calc tilde_j ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C)
        = tilde_j ≫ (ι_w ≫ p_L) := by rw [hιw_p]
      _ = (tilde_j ≫ ι_w) ≫ p_L := (CategoryTheory.Category.assoc _ _ _).symm
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by rw [htilde_fac, hjL_p]

  have htilde_surj : Set.range tilde_j.base = Set.univ :=
    hPolyOpenSurj L tilde_j htilde_open htilde_over

  have hWL_eq_compl : (W_L : Set ↥E_L) = (Set.range σ_L.base)ᶜ := by
    rw [← hRange_jL, ← hRange_ιw, ← htilde_fac]
    ext y
    constructor
    · rintro ⟨q, rfl⟩
      exact ⟨tilde_j.base q, rfl⟩
    · rintro ⟨w, rfl⟩
      have hw : w ∈ Set.range tilde_j.base := by rw [htilde_surj]; trivial
      obtain ⟨q, rfl⟩ := hw
      exact ⟨q, rfl⟩

  have hzL_in_σ : z_L ∈ Set.range σ_L.base := by
    by_contra hzL_not_σ
    have hzL_in_compl : z_L ∈ (Set.range σ_L.base)ᶜ := hzL_not_σ
    rw [← hWL_eq_compl] at hzL_in_compl
    exact hzL_notWL hzL_in_compl

  obtain ⟨u_L, hu_L⟩ := hzL_in_σ
  refine ⟨ξ_x.base u_L, ?_⟩
  calc s.base (ξ_x.base u_L)
      = (ξ_x ≫ s).base u_L := rfl
    _ = (σ_L ≫ f_x).base u_L := by rw [← hσ_fx]
    _ = f_x.base (σ_L.base u_L) := rfl
    _ = f_x.base z_L := by rw [hu_L]
    _ = z := hfx_zL

theorem weil_pointCenter_blowup_chart_compl_and_disjoint_coprod (k : Type u) [Field k] (m : ℕ) (hm : 1 ≤ m) :
    (let P_amb := weilProjectiveSpaceOver k (m + 1)
     let B₀ := weilProjectiveSpaceOver k m
     let U_proj := weilProjCenterComplOpen k m
     let 𝒜_m := MvPolynomial.homogeneousSubmodule (Fin (m + 1)) k
     letI : GradedAlgebra 𝒜_m := MvPolynomial.gradedAlgebra
     let D_base := AlgebraicGeometry.Proj.basicOpen 𝒜_m (MvPolynomial.X (Fin.last m))
     ∃ (pr_p₀ : Quiver.Hom (U_proj : AlgebraicGeometry.Scheme.{u}) B₀.left)
       (P_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
       (p₁ : Quiver.Hom P_tilde P_amb)
       (p₂ : Quiver.Hom P_tilde B₀)
       (ε_p₀ : Quiver.Hom B₀ P_tilde)
       (e_Dbase : CategoryTheory.Iso D_base.toScheme (weilAffineSpaceOver k m).left),
       IsCenterComplLinearProjection k m pr_p₀ ∧
       Nonempty U_proj ∧
       AlgebraicGeometry.IsIntegral P_tilde.left ∧
       IsProjectiveOverField k P_tilde ∧
       AlgebraicGeometry.IsProper p₁.left ∧
       AlgebraicGeometry.IsProper p₂.left ∧
       AlgebraicGeometry.SmoothOfRelativeDimension 1 p₂.left ∧
       (CategoryTheory.CategoryStruct.comp e_Dbase.hom (weilAffineSpaceOver k m).hom =
         CategoryTheory.CategoryStruct.comp D_base.ι B₀.hom) ∧
       (((p₁.left ⁻¹ᵁ U_proj : P_tilde.left.Opens) : Set ↥P_tilde.left)ᶜ =
         Set.range ε_p₀.left.base) ∧
       ∃ (hIso_p₁ : CategoryTheory.IsIso (p₁.left ∣_ U_proj)),
         (CategoryTheory.CategoryStruct.comp
           (@CategoryTheory.inv _ _ _ _ (p₁.left ∣_ U_proj) hIso_p₁)
           (CategoryTheory.CategoryStruct.comp
             (p₁.left ⁻¹ᵁ U_proj : P_tilde.left.Opens).ι p₂.left) = pr_p₀) ∧
         (CategoryTheory.CategoryStruct.comp ε_p₀ p₂ = CategoryTheory.CategoryStruct.id B₀) ∧
         (∀ (g_pt : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) P_amb.left),
           CategoryTheory.CategoryStruct.comp g_pt P_amb.hom =
             CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
           Set.range g_pt.base ⊆ ((U_proj : Set ↥P_amb.left)ᶜ) →
           CategoryTheory.CategoryStruct.comp B₀.hom g_pt =
             CategoryTheory.CategoryStruct.comp ε_p₀.left p₁.left) ∧
         (∀ (K : Type u) [Field K] [IsAlgClosed K]
             (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of K)) B₀.left),
           IrreducibleSpace ↥(CategoryTheory.Limits.pullback p₂.left s) ∧
           topologicalKrullDim ↥(CategoryTheory.Limits.pullback p₂.left s) = (1 : WithBot ℕ∞) ∧
           ∃ z₀ : ↥(CategoryTheory.Limits.pullback p₂.left s),
             p₁.left.base ((CategoryTheory.Limits.pullback.fst p₂.left s).base z₀) ∉ U_proj)) ∧
    (∀ (Z₁ Z₂ Y S : AlgebraicGeometry.Scheme.{u})
       (ι₁ : Quiver.Hom Z₁ Y) (ι₂ : Quiver.Hom Z₂ Y) (f : Quiver.Hom Y S),
      AlgebraicGeometry.IsClosedImmersion ι₁ →
      AlgebraicGeometry.IsClosedImmersion ι₂ →
      Disjoint (Set.range ι₁.base) (Set.range ι₂.base) →
      AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp ι₁ f) →
      AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp ι₁ f) →
      AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp ι₂ f) →
      AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp ι₂ f) →
      AlgebraicGeometry.Surjective (CategoryTheory.CategoryStruct.comp ι₂ f) →
      ∃ (Z_tot : AlgebraicGeometry.Scheme.{u}) (ι_tot : Quiver.Hom Z_tot Y),
        AlgebraicGeometry.IsClosedImmersion ι_tot ∧
        Set.range ι_tot.base = Set.range ι₁.base ∪ Set.range ι₂.base ∧
        AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp ι_tot f) ∧
        AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp ι_tot f) ∧
        AlgebraicGeometry.Surjective (CategoryTheory.CategoryStruct.comp ι_tot f)) :=
by
  classical
  let _ := hm
  have hIsoOfOpenRangeEq :
      ∀ {A B C : AlgebraicGeometry.Scheme.{u}} (g₁ : A ⟶ C) (g₂ : B ⟶ C)
        [AlgebraicGeometry.IsOpenImmersion g₁] [AlgebraicGeometry.IsOpenImmersion g₂],
        Set.range g₁.base = Set.range g₂.base →
        ∃ e : A ≅ B, e.hom ≫ g₂ = g₁ ∧ e.inv ≫ g₁ = g₂ := by
    intro A B C g₁ g₂ _ _ hRange
