    have : AlgebraicGeometry.IsProper P_amb.hom := hProperProjSpace (m + 1)
    have : AlgebraicGeometry.IsProper B₀.hom := hProperProjSpace m

    obtain ⟨hCovB₀, hUproj, hCompU, hIntU, pr_p₀, p₀_pt, hPr, hp₀_hom, hp₀_range, hp₀_uniq⟩ :=
