        apply huniq_u (((C.obj AM).obj.map u.op).hom (Ψ_fun U g))
        rintro V' f' ⟨a, ha⟩
        have hcomp_map : ((C.obj AM).obj.map f'.op).hom (((C.obj AM).obj.map u.op).hom (Ψ_fun U g)) =
