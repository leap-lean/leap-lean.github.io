      intro W s
      apply hGlueArrows FM W (fun y => openEtObj W (lvlOpen W s y))
        (fun y => openEtHom W (lvlOpen W s y))
      · intro x
        exact ⟨x, ⟨x, rfl⟩, rfl⟩
      · intro y₁ y₂ Z g₁ g₂ hg
        by_cases hEmp : IsEmpty ↥(Fgt.obj Z).left
        · exact (hSubOfEmpty FM Z hEmp).elim _ _
        · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmp
          let z₁ := (Fgt.map g₁).left.base z₀
          let z₂ := (Fgt.map g₂).left.base z₀
          have hz_eq : z₁.1 = z₂.1 :=
            congrArg (fun u : Z ⟶ W => (Fgt.map u).left.base z₀) hg
