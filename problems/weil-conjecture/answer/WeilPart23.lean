                have h_sec_gh := hGlueArrows C''.left L_V U W_gh j_gh h_cov_gh
                  (fun x => (L_V.obj.map (j_gh x).op).hom (θ_fun U (g + h)))
                  (fun i₁ i₂ Z₀ f₁ f₂ hf => by
                    rw [← hMapComp L_V.obj f₁ (j_gh i₁), ← hMapComp L_V.obj f₂ (j_gh i₂), hf])
                refine h_sec_gh.unique (fun _ => rfl) ?_
                intro x
