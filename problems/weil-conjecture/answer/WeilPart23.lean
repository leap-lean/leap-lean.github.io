          ∀ (f_sec : ↑(C_bar.left.presheaf.obj (Opposite.op W₁)))
            (u_W : Units ↑(C_bar.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂)))),
            (C_bar.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom f_sec =
              (u_W : ↑(C_bar.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂)))) →
            Ideal.span {(C_bar.left.presheaf.germ W₁ P hP_mem).hom f_sec} =
