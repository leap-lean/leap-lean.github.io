      have hc₀_alg :
          algebraMap _ (FractionRing ↑(W_V₀.left.presheaf.stalk z.1)) c₀ = ev_z (α c) :=
        (hOpenGerm_V₀ z.1 (hDom_et W_V₀ z) (hInj_stalk W_V₀ z) c).symm
      have hd₀_alg :
          algebraMap _ (FractionRing ↑(W_V₀.left.presheaf.stalk z.1)) d₀ = ev_z (α d) :=
        (hOpenGerm_V₀ z.1 (hDom_et W_V₀ z) (hInj_stalk W_V₀ z) d).symm
      have hc₀_ne : c₀ ≠ 0 := by
        intro h0
        have h_unit : IsUnit (ev_z (α c)) := hu_αc.map ev_z.toMonoidHom
        rw [← hc₀_alg, h0, map_zero] at h_unit
        exact h_unit.ne_zero rfl
      have hd₀_ne : d₀ ≠ 0 := by
        intro h0
        have h_unit : IsUnit (ev_z (α d)) := (hUnitα d hd).map ev_z.toMonoidHom
        rw [← hd₀_alg, h0, map_zero] at h_unit
        exact h_unit.ne_zero rfl
      have h_rel :
          ((Units.map ev_z.toMonoidHom u :
              Units (FractionRing ↑(W_V₀.left.presheaf.stalk z.1))) :
            FractionRing ↑(W_V₀.left.presheaf.stalk z.1)) *
            algebraMap _ _ d₀ = algebraMap _ _ c₀ := by
        rw [hd₀_alg, hc₀_alg]
        change ev_z (u : E) * ev_z (α d) = ev_z (α c)
        rw [← map_mul ev_z, hcd_eq]
      have hmem_z : c₀ * d₀ ∈ IsLocalRing.maximalIdeal ↑(W_V₀.left.presheaf.stalk z.1) :=
        ((hOrd_et_spec W_V₀ z).2.2.1 (Units.map ev_z.toMonoidHom u) c₀ d₀ hc₀_ne hd₀_ne h_rel).1
          hz_val_ne
      have hcd_stalk : c₀ * d₀ = φ_st (g_st (c * d)) := by
        change φ_st (g_st c) * φ_st (g_st d) = φ_st (g_st (c * d))
        rw [← map_mul φ_st, ← map_mul g_st]
      have hmem_z' : φ_st (g_st (c * d)) ∈
          IsLocalRing.maximalIdeal ↑(V₀_op.toScheme.presheaf.stalk z_sch) := by
        rw [← hcd_stalk]
        exact hmem_z
      exact ⟨hy, (hOpenStalk U_sch V₀_op z_sch _).1.mp hmem_z'⟩

    · 
      intro s hs0 u m hm_max hm_ne
      obtain ⟨y, hy, hm_y⟩ := hMax m hm_max hm_ne
      let z_sch : ↥V₀_op.toScheme := ⟨y.1, hy⟩
      let z : { w : ↥W_V₀.left // IsClosed ({W_V₀.hom.base w} : Set ↥C.left) } :=
        ⟨z_sch, y.2⟩
      have hy_eq : (⟨j_V₀.left.base z.1, by
          rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w j_V₀]
          exact z.2⟩ : { w : ↥U.left // IsClosed ({U.hom.base w} : Set ↥C.left) }) = y :=
        Subtype.ext rfl
      let : IsDomain ↑(W_V₀.left.presheaf.stalk z.1) := hDom_et W_V₀ z
      let ev_z : E →+* FractionRing ↑(W_V₀.left.presheaf.stalk z.1) :=
        evRing W_V₀ z.1 (hDom_et W_V₀ z) (hInj_stalk W_V₀ z)
      have hInj_ev : Function.Injective ev_z := by
        intro x₁ x₂ h_eq
        by_contra hne
        have hsub : x₁ - x₂ ≠ 0 := sub_ne_zero.mpr hne
        obtain ⟨w, hw⟩ := hFieldE.mul_inv_cancel hsub
        have h01 : (0 : FractionRing ↑(W_V₀.left.presheaf.stalk z.1)) = 1 := by
          calc
            (0 : FractionRing ↑(W_V₀.left.presheaf.stalk z.1)) =
                (ev_z x₁ - ev_z x₂) * ev_z w := by rw [h_eq, sub_self, zero_mul]
            _ = ev_z ((x₁ - x₂) * w) := by rw [← map_sub ev_z, ← map_mul ev_z]
            _ = ev_z 1 := by rw [hw]
            _ = 1 := map_one ev_z
        exact zero_ne_one h01
      have hLift_unit : ∀ w_u : Units E,
          div_val W_V₀ (ofMul_V₀ w_u) z = 0 →
          ∃ a b : D, b ∉ m ∧ (w_u : E) * α b = α a := by
        intro w_u hw0
        obtain ⟨v', hv'⟩ := (hOrd_et_spec W_V₀ z).2.2.2 (Units.map ev_z.toMonoidHom w_u) |>.mp hw0
        obtain ⟨a, b, hb_not, hab_st⟩ := hUnitLift U_sch V₀_op hV₀ z_sch m hm_y v'
        refine ⟨a, b, hb_not, hInj_ev ?_⟩
        let R_z := ↑(W_V₀.left.presheaf.stalk z.1)
        let F_z := FractionRing R_z
        let a_z : R_z :=
          (V₀_op.ι.stalkMap z_sch).hom ((U_sch.presheaf.germ V₀_op z_sch.1 z_sch.2).hom a)
        let b_z : R_z :=
          (V₀_op.ι.stalkMap z_sch).hom ((U_sch.presheaf.germ V₀_op z_sch.1 z_sch.2).hom b)
        have hv_z : v'.val * b_z = a_z := hab_st
        have hb_ev : ev_z (α b) = algebraMap R_z F_z b_z :=
          hOpenGerm_V₀ z.1 (hDom_et W_V₀ z) (hInj_stalk W_V₀ z) b
        have ha_ev : ev_z (α a) = algebraMap R_z F_z a_z :=
          hOpenGerm_V₀ z.1 (hDom_et W_V₀ z) (hInj_stalk W_V₀ z) a
        have hv'_val : algebraMap R_z F_z v'.val = ev_z (w_u : E) :=
          congrArg Units.val hv'
        calc
          ev_z ((w_u : E) * α b) = ev_z (w_u : E) * ev_z (α b) := map_mul ev_z _ _
          _ = algebraMap R_z F_z v'.val * algebraMap R_z F_z b_z :=
            congrArg₂ (· * ·) hv'_val.symm hb_ev
          _ = algebraMap R_z F_z (v'.val * b_z) := (map_mul (algebraMap R_z F_z) v'.val b_z).symm
          _ = algebraMap R_z F_z a_z := congrArg (algebraMap R_z F_z) hv_z
          _ = ev_z (α a) := ha_ev.symm
      have hu_map : (((weilEtaleKPresheaf C.left).map j_V₀.op).hom s) = ofMul_V₀ u :=
        hOpenMap_V₀ s
      have hu_val0 : div_val W_V₀ (ofMul_V₀ u) z = 0 := by
        rw [← hu_map, hDivNat j_V₀ s z, hy_eq, hs0]
        rfl
      have hu_inv_neg : ofMul_V₀ (u⁻¹ : Units E) = - ofMul_V₀ u := ofMul_inv u
      have hu_inv_val0 : div_val W_V₀ (ofMul_V₀ (u⁻¹ : Units E)) z = 0 := by
        rw [hu_inv_neg, map_neg, Pi.neg_apply, hu_val0, neg_zero]
      exact ⟨hLift_unit u hu_val0, hLift_unit (u⁻¹ : Units E) hu_inv_val0⟩

    · 
      intro D_fn u₀ hu₀_V₀ V_fin hu₀_fin hFin
      let FibClPt := { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }
      let S_fin : Set FibClPt := { y : FibClPt | y.1 ∈ V_fin ∧ D_fn y ≠ 0 }
      have hMkOpen : ∀ (S_bad : Set FibClPt),
          S_bad.Finite →
          (∀ y ∈ S_bad, y.1 ≠ u₀) →
          ∃ V : U.left.Opens,
            u₀ ∈ V ∧ V ≤ V₀ ∧ V ≤ V_fin ∧ ∀ y ∈ S_bad, y.1 ∉ V := by
        intro S_bad hBad_fin hBad_ne
        let V : U.left.Opens :=
          ⟨((V₀ ⊓ V_fin : U.left.Opens) : Set ↥U.left) ∩
              ⋂ y ∈ S_bad, ((V₀ : Set ↥U.left) \ {y.1}),
            (V₀ ⊓ V_fin).isOpen.inter (hBad_fin.isOpen_biInter fun y _ => hOpenCompl y)⟩
        refine ⟨V, ?_, fun _ hx => hx.1.1, fun _ hx => hx.1.2, ?_⟩
        · refine ⟨⟨hu₀_V₀, hu₀_fin⟩, Set.mem_iInter₂.mpr fun y hy => ⟨hu₀_V₀, ?_⟩⟩
          intro h_eq
          exact hBad_ne y hy (Set.mem_singleton_iff.mp h_eq).symm
        · intro y hy hyV
          exact (Set.mem_iInter₂.mp hyV.2 y hy).2 rfl

      by_cases h_active : ∃ hcl : IsClosed ({U.hom.base u₀} : Set ↥C.left), D_fn ⟨u₀, hcl⟩ ≠ 0
      · 
        obtain ⟨hcl, _⟩ := h_active
        let y₀ : FibClPt := ⟨u₀, hcl⟩
        let z₀_sch : ↥V₀_op.toScheme := ⟨u₀, hu₀_V₀⟩
        obtain ⟨a₀, b₀, ha₀, hb₀, hb₀_not, ha₀_span⟩ :=
          hUnifLift U_sch V₀_op hV₀ z₀_sch (hDom_et U y₀) (hDVR_inst U y₀)
        have ha₀b₀ : a₀ * b₀ ≠ 0 := mul_ne_zero ha₀ hb₀
        let S_bad : Set FibClPt :=
          { y : FibClPt | y ∈ S_fin ∧ y ≠ y₀ } ∪
          { y : FibClPt | y ≠ y₀ ∧ ∃ hy : y.1 ∈ V₀,
            (U.left.presheaf.germ V₀ y.1 hy).hom (a₀ * b₀) ∈
              IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1) }
        have hBad_fin : S_bad.Finite :=
          (hFin.subset fun _ h => h.1).union ((hFinD (a₀ * b₀) ha₀b₀).subset fun _ h => h.2)
        have hBad_ne : ∀ y ∈ S_bad, y.1 ≠ u₀ := by
          intro y hy h_eq
          have hy_ne : y ≠ y₀ := by
            rcases hy with h1 | h2
            · exact h1.2
            · exact h2.1
          exact hy_ne (Subtype.ext h_eq)
        obtain ⟨V, hu₀_V, hVV₀, hVVfin, hNotBad⟩ := hMkOpen S_bad hBad_fin hBad_ne
        refine ⟨V, hu₀_V, ?_⟩
        intro W_V j_V
        let k_V : W_V ⟶ W_V₀ :=
          CategoryTheory.MorphismProperty.Over.homMk (U_sch.homOfLE hVV₀)
            (by
              change U_sch.homOfLE hVV₀ ≫ (V₀.ι ≫ U.hom) = V.ι ≫ U.hom
              rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι])
            trivial
        let u_unif : Units E := (hUnitα a₀ ha₀).unit * ((hUnitα b₀ hb₀).unit)⁻¹
        have hu_unif_eq : (u_unif : E) * α b₀ = α a₀ := by
          change ((hUnitα a₀ ha₀).unit : E) * (((hUnitα b₀ hb₀).unit⁻¹ : Units E) : E) *
            ((hUnitα b₀ hb₀).unit : E) = ((hUnitα a₀ ha₀).unit : E)
          rw [mul_assoc, Units.inv_mul, mul_one]
        let pull_k : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op W_V₀)) →+
            ↥((weilEtaleKPresheaf C.left).obj (Opposite.op W_V)) :=
          ((weilEtaleKPresheaf C.left).map k_V.op).hom
        let s_V : ↥((weilEtaleKPresheaf C.left).obj (Opposite.op W_V)) :=
          pull_k (D_fn y₀ • ofMul_V₀ u_unif)
        refine ⟨s_V, fun z => ?_⟩
        let z_V : ↥V := z.1
        let y' : FibClPt :=
          ⟨j_V.left.base z.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w j_V]
            exact z.2⟩
        let z_V₀ : { w : ↥W_V₀.left // IsClosed ({W_V₀.hom.base w} : Set ↥C.left) } :=
          ⟨k_V.left.base z.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w k_V]
            exact z.2⟩
        let z_V₀_sch : ↥V₀_op.toScheme := z_V₀.1
        let z_V₀_sub : ↥V₀_op := z_V₀.1
        have hz_V₀_fst : z_V₀_sub.1 = z_V.1 := by
          have hcomp := congrArg (fun h : (V : U_sch.Opens).toScheme ⟶ U_sch => h.base z_V)
            (U_sch.homOfLE_ι hVV₀)
          exact hcomp
        have hsV_eval :
            div_val W_V s_V z = D_fn y₀ • div_val W_V₀ (ofMul_V₀ u_unif) z_V₀ := by
          dsimp only [s_V]
          rw [map_zsmul pull_k, map_zsmul (div_val W_V), Pi.smul_apply,
            hDivNat k_V (ofMul_V₀ u_unif) z]
        rw [hsV_eval]
        let : IsDomain ↑(W_V₀.left.presheaf.stalk z_V₀.1) := hDom_et W_V₀ z_V₀
        let ev_z : E →+* FractionRing ↑(W_V₀.left.presheaf.stalk z_V₀.1) :=
          evRing W_V₀ z_V₀.1 (hDom_et W_V₀ z_V₀) (hInj_stalk W_V₀ z_V₀)
        let φ_st : ↑(U_sch.presheaf.stalk z_V₀_sub.1) →+*
            ↑(V₀_op.toScheme.presheaf.stalk z_V₀_sch) :=
          (V₀_op.ι.stalkMap z_V₀_sch).hom
        let g_st : D →+* ↑(U_sch.presheaf.stalk z_V₀_sub.1) :=
          (U_sch.presheaf.germ V₀_op z_V₀_sub.1 z_V₀_sub.2).hom
        let c' : ↑(W_V₀.left.presheaf.stalk z_V₀.1) := φ_st (g_st a₀)
        let d' : ↑(W_V₀.left.presheaf.stalk z_V₀.1) := φ_st (g_st b₀)
        have hc'_alg :
            algebraMap _ (FractionRing ↑(W_V₀.left.presheaf.stalk z_V₀.1)) c' = ev_z (α a₀) :=
          (hOpenGerm_V₀ z_V₀.1 (hDom_et W_V₀ z_V₀) (hInj_stalk W_V₀ z_V₀) a₀).symm
        have hd'_alg :
            algebraMap _ (FractionRing ↑(W_V₀.left.presheaf.stalk z_V₀.1)) d' = ev_z (α b₀) :=
          (hOpenGerm_V₀ z_V₀.1 (hDom_et W_V₀ z_V₀) (hInj_stalk W_V₀ z_V₀) b₀).symm
        have hc'_ne : c' ≠ 0 := by
          intro h0
          have h_unit : IsUnit (ev_z (α a₀)) := (hUnitα a₀ ha₀).map ev_z.toMonoidHom
          rw [← hc'_alg, h0, map_zero] at h_unit
          exact h_unit.ne_zero rfl
        have hd'_ne : d' ≠ 0 := by
          intro h0
          have h_unit : IsUnit (ev_z (α b₀)) := (hUnitα b₀ hb₀).map ev_z.toMonoidHom
          rw [← hd'_alg, h0, map_zero] at h_unit
          exact h_unit.ne_zero rfl
        have h_rel :
            ((Units.map ev_z.toMonoidHom u_unif :
                Units (FractionRing ↑(W_V₀.left.presheaf.stalk z_V₀.1))) :
              FractionRing ↑(W_V₀.left.presheaf.stalk z_V₀.1)) *
              algebraMap _ _ d' = algebraMap _ _ c' := by
          rw [hd'_alg, hc'_alg]
          change ev_z (u_unif : E) * ev_z (α b₀) = ev_z (α a₀)
          rw [← map_mul ev_z, hu_unif_eq]
        by_cases hy'_eq : y' = y₀
        · have hz_eq_z₀ : z_V₀_sch = z₀_sch := by
            apply Subtype.ext
            rw [hz_V₀_fst]
            exact congrArg Subtype.val hy'_eq
          have hc'_span :
              Ideal.span ({c'} : Set ↑(W_V₀.left.presheaf.stalk z_V₀.1)) =
                IsLocalRing.maximalIdeal ↑(W_V₀.left.presheaf.stalk z_V₀.1) := by
            change Ideal.span
                ({(V₀_op.ι.stalkMap z_V₀_sch).hom
                    ((U_sch.presheaf.germ V₀_op (z_V₀_sch : ↥V₀_op).1 (z_V₀_sch : ↥V₀_op).2).hom a₀)} :
                  Set ↑(V₀_op.toScheme.presheaf.stalk z_V₀_sch)) =
              IsLocalRing.maximalIdeal ↑(V₀_op.toScheme.presheaf.stalk z_V₀_sch)
            rw [(hOpenStalk U_sch V₀_op z_V₀_sch _).2, hz_eq_z₀]
            exact ha₀_span
          have hd'_not :
              d' ∉ IsLocalRing.maximalIdeal ↑(W_V₀.left.presheaf.stalk z_V₀.1) := by
            change (V₀_op.ι.stalkMap z_V₀_sch).hom
                ((U_sch.presheaf.germ V₀_op (z_V₀_sch : ↥V₀_op).1 (z_V₀_sch : ↥V₀_op).2).hom b₀) ∉
              IsLocalRing.maximalIdeal ↑(V₀_op.toScheme.presheaf.stalk z_V₀_sch)
            rw [(hOpenStalk U_sch V₀_op z_V₀_sch _).1, hz_eq_z₀]
            exact hb₀_not
          have h_ord1 : div_val W_V₀ (ofMul_V₀ u_unif) z_V₀ = 1 :=
            ((hOrd_et_spec W_V₀ z_V₀).2.2.1
              (Units.map ev_z.toMonoidHom u_unif) c' d' hc'_ne hd'_ne h_rel).2.2
              hc'_span hd'_not
          change D_fn y₀ • div_val W_V₀ (ofMul_V₀ u_unif) z_V₀ = D_fn y'
          rw [h_ord1, zsmul_one, Int.cast_id, hy'_eq]
        · have hy'_V : y'.1 ∈ V := z_V.2
          have hy'_not_bad : y' ∉ S_bad := fun h => hNotBad y' h hy'_V
          have hy'_fin : y'.1 ∈ V_fin := hVVfin hy'_V
          have hD_zero : D_fn y' = 0 := by
            by_contra h_ne
            exact hy'_not_bad (Or.inl ⟨⟨hy'_fin, h_ne⟩, hy'_eq⟩)
          have h_not_mem_y' :
              g_st (a₀ * b₀) ∉ IsLocalRing.maximalIdeal ↑(U_sch.presheaf.stalk z_V₀_sub.1) := by
            intro hmem
            have hy'_eq_z : y'.1 = z_V₀_sub.1 := hz_V₀_fst.symm
            have hmem' :
                ∃ hy : y'.1 ∈ V₀,
                  (U.left.presheaf.germ V₀ y'.1 hy).hom (a₀ * b₀) ∈
                    IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y'.1) := by
              rw [hy'_eq_z]
              exact ⟨z_V₀_sub.2, hmem⟩
            exact hy'_not_bad (Or.inr ⟨hy'_eq, hmem'⟩)
          have hcd'_not :
              c' * d' ∉ IsLocalRing.maximalIdeal ↑(W_V₀.left.presheaf.stalk z_V₀.1) := by
            have hmul : c' * d' = φ_st (g_st (a₀ * b₀)) := by
              change φ_st (g_st a₀) * φ_st (g_st b₀) = φ_st (g_st (a₀ * b₀))
              rw [← map_mul φ_st, ← map_mul g_st]
            rw [hmul]
            change (V₀_op.ι.stalkMap z_V₀_sch).hom _ ∉
              IsLocalRing.maximalIdeal ↑(V₀_op.toScheme.presheaf.stalk z_V₀_sch)
            rw [(hOpenStalk U_sch V₀_op z_V₀_sch _).1]
            exact h_not_mem_y'
          have h_ord0 : div_val W_V₀ (ofMul_V₀ u_unif) z_V₀ = 0 :=
            ((hOrd_et_spec W_V₀ z_V₀).2.2.1
              (Units.map ev_z.toMonoidHom u_unif) c' d' hc'_ne hd'_ne h_rel).2.1 hcd'_not
          change D_fn y₀ • div_val W_V₀ (ofMul_V₀ u_unif) z_V₀ = D_fn y'
          rw [h_ord0, smul_zero, hD_zero]

      · 
        have hFin_ne : ∀ y ∈ S_fin, y.1 ≠ u₀ := by
          intro y hy h_eq
          have hcl : IsClosed ({U.hom.base u₀} : Set ↥C.left) := h_eq ▸ y.2
          have hy_eq : (⟨u₀, hcl⟩ : FibClPt) = y := Subtype.ext h_eq.symm
          exact h_active ⟨hcl, hy_eq ▸ hy.2⟩
        obtain ⟨V, hu₀_V, _, hVVfin, hNotBad⟩ := hMkOpen S_fin hFin hFin_ne
        refine ⟨V, hu₀_V, ?_⟩
        intro W_V j_V
        refine ⟨0, fun z => ?_⟩
        let z_V : ↥V := z.1
        let y' : FibClPt :=
          ⟨j_V.left.base z.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w j_V]
            exact z.2⟩
        have hy'_V : y'.1 ∈ V := z_V.2
        have hy'_fin : y'.1 ∈ V_fin := hVVfin hy'_V
        have hy'_not : y' ∉ S_fin := fun h => hNotBad y' h hy'_V
        have hD_zero : D_fn y' = 0 := by
          by_contra h_ne
          exact hy'_not ⟨hy'_fin, h_ne⟩
        rw [map_zero, Pi.zero_apply]
        exact hD_zero.symm

theorem weil_smooth_qc_sep_curve_canonical_divisor_short_exact (k : Type u) [Field k] [IsAlgClosed k]
    (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z))
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C.left]
    [CompactSpace ↥C.left]
    [C.left.IsSeparated]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (ι_gm : weilEtaleGmSheaf C.left ⟶ weilEtaleKSheaf C.left)
    (k_hom : Additive (Units ↑C.left.functionField) →+ (weilEtaleKSheaf C.left).H 0)
    (hPin_gm :
      letI : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
      let shAdj := CategoryTheory.sheafificationAdjunction C.left.smallEtaleTopology AddCommGrpCat.{u}
      let η_C := C.left.fromSpecStalk (genericPoint ↥C.left)
      ∀ (U : C.left.Etale) (u : Units ↑(U.left.presheaf.obj (Opposite.op ⊤))),
        (ι_gm.hom.app (Opposite.op U)).hom
