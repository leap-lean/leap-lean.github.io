      have hFibEq : ∀ {Z₁ Z₂ : S.Etale} (f₁ : Z₁ ⟶ W) (f₂ : Z₂ ⟶ W)
          (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂)
          (y₁ : ↥(Fgt.obj Z₁).left) (y₂ : ↥(Fgt.obj Z₂).left),
