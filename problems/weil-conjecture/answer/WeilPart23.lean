  obtain ⟨hEx_tp, hCard0_M⟩ :=
    @weil_etale_cyclic_sheet_freeYoneda_telescoping_exact X ℓ _ V_et V'_et hOpen_Vet
      p_et σ_et hσ_p h0_tp hEnd_V' hSheets_et

  
  obtain ⟨hArt, hDesc⟩ := weil_finite_alg_pointed_etale_decomposition_and_descent.{u}
  obtain ⟨hArtEpi, hAffGeom⟩ := weil_etale_affine_geom_point_pbc_of_alg_descent.{u} hArt hDesc
  have hPresEpi : WeilEtalePushforwardPreservesEpi bar_p.left :=
    (weil_etale_pbc_reduction_to_affine_geom_point.{u} hArtEpi hAffGeom
      bar_p.left (CategoryTheory.CategoryStruct.id C_bar.left) bar_p.left
      (CategoryTheory.CategoryStruct.id C'_bar.left)
      (CategoryTheory.IsPullback.of_id_snd (f := bar_p.left)).flip).1
  have hDimC' : topologicalKrullDim C'_bar.left = (1 : WithBot ℕ∞) := by
    rw [(weil_isFinite_projective_and_krullDim_over_field k bar_p hIntC' inferInstance
      hProjC hFin_p hSurj_p).2]
    exact hDimC
  have hStalkC'_full := weil_smooth_curve_etale_stalk_dvr_and_domain_chart k C'_bar hDimC'
  have hStalkDVR_C' : ∀ x' : { x : ↥C'_bar.left // IsClosed ({x} : Set ↥C'_bar.left) },
      ∃ hDom : IsDomain ↑(C'_bar.left.presheaf.stalk x'.1),
        @IsDiscreteValuationRing ↑(C'_bar.left.presheaf.stalk x'.1) _ hDom :=
    fun x' => hStalkC'_full.2.1 (weilEtaleIdTerminal.{u} C'_bar.left) ⟨x'.1, x'.2⟩
  obtain ⟨deg_Cl, P₀, _, hdeg_sum, hdeg_P₀, -⟩ :=
    weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj k C_bar hProjC
  have hValPkg_C :=
    weil_smooth_curve_generic_gm_divisor_valuation_package k C_bar hDimC hGmSheaf
  have hModComp : ∀ (S : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      ∃ θ : weilCupPDModH S ℓ q →+ weilEtaleTorsionH S ℓ q,
        WeilIsModuleToTorsionComparison S ℓ q θ ∧ Function.Bijective θ :=
    fun S q => (weil_etale_module_ext_comparison.{u}.1 S ℓ q).1
  have he_V'_refl :
      CategoryTheory.CategoryStruct.comp (CategoryTheory.Iso.refl V'_open.toScheme).hom
        (CategoryTheory.CategoryStruct.comp V'_open.ι bar_p.left) =
      ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj V'_et).hom := by
    change 𝟙 V'_open.toScheme ≫ (V'_open.ι ≫ bar_p.left) = (bar_p.left ∣_ V) ≫ V.ι
    rw [CategoryTheory.Category.id_comp]
    exact (AlgebraicGeometry.morphismRestrict_ι bar_p.left V).symm
  obtain ⟨hCard2_M, hz_M⟩ :=
    weil_etale_finite_curve_cover_local_H2_and_norm_counit k ℓ hℓ C_bar C'_bar
      hProjC hProjC' hDimC hDimC'
      ⟨hStalkC_full.2.1, hStalkC_full.2.2.1⟩ hStalkDVR_C'
      bar_p hFree_p hPresEpi hKum hProjCurveH2 hModComp
      ⟨deg_Cl, P₀, hdeg_sum, hdeg_P₀⟩ hValPkg_C
      V hNe_V hp_et
      (fun x => by
        obtain ⟨W, hAffW, w, hEt_w, w₀, hw₀, s_sh, hO, hS, _, hD, hU⟩ := hSheets_V x
        exact ⟨W, hAffW, w, hEt_w, w₀, hw₀, s_sh, hO, hS, hD, hU⟩)
      V'_et (CategoryTheory.Iso.refl V'_open.toScheme) he_V'_refl hCard0_M

  exact ⟨V'_et, p_et, σ_et, hConj1, hEpi_π, ⟨h0_tp, hEx_tp⟩, hCard0_M, hCard2_M, hz_M⟩

theorem weil_etale_affine_curve_mod_prime_duality (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC : AlgebraicGeometry.IsIntegral C_bar.left)
    (hProjC : IsProjectiveOverField k C_bar)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom] :
    Finite (weilCupPDModH C_bar.left ℓ 1) ∧
    (∀ a : weilCupPDModH C_bar.left ℓ 1,
      (∀ b : weilCupPDModH C_bar.left ℓ 1,
        CategoryTheory.Abelian.Ext.comp a b (rfl : 1 + 1 = 2) = 0) →
      a = 0) ∧
    (∀ (U_C : C_bar.left.Opens) (U_et C'_et : C_bar.left.Etale)
        (v_et : Quiver.Hom C'_et U_et)
        (e_U : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj U_et).left
          U_C.toScheme),
      AlgebraicGeometry.IsAffineOpen U_C →
      Nonempty ↥U_C →
      (U_C : Set ↥C_bar.left) ≠ Set.univ →
      CategoryTheory.CategoryStruct.comp e_U.hom U_C.ι =
        ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj U_et).hom →
      ConnectedSpace ↥((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj C'_et).left →
      AlgebraicGeometry.IsFinite
        (CategoryTheory.CategoryStruct.comp
          ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).map v_et).left e_U.hom) →
      AlgebraicGeometry.Etale
        (CategoryTheory.CategoryStruct.comp
          ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).map v_et).left e_U.hom) →
      AlgebraicGeometry.Surjective
        (CategoryTheory.CategoryStruct.comp
          ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).map v_et).left e_U.hom) →
      (∃ p₁ : weilEtaleTorsionH U_C.toScheme ℓ 1 →+
          weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj C'_et).left ℓ 1,
        WeilIsTorsionEtalePullback
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).map v_et).left e_U.hom)
          ℓ 1 p₁ ∧
        ∀ β : weilEtaleTorsionH U_C.toScheme ℓ 1, p₁ β = 0) →
      weilEtaleLocalTorsionMapH C_bar.left ℓ v_et 1 = 0) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have _ : AlgebraicGeometry.IsIntegral C_bar.left := hIntC
  let X : AlgebraicGeometry.Scheme.{u} := C_bar.left
  let R : Type u := ULift.{u, 0} (ZMod ℓ)
  let RM : ModuleCat.{u, u} R := ModuleCat.of R R
  let oneR : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R) :=
    weilCupPDModUnit X ℓ

  
  have hMod1 := weil_etale_module_ext_comparison.{u}.1
  let θ_mod : ∀ (S : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      weilCupPDModH S ℓ q →+ weilEtaleTorsionH S ℓ q :=
    fun S q => Classical.choose (hMod1 S ℓ q).1
  have hθ_mod_bij : ∀ (S : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      Function.Bijective (θ_mod S q) :=
    fun S q => (Classical.choose_spec (hMod1 S ℓ q).1).2
  let eθ_mod : ∀ (S : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      weilCupPDModH S ℓ q ≃+ weilEtaleTorsionH S ℓ q :=
    fun S q => AddEquiv.ofBijective (θ_mod S q) (hθ_mod_bij S q)
  have hKum : ∀ Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)),
      CategoryTheory.Presheaf.IsSheaf Y.left.smallEtaleTopology (weilEtaleGmPresheaf Y.left) ∧
      ∃ (ι_kum : weilEtaleTorsionSheaf Y.left ℓ ⟶ weilEtaleGmSheaf Y.left)
        (p_kum : weilEtaleGmSheaf Y.left ⟶ weilEtaleGmSheaf Y.left)
        (h0 : ι_kum ≫ p_kum = 0),
        p_kum = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y.left) ∧
        (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact :=
    fun Y => weil_etale_kummer_mod_prime_short_exact k Y ℓ hℓ

  
  have hProjCurvePkg :
      ∀ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C.left],
        IsProjectiveOverField k C →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
          Finite { c : weilCurveClGroup C.left // ℓ • c = 0 } ∧
          Finite (weilCupPDModH C.left ℓ 1) ∧
          Nat.card (weilCupPDModH C.left ℓ 1) =
            Nat.card { c : weilCurveClGroup C.left // ℓ • c = 0 } ∧
          Nonempty ((weilEtaleGmSheaf C.left).H 1 ≃+ weilCurveClGroup C.left) ∧
          Subsingleton ((weilEtaleGmSheaf C.left).H 2) ∧
          Nat.card (weilCupPDModH C.left ℓ 2) = ℓ ∧
          Nat.card (weilCurveClGroup C.left ⧸
            (zsmulAddGroupHom (ℓ : ℤ) :
              weilCurveClGroup C.left →+ weilCurveClGroup C.left).range) = ℓ := by
    intro C _ hProj _
    have hRiem := weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj k C hProj
    obtain ⟨hFin_tors, hCard_quot⟩ :=
      weil_smooth_proj_curve_picZero_divisible_and_torsion_finite k C hProj ℓ hℓ hRiem
    obtain ⟨hDiv0, ⟨e_Cl⟩, hSub_ge2⟩ :=
      weil_etale_smooth_proj_curve_gm_cohomology_and_divisor_iso k C hProj ℓ
    have hSub2 : Subsingleton ((weilEtaleGmSheaf C.left).H 2) := hSub_ge2 2 (le_refl 2)
    obtain ⟨_, ι_kum, p_kum, h0_kum, hp_kum, hSES_kum⟩ := hKum C
    let Fℤ_C := (CategoryTheory.constantSheaf C.left.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let Gm_C := weilEtaleGmSheaf C.left
    let T_C := weilEtaleTorsionSheaf C.left ℓ
    have hcomp_nsmul :
        ∀ {q : ℕ} (n : ℕ) (x : CategoryTheory.Abelian.Ext.{u} Fℤ_C Gm_C q),
          x.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id Gm_C))
            (Nat.add_zero q) = n • x := by
      intro q n x
      induction n with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ n ih =>
        rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ih,
          CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
    have hp_post :
        ∀ {q : ℕ} (x : CategoryTheory.Abelian.Ext.{u} Fℤ_C Gm_C q),
          x.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero q) = ℓ • x := by
      intro q x
      rw [hp_kum]
      exact hcomp_nsmul ℓ x
    let ι₁ : weilEtaleTorsionH C.left ℓ 1 →+ weilCurveClGroup C.left :=
      e_Cl.toAddMonoidHom.comp
        (AddMonoidHom.mk'
          (fun x => x.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1))
          (fun x₁ x₂ => CategoryTheory.Abelian.Ext.add_comp x₁ x₂ _ (Nat.add_zero 1)))
    have hι₁_tors : ∀ x : weilEtaleTorsionH C.left ℓ 1, ℓ • ι₁ x = 0 := by
      intro x
      change ℓ • e_Cl (x.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1)) = 0
      rw [← map_nsmul, ← hp_post,
        CategoryTheory.Abelian.Ext.comp_assoc x
          (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (CategoryTheory.Abelian.Ext.mk₀ p_kum)
          (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      change e_Cl (x.comp (CategoryTheory.Abelian.Ext.mk₀ (ι_kum ≫ p_kum)) (Nat.add_zero 1)) = 0
      rw [h0_kum, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero, map_zero]
    let φ₁_fn : weilEtaleTorsionH C.left ℓ 1 → { c : weilCurveClGroup C.left // ℓ • c = 0 } :=
      fun x => ⟨ι₁ x, hι₁_tors x⟩
    have hinj_φ₁ : Function.Injective φ₁_fn := by
      intro x₁ x₂ h
      have hsub : ι₁ (x₁ - x₂) = 0 := by
        rw [map_sub, sub_eq_zero]
        exact congrArg Subtype.val h
      have hx_comp : (x₁ - x₂).comp
          (CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).f)
          (Nat.add_zero 1) = 0 :=
        e_Cl.injective (hsub.trans (map_zero e_Cl).symm)
      obtain ⟨x₀, hx₀_ext⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hSES_kum
          (x₁ - x₂) hx_comp (Nat.zero_add 1)
      obtain ⟨y₀, hy₀⟩ := hDiv0 x₀
      have hx₀_eq : x₀ = y₀.comp (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).g) (Nat.add_zero 0) := by
        change x₀ = y₀.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero 0)
        rw [hp_post, hy₀]
      have hdiff0 : x₁ - x₂ = 0 := by
        rw [← hx₀_ext, hx₀_eq,
          CategoryTheory.Abelian.Ext.comp_assoc y₀
            (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).g)
            hSES_kum.extClass (Nat.add_zero 0) (Nat.zero_add 1) (Nat.zero_add 1),
          hSES_kum.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      exact sub_eq_zero.mp hdiff0
    have hsurj_φ₁ : Function.Surjective φ₁_fn := by
      rintro ⟨c, hc⟩
      let u₁ : CategoryTheory.Abelian.Ext.{u} Fℤ_C Gm_C 1 := e_Cl.symm c
      have hu₁ : u₁.comp (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).g) (Nat.add_zero 1) = 0 := by
        change u₁.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero 1) = 0
        rw [hp_post]
        apply e_Cl.injective
        rw [map_nsmul, map_zero, AddEquiv.apply_symm_apply]
        exact hc
      obtain ⟨x, hx⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_C hSES_kum u₁ hu₁
      refine ⟨x, Subtype.ext ?_⟩
      change e_Cl (x.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1)) = c
      rw [hx]
      exact e_Cl.apply_symm_apply c
    let e_H1 : weilCupPDModH C.left ℓ 1 ≃ { c : weilCurveClGroup C.left // ℓ • c = 0 } :=
      (eθ_mod C.left 1).toEquiv.trans (Equiv.ofBijective φ₁_fn ⟨hinj_φ₁, hsurj_φ₁⟩)
    have hFin_H1 : Finite (weilCupPDModH C.left ℓ 1) :=
      @Finite.of_equiv _ _ hFin_tors e_H1.symm
    have hCard_H1 : Nat.card (weilCupPDModH C.left ℓ 1) =
        Nat.card { c : weilCurveClGroup C.left // ℓ • c = 0 } :=
      Nat.card_congr e_H1

    let δ₁ : weilCurveClGroup C.left →+ weilEtaleTorsionH C.left ℓ 2 :=
      (AddMonoidHom.mk'
        (fun u₁ : CategoryTheory.Abelian.Ext.{u} Fℤ_C Gm_C 1 =>
          u₁.comp hSES_kum.extClass (rfl : 1 + 1 = 2))
        (fun a b =>
          CategoryTheory.Abelian.Ext.add_comp a b hSES_kum.extClass (rfl : 1 + 1 = 2))).comp
        e_Cl.symm.toAddMonoidHom
    have hsurj_δ₁ : Function.Surjective δ₁ := by
      intro z₂
      have hz₂ : z₂.comp (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).f) (Nat.add_zero 2) = 0 :=
        @Subsingleton.elim _ hSub2 _ 0
      obtain ⟨u₁, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hSES_kum
          z₂ hz₂ (rfl : 1 + 1 = 2)
      refine ⟨e_Cl u₁, ?_⟩
      change (e_Cl.symm (e_Cl u₁)).comp hSES_kum.extClass (rfl : 1 + 1 = 2) = _
      rw [e_Cl.symm_apply_apply]
    let R_Cl : AddSubgroup (weilCurveClGroup C.left) :=
      (zsmulAddGroupHom (ℓ : ℤ) :
        weilCurveClGroup C.left →+ weilCurveClGroup C.left).range
    have hker_δ₁ : δ₁.ker = R_Cl := by
      ext c
      rw [AddMonoidHom.mem_ker]
      constructor
      · intro hc
        change (e_Cl.symm c).comp hSES_kum.extClass (rfl : 1 + 1 = 2) = 0 at hc
        obtain ⟨v₁, hv₁⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_C hSES_kum
            (e_Cl.symm c) (rfl : 1 + 1 = 2) hc
        change v₁.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero 1) =
          e_Cl.symm c at hv₁
        rw [hp_post] at hv₁
        refine ⟨e_Cl v₁, ?_⟩
        change (ℓ : ℤ) • e_Cl v₁ = c
        rw [natCast_zsmul, ← map_nsmul, hv₁, e_Cl.apply_symm_apply]
      · rintro ⟨d, rfl⟩
        change (e_Cl.symm ((ℓ : ℤ) • d)).comp hSES_kum.extClass (rfl : 1 + 1 = 2) = 0
        rw [natCast_zsmul, map_nsmul, ← hp_post (e_Cl.symm d),
          CategoryTheory.Abelian.Ext.comp_assoc (e_Cl.symm d)
            (CategoryTheory.Abelian.Ext.mk₀
              (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).g)
            hSES_kum.extClass (Nat.add_zero 1) (Nat.zero_add 1) (rfl : 1 + 1 = 2),
          hSES_kum.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
    let e₂ : (weilCurveClGroup C.left ⧸ R_Cl) ≃+ weilEtaleTorsionH C.left ℓ 2 :=
      (QuotientAddGroup.quotientAddEquivOfEq hker_δ₁.symm).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective δ₁ hsurj_δ₁)
    have hCard_H2 : Nat.card (weilCupPDModH C.left ℓ 2) = ℓ := by
      rw [Nat.card_congr ((eθ_mod C.left 2).toEquiv.trans e₂.symm.toEquiv)]
      exact hCard_quot
    exact ⟨hFin_tors, hFin_H1, hCard_H1, ⟨e_Cl⟩, hSub2, hCard_H2, hCard_quot⟩

  obtain ⟨hFin1_Cl, hFin1_C, hCard1_C, -, -, hCard2_X, hCardQ_C⟩ :=
    hProjCurvePkg C_bar hProjC
  have hProjCurveH2 :
      ∀ (C' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C'.left],
        IsProjectiveOverField k C' →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C'.hom],
          Nonempty ((weilEtaleGmSheaf C'.left).H 1 ≃+ weilCurveClGroup C'.left) ∧
          Subsingleton ((weilEtaleGmSheaf C'.left).H 2) ∧
          Nat.card (weilCupPDModH C'.left ℓ 2) = ℓ := by
    intro C' _ hProj' _
    obtain ⟨-, -, -, h1, h2, h3, -⟩ := hProjCurvePkg C' hProj'
    exact ⟨h1, h2, h3⟩

  have hDiv_Cl0 :
      ∀ (deg_Cl : weilCurveClGroup X →+ ℤ),
        (∀ D : ({ x : ↥X // IsClosed ({x} : Set ↥X) } →₀ ℤ),
          deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D) =
            D.sum (fun _ n => n)) →
        ∀ c : weilCurveClGroup X, deg_Cl c = 0 →
          ∃ y : weilCurveClGroup X, deg_Cl y = 0 ∧ ℓ • y = c := by
    obtain ⟨deg₀, P₀, _, hdeg₀_sum, hdeg₀_P₀, -⟩ :=
      weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj k C_bar hProjC
    intro deg_Cl hdeg_sum c hc
    have hdeg_eq : deg_Cl = deg₀ := by
      apply DFunLike.ext
      intro x
      obtain ⟨D, rfl⟩ := QuotientAddGroup.mk'_surjective (weilCurvePrincipalSubgroup X) x
      exact (hdeg_sum D).trans (hdeg₀_sum D).symm
    have hdeg_P₀ :
        deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (Finsupp.single P₀ 1)) = 1 := by
      rw [hdeg_eq]
      exact hdeg₀_P₀
    let R_ℓ : AddSubgroup (weilCurveClGroup X) :=
      (zsmulAddGroupHom (ℓ : ℤ) : weilCurveClGroup X →+ weilCurveClGroup X).range
    let deg_mod : weilCurveClGroup X →+ ZMod ℓ := (Int.castAddHom (ZMod ℓ)).comp deg_Cl
    have hR_le : R_ℓ ≤ deg_mod.ker := by
      rintro _ ⟨y, rfl⟩
      rw [AddMonoidHom.mem_ker]
      change (((deg_Cl ((ℓ : ℤ) • y)) : ℤ) : ZMod ℓ) = 0
      rw [natCast_zsmul, map_nsmul, nsmul_eq_mul, Int.cast_mul, Int.cast_natCast,
        CharP.cast_eq_zero (ZMod ℓ) ℓ, zero_mul]
    let bar_deg : (weilCurveClGroup X ⧸ R_ℓ) →+ ZMod ℓ :=
      QuotientAddGroup.lift R_ℓ deg_mod hR_le
    have hsurj_bar : Function.Surjective bar_deg := by
      intro z
      let c₀ : weilCurveClGroup X :=
        QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (Finsupp.single P₀ 1)
      refine ⟨QuotientAddGroup.mk' R_ℓ (z.val • c₀), ?_⟩
      change (((deg_Cl (z.val • c₀)) : ℤ) : ZMod ℓ) = z
      rw [map_nsmul, hdeg_P₀, nsmul_one, Int.cast_natCast, ZMod.natCast_zmod_val]
    have hFin_Q : Finite (weilCurveClGroup X ⧸ R_ℓ) :=
      Nat.finite_of_card_ne_zero (by rw [hCardQ_C]; exact hPrime.ne_zero)
    have hbij_bar : Function.Bijective bar_deg := by
      let _ftQ : Fintype (weilCurveClGroup X ⧸ R_ℓ) :=
        Fintype.ofFinite (weilCurveClGroup X ⧸ R_ℓ)
      rw [@Fintype.bijective_iff_surjective_and_card
        (weilCurveClGroup X ⧸ R_ℓ) (ZMod ℓ) _ftQ inferInstance bar_deg]
      refine ⟨hsurj_bar, ?_⟩
      rw [← @Nat.card_eq_fintype_card (weilCurveClGroup X ⧸ R_ℓ) _ftQ,
        ← @Nat.card_eq_fintype_card (ZMod ℓ) inferInstance, hCardQ_C, Nat.card_zmod]
    have hbar_c : bar_deg (QuotientAddGroup.mk' R_ℓ c) = 0 := by
      change (((deg_Cl c) : ℤ) : ZMod ℓ) = 0
      rw [hc, Int.cast_zero]
    have hmk_c : QuotientAddGroup.mk' R_ℓ c = 0 :=
      hbij_bar.1 (hbar_c.trans (map_zero bar_deg).symm)
    have hc_mem : c ∈ R_ℓ := (QuotientAddGroup.eq_zero_iff c).mp hmk_c
    obtain ⟨y, hy⟩ := hc_mem
    change (ℓ : ℤ) • y = c at hy
    rw [natCast_zsmul] at hy
    refine ⟨y, ?_, hy⟩
    have hℓ_deg : ℓ • deg_Cl y = 0 := by
      rw [← map_nsmul, hy, hc]
    rw [nsmul_eq_mul] at hℓ_deg
    rcases mul_eq_zero.mp hℓ_deg with hℓ0 | hy0
    · exact absurd (Int.ofNat_eq_zero.mp hℓ0) hPrime.ne_zero
    · exact hy0

  
  have hℓ_one : ℓ • CategoryTheory.CategoryStruct.id oneR = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    ext W x
    let EV : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R) ⥤
        ModuleCat.{u, u} R :=
      CategoryTheory.sheafToPresheaf X.smallEtaleTopology (ModuleCat.{u, u} R) ⋙
        (CategoryTheory.evaluation (Opposite X.Etale) (ModuleCat.{u, u} R)).obj W
    change (EV.map (ℓ • CategoryTheory.CategoryStruct.id oneR)).hom x = 0
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have h_app : ∀ n : ℕ,
        (n • CategoryTheory.CategoryStruct.id (EV.obj oneR)).hom x = n • x := by
      intro n
      induction n with
      | zero => simp
      | succ n ih => rw [succ_nsmul, succ_nsmul, ModuleCat.hom_add, LinearMap.add_apply, ih]; rfl
    rw [h_app ℓ, ← Nat.cast_smul_eq_nsmul R ℓ x]
    have hℓ_R : (ℓ : R) = 0 := ULift.ext _ _ (CharP.cast_eq_zero (ZMod ℓ) ℓ)
    rw [hℓ_R, zero_smul]

  have hnsmul_mk₀_left :
      ∀ {Y : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)} {q : ℕ}
        (n : ℕ) (x : CategoryTheory.Abelian.Ext.{u} oneR Y q),
        (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id oneR)).comp
          x (Nat.zero_add q) = n • x := by
    intro Y q n x
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.zero_comp]
    | succ n ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.add_comp, ih,
        CategoryTheory.Abelian.Ext.mk₀_id_comp, succ_nsmul]

  have hnsmul_mk₀_right :
      ∀ {Y : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)} {q : ℕ}
        (n : ℕ) (y : CategoryTheory.Abelian.Ext.{u} Y oneR q),
        y.comp (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id oneR))
          (Nat.add_zero q) = n • y := by
    intro Y q n y
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih,
        CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]

  have hTors_left :
      ∀ (Y : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)) (q : ℕ)
        (x : CategoryTheory.Abelian.Ext.{u} oneR Y q), ℓ • x = 0 := by
    intro Y q x
    rw [← hnsmul_mk₀_left ℓ x, hℓ_one, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.zero_comp]

  have hTors_right :
      ∀ (Y : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R)) (q : ℕ)
        (y : CategoryTheory.Abelian.Ext.{u} Y oneR q), ℓ • y = 0 := by
    intro Y q y
    rw [← hnsmul_mk₀_right ℓ y, hℓ_one, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero]

  have hDualCardSep :
      ∀ (E : Type u) [AddCommGroup E] [Module (ZMod ℓ) E] [Finite E]
        (F : Type u) [AddCommGroup F] [Module (ZMod ℓ) F],
        Nat.card F = ℓ →
        Finite (E →ₗ[ZMod ℓ] F) ∧
        Nat.card (E →ₗ[ZMod ℓ] F) = Nat.card E ∧
        (∀ v : E, v ≠ 0 → ∃ φ : E →ₗ[ZMod ℓ] F, φ v ≠ 0) := by
    intro E _ _ _ F _ _ hCardF
    have _ : Finite F := Nat.finite_of_card_ne_zero (by rw [hCardF]; exact hPrime.ne_zero)
    have hex_F : ∃ w₀ : F, w₀ ≠ 0 := by
      by_contra h_all
      push Not at h_all
      let _ : Unique F := ⟨⟨0⟩, fun a => h_all a⟩
      have h1 : Nat.card F = 1 := Nat.card_unique
      have hge2 : 2 ≤ ℓ := hPrime.two_le
      omega
    obtain ⟨w₀, hw₀⟩ := hex_F
    let ι_F : ZMod ℓ →ₗ[ZMod ℓ] F := LinearMap.toSpanSingleton (ZMod ℓ) F w₀
    have hinj_F : Function.Injective ι_F := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro c hc
      rw [LinearMap.mem_ker] at hc
      change c • w₀ = 0 at hc
      by_contra hc0
      apply hw₀
      calc
        w₀ = (c⁻¹ * c) • w₀ := by rw [inv_mul_cancel₀ hc0, one_smul]
        _ = c⁻¹ • (c • w₀) := mul_smul c⁻¹ c w₀
        _ = 0 := by rw [hc, smul_zero]
    have hbij_F : Function.Bijective ι_F := by
      let _ftF : Fintype F := Fintype.ofFinite F
      rw [@Fintype.bijective_iff_injective_and_card (ZMod ℓ) F inferInstance _ftF ι_F]
      refine ⟨hinj_F, ?_⟩
      rw [← @Nat.card_eq_fintype_card (ZMod ℓ) inferInstance,
        ← @Nat.card_eq_fintype_card F _ftF, Nat.card_zmod, hCardF]
    let e_F : ZMod ℓ ≃ₗ[ZMod ℓ] F := LinearEquiv.ofBijective ι_F hbij_F
    let B := Module.Basis.ofVectorSpace (ZMod ℓ) E
    have _ : Finite ↥(Module.Basis.ofVectorSpaceIndex (ZMod ℓ) E) := Subtype.finite
    let e_dual : E ≃ₗ[ZMod ℓ] (E →ₗ[ZMod ℓ] ZMod ℓ) := B.toDualEquiv
    let e_EF : (E →ₗ[ZMod ℓ] ZMod ℓ) ≃+ (E →ₗ[ZMod ℓ] F) :=
      { toFun := fun φ => e_F.toLinearMap.comp φ
        invFun := fun ψ => e_F.symm.toLinearMap.comp ψ
        left_inv := fun φ => by ext x; simp
        right_inv := fun ψ => by ext x; simp
        map_add' := fun φ₁ φ₂ => by ext x; simp }
    let e_tot : E ≃+ (E →ₗ[ZMod ℓ] F) := e_dual.toAddEquiv.trans e_EF
    have hFin_hom : Finite (E →ₗ[ZMod ℓ] F) := Finite.of_equiv E e_tot.toEquiv
    have hCard_hom : Nat.card (E →ₗ[ZMod ℓ] F) = Nat.card E :=
      (Nat.card_congr e_tot.toEquiv).symm
    refine ⟨hFin_hom, hCard_hom, ?_⟩
    intro v hv
    have hv_rep : B.repr v ≠ 0 := fun h0 => hv (B.repr.injective (h0.trans (map_zero _).symm))
    have hv_fn : ⇑(B.repr v) ≠ 0 := fun hfn => hv_rep (Finsupp.ext (congrFun hfn))
    obtain ⟨i, hi⟩ := Function.ne_iff.mp hv_fn
    let π_i : E →ₗ[ZMod ℓ] ZMod ℓ := (Finsupp.lapply (R := ZMod ℓ) i).comp B.repr.toLinearMap
    refine ⟨e_F.toLinearMap.comp π_i, ?_⟩
    intro h0
    apply hi
    exact e_F.injective (h0.trans (map_zero _).symm)

  have hFinitePairingLeftNonDeg :
      ∀ (E₁ E₂ F : Type u) [AddCommGroup E₁] [AddCommGroup E₂] [AddCommGroup F]
        [Module (ZMod ℓ) E₁] [Module (ZMod ℓ) E₂] [Module (ZMod ℓ) F]
        [Finite E₁] [Finite E₂],
        Nat.card E₁ = Nat.card E₂ →
        Nat.card F = ℓ →
        ∀ (B : E₁ →+ E₂ →+ F),
          (∀ y : E₂, (∀ x : E₁, B x y = 0) → y = 0) →
          ∀ x : E₁, (∀ y : E₂, B x y = 0) → x = 0 := by
    intro E₁ E₂ F _ _ _ _ _ _ _ _ hCardEq hCardF B hRight
    obtain ⟨hFin_dual, hCard_dual, hSep⟩ := hDualCardSep E₁ F hCardF
    let B_flip : E₂ →ₗ[ZMod ℓ] (E₁ →ₗ[ZMod ℓ] F) :=
      AddMonoidHom.toZModLinearMap ℓ
        (AddMonoidHom.mk'
          (fun y => AddMonoidHom.toZModLinearMap ℓ
            (AddMonoidHom.mk' (fun x => B x y) (fun x₁ x₂ => by simp)))
          (fun y₁ y₂ => by
            ext x
            change B x (y₁ + y₂) = B x y₁ + B x y₂
            exact map_add (B x) y₁ y₂))
    have hinj_flip : Function.Injective B_flip := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro y hy
      rw [LinearMap.mem_ker] at hy
      apply hRight y
      intro x
      change (B_flip y) x = 0
      rw [hy]
      rfl
    have hbij_flip : Function.Bijective B_flip := by
      let _ft₂ : Fintype E₂ := Fintype.ofFinite E₂
      let _ftD : Fintype (E₁ →ₗ[ZMod ℓ] F) := Fintype.ofFinite (E₁ →ₗ[ZMod ℓ] F)
      rw [@Fintype.bijective_iff_injective_and_card E₂ (E₁ →ₗ[ZMod ℓ] F) _ft₂ _ftD B_flip]
      refine ⟨hinj_flip, ?_⟩
      rw [← @Nat.card_eq_fintype_card E₂ _ft₂,
        ← @Nat.card_eq_fintype_card (E₁ →ₗ[ZMod ℓ] F) _ftD, hCard_dual, hCardEq]
    intro x hx
    by_contra hx_ne
    obtain ⟨φ, hφ_ne⟩ := hSep x hx_ne
    obtain ⟨y, hy⟩ := hbij_flip.2 φ
    apply hφ_ne
    rw [← hy]
    exact hx y

  have hVecSpaceChase :
      ∀ (F M0 M2 K0 K2 : Type u)
        [AddCommGroup F] [AddCommGroup M0] [AddCommGroup M2]
        [AddCommGroup K0] [AddCommGroup K2]
        [Module (ZMod ℓ) F] [Module (ZMod ℓ) M0] [Module (ZMod ℓ) M2]
        [Module (ZMod ℓ) K0] [Module (ZMod ℓ) K2],
        Nat.card F = ℓ →
        Nat.card M0 = ℓ →
        Nat.card M2 = ℓ →
        ∀ (B_M : M0 →+ M2 →+ F) (B_K : K0 →+ K2 →+ F)
          (q_pull : K0 →+ M0), Function.Injective q_pull →
        ∀ (q_push : M2 →+ K2),
          (∀ (w₀ : K0) (x₂ : M2), B_M (q_pull w₀) x₂ = B_K w₀ (q_push x₂)) →
        ∀ (i_pull : M0 →+ K0) (i_push : K2 →+ M2),
          (∀ (u : M0) (x : K2), B_K (i_pull u) x = B_M u (i_push x)) →
          (∃ (c₀ : M0) (z_M : M2), B_M c₀ z_M ≠ 0) →
        ∀ (w : K0),
          (∀ x : K2, i_push x = 0 → B_K w x = 0) →
          ∃ u : M0, w = i_pull u := by
    intro F M0 M2 K0 K2 _ _ _ _ _ _ _ _ _ _ hCardF hCardM0 hCardM2
      B_M B_K q_pull hq_inj q_push hq_adj i_pull i_push hi_adj hNonZero w hw_ker
    have _ : Finite M0 := Nat.finite_of_card_ne_zero (by rw [hCardM0]; exact hPrime.ne_zero)
    have _ : Finite M2 := Nat.finite_of_card_ne_zero (by rw [hCardM2]; exact hPrime.ne_zero)
    obtain ⟨hFin_M2d, hCard_M2d, -⟩ := hDualCardSep M2 F hCardF
    let Φ_M : M0 →ₗ[ZMod ℓ] (M2 →ₗ[ZMod ℓ] F) :=
      AddMonoidHom.toZModLinearMap ℓ
        (AddMonoidHom.mk'
          (fun y₀ => AddMonoidHom.toZModLinearMap ℓ (B_M y₀))
          (fun y₁ y₂ => by
            ext x₂
            change B_M (y₁ + y₂) x₂ = B_M y₁ x₂ + B_M y₂ x₂
            simp))
    let Φ_K : K0 →ₗ[ZMod ℓ] (K2 →ₗ[ZMod ℓ] F) :=
      AddMonoidHom.toZModLinearMap ℓ
        (AddMonoidHom.mk'
          (fun y₀ => AddMonoidHom.toZModLinearMap ℓ (B_K y₀))
          (fun y₁ y₂ => by
            ext x₂
            change B_K (y₁ + y₂) x₂ = B_K y₁ x₂ + B_K y₂ x₂
            simp))
    obtain ⟨c₀, z_M, hcz_ne⟩ := hNonZero
    have hc₀_ne : c₀ ≠ 0 := by
      intro hc0
      rw [hc0, map_zero, AddMonoidHom.zero_apply] at hcz_ne
      exact hcz_ne rfl
    let ι_M0 : ZMod ℓ →ₗ[ZMod ℓ] M0 := LinearMap.toSpanSingleton (ZMod ℓ) M0 c₀
    have hinj_ιM0 : Function.Injective ι_M0 := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro a ha
      rw [LinearMap.mem_ker] at ha
      change a • c₀ = 0 at ha
      by_contra ha0
      apply hc₀_ne
      calc
        c₀ = (a⁻¹ * a) • c₀ := by rw [inv_mul_cancel₀ ha0, one_smul]
        _ = a⁻¹ • (a • c₀) := mul_smul a⁻¹ a c₀
        _ = 0 := by rw [ha, smul_zero]
    have hbij_ιM0 : Function.Bijective ι_M0 := by
      let _ftM0 : Fintype M0 := Fintype.ofFinite M0
      rw [@Fintype.bijective_iff_injective_and_card (ZMod ℓ) M0 inferInstance _ftM0 ι_M0]
      refine ⟨hinj_ιM0, ?_⟩
      rw [← @Nat.card_eq_fintype_card (ZMod ℓ) inferInstance,
        ← @Nat.card_eq_fintype_card M0 _ftM0, Nat.card_zmod, hCardM0]
    have hinj_ΦM : Function.Injective Φ_M := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro y₀ hy₀
      rw [LinearMap.mem_ker] at hy₀
      obtain ⟨a, rfl⟩ := hbij_ιM0.2 y₀
      change Φ_M (a • c₀) = 0 at hy₀
      rw [map_smul] at hy₀
      have hz_eval : (a • Φ_M c₀) z_M = 0 := by rw [hy₀]; rfl
      change a • B_M c₀ z_M = 0 at hz_eval
      have ha0 : a = 0 := by
        by_contra ha_ne
        apply hcz_ne
        calc
          B_M c₀ z_M = (a⁻¹ * a) • B_M c₀ z_M := by rw [inv_mul_cancel₀ ha_ne, one_smul]
          _ = a⁻¹ • (a • B_M c₀ z_M) := mul_smul a⁻¹ a _
          _ = 0 := by rw [hz_eval, smul_zero]
      rw [ha0, map_zero]
    have hbij_ΦM : Function.Bijective Φ_M := by
      let _ftM0 : Fintype M0 := Fintype.ofFinite M0
      let _ftD : Fintype (M2 →ₗ[ZMod ℓ] F) := Fintype.ofFinite (M2 →ₗ[ZMod ℓ] F)
      rw [@Fintype.bijective_iff_injective_and_card M0 (M2 →ₗ[ZMod ℓ] F) _ftM0 _ftD Φ_M]
      refine ⟨hinj_ΦM, ?_⟩
      rw [← @Nat.card_eq_fintype_card M0 _ftM0,
        ← @Nat.card_eq_fintype_card (M2 →ₗ[ZMod ℓ] F) _ftD, hCard_M2d, hCardM0, hCardM2]
    have hinj_ΦK : Function.Injective Φ_K := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro w₀ hw₀
      rw [LinearMap.mem_ker] at hw₀
      apply hq_inj
      rw [map_zero]
      apply hinj_ΦM
      rw [map_zero]
      ext x₂
      change B_M (q_pull w₀) x₂ = 0
      rw [hq_adj w₀ x₂]
      change (Φ_K w₀) (q_push x₂) = 0
      rw [hw₀]
      rfl
    let ι_K2 : K2 →ₗ[ZMod ℓ] M2 := AddMonoidHom.toZModLinearMap ℓ i_push
    have hker_le : LinearMap.ker ι_K2 ≤ LinearMap.ker (Φ_K w) := by
      intro x hx
      rw [LinearMap.mem_ker] at hx ⊢
      exact hw_ker x hx
    let q_bar : (K2 ⧸ LinearMap.ker ι_K2) →ₗ[ZMod ℓ] F :=
      Submodule.liftQ (LinearMap.ker ι_K2) (Φ_K w) hker_le
    let e_qr : (K2 ⧸ LinearMap.ker ι_K2) ≃ₗ[ZMod ℓ] ↥(LinearMap.range ι_K2) :=
      LinearMap.quotKerEquivRange ι_K2
    obtain ⟨lam, hlam⟩ := LinearMap.exists_extend (q_bar.comp e_qr.symm.toLinearMap)
    obtain ⟨u, hu⟩ := hbij_ΦM.2 lam
    refine ⟨u, ?_⟩
    apply hinj_ΦK
    ext x
    have hlam_x : lam (ι_K2 x) = (Φ_K w) x := by
      let y_r : ↥(LinearMap.range ι_K2) := LinearMap.rangeRestrict ι_K2 x
      have hy_eq : e_qr (Submodule.Quotient.mk x) = y_r := rfl
      have hsymm_y : e_qr.symm y_r = Submodule.Quotient.mk x := by
        rw [← hy_eq, LinearEquiv.symm_apply_apply]
      calc
        lam (ι_K2 x) = (lam.comp (LinearMap.range ι_K2).subtype) y_r := rfl
        _ = (q_bar.comp e_qr.symm.toLinearMap) y_r := by rw [hlam]
        _ = q_bar (Submodule.Quotient.mk x) := by simp [hsymm_y]
        _ = (Φ_K w) x := rfl
    change B_K w x = B_K (i_pull u) x
    rw [hi_adj u x]
    change (Φ_K w) x = (Φ_M u) (ι_K2 x)
    rw [hu, hlam_x]

  have hUnipExtInj :
      ∀ (L M : CategoryTheory.Sheaf X.smallEtaleTopology (ModuleCat.{u, u} R))
        (τ : Quiver.Hom M M) (π : Quiver.Hom M L) [CategoryTheory.Epi π]
        (h0_tp : CategoryTheory.CategoryStruct.comp τ π = 0),
        (CategoryTheory.ShortComplex.mk τ π h0_tp).Exact →
        Nat.card (CategoryTheory.Abelian.Ext.{u} M oneR 0) = ℓ →
        Nat.card (CategoryTheory.Abelian.Ext.{u} oneR M 2) = ℓ →
        (∃ (c₀ : CategoryTheory.Abelian.Ext.{u} M oneR 0)
           (z_M : CategoryTheory.Abelian.Ext.{u} oneR M 2),
          z_M.comp c₀ (Nat.add_zero 2) ≠ 0) →
        ∀ (η : CategoryTheory.Abelian.Ext.{u} L oneR 1),
          (CategoryTheory.Abelian.Ext.mk₀ π).comp η (Nat.zero_add 1) = 0 →
          (∀ α : CategoryTheory.Abelian.Ext.{u} oneR L 1,
            CategoryTheory.Abelian.Ext.comp α η (rfl : 1 + 1 = 2) = 0) →
          η = 0 := by
    intro L M τ π _ h0_tp hEx_tp hCard0_M hCard2_M hNonZero_M η hπ_η hOrth_η
    let K_ker := CategoryTheory.Limits.kernel π
    let i_K : K_ker ⟶ M := CategoryTheory.Limits.kernel.ι π
    let S_SES := CategoryTheory.ShortComplex.mk i_K π (CategoryTheory.Limits.kernel.condition π)
    have hEx_SES : S_SES.Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel S_SES
        (CategoryTheory.Limits.kernelIsKernel π)
    have hSES : S_SES.ShortExact := { exact := hEx_SES }
    let q_K : M ⟶ K_ker := CategoryTheory.Limits.kernel.lift π τ h0_tp
    have _ : CategoryTheory.Epi q_K :=
      (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift
        (CategoryTheory.ShortComplex.mk τ π h0_tp)).mp hEx_tp
    let B_M : CategoryTheory.Abelian.Ext.{u} M oneR 0 →+
        CategoryTheory.Abelian.Ext.{u} oneR M 2 →+
        CategoryTheory.Abelian.Ext.{u} oneR oneR 2 :=
      AddMonoidHom.mk'
        (fun y₀ => AddMonoidHom.mk'
          (fun x₂ => x₂.comp y₀ (Nat.add_zero 2))
          (fun a₁ a₂ => CategoryTheory.Abelian.Ext.add_comp a₁ a₂ y₀ (Nat.add_zero 2)))
        (fun y₁ y₂ => by
          ext x₂
          exact CategoryTheory.Abelian.Ext.comp_add x₂ y₁ y₂ (Nat.add_zero 2))
    let B_K : CategoryTheory.Abelian.Ext.{u} K_ker oneR 0 →+
        CategoryTheory.Abelian.Ext.{u} oneR K_ker 2 →+
        CategoryTheory.Abelian.Ext.{u} oneR oneR 2 :=
      AddMonoidHom.mk'
        (fun y₀ => AddMonoidHom.mk'
          (fun x₂ => x₂.comp y₀ (Nat.add_zero 2))
          (fun a₁ a₂ => CategoryTheory.Abelian.Ext.add_comp a₁ a₂ y₀ (Nat.add_zero 2)))
        (fun y₁ y₂ => by
          ext x₂
          exact CategoryTheory.Abelian.Ext.comp_add x₂ y₁ y₂ (Nat.add_zero 2))
    let q_pull : CategoryTheory.Abelian.Ext.{u} K_ker oneR 0 →+
        CategoryTheory.Abelian.Ext.{u} M oneR 0 :=
      AddMonoidHom.mk'
        (fun w₀ => (CategoryTheory.Abelian.Ext.mk₀ q_K).comp w₀ (Nat.zero_add 0))
        (fun w₁ w₂ =>
          CategoryTheory.Abelian.Ext.comp_add (CategoryTheory.Abelian.Ext.mk₀ q_K) w₁ w₂
            (Nat.zero_add 0))
    have hq_inj : Function.Injective q_pull := by
      rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro w₀ hw₀
      rw [AddMonoidHom.mem_ker] at hw₀
      change (CategoryTheory.Abelian.Ext.mk₀ q_K).comp w₀ (Nat.zero_add 0) = 0 at hw₀
      obtain ⟨f_w, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective K_ker oneR).2 w₀
      rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.mk₀_zero M oneR] at hw₀
      have hqf0 : q_K ≫ f_w = 0 := (CategoryTheory.Abelian.Ext.mk₀_bijective M oneR).1 hw₀
      have hf0 : f_w = 0 :=
        (CategoryTheory.cancel_epi q_K).mp (hqf0.trans CategoryTheory.Limits.comp_zero.symm)
      rw [hf0, CategoryTheory.Abelian.Ext.mk₀_zero]
      rfl
    let q_push : CategoryTheory.Abelian.Ext.{u} oneR M 2 →+
        CategoryTheory.Abelian.Ext.{u} oneR K_ker 2 :=
      AddMonoidHom.mk'
        (fun x₂ => x₂.comp (CategoryTheory.Abelian.Ext.mk₀ q_K) (Nat.add_zero 2))
        (fun a₁ a₂ =>
          CategoryTheory.Abelian.Ext.add_comp a₁ a₂ (CategoryTheory.Abelian.Ext.mk₀ q_K)
            (Nat.add_zero 2))
    let i_pull : CategoryTheory.Abelian.Ext.{u} M oneR 0 →+
        CategoryTheory.Abelian.Ext.{u} K_ker oneR 0 :=
      AddMonoidHom.mk'
        (fun u => (CategoryTheory.Abelian.Ext.mk₀ i_K).comp u (Nat.zero_add 0))
        (fun u₁ u₂ =>
          CategoryTheory.Abelian.Ext.comp_add (CategoryTheory.Abelian.Ext.mk₀ i_K) u₁ u₂
            (Nat.zero_add 0))
    let i_push : CategoryTheory.Abelian.Ext.{u} oneR K_ker 2 →+
        CategoryTheory.Abelian.Ext.{u} oneR M 2 :=
      AddMonoidHom.mk'
        (fun x => x.comp (CategoryTheory.Abelian.Ext.mk₀ i_K) (Nat.add_zero 2))
        (fun a₁ a₂ =>
          CategoryTheory.Abelian.Ext.add_comp a₁ a₂ (CategoryTheory.Abelian.Ext.mk₀ i_K)
            (Nat.add_zero 2))
    obtain ⟨w, hw⟩ :=
      CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSES oneR η hπ_η (Nat.add_zero 1)
    have hw_ker : ∀ x : CategoryTheory.Abelian.Ext.{u} oneR K_ker 2,
        i_push x = 0 → B_K w x = 0 := by
      intro x hx
      change x.comp (CategoryTheory.Abelian.Ext.mk₀ S_SES.f) (Nat.add_zero 2) = 0 at hx
      obtain ⟨α, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hSES x hx (rfl : 1 + 1 = 2)
      change (α.comp hSES.extClass (rfl : 1 + 1 = 2)).comp w (Nat.add_zero 2) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc α hSES.extClass w
        (rfl : 1 + 1 = 2) (Nat.add_zero 1) (by omega), hw]
      exact hOrth_η α
    obtain ⟨u, hw_eq⟩ :=
      @hVecSpaceChase
        (CategoryTheory.Abelian.Ext.{u} oneR oneR 2)
        (CategoryTheory.Abelian.Ext.{u} M oneR 0)
        (CategoryTheory.Abelian.Ext.{u} oneR M 2)
        (CategoryTheory.Abelian.Ext.{u} K_ker oneR 0)
        (CategoryTheory.Abelian.Ext.{u} oneR K_ker 2)
        inferInstance inferInstance inferInstance inferInstance inferInstance
        (AddCommGroup.zmodModule (hTors_left oneR 2))
        (AddCommGroup.zmodModule (hTors_right M 0))
        (AddCommGroup.zmodModule (hTors_left M 2))
        (AddCommGroup.zmodModule (hTors_right K_ker 0))
        (AddCommGroup.zmodModule (hTors_left K_ker 2))
        hCard2_X hCard0_M hCard2_M
        B_M B_K q_pull hq_inj q_push
        (fun w₀ x₂ =>
          (CategoryTheory.Abelian.Ext.comp_assoc x₂ (CategoryTheory.Abelian.Ext.mk₀ q_K) w₀
            (Nat.add_zero 2) (Nat.zero_add 0) (by omega)).symm)
        i_pull i_push
        (fun u₀ x =>
          (CategoryTheory.Abelian.Ext.comp_assoc x (CategoryTheory.Abelian.Ext.mk₀ i_K) u₀
            (Nat.add_zero 2) (Nat.zero_add 0) (by omega)).symm)
        hNonZero_M w hw_ker
    rw [← hw, hw_eq]
    change hSES.extClass.comp
      ((CategoryTheory.Abelian.Ext.mk₀ S_SES.f).comp u (Nat.zero_add 0)) (Nat.add_zero 1) = 0
    rw [← CategoryTheory.Abelian.Ext.comp_assoc hSES.extClass
      (CategoryTheory.Abelian.Ext.mk₀ S_SES.f) u
      (Nat.add_zero 1) (Nat.zero_add 0) (by omega),
      hSES.extClass_comp, CategoryTheory.Abelian.Ext.zero_comp]

  
