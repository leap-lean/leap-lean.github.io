        (mul_ne_zero ha₁ ha₂) (mul_ne_zero hb₁ hb₂)
        (by rw [map_mul, map_mul, Units.val_mul, heq₁, heq₂]; ring)
        (by rw [pow_add, ← hsa₁, ← hsa₂, Ideal.span_singleton_mul_span_singleton])
        (by rw [pow_add, ← hsb₁, ← hsb₂, Ideal.span_singleton_mul_span_singleton])
