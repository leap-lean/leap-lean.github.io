      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (M_p.obj W) S_R).mpr ?_
      intro y
      have hR_pre : R ∈ (V'_sch.smallEtalePretopology).toGrothendieck W := by rwa [← hJY_eq]
      obtain ⟨V, f_V, z, hf_V, hz_eq⟩ :=
        (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R).mp hR_pre y
      exact ⟨M_p.obj V, M_p.map f_V, z,
        CategoryTheory.Sieve.image_mem_functorPushforward M_p R hf_V, hz_eq⟩
    let Z_lift : ∀ {Z : V₀.Etale} (u : Z ⟶ M_p.obj W), V'_sch.Etale :=
      fun {Z} u =>
        let u_l : Z.left ⟶ W.left := u.left
        have : AlgebraicGeometry.Etale u_l := hEt_of_hom u
        have : AlgebraicGeometry.Etale W.hom := W.prop
        CategoryTheory.MorphismProperty.Over.mk ⊤ (u_l ≫ W.hom) inferInstance
    let u_lift : ∀ {Z : V₀.Etale} (u : Z ⟶ M_p.obj W), Z_lift u ⟶ W :=
      fun u => CategoryTheory.MorphismProperty.Over.homMk u.left rfl trivial
    let e_lift : ∀ {Z : V₀.Etale} (u : Z ⟶ M_p.obj W), M_p.obj (Z_lift u) ≅ Z :=
      fun {Z} u =>
        CategoryTheory.MorphismProperty.Over.isoMk (CategoryTheory.Iso.refl Z.left)
          ((CategoryTheory.Category.id_comp Z.hom).trans
            ((CategoryTheory.MorphismProperty.Over.w u).symm.trans
              (CategoryTheory.Category.assoc (u.left : Z.left ⟶ W.left) W.hom p).symm))
    have hu_lift_mem :
        ∀ {Z : V₀.Etale} (u : Z ⟶ M_p.obj W), S_R.arrows u → R.arrows (u_lift u) := by
      intro Z u ⟨V, f_V, h_V, hf_V, hu_eq⟩
      have hu_left : (u.left : Z.left ⟶ W.left) = h_V.left ≫ f_V.left :=
        congrArg (fun m : Z ⟶ M_p.obj W => (m.left : Z.left ⟶ W.left)) hu_eq
      let h_tilde : Z_lift u ⟶ V :=
        CategoryTheory.MorphismProperty.Over.homMk h_V.left
          ((congrArg ((h_V.left : Z.left ⟶ V.left) ≫ ·)
            (CategoryTheory.MorphismProperty.Over.w f_V).symm).trans
            ((CategoryTheory.Category.assoc (h_V.left : Z.left ⟶ V.left)
              (f_V.left : V.left ⟶ W.left) W.hom).symm.trans
              (congrArg (· ≫ W.hom) hu_left.symm)))
          trivial
      have hfac : u_lift u = h_tilde ≫ f_V :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hu_left
      rw [hfac]
      exact R.downward_closed hf_V h_tilde
    let y_fam : CategoryTheory.Presieve.FamilyOfElements
        (G.obj ⋙ CategoryTheory.forget (Type (u + 1))) (S_R : CategoryTheory.Presieve _) :=
      fun Z u hu => G.obj.map (e_lift u).inv.op (x_fam (u_lift u) (hu_lift_mem u hu))
    have hy_compat : y_fam.Compatible := by
      intro Y₁ Y₂ Z₀ g₁ g₂ u₁ u₂ hu₁ hu₂ hcomm
      have hhcomm_left : (g₁.left : Z₀.left ⟶ Y₁.left) ≫ u₁.left = g₂.left ≫ u₂.left :=
        congrArg (fun m : Z₀ ⟶ M_p.obj W => (m.left : Z₀.left ⟶ W.left)) hcomm
      let u₀ : Z₀ ⟶ M_p.obj W := g₁ ≫ u₁
      let g_tilde₁ : Z_lift u₀ ⟶ Z_lift u₁ :=
        CategoryTheory.MorphismProperty.Over.homMk g₁.left
