                (((π ≫ α).hom.app (Opposite.op (W_u u))).hom (s_u u)) := by
          intro α
          have hmap : F.obj.map (h ≫ j_u u).op = F.obj.map (j_u u).op ≫ F.obj.map h.op := by
            rw [op_comp, F.obj.map_comp]
          have hnat := (congrArg (fun φ => φ.hom d) (α.hom.naturality (j_u u).op)).symm
          change (F.obj.map (j_u u).op).hom ((α.hom.app (Opposite.op U)).hom d) =
            (α.hom.app (Opposite.op (W_u u))).hom ((D.obj.map (j_u u).op).hom d) at hnat
          calc
            (F.obj.map (h ≫ j_u u).op).hom ((α.hom.app (Opposite.op U)).hom d)
                = (F.obj.map h.op).hom
                    ((F.obj.map (j_u u).op).hom ((α.hom.app (Opposite.op U)).hom d)) := by
                  rw [hmap]; rfl
            _ = (F.obj.map h.op).hom
                  ((α.hom.app (Opposite.op (W_u u))).hom
                    ((D.obj.map (j_u u).op).hom d)) := by
                  rw [hnat]
            _ = (F.obj.map h.op).hom
                  ((α.hom.app (Opposite.op (W_u u))).hom
                    ((π.hom.app (Opposite.op (W_u u))).hom (s_u u))) := by
                  rw [← hs_u u]
            _ = (F.obj.map h.op).hom
                  (((π ≫ α).hom.app (Opposite.op (W_u u))).hom (s_u u)) := rfl
        rw [hStep α₁, hStep α₂, hα]
      exact ⟨h0, CategoryTheory.ShortComplex.ShortExact.mk' hExact hMono hEpi⟩
    let u_G : weilEtaleGmPresheaf X ≅ (weilEtaleGmSheaf X).obj :=
      CategoryTheory.isoSheafify J_X hG
    let u_K : weilEtaleKPresheaf X ≅ (weilEtaleKSheaf X).obj :=
      CategoryTheory.isoSheafify J_X hK
    have hu_G : shAdj.unit.app (weilEtaleGmPresheaf X) = u_G.hom :=
      (CategoryTheory.sheafificationAdjunction_unit_app J_X (weilEtaleGmPresheaf X)).trans
        (CategoryTheory.isoSheafify_hom J_X hG).symm
    have hu_K : shAdj.unit.app (weilEtaleKPresheaf X) = u_K.hom :=
      (CategoryTheory.sheafificationAdjunction_unit_app J_X (weilEtaleKPresheaf X)).trans
        (CategoryTheory.isoSheafify_hom J_X hK).symm
    have hu_G_app : ∀ (U : X.Etale) (z : ↥((weilEtaleGmPresheaf X).obj (Opposite.op U))),
        ((u_G.hom.app (Opposite.op U)).hom z :
          ↥((weilEtaleGmSheaf X).obj.obj (Opposite.op U))) =
        ((shAdj.unit.app (weilEtaleGmPresheaf X)).app (Opposite.op U)).hom z :=
      fun U z => congrArg (fun τ : weilEtaleGmPresheaf X ⟶ (weilEtaleGmSheaf X).obj =>
        (τ.app (Opposite.op U)).hom z) hu_G.symm
    have hu_K_app : ∀ (U : X.Etale) (z : ↥((weilEtaleKPresheaf X).obj (Opposite.op U))),
        (((shAdj.unit.app (weilEtaleKPresheaf X)).app (Opposite.op U)).hom z :
          ↥((weilEtaleKSheaf X).obj.obj (Opposite.op U))) =
        (u_K.hom.app (Opposite.op U)).hom z :=
      fun U z => congrArg (fun τ : weilEtaleKPresheaf X ⟶ (weilEtaleKSheaf X).obj =>
        (τ.app (Opposite.op U)).hom z) hu_K
    let G_sh : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := ⟨weilEtaleGmPresheaf X, hG⟩
    let K_sh : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} := ⟨weilEtaleKPresheaf X, hK⟩
    let e_G : G_sh ≅ weilEtaleGmSheaf X :=
      { hom := { hom := u_G.hom }
        inv := { hom := u_G.inv }
        hom_inv_id := by apply CategoryTheory.Sheaf.hom_ext; exact u_G.hom_inv_id
        inv_hom_id := by apply CategoryTheory.Sheaf.hom_ext; exact u_G.inv_hom_id }
    let e_K : K_sh ≅ weilEtaleKSheaf X :=
      { hom := { hom := u_K.hom }
        inv := { hom := u_K.inv }
        hom_inv_id := by apply CategoryTheory.Sheaf.hom_ext; exact u_K.hom_inv_id
        inv_hom_id := by apply CategoryTheory.Sheaf.hom_ext; exact u_K.inv_hom_id }
    let ι_sh : G_sh ⟶ K_sh := e_G.hom ≫ ι_gm ≫ e_K.inv
    let div_sh : K_sh ⟶ Div_sh := { hom := div_pre }
    have hι_sh_eval : ∀ (U : X.Etale) (x : ↥(G_sh.obj.obj (Opposite.op U))),
        (ι_sh.hom.app (Opposite.op U)).hom x =
          Additive.ofMul
            (Units.map (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom.toMonoidHom
              (Additive.toMul x)) :=
      fun U x =>
        let u : Units ↑(U.left.presheaf.obj (Opposite.op ⊤)) := Additive.toMul x
        let y : ↥((weilEtaleKPresheaf X).obj (Opposite.op U)) :=
          Additive.ofMul
            (Units.map (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom.toMonoidHom u)
        have h1 : (u_G.hom.app (Opposite.op U)).hom x =
            ((shAdj.unit.app (weilEtaleGmPresheaf X)).app (Opposite.op U)).hom
              (Additive.ofMul u) :=
          hu_G_app U (Additive.ofMul u)
        have h2 : (ι_gm.hom.app (Opposite.op U)).hom ((u_G.hom.app (Opposite.op U)).hom x) =
            (u_K.hom.app (Opposite.op U)).hom y :=
          (congrArg (ι_gm.hom.app (Opposite.op U)).hom h1).trans
            ((hPin_gm U u).trans (hu_K_app U y))
        (congrArg (u_K.inv.app (Opposite.op U)).hom h2).trans
          (congrArg (fun φ => φ.hom y) (u_K.hom_inv_id_app (Opposite.op U)))
    have hSecEx : ∀ U : X.Etale,
        Function.Injective (ι_sh.hom.app (Opposite.op U)).hom ∧
        (∀ x : ↥(G_sh.obj.obj (Opposite.op U)),
          (div_sh.hom.app (Opposite.op U)).hom ((ι_sh.hom.app (Opposite.op U)).hom x) = 0) ∧
        (∀ s : ↥(K_sh.obj.obj (Opposite.op U)),
          (div_sh.hom.app (Opposite.op U)).hom s = 0 →
          ∃ x : ↥(G_sh.obj.obj (Opposite.op U)),
            (ι_sh.hom.app (Opposite.op U)).hom x = s) := by
      intro U
      refine ⟨?_, ?_, ?_⟩
      · intro x₁ x₂ hx
        rw [hι_sh_eval U x₁, hι_sh_eval U x₂] at hx
        have hmul : Additive.toMul x₁ = Additive.toMul x₂ :=
          (hObjEx U).1 (congrArg Additive.toMul hx)
        exact congrArg Additive.ofMul hmul
      · intro x
        rw [hι_sh_eval U x]
        exact (hObjEx U).2.1 (Additive.toMul x)
      · intro s hs
        obtain ⟨u, hu⟩ := (hObjEx U).2.2 s hs
        refine ⟨Additive.ofMul u, ?_⟩
        rw [hι_sh_eval U (Additive.ofMul u)]
        exact hu
    obtain ⟨h0_sh, hSE_sh⟩ := hShortExactCriterion G_sh K_sh Div_sh ι_sh div_sh hSecEx hLocSurj
    let div_mor : weilEtaleKSheaf X ⟶ Div_sh := e_K.inv ≫ div_sh
    have h_sq1 : e_G.hom ≫ ι_gm = ι_sh ≫ e_K.hom := by
      dsimp only [ι_sh]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        e_K.inv_hom_id, CategoryTheory.Category.comp_id]
    have h_sq2 : e_K.hom ≫ div_mor = div_sh ≫ (CategoryTheory.Iso.refl Div_sh).hom := by
      dsimp only [div_mor]
      rw [e_K.hom_inv_id_assoc, CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
    have h0_div : ι_gm ≫ div_mor = 0 := by
      apply (CategoryTheory.cancel_epi e_G.hom).mp
      calc
        e_G.hom ≫ (ι_gm ≫ div_mor)
            = (e_G.hom ≫ ι_gm) ≫ div_mor := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (ι_sh ≫ e_K.hom) ≫ (e_K.inv ≫ div_sh) := by rw [h_sq1]
        _ = ι_sh ≫ (e_K.hom ≫ (e_K.inv ≫ div_sh)) := CategoryTheory.Category.assoc _ _ _
        _ = ι_sh ≫ div_sh := by rw [e_K.hom_inv_id_assoc]
        _ = 0 := h0_sh
        _ = e_G.hom ≫ 0 := (CategoryTheory.Limits.comp_zero).symm
    let e_SC : CategoryTheory.ShortComplex.mk ι_sh div_sh h0_sh ≅
        CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div :=
      CategoryTheory.ShortComplex.isoMk e_G e_K (CategoryTheory.Iso.refl Div_sh) h_sq1 h_sq2
    have hSE_div : (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact :=
      (CategoryTheory.ShortComplex.shortExact_iff_of_iso e_SC).mp hSE_sh
    let Fℤ := (CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}).obj Aℤ
    let e_adj : ∀ F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        (Fℤ ⟶ F) ≃+ (Aℤ ⟶ F.obj.obj (Opposite.op T_X)) := fun F =>
      { adj_X.homEquiv Aℤ F with
        map_add' := fun f₁ f₂ => by
          change adj_X.homEquiv Aℤ F (f₁ + f₂) =
            adj_X.homEquiv Aℤ F f₁ + adj_X.homEquiv Aℤ F f₂
          rw [CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Adjunction.homEquiv_unit,
            CategoryTheory.Adjunction.homEquiv_unit]
          have hadd_app : ((CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj
              (Opposite.op T_X)).map (f₁ + f₂) =
              ((CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj
                (Opposite.op T_X)).map f₁ +
              ((CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj
                (Opposite.op T_X)).map f₂ :=
            (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u} ⋙
              (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj
                (Opposite.op T_X)).map_add
          rw [hadd_app, CategoryTheory.Preadditive.comp_add] }
    let e_Z : ∀ M : AddCommGrpCat.{u}, (Aℤ ⟶ M) ≃+ ↥M := fun M =>
      { toFun := fun g => g.hom (ULift.up (1 : ℤ))
        invFun := fun m => AddCommGrpCat.ofHom
          { toFun := fun n => n.down • m
            map_zero' := zero_zsmul m
            map_add' := fun a b => add_zsmul m a.down b.down }
        left_inv := fun g => by
          apply AddCommGrpCat.ext
          rintro ⟨n⟩
          have hn : (ULift.up n : ULift.{u} ℤ) = n • (ULift.up (1 : ℤ) : ULift.{u} ℤ) :=
            ULift.ext _ _ (by simp)
          change n • g.hom (ULift.up (1 : ℤ)) = g.hom (ULift.up n)
          rw [hn, map_zsmul]
        right_inv := fun m => one_zsmul m
        map_add' := fun _ _ => rfl }
    let ev₀ : ∀ F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u},
        F.H 0 ≃+ ↥(F.obj.obj (Opposite.op T_X)) := fun F =>
      CategoryTheory.Abelian.Ext.addEquiv₀.trans
        ((e_adj F).trans (e_Z (F.obj.obj (Opposite.op T_X))))
    have hev_nat : ∀ {F₁ F₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
        (φ : F₁ ⟶ F₂) (κ : F₁.H 0),
        ev₀ F₂ (κ.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) =
          (φ.hom.app (Opposite.op T_X)).hom (ev₀ F₁ κ) := by
      intro F₁ F₂ φ κ
      let g : Fℤ ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ κ
      have hg : CategoryTheory.Abelian.Ext.mk₀ g = κ :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply κ
      have hcomp : CategoryTheory.Abelian.Ext.addEquiv₀
          (κ.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)) = g ≫ φ := by
        rw [← hg, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply (g ≫ φ)
      change (adj_X.homEquiv Aℤ F₂
          (CategoryTheory.Abelian.Ext.addEquiv₀
            (κ.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero 0)))).hom
          (ULift.up (1 : ℤ)) =
        (φ.hom.app (Opposite.op T_X)).hom
          ((adj_X.homEquiv Aℤ F₁ g).hom (ULift.up (1 : ℤ)))
      rw [hcomp, CategoryTheory.Adjunction.homEquiv_naturality_right]
      rfl
    refine ⟨div_mor, h0_div, ev₀ Div_sh, hSE_div, fun f => ?_⟩
    rw [hev_nat div_mor (k_hom (Additive.ofMul f))]
    let s_f : ↥((weilEtaleKPresheaf X).obj (Opposite.op T_X)) :=
      Additive.ofMul
        (Units.map
          ((AlgebraicGeometry.Scheme.ΓSpecIso
              (X.presheaf.stalk (genericPoint ↥X))).inv ≫
            (CategoryTheory.Limits.pullback.snd T_X.hom η_X).appTop).hom.toMonoidHom f)
    have hev_k : ev₀ (weilEtaleKSheaf X) (k_hom (Additive.ofMul f)) =
        (u_K.hom.app (Opposite.op T_X)).hom s_f :=
      (hPin_k f).trans (hu_K_app T_X s_f)
    rw [hev_k]
    change (div_pre.app (Opposite.op T_X)).hom
        ((u_K.inv.app (Opposite.op T_X)).hom ((u_K.hom.app (Opposite.op T_X)).hom s_f)) =
      (div_pre.app (Opposite.op T_X)).hom s_f
    exact congrArg (div_pre.app (Opposite.op T_X)).hom
      (congrArg (fun φ => φ.hom s_f) (u_K.hom_inv_id_app (Opposite.op T_X)))

theorem weil_affine_chart_generic_pullback_fraction_and_unit_gluing (X Y : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (f : Y ⟶ X) :
    letI : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    let η_X := X.fromSpecStalk (genericPoint ↥X)
    (∀ (W₀ : X.Opens) (_ : AlgebraicGeometry.IsAffineOpen W₀)
       (V₀ : Y.Opens) (_ : AlgebraicGeometry.IsAffineOpen V₀)
       (e : V₀ ≤ (TopologicalSpace.Opens.map f.base).obj W₀),
      let D := ↑(Y.presheaf.obj (Opposite.op V₀))
      let Z_η := CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.comp V₀.ι f) η_X
      let E := ↑(Z_η.presheaf.obj (Opposite.op ⊤))
      let α : D →+* E :=
        (CategoryTheory.CategoryStruct.comp V₀.topIso.inv
          (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.CategoryStruct.comp V₀.ι f) η_X).appTop).hom
      IsDomain D →
      Function.Injective (f.appLE W₀ V₀ e).hom →
      (∀ q : Ideal D, q.IsPrime → Ideal.comap (f.appLE W₀ V₀ e).hom q = ⊥ → q = ⊥) →
      (IsDomain E ∧ IsField E ∧ Function.Injective α ∧
        (∀ d : D, d ≠ 0 → IsUnit (α d)) ∧
        (∀ z : E, ∃ c d : D, d ≠ 0 ∧ z * α d = α c)) ∧
      (∀ u : Units E,
        (∀ m : Ideal D, m.IsMaximal → m ≠ ⊥ →
          (∃ a₁ b₁ : D, b₁ ∉ m ∧ (u : E) * α b₁ = α a₁) ∧
          (∃ a₂ b₂ : D, b₂ ∉ m ∧ ((u⁻¹ : Units E) : E) * α b₂ = α a₂)) →
        u ∈ Set.range (Units.map α.toMonoidHom)) ∧
      (∀ (y : ↥Y) (W : Y.Opens),
        y ∈ V₀ → y ∈ W →
        ∃ V' : Y.Opens, y ∈ V' ∧ V' ≤ W ∧
          Function.Injective
            (CategoryTheory.CategoryStruct.comp V'.topIso.inv
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.CategoryStruct.comp V'.ι f) η_X).appTop).hom)) ∧
    (∀ {ι : Type u} (V : ι → Y.Opens),
      (∀ y : ↥Y, ∃ i : ι, y ∈ V i) →
      (∀ (y : ↥Y) (W : Y.Opens), y ∈ W →
        ∃ V' : Y.Opens, y ∈ V' ∧ V' ≤ W ∧
          Function.Injective
            (CategoryTheory.CategoryStruct.comp V'.topIso.inv
              (CategoryTheory.Limits.pullback.fst
                (CategoryTheory.CategoryStruct.comp V'.ι f) η_X).appTop).hom) →
      Function.Injective
        (Units.map (CategoryTheory.Limits.pullback.fst f η_X).appTop.hom.toMonoidHom) ∧
      ∀ s : Units ↑((CategoryTheory.Limits.pullback f η_X).presheaf.obj (Opposite.op ⊤)),
        (∀ i : ι, ∃ u_i : Units ↑(Y.presheaf.obj (Opposite.op (V i))),
          Units.map
              (CategoryTheory.CategoryStruct.comp (V i).topIso.inv
                (CategoryTheory.Limits.pullback.fst
                  (CategoryTheory.CategoryStruct.comp (V i).ι f) η_X).appTop).hom.toMonoidHom
              u_i =
            Units.map
              (CategoryTheory.Limits.pullback.map
                (CategoryTheory.CategoryStruct.comp (V i).ι f) η_X f η_X
                (V i).ι (CategoryTheory.CategoryStruct.id _) (CategoryTheory.CategoryStruct.id _)
                (by rw [CategoryTheory.Category.comp_id])
                (by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])).appTop.hom.toMonoidHom
              s) →
        s ∈ Set.range
          (Units.map (CategoryTheory.Limits.pullback.fst f η_X).appTop.hom.toMonoidHom)) :=
by
  classical
  have : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
  let η_X := X.fromSpecStalk (genericPoint ↥X)

  
  have hTensorFrac :
      ∀ (A₀ D K : Type u) [CommRing A₀] [IsDomain A₀] [CommRing D] [IsDomain D] [Field K]
        (φ : A₀ →+* D) [Algebra A₀ K] [IsFractionRing A₀ K],
        Function.Injective φ →
        (∀ q : Ideal D, q.IsPrime → Ideal.comap φ q = ⊥ → q = ⊥) →
        letI : Algebra A₀ D := φ.toAlgebra
        let T := TensorProduct A₀ D K
        let ι_D : D →+* T := Algebra.TensorProduct.includeLeftRingHom
        IsDomain T ∧ IsField T ∧ Function.Injective ι_D ∧
          (∀ d : D, d ≠ 0 → IsUnit (ι_D d)) ∧
          (∀ t : T, ∃ c d : D, d ≠ 0 ∧ t * ι_D d = ι_D c) := by
    intro A₀ D K _ _ _ _ _ φ _ _ hInjφ hGenPrime
    letI : Algebra A₀ D := φ.toAlgebra
    let T := TensorProduct A₀ D K
    let ι_D : D →+* T := Algebra.TensorProduct.includeLeftRingHom
    let M₀ : Submonoid D := Algebra.algebraMapSubmonoid D (nonZeroDivisors A₀)
    have : IsLocalization M₀ T := IsLocalization.tensor K (nonZeroDivisors A₀)
    have hM₀_le : M₀ ≤ nonZeroDivisors D := by
      rintro _ ⟨a, ha, rfl⟩
      have ha0 : a ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp ha
      exact mem_nonZeroDivisors_iff_ne_zero.mpr fun h0 => ha0 (hInjφ (h0.trans (map_zero φ).symm))
    have hDomT : IsDomain T := IsLocalization.isDomain_of_le_nonZeroDivisors T hM₀_le
    have : IsDomain T := hDomT
    have hInj_ι : Function.Injective ι_D := IsLocalization.injective T hM₀_le
    have hSurj_ι : ∀ t : T, ∃ c d : D, d ≠ 0 ∧ t * ι_D d = ι_D c := by
      intro t
      obtain ⟨⟨c, m⟩, htm⟩ := IsLocalization.surj M₀ t
      exact ⟨c, m.1, mem_nonZeroDivisors_iff_ne_zero.mp (hM₀_le m.2), htm⟩
    have hUnit_ι : ∀ d : D, d ≠ 0 → IsUnit (ι_D d) := by
      intro d hd
      by_contra hnu
      have hne_top : Ideal.span ({ι_D d} : Set T) ≠ ⊤ := by
        rw [Ne, Ideal.span_singleton_eq_top]
        exact hnu
      obtain ⟨M, hM_max, hdM_le⟩ := Ideal.exists_le_maximal _ hne_top
      have : M.IsPrime := hM_max.isPrime
      let q : Ideal D := Ideal.comap ι_D M
      have : q.IsPrime := Ideal.IsPrime.comap ι_D
      have hq_comap : Ideal.comap φ q = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro a ha
        by_contra ha0
        have hm_mem : φ a ∈ M₀ := ⟨a, mem_nonZeroDivisors_iff_ne_zero.mpr ha0, rfl⟩
        have hu : IsUnit (ι_D (φ a)) := IsLocalization.map_units T ⟨φ a, hm_mem⟩
        exact hM_max.ne_top (Ideal.eq_top_of_isUnit_mem M ha hu)
      have hq_bot : q = ⊥ := hGenPrime q inferInstance hq_comap
      have hd_mem : d ∈ q := hdM_le (Ideal.subset_span (Set.mem_singleton _))
      rw [hq_bot, Ideal.mem_bot] at hd_mem
      exact hd hd_mem
    have hFieldT : IsField T := by
      refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, fun {t} ht => ?_⟩
      obtain ⟨c, d, hd, htd⟩ := hSurj_ι t
      have hc : c ≠ 0 := by
        intro hc0
        rw [hc0, map_zero] at htd
        rcases mul_eq_zero.mp htd with rfl | hd0
        · exact ht rfl
        · exact hd (hInj_ι (hd0.trans (map_zero ι_D).symm))
      obtain ⟨uc, huc⟩ := hUnit_ι c hc
      obtain ⟨ud, hud⟩ := hUnit_ι d hd
      refine ⟨ud.val * (uc⁻¹).val, ?_⟩
      rw [← mul_assoc, hud, htd, ← huc, Units.mul_inv]
    exact ⟨hDomT, hFieldT, hInj_ι, hUnit_ι, hSurj_ι⟩

  
  have hAwayPres :
      ∀ (A₀ D : Type u) [CommRing A₀] [CommRing D] [IsDomain D] (φ : A₀ →+* D),
        Function.Injective φ →
        (∀ q : Ideal D, q.IsPrime → Ideal.comap φ q = ⊥ → q = ⊥) →
        ∀ (g : D) (D' : Type u) [CommRing D'] [Algebra D D'] [IsLocalization.Away g D'],
          g ≠ 0 →
          IsDomain D' ∧
          Function.Injective ((algebraMap D D').comp φ) ∧
          (∀ Q : Ideal D', Q.IsPrime →
            Ideal.comap ((algebraMap D D').comp φ) Q = ⊥ → Q = ⊥) := by
    intro A₀ D _ _ _ φ hInjφ hGenPrime g D' _ _ _ hg
    have hSg_le : Submonoid.powers g ≤ nonZeroDivisors D := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_iff_ne_zero.mpr (pow_ne_zero n hg)
    have hDomD' : IsDomain D' := IsLocalization.isDomain_of_le_nonZeroDivisors D' hSg_le
    have hInjD' : Function.Injective (algebraMap D D') := IsLocalization.injective D' hSg_le
    refine ⟨hDomD', hInjD'.comp hInjφ, fun Q hQ hQ_bot => ?_⟩
    have : Q.IsPrime := hQ
    let q : Ideal D := Ideal.comap (algebraMap D D') Q
    have : q.IsPrime := Ideal.IsPrime.comap (algebraMap D D')
    have hq_comap : Ideal.comap φ q = ⊥ := by
      rw [Ideal.comap_comap]
      exact hQ_bot
    have hq_bot : q = ⊥ := hGenPrime q inferInstance hq_comap
    rw [Submodule.eq_bot_iff]
    intro z hz
    obtain ⟨⟨r, s⟩, hzs⟩ := IsLocalization.surj (Submonoid.powers g) z
    have hr_mem : r ∈ q := by
      change algebraMap D D' r ∈ Q
      rw [← hzs]
      exact Q.mul_mem_right _ hz
    rw [hq_bot, Ideal.mem_bot] at hr_mem
    rw [hr_mem, map_zero] at hzs
    obtain ⟨us, hus⟩ := IsLocalization.map_units D' s
    calc
      z = z * (us.val * (us⁻¹).val) := by rw [Units.mul_inv, mul_one]
      _ = (z * algebraMap D D' s.1) * (us⁻¹).val := by rw [← mul_assoc, hus]
      _ = 0 := by rw [hzs, zero_mul]

  
  have hDenomReg :
      ∀ (D E : Type u) [CommRing D] [CommRing E] (α : D →+* E),
        Function.Injective α →
        (∀ z : E, ∃ c d : D, d ≠ 0 ∧ z * α d = α c) →
        ∀ u : Units E,
          (∀ m : Ideal D, m.IsMaximal → m ≠ ⊥ →
            (∃ a₁ b₁ : D, b₁ ∉ m ∧ (u : E) * α b₁ = α a₁) ∧
            (∃ a₂ b₂ : D, b₂ ∉ m ∧ ((u⁻¹ : Units E) : E) * α b₂ = α a₂)) →
          u ∈ Set.range (Units.map α.toMonoidHom) := by
    intro D E _ _ α hInjα hSurjα u hReg
    have hLift : ∀ z : E,
        (∀ m : Ideal D, m.IsMaximal → m ≠ ⊥ → ∃ a b : D, b ∉ m ∧ z * α b = α a) →
        ∃ r : D, α r = z := by
      intro z hz
      let I : Ideal D :=
        { carrier := { b : D | ∃ a : D, z * α b = α a }
          zero_mem' := ⟨0, by rw [map_zero, mul_zero]⟩
          add_mem' := fun {b₁ b₂} ⟨a₁, h₁⟩ ⟨a₂, h₂⟩ =>
            ⟨a₁ + a₂, by rw [map_add, mul_add, h₁, h₂, map_add]⟩
          smul_mem' := fun c {b} ⟨a, h⟩ =>
            ⟨c * a, by
              simp only [smul_eq_mul, map_mul]
              rw [← mul_assoc, mul_comm z (α c), mul_assoc, h]⟩ }
      have hI_top : I = ⊤ := by
        by_contra hI_ne
        obtain ⟨m, hm_max, hIm⟩ := Ideal.exists_le_maximal I hI_ne
        by_cases hm_bot : m = ⊥
        · obtain ⟨c, d, hd, hzd⟩ := hSurjα z
          have hd_mem : d ∈ m := hIm ⟨c, hzd⟩
          rw [hm_bot, Ideal.mem_bot] at hd_mem
          exact hd hd_mem
        · obtain ⟨a, b, hb_not, hzb⟩ := hz m hm_max hm_bot
          exact hb_not (hIm ⟨a, hzb⟩)
      have h1 : (1 : D) ∈ I := by rw [hI_top]; trivial
      obtain ⟨r, hr⟩ := h1
      exact ⟨r, by rw [← hr, map_one, mul_one]⟩
    obtain ⟨r₁, hr₁⟩ := hLift (u : E) (fun m hm hm_ne => (hReg m hm hm_ne).1)
    obtain ⟨r₂, hr₂⟩ := hLift ((u⁻¹ : Units E) : E) (fun m hm hm_ne => (hReg m hm hm_ne).2)
    have hr₁₂ : r₁ * r₂ = 1 := hInjα (by rw [map_mul, hr₁, hr₂, Units.mul_inv, map_one])
    exact ⟨⟨r₁, r₂, hr₁₂, mul_comm r₂ r₁ ▸ hr₁₂⟩, Units.ext hr₁⟩

  
