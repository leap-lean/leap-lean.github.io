        rw [CategoryTheory.Limits.biprod.lift_desc, CategoryTheory.Preadditive.neg_comp,
          hmap_pre_comp, hmap_pre_comp, hij_comm, add_neg_cancel]
      let inl_app : ∀ Y : (S.Etale)ᵒᵖ, P₁.obj Y ⟶ (P₁ ⊞ P₂).obj Y :=
        fun Y => (CategoryTheory.Limits.biprod.inl : P₁ ⟶ P₁ ⊞ P₂).app Y
      let inr_app : ∀ Y : (S.Etale)ᵒᵖ, P₂.obj Y ⟶ (P₁ ⊞ P₂).obj Y :=
        fun Y => (CategoryTheory.Limits.biprod.inr : P₂ ⟶ P₁ ⊞ P₂).app Y
      let fst_app : ∀ Y : (S.Etale)ᵒᵖ, (P₁ ⊞ P₂).obj Y ⟶ P₁.obj Y :=
        fun Y => (CategoryTheory.Limits.biprod.fst : P₁ ⊞ P₂ ⟶ P₁).app Y
      let snd_app : ∀ Y : (S.Etale)ᵒᵖ, (P₁ ⊞ P₂).obj Y ⟶ P₂.obj Y :=
        fun Y => (CategoryTheory.Limits.biprod.snd : P₁ ⊞ P₂ ⟶ P₂).app Y
      let r_Y : ∀ Y : (S.Etale)ᵒᵖ, (P₁ ⊞ P₂).obj Y ⟶ P₁₂.obj Y := fun Y =>
        fst_app Y ≫
          desc_free (fun f₁ : Y.unop ⟶ O_sub U₁ =>
            if h : ∃ g : Y.unop ⟶ O_sub U₁₂, g ≫ i₁ = f₁ then
              ι_free (O_sub U₁₂) Y h.choose
            else 0)
      let s_Y : ∀ Y : (S.Etale)ᵒᵖ, P_cup.obj Y ⟶ (P₁ ⊞ P₂).obj Y := fun Y =>
        desc_free (fun h : Y.unop ⟶ O_sub U_cup =>
          if h₂ : ∃ f₂ : Y.unop ⟶ O_sub U₂, f₂ ≫ j₂ = h then
            ι_free (O_sub U₂) Y h₂.choose ≫ inr_app Y
          else if h₁ : ∃ f₁ : Y.unop ⟶ O_sub U₁, f₁ ≫ j₁ = h then
            ι_free (O_sub U₁) Y h₁.choose ≫ inl_app Y
          else 0)
      have hr_retract : ∀ Y : (S.Etale)ᵒᵖ, α_pre.app Y ≫ r_Y Y = 𝟙 (P₁₂.obj Y) := by
        intro Y
        have hα_fst : α_pre.app Y ≫ fst_app Y = (map_pre i₁).app Y :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.lift_fst (map_pre i₁) (-map_pre i₂))
        dsimp [r_Y]
        rw [← CategoryTheory.Category.assoc, hα_fst]
        apply h_ext_free
        intro g
        rw [← CategoryTheory.Category.assoc, hMap_pre_ι i₁ Y g, h_ι_desc_free,
          CategoryTheory.Category.comp_id]
        have hex : ∃ g' : Y.unop ⟶ O_sub U₁₂, g' ≫ i₁ = g ≫ i₁ := ⟨g, rfl⟩
        rw [dif_pos hex]
        congr 1
        exact hMono_le (hCap.le.trans inf_le_left) hex.choose g hex.choose_spec
      have h_homotopy : ∀ Y : (S.Etale)ᵒᵖ,
          r_Y Y ≫ α_pre.app Y + β_pre.app Y ≫ s_Y Y = 𝟙 ((P₁ ⊞ P₂).obj Y) := by
        intro Y
        have h_inl_fst : inl_app Y ≫ fst_app Y = 𝟙 (P₁.obj Y) :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.inl_fst :
              (CategoryTheory.Limits.biprod.inl : P₁ ⟶ P₁ ⊞ P₂) ≫
                CategoryTheory.Limits.biprod.fst = 𝟙 P₁)
        have h_inr_fst : inr_app Y ≫ fst_app Y = 0 :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.inr_fst :
              (CategoryTheory.Limits.biprod.inr : P₂ ⟶ P₁ ⊞ P₂) ≫
                CategoryTheory.Limits.biprod.fst = 0)
        have h_inl_snd : inl_app Y ≫ snd_app Y = 0 :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.inl_snd :
              (CategoryTheory.Limits.biprod.inl : P₁ ⟶ P₁ ⊞ P₂) ≫
                CategoryTheory.Limits.biprod.snd = 0)
        have h_inr_snd : inr_app Y ≫ snd_app Y = 𝟙 (P₂.obj Y) :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.inr_snd :
              (CategoryTheory.Limits.biprod.inr : P₂ ⟶ P₁ ⊞ P₂) ≫
                CategoryTheory.Limits.biprod.snd = 𝟙 P₂)
        have h_total_Y : fst_app Y ≫ inl_app Y + snd_app Y ≫ inr_app Y = 𝟙 ((P₁ ⊞ P₂).obj Y) :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.total :
              (CategoryTheory.Limits.biprod.fst : P₁ ⊞ P₂ ⟶ P₁) ≫
                CategoryTheory.Limits.biprod.inl +
              CategoryTheory.Limits.biprod.snd ≫ CategoryTheory.Limits.biprod.inr = 𝟙 (P₁ ⊞ P₂))
        have bip_ext_left : ∀ {Q : AddCommGrpCat.{u}} {u₁ u₂ : (P₁ ⊞ P₂).obj Y ⟶ Q},
            inl_app Y ≫ u₁ = inl_app Y ≫ u₂ →
            inr_app Y ≫ u₁ = inr_app Y ≫ u₂ → u₁ = u₂ := by
          intro Q u₁ u₂ h₁ h₂
          calc
            u₁ = 𝟙 ((P₁ ⊞ P₂).obj Y) ≫ u₁ := (CategoryTheory.Category.id_comp u₁).symm
            _ = (fst_app Y ≫ inl_app Y + snd_app Y ≫ inr_app Y) ≫ u₁ := by rw [h_total_Y]
            _ = fst_app Y ≫ (inl_app Y ≫ u₁) + snd_app Y ≫ (inr_app Y ≫ u₁) := by
                simp only [CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc]
            _ = fst_app Y ≫ (inl_app Y ≫ u₂) + snd_app Y ≫ (inr_app Y ≫ u₂) := by rw [h₁, h₂]
            _ = (fst_app Y ≫ inl_app Y + snd_app Y ≫ inr_app Y) ≫ u₂ := by
                simp only [CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc]
            _ = u₂ := by rw [h_total_Y, CategoryTheory.Category.id_comp]
        have bip_ext_right : ∀ {Q : AddCommGrpCat.{u}} {u₁ u₂ : Q ⟶ (P₁ ⊞ P₂).obj Y},
            u₁ ≫ fst_app Y = u₂ ≫ fst_app Y →
            u₁ ≫ snd_app Y = u₂ ≫ snd_app Y → u₁ = u₂ := by
          intro Q u₁ u₂ h₁ h₂
          calc
            u₁ = u₁ ≫ 𝟙 ((P₁ ⊞ P₂).obj Y) := (CategoryTheory.Category.comp_id u₁).symm
            _ = u₁ ≫ (fst_app Y ≫ inl_app Y + snd_app Y ≫ inr_app Y) := by rw [h_total_Y]
            _ = (u₁ ≫ fst_app Y) ≫ inl_app Y + (u₁ ≫ snd_app Y) ≫ inr_app Y := by
                simp only [CategoryTheory.Preadditive.comp_add, CategoryTheory.Category.assoc]
            _ = (u₂ ≫ fst_app Y) ≫ inl_app Y + (u₂ ≫ snd_app Y) ≫ inr_app Y := by rw [h₁, h₂]
            _ = u₂ ≫ (fst_app Y ≫ inl_app Y + snd_app Y ≫ inr_app Y) := by
                simp only [CategoryTheory.Preadditive.comp_add, CategoryTheory.Category.assoc]
            _ = u₂ := by rw [h_total_Y, CategoryTheory.Category.comp_id]
        have h_inl_β : inl_app Y ≫ β_pre.app Y = (map_pre j₁).app Y :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.inl_desc (map_pre j₁) (map_pre j₂))
        have h_inr_β : inr_app Y ≫ β_pre.app Y = (map_pre j₂).app Y :=
          congrArg (fun τ => τ.app Y)
            (CategoryTheory.Limits.biprod.inr_desc (map_pre j₁) (map_pre j₂))
        have hα_app : ∀ g : Y.unop ⟶ O_sub U₁₂,
            ι_free (O_sub U₁₂) Y g ≫ α_pre.app Y =
              ι_free (O_sub U₁) Y (g ≫ i₁) ≫ inl_app Y -
              ι_free (O_sub U₂) Y (g ≫ i₂) ≫ inr_app Y := by
          intro g
          apply bip_ext_right
          · have hfst : α_pre.app Y ≫ fst_app Y = (map_pre i₁).app Y :=
              congrArg (fun τ => τ.app Y)
                (CategoryTheory.Limits.biprod.lift_fst (map_pre i₁) (-map_pre i₂))
            rw [CategoryTheory.Category.assoc, hfst, hMap_pre_ι,
              CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc, h_inl_fst,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc, h_inr_fst,
              CategoryTheory.Limits.comp_zero, sub_zero]
          · have hsnd : α_pre.app Y ≫ snd_app Y = -(map_pre i₂).app Y :=
              congrArg (fun τ => τ.app Y)
                (CategoryTheory.Limits.biprod.lift_snd (map_pre i₁) (-map_pre i₂))
            rw [CategoryTheory.Category.assoc, hsnd, CategoryTheory.Preadditive.comp_neg,
              hMap_pre_ι, CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc,
              h_inl_snd, CategoryTheory.Limits.comp_zero, zero_sub,
              CategoryTheory.Category.assoc, h_inr_snd, CategoryTheory.Category.comp_id]
        apply bip_ext_left
        · apply h_ext_free
          intro f₁
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Preadditive.comp_add,
            CategoryTheory.Preadditive.comp_add]
          have hr_inl : (ι_free (O_sub U₁) Y f₁ ≫ inl_app Y) ≫ r_Y Y =
              if h : ∃ g : Y.unop ⟶ O_sub U₁₂, g ≫ i₁ = f₁ then
                ι_free (O_sub U₁₂) Y h.choose
              else 0 := by
            dsimp only [r_Y]
            rw [CategoryTheory.Category.assoc (ι_free (O_sub U₁) Y f₁),
              ← CategoryTheory.Category.assoc (inl_app Y), h_inl_fst,
              CategoryTheory.Category.id_comp, h_ι_desc_free]
          have hs_inl : (ι_free (O_sub U₁) Y f₁ ≫ inl_app Y) ≫ (β_pre.app Y ≫ s_Y Y) =
              ι_free (O_sub U_cup) Y (f₁ ≫ j₁) ≫ s_Y Y := by
            calc
              (ι_free (O_sub U₁) Y f₁ ≫ inl_app Y) ≫ (β_pre.app Y ≫ s_Y Y)
                = (ι_free (O_sub U₁) Y f₁ ≫ (inl_app Y ≫ β_pre.app Y)) ≫ s_Y Y := by
                    simp only [CategoryTheory.Category.assoc]
              _ = _ := by rw [h_inl_β, hMap_pre_ι]
          change (ι_free (O_sub U₁) Y f₁ ≫ inl_app Y) ≫ r_Y Y ≫ α_pre.app Y +
              (ι_free (O_sub U₁) Y f₁ ≫ inl_app Y) ≫ (β_pre.app Y ≫ s_Y Y) =
            ι_free (O_sub U₁) Y f₁ ≫ inl_app Y
          rw [← CategoryTheory.Category.assoc _ (r_Y Y), hr_inl, hs_inl]
          dsimp [s_Y]
          rw [h_ι_desc_free]
          by_cases h₂ : ∃ f₂ : Y.unop ⟶ O_sub U₂, f₂ ≫ j₂ = f₁ ≫ j₁
          · rw [dif_pos h₂]
            obtain ⟨g, hg₁, hg₂⟩ := hPull f₁ h₂.choose h₂.choose_spec.symm
            have hex : ∃ g' : Y.unop ⟶ O_sub U₁₂, g' ≫ i₁ = f₁ := ⟨g, hg₁⟩
            rw [dif_pos hex, hα_app hex.choose]
            have hg_eq : hex.choose = g :=
              hMono_le (hCap.le.trans inf_le_left) hex.choose g (hex.choose_spec.trans hg₁.symm)
            rw [hg_eq, hg₁, hg₂]
            exact sub_add_cancel _ _
          · rw [dif_neg h₂]
            have hnot_ex : ¬ ∃ g' : Y.unop ⟶ O_sub U₁₂, g' ≫ i₁ = f₁ := by
              rintro ⟨g', rfl⟩
              exact h₂ ⟨g' ≫ i₂, by rw [CategoryTheory.Category.assoc,
                CategoryTheory.Category.assoc, hij_comm]⟩
            have h₁ : ∃ f'₁ : Y.unop ⟶ O_sub U₁, f'₁ ≫ j₁ = f₁ ≫ j₁ := ⟨f₁, rfl⟩
            rw [dif_neg hnot_ex, CategoryTheory.Limits.zero_comp, zero_add, dif_pos h₁]
            have hf₁_eq : h₁.choose = f₁ :=
              hMono_le (le_sup_left.trans hCup.le) h₁.choose f₁ h₁.choose_spec
            rw [hf₁_eq]
        · apply h_ext_free
          intro f₂
          rw [CategoryTheory.Category.comp_id, CategoryTheory.Preadditive.comp_add,
            CategoryTheory.Preadditive.comp_add]
          have hr_inr : inr_app Y ≫ r_Y Y = 0 := by
            dsimp [r_Y]
            rw [← CategoryTheory.Category.assoc, h_inr_fst, CategoryTheory.Limits.zero_comp]
          have hs_inr : (ι_free (O_sub U₂) Y f₂ ≫ inr_app Y) ≫ (β_pre.app Y ≫ s_Y Y) =
              ι_free (O_sub U_cup) Y (f₂ ≫ j₂) ≫ s_Y Y := by
            calc
              (ι_free (O_sub U₂) Y f₂ ≫ inr_app Y) ≫ (β_pre.app Y ≫ s_Y Y)
                = (ι_free (O_sub U₂) Y f₂ ≫ (inr_app Y ≫ β_pre.app Y)) ≫ s_Y Y := by
                    simp only [CategoryTheory.Category.assoc]
              _ = _ := by rw [h_inr_β, hMap_pre_ι]
          have h_term1 : ι_free (O_sub U₂) Y f₂ ≫ inr_app Y ≫ r_Y Y ≫ α_pre.app Y = 0 := by
            rw [← CategoryTheory.Category.assoc (inr_app Y), hr_inr, CategoryTheory.Limits.zero_comp,
              CategoryTheory.Limits.comp_zero]
          change ι_free (O_sub U₂) Y f₂ ≫ inr_app Y ≫ r_Y Y ≫ α_pre.app Y +
              (ι_free (O_sub U₂) Y f₂ ≫ inr_app Y) ≫ (β_pre.app Y ≫ s_Y Y) =
            ι_free (O_sub U₂) Y f₂ ≫ inr_app Y
          rw [h_term1, zero_add, hs_inr]
          dsimp [s_Y]
          rw [h_ι_desc_free]
          have h₂ : ∃ f'₂ : Y.unop ⟶ O_sub U₂, f'₂ ≫ j₂ = f₂ ≫ j₂ := ⟨f₂, rfl⟩
          rw [dif_pos h₂]
          have hf₂_eq : h₂.choose = f₂ :=
            hMono_le (le_sup_right.trans hCup.le) h₂.choose f₂ h₂.choose_spec
          rw [hf₂_eq]
      have _hMono_α_app : ∀ Y : (S.Etale)ᵒᵖ, CategoryTheory.Mono (α_pre.app Y) :=
        fun Y => ⟨fun f₁ f₂ hf => by
          have := congrArg (· ≫ r_Y Y) hf
          simpa [CategoryTheory.Category.assoc, hr_retract Y] using this⟩
      have hKer_pre : CategoryTheory.Limits.IsLimit
          (CategoryTheory.Limits.KernelFork.ofι α_pre h0_pre) := by
        have hfac_Y : ∀ (fk : CategoryTheory.Limits.Fork β_pre 0) (Y : (S.Etale)ᵒᵖ),
            (fk.ι.app Y ≫ r_Y Y) ≫ α_pre.app Y = fk.ι.app Y := by
          intro fk Y
          have h1 : fk.ι.app Y ≫ (r_Y Y ≫ α_pre.app Y + β_pre.app Y ≫ s_Y Y) =
              fk.ι.app Y ≫ 𝟙 ((P₁ ⊞ P₂).obj Y) :=
            congrArg (fk.ι.app Y ≫ ·) (h_homotopy Y)
          have hkY : fk.ι.app Y ≫ β_pre.app Y = 0 :=
            congrArg (fun τ => τ.app Y) (CategoryTheory.Limits.KernelFork.condition fk)
          rw [CategoryTheory.Preadditive.comp_add, CategoryTheory.Category.comp_id,
            ← CategoryTheory.Category.assoc (fk.ι.app Y) (β_pre.app Y), hkY,
            CategoryTheory.Limits.zero_comp, add_zero, ← CategoryTheory.Category.assoc] at h1
          exact h1
        refine CategoryTheory.Limits.Fork.IsLimit.mk _
          (fun fk => { app := fun Y => fk.ι.app Y ≫ r_Y Y, naturality := ?_ })
          (fun fk => ?_) (fun fk m hm => ?_)
        · intro Y₁ Y₂ w
          change fk.pt.map w ≫ (fk.ι.app Y₂ ≫ r_Y Y₂) =
            (fk.ι.app Y₁ ≫ r_Y Y₁) ≫ P₁₂.map w
          rw [← CategoryTheory.cancel_mono (α_pre.app Y₂), CategoryTheory.Category.assoc,
            hfac_Y fk Y₂, fk.ι.naturality w, CategoryTheory.Category.assoc,
            α_pre.naturality w, ← CategoryTheory.Category.assoc, hfac_Y fk Y₁]
        · ext Y : 2
          exact hfac_Y fk Y
        · ext Y : 2
          change m.app Y = fk.ι.app Y ≫ r_Y Y
          rw [← CategoryTheory.cancel_mono (α_pre.app Y)]
          have hmY : m.app Y ≫ α_pre.app Y = fk.ι.app Y := congrArg (fun τ => τ.app Y) hm
          rw [hmY, hfac_Y fk Y]
      let SC_pre := CategoryTheory.ShortComplex.mk α_pre β_pre h0_pre
      have hEx_pre : SC_pre.Exact :=
        CategoryTheory.ShortComplex.exact_of_f_is_kernel SC_pre hKer_pre
      have : CategoryTheory.Mono α_pre := CategoryTheory.NatTrans.mono_of_mono_app α_pre
      have hEx_map : (SC_pre.map ShF).Exact := hEx_pre.map ShF
      have : CategoryTheory.Mono (ShF.map α_pre) := ShF.map_mono α_pre
      let e_bip_pre : ShF.obj (P₁ ⊞ P₂) ≅ ShF.obj P₁ ⊞ ShF.obj P₂ :=
        { hom := CategoryTheory.Limits.biprod.lift
            (ShF.map CategoryTheory.Limits.biprod.fst)
            (ShF.map CategoryTheory.Limits.biprod.snd)
          inv := CategoryTheory.Limits.biprod.desc
            (ShF.map CategoryTheory.Limits.biprod.inl)
            (ShF.map CategoryTheory.Limits.biprod.inr)
          hom_inv_id := by
            rw [CategoryTheory.Limits.biprod.lift_desc, ← ShF.map_comp, ← ShF.map_comp,
              ← ShF.map_add, CategoryTheory.Limits.biprod.total, ShF.map_id]
          inv_hom_id := by
            apply CategoryTheory.Limits.biprod.hom_ext'
            · apply CategoryTheory.Limits.biprod.hom_ext
              · rw [CategoryTheory.Limits.biprod.inl_desc_assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.biprod.lift_fst, ← ShF.map_comp,
                  CategoryTheory.Limits.biprod.inl_fst, ShF.map_id,
                  CategoryTheory.Category.comp_id, CategoryTheory.Limits.biprod.inl_fst]
              · rw [CategoryTheory.Limits.biprod.inl_desc_assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.biprod.lift_snd, ← ShF.map_comp,
                  CategoryTheory.Limits.biprod.inl_snd, ShF.map_zero,
                  CategoryTheory.Category.comp_id, CategoryTheory.Limits.biprod.inl_snd]
            · apply CategoryTheory.Limits.biprod.hom_ext
              · rw [CategoryTheory.Limits.biprod.inr_desc_assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.biprod.lift_fst, ← ShF.map_comp,
                  CategoryTheory.Limits.biprod.inr_fst, ShF.map_zero,
                  CategoryTheory.Category.comp_id, CategoryTheory.Limits.biprod.inr_fst]
              · rw [CategoryTheory.Limits.biprod.inr_desc_assoc, CategoryTheory.Category.assoc,
                  CategoryTheory.Limits.biprod.lift_snd, ← ShF.map_comp,
                  CategoryTheory.Limits.biprod.inr_snd, ShF.map_id,
                  CategoryTheory.Category.comp_id, CategoryTheory.Limits.biprod.inr_snd] }
      let α_sh : ShF.obj P₁₂ ⟶ ShF.obj P₁ ⊞ ShF.obj P₂ :=
        CategoryTheory.Limits.biprod.lift (ShF.map (map_pre i₁)) (-ShF.map (map_pre i₂))
      let β_sh : ShF.obj P₁ ⊞ ShF.obj P₂ ⟶ ShF.obj P_cup :=
        CategoryTheory.Limits.biprod.desc (ShF.map (map_pre j₁)) (ShF.map (map_pre j₂))
      have hα_sh : ShF.map α_pre ≫ e_bip_pre.hom = α_sh := by
        dsimp only [e_bip_pre, α_sh, α_pre]
        apply CategoryTheory.Limits.biprod.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_fst,
            CategoryTheory.Limits.biprod.lift_fst, ← ShF.map_comp,
            CategoryTheory.Limits.biprod.lift_fst]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.biprod.lift_snd,
            CategoryTheory.Limits.biprod.lift_snd, ← ShF.map_comp,
            CategoryTheory.Limits.biprod.lift_snd, ShF.map_neg]
      have hβ_sh : e_bip_pre.hom ≫ β_sh = ShF.map β_pre := by
        rw [← CategoryTheory.Iso.eq_inv_comp]
        dsimp only [e_bip_pre, β_sh, β_pre]
        apply CategoryTheory.Limits.biprod.hom_ext'
        · rw [CategoryTheory.Limits.biprod.inl_desc,
            CategoryTheory.Limits.biprod.inl_desc_assoc, ← ShF.map_comp,
            CategoryTheory.Limits.biprod.inl_desc]
        · rw [CategoryTheory.Limits.biprod.inr_desc,
            CategoryTheory.Limits.biprod.inr_desc_assoc, ← ShF.map_comp,
            CategoryTheory.Limits.biprod.inr_desc]
      have h0_sh : α_sh ≫ β_sh = 0 := by
        rw [← hα_sh, CategoryTheory.Category.assoc, hβ_sh, ← ShF.map_comp, h0_pre, ShF.map_zero]
      let SC_sh := CategoryTheory.ShortComplex.mk α_sh β_sh h0_sh
      let e_SC_sh : SC_pre.map ShF ≅ SC_sh :=
        CategoryTheory.ShortComplex.isoMk (CategoryTheory.Iso.refl (ShF.obj P₁₂)) e_bip_pre
          (CategoryTheory.Iso.refl (ShF.obj P_cup))
          ((CategoryTheory.Category.id_comp α_sh).trans hα_sh.symm)
          (hβ_sh.trans (CategoryTheory.Category.comp_id (ShF.map β_pre)).symm)
      have hEx_sh : SC_sh.Exact :=
        (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC_sh).mp hEx_map
