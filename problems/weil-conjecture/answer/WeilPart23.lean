        by_contra hall
        push Not at hall
        have h1 : (1 : S) ∈ P_spec.asIdeal := by
          rw [← hsum_one]
          exact Submodule.sum_mem P_spec.asIdeal (fun i _ => hall i)
        exact P_spec.isPrime.one_notMem h1
      obtain ⟨i, hi_not⟩ := hex_not
      let q_ideal : Ideal R :=
        { carrier := { r : R | Pi.single i r ∈ P_spec.asIdeal }
          add_mem' := fun {a b} ha hb => by
            change Pi.single i (a + b) ∈ P_spec.asIdeal
            rw [Pi.single_add]
            exact P_spec.asIdeal.add_mem ha hb
          zero_mem' := by
            change Pi.single i (0 : R) ∈ P_spec.asIdeal
            rw [Pi.single_zero]
            exact P_spec.asIdeal.zero_mem
          smul_mem' := fun c {a} ha => by
            change Pi.single i (c • a) ∈ P_spec.asIdeal
            have hmul : (Pi.single i (c • a) : S) = (fun _ : ZMod ℓ => c) * (Pi.single i a : S) := by
              funext k
              change Pi.single (M := fun _ : ZMod ℓ => R) i (c * a) k =
                c * Pi.single (M := fun _ : ZMod ℓ => R) i a k
              by_cases hk : k = i
              · subst hk; simp
              · simp [Pi.single_eq_of_ne hk]
            rw [hmul]
            exact P_spec.asIdeal.mul_mem_left _ ha }
      have hq_prime : q_ideal.IsPrime := by
        refine ⟨?_, ?_⟩
        · intro htop
          have h1 : (1 : R) ∈ q_ideal := htop ▸ trivial
          exact hi_not h1
        · intro a b hab
          have hmul : (Pi.single i a : S) * (Pi.single i b : S) = (Pi.single i (a * b) : S) := by
            funext k
            change Pi.single (M := fun _ : ZMod ℓ => R) i a k *
              Pi.single (M := fun _ : ZMod ℓ => R) i b k =
              Pi.single (M := fun _ : ZMod ℓ => R) i (a * b) k
            by_cases hk : k = i
            · subst hk; simp
            · simp [Pi.single_eq_of_ne hk]
          have hab' : (Pi.single i a : S) * (Pi.single i b : S) ∈ P_spec.asIdeal := by
            rw [hmul]
            exact hab
          exact P_spec.isPrime.mem_or_mem hab'
      let q₀ : PrimeSpectrum R := ⟨q_ideal, hq_prime⟩
      rw [Set.mem_iUnion]
      refine ⟨i, q₀, ?_⟩
      rw [he_base i q₀]
      apply PrimeSpectrum.ext
      ext g
      have hg_mul : (g : S) * δ i = (Pi.single i ((g : S) i) : S) := by
        funext k
        change (g : S) k * Pi.single (M := fun _ : ZMod ℓ => R) i 1 k =
          Pi.single (M := fun _ : ZMod ℓ => R) i ((g : S) i) k
        by_cases hk : k = i
        · subst hk; simp
        · simp [Pi.single_eq_of_ne hk]
      change (Pi.single i ((g : S) i) : S) ∈ P_spec.asIdeal ↔ (g : S) ∈ P_spec.asIdeal
      rw [← hg_mul]
      constructor
      · intro hprod
        exact (P_spec.isPrime.mem_or_mem hprod).resolve_right hi_not
      · intro hg
        exact P_spec.asIdeal.mul_mem_right (δ i) hg

  
  have ⟨v₀_pt, hv₀_pt⟩ := hNe_V
  have hNe_topV₀ : Nonempty ↥((⊤ : V₀.Opens) : AlgebraicGeometry.Scheme.{u}) :=
