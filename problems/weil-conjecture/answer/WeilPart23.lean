              exact ℋ.obj.map_id _))) }, fun _ _ => rfl⟩
    obtain ⟨adj_RP, hadj_RP_counit⟩ := hAdjRP
    let η_pull : P_pull ≅ R_ab := adj_pull.leftAdjointUniq adj_RP
    refine ⟨η_pull, fun A => ?_⟩
    let τ_std : G.obj T₂ ⟶ T₁ := hT₁.from (G.obj T₂)
    let u'_A : C₂.obj A ⟶ P_push.obj (C₁.obj A) :=
