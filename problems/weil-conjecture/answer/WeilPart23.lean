        rw [hψ_of D, ← hz_repr, Finset.sum_mul]
        dsimp [num_CU]
        rw [map_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        have hgen_L : pb_L.gen = AdjoinRoot.root P_f := AdjoinRoot.powerBasis_gen hIrred.ne_zero
        rw [PowerBasis.basis_eq_pow, hgen_L, hroot_w, Algebra.smul_def, mul_pow,
          map_mul ψ, map_pow ψ, hψ_of, hψ_root]
        have h1 : algebraMap F L (pb_L.basis.repr z i) *
