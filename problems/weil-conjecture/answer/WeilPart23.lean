    have hB_to_CU : ∀ b : B, ∃ c : C_U, ψ c = τ b := by
      intro b
      let _ : Algebra C_U L := alg_CU_L
      have : IsFractionRing C_U L := hFrac_CU_L
      obtain ⟨P, hPm, hPe⟩ := (hτ_int (τ b)).mpr ⟨b, rfl⟩
      have htb_CU : _root_.IsIntegral C_U (τ b) := by
        refine ⟨P.map (algebraMap A C_U), hPm.map (algebraMap A C_U), ?_⟩
        rw [Polynomial.eval₂_map]
        change Polynomial.eval₂ (ψ.comp (algebraMap A C_U)) (τ b) P = 0
        rwa [hcomp_ψ]
