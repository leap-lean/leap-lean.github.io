        AlgebraicGeometry.IsClosedImmersion.lift_fac Φ_b (ι_inc ∣_ Q_b) hKer_eq.ge
      have huv_cl : u_cl ≫ v_cl = 𝟙 E_b := by
        rw [← CategoryTheory.cancel_mono Φ_b, CategoryTheory.Category.assoc, hv_cl, hu_cl,
