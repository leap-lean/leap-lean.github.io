      have hForGen := hF_type _ hMem
      have hForArr := (CategoryTheory.Presieve.isSheafFor_iff_generate
        (CategoryTheory.Presieve.ofArrows Z_c f_c)).mpr hForGen
      exact (CategoryTheory.Presieve.isSheafFor_arrows_iff
        (F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) f_c).mp hForArr sec hCompat

    let ℒ_S : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf S n, hShL⟩
    let FM : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleTorsionSheaf S n
    let adj_S := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
    let Φ_hom : FM ⟶ ℒ_S := (adj_S.homEquiv AM ℒ_S).symm (weilAltLocConstConstHom S T_S n)

    have hΦ_unit : CategoryTheory.CategoryStruct.comp (adj_S.unit.app AM)
        (Φ_hom.hom.app (Opposite.op T_S)) = weilAltLocConstConstHom S T_S n :=
      (adj_S.homEquiv_unit AM ℒ_S Φ_hom).symm.trans (Equiv.apply_symm_apply _ _)

    have hΦ_const : ∀ (W : S.Etale) (a : ULift.{u} (ZMod n)),
        (Φ_hom.hom.app (Opposite.op W)).hom
          ((FM.obj.map (Opposite.op (hT_S.from W))).hom ((adj_S.unit.app AM).hom a)) =
          LocallyConstant.const ↥(Fgt.obj W).left a := by
      intro W a
      let src := FM.obj.obj (Opposite.op T_S)
      let dst := ℒ_S.obj.obj (Opposite.op W)
      have hnat := congrArg (fun f : src ⟶ dst => AddCommGrpCat.Hom.hom f ((adj_S.unit.app AM).hom a))
        (Φ_hom.hom.naturality (Opposite.op (hT_S.from W)))
      change (Φ_hom.hom.app (Opposite.op W)).hom
          ((FM.obj.map (Opposite.op (hT_S.from W))).hom ((adj_S.unit.app AM).hom a)) =
        (ℒ_S.obj.map (Opposite.op (hT_S.from W))).hom
          ((Φ_hom.hom.app (Opposite.op T_S)).hom ((adj_S.unit.app AM).hom a)) at hnat
      refine hnat.trans ?_
      have hu := congrArg (fun f : AM ⟶ ℒ_S.obj.obj (Opposite.op T_S) => AddCommGrpCat.Hom.hom f a) hΦ_unit
      change (Φ_hom.hom.app (Opposite.op T_S)).hom ((adj_S.unit.app AM).hom a) =
        LocallyConstant.const ↥(Fgt.obj T_S).left a at hu
      rw [hu]
      rfl

    let openEtObj : ∀ (W : S.Etale) (O : ((Fgt.obj W).left).Opens), S.Etale :=
      fun W O => CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ (Fgt.obj W).hom)
        (by have _ : AlgebraicGeometry.Etale (Fgt.obj W).hom := W.prop; infer_instance)
    let openEtHom : ∀ (W : S.Etale) (O : ((Fgt.obj W).left).Opens), openEtObj W O ⟶ W :=
