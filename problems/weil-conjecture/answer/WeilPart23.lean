          ext ℱ : 2
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext W_op
          change ℱ.obj.map (adj_site.counit.app (M_p.obj W_op.unop)).op ≫
              ℱ.obj.map (M_p.map (adj_site.unit.app W_op.unop)).op = 𝟙 _
          rw [← CategoryTheory.Functor.map_comp, ← op_comp,
            adj_site.left_triangle_components W_op.unop]
          exact CategoryTheory.Functor.map_id ℱ.obj (Opposite.op (M_p.obj W_op.unop))
        right_triangle := by
          ext 𝒢 : 2
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext U_op
          change 𝒢.obj.map (B.map (adj_site.counit.app U_op.unop)).op ≫
              𝒢.obj.map (adj_site.unit.app (B.obj U_op.unop)).op = 𝟙 _
          rw [← CategoryTheory.Functor.map_comp, ← op_comp,
            adj_site.right_triangle_components U_op.unop]
          exact CategoryTheory.Functor.map_id 𝒢.obj (Opposite.op (B.obj U_op.unop)) }

  let η_iso : P_pull ≅ R_p := CategoryTheory.Adjunction.leftAdjointUniq adj_pull adj_Rp

  have hP_push_nsmul :
      ∀ {𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}} (n : ℕ) (h : 𝒢₁ ⟶ 𝒢₂),
