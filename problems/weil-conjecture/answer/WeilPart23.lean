import WeilPart22
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_polyP1_clopen_diagonal_and_bockstein_r2_upgrade (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (η : ∀ r : ℕ, weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ r) 2)
    (γ_rel : ∀ (δ r : ℕ), Quiver.Hom
      (weilEtaleTorsionSheaf (weilPolyP1Over k δ).left (ℓ ^ r))
      (weilEtaleHigherDirectImage
        (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
          (weilProjectiveSpaceOver k 1).hom) 2
        (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r))))
    (Tr_rel : ∀ (δ r : ℕ), Quiver.Hom
      (weilEtaleHigherDirectImage
        (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
          (weilProjectiveSpaceOver k 1).hom) 2
        (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r)))
      (weilEtaleTorsionSheaf (weilPolyP1Over k δ).left (ℓ ^ r)))
    (hη_trans : ∀ r : ℕ,
      weilEtaleTorsionTransition (weilProjectiveSpaceOver k 1).left ℓ r 2 (η (r + 1)) = η r)
    (hγTr : ∀ r : ℕ,
      CategoryTheory.CategoryStruct.comp (γ_rel δ r) (Tr_rel δ r) =
        CategoryTheory.CategoryStruct.id
          (weilEtaleTorsionSheaf (weilPolyP1Over k δ).left (ℓ ^ r)) ∧
      CategoryTheory.CategoryStruct.comp (Tr_rel δ r) (γ_rel δ r) =
        CategoryTheory.CategoryStruct.id
          (weilEtaleHigherDirectImage
            (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
              (weilProjectiveSpaceOver k 1).hom) 2
            (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r))))
    (hγ_char : ∀ (r : ℕ)
        (p_ρ : weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ r) 2 →+
          weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) 2),
      WeilIsTorsionEtalePullback
        (CategoryTheory.Limits.pullback.snd (weilPolyP1Over k δ).hom
          (weilProjectiveSpaceOver k 1).hom) (ℓ ^ r) 2 p_ρ →
      (∀ (σ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
          (weilPolyP1Over k δ).left)
         (hσ : CategoryTheory.CategoryStruct.comp σ (weilPolyP1Over k δ).hom =
           CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k))),
        let ι_σ : Quiver.Hom (weilProjectiveSpaceOver k 1).left
            (weilPolyP1Over k (δ + 1)).left :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.comp (weilProjectiveSpaceOver k 1).hom σ)
            (CategoryTheory.CategoryStruct.id (weilProjectiveSpaceOver k 1).left)
            ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp _) hσ).trans
                (CategoryTheory.Category.comp_id _) |>.trans
                  (CategoryTheory.Category.id_comp _).symm))
        ∀ (p_ισ : weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) 2 →+
            weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left (ℓ ^ r) 2),
          WeilIsTorsionEtalePullback ι_σ (ℓ ^ r) 2 p_ισ →
          p_ισ (p_ρ (η r)) = η r) ∧
      (∀ (T_δ : (weilPolyP1Over k δ).left.Etale) (hT_δ : CategoryTheory.Limits.IsTerminal T_δ)
         (hT_top : CategoryTheory.Limits.IsTerminal
           ((weilEtaleSitePullback
             (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
               (weilProjectiveSpaceOver k 1).hom)).obj T_δ)),
        let Q_rel : CategoryTheory.Functor
            (Opposite (weilPolyP1Over k (δ + 1)).left.Etale) AddCommGrpCat.{u} :=
          CategoryTheory.Sheaf.cohomologyPresheaf
            (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r)) 2
        let P_rel : CategoryTheory.Functor
            (Opposite (weilPolyP1Over k δ).left.Etale) AddCommGrpCat.{u} :=
          CategoryTheory.Functor.comp
            (weilEtaleSitePullback
              (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
                (weilProjectiveSpaceOver k 1).hom)).op Q_rel
        ((CategoryTheory.constantSheafAdj (weilPolyP1Over k δ).left.smallEtaleTopology
          AddCommGrpCat.{u} hT_δ).homEquiv
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod (ℓ ^ r))))
          (weilEtaleHigherDirectImage
            (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
              (weilProjectiveSpaceOver k 1).hom) 2
            (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r)))
          (γ_rel δ r)) (ULift.up 1) =
        (((CategoryTheory.sheafificationAdjunction (weilPolyP1Over k δ).left.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P_rel).app
          (Opposite.op T_δ))
          (weilPolyP1CohomologyTermToPresheaf (weilPolyP1Over k (δ + 1)).left
            ((weilEtaleSitePullback
              (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
                (weilProjectiveSpaceOver k 1).hom)).obj T_δ) hT_top
            (weilEtaleTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r)) 2 (p_ρ (η r)))))
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom]
    [AlgebraicGeometry.IsProper (weilPolyP1Over k δ).hom]
    (V : (weilPolyP1Over k δ).left.Etale)
    (U : (weilPolyP1Over k (δ + 1)).left.Etale)
    [AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).left]
    [AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).left]
    (u_rel : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).left
      (((weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
          (weilProjectiveSpaceOver k 1).hom)).obj V).left))
    (hEt_urel : AlgebraicGeometry.Etale u_rel)
    (hu_rel_snd : CategoryTheory.CategoryStruct.comp u_rel
      (((weilEtaleSitePullback
        (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
          (weilProjectiveSpaceOver k 1).hom)).obj V).hom) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (δ + 1)).left).obj U).hom)
    (hm1 : ∀ b : ℕ, 3 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
            (weilProjectiveSpaceOver k 1).hom) b
          (weilEtaleLocalTorsionSheaf (weilPolyP1Over k (δ + 1)).left ℓ U)))
    (hm2 : ∀ b : ℕ, 3 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst
            (((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).hom)
            (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
              (weilProjectiveSpaceOver k 1).hom)) b
          (weilEtaleLocalTorsionSheaf
            (((weilEtaleSitePullback
              (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
                (weilProjectiveSpaceOver k 1).hom)).obj V).left) ℓ
            (CategoryTheory.MorphismProperty.Over.mk ⊤ u_rel hEt_urel))))
    (hm3 : CategoryTheory.IsIso
      (weilPolyP1HigherDirectImageMap
        (CategoryTheory.Limits.pullback.fst
          (((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k δ).left).obj V).hom)
          (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
            (weilProjectiveSpaceOver k 1).hom)) 2
        (weilEtaleLocalTorsionCounit
          (((weilEtaleSitePullback
            (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
              (weilProjectiveSpaceOver k 1).hom)).obj V).left) ℓ
          (CategoryTheory.MorphismProperty.Over.mk ⊤ u_rel hEt_urel))))
    (hm4 : ∀ (σ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) (weilPolyP1Over k δ).left),
      CategoryTheory.CategoryStruct.comp σ (weilPolyP1Over k δ).hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      ∀ [_hc : (weilEtaleSitePullback σ).IsContinuous
          (weilPolyP1Over k δ).left.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology]
        [_hr : ((weilEtaleSitePullback σ).sheafPushforwardContinuous AddCommGrpCat.{u}
          (weilPolyP1Over k δ).left.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology).IsRightAdjoint],
        let pb_σ := (weilEtaleSitePullback σ).sheafPullback AddCommGrpCat.{u}
          (weilPolyP1Over k δ).left.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
        let T_k := weilEtaleIdTerminal (AlgebraicGeometry.Spec (CommRingCat.of k))
        Finite ↑((pb_σ.obj (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
            (weilProjectiveSpaceOver k 1).hom) 2
          (weilEtaleLocalTorsionSheaf (weilPolyP1Over k (δ + 1)).left ℓ U))).obj.obj
          (Opposite.op T_k)) ∧
        Nat.card ↑((pb_σ.obj (weilEtaleHigherDirectImage
          (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
            (weilProjectiveSpaceOver k 1).hom) 2
          (weilEtaleLocalTorsionSheaf (weilPolyP1Over k (δ + 1)).left ℓ U))).obj.obj
          (Opposite.op T_k)) =
          Nat.card ↑((pb_σ.obj
            (weilEtaleLocalTorsionSheaf (weilPolyP1Over k δ).left ℓ V)).obj.obj
            (Opposite.op T_k)))
    (r : ℕ) (hr : 1 ≤ r) :
    let π_fst := CategoryTheory.Limits.pullback.fst (weilPolyP1Over k δ).hom
      (weilProjectiveSpaceOver k 1).hom
    (∀ b : ℕ, 3 ≤ b →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage π_fst b
          (weilEtaleLocalTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) U))) ∧
    ∃ e_LV : CategoryTheory.Iso
        (weilEtaleLocalTorsionSheaf (weilPolyP1Over k δ).left (ℓ ^ r) V)
        (weilEtaleHigherDirectImage π_fst 2
          (weilEtaleLocalTorsionSheaf (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) U)),
      CategoryTheory.CategoryStruct.comp e_LV.hom
        (CategoryTheory.CategoryStruct.comp
          (weilPolyP1HigherDirectImageMap π_fst 2
            (weilEtaleLocalTorsionCounit (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) U))
          (Tr_rel δ r)) =
        weilEtaleLocalTorsionCounit (weilPolyP1Over k δ).left (ℓ ^ r) V :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P1_ov := weilProjectiveSpaceOver k 1
  let P1 : AlgebraicGeometry.Scheme.{u} := P1_ov.left
  let Pd_ov := weilPolyP1Over k δ
  let Pd : AlgebraicGeometry.Scheme.{u} := Pd_ov.left
  let Pd_succ_ov := weilPolyP1Over k (δ + 1)
  let X_succ : AlgebraicGeometry.Scheme.{u} := Pd_succ_ov.left
  let π_fst : Quiver.Hom X_succ Pd := CategoryTheory.Limits.pullback.fst Pd_ov.hom P1_ov.hom
  let π_snd : Quiver.Hom X_succ P1 := CategoryTheory.Limits.pullback.snd Pd_ov.hom P1_ov.hom
  let A : ℕ → AddCommGrpCat.{u} :=
    fun m => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C_δ := CategoryTheory.constantSheaf Pd.smallEtaleTopology AddCommGrpCat.{u}
  let C_Xsucc := CategoryTheory.constantSheaf X_succ.smallEtaleTopology AddCommGrpCat.{u}
  let mapCoeff : ∀ {m₁ m₂ : ℕ}, Quiver.Hom (A m₁) (A m₂) →
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale),
        Quiver.Hom (weilEtaleLocalTorsionSheaf Z m₁ W) (weilEtaleLocalTorsionSheaf Z m₂ W) :=
    fun {_m₁ m₂} φ Z W =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp φ
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf Z m₂ W))))
  obtain ⟨⟨hR_id, hR_comp, hR_nsmul, hC_nsmul, hMap_id, hMap_counit⟩, hR_exact, hBock⟩ :=
    weil_etale_higherDirectImage_bockstein_exact_package.{u} ℓ

  
  let T_δ : Pd.Etale := weilEtaleIdTerminal.{u} Pd
  let hT_δ : CategoryTheory.Limits.IsTerminal T_δ := weilEtaleIdTerminalIsTerminal.{u} Pd
  let T_top : X_succ.Etale := (weilEtaleSitePullback π_fst).obj T_δ
  have hT_top : CategoryTheory.Limits.IsTerminal T_top := by
    refine CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W =>
        let w_hom : Quiver.Hom W.left X_succ := W.hom
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift
            (CategoryTheory.CategoryStruct.comp w_hom π_fst) w_hom
            (CategoryTheory.Category.comp_id _))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          trivial)
      (fun W m => ?_)
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · have hsnd : CategoryTheory.CategoryStruct.comp m.left
          (CategoryTheory.Limits.pullback.snd T_δ.hom π_fst) = W.hom :=
        CategoryTheory.MorphismProperty.Over.w m
      apply CategoryTheory.Limits.pullback.hom_ext
      · have h1 : CategoryTheory.CategoryStruct.comp m.left
            (CategoryTheory.Limits.pullback.fst T_δ.hom π_fst) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp m.left
              (CategoryTheory.Limits.pullback.fst T_δ.hom π_fst))
            T_δ.hom :=
          (CategoryTheory.Category.comp_id _).symm
        have h2 : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp m.left
              (CategoryTheory.Limits.pullback.fst T_δ.hom π_fst))
            T_δ.hom =
          CategoryTheory.CategoryStruct.comp m.left
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst T_δ.hom π_fst) T_δ.hom) :=
          CategoryTheory.Category.assoc _ _ _
        have h3 : CategoryTheory.CategoryStruct.comp m.left
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.fst T_δ.hom π_fst) T_δ.hom) =
          CategoryTheory.CategoryStruct.comp m.left
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd T_δ.hom π_fst) π_fst) :=
          congrArg (CategoryTheory.CategoryStruct.comp m.left)
            CategoryTheory.Limits.pullback.condition
        have h4 : CategoryTheory.CategoryStruct.comp m.left
            (CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd T_δ.hom π_fst) π_fst) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp m.left
              (CategoryTheory.Limits.pullback.snd T_δ.hom π_fst)) π_fst :=
          (CategoryTheory.Category.assoc _ _ _).symm
        have h5 : CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp m.left
              (CategoryTheory.Limits.pullback.snd T_δ.hom π_fst)) π_fst =
          CategoryTheory.CategoryStruct.comp W.hom π_fst :=
          congrArg (fun k => CategoryTheory.CategoryStruct.comp k π_fst) hsnd
        exact (h1.trans (h2.trans (h3.trans (h4.trans h5)))).trans
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
      · exact hsnd.trans (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
    · exact Subsingleton.elim _ _

  
  have hA_ext : ∀ (n : ℕ) {M : AddCommGrpCat.{u}} (g₁ g₂ : Quiver.Hom (A (ℓ ^ n)) M),
      g₁ (ULift.up 1) = g₂ (ULift.up 1) → g₁ = g₂ := by
    intro n M g₁ g₂ h1
    have _ : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hPrime.ne_zero⟩
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro (x : ULift.{u, 0} (ZMod (ℓ ^ n)))
    have hx : x = x.down.val • (ULift.up (1 : ZMod (ℓ ^ n))) := by
      apply ULift.ext
      change x.down = x.down.val • (1 : ZMod (ℓ ^ n))
      rw [nsmul_one, ZMod.natCast_zmod_val]
    calc
      g₁.hom x = g₁.hom (x.down.val • ULift.up 1) := congrArg g₁.hom hx
      _ = x.down.val • g₁.hom (ULift.up 1) := map_nsmul g₁.hom _ _
      _ = x.down.val • g₂.hom (ULift.up 1) := congrArg (x.down.val • ·) h1
      _ = g₂.hom (x.down.val • ULift.up 1) := (map_nsmul g₂.hom _ _).symm
      _ = g₂.hom x := congrArg g₂.hom hx.symm

  let π_step : ∀ k_exp : ℕ, Quiver.Hom (A (ℓ ^ (k_exp + 1))) (A (ℓ ^ k_exp)) :=
    fun k_exp =>
      AddCommGrpCat.uliftFunctor.{u, 0}.map
        (AddCommGrpCat.ofHom
          (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k_exp)) (ZMod (ℓ ^ k_exp))).toAddMonoidHom)
  obtain ⟨hPull_ex, _, _, hPull_trans, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  let p_ρ : ∀ m : ℕ, weilEtaleTorsionH P1 (ℓ ^ m) 2 →+ weilEtaleTorsionH X_succ (ℓ ^ m) 2 :=
    fun m => Classical.choose (hPull_ex π_snd (ℓ ^ m) 2)
  have hp_ρ : ∀ m : ℕ, WeilIsTorsionEtalePullback π_snd (ℓ ^ m) 2 (p_ρ m) :=
    fun m => Classical.choose_spec (hPull_ex π_snd (ℓ ^ m) 2)
  let adj_δ := CategoryTheory.constantSheafAdj Pd.smallEtaleTopology AddCommGrpCat.{u} hT_δ

  have hγ_step : ∀ k_exp : ℕ,
      CategoryTheory.CategoryStruct.comp (C_δ.map (π_step k_exp)) (γ_rel δ k_exp) =
        CategoryTheory.CategoryStruct.comp (γ_rel δ (k_exp + 1))
          (weilPolyP1HigherDirectImageMap π_fst 2 (C_Xsucc.map (π_step k_exp))) := by
    intro k_exp
    apply (adj_δ.homEquiv (A (ℓ ^ (k_exp + 1)))
      (weilEtaleHigherDirectImage π_fst 2 (weilEtaleTorsionSheaf X_succ (ℓ ^ k_exp)))).injective
    apply hA_ext (k_exp + 1)
    have h_lhs_equiv :
        (adj_δ.homEquiv _ _ (C_δ.map (π_step k_exp) ≫ γ_rel δ k_exp)) =
          π_step k_exp ≫ adj_δ.homEquiv _ _ (γ_rel δ k_exp) :=
      adj_δ.homEquiv_naturality_left (π_step k_exp) (γ_rel δ k_exp)
    have h_rhs_equiv :
        (adj_δ.homEquiv _ _ (γ_rel δ (k_exp + 1) ≫
            weilPolyP1HigherDirectImageMap π_fst 2 (C_Xsucc.map (π_step k_exp)))) =
          adj_δ.homEquiv _ _ (γ_rel δ (k_exp + 1)) ≫
            ((CategoryTheory.sheafSections Pd.smallEtaleTopology AddCommGrpCat.{u}).obj
              (Opposite.op T_δ)).map
              (weilPolyP1HigherDirectImageMap π_fst 2 (C_Xsucc.map (π_step k_exp))) :=
      adj_δ.homEquiv_naturality_right (γ_rel δ (k_exp + 1))
        (weilPolyP1HigherDirectImageMap π_fst 2 (C_Xsucc.map (π_step k_exp)))
    have hπ_one : (π_step k_exp) (ULift.up 1) = ULift.up 1 := by
      apply ULift.ext
      exact map_one (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k_exp)) (ZMod (ℓ ^ k_exp)))
    have h_char_k := (hγ_char k_exp (p_ρ k_exp) (hp_ρ k_exp)).2 T_δ hT_δ hT_top
    have h_char_succ :=
      (hγ_char (k_exp + 1) (p_ρ (k_exp + 1)) (hp_ρ (k_exp + 1))).2 T_δ hT_δ hT_top
    let Q_succ := CategoryTheory.Sheaf.cohomologyPresheaf
      (weilEtaleTorsionSheaf X_succ (ℓ ^ (k_exp + 1))) 2
    let Q_curr := CategoryTheory.Sheaf.cohomologyPresheaf
      (weilEtaleTorsionSheaf X_succ (ℓ ^ k_exp)) 2
    let P_succ := CategoryTheory.Functor.comp (weilEtaleSitePullback π_fst).op Q_succ
    let P_curr := CategoryTheory.Functor.comp (weilEtaleSitePullback π_fst).op Q_curr
    let α_pre : Quiver.Hom P_succ P_curr :=
      CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback π_fst).op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X_succ.smallEtaleTopology 2).map
          (C_Xsucc.map (π_step k_exp)))
    let η_sh := (CategoryTheory.sheafificationAdjunction Pd.smallEtaleTopology
      AddCommGrpCat.{u}).unit
    have h_unit_nat :
        CategoryTheory.CategoryStruct.comp
          ((η_sh.app P_succ).app (Opposite.op T_δ))
          (((CategoryTheory.presheafToSheaf Pd.smallEtaleTopology AddCommGrpCat.{u}).map
            α_pre).hom.app (Opposite.op T_δ)) =
        CategoryTheory.CategoryStruct.comp
          (α_pre.app (Opposite.op T_δ))
          ((η_sh.app P_curr).app (Opposite.op T_δ)) := by
      have h1 := η_sh.naturality α_pre
      exact congrArg (fun ν => ν.app (Opposite.op T_δ)) h1.symm
    have h_eval_nat := congrArg
      (fun f => f (weilPolyP1CohomologyTermToPresheaf X_succ T_top hT_top
        (weilEtaleTorsionSheaf X_succ (ℓ ^ (k_exp + 1))) 2
        (p_ρ (k_exp + 1) (η (k_exp + 1)))))
      h_unit_nat
    have h_trans_eq :
        weilEtaleTorsionTransition X_succ ℓ k_exp 2 (p_ρ (k_exp + 1) (η (k_exp + 1))) =
          p_ρ k_exp (η k_exp) := by
      have hc := DFunLike.congr_fun
        (hPull_trans π_snd ℓ k_exp 2 (p_ρ (k_exp + 1)) (p_ρ k_exp)
          (hp_ρ (k_exp + 1)) (hp_ρ k_exp))
        (η (k_exp + 1))
      change (weilEtaleTorsionTransition X_succ ℓ k_exp 2) ((p_ρ (k_exp + 1)) (η (k_exp + 1))) =
        (p_ρ k_exp) ((weilEtaleTorsionTransition P1 ℓ k_exp 2) (η (k_exp + 1))) at hc
      rwa [hη_trans k_exp] at hc
    have h_ext_assoc :
