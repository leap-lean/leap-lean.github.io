      by_contra hne
      let u₁ : (i : I) → Ai i := fun i => if i = i₁ then 1 else 0
      let u₂ : (i : I) → Ai i := fun i => if i = i₂ then 1 else 0
      have hu_mul : u₁ * u₂ = 0 := by
        funext i
        change (if i = i₁ then (1 : Ai i) else 0) * (if i = i₂ then (1 : Ai i) else 0) = 0
        split_ifs with h₁ h₂
        · exact absurd (h₁.symm.trans h₂) hne
