    fun x hx => hRatLift V_norm ι_V hClV S₀ hClosed_S₀ hDim_S₀ x hx

  obtain ⟨q_sec, hq_sec_hom, pt₀, hpt₀⟩ := hPt_lift x_star hx_star_S₀
  have hq_sec_range :
