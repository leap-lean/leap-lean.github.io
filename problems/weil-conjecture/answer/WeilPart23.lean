theorem weil_abelian_kummer_divisor_pullback_h1_bridge (m : ℕ) :
    ∃ delta_sys :
      ∀ (S : AlgebraicGeometry.Scheme.{u})
        (G K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (ι_kum : weilEtaleTorsionSheaf S m ⟶ G)
        (h0_kum : ι_kum ≫ (m • CategoryTheory.CategoryStruct.id G) = 0),
        (CategoryTheory.ShortComplex.mk ι_kum
          (m • CategoryTheory.CategoryStruct.id G) h0_kum).ShortExact →
        ∀ (ι_gm : G ⟶ K) (div_mor : K ⟶ D) (h0_div : ι_gm ≫ div_mor = 0),
          (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact →
          ∀ [CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id D)]
            [Subsingleton (K.H 1)]
            (κ : K.H 0),
            (∃ δ : D.H 0,
              κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ) →
            weilEtaleTorsionH S m 1,
      (∀ (S : AlgebraicGeometry.Scheme.{u})
         (G K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
         (ι_kum : weilEtaleTorsionSheaf S m ⟶ G)
         (h0_kum : ι_kum ≫ (m • CategoryTheory.CategoryStruct.id G) = 0)
         (hSE_kum : (CategoryTheory.ShortComplex.mk ι_kum
           (m • CategoryTheory.CategoryStruct.id G) h0_kum).ShortExact)
         (ι_gm : G ⟶ K) (div_mor : K ⟶ D) (h0_div : ι_gm ≫ div_mor = 0)
         (hSE_div : (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact)
         [CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id D)]
         [Subsingleton (K.H 1)],
        (∀ (κ₁ κ₂ : K.H 0)
           (hκ₁ : ∃ δ : D.H 0,
             κ₁.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ)
           (hκ₂ : ∃ δ : D.H 0,
             κ₂.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ)
           (hκ₁₂ : ∃ δ : D.H 0,
             (κ₁ + κ₂).comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ),
          delta_sys S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div (κ₁ + κ₂) hκ₁₂ =
            delta_sys S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div κ₁ hκ₁ +
              delta_sys S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div κ₂ hκ₂) ∧
        (∀ γ : weilEtaleTorsionH S m 1,
          ∃ (κ : K.H 0)
            (hκ : ∃ δ : D.H 0,
              κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ),
            delta_sys S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div κ hκ = γ) ∧
        (∀ (κ : K.H 0)
           (hκ : ∃ δ : D.H 0,
             κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ),
          delta_sys S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div κ hκ = 0 ↔
            ∃ g : K.H 0, m • g = κ)) ∧
      (∀ (S₁ S₂ : AlgebraicGeometry.Scheme.{u})
         (G₁ K₁ D₁ : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u})
         (ι_kum₁ : weilEtaleTorsionSheaf S₁ m ⟶ G₁)
         (h0_kum₁ : ι_kum₁ ≫ (m • CategoryTheory.CategoryStruct.id G₁) = 0)
         (hSE_kum₁ : (CategoryTheory.ShortComplex.mk ι_kum₁
           (m • CategoryTheory.CategoryStruct.id G₁) h0_kum₁).ShortExact)
         (ι_gm₁ : G₁ ⟶ K₁) (div_mor₁ : K₁ ⟶ D₁) (h0_div₁ : ι_gm₁ ≫ div_mor₁ = 0)
         (hSE_div₁ : (CategoryTheory.ShortComplex.mk ι_gm₁ div_mor₁ h0_div₁).ShortExact)
         [CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id D₁)]
         [Subsingleton (K₁.H 1)]
         (G₂ K₂ D₂ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u})
         (ι_kum₂ : weilEtaleTorsionSheaf S₂ m ⟶ G₂)
         (h0_kum₂ : ι_kum₂ ≫ (m • CategoryTheory.CategoryStruct.id G₂) = 0)
         (hSE_kum₂ : (CategoryTheory.ShortComplex.mk ι_kum₂
           (m • CategoryTheory.CategoryStruct.id G₂) h0_kum₂).ShortExact)
         (ι_gm₂ : G₂ ⟶ K₂) (div_mor₂ : K₂ ⟶ D₂) (h0_div₂ : ι_gm₂ ≫ div_mor₂ = 0)
         (hSE_div₂ : (CategoryTheory.ShortComplex.mk ι_gm₂ div_mor₂ h0_div₂).ShortExact)
         [CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id D₂)]
         [Subsingleton (K₂.H 1)]
         (h : S₁ ⟶ S₂)
         (p_h : weilEtaleTorsionH S₂ m 1 →+ weilEtaleTorsionH S₁ m 1),
        WeilIsTorsionEtalePullback h m 1 p_h →
        ∀ (κ₂ : K₂.H 0)
          (hκ₂ : ∃ δ₂ : D₂.H 0,
            κ₂.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor₂) (Nat.add_zero 0) = m • δ₂)
          (κ₁ : K₁.H 0)
          (hκ₁ : ∃ δ₁ : D₁.H 0,
            κ₁.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor₁) (Nat.add_zero 0) = m • δ₁),
          (let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
           let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
           let Fℤ₁ := (CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
           let Fℤ₂ := (CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
           ∀ (hCont : (weilEtaleSitePullback h).IsContinuous
               S₂.smallEtaleTopology S₁.smallEtaleTopology)
             (hAdj : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
               (weilEtaleSitePullback h) AddCommGrpCat.{u} _
               S₂.smallEtaleTopology S₁.smallEtaleTopology hCont).IsRightAdjoint),
             letI := hCont
             letI := hAdj
             let P_pull := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
               S₂.smallEtaleTopology S₁.smallEtaleTopology
             ∀ (hAdd : P_pull.Additive)
               (hLim : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
               (hColim : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
               (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
               (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
               (ιℤ : Fℤ₁ ⟶ P_pull.obj Fℤ₂),
               ιℤ ≫ weilEtaleConstPullbackHom h hT₁ hT₂ Aℤ = CategoryTheory.CategoryStruct.id Fℤ₁ →
               weilEtaleConstPullbackHom h hT₁ hT₂ Aℤ ≫ ιℤ =
                 CategoryTheory.CategoryStruct.id (P_pull.obj Fℤ₂) →
               ∃ (β_G : P_pull.obj G₂ ⟶ G₁) (β_K : P_pull.obj K₂ ⟶ K₁),
                 P_pull.map ι_kum₂ ≫ β_G = weilEtaleConstPullbackHom h hT₁ hT₂ AM ≫ ι_kum₁ ∧
                 P_pull.map ι_gm₂ ≫ β_K = β_G ≫ ι_gm₁ ∧
                 κ₁ = (CategoryTheory.Abelian.Ext.mk₀ β_K).postcomp Fℤ₁ (Nat.add_zero 0)
                   ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
                     ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull
                       hAdd hLim hColim _ _ Fℤ₂ K₂ 0) κ₂)
                     (Nat.zero_add 0))) →
          p_h (delta_sys S₂ G₂ K₂ D₂ ι_kum₂ h0_kum₂ hSE_kum₂ ι_gm₂ div_mor₂ h0_div₂ hSE_div₂ κ₂ hκ₂) =
            delta_sys S₁ G₁ K₁ D₁ ι_kum₁ h0_kum₁ hSE_kum₁ ι_gm₁ div_mor₁ h0_div₁ hSE_div₁ κ₁ hκ₁) :=
by
  classical
  have nsmul_id_comm : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}} (u_mor : X ⟶ Y),
      (m • CategoryTheory.CategoryStruct.id X) ≫ u_mor =
        u_mor ≫ (m • CategoryTheory.CategoryStruct.id Y) := by
    intro S X Y u_mor
    rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
      CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]

  have addEquiv₀_mk₀ : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}} (f : X ⟶ Y),
      CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ f) = f := by
    intro S X Y f
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply f

  have addEquiv₀_comp_mk₀ : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y Z : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (x : CategoryTheory.Abelian.Ext X Y 0) (u_mor : Y ⟶ Z),
      CategoryTheory.Abelian.Ext.addEquiv₀
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ u_mor) (Nat.add_zero 0)) =
        CategoryTheory.Abelian.Ext.addEquiv₀ x ≫ u_mor := by
    intro S X Y Z x u_mor
    conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x]
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    exact addEquiv₀_mk₀ _

  have mk₀_nsmul_eq : ∀ {S : AlgebraicGeometry.Scheme.{u}}
      {X Y : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}} (f : X ⟶ Y),
      CategoryTheory.Abelian.Ext.mk₀ (m • f) = m • CategoryTheory.Abelian.Ext.mk₀ f := by
    intro S X Y f
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
    exact map_nsmul CategoryTheory.Abelian.Ext.addEquiv₀.symm m f

  let E_obj := fun (S : AlgebraicGeometry.Scheme.{u})
      (K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (div_mor : K ⟶ D) =>
    CategoryTheory.Limits.pullback div_mor (m • CategoryTheory.CategoryStruct.id D)

  let π₁_mor := fun (S : AlgebraicGeometry.Scheme.{u})
      (K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (div_mor : K ⟶ D) =>
    CategoryTheory.Limits.pullback.fst div_mor (m • CategoryTheory.CategoryStruct.id D)

  let π₂_mor := fun (S : AlgebraicGeometry.Scheme.{u})
      (K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (div_mor : K ⟶ D) =>
    CategoryTheory.Limits.pullback.snd div_mor (m • CategoryTheory.CategoryStruct.id D)

  let ι_E_mor := fun (S : AlgebraicGeometry.Scheme.{u})
      (G K : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (ι_kum : weilEtaleTorsionSheaf S m ⟶ G) (ι_gm : G ⟶ K) =>
    ι_kum ≫ ι_gm

  let ψ_E_mor := fun (S : AlgebraicGeometry.Scheme.{u})
      (K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (div_mor : K ⟶ D) =>
    CategoryTheory.Limits.pullback.lift (m • CategoryTheory.CategoryStruct.id K) div_mor
      (nsmul_id_comm div_mor)

  have h0_E_pf : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (ι_kum : weilEtaleTorsionSheaf S m ⟶ G)
      (h0_kum : ι_kum ≫ (m • CategoryTheory.CategoryStruct.id G) = 0)
      (ι_gm : G ⟶ K) (div_mor : K ⟶ D) (h0_div : ι_gm ≫ div_mor = 0),
      ι_E_mor S G K ι_kum ι_gm ≫ ψ_E_mor S K D div_mor = 0 := by
    intro S G K D ι_kum h0_kum ι_gm div_mor h0_div
    apply CategoryTheory.Limits.pullback.hom_ext
    · dsimp only [ι_E_mor, ψ_E_mor]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.assoc, ← nsmul_id_comm ι_gm,
        ← CategoryTheory.Category.assoc, h0_kum,
        CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
    · dsimp only [ι_E_mor, ψ_E_mor]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Category.assoc, h0_div,
        CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]

  let S_E_sc := fun (S : AlgebraicGeometry.Scheme.{u})
      (G K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (ι_kum : weilEtaleTorsionSheaf S m ⟶ G)
      (h0_kum : ι_kum ≫ (m • CategoryTheory.CategoryStruct.id G) = 0)
      (ι_gm : G ⟶ K) (div_mor : K ⟶ D) (h0_div : ι_gm ≫ div_mor = 0) =>
    CategoryTheory.ShortComplex.mk (ι_E_mor S G K ι_kum ι_gm) (ψ_E_mor S K D div_mor)
      (h0_E_pf S G K D ι_kum h0_kum ι_gm div_mor h0_div)

  have hSE_E : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (ι_kum : weilEtaleTorsionSheaf S m ⟶ G)
      (h0_kum : ι_kum ≫ (m • CategoryTheory.CategoryStruct.id G) = 0)
      (hSE_kum : (CategoryTheory.ShortComplex.mk ι_kum
        (m • CategoryTheory.CategoryStruct.id G) h0_kum).ShortExact)
      (ι_gm : G ⟶ K) (div_mor : K ⟶ D) (h0_div : ι_gm ≫ div_mor = 0)
      (hSE_div : (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact),
      (S_E_sc S G K D ι_kum h0_kum ι_gm div_mor h0_div).ShortExact := by
    intro S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div
    have hMono_kum : CategoryTheory.Mono ι_kum := hSE_kum.mono_f
    have hMono_gm : CategoryTheory.Mono ι_gm := hSE_div.mono_f
    have hEpi_kum : CategoryTheory.Epi (m • CategoryTheory.CategoryStruct.id G) := hSE_kum.epi_g
    have hEpi_div : CategoryTheory.Epi div_mor := hSE_div.epi_g
    have hMono_ιE : CategoryTheory.Mono (ι_E_mor S G K ι_kum ι_gm) :=
      @CategoryTheory.mono_comp _ _ _ _ _ ι_kum hMono_kum ι_gm hMono_gm
    have hLift_ex : ∀ {W : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (τ : W ⟶ K), τ ≫ ψ_E_mor S K D div_mor = 0 →
        ∃ τ₀ : W ⟶ weilEtaleTorsionSheaf S m, τ₀ ≫ ι_E_mor S G K ι_kum ι_gm = τ := by
      intro W τ hτ
      have hτ_div : τ ≫ div_mor = 0 := by
        calc
          τ ≫ div_mor = τ ≫ (ψ_E_mor S K D div_mor ≫ π₂_mor S K D div_mor) := by
            rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = (τ ≫ ψ_E_mor S K D div_mor) ≫ π₂_mor S K D div_mor :=
            (CategoryTheory.Category.assoc _ _ _).symm
          _ = 0 := by rw [hτ, CategoryTheory.Limits.zero_comp]
      obtain ⟨τ₁, hτ₁⟩ := CategoryTheory.Limits.KernelFork.IsLimit.lift' hSE_div.fIsKernel τ hτ_div
      change τ₁ ≫ ι_gm = τ at hτ₁
      have hτ₁_m : τ₁ ≫ (m • CategoryTheory.CategoryStruct.id G) = 0 := by
        apply (@CategoryTheory.cancel_mono _ _ _ _ _ ι_gm hMono_gm _ _).mp
        calc
          (τ₁ ≫ (m • CategoryTheory.CategoryStruct.id G)) ≫ ι_gm
            = τ₁ ≫ ((m • CategoryTheory.CategoryStruct.id G) ≫ ι_gm) :=
              CategoryTheory.Category.assoc _ _ _
          _ = τ₁ ≫ (ι_gm ≫ (m • CategoryTheory.CategoryStruct.id K)) := by
              rw [nsmul_id_comm ι_gm]
          _ = (τ₁ ≫ ι_gm) ≫ (m • CategoryTheory.CategoryStruct.id K) :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = τ ≫ (ψ_E_mor S K D div_mor ≫ π₁_mor S K D div_mor) := by
              rw [hτ₁, CategoryTheory.Limits.pullback.lift_fst]
          _ = (τ ≫ ψ_E_mor S K D div_mor) ≫ π₁_mor S K D div_mor :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = 0 ≫ ι_gm := by
              rw [hτ, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
      obtain ⟨τ₀, hτ₀⟩ := CategoryTheory.Limits.KernelFork.IsLimit.lift' hSE_kum.fIsKernel τ₁ hτ₁_m
      change τ₀ ≫ ι_kum = τ₁ at hτ₀
      refine ⟨τ₀, ?_⟩
      dsimp only [ι_E_mor]
      rw [← CategoryTheory.Category.assoc, hτ₀, hτ₁]
    have hKer_E : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι
          (S_E_sc S G K D ι_kum h0_kum ι_gm div_mor h0_div).f
          (S_E_sc S G K D ι_kum h0_kum ι_gm div_mor h0_div).zero) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
        (fun τ hτ => Classical.choose (hLift_ex τ hτ))
        (fun τ hτ => Classical.choose_spec (hLift_ex τ hτ))
        (fun τ hτ u_m hu_m =>
          (@CategoryTheory.cancel_mono _ _ _ _ _ (ι_E_mor S G K ι_kum ι_gm) hMono_ιE _ _).mp
            (hu_m.trans (Classical.choose_spec (hLift_ex τ hτ)).symm))
    have hExact_E : (S_E_sc S G K D ι_kum h0_kum ι_gm div_mor h0_div).Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer_E
    have hEpi_ψE : CategoryTheory.Epi (ψ_E_mor S K D div_mor) := by
      apply CategoryTheory.Preadditive.epi_of_cancel_zero
      intro Z α hα
      let u₁ := CategoryTheory.Limits.pullback.fst (π₂_mor S K D div_mor) div_mor
      let k₁ := CategoryTheory.Limits.pullback.snd (π₂_mor S K D div_mor) div_mor
      have hEpi_u₁ : CategoryTheory.Epi u₁ :=
        @CategoryTheory.Abelian.epi_pullback_of_epi_g _ _ _ _ _ _ _
          (π₂_mor S K D div_mor) div_mor hEpi_div
      let d₁ := u₁ ≫ π₁_mor S K D div_mor - k₁ ≫ (m • CategoryTheory.CategoryStruct.id K)
      have hd₁ : d₁ ≫ div_mor = 0 := by
        dsimp only [d₁, π₁_mor]
        rw [CategoryTheory.Preadditive.sub_comp, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          nsmul_id_comm div_mor, ← CategoryTheory.Category.assoc u₁,
          ← CategoryTheory.Category.assoc k₁,
          CategoryTheory.Limits.pullback.condition (f := π₂_mor S K D div_mor) (g := div_mor),
          sub_self]
      obtain ⟨v₁, hv₁⟩ := CategoryTheory.Limits.KernelFork.IsLimit.lift' hSE_div.fIsKernel d₁ hd₁
      change v₁ ≫ ι_gm = d₁ at hv₁
      let u₂ := CategoryTheory.Limits.pullback.fst v₁ (m • CategoryTheory.CategoryStruct.id G)
      let w := CategoryTheory.Limits.pullback.snd v₁ (m • CategoryTheory.CategoryStruct.id G)
      have hEpi_u₂ : CategoryTheory.Epi u₂ :=
        @CategoryTheory.Abelian.epi_pullback_of_epi_g _ _ _ _ _ _ _
          v₁ (m • CategoryTheory.CategoryStruct.id G) hEpi_kum
      let g₂ := u₂ ≫ k₁ + w ≫ ι_gm
      have hg₂ : g₂ ≫ ψ_E_mor S K D div_mor = u₂ ≫ u₁ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp only [g₂, ψ_E_mor, π₁_mor]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc u₂,
            CategoryTheory.Category.assoc w, ← nsmul_id_comm ι_gm,
            ← CategoryTheory.Category.assoc w,
            ← CategoryTheory.Limits.pullback.condition (f := v₁)
              (g := m • CategoryTheory.CategoryStruct.id G),
            CategoryTheory.Category.assoc u₂ v₁, hv₁]
          dsimp only [d₁, π₁_mor]
          rw [← CategoryTheory.Preadditive.comp_add]
          have hsub : k₁ ≫ (m • CategoryTheory.CategoryStruct.id K) +
              (u₁ ≫ CategoryTheory.Limits.pullback.fst div_mor
                  (m • CategoryTheory.CategoryStruct.id D) -
                k₁ ≫ (m • CategoryTheory.CategoryStruct.id K)) =
              u₁ ≫ CategoryTheory.Limits.pullback.fst div_mor
                (m • CategoryTheory.CategoryStruct.id D) := by abel
          rw [hsub, CategoryTheory.Category.assoc]
        · dsimp only [g₂, ψ_E_mor, π₂_mor]
          rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc u₂,
            ← CategoryTheory.Limits.pullback.condition (f := π₂_mor S K D div_mor) (g := div_mor),
            CategoryTheory.Category.assoc w, h0_div, CategoryTheory.Limits.comp_zero, add_zero,
            CategoryTheory.Category.assoc]
      have hEpi_u₂u₁ : CategoryTheory.Epi (u₂ ≫ u₁) :=
        @CategoryTheory.epi_comp _ _ _ _ _ u₂ hEpi_u₂ u₁ hEpi_u₁
      apply (@CategoryTheory.cancel_epi _ _ _ _ _ (u₂ ≫ u₁) hEpi_u₂u₁ _ _).mp
      calc
        (u₂ ≫ u₁) ≫ α = (g₂ ≫ ψ_E_mor S K D div_mor) ≫ α := by rw [hg₂]
        _ = g₂ ≫ (ψ_E_mor S K D div_mor ≫ α) := CategoryTheory.Category.assoc _ _ _
        _ = (u₂ ≫ u₁) ≫ 0 := by
          rw [hα, CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.comp_zero]
    exact CategoryTheory.ShortComplex.ShortExact.mk' hExact_E hMono_ιE hEpi_ψE

  let f_E_mor := fun (S : AlgebraicGeometry.Scheme.{u})
      (K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (div_mor : K ⟶ D) (κ : K.H 0)
      (hκ : ∃ δ : D.H 0,
        κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ) =>
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Abelian.Ext.addEquiv₀ κ)
      (CategoryTheory.Abelian.Ext.addEquiv₀ (Classical.choose hκ))
      (calc
        CategoryTheory.Abelian.Ext.addEquiv₀ κ ≫ div_mor
          = CategoryTheory.Abelian.Ext.addEquiv₀
              (κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0)) :=
            (addEquiv₀_comp_mk₀ κ div_mor).symm
        _ = CategoryTheory.Abelian.Ext.addEquiv₀ (m • Classical.choose hκ) :=
            congrArg CategoryTheory.Abelian.Ext.addEquiv₀ (Classical.choose_spec hκ)
        _ = m • CategoryTheory.Abelian.Ext.addEquiv₀ (Classical.choose hκ) :=
            map_nsmul CategoryTheory.Abelian.Ext.addEquiv₀ m (Classical.choose hκ)
        _ = CategoryTheory.Abelian.Ext.addEquiv₀ (Classical.choose hκ) ≫
              (m • CategoryTheory.CategoryStruct.id D) := by
            rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id])

  have f_E_eq_of_fst : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (div_mor : K ⟶ D)
      [CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id D)]
      (κ : K.H 0)
      (hκ : ∃ δ : D.H 0,
        κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ)
      (g_E : ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))) ⟶ E_obj S K D div_mor),
      g_E ≫ π₁_mor S K D div_mor = CategoryTheory.Abelian.Ext.addEquiv₀ κ →
      g_E = f_E_mor S K D div_mor κ hκ := by
    intro S K D div_mor _ κ hκ g_E hg_E
    have hMono_π₁ : CategoryTheory.Mono (π₁_mor S K D div_mor) :=
      CategoryTheory.Limits.pullback.fst_of_mono
    exact (@CategoryTheory.cancel_mono _ _ _ _ _ (π₁_mor S K D div_mor) hMono_π₁ _ _).mp
      (hg_E.trans (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)

  let delta_sys :
      ∀ (S : AlgebraicGeometry.Scheme.{u})
        (G K D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (ι_kum : weilEtaleTorsionSheaf S m ⟶ G)
        (h0_kum : ι_kum ≫ (m • CategoryTheory.CategoryStruct.id G) = 0),
        (CategoryTheory.ShortComplex.mk ι_kum
          (m • CategoryTheory.CategoryStruct.id G) h0_kum).ShortExact →
        ∀ (ι_gm : G ⟶ K) (div_mor : K ⟶ D) (h0_div : ι_gm ≫ div_mor = 0),
          (CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div).ShortExact →
          ∀ [CategoryTheory.Mono (m • CategoryTheory.CategoryStruct.id D)]
            [Subsingleton (K.H 1)]
            (κ : K.H 0),
            (∃ δ : D.H 0,
              κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ) →
            weilEtaleTorsionH S m 1 :=
    fun S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div _ _ κ hκ =>
      (CategoryTheory.Abelian.Ext.mk₀ (f_E_mor S K D div_mor κ hκ)).comp
        (hSE_E S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div).extClass
        (Nat.zero_add 1)

  refine ⟨delta_sys, ?_, ?_⟩
  · intro S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div _ _
    refine ⟨?_, ?_, ?_⟩
    · intro κ₁ κ₂ hκ₁ hκ₂ hκ₁₂
      have hf_add : f_E_mor S K D div_mor (κ₁ + κ₂) hκ₁₂ =
          f_E_mor S K D div_mor κ₁ hκ₁ + f_E_mor S K D div_mor κ₂ hκ₂ := by
        symm
        apply f_E_eq_of_fst S K D div_mor (κ₁ + κ₂) hκ₁₂
        rw [CategoryTheory.Preadditive.add_comp,
          CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst,
          ← map_add]
      dsimp only [delta_sys]
      rw [hf_add, CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.add_comp]
    · intro γ
      let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      let hSE := hSE_E S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div
      have hγ0 : γ.comp
          (CategoryTheory.Abelian.Ext.mk₀ (S_E_sc S G K D ι_kum h0_kum ι_gm div_mor h0_div).f)
          (Nat.add_zero 1) = 0 :=
        Subsingleton.elim _ 0
      obtain ⟨e₀, he₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE γ hγ0 (Nat.zero_add 1)
      let e_hom : Fℤ ⟶ E_obj S K D div_mor := CategoryTheory.Abelian.Ext.addEquiv₀ e₀
      let κ : K.H 0 := CategoryTheory.Abelian.Ext.mk₀ (e_hom ≫ π₁_mor S K D div_mor)
      let δ : D.H 0 := CategoryTheory.Abelian.Ext.mk₀ (e_hom ≫ π₂_mor S K D div_mor)
      have hκ : ∃ δ' : D.H 0,
          κ.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor) (Nat.add_zero 0) = m • δ' := by
        refine ⟨δ, ?_⟩
        dsimp only [κ, δ, π₁_mor, π₂_mor]
        rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc,
          CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
          mk₀_nsmul_eq]
      refine ⟨κ, hκ, ?_⟩
      have hf_eq : f_E_mor S K D div_mor κ hκ = e_hom := by
        symm
        apply f_E_eq_of_fst S K D div_mor κ hκ
        exact (addEquiv₀_mk₀ _).symm
      dsimp only [delta_sys]
      rw [hf_eq]
      dsimp only [e_hom]
      rw [CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
      exact he₀
    · intro κ hκ
      let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.of (ULift.{u} ℤ))
      let hSE := hSE_E S G K D ι_kum h0_kum hSE_kum ι_gm div_mor h0_div hSE_div
      let f₀ := f_E_mor S K D div_mor κ hκ
      constructor
      · intro h0
        obtain ⟨g, hg⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hSE
            (CategoryTheory.Abelian.Ext.mk₀ f₀) (Nat.zero_add 1) h0
        refine ⟨g, CategoryTheory.Abelian.Ext.addEquiv₀.injective ?_⟩
        have hg_hom : CategoryTheory.Abelian.Ext.addEquiv₀ g ≫ ψ_E_mor S K D div_mor = f₀ := by
          calc
            CategoryTheory.Abelian.Ext.addEquiv₀ g ≫ ψ_E_mor S K D div_mor
              = CategoryTheory.Abelian.Ext.addEquiv₀
                  (g.comp (CategoryTheory.Abelian.Ext.mk₀ (ψ_E_mor S K D div_mor))
                    (Nat.add_zero 0)) := (addEquiv₀_comp_mk₀ g _).symm
            _ = CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ f₀) :=
                congrArg CategoryTheory.Abelian.Ext.addEquiv₀ hg
            _ = f₀ := addEquiv₀_mk₀ f₀
        calc
          CategoryTheory.Abelian.Ext.addEquiv₀ (m • g)
            = m • CategoryTheory.Abelian.Ext.addEquiv₀ g :=
              map_nsmul CategoryTheory.Abelian.Ext.addEquiv₀ m g
          _ = CategoryTheory.Abelian.Ext.addEquiv₀ g ≫ (m • CategoryTheory.CategoryStruct.id K) := by
              rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
          _ = CategoryTheory.Abelian.Ext.addEquiv₀ g ≫
                (ψ_E_mor S K D div_mor ≫ π₁_mor S K D div_mor) := by
              rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = (CategoryTheory.Abelian.Ext.addEquiv₀ g ≫ ψ_E_mor S K D div_mor) ≫
                π₁_mor S K D div_mor := (CategoryTheory.Category.assoc _ _ _).symm
          _ = f₀ ≫ π₁_mor S K D div_mor := by rw [hg_hom]
          _ = CategoryTheory.Abelian.Ext.addEquiv₀ κ := CategoryTheory.Limits.pullback.lift_fst _ _ _
      · rintro ⟨g, hg⟩
        let g_hom : Fℤ ⟶ K := CategoryTheory.Abelian.Ext.addEquiv₀ g
        have hf_eq : f₀ = g_hom ≫ ψ_E_mor S K D div_mor := by
          symm
          apply f_E_eq_of_fst S K D div_mor κ hκ
          calc
            (g_hom ≫ ψ_E_mor S K D div_mor) ≫ π₁_mor S K D div_mor
              = g_hom ≫ (ψ_E_mor S K D div_mor ≫ π₁_mor S K D div_mor) :=
                CategoryTheory.Category.assoc _ _ _
            _ = g_hom ≫ (m • CategoryTheory.CategoryStruct.id K) := by
                rw [CategoryTheory.Limits.pullback.lift_fst]
            _ = m • g_hom := by
                rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
            _ = CategoryTheory.Abelian.Ext.addEquiv₀ (m • g) :=
                (map_nsmul CategoryTheory.Abelian.Ext.addEquiv₀ m g).symm
            _ = CategoryTheory.Abelian.Ext.addEquiv₀ κ := by rw [hg]
        dsimp only [delta_sys]
        change (CategoryTheory.Abelian.Ext.mk₀ f₀).comp hSE.extClass (Nat.zero_add 1) = 0
        rw [hf_eq, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add 1),
          hSE.comp_extClass]
        exact CategoryTheory.Abelian.Ext.comp_zero _ _ _ _ _
  · intro S₁ S₂ G₁ K₁ D₁ ι_kum₁ h0_kum₁ hSE_kum₁ ι_gm₁ div_mor₁ h0_div₁ hSE_div₁ _ _
      G₂ K₂ D₂ ι_kum₂ h0_kum₂ hSE_kum₂ ι_gm₂ div_mor₂ h0_div₂ hSE_div₂ _ _
      h p_h hp_h κ₂ hκ₂ κ₁ hκ₁ h_compat
    rcases hp_h with
      ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hp_eq⟩
    let _ := hCont
    let _ := hAdj
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let Fℤ₁ := (CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let Fℤ₂ := (CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
    let FM₂ := weilEtaleTorsionSheaf S₂ m
    let P_pull := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology
    let _ : P_pull.Additive := hAdd
    let _ : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
    let _ : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
    have : P_pull.PreservesZeroMorphisms := inferInstance
    let πM := weilEtaleConstPullbackHom h hT₁ hT₂ AM
    obtain ⟨β_G, β_K, hβ_kum, hβ_gm, hκ₁_eq⟩ :=
      h_compat hCont hAdj hAdd hLim hColim T₁ hT₁ T₂ hT₂ ιℤ hιπ hπι
    let S_div₂ := CategoryTheory.ShortComplex.mk ι_gm₂ div_mor₂ h0_div₂
    have hSE_div₂_map : (S_div₂.map P_pull).ShortExact := hSE_div₂.map_of_exact P_pull
    have h_ann_div : (S_div₂.map P_pull).f ≫ (β_K ≫ div_mor₁) = 0 := by
      change P_pull.map ι_gm₂ ≫ (β_K ≫ div_mor₁) = 0
      rw [← CategoryTheory.Category.assoc, hβ_gm, CategoryTheory.Category.assoc,
        h0_div₁, CategoryTheory.Limits.comp_zero]
    obtain ⟨β_D, hβ_D⟩ :=
      CategoryTheory.Limits.CokernelCofork.IsColimit.desc'
        hSE_div₂_map.gIsCokernel (β_K ≫ div_mor₁) h_ann_div
    change P_pull.map div_mor₂ ≫ β_D = β_K ≫ div_mor₁ at hβ_D
    have hP_nsmul_D : P_pull.map (m • CategoryTheory.CategoryStruct.id D₂) ≫ β_D =
        β_D ≫ (m • CategoryTheory.CategoryStruct.id D₁) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      exact nsmul_id_comm β_D
    have hP_nsmul_K : P_pull.map (m • CategoryTheory.CategoryStruct.id K₂) ≫ β_K =
        β_K ≫ (m • CategoryTheory.CategoryStruct.id K₁) := by
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      exact nsmul_id_comm β_K
    have hβ_E_comm : (P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂) ≫ β_K) ≫ div_mor₁ =
        (P_pull.map (π₂_mor S₂ K₂ D₂ div_mor₂) ≫ β_D) ≫
          (m • CategoryTheory.CategoryStruct.id D₁) := by
      calc
        (P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂) ≫ β_K) ≫ div_mor₁
          = P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂) ≫ (β_K ≫ div_mor₁) :=
            CategoryTheory.Category.assoc _ _ _
        _ = P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂) ≫ (P_pull.map div_mor₂ ≫ β_D) := by
            rw [← hβ_D]
        _ = P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂ ≫ div_mor₂) ≫ β_D := by
            rw [← CategoryTheory.Category.assoc, ← P_pull.map_comp]
        _ = P_pull.map (π₂_mor S₂ K₂ D₂ div_mor₂ ≫
              (m • CategoryTheory.CategoryStruct.id D₂)) ≫ β_D := by
            dsimp only [π₁_mor, π₂_mor]
            rw [CategoryTheory.Limits.pullback.condition]
        _ = P_pull.map (π₂_mor S₂ K₂ D₂ div_mor₂) ≫
              (P_pull.map (m • CategoryTheory.CategoryStruct.id D₂) ≫ β_D) := by
            rw [P_pull.map_comp, CategoryTheory.Category.assoc]
        _ = (P_pull.map (π₂_mor S₂ K₂ D₂ div_mor₂) ≫ β_D) ≫
              (m • CategoryTheory.CategoryStruct.id D₁) := by
            rw [hP_nsmul_D, CategoryTheory.Category.assoc]
    let β_E : P_pull.obj (E_obj S₂ K₂ D₂ div_mor₂) ⟶ E_obj S₁ K₁ D₁ div_mor₁ :=
      CategoryTheory.Limits.pullback.lift
        (P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂) ≫ β_K)
        (P_pull.map (π₂_mor S₂ K₂ D₂ div_mor₂) ≫ β_D)
        hβ_E_comm
    let S_E₁ := S_E_sc S₁ G₁ K₁ D₁ ι_kum₁ h0_kum₁ ι_gm₁ div_mor₁ h0_div₁
    let S_E₂ := S_E_sc S₂ G₂ K₂ D₂ ι_kum₂ h0_kum₂ ι_gm₂ div_mor₂ h0_div₂
    let hSE₁ := hSE_E S₁ G₁ K₁ D₁ ι_kum₁ h0_kum₁ hSE_kum₁ ι_gm₁ div_mor₁ h0_div₁ hSE_div₁
    let hSE₂ := hSE_E S₂ G₂ K₂ D₂ ι_kum₂ h0_kum₂ hSE_kum₂ ι_gm₂ div_mor₂ h0_div₂ hSE_div₂
    have hSE₂_map : (S_E₂.map P_pull).ShortExact := hSE₂.map_of_exact P_pull
    have hsq₁ : πM ≫ S_E₁.f = (S_E₂.map P_pull).f ≫ β_K := by
      change πM ≫ (ι_kum₁ ≫ ι_gm₁) = P_pull.map (ι_kum₂ ≫ ι_gm₂) ≫ β_K
      rw [P_pull.map_comp, CategoryTheory.Category.assoc, hβ_gm,
        ← CategoryTheory.Category.assoc (P_pull.map ι_kum₂), hβ_kum,
        CategoryTheory.Category.assoc]
    have hsq₂ : β_K ≫ S_E₁.g = (S_E₂.map P_pull).g ≫ β_E := by
      change β_K ≫ ψ_E_mor S₁ K₁ D₁ div_mor₁ = P_pull.map (ψ_E_mor S₂ K₂ D₂ div_mor₂) ≫ β_E
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [ψ_E_mor, β_E]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← CategoryTheory.Category.assoc (P_pull.map _), ← P_pull.map_comp,
          CategoryTheory.Limits.pullback.lift_fst, hP_nsmul_K]
      · dsimp only [ψ_E_mor, β_E]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc (P_pull.map _), ← P_pull.map_comp,
          CategoryTheory.Limits.pullback.lift_snd, hβ_D]
    let Φ_E : S_E₂.map P_pull ⟶ S_E₁ :=
      CategoryTheory.ShortComplex.homMk πM β_K β_E hsq₁ hsq₂
    let f₂ := f_E_mor S₂ K₂ D₂ div_mor₂ κ₂ hκ₂
    let f₁ := f_E_mor S₁ K₁ D₁ div_mor₁ κ₁ hκ₁
    have hmap_δ₂ :
        (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull hAdd hLim hColim _ _
          Fℤ₂ FM₂ 1)
          ((CategoryTheory.Abelian.Ext.mk₀ f₂).comp hSE₂.extClass (Nat.zero_add 1)) =
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map f₂)).comp
          hSE₂_map.extClass (Nat.zero_add 1) := by
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
    have hnat_ext :
        hSE₂_map.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ β_E).comp hSE₁.extClass (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE₂_map hSE₁ Φ_E
    have hf_pull_eq : ιℤ ≫ P_pull.map f₂ ≫ β_E = f₁ := by
      have hmap_κ₂ :
          (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull hAdd hLim hColim _ _
            Fℤ₂ K₂ 0) κ₂ =
          CategoryTheory.Abelian.Ext.mk₀
            (P_pull.map (CategoryTheory.Abelian.Ext.addEquiv₀ κ₂)) := by
        conv_lhs => rw [← CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply κ₂]
        rw [CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      have hκ₁_hom : CategoryTheory.Abelian.Ext.addEquiv₀ κ₁ =
          ιℤ ≫ P_pull.map (CategoryTheory.Abelian.Ext.addEquiv₀ κ₂) ≫ β_K := by
        have hκ₁_mk : κ₁ = CategoryTheory.Abelian.Ext.mk₀
            (ιℤ ≫ P_pull.map (CategoryTheory.Abelian.Ext.addEquiv₀ κ₂) ≫ β_K) := by
          rw [hκ₁_eq]
          change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull hAdd hLim hColim _ _
              Fℤ₂ K₂ 0) κ₂) (Nat.zero_add 0)).comp
            (CategoryTheory.Abelian.Ext.mk₀ β_K) (Nat.add_zero 0) = _
          rw [hmap_κ₂, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Category.assoc]
        rw [hκ₁_mk]
        exact addEquiv₀_mk₀ _
      apply f_E_eq_of_fst S₁ K₁ D₁ div_mor₁ κ₁ hκ₁
      calc
        (ιℤ ≫ P_pull.map f₂ ≫ β_E) ≫ π₁_mor S₁ K₁ D₁ div_mor₁
          = ιℤ ≫ P_pull.map f₂ ≫ (β_E ≫ π₁_mor S₁ K₁ D₁ div_mor₁) := by
            simp only [CategoryTheory.Category.assoc]
        _ = ιℤ ≫ P_pull.map f₂ ≫ (P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂) ≫ β_K) := by
            rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = ιℤ ≫ (P_pull.map f₂ ≫ P_pull.map (π₁_mor S₂ K₂ D₂ div_mor₂)) ≫ β_K := by
            simp only [CategoryTheory.Category.assoc]
        _ = ιℤ ≫ P_pull.map (f₂ ≫ π₁_mor S₂ K₂ D₂ div_mor₂) ≫ β_K := by
            rw [← P_pull.map_comp]
        _ = ιℤ ≫ P_pull.map (CategoryTheory.Abelian.Ext.addEquiv₀ κ₂) ≫ β_K := by
            rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = CategoryTheory.Abelian.Ext.addEquiv₀ κ₁ := hκ₁_hom.symm
    dsimp only [delta_sys]
    rw [hp_eq]
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull hAdd hLim hColim _ _
          Fℤ₂ FM₂ 1)
          ((CategoryTheory.Abelian.Ext.mk₀ f₂).comp hSE₂.extClass (Nat.zero_add 1)))
        (Nat.zero_add 1)).comp (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.add_zero 1)) =
      (CategoryTheory.Abelian.Ext.mk₀ f₁).comp hSE₁.extClass (Nat.zero_add 1)
    rw [hmap_δ₂,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add 1),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ P_pull.map f₂))
        hSE₂_map.extClass (CategoryTheory.Abelian.Ext.mk₀ πM)
        (Nat.zero_add 1) (Nat.add_zero 1) (by omega),
      hnat_ext,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero _ _ _ (Nat.zero_add 1),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Category.assoc, hf_pull_eq]

theorem weil_etale_pinned_kummer_and_generic_gm_pullback_squares (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (ζ : Units k) (hζ : IsPrimitiveRoot ((ζ : Units k) : k) ℓ)
    (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z)) :
    (∀ (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
       [AlgebraicGeometry.IsIntegral X.left],
      letI : IrreducibleSpace ↥X.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral X.left
      let J_X := X.left.smallEtaleTopology
      let shAdj_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
      let T_X : X.left.Etale := weilEtaleIdTerminal.{u} X.left
      let adj_X := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u}
        (weilEtaleIdTerminalIsTerminal.{u} X.left)
      let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
      let η_X := X.left.fromSpecStalk (genericPoint ↥X.left)
      let σ_X : k →+* ↑(T_X.left.presheaf.obj (Opposite.op ⊤)) :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ (T_X.hom ≫ X.hom).appTop).hom
      ∃ (ι_kum : weilEtaleTorsionSheaf X.left ℓ ⟶ weilEtaleGmSheaf X.left)
        (h0_kum : ι_kum ≫ (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left)) = 0)
        (ι_gm : weilEtaleGmSheaf X.left ⟶ weilEtaleKSheaf X.left)
        (k_hom : Additive (Units ↑X.left.functionField) →+ (weilEtaleKSheaf X.left).H 0),
        (CategoryTheory.ShortComplex.mk ι_kum
          (ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf X.left)) h0_kum).ShortExact ∧
        (∀ a : ZMod ℓ,
          (ι_kum.hom.app (Opposite.op T_X)).hom ((adj_X.unit.app AM).hom (ULift.up a)) =
            ((shAdj_X.unit.app (weilEtaleGmPresheaf X.left)).app (Opposite.op T_X)).hom
              (Additive.ofMul ((Units.map σ_X.toMonoidHom ζ) ^ a.val))) ∧
        (∀ (U : X.left.Etale) (u : Units ↑(U.left.presheaf.obj (Opposite.op ⊤))),
          (ι_gm.hom.app (Opposite.op U)).hom
              (((shAdj_X.unit.app (weilEtaleGmPresheaf X.left)).app (Opposite.op U)).hom
                (Additive.ofMul u)) =
            ((shAdj_X.unit.app (weilEtaleKPresheaf X.left)).app (Opposite.op U)).hom
              (Additive.ofMul
                (Units.map (CategoryTheory.Limits.pullback.fst U.hom η_X).appTop.hom.toMonoidHom u))) ∧
        (Function.Bijective k_hom ∧
          ∀ f : Units ↑X.left.functionField,
            (adj_X.homEquiv Aℤ (weilEtaleKSheaf X.left)
                (CategoryTheory.Abelian.Ext.addEquiv₀ (k_hom (Additive.ofMul f)))).hom
              (ULift.up (1 : ℤ)) =
