          (CategoryTheory.CategoryStruct.id X).appLE U V₁ hV₁_le =
            X.presheaf.map (CategoryTheory.homOfLE hV₁_le).op := by
        simp only [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.id_app]
        exact CategoryTheory.Category.id_comp _
      rw [hid_app, CategoryTheory.Category.comp_id] at hSpec_id
      let q_V : PrimeSpectrum B :=
        (AlgebraicGeometry.Spec.map
          (X.presheaf.map (CategoryTheory.homOfLE hV₁_le).op)).base q₁
      have hqV_pt : hAff_U.fromSpec.base q_V = y :=
        (congrArg (fun f => f.base q₁) hSpec_id).trans
          (hAff_V₁.fromSpec_primeIdealOf ⟨y, hy_V₁⟩)
      have hb₀_not : b₀ ∉ q_V.asIdeal := by
        have hmem : q_V ∈ (TopologicalSpace.Opens.map hAff_U.fromSpec.base).obj
            (X.basicOpen b₀) := by
          change hAff_U.fromSpec.base q_V ∈ X.basicOpen b₀
          rw [hqV_pt]
          exact hy_V₁
        rwa [hAff_U.fromSpec_preimage_basicOpen b₀] at hmem
      have hdet₁_not : det₁ ∉ q₁.asIdeal := by
        intro hdet₁_in
        have hΔ_in : Δ ∈ q_V.asIdeal := hdet₁_in
        have hqV_eq_mQ : q_V.asIdeal = m_Q :=
          (hdet_iso q_V.asIdeal q_V.isPrime hb₀_not).mp hΔ_in
        have hqV_eq : q_V = p_Q := PrimeSpectrum.ext hqV_eq_mQ
        apply hy_ne_P
        change y = P₀.1
        rw [← hqV_pt, hqV_eq, hAff_U.fromSpec_primeIdealOf q_pt]
      have hmem_b : q₁ ∈ (TopologicalSpace.Opens.map hAff_V₁.fromSpec.base).obj
          (X.basicOpen det₁) := by
        rw [hAff_V₁.fromSpec_preimage_basicOpen det₁]
        exact hdet₁_not
      change hAff_V₁.fromSpec.base q₁ ∈ X.basicOpen det₁ at hmem_b
      rwa [hAff_V₁.fromSpec_primeIdealOf ⟨y, hy_V₁⟩] at hmem_b

  have hUnit_det₁ :
      IsUnit ((X.presheaf.map
        (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom det₁) := by
    let e_b : X.basicOpen det₁ ≅ V₁ ⊓ V₂ := CategoryTheory.eqToIso hbasic_det₁
    have h1 : IsUnit ((X.presheaf.map
        (CategoryTheory.homOfLE (X.basicOpen_le det₁)).op).hom det₁) :=
      X.toRingedSpace.isUnit_res_basicOpen det₁
    have hcomp :
        (X.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom det₁ =
          (X.presheaf.map e_b.inv.op).hom
            ((X.presheaf.map
              (CategoryTheory.homOfLE (X.basicOpen_le det₁)).op).hom det₁) := by
      change _ = (X.presheaf.map
        (CategoryTheory.homOfLE (X.basicOpen_le det₁)).op ≫
          X.presheaf.map e_b.inv.op).hom det₁
      rw [← X.presheaf.map_comp, ← op_comp]
      rfl
    rw [hcomp]
    exact h1.map (X.presheaf.map e_b.inv.op).hom
  let u_V : Units ↑(X.presheaf.obj (Opposite.op (V₁ ⊓ V₂))) := hUnit_det₁.unit
  have hu_V_val :
      (u_V : ↑(X.presheaf.obj (Opposite.op (V₁ ⊓ V₂)))) =
        (X.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom
          (((LinearMap.toMatrix bM₁ bM₁) L_g).det) := by
    rw [hdet₁_eq]
    exact IsUnit.unit_spec hUnit_det₁

  have hspan_stalkP₀ :
      Ideal.span ({(X.presheaf.germ V₁ P₀.1 hP₀_mem).hom det₁} :
          Set ↑(X.presheaf.stalk P₀.1)) =
        IsLocalRing.maximalIdeal ↑(X.presheaf.stalk P₀.1) := by
    have hgerm_eq :
        (X.presheaf.germ V₁ P₀.1 hP₀_mem).hom det₁ =
          algebraMap B ↑(X.presheaf.stalk (q_pt : ↥X)) Δ := by
      rw [TopCat.Presheaf.stalk_open_algebraMap X.presheaf q_pt]
      exact X.presheaf.germ_res_apply (CategoryTheory.homOfLE hV₁_le) P₀.1 hP₀_mem Δ
    rw [hgerm_eq]
    exact hSpan_to_loc m_Q Δ hdet_span

  
  obtain ⟨Q_div, ι_gm, π_div, h0_div, div_H0, hSE_div, hPrin_div, hUnif_div⟩ := hValPkg_C
  let J_C := X.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_C := (CategoryTheory.constantSheaf J_C AddCommGrpCat.{u}).obj Aℤ
  let δ_div : Q_div.H 0 →+ (weilEtaleGmSheaf X).H 1 :=
    hSE_div.extClass.postcomp Fℤ_C (Nat.zero_add 1)
  have hSurj_δ : Function.Surjective δ_div := by
    intro ξ
    have hξ_0 : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ ι_gm) (Nat.add_zero 1) = 0 :=
      @Subsingleton.elim _ hH1K_C _ _
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hSE_div ξ hξ_0
      (Nat.zero_add 1)
  let Φ_Q : Q_div.H 0 →+ weilCurveClGroup X :=
    (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X)).comp div_H0
  have hKer_δ_Φ : ∀ q : Q_div.H 0, δ_div q = 0 → Φ_Q q = 0 := by
    intro q hq
    obtain ⟨k₀, hk₀⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_C hSE_div q (Nat.zero_add 1) hq
    apply (QuotientAddGroup.eq_zero_iff (div_H0 q)).mpr
    rw [← hk₀]
    exact hPrin_div k₀
  obtain ⟨deg_H1, hdeg_H1_eval⟩ := hDescendDeg δ_div Φ_Q deg_Cl hSurj_δ hKer_δ_Φ

  obtain ⟨s₁, f_q, hs₁, hfq_1, hfq_2, hdiv_fq⟩ :=
    hUnif_div V₁ V₂ hcov_V P₀.1 P₀.2 hP₀_mem rfl det₁ u_V
      (IsUnit.unit_spec hUnit_det₁).symm hspan_stalkP₀
  let T_C : X.Etale := weilEtaleIdTerminal.{u} X
  let hT_C : CategoryTheory.Limits.IsTerminal T_C := weilEtaleIdTerminalIsTerminal.{u} X
  let shAdj_C := CategoryTheory.sheafificationAdjunction J_C AddCommGrpCat.{u}
  let adj_c := CategoryTheory.constantSheafAdj J_C AddCommGrpCat.{u} hT_C
  let P_const := (CategoryTheory.Functor.const (Opposite X.Etale)).obj Aℤ
  let u₁_Fℤ : ∀ W : X.Etale, ↥(Fℤ_C.obj.obj (Opposite.op W)) := fun W =>
    (((shAdj_C.unit.app P_const).app (Opposite.op W)).hom (ULift.up (1 : ℤ)))
  have hUnitAlign : ∀ W : X.Etale,
      (Q_div.obj.map (Opposite.op (hT_C.from W))).hom
        ((f_q.hom.app (Opposite.op T_C)).hom ((adj_c.unit.app Aℤ).hom (ULift.up 1))) =
        (f_q.hom.app (Opposite.op W)).hom (u₁_Fℤ W) := by
    intro W
    have hadj_eq : (adj_c.unit.app Aℤ).hom (ULift.up 1) = u₁_Fℤ T_C := by
      change (((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT_C).comp
          shAdj_C).unit.app Aℤ).hom (ULift.up 1) = u₁_Fℤ T_C
      rw [CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.Category.id_comp]
      rfl
    let t_W : Opposite.op T_C ⟶ Opposite.op W := (hT_C.from W).op
    have hnat_fq :
        (Q_div.obj.map t_W).hom ((f_q.hom.app (Opposite.op T_C)).hom (u₁_Fℤ T_C)) =
          (f_q.hom.app (Opposite.op W)).hom ((Fℤ_C.obj.map t_W).hom (u₁_Fℤ T_C)) :=
      (congrArg (fun m => m.hom (u₁_Fℤ T_C)) (f_q.hom.naturality t_W)).symm
    have hnat_u : (Fℤ_C.obj.map t_W).hom (u₁_Fℤ T_C) = u₁_Fℤ W :=
      (congrArg (fun m => m.hom (ULift.up (1 : ℤ)))
        ((shAdj_C.unit.app P_const).naturality t_W)).symm
    exact (congrArg (fun x => (Q_div.obj.map t_W).hom ((f_q.hom.app (Opposite.op T_C)).hom x))
      hadj_eq).trans (hnat_fq.trans (congrArg (f_q.hom.app (Opposite.op W)).hom hnat_u))
  let V₁_et : X.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ V₁.ι (inferInstance : AlgebraicGeometry.Etale V₁.ι)
  let V₂_et : X.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ V₂.ι (inferInstance : AlgebraicGeometry.Etale V₂.ι)
  have hMV_eq : δ_MV C_bar V₁ V₂ hcov_V u_V = δ_div (CategoryTheory.Abelian.Ext.mk₀ f_q) :=
    hMV_se V₁ V₂ hcov_V u_V (weilEtaleKSheaf X) Q_div ι_gm π_div h0_div hSE_div s₁ f_q
      hs₁ ((hUnitAlign V₁_et).trans hfq_1) ((hUnitAlign V₂_et).trans hfq_2)
  let ξ_C : (weilEtaleGmSheaf X).H 1 := δ_MV C_bar V₁ V₂ hcov_V u_V
  have hdeg_ξC : deg_H1 ξ_C = 1 := by
    change deg_H1 (δ_MV C_bar V₁ V₂ hcov_V u_V) = 1
    rw [hMV_eq, hdeg_H1_eval (CategoryTheory.Abelian.Ext.mk₀ f_q)]
    change deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X)
      (div_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q))) = 1
    rw [hdiv_fq]
    exact hdeg_P₀

  
  obtain ⟨ι_kum, p_kum, h0_kum, hp_kum, hSE_kum⟩ := hKum_C
  let T_sh := weilEtaleTorsionSheaf X ℓ
  let Gm_sh := weilEtaleGmSheaf X
  have hnsmul_comp : ∀ (𝒢 : CategoryTheory.Sheaf J_C AddCommGrpCat.{u})
      (q n : ℕ) (x : 𝒢.H q),
      x.comp (CategoryTheory.Abelian.Ext.mk₀ (n • 𝟙 𝒢)) (Nat.add_zero q) = n • x := by
    intro 𝒢 q n x
    induction n with
    | zero =>
      rw [zero_smul, zero_smul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]
  have : CategoryTheory.Mono ι_kum := hSE_kum.mono_f
  have hℓ_id_T : ℓ • 𝟙 T_sh = (0 : T_sh ⟶ T_sh) := by
    apply (CategoryTheory.cancel_mono ι_kum).mp
    calc
      (ℓ • 𝟙 T_sh) ≫ ι_kum = ℓ • (𝟙 T_sh ≫ ι_kum) :=
        CategoryTheory.Preadditive.nsmul_comp _ _ _
      _ = ℓ • (ι_kum ≫ 𝟙 Gm_sh) := by
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      _ = ι_kum ≫ (ℓ • 𝟙 Gm_sh) := (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
      _ = ι_kum ≫ p_kum := by rw [← hp_kum]
      _ = 0 := h0_kum
      _ = 0 ≫ ι_kum := (CategoryTheory.Limits.zero_comp).symm
  have hℓ_kill : ∀ z : weilEtaleTorsionH X ℓ 2, ℓ • z = 0 := by
    intro z
    rw [← hnsmul_comp T_sh 2 ℓ z, hℓ_id_T, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero]
  let δ_kum : Gm_sh.H 1 →+ weilEtaleTorsionH X ℓ 2 :=
    hSE_kum.extClass.postcomp Fℤ_C (show 1 + 1 = 2 from rfl)
  have hsurj_kum : Function.Surjective δ_kum := by
    intro z₂
    have hz₂_0 : z₂.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 2) = 0 :=
      @Subsingleton.elim _ hH2Gm_C _ _
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_C hSE_kum z₂ hz₂_0
      (show 1 + 1 = 2 from rfl)
  have hker_kum : ∀ u₁ : Gm_sh.H 1, δ_kum u₁ = 0 ↔ ∃ v₁ : Gm_sh.H 1, ℓ • v₁ = u₁ := by
    intro u₁
    constructor
    · intro hu₁
      obtain ⟨v₁, hv₁⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_C hSE_kum u₁
        (show 1 + 1 = 2 from rfl) hu₁
      refine ⟨v₁, ?_⟩
      rw [← hnsmul_comp Gm_sh 1 ℓ v₁, ← hp_kum]
      exact hv₁
    · rintro ⟨v₁, rfl⟩
      change (ℓ • v₁).comp hSE_kum.extClass (show 1 + 1 = 2 from rfl) = 0
      rw [← hnsmul_comp Gm_sh 1 ℓ v₁, ← hp_kum,
        CategoryTheory.Abelian.Ext.comp_assoc_of_second_deg_zero, hSE_kum.comp_extClass,
        CategoryTheory.Abelian.Ext.comp_zero]
  have hκ_ne : κ C_bar ξ_C ≠ 0 :=
    hPigeonholeNeZero δ_kum (κ C_bar) deg_H1 ξ_C
      hsurj_kum hker_kum hℓ_kill hCardH2_C hκ_surj_C hdeg_ξC

  
  let u₀ : weilEtaleTorsionH C'_bar.left ℓ 2 := κ C'_bar (δ_MV C'_bar U₁ U₂ hcov_U u_U)
  refine ⟨u₀, ?_⟩
  have hpush_eq : g_shriek u₀ = κ C_bar ξ_C := by
    change g_shriek (κ C'_bar (δ_MV C'_bar U₁ U₂ hcov_U u_U)) = κ C_bar ξ_C
    rw [hκ_comm (δ_MV C'_bar U₁ U₂ hcov_U u_U)]
    congr 1
    exact hMV_det V₁ V₂ hcov_V hcov_U hAff_V₁ hAff_U₁ A₁ inferInstance inferInstance
      bM₁ (AddEquiv.refl A₁) (fun _ _ => rfl) g₁ L_g (fun _ => rfl) u_U u_V
      hu_U_val hu_V_val
  rw [hpush_eq]
  exact hκ_ne

theorem weil_etale_finite_curve_cover_local_H2_and_norm_counit (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (C_bar C'_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C_bar.left]
    [AlgebraicGeometry.IsIntegral C'_bar.left]
    (hProjC : IsProjectiveOverField k C_bar)
    (hProjC' : IsProjectiveOverField k C'_bar)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C'_bar.hom]
    (hDimC : topologicalKrullDim C_bar.left = (1 : WithBot ℕ∞))
    (hDimC' : topologicalKrullDim C'_bar.left = (1 : WithBot ℕ∞))
    (hStalkC : (∀ (U : C_bar.left.Etale)
        (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C_bar.left) }),
      ∃ hDom : IsDomain ↑(U.left.presheaf.stalk y.1),
        @IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) _ hDom) ∧
      (∀ {U₁ U₂ : C_bar.left.Etale} (g : U₁ ⟶ U₂)
          (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥C_bar.left) }),
        let y₂ : { y : ↥U₂.left // IsClosed ({U₂.hom.base y} : Set ↥C_bar.left) } :=
          ⟨g.left.base y₁.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w g]
            exact y₁.2⟩
        Function.Injective (g.left.stalkMap y₁.1).hom ∧
        ∀ n : ℕ,
          Ideal.map (g.left.stalkMap y₁.1).hom
            (IsLocalRing.maximalIdeal ↑(U₂.left.presheaf.stalk y₂.1) ^ n) =
          IsLocalRing.maximalIdeal ↑(U₁.left.presheaf.stalk y₁.1) ^ n))
    (hStalkC' : ∀ x' : { x : ↥C'_bar.left // IsClosed ({x} : Set ↥C'_bar.left) },
      ∃ hDom : IsDomain ↑(C'_bar.left.presheaf.stalk x'.1),
        @IsDiscreteValuationRing ↑(C'_bar.left.presheaf.stalk x'.1) _ hDom)
    (bar_p : C'_bar ⟶ C_bar)
    [AlgebraicGeometry.IsFinite bar_p.left]
    [AlgebraicGeometry.Surjective bar_p.left]
    (hFree_p : ∀ x : ↥C_bar.left,
      ∃ (U : C_bar.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen U) (_ : x ∈ U)
        (M_U : Type u) (_ : AddCommGroup M_U)
        (_ : Module ↑(C_bar.left.presheaf.obj (Opposite.op U)) M_U)
        (_ : Module.Basis (Fin ℓ) ↑(C_bar.left.presheaf.obj (Opposite.op U)) M_U)
        (e_U : M_U ≃+ ↑(C'_bar.left.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map bar_p.left.base).obj U)))),
        ∀ (r : ↑(C_bar.left.presheaf.obj (Opposite.op U))) (m : M_U),
          e_U (r • m) = (bar_p.left.app U).hom r * e_U m)
    (hPresEpi : WeilEtalePushforwardPreservesEpi bar_p.left)
    (hKum : ∀ Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)),
      CategoryTheory.Presheaf.IsSheaf Y.left.smallEtaleTopology (weilEtaleGmPresheaf Y.left) ∧
      ∃ (ι_kum : weilEtaleTorsionSheaf Y.left ℓ ⟶ weilEtaleGmSheaf Y.left)
        (p_kum : weilEtaleGmSheaf Y.left ⟶ weilEtaleGmSheaf Y.left)
        (h0 : ι_kum ≫ p_kum = 0),
        p_kum = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y.left) ∧
        (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact)
    (hProjCurveH2 : ∀ (C'' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.IsIntegral C''.left],
      IsProjectiveOverField k C'' →
      ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C''.hom],
        Nonempty ((weilEtaleGmSheaf C''.left).H 1 ≃+ weilCurveClGroup C''.left) ∧
        Subsingleton ((weilEtaleGmSheaf C''.left).H 2) ∧
        Nat.card (weilCupPDModH C''.left ℓ 2) = ℓ)
    (hModComp : ∀ (S : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      ∃ θ : weilCupPDModH S ℓ q →+ weilEtaleTorsionH S ℓ q,
        WeilIsModuleToTorsionComparison S ℓ q θ ∧ Function.Bijective θ)
    (hDeg_C : ∃ (deg_Cl : weilCurveClGroup C_bar.left →+ ℤ)
      (P₀ : { x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) }),
      (∀ D : ({ x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) } →₀ ℤ),
        deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C_bar.left) D) =
          D.sum (fun _ n => n)) ∧
      deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C_bar.left)
        (Finsupp.single P₀ 1)) = 1)
    (hValPkg_C : ∃ (Q_div : CategoryTheory.Sheaf C_bar.left.smallEtaleTopology AddCommGrpCat.{u})
      (ι_gm : weilEtaleGmSheaf C_bar.left ⟶ weilEtaleKSheaf C_bar.left)
      (π_div : weilEtaleKSheaf C_bar.left ⟶ Q_div)
      (h0_div : ι_gm ≫ π_div = 0)
      (div_H0 : Q_div.H 0 →+ ({ x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) } →₀ ℤ)),
      (CategoryTheory.ShortComplex.mk ι_gm π_div h0_div).ShortExact ∧
      (∀ k₀ : (weilEtaleKSheaf C_bar.left).H 0,
        div_H0 (k₀.comp (CategoryTheory.Abelian.Ext.mk₀ π_div) (Nat.add_zero 0)) ∈
          weilCurvePrincipalSubgroup C_bar.left) ∧
      (∀ (W₁ W₂ : C_bar.left.Opens),
        W₁ ⊔ W₂ = ⊤ →
        ∀ (P : ↥C_bar.left) (hP_cl : IsClosed ({P} : Set ↥C_bar.left)) (hP_mem : P ∈ W₁),
          (W₂ : Set ↥C_bar.left) = ({P} : Set ↥C_bar.left)ᶜ →
          ∀ (f_sec : ↑(C_bar.left.presheaf.obj (Opposite.op W₁)))
            (u_W : Units ↑(C_bar.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂)))),
            (C_bar.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : W₁ ⊓ W₂ ≤ W₁)).op).hom f_sec =
              (u_W : ↑(C_bar.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂)))) →
            Ideal.span {(C_bar.left.presheaf.germ W₁ P hP_mem).hom f_sec} =
              IsLocalRing.maximalIdeal ↑(C_bar.left.presheaf.stalk P) →
            let W₁₂ : C_bar.left.Opens := W₁ ⊓ W₂
            let V₁ : C_bar.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁.ι
              (inferInstance : AlgebraicGeometry.Etale W₁.ι)
            let V₂ : C_bar.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₂.ι
              (inferInstance : AlgebraicGeometry.Etale W₂.ι)
            let V₁₂ : C_bar.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W₁₂.ι
              (inferInstance : AlgebraicGeometry.Etale W₁₂.ι)
            let j₁₂_₁ : V₁₂ ⟶ V₁ :=
              CategoryTheory.MorphismProperty.Over.homMk
                (C_bar.left.homOfLE inf_le_left) (C_bar.left.homOfLE_ι inf_le_left)
            let shAdj_C := CategoryTheory.sheafificationAdjunction
              C_bar.left.smallEtaleTopology AddCommGrpCat.{u}
