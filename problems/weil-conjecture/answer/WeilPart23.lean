            rw [e_one₂.inv_hom_id, Category.id_comp]

  haveI : EnoughInjectives (CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R)) := inferInstance
  haveI : EnoughInjectives (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}) := inferInstance

  letI : (R_sh ⋙ U_std₁).Additive := hCompAdd R_sh U_std₁
  letI : Limits.PreservesFiniteLimits (R_sh ⋙ U_std₁) :=
    Limits.comp_preservesFiniteLimits R_sh U_std₁
  letI : Limits.PreservesFiniteColimits (R_sh ⋙ U_std₁) :=
    Limits.comp_preservesFiniteColimits R_sh U_std₁
