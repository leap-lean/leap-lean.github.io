      have hX : AlgebraicGeometry.Etale (X_i i).hom := (X_i i).prop
      have hU : AlgebraicGeometry.Etale U.hom := U.prop
      rw [← CategoryTheory.MorphismProperty.Over.w (π_i i)] at hX
      exact ⟨X_i i, π_i i, y, CategoryTheory.Sieve.ofArrows_mk X_i π_i i,
