        have hR : ((C.obj AM).obj.map f.op).hom (Ψ_fun U (g₁ + g₂)) =
            (η_sh.app (Opposite.op V)).hom (ULift.up a₁) +
              (η_sh.app (Opposite.op V)).hom (ULift.up a₂) :=
          (hΨ_spec U (g₁ + g₂) f (a₁ + a₂) ha₁₂).trans
            (map_add (η_sh.app (Opposite.op V)).hom (ULift.up a₁) (ULift.up a₂))
        exact hL.trans hR.symm
      exact hw₁.trans hw₂.symm
