          congrArg (fun k : P_U V'_et ⟶ X => k.base z)
            CategoryTheory.Limits.pullback.condition.symm
        change (snd_U V'_et ≫ g).base z ∈ (V : Set ↥X)
        rw [hcond, ← hh_V]
        exact (h_V.base ((fst_U V'_et).base z)).2
      let q_snd : P_U V'_et ⟶ V'_open.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V'_open.ι (snd_U V'_et) hRange_snd
      have hq_fac : q_snd ≫ V'_open.ι = snd_U V'_et :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V'_open.ι (snd_U V'_et) hRange_snd
      have hq_comm : q_snd ≫ (g ∣_ V) = fst_U V'_et ≫ h_V := by
        refine (CategoryTheory.cancel_mono V.ι).mp ?_
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι g V,
          ← CategoryTheory.Category.assoc, hq_fac, CategoryTheory.Category.assoc, hh_V]
        exact CategoryTheory.Limits.pullback.condition.symm
      have hPb_pfst : CategoryTheory.IsPullback q_snd (fst_U V'_et) (g ∣_ V) h_V := by
        apply CategoryTheory.IsPullback.of_right _ hq_comm
          (AlgebraicGeometry.isPullback_morphismRestrict g V).flip
        rw [hq_fac, hh_V]
        exact (CategoryTheory.IsPullback.of_hasPullback (FgtX.obj V'_et).hom g).flip
      have hEt_pfst : AlgebraicGeometry.Etale (fst_U V'_et) :=
        CategoryTheory.MorphismProperty.of_isPullback (P := P_et) hPb_pfst hEt_p
      have hfδ_fst : f_δ ≫ fst_U V'_et = CategoryTheory.CategoryStruct.id _ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have _ : AlgebraicGeometry.Etale f_δ :=
        CategoryTheory.MorphismProperty.of_postcomp P_et f_δ (fst_U V'_et) hEt_pfst
          (by rw [hfδ_fst]; infer_instance)
      have _ : CategoryTheory.Mono f_δ :=
        ⟨fun {_} g₁ g₂ hg => by
          have hpost := congrArg (· ≫ fst_U V'_et) hg
          change (g₁ ≫ f_δ) ≫ fst_U V'_et = (g₂ ≫ f_δ) ≫ fst_U V'_et at hpost
          rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hfδ_fst,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id] at hpost
          exact hpost⟩
      have _ : AlgebraicGeometry.IsOpenImmersion f_δ :=
        AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono f_δ
      have _ : AlgebraicGeometry.IsClosedImmersion (f_δ ≫ fst_U V'_et) := by
        rw [hfδ_fst]
        infer_instance
      have _ : AlgebraicGeometry.IsClosedImmersion f_δ :=
        AlgebraicGeometry.IsClosedImmersion.of_comp f_δ (fst_U V'_et)
      exact ⟨f_δ.isOpenEmbedding.isOpen_range, f_δ.isClosedEmbedding.isClosed_range⟩

    let S_Δ : Set ↥(P_U V'_et) := Set.range f_δ.base
    have hLC_δ : ∀ a : ULift.{u} (ZMod ℓ),
        IsLocallyConstant (fun z : ↥(P_U V'_et) => if z ∈ S_Δ then a else 0) := by
      intro a T_set
      by_cases ha : a ∈ T_set <;> by_cases h0 : (0 : ULift.{u} (ZMod ℓ)) ∈ T_set
      · have heq : (fun z : ↥(P_U V'_et) => if z ∈ S_Δ then a else 0) ⁻¹' T_set = Set.univ := by
          ext z; simp only [Set.mem_preimage, Set.mem_univ, iff_true]; split_ifs <;> assumption
        rw [heq]; exact isOpen_univ
      · have heq : (fun z : ↥(P_U V'_et) => if z ∈ S_Δ then a else 0) ⁻¹' T_set = S_Δ := by
          ext z; simp only [Set.mem_preimage]; split_ifs with hz <;> simp [hz, ha, h0]
        rw [heq]; exact hClopen_fδ.1
      · have heq : (fun z : ↥(P_U V'_et) => if z ∈ S_Δ then a else 0) ⁻¹' T_set = S_Δᶜ := by
          ext z; simp only [Set.mem_preimage, Set.mem_compl_iff]; split_ifs with hz <;> simp [hz, ha, h0]
        rw [heq]; exact hClopen_fδ.2.isOpen_compl
      · have heq : (fun z : ↥(P_U V'_et) => if z ∈ S_Δ then a else 0) ⁻¹' T_set = ∅ := by
          ext z; simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false]; split_ifs <;> assumption
        rw [heq]; exact isOpen_empty

    have hBdry_δ : ∀ (z : ↥(P_U V'_et)),
        ((FgtX'.obj (B_g.obj V'_et)).hom).base z ∈ (V'_open : Set ↥X') := by
      intro z
      change g.base ((snd_U V'_et).base z) ∈ (V : Set ↥X)
      have hcond : (snd_U V'_et ≫ g).base z = (fst_U V'_et ≫ (FgtX.obj V'_et).hom).base z :=
        congrArg (fun k : P_U V'_et ⟶ X => k.base z)
          CategoryTheory.Limits.pullback.condition.symm
      change (snd_U V'_et ≫ g).base z ∈ (V : Set ↥X)
      rw [hcond, ← he_V']
      exact (e_V'.hom.base ((fst_U V'_et).base z)).2

    let η_clop : AM ⟶ (P_push.obj K'_sh).obj.obj (Opposite.op V'_et) :=
      AddCommGrpCat.ofHom
        { toFun := fun a =>
            ⟨⟨fun z => if z ∈ S_Δ then a else 0, hLC_δ a⟩,
             fun z hz => (hz (hBdry_δ z)).elim⟩
          map_zero' := Subtype.ext (LocallyConstant.ext fun z => by
            change (if z ∈ S_Δ then (0 : ULift.{u} (ZMod ℓ)) else 0) = 0
            split_ifs <;> rfl)
          map_add' := fun a b => Subtype.ext (LocallyConstant.ext fun z => by
            change (if z ∈ S_Δ then a + b else 0) =
              (if z ∈ S_Δ then a else 0) + (if z ∈ S_Δ then b else 0)
            split_ifs <;> simp) }

    let α_clop : L_ab ⟶ P_push.obj K'_sh := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm η_clop

    have hEquiv_comp : ∀ {F G : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
        (α : L_ab ⟶ F) (q : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ q) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ q.hom.app (Opposite.op V'_et) := by
      intro F G α q
      let α' : (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda V'_et AM) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ q))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              (((CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}).map q) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ q.hom.app (Opposite.op V'_et) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

    have hPre_SΔ : ∀ {U : X.Etale} (γ : U ⟶ V'_et) (z : ↥(P_U U)),
        (map_Bg γ).base z ∈ S_Δ ↔ z ∈ Set.range (s_diag γ).base := by
      intro U γ z
      dsimp only [S_Δ]
      rw [← hs_diag_id]
      constructor
      · rintro ⟨v, hv⟩
        have hγ_id : γ ≫ 𝟙 V'_et = γ := CategoryTheory.Category.comp_id γ
        obtain ⟨w, _, hw⟩ := hPre_of_pb (hPb_sdiag γ (𝟙 V'_et)) v z hv
        refine ⟨w, ?_⟩
        exact (congrArg (fun u => (s_diag u).base w) hγ_id.symm).trans hw
      · rintro ⟨w, rfl⟩
        have hγ_id : γ ≫ 𝟙 V'_et = γ := CategoryTheory.Category.comp_id γ
        refine ⟨(FgtX.map γ).left.base w, ?_⟩
        have hnat_w := congrArg (fun k : (FgtX.obj U).left ⟶ P_U V'_et => k.base w)
          (hs_diag_nat γ (𝟙 V'_et))
        change (map_Bg γ).base ((s_diag (γ ≫ 𝟙 V'_et)).base w) =
          (s_diag (𝟙 V'_et)).base ((FgtX.map γ).left.base w) at hnat_w
        rw [hγ_id] at hnat_w
        exact hnat_w.symm

    have hα_eval_gen : ∀ {U : X.Etale} (γ : U ⟶ V'_et) (a : ULift.{u} (ZMod ℓ)) (z : ↥(P_U U)),
        (((α_clop.hom.app (Opposite.op U)).hom ((L_ab.obj.map (Opposite.op γ)).hom (ξ_V.hom a)) :
          ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))).1 z) =
          if z ∈ Set.range (s_diag γ).base then a else 0 := by
      intro U γ a z
      let src := L_ab.obj.obj (Opposite.op V'_et)
      let dst := (P_push.obj K'_sh).obj.obj (Opposite.op U)
      have hnat := congrArg (fun f : src ⟶ dst =>
          (AddCommGrpCat.Hom.hom f (ξ_V.hom a) :
            ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))).1 z)
        (α_clop.hom.naturality (Opposite.op γ))
      change (((α_clop.hom.app (Opposite.op U)).hom
          ((L_ab.obj.map (Opposite.op γ)).hom (ξ_V.hom a)) :
            ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))).1 z) =
        (((P_push.obj K'_sh).obj.map (Opposite.op γ)).hom
          ((α_clop.hom.app (Opposite.op V'_et)).hom (ξ_V.hom a)) :
            ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))).1 z at hnat
      have hid_eq : ξ_V ≫ α_clop.hom.app (Opposite.op V'_et) = η_clop :=
        (hEquiv_comp (𝟙 L_ab) α_clop).symm.trans
          ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.Category.id_comp α_clop)).trans (Equiv.apply_symm_apply _ _))
      have ha := congrArg (fun f : AM ⟶ (P_push.obj K'_sh).obj.obj (Opposite.op V'_et) =>
        (AddCommGrpCat.Hom.hom f a :
          ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj V'_et))).1 ((map_Bg γ).base z)) hid_eq
      change (((P_push.obj K'_sh).obj.map (Opposite.op γ)).hom
          ((α_clop.hom.app (Opposite.op V'_et)).hom (ξ_V.hom a)) :
            ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))).1 z =
        (if (map_Bg γ).base z ∈ S_Δ then a else 0) at ha
      refine hnat.trans (ha.trans ?_)
      by_cases hz : z ∈ Set.range (s_diag γ).base
      · have hz' : (map_Bg γ).base z ∈ S_Δ := (hPre_SΔ γ z).mpr hz
        simp [hz, hz']
      · have hz' : (map_Bg γ).base z ∉ S_Δ := fun h => hz ((hPre_SΔ γ z).mp h)
        simp [hz, hz']

    let IsSplitSheets : ∀ (U : X.Etale), (ZMod ℓ → (U ⟶ V'_et)) → Prop :=
      fun U γ =>
        (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (s_diag (γ i))) ∧
        (_root_.Pairwise fun i j : ZMod ℓ =>
          Disjoint (Set.range (s_diag (γ i)).base) (Set.range (s_diag (γ j)).base)) ∧
        (⋃ i : ZMod ℓ, Set.range (s_diag (γ i)).base) = Set.univ

    have hSplitPull : ∀ {U₁ U₂ : X.Etale} (u : U₁ ⟶ U₂) (γ : ZMod ℓ → (U₂ ⟶ V'_et)),
        IsSplitSheets U₂ γ → IsSplitSheets U₁ (fun i => u ≫ γ i) := by
      intro U₁ U₂ u γ ⟨hOpen, hDisj, hUniv⟩
      have hRangeEq : ∀ i : ZMod ℓ,
          Set.range (s_diag (u ≫ γ i)).base = (map_Bg u).base ⁻¹' Set.range (s_diag (γ i)).base := by
        intro i
        ext z
        simp only [Set.mem_preimage]
        constructor
        · rintro ⟨w, rfl⟩
          refine ⟨(FgtX.map u).left.base w, ?_⟩
          exact (congrArg (fun k : (FgtX.obj U₁).left ⟶ P_U U₂ => k.base w)
            (hs_diag_nat u (γ i))).symm
        · rintro ⟨v, hv⟩
          obtain ⟨w, _, hw⟩ := hPre_of_pb (hPb_sdiag u (γ i)) v z hv
          exact ⟨w, hw⟩
      refine ⟨?_, ?_, ?_⟩
      · intro i
        have _ : AlgebraicGeometry.IsOpenImmersion (s_diag (γ i)) := hOpen i
        exact CategoryTheory.MorphismProperty.of_isPullback
          (P := @AlgebraicGeometry.IsOpenImmersion) (hPb_sdiag u (γ i)) (hOpen i)
      · intro i j hij
        rw [hRangeEq i, hRangeEq j]
        exact (hDisj hij).preimage (map_Bg u).base
      · ext z
        simp only [Set.mem_iUnion, hRangeEq, Set.mem_preimage, Set.mem_univ, iff_true]
        have hz : (map_Bg u).base z ∈ ⋃ i : ZMod ℓ, Set.range (s_diag (γ i)).base := by
          rw [hUniv]; trivial
        exact Set.mem_iUnion.mp hz

    let sheetSum : ∀ (U : X.Etale), (ZMod ℓ → (U ⟶ V'_et)) →
        (ZMod ℓ → ULift.{u} (ZMod ℓ)) → ↥(L_ab.obj.obj (Opposite.op U)) :=
      fun U γ c =>
        Finset.univ.sum fun i : ZMod ℓ => (L_ab.obj.map (Opposite.op (γ i))).hom (ξ_V.hom (c i))

    have hSheetSumPull : ∀ {U₁ U₂ : X.Etale} (u : U₁ ⟶ U₂)
        (γ : ZMod ℓ → (U₂ ⟶ V'_et)) (c : ZMod ℓ → ULift.{u} (ZMod ℓ)),
        (L_ab.obj.map (Opposite.op u)).hom (sheetSum U₂ γ c) =
          sheetSum U₁ (fun i => u ≫ γ i) c := by
      intro U₁ U₂ u γ c
      dsimp only [sheetSum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      let src := L_ab.obj.obj (Opposite.op V'_et)
      let dst := L_ab.obj.obj (Opposite.op U₁)
      exact congrArg (fun f : src ⟶ dst => AddCommGrpCat.Hom.hom f (ξ_V.hom (c i)))
        (L_ab.obj.map_comp (Opposite.op (γ i)) (Opposite.op u)).symm

    have hα_sheetSum_at : ∀ {U : X.Etale} {γ : ZMod ℓ → (U ⟶ V'_et)}
        (hSp : IsSplitSheets U γ) (c : ZMod ℓ → ULift.{u} (ZMod ℓ))
        (j : ZMod ℓ) (w : ↥(FgtX.obj U).left),
        (((α_clop.hom.app (Opposite.op U)).hom (sheetSum U γ c) :
          ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))).1 ((s_diag (γ j)).base w)) =
          c j := by
      intro U γ hSp c j w
      have hmap_sum : (α_clop.hom.app (Opposite.op U)).hom (sheetSum U γ c) =
          Finset.univ.sum fun i : ZMod ℓ =>
            (α_clop.hom.app (Opposite.op U)).hom
              ((L_ab.obj.map (Opposite.op (γ i))).hom (ξ_V.hom (c i))) :=
        map_sum (α_clop.hom.app (Opposite.op U)).hom _ _
      have hsum_val : ∀ (S_fin : Finset (ZMod ℓ))
          (fn : ZMod ℓ → ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))),
          (S_fin.sum fn).1 ((s_diag (γ j)).base w) =
            S_fin.sum fun i => (fn i).1 ((s_diag (γ j)).base w) := by
        intro S_fin fn
        induction S_fin using Finset.cons_induction with
        | empty => rfl
        | cons a s ha ih =>
          rw [Finset.sum_cons, Finset.sum_cons]
          exact congrArg ((fn a).1 ((s_diag (γ j)).base w) + ·) ih
      have hterm_eq : ∀ i : ZMod ℓ,
          (((α_clop.hom.app (Opposite.op U)).hom
            ((L_ab.obj.map (Opposite.op (γ i))).hom (ξ_V.hom (c i))) :
              ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))).1 ((s_diag (γ j)).base w)) =
            if i = j then c i else 0 := by
        intro i
        rw [hα_eval_gen (γ i) (c i) ((s_diag (γ j)).base w)]
        by_cases hij : i = j
        · subst hij
          have hmem : (s_diag (γ i)).base w ∈ Set.range (s_diag (γ i)).base := ⟨w, rfl⟩
          simp [hmem]
        · have hnot : (s_diag (γ j)).base w ∉ Set.range (s_diag (γ i)).base :=
            fun hmem => Set.disjoint_left.mp (hSp.2.1 hij) hmem ⟨w, rfl⟩
          simp [hnot, hij]
      refine (congrArg (fun s : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U)) =>
          s.1 ((s_diag (γ j)).base w)) hmap_sum).trans ?_
      refine (hsum_val Finset.univ _).trans ?_
      simp_rw [hterm_eq]
      simp [Finset.sum_ite_eq', Finset.mem_univ]

    have hAlphaInjZero : ∀ {Z : X.Etale} {γ : ZMod ℓ → (Z ⟶ V'_et)}
        (hSp : IsSplitSheets Z γ) (c : ZMod ℓ → ULift.{u} (ZMod ℓ)),
        (α_clop.hom.app (Opposite.op Z)).hom (sheetSum Z γ c) = 0 →
        sheetSum Z γ c = 0 := by
      intro Z γ hSp c h0
      by_cases hEmp : IsEmpty ↥(FgtX.obj Z).left
      · exact (hSubOfEmpty L_ab Z hEmp).elim _ _
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hEmp
        have hc0 : ∀ i : ZMod ℓ, c i = 0 := by
          intro i
          have hi := (hα_sheetSum_at hSp c i z₀).symm
          rw [h0] at hi
          exact hi
        dsimp only [sheetSum]
        refine Finset.sum_eq_zero fun i _ => ?_
        exact (congrArg (fun a => (L_ab.obj.map (Opposite.op (γ i))).hom (ξ_V.hom a)) (hc0 i)).trans
          ((congrArg (L_ab.obj.map (Opposite.op (γ i))).hom (map_zero ξ_V.hom)).trans (map_zero _))

    have hAlphaInjEq : ∀ {Z : X.Etale} {γ₁ γ₂ : ZMod ℓ → (Z ⟶ V'_et)}
        (hSp₁ : IsSplitSheets Z γ₁) (hSp₂ : IsSplitSheets Z γ₂)
        (c₁ c₂ : ZMod ℓ → ULift.{u} (ZMod ℓ)),
        (α_clop.hom.app (Opposite.op Z)).hom (sheetSum Z γ₁ c₁) =
          (α_clop.hom.app (Opposite.op Z)).hom (sheetSum Z γ₂ c₂) →
        sheetSum Z γ₁ c₁ = sheetSum Z γ₂ c₂ := by
      intro Z γ₁ γ₂ hSp₁ hSp₂ c₁ c₂ hEqα
      have hPointMatch : ∀ (z : ↥(FgtX.obj Z).left) (i : ZMod ℓ),
          ∃ j : ZMod ℓ, (s_diag (γ₁ i)).base z = (s_diag (γ₂ j)).base z := by
        intro z i
        have hmem : (s_diag (γ₁ i)).base z ∈ ⋃ j : ZMod ℓ, Set.range (s_diag (γ₂ j)).base := by
          rw [hSp₂.2.2]; trivial
        obtain ⟨j, w, hw⟩ := Set.mem_iUnion.mp hmem
        have hwz : w = z := by
          have h1 := congrArg (fst_U Z).base hw
          have hL : (fst_U Z).base ((s_diag (γ₂ j)).base w) = w :=
            congrArg (fun k : (FgtX.obj Z).left ⟶ (FgtX.obj Z).left => k.base w)
              (hs_diag_fst (γ₂ j))
          have hR : (fst_U Z).base ((s_diag (γ₁ i)).base z) = z :=
            congrArg (fun k : (FgtX.obj Z).left ⟶ (FgtX.obj Z).left => k.base z)
              (hs_diag_fst (γ₁ i))
          exact hL.symm.trans (h1.trans hR)
        subst hwz
        exact ⟨j, hw.symm⟩
      obtain ⟨π_fn, hπ_spec⟩ : ∃ π_fn : ↥(FgtX.obj Z).left → ZMod ℓ → ZMod ℓ,
          ∀ (z : ↥(FgtX.obj Z).left) (i : ZMod ℓ),
            (s_diag (γ₁ i)).base z = (s_diag (γ₂ (π_fn z i))).base z :=
        ⟨fun z i => Classical.choose (hPointMatch z i),
         fun z i => Classical.choose_spec (hPointMatch z i)⟩
      have hπ_bij : ∀ z : ↥(FgtX.obj Z).left, Function.Bijective (π_fn z) := by
        intro z
        apply Finite.injective_iff_bijective.mp
        intro i₁ i₂ hπ
        by_contra hne
        have heq_pt : (s_diag (γ₁ i₁)).base z = (s_diag (γ₁ i₂)).base z :=
          (hπ_spec z i₁).trans ((congrArg (fun j => (s_diag (γ₂ j)).base z) hπ).trans
            (hπ_spec z i₂).symm)
        exact Set.disjoint_left.mp (hSp₁.2.1 hne) ⟨z, rfl⟩ ⟨z, heq_pt.symm⟩
      let O_match : ↥(FgtX.obj Z).left → ((FgtX.obj Z).left).Opens :=
        fun z =>
          ⟨⋂ i : ZMod ℓ, (s_diag (γ₁ i)).base ⁻¹' Set.range (s_diag (γ₂ (π_fn z i))).base,
           isOpen_iInter_of_finite fun i => by
             have _ : AlgebraicGeometry.IsOpenImmersion (s_diag (γ₂ (π_fn z i))) :=
               hSp₂.1 (π_fn z i)
             exact (s_diag (γ₁ i)).continuous.isOpen_preimage _
               (s_diag (γ₂ (π_fn z i))).isOpenEmbedding.isOpen_range⟩
      have hCov_match : ∀ z : ↥(FgtX.obj Z).left,
          ∃ (z₀ : ↥(FgtX.obj Z).left) (w : ↥(FgtX.obj (openEtObj Z (O_match z₀))).left),
            (FgtX.map (openEtHom Z (O_match z₀))).left.base w = z := by
        intro z
        refine ⟨z, ⟨z, Set.mem_iInter.mpr fun i => ⟨z, (hπ_spec z i).symm⟩⟩, rfl⟩
      let M_Z := L_ab.obj.obj (Opposite.op Z)
      apply (hGlueArrows L_ab Z (fun z => openEtObj Z (O_match z))
        (fun z => openEtHom Z (O_match z)) hCov_match
        (fun z => (L_ab.obj.map (Opposite.op (openEtHom Z (O_match z)))).hom (sheetSum Z γ₁ c₁))
        (fun z₁ z₂ W₀ g₁ g₂ hg =>
          congrArg (fun f : M_Z ⟶ L_ab.obj.obj (Opposite.op W₀) =>
            AddCommGrpCat.Hom.hom f (sheetSum Z γ₁ c₁))
            ((L_ab.obj.map_comp _ _).symm.trans
              ((congrArg L_ab.obj.map (congrArg Opposite.op hg)).trans
                (L_ab.obj.map_comp _ _))))).unique
      · intro z
        rfl
      · intro z
        let j_z := openEtHom Z (O_match z)
        let e_π : ZMod ℓ ≃ ZMod ℓ := Equiv.ofBijective (π_fn z) (hπ_bij z)
        have hc_eq : ∀ i : ZMod ℓ, c₁ i = c₂ (e_π i) := by
          intro i
          have hL := (hα_sheetSum_at hSp₁ c₁ i z).symm
          have hR := hα_sheetSum_at hSp₂ c₂ (e_π i) z
          have hpt : (((α_clop.hom.app (Opposite.op Z)).hom (sheetSum Z γ₁ c₁) :
              ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj Z))).1 ((s_diag (γ₁ i)).base z)) =
            (((α_clop.hom.app (Opposite.op Z)).hom (sheetSum Z γ₂ c₂) :
              ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj Z))).1
                ((s_diag (γ₂ (e_π i))).base z)) := by
            rw [hEqα, hπ_spec z i]
            rfl
          exact hL.trans (hpt.trans hR)
        have hγ_eq : ∀ i : ZMod ℓ, j_z ≫ γ₁ i = j_z ≫ γ₂ (e_π i) := by
          intro i
          have _ : AlgebraicGeometry.IsOpenImmersion (s_diag (γ₂ (e_π i))) := hSp₂.1 (e_π i)
          have hsub : Set.range ((O_match z).ι ≫ s_diag (γ₁ i)).base ⊆
              Set.range (s_diag (γ₂ (e_π i))).base := by
            rintro _ ⟨w, rfl⟩
            exact Set.mem_iInter.mp w.2 i
          let h_lift : (O_match z).toScheme ⟶ (FgtX.obj Z).left :=
            AlgebraicGeometry.IsOpenImmersion.lift (s_diag (γ₂ (e_π i)))
              ((O_match z).ι ≫ s_diag (γ₁ i)) hsub
          have h_fac : h_lift ≫ s_diag (γ₂ (e_π i)) = (O_match z).ι ≫ s_diag (γ₁ i) :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
          have hh_eq : h_lift = (O_match z).ι := by
            have hpost := congrArg (· ≫ fst_U Z) h_fac
            change (h_lift ≫ s_diag (γ₂ (e_π i))) ≫ fst_U Z =
              ((O_match z).ι ≫ s_diag (γ₁ i)) ≫ fst_U Z at hpost
            rw [CategoryTheory.Category.assoc, hs_diag_fst, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.assoc, hs_diag_fst, CategoryTheory.Category.comp_id] at hpost
            exact hpost
          have hs_eq : (O_match z).ι ≫ s_diag (γ₁ i) = (O_match z).ι ≫ s_diag (γ₂ (e_π i)) := by
            rw [← h_fac, hh_eq]
          have hsnd_eq := congrArg (· ≫ snd_U Z) hs_eq
          change ((O_match z).ι ≫ s_diag (γ₁ i)) ≫ snd_U Z =
            ((O_match z).ι ≫ s_diag (γ₂ (e_π i))) ≫ snd_U Z at hsnd_eq
          rw [CategoryTheory.Category.assoc, hs_diag_snd, CategoryTheory.Category.assoc,
            hs_diag_snd, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc] at hsnd_eq
          have hleft_eq : (O_match z).ι ≫ (FgtX.map (γ₁ i)).left =
              (O_match z).ι ≫ (FgtX.map (γ₂ (e_π i))).left :=
            (CategoryTheory.cancel_mono j_V').mp hsnd_eq
          exact CategoryTheory.MorphismProperty.Over.Hom.ext hleft_eq
        have hterm : ∀ i : ZMod ℓ,
            (L_ab.obj.map (Opposite.op (j_z ≫ γ₁ i))).hom (ξ_V.hom (c₁ i)) =
              (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ (e_π i)))).hom (ξ_V.hom (c₂ (e_π i))) := by
          intro i
          exact (congrArg (fun a => (L_ab.obj.map (Opposite.op (j_z ≫ γ₁ i))).hom (ξ_V.hom a))
              (hc_eq i)).trans
            (congrArg (fun u => (L_ab.obj.map (Opposite.op u)).hom (ξ_V.hom (c₂ (e_π i))))
              (hγ_eq i))
        have hsum_eq : sheetSum (openEtObj Z (O_match z)) (fun i => j_z ≫ γ₂ i) c₂ =
            sheetSum (openEtObj Z (O_match z)) (fun i => j_z ≫ γ₁ i) c₁ := by
          dsimp only [sheetSum]
          refine (Equiv.sum_comp e_π fun k =>
            (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ k))).hom (ξ_V.hom (c₂ k))).symm.trans ?_
          exact Finset.sum_congr rfl fun i _ => (hterm i).symm
        exact (hSheetSumPull j_z γ₂ c₂).trans (hsum_eq.trans (hSheetSumPull j_z γ₁ c₁).symm)
    have hLocalSheetChart : ∀ (U : X.Etale) (u : ↥(FgtX.obj U).left),
        (FgtX.obj U).hom.base u ∈ (V : Set ↥X) →
        ∃ (W'_u : X.Etale) (v'_u : W'_u ⟶ U) (y₀ : ↥(FgtX.obj W'_u).left)
          (γ_u : ZMod ℓ → (W'_u ⟶ V'_et)),
          (FgtX.map v'_u).left.base y₀ = u ∧ IsSplitSheets W'_u γ_u := by
      intro U u hu
      obtain ⟨W, _, w, hEt_w, w₀, hw₀, s_sh, hOpen_s, hSnd_s, hDisj_s, hUniv_s⟩ :=
        hSheetSplit_V ⟨(FgtX.obj U).hom.base u, hu⟩
      have _ : AlgebraicGeometry.Etale w := hEt_w
      have _ : AlgebraicGeometry.Etale (FgtX.obj U).hom := U.prop
      let w_X : W ⟶ X := w ≫ V.ι
      let W_base : AlgebraicGeometry.Scheme.{u} :=
        CategoryTheory.Limits.pullback (FgtX.obj U).hom w_X
      let q₁ : W_base ⟶ (FgtX.obj U).left :=
        CategoryTheory.Limits.pullback.fst (FgtX.obj U).hom w_X
      let q₂ : W_base ⟶ W :=
        CategoryTheory.Limits.pullback.snd (FgtX.obj U).hom w_X
      have hu_w₀ : (FgtX.obj U).hom.base u = w_X.base w₀ := (congrArg Subtype.val hw₀).symm
      obtain ⟨y₀, hy₀_1, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback u w₀ hu_w₀
      let W'_u : X.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (q₁ ≫ (FgtX.obj U).hom) inferInstance
      let v'_u : W'_u ⟶ U := CategoryTheory.MorphismProperty.Over.homMk q₁ rfl trivial
      let q₁' : (FgtX.obj W'_u).left ⟶ (FgtX.obj U).left := q₁
      let q₂' : (FgtX.obj W'_u).left ⟶ W := q₂
      have hq_cond : q₁' ≫ (FgtX.obj U).hom = (q₂' ≫ w) ≫ V.ι := by
        change q₁ ≫ (FgtX.obj U).hom = (q₂ ≫ w) ≫ V.ι
        rw [CategoryTheory.Category.assoc]
        exact CategoryTheory.Limits.pullback.condition
      let γ_u : ZMod ℓ → (W'_u ⟶ V'_et) := fun i =>
        CategoryTheory.MorphismProperty.Over.homMk
          (q₂' ≫ s_sh i ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ e_V'.inv)
          (by
            change (q₂' ≫ s_sh i ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ e_V'.inv) ≫
              (FgtX.obj V'_et).hom = q₁' ≫ (FgtX.obj U).hom
            rw [← he_V']
            calc
              (q₂' ≫ s_sh i ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ e_V'.inv) ≫
                  (e_V'.hom ≫ V'_open.ι ≫ g)
                = q₂' ≫ s_sh i ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫
                    (e_V'.inv ≫ e_V'.hom) ≫ (V'_open.ι ≫ g) := by
                    simp only [CategoryTheory.Category.assoc]
              _ = q₂' ≫ s_sh i ≫ (CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ (g ∣_ V)) ≫ V.ι := by
                    rw [e_V'.inv_hom_id, CategoryTheory.Category.id_comp,
                      ← AlgebraicGeometry.morphismRestrict_ι g V, CategoryTheory.Category.assoc]
              _ = q₂' ≫ (s_sh i ≫ CategoryTheory.Limits.pullback.snd (g ∣_ V) w) ≫ w ≫ V.ι := by
                    rw [CategoryTheory.Limits.pullback.condition]
                    simp only [CategoryTheory.Category.assoc]
              _ = q₁' ≫ (FgtX.obj U).hom := by
                    rw [hSnd_s i, CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc,
                      ← hq_cond])
          trivial

      have hW'_hom : (FgtX.obj W'_u).hom = (q₂' ≫ w) ≫ V.ι := hq_cond
      have hRange_snd : Set.range (snd_U W'_u).base ⊆ Set.range V'_open.ι.base := by
        rintro _ ⟨z, rfl⟩
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        change (snd_U W'_u ≫ g).base z ∈ (V : Set ↥X)
        have hcond : (snd_U W'_u ≫ g).base z = (fst_U W'_u ≫ (FgtX.obj W'_u).hom).base z :=
          congrArg (fun k : P_U W'_u ⟶ X => k.base z)
            CategoryTheory.Limits.pullback.condition.symm
        rw [hcond, hW'_hom]
        exact ((q₂' ≫ w).base ((fst_U W'_u).base z)).2
      let q_snd' : P_U W'_u ⟶ V'_open.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V'_open.ι (snd_U W'_u) hRange_snd
      have hq_snd'_fac : q_snd' ≫ V'_open.ι = snd_U W'_u :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V'_open.ι (snd_U W'_u) hRange_snd
      have hq_snd'_comm : q_snd' ≫ (g ∣_ V) = (fst_U W'_u ≫ q₂') ≫ w := by
        refine (CategoryTheory.cancel_mono V.ι).mp ?_
        rw [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι g V,
          ← CategoryTheory.Category.assoc, hq_snd'_fac, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc q₂' w V.ι, ← hW'_hom]
        exact CategoryTheory.Limits.pullback.condition.symm
      have hPb_step1 : CategoryTheory.IsPullback q_snd' (fst_U W'_u) (g ∣_ V) (q₂' ≫ w) := by
        apply CategoryTheory.IsPullback.of_right _
          (hq_snd'_comm.trans (CategoryTheory.Category.assoc _ _ _))
          (AlgebraicGeometry.isPullback_morphismRestrict g V).flip
        rw [hq_snd'_fac, ← hW'_hom]
        exact (CategoryTheory.IsPullback.of_hasPullback (FgtX.obj W'_u).hom g).flip
      let ψ : P_U W'_u ⟶ CategoryTheory.Limits.pullback (g ∣_ V) w :=
        CategoryTheory.Limits.pullback.lift q_snd' (fst_U W'_u ≫ q₂') hq_snd'_comm
      have hψ_fst : ψ ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w = q_snd' :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hψ_snd : ψ ≫ CategoryTheory.Limits.pullback.snd (g ∣_ V) w = fst_U W'_u ≫ q₂' :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hPb_step2 : CategoryTheory.IsPullback ψ (fst_U W'_u)
          (CategoryTheory.Limits.pullback.snd (g ∣_ V) w) q₂' := by
        apply CategoryTheory.IsPullback.of_right _ hψ_snd
          (CategoryTheory.IsPullback.of_hasPullback (g ∣_ V) w)
        rw [hψ_fst]
        exact hPb_step1
      have hs_ψ : ∀ i : ZMod ℓ, s_diag (γ_u i) ≫ ψ = q₂' ≫ s_sh i := by
        intro i
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hψ_fst]
          refine (CategoryTheory.cancel_mono V'_open.ι).mp ?_
          rw [CategoryTheory.Category.assoc, hq_snd'_fac, hs_diag_snd]
          change ((q₂' ≫ s_sh i ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ e_V'.inv) ≫
              e_V'.hom) ≫ V'_open.ι =
            (q₂' ≫ s_sh i ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w) ≫ V'_open.ι
          simp only [CategoryTheory.Category.assoc, e_V'.inv_hom_id,
            CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hψ_snd, ← CategoryTheory.Category.assoc,
            hs_diag_fst, CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc,
            hSnd_s i, CategoryTheory.Category.comp_id]
      have hPb_sheet : ∀ i : ZMod ℓ,
          CategoryTheory.IsPullback q₂' (s_diag (γ_u i)) (s_sh i) ψ := by
        intro i
        have hIso_l : CategoryTheory.IsIso (s_diag (γ_u i) ≫ fst_U W'_u) := by
          rw [hs_diag_fst]; infer_instance
        have hIso_r : CategoryTheory.IsIso
            (s_sh i ≫ CategoryTheory.Limits.pullback.snd (g ∣_ V) w) := by
          rw [hSnd_s i]; infer_instance
        have hOuter : CategoryTheory.IsPullback q₂'
            (s_diag (γ_u i) ≫ fst_U W'_u)
            (s_sh i ≫ CategoryTheory.Limits.pullback.snd (g ∣_ V) w) q₂' :=
          @CategoryTheory.IsPullback.of_vert_isIso _ _ _ _ _ _ _ _ _ _ hIso_l hIso_r
            ⟨by rw [hs_diag_fst, hSnd_s i, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]⟩
        exact CategoryTheory.IsPullback.of_bot hOuter (hs_ψ i).symm hPb_step2
      have hRange_sheet : ∀ i : ZMod ℓ,
          Set.range (s_diag (γ_u i)).base = ψ.base ⁻¹' Set.range (s_sh i).base := by
        intro i
        ext z
        simp only [Set.mem_preimage]
        constructor
        · rintro ⟨y, rfl⟩
          exact ⟨q₂'.base y,
            (congrArg (fun k : (FgtX.obj W'_u).left ⟶ _ => k.base y) (hs_ψ i)).symm⟩
        · rintro ⟨w_pt, hw_pt⟩
          obtain ⟨y, _, hy⟩ := hPre_of_pb (hPb_sheet i) w_pt z hw_pt
          exact ⟨y, hy⟩
      refine ⟨W'_u, v'_u, y₀, γ_u, hy₀_1, ?_, ?_, ?_⟩
      · intro i
        have _ : AlgebraicGeometry.IsOpenImmersion (s_sh i) := hOpen_s i
        exact CategoryTheory.MorphismProperty.of_isPullback
          (P := @AlgebraicGeometry.IsOpenImmersion) (hPb_sheet i) (hOpen_s i)
      · intro i j hij
        rw [hRange_sheet i, hRange_sheet j]
        exact (hDisj_s hij).preimage ψ.base
      · ext z
        simp only [Set.mem_iUnion, hRange_sheet, Set.mem_preimage, Set.mem_univ, iff_true]
        have hz : ψ.base z ∈ ⋃ i : ZMod ℓ, Set.range (s_sh i).base := by
          rw [hUniv_s]; trivial
        exact Set.mem_iUnion.mp hz

    have hβ_local_pkg : ∀ (U : X.Etale)
        (s : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U)))
        (u : ↥(FgtX.obj U).left),
        ∃ (W_u : X.Etale) (v_u : W_u ⟶ U) (u₀ : ↥(FgtX.obj W_u).left)
          (σ_u : ↥(L_ab.obj.obj (Opposite.op W_u))),
          (FgtX.map v_u).left.base u₀ = u ∧
          (α_clop.hom.app (Opposite.op W_u)).hom σ_u =
            ((P_push.obj K'_sh).obj.map (Opposite.op v_u)).hom s ∧
          (σ_u = 0 ∨ ∃ (γ_u : ZMod ℓ → (W_u ⟶ V'_et)) (c_u : ZMod ℓ → ULift.{u} (ZMod ℓ)),
            IsSplitSheets W_u γ_u ∧ σ_u = sheetSum W_u γ_u c_u) := by
      intro U s u
      by_cases hu : (FgtX.obj U).hom.base u ∈ (V : Set ↥X)
      · obtain ⟨W'_u, v'_u, y₀, γ'_u, hy₀, hSp'⟩ := hLocalSheetChart U u hu
        let s' : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj W'_u)) :=
          ((P_push.obj K'_sh).obj.map (Opposite.op v'_u)).hom s
        let c_u : ZMod ℓ → ULift.{u} (ZMod ℓ) :=
          fun i => s'.1 ((s_diag (γ'_u i)).base y₀)
        let O_u : ((FgtX.obj W'_u).left).Opens :=
          ⟨⋂ i : ZMod ℓ, (s_diag (γ'_u i)).base ⁻¹' (s'.1 ⁻¹' {c_u i}),
           isOpen_iInter_of_finite fun i =>
             (s_diag (γ'_u i)).continuous.isOpen_preimage _ (s'.1.isLocallyConstant {c_u i})⟩
        let W_u : X.Etale := openEtObj W'_u O_u
        let j_O : W_u ⟶ W'_u := openEtHom W'_u O_u
        let v_u : W_u ⟶ U := j_O ≫ v'_u
        let u₀ : ↥(FgtX.obj W_u).left := ⟨y₀, Set.mem_iInter.mpr fun _ => rfl⟩
        let γ_u : ZMod ℓ → (W_u ⟶ V'_et) := fun i => j_O ≫ γ'_u i
        have hSp : IsSplitSheets W_u γ_u := hSplitPull j_O γ'_u hSp'
        let σ_u : ↥(L_ab.obj.obj (Opposite.op W_u)) := sheetSum W_u γ_u c_u
        refine ⟨W_u, v_u, u₀, σ_u, hy₀, ?_, Or.inr ⟨γ_u, c_u, hSp, rfl⟩⟩
        apply Subtype.ext
        apply LocallyConstant.ext
        intro z
        have hcov : z ∈ ⋃ j : ZMod ℓ, Set.range (s_diag (γ_u j)).base := by
          rw [hSp.2.2]; trivial
        obtain ⟨j, w, rfl⟩ := Set.mem_iUnion.mp hcov
        refine (hα_sheetSum_at hSp c_u j w).trans ?_
        have hnat_z : (map_Bg j_O).base ((s_diag (γ_u j)).base w) =
            (s_diag (γ'_u j)).base w.1 :=
          congrArg (fun k : (FgtX.obj W_u).left ⟶ P_U W'_u => k.base w)
            (hs_diag_nat j_O (γ'_u j))
        have hw_mem : s'.1 ((s_diag (γ'_u j)).base w.1) = c_u j :=
          Set.mem_iInter.mp w.2 j
        refine hw_mem.symm.trans ?_
        change s'.1 ((s_diag (γ'_u j)).base w.1) =
          s.1 ((map_Bg (j_O ≫ v'_u)).base ((s_diag (γ_u j)).base w))
        have hcomp_Bg : map_Bg (j_O ≫ v'_u) = map_Bg j_O ≫ map_Bg v'_u :=
          congrArg (fun m => (FgtX'.map m).left) (B_g.map_comp j_O v'_u)
        have hpt : (map_Bg (j_O ≫ v'_u)).base ((s_diag (γ_u j)).base w) =
            (map_Bg v'_u).base ((s_diag (γ'_u j)).base w.1) :=
          (congrArg (fun k : P_U W_u ⟶ P_U U => k.base ((s_diag (γ_u j)).base w)) hcomp_Bg).trans
            (congrArg (map_Bg v'_u).base hnat_z)
        exact congrArg s.1 hpt.symm
      · let F_supp : Set ↥(P_U U) := (s.1 ⁻¹' {(0 : ULift.{u} (ZMod ℓ))})ᶜ
        have hF_cl : IsClosed F_supp := (s.1.isLocallyConstant {0}).isClosed_compl
        have hImg_cl : IsClosed ((fst_U U).base '' F_supp) :=
          (fst_U U).isClosedMap F_supp hF_cl
        have hu_not : u ∉ (fst_U U).base '' F_supp := by
          rintro ⟨z, hzF, hzu⟩
          apply hzF
          change s.1 z = 0
          apply s.2 z
          change g.base ((snd_U U).base z) ∉ (V : Set ↥X)
          have hcond : (snd_U U ≫ g).base z = (fst_U U ≫ (FgtX.obj U).hom).base z :=
            congrArg (fun k : P_U U ⟶ X => k.base z)
              CategoryTheory.Limits.pullback.condition.symm
          change (snd_U U ≫ g).base z ∉ (V : Set ↥X)
          rw [hcond]
          change (FgtX.obj U).hom.base ((fst_U U).base z) ∉ (V : Set ↥X)
          rwa [hzu]
        let O_u : ((FgtX.obj U).left).Opens := ⟨((fst_U U).base '' F_supp)ᶜ, hImg_cl.isOpen_compl⟩
        let W_u : X.Etale := openEtObj U O_u
        let v_u : W_u ⟶ U := openEtHom U O_u
        let u₀ : ↥(FgtX.obj W_u).left := ⟨u, hu_not⟩
        refine ⟨W_u, v_u, u₀, 0, rfl, ?_, Or.inl rfl⟩
        rw [map_zero]
        apply Subtype.ext
        apply LocallyConstant.ext
        intro z
        symm
        change s.1 ((map_Bg v_u).base z) = 0
        by_contra hne
        have hmemF : (map_Bg v_u).base z ∈ F_supp := hne
        have hfst_z : (fst_U U).base ((map_Bg v_u).base z) = ((fst_U W_u).base z).1 :=
          congrArg (fun k : P_U W_u ⟶ (FgtX.obj U).left => k.base z) (hmap_Bg_fst v_u)
        exact ((fst_U W_u).base z).2 ⟨(map_Bg v_u).base z, hmemF, hfst_z⟩

    have hRepEqOfAlpha : ∀ {Z : X.Etale} (σ₁ σ₂ : ↥(L_ab.obj.obj (Opposite.op Z))),
        (σ₁ = 0 ∨ ∃ (γ₁ : ZMod ℓ → (Z ⟶ V'_et)) (c₁ : ZMod ℓ → ULift.{u} (ZMod ℓ)),
          IsSplitSheets Z γ₁ ∧ σ₁ = sheetSum Z γ₁ c₁) →
        (σ₂ = 0 ∨ ∃ (γ₂ : ZMod ℓ → (Z ⟶ V'_et)) (c₂ : ZMod ℓ → ULift.{u} (ZMod ℓ)),
          IsSplitSheets Z γ₂ ∧ σ₂ = sheetSum Z γ₂ c₂) →
        (α_clop.hom.app (Opposite.op Z)).hom σ₁ = (α_clop.hom.app (Opposite.op Z)).hom σ₂ →
        σ₁ = σ₂ := by
      intro Z σ₁ σ₂ h₁ h₂ hα
      rcases h₁ with rfl | ⟨γ₁, c₁, hSp₁, rfl⟩ <;> rcases h₂ with rfl | ⟨γ₂, c₂, hSp₂, rfl⟩
      · rfl
      · rw [map_zero] at hα
        exact (hAlphaInjZero hSp₂ c₂ hα.symm).symm
      · rw [map_zero] at hα
        exact hAlphaInjZero hSp₁ c₁ hα
      · exact hAlphaInjEq hSp₁ hSp₂ c₁ c₂ hα

    have hRepPull : ∀ {Z₁ Z₂ : X.Etale} (u : Z₁ ⟶ Z₂) (σ : ↥(L_ab.obj.obj (Opposite.op Z₂))),
        (σ = 0 ∨ ∃ (γ : ZMod ℓ → (Z₂ ⟶ V'_et)) (c : ZMod ℓ → ULift.{u} (ZMod ℓ)),
          IsSplitSheets Z₂ γ ∧ σ = sheetSum Z₂ γ c) →
        ((L_ab.obj.map (Opposite.op u)).hom σ = 0 ∨
          ∃ (γ' : ZMod ℓ → (Z₁ ⟶ V'_et)) (c' : ZMod ℓ → ULift.{u} (ZMod ℓ)),
            IsSplitSheets Z₁ γ' ∧ (L_ab.obj.map (Opposite.op u)).hom σ = sheetSum Z₁ γ' c') := by
      intro Z₁ Z₂ u σ hσ
      rcases hσ with rfl | ⟨γ, c, hSp, rfl⟩
      · exact Or.inl (map_zero _)
      · exact Or.inr ⟨fun i => u ≫ γ i, c, hSplitPull u γ hSp, hSheetSumPull u γ c⟩

    obtain ⟨W_loc, v_loc, u₀_loc, σ_loc, hloc_pkg⟩ :
        ∃ (W_loc : ∀ (U : X.Etale), ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U)) →
            ↥(FgtX.obj U).left → X.Etale)
          (v_loc : ∀ U s u, W_loc U s u ⟶ U)
          (u₀_loc : ∀ U s u, ↥(FgtX.obj (W_loc U s u)).left)
          (σ_loc : ∀ U s u, ↥(L_ab.obj.obj (Opposite.op (W_loc U s u)))),
          ∀ U s u,
            (FgtX.map (v_loc U s u)).left.base (u₀_loc U s u) = u ∧
            (α_clop.hom.app (Opposite.op (W_loc U s u))).hom (σ_loc U s u) =
              ((P_push.obj K'_sh).obj.map (Opposite.op (v_loc U s u))).hom s ∧
            (σ_loc U s u = 0 ∨
              ∃ (γ_u : ZMod ℓ → (W_loc U s u ⟶ V'_et)) (c_u : ZMod ℓ → ULift.{u} (ZMod ℓ)),
                IsSplitSheets (W_loc U s u) γ_u ∧
                σ_loc U s u = sheetSum (W_loc U s u) γ_u c_u) :=
      ⟨fun U s u => Classical.choose (hβ_local_pkg U s u),
       fun U s u => Classical.choose (Classical.choose_spec (hβ_local_pkg U s u)),
       fun U s u => Classical.choose (Classical.choose_spec
         (Classical.choose_spec (hβ_local_pkg U s u))),
       fun U s u => Classical.choose (Classical.choose_spec (Classical.choose_spec
         (Classical.choose_spec (hβ_local_pkg U s u)))),
       fun U s u => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
         (Classical.choose_spec (hβ_local_pkg U s u))))⟩

    have hβ_ex_uniq : ∀ (U : X.Etale)
        (s : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))),
        ∃! t : ↥(L_ab.obj.obj (Opposite.op U)),
          ∀ u : ↥(FgtX.obj U).left,
            (L_ab.obj.map (Opposite.op (v_loc U s u))).hom t = σ_loc U s u := by
      intro U s
      apply hGlueArrows L_ab U (W_loc U s) (v_loc U s)
        (fun u => ⟨u, u₀_loc U s u, (hloc_pkg U s u).1⟩) (σ_loc U s)
      intro u₁ u₂ Z g₁ g₂ hg
      apply hRepEqOfAlpha _ _ (hRepPull g₁ (σ_loc U s u₁) (hloc_pkg U s u₁).2.2)
        (hRepPull g₂ (σ_loc U s u₂) (hloc_pkg U s u₂).2.2)
      let src₁ := L_ab.obj.obj (Opposite.op (W_loc U s u₁))
      let src₂ := L_ab.obj.obj (Opposite.op (W_loc U s u₂))
      let dst := (P_push.obj K'_sh).obj.obj (Opposite.op Z)
      let top := (P_push.obj K'_sh).obj.obj (Opposite.op U)
      have hnat₁ := congrArg (fun f : src₁ ⟶ dst => AddCommGrpCat.Hom.hom f (σ_loc U s u₁))
        (α_clop.hom.naturality (Opposite.op g₁))
      have hnat₂ := congrArg (fun f : src₂ ⟶ dst => AddCommGrpCat.Hom.hom f (σ_loc U s u₂))
        (α_clop.hom.naturality (Opposite.op g₂))
      change (α_clop.hom.app (Opposite.op Z)).hom
          ((L_ab.obj.map (Opposite.op g₁)).hom (σ_loc U s u₁)) =
        ((P_push.obj K'_sh).obj.map (Opposite.op g₁)).hom
          ((α_clop.hom.app (Opposite.op (W_loc U s u₁))).hom (σ_loc U s u₁)) at hnat₁
      change (α_clop.hom.app (Opposite.op Z)).hom
          ((L_ab.obj.map (Opposite.op g₂)).hom (σ_loc U s u₂)) =
        ((P_push.obj K'_sh).obj.map (Opposite.op g₂)).hom
          ((α_clop.hom.app (Opposite.op (W_loc U s u₂))).hom (σ_loc U s u₂)) at hnat₂
      refine hnat₁.trans ?_
      refine (congrArg ((P_push.obj K'_sh).obj.map (Opposite.op g₁)).hom
        (hloc_pkg U s u₁).2.1).trans ?_
      refine (congrArg (fun f : top ⟶ dst => AddCommGrpCat.Hom.hom f s)
        (((P_push.obj K'_sh).obj.map_comp _ _).symm.trans
          ((congrArg (P_push.obj K'_sh).obj.map (congrArg Opposite.op hg)).trans
            ((P_push.obj K'_sh).obj.map_comp _ _)))).trans ?_
      exact (congrArg ((P_push.obj K'_sh).obj.map (Opposite.op g₂)).hom
        (hloc_pkg U s u₂).2.1).symm.trans hnat₂.symm

    obtain ⟨β_fn, hβ_spec⟩ :
        ∃ β_fn : ∀ (U : X.Etale),
            ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U)) → ↥(L_ab.obj.obj (Opposite.op U)),
          ∀ U s u, (L_ab.obj.map (Opposite.op (v_loc U s u))).hom (β_fn U s) = σ_loc U s u :=
      ⟨fun U s => Classical.choose (hβ_ex_uniq U s),
       fun U s => (Classical.choose_spec (hβ_ex_uniq U s)).1⟩

    have hα_of_β : ∀ (U : X.Etale)
        (s : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U))),
        (α_clop.hom.app (Opposite.op U)).hom (β_fn U s) = s := by
      intro U s
      let M_top := (P_push.obj K'_sh).obj.obj (Opposite.op U)
      apply (hGlueArrows (P_push.obj K'_sh) U (W_loc U s) (v_loc U s)
        (fun u => ⟨u, u₀_loc U s u, (hloc_pkg U s u).1⟩)
        (fun u => ((P_push.obj K'_sh).obj.map (Opposite.op (v_loc U s u))).hom s)
        (fun u₁ u₂ Z g₁ g₂ hg =>
          congrArg (fun f : M_top ⟶ (P_push.obj K'_sh).obj.obj (Opposite.op Z) =>
            AddCommGrpCat.Hom.hom f s)
            (((P_push.obj K'_sh).obj.map_comp _ _).symm.trans
              ((congrArg (P_push.obj K'_sh).obj.map (congrArg Opposite.op hg)).trans
                ((P_push.obj K'_sh).obj.map_comp _ _))))).unique
      · intro u
        let src := L_ab.obj.obj (Opposite.op U)
        let dst := (P_push.obj K'_sh).obj.obj (Opposite.op (W_loc U s u))
        have hnat := congrArg (fun f : src ⟶ dst => AddCommGrpCat.Hom.hom f (β_fn U s))
          (α_clop.hom.naturality (Opposite.op (v_loc U s u)))
        change (α_clop.hom.app (Opposite.op (W_loc U s u))).hom
            ((L_ab.obj.map (Opposite.op (v_loc U s u))).hom (β_fn U s)) =
          ((P_push.obj K'_sh).obj.map (Opposite.op (v_loc U s u))).hom
            ((α_clop.hom.app (Opposite.op U)).hom (β_fn U s)) at hnat
        exact hnat.symm.trans ((congrArg (α_clop.hom.app (Opposite.op (W_loc U s u))).hom
          (hβ_spec U s u)).trans (hloc_pkg U s u).2.1)
      · intro _
        rfl

    have hAddSheetRep : ∀ {Z : X.Etale} (σ₁ σ₂ : ↥(L_ab.obj.obj (Opposite.op Z))),
        (σ₁ = 0 ∨ ∃ (γ₁ : ZMod ℓ → (Z ⟶ V'_et)) (c₁ : ZMod ℓ → ULift.{u} (ZMod ℓ)),
          IsSplitSheets Z γ₁ ∧ σ₁ = sheetSum Z γ₁ c₁) →
        (σ₂ = 0 ∨ ∃ (γ₂ : ZMod ℓ → (Z ⟶ V'_et)) (c₂ : ZMod ℓ → ULift.{u} (ZMod ℓ)),
          IsSplitSheets Z γ₂ ∧ σ₂ = sheetSum Z γ₂ c₂) →
        ∀ z : ↥(FgtX.obj Z).left,
          ∃ (O_z : ((FgtX.obj Z).left).Opens), z ∈ O_z ∧
            let W_z := openEtObj Z O_z
            let j_z := openEtHom Z O_z
            ((L_ab.obj.map (Opposite.op j_z)).hom (σ₁ + σ₂) = 0 ∨
              ∃ (γ' : ZMod ℓ → (W_z ⟶ V'_et)) (c' : ZMod ℓ → ULift.{u} (ZMod ℓ)),
                IsSplitSheets W_z γ' ∧
                (L_ab.obj.map (Opposite.op j_z)).hom (σ₁ + σ₂) = sheetSum W_z γ' c') := by
      intro Z σ₁ σ₂ h₁ h₂ z
      rcases h₁ with rfl | ⟨γ₁, c₁, hSp₁, rfl⟩
      · refine ⟨⊤, trivial, ?_⟩
        rw [zero_add]
        exact hRepPull _ σ₂ h₂
      · rcases h₂ with rfl | ⟨γ₂, c₂, hSp₂, rfl⟩
        · refine ⟨⊤, trivial, ?_⟩
          rw [add_zero]
          exact Or.inr ⟨fun i => openEtHom Z ⊤ ≫ γ₁ i, c₁,
            hSplitPull _ γ₁ hSp₁, hSheetSumPull _ γ₁ c₁⟩
        · have hPointMatch : ∀ i : ZMod ℓ,
              ∃ j : ZMod ℓ, (s_diag (γ₁ i)).base z = (s_diag (γ₂ j)).base z := by
            intro i
            have hmem : (s_diag (γ₁ i)).base z ∈ ⋃ j : ZMod ℓ, Set.range (s_diag (γ₂ j)).base := by
              rw [hSp₂.2.2]; trivial
            obtain ⟨j, w, hw⟩ := Set.mem_iUnion.mp hmem
            have hwz : w = z := by
              have h1 := congrArg (fst_U Z).base hw
              have hL : (fst_U Z).base ((s_diag (γ₂ j)).base w) = w :=
                congrArg (fun k : (FgtX.obj Z).left ⟶ (FgtX.obj Z).left => k.base w)
                  (hs_diag_fst (γ₂ j))
              have hR : (fst_U Z).base ((s_diag (γ₁ i)).base z) = z :=
                congrArg (fun k : (FgtX.obj Z).left ⟶ (FgtX.obj Z).left => k.base z)
                  (hs_diag_fst (γ₁ i))
              exact hL.symm.trans (h1.trans hR)
            subst hwz
            exact ⟨j, hw.symm⟩
          obtain ⟨π_z, hπ_spec⟩ : ∃ π_z : ZMod ℓ → ZMod ℓ,
              ∀ i : ZMod ℓ, (s_diag (γ₁ i)).base z = (s_diag (γ₂ (π_z i))).base z :=
            ⟨fun i => Classical.choose (hPointMatch i),
             fun i => Classical.choose_spec (hPointMatch i)⟩
          have hπ_bij : Function.Bijective π_z := by
            apply Finite.injective_iff_bijective.mp
            intro i₁ i₂ hπ
            by_contra hne
            have heq_pt : (s_diag (γ₁ i₁)).base z = (s_diag (γ₁ i₂)).base z :=
              (hπ_spec i₁).trans ((congrArg (fun j => (s_diag (γ₂ j)).base z) hπ).trans
                (hπ_spec i₂).symm)
            exact Set.disjoint_left.mp (hSp₁.2.1 hne) ⟨z, rfl⟩ ⟨z, heq_pt.symm⟩
          let e_π : ZMod ℓ ≃ ZMod ℓ := Equiv.ofBijective π_z hπ_bij
          let O_z : ((FgtX.obj Z).left).Opens :=
            ⟨⋂ i : ZMod ℓ, (s_diag (γ₁ i)).base ⁻¹' Set.range (s_diag (γ₂ (e_π i))).base,
             isOpen_iInter_of_finite fun i => by
               have _ : AlgebraicGeometry.IsOpenImmersion (s_diag (γ₂ (e_π i))) := hSp₂.1 (e_π i)
               exact (s_diag (γ₁ i)).continuous.isOpen_preimage _
                 (s_diag (γ₂ (e_π i))).isOpenEmbedding.isOpen_range⟩
          have hz_mem : z ∈ O_z := Set.mem_iInter.mpr fun i => ⟨z, (hπ_spec i).symm⟩
          let W_z := openEtObj Z O_z
          let j_z := openEtHom Z O_z
          have hγ_eq : ∀ i : ZMod ℓ, j_z ≫ γ₁ i = j_z ≫ γ₂ (e_π i) := by
            intro i
            have _ : AlgebraicGeometry.IsOpenImmersion (s_diag (γ₂ (e_π i))) := hSp₂.1 (e_π i)
            have hsub : Set.range (O_z.ι ≫ s_diag (γ₁ i)).base ⊆
                Set.range (s_diag (γ₂ (e_π i))).base := by
              rintro _ ⟨w, rfl⟩
              exact Set.mem_iInter.mp w.2 i
            let h_lift : O_z.toScheme ⟶ (FgtX.obj Z).left :=
              AlgebraicGeometry.IsOpenImmersion.lift (s_diag (γ₂ (e_π i)))
                (O_z.ι ≫ s_diag (γ₁ i)) hsub
            have h_fac : h_lift ≫ s_diag (γ₂ (e_π i)) = O_z.ι ≫ s_diag (γ₁ i) :=
              AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
            have hh_eq : h_lift = O_z.ι := by
              have hpost := congrArg (· ≫ fst_U Z) h_fac
              change (h_lift ≫ s_diag (γ₂ (e_π i))) ≫ fst_U Z =
                (O_z.ι ≫ s_diag (γ₁ i)) ≫ fst_U Z at hpost
              rw [CategoryTheory.Category.assoc, hs_diag_fst, CategoryTheory.Category.comp_id,
                CategoryTheory.Category.assoc, hs_diag_fst, CategoryTheory.Category.comp_id] at hpost
              exact hpost
            have hs_eq : O_z.ι ≫ s_diag (γ₁ i) = O_z.ι ≫ s_diag (γ₂ (e_π i)) := by
              rw [← h_fac, hh_eq]
            have hsnd_eq := congrArg (· ≫ snd_U Z) hs_eq
            change (O_z.ι ≫ s_diag (γ₁ i)) ≫ snd_U Z =
              (O_z.ι ≫ s_diag (γ₂ (e_π i))) ≫ snd_U Z at hsnd_eq
            rw [CategoryTheory.Category.assoc, hs_diag_snd, CategoryTheory.Category.assoc,
              hs_diag_snd, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc] at hsnd_eq
            exact CategoryTheory.MorphismProperty.Over.Hom.ext
              ((CategoryTheory.cancel_mono j_V').mp hsnd_eq)
          refine ⟨O_z, hz_mem, Or.inr ⟨fun j => j_z ≫ γ₂ j, fun j => c₁ (e_π.symm j) + c₂ j,
            hSplitPull j_z γ₂ hSp₂, ?_⟩⟩
          have hmap_add : (L_ab.obj.map (Opposite.op j_z)).hom
              (sheetSum Z γ₁ c₁ + sheetSum Z γ₂ c₂) =
              sheetSum W_z (fun i => j_z ≫ γ₁ i) c₁ + sheetSum W_z (fun j => j_z ≫ γ₂ j) c₂ :=
            (map_add (L_ab.obj.map (Opposite.op j_z)).hom _ _).trans
              (congrArg₂ (· + ·) (hSheetSumPull j_z γ₁ c₁) (hSheetSumPull j_z γ₂ c₂))
          refine hmap_add.trans ?_
          dsimp only [sheetSum]
          have hsum₁ : (Finset.univ.sum fun i : ZMod ℓ =>
              (L_ab.obj.map (Opposite.op (j_z ≫ γ₁ i))).hom (ξ_V.hom (c₁ i))) =
            Finset.univ.sum fun j : ZMod ℓ =>
              (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ j))).hom (ξ_V.hom (c₁ (e_π.symm j))) := by
            have hterm : ∀ i : ZMod ℓ,
                (L_ab.obj.map (Opposite.op (j_z ≫ γ₁ i))).hom (ξ_V.hom (c₁ i)) =
                (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ (e_π i)))).hom
                  (ξ_V.hom (c₁ (e_π.symm (e_π i)))) := by
              intro i
              exact (congrArg (fun u => (L_ab.obj.map (Opposite.op u)).hom (ξ_V.hom (c₁ i)))
                  (hγ_eq i)).trans
                (congrArg (fun a => (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ (e_π i)))).hom (ξ_V.hom a))
                  (congrArg c₁ (e_π.symm_apply_apply i)).symm)
            exact (Finset.sum_congr rfl fun i _ => hterm i).trans
              (Equiv.sum_comp e_π fun j =>
                (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ j))).hom (ξ_V.hom (c₁ (e_π.symm j))))
          refine (congrArg (· + Finset.univ.sum fun j : ZMod ℓ =>
              (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ j))).hom (ξ_V.hom (c₂ j))) hsum₁).trans ?_
          refine Finset.sum_add_distrib.symm.trans (Finset.sum_congr rfl fun j _ => ?_)
          exact ((congrArg (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ j))).hom
              (map_add ξ_V.hom (c₁ (e_π.symm j)) (c₂ j))).trans
            (map_add (L_ab.obj.map (Opposite.op (j_z ≫ γ₂ j))).hom _ _)).symm

    have hInjOfLocalRep : ∀ {U : X.Etale} (t₁ t₂ : ↥(L_ab.obj.obj (Opposite.op U))),
        (∀ u : ↥(FgtX.obj U).left,
          ∃ (W₁ : X.Etale) (v₁ : W₁ ⟶ U) (y₁ : ↥(FgtX.obj W₁).left),
            (FgtX.map v₁).left.base y₁ = u ∧
            ((L_ab.obj.map (Opposite.op v₁)).hom t₁ = 0 ∨
              ∃ γ c, IsSplitSheets W₁ γ ∧ (L_ab.obj.map (Opposite.op v₁)).hom t₁ = sheetSum W₁ γ c)) →
        (∀ u : ↥(FgtX.obj U).left,
          ∃ (W₂ : X.Etale) (v₂ : W₂ ⟶ U) (y₂ : ↥(FgtX.obj W₂).left),
            (FgtX.map v₂).left.base y₂ = u ∧
            ((L_ab.obj.map (Opposite.op v₂)).hom t₂ = 0 ∨
              ∃ γ c, IsSplitSheets W₂ γ ∧ (L_ab.obj.map (Opposite.op v₂)).hom t₂ = sheetSum W₂ γ c)) →
        (α_clop.hom.app (Opposite.op U)).hom t₁ = (α_clop.hom.app (Opposite.op U)).hom t₂ →
        t₁ = t₂ := by
      intro U t₁ t₂ hLoc₁ hLoc₂ hEqα
      have hCommon : ∀ u : ↥(FgtX.obj U).left,
          ∃ (Z_u : X.Etale) (f_u : Z_u ⟶ U) (z_u : ↥(FgtX.obj Z_u).left),
            (FgtX.map f_u).left.base z_u = u ∧
            (L_ab.obj.map (Opposite.op f_u)).hom t₁ = (L_ab.obj.map (Opposite.op f_u)).hom t₂ := by
        intro u
        obtain ⟨W₁, v₁, y₁, hy₁, hR₁⟩ := hLoc₁ u
        obtain ⟨W₂, v₂, y₂, hy₂, hR₂⟩ := hLoc₂ u
        let m₁ : (FgtX.obj W₁).left ⟶ (FgtX.obj U).left := (FgtX.map v₁).left
        let m₂ : (FgtX.obj W₂).left ⟶ (FgtX.obj U).left := (FgtX.map v₂).left
        have _ : AlgebraicGeometry.Etale m₁ := hEt_map v₁
        have _ : AlgebraicGeometry.Etale m₂ := hEt_map v₂
        have _ : AlgebraicGeometry.Etale (FgtX.obj W₁).hom := W₁.prop
        let P_12 := CategoryTheory.Limits.pullback m₁ m₂
        let p₁ : P_12 ⟶ (FgtX.obj W₁).left := CategoryTheory.Limits.pullback.fst m₁ m₂
        let p₂ : P_12 ⟶ (FgtX.obj W₂).left := CategoryTheory.Limits.pullback.snd m₁ m₂
        obtain ⟨z_u, hz₁, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ (hy₁.trans hy₂.symm)
        let Z_u : X.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (FgtX.obj W₁).hom) inferInstance
        let g₁ : Z_u ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        let g₂ : Z_u ⟶ W₂ :=
          CategoryTheory.MorphismProperty.Over.homMk p₂
            (by
              change p₂ ≫ (FgtX.obj W₂).hom = p₁ ≫ (FgtX.obj W₁).hom
              have hw₁ : m₁ ≫ (FgtX.obj U).hom = (FgtX.obj W₁).hom :=
                CategoryTheory.MorphismProperty.Over.w v₁
              have hw₂ : m₂ ≫ (FgtX.obj U).hom = (FgtX.obj W₂).hom :=
                CategoryTheory.MorphismProperty.Over.w v₂
              rw [← hw₁, ← hw₂, ← CategoryTheory.Category.assoc,
                ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
            trivial
        let f_u : Z_u ⟶ U := g₁ ≫ v₁
        have hfu_eq : f_u = g₂ ≫ v₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        have hfu_pt : (FgtX.map f_u).left.base z_u = u := by
          change m₁.base (p₁.base z_u) = u
          rw [hz₁, hy₁]
        refine ⟨Z_u, f_u, z_u, hfu_pt, ?_⟩
        let M_U := L_ab.obj.obj (Opposite.op U)
        let M_Z := L_ab.obj.obj (Opposite.op Z_u)
        have ht₁_g : (L_ab.obj.map (Opposite.op f_u)).hom t₁ =
            (L_ab.obj.map (Opposite.op g₁)).hom ((L_ab.obj.map (Opposite.op v₁)).hom t₁) :=
          congrArg (fun f : M_U ⟶ M_Z => AddCommGrpCat.Hom.hom f t₁) (L_ab.obj.map_comp _ _)
        have ht₂_g : (L_ab.obj.map (Opposite.op f_u)).hom t₂ =
            (L_ab.obj.map (Opposite.op g₂)).hom ((L_ab.obj.map (Opposite.op v₂)).hom t₂) :=
          congrArg (fun f : M_U ⟶ M_Z => AddCommGrpCat.Hom.hom f t₂)
            ((congrArg L_ab.obj.map (congrArg Opposite.op hfu_eq)).trans (L_ab.obj.map_comp _ _))
        have hsub_eq :
            (L_ab.obj.map (Opposite.op g₁)).hom ((L_ab.obj.map (Opposite.op v₁)).hom t₁) =
            (L_ab.obj.map (Opposite.op g₂)).hom ((L_ab.obj.map (Opposite.op v₂)).hom t₂) := by
          apply hRepEqOfAlpha _ _ (hRepPull g₁ _ hR₁) (hRepPull g₂ _ hR₂)
          let dst_Z := (P_push.obj K'_sh).obj.obj (Opposite.op Z_u)
          have hnat₁ := congrArg (fun f : M_U ⟶ dst_Z => AddCommGrpCat.Hom.hom f t₁)
            (α_clop.hom.naturality (Opposite.op f_u))
          have hnat₂ := congrArg (fun f : M_U ⟶ dst_Z => AddCommGrpCat.Hom.hom f t₂)
            (α_clop.hom.naturality (Opposite.op f_u))
          change (α_clop.hom.app (Opposite.op Z_u)).hom ((L_ab.obj.map (Opposite.op f_u)).hom t₁) =
            ((P_push.obj K'_sh).obj.map (Opposite.op f_u)).hom
              ((α_clop.hom.app (Opposite.op U)).hom t₁) at hnat₁
          change (α_clop.hom.app (Opposite.op Z_u)).hom ((L_ab.obj.map (Opposite.op f_u)).hom t₂) =
            ((P_push.obj K'_sh).obj.map (Opposite.op f_u)).hom
              ((α_clop.hom.app (Opposite.op U)).hom t₂) at hnat₂
          exact (congrArg (α_clop.hom.app (Opposite.op Z_u)).hom ht₁_g.symm).trans
            (hnat₁.trans ((congrArg ((P_push.obj K'_sh).obj.map (Opposite.op f_u)).hom hEqα).trans
              (hnat₂.symm.trans (congrArg (α_clop.hom.app (Opposite.op Z_u)).hom ht₂_g))))
        exact ht₁_g.trans (hsub_eq.trans ht₂_g.symm)
      obtain ⟨Z_u, f_u, z_u, hf_spec⟩ :
          ∃ (Z_u : ↥(FgtX.obj U).left → X.Etale)
            (f_u : ∀ u, Z_u u ⟶ U)
            (z_u : ∀ u, ↥(FgtX.obj (Z_u u)).left),
            ∀ u, (FgtX.map (f_u u)).left.base (z_u u) = u ∧
              (L_ab.obj.map (Opposite.op (f_u u))).hom t₁ =
                (L_ab.obj.map (Opposite.op (f_u u))).hom t₂ :=
        ⟨fun u => Classical.choose (hCommon u),
         fun u => Classical.choose (Classical.choose_spec (hCommon u)),
         fun u => Classical.choose (Classical.choose_spec (Classical.choose_spec (hCommon u))),
         fun u => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCommon u)))⟩
      let M_U := L_ab.obj.obj (Opposite.op U)
      exact (hGlueArrows L_ab U Z_u f_u (fun u => ⟨u, z_u u, (hf_spec u).1⟩)
        (fun u => (L_ab.obj.map (Opposite.op (f_u u))).hom t₁)
        (fun u₁ u₂ W₀ g₁ g₂ hg =>
          congrArg (fun f : M_U ⟶ L_ab.obj.obj (Opposite.op W₀) => AddCommGrpCat.Hom.hom f t₁)
            ((L_ab.obj.map_comp _ _).symm.trans
              ((congrArg L_ab.obj.map (congrArg Opposite.op hg)).trans
                (L_ab.obj.map_comp _ _))))).unique
        (fun _ => rfl) (fun u => ((hf_spec u).2).symm)

    have hβ_hasLocalRep : ∀ (U : X.Etale)
        (s : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U)))
        (u : ↥(FgtX.obj U).left),
        ∃ (W₁ : X.Etale) (v₁ : W₁ ⟶ U) (y₁ : ↥(FgtX.obj W₁).left),
          (FgtX.map v₁).left.base y₁ = u ∧
          ((L_ab.obj.map (Opposite.op v₁)).hom (β_fn U s) = 0 ∨
            ∃ γ c, IsSplitSheets W₁ γ ∧
              (L_ab.obj.map (Opposite.op v₁)).hom (β_fn U s) = sheetSum W₁ γ c) := by
      intro U s u
      refine ⟨W_loc U s u, v_loc U s u, u₀_loc U s u, (hloc_pkg U s u).1, ?_⟩
      rw [hβ_spec U s u]
      exact (hloc_pkg U s u).2.2

    let β_clop : P_push.obj K'_sh ⟶ L_ab :=
      { hom :=
          { app := fun U_op =>
              let U := Opposite.unop U_op
              AddCommGrpCat.ofHom
                { toFun := β_fn U
                  map_zero' := by
                    apply hInjOfLocalRep (β_fn U 0) 0 (hβ_hasLocalRep U 0)
                    · intro u
                      exact ⟨U, 𝟙 U, u, rfl, Or.inl (map_zero _)⟩
                    · exact (hα_of_β U 0).trans (map_zero _).symm
                  map_add' := fun s₁ s₂ => by
                    apply hInjOfLocalRep (β_fn U (s₁ + s₂)) (β_fn U s₁ + β_fn U s₂)
                      (hβ_hasLocalRep U (s₁ + s₂))
                    · intro u
                      obtain ⟨W₁, v₁, y₁, hy₁, hR₁⟩ := hβ_hasLocalRep U s₁ u
                      obtain ⟨W₂, v₂, y₂, hy₂, hR₂⟩ := hβ_hasLocalRep U s₂ u
                      let m₁ : (FgtX.obj W₁).left ⟶ (FgtX.obj U).left := (FgtX.map v₁).left
                      let m₂ : (FgtX.obj W₂).left ⟶ (FgtX.obj U).left := (FgtX.map v₂).left
                      have _ : AlgebraicGeometry.Etale m₁ := hEt_map v₁
                      have _ : AlgebraicGeometry.Etale m₂ := hEt_map v₂
                      have _ : AlgebraicGeometry.Etale (FgtX.obj W₁).hom := W₁.prop
                      let P_12 := CategoryTheory.Limits.pullback m₁ m₂
                      let p₁ : P_12 ⟶ (FgtX.obj W₁).left := CategoryTheory.Limits.pullback.fst m₁ m₂
                      let p₂ : P_12 ⟶ (FgtX.obj W₂).left := CategoryTheory.Limits.pullback.snd m₁ m₂
                      obtain ⟨z_u, hz₁, _⟩ :=
                        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂
                          (hy₁.trans hy₂.symm)
                      let Z_u : X.Etale :=
                        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (FgtX.obj W₁).hom)
                          inferInstance
                      let g₁ : Z_u ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
                      let g₂ : Z_u ⟶ W₂ :=
                        CategoryTheory.MorphismProperty.Over.homMk p₂
                          (by
                            change p₂ ≫ (FgtX.obj W₂).hom = p₁ ≫ (FgtX.obj W₁).hom
                            have hw₁ : m₁ ≫ (FgtX.obj U).hom = (FgtX.obj W₁).hom :=
                              CategoryTheory.MorphismProperty.Over.w v₁
                            have hw₂ : m₂ ≫ (FgtX.obj U).hom = (FgtX.obj W₂).hom :=
                              CategoryTheory.MorphismProperty.Over.w v₂
                            rw [← hw₁, ← hw₂, ← CategoryTheory.Category.assoc,
                              ← CategoryTheory.Category.assoc,
                              CategoryTheory.Limits.pullback.condition])
                          trivial
                      let f_u : Z_u ⟶ U := g₁ ≫ v₁
                      have hfu_eq : f_u = g₂ ≫ v₂ :=
                        CategoryTheory.MorphismProperty.Over.Hom.ext
                          CategoryTheory.Limits.pullback.condition
                      let σ₁ := (L_ab.obj.map (Opposite.op f_u)).hom (β_fn U s₁)
                      let σ₂ := (L_ab.obj.map (Opposite.op f_u)).hom (β_fn U s₂)
                      let M_U := L_ab.obj.obj (Opposite.op U)
                      let M_Z := L_ab.obj.obj (Opposite.op Z_u)
                      have hσ₁ : σ₁ = (L_ab.obj.map (Opposite.op g₁)).hom
                          ((L_ab.obj.map (Opposite.op v₁)).hom (β_fn U s₁)) :=
                        congrArg (fun f : M_U ⟶ M_Z => AddCommGrpCat.Hom.hom f (β_fn U s₁))
                          (L_ab.obj.map_comp _ _)
                      have hσ₂ : σ₂ = (L_ab.obj.map (Opposite.op g₂)).hom
                          ((L_ab.obj.map (Opposite.op v₂)).hom (β_fn U s₂)) :=
                        congrArg (fun f : M_U ⟶ M_Z => AddCommGrpCat.Hom.hom f (β_fn U s₂))
                          ((congrArg L_ab.obj.map (congrArg Opposite.op hfu_eq)).trans
                            (L_ab.obj.map_comp _ _))
                      have hRep₁ : σ₁ = 0 ∨ ∃ γ c, IsSplitSheets Z_u γ ∧ σ₁ = sheetSum Z_u γ c := by
                        rw [hσ₁]; exact hRepPull g₁ _ hR₁
                      have hRep₂ : σ₂ = 0 ∨ ∃ γ c, IsSplitSheets Z_u γ ∧ σ₂ = sheetSum Z_u γ c := by
                        rw [hσ₂]; exact hRepPull g₂ _ hR₂
                      obtain ⟨O_z, hzO, hSumO⟩ := hAddSheetRep σ₁ σ₂ hRep₁ hRep₂ z_u
                      let W_z := openEtObj Z_u O_z
                      let j_z := openEtHom Z_u O_z
                      refine ⟨W_z, j_z ≫ f_u, ⟨z_u, hzO⟩, ?_, ?_⟩
                      · change m₁.base (p₁.base z_u) = u
                        rw [hz₁, hy₁]
                      · have hcomp_map : (L_ab.obj.map (Opposite.op (j_z ≫ f_u))).hom
                            (β_fn U s₁ + β_fn U s₂) =
                            (L_ab.obj.map (Opposite.op j_z)).hom (σ₁ + σ₂) := by
                          have h1 := congrArg (fun f : M_U ⟶ L_ab.obj.obj (Opposite.op W_z) =>
                            AddCommGrpCat.Hom.hom f (β_fn U s₁ + β_fn U s₂))
                            (L_ab.obj.map_comp (Opposite.op f_u) (Opposite.op j_z))
                          exact h1.trans (congrArg (L_ab.obj.map (Opposite.op j_z)).hom
                            (map_add (L_ab.obj.map (Opposite.op f_u)).hom _ _))
                        rcases hSumO with h0 | ⟨γ', c', hSp', hEq'⟩
                        · exact Or.inl (hcomp_map.trans h0)
                        · exact Or.inr ⟨γ', c', hSp', hcomp_map.trans hEq'⟩
                    · exact (hα_of_β U (s₁ + s₂)).trans
                        ((congrArg₂ (· + ·) (hα_of_β U s₁).symm (hα_of_β U s₂).symm).trans
                          (map_add (α_clop.hom.app (Opposite.op U)).hom _ _).symm) }
            naturality := fun {U₁_op U₂_op} f_op => by
              let U₁ := Opposite.unop U₁_op
              let U₂ := Opposite.unop U₂_op
              let f : U₂ ⟶ U₁ := f_op.unop
              ext s
              let s₁ : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U₁)) := s
              let s₂ : ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj U₂)) :=
                ((P_push.obj K'_sh).obj.map (Opposite.op f)).hom s₁
              change β_fn U₂ s₂ = (L_ab.obj.map (Opposite.op f)).hom (β_fn U₁ s₁)
              apply hInjOfLocalRep (β_fn U₂ s₂) ((L_ab.obj.map (Opposite.op f)).hom (β_fn U₁ s₁))
                (hβ_hasLocalRep U₂ s₂)
              · intro u₂
                obtain ⟨W₁, v₁, y₁, hy₁, hR₁⟩ := hβ_hasLocalRep U₁ s₁ ((FgtX.map f).left.base u₂)
                let m₁ : (FgtX.obj W₁).left ⟶ (FgtX.obj U₁).left := (FgtX.map v₁).left
                let mf : (FgtX.obj U₂).left ⟶ (FgtX.obj U₁).left := (FgtX.map f).left
                have _ : AlgebraicGeometry.Etale m₁ := hEt_map v₁
                have _ : AlgebraicGeometry.Etale mf := hEt_map f
                have _ : AlgebraicGeometry.Etale (FgtX.obj W₁).hom := W₁.prop
                let P_f := CategoryTheory.Limits.pullback m₁ mf
                let p₁ : P_f ⟶ (FgtX.obj W₁).left := CategoryTheory.Limits.pullback.fst m₁ mf
                let p₂ : P_f ⟶ (FgtX.obj U₂).left := CategoryTheory.Limits.pullback.snd m₁ mf
                obtain ⟨z₂, _, hz₂⟩ :=
                  AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ u₂ hy₁
                let Z₂ : X.Etale :=
                  CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (FgtX.obj W₁).hom) inferInstance
                let g₁ : Z₂ ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
                let g₂ : Z₂ ⟶ U₂ :=
                  CategoryTheory.MorphismProperty.Over.homMk p₂
                    (by
                      change p₂ ≫ (FgtX.obj U₂).hom = p₁ ≫ (FgtX.obj W₁).hom
                      have hw₁ : m₁ ≫ (FgtX.obj U₁).hom = (FgtX.obj W₁).hom :=
                        CategoryTheory.MorphismProperty.Over.w v₁
                      have hwf : mf ≫ (FgtX.obj U₁).hom = (FgtX.obj U₂).hom :=
                        CategoryTheory.MorphismProperty.Over.w f
                      rw [← hw₁, ← hwf, ← CategoryTheory.Category.assoc,
                        ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition])
                    trivial
                have hg_comm : g₁ ≫ v₁ = g₂ ≫ f :=
                  CategoryTheory.MorphismProperty.Over.Hom.ext
                    CategoryTheory.Limits.pullback.condition
                let M₁ := L_ab.obj.obj (Opposite.op U₁)
                let M_Z := L_ab.obj.obj (Opposite.op Z₂)
                have hcomp_eq : (L_ab.obj.map (Opposite.op g₂)).hom
                    ((L_ab.obj.map (Opposite.op f)).hom (β_fn U₁ s₁)) =
                    (L_ab.obj.map (Opposite.op g₁)).hom
                      ((L_ab.obj.map (Opposite.op v₁)).hom (β_fn U₁ s₁)) :=
                  congrArg (fun h : M₁ ⟶ M_Z => AddCommGrpCat.Hom.hom h (β_fn U₁ s₁))
                    ((L_ab.obj.map_comp _ _).symm.trans
                      ((congrArg L_ab.obj.map (congrArg Opposite.op hg_comm.symm)).trans
                        (L_ab.obj.map_comp _ _)))
                refine ⟨Z₂, g₂, z₂, hz₂, ?_⟩
                rcases hRepPull g₁ _ hR₁ with h0 | ⟨γ', c', hSp', hEq'⟩
                · exact Or.inl (hcomp_eq.trans h0)
                · exact Or.inr ⟨γ', c', hSp', hcomp_eq.trans hEq'⟩
              · rw [hα_of_β U₂ s₂]
                let src := L_ab.obj.obj (Opposite.op U₁)
                let dst := (P_push.obj K'_sh).obj.obj (Opposite.op U₂)
                have hnat := congrArg (fun h : src ⟶ dst => AddCommGrpCat.Hom.hom h (β_fn U₁ s₁))
                  (α_clop.hom.naturality (Opposite.op f))
                change (α_clop.hom.app (Opposite.op U₂)).hom
                    ((L_ab.obj.map (Opposite.op f)).hom (β_fn U₁ s₁)) =
                  ((P_push.obj K'_sh).obj.map (Opposite.op f)).hom
                    ((α_clop.hom.app (Opposite.op U₁)).hom (β_fn U₁ s₁)) at hnat
                rw [hnat, hα_of_β U₁ s₁] } }

    have hβ_α : β_clop ≫ α_clop = 𝟙 (P_push.obj K'_sh) := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      let U := Opposite.unop U_op
      ext s
      exact hα_of_β U s

    have hα_β : α_clop ≫ β_clop = 𝟙 L_ab := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have hLHS : CategoryTheory.Sheaf.freeYonedaHomEquiv (α_clop ≫ β_clop) =
          η_clop ≫ β_clop.hom.app (Opposite.op V'_et) :=
        (hEquiv_comp α_clop β_clop).trans
          (congrArg (· ≫ β_clop.hom.app (Opposite.op V'_et)) (Equiv.apply_symm_apply _ _))
      rw [hLHS]
      ext a
      change β_fn V'_et (η_clop.hom a) = ξ_V.hom a
      apply hInjOfLocalRep (β_fn V'_et (η_clop.hom a)) (ξ_V.hom a)
        (hβ_hasLocalRep V'_et (η_clop.hom a))
      · intro u
        have hu : (FgtX.obj V'_et).hom.base u ∈ (V : Set ↥X) := by
          rw [← he_V']
          exact (e_V'.hom.base u).2
        obtain ⟨W'_u, v'_u, y₀, γ_u, hy₀, hSp⟩ := hLocalSheetChart V'_et u hu
        have hmem : (s_diag v'_u).base y₀ ∈ ⋃ i : ZMod ℓ, Set.range (s_diag (γ_u i)).base := by
          rw [hSp.2.2]; trivial
        obtain ⟨i₀, w, hw⟩ := Set.mem_iUnion.mp hmem
        have hwy₀ : y₀ = w := by
          have h1 := congrArg (fst_U W'_u).base hw
          have hL : (fst_U W'_u).base ((s_diag (γ_u i₀)).base w) = w :=
            congrArg (fun k : (FgtX.obj W'_u).left ⟶ (FgtX.obj W'_u).left => k.base w)
              (hs_diag_fst (γ_u i₀))
          have hR : (fst_U W'_u).base ((s_diag v'_u).base y₀) = y₀ :=
            congrArg (fun k : (FgtX.obj W'_u).left ⟶ (FgtX.obj W'_u).left => k.base y₀)
              (hs_diag_fst v'_u)
          exact (hL.symm.trans (h1.trans hR)).symm
        subst hwy₀
        have _ : AlgebraicGeometry.IsOpenImmersion (s_diag (γ_u i₀)) := hSp.1 i₀
        let O_Δ : ((FgtX.obj W'_u).left).Opens :=
          ⟨(s_diag v'_u).base ⁻¹' Set.range (s_diag (γ_u i₀)).base,
           (s_diag v'_u).continuous.isOpen_preimage _
             (s_diag (γ_u i₀)).isOpenEmbedding.isOpen_range⟩
        have hy₀_O : y₀ ∈ O_Δ := ⟨y₀, hw⟩
        let W_Δ := openEtObj W'_u O_Δ
        let j_Δ := openEtHom W'_u O_Δ
        have hsub : Set.range (O_Δ.ι ≫ s_diag v'_u).base ⊆ Set.range (s_diag (γ_u i₀)).base := by
          rintro _ ⟨z, rfl⟩
          exact z.2
        let h_lift : O_Δ.toScheme ⟶ (FgtX.obj W'_u).left :=
          AlgebraicGeometry.IsOpenImmersion.lift (s_diag (γ_u i₀)) (O_Δ.ι ≫ s_diag v'_u) hsub
        have h_fac : h_lift ≫ s_diag (γ_u i₀) = O_Δ.ι ≫ s_diag v'_u :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
        have hh_eq : h_lift = O_Δ.ι := by
          have hpost := congrArg (· ≫ fst_U W'_u) h_fac
          change (h_lift ≫ s_diag (γ_u i₀)) ≫ fst_U W'_u =
            (O_Δ.ι ≫ s_diag v'_u) ≫ fst_U W'_u at hpost
          rw [CategoryTheory.Category.assoc, hs_diag_fst, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.assoc, hs_diag_fst, CategoryTheory.Category.comp_id] at hpost
          exact hpost
        have hs_eq : O_Δ.ι ≫ s_diag v'_u = O_Δ.ι ≫ s_diag (γ_u i₀) := by
          rw [← h_fac, hh_eq]
        have hsnd_eq := congrArg (· ≫ snd_U W'_u) hs_eq
        change (O_Δ.ι ≫ s_diag v'_u) ≫ snd_U W'_u =
          (O_Δ.ι ≫ s_diag (γ_u i₀)) ≫ snd_U W'_u at hsnd_eq
        rw [CategoryTheory.Category.assoc, hs_diag_snd, CategoryTheory.Category.assoc,
          hs_diag_snd, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc] at hsnd_eq
        have hv_eq : j_Δ ≫ v'_u = j_Δ ≫ γ_u i₀ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext ((CategoryTheory.cancel_mono j_V').mp hsnd_eq)
        refine ⟨W_Δ, j_Δ ≫ v'_u, ⟨y₀, hy₀_O⟩, hy₀, Or.inr ⟨fun i => j_Δ ≫ γ_u i,
          fun i => if i = i₀ then a else 0, hSplitPull j_Δ γ_u hSp, ?_⟩⟩
        refine (congrArg (fun u => (L_ab.obj.map (Opposite.op u)).hom (ξ_V.hom a)) hv_eq).trans ?_
        symm
        dsimp only [sheetSum]
        have hterm : ∀ i : ZMod ℓ,
            (L_ab.obj.map (Opposite.op (j_Δ ≫ γ_u i))).hom
              (ξ_V.hom (if i = i₀ then a else 0)) =
            if i = i₀ then (L_ab.obj.map (Opposite.op (j_Δ ≫ γ_u i₀))).hom (ξ_V.hom a) else 0 := by
          intro i
          split_ifs with hi
          · subst hi; rfl
          · exact (congrArg (L_ab.obj.map (Opposite.op (j_Δ ≫ γ_u i))).hom
              (map_zero ξ_V.hom)).trans (map_zero _)
        refine (Finset.sum_congr rfl fun i _ => hterm i).trans ?_
        refine (Finset.sum_ite_eq' Finset.univ i₀
          (fun _ => (L_ab.obj.map (Opposite.op (j_Δ ≫ γ_u i₀))).hom (ξ_V.hom a))).trans ?_
        exact ite_eq_left_of_eq_true _ _ (eq_true (Finset.mem_univ i₀))
      · rw [hα_of_β V'_et (η_clop.hom a)]
        have hid_eq : ξ_V ≫ α_clop.hom.app (Opposite.op V'_et) = η_clop :=
          (hEquiv_comp (𝟙 L_ab) α_clop).symm.trans
            ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.Category.id_comp α_clop)).trans (Equiv.apply_symm_apply _ _))
        exact (congrArg (fun f : AM ⟶ (P_push.obj K'_sh).obj.obj (Opposite.op V'_et) =>
          AddCommGrpCat.Hom.hom f a) hid_eq).symm

    let e_clop : L_ab ≅ P_push.obj K'_sh :=
      { hom := α_clop, inv := β_clop, hom_inv_id := hα_β, inv_hom_id := hβ_α }

    refine ⟨e_clop, ?_⟩
    intro a z
    have heq : CategoryTheory.Sheaf.freeYonedaHomEquiv e_clop.hom = η_clop :=
      Equiv.apply_symm_apply _ _
    exact congrArg (fun f : AM ⟶ (P_push.obj K'_sh).obj.obj (Opposite.op V'_et) =>
      (AddCommGrpCat.Hom.hom f a :
        ↥(weilAltZeroBdrySubgroup X' V'_open ℓ (B_g.obj V'_et))).1 z) heq
  classical
  let _ := hζ
  intro V'_open V''_et
  let X' := Y'.left
  let X := Y.left
  have hPrime : Nat.Prime ℓ := Fact.out
  have _ : NeZero ℓ := ⟨hPrime.ne_zero⟩
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  have _ : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) g :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B : CategoryTheory.Functor X.Etale X'.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ g
  let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget X'
  let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget X
  let J₁ := X'.smallEtaleTopology
  let J₂ := X.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}

  rcases hg_sh with ⟨hCont, P_pull, adj_pull, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ,
    hιπ, hπι, _hBij_leray, ι₁, ι₂, τM, _hInj₁, hInj₂, hNat₁, hNat₂, hNorm₁, hNorm₂, hDet,
    hg_sh_eq⟩
  have _ := hCont
  have _ := hAdd
  have _ := hLim
  have _ := hColim
  let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
  let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
  let τ_term : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
  let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
    (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
      ((adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
          ((C₁.obj Aℤ).obj.map (Opposite.op τ_term))))
  let kMap₁ : ∀ U : X'.Etale, k →+* ↑(((Fgt₁.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
    fun U => CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (AlgebraicGeometry.Scheme.Hom.appTop
          (CategoryTheory.CategoryStruct.comp (Fgt₁.obj U).hom Y'.hom)))
  let kMap₂ : ∀ U : X.Etale, k →+* ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
    fun U => CommRingCat.Hom.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (AlgebraicGeometry.Scheme.Hom.appTop
          (CategoryTheory.CategoryStruct.comp (Fgt₂.obj U).hom Y.hom)))

  obtain ⟨hLerayBij, hLerayNat⟩ :=
    hPart1 X' X g hPresEpi hCont P_pull adj_pull hAdd hLim hColim ιℤ πℤ hιπ hπι
  obtain ⟨hShL₁, hSh0₁, Φ₁, Ψ₁, hΦ₁_unit, _hΨ₁_gen, hΨ₁_counit⟩ :=
    hPart2 X' V'_open ℓ T₁ hT₁
  obtain ⟨e_clop, he_clop⟩ :=
    hPart3 X' X ℓ g V hEt_p hSheetSplit_V V'_et e_V' he_V' hSh0₁ hCont

  let L_ab := weilEtaleLocalTorsionSheaf X ℓ V'_et
  let L'_ab := weilEtaleLocalTorsionSheaf X' ℓ V''_et
  let ε_ab := weilEtaleLocalTorsionCounit X ℓ V'_et
  let ε'_ab := weilEtaleLocalTorsionCounit X' ℓ V''_et
  let K'_sh : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} :=
    ⟨weilAltZeroBdrySubpresheaf X' V'_open ℓ, hSh0₁⟩
  let L'_loc : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} :=
    ⟨weilAltLocConstPresheaf X' ℓ, hShL₁⟩
  let sub_ι : K'_sh ⟶ L'_loc := { hom := weilAltZeroBdrySubpresheafι X' V'_open ℓ }
  let e_M : L_ab ≅ P_push.obj L'_ab := e_clop.trans (P_push.mapIso Ψ₁.symm)

  have hΨ₁_inv_counit : Ψ₁.inv ≫ ε'_ab = sub_ι ≫ Φ₁.inv := by
    calc
      Ψ₁.inv ≫ ε'_ab
        = Ψ₁.inv ≫ (ε'_ab ≫ Φ₁.hom) ≫ Φ₁.inv := by simp
      _ = Ψ₁.inv ≫ (Ψ₁.hom ≫ sub_ι) ≫ Φ₁.inv := by rw [← hΨ₁_counit]
      _ = (Ψ₁.inv ≫ Ψ₁.hom) ≫ sub_ι ≫ Φ₁.inv := by simp only [CategoryTheory.Category.assoc]
      _ = sub_ι ≫ Φ₁.inv := by rw [Ψ₁.inv_hom_id, CategoryTheory.Category.id_comp]

  have hΦ₁_inv_const : ∀ (U' : X'.Etale) (c : ZMod ℓ),
      (Φ₁.inv.hom.app (Opposite.op U')).hom
        (LocallyConstant.const ↥(Fgt₁.obj U').left (ULift.up c)) =
      ((C₁.obj AM).obj.map (Opposite.op (hT₁.from U'))).hom
        ((adj₁.unit.app AM).hom (ULift.up c)) := by
    intro U' c
    let src_T := (C₁.obj AM).obj.obj (Opposite.op T₁)
    let dst_U := L'_loc.obj.obj (Opposite.op U')
    let M_U := (C₁.obj AM).obj.obj (Opposite.op U')
    have hnat := congrArg
      (fun f : src_T ⟶ dst_U => AddCommGrpCat.Hom.hom f ((adj₁.unit.app AM).hom (ULift.up c)))
      (Φ₁.hom.hom.naturality (Opposite.op (hT₁.from U')))
    change (Φ₁.hom.hom.app (Opposite.op U')).hom
        (((C₁.obj AM).obj.map (Opposite.op (hT₁.from U'))).hom
          ((adj₁.unit.app AM).hom (ULift.up c))) =
      (L'_loc.obj.map (Opposite.op (hT₁.from U'))).hom
        ((Φ₁.hom.hom.app (Opposite.op T₁)).hom ((adj₁.unit.app AM).hom (ULift.up c))) at hnat
    have hu := congrArg
      (fun f : AM ⟶ L'_loc.obj.obj (Opposite.op T₁) => AddCommGrpCat.Hom.hom f (ULift.up c))
      hΦ₁_unit
    change (Φ₁.hom.hom.app (Opposite.op T₁)).hom ((adj₁.unit.app AM).hom (ULift.up c)) =
      LocallyConstant.const ↥(Fgt₁.obj T₁).left (ULift.up c) at hu
    have hhom_eq : (Φ₁.hom.hom.app (Opposite.op U')).hom
        (((C₁.obj AM).obj.map (Opposite.op (hT₁.from U'))).hom
          ((adj₁.unit.app AM).hom (ULift.up c))) =
        LocallyConstant.const ↥(Fgt₁.obj U').left (ULift.up c) := by
      rw [hnat, hu]
      rfl
    have hinv := congrArg (Φ₁.inv.hom.app (Opposite.op U')).hom hhom_eq
    have hid : Φ₁.hom.hom.app (Opposite.op U') ≫ Φ₁.inv.hom.app (Opposite.op U') = 𝟙 M_U :=
      congrArg (fun η : (C₁.obj AM) ⟶ (C₁.obj AM) => η.hom.app (Opposite.op U')) Φ₁.hom_inv_id
    have hcancel := congrArg
      (fun f : M_U ⟶ M_U => AddCommGrpCat.Hom.hom f
        (((C₁.obj AM).obj.map (Opposite.op (hT₁.from U'))).hom
          ((adj₁.unit.app AM).hom (ULift.up c)))) hid
    exact hinv.symm.trans hcancel

  have hι₁_const : ∀ (U' : X'.Etale) (c : ZMod ℓ),
      ι₁ U' ((Φ₁.inv.hom.app (Opposite.op U')).hom
        (LocallyConstant.const ↥(Fgt₁.obj U').left (ULift.up c))) =
      (kMap₁ U' ((ζ : kˣ) : k)) ^ c.val := by
    intro U' c
    let t_U' := hT₁.from U'
    rw [hΦ₁_inv_const U' c, hNat₁ t_U', hNorm₁ c, map_pow]
    congr 1
    have htw : (Fgt₁.map t_U').left ≫ (Fgt₁.obj T₁).hom = (Fgt₁.obj U').hom :=
      CategoryTheory.MorphismProperty.Over.w t_U'
    have hcomp_k : ((Fgt₁.map t_U').left ≫ (Fgt₁.obj T₁).hom) ≫ Y'.hom =
        (Fgt₁.obj U').hom ≫ Y'.hom :=
      congrArg (· ≫ Y'.hom) htw
    let eΓ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
    have hmor : (eΓ.inv ≫ ((Fgt₁.obj T₁).hom ≫ Y'.hom).appTop) ≫ ((Fgt₁.map t_U').left).appTop =
        eΓ.inv ≫ ((Fgt₁.obj U').hom ≫ Y'.hom).appTop := by
      rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
        ← CategoryTheory.Category.assoc (Fgt₁.map t_U').left, hcomp_k]
    exact congrArg (fun φ : CommRingCat.of k ⟶ _ => CommRingCat.Hom.hom φ ((ζ : kˣ) : k)) hmor

  have hEquiv_comp : ∀ {F G : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}}
      (α : L_ab ⟶ F) (q : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ q) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ q.hom.app (Opposite.op V'_et) := by
    intro F G α q
    let α' : (CategoryTheory.presheafToSheaf J₂ AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda V'_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ q))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).map q) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ q.hom.app (Opposite.op V'_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hCounitDet : e_M.hom ≫ P_push.map ε'_ab ≫ τM = ε_ab := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    ext a_up
    let a : ZMod ℓ := a_up.down
    have ha_up : a_up = ULift.up a := rfl
    let s_LHS : ↥((C₂.obj AM).obj.obj (Opposite.op V'_et)) :=
      (CategoryTheory.Sheaf.freeYonedaHomEquiv (e_M.hom ≫ P_push.map ε'_ab ≫ τM)).hom a_up
    let s_RHS : ↥((C₂.obj AM).obj.obj (Opposite.op V'_et)) :=
      (CategoryTheory.Sheaf.freeYonedaHomEquiv ε_ab).hom a_up
    change s_LHS = s_RHS

    let f_δ : (Fgt₂.obj V'_et).left ⟶ CategoryTheory.Limits.pullback (Fgt₂.obj V'_et).hom g :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.CategoryStruct.id _)
        (CategoryTheory.CategoryStruct.comp e_V'.hom V'_open.ι)
        ((CategoryTheory.Category.id_comp _).trans
          (he_V'.symm.trans (CategoryTheory.Category.assoc e_V'.hom V'_open.ι g).symm))

    have hs_LHS_eq : s_LHS = (τM.hom.app (Opposite.op V'_et)).hom
        ((Φ₁.inv.hom.app (Opposite.op (B.obj V'_et))).hom
          (((CategoryTheory.Sheaf.freeYonedaHomEquiv e_clop.hom).hom a_up).1)) := by
      have hmor : e_M.hom ≫ P_push.map ε'_ab ≫ τM =
          e_clop.hom ≫ P_push.map (sub_ι ≫ Φ₁.inv) ≫ τM := by
        dsimp only [e_M, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom,
          CategoryTheory.Iso.symm_hom]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (P_push.map Ψ₁.inv),
          ← P_push.map_comp, hΨ₁_inv_counit]
      have heq1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (e_M.hom ≫ P_push.map ε'_ab ≫ τM) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv e_clop.hom ≫
            (P_push.map (sub_ι ≫ Φ₁.inv) ≫ τM).hom.app (Opposite.op V'_et) := by
        rw [hmor]
        exact hEquiv_comp e_clop.hom _
      exact congrArg (fun f : AM ⟶ _ => AddCommGrpCat.Hom.hom f a_up) heq1

    have hLocalAgree : ∀ v' : ↥(Fgt₂.obj V'_et).left,
        ∃ (U_W : X.Etale) (u_W : U_W ⟶ V'_et) (w₀ : ↥(Fgt₂.obj U_W).left),
          AlgebraicGeometry.Etale (Fgt₂.map u_W).left ∧
          (Fgt₂.map u_W).left.base w₀ = v' ∧
          ((C₂.obj AM).obj.map (Opposite.op u_W)).hom s_LHS =
            ((C₂.obj AM).obj.map (Opposite.op u_W)).hom s_RHS := by
      intro v'
      let x_v' : ↥V.toScheme := (g ∣_ V).base (e_V'.hom.base v')
      obtain ⟨W, hAffW, w, hEt_w, w₀, hw₀, s_sh, hOpen_s, hSnd_s, hDisj_s, hUniv_s⟩ :=
        hSheetSplit_V x_v'
      have _ : AlgebraicGeometry.Etale w := hEt_w
      obtain ⟨p₀, hp₀_fst, hp₀_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (e_V'.hom.base v') w₀ hw₀.symm
      have hp₀_mem : p₀ ∈ ⋃ i : ZMod ℓ, Set.range (s_sh i).base := by
        rw [hUniv_s]; trivial
      obtain ⟨i₀, w'_0, hw'_0⟩ := Set.mem_iUnion.mp hp₀_mem
      have hw'_eq : w'_0 = w₀ := by
        have h1 := congrArg (CategoryTheory.Limits.pullback.snd (g ∣_ V) w).base hw'_0
        have hL : (CategoryTheory.Limits.pullback.snd (g ∣_ V) w).base ((s_sh i₀).base w'_0) =
            w'_0 :=
          congrArg (fun k : W ⟶ W => k.base w'_0) (hSnd_s i₀)
        exact hL.symm.trans (h1.trans hp₀_snd)
      subst w'_0
      let U_W : X.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (w ≫ V.ι) inferInstance
      let u_W_left : W ⟶ (Fgt₂.obj V'_et).left :=
        s_sh i₀ ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ e_V'.inv
      have hu_W_comm : u_W_left ≫ (Fgt₂.obj V'_et).hom = w ≫ V.ι := by
        dsimp only [u_W_left]
        rw [← he_V']
        calc
          (s_sh i₀ ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ e_V'.inv) ≫
              (e_V'.hom ≫ V'_open.ι ≫ g)
            = s_sh i₀ ≫ CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫
                (e_V'.inv ≫ e_V'.hom) ≫ (V'_open.ι ≫ g) := by
                simp only [CategoryTheory.Category.assoc]
          _ = s_sh i₀ ≫ (CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ (g ∣_ V)) ≫ V.ι := by
                rw [e_V'.inv_hom_id, CategoryTheory.Category.id_comp,
                  ← AlgebraicGeometry.morphismRestrict_ι g V, CategoryTheory.Category.assoc]
          _ = (s_sh i₀ ≫ CategoryTheory.Limits.pullback.snd (g ∣_ V) w) ≫ w ≫ V.ι := by
                rw [CategoryTheory.Limits.pullback.condition]
                simp only [CategoryTheory.Category.assoc]
          _ = w ≫ V.ι := by rw [hSnd_s i₀, CategoryTheory.Category.id_comp]
      let u_W : U_W ⟶ V'_et :=
        CategoryTheory.MorphismProperty.Over.homMk u_W_left hu_W_comm trivial
      have hEt_uW : AlgebraicGeometry.Etale (Fgt₂.map u_W).left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et
          u_W_left (Fgt₂.obj V'_et).hom V'_et.prop
          (by rw [hu_W_comm]; exact U_W.prop)
      have hw₀_pt : (Fgt₂.map u_W).left.base w₀ = v' := by
        change e_V'.inv.base
          ((CategoryTheory.Limits.pullback.fst (g ∣_ V) w).base ((s_sh i₀).base w₀)) = v'
        rw [hw'_0, hp₀_fst]
        exact congrArg (fun k : (Fgt₂.obj V'_et).left ⟶ (Fgt₂.obj V'_et).left => k.base v')
          e_V'.hom_inv_id

      let P_W : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback (w ≫ V.ι) g
      let p_W : P_W ⟶ W := CategoryTheory.Limits.pullback.fst (w ≫ V.ι) g
      let snd_W : P_W ⟶ X' := CategoryTheory.Limits.pullback.snd (w ≫ V.ι) g
      have hPb_W : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd (g ∣_ V) w)
          (CategoryTheory.Limits.pullback.fst (g ∣_ V) w ≫ V'_open.ι)
          (w ≫ V.ι) g :=
        (CategoryTheory.IsPullback.paste_horiz
          (CategoryTheory.IsPullback.of_hasPullback (g ∣_ V) w)
          (AlgebraicGeometry.isPullback_morphismRestrict g V).flip).flip
      let e_pb : CategoryTheory.Limits.pullback (g ∣_ V) w ≅ P_W := hPb_W.isoPullback
      let finEquiv : Fin ℓ ≃ ZMod ℓ :=
        { toFun := fun j => (j.1 : ZMod ℓ)
          invFun := fun i => ⟨i.val, ZMod.val_lt i⟩
          left_inv := fun j => Fin.ext (ZMod.val_natCast_of_lt j.2)
          right_inv := fun i => ZMod.natCast_zmod_val i }
      let j₀ : Fin ℓ := finEquiv.symm i₀
      have hj₀_eq : finEquiv j₀ = i₀ := finEquiv.apply_symm_apply i₀
      let s' : Fin ℓ → (W ⟶ P_W) := fun j => s_sh (finEquiv j) ≫ e_pb.hom
      have hOpen' : ∀ j : Fin ℓ, AlgebraicGeometry.IsOpenImmersion (s' j) := by
        intro j
        have _ : AlgebraicGeometry.IsOpenImmersion (s_sh (finEquiv j)) := hOpen_s (finEquiv j)
        dsimp only [s']
        infer_instance
      have hSec' : ∀ j : Fin ℓ, s' j ≫ p_W = CategoryTheory.CategoryStruct.id W := by
        intro j
        dsimp only [s', p_W]
        rw [CategoryTheory.Category.assoc, hPb_W.isoPullback_hom_fst]
        exact hSnd_s (finEquiv j)
      have hRange_s' : ∀ j : Fin ℓ,
          Set.range (s' j).base = e_pb.inv.base ⁻¹' Set.range (s_sh (finEquiv j)).base := by
        intro j
        ext z
        simp only [Set.mem_preimage]
        constructor
        · rintro ⟨y, rfl⟩
          refine ⟨y, ?_⟩
          exact (congrArg (fun k : CategoryTheory.Limits.pullback (g ∣_ V) w ⟶ _ =>
            k.base ((s_sh (finEquiv j)).base y)) e_pb.hom_inv_id).symm
        · rintro ⟨y, hy⟩
          refine ⟨y, ?_⟩
          have h1 := congrArg e_pb.hom.base hy
          exact h1.trans (congrArg (fun k : P_W ⟶ P_W => k.base z) e_pb.inv_hom_id)
      have hDisj' : _root_.Pairwise fun j₁ j₂ : Fin ℓ =>
          Disjoint (Set.range (s' j₁).base) (Set.range (s' j₂).base) := by
        intro j₁ j₂ hj
        rw [hRange_s' j₁, hRange_s' j₂]
        exact (hDisj_s (finEquiv.injective.ne hj)).preimage e_pb.inv.base
      have hUniv' : (⋃ j : Fin ℓ, Set.range (s' j).base) = Set.univ := by
        ext z
        simp only [Set.mem_iUnion, hRange_s', Set.mem_preimage, Set.mem_univ, iff_true]
        have hz : e_pb.inv.base z ∈ ⋃ i : ZMod ℓ, Set.range (s_sh i).base := by
          rw [hUniv_s]; trivial
        obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hz
        exact ⟨finEquiv.symm i, by rwa [finEquiv.apply_symm_apply]⟩

      let P_V' : AlgebraicGeometry.Scheme.{u} :=
        CategoryTheory.Limits.pullback (Fgt₂.obj V'_et).hom g
      let map_uW : P_W ⟶ P_V' := (Fgt₁.map (B.map u_W)).left
      have hs'j₀_snd : s' j₀ ≫ snd_W = u_W_left ≫ e_V'.hom ≫ V'_open.ι := by
        dsimp only [s', snd_W, u_W_left]
        rw [CategoryTheory.Category.assoc, hPb_W.isoPullback_hom_snd, hj₀_eq]
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id_assoc]
      have hfδ_fst : f_δ ≫ CategoryTheory.Limits.pullback.fst (Fgt₂.obj V'_et).hom g = 𝟙 _ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hfδ_snd : f_δ ≫ CategoryTheory.Limits.pullback.snd (Fgt₂.obj V'_et).hom g =
          e_V'.hom ≫ V'_open.ι :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hs'j₀_comm : s' j₀ ≫ map_uW = u_W_left ≫ f_δ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · have hfst : map_uW ≫ CategoryTheory.Limits.pullback.fst (Fgt₂.obj V'_et).hom g =
              p_W ≫ u_W_left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          rw [CategoryTheory.Category.assoc, hfst, ← CategoryTheory.Category.assoc, hSec' j₀,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hfδ_fst,
            CategoryTheory.Category.comp_id]
        · have hsnd : map_uW ≫ CategoryTheory.Limits.pullback.snd (Fgt₂.obj V'_et).hom g =
              snd_W :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          rw [CategoryTheory.Category.assoc, hsnd, hs'j₀_snd,
            CategoryTheory.Category.assoc u_W_left f_δ, hfδ_snd]
      have hPb_j₀ : CategoryTheory.IsPullback u_W_left (s' j₀) f_δ map_uW := by
        have hBot : CategoryTheory.IsPullback map_uW p_W
            (CategoryTheory.Limits.pullback.fst (Fgt₂.obj V'_et).hom g) u_W_left := by
          apply CategoryTheory.IsPullback.of_right _
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.IsPullback.of_hasPullback (Fgt₂.obj V'_et).hom g).flip
          have hsnd : map_uW ≫ CategoryTheory.Limits.pullback.snd (Fgt₂.obj V'_et).hom g =
              snd_W :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          change CategoryTheory.IsPullback
            (map_uW ≫ CategoryTheory.Limits.pullback.snd (Fgt₂.obj V'_et).hom g)
            p_W g (u_W_left ≫ (Fgt₂.obj V'_et).hom)
          rw [hsnd, hu_W_comm]
          exact (CategoryTheory.IsPullback.of_hasPullback (w ≫ V.ι) g).flip
        have hIso_l : CategoryTheory.IsIso (s' j₀ ≫ p_W) := by
          rw [hSec' j₀]; infer_instance
        have hIso_r : CategoryTheory.IsIso
            (f_δ ≫ CategoryTheory.Limits.pullback.fst (Fgt₂.obj V'_et).hom g) := by
          rw [hfδ_fst]; infer_instance
        have hOuter : CategoryTheory.IsPullback u_W_left (s' j₀ ≫ p_W)
            (f_δ ≫ CategoryTheory.Limits.pullback.fst (Fgt₂.obj V'_et).hom g) u_W_left :=
          @CategoryTheory.IsPullback.of_vert_isIso _ _ _ _ _ _ _ _ _ _ hIso_l hIso_r
            ⟨by rw [hSec' j₀, hfδ_fst, CategoryTheory.Category.comp_id,
              CategoryTheory.Category.id_comp]⟩
        exact CategoryTheory.IsPullback.of_bot hOuter hs'j₀_comm.symm hBot
      have hPre_j₀ : ∀ z : ↥P_W,
          map_uW.base z ∈ Set.range f_δ.base ↔ z ∈ Set.range (s' j₀).base := by
        intro z
        constructor
        · rintro ⟨v, hv⟩
          obtain ⟨p, _, hp₂⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v z hv
          refine ⟨hPb_j₀.isoPullback.inv.base p, ?_⟩
          exact (AlgebraicGeometry.Scheme.Hom.comp_apply hPb_j₀.isoPullback.inv (s' j₀) p).symm.trans
            ((congrArg (fun k : _ ⟶ P_W => k.base p) hPb_j₀.isoPullback_inv_snd).trans hp₂)
        · rintro ⟨y, rfl⟩
          exact ⟨u_W_left.base y,
            (congrArg (fun k : W ⟶ _ => k.base y) hs'j₀_comm).symm⟩

      let s_clop_V' : LocallyConstant ↥((Fgt₁.obj (B.obj V'_et)).left) (ULift.{u} (ZMod ℓ)) :=
        ((CategoryTheory.Sheaf.freeYonedaHomEquiv e_clop.hom).hom a_up).1
      let s_clop_UW : LocallyConstant ↥P_W (ULift.{u} (ZMod ℓ)) :=
        ((L'_loc.obj.map (Opposite.op (B.map u_W))).hom s_clop_V')
      let σ : ↥((C₁.obj AM).obj.obj (Opposite.op (B.obj U_W))) :=
        (Φ₁.inv.hom.app (Opposite.op (B.obj U_W))).hom s_clop_UW
      let u_B : ↑(P_W.presheaf.obj (Opposite.op ⊤)) := ι₁ (B.obj U_W) σ
      let r₀ : ↑(W.presheaf.obj (Opposite.op ⊤)) := (kMap₂ U_W ((ζ : kˣ) : k)) ^ a.val

      have hu_eval : ∀ j : Fin ℓ,
          ((s' j).appTop).hom u_B = if j = j₀ then r₀ else 1 := by
        intro j
        have _ : AlgebraicGeometry.IsOpenImmersion (s' j) := hOpen' j
        let b_hom : P_W ⟶ X' := (Fgt₁.obj (B.obj U_W)).hom
        have _ : AlgebraicGeometry.Etale b_hom := (B.obj U_W).prop
        let U'_j : X'.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (s' j ≫ b_hom) inferInstance
        let sh_j : U'_j ⟶ B.obj U_W :=
          CategoryTheory.MorphismProperty.Over.homMk (s' j) rfl trivial
        have hnat_j : ((s' j).appTop).hom u_B =
            ι₁ U'_j (((C₁.obj AM).obj.map (Opposite.op sh_j)).hom σ) :=
          (hNat₁ sh_j σ).symm
        let src_loc := L'_loc.obj.obj (Opposite.op (B.obj U_W))
        let dst_sh := (C₁.obj AM).obj.obj (Opposite.op U'_j)
        have hΦ_nat : ((C₁.obj AM).obj.map (Opposite.op sh_j)).hom σ =
            (Φ₁.inv.hom.app (Opposite.op U'_j)).hom
              ((L'_loc.obj.map (Opposite.op sh_j)).hom s_clop_UW) :=
          (congrArg (fun f : src_loc ⟶ dst_sh => AddCommGrpCat.Hom.hom f s_clop_UW)
            (Φ₁.inv.hom.naturality (Opposite.op sh_j))).symm
        rw [hnat_j, hΦ_nat]
        by_cases hj : j = j₀
        · have hconst_a : (L'_loc.obj.map (Opposite.op sh_j)).hom s_clop_UW =
              LocallyConstant.const ↥(Fgt₁.obj U'_j).left (ULift.up a) := by
            apply LocallyConstant.ext
            intro y
            change s_clop_V' (map_uW.base ((s' j).base y)) = ULift.up a
            have hev := he_clop a_up (map_uW.base ((s' j).base y))
            have hmem : map_uW.base ((s' j).base y) ∈ Set.range f_δ.base := by
              rw [hj]
              exact (hPre_j₀ ((s' j₀).base y)).mpr ⟨y, rfl⟩
            exact (hev.trans (ite_eq_left_of_eq_true _ _ (eq_true hmem))).trans ha_up
          refine ((congrArg (fun x => ι₁ U'_j ((Φ₁.inv.hom.app (Opposite.op U'_j)).hom x))
            hconst_a).trans (hι₁_const U'_j a)).trans ?_
          refine Eq.symm ((ite_eq_left_of_eq_true _ _ (eq_true hj)).trans ?_)
          symm
          congr 1
          let eΓ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
          have hk_eq : (Fgt₁.obj U'_j).hom ≫ Y'.hom = (Fgt₂.obj U_W).hom ≫ Y.hom := by
            change (s' j ≫ snd_W) ≫ Y'.hom = (w ≫ V.ι) ≫ Y.hom
            rw [CategoryTheory.Category.assoc, ← hg_over, ← CategoryTheory.Category.assoc snd_W,
              ← CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc]
            change ((s' j ≫ p_W) ≫ (w ≫ V.ι)) ≫ Y.hom = _
            rw [hSec' j, CategoryTheory.Category.id_comp]
          exact congrArg (fun ψ : _ ⟶ _ =>
            CommRingCat.Hom.hom (eΓ.inv ≫ AlgebraicGeometry.Scheme.Hom.appTop ψ) ((ζ : kˣ) : k))
            hk_eq
        · have hconst_0 : (L'_loc.obj.map (Opposite.op sh_j)).hom s_clop_UW =
              LocallyConstant.const ↥(Fgt₁.obj U'_j).left (ULift.up (0 : ZMod ℓ)) := by
            apply LocallyConstant.ext
            intro y
            change s_clop_V' (map_uW.base ((s' j).base y)) = ULift.up 0
            have hev := he_clop a_up (map_uW.base ((s' j).base y))
            have hnot : map_uW.base ((s' j).base y) ∉ Set.range f_δ.base :=
              fun hmem => Set.disjoint_left.mp (hDisj' hj) ⟨y, rfl⟩
                ((hPre_j₀ ((s' j).base y)).mp hmem)
            exact hev.trans (ite_eq_right_of_eq_false _ _ (eq_false hnot))
          refine ((congrArg (fun x => ι₁ U'_j ((Φ₁.inv.hom.app (Opposite.op U'_j)).hom x))
            hconst_0).trans (hι₁_const U'_j 0)).trans ?_
          rw [ZMod.val_zero, pow_zero]
          exact (ite_eq_right_of_eq_false _ _ (eq_false hj)).symm

      obtain ⟨M, hAddM, hModM, bM, eM, L, hScalar, hMul, hDet_L⟩ :=
        hPart4 W P_W p_W ℓ s' hOpen' hSec' hDisj' hUniv' u_B j₀ r₀
          ((hu_eval j₀).trans (ite_eq_left_of_eq_true _ _ (eq_true rfl)))
          (fun j hj => (hu_eval j).trans (ite_eq_right_of_eq_false _ _ (eq_false hj)))
      have hτ_det : ι₂ U_W ((τM.hom.app (Opposite.op U_W)).hom σ) = r₀ :=
        (hDet U_W hAffW M hAddM hModM bM eM hScalar σ L hMul).trans hDet_L

      have hLHS_uW : ((C₂.obj AM).obj.map (Opposite.op u_W)).hom s_LHS =
          (τM.hom.app (Opposite.op U_W)).hom σ := by
        rw [hs_LHS_eq]
        let s₀ := (Φ₁.inv.hom.app (Opposite.op (B.obj V'_et))).hom s_clop_V'
        let src_τ := (P_push.obj (C₁.obj AM)).obj.obj (Opposite.op V'_et)
        let dst_τ := (C₂.obj AM).obj.obj (Opposite.op U_W)
        have hnat_τ := congrArg (fun f : src_τ ⟶ dst_τ => AddCommGrpCat.Hom.hom f s₀)
          (τM.hom.naturality (Opposite.op u_W)).symm
        change ((C₂.obj AM).obj.map (Opposite.op u_W)).hom
            ((τM.hom.app (Opposite.op V'_et)).hom s₀) =
          (τM.hom.app (Opposite.op U_W)).hom
            (((C₁.obj AM).obj.map (Opposite.op (B.map u_W))).hom s₀) at hnat_τ
        let src_Φ := L'_loc.obj.obj (Opposite.op (B.obj V'_et))
        let dst_Φ := (C₁.obj AM).obj.obj (Opposite.op (B.obj U_W))
        have hnat_Φ := congrArg (fun f : src_Φ ⟶ dst_Φ => AddCommGrpCat.Hom.hom f s_clop_V')
          (Φ₁.inv.hom.naturality (Opposite.op (B.map u_W)))
        change (Φ₁.inv.hom.app (Opposite.op (B.obj U_W))).hom s_clop_UW =
          ((C₁.obj AM).obj.map (Opposite.op (B.map u_W))).hom s₀ at hnat_Φ
        exact hnat_τ.trans (congrArg (τM.hom.app (Opposite.op U_W)).hom hnat_Φ.symm)

      have hRHS_uW : ι₂ U_W (((C₂.obj AM).obj.map (Opposite.op u_W)).hom s_RHS) = r₀ := by
        let P_const₂ := (CategoryTheory.Functor.const (Opposite X.Etale)).obj AM
        let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
        have hs_RHS : s_RHS = ((shAdj₂.unit.app P_const₂).app (Opposite.op V'_et)).hom a_up := by
          have heq : CategoryTheory.Sheaf.freeYonedaHomEquiv ε_ab =
              (shAdj₂.unit.app P_const₂).app (Opposite.op V'_et) :=
            Equiv.apply_symm_apply _ _
          exact congrArg (fun f : AM ⟶ _ => AddCommGrpCat.Hom.hom f a_up) heq
        have hUnitT₂ : (shAdj₂.unit.app P_const₂).app (Opposite.op T₂) = adj₂.unit.app AM := by
          dsimp [adj₂, shAdj₂, CategoryTheory.constantSheafAdj,
            CategoryTheory.sheafificationAdjunction, CategoryTheory.Adjunction.comp, P_const₂]
          ext ⟨b⟩
          simp
        let t_UW := hT₂.from U_W
        have hUnitV' : (shAdj₂.unit.app P_const₂).app (Opposite.op V'_et) ≫
            (C₂.obj AM).obj.map (Opposite.op u_W) =
            adj₂.unit.app AM ≫ (C₂.obj AM).obj.map (Opposite.op t_UW) := by
          have hn1 : (shAdj₂.unit.app P_const₂).app (Opposite.op V'_et) ≫
              (C₂.obj AM).obj.map (Opposite.op u_W) =
              (shAdj₂.unit.app P_const₂).app (Opposite.op U_W) :=
            ((shAdj₂.unit.app P_const₂).naturality (Opposite.op u_W)).symm.trans
              (CategoryTheory.Category.id_comp _)
          have hn2 : (shAdj₂.unit.app P_const₂).app (Opposite.op T₂) ≫
              (C₂.obj AM).obj.map (Opposite.op t_UW) =
              (shAdj₂.unit.app P_const₂).app (Opposite.op U_W) :=
            ((shAdj₂.unit.app P_const₂).naturality (Opposite.op t_UW)).symm.trans
              (CategoryTheory.Category.id_comp _)
          exact hn1.trans (hn2.symm.trans
            (congrArg (· ≫ (C₂.obj AM).obj.map (Opposite.op t_UW)) hUnitT₂))
        have hsec_eq : ((C₂.obj AM).obj.map (Opposite.op u_W)).hom s_RHS =
            ((C₂.obj AM).obj.map (Opposite.op t_UW)).hom ((adj₂.unit.app AM).hom (ULift.up a)) := by
          rw [hs_RHS, ha_up]
          exact congrArg (fun f : AM ⟶ _ => AddCommGrpCat.Hom.hom f (ULift.up a)) hUnitV'
        refine (congrArg (ι₂ U_W) hsec_eq).trans ?_
        refine (hNat₂ t_UW ((adj₂.unit.app AM).hom (ULift.up a))).trans ?_
        rw [hNorm₂ a, map_pow]
        dsimp only [r₀]
        congr 1
        have htw : (Fgt₂.map t_UW).left ≫ (Fgt₂.obj T₂).hom = (Fgt₂.obj U_W).hom :=
          CategoryTheory.MorphismProperty.Over.w t_UW
        let eΓ := AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
        have hmor : (eΓ.inv ≫ ((Fgt₂.obj T₂).hom ≫ Y.hom).appTop) ≫
            ((Fgt₂.map t_UW).left).appTop =
            eΓ.inv ≫ ((Fgt₂.obj U_W).hom ≫ Y.hom).appTop := by
          rw [CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.Hom.comp_appTop,
            ← CategoryTheory.Category.assoc (Fgt₂.map t_UW).left, htw]
        exact congrArg (fun φ : CommRingCat.of k ⟶ _ => CommRingCat.Hom.hom φ ((ζ : kˣ) : k)) hmor

      refine ⟨U_W, u_W, w₀, hEt_uW, hw₀_pt, ?_⟩
      apply hInj₂ U_W
      exact (congrArg (ι₂ U_W) hLHS_uW).trans (hτ_det.trans hRHS_uW.symm)

    obtain ⟨U_cov, u_cov, w_cov, hcov_spec⟩ :
        ∃ (U_cov : ↥(Fgt₂.obj V'_et).left → X.Etale)
          (u_cov : ∀ v', U_cov v' ⟶ V'_et)
          (w_cov : ∀ v', ↥(Fgt₂.obj (U_cov v')).left),
          ∀ v', AlgebraicGeometry.Etale (Fgt₂.map (u_cov v')).left ∧
            (Fgt₂.map (u_cov v')).left.base (w_cov v') = v' ∧
            ((C₂.obj AM).obj.map (Opposite.op (u_cov v'))).hom s_LHS =
              ((C₂.obj AM).obj.map (Opposite.op (u_cov v'))).hom s_RHS :=
      ⟨fun v' => Classical.choose (hLocalAgree v'),
       fun v' => Classical.choose (Classical.choose_spec (hLocalAgree v')),
       fun v' => Classical.choose (Classical.choose_spec (Classical.choose_spec (hLocalAgree v'))),
       fun v' => Classical.choose_spec (Classical.choose_spec
         (Classical.choose_spec (hLocalAgree v')))⟩
    have hJ₂_eq : J₂ = (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X
        (le_refl P_et)
    have hMemJ₂_iff : ∀ (Z : X.Etale) (R : CategoryTheory.Sieve Z),
        R ∈ J₂ Z ↔ ∀ x : ↥(Fgt₂.obj Z).left,
          ∃ (Y_c : X.Etale) (f_c : Y_c ⟶ Z) (y_c : ↥(Fgt₂.obj Y_c).left),
            R.arrows f_c ∧ AlgebraicGeometry.Etale (Fgt₂.map f_c).left ∧
              (Fgt₂.map f_c).left.base y_c = x := by
      intro Z R
      rw [hJ₂_eq]
      exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Z R
    have hMemCov : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows U_cov u_cov) ∈
        J₂ V'_et := by
      refine (hMemJ₂_iff V'_et _).mpr fun v' => ?_
      exact ⟨U_cov v', u_cov v', w_cov v',
        ⟨U_cov v', 𝟙 _, u_cov v', CategoryTheory.Presieve.ofArrows.mk v',
          CategoryTheory.Category.id_comp _⟩,
        (hcov_spec v').1, (hcov_spec v').2.1⟩
    have hShC₂ := (CategoryTheory.isSheaf_iff_isSheaf_of_type J₂
      ((C₂.obj AM).obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp
      (((CategoryTheory.sheafCompose J₂ (CategoryTheory.forget AddCommGrpCat.{u})).obj
        (C₂.obj AM)).property)
    have hForArr := (CategoryTheory.Presieve.isSheafFor_arrows_iff
      ((C₂.obj AM).obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) u_cov).mp
      ((CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (hShC₂ _ hMemCov))
    let M_V' := (C₂.obj AM).obj.obj (Opposite.op V'_et)
    exact (hForArr
      (fun v' => ((C₂.obj AM).obj.map (Opposite.op (u_cov v'))).hom s_LHS)
      (fun v₁ v₂ Z g₁ g₂ hg =>
        congrArg (fun f : M_V' ⟶ (C₂.obj AM).obj.obj (Opposite.op Z) =>
          AddCommGrpCat.Hom.hom f s_LHS)
          (((C₂.obj AM).obj.map_comp _ _).symm.trans
            ((congrArg (C₂.obj AM).obj.map (congrArg Opposite.op hg)).trans
              ((C₂.obj AM).obj.map_comp _ _))))).unique
      (fun _ => rfl) (fun v' => ((hcov_spec v').2.2).symm)

  have hInvCounit : P_push.map ε'_ab ≫ τM = e_M.inv ≫ ε_ab := by
    calc
      P_push.map ε'_ab ≫ τM
        = (e_M.inv ≫ e_M.hom) ≫ (P_push.map ε'_ab ≫ τM) := by
            rw [e_M.inv_hom_id, CategoryTheory.Category.id_comp]
      _ = e_M.inv ≫ (e_M.hom ≫ P_push.map ε'_ab ≫ τM) := by
            rw [CategoryTheory.Category.assoc]
      _ = e_M.inv ≫ ε_ab := by rw [hCounitDet]

  let leray_hom : ∀ (𝒢 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext.{u} (C₂.obj Aℤ) (P_push.obj 𝒢) 2 →+
        CategoryTheory.Abelian.Ext.{u} (C₁.obj Aℤ) 𝒢 2 :=
    fun 𝒢 =>
      ((CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app 𝒢)).postcomp
        (C₁.obj Aℤ) (Nat.add_zero 2)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp
          (P_pull.obj (P_push.obj 𝒢)) (Nat.zero_add 2)).comp
          (P_pull.mapExtAddHom (C₂.obj Aℤ) (P_push.obj 𝒢) 2))

  let e_Λ : CategoryTheory.Abelian.Ext.{u} (C₂.obj Aℤ) (P_push.obj L'_ab) 2 ≃+
      weilEtaleLocalTorsionH X' ℓ V''_et 2 :=
    AddEquiv.ofBijective (leray_hom L'_ab) (hLerayBij 2 L'_ab)

  let e_α : weilEtaleLocalTorsionH X ℓ V'_et 2 ≃+
      CategoryTheory.Abelian.Ext.{u} (C₂.obj Aℤ) (P_push.obj L'_ab) 2 :=
    { toFun := (CategoryTheory.Abelian.Ext.mk₀ e_M.hom).postcomp (C₂.obj Aℤ) (Nat.add_zero 2)
      invFun := (CategoryTheory.Abelian.Ext.mk₀ e_M.inv).postcomp (C₂.obj Aℤ) (Nat.add_zero 2)
      left_inv := fun w => by
        change (w.comp (CategoryTheory.Abelian.Ext.mk₀ e_M.hom) (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_M.inv) (Nat.add_zero 2) = w
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_M.hom_inv_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      right_inv := fun z => by
        change (z.comp (CategoryTheory.Abelian.Ext.mk₀ e_M.inv) (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ e_M.hom) (Nat.add_zero 2) = z
        rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_M.inv_hom_id,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      map_add' := map_add _ }

  let Ψ_M : weilEtaleLocalTorsionH X' ℓ V''_et 2 →+
      weilEtaleLocalTorsionH X ℓ V'_et 2 :=
    (e_Λ.symm.trans e_α.symm).toAddMonoidHom

  refine ⟨Ψ_M, (e_Λ.symm.trans e_α.symm).bijective, ?_⟩
  intro y'
  let z : CategoryTheory.Abelian.Ext.{u} (C₂.obj Aℤ) (P_push.obj L'_ab) 2 := e_Λ.symm y'
  have hz : leray_hom L'_ab z = y' := e_Λ.apply_symm_apply y'
  have hΨ_y' : Ψ_M y' = z.comp (CategoryTheory.Abelian.Ext.mk₀ e_M.inv) (Nat.add_zero 2) := rfl
  have hNat_ε' : leray_hom (C₁.obj AM)
      (z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map ε'_ab)) (Nat.add_zero 2)) =
      weilEtaleLocalTorsionCounitH X' ℓ V''_et 2 y' :=
    (hLerayNat 2 ε'_ab z).trans
      (congrArg (fun w => w.comp (CategoryTheory.Abelian.Ext.mk₀ ε'_ab) (Nat.add_zero 2)) hz)
  have hShriek := hg_sh_eq
    (weilEtaleLocalTorsionCounitH X' ℓ V''_et 2 y')
    (z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map ε'_ab)) (Nat.add_zero 2))
    hNat_ε'
  rw [hShriek]
  change ((z.comp (CategoryTheory.Abelian.Ext.mk₀ e_M.inv) (Nat.add_zero 2)).comp
      (CategoryTheory.Abelian.Ext.mk₀ ε_ab) (Nat.add_zero 2)) =
    (z.comp (CategoryTheory.Abelian.Ext.mk₀ (P_push.map ε'_ab)) (Nat.add_zero 2)).comp
      (CategoryTheory.Abelian.Ext.mk₀ τM) (Nat.add_zero 2)
  rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
    CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
    hInvCounit]

theorem weil_curve_finite_free_cover_det_pushforward_ne_zero (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (C_bar C'_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C_bar.left]
    [AlgebraicGeometry.IsIntegral C'_bar.left]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C'_bar.hom]
    (hDimC' : topologicalKrullDim C'_bar.left = (1 : WithBot ℕ∞))
    (hStalkC_dvr : ∀ x : { x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) },
      ∃ hDom : IsDomain ↑(C_bar.left.presheaf.stalk x.1),
        @IsDiscreteValuationRing ↑(C_bar.left.presheaf.stalk x.1) _ hDom)
