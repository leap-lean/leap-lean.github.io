                (adj'₁.unit.app A ≫ (C₁.obj A).obj.map τ'.op)) =
            𝟙 (C₁.obj A) := by
    intro E₁ E₂ _ _ J₁ J₂ _ _ F G _ _ _ adj_FG T₁ hT₁ T₂ hT₂ T'₁ hT'₁ T'₂ hT'₂
      R_ab P_push P_pull adj_pull C₁ C₂ adj₁ adj₂ adj'₁ adj'₂ μ₁₂ τ'
    have hAdjRP : ∃ adj_RP : R_ab ⊣ P_push,
        ∀ (ℋ : Sheaf J₁ AddCommGrpCat.{u}) (U : E₁),
          (adj_RP.counit.app ℋ).hom.app (Opposite.op U) =
            ℋ.obj.map (adj_FG.unit.app U).op :=
      ⟨Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun 𝒢 =>
                { hom :=
                    { app := fun V => 𝒢.obj.map (adj_FG.counit.app (Opposite.unop V)).op
                      naturality := fun {V₁ V₂} f => by
                        change 𝒢.obj.map f ≫ 𝒢.obj.map (adj_FG.counit.app (Opposite.unop V₂)).op =
                          𝒢.obj.map (adj_FG.counit.app (Opposite.unop V₁)).op ≫
                            𝒢.obj.map (F.map (G.map f.unop)).op
                        rw [← Functor.map_comp, ← Functor.map_comp]
                        congr 1
                        exact Quiver.Hom.unop_inj (adj_FG.counit.naturality f.unop).symm } }
              naturality := fun {𝒢₁ 𝒢₂} u =>
                CategoryTheory.Sheaf.hom_ext (NatTrans.ext (funext fun V =>
                  (u.hom.naturality (adj_FG.counit.app (Opposite.unop V)).op).symm)) }
          counit :=
            { app := fun ℋ =>
                { hom :=
                    { app := fun U => ℋ.obj.map (adj_FG.unit.app (Opposite.unop U)).op
                      naturality := fun {U₁ U₂} f => by
                        change ℋ.obj.map (G.map (F.map f.unop)).op ≫
                            ℋ.obj.map (adj_FG.unit.app (Opposite.unop U₂)).op =
                          ℋ.obj.map (adj_FG.unit.app (Opposite.unop U₁)).op ≫ ℋ.obj.map f
                        rw [← Functor.map_comp, ← Functor.map_comp]
                        congr 1
                        exact Quiver.Hom.unop_inj (adj_FG.unit.naturality f.unop).symm } }
              naturality := fun {ℋ₁ ℋ₂} u =>
                CategoryTheory.Sheaf.hom_ext (NatTrans.ext (funext fun U =>
                  (u.hom.naturality (adj_FG.unit.app (Opposite.unop U)).op).symm)) }
          left_triangle :=
            NatTrans.ext (funext fun 𝒢 => CategoryTheory.Sheaf.hom_ext (NatTrans.ext (funext fun U => by
              change 𝒢.obj.map (adj_FG.counit.app (F.obj (Opposite.unop U))).op ≫
                𝒢.obj.map (F.map (adj_FG.unit.app (Opposite.unop U))).op =
                𝟙 (𝒢.obj.obj (Opposite.op (F.obj (Opposite.unop U))))
              rw [← Functor.map_comp, ← op_comp,
                adj_FG.left_triangle_components (Opposite.unop U)]
              exact 𝒢.obj.map_id _)))
          right_triangle :=
            NatTrans.ext (funext fun ℋ => CategoryTheory.Sheaf.hom_ext (NatTrans.ext (funext fun V => by
              change ℋ.obj.map (G.map (adj_FG.counit.app (Opposite.unop V))).op ≫
                ℋ.obj.map (adj_FG.unit.app (G.obj (Opposite.unop V))).op =
                𝟙 (ℋ.obj.obj (Opposite.op (G.obj (Opposite.unop V))))
              rw [← Functor.map_comp, ← op_comp,
