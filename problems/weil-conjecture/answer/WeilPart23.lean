    have hFin_ker_ε : Finite ↥ε_post.ker := hker_ε.symm ▸ hFin_rng_δ₀
    have hCard_ker_ε : Nat.card ↥ε_post.ker = ℓ ^ (s - 1) := by
      rw [hker_ε, hCard_rng_δ₀]
    let e_quot_ε : (Abelian.Ext.{u} one L 1 ⧸ ε_post.ker) ≃+ Abelian.Ext.{u} one one 1 :=
      QuotientAddGroup.quotientKerEquivOfSurjective ε_post hε_surj
    have hFin_quot_ε : Finite (Abelian.Ext.{u} one L 1 ⧸ ε_post.ker) :=
      @Finite.of_equiv _ _ hFin_one1 e_quot_ε.symm.toEquiv
    obtain ⟨e_cos_L1⟩ := hCoset (Abelian.Ext.{u} one L 1) ε_post.ker
    have : Finite (Abelian.Ext.{u} one L 1 ⧸ ε_post.ker) := hFin_quot_ε
    have : Finite ↥ε_post.ker := hFin_ker_ε
    have hFin_L1 : Finite (Abelian.Ext.{u} one L 1) :=
      Finite.of_equiv _ e_cos_L1.symm
    refine ⟨hFin_L1, ?_⟩
    calc
      Nat.card (Abelian.Ext.{u} one L 1)
        = Nat.card (Abelian.Ext.{u} one L 1 ⧸ ε_post.ker) * Nat.card ↥ε_post.ker :=
            (Nat.card_congr e_cos_L1).trans (Nat.card_prod _ _)
      _ = Nat.card (Abelian.Ext.{u} one one 1) * ℓ ^ (s - 1) := by
            rw [Nat.card_congr e_quot_ε.toEquiv, hCard_ker_ε]
      _ = ℓ ^ (s - 1) * Nat.card (Abelian.Ext.{u} one one 1) := Nat.mul_comm _ _

  
  
  
  let S₀ : Scheme.{u} := X.left
  let p_X : S₀ ⟶ Spec (CommRingCat.of k) := X.hom
  let S_k : Scheme.{u} := Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⊥ : PrimeSpectrum k)
  let Fgt := Scheme.Etale.forget S₀
  have : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEtale_map : ∀ {W₁ W₂ : S₀.Etale} (u : W₁ ⟶ W₂), Etale ((Fgt.map u).left) := by
    intro W₁ W₂ u
    have h₁ : Etale ((Fgt.obj W₁).hom) := W₁.prop
    have h₂ : Etale ((Fgt.obj W₂).hom) := W₂.prop
    have hw : (Fgt.map u).left ≫ (Fgt.obj W₂).hom = (Fgt.obj W₁).hom := (Fgt.map u).w
    exact MorphismProperty.of_postcomp (@Etale) ((Fgt.map u).left) ((Fgt.obj W₂).hom) h₂
      (hw.symm ▸ h₁)
  let R := ULift.{u, 0} (ZMod ℓ)
  let ModR := ModuleCat.{u, u} R
  let RM : ModR := ModuleCat.of R R
  let J := S₀.smallEtaleTopology
  let 𝒞 := Sheaf J ModR
  let oneR : 𝒞 := weilCupPDModUnit S₀ ℓ
  let adj_sh := sheafificationAdjunction J ModR
  let P_const : Opposite S₀.Etale ⥤ ModR := (Functor.const (Opposite S₀.Etale)).obj RM
  have hMemJ_iff : ∀ (W : S₀.Etale) (R_s : Sieve W),
      R_s ∈ J W ↔ ∀ x : ↥((Fgt.obj W).left),
        ∃ (Y : S₀.Etale) (f : Y ⟶ W) (y : ↥((Fgt.obj Y).left)),
          R_s.arrows f ∧ Etale f.left ∧ f.left.base y = x := by
    intro W R_s
    have hJ := S₀.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @Etale) (Q := @Etale) le_rfl
    exact (Iff.of_eq (congrArg (fun T : GrothendieckTopology S₀.Etale => R_s ∈ T W) hJ)).trans
      (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) W R_s)

  have hs_pos : 1 ≤ Nat.card ↥((U_X : Set ↥S₀)ᶜ) :=
    @Nat.card_pos ↥((U_X : Set ↥S₀)ᶜ) hNe_compl hFin_compl

  
  
  
  obtain ⟨Q_S, ρ_S, ev_Q, hInj_Q, hev_bij, hev_diag, hVan_U, hLocChart_Q⟩ :
      ∃ (Q_S : 𝒞) (ρ_S : oneR ⟶ Q_S)
        (ev_Q : (oneR ⟶ Q_S) →+ (Fin (Nat.card ↥((U_X : Set ↥S₀)ᶜ)) → ZMod ℓ)),
        Injective Q_S ∧
        Function.Bijective ev_Q ∧
        (∀ c : ZMod ℓ, ev_Q ((c.val • 𝟙 oneR) ≫ ρ_S) = fun _ => c) ∧
        (∀ W : S₀.Etale, Set.range ((Fgt.obj W).hom).base ⊆ (U_X : Set ↥S₀) →
          Subsingleton ↑(Q_S.obj.obj (Opposite.op W))) ∧
        (∀ (W : S₀.Etale) (y : ↥((Fgt.obj W).left)),
          ∃ (U₀ : S₀.Etale) (u₀ : U₀ ⟶ W) (y₀ : ↥((Fgt.obj U₀).left))
            (val_y : ↑(Q_S.obj.obj (Opposite.op W)) → R),
            ((Fgt.map u₀).left).base y₀ = y ∧
            (∀ ξ : ↑(Q_S.obj.obj (Opposite.op W)),
              (Q_S.obj.map (Opposite.op u₀)).hom ξ =
                (ρ_S.hom.app (Opposite.op U₀)).hom
                  (((adj_sh.unit.app P_const).app (Opposite.op U₀)).hom (val_y ξ))) ∧
            (((Fgt.obj W).hom).base y ∉ U_X →
              ∀ r : R,
                (ρ_S.hom.app (Opposite.op U₀)).hom
                  (((adj_sh.unit.app P_const).app (Opposite.op U₀)).hom r) = 0 →
                r = 0)) := by
    let Z_compl : Set ↥S₀ := (U_X : Set ↥S₀)ᶜ
    let s_card : ℕ := Nat.card ↥Z_compl
    let e_Z : ↥Z_compl ≃ Fin s_card := @Finite.equivFinOfCardEq ↥Z_compl hFin_compl s_card rfl
    let P_pt : Fin s_card → ↥S₀ := fun a => (e_Z.symm a).1
    have hP_inj : Function.Injective P_pt := Subtype.val_injective.comp e_Z.symm.injective
    have hP_cl : ∀ a : Fin s_card, IsClosed ({P_pt a} : Set ↥S₀) :=
      fun a => hCl_compl (P_pt a) (e_Z.symm a).2
    have hP_compl : ∀ x : ↥S₀, x ∉ U_X ↔ ∃ a : Fin s_card, P_pt a = x := by
      intro x
      constructor
      · intro hx
        exact ⟨e_Z ⟨x, hx⟩, congrArg Subtype.val (e_Z.symm_apply_apply ⟨x, hx⟩)⟩
      · rintro ⟨a, rfl⟩
        exact (e_Z.symm a).2

    
    obtain ⟨i_pt, hi_pt_base, hCov_lift_raw, hIso_shrink_raw, Idx, hCatIdx, hFiltIdx,
        D_op, γ_idx, hIdx_map, hIdx_shrink, hIdx_refine⟩ :
        ∃ (i_pt : Fin s_card → (S_k ⟶ S₀)),
          (∀ (a : Fin s_card) (pt : ↥S_k), (i_pt a).base pt = P_pt a) ∧
          (∀ (a : Fin s_card) {W₁ W₂ : S₀.Etale} (u : W₁ ⟶ W₂)
              (γ : S_k ⟶ ((Fgt.obj W₂).left)),
            γ ≫ ((Fgt.obj W₂).hom) = i_pt a →
            (∃ y₁ : ↥((Fgt.obj W₁).left), ((Fgt.map u).left).base y₁ = γ.base pt_k) →
            ∃ γ₁ : S_k ⟶ ((Fgt.obj W₁).left),
              γ₁ ≫ ((Fgt.obj W₁).hom) = i_pt a ∧ γ₁ ≫ ((Fgt.map u).left) = γ) ∧
          (∀ (a : Fin s_card) (W : S₀.Etale) (y : ↥((Fgt.obj W).left)),
            ((Fgt.obj W).hom).base y = P_pt a →
            ∃ (U₀ : S₀.Etale) (u₀ : U₀ ⟶ W) (y₀ : ↥((Fgt.obj U₀).left))
              (γ₀ : { γ : S_k ⟶ ((Fgt.obj U₀).left) // γ ≫ ((Fgt.obj U₀).hom) = i_pt a }),
              ((Fgt.map u₀).left).base y₀ = y ∧
              (∀ γ' : { γ : S_k ⟶ ((Fgt.obj U₀).left) // γ ≫ ((Fgt.obj U₀).hom) = i_pt a },
                γ' = γ₀) ∧
              (∀ b : Fin s_card, b ≠ a →
                IsEmpty { γ : S_k ⟶ ((Fgt.obj U₀).left) // γ ≫ ((Fgt.obj U₀).hom) = i_pt b })) ∧
          ∃ (Idx : Fin s_card → Type u) (hCat : ∀ a, SmallCategory (Idx a)),
            letI := hCat
            ∃ (_ : ∀ a, IsFiltered (Idx a))
              (D_op : ∀ a, Idx a ⥤ Opposite S₀.Etale)
              (γ_idx : ∀ (a : Fin s_card) (j : Idx a),
                { γ : S_k ⟶ ((Fgt.obj (Opposite.unop ((D_op a).obj j))).left) //
                  γ ≫ ((Fgt.obj (Opposite.unop ((D_op a).obj j))).hom) = i_pt a }),
              (∀ (a : Fin s_card) {j₁ j₂ : Idx a} (f : j₁ ⟶ j₂),
                (γ_idx a j₂).1 ≫ ((Fgt.map ((D_op a).map f).unop).left) = (γ_idx a j₁).1) ∧
              (∀ (a : Fin s_card) (W : S₀.Etale)
                  (γ : { γ : S_k ⟶ ((Fgt.obj W).left) // γ ≫ ((Fgt.obj W).hom) = i_pt a }),
                ∃ (j : Idx a) (w : Opposite.unop ((D_op a).obj j) ⟶ W),
                  (γ_idx a j).1 ≫ ((Fgt.map w).left) = γ.1) ∧
              (∀ (a : Fin s_card) {W : S₀.Etale} (γ : S_k ⟶ ((Fgt.obj W).left))
                  (j₁ j₂ : Idx a)
                  (w₁ : Opposite.unop ((D_op a).obj j₁) ⟶ W)
                  (w₂ : Opposite.unop ((D_op a).obj j₂) ⟶ W),
                (γ_idx a j₁).1 ≫ ((Fgt.map w₁).left) = γ →
                (γ_idx a j₂).1 ≫ ((Fgt.map w₂).left) = γ →
                ∃ (j₃ : Idx a) (f₁ : j₁ ⟶ j₃) (f₂ : j₂ ⟶ j₃),
                  ((D_op a).map f₁).unop ≫ w₁ = ((D_op a).map f₂).unop ≫ w₂) := by
      have hClosedPtSection :
          ∀ {W : Scheme.{u}} [IsAffine W] (p_W : W ⟶ S_k) [LocallyOfFiniteType p_W]
            (w : ↥W), IsClosed ({w} : Set ↥W) →
            ∃ s_w : S_k ⟶ W, s_w ≫ p_W = 𝟙 S_k ∧ s_w.base pt_k = w := by
        intro W _ p_W _ w hw
        let e_W := W.isoSpec
        let B : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
        let φ_k : CommRingCat.of k ⟶ B := Spec.preimage (e_W.inv ≫ p_W)
        have hmap_φ : Spec.map φ_k = e_W.inv ≫ p_W := Spec.map_preimage (e_W.inv ≫ p_W)
        have hLFT_comp : LocallyOfFiniteType (e_W.inv ≫ p_W) := inferInstance
        have hLFT_spec : LocallyOfFiniteType (Spec.map φ_k) := hmap_φ.symm ▸ hLFT_comp
        have hFT_hom : RingHom.FiniteType φ_k.hom :=
          (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hLFT_spec
        let _ : Algebra k ↑B := φ_k.hom.toAlgebra
        have hFT_alg : Algebra.FiniteType k ↑B := hFT_hom
        obtain ⟨n, q, hq_surj⟩ := (Algebra.FiniteType.iff_quotient_mvPolynomial'').mp hFT_alg
        let w' : PrimeSpectrum ↑B := e_W.hom.base w
        have hw'_eq : ({w'} : Set (PrimeSpectrum ↑B)) = e_W.inv.base ⁻¹' ({w} : Set ↥W) := by
          ext z
          constructor
          · intro hz_eq
            rw [Set.mem_singleton_iff.mp hz_eq]
            change (e_W.hom ≫ e_W.inv).base w = w
            rw [e_W.hom_inv_id]; rfl
          · intro hz
            have hz' : e_W.inv.base z = w := hz
            rw [Set.mem_singleton_iff]
            dsimp only [w']
            rw [← hz']
            change z = (e_W.inv ≫ e_W.hom).base z
            rw [e_W.inv_hom_id]; rfl
        have hw'_cl : IsClosed ({w'} : Set (PrimeSpectrum ↑B)) := by
          rw [hw'_eq]
          exact hw.preimage e_W.inv.continuous
        have hw'_max : w'.asIdeal.IsMaximal :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal w').mp hw'_cl
        have hm₀_max : (Ideal.comap q.toRingHom w'.asIdeal).IsMaximal :=
          Ideal.comap_isMaximal_of_surjective q.toRingHom hq_surj
        obtain ⟨x₀, hx₀⟩ :=
          MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hm₀_max
        let ev₀ : MvPolynomial (Fin n) k →+* k := (MvPolynomial.aeval x₀).toRingHom
        have hmem_iff : ∀ f : MvPolynomial (Fin n) k,
            q f ∈ w'.asIdeal ↔ ev₀ f = 0 := by
          intro f
          change f ∈ Ideal.comap q.toRingHom w'.asIdeal ↔ MvPolynomial.aeval x₀ f = 0
          rw [hx₀, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        have hker : RingHom.ker q.toRingHom ≤ RingHom.ker ev₀ := by
          intro f hf
          change ev₀ f = 0
          rw [← hmem_iff f]
          change q.toRingHom f ∈ w'.asIdeal
          rw [RingHom.mem_ker.mp hf]
          exact w'.asIdeal.zero_mem
        let σ_B : ↑B →+* k :=
          RingHom.liftOfRightInverse q.toRingHom (Function.surjInv hq_surj)
            (Function.rightInverse_surjInv hq_surj) ⟨ev₀, hker⟩
        have hσ_comp : σ_B.comp q.toRingHom = ev₀ :=
          RingHom.liftOfRightInverse_comp q.toRingHom (Function.surjInv hq_surj)
            (Function.rightInverse_surjInv hq_surj) ⟨ev₀, hker⟩
        have hφ_σ : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro c
          have hqc : q (MvPolynomial.C c) = φ_k.hom c := q.commutes c
          calc
            σ_B (φ_k.hom c) = (σ_B.comp q.toRingHom) (MvPolynomial.C c) := by rw [← hqc]; rfl
            _ = ev₀ (MvPolynomial.C c) := by rw [hσ_comp]
            _ = c := (MvPolynomial.aeval x₀).commutes c
        have hcomap_pt : (Spec.map (CommRingCat.ofHom σ_B)).base pt_k = w' := by
          apply PrimeSpectrum.ext
          ext b
          obtain ⟨f, rfl⟩ := hq_surj b
          change (σ_B.comp q.toRingHom) f ∈ (⊥ : Ideal k) ↔ q f ∈ w'.asIdeal
          rw [hσ_comp, Ideal.mem_bot, ← hmem_iff f]
        let s_w : S_k ⟶ W := Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
        refine ⟨s_w, ?_, ?_⟩
        · calc
            s_w ≫ p_W = Spec.map (CommRingCat.ofHom σ_B) ≫ (e_W.inv ≫ p_W) := Category.assoc _ _ _
            _ = Spec.map (CommRingCat.ofHom σ_B) ≫ Spec.map φ_k := by rw [hmap_φ]
            _ = Spec.map (φ_k ≫ CommRingCat.ofHom σ_B) := (Spec.map_comp _ _).symm
            _ = Spec.map (𝟙 (CommRingCat.of k)) := by rw [hφ_σ]
            _ = 𝟙 S_k := Spec.map_id _
        · change (Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv).base pt_k = w
          rw [Scheme.Hom.comp_apply, hcomap_pt]
          change (e_W.hom ≫ e_W.inv).base w = w
          rw [e_W.hom_inv_id]; rfl

      have hClosedOfSection :
          ∀ {W : Scheme.{u}} [IsAffine W] (p_W : W ⟶ S_k) (s : S_k ⟶ W),
            s ≫ p_W = 𝟙 S_k → IsClosed ({s.base pt_k} : Set ↥W) := by
        intro W _ p_W s hs
        let e_W := W.isoSpec
        let B : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
        let φ_k : CommRingCat.of k ⟶ B := Spec.preimage (e_W.inv ≫ p_W)
        let ψ : B ⟶ CommRingCat.of k := Spec.preimage (s ≫ e_W.hom)
        have hcomp_id : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
          apply Spec.map_injective
          rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_id]
          calc
            (s ≫ e_W.hom) ≫ e_W.inv ≫ p_W
              = s ≫ (e_W.hom ≫ e_W.inv) ≫ p_W := by simp only [Category.assoc]
            _ = s ≫ p_W := by rw [e_W.hom_inv_id, Category.id_comp]
            _ = 𝟙 S_k := hs
        have hψ_surj : Function.Surjective ψ.hom := fun c =>
          ⟨φ_k.hom c, congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom c) hcomp_id⟩
        let q_pt : PrimeSpectrum ↑B := (Spec.map ψ).base pt_k
        have hq_max : q_pt.asIdeal.IsMaximal := by
          change (Ideal.comap ψ.hom (⊥ : Ideal k)).IsMaximal
          have : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
          exact Ideal.comap_isMaximal_of_surjective ψ.hom hψ_surj
        have hq_cl : IsClosed ({q_pt} : Set (PrimeSpectrum ↑B)) :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_pt).mpr hq_max
        have hq_eq : q_pt = e_W.hom.base (s.base pt_k) := by
          dsimp [q_pt]; rw [Spec.map_preimage]; rfl
        have hpre_eq : ({s.base pt_k} : Set ↥W) =
            e_W.hom.base ⁻¹' ({q_pt} : Set (PrimeSpectrum ↑B)) := by
          ext z
          constructor
          · intro hz; rw [Set.mem_singleton_iff.mp hz]; exact hq_eq.symm
          · intro hz
            have hz' : e_W.hom.base z = e_W.hom.base (s.base pt_k) := hq_eq ▸ hz
            have hinv := congrArg e_W.inv.base hz'
            change (e_W.hom ≫ e_W.inv).base z = (e_W.hom ≫ e_W.inv).base (s.base pt_k) at hinv
            rw [e_W.hom_inv_id] at hinv; exact hinv
        rw [hpre_eq]
        exact hq_cl.preimage e_W.hom.continuous

      have hSectionEq :
          ∀ {W : Scheme.{u}} [IsAffine W] (p_W : W ⟶ S_k) (s₁ s₂ : S_k ⟶ W),
            s₁ ≫ p_W = 𝟙 S_k → s₂ ≫ p_W = 𝟙 S_k →
            s₁.base pt_k = s₂.base pt_k → s₁ = s₂ := by
        intro W _ p_W s₁ s₂ hs₁ hs₂ hpt_eq
        let e_W := W.isoSpec
        let B : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
        let φ_k : CommRingCat.of k ⟶ B := Spec.preimage (e_W.inv ≫ p_W)
        let ψ₁ : B ⟶ CommRingCat.of k := Spec.preimage (s₁ ≫ e_W.hom)
        let ψ₂ : B ⟶ CommRingCat.of k := Spec.preimage (s₂ ≫ e_W.hom)
        have hφ₁ : φ_k ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
          apply Spec.map_injective
          rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_id]
          calc
            (s₁ ≫ e_W.hom) ≫ e_W.inv ≫ p_W = s₁ ≫ (e_W.hom ≫ e_W.inv) ≫ p_W := by simp [Category.assoc]
            _ = s₁ ≫ p_W := by rw [e_W.hom_inv_id, Category.id_comp]
            _ = 𝟙 S_k := hs₁
        have hφ₂ : φ_k ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
          apply Spec.map_injective
          rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Spec.map_id]
          calc
            (s₂ ≫ e_W.hom) ≫ e_W.inv ≫ p_W = s₂ ≫ (e_W.hom ≫ e_W.inv) ≫ p_W := by simp [Category.assoc]
            _ = s₂ ≫ p_W := by rw [e_W.hom_inv_id, Category.id_comp]
            _ = 𝟙 S_k := hs₂
        have hbase_eq : (Spec.map ψ₁).base pt_k = (Spec.map ψ₂).base pt_k := by
          rw [Spec.map_preimage, Spec.map_preimage]
          exact congrArg e_W.hom.base hpt_eq
        have hker_iff : ∀ b : ↑B, ψ₁.hom b = 0 ↔ ψ₂.hom b = 0 := by
          intro b
          have hmem := SetLike.ext_iff.mp (PrimeSpectrum.ext_iff.mp hbase_eq) b
          change ψ₁.hom b ∈ (⊥ : Ideal k) ↔ ψ₂.hom b ∈ (⊥ : Ideal k) at hmem
          rwa [Ideal.mem_bot, Ideal.mem_bot] at hmem
        have hψ_eq : ψ₁ = ψ₂ := by
          apply CommRingCat.hom_ext; apply RingHom.ext; intro b
          have hd₂ : ψ₂.hom (b - φ_k.hom (ψ₂.hom b)) = 0 := by
            rw [map_sub]
            have hc : ψ₂.hom (φ_k.hom (ψ₂.hom b)) = ψ₂.hom b :=
              congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom (ψ₂.hom b)) hφ₂
            rw [hc, sub_self]
          have hd₁ : ψ₁.hom (b - φ_k.hom (ψ₂.hom b)) = 0 := (hker_iff _).mpr hd₂
          rw [map_sub] at hd₁
          have hc₁ : ψ₁.hom (φ_k.hom (ψ₂.hom b)) = ψ₂.hom b :=
            congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom (ψ₂.hom b)) hφ₁
          rw [hc₁] at hd₁
          exact sub_eq_zero.mp hd₁
        have hs_e : s₁ ≫ e_W.hom = s₂ ≫ e_W.hom := by
          rw [← Spec.map_preimage (s₁ ≫ e_W.hom), ← Spec.map_preimage (s₂ ≫ e_W.hom)]
          exact congrArg Spec.map hψ_eq
        exact (Iso.cancel_iso_hom_right s₁ s₂ e_W).mp hs_e

      have hChart_ex : ∀ a : Fin s_card,
          ∃ (U_a : S₀.Opens) (hAff_Ua : IsAffineOpen U_a)
            (p_a : ↥(Spec (S₀.presheaf.obj (Opposite.op U_a))))
            (σ_a : S_k ⟶ Spec (S₀.presheaf.obj (Opposite.op U_a))),
            P_pt a ∈ U_a ∧
            hAff_Ua.fromSpec.base p_a = P_pt a ∧
            σ_a ≫ hAff_Ua.fromSpec ≫ p_X = 𝟙 S_k ∧
            σ_a.base pt_k = p_a := by
        intro a
        obtain ⟨U_a, hAff_Ua, hPa_in, _⟩ :=
          exists_isAffineOpen_mem_and_subset (x := P_pt a) (U := ⊤) trivial
        let W_a := Spec (S₀.presheaf.obj (Opposite.op U_a))
        let ι_a : W_a ⟶ S₀ := hAff_Ua.fromSpec
        let p_a : ↥W_a := hAff_Ua.primeIdealOf ⟨P_pt a, hPa_in⟩
        have hp_a : ι_a.base p_a = P_pt a := hAff_Ua.fromSpec_primeIdealOf ⟨P_pt a, hPa_in⟩
        have hp_a_pre : ({p_a} : Set ↥W_a) = ι_a.base ⁻¹' ({P_pt a} : Set ↥S₀) := by
          ext z
          exact ⟨fun h => by rw [Set.mem_singleton_iff.mp h]; exact hp_a,
            fun h => ι_a.isOpenEmbedding.injective (h.trans hp_a.symm)⟩
        have hp_a_cl : IsClosed ({p_a} : Set ↥W_a) := by
          rw [hp_a_pre]; exact (hP_cl a).preimage ι_a.continuous
        obtain ⟨σ_a, hσ_id, hσ_pt⟩ := hClosedPtSection (ι_a ≫ p_X) p_a hp_a_cl
        exact ⟨U_a, hAff_Ua, p_a, σ_a, hPa_in, hp_a, hσ_id, hσ_pt⟩

      let U_chart : Fin s_card → S₀.Opens := fun a => Classical.choose (hChart_ex a)
      let hAff_chart : ∀ a : Fin s_card, IsAffineOpen (U_chart a) :=
        fun a => Classical.choose (Classical.choose_spec (hChart_ex a))
      let W_chart : Fin s_card → Scheme.{u} :=
        fun a => Spec (S₀.presheaf.obj (Opposite.op (U_chart a)))
      let ι_chart : ∀ a : Fin s_card, W_chart a ⟶ S₀ := fun a => (hAff_chart a).fromSpec
      let p_chart : ∀ a : Fin s_card, ↥(W_chart a) :=
        fun a => Classical.choose (Classical.choose_spec (Classical.choose_spec (hChart_ex a)))
      let σ_chart : ∀ a : Fin s_card, S_k ⟶ W_chart a :=
        fun a => Classical.choose
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hChart_ex a))))
      have hChart_spec : ∀ a : Fin s_card,
          P_pt a ∈ U_chart a ∧
          (ι_chart a).base (p_chart a) = P_pt a ∧
          σ_chart a ≫ ι_chart a ≫ p_X = 𝟙 S_k ∧
          (σ_chart a).base pt_k = p_chart a :=
        fun a => Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hChart_ex a))))

      let i_pt : Fin s_card → (S_k ⟶ S₀) := fun a => σ_chart a ≫ ι_chart a
      have hi_pt_hom : ∀ a : Fin s_card, i_pt a ≫ p_X = 𝟙 S_k :=
        fun a => (Category.assoc _ _ _).trans (hChart_spec a).2.2.1
      have hi_pt_base : ∀ (a : Fin s_card) (pt : ↥S_k), (i_pt a).base pt = P_pt a := by
        intro a pt
        rw [Subsingleton.elim pt pt_k]
        change (σ_chart a ≫ ι_chart a).base pt_k = P_pt a
        rw [Scheme.Hom.comp_apply, (hChart_spec a).2.2.2, (hChart_spec a).2.1]

      let L_set : Fin s_card → S₀.Etale → Type u := fun a W =>
        { γ : S_k ⟶ ((Fgt.obj W).left) // γ ≫ ((Fgt.obj W).hom) = i_pt a }
      let liftMap : ∀ (a : Fin s_card) {W₁ W₂ : S₀.Etale},
          (W₁ ⟶ W₂) → L_set a W₁ → L_set a W₂ :=
        fun a {_ _} u γ =>
          ⟨γ.1 ≫ ((Fgt.map u).left),
            (Category.assoc γ.1 ((Fgt.map u).left) _).trans
              ((congrArg (γ.1 ≫ ·) ((Fgt.map u).w)).trans γ.2)⟩

      have hCov_lift_raw : ∀ (a : Fin s_card) {W₁ W₂ : S₀.Etale} (u : W₁ ⟶ W₂)
          (γ : S_k ⟶ ((Fgt.obj W₂).left)),
          γ ≫ ((Fgt.obj W₂).hom) = i_pt a →
          (∃ y₁ : ↥((Fgt.obj W₁).left), ((Fgt.map u).left).base y₁ = γ.base pt_k) →
          ∃ γ₁ : S_k ⟶ ((Fgt.obj W₁).left),
            γ₁ ≫ ((Fgt.obj W₁).hom) = i_pt a ∧ γ₁ ≫ ((Fgt.map u).left) = γ := by
        intro a W₁ W₂ u γ hγ ⟨y₁, hy₁⟩
        have : Etale ((Fgt.map u).left) := hEtale_map u
        let P_cov := Limits.pullback ((Fgt.map u).left) γ
        let p₁ : P_cov ⟶ (Fgt.obj W₁).left := Limits.pullback.fst ((Fgt.map u).left) γ
        let p₂ : P_cov ⟶ S_k := Limits.pullback.snd ((Fgt.map u).left) γ
        obtain ⟨z₀, -⟩ := Scheme.Pullback.exists_preimage_pullback y₁ pt_k hy₁
        obtain ⟨V_P, hAff_VP, hz₀_in, _⟩ :=
          exists_isAffineOpen_mem_and_subset (x := z₀) (U := ⊤) trivial
        let B_P : CommRingCat.{u} := P_cov.presheaf.obj (Opposite.op V_P)
        let j_P : Spec B_P ⟶ P_cov := hAff_VP.fromSpec
        let q_z₀ : PrimeSpectrum ↑B_P := hAff_VP.primeIdealOf ⟨z₀, hz₀_in⟩
        have : Nontrivial ↑B_P :=
          (PrimeSpectrum.nonempty_iff_nontrivial (R := ↑B_P)).mp ⟨q_z₀⟩
        obtain ⟨m_P, hm_P⟩ := Ideal.exists_maximal ↑B_P
        let q_max : PrimeSpectrum ↑B_P := ⟨m_P, hm_P.isPrime⟩
        have hq_cl : IsClosed ({q_max} : Set ↥(Spec B_P)) :=
          (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_max).mpr hm_P
        obtain ⟨s_P, hs_P_id, -⟩ := hClosedPtSection (j_P ≫ p₂) q_max hq_cl
        let γ₁_hom : S_k ⟶ (Fgt.obj W₁).left := s_P ≫ j_P ≫ p₁
        have hγ₁_u : γ₁_hom ≫ ((Fgt.map u).left) = γ := by
          calc
            (s_P ≫ j_P ≫ p₁) ≫ ((Fgt.map u).left)
              = s_P ≫ j_P ≫ (p₁ ≫ ((Fgt.map u).left)) := by simp only [Category.assoc]
            _ = s_P ≫ j_P ≫ (p₂ ≫ γ) := by rw [Limits.pullback.condition]
            _ = (s_P ≫ (j_P ≫ p₂)) ≫ γ := by simp only [Category.assoc]
            _ = 𝟙 S_k ≫ γ := by rw [hs_P_id]
            _ = γ := Category.id_comp _
        have hγ₁_hom : γ₁_hom ≫ ((Fgt.obj W₁).hom) = i_pt a := by
          rw [← (Fgt.map u).w, ← Category.assoc, hγ₁_u, hγ]
        exact ⟨γ₁_hom, hγ₁_hom, hγ₁_u⟩

      have hIso_shrink : ∀ (a : Fin s_card) (W : S₀.Etale) (y : ↥((Fgt.obj W).left)),
          ((Fgt.obj W).hom).base y = P_pt a →
          ∃ (U₀ : S₀.Etale) (u₀ : U₀ ⟶ W) (y₀ : ↥((Fgt.obj U₀).left)) (γ₀ : L_set a U₀),
            ((Fgt.map u₀).left).base y₀ = y ∧
            (∀ γ' : L_set a U₀, γ' = γ₀) ∧
            (∀ b : Fin s_card, b ≠ a → IsEmpty (L_set b U₀)) := by
        intro a W y hy_Pa
        let S_other : Set (Fin s_card) := { b : Fin s_card | b ≠ a }
        let Z_other : Set ↥S₀ := ⋃ b ∈ S_other, ({P_pt b} : Set ↥S₀)
        have hZ_other_cl : IsClosed Z_other :=
          (Set.toFinite S_other).isClosed_biUnion (fun b _ => hP_cl b)
        have hPa_not_other : P_pt a ∉ Z_other := by
          rintro hmem
          rw [Set.mem_iUnion₂] at hmem
          rcases hmem with ⟨b, hba, hPb⟩
          exact hba (hP_inj (Set.mem_singleton_iff.mp hPb).symm)
        let O_a : S₀.Opens :=
          ⟨(U_chart a : Set ↥S₀) ∩ Z_otherᶜ,
            (U_chart a).isOpen.inter hZ_other_cl.isOpen_compl⟩
        have hy_Oa : y ∈ (TopologicalSpace.Opens.map ((Fgt.obj W).hom).base).obj O_a := by
          change ((Fgt.obj W).hom).base y ∈ (U_chart a : Set ↥S₀) ∩ Z_otherᶜ
          rw [hy_Pa]
          exact ⟨(hChart_spec a).1, hPa_not_other⟩
        obtain ⟨V₀, hAff_V₀, hy_V₀, hV₀_sub⟩ :=
          exists_isAffineOpen_mem_and_subset (x := y)
            (U := (TopologicalSpace.Opens.map ((Fgt.obj W).hom).base).obj O_a) hy_Oa
        let A₀ : Scheme.{u} := Spec (((Fgt.obj W).left).presheaf.obj (Opposite.op V₀))
        let j₀ : A₀ ⟶ (Fgt.obj W).left := hAff_V₀.fromSpec
        let z_y : ↥A₀ := hAff_V₀.primeIdealOf ⟨y, hy_V₀⟩
        have hz_y : j₀.base z_y = y := hAff_V₀.fromSpec_primeIdealOf ⟨y, hy_V₀⟩
        have hj₀_range : Set.range (j₀ ≫ (Fgt.obj W).hom).base ⊆ Set.range (ι_chart a).base := by
          rintro _ ⟨z, rfl⟩
          rw [Scheme.Hom.comp_apply, (hAff_chart a).range_fromSpec]
          have hz_in_V₀ : j₀.base z ∈ (V₀ : Set ↥((Fgt.obj W).left)) := by
            rw [← hAff_V₀.range_fromSpec]; exact ⟨z, rfl⟩
          exact (hV₀_sub hz_in_V₀).1
        let g₀ : A₀ ⟶ W_chart a :=
          IsOpenImmersion.lift (ι_chart a) (j₀ ≫ (Fgt.obj W).hom) hj₀_range
        have hg₀_fac : g₀ ≫ ι_chart a = j₀ ≫ (Fgt.obj W).hom :=
          IsOpenImmersion.lift_fac (ι_chart a) (j₀ ≫ (Fgt.obj W).hom) hj₀_range
        have hEt_W : Etale ((Fgt.obj W).hom) := W.prop
        have hEt_jW : Etale (j₀ ≫ (Fgt.obj W).hom) := inferInstance
        have hEt_ιa : Etale (ι_chart a) := inferInstance
        have : Etale g₀ :=
          MorphismProperty.of_postcomp (@Etale) g₀ (ι_chart a) hEt_ιa (hg₀_fac.symm ▸ hEt_jW)
        have hg₀_zy : g₀.base z_y = p_chart a := by
          apply (ι_chart a).isOpenEmbedding.injective
          change (g₀ ≫ ι_chart a).base z_y = (ι_chart a).base (p_chart a)
          rw [hg₀_fac, Scheme.Hom.comp_apply, hz_y, hy_Pa, (hChart_spec a).2.1]
        let P_V : Scheme.{u} := Limits.pullback g₀ (σ_chart a)
        let f₁ : P_V ⟶ A₀ := Limits.pullback.fst g₀ (σ_chart a)
        let f₂ : P_V ⟶ S_k := Limits.pullback.snd g₀ (σ_chart a)
        have : IsAffine P_V := inferInstance
        have : CompactSpace ↥P_V := Scheme.compactSpace_of_isAffine P_V
        have hSec_PV : ∀ q : ↥P_V, ∃ s_q : S_k ⟶ P_V, s_q ≫ f₂ = 𝟙 S_k ∧ s_q.base pt_k = q := by
          intro q
          let e_PV := P_V.isoSpec
          let R_PV : CommRingCat.{u} := P_V.presheaf.obj (Opposite.op ⊤)
          let q' : PrimeSpectrum ↑R_PV := e_PV.hom.base q
          obtain ⟨m_q, hm_max, hle_mq⟩ := Ideal.exists_le_maximal q'.asIdeal q'.isPrime.ne_top
          let q₀' : PrimeSpectrum ↑R_PV := ⟨m_q, hm_max.isPrime⟩
          let q₀ : ↥P_V := e_PV.inv.base q₀'
          have hq₀'_cl : IsClosed ({q₀'} : Set (PrimeSpectrum ↑R_PV)) :=
            (PrimeSpectrum.isClosed_singleton_iff_isMaximal q₀').mpr hm_max
          have hq₀_pre : ({q₀} : Set ↥P_V) =
              e_PV.hom.base ⁻¹' ({q₀'} : Set (PrimeSpectrum ↑R_PV)) := by
            ext w_pt
            constructor
            · intro hw
              rw [Set.mem_singleton_iff.mp hw]
              change (e_PV.inv ≫ e_PV.hom).base q₀' = q₀'
              rw [e_PV.inv_hom_id]; rfl
            · intro hw_pt
              have hw' : e_PV.hom.base w_pt = q₀' := hw_pt
              rw [Set.mem_singleton_iff]; dsimp only [q₀]; rw [← hw']
              change w_pt = (e_PV.hom ≫ e_PV.inv).base w_pt
              rw [e_PV.hom_inv_id]; rfl
          have hq₀_cl : IsClosed ({q₀} : Set ↥P_V) := by
            rw [hq₀_pre]; exact hq₀'_cl.preimage e_PV.hom.continuous
          obtain ⟨s_q₀, hs_id, hs_pt⟩ := hClosedPtSection f₂ q₀ hq₀_cl
          have hEt_f₂ : Etale f₂ := inferInstance
          have hEt_id : Etale (𝟙 S_k) := inferInstance
          have : Etale s_q₀ :=
            MorphismProperty.of_postcomp (@Etale) s_q₀ f₂ hEt_f₂ (hs_id.symm ▸ hEt_id)
          have hRange_sq₀ : Set.range s_q₀.base = ({q₀} : Set ↥P_V) := by
            ext w_pt
            simp only [Set.mem_range, Set.mem_singleton_iff]
            exact ⟨by rintro ⟨pt, rfl⟩; rw [Subsingleton.elim pt pt_k, hs_pt],
              by rintro rfl; exact ⟨pt_k, hs_pt⟩⟩
          have hOpen_q₀ : IsOpen ({q₀} : Set ↥P_V) := by
            rw [← hRange_sq₀]; exact s_q₀.isOpenMap.isOpen_range
          have hq₀'_mem : q₀' ∈ closure ({q'} : Set (PrimeSpectrum ↑R_PV)) :=
            (PrimeSpectrum.le_iff_mem_closure q' q₀').mp hle_mq
          have hq₀_mem : q₀ ∈ closure ({q} : Set ↥P_V) := by
            let S_q : Set ↥(Spec (P_V.presheaf.obj (Opposite.op ⊤))) := {q'}
            have hcont : Continuous e_PV.inv.base := e_PV.inv.continuous
            have himg : e_PV.inv.base '' closure S_q ⊆ closure (e_PV.inv.base '' S_q) :=
              image_closure_subset_closure_image hcont
            have hq_eq : e_PV.inv.base q' = q := by
              change (e_PV.hom ≫ e_PV.inv).base q = q
              rw [e_PV.hom_inv_id]; rfl
            have hset_eq : e_PV.inv.base '' S_q = ({q} : Set ↥P_V) := by
              ext z
              constructor
              · rintro ⟨u_pt, hu_pt, hzu⟩
                have hu_eq : u_pt = q' := hu_pt
                rw [← hzu, hu_eq, hq_eq]; rfl
              · intro hz
                have hz_eq : z = q := hz
                exact ⟨q', rfl, hq_eq.trans hz_eq.symm⟩
            have hmem1 : q₀ ∈ closure (e_PV.inv.base '' S_q) := himg ⟨q₀', hq₀'_mem, rfl⟩
            rwa [hset_eq] at hmem1
          have hq_eq_q₀ : q = q₀ := by
            obtain ⟨w_pt, hw_open, hw_sing⟩ :=
              (mem_closure_iff.mp hq₀_mem) ({q₀} : Set ↥P_V) hOpen_q₀ (Set.mem_singleton q₀)
            exact (Set.mem_singleton_iff.mp hw_sing).symm.trans (Set.mem_singleton_iff.mp hw_open)
          exact ⟨s_q₀, hs_id, hs_pt.trans hq_eq_q₀.symm⟩
        have : DiscreteTopology ↥P_V := by
          rw [discreteTopology_iff_isOpen_singleton]
          intro q
          obtain ⟨s_q, hs_id, hs_pt⟩ := hSec_PV q
          have hEt_f₂ : Etale f₂ := inferInstance
          have hEt_id : Etale (𝟙 S_k) := inferInstance
          have : Etale s_q :=
            MorphismProperty.of_postcomp (@Etale) s_q f₂ hEt_f₂ (hs_id.symm ▸ hEt_id)
          have hRange_sq : Set.range s_q.base = ({q} : Set ↥P_V) := by
            ext w_pt
            simp only [Set.mem_range, Set.mem_singleton_iff]
            exact ⟨by rintro ⟨pt, rfl⟩; rw [Subsingleton.elim pt pt_k, hs_pt],
              by rintro rfl; exact ⟨pt_k, hs_pt⟩⟩
          rw [← hRange_sq]; exact s_q.isOpenMap.isOpen_range
        have hFin_PV : Finite ↥P_V :=
          Set.finite_univ_iff.mp isCompact_univ.finite_of_discrete
        have hCl_f₁ : ∀ q : ↥P_V, IsClosed ({f₁.base q} : Set ↥A₀) := by
          intro q
          obtain ⟨s_q, hs_id, hs_pt⟩ := hSec_PV q
          have hs_A₀ : (s_q ≫ f₁) ≫ (g₀ ≫ ι_chart a ≫ p_X) = 𝟙 S_k := by
            calc
              (s_q ≫ f₁) ≫ (g₀ ≫ ι_chart a ≫ p_X)
                = s_q ≫ (f₁ ≫ g₀) ≫ ι_chart a ≫ p_X := by simp only [Category.assoc]
              _ = s_q ≫ (f₂ ≫ σ_chart a) ≫ ι_chart a ≫ p_X := by rw [Limits.pullback.condition]
              _ = (s_q ≫ f₂) ≫ (σ_chart a ≫ ι_chart a ≫ p_X) := by simp only [Category.assoc]
              _ = 𝟙 S_k ≫ 𝟙 S_k := by rw [hs_id, (hChart_spec a).2.2.1]
              _ = 𝟙 S_k := Category.id_comp _
          have hcl := hClosedOfSection (g₀ ≫ ι_chart a ≫ p_X) (s_q ≫ f₁) hs_A₀
          rwa [Scheme.Hom.comp_apply, hs_pt] at hcl
        let Q_bad : Set ↥P_V := { q : ↥P_V | f₁.base q ≠ z_y }
        let F_bad : Set ↥A₀ := ⋃ q ∈ Q_bad, ({f₁.base q} : Set ↥A₀)
        have hF_bad_cl : IsClosed F_bad :=
          (@Set.toFinite _ Q_bad (@Subtype.finite _ hFin_PV _)).isClosed_biUnion
            (fun q _ => hCl_f₁ q)
        have hzy_not_bad : z_y ∉ F_bad := by
          intro hmem; rw [Set.mem_iUnion₂] at hmem
          rcases hmem with ⟨q, hne, heq⟩
          exact hne (Set.mem_singleton_iff.mp heq).symm
        let O_A₀ : A₀.Opens := ⟨F_badᶜ, hF_bad_cl.isOpen_compl⟩
        obtain ⟨V₁, hAff_V₁, hzy_V₁, hV₁_sub⟩ :=
          exists_isAffineOpen_mem_and_subset (x := z_y) (U := O_A₀) hzy_not_bad
        let A₁ : Scheme.{u} := Spec (A₀.presheaf.obj (Opposite.op V₁))
        let j₁ : A₁ ⟶ A₀ := hAff_V₁.fromSpec
        let y₀ : ↥A₁ := hAff_V₁.primeIdealOf ⟨z_y, hzy_V₁⟩
        have hy₀_zy : j₁.base y₀ = z_y := hAff_V₁.fromSpec_primeIdealOf ⟨z_y, hzy_V₁⟩
        let p_A₁_S₀ : A₁ ⟶ S₀ := (j₁ ≫ j₀) ≫ (Fgt.obj W).hom
        have : Etale p_A₁_S₀ := inferInstance
        let U₀ : S₀.Etale := MorphismProperty.Over.mk ⊤ p_A₁_S₀ inferInstance
        let u₀ : U₀ ⟶ W := MorphismProperty.Over.homMk (j₁ ≫ j₀) rfl
        have hu₀_y₀ : ((Fgt.map u₀).left).base y₀ = y := by
          change (j₁ ≫ j₀).base y₀ = y
          rw [Scheme.Hom.comp_apply, hy₀_zy, hz_y]
        have hPre_Pa : p_A₁_S₀.base ⁻¹' ({P_pt a} : Set ↥S₀) = ({y₀} : Set ↥A₁) := by
          ext z
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          constructor
          · intro hz_Pa
            have hg₀_z : g₀.base (j₁.base z) = (σ_chart a).base pt_k := by
              rw [(hChart_spec a).2.2.2]
              apply (ι_chart a).isOpenEmbedding.injective
              change (g₀ ≫ ι_chart a).base (j₁.base z) = (ι_chart a).base (p_chart a)
              rw [hg₀_fac, (hChart_spec a).2.1, ← hz_Pa]; rfl
            obtain ⟨q_z, hq_f₁, -⟩ :=
              Scheme.Pullback.exists_preimage_pullback (j₁.base z) pt_k hg₀_z
            have hj₁_in_V₁ : j₁.base z ∈ (V₁ : Set ↥A₀) := by
              rw [← hAff_V₁.range_fromSpec]; exact ⟨z, rfl⟩
            have hj₁_not_bad : j₁.base z ∉ F_bad := hV₁_sub hj₁_in_V₁
            have hq_eq_zy : f₁.base q_z = z_y := by
              by_contra hne
              apply hj₁_not_bad
              rw [Set.mem_iUnion₂]
              exact ⟨q_z, hne, Set.mem_singleton_iff.mpr hq_f₁.symm⟩
            apply j₁.isOpenEmbedding.injective
            rw [hy₀_zy, ← hq_eq_zy, hq_f₁]
          · rintro rfl
            change (j₁ ≫ j₀ ≫ (Fgt.obj W).hom).base y₀ = P_pt a
            rw [Scheme.Hom.comp_apply, hy₀_zy, Scheme.Hom.comp_apply, hz_y, hy_Pa]
        have hy₀_cl : IsClosed ({y₀} : Set ↥A₁) := by
          rw [← hPre_Pa]; exact (hP_cl a).preimage p_A₁_S₀.continuous
        obtain ⟨γ₀_hom, hγ₀_k, hγ₀_pt⟩ := hClosedPtSection (p_A₁_S₀ ≫ p_X) y₀ hy₀_cl
        have hγ₀_Wa : (γ₀_hom ≫ j₁ ≫ g₀) ≫ (ι_chart a ≫ p_X) = 𝟙 S_k := by
          calc
            (γ₀_hom ≫ j₁ ≫ g₀) ≫ (ι_chart a ≫ p_X)
              = γ₀_hom ≫ j₁ ≫ (g₀ ≫ ι_chart a) ≫ p_X := by simp only [Category.assoc]
            _ = γ₀_hom ≫ (p_A₁_S₀ ≫ p_X) := by
                dsimp [p_A₁_S₀]; rw [hg₀_fac]; simp only [Category.assoc]
            _ = 𝟙 S_k := hγ₀_k
        have hγ₀_Wa_pt : (γ₀_hom ≫ j₁ ≫ g₀).base pt_k = (σ_chart a).base pt_k := by
          rw [Scheme.Hom.comp_apply, hγ₀_pt, Scheme.Hom.comp_apply, hy₀_zy, hg₀_zy,
            (hChart_spec a).2.2.2]
        have hγ₀_eq_σ : γ₀_hom ≫ j₁ ≫ g₀ = σ_chart a :=
          hSectionEq (ι_chart a ≫ p_X) (γ₀_hom ≫ j₁ ≫ g₀) (σ_chart a)
            hγ₀_Wa (hChart_spec a).2.2.1 hγ₀_Wa_pt
        have hγ₀_U₀ : γ₀_hom ≫ p_A₁_S₀ = i_pt a := by
          dsimp [p_A₁_S₀, i_pt]
          rw [Category.assoc j₁ j₀ _, ← hg₀_fac, ← Category.assoc j₁ g₀ _, ← Category.assoc,
            hγ₀_eq_σ]
        let γ₀ : L_set a U₀ := ⟨γ₀_hom, hγ₀_U₀⟩
        refine ⟨U₀, u₀, y₀, γ₀, hu₀_y₀, ?_, ?_⟩
        · intro γ'
          apply Subtype.ext
          let g' : S_k ⟶ A₁ := γ'.1
          have hγ'_p : g' ≫ p_A₁_S₀ = i_pt a := γ'.2
          have hγ'_k : g' ≫ (p_A₁_S₀ ≫ p_X) = 𝟙 S_k := by
            rw [← Category.assoc, hγ'_p, hi_pt_hom a]
          have hγ'_Pa : p_A₁_S₀.base (g'.base pt_k) = P_pt a := by
            rw [← Scheme.Hom.comp_apply, hγ'_p, hi_pt_base a pt_k]
          have hγ'_y₀ : g'.base pt_k = y₀ := by
            have hmem : g'.base pt_k ∈ p_A₁_S₀.base ⁻¹' ({P_pt a} : Set ↥S₀) := hγ'_Pa
            rwa [hPre_Pa, Set.mem_singleton_iff] at hmem
          exact hSectionEq (p_A₁_S₀ ≫ p_X) g' γ₀_hom hγ'_k hγ₀_k
            (hγ'_y₀.trans hγ₀_pt.symm)
        · intro b hba
          refine ⟨fun γ_b => ?_⟩
          let g_b : S_k ⟶ A₁ := γ_b.1
          have hg_b : g_b ≫ p_A₁_S₀ = i_pt b := γ_b.2
          have hPb_eq : P_pt b = p_A₁_S₀.base (g_b.base pt_k) := by
            rw [← hi_pt_base b pt_k, ← hg_b, Scheme.Hom.comp_apply]
          have hj₀_in : j₀.base (j₁.base (g_b.base pt_k)) ∈ (V₀ : Set ↥((Fgt.obj W).left)) := by
            rw [← hAff_V₀.range_fromSpec]; exact ⟨j₁.base (g_b.base pt_k), rfl⟩
          have hIn_Oa := (hV₀_sub hj₀_in).2
          apply hIn_Oa
          have hEq_base : ((Fgt.obj W).hom).base (j₀.base (j₁.base (g_b.base pt_k))) = P_pt b := by
            rw [hPb_eq]; rfl
          rw [hEq_base, Set.mem_iUnion₂]; exact ⟨b, hba, rfl⟩

      let Φ := weilOrdGodSmallAffSpec S₀
      have : Φ.Full := by dsimp [Φ, weilOrdGodSmallAffSpec]; infer_instance
      have : Φ.Faithful := by dsimp [Φ, weilOrdGodSmallAffSpec]; infer_instance
      let Nhd : Fin s_card → Type u := fun a =>
        Σ (v : SmallModel.{u} S₀.AffineEtale), L_set a (Φ.obj v)
      let instCatNhd : ∀ a : Fin s_card, SmallCategory (Nhd a) := fun a =>
        { Hom := fun A B => { f : A.1 ⟶ B.1 // liftMap a (Φ.map f) A.2 = B.2 }
          id := fun A => ⟨𝟙 A.1, Subtype.ext (by
            dsimp [liftMap]; rw [Φ.map_id, Fgt.map_id]; exact Category.comp_id A.2.1)⟩
          comp := fun {A B C} f g => ⟨f.1 ≫ g.1, Subtype.ext (by
            have hf := congrArg Subtype.val f.2
            have hg := congrArg Subtype.val g.2
            dsimp [liftMap] at hf hg ⊢
            rw [Φ.map_comp, Fgt.map_comp]
            change A.2.1 ≫ ((Fgt.map (Φ.map f.1)).left ≫ (Fgt.map (Φ.map g.1)).left) = C.2.1
            rw [← Category.assoc, hf, hg])⟩
          id_comp := fun f => Subtype.ext (Category.id_comp f.1)
          comp_id := fun f => Subtype.ext (Category.comp_id f.1)
          assoc := fun f g h => Subtype.ext (Category.assoc f.1 g.1 h.1) }

      have hShrink : ∀ (a : Fin s_card) (W : S₀.Etale) (γ : L_set a W),
          ∃ (A : Nhd a) (w : Φ.obj A.1 ⟶ W), liftMap a w A.2 = γ := by
        intro a W γ
        obtain ⟨V, hAff_V, hmem_V, _⟩ :=
          exists_isAffineOpen_mem_and_subset (x := γ.1.base pt_k) (U := ⊤) trivial
        let R_V : CommRingCat.{u} := ((Fgt.obj W).left).presheaf.obj (Opposite.op V)
        let j_V : Spec R_V ⟶ (Fgt.obj W).left := hAff_V.fromSpec
        have hrange_γ : Set.range γ.1.base ⊆ Set.range j_V.base := by
          rintro _ ⟨pt, rfl⟩
          rw [Subsingleton.elim pt pt_k, hAff_V.range_fromSpec]; exact hmem_V
        let γ_V : S_k ⟶ Spec R_V := IsOpenImmersion.lift j_V γ.1 hrange_γ
        have hγ_V_fac : γ_V ≫ j_V = γ.1 := IsOpenImmersion.lift_fac j_V γ.1 hrange_γ
        have hEt_W : Etale ((Fgt.obj W).hom) := W.prop
        have : Etale (j_V ≫ (Fgt.obj W).hom) := inferInstance
        let A_et : S₀.AffineEtale := Scheme.AffineEtale.mk (j_V ≫ (Fgt.obj W).hom)
        let u_V : (Scheme.AffineEtale.Spec S₀).obj A_et ⟶ W :=
          MorphismProperty.Over.homMk j_V rfl
        let eqv := equivSmallModel.{u} S₀.AffineEtale
        let v₀ : SmallModel.{u} S₀.AffineEtale := eqv.functor.obj A_et
        let e_iso : (Scheme.AffineEtale.Spec S₀).obj A_et ≅ Φ.obj v₀ :=
          (Scheme.AffineEtale.Spec S₀).mapIso (eqv.unitIso.app A_et)
        let γ_V' : S_k ⟶ (Fgt.obj ((Scheme.AffineEtale.Spec S₀).obj A_et)).left := γ_V
        let γ_v₀ : S_k ⟶ (Fgt.obj (Φ.obj v₀)).left := γ_V' ≫ (Fgt.map e_iso.hom).left
        have hγ_v₀ : γ_v₀ ≫ (Fgt.obj (Φ.obj v₀)).hom = i_pt a := by
          have h1 : (γ_V' ≫ (Fgt.map e_iso.hom).left) ≫ (Fgt.obj (Φ.obj v₀)).hom =
              γ_V' ≫ (Fgt.obj ((Scheme.AffineEtale.Spec S₀).obj A_et)).hom :=
            (Category.assoc _ _ _).trans (congrArg (γ_V' ≫ ·) ((Fgt.map e_iso.hom).w))
          exact h1.trans ((Category.assoc γ_V j_V _).symm.trans
            ((congrArg (· ≫ (Fgt.obj W).hom) hγ_V_fac).trans γ.2))
        let w₀ : Φ.obj v₀ ⟶ W := e_iso.inv ≫ u_V
        refine ⟨⟨v₀, ⟨γ_v₀, hγ_v₀⟩⟩, w₀, Subtype.ext ?_⟩
        have he_inv : (Fgt.map e_iso.hom).left ≫ (Fgt.map e_iso.inv).left =
            𝟙 ((Fgt.obj ((Scheme.AffineEtale.Spec S₀).obj A_et)).left) := by
          have h1 : Fgt.map e_iso.hom ≫ Fgt.map e_iso.inv = 𝟙 _ := by
            rw [← Fgt.map_comp, e_iso.hom_inv_id, Fgt.map_id]
          exact congrArg CommaMorphism.left h1
        have hmap_w₀ : (Fgt.map w₀).left = (Fgt.map e_iso.inv).left ≫ (Fgt.map u_V).left := by
          rw [Fgt.map_comp]; rfl
        change γ_v₀ ≫ (Fgt.map w₀).left = γ.1
        rw [hmap_w₀]
        calc
          (γ_V' ≫ (Fgt.map e_iso.hom).left) ≫ ((Fgt.map e_iso.inv).left ≫ (Fgt.map u_V).left)
            = γ_V' ≫ ((Fgt.map e_iso.hom).left ≫ (Fgt.map e_iso.inv).left) ≫ (Fgt.map u_V).left := by
                simp only [Category.assoc]
          _ = γ_V' ≫ (Fgt.map u_V).left := by rw [he_inv, Category.id_comp]
          _ = γ.1 := hγ_V_fac

      have hEq_etale : ∀ (a : Fin s_card) {U' W : S₀.Etale} (w₁ w₂ : U' ⟶ W) (γ' : L_set a U'),
          liftMap a w₁ γ' = liftMap a w₂ γ' →
          ∃ (A : Nhd a) (e : Φ.obj A.1 ⟶ U'),
            liftMap a e A.2 = γ' ∧ e ≫ w₁ = e ≫ w₂ := by
        intro a U' W w₁ w₂ γ' h_eq
        have : Etale ((Fgt.obj W).hom) := W.prop
        have : Etale ((Fgt.obj U').hom) := U'.prop
        let Δ_W := Limits.pullback.diagonal ((Fgt.obj W).hom)
        have : IsOpenImmersion Δ_W :=
          FormallyUnramified.isOpenImmersion_diagonal ((Fgt.obj W).hom)
        let δ₁₂ : (Fgt.obj U').left ⟶ Limits.pullback ((Fgt.obj W).hom) ((Fgt.obj W).hom) :=
          Limits.pullback.lift ((Fgt.map w₁).left) ((Fgt.map w₂).left)
            (((Fgt.map w₁).w).trans ((Fgt.map w₂).w).symm)
        let E_sch := Limits.pullback δ₁₂ Δ_W
        let p_E : E_sch ⟶ (Fgt.obj U').left := Limits.pullback.fst δ₁₂ Δ_W
        let q_E : E_sch ⟶ (Fgt.obj W).left := Limits.pullback.snd δ₁₂ Δ_W
        have : IsOpenImmersion p_E := inferInstance
        have : Etale (p_E ≫ (Fgt.obj U').hom) := inferInstance
        let E_et : S₀.Etale := MorphismProperty.Over.mk ⊤ (p_E ≫ (Fgt.obj U').hom) inferInstance
        let e_U : E_et ⟶ U' := MorphismProperty.Over.homMk p_E rfl
        have hp_w₁ : p_E ≫ ((Fgt.map w₁).left) = q_E := by
          have hc := congrArg (· ≫ Limits.pullback.fst ((Fgt.obj W).hom) ((Fgt.obj W).hom))
            (Limits.pullback.condition (f := δ₁₂) (g := Δ_W))
          dsimp only [p_E, q_E, δ₁₂, Δ_W] at hc ⊢
          simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.diagonal_fst,
            Category.comp_id] at hc
          exact hc
        have hp_w₂ : p_E ≫ ((Fgt.map w₂).left) = q_E := by
          have hc := congrArg (· ≫ Limits.pullback.snd ((Fgt.obj W).hom) ((Fgt.obj W).hom))
            (Limits.pullback.condition (f := δ₁₂) (g := Δ_W))
          dsimp only [p_E, q_E, δ₁₂, Δ_W] at hc ⊢
          simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.diagonal_snd,
            Category.comp_id] at hc
          exact hc
        have he_eq : e_U ≫ w₁ = e_U ≫ w₂ :=
          MorphismProperty.Over.Hom.ext (hp_w₁.trans hp_w₂.symm)
        have hγ'_eq : γ'.1 ≫ δ₁₂ = (γ'.1 ≫ ((Fgt.map w₁).left)) ≫ Δ_W := by
          apply Limits.pullback.hom_ext
          · simp only [δ₁₂, Δ_W, Category.assoc, Limits.pullback.lift_fst,
              Limits.pullback.diagonal_fst, Category.comp_id]
          · simp only [δ₁₂, Δ_W, Category.assoc, Limits.pullback.lift_snd,
              Limits.pullback.diagonal_snd, Category.comp_id]
            exact (congrArg Subtype.val h_eq).symm
        let γ_E : S_k ⟶ E_sch :=
          Limits.pullback.lift γ'.1 (γ'.1 ≫ ((Fgt.map w₁).left)) hγ'_eq
        have hγ_E_p : γ_E ≫ p_E = γ'.1 := Limits.pullback.lift_fst _ _ _
        have hγ_E_hom : γ_E ≫ (Fgt.obj E_et).hom = i_pt a := by
          change γ_E ≫ (p_E ≫ (Fgt.obj U').hom) = i_pt a
          rw [← Category.assoc, hγ_E_p, γ'.2]
        obtain ⟨A, w_A, hw_A⟩ := hShrink a E_et ⟨γ_E, hγ_E_hom⟩
        refine ⟨A, w_A ≫ e_U, Subtype.ext ?_, ?_⟩
        · have hw_val : A.2.1 ≫ ((Fgt.map w_A).left) = γ_E := congrArg Subtype.val hw_A
          have hcomp_left : (Fgt.map (w_A ≫ e_U)).left = (Fgt.map w_A).left ≫ (Fgt.map e_U).left := by
            rw [Fgt.map_comp]; rfl
          change A.2.1 ≫ (Fgt.map (w_A ≫ e_U)).left = γ'.1
          rw [hcomp_left]
          exact (Category.assoc A.2.1 ((Fgt.map w_A).left) ((Fgt.map e_U).left)).symm.trans
            ((congrArg (· ≫ p_E) hw_val).trans hγ_E_p)
        · rw [Category.assoc, he_eq, Category.assoc]

      have hCone_Nhd : ∀ (a : Fin s_card) (A₁ A₂ : Nhd a),
          ∃ (A₃ : Nhd a) (f₁ : A₃ ⟶ A₁) (f₂ : A₃ ⟶ A₂), True := by
        intro a A₁ A₂
        let W₁ := Φ.obj A₁.1
        let W₂ := Φ.obj A₂.1
        have : Etale ((Fgt.obj W₁).hom) := W₁.prop
        have : Etale ((Fgt.obj W₂).hom) := W₂.prop
        let P₁₂ := Limits.pullback ((Fgt.obj W₁).hom) ((Fgt.obj W₂).hom)
        let p₁ : P₁₂ ⟶ (Fgt.obj W₁).left := Limits.pullback.fst _ _
        let p₂ : P₁₂ ⟶ (Fgt.obj W₂).left := Limits.pullback.snd _ _
        have : Etale (p₁ ≫ (Fgt.obj W₁).hom) := inferInstance
        let W₁₂ : S₀.Etale := MorphismProperty.Over.mk ⊤ (p₁ ≫ (Fgt.obj W₁).hom) inferInstance
        let u₁ : W₁₂ ⟶ W₁ := MorphismProperty.Over.homMk p₁ rfl
        let u₂ : W₁₂ ⟶ W₂ := MorphismProperty.Over.homMk p₂ Limits.pullback.condition.symm
        let γ₁₂_hom : S_k ⟶ P₁₂ :=
          Limits.pullback.lift A₁.2.1 A₂.2.1 (A₁.2.2.trans A₂.2.2.symm)
        have hγ₁₂_hom : γ₁₂_hom ≫ (Fgt.obj W₁₂).hom = i_pt a := by
          change γ₁₂_hom ≫ (p₁ ≫ (Fgt.obj W₁).hom) = i_pt a
          rw [← Category.assoc, Limits.pullback.lift_fst, A₁.2.2]
        obtain ⟨A₃, w₃, hw₃⟩ := hShrink a W₁₂ ⟨γ₁₂_hom, hγ₁₂_hom⟩
        let f₁_raw : A₃.1 ⟶ A₁.1 := Φ.preimage (w₃ ≫ u₁)
        let f₂_raw : A₃.1 ⟶ A₂.1 := Φ.preimage (w₃ ≫ u₂)
        have hw_val : A₃.2.1 ≫ ((Fgt.map w₃).left) = γ₁₂_hom := congrArg Subtype.val hw₃
        have hf₁_lift : liftMap a (Φ.map f₁_raw) A₃.2 = A₁.2 := by
          rw [Φ.map_preimage]; apply Subtype.ext
          have hcomp_left : (Fgt.map (w₃ ≫ u₁)).left = (Fgt.map w₃).left ≫ (Fgt.map u₁).left := by
            rw [Fgt.map_comp]; rfl
          change A₃.2.1 ≫ (Fgt.map (w₃ ≫ u₁)).left = A₁.2.1; rw [hcomp_left]
          exact (Category.assoc A₃.2.1 ((Fgt.map w₃).left) ((Fgt.map u₁).left)).symm.trans
            ((congrArg (· ≫ p₁) hw_val).trans (Limits.pullback.lift_fst _ _ _))
        have hf₂_lift : liftMap a (Φ.map f₂_raw) A₃.2 = A₂.2 := by
          rw [Φ.map_preimage]; apply Subtype.ext
          have hcomp_left : (Fgt.map (w₃ ≫ u₂)).left = (Fgt.map w₃).left ≫ (Fgt.map u₂).left := by
            rw [Fgt.map_comp]; rfl
          change A₃.2.1 ≫ (Fgt.map (w₃ ≫ u₂)).left = A₂.2.1; rw [hcomp_left]
          exact (Category.assoc A₃.2.1 ((Fgt.map w₃).left) ((Fgt.map u₂).left)).symm.trans
            ((congrArg (· ≫ p₂) hw_val).trans (Limits.pullback.lift_snd _ _ _))
        exact ⟨A₃, ⟨f₁_raw, hf₁_lift⟩, ⟨f₂_raw, hf₂_lift⟩, trivial⟩

      let Idx : Fin s_card → Type u := fun a => Opposite (Nhd a)
      let T_S₀ : S₀.Etale :=
        MorphismProperty.Over.mk ⊤ (𝟙 S₀) (inferInstance : Etale (𝟙 S₀))
      let instFiltIdx : ∀ a : Fin s_card, IsFiltered (Idx a) := fun a =>
        { cocone_objs := fun j₁ j₂ => by
            obtain ⟨A₃, f₁, f₂, -⟩ := hCone_Nhd a j₁.unop j₂.unop
            exact ⟨Opposite.op A₃, f₁.op, f₂.op, trivial⟩
          cocone_maps := fun {j₁ j₂} g₁ g₂ => by
            have hg_eq : liftMap a (Φ.map g₁.unop.1) j₂.unop.2 =
                liftMap a (Φ.map g₂.unop.1) j₂.unop.2 :=
              g₁.unop.2.trans g₂.unop.2.symm
            obtain ⟨A₃, e, he_lift, he_eq⟩ :=
              hEq_etale a (Φ.map g₁.unop.1) (Φ.map g₂.unop.1) j₂.unop.2 hg_eq
            let h_raw : A₃.1 ⟶ j₂.unop.1 := Φ.preimage e
            have hh_lift : liftMap a (Φ.map h_raw) A₃.2 = j₂.unop.2 := by rwa [Φ.map_preimage]
            let h_mor : A₃ ⟶ j₂.unop := ⟨h_raw, hh_lift⟩
            have hcomp_eq : h_mor ≫ g₁.unop = h_mor ≫ g₂.unop := by
              apply Subtype.ext; apply Φ.map_injective
              change Φ.map (h_raw ≫ g₁.unop.1) = Φ.map (h_raw ≫ g₂.unop.1)
              rw [Φ.map_comp, Φ.map_comp, Φ.map_preimage, he_eq]
            exact ⟨Opposite.op A₃, h_mor.op, congrArg Quiver.Hom.op hcomp_eq⟩
          nonempty := by
            obtain ⟨A₀, -, -⟩ := hShrink a T_S₀ ⟨i_pt a, Category.comp_id _⟩
            exact ⟨Opposite.op A₀⟩ }

      let D_op : ∀ a : Fin s_card, Idx a ⥤ Opposite S₀.Etale := fun a =>
        { obj := fun j => Opposite.op (Φ.obj j.unop.1)
          map := fun f => Opposite.op (Φ.map f.unop.1)
          map_id := fun j => congrArg Opposite.op (Φ.map_id j.unop.1)
          map_comp := fun f g => congrArg Opposite.op (Φ.map_comp g.unop.1 f.unop.1) }

      refine ⟨i_pt, hi_pt_base, hCov_lift_raw, hIso_shrink, Idx, inferInstance, instFiltIdx,
        D_op, fun a j => j.unop.2, ?_, ?_, ?_⟩
      · intro a j₁ j₂ f
        exact congrArg Subtype.val f.unop.2
      · intro a W γ
        obtain ⟨A, w, hw⟩ := hShrink a W γ
        exact ⟨Opposite.op A, w, congrArg Subtype.val hw⟩
      · intro a W γ j₁ j₂ w₁ w₂ hw₁ hw₂
        obtain ⟨A', g₁, g₂, -⟩ := hCone_Nhd a j₁.unop j₂.unop
        have hpar : liftMap a (Φ.map g₁.1 ≫ w₁) A'.2 = liftMap a (Φ.map g₂.1 ≫ w₂) A'.2 := by
          apply Subtype.ext
          have hg₁ := congrArg Subtype.val g₁.2
          have hg₂ := congrArg Subtype.val g₂.2
          dsimp [liftMap] at hg₁ hg₂ ⊢
          rw [Fgt.map_comp, Fgt.map_comp]
          change A'.2.1 ≫ ((Fgt.map (Φ.map g₁.1)).left ≫ (Fgt.map w₁).left) =
            A'.2.1 ≫ ((Fgt.map (Φ.map g₂.1)).left ≫ (Fgt.map w₂).left)
          rw [← Category.assoc, ← Category.assoc, hg₁, hg₂, hw₁, hw₂]
        obtain ⟨A₃, e, he_lift, he_eq⟩ :=
          hEq_etale a (Φ.map g₁.1 ≫ w₁) (Φ.map g₂.1 ≫ w₂) A'.2 hpar
        let h_raw : A₃.1 ⟶ A'.1 := Φ.preimage e
        have hh_lift : liftMap a (Φ.map h_raw) A₃.2 = A'.2 := by rwa [Φ.map_preimage]
        let h_mor : A₃ ⟶ A' := ⟨h_raw, hh_lift⟩
        refine ⟨Opposite.op A₃, (h_mor ≫ g₁).op, (h_mor ≫ g₂).op, ?_⟩
        change Φ.map (h_raw ≫ g₁.1) ≫ w₁ = Φ.map (h_raw ≫ g₂.1) ≫ w₂
        rw [Φ.map_comp, Φ.map_comp, Φ.map_preimage, Category.assoc, Category.assoc, he_eq]

    
    let _ := hCatIdx
    let _ := hFiltIdx
    let L_set : Fin s_card → S₀.Etale → Type u := fun a W =>
      { γ : S_k ⟶ ((Fgt.obj W).left) // γ ≫ ((Fgt.obj W).hom) = i_pt a }
    let liftMap : ∀ (a : Fin s_card) {W₁ W₂ : S₀.Etale}, (W₁ ⟶ W₂) → L_set a W₁ → L_set a W₂ :=
      fun a {_ _} u γ =>
        ⟨γ.1 ≫ ((Fgt.map u).left),
          (Category.assoc γ.1 ((Fgt.map u).left) _).trans
            ((congrArg (γ.1 ≫ ·) ((Fgt.map u).w)).trans γ.2)⟩

    let P_fam : ∀ (I : Type) (idx_pt : I → Fin s_card) (X_fam : I → Type u),
        Opposite S₀.Etale ⥤ Type u := fun I idx_pt X_fam =>
      { obj := fun opW => ∀ i : I, L_set (idx_pt i) (Opposite.unop opW) → X_fam i
        map := fun {_ _} f => TypeCat.ofHom (fun s i γ => s i (liftMap (idx_pt i) f.unop γ))
        map_id := fun _ => congrArg TypeCat.ofHom (funext fun s => funext fun i => funext fun γ =>
          congrArg (s i) (Subtype.ext (Category.comp_id γ.1)))
        map_comp := fun _ _ => congrArg TypeCat.ofHom (funext fun s => funext fun i => funext fun γ =>
          congrArg (s i) (Subtype.ext (Category.assoc γ.1 _ _).symm)) }

    have hSheaf_fam : ∀ (I : Type) (idx_pt : I → Fin s_card) (X_fam : I → Type u),
        Presieve.IsSheaf J (P_fam I idx_pt X_fam) := by
      intro I idx_pt X_fam W R_sieve hR_sieve
      have hCov_R := (hMemJ_iff W R_sieve).mp hR_sieve
      intro x hx
      have hLift_ex : ∀ (a : Fin s_card) (γ : L_set a W),
          ∃ (Y : S₀.Etale) (f : Y ⟶ W) (_ : R_sieve.arrows f) (δ : L_set a Y),
            liftMap a f δ = γ := by
        intro a γ
        obtain ⟨Y, f, y₁, hf_R, _, hfy₁⟩ := hCov_R (γ.1.base pt_k)
        obtain ⟨γ₁, hγ₁_hom, hγ₁_u⟩ := hCov_lift_raw a f γ.1 γ.2 ⟨y₁, hfy₁⟩
        exact ⟨Y, f, hf_R, ⟨γ₁, hγ₁_hom⟩, Subtype.ext hγ₁_u⟩
      have hAgree : ∀ (i : I) (γ : L_set (idx_pt i) W)
          {Y₁ Y₂ : S₀.Etale} (f₁ : Y₁ ⟶ W) (hf₁ : R_sieve.arrows f₁) (δ₁ : L_set (idx_pt i) Y₁)
          (f₂ : Y₂ ⟶ W) (hf₂ : R_sieve.arrows f₂) (δ₂ : L_set (idx_pt i) Y₂),
          liftMap (idx_pt i) f₁ δ₁ = γ → liftMap (idx_pt i) f₂ δ₂ = γ →
          x f₁ hf₁ i δ₁ = x f₂ hf₂ i δ₂ := by
        intro i γ Y₁ Y₂ f₁ hf₁ δ₁ f₂ hf₂ δ₂ hδ₁ hδ₂
        have : Etale ((Fgt.map f₁).left) := hEtale_map f₁
        have : Etale ((Fgt.map f₂).left) := hEtale_map f₂
        have : Etale ((Fgt.obj Y₁).hom) := Y₁.prop
        let P₁₂ := Limits.pullback ((Fgt.map f₁).left) ((Fgt.map f₂).left)
        let p₁ : P₁₂ ⟶ (Fgt.obj Y₁).left := Limits.pullback.fst _ _
        let p₂ : P₁₂ ⟶ (Fgt.obj Y₂).left := Limits.pullback.snd _ _
        have : Etale (p₁ ≫ (Fgt.obj Y₁).hom) := inferInstance
        let Y₁₂ : S₀.Etale := MorphismProperty.Over.mk ⊤ (p₁ ≫ (Fgt.obj Y₁).hom) inferInstance
        let g₁ : Y₁₂ ⟶ Y₁ := MorphismProperty.Over.homMk p₁ rfl
        have hp₂_w : p₂ ≫ (Fgt.obj Y₂).hom = p₁ ≫ (Fgt.obj Y₁).hom := by
          rw [← (Fgt.map f₂).w, ← Category.assoc, ← Limits.pullback.condition,
            Category.assoc, (Fgt.map f₁).w]
        let g₂ : Y₁₂ ⟶ Y₂ := MorphismProperty.Over.homMk p₂ hp₂_w
        have hg_comm : g₁ ≫ f₁ = g₂ ≫ f₂ :=
          MorphismProperty.Over.Hom.ext Limits.pullback.condition
        have hcompat := hx g₁ g₂ hf₁ hf₂ hg_comm
        have hδ_eq : δ₁.1 ≫ ((Fgt.map f₁).left) = δ₂.1 ≫ ((Fgt.map f₂).left) :=
          (congrArg Subtype.val hδ₁).trans (congrArg Subtype.val hδ₂).symm
        let δ₁₂_hom : S_k ⟶ P₁₂ := Limits.pullback.lift δ₁.1 δ₂.1 hδ_eq
        have hδ₁₂_hom : δ₁₂_hom ≫ (Fgt.obj Y₁₂).hom = i_pt (idx_pt i) := by
          change δ₁₂_hom ≫ (p₁ ≫ (Fgt.obj Y₁).hom) = i_pt (idx_pt i)
          rw [← Category.assoc, Limits.pullback.lift_fst, δ₁.2]
        let δ₁₂ : L_set (idx_pt i) Y₁₂ := ⟨δ₁₂_hom, hδ₁₂_hom⟩
        have hval := congrFun (congrFun hcompat i) δ₁₂
        have hl₁ : liftMap (idx_pt i) g₁ δ₁₂ = δ₁ := Subtype.ext (Limits.pullback.lift_fst _ _ _)
        have hl₂ : liftMap (idx_pt i) g₂ δ₁₂ = δ₂ := Subtype.ext (Limits.pullback.lift_snd _ _ _)
        change x f₁ hf₁ i (liftMap (idx_pt i) g₁ δ₁₂) =
          x f₂ hf₂ i (liftMap (idx_pt i) g₂ δ₁₂) at hval
        rwa [hl₁, hl₂] at hval
      let s₀ : ∀ i : I, L_set (idx_pt i) W → X_fam i := fun i γ =>
        let f := Classical.choose (Classical.choose_spec (hLift_ex (idx_pt i) γ))
        let hf := Classical.choose
          (Classical.choose_spec (Classical.choose_spec (hLift_ex (idx_pt i) γ)))
        let δ := Classical.choose (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (hLift_ex (idx_pt i) γ))))
        x f hf i δ
      refine ⟨s₀, ?_, ?_⟩
      · intro Y f hf
        funext i δ
        let γ := liftMap (idx_pt i) f δ
        let hspec := Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (hLift_ex (idx_pt i) γ))))
        exact hAgree i γ _ _ _ f hf δ hspec rfl
      · intro s₁ hs₁
        funext i γ
        let f := Classical.choose (Classical.choose_spec (hLift_ex (idx_pt i) γ))
        let hf := Classical.choose
          (Classical.choose_spec (Classical.choose_spec (hLift_ex (idx_pt i) γ)))
        let δ := Classical.choose (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (hLift_ex (idx_pt i) γ))))
        let hδ : liftMap (idx_pt i) f δ = γ := Classical.choose_spec (Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (hLift_ex (idx_pt i) γ))))
        calc
          s₁ i γ = s₁ i (liftMap (idx_pt i) f δ) := by rw [hδ]
          _ = x f hf i δ := congrFun (congrFun (hs₁ f hf) i) δ
          _ = s₀ i γ := rfl

    let P_single : Fin s_card → ModR → (Opposite S₀.Etale ⥤ ModR) := fun a N =>
      { obj := fun opW => ModuleCat.of R (L_set a (Opposite.unop opW) → ↑N)
        map := fun {_ _} f => ModuleCat.ofHom
          { toFun := fun s γ => s (liftMap a f.unop γ)
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        map_id := fun _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun γ =>
          congrArg s (Subtype.ext (Category.comp_id γ.1)))
        map_comp := fun _ _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun γ =>
          congrArg s (Subtype.ext (Category.assoc γ.1 _ _).symm)) }

    have hSheaf_single : ∀ (a : Fin s_card) (N : ModR), Presheaf.IsSheaf J (P_single a N) := by
      intro a N E
      let e_iso : (P_single a N ⋙ coyoneda.obj (Opposite.op E)) ≅
          P_fam Unit (fun _ => a) (fun _ => E ⟶ N) :=
        NatIso.ofComponents
          (fun _ =>
            { hom := TypeCat.ofHom (fun φ _ γ => ModuleCat.ofHom
                { toFun := fun e => φ.hom e γ
                  map_add' := fun e₁ e₂ => congrFun (φ.hom.map_add e₁ e₂) γ
                  map_smul' := fun r e => congrFun (φ.hom.map_smul r e) γ })
              inv := TypeCat.ofHom (fun ψ => ModuleCat.ofHom
                { toFun := fun e γ => (ψ () γ).hom e
                  map_add' := fun e₁ e₂ => funext fun γ => (ψ () γ).hom.map_add e₁ e₂
                  map_smul' := fun r e => funext fun γ => (ψ () γ).hom.map_smul r e })
              hom_inv_id := rfl
              inv_hom_id := rfl })
          (fun _ => rfl)
      exact Presieve.isSheaf_iso J e_iso.symm (hSheaf_fam Unit (fun _ => a) (fun _ => E ⟶ N))

    let Sky : Fin s_card → (ModR ⥤ 𝒞) := fun a =>
      { obj := fun N => ⟨P_single a N, hSheaf_single a N⟩
        map := fun {N₁ N₂} α =>
          { hom :=
              { app := fun _ => ModuleCat.ofHom
                  { toFun := fun s γ => α.hom (s γ)
                    map_add' := fun s₁ s₂ => funext fun γ => α.hom.map_add (s₁ γ) (s₂ γ)
                    map_smul' := fun r s => funext fun γ => α.hom.map_smul r (s γ) }
                naturality := fun _ _ _ => rfl } }
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }

    let Q_pre : Opposite S₀.Etale ⥤ ModR :=
      { obj := fun opW => ModuleCat.of R (∀ a : Fin s_card, L_set a (Opposite.unop opW) → R)
        map := fun {_ _} f => ModuleCat.ofHom
          { toFun := fun s a γ => s a (liftMap a f.unop γ)
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        map_id := fun _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun a => funext fun γ =>
          congrArg (s a) (Subtype.ext (Category.comp_id γ.1)))
        map_comp := fun _ _ => ModuleCat.hom_ext (LinearMap.ext fun s => funext fun a => funext fun γ =>
          congrArg (s a) (Subtype.ext (Category.assoc γ.1 _ _).symm)) }

    have hSheaf_Q : Presheaf.IsSheaf J Q_pre := by
      intro E
      let e_iso : (Q_pre ⋙ coyoneda.obj (Opposite.op E)) ≅
          P_fam (Fin s_card) id (fun _ => E ⟶ RM) :=
        NatIso.ofComponents
          (fun _ =>
            { hom := TypeCat.ofHom (fun φ a γ => ModuleCat.ofHom
                { toFun := fun e => φ.hom e a γ
                  map_add' := fun e₁ e₂ => congrFun (congrFun (φ.hom.map_add e₁ e₂) a) γ
                  map_smul' := fun r e => congrFun (congrFun (φ.hom.map_smul r e) a) γ })
              inv := TypeCat.ofHom (fun ψ => ModuleCat.ofHom
                { toFun := fun e a γ => (ψ a γ).hom e
                  map_add' := fun e₁ e₂ => funext fun a => funext fun γ => (ψ a γ).hom.map_add e₁ e₂
                  map_smul' := fun r e => funext fun a => funext fun γ => (ψ a γ).hom.map_smul r e })
              hom_inv_id := rfl
              inv_hom_id := rfl })
          (fun _ => rfl)
      exact Presieve.isSheaf_iso J e_iso.symm (hSheaf_fam (Fin s_card) id (fun _ => E ⟶ RM))

    let Q_S : 𝒞 := ⟨Q_pre, hSheaf_Q⟩

    let Stalk : Fin s_card → (𝒞 ⥤ ModR) := fun a =>
      Functor.comp (sheafToPresheaf J ModR)
        (Functor.comp ((Functor.whiskeringLeft (Idx a) (Opposite S₀.Etale) ModR).obj (D_op a))
          Limits.colim)

    let germ_map : ∀ (a : Fin s_card) (F : 𝒞) (W : S₀.Etale) (γ : L_set a W),
        F.obj.obj (Opposite.op W) ⟶ (Stalk a).obj F := fun a F W γ =>
      let j₀ := Classical.choose (hIdx_shrink a W γ)
      let w₀ := Classical.choose (Classical.choose_spec (hIdx_shrink a W γ))
      F.obj.map (Opposite.op w₀) ≫ Limits.colimit.ι (D_op a ⋙ F.obj) j₀

    have hgerm_eq : ∀ (a : Fin s_card) (F : 𝒞) {W : S₀.Etale} {γ : L_set a W}
        (j : Idx a) (w : Opposite.unop ((D_op a).obj j) ⟶ W),
        liftMap a w (γ_idx a j) = γ →
        germ_map a F W γ = F.obj.map (Opposite.op w) ≫ Limits.colimit.ι (D_op a ⋙ F.obj) j := by
      intro a F W γ j w hw
      let j₀ := Classical.choose (hIdx_shrink a W γ)
      let w₀ := Classical.choose (Classical.choose_spec (hIdx_shrink a W γ))
      have hw₀ : (γ_idx a j₀).1 ≫ ((Fgt.map w₀).left) = γ.1 :=
        Classical.choose_spec (Classical.choose_spec (hIdx_shrink a W γ))
      obtain ⟨j₃, f₀, f, hf_eq⟩ :=
        hIdx_refine a γ.1 j₀ j w₀ w hw₀ (congrArg Subtype.val hw)
      change F.obj.map (Opposite.op w₀) ≫ Limits.colimit.ι (D_op a ⋙ F.obj) j₀ =
        F.obj.map (Opposite.op w) ≫ Limits.colimit.ι (D_op a ⋙ F.obj) j
      have hc₀ := Limits.colimit.w (D_op a ⋙ F.obj) f₀
      have hc₁ := Limits.colimit.w (D_op a ⋙ F.obj) f
      have hm₀ : F.obj.map (Opposite.op w₀) ≫ (D_op a ⋙ F.obj).map f₀ =
          F.obj.map (Opposite.op (((D_op a).map f₀).unop ≫ w₀)) :=
        (F.obj.map_comp (Opposite.op w₀) ((D_op a).map f₀)).symm
      have hm₁ : F.obj.map (Opposite.op w) ≫ (D_op a ⋙ F.obj).map f =
          F.obj.map (Opposite.op (((D_op a).map f).unop ≫ w)) :=
        (F.obj.map_comp (Opposite.op w) ((D_op a).map f)).symm
      calc
        F.obj.map (Opposite.op w₀) ≫ Limits.colimit.ι (D_op a ⋙ F.obj) j₀
          = (F.obj.map (Opposite.op w₀) ≫ (D_op a ⋙ F.obj).map f₀) ≫
              Limits.colimit.ι (D_op a ⋙ F.obj) j₃ := by rw [← hc₀, Category.assoc]
        _ = F.obj.map (Opposite.op (((D_op a).map f₀).unop ≫ w₀)) ≫
              Limits.colimit.ι (D_op a ⋙ F.obj) j₃ := by rw [hm₀]
        _ = F.obj.map (Opposite.op (((D_op a).map f).unop ≫ w)) ≫
              Limits.colimit.ι (D_op a ⋙ F.obj) j₃ := by rw [hf_eq]
        _ = (F.obj.map (Opposite.op w) ≫ (D_op a ⋙ F.obj).map f) ≫
              Limits.colimit.ι (D_op a ⋙ F.obj) j₃ := by rw [hm₁]
        _ = F.obj.map (Opposite.op w) ≫ Limits.colimit.ι (D_op a ⋙ F.obj) j := by
              rw [Category.assoc, hc₁]

    let cocone_stalk : ∀ (a : Fin s_card) {F : 𝒞} {N : ModR},
        (F ⟶ (Sky a).obj N) → Limits.Cocone (D_op a ⋙ F.obj) := fun a {F N} β =>
      { pt := N
        ι :=
          { app := fun j =>
              β.hom.app ((D_op a).obj j) ≫
                ModuleCat.ofHom
                  { toFun := fun fn => fn (γ_idx a j)
                    map_add' := fun _ _ => rfl
                    map_smul' := fun _ _ => rfl }
            naturality := fun {j₁ j₂} f => by
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro s
              have hnat := LinearMap.congr_fun
                (ModuleCat.hom_ext_iff.mp (β.hom.naturality ((D_op a).map f))) s
              have hval := congrFun hnat (γ_idx a j₂)
              have hf_idx : liftMap a ((D_op a).map f).unop (γ_idx a j₂) = γ_idx a j₁ :=
                Subtype.ext (hIdx_map a f)
              exact hval.trans (congrArg ((β.hom.app ((D_op a).obj j₁)).hom s) hf_idx) } }

    let adj_stalk : ∀ a : Fin s_card, Stalk a ⊣ Sky a := fun a =>
      Adjunction.mkOfHomEquiv
        { homEquiv := fun F N =>
            { toFun := fun α =>
                { hom :=
                    { app := fun opW => ModuleCat.ofHom
                        { toFun := fun s γ => (germ_map a F (Opposite.unop opW) γ ≫ α).hom s
                          map_add' := fun s₁ s₂ => funext fun γ =>
                            (germ_map a F (Opposite.unop opW) γ ≫ α).hom.map_add s₁ s₂
                          map_smul' := fun r s => funext fun γ =>
                            (germ_map a F (Opposite.unop opW) γ ≫ α).hom.map_smul r s }
                      naturality := fun {opW₁ opW₂} f => ModuleCat.hom_ext (LinearMap.ext fun s =>
                        funext fun γ => by
                          let W₁ := Opposite.unop opW₁
                          let W₂ := Opposite.unop opW₂
                          obtain ⟨j, w, hw_raw⟩ := hIdx_shrink a W₂ γ
                          have hw : liftMap a w (γ_idx a j) = γ := Subtype.ext hw_raw
                          have hw' : liftMap a (w ≫ f.unop) (γ_idx a j) = liftMap a f.unop γ := by
                            rw [← hw]
                            apply Subtype.ext; dsimp [liftMap]
                            rw [Fgt.map_comp]; exact (Category.assoc _ _ _).symm
                          change (germ_map a F W₂ γ ≫ α).hom ((F.obj.map f).hom s) =
                            (germ_map a F W₁ (liftMap a f.unop γ) ≫ α).hom s
                          rw [hgerm_eq a F j w hw, hgerm_eq a F j (w ≫ f.unop) hw']
                          have hcomp_f : F.obj.map (Opposite.op (w ≫ f.unop)) =
                              F.obj.map f ≫ F.obj.map (Opposite.op w) :=
                            F.obj.map_comp f (Opposite.op w)
                          rw [hcomp_f]
                          rfl) } }
              invFun := fun β => Limits.colimit.desc (D_op a ⋙ F.obj) (cocone_stalk a β)
              left_inv := fun α => by
                apply Limits.colimit.hom_ext
                intro j
                rw [Limits.colimit.ι_desc]
                apply ModuleCat.hom_ext
                apply LinearMap.ext
                intro s
                let U_j := Opposite.unop ((D_op a).obj j)
                have hid : liftMap a (𝟙 U_j) (γ_idx a j) = γ_idx a j :=
                  Subtype.ext (by dsimp [liftMap]; rw [Fgt.map_id]; exact Category.comp_id _)
                change (germ_map a F U_j (γ_idx a j) ≫ α).hom s =
                  (Limits.colimit.ι (D_op a ⋙ F.obj) j ≫ α).hom s
                have hid_map : F.obj.map (Opposite.op (𝟙 U_j)) = 𝟙 _ :=
                  F.obj.map_id ((D_op a).obj j)
                rw [hgerm_eq a F j (𝟙 U_j) hid, hid_map, Category.id_comp]
              right_inv := fun β => by
                ext opW : 3
                apply ModuleCat.hom_ext
                apply LinearMap.ext
                intro s
                funext γ
                obtain ⟨j, w, hw_raw⟩ := hIdx_shrink a (Opposite.unop opW) γ
                have hw : liftMap a w (γ_idx a j) = γ := Subtype.ext hw_raw
                change (germ_map a F (Opposite.unop opW) γ ≫
                  Limits.colimit.desc (D_op a ⋙ F.obj) (cocone_stalk a β)).hom s =
                  (β.hom.app opW).hom s γ
                rw [hgerm_eq a F j w hw, Category.assoc, Limits.colimit.ι_desc]
                have hnat := β.hom.naturality (Opposite.op w)
                have hval := congrFun
                  (LinearMap.congr_fun (ModuleCat.hom_ext_iff.mp hnat) s) (γ_idx a j)
                change ((β.hom.app ((D_op a).obj j)).hom
                  ((F.obj.map (Opposite.op w)).hom s)) (γ_idx a j) =
                  (β.hom.app opW).hom s (liftMap a w (γ_idx a j)) at hval
                simpa [cocone_stalk, hw] using hval }
          homEquiv_naturality_left_symm := fun {F₁ F₂ N} g β => by
            apply Limits.colimit.hom_ext
            intro j
            dsimp [Stalk]
            rw [Limits.ι_colimMap_assoc, Limits.colimit.ι_desc, Limits.colimit.ι_desc]
            rfl
          homEquiv_naturality_right := fun {F N₁ N₂} α h => by
            ext opW : 3
            rfl }

    have : Limits.PreservesLimitsOfSize.{0, 0} (sheafToPresheaf J ModR) :=
      adj_sh.rightAdjoint_preservesLimits
    have : Limits.PreservesFiniteLimits (sheafToPresheaf J ModR) := ⟨fun _ _ _ => inferInstance⟩
    have hStalk_mono : ∀ a : Fin s_card, (Stalk a).PreservesMonomorphisms := by
      intro a
      have : Limits.PreservesFiniteLimits (Limits.colim : (Idx a ⥤ ModR) ⥤ ModR) :=
        ⟨fun _ _ _ => Limits.filtered_colim_preservesFiniteLimits⟩
      dsimp [Stalk]
      infer_instance

    have hInj_RM : Injective RM := by
      refine Injective.mk (fun {X_m Y_m} g f hf_mono => ?_)
      have hf_inj : Function.Injective f.hom := (ModuleCat.mono_iff_injective f).mp hf_mono
      let _ : Module (ZMod ℓ) ↑X_m := Module.compHom ↑X_m
        (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom
      let _ : Module (ZMod ℓ) ↑Y_m := Module.compHom ↑Y_m
        (ULift.ringEquiv (R := ZMod ℓ)).symm.toRingHom
      let f_Z : ↑X_m →ₗ[ZMod ℓ] ↑Y_m :=
        { toFun := f.hom
          map_add' := f.hom.map_add
          map_smul' := fun c x => f.hom.map_smul (ULift.up c) x }
      let g_Z : ↑X_m →ₗ[ZMod ℓ] ZMod ℓ :=
        { toFun := fun x => (g.hom x).down
          map_add' := fun x₁ x₂ => congrArg ULift.down (g.hom.map_add x₁ x₂)
          map_smul' := fun c x => congrArg ULift.down (g.hom.map_smul (ULift.up c) x) }
      let p_sub : Submodule (ZMod ℓ) ↑Y_m := LinearMap.range f_Z
      let e_sub : ↑X_m ≃ₗ[ZMod ℓ] ↥p_sub := LinearEquiv.ofInjective f_Z hf_inj
      obtain ⟨h_Z, hh_Z⟩ := LinearMap.exists_extend (g_Z ∘ₗ e_sub.symm.toLinearMap)
      let h_mod : Y_m ⟶ RM := ModuleCat.ofHom
        { toFun := fun y => ULift.up (h_Z y)
          map_add' := fun y₁ y₂ => congrArg ULift.up (h_Z.map_add y₁ y₂)
          map_smul' := fun r y => congrArg ULift.up (h_Z.map_smul r.down y) }
      refine ⟨h_mod, ModuleCat.hom_ext (LinearMap.ext fun x => ?_)⟩
      have hx_eq := LinearMap.congr_fun hh_Z (e_sub x)
      have hsub_x : p_sub.subtype (e_sub x) = f.hom x := rfl
      have hsymm_x : e_sub.symm (e_sub x) = x := e_sub.symm_apply_apply x
      change ULift.up (h_Z (f.hom x)) = g.hom x
      rw [← hsub_x]
      exact congrArg ULift.up (hx_eq.trans (congrArg g_Z hsymm_x))

    have hInj_Sky : ∀ a : Fin s_card, Injective ((Sky a).obj RM) := by
      intro a
      have := hStalk_mono a
      exact Adjunction.map_injective (adj_stalk a) RM hInj_RM

    have hInj_Q : Injective Q_S := by
      refine Injective.mk (fun {X_sh Y_sh} g f hf_mono => ?_)
      have : Mono f := hf_mono
      let pr_Q : ∀ a : Fin s_card, Q_S ⟶ (Sky a).obj RM := fun a =>
        { hom :=
            { app := fun _ => ModuleCat.ofHom
                { toFun := fun s γ => s a γ
                  map_add' := fun _ _ => rfl
                  map_smul' := fun _ _ => rfl }
              naturality := fun _ _ _ => rfl } }
      let β : ∀ a : Fin s_card, Y_sh ⟶ (Sky a).obj RM := fun a =>
        have : Injective ((Sky a).obj RM) := hInj_Sky a
        Injective.factorThru (g ≫ pr_Q a) f
      have hβ : ∀ a : Fin s_card, f ≫ β a = g ≫ pr_Q a := fun a => by
        have : Injective ((Sky a).obj RM) := hInj_Sky a
        exact Injective.comp_factorThru (g ≫ pr_Q a) f
      let h_Q : Y_sh ⟶ Q_S :=
        { hom :=
            { app := fun opW => ModuleCat.ofHom
                { toFun := fun y a γ => ((β a).hom.app opW).hom y γ
                  map_add' := fun y₁ y₂ => funext fun a => funext fun γ =>
                    congrFun (((β a).hom.app opW).hom.map_add y₁ y₂) γ
                  map_smul' := fun r y => funext fun a => funext fun γ =>
                    congrFun (((β a).hom.app opW).hom.map_smul r y) γ }
              naturality := fun {opW₁ opW₂} u => ModuleCat.hom_ext (LinearMap.ext fun y =>
                funext fun a => funext fun γ =>
                  congrFun (ModuleCat.hom_ext_iff.mp ((β a).hom.naturality u) |>
                    LinearMap.congr_fun <| y) γ) } }
      refine ⟨h_Q, ?_⟩
      ext opW : 3
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      funext a γ
      have ha := hβ a
      exact congrFun (LinearMap.congr_fun
        (ModuleCat.hom_ext_iff.mp (congrArg (fun m : X_sh ⟶ (Sky a).obj RM => m.hom.app opW) ha))
        x) γ

    let ρ_pre : P_const ⟶ Q_pre :=
      { app := fun _ => ModuleCat.ofHom
          { toFun := fun r _ _ => r
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        naturality := fun _ _ _ => rfl }
    let ρ_S_raw : (presheafToSheaf J ModR).obj P_const ⟶ Q_S :=
      (adj_sh.homEquiv P_const Q_S).symm ρ_pre
    let ρ_S : oneR ⟶ Q_S := ρ_S_raw
    have hρ_unit : ∀ W : S₀.Etale,
        ((adj_sh.unit.app P_const).app (Opposite.op W)) ≫ (ρ_S.hom.app (Opposite.op W)) =
          ρ_pre.app (Opposite.op W) := by
      intro W
      have hu : adj_sh.unit.app P_const ≫ (sheafToPresheaf J ModR).map ρ_S_raw = ρ_pre :=
        (Adjunction.homEquiv_unit adj_sh P_const Q_S ρ_S_raw).symm.trans
          ((adj_sh.homEquiv P_const Q_S).apply_symm_apply ρ_pre)
      exact congrArg (fun η => η.app (Opposite.op W)) hu

    let T_S₀ : S₀.Etale :=
      MorphismProperty.Over.mk ⊤ (𝟙 S₀) (inferInstance : Etale (𝟙 S₀))
    have hT_S₀ : Limits.IsTerminal T_S₀ :=
      Limits.IsTerminal.ofUniqueHom
        (fun W => MorphismProperty.Over.homMk ((Fgt.obj W).hom) (Category.comp_id _))
        (fun W m => MorphismProperty.Over.Hom.ext
          ((Category.comp_id ((Fgt.map m).left)).symm.trans ((Fgt.map m).w)))
    let adj_c := constantSheafAdj J ModR hT_S₀
    let γ_top : ∀ a : Fin s_card, L_set a T_S₀ := fun a => ⟨i_pt a, Category.comp_id _⟩
    have hγ_top_uniq : ∀ (a : Fin s_card) (γ : L_set a T_S₀), γ = γ_top a :=
      fun a γ => Subtype.ext ((Category.comp_id γ.1).symm.trans γ.2)

    let ev_Q : (oneR ⟶ Q_S) →+ (Fin s_card → ZMod ℓ) :=
      { toFun := fun φ a =>
          (((adj_c.unit.app RM ≫ φ.hom.app (Opposite.op T_S₀)).hom (ULift.up 1))
            a (γ_top a)).down
        map_zero' := rfl
        map_add' := fun φ₁ φ₂ => funext fun a => by
          have h_app : (φ₁ + φ₂).hom.app (Opposite.op T_S₀) =
              φ₁.hom.app (Opposite.op T_S₀) + φ₂.hom.app (Opposite.op T_S₀) := rfl
          rw [h_app, Preadditive.comp_add]
          rfl }

    have hev_bij : Function.Bijective ev_Q := by
      let inv_ev : (Fin s_card → ZMod ℓ) → (oneR ⟶ Q_S) := fun v =>
        (adj_c.homEquiv RM Q_S).symm (ModuleCat.ofHom
          { toFun := fun r a _ => r * ULift.up (v a)
            map_add' := fun r₁ r₂ => funext fun a => funext fun _ => add_mul r₁ r₂ _
            map_smul' := fun r₁ r₂ => funext fun a => funext fun _ => mul_assoc r₁ r₂ _ })
      refine ⟨?_, ?_⟩
      · intro φ₁ φ₂ h_eq
        apply (adj_c.homEquiv RM Q_S).injective
        apply ModuleCat.hom_ext; apply LinearMap.ext; intro r
        funext a γ
        rw [hγ_top_uniq a γ]
        have hr : r = r • ULift.up (1 : ZMod ℓ) := ULift.ext _ _ (mul_one r.down).symm
        rw [hr, map_smul, map_smul]
        have h1 : ((adj_c.homEquiv RM Q_S φ₁).hom (ULift.up 1)) a (γ_top a) =
            ((adj_c.homEquiv RM Q_S φ₂).hom (ULift.up 1)) a (γ_top a) :=
          ULift.ext _ _ (congrFun h_eq a)
        exact congrArg (r • ·) h1
      · intro v
        refine ⟨inv_ev v, funext fun a => ?_⟩
        change (((adj_c.homEquiv RM Q_S (inv_ev v)).hom (ULift.up 1)) a (γ_top a)).down = v a
        rw [(adj_c.homEquiv RM Q_S).apply_symm_apply]
        exact one_mul (v a)

    have hev_diag : ∀ c : ZMod ℓ, ev_Q ((c.val • 𝟙 oneR) ≫ ρ_S) = fun _ => c := by
      have hunit_eq : adj_c.unit.app RM =
          (adj_sh.unit.app P_const).app (Opposite.op T_S₀) := by
        dsimp only [adj_c, adj_sh, P_const]
        simp only [constantSheafAdj]
        rfl
      have htop_comp : adj_c.unit.app RM ≫ ρ_S.hom.app (Opposite.op T_S₀) =
          ρ_pre.app (Opposite.op T_S₀) :=
        (congrArg (· ≫ ρ_S.hom.app (Opposite.op T_S₀)) hunit_eq).trans (hρ_unit T_S₀)
      have hev_one : ev_Q ρ_S = fun _ => (1 : ZMod ℓ) := by
        funext a
        change (((adj_c.unit.app RM ≫ ρ_S.hom.app (Opposite.op T_S₀)).hom (ULift.up 1))
          a (γ_top a)).down = 1
        rw [htop_comp]; rfl
      intro c
      rw [Preadditive.nsmul_comp, Category.id_comp, map_nsmul, hev_one]
      funext _
      simp [nsmul_eq_mul]

    have hVan_U : ∀ W : S₀.Etale,
        Set.range ((Fgt.obj W).hom).base ⊆ (U_X : Set ↥S₀) →
        Subsingleton ↑(Q_S.obj.obj (Opposite.op W)) := by
      intro W hW_sub
      refine ⟨fun ξ₁ ξ₂ => funext fun a => funext fun γ => False.elim ?_⟩
      have hPa_UX : P_pt a ∈ U_X := by
        apply hW_sub
        exact ⟨γ.1.base pt_k, by rw [← Scheme.Hom.comp_apply, γ.2, hi_pt_base a pt_k]⟩
      exact (hP_compl (P_pt a)).mpr ⟨a, rfl⟩ hPa_UX

    have hLocChart_Q : ∀ (W : S₀.Etale) (y : ↥((Fgt.obj W).left)),
        ∃ (U₀ : S₀.Etale) (u₀ : U₀ ⟶ W) (y₀ : ↥((Fgt.obj U₀).left))
          (val_y : ↑(Q_S.obj.obj (Opposite.op W)) → R),
          ((Fgt.map u₀).left).base y₀ = y ∧
          (∀ ξ : ↑(Q_S.obj.obj (Opposite.op W)),
            (Q_S.obj.map (Opposite.op u₀)).hom ξ =
              (ρ_S.hom.app (Opposite.op U₀)).hom
                (((adj_sh.unit.app P_const).app (Opposite.op U₀)).hom (val_y ξ))) ∧
          (((Fgt.obj W).hom).base y ∉ U_X →
            ∀ r : R,
              (ρ_S.hom.app (Opposite.op U₀)).hom
                (((adj_sh.unit.app P_const).app (Opposite.op U₀)).hom r) = 0 →
              r = 0) := by
      intro W y
      by_cases hy_U : ((Fgt.obj W).hom).base y ∈ U_X
      · let V_U : ((Fgt.obj W).left).Opens :=
          (TopologicalSpace.Opens.map ((Fgt.obj W).hom).base).obj U_X
        have : Etale ((Fgt.obj W).hom) := W.prop
        let U₀ : S₀.Etale :=
          MorphismProperty.Over.mk ⊤ (V_U.ι ≫ (Fgt.obj W).hom) inferInstance
        let u₀ : U₀ ⟶ W := MorphismProperty.Over.homMk V_U.ι rfl
        have hsub : Set.range ((Fgt.obj U₀).hom).base ⊆ (U_X : Set ↥S₀) := by
          rintro _ ⟨z, rfl⟩; exact z.2
        have := hVan_U U₀ hsub
        exact ⟨U₀, u₀, ⟨y, hy_U⟩, fun _ => 0, rfl,
          fun _ => Subsingleton.elim _ _, fun hnot => False.elim (hnot hy_U)⟩
      · obtain ⟨a, ha⟩ := (hP_compl _).mp hy_U
        obtain ⟨U₀, u₀, y₀, γ₀, hy₀, hγ_uniq, h_empty⟩ := hIso_shrink_raw a W y ha.symm
        refine ⟨U₀, u₀, y₀, fun ξ => ξ a (liftMap a u₀ γ₀), hy₀, ?_, ?_⟩
        · intro ξ
          have hρ_eq := LinearMap.congr_fun
            (ModuleCat.hom_ext_iff.mp (hρ_unit U₀)) (ξ a (liftMap a u₀ γ₀))
          change (Q_S.obj.map (Opposite.op u₀)).hom ξ =
            (((adj_sh.unit.app P_const).app (Opposite.op U₀)) ≫
              ρ_S.hom.app (Opposite.op U₀)).hom (ξ a (liftMap a u₀ γ₀))
          rw [hρ_eq]
          funext b γ_b
          by_cases hba : b = a
          · subst hba
            rw [hγ_uniq γ_b]; rfl
          · exact IsEmpty.elim (h_empty b hba) γ_b
        · intro _ r hr0
          have hρ_eq := LinearMap.congr_fun (ModuleCat.hom_ext_iff.mp (hρ_unit U₀)) r
          have hr_pre : (ρ_pre.app (Opposite.op U₀)).hom r = 0 := hρ_eq.symm.trans hr0
          exact congrArg (fun f : ∀ b : Fin s_card, L_set b U₀ → R => f a γ₀) hr_pre

    exact ⟨Q_S, ρ_S, ev_Q, hInj_Q, hev_bij, hev_diag, hVan_U, hLocChart_Q⟩

  
  
  
  let L_U : 𝒞 := weilCupPDLocalFreeSheaf S₀ ℓ U_et
  let ε : L_U ⟶ oneR := weilCupPDLocalCounit S₀ ℓ U_et

  have h0 : ε ≫ ρ_S = 0 := by
    have : Subsingleton ↑(Q_S.obj.obj (Opposite.op U_et)) :=
      hVan_U U_et (le_of_eq hRange_Uet)
    apply Sheaf.freeYonedaHomEquiv.injective
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro _
    exact Subsingleton.elim _ _

  
  let c_pre : Presheaf.freeYoneda U_et RM ⟶ P_const :=
    Presheaf.freeYonedaHomEquiv.symm (𝟙 RM)
  have hSub_hom_Uet : ∀ W : S₀.Etale, Subsingleton (W ⟶ U_et) := by
    intro W
    have : IsOpenImmersion ((Fgt.obj U_et).hom) := hOpen_Uet
    have : Mono ((Fgt.obj U_et).hom) := inferInstance
    refine ⟨fun g₁ g₂ => MorphismProperty.Over.Hom.ext ?_⟩
    exact (cancel_mono ((Fgt.obj U_et).hom)).mp (((Fgt.map g₁).w).trans ((Fgt.map g₂).w).symm)

  have hMono_c_app : ∀ opW : Opposite S₀.Etale, Mono (c_pre.app opW) := by
    intro opW
    let W := Opposite.unop opW
    have := hSub_hom_Uet W
    by_cases hne : Nonempty (W ⟶ U_et)
    · obtain ⟨g₀⟩ := hne
      let ι₀ : RM ⟶ (Presheaf.freeYoneda U_et RM).obj (Opposite.op W) :=
        Limits.Sigma.ι (fun _ : W ⟶ U_et => RM) g₀
      have hsplit : c_pre.app (Opposite.op W) ≫ ι₀ = 𝟙 _ := by
        dsimp only [Presheaf.freeYoneda] at ι₀ ⊢
        apply Limits.Sigma.hom_ext
        intro g
        have hg : g = g₀ := Subsingleton.elim g g₀
        subst hg
        have hcomp : ι₀ ≫ c_pre.app (Opposite.op W) = 𝟙 RM := by
          dsimp [ι₀, c_pre, Presheaf.freeYonedaHomEquiv, P_const]
          simp
        exact (Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ ι₀) hcomp).trans
            ((Category.id_comp ι₀).trans (Category.comp_id ι₀).symm))
      exact ⟨fun z₁ z₂ hz => by
        calc
          z₁ = z₁ ≫ (c_pre.app (Opposite.op W) ≫ ι₀) := by rw [hsplit, Category.comp_id]
          _ = (z₁ ≫ c_pre.app (Opposite.op W)) ≫ ι₀ := (Category.assoc _ _ _).symm
          _ = (z₂ ≫ c_pre.app (Opposite.op W)) ≫ ι₀ := by rw [hz]
          _ = z₂ := by rw [Category.assoc, hsplit, Category.comp_id]⟩
    · have : IsEmpty (W ⟶ U_et) := not_nonempty_iff.mp hne
      have h0_id : 𝟙 ((Presheaf.freeYoneda U_et RM).obj opW) = 0 := by
        dsimp only [Presheaf.freeYoneda]
        exact Limits.Sigma.hom_ext _ _ (fun g => IsEmpty.elim inferInstance g)
      exact ⟨fun z₁ z₂ _ => by
        calc
          z₁ = z₁ ≫ 𝟙 _ := (Category.comp_id z₁).symm
          _ = 0 := by rw [h0_id, Limits.comp_zero]
          _ = z₂ ≫ 𝟙 _ := by rw [h0_id, Limits.comp_zero]
          _ = z₂ := Category.comp_id z₂⟩

  have hMono_c_pre : Mono c_pre :=
    ⟨fun g₁ g₂ h => NatTrans.ext (funext fun opW =>
      (@cancel_mono _ _ _ _ _ (c_pre.app opW) (hMono_c_app opW) _ _).mp
        (congrArg (fun η => η.app opW) h))⟩

  let ε_map : L_U ⟶ oneR := (presheafToSheaf J ModR).map c_pre
  have hc_pre_map : ε_map = ε := by
    apply Sheaf.freeYonedaHomEquiv.injective
    have hR : Sheaf.freeYonedaHomEquiv ε =
        ((adj_sh.unit.app P_const).app (Opposite.op U_et)) :=
      Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have h1 : (adj_sh.homEquiv (Presheaf.freeYoneda U_et RM)
        ((presheafToSheaf J ModR).obj P_const)) ((presheafToSheaf J ModR).map c_pre) =
        c_pre ≫ adj_sh.unit.app P_const :=
      (Adjunction.homEquiv_unit adj_sh _ _ ((presheafToSheaf J ModR).map c_pre)).trans
        (adj_sh.unit.naturality c_pre).symm
    have hL : Sheaf.freeYonedaHomEquiv ε_map =
        (adj_sh.unit.app P_const).app (Opposite.op U_et) :=
      (congrArg Presheaf.freeYonedaHomEquiv h1).trans
        ((Presheaf.freeYonedaHomEquiv_comp c_pre (adj_sh.unit.app P_const)).trans
          ((congrArg (· ≫ (adj_sh.unit.app P_const).app (Opposite.op U_et))
            (Presheaf.freeYonedaHomEquiv.apply_symm_apply (𝟙 RM))).trans
            (Category.id_comp _)))
    exact hL.trans hR.symm

  have : Mono ε := by
    rw [← hc_pre_map]
    exact Functor.map_mono (presheafToSheaf J ModR) c_pre

  
  have hSep : ∀ (D : 𝒞) (W : S₀.Etale) (s : ↑(D.obj.obj (Opposite.op W))),
      (∀ y : ↥((Fgt.obj W).left),
        ∃ (U₀ : S₀.Etale) (u₀ : U₀ ⟶ W) (y₀ : ↥((Fgt.obj U₀).left)),
          ((Fgt.map u₀).left).base y₀ = y ∧ (D.obj.map (Opposite.op u₀)).hom s = 0) →
      s = 0 := by
    intro D W s hloc
    let R_s : Sieve W :=
      { arrows := fun {V} h => (D.obj.map (Opposite.op h)).hom s = 0
        downward_closed := fun {V₁ V₂} {h} hh g => by
          have hmc := LinearMap.congr_fun
            (ModuleCat.hom_ext_iff.mp (D.obj.map_comp (Opposite.op h) (Opposite.op g))) s
          exact hmc.trans (by
            change (D.obj.map (Opposite.op g)).hom ((D.obj.map (Opposite.op h)).hom s) = 0
            rw [hh, map_zero]) }
    have hRs_J : R_s ∈ J W := by
      rw [hMemJ_iff]
      intro y
      obtain ⟨U₀, u₀, y₀, hy₀, hs₀⟩ := hloc y
      exact ⟨U₀, u₀, y₀, hs₀, hEtale_map u₀, hy₀⟩
    let x₁ : RM ⟶ D.obj.obj (Opposite.op W) :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton R _ s)
    have hx_eq : x₁ = (0 : RM ⟶ D.obj.obj (Opposite.op W)) := by
      apply (D.property RM R_s hRs_J).isSeparatedFor.ext
      intro V h hh
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro r
      have h0_comp : (0 : RM ⟶ D.obj.obj (Opposite.op W)) ≫ D.obj.map (Opposite.op h) = 0 :=
        Limits.zero_comp
      change (x₁ ≫ D.obj.map (Opposite.op h)).hom r =
        ((0 : RM ⟶ D.obj.obj (Opposite.op W)) ≫ D.obj.map (Opposite.op h)).hom r
      rw [h0_comp]
      change (D.obj.map (Opposite.op h)).hom (r • s) = 0
      rw [map_smul, hh, smul_zero]
    have h1 := congrArg (fun m : RM ⟶ D.obj.obj (Opposite.op W) => m.hom (ULift.up 1)) hx_eq
    have h1' : (1 : R) • s = 0 := h1
    rwa [one_smul] at h1'

  let η_const : ∀ W : S₀.Etale, RM ⟶ oneR.obj.obj (Opposite.op W) :=
    fun W => (adj_sh.unit.app P_const).app (Opposite.op W)
  have hnat_η_const : ∀ {W₁ W₂ : S₀.Etale} (g : W₁ ⟶ W₂),
      η_const W₂ ≫ oneR.obj.map (Opposite.op g) = η_const W₁ := by
    intro W₁ W₂ g
    exact ((Category.id_comp ((adj_sh.unit.app P_const).app (Opposite.op W₁))).symm.trans
      ((adj_sh.unit.app P_const).naturality (Opposite.op g))).symm
  let ρ_const : ∀ W : S₀.Etale, RM ⟶ Q_S.obj.obj (Opposite.op W) :=
    fun W => η_const W ≫ ρ_S.hom.app (Opposite.op W)
  have hpull_ρ_const : ∀ {W₁ W₂ : S₀.Etale} (g : W₁ ⟶ W₂) (r : R),
      (Q_S.obj.map (Opposite.op g)).hom ((ρ_const W₂).hom r) = (ρ_const W₁).hom r := by
    intro W₁ W₂ g r
    have hn1 := LinearMap.congr_fun
      (ModuleCat.hom_ext_iff.mp (ρ_S.hom.naturality (Opposite.op g)).symm)
      ((η_const W₂).hom r)
    have hn2 := congrArg (ρ_S.hom.app (Opposite.op W₁)).hom
      (LinearMap.congr_fun (ModuleCat.hom_ext_iff.mp (hnat_η_const g)) r)
    exact hn1.trans hn2

  have : Epi ρ_S := by
    refine ⟨fun {D} z₁ z₂ hz => ?_⟩
    ext opW : 3
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro ξ
    have hdiff : (z₁.hom.app opW).hom ξ - (z₂.hom.app opW).hom ξ = 0 := by
      apply hSep D (Opposite.unop opW)
      intro y
      obtain ⟨U₀, u₀, y₀, val_y, hy₀, hξ_loc, -⟩ := hLocChart_Q (Opposite.unop opW) y
      have hpull :
          (D.obj.map (Opposite.op u₀)).hom ((z₁.hom.app opW).hom ξ - (z₂.hom.app opW).hom ξ) =
          (Q_S.obj.map (Opposite.op u₀) ≫ z₁.hom.app (Opposite.op U₀)).hom ξ -
          (Q_S.obj.map (Opposite.op u₀) ≫ z₂.hom.app (Opposite.op U₀)).hom ξ := by
        rw [map_sub]
        exact congrArg₂ (· - ·)
          (LinearMap.congr_fun
            (ModuleCat.hom_ext_iff.mp (z₁.hom.naturality (Opposite.op u₀)).symm) ξ)
          (LinearMap.congr_fun
            (ModuleCat.hom_ext_iff.mp (z₂.hom.naturality (Opposite.op u₀)).symm) ξ)
      refine ⟨U₀, u₀, y₀, hy₀, ?_⟩
      rw [hpull]
      change (z₁.hom.app (Opposite.op U₀)).hom ((Q_S.obj.map (Opposite.op u₀)).hom ξ) -
        (z₂.hom.app (Opposite.op U₀)).hom ((Q_S.obj.map (Opposite.op u₀)).hom ξ) = 0
      rw [hξ_loc ξ]
      have hz_app := congrArg (fun m : oneR ⟶ D =>
        (m.hom.app (Opposite.op U₀)).hom ((η_const U₀).hom (val_y ξ))) hz
      exact sub_eq_zero.mpr hz_app
    exact sub_eq_zero.mp hdiff

  
  have hDesc : ∀ (D : 𝒞) (u : oneR ⟶ D), ε ≫ u = 0 → ∃ w : Q_S ⟶ D, ρ_S ≫ w = u := by
    intro D u hu
    have hpull_u_η : ∀ {W₁ W₂ : S₀.Etale} (g : W₁ ⟶ W₂) (r : R),
        (D.obj.map (Opposite.op g)).hom
          ((u.hom.app (Opposite.op W₂)).hom ((η_const W₂).hom r)) =
        (u.hom.app (Opposite.op W₁)).hom ((η_const W₁).hom r) := by
      intro W₁ W₂ g r
      have hn1 := LinearMap.congr_fun
        (ModuleCat.hom_ext_iff.mp (u.hom.naturality (Opposite.op g)).symm)
        ((η_const W₂).hom r)
      have hn2 := congrArg (u.hom.app (Opposite.op W₁)).hom
        (LinearMap.congr_fun (ModuleCat.hom_ext_iff.mp (hnat_η_const g)) r)
      exact hn1.trans hn2
    have hu_Uet : ∀ r : R, (u.hom.app (Opposite.op U_et)).hom ((η_const U_et).hom r) = 0 := by
      intro r
      have heq_fY : Sheaf.freeYonedaHomEquiv (ε ≫ u) =
          Sheaf.freeYonedaHomEquiv (0 : L_U ⟶ D) := congrArg Sheaf.freeYonedaHomEquiv hu
      have hL : Sheaf.freeYonedaHomEquiv (ε ≫ u) =
          η_const U_et ≫ u.hom.app (Opposite.op U_et) := by
        have h1 : (adj_sh.homEquiv (Presheaf.freeYoneda U_et RM) D) (ε ≫ u) =
            (adj_sh.homEquiv (Presheaf.freeYoneda U_et RM) oneR) ε ≫ u.hom :=
          Adjunction.homEquiv_naturality_right adj_sh ε u
        have hε_eq : Presheaf.freeYonedaHomEquiv
            ((adj_sh.homEquiv (Presheaf.freeYoneda U_et RM) oneR) ε) = η_const U_et :=
          Sheaf.freeYonedaHomEquiv.apply_symm_apply (η_const U_et)
        exact (congrArg Presheaf.freeYonedaHomEquiv h1).trans
          ((Presheaf.freeYonedaHomEquiv_comp _ u.hom).trans
            (congrArg (· ≫ u.hom.app (Opposite.op U_et)) hε_eq))
      have hR : Sheaf.freeYonedaHomEquiv (0 : L_U ⟶ D) = 0 := by
        let zero_LD : (presheafToSheaf J ModR).obj (Presheaf.freeYoneda U_et RM) ⟶ D :=
          (0 : L_U ⟶ D)
        have h0_hom : (sheafToPresheaf J ModR).map zero_LD = 0 := rfl
        have h1 : (adj_sh.homEquiv (Presheaf.freeYoneda U_et RM) D) zero_LD = 0 :=
          (Adjunction.homEquiv_unit adj_sh _ D zero_LD).trans
            ((congrArg (_ ≫ ·) h0_hom).trans Limits.comp_zero)
        exact (congrArg Presheaf.freeYonedaHomEquiv h1).trans
          (ModuleCat.hom_ext (LinearMap.ext fun _ => rfl))
      rw [hL, hR] at heq_fY
      exact congrArg (fun m : RM ⟶ D.obj.obj (Opposite.op U_et) => m.hom r) heq_fY
    have hu_sub_U : ∀ (V₁ : S₀.Etale),
        Set.range ((Fgt.obj V₁).hom).base ⊆ (U_X : Set ↥S₀) →
        ∀ r : R, (u.hom.app (Opposite.op V₁)).hom ((η_const V₁).hom r) = 0 := by
      intro V₁ hsub r
      have : IsOpenImmersion ((Fgt.obj U_et).hom) := hOpen_Uet
      have hsub' : Set.range ((Fgt.obj V₁).hom).base ⊆ Set.range ((Fgt.obj U_et).hom).base :=
        hRange_Uet.symm ▸ hsub
      let g_sch := IsOpenImmersion.lift ((Fgt.obj U_et).hom) ((Fgt.obj V₁).hom) hsub'
      let g₁ : V₁ ⟶ U_et := MorphismProperty.Over.homMk g_sch
        (IsOpenImmersion.lift_fac ((Fgt.obj U_et).hom) ((Fgt.obj V₁).hom) hsub')
      rw [← hpull_u_η g₁ r, hu_Uet r, map_zero]
    have hu_wellDef : ∀ (V : S₀.Etale) (r₁ r₂ : R),
        (ρ_const V).hom r₁ = (ρ_const V).hom r₂ →
        (u.hom.app (Opposite.op V)).hom ((η_const V).hom r₁) =
          (u.hom.app (Opposite.op V)).hom ((η_const V).hom r₂) := by
      intro V r₁ r₂ hr_eq
      suffices h0_r : ∀ r : R, (ρ_const V).hom r = 0 →
          (u.hom.app (Opposite.op V)).hom ((η_const V).hom r) = 0 by
        have hsub0 : (ρ_const V).hom (r₁ - r₂) = 0 := by
          rw [map_sub, hr_eq, sub_self]
        have hu0 := h0_r (r₁ - r₂) hsub0
        rwa [map_sub, map_sub, sub_eq_zero] at hu0
      intro r hr0
      apply hSep D V
      intro z
      by_cases hz_U : ((Fgt.obj V).hom).base z ∈ U_X
      · let O_z : ((Fgt.obj V).left).Opens :=
          (TopologicalSpace.Opens.map ((Fgt.obj V).hom).base).obj U_X
        have : Etale ((Fgt.obj V).hom) := V.prop
        let V₁ : S₀.Etale :=
          MorphismProperty.Over.mk ⊤ (O_z.ι ≫ (Fgt.obj V).hom) inferInstance
        let v₁ : V₁ ⟶ V := MorphismProperty.Over.homMk O_z.ι rfl
        have hsub : Set.range ((Fgt.obj V₁).hom).base ⊆ (U_X : Set ↥S₀) := by
          rintro _ ⟨pt_z, rfl⟩; exact pt_z.2
        exact ⟨V₁, v₁, ⟨z, hz_U⟩, rfl, (hpull_u_η v₁ r).trans (hu_sub_U V₁ hsub r)⟩
      · obtain ⟨U₀, u₀, y₀, _, hy₀, _, hinj_r⟩ := hLocChart_Q V z
        refine ⟨U₀, u₀, y₀, hy₀, ?_⟩
        have hr_U₀ : (ρ_const U₀).hom r = 0 := by
          rw [← hpull_ρ_const u₀ r, hr0, map_zero]
        have hr_zero : r = 0 := hinj_r hz_U r hr_U₀
        rw [hr_zero, map_zero, map_zero, map_zero]
    let R_sieve_of : ∀ (W : S₀.Etale), ↑(Q_S.obj.obj (Opposite.op W)) → Sieve W :=
      fun W ξ =>
        { arrows := fun {V} h =>
            ∃ r : R, (Q_S.obj.map (Opposite.op h)).hom ξ = (ρ_const V).hom r
          downward_closed := fun {V₁ V₂} {h} ⟨r, hr⟩ g =>
            ⟨r, by
              have hmc := LinearMap.congr_fun
                (ModuleCat.hom_ext_iff.mp (Q_S.obj.map_comp (Opposite.op h) (Opposite.op g))) ξ
              exact hmc.trans ((congrArg (Q_S.obj.map (Opposite.op g)).hom hr).trans
                (hpull_ρ_const g r))⟩ }
    have hR_mem : ∀ (W : S₀.Etale) (ξ : ↑(Q_S.obj.obj (Opposite.op W))),
        R_sieve_of W ξ ∈ J W := by
      intro W ξ
      rw [hMemJ_iff]
      intro y
      obtain ⟨U₀, u₀, y₀, val_y, hy₀, hξ_loc, -⟩ := hLocChart_Q W y
      exact ⟨U₀, u₀, y₀, ⟨val_y ξ, hξ_loc ξ⟩, hEtale_map u₀, hy₀⟩
    let fam_of : ∀ (W : S₀.Etale) (ξ : ↑(Q_S.obj.obj (Opposite.op W))),
        Presieve.FamilyOfElements (D.obj ⋙ coyoneda.obj (Opposite.op RM))
          (R_sieve_of W ξ).arrows :=
      fun W ξ {V} h hh =>
        ModuleCat.ofHom (LinearMap.toSpanSingleton R _
          ((u.hom.app (Opposite.op V)).hom ((η_const V).hom (Classical.choose hh))))
    have hcompat_of : ∀ (W : S₀.Etale) (ξ : ↑(Q_S.obj.obj (Opposite.op W))),
        Presieve.FamilyOfElements.Compatible (fam_of W ξ) := by
      intro W ξ V₁ V₂ V₀ g₁ g₂ h₁ h₂ hh₁ hh₂ hcomm
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro r_in
      let r₁ := Classical.choose hh₁
      let r₂ := Classical.choose hh₂
      have hr₁ : (Q_S.obj.map (Opposite.op h₁)).hom ξ = (ρ_const V₁).hom r₁ :=
        Classical.choose_spec hh₁
      have hr₂ : (Q_S.obj.map (Opposite.op h₂)).hom ξ = (ρ_const V₂).hom r₂ :=
        Classical.choose_spec hh₂
      have hr₁₂ : (ρ_const V₀).hom r₁ = (ρ_const V₀).hom r₂ := by
        have hq₁ : (Q_S.obj.map (Opposite.op (g₁ ≫ h₁))).hom ξ = (ρ_const V₀).hom r₁ := by
          have hmc := LinearMap.congr_fun
            (ModuleCat.hom_ext_iff.mp (Q_S.obj.map_comp (Opposite.op h₁) (Opposite.op g₁))) ξ
          exact hmc.trans ((congrArg (Q_S.obj.map (Opposite.op g₁)).hom hr₁).trans
            (hpull_ρ_const g₁ r₁))
        have hq₂ : (Q_S.obj.map (Opposite.op (g₂ ≫ h₂))).hom ξ = (ρ_const V₀).hom r₂ := by
          have hmc := LinearMap.congr_fun
            (ModuleCat.hom_ext_iff.mp (Q_S.obj.map_comp (Opposite.op h₂) (Opposite.op g₂))) ξ
          exact hmc.trans ((congrArg (Q_S.obj.map (Opposite.op g₂)).hom hr₂).trans
            (hpull_ρ_const g₂ r₂))
        rw [← hq₁, ← hq₂, hcomm]
      change (D.obj.map (Opposite.op g₁)).hom
          (r_in • (u.hom.app (Opposite.op V₁)).hom ((η_const V₁).hom r₁)) =
        (D.obj.map (Opposite.op g₂)).hom
          (r_in • (u.hom.app (Opposite.op V₂)).hom ((η_const V₂).hom r₂))
      rw [map_smul, map_smul, hpull_u_η g₁ r₁, hpull_u_η g₂ r₂, hu_wellDef V₀ r₁ r₂ hr₁₂]
    let w_val : ∀ (W : S₀.Etale), ↑(Q_S.obj.obj (Opposite.op W)) → ↑(D.obj.obj (Opposite.op W)) :=
      fun W ξ =>
        ((D.property RM (R_sieve_of W ξ) (hR_mem W ξ)).amalgamate
          (fam_of W ξ) (hcompat_of W ξ)).hom (ULift.up 1)
    have hw_spec : ∀ (W V : S₀.Etale) (h : V ⟶ W) (ξ : ↑(Q_S.obj.obj (Opposite.op W))) (r : R),
        (Q_S.obj.map (Opposite.op h)).hom ξ = (ρ_const V).hom r →
        (D.obj.map (Opposite.op h)).hom (w_val W ξ) =
          (u.hom.app (Opposite.op V)).hom ((η_const V).hom r) := by
      intro W V h ξ r hr
      have hh : (R_sieve_of W ξ).arrows h := ⟨r, hr⟩
      have hamalg := (D.property RM (R_sieve_of W ξ) (hR_mem W ξ)).valid_glue
        (hcompat_of W ξ) h hh
      have h1 := congrArg (fun m : RM ⟶ D.obj.obj (Opposite.op V) => m.hom (ULift.up 1)) hamalg
      have h1' : (D.obj.map (Opposite.op h)).hom (w_val W ξ) =
          (1 : R) • (u.hom.app (Opposite.op V)).hom ((η_const V).hom (Classical.choose hh)) := h1
      rw [one_smul] at h1'
      rw [h1']
      exact hu_wellDef V (Classical.choose hh) r ((Classical.choose_spec hh).symm.trans hr)
    let w_mor : Q_S ⟶ D :=
      { hom :=
          { app := fun opW => ModuleCat.ofHom
              { toFun := w_val (Opposite.unop opW)
                map_add' := fun ξ₁ ξ₂ => by
                  let W := Opposite.unop opW
                  suffices hd : w_val W (ξ₁ + ξ₂) - (w_val W ξ₁ + w_val W ξ₂) = 0 from
                    sub_eq_zero.mp hd
                  apply hSep D W
                  intro y
                  obtain ⟨U₀, u₀, y₀, val_y, hy₀, hξ_loc, -⟩ := hLocChart_Q W y
                  refine ⟨U₀, u₀, y₀, hy₀, ?_⟩
                  rw [map_sub, map_add]
                  have h_sum : (Q_S.obj.map (Opposite.op u₀)).hom (ξ₁ + ξ₂) =
                      (ρ_const U₀).hom (val_y ξ₁ + val_y ξ₂) := by
                    rw [map_add, hξ_loc ξ₁, hξ_loc ξ₂]
                    exact (ρ_const U₀).hom.map_add (val_y ξ₁) (val_y ξ₂) |>.symm
                  rw [hw_spec W U₀ u₀ (ξ₁ + ξ₂) _ h_sum,
                    hw_spec W U₀ u₀ ξ₁ _ (hξ_loc ξ₁),
                    hw_spec W U₀ u₀ ξ₂ _ (hξ_loc ξ₂), map_add, map_add, sub_self]
                map_smul' := fun r ξ => by
                  let W := Opposite.unop opW
                  suffices hd : w_val W (r • ξ) - r • w_val W ξ = 0 from sub_eq_zero.mp hd
                  apply hSep D W
                  intro y
                  obtain ⟨U₀, u₀, y₀, val_y, hy₀, hξ_loc, -⟩ := hLocChart_Q W y
                  refine ⟨U₀, u₀, y₀, hy₀, ?_⟩
                  rw [map_sub, map_smul]
                  have h_smul : (Q_S.obj.map (Opposite.op u₀)).hom (r • ξ) =
                      (ρ_const U₀).hom (r • val_y ξ) := by
                    rw [map_smul, hξ_loc ξ]
                    exact ((ρ_const U₀).hom.map_smul r (val_y ξ)).symm
                  rw [hw_spec W U₀ u₀ (r • ξ) _ h_smul,
                    hw_spec W U₀ u₀ ξ _ (hξ_loc ξ), map_smul, map_smul, sub_self] }
            naturality := fun {opW₁ opW₂} f => by
              let W₁ := Opposite.unop opW₁
              let W₂ := Opposite.unop opW₂
              apply ModuleCat.hom_ext
              apply LinearMap.ext
              intro ξ
              suffices hd : w_val W₂ ((Q_S.obj.map f).hom ξ) -
                  (D.obj.map f).hom (w_val W₁ ξ) = 0 from sub_eq_zero.mp hd
              apply hSep D W₂
              intro y
              obtain ⟨U₀, u₀, y₀, val_y, hy₀, hξ_loc, -⟩ := hLocChart_Q W₂ y
              refine ⟨U₀, u₀, y₀, hy₀, ?_⟩
              rw [map_sub]
              have hcomp_D : (D.obj.map (Opposite.op u₀)).hom ((D.obj.map f).hom (w_val W₁ ξ)) =
                  (D.obj.map (Opposite.op (u₀ ≫ f.unop))).hom (w_val W₁ ξ) :=
                (LinearMap.congr_fun
                  (ModuleCat.hom_ext_iff.mp (D.obj.map_comp f (Opposite.op u₀))) (w_val W₁ ξ)).symm
              have hcomp_Q : (Q_S.obj.map (Opposite.op u₀)).hom ((Q_S.obj.map f).hom ξ) =
                  (Q_S.obj.map (Opposite.op (u₀ ≫ f.unop))).hom ξ :=
                (LinearMap.congr_fun
                  (ModuleCat.hom_ext_iff.mp (Q_S.obj.map_comp f (Opposite.op u₀))) ξ).symm
              have h1 := hξ_loc ((Q_S.obj.map f).hom ξ)
              have h2 : (Q_S.obj.map (Opposite.op (u₀ ≫ f.unop))).hom ξ =
                  (ρ_const U₀).hom (val_y ((Q_S.obj.map f).hom ξ)) := hcomp_Q ▸ h1
              rw [hcomp_D, hw_spec W₂ U₀ u₀ _ _ h1, hw_spec W₁ U₀ (u₀ ≫ f.unop) ξ _ h2, sub_self] } }
    refine ⟨w_mor, ?_⟩
    ext opW : 3
    let W := Opposite.unop opW
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro σ
    suffices hd : w_val W ((ρ_S.hom.app (Opposite.op W)).hom σ) -
        (u.hom.app (Opposite.op W)).hom σ = 0 from sub_eq_zero.mp hd
    apply hSep D W
    intro y
    obtain ⟨U₀, u₀, y₀, c, hy₀, hσ_loc⟩ := hLocConst W σ y
    refine ⟨U₀, u₀, y₀, hy₀, ?_⟩
    rw [map_sub]
    have hρ_σ : (Q_S.obj.map (Opposite.op u₀)).hom ((ρ_S.hom.app (Opposite.op W)).hom σ) =
        (ρ_const U₀).hom (ULift.up c) := by
      have hnat := ρ_S.hom.naturality (Opposite.op u₀)
      exact (LinearMap.congr_fun (ModuleCat.hom_ext_iff.mp hnat.symm) σ).trans
        (congrArg (ρ_S.hom.app (Opposite.op U₀)).hom hσ_loc)
    have hu_σ : (D.obj.map (Opposite.op u₀)).hom ((u.hom.app (Opposite.op W)).hom σ) =
        (u.hom.app (Opposite.op U₀)).hom ((η_const U₀).hom (ULift.up c)) := by
      have hnat := u.hom.naturality (Opposite.op u₀)
      exact (LinearMap.congr_fun (ModuleCat.hom_ext_iff.mp hnat.symm) σ).trans
        (congrArg (u.hom.app (Opposite.op U₀)).hom hσ_loc)
    rw [hw_spec W U₀ u₀ _ (ULift.up c) hρ_σ, hu_σ, sub_self]

  have hSE : (ShortComplex.mk ε ρ_S h0).ShortExact :=
    hShortExactOfCokernel ε ρ_S h0 hDesc
  have : Injective Q_S := hInj_Q
  exact hExtCard (Nat.card ↥((U_X : Set ↥S₀)ᶜ)) hs_pos oneR L_U Q_S ε ρ_S h0 hSE
    hEnd_one ev_Q hev_bij hev_diag hFin1

theorem weil_affine_curve_open_divisor_unit_picard_presentation (k : Type u) [Field k] [IsAlgClosed k]
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C_bar.left]
    [AlgebraicGeometry.IsProper C_bar.hom]
    (hDimC : topologicalKrullDim C_bar.left = (1 : WithBot ℕ∞))
    (hDimOpen : ∀ U : C_bar.left.Opens, Nonempty ↥U.toScheme →
      topologicalKrullDim U.toScheme = (1 : WithBot ℕ∞))
    (hChart : WeilCurveDivisorAndAffineChartHolds k C_bar)
    (deg_Cl : weilCurveClGroup C_bar.left →+ ℤ)
    (hdeg_sum : ∀ D : ({ x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) } →₀ ℤ),
      deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C_bar.left) D) =
        D.sum (fun _ n => n))
    (k_to_K : k →+* ↑C_bar.left.functionField)
    (hk_compat : ∀ (U : C_bar.left.Opens) [Nonempty ↥U.toScheme],
      (C_bar.left.germToFunctionField U).hom.comp
        ((CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (CategoryTheory.CategoryStruct.comp
            (CategoryTheory.CategoryStruct.comp U.ι C_bar.hom).appTop
            (U.topIso).hom)).hom) = k_to_K)
    (hStalkReg : ∀ (U : C_bar.left.Opens) [Nonempty ↥U.toScheme],
      AlgebraicGeometry.IsAffineOpen U →
      ∀ z : ↑C_bar.left.functionField,
        (∃ g : ↑(C_bar.left.presheaf.obj (Opposite.op U)),
          (C_bar.left.germToFunctionField U).hom g = z) ↔
        (∀ x : { x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) }, x.1 ∈ U →
          ∃ r : ↑(C_bar.left.presheaf.stalk x.1), algebraMap _ _ r = z))
    (hGlobalConst : ∀ z : ↑C_bar.left.functionField,
      (∀ x : { x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) },
        ∃ r : ↑(C_bar.left.presheaf.stalk x.1), algebraMap _ _ r = z) ↔
        z ∈ Set.range k_to_K)
    (U_C : C_bar.left.Opens)
    [AlgebraicGeometry.IsIntegral U_C.toScheme]
    (hAff_U : AlgebraicGeometry.IsAffineOpen U_C)
    (hNe_U : Nonempty ↥U_C)
    (hProper_U : (U_C : Set ↥C_bar.left) ≠ Set.univ) :
    Finite ↥((U_C : Set ↥C_bar.left)ᶜ) ∧
    Nonempty ↥((U_C : Set ↥C_bar.left)ᶜ) ∧
    (∀ x ∈ ((U_C : Set ↥C_bar.left)ᶜ), IsClosed ({x} : Set ↥C_bar.left)) ∧
    ∃ (A I : Type u) (_ : AddCommGroup A) (_ : AddCommGroup I)
      (φ : Additive (Units ↑(U_C.toScheme.presheaf.obj (Opposite.op ⊤))) →+ A)
      (i_A : A →+ (Fin (Nat.card ↥((U_C : Set ↥C_bar.left)ᶜ) - 1) → ℤ))
      (p_I : (Fin (Nat.card ↥((U_C : Set ↥C_bar.left)ᶜ) - 1) → ℤ) →+ I)
      (j_I : I →+ ↥deg_Cl.ker)
      (q_U : ↥deg_Cl.ker →+ weilCurveClGroup U_C.toScheme),
      Function.Surjective φ ∧
      (∀ (g : Additive (Units ↑(U_C.toScheme.presheaf.obj (Opposite.op ⊤)))),
        φ g = 0 → ∀ (m : ℕ), 1 ≤ m → ∃ g₀, (m : ℤ) • g₀ = g) ∧
      Function.Injective i_A ∧
      Function.Surjective p_I ∧
      p_I.ker = i_A.range ∧
      Function.Injective j_I ∧
      Function.Surjective q_U ∧
      q_U.ker = j_I.range :=
by
  classical
  obtain ⟨_, div_fn, hdiv_range, _, _, hDVR_stalk, _, _⟩ := hChart
  let X : AlgebraicGeometry.Scheme.{u} := C_bar.left
  let Pt := { x : ↥X // IsClosed ({x} : Set ↥X) }
  let Pt_U := { y : ↥U_C.toScheme // IsClosed ({y} : Set ↥U_C.toScheme) }
  let K := ↑X.functionField
  let R_U := ↑(U_C.toScheme.presheaf.obj (Opposite.op ⊤))
  let G_U := Additive (Units R_U)
  let S : Set ↥X := (U_C : Set ↥X)ᶜ

  
  have : AlgebraicGeometry.IsLocallyNoetherian (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    inferInstance
  have : AlgebraicGeometry.IsLocallyNoetherian X :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian C_bar.hom
  have hComp_X : IsCompact (Set.univ : Set ↥X) := by
    rw [← Set.preimage_univ (f := C_bar.hom.base)]
    exact C_bar.hom.isProperMap.isCompact_preimage isCompact_univ
  have : CompactSpace ↥X := ⟨hComp_X⟩
  have : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk
  have : TopologicalSpace.NoetherianSpace ↥X := AlgebraicGeometry.IsNoetherian.noetherianSpace

  
  have : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
  have : IrreducibleSpace ↥U_C.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral U_C.toScheme
  have hNe_U_sch : Nonempty ↥U_C.toScheme := hNe_U
  have hDimU : topologicalKrullDim U_C.toScheme = (1 : WithBot ℕ∞) := hDimOpen U_C hNe_U_sch

  let top_X : TopologicalSpace.IrreducibleCloseds ↥X :=
    ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥X, isClosed_univ⟩
  letI : OrderTop (TopologicalSpace.IrreducibleCloseds ↥X) :=
    { top := top_X
      le_top := fun _ _ _ => trivial }
  have hMin : ∀ C₀ : TopologicalSpace.IrreducibleCloseds ↥X, C₀ ≠ ⊤ → IsMin C₀ :=
    Order.krullDim_le_one_iff_forall_isMin.mp (le_of_eq hDimC)

  have hClosedPt_of_proper : ∀ (Z : Set ↥X), IsClosed Z → Z ≠ Set.univ →
      ∀ y ∈ Z, IsClosed ({y} : Set ↥X) := by
    intro Z hClZ hZ_ne y hy
    let Cy : TopologicalSpace.IrreducibleCloseds ↥X :=
      ⟨closure ({y} : Set ↥X), isIrreducible_singleton.closure, isClosed_closure⟩
    have hCy_sub : (Cy : Set ↥X) ⊆ Z := closure_minimal (Set.singleton_subset_iff.mpr hy) hClZ
    have hCy_ne : Cy ≠ ⊤ := by
      intro htop
      apply hZ_ne
      apply Set.Subset.antisymm (Set.subset_univ _)
      have h_eq : (Cy : Set ↥X) = Set.univ := congrArg SetLike.coe htop
      rwa [← h_eq]
    have hCy_min : IsMin Cy := hMin Cy hCy_ne
    rw [← closure_eq_iff_isClosed]
    apply Set.Subset.antisymm _ subset_closure
    intro w hw
    rw [Set.mem_singleton_iff]
    let Cw : TopologicalSpace.IrreducibleCloseds ↥X :=
      ⟨closure ({w} : Set ↥X), isIrreducible_singleton.closure, isClosed_closure⟩
    have hCw_le : Cw ≤ Cy := closure_minimal (Set.singleton_subset_iff.mpr hw) isClosed_closure
    have hCy_le : Cy ≤ Cw := hCy_min hCw_le
    have hy_in_w : y ∈ closure ({w} : Set ↥X) := hCy_le (subset_closure (Set.mem_singleton y))
    have h1 : y ⤳ w := specializes_iff_mem_closure.mpr hw
    have h2 : w ⤳ y := specializes_iff_mem_closure.mpr hy_in_w
    exact (h2.antisymm h1).eq

  have hFin_of_proper : ∀ (Z : Set ↥X), IsClosed Z → Z ≠ Set.univ → Z.Finite := by
    intro Z hClZ hZ_ne
    obtain ⟨S_irr, hS_fin, hS_cl, hS_irr, hZ_eq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hClZ
    rw [hZ_eq]
    apply hS_fin.sUnion
    intro Y hY
    have hY_cl : IsClosed Y := hS_cl Y hY
    have hY_irr : IsIrreducible Y := hS_irr Y hY
    have hY_sub : Y ⊆ Z := by
      rw [hZ_eq]
      exact Set.subset_sUnion_of_mem hY
    let CY : TopologicalSpace.IrreducibleCloseds ↥X := ⟨Y, hY_irr, hY_cl⟩
    have hCY_ne : CY ≠ ⊤ := by
      intro htop
      apply hZ_ne
      apply Set.Subset.antisymm (Set.subset_univ _)
      have h_eq : (CY : Set ↥X) = Set.univ := congrArg SetLike.coe htop
      rwa [← h_eq]
    have hCY_min : IsMin CY := hMin CY hCY_ne
    obtain ⟨y₀, hy₀⟩ := hY_irr.nonempty
    have hy₀_cl : IsClosed ({y₀} : Set ↥X) := hClosedPt_of_proper Z hClZ hZ_ne y₀ (hY_sub hy₀)
    let Cy₀ : TopologicalSpace.IrreducibleCloseds ↥X := ⟨{y₀}, isIrreducible_singleton, hy₀_cl⟩
    have hle : Cy₀ ≤ CY := Set.singleton_subset_iff.mpr hy₀
    have hge : CY ≤ Cy₀ := hCY_min hle
    have hY_eq : Y = {y₀} := Set.Subset.antisymm hge hle
    rw [hY_eq]
    exact Set.finite_singleton y₀

  have hCl_S_set : IsClosed S := U_C.isOpen.isClosed_compl
  have hNe_S : Nonempty ↥S := (Set.nonempty_compl.mpr hProper_U).to_subtype
  have hS_ne_univ : S ≠ Set.univ := by
    obtain ⟨u₀, hu₀⟩ := hNe_U
    intro huniv
    have hu₀_in : u₀ ∈ S := huniv.symm ▸ Set.mem_univ u₀
    exact hu₀_in hu₀
  have hFin_S : Finite ↥S := (hFin_of_proper S hCl_S_set hS_ne_univ).to_subtype
  have hCl_S : ∀ x ∈ S, IsClosed ({x} : Set ↥X) := hClosedPt_of_proper S hCl_S_set hS_ne_univ

  have hCl_U : ∀ y : Pt_U, IsClosed ({U_C.ι.base y.1} : Set ↥X) := by
    intro y
    have h_not_univ : closure ({U_C.ι.base y.1} : Set ↥X) ≠ Set.univ := by
      intro h_univ
      have h_pre :=
        U_C.ι.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image
          ({y.1} : Set ↥U_C.toScheme)
      rw [y.2.closure_eq, Set.image_singleton, h_univ, Set.preimage_univ] at h_pre
      have h_all_eq : ∀ z : ↥U_C.toScheme, z = y.1 := by
        intro z
        have hz : z ∈ ({y.1} : Set ↥U_C.toScheme) := h_pre.symm ▸ Set.mem_univ z
        exact Set.mem_singleton_iff.mp hz
      let top_U : TopologicalSpace.IrreducibleCloseds ↥U_C.toScheme :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥U_C.toScheme, isClosed_univ⟩
      letI : Unique (TopologicalSpace.IrreducibleCloseds ↥U_C.toScheme) :=
        { default := top_U
          uniq := fun A => by
            ext z
            change z ∈ (A : Set ↥U_C.toScheme) ↔ z ∈ (Set.univ : Set ↥U_C.toScheme)
            simp only [Set.mem_univ, iff_true]
            obtain ⟨z₀, hz₀⟩ := A.isIrreducible.nonempty
            rwa [h_all_eq z, ← h_all_eq z₀] }
      have h0 : topologicalKrullDim U_C.toScheme = 0 := Order.krullDim_eq_zero_of_unique
      rw [hDimU] at h0
      exact one_ne_zero h0
    exact hClosedPt_of_proper (closure ({U_C.ι.base y.1} : Set ↥X)) isClosed_closure h_not_univ
      (U_C.ι.base y.1) (subset_closure (Set.mem_singleton _))

  
  let ι_Pt : Pt_U → Pt := fun y => ⟨U_C.ι.base y.1, hCl_U y⟩
  have hι_base_inj : Function.Injective U_C.ι.base := U_C.ι.isOpenEmbedding.injective
  have hι_inj : Function.Injective ι_Pt :=
    fun y₁ y₂ h => Subtype.ext (hι_base_inj (congrArg (fun p : Pt => p.1) h))
  have hRange_ι : Set.range U_C.ι.base = (U_C : Set ↥X) := U_C.range_ι
  let res_U : (Pt →₀ ℤ) →+ (Pt_U →₀ ℤ) :=
    { toFun := fun D => Finsupp.comapDomain ι_Pt D hι_inj.injOn
      map_zero' := by ext y; simp
      map_add' := fun D₁ D₂ => by ext y; simp [Finsupp.comapDomain_apply] }
  have hres_apply : ∀ (D : Pt →₀ ℤ) (y : Pt_U), res_U D y = D (ι_Pt y) :=
    fun D y => Finsupp.comapDomain_apply ι_Pt D hι_inj.injOn y

  let η_X : ↥X := genericPoint ↥X
  let η_U : ↥U_C.toScheme := genericPoint ↥U_C.toScheme
  have h_dense : closure ({U_C.ι.base η_U} : Set ↥X) = Set.univ := by
    ext z
    simp only [Set.mem_univ, iff_true, mem_closure_iff]
    intro V hVo hzV
    have hRange_open : IsOpen (Set.range U_C.ι.base) := U_C.ι.isOpenMap.isOpen_range
    obtain ⟨u₀⟩ := hNe_U_sch
    obtain ⟨_, -, ⟨w, rfl⟩, hwV⟩ :=
      (IrreducibleSpace.isIrreducible_univ (X := ↥X)).isPreirreducible (Set.range U_C.ι.base) V
        hRange_open hVo ⟨U_C.ι.base u₀, trivial, ⟨u₀, rfl⟩⟩ ⟨z, trivial, hzV⟩
    have hW_open : IsOpen (U_C.ι.base ⁻¹' V) := hVo.preimage U_C.ι.continuous
    have hη_in_W : η_U ∈ U_C.ι.base ⁻¹' V := by
      by_contra h_not
      have h_sub : ({η_U} : Set ↥U_C.toScheme) ⊆ (U_C.ι.base ⁻¹' V)ᶜ :=
        Set.singleton_subset_iff.mpr h_not
      have h_cl := closure_minimal h_sub hW_open.isClosed_compl
      rw [genericPoint_spec ↥U_C.toScheme] at h_cl
      exact h_cl (Set.mem_univ w) hwV
    exact ⟨U_C.ι.base η_U, hη_in_W, Set.mem_singleton _⟩

  have h_fwd : η_X ⤳ U_C.ι.base η_U := genericPoint_specializes (U_C.ι.base η_U)
  have h_bwd : U_C.ι.base η_U ⤳ η_X := specializes_iff_mem_closure.mpr (by rw [h_dense]; trivial)
  let iso_η : X.functionField ≅ X.presheaf.stalk (U_C.ι.base η_U) :=
    { hom := X.presheaf.stalkSpecializes h_bwd
      inv := X.presheaf.stalkSpecializes h_fwd
      hom_inv_id := by
        change X.presheaf.stalkSpecializes h_bwd ≫ X.presheaf.stalkSpecializes h_fwd =
          𝟙 (X.presheaf.stalk η_X)
        rw [TopCat.Presheaf.stalkSpecializes_comp, TopCat.Presheaf.stalkSpecializes_refl]
      inv_hom_id := by
        rw [TopCat.Presheaf.stalkSpecializes_comp, TopCat.Presheaf.stalkSpecializes_refl] }
  let iso_K : X.functionField ≅ U_C.toScheme.functionField :=
    iso_η ≪≫ CategoryTheory.asIso (U_C.ι.stalkMap η_U)
  let e_K : K ≃+* ↑U_C.toScheme.functionField := iso_K.commRingCatIsoToRingEquiv
  let e_stalk : ∀ y : ↥U_C.toScheme,
      ↑(X.presheaf.stalk (U_C.ι.base y)) ≃+* ↑(U_C.toScheme.presheaf.stalk y) :=
    fun y => (CategoryTheory.asIso (U_C.ι.stalkMap y)).commRingCatIsoToRingEquiv

  have h_alg_compat : ∀ (y : ↥U_C.toScheme) (r : ↑(X.presheaf.stalk (U_C.ι.base y))),
      algebraMap _ ↑U_C.toScheme.functionField (e_stalk y r) =
        e_K (algebraMap _ K r) := by
    intro y r
    have h_comm :
        U_C.ι.stalkMap y ≫ U_C.toScheme.presheaf.stalkSpecializes (genericPoint_specializes y) =
          X.presheaf.stalkSpecializes (genericPoint_specializes (U_C.ι.base y)) ≫ iso_K.hom := by
      dsimp [iso_K, iso_η]
      rw [← CategoryTheory.Category.assoc, TopCat.Presheaf.stalkSpecializes_comp]
      exact (U_C.ι.stalkSpecializes_stalkMap η_U y (genericPoint_specializes y)).symm
    exact congrArg (fun g => g.hom r) h_comm

  have h_max_map : ∀ y : ↥U_C.toScheme,
      Ideal.map (e_stalk y) (IsLocalRing.maximalIdeal ↑(X.presheaf.stalk (U_C.ι.base y))) =
        IsLocalRing.maximalIdeal ↑(U_C.toScheme.presheaf.stalk y) := by
    intro y
    exact (IsLocalRing.isMaximal_iff _).mp (Ideal.map_isMaximal_of_equiv (e_stalk y))

  have h_max_symm : ∀ y : ↥U_C.toScheme,
      Ideal.map (e_stalk y).symm (IsLocalRing.maximalIdeal ↑(U_C.toScheme.presheaf.stalk y)) =
        IsLocalRing.maximalIdeal ↑(X.presheaf.stalk (U_C.ι.base y)) := by
    intro y
    exact (IsLocalRing.isMaximal_iff _).mp (Ideal.map_isMaximal_of_equiv (e_stalk y).symm)

  let Gen_X : Set (Pt →₀ ℤ) :=
    { D : Pt →₀ ℤ |
      ∃ f : Units K,
        ∀ x : Pt,
          let Rx := ↑(X.presheaf.stalk x.1)
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ (a b : Rx) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Rx K a = (f : K) * algebraMap Rx K b ∧
            Ideal.span ({a} : Set Rx) = mx ^ na ∧
            Ideal.span ({b} : Set Rx) = mx ^ nb ∧
            D x = (na : ℤ) - (nb : ℤ) }
  let Gen_U : Set (Pt_U →₀ ℤ) :=
    { D_U : Pt_U →₀ ℤ |
      ∃ f_U : Units ↑U_C.toScheme.functionField,
        ∀ y : Pt_U,
          let Ry := ↑(U_C.toScheme.presheaf.stalk y.1)
          let my := IsLocalRing.maximalIdeal Ry
          ∃ (a b : Ry) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Ry ↑U_C.toScheme.functionField a =
              (f_U : ↑U_C.toScheme.functionField) * algebraMap Ry ↑U_C.toScheme.functionField b ∧
            Ideal.span ({a} : Set Ry) = my ^ na ∧
            Ideal.span ({b} : Set Ry) = my ^ nb ∧
            D_U y = (na : ℤ) - (nb : ℤ) }

  have hGen_img : res_U '' Gen_X = Gen_U := by
    apply Set.Subset.antisymm
    · rintro _ ⟨D, ⟨f, hf⟩, rfl⟩
      refine ⟨Units.map e_K.toMonoidHom f, fun y => ?_⟩
      obtain ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hD⟩ := hf (ι_Pt y)
      refine ⟨e_stalk y.1 a, e_stalk y.1 b, na, nb,
        (map_ne_zero_iff (e_stalk y.1) (e_stalk y.1).injective).mpr ha,
        (map_ne_zero_iff (e_stalk y.1) (e_stalk y.1).injective).mpr hb, ?_, ?_, ?_, ?_⟩
      · rw [h_alg_compat y.1 a, h_alg_compat y.1 b, hab, map_mul]
        rfl
      · have hm := congrArg (Ideal.map (e_stalk y.1)) hsa
        rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, h_max_map y.1] at hm
      · have hm := congrArg (Ideal.map (e_stalk y.1)) hsb
        rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, h_max_map y.1] at hm
      · rw [hres_apply, hD]
    · rintro D_U ⟨f_U, hf_U⟩
      let f : Units K := Units.map e_K.symm.toMonoidHom f_U
      have hf_eK : e_K (f : K) = (f_U : ↑U_C.toScheme.functionField) := e_K.apply_symm_apply _
      have hPrePt : ∀ (x : Pt) (hx : x.1 ∈ Set.range U_C.ι.base),
          IsClosed ({Classical.choose hx} : Set ↥U_C.toScheme) := by
        intro x hx
        let y₀ := Classical.choose hx
        have hy₀ : U_C.ι.base y₀ = x.1 := Classical.choose_spec hx
        have hsing : ({y₀} : Set ↥U_C.toScheme) = U_C.ι.base ⁻¹' ({x.1} : Set ↥X) := by
          ext z
          simp only [Set.mem_singleton_iff, Set.mem_preimage]
          exact ⟨fun h => h ▸ hy₀, fun h => hι_base_inj (h.trans hy₀.symm)⟩
        rw [hsing]
        exact x.2.preimage U_C.ι.continuous
      have hOut : ∀ x : Pt, x.1 ∉ Set.range U_C.ι.base →
          let Rx := ↑(X.presheaf.stalk x.1)
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ (a b : Rx) (na nb : ℕ),
            a ≠ 0 ∧ b ≠ 0 ∧
            algebraMap Rx K a = (f : K) * algebraMap Rx K b ∧
            Ideal.span ({a} : Set Rx) = mx ^ na ∧
            Ideal.span ({b} : Set Rx) = mx ^ nb := by
        intro x _
        let Rx := ↑(X.presheaf.stalk x.1)
        let mx := IsLocalRing.maximalIdeal Rx
        have : IsDiscreteValuationRing Rx := (hDVR_stalk x).1
        obtain ⟨⟨a, b, hb_nzd⟩, hmul⟩ := IsLocalization.surj (nonZeroDivisors Rx) (f : K)
        have hb_ne : b ≠ 0 := nonZeroDivisors.ne_zero hb_nzd
        have hφ_inj : Function.Injective (algebraMap Rx K) := IsFractionRing.injective Rx K
        have hφb_ne : algebraMap Rx K b ≠ 0 :=
          fun h0 => hb_ne (hφ_inj (h0.trans (map_zero _).symm))
        have hab : algebraMap Rx K a = (f : K) * algebraMap Rx K b := hmul.symm
        have ha_ne : a ≠ 0 := by
          intro ha0
          rw [ha0, map_zero] at hab
          exact (mul_ne_zero f.ne_zero hφb_ne) hab.symm
        have ha_span_ne : Ideal.span ({a} : Set Rx) ≠ ⊥ :=
          mt Ideal.span_singleton_eq_bot.mp ha_ne
        have hb_span_ne : Ideal.span ({b} : Set Rx) ≠ ⊥ :=
          mt Ideal.span_singleton_eq_bot.mp hb_ne
        obtain ⟨na, hna⟩ :=
          exists_maximalIdeal_pow_eq_of_principal Rx inferInstance (Ideal.span ({a} : Set Rx))
            ha_span_ne
        obtain ⟨nb, hnb⟩ :=
          exists_maximalIdeal_pow_eq_of_principal Rx inferInstance (Ideal.span ({b} : Set Rx))
            hb_span_ne
        exact ⟨a, b, na, nb, ha_ne, hb_ne, hab, hna, hnb⟩
      let D_fn : Pt → ℤ := fun x =>
        if hx : x.1 ∈ Set.range U_C.ι.base then
          D_U ⟨Classical.choose hx, hPrePt x hx⟩
        else
          let w := Classical.choose_spec (Classical.choose_spec (hOut x hx))
          ((Classical.choose w : ℕ) : ℤ) - ((Classical.choose (Classical.choose_spec w) : ℕ) : ℤ)
      have hFin_out : { x : Pt | x.1 ∉ Set.range U_C.ι.base }.Finite := by
        let toCompl : { x : Pt // x.1 ∉ Set.range U_C.ι.base } → ↥S :=
          fun z => ⟨z.1.1, by change z.1.1 ∉ (U_C : Set ↥X); rw [← hRange_ι]; exact z.2⟩
        have hInj_compl : Function.Injective toCompl :=
          fun z₁ z₂ h => Subtype.ext (Subtype.ext (congrArg (fun s : ↥S => s.1) h))
        exact Set.finite_coe_iff.mpr (Finite.of_injective toCompl hInj_compl)
      let S_supp : Set Pt :=
        (ι_Pt '' (D_U.support : Set Pt_U)) ∪ { x : Pt | x.1 ∉ Set.range U_C.ι.base }
      have hS_fin : S_supp.Finite := (D_U.support.finite_toSet.image ι_Pt).union hFin_out
      have hSupp_mem : ∀ x : Pt, D_fn x ≠ 0 → x ∈ hS_fin.toFinset := by
        intro x hne
        rw [Set.Finite.mem_toFinset]
        by_cases hx : x.1 ∈ Set.range U_C.ι.base
        · left
          have hne' : D_U ⟨Classical.choose hx, hPrePt x hx⟩ ≠ 0 := by
            rwa [show D_fn x = D_U ⟨Classical.choose hx, hPrePt x hx⟩ from dif_pos hx] at hne
          exact ⟨⟨Classical.choose hx, hPrePt x hx⟩, Finsupp.mem_support_iff.mpr hne',
            Subtype.ext (Classical.choose_spec hx)⟩
        · exact Or.inr hx
      let D : Pt →₀ ℤ := Finsupp.onFinset hS_fin.toFinset D_fn hSupp_mem
      refine ⟨D, ⟨f, ?_⟩, ?_⟩
      · rintro ⟨x_val, hx_cl⟩
        have hD_app : D ⟨x_val, hx_cl⟩ = D_fn ⟨x_val, hx_cl⟩ := rfl
        by_cases hx : x_val ∈ Set.range U_C.ι.base
        · obtain ⟨y₀, hy₀⟩ := hx
          have hx' : x_val ∈ Set.range U_C.ι.base := ⟨y₀, hy₀⟩
          have hy₀_cl : IsClosed ({y₀} : Set ↥U_C.toScheme) := by
            have hchoose_eq : Classical.choose hx' = y₀ :=
              hι_base_inj ((Classical.choose_spec hx').trans hy₀.symm)
            exact hchoose_eq ▸ hPrePt ⟨x_val, hx_cl⟩ hx'
          let y_pt : Pt_U := ⟨y₀, hy₀_cl⟩
          have hD_eq : D ⟨x_val, hx_cl⟩ = D_U y_pt := by
            rw [hD_app, show D_fn ⟨x_val, hx_cl⟩ =
              D_U ⟨Classical.choose hx', hPrePt ⟨x_val, hx_cl⟩ hx'⟩ from dif_pos hx']
            congr 1
            exact Subtype.ext (hι_base_inj ((Classical.choose_spec hx').trans hy₀.symm))
          clear hx'
          obtain ⟨a_U, b_U, na, nb, ha_U, hb_U, hab_U, hsa_U, hsb_U, hDU_y⟩ := hf_U y_pt
          subst hy₀
          refine ⟨(e_stalk y₀).symm a_U, (e_stalk y₀).symm b_U, na, nb,
            (map_ne_zero_iff (e_stalk y₀).symm (e_stalk y₀).symm.injective).mpr ha_U,
            (map_ne_zero_iff (e_stalk y₀).symm (e_stalk y₀).symm.injective).mpr hb_U,
            ?_, ?_, ?_, hD_eq.trans hDU_y⟩
          · apply e_K.injective
            rw [← h_alg_compat y₀ ((e_stalk y₀).symm a_U), (e_stalk y₀).apply_symm_apply,
              map_mul, ← h_alg_compat y₀ ((e_stalk y₀).symm b_U), (e_stalk y₀).apply_symm_apply,
              hf_eK, hab_U]
          · have hm := congrArg (Ideal.map (e_stalk y₀).symm) hsa_U
            rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, h_max_symm y₀] at hm
          · have hm := congrArg (Ideal.map (e_stalk y₀).symm) hsb_U
            rwa [Ideal.map_span, Set.image_singleton, Ideal.map_pow, h_max_symm y₀] at hm
        · let h_ex := hOut ⟨x_val, hx_cl⟩ hx
          let a := Classical.choose h_ex
          let h_ex1 := Classical.choose_spec h_ex
          let b := Classical.choose h_ex1
          let h_ex2 := Classical.choose_spec h_ex1
          let na := Classical.choose h_ex2
          let h_ex3 := Classical.choose_spec h_ex2
          let nb := Classical.choose h_ex3
          obtain ⟨ha, hb, hab, hsa, hsb⟩ := Classical.choose_spec h_ex3
          exact ⟨a, b, na, nb, ha, hb, hab, hsa, hsb, hD_app.trans (dif_neg hx)⟩
      · ext y
        rw [hres_apply]
        change D_fn (ι_Pt y) = D_U y
        have hy_in : (ι_Pt y).1 ∈ Set.range U_C.ι.base := ⟨y.1, rfl⟩
        rw [show D_fn (ι_Pt y) = D_U ⟨Classical.choose hy_in, hPrePt (ι_Pt y) hy_in⟩ from
          dif_pos hy_in]
        congr 1
        apply Subtype.ext
        exact hι_base_inj (Classical.choose_spec hy_in)

  have hres_princ :
      AddSubgroup.map res_U (weilCurvePrincipalSubgroup X) =
        weilCurvePrincipalSubgroup U_C.toScheme := by
    change AddSubgroup.map res_U (AddSubgroup.closure Gen_X) = AddSubgroup.closure Gen_U
    rw [AddMonoidHom.map_closure, hGen_img]

  
  let e_Γ : R_U ≃+* ↑(X.presheaf.obj (Opposite.op U_C)) := U_C.topIso.commRingCatIsoToRingEquiv
  let ι_Γ : ↑(X.presheaf.obj (Opposite.op U_C)) →+* K := (X.germToFunctionField U_C).hom
  have hιΓ_inj : Function.Injective ι_Γ :=
    AlgebraicGeometry.Scheme.germToFunctionField_injective X U_C
  let ι_U : R_U →+* K := ι_Γ.comp e_Γ.toRingHom
  have hιU_inj : Function.Injective ι_U := hιΓ_inj.comp e_Γ.injective
  let γ_U : G_U →+ Additive (Units K) := MonoidHom.toAdditive (Units.map ι_U.toMonoidHom)
  let div_G : G_U →+ (Pt →₀ ℤ) := div_fn.comp γ_U

  have hdivG_princ : ∀ g : G_U, div_G g ∈ weilCurvePrincipalSubgroup X := by
    intro g
    rw [← hdiv_range]
    exact ⟨γ_U g, rfl⟩

  have hdivG_van : ∀ (g : G_U) (x : Pt), x.1 ∈ U_C → div_G g x = 0 := by
    intro g x hx
    let w : Units R_U := Additive.toMul g
    let u : Units K := Units.map ι_U.toMonoidHom w
    have h1 : 0 ≤ div_fn (Additive.ofMul u) x :=
      ((hDVR_stalk x).2 u).1.mpr
        ⟨(X.presheaf.germ U_C x.1 hx).hom (e_Γ w.val),
          AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField X hx (e_Γ w.val)⟩
    have h2 : 0 ≤ div_fn (Additive.ofMul u⁻¹) x :=
      ((hDVR_stalk x).2 u⁻¹).1.mpr
        ⟨(X.presheaf.germ U_C x.1 hx).hom (e_Γ (w⁻¹ : Units R_U).val),
          AlgebraicGeometry.Scheme.algebraMap_germ_eq_germToFunctionField X hx
            (e_Γ (w⁻¹ : Units R_U).val)⟩
    rw [ofMul_inv, map_neg, Finsupp.neg_apply] at h2
    change div_fn (Additive.ofMul u) x = 0
    omega

  have hdivG_surj : ∀ D ∈ weilCurvePrincipalSubgroup X,
      (∀ x : Pt, x.1 ∈ U_C → D x = 0) → D ∈ div_G.range := by
    intro D hD_princ hD_van
    rw [← hdiv_range] at hD_princ
    obtain ⟨a, rfl⟩ := hD_princ
    let u : Units K := Additive.toMul a
    have ha_eq : a = Additive.ofMul u := rfl
    have hu_reg : ∀ x : Pt, x.1 ∈ U_C →
        ∃ r : ↑(X.presheaf.stalk x.1), algebraMap _ K r = (u : K) := by
      intro x hx
      apply ((hDVR_stalk x).2 u).1.mp
      rw [← ha_eq, hD_van x hx]
    have huinv_reg : ∀ x : Pt, x.1 ∈ U_C →
        ∃ r : ↑(X.presheaf.stalk x.1), algebraMap _ K r = ((u⁻¹ : Units K) : K) := by
      intro x hx
      apply ((hDVR_stalk x).2 u⁻¹).1.mp
      rw [ofMul_inv, map_neg, Finsupp.neg_apply, ← ha_eq, hD_van x hx, neg_zero]
    obtain ⟨b₁, hb₁⟩ := (hStalkReg U_C hAff_U (u : K)).mpr hu_reg
    obtain ⟨b₂, hb₂⟩ := (hStalkReg U_C hAff_U ((u⁻¹ : Units K) : K)).mpr huinv_reg
    have hb12 : b₁ * b₂ = 1 := hιΓ_inj (by rw [map_mul, map_one, hb₁, hb₂, Units.mul_inv])
    have hb21 : b₂ * b₁ = 1 := hιΓ_inj (by rw [map_mul, map_one, hb₂, hb₁, Units.inv_mul])
    let w : Units R_U :=
      { val := e_Γ.symm b₁
        inv := e_Γ.symm b₂
        val_inv := by rw [← map_mul, hb12, map_one]
        inv_val := by rw [← map_mul, hb21, map_one] }
    refine ⟨Additive.ofMul w, ?_⟩
    change div_fn (Additive.ofMul (Units.map ι_U.toMonoidHom w)) = div_fn (Additive.ofMul u)
    congr 2
    apply Units.ext
    change ι_Γ (e_Γ (e_Γ.symm b₁)) = (u : K)
    rw [e_Γ.apply_symm_apply, hb₁]

  have hdivG_div : ∀ g : G_U, div_G g = 0 → ∀ (m : ℕ), 1 ≤ m → ∃ g₀ : G_U, (m : ℤ) • g₀ = g := by
    intro g hg0 m hm
    let w : Units R_U := Additive.toMul g
    let u : Units K := Units.map ι_U.toMonoidHom w
    have hu_div0 : div_fn (Additive.ofMul u) = 0 := hg0
    have hu_all : ∀ x : Pt, ∃ r : ↑(X.presheaf.stalk x.1), algebraMap _ K r = (u : K) := by
      intro x
      apply ((hDVR_stalk x).2 u).1.mp
      rw [hu_div0, Finsupp.zero_apply]
    obtain ⟨c, hc⟩ := (hGlobalConst (u : K)).mp hu_all
    have hc_ne : c ≠ 0 := by
      intro hc0
      rw [hc0, map_zero] at hc
      exact u.ne_zero hc.symm
    have hm_pos : 0 < m := hm
    let P_poly : Polynomial k := Polynomial.X ^ m - Polynomial.C c
    have hdegP : P_poly.degree ≠ 0 := by
      dsimp [P_poly]
      rw [Polynomial.degree_X_pow_sub_C hm_pos c]
      exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hm_pos)
    obtain ⟨d₀, hd₀_root⟩ := IsAlgClosed.exists_root P_poly hdegP
    have hd₀_pow : d₀ ^ m = c := by
      have hev : Polynomial.eval d₀ P_poly = 0 := hd₀_root
      simp only [P_poly, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C, sub_eq_zero] at hev
      exact hev
    have hd₀_ne : d₀ ≠ 0 := by
      intro hd0
      rw [hd0, zero_pow (Nat.ne_of_gt hm_pos)] at hd₀_pow
      exact hc_ne hd₀_pow.symm
    let u_d : Units k := Units.mk0 d₀ hd₀_ne
    let α_U : k →+* R_U :=
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
        (CategoryTheory.CategoryStruct.comp U_C.ι C_bar.hom).appTop).hom
    have h_ι_α : ∀ a : k, ι_U (α_U a) = k_to_K a :=
      fun a => RingHom.congr_fun (hk_compat U_C) a
    let g₀ : G_U := Additive.ofMul (Units.map α_U.toMonoidHom u_d)
    refine ⟨g₀, ?_⟩
    apply Additive.toMul.injective
    rw [natCast_zsmul, toMul_nsmul, toMul_ofMul]
    apply Units.ext
    apply hιU_inj
    change ι_U (((Units.map α_U.toMonoidHom u_d) ^ m : Units R_U) : R_U) = (u : K)
    rw [Units.val_pow_eq_pow_val]
    change ι_U ((α_U d₀) ^ m) = (u : K)
    rw [← map_pow, hd₀_pow, h_ι_α c, hc]

  
  let d : ℕ := Nat.card ↥S - 1
  have hPos_S : 0 < Nat.card ↥S := @Nat.card_pos ↥S hNe_S hFin_S
  have hCard_S : Nat.card ↥S = d + 1 := (Nat.sub_add_cancel hPos_S).symm
  let e_S : Fin (d + 1) ≃ ↥S := (Finite.equivFinOfCardEq hCard_S).symm
  let P : Fin (d + 1) → Pt := fun a => ⟨(e_S a).1, hCl_S (e_S a).1 (e_S a).2⟩
  have hP_inj : Function.Injective P :=
    fun a₁ a₂ h => e_S.injective (Subtype.ext (congrArg (fun x : Pt => x.1) h))
  have hP_not_inU : ∀ a : Fin (d + 1), (P a).1 ∉ U_C := fun a => (e_S a).2
  have hP_surj : ∀ x : Pt, x.1 ∉ U_C → ∃ a : Fin (d + 1), P a = x := by
    intro x hx
    refine ⟨e_S.symm ⟨x.1, hx⟩, Subtype.ext ?_⟩
    change (e_S (e_S.symm ⟨x.1, hx⟩)).1 = x.1
    rw [e_S.apply_symm_apply]

  have hι_inU : ∀ y : Pt_U, (ι_Pt y).1 ∈ U_C := by
    intro y
    change U_C.ι.base y.1 ∈ (U_C : Set ↥X)
    rw [← hRange_ι]
    exact ⟨y.1, rfl⟩
  have hι_surj : ∀ x : Pt, x.1 ∈ U_C → ∃ y : Pt_U, ι_Pt y = x := by
    intro x hx
    have hx_rng : x.1 ∈ Set.range U_C.ι.base := hRange_ι.symm ▸ hx
    let y₀ := Classical.choose hx_rng
    have hy₀ : U_C.ι.base y₀ = x.1 := Classical.choose_spec hx_rng
    have hy₀_cl : IsClosed ({y₀} : Set ↥U_C.toScheme) := by
      have hsing : ({y₀} : Set ↥U_C.toScheme) = U_C.ι.base ⁻¹' ({x.1} : Set ↥X) := by
        ext z
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        exact ⟨fun h => h ▸ hy₀, fun h => hι_base_inj (h.trans hy₀.symm)⟩
      rw [hsing]
      exact x.2.preimage U_C.ι.continuous
    exact ⟨⟨y₀, hy₀_cl⟩, Subtype.ext hy₀⟩

  let sum_X : (Pt →₀ ℤ) →+ ℤ := Finsupp.liftAddHom (fun _ => AddMonoidHom.id ℤ)
  have hsum_apply : ∀ D : Pt →₀ ℤ, sum_X D = D.sum (fun _ n => n) := by
    intro D
    rw [Finsupp.liftAddHom_apply]
    rfl
  have hsum_single : ∀ (x : Pt) (n : ℤ), sum_X (Finsupp.single x n) = n := by
    intro x n
    simp [sum_X]

  let β_S : (Fin d → ℤ) →+ (Pt →₀ ℤ) :=
    AddMonoidHom.mk'
      (fun v => (Finset.univ.sum fun j : Fin d => Finsupp.single (P j.succ) (v j)) -
        Finsupp.single (P 0) (Finset.univ.sum fun j : Fin d => v j))
      (fun u v => by
        simp only [Pi.add_apply, Finsupp.single_add, Finset.sum_add_distrib]
        abel)
  let π_S : (Pt →₀ ℤ) →+ (Fin d → ℤ) :=
    AddMonoidHom.mk' (fun D j => D (P j.succ))
      (fun D₁ D₂ => by ext j; simp)

  have hπ_β : ∀ v : Fin d → ℤ, π_S (β_S v) = v := by
    intro v
    ext i
    change ((Finset.univ.sum fun j : Fin d => Finsupp.single (P j.succ) (v j)) -
      Finsupp.single (P 0) (Finset.univ.sum fun j : Fin d => v j)) (P i.succ) = v i
    rw [Finsupp.sub_apply, Finsupp.finsetSum_apply]
    have h0 : (Finsupp.single (P 0) (Finset.univ.sum fun j : Fin d => v j)) (P i.succ) = 0 :=
      Finsupp.single_eq_of_ne (fun h => Fin.succ_ne_zero i (hP_inj h))
    rw [h0, sub_zero, Finset.sum_eq_single i]
    · exact Finsupp.single_eq_same
    · intro j _ hji
      exact Finsupp.single_eq_of_ne (fun h => hji (Fin.succ_injective d (hP_inj h.symm)))
    · intro hi
      exact absurd (Finset.mem_univ i) hi

  have hsum_β : ∀ v : Fin d → ℤ, sum_X (β_S v) = 0 := by
    intro v
    change sum_X ((Finset.univ.sum fun j : Fin d => Finsupp.single (P j.succ) (v j)) -
      Finsupp.single (P 0) (Finset.univ.sum fun j : Fin d => v j)) = 0
    rw [map_sub, map_sum, hsum_single]
    simp_rw [hsum_single]
    exact sub_self _

  have hβ_van : ∀ (v : Fin d → ℤ) (x : Pt), x.1 ∈ U_C → β_S v x = 0 := by
    intro v x hx
    change ((Finset.univ.sum fun j : Fin d => Finsupp.single (P j.succ) (v j)) -
      Finsupp.single (P 0) (Finset.univ.sum fun j : Fin d => v j)) x = 0
    rw [Finsupp.sub_apply, Finsupp.finsetSum_apply]
    have h0 : (Finsupp.single (P 0) (Finset.univ.sum fun j : Fin d => v j)) x = 0 :=
      Finsupp.single_eq_of_ne (fun h => hP_not_inU 0 (h ▸ hx))
    have h1 : (Finset.univ.sum fun j : Fin d => Finsupp.single (P j.succ) (v j) x) = 0 :=
      Finset.sum_eq_zero fun j _ =>
        Finsupp.single_eq_of_ne (fun h => hP_not_inU j.succ (h ▸ hx))
    rw [h1, h0, sub_zero]

  have hβ_π : ∀ D : Pt →₀ ℤ, (∀ x : Pt, x.1 ∈ U_C → D x = 0) → sum_X D = 0 → β_S (π_S D) = D := by
    intro D hvan hsum0
    have hsupp : D.support ⊆ Finset.univ.image P := by
      intro x hx
      rw [Finsupp.mem_support_iff] at hx
      have hnot : x.1 ∉ U_C := fun hin => hx (hvan x hin)
      obtain ⟨a, rfl⟩ := hP_surj x hnot
      exact Finset.mem_image_of_mem P (Finset.mem_univ a)
    have hsum_P : (Finset.univ.sum fun a : Fin (d + 1) => D (P a)) = 0 := by
      rw [← Finset.sum_image (fun a _ b _ h => hP_inj h),
        ← Finsupp.sum_of_support_subset D hsupp (fun _ n => n) (fun _ _ => rfl),
        ← hsum_apply D, hsum0]
    rw [Fin.sum_univ_succ] at hsum_P
    have hD_P0 : D (P 0) = - (Finset.univ.sum fun j : Fin d => D (P j.succ)) := by omega
    ext x
    by_cases hx : x.1 ∈ U_C
    · rw [hβ_van (π_S D) x hx, hvan x hx]
    · obtain ⟨a, rfl⟩ := hP_surj x hx
      refine Fin.cases ?_ (fun i => ?_) a
      · change ((Finset.univ.sum fun j : Fin d => Finsupp.single (P j.succ) (D (P j.succ))) -
          Finsupp.single (P 0) (Finset.univ.sum fun j : Fin d => D (P j.succ))) (P 0) = D (P 0)
        rw [Finsupp.sub_apply, Finsupp.finsetSum_apply, Finsupp.single_eq_same]
        have hs0 : (Finset.univ.sum fun j : Fin d =>
            Finsupp.single (P j.succ) (D (P j.succ)) (P 0)) = 0 :=
          Finset.sum_eq_zero fun j _ =>
            Finsupp.single_eq_of_ne (fun h => Fin.succ_ne_zero j (hP_inj h.symm))
        rw [hs0, zero_sub, hD_P0]
      · change (π_S (β_S (π_S D))) i = (π_S D) i
        rw [hπ_β]

  let ψ_U : G_U →+ (Fin d → ℤ) := π_S.comp div_G
  have hβ_ψ : ∀ g : G_U, β_S (ψ_U g) = div_G g := by
    intro g
    apply hβ_π (div_G g) (hdivG_van g)
    rw [hsum_apply, ← hdeg_sum (div_G g)]
    have hmk0 : QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (div_G g) = 0 :=
      (QuotientAddGroup.eq_zero_iff _).mpr (hdivG_princ g)
    rw [hmk0, map_zero]

  let A : Type u := G_U ⧸ ψ_U.ker
  let φ : G_U →+ A := QuotientAddGroup.mk' ψ_U.ker
  let i_A : A →+ (Fin d → ℤ) := QuotientAddGroup.kerLift ψ_U
  have hφ_surj : Function.Surjective φ := QuotientAddGroup.mk'_surjective ψ_U.ker
  have hi_A_inj : Function.Injective i_A := QuotientAddGroup.kerLift_injective ψ_U
  have hφ_div : ∀ g : G_U, φ g = 0 → ∀ (m : ℕ), 1 ≤ m → ∃ g₀ : G_U, (m : ℤ) • g₀ = g := by
    intro g hg m hm
    have hmem : g ∈ ψ_U.ker := (QuotientAddGroup.eq_zero_iff g).mp hg
    rw [AddMonoidHom.mem_ker] at hmem
    have hdiv0 : div_G g = 0 := by rw [← hβ_ψ g, hmem, map_zero]
    exact hdivG_div g hdiv0 m hm

  let μ_S0 : (Fin d → ℤ) →+ weilCurveClGroup X :=
    (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X)).comp β_S
  have hμ_ker : ∀ v : Fin d → ℤ, μ_S0 v ∈ deg_Cl.ker := by
    intro v
    rw [AddMonoidHom.mem_ker]
    change deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (β_S v)) = 0
    rw [hdeg_sum, ← hsum_apply, hsum_β]
  let μ_S : (Fin d → ℤ) →+ ↥deg_Cl.ker := μ_S0.codRestrict deg_Cl.ker hμ_ker
  let I : Type u := ↥μ_S.range
  let p_I : (Fin d → ℤ) →+ I := μ_S.rangeRestrict
  let j_I : I →+ ↥deg_Cl.ker := μ_S.range.subtype
  have hp_I_surj : Function.Surjective p_I := μ_S.rangeRestrict_surjective
  have hj_I_inj : Function.Injective j_I := Subtype.val_injective

  have hEx_AEI : p_I.ker = i_A.range := by
    ext v
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hv
      have hmk0 : QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (β_S v) = 0 :=
        congrArg Subtype.val (congrArg Subtype.val hv)
      have hprinc : β_S v ∈ weilCurvePrincipalSubgroup X :=
        (QuotientAddGroup.eq_zero_iff _).mp hmk0
      obtain ⟨g, hg⟩ := hdivG_surj (β_S v) hprinc (hβ_van v)
      refine ⟨φ g, ?_⟩
      change π_S (div_G g) = v
      rw [hg, hπ_β]
    · rintro ⟨a, rfl⟩
      obtain ⟨g, rfl⟩ := hφ_surj a
      apply Subtype.ext
      apply Subtype.ext
      change QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (β_S (ψ_U g)) = 0
      rw [hβ_ψ g]
      exact (QuotientAddGroup.eq_zero_iff _).mpr (hdivG_princ g)

  have hPrinc_le :
      weilCurvePrincipalSubgroup X ≤ (weilCurvePrincipalSubgroup U_C.toScheme).comap res_U := by
    intro D hD
    rw [AddSubgroup.mem_comap, ← hres_princ]
    exact AddSubgroup.mem_map_of_mem res_U hD
  let bar_res : weilCurveClGroup X →+ weilCurveClGroup U_C.toScheme :=
    QuotientAddGroup.map (weilCurvePrincipalSubgroup X) (weilCurvePrincipalSubgroup U_C.toScheme)
      res_U hPrinc_le
  let q_U : ↥deg_Cl.ker →+ weilCurveClGroup U_C.toScheme := bar_res.comp deg_Cl.ker.subtype

  have hq_U_surj : Function.Surjective q_U := by
    intro q
    obtain ⟨D_U, rfl⟩ := QuotientAddGroup.mk'_surjective (weilCurvePrincipalSubgroup U_C.toScheme) q
    let emb : Pt_U ↪ Pt := ⟨ι_Pt, hι_inj⟩
    let D_tilde : Pt →₀ ℤ :=
      Finsupp.embDomain emb D_U - Finsupp.single (P 0) (D_U.sum (fun _ n => n))
    have hdeg_tilde : QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D_tilde ∈ deg_Cl.ker := by
      rw [AddMonoidHom.mem_ker, hdeg_sum, ← hsum_apply]
      dsimp [D_tilde]
      rw [map_sub, hsum_single, hsum_apply, Finsupp.sum_embDomain, sub_self]
    refine ⟨⟨QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D_tilde, hdeg_tilde⟩, ?_⟩
    change QuotientAddGroup.mk' (weilCurvePrincipalSubgroup U_C.toScheme) (res_U D_tilde) =
      QuotientAddGroup.mk' (weilCurvePrincipalSubgroup U_C.toScheme) D_U
    congr 1
    ext y
    rw [hres_apply]
    change (Finsupp.embDomain emb D_U - Finsupp.single (P 0) (D_U.sum (fun _ n => n))) (emb y) =
      D_U y
    rw [Finsupp.sub_apply, Finsupp.embDomain_apply_self emb D_U y]
    have h0 : (Finsupp.single (P 0) (D_U.sum (fun _ n => n))) (emb y) = 0 :=
      Finsupp.single_eq_of_ne (fun h => hP_not_inU 0 (h.symm ▸ hι_inU y))
    rw [h0, sub_zero]

  have hEx_ICC : q_U.ker = j_I.range := by
    ext c
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hc
      obtain ⟨D, hD_mk⟩ := QuotientAddGroup.mk'_surjective (weilCurvePrincipalSubgroup X) c.1
      have hres_zero :
          QuotientAddGroup.mk' (weilCurvePrincipalSubgroup U_C.toScheme) (res_U D) = 0 := by
        change bar_res (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D) = 0
        rw [hD_mk]
        exact hc
      have hres_mem : res_U D ∈ weilCurvePrincipalSubgroup U_C.toScheme :=
        (QuotientAddGroup.eq_zero_iff _).mp hres_zero
      rw [← hres_princ] at hres_mem
      obtain ⟨P_div, hP_princ, hP_res⟩ := hres_mem
      let D' : Pt →₀ ℤ := D - P_div
      have hD'_mk : QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) D' = c.1 := by
        have hP0 : QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) P_div = 0 :=
          (QuotientAddGroup.eq_zero_iff P_div).mpr hP_princ
        change (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X)) (D - P_div) = c.1
        rw [map_sub, hD_mk, hP0, sub_zero]
      have hD'_sum : sum_X D' = 0 := by
        rw [hsum_apply, ← hdeg_sum D', hD'_mk]
        exact c.2
      have hD'_van : ∀ x : Pt, x.1 ∈ U_C → D' x = 0 := by
        intro x hx
        obtain ⟨y, rfl⟩ := hι_surj x hx
        change (D - P_div) (ι_Pt y) = 0
        rw [Finsupp.sub_apply, ← hres_apply D y, ← hres_apply P_div y, hP_res, sub_self]
      have hD'_eq : β_S (π_S D') = D' := hβ_π D' hD'_van hD'_sum
      refine ⟨p_I (π_S D'), Subtype.ext ?_⟩
      change QuotientAddGroup.mk' (weilCurvePrincipalSubgroup X) (β_S (π_S D')) = c.1
      rw [hD'_eq, hD'_mk]
    · rintro ⟨w, rfl⟩
      obtain ⟨v, rfl⟩ := hp_I_surj w
      change QuotientAddGroup.mk' (weilCurvePrincipalSubgroup U_C.toScheme) (res_U (β_S v)) = 0
      have hres0 : res_U (β_S v) = 0 := by
        ext y
        rw [hres_apply, Finsupp.zero_apply]
        exact hβ_van v (ι_Pt y) (hι_inU y)
      rw [hres0, map_zero]

  exact ⟨hFin_S, hNe_S, hCl_S, A, I, inferInstance, inferInstance, φ, i_A, p_I, j_I, q_U,
    hφ_surj, hφ_div, hi_A_inj, hp_I_surj, hEx_AEI, hj_I_inj, hq_U_surj, hEx_ICC⟩

theorem weil_etale_affine_curve_open_excision_and_card_eq (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C_bar.left]
    (hProjC : IsProjectiveOverField k C_bar)
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom]
    (hKum : ∀ Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)),
      CategoryTheory.Presheaf.IsSheaf Y.left.smallEtaleTopology (weilEtaleGmPresheaf Y.left) ∧
      ∃ (ι_kum : weilEtaleTorsionSheaf Y.left ℓ ⟶ weilEtaleGmSheaf Y.left)
        (p_kum : weilEtaleGmSheaf Y.left ⟶ weilEtaleGmSheaf Y.left)
        (h0 : ι_kum ≫ p_kum = 0),
        p_kum = ℓ • CategoryTheory.CategoryStruct.id (weilEtaleGmSheaf Y.left) ∧
        (CategoryTheory.ShortComplex.mk ι_kum p_kum h0).ShortExact)
    (hFin1_C : Finite { c : weilCurveClGroup C_bar.left // ℓ • c = 0 })
    (hCard1_C : Nat.card (weilCupPDModH C_bar.left ℓ 1) =
      Nat.card { c : weilCurveClGroup C_bar.left // ℓ • c = 0 })
    (hDiv_Cl0 : ∀ (deg_Cl : weilCurveClGroup C_bar.left →+ ℤ),
      (∀ D : ({ x : ↥C_bar.left // IsClosed ({x} : Set ↥C_bar.left) } →₀ ℤ),
        deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C_bar.left) D) =
          D.sum (fun _ n => n)) →
      ∀ c : weilCurveClGroup C_bar.left, deg_Cl c = 0 →
        ∃ y : weilCurveClGroup C_bar.left, deg_Cl y = 0 ∧ ℓ • y = c)
    (U_C : C_bar.left.Opens) (U_et : C_bar.left.Etale)
    (e_U : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj U_et).left
      U_C.toScheme)
    (hAff_U : AlgebraicGeometry.IsAffineOpen U_C)
    (hNe_U : Nonempty ↥U_C)
    (hProper_U : (U_C : Set ↥C_bar.left) ≠ Set.univ)
    (he_U : CategoryTheory.CategoryStruct.comp e_U.hom U_C.ι =
      ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj U_et).hom) :
    Finite (weilCupPDLocalModH C_bar.left ℓ U_et 1) ∧
    Finite (weilEtaleTorsionH U_C.toScheme ℓ 1) ∧
    Nat.card (weilCupPDLocalModH C_bar.left ℓ U_et 1) =
      Nat.card (weilEtaleTorsionH U_C.toScheme ℓ 1) :=
by
  classical
  let _ := hℓ
  have hPrime : Nat.Prime ℓ := Fact.out
  letI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  let X : AlgebraicGeometry.Scheme.{u} := C_bar.left
  have hIntX : AlgebraicGeometry.IsIntegral X := inferInstance

  
  have hDimC : topologicalKrullDim X = (1 : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k 1 C_bar hIntX
  have hDimOpen : ∀ U : X.Opens, Nonempty ↥(U : AlgebraicGeometry.Scheme.{u}) →
      topologicalKrullDim ↥(U : AlgebraicGeometry.Scheme.{u}) = (1 : WithBot ℕ∞) := by
    intro U hNeU
    letI : Nonempty ↥U.toScheme := hNeU
    have hIntU : AlgebraicGeometry.IsIntegral U.toScheme :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion U.ι
    let U_ov' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (U.ι ≫ C_bar.hom)
    have hSm01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (U.ι ≫ C_bar.hom) :=
      inferInstance
    have hSm1 : AlgebraicGeometry.SmoothOfRelativeDimension 1 U_ov'.hom := by
      simpa [U_ov'] using hSm01
    letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 U_ov'.hom := hSm1
    exact weil_smooth_integral_krullDim_over_field k 1 U_ov' hIntU
  obtain ⟨hPropC, k_to_K, hk_compat, hStalkReg, _, hGlobalConst, _⟩ :=
    weil_proj_curve_dual_hyperplane_cover_stalkReg_and_global_const k C_bar hProjC hDimC hDimOpen
  letI : AlgebraicGeometry.IsProper C_bar.hom := hPropC
  have hChart : WeilCurveDivisorAndAffineChartHolds k C_bar :=
    (weil_curve_dvr_principal_divisor_and_affine_chart k C_bar hProjC).1
  obtain ⟨deg_Cl, _, _, hdeg_sum, _, _⟩ :=
    weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj k C_bar hProjC
  letI : Nonempty ↥U_C.toScheme := hNe_U
  letI : AlgebraicGeometry.IsIntegral U_C.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_C.ι
  letI : AlgebraicGeometry.IsAffine U_C.toScheme := hAff_U
  obtain ⟨hFin_compl, hNe_compl, hCl_compl, A, I, hAddA, hAddI, φ, i_A, p_I, j_I, q_U,
      hφ_surj, hφ_div, hi_A, hp_I, hEx_AEI, hj_I, hq_U, hEx_ICC⟩ :=
    weil_affine_curve_open_divisor_unit_picard_presentation k C_bar hDimC hDimOpen hChart
      deg_Cl hdeg_sum k_to_K hk_compat hStalkReg hGlobalConst U_C hAff_U hNe_U hProper_U
  letI : AddCommGroup A := hAddA
  letI : AddCommGroup I := hAddI

  
  haveI : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
  haveI : ConnectedSpace ↥X := IrreducibleSpace.connectedSpace ↥X
  obtain ⟨hEnd_one, _, hLocConst⟩ :=
    weil_etale_connected_unit_end_and_geom_point_lift X ℓ hPrime.one_lt.le
  have hPos_ClTors : 0 < Nat.card { c : weilCurveClGroup X // ℓ • c = 0 } :=
    @Nat.card_pos { c : weilCurveClGroup X // ℓ • c = 0 } ⟨⟨0, smul_zero ℓ⟩⟩ hFin1_C
  have hFin_Mod1 : Finite (weilCupPDModH X ℓ 1) :=
    Nat.finite_of_card_ne_zero (by rw [hCard1_C]; exact Nat.ne_of_gt hPos_ClTors)
  have hOpen_Uet : AlgebraicGeometry.IsOpenImmersion
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj U_et).hom := by
    rw [← he_U]
    infer_instance
  have hRange_Uet : Set.range (((AlgebraicGeometry.Scheme.Etale.forget X).obj U_et).hom).base =
      (U_C : Set ↥X) := by
    rw [← he_U]
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact (e_U.hom.base w).2
    · intro hx
      refine ⟨e_U.inv.base ⟨x, hx⟩, ?_⟩
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      have hid : e_U.hom.base (e_U.inv.base ⟨x, hx⟩) = (⟨x, hx⟩ : ↥U_C.toScheme) := by
        change (e_U.inv ≫ e_U.hom).base ⟨x, hx⟩ = ⟨x, hx⟩
        rw [e_U.inv_hom_id]
        rfl
      rw [hid]
      rfl
  obtain ⟨hFin_LocMod1, hCard_LocMod1⟩ :=
    weil_etale_algClosed_open_compl_finite_closedPts_localModH_card k ℓ C_bar
      hEnd_one hLocConst hFin_Mod1 U_C U_et hOpen_Uet hRange_Uet hFin_compl hNe_compl hCl_compl

  
  let U_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (U_C.ι ≫ C_bar.hom)
  letI : Nonempty ↥U_ov.left := hNe_U
  haveI : AlgebraicGeometry.IsAffine U_ov.left := hAff_U
  haveI : AlgebraicGeometry.IsIntegral U_ov.left :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion U_C.ι
  haveI : CompactSpace ↥U_ov.left := inferInstance
  haveI : U_ov.left.IsSeparated := inferInstance
  have hSm_Uov : AlgebraicGeometry.SmoothOfRelativeDimension 1 U_ov.hom := by
    have h01 : AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (U_C.ι ≫ C_bar.hom) :=
      inferInstance
    simpa [U_ov] using h01
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 U_ov.hom := hSm_Uov

  obtain ⟨hGmSheaf, _⟩ := weil_etale_gm_isSheaf_and_proj_H0_divisible
  obtain ⟨hKSheaf, Div_sh, ι_gm, div_mor, h0_div, _, hSE_div, _, _, ⟨e_Cl_U⟩⟩ :=
    weil_etale_curve_weil_divisor_short_exact k U_ov hGmSheaf

  have hSub_K1 : Subsingleton ((weilEtaleKSheaf U_ov.left).H 1) := by
    apply weil_etale_qc_sep_cech_vanishing_implies_H_subsingleton U_ov.left
      (weilEtaleKSheaf U_ov.left) _ 1 le_rfl
    intro V W _ _ _ w _ p c hc
    let isoK : weilEtaleKPresheaf U_ov.left ≅ (weilEtaleKSheaf U_ov.left).obj :=
      CategoryTheory.isoSheafify U_ov.left.smallEtaleTopology hKSheaf
    have hDiffInv : ∀ (m : ℕ)
        (x : ↥((weilEtaleKSheaf U_ov.left).obj.obj (Opposite.op (weilEtaleCechObj w m)))),
        (isoK.inv.app (Opposite.op (weilEtaleCechObj w (m + 1)))).hom
          (weilEtaleCechDiff (weilEtaleKSheaf U_ov.left).obj w m x) =
        weilEtaleCechDiff (weilEtaleKPresheaf U_ov.left) w m
          ((isoK.inv.app (Opposite.op (weilEtaleCechObj w m))).hom x) := by
      intro m x
      dsimp [weilEtaleCechDiff]
      rw [AddMonoidHom.finsetSum_apply, AddMonoidHom.finsetSum_apply, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [AddMonoidHom.smul_apply, AddMonoidHom.smul_apply, map_zsmul]
      congr 1
      have hnat := isoK.inv.naturality (weilEtaleCechFace w m j).op
      exact congrArg (fun ψ => ψ.hom x) hnat
    have hDiffHom : ∀ (m : ℕ)
        (x : ↥((weilEtaleKPresheaf U_ov.left).obj (Opposite.op (weilEtaleCechObj w m)))),
        (isoK.hom.app (Opposite.op (weilEtaleCechObj w (m + 1)))).hom
          (weilEtaleCechDiff (weilEtaleKPresheaf U_ov.left) w m x) =
        weilEtaleCechDiff (weilEtaleKSheaf U_ov.left).obj w m
          ((isoK.hom.app (Opposite.op (weilEtaleCechObj w m))).hom x) := by
      intro m x
      dsimp [weilEtaleCechDiff]
      rw [AddMonoidHom.finsetSum_apply, AddMonoidHom.finsetSum_apply, map_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [AddMonoidHom.smul_apply, AddMonoidHom.smul_apply, map_zsmul]
      congr 1
      have hnat := isoK.hom.naturality (weilEtaleCechFace w m j).op
      exact congrArg (fun ψ => ψ.hom x) hnat
    let c₀ := (isoK.inv.app (Opposite.op (weilEtaleCechObj w (p + 1)))).hom c
    have hc₀ : weilEtaleCechDiff (weilEtaleKPresheaf U_ov.left) w (p + 1) c₀ = 0 := by
      rw [← hDiffInv (p + 1) c, hc, map_zero]
    obtain ⟨b₀, hb₀⟩ :=
      weil_etale_curve_generic_gm_cech_vanishing k U_ov
        (fun E L _ _ _ _ _ _ _ n hn =>
          weil_tsen_c1_galois_units_cohomology_vanishing k E L n hn)
        V W w p c₀ hc₀
    refine ⟨(isoK.hom.app (Opposite.op (weilEtaleCechObj w p))).hom b₀, ?_⟩
    rw [← hDiffHom p b₀, hb₀]
    exact congrArg (fun ψ => ψ.hom c)
      (isoK.inv_hom_id_app (Opposite.op (weilEtaleCechObj w (p + 1))))

  let J_U := U_ov.left.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_U := (CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}).obj Aℤ
  let Gm_U := weilEtaleGmSheaf U_ov.left
  let G_U := Additive (Units ↑(U_C.toScheme.presheaf.obj (Opposite.op ⊤)))

  
  let SC_div := CategoryTheory.ShortComplex.mk ι_gm div_mor h0_div
  let δ_div : Div_sh.H 0 →+ Gm_U.H 1 := hSE_div.extClass.postcomp Fℤ_U (rfl : 0 + 1 = 1)
  let p0_div : (weilEtaleKSheaf U_ov.left).H 0 →+ Div_sh.H 0 :=
    (CategoryTheory.Abelian.Ext.mk₀ div_mor).postcomp Fℤ_U (Nat.add_zero 0)
  have hδ_div_surj : Function.Surjective δ_div := by
    intro a
    have ha0 : a.comp (CategoryTheory.Abelian.Ext.mk₀ SC_div.f) (Nat.add_zero 1) = 0 :=
      @Subsingleton.elim _ hSub_K1 _ 0
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_U hSE_div a ha0 (rfl : 0 + 1 = 1)
  have hker_div : δ_div.ker = p0_div.range := by
    ext d
    simp only [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hd
      exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_U hSE_div d (rfl : 0 + 1 = 1) hd
    · rintro ⟨y, rfl⟩
      change (y.comp (CategoryTheory.Abelian.Ext.mk₀ SC_div.g) (Nat.add_zero 0)).comp
        hSE_div.extClass (rfl : 0 + 1 = 1) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc y (CategoryTheory.Abelian.Ext.mk₀ SC_div.g)
        hSE_div.extClass (Nat.add_zero 0) (Nat.zero_add 1) (rfl : 0 + 1 = 1),
        hSE_div.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
  let e_Gm1 : Gm_U.H 1 ≃+ weilCurveClGroup U_C.toScheme :=
    ((QuotientAddGroup.quotientKerEquivOfSurjective δ_div hδ_div_surj).symm.trans
      (QuotientAddGroup.quotientAddEquivOfEq hker_div)).trans e_Cl_U

  
  let T_U : U_ov.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id U_ov.left) inferInstance
  have hT_U : CategoryTheory.Limits.IsTerminal T_U :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun W => CategoryTheory.MorphismProperty.Over.homMk W.hom
        (CategoryTheory.Category.comp_id W.hom) trivial)
      (fun W g => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id g.left).symm.trans
          (CategoryTheory.MorphismProperty.Over.w g)))
  let adj_U := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT_U
  let isoGm : weilEtaleGmPresheaf U_ov.left ≅ Gm_U.obj :=
    CategoryTheory.isoSheafify J_U (hGmSheaf U_ov.left)
  let EV_U : CategoryTheory.Sheaf J_U AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
    CategoryTheory.sheafToPresheaf J_U AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (Opposite U_ov.left.Etale) AddCommGrpCat.{u}).obj
        (Opposite.op T_U)
  let toG : (Fℤ_U ⟶ Gm_U) → G_U := fun f =>
    (isoGm.inv.app (Opposite.op T_U)).hom ((adj_U.homEquiv Aℤ Gm_U f).hom (ULift.up 1))
  let fromG : G_U → (Fℤ_U ⟶ Gm_U) := fun g =>
    (adj_U.homEquiv Aℤ Gm_U).symm
      ((AddCommGrpCat.ofHom
        { toFun := fun z : ULift.{u} ℤ => z.down • g
          map_zero' := zero_zsmul g
          map_add' := fun a b => add_zsmul g a.down b.down }) ≫
        isoGm.hom.app (Opposite.op T_U))
  have h_rightG : Function.RightInverse fromG toG := by
    intro g
    dsimp [toG, fromG]
    rw [Equiv.apply_symm_apply]
    let φ_g : Aℤ ⟶ (weilEtaleGmPresheaf U_ov.left).obj (Opposite.op T_U) :=
      AddCommGrpCat.ofHom
        { toFun := fun z : ULift.{u} ℤ => z.down • g
          map_zero' := zero_zsmul g
          map_add' := fun a b => add_zsmul g a.down b.down }
    have h1 : (φ_g ≫ isoGm.hom.app (Opposite.op T_U)) ≫ isoGm.inv.app (Opposite.op T_U) = φ_g :=
      (CategoryTheory.Category.assoc φ_g (isoGm.hom.app (Opposite.op T_U))
        (isoGm.inv.app (Opposite.op T_U))).trans
        ((congrArg (φ_g ≫ ·) (isoGm.hom_inv_id_app (Opposite.op T_U))).trans
          (CategoryTheory.Category.comp_id φ_g))
    exact (congrArg (fun ψ => ψ.hom (ULift.up 1)) h1).trans (one_zsmul g)
  have h_leftG : Function.LeftInverse fromG toG := by
    intro f
    apply (adj_U.homEquiv Aℤ Gm_U).injective
    dsimp [fromG]
    rw [Equiv.apply_symm_apply]
    let h : Aℤ ⟶ Gm_U.obj.obj (Opposite.op T_U) := adj_U.homEquiv Aℤ Gm_U f
    let h₀ : Aℤ ⟶ (weilEtaleGmPresheaf U_ov.left).obj (Opposite.op T_U) :=
      h ≫ isoGm.inv.app (Opposite.op T_U)
    have hh₀ : (AddCommGrpCat.ofHom
        { toFun := fun z : ULift.{u} ℤ => z.down • toG f
          map_zero' := zero_zsmul (toG f)
          map_add' := fun a b => add_zsmul (toG f) a.down b.down } :
        Aℤ ⟶ (weilEtaleGmPresheaf U_ov.left).obj (Opposite.op T_U)) = h₀ := by
      apply AddCommGrpCat.ext
      intro z
      have hz : z = z.down • (ULift.up (1 : ℤ)) :=
        ULift.ext _ _ (by change z.down = z.down • (1 : ℤ); simp)
      change z.down • h₀.hom (ULift.up 1) = h₀.hom z
      conv_rhs => rw [hz]
      exact (map_zsmul h₀.hom z.down (ULift.up 1)).symm
    exact (congrArg (· ≫ isoGm.hom.app (Opposite.op T_U)) hh₀).trans
      ((CategoryTheory.Category.assoc h (isoGm.inv.app (Opposite.op T_U))
        (isoGm.hom.app (Opposite.op T_U))).trans
        ((congrArg (h ≫ ·) (isoGm.inv_hom_id_app (Opposite.op T_U))).trans
          (CategoryTheory.Category.comp_id h)))
  have h_addG : ∀ f₁ f₂ : Fℤ_U ⟶ Gm_U, toG (f₁ + f₂) = toG f₁ + toG f₂ := by
    intro f₁ f₂
    have heq : adj_U.homEquiv Aℤ Gm_U (f₁ + f₂) =
        adj_U.homEquiv Aℤ Gm_U f₁ + adj_U.homEquiv Aℤ Gm_U f₂ := by
      rw [adj_U.homEquiv_unit Aℤ Gm_U (f₁ + f₂), adj_U.homEquiv_unit Aℤ Gm_U f₁,
        adj_U.homEquiv_unit Aℤ Gm_U f₂]
      change adj_U.unit.app Aℤ ≫ EV_U.map (f₁ + f₂) =
        (adj_U.unit.app Aℤ ≫ EV_U.map f₁) + (adj_U.unit.app Aℤ ≫ EV_U.map f₂)
      rw [EV_U.map_add, CategoryTheory.Preadditive.comp_add]
    dsimp [toG]
    rw [heq]
    change (isoGm.inv.app (Opposite.op T_U)).hom
      ((adj_U.homEquiv Aℤ Gm_U f₁).hom (ULift.up 1) +
        (adj_U.homEquiv Aℤ Gm_U f₂).hom (ULift.up 1)) = _
    exact map_add (isoGm.inv.app (Opposite.op T_U)).hom _ _
  let e_Gm0 : Gm_U.H 0 ≃+ G_U :=
    CategoryTheory.Abelian.Ext.addEquiv₀.trans
      (AddEquiv.mk' (Equiv.mk toG fromG h_leftG h_rightG) h_addG)

  
  obtain ⟨_, ι_kum, p_kum, h0_kum, hp_kum, hSES_kum⟩ := hKum U_ov
  have hnsmul_gm : ∀ {q : ℕ} (n : ℕ) (u : Gm_U.H q),
      u.comp (CategoryTheory.Abelian.Ext.mk₀
        (n • CategoryTheory.CategoryStruct.id Gm_U)) (Nat.add_zero q) = n • u := by
    intro q n u
    induction n with
    | zero =>
      rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
        CategoryTheory.Abelian.Ext.comp_add, ih,
        CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul]
  have hp_post : ∀ {q : ℕ} (u : Gm_U.H q),
      u.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero q) = ℓ • u := by
    intro q u
    rw [hp_kum]
    exact hnsmul_gm ℓ u

  let R_G : AddSubgroup G_U := (zsmulAddGroupHom (ℓ : ℤ) : G_U →+ G_U).range
  let C_U := weilCurveClGroup U_C.toScheme
  let C_U_tors := ↥(AddMonoidHom.ker (zsmulAddGroupHom (ℓ : ℤ) : C_U →+ C_U))
  let H₁ := weilEtaleTorsionH U_C.toScheme ℓ 1

  let δ_kum_raw : G_U →+ H₁ :=
    (hSES_kum.extClass.postcomp Fℤ_U (rfl : 0 + 1 = 1)).comp e_Gm0.symm.toAddMonoidHom
  have hker_kum_raw : δ_kum_raw.ker = R_G := by
    ext g
    rw [AddMonoidHom.mem_ker]
    constructor
    · intro hg
      change (e_Gm0.symm g).comp hSES_kum.extClass (rfl : 0 + 1 = 1) = 0 at hg
      obtain ⟨v₀, hv₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_U hSES_kum
          (e_Gm0.symm g) (rfl : 0 + 1 = 1) hg
      change v₀.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero 0) =
        e_Gm0.symm g at hv₀
      rw [hp_post] at hv₀
      refine ⟨e_Gm0 v₀, ?_⟩
      change (ℓ : ℤ) • e_Gm0 v₀ = g
      rw [natCast_zsmul, ← map_nsmul, hv₀, e_Gm0.apply_symm_apply]
    · rintro ⟨g₀, rfl⟩
      change (e_Gm0.symm ((ℓ : ℤ) • g₀)).comp hSES_kum.extClass (rfl : 0 + 1 = 1) = 0
      rw [natCast_zsmul, map_nsmul, ← hp_post (e_Gm0.symm g₀),
        CategoryTheory.Abelian.Ext.comp_assoc (e_Gm0.symm g₀)
          (CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).g)
          hSES_kum.extClass (Nat.add_zero 0) (Nat.zero_add 1) (rfl : 0 + 1 = 1),
        hSES_kum.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
  let ι_H : (G_U ⧸ R_G) →+ H₁ :=
    QuotientAddGroup.lift R_G δ_kum_raw (le_of_eq hker_kum_raw.symm)
  have hι_H : Function.Injective ι_H := by
    rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro q hq
    obtain ⟨g, rfl⟩ := QuotientAddGroup.mk'_surjective R_G q
    rw [AddMonoidHom.mem_ker] at hq
    have hg : g ∈ δ_kum_raw.ker := hq
    rw [hker_kum_raw] at hg
    exact (QuotientAddGroup.eq_zero_iff g).mpr hg

  let π_H_raw : H₁ →+ C_U :=
    e_Gm1.toAddMonoidHom.comp
      ((CategoryTheory.Abelian.Ext.mk₀ ι_kum).postcomp Fℤ_U (Nat.add_zero 1))
  have hπ_H_tors : ∀ x : H₁, π_H_raw x ∈ AddMonoidHom.ker (zsmulAddGroupHom (ℓ : ℤ) : C_U →+ C_U) := by
    intro x
    rw [AddMonoidHom.mem_ker]
    change (ℓ : ℤ) • e_Gm1 (x.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1)) = 0
    rw [natCast_zsmul, ← map_nsmul, ← hp_post,
      CategoryTheory.Abelian.Ext.comp_assoc x
        (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (CategoryTheory.Abelian.Ext.mk₀ p_kum)
        (Nat.add_zero 1) (Nat.add_zero 0) (Nat.add_zero 1),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, h0_kum,
      CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero, map_zero]
  let π_H : H₁ →+ C_U_tors :=
    π_H_raw.codRestrict (AddMonoidHom.ker (zsmulAddGroupHom (ℓ : ℤ) : C_U →+ C_U)) hπ_H_tors
  have hπ_H : Function.Surjective π_H := by
    rintro ⟨c, hc⟩
    rw [AddMonoidHom.mem_ker] at hc
    change (ℓ : ℤ) • c = 0 at hc
    rw [natCast_zsmul] at hc
    let u₁ : Gm_U.H 1 := e_Gm1.symm c
    have hu₁ : u₁.comp (CategoryTheory.Abelian.Ext.mk₀
        (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).g) (Nat.add_zero 1) = 0 := by
      change u₁.comp (CategoryTheory.Abelian.Ext.mk₀ p_kum) (Nat.add_zero 1) = 0
      rw [hp_post]
      apply e_Gm1.injective
      rw [map_nsmul, map_zero, e_Gm1.apply_symm_apply]
      exact hc
    obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_U hSES_kum u₁ hu₁
    refine ⟨x, Subtype.ext ?_⟩
    change e_Gm1 (x.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1)) = c
    rw [hx]
    exact e_Gm1.apply_symm_apply c
  have hEx_H : π_H.ker = ι_H.range := by
    ext x
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hx
      have hx' : e_Gm1 (x.comp (CategoryTheory.Abelian.Ext.mk₀ ι_kum) (Nat.add_zero 1)) = 0 :=
        congrArg Subtype.val hx
      have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).f) (Nat.add_zero 1) = 0 :=
        e_Gm1.injective (hx'.trans (map_zero e_Gm1).symm)
      obtain ⟨v₀, hv₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_U hSES_kum x hx0 (rfl : 0 + 1 = 1)
      refine ⟨QuotientAddGroup.mk' R_G (e_Gm0 v₀), ?_⟩
      change (e_Gm0.symm (e_Gm0 v₀)).comp hSES_kum.extClass (rfl : 0 + 1 = 1) = x
      rw [e_Gm0.symm_apply_apply]
      exact hv₀
    · rintro ⟨q, rfl⟩
      obtain ⟨g, rfl⟩ := QuotientAddGroup.mk'_surjective R_G q
      apply Subtype.ext
      change e_Gm1 (((e_Gm0.symm g).comp hSES_kum.extClass (rfl : 0 + 1 = 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).f) (Nat.add_zero 1)) = 0
      rw [CategoryTheory.Abelian.Ext.comp_assoc (e_Gm0.symm g) hSES_kum.extClass
        (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.ShortComplex.mk ι_kum p_kum h0_kum).f)
        (rfl : 0 + 1 = 1) (Nat.add_zero 1) (rfl : 0 + 1 = 1),
        hSES_kum.extClass_comp, CategoryTheory.Abelian.Ext.comp_zero, map_zero]

  
  have hCosetEquiv : ∀ (M : Type u) [AddCommGroup M] (S : AddSubgroup M),
      Nonempty (M ≃ (M ⧸ S) × ↥S) := by
    intro M _ S
    let sec : (M ⧸ S) → M := fun q => Classical.choose (QuotientAddGroup.mk'_surjective S q)
    have hsec : ∀ q : M ⧸ S, QuotientAddGroup.mk' S (sec q) = q :=
      fun q => Classical.choose_spec (QuotientAddGroup.mk'_surjective S q)
    refine ⟨{
      toFun := fun m =>
        (QuotientAddGroup.mk' S m,
         ⟨m - sec (QuotientAddGroup.mk' S m),
          (QuotientAddGroup.eq_zero_iff _).mp (by
            change QuotientAddGroup.mk' S (m - sec (QuotientAddGroup.mk' S m)) = 0
            rw [map_sub, hsec, sub_self])⟩)
      invFun := fun p => sec p.1 + p.2.1
      left_inv := fun m => by dsimp; abel
      right_inv := fun ⟨q, s, hs⟩ => by
        have hs0 : QuotientAddGroup.mk' S s = 0 := (QuotientAddGroup.eq_zero_iff s).mpr hs
        have hq : QuotientAddGroup.mk' S (sec q + s) = q := by
          rw [map_add, hsec q, hs0, add_zero]
        refine Prod.ext hq (Subtype.ext ?_)
        change sec q + s - sec (QuotientAddGroup.mk' S (sec q + s)) = s
        rw [hq]
        abel
    }⟩

  let d : ℕ := Nat.card ↥((U_C : Set ↥X)ᶜ) - 1
  let E := Fin d → ℤ
  let C₀ := ↥deg_Cl.ker
  let C₀_tors := ↥(AddMonoidHom.ker (zsmulAddGroupHom (ℓ : ℤ) : C₀ →+ C₀))
  let I_tors := ↥(AddMonoidHom.ker (zsmulAddGroupHom (ℓ : ℤ) : I →+ I))
  let R_A : AddSubgroup A := (zsmulAddGroupHom (ℓ : ℤ) : A →+ A).range
  let R_E : AddSubgroup E := (zsmulAddGroupHom (ℓ : ℤ) : E →+ E).range
  let R_I : AddSubgroup I := (zsmulAddGroupHom (ℓ : ℤ) : I →+ I).range

  
  have hdeg_of_tors : ∀ c : weilCurveClGroup X, ℓ • c = 0 → deg_Cl c = 0 := by
    intro c hc
    have h1 : ℓ • deg_Cl c = 0 := by rw [← map_nsmul, hc, map_zero]
    rw [nsmul_eq_mul] at h1
    rcases mul_eq_zero.mp h1 with h0 | h0
    · exact absurd (Int.ofNat_eq_zero.mp h0) hPrime.ne_zero
    · exact h0
  let e_C0_tors : C₀_tors ≃ { c : weilCurveClGroup X // ℓ • c = 0 } :=
    { toFun := fun x =>
        ⟨x.1.1, by
          have hx : (ℓ : ℤ) • x.1 = 0 := x.2
          have hx1 : (ℓ : ℤ) • x.1.1 = 0 := congrArg Subtype.val hx
          rwa [natCast_zsmul] at hx1⟩
      invFun := fun y =>
        ⟨⟨y.1, hdeg_of_tors y.1 y.2⟩,
         Subtype.ext (by change (ℓ : ℤ) • y.1 = 0; rw [natCast_zsmul]; exact y.2)⟩
      left_inv := fun _ => Subtype.ext (Subtype.ext rfl)
      right_inv := fun _ => Subtype.ext rfl }
  have hFin_C0_tors : Finite C₀_tors := @Finite.of_equiv _ _ hFin1_C e_C0_tors.symm
  have hCard_C0_tors : Nat.card C₀_tors = Nat.card { c : weilCurveClGroup X // ℓ • c = 0 } :=
    Nat.card_congr e_C0_tors
  have hDiv_C0 : ∀ c : C₀, ∃ y : C₀, (ℓ : ℤ) • y = c := by
    intro c
    obtain ⟨y, hy_deg, hy_mul⟩ := hDiv_Cl0 deg_Cl hdeg_sum c.1 c.2
    refine ⟨⟨y, hy_deg⟩, Subtype.ext ?_⟩
    change (ℓ : ℤ) • y = c.1
    rwa [natCast_zsmul]

  
  let φ_bar : G_U →+ (A ⧸ R_A) := (QuotientAddGroup.mk' R_A).comp φ
  have hsurj_φbar : Function.Surjective φ_bar :=
    (QuotientAddGroup.mk'_surjective R_A).comp hφ_surj
  have hker_φbar : φ_bar.ker = R_G := by
    ext g
    rw [AddMonoidHom.mem_ker]
    constructor
    · intro hg
      have hmem : φ g ∈ R_A := (QuotientAddGroup.eq_zero_iff (φ g)).mp hg
      obtain ⟨a, ha⟩ := hmem
      change (ℓ : ℤ) • a = φ g at ha
      obtain ⟨h, rfl⟩ := hφ_surj a
      have hker0 : φ (g - (ℓ : ℤ) • h) = 0 := by
        rw [map_sub, map_zsmul, ha, sub_self]
      obtain ⟨g₀, hg₀⟩ := hφ_div (g - (ℓ : ℤ) • h) hker0 ℓ hPrime.one_lt.le
      refine ⟨h + g₀, ?_⟩
      change (ℓ : ℤ) • (h + g₀) = g
      rw [zsmul_add, hg₀]
      abel
    · rintro ⟨g₀, rfl⟩
      change QuotientAddGroup.mk' R_A (φ ((ℓ : ℤ) • g₀)) = 0
      rw [map_zsmul]
      exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨φ g₀, rfl⟩
  let e_GA : (G_U ⧸ R_G) ≃+ (A ⧸ R_A) :=
    (QuotientAddGroup.quotientAddEquivOfEq hker_φbar.symm).trans
      (QuotientAddGroup.quotientKerEquivOfSurjective φ_bar hsurj_φbar)

  
  have hE_tf : ∀ e : E, (ℓ : ℤ) • e = 0 → e = 0 := by
    intro e he
    ext j
    have hj : (ℓ : ℤ) • (e j) = 0 := congrFun he j
    rw [zsmul_eq_mul] at hj
    rcases mul_eq_zero.mp hj with h0 | h0
    · exact absurd (Int.ofNat_eq_zero.mp h0) hPrime.ne_zero
    · exact h0
  let mod_E : E →+ (Fin d → ZMod ℓ) :=
    AddMonoidHom.mk' (fun v j => (v j : ZMod ℓ))
      (fun u v => by ext j; exact Int.cast_add (u j) (v j))
  have hsurj_modE : Function.Surjective mod_E := by
    intro w
    refine ⟨fun j => ((w j).val : ℤ), ?_⟩
    ext j
    change (((w j).val : ℤ) : ZMod ℓ) = w j
    rw [Int.cast_natCast, ZMod.natCast_zmod_val]
  have hker_modE : mod_E.ker = R_E := by
    ext v
    rw [AddMonoidHom.mem_ker]
    constructor
    · intro hv
      have hdvd : ∀ j : Fin d, (ℓ : ℤ) ∣ v j := by
        intro j
        have hj : (v j : ZMod ℓ) = 0 := congrFun hv j
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd (v j) ℓ).mp hj
      refine ⟨fun j => Classical.choose (hdvd j), ?_⟩
      ext j
      change (ℓ : ℤ) * Classical.choose (hdvd j) = v j
      exact (Classical.choose_spec (hdvd j)).symm
    · rintro ⟨u, rfl⟩
      ext j
      change (((ℓ : ℤ) * u j : ℤ) : ZMod ℓ) = 0
      rw [Int.cast_mul, Int.cast_natCast, CharP.cast_eq_zero (ZMod ℓ) ℓ, zero_mul]
  let e_EZ : (E ⧸ R_E) ≃+ (Fin d → ZMod ℓ) :=
    (QuotientAddGroup.quotientAddEquivOfEq hker_modE.symm).trans
      (QuotientAddGroup.quotientKerEquivOfSurjective mod_E hsurj_modE)
  have hFin_ER : Finite (E ⧸ R_E) := Finite.of_equiv (Fin d → ZMod ℓ) e_EZ.symm.toEquiv
  have hCard_ER : Nat.card (E ⧸ R_E) = ℓ ^ d := by
    rw [Nat.card_congr e_EZ.toEquiv, Nat.card_eq_fintype_card, Fintype.card_fun,
      Fintype.card_fin, ZMod.card]

  
  have hex_δ₂ : ∀ x : I_tors, ∃ (e : E) (a : A), p_I e = x.1 ∧ i_A a = (ℓ : ℤ) • e := by
    intro x
    obtain ⟨e, he⟩ := hp_I x.1
    have hp0 : p_I ((ℓ : ℤ) • e) = 0 := by
      rw [map_zsmul, he]
      exact x.2
    have hmem : (ℓ : ℤ) • e ∈ i_A.range := by
      rw [← hEx_AEI]
      exact hp0
    obtain ⟨a, ha⟩ := hmem
    exact ⟨e, a, he, ha⟩
  let δ₂_fn : I_tors → (A ⧸ R_A) := fun x =>
    QuotientAddGroup.mk' R_A (Classical.choose (Classical.choose_spec (hex_δ₂ x)))
  have hδ₂_spec : ∀ (x : I_tors) (e : E) (a : A),
      p_I e = x.1 → i_A a = (ℓ : ℤ) • e → δ₂_fn x = QuotientAddGroup.mk' R_A a := by
    intro x e a he ha
    let e₀ := Classical.choose (hex_δ₂ x)
    let a₀ := Classical.choose (Classical.choose_spec (hex_δ₂ x))
    obtain ⟨he₀, ha₀⟩ := Classical.choose_spec (Classical.choose_spec (hex_δ₂ x))
    change QuotientAddGroup.mk' R_A a₀ = QuotientAddGroup.mk' R_A a
    have hdiff_ker : e₀ - e ∈ p_I.ker := by
      rw [AddMonoidHom.mem_ker, map_sub, he₀, he, sub_self]
    rw [hEx_AEI] at hdiff_ker
    obtain ⟨b, hb⟩ := hdiff_ker
    have hi_diff : i_A (a₀ - a) = i_A ((ℓ : ℤ) • b) := by
      rw [map_sub, ha₀, ha, ← zsmul_sub, ← hb, map_zsmul]
    have ha_diff : a₀ - a = (ℓ : ℤ) • b := hi_A hi_diff
    have hneg : -a₀ + a = (ℓ : ℤ) • (-b) := by
      rw [zsmul_neg, ← ha_diff]
      abel
    exact QuotientAddGroup.eq.mpr ⟨-b, hneg.symm⟩
  let δ₂ : I_tors →+ (A ⧸ R_A) :=
    AddMonoidHom.mk' δ₂_fn (fun x₁ x₂ => by
      obtain ⟨e₁, a₁, he₁, ha₁⟩ := hex_δ₂ x₁
      obtain ⟨e₂, a₂, he₂, ha₂⟩ := hex_δ₂ x₂
      rw [hδ₂_spec x₁ e₁ a₁ he₁ ha₁, hδ₂_spec x₂ e₂ a₂ he₂ ha₂,
        hδ₂_spec (x₁ + x₂) (e₁ + e₂) (a₁ + a₂)
          (by rw [map_add, he₁, he₂]; rfl)
          (by rw [map_add, ha₁, ha₂, zsmul_add]),
        map_add])
  have hδ₂_inj : Function.Injective δ₂ := by
    rw [← AddMonoidHom.ker_eq_bot_iff, eq_bot_iff]
    intro x hx
    rw [AddMonoidHom.mem_ker] at hx
    obtain ⟨e, a, he, ha⟩ := hex_δ₂ x
    have hmk0 : QuotientAddGroup.mk' R_A a = 0 := (hδ₂_spec x e a he ha).symm.trans hx
    obtain ⟨a₁, ha₁⟩ := (QuotientAddGroup.eq_zero_iff a).mp hmk0
    change (ℓ : ℤ) • a₁ = a at ha₁
    have he_eq : e = i_A a₁ := by
      have htf0 : (ℓ : ℤ) • (e - i_A a₁) = 0 := by
        rw [zsmul_sub, ← ha, ← ha₁, map_zsmul, sub_self]
      exact sub_eq_zero.mp (hE_tf (e - i_A a₁) htf0)
    apply Subtype.ext
    change x.1 = 0
    rw [← he, he_eq]
    have hmem : i_A a₁ ∈ p_I.ker := by rw [hEx_AEI]; exact ⟨a₁, rfl⟩
    exact hmem

  let bar_iA : (A ⧸ R_A) →+ (E ⧸ R_E) :=
    QuotientAddGroup.map R_A R_E i_A (by
      rintro _ ⟨a, rfl⟩
      exact ⟨i_A a, (map_zsmul i_A (ℓ : ℤ) a).symm⟩)
  let bar_pI : (E ⧸ R_E) →+ (I ⧸ R_I) :=
    QuotientAddGroup.map R_E R_I p_I (by
      rintro _ ⟨e, rfl⟩
      exact ⟨p_I e, (map_zsmul p_I (ℓ : ℤ) e).symm⟩)
  have hsurj_bar_pI : Function.Surjective bar_pI := by
    intro q
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective R_I q
    obtain ⟨e, rfl⟩ := hp_I y
    exact ⟨QuotientAddGroup.mk' R_E e, rfl⟩
  have hker_bar_pI : bar_pI.ker = bar_iA.range := by
    ext q
    obtain ⟨e, rfl⟩ := QuotientAddGroup.mk'_surjective R_E q
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hq
      obtain ⟨y₀, hy₀⟩ := (QuotientAddGroup.eq_zero_iff (p_I e)).mp hq
      change (ℓ : ℤ) • y₀ = p_I e at hy₀
      obtain ⟨e₀, rfl⟩ := hp_I y₀
      have hmem : e - (ℓ : ℤ) • e₀ ∈ p_I.ker := by
        rw [AddMonoidHom.mem_ker, map_sub, map_zsmul, hy₀, sub_self]
      rw [hEx_AEI] at hmem
      obtain ⟨a, ha⟩ := hmem
      refine ⟨QuotientAddGroup.mk' R_A a, ?_⟩
      have hneg : -(i_A a) + e = (ℓ : ℤ) • e₀ := by
        rw [ha]
        abel
      exact QuotientAddGroup.eq.mpr ⟨e₀, hneg.symm⟩
    · rintro ⟨qa, hqa⟩
      obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective R_A qa
      have he_eq : QuotientAddGroup.mk' R_E e = QuotientAddGroup.mk' R_E (i_A a) := hqa.symm
      change bar_pI (QuotientAddGroup.mk' R_E e) = 0
      rw [he_eq]
      change QuotientAddGroup.mk' R_I (p_I (i_A a)) = 0
      have hp0 : p_I (i_A a) = 0 := by
        have hm : i_A a ∈ p_I.ker := by rw [hEx_AEI]; exact ⟨a, rfl⟩
        exact hm
      rw [hp0, map_zero]
  have hker_bar_iA : bar_iA.ker = δ₂.range := by
    ext qa
    obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective R_A qa
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro ha
      obtain ⟨e, he⟩ := (QuotientAddGroup.eq_zero_iff (i_A a)).mp ha
      change (ℓ : ℤ) • e = i_A a at he
      let x : I_tors := ⟨p_I e, by
        rw [AddMonoidHom.mem_ker]
        change (ℓ : ℤ) • p_I e = 0
        rw [← map_zsmul, he]
        have hm : i_A a ∈ p_I.ker := by rw [hEx_AEI]; exact ⟨a, rfl⟩
        exact hm⟩
      exact ⟨x, hδ₂_spec x e a rfl he.symm⟩
    · rintro ⟨x, hx⟩
      obtain ⟨e, a', he, ha'⟩ := hex_δ₂ x
      have hmk_eq : QuotientAddGroup.mk' R_A a' = QuotientAddGroup.mk' R_A a :=
        (hδ₂_spec x e a' he ha').symm.trans hx
      change bar_iA (QuotientAddGroup.mk' R_A a) = 0
      rw [← hmk_eq]
      change QuotientAddGroup.mk' R_E (i_A a') = 0
      rw [ha']
      exact (QuotientAddGroup.eq_zero_iff _).mpr ⟨e, rfl⟩

  let j_tors : I_tors →+ C₀_tors :=
    AddMonoidHom.mk'
      (fun y => ⟨j_I y.1, by
        rw [AddMonoidHom.mem_ker]
        change (ℓ : ℤ) • j_I y.1 = 0
        rw [← map_zsmul, show (ℓ : ℤ) • y.1 = 0 from y.2, map_zero]⟩)
      (fun y₁ y₂ => Subtype.ext (map_add j_I y₁.1 y₂.1))
  have hj_tors_inj : Function.Injective j_tors :=
    fun y₁ y₂ h => Subtype.ext (hj_I (congrArg Subtype.val h))
  have hFin_I_tors : Finite I_tors := @Finite.of_injective _ _ hFin_C0_tors j_tors hj_tors_inj

  let M₂ : AddSubgroup (E ⧸ R_E) := bar_iA.range
  have hFin_M₂ : Finite ↥M₂ := @Subtype.finite _ hFin_ER _
  let e_ER_IR : ((E ⧸ R_E) ⧸ bar_pI.ker) ≃+ (I ⧸ R_I) :=
    QuotientAddGroup.quotientKerEquivOfSurjective bar_pI hsurj_bar_pI
  have hFin_IR : Finite (I ⧸ R_I) :=
    @Finite.of_surjective _ _ hFin_ER bar_pI hsurj_bar_pI
  let sec_ER : ((E ⧸ R_E) ⧸ bar_pI.ker) → (E ⧸ R_E) :=
    fun q => Classical.choose (QuotientAddGroup.mk'_surjective bar_pI.ker q)
  have hsec_ER : ∀ q : (E ⧸ R_E) ⧸ bar_pI.ker,
      QuotientAddGroup.mk' bar_pI.ker (sec_ER q) = q :=
    fun q => Classical.choose_spec (QuotientAddGroup.mk'_surjective bar_pI.ker q)
  let e_cos_ER : (E ⧸ R_E) ≃ ((E ⧸ R_E) ⧸ bar_pI.ker) × ↥bar_pI.ker :=
    { toFun := fun m =>
        (QuotientAddGroup.mk' bar_pI.ker m,
         ⟨m - sec_ER (QuotientAddGroup.mk' bar_pI.ker m),
          (QuotientAddGroup.eq_zero_iff _).mp (by
            change QuotientAddGroup.mk' bar_pI.ker
              (m - sec_ER (QuotientAddGroup.mk' bar_pI.ker m)) = 0
            rw [map_sub, hsec_ER, sub_self])⟩)
      invFun := fun p => sec_ER p.1 + p.2.1
      left_inv := fun m => by dsimp; abel
      right_inv := fun ⟨q, s, hs⟩ => by
        have hs0 : QuotientAddGroup.mk' bar_pI.ker s = 0 :=
          (QuotientAddGroup.eq_zero_iff s).mpr hs
        have hq : QuotientAddGroup.mk' bar_pI.ker (sec_ER q + s) = q := by
          rw [map_add, hsec_ER q, hs0, add_zero]
        refine Prod.ext hq (Subtype.ext ?_)
        change sec_ER q + s - sec_ER (QuotientAddGroup.mk' bar_pI.ker (sec_ER q + s)) = s
        rw [hq]
        abel }
  have hCard_ER_split : ℓ ^ d = Nat.card (I ⧸ R_I) * Nat.card ↥M₂ := by
    calc
      ℓ ^ d = Nat.card (E ⧸ R_E) := hCard_ER.symm
      _ = Nat.card ((E ⧸ R_E) ⧸ bar_pI.ker) * Nat.card ↥bar_pI.ker :=
        (Nat.card_congr e_cos_ER).trans (Nat.card_prod _ _)
      _ = Nat.card (I ⧸ R_I) * Nat.card ↥M₂ := by
        rw [Nat.card_congr e_ER_IR.toEquiv, hker_bar_pI]

  let e_δ₂_rng : I_tors ≃ ↥bar_iA.ker :=
    (Equiv.ofBijective δ₂.rangeRestrict
      ⟨fun x y h => hδ₂_inj (congrArg Subtype.val h), δ₂.rangeRestrict_surjective⟩).trans
      { toFun := fun z => ⟨z.1, hker_bar_iA.symm ▸ z.2⟩
        invFun := fun z => ⟨z.1, hker_bar_iA ▸ z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
  have hFin_ker_bariA : Finite ↥bar_iA.ker := @Finite.of_equiv _ _ hFin_I_tors e_δ₂_rng
  let e_AR_M₂ : ((A ⧸ R_A) ⧸ bar_iA.ker) ≃+ ↥M₂ :=
    QuotientAddGroup.quotientKerEquivRange bar_iA
  have hFin_quot_AR : Finite ((A ⧸ R_A) ⧸ bar_iA.ker) :=
    @Finite.of_equiv _ _ hFin_M₂ e_AR_M₂.symm.toEquiv
  obtain ⟨e_cos_AR⟩ := hCosetEquiv (A ⧸ R_A) bar_iA.ker
  letI : Finite ((A ⧸ R_A) ⧸ bar_iA.ker) := hFin_quot_AR
  letI : Finite ↥bar_iA.ker := hFin_ker_bariA
  have hFin_AR : Finite (A ⧸ R_A) := Finite.of_equiv _ e_cos_AR.symm
  have hCard_AR_split : Nat.card (A ⧸ R_A) = Nat.card ↥M₂ * Nat.card I_tors := by
    calc
      Nat.card (A ⧸ R_A) = Nat.card ((A ⧸ R_A) ⧸ bar_iA.ker) * Nat.card ↥bar_iA.ker :=
        (Nat.card_congr e_cos_AR).trans (Nat.card_prod _ _)
      _ = Nat.card ↥M₂ * Nat.card I_tors := by
        rw [Nat.card_congr e_AR_M₂.toEquiv, Nat.card_congr e_δ₂_rng.symm]
  have hSnake1_eq : Nat.card (A ⧸ R_A) * Nat.card (I ⧸ R_I) = ℓ ^ d * Nat.card I_tors := by
    rw [hCard_AR_split, hCard_ER_split]
    ring

  
  have hex_δ₃ : ∀ u : C_U_tors, ∃ (c : C₀) (y : I), q_U c = u.1 ∧ j_I y = (ℓ : ℤ) • c := by
    intro u
    obtain ⟨c, hc⟩ := hq_U u.1
    have hq0 : q_U ((ℓ : ℤ) • c) = 0 := by
      rw [map_zsmul, hc]
      exact u.2
    have hmem : (ℓ : ℤ) • c ∈ j_I.range := by
      rw [← hEx_ICC]
      exact hq0
    obtain ⟨y, hy⟩ := hmem
    exact ⟨c, y, hc, hy⟩
  let δ₃_fn : C_U_tors → (I ⧸ R_I) := fun u =>
    QuotientAddGroup.mk' R_I (Classical.choose (Classical.choose_spec (hex_δ₃ u)))
  have hδ₃_spec : ∀ (u : C_U_tors) (c : C₀) (y : I),
      q_U c = u.1 → j_I y = (ℓ : ℤ) • c → δ₃_fn u = QuotientAddGroup.mk' R_I y := by
    intro u c y hc hy
    let c₀ := Classical.choose (hex_δ₃ u)
    let y₀ := Classical.choose (Classical.choose_spec (hex_δ₃ u))
    obtain ⟨hc₀, hy₀⟩ := Classical.choose_spec (Classical.choose_spec (hex_δ₃ u))
    change QuotientAddGroup.mk' R_I y₀ = QuotientAddGroup.mk' R_I y
    have hdiff_ker : c₀ - c ∈ q_U.ker := by
      rw [AddMonoidHom.mem_ker, map_sub, hc₀, hc, sub_self]
    rw [hEx_ICC] at hdiff_ker
    obtain ⟨w, hw⟩ := hdiff_ker
    have hj_diff : j_I (y₀ - y) = j_I ((ℓ : ℤ) • w) := by
      rw [map_sub, hy₀, hy, ← zsmul_sub, ← hw, map_zsmul]
    have hy_diff : y₀ - y = (ℓ : ℤ) • w := hj_I hj_diff
    have hneg : -y₀ + y = (ℓ : ℤ) • (-w) := by
      rw [zsmul_neg, ← hy_diff]
      abel
    exact QuotientAddGroup.eq.mpr ⟨-w, hneg.symm⟩
  let δ₃ : C_U_tors →+ (I ⧸ R_I) :=
    AddMonoidHom.mk' δ₃_fn (fun u₁ u₂ => by
      obtain ⟨c₁, y₁, hc₁, hy₁⟩ := hex_δ₃ u₁
      obtain ⟨c₂, y₂, hc₂, hy₂⟩ := hex_δ₃ u₂
      rw [hδ₃_spec u₁ c₁ y₁ hc₁ hy₁, hδ₃_spec u₂ c₂ y₂ hc₂ hy₂,
        hδ₃_spec (u₁ + u₂) (c₁ + c₂) (y₁ + y₂)
          (by rw [map_add, hc₁, hc₂]; rfl)
          (by rw [map_add, hy₁, hy₂, zsmul_add]),
        map_add])
  have hsurj_δ₃ : Function.Surjective δ₃ := by
    intro q
    obtain ⟨y, rfl⟩ := QuotientAddGroup.mk'_surjective R_I q
    obtain ⟨c, hc⟩ := hDiv_C0 (j_I y)
    let u : C_U_tors := ⟨q_U c, by
      rw [AddMonoidHom.mem_ker]
      change (ℓ : ℤ) • q_U c = 0
      rw [← map_zsmul, hc]
      have hm : j_I y ∈ q_U.ker := by rw [hEx_ICC]; exact ⟨y, rfl⟩
      exact hm⟩
    exact ⟨u, hδ₃_spec u c y rfl hc.symm⟩

  let q_tors : C₀_tors →+ C_U_tors :=
    AddMonoidHom.mk'
      (fun c => ⟨q_U c.1, by
        rw [AddMonoidHom.mem_ker]
        change (ℓ : ℤ) • q_U c.1 = 0
        rw [← map_zsmul, show (ℓ : ℤ) • c.1 = 0 from c.2, map_zero]⟩)
      (fun c₁ c₂ => Subtype.ext (map_add q_U c₁.1 c₂.1))
  have hker_qtors : q_tors.ker = j_tors.range := by
    ext c
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hc
      have hmem : c.1 ∈ q_U.ker := congrArg Subtype.val hc
      rw [hEx_ICC] at hmem
      obtain ⟨y, hy⟩ := hmem
      have hy_tors : y ∈ AddMonoidHom.ker (zsmulAddGroupHom (ℓ : ℤ) : I →+ I) := by
        rw [AddMonoidHom.mem_ker]
        apply hj_I
        rw [map_zero, show (zsmulAddGroupHom (ℓ : ℤ) y : I) = (ℓ : ℤ) • y from rfl,
          map_zsmul, hy]
        exact c.2
      exact ⟨⟨y, hy_tors⟩, Subtype.ext hy⟩
    · rintro ⟨y, rfl⟩
      apply Subtype.ext
      have hm : j_I y.1 ∈ q_U.ker := by rw [hEx_ICC]; exact ⟨y.1, rfl⟩
      exact hm
  have hker_δ₃ : δ₃.ker = q_tors.range := by
    ext u
    rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
    constructor
    · intro hu
      obtain ⟨c, y, hc, hy⟩ := hex_δ₃ u
      have hmk0 : QuotientAddGroup.mk' R_I y = 0 := (hδ₃_spec u c y hc hy).symm.trans hu
      obtain ⟨y₀, hy₀⟩ := (QuotientAddGroup.eq_zero_iff y).mp hmk0
      change (ℓ : ℤ) • y₀ = y at hy₀
      let c' : C₀ := c - j_I y₀
      have hc'_tors : c' ∈ AddMonoidHom.ker (zsmulAddGroupHom (ℓ : ℤ) : C₀ →+ C₀) := by
        rw [AddMonoidHom.mem_ker]
        change (ℓ : ℤ) • (c - j_I y₀) = 0
        rw [zsmul_sub, ← hy, ← map_zsmul, hy₀, sub_self]
      refine ⟨⟨c', hc'_tors⟩, Subtype.ext ?_⟩
      change q_U (c - j_I y₀) = u.1
      have hj0 : q_U (j_I y₀) = 0 := by
        have hm : j_I y₀ ∈ q_U.ker := by rw [hEx_ICC]; exact ⟨y₀, rfl⟩
        exact hm
      rw [map_sub, hj0, sub_zero, hc]
    · rintro ⟨c, rfl⟩
      exact hδ₃_spec (q_tors c) c.1 0 rfl
        (by rw [map_zero]; exact (show (ℓ : ℤ) • c.1 = 0 from c.2).symm)

  let M₃ : AddSubgroup C_U_tors := q_tors.range
  have hFin_M₃ : Finite ↥M₃ :=
    @Finite.of_surjective _ _ hFin_C0_tors q_tors.rangeRestrict q_tors.rangeRestrict_surjective
  let e_jtors_rng : I_tors ≃ ↥q_tors.ker :=
    (Equiv.ofBijective j_tors.rangeRestrict
      ⟨fun x y h => hj_tors_inj (congrArg Subtype.val h), j_tors.rangeRestrict_surjective⟩).trans
      { toFun := fun z => ⟨z.1, hker_qtors.symm ▸ z.2⟩
        invFun := fun z => ⟨z.1, hker_qtors ▸ z.2⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
  let e_C0_M₃ : (C₀_tors ⧸ q_tors.ker) ≃+ ↥M₃ :=
    QuotientAddGroup.quotientKerEquivRange q_tors
  obtain ⟨e_cos_C0⟩ := hCosetEquiv C₀_tors q_tors.ker
  have hCard_C0_split : Nat.card C₀_tors = Nat.card ↥M₃ * Nat.card I_tors := by
    calc
      Nat.card C₀_tors = Nat.card (C₀_tors ⧸ q_tors.ker) * Nat.card ↥q_tors.ker :=
        (Nat.card_congr e_cos_C0).trans (Nat.card_prod _ _)
      _ = Nat.card ↥M₃ * Nat.card I_tors := by
        rw [Nat.card_congr e_C0_M₃.toEquiv, Nat.card_congr e_jtors_rng.symm]

  let e_CU_IR : (C_U_tors ⧸ δ₃.ker) ≃+ (I ⧸ R_I) :=
    QuotientAddGroup.quotientKerEquivOfSurjective δ₃ hsurj_δ₃
  have hFin_quot_CU : Finite (C_U_tors ⧸ δ₃.ker) :=
    @Finite.of_equiv _ _ hFin_IR e_CU_IR.symm.toEquiv
  have hFin_ker_δ₃ : Finite ↥δ₃.ker := by
    rw [hker_δ₃]
    exact hFin_M₃
  obtain ⟨e_cos_CU⟩ := hCosetEquiv C_U_tors δ₃.ker
  letI : Finite (C_U_tors ⧸ δ₃.ker) := hFin_quot_CU
  letI : Finite ↥δ₃.ker := hFin_ker_δ₃
  have hFin_CU_tors : Finite C_U_tors := Finite.of_equiv _ e_cos_CU.symm
  have hCard_CU_split : Nat.card C_U_tors = Nat.card (I ⧸ R_I) * Nat.card ↥M₃ := by
    calc
      Nat.card C_U_tors = Nat.card (C_U_tors ⧸ δ₃.ker) * Nat.card ↥δ₃.ker :=
        (Nat.card_congr e_cos_CU).trans (Nat.card_prod _ _)
      _ = Nat.card (I ⧸ R_I) * Nat.card ↥M₃ := by
        rw [Nat.card_congr e_CU_IR.toEquiv, hker_δ₃]
  have hSnake2_eq : Nat.card C_U_tors * Nat.card I_tors =
      Nat.card (I ⧸ R_I) * Nat.card C₀_tors := by
    rw [hCard_CU_split, hCard_C0_split]
    ring

  
  let e_ιH_rng : (A ⧸ R_A) ≃ ↥π_H.ker :=
    e_GA.symm.toEquiv.trans
      ((Equiv.ofBijective ι_H.rangeRestrict
        ⟨fun x y h => hι_H (congrArg Subtype.val h), ι_H.rangeRestrict_surjective⟩).trans
        { toFun := fun z => ⟨z.1, hEx_H.symm ▸ z.2⟩
          invFun := fun z => ⟨z.1, hEx_H ▸ z.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl })
  have hFin_ker_πH : Finite ↥π_H.ker := @Finite.of_equiv _ _ hFin_AR e_ιH_rng
  let e_H1_CU : (H₁ ⧸ π_H.ker) ≃+ C_U_tors :=
    QuotientAddGroup.quotientKerEquivOfSurjective π_H hπ_H
  have hFin_quot_H1 : Finite (H₁ ⧸ π_H.ker) :=
    @Finite.of_equiv _ _ hFin_CU_tors e_H1_CU.symm.toEquiv
  obtain ⟨e_cos_H1⟩ := hCosetEquiv H₁ π_H.ker
  letI : Finite (H₁ ⧸ π_H.ker) := hFin_quot_H1
  letI : Finite ↥π_H.ker := hFin_ker_πH
  have hFin_H1 : Finite H₁ := Finite.of_equiv _ e_cos_H1.symm
  have hCard_H1_split : Nat.card H₁ = Nat.card C_U_tors * Nat.card (A ⧸ R_A) := by
    calc
      Nat.card H₁ = Nat.card (H₁ ⧸ π_H.ker) * Nat.card ↥π_H.ker :=
        (Nat.card_congr e_cos_H1).trans (Nat.card_prod _ _)
      _ = Nat.card C_U_tors * Nat.card (A ⧸ R_A) := by
        rw [Nat.card_congr e_H1_CU.toEquiv, Nat.card_congr e_ιH_rng.symm]

  have hPos_Itors : 0 < Nat.card I_tors := @Nat.card_pos I_tors ⟨0⟩ hFin_I_tors
  have hPos_IR : 0 < Nat.card (I ⧸ R_I) := @Nat.card_pos (I ⧸ R_I) ⟨0⟩ hFin_IR
  have hk_pos : 0 < Nat.card I_tors * Nat.card (I ⧸ R_I) := Nat.mul_pos hPos_Itors hPos_IR
  have hCard_H1 : Nat.card H₁ = ℓ ^ d * Nat.card C₀_tors := by
    apply Nat.mul_right_cancel hk_pos
    calc
      Nat.card H₁ * (Nat.card I_tors * Nat.card (I ⧸ R_I))
        = (Nat.card (A ⧸ R_A) * Nat.card (I ⧸ R_I)) * (Nat.card C_U_tors * Nat.card I_tors) := by
            rw [hCard_H1_split]
            ring
      _ = (ℓ ^ d * Nat.card I_tors) * (Nat.card (I ⧸ R_I) * Nat.card C₀_tors) := by
            rw [hSnake1_eq, hSnake2_eq]
      _ = (ℓ ^ d * Nat.card C₀_tors) * (Nat.card I_tors * Nat.card (I ⧸ R_I)) := by
            ring

  refine ⟨hFin_LocMod1, hFin_H1, ?_⟩
  rw [hCard_LocMod1, hCard1_C, hCard_H1, hCard_C0_tors]

theorem weil_etale_curve_open_generic_kummer_lift_and_trivialization (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (V_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral V_ov.left]
    [CompactSpace ↥V_ov.left] [V_ov.left.IsSeparated]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 V_ov.hom]
    (hDim_V : topologicalKrullDim V_ov.left = (1 : WithBot ℕ∞))
    (hKSheaf_V : CategoryTheory.Presheaf.IsSheaf V_ov.left.smallEtaleTopology
      (weilEtaleKPresheaf V_ov.left))
    (Q_sh : CategoryTheory.Sheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u})
    (j_kum : weilEtaleTorsionSheaf V_ov.left ℓ ⟶ weilEtaleKSheaf V_ov.left)
    (q_K : weilEtaleKSheaf V_ov.left ⟶ Q_sh)
    (i_Q : Q_sh ⟶ weilEtaleKSheaf V_ov.left)
    [CategoryTheory.Mono i_Q]
    (hfac_Q : CategoryTheory.CategoryStruct.comp q_K i_Q =
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleKSheaf V_ov.left))
    (h0_jq : CategoryTheory.CategoryStruct.comp j_kum q_K = 0)
    (hSE_jq : (CategoryTheory.ShortComplex.mk j_kum q_K h0_jq).ShortExact)
    (q_mor : (CategoryTheory.constantSheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ Q_sh)
    (s : weilEtaleTorsionH V_ov.left ℓ 1)
    (hq_s : (CategoryTheory.Abelian.Ext.mk₀ q_mor).comp hSE_jq.extClass (Nat.zero_add 1) = s)
    (hf_not_mul : ∀ g_mor :
        (CategoryTheory.constantSheaf V_ov.left.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.of (ULift.{u} ℤ)) ⟶ weilEtaleKSheaf V_ov.left,
      ℓ • g_mor ≠ CategoryTheory.CategoryStruct.comp q_mor i_Q)
    (hStalkDVR : (∀ x : { x : ↥V_ov.left // IsClosed ({x} : Set ↥V_ov.left) },
        StrictAnti (fun n : ℕ => IsLocalRing.maximalIdeal ↑(V_ov.left.presheaf.stalk x.1) ^ n)) ∧
      (∀ (U : V_ov.left.Etale)
          (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥V_ov.left) }),
        ∃ hDom : IsDomain ↑(U.left.presheaf.stalk y.1),
          @IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) _ hDom) ∧
      (∀ {U₁ U₂ : V_ov.left.Etale} (g : U₁ ⟶ U₂)
          (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥V_ov.left) }),
        let y₂ : { y : ↥U₂.left // IsClosed ({U₂.hom.base y} : Set ↥V_ov.left) } :=
          ⟨g.left.base y₁.1, by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w g]
            exact y₁.2⟩
        Function.Injective (g.left.stalkMap y₁.1).hom ∧
        ∀ n : ℕ,
          Ideal.map (g.left.stalkMap y₁.1).hom
            (IsLocalRing.maximalIdeal ↑(U₂.left.presheaf.stalk y₂.1) ^ n) =
          IsLocalRing.maximalIdeal ↑(U₁.left.presheaf.stalk y₁.1) ^ n) ∧
      (∀ (U : V_ov.left.Etale) (u₀ : ↥U.left),
        ∃ (W₀ : V_ov.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W₀)
          (V₀ : U.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V₀) (_ : u₀ ∈ V₀)
          (e : V₀ ≤ (TopologicalSpace.Opens.map U.hom.base).obj W₀),
          IsDomain ↑(U.left.presheaf.obj (Opposite.op V₀)) ∧
          Function.Injective (U.hom.appLE W₀ V₀ e).hom)) :
    ∃ (s_f : ↥((weilEtaleKPresheaf V_ov.left).obj
        (Opposite.op (weilEtaleIdTerminal.{u} V_ov.left))))
      (f : Units ↑V_ov.left.functionField),
      (∀ g : Units ↑V_ov.left.functionField, g ^ ℓ ≠ f) ∧
      (∀ x : { x : ↥V_ov.left // IsClosed ({x} : Set ↥V_ov.left) },
        ∃ (u_x : Units ↑(V_ov.left.presheaf.stalk x.1))
          (g_x : Units ↑V_ov.left.functionField),
          (f : ↑V_ov.left.functionField) =
            algebraMap ↑(V_ov.left.presheaf.stalk x.1) ↑V_ov.left.functionField
              (u_x : ↑(V_ov.left.presheaf.stalk x.1)) *
              (g_x : ↑V_ov.left.functionField) ^ ℓ) ∧
      (let η_V := V_ov.left.fromSpecStalk (genericPoint ↥V_ov.left)
       let π_gen :=
         ((CategoryTheory.Over.pullback η_V).obj
           ((AlgebraicGeometry.Scheme.Etale.forget V_ov.left).obj
             (weilEtaleIdTerminal.{u} V_ov.left))).hom
       Additive.ofMul (Units.map
         ((AlgebraicGeometry.Scheme.ΓSpecIso
           (V_ov.left.presheaf.stalk (genericPoint ↥V_ov.left))).inv ≫
           π_gen.appTop).hom.toMonoidHom f) = s_f) ∧
      (∀ (V'_sch : AlgebraicGeometry.Scheme.{u})
         (p : V'_sch ⟶ V_ov.left) (hp_et : AlgebraicGeometry.Etale p),
        let U_p : V_ov.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ p hp_et
        let j_p : U_p ⟶ weilEtaleIdTerminal.{u} V_ov.left :=
          CategoryTheory.MorphismProperty.Over.homMk p (CategoryTheory.Category.comp_id p) trivial
        (∃ w_K : ↥((weilEtaleKPresheaf V_ov.left).obj (Opposite.op U_p)),
          ℓ • w_K = ((weilEtaleKPresheaf V_ov.left).map j_p.op).hom s_f) →
        ∀ (p₁ : weilEtaleTorsionH V_ov.left ℓ 1 →+ weilEtaleTorsionH V'_sch ℓ 1),
          WeilIsTorsionEtalePullback p ℓ 1 p₁ →
          p₁ s = 0) :=
by
  classical
  have _ := And.intro hℓ hDim_V
  let V₀ : AlgebraicGeometry.Scheme.{u} := V_ov.left
  let J := V₀.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let K_pre := weilEtaleKPresheaf V₀
  let K_sh := weilEtaleKSheaf V₀
  let Fℤ_V := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
  let T_V := weilEtaleIdTerminal.{u} V₀
  let hT_V := weilEtaleIdTerminalIsTerminal.{u} V₀
  let adj_TV := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_V
  let isoK : K_pre ≅ K_sh.obj := CategoryTheory.isoSheafify J hKSheaf_V
  have : CategoryTheory.Epi q_K := hSE_jq.epi_g
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have h_hom_nsmul :
      ∀ {M₁ M₂ : AddCommGrpCat.{u}} (n : ℕ) (φ : M₁ ⟶ M₂) (x : M₁),
        (n • φ).hom x = n • φ.hom x := by
    intro M₁ M₂ n φ x
    induction n with
    | zero => simp
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih]

  have h_sheaf_nsmul_app :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        {F₁ F₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (n : ℕ) (α : F₁ ⟶ F₂) (W : Opposite S.Etale),
        (n • α).hom.app W = n • (α.hom.app W) := by
    intro S F₁ F₂ n α W
    let EV : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj W
    change EV.map (n • α) = n • EV.map α
    exact EV.map_nsmul

  have h_Aℤ_hom_ext :
      ∀ {M : AddCommGrpCat.{u}} (φ₁ φ₂ : Aℤ ⟶ M),
        φ₁.hom (ULift.up (1 : ℤ)) = φ₂.hom (ULift.up (1 : ℤ)) → φ₁ = φ₂ := by
    intro M φ₁ φ₂ h1
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro u
    have hu : u = u.down • ULift.up (1 : ℤ) := by
      ext
      change u.down = u.down • (1 : ℤ)
      simp
    rw [hu, map_zsmul, map_zsmul, h1]

  have h_constAdj_nsmul :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {T : S.Etale}
        (hT : CategoryTheory.Limits.IsTerminal T)
        {F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (n : ℕ) (h : (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ ⟶ F),
        ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT).homEquiv Aℤ F)
          (n • h) =
        n • ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT).homEquiv Aℤ F) h := by
    intro S T hT F n h
    let adj_c := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    change adj_c.unit.app Aℤ ≫ (n • h).hom.app (Opposite.op T) =
      n • (adj_c.unit.app Aℤ ≫ h.hom.app (Opposite.op T))
    rw [h_sheaf_nsmul_app n h (Opposite.op T), CategoryTheory.Preadditive.comp_nsmul]

  
  
  
  let z_f : ↥(K_sh.obj.obj (Opposite.op T_V)) :=
    ((adj_TV.homEquiv Aℤ K_sh) (q_mor ≫ i_Q)).hom (ULift.up (1 : ℤ))
  let s_f : ↥(K_pre.obj (Opposite.op T_V)) :=
    (isoK.inv.app (Opposite.op T_V)).hom z_f
  have hs_f_hom : (isoK.hom.app (Opposite.op T_V)).hom s_f = z_f := by
    change (isoK.inv.app (Opposite.op T_V) ≫ isoK.hom.app (Opposite.op T_V)).hom z_f = z_f
    rw [isoK.inv_hom_id_app]
    rfl

  have hs_not_mul : ∀ s_g : ↥(K_pre.obj (Opposite.op T_V)), ℓ • s_g ≠ s_f := by
    intro s_g hsg
    let z_g : ↥(K_sh.obj.obj (Opposite.op T_V)) := (isoK.hom.app (Opposite.op T_V)).hom s_g
    have hzg : ℓ • z_g = z_f := by
      dsimp [z_g]
      rw [← map_nsmul, hsg, hs_f_hom]
    let φ_g : Aℤ ⟶ K_sh.obj.obj (Opposite.op T_V) :=
      AddCommGrpCat.ofHom
        { toFun := fun u => u.down • z_g
          map_zero' := zero_zsmul z_g
          map_add' := fun u₁ u₂ => add_zsmul z_g u₁.down u₂.down }
    let g_mor : Fℤ_V ⟶ K_sh := (adj_TV.homEquiv Aℤ K_sh).symm φ_g
    apply hf_not_mul g_mor
    apply (adj_TV.homEquiv Aℤ K_sh).injective
    rw [h_constAdj_nsmul hT_V ℓ g_mor, Equiv.apply_symm_apply]
    apply h_Aℤ_hom_ext
    rw [h_hom_nsmul]
    change ℓ • ((1 : ℤ) • z_g) = z_f
    rwa [one_zsmul]

  let imgSieve : ∀ (U : V₀.Etale), ↥(Q_sh.obj.obj (Opposite.op U)) → CategoryTheory.Sieve U :=
    fun U z =>
      { arrows := fun {V} f =>
          ∃ t : ↥(K_sh.obj.obj (Opposite.op V)),
            (q_K.hom.app (Opposite.op V)).hom t = (Q_sh.obj.map f.op).hom z
        downward_closed := by
          intro V W f ⟨t, ht⟩ g
          refine ⟨(K_sh.obj.map g.op).hom t, ?_⟩
          have hnat := congrArg (fun ψ => ψ.hom t) (q_K.hom.naturality g.op)
          change (q_K.hom.app (Opposite.op W)).hom ((K_sh.obj.map g.op).hom t) =
            (Q_sh.obj.map g.op).hom ((q_K.hom.app (Opposite.op V)).hom t) at hnat
          rw [hnat, ht, op_comp, CategoryTheory.Functor.map_comp]
          rfl }

  let S_sub : ∀ (U : V₀.Etale), AddSubgroup ↥(Q_sh.obj.obj (Opposite.op U)) :=
    fun U =>
      { carrier := { z | imgSieve U z ∈ J U }
        zero_mem' := by
          have htop : imgSieve U 0 = ⊤ := by
            ext V f
            simp only [CategoryTheory.Sieve.top_apply, iff_true]
            exact ⟨0, by simp⟩
          change imgSieve U 0 ∈ J U
          rw [htop]
          exact J.top_mem U
        add_mem' := by
          intro z₁ z₂ hz₁ hz₂
          refine J.superset_covering ?_ (J.intersection_covering hz₁ hz₂)
          intro V f ⟨⟨t₁, ht₁⟩, ⟨t₂, ht₂⟩⟩
          exact ⟨t₁ + t₂, by rw [map_add, map_add, ht₁, ht₂]⟩
        neg_mem' := by
          intro z hz
          refine J.superset_covering ?_ hz
          intro V f ⟨t, ht⟩
          exact ⟨-t, by rw [map_neg, map_neg, ht]⟩ }

  have hS_map :
      ∀ {U V : V₀.Etale} (g : V ⟶ U) (z : ↥(S_sub U)),
        (Q_sh.obj.map g.op).hom z.1 ∈ S_sub V := by
    intro U V g z
    refine J.superset_covering ?_ (J.pullback_stable g z.2)
    intro W h ⟨t, ht⟩
    refine ⟨t, ?_⟩
    rw [ht, op_comp, CategoryTheory.Functor.map_comp]
    rfl

  let I_pre : CategoryTheory.Functor (Opposite V₀.Etale) AddCommGrpCat.{u} :=
    { obj := fun U_op => AddCommGrpCat.of ↥(S_sub U_op.unop)
      map := fun {U_op V_op} g_op =>
        AddCommGrpCat.ofHom
          { toFun := fun z => ⟨(Q_sh.obj.map g_op).hom z.1, hS_map g_op.unop z⟩
            map_zero' := Subtype.ext (map_zero _)
            map_add' := fun z₁ z₂ => Subtype.ext (map_add _ z₁.1 z₂.1) }
      map_id := fun U_op => by
        apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro z
        apply Subtype.ext
        change (Q_sh.obj.map (𝟙 U_op)).hom z.1 = z.1
        rw [CategoryTheory.Functor.map_id]; rfl
      map_comp := fun f_op g_op => by
        apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro z
        apply Subtype.ext
        change (Q_sh.obj.map (f_op ≫ g_op)).hom z.1 =
          (Q_sh.obj.map g_op).hom ((Q_sh.obj.map f_op).hom z.1)
        rw [CategoryTheory.Functor.map_comp]; rfl }

  let ι_pre : I_pre ⟶ Q_sh.obj :=
    { app := fun U_op => AddCommGrpCat.ofHom (S_sub U_op.unop).subtype
      naturality := fun _ _ _ => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun _ => rfl) }

  have hI_sh : CategoryTheory.Presheaf.IsSheaf J I_pre := by
    intro E U R hR x hx
    let x_Q : CategoryTheory.Presieve.FamilyOfElements
        (Q_sh.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op E)) (R : CategoryTheory.Presieve U) :=
      fun V f hf => x f hf ≫ ι_pre.app (Opposite.op V)
    have hx_Q : x_Q.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      change (x f₁ hf₁ ≫ ι_pre.app (Opposite.op Y₁)) ≫ Q_sh.obj.map g₁.op =
        (x f₂ hf₂ ≫ ι_pre.app (Opposite.op Y₂)) ≫ Q_sh.obj.map g₂.op
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        ← ι_pre.naturality g₁.op, ← ι_pre.naturality g₂.op,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
      congr 1
      exact hx g₁ g₂ hf₁ hf₂ hcomm
    have hQ_for := Q_sh.property E R hR
    let φ_Q : E ⟶ Q_sh.obj.obj (Opposite.op U) := hQ_for.amalgamate x_Q hx_Q
    have hφ_glue : ∀ {V : V₀.Etale} (f : V ⟶ U) (hf : R.arrows f),
        φ_Q ≫ Q_sh.obj.map f.op = x f hf ≫ ι_pre.app (Opposite.op V) :=
      fun f hf => hQ_for.valid_glue hx_Q f hf
    have hφ_mem : ∀ e : ↥E, φ_Q.hom e ∈ S_sub U := by
      intro e
      change imgSieve U (φ_Q.hom e) ∈ J U
      refine J.transitive hR (imgSieve U (φ_Q.hom e)) ?_
      intro V f hf
      have hf_eq : (Q_sh.obj.map f.op).hom (φ_Q.hom e) = ((x f hf).hom e).1 :=
        congrArg (fun ψ : E ⟶ Q_sh.obj.obj (Opposite.op V) => ψ.hom e) (hφ_glue f hf)
      have hf_mem : imgSieve V ((x f hf).hom e).1 ∈ J V := ((x f hf).hom e).2
      rw [← hf_eq] at hf_mem
      refine J.superset_covering ?_ hf_mem
      intro W g ⟨t, ht⟩
      refine ⟨t, ?_⟩
      rw [ht, op_comp, CategoryTheory.Functor.map_comp]
      rfl
    let φ_I : E ⟶ I_pre.obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := fun e => ⟨φ_Q.hom e, hφ_mem e⟩
          map_zero' := Subtype.ext (map_zero φ_Q.hom)
          map_add' := fun e₁ e₂ => Subtype.ext (map_add φ_Q.hom e₁ e₂) }
    refine ⟨φ_I, ?_, ?_⟩
    · intro V f hf
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro e
      apply Subtype.ext
      exact congrArg (fun ψ : E ⟶ Q_sh.obj.obj (Opposite.op V) => ψ.hom e) (hφ_glue f hf)
    · intro ψ_I hψ
      have hψ_Q : ψ_I ≫ ι_pre.app (Opposite.op U) = φ_Q := by
        refine hQ_for.isSeparatedFor.ext fun V f hf => ?_
        calc
          (ψ_I ≫ ι_pre.app (Opposite.op U)) ≫ Q_sh.obj.map f.op
            = ψ_I ≫ (ι_pre.app (Opposite.op U) ≫ Q_sh.obj.map f.op) :=
                CategoryTheory.Category.assoc _ _ _
          _ = ψ_I ≫ (I_pre.map f.op ≫ ι_pre.app (Opposite.op V)) := by
                rw [ι_pre.naturality f.op]
          _ = (ψ_I ≫ I_pre.map f.op) ≫ ι_pre.app (Opposite.op V) :=
                (CategoryTheory.Category.assoc _ _ _).symm
          _ = x f hf ≫ ι_pre.app (Opposite.op V) := by
                congr 1; exact hψ f hf
          _ = φ_Q ≫ Q_sh.obj.map f.op := (hφ_glue f hf).symm
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro e
      apply Subtype.ext
      exact congrArg (fun ψ : E ⟶ Q_sh.obj.obj (Opposite.op U) => ψ.hom e) hψ_Q

  let I_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨I_pre, hI_sh⟩
  let ι_sh : I_sh ⟶ Q_sh := { hom := ι_pre }
  have : CategoryTheory.Mono ι_sh :=
    ⟨fun {W_sh} α₁ α₂ h => by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro w
      apply Subtype.ext
      exact congrArg (fun ψ : W_sh ⟶ Q_sh => (ψ.hom.app U_op).hom w) h⟩
  let q_tilde : K_sh ⟶ I_sh :=
    { hom :=
        { app := fun U_op =>
            AddCommGrpCat.ofHom
              { toFun := fun t =>
                  ⟨(q_K.hom.app U_op).hom t, by
                    have htop : imgSieve U_op.unop ((q_K.hom.app U_op).hom t) = ⊤ := by
                      ext V f
                      simp only [CategoryTheory.Sieve.top_apply, iff_true]
                      refine ⟨(K_sh.obj.map f.op).hom t, ?_⟩
                      exact congrArg (fun ψ => ψ.hom t) (q_K.hom.naturality f.op)
                    change imgSieve U_op.unop ((q_K.hom.app U_op).hom t) ∈ J U_op.unop
                    rw [htop]
                    exact J.top_mem U_op.unop⟩
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun t₁ t₂ => Subtype.ext (map_add _ t₁ t₂) }
          naturality := fun U_op V_op f_op => by
            apply AddCommGrpCat.hom_ext; apply AddMonoidHom.ext; intro t
            apply Subtype.ext
            exact congrArg (fun ψ => ψ.hom t) (q_K.hom.naturality f_op) } }
  have hq_fac_ι : q_tilde ≫ ι_sh = q_K := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext U_op
    rfl
  have : CategoryTheory.Epi (q_tilde ≫ ι_sh) := by rw [hq_fac_ι]; infer_instance
  have : CategoryTheory.Epi ι_sh := CategoryTheory.epi_of_epi q_tilde ι_sh
  have : CategoryTheory.IsIso ι_sh := CategoryTheory.isIso_of_mono_of_epi ι_sh

  let z_q : ↥(Q_sh.obj.obj (Opposite.op T_V)) :=
    ((adj_TV.homEquiv Aℤ Q_sh) q_mor).hom (ULift.up (1 : ℤ))
  have hzq_mem : imgSieve T_V z_q ∈ J T_V := by
    let z_I : ↥(S_sub T_V) := ((CategoryTheory.inv ι_sh).hom.app (Opposite.op T_V)).hom z_q
    have hz_eq : z_I.1 = z_q := by
      change ((CategoryTheory.inv ι_sh ≫ ι_sh).hom.app (Opposite.op T_V)).hom z_q = z_q
      rw [CategoryTheory.IsIso.inv_hom_id]
      rfl
    exact hz_eq ▸ z_I.2

  have hLocLift_all :
      ∀ x₀ : ↥V₀,
        ∃ (U₁ : V₀.Etale) (g₁ : U₁ ⟶ T_V) (y₁ : ↥U₁.left),
          g₁.left.base y₁ = x₀ ∧
          ∃ τ₁ : ↥(K_pre.obj (Opposite.op U₁)),
            ℓ • τ₁ = (K_pre.map g₁.op).hom s_f := by
    intro x₀
    have hJ_eq : J = (V₀.smallEtalePretopology).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology V₀ le_rfl
    have hmem_pre : imgSieve T_V z_q ∈ (V₀.smallEtalePretopology).toGrothendieck T_V := by
      rwa [← hJ_eq]
    obtain ⟨U₁_raw, g₁_raw, y₁, ⟨τ_tilde, hτ_tilde⟩, _, hy₁_eq⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology T_V (imgSieve T_V z_q)).mp
        hmem_pre x₀
    let U₁ : V₀.Etale := U₁_raw
    let g₁ : U₁ ⟶ T_V := g₁_raw
    have h_iQ_zq : (i_Q.hom.app (Opposite.op T_V)).hom z_q = z_f := by
      have hnat := CategoryTheory.Adjunction.homEquiv_naturality_right adj_TV q_mor i_Q
      exact (congrArg (fun ψ => ψ.hom (ULift.up (1 : ℤ))) hnat).symm
    have h_mul_sh : ℓ • τ_tilde = (K_sh.obj.map g₁.op).hom z_f := by
      have h_app := congrArg (i_Q.hom.app (Opposite.op U₁)).hom hτ_tilde
      have hLHS : (i_Q.hom.app (Opposite.op U₁)).hom ((q_K.hom.app (Opposite.op U₁)).hom τ_tilde) =
          ℓ • τ_tilde := by
        change ((q_K ≫ i_Q).hom.app (Opposite.op U₁)).hom τ_tilde = ℓ • τ_tilde
        rw [hfac_Q, h_sheaf_nsmul_app, h_hom_nsmul]
        rfl
      have hRHS : (i_Q.hom.app (Opposite.op U₁)).hom ((Q_sh.obj.map g₁.op).hom z_q) =
          (K_sh.obj.map g₁.op).hom z_f := by
        have hnat := congrArg (fun ψ => ψ.hom z_q) (i_Q.hom.naturality g₁.op)
        change (i_Q.hom.app (Opposite.op U₁)).hom ((Q_sh.obj.map g₁.op).hom z_q) =
          (K_sh.obj.map g₁.op).hom ((i_Q.hom.app (Opposite.op T_V)).hom z_q) at hnat
        rw [hnat, h_iQ_zq]
      exact hLHS.symm.trans (h_app.trans hRHS)
    let τ₁ : ↥(K_pre.obj (Opposite.op U₁)) := (isoK.inv.app (Opposite.op U₁)).hom τ_tilde
    refine ⟨U₁, g₁, y₁, hy₁_eq, τ₁, ?_⟩
    dsimp [τ₁]
    rw [← map_nsmul, h_mul_sh]
    exact congrArg (fun ψ => ψ.hom z_f) (isoK.inv.naturality g₁.op)

  
  
  
  have : IrreducibleSpace ↥V₀ := AlgebraicGeometry.irreducibleSpace_of_isIntegral V₀
  let η : ↥V₀ := genericPoint ↥V₀
  let η_V := V₀.fromSpecStalk η
  let Z_T : AlgebraicGeometry.Scheme.{u} :=
    ((CategoryTheory.Over.pullback η_V).obj
      ((AlgebraicGeometry.Scheme.Etale.forget V₀).obj T_V)).left
  let π_gen : Z_T ⟶ AlgebraicGeometry.Spec (V₀.presheaf.stalk η) :=
    ((CategoryTheory.Over.pullback η_V).obj
      ((AlgebraicGeometry.Scheme.Etale.forget V₀).obj T_V)).hom
  have : CategoryTheory.IsIso π_gen :=
    @CategoryTheory.Limits.pullback_snd_iso_of_left_iso _ _ _ _ _
      (((AlgebraicGeometry.Scheme.Etale.forget V₀).obj T_V).hom) η_V
      (by change CategoryTheory.IsIso (𝟙 V₀); infer_instance)
  let e_π : Z_T ≅ AlgebraicGeometry.Spec (V₀.presheaf.stalk η) := CategoryTheory.asIso π_gen
  let α_ring : V₀.presheaf.stalk η ⟶ Z_T.presheaf.obj (Opposite.op ⊤) :=
    (AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)).inv ≫ π_gen.appTop
  let β_ring : Z_T.presheaf.obj (Opposite.op ⊤) ⟶ V₀.presheaf.stalk η :=
    e_π.inv.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)).hom
  have hβα_ring : β_ring ≫ α_ring = 𝟙 _ := by
    dsimp [α_ring, β_ring]
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso _).hom,
      CategoryTheory.Iso.hom_inv_id, CategoryTheory.Category.id_comp,
      ← AlgebraicGeometry.Scheme.Hom.comp_appTop]
    have he_id : π_gen ≫ e_π.inv = 𝟙 Z_T := e_π.hom_inv_id
    rw [he_id, AlgebraicGeometry.Scheme.Hom.id_appTop]

  let U_ZT := Units ↑(Z_T.presheaf.obj (Opposite.op ⊤))
  let u_sf : U_ZT := @Additive.toMul U_ZT s_f
  let f : Units ↑V₀.functionField :=
    Units.map β_ring.hom.toMonoidHom u_sf

  have hs_f_toMul : Units.map α_ring.hom.toMonoidHom f = u_sf := by
    dsimp [f]
    ext1
    change α_ring.hom (β_ring.hom u_sf.val) = u_sf.val
    exact congrArg (fun ψ : Z_T.presheaf.obj (Opposite.op ⊤) ⟶ _ => ψ.hom _) hβα_ring

  have hs_f_compat :
      Additive.ofMul (Units.map α_ring.hom.toMonoidHom f) = s_f := by
    rw [hs_f_toMul]
    rfl

  have hf_not_pow : ∀ g : Units ↑V₀.functionField, g ^ ℓ ≠ f := by
    intro g hg
    let s_g : ↥(K_pre.obj (Opposite.op T_V)) :=
      Additive.ofMul (Units.map α_ring.hom.toMonoidHom g)
    apply hs_not_mul s_g
    have hpow : ℓ • s_g =
        Additive.ofMul (Units.map α_ring.hom.toMonoidHom (g ^ ℓ)) := by
      dsimp [s_g]
      rw [map_pow, ofMul_pow]
      rfl
    rw [hpow, hg, hs_f_compat]

  have hf_val :
      ∀ x : { x : ↥V₀ // IsClosed ({x} : Set ↥V₀) },
        ∃ (u_x : Units ↑(V₀.presheaf.stalk x.1))
          (g_x : Units ↑V₀.functionField),
          (f : ↑V₀.functionField) =
            algebraMap ↑(V₀.presheaf.stalk x.1) ↑V₀.functionField
              (u_x : ↑(V₀.presheaf.stalk x.1)) *
              (g_x : ↑V₀.functionField) ^ ℓ := by
    rintro ⟨x₀, hx₀⟩
    obtain ⟨U₁, g₁, y₁, hy₁_g, τ₁, hτ₁⟩ := hLocLift_all x₀
    let g₁_l : U₁.left ⟶ V₀ := g₁.left
    have hy₁_l : g₁_l.base y₁ = x₀ := hy₁_g
    subst hy₁_l
    have hU₁_hom : g₁_l = U₁.hom :=
      (CategoryTheory.Category.comp_id g₁_l).symm.trans
        (CategoryTheory.MorphismProperty.Over.w g₁)
    let x_pt : ↥V₀ := g₁_l.base y₁
    let y_cl : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥V₀) } :=
      ⟨y₁, by rwa [← hU₁_hom]⟩
    let x_cl_T : { y : ↥T_V.left // IsClosed ({T_V.hom.base y} : Set ↥V₀) } :=
      ⟨x_pt, hx₀⟩
    obtain ⟨hDom_x, hDVR_x⟩ := hStalkDVR.2.1 T_V x_cl_T
    obtain ⟨hDom_y, hDVR_y⟩ := hStalkDVR.2.1 U₁ y_cl
    let R_y : Type u := ↑(U₁.left.presheaf.stalk y₁)
    have : IsDomain ↑(V₀.presheaf.stalk x_pt) := hDom_x
    have : IsDiscreteValuationRing ↑(V₀.presheaf.stalk x_pt) := hDVR_x
    have : IsDomain R_y := hDom_y
    have : IsDiscreteValuationRing R_y := hDVR_y
    obtain ⟨hψ_inj, hψ_unram⟩ := hStalkDVR.2.2.1 g₁ y_cl
    let ψ : ↑(V₀.presheaf.stalk x_pt) →+* R_y := (g₁_l.stalkMap y₁).hom
    let L_y : Type u := FractionRing R_y
    have hg_emb : Function.Injective ((algebraMap R_y L_y).comp ψ) :=
      (IsFractionRing.injective R_y L_y).comp hψ_inj
    let φ_tilde : ↑V₀.functionField →+* L_y :=
      IsFractionRing.lift (A := ↑(V₀.presheaf.stalk x_pt)) (K := ↑V₀.functionField) hg_emb
    have hφ_alg : ∀ r : ↑(V₀.presheaf.stalk x_pt),
        φ_tilde (algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField r) =
          algebraMap R_y L_y (ψ r) :=
      fun r => IsFractionRing.lift_algebraMap hg_emb r

    let φ_cat : V₀.presheaf.stalk η ⟶ CommRingCat.of L_y := CommRingCat.ofHom φ_tilde
    let α_y : AlgebraicGeometry.Spec (CommRingCat.of L_y) ⟶ U₁.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_y L_y)) ≫
        U₁.left.fromSpecStalk y₁
    let β_y : AlgebraicGeometry.Spec (CommRingCat.of L_y) ⟶
        AlgebraicGeometry.Spec (V₀.presheaf.stalk η) :=
      AlgebraicGeometry.Spec.map φ_cat
    have hring_comm :
        g₁_l.stalkMap y₁ ≫ CommRingCat.ofHom (algebraMap R_y L_y) =
        V₀.presheaf.stalkSpecializes (genericPoint_specializes x_pt) ≫ φ_cat := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      exact (hφ_alg r).symm
    have hcomm_y : α_y ≫ U₁.hom = β_y ≫ η_V :=
      (congrArg (α_y ≫ ·) hU₁_hom.symm).trans <|
      (CategoryTheory.Category.assoc _ _ _).trans <|
      (congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_y L_y)) ≫ ·)
        (AlgebraicGeometry.Scheme.SpecMap_stalkMap_fromSpecStalk g₁_l (x := y₁)).symm).trans <|
      (CategoryTheory.Category.assoc _ _ _).symm.trans <|
      (congrArg (· ≫ V₀.fromSpecStalk x_pt)
        ((AlgebraicGeometry.Spec.map_comp (g₁_l.stalkMap y₁)
            (CommRingCat.ofHom (algebraMap R_y L_y))).symm.trans
          ((congrArg AlgebraicGeometry.Spec.map hring_comm).trans
            (AlgebraicGeometry.Spec.map_comp
              (V₀.presheaf.stalkSpecializes (genericPoint_specializes x_pt)) φ_cat)))).trans <|
      (CategoryTheory.Category.assoc _ _ _).trans <|
      congrArg (β_y ≫ ·)
        (AlgebraicGeometry.Scheme.SpecMap_stalkSpecializes_fromSpecStalk
          (genericPoint_specializes x_pt))

    let Z_U₁ : AlgebraicGeometry.Scheme.{u} :=
      ((CategoryTheory.Over.pullback η_V).obj
        ((AlgebraicGeometry.Scheme.Etale.forget V₀).obj U₁)).left
    let γ_y : AlgebraicGeometry.Spec (CommRingCat.of L_y) ⟶ Z_U₁ :=
      CategoryTheory.Limits.pullback.lift α_y β_y hcomm_y
    let m_g₁ : Z_U₁ ⟶ Z_T :=
      ((CategoryTheory.Over.pullback η_V).map
        ((AlgebraicGeometry.Scheme.Etale.forget V₀).map g₁)).left
    have hγ_snd : γ_y ≫ m_g₁ ≫ π_gen = β_y := by
      have hw_pb : m_g₁ ≫ π_gen = CategoryTheory.Limits.pullback.snd U₁.hom η_V :=
        CategoryTheory.Over.w
          ((CategoryTheory.Over.pullback η_V).map
            ((AlgebraicGeometry.Scheme.Etale.forget V₀).map g₁))
      rw [hw_pb]
      exact CategoryTheory.Limits.pullback.lift_snd α_y β_y hcomm_y

    let ev_y : Z_U₁.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of L_y :=
      γ_y.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L_y)).hom
    have hev_comp : α_ring ≫ m_g₁.appTop ≫ ev_y = φ_cat := by
      dsimp [α_ring, ev_y]
      have happ : π_gen.appTop ≫ m_g₁.appTop ≫ γ_y.appTop = β_y.appTop := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop,
          ← AlgebraicGeometry.Scheme.Hom.comp_appTop, CategoryTheory.Category.assoc, hγ_snd]
      calc
        ((AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)).inv ≫ π_gen.appTop) ≫
            m_g₁.appTop ≫ γ_y.appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L_y)).hom
          = (AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)).inv ≫
              (π_gen.appTop ≫ m_g₁.appTop ≫ γ_y.appTop) ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L_y)).hom := by
                simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)).inv ≫
              (AlgebraicGeometry.Spec.map φ_cat).appTop ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of L_y)).hom := by
                rw [happ]
        _ = (AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)).inv ≫
              (AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)).hom ≫
              φ_cat := by
                rw [AlgebraicGeometry.Scheme.ΓSpecIso_naturality]
        _ = φ_cat :=
              CategoryTheory.Iso.inv_hom_id_assoc
                (AlgebraicGeometry.Scheme.ΓSpecIso (V₀.presheaf.stalk η)) φ_cat

    let U_ZU₁ := Units ↑(Z_U₁.presheaf.obj (Opposite.op ⊤))
    let u_τ₁ : U_ZU₁ := @Additive.toMul U_ZU₁ τ₁
    let w_y : Units L_y := Units.map ev_y.hom.toMonoidHom u_τ₁
    have hwy_pow : (w_y : L_y) ^ ℓ = φ_tilde (f : ↑V₀.functionField) := by
      have hτ₁_mul : u_τ₁ ^ ℓ = Units.map (m_g₁.appTop).hom.toMonoidHom u_sf := by
        change @Additive.toMul U_ZU₁ (ℓ • τ₁) = _
        rw [hτ₁]
        rfl
      have hτ₁_val : (u_τ₁.val) ^ ℓ = (m_g₁.appTop).hom (α_ring.hom (f : ↑V₀.functionField)) := by
        have hv := congrArg Units.val hτ₁_mul
        rw [Units.val_pow_eq_pow_val, ← hs_f_toMul] at hv
        exact hv
      change (ev_y.hom u_τ₁.val) ^ ℓ = φ_tilde (f : ↑V₀.functionField)
      rw [← map_pow, hτ₁_val]
      exact congrArg (fun ρ : V₀.presheaf.stalk η ⟶ CommRingCat.of L_y =>
        ρ.hom (f : ↑V₀.functionField)) hev_comp

    obtain ⟨ϖ_x, hϖ_x⟩ :=
      IsDiscreteValuationRing.exists_irreducible ↑(V₀.presheaf.stalk x_pt)
    obtain ⟨ϖ_y, hϖ_y⟩ := IsDiscreteValuationRing.exists_irreducible R_y
    have hm_x : IsLocalRing.maximalIdeal ↑(V₀.presheaf.stalk x_pt) =
        Ideal.span ({ϖ_x} : Set ↑(V₀.presheaf.stalk x_pt)) :=
      hϖ_x.maximalIdeal_eq
    have hm_y : IsLocalRing.maximalIdeal R_y = Ideal.span ({ϖ_y} : Set R_y) :=
      hϖ_y.maximalIdeal_eq

    obtain ⟨a, b, hb_nzd, hab_div⟩ :=
      IsFractionRing.div_surjective (A := ↑(V₀.presheaf.stalk x_pt)) (f : ↑V₀.functionField)
    have hb_ne : b ≠ 0 := nonZeroDivisors.ne_zero hb_nzd
    have hb_K : algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField b ≠ 0 :=
      fun h0 => hb_ne ((IsFractionRing.injective ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField)
        (h0.trans (map_zero _).symm))
    have hab_eq : algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField a =
        (f : ↑V₀.functionField) * algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField b :=
      (div_eq_iff hb_K).mp hab_div
    have ha_ne : a ≠ 0 := by
      intro ha0
      apply mul_ne_zero f.ne_zero hb_K
      rw [← hab_eq, ha0, map_zero]

    obtain ⟨c, d, hd_nzd, hcd_div⟩ := IsFractionRing.div_surjective (A := R_y) (w_y : L_y)
    have hd_ne : d ≠ 0 := nonZeroDivisors.ne_zero hd_nzd
    have hd_L : algebraMap R_y L_y d ≠ 0 :=
      fun h0 => hd_ne ((IsFractionRing.injective R_y L_y) (h0.trans (map_zero _).symm))
    have hcd_eq : algebraMap R_y L_y c = (w_y : L_y) * algebraMap R_y L_y d :=
      (div_eq_iff hd_L).mp hcd_div
    have hc_ne : c ≠ 0 := by
      intro hc0
      apply mul_ne_zero w_y.ne_zero hd_L
      rw [← hcd_eq, hc0, map_zero]

    obtain ⟨n_a, h_assoc_a⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha_ne hϖ_x
    obtain ⟨n_b, h_assoc_b⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb_ne hϖ_x
    obtain ⟨n_c, h_assoc_c⟩ := IsDiscreteValuationRing.associated_pow_irreducible hc_ne hϖ_y
    obtain ⟨n_d, h_assoc_d⟩ := IsDiscreteValuationRing.associated_pow_irreducible hd_ne hϖ_y

    have hspan_a : Ideal.span ({a} : Set ↑(V₀.presheaf.stalk x_pt)) =
        IsLocalRing.maximalIdeal ↑(V₀.presheaf.stalk x_pt) ^ n_a := by
      rw [Ideal.span_singleton_eq_span_singleton.mpr h_assoc_a, ← Ideal.span_singleton_pow, ← hm_x]
    have hspan_b : Ideal.span ({b} : Set ↑(V₀.presheaf.stalk x_pt)) =
        IsLocalRing.maximalIdeal ↑(V₀.presheaf.stalk x_pt) ^ n_b := by
      rw [Ideal.span_singleton_eq_span_singleton.mpr h_assoc_b, ← Ideal.span_singleton_pow, ← hm_x]
    have hspan_c : Ideal.span ({c} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ n_c := by
      rw [Ideal.span_singleton_eq_span_singleton.mpr h_assoc_c, ← Ideal.span_singleton_pow, ← hm_y]
    have hspan_d : Ideal.span ({d} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ n_d := by
      rw [Ideal.span_singleton_eq_span_singleton.mpr h_assoc_d, ← Ideal.span_singleton_pow, ← hm_y]

    have h_eq_Ry : ψ a * d ^ ℓ = ψ b * c ^ ℓ := by
      apply IsFractionRing.injective R_y L_y
      have hφ_ab := congrArg φ_tilde hab_eq
      rw [map_mul, hφ_alg a, hφ_alg b, ← hwy_pow] at hφ_ab
      calc
        algebraMap R_y L_y (ψ a * d ^ ℓ)
          = algebraMap R_y L_y (ψ a) * (algebraMap R_y L_y d) ^ ℓ := by rw [map_mul, map_pow]
        _ = ((w_y : L_y) ^ ℓ * algebraMap R_y L_y (ψ b)) * (algebraMap R_y L_y d) ^ ℓ := by
              rw [hφ_ab]
        _ = algebraMap R_y L_y (ψ b) * ((w_y : L_y) * algebraMap R_y L_y d) ^ ℓ := by ring
        _ = algebraMap R_y L_y (ψ b) * (algebraMap R_y L_y c) ^ ℓ := by rw [← hcd_eq]
        _ = algebraMap R_y L_y (ψ b * c ^ ℓ) := by rw [map_mul, map_pow]

    have hspan_ψa : Ideal.span ({ψ a} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ n_a := by
      have hmap : Ideal.map ψ (Ideal.span ({a} : Set ↑(V₀.presheaf.stalk x_pt))) =
          Ideal.span ({ψ a} : Set R_y) := by
        rw [Ideal.map_span, Set.image_singleton]
      exact hmap.symm.trans ((congrArg (Ideal.map ψ) hspan_a).trans (hψ_unram n_a))
    have hspan_ψb : Ideal.span ({ψ b} : Set R_y) = IsLocalRing.maximalIdeal R_y ^ n_b := by
      have hmap : Ideal.map ψ (Ideal.span ({b} : Set ↑(V₀.presheaf.stalk x_pt))) =
          Ideal.span ({ψ b} : Set R_y) := by
        rw [Ideal.map_span, Set.image_singleton]
      exact hmap.symm.trans ((congrArg (Ideal.map ψ) hspan_b).trans (hψ_unram n_b))

    have hm_pow_eq :
        IsLocalRing.maximalIdeal R_y ^ (n_a + n_d * ℓ) =
          IsLocalRing.maximalIdeal R_y ^ (n_b + n_c * ℓ) := by
      calc
        IsLocalRing.maximalIdeal R_y ^ (n_a + n_d * ℓ)
          = IsLocalRing.maximalIdeal R_y ^ n_a * (IsLocalRing.maximalIdeal R_y ^ n_d) ^ ℓ := by
              rw [pow_add, pow_mul]
        _ = Ideal.span ({ψ a} : Set R_y) * Ideal.span ({d} : Set R_y) ^ ℓ := by
              rw [hspan_ψa, hspan_d]
        _ = Ideal.span ({ψ a * d ^ ℓ} : Set R_y) := by
              rw [Ideal.span_singleton_pow, Ideal.span_singleton_mul_span_singleton]
        _ = Ideal.span ({ψ b * c ^ ℓ} : Set R_y) := by rw [h_eq_Ry]
        _ = Ideal.span ({ψ b} : Set R_y) * Ideal.span ({c} : Set R_y) ^ ℓ := by
              rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_pow]
        _ = IsLocalRing.maximalIdeal R_y ^ n_b * (IsLocalRing.maximalIdeal R_y ^ n_c) ^ ℓ := by
              rw [hspan_ψb, hspan_c]
        _ = IsLocalRing.maximalIdeal R_y ^ (n_b + n_c * ℓ) := by
              rw [← pow_mul, ← pow_add]

    have hm_pow_lt_ne :
        ∀ {m₁ m₂ : ℕ}, m₁ < m₂ →
          IsLocalRing.maximalIdeal R_y ^ m₁ ≠ IsLocalRing.maximalIdeal R_y ^ m₂ := by
      intro m₁ m₂ hlt heq
      rw [hm_y, Ideal.span_singleton_pow, Ideal.span_singleton_pow] at heq
      have hmem : ϖ_y ^ m₁ ∈ Ideal.span ({ϖ_y ^ m₂} : Set R_y) := by
        rw [← heq]
        exact Ideal.subset_span (Set.mem_singleton _)
      rw [Ideal.mem_span_singleton] at hmem
      obtain ⟨r, hr⟩ := hmem
      obtain ⟨k_diff, rfl⟩ : ∃ k_diff, m₂ = m₁ + (k_diff + 1) := ⟨m₂ - m₁ - 1, by omega⟩
      have hpow_ne : ϖ_y ^ m₁ ≠ 0 := pow_ne_zero m₁ hϖ_y.ne_zero
      have h1 : (1 : R_y) = ϖ_y * (ϖ_y ^ k_diff * r) := by
        apply mul_left_cancel₀ hpow_ne
        calc
          ϖ_y ^ m₁ * 1 = ϖ_y ^ m₁ := mul_one _
          _ = ϖ_y ^ (m₁ + (k_diff + 1)) * r := hr
          _ = ϖ_y ^ m₁ * (ϖ_y * (ϖ_y ^ k_diff * r)) := by ring
      have hu_ϖ : IsUnit ϖ_y :=
        ⟨⟨ϖ_y, ϖ_y ^ k_diff * r, h1.symm, (mul_comm _ _).trans h1.symm⟩, rfl⟩
      exact hϖ_y.not_isUnit hu_ϖ

    have hexp_eq : n_a + n_d * ℓ = n_b + n_c * ℓ := by
      rcases lt_trichotomy (n_a + n_d * ℓ) (n_b + n_c * ℓ) with hlt | heq | hgt
      · exact absurd hm_pow_eq (hm_pow_lt_ne hlt)
      · exact heq
      · exact absurd hm_pow_eq.symm (hm_pow_lt_ne hgt)

    obtain ⟨u_a, hua⟩ := h_assoc_a.symm
    obtain ⟨u_b, hub⟩ := h_assoc_b.symm
    have hϖx_K : algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField ϖ_x ≠ 0 :=
      fun h0 => hϖ_x.ne_zero
        ((IsFractionRing.injective ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField)
          (h0.trans (map_zero _).symm))
    let ϖ_unit : Units ↑V₀.functionField :=
      Units.mk0 (algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField ϖ_x) hϖx_K
    let u_x : Units ↑(V₀.presheaf.stalk x_pt) := u_a * u_b⁻¹
    let e_int : ℤ := (n_c : ℤ) - (n_d : ℤ)
    have he_int : (n_a : ℤ) - (n_b : ℤ) = e_int * (ℓ : ℤ) := by
      have hcast : (n_a : ℤ) + (n_d : ℤ) * (ℓ : ℤ) = (n_b : ℤ) + (n_c : ℤ) * (ℓ : ℤ) := by
        exact_mod_cast hexp_eq
      dsimp [e_int]
      linarith
    let g_x : Units ↑V₀.functionField := ϖ_unit ^ e_int
    let a_unit : Units ↑V₀.functionField :=
      Units.map (algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField).toMonoidHom u_a *
        ϖ_unit ^ (n_a : ℤ)
    let b_unit : Units ↑V₀.functionField :=
      Units.map (algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField).toMonoidHom u_b *
        ϖ_unit ^ (n_b : ℤ)
    have ha_val : (a_unit : ↑V₀.functionField) =
        algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField a := by
      dsimp only [a_unit]
      rw [Units.val_mul, zpow_natCast, Units.val_pow_eq_pow_val]
      change algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField u_a.val *
        (algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField ϖ_x) ^ n_a = _
      rw [← map_pow, ← map_mul, mul_comm, hua]
    have hb_val : (b_unit : ↑V₀.functionField) =
        algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField b := by
      dsimp only [b_unit]
      rw [Units.val_mul, zpow_natCast, Units.val_pow_eq_pow_val]
      change algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField u_b.val *
        (algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField ϖ_x) ^ n_b = _
      rw [← map_pow, ← map_mul, mul_comm, hub]
    have hfb_unit : f * b_unit = a_unit := by
      ext1
      rw [Units.val_mul, ha_val, hb_val, hab_eq]
    have hf_unit_eq :
        f = Units.map (algebraMap ↑(V₀.presheaf.stalk x_pt) ↑V₀.functionField).toMonoidHom u_x *
          g_x ^ ℓ := by
      have hf_div : f = a_unit * b_unit⁻¹ := eq_mul_inv_of_mul_eq hfb_unit
      rw [hf_div]
      dsimp [a_unit, b_unit, u_x, g_x]
      rw [mul_inv_rev, map_mul, map_inv, ← zpow_neg, ← zpow_natCast _ ℓ, ← zpow_mul, ← he_int,
        sub_eq_add_neg, zpow_add, mul_comm (ϖ_unit ^ (-(n_b : ℤ)))]
      exact mul_mul_mul_comm _ _ _ _
    refine ⟨u_x, g_x, ?_⟩
    have hv := congrArg Units.val hf_unit_eq
    simpa [Units.val_pow_eq_pow_val] using hv

  
  
  
  refine ⟨s_f, f, hf_not_pow, hf_val, hs_f_compat, ?_⟩
  intro V'_sch p hp_et U_p j_p ⟨w_K, hw_K⟩ p₁ hp₁
  let w_sh : ↥(K_sh.obj.obj (Opposite.op U_p)) :=
    (isoK.hom.app (Opposite.op U_p)).hom w_K
  have hw_sh : ℓ • w_sh = (K_sh.obj.map j_p.op).hom z_f := by
    dsimp [w_sh]
    rw [← map_nsmul, hw_K]
    have hnat := congrArg (fun ψ => ψ.hom s_f) (isoK.hom.naturality j_p.op)
    change (isoK.hom.app (Opposite.op U_p)).hom ((K_pre.map j_p.op).hom s_f) =
      (K_sh.obj.map j_p.op).hom ((isoK.hom.app (Opposite.op T_V)).hom s_f) at hnat
