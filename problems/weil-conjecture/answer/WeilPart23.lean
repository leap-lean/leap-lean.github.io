      rw [← step1_constAdj_homEquiv_symm J₂ hT₂ hT'₂ e₂ A (P_push.obj (C₁.obj A))]
      congr 1
      change adj'₁.unit.app A ≫ (C₁.obj A).obj.map τ'.op =
        (adj₁.unit.app A ≫ (C₁.obj A).obj.map τ_std.op) ≫ (C₁.obj A).obj.map (G.map e₂).op
      rw [Category.assoc, ← Functor.map_comp, ← op_comp,
        show G.map e₂ ≫ τ_std = τ' ≫ e₁ from hT₁.hom_ext _ _,
        op_comp, Functor.map_comp, ← Category.assoc,
        ← step1_constAdj_unit_ab J₁ hT₁ hT'₁ e₁ A]
    let π_std_A : P_pull.obj (C₂.obj A) ⟶ C₁.obj A :=
      (adj_pull.homEquiv (C₂.obj A) (C₁.obj A)).symm u_std_A
    let α_A : C₁.obj A ⟶ R_ab.obj (C₂.obj A) :=
