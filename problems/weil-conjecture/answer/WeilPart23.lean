  let I₁ : Ideal (MvPolynomial (Fin ((s₀ + 1) + ν + d)) k) := Ideal.span (Set.range q₁)
  have hI_le : I₁ ≤ RingHom.ker φ₁ := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    refine Fin.lastCases ?_ (fun a => ?_) i
    · dsimp [q₁]
      rw [Fin.snoc_last, map_sub, map_one, map_mul, hφ₁_ren, hg_poly, hφ₁_z,
        IsLocalization.Away.mul_invSelf, sub_self]
    · dsimp [q₁]
      rw [Fin.snoc_castSucc, hφ₁_ren]
      have hq_mem : q₀ a ∈ RingHom.ker φ₀ := by
        rw [hKer₀]
        exact Ideal.subset_span ⟨a, rfl⟩
      rw [RingHom.mem_ker.mp hq_mem, map_zero]
  let mkQ := Ideal.Quotient.mk I₁
  let G : MvPolynomial (Fin ((s₀ + 1) + ν + d)) k := MvPolynomial.rename ι_old g_poly
  let Z : MvPolynomial (Fin ((s₀ + 1) + ν + d)) k := MvPolynomial.X z_slot
  have hGZ : mkQ G * mkQ Z = 1 := by
    have hmem : G * Z - 1 ∈ I₁ := by
      refine Ideal.subset_span ⟨Fin.last s₀, ?_⟩
      simp [q₁, G, Z]
    have hzero : mkQ (G * Z - 1) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    rw [map_sub, map_mul, map_one, sub_eq_zero] at hzero
    exact hzero
  have hClear : ∀ F : MvPolynomial (Fin ((s₀ + 1) + ν + d)) k,
      ∃ (D : ℕ) (P : MvPolynomial (Fin (s₀ + ν + d)) k),
        mkQ F * (mkQ G) ^ D = mkQ (MvPolynomial.rename ι_old P) := by
    intro F
    refine MvPolynomial.induction_on
      (motive := fun F =>
        ∃ (D : ℕ) (P : MvPolynomial (Fin (s₀ + ν + d)) k),
          mkQ F * (mkQ G) ^ D = mkQ (MvPolynomial.rename ι_old P))
      F ?_ ?_ ?_
    · intro c
      refine ⟨0, MvPolynomial.C c, ?_⟩
      simp
    · rintro f₁ f₂ ⟨D₁, P₁, h₁⟩ ⟨D₂, P₂, h₂⟩
      refine ⟨D₁ + D₂, P₁ * g_poly ^ D₂ + P₂ * g_poly ^ D₁, ?_⟩
      have hG1 : (mkQ G) ^ D₁ = mkQ (MvPolynomial.rename ι_old (g_poly ^ D₁)) := by
        simp only [G, map_pow]
      have hG2 : (mkQ G) ^ D₂ = mkQ (MvPolynomial.rename ι_old (g_poly ^ D₂)) := by
        simp only [G, map_pow]
      calc
        mkQ (f₁ + f₂) * (mkQ G) ^ (D₁ + D₂)
            = (mkQ f₁ * (mkQ G) ^ D₁) * (mkQ G) ^ D₂ +
                (mkQ f₂ * (mkQ G) ^ D₂) * (mkQ G) ^ D₁ := by
              rw [map_add, pow_add]
              ring
        _ = mkQ (MvPolynomial.rename ι_old P₁) * mkQ (MvPolynomial.rename ι_old (g_poly ^ D₂)) +
              mkQ (MvPolynomial.rename ι_old P₂) * mkQ (MvPolynomial.rename ι_old (g_poly ^ D₁)) := by
              rw [h₁, h₂, hG1, hG2]
        _ = mkQ (MvPolynomial.rename ι_old (P₁ * g_poly ^ D₂ + P₂ * g_poly ^ D₁)) := by
