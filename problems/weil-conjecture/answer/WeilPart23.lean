      let E_b := CategoryTheory.Limits.pullback ((D₀ b).ι ≫ B₀.hom) P₁.hom
      obtain ⟨Φ_b, p₀_b, s_b, hCl_Φ, hΦ_snd, hKer_b, hp₀b_hom, hp₀b_range, hs_b_sec, hs_b_fst⟩ :=
