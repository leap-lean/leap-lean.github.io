    have hSurj_app : Function.Surjective (ι_M.left.app (ν₂.left ⁻¹ᵁ D_β₀)).hom :=
      AlgebraicGeometry.Scheme.Hom.app_surjective ι_M.left (ν₂.left ⁻¹ᵁ D_β₀) hAff_pre
    have hSurj_ν₂ := hν₂_surj i hXβ₀ hpos
    let ρ_i := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ)
