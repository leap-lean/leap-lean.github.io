  letI : Limits.PreservesFiniteLimits (U_std₂ ⋙ R_h_ab) :=
    Limits.comp_preservesFiniteLimits U_std₂ R_h_ab
  letI : Limits.PreservesFiniteColimits (U_std₂ ⋙ R_h_ab) :=
    Limits.comp_preservesFiniteColimits U_std₂ R_h_ab

  let w := Abelian.Ext.mapExactFunctor U_std₂ x
  have hMod_comm : Abelian.Ext.mapExactFunctor U_std₁ (Abelian.Ext.mapExactFunctor R_sh x) =
      (Abelian.Ext.mk₀ e_one₂.hom).comp
        ((Abelian.Ext.mapExactFunctor R_h_ab w).comp
          (Abelian.Ext.mk₀ e_one₂.inv) (Nat.add_zero q))
        (Nat.zero_add q) := by
    rw [← step2_extComp R_sh U_std₁ x,
      step2_extIso (U_std₂ ⋙ R_h_ab) (R_sh ⋙ U_std₁) e_comm.symm x,
      step2_extComp U_std₂ R_h_ab x]
    rfl

  have hLHS : θ₁ (r_q x) =
      (Abelian.Ext.mk₀ ((ηℤ₁ ≫ U_std₁.map α_h) ≫ e_one₂.hom)).comp
        ((Abelian.Ext.mapExactFunctor R_h_ab w).comp
          (Abelian.Ext.mk₀ (e_one₂.inv ≫ (U_std₁.map β_h ≫ βM₁))) (Nat.add_zero q))
        (Nat.zero_add q) := by
    rw [hθ₁_eq (r_q x), hr_eq x]
    change ((Abelian.Ext.mk₀ ηℤ₁).comp
        (Abelian.Ext.mapExactFunctor U_std₁
          (((Abelian.Ext.mk₀ α_h).comp (Abelian.Ext.mapExactFunctor R_sh x) (Nat.zero_add q)).comp
            (Abelian.Ext.mk₀ β_h) (Nat.add_zero q)))
        (Nat.zero_add q)).comp (Abelian.Ext.mk₀ βM₁) (Nat.add_zero q) = _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (U_std₁.map α_h)) _ _
        (Nat.zero_add q) (Nat.add_zero q) (by omega),
      ext_conj_eq, hMod_comm,
      ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ηℤ₁ ≫ U_std₁.map α_h)) _ _
        (Nat.zero_add q) (Nat.add_zero q) (by omega),
      ext_conj_eq]

  have hRHS : p_q (θ₂ x) =
      (Abelian.Ext.mk₀ ((ιℤ_pull ≫ P_pull.map ηℤ₂) ≫ η_pull.hom.app Z_obj)).comp
        ((Abelian.Ext.mapExactFunctor R_h_ab w).comp
          (Abelian.Ext.mk₀ (η_pull.inv.app Z_obj ≫ P_pull.map βM₂ ≫ π'_of AM)) (Nat.add_zero q))
        (Nat.zero_add q) := by
    rw [hp_eq (θ₂ x), hθ₂_eq x]
    change ((Abelian.Ext.mk₀ ιℤ_pull).comp
        (Abelian.Ext.mapExactFunctor P_pull
          (((Abelian.Ext.mk₀ ηℤ₂).comp w (Nat.zero_add q)).comp
            (Abelian.Ext.mk₀ βM₂) (Nat.add_zero q)))
        (Nat.zero_add q)).comp (Abelian.Ext.mk₀ (π'_of AM)) (Nat.add_zero q) = _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (P_pull.map ηℤ₂)) _ _
        (Nat.zero_add q) (Nat.add_zero q) (by omega),
      ext_conj_eq,
      step2_extIso R_h_ab P_pull η_pull.symm w]
    change (Abelian.Ext.mk₀ (ιℤ_pull ≫ P_pull.map ηℤ₂)).comp
        (((Abelian.Ext.mk₀ (η_pull.hom.app Z_obj)).comp
          ((Abelian.Ext.mapExactFunctor R_h_ab w).comp
            (Abelian.Ext.mk₀ (η_pull.inv.app Z_obj)) (Nat.add_zero q))
          (Nat.zero_add q)).comp
          (Abelian.Ext.mk₀ (P_pull.map βM₂ ≫ π'_of AM)) (Nat.add_zero q))
        (Nat.zero_add q) = _
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ιℤ_pull ≫ P_pull.map ηℤ₂)) _ _
        (Nat.zero_add q) (Nat.add_zero q) (by omega),
      ext_conj_eq]

  rw [hLHS, hRHS, hEq_L, hEq_R]

theorem weil_etale_local_freeYoneda_mod_and_slice_ext_iso (S : AlgebraicGeometry.Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∃ θ_loc : ∀ (W : S.Etale) (q : ℕ),
        weilCupPDLocalModH S ℓ W q →+ weilEtaleLocalTorsionH S ℓ W q,
      (∀ (W : S.Etale) (q : ℕ), Function.Bijective (θ_loc W q)) ∧
      (∀ {W₁ W₂ : S.Etale} (v : Quiver.Hom W₁ W₂) (q : ℕ)
          (z : weilCupPDLocalModH S ℓ W₁ q),
        θ_loc W₂ q
          (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S ℓ v))
            (Nat.add_zero q)) =
          weilEtaleLocalTorsionMapH S ℓ v q (θ_loc W₁ q z))) ∧
    (∃ ψ_slice : ∀ (W : S.Etale) (q : ℕ),
        CategoryTheory.Abelian.Ext.{u}
          (weilCupPDLocalFreeSheaf S ℓ W) (weilCupPDModUnit S ℓ) q →+
          weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left ℓ q,
      (∀ (W : S.Etale) (q : ℕ), Function.Bijective (ψ_slice W q)) ∧
      (∀ {W₁ W₂ : S.Etale} (v : Quiver.Hom W₁ W₂) (q : ℕ)
          (p_q : weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₂).left ℓ q →+
            weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left ℓ q),
        WeilIsTorsionEtalePullback
          ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ℓ q p_q →
        ∀ ξ : CategoryTheory.Abelian.Ext.{u}
            (weilCupPDLocalFreeSheaf S ℓ W₂) (weilCupPDModUnit S ℓ) q,
          ψ_slice W₁ q
            ((CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S ℓ v)).comp
              ξ (Nat.zero_add q)) =
            p_q (ψ_slice W₂ q ξ))) :=
by
  refine ⟨weil_etale_local_freeYoneda_mod_to_torsion_ext_iso S ℓ, ?_⟩
  obtain ⟨Φ_slice, hΦ_bij, hΦ_nat⟩ := weil_etale_slice_freeYoneda_mod_ext_iso S ℓ
  have hMod1 := weil_etale_module_ext_comparison.{u}.1
  let θ_mod : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      weilEtaleModuleH Y ℓ q →+ weilEtaleTorsionH Y ℓ q :=
    fun Y q => Classical.choose (hMod1 Y ℓ q).1
  have hθ_mod_spec : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      WeilIsModuleToTorsionComparison Y ℓ q (θ_mod Y q) :=
    fun Y q => (Classical.choose_spec (hMod1 Y ℓ q).1).1
  have hθ_mod_bij : ∀ (Y : AlgebraicGeometry.Scheme.{u}) (q : ℕ),
      Function.Bijective (θ_mod Y q) :=
    fun Y q => (Classical.choose_spec (hMod1 Y ℓ q).1).2
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let ψ_slice : ∀ (W : S.Etale) (q : ℕ),
      CategoryTheory.Abelian.Ext.{u}
        (weilCupPDLocalFreeSheaf S ℓ W) (weilCupPDModUnit S ℓ) q →+
        weilEtaleTorsionH (Fgt.obj W).left ℓ q :=
    fun W q => (θ_mod (Fgt.obj W).left q).comp (Φ_slice W q)
  refine ⟨ψ_slice, fun W q => (hθ_mod_bij (Fgt.obj W).left q).comp (hΦ_bij W q), ?_⟩
  intro W₁ W₂ v q p_q hp_q ξ
  let h : Quiver.Hom (Fgt.obj W₁).left (Fgt.obj W₂).left := (Fgt.map v).left
  have hv : AlgebraicGeometry.Etale h :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      h (Fgt.obj W₂).hom W₂.prop
      (by
        change AlgebraicGeometry.Etale (v.left ≫ W₂.hom)
        rw [CategoryTheory.MorphismProperty.Over.w v]
        exact W₁.prop)
  obtain ⟨r_q, hr_q, hΦ_v⟩ := hΦ_nat v hv q
  calc
    ψ_slice W₁ q
        ((CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S ℓ v)).comp
          ξ (Nat.zero_add q))
      = θ_mod (Fgt.obj W₁).left q
          (Φ_slice W₁ q
            ((CategoryTheory.Abelian.Ext.mk₀ (weilCupPDLocalFreeMap S ℓ v)).comp
              ξ (Nat.zero_add q))) := rfl
    _ = θ_mod (Fgt.obj W₁).left q (r_q (Φ_slice W₂ q ξ)) := by rw [hΦ_v ξ]
    _ = p_q (θ_mod (Fgt.obj W₂).left q (Φ_slice W₂ q ξ)) :=
          weil_etale_mod_restriction_eq_torsion_pullback h hv ℓ q
            r_q hr_q
            (θ_mod (Fgt.obj W₁).left q) (hθ_mod_spec (Fgt.obj W₁).left q)
            (θ_mod (Fgt.obj W₂).left q) (hθ_mod_spec (Fgt.obj W₂).left q)
            p_q hp_q (Φ_slice W₂ q ξ)
    _ = p_q (ψ_slice W₂ q ξ) := rfl

theorem weil_etale_connected_unit_end_and_geom_point_lift (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S]
    (m : ℕ) (hm : 1 ≤ m) :
    let R := ULift.{u, 0} (ZMod m)
    let J := S.smallEtaleTopology
    let oneR := weilEtaleModuleUnit S m
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    Function.Bijective (fun c : ZMod m =>
      c.val • CategoryTheory.CategoryStruct.id oneR) ∧
    (∀ (U : S.Etale) (y : ↥((Fgt.obj U).left)),
      let x : ↥S := ((Fgt.obj U).hom).base y
      let κ := S.residueField x
      let Ω := AlgebraicClosure ↥κ
      let gx : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
          (S.fromSpecResidueField x)
      ∃ (γ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) (Fgt.obj U).left)
        (pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        CategoryTheory.CategoryStruct.comp γ (Fgt.obj U).hom = gx ∧
        γ.base pt = y) ∧
    (∀ (U : S.Etale) (s : ↑(oneR.obj.obj (Opposite.op U))) (y : ↥((Fgt.obj U).left)),
      ∃ (U₀ : S.Etale) (u₀ : Quiver.Hom U₀ U) (y₀ : ↥((Fgt.obj U₀).left)) (c : ZMod m),
        ((Fgt.map u₀).left).base y₀ = y ∧
        (oneR.obj.map (Opposite.op u₀)).hom s =
          (((CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).unit.app
            ((CategoryTheory.Functor.const (Opposite S.Etale)).obj (ModuleCat.of R R))).app
            (Opposite.op U₀)).hom (ULift.up c)) :=
by
  classical
  intro R J oneR Fgt
  let R_mod : ModuleCat.{u, u} R := ModuleCat.of R R
  let P_const : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R) :=
    (CategoryTheory.Functor.const (Opposite S.Etale)).obj R_mod
  let adj_sh := CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)
  let η_sh : Quiver.Hom P_const oneR.obj := adj_sh.unit.app P_const
  
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
      (@AlgebraicGeometry.Etale)).toIsStableUnderComposition
  have _ : CategoryTheory.MorphismProperty.ContainsIdentities (@AlgebraicGeometry.Etale) :=
    (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
      (@AlgebraicGeometry.Etale)).toContainsIdentities
  have hEtale_left : ∀ {U₁ U₂ : S.Etale} (f : Quiver.Hom U₁ U₂),
      AlgebraicGeometry.Etale f.left := by
    intro U₁ U₂ f
    have hw : CategoryTheory.CategoryStruct.comp f.left U₂.hom = U₁.hom :=
      CategoryTheory.MorphismProperty.Over.w f
    exact CategoryTheory.MorphismProperty.of_postcomp
      (@AlgebraicGeometry.Etale) f.left U₂.hom U₂.prop (by rw [hw]; exact U₁.prop)
  have hJ_eq : J = S.smallEtalePretopology.toGrothendieck :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S le_rfl
  have hJ_mem : ∀ (U : S.Etale) (S_sieve : CategoryTheory.Sieve U),
      S_sieve ∈ J U ↔
        ∀ x : ↥U.left, ∃ (V : S.Etale) (f : Quiver.Hom V U) (y : ↥V.left),
          S_sieve.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro U S_sieve
    rw [hJ_eq]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U S_sieve
  have hArrows_mem : ∀ (U : S.Etale) {ι : Type u} (Y : ι → S.Etale)
      (π : ∀ i : ι, Quiver.Hom (Y i) U),
      (∀ x : ↥U.left, ∃ i : ι, x ∈ Set.range ⇑(π i).left.base) →
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y π) ∈ J U := by
    intro U ι Y π hcov
    rw [hJ_mem]
    intro x
    obtain ⟨i, y, hy⟩ := hcov x
    exact ⟨Y i, π i, y,
      CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows Y π) (Y i) (π i)
        (CategoryTheory.Presieve.ofArrows.mk i),
      hEtale_left (π i), hy⟩
  let L_pre : CategoryTheory.Functor (Opposite S.Etale) (ModuleCat.{u, u} R) :=
    { obj := fun U => ModuleCat.of R (LocallyConstant ↥((Fgt.obj U.unop).left) R)
      map := fun u => ModuleCat.ofHom
        (LocallyConstant.comapₗ R ((Fgt.map u.unop).left).base.hom)
      map_id := fun U => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro f
        apply LocallyConstant.ext
        intro x
        rfl
      map_comp := fun u v => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro f
        apply LocallyConstant.ext
        intro x
        rfl }
  let asLC : ∀ {V : S.Etale},
      (L_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)).obj (Opposite.op V) →
      LocallyConstant ↥V.left R := fun v => v
  have hSheaf_type : CategoryTheory.Presieve.IsSheaf J
      (L_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) := by
    intro U S_sieve hS fam hcompat
    have hSurj : ∀ x : ↥U.left, ∃ (V : S.Etale) (g : Quiver.Hom V U) (y : ↥V.left),
        S_sieve.arrows g ∧ AlgebraicGeometry.Etale g.left ∧ g.left.base y = x :=
      (hJ_mem U S_sieve).mp hS
    have hFiber : ∀ {V₁ V₂ : S.Etale} (g₁ : Quiver.Hom V₁ U) (g₂ : Quiver.Hom V₂ U)
        (hg₁ : S_sieve.arrows g₁) (hg₂ : S_sieve.arrows g₂)
        (y₁ : ↥V₁.left) (y₂ : ↥V₂.left),
        g₁.left.base y₁ = g₂.left.base y₂ →
        asLC (fam g₁ hg₁) y₁ = asLC (fam g₂ hg₂) y₂ := by
      intro V₁ V₂ g₁ g₂ hg₁ hg₂ y₁ y₂ hy_eq
      let W₀ := CategoryTheory.Limits.pullback g₁.left g₂.left
      let p₁ : Quiver.Hom W₀ V₁.left := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
      let p₂ : Quiver.Hom W₀ V₂.left := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
      have hp₂_et : AlgebraicGeometry.Etale p₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback g₁.left g₂.left) (hEtale_left g₁)
      have hW_et : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp p₂ V₂.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          p₂ V₂.hom hp₂_et V₂.prop
      let W : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp p₂ V₂.hom) hW_et
      have hp₁_w : CategoryTheory.CategoryStruct.comp p₁ V₁.hom = W.hom := by
        change p₁ ≫ V₁.hom = p₂ ≫ V₂.hom
        rw [← CategoryTheory.MorphismProperty.Over.w g₁,
          ← CategoryTheory.MorphismProperty.Over.w g₂,
          CategoryTheory.Limits.pullback.condition_assoc]
      let π₁ : Quiver.Hom W V₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ hp₁_w
      let π₂ : Quiver.Hom W V₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ rfl
      have hπ_comm : CategoryTheory.CategoryStruct.comp π₁ g₁ =
          CategoryTheory.CategoryStruct.comp π₂ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Limits.pullback.condition (f := g₁.left) (g := g₂.left))
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy_eq
      have h_pull := hcompat π₁ π₂ hg₁ hg₂ hπ_comm
      have h_ev := congrArg (fun φ => asLC φ z) h_pull
      change asLC (fam g₁ hg₁) (p₁.base z) = asLC (fam g₂ hg₂) (p₂.base z) at h_ev
      rwa [hz₁, hz₂] at h_ev
    let s_fn : ↥U.left → R := fun x =>
      let V := Classical.choose (hSurj x)
      let g := Classical.choose (Classical.choose_spec (hSurj x))
      let y := Classical.choose (Classical.choose_spec (Classical.choose_spec (hSurj x)))
      let hg := (Classical.choose_spec (Classical.choose_spec
        (Classical.choose_spec (hSurj x)))).1
      asLC (fam g hg) y
    have hs_fn_eq : ∀ {V : S.Etale} (g : Quiver.Hom V U) (hg : S_sieve.arrows g)
        (y : ↥V.left),
        s_fn (g.left.base y) = asLC (fam g hg) y := by
      intro V g hg y
      let x := g.left.base y
      let hspec := Classical.choose_spec (Classical.choose_spec
        (Classical.choose_spec (hSurj x)))
      exact hFiber _ g hspec.1 hg _ y hspec.2.2
    have hs_lc : IsLocallyConstant s_fn := by
      intro E
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      obtain ⟨V, g, y, hg, hg_et, rfl⟩ := hSurj x
      let f_g : LocallyConstant ↥V.left R := asLC (fam g hg)
      refine ⟨⇑g.left.base '' (f_g ⁻¹' E), ?_, ?_, ?_⟩
      · rintro _ ⟨y', hy', rfl⟩
        change s_fn (g.left.base y') ∈ E
        rw [hs_fn_eq g hg y']
        exact hy'
      · have _ : AlgebraicGeometry.Etale g.left := hg_et
        exact g.left.isOpenMap _ (f_g.isLocallyConstant E)
      · refine ⟨y, ?_, rfl⟩
        change f_g y ∈ E
        rw [← hs_fn_eq g hg y]
        exact hx
    let s₀ : LocallyConstant ↥((Fgt.obj U).left) R := ⟨s_fn, hs_lc⟩
    refine ⟨s₀, ?_, ?_⟩
    · intro V g hg
      apply LocallyConstant.ext
      intro y
      exact hs_fn_eq g hg y
    · intro t ht
      apply LocallyConstant.ext
      intro x
      obtain ⟨V, g, y, hg, -, rfl⟩ := hSurj x
      have ht_ev := congrArg (fun φ => asLC φ y) (ht g hg)
      have ht_lhs : asLC ((L_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)).map
          (Opposite.op g) t) y = asLC t (g.left.base y) := rfl
      exact (ht_lhs.symm.trans ht_ev).trans (hs_fn_eq g hg y).symm
  have hL_sheaf : CategoryTheory.Presheaf.IsSheaf J L_pre := by
    intro E U S_sieve hS x hx
    have hFor := hSheaf_type S_sieve hS
    let fam_e : ↑E → CategoryTheory.Presieve.FamilyOfElements
        (L_pre ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) S_sieve.arrows :=
      fun e _ g hg => (x g hg).hom e
    have hx_pt : ∀ e : ↑E, (fam_e e).Compatible := by
      intro e Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      have h1 := hx g₁ g₂ hf₁ hf₂ hcomm
      exact congrArg (fun (φ : Quiver.Hom E _) => φ.hom e) h1
    let t_fn : ↑E → LocallyConstant ↥((Fgt.obj U).left) R :=
      fun e => Classical.choose (hFor (fam_e e) (hx_pt e))
    have ht_spec : ∀ (e : ↑E) {V : S.Etale} (g : Quiver.Hom V U) (hg : S_sieve.arrows g),
        (L_pre.map (Opposite.op g)).hom (t_fn e) = (x g hg).hom e :=
      fun e _ g hg => (Classical.choose_spec (hFor (fam_e e) (hx_pt e))).1 g hg
    have ht_uniq : ∀ (e : ↑E) (y : LocallyConstant ↥((Fgt.obj U).left) R),
        (∀ {V : S.Etale} (g : Quiver.Hom V U) (hg : S_sieve.arrows g),
          (L_pre.map (Opposite.op g)).hom y = (x g hg).hom e) →
        y = t_fn e :=
      fun e y hy => (Classical.choose_spec (hFor (fam_e e) (hx_pt e))).2 y (fun _ g hg => hy g hg)
    have ht_add : ∀ e₁ e₂ : ↑E, t_fn (e₁ + e₂) = t_fn e₁ + t_fn e₂ := by
      intro e₁ e₂
      symm
      apply ht_uniq (e₁ + e₂)
      intro V g hg
      rw [map_add, ht_spec e₁ g hg, ht_spec e₂ g hg, ← map_add]
    have ht_smul : ∀ (r : R) (e : ↑E), t_fn (r • e) = r • t_fn e := by
      intro r e
      symm
      apply ht_uniq (r • e)
      intro V g hg
      rw [map_smul, ht_spec e g hg, ← map_smul]
    let t_hom : Quiver.Hom E (L_pre.obj (Opposite.op U)) :=
      ModuleCat.ofHom
        { toFun := t_fn
          map_add' := ht_add
          map_smul' := ht_smul }
    refine ⟨t_hom, ?_, ?_⟩
    · intro V g hg
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro e
      exact ht_spec e g hg
    · intro y_hom hy
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro e
      apply ht_uniq e (y_hom.hom e)
      intro V g hg
      exact congrArg (fun (φ : Quiver.Hom E _) => φ.hom e) (hy g hg)
  let L_sh : CategoryTheory.Sheaf J (ModuleCat.{u, u} R) := ⟨L_pre, hL_sheaf⟩
  let ι_lc : Quiver.Hom P_const L_pre :=
    { app := fun U => ModuleCat.ofHom (LocallyConstant.constₗ R)
      naturality := fun U₁ U₂ u => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro r
        apply LocallyConstant.ext
        intro z
        rfl }
  let Φ : Quiver.Hom oneR L_sh := (adj_sh.homEquiv P_const L_sh).symm ι_lc
  let ev_lc : ∀ U : S.Etale,
      ↑(oneR.obj.obj (Opposite.op U)) →ₗ[R] LocallyConstant ↥((Fgt.obj U).left) R :=
    fun U => (Φ.hom.app (Opposite.op U)).hom
  have hΦ_unit : CategoryTheory.CategoryStruct.comp η_sh Φ.hom = ι_lc := by
    have h1 : (adj_sh.homEquiv P_const L_sh) Φ = ι_lc :=
      (adj_sh.homEquiv P_const L_sh).apply_symm_apply ι_lc
    exact (CategoryTheory.Adjunction.homEquiv_unit adj_sh P_const L_sh Φ).symm.trans h1
  have h_res : ∀ {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂)
      (s : ↑(oneR.obj.obj (Opposite.op U₂))) (z : ↥((Fgt.obj U₁).left)),
      ev_lc U₁ ((oneR.obj.map (Opposite.op u)).hom s) z =
        ev_lc U₂ s (((Fgt.map u).left).base z) := by
    intro U₁ U₂ u s z
    have hnat := Φ.hom.naturality (Opposite.op u)
    exact congrArg (fun (φ : Quiver.Hom (oneR.obj.obj (Opposite.op U₂))
      (L_pre.obj (Opposite.op U₁))) =>
      (φ.hom s : LocallyConstant ↥((Fgt.obj U₁).left) R) z) hnat
  have h_unit : ∀ (U : S.Etale) (r : R) (z : ↥((Fgt.obj U).left)),
      ev_lc U ((η_sh.app (Opposite.op U)).hom r) z = r := by
    intro U r z
    exact congrArg (fun (τ : Quiver.Hom P_const L_pre) =>
      ((τ.app (Opposite.op U)).hom r : LocallyConstant ↥((Fgt.obj U).left) R) z) hΦ_unit
  have hOne_sheaf_cat : CategoryTheory.Presheaf.IsSheaf J
      (oneR.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) :=
    CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J oneR.obj
      (CategoryTheory.forget (ModuleCat.{u, u} R)) oneR.property
  have hOne_type : CategoryTheory.Presieve.IsSheaf J
      (oneR.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type J _).mp hOne_sheaf_cat
  have hArrows_sheaf : ∀ (U : S.Etale) {ι : Type u} (Y : ι → S.Etale)
      (π : ∀ i : ι, Quiver.Hom (Y i) U),
      (∀ x : ↥U.left, ∃ i : ι, x ∈ Set.range ⇑(π i).left.base) →
      ∀ (sec : ∀ i : ι, ↑(oneR.obj.obj (Opposite.op (Y i)))),
      (∀ (i j : ι) (Z : S.Etale) (g₁ : Quiver.Hom Z (Y i)) (g₂ : Quiver.Hom Z (Y j)),
        CategoryTheory.CategoryStruct.comp g₁ (π i) =
          CategoryTheory.CategoryStruct.comp g₂ (π j) →
        (oneR.obj.map (Opposite.op g₁)).hom (sec i) =
          (oneR.obj.map (Opposite.op g₂)).hom (sec j)) →
      ∃! t : ↑(oneR.obj.obj (Opposite.op U)),
        ∀ i : ι, (oneR.obj.map (Opposite.op (π i))).hom t = sec i := by
    intro U ι Y π hcov sec hsec
    have hmem := hArrows_mem U Y π hcov
    have hFor : CategoryTheory.Presieve.IsSheafFor
        (oneR.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R))
        (CategoryTheory.Presieve.ofArrows Y π) :=
      CategoryTheory.Presieve.IsSheaf.isSheafFor hOne_type
        (CategoryTheory.Presieve.ofArrows Y π) hmem
    rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hFor
    exact hFor sec hsec
  have hEmpty_sub : ∀ (Z : S.Etale), IsEmpty ↥Z.left →
      Subsingleton ↑(oneR.obj.obj (Opposite.op Z)) := by
    intro Z hZ
    refine ⟨fun s₁ s₂ => ?_⟩
    obtain ⟨t, -, ht_uniq⟩ := hArrows_sheaf Z (ι := PEmpty.{u + 1})
      PEmpty.elim (fun i => PEmpty.elim i) (fun x => IsEmpty.elim hZ x)
      (fun i => PEmpty.elim i) (fun i => PEmpty.elim i)
    have h1 : s₁ = t := ht_uniq s₁ (fun i => PEmpty.elim i)
    have h2 : s₂ = t := ht_uniq s₂ (fun i => PEmpty.elim i)
    exact h1.trans h2.symm
  have hη_map : ∀ {U₁ U₂ : S.Etale} (g : Quiver.Hom U₁ U₂) (r : R),
      (oneR.obj.map (Opposite.op g)).hom ((η_sh.app (Opposite.op U₂)).hom r) =
        (η_sh.app (Opposite.op U₁)).hom r := by
    intro U₁ U₂ g r
    have hnat := η_sh.naturality (Opposite.op g)
    exact (congrArg (fun (φ : Quiver.Hom R_mod _) => φ.hom r) hnat).symm
  have hSheaf_ext : ∀ (α₁ α₂ : Quiver.Hom oneR oneR),
      CategoryTheory.CategoryStruct.comp η_sh α₁.hom =
        CategoryTheory.CategoryStruct.comp η_sh α₂.hom →
      α₁ = α₂ := by
    intro α₁ α₂ h_eq
    let oneR' : CategoryTheory.Sheaf J (ModuleCat.{u, u} R) :=
      (CategoryTheory.presheafToSheaf J (ModuleCat.{u, u} R)).obj P_const
    let α₁' : Quiver.Hom oneR' oneR := α₁
    let α₂' : Quiver.Hom oneR' oneR := α₂
    apply (adj_sh.homEquiv P_const oneR).injective
    exact (CategoryTheory.Adjunction.homEquiv_unit adj_sh P_const oneR α₁').trans
      (h_eq.trans (CategoryTheory.Adjunction.homEquiv_unit adj_sh P_const oneR α₂').symm)
  let W_open : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
      (x : ↥((Fgt.obj U).left)), U.left.Opens :=
    fun U f x => ⟨(f : ↥U.left → R) ⁻¹' {f x}, f.isLocallyConstant {f x}⟩
  let Y_lvl : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
      (x : ↥((Fgt.obj U).left)), S.Etale :=
    fun U f x => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp (W_open U f x).ι U.hom)
      (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (W_open U f x).ι U.hom inferInstance U.prop)
  let π_lvl : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
      (x : ↥((Fgt.obj U).left)), Quiver.Hom (Y_lvl U f x) U :=
    fun U f x => CategoryTheory.MorphismProperty.Over.homMk (W_open U f x).ι rfl
  have hlvl_cov : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R) (x : ↥U.left),
      ∃ i : ↥((Fgt.obj U).left), x ∈ Set.range ⇑(π_lvl U f i).left.base :=
    fun U f x => ⟨x, ⟨x, rfl⟩, rfl⟩
  have hψ_ex : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R),
      ∃! t : ↑(oneR.obj.obj (Opposite.op U)),
        ∀ x : ↥((Fgt.obj U).left),
          (oneR.obj.map (Opposite.op (π_lvl U f x))).hom t =
            (η_sh.app (Opposite.op (Y_lvl U f x))).hom (f x) := by
    intro U f
    apply hArrows_sheaf U (Y_lvl U f) (π_lvl U f) (hlvl_cov U f)
    intro x₁ x₂ Z g₁ g₂ hcomm
    by_cases hZ : IsEmpty ↥Z.left
    · have _ := hEmpty_sub Z hZ
      exact Subsingleton.elim _ _
    · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hZ
      have hz₁ : f (((CategoryTheory.CategoryStruct.comp g₁ (π_lvl U f x₁)).left).base z₀) =
          f x₁ := (g₁.left.base z₀).2
      have hz₂ : f (((CategoryTheory.CategoryStruct.comp g₂ (π_lvl U f x₂)).left).base z₀) =
          f x₂ := (g₂.left.base z₀).2
      have hfx : f x₁ = f x₂ := by
        rw [← hz₁, ← hz₂, hcomm]
      rw [hη_map g₁ (f x₁), hη_map g₂ (f x₂), hfx]
  let ψ_fun : ∀ (U : S.Etale), LocallyConstant ↥((Fgt.obj U).left) R →
      ↑(oneR.obj.obj (Opposite.op U)) :=
    fun U f => Classical.choose (hψ_ex U f)
  have hψ_spec : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
      (x : ↥((Fgt.obj U).left)),
      (oneR.obj.map (Opposite.op (π_lvl U f x))).hom (ψ_fun U f) =
        (η_sh.app (Opposite.op (Y_lvl U f x))).hom (f x) :=
    fun U f => (Classical.choose_spec (hψ_ex U f)).1
  have hψ_uniq : ∀ (U : S.Etale) (f : LocallyConstant ↥((Fgt.obj U).left) R)
      (t : ↑(oneR.obj.obj (Opposite.op U))),
      (∀ x : ↥((Fgt.obj U).left),
        (oneR.obj.map (Opposite.op (π_lvl U f x))).hom t =
          (η_sh.app (Opposite.op (Y_lvl U f x))).hom (f x)) →
      t = ψ_fun U f :=
    fun U f => (Classical.choose_spec (hψ_ex U f)).2
  have hOne_map_comp : ∀ {U₁ U₂ U₃ : S.Etale} (a : Quiver.Hom U₁ U₂) (b : Quiver.Hom U₂ U₃)
      (s : ↑(oneR.obj.obj (Opposite.op U₃))),
      (oneR.obj.map (Opposite.op (CategoryTheory.CategoryStruct.comp a b))).hom s =
        (oneR.obj.map (Opposite.op a)).hom ((oneR.obj.map (Opposite.op b)).hom s) := by
    intro U₁ U₂ U₃ a b s
    have hop : Opposite.op (CategoryTheory.CategoryStruct.comp a b) =
        CategoryTheory.CategoryStruct.comp
          (X := Opposite.op U₃) (Y := Opposite.op U₂) (Z := Opposite.op U₁)
          (Opposite.op b) (Opposite.op a) := rfl
    rw [hop, CategoryTheory.Functor.map_comp]
    rfl
  have hψ_const : ∀ {V U : S.Etale} (g : Quiver.Hom V U)
      (f : LocallyConstant ↥((Fgt.obj U).left) R) (r : R),
      (∀ y : ↥V.left, f (g.left.base y) = r) →
      (oneR.obj.map (Opposite.op g)).hom (ψ_fun U f) =
        (η_sh.app (Opposite.op V)).hom r := by
    intro V U g f r hconst
    by_cases hV : IsEmpty ↥V.left
    · have _ := hEmpty_sub V hV
      exact Subsingleton.elim _ _
    · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hV
      let x₀ : ↥((Fgt.obj U).left) := g.left.base y₀
      have hrx₀ : f x₀ = r := hconst y₀
      let W₀ : U.left.Opens := W_open U f x₀
      have hrange : Set.range ⇑g.left.base ⊆ Set.range ⇑W₀.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨y, rfl⟩
        change f (g.left.base y) = f x₀
        rw [hconst y, hrx₀]
      let l_left : Quiver.Hom V.left W₀.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift W₀.ι g.left hrange
      have hl_fac : CategoryTheory.CategoryStruct.comp l_left W₀.ι = g.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac W₀.ι g.left hrange
      have hl_w : CategoryTheory.CategoryStruct.comp l_left (Y_lvl U f x₀).hom = V.hom := by
        have h1 : CategoryTheory.CategoryStruct.comp l_left
            (CategoryTheory.CategoryStruct.comp W₀.ι U.hom) = V.hom := by
          rw [← CategoryTheory.Category.assoc, hl_fac]
          exact CategoryTheory.MorphismProperty.Over.w g
        exact h1
      let l : Quiver.Hom V (Y_lvl U f x₀) :=
        CategoryTheory.MorphismProperty.Over.homMk l_left hl_w
      have hl_eq : CategoryTheory.CategoryStruct.comp l (π_lvl U f x₀) = g :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hl_fac
      calc
        (oneR.obj.map (Opposite.op g)).hom (ψ_fun U f)
          = (oneR.obj.map (Opposite.op (CategoryTheory.CategoryStruct.comp l (π_lvl U f x₀)))).hom
              (ψ_fun U f) := by rw [hl_eq]
        _ = (oneR.obj.map (Opposite.op l)).hom
              ((oneR.obj.map (Opposite.op (π_lvl U f x₀))).hom (ψ_fun U f)) :=
              hOne_map_comp l (π_lvl U f x₀) (ψ_fun U f)
        _ = (oneR.obj.map (Opposite.op l)).hom
              ((η_sh.app (Opposite.op (Y_lvl U f x₀))).hom (f x₀)) :=
              congrArg (oneR.obj.map (Opposite.op l)).hom (hψ_spec U f x₀)
        _ = (η_sh.app (Opposite.op V)).hom (f x₀) := hη_map l (f x₀)
        _ = (η_sh.app (Opposite.op V)).hom r := by rw [hrx₀]
  have hψ_add : ∀ (U : S.Etale) (f₁ f₂ : LocallyConstant ↥((Fgt.obj U).left) R),
      ψ_fun U (f₁ + f₂) = ψ_fun U f₁ + ψ_fun U f₂ := by
    intro U f₁ f₂
    let W₁₂ : ↥U.left → U.left.Opens := fun x =>
      ⟨(f₁ : ↥U.left → R) ⁻¹' {f₁ x} ∩ (f₂ : ↥U.left → R) ⁻¹' {f₂ x},
        (f₁.isLocallyConstant {f₁ x}).inter (f₂.isLocallyConstant {f₂ x})⟩
    let Y₁₂ : ↥U.left → S.Etale := fun x =>
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp (W₁₂ x).ι U.hom)
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (W₁₂ x).ι U.hom inferInstance U.prop)
    let π₁₂ : ∀ x : ↥U.left, Quiver.Hom (Y₁₂ x) U := fun x =>
      CategoryTheory.MorphismProperty.Over.homMk (W₁₂ x).ι rfl
    have hcov₁₂ : ∀ x : ↥U.left, ∃ i : ↥U.left, x ∈ Set.range ⇑(π₁₂ i).left.base :=
      fun x => ⟨x, ⟨x, ⟨rfl, rfl⟩⟩, rfl⟩
    obtain ⟨t, -, ht_uniq⟩ := hArrows_sheaf U Y₁₂ π₁₂ hcov₁₂
      (fun x => (η_sh.app (Opposite.op (Y₁₂ x))).hom (f₁ x + f₂ x))
      (fun x₁ x₂ Z g₁ g₂ hcomm => by
        by_cases hZ : IsEmpty ↥Z.left
        · have _ := hEmpty_sub Z hZ
          exact Subsingleton.elim _ _
        · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hZ
          have h1 : f₁ (((CategoryTheory.CategoryStruct.comp g₁ (π₁₂ x₁)).left).base z₀) = f₁ x₁ ∧
              f₂ (((CategoryTheory.CategoryStruct.comp g₁ (π₁₂ x₁)).left).base z₀) = f₂ x₁ :=
            (g₁.left.base z₀).2
          have h2 : f₁ (((CategoryTheory.CategoryStruct.comp g₂ (π₁₂ x₂)).left).base z₀) = f₁ x₂ ∧
              f₂ (((CategoryTheory.CategoryStruct.comp g₂ (π₁₂ x₂)).left).base z₀) = f₂ x₂ :=
            (g₂.left.base z₀).2
          have hf₁_eq : f₁ x₁ = f₁ x₂ := by rw [← h1.1, ← h2.1, hcomm]
          have hf₂_eq : f₂ x₁ = f₂ x₂ := by rw [← h1.2, ← h2.2, hcomm]
          rw [hη_map g₁, hη_map g₂, hf₁_eq, hf₂_eq])
    have hLHS : ψ_fun U (f₁ + f₂) = t := by
      apply ht_uniq
      intro x
      exact hψ_const (π₁₂ x) (f₁ + f₂) (f₁ x + f₂ x)
        (fun y => congrArg₂ (· + ·) y.2.1 y.2.2)
    have hRHS : ψ_fun U f₁ + ψ_fun U f₂ = t := by
      apply ht_uniq
      intro x
      rw [map_add,
        hψ_const (π₁₂ x) f₁ (f₁ x) (fun y => y.2.1),
        hψ_const (π₁₂ x) f₂ (f₂ x) (fun y => y.2.2),
        ← map_add]
    exact hLHS.trans hRHS.symm
  have hψ_smul : ∀ (U : S.Etale) (r : R) (f : LocallyConstant ↥((Fgt.obj U).left) R),
      ψ_fun U (r • f) = r • ψ_fun U f := by
    intro U r f
    obtain ⟨t, -, ht_uniq⟩ := hArrows_sheaf U (Y_lvl U f) (π_lvl U f) (hlvl_cov U f)
      (fun x => (η_sh.app (Opposite.op (Y_lvl U f x))).hom (r • f x))
      (fun x₁ x₂ Z g₁ g₂ hcomm => by
        by_cases hZ : IsEmpty ↥Z.left
        · have _ := hEmpty_sub Z hZ
          exact Subsingleton.elim _ _
        · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hZ
          have hz₁ : f (((CategoryTheory.CategoryStruct.comp g₁ (π_lvl U f x₁)).left).base z₀) =
              f x₁ := (g₁.left.base z₀).2
          have hz₂ : f (((CategoryTheory.CategoryStruct.comp g₂ (π_lvl U f x₂)).left).base z₀) =
              f x₂ := (g₂.left.base z₀).2
          have hfx : f x₁ = f x₂ := by rw [← hz₁, ← hz₂, hcomm]
          rw [hη_map g₁, hη_map g₂, hfx])
    have hLHS : ψ_fun U (r • f) = t := by
      apply ht_uniq
      intro x
      exact hψ_const (π_lvl U f x) (r • f) (r • f x)
        (fun y => congrArg (r • ·) y.2)
    have hRHS : r • ψ_fun U f = t := by
      apply ht_uniq
      intro x
      exact ((oneR.obj.map (Opposite.op (π_lvl U f x))).hom.map_smul r (ψ_fun U f)).trans
        ((congrArg (r • ·) (hψ_spec U f x)).trans
          ((η_sh.app (Opposite.op (Y_lvl U f x))).hom.map_smul r (f x)).symm)
    exact hLHS.trans hRHS.symm
  have hψ_nat : ∀ {U₁ U₂ : S.Etale} (u : Quiver.Hom U₁ U₂)
      (f : LocallyConstant ↥((Fgt.obj U₂).left) R),
      (oneR.obj.map (Opposite.op u)).hom (ψ_fun U₂ f) =
        ψ_fun U₁ ((L_pre.map (Opposite.op u)).hom f) := by
    intro U₁ U₂ u f
    let f₁ : LocallyConstant ↥((Fgt.obj U₁).left) R := (L_pre.map (Opposite.op u)).hom f
    apply hψ_uniq U₁ f₁
    intro x₁
    exact (hOne_map_comp (π_lvl U₁ f₁ x₁) u (ψ_fun U₂ f)).symm.trans
      (hψ_const (CategoryTheory.CategoryStruct.comp (π_lvl U₁ f₁ x₁) u) f (f₁ x₁)
        (fun y => y.2))
  let Ψ_nat : Quiver.Hom L_pre oneR.obj :=
    { app := fun U => ModuleCat.ofHom
        { toFun := ψ_fun U.unop
          map_add' := hψ_add U.unop
          map_smul' := hψ_smul U.unop }
      naturality := fun U₂ U₁ u => by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro f
        exact (hψ_nat u.unop f).symm }
  have hιΨ : CategoryTheory.CategoryStruct.comp ι_lc Ψ_nat = η_sh := by
    apply CategoryTheory.NatTrans.ext
    funext U
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro r
    have hid := hψ_const (CategoryTheory.CategoryStruct.id U.unop)
      (LocallyConstant.constₗ R r) r (fun _ => rfl)
    have hop : Opposite.op (CategoryTheory.CategoryStruct.id U.unop) =
        CategoryTheory.CategoryStruct.id U := rfl
    rw [hop, CategoryTheory.Functor.map_id] at hid
    exact hid
  let Ψ : Quiver.Hom L_sh oneR := { hom := Ψ_nat }
  have hΦΨ : CategoryTheory.CategoryStruct.comp Φ Ψ = CategoryTheory.CategoryStruct.id oneR := by
    apply hSheaf_ext
    change η_sh ≫ (Φ.hom ≫ Ψ_nat) = η_sh ≫ 𝟙 oneR.obj
    rw [← CategoryTheory.Category.assoc, hΦ_unit, hιΨ, CategoryTheory.Category.comp_id]
  have h_inj : ∀ U : S.Etale, Function.Injective (ev_lc U) := by
    intro U s₁ s₂ hs
    have h1 := congrArg (fun (θ : Quiver.Hom oneR oneR) =>
      (θ.hom.app (Opposite.op U)).hom s₁) hΦΨ
    have h2 := congrArg (fun (θ : Quiver.Hom oneR oneR) =>
      (θ.hom.app (Opposite.op U)).hom s₂) hΦΨ
    change ψ_fun U (ev_lc U s₁) = s₁ at h1
    change ψ_fun U (ev_lc U s₂) = s₂ at h2
    rw [← h1, ← h2, hs]
  refine ⟨?_, ?_, ?_⟩
  · 
    have hval_cast : ∀ c : ZMod m, (c.val : ZMod m) = c := by
      intro c
      by_cases hm1 : m = 1
      · subst hm1
        exact Subsingleton.elim _ _
      · have _ : NeZero m := ⟨by omega⟩
        exact ZMod.natCast_zmod_val c
    have hc_smul : ∀ c : ZMod m, c.val • (1 : R) = ULift.up c := by
      intro c
      apply ULift.ext
      change c.val • (1 : ZMod m) = c
      rw [nsmul_eq_mul, mul_one, hval_cast]
    let T_S : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.id S)
      (CategoryTheory.MorphismProperty.id_mem (@AlgebraicGeometry.Etale) S)
    obtain ⟨x₀⟩ := (inferInstance : Nonempty ↥S)
    let one_TS : ↑(oneR.obj.obj (Opposite.op T_S)) :=
      (η_sh.app (Opposite.op T_S)).hom (1 : R)
    refine ⟨?_, ?_⟩
    · intro c₁ c₂ h_eq
      have h_sec : c₁.val • one_TS = c₂.val • one_TS :=
        congrArg (fun (θ : Quiver.Hom oneR oneR) =>
          (θ.hom.app (Opposite.op T_S)).hom one_TS) h_eq
      have h_ev := congrArg (fun s => ev_lc T_S s x₀) h_sec
      rw [map_nsmul, map_nsmul] at h_ev
