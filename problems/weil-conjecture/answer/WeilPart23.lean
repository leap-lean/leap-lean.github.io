  obtain ⟨e_comm, he_T₁⟩ := hCommIso
  let e_one₂ : U_std₁.obj (R_sh.obj one₂) ≅ R_h_ab.obj (U_std₂.obj one₂) := e_comm.app one₂

  let adj'₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT'₁
  let adj'₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT'₂
