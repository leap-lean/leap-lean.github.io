          ⟨{y₀}, isIrreducible_singleton, hCl_pt y₀ (hY_sub hy₀)⟩
        have h_le : Cy₀ ≤ CY := Set.singleton_subset_iff.mpr hy₀
        have h_eq : Y = {y₀} := Set.Subset.antisymm (hCY_min h_le) h_le
