            (u₁.left : Y₁.left ⟶ W.left) W.hom).symm
          trivial
      let g_tilde₂ : Z_lift u₀ ⟶ Z_lift u₂ :=
        CategoryTheory.MorphismProperty.Over.homMk g₂.left
          ((CategoryTheory.Category.assoc (g₂.left : Z₀.left ⟶ Y₂.left)
            (u₂.left : Y₂.left ⟶ W.left) W.hom).symm.trans
            (congrArg (· ≫ W.hom) hhcomm_left.symm))
