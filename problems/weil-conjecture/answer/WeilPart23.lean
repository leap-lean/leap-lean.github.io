    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro r
    let x₁ : ↑(F.obj.obj (Opposite.op V_et)) :=
      (CategoryTheory.Sheaf.freeYonedaHomEquiv α₁).hom r
    let x₂ : ↑(F.obj.obj (Opposite.op V_et)) :=
      (CategoryTheory.Sheaf.freeYonedaHomEquiv α₂).hom r
    change x₁ = x₂
    have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.Etale)).toIsStableUnderComposition
    have hLiftCov :
        ∀ x : ↥((AlgebraicGeometry.Scheme.Etale.forget X).obj V_et).left,
          ∃ (W : AlgebraicGeometry.Scheme.{u})
            (w : W ⟶ ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_et).left)
            (_ : AlgebraicGeometry.Etale w)
            (w₀ : ↥W) (_ : w.base w₀ = x)
            (u_left : W ⟶ ((AlgebraicGeometry.Scheme.Etale.forget X).obj V'_et).left),
            u_left ≫ ((AlgebraicGeometry.Scheme.Etale.forget X).map p_et).left = w := by
      intro x
      obtain ⟨W, _, w, hEt_w, w₀, hw₀, s_sh, _, hSnd_s, _, _, _⟩ := hSheets_et x
      refine ⟨W, w, hEt_w, w₀, hw₀,
        s_sh 0 ≫ CategoryTheory.Limits.pullback.fst
          ((AlgebraicGeometry.Scheme.Etale.forget X).map p_et).left w, ?_⟩
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hSnd_s 0, CategoryTheory.Category.id_comp]
    let ι_idx := ↥((AlgebraicGeometry.Scheme.Etale.forget X).obj V_et).left
    let W_sch : ι_idx → AlgebraicGeometry.Scheme.{u} := fun x => Classical.choose (hLiftCov x)
    let w_map : ∀ x : ι_idx, W_sch x ⟶ V_et.left :=
      fun x => Classical.choose (Classical.choose_spec (hLiftCov x))
    have hw_et : ∀ x : ι_idx, AlgebraicGeometry.Etale (w_map x) :=
      fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (hLiftCov x)))
    let w_pt : ∀ x : ι_idx, ↥(W_sch x) :=
      fun x => Classical.choose (Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (hLiftCov x))))
    have hw_pt : ∀ x : ι_idx, (w_map x).base (w_pt x) = x :=
      fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (hLiftCov x)))))
    let u_map : ∀ x : ι_idx, W_sch x ⟶ V'_et.left :=
      fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftCov x))))))
    have hu_fac : ∀ x : ι_idx, u_map x ≫ p_et.left = w_map x :=
      fun x => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftCov x))))))
    let Y_cov : ι_idx → X.Etale := fun x =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ (w_map x ≫ V_et.hom)
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (w_map x) V_et.hom (hw_et x) V_et.prop)
    let v_cov : ∀ x : ι_idx, Y_cov x ⟶ V_et := fun x =>
      CategoryTheory.MorphismProperty.Over.homMk (w_map x) rfl trivial
    let u_cov : ∀ x : ι_idx, Y_cov x ⟶ V'_et := fun x =>
      CategoryTheory.MorphismProperty.Over.homMk (u_map x)
        (by
          change u_map x ≫ V'_et.hom = w_map x ≫ V_et.hom
          rw [← CategoryTheory.MorphismProperty.Over.w p_et, ← CategoryTheory.Category.assoc,
            hu_fac x])
        trivial
    have huv_eq : ∀ x : ι_idx, u_cov x ≫ p_et = v_cov x := fun x =>
      CategoryTheory.MorphismProperty.Over.Hom.ext (hu_fac x)
    have hSieve : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y_cov v_cov) ∈
        X.smallEtaleTopology V_et := by
      have hJ_eq : X.smallEtaleTopology = X.smallEtalePretopology.toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X le_rfl
      rw [hJ_eq]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology V_et _).mpr ?_
      intro x
      exact ⟨Y_cov x, v_cov x, w_pt x,
        CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows Y_cov v_cov)
          (Y_cov x) (v_cov x) (CategoryTheory.Presieve.ofArrows.mk x),
        hw_et x, hw_pt x⟩
    have hF_cat : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology
        (F.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf X.smallEtaleTopology F.obj
        (CategoryTheory.forget (ModuleCat.{u, u} R)) F.property
    have hF_type : CategoryTheory.Presieve.IsSheaf X.smallEtaleTopology
        (F.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R)) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type X.smallEtaleTopology _).mp hF_cat
    have hFor : CategoryTheory.Presieve.IsSheafFor
        (F.obj ⋙ CategoryTheory.forget (ModuleCat.{u, u} R))
        (CategoryTheory.Presieve.ofArrows Y_cov v_cov) :=
      CategoryTheory.Presieve.IsSheaf.isSheafFor hF_type _ hSieve
    rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hFor
    let sec : ∀ x : ι_idx, ↑(F.obj.obj (Opposite.op (Y_cov x))) :=
      fun x => (F.obj.map (Opposite.op (v_cov x))).hom x₁
    have hcompat : ∀ (i j : ι_idx) (Z : X.Etale) (g₁ : Z ⟶ Y_cov i) (g₂ : Z ⟶ Y_cov j),
        g₁ ≫ v_cov i = g₂ ≫ v_cov j →
        (F.obj.map (Opposite.op g₁)).hom (sec i) = (F.obj.map (Opposite.op g₂)).hom (sec j) := by
      intro i j Z g₁ g₂ hcomm
      have hcomp_map : ∀ {A B C : X.Etale} (a : A ⟶ B) (b : B ⟶ C)
          (s_el : ↑(F.obj.obj (Opposite.op C))),
          (F.obj.map (Opposite.op a)).hom ((F.obj.map (Opposite.op b)).hom s_el) =
            (F.obj.map (Opposite.op (a ≫ b))).hom s_el := by
        intro A B C a b s_el
        have hop : Opposite.op (a ≫ b) =
            (Opposite.op b ≫ Opposite.op a : Opposite.op C ⟶ Opposite.op A) := rfl
        rw [hop, CategoryTheory.Functor.map_comp]
        rfl
      exact (hcomp_map g₁ (v_cov i) x₁).trans
        ((congrArg (fun f_m => (F.obj.map (Opposite.op f_m)).hom x₁) hcomm).trans
          (hcomp_map g₂ (v_cov j) x₁).symm)
    obtain ⟨t, -, ht_uniq⟩ := hFor sec hcompat
    have ht₁ : x₁ = t := ht_uniq x₁ (fun _ => rfl)
    have ht₂ : x₂ = t := by
      apply ht_uniq x₂
      intro x
      have hmap_equiv : ∀ {W_et : X.Etale} (v : W_et ⟶ V_et) (α : L ⟶ F),
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ F.obj.map (Opposite.op v) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv
              (weilCupPDLocalFreeMap X ℓ v ≫ α) := by
        intro W_et v α
        calc
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ F.obj.map (Opposite.op v)
            = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫ α.hom.app (Opposite.op V_et)) ≫
                F.obj.map (Opposite.op v) := by
                rw [← hEquiv_comp (𝟙 L) α, CategoryTheory.Category.id_comp]
          _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫
                (α.hom.app (Opposite.op V_et) ≫ F.obj.map (Opposite.op v)) := by
                rw [CategoryTheory.Category.assoc]
          _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫
                (L.obj.map (Opposite.op v) ≫ α.hom.app (Opposite.op W_et)) := by
                rw [← α.hom.naturality (Opposite.op v)]
          _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫ L.obj.map (Opposite.op v)) ≫
                α.hom.app (Opposite.op W_et) := by
                rw [CategoryTheory.Category.assoc]
          _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap X ℓ v) ≫
                α.hom.app (Opposite.op W_et) := by
                have hv : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilCupPDLocalFreeMap X ℓ v) =
                    CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L) ≫ L.obj.map (Opposite.op v) :=
                  Equiv.apply_symm_apply _ _
                rw [hv]
          _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
                (weilCupPDLocalFreeMap X ℓ v ≫ α) :=
                (hEquiv_comp (weilCupPDLocalFreeMap X ℓ v) α).symm
      have heq_mor : weilCupPDLocalFreeMap X ℓ (v_cov x) ≫ α₂ =
          weilCupPDLocalFreeMap X ℓ (v_cov x) ≫ α₁ := by
        rw [← huv_eq x, hLocMap_comp (u_cov x) p_et, CategoryTheory.Category.assoc,
          CategoryTheory.Category.assoc]
        exact congrArg (weilCupPDLocalFreeMap X ℓ (u_cov x) ≫ ·) hα.symm
      exact congrArg (fun φ : RM ⟶ F.obj.obj (Opposite.op (Y_cov x)) => φ.hom r)
        ((hmap_equiv (v_cov x) α₂).trans
          ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv heq_mor).trans
            (hmap_equiv (v_cov x) α₁).symm))
    exact ht₁.trans ht₂.symm

  
  have hNe_V' : Nonempty ↥V'_open := by
    obtain ⟨v₀, hv₀⟩ := hNe_V
    obtain ⟨x'₀, hx'₀⟩ := bar_p.left.surjective v₀
    exact ⟨⟨x'₀, by change bar_p.left.base x'₀ ∈ V; rwa [hx'₀]⟩⟩
  obtain ⟨_, _, _, _, hIntV', _, _, _⟩ := hOpenGeom C'_bar hProjC' V'_open hNe_V'
  have : AlgebraicGeometry.IsIntegral V'_open.toScheme := hIntV'
  have : IrreducibleSpace ↥V'_open.toScheme :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral V'_open.toScheme
  have hConn_V' : ConnectedSpace ↥((AlgebraicGeometry.Scheme.Etale.forget X).obj V'_et).left :=
    IrreducibleSpace.connectedSpace ↥V'_open.toScheme
  have hOpen_Vet :
      AlgebraicGeometry.IsOpenImmersion ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_et).hom := by
    rw [← he_V]
    infer_instance
  have hEnd_V' : Function.Bijective (fun c : ZMod ℓ =>
      c.val • CategoryTheory.CategoryStruct.id
        (weilCupPDModUnit ((AlgebraicGeometry.Scheme.Etale.forget X).obj V'_et).left ℓ)) :=
    (@weil_etale_connected_unit_end_and_geom_point_lift
