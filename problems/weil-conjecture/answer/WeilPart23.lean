  have h_uniq_equiv :
      (adj_Rp.homEquiv (C_X.obj Aℤ) (C_Y.obj Aℤ)) (η_iso.inv.app (C_X.obj Aℤ) ≫ πℤ) =
        (adj₂.homEquiv Aℤ (P_push.obj (C_Y.obj Aℤ))).symm
