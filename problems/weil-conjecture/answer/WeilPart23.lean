            CategoryTheory.Limits.pullback.snd (FgtX.map u₀).left
              (CategoryTheory.Limits.pullback.fst (FgtX.obj U).hom g) := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Category.assoc ψ _ _).trans
              ((congrArg (ψ ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                ((CategoryTheory.Category.assoc ψ _ _).symm.trans
                  ((congrArg (· ≫ (FgtX.map u₀).left)
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    CategoryTheory.Limits.pullback.condition)))
