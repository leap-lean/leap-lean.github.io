    let U' : C'_bar.left.Opens := (TopologicalSpace.Opens.map bar_p.left.base).obj U
    have hU'_eq : U' = C'_bar.left.basicOpen g' :=
      AlgebraicGeometry.Scheme.Hom.preimage_basicOpen bar_p.left g
    let A_U_cat : CommRingCat.{u} := C_bar.left.presheaf.obj (Opposite.op U)
    let A_U : Type u := ↑A_U_cat
    let B_U_cat : CommRingCat.{u} := C'_bar.left.presheaf.obj (Opposite.op U')
    let B_U : Type u := ↑B_U_cat
