        let t_fn : LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod n)) := t
        apply LocallyConstant.ext
        intro pt
        have htc := congrArg (fun fn : LocallyConstant _ _ => fn (y_of pt))
