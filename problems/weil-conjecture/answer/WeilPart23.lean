      intro U V g _ a₁ a₂ ha₁ ha₂
      by_cases hEmp : IsEmpty ↥V.left
      · exact @Subsingleton.elim _ (hC_empty_sub V hEmp) _ _
      · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hEmp
        have heq : a₁ = a₂ := (ha₁ y₀).symm.trans (ha₂ y₀)
        rw [heq]
    have hη_nat_apply : ∀ {V₁ V₂ : S.Etale} (f : V₁ ⟶ V₂) (a : ZMod ℓ),
        ((C.obj AM).obj.map f.op).hom ((η_sh.app (Opposite.op V₂)).hom (ULift.up a)) =
          (η_sh.app (Opposite.op V₁)).hom (ULift.up a) := by
      intro V₁ V₂ f a
      exact (congrArg (fun (ψ : AM ⟶ _) => ψ.hom (ULift.up a)) (η_sh.naturality f.op)).symm
    have hΨ_ex : ∀ (U : S.Etale) (g : LocallyConstant ↥U.left (ZMod ℓ)),
        ∃! s : ↑((C.obj AM).obj.obj (Opposite.op U)),
          ∀ ⦃V : S.Etale⦄ (f : V ⟶ U) (a : ZMod ℓ),
            (∀ y : ↥V.left, g (f.left y) = a) →
            ((C.obj AM).obj.map f.op).hom s = (η_sh.app (Opposite.op V)).hom (ULift.up a) := by
      intro U g
      let σ : ∀ ⦃V : S.Etale⦄ (f : V ⟶ U), (S_lvl U g).arrows f →
          ↑((C.obj AM).obj.obj (Opposite.op V)) :=
        fun V _ hf => (η_sh.app (Opposite.op V)).hom (ULift.up (Classical.choose hf))
      have hσ_compat : ∀ ⦃V₁ V₂ W : S.Etale⦄ (g₁ : W ⟶ V₁) (g₂ : W ⟶ V₂)
          ⦃f₁ : V₁ ⟶ U⦄ ⦃f₂ : V₂ ⟶ U⦄ (hf₁ : (S_lvl U g).arrows f₁) (hf₂ : (S_lvl U g).arrows f₂),
          g₁ ≫ f₁ = g₂ ≫ f₂ →
          ((C.obj AM).obj.map g₁.op).hom (σ f₁ hf₁) =
            ((C.obj AM).obj.map g₂.op).hom (σ f₂ hf₂) := by
        intro V₁ V₂ W g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
        dsimp [σ]
        rw [hη_nat_apply g₁, hη_nat_apply g₂]
        have ha₁ : ∀ z : ↥W.left, g ((g₁ ≫ f₁).left z) = Classical.choose hf₁ := by
          intro z
          change g ((g₁.left ≫ f₁.left) z) = _
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
          exact Classical.choose_spec hf₁ (g₁.left z)
        have ha₂ : ∀ z : ↥W.left, g ((g₁ ≫ f₁).left z) = Classical.choose hf₂ := by
          intro z
          have hc : (g₁ ≫ f₁).left = (g₂ ≫ f₂).left := congrArg (fun m => m.left) hcomm
          rw [hc]
          change g ((g₂.left ≫ f₂.left) z) = _
          rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
          exact Classical.choose_spec hf₂ (g₂.left z)
        exact hη_lvl_indep (g₁ ≫ f₁) ha₁ ha₂
      obtain ⟨s, hs, hs_uniq⟩ := hC_glue U (S_lvl U g) (hS_lvl_mem U g) σ hσ_compat
      refine ⟨s, ?_, ?_⟩
      · intro V f a ha
        have hf : (S_lvl U g).arrows f := ⟨a, ha⟩
        exact (hs f hf).trans (hη_lvl_indep f (Classical.choose_spec hf) ha)
      · intro s' hs'
        apply hs_uniq
        intro V f hf
        exact hs' f (Classical.choose hf) (Classical.choose_spec hf)
