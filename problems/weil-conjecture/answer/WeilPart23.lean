        CategoryTheory.Category.comp_id]
    let s_norm : S_k ⟶ V_norm.left := CategoryTheory.inv V_norm.hom
    have hs_norm_sec : s_norm ≫ V_norm.hom = 𝟙 S_k :=
      CategoryTheory.IsIso.inv_hom_id V_norm.hom
    let x_norm : ↥V_norm.left := s_norm.base pt_k
    have hx_norm_cl : IsClosed ({x_norm} : Set ↥V_norm.left) :=
      hClosedOfSection V_norm hProjVn s_norm hs_norm_sec
    have hx_in : x_norm ∈ U_in := trivial
    have hx_jin : j_in.base ⟨x_norm, hx_in⟩ = x₀ := by
      change (V_norm.hom ≫ CategoryTheory.inv p_A₀ ≫ j_UW).base (U_in.ι.base ⟨x_norm, hx_in⟩) = x₀
      rw [AlgebraicGeometry.Scheme.Opens.ι_apply]
      change ((s_norm ≫ V_norm.hom) ≫ CategoryTheory.inv p_A₀ ≫ j_UW).base pt_k = x₀
      rw [hs_norm_sec, CategoryTheory.Category.id_comp, hinv_pA₀]
      exact hs_A₀_x₀

    exact ⟨V_norm, U_in, W_reg, j_in, x_norm, hIntVn, hProjVn, hDimVn, hSm_Wreg, hDimSing,
      hAff_Uin, le_rfl, hx_norm_cl, hEt_jin, hComp_jin, hx_in, hx_jin⟩

  · 
    obtain ⟨V_cl, U_cl, e_cl, hInt_Vcl, hProj_Vcl, hDim_Vcl_eq,
        hAff_Ucl, hNe_Ucl, he_cl_hom, hIC_imp⟩ :=
      weil_finiteType_domain_projective_schematic_closure k A₀ hStdChart
    have hIC_Ucl : IsIntegrallyClosed ↑(V_cl.left.presheaf.obj (Opposite.op U_cl)) :=
      hIC_imp hIC_A₀

    let Y_A₀ : CategoryTheory.Over S_k := CategoryTheory.Over.mk p_A₀
    have : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) Y_A₀.hom := by
      change AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) p_A₀
      rw [← hj_UW_pW₀]
      have : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) p_W₀ := hSm_pW₀
      have h0m : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (m + 1)) (j_UW ≫ p_W₀) :=
        inferInstance
      simpa using h0m
    have hInt_YA₀ : AlgebraicGeometry.IsIntegral Y_A₀.left := by
      change AlgebraicGeometry.IsIntegral (AlgebraicGeometry.Spec (CommRingCat.of A₀))
      infer_instance
    have hDim_SpecA₀ : topologicalKrullDim Y_A₀.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
      weil_smooth_integral_krullDim_over_field k (m + 1) Y_A₀ hInt_YA₀
    have hDim_A₀ : ringKrullDim A₀ = ((m + 1 : ℕ) : WithBot ℕ∞) :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A₀).symm.trans hDim_SpecA₀
    have hDim_Vcl : topologicalKrullDim V_cl.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
      hDim_Vcl_eq.trans hDim_A₀

    obtain ⟨V_norm, ν, U_ν, hIntVn, hFinν, _, hSurjν, hNe_Uν, hIso_Uν, hNormCov⟩ :=
      weil_algClosed_scheme_normalization_finite_birational k V_cl hInt_Vcl hProj_Vcl
        (fun A _ _ _ _ K _ _ _ => weil_algClosed_finiteType_domain_integralClosure_finite k A K)
    have : AlgebraicGeometry.IsFinite ν.left := hFinν
    have : CategoryTheory.IsIso (ν.left ∣_ U_ν) := hIso_Uν

    obtain ⟨hProjVn, hDimVn_eq⟩ :=
      weil_isFinite_projective_and_krullDim_over_field k ν hIntVn hInt_Vcl hProj_Vcl hFinν hSurjν
    have hDimVn : topologicalKrullDim V_norm.left = ((m + 1 : ℕ) : WithBot ℕ∞) :=
      hDimVn_eq.trans hDim_Vcl

    obtain ⟨W_reg₀, hSm_Wreg₀, hDimSing₀⟩ :=
      weil_affineNormal_scheme_codim2_smooth_open k m V_norm hIntVn hProjVn hDimVn hNormCov
        (fun d₀ A _ _ _ _ _ hDimA p _ hp =>
          weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k d₀ A hDimA p hp)

    obtain ⟨hAff_Uin, hIso_Ucl⟩ :=
      weil_finite_birational_isIso_over_integrallyClosed_affineOpen
        ν.left hIntVn hInt_Vcl U_ν U_cl hNe_Uν hAff_Ucl hNe_Ucl hIC_Ucl
    have : CategoryTheory.IsIso (ν.left ∣_ U_cl) := hIso_Ucl

    let U_in : V_norm.left.Opens := ν.left ⁻¹ᵁ U_cl
    let W_reg : V_norm.left.Opens := W_reg₀ ⊔ U_in
    have hU_le_reg : U_in ≤ W_reg := le_sup_right

    let j_in : U_in.toScheme ⟶ W₀ := (ν.left ∣_ U_cl) ≫ e_cl.inv ≫ j_UW
    have hEt_jin : AlgebraicGeometry.Etale j_in := by
      dsimp [j_in]
      infer_instance
    have he_cl_inv_pA₀ : e_cl.inv ≫ p_A₀ = U_cl.ι ≫ V_cl.hom := by
      dsimp [p_A₀]
      rw [← he_cl_hom, CategoryTheory.Iso.inv_hom_id_assoc]
    have hComp_jin : j_in ≫ p_W₀ = U_in.ι ≫ V_norm.hom := by
      calc j_in ≫ p_W₀
          = (ν.left ∣_ U_cl) ≫ e_cl.inv ≫ (j_UW ≫ p_W₀) := by
              dsimp [j_in]
              simp only [CategoryTheory.Category.assoc]
        _ = (ν.left ∣_ U_cl) ≫ (e_cl.inv ≫ p_A₀) := by rw [hj_UW_pW₀]
        _ = ((ν.left ∣_ U_cl) ≫ U_cl.ι) ≫ V_cl.hom := by
              rw [he_cl_inv_pA₀, CategoryTheory.Category.assoc]
        _ = (U_in.ι ≫ ν.left) ≫ V_cl.hom := by
              rw [AlgebraicGeometry.morphismRestrict_ι ν.left U_cl]
        _ = U_in.ι ≫ V_norm.hom := by
              rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w ν]

    have hSm_Uin : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (U_in.ι ≫ V_norm.hom) := by
      rw [← hComp_jin]
      have : AlgebraicGeometry.Etale j_in := hEt_jin
      have : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) p_W₀ := hSm_pW₀
      have h0m : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (m + 1)) (j_in ≫ p_W₀) :=
        inferInstance
      simpa using h0m
    have hSm_Wreg : AlgebraicGeometry.SmoothOfRelativeDimension (m + 1) (W_reg.ι ≫ V_norm.hom) :=
      hSmoothSup V_norm.hom (m + 1) W_reg₀ U_in hSm_Wreg₀ hSm_Uin

    have hDimSing :
        topologicalKrullDim ↥((W_reg : Set ↥V_norm.left)ᶜ) + 2 ≤ ((m + 1 : ℕ) : WithBot ℕ∞) := by
      let S₁ : Set ↥V_norm.left := (W_reg : Set ↥V_norm.left)ᶜ
      let S₀ : Set ↥V_norm.left := (W_reg₀ : Set ↥V_norm.left)ᶜ
      have hSub : S₁ ⊆ S₀ := Set.compl_subset_compl.mpr (le_sup_left : W_reg₀ ≤ W_reg)
      let T_sub : Set ↥S₀ := {z : ↥S₀ | z.1 ∈ S₁}
      let e_sub : ↥S₁ ≃ₜ ↥T_sub :=
        { toFun := fun x => ⟨⟨x.1, hSub x.2⟩, x.2⟩
          invFun := fun y => ⟨y.1.1, y.2⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          continuous_toFun :=
            Continuous.subtype_mk (Continuous.subtype_mk continuous_subtype_val _) _
          continuous_invFun :=
            Continuous.subtype_mk (continuous_subtype_val.comp continuous_subtype_val) _ }
      have hDimLe : topologicalKrullDim ↥S₁ ≤ topologicalKrullDim ↥S₀ := by
        rw [e_sub.isHomeomorph.topologicalKrullDim_eq]
        exact topologicalKrullDim_subspace_le (↥S₀) T_sub
      exact (add_le_add hDimLe le_rfl).trans hDimSing₀

    let s_in : S_k ⟶ U_in.toScheme :=
      s_A₀ ≫ e_cl.hom ≫ CategoryTheory.inv (ν.left ∣_ U_cl)
    let s_norm : S_k ⟶ V_norm.left := s_in ≫ U_in.ι
    have hs_in_jin : s_in ≫ j_in = s_A₀ ≫ j_UW := by
      dsimp [s_in, j_in]
      simp only [CategoryTheory.Category.assoc]
      rw [CategoryTheory.IsIso.inv_hom_id_assoc, CategoryTheory.Iso.hom_inv_id_assoc]
    have hs_norm_sec : s_norm ≫ V_norm.hom = 𝟙 S_k := by
      calc s_norm ≫ V_norm.hom
          = s_in ≫ (U_in.ι ≫ V_norm.hom) := CategoryTheory.Category.assoc _ _ _
        _ = s_in ≫ (j_in ≫ p_W₀) := by rw [hComp_jin]
        _ = (s_in ≫ j_in) ≫ p_W₀ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (s_A₀ ≫ j_UW) ≫ p_W₀ := by rw [hs_in_jin]
        _ = s_A₀ ≫ (j_UW ≫ p_W₀) := CategoryTheory.Category.assoc _ _ _
        _ = s_A₀ ≫ p_A₀ := by rw [hj_UW_pW₀]
        _ = 𝟙 S_k := hs_A₀_sec

    let x_in : ↥U_in.toScheme := s_in.base pt_k
    let x_norm : ↥V_norm.left := s_norm.base pt_k
    have hx_norm_cl : IsClosed ({x_norm} : Set ↥V_norm.left) :=
      hClosedOfSection V_norm hProjVn s_norm hs_norm_sec
    have hx_in : x_norm ∈ U_in := x_in.2
    have hx_sub : (⟨x_norm, hx_in⟩ : ↥U_in.toScheme) = x_in := Subtype.ext rfl
    have hx_jin : j_in.base ⟨x_norm, hx_in⟩ = x₀ := by
      rw [hx_sub]
      change (s_in ≫ j_in).base pt_k = x₀
      rw [hs_in_jin]
      exact hs_A₀_x₀

    exact ⟨V_norm, U_in, W_reg, j_in, x_norm, hIntVn, hProjVn, hDimVn, hSm_Wreg, hDimSing,
      hAff_Uin, hU_le_reg, hx_norm_cl, hEt_jin, hComp_jin, hx_in, hx_jin⟩

theorem weil_algClosed_smooth_proj_curve_affine_compl_etale_surj (k : Type u) [Field k] [IsAlgClosed k]
    (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hIntC : AlgebraicGeometry.IsIntegral C.left)
    (hProjC : IsProjectiveOverField k C)
    (hDimC : topologicalKrullDim C.left = ((1 : ℕ) : WithBot ℕ∞))
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom]
    (U_in : C.left.Opens)
    (hAffU : AlgebraicGeometry.IsAffineOpen U_in)
    (hNeU : Nonempty ↥U_in) :
    (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω))
          (AlgebraicGeometry.Spec (CommRingCat.of k))),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback C.hom s)) ∧
    ∃ (Z : AlgebraicGeometry.Scheme.{u}) (ι_Z : Quiver.Hom Z C.left),
      AlgebraicGeometry.IsClosedImmersion ι_Z ∧
      AlgebraicGeometry.IsFinite (CategoryTheory.CategoryStruct.comp ι_Z C.hom) ∧
      AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp ι_Z C.hom) ∧
      AlgebraicGeometry.Surjective (CategoryTheory.CategoryStruct.comp ι_Z C.hom) ∧
      (Set.range ι_Z.base)ᶜ = (U_in : Set ↥C.left) :=
by
  classical
  have : AlgebraicGeometry.IsIntegral C.left := hIntC
  have : IrreducibleSpace ↥C.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C.left
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hNe_k : Nonempty ↥S_k :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := k)).mpr inferInstance
  let pt_k : ↥S_k := Classical.choice hNe_k

  
  have hNull : ∀ (F : Type u) [Field F] [Algebra k F] [Algebra.FiniteType k F],
      Function.Bijective (algebraMap k F) := by
    intro F _ _ hFT
    refine ⟨RingHom.injective (algebraMap k F), ?_⟩
    intro y
    obtain ⟨n, f, hf_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := F)).mp hFT
    have hMax : (RingHom.ker f.toRingHom).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective f.toRingHom hf_surj
    obtain ⟨x, hx⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k)).mp hMax
    obtain ⟨p, rfl⟩ := hf_surj y
    let c : k := MvPolynomial.aeval x p
    have hmem : p - MvPolynomial.C c ∈ RingHom.ker f.toRingHom := by
      rw [hx, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      simp [c]
    refine ⟨c, ?_⟩
    have hsub : f (p - algebraMap k (MvPolynomial (Fin n) k) c) = 0 := hmem
    rw [map_sub, AlgHom.commutes, sub_eq_zero] at hsub
    exact hsub.symm

  
  have hPropC : AlgebraicGeometry.IsProper C.hom := by
    obtain ⟨N, ι_proj, hCl_proj⟩ := hProjC
    have : AlgebraicGeometry.IsClosedImmersion ι_proj.left := hCl_proj
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      ⟨fun c x y => Algebra.smul_mul_assoc c x.1 y⟩
    have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
      Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
    have hBij_𝒜0 : Function.Bijective (algebraMap k ↥(𝒜 0)) := by
      refine ⟨?_, ?_⟩
      · intro c₁ c₂ hc
        have hc' := congrArg (fun q : ↥(𝒜 0) => MvPolynomial.constantCoeff q.1) hc
        simpa [MvPolynomial.constantCoeff_C] using hc'
      · intro p
        have h0 := MvPolynomial.homogeneousComponent_zero p.1
        simp only [MvPolynomial.homogeneousComponent_of_mem p.2, ↓reduceIte] at h0
        refine ⟨MvPolynomial.constantCoeff p.1, Subtype.ext ?_⟩
        change MvPolynomial.C (MvPolynomial.constantCoeff p.1) = p.1
        rw [h0, MvPolynomial.constantCoeff_C]
    let e0 : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective (algebraMap k ↥(𝒜 0)) hBij_𝒜0
    let iso0 : CommRingCat.of k ≅ CommRingCat.of ↥(𝒜 0) :=
      { hom := CommRingCat.ofHom (algebraMap k ↥(𝒜 0))
        inv := CommRingCat.ofHom e0.symm.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun x => e0.symm_apply_apply x)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun x => e0.apply_symm_apply x) }
    let isoSpec0 : AlgebraicGeometry.Spec (CommRingCat.of ↥(𝒜 0)) ≅ S_k :=
      { hom := AlgebraicGeometry.Spec.map iso0.hom
        inv := AlgebraicGeometry.Spec.map iso0.inv
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, iso0.inv_hom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, iso0.hom_inv_id, AlgebraicGeometry.Spec.map_id] }
    have hProp1 : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) :=
      AlgebraicGeometry.Proj.instIsProperToSpecZeroOfFiniteTypeSubtypeMemOfNatNat 𝒜
    let f0 := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))
    have : CategoryTheory.IsIso f0 := CategoryTheory.Iso.isIso_hom isoSpec0
    have : AlgebraicGeometry.IsFinite f0 := AlgebraicGeometry.IsFinite.instOfIsIsoScheme f0
    have hProp2 : AlgebraicGeometry.IsProper f0 := AlgebraicGeometry.IsProper.instOfIsFinite f0
    have hPropProj : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsProper)
        (AlgebraicGeometry.Proj.toSpecZero 𝒜) f0 hProp1 hProp2
    have hPropCl : AlgebraicGeometry.IsProper ι_proj.left := inferInstance
    rw [← CategoryTheory.Over.w ι_proj]
    exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsProper)
      ι_proj.left (weilProjectiveSpaceOver k N).hom hPropCl hPropProj

  have hCompactC : CompactSpace ↥C.left := by
    refine ⟨?_⟩
    have hpre : C.hom.base ⁻¹' (Set.univ : Set ↥S_k) = Set.univ := rfl
    rw [← hpre]
    have : CompactSpace ↥S_k := Finite.compactSpace
    exact AlgebraicGeometry.QuasiCompact.isCompact_preimage (f := C.hom)
      Set.univ isOpen_univ isCompact_univ

  
  have hAffFT : ∀ (U : C.left.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      RingHom.FiniteType (AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ C.hom)).hom := by
    intro U hU
    let φ_U := AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ C.hom)
    have hmap : AlgebraicGeometry.Spec.map φ_U = hU.fromSpec ≫ C.hom :=
      AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ C.hom)
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_U) := by
      rw [hmap]
      infer_instance
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT

  
  have hConj1 : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (s : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) S_k),
      ConnectedSpace ↥(CategoryTheory.Limits.pullback C.hom s) := by
    intro Ω _ _ s
    let P := CategoryTheory.Limits.pullback C.hom s
    let fst : P ⟶ C.left := CategoryTheory.Limits.pullback.fst C.hom s
    let φ_Ω := AlgebraicGeometry.Spec.preimage s
    have hs_eq : AlgebraicGeometry.Spec.map φ_Ω = s := AlgebraicGeometry.Spec.map_preimage s
    letI : Algebra k Ω := φ_Ω.hom.toAlgebra

    
    have hTensorDom : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A]
        [Algebra.FiniteType k A], IsDomain (TensorProduct k A Ω) := by
      intro A _ _ _ _
      let b := Module.Free.chooseBasis k Ω
      let B := Algebra.TensorProduct.basis A b
      have hEvalNonzero : ∀ (u : A), u ≠ 0 → ∃ ev : A →ₐ[k] k, ev u ≠ 0 := by
        intro u hu
        let A_u := Localization.Away u
        have hInj_Au : Function.Injective (algebraMap A A_u) :=
          IsLocalization.injective A_u
            (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hu))
        have : Nontrivial A_u := hInj_Au.nontrivial
        have : Algebra.FinitePresentation A A_u := IsLocalization.Away.finitePresentation u
        have : Algebra.FiniteType A A_u := inferInstance
        have : Algebra.FiniteType k A_u :=
          Algebra.FiniteType.trans (R := k) (S := A) (A := A_u) ‹_› ‹_›
        obtain ⟨𝔪, h𝔪⟩ := Ideal.exists_maximal A_u
        letI : Field (A_u ⧸ 𝔪) := Ideal.Quotient.field 𝔪
        have : Algebra.FiniteType k (A_u ⧸ 𝔪) :=
          Algebra.FiniteType.trans (R := k) (S := A_u) (A := A_u ⧸ 𝔪) ‹_› inferInstance
        let eF : k ≃ₐ[k] (A_u ⧸ 𝔪) :=
          AlgEquiv.ofBijective (Algebra.ofId k (A_u ⧸ 𝔪)) (hNull (A_u ⧸ 𝔪))
        let ev : A →ₐ[k] k :=
          (eF.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k 𝔪)).comp (IsScalarTower.toAlgHom k A A_u)
        have hUnit : IsUnit (ev u) :=
          ((IsLocalization.Away.algebraMap_isUnit (S := A_u) u).map
            (Ideal.Quotient.mkₐ k 𝔪)).map eF.symm.toAlgHom
        exact ⟨ev, hUnit.ne_zero⟩
      obtain ⟨ev1, _⟩ := hEvalNonzero 1 one_ne_zero
      let Ψ1 : TensorProduct k A Ω →ₐ[k] Ω :=
        Algebra.TensorProduct.lift ((Algebra.ofId k Ω).comp ev1) (AlgHom.id k Ω)
          (fun _ _ => Commute.all _ _)
      have : Nontrivial (TensorProduct k A Ω) := Ψ1.toRingHom.domain_nontrivial
      have : NoZeroDivisors (TensorProduct k A Ω) := by
        refine NoZeroDivisors.mk fun {z₁ z₂} hz12 => ?_
        by_contra hmul
        have hz₁ : z₁ ≠ 0 := fun h0 => hmul (Or.inl h0)
        have hz₂ : z₂ ≠ 0 := fun h0 => hmul (Or.inr h0)
        have hne1 : B.repr z₁ ≠ 0 := fun h0 => hz₁ (B.repr.injective (by simp [h0]))
        have hne2 : B.repr z₂ ≠ 0 := fun h0 => hz₂ (B.repr.injective (by simp [h0]))
        obtain ⟨j₁, hj₁⟩ := Finsupp.support_nonempty_iff.mpr hne1
        obtain ⟨j₂, hj₂⟩ := Finsupp.support_nonempty_iff.mpr hne2
        rw [Finsupp.mem_support_iff] at hj₁ hj₂
        obtain ⟨ev, hev⟩ := hEvalNonzero (B.repr z₁ j₁ * B.repr z₂ j₂) (mul_ne_zero hj₁ hj₂)
        rw [map_mul] at hev
        have hev1 : ev (B.repr z₁ j₁) ≠ 0 := left_ne_zero_of_mul hev
        have hev2 : ev (B.repr z₂ j₂) ≠ 0 := right_ne_zero_of_mul hev
        let Ψ : TensorProduct k A Ω →ₐ[k] Ω :=
          Algebra.TensorProduct.lift ((Algebra.ofId k Ω).comp ev) (AlgHom.id k Ω)
            (fun _ _ => Commute.all _ _)
        have hCoord : ∀ (z : TensorProduct k A Ω) (j : Module.Free.ChooseBasisIndex k Ω),
            b.repr (Ψ z) j = ev (B.repr z j) := by
          intro z j
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul a ω =>
            simp only [Ψ, B, Algebra.TensorProduct.lift_tmul, AlgHom.comp_apply,
              Algebra.ofId_apply, AlgHom.id_apply, Algebra.TensorProduct.basis_repr_tmul,
              Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul, map_mul, AlgHom.commutes]
            rw [← Algebra.smul_def, map_smul, Finsupp.smul_apply, smul_eq_mul]
            simp
          | add x y ihx ihy =>
            rw [map_add, map_add, Finsupp.add_apply, ihx, ihy, ← map_add,
              ← Finsupp.add_apply, ← map_add]
        have hΨ1 : Ψ z₁ ≠ 0 := by
          intro h0
          apply hev1
          rw [← hCoord z₁ j₁, h0, map_zero, Finsupp.zero_apply]
        have hΨ2 : Ψ z₂ ≠ 0 := by
          intro h0
          apply hev2
          rw [← hCoord z₂ j₂, h0, map_zero, Finsupp.zero_apply]
        apply mul_ne_zero hΨ1 hΨ2
        rw [← map_mul, hz12, map_zero]
      exact NoZeroDivisors.to_isDomain _

    
    have hChartIrred : ∀ (U : C.left.Opens),
        AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
        IsIrreducible (fst.base ⁻¹' (U : Set ↥C.left)) := by
      intro U hU hNe
      let A_cat : CommRingCat.{u} := C.left.presheaf.obj (Opposite.op U)
      let A : Type u := ↑A_cat
      have hNeSet : Nonempty ↥(U : Set ↥C.left) := let ⟨u⟩ := hNe; ⟨⟨u.1, u.2⟩⟩
      have : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral C.left hIntC U hNeSet
      let φ_U := AlgebraicGeometry.Spec.preimage (hU.fromSpec ≫ C.hom)
      have hmap_U : AlgebraicGeometry.Spec.map φ_U = hU.fromSpec ≫ C.hom :=
        AlgebraicGeometry.Spec.map_preimage (hU.fromSpec ≫ C.hom)
      letI : Algebra k A := φ_U.hom.toAlgebra
      have : Algebra.FiniteType k A := hAffFT U hU
      have : IsDomain (TensorProduct k A Ω) := hTensorDom A
      let T_sch := AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct k A Ω))
      have : IrreducibleSpace ↥T_sch := by
        change IrreducibleSpace (PrimeSpectrum (TensorProduct k A Ω))
        infer_instance
      have hmap_A : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A)) =
          hU.fromSpec ≫ C.hom := hmap_U
      have hmap_Ω : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k Ω)) = s := hs_eq
      let iso_pb : T_sch ≅ CategoryTheory.Limits.pullback fst hU.fromSpec :=
        (AlgebraicGeometry.pullbackSpecIso k A Ω).symm ≪≫
          CategoryTheory.Limits.pullback.congrHom hmap_A hmap_Ω ≪≫
          (CategoryTheory.Limits.pullbackRightPullbackFstIso C.hom s hU.fromSpec).symm ≪≫
          CategoryTheory.Limits.pullbackSymmetry hU.fromSpec fst
      let g_U : T_sch ⟶ P := iso_pb.hom ≫ CategoryTheory.Limits.pullback.fst fst hU.fromSpec
      have hRange_gU : Set.range g_U.base = fst.base ⁻¹' (U : Set ↥C.left) := by
        rw [← hU.range_fromSpec, ← AlgebraicGeometry.Scheme.Pullback.range_fst]
        ext p
        constructor
        · rintro ⟨t, rfl⟩
          exact ⟨iso_pb.hom.base t, rfl⟩
        · rintro ⟨q, rfl⟩
          refine ⟨iso_pb.inv.base q, ?_⟩
          change ((iso_pb.inv ≫ iso_pb.hom) ≫
            CategoryTheory.Limits.pullback.fst fst hU.fromSpec).base q = _
          rw [iso_pb.inv_hom_id, CategoryTheory.Category.id_comp]
      rw [← hRange_gU, ← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ ↥T_sch).image g_U.base g_U.continuous.continuousOn

    have hNeP : Nonempty ↥P := by
      obtain ⟨p₀, _⟩ := (hChartIrred U_in hAffU hNeU).nonempty
      exact ⟨p₀⟩
    have hPreUniv : IsPreirreducible (Set.univ : Set ↥P) := by
      intro O₁ O₂ hO₁ hO₂ hNeO₁ hNeO₂
      obtain ⟨p₁, hp₁_mem⟩ := hNeO₁
      have hp₁ : p₁ ∈ O₁ := hp₁_mem.2
      obtain ⟨p₂, hp₂_mem⟩ := hNeO₂
      have hp₂ : p₂ ∈ O₂ := hp₂_mem.2
      obtain ⟨U₁, hAff₁, hp₁U₁, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := ⊤) (trivial : fst.base p₁ ∈ (⊤ : C.left.Opens))
      obtain ⟨U₂, hAff₂, hp₂U₂, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := ⊤) (trivial : fst.base p₂ ∈ (⊤ : C.left.Opens))
      have hNe₁ : Nonempty ↥U₁ := ⟨⟨fst.base p₁, hp₁U₁⟩⟩
      have hNe₂ : Nonempty ↥U₂ := ⟨⟨fst.base p₂, hp₂U₂⟩⟩
      obtain ⟨x₃, hx₃_mem⟩ :=
        (IrreducibleSpace.isIrreducible_univ ↥C.left).isPreirreducible
          (U₁ : Set ↥C.left) (U₂ : Set ↥C.left)
          U₁.isOpen U₂.isOpen ⟨fst.base p₁, trivial, hp₁U₁⟩ ⟨fst.base p₂, trivial, hp₂U₂⟩
      have hx₃U₁ : x₃ ∈ U₁ := hx₃_mem.2.1
      have hx₃U₂ : x₃ ∈ U₂ := hx₃_mem.2.2
      obtain ⟨U₃, hAff₃, hx₃U₃, hSub₃⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := U₁ ⊓ U₂) (show x₃ ∈ U₁ ⊓ U₂ from ⟨hx₃U₁, hx₃U₂⟩)
      obtain ⟨p₃, hp₃⟩ := (hChartIrred U₃ hAff₃ ⟨⟨x₃, hx₃U₃⟩⟩).nonempty
      have hp₃_12 : fst.base p₃ ∈ U₁ ⊓ U₂ := hSub₃ hp₃
      have hIrr₁ := (hChartIrred U₁ hAff₁ hNe₁).isPreirreducible
      have hIrr₂ := (hChartIrred U₂ hAff₂ hNe₂).isPreirreducible
      obtain ⟨q, hq_mem⟩ :=
        hIrr₁ O₁ (fst.base ⁻¹' (U₂ : Set ↥C.left)) hO₁
          (U₂.isOpen.preimage fst.continuous)
          ⟨p₁, hp₁U₁, hp₁⟩ ⟨p₃, hp₃_12.1, hp₃_12.2⟩
      have hqO₁ : q ∈ O₁ := hq_mem.2.1
      have hqU₂ : fst.base q ∈ U₂ := hq_mem.2.2
      obtain ⟨r, hr_mem⟩ :=
        hIrr₂ O₁ O₂ hO₁ hO₂ ⟨q, hqU₂, hqO₁⟩ ⟨p₂, hp₂U₂, hp₂⟩
      exact ⟨r, trivial, hr_mem.2.1, hr_mem.2.2⟩
    have hPreSpace : PreirreducibleSpace ↥P := { isPreirreducible_univ := hPreUniv }
    have : IrreducibleSpace ↥P := @IrreducibleSpace.mk ↥P _ hPreSpace hNeP
    exact IrreducibleSpace.connectedSpace ↥P

  
  let Z_closed : Set ↥C.left := (U_in : Set ↥C.left)ᶜ
  have hClosedZ : IsClosed Z_closed := U_in.isOpen.isClosed_compl
  have hNeZ : Z_closed.Nonempty := by
    by_contra hNotNe
    have hUniv : (U_in : Set ↥C.left) = Set.univ :=
      Set.ext fun x => ⟨fun _ => trivial, fun _ => by_contra fun hx => hNotNe ⟨x, hx⟩⟩
    have hU_top : U_in = (⊤ : C.left.Opens) := TopologicalSpace.Opens.ext hUniv
    have hAff_top : AlgebraicGeometry.IsAffine (⊤ : C.left.Opens).toScheme := hU_top ▸ hAffU
    have : AlgebraicGeometry.IsAffine C.left :=
      @AlgebraicGeometry.IsAffine.of_isIso _ _ C.left.topIso.inv _ hAff_top
    have : AlgebraicGeometry.IsAffineHom C.hom :=
      AlgebraicGeometry.isAffineHom_of_isAffine C.hom
    have : AlgebraicGeometry.IsFinite C.hom :=
      AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hPropC, inferInstance⟩
    let R_cat : CommRingCat.{u} := C.left.presheaf.obj (Opposite.op ⊤)
    let R : Type u := ↑R_cat
    let e_C := C.left.isoSpec
    let φ_R := AlgebraicGeometry.Spec.preimage (e_C.inv ≫ C.hom)
    have hmap_R : AlgebraicGeometry.Spec.map φ_R = e_C.inv ≫ C.hom :=
      AlgebraicGeometry.Spec.map_preimage (e_C.inv ≫ C.hom)
    have hSpecFin_R : AlgebraicGeometry.IsFinite (AlgebraicGeometry.Spec.map φ_R) := by
      rw [hmap_R]
      infer_instance
    have hFin_R : RingHom.Finite φ_R.hom :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff φ_R).mp hSpecFin_R
    letI : Algebra k R := φ_R.hom.toAlgebra
    have : Module.Finite k R := hFin_R
    have : IsScalarTower k R R := ⟨fun c x y => Algebra.smul_mul_assoc c x y⟩
    have : IsArtinianRing R := isArtinian_of_tower k (S := R) (M := R) inferInstance
    have hDiscSpec : DiscreteTopology ↥(AlgebraicGeometry.Spec R_cat) := by
      change DiscreteTopology (PrimeSpectrum R)
      infer_instance
    have : DiscreteTopology ↥C.left :=
      Homeomorph.discreteTopology
        (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e_C.symm))
    have hDimLe0 : topologicalKrullDim C.left ≤ (0 : WithBot ℕ∞) :=
      topologicalKrullDim_zero_of_discreteTopology ↥C.left
    rw [hDimC] at hDimLe0
    exact not_lt_of_ge hDimLe0 (WithBot.coe_lt_coe.mpr (Nat.cast_lt.mpr Nat.zero_lt_one))

  
  have hLocalFinAndClosed : ∀ (W : C.left.Opens),
      AlgebraicGeometry.IsAffineOpen W → Nonempty ↥W →
      ((W : Set ↥C.left) ∩ Z_closed).Finite ∧
      ∀ x ∈ (W : Set ↥C.left) ∩ Z_closed, IsOpen ((W : Set ↥C.left) \ {x}) := by
    intro W hAffW hNeW
    let A_cat : CommRingCat.{u} := C.left.presheaf.obj (Opposite.op W)
    let A : Type u := ↑A_cat
    have hNeSetW : Nonempty ↥(W : Set ↥C.left) := let ⟨w⟩ := hNeW; ⟨⟨w.1, w.2⟩⟩
    have : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral C.left hIntC W hNeSetW
    let fW := hAffW.fromSpec
    let φ_W := AlgebraicGeometry.Spec.preimage (fW ≫ C.hom)
    letI : Algebra k A := φ_W.hom.toAlgebra
    have : Algebra.FiniteType k A := hAffFT W hAffW
    have : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
    let S_A : Set (PrimeSpectrum A) := fW.base ⁻¹' Z_closed
    have hClosed_SA : IsClosed S_A := hClosedZ.preimage fW.continuous
    obtain ⟨u₀⟩ := hNeU
    obtain ⟨w₀⟩ := hNeW
    obtain ⟨x_meet, _, hxW, hxU⟩ :=
      (IrreducibleSpace.isIrreducible_univ ↥C.left).isPreirreducible
        (W : Set ↥C.left) (U_in : Set ↥C.left)
        W.isOpen U_in.isOpen ⟨w₀.1, trivial, w₀.2⟩ ⟨u₀.1, trivial, u₀.2⟩
    have hx_range : x_meet ∈ Set.range fW.base := by
      rw [hAffW.range_fromSpec]
      exact hxW
    obtain ⟨p_out, hp_out⟩ := hx_range
    have hp_not_SA : p_out ∉ S_A := by
      change fW.base p_out ∉ (U_in : Set ↥C.left)ᶜ
      rw [hp_out]
      exact fun h => h hxU
    obtain ⟨I, hSA_eq⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal S_A).mp hClosed_SA
    have hI_ne_bot : ¬ (I ≤ ⊥) := by
      intro hle
      apply hp_not_SA
      rw [hSA_eq]
      intro a ha
      rw [Ideal.mem_bot.mp (hle ha)]
      exact Ideal.zero_mem _
    obtain ⟨g, hgI, hg_ne0⟩ : ∃ g ∈ I, g ≠ 0 := by
      by_contra hAll0
      exact hI_ne_bot fun a ha => Ideal.mem_bot.mpr
        (by_contra fun ha0 => hAll0 ⟨a, ha, ha0⟩)
    let I_g : Ideal A := Ideal.span ({g} : Set A)
    let B := A ⧸ I_g
    let mk_g : A →+* B := Ideal.Quotient.mk I_g
    have hDimA_le_1 : Order.krullDim (PrimeSpectrum A) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
      change ringKrullDim A ≤ ((1 : ℕ) : WithBot ℕ∞)
      rw [← PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A]
      have hEmb := fW.isOpenEmbedding
      have hEqSub : topologicalKrullDim (PrimeSpectrum A) =
          topologicalKrullDim ↥(Set.range fW.base) :=
        IsHomeomorph.topologicalKrullDim_eq _ hEmb.toHomeomorph.isHomeomorph
      change topologicalKrullDim (PrimeSpectrum A) ≤ _
      rw [hEqSub, ← hDimC]
      exact topologicalKrullDim_subspace_le ↥C.left (Set.range fW.base)
    have : Ring.KrullDimLE 0 B := by
      refine Ring.KrullDimLE.mk₀ (fun J hJp => ?_)
      by_contra hNotMax
      obtain ⟨M, hMaxM, hJM⟩ := Ideal.exists_le_maximal J hJp.ne_top
      have hJM_lt : J < M := lt_of_le_of_ne hJM (fun heq => hNotMax (heq ▸ hMaxM))
      let P₀ : PrimeSpectrum A := ⟨⊥, inferInstance⟩
      let P₁ : PrimeSpectrum A := ⟨Ideal.comap mk_g J, hJp.comap mk_g⟩
      let P₂ : PrimeSpectrum A := ⟨Ideal.comap mk_g M, hMaxM.isPrime.comap mk_g⟩
      have h01 : P₀ < P₁ := by
        refine lt_of_le_of_ne (show (⊥ : Ideal A) ≤ P₁.asIdeal from bot_le) ?_
        intro heq
        have hg_mem : g ∈ P₁.asIdeal := by
          change mk_g g ∈ J
          have hg0 : mk_g g = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          rw [hg0]
          exact J.zero_mem
        have hbot : P₁.asIdeal = ⊥ := (congrArg PrimeSpectrum.asIdeal heq).symm
        rw [hbot, Ideal.mem_bot] at hg_mem
        exact hg_ne0 hg_mem
      have h12 : P₁ < P₂ := by
        refine lt_of_le_of_ne (Ideal.comap_mono (le_of_lt hJM_lt)) ?_
        intro heq
        have hcomap : Ideal.comap mk_g J = Ideal.comap mk_g M :=
          congrArg PrimeSpectrum.asIdeal heq
        apply ne_of_lt hJM_lt
        apply le_antisymm hJM
        intro m hm
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective m
        change a ∈ Ideal.comap mk_g J
        rw [hcomap]
        exact hm
      let s_chain : LTSeries (PrimeSpectrum A) :=
        { length := 2
          toFun := ![P₀, P₁, P₂]
          step := fun i => by fin_cases i <;> assumption }
      have h2le : ((2 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (PrimeSpectrum A) :=
        Order.LTSeries.length_le_krullDim s_chain
      have h2le1 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := le_trans h2le hDimA_le_1
      exact absurd (WithBot.coe_le_coe.mp h2le1) (by decide)
    have : IsArtinianRing B := IsNoetherianRing.isArtinianRing_of_krullDimLE_zero
    have : Finite (PrimeSpectrum B) := IsArtinianRing.instFinitePrimeSpectrum B
    have : DiscreteTopology (PrimeSpectrum B) := inferInstance
    have hClEmb_comap : Topology.IsClosedEmbedding (PrimeSpectrum.comap mk_g) :=
      PrimeSpectrum.isClosedEmbedding_comap_of_surjective B mk_g Ideal.Quotient.mk_surjective
    have hSA_sub_range : S_A ⊆ Set.range (PrimeSpectrum.comap mk_g) := by
      intro p hp
      have hIg_le : I_g ≤ p.asIdeal := by
        rw [Ideal.span_singleton_le_iff_mem]
        rw [hSA_eq] at hp
        exact hp hgI
      let φ_p : B →+* (A ⧸ p.asIdeal) := Ideal.Quotient.factor hIg_le
      have : p.asIdeal.IsPrime := p.isPrime
      have : IsDomain (A ⧸ p.asIdeal) := inferInstance
      let q : PrimeSpectrum B := ⟨RingHom.ker φ_p, RingHom.ker_isPrime φ_p⟩
      refine ⟨q, PrimeSpectrum.ext (Ideal.ext fun a => ?_)⟩
      change φ_p (mk_g a) = 0 ↔ a ∈ p.asIdeal
      change Ideal.Quotient.mk p.asIdeal a = 0 ↔ a ∈ p.asIdeal
      exact Ideal.Quotient.eq_zero_iff_mem
    have hSA_fin : S_A.Finite := (Set.finite_range (PrimeSpectrum.comap mk_g)).subset hSA_sub_range
    have hImg_eq : (W : Set ↥C.left) ∩ Z_closed = fW.base '' S_A := by
      ext x
      constructor
      · rintro ⟨hxW, hxZ⟩
        have hxR : x ∈ Set.range fW.base := hAffW.range_fromSpec.symm ▸ hxW
        obtain ⟨p, rfl⟩ := hxR
        exact ⟨p, hxZ, rfl⟩
      · rintro ⟨p, hpZ, rfl⟩
        exact ⟨hAffW.range_fromSpec ▸ Set.mem_range_self p, hpZ⟩
    refine ⟨hImg_eq ▸ hSA_fin.image fW.base, ?_⟩
    intro x ⟨hxW, hxZ⟩
    have hxR : x ∈ Set.range fW.base := hAffW.range_fromSpec.symm ▸ hxW
    obtain ⟨p, rfl⟩ := hxR
    obtain ⟨q, rfl⟩ := hSA_sub_range (show p ∈ S_A from hxZ)
    have hCl_p : IsClosed ({PrimeSpectrum.comap mk_g q} : Set (PrimeSpectrum A)) := by
      rw [← Set.image_singleton]
      exact hClEmb_comap.isClosedMap {q} (isClosed_discrete {q})
    have hOpen_compl : IsOpen (({PrimeSpectrum.comap mk_g q} : Set (PrimeSpectrum A))ᶜ) :=
      hCl_p.isOpen_compl
    have hSetEq : (W : Set ↥C.left) \ {fW.base (PrimeSpectrum.comap mk_g q)} =
        fW.base '' (({PrimeSpectrum.comap mk_g q} : Set (PrimeSpectrum A))ᶜ) := by
      ext y
      constructor
      · rintro ⟨hyW, hyNe⟩
        have hyR : y ∈ Set.range fW.base := hAffW.range_fromSpec.symm ▸ hyW
        obtain ⟨p', rfl⟩ := hyR
        exact ⟨p', fun hp' => hyNe (congrArg fW.base hp'), rfl⟩
      · rintro ⟨p', hp', rfl⟩
        refine ⟨hAffW.range_fromSpec ▸ Set.mem_range_self p', ?_⟩
        intro heq
        exact hp' (fW.isOpenEmbedding.injective heq)
    rw [hSetEq]
    exact fW.isOpenEmbedding.isOpenMap _ hOpen_compl

  
  have hFinZ : Z_closed.Finite := by
    have hCov : ∀ x : ↥C.left, ∃ W : C.left.Opens, AlgebraicGeometry.IsAffineOpen W ∧ x ∈ W := by
      intro x
      obtain ⟨W, hAffW, hxW, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := ⊤) (trivial : x ∈ (⊤ : C.left.Opens))
      exact ⟨W, hAffW, hxW⟩
    choose W_of hAff_Wof hx_Wof using hCov
    obtain ⟨t, ht⟩ := hCompactC.isCompact_univ.elim_finite_subcover
      (fun x : ↥C.left => (W_of x : Set ↥C.left))
      (fun x => (W_of x).isOpen)
      (fun x _ => Set.mem_iUnion.mpr ⟨x, hx_Wof x⟩)
    have hSub : Z_closed ⊆ ⋃ x ∈ t, ((W_of x : Set ↥C.left) ∩ Z_closed) := by
      intro z hz
      obtain ⟨x, hxt, hzx⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ z))
      exact Set.mem_iUnion₂.mpr ⟨x, hxt, hzx, hz⟩
    exact (t.finite_toSet.biUnion fun x _ =>
      (hLocalFinAndClosed (W_of x) (hAff_Wof x) ⟨⟨x, hx_Wof x⟩⟩).1).subset hSub

  have hClosedPt : ∀ x ∈ Z_closed, IsClosed ({x} : Set ↥C.left) := by
    intro x hxZ
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro y hyNe
    obtain ⟨W, hAffW, hyW, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (U := ⊤) (trivial : y ∈ (⊤ : C.left.Opens))
    by_cases hxW : x ∈ W
    · refine ⟨(W : Set ↥C.left) \ {x}, ?_, ?_, ⟨hyW, hyNe⟩⟩
      · intro w hw
        exact hw.2
      · exact (hLocalFinAndClosed W hAffW ⟨⟨y, hyW⟩⟩).2 x ⟨hxW, hxZ⟩
    · refine ⟨(W : Set ↥C.left), ?_, W.isOpen, hyW⟩
      intro w hw hwx
      rw [Set.mem_singleton_iff] at hwx
      exact hxW (hwx ▸ hw)

  
  let ι_type : Type u := ↥Z_closed
  have : Finite ι_type := hFinZ.to_subtype
  letI : Fintype ι_type := Fintype.ofFinite ι_type
  have hNe_ι : Nonempty ι_type := hNeZ.to_subtype

  have hPointwise : ∀ z : ι_type,
      ∃ ez : S_k ⟶ C.left,
        AlgebraicGeometry.IsClosedImmersion ez ∧
        ez ≫ C.hom = 𝟙 S_k ∧
        Set.range ez.base = {z.1} := by
    intro z
    let α_z := C.left.fromSpecResidueField z.1
    have hRange_α : Set.range α_z.base = {z.1} :=
      AlgebraicGeometry.Scheme.range_fromSpecResidueField z.1
    have : AlgebraicGeometry.IsClosedImmersion α_z :=
      AlgebraicGeometry.IsClosedImmersion.of_isPreimmersion α_z (hRange_α.symm ▸ hClosedPt z.1 z.2)
    let φ_z := AlgebraicGeometry.Spec.preimage (α_z ≫ C.hom)
    have hmap_z : AlgebraicGeometry.Spec.map φ_z = α_z ≫ C.hom :=
      AlgebraicGeometry.Spec.map_preimage (α_z ≫ C.hom)
    have hLFT_z : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_z) := by
      rw [hmap_z]
      infer_instance
    have hFT_z : RingHom.FiniteType φ_z.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_z
    let κ_z : Type u := ↑(C.left.residueField z.1)
    letI : Algebra k κ_z := φ_z.hom.toAlgebra
    have : Algebra.FiniteType k κ_z := hFT_z
    let e_κ : k ≃+* κ_z := RingEquiv.ofBijective φ_z.hom (hNull κ_z)
    let iso_κ : CommRingCat.of k ≅ C.left.residueField z.1 :=
      { hom := φ_z
        inv := CommRingCat.ofHom e_κ.symm.toRingHom
        hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun c => e_κ.symm_apply_apply c)
        inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun c => e_κ.apply_symm_apply c) }
    let isoSpec_κ : S_k ≅ AlgebraicGeometry.Spec (C.left.residueField z.1) :=
      { hom := AlgebraicGeometry.Spec.map iso_κ.inv
        inv := AlgebraicGeometry.Spec.map iso_κ.hom
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, iso_κ.hom_inv_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, iso_κ.inv_hom_id, AlgebraicGeometry.Spec.map_id] }
    let ez : S_k ⟶ C.left := isoSpec_κ.hom ≫ α_z
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map iso_κ.inv) :=
      CategoryTheory.Iso.isIso_hom isoSpec_κ
    have hCl_ez : AlgebraicGeometry.IsClosedImmersion ez := by
      dsimp [ez, isoSpec_κ]
      infer_instance
    refine ⟨ez, hCl_ez, ?_, ?_⟩
    · calc
        ez ≫ C.hom = AlgebraicGeometry.Spec.map iso_κ.inv ≫ (α_z ≫ C.hom) :=
          CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map iso_κ.inv ≫ AlgebraicGeometry.Spec.map iso_κ.hom := by
          rw [← hmap_z]
        _ = 𝟙 S_k := isoSpec_κ.hom_inv_id
    · rw [← hRange_α]
      ext x
      constructor
      · rintro ⟨s_pt, rfl⟩
        exact ⟨isoSpec_κ.hom.base s_pt, rfl⟩
      · rintro ⟨r_pt, rfl⟩
        refine ⟨isoSpec_κ.inv.base r_pt, ?_⟩
        change ((isoSpec_κ.inv ≫ isoSpec_κ.hom) ≫ α_z).base r_pt = _
        rw [isoSpec_κ.inv_hom_id, CategoryTheory.Category.id_comp]

  choose e he_cl he_sec he_range using hPointwise
  let R_fam : ι_type → CommRingCat.{u} := fun _ => CommRingCat.of k
  let σ_Spec := AlgebraicGeometry.sigmaSpec R_fam
  have : CategoryTheory.IsIso σ_Spec := inferInstance
  let ε : (∐ fun i : ι_type => AlgebraicGeometry.Spec (R_fam i)) ⟶ C.left :=
    CategoryTheory.Limits.Sigma.desc e
  let Z : AlgebraicGeometry.Scheme.{u} :=
    AlgebraicGeometry.Spec (CommRingCat.of (ι_type → k))
  let ι_Z : Z ⟶ C.left := CategoryTheory.inv σ_Spec ≫ ε

  
  let j : ι_type → (S_k ⟶ Z) := fun z =>
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Pi.evalRingHom (fun _ : ι_type => k) z))
  have hj_comp : ∀ z : ι_type, j z ≫ ι_Z = e z := by
    intro z
    have hι : CategoryTheory.Limits.Sigma.ι (fun i : ι_type => AlgebraicGeometry.Spec (R_fam i)) z ≫
        σ_Spec = j z := AlgebraicGeometry.ι_sigmaSpec R_fam z
    calc
      j z ≫ ι_Z = (CategoryTheory.Limits.Sigma.ι _ z ≫ σ_Spec) ≫ (CategoryTheory.inv σ_Spec ≫ ε) := by
        rw [hι]
      _ = CategoryTheory.Limits.Sigma.ι _ z ≫ (σ_Spec ≫ CategoryTheory.inv σ_Spec) ≫ ε := by
        simp only [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Limits.Sigma.ι _ z ≫ ε := by simp
      _ = e z := CategoryTheory.Limits.Sigma.ι_comp_desc e z

  have hj_pt_map : ∀ z : ι_type, ι_Z.base ((j z).base pt_k) = z.1 := by
    intro z
    have hmem : (e z).base pt_k ∈ Set.range (e z).base := Set.mem_range_self pt_k
    rw [he_range z, Set.mem_singleton_iff] at hmem
    calc
      ι_Z.base ((j z).base pt_k) = (j z ≫ ι_Z).base pt_k := rfl
      _ = (e z).base pt_k := by rw [hj_comp z]
      _ = z.1 := hmem

  have hZ_cover : ∀ w : ↥Z, ∃ z : ι_type, (j z).base pt_k = w := by
    intro w
    change ∃ z : ι_type, PrimeSpectrum.comap (Pi.evalRingHom (fun _ : ι_type => k) z) pt_k = w
    have hSum1 : (∑ z : ι_type, Pi.single z (1 : k)) = (1 : ι_type → k) := by
      ext z'
      rw [Finset.sum_apply, Pi.one_apply, Finset.sum_eq_single z']
      · simp
      · intro b _ hb
        exact Pi.single_eq_of_ne (Ne.symm hb) 1
      · intro hz'
        exact absurd (Finset.mem_univ z') hz'
    obtain ⟨z, hz_not_mem⟩ : ∃ z : ι_type, Pi.single z (1 : k) ∉ w.asIdeal := by
      by_contra hAll
      have h1mem : (1 : ι_type → k) ∈ w.asIdeal := by
        rw [← hSum1]
        exact Ideal.sum_mem w.asIdeal fun z _ =>
          by_contra fun hz => hAll ⟨z, hz⟩
      exact w.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem w.asIdeal h1mem isUnit_one)
    have hSurj_ev : Function.Surjective (Pi.evalRingHom (fun _ : ι_type => k) z) := fun c =>
      ⟨Function.const ι_type c, rfl⟩
    have hMax_ker : (RingHom.ker (Pi.evalRingHom (fun _ : ι_type => k) z)).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective _ hSurj_ev
    have hKer_le : RingHom.ker (Pi.evalRingHom (fun _ : ι_type => k) z) ≤ w.asIdeal := by
      intro f hf
      have hf0 : f z = 0 := hf
      have hmul0 : f * Pi.single z (1 : k) = 0 := by
        ext z'
        by_cases hzz' : z' = z
        · subst hzz'; simp [hf0]
        · simp [Pi.single_eq_of_ne hzz']
      have hmem0 : f * Pi.single z (1 : k) ∈ w.asIdeal := hmul0.symm ▸ w.asIdeal.zero_mem
      exact (w.isPrime.mem_or_mem hmem0).resolve_right hz_not_mem
    have hEq_ideal : RingHom.ker (Pi.evalRingHom (fun _ : ι_type => k) z) = w.asIdeal :=
      hMax_ker.eq_of_le w.isPrime.ne_top hKer_le
    refine ⟨z, PrimeSpectrum.ext ?_⟩
    have hpt_bot : pt_k.asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top pt_k.asIdeal).resolve_right pt_k.isPrime.ne_top
    change Ideal.comap (Pi.evalRingHom (fun _ : ι_type => k) z) pt_k.asIdeal = w.asIdeal
    rw [hpt_bot]
    exact hEq_ideal

  have hRangeZ : Set.range ι_Z.base = Z_closed := by
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      obtain ⟨z, rfl⟩ := hZ_cover w
      rw [hj_pt_map z]
      exact z.2
    · intro hx
      refine ⟨(j ⟨x, hx⟩).base pt_k, hj_pt_map ⟨x, hx⟩⟩

  have hInjZ : Function.Injective ι_Z.base := by
    intro w₁ w₂ hw
    obtain ⟨z₁, rfl⟩ := hZ_cover w₁
    obtain ⟨z₂, rfl⟩ := hZ_cover w₂
    rw [hj_pt_map z₁, hj_pt_map z₂] at hw
    have hz : z₁ = z₂ := Subtype.ext hw
    rw [hz]

  have : Finite ↥Z := by
    change Finite (PrimeSpectrum (ι_type → k))
    have : IsScalarTower k (ι_type → k) (ι_type → k) :=
      ⟨fun c x y => Algebra.smul_mul_assoc c x y⟩
    have : IsArtinianRing (ι_type → k) :=
      isArtinian_of_tower k (S := ι_type → k) (M := ι_type → k) inferInstance
    exact IsArtinianRing.instFinitePrimeSpectrum (ι_type → k)

  have hClosedMapZ : IsClosedMap ι_Z.base := by
    intro T _
    have hFinT : T.Finite := Set.toFinite T
    have hImgUnion : ι_Z.base '' T = ⋃ w ∈ T, ({ι_Z.base w} : Set ↥C.left) := by
      ext y; simp [eq_comm]
    rw [hImgUnion]
    exact hFinT.isClosed_biUnion fun w _ =>
      hClosedPt (ι_Z.base w) (hRangeZ ▸ Set.mem_range_self w)

  have : AlgebraicGeometry.SurjectiveOnStalks ε :=
    AlgebraicGeometry.IsZariskiLocalAtSource.sigmaDesc (fun z =>
      ((AlgebraicGeometry.isClosedImmersion_iff (e z)).mp (he_cl z)).1)
  have hSurjStalks_Z : AlgebraicGeometry.SurjectiveOnStalks ι_Z := by
    dsimp [ι_Z]
    infer_instance

  have hClZ : AlgebraicGeometry.IsClosedImmersion ι_Z :=
    (AlgebraicGeometry.isClosedImmersion_iff ι_Z).mpr
      ⟨hSurjStalks_Z,
       Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap
         ι_Z.continuous hInjZ hClosedMapZ⟩

  
  let π_Z : Z ⟶ S_k :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (ι_type → k)))
  have hCompZ_eq : ι_Z ≫ C.hom = π_Z := by
    rw [← CategoryTheory.cancel_epi σ_Spec]
    apply CategoryTheory.Limits.Sigma.hom_ext
    intro z
    have hι : CategoryTheory.Limits.Sigma.ι (fun i : ι_type => AlgebraicGeometry.Spec (R_fam i)) z ≫
        σ_Spec = j z := AlgebraicGeometry.ι_sigmaSpec R_fam z
    calc
      CategoryTheory.Limits.Sigma.ι _ z ≫ σ_Spec ≫ (ι_Z ≫ C.hom) =
          (j z ≫ ι_Z) ≫ C.hom := by
        rw [← CategoryTheory.Category.assoc, hι]
        simp only [ι_Z, CategoryTheory.Category.assoc]
      _ = e z ≫ C.hom := by rw [hj_comp z]
      _ = 𝟙 S_k := he_sec z
      _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) :=
        (AlgebraicGeometry.Spec.map_id _).symm
      _ = j z ≫ π_Z := by
        dsimp [j, π_Z]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
      _ = CategoryTheory.Limits.Sigma.ι _ z ≫ σ_Spec ≫ π_Z := by
        rw [← CategoryTheory.Category.assoc, hι]

  have hFinZ_hom : AlgebraicGeometry.IsFinite (ι_Z ≫ C.hom) := by
    rw [hCompZ_eq]
    exact (AlgebraicGeometry.IsFinite.SpecMap_iff
      (CommRingCat.ofHom (algebraMap k (ι_type → k)))).mpr
      (show Module.Finite k (ι_type → k) from inferInstance)

  have hEtZ_hom : AlgebraicGeometry.Etale (ι_Z ≫ C.hom) := by
    rw [hCompZ_eq]
    have hAlgEt : Algebra.Etale k (ι_type → k) := inferInstance
    have hRingEt : RingHom.Etale (algebraMap k (ι_type → k)) := hAlgEt
    exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.Etale)).mpr hRingEt

  have hSurjZ_hom : AlgebraicGeometry.Surjective (ι_Z ≫ C.hom) := by
    obtain ⟨z₀⟩ := hNe_ι
    exact ⟨fun pt => ⟨(j z₀).base pt_k, Subsingleton.elim _ _⟩⟩

  have hComplZ : (Set.range ι_Z.base)ᶜ = (U_in : Set ↥C.left) := by
    rw [hRangeZ]
    exact compl_compl (U_in : Set ↥C.left)

  exact ⟨hConj1, Z, ι_Z, hClZ, hFinZ_hom, hEtZ_hom, hSurjZ_hom, hComplZ⟩

theorem weil_algClosed_proj_closedPoint_linear_centering (k : Type u) [Field k] [IsAlgClosed k]
    (M : ℕ) (hM : 1 ≤ M)
    (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₀ : Quiver.Hom V (weilProjectiveSpaceOver k M))
    (hCl₀ : AlgebraicGeometry.IsClosedImmersion ι₀.left)
    (x₀ : ↥V.left) (hx₀ : IsClosed ({x₀} : Set ↥V.left)) :
    let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
    ∃ (ι₁ : Quiver.Hom V (weilProjectiveSpaceOver k M)),
      AlgebraicGeometry.IsClosedImmersion ι₁.left ∧
      ι₁.left.base x₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0) ∧
      (∀ i : Fin M,
        ι₁.left.base x₀ ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ)) ∧
      (∀ p : ↥(weilProjectiveSpaceOver k M).left,
        p ≠ ι₁.left.base x₀ →
        ∃ i : Fin M, p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ)) :=
by
  classical
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
  change ∃ (ι₁ : Quiver.Hom V (weilProjectiveSpaceOver k M)),
    AlgebraicGeometry.IsClosedImmersion ι₁.left ∧
    ι₁.left.base x₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0) ∧
    (∀ i : Fin M,
      ι₁.left.base x₀ ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ)) ∧
    (∀ p : ↥(weilProjectiveSpaceOver k M).left,
      p ≠ ι₁.left.base x₀ →
      ∃ i : Fin M, p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ))

  have hAlg0_val : ∀ r : k,
      ((algebraMap k ↥(𝒜_M 0) r : ↥(𝒜_M 0)) : MvPolynomial (Fin (M + 1)) k) =
        MvPolynomial.C r := by
    intro r
    rw [Algebra.algebraMap_eq_smul_one, Submodule.coe_smul, SetLike.GradeZero.coe_one,
      Algebra.smul_def, MvPolynomial.algebraMap_eq, mul_one]

  
  have hCov_X : ∀ y : ↥(AlgebraicGeometry.Proj 𝒜_M),
      ∃ a : Fin (M + 1), y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X a) := by
    intro y
    by_contra! hNone
    let I_all : Ideal (MvPolynomial (Fin (M + 1)) k) :=
      Ideal.span (Set.range (MvPolynomial.X : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k))
    have hI_le : I_all ≤ y.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨a, rfl⟩
      exact (not_iff_comm.mp (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_M (MvPolynomial.X a) y)).mp
        (hNone a)
    have hDiff_all : ∀ Q : MvPolynomial (Fin (M + 1)) k,
        Q - MvPolynomial.C (MvPolynomial.constantCoeff Q) ∈ I_all := by
      intro Q
      induction Q using MvPolynomial.induction_on with
      | C r =>
        rw [MvPolynomial.constantCoeff_C, sub_self]
        exact I_all.zero_mem
      | add p q hp hq =>
        have heq : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
          rw [map_add, map_add]
          ring
        rw [heq]
        exact I_all.add_mem hp hq
      | mul_X p a _ =>
        rw [map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
        exact I_all.mul_mem_left p (Ideal.subset_span ⟨a, rfl⟩)
    apply y.not_irrelevant_le
    rw [HomogeneousIdeal.irrelevant_le]
    intro d hd Q hQ
    have hQ_hom : Q.IsHomogeneous d := hQ
    have hdeg0 : Finsupp.degree (0 : Fin (M + 1) →₀ ℕ) ≠ d := by
      rw [map_zero]
      exact Nat.ne_of_lt hd
    have hc0 : MvPolynomial.constantCoeff Q = 0 := by
      rw [MvPolynomial.constantCoeff_eq]
      exact hQ_hom.coeff_eq_zero hdeg0
    have hQ_mem : Q ∈ I_all := by
      simpa [hc0] using hDiff_all Q
    exact hI_le hQ_mem

  
  haveI : AlgebraicGeometry.IsClosedImmersion ι₀.left := hCl₀
  let p₀ : ↥(AlgebraicGeometry.Proj 𝒜_M) := ι₀.left.base x₀
  have hp₀_closed : IsClosed ({p₀} : Set ↥(AlgebraicGeometry.Proj 𝒜_M)) := by
    have hImg : IsClosed (ι₀.left.base '' ({x₀} : Set ↥V.left)) :=
      ι₀.left.isClosedEmbedding.isClosedMap _ hx₀
    rwa [Set.image_singleton] at hImg

  obtain ⟨a₀, hp₀_a₀⟩ := hCov_X p₀
  let U_a₀ : (AlgebraicGeometry.Proj 𝒜_M).Opens :=
    AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X a₀)
  have hXa₀ : (MvPolynomial.X a₀ : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
    MvPolynomial.isHomogeneous_X k a₀
  let iso_a₀ := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X a₀) hXa₀ zero_lt_one
  let away_hom := AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X a₀) hXa₀ zero_lt_one
  have h_away_eq : iso_a₀.inv ≫ U_a₀.ι = away_hom :=
    AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (MvPolynomial.X a₀) hXa₀ zero_lt_one
  haveI : AlgebraicGeometry.IsOpenImmersion away_hom := by
    rw [← h_away_eq]
    infer_instance

  let p_U : ↥U_a₀.toScheme := ⟨p₀, hp₀_a₀⟩
  let p_spec : PrimeSpectrum (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a₀)) :=
    iso_a₀.hom.base p_U
  have h_away_p : away_hom.base p_spec = p₀ := by
    change (iso_a₀.hom ≫ away_hom).base p_U = p₀
    rw [← h_away_eq, CategoryTheory.Iso.hom_inv_id_assoc]
    rfl
  have hPre_pspec :
      away_hom.base ⁻¹' ({p₀} : Set ↥(AlgebraicGeometry.Proj 𝒜_M)) =
        ({p_spec} : Set (PrimeSpectrum (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a₀)))) := by
    ext q
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨fun hq => away_hom.isOpenEmbedding.injective (hq.trans h_away_p.symm),
      fun hq => hq.symm ▸ h_away_p⟩
  have hClosed_pspec :
      IsClosed ({p_spec} : Set (PrimeSpectrum (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a₀)))) := by
    rw [← hPre_pspec]
    exact hp₀_closed.preimage away_hom.isOpenEmbedding.continuous
  haveI hMax_pspec : p_spec.asIdeal.IsMaximal :=
    (PrimeSpectrum.isClosed_singleton_iff_isMaximal p_spec).mp hClosed_pspec

  let S_a₀ : Submonoid (MvPolynomial (Fin (M + 1)) k) := Submonoid.powers (MvPolynomial.X a₀)
  let d₁ : ↥S_a₀ := ⟨MvPolynomial.X a₀, Submonoid.mem_powers (MvPolynomial.X a₀)⟩
  have hMk_add_same : ∀ (d : ↥S_a₀) (a b : MvPolynomial (Fin (M + 1)) k),
      Localization.mk a d + Localization.mk b d = Localization.mk (a + b) d := by
    intro d a b
    calc Localization.mk a d + Localization.mk b d
        = Localization.mk ((d : MvPolynomial (Fin (M + 1)) k) * (a + b)) (d * d) := by
            rw [Localization.add_mk]
            congr 1
            ring
      _ = Localization.mk (d : MvPolynomial (Fin (M + 1)) k) d * Localization.mk (a + b) d := by
            rw [Localization.mk_mul]
      _ = Localization.mk (a + b) d := by
            rw [Localization.mk_self, one_mul]
  have hMk_sum : ∀ {ι_s : Type} (d : ↥S_a₀) (T : Finset ι_s)
      (a : ι_s → MvPolynomial (Fin (M + 1)) k),
      (∑ t ∈ T, Localization.mk (a t) d) = Localization.mk (∑ t ∈ T, a t) d := by
    intro ι_s d T a
    induction T using Finset.cons_induction with
    | empty =>
      simp only [Finset.sum_empty]
      have h0 : Localization.mk (0 : MvPolynomial (Fin (M + 1)) k) d +
          Localization.mk (0 : MvPolynomial (Fin (M + 1)) k) d =
          Localization.mk (0 : MvPolynomial (Fin (M + 1)) k) d + 0 := by
        rw [hMk_add_same, add_zero, add_zero]
      exact (add_left_cancel h0).symm
    | cons t T _ ih =>
      rw [Finset.sum_cons, Finset.sum_cons, ih, hMk_add_same]
  have hMk_prod : ∀ {ι_s : Type} (T : Finset ι_s)
      (a : ι_s → MvPolynomial (Fin (M + 1)) k) (d : ι_s → ↥S_a₀),
      (∏ t ∈ T, Localization.mk (a t) (d t)) = Localization.mk (∏ t ∈ T, a t) (∏ t ∈ T, d t) := by
    intro ι_s T a d
    induction T using Finset.cons_induction with
    | empty =>
      simp only [Finset.prod_empty, Localization.mk_one]
    | cons t T _ ih =>
      rw [Finset.prod_cons, Finset.prod_cons, Finset.prod_cons, ih, Localization.mk_mul]

  let ι₀_k : k →+* HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a₀) :=
    (HomogeneousLocalization.fromZeroRingHom 𝒜_M S_a₀).comp (algebraMap k ↥(𝒜_M 0))
  let y_gen : Fin (M + 1) → HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a₀) :=
    fun b => HomogeneousLocalization.Away.isLocalizationElem hXa₀ (MvPolynomial.isHomogeneous_X k b)
  let ψ_dehom : MvPolynomial (Fin (M + 1)) k →+*
      HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a₀) :=
    MvPolynomial.eval₂Hom ι₀_k y_gen
  let valHom : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a₀) →+* Localization S_a₀ :=
    { toFun := HomogeneousLocalization.val
      map_one' := HomogeneousLocalization.val_one
      map_mul' := HomogeneousLocalization.val_mul
      map_zero' := HomogeneousLocalization.val_zero
      map_add' := HomogeneousLocalization.val_add }

  have hVal_ι₀ : ∀ r : k, valHom (ι₀_k r) = Localization.mk (MvPolynomial.C r) 1 := by
    intro r
    change (HomogeneousLocalization.fromZeroRingHom 𝒜_M S_a₀ (algebraMap k ↥(𝒜_M 0) r)).val = _
    erw [HomogeneousLocalization.val_mk]
    congr 1 <;>
      simp only [hAlg0_val, Subtype.ext_iff, SetLike.GradeZero.coe_one, Submonoid.coe_one]

  have hVal_y : ∀ b : Fin (M + 1), valHom (y_gen b) = Localization.mk (MvPolynomial.X b) d₁ := by
    intro b
    change (HomogeneousLocalization.Away.isLocalizationElem hXa₀
      (MvPolynomial.isHomogeneous_X k b)).val = _
    rw [HomogeneousLocalization.Away.val_mk]
    congr 1 <;> simp only [Subtype.ext_iff, pow_one, d₁]

  have hSurj_dehom : Function.Surjective ψ_dehom := by
    intro z
    obtain ⟨n, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜_M hXa₀ z
    have hF_hom : F.IsHomogeneous n := by
      have hF' : F.IsHomogeneous (n • 1) := hF
      rwa [nsmul_eq_mul, mul_one] at hF'
    refine ⟨F, ?_⟩
    apply HomogeneousLocalization.val_injective
    change valHom (ψ_dehom F) = (HomogeneousLocalization.Away.mk 𝒜_M hXa₀ n F hF).val
    rw [HomogeneousLocalization.Away.val_mk]
    have hLHS : valHom (ψ_dehom F) = Localization.mk F (d₁ ^ n) := by
      calc valHom (ψ_dehom F)
          = ∑ s ∈ F.support,
              valHom (ψ_dehom (MvPolynomial.monomial s (F.coeff s))) := by
                conv_lhs => rw [MvPolynomial.as_sum F]
                rw [map_sum, map_sum]
        _ = ∑ s ∈ F.support,
              Localization.mk (MvPolynomial.monomial s (F.coeff s)) (d₁ ^ n) := by
                refine Finset.sum_congr rfl (fun s hs => ?_)
                have hdeg_s : Finsupp.degree s = n := by
                  by_contra hne
                  exact (MvPolynomial.mem_support_iff.mp hs) (hF_hom.coeff_eq_zero hne)
                have hsum_s : (∑ b : Fin (M + 1), s b) = n := by
                  rw [← Finsupp.degree_eq_sum]
                  exact hdeg_s
                change valHom (MvPolynomial.eval₂Hom ι₀_k y_gen
                  (MvPolynomial.monomial s (F.coeff s))) = _
                rw [MvPolynomial.eval₂Hom_monomial, Finsupp.prod_pow, map_mul, map_prod,
                  hVal_ι₀]
                have hprod_eq :
                    (∏ b : Fin (M + 1), valHom (y_gen b ^ s b)) =
                      Localization.mk (∏ b : Fin (M + 1), MvPolynomial.X b ^ s b) (d₁ ^ n) := by
                  have hp1 : (∏ b : Fin (M + 1), valHom (y_gen b ^ s b)) =
                      ∏ b : Fin (M + 1), Localization.mk (MvPolynomial.X b ^ s b) (d₁ ^ s b) := by
                    refine Finset.prod_congr rfl (fun b _ => ?_)
                    rw [map_pow, hVal_y, Localization.mk_pow]
                  rw [hp1,
                    hMk_prod Finset.univ (fun b : Fin (M + 1) => MvPolynomial.X b ^ s b)
                      (fun b : Fin (M + 1) => d₁ ^ s b),
                    Finset.prod_pow_eq_pow_sum, hsum_s]
                rw [hprod_eq, Localization.mk_mul, one_mul, MvPolynomial.monomial_eq,
                  Finsupp.prod_pow]
        _ = Localization.mk
              (∑ s ∈ F.support, MvPolynomial.monomial s (F.coeff s)) (d₁ ^ n) :=
                hMk_sum (d₁ ^ n) F.support _
        _ = Localization.mk F (d₁ ^ n) := by
                rw [← MvPolynomial.as_sum F]
    rw [hLHS]
    congr 1 <;> simp only [Subtype.ext_iff, d₁, Submonoid.coe_pow]

  have hMax_comap : (Ideal.comap ψ_dehom p_spec.asIdeal).IsMaximal :=
    Ideal.comap_isMaximal_of_surjective ψ_dehom hSurj_dehom
  obtain ⟨v_pt, hv_pt⟩ :=
    (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton).mp hMax_comap
  have hMem_iff : ∀ P : MvPolynomial (Fin (M + 1)) k,
      ψ_dehom P ∈ p_spec.asIdeal ↔ (MvPolynomial.aeval v_pt) P = 0 := by
    intro P
    change P ∈ Ideal.comap ψ_dehom p_spec.asIdeal ↔ _
    rw [hv_pt, MvPolynomial.mem_vanishingIdeal_iff]
    simp

  let σ : Equiv.Perm (Fin (M + 1)) := Equiv.swap (0 : Fin (M + 1)) a₀
  let c : Fin M → k := fun i => v_pt (σ i.succ)

  have hp₀_not_Li : ∀ i : Fin M,
      p₀ ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M
        (MvPolynomial.X (σ i.succ) - MvPolynomial.C (c i) * MvPolynomial.X a₀) := by
    intro i
    let L_i : MvPolynomial (Fin (M + 1)) k :=
      MvPolynomial.X (σ i.succ) - MvPolynomial.C (c i) * MvPolynomial.X a₀
    have hXσ : (MvPolynomial.X (σ i.succ) : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
      MvPolynomial.isHomogeneous_X k (σ i.succ)
    have hLi : L_i ∈ 𝒜_M 1 := by
      refine Submodule.sub_mem _ hXσ ?_
      change (MvPolynomial.C (c i) * MvPolynomial.X a₀).IsHomogeneous 1
      simpa using (MvPolynomial.isHomogeneous_C (Fin (M + 1)) (c i)).mul
        (MvPolynomial.isHomogeneous_X k a₀)
    have hElem_eq :
        HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLi =
          ψ_dehom (MvPolynomial.X (σ i.succ) - MvPolynomial.C (c i)) := by
      change HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLi =
        MvPolynomial.eval₂Hom ι₀_k y_gen (MvPolynomial.X (σ i.succ) - MvPolynomial.C (c i))
      rw [map_sub, MvPolynomial.eval₂Hom_X' ι₀_k y_gen (σ i.succ),
        MvPolynomial.eval₂Hom_C ι₀_k y_gen (c i)]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_sub, HomogeneousLocalization.Away.val_mk]
      change Localization.mk (L_i ^ 1) _ =
        valHom (y_gen (σ i.succ)) - valHom (ι₀_k (c i))
      rw [hVal_y, hVal_ι₀, Localization.sub_mk]
      congr 1
      · simp only [Submonoid.coe_one, d₁, pow_one, L_i]
        ring
      · apply Subtype.ext
        simp [d₁]
    have hElem_mem : HomogeneousLocalization.Away.isLocalizationElem hXa₀ hLi ∈ p_spec.asIdeal := by
      rw [hElem_eq, hMem_iff]
      simp [c]
    intro hp_mem
    have hpre_mem : p_spec ∈
        (TopologicalSpace.Opens.map away_hom.base).obj
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M L_i) := by
      change away_hom.base p_spec ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M L_i
      rwa [h_away_p]
    rw [AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_M hXa₀ zero_lt_one hLi zero_lt_one]
      at hpre_mem
    exact hpre_mem hElem_mem

  
  let F_gen : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k :=
    Fin.cases (MvPolynomial.X a₀)
      (fun i : Fin M => MvPolynomial.X (σ i.succ) - MvPolynomial.C (c i) * MvPolynomial.X a₀)
  let G_gen : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k := fun b =>
    Fin.cases (MvPolynomial.X 0)
      (fun i : Fin M => MvPolynomial.X i.succ + MvPolynomial.C (c i) * MvPolynomial.X 0) (σ b)

  have hF_hom : ∀ j : Fin (M + 1), (F_gen j).IsHomogeneous 1 := by
    refine Fin.cases ?_ (fun i => ?_)
    · exact MvPolynomial.isHomogeneous_X k a₀
    · dsimp [F_gen]
      have h1 : (MvPolynomial.X (σ i.succ) : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
        MvPolynomial.isHomogeneous_X k (σ i.succ)
      have h2 : (MvPolynomial.C (c i) * MvPolynomial.X a₀ : MvPolynomial (Fin (M + 1)) k) ∈
          𝒜_M 1 := by
        change (MvPolynomial.C (c i) * MvPolynomial.X a₀).IsHomogeneous 1
        simpa using (MvPolynomial.isHomogeneous_C (Fin (M + 1)) (c i)).mul
          (MvPolynomial.isHomogeneous_X k a₀)
      exact Submodule.sub_mem _ h1 h2

  have hG_hom : ∀ b : Fin (M + 1), (G_gen b).IsHomogeneous 1 := by
    intro b
    dsimp only [G_gen]
    generalize σ b = u
    refine Fin.cases ?_ (fun i => ?_) u
    · exact MvPolynomial.isHomogeneous_X k 0
    · dsimp only [Fin.cases_succ]
      refine (MvPolynomial.isHomogeneous_X k i.succ).add ?_
      simpa using (MvPolynomial.isHomogeneous_C (Fin (M + 1)) (c i)).mul
        (MvPolynomial.isHomogeneous_X k 0)

  let Φ₀ : MvPolynomial (Fin (M + 1)) k →+* MvPolynomial (Fin (M + 1)) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C F_gen
  let Ψ₀ : MvPolynomial (Fin (M + 1)) k →+* MvPolynomial (Fin (M + 1)) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C G_gen

  let f : 𝒜_M →+*ᵍ 𝒜_M :=
    { toRingHom := Φ₀
      map_mem := fun {n p} hp => by
        have hp' : p.IsHomogeneous n := hp
        have hev := hp'.eval₂ MvPolynomial.C F_gen
          (fun r => MvPolynomial.isHomogeneous_C (Fin (M + 1)) r) hF_hom
        rw [Nat.one_mul] at hev
        exact hev }
  let g : 𝒜_M →+*ᵍ 𝒜_M :=
    { toRingHom := Ψ₀
      map_mem := fun {n p} hp => by
        have hp' : p.IsHomogeneous n := hp
        have hev := hp'.eval₂ MvPolynomial.C G_gen
          (fun r => MvPolynomial.isHomogeneous_C (Fin (M + 1)) r) hG_hom
        rw [Nat.one_mul] at hev
        exact hev }

  have hC : ∀ r : k, f (MvPolynomial.C r) = MvPolynomial.C r :=
    fun r => MvPolynomial.eval₂Hom_C MvPolynomial.C F_gen r
  have hf0 : f (MvPolynomial.X 0) = MvPolynomial.X a₀ := by
    change Φ₀ (MvPolynomial.X 0) = MvPolynomial.X a₀
    rw [MvPolynomial.eval₂Hom_X' MvPolynomial.C F_gen 0]
    rfl
  have hfi : ∀ i : Fin M,
      f (MvPolynomial.X i.succ) =
        MvPolynomial.X (σ i.succ) - MvPolynomial.C (c i) * MvPolynomial.X a₀ := by
    intro i
    change Φ₀ (MvPolynomial.X i.succ) = _
    rw [MvPolynomial.eval₂Hom_X' MvPolynomial.C F_gen i.succ]
    rfl

  have hgf_ring : Ψ₀.comp Φ₀ = RingHom.id (MvPolynomial (Fin (M + 1)) k) := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      simp [Φ₀, Ψ₀]
    · refine Fin.cases ?_ (fun i => ?_)
      · simp only [RingHom.comp_apply, RingHom.id_apply, Φ₀, Ψ₀,
          MvPolynomial.eval₂Hom_X', F_gen, Fin.cases_zero, G_gen]
        have hσa : σ a₀ = 0 := by
          dsimp [σ]
          exact Equiv.swap_apply_right (0 : Fin (M + 1)) a₀
        rw [hσa, Fin.cases_zero]
      · simp only [RingHom.comp_apply, RingHom.id_apply, Φ₀, Ψ₀,
          MvPolynomial.eval₂Hom_X', F_gen, Fin.cases_succ, map_sub, map_mul,
          MvPolynomial.eval₂Hom_C, G_gen]
        have hσs : σ (σ i.succ) = i.succ := Equiv.swap_apply_self (0 : Fin (M + 1)) a₀ i.succ
        have hσa : σ a₀ = 0 := Equiv.swap_apply_right (0 : Fin (M + 1)) a₀
        rw [hσs, hσa, Fin.cases_succ, Fin.cases_zero]
        ring

  have hfg_ring : Φ₀.comp Ψ₀ = RingHom.id (MvPolynomial (Fin (M + 1)) k) := by
    apply MvPolynomial.ringHom_ext'
    · ext r
      simp [Φ₀, Ψ₀]
    · intro b
      simp only [RingHom.comp_apply, RingHom.id_apply, Ψ₀, MvPolynomial.eval₂Hom_X', G_gen]
      have hb_inv : σ (σ b) = b := Equiv.swap_apply_self (0 : Fin (M + 1)) a₀ b
      revert hb_inv
      generalize σ b = u
      refine Fin.cases ?_ (fun i => ?_) u
      · intro hb0
        have ha : a₀ = b := by
          calc a₀ = σ 0 := (Equiv.swap_apply_left (0 : Fin (M + 1)) a₀).symm
            _ = b := hb0
        simp only [Fin.cases_zero, Φ₀, MvPolynomial.eval₂Hom_X', F_gen, ha]
      · intro hbs
        simp only [Fin.cases_succ, map_add, map_mul, Φ₀, MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C, F_gen, Fin.cases_zero, hbs]
        ring

  have hgf : g.comp f = GradedRingHom.id 𝒜_M := by
    apply GradedRingHom.ext
    intro x
    exact congrArg (fun φ : MvPolynomial (Fin (M + 1)) k →+* MvPolynomial (Fin (M + 1)) k => φ x)
      hgf_ring
  have hfg : f.comp g = GradedRingHom.id 𝒜_M := by
    apply GradedRingHom.ext
    intro x
    exact congrArg (fun φ : MvPolynomial (Fin (M + 1)) k →+* MvPolynomial (Fin (M + 1)) k => φ x)
      hfg_ring

  have hIrrel_of_comp :
      ∀ (u v : 𝒜_M →+*ᵍ 𝒜_M),
        u.comp v = GradedRingHom.id 𝒜_M →
        HomogeneousIdeal.irrelevant 𝒜_M ≤
          HomogeneousIdeal.map u (HomogeneousIdeal.irrelevant 𝒜_M) := by
    intro u v huv
    rw [HomogeneousIdeal.irrelevant_le]
    intro d hd x hx
    have hvx : v x ∈ HomogeneousIdeal.irrelevant 𝒜_M :=
      HomogeneousIdeal.mem_irrelevant_of_mem 𝒜_M hd (v.map_mem hx)
    have huvx : u (v x) ∈ (HomogeneousIdeal.map u (HomogeneousIdeal.irrelevant 𝒜_M)).toIdeal :=
      Ideal.mem_map_of_mem u.toRingHom hvx
    have heq : u (v x) = x := congrArg (fun φ : 𝒜_M →+*ᵍ 𝒜_M => φ x) huv
    rwa [heq] at huvx

  have hf : HomogeneousIdeal.irrelevant 𝒜_M ≤
      HomogeneousIdeal.map f (HomogeneousIdeal.irrelevant 𝒜_M) :=
    hIrrel_of_comp f g hfg
  have hg : HomogeneousIdeal.irrelevant 𝒜_M ≤
      HomogeneousIdeal.map g (HomogeneousIdeal.irrelevant 𝒜_M) :=
    hIrrel_of_comp g f hgf

  
  let τ_left : AlgebraicGeometry.Proj 𝒜_M ⟶ AlgebraicGeometry.Proj 𝒜_M :=
    AlgebraicGeometry.Proj.map f hf
  let τ_inv : AlgebraicGeometry.Proj 𝒜_M ⟶ AlgebraicGeometry.Proj 𝒜_M :=
    AlgebraicGeometry.Proj.map g hg

  have hMap_eq_id :
      ∀ (h : 𝒜_M →+*ᵍ 𝒜_M)
        (hh : HomogeneousIdeal.irrelevant 𝒜_M ≤
          HomogeneousIdeal.map h (HomogeneousIdeal.irrelevant 𝒜_M)),
        h = GradedRingHom.id 𝒜_M →
        AlgebraicGeometry.Proj.map h hh = 𝟙 (AlgebraicGeometry.Proj 𝒜_M) := by
    rintro _ hh rfl
    exact AlgebraicGeometry.Proj.map_id

  have hτ_hom_inv : τ_left ≫ τ_inv = 𝟙 (AlgebraicGeometry.Proj 𝒜_M) := by
    dsimp [τ_left, τ_inv]
    rw [← AlgebraicGeometry.Proj.map_comp g f hg hf]
    exact hMap_eq_id (f.comp g) _ hfg

  have hτ_inv_hom : τ_inv ≫ τ_left = 𝟙 (AlgebraicGeometry.Proj 𝒜_M) := by
    dsimp [τ_left, τ_inv]
    rw [← AlgebraicGeometry.Proj.map_comp f g hf hg]
    exact hMap_eq_id (g.comp f) _ hgf

  have hIso_τ_left : CategoryTheory.IsIso τ_left := ⟨⟨τ_inv, hτ_hom_inv, hτ_inv_hom⟩⟩
  have hPre_τ : ∀ s : MvPolynomial (Fin (M + 1)) k,
      (TopologicalSpace.Opens.map τ_left.base).obj (AlgebraicGeometry.Proj.basicOpen 𝒜_M s) =
        AlgebraicGeometry.Proj.basicOpen 𝒜_M (f s) :=
    fun s => AlgebraicGeometry.Proj.map_preimage_basicOpen f hf s

  let V_cov : Fin (M + 1) → (AlgebraicGeometry.Proj 𝒜_M).Opens :=
    fun a => AlgebraicGeometry.Proj.basicOpen 𝒜_M (f (MvPolynomial.X a))
  have hSup_V : (⨆ a : Fin (M + 1), V_cov a) = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨a, ha⟩ := hCov_X (τ_left.base y)
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨a, ?_⟩
    have hpre_y : y ∈ (TopologicalSpace.Opens.map τ_left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X a)) := ha
    rwa [hPre_τ (MvPolynomial.X a)] at hpre_y

  let π_M : AlgebraicGeometry.Proj 𝒜_M ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
    AlgebraicGeometry.Proj.toSpecZero 𝒜_M ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)))
  have hτ_over_local :
      ∀ a : Fin (M + 1),
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (f (MvPolynomial.X a))).ι ≫ (τ_left ≫ π_M) =
          (AlgebraicGeometry.Proj.basicOpen 𝒜_M (f (MvPolynomial.X a))).ι ≫ π_M := by
    intro a
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (M + 1)) k) ∈ 𝒜_M 1 :=
      MvPolynomial.isHomogeneous_X k a
    have hfXa : f (MvPolynomial.X a) ∈ 𝒜_M 1 := f.map_mem hXa
    apply (CategoryTheory.cancel_epi
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (f (MvPolynomial.X a)) hfXa zero_lt_one).inv).mp
    calc
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (f (MvPolynomial.X a)) hfXa zero_lt_one).inv ≫
          ((AlgebraicGeometry.Proj.basicOpen 𝒜_M (f (MvPolynomial.X a))).ι ≫ (τ_left ≫ π_M))
        = (AlgebraicGeometry.Proj.awayι 𝒜_M (f (MvPolynomial.X a)) hfXa zero_lt_one ≫
            AlgebraicGeometry.Proj.map f hf) ≫ π_M := by
            dsimp only [τ_left]
            rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (f (MvPolynomial.X a))
              hfXa zero_lt_one]
            simp only [CategoryTheory.Category.assoc]
      _ = (AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X a) hXa zero_lt_one) ≫ π_M := by
            rw [AlgebraicGeometry.Proj.awayι_comp_map f hf zero_lt_one (MvPolynomial.X a) hXa]
      _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) ≫
            (AlgebraicGeometry.Proj.awayι 𝒜_M (MvPolynomial.X a) hXa zero_lt_one ≫
              AlgebraicGeometry.Proj.toSpecZero 𝒜_M) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0))) := by
            dsimp only [π_M]
            simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)) ≫
              CommRingCat.ofHom
                (HomogeneousLocalization.fromZeroRingHom 𝒜_M
                  (Submonoid.powers (MvPolynomial.X a))) ≫
              CommRingCat.ofHom (HomogeneousLocalization.Away.map f (MvPolynomial.X a))) := by
            rw [AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_M (MvPolynomial.X a) hXa zero_lt_one,
              AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
              CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)) ≫
              CommRingCat.ofHom
                (HomogeneousLocalization.fromZeroRingHom 𝒜_M
                  (Submonoid.powers (f (MvPolynomial.X a))))) := by
            congr 1
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro r
            change HomogeneousLocalization.Away.map f (MvPolynomial.X a)
                (HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X a))
                  (algebraMap k ↥(𝒜_M 0) r)) =
              HomogeneousLocalization.fromZeroRingHom 𝒜_M
                (Submonoid.powers (f (MvPolynomial.X a)))
                (algebraMap k ↥(𝒜_M 0) r)
            apply HomogeneousLocalization.val_injective
            erw [HomogeneousLocalization.map_mk]
            rw [HomogeneousLocalization.val_mk]
            erw [HomogeneousLocalization.val_mk]
            congr 1 <;>
              simp only [hAlg0_val, hC, Subtype.ext_iff, SetLike.GradeZero.coe_one,
                Submonoid.coe_one, map_one]
      _ = (AlgebraicGeometry.Proj.awayι 𝒜_M (f (MvPolynomial.X a)) hfXa zero_lt_one ≫
            AlgebraicGeometry.Proj.toSpecZero 𝒜_M) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0))) := by
            rw [AlgebraicGeometry.Spec.map_comp,
              AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_M (f (MvPolynomial.X a)) hfXa zero_lt_one]
      _ = (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (f (MvPolynomial.X a)) hfXa
            zero_lt_one).inv ≫
          ((AlgebraicGeometry.Proj.basicOpen 𝒜_M (f (MvPolynomial.X a))).ι ≫ π_M) := by
            dsimp only [π_M]
            rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (f (MvPolynomial.X a))
              hfXa zero_lt_one]
            simp only [CategoryTheory.Category.assoc]

  have hτ_over : τ_left ≫ π_M = π_M :=
    AlgebraicGeometry.Scheme.Cover.hom_ext
      ((AlgebraicGeometry.Proj 𝒜_M).openCoverOfIsOpenCover V_cov
        (TopologicalSpace.IsOpenCover.mk hSup_V))
      (τ_left ≫ π_M) π_M (fun a => hτ_over_local a)

  let τ : Quiver.Hom (weilProjectiveSpaceOver k M) (weilProjectiveSpaceOver k M) :=
    CategoryTheory.Over.homMk τ_left hτ_over

  
  have hOriginCompl :
      ∀ (p_star : ↥(weilProjectiveSpaceOver k M).left),
        p_star ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0) →
        (∀ i : Fin M,
          p_star ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ)) →
        ∀ p : ↥(weilProjectiveSpaceOver k M).left,
          p ≠ p_star →
          ∃ i : Fin M, p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ) := by
    intro p_star hp0 hpi p hp_ne
    by_contra! hAll
    obtain ⟨a_p, ha_p⟩ := hCov_X p
    have hp_X0 : p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0) := by
      revert ha_p
      refine Fin.cases ?_ (fun i hi => False.elim (hAll i hi)) a_p
      exact id
    let g₀ : Fin (M + 1) → MvPolynomial (Fin (M + 1)) k :=
      Fin.cases (MvPolynomial.X 0) (fun _ : Fin M => 0)
    let ρ₀ : MvPolynomial (Fin (M + 1)) k →+* MvPolynomial (Fin (M + 1)) k :=
      MvPolynomial.eval₂Hom MvPolynomial.C g₀
    let I₁ : Ideal (MvPolynomial (Fin (M + 1)) k) :=
      Ideal.span (Set.range (fun i : Fin M => (MvPolynomial.X i.succ : MvPolynomial (Fin (M + 1)) k)))
    have hDiff_ρ₀ : ∀ R : MvPolynomial (Fin (M + 1)) k, R - ρ₀ R ∈ I₁ := by
      intro R
      induction R using MvPolynomial.induction_on with
      | C r =>
        simp only [ρ₀, MvPolynomial.eval₂Hom_C, sub_self]
        exact I₁.zero_mem
      | add R₁ R₂ h₁ h₂ =>
        have heq : R₁ + R₂ - ρ₀ (R₁ + R₂) = (R₁ - ρ₀ R₁) + (R₂ - ρ₀ R₂) := by
          rw [map_add]
          ring
        rw [heq]
        exact I₁.add_mem h₁ h₂
      | mul_X R b hR =>
        refine Fin.cases ?_ (fun i => ?_) b
        · have heq : R * MvPolynomial.X 0 - ρ₀ (R * MvPolynomial.X 0) =
              (R - ρ₀ R) * MvPolynomial.X 0 := by
            simp only [map_mul, ρ₀, MvPolynomial.eval₂Hom_X', g₀, Fin.cases_zero]
            ring
          rw [heq]
          exact I₁.mul_mem_right _ hR
        · simp only [map_mul, ρ₀, MvPolynomial.eval₂Hom_X', g₀, Fin.cases_succ, mul_zero,
            sub_zero]
          exact I₁.mul_mem_left R (Ideal.subset_span ⟨i, rfl⟩)
    have hHom_ρ₀ : ∀ (d : ℕ) (Q : MvPolynomial (Fin (M + 1)) k),
        Q.IsHomogeneous d →
        ∃ c_d : k, ρ₀ Q = MvPolynomial.C c_d * MvPolynomial.X 0 ^ d := by
      intro d Q hQ
      let c_term : (Fin (M + 1) →₀ ℕ) → k := fun s =>
        if ∀ i : Fin M, s i.succ = 0 then Q.coeff s else 0
      refine ⟨∑ s ∈ Q.support, c_term s, ?_⟩
      conv_lhs => rw [MvPolynomial.as_sum Q]
      rw [map_sum, map_sum, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun s hs => ?_)
      have hdeg_s : Finsupp.degree s = d := by
        by_contra hne
        exact (MvPolynomial.mem_support_iff.mp hs) (hQ.coeff_eq_zero hne)
      have hsum_s : s 0 + ∑ i : Fin M, s i.succ = d := by
        rw [← Fin.sum_univ_succ, ← Finsupp.degree_eq_sum]
        exact hdeg_s
      change MvPolynomial.eval₂Hom MvPolynomial.C g₀
          (MvPolynomial.monomial s (Q.coeff s)) = _
      rw [MvPolynomial.eval₂Hom_monomial, Finsupp.prod_pow, Fin.prod_univ_succ]
      dsimp only [g₀, Fin.cases_zero, Fin.cases_succ, c_term]
      by_cases hall0 : ∀ i : Fin M, s i.succ = 0
      · rw [if_pos hall0]
        have hsum0 : (∑ i : Fin M, s i.succ) = 0 :=
          Finset.sum_eq_zero (fun i _ => hall0 i)
        have hs0 : s 0 = d := by omega
        have hprod1 :
            (∏ i : Fin M, (0 : MvPolynomial (Fin (M + 1)) k) ^ s i.succ) = 1 := by
          refine Finset.prod_eq_one (fun i _ => ?_)
          rw [hall0 i, pow_zero]
        rw [hprod1, mul_one, hs0]
      · rw [if_neg hall0, MvPolynomial.C.map_zero, zero_mul]
        push_neg at hall0
        obtain ⟨i, hi⟩ := hall0
        have hprod0 :
            (∏ i' : Fin M, (0 : MvPolynomial (Fin (M + 1)) k) ^ s i'.succ) = 0 :=
          Finset.prod_eq_zero (Finset.mem_univ i) (zero_pow hi)
        rw [hprod0, mul_zero, mul_zero]
    have hEqKer : ∀ 𝔮 : ProjectiveSpectrum 𝒜_M,
        (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) k) ∉ 𝔮.asHomogeneousIdeal →
        (∀ i : Fin M,
          (MvPolynomial.X i.succ : MvPolynomial (Fin (M + 1)) k) ∈ 𝔮.asHomogeneousIdeal.toIdeal) →
        𝔮.asHomogeneousIdeal.toIdeal = RingHom.ker ρ₀ := by
      intro 𝔮 hX0_not hXi_mem
      have hI₁_le : I₁ ≤ 𝔮.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        exact hXi_mem i
      apply le_antisymm
      · intro R hR
        rw [RingHom.mem_ker, ← MvPolynomial.sum_homogeneousComponent R, map_sum]
        refine Finset.sum_eq_zero (fun d _ => ?_)
        let Q := MvPolynomial.homogeneousComponent d R
        have hQ_mem : Q ∈ 𝔮.asHomogeneousIdeal.toIdeal := by
          dsimp [Q]
          rw [← MvPolynomial.decomposition.decompose'_apply R d]
          exact (Ideal.IsHomogeneous.mem_iff 𝒜_M 𝔮.asHomogeneousIdeal.isHomogeneous).mp hR d
        have hρQ_mem : ρ₀ Q ∈ 𝔮.asHomogeneousIdeal.toIdeal := by
          have hsub := 𝔮.asHomogeneousIdeal.toIdeal.sub_mem hQ_mem (hI₁_le (hDiff_ρ₀ Q))
          simpa using hsub
        obtain ⟨c_d, hρQ_eq⟩ := hHom_ρ₀ d Q (MvPolynomial.homogeneousComponent_isHomogeneous d R)
        rw [hρQ_eq] at hρQ_mem ⊢
        by_cases hc0 : c_d = 0
        · rw [hc0, map_zero, zero_mul]
        · exfalso
          have hpow_mem :
              (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) k) ^ d ∈
                𝔮.asHomogeneousIdeal.toIdeal := by
            have hmul := 𝔮.asHomogeneousIdeal.toIdeal.mul_mem_left (MvPolynomial.C c_d⁻¹) hρQ_mem
            have hcancel :
                (MvPolynomial.C c_d⁻¹ : MvPolynomial (Fin (M + 1)) k) *
                  (MvPolynomial.C c_d * MvPolynomial.X 0 ^ d) = MvPolynomial.X 0 ^ d := by
              rw [← mul_assoc, ← map_mul, inv_mul_cancel₀ hc0, map_one, one_mul]
            rwa [hcancel] at hmul
          cases d with
          | zero =>
            rw [pow_zero] at hpow_mem
            exact 𝔮.isPrime.ne_top
              (Ideal.eq_top_of_isUnit_mem 𝔮.asHomogeneousIdeal.toIdeal hpow_mem isUnit_one)
          | succ d' =>
            exact hX0_not (𝔮.isPrime.mem_of_pow_mem (d' + 1) hpow_mem)
      · intro R hR
        rw [RingHom.mem_ker] at hR
        have hmem := hI₁_le (hDiff_ρ₀ R)
        rwa [hR, sub_zero] at hmem
    let p_proj : ProjectiveSpectrum 𝒜_M := p
    let pstar_proj : ProjectiveSpectrum 𝒜_M := p_star
    have hp_ker : p_proj.asHomogeneousIdeal.toIdeal = RingHom.ker ρ₀ :=
      hEqKer p_proj
        ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜_M (MvPolynomial.X 0) p_proj).mp hp_X0)
        (fun i => (not_iff_comm.mp
          (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_M (MvPolynomial.X i.succ) p_proj)).mp (hAll i))
    have hpstar_ker : pstar_proj.asHomogeneousIdeal.toIdeal = RingHom.ker ρ₀ :=
      hEqKer pstar_proj
        ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜_M (MvPolynomial.X 0) pstar_proj).mp hp0)
        (fun i => (not_iff_comm.mp
          (AlgebraicGeometry.Proj.mem_basicOpen 𝒜_M (MvPolynomial.X i.succ) pstar_proj)).mp (hpi i))
    have heq_pt : p = p_star :=
      ProjectiveSpectrum.ext (HomogeneousIdeal.toIdeal_injective (hp_ker.trans hpstar_ker.symm))
    exact hp_ne heq_pt

  
  let ι₁ : Quiver.Hom V (weilProjectiveSpaceOver k M) := ι₀ ≫ τ
  have hCl₁ : AlgebraicGeometry.IsClosedImmersion ι₁.left := by
    haveI : AlgebraicGeometry.IsClosedImmersion ι₀.left := hCl₀
    haveI : CategoryTheory.IsIso τ.left := hIso_τ_left
    change AlgebraicGeometry.IsClosedImmersion (ι₀.left ≫ τ.left)
    infer_instance
  have hp1_0 : ι₁.left.base x₀ ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0) := by
    change p₀ ∈ (TopologicalSpace.Opens.map τ_left.base).obj
      (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0))
    rw [hPre_τ (MvPolynomial.X 0), hf0]
    exact hp₀_a₀
  have hp1_succ : ∀ i : Fin M,
      ι₁.left.base x₀ ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ) := by
    intro i hmem
    have hpre : p₀ ∈ (TopologicalSpace.Opens.map τ_left.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ)) := hmem
    rw [hPre_τ (MvPolynomial.X i.succ), hfi i] at hpre
    exact hp₀_not_Li i hpre
  exact ⟨ι₁, hCl₁, hp1_0, hp1_succ, hOriginCompl (ι₁.left.base x₀) hp1_0 hp1_succ⟩

theorem weil_proj_veronese_quadric_closedImmersion (k : Type u) [Field k]
    (M : ℕ) (hM : 1 ≤ M) :
    let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
    letI : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
    ∃ (N' : ℕ)
      (ν₂ : Quiver.Hom (weilProjectiveSpaceOver k M) (weilProjectiveSpaceOver k (N' + 1)))
      (diag_idx : Fin M → Fin (N' + 1)),
      let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
      letI : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      AlgebraicGeometry.IsClosedImmersion ν₂.left ∧
      (∀ p : ↥(weilProjectiveSpaceOver k M).left,
        p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0) →
        (∀ i : Fin M, p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ)) →
        ν₂.left.base p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X 0) ∧
        (∀ β : Fin (N' + 1),
          ν₂.left.base p ∈ weilProjHyperplaneSet k (N' + 1) (MvPolynomial.X β.succ))) ∧
      (∀ (i : Fin M) (p : ↥(weilProjectiveSpaceOver k M).left),
        p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ) →
        ν₂.left.base p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X (diag_idx i).succ)) ∧
      (∀ (i : Fin M)
         (hXβ₀ : (MvPolynomial.X (diag_idx i).succ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
         (hpos : 0 < 1),
        let β₀ := diag_idx i
        let D_β₀ := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X β₀.succ)
        let ρ_i := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ) hXβ₀ hpos).hom ≫
          ν₂.left.app D_β₀).hom
        Function.Surjective
          (MvPolynomial.eval₂Hom
            (ρ_i.comp
              ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
                (Submonoid.powers (MvPolynomial.X β₀.succ))).comp (algebraMap k ↥(𝒜_N 0))))
            (fun m : Fin N' =>
              ρ_i (HomogeneousLocalization.mk
                ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
                  ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, ⟨1, pow_one _⟩⟩)))) :=
by
  classical
  let 𝒜_M := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) k
  let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra

  
  
  
  have h4 : 4 ≤ (M + 1) * (M + 1) := by nlinarith
  let N' : ℕ := (M + 1) * (M + 1) - 2
  have hL : N' + 1 + 1 = (M + 1) * (M + 1) := by omega
  let e_idx : Fin (M + 1) × Fin (M + 1) ≃ Fin (N' + 1 + 1) :=
    finProdFinEquiv.trans (finCongr hL.symm)
  have he00 : e_idx (0, 0) = 0 := by
    apply Fin.ext
    simp [e_idx, finProdFinEquiv]
  have he_symm0 : e_idx.symm 0 = (0, 0) :=
    e_idx.injective (by simp [he00])
  have h_ii_ne : ∀ i : Fin M, e_idx (i.succ, i.succ) ≠ 0 := by
    intro i h
    have hpair : (i.succ, i.succ) = (0, 0) :=
      e_idx.injective (h.trans he00.symm)
    exact Fin.succ_ne_zero i (Prod.mk.inj hpair).1
  let diag_idx : Fin M → Fin (N' + 1) :=
    fun i => (e_idx (i.succ, i.succ)).pred (h_ii_ne i)
  have hdiag : ∀ i : Fin M, (diag_idx i).succ = e_idx (i.succ, i.succ) :=
    fun i => Fin.succ_pred _ (h_ii_ne i)

  let 𝒜_N := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
  let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra

  
  
  
  let Q : Fin (N' + 1 + 1) → MvPolynomial (Fin (M + 1)) k :=
    fun α => MvPolynomial.X (e_idx.symm α).1 * MvPolynomial.X (e_idx.symm α).2
  have hQ_pair : ∀ u v : Fin (M + 1),
      Q (e_idx (u, v)) = MvPolynomial.X u * MvPolynomial.X v := by
    intro u v
    dsimp only [Q]
    rw [e_idx.symm_apply_apply]
  have hQ_hom : ∀ α : Fin (N' + 1 + 1), (Q α).IsHomogeneous 2 := by
    intro α
    simpa using (MvPolynomial.isHomogeneous_X k (e_idx.symm α).1).mul
      (MvPolynomial.isHomogeneous_X k (e_idx.symm α).2)
  have hQ : ∀ α : Fin (N' + 1 + 1), Q α ∈ 𝒜_M 2 :=
    fun α => (MvPolynomial.mem_homogeneousSubmodule 2 (Q α)).mpr (hQ_hom α)
  have hXM : ∀ a : Fin (M + 1), MvPolynomial.X a ∈ 𝒜_M 1 :=
    fun a => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k a)
  have hXN : ∀ α : Fin (N' + 1 + 1), MvPolynomial.X α ∈ 𝒜_N 1 :=
    fun α => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k α)

  let Φ_quad : MvPolynomial (Fin (N' + 1 + 1)) k →+* MvPolynomial (Fin (M + 1)) k :=
    MvPolynomial.eval₂Hom MvPolynomial.C Q
  have hΦ_hom : ∀ (d : ℕ) (G : MvPolynomial (Fin (N' + 1 + 1)) k),
      G ∈ 𝒜_N d → Φ_quad G ∈ 𝒜_M (2 * d) := by
    intro d G hG
    rw [MvPolynomial.mem_homogeneousSubmodule] at hG ⊢
    exact hG.eval₂ MvPolynomial.C Q (fun c => MvPolynomial.isHomogeneous_C _ c) hQ_hom

  let veroneseFun : ∀ {S : Submonoid (MvPolynomial (Fin (N' + 1 + 1)) k)}
      {T : Submonoid (MvPolynomial (Fin (M + 1)) k)}
      (_ : S ≤ Submonoid.comap Φ_quad T),
      HomogeneousLocalization 𝒜_N S → HomogeneousLocalization 𝒜_M T :=
    fun {_ _} hST x =>
      let nd := Classical.choose (HomogeneousLocalization.mk_surjective x)
      HomogeneousLocalization.mk
        ⟨2 * nd.deg, ⟨Φ_quad nd.num.1, hΦ_hom nd.deg nd.num.1 nd.num.2⟩,
          ⟨Φ_quad nd.den.1, hΦ_hom nd.deg nd.den.1 nd.den.2⟩, hST nd.den_mem⟩

  have hVeronese_val : ∀ {S : Submonoid (MvPolynomial (Fin (N' + 1 + 1)) k)}
      {T : Submonoid (MvPolynomial (Fin (M + 1)) k)}
      (hST : S ≤ Submonoid.comap Φ_quad T)
      (x : HomogeneousLocalization 𝒜_N S),
      (veroneseFun hST x).val =
        IsLocalization.map (Localization T) Φ_quad hST x.val := by
    intro S T hST x
    let nd := Classical.choose (HomogeneousLocalization.mk_surjective x)
    have hnd : HomogeneousLocalization.mk nd = x :=
      Classical.choose_spec (HomogeneousLocalization.mk_surjective x)
    change (HomogeneousLocalization.mk
        ⟨2 * nd.deg, ⟨Φ_quad nd.num.1, hΦ_hom nd.deg nd.num.1 nd.num.2⟩,
          ⟨Φ_quad nd.den.1, hΦ_hom nd.deg nd.den.1 nd.den.2⟩, hST nd.den_mem⟩).val =
      IsLocalization.map (Localization T) Φ_quad hST x.val
    rw [← hnd, HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk,
      Localization.mk_eq_mk', Localization.mk_eq_mk']
    exact (IsLocalization.map_mk' hST nd.num.1 ⟨nd.den.1, nd.den_mem⟩).symm

  let veroneseLocMap : ∀ {S : Submonoid (MvPolynomial (Fin (N' + 1 + 1)) k)}
      {T : Submonoid (MvPolynomial (Fin (M + 1)) k)}
      (_ : S ≤ Submonoid.comap Φ_quad T),
      HomogeneousLocalization 𝒜_N S →+* HomogeneousLocalization 𝒜_M T :=
    fun {_ _} hST =>
      { toFun := veroneseFun hST
        map_one' := by
          apply HomogeneousLocalization.val_injective
          rw [hVeronese_val, HomogeneousLocalization.val_one, map_one,
            HomogeneousLocalization.val_one]
        map_mul' := fun x y => by
          apply HomogeneousLocalization.val_injective
          rw [hVeronese_val, HomogeneousLocalization.val_mul, map_mul,
            ← hVeronese_val, ← hVeronese_val, HomogeneousLocalization.val_mul]
        map_zero' := by
          apply HomogeneousLocalization.val_injective
          rw [hVeronese_val, HomogeneousLocalization.val_zero, map_zero,
            HomogeneousLocalization.val_zero]
        map_add' := fun x y => by
          apply HomogeneousLocalization.val_injective
          rw [hVeronese_val, HomogeneousLocalization.val_add, map_add,
            ← hVeronese_val, ← hVeronese_val, HomogeneousLocalization.val_add] }

  have hVeronese_mk_val : ∀ {S : Submonoid (MvPolynomial (Fin (N' + 1 + 1)) k)}
      {T : Submonoid (MvPolynomial (Fin (M + 1)) k)}
      (hST : S ≤ Submonoid.comap Φ_quad T)
      (nd : HomogeneousLocalization.NumDenSameDeg 𝒜_N S),
      (veroneseLocMap hST (HomogeneousLocalization.mk nd)).val =
        Localization.mk (Φ_quad nd.num.1) ⟨Φ_quad nd.den.1, hST nd.den_mem⟩ := by
    intro S T hST nd
    change (veroneseFun hST (HomogeneousLocalization.mk nd)).val = _
    rw [hVeronese_val hST, HomogeneousLocalization.val_mk,
      Localization.mk_eq_mk', Localization.mk_eq_mk']
    exact IsLocalization.map_mk' hST nd.num.1 ⟨nd.den.1, nd.den_mem⟩

  have hsub_chart : ∀ α : Fin (N' + 1 + 1),
      Submonoid.powers (MvPolynomial.X α : MvPolynomial (Fin (N' + 1 + 1)) k) ≤
        Submonoid.comap Φ_quad (Submonoid.powers (Q α)) := by
    intro α
    apply Submonoid.powers_le.mpr
    change Φ_quad (MvPolynomial.X α) ∈ Submonoid.powers (Q α)
    simp [Φ_quad, Submonoid.mem_powers]

  let ψ : ∀ α : Fin (N' + 1 + 1),
      HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) →+*
        HomogeneousLocalization.Away 𝒜_M (Q α) :=
    fun α => veroneseLocMap (hsub_chart α)

  
  have hLiftMonomial : ∀ (r : ℕ) (s : Fin (M + 1) →₀ ℕ),
      (Finsupp.weight 1) s = 2 * r →
      ∃ G_s : MvPolynomial (Fin (N' + 1 + 1)) k,
        G_s.IsHomogeneous r ∧ Φ_quad G_s = MvPolynomial.monomial s (1 : k) := by
    let wt : (Fin (M + 1) →₀ ℕ) →+ ℕ := Finsupp.weight 1
    have hw_single : ∀ j : Fin (M + 1), wt (Finsupp.single j (1 : ℕ)) = 1 := by
      intro j
      simp [wt, Finsupp.weight_apply]
    intro r
    induction r with
    | zero =>
      intro s hs
      have hs0 : s = 0 := by
        ext j
        have hsum : (∑ i : Fin (M + 1), s i) = 0 := by
          simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using hs
        exact Finset.sum_eq_zero_iff.mp hsum j (Finset.mem_univ j)
      subst hs0
      refine ⟨1, MvPolynomial.isHomogeneous_one _ _, ?_⟩
      rw [map_one, MvPolynomial.monomial_zero', map_one]
    | succ r ih =>
      intro s hs
      have hs_wt : wt s = 2 * (r + 1) := hs
      have ⟨u, hu⟩ : ∃ u : Fin (M + 1), 1 ≤ s u := by
        by_contra! h0
        have hs_eq0 : s = 0 := Finsupp.ext (fun i => Nat.lt_one_iff.mp (h0 i))
        rw [hs_eq0, map_zero] at hs_wt
        omega
      let s₁ : Fin (M + 1) →₀ ℕ := s - Finsupp.single u 1
      have hs₁_add : s₁ + Finsupp.single u 1 = s :=
        tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr hu)
      have hws₁ : wt s₁ = 2 * r + 1 := by
        have h := congrArg wt hs₁_add
        rw [map_add, hw_single u, hs_wt] at h
        omega
      have ⟨v, hv⟩ : ∃ v : Fin (M + 1), 1 ≤ s₁ v := by
        by_contra! h0
        have hs₁_eq0 : s₁ = 0 := Finsupp.ext (fun i => Nat.lt_one_iff.mp (h0 i))
        rw [hs₁_eq0, map_zero] at hws₁
        omega
      let s₂ : Fin (M + 1) →₀ ℕ := s₁ - Finsupp.single v 1
      have hs₂_add : s₂ + Finsupp.single v 1 = s₁ :=
        tsub_add_cancel_of_le (Finsupp.single_le_iff.mpr hv)
      have hws₂ : wt s₂ = 2 * r := by
        have h := congrArg wt hs₂_add
        rw [map_add, hw_single v, hws₁] at h
        omega
      obtain ⟨G₂, hG₂_hom, hG₂_eq⟩ := ih s₂ hws₂
      refine ⟨G₂ * MvPolynomial.X (e_idx (u, v)),
        hG₂_hom.mul (MvPolynomial.isHomogeneous_X k (e_idx (u, v))), ?_⟩
      have hX_mon : ∀ j : Fin (M + 1),
          (MvPolynomial.X j : MvPolynomial (Fin (M + 1)) k) =
            MvPolynomial.monomial (Finsupp.single j 1) (1 : k) := fun _ => rfl
      have hΦ_uv : Φ_quad (MvPolynomial.X (e_idx (u, v))) =
          MvPolynomial.X v * MvPolynomial.X u := by
        dsimp only [Φ_quad]
        rw [MvPolynomial.eval₂Hom_X', hQ_pair, mul_comm]
      rw [map_mul, hG₂_eq, hΦ_uv, hX_mon v, hX_mon u, ← mul_assoc,
        MvPolynomial.monomial_mul_monomial, one_mul,
        MvPolynomial.monomial_mul_monomial, one_mul, hs₂_add, hs₁_add]

  have hSurj_ψ : ∀ α : Fin (N' + 1 + 1), Function.Surjective (ψ α) := by
    intro α z
    obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
    obtain ⟨r, hr⟩ := nd.den_mem
    have hr' : Q α ^ r = nd.den.1 := hr
    have hQpow_ne : Q α ^ r ≠ 0 := by
      intro h0
      have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) h0
      simp [Q] at hev
    have hex_d : ∃ d₀, (Q α ^ r).coeff d₀ ≠ 0 := by
      by_contra h_all
      push Not at h_all
      exact hQpow_ne (MvPolynomial.ext_iff.mpr fun d => by simp [h_all d])
    obtain ⟨d₀, hd₀⟩ := hex_d
    have hden_homog : (Q α ^ r).IsHomogeneous nd.deg := by
      rw [hr']
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
    have hQ_pow_homog : (Q α ^ r).IsHomogeneous (2 * r) := (hQ_hom α).pow r
    have hdeg_eq : nd.deg = 2 * r := (hden_homog hd₀).symm.trans (hQ_pow_homog hd₀)
    have hnum_homog : nd.num.1.IsHomogeneous (2 * r) := by
      rw [← hdeg_eq]
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
    have h_lift_term : ∀ s ∈ nd.num.1.support,
        ∃ G_s : MvPolynomial (Fin (N' + 1 + 1)) k,
          G_s.IsHomogeneous r ∧ Φ_quad G_s = MvPolynomial.monomial s (1 : k) := by
      intro s hs
      exact hLiftMonomial r s (hnum_homog (MvPolynomial.mem_support_iff.mp hs))
    let G_fun : (Fin (M + 1) →₀ ℕ) → MvPolynomial (Fin (N' + 1 + 1)) k :=
      fun s => if hs : s ∈ nd.num.1.support then Classical.choose (h_lift_term s hs) else 0
    let G : MvPolynomial (Fin (N' + 1 + 1)) k :=
      ∑ s ∈ nd.num.1.support, MvPolynomial.C (nd.num.1.coeff s) * G_fun s
    have hG_mem : G ∈ 𝒜_N r := by
      apply Submodule.sum_mem
      intro s hs
      rw [MvPolynomial.mem_homogeneousSubmodule]
      have hGs : (G_fun s).IsHomogeneous r := by
        simp only [G_fun, hs, ↓reduceDIte]
        exact (Classical.choose_spec (h_lift_term s hs)).1
      simpa using (MvPolynomial.isHomogeneous_C _ (nd.num.1.coeff s)).mul hGs
    have hΦ_G : Φ_quad G = nd.num.1 := by
      dsimp only [G]
      rw [map_sum]
      conv_rhs => rw [MvPolynomial.as_sum nd.num.1]
      refine Finset.sum_congr rfl fun s hs => ?_
      have hGs_eq : Φ_quad (G_fun s) = MvPolynomial.monomial s (1 : k) := by
        simp only [G_fun, hs, ↓reduceDIte]
        exact (Classical.choose_spec (h_lift_term s hs)).2
      have hC : Φ_quad (MvPolynomial.C (nd.num.1.coeff s)) =
          MvPolynomial.C (nd.num.1.coeff s) :=
        MvPolynomial.eval₂Hom_C MvPolynomial.C Q (nd.num.1.coeff s)
      rw [map_mul, hC, hGs_eq, MvPolynomial.C_mul_monomial, mul_one]
    have hYpow_mem : (MvPolynomial.X α : MvPolynomial (Fin (N' + 1 + 1)) k) ^ r ∈ 𝒜_N r :=
      (MvPolynomial.mem_homogeneousSubmodule r _).mpr (MvPolynomial.isHomogeneous_X_pow α r)
    let w : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α) :=
      HomogeneousLocalization.mk ⟨r, ⟨G, hG_mem⟩, ⟨MvPolynomial.X α ^ r, hYpow_mem⟩,
        pow_mem (Submonoid.mem_powers (MvPolynomial.X α)) r⟩
    refine ⟨w, ?_⟩
    apply HomogeneousLocalization.val_injective
    rw [hVeronese_mk_val (hsub_chart α), HomogeneousLocalization.val_mk, hΦ_G]
    congr 1
    apply Subtype.ext
    change Φ_quad (MvPolynomial.X α ^ r) = nd.den.1
    rw [map_pow]
    have hΦ_X : Φ_quad (MvPolynomial.X α) = Q α := MvPolynomial.eval₂Hom_X' MvPolynomial.C Q α
    rw [hΦ_X, hr']

  
  have hZero_ψ : ∀ (α : Fin (N' + 1 + 1)) (c : k),
      ψ α (HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_N 0) c)) =
        HomogeneousLocalization.fromZeroRingHom 𝒜_M
          (Submonoid.powers (Q α)) (algebraMap k ↥(𝒜_M 0) c) := by
    intro α c
    apply HomogeneousLocalization.val_injective
    change (veroneseFun (hsub_chart α)
        (HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_N 0) c))).val = _
    rw [hVeronese_val]
    have hvN : (HomogeneousLocalization.fromZeroRingHom 𝒜_N
        (Submonoid.powers (MvPolynomial.X α)) (algebraMap k ↥(𝒜_N 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := rfl
    have hvM : (HomogeneousLocalization.fromZeroRingHom 𝒜_M
        (Submonoid.powers (Q α)) (algebraMap k ↥(𝒜_M 0) c)).val =
        Localization.mk (MvPolynomial.C c) 1 := rfl
    rw [hvN, hvM, Localization.mk_eq_mk', IsLocalization.map_mk' (hsub_chart α),
      ← Localization.mk_eq_mk']
    congr 1
    · exact MvPolynomial.eval₂Hom_C MvPolynomial.C Q c
    · apply Subtype.ext
      exact map_one Φ_quad

  
  have hOverlap_ψ : ∀ (α α' : Fin (N' + 1 + 1)),
      ∃ ψ_ov : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α * MvPolynomial.X α') →+*
          HomogeneousLocalization.Away 𝒜_M (Q α * Q α'),
        ψ_ov.comp (HomogeneousLocalization.awayMap 𝒜_N (hXN α') rfl) =
          (HomogeneousLocalization.awayMap 𝒜_M (hQ α') rfl).comp (ψ α) ∧
        ψ_ov.comp (HomogeneousLocalization.awayMap 𝒜_N (hXN α)
            (mul_comm (MvPolynomial.X α) (MvPolynomial.X α'))) =
          (HomogeneousLocalization.awayMap 𝒜_M (hQ α) (mul_comm (Q α) (Q α'))).comp (ψ α') := by
    intro α α'
    have hsub_ov :
        Submonoid.powers (MvPolynomial.X α * MvPolynomial.X α' :
            MvPolynomial (Fin (N' + 1 + 1)) k) ≤
          Submonoid.comap Φ_quad (Submonoid.powers (Q α * Q α')) := by
      apply Submonoid.powers_le.mpr
      change Φ_quad (MvPolynomial.X α * MvPolynomial.X α') ∈ Submonoid.powers (Q α * Q α')
      rw [map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      exact Submonoid.mem_powers _
    let ψ_ov := veroneseLocMap hsub_ov
    have hSide : ∀ (β γ : Fin (N' + 1 + 1))
        (hxN : MvPolynomial.X α * MvPolynomial.X α' = MvPolynomial.X β * MvPolynomial.X γ)
        (hxM : Q α * Q α' = Q β * Q γ),
        ψ_ov.comp (HomogeneousLocalization.awayMap 𝒜_N (hXN γ) hxN) =
          (HomogeneousLocalization.awayMap 𝒜_M (hQ γ) hxM).comp (ψ β) := by
      intro β γ hxN hxM
      apply RingHom.ext
      intro z
      obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
      obtain ⟨n, hn⟩ := nd.den_mem
      have hn' : MvPolynomial.X β ^ n = nd.den.1 := hn
      have hdenN : MvPolynomial.X β ^ n ∈ 𝒜_N nd.deg := hn' ▸ nd.den.2
      let ndN : HomogeneousLocalization.NumDenSameDeg 𝒜_N (Submonoid.powers (MvPolynomial.X β)) :=
        ⟨nd.deg, nd.num, ⟨MvPolynomial.X β ^ n, hdenN⟩,
          pow_mem (Submonoid.mem_powers (MvPolynomial.X β)) n⟩
      have hnd_eq : HomogeneousLocalization.mk nd = HomogeneousLocalization.mk ndN := by
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk]
        congr 1
        exact Subtype.ext hn'.symm
      have hdenM : Q β ^ n ∈ 𝒜_M (2 * nd.deg) := by
        have h1 : Φ_quad (MvPolynomial.X β ^ n) ∈ 𝒜_M (2 * nd.deg) := hΦ_hom nd.deg _ hdenN
        have h2 : Φ_quad (MvPolynomial.X β ^ n) = Q β ^ n := by
          rw [map_pow, MvPolynomial.eval₂Hom_X']
        rwa [← h2]
      let ndM : HomogeneousLocalization.NumDenSameDeg 𝒜_M (Submonoid.powers (Q β)) :=
        ⟨2 * nd.deg, ⟨Φ_quad nd.num.1, hΦ_hom nd.deg nd.num.1 nd.num.2⟩,
          ⟨Q β ^ n, hdenM⟩, pow_mem (Submonoid.mem_powers (Q β)) n⟩
      have hψ_eq : ψ β (HomogeneousLocalization.mk nd) = HomogeneousLocalization.mk ndM := by
        apply HomogeneousLocalization.val_injective
        rw [hVeronese_mk_val (hsub_chart β), HomogeneousLocalization.val_mk]
        congr 1
        apply Subtype.ext
        change Φ_quad nd.den.1 = Q β ^ n
        rw [← hn', map_pow, MvPolynomial.eval₂Hom_X']
      apply HomogeneousLocalization.val_injective
      simp only [RingHom.comp_apply]
      rw [hψ_eq, HomogeneousLocalization.val_awayMap_mk, hnd_eq]
      change (veroneseFun hsub_ov
          ((HomogeneousLocalization.awayMap 𝒜_N (hXN γ) hxN)
            (HomogeneousLocalization.mk ndN))).val = _
      rw [hVeronese_val hsub_ov, HomogeneousLocalization.val_awayMap_mk,
        Localization.mk_eq_mk', IsLocalization.map_mk' hsub_ov, ← Localization.mk_eq_mk']
      congr 1
      · change Φ_quad (nd.num.1 * MvPolynomial.X γ ^ n) = Φ_quad nd.num.1 * Q γ ^ n
        rw [map_mul, map_pow, MvPolynomial.eval₂Hom_X']
      · apply Subtype.ext
        change Φ_quad ((MvPolynomial.X α * MvPolynomial.X α') ^ n) = (Q α * Q α') ^ n
        rw [map_pow, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
    exact ⟨ψ_ov, hSide α α' rfl rfl,
      hSide α' α (mul_comm _ _) (mul_comm _ _)⟩

  
  
  
  let P_M : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_M
  let P_N : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Proj 𝒜_N
  let W : Fin (N' + 1 + 1) → P_M.Opens :=
    fun α => AlgebraicGeometry.Proj.basicOpen 𝒜_M (Q α)
  let D : Fin (N' + 1 + 1) → P_N.Opens :=
    fun α => AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X α)

  have hStdCover : ∀ (L₀ : ℕ),
      let 𝒜₀ := MvPolynomial.homogeneousSubmodule (Fin (L₀ + 1)) k
      letI : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
      ∀ y : ↥(AlgebraicGeometry.Proj 𝒜₀),
        ∃ a : Fin (L₀ + 1), y ∈ AlgebraicGeometry.Proj.basicOpen 𝒜₀ (MvPolynomial.X a) := by
    intro L₀ 𝒜₀ y
    let _ : GradedAlgebra 𝒜₀ := MvPolynomial.gradedAlgebra
    by_contra! hAll
    apply y.not_irrelevant_le
    rw [HomogeneousIdeal.irrelevant_le]
    intro d hd p hp
    have hp_hom : p.IsHomogeneous d := hp
    rw [MvPolynomial.as_sum p]
    apply y.asHomogeneousIdeal.toIdeal.sum_mem
    intro s hs
    have hs_deg : (∑ b : Fin (L₀ + 1), s b) = d := by
      simpa [Finsupp.weight_apply, Finsupp.sum_fintype] using
        hp_hom (MvPolynomial.mem_support_iff.mp hs)
    have ⟨b₀, hb₀⟩ : ∃ b₀ : Fin (L₀ + 1), 1 ≤ s b₀ := by
      by_contra! hZero
      have hsum0 : (∑ b : Fin (L₀ + 1), s b) = 0 :=
        Finset.sum_eq_zero (fun b _ => Nat.lt_one_iff.mp (hZero b))
      omega
    have hXb₀ : (MvPolynomial.X b₀ : MvPolynomial (Fin (L₀ + 1)) k) ∈
        y.asHomogeneousIdeal.toIdeal := by
      have hnot := hAll b₀
      have hm := @AlgebraicGeometry.Proj.mem_basicOpen _ _ _ _ _ 𝒜₀ _
        (MvPolynomial.X b₀) y
      exact not_not.mp (mt hm.mpr hnot)
    rw [MvPolynomial.monomial_eq, Finsupp.prod_of_support_subset _ (Finset.subset_univ _)
      _ (fun _ _ => pow_zero _)]
    apply y.asHomogeneousIdeal.toIdeal.mul_mem_left
    obtain ⟨r, hr⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s b₀ ≠ 0)
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ b₀), hr, pow_succ']
    exact y.asHomogeneousIdeal.toIdeal.mul_mem_right _
      (y.asHomogeneousIdeal.toIdeal.mul_mem_right _ hXb₀)

  have hCov_W_pt : ∀ p : ↥P_M, ∃ α : Fin (N' + 1 + 1), p ∈ W α := by
    intro p
    obtain ⟨a, ha⟩ := hStdCover M p
    refine ⟨e_idx (a, a), ?_⟩
    change p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (Q (e_idx (a, a)))
    rw [hQ_pair a a, AlgebraicGeometry.Proj.basicOpen_mul]
    exact ⟨ha, ha⟩

  have hCov_W : (⨆ α : Fin (N' + 1 + 1), W α) = ⊤ := by
    ext p
    exact ⟨fun _ => trivial, fun _ => TopologicalSpace.Opens.mem_iSup.mpr (hCov_W_pt p)⟩

  have hCov_D : (⨆ α : Fin (N' + 1 + 1), D α) = ⊤ := by
    ext y
    exact ⟨fun _ => trivial, fun _ => TopologicalSpace.Opens.mem_iSup.mpr (hStdCover (N' + 1) y)⟩

  let f_loc : ∀ α : Fin (N' + 1 + 1), (W α).toScheme ⟶ P_N :=
    fun α =>
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (Q α) (hQ α) zero_lt_two).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ α)) ≫
      AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hXN α) zero_lt_one

  have hOverlap_W : ∀ α α' : Fin (N' + 1 + 1),
      P_M.homOfLE (inf_le_left : W α ⊓ W α' ≤ W α) ≫ f_loc α =
      P_M.homOfLE (inf_le_right : W α ⊓ W α' ≤ W α') ≫ f_loc α' := by
    intro α α'
    obtain ⟨ψ_ov, hov_L, hov_R⟩ := hOverlap_ψ α α'
    let Q_ov := Q α * Q α'
    let Y_ov : MvPolynomial (Fin (N' + 1 + 1)) k := MvPolynomial.X α * MvPolynomial.X α'
    have hY_ov : Y_ov ∈ 𝒜_N (1 + 1) := SetLike.mul_mem_graded (hXN α) (hXN α')
    let W_ov : P_M.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_M Q_ov
    have hW_eq : W_ov = W α ⊓ W α' := AlgebraicGeometry.Proj.basicOpen_mul 𝒜_M (Q α) (Q α')
    have hle_L : W_ov ≤ W α := hW_eq.le.trans inf_le_left
    have hle_R : W_ov ≤ W α' := hW_eq.le.trans inf_le_right
    have hFactor : ∀ (β γ : Fin (N' + 1 + 1))
        (hxM : Q_ov = Q β * Q γ)
        (hxN : Y_ov = MvPolynomial.X β * MvPolynomial.X γ)
        (hle : W_ov ≤ W β)
        (hring : ψ_ov.comp (HomogeneousLocalization.awayMap 𝒜_N (hXN γ) hxN) =
          (HomogeneousLocalization.awayMap 𝒜_M (hQ γ) hxM).comp (ψ β)),
        P_M.homOfLE hle ≫ f_loc β =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M Q_ov ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_ov) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_N Y_ov hY_ov zero_lt_two := by
      intro β γ hxM hxN hle hring
      have h_toSpec : P_M.homOfLE hle ≫ AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M (Q β) =
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M Q_ov ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_M (hQ γ) hxM)) :=
        (AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_M (hQ γ) hxM).symm
      have h_awayι :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_N (hXN γ) hxN)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X β) (hXN β) zero_lt_one =
          AlgebraicGeometry.Proj.awayι 𝒜_N Y_ov hY_ov zero_lt_two :=
        AlgebraicGeometry.Proj.SpecMap_awayMap_awayι 𝒜_N (hXN β) zero_lt_one (hXN γ) hxN
      dsimp only [f_loc]
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom,
        ← CategoryTheory.Category.assoc (P_M.homOfLE hle), h_toSpec,
        CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← hring,
        CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc, h_awayι]
    have hW_ov_eq : P_M.homOfLE hle_L ≫ f_loc α = P_M.homOfLE hle_R ≫ f_loc α' :=
      (hFactor α α' rfl rfl hle_L hov_L).trans
        (hFactor α' α (mul_comm _ _) (mul_comm _ _) hle_R hov_R).symm
    have hiso_L : (P_M.isoOfEq hW_eq).hom ≫ P_M.homOfLE inf_le_left = P_M.homOfLE hle_L := by
      rw [← CategoryTheory.cancel_mono (W α).ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.isoOfEq_hom_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι]
    have hiso_R : (P_M.isoOfEq hW_eq).hom ≫ P_M.homOfLE inf_le_right = P_M.homOfLE hle_R := by
      rw [← CategoryTheory.cancel_mono (W α').ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.isoOfEq_hom_ι,
        AlgebraicGeometry.Scheme.homOfLE_ι]
    rw [← CategoryTheory.cancel_epi (P_M.isoOfEq hW_eq).hom]
    calc (P_M.isoOfEq hW_eq).hom ≫ P_M.homOfLE inf_le_left ≫ f_loc α
        = P_M.homOfLE hle_L ≫ f_loc α := by rw [← CategoryTheory.Category.assoc, hiso_L]
      _ = P_M.homOfLE hle_R ≫ f_loc α' := hW_ov_eq
      _ = (P_M.isoOfEq hW_eq).hom ≫ P_M.homOfLE inf_le_right ≫ f_loc α' := by
            symm
            rw [← CategoryTheory.Category.assoc, hiso_R]

  let 𝒰 : P_M.OpenCover :=
    P_M.openCoverOfIsOpenCover W (TopologicalSpace.IsOpenCover.mk hCov_W)

  have hGlue : ∀ α α' : 𝒰.I₀,
      CategoryTheory.Limits.pullback.fst (𝒰.f α) (𝒰.f α') ≫ f_loc α =
      CategoryTheory.Limits.pullback.snd (𝒰.f α) (𝒰.f α') ≫ f_loc α' := by
    intro (α : Fin (N' + 1 + 1)) (α' : Fin (N' + 1 + 1))
    let fst := CategoryTheory.Limits.pullback.fst (W α).ι (W α').ι
    let snd := CategoryTheory.Limits.pullback.snd (W α).ι (W α').ι
    have hcond : fst ≫ (W α).ι = snd ≫ (W α').ι := CategoryTheory.Limits.pullback.condition
    have hrange : Set.range (fst ≫ (W α).ι).base ⊆ Set.range (W α ⊓ W α').ι.base := by
      rw [(W α ⊓ W α').range_ι]
      rintro _ ⟨z, rfl⟩
      refine ⟨?_, ?_⟩
      · have h1 : (W α).ι.base (fst.base z) = (fst.base z).1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply (W α) (fst.base z)
        change (W α).ι.base (fst.base z) ∈ W α
        rw [h1]
        exact (fst.base z).2
      · rw [hcond]
        have h2 : (W α').ι.base (snd.base z) = (snd.base z).1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply (W α') (snd.base z)
        change (W α').ι.base (snd.base z) ∈ W α'
        rw [h2]
        exact (snd.base z).2
    let p_inf : CategoryTheory.Limits.pullback (W α).ι (W α').ι ⟶ (W α ⊓ W α').toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (W α ⊓ W α').ι (fst ≫ (W α).ι) hrange
    have hp_fac : p_inf ≫ (W α ⊓ W α').ι = fst ≫ (W α).ι :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (W α ⊓ W α').ι (fst ≫ (W α).ι) hrange
    have hp_fst : fst = p_inf ≫ P_M.homOfLE (inf_le_left : W α ⊓ W α' ≤ W α) := by
      rw [← CategoryTheory.cancel_mono (W α).ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac]
    have hp_snd : snd = p_inf ≫ P_M.homOfLE (inf_le_right : W α ⊓ W α' ≤ W α') := by
      rw [← CategoryTheory.cancel_mono (W α').ι, CategoryTheory.Category.assoc,
        AlgebraicGeometry.Scheme.homOfLE_ι, hp_fac, hcond]
    change fst ≫ f_loc α = snd ≫ f_loc α'
    rw [hp_fst, hp_snd, CategoryTheory.Category.assoc, hOverlap_W α α',
      CategoryTheory.Category.assoc]

  let ν_left : P_M ⟶ P_N := 𝒰.glueMorphisms f_loc hGlue
  have hChart : ∀ α : Fin (N' + 1 + 1), (W α).ι ≫ ν_left = f_loc α :=
    fun α => 𝒰.ι_glueMorphisms f_loc hGlue α

  have hν_w : ν_left ≫ (weilProjectiveSpaceOver k (N' + 1)).hom =
      (weilProjectiveSpaceOver k M).hom := by
    let hom_N : P_N ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜_N ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_N 0)))
    let hom_M : P_M ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Proj.toSpecZero 𝒜_M ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜_M 0)))
    change ν_left ≫ hom_N = hom_M
    apply 𝒰.hom_ext
    intro (α : Fin (N' + 1 + 1))
    change (W α).ι ≫ ν_left ≫ hom_N = (W α).ι ≫ hom_M
    rw [← CategoryTheory.Category.assoc, hChart α]
    let z_N := HomogeneousLocalization.fromZeroRingHom 𝒜_N (Submonoid.powers (MvPolynomial.X α))
    let z_M := HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (Q α))
    have hZero_comp : ((ψ α).comp z_N).comp (algebraMap k ↥(𝒜_N 0)) =
        z_M.comp (algebraMap k ↥(𝒜_M 0)) := RingHom.ext (hZero_ψ α)
    have hW_ι : (W α).ι =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (Q α) (hQ α) zero_lt_two).hom ≫
        AlgebraicGeometry.Proj.awayι 𝒜_M (Q α) (hQ α) zero_lt_two := by
      dsimp only [W]
      rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (Q α) (hQ α) zero_lt_two,
        CategoryTheory.Iso.hom_inv_id_assoc]
    have h_away_N :
        AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hXN α) zero_lt_one ≫ hom_N =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_N.comp (algebraMap k ↥(𝒜_N 0)))) := by
      dsimp only [hom_N]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_N (MvPolynomial.X α) (hXN α) zero_lt_one,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_away_M :
        AlgebraicGeometry.Proj.awayι 𝒜_M (Q α) (hQ α) zero_lt_two ≫ hom_M =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (z_M.comp (algebraMap k ↥(𝒜_M 0)))) := by
      dsimp only [hom_M]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_toSpecZero 𝒜_M (Q α) (hQ α) zero_lt_two,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    dsimp only [f_loc]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_away_N,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← RingHom.comp_assoc, hZero_comp, ← h_away_M]
    conv_rhs => rw [hW_ι, CategoryTheory.Category.assoc]

  let ν₂ : Quiver.Hom (weilProjectiveSpaceOver k M) (weilProjectiveSpaceOver k (N' + 1)) :=
    CategoryTheory.Over.homMk ν_left hν_w

  
  have hPre : ∀ β : Fin (N' + 1 + 1), ν_left ⁻¹ᵁ D β = W β := by
    intro β
    ext p
    obtain ⟨α, hpα⟩ := hCov_W_pt p
    let u : ↥(W α).toScheme := ⟨p, hpα⟩
    have hu_val : (W α).ι.base u = p := AlgebraicGeometry.Scheme.Opens.ι_apply (W α) u
    have hElem_sq : (ψ α (HomogeneousLocalization.Away.isLocalizationElem (hXN α) (hXN β))) ^ 2 =
        HomogeneousLocalization.Away.isLocalizationElem (hQ α) (hQ β) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_pow]
      change (veroneseFun (hsub_chart α)
          (HomogeneousLocalization.Away.isLocalizationElem (hXN α) (hXN β))).val ^ 2 = _
      rw [hVeronese_val]
      dsimp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.mk]
      rw [HomogeneousLocalization.val_mk, HomogeneousLocalization.val_mk,
        Localization.mk_eq_mk', IsLocalization.map_mk' (hsub_chart α),
        ← Localization.mk_eq_mk', Localization.mk_pow]
      have hnum : (Φ_quad (MvPolynomial.X β ^ 1)) ^ 2 = Q β ^ 2 := by
        rw [pow_one, MvPolynomial.eval₂Hom_X']
      rw [hnum]
      congr 1
      apply Subtype.ext
      change (Φ_quad (MvPolynomial.X α ^ 1)) ^ 2 = Q α ^ 2
      rw [pow_one, MvPolynomial.eval₂Hom_X']
    have hBasic_eq :
        PrimeSpectrum.basicOpen
          (ψ α (HomogeneousLocalization.Away.isLocalizationElem (hXN α) (hXN β))) =
        PrimeSpectrum.basicOpen
          (HomogeneousLocalization.Away.isLocalizationElem (hQ α) (hQ β)) := by
      rw [← hElem_sq, PrimeSpectrum.basicOpen_pow _ 2 zero_lt_two]
    have hLoc_pre :
        (TopologicalSpace.Opens.map (f_loc α).base).obj (D β) =
        (TopologicalSpace.Opens.map (W α).ι.base).obj (W β) := by
      let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
      let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      have hW_ι : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (Q α) (hQ α) zero_lt_two).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_M (Q α) (hQ α) zero_lt_two = (W α).ι := by
        dsimp only [W]
        rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_M (Q α) (hQ α) zero_lt_two,
          CategoryTheory.Iso.hom_inv_id_assoc]
      have h1 := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_N (hXN α) zero_lt_one
        (hXN β) zero_lt_one
      have h2 : (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ α))).base).obj
          (PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hXN α) (hXN β))) =
        PrimeSpectrum.basicOpen (HomogeneousLocalization.Away.isLocalizationElem (hQ α) (hQ β)) := by
        rw [AlgebraicGeometry.SpecMap_preimage_basicOpen]
        exact hBasic_eq
      have h3 := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜_M (hQ α) zero_lt_two
        (hQ β) zero_lt_two
      change (TopologicalSpace.Opens.map
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (Q α) (hQ α) zero_lt_two).hom.base).obj
        ((TopologicalSpace.Opens.map
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ α))).base).obj
          ((TopologicalSpace.Opens.map
            (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α) (hXN α) zero_lt_one).base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X β)))) = _
      rw [h1, h2, ← h3]
      change (TopologicalSpace.Opens.map
        ((AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (Q α) (hQ α) zero_lt_two).hom ≫
          AlgebraicGeometry.Proj.awayι 𝒜_M (Q α) (hQ α) zero_lt_two).base).obj (W β) = _
      rw [hW_ι]
    have h_iff := SetLike.ext_iff.mp hLoc_pre u
    change ν_left.base p ∈ D β ↔ p ∈ W β
    rw [← hu_val]
    change ((W α).ι ≫ ν_left).base u ∈ D β ↔ (W α).ι.base u ∈ W β
    rw [hChart α]
    exact h_iff

  
  have hC1 : AlgebraicGeometry.IsClosedImmersion ν₂.left := by
    change AlgebraicGeometry.IsClosedImmersion ν_left
    rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := @AlgebraicGeometry.IsClosedImmersion) D hCov_D]
    intro α
    let g_α : (W α).toScheme ⟶ (D α).toScheme :=
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (Q α) (hQ α) zero_lt_two).hom ≫
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ α)) ≫
      (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α) (hXN α) zero_lt_one).inv
    have hRestr_eq : (ν_left ∣_ D α) = (P_M.isoOfEq (hPre α)).hom ≫ g_α := by
      rw [← CategoryTheory.cancel_mono (D α).ι, AlgebraicGeometry.morphismRestrict_ι]
      dsimp only [g_α]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
        CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N (MvPolynomial.X α) (hXN α) zero_lt_one]
      change (ν_left ⁻¹ᵁ D α).ι ≫ ν_left = (P_M.isoOfEq (hPre α)).hom ≫ f_loc α
      rw [← hChart α, ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
    rw [hRestr_eq]
    have : AlgebraicGeometry.IsClosedImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ α))) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (ψ α)) (hSurj_ψ α)
    dsimp only [g_α]
    infer_instance

  
  have hC2 : ∀ p : ↥(weilProjectiveSpaceOver k M).left,
      p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X 0) →
      (∀ i : Fin M, p ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ)) →
      ν₂.left.base p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X 0) ∧
      (∀ β : Fin (N' + 1),
        ν₂.left.base p ∈ weilProjHyperplaneSet k (N' + 1) (MvPolynomial.X β.succ)) := by
    intro p hp0 hp_succ
    let p' : ↥P_M := p
    refine ⟨?_, fun β => ?_⟩
    · change p' ∈ ν_left ⁻¹ᵁ D 0
      rw [hPre 0]
      change p' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (Q 0)
      have hQ0 : Q 0 = MvPolynomial.X 0 * MvPolynomial.X 0 := by
        dsimp only [Q]
        rw [he_symm0]
      rw [hQ0, AlgebraicGeometry.Proj.basicOpen_mul]
      exact ⟨hp0, hp0⟩
    · change p' ∉ ν_left ⁻¹ᵁ D β.succ
      rw [hPre β.succ]
      change p' ∉ AlgebraicGeometry.Proj.basicOpen 𝒜_M (Q β.succ)
      dsimp only [Q]
      rw [AlgebraicGeometry.Proj.basicOpen_mul]
      rintro ⟨hpa, hpb⟩
      let a := (e_idx.symm β.succ).1
      let b := (e_idx.symm β.succ).2
      have ha0 : a = 0 :=
        Fin.cases (motive := fun x => p' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X x) → x = 0)
          (fun _ => rfl) (fun i hi => False.elim (hp_succ i hi)) a hpa
      have hb0 : b = 0 :=
        Fin.cases (motive := fun x => p' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X x) → x = 0)
          (fun _ => rfl) (fun j hj => False.elim (hp_succ j hj)) b hpb
      have hpair : e_idx.symm β.succ = (0, 0) := Prod.ext ha0 hb0
      have hβ0 : β.succ = 0 := by
        rw [← e_idx.apply_symm_apply β.succ, hpair, he00]
      exact Fin.succ_ne_zero β hβ0

  
  have hC3 : ∀ (i : Fin M) (p : ↥(weilProjectiveSpaceOver k M).left),
      p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X i.succ) →
      ν₂.left.base p ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X (diag_idx i).succ) := by
    intro i p hp
    let p' : ↥P_M := p
    change p' ∈ ν_left ⁻¹ᵁ D (diag_idx i).succ
    rw [hPre (diag_idx i).succ]
    change p' ∈ AlgebraicGeometry.Proj.basicOpen 𝒜_M (Q (diag_idx i).succ)
    rw [hdiag i, hQ_pair i.succ i.succ, AlgebraicGeometry.Proj.basicOpen_mul]
    exact ⟨hp, hp⟩

  
  
  
  have hStdChartSurj : ∀ (a : Fin (M + 1)) (hXa : MvPolynomial.X a ∈ 𝒜_M 1),
      Function.Surjective
        (MvPolynomial.eval₂Hom
          ((HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap k ↥(𝒜_M 0)))
          (fun u : {b : Fin (M + 1) // b ≠ a} =>
            HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X u.1, MvPolynomial.isHomogeneous_X k u.1⟩,
                ⟨MvPolynomial.X a, hXa⟩, Submonoid.mem_powers (MvPolynomial.X a)⟩)) := by
    intro a hXa
    let Xa : MvPolynomial (Fin (M + 1)) k := MvPolynomial.X a
    let S : Submonoid (MvPolynomial (Fin (M + 1)) k) := Submonoid.powers Xa
    let τ := {b : Fin (M + 1) // b ≠ a}
    let Ra := HomogeneousLocalization.Away 𝒜_M Xa
    let ι_k : k →+* Ra :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜_M S).comp (algebraMap k ↥(𝒜_M 0))
    let u_gen : τ → Ra := fun u =>
      HomogeneousLocalization.mk
        ⟨1, ⟨MvPolynomial.X u.1, MvPolynomial.isHomogeneous_X k u.1⟩, ⟨Xa, hXa⟩,
          Submonoid.mem_powers Xa⟩
    let α_std : MvPolynomial τ k →+* Ra := MvPolynomial.eval₂Hom ι_k u_gen
    let dehom : MvPolynomial (Fin (M + 1)) k →+* MvPolynomial τ k :=
      MvPolynomial.eval₂Hom MvPolynomial.C (fun j => if h : j = a then 1 else MvPolynomial.X ⟨j, h⟩)
    let valHom : Ra →+* Localization S :=
      { toFun := HomogeneousLocalization.val
        map_one' := HomogeneousLocalization.val_one
        map_mul' := HomogeneousLocalization.val_mul
        map_zero' := HomogeneousLocalization.val_zero
        map_add' := HomogeneousLocalization.val_add }
    let φ : MvPolynomial (Fin (M + 1)) k →+* Localization S := valHom.comp (α_std.comp dehom)
    have hφ_C : ∀ c : k, φ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
      intro c
      change (α_std (dehom (MvPolynomial.C c))).val = Localization.mk (MvPolynomial.C c) 1
      rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
      rfl
    have hφ_X : ∀ j : Fin (M + 1),
        φ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) ⟨Xa, Submonoid.mem_powers Xa⟩ := by
      intro j
      change (α_std (dehom (MvPolynomial.X j))).val = _
      rw [MvPolynomial.eval₂Hom_X']
      by_cases hj : j = a
      · subst hj
        simp only [↓reduceDIte, map_one, HomogeneousLocalization.val_one]
        exact (Localization.mk_self ⟨Xa, Submonoid.mem_powers Xa⟩).symm
      · simp only [hj, ↓reduceDIte]
        change (α_std (MvPolynomial.X ⟨j, hj⟩)).val = _
        rw [MvPolynomial.eval₂Hom_X']
        exact HomogeneousLocalization.val_mk _
    have hφ_prod : ∀ (d : Fin (M + 1) →₀ ℕ) (s : Finset (Fin (M + 1))),
        φ (∏ j ∈ s, MvPolynomial.X j ^ d j) =
          Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
            ⟨Xa ^ (∑ j ∈ s, d j), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
      intro d s
      induction s using Finset.induction_on with
      | empty =>
        simp only [Finset.prod_empty, Finset.sum_empty, pow_zero, map_one]
        exact Localization.mk_one.symm
      | insert j s hjs ih =>
        rw [Finset.prod_insert hjs, Finset.sum_insert hjs, map_mul, map_pow, hφ_X j,
          Localization.mk_pow, ih, Localization.mk_mul]
        congr 1
        exact Subtype.ext (pow_add Xa (d j) (∑ i ∈ s, d i)).symm
    have hφ_monomial : ∀ (d : Fin (M + 1) →₀ ℕ) (c : k),
        φ (MvPolynomial.monomial d c) =
          Localization.mk (MvPolynomial.monomial d c)
            ⟨Xa ^ ((Finsupp.weight 1) d), pow_mem (Submonoid.mem_powers Xa) _⟩ := by
      intro d c
      rw [MvPolynomial.monomial_eq, map_mul, hφ_C]
      change Localization.mk (MvPolynomial.C c) 1 *
          φ (∏ j ∈ d.support, MvPolynomial.X j ^ d j) = _
      rw [hφ_prod d d.support, Localization.mk_mul]
      congr 1
      apply Subtype.ext
      change 1 * Xa ^ (∑ j ∈ d.support, d j) = Xa ^ ((Finsupp.weight 1) d)
      rw [one_mul]
      simp [Finsupp.weight_apply, Finsupp.sum]
    have h_sum_mk : ∀ (s : Finset (Fin (M + 1) →₀ ℕ))
        (g : (Fin (M + 1) →₀ ℕ) → MvPolynomial (Fin (M + 1)) k) (y : S),
        ∑ d ∈ s, Localization.mk (g d) y = Localization.mk (∑ d ∈ s, g d) y := by
      intro s g y
      induction s using Finset.induction_on with
      | empty => simp [Localization.mk_zero]
      | insert d s hds ih =>
        rw [Finset.sum_insert hds, Finset.sum_insert hds, ih, Localization.add_mk_self]
    have hφ_homog : ∀ (n : ℕ) (p : MvPolynomial (Fin (M + 1)) k), p.IsHomogeneous n →
        φ p = Localization.mk p ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩ := by
      intro n p hp
      conv_lhs => rw [MvPolynomial.as_sum p]
      rw [map_sum]
      have hterms : ∀ d ∈ p.support,
          φ (MvPolynomial.monomial d (p.coeff d)) =
            Localization.mk (MvPolynomial.monomial d (p.coeff d))
              ⟨Xa ^ n, pow_mem (Submonoid.mem_powers Xa) n⟩ := by
        intro d hd
        rw [hφ_monomial]
        have hdn : (Finsupp.weight 1) d = n := hp (MvPolynomial.mem_support_iff.mp hd)
        congr 1
        exact Subtype.ext (by change Xa ^ ((Finsupp.weight 1) d) = Xa ^ n; rw [hdn])
      rw [Finset.sum_congr rfl hterms, h_sum_mk, ← MvPolynomial.as_sum p]
    intro z
    obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
    obtain ⟨n, hn⟩ := nd.den_mem
    have hn' : Xa ^ n = nd.den.1 := hn
    have hXa_pow_ne : Xa ^ n ≠ 0 := by
      intro h0
      have hev := congrArg (MvPolynomial.eval (fun _ => (1 : k))) h0
      simp [Xa] at hev
    have hex_d : ∃ d₀, (Xa ^ n).coeff d₀ ≠ 0 := by
      by_contra h_all
      push Not at h_all
      exact hXa_pow_ne (MvPolynomial.ext_iff.mpr fun d => by simp [h_all d])
    obtain ⟨d₀, hd₀⟩ := hex_d
    have hden_homog : (Xa ^ n).IsHomogeneous nd.deg := by
      rw [hn']
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.den.1).mp nd.den.2
    have hXa_homog : (Xa ^ n).IsHomogeneous n := by
      simpa using (MvPolynomial.isHomogeneous_X k a).pow n
    have hdeg_eq : nd.deg = n := (hden_homog hd₀).symm.trans (hXa_homog hd₀)
    have hnum_homog : nd.num.1.IsHomogeneous n := by
      rw [← hdeg_eq]
      exact (MvPolynomial.mem_homogeneousSubmodule nd.deg nd.num.1).mp nd.num.2
    refine ⟨dehom nd.num.1, ?_⟩
    apply HomogeneousLocalization.val_injective
    change φ nd.num.1 = (HomogeneousLocalization.mk nd).val
    rw [hφ_homog n nd.num.1 hnum_homog, HomogeneousLocalization.val_mk]
    congr 1
    exact Subtype.ext hn'

  have hC4 : ∀ (i : Fin M)
      (hXβ₀ : (MvPolynomial.X (diag_idx i).succ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈ 𝒜_N 1)
      (hpos : 0 < 1),
      let β₀ := diag_idx i
      let D_β₀ := AlgebraicGeometry.Proj.basicOpen 𝒜_N (MvPolynomial.X β₀.succ)
      let ρ_i := ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X β₀.succ) hXβ₀ hpos).hom ≫
        ν₂.left.app D_β₀).hom
      Function.Surjective
        (MvPolynomial.eval₂Hom
          (ρ_i.comp
            ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
              (Submonoid.powers (MvPolynomial.X β₀.succ))).comp (algebraMap k ↥(𝒜_N 0))))
          (fun m : Fin N' =>
            ρ_i (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
                ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, ⟨1, pow_one _⟩⟩))) := by
    intro i hXβ₀ hpos β₀ D_β₀ ρ_i
    let a : Fin (M + 1) := i.succ
    let α₀ : Fin (N' + 1 + 1) := β₀.succ
    have hα₀_eq : α₀ = e_idx (a, a) := hdiag i
    have hx_a : Q α₀ = MvPolynomial.X a * MvPolynomial.X a := by
      rw [hα₀_eq, hQ_pair]
    have hXa : MvPolynomial.X a ∈ 𝒜_M 1 := hXM a

    
    have hsub_diag :
        Submonoid.powers (MvPolynomial.X α₀ : MvPolynomial (Fin (N' + 1 + 1)) k) ≤
          Submonoid.comap Φ_quad (Submonoid.powers (MvPolynomial.X a)) := by
      apply Submonoid.powers_le.mpr
      change Φ_quad (MvPolynomial.X α₀) ∈ Submonoid.powers (MvPolynomial.X a)
      rw [MvPolynomial.eval₂Hom_X', hx_a]
      exact ⟨2, sq (MvPolynomial.X a)⟩
    let θ_a : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α₀) →+*
        HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a) :=
      veroneseLocMap hsub_diag

    have hθ_comp : (HomogeneousLocalization.awayMap 𝒜_M hXa hx_a).comp θ_a = ψ α₀ := by
      apply RingHom.ext
      intro z
      obtain ⟨nd, rfl⟩ := HomogeneousLocalization.mk_surjective z
      obtain ⟨n, hn⟩ := nd.den_mem
      have hn' : MvPolynomial.X α₀ ^ n = nd.den.1 := hn
      have hXa_pow : MvPolynomial.X a ^ (2 * n) ∈ 𝒜_M (2 * nd.deg) := by
        have h1 : Φ_quad nd.den.1 ∈ 𝒜_M (2 * nd.deg) := hΦ_hom nd.deg nd.den.1 nd.den.2
        have h2 : Φ_quad nd.den.1 = MvPolynomial.X a ^ (2 * n) := by
          rw [← hn', map_pow, MvPolynomial.eval₂Hom_X', hx_a, pow_mul, sq]
        rwa [← h2]
      let nd_diag : HomogeneousLocalization.NumDenSameDeg 𝒜_M
          (Submonoid.powers (MvPolynomial.X a)) :=
        ⟨2 * nd.deg, ⟨Φ_quad nd.num.1, hΦ_hom nd.deg nd.num.1 nd.num.2⟩,
          ⟨MvPolynomial.X a ^ (2 * n), hXa_pow⟩,
          pow_mem (Submonoid.mem_powers (MvPolynomial.X a)) (2 * n)⟩
      have hθ_mk : θ_a (HomogeneousLocalization.mk nd) = HomogeneousLocalization.mk nd_diag := by
        apply HomogeneousLocalization.val_injective
        rw [hVeronese_mk_val hsub_diag, HomogeneousLocalization.val_mk]
        congr 1
        apply Subtype.ext
        change Φ_quad nd.den.1 = MvPolynomial.X a ^ (2 * n)
        rw [← hn', map_pow, MvPolynomial.eval₂Hom_X', hx_a, pow_mul, sq]
      apply HomogeneousLocalization.val_injective
      simp only [RingHom.comp_apply]
      rw [hθ_mk, HomogeneousLocalization.val_awayMap_mk, hVeronese_mk_val (hsub_chart α₀),
        Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      have hQ_pow : MvPolynomial.X a ^ (2 * n) = Q α₀ ^ n := by
        rw [hx_a, pow_mul, sq]
      have hden_Q : Φ_quad nd.den.1 = Q α₀ ^ n := by
        rw [← hn', map_pow, MvPolynomial.eval₂Hom_X']
      change 1 * (Φ_quad nd.den.1 * (Φ_quad nd.num.1 * MvPolynomial.X a ^ (2 * n))) =
        1 * (Q α₀ ^ (2 * n) * Φ_quad nd.num.1)
      rw [hQ_pow, hden_Q]
      ring

    have hθ_zero : ∀ c : k,
        θ_a (HomogeneousLocalization.fromZeroRingHom 𝒜_N
            (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_N 0) c)) =
          HomogeneousLocalization.fromZeroRingHom 𝒜_M
            (Submonoid.powers (MvPolynomial.X a)) (algebraMap k ↥(𝒜_M 0) c) := by
      intro c
      apply HomogeneousLocalization.val_injective
      change (veroneseFun hsub_diag
          (HomogeneousLocalization.fromZeroRingHom 𝒜_N
            (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_N 0) c))).val = _
      rw [hVeronese_val]
      have hvN : (HomogeneousLocalization.fromZeroRingHom 𝒜_N
          (Submonoid.powers (MvPolynomial.X α₀)) (algebraMap k ↥(𝒜_N 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := rfl
      have hvM : (HomogeneousLocalization.fromZeroRingHom 𝒜_M
          (Submonoid.powers (MvPolynomial.X a)) (algebraMap k ↥(𝒜_M 0) c)).val =
          Localization.mk (MvPolynomial.C c) 1 := rfl
      rw [hvN, hvM, Localization.mk_eq_mk', IsLocalization.map_mk' hsub_diag,
        ← Localization.mk_eq_mk']
      congr 1
      · exact MvPolynomial.eval₂Hom_C MvPolynomial.C Q c
      · apply Subtype.ext
        exact map_one Φ_quad

    have hθ_ratio : ∀ (u : Fin (M + 1)) (γ : Fin (N' + 1 + 1)),
        e_idx (u, a) = γ →
        ∀ (hXγ : MvPolynomial.X γ ∈ 𝒜_N 1)
          (hmem : (MvPolynomial.X α₀ : MvPolynomial (Fin (N' + 1 + 1)) k) ∈
            Submonoid.powers (MvPolynomial.X α₀)),
          θ_a (HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X γ, hXγ⟩, ⟨MvPolynomial.X α₀, hXβ₀⟩, hmem⟩) =
            HomogeneousLocalization.mk
              ⟨1, ⟨MvPolynomial.X u, MvPolynomial.isHomogeneous_X k u⟩,
                ⟨MvPolynomial.X a, hXa⟩, Submonoid.mem_powers (MvPolynomial.X a)⟩ := by
      intro u γ hγ hXγ hmem
      subst hγ
      apply HomogeneousLocalization.val_injective
      rw [hVeronese_mk_val hsub_diag, HomogeneousLocalization.val_mk,
        Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      refine ⟨1, ?_⟩
      change 1 * (MvPolynomial.X a * Φ_quad (MvPolynomial.X (e_idx (u, a)))) =
        1 * (Φ_quad (MvPolynomial.X α₀) * MvPolynomial.X u)
      rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', hQ_pair u a, hx_a]
      ring

    
    let U_a : P_M.Opens := AlgebraicGeometry.Proj.basicOpen 𝒜_M (MvPolynomial.X a)
    have hU_eq_W : U_a = W α₀ := by
      dsimp only [U_a, W]
      rw [hx_a, AlgebraicGeometry.Proj.basicOpen_mul, inf_idem]
    have hU_eq_pre : U_a = ν_left ⁻¹ᵁ D_β₀ := hU_eq_W.trans (hPre α₀).symm
    have hChart_deg1 : U_a.ι ≫ ν_left =
        (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X a) hXa hpos).hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a) ≫
        AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos := by
      have h_toSpec :
          AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M (Q α₀) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (HomogeneousLocalization.awayMap 𝒜_M hXa hx_a)) =
          P_M.homOfLE (by rw [← hU_eq_W] : W α₀ ≤ U_a) ≫
            AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M (MvPolynomial.X a) :=
        AlgebraicGeometry.Proj.basicOpenToSpec_SpecMap_awayMap 𝒜_M hXa hx_a
      have hiso_hom : (P_M.isoOfEq hU_eq_W).hom ≫ P_M.homOfLE (by rw [← hU_eq_W] : W α₀ ≤ U_a) =
          𝟙 U_a.toScheme := by
        rw [← CategoryTheory.cancel_mono U_a.ι, CategoryTheory.Category.assoc,
          AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.isoOfEq_hom_ι,
          CategoryTheory.Category.id_comp]
      have hU_ι_W : U_a.ι ≫ ν_left = (P_M.isoOfEq hU_eq_W).hom ≫ f_loc α₀ := by
        rw [← hChart α₀, ← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.isoOfEq_hom_ι]
      have h_away_eq :
          AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) (hXN α₀) zero_lt_one =
          AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos := rfl
      calc U_a.ι ≫ ν_left
          = (P_M.isoOfEq hU_eq_W).hom ≫ f_loc α₀ := hU_ι_W
        _ = (P_M.isoOfEq hU_eq_W).hom ≫
              ((AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M (Q α₀) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (HomogeneousLocalization.awayMap 𝒜_M hXa hx_a))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a) ≫
                AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos) := by
              dsimp only [f_loc]
              rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom, ← hθ_comp,
                CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, h_away_eq]
              simp only [CategoryTheory.Category.assoc]
        _ = ((P_M.isoOfEq hU_eq_W).hom ≫ P_M.homOfLE (by rw [← hU_eq_W] : W α₀ ≤ U_a)) ≫
              AlgebraicGeometry.Proj.basicOpenToSpec 𝒜_M (MvPolynomial.X a) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos := by
              rw [h_toSpec]
              simp only [CategoryTheory.Category.assoc]
        _ = (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X a) hXa hpos).hom ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a) ≫
              AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos := by
              rw [hiso_hom, CategoryTheory.Category.id_comp,
                ← AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_M (MvPolynomial.X a) hXa hpos]

    let iso_sec : CommRingCat.of (HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a)) ≅
        P_M.presheaf.obj (Opposite.op (ν_left ⁻¹ᵁ D_β₀)) :=
      AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_M (MvPolynomial.X a) hXa hpos ≪≫
        P_M.presheaf.mapIso (CategoryTheory.eqToIso (congrArg Opposite.op hU_eq_pre))
    let e_sec := iso_sec.commRingCatIsoToRingEquiv

    have hle : U_a ≤ ν_left ⁻¹ᵁ D_β₀ := hU_eq_pre.le
    have hAppLE_eq :
        AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀) ≫
          ν_left.appLE D_β₀ U_a hle =
        CommRingCat.ofHom θ_a ≫
          AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X a) := by
      let _ : GradedAlgebra 𝒜_M := MvPolynomial.gradedAlgebra
      let _ : GradedAlgebra 𝒜_N := MvPolynomial.gradedAlgebra
      apply AlgebraicGeometry.Spec.map_injective
      have hAff_Ua : AlgebraicGeometry.IsAffineOpen U_a :=
        AlgebraicGeometry.Proj.isAffineOpen_basicOpen 𝒜_M (MvPolynomial.X a) hXa hpos
      have : CategoryTheory.IsIso U_a.toSpecΓ := by
        rw [← hAff_Ua.isoSpec_hom]
        infer_instance
      rw [← CategoryTheory.cancel_epi U_a.toSpecΓ,
        ← CategoryTheory.cancel_mono
          (AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos)]
      have hLHS :
          (U_a.toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀) ≫
                ν_left.appLE D_β₀ U_a hle)) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos =
          U_a.ι ≫ ν_left := by
        have hD_away : D_β₀.toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀)) =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos).hom := by
          rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos]
          rfl
        have h_away_ι : (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_N
              (MvPolynomial.X α₀) hXβ₀ hpos).hom ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos = D_β₀.ι := by
          rw [← AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι 𝒜_N
            (MvPolynomial.X α₀) hXβ₀ hpos, CategoryTheory.Iso.hom_inv_id_assoc]
        rw [AlgebraicGeometry.Spec.map_comp,
          ← CategoryTheory.Category.assoc U_a.toSpecΓ,
          AlgebraicGeometry.Scheme.Opens.toSpecΓ_SpecMap_appLE ν_left D_β₀ U_a hle,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc D_β₀.toSpecΓ, hD_away, h_away_ι,
          AlgebraicGeometry.Scheme.Hom.resLE_comp_ι ν_left hle]
      have hRHS :
          (U_a.toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom θ_a ≫
                AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X a))) ≫
            AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos =
          (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X a) hXa hpos).hom ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ_a) ≫
          AlgebraicGeometry.Proj.awayι 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos := by
        have hU_away : U_a.toSpecΓ ≫
            AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X a)) =
            (AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_M (MvPolynomial.X a) hXa hpos).hom := by
          rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_hom 𝒜_M (MvPolynomial.X a) hXa hpos]
          rfl
        rw [AlgebraicGeometry.Spec.map_comp,
          ← CategoryTheory.Category.assoc U_a.toSpecΓ, hU_away,
          CategoryTheory.Category.assoc]
      rw [hLHS, hRHS, hChart_deg1]

    have hSec_hom :
        (AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos).hom ≫
          ν_left.app D_β₀ =
        CommRingCat.ofHom θ_a ≫ iso_sec.hom := by
      let res_Ua := P_M.presheaf.map (CategoryTheory.homOfLE hle).op
      have : CategoryTheory.IsIso res_Ua := by
        have h_op : (CategoryTheory.homOfLE hle).op =
            CategoryTheory.eqToHom (congrArg Opposite.op hU_eq_pre.symm) :=
          Subsingleton.elim _ _
        rw [show res_Ua = P_M.presheaf.map
              (CategoryTheory.eqToHom (congrArg Opposite.op hU_eq_pre.symm)) from
            congrArg (P_M.presheaf.map ·) h_op]
        infer_instance
      rw [← CategoryTheory.cancel_mono res_Ua]
      have h1 : ((AlgebraicGeometry.Proj.basicOpenIsoAway 𝒜_N (MvPolynomial.X α₀) hXβ₀ hpos).hom ≫
          ν_left.app D_β₀) ≫ res_Ua =
          AlgebraicGeometry.Proj.awayToSection 𝒜_N (MvPolynomial.X α₀) ≫
            ν_left.appLE D_β₀ U_a hle := by
        rw [AlgebraicGeometry.Proj.basicOpenIsoAway_hom, CategoryTheory.Category.assoc]
        rfl
      have h2 : (CommRingCat.ofHom θ_a ≫ iso_sec.hom) ≫ res_Ua =
          CommRingCat.ofHom θ_a ≫
            AlgebraicGeometry.Proj.awayToSection 𝒜_M (MvPolynomial.X a) := by
        dsimp only [iso_sec, Iso.trans_hom, Functor.mapIso_hom, res_Ua]
        simp only [CategoryTheory.Category.assoc, ← P_M.presheaf.map_comp]
        have h_id : (CategoryTheory.eqToIso (congrArg Opposite.op hU_eq_pre)).hom ≫
            (CategoryTheory.homOfLE hle).op =
            𝟙 (Opposite.op U_a) := Subsingleton.elim _ _
        rw [h_id, P_M.presheaf.map_id, CategoryTheory.Category.comp_id,
          AlgebraicGeometry.Proj.basicOpenIsoAway_hom]
      rw [h1, h2, hAppLE_eq]

    let D_β₀' : (weilProjectiveSpaceOver k (N' + 1)).left.Opens := D_β₀
    let e_sec' : HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a) ≃+*
        ↑((weilProjectiveSpaceOver k M).left.presheaf.obj (Opposite.op (ν₂.left ⁻¹ᵁ D_β₀'))) :=
      e_sec

    have hρ_eq : ∀ z : HomogeneousLocalization.Away 𝒜_N (MvPolynomial.X α₀),
        ρ_i z = e_sec' (θ_a z) := by
      intro z
      exact ConcreteCategory.congr_hom hSec_hom z

    
    let τ := {b : Fin (M + 1) // b ≠ a}
    have hm_ex : ∀ u : τ, ∃ m : Fin N', e_idx (u.1, a) = (β₀.succAbove m).succ := by
      intro u
      have hne_0 : e_idx (u.1, a) ≠ 0 := by
        intro h0
        have hp : (u.1, a) = (0, 0) := e_idx.injective (h0.trans he00.symm)
        exact Fin.succ_ne_zero i (Prod.mk.inj hp).2
      let β_u : Fin (N' + 1) := (e_idx (u.1, a)).pred hne_0
      have hβ_u : β_u.succ = e_idx (u.1, a) := Fin.succ_pred _ hne_0
      have hβ_ne : β_u ≠ β₀ := by
        intro heq
        have h_idx : e_idx (u.1, a) = e_idx (a, a) := by
          rw [← hβ_u, heq, ← hα₀_eq]
        exact u.2 (Prod.mk.inj (e_idx.injective h_idx)).1
      obtain ⟨m, hm⟩ := Fin.exists_succAbove_eq hβ_ne
      exact ⟨m, by rw [hm, hβ_u]⟩

    let m_of : τ → Fin N' := fun u => Classical.choose (hm_ex u)
    have hm_of : ∀ u : τ, e_idx (u.1, a) = (β₀.succAbove (m_of u)).succ :=
      fun u => Classical.choose_spec (hm_ex u)

    let ev_N' : MvPolynomial (Fin N') k →+*
        ↑((weilProjectiveSpaceOver k M).left.presheaf.obj (Opposite.op (ν₂.left ⁻¹ᵁ D_β₀'))) :=
      MvPolynomial.eval₂Hom
        (ρ_i.comp
          ((HomogeneousLocalization.fromZeroRingHom 𝒜_N
            (Submonoid.powers (MvPolynomial.X β₀.succ))).comp (algebraMap k ↥(𝒜_N 0))))
        (fun m : Fin N' =>
          ρ_i (HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X ((β₀.succAbove m).succ), MvPolynomial.isHomogeneous_X k _⟩,
              ⟨MvPolynomial.X β₀.succ, hXβ₀⟩, ⟨1, pow_one _⟩⟩))
    let α_std : MvPolynomial τ k →+* HomogeneousLocalization.Away 𝒜_M (MvPolynomial.X a) :=
      MvPolynomial.eval₂Hom
        ((HomogeneousLocalization.fromZeroRingHom 𝒜_M (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap k ↥(𝒜_M 0)))
        (fun u : τ =>
          HomogeneousLocalization.mk
            ⟨1, ⟨MvPolynomial.X u.1, MvPolynomial.isHomogeneous_X k u.1⟩,
              ⟨MvPolynomial.X a, hXa⟩, Submonoid.mem_powers (MvPolynomial.X a)⟩)

    have hComp_rename :
        ev_N'.comp (MvPolynomial.rename m_of).toRingHom =
          e_sec'.toRingHom.comp α_std := by
      apply MvPolynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change ev_N' (MvPolynomial.rename m_of (MvPolynomial.C c)) =
          e_sec' (α_std (MvPolynomial.C c))
        rw [MvPolynomial.rename_C]
        dsimp only [ev_N', α_std]
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
          RingHom.comp_apply, RingHom.comp_apply, hρ_eq, hθ_zero c]
      · intro u
        change ev_N' (MvPolynomial.rename m_of (MvPolynomial.X u)) =
          e_sec' (α_std (MvPolynomial.X u))
        rw [MvPolynomial.rename_X]
        dsimp only [ev_N', α_std]
        rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X', hρ_eq]
        congr 1
        exact hθ_ratio u.1 ((β₀.succAbove (m_of u)).succ) (hm_of u)
          (MvPolynomial.isHomogeneous_X k _) ⟨1, pow_one _⟩

    intro s
    obtain ⟨P, hP⟩ := hStdChartSurj a hXa (e_sec'.symm s)
    refine ⟨MvPolynomial.rename m_of P, ?_⟩
    have h1 : ev_N' (MvPolynomial.rename m_of P) = e_sec' (α_std P) :=
      DFunLike.congr_fun hComp_rename P
    change ev_N' (MvPolynomial.rename m_of P) = s
    rw [h1]
    have hP' : α_std P = e_sec'.symm s := hP
    rw [hP', e_sec'.apply_symm_apply]

  exact ⟨N', ν₂, diag_idx, hC1, hC2, hC3, hC4⟩

theorem weil_algClosed_pointed_proj_closedSet_avoidance_poly (k : Type u) [Field k] [IsAlgClosed k]
    (N' p : ℕ)
    (q_star : ↥(weilProjectiveSpaceOver k (N' + 1)).left)
    (hq_pt : ∀ β : Fin (N' + 1),
      q_star ∈ weilProjHyperplaneSet k (N' + 1) (MvPolynomial.X β.succ))
    (Y : Fin p → Set ↥(weilProjectiveSpaceOver k (N' + 1)).left)
    (hY : ∀ a : Fin p, IsClosed (Y a)) :
    ∃ Δ_closed : MvPolynomial (Fin (N' + 1)) k,
      Δ_closed ≠ 0 ∧
      ∀ c' : Fin (N' + 1) → k,
        MvPolynomial.eval c' Δ_closed ≠ 0 →
        ∀ a : Fin p,
          (q_star ∉ Y a →
            topologicalKrullDim ↥(Y a ∩ weilProjHyperplaneSet k (N' + 1)
              (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ)) + 1 ≤
              topologicalKrullDim ↥(Y a)) ∧
          (topologicalKrullDim ↥(Y a ∩ weilProjHyperplaneSet k (N' + 1)
            (∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ)) + 1 ≤
            max (topologicalKrullDim ↥(Y a)) ((1 : ℕ) : WithBot ℕ∞)) :=
by
  classical
  let R := MvPolynomial (Fin (N' + 1 + 1)) k
  let F_pt : (Fin (N' + 1) → k) → R := fun c' =>
    ∑ β : Fin (N' + 1), MvPolynomial.C (c' β) * MvPolynomial.X β.succ

  
  have hIdealAvoid : ∀ (I : Ideal R) (β₀ : Fin (N' + 1)),
      (MvPolynomial.X β₀.succ : R) ∉ I →
      ∃ L : MvPolynomial (Fin (N' + 1)) k,
        L ≠ 0 ∧ ∀ c' : Fin (N' + 1) → k, MvPolynomial.eval c' L ≠ 0 → F_pt c' ∉ I := by
    intro I β₀ hNotMem
    let V_I : Submodule k (Fin (N' + 1) → k) :=
      { carrier := { c' : Fin (N' + 1) → k | F_pt c' ∈ I }
        zero_mem' := by
          change F_pt 0 ∈ I
          have h0 : F_pt 0 = 0 := by
            simp [F_pt]
          rw [h0]
          exact I.zero_mem
        add_mem' := by
          intro c₁ c₂ hc₁ hc₂
          change F_pt (c₁ + c₂) ∈ I
          have hadd : F_pt (c₁ + c₂) = F_pt c₁ + F_pt c₂ := by
            simp only [F_pt, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          rw [hadd]
          exact I.add_mem hc₁ hc₂
        smul_mem' := by
          intro r c' hc'
          change F_pt (r • c') ∈ I
          have hsmul : F_pt (r • c') = MvPolynomial.C r * F_pt c' := by
            simp only [F_pt, Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, Finset.mul_sum]
          rw [hsmul]
          exact I.mul_mem_left _ hc' }
    have hVI_lt : V_I < ⊤ := by
      rw [lt_top_iff_ne_top]
      intro hTop
      have hmem : (Pi.single β₀ (1 : k) : Fin (N' + 1) → k) ∈ V_I := by
        rw [hTop]
        trivial
      change F_pt (Pi.single β₀ (1 : k)) ∈ I at hmem
      have hsingle : F_pt (Pi.single β₀ (1 : k)) = MvPolynomial.X β₀.succ := by
        dsimp [F_pt]
        rw [Finset.sum_eq_single β₀]
        · simp [Pi.single_eq_same]
        · intro β _ hβ
          simp [Pi.single_eq_of_ne hβ]
        · intro h
          exact absurd (Finset.mem_univ β₀) h
      rw [hsingle] at hmem
      exact hNotMem hmem
    obtain ⟨ℓ, hℓ_ne, hℓ_ker⟩ :=
      Submodule.exists_dual_map_eq_bot_of_lt_top hVI_lt inferInstance
    let L : MvPolynomial (Fin (N' + 1)) k :=
      ∑ β : Fin (N' + 1), MvPolynomial.C (ℓ (Pi.single β 1)) * MvPolynomial.X β
    have hEval : ∀ c' : Fin (N' + 1) → k, MvPolynomial.eval c' L = ℓ c' := by
      intro c'
      have hc' : c' = ∑ β : Fin (N' + 1), c' β • Pi.single β (1 : k) := by
        ext γ
        simp [Finset.sum_apply, Pi.single_apply]
      conv_rhs => rw [hc']
      dsimp only [L]
      simp only [map_sum, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X,
        map_smul, smul_eq_mul]
      refine Finset.sum_congr rfl fun β _ => ?_
      ring
    have hL_ne : L ≠ 0 := by
      intro hL0
      apply hℓ_ne
      apply LinearMap.ext
      intro c'
      rw [← hEval c', hL0, map_zero, LinearMap.zero_apply]
    refine ⟨L, hL_ne, fun c' hc' hIn => hc' ?_⟩
    rw [hEval c']
    have hmap : ℓ c' ∈ Submodule.map ℓ V_I := ⟨c', hIn, rfl⟩
    rw [hℓ_ker, Submodule.mem_bot] at hmap
    exact hmap

  
  have hKrullBounds : ∀ {T : Type u} [TopologicalSpace T]
      (q₀ : T) (Y₀ H₀ : Set T) (_ : IsClosed H₀)
      (S₀ : Finset (Set T))
      (_ : ∀ W ∈ S₀, IsClosed W ∧ IsIrreducible W)
      (_ : Y₀ = ⋃ W ∈ S₀, W)
      (_ : ∀ W ∈ S₀, W ⊆ {q₀} ∨ ∃ z ∈ W, z ∉ H₀),
      (q₀ ∉ Y₀ → topologicalKrullDim ↥(Y₀ ∩ H₀) + 1 ≤ topologicalKrullDim ↥Y₀) ∧
      (topologicalKrullDim ↥(Y₀ ∩ H₀) + 1 ≤
        max (topologicalKrullDim ↥Y₀) ((1 : ℕ) : WithBot ℕ∞)) := by
    intro T _ q₀ Y₀ H₀ hClosedH S₀ hS₀ hY₀_eq hAvoid₀
    by_cases hEmp : IsEmpty (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀))
    · have hBot : topologicalKrullDim ↥(Y₀ ∩ H₀) = ⊥ := by
        change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀)) = ⊥
        exact @Order.krullDim_eq_bot _ _ hEmp
      rw [hBot]
      have hBotAdd : (⊥ : WithBot ℕ∞) + 1 = ⊥ := rfl
      rw [hBotAdd]
      exact ⟨fun _ => bot_le, bot_le⟩
    · have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀)) :=
        not_isEmpty_iff.mp hEmp
      let C₀ : TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀) := Classical.arbitrary _
      let ι : ↥(Y₀ ∩ H₀) → ↥Y₀ := fun x => ⟨x.1, x.2.1⟩
      have hInj : Function.Injective ι := fun x₁ x₂ h =>
        Subtype.ext (congrArg (Subtype.val : ↥Y₀ → T) h)
      have hInd : Topology.IsInducing ι :=
        (Topology.IsInducing.subtypeVal (t := Y₀)).of_comp_iff.mp
          (Topology.IsInducing.subtypeVal (t := Y₀ ∩ H₀))
      have hRange : Set.range ι = (Subtype.val : ↥Y₀ → T) ⁻¹' H₀ := by
        ext y
        refine ⟨?_, ?_⟩
        · rintro ⟨x, rfl⟩
          exact x.2.2
        · intro hyH
          exact ⟨⟨y.1, ⟨y.2, hyH⟩⟩, rfl⟩
      have hRangeCl : IsClosed (Set.range ι) := by
        rw [hRange]
        exact hClosedH.preimage continuous_subtype_val
      have hClEmb : Topology.IsClosedEmbedding ι := ⟨⟨hInd, hInj⟩, hRangeCl⟩
      let Φ : TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀) →
          TopologicalSpace.IrreducibleCloseds ↥Y₀ :=
        fun C =>
          { carrier := ι '' (C : Set ↥(Y₀ ∩ H₀))
            isIrreducible' := C.isIrreducible'.image ι hClEmb.continuous.continuousOn
            isClosed' := hClEmb.isClosedMap _ C.isClosed' }
      have hStrictMono : StrictMono Φ := by
        intro C₁ C₂ hlt
        refine lt_of_le_not_ge ?_ ?_
        · exact Set.image_mono (le_of_lt hlt)
        · intro hle
          exact not_le_of_gt hlt ((Set.image_subset_image_iff hInj).mp hle)
      have : Nonempty (TopologicalSpace.IrreducibleCloseds ↥Y₀) := ⟨Φ C₀⟩
      have hWY_sub : ∀ W ∈ S₀, W ⊆ Y₀ := by
        intro W hW x hx
        rw [hY₀_eq]
        exact Set.mem_biUnion hW hx
      have hWY_cl : ∀ W ∈ S₀, IsClosed { y : ↥Y₀ | y.1 ∈ W } := by
        intro W hW
        exact (hS₀ W hW).1.preimage continuous_subtype_val
      have hWY_irr : ∀ W ∈ S₀, IsIrreducible { y : ↥Y₀ | y.1 ∈ W } := by
        intro W hW
        refine ⟨?_, ?_⟩
        · obtain ⟨w₀, hw₀⟩ := (hS₀ W hW).2.nonempty
          exact ⟨⟨w₀, hWY_sub W hW hw₀⟩, hw₀⟩
        · rw [isPreirreducible_iff_isClosed_union_isClosed]
          intro z₁ z₂ hz₁ hz₂ hsub
          rw [isClosed_induced_iff] at hz₁ hz₂
          obtain ⟨F₁, hF₁, rfl⟩ := hz₁
          obtain ⟨F₂, hF₂, rfl⟩ := hz₂
          have hW_union : W ⊆ F₁ ∪ F₂ := by
            intro x hx
            exact hsub (show (⟨x, hWY_sub W hW hx⟩ : ↥Y₀).1 ∈ W from hx)
          rcases isPreirreducible_iff_isClosed_union_isClosed.mp
            (hS₀ W hW).2.isPreirreducible F₁ F₂ hF₁ hF₂ hW_union with h1 | h2
          · left
            intro y hy
            exact h1 hy
          · right
            intro y hy
            exact h2 hy
      let t_fin : Finset (Set ↥Y₀) := S₀.image (fun W : Set T => { y : ↥Y₀ | y.1 ∈ W })
      have ht_cl : ∀ Z ∈ t_fin, IsClosed Z := by
        intro Z hZ
        simp only [t_fin, Finset.mem_image] at hZ
        obtain ⟨W, hW, rfl⟩ := hZ
        exact hWY_cl W hW
      have ht_cov : ∀ y : ↥Y₀, y ∈ ⋃₀ (t_fin : Set (Set ↥Y₀)) := by
        intro y
        have hy : (y : T) ∈ ⋃ W ∈ S₀, W := hY₀_eq ▸ y.2
        rw [Set.mem_iUnion₂] at hy
        obtain ⟨W, hW, hyW⟩ := hy
        refine Set.mem_sUnion.mpr ⟨{ z : ↥Y₀ | z.1 ∈ W }, ?_, hyW⟩
        simp only [t_fin, Finset.mem_coe, Finset.mem_image]
        exact ⟨W, hW, rfl⟩
      have hChainDichotomy : ∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀)),
          ∃ W ∈ S₀,
            ((∃ z ∈ W, z ∉ H₀) →
              ∃ q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀),
                q.length = p.length + 1) ∧
            (W ⊆ {q₀} → p.length = 0) := by
        intro p
        let p' : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀) :=
          { length := p.length
            toFun := fun i => Φ (p.toFun i)
            step := fun i => hStrictMono (p.step i) }
        have hSubUnion : (p'.last : Set ↥Y₀) ⊆ ⋃₀ (t_fin : Set (Set ↥Y₀)) := fun y _ => ht_cov y
        obtain ⟨Z, hZ_mem, hLastSub⟩ :=
          (isIrreducible_iff_sUnion_isClosed.mp p'.last.isIrreducible') t_fin ht_cl hSubUnion
        simp only [t_fin, Finset.mem_image] at hZ_mem
        obtain ⟨W, hW, rfl⟩ := hZ_mem
        refine ⟨W, hW, ?_, ?_⟩
        · rintro ⟨z, hzW, hzNotH⟩
          let W_hat : TopologicalSpace.IrreducibleCloseds ↥Y₀ :=
            { carrier := { y : ↥Y₀ | y.1 ∈ W }
              isIrreducible' := hWY_irr W hW
              isClosed' := hWY_cl W hW }
          have hle : p'.last ≤ W_hat := hLastSub
          have hnot_le : ¬ W_hat ≤ p'.last := by
            intro hge
            have hz_mem : (⟨z, hWY_sub W hW hzW⟩ : ↥Y₀) ∈ (W_hat : Set ↥Y₀) := hzW
            have hz_last : (⟨z, hWY_sub W hW hzW⟩ : ↥Y₀) ∈ (p'.last : Set ↥Y₀) := hge hz_mem
            change (⟨z, hWY_sub W hW hzW⟩ : ↥Y₀) ∈ ι '' (p.last : Set ↥(Y₀ ∩ H₀)) at hz_last
            have hz_range : (⟨z, hWY_sub W hW hzW⟩ : ↥Y₀) ∈ Set.range ι := by
              obtain ⟨x, _, hx⟩ := hz_last
              exact ⟨x, hx⟩
            rw [hRange] at hz_range
            exact hzNotH hz_range
          exact ⟨p'.snoc W_hat (lt_of_le_not_ge hle hnot_le), RelSeries.snoc_length _ _ _⟩
        · intro hW_sub
          by_contra hp_ne
          have hp_pos : 0 < p'.length := Nat.pos_of_ne_zero hp_ne
          have h0_lt_last : (0 : Fin (p'.length + 1)) < Fin.last p'.length := by
            simp [Fin.lt_def, hp_pos]
          have hlt0 : p' 0 < p'.last := p'.strictMono h0_lt_last
          obtain ⟨y₀, hy₀⟩ := (p' 0).isIrreducible'.nonempty
          have hy₀_last : y₀ ∈ (p'.last : Set ↥Y₀) := (le_of_lt hlt0) hy₀
          have hy₀_W : y₀.1 ∈ W := hLastSub hy₀_last
          have hy₀_eq : y₀.1 = q₀ := Set.mem_singleton_iff.mp (hW_sub hy₀_W)
          have hlast_le : p'.last ≤ p' 0 := by
            intro z hz
            have hz_W : z.1 ∈ W := hLastSub hz
            have hz_eq : z.1 = q₀ := Set.mem_singleton_iff.mp (hW_sub hz_W)
            have hz_y₀ : z = y₀ := Subtype.ext (hz_eq.trans hy₀_eq.symm)
            rwa [hz_y₀]
          exact not_le_of_gt hlt0 hlast_le
      let A : ℕ∞ := ⨆ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀)), (p.length : ℕ∞)
      let B : ℕ∞ := ⨆ q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀), (q.length : ℕ∞)
      have hDimYH : topologicalKrullDim ↥(Y₀ ∩ H₀) = (A : WithBot ℕ∞) :=
        Order.krullDim_eq_iSup_length
      have hDimY : topologicalKrullDim ↥Y₀ = (B : WithBot ℕ∞) :=
        Order.krullDim_eq_iSup_length
      have hBoundENat : ∀ M : ℕ∞, 1 ≤ M →
          (∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀)),
            ((p.length + 1 : ℕ) : ℕ∞) ≤ M) →
          A + 1 ≤ M := by
        intro M h1M hAll
        induction M using ENat.recTopCoe with
        | top => exact le_top
        | coe m =>
          have hm1 : 1 ≤ m := by
            exact_mod_cast h1M
          have hA_le : A ≤ ((m - 1 : ℕ) : ℕ∞) := by
            refine iSup_le fun p => ?_
            have hp : p.length + 1 ≤ m := by
              exact_mod_cast hAll p
            have hp' : p.length ≤ m - 1 := by omega
            exact_mod_cast hp'
          calc A + 1
              ≤ ((m - 1 : ℕ) : ℕ∞) + ((1 : ℕ) : ℕ∞) := add_le_add hA_le le_rfl
            _ = ((m - 1 + 1 : ℕ) : ℕ∞) := by norm_cast
            _ = (m : ℕ∞) := by congr 1; omega
      rw [hDimYH, hDimY]
      have hLHS_eq : (A : WithBot ℕ∞) + 1 = ((A + 1 : ℕ∞) : WithBot ℕ∞) := by
        rw [← WithBot.coe_one, ← WithBot.coe_add]
      rw [hLHS_eq]
      refine ⟨?_, ?_⟩
      · intro hq_not
        have hNoSing : ∀ W ∈ S₀, ¬ W ⊆ {q₀} := by
          intro W hW hsub
          obtain ⟨w₀, hw₀⟩ := (hS₀ W hW).2.nonempty
          have hw_eq : w₀ = q₀ := Set.mem_singleton_iff.mp (hsub hw₀)
          exact hq_not (hw_eq ▸ hWY_sub W hW hw₀)
        have hStepAll : ∀ p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(Y₀ ∩ H₀)),
            ((p.length + 1 : ℕ) : ℕ∞) ≤ B := by
          intro p
          obtain ⟨W, hW, hEx, _⟩ := hChainDichotomy p
          rcases hAvoid₀ W hW with hsub | hex
          · exact False.elim (hNoSing W hW hsub)
          · obtain ⟨q, hq_len⟩ := hEx hex
            rw [← hq_len]
            exact le_iSup
              (fun q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀) => (q.length : ℕ∞)) q
        have h1B : (1 : ℕ∞) ≤ B := by
          simpa using hStepAll (RelSeries.singleton _ C₀)
        exact WithBot.coe_le_coe.mpr (hBoundENat B h1B hStepAll)
      · have hMaxEq : max (B : WithBot ℕ∞) ((1 : ℕ) : WithBot ℕ∞) =
            ((max B 1 : ℕ∞) : WithBot ℕ∞) := by
          have h1 : ((1 : ℕ) : WithBot ℕ∞) = ((1 : ℕ∞) : WithBot ℕ∞) := rfl
          rw [h1]
          rcases le_total B 1 with h | h
          · rw [max_eq_right h, max_eq_right (WithBot.coe_le_coe.mpr h)]
          · rw [max_eq_left h, max_eq_left (WithBot.coe_le_coe.mpr h)]
        rw [hMaxEq]
        refine WithBot.coe_le_coe.mpr (hBoundENat (max B 1) (le_max_right B 1) fun p => ?_)
        obtain ⟨W, hW, hEx, hZero⟩ := hChainDichotomy p
        rcases hAvoid₀ W hW with hsub | hex
        · rw [hZero hsub]
          simp
        · obtain ⟨q, hq_len⟩ := hEx hex
          rw [← hq_len]
          exact le_trans
            (le_iSup
              (fun q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥Y₀) => (q.length : ℕ∞)) q)
            (le_max_left B 1)

  
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N' + 1 + 1)) k
  letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hClosedHyp : ∀ G : R, IsClosed (weilProjHyperplaneSet k (N' + 1) G) := by
    intro G
    exact (AlgebraicGeometry.Proj.basicOpen 𝒜 G).isOpen.isClosed_compl
  have hMemHyp : ∀ (q : ↥(weilProjectiveSpaceOver k (N' + 1)).left) (G : R),
      q ∈ weilProjHyperplaneSet k (N' + 1) G ↔
        G ∈ (q : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal := by
    intro q G
    exact (AlgebraicGeometry.Proj.mem_basicOpen 𝒜 G
      (q : ↥(AlgebraicGeometry.Proj 𝒜))).not.trans not_not
  have hNoeth : TopologicalSpace.NoetherianSpace ↥(weilProjectiveSpaceOver k (N' + 1)).left := by
    change TopologicalSpace.NoetherianSpace (ProjectiveSpectrum 𝒜)
    let f : ProjectiveSpectrum 𝒜 → PrimeSpectrum R :=
      fun x => ⟨x.asHomogeneousIdeal.toIdeal, x.isPrime⟩
    have hPre : ∀ s : Set R,
        ProjectiveSpectrum.zeroLocus 𝒜 s = f ⁻¹' PrimeSpectrum.zeroLocus s := by
      intro s
      ext x
      simp only [Set.mem_preimage, ProjectiveSpectrum.mem_zeroLocus, PrimeSpectrum.mem_zeroLocus]
      rfl
    have hf : Topology.IsInducing f := by
      refine Topology.IsInducing.mk (TopologicalSpace.ext_isClosed fun Z => ?_)
      rw [isClosed_induced_iff]
      refine ⟨?_, ?_⟩
      · intro hZ
        obtain ⟨s, rfl⟩ := (ProjectiveSpectrum.isClosed_iff_zeroLocus 𝒜 Z).mp hZ
        exact ⟨PrimeSpectrum.zeroLocus s, PrimeSpectrum.isClosed_zeroLocus s, (hPre s).symm⟩
      · rintro ⟨K, hK, rfl⟩
        obtain ⟨I, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal K).mp hK
        rw [← hPre (I : Set R)]
        exact ProjectiveSpectrum.isClosed_zeroLocus 𝒜 (I : Set R)
    rw [TopologicalSpace.noetherianSpace_iff_isCompact]
    intro s
    exact hf.isCompact_iff.mpr (TopologicalSpace.NoetherianSpace.isCompact (f '' s))

  
  let I₁ : Ideal R :=
    Ideal.span (MvPolynomial.X '' Set.range (Fin.succ : Fin (N' + 1) → Fin (N' + 1 + 1)))
  have hUnique : ∀ q : ProjectiveSpectrum 𝒜,
      (∀ β : Fin (N' + 1), (MvPolynomial.X β.succ : R) ∈ q.asHomogeneousIdeal.toIdeal) →
      q.asHomogeneousIdeal.toIdeal = I₁ := by
    intro q hq_succ
    have hI₁_le : I₁ ≤ q.asHomogeneousIdeal.toIdeal := by
      rw [Ideal.span_le]
      rintro _ ⟨_, ⟨β, rfl⟩, rfl⟩
      exact hq_succ β
    have hX0_not : (MvPolynomial.X 0 : R) ∉ q.asHomogeneousIdeal.toIdeal := by
      intro hX0
      have hUniv : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N' + 1 + 1)))) ≤
          q.asHomogeneousIdeal.toIdeal := by
        rw [Ideal.span_le]
        rintro _ ⟨α, _, rfl⟩
        exact Fin.cases hX0 hq_succ α
      apply q.not_irrelevant_le
      rw [HomogeneousIdeal.irrelevant_le]
      intro i hi f hf
      have hf_hom : f.IsHomogeneous i := (MvPolynomial.mem_homogeneousSubmodule i f).mp hf
      apply hUniv
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm_ne : f.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      have hdeg : m.degree = i := by
        by_contra hne
        exact hm_ne (hf_hom.coeff_eq_zero hne)
      rw [Finsupp.degree_eq_sum] at hdeg
      by_contra! hall0
      have hsum0 : (∑ α : Fin (N' + 1 + 1), m α) = 0 :=
        Finset.sum_eq_zero fun α _ => hall0 α (Set.mem_univ α)
      omega
    have hHom_mem : ∀ (d : ℕ) (Pd : R),
        Pd ∈ 𝒜 d → Pd ∈ q.asHomogeneousIdeal.toIdeal → Pd ∈ I₁ := by
      intro d Pd hPd hPd_q
      have hPd_hom : Pd.IsHomogeneous d := (MvPolynomial.mem_homogeneousSubmodule d Pd).mp hPd
      let s₀ : Fin (N' + 1 + 1) →₀ ℕ := Finsupp.single 0 d
      let a_d : k := Pd.coeff s₀
      let Q : R := Pd - MvPolynomial.C a_d * (MvPolynomial.X 0 : R) ^ d
      have hMon : (MvPolynomial.C a_d * (MvPolynomial.X 0 : R) ^ d) = MvPolynomial.monomial s₀ a_d :=
        MvPolynomial.C_mul_X_pow_eq_monomial
      have hQ_I₁ : Q ∈ I₁ := by
        dsimp [I₁]
        rw [MvPolynomial.mem_ideal_span_X_image]
        intro m hm
        have hQm : Q.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
        have hm_ne_s0 : m ≠ s₀ := by
          rintro rfl
          apply hQm
          dsimp [Q]
          rw [hMon, MvPolynomial.coeff_sub, MvPolynomial.coeff_monomial]
          simp [a_d]
        have hPdm : Pd.coeff m ≠ 0 := by
          have hsub : Q.coeff m = Pd.coeff m := by
            dsimp [Q]
            rw [hMon, MvPolynomial.coeff_sub, MvPolynomial.coeff_monomial]
            simp [hm_ne_s0.symm]
          rwa [← hsub]
        have hdeg : m.degree = d := by
          by_contra hne
          exact hPdm (hPd_hom.coeff_eq_zero hne)
        by_contra! hall0
        have hall_succ : ∀ β : Fin (N' + 1), m β.succ = 0 :=
          fun β => hall0 β.succ ⟨β, rfl⟩
        have hsum_univ : (∑ α : Fin (N' + 1 + 1), m α) = d := by
          rwa [Finsupp.degree_eq_sum] at hdeg
        rw [Fin.sum_univ_succ, Finset.sum_eq_zero (fun β _ => hall_succ β), add_zero] at hsum_univ
        apply hm_ne_s0
        ext α
        refine Fin.cases ?_ (fun β => ?_) α
        · simp [s₀, hsum_univ]
        · simp [s₀, hall_succ β, Fin.succ_ne_zero]
      have hTerm_q :
          MvPolynomial.C a_d * (MvPolynomial.X 0 : R) ^ d ∈ q.asHomogeneousIdeal.toIdeal := by
        have hEq : MvPolynomial.C a_d * (MvPolynomial.X 0 : R) ^ d = Pd - Q := by
          dsimp [Q]; ring
        rw [hEq]
        exact q.asHomogeneousIdeal.toIdeal.sub_mem hPd_q (hI₁_le hQ_I₁)
      have had0 : a_d = 0 := by
        by_contra had_ne
        have hPow_q : ((MvPolynomial.X 0 : R) ^ d) ∈ q.asHomogeneousIdeal.toIdeal := by
          have hmul := q.asHomogeneousIdeal.toIdeal.mul_mem_left (MvPolynomial.C a_d⁻¹) hTerm_q
          rwa [← mul_assoc, ← map_mul, inv_mul_cancel₀ had_ne, map_one, one_mul] at hmul
        exact hX0_not (q.isPrime.mem_of_pow_mem d hPow_q)
      have hPd_eq : Pd = Q := by
        dsimp [Q]
        rw [had0, map_zero, zero_mul, sub_zero]
      rwa [hPd_eq]
    refine le_antisymm ?_ hI₁_le
    obtain ⟨S_hom, hEqSpan⟩ :=
      (Ideal.IsHomogeneous.iff_exists 𝒜 q.asHomogeneousIdeal.toIdeal).mp
        q.asHomogeneousIdeal.isHomogeneous
    rw [hEqSpan, Ideal.span_le]
    rintro _ ⟨⟨x, ⟨d, hxd⟩⟩, hxS, rfl⟩
    have hx_q : x ∈ q.asHomogeneousIdeal.toIdeal := by
      rw [hEqSpan]
      exact Ideal.subset_span ⟨⟨x, ⟨d, hxd⟩⟩, hxS, rfl⟩
    exact hHom_mem d x hxd hx_q

  have hq_star_I₁ : (q_star : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal = I₁ :=
    hUnique q_star fun β => (hMemHyp q_star _).mp (hq_pt β)

  have hAvoidPt : ∀ y : ↥(weilProjectiveSpaceOver k (N' + 1)).left, y ≠ q_star →
      ∃ L : MvPolynomial (Fin (N' + 1)) k,
        L ≠ 0 ∧
        ∀ c' : Fin (N' + 1) → k,
          MvPolynomial.eval c' L ≠ 0 →
          y ∉ weilProjHyperplaneSet k (N' + 1) (F_pt c') := by
    intro y hy_ne
    have hex_β : ∃ β₀ : Fin (N' + 1),
        (MvPolynomial.X β₀.succ : R) ∉ (y : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal := by
      by_contra! hall_y
      apply hy_ne
      exact ProjectiveSpectrum.ext (HomogeneousIdeal.ext
        ((hUnique y hall_y).trans hq_star_I₁.symm))
    obtain ⟨β₀, hβ₀⟩ := hex_β
    obtain ⟨L, hL_ne, hL_avoid⟩ :=
      hIdealAvoid (y : ProjectiveSpectrum 𝒜).asHomogeneousIdeal.toIdeal β₀ hβ₀
    refine ⟨L, hL_ne, fun c' hc' hyH => ?_⟩
    exact hL_avoid c' hc' ((hMemHyp y (F_pt c')).mp hyH)

  
  have hDecomp : ∀ a : Fin p, ∃ S_a : Finset (Set ↥(weilProjectiveSpaceOver k (N' + 1)).left),
      (∀ W ∈ S_a, IsClosed W ∧ IsIrreducible W) ∧ Y a = ⋃ W ∈ S_a, W := by
    intro a
    obtain ⟨S_raw, hFin, hCl, hIrr, hEq⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible (hY a)
    refine ⟨hFin.toFinset, ?_, ?_⟩
    · intro W hW
      have hW_raw : W ∈ S_raw := hFin.mem_toFinset.mp hW
      exact ⟨hCl W hW_raw, hIrr W hW_raw⟩
    · rw [hEq, Set.sUnion_eq_biUnion]
      ext x
      simp only [Set.mem_iUnion, hFin.mem_toFinset]

  let S_fin : Fin p → Finset (Set ↥(weilProjectiveSpaceOver k (N' + 1)).left) :=
    fun a => Classical.choose (hDecomp a)
  have hS_fin : ∀ (a : Fin p) (W : Set ↥(weilProjectiveSpaceOver k (N' + 1)).left),
      W ∈ S_fin a → IsClosed W ∧ IsIrreducible W :=
    fun a => (Classical.choose_spec (hDecomp a)).1
  have hY_eq : ∀ a : Fin p, Y a = ⋃ W ∈ S_fin a, W :=
    fun a => (Classical.choose_spec (hDecomp a)).2

  let L_wit : ∀ (a : Fin p), ↥(S_fin a) → MvPolynomial (Fin (N' + 1)) k :=
    fun a W =>
      if h : ∃ y ∈ W.1, y ≠ q_star then
        Classical.choose (hAvoidPt (Classical.choose h) (Classical.choose_spec h).2)
      else 1

  have hL_ne : ∀ (a : Fin p) (W : ↥(S_fin a)), L_wit a W ≠ 0 := by
    intro a W
    dsimp [L_wit]
    split_ifs with h
    · exact (Classical.choose_spec
        (hAvoidPt (Classical.choose h) (Classical.choose_spec h).2)).1
    · exact one_ne_zero

  let Δ_closed : MvPolynomial (Fin (N' + 1)) k :=
    ∏ a : Fin p, ∏ W ∈ (S_fin a).attach, L_wit a W

  have hΔ_ne : Δ_closed ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr fun a _ =>
      Finset.prod_ne_zero_iff.mpr fun W _ => hL_ne a W

  refine ⟨Δ_closed, hΔ_ne, fun c' hc' a => ?_⟩
  simp only [Δ_closed, map_prod] at hc'
  rw [Finset.prod_ne_zero_iff] at hc'
  have hc'_a := hc' a (Finset.mem_univ a)
  rw [Finset.prod_ne_zero_iff] at hc'_a
  have hAvoid_a : ∀ W ∈ S_fin a,
      W ⊆ {q_star} ∨ ∃ z ∈ W, z ∉ weilProjHyperplaneSet k (N' + 1) (F_pt c') := by
    intro W hW
    by_cases h : ∃ y ∈ W, y ≠ q_star
    · right
      have hEv : MvPolynomial.eval c' (L_wit a ⟨W, hW⟩) ≠ 0 :=
        hc'_a ⟨W, hW⟩ (Finset.mem_attach _ ⟨W, hW⟩)
      have hL_eq : L_wit a ⟨W, hW⟩ =
          Classical.choose (hAvoidPt (Classical.choose h) (Classical.choose_spec h).2) := by
        dsimp only [L_wit]
        exact dite_eq_left_of_eq_true (eq_true h)
      rw [hL_eq] at hEv
      exact ⟨Classical.choose h, (Classical.choose_spec h).1,
        (Classical.choose_spec
          (hAvoidPt (Classical.choose h) (Classical.choose_spec h).2)).2 c' hEv⟩
    · left
      intro y hy
      refine Set.mem_singleton_iff.mpr ?_
      by_contra hy_ne
      exact h ⟨y, hy, hy_ne⟩
  exact hKrullBounds q_star (Y a) (weilProjHyperplaneSet k (N' + 1) (F_pt c'))
    (hClosedHyp (F_pt c')) (S_fin a) (hS_fin a) (hY_eq a) hAvoid_a

theorem weil_pointed_tangent_frame_single_prime_eliminant (k : Type u) [Field k]
    (N' d ν : ℕ) (hd : 1 ≤ d)
    (R : Type u) [CommRing R]
    (κ : k →+* R)
    (f_val : Fin ν → R)
    (v : Matrix (Fin (N' + 1)) (Fin d) R)
    (U_mat : Matrix (Fin d) (Fin (N' + 1)) (R ⧸ Ideal.span (Set.range f_val)))
    (hUv : U_mat * v.map (Ideal.Quotient.mk (Ideal.span (Set.range f_val))) = 1)
    (𝔭 : Ideal R) [h𝔭 : 𝔭.IsPrime]
    (h_mem : ∀ j : Fin ν, f_val j ∈ 𝔭) :
    ∃ (Δ_star : MvPolynomial (Fin (N' + 1)) k) (γ₀ : Fin d),
      Δ_star ≠ 0 ∧
      ∀ c' : Fin (N' + 1) → k,
        MvPolynomial.eval c' Δ_star ≠ 0 →
        ∑ β : Fin (N' + 1), κ (c' β) * v β γ₀ ∉ 𝔭 :=
by
  classical
  let I_sl : Ideal R := Ideal.span (Set.range f_val)
  have h_le : I_sl ≤ 𝔭 := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact h_mem j
  let Q := R ⧸ 𝔭
  let π_I : R →+* R ⧸ I_sl := Ideal.Quotient.mk I_sl
  let π_Q : R →+* Q := Ideal.Quotient.mk 𝔭
  let π_fac : R ⧸ I_sl →+* Q := Ideal.Quotient.factor h_le
  let γ₀ : Fin d := ⟨0, hd⟩
  have h_diag : ∑ β : Fin (N' + 1), π_fac (U_mat γ₀ β) * π_Q (v β γ₀) = (1 : Q) := by
    have h1 : (U_mat * v.map π_I) γ₀ γ₀ = 1 := by
      rw [hUv, Matrix.one_apply_eq]
    have h2 := congrArg π_fac h1
    rw [Matrix.mul_apply, map_sum, map_one] at h2
    refine Eq.trans ?_ h2
    refine Finset.sum_congr rfl fun β _ => ?_
    rw [map_mul, Matrix.map_apply]
    dsimp [π_fac, π_I, π_Q]
    rw [Ideal.Quotient.factor_mk]
  have h_ex : ∃ β₁ : Fin (N' + 1), π_Q (v β₁ γ₀) ≠ 0 := by
    by_contra! h_zero
    have h0 : ∑ β : Fin (N' + 1), π_fac (U_mat γ₀ β) * π_Q (v β γ₀) = 0 :=
      Finset.sum_eq_zero fun β _ => by rw [h_zero β, mul_zero]
    rw [h_diag] at h0
    exact one_ne_zero h0
  obtain ⟨β₁, hβ₁⟩ := h_ex
  letI : Algebra k Q := (π_Q.comp κ).toAlgebra
  have h_notMem : π_Q (v β₁ γ₀) ∉ (⊥ : Submodule k Q) := by
    rw [Submodule.mem_bot]
    exact hβ₁
  obtain ⟨φ_lin, hφ_ne, -⟩ := Submodule.exists_le_ker_of_notMem h_notMem
  let Δ_star : MvPolynomial (Fin (N' + 1)) k :=
    ∑ β : Fin (N' + 1), MvPolynomial.C (φ_lin (π_Q (v β γ₀))) * MvPolynomial.X β
  have h_eval : ∀ c' : Fin (N' + 1) → k,
      MvPolynomial.eval c' Δ_star = ∑ β : Fin (N' + 1), φ_lin (π_Q (v β γ₀)) * c' β := by
    intro c'
    dsimp [Δ_star]
    rw [map_sum]
    refine Finset.sum_congr rfl fun β _ => ?_
    rw [map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
  have hΔ_ne : Δ_star ≠ 0 := by
    intro h0
    let e₁ : Fin (N' + 1) → k := fun β => if β = β₁ then 1 else 0
    have hev : MvPolynomial.eval e₁ Δ_star = 0 := by
      rw [h0, map_zero]
    rw [h_eval] at hev
    have hsum : (∑ β : Fin (N' + 1), φ_lin (π_Q (v β γ₀)) * e₁ β) =
        φ_lin (π_Q (v β₁ γ₀)) := by
      rw [Finset.sum_eq_single β₁]
      · dsimp [e₁]
        rw [if_pos rfl, mul_one]
      · intro β _ hβ
        dsimp [e₁]
        rw [if_neg hβ, mul_zero]
      · intro h_abs
        exact False.elim (h_abs (Finset.mem_univ β₁))
    rw [hsum] at hev
    exact hφ_ne hev
  refine ⟨Δ_star, γ₀, hΔ_ne, fun c' h_ev_ne h_in_p => ?_⟩
  have hQ_zero : π_Q (∑ β : Fin (N' + 1), κ (c' β) * v β γ₀) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr h_in_p
  have hQ_smul : π_Q (∑ β : Fin (N' + 1), κ (c' β) * v β γ₀) =
      ∑ β : Fin (N' + 1), c' β • π_Q (v β γ₀) := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun β _ => ?_
    rw [map_mul, Algebra.smul_def]
    rfl
  rw [hQ_smul] at hQ_zero
  have hφ_zero := congrArg φ_lin hQ_zero
  rw [map_sum, map_zero] at hφ_zero
  have hφ_eq : (∑ β : Fin (N' + 1), φ_lin (c' β • π_Q (v β γ₀))) =
      MvPolynomial.eval c' Δ_star := by
    rw [h_eval]
    refine Finset.sum_congr rfl fun β _ => ?_
    rw [LinearMap.map_smul, smul_eq_mul, mul_comm]
  rw [hφ_eq] at hφ_zero
  exact h_ev_ne hφ_zero

theorem weil_mvPolynomial_normalized_away_localization (k : Type u) [Field k]
    (s₀ ν d : ℕ)
    (R₀ R₁ : Type u) [CommRing R₀] [CommRing R₁] [Algebra R₀ R₁]
    (g₀ : R₀) [IsLocalization.Away g₀ R₁]
    (φ₀ : MvPolynomial (Fin (s₀ + ν + d)) k →+* R₀)
    (hSurj₀ : Function.Surjective φ₀)
    (q₀ : Fin s₀ → MvPolynomial (Fin (s₀ + ν + d)) k)
    (hKer₀ : RingHom.ker φ₀ = Ideal.span (Set.range q₀))
    (f_lift₀ : Fin ν → MvPolynomial (Fin (s₀ + ν + d)) k)
    (hDet_q₀ : IsUnit (Matrix.det (Matrix.of fun a b : Fin s₀ =>
      φ₀ (MvPolynomial.pderiv (Fin.castAdd d (Fin.castAdd ν b)) (q₀ a)))))
    (hDet_qf₀ : IsUnit (Matrix.det (Matrix.of fun a b : Fin (s₀ + ν) =>
      φ₀ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q₀ f_lift₀ a))))) :
    ∃ (φ₁ : MvPolynomial (Fin ((s₀ + 1) + ν + d)) k →+* R₁)
      (q₁ : Fin (s₀ + 1) → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
      (f_lift₁ : Fin ν → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k),
      Function.Surjective φ₁ ∧
      φ₁.comp MvPolynomial.C = (algebraMap R₀ R₁).comp (φ₀.comp MvPolynomial.C) ∧
      RingHom.ker φ₁ = Ideal.span (Set.range q₁) ∧
      (∀ j : Fin ν, φ₁ (f_lift₁ j) = algebraMap R₀ R₁ (φ₀ (f_lift₀ j))) ∧
      IsUnit (Matrix.det (Matrix.of fun a b : Fin (s₀ + 1) =>
        φ₁ (MvPolynomial.pderiv (Fin.castAdd d (Fin.castAdd ν b)) (q₁ a)))) ∧
      IsUnit (Matrix.det (Matrix.of fun a b : Fin ((s₀ + 1) + ν) =>
        φ₁ (MvPolynomial.pderiv (Fin.castAdd d b) (Fin.addCases q₁ f_lift₁ a)))) ∧
      (∀ (U_poly f_pt : MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
         (γ₀ : Fin d) (𝔭 : Ideal R₁) [𝔭.IsPrime],
        IsUnit (φ₁ U_poly) →
        φ₁ f_pt ∈ 𝔭 →
        Matrix.det (Matrix.of fun a b : Fin ((s₀ + 1) + ν + 1) =>
          φ₁ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin ((s₀ + 1) + ν + d))
              (Fin.castAdd d) (Fin.natAdd ((s₀ + 1) + ν) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
                q₁ f_lift₁)
              f_pt a))) ∉ 𝔭 →
        Matrix.det (Matrix.of fun a b : Fin ((s₀ + 1) + ν + 1) =>
          φ₁ (MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin ((s₀ + 1) + ν + d))
              (Fin.castAdd d) (Fin.natAdd ((s₀ + 1) + ν) γ₀) b)
            (Fin.snoc (α := fun _ => MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
              (Fin.addCases (motive := fun _ => MvPolynomial (Fin ((s₀ + 1) + ν + d)) k)
                q₁ f_lift₁)
              (U_poly * f_pt) a))) ∉ 𝔭) :=
by
  classical
  have hDetDiag :
      ∀ {A : Type u} [CommRing A] {m : ℕ} (M : Matrix (Fin (m + 1)) (Fin (m + 1)) A)
        (k₀ : Fin (m + 1)),
        (∀ i : Fin (m + 1), i ≠ k₀ → M i k₀ = 0) →
        M.det = M k₀ k₀ * (M.submatrix k₀.succAbove k₀.succAbove).det := by
    intro A _ m M k₀ hZero
    rw [Matrix.det_succ_column M k₀, Finset.sum_eq_single k₀]
    · have hsign : (-1 : A) ^ ((k₀ : ℕ) + (k₀ : ℕ)) = 1 := by
        rw [← two_mul, pow_mul, neg_one_sq, one_pow]
      rw [hsign, one_mul]
    · intro i _ hi
      rw [hZero i hi, mul_zero, zero_mul]
    · intro hk₀
      exact absurd (Finset.mem_univ k₀) hk₀
  obtain ⟨g_poly, hg_poly⟩ := hSurj₀ g₀
  let e_fin : Fin ((s₀ + ν + d) + 1) ≃ Fin ((s₀ + 1) + ν + d) := finCongr (by omega)
  let z_slot : Fin ((s₀ + 1) + ν + d) := Fin.castAdd d (Fin.castAdd ν (Fin.last s₀))
  let p_slot : Fin ((s₀ + ν + d) + 1) := e_fin.symm z_slot
  let ι_old : Fin (s₀ + ν + d) → Fin ((s₀ + 1) + ν + d) :=
    fun β => e_fin (p_slot.succAbove β)
  have hInj_old : Function.Injective ι_old :=
    e_fin.injective.comp Fin.succAbove_right_injective
  have hz_eq : e_fin p_slot = z_slot := e_fin.apply_symm_apply z_slot
  have hp_val : (p_slot : ℕ) = s₀ := by
    change (z_slot : ℕ) = s₀
    simp [z_slot]
  have hι_lt : ∀ β : Fin (s₀ + ν + d), (β : ℕ) < s₀ → (ι_old β : ℕ) = (β : ℕ) := by
    intro β hβ
    have hlt : β.castSucc < p_slot := Fin.lt_def.mpr (by simpa [hp_val] using hβ)
    change (p_slot.succAbove β : ℕ) = (β : ℕ)
    rw [Fin.succAbove_of_castSucc_lt p_slot β hlt]
    rfl
  have hι_ge : ∀ β : Fin (s₀ + ν + d), s₀ ≤ (β : ℕ) → (ι_old β : ℕ) = (β : ℕ) + 1 := by
    intro β hβ
    have hle : p_slot ≤ β.castSucc := Fin.le_def.mpr (by simpa [hp_val] using hβ)
    change (p_slot.succAbove β : ℕ) = (β : ℕ) + 1
    rw [Fin.succAbove_of_le_castSucc p_slot β hle]
    rfl
  let v_val : Fin ((s₀ + 1) + ν + d) → R₁ :=
    fun n => p_slot.insertNth (α := fun _ => R₁)
      (IsLocalization.Away.invSelf (S := R₁) g₀)
      (fun β => algebraMap R₀ R₁ (φ₀ (MvPolynomial.X β)))
      (e_fin.symm n)
  let φ₁ : MvPolynomial (Fin ((s₀ + 1) + ν + d)) k →+* R₁ :=
    MvPolynomial.eval₂Hom ((algebraMap R₀ R₁).comp (φ₀.comp MvPolynomial.C)) v_val
  let q₁ : Fin (s₀ + 1) → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k :=
    Fin.snoc (fun a => MvPolynomial.rename ι_old (q₀ a))
      (MvPolynomial.rename ι_old g_poly * MvPolynomial.X z_slot - 1)
  let f_lift₁ : Fin ν → MvPolynomial (Fin ((s₀ + 1) + ν + d)) k :=
    fun j => MvPolynomial.rename ι_old (f_lift₀ j)
  have hφ₁_C : φ₁.comp MvPolynomial.C = (algebraMap R₀ R₁).comp (φ₀.comp MvPolynomial.C) := by
    ext c
    exact MvPolynomial.eval₂Hom_C _ _ c
  have hφ₁_z : φ₁ (MvPolynomial.X z_slot) = IsLocalization.Away.invSelf (S := R₁) g₀ := by
    simp only [φ₁, MvPolynomial.eval₂Hom_X']
    dsimp [v_val]
    change p_slot.insertNth (α := fun _ => R₁)
      (IsLocalization.Away.invSelf (S := R₁) g₀)
      (fun β => algebraMap R₀ R₁ (φ₀ (MvPolynomial.X β))) p_slot = _
    exact p_slot.insertNth_apply_same _ _
  have hφ₁_old_X : ∀ β : Fin (s₀ + ν + d),
      φ₁ (MvPolynomial.X (ι_old β)) = algebraMap R₀ R₁ (φ₀ (MvPolynomial.X β)) := by
    intro β
    simp only [φ₁, MvPolynomial.eval₂Hom_X']
    dsimp [v_val, ι_old]
    rw [e_fin.symm_apply_apply]
    exact p_slot.insertNth_apply_succAbove _ _ β
  have hφ₁_ren_hom :
      φ₁.comp (MvPolynomial.rename ι_old).toRingHom = (algebraMap R₀ R₁).comp φ₀ := by
    apply MvPolynomial.ringHom_ext'
    · ext c
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.rename_C]
      exact RingHom.congr_fun hφ₁_C c
    · intro β
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        MvPolynomial.rename_X]
      exact hφ₁_old_X β
  have hφ₁_ren : ∀ P : MvPolynomial (Fin (s₀ + ν + d)) k,
      φ₁ (MvPolynomial.rename ι_old P) = algebraMap R₀ R₁ (φ₀ P) :=
    fun P => RingHom.congr_fun hφ₁_ren_hom P
