      let toTop_a := weilCupPDTraceOpenSubobjToTop X.left (weilEtaleIdTerminal X.left) (V a)
      have hL := DFunLike.congr_fun (hF_gl (r + 1) a) z_a
      have hR := DFunLike.congr_fun (hF_gl r a)
        (weilEtaleLocalTorsionTransition X.left ℓ r
          (weilCupPDTraceOpenSubobj X.left (weilEtaleIdTerminal X.left) (V a)) (2 * d) z_a)
      simp only [AddMonoidHom.comp_apply] at hL hR ⊢
      change ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))
          (F_gl (r + 1) (weilEtaleLocalTorsionMapH X.left (ℓ ^ (r + 1)) toTop_a (2 * d) z_a)) =
        F_gl r (weilEtaleLocalTorsionTransition X.left ℓ r (weilEtaleIdTerminal X.left) (2 * d)
          (weilEtaleLocalTorsionMapH X.left (ℓ ^ (r + 1)) toTop_a (2 * d) z_a))
      rw [hL, hMapTrans_X ℓ r (2 * d) toTop_a z_a, hR]
      exact hτ_trans
        (weilCupPDTraceOpenSubobj X.left (weilEtaleIdTerminal X.left) (V a))
        (hV_aff a) (u_cov a) (hu_cov a).1 (hu_cov_OX a) r z_a
    let z_T := (e_TX (r + 1)).symm w
    have hw_eq :
        weilEtaleLocalTorsionCounitH X.left (ℓ ^ (r + 1)) (weilEtaleIdTerminal X.left) (2 * d) z_T =
          w :=
      (e_TX (r + 1)).apply_symm_apply w
    rw [← hw_eq, htr_counit_TX (r + 1) z_T, hCounitTrans_X, htr_counit_TX r]
    exact DFunLike.congr_fun hF_trans z_T
  · intro U widetilde_U u e hRoof hu_et he_chart r z
    have hAff_U : AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).left := hRoof.2.2.1
    have hu_hom : u ≫ (weilAffineSpaceOver k d).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).hom ≫ X.hom := by
      rw [← hιd_hom, ← CategoryTheory.Category.assoc, ← he_chart,
        CategoryTheory.Category.assoc, hRoof.2.2.2]
    rw [← hτ_roof U hAff_U u hu_et hu_hom widetilde_U u e hRoof hu_et he_chart r z]
    let p_U : ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).left ⟶ X.left :=
      ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).hom
    let V_U : Fin M → ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).left.Opens :=
      fun a => (TopologicalSpace.Opens.map p_U.base).obj (V a)
    have hVU_sup : (⨆ a : Fin M, V_U a) = ⊤ := by
      apply le_antisymm le_top
      intro x _
      have hx : p_U.base x ∈ (⊤ : X.left.Opens) := trivial
      rw [← hV_sup, TopologicalSpace.Opens.mem_iSup] at hx
      rcases hx with ⟨a, ha⟩
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩
    have hVU_inter_aff : ∀ (I : Finset (Fin M)), I.Nonempty →
        AlgebraicGeometry.IsAffineOpen (⨅ a ∈ I, V_U a) := by
      intro I hI
      have hEq_pre : (⨅ a ∈ I, V_U a) =
          (TopologicalSpace.Opens.map p_U.base).obj (⨅ a ∈ I, V a) := by
        induction hI using Finset.Nonempty.cons_induction with
        | singleton a =>
          rw [hSing_inf V_U a, hSing_inf V a]
        | cons a s has hs ih =>
          have h1 : (⨅ b ∈ Finset.cons a s has, V_U b) = V_U a ⊓ (⨅ b ∈ s, V_U b) := by
            rw [Finset.cons_eq_insert]
            apply le_antisymm
            · exact le_inf (iInf₂_le a (Finset.mem_insert_self a s))
                (le_iInf₂ fun b hb => iInf₂_le b (Finset.mem_insert_of_mem hb))
            · refine le_iInf₂ fun b hb => ?_
              rcases Finset.mem_insert.mp hb with rfl | hbs
              · exact inf_le_left
              · exact inf_le_right.trans (iInf₂_le b hbs)
          have h2 : (⨅ b ∈ Finset.cons a s has, V b) = V a ⊓ (⨅ b ∈ s, V b) := by
            rw [Finset.cons_eq_insert]
            apply le_antisymm
            · exact le_inf (iInf₂_le a (Finset.mem_insert_self a s))
                (le_iInf₂ fun b hb => iInf₂_le b (Finset.mem_insert_of_mem hb))
            · refine le_iInf₂ fun b hb => ?_
              rcases Finset.mem_insert.mp hb with rfl | hbs
              · exact inf_le_left
              · exact inf_le_right.trans (iInf₂_le b hbs)
          rw [h1, h2, ih]
          rfl
      rw [hEq_pre]
      exact @hV_pre ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).left hAff_U p_U I hI
    have hVan_U : ∀ (I : Finset (Fin M)), I.Nonempty → ∀ q : ℕ, 2 * d < q →
        Subsingleton
          (weilEtaleLocalTorsionH X.left (ℓ ^ r)
            (weilCupPDTraceOpenSubobj X.left U (⨅ a ∈ I, V_U a)) q) := by
      intro I hI q hq
      let U_I := weilCupPDTraceOpenSubobj X.left U (⨅ a ∈ I, V_U a)
      have hAff_UI : AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U_I).left := hVU_inter_aff I hI
      have hEt_uUI : AlgebraicGeometry.Etale ((⨅ a ∈ I, V_U a).ι ≫ u) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (⨅ a ∈ I, V_U a).ι u inferInstance hu_et
      have huUI_raw : ((⨅ a ∈ I, V_U a).ι ≫ u) ≫ (weilAffineSpaceOver k d).hom =
          ((⨅ a ∈ I, V_U a).ι ≫ ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).hom) ≫
            X.hom := by
        rw [CategoryTheory.Category.assoc, hu_hom, CategoryTheory.Category.assoc]
      exact hτ_van U_I hAff_UI ((⨅ a ∈ I, V_U a).ι ≫ u) hEt_uUI huUI_raw r q hq
    have hEq_on_U :
        (tr r).comp (weilEtaleLocalTorsionCounitH X.left (ℓ ^ r) U (2 * d)) =
          τ_sys U hAff_U u hu_et hu_hom r := by
      refine (hOpenDesc_X (ℓ ^ r) (2 * d) M U V_U hVU_sup hVan_U).1 _ _ (fun a => ?_)
      ext z_a
      let U_a := weilCupPDTraceOpenSubobj X.left U (V_U a)
      let toTop_Ua := weilCupPDTraceOpenSubobjToTop X.left U (V_U a)
      have hAff_Ua : AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U_a).left := by
        change AlgebraicGeometry.IsAffine (V_U a).toScheme
        rw [← hSing_inf V_U a]
        exact hVU_inter_aff {a} (Finset.singleton_nonempty a)
      have hEt_uUa : AlgebraicGeometry.Etale ((V_U a).ι ≫ u) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (V_U a).ι u inferInstance hu_et
      have huUa_raw : ((V_U a).ι ≫ u) ≫ (weilAffineSpaceOver k d).hom =
          ((V_U a).ι ≫ ((AlgebraicGeometry.Scheme.Etale.forget X.left).obj U).hom) ≫ X.hom := by
        rw [CategoryTheory.Category.assoc, hu_hom, CategoryTheory.Category.assoc]
      have hrange_qa : Set.range ((V_U a).ι ≫ p_U).base ⊆ Set.range (V a).ι.base := by
        rw [(V a).range_ι]
        rintro _ ⟨y, rfl⟩
        have hy : (V_U a).ι.base y ∈ Set.range (V_U a).ι.base := ⟨y, rfl⟩
        rw [(V_U a).range_ι] at hy
        exact hy
      let q_sch : (V_U a).toScheme ⟶ (V a).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (V a).ι ((V_U a).ι ≫ p_U) hrange_qa
      have hq_fac : q_sch ≫ (V a).ι = (V_U a).ι ≫ p_U :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _
      let q_a : U_a ⟶ weilCupPDTraceOpenSubobj X.left (weilEtaleIdTerminal X.left) (V a) :=
        CategoryTheory.MorphismProperty.Over.homMk q_sch (by
          change q_sch ≫ ((V a).ι ≫ 𝟙 X.left) = (V_U a).ι ≫ p_U
          rw [CategoryTheory.Category.comp_id, hq_fac])
      let toTop_TX_a := weilCupPDTraceOpenSubobjToTop X.left (weilEtaleIdTerminal X.left) (V a)
      have hLHS :
          (((tr r).comp (weilEtaleLocalTorsionCounitH X.left (ℓ ^ r) U (2 * d))).comp
            (weilEtaleLocalTorsionMapH X.left (ℓ ^ r) toTop_Ua (2 * d))) z_a =
          τ_sys U_a hAff_Ua ((V_U a).ι ≫ u) hEt_uUa huUa_raw r z_a := by
        simp only [AddMonoidHom.comp_apply, hCounitMap_X]
        rw [← hCounitMap_X (ℓ ^ r) (2 * d) q_a z_a,
          ← hCounitMap_X (ℓ ^ r) (2 * d) toTop_TX_a _,
          htr_counit_TX r]
        have h1 := DFunLike.congr_fun (hF_gl r a)
          (weilEtaleLocalTorsionMapH X.left (ℓ ^ r) q_a (2 * d) z_a)
        have h2 := DFunLike.congr_fun
          (hτ_cov q_a hAff_Ua (hV_aff a) ((V_U a).ι ≫ u) (u_cov a) hEt_uUa (hu_cov a).1
            huUa_raw (hu_cov_OX a) r) z_a
        simp only [AddMonoidHom.comp_apply] at h1 h2
        exact h1.trans h2
      have hRHS :
          ((τ_sys U hAff_U u hu_et hu_hom r).comp
            (weilEtaleLocalTorsionMapH X.left (ℓ ^ r) toTop_Ua (2 * d))) z_a =
          τ_sys U_a hAff_Ua ((V_U a).ι ≫ u) hEt_uUa huUa_raw r z_a :=
        DFunLike.congr_fun
          (hτ_cov toTop_Ua hAff_Ua hAff_U ((V_U a).ι ≫ u) u hEt_uUa hu_et huUa_raw hu_hom r) z_a
      exact hLHS.trans hRHS.symm
    exact DFunLike.congr_fun hEq_on_U z

theorem weil_etale_local_torsion_bockstein_exact (S : AlgebraicGeometry.Scheme.{u})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (U : S.Etale) (q : ℕ), Subsingleton (weilEtaleLocalTorsionH S 1 U q)) ∧
    ∀ (r q : ℕ),
      (∀ {U₁ U₂ : S.Etale} (v : Quiver.Hom U₁ U₂)
          (z : weilEtaleLocalTorsionH S (ℓ ^ (r + 1)) U₁ q),
        weilEtaleLocalTorsionTransition S ℓ r U₂ q
          (weilEtaleLocalTorsionMapH S (ℓ ^ (r + 1)) v q z) =
        weilEtaleLocalTorsionMapH S (ℓ ^ r) v q
          (weilEtaleLocalTorsionTransition S ℓ r U₁ q z)) ∧
      ∃ (ι_bock : ∀ W : S.Etale,
          weilEtaleLocalTorsionH S ℓ W q →+ weilEtaleLocalTorsionH S (ℓ ^ (r + 1)) W q),
        (∀ {U₁ U₂ : S.Etale} (v : Quiver.Hom U₁ U₂)
            (x : weilEtaleLocalTorsionH S ℓ U₁ q),
          weilEtaleLocalTorsionMapH S (ℓ ^ (r + 1)) v q (ι_bock U₁ x) =
            ι_bock U₂ (weilEtaleLocalTorsionMapH S ℓ v q x)) ∧
        (∀ (W : S.Etale) (y : weilEtaleLocalTorsionH S (ℓ ^ (r + 1)) W q),
          weilEtaleLocalTorsionTransition S ℓ r W q y = 0 →
          ∃ x : weilEtaleLocalTorsionH S ℓ W q, ι_bock W x = y) :=
by
  classical
  let J := S.smallEtaleTopology
  let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let AM : ℕ → AddCommGrpCat.{u} := fun m =>
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))

  have hEquiv_comp :
      ∀ {W : S.Etale} {M : AddCommGrpCat.{u}}
        {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (α : CategoryTheory.Sheaf.freeYoneda J W M ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro W M F G α g
    let α' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W M) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ G)
            (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hSub1 : ∀ (U : S.Etale) (q : ℕ), Subsingleton (weilEtaleLocalTorsionH S 1 U q) := by
    intro U q
    let L₁ := weilEtaleLocalTorsionSheaf S 1 U
    have hAM1_zero : (𝟙 (AM 1) : AM 1 ⟶ AM 1) = 0 := by
      apply AddCommGrpCat.ext
      rintro ⟨b⟩
      exact congrArg ULift.up (Subsingleton.elim b 0)
    have hIdZero : (𝟙 L₁ : L₁ ⟶ L₁) = 0 := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have hHom0 : ∀ (g : AM 1 ⟶ L₁.obj.obj (Opposite.op U)), g = 0 := fun g => by
        rw [← CategoryTheory.Category.id_comp g, hAM1_zero, Limits.zero_comp]
      exact (hHom0 _).trans (hHom0 _).symm
    have hz : ∀ z : weilEtaleLocalTorsionH S 1 U q, z = 0 := by
      intro z
      calc
        z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 L₁)) (Nat.add_zero q) :=
          (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
        _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (0 : L₁ ⟶ L₁)) (Nat.add_zero q) := by
          rw [hIdZero]
        _ = z.comp 0 (Nat.add_zero q) := by
          rw [CategoryTheory.Abelian.Ext.mk₀_zero]
        _ = 0 := CategoryTheory.Abelian.Ext.comp_zero z L₁ 0 q (Nat.add_zero q)
    exact Subsingleton.intro fun z₁ z₂ => (hz z₁).trans (hz z₂).symm

  refine ⟨hSub1, fun r q => ?_⟩

  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have : NeZero (ℓ ^ r) := ⟨pow_ne_zero r hPrime.ne_zero⟩
  have : NeZero (ℓ ^ (r + 1)) := ⟨pow_ne_zero (r + 1) hPrime.ne_zero⟩

  let fℤ : ℤ →+ ZMod (ℓ ^ (r + 1)) :=
    AddMonoidHom.mk'
      (fun n : ℤ => (n : ZMod (ℓ ^ (r + 1))) * ((ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))))
      (fun x y => by push_cast; ring)
  have hfℤ : fℤ (ℓ : ℤ) = 0 := by
    change ((ℓ : ℤ) : ZMod (ℓ ^ (r + 1))) * ((ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) = 0
    rw [Int.cast_natCast, ← Nat.cast_mul, ← pow_succ', ZMod.natCast_self]
  let i₀ : ZMod ℓ →+ ZMod (ℓ ^ (r + 1)) := ZMod.lift ℓ ⟨fℤ, hfℤ⟩
  have hi₀_nat : ∀ k : ℕ, i₀ (k : ZMod ℓ) = ((k * ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) := by
    intro k
    have hk : (k : ZMod ℓ) = ((k : ℤ) : ZMod ℓ) := (Int.cast_natCast k).symm
    rw [hk, ZMod.lift_coe]
    change ((k : ℤ) : ZMod (ℓ ^ (r + 1))) * ((ℓ ^ r : ℕ) : ZMod (ℓ ^ (r + 1))) = _
    rw [Int.cast_natCast, Nat.cast_mul]
  let p₀ : ZMod (ℓ ^ (r + 1)) →+ ZMod (ℓ ^ r) :=
    (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom
  have hp₀_nat : ∀ k : ℕ, p₀ (k : ZMod (ℓ ^ (r + 1))) = (k : ZMod (ℓ ^ r)) := fun k =>
    map_natCast (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))) k
  have h_pi0 : ∀ a : ZMod ℓ, p₀ (i₀ a) = 0 := by
    intro a
    rw [← ZMod.natCast_zmod_val a, hi₀_nat, hp₀_nat, Nat.cast_mul, ZMod.natCast_self, mul_zero]
  have hi₀_inj : Function.Injective i₀ := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    rw [← ZMod.natCast_zmod_val a, hi₀_nat, ZMod.natCast_eq_zero_iff, pow_succ'] at ha
    have hdvd : ℓ ∣ a.val := (Nat.mul_dvd_mul_iff_right (pow_pos hPrime.pos r)).mp ha
    have hval0 : a.val = 0 := Nat.eq_zero_of_dvd_of_lt hdvd (ZMod.val_lt a)
    rw [← ZMod.natCast_zmod_val a, hval0, Nat.cast_zero]
  have hp₀_surj : Function.Surjective p₀ := by
    intro w
    refine ⟨(w.val : ZMod (ℓ ^ (r + 1))), ?_⟩
    rw [hp₀_nat, ZMod.natCast_zmod_val]
  have h_exact0 : ∀ b : ZMod (ℓ ^ (r + 1)), p₀ b = 0 → ∃ a : ZMod ℓ, i₀ a = b := by
    intro b hb
    have hb' : p₀ (b.val : ZMod (ℓ ^ (r + 1))) = 0 := by
      rwa [ZMod.natCast_zmod_val]
    rw [hp₀_nat, ZMod.natCast_eq_zero_iff] at hb'
    obtain ⟨k, hk⟩ := hb'
    refine ⟨(k : ZMod ℓ), ?_⟩
    rw [hi₀_nat, mul_comm k (ℓ ^ r), ← hk, ZMod.natCast_zmod_val]

  let ι_coeff : AM ℓ ⟶ AM (ℓ ^ (r + 1)) :=
    AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom i₀)
  let π_coeff : AM (ℓ ^ (r + 1)) ⟶ AM (ℓ ^ r) :=
    AddCommGrpCat.uliftFunctor.{u, 0}.map
      (AddCommGrpCat.ofHom
        (ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ r)) (ZMod (ℓ ^ r))).toAddMonoidHom)
  have hι_inj : Function.Injective ι_coeff.hom := by
    rintro ⟨a₁⟩ ⟨a₂⟩ h
    exact congrArg ULift.up (hi₀_inj (congrArg ULift.down h))
  have hπ_surj : Function.Surjective π_coeff.hom := by
    rintro ⟨w⟩
    obtain ⟨b, hb⟩ := hp₀_surj w
    exact ⟨ULift.up b, congrArg ULift.up hb⟩
  have h_comp_coeff : ι_coeff ≫ π_coeff = 0 := by
    apply AddCommGrpCat.ext
    rintro ⟨a⟩
    exact congrArg ULift.up (h_pi0 a)
  have h_exact_coeff : ∀ y : ↑(AM (ℓ ^ (r + 1))), π_coeff.hom y = 0 →
      ∃ x : ↑(AM ℓ), ι_coeff.hom x = y := by
    rintro ⟨b⟩ hb
    obtain ⟨a, ha⟩ := h_exact0 b (congrArg ULift.down hb)
    exact ⟨ULift.up a, congrArg ULift.up ha⟩

  let Φ : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (f : M₁ ⟶ M₂) (W : S.Etale),
      CategoryTheory.Sheaf.freeYoneda J W M₁ ⟶ CategoryTheory.Sheaf.freeYoneda J W M₂ :=
    fun {_ _} f W =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.CategoryStruct.comp f
          (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id (CategoryTheory.Sheaf.freeYoneda J W _))))

  have hCoeffMap_comm :
      ∀ {m₁ m₂ : ℕ} (f : AM m₁ ⟶ AM m₂) {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂),
        Φ f U₁ ≫ weilEtaleLocalTorsionMap S m₂ v =
          weilEtaleLocalTorsionMap S m₁ v ≫ Φ f U₂ := by
    intro m₁ m₂ f U₁ U₂ v
    let μ₁ := weilEtaleLocalTorsionMap S m₁ v
    let μ₂ := weilEtaleLocalTorsionMap S m₂ v
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ f U₁ ≫ μ₂)
        = CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ f U₁) ≫ μ₂.hom.app (Opposite.op U₁) :=
            hEquiv_comp (Φ f U₁) μ₂
      _ = (f ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₁))) ≫ μ₂.hom.app (Opposite.op U₁) := by
            rw [show CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ f U₁) =
              f ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₁)) from Equiv.apply_symm_apply _ _]
      _ = f ≫ (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₁)) ≫ μ₂.hom.app (Opposite.op U₁)) := by
            rw [CategoryTheory.Category.assoc]
      _ = f ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv μ₂ := by
            rw [← hEquiv_comp (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₁)) μ₂,
              CategoryTheory.Category.id_comp]
      _ = f ≫ (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₂)) ≫
            (weilEtaleLocalTorsionSheaf S m₂ U₂).obj.map (Opposite.op v)) := by
            rw [show CategoryTheory.Sheaf.freeYonedaHomEquiv μ₂ =
              CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₂)) ≫
                (weilEtaleLocalTorsionSheaf S m₂ U₂).obj.map (Opposite.op v) from
              Equiv.apply_symm_apply _ _]
      _ = (f ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₂))) ≫
            (weilEtaleLocalTorsionSheaf S m₂ U₂).obj.map (Opposite.op v) := by
            rw [← CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ f U₂) ≫
            (weilEtaleLocalTorsionSheaf S m₂ U₂).obj.map (Opposite.op v) := by
            rw [show CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ f U₂) =
              f ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf S m₂ U₂)) from Equiv.apply_symm_apply _ _]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₁ U₂)) ≫
            (Φ f U₂).hom.app (Opposite.op U₂)) ≫
            (weilEtaleLocalTorsionSheaf S m₂ U₂).obj.map (Opposite.op v) := by
            rw [← hEquiv_comp (𝟙 (weilEtaleLocalTorsionSheaf S m₁ U₂)) (Φ f U₂),
              CategoryTheory.Category.id_comp]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₁ U₂)) ≫
            ((Φ f U₂).hom.app (Opposite.op U₂) ≫
              (weilEtaleLocalTorsionSheaf S m₂ U₂).obj.map (Opposite.op v)) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₁ U₂)) ≫
            ((weilEtaleLocalTorsionSheaf S m₁ U₂).obj.map (Opposite.op v) ≫
              (Φ f U₂).hom.app (Opposite.op U₁)) := by
            rw [(Φ f U₂).hom.naturality (Opposite.op v)]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m₁ U₂)) ≫
            (weilEtaleLocalTorsionSheaf S m₁ U₂).obj.map (Opposite.op v)) ≫
            (Φ f U₂).hom.app (Opposite.op U₁) := by
            rw [← CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv μ₁ ≫ (Φ f U₂).hom.app (Opposite.op U₁) := by
            rw [show CategoryTheory.Sheaf.freeYonedaHomEquiv μ₁ =
              CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf S m₁ U₂)) ≫
                (weilEtaleLocalTorsionSheaf S m₁ U₂).obj.map (Opposite.op v) from
              Equiv.apply_symm_apply _ _]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (μ₁ ≫ Φ f U₂) :=
            (hEquiv_comp μ₁ (Φ f U₂)).symm

  have hCoeffMapH_comm :
      ∀ {m₁ m₂ : ℕ} (f : AM m₁ ⟶ AM m₂) {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂)
        (z : weilEtaleLocalTorsionH S m₁ U₁ q),
        (CategoryTheory.Abelian.Ext.mk₀ (Φ f U₂)).postcomp Fℤ (Nat.add_zero q)
          (weilEtaleLocalTorsionMapH S m₁ v q z) =
        weilEtaleLocalTorsionMapH S m₂ v q
          ((CategoryTheory.Abelian.Ext.mk₀ (Φ f U₁)).postcomp Fℤ (Nat.add_zero q) z) := by
    intro m₁ m₂ f U₁ U₂ v z
    change (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S m₁ v))
        (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (Φ f U₂)) (Nat.add_zero q) =
      (z.comp (CategoryTheory.Abelian.Ext.mk₀ (Φ f U₁)) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S m₂ v)) (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← hCoeffMap_comm f v,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]

  let ι_bock : ∀ W : S.Etale,
      weilEtaleLocalTorsionH S ℓ W q →+ weilEtaleLocalTorsionH S (ℓ ^ (r + 1)) W q :=
    fun W => (CategoryTheory.Abelian.Ext.mk₀ (Φ ι_coeff W)).postcomp Fℤ (Nat.add_zero q)

  refine ⟨fun {U₁ U₂} v z => hCoeffMapH_comm π_coeff v z, ⟨ι_bock, ?_, ?_⟩⟩
  · intro U₁ U₂ v x
    exact (hCoeffMapH_comm ι_coeff v x).symm
  · intro W y hy
    let Ψ_W : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (f : M₁ ⟶ M₂),
        CategoryTheory.Presheaf.freeYoneda W M₁ ⟶ CategoryTheory.Presheaf.freeYoneda W M₂ :=
      fun {_ _} f =>
        { app := fun V =>
            CategoryTheory.Limits.Sigma.map (fun (_ : V.unop ⟶ W) => f)
          naturality := by
            intro V₁ V₂ g
            dsimp [CategoryTheory.Presheaf.freeYoneda]
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro u
            rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.Sigma.ι_comp_map',
              CategoryTheory.Category.id_comp, CategoryTheory.Limits.Sigma.ι_map,
              CategoryTheory.Limits.Sigma.ι_map_assoc, CategoryTheory.Limits.Sigma.ι_comp_map',
              CategoryTheory.Category.id_comp] }
    have hΨ_equiv : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (f : M₁ ⟶ M₂),
        CategoryTheory.Presheaf.freeYonedaHomEquiv (Ψ_W f) =
          f ≫ CategoryTheory.Presheaf.freeYonedaHomEquiv
            (𝟙 (CategoryTheory.Presheaf.freeYoneda W M₂)) := by
      intro M₁ M₂ f
      have hL : CategoryTheory.Presheaf.freeYonedaHomEquiv (Ψ_W f) =
          CategoryTheory.Limits.Sigma.ι (fun (_ : W ⟶ W) => M₁) (𝟙 W) ≫
            CategoryTheory.Limits.Sigma.map (fun (_ : W ⟶ W) => f) := rfl
      have hR : CategoryTheory.Presheaf.freeYonedaHomEquiv
          (𝟙 (CategoryTheory.Presheaf.freeYoneda W M₂)) =
          CategoryTheory.Limits.Sigma.ι (fun (_ : W ⟶ W) => M₂) (𝟙 W) ≫
            𝟙 (∐ fun (_ : W ⟶ W) => M₂) := rfl
      exact hL.trans ((CategoryTheory.Limits.Sigma.ι_map (fun (_ : W ⟶ W) => f) (𝟙 W)).trans
        (congrArg (f ≫ ·) ((CategoryTheory.Category.comp_id _).symm.trans hR.symm)))
    have hShMap : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (f : M₁ ⟶ M₂),
        (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map (Ψ_W f) = Φ f W := by
      intro M₁ M₂ f
      let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have hLHS : CategoryTheory.Sheaf.freeYonedaHomEquiv
          ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map (Ψ_W f)) =
          CategoryTheory.Presheaf.freeYonedaHomEquiv
            (Ψ_W f ≫ adj_sh.unit.app (CategoryTheory.Presheaf.freeYoneda W M₂)) := by
        change CategoryTheory.Presheaf.freeYonedaHomEquiv
          (adj_sh.unit.app (CategoryTheory.Presheaf.freeYoneda W M₁) ≫
            (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u} ⋙
              CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map (Ψ_W f)) = _
        rw [← adj_sh.unit.naturality (Ψ_W f)]
        rfl
      have hRHS : CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ f W) =
          f ≫ CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (CategoryTheory.Sheaf.freeYoneda J W M₂)) :=
        Equiv.apply_symm_apply _ _
      have hIdSh : CategoryTheory.Sheaf.freeYonedaHomEquiv
          (𝟙 (CategoryTheory.Sheaf.freeYoneda J W M₂)) =
          CategoryTheory.Presheaf.freeYonedaHomEquiv
            (𝟙 (CategoryTheory.Presheaf.freeYoneda W M₂)) ≫
            (adj_sh.unit.app (CategoryTheory.Presheaf.freeYoneda W M₂)).app (Opposite.op W) := by
        let P₂ := CategoryTheory.Presheaf.freeYoneda W M₂
        have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (CategoryTheory.Sheaf.freeYoneda J W M₂)) =
            CategoryTheory.Presheaf.freeYonedaHomEquiv
              (adj_sh.unit.app P₂ ≫
                (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map
                  (𝟙 ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P₂))) := rfl
        have h2 : adj_sh.unit.app P₂ ≫
            (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map
              (𝟙 ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P₂)) =
            𝟙 P₂ ≫ adj_sh.unit.app P₂ :=
          (congrArg (adj_sh.unit.app P₂ ≫ ·)
            ((CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map_id _)).trans
            ((CategoryTheory.Category.comp_id (adj_sh.unit.app P₂)).trans
              (CategoryTheory.Category.id_comp (adj_sh.unit.app P₂)).symm)
        exact h1.trans ((congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv h2).trans
          (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _))
      exact (hLHS.trans (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _)).trans
        ((congrArg (· ≫ _) (hΨ_equiv f)).trans
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (f ≫ ·) hIdSh.symm).trans hRHS.symm)))
    have h0_presh : Ψ_W ι_coeff ≫ Ψ_W π_coeff = 0 := by
      ext V : 2
      change CategoryTheory.Limits.Sigma.map (fun (_ : V.unop ⟶ W) => ι_coeff) ≫
          CategoryTheory.Limits.Sigma.map (fun (_ : V.unop ⟶ W) => π_coeff) =
        (0 : (∐ fun (_ : V.unop ⟶ W) => AM ℓ) ⟶ (∐ fun (_ : V.unop ⟶ W) => AM (ℓ ^ r)))
      apply CategoryTheory.Limits.Sigma.hom_ext
      intro u
      rw [CategoryTheory.Limits.Sigma.ι_map_assoc, CategoryTheory.Limits.Sigma.ι_map,
        ← CategoryTheory.Category.assoc, h_comp_coeff, Limits.zero_comp, Limits.comp_zero]
    let SC_presh := CategoryTheory.ShortComplex.mk (Ψ_W ι_coeff) (Ψ_W π_coeff) h0_presh
    have hPointwise : ∀ V : (S.Etale)ᵒᵖ,
        (SC_presh.map ((CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj V)).ShortExact := by
      intro V
      let α : Type u := V.unop ⟶ W
      let ev_V := (CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj V
      let e_coprod : ∀ (M : AddCommGrpCat.{u}),
          (CategoryTheory.Presheaf.freeYoneda W M).obj V ≅
            AddCommGrpCat.of (α →₀ ↑M) := fun M =>
        { hom :=
            CategoryTheory.Limits.Sigma.desc
              (fun u : α => AddCommGrpCat.ofHom (Finsupp.singleAddHom (M := ↑M) u))
          inv :=
            AddCommGrpCat.ofHom
              (Finsupp.liftAddHom
                (fun u : α =>
                  (CategoryTheory.Limits.Sigma.ι (fun _ : α => M) u).hom))
          hom_inv_id := by
            dsimp [CategoryTheory.Presheaf.freeYoneda]
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro u
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, CategoryTheory.Category.comp_id]
            apply AddCommGrpCat.ext
            intro m
            exact Finsupp.liftAddHom_apply_single _ u m
          inv_hom_id := by
            apply AddCommGrpCat.hom_ext
            apply Finsupp.addHom_ext'
            intro u
            apply AddMonoidHom.ext
            intro m
            change (CategoryTheory.Limits.Sigma.desc
              (fun u : α => AddCommGrpCat.ofHom (Finsupp.singleAddHom (M := ↑M) u))).hom
              ((Finsupp.liftAddHom
                (fun u : α => (CategoryTheory.Limits.Sigma.ι (fun _ : α => M) u).hom))
                (Finsupp.single u m)) = Finsupp.single u m
            rw [Finsupp.liftAddHom_apply_single]
            exact ConcreteCategory.congr_hom
              (CategoryTheory.Limits.Sigma.ι_comp_desc
                (fun u : α => AddCommGrpCat.ofHom (Finsupp.singleAddHom (M := ↑M) u)) u) m }
      have he_nat : ∀ {M₁ M₂ : AddCommGrpCat.{u}} (f : M₁ ⟶ M₂),
          (e_coprod M₁).hom ≫ AddCommGrpCat.ofHom (Finsupp.mapRange.addMonoidHom f.hom) =
            (Ψ_W f).app V ≫ (e_coprod M₂).hom := by
        intro M₁ M₂ f
        dsimp [Ψ_W, e_coprod, CategoryTheory.Presheaf.freeYoneda]
        apply CategoryTheory.Limits.Sigma.hom_ext
        intro u
        rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
          CategoryTheory.Limits.Sigma.ι_map_assoc,
          CategoryTheory.Limits.Sigma.ι_comp_desc]
        apply AddCommGrpCat.ext
        intro m
        simp
      let f_fs : AddCommGrpCat.of (α →₀ ↑(AM ℓ)) ⟶ AddCommGrpCat.of (α →₀ ↑(AM (ℓ ^ (r + 1)))) :=
        AddCommGrpCat.ofHom (Finsupp.mapRange.addMonoidHom ι_coeff.hom)
      let g_fs : AddCommGrpCat.of (α →₀ ↑(AM (ℓ ^ (r + 1)))) ⟶ AddCommGrpCat.of (α →₀ ↑(AM (ℓ ^ r))) :=
        AddCommGrpCat.ofHom (Finsupp.mapRange.addMonoidHom π_coeff.hom)
      have h0_fs : f_fs ≫ g_fs = 0 := by
        apply AddCommGrpCat.ext
        intro h
        ext u
        change π_coeff.hom (ι_coeff.hom (h u)) = 0
        exact ConcreteCategory.congr_hom h_comp_coeff (h u)
      let SC_fs := CategoryTheory.ShortComplex.mk f_fs g_fs h0_fs
      have hSE_fs : SC_fs.ShortExact := by
        have hMono_fs : CategoryTheory.Mono SC_fs.f := by
          rw [AddCommGrpCat.mono_iff_injective]
          intro h₁ h₂ hh
          ext u
          apply hι_inj
          have hu := Finsupp.ext_iff.mp hh u
          simpa [SC_fs, f_fs] using hu
        have hEpi_fs : CategoryTheory.Epi SC_fs.g := by
          rw [AddCommGrpCat.epi_iff_surjective]
          intro h
          let sec_epi : ↑(AM (ℓ ^ r)) → ↑(AM (ℓ ^ (r + 1))) := fun w =>
            if w = 0 then 0 else Classical.choose (hπ_surj w)
          have hsec_zero : sec_epi 0 = 0 := by simp [sec_epi]
          have hsec_spec : ∀ w, π_coeff.hom (sec_epi w) = w := by
            intro w
            dsimp [sec_epi]
            split_ifs with hw
            · subst hw; exact map_zero _
            · exact Classical.choose_spec (hπ_surj w)
          refine ⟨Finsupp.mapRange sec_epi hsec_zero h, ?_⟩
          ext u
          simpa [SC_fs, g_fs] using hsec_spec (h u)
        have hEx_fs : SC_fs.Exact := by
          rw [CategoryTheory.ShortComplex.ab_exact_iff]
          intro g_el hg_el
          let sec_ker : ↑(AM (ℓ ^ (r + 1))) → ↑(AM ℓ) := fun z =>
            if z = 0 then 0
            else if hz : π_coeff.hom z = 0 then Classical.choose (h_exact_coeff z hz)
            else 0
          have hsec_k0 : sec_ker 0 = 0 := by simp [sec_ker]
          refine ⟨Finsupp.mapRange sec_ker hsec_k0 g_el, ?_⟩
          ext u
          have hu0 : π_coeff.hom (g_el u) = 0 := by
            have hu := Finsupp.ext_iff.mp hg_el u
            simpa [SC_fs, g_fs] using hu
          dsimp [SC_fs, f_fs, sec_ker]
          simp only [Finsupp.mapRange.addMonoidHom_apply, Finsupp.mapRange_apply]
          split_ifs with hzu
          · rw [hzu, map_zero]
          · exact Classical.choose_spec (h_exact_coeff (g_el u) hu0)
        exact CategoryTheory.ShortComplex.ShortExact.mk' hEx_fs hMono_fs hEpi_fs
      let iso_V : SC_presh.map ev_V ≅ SC_fs :=
        CategoryTheory.ShortComplex.isoMk
          (e_coprod (AM ℓ)) (e_coprod (AM (ℓ ^ (r + 1)))) (e_coprod (AM (ℓ ^ r)))
          (he_nat ι_coeff) (he_nat π_coeff)
      exact (CategoryTheory.ShortComplex.shortExact_iff_of_iso iso_V).mpr hSE_fs
    have hMono_presh : CategoryTheory.Mono SC_presh.f := by
      rw [CategoryTheory.NatTrans.mono_iff_mono_app]
      intro V
      exact (hPointwise V).mono_f
    have hEpi_presh : CategoryTheory.Epi SC_presh.g := by
      rw [CategoryTheory.NatTrans.epi_iff_epi_app]
      intro V
      exact (hPointwise V).epi_g
    have hExact_presh : SC_presh.Exact := by
      rw [CategoryTheory.ShortComplex.exact_iff_isZero_homology]
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext V : 2
      let ev_V := (CategoryTheory.evaluation (S.Etale)ᵒᵖ AddCommGrpCat.{u}).obj V
      have hZero_map : CategoryTheory.Limits.IsZero
          (SC_presh.map ev_V).homology :=
        (CategoryTheory.ShortComplex.exact_iff_isZero_homology _).mp (hPointwise V).exact
      have hZero_V : CategoryTheory.Limits.IsZero (SC_presh.homology.obj V) :=
        hZero_map.of_iso (SC_presh.mapHomologyIso ev_V).symm
      exact (CategoryTheory.Limits.IsZero.iff_id_eq_zero _).mp hZero_V
    have hSE_presh : SC_presh.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hExact_presh hMono_presh hEpi_presh
    have hSE_map := hSE_presh.map_of_exact (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u})
    have h0_sheaf : Φ ι_coeff W ≫ Φ π_coeff W = 0 :=
      (congrArg₂ CategoryTheory.CategoryStruct.comp
        (hShMap ι_coeff).symm (hShMap π_coeff).symm).trans
        (((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map_comp
            (Ψ_W ι_coeff) (Ψ_W π_coeff)).symm.trans
          ((congrArg (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map h0_presh).trans
            ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).map_zero _ _)))
    let SC_sheaf := CategoryTheory.ShortComplex.mk (Φ ι_coeff W) (Φ π_coeff W) h0_sheaf
    have hSE_sheaf : SC_sheaf.ShortExact := by
      let iso_sh : SC_presh.map (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}) ≅ SC_sheaf :=
        CategoryTheory.ShortComplex.isoMk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
          (by
            dsimp [SC_presh, SC_sheaf, Φ, CategoryTheory.Sheaf.freeYoneda] at hShMap ⊢
            rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            exact (hShMap ι_coeff).symm)
          (by
            dsimp [SC_presh, SC_sheaf, Φ, CategoryTheory.Sheaf.freeYoneda] at hShMap ⊢
            rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            exact (hShMap π_coeff).symm)
      exact (CategoryTheory.ShortComplex.shortExact_iff_of_iso iso_sh).mp hSE_map
    have hy' : y.comp (CategoryTheory.Abelian.Ext.mk₀ SC_sheaf.g) (Nat.add_zero q) = 0 := hy
    obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE_sheaf y hy'
    exact ⟨x, hx⟩

theorem weil_algClosed_etale_mvPolynomial_local_domain_integrallyClosed (k : Type u) [Field k] [IsAlgClosed k] (d : ℕ)
    (B : Type u) [CommRing B] [Algebra (MvPolynomial (Fin d) k) B]
    [Algebra.Etale (MvPolynomial (Fin d) k) B]
    (p : Ideal B) [p.IsMaximal] :
    IsDomain (Localization.AtPrime p) ∧ IsIntegrallyClosed (Localization.AtPrime p) :=
by
  have hGeneral : ∀ (R₀ : Type u) [CommRing R₀] [IsDomain R₀] [IsIntegrallyClosed R₀]
      [IsNoetherianRing R₀] (B : Type u) [CommRing B] [Algebra R₀ B] [Algebra.Etale R₀ B]
      (p : Ideal B) [p.IsPrime],
      IsDomain (Localization.AtPrime p) ∧ IsIntegrallyClosed (Localization.AtPrime p) := by
    intro R₀ _ _ _ _ B _ _ _ p hp_prime
    classical
    have : Module.Flat R₀ B := Algebra.Smooth.flat R₀ B

    
    have hFlatSMulEqZero : ∀ {R M : Type u} [CommRing R] [IsDomain R]
        [AddCommGroup M] [Module R M] [Module.Flat R M] {r : R},
        r ≠ 0 → ∀ {x : M}, r • x = 0 → x = 0 := by
      intro R M _ _ _ _ _ r hr x hx
      let μ_r : R →ₗ[R] R := LinearMap.mulLeft R r
      have hμ_inj : Function.Injective μ_r := mul_right_injective₀ hr
      have hL_inj : Function.Injective (LinearMap.lTensor M μ_r) :=
        Module.Flat.lTensor_preserves_injective_linearMap μ_r hμ_inj
      have htmul : (LinearMap.lTensor M μ_r) (x ⊗ₜ[R] (1 : R)) = 0 := by
        change x ⊗ₜ[R] (r * (1 : R)) = 0
        rw [← smul_eq_mul, ← TensorProduct.smul_tmul, hx, TensorProduct.zero_tmul]
      have hx1 : x ⊗ₜ[R] (1 : R) = 0 :=
        hL_inj (htmul.trans (map_zero (LinearMap.lTensor M μ_r)).symm)
      have hrid := congrArg (TensorProduct.rid R M) hx1
      simpa using hrid

    
    have hDvrEtaleMonic : ∀ (V C' : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V]
        [CommRing C'] [Algebra V C'] [Algebra.Etale V C']
        (b₀ : V), b₀ ≠ 0 → ∀ (m : ℕ) (d_c : ℕ → C') (c : C'),
        c ^ m + ∑ j ∈ Finset.range m, ((b₀ ^ (m - j)) • d_c j) * c ^ j = 0 →
        ∃ y : C', c = b₀ • y := by
      intro V C' _ _ _ _ _ _ b₀ hb₀ m d_c c hEq
      rcases Nat.eq_zero_or_pos m with rfl | hm_pos
      · simp only [pow_zero, Finset.range_zero, Finset.sum_empty, add_zero] at hEq
        refine ⟨0, ?_⟩
        rw [smul_zero, ← one_mul c, hEq, zero_mul]
      · have : Module.Flat V C' := Algebra.Smooth.flat V C'
        obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible V
        have hϖ_ne : ϖ ≠ 0 := hϖ.ne_zero
        let I_ϖ : Ideal V := Ideal.span ({ϖ} : Set V)
        have : I_ϖ.IsMaximal := PrincipalIdealRing.isMaximal_of_irreducible hϖ
        let κ : Type u := V ⧸ I_ϖ
        let _ : Field κ := Ideal.Quotient.field I_ϖ
        have hPowInd : ∀ (n : ℕ) (c₀ : C') (d₀ : ℕ → C'),
            c₀ ^ m + ∑ j ∈ Finset.range m, (((ϖ ^ n) ^ (m - j)) • d₀ j) * c₀ ^ j = 0 →
            ∃ y' : C', c₀ = (ϖ ^ n) • y' := by
          intro n
          induction n with
          | zero =>
            intro c₀ _ _
            exact ⟨c₀, by rw [pow_zero, one_smul]⟩
          | succ k_n ih =>
            intro c₀ d₀ hEq₀
            let C'_κ : Type u := TensorProduct V κ C'
            have : Algebra.Etale κ C'_κ := Algebra.Etale.baseChange V C' κ
            let φ_κ : C' →+* C'_κ := (Algebra.TensorProduct.includeRight : C' →ₐ[V] C'_κ).toRingHom
            have hφ_sum : ∑ j ∈ Finset.range m,
                φ_κ ((((ϖ ^ (k_n + 1)) ^ (m - j)) • d₀ j) * c₀ ^ j) = 0 := by
              refine Finset.sum_eq_zero fun j hj => ?_
              have hj_lt : j < m := Finset.mem_range.mp hj
              have hsub_pos : 0 < m - j := Nat.sub_pos_of_lt hj_lt
              have hsub_eq : m - j = (m - j - 1) + 1 := (Nat.sub_add_cancel hsub_pos).symm
              have hmem_ϖ : (ϖ ^ (k_n + 1)) ^ (m - j) ∈ I_ϖ := by
                rw [hsub_eq, pow_succ, pow_succ ϖ k_n]
                refine Ideal.mem_span_singleton.mpr ⟨(ϖ ^ (k_n + 1)) ^ (m - j - 1) * ϖ ^ k_n, ?_⟩
                ring
              have hmk_zero : Ideal.Quotient.mk I_ϖ ((ϖ ^ (k_n + 1)) ^ (m - j)) = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr hmem_ϖ
              rw [map_mul]
              have hcoeff0 : φ_κ (((ϖ ^ (k_n + 1)) ^ (m - j)) • d₀ j) = 0 := by
                change (1 : κ) ⊗ₜ[V] (((ϖ ^ (k_n + 1)) ^ (m - j)) • d₀ j) = 0
                rw [← TensorProduct.smul_tmul]
                have hsmul_κ : ((ϖ ^ (k_n + 1)) ^ (m - j)) • (1 : κ) = 0 := by
                  rw [Algebra.smul_def, mul_one]
                  exact hmk_zero
                rw [hsmul_κ, TensorProduct.zero_tmul]
              rw [hcoeff0, zero_mul]
            have hφ_pow : (φ_κ c₀) ^ m = 0 := by
              have h1 := congrArg φ_κ hEq₀
              rw [map_add, map_pow, map_sum, hφ_sum, add_zero, map_zero] at h1
              exact h1
            obtain ⟨I_κ, _, Ai_κ, hFieldAi_κ, _, e_κ, _⟩ :=
              (Algebra.Etale.iff_exists_algEquiv_prod κ C'_κ).mp inferInstance
            let _ := hFieldAi_κ
            have hφ_c₀ : φ_κ c₀ = 0 := by
              apply e_κ.injective
              rw [map_zero]
              funext i
              have hi_pow : (e_κ (φ_κ c₀) i) ^ m = 0 := by
                rw [← Pi.pow_apply, ← map_pow, hφ_pow, map_zero, Pi.zero_apply]
              exact (pow_eq_zero_iff hm_pos.ne').mp hi_pow
            have hc₀_mem : c₀ ∈ I_ϖ • (⊤ : Submodule V C') := by
              have hqt := congrArg (TensorProduct.quotTensorEquivQuotSMul C' I_ϖ) hφ_c₀
              change (TensorProduct.quotTensorEquivQuotSMul C' I_ϖ)
                (Ideal.Quotient.mk I_ϖ 1 ⊗ₜ[V] c₀) = _ at hqt
              rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul, one_smul, map_zero] at hqt
              exact (Submodule.Quotient.mk_eq_zero _).mp hqt
            obtain ⟨c₁, hc₁⟩ : ∃ c₁ : C', c₀ = ϖ • c₁ := by
              refine Submodule.smul_induction_on hc₀_mem ?_ ?_
              · intro r hr x _
                obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hr
                exact ⟨q • x, mul_smul ϖ q x⟩
              · rintro x y ⟨cx, rfl⟩ ⟨cy, rfl⟩
                exact ⟨cx + cy, (smul_add ϖ cx cy).symm⟩
            have hScaled : (ϖ ^ m) •
                (c₁ ^ m + ∑ j ∈ Finset.range m, (((ϖ ^ k_n) ^ (m - j)) • d₀ j) * c₁ ^ j) = 0 := by
              rw [← hEq₀, hc₁, smul_add, Finset.smul_sum]
              congr 1
              · simp only [Algebra.smul_def, mul_pow, map_pow]
              · refine Finset.sum_congr rfl fun j hj => ?_
                have hj_le : j ≤ m := (Finset.mem_range.mp hj).le
                have hpow_m : (algebraMap V C' ϖ) ^ m =
                    (algebraMap V C' ϖ) ^ (m - j) * (algebraMap V C' ϖ) ^ j := by
                  rw [← pow_add, Nat.sub_add_cancel hj_le]
                simp only [Algebra.smul_def, mul_pow, map_pow]
                rw [hpow_m, pow_succ (algebraMap V C' ϖ) k_n, mul_pow]
                ring
            have hRed := hFlatSMulEqZero (pow_ne_zero m hϖ_ne) hScaled
            obtain ⟨y₀, hy₀⟩ := ih c₁ d₀ hRed
            exact ⟨y₀, by rw [hc₁, hy₀, ← mul_smul, ← pow_succ']⟩
        obtain ⟨n, hAssoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb₀ hϖ
        obtain ⟨u, hu⟩ := hAssoc.symm
        let d' : ℕ → C' := fun j => ((u : V) ^ (m - j)) • d_c j
        have hEq' : c ^ m + ∑ j ∈ Finset.range m, (((ϖ ^ n) ^ (m - j)) • d' j) * c ^ j = 0 := by
          rw [← hEq]
          congr 1
          refine Finset.sum_congr rfl fun j _ => ?_
          dsimp [d']
          rw [← mul_smul, ← mul_pow, hu]
        obtain ⟨y', hy'⟩ := hPowInd n c d' hEq'
        refine ⟨((↑u⁻¹ : V)) • y', ?_⟩
        rw [hy', ← hu, ← mul_smul, mul_assoc, Units.mul_inv, mul_one]

    
    have hKrullDvrInj : ∀ (b₀ : R₀), b₀ ≠ 0 →
        ∃ (n : ℕ) (P : Fin n → PrimeSpectrum R₀)
          (α : (R₀ ⧸ Ideal.span ({b₀} : Set R₀)) →ₗ[R₀]
            ∀ i : Fin n,
              Localization.AtPrime (P i).asIdeal ⧸
                Ideal.span ({algebraMap R₀ (Localization.AtPrime (P i).asIdeal) b₀} :
                  Set (Localization.AtPrime (P i).asIdeal))),
          (∀ i : Fin n, IsDiscreteValuationRing (Localization.AtPrime (P i).asIdeal)) ∧
          Function.Injective α ∧
          ∀ (r : R₀) (i : Fin n),
            α (Ideal.Quotient.mk (Ideal.span ({b₀} : Set R₀)) r) i =
              Ideal.Quotient.mk
                (Ideal.span ({algebraMap R₀ (Localization.AtPrime (P i).asIdeal) b₀} :
                  Set (Localization.AtPrime (P i).asIdeal)))
                (algebraMap R₀ (Localization.AtPrime (P i).asIdeal) r) := by
      intro b₀ hb₀
      let I₀ : Ideal R₀ := Ideal.span ({b₀} : Set R₀)
      let M₀ : Type u := R₀ ⧸ I₀
      have : Module.Finite R₀ M₀ :=
        Module.Finite.of_surjective (Submodule.mkQ I₀) (Submodule.Quotient.mk_surjective I₀)
      have hFin : (associatedPrimes R₀ M₀).Finite := associatedPrimes.finite R₀ M₀
      let S_fin : Finset (Ideal R₀) := hFin.toFinset
      let n : ℕ := Fintype.card ↥S_fin
      let e_fin : Fin n ≃ ↥S_fin := (Fintype.equivFin ↥S_fin).symm
      have hAss : ∀ i : Fin n, IsAssociatedPrime (e_fin i).1 M₀ :=
        fun i => hFin.mem_toFinset.mp (e_fin i).2
      have hPrime_efin : ∀ i : Fin n, (e_fin i).1.IsPrime :=
        fun i => ((isAssociatedPrime_iff_exists_injective_linearMap _ M₀).mp (hAss i)).1
      let P : Fin n → PrimeSpectrum R₀ := fun i => ⟨(e_fin i).1, hPrime_efin i⟩
      have : ∀ i : Fin n, (P i).asIdeal.IsPrime := fun i => (P i).isPrime
      let V_i : Fin n → Type u := fun i => Localization.AtPrime (P i).asIdeal
      let J_i : ∀ i : Fin n, Ideal (V_i i) :=
        fun i => Ideal.span ({algebraMap R₀ (V_i i) b₀} : Set (V_i i))
      let f_i : ∀ i : Fin n, R₀ →ₗ[R₀] (V_i i) ⧸ (J_i i) :=
        fun i => ((Submodule.mkQ (J_i i)).restrictScalars R₀).comp (Algebra.linearMap R₀ (V_i i))
      have hker_i : ∀ i : Fin n, I₀ ≤ LinearMap.ker (f_i i) := by
        intro i r hr
        rw [LinearMap.mem_ker]
        obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hr
        change Ideal.Quotient.mk (J_i i) (algebraMap R₀ (V_i i) (b₀ * q)) = 0
        rw [map_mul, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton.mpr ⟨algebraMap R₀ (V_i i) q, rfl⟩
      let α : M₀ →ₗ[R₀] ∀ i : Fin n, (V_i i) ⧸ (J_i i) :=
        LinearMap.pi fun i => Submodule.liftQ I₀ (f_i i) (hker_i i)
      have hα_mk : ∀ (r : R₀) (i : Fin n),
          α (Ideal.Quotient.mk I₀ r) i = Ideal.Quotient.mk (J_i i) (algebraMap R₀ (V_i i) r) :=
        fun _ _ => rfl
      have hInj_α : Function.Injective α := by
        rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
        intro q hq_ker
        by_contra hq_ne
        rw [LinearMap.mem_ker] at hq_ker
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
        obtain ⟨p₀, hp₀_ass, h_colon⟩ :=
          exists_le_isAssociatedPrime_of_isNoetherianRing R₀ (Ideal.Quotient.mk I₀ r) hq_ne
        let i : Fin n := e_fin.symm ⟨p₀, hFin.mem_toFinset.mpr hp₀_ass⟩
        have hPi_eq : (P i).asIdeal = p₀ :=
          congrArg Subtype.val (e_fin.apply_symm_apply ⟨p₀, hFin.mem_toFinset.mpr hp₀_ass⟩)
        have hmk_i : Ideal.Quotient.mk (J_i i) (algebraMap R₀ (V_i i) r) = 0 := by
          rw [← hα_mk r i, hq_ker]
          rfl
        obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hmk_i)
        obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj (P i).asIdeal.primeCompl u
        have hInj_Vi : Function.Injective (algebraMap R₀ (V_i i)) :=
          IsLocalization.injective (V_i i) (P i).asIdeal.primeCompl_le_nonZeroDivisors
        have hrs : s.1 * r = b₀ * t := hInj_Vi <| by
          simp only [map_mul]
          rw [mul_comm (algebraMap R₀ (V_i i) s.1), hu, mul_assoc, hts]
        have hs_colon : s.1 ∈ (⊥ : Submodule R₀ M₀).colon {Ideal.Quotient.mk I₀ r} := by
          rw [Submodule.mem_colon_singleton, Submodule.mem_bot]
          change Ideal.Quotient.mk I₀ (s.1 * r) = 0
          rw [hrs, Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.mem_span_singleton.mpr ⟨t, rfl⟩
        have hs_p₀ : s.1 ∈ p₀ := h_colon hs_colon
        rw [← hPi_eq] at hs_p₀
        exact s.2 hs_p₀
      have hDVR : ∀ i : Fin n, IsDiscreteValuationRing (V_i i) := by
        intro i
        let p_i : Ideal R₀ := (P i).asIdeal
        have hp_i : p_i.IsPrime := (P i).isPrime
        let V : Type u := Localization.AtPrime p_i
        change IsDiscreteValuationRing V
        have : IsNoetherianRing V := IsLocalization.isNoetherianRing p_i.primeCompl V inferInstance
        have : IsDomain V := IsLocalization.isDomain_of_local_atPrime hp_i
        have : IsIntegrallyClosed V :=
          isIntegrallyClosed_of_isLocalization V p_i.primeCompl p_i.primeCompl_le_nonZeroDivisors
        have hInj_RV : Function.Injective (algebraMap R₀ V) :=
          IsLocalization.injective V p_i.primeCompl_le_nonZeroDivisors
        obtain ⟨_, f_ass, hf_inj⟩ :=
          (isAssociatedPrime_iff_exists_injective_linearMap p_i M₀).mp (hAss i)
        obtain ⟨x, hx_mk⟩ := Ideal.Quotient.mk_surjective (f_ass (Ideal.Quotient.mk p_i 1))
        have hp_iff : ∀ r : R₀, r ∈ p_i ↔ ∃ t : R₀, r * x = b₀ * t := by
          intro r
          have hsmul1 : r • Ideal.Quotient.mk p_i (1 : R₀) = Ideal.Quotient.mk p_i r := by
            rw [Algebra.smul_def, map_one, mul_one]
            rfl
          have hf_r : f_ass (Ideal.Quotient.mk p_i r) = Ideal.Quotient.mk I₀ (r * x) := by
            rw [← hsmul1, map_smul, ← hx_mk, Algebra.smul_def, map_mul]
            rfl
          rw [← Ideal.Quotient.eq_zero_iff_mem, ← map_eq_zero_iff f_ass hf_inj, hf_r,
            Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton]
          exact Iff.rfl
        have hb₀_pi : b₀ ∈ p_i := (hp_iff b₀).mpr ⟨x, rfl⟩
        let m_V : Ideal V := IsLocalRing.maximalIdeal V
        have hmap_mV : Ideal.map (algebraMap R₀ V) p_i = m_V :=
          Localization.AtPrime.map_eq_maximalIdeal
        let b_V : V := algebraMap R₀ V b₀
        have hb_V_mem : b_V ∈ m_V := hmap_mV ▸ Ideal.mem_map_of_mem (algebraMap R₀ V) hb₀_pi
        have hb_V_ne : b_V ≠ 0 :=
          fun h0 => hb₀ (hInj_RV (h0.trans (map_zero (algebraMap R₀ V)).symm))
        have hNotField : ¬ IsField V := by
          intro hF
          obtain ⟨inv_b, hinv⟩ := hF.mul_inv_cancel hb_V_ne
          exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_iff_exists_inv.mpr ⟨inv_b, hinv⟩))
            hb_V_mem
        let K₀ : Type u := FractionRing R₀
        have hInj_VK : Function.Injective (algebraMap V K₀) := IsFractionRing.injective V K₀
        have hInj_RK : Function.Injective (algebraMap R₀ K₀) := IsFractionRing.injective R₀ K₀
        have hb_K_ne : algebraMap R₀ K₀ b₀ ≠ 0 :=
          fun h0 => hb₀ (hInj_RK (h0.trans (map_zero (algebraMap R₀ K₀)).symm))
        let z₀ : K₀ := algebraMap R₀ K₀ x / algebraMap R₀ K₀ b₀
        have hz₀_not_V : z₀ ∉ Set.range (algebraMap V K₀) := by
          rintro ⟨v, hv_eq⟩
          obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj p_i.primeCompl v
          have hrs_K : z₀ * algebraMap R₀ K₀ s.1 = algebraMap R₀ K₀ r := by
            rw [← hv_eq, IsScalarTower.algebraMap_apply R₀ V K₀ s.1,
              IsScalarTower.algebraMap_apply R₀ V K₀ r, ← map_mul, hrs]
          have hsx_K : algebraMap R₀ K₀ (s.1 * x) = algebraMap R₀ K₀ (b₀ * r) := by
            dsimp [z₀] at hrs_K
            rw [div_mul_eq_mul_div, div_eq_iff hb_K_ne] at hrs_K
            simpa only [map_mul, mul_comm] using hrs_K
          exact s.2 ((hp_iff s.1).mpr ⟨r, hInj_RK hsx_K⟩)
        have hmV_mul : ∀ w ∈ m_V, ∃ u : V, z₀ * algebraMap V K₀ w = algebraMap V K₀ u := by
          intro w hw
          rw [← hmap_mV] at hw
          refine Submodule.span_induction ?_ ?_ ?_ ?_ hw
          · rintro _ ⟨r, hr, rfl⟩
            obtain ⟨t, ht⟩ := (hp_iff r).mp hr
            refine ⟨algebraMap R₀ V t, ?_⟩
            rw [← IsScalarTower.algebraMap_apply R₀ V K₀ r,
              ← IsScalarTower.algebraMap_apply R₀ V K₀ t]
            dsimp [z₀]
            rw [div_mul_eq_mul_div, mul_comm (algebraMap R₀ K₀ x), ← map_mul, ht, map_mul,
              mul_div_cancel_left₀ _ hb_K_ne]
          · exact ⟨0, by simp⟩
          · rintro w₁ w₂ _ _ ⟨u₁, h₁⟩ ⟨u₂, h₂⟩
            exact ⟨u₁ + u₂, by rw [map_add, mul_add, h₁, h₂, map_add]⟩
          · rintro v₀ w₀ _ ⟨u₀, h₀⟩
            refine ⟨v₀ * u₀, ?_⟩
            rw [smul_eq_mul, map_mul, ← mul_assoc, mul_comm z₀, mul_assoc, h₀, ← map_mul]
        have hExistsUnit :
            ∃ w₀ ∈ m_V, ∃ u₀ : V, z₀ * algebraMap V K₀ w₀ = algebraMap V K₀ u₀ ∧ u₀ ∉ m_V := by
          by_contra! hAllMem
          let N : Submodule V K₀ := Submodule.map (Algebra.linearMap V K₀) m_V
          have hN_ne : N ≠ ⊥ := by
            intro hBot
            have hmem : algebraMap V K₀ b_V ∈ N := ⟨b_V, hb_V_mem, rfl⟩
            rw [hBot, Submodule.mem_bot] at hmem
            exact hb_V_ne (hInj_VK (hmem.trans (map_zero (algebraMap V K₀)).symm))
          have hN_fg : N.FG := (IsNoetherian.noetherian m_V).map (Algebra.linearMap V K₀)
          have hN_smul : ∀ y_N ∈ N, z₀ • y_N ∈ N := by
            rintro y_N ⟨w, hw, rfl⟩
            obtain ⟨u, hu⟩ := hmV_mul w hw
            refine ⟨u, hAllMem w hw u hu, ?_⟩
            change algebraMap V K₀ u = z₀ * algebraMap V K₀ w
            exact hu.symm
          have hz₀_int : IsIntegral V z₀ :=
            isIntegral_of_smul_mem_submodule N hN_ne hN_fg z₀ hN_smul
          exact hz₀_not_V ((isIntegrallyClosed_iff K₀).mp inferInstance hz₀_int)
        obtain ⟨w₀, hw₀, u₀, hu₀_eq, hu₀_not⟩ := hExistsUnit
        let u_unit : Vˣ := (IsLocalRing.notMem_maximalIdeal.mp hu₀_not).unit
        let ϖ_V : V := (↑u_unit⁻¹ : V) * w₀
        have hϖ_mem : ϖ_V ∈ m_V := m_V.mul_mem_left _ hw₀
        have hz₀_ϖ : z₀ * algebraMap V K₀ ϖ_V = 1 := by
          dsimp [ϖ_V]
          rw [map_mul, ← mul_assoc, mul_comm z₀, mul_assoc, hu₀_eq, ← map_mul]
          have hu_val : (u_unit : V) = u₀ := IsUnit.unit_spec _
          rw [← hu_val, Units.inv_mul, map_one]
        have hmV_prin : m_V.IsPrincipal := by
          refine ⟨⟨ϖ_V, le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖ_mem))⟩⟩
          intro w hw
          obtain ⟨u_w, hu_w⟩ := hmV_mul w hw
          have hw_K : algebraMap V K₀ w = algebraMap V K₀ (ϖ_V * u_w) := by
            calc
              algebraMap V K₀ w = 1 * algebraMap V K₀ w := (one_mul _).symm
              _ = (z₀ * algebraMap V K₀ ϖ_V) * algebraMap V K₀ w := by rw [hz₀_ϖ]
              _ = algebraMap V K₀ ϖ_V * (z₀ * algebraMap V K₀ w) := by ring
              _ = algebraMap V K₀ (ϖ_V * u_w) := by rw [hu_w, ← map_mul]
          exact Ideal.mem_span_singleton.mpr ⟨u_w, hInj_VK hw_K⟩
        exact ((IsDiscreteValuationRing.TFAE V hNotField).out 5 1).mp hmV_prin
      exact ⟨n, P, α, hDVR, hInj_α, hα_mk⟩

    
    have hEtaleMonicDiv : ∀ (b₀ : R₀), b₀ ≠ 0 → ∀ (m : ℕ) (d_c : ℕ → B) (c : B),
        c ^ m + ∑ j ∈ Finset.range m, ((b₀ ^ (m - j)) • d_c j) * c ^ j = 0 →
        ∃ y : B, c = b₀ • y := by
      intro b₀ hb₀ m d_c c hEq
      obtain ⟨n, P, α, hDVR, hInj_α, hα_mk⟩ := hKrullDvrInj b₀ hb₀
      let I₀ : Ideal R₀ := Ideal.span ({b₀} : Set R₀)
      let V_i : Fin n → Type u := fun i => Localization.AtPrime (P i).asIdeal
      let J_i : ∀ i : Fin n, Ideal (V_i i) :=
        fun i => Ideal.span ({algebraMap R₀ (V_i i) b₀} : Set (V_i i))
      have hc_each : ∀ i : Fin n,
          c ⊗ₜ[R₀] Ideal.Quotient.mk (J_i i) (1 : V_i i) =
            (0 : TensorProduct R₀ B ((V_i i) ⧸ (J_i i))) := by
        intro i
        have : (P i).asIdeal.IsPrime := (P i).isPrime
        have : IsDomain (V_i i) := IsLocalization.isDomain_of_local_atPrime (P i).isPrime
        have : IsDiscreteValuationRing (V_i i) := hDVR i
        have hInj_Vi : Function.Injective (algebraMap R₀ (V_i i)) :=
          IsLocalization.injective (V_i i) (P i).asIdeal.primeCompl_le_nonZeroDivisors
        let b_Vi : V_i i := algebraMap R₀ (V_i i) b₀
        have hb_Vi : b_Vi ≠ 0 :=
          fun h0 => hb₀ (hInj_Vi (h0.trans (map_zero (algebraMap R₀ (V_i i))).symm))
        let C'_i : Type u := TensorProduct R₀ (V_i i) B
        have : Algebra.Etale (V_i i) C'_i := Algebra.Etale.baseChange R₀ B (V_i i)
        let inc_i : B →+* C'_i := (Algebra.TensorProduct.includeRight : B →ₐ[R₀] C'_i).toRingHom
        have hinc_smul : ∀ (r : R₀) (x : B),
            inc_i (r • x) = (algebraMap R₀ (V_i i) r) • inc_i x := by
          intro r x
          change (1 : V_i i) ⊗ₜ[R₀] (r • x) =
            (algebraMap R₀ (V_i i) r) • ((1 : V_i i) ⊗ₜ[R₀] x)
          rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, TensorProduct.smul_tmul',
            smul_eq_mul, mul_one]
        have hEq_i : (inc_i c) ^ m +
            ∑ j ∈ Finset.range m, ((b_Vi ^ (m - j)) • inc_i (d_c j)) * (inc_i c) ^ j = 0 := by
          have h1 := congrArg inc_i hEq
          rw [map_add, map_pow, map_sum, map_zero] at h1
          rw [← h1]
          congr 1
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, map_pow, hinc_smul, map_pow]
        obtain ⟨y_i, hy_i⟩ :=
          hDvrEtaleMonic (V_i i) C'_i b_Vi hb_Vi m (fun j => inc_i (d_c j)) (inc_i c) hEq_i
        let β_i : C'_i →ₗ[R₀] TensorProduct R₀ B ((V_i i) ⧸ (J_i i)) :=
          (LinearMap.lTensor B ((Submodule.mkQ (J_i i)).restrictScalars R₀)).comp
            (TensorProduct.comm R₀ (V_i i) B).toLinearMap
        have hβ_kill : ∀ z : C'_i, β_i (b_Vi • z) = 0 := by
          intro z
          induction z using TensorProduct.induction_on with
          | zero => rw [smul_zero, map_zero]
          | tmul v₀ x₀ =>
            rw [TensorProduct.smul_tmul', smul_eq_mul]
            change x₀ ⊗ₜ[R₀] Ideal.Quotient.mk (J_i i) (b_Vi * v₀) = 0
            have hmem : b_Vi * v₀ ∈ J_i i := Ideal.mem_span_singleton.mpr ⟨v₀, rfl⟩
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, TensorProduct.tmul_zero]
          | add z₁ z₂ ih₁ ih₂ => rw [smul_add, map_add, ih₁, ih₂, add_zero]
        have hβ_c : β_i (inc_i c) = c ⊗ₜ[R₀] Ideal.Quotient.mk (J_i i) (1 : V_i i) := rfl
        rw [← hβ_c, hy_i]
        exact hβ_kill y_i
      let w₀ : TensorProduct R₀ B (R₀ ⧸ I₀) := c ⊗ₜ[R₀] Ideal.Quotient.mk I₀ 1
      have hw₀_map : (LinearMap.lTensor B α) w₀ = 0 := by
        let e_pi := TensorProduct.piRight R₀ R₀ B (fun i : Fin n => (V_i i) ⧸ (J_i i))
        apply e_pi.injective
        rw [e_pi.map_zero]
        funext i
        change ((TensorProduct.piRightHom R₀ R₀ B (fun i : Fin n => (V_i i) ⧸ (J_i i)))
          (c ⊗ₜ[R₀] α (Ideal.Quotient.mk I₀ 1))) i = 0
        rw [TensorProduct.piRightHom_tmul]
        change c ⊗ₜ[R₀] α (Ideal.Quotient.mk (Ideal.span ({b₀} : Set R₀)) 1) i = 0
        rw [hα_mk 1 i, map_one]
        exact hc_each i
      have hw₀_zero : w₀ = 0 :=
        (Module.Flat.lTensor_preserves_injective_linearMap α hInj_α)
          (hw₀_map.trans (map_zero (LinearMap.lTensor B α)).symm)
      have hc_mem : c ∈ I₀ • (⊤ : Submodule R₀ B) := by
        have hqt := congrArg (TensorProduct.tensorQuotEquivQuotSMul B I₀) hw₀_zero
        dsimp [w₀] at hqt
        rw [TensorProduct.tensorQuotEquivQuotSMul_tmul_mk, one_smul, map_zero] at hqt
        exact (Submodule.Quotient.mk_eq_zero _).mp hqt
      refine Submodule.smul_induction_on hc_mem ?_ ?_
      · intro r hr x _
        obtain ⟨q, rfl⟩ := Ideal.mem_span_singleton.mp hr
        exact ⟨q • x, mul_smul b₀ q x⟩
      · rintro x y ⟨cx, rfl⟩ ⟨cy, rfl⟩
        exact ⟨cx + cy, (smul_add b₀ cx cy).symm⟩

    
    let K₀ : Type u := FractionRing R₀
    have hInj_RK : Function.Injective (algebraMap R₀ K₀) := IsFractionRing.injective R₀ K₀
    let E : Type u := TensorProduct R₀ K₀ B
    have : Algebra.Etale K₀ E := Algebra.Etale.baseChange R₀ B K₀
    let j_lin : B →ₗ[R₀] E := TensorProduct.mk R₀ K₀ B 1
    let j_alg : B →ₐ[R₀] E := Algebra.TensorProduct.includeRight
    have : IsLocalizedModule (nonZeroDivisors R₀) j_lin :=
      IsLocalization.tensorProduct_isLocalizedModule (nonZeroDivisors R₀) K₀
    have hInj_j : Function.Injective j_alg := by
      intro b₁ b₂ hb
      have hb_lin : j_lin b₁ = j_lin b₂ := hb
      obtain ⟨s, hs_eq⟩ := (IsLocalizedModule.eq_iff_exists (nonZeroDivisors R₀) j_lin).mp hb_lin
      have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      have hs_eq' : s.1 • b₁ = s.1 • b₂ := hs_eq
      have hsub : s.1 • (b₁ - b₂) = 0 := by rw [smul_sub, hs_eq', sub_self]
      exact sub_eq_zero.mp (hFlatSMulEqZero hs_ne hsub)

    obtain ⟨I, hFinI, F_i, hFieldFi, hAlgFi, e_prod, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K₀ E).mp inferInstance
    have : Finite I := hFinI
    let _ : Fintype I := Fintype.ofFinite I
    let _ := hFieldFi
    let _ := hAlgFi

    have hLiftIdem : ∀ i : I, ∃ e_i : B, j_alg e_i = e_prod.symm (Pi.single i 1) := by
      intro i
      let ε_i : E := e_prod.symm (Pi.single i 1)
      have hε_sq : ε_i * ε_i = ε_i := by
        apply e_prod.injective
        rw [map_mul, e_prod.apply_symm_apply]
        funext k_idx
        change Pi.single i (1 : F_i i) k_idx * Pi.single i (1 : F_i i) k_idx =
          Pi.single i (1 : F_i i) k_idx
        by_cases hk : k_idx = i
        · subst hk; simp [Pi.single_eq_same]
        · simp [Pi.single_eq_of_ne hk]
      obtain ⟨⟨c_i, s_i⟩, hcs⟩ := IsLocalizedModule.surj (nonZeroDivisors R₀) j_lin ε_i
      have hs_i : s_i.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s_i.2
      have hcs_alg : s_i.1 • ε_i = j_alg c_i := hcs
      have hci_sq : c_i * c_i = s_i.1 • c_i := hInj_j <| by
        rw [map_mul, Algebra.smul_def s_i.1 c_i, map_mul, j_alg.commutes, ← hcs_alg,
          Algebra.smul_def s_i.1 ε_i]
        calc
          (algebraMap R₀ E s_i.1 * ε_i) * (algebraMap R₀ E s_i.1 * ε_i) =
              (algebraMap R₀ E s_i.1 * algebraMap R₀ E s_i.1) * (ε_i * ε_i) := by ring
          _ = algebraMap R₀ E s_i.1 * (algebraMap R₀ E s_i.1 * ε_i) := by rw [hε_sq, mul_assoc]
      let d_quad : ℕ → B := fun j => if j = 1 then -1 else 0
      have hQuadEq :
          c_i ^ 2 + ∑ j ∈ Finset.range 2, ((s_i.1 ^ (2 - j)) • d_quad j) * c_i ^ j = 0 := by
        rw [Finset.sum_range_succ, Finset.sum_range_one]
        change c_i ^ 2 + (((s_i.1 ^ 2) • (0 : B)) * c_i ^ 0 + ((s_i.1 ^ 1) • (-1 : B)) * c_i ^ 1) = 0
        rw [smul_zero, zero_mul, zero_add, pow_one, pow_one, sq, hci_sq, Algebra.smul_def,
          Algebra.smul_def]
        ring
      obtain ⟨e_i, he_i⟩ := hEtaleMonicDiv s_i.1 hs_i 2 d_quad c_i hQuadEq
      refine ⟨e_i, ?_⟩
      have hsK_ne : algebraMap R₀ K₀ s_i.1 ≠ 0 :=
        fun h0 => hs_i (hInj_RK (h0.trans (map_zero (algebraMap R₀ K₀)).symm))
      have hsmul_eq : (algebraMap R₀ K₀ s_i.1) • j_alg e_i = (algebraMap R₀ K₀ s_i.1) • ε_i := by
        rw [algebraMap_smul K₀ s_i.1 (j_alg e_i), algebraMap_smul K₀ s_i.1 ε_i, hcs_alg, he_i,
          Algebra.smul_def s_i.1 (j_alg e_i), Algebra.smul_def s_i.1 e_i, map_mul, j_alg.commutes]
      calc
        j_alg e_i = (algebraMap R₀ K₀ s_i.1)⁻¹ • ((algebraMap R₀ K₀ s_i.1) • j_alg e_i) :=
          (inv_smul_smul₀ hsK_ne _).symm
        _ = (algebraMap R₀ K₀ s_i.1)⁻¹ • ((algebraMap R₀ K₀ s_i.1) • ε_i) := by rw [hsmul_eq]
        _ = ε_i := inv_smul_smul₀ hsK_ne _

    let e_B : I → B := fun i => Classical.choose (hLiftIdem i)
    have he_B : ∀ i : I, e_prod (j_alg (e_B i)) = Pi.single i 1 := by
      intro i
      rw [Classical.choose_spec (hLiftIdem i), e_prod.apply_symm_apply]

    have hSum_eB : ∑ i : I, e_B i = 1 := hInj_j <| e_prod.injective <| by
      rw [map_sum, map_sum, map_one, map_one]
      funext k_idx
      simp only [Finset.sum_apply, he_B, Pi.one_apply]
      exact Fintype.sum_pi_single k_idx (fun i : I => (1 : F_i i))

    have hExists_i₀ : ∃ i₀ : I, e_B i₀ ∉ p := by
      by_contra! hAllP
      have h1_mem : (1 : B) ∈ p := hSum_eB ▸ p.sum_mem fun i _ => hAllP i
      exact hp_prime.ne_top ((Ideal.eq_top_iff_one p).mpr h1_mem)
    obtain ⟨i₀, he₀_not_p⟩ := hExists_i₀
    let e₀_sub : p.primeCompl := ⟨e_B i₀, he₀_not_p⟩

    let ψ : B →+* F_i i₀ := (Pi.evalRingHom F_i i₀).comp (e_prod.toRingHom.comp j_alg.toRingHom)
    have hψ_apply : ∀ b : B, ψ b = e_prod (j_alg b) i₀ := fun _ => rfl
    have hψ_zero : ∀ b : B, ψ b = 0 → e_B i₀ * b = 0 := by
      intro b hb0
      apply hInj_j
      apply e_prod.injective
      rw [map_mul, map_mul, map_zero, map_zero, he_B i₀]
      funext k_idx
      change Pi.single i₀ (1 : F_i i₀) k_idx * e_prod (j_alg b) k_idx = 0
      by_cases hk : k_idx = i₀
      · subst hk
        rw [Pi.single_eq_same, ← hψ_apply b, hb0, mul_zero]
      · rw [Pi.single_eq_of_ne hk, zero_mul]

    have hψ_units : ∀ s : p.primeCompl, IsUnit (ψ s.1) := by
      intro s
      refine IsUnit.mk0 (ψ s.1) fun hs0 => ?_
      have hmul0 : e_B i₀ * s.1 ∈ p := (hψ_zero s.1 hs0).symm ▸ p.zero_mem
      rcases hp_prime.mem_or_mem hmul0 with h1 | h2
      · exact he₀_not_p h1
      · exact s.2 h2

    let B_p : Type u := Localization.AtPrime p
    let loc : B →+* B_p := algebraMap B B_p
    let ψ_loc : B_p →+* F_i i₀ := IsLocalization.lift hψ_units
    have hψ_loc_eq : ∀ b : B, ψ_loc (loc b) = ψ b := IsLocalization.lift_eq hψ_units
    have hInj_ψloc : Function.Injective ψ_loc := by
      rw [injective_iff_map_eq_zero]
      intro z hz0
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj p.primeCompl z
      have hψb : ψ b = 0 := by
        have h1 := congrArg ψ_loc hbs
        rw [map_mul, hz0, zero_mul, hψ_loc_eq] at h1
        exact h1.symm
      have heb : e_B i₀ * b = 0 := hψ_zero b hψb
      let u_e : B_pˣ := (IsLocalization.map_units B_p e₀_sub).unit
      let u_s : B_pˣ := (IsLocalization.map_units B_p s).unit
      have hue_val : (u_e : B_p) = loc (e_B i₀) := IsUnit.unit_spec _
      have hus_val : (u_s : B_p) = loc s.1 := IsUnit.unit_spec _
      have hzs0 : loc (e_B i₀) * (z * loc s.1) = 0 := by
        rw [hbs, ← map_mul, heb, map_zero]
      calc
        z = ((↑u_e⁻¹ : B_p) * (u_e : B_p)) * z * ((u_s : B_p) * (↑u_s⁻¹ : B_p)) := by
          rw [Units.inv_mul, Units.mul_inv, one_mul, mul_one]
        _ = (↑u_e⁻¹ : B_p) * (loc (e_B i₀) * (z * loc s.1)) * (↑u_s⁻¹ : B_p) := by
          rw [hue_val, hus_val]; ring
        _ = 0 := by rw [hzs0, mul_zero, zero_mul]

    have hDom_Bp : IsDomain B_p := hInj_ψloc.isDomain
    refine ⟨hDom_Bp, ?_⟩

    
    let L_p : Type u := FractionRing B_p
    let ι_L : B_p →+* L_p := algebraMap B_p L_p
    have hInj_ιL : Function.Injective ι_L := IsFractionRing.injective B_p L_p
    apply (isIntegrallyClosed_iff L_p).mpr
    intro z hz
    obtain ⟨Q, hQ_mon, hQ_eval⟩ := hz
    let m : ℕ := Q.natDegree
    have hMonic_L : z ^ m + ∑ j ∈ Finset.range m, ι_L (Q.coeff j) * z ^ j = 0 := by
      have h1 := hQ_eval
      rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, hQ_mon.coeff_natDegree,
        map_one, one_mul, add_comm] at h1
      exact h1
    rcases Nat.eq_zero_or_pos m with hm0 | hm_pos
    · exfalso
      rw [hm0] at hMonic_L
      simp only [pow_zero, Finset.range_zero, Finset.sum_empty, add_zero] at hMonic_L
      exact one_ne_zero hMonic_L

    obtain ⟨x_p, v_p, hv_mem, hxv⟩ := IsFractionRing.div_surjective B_p z
    have hv_p : v_p ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hv_mem
    obtain ⟨⟨b_x, s_x⟩, hbs_x⟩ := IsLocalization.surj p.primeCompl x_p
    obtain ⟨⟨b_v, s_v⟩, hbs_v⟩ := IsLocalization.surj p.primeCompl v_p
    let x₀ : B := b_x * s_v.1
    let v₀ : B := b_v * s_x.1
    have hloc_sxv_unit : IsUnit (loc (s_x.1 * s_v.1)) :=
      IsLocalization.map_units B_p (s_x * s_v)
    have hloc_x₀ : loc x₀ = x_p * loc (s_x.1 * s_v.1) := by
      dsimp [x₀]
      rw [map_mul, map_mul, ← mul_assoc, hbs_x]
    have hloc_v₀ : loc v₀ = v_p * loc (s_x.1 * s_v.1) := by
      dsimp [v₀]
      rw [map_mul, map_mul, mul_comm (loc s_x.1), ← mul_assoc, hbs_v]
    have hloc_v₀_ne : loc v₀ ≠ 0 := by
      rw [hloc_v₀]
      exact mul_ne_zero hv_p hloc_sxv_unit.ne_zero
    have hz_x₀v₀ : z = ι_L (loc x₀) / ι_L (loc v₀) := by
      have hne_sxv : ι_L (loc (s_x.1 * s_v.1)) ≠ 0 :=
        fun h0 => hloc_sxv_unit.ne_zero (hInj_ιL (h0.trans (map_zero ι_L).symm))
      rw [← hxv, hloc_x₀, hloc_v₀, map_mul ι_L x_p, map_mul ι_L v_p,
        mul_div_mul_right _ _ hne_sxv]

    have hψ_v₀ : ψ v₀ ≠ 0 := by
      rw [← hψ_loc_eq v₀]
      exact fun h0 => hloc_v₀_ne (hInj_ψloc (h0.trans (map_zero ψ_loc).symm))
    let w_inv : E := e_prod.symm (Pi.single i₀ (ψ v₀)⁻¹)
    have hw_v₀ : w_inv * j_alg v₀ = j_alg (e_B i₀) := by
      apply e_prod.injective
      rw [map_mul, e_prod.apply_symm_apply, he_B i₀]
      funext k_idx
      change Pi.single i₀ (ψ v₀)⁻¹ k_idx * e_prod (j_alg v₀) k_idx = Pi.single i₀ 1 k_idx
      by_cases hk : k_idx = i₀
      · subst hk
        rw [Pi.single_eq_same, Pi.single_eq_same, ← hψ_apply v₀, inv_mul_cancel₀ hψ_v₀]
      · rw [Pi.single_eq_of_ne hk, Pi.single_eq_of_ne hk, zero_mul]

    obtain ⟨⟨b', s₀⟩, hbs₀⟩ := IsLocalizedModule.surj (nonZeroDivisors R₀) j_lin w_inv
    let b₀ : R₀ := s₀.1
    have hb₀ : b₀ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s₀.2
    let b_B : B := algebraMap R₀ B b₀
    have hb'_v₀ : b' * v₀ = b_B * e_B i₀ := hInj_j <| by
      have hbs₀' : algebraMap R₀ E b₀ * w_inv = j_alg b' := by
        rw [← Algebra.smul_def b₀ w_inv]
        exact hbs₀
      rw [map_mul, ← hbs₀', mul_assoc, hw_v₀, map_mul, j_alg.commutes]

    have hψ_bB : ψ b_B ≠ 0 := by
      dsimp [b_B]
      rw [hψ_apply]
      have hj_bB : j_alg (algebraMap R₀ B b₀) = algebraMap K₀ E (algebraMap R₀ K₀ b₀) := by
        change (1 : K₀) ⊗ₜ[R₀] (algebraMap R₀ B b₀) = (algebraMap R₀ K₀ b₀) ⊗ₜ[R₀] (1 : B)
        have h1 : algebraMap R₀ B b₀ = b₀ • (1 : B) := by rw [Algebra.smul_def, mul_one]
        have h2 : algebraMap R₀ K₀ b₀ = b₀ • (1 : K₀) := by rw [Algebra.smul_def, mul_one]
        rw [h1, h2, TensorProduct.smul_tmul]
      rw [hj_bB, e_prod.commutes]
      change algebraMap K₀ (F_i i₀) (algebraMap R₀ K₀ b₀) ≠ 0
      have hbK : algebraMap R₀ K₀ b₀ ≠ 0 :=
        fun h0 => hb₀ (hInj_RK (h0.trans (map_zero (algebraMap R₀ K₀)).symm))
      exact fun h0 => hbK ((RingHom.injective (algebraMap K₀ (F_i i₀)))
        (h0.trans (map_zero (algebraMap K₀ (F_i i₀))).symm))
    have hloc_bB_ne : loc b_B ≠ 0 := by
      rw [← hψ_loc_eq b_B] at hψ_bB
      exact fun h0 => hψ_bB (by rw [h0, map_zero])
    have hι_bB_ne : ι_L (loc b_B) ≠ 0 :=
      fun h0 => hloc_bB_ne (hInj_ιL (h0.trans (map_zero ι_L).symm))

    let u₀ : B := b' * x₀
    have he₀_z : ι_L (loc (e_B i₀)) * z = ι_L (loc u₀) / ι_L (loc b_B) := by
      have hv₀_L : ι_L (loc v₀) ≠ 0 :=
        fun h0 => hloc_v₀_ne (hInj_ιL (h0.trans (map_zero ι_L).symm))
      apply mul_right_cancel₀ hv₀_L
      apply mul_right_cancel₀ hι_bB_ne
      have hbv_L : ι_L (loc b') * ι_L (loc v₀) = ι_L (loc b_B) * ι_L (loc (e_B i₀)) := by
        rw [← map_mul, ← map_mul, ← map_mul, ← map_mul, hb'_v₀]
      have hzx_L : z * ι_L (loc v₀) = ι_L (loc x₀) := by
        rw [hz_x₀v₀, div_mul_cancel₀ _ hv₀_L]
      have hu₀_L : ι_L (loc u₀) = ι_L (loc b') * ι_L (loc x₀) := by
        dsimp [u₀]; rw [map_mul, map_mul]
      calc
        (ι_L (loc (e_B i₀)) * z) * ι_L (loc v₀) * ι_L (loc b_B) =
            (z * ι_L (loc v₀)) * (ι_L (loc b_B) * ι_L (loc (e_B i₀))) := by ring
        _ = ι_L (loc x₀) * (ι_L (loc b') * ι_L (loc v₀)) := by rw [hzx_L, ← hbv_L]
        _ = (ι_L (loc b') * ι_L (loc x₀)) * ι_L (loc v₀) := by ring
        _ = (ι_L (loc u₀) / ι_L (loc b_B)) * ι_L (loc v₀) * ι_L (loc b_B) := by
          rw [← hu₀_L, mul_right_comm, div_mul_cancel₀ _ hι_bB_ne]

    let r_Q : ℕ → B := fun j => (Classical.choose (IsLocalization.surj p.primeCompl (Q.coeff j))).1
    let s_Q : ℕ → p.primeCompl :=
      fun j => (Classical.choose (IsLocalization.surj p.primeCompl (Q.coeff j))).2
    have hs_Q : ∀ j : ℕ, Q.coeff j * loc (s_Q j).1 = loc (r_Q j) :=
      fun j => Classical.choose_spec (IsLocalization.surj p.primeCompl (Q.coeff j))
    let S_sub : p.primeCompl := ∏ j ∈ Finset.range m, s_Q j
    have hQ_Ssub : ∀ j ∈ Finset.range m, ∃ d₀_j : B, Q.coeff j * loc S_sub.1 = loc d₀_j := by
      intro j hj
      obtain ⟨k_Q, hk_Q⟩ := Finset.dvd_prod_of_mem s_Q hj
      refine ⟨r_Q j * k_Q.1, ?_⟩
      have hS_val : S_sub.1 = (s_Q j).1 * k_Q.1 := congrArg Subtype.val hk_Q
      rw [hS_val, map_mul, ← mul_assoc, hs_Q j, ← map_mul]

    let s_tot : p.primeCompl := S_sub * e₀_sub
    let u₁ : B := S_sub.1 * u₀
    have hstot_z : (ι_L (loc s_tot.1) * z) * ι_L (loc b_B) = ι_L (loc u₁) := by
      have hstot_val : s_tot.1 = S_sub.1 * e_B i₀ := rfl
      calc
        (ι_L (loc s_tot.1) * z) * ι_L (loc b_B) =
            ι_L (loc S_sub.1) * ((ι_L (loc (e_B i₀)) * z) * ι_L (loc b_B)) := by
          rw [hstot_val, map_mul, map_mul]; ring
        _ = ι_L (loc S_sub.1) * ι_L (loc u₀) := by
          rw [he₀_z, div_mul_cancel₀ _ hι_bB_ne]
        _ = ι_L (loc u₁) := by
          rw [← map_mul, ← map_mul]

    let d₁ : ℕ → B := fun j =>
      if hj : j ∈ Finset.range m then
        Classical.choose (hQ_Ssub j hj) * (e_B i₀ * s_tot.1 ^ (m - j - 1))
      else 0
    have hd₁_spec : ∀ j ∈ Finset.range m,
        Q.coeff j * loc (s_tot.1 ^ (m - j)) = loc (d₁ j) := by
      intro j hj
      have hj_lt : j < m := Finset.mem_range.mp hj
      have hsub_pos : 0 < m - j := Nat.sub_pos_of_lt hj_lt
      have hstot_val : s_tot.1 = S_sub.1 * e_B i₀ := rfl
      have hpow_stot : s_tot.1 ^ (m - j) = S_sub.1 * (e_B i₀ * s_tot.1 ^ (m - j - 1)) := by
        calc
          s_tot.1 ^ (m - j) = s_tot.1 * s_tot.1 ^ (m - j - 1) := by
            rw [← pow_succ', Nat.sub_add_cancel hsub_pos]
          _ = S_sub.1 * (e_B i₀ * s_tot.1 ^ (m - j - 1)) := by
            rw [hstot_val, mul_assoc]
      let c_choose : B := Classical.choose (hQ_Ssub j hj)
      have hc_spec : Q.coeff j * loc S_sub.1 = loc c_choose :=
        Classical.choose_spec (hQ_Ssub j hj)
      have hd₁_eq : d₁ j = c_choose * (e_B i₀ * s_tot.1 ^ (m - j - 1)) := dif_pos hj
      rw [hd₁_eq, hpow_stot, map_mul, ← mul_assoc, hc_spec, ← map_mul]

    have hLocEq : loc (u₁ ^ m + ∑ j ∈ Finset.range m, ((b₀ ^ (m - j)) • d₁ j) * u₁ ^ j) = 0 := by
      apply hInj_ιL
      rw [map_zero, map_add, map_add, map_pow, map_pow, map_sum, map_sum]
      have h0 := congrArg (fun x => x * (ι_L (loc s_tot.1) * ι_L (loc b_B)) ^ m) hMonic_L
      rw [zero_mul, add_mul, Finset.sum_mul] at h0
      rw [← h0]
      congr 1
      · calc
          (ι_L (loc u₁)) ^ m = ((ι_L (loc s_tot.1) * z) * ι_L (loc b_B)) ^ m := by rw [hstot_z]
          _ = z ^ m * (ι_L (loc s_tot.1) * ι_L (loc b_B)) ^ m := by ring
      · refine Finset.sum_congr rfl fun j hj => ?_
        have hj_le : j ≤ m := (Finset.mem_range.mp hj).le
        have hpow_m : (ι_L (loc s_tot.1) * ι_L (loc b_B)) ^ m =
            (ι_L (loc s_tot.1) * ι_L (loc b_B)) ^ (m - j) *
              (ι_L (loc s_tot.1) * ι_L (loc b_B)) ^ j := by
          rw [← pow_add, Nat.sub_add_cancel hj_le]
        have hd₁_j : ι_L (Q.coeff j) * (ι_L (loc s_tot.1)) ^ (m - j) = ι_L (loc (d₁ j)) := by
          rw [← map_pow ι_L, ← map_pow loc, ← map_mul ι_L, hd₁_spec j hj]
        rw [Algebra.smul_def, map_mul loc, map_mul ι_L, map_mul loc, map_mul ι_L, ← hd₁_j,
          map_pow (algebraMap R₀ B), map_pow loc, map_pow ι_L, map_pow loc, map_pow ι_L]
        change ((ι_L (loc b_B)) ^ (m - j) * (ι_L (Q.coeff j) * (ι_L (loc s_tot.1)) ^ (m - j))) *
            (ι_L (loc u₁)) ^ j =
          ι_L (Q.coeff j) * z ^ j * (ι_L (loc s_tot.1) * ι_L (loc b_B)) ^ m
        rw [← hstot_z, hpow_m]
        ring

    obtain ⟨t_ann, ht_ann⟩ :=
      (IsLocalization.eq_iff_exists p.primeCompl B_p).mp (hLocEq.trans (map_zero loc).symm)
    rw [mul_zero] at ht_ann

    let c_fin : B := t_ann.1 * u₁
    let d₂ : ℕ → B := fun j => t_ann.1 ^ (m - j) * d₁ j
    have hFinEq :
        c_fin ^ m + ∑ j ∈ Finset.range m, ((b₀ ^ (m - j)) • d₂ j) * c_fin ^ j = 0 := by
      have ht_pow_eq : t_ann.1 ^ m = t_ann.1 ^ (m - 1) * t_ann.1 := by
        rw [← pow_succ, Nat.sub_add_cancel hm_pos]
      have ht_pow :
          t_ann.1 ^ m * (u₁ ^ m + ∑ j ∈ Finset.range m, ((b₀ ^ (m - j)) • d₁ j) * u₁ ^ j) = 0 := by
        rw [ht_pow_eq, mul_assoc, ht_ann, mul_zero]
      rw [← ht_pow, mul_add, Finset.mul_sum]
      congr 1
      · dsimp [c_fin]; ring
      · refine Finset.sum_congr rfl fun j hj => ?_
        have hj_le : j ≤ m := (Finset.mem_range.mp hj).le
        have hpow_t : t_ann.1 ^ m = t_ann.1 ^ (m - j) * t_ann.1 ^ j := by
          rw [← pow_add, Nat.sub_add_cancel hj_le]
        dsimp [c_fin, d₂]
        simp only [Algebra.smul_def]
        rw [hpow_t]
        ring

    obtain ⟨y, hy⟩ := hEtaleMonicDiv b₀ hb₀ m d₂ c_fin hFinEq
    let s_final : p.primeCompl := t_ann * s_tot
    have hs_final_z : ι_L (loc s_final.1) * z = ι_L (loc y) := by
      have hsf_val : s_final.1 = t_ann.1 * s_tot.1 := rfl
      have hc_eq : c_fin = b_B * y := by rwa [Algebra.smul_def] at hy
      apply mul_right_cancel₀ hι_bB_ne
      calc
        (ι_L (loc s_final.1) * z) * ι_L (loc b_B) =
            ι_L (loc t_ann.1) * ((ι_L (loc s_tot.1) * z) * ι_L (loc b_B)) := by
          rw [hsf_val, map_mul, map_mul]; ring
        _ = ι_L (loc c_fin) := by
          rw [hstot_z, ← map_mul, ← map_mul]
        _ = ι_L (loc y) * ι_L (loc b_B) := by
          rw [hc_eq, map_mul, map_mul, mul_comm]

    let u_sf : B_pˣ := (IsLocalization.map_units B_p s_final).unit
    refine ⟨(↑u_sf⁻¹ : B_p) * loc y, ?_⟩
    rw [map_mul, ← hs_final_z, ← mul_assoc, ← map_mul]
    have hu_sf_val : (u_sf : B_p) = loc s_final.1 := IsUnit.unit_spec _
    rw [← hu_sf_val, Units.inv_mul, map_one, one_mul]

  have : p.IsPrime := Ideal.IsMaximal.isPrime inferInstance
  exact hGeneral (MvPolynomial (Fin d) k) B p

theorem weil_noetherian_locally_domain_exists_away_isDomain (B : Type u) [CommRing B] [IsNoetherianRing B]
    (m₀ : Ideal B) [m₀.IsMaximal]
    (hLocDom : ∀ (p : Ideal B) [p.IsMaximal], IsDomain (Localization.AtPrime p)) :
    ∃ f₀ : B, f₀ ∉ m₀ ∧ IsDomain (Localization.Away f₀) :=
by
  classical
  let S_loc : Type u := Localization.AtPrime m₀
  have : IsDomain S_loc := hLocDom m₀
  let K : Ideal B := RingHom.ker (algebraMap B S_loc)
  obtain ⟨S, hS⟩ := Ideal.fg_of_isNoetherianRing K
  have hex : ∀ b ∈ K, ∃ m : ↥m₀.primeCompl, (m : B) * b = 0 := by
    intro b hb
    exact (IsLocalization.map_eq_zero_iff m₀.primeCompl S_loc b).mp (RingHom.mem_ker.mp hb)
  let s_fn : B → B := fun b =>
    if hb : b ∈ K then ((Classical.choose (hex b hb) : ↥m₀.primeCompl) : B) else 1
  have hs_notMem : ∀ b ∈ K, s_fn b ∉ m₀ := by
    intro b hb
    simp only [s_fn, hb, ↓reduceDIte]
    exact (Classical.choose (hex b hb)).2
  have hs_mul : ∀ b ∈ K, s_fn b * b = 0 := by
    intro b hb
    simp only [s_fn, hb, ↓reduceDIte]
    exact Classical.choose_spec (hex b hb)
  have hS_sub : ∀ b ∈ S, b ∈ K := by
    intro b hb
    rw [← hS]
    exact Ideal.subset_span hb
  let f₀ : B := ∏ b ∈ S, s_fn b
  have hf₀ : f₀ ∉ m₀ := by
    intro hmem
    obtain ⟨b, hbS, hbm₀⟩ := (Ideal.IsPrime.prod_mem_iff (p := m₀)).mp hmem
    exact hs_notMem b (hS_sub b hbS) hbm₀
  have hann : ∀ x ∈ K, f₀ * x = 0 := by
    let L : Ideal B := LinearMap.ker (LinearMap.mulLeft B f₀)
    have hle : K ≤ L := by
      rw [← hS, Ideal.span_le]
      intro b hbS
      rw [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.mulLeft_apply]
      obtain ⟨t, ht⟩ := Finset.dvd_prod_of_mem s_fn hbS
      have hf₀_eq : f₀ = s_fn b * t := ht
      calc f₀ * b
          = (s_fn b * t) * b := by rw [hf₀_eq]
        _ = t * (s_fn b * b) := by ring
        _ = t * 0 := by rw [hs_mul b (hS_sub b hbS)]
        _ = 0 := mul_zero t
    intro x hx
    exact LinearMap.mem_ker.mp (hle hx)
  let A₀ : Type u := Localization.Away f₀
  let f₀_sub : ↥m₀.primeCompl := ⟨f₀, hf₀⟩
  have hu : IsUnit (algebraMap B S_loc f₀) := IsLocalization.map_units S_loc f₀_sub
  let ψ : A₀ →+* S_loc := IsLocalization.Away.lift f₀ hu
  have hψ_inj : Function.Injective ψ := by
    rw [_root_.injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨n, x, hzx⟩ := IsLocalization.Away.surj f₀ z
    have hxK : x ∈ K := by
      rw [RingHom.mem_ker, ← IsLocalization.Away.lift_eq (S := A₀) f₀ hu x]
      change ψ (algebraMap B A₀ x) = 0
      rw [← hzx, map_mul, hz, zero_mul]
    have hxf₀ : x * f₀ = 0 := by
      rw [mul_comm]
      exact hann x hxK
    have hz_pow : z * (algebraMap B A₀ f₀) ^ (n + 1) = 0 := by
      calc z * (algebraMap B A₀ f₀) ^ (n + 1)
          = (z * (algebraMap B A₀ f₀) ^ n) * algebraMap B A₀ f₀ := by rw [pow_succ, mul_assoc]
        _ = algebraMap B A₀ x * algebraMap B A₀ f₀ := by rw [hzx]
        _ = algebraMap B A₀ (x * f₀) := (map_mul (algebraMap B A₀) x f₀).symm
        _ = algebraMap B A₀ 0 := by rw [hxf₀]
        _ = 0 := map_zero (algebraMap B A₀)
    have hUnit_pow : IsUnit ((algebraMap B A₀ f₀) ^ (n + 1)) :=
      (IsLocalization.Away.algebraMap_isUnit (S := A₀) f₀).pow (n + 1)
    obtain ⟨u_pow, hu_pow⟩ := hUnit_pow
    rw [← hu_pow] at hz_pow
    calc z
        = z * 1 := (mul_one z).symm
      _ = z * (↑u_pow * ↑u_pow⁻¹) := by rw [Units.mul_inv]
      _ = (z * ↑u_pow) * ↑u_pow⁻¹ := (mul_assoc z _ _).symm
      _ = 0 * ↑u_pow⁻¹ := by rw [hz_pow]
      _ = 0 := zero_mul _
  exact ⟨f₀, hf₀, Function.Injective.isDomain ψ hψ_inj⟩

theorem weil_finiteType_domain_projective_schematic_closure (k : Type u) [Field k]
    (A₀ : Type u) [CommRing A₀] [IsDomain A₀] [Algebra k A₀] [Algebra.FiniteType k A₀]
    (hStdChart : ∀ M₀ : ℕ,
      AlgebraicGeometry.IsSeparated (weilProjectiveSpaceOver k M₀).hom ∧
      ∃ (ι_aff : Quiver.Hom
          (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin M₀) k)))
          (weilProjectiveSpaceOver k M₀).left),
        AlgebraicGeometry.IsOpenImmersion ι_aff ∧
        CategoryTheory.CategoryStruct.comp ι_aff (weilProjectiveSpaceOver k M₀).hom =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C)) :
    ∃ (V_cl : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U_cl : V_cl.left.Opens)
      (e_cl : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of A₀)) U_cl.toScheme),
      AlgebraicGeometry.IsIntegral V_cl.left ∧
      IsProjectiveOverField k V_cl ∧
      topologicalKrullDim V_cl.left = ringKrullDim A₀ ∧
      AlgebraicGeometry.IsAffineOpen U_cl ∧
      Nonempty ↥U_cl ∧
      CategoryTheory.CategoryStruct.comp e_cl.hom
        (CategoryTheory.CategoryStruct.comp U_cl.ι V_cl.hom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)) ∧
      (IsIntegrallyClosed A₀ →
        IsIntegrallyClosed ↑(V_cl.left.presheaf.obj (Opposite.op U_cl))) :=
by
  classical
  
  have hS1 :
      ∀ (P : AlgebraicGeometry.Scheme.{u})
        (j₀ : AlgebraicGeometry.Spec (CommRingCat.of A₀) ⟶ P)
        [AlgebraicGeometry.IsImmersion j₀] [AlgebraicGeometry.QuasiCompact j₀],
        AlgebraicGeometry.IsIntegral j₀.image ∧
        ∃ (U_cl : j₀.image.Opens)
          (e_cl : AlgebraicGeometry.Spec (CommRingCat.of A₀) ≅ U_cl.toScheme),
          AlgebraicGeometry.IsAffineOpen U_cl ∧
          Nonempty ↥U_cl ∧
          e_cl.hom ≫ U_cl.ι ≫ j₀.imageι = j₀ ∧
          (IsIntegrallyClosed A₀ →
            IsIntegrallyClosed ↑(j₀.image.presheaf.obj (Opposite.op U_cl))) := by
    intro P j₀ _ _
    let X : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A₀)
    let Y : AlgebraicGeometry.Scheme.{u} := j₀.image
    haveI hIntX : AlgebraicGeometry.IsIntegral X :=
      (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of A₀)).mpr inferInstance
    haveI hIrredX : IrreducibleSpace ↥X := AlgebraicGeometry.irreducibleSpace_of_isIntegral X
    have hDense : DenseRange j₀.toImage.base :=
      AlgebraicGeometry.IsDominant.denseRange (f := j₀.toImage)
    let U_cl : Y.Opens := j₀.toImage.opensRange
    let e_cl : X ≅ U_cl.toScheme := j₀.toImage.isoOpensRange
    have hAff_Ucl : AlgebraicGeometry.IsAffineOpen U_cl :=
      AlgebraicGeometry.IsAffine.of_isIso e_cl.inv
    let x₀ : ↥X := Classical.choice hIrredX.toNonempty
    have hNe_Ucl : Nonempty ↥U_cl := ⟨⟨j₀.toImage.base x₀, ⟨x₀, rfl⟩⟩⟩
    have hNe_Y : Nonempty ↥Y := ⟨j₀.toImage.base x₀⟩
    have he_cl_j₀ : e_cl.hom ≫ U_cl.ι ≫ j₀.imageι = j₀ :=
      (AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι_assoc j₀.toImage j₀.imageι).trans
        (AlgebraicGeometry.Scheme.Hom.toImage_imageι j₀)
    have hIC_imp : IsIntegrallyClosed A₀ →
        IsIntegrallyClosed ↑(Y.presheaf.obj (Opposite.op U_cl)) := by
      intro hIC
      let iso_op : Opposite.op ((j₀.toImage.opensFunctor).obj ⊤) ≅ Opposite.op U_cl :=
        CategoryTheory.eqToIso (congrArg Opposite.op j₀.toImage.image_top_eq_opensRange)
      let iso_ring : CommRingCat.of A₀ ≅ Y.presheaf.obj (Opposite.op U_cl) :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A₀)).symm ≪≫
          (j₀.toImage.appIso ⊤).symm ≪≫
          Y.presheaf.mapIso iso_op
      letI : IsIntegrallyClosed A₀ := hIC
      exact IsIntegrallyClosed.of_equiv iso_ring.commRingCatIsoToRingEquiv
    have hPre_Y : IsPreirreducible (Set.univ : Set ↥Y) := by
      have hcl : closure (j₀.toImage.base '' (Set.univ : Set ↥X)) = (Set.univ : Set ↥Y) := by
        rw [Set.image_univ]
        exact hDense.closure_range
      rw [← hcl]
      exact (hIrredX.isIrreducible_univ.isPreirreducible.image
        j₀.toImage.base j₀.toImage.continuous.continuousOn).closure
    haveI : PreirreducibleSpace ↥Y := ⟨hPre_Y⟩
    haveI hIrredY : IrreducibleSpace ↥Y := ⟨hNe_Y⟩
    have hStalkRed : ∀ y : ↥Y, _root_.IsReduced ↑(Y.presheaf.stalk y) := by
      intro y
      obtain ⟨U_P, hUP, hy_UP, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (x := j₀.imageι.base y) (U := ⊤) trivial
      let W_y : Y.Opens := j₀.imageι ⁻¹ᵁ U_P
      have hWy : AlgebraicGeometry.IsAffineOpen W_y := hUP.preimage j₀.imageι
      have hy_range : y ∈ Set.range ⇑hWy.fromSpec := by
        change y ∈ Set.range hWy.fromSpec.base
        rw [hWy.range_fromSpec]
        exact hy_UP
      obtain ⟨q, rfl⟩ := hy_range
      let e_sub := j₀.ker.subschemeObjIso ⟨U_P, hUP⟩
      let f_ring : ↑(P.presheaf.obj (Opposite.op U_P)) →+*
          ↑(X.presheaf.obj (Opposite.op (j₀ ⁻¹ᵁ U_P))) := (j₀.app U_P).hom
      let e_quot : ↑(P.presheaf.obj (Opposite.op U_P)) ⧸ j₀.ker.ideal ⟨U_P, hUP⟩ ≃+*
          ↑(P.presheaf.obj (Opposite.op U_P)) ⧸ RingHom.ker f_ring :=
        Ideal.quotEquivOfEq (j₀.ker_apply ⟨U_P, hUP⟩)
      let e_sub_ring := e_sub.commRingCatIsoToRingEquiv
      let φ_inj : ↑(Y.presheaf.obj (Opposite.op W_y)) →+*
          ↑(X.presheaf.obj (Opposite.op (j₀ ⁻¹ᵁ U_P))) :=
        (RingHom.kerLift f_ring).comp (e_quot.toRingHom.comp e_sub_ring.toRingHom)
      have hφ_inj : Function.Injective φ_inj :=
        (RingHom.kerLift_injective f_ring).comp (e_quot.injective.comp e_sub_ring.injective)
      haveI : _root_.IsReduced ↑(X.presheaf.obj (Opposite.op (j₀ ⁻¹ᵁ U_P))) :=
        AlgebraicGeometry.IsReduced.component_reduced (j₀ ⁻¹ᵁ U_P)
      have hRed_Wy_ring : _root_.IsReduced ↑(Y.presheaf.obj (Opposite.op W_y)) :=
        isReduced_of_injective φ_inj hφ_inj
      haveI hRed_SpecWy : AlgebraicGeometry.IsReduced
          (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op W_y))) :=
        (AlgebraicGeometry.affine_isReduced_iff (Y.presheaf.obj (Opposite.op W_y))).mpr hRed_Wy_ring
      let e_stalk := (CategoryTheory.asIso (hWy.fromSpec.stalkMap q)).commRingCatIsoToRingEquiv
      exact isReduced_of_injective e_stalk.toRingHom e_stalk.injective
    haveI hRedY : AlgebraicGeometry.IsReduced Y :=
      @AlgebraicGeometry.isReduced_of_isReduced_stalk Y hStalkRed
    have hIntY : AlgebraicGeometry.IsIntegral Y :=
      @AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y hRedY hIrredY
    exact ⟨hIntY, U_cl, e_cl, hAff_Ucl, hNe_Ucl, he_cl_j₀, hIC_imp⟩

  
  have hS2 :
      ∀ (R K : Type u) [CommRing R] [IsDomain R] [Algebra k R] [Algebra.FiniteType k R]
        [Field K] [Algebra k K] [Algebra R K] [IsScalarTower k R K] [IsFractionRing R K],
        ∃ s : ℕ, (s : Cardinal.{u}) = Algebra.trdeg k K ∧ ringKrullDim R = (s : WithBot ℕ∞) := by
    intro R K _ _ _ _ _ _ _ _ _
    have h_tr_RK : Algebra.trdeg k R = Algebra.trdeg k K := by
      haveI : FaithfulSMul k R :=
        (faithfulSMul_iff_algebraMap_injective k R).mpr (RingHom.injective (algebraMap k R))
      haveI : FaithfulSMul R K :=
        (faithfulSMul_iff_algebraMap_injective R K).mpr (IsFractionRing.injective R K)
      haveI : Algebra.IsAlgebraic R K := IsLocalization.isAlgebraic K (nonZeroDivisors R)
      have h0 : Algebra.trdeg R K = 0 := trdeg_eq_zero
      have hadd := trdeg_add_eq k R (A := K)
      rw [h0, add_zero] at hadd
      exact hadd
    obtain ⟨s, g, hg_inj, hg_int⟩ := exists_integral_inj_algHom_of_fg k R
    let P : Type u := MvPolynomial (Fin s) k
    have h_dim_P : ringKrullDim P = (s : WithBot ℕ∞) := by
      dsimp [P]
      rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field k,
        zero_add, ENat.card_eq_coe_fintype_card, Fintype.card_fin, WithBot.coe_natCast]
    letI : Algebra P R := g.toRingHom.toAlgebra
    haveI : Algebra.IsIntegral P R := algebraMap_isIntegral_iff.mp hg_int
    have h_tr_kR : (s : Cardinal.{u}) = Algebra.trdeg k R := by
      haveI : IsScalarTower k P R := IsScalarTower.of_algebraMap_eq fun c => (g.commutes c).symm
      haveI : FaithfulSMul k P :=
        (faithfulSMul_iff_algebraMap_injective k P).mpr (RingHom.injective (algebraMap k P))
      haveI : FaithfulSMul P R :=
        (faithfulSMul_iff_algebraMap_injective P R).mpr hg_inj
      haveI : Algebra.IsAlgebraic P R := Algebra.IsIntegral.isAlgebraic
      have h0 : Algebra.trdeg P R = 0 := trdeg_eq_zero
      have hP : Algebra.trdeg k P = (s : Cardinal.{u}) := by
        dsimp [P]
        rw [MvPolynomial.trdeg_of_isDomain, Cardinal.lift_mk_fin]
      have hadd := trdeg_add_eq k P (A := R)
      rw [hP, h0, add_zero] at hadd
      exact hadd
    have h_le_RP : ringKrullDim R ≤ ringKrullDim P := by
      refine Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap P R)) ?_
      intro q₁ q₂ hlt
      have h_le : q₁.asIdeal ≤ q₂.asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal q₁ q₂).mpr (le_of_lt hlt)
      have h_not_le : ¬ (q₂.asIdeal : Set R) ⊆ (q₁.asIdeal : Set R) :=
        fun hsub => not_le_of_gt hlt ((PrimeSpectrum.asIdeal_le_asIdeal q₂ q₁).mp hsub)
      obtain ⟨x, hxq₂, hxq₁⟩ := Set.not_subset.mp h_not_le
      have h_under_lt : Ideal.under P q₁.asIdeal < Ideal.under P q₂.asIdeal :=
        Ideal.under_lt_under_of_integral_mem_sdiff (R := P) h_le ⟨hxq₂, hxq₁⟩
          (Algebra.IsIntegral.isIntegral x)
      exact lt_of_le_of_ne
        ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp (le_of_lt h_under_lt))
        (fun heq => ne_of_lt h_under_lt (congrArg PrimeSpectrum.asIdeal heq))
    have h_lift_chain :
        ∀ (m : ℕ) (p : LTSeries (PrimeSpectrum P)),
          p.length = m →
          ∃ q : LTSeries (PrimeSpectrum R),
            q.length = m ∧ Ideal.under P q.last.asIdeal = p.last.asIdeal := by
      intro m
      induction m with
      | zero =>
        intro p _
        have h_bot : Ideal.under P (⊥ : Ideal R) ≤ p.last.asIdeal := by
          intro y hy
          rw [Ideal.under_def, Ideal.mem_comap, Ideal.mem_bot] at hy
          have hy0 : y = 0 := hg_inj (hy.trans (map_zero g).symm)
          rw [hy0]
          exact p.last.asIdeal.zero_mem
        obtain ⟨Q₀, _, hQ₀_prime, hQ₀_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (R := P) (S := R)
            p.last.asIdeal (⊥ : Ideal R) h_bot
        exact ⟨RelSeries.singleton _ ⟨Q₀, hQ₀_prime⟩, rfl, hQ₀_under⟩
      | succ m ih =>
        intro p hpm
        let p' : LTSeries (PrimeSpectrum P) := p.eraseLast
        have hp'_len : p'.length = m := by
          dsimp [p']
          rw [RelSeries.eraseLast_length, hpm]
          rfl
        have hp'_lt : p'.last < p.last :=
          p.eraseLast_last_rel_last (by omega)
        obtain ⟨q', hq'_len, hq'_under⟩ := ih p' hp'_len
        have h_le_under : Ideal.under P q'.last.asIdeal ≤ p.last.asIdeal := by
          rw [hq'_under]
          exact (PrimeSpectrum.asIdeal_le_asIdeal _ _).mpr (le_of_lt hp'_lt)
        obtain ⟨Q_next, hQ_ge, hQ_prime, hQ_under⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral_of_isPrime (R := P) (S := R)
            p.last.asIdeal q'.last.asIdeal h_le_under
        have h_lt_Q : q'.last < (⟨Q_next, hQ_prime⟩ : PrimeSpectrum R) := by
          refine lt_of_le_of_ne ((PrimeSpectrum.asIdeal_le_asIdeal _ _).mp hQ_ge) ?_
          intro h_eq
          have h_id_eq : q'.last.asIdeal = Q_next := congrArg PrimeSpectrum.asIdeal h_eq
          have h_p_eq : p'.last = p.last := by
            apply PrimeSpectrum.ext
            rw [← hq'_under, h_id_eq, hQ_under]
          exact ne_of_lt hp'_lt h_p_eq
        refine ⟨q'.snoc ⟨Q_next, hQ_prime⟩ h_lt_Q, ?_, ?_⟩
        · rw [RelSeries.snoc_length, hq'_len]
        · rw [RelSeries.last_snoc]
          exact hQ_under
    have h_le_PR : ringKrullDim P ≤ ringKrullDim R := by
      change ⨆ (p : LTSeries (PrimeSpectrum P)), (p.length : WithBot ℕ∞) ≤ ringKrullDim R
      refine iSup_le fun p => ?_
      obtain ⟨q, hq_len, _⟩ := h_lift_chain p.length p rfl
      rw [← hq_len]
      exact Order.LTSeries.length_le_krullDim q
    exact ⟨s, h_tr_kR.trans h_tr_RK, (le_antisymm h_le_RP h_le_PR).trans h_dim_P⟩

  
  have hS3 :
      ∀ (X_top : Type u) [TopologicalSpace X_top] [Nonempty X_top] (d : WithBot ℕ∞),
        (∀ x : X_top, ∃ V : TopologicalSpace.Opens X_top,
          x ∈ V ∧ topologicalKrullDim ↥V = d) →
        topologicalKrullDim X_top = d := by
    intro X_top _ hNeX d hCover
    apply le_antisymm
    · change ⨆ (p : LTSeries (TopologicalSpace.IrreducibleCloseds X_top)),
        (p.length : WithBot ℕ∞) ≤ d
      refine iSup_le fun p => ?_
      obtain ⟨x, hx0⟩ := (p 0).isIrreducible.nonempty
      obtain ⟨V, hxV, hVdim⟩ := hCover x
      have hv_emb : Topology.IsOpenEmbedding (Subtype.val : ↥V → X_top) := V.isOpenEmbedding'
      let c : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥V := fun i =>
        have hxi : x ∈ (p i : Set X_top) := p.monotone (Fin.zero_le i) hx0
        have hne_i : ((p i : Set X_top) ∩ Set.range (Subtype.val : ↥V → X_top)).Nonempty :=
          ⟨x, hxi, ⟨⟨x, hxV⟩, rfl⟩⟩
        ⟨(Subtype.val : ↥V → X_top) ⁻¹' (p i : Set X_top),
         (p i).isIrreducible.preimage hv_emb hne_i,
         (p i).isClosed.preimage continuous_subtype_val⟩
      have hc_strict : ∀ i : Fin p.length, c i.castSucc < c i.succ := by
        intro i
        have hp_lt : p i.castSucc < p i.succ := p.step i
        have hc_le : c i.castSucc ≤ c i.succ := fun z hz => le_of_lt hp_lt hz
        refine lt_of_le_of_ne hc_le ?_
        intro hc_eq
        have hp_not_le : ¬ (p i.succ : Set X_top) ⊆ (p i.castSucc : Set X_top) :=
          not_le_of_gt hp_lt
        obtain ⟨y, hy_succ, hy_not_cast⟩ := Set.not_subset.mp hp_not_le
        have hx_succ : x ∈ (p i.succ : Set X_top) := p.monotone (Fin.zero_le i.succ) hx0
        obtain ⟨w, hw_succ, hw_not_cast, hw_V⟩ :=
          (p i.succ).isIrreducible.isPreirreducible
            ((p i.castSucc : Set X_top)ᶜ) (V : Set X_top)
            (p i.castSucc).isClosed.isOpen_compl V.isOpen
            ⟨y, hy_succ, hy_not_cast⟩ ⟨x, hx_succ, hxV⟩
        have hw_c_succ : (⟨w, hw_V⟩ : ↥V) ∈ c i.succ := hw_succ
        rw [← hc_eq] at hw_c_succ
        exact hw_not_cast hw_c_succ
      let q : LTSeries (TopologicalSpace.IrreducibleCloseds ↥V) := ⟨p.length, c, hc_strict⟩
      calc
        (p.length : WithBot ℕ∞) = (q.length : WithBot ℕ∞) := rfl
        _ ≤ topologicalKrullDim ↥V := Order.LTSeries.length_le_krullDim q
        _ = d := hVdim
    · obtain ⟨x₀⟩ := hNeX
      obtain ⟨V₀, _, hV₀⟩ := hCover x₀
      rw [← hV₀]
      exact topologicalKrullDim_subspace_le X_top (V₀ : Set X_top)

  
  have hS4 :
      ∀ (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral Z.left →
        IsProjectiveOverField k Z →
        ∃ (K : Type u) (_ : Field K) (_ : Algebra k K),
          ∀ (U : Z.left.Opens), AlgebraicGeometry.IsAffineOpen U → Nonempty ↥U →
            ∃ (R_U : Type u) (_ : CommRing R_U) (_ : IsDomain R_U) (_ : Algebra k R_U)
              (_ : Algebra.FiniteType k R_U) (_ : Algebra R_U K)
              (_ : IsScalarTower k R_U K) (_ : IsFractionRing R_U K),
              topologicalKrullDim ↥U = ringKrullDim R_U := by
    intro Z hIntZ hProjZ
    haveI hLFT_Z : AlgebraicGeometry.LocallyOfFiniteType Z.hom := by
      rcases hProjZ with ⟨N, ι, hCl⟩
      haveI : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
      haveI hLFT_PN : AlgebraicGeometry.LocallyOfFiniteType (weilProjectiveSpaceOver k N).hom := by
        let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
        letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
        haveI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
          ⟨fun c x p => smul_mul_assoc c (x : MvPolynomial (Fin (N + 1)) k) p⟩
        haveI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
          Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
        have hSurj0 : Function.Surjective (algebraMap k ↥(𝒜 0)) := by
          intro z
          have hz0 : z.1 ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := z.2
          rw [MvPolynomial.homogeneousSubmodule_zero, Submodule.mem_one] at hz0
          obtain ⟨c, hc⟩ := hz0
          exact ⟨c, Subtype.ext hc⟩
        haveI : Nontrivial ↥(𝒜 0) :=
          ⟨⟨0, 1, fun h =>
            zero_ne_one (congrArg Subtype.val h : (0 : MvPolynomial (Fin (N + 1)) k) = 1)⟩⟩
        let e0 := RingEquiv.ofBijective (algebraMap k ↥(𝒜 0))
          ⟨RingHom.injective (algebraMap k ↥(𝒜 0)), hSurj0⟩
        haveI : CategoryTheory.IsIso
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) := by
          haveI : CategoryTheory.IsIso (CommRingCat.ofHom (algebraMap k ↥(𝒜 0))) :=
            ⟨⟨CommRingCat.ofHom e0.symm.toRingHom,
              CommRingCat.hom_ext (RingHom.ext e0.symm_apply_apply),
              CommRingCat.hom_ext (RingHom.ext e0.apply_symm_apply)⟩⟩
          infer_instance
        dsimp [weilProjectiveSpaceOver]
        infer_instance
      rw [← CategoryTheory.Over.w ι]
      infer_instance
    haveI : AlgebraicGeometry.IsIntegral Z.left := hIntZ
    haveI hIrredZ : IrreducibleSpace ↥Z.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral Z.left
    let z₀ : ↥Z.left := Classical.choice hIrredZ.toNonempty
    haveI : Nonempty ↥(⊤ : Z.left.Opens) := ⟨⟨z₀, trivial⟩⟩
    haveI : Nonempty ↥(⊤ : Z.left.Opens).toScheme := ⟨⟨z₀, trivial⟩⟩
    let K : Type u := ↑Z.left.functionField
    let R_k : CommRingCat.{u} := CommRingCat.of k
    let e_Γk := AlgebraicGeometry.Scheme.ΓSpecIso R_k
    have hSurj_Γk : Function.Surjective e_Γk.inv.hom := fun x =>
      ⟨e_Γk.hom.hom x,
        congrArg
          (fun m : (AlgebraicGeometry.Spec R_k).presheaf.obj (Opposite.op ⊤) ⟶
              (AlgebraicGeometry.Spec R_k).presheaf.obj (Opposite.op ⊤) =>
            CommRingCat.Hom.hom m x)
          e_Γk.hom_inv_id⟩
    let φ_top : R_k ⟶ Z.left.presheaf.obj (Opposite.op ⊤) :=
      e_Γk.inv ≫ Z.hom.appLE ⊤ ⊤ le_top
    letI alg_kK : Algebra k K := ((Z.left.germToFunctionField ⊤).hom.comp φ_top.hom).toAlgebra
    refine ⟨K, inferInstance, alg_kK, ?_⟩
    intro U hAffU hU
    haveI : Nonempty ↥U := hU
    haveI : Nonempty ↥U.toScheme := hU
    let R_U : Type u := ↑(Z.left.presheaf.obj (Opposite.op U))
    haveI : IsDomain R_U := AlgebraicGeometry.IsIntegral.component_integral U
    haveI : IsFractionRing R_U K :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z.left U hAffU
    let φ_U : R_k ⟶ Z.left.presheaf.obj (Opposite.op U) :=
      e_Γk.inv ≫ Z.hom.appLE ⊤ U le_top
    letI alg_kRU : Algebra k R_U := φ_U.hom.toAlgebra
    have hFT_app : (Z.hom.appLE ⊤ U le_top).hom.FiniteType :=
      Z.hom.finiteType_appLE (AlgebraicGeometry.isAffineOpen_top _) hAffU le_top
    have hFT_Γk : e_Γk.inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective e_Γk.inv.hom hSurj_Γk
    haveI hFT_RU : Algebra.FiniteType k R_U := RingHom.FiniteType.comp hFT_app hFT_Γk
    have h_germ_eq : φ_top ≫ Z.left.germToFunctionField ⊤ =
        φ_U ≫ Z.left.germToFunctionField U := by
      let i_U : U ⟶ ⊤ := CategoryTheory.homOfLE (le_top : U ≤ ⊤)
      calc
        (e_Γk.inv ≫ Z.hom.appLE ⊤ ⊤ le_top) ≫ Z.left.germToFunctionField ⊤
          = e_Γk.inv ≫ Z.hom.appLE ⊤ ⊤ le_top ≫
              (Z.left.presheaf.map i_U.op ≫ Z.left.germToFunctionField U) := by
              rw [Z.left.presheaf.germ_res i_U _ _]
              simp only [CategoryTheory.Category.assoc]
        _ = e_Γk.inv ≫ (Z.hom.appLE ⊤ ⊤ le_top ≫ Z.left.presheaf.map i_U.op) ≫
              Z.left.germToFunctionField U := by
              simp only [CategoryTheory.Category.assoc]
        _ = (e_Γk.inv ≫ Z.hom.appLE ⊤ U le_top) ≫ Z.left.germToFunctionField U := by
              rw [Z.hom.appLE_map le_top i_U.op]
              simp only [CategoryTheory.Category.assoc]
    haveI hTower_RU : IsScalarTower k R_U K :=
      IsScalarTower.of_algebraMap_eq fun c =>
        congrArg (fun m : R_k ⟶ Z.left.functionField => m.hom c) h_germ_eq
    have hDimU : topologicalKrullDim ↥U = ringKrullDim R_U := by
      have h1 : topologicalKrullDim ↥U.toScheme =
          topologicalKrullDim ↥(AlgebraicGeometry.Spec (Z.left.presheaf.obj (Opposite.op U))) :=
        (AlgebraicGeometry.Scheme.homeoOfIso hAffU.isoSpec).isHomeomorph.topologicalKrullDim_eq
      exact h1.trans (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim R_U)
    exact ⟨R_U, inferInstance, inferInstance, alg_kRU, hFT_RU, inferInstance,
      hTower_RU, inferInstance, hDimU⟩

  
  obtain ⟨M₀, q_mv, hq_surj⟩ :=
    Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (inferInstance : Algebra.FiniteType k A₀)
  let P_M₀ := weilProjectiveSpaceOver k M₀
  obtain ⟨hSep_P, ι_aff, hOpen_aff, hι_hom⟩ := hStdChart M₀
  haveI : AlgebraicGeometry.IsSeparated P_M₀.hom := hSep_P
  haveI : AlgebraicGeometry.IsOpenImmersion ι_aff := hOpen_aff
  let i_cl : AlgebraicGeometry.Spec (CommRingCat.of A₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin M₀) k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom q_mv.toRingHom)
  haveI : AlgebraicGeometry.IsClosedImmersion i_cl :=
    AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
      (CommRingCat.ofHom q_mv.toRingHom) hq_surj
  let j₀ : AlgebraicGeometry.Spec (CommRingCat.of A₀) ⟶ P_M₀.left := i_cl ≫ ι_aff
  haveI : AlgebraicGeometry.IsImmersion j₀ := inferInstance
  have hj₀_hom : j₀ ≫ P_M₀.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)) := by
    dsimp [j₀, i_cl]
    rw [CategoryTheory.Category.assoc, hι_hom, ← AlgebraicGeometry.Spec.map_comp]
    congr 1
    exact CommRingCat.hom_ext (RingHom.ext q_mv.commutes)
  haveI : AlgebraicGeometry.QuasiCompact j₀ := by
    haveI : AlgebraicGeometry.QuasiCompact (j₀ ≫ P_M₀.hom) := by
      rw [hj₀_hom]
      infer_instance
    exact AlgebraicGeometry.QuasiCompact.of_comp j₀ P_M₀.hom

  obtain ⟨hInt_Vcl, U_cl, e_cl, hAff_Ucl, hNe_Ucl, he_cl_j₀, hIC_imp⟩ := hS1 P_M₀.left j₀
  let V_cl : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (j₀.imageι ≫ P_M₀.hom)
  have hCl_imageι : AlgebraicGeometry.IsClosedImmersion j₀.imageι := inferInstance
  have hProj_Vcl : IsProjectiveOverField k V_cl :=
    ⟨M₀, CategoryTheory.Over.homMk j₀.imageι rfl, hCl_imageι⟩

  obtain ⟨K, hFieldK, hAlgK, hPkg⟩ := hS4 V_cl hInt_Vcl hProj_Vcl
  obtain ⟨R_cl, hCommRcl, hDomRcl, hAlgkRcl, hFTRcl, hAlgRKcl, hTowerRcl, hFracRcl, hDim_Ucl_R⟩ :=
    hPkg U_cl hAff_Ucl hNe_Ucl
  obtain ⟨s₀, hs₀_tr, hs₀_ring⟩ :=
    @hS2 R_cl K hCommRcl hDomRcl hAlgkRcl hFTRcl hFieldK hAlgK hAlgRKcl hTowerRcl hFracRcl
  have hDim_Ucl_s₀ : topologicalKrullDim ↥U_cl = (s₀ : WithBot ℕ∞) :=
    hDim_Ucl_R.trans hs₀_ring

  have ⟨⟨u₀, _⟩⟩ := hNe_Ucl
  haveI : Nonempty ↥V_cl.left := ⟨u₀⟩
  have hDim_Vcl_s₀ : topologicalKrullDim V_cl.left = (s₀ : WithBot ℕ∞) := by
    apply hS3 ↥V_cl.left (s₀ : WithBot ℕ∞)
    intro x
    obtain ⟨W, hAffW, hxW, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    obtain ⟨R_W, hCommRW, hDomRW, hAlgkRW, hFTRW, hAlgRKW, hTowerRW, hFracRW, hDim_W_R⟩ :=
      hPkg W hAffW ⟨⟨x, hxW⟩⟩
    obtain ⟨s_W, hsW_tr, hsW_ring⟩ :=
      @hS2 R_W K hCommRW hDomRW hAlgkRW hFTRW hFieldK hAlgK hAlgRKW hTowerRW hFracRW
    have hs_eq : s_W = s₀ := (Nat.cast_injective (R := Cardinal.{u})) (hsW_tr.trans hs₀_tr.symm)
    exact ⟨W, hxW, hDim_W_R.trans (hsW_ring.trans (congrArg _ hs_eq))⟩

  have hDim_Spec_Ucl :
      topologicalKrullDim ↥(AlgebraicGeometry.Spec (CommRingCat.of A₀)) =
        topologicalKrullDim ↥U_cl.toScheme :=
    (AlgebraicGeometry.Scheme.homeoOfIso e_cl).isHomeomorph.topologicalKrullDim_eq
  have hDim_Vcl : topologicalKrullDim V_cl.left = ringKrullDim A₀ :=
    hDim_Vcl_s₀.trans (hDim_Ucl_s₀.symm.trans
      (hDim_Spec_Ucl.symm.trans (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A₀)))

  have hBase_cl :
      e_cl.hom ≫ (U_cl.ι ≫ V_cl.hom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₀)) := by
    change e_cl.hom ≫ (U_cl.ι ≫ (j₀.imageι ≫ P_M₀.hom)) = _
    rw [← CategoryTheory.Category.assoc U_cl.ι, ← CategoryTheory.Category.assoc e_cl.hom,
      he_cl_j₀, hj₀_hom]

  exact ⟨V_cl, U_cl, e_cl, hInt_Vcl, hProj_Vcl, hDim_Vcl, hAff_Ucl, hNe_Ucl, hBase_cl, hIC_imp⟩

theorem weil_finite_birational_isIso_over_integrallyClosed_affineOpen {X Y : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X Y)
    (hIntX : AlgebraicGeometry.IsIntegral X)
    (hIntY : AlgebraicGeometry.IsIntegral Y)
    [AlgebraicGeometry.IsFinite f]
    (U_iso U : Y.Opens)
    (hNe_iso : Nonempty ↥U_iso)
    [CategoryTheory.IsIso (f ∣_ U_iso)]
    (hAffU : AlgebraicGeometry.IsAffineOpen U)
    (hNeU : Nonempty ↥U)
    (hIC : IsIntegrallyClosed ↑(Y.presheaf.obj (Opposite.op U))) :
    AlgebraicGeometry.IsAffineOpen (f ⁻¹ᵁ U) ∧ CategoryTheory.IsIso (f ∣_ U) :=
by
  have hAff_preU : AlgebraicGeometry.IsAffineOpen (f ⁻¹ᵁ U) := hAffU.preimage f
  refine ⟨hAff_preU, ?_⟩
  have hAffIsoIff : ∀ (W : Y.Opens) (hAffW : AlgebraicGeometry.IsAffineOpen W)
      (hAffPreW : AlgebraicGeometry.IsAffineOpen (f ⁻¹ᵁ W)),
      CategoryTheory.IsIso (f ∣_ W) ↔
        Function.Bijective (AlgebraicGeometry.Scheme.Hom.app f W).hom := by
    intro W hAffW hAffPreW
    let φ := AlgebraicGeometry.Scheme.Hom.app f W
    have hSpecNat :
        AlgebraicGeometry.Spec.map φ ≫ hAffW.isoSpec.inv =
          hAffPreW.isoSpec.inv ≫ (f ∣_ W) := by
      apply (CategoryTheory.cancel_mono W.ι).mp
      have h1 := AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hAffW hAffPreW le_rfl
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE] at h1
      calc (AlgebraicGeometry.Spec.map φ ≫ hAffW.isoSpec.inv) ≫ W.ι
          = AlgebraicGeometry.Spec.map φ ≫ hAffW.fromSpec := by
              rw [CategoryTheory.Category.assoc, hAffW.isoSpec_inv_ι]
        _ = hAffPreW.fromSpec ≫ f := h1
        _ = (hAffPreW.isoSpec.inv ≫ (f ⁻¹ᵁ W).ι) ≫ f := by
              rw [hAffPreW.isoSpec_inv_ι]
        _ = hAffPreW.isoSpec.inv ≫ ((f ⁻¹ᵁ W).ι ≫ f) := CategoryTheory.Category.assoc _ _ _
        _ = hAffPreW.isoSpec.inv ≫ ((f ∣_ W) ≫ W.ι) := by
              rw [← AlgebraicGeometry.morphismRestrict_ι f W]
        _ = (hAffPreW.isoSpec.inv ≫ (f ∣_ W)) ≫ W.ι :=
              (CategoryTheory.Category.assoc _ _ _).symm
    constructor
    · intro hIsoW
      have hSpecEq :
          AlgebraicGeometry.Spec.map φ =
            hAffPreW.isoSpec.inv ≫ (f ∣_ W) ≫ hAffW.isoSpec.hom := by
        calc AlgebraicGeometry.Spec.map φ
            = (AlgebraicGeometry.Spec.map φ ≫ hAffW.isoSpec.inv) ≫ hAffW.isoSpec.hom := by
                rw [CategoryTheory.Category.assoc, CategoryTheory.Iso.inv_hom_id,
                  CategoryTheory.Category.comp_id]
          _ = (hAffPreW.isoSpec.inv ≫ (f ∣_ W)) ≫ hAffW.isoSpec.hom := by rw [hSpecNat]
          _ = hAffPreW.isoSpec.inv ≫ (f ∣_ W) ≫ hAffW.isoSpec.hom :=
                CategoryTheory.Category.assoc _ _ _
      have hIsoSpec : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map φ) := by
        rw [hSpecEq]
        infer_instance
      let φ_inv := AlgebraicGeometry.Spec.preimage (CategoryTheory.inv (AlgebraicGeometry.Spec.map φ))
      have h_hom_inv : φ ≫ φ_inv = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          CategoryTheory.IsIso.inv_hom_id, AlgebraicGeometry.Spec.map_id]
      have h_inv_hom : φ_inv ≫ φ = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          CategoryTheory.IsIso.hom_inv_id, AlgebraicGeometry.Spec.map_id]
      have hIsoφ : CategoryTheory.IsIso φ := ⟨⟨φ_inv, h_hom_inv, h_inv_hom⟩⟩
      exact CategoryTheory.ConcreteCategory.bijective_of_isIso φ
    · intro hBij
      let e := RingEquiv.ofBijective φ.hom hBij
      let φ_inv : X.presheaf.obj (Opposite.op (f ⁻¹ᵁ W)) ⟶ Y.presheaf.obj (Opposite.op W) :=
        CommRingCat.ofHom e.symm.toRingHom
      have h_hom_inv : φ ≫ φ_inv = 𝟙 _ := by
        ext x
        exact e.symm_apply_apply x
      have h_inv_hom : φ_inv ≫ φ = 𝟙 _ := by
        ext x
        exact e.apply_symm_apply x
      have hIsoφ : CategoryTheory.IsIso φ := ⟨⟨φ_inv, h_hom_inv, h_inv_hom⟩⟩
      have hfW : f ∣_ W = hAffPreW.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ ≫ hAffW.isoSpec.inv := by
        calc f ∣_ W
            = hAffPreW.isoSpec.hom ≫ (hAffPreW.isoSpec.inv ≫ (f ∣_ W)) := by
                rw [← CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id,
                  CategoryTheory.Category.id_comp]
          _ = hAffPreW.isoSpec.hom ≫ AlgebraicGeometry.Spec.map φ ≫ hAffW.isoSpec.inv := by
                rw [← hSpecNat]
      rw [hfW]
      infer_instance
  have hIrrY : IrreducibleSpace ↥Y :=
    @AlgebraicGeometry.irreducibleSpace_of_isIntegral Y hIntY
  have ⟨u₀, hu₀⟩ := hNeU
  have ⟨v₀, hv₀⟩ := hNe_iso
  obtain ⟨y, -, hy_inter⟩ :=
    hIrrY.isIrreducible_univ.isPreirreducible U.carrier U_iso.carrier U.isOpen U_iso.isOpen
      ⟨u₀, trivial, hu₀⟩ ⟨v₀, trivial, hv₀⟩
  have hyU : y ∈ U := hy_inter.1
  have hy_iso : y ∈ U_iso := hy_inter.2
  let y_iso : ↥U_iso.toScheme := ⟨y, hy_iso⟩
  let x_iso : ↥(f ⁻¹ᵁ U_iso).toScheme := (CategoryTheory.inv (f ∣_ U_iso)).base y_iso
  have hf_x : f.base x_iso.1 = y := by
    calc f.base x_iso.1
        = f.base ((f ⁻¹ᵁ U_iso).ι.base x_iso) := by
            rw [AlgebraicGeometry.Scheme.Opens.ι_apply (f ⁻¹ᵁ U_iso) x_iso]
      _ = ((f ⁻¹ᵁ U_iso).ι ≫ f).base x_iso :=
            (AlgebraicGeometry.Scheme.Hom.comp_apply (f ⁻¹ᵁ U_iso).ι f x_iso).symm
      _ = ((f ∣_ U_iso) ≫ U_iso.ι).base x_iso := by
            rw [← AlgebraicGeometry.morphismRestrict_ι f U_iso]
      _ = (CategoryTheory.inv (f ∣_ U_iso) ≫ ((f ∣_ U_iso) ≫ U_iso.ι)).base y_iso :=
            (AlgebraicGeometry.Scheme.Hom.comp_apply
              (CategoryTheory.inv (f ∣_ U_iso)) ((f ∣_ U_iso) ≫ U_iso.ι) y_iso).symm
      _ = U_iso.ι.base y_iso := by
            rw [← CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
              CategoryTheory.Category.id_comp]
      _ = y := AlgebraicGeometry.Scheme.Opens.ι_apply U_iso y_iso
  have hx_preU : x_iso.1 ∈ f ⁻¹ᵁ U := by
    change f.base x_iso.1 ∈ U
    rwa [hf_x]
  have hNe_preU : Nonempty ↥(f ⁻¹ᵁ U) := ⟨⟨x_iso.1, hx_preU⟩⟩
  obtain ⟨g, hg_le, hy_g⟩ := hAffU.exists_basicOpen_le (⟨y, hy_iso⟩ : ↥U_iso) hyU
  have hg : g ≠ 0 := by
    intro hg0
    rw [hg0, AlgebraicGeometry.Scheme.basicOpen_zero] at hy_g
    exact hy_g
  let V : Y.Opens := Y.basicOpen g
  have hPre_le : f ⁻¹ᵁ V ≤ f ⁻¹ᵁ U_iso := (TopologicalSpace.Opens.map f.base).monotone hg_le
  have hPbV := AlgebraicGeometry.isPullback_morphismRestrict f V
  have h_comm :
      𝟙 V.toScheme ≫ V.ι =
        (Y.homOfLE hg_le ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ (f ⁻¹ᵁ U_iso).ι) ≫ f := by
    calc 𝟙 V.toScheme ≫ V.ι
        = V.ι := CategoryTheory.Category.id_comp _
      _ = Y.homOfLE hg_le ≫ U_iso.ι := (AlgebraicGeometry.Scheme.homOfLE_ι Y hg_le).symm
      _ = Y.homOfLE hg_le ≫ (CategoryTheory.inv (f ∣_ U_iso) ≫ (f ∣_ U_iso)) ≫ U_iso.ι := by
            rw [CategoryTheory.IsIso.inv_hom_id, CategoryTheory.Category.id_comp]
      _ = Y.homOfLE hg_le ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ ((f ∣_ U_iso) ≫ U_iso.ι) := by
            simp only [CategoryTheory.Category.assoc]
      _ = Y.homOfLE hg_le ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ ((f ⁻¹ᵁ U_iso).ι ≫ f) := by
            rw [AlgebraicGeometry.morphismRestrict_ι f U_iso]
      _ = (Y.homOfLE hg_le ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ (f ⁻¹ᵁ U_iso).ι) ≫ f := by
            simp only [CategoryTheory.Category.assoc]
  let g_inv : V.toScheme ⟶ (f ⁻¹ᵁ V).toScheme :=
    hPbV.lift (𝟙 V.toScheme)
      (Y.homOfLE hg_le ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ (f ⁻¹ᵁ U_iso).ι) h_comm
  have h_inv_hom : g_inv ≫ (f ∣_ V) = 𝟙 V.toScheme := hPbV.lift_fst _ _ h_comm
  have h_nat_le : (f ∣_ V) ≫ Y.homOfLE hg_le = X.homOfLE hPre_le ≫ (f ∣_ U_iso) := by
    apply (CategoryTheory.cancel_mono U_iso.ι).mp
    calc ((f ∣_ V) ≫ Y.homOfLE hg_le) ≫ U_iso.ι
        = (f ∣_ V) ≫ (Y.homOfLE hg_le ≫ U_iso.ι) := CategoryTheory.Category.assoc _ _ _
      _ = (f ∣_ V) ≫ V.ι := by rw [AlgebraicGeometry.Scheme.homOfLE_ι]
      _ = (f ⁻¹ᵁ V).ι ≫ f := AlgebraicGeometry.morphismRestrict_ι f V
      _ = (X.homOfLE hPre_le ≫ (f ⁻¹ᵁ U_iso).ι) ≫ f := by
            rw [AlgebraicGeometry.Scheme.homOfLE_ι]
      _ = X.homOfLE hPre_le ≫ ((f ⁻¹ᵁ U_iso).ι ≫ f) := CategoryTheory.Category.assoc _ _ _
      _ = X.homOfLE hPre_le ≫ ((f ∣_ U_iso) ≫ U_iso.ι) := by
            rw [← AlgebraicGeometry.morphismRestrict_ι f U_iso]
      _ = (X.homOfLE hPre_le ≫ (f ∣_ U_iso)) ≫ U_iso.ι :=
            (CategoryTheory.Category.assoc _ _ _).symm
  have h_hom_inv : (f ∣_ V) ≫ g_inv = 𝟙 (f ⁻¹ᵁ V).toScheme := by
    apply hPbV.hom_ext
    · rw [CategoryTheory.Category.assoc, h_inv_hom, CategoryTheory.Category.comp_id,
        CategoryTheory.Category.id_comp]
    · calc ((f ∣_ V) ≫ g_inv) ≫ (f ⁻¹ᵁ V).ι
          = (f ∣_ V) ≫ (g_inv ≫ (f ⁻¹ᵁ V).ι) := CategoryTheory.Category.assoc _ _ _
        _ = (f ∣_ V) ≫ (Y.homOfLE hg_le ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ (f ⁻¹ᵁ U_iso).ι) := by
              rw [hPbV.lift_snd]
        _ = ((f ∣_ V) ≫ Y.homOfLE hg_le) ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ (f ⁻¹ᵁ U_iso).ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = (X.homOfLE hPre_le ≫ (f ∣_ U_iso)) ≫ CategoryTheory.inv (f ∣_ U_iso) ≫ (f ⁻¹ᵁ U_iso).ι := by
              rw [h_nat_le]
        _ = X.homOfLE hPre_le ≫ ((f ∣_ U_iso) ≫ CategoryTheory.inv (f ∣_ U_iso)) ≫ (f ⁻¹ᵁ U_iso).ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = X.homOfLE hPre_le ≫ (f ⁻¹ᵁ U_iso).ι := by
              rw [CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.id_comp]
        _ = (f ⁻¹ᵁ V).ι := AlgebraicGeometry.Scheme.homOfLE_ι X hPre_le
        _ = 𝟙 (f ⁻¹ᵁ V).toScheme ≫ (f ⁻¹ᵁ V).ι := (CategoryTheory.Category.id_comp _).symm
  have hIso_V : CategoryTheory.IsIso (f ∣_ V) := ⟨⟨g_inv, h_hom_inv, h_inv_hom⟩⟩
  let A := ↑(Y.presheaf.obj (Opposite.op U))
  let C := ↑(X.presheaf.obj (Opposite.op (f ⁻¹ᵁ U)))
  let ψ : A →+* C := (AlgebraicGeometry.Scheme.Hom.app f U).hom
  have hAff_V : AlgebraicGeometry.IsAffineOpen V := hAffU.basicOpen g
  have hAff_preV : AlgebraicGeometry.IsAffineOpen (f ⁻¹ᵁ V) := hAff_V.preimage f
  have hBij_appV : Function.Bijective (AlgebraicGeometry.Scheme.Hom.app f V).hom :=
    (hAffIsoIff V hAff_V hAff_preV).mp hIso_V
  let A_g := ↑(Y.presheaf.obj (Opposite.op (Y.basicOpen g)))
  let C_g := ↑(X.presheaf.obj (Opposite.op (X.basicOpen (ψ g))))
  haveI : IsLocalization.Away g A_g := hAffU.isLocalization_basicOpen g
  haveI : IsLocalization.Away (ψ g) C_g := hAff_preU.isLocalization_basicOpen (ψ g)
  let L : A_g →+* C_g := IsLocalization.Away.map A_g C_g ψ g
  have hApp_eq := AlgebraicGeometry.IsAffineOpen.app_basicOpen_eq_away_map f hAffU hAff_preU g
  let ρ := X.presheaf.map (CategoryTheory.eqToHom (f.preimage_basicOpen g)).op
  have hBij_ρ : Function.Bijective ρ.hom := CategoryTheory.ConcreteCategory.bijective_of_isIso ρ
  have hComp_fn :
      ⇑(AlgebraicGeometry.Scheme.Hom.app f V).hom = ⇑ρ.hom ∘ ⇑L := by
    change ⇑(AlgebraicGeometry.Scheme.Hom.app f (Y.basicOpen g)).hom = ⇑ρ.hom ∘ ⇑L
    rw [hApp_eq]
    rfl
  have hBij_L : Function.Bijective L := by
    refine ⟨fun x₁ x₂ hx => ?_, fun y₀ => ?_⟩
    · apply hBij_appV.1
      have h1 : (⇑(AlgebraicGeometry.Scheme.Hom.app f V).hom) x₁ =
          (⇑(AlgebraicGeometry.Scheme.Hom.app f V).hom) x₂ := by
        rw [hComp_fn]
        exact congrArg ρ.hom hx
      exact h1
    · obtain ⟨x₀, hx₀⟩ := hBij_appV.2 (ρ.hom y₀)
      refine ⟨x₀, hBij_ρ.1 ?_⟩
      have hx₀' : (⇑ρ.hom ∘ ⇑L) x₀ = ρ.hom y₀ := by
        rw [← hComp_fn]
        exact hx₀
      exact hx₀'
  haveI : IsDomain A := @AlgebraicGeometry.IsIntegral.component_integral Y hIntY U hNeU
  haveI : IsDomain C := @AlgebraicGeometry.IsIntegral.component_integral X hIntX (f ⁻¹ᵁ U) hNe_preU
  have hInt_ψ : ψ.IsIntegral := AlgebraicGeometry.IsIntegralHom.isIntegral_app f U hAffU
  have hSub_A : Submonoid.powers g ≤ nonZeroDivisors A := by
    intro m hm
    obtain ⟨k, rfl⟩ := hm
    exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hg)
  have halgA_inj : Function.Injective (algebraMap A A_g) :=
    IsLocalization.injective A_g hSub_A
  have hψ_inj : Function.Injective ψ := by
    intro a₁ a₂ ha
    apply halgA_inj
    apply hBij_L.1
    have hL1 : L (algebraMap A A_g a₁) = algebraMap C C_g (ψ a₁) :=
      IsLocalization.map_eq _ a₁
    have hL2 : L (algebraMap A A_g a₂) = algebraMap C C_g (ψ a₂) :=
      IsLocalization.map_eq _ a₂
    rw [hL1, hL2, ha]
  have hψg : ψ g ≠ 0 := by
    intro h0
    apply hg
    apply hψ_inj
    rw [h0, map_zero]
  have hSub_C : Submonoid.powers (ψ g) ≤ nonZeroDivisors C := by
    intro m hm
    obtain ⟨k, rfl⟩ := hm
    exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero k hψg)
  have halgC_inj : Function.Injective (algebraMap C C_g) :=
    IsLocalization.injective C_g hSub_C
  let K_A := FractionRing A
  have hg_KA : algebraMap A K_A g ≠ 0 := by
    intro h0
    apply hg
    apply IsFractionRing.injective A K_A
    rw [h0, map_zero]
  have hu_g : IsUnit (algebraMap A K_A g) := IsUnit.mk0 _ hg_KA
  let lam : A_g →+* K_A := IsLocalization.Away.lift g hu_g
  have hlam_inj : Function.Injective lam := by
    intro z₁ z₂ hz_eq
    have hz : lam (z₁ - z₂) = 0 := by rw [map_sub, hz_eq, sub_self]
    obtain ⟨n, a, hza⟩ := IsLocalization.Away.surj g (z₁ - z₂)
    have ha_KA : algebraMap A K_A a = 0 := by
      calc algebraMap A K_A a
          = lam (algebraMap A A_g a) := (IsLocalization.Away.lift_eq g hu_g a).symm
        _ = lam ((z₁ - z₂) * (algebraMap A A_g g) ^ n) := by rw [← hza]
        _ = lam (z₁ - z₂) * lam ((algebraMap A A_g g) ^ n) := map_mul _ _ _
        _ = 0 := by rw [hz, zero_mul]
    have ha0 : a = 0 := by
      apply IsFractionRing.injective A K_A
      rw [ha_KA, map_zero]
    rw [ha0, map_zero] at hza
    have hu_g_Ag : IsUnit (algebraMap A A_g g) := IsLocalization.Away.algebraMap_isUnit g
    obtain ⟨u_Ag, hu_Ag_eq⟩ := hu_g_Ag.pow n
    apply sub_eq_zero.mp
    calc z₁ - z₂
        = (z₁ - z₂) * 1 := (mul_one _).symm
      _ = (z₁ - z₂) * (u_Ag.val * u_Ag.inv) := by rw [u_Ag.val_inv]
      _ = ((z₁ - z₂) * u_Ag.val) * u_Ag.inv := (mul_assoc _ _ _).symm
      _ = ((z₁ - z₂) * (algebraMap A A_g g) ^ n) * u_Ag.inv :=
            congrArg (· * u_Ag.inv) (congrArg ((z₁ - z₂) * ·) hu_Ag_eq)
      _ = 0 * u_Ag.inv := by rw [hza]
      _ = 0 := zero_mul _
  let e_L : A_g ≃+* C_g := RingEquiv.ofBijective L hBij_L
  let ι : C →+* K_A := lam.comp (e_L.symm.toRingHom.comp (algebraMap C C_g))
  have hι_inj : Function.Injective ι :=
    hlam_inj.comp (e_L.symm.injective.comp halgC_inj)
  have hι_comp : ι.comp ψ = algebraMap A K_A := by
    ext a
    change lam (e_L.symm (algebraMap C C_g (ψ a))) = algebraMap A K_A a
    have hLa0 : L (algebraMap A A_g a) = algebraMap C C_g (ψ a) :=
      IsLocalization.map_eq _ a
    have hLa : e_L (algebraMap A A_g a) = algebraMap C C_g (ψ a) := hLa0
    rw [← hLa, e_L.symm_apply_apply]
    exact IsLocalization.Away.lift_eq g hu_g a
  have hψ_surj : Function.Surjective ψ := by
    intro c
    have hInt_ιc : (ι.comp ψ).IsIntegralElem (ι c) :=
      RingHom.IsIntegralElem.map (hInt_ψ c) ι
    rw [hι_comp] at hInt_ιc
    have hInt_A : IsIntegral A (ι c) := hInt_ιc
    obtain ⟨a₀, ha₀⟩ := (isIntegrallyClosed_iff K_A).mp hIC hInt_A
    refine ⟨a₀, hι_inj ?_⟩
    calc ι (ψ a₀)
        = (ι.comp ψ) a₀ := rfl
      _ = algebraMap A K_A a₀ := by rw [hι_comp]
      _ = ι c := ha₀
  exact (hAffIsoIff U hAffU hAff_preU).mpr ⟨hψ_inj, hψ_surj⟩

theorem weil_algClosed_etale_affineSpace_pointed_normal_compactification (k : Type u) [Field k] [IsAlgClosed k] (d : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W₀]
    (u₀ : Quiver.Hom W₀ (weilAffineSpaceOver k d).left) [AlgebraicGeometry.Etale u₀]
    (x₀ : ↥W₀) (hx₀ : IsClosed ({x₀} : Set ↥W₀)) :
    (∃ U_W : W₀.Opens,
      AlgebraicGeometry.IsAffineOpen U_W ∧ x₀ ∈ U_W ∧ AlgebraicGeometry.IsIntegral U_W.toScheme) ∧
    ∃ (V_norm : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (U_in W_reg : V_norm.left.Opens)
      (j_in : Quiver.Hom U_in.toScheme W₀)
      (x_norm : ↥V_norm.left),
      AlgebraicGeometry.IsIntegral V_norm.left ∧
      IsProjectiveOverField k V_norm ∧
      topologicalKrullDim V_norm.left = ((d : ℕ) : WithBot ℕ∞) ∧
      AlgebraicGeometry.SmoothOfRelativeDimension d
        (CategoryTheory.CategoryStruct.comp W_reg.ι V_norm.hom) ∧
      topologicalKrullDim ↥((W_reg : Set ↥V_norm.left)ᶜ) + 2 ≤ ((d : ℕ) : WithBot ℕ∞) ∧
      AlgebraicGeometry.IsAffineOpen U_in ∧
      U_in ≤ W_reg ∧
      IsClosed ({x_norm} : Set ↥V_norm.left) ∧
      AlgebraicGeometry.Etale j_in ∧
      CategoryTheory.CategoryStruct.comp j_in
        (CategoryTheory.CategoryStruct.comp u₀ (weilAffineSpaceOver k d).hom) =
        CategoryTheory.CategoryStruct.comp U_in.ι V_norm.hom ∧
      ∃ hx_in : x_norm ∈ U_in, j_in.base ⟨x_norm, hx_in⟩ = x₀ :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  have hNonempty_k : Nonempty ↥S_k :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := k)).mpr inferInstance
  let pt_k : ↥S_k := Classical.choice hNonempty_k
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := by
    ext c
    rw [Ideal.mem_bot]
    refine ⟨fun hc => ?_, fun hc => hc.symm ▸ (pt_k : PrimeSpectrum k).asIdeal.zero_mem⟩
    by_contra hne
    exact (pt_k : PrimeSpectrum k).isPrime.ne_top
      (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hne))

  let p_W₀ : W₀ ⟶ S_k := u₀ ≫ (weilAffineSpaceOver k d).hom
  have hSm_aff : ∀ n : ℕ,
      AlgebraicGeometry.SmoothOfRelativeDimension n (weilAffineSpaceOver k n).hom := by
    intro n
    change AlgebraicGeometry.SmoothOfRelativeDimension n
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin n) k)))
    rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension n)]
    refine RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ ?_
    change RingHom.IsStandardSmoothOfRelativeDimension n (algebraMap k (MvPolynomial (Fin n) k))
    rw [RingHom.isStandardSmoothOfRelativeDimension_algebraMap]
    infer_instance
  have hSm_pW₀ : AlgebraicGeometry.SmoothOfRelativeDimension d p_W₀ := by
    have : AlgebraicGeometry.SmoothOfRelativeDimension d (weilAffineSpaceOver k d).hom :=
      hSm_aff d
    have h0d : AlgebraicGeometry.SmoothOfRelativeDimension (0 + d)
        (u₀ ≫ (weilAffineSpaceOver k d).hom) := inferInstance
    simpa [p_W₀] using h0d

  
  let e_W₀ := W₀.isoSpec
  let B_cat : CommRingCat.{u} := W₀.presheaf.obj (Opposite.op ⊤)
  let B : Type u := ↑B_cat
  let R_d : Type u := MvPolynomial (Fin d) k
  let u₀_spec : AlgebraicGeometry.Spec B_cat ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_d) := e_W₀.inv ≫ u₀
  have hEt_u₀_spec : AlgebraicGeometry.Etale u₀_spec := by
    change AlgebraicGeometry.Etale (e_W₀.inv ≫ u₀)
    infer_instance
  let ψ_R : CommRingCat.of R_d ⟶ B_cat := AlgebraicGeometry.Spec.preimage u₀_spec
  have hmap_ψR : AlgebraicGeometry.Spec.map ψ_R = u₀_spec :=
    AlgebraicGeometry.Spec.map_preimage u₀_spec
  have hEt_ψR : RingHom.Etale ψ_R.hom := by
    rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale), hmap_ψR]
    exact hEt_u₀_spec

  let _ : Algebra R_d B := ψ_R.hom.toAlgebra
  let _ : Algebra k B := (ψ_R.hom.comp (MvPolynomial.C : k →+* R_d)).toAlgebra
  have : IsScalarTower k R_d B := IsScalarTower.of_algebraMap_eq' rfl
  have : Algebra.Etale R_d B := RingHom.etale_algebraMap.mp hEt_ψR
  have : Algebra.FiniteType k B :=
    Algebra.FiniteType.trans (S := R_d) inferInstance inferInstance
  have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing k B

  let q₀_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W₀.hom.base x₀
  let q₀_spec : PrimeSpectrum B := q₀_pt
  have hq₀_pre : ({q₀_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
      e_W₀.inv.base ⁻¹' ({x₀} : Set ↥W₀) := by
    ext z
    simp only [Set.mem_singleton_iff, Set.mem_preimage]
    constructor
    · rintro rfl
      change (e_W₀.hom ≫ e_W₀.inv).base x₀ = x₀
      rw [e_W₀.hom_inv_id]
      rfl
    · intro hz
      dsimp [q₀_pt]
      rw [← hz]
