        refine ⟨B_g.obj U₀, B_g.map u₀, ψ.base p₀,
          ⟨U₀, u₀, CategoryTheory.CategoryStruct.id (B_g.obj U₀), hu₀,
            (CategoryTheory.Category.id_comp _).symm⟩,
          hEt_of_etale_hom (B_g.map u₀), ?_⟩
        exact (AlgebraicGeometry.Scheme.Hom.comp_apply ψ
          (FgtV'.map (B_g.map u₀)).left p₀).symm.trans
          ((congrArg (fun m => m.base p₀) hψ_comp).trans hp₀_snd)

    have := hc_S
    have := hc_B
    let A := ModuleCat.{u, u} R
    let J₁ := V'_sch.smallEtaleTopology
    let J₂ := X.smallEtaleTopology
    let T₁ := weilEtaleIdTerminal.{u} V'_sch
    let hT₁ := weilEtaleIdTerminalIsTerminal.{u} V'_sch
    let T₂ := weilEtaleIdTerminal.{u} X
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} X
    let R_sh := Sigma_g.sheafPushforwardContinuous A J₁ J₂
    let P_sh := B_g.sheafPushforwardContinuous A J₂ J₁
    let adj_pre := CategoryTheory.Adjunction.whiskerLeft A adj_SB.op
    let adj_RP : R_sh ⊣ P_sh :=
      adj_pre.restrictFullyFaithful
        (CategoryTheory.fullyFaithfulSheafToPresheaf J₂ A)
        (CategoryTheory.fullyFaithfulSheafToPresheaf J₁ A)
        (CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _)
          (fun _ => (CategoryTheory.Category.comp_id _).trans
            (CategoryTheory.Category.id_comp _).symm))
        (CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _)
          (fun _ => (CategoryTheory.Category.comp_id _).trans
            (CategoryTheory.Category.id_comp _).symm))
    let adj₂ := CategoryTheory.constantSheafAdj J₂ A hT₂
    let adj₁ := CategoryTheory.constantSheafAdj J₁ A hT₁
    let adj_comp := adj₂.comp adj_RP
    have hBT₂ : CategoryTheory.Limits.IsTerminal (B_g.obj T₂) :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun Z => (adj_SB.homEquiv Z T₂) (hT₂.from (Sigma_g.obj Z)))
        (fun Z m => (adj_SB.homEquiv Z T₂).symm.injective (hT₂.hom_ext _ _))
    let e_T : T₁ ≅ B_g.obj T₂ := hT₁.uniqueUpToIso hBT₂
    let e_T_op : Opposite.op (B_g.obj T₂) ≅ Opposite.op T₁ :=
      { hom := e_T.hom.op
        inv := e_T.inv.op
        hom_inv_id := congrArg Opposite.op e_T.inv_hom_id
        inv_hom_id := congrArg Opposite.op e_T.hom_inv_id }
    let η_R : (P_sh ⋙ (CategoryTheory.sheafSections J₂ A).obj (Opposite.op T₂)) ≅
        (CategoryTheory.sheafSections J₁ A).obj (Opposite.op T₁) :=
      CategoryTheory.NatIso.ofComponents
        (fun 𝒢 => 𝒢.obj.mapIso e_T_op)
        (fun {𝒢₁ 𝒢₂} φ => (φ.hom.naturality e_T.hom.op).symm)
    let adj_comp' := adj_comp.ofNatIsoRight η_R
    let one_X := weilCupPDModUnit X ℓ
    let one_V' := weilCupPDModUnit V'_sch ℓ
    let iso_sh : R_sh.obj one_X ≅ one_V' := (adj_comp'.leftAdjointUniq adj₁).app RM
    let e_sec : one_X.obj.obj (Opposite.op (Sigma_g.obj T₁)) ≅ one_V'.obj.obj (Opposite.op T₁) :=
      ((CategoryTheory.sheafSections J₁ A).obj (Opposite.op T₁)).mapIso iso_sh
    let iso_V' : Sigma_g.obj T₁ ≅ V'_et :=
      { hom := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id V'_sch)
          (by
            change CategoryTheory.CategoryStruct.id V'_sch ≫ g =
              CategoryTheory.CategoryStruct.id V'_sch ≫ g
            rfl)
          trivial
        inv := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.CategoryStruct.id V'_sch)
          (by
            change CategoryTheory.CategoryStruct.id V'_sch ≫
                (CategoryTheory.CategoryStruct.id V'_sch ≫ g) = g
            rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp])
          trivial
        hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Category.id_comp _)
        inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Category.id_comp _) }
    let iso_V'_op : Opposite.op (Sigma_g.obj T₁) ≅ Opposite.op V'_et :=
      { hom := iso_V'.inv.op
        inv := iso_V'.hom.op
        hom_inv_id := congrArg Opposite.op iso_V'.hom_inv_id
        inv_hom_id := congrArg Opposite.op iso_V'.inv_hom_id }
    let e₁ : ZMod ℓ ≃ (one_V' ⟶ one_V') := Equiv.ofBijective _ hEnd_V'
    let e₂ : (one_V' ⟶ one_V') ≃ (RM ⟶ one_V'.obj.obj (Opposite.op T₁)) :=
      adj₁.homEquiv RM one_V'
    let e₃ : (RM ⟶ one_V'.obj.obj (Opposite.op T₁)) ≃
        (RM ⟶ one_X.obj.obj (Opposite.op (Sigma_g.obj T₁))) :=
      CategoryTheory.Iso.homCongr (CategoryTheory.Iso.refl RM) e_sec.symm
    let e₄ : (RM ⟶ one_X.obj.obj (Opposite.op (Sigma_g.obj T₁))) ≃
        (RM ⟶ one_X.obj.obj (Opposite.op V'_et)) :=
      CategoryTheory.Iso.homCongr (CategoryTheory.Iso.refl RM)
        (one_X.obj.mapIso iso_V'_op)
    let e₅ : (RM ⟶ one_X.obj.obj (Opposite.op V'_et)) ≃ (M ⟶ one_X) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
    let e₆ : (M ⟶ one_X) ≃ CategoryTheory.Abelian.Ext.{u} M one_X 0 :=
      Equiv.ofBijective _ (CategoryTheory.Abelian.Ext.mk₀_bijective M one_X)
    let e_all : CategoryTheory.Abelian.Ext.{u} M one_X 0 ≃ ZMod ℓ :=
      (e₁.trans (e₂.trans (e₃.trans (e₄.trans (e₅.trans e₆))))).symm
    rw [Nat.card_congr e_all, Nat.card_zmod]

theorem weil_proj_curve_open_compl_localTorsionCounitH_two_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (C'' : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsIntegral C''.left]
    (hProj : IsProjectiveOverField k C'')
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C''.hom]
    (hDim : topologicalKrullDim C''.left = (1 : WithBot ℕ∞))
    (V' : C''.left.Opens) (hNe_V' : Nonempty ↥V')
    (hZeroBdry : ∃ (K : CategoryTheory.Sheaf C''.left.smallEtaleTopology AddCommGrpCat.{u})
        (ι : Quiver.Hom K (weilEtaleTorsionSheaf C''.left m)),
      WeilAltIsZeroBdryExact C''.left V' m K ι)
    (hCloseVan : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (i_Z : Quiver.Hom Z C''.left)
        [AlgebraicGeometry.IsClosedImmersion i_Z],
      Finite ↥Z →
      (∀ v : ↥Z, IsClosed ({v} : Set ↥Z)) →
      ∀ (hCont : (weilEtaleSitePullback i_Z).IsContinuous
          C''.left.smallEtaleTopology Z.smallEtaleTopology),
        let P_push_Z := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback i_Z) AddCommGrpCat.{u} _
          C''.left.smallEtaleTopology Z.smallEtaleTopology hCont
        Subsingleton ((P_push_Z.obj (weilEtaleTorsionSheaf Z m)).H 1) ∧
        Subsingleton ((P_push_Z.obj (weilEtaleTorsionSheaf Z m)).H 2))
    (hSpecUnitInj : Function.Injective (fun c : ZMod m =>
      ((CategoryTheory.constantSheafAdj
        (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology AddCommGrpCat.{u}
        (weilEtaleIdTerminalIsTerminal.{u}
          (AlgebraicGeometry.Spec (CommRingCat.of k)))).unit.app
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))))
        (ULift.up c))) :
    let V''_et : C''.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ V'.ι
        (inferInstance : AlgebraicGeometry.Etale V'.ι)
    Function.Bijective (weilEtaleLocalTorsionCounitH C''.left m V''_et 2) :=
by
  classical
  let _ := hm
  let _ := hSpecUnitInj
  intro V''_et
  have hEtStableComp : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  
  
  
  have hComplGeom :
      let Z₀ : AlgebraicGeometry.Scheme.{u} :=
        (weilAltClosedComplIdeal C''.left V').subscheme
      Finite ↥Z₀ ∧ (∀ v : ↥Z₀, IsClosed ({v} : Set ↥Z₀)) := by
    let X' : AlgebraicGeometry.Scheme.{u} := C''.left
    have : AlgebraicGeometry.IsProper C''.hom := by
      rcases hProj with ⟨N, ι_Y, hClosed_ι⟩
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      let α₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
      have hα₀_bij : Function.Bijective α₀ := by
        constructor
        · intro c₁ c₂ hc
          exact MvPolynomial.C_injective (Fin (N + 1)) k (congrArg Subtype.val hc)
        · rintro ⟨p, hp⟩
          have hp' : p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0 := hp
          rw [MvPolynomial.homogeneousSubmodule_zero] at hp'
          obtain ⟨c, rfl⟩ := Submodule.mem_one.mp hp'
          exact ⟨c, Subtype.ext rfl⟩
      let e₀ : k ≃+* ↥(𝒜 0) := RingEquiv.ofBijective α₀ hα₀_bij
      have : CategoryTheory.IsIso (CommRingCat.ofHom α₀) :=
        ⟨⟨CommRingCat.ofHom e₀.symm.toRingHom,
          CommRingCat.hom_ext (RingHom.ext e₀.symm_apply_apply),
          CommRingCat.hom_ext (RingHom.ext e₀.apply_symm_apply)⟩⟩
      have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α₀)) :=
        inferInstance
      have : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0))
          (A := MvPolynomial (Fin (N + 1)) k) fun _ => rfl
      have : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0)
          (MvPolynomial (Fin (N + 1)) k)
      have : AlgebraicGeometry.IsProper (AlgebraicGeometry.Proj.toSpecZero 𝒜) := inferInstance
      have : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
        dsimp [weilProjectiveSpaceOver]
        infer_instance
      have : AlgebraicGeometry.IsClosedImmersion ι_Y.left := hClosed_ι
      rw [← CategoryTheory.Over.w ι_Y]
      infer_instance
    have hComp : CompactSpace ↥X' :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace C''.hom
    have : CompactSpace ↥X' := hComp
    have : AlgebraicGeometry.IsLocallyNoetherian X' :=
      AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian C''.hom
    have : AlgebraicGeometry.IsNoetherian X' :=
      (AlgebraicGeometry.isNoetherian_iff X').mpr ⟨inferInstance, hComp⟩
    have : TopologicalSpace.NoetherianSpace ↥X' :=
      AlgebraicGeometry.IsNoetherian.noetherianSpace
    have : IrreducibleSpace ↥X' := AlgebraicGeometry.irreducibleSpace_of_isIntegral X'
    let _ : OrderTop (TopologicalSpace.IrreducibleCloseds ↥X') :=
      { top := ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥X', isClosed_univ⟩
        le_top := fun _ _ _ => trivial }
    have hDim_le : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥X') ≤ 1 :=
      le_of_eq hDim
    have hMin : ∀ C₀ : TopologicalSpace.IrreducibleCloseds ↥X', C₀ ≠ ⊤ → IsMin C₀ :=
      Order.krullDim_le_one_iff_forall_isMin.mp hDim_le
    let S : Set ↥X' := (V' : Set ↥X')ᶜ
    have hCl_S : IsClosed S := V'.isOpen.isClosed_compl
    have hS_ne : S ≠ Set.univ := by
      intro h_univ
      obtain ⟨v₀, hv₀⟩ := hNe_V'
      have hv_S : v₀ ∈ S := h_univ ▸ Set.mem_univ v₀
      exact hv_S hv₀
    have hCl_pt : ∀ y ∈ S, IsClosed ({y} : Set ↥X') := by
      intro y hy
      let Cy : TopologicalSpace.IrreducibleCloseds ↥X' :=
        ⟨closure ({y} : Set ↥X'), isIrreducible_singleton.closure, isClosed_closure⟩
      have hCy_sub : (Cy : Set ↥X') ⊆ S :=
        closure_minimal (Set.singleton_subset_iff.mpr hy) hCl_S
      have hCy_ne : Cy ≠ ⊤ := fun htop =>
        hS_ne (Set.eq_univ_of_subset hCy_sub (congrArg SetLike.coe htop))
