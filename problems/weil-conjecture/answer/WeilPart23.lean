    (hDvrIsol : ∀ (B A : Type u) [CommRing B] [IsDomain B] [Algebra k B]
        [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
        [Algebra B A] [IsScalarTower k B A]
        (bA : Module.Basis (Fin ℓ) B A)
        (m_Q : Ideal B) [m_Q.IsMaximal]
        (P_max : Ideal A) [P_max.IsMaximal],
      Ideal.comap (algebraMap B A) P_max = m_Q →
      IsDiscreteValuationRing (Localization.AtPrime m_Q) →
      IsDiscreteValuationRing (Localization.AtPrime P_max) →
      (∀ q : Ideal A, q.IsPrime → q ≠ ⊥ → q.IsMaximal) →
      ∃ (b₀ : B) (g₀ : A),
        b₀ ∉ m_Q ∧
        g₀ ≠ 0 ∧
        (∀ q : Ideal A, q.IsPrime → algebraMap B A b₀ ∉ q → (g₀ ∈ q ↔ q = P_max)) ∧
        Ideal.span ({algebraMap A (Localization.AtPrime P_max) g₀} :
            Set (Localization.AtPrime P_max)) =
          IsLocalRing.maximalIdeal (Localization.AtPrime P_max) ∧
        Ideal.span ({algebraMap B (Localization.AtPrime m_Q)
            (((LinearMap.toMatrix bA bA) (LinearMap.mulLeft B g₀)).det)} :
            Set (Localization.AtPrime m_Q)) =
          IsLocalRing.maximalIdeal (Localization.AtPrime m_Q))
    (κ : ∀ Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)),
      (weilEtaleGmSheaf Y.left).H 1 →+ weilEtaleTorsionH Y.left ℓ 2)
    (δ_MV : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (W₁ W₂ : Y.left.Opens),
      W₁ ⊔ W₂ = ⊤ →
      Units ↑(Y.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂))) →
      (weilEtaleGmSheaf Y.left).H 1)
    (hκ_surj_C : Function.Surjective (κ C_bar))
    (hMV_se : ∀ (W₁ W₂ : C_bar.left.Opens) (hcov : W₁ ⊔ W₂ = ⊤)
        (u : Units ↑(C_bar.left.presheaf.obj (Opposite.op (W₁ ⊓ W₂))))
        (ℱ 𝒬 : CategoryTheory.Sheaf C_bar.left.smallEtaleTopology AddCommGrpCat.{u})
        (ι_sh : Quiver.Hom (weilEtaleGmSheaf C_bar.left) ℱ)
        (π_sh : Quiver.Hom ℱ 𝒬)
