          Ideal.span ({b} : Set Rx) = mx ^ nb ∧
          div_val T_C s_f ⟨x.1, x.2⟩ = (na : ℤ) - (nb : ℤ)) ∧
        (∀ (a b : Rx) (na nb : ℕ),
          a ≠ 0 → b ≠ 0 →
          algebraMap Rx ↑C.left.functionField a =
            (f : ↑C.left.functionField) * algebraMap Rx ↑C.left.functionField b →
          Ideal.span ({a} : Set Rx) = mx ^ na →
          Ideal.span ({b} : Set Rx) = mx ^ nb →
          div_val T_C s_f ⟨x.1, x.2⟩ = (na : ℤ) - (nb : ℤ))) ∧
      (∀ (U : C.left.Etale) (V₀ : U.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V₀),
        let D := ↑(U.left.presheaf.obj (Opposite.op V₀))
        let E := ↑((CategoryTheory.Limits.pullback
          (CategoryTheory.CategoryStruct.comp V₀.ι U.hom) η_C).presheaf.obj (Opposite.op ⊤))
        let α : D →+* E :=
          (CategoryTheory.CategoryStruct.comp V₀.topIso.inv
            (CategoryTheory.Limits.pullback.fst
              (CategoryTheory.CategoryStruct.comp V₀.ι U.hom) η_C).appTop).hom
        IsDomain D →
        IsField E →
        (∀ d : D, d ≠ 0 → IsUnit (α d)) →
        (∀ z : E, ∃ c d : D, d ≠ 0 ∧ z * α d = α c) →
        (∀ m : Ideal D, m.IsMaximal → m ≠ ⊥ →
          ∃ (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C.left) }) (hy : y.1 ∈ V₀),
