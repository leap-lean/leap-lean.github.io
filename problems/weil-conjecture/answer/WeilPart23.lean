  have hIsoOfOpenRangeEq :
      ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z)
        [AlgebraicGeometry.IsOpenImmersion f] [AlgebraicGeometry.IsOpenImmersion g],
        Set.range f.base = Set.range g.base →
        ∃ e : X ≅ Y, e.hom ≫ g = f ∧ e.inv ≫ f = g := by
    intro X Y Z f g _ _ hRange
    let u : X ⟶ Y := AlgebraicGeometry.IsOpenImmersion.lift g f hRange.le
    let v : Y ⟶ X := AlgebraicGeometry.IsOpenImmersion.lift f g hRange.ge
    have hu : u ≫ g = f := AlgebraicGeometry.IsOpenImmersion.lift_fac g f hRange.le
    have hv : v ≫ f = g := AlgebraicGeometry.IsOpenImmersion.lift_fac f g hRange.ge
    have huv : u ≫ v = 𝟙 X := by
      rw [← CategoryTheory.cancel_mono f, CategoryTheory.Category.assoc, hv, hu,
        CategoryTheory.Category.id_comp]
    have hvu : v ≫ u = 𝟙 Y := by
      rw [← CategoryTheory.cancel_mono g, CategoryTheory.Category.assoc, hu, hv,
        CategoryTheory.Category.id_comp]
    exact ⟨⟨u, v, huv, hvu⟩, hu, hv⟩

  
  have hPullRestrict :
      ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z) (U : Z.Opens),
        ∃ q_U : ((CategoryTheory.Limits.pullback.fst f g) ⁻¹ᵁ (f ⁻¹ᵁ U)).toScheme ⟶
            (g ⁻¹ᵁ U).toScheme,
          q_U ≫ (g ⁻¹ᵁ U).ι =
            ((CategoryTheory.Limits.pullback.fst f g) ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫
              CategoryTheory.Limits.pullback.snd f g ∧
          CategoryTheory.IsPullback
            ((CategoryTheory.Limits.pullback.fst f g) ∣_ (f ⁻¹ᵁ U)) q_U (f ∣_ U) (g ∣_ U) := by
    intro X Y Z f g U
    let fst := CategoryTheory.Limits.pullback.fst f g
    let snd := CategoryTheory.Limits.pullback.snd f g
    have hBase : CategoryTheory.IsPullback fst snd f g :=
      CategoryTheory.IsPullback.of_hasPullback f g
    have hTop : CategoryTheory.IsPullback (fst ∣_ (f ⁻¹ᵁ U)) (fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι
        (f ⁻¹ᵁ U).ι fst :=
      AlgebraicGeometry.isPullback_morphismRestrict fst (f ⁻¹ᵁ U)
    have hBot : CategoryTheory.IsPullback (g ∣_ U) (g ⁻¹ᵁ U).ι U.ι g :=
      AlgebraicGeometry.isPullback_morphismRestrict g U
    have hOuter : CategoryTheory.IsPullback (fst ∣_ (f ⁻¹ᵁ U)) ((fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ snd)
        ((f ∣_ U) ≫ U.ι) g := by
      rw [AlgebraicGeometry.morphismRestrict_ι f U]
      exact hTop.paste_vert hBase
    let q_U : (fst ⁻¹ᵁ (f ⁻¹ᵁ U)).toScheme ⟶ (g ⁻¹ᵁ U).toScheme :=
      hBot.lift ((fst ∣_ (f ⁻¹ᵁ U)) ≫ (f ∣_ U)) ((fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ snd)
        (by rw [CategoryTheory.Category.assoc]; exact hOuter.w)
    have hq_ι : q_U ≫ (g ⁻¹ᵁ U).ι = (fst ⁻¹ᵁ (f ⁻¹ᵁ U)).ι ≫ snd := hBot.lift_snd _ _ _
    have hq_comm : (fst ∣_ (f ⁻¹ᵁ U)) ≫ (f ∣_ U) = q_U ≫ (g ∣_ U) :=
      (hBot.lift_fst _ _ _).symm
    refine ⟨q_U, hq_ι, CategoryTheory.IsPullback.of_bot ?_ hq_comm hBot⟩
    rw [hq_ι]
    exact hOuter

  have hRestrictSub :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (W : X.Opens) (U₀ : Y.Opens)
        (hle : f ⁻¹ᵁ U₀ ≤ W),
        CategoryTheory.IsPullback (f ∣_ U₀) (X.homOfLE hle) U₀.ι (W.ι ≫ f) := by
    intro X Y f W U₀ hle
    have h1 : CategoryTheory.IsPullback (f ∣_ U₀) (X.homOfLE hle ≫ W.ι) U₀.ι f := by
      rw [X.homOfLE_ι hle]
      exact AlgebraicGeometry.isPullback_morphismRestrict f U₀
    have hcomm : (f ∣_ U₀) ≫ U₀.ι = X.homOfLE hle ≫ (W.ι ≫ f) := h1.w
    refine CategoryTheory.IsPullback.of_isLimit (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm
      (fun s => h1.lift s.fst (s.snd ≫ W.ι)
        (by rw [CategoryTheory.Category.assoc]; exact s.condition))
      (fun s => h1.lift_fst _ _ _)
      (fun s => by
        rw [← CategoryTheory.cancel_mono W.ι, CategoryTheory.Category.assoc]
        exact h1.lift_snd _ _ _)
      (fun s m hm₁ hm₂ => h1.hom_ext
        (hm₁.trans (h1.lift_fst _ _ _).symm)
        (by rw [← CategoryTheory.Category.assoc, hm₂]; exact (h1.lift_snd _ _ _).symm)))

  have hSmoothSup :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (W₁ W₂ : X.Opens),
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₁.ι ≫ f) →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₂.ι ≫ f) →
        AlgebraicGeometry.SmoothOfRelativeDimension 1 ((W₁ ⊔ W₂ : X.Opens).ι ≫ f) := by
    intro X Y f W₁ W₂ h₁ h₂
    let W : X.Opens := W₁ ⊔ W₂
    have h_part : ∀ (W₀_s : X.Opens) (hle : W₀_s ≤ W),
        AlgebraicGeometry.SmoothOfRelativeDimension 1 (W₀_s.ι ≫ f) →
        ∀ (z : ↥W.toScheme), z.1 ∈ W₀_s →
          ∃ (U : Y.Opens) (_ : AlgebraicGeometry.IsAffineOpen U)
            (V : W.toScheme.Opens) (_ : AlgebraicGeometry.IsAffineOpen V)
            (_ : z ∈ V) (e : V ≤ (W.ι ≫ f) ⁻¹ᵁ U),
            RingHom.IsStandardSmoothOfRelativeDimension 1
              ((W.ι ≫ f).appLE U V e).hom := by
      intro W₀_s hle h₀ z hz₀
      let j : W₀_s.toScheme ⟶ W.toScheme := X.homOfLE hle
      have h₀' : AlgebraicGeometry.SmoothOfRelativeDimension 1 (j ≫ W.ι ≫ f) := by
        rw [AlgebraicGeometry.Scheme.homOfLE_ι_assoc]
        exact h₀
      rw [AlgebraicGeometry.smoothOfRelativeDimension_iff] at h₀'
      obtain ⟨U, hAffU, V₀, hAffV₀, hzV₀, e₀, hStd₀⟩ := h₀' ⟨z.1, hz₀⟩
      let V : W.toScheme.Opens := j ''ᵁ V₀
      have hAffV : AlgebraicGeometry.IsAffineOpen V := hAffV₀.image_of_isOpenImmersion j
      have hzV : z ∈ V := by
        refine ⟨⟨z.1, hz₀⟩, hzV₀, ?_⟩
        apply Subtype.ext
        exact AlgebraicGeometry.Scheme.homOfLE_apply hle ⟨z.1, hz₀⟩
      have e : V ≤ (W.ι ≫ f) ⁻¹ᵁ U := by
        rintro _ ⟨w, hw, rfl⟩
        exact e₀ hw
      have hpre_eq : j ⁻¹ᵁ V = V₀ := by
        ext w
        refine ⟨?_, fun hw => ⟨w, hw, rfl⟩⟩
        rintro ⟨w', hw', hEq⟩
        cases j.isOpenEmbedding.injective hEq
        exact hw'
      have hIso_app : CategoryTheory.IsIso (j.app V) :=
        AlgebraicGeometry.PresheafedSpace.IsOpenImmersion.c_iso V₀
      have hIso_map : CategoryTheory.IsIso
          (W₀_s.toScheme.presheaf.map (CategoryTheory.homOfLE hpre_eq.ge).op) := by
        have : CategoryTheory.IsIso (CategoryTheory.homOfLE hpre_eq.ge).op :=
          ⟨⟨(CategoryTheory.homOfLE hpre_eq.le).op, Subsingleton.elim _ _, Subsingleton.elim _ _⟩⟩
        infer_instance
      have hIso : CategoryTheory.IsIso (j.appLE V V₀ hpre_eq.ge) := by
        rw [AlgebraicGeometry.Scheme.Hom.appLE]
        exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_app hIso_map
      refine ⟨U, hAffU, V, hAffV, hzV, e, ?_⟩
      let φ := (W.ι ≫ f).appLE U V e
      let ψ := j.appLE V V₀ hpre_eq.ge
      have hcomp : φ ≫ ψ = (j ≫ W.ι ≫ f).appLE U V₀ e₀ :=
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE j (W.ι ≫ f) U V V₀ e hpre_eq.ge
      have hφ_eq : φ = (j ≫ W.ι ≫ f).appLE U V₀ e₀ ≫ CategoryTheory.inv ψ := by
        rw [← hcomp, CategoryTheory.Category.assoc, CategoryTheory.IsIso.hom_inv_id,
          CategoryTheory.Category.comp_id]
      let e_ring : ↑(W₀_s.toScheme.presheaf.obj (Opposite.op V₀)) ≃+*
          ↑(W.toScheme.presheaf.obj (Opposite.op V)) :=
        (CategoryTheory.asIso ψ).symm.commRingCatIsoToRingEquiv
      have h_std' : RingHom.IsStandardSmoothOfRelativeDimension 1
          (e_ring.toRingHom.comp ((j ≫ W.ι ≫ f).appLE U V₀ e₀).hom) :=
        RingHom.isStandardSmoothOfRelativeDimension_respectsIso.left _ e_ring hStd₀
      have hhom : φ.hom = e_ring.toRingHom.comp ((j ≫ W.ι ≫ f).appLE U V₀ e₀).hom := by
        rw [hφ_eq, CommRingCat.hom_comp]
        rfl
      rwa [hhom]
    rw [AlgebraicGeometry.smoothOfRelativeDimension_iff]
    intro z
    rcases z.2 with hz₁ | hz₂
    · exact h_part W₁ le_sup_left h₁ z hz₁
    · exact h_part W₂ le_sup_right h₂ z hz₂

  
