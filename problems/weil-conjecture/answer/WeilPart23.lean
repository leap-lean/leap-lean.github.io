      let O_s : ∀ (U : W.Etale),
          LocallyConstant ↥U.left (ULift.{u} (ZMod m)) → ↥U.left → U.left.Opens :=
        fun U s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
      let W_s : ∀ (U : W.Etale),
          LocallyConstant ↥U.left (ULift.{u} (ZMod m)) → ↥U.left → W.Etale :=
        fun U s x =>
          CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_s U s x).ι ≫ U.hom)
            (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
      let j_s : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
          (x : ↥U.left), W_s U s x ⟶ U :=
        fun U s x => CategoryTheory.MorphismProperty.Over.homMk (O_s U s x).ι rfl trivial
      let σ_s : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
          (x : ↥U.left), ↥(F_W.obj.obj (Opposite.op (W_s U s x))) :=
        fun U s x => (F_W.obj.map (hT_W.from (W_s U s x)).op).hom (η_W.hom (s x))
      have h_ex : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m))),
          ∃! t : ↥(F_W.obj.obj (Opposite.op U)),
            ∀ x : ↥U.left, (F_W.obj.map (j_s U s x).op).hom t = σ_s U s x := by
        intro U s
        apply hGlueArrows W F_W U (W_s U s) (j_s U s)
        · intro x
          exact ⟨x, ⟨x, rfl⟩, rfl⟩
        · intro x₁ x₂ Z₀ f₁ f₂ hf
          by_cases hE : IsEmpty ↥Z₀.left
          · exact @Subsingleton.elim _ (hEmptySub W F_W Z₀ hE) _ _
          · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hE
            have hu_eq : (O_s U s x₁).ι (f₁.left z₀) = (O_s U s x₂).ι (f₂.left z₀) :=
              congrArg (fun k : Z₀ ⟶ U => k.left z₀) hf
            have hs₁ : s ((O_s U s x₁).ι (f₁.left z₀)) = s x₁ := (f₁.left z₀).2
            have hs₂ : s ((O_s U s x₂).ι (f₂.left z₀)) = s x₂ := (f₂.left z₀).2
            have hs_eq : s x₁ = s x₂ := hs₁.symm.trans ((congrArg s hu_eq).trans hs₂)
            have hT_eq : f₁ ≫ hT_W.from (W_s U s x₁) = f₂ ≫ hT_W.from (W_s U s x₂) :=
              hT_W.hom_ext _ _
            change (F_W.obj.map f₁.op).hom
                ((F_W.obj.map (hT_W.from (W_s U s x₁)).op).hom (η_W.hom (s x₁))) =
              (F_W.obj.map f₂.op).hom
                ((F_W.obj.map (hT_W.from (W_s U s x₂)).op).hom (η_W.hom (s x₂)))
            rw [← hMapComp F_W.obj f₁ (hT_W.from (W_s U s x₁)),
              ← hMapComp F_W.obj f₂ (hT_W.from (W_s U s x₂)), hT_eq, hs_eq]
      let φ_fun : ∀ U : W.Etale, LocallyConstant ↥U.left (ULift.{u} (ZMod m)) →
          ↥(F_W.obj.obj (Opposite.op U)) :=
        fun U s => Classical.choose (h_ex U s)
      have hφ_spec : ∀ (U : W.Etale) (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
          (x : ↥U.left),
          (F_W.obj.map (j_s U s x).op).hom (φ_fun U s) = σ_s U s x :=
        fun U s => (Classical.choose_spec (h_ex U s)).1
      have hφ_const : ∀ {U Y : W.Etale} (w : Y ⟶ U)
          (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m))) (a : ULift.{u} (ZMod m)),
          (∀ y : ↥Y.left, s (w.left y) = a) →
          (F_W.obj.map w.op).hom (φ_fun U s) =
            (F_W.obj.map (hT_W.from Y).op).hom (η_W.hom a) := by
        intro U Y w s a hsa
        by_cases hE : IsEmpty ↥Y.left
        · exact @Subsingleton.elim _ (hEmptySub W F_W Y hE) _ _
        · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hE
          let x₀ := w.left y₀
          have hx₀ : s x₀ = a := hsa y₀
          have hsub : Set.range ⇑w.left ⊆ Set.range ⇑(O_s U s x₀).ι := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨y, rfl⟩
            change s (w.left y) = s x₀
            exact (hsa y).trans hx₀.symm
          let w_l : Y.left ⟶ (O_s U s x₀).toScheme :=
            AlgebraicGeometry.IsOpenImmersion.lift (O_s U s x₀).ι w.left hsub
          have hw_l : w_l ≫ (O_s U s x₀).ι = w.left :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac (O_s U s x₀).ι w.left hsub
          let w_et : Y ⟶ W_s U s x₀ :=
            CategoryTheory.MorphismProperty.Over.homMk w_l
              (by
                change w_l ≫ (O_s U s x₀).ι ≫ U.hom = Y.hom
                rw [← CategoryTheory.Category.assoc, hw_l, CategoryTheory.MorphismProperty.Over.w w])
              trivial
          have hw_fac : w_et ≫ j_s U s x₀ = w :=
            CategoryTheory.MorphismProperty.Comma.Hom.ext hw_l (Subsingleton.elim _ _)
          have hT_eq : w_et ≫ hT_W.from (W_s U s x₀) = hT_W.from Y := hT_W.hom_ext _ _
          calc
            (F_W.obj.map w.op).hom (φ_fun U s)
              = (F_W.obj.map w_et.op).hom ((F_W.obj.map (j_s U s x₀).op).hom (φ_fun U s)) := by
                  rw [← hw_fac, hMapComp F_W.obj w_et (j_s U s x₀)]
            _ = (F_W.obj.map w_et.op).hom (σ_s U s x₀) := by rw [hφ_spec U s x₀]
            _ = (F_W.obj.map (w_et ≫ hT_W.from (W_s U s x₀)).op).hom
                  (η_W.hom (s x₀)) := (hMapComp F_W.obj w_et (hT_W.from (W_s U s x₀)) _).symm
            _ = (F_W.obj.map (hT_W.from Y).op).hom (η_W.hom a) := by
                  rw [hT_eq, hx₀]
      let Φ_inv_pre : weilAltLocConstPresheaf W m ⟶ F_W.obj :=
        { app := fun U_op =>
            AddCommGrpCat.ofHom
              { toFun := φ_fun (Opposite.unop U_op)
                map_zero' := by
                  rcases U_op with ⟨U⟩
                  change φ_fun U 0 = 0
                  have h0 := hφ_const (CategoryTheory.CategoryStruct.id U) 0 0 (fun _ => rfl)
                  have h_zero_η : (F_W.obj.map (hT_W.from U).op).hom
                      (η_W.hom (0 : ULift.{u} (ZMod m))) = 0 := by
                    change (F_W.obj.map (hT_W.from U).op).hom (η_W.hom (0 : ↥AM)) = 0
                    rw [η_W.hom.map_zero, (F_W.obj.map (hT_W.from U).op).hom.map_zero]
                  exact (hMapId F_W.obj U (φ_fun U 0)).symm.trans (h0.trans h_zero_η)
                map_add' := by
                  rcases U_op with ⟨U⟩
                  intro (s₁ : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
                        (s₂ : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
                  let O₁₂ : ↥U.left → U.left.Opens := fun x => O_s U s₁ x ⊓ O_s U s₂ x
                  let W₁₂ : ↥U.left → W.Etale := fun x =>
                    CategoryTheory.MorphismProperty.Over.mk ⊤ ((O₁₂ x).ι ≫ U.hom)
                      (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
                  let j₁₂ : ∀ x : ↥U.left, W₁₂ x ⟶ U :=
                    fun x => CategoryTheory.MorphismProperty.Over.homMk (O₁₂ x).ι rfl trivial
                  have h_cov₁₂ : ∀ x : ↥U.left, ∃ (i : ↥U.left) (y : ↥(W₁₂ i).left),
                      (j₁₂ i).left y = x :=
                    fun x => ⟨x, ⟨x, ⟨rfl, rfl⟩⟩, rfl⟩
                  have h_sec₁₂ := hGlueArrows W F_W U W₁₂ j₁₂ h_cov₁₂
                    (fun x => (F_W.obj.map (j₁₂ x).op).hom (φ_fun U (s₁ + s₂)))
                    (fun i₁ i₂ Z₀ f₁ f₂ hf => by
                      rw [← hMapComp F_W.obj f₁ (j₁₂ i₁), ← hMapComp F_W.obj f₂ (j₁₂ i₂), hf])
                  refine h_sec₁₂.unique (fun _ => rfl) ?_
                  intro x
                  rw [map_add]
                  have hc₁ := hφ_const (j₁₂ x) s₁ (s₁ x) (fun y => y.2.1)
                  have hc₂ := hφ_const (j₁₂ x) s₂ (s₂ x) (fun y => y.2.2)
                  have hc₁₂ := hφ_const (j₁₂ x) (s₁ + s₂) (s₁ x + s₂ x)
                    (fun y => (LocallyConstant.add_apply s₁ s₂ _).trans
                      (congrArg₂ (· + ·) y.2.1 y.2.2))
                  have h_add_η : (F_W.obj.map (hT_W.from (W₁₂ x)).op).hom (η_W.hom (s₁ x)) +
                      (F_W.obj.map (hT_W.from (W₁₂ x)).op).hom (η_W.hom (s₂ x)) =
                      (F_W.obj.map (hT_W.from (W₁₂ x)).op).hom (η_W.hom (s₁ x + s₂ x)) := by
                    let a₁ : ↥AM := s₁ x
                    let a₂ : ↥AM := s₂ x
                    change (F_W.obj.map (hT_W.from (W₁₂ x)).op).hom (η_W.hom a₁) +
                        (F_W.obj.map (hT_W.from (W₁₂ x)).op).hom (η_W.hom a₂) =
                      (F_W.obj.map (hT_W.from (W₁₂ x)).op).hom (η_W.hom (a₁ + a₂))
                    rw [η_W.hom.map_add, (F_W.obj.map (hT_W.from (W₁₂ x)).op).hom.map_add]
                  exact (congrArg₂ (· + ·) hc₁ hc₂).trans (h_add_η.trans hc₁₂.symm) }
          naturality := fun {U₁_op U₂_op} f_op => by
            rcases U₁_op with ⟨U₁⟩
            rcases U₂_op with ⟨U₂⟩
            let u : U₂ ⟶ U₁ := f_op.unop
            have hfu : f_op = u.op := rfl
            rw [hfu]
            apply AddCommGrpCat.ext
            intro (s : LocallyConstant ↥U₁.left (ULift.{u} (ZMod m)))
            let su : LocallyConstant ↥U₂.left (ULift.{u} (ZMod m)) :=
              ((weilAltLocConstPresheaf W m).map u.op).hom s
            refine ((Classical.choose_spec (h_ex U₂ su)).2
              ((F_W.obj.map u.op).hom (φ_fun U₁ s)) ?_).symm
            intro x
            rw [← hMapComp F_W.obj (j_s U₂ su x) u]
            exact hφ_const (j_s U₂ su x ≫ u) s (su x) (fun y => by
              have hy : s (u.left y.1) = su x := y.2
              have hcomp_y : (j_s U₂ su x ≫ u).left y = u.left y.1 :=
                AlgebraicGeometry.Scheme.Hom.comp_apply (O_s U₂ su x).ι u.left y
              exact (congrArg s hcomp_y).trans hy) }
      let Φ_inv : L_W ⟶ F_W := CategoryTheory.ObjectProperty.homMk Φ_inv_pre
      have hΦ_inv_c : c_W ≫ Φ_inv.hom.app (Opposite.op T_W) = η_W := by
        apply AddCommGrpCat.ext
        intro a
        change φ_fun T_W (c_W.hom a) = η_W.hom a
        have hc := hφ_const (CategoryTheory.CategoryStruct.id T_W) (c_W.hom a) a (fun _ => rfl)
        have hT_id : hT_W.from T_W = CategoryTheory.CategoryStruct.id T_W :=
          hT_W.hom_ext _ _
        rw [hT_id, hMapId F_W.obj T_W, hMapId F_W.obj T_W] at hc
        exact hc
      have h_hom_inv : Φ_hom ≫ Φ_inv = CategoryTheory.CategoryStruct.id F_W := by
        apply (adj_W.homEquiv AM F_W).injective
        rw [adj_W.homEquiv_unit, adj_W.homEquiv_unit]
        change η_W ≫ (Φ_hom.hom.app (Opposite.op T_W) ≫ Φ_inv.hom.app (Opposite.op T_W)) =
          η_W ≫ CategoryTheory.CategoryStruct.id _
        rw [← CategoryTheory.Category.assoc, hΦ_unit, hΦ_inv_c, CategoryTheory.Category.comp_id]
      have h_inv_hom : Φ_inv ≫ Φ_hom = CategoryTheory.CategoryStruct.id L_W := by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext U_op
        rcases U_op with ⟨U⟩
        apply AddCommGrpCat.ext
        intro (s : LocallyConstant ↥U.left (ULift.{u} (ZMod m)))
        apply LocallyConstant.ext
        intro (x : ↥U.left)
        let eval_W : ↥(L_W.obj.obj (Opposite.op (W_s U s x))) → ULift.{u} (ZMod m) :=
          fun k => (show LocallyConstant ↥(W_s U s x).left (ULift.{u} (ZMod m)) from k) ⟨x, rfl⟩
        let eval_U : ↥(L_W.obj.obj (Opposite.op U)) → ULift.{u} (ZMod m) :=
          fun k => (show LocallyConstant ↥U.left (ULift.{u} (ZMod m)) from k) x
        have hnat := congrArg
          (fun φ : F_W.obj.obj (Opposite.op U) ⟶ L_W.obj.obj (Opposite.op (W_s U s x)) =>
            φ.hom (φ_fun U s))
          (Φ_hom.hom.naturality (j_s U s x).op)
        have hev : eval_W ((Φ_hom.hom.app (Opposite.op (W_s U s x))).hom
            ((F_W.obj.map (j_s U s x).op).hom (φ_fun U s))) =
            eval_U ((Φ_hom.hom.app (Opposite.op U)).hom (φ_fun U s)) :=
          congrArg eval_W hnat
        change eval_U ((Φ_hom.hom.app (Opposite.op U)).hom (φ_fun U s)) = s x
        rw [← hev, hφ_spec U s x]
        let u_x : W_s U s x ⟶ T_W := hT_W.from (W_s U s x)
        have hnatT : eval_W ((Φ_hom.hom.app (Opposite.op (W_s U s x))).hom
            ((F_W.obj.map u_x.op).hom (η_W.hom (s x)))) =
            eval_W ((L_W.obj.map u_x.op).hom
              ((Φ_hom.hom.app (Opposite.op T_W)).hom (η_W.hom (s x)))) :=
          congrArg
            (fun φ : F_W.obj.obj (Opposite.op T_W) ⟶ L_W.obj.obj (Opposite.op (W_s U s x)) =>
              eval_W (φ.hom (η_W.hom (s x))))
            (Φ_hom.hom.naturality u_x.op)
        have hu_ev : (Φ_hom.hom.app (Opposite.op T_W)).hom (η_W.hom (s x)) = c_W.hom (s x) :=
          congrArg (fun φ : AM ⟶ L_W.obj.obj (Opposite.op T_W) => φ.hom (s x)) hΦ_unit
        exact hnatT.trans (congrArg (fun v => eval_W ((L_W.obj.map u_x.op).hom v)) hu_ev)
      exact ⟨⟨Φ_hom, Φ_inv, h_hom_inv, h_inv_hom⟩, hΦ_unit⟩

    let hShL := hShL_gen X'
    obtain ⟨Φ, hΦ_unit⟩ := hPhi_gen X' (weilEtaleIdTerminal.{u} X')
      (weilEtaleIdTerminalIsTerminal.{u} X')
    let I_Z := weilAltClosedComplIdeal X' V'
    let Z := I_Z.subscheme
    let i_Z := I_Z.subschemeι
    rcases hZB with ⟨hCont_Z, T_S, hT_S, T_Z, hT_Z, h0_K, hSE_K⟩
    obtain ⟨Φ_Z, hΦ_Z_unit⟩ := hPhi_gen Z T_Z hT_Z
    let B_Z := weilEtaleSitePullback i_Z
    let P_push_Z := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
      B_Z AddCommGrpCat.{u} _ X'.smallEtaleTopology Z.smallEtaleTopology hCont_Z
    let L_S : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf X' m, hShL⟩
    let L_Z : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf Z m, hShL_gen Z⟩
    let L0_sh : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltZeroBdrySubpresheaf X' V' m, hSh0⟩
    let ι0_sh : L0_sh ⟶ L_S :=
      CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι X' V' m)
    let ρ_loc : L_S ⟶ P_push_Z.obj L_Z :=
      CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat i_Z m)
    let adj_S := CategoryTheory.constantSheafAdj X'.smallEtaleTopology AddCommGrpCat.{u} hT_S
    let adj_Z := CategoryTheory.constantSheafAdj Z.smallEtaleTopology AddCommGrpCat.{u} hT_Z
    let τ_Z : B_Z.obj T_S ⟶ T_Z := hT_Z.from (B_Z.obj T_S)
    let ρ_Z : weilEtaleTorsionSheaf X' m ⟶ P_push_Z.obj (weilEtaleTorsionSheaf Z m) :=
      (adj_S.homEquiv AM (P_push_Z.obj (weilEtaleTorsionSheaf Z m))).symm
        (adj_Z.unit.app AM ≫ (weilEtaleTorsionSheaf Z m).obj.map (Opposite.op τ_Z))

    have hRange_Z : Set.range ⇑i_Z = (V' : Set ↥X')ᶜ :=
      (AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι I_Z).trans
        (AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal _)
    have h_pr1_iff : ∀ (U : X'.Etale) (x : ↥U.left),
        (∃ y : ↥(B_Z.obj U).left, (CategoryTheory.Limits.pullback.fst U.hom i_Z) y = x) ↔
          U.hom x ∉ (V' : Set ↥X') := by
      intro U x
      constructor
      · rintro ⟨y, rfl⟩
        have hcond : U.hom ((CategoryTheory.Limits.pullback.fst U.hom i_Z) y) =
            i_Z ((CategoryTheory.Limits.pullback.snd U.hom i_Z) y) := by
          calc
            U.hom ((CategoryTheory.Limits.pullback.fst U.hom i_Z) y)
              = (CategoryTheory.Limits.pullback.fst U.hom i_Z ≫ (U.hom : U.left ⟶ X')) y :=
                  (AlgebraicGeometry.Scheme.Hom.comp_apply _ (U.hom : U.left ⟶ X') y).symm
            _ = (CategoryTheory.Limits.pullback.snd U.hom i_Z ≫ i_Z) y := by
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = i_Z ((CategoryTheory.Limits.pullback.snd U.hom i_Z) y) :=
                  AlgebraicGeometry.Scheme.Hom.comp_apply _ i_Z y
        rw [hcond]
        have hmem : i_Z ((CategoryTheory.Limits.pullback.snd U.hom i_Z) y) ∈ Set.range ⇑i_Z :=
          ⟨_, rfl⟩
        rwa [hRange_Z] at hmem
      · intro hx
        have hmem : U.hom x ∈ Set.range ⇑i_Z := by
          rw [hRange_Z]
          exact hx
        obtain ⟨z, hz⟩ := hmem
        obtain ⟨y, hy, _⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x z hz.symm
        exact ⟨y, hy⟩

    have h0_loc : ι0_sh ≫ ρ_loc = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      apply AddCommGrpCat.ext
      intro g
      change (((ι0_sh.hom.app U_op ≫ ρ_loc.hom.app U_op).hom g) :
        LocallyConstant ↥(B_Z.obj (Opposite.unop U_op)).left (ULift.{u} (ZMod m))) = 0
      apply LocallyConstant.ext
      intro y
      exact g.2 _ ((h_pr1_iff (Opposite.unop U_op) _).mp ⟨y, rfl⟩)

    have hρ_comm : ρ_Z ≫ P_push_Z.map Φ_Z.hom = Φ.hom ≫ ρ_loc := by
      apply (adj_S.homEquiv AM (P_push_Z.obj L_Z)).injective
      have h_lhs1 : adj_S.homEquiv AM (P_push_Z.obj (weilEtaleTorsionSheaf Z m)) ρ_Z =
          adj_Z.unit.app AM ≫ (weilEtaleTorsionSheaf Z m).obj.map τ_Z.op :=
        Equiv.apply_symm_apply _ _
      rw [adj_S.homEquiv_naturality_right, h_lhs1, adj_S.homEquiv_unit]
      change (adj_Z.unit.app AM ≫ (weilEtaleTorsionSheaf Z m).obj.map τ_Z.op) ≫
          Φ_Z.hom.hom.app (Opposite.op (B_Z.obj T_S)) =
        adj_S.unit.app AM ≫ (Φ.hom.hom.app (Opposite.op T_S) ≫ ρ_loc.hom.app (Opposite.op T_S))
      have h_lhs2 :
          (adj_Z.unit.app AM ≫ (weilEtaleTorsionSheaf Z m).obj.map τ_Z.op) ≫
            Φ_Z.hom.hom.app (Opposite.op (B_Z.obj T_S)) =
          weilAltLocConstConstHom Z T_Z m ≫ L_Z.obj.map τ_Z.op := by
        rw [CategoryTheory.Category.assoc, Φ_Z.hom.hom.naturality τ_Z.op,
          ← CategoryTheory.Category.assoc, hΦ_Z_unit]
      rw [h_lhs2]
      let T₀ := weilEtaleIdTerminal.{u} X'
      let hT₀ := weilEtaleIdTerminalIsTerminal.{u} X'
      let u_TS : T_S ⟶ T₀ := hT₀.from T_S
      have hu_eq : adj_S.unit.app AM =
          (CategoryTheory.constantSheafAdj X'.smallEtaleTopology AddCommGrpCat.{u} hT₀).unit.app AM ≫
            (weilEtaleTorsionSheaf X' m).obj.map u_TS.op := by
        have hid : (hT_S.from T_S).op = CategoryTheory.CategoryStruct.id (Opposite.op T_S) := by
          rw [hT_S.hom_ext (hT_S.from T_S) (CategoryTheory.CategoryStruct.id T_S)]
          rfl
        have h_id_comp : adj_S.unit.app AM =
            adj_S.unit.app AM ≫
              ((CategoryTheory.constantSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).obj AM).obj.map
                (hT_S.from T_S).op := by
          rw [hid, CategoryTheory.Functor.map_id]
          exact (CategoryTheory.Category.comp_id (adj_S.unit.app AM)).symm
        exact h_id_comp.trans
          ((hUnitNat X' T_S hT_S AM T_S).trans (hUnitNat X' T₀ hT₀ AM T_S).symm)
      have h_rhs2 :
          adj_S.unit.app AM ≫ (Φ.hom.hom.app (Opposite.op T_S) ≫ ρ_loc.hom.app (Opposite.op T_S)) =
          (weilAltLocConstConstHom X' T₀ m ≫ L_S.obj.map u_TS.op) ≫
            ρ_loc.hom.app (Opposite.op T_S) := by
        rw [hu_eq, CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
          ((weilEtaleTorsionSheaf X' m).obj.map u_TS.op),
          Φ.hom.hom.naturality u_TS.op,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hΦ_unit]
      rw [h_rhs2]
      apply AddCommGrpCat.ext
      intro a
      exact LocallyConstant.ext fun _ => rfl

    have h0_KΦ : (ι ≫ Φ.hom) ≫ ρ_loc = 0 := by
      rw [CategoryTheory.Category.assoc, ← hρ_comm, ← CategoryTheory.Category.assoc, h0_K,
        CategoryTheory.Limits.zero_comp]

    let Ψ_hom : K ⟶ L0_sh :=
      CategoryTheory.ObjectProperty.homMk
        { app := fun U_op =>
            AddCommGrpCat.ofHom
              { toFun := fun w =>
                  ⟨(((ι ≫ Φ.hom).hom.app U_op).hom w), fun x hx => by
                    obtain ⟨y, rfl⟩ := (h_pr1_iff (Opposite.unop U_op) x).mpr hx
                    have hzero : (((((ι ≫ Φ.hom) ≫ ρ_loc).hom.app U_op).hom w) :
                        LocallyConstant ↥(B_Z.obj (Opposite.unop U_op)).left
                          (ULift.{u} (ZMod m))) = 0 := by
                      rw [h0_KΦ]
                      rfl
                    exact congrArg (fun f : LocallyConstant _ _ => f y) hzero⟩
                map_zero' := Subtype.ext (map_zero _)
                map_add' := fun w₁ w₂ => Subtype.ext (map_add _ w₁ w₂) }
          naturality := fun {U₁_op U₂_op} f_op => by
            apply AddCommGrpCat.ext
            intro w
            apply Subtype.ext
            exact congrArg (fun φ => φ.hom w) ((ι ≫ Φ.hom).hom.naturality f_op) }
    have hΨ_comm : Ψ_hom ≫ ι0_sh = ι ≫ Φ.hom := by
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      apply AddCommGrpCat.ext
      intro w
      change (Ψ_hom.hom.app U_op ≫ ι0_sh.hom.app U_op).hom w =
        ((ι ≫ Φ.hom).hom.app U_op).hom w
      rfl

    have h0_inv : (ι0_sh ≫ Φ.inv) ≫ ρ_Z = 0 := by
      have h_post : ((ι0_sh ≫ Φ.inv) ≫ ρ_Z) ≫ P_push_Z.map Φ_Z.hom = 0 := by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hρ_comm,
          ← CategoryTheory.Category.assoc Φ.inv, Φ.inv_hom_id,
          CategoryTheory.Category.id_comp, h0_loc]
      have h_cancel := congrArg (· ≫ P_push_Z.map Φ_Z.inv) h_post
      rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.assoc,
        ← P_push_Z.map_comp, Φ_Z.hom_inv_id, P_push_Z.map_id,
        CategoryTheory.Category.comp_id] at h_cancel
      exact h_cancel

    obtain ⟨Ψ_inv, hΨ_inv_fac⟩ :=
      CategoryTheory.Limits.KernelFork.IsLimit.lift' hSE_K.fIsKernel (ι0_sh ≫ Φ.inv) h0_inv
    have hΨ_inv_ι : Ψ_inv ≫ ι = ι0_sh ≫ Φ.inv := hΨ_inv_fac

    have hΨ_hom_inv : Ψ_hom ≫ Ψ_inv = CategoryTheory.CategoryStruct.id K := by
      have : CategoryTheory.Mono ι := hSE_K.mono_f
      apply (CategoryTheory.cancel_mono ι).mp
      rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hΨ_inv_ι,
        ← CategoryTheory.Category.assoc, hΨ_comm, CategoryTheory.Category.assoc,
        Φ.hom_inv_id, CategoryTheory.Category.comp_id]
    have hΨ_inv_hom : Ψ_inv ≫ Ψ_hom = CategoryTheory.CategoryStruct.id L0_sh := by
      have h_comp_ι0 : (Ψ_inv ≫ Ψ_hom) ≫ ι0_sh = CategoryTheory.CategoryStruct.id L0_sh ≫ ι0_sh := by
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hΨ_comm,
          ← CategoryTheory.Category.assoc, hΨ_inv_ι, CategoryTheory.Category.assoc,
          Φ.inv_hom_id, CategoryTheory.Category.comp_id]
      apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext U_op
      apply AddCommGrpCat.ext
      intro g
      apply Subtype.ext
      have hg_eq : (((Ψ_inv ≫ Ψ_hom) ≫ ι0_sh).hom.app U_op).hom g =
          ((CategoryTheory.CategoryStruct.id L0_sh ≫ ι0_sh).hom.app U_op).hom g :=
        congrArg (fun k : L0_sh ⟶ L_S => (k.hom.app U_op).hom g) h_comp_ι0
      exact hg_eq
    exact ⟨hShL, hSh0, Φ, ⟨Ψ_hom, Ψ_inv, hΨ_hom_inv, hΨ_inv_hom⟩, hΦ_unit, hΨ_comm⟩

  obtain ⟨hShL, hSh0, Φ, Ψ, hΦ_unit, hΨ_comm⟩ := hBlock2

  
  
  
  have hBlock3 :
      ∃ Θ : CategoryTheory.Iso (weilEtaleLocalTorsionSheaf C''.left m V''_et)
          ⟨weilAltZeroBdrySubpresheaf C''.left V' m, hSh0⟩,
        CategoryTheory.CategoryStruct.comp Θ.hom
          (CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι C''.left V' m)) =
          CategoryTheory.CategoryStruct.comp
            (weilEtaleLocalTorsionCounit C''.left m V''_et) Φ.hom := by
    let J := C''.left.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let L_V := weilEtaleLocalTorsionSheaf C''.left m V''_et
    let ε' := weilEtaleLocalTorsionCounit C''.left m V''_et
    let L_S : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf C''.left m, hShL⟩
    let L0_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
      ⟨weilAltZeroBdrySubpresheaf C''.left V' m, hSh0⟩
    let ι0_sh : L0_sh ⟶ L_S :=
      CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι C''.left V' m)
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    have hOpenV : AlgebraicGeometry.IsOpenImmersion V'.ι := inferInstance

    have hEquivComp : ∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (α : L_V ⟶ F) (β : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ β) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ β.hom.app (Opposite.op V''_et) := by
      intro F G α β
      let α' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda V''_et AM) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj_sh.homEquiv _ G) (α' ≫ β))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              ((adj_sh.homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map β) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ β.hom.app (Opposite.op V''_et) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

    let γ₀ : AM ⟶ L0_sh.obj.obj (Opposite.op V''_et) :=
      AddCommGrpCat.ofHom
        { toFun := fun a =>
            ⟨LocallyConstant.const ↥V''_et.left a, fun x hx => False.elim (hx x.2)⟩
          map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
          map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
    let Θ_hom : L_V ⟶ L0_sh := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm γ₀

    have hΘ_comm : Θ_hom ≫ ι0_sh = ε' ≫ Φ.hom := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquivComp Θ_hom ι0_sh, hEquivComp ε' Φ.hom]
      have hc₁ : CategoryTheory.Sheaf.freeYonedaHomEquiv Θ_hom = γ₀ :=
        Equiv.apply_symm_apply _ _
      have hc₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv ε' =
          ((adj_sh.unit.app ((CategoryTheory.Functor.const (Opposite C''.left.Etale)).obj AM)).app
            (Opposite.op V''_et)) :=
        Equiv.apply_symm_apply _ _
      rw [hc₁, hc₂]
      let T₀ := weilEtaleIdTerminal.{u} C''.left
      let hT₀ := weilEtaleIdTerminalIsTerminal.{u} C''.left
      rw [← hUnitNat C''.left T₀ hT₀ AM V''_et]
      change γ₀ ≫ ι0_sh.hom.app (Opposite.op V''_et) =
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₀).unit.app AM ≫
          ((weilEtaleTorsionSheaf C''.left m).obj.map (hT₀.from V''_et).op ≫
            Φ.hom.hom.app (Opposite.op V''_et))
      rw [Φ.hom.hom.naturality (hT₀.from V''_et).op, ← CategoryTheory.Category.assoc, hΦ_unit]
      exact AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl

    have hSubHom : ∀ Z₀ : C''.left.Etale, Subsingleton (Z₀ ⟶ V''_et) := by
      intro Z₀
      refine ⟨fun m₁ m₂ => ?_⟩
      have : CategoryTheory.Mono V'.ι := AlgebraicGeometry.IsOpenImmersion.mono V'.ι
      have hm : m₁.left ≫ V'.ι = m₂.left ≫ V'.ι :=
        (CategoryTheory.MorphismProperty.Over.w m₁).trans
          (CategoryTheory.MorphismProperty.Over.w m₂).symm
      exact CategoryTheory.MorphismProperty.Comma.Hom.ext
        ((CategoryTheory.cancel_mono V'.ι).mp hm) (Subsingleton.elim _ _)

    let ξ₀ : AM ⟶ L_V.obj.obj (Opposite.op V''_et) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_V)

    let O_g : ∀ (U : C''.left.Etale),
        ↥(weilAltZeroBdrySubgroup C''.left V' m U) → ↥U.left → U.left.Opens :=
      fun U g x =>
        if U.hom x ∈ (V' : Set ↥C''.left) then
          ⟨(g.1 ⁻¹' {g.1 x}) ∩ (⇑U.hom ⁻¹' (V' : Set ↥C''.left)),
            (g.1.isLocallyConstant {g.1 x}).inter (V'.isOpen.preimage U.hom.continuous)⟩
        else
          ⟨g.1 ⁻¹' {0}, g.1.isLocallyConstant {0}⟩

    have hOg_mem : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left), x ∈ O_g U g x := by
      intro U g x
      change x ∈ if U.hom x ∈ (V' : Set ↥C''.left) then _ else _
      split_ifs with hx
      · exact ⟨rfl, hx⟩
      · exact g.2 x hx

    have hOg_val : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x w : ↥U.left), w ∈ O_g U g x → g.1 w = g.1 x := by
      intro U g x w hw
      change w ∈ (if U.hom x ∈ (V' : Set ↥C''.left) then _ else _) at hw
      split_ifs at hw with hx
      · exact hw.1
      · have hw0 : g.1 w = 0 := hw
        exact hw0.trans (g.2 x hx).symm

    have hOg_inV : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x w : ↥U.left), U.hom x ∈ (V' : Set ↥C''.left) → w ∈ O_g U g x →
        U.hom w ∈ (V' : Set ↥C''.left) := by
      intro U g x w hx hw
      change w ∈ (if U.hom x ∈ (V' : Set ↥C''.left) then _ else _) at hw
      rw [if_pos hx] at hw
      exact hw.2

    have hOg_mk_inV : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x w : ↥U.left), U.hom x ∈ (V' : Set ↥C''.left) →
        g.1 w = g.1 x → U.hom w ∈ (V' : Set ↥C''.left) → w ∈ O_g U g x := by
      intro U g x w hx hgw hwV
      change w ∈ if U.hom x ∈ (V' : Set ↥C''.left) then _ else _
      rw [if_pos hx]
      exact ⟨hgw, hwV⟩

    let W_g : ∀ (U : C''.left.Etale),
        ↥(weilAltZeroBdrySubgroup C''.left V' m U) → ↥U.left → C''.left.Etale :=
      fun U g x =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((O_g U g x).ι ≫ U.hom)
          (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)

    let j_g : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left), W_g U g x ⟶ U :=
      fun U g x => CategoryTheory.MorphismProperty.Over.homMk (O_g U g x).ι rfl trivial

    have hRange_inV : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left), U.hom x ∈ (V' : Set ↥C''.left) →
        Set.range ⇑((O_g U g x).ι ≫ (U.hom : U.left ⟶ C''.left)) ⊆ Set.range ⇑V'.ι := by
      intro U g x hx
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨y, rfl⟩
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply]
      exact hOg_inV U g x y.1 hx y.2

    let u_g : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left) (_ : U.hom x ∈ (V' : Set ↥C''.left)), W_g U g x ⟶ V''_et :=
      fun U g x hx =>
        CategoryTheory.MorphismProperty.Over.homMk
          (@AlgebraicGeometry.IsOpenImmersion.lift _ _ C''.left V'.ι
            ((O_g U g x).ι ≫ (U.hom : U.left ⟶ C''.left)) hOpenV (hRange_inV U g x hx))
          (@AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ C''.left V'.ι
            ((O_g U g x).ι ≫ (U.hom : U.left ⟶ C''.left)) hOpenV (hRange_inV U g x hx))
          trivial

    let τ_g : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left), ↥(L_V.obj.obj (Opposite.op (W_g U g x))) :=
      fun U g x =>
        if hx : U.hom x ∈ (V' : Set ↥C''.left) then
          (L_V.obj.map (u_g U g x hx).op).hom (ξ₀.hom (g.1 x))
        else
          0

    have hτ_pos : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left) (hx : U.hom x ∈ (V' : Set ↥C''.left)),
        τ_g U g x = (L_V.obj.map (u_g U g x hx).op).hom (ξ₀.hom (g.1 x)) := by
      intro U g x hx
      exact dif_pos hx

    have hτ_zero_of_val : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left), g.1 x = 0 → τ_g U g x = 0 := by
      intro U g x hx0
      by_cases hx : U.hom x ∈ (V' : Set ↥C''.left)
      · have h_z : (L_V.obj.map (u_g U g x hx).op).hom (ξ₀.hom (0 : ULift.{u} (ZMod m))) = 0 := by
          change (L_V.obj.map (u_g U g x hx).op).hom (ξ₀.hom (0 : ↥AM)) = 0
          rw [ξ₀.hom.map_zero, (L_V.obj.map (u_g U g x hx).op).hom.map_zero]
        exact (hτ_pos U g x hx).trans
          ((congrArg (fun a => (L_V.obj.map (u_g U g x hx).op).hom (ξ₀.hom a)) hx0).trans h_z)
      · exact dif_neg hx

    have h_theta_ex : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U)),
        ∃! t : ↥(L_V.obj.obj (Opposite.op U)),
          ∀ x : ↥U.left, (L_V.obj.map (j_g U g x).op).hom t = τ_g U g x := by
      intro U g
      apply hGlueArrows C''.left L_V U (W_g U g) (j_g U g)
      · intro x
        exact ⟨x, ⟨x, hOg_mem U g x⟩, rfl⟩
      · intro x₁ x₂ Z₀ f₁ f₂ hf
        by_cases hE : IsEmpty ↥Z₀.left
        · exact @Subsingleton.elim _ (hEmptySub C''.left L_V Z₀ hE) _ _
        · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hE
          have hw_eq : (O_g U g x₁).ι (f₁.left z₀) = (O_g U g x₂).ι (f₂.left z₀) :=
            congrArg (fun k : Z₀ ⟶ U => k.left z₀) hf
          have hg₁ : g.1 ((O_g U g x₁).ι (f₁.left z₀)) = g.1 x₁ :=
            hOg_val U g x₁ _ (f₁.left z₀).2
          have hg₂ : g.1 ((O_g U g x₂).ι (f₂.left z₀)) = g.1 x₂ :=
            hOg_val U g x₂ _ (f₂.left z₀).2
          have hg_eq : g.1 x₁ = g.1 x₂ := hg₁.symm.trans ((congrArg g.1 hw_eq).trans hg₂)
          by_cases hx₁ : U.hom x₁ ∈ (V' : Set ↥C''.left)
          · by_cases hx₂ : U.hom x₂ ∈ (V' : Set ↥C''.left)
            · rw [hτ_pos U g x₁ hx₁, hτ_pos U g x₂ hx₂]
              have hu_eq : f₁ ≫ u_g U g x₁ hx₁ = f₂ ≫ u_g U g x₂ hx₂ :=
                @Subsingleton.elim _ (hSubHom Z₀) _ _
              rw [← hMapComp L_V.obj f₁ (u_g U g x₁ hx₁),
                ← hMapComp L_V.obj f₂ (u_g U g x₂ hx₂), hu_eq, hg_eq]
            · have hx₂_0 : g.1 x₂ = 0 := g.2 x₂ hx₂
              have hx₁_0 : g.1 x₁ = 0 := hg_eq.trans hx₂_0
              rw [hτ_zero_of_val U g x₁ hx₁_0, hτ_zero_of_val U g x₂ hx₂_0, map_zero, map_zero]
          · have hx₁_0 : g.1 x₁ = 0 := g.2 x₁ hx₁
            have hx₂_0 : g.1 x₂ = 0 := hg_eq.symm.trans hx₁_0
            rw [hτ_zero_of_val U g x₁ hx₁_0, hτ_zero_of_val U g x₂ hx₂_0, map_zero, map_zero]

    let θ_fun : ∀ U : C''.left.Etale, ↥(weilAltZeroBdrySubgroup C''.left V' m U) →
        ↥(L_V.obj.obj (Opposite.op U)) :=
      fun U g => Classical.choose (h_theta_ex U g)
    have hθ_spec : ∀ (U : C''.left.Etale) (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U))
        (x : ↥U.left),
        (L_V.obj.map (j_g U g x).op).hom (θ_fun U g) = τ_g U g x :=
      fun U g => (Classical.choose_spec (h_theta_ex U g)).1

    have hθ_inV : ∀ {U Y : C''.left.Etale} (w : Y ⟶ U) (u_Y : Y ⟶ V''_et)
        (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U)) (a : ULift.{u} (ZMod m)),
        (∀ y : ↥Y.left, g.1 (w.left y) = a) →
        (L_V.obj.map w.op).hom (θ_fun U g) = (L_V.obj.map u_Y.op).hom (ξ₀.hom a) := by
      intro U Y w u_Y g a hga
      by_cases hE : IsEmpty ↥Y.left
      · exact @Subsingleton.elim _ (hEmptySub C''.left L_V Y hE) _ _
      · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hE
        let x₀ := w.left y₀
        have hx₀_a : g.1 x₀ = a := hga y₀
        have hw_inV : ∀ y : ↥Y.left, U.hom (w.left y) ∈ (V' : Set ↥C''.left) := by
          intro y
          have hw_y : U.hom (w.left y) = V'.ι (u_Y.left y) := by
            rw [← AlgebraicGeometry.Scheme.Hom.comp_apply,
              CategoryTheory.MorphismProperty.Over.w w,
              ← CategoryTheory.MorphismProperty.Over.w u_Y,
              AlgebraicGeometry.Scheme.Hom.comp_apply]
            rfl
          rw [hw_y]
          exact (u_Y.left y).2
        have hx₀_V : U.hom x₀ ∈ (V' : Set ↥C''.left) := hw_inV y₀
        have hsub : Set.range ⇑w.left ⊆ Set.range ⇑(O_g U g x₀).ι := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨y, rfl⟩
          exact hOg_mk_inV U g x₀ (w.left y) hx₀_V ((hga y).trans hx₀_a.symm) (hw_inV y)
        let w_l := AlgebraicGeometry.IsOpenImmersion.lift (O_g U g x₀).ι w.left hsub
        have hw_l : w_l ≫ (O_g U g x₀).ι = w.left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (O_g U g x₀).ι w.left hsub
        let w_et : Y ⟶ W_g U g x₀ :=
          CategoryTheory.MorphismProperty.Over.homMk w_l
            (by
              change w_l ≫ (O_g U g x₀).ι ≫ U.hom = Y.hom
              rw [← CategoryTheory.Category.assoc, hw_l, CategoryTheory.MorphismProperty.Over.w w])
            trivial
        have hw_fac : w_et ≫ j_g U g x₀ = w :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext hw_l (Subsingleton.elim _ _)
        have hu_eq : w_et ≫ u_g U g x₀ hx₀_V = u_Y := @Subsingleton.elim _ (hSubHom Y) _ _
        calc
          (L_V.obj.map w.op).hom (θ_fun U g)
            = (L_V.obj.map w_et.op).hom ((L_V.obj.map (j_g U g x₀).op).hom (θ_fun U g)) := by
                rw [← hw_fac, hMapComp L_V.obj w_et (j_g U g x₀)]
          _ = (L_V.obj.map w_et.op).hom (τ_g U g x₀) := by rw [hθ_spec U g x₀]
          _ = (L_V.obj.map (w_et ≫ u_g U g x₀ hx₀_V).op).hom (ξ₀.hom (g.1 x₀)) := by
                rw [hτ_pos U g x₀ hx₀_V, ← hMapComp L_V.obj w_et (u_g U g x₀ hx₀_V)]
          _ = (L_V.obj.map u_Y.op).hom (ξ₀.hom a) := by rw [hu_eq, hx₀_a]

    have hθ_zero : ∀ {U Y : C''.left.Etale} (w : Y ⟶ U)
        (g : ↥(weilAltZeroBdrySubgroup C''.left V' m U)),
        (∀ y : ↥Y.left, g.1 (w.left y) = 0) →
        (L_V.obj.map w.op).hom (θ_fun U g) = 0 := by
      intro U Y w g hg0
      let Q_y : ↥Y.left → Y.left.Opens :=
        fun y => (TopologicalSpace.Opens.map w.left.base).obj (O_g U g (w.left y))
      let WY : ↥Y.left → C''.left.Etale := fun y =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ ((Q_y y).ι ≫ Y.hom)
          (by have : AlgebraicGeometry.Etale Y.hom := Y.prop; infer_instance)
      let jY : ∀ y : ↥Y.left, WY y ⟶ Y :=
        fun y => CategoryTheory.MorphismProperty.Over.homMk (Q_y y).ι rfl trivial
      have h_covY : ∀ y : ↥Y.left, ∃ (i : ↥Y.left) (z : ↥(WY i).left), (jY i).left z = y :=
        fun y => ⟨y, ⟨y, hOg_mem U g (w.left y)⟩, rfl⟩
      have h_zero_sec := hGlueArrows C''.left L_V Y WY jY h_covY (fun _ => 0)
        (fun _ _ _ _ _ _ => by simp)
      refine h_zero_sec.unique ?_ (fun _ => map_zero _)
      intro y
      have hsub : Set.range ⇑((Q_y y).ι ≫ w.left) ⊆ Set.range ⇑(O_g U g (w.left y)).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨z, rfl⟩
        exact z.2
      let q_l := AlgebraicGeometry.IsOpenImmersion.lift (O_g U g (w.left y)).ι
        ((Q_y y).ι ≫ w.left) hsub
      have hq_l : q_l ≫ (O_g U g (w.left y)).ι = (Q_y y).ι ≫ w.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hsub
      let q_et : WY y ⟶ W_g U g (w.left y) :=
        CategoryTheory.MorphismProperty.Over.homMk q_l
          (by
            change q_l ≫ (O_g U g (w.left y)).ι ≫ U.hom = (Q_y y).ι ≫ Y.hom
            rw [← CategoryTheory.Category.assoc, hq_l, CategoryTheory.Category.assoc,
              CategoryTheory.MorphismProperty.Over.w w])
          trivial
      have hq_fac : q_et ≫ j_g U g (w.left y) = jY y ≫ w :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hq_l (Subsingleton.elim _ _)
      calc
        (L_V.obj.map (jY y).op).hom ((L_V.obj.map w.op).hom (θ_fun U g))
          = (L_V.obj.map (jY y ≫ w).op).hom (θ_fun U g) :=
              (hMapComp L_V.obj (jY y) w _).symm
        _ = (L_V.obj.map q_et.op).hom ((L_V.obj.map (j_g U g (w.left y)).op).hom (θ_fun U g)) := by
              rw [← hq_fac, hMapComp L_V.obj q_et (j_g U g (w.left y))]
        _ = (L_V.obj.map q_et.op).hom (τ_g U g (w.left y)) := by rw [hθ_spec]
        _ = 0 := by rw [hτ_zero_of_val U g (w.left y) (hg0 y), map_zero]

    let Θ_inv_pre : weilAltZeroBdrySubpresheaf C''.left V' m ⟶ L_V.obj :=
      { app := fun U_op =>
          AddCommGrpCat.ofHom
            { toFun := θ_fun (Opposite.unop U_op)
