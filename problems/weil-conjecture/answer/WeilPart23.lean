            rw [← pow_add, Nat.sub_add_cancel hle_i]
          have hsec : m i * res_A (g ^ k_i) =
              res_A ((IsLocalization.Away.sec g (m i)).1) :=
            IsLocalization.Away.sec_spec g (m i)
          calc
            res_A (g ^ N) * m i
              = res_A (g ^ q_i) * (m i * res_A (g ^ k_i)) := by
                rw [hN_eq, map_mul, mul_assoc, mul_comm (res_A (g ^ k_i)) (m i)]
            _ = res_A (c i) := by
                rw [hsec, ← map_mul]
        have hsum0 : res_B (∑ i : Fin ℓ, (bar_p.left.app W).hom (c i) * v i) = 0 := by
          calc
            res_B (∑ i : Fin ℓ, (bar_p.left.app W).hom (c i) * v i)
              = ∑ i : Fin ℓ, φ_U (res_A (c i)) * res_B (v i) := by
                rw [map_sum]
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [map_mul, hNat_AU]
            _ = ∑ i : Fin ℓ, φ_U (res_A (g ^ N)) * (φ_U (m i) * res_B (v i)) := by
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [← hclear i, map_mul, mul_assoc]
            _ = φ_U (res_A (g ^ N)) * e₀ m := (Finset.mul_sum _ _ _).symm
