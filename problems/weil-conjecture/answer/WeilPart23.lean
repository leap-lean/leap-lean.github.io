          dsimp [q_i, α_AL]
          rw [map_mul, map_mul, map_pow]
          ring
        rw [h1, hD_qi i]
        rfl
      · intro x y hxy
        exact ⟨1, by simp [hInj_ψ hxy]⟩
    have hCU_to_B : ∀ c : C_U, ∃ b : B, τ b = ψ c := by
      intro c
      have hc_int : _root_.IsIntegral A c := Algebra.IsIntegral.isIntegral c
      have hψc_int : α_AL.IsIntegralElem (ψ c) := by
        obtain ⟨P, hPm, hPe⟩ := hc_int
        refine ⟨P, hPm, ?_⟩
        have h1 := congrArg ψ hPe
        rw [Polynomial.hom_eval₂, map_zero, hcomp_ψ] at h1
        exact h1
