      rw [← hz_repr]
      refine Finset.sum_eq_zero (fun k_idx _ => ?_)
      rw [hrepr0 k_idx, zero_smul]
    refine ⟨⟨ψ, hInj_ψ⟩, ?_⟩
    intro hIC_CU B _ φ_AB τ σ_B hInj_τ hτ_comp hτ_int hτ_σ
    have : IsDomain C_U := Function.Injective.isDomain ψ hInj_ψ
    let alg_CU_L : Algebra C_U L := ψ.toAlgebra
