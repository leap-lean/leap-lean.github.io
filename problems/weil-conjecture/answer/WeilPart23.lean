      rw [← Set.image_singleton, ← Ideal.map_span, hsb₂, hMapPow nb]
    rw [hUniq₁ (Units.map ψ.toMonoidHom u₂) (φ a₂) (φ b₂) na nb hφa hφb heq₁ hsa₁ hsb₁, hord₂]

  
