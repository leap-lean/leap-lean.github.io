    apply (adjℤ₁.homEquiv A (R_h_ab.obj (U_std₂.obj one₂))).injective
    have hL0 : adjℤ₁.homEquiv A (R_h_ab.obj (U_std₂.obj one₂))
          ((γ₁ ≫ U_std₁.map α_h) ≫ e_one₂.hom) =
        (ι₀ ≫ u_std₁) ≫ FgtMod.map (α_h.hom.app (Opposite.op T₁)) := by
      rw [Adjunction.homEquiv_naturality_right adjℤ₁ (γ₁ ≫ U_std₁.map α_h) e_one₂.hom,
