        rw [hC_quot, hC_const, hc0, map_one, mul_one]
      let L : ZMod ℓ → Polynomial k := fun a => Lagrange.basis Finset.univ ν a
      have hL_sum : (Finset.univ : Finset (ZMod ℓ)).sum L = 1 :=
        Lagrange.sum_basis hν_inj.injOn Finset.univ_nonempty
      have hL_orth : ∀ a b : ZMod ℓ, a ≠ b → (Polynomial.X ^ ℓ - 1) ∣ L a * L b := by
        intro a b hab
        rw [← hP_eq]
        apply hP_dvd_of_eval
        intro m
        rw [Polynomial.eval_mul]
        by_cases hma : m = a
        · subst hma
          rw [Lagrange.eval_basis_of_ne hab.symm (Finset.mem_univ m), mul_zero]
        · rw [Lagrange.eval_basis_of_ne (Ne.symm hma) (Finset.mem_univ m), zero_mul]
      have hL_eigen : ∀ a : ZMod ℓ,
          (Polynomial.X ^ ℓ - 1) ∣ (Polynomial.X - Polynomial.C (ν a)) * L a := by
        intro a
        rw [← hP_eq]
        apply hP_dvd_of_eval
        intro m
        rw [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
        by_cases hma : m = a
        · subst hma
          rw [sub_self, zero_mul]
        · rw [Lagrange.eval_basis_of_ne (Ne.symm hma) (Finset.mem_univ m), mul_zero]
      intro R _ φ v hv
      let ψ : Polynomial k →+* R := Polynomial.eval₂RingHom φ v
      have hψ_kill : ∀ F : Polynomial k, (Polynomial.X ^ ℓ - 1) ∣ F → ψ F = 0 := by
        rintro F ⟨G, rfl⟩
        simp [ψ, hv]
      refine ⟨fun a => ψ (L a), ?_, ?_, ?_⟩
      · rw [← map_sum ψ, hL_sum, map_one]
      · intro a b hab
        rw [← map_mul]
        exact hψ_kill _ (hL_orth a b hab)
      · intro a
        have h0 := hψ_kill _ (hL_eigen a)
        rw [map_mul, map_sub] at h0
        have hX : ψ Polynomial.X = v := Polynomial.eval₂_X φ v
        have hC : ψ (Polynomial.C (ν a)) = φ (ν a) := Polynomial.eval₂_C φ v
        rw [hX, hC, sub_mul] at h0
        exact sub_eq_zero.mp h0
    have hSecExt : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        (r₁ r₂ : ↑(Y.presheaf.obj (Opposite.op ⊤))),
        (∀ x : ↥Y, (Y.presheaf.Γgerm x).hom r₁ = (Y.presheaf.Γgerm x).hom r₂) → r₁ = r₂ :=
      fun Y r₁ r₂ h => TopCat.Presheaf.section_ext Y.sheaf ⊤ r₁ r₂ (fun x _ => h x)
    have hAppTopGerm : ∀ {Y' Y : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Y' Y)
        (y : ↥Y') (r : ↑(Y.presheaf.obj (Opposite.op ⊤))),
        (Y'.presheaf.Γgerm y).hom ((AlgebraicGeometry.Scheme.Hom.appTop f).hom r) =
          (AlgebraicGeometry.Scheme.Hom.stalkMap f y).hom
            ((Y.presheaf.Γgerm (f.base y)).hom r) :=
      fun f y r => (AlgebraicGeometry.Scheme.Hom.germ_stalkMap_apply f ⊤ y trivial r).symm
    have hGlueEx : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        (κ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
        (g : LocallyConstant ↥Y (ZMod ℓ)),
        ∃ s : ↑(Y.presheaf.obj (Opposite.op ⊤)),
          ∀ x : ↥Y, (Y.presheaf.Γgerm x).hom s = (Y.presheaf.Γgerm x).hom (κ (ν (g x))) := by
      intro Y κ g
      let O_g : ZMod ℓ → Y.Opens := fun a => ⟨g ⁻¹' {a}, g.isLocallyConstant {a}⟩
      let sf : ∀ a : ZMod ℓ, ↑(Y.presheaf.obj (Opposite.op (O_g a))) :=
        fun a => (Y.presheaf.map (CategoryTheory.homOfLE (le_top : O_g a ≤ ⊤)).op).hom (κ (ν a))
      have hcov : (⊤ : Y.Opens) ≤ ⨆ a : ZMod ℓ, O_g a := by
        intro x _
        rw [TopologicalSpace.Opens.mem_iSup]
        exact ⟨g x, rfl⟩
      obtain ⟨s, hs, _⟩ := Y.sheaf.existsUnique_gluing' O_g ⊤
        (fun a => CategoryTheory.homOfLE (le_top : O_g a ≤ ⊤)) hcov sf (by
          intro a b
          by_cases hab : a = b
          · subst hab; rfl
          · have hbot : O_g a ⊓ O_g b = ⊥ := by
              ext x
              simp only [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_bot,
                Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
              intro ha hb
              exact hab (ha.symm.trans hb)
            have hSub : Subsingleton ↑(Y.presheaf.obj (Opposite.op (O_g a ⊓ O_g b))) := by
              rw [hbot]
              infer_instance
            exact @Subsingleton.elim _ hSub _ _)
      refine ⟨s, fun x => ?_⟩
      have hx : x ∈ O_g (g x) := rfl
      have hres := congrArg ((Y.presheaf.germ (O_g (g x)) x hx).hom) (hs (g x))
      have hcomp : Y.presheaf.map (CategoryTheory.homOfLE (le_top : O_g (g x) ≤ ⊤)).op ≫
          Y.presheaf.germ (O_g (g x)) x hx = Y.presheaf.Γgerm x :=
        TopCat.Presheaf.germ_res Y.presheaf (CategoryTheory.homOfLE (le_top : O_g (g x) ≤ ⊤)) x hx
      have hL : (Y.presheaf.germ (O_g (g x)) x hx).hom
          ((Y.presheaf.map (CategoryTheory.homOfLE (le_top : O_g (g x) ≤ ⊤)).op).hom s) =
          (Y.presheaf.Γgerm x).hom s :=
        congrArg (fun ψ => ψ.hom s) hcomp
      have hR : (Y.presheaf.germ (O_g (g x)) x hx).hom (sf (g x)) =
          (Y.presheaf.Γgerm x).hom (κ (ν (g x))) :=
        congrArg (fun ψ => ψ.hom (κ (ν (g x)))) hcomp
      exact hL.symm.trans (hres.trans hR)
    let Ψ : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        (_ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤))),
        LocallyConstant ↥Y (ZMod ℓ) → ↑(Y.presheaf.obj (Opposite.op ⊤)) :=
      fun Y κ g => Classical.choose (hGlueEx Y κ g)
    have hΨ_germ : ∀ (Y : AlgebraicGeometry.Scheme.{u})
        (κ : k →+* ↑(Y.presheaf.obj (Opposite.op ⊤)))
        (g : LocallyConstant ↥Y (ZMod ℓ)) (x : ↥Y),
