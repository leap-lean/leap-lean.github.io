theorem weil_etale_finite_sheetSplit_pushforward_localTorsion_iso_and_det_counit (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) ℓ)
    (Y' Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g : Quiver.Hom Y'.left Y.left)
    (hg_over : CategoryTheory.CategoryStruct.comp g Y.hom = Y'.hom)
    [AlgebraicGeometry.IsFinite g]
    (hPresEpi : WeilEtalePushforwardPreservesEpi g)
    (V : Y.left.Opens)
    (hEt_p : AlgebraicGeometry.Etale (g ∣_ V))
    (hSheetSplit_V : ∀ x : ↥V.toScheme,
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (_ : AlgebraicGeometry.IsAffine W)
        (w : W ⟶ V.toScheme) (_ : AlgebraicGeometry.Etale w)
        (w₀ : ↥W) (_ : w.base w₀ = x)
        (s_sh : ZMod ℓ → (W ⟶ CategoryTheory.Limits.pullback (g ∣_ V) w)),
        (∀ i : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (s_sh i)) ∧
        (∀ i : ZMod ℓ,
          s_sh i ≫ CategoryTheory.Limits.pullback.snd (g ∣_ V) w =
            CategoryTheory.CategoryStruct.id W) ∧
        (_root_.Pairwise fun i j : ZMod ℓ =>
          Disjoint (Set.range (s_sh i).base) (Set.range (s_sh j).base)) ∧
        (⋃ i : ZMod ℓ, Set.range (s_sh i).base) = Set.univ)
    (V'_et : Y.left.Etale)
    (e_V' : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj V'_et).left
      (AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map g.base).obj V)))
    (he_V' : CategoryTheory.CategoryStruct.comp e_V'.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Opens.ι
          ((TopologicalSpace.Opens.map g.base).obj V))
        g) =
      ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj V'_et).hom)
    (g_shriek : weilEtaleTorsionH Y'.left ℓ 2 →+ weilEtaleTorsionH Y.left ℓ 2)
    (hg_sh : WeilTopDegAffineFiniteFreePushforward k ℓ ℓ 2 ζ Y' Y g g_shriek) :
    let V'_open : Y'.left.Opens := (TopologicalSpace.Opens.map g.base).obj V
    let V''_et : Y'.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ V'_open.ι
        (inferInstance : AlgebraicGeometry.Etale V'_open.ι)
    ∃ Ψ_M : weilEtaleLocalTorsionH Y'.left ℓ V''_et 2 →+
