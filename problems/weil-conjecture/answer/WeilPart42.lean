      haveI : IsNoetherianRing B_q := IsLocalization.isNoetherianRing 𝔮.primeCompl B_q hNoethB
      have hmem_max_Bq : ∀ b : B, b ∈ 𝔮 ↔ algebraMap B B_q b ∈ IsLocalRing.maximalIdeal B_q :=
        fun b => SetLike.ext_iff.mp (Localization.AtPrime.comap_maximalIdeal (I := 𝔮)).symm b
      have h_units_q : ∀ s : 𝔮.primeCompl, IsUnit (algebraMap B L_loc s.1) := by
        intro s
        have hs_ne : s.1 ≠ 0 := nonZeroDivisors.ne_zero (𝔮.primeCompl_le_nonZeroDivisors s.2)
        refine IsUnit.mk0 _ fun h0 => hs_ne (Subtype.ext h0)
      let ι : B_q →+* L_loc := IsLocalization.lift h_units_q
      have hι_eq : ∀ b : B, ι (algebraMap B B_q b) = (b : L_loc) :=
        fun b => IsLocalization.lift_eq h_units_q b
      have hι_inj : Function.Injective ι := by
        intro w₁ w₂ hw
        suffices h0 : w₁ - w₂ = 0 by exact sub_eq_zero.mp h0
        have hw0 : ι (w₁ - w₂) = 0 := by rw [map_sub, hw, sub_self]
        obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj 𝔮.primeCompl (w₁ - w₂)
        dsimp only at has
        have haL : (a : L_loc) = 0 := by rw [← hι_eq a, ← has, map_mul, hw0, zero_mul]
        have haB : a = 0 := Subtype.ext haL
        rw [haB, map_zero, mul_comm] at has
        exact (IsLocalization.map_units B_q s).mul_right_eq_zero.mp has
      let u : L_loc := (z : L_loc) / (t₁B : L_loc)
      have hu_not_range : u ∉ Set.range ι := by
        rintro ⟨w, hw⟩
        obtain ⟨⟨b₁, s₁⟩, hws⟩ := IsLocalization.surj 𝔮.primeCompl w
        dsimp only at hws
        have hL : ((s₁.1 * z : B) : L_loc) = ((t₁B * b₁ : B) : L_loc) := by
          have h1 := congrArg ι hws
          rw [map_mul, hι_eq, hι_eq, hw] at h1
          change ((z : L_loc) / (t₁B : L_loc)) * (s₁.1 : L_loc) = (b₁ : L_loc) at h1
          change (s₁.1 : L_loc) * (z : L_loc) = (t₁B : L_loc) * (b₁ : L_loc)
          calc
            (s₁.1 : L_loc) * (z : L_loc) =
                (t₁B : L_loc) * (((z : L_loc) / (t₁B : L_loc)) * (s₁.1 : L_loc)) := by
              field_simp [ht₁B_L_ne]
            _ = (t₁B : L_loc) * (b₁ : L_loc) := by rw [h1]
        have hB : s₁.1 * z = t₁B * b₁ := Subtype.ext hL
        exact s₁.2 ((h𝔮_iff s₁.1).mpr (Ideal.mem_span_singleton.mpr ⟨b₁, hB⟩))
      have hu_mul_max : ∀ m ∈ IsLocalRing.maximalIdeal B_q, ∃ v : B_q, u * ι m = ι v := by
        intro m hm
        obtain ⟨⟨y, s⟩, hms⟩ := IsLocalization.surj 𝔮.primeCompl m
        dsimp only at hms
        have hy_max : algebraMap B B_q y ∈ IsLocalRing.maximalIdeal B_q := by
          rw [← hms]; exact Ideal.mul_mem_right _ _ hm
        have hy_q : y ∈ 𝔮 := (hmem_max_Bq y).mpr hy_max
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp ((h𝔮_iff y).mp hy_q)
        refine ⟨IsLocalization.mk' B_q c s, ?_⟩
        have hs_ne : (s.1 : L_loc) ≠ 0 := (h_units_q s).ne_zero
        have hms_L : ι m * (s.1 : L_loc) = (y : L_loc) := by
          have h := congrArg ι hms; rwa [map_mul, hι_eq, hι_eq] at h
        have hmk_L : ι (IsLocalization.mk' B_q c s) * (s.1 : L_loc) = (c : L_loc) := by
          have h := congrArg ι (IsLocalization.mk'_spec' B_q c s)
          rw [map_mul, hι_eq, hι_eq] at h; linear_combination h
        have hc_L : (y : L_loc) * (z : L_loc) = (t₁B : L_loc) * (c : L_loc) :=
          congrArg Subtype.val hc
        dsimp [u]
        apply mul_right_cancel₀ hs_ne
        calc
          (z : L_loc) / (t₁B : L_loc) * ι m * (s.1 : L_loc) =
              (z : L_loc) / (t₁B : L_loc) * (ι m * (s.1 : L_loc)) := by ring
          _ = (z : L_loc) / (t₁B : L_loc) * (y : L_loc) := by rw [hms_L]
          _ = ((y : L_loc) * (z : L_loc)) / (t₁B : L_loc) := by ring
          _ = (c : L_loc) := by rw [hc_L, mul_div_cancel_left₀ _ ht₁B_L_ne]
          _ = ι (IsLocalization.mk' B_q c s) * (s.1 : L_loc) := hmk_L.symm
      have hex_unit : ∃ m₀ ∈ IsLocalRing.maximalIdeal B_q, ∃ v₀ : B_q,
          u * ι m₀ = ι v₀ ∧ v₀ ∉ IsLocalRing.maximalIdeal B_q := by
        by_contra h_all
        push_neg at h_all
        letI : Algebra B_q L_loc := ι.toAlgebra
        let J : Submodule B_q L_loc :=
          Submodule.map (Algebra.linearMap B_q L_loc) (IsLocalRing.maximalIdeal B_q)
        have hJ_fg : J.FG :=
          Submodule.FG.map _ (IsNoetherian.noetherian (IsLocalRing.maximalIdeal B_q))
        have hJ_ne : J ≠ ⊥ := by
          intro hbot
          have ht₁_max : algebraMap B B_q t₁B ∈ IsLocalRing.maximalIdeal B_q :=
            (hmem_max_Bq t₁B).mp ht₁B_mem
          have ht₁_J : Algebra.linearMap B_q L_loc (algebraMap B B_q t₁B) ∈ J :=
            Submodule.mem_map_of_mem ht₁_max
          rw [hbot, Submodule.mem_bot] at ht₁_J
          change ι (algebraMap B B_q t₁B) = 0 at ht₁_J
          rw [hι_eq] at ht₁_J
          exact ht₁B_L_ne ht₁_J
        have hu_stab : ∀ x ∈ J, u • x ∈ J := by
          rintro _ ⟨m, hm, rfl⟩
          obtain ⟨v, hv⟩ := hu_mul_max m hm
          exact ⟨v, h_all m hm v hv, hv.symm⟩
        have hu_int_Bq : IsIntegral B_q u :=
          isIntegral_of_smul_mem_submodule J hJ_ne hJ_fg u hu_stab
        obtain ⟨P, hP_monic, hP_eval⟩ := hu_int_Bq
        let d := P.natDegree
        have hsurj_coeff : ∀ k : ℕ, ∃ p : B × 𝔮.primeCompl,
            P.coeff k * algebraMap B B_q p.2.1 = algebraMap B B_q p.1 :=
          fun k => IsLocalization.surj 𝔮.primeCompl (P.coeff k)
        choose p_cf hp_cf using hsurj_coeff
        let S : 𝔮.primeCompl := ∏ k ∈ Finset.range d, (p_cf k).2
        have hS_dvd : ∀ k ∈ Finset.range d, ∃ q_k : B, S.1 = (p_cf k).2.1 * q_k := by
          intro k hk
          obtain ⟨q_sub, hq_sub⟩ := Finset.dvd_prod_of_mem (fun j => (p_cf j).2) hk
          exact ⟨q_sub.1, congrArg Subtype.val hq_sub⟩
        choose q_cf hq_cf using hS_dvd
        let c_B : ℕ → B := fun k =>
          if hk : k ∈ Finset.range d then S.1 ^ (d - 1 - k) * ((p_cf k).1 * q_cf k hk) else 0
        let Q_B : Polynomial B :=
          Polynomial.X ^ d + ∑ k ∈ Finset.range d, Polynomial.C (c_B k) * Polynomial.X ^ k
        have hQ_monic : Q_B.Monic := by
          apply Polynomial.monic_X_pow_add
          have hdeg_lt : ∀ m : ℕ, m ≤ d →
              (∑ k ∈ Finset.range m, Polynomial.C (c_B k) * Polynomial.X ^ k).degree <
                (d : WithBot ℕ) := by
            intro m hm
            induction m with
            | zero =>
              simp only [Finset.range_zero, Finset.sum_empty, Polynomial.degree_zero]
              exact WithBot.bot_lt_coe d
            | succ m ih =>
              rw [Finset.sum_range_succ]
              refine (Polynomial.degree_add_le _ _).trans_lt (max_lt (ih (Nat.le_of_succ_le hm)) ?_)
              exact (Polynomial.degree_C_mul_X_pow_le m (c_B m)).trans_lt (WithBot.coe_lt_coe.mpr hm)
          exact hdeg_lt d le_rfl
        have hP_sum : u ^ d + ∑ k ∈ Finset.range d, ι (P.coeff k) * u ^ k = 0 := by
          have hev : Polynomial.eval₂ ι u P = 0 := hP_eval
          rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, hP_monic.coeff_natDegree,
            map_one, one_mul, add_comm] at hev
          exact hev
        have hQ_eval : Polynomial.aeval ((S.1 : L_loc) * u) Q_B = 0 := by
          dsimp [Q_B]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ k ∈ Finset.range d,
              (Polynomial.aeval ((S.1 : L_loc) * u)) (Polynomial.C (c_B k) * Polynomial.X ^ k) =
                (S.1 : L_loc) ^ d * (ι (P.coeff k) * u ^ k) := by
            intro k hk
            have hk_lt : k < d := Finset.mem_range.mp hk
            have hcoeff_S : ι (P.coeff k) * (S.1 : L_loc) =
                (((p_cf k).1 * q_cf k hk : B) : L_loc) := by
              have h1 := congrArg ι (hp_cf k)
              rw [map_mul, hι_eq, hι_eq] at h1
              have h2 : (S.1 : L_loc) = ((p_cf k).2.1 : L_loc) * (q_cf k hk : L_loc) := by
                exact_mod_cast hq_cf k hk
              rw [h2, ← mul_assoc, h1]; rfl
            have hd_split : (S.1 : L_loc) ^ d =
                (S.1 : L_loc) ^ (d - 1 - k) * (S.1 : L_loc) * (S.1 : L_loc) ^ k := by
              rw [← pow_succ, ← pow_add]; congr 1; omega
            rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
            have hc_eq : (algebraMap B L_loc (c_B k)) =
                (S.1 : L_loc) ^ (d - 1 - k) * (((p_cf k).1 * q_cf k hk : B) : L_loc) := by
              dsimp [c_B]; rw [dif_pos hk]; rfl
            rw [hc_eq, ← hcoeff_S, mul_pow, hd_split]; ring
          rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, mul_pow, ← mul_add, hP_sum, mul_zero]
        have huS_int_B : IsIntegral B ((S.1 : L_loc) * u) := ⟨Q_B, hQ_monic, hQ_eval⟩
        have huS_int_R : IsIntegral R_loc ((S.1 : L_loc) * u) :=
          isIntegral_trans (R := R_loc) (A := B) ((S.1 : L_loc) * u) huS_int_B
        let b_u : B := ⟨(S.1 : L_loc) * u, huS_int_R⟩
        apply hu_not_range
        refine ⟨IsLocalization.mk' B_q b_u S, ?_⟩
        have hs_ne : (S.1 : L_loc) ≠ 0 := (h_units_q S).ne_zero
        apply mul_right_cancel₀ hs_ne
        have hmk := congrArg ι (IsLocalization.mk'_spec' B_q b_u S)
        rw [map_mul, hι_eq, hι_eq] at hmk
        calc
          ι (IsLocalization.mk' B_q b_u S) * (S.1 : L_loc) = (b_u : L_loc) := by linear_combination hmk
          _ = u * (S.1 : L_loc) := by change (S.1 : L_loc) * u = u * (S.1 : L_loc); ring
      obtain ⟨m₀, hm₀_max, v₀, hv₀_eq, hv₀_not_max⟩ := hex_unit
      obtain ⟨uv₀, huv₀⟩ := IsLocalRing.notMem_maximalIdeal.mp hv₀_not_max
      let π_q : B_q := ↑(uv₀⁻¹) * m₀
      have hπ_max : π_q ∈ IsLocalRing.maximalIdeal B_q := Ideal.mul_mem_left _ _ hm₀_max
      have huπ : u * ι π_q = 1 := by
        dsimp [π_q]; rw [map_mul]
        have hinv : ι ↑(uv₀⁻¹) * ι v₀ = 1 := by rw [← huv₀, ← map_mul, Units.inv_mul, map_one]
        calc
          u * (ι ↑(uv₀⁻¹) * ι m₀) = ι ↑(uv₀⁻¹) * (u * ι m₀) := by ring
          _ = ι ↑(uv₀⁻¹) * ι v₀ := by rw [hv₀_eq]
          _ = 1 := hinv
      have hmax_prin : IsLocalRing.maximalIdeal B_q = Ideal.span {π_q} := by
        apply le_antisymm
        · intro m hm
          obtain ⟨v, hv⟩ := hu_mul_max m hm
          have hmv : m = v * π_q := by
            apply hι_inj; rw [map_mul]
            calc
              ι m = ι m * (u * ι π_q) := by rw [huπ, mul_one]
              _ = (u * ι m) * ι π_q := by ring
              _ = ι v * ι π_q := by rw [hv]
          exact Ideal.mem_span_singleton.mpr ⟨v, by rw [hmv]; ring⟩
        · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ_max)
      have hprime_bot : ∀ (P : Ideal B_q), P.IsPrime → P < IsLocalRing.maximalIdeal B_q → P = ⊥ := by
        intro P hP hP_lt
        have hπ_not_P : π_q ∉ P := fun hmem =>
          not_le_of_gt hP_lt (by rw [hmax_prin]; exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem))
        apply eq_bot_iff.mpr
        intro x hx
        have hx_pow : ∀ k : ℕ, x ∈ (IsLocalRing.maximalIdeal B_q) ^ k := by
          intro k
          induction k with
          | zero => simp
          | succ k ih =>
            rw [hmax_prin, Ideal.span_singleton_pow] at ih ⊢
            obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ih
            have hy_P : y ∈ P := by
              rcases hP.mem_or_mem hx with hpow | hy
              · exact absurd (hP.mem_of_pow_mem k hpow) hπ_not_P
              · exact hy
            have hy_max : y ∈ Ideal.span {π_q} := by rw [← hmax_prin]; exact hP_lt.le hy_P
            obtain ⟨y', rfl⟩ := Ideal.mem_span_singleton.mp hy_max
            exact Ideal.mem_span_singleton.mpr ⟨y', by ring⟩
        have hx_iInf : x ∈ ⨅ k : ℕ, (IsLocalRing.maximalIdeal B_q) ^ k := Ideal.mem_iInf.mpr hx_pow
        rwa [Ideal.iInf_pow_eq_bot_of_isLocalRing _
          (IsLocalRing.maximalIdeal.isMaximal B_q).ne_top] at hx_iInf
      have hp₁_lt : Ideal.span {t₁} < Ideal.comap (algebraMap R_loc B) 𝔮 := by
        rw [hcomap_𝔮, hmax]
        refine lt_of_le_of_ne (Ideal.span_mono (by simp)) ?_
        intro heq; apply ht₂_not_mem; rw [heq]; exact Ideal.subset_span (by simp)
      haveI : 𝔮.LiesOver (Ideal.comap (algebraMap R_loc B) 𝔮) := ⟨rfl⟩
      obtain ⟨𝔮₁, h𝔮₁_le, h𝔮₁_prime, h𝔮₁_over⟩ :=
        Algebra.HasGoingDown.exists_ideal_le_liesOver_of_lt 𝔮 hp₁_lt
      have h𝔮₁_comap : Ideal.comap (algebraMap R_loc B) 𝔮₁ = Ideal.span {t₁} := (h𝔮₁_over.over).symm
      have hdisj₁ : Disjoint (𝔮.primeCompl : Set B) (𝔮₁ : Set B) := by
        rw [Set.disjoint_left]; intro s hs hs₁; exact hs (h𝔮₁_le hs₁)
      let P₁ : Ideal B_q := 𝔮₁.map (algebraMap B B_q)
      have hP₁_prime : P₁.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint 𝔮.primeCompl B_q 𝔮₁ h𝔮₁_prime hdisj₁
      have hP₁_le : P₁ ≤ IsLocalRing.maximalIdeal B_q := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal]; exact Ideal.map_mono h𝔮₁_le
      have hP₁_lt : P₁ < IsLocalRing.maximalIdeal B_q := by
        refine lt_of_le_of_ne hP₁_le ?_
        intro heq
        have ht₂_P₁ : algebraMap B B_q t₂B ∈ P₁ := by rw [heq]; exact (hmem_max_Bq t₂B).mp ht₂B_mem
        have ht₂_q₁ : t₂B ∈ Ideal.under B (Ideal.map (algebraMap B B_q) 𝔮₁) := ht₂_P₁
        rw [IsLocalization.comap_map_of_isPrime_disjoint 𝔮.primeCompl B_q h𝔮₁_prime hdisj₁] at ht₂_q₁
        have ht₂_p₁ : t₂ ∈ Ideal.comap (algebraMap R_loc B) 𝔮₁ := ht₂_q₁
        rw [h𝔮₁_comap] at ht₂_p₁; exact ht₂_not_mem ht₂_p₁
      have hP₁_bot : P₁ = ⊥ := hprime_bot P₁ hP₁_prime hP₁_lt
      have ht₁_q₁ : t₁B ∈ 𝔮₁ := by
        have ht₁_p₁ : t₁ ∈ Ideal.span {t₁} := Ideal.subset_span rfl
        rwa [← h𝔮₁_comap] at ht₁_p₁
      have ht₁_P₁ : algebraMap B B_q t₁B ∈ P₁ := Ideal.mem_map_of_mem _ ht₁_q₁
      rw [hP₁_bot, Submodule.mem_bot] at ht₁_P₁
      exact ht₁B_ne (IsLocalization.injective B_q 𝔮.primeCompl_le_nonZeroDivisors
        (ht₁_P₁.trans (map_zero _).symm))
    let κ := IsLocalRing.ResidueField R_loc
    let V := TensorProduct R_loc κ B
    haveI : Module.Finite κ V := inferInstance
    let r := Module.finrank κ V
    let bV : Module.Basis (Fin r) κ V := Module.finBasis κ V
    have htmul_surj : Function.Surjective (fun b : B => (1 : κ) ⊗ₜ[R_loc] b) := by
      intro v
      refine TensorProduct.induction_on (motive := fun v => ∃ b : B, (1 : κ) ⊗ₜ[R_loc] b = v)
        v ⟨0, TensorProduct.tmul_zero _ _⟩ ?_ ?_
      · intro c b
        obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective c
        refine ⟨a • b, ?_⟩
        rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]; rfl
      · rintro x y ⟨bx, rfl⟩ ⟨by_, rfl⟩
        exact ⟨bx + by_, TensorProduct.tmul_add _ _ _⟩
    choose e he using fun i : Fin r => htmul_surj (bV i)
    have hspan_e : Submodule.span R_loc (Set.range e) = ⊤ :=
      IsLocalRing.span_eq_top_of_tmul_eq_basis e bV he
    let Φ : (Fin r → R_loc) →ₗ[R_loc] B :=
      { toFun := fun x => ∑ i : Fin r, x i • e i
        map_add' := fun x y => by simp [add_smul, Finset.sum_add_distrib]
        map_smul' := fun c x => by simp [mul_smul, Finset.smul_sum] }
    have hΦ_surj : Function.Surjective Φ := by
      intro b
      have hb : b ∈ Submodule.span R_loc (Set.range e) := by rw [hspan_e]; trivial
      rwa [Submodule.mem_span_range_iff_exists_fun] at hb
    let N_ker : Submodule R_loc (Fin r → R_loc) := LinearMap.ker Φ
    have hN_fg : N_ker.FG := IsNoetherian.noetherian N_ker
    have hN_smul : N_ker ≤ (IsLocalRing.maximalIdeal R_loc) • N_ker := by
      intro x hx
      have hΦx : Φ x = 0 := hx
      have hxi_max : ∀ i : Fin r, x i ∈ IsLocalRing.maximalIdeal R_loc := by
        intro i
        have h0V : (1 : κ) ⊗ₜ[R_loc] (Φ x) = 0 := by rw [hΦx, TensorProduct.tmul_zero]
        change (1 : κ) ⊗ₜ[R_loc] (∑ j : Fin r, x j • e j) = 0 at h0V
        rw [TensorProduct.tmul_sum] at h0V
        have htermV : ∀ j : Fin r,
            (1 : κ) ⊗ₜ[R_loc] (x j • e j) = (IsLocalRing.residue R_loc (x j)) • bV j := by
          intro j
          rw [← TensorProduct.smul_tmul, ← he j, TensorProduct.smul_tmul',
            Algebra.smul_def, Algebra.smul_def]; rfl
        simp_rw [htermV] at h0V
        have hres0 : IsLocalRing.residue R_loc (x i) = 0 :=
          Fintype.linearIndependent_iff.mp bV.linearIndependent _ h0V i
        rwa [← IsLocalRing.ker_residue, RingHom.mem_ker]
      have hxi_span : ∀ i : Fin r, ∃ ab : R_loc × R_loc, x i = t₁ * ab.1 + t₂ * ab.2 := by
        intro i
        have hm := hxi_max i; rw [hmax, Ideal.mem_span_pair] at hm
        obtain ⟨a_i, b_i, hab⟩ := hm
        exact ⟨(a_i, b_i), by linear_combination -hab⟩
      choose ab hab using hxi_span
      let a : Fin r → R_loc := fun i => (ab i).1
      let b_vec : Fin r → R_loc := fun i => (ab i).2
      have hx_ab : x = t₁ • a + t₂ • b_vec := funext hab
      have hΦ_rel : t₁B * Φ a + t₂B * Φ b_vec = 0 := by
        have h1 : Φ x = t₁ • Φ a + t₂ • Φ b_vec := by rw [hx_ab, map_add, map_smul, map_smul]
        rw [hΦx, Algebra.smul_def, Algebra.smul_def] at h1; exact h1.symm
      have hΦb_span : Φ b_vec ∈ Ideal.span {t₁B} :=
        hRegSeq _ (Ideal.mem_span_singleton.mpr ⟨-Φ a, by linear_combination hΦ_rel⟩)
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hΦb_span
      obtain ⟨c, rfl⟩ := hΦ_surj w
      let a' : Fin r → R_loc := a + t₂ • c
      let b' : Fin r → R_loc := b_vec - t₁ • c
      have hb'_ker : b' ∈ N_ker := by
        change Φ (b_vec - t₁ • c) = 0
        rw [map_sub, map_smul, Algebra.smul_def]; exact sub_eq_zero.mpr hw
      have ha'_ker : a' ∈ N_ker := by
        change Φ a' = 0
