    hLegConj Q_R x_Q U_Q q_W q_tilde hpb_q hv_q τ_Q.hom τ_UQ.hom hτ_UQ hτ_qW hUnit_Q σ_Q hγ_Q
  obtain ⟨E_Z, hIso_EZ, hConj_Z⟩ :=
    hLegConj Z_R x_Z U_Z e_W e_tilde hpb_e hv_e τ_Z.hom τ_UZ.hom hτ_UZ hτ_eW hUnit_Z σ_Z hγ_Z
  have : CategoryTheory.IsIso E_Q := hIso_EQ
  have : CategoryTheory.IsIso E_Z := hIso_EZ
  have hSec_Q_hom : secPull τ_Q.hom σ_Q γ_Q = 𝟙 (ℛ_Q.obj.obj (Opposite.op T_Q)) :=
    AddCommGrpCat.ext hSec_Q
  have hϕ_W_id : ϕ_W = 𝟙 (ℋ.obj.obj (Opposite.op T_κ)) := by
    rw [hSec_Q_hom, CategoryTheory.Category.id_comp] at hConj_Q
    have hConj_Q' : E_Q ≫ 𝟙 _ = E_Q ≫ ϕ_W :=
      (CategoryTheory.Category.comp_id E_Q).trans hConj_Q
    exact ((CategoryTheory.cancel_epi E_Q).mp hConj_Q').symm
  have hSec_Z_hom : secPull τ_Z.hom σ_Z γ_Z = 𝟙 (ℛ_Z.obj.obj (Opposite.op T_Z)) := by
    rw [hϕ_W_id, CategoryTheory.Category.comp_id] at hConj_Z
    have hConj_Z' : secPull τ_Z.hom σ_Z γ_Z ≫ E_Z = 𝟙 _ ≫ E_Z :=
      hConj_Z.trans (CategoryTheory.Category.id_comp E_Z).symm
    exact (CategoryTheory.cancel_mono E_Z).mp hConj_Z'
  exact congrArg (fun m : ℛ_Z.obj.obj (Opposite.op T_Z) ⟶ ℛ_Z.obj.obj (Opposite.op T_Z) =>
    AddCommGrpCat.Hom.hom m s) hSec_Z_hom

theorem weil_equiv_roof_open_edge_kernel_exact (sys : WeilEtaleSitePullbackSys.{u})
    (hBase : WeilSingDevAlgBCBaseProps.{u} sys)
    (X U : AlgebraicGeometry.Scheme.{u}) (u : U ⟶ X) (m₀ n : ℕ)
    (hIso_η :
      letI := (sys u).hCont
      letI := (sys u).hAdj
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
      let adj_u := (weilEtaleSitePullback u).sheafAdjunctionContinuous
        AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology
      CategoryTheory.IsIso
        ((adj_u.homEquiv (weilEtaleTorsionSheaf X m₀) (weilEtaleTorsionSheaf U m₀))
          (weilEtaleConstPullbackHom u
            (weilEtaleIdTerminalIsTerminal.{u} U)
            (weilEtaleIdTerminalIsTerminal.{u} X) AM)))
    (hZero : ∀ a : ℕ, 1 ≤ a → a ≤ n →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage u a (weilEtaleTorsionSheaf U m₀))) :
    let T_X := weilEtaleIdTerminal.{u} X
    ∀ (hT_U : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback u).obj T_X))
      (p_u : weilEtaleTorsionH X m₀ (n + 1) →+ weilEtaleTorsionH U m₀ (n + 1)),
      WeilIsTorsionEtalePullback u m₀ (n + 1) p_u →
      ∀ y : weilEtaleTorsionH U m₀ (n + 1),
        weilOuterTrFibEdgeHom u T_X hT_U (weilEtaleTorsionSheaf U m₀) (n + 1) y = 0 →
        ∃ ξ : weilEtaleTorsionH X m₀ (n + 1), p_u ξ = y :=
by
  
  have hSplitSES : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] {X₁ X₂ X₃ R₁ : 𝒜}
      (f : X₁ ⟶ X₂) [CategoryTheory.Mono f]
      (g : X₂ ⟶ X₃) (hfg : f ≫ g = 0)
      (hEx₁ : (CategoryTheory.ShortComplex.mk f g hfg).Exact)
      (δ : X₃ ⟶ R₁) [CategoryTheory.Epi δ] (hgδ : g ≫ δ = 0)
      (hEx₂ : (CategoryTheory.ShortComplex.mk g δ hgδ).Exact),
      ∃ (hfq : f ≫ CategoryTheory.Limits.factorThruImage g = 0)
        (hmδ : CategoryTheory.Limits.image.ι g ≫ δ = 0),
        (CategoryTheory.ShortComplex.mk f (CategoryTheory.Limits.factorThruImage g) hfq).ShortExact ∧
        (CategoryTheory.ShortComplex.mk (CategoryTheory.Limits.image.ι g) δ hmδ).ShortExact := by
    clear * -
    intro 𝒜 _ _ X₁ X₂ X₃ R₁ f _ g hfg hEx₁ δ _ hgδ hEx₂
    let q := CategoryTheory.Limits.factorThruImage g
    let m := CategoryTheory.Limits.image.ι g
    have hqm : q ≫ m = g := CategoryTheory.Limits.image.fac g
    have hfq : f ≫ q = 0 := by
      apply (cancel_mono m).mp
      rw [CategoryTheory.Category.assoc, hqm, hfg, CategoryTheory.Limits.zero_comp]
    have hmδ : m ≫ δ = 0 := by
      apply (cancel_epi q).mp
      rw [← CategoryTheory.Category.assoc, hqm, hgδ, CategoryTheory.Limits.comp_zero]
    have kf := hEx₁.fIsKernel
    let SC₁ := CategoryTheory.ShortComplex.mk f q hfq
    let lift₁ : ∀ s : CategoryTheory.Limits.Fork SC₁.g 0, s.pt ⟶ X₁ :=
      fun s => kf.lift (CategoryTheory.Limits.KernelFork.ofι s.ι (by
        change s.ι ≫ g = 0
        have hs : s.ι ≫ q = 0 := CategoryTheory.Limits.KernelFork.condition s
        rw [← hqm, ← CategoryTheory.Category.assoc, hs, CategoryTheory.Limits.zero_comp]))
    have hfac₁ : ∀ s : CategoryTheory.Limits.Fork SC₁.g 0, lift₁ s ≫ SC₁.f = s.ι :=
      fun s => kf.fac _ CategoryTheory.Limits.WalkingParallelPair.zero
    have hKer₁ : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι SC₁.f SC₁.zero) :=
      CategoryTheory.Limits.Fork.IsLimit.mk _ lift₁ hfac₁
        (fun s l hl => (cancel_mono f).mp (hl.trans (hfac₁ s).symm))
    have hSE₁ : SC₁.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_f_is_kernel SC₁ hKer₁) inferInstance inferInstance
    have cf := hEx₂.gIsCokernel
    let SC₂ := CategoryTheory.ShortComplex.mk m δ hmδ
    let desc₂ : ∀ s : CategoryTheory.Limits.Cofork SC₂.f 0, R₁ ⟶ s.pt :=
      fun s => cf.desc (CategoryTheory.Limits.CokernelCofork.ofπ s.π (by
        change g ≫ s.π = 0
        have hs : m ≫ s.π = 0 := CategoryTheory.Limits.CokernelCofork.condition s
        rw [← hqm, CategoryTheory.Category.assoc, hs, CategoryTheory.Limits.comp_zero]))
    have hfac₂ : ∀ s : CategoryTheory.Limits.Cofork SC₂.f 0, SC₂.g ≫ desc₂ s = s.π :=
      fun s => cf.fac _ CategoryTheory.Limits.WalkingParallelPair.one
    have hCoker₂ : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.CokernelCofork.ofπ SC₂.g SC₂.zero) :=
      CategoryTheory.Limits.Cofork.IsColimit.mk _ desc₂ hfac₂
        (fun s l hl => (cancel_epi δ).mp (hl.trans (hfac₂ s).symm))
    have hSE₂ : SC₂.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk'
        (CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC₂ hCoker₂) inferInstance inferInstance
    exact ⟨hfq, hmδ, hSE₁, hSE₂⟩

  have hConnSurj : ∀ {𝒜 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒜]
      [CategoryTheory.Abelian 𝒜] [CategoryTheory.HasExt.{u} 𝒜]
      (Z₀ : 𝒜) {S : CategoryTheory.ShortComplex 𝒜} (hS : S.ShortExact)
      [CategoryTheory.Injective S.X₂] (k : ℕ),
      Function.Surjective (hS.extClass.postcomp Z₀ (rfl : k + 1 = k + 1)) := by
    clear * -
    intro 𝒜 _ _ _ Z₀ S hS _ k z
    have hz : z.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
      CategoryTheory.Abelian.Ext.eq_zero_of_injective _
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z₀ hS z hz rfl

  
  intro T_X hT_U p_u hp_u y hy
  letI : (weilEtaleSitePullback u).IsContinuous X.smallEtaleTopology U.smallEtaleTopology :=
    (sys u).hCont
  letI : ((weilEtaleSitePullback u).sheafPushforwardContinuous
      AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology).IsRightAdjoint :=
    (sys u).hAdj
  letI : ((weilEtaleSitePullback u).sheafPullback
      AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology).Additive :=
    (sys u).hAdd_pb
  letI : ((weilEtaleSitePullback u).sheafPushforwardContinuous
      AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology).Additive :=
    (sys u).hAdd_pf
  letI : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback u).sheafPullback
        AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology) :=
    (sys u).hLim_pb
  letI : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback u).sheafPullback
        AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology) :=
    (sys u).hColim_pb
  let J_X := X.smallEtaleTopology
  let J_U := U.smallEtaleTopology
  let B_u := weilEtaleSitePullback u
  let pf_u := B_u.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_U
  let pb_u := B_u.sheafPullback AddCommGrpCat.{u} J_X J_U
  let adj_u := B_u.sheafAdjunctionContinuous AddCommGrpCat.{u} J_X J_U
  let Sh_X := CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
  let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
  let shAdj_X := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
  let Sh_U := CategoryTheory.presheafToSheaf J_U AddCommGrpCat.{u}
  let U_U := CategoryTheory.sheafToPresheaf J_U AddCommGrpCat.{u}
  let shAdj_U := CategoryTheory.sheafificationAdjunction J_U AddCommGrpCat.{u}
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_X := (CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_U := (CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}).obj Aℤ
  let hT_X := weilEtaleIdTerminalIsTerminal.{u} X
  let πℤ : pb_u.obj Fℤ_X ⟶ Fℤ_U := weilEtaleConstPullbackHom u hT_U hT_X Aℤ
  letI : CategoryTheory.IsIso πℤ := (sys u).hConstIso hT_U hT_X Aℤ
  let ιℤ : Fℤ_U ⟶ pb_u.obj Fℤ_X := CategoryTheory.inv πℤ
  have hι1 : ιℤ ≫ πℤ = CategoryTheory.CategoryStruct.id Fℤ_U :=
    CategoryTheory.IsIso.inv_hom_id πℤ
  have hι2 : πℤ ≫ ιℤ = CategoryTheory.CategoryStruct.id (pb_u.obj Fℤ_X) :=
    CategoryTheory.IsIso.hom_inv_id πℤ

  
  have hConstIndep : ∀ {T₁ T'₁ : U.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (hT'₁ : CategoryTheory.Limits.IsTerminal T'₁)
      {T₂ T'₂ : X.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (hT'₂ : CategoryTheory.Limits.IsTerminal T'₂)
      (A : AddCommGrpCat.{u}),
      weilEtaleConstPullbackHom u hT₁ hT₂ A = weilEtaleConstPullbackHom u hT'₁ hT'₂ A := by
    intro T₁ T'₁ hT₁ hT'₁ T₂ T'₂ hT₂ hT'₂ A
    let C₁ := CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J_X AddCommGrpCat.{u}
    let K₁ := (CategoryTheory.Functor.const (Opposite U.Etale)).obj A
    let K₂ := (CategoryTheory.Functor.const (Opposite X.Etale)).obj A
    let η₁ := shAdj_U.unit.app K₁
    let ν_u : K₂ ⟶ (pf_u.obj (C₁.obj A)).obj :=
      { app := fun W => η₁.app (Opposite.op (B_u.obj (Opposite.unop W)))
        naturality := fun {_ _} f => η₁.naturality (Opposite.op (B_u.map (Opposite.unop f))) }
    let u_canon : C₂.obj A ⟶ pf_u.obj (C₁.obj A) :=
      (shAdj_X.homEquiv K₂ (pf_u.obj (C₁.obj A))).symm ν_u
    have h_eq : ∀ {Ua : U.Etale} (hUa : CategoryTheory.Limits.IsTerminal Ua)
        {Ub : X.Etale} (hUb : CategoryTheory.Limits.IsTerminal Ub),
        weilEtaleConstPullbackHom u hUa hUb A =
          (adj_u.homEquiv (C₂.obj A) (C₁.obj A)).symm u_canon := by
      intro Ua hUa Ub hUb
      apply congrArg (adj_u.homEquiv (C₂.obj A) (C₁.obj A)).symm
      let adj₁ := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hUa
      let adj₂ := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hUb
      apply (adj₂.homEquiv A (pf_u.obj (C₁.obj A))).injective
      rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit]
      let τ : B_u.obj Ub ⟶ Ua := hUa.from (B_u.obj Ub)
      have h_unit₁ : adj₁.unit.app A = η₁.app (Opposite.op Ua) := Category.id_comp _
      have h_unit₂ : adj₂.unit.app A = (shAdj_X.unit.app K₂).app (Opposite.op Ub) :=
        Category.id_comp _
      have h_rhs : adj₂.unit.app A ≫
            ((CategoryTheory.sheafSections J_X AddCommGrpCat.{u}).obj (Opposite.op Ub)).map u_canon =
          ν_u.app (Opposite.op Ub) := by
        change adj₂.unit.app A ≫ u_canon.hom.app (Opposite.op Ub) = _
        rw [h_unit₂]
        exact congrArg (fun m => m.app (Opposite.op Ub))
          ((shAdj_X.homEquiv K₂ (pf_u.obj (C₁.obj A))).apply_symm_apply ν_u)
      rw [h_rhs, h_unit₁]
      exact (η₁.naturality τ.op).symm.trans (Category.id_comp _)
    exact (h_eq hT₁ hT₂).trans (h_eq hT'₁ hT'₂).symm

  let leray_u : ∀ (G : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) (q : ℕ),
      (pf_u.obj G).H q →+ G.H q :=
    fun G q =>
      ((CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app G)).postcomp Fℤ_U (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ).precomp (pb_u.obj (pf_u.obj G)) (Nat.zero_add q)).comp
          (pb_u.mapExtAddHom Fℤ_X (pf_u.obj G) q))
  have hleray_def : ∀ (G : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      (q : ℕ) (w : (pf_u.obj G).H q),
      leray_u G q w =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u w) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app G)) (Nat.add_zero q) :=
    fun _ _ _ => rfl

  have hConnEdge : ∀ (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf J_U AddCommGrpCat.{u}))
      (hSE : SC.ShortExact) (q : ℕ) (z : SC.X₃.H q),
      (((weilSingDevAlgBCConnHom u SC hSE q).hom.app (Opposite.op T_X)).hom)
        (weilOuterTrFibEdgeHom u T_X hT_U SC.X₃ q z) =
        weilOuterTrFibEdgeHom u T_X hT_U SC.X₁ (q + 1)
          (z.comp hSE.extClass (rfl : q + 1 = q + 1)) := by
    intro SC hSE q z
    let P₃ := B_u.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ q
    let P₁ := B_u.op ⋙ CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1)
    let δ_pre : CategoryTheory.Sheaf.cohomologyPresheaf SC.X₃ q ⟶
        CategoryTheory.Sheaf.cohomologyPresheaf SC.X₁ (q + 1) :=
      { app := fun W =>
          AddCommGrpCat.ofHom
            (hSE.extClass.postcomp (weilPolyP1CohomologyRepSheaf U (Opposite.unop W)) rfl)
        naturality := fun {W₁ W₂} u_mor =>
          AddCommGrpCat.ext fun x =>
            let φ_u : Quiver.Hom
                (weilPolyP1CohomologyRepSheaf U (Opposite.unop W₂))
                (weilPolyP1CohomologyRepSheaf U (Opposite.unop W₁)) :=
              (CategoryTheory.presheafToSheaf J_U AddCommGrpCat.{u}).map
                (CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map u_mor.unop)
                  AddCommGrpCat.free)
            CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ φ_u) x hSE.extClass
              (Nat.zero_add q) rfl (Nat.zero_add (q + 1)) }
    let δ_w : P₃ ⟶ P₁ := CategoryTheory.Functor.whiskerLeft B_u.op δ_pre
    have h_app := congrArg
      (fun η : P₃ ⟶ U_X.obj (Sh_X.obj P₁) => (η.app (Opposite.op T_X)).hom
        (weilPolyP1CohomologyTermToPresheaf U (B_u.obj T_X) hT_U SC.X₃ q z))
      (shAdj_X.unit.naturality δ_w).symm
    refine h_app.trans ?_
    exact congrArg ((shAdj_X.unit.app P₁).app (Opposite.op T_X)).hom
      (CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ (weilPolyP1CohomologyRepToConst U (B_u.obj T_X) hT_U))
        z hSE.extClass (Nat.zero_add q) rfl (Nat.zero_add (q + 1)))

  
  let adj_cX := CategoryTheory.constantSheafAdj J_X AddCommGrpCat.{u} hT_X
  let ev_X : ∀ (ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      ℱ.H 0 → ↑(ℱ.obj.obj (Opposite.op T_X)) :=
    fun ℱ w => ((adj_cX.homEquiv Aℤ ℱ (CategoryTheory.Abelian.Ext.addEquiv₀ w)).hom)
      (ULift.up (1 : ℤ))
  have hev_inj : ∀ (ℱ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}) (w : ℱ.H 0),
      ev_X ℱ w = 0 → w = 0 := by
    intro ℱ w hw
    let g : Aℤ ⟶ ℱ.obj.obj (Opposite.op T_X) :=
      adj_cX.homEquiv Aℤ ℱ (CategoryTheory.Abelian.Ext.addEquiv₀ w)
    have hg1 : g.hom (ULift.up (1 : ℤ)) = 0 := hw
    have hg_zero : g = 0 := by
      apply AddCommGrpCat.ext
      rintro ⟨z⟩
      change g.hom (ULift.up z) = 0
      induction z using Int.induction_on with
      | zero =>
        change g.hom 0 = 0
        exact map_zero g.hom
      | succ i ih =>
        change g.hom (ULift.up (i : ℤ) + ULift.up 1) = 0
        rw [map_add, ih, hg1, add_zero]
      | pred i ih =>
        change g.hom (ULift.up (- (i : ℤ)) - ULift.up 1) = 0
        rw [map_sub, ih, hg1, sub_zero]
    have h0_equiv : adj_cX.homEquiv Aℤ ℱ 0 = 0 := by
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      change adj_cX.unit.app Aℤ ≫ (0 : Fℤ_X ⟶ ℱ).hom.app (Opposite.op T_X) = 0
      exact CategoryTheory.Limits.comp_zero
    have h_ext0 : CategoryTheory.Abelian.Ext.addEquiv₀ w = 0 :=
      (adj_cX.homEquiv Aℤ ℱ).injective (hg_zero.trans h0_equiv.symm)
    exact CategoryTheory.Abelian.Ext.addEquiv₀.injective
      (h_ext0.trans (map_zero CategoryTheory.Abelian.Ext.addEquiv₀).symm)

  have hev_nat : ∀ {ℱ₁ ℱ₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}}
      (α : ℱ₁ ⟶ ℱ₂) (w : ℱ₁.H 0),
      ev_X ℱ₂ (w.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero 0)) =
        (α.hom.app (Opposite.op T_X)).hom (ev_X ℱ₁ w) := by
    intro ℱ₁ ℱ₂ α w
    let fw : Fℤ_X ⟶ ℱ₁ := CategoryTheory.Abelian.Ext.addEquiv₀ w
    have hw_eq : w = CategoryTheory.Abelian.Ext.mk₀ fw :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply w).symm
    have hcomp_eq : CategoryTheory.Abelian.Ext.addEquiv₀
        (w.comp (CategoryTheory.Abelian.Ext.mk₀ α) (Nat.add_zero 0)) = fw ≫ α := by
      rw [hw_eq, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
    dsimp [ev_X]
    rw [hcomp_eq, CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    rfl

  let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite U.Etale)
    (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
  let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite U.Etale)
    AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
  let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite U.Etale) AddCommGrpCat.adj
  let L_tot := Free_PSh ⋙ Sh_U
  let R_tot := U_U ⋙ Fgt_PSh
  let adj_tot : L_tot ⊣ R_tot := adj_free.comp shAdj_U
  let Z_fun : U.Etale ⥤ CategoryTheory.Sheaf J_U AddCommGrpCat.{u} := CategoryTheory.yoneda ⋙ L_tot
  let Z_obj : Opposite U.Etale → CategoryTheory.Sheaf J_U AddCommGrpCat.{u} :=
    fun W => Opposite.unop (Z_fun.op.obj W)
  let e_raw : ∀ (W : Opposite U.Etale) (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      CategoryTheory.Abelian.Ext (Z_obj W) F 0 ≃ ↑((U_U.obj F).obj W) :=
    fun W F =>
      CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
        ((adj_tot.homEquiv (CategoryTheory.yoneda.obj (Opposite.unop W)) F).trans
          CategoryTheory.yonedaEquiv)
  have he_add : ∀ (W : Opposite U.Etale) (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      (α₁ α₂ : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
      e_raw W F (α₁ + α₂) = e_raw W F α₁ + e_raw W F α₂ := by
    intro W F α₁ α₂
    let V := Opposite.unop W
    let u₁ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₁
    let u₂ : Z_obj W ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α₂
    have hu : CategoryTheory.Abelian.Ext.addEquiv₀ (α₁ + α₂) = u₁ + u₂ :=
      map_add CategoryTheory.Abelian.Ext.addEquiv₀ α₁ α₂
    let ψ : (Z_obj W ⟶ F) → (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_U.obj F) :=
      fun f => shAdj_U.homEquiv (Free_PSh.obj (CategoryTheory.yoneda.obj V)) F f
    have hψ : ψ (u₁ + u₂) = ψ u₁ + ψ u₂ := by
      dsimp [ψ]
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit]
      have hmap : U_U.map (u₁ + u₂) = U_U.map u₁ + U_U.map u₂ := rfl
      rw [hmap, CategoryTheory.Preadditive.comp_add]
    let eval_hom : (Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_U.obj F) →
        ↑((U_U.obj F).obj W) :=
      fun φ => CategoryTheory.yonedaEquiv
        (adj_free.homEquiv (CategoryTheory.yoneda.obj V) (U_U.obj F) φ)
    let g₀ := ((adj_free.unit.app (CategoryTheory.yoneda.obj V)).app W) (𝟙 V)
    have hyon : ∀ (φ : Free_PSh.obj (CategoryTheory.yoneda.obj V) ⟶ U_U.obj F),
        eval_hom φ = (φ.app W) g₀ := by
      intro φ
      dsimp [eval_hom]
      rw [CategoryTheory.yonedaEquiv_apply, CategoryTheory.Adjunction.homEquiv_unit]
      rfl
    have he_eq : ∀ (α : CategoryTheory.Abelian.Ext (Z_obj W) F 0),
        e_raw W F α = eval_hom (ψ (CategoryTheory.Abelian.Ext.addEquiv₀ α)) := by
      intro α
      dsimp [e_raw, eval_hom, ψ, adj_tot]
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      rfl
    rw [he_eq (α₁ + α₂), he_eq α₁, he_eq α₂, hu, hψ, hyon, hyon, hyon,
      CategoryTheory.NatTrans.app_add]
    rfl
  let e_add : ∀ (W : Opposite U.Etale) (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      ↑(((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F).obj W) ≃+
        ↑((U_U.obj F).obj W) :=
    fun W F => AddEquiv.mk' (e_raw W F) (he_add W F)
  let θ_comp : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) (W : Opposite U.Etale),
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F).obj W ≅
        (U_U.obj F).obj W :=
    fun F W =>
      { hom := AddCommGrpCat.ofHom (e_add W F).toAddMonoidHom
        inv := AddCommGrpCat.ofHom (e_add W F).symm.toAddMonoidHom
        hom_inv_id := by ext x; exact (e_add W F).symm_apply_apply x
        inv_hom_id := by ext y; exact (e_add W F).apply_symm_apply y }
  have hθ_mor : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      {W₁ W₂ : Opposite U.Etale} (ω : W₁ ⟶ W₂),
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F).map ω ≫
        (θ_comp F W₂).hom =
        (θ_comp F W₁).hom ≫ (U_U.obj F).map ω := by
    intro F W₁ W₂ ω
    have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).obj F).map ω =
        ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F := rfl
    rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F]
    ext α
    let f : Z_obj W₁ ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α
    have hα : α = CategoryTheory.Abelian.Ext.mk₀ f :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
    change e_raw W₂ F
        ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
      ((U_U.obj F).map ω) (e_raw W₁ F α)
    rw [hα]
    have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
    rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    dsimp [e_raw]
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
      CategoryTheory.Adjunction.homEquiv_naturality_left,
      ← CategoryTheory.yonedaEquiv_naturality',
      ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
    rfl
  have hθ_nat : ∀ {F₁ F₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}} (φ : F₁ ⟶ F₂)
      (W : Opposite U.Etale),
      (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).map φ).app W) ≫
        (θ_comp F₂ W).hom =
        (θ_comp F₁ W).hom ≫ (U_U.map φ).app W := by
    intro F₁ F₂ φ W
    ext α
    have hmap_φ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).map φ).app W =
        (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map φ := rfl
    let f : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
    have hα : α = CategoryTheory.Abelian.Ext.mk₀ f :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
    change e_raw W F₂ ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).map φ).app W) α) =
      ((U_U.map φ).app W) (e_raw W F₁ α)
    rw [hmap_φ_mor, CategoryTheory.Abelian.extFunctorObj_map, hα]
    have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
        (CategoryTheory.Abelian.Ext.mk₀ f) =
        CategoryTheory.Abelian.Ext.mk₀ (f ≫ φ) :=
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f φ
    change e_raw W F₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
        (CategoryTheory.Abelian.Ext.mk₀ f)) = _
    rw [hpost]
    dsimp [e_raw]
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
      CategoryTheory.Adjunction.homEquiv_naturality_right,
      CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
      ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
    rfl

  let θ₀ : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      (B_u.op ⋙ F.cohomologyPresheaf 0) ≅ U_X.obj (pf_u.obj F) :=
    fun F => CategoryTheory.NatIso.ofComponents
      (fun W => θ_comp F (Opposite.op (B_u.obj (Opposite.unop W))))
      (fun ω => hθ_mor F (B_u.op.map ω))
  let ε₀ : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      weilEtaleHigherDirectImage u 0 F ≅ pf_u.obj F :=
    fun F => Sh_X.mapIso (θ₀ F) ≪≫ CategoryTheory.asIso (shAdj_X.counit.app (pf_u.obj F))

  have hε₀_nat : ∀ {F₁ F₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}} (φ : F₁ ⟶ F₂),
      weilEtaleHigherDirectImageMap u 0 φ ≫ (ε₀ F₂).hom = (ε₀ F₁).hom ≫ pf_u.map φ := by
    intro F₁ F₂ φ
    change Sh_X.map (CategoryTheory.Functor.whiskerLeft B_u.op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).map φ)) ≫
      (Sh_X.map (θ₀ F₂).hom ≫ shAdj_X.counit.app (pf_u.obj F₂)) =
      (Sh_X.map (θ₀ F₁).hom ≫ shAdj_X.counit.app (pf_u.obj F₁)) ≫ pf_u.map φ
    rw [← CategoryTheory.Category.assoc, ← Sh_X.map_comp]
    have hwh : CategoryTheory.Functor.whiskerLeft B_u.op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_U 0).map φ) ≫ (θ₀ F₂).hom =
        (θ₀ F₁).hom ≫ U_X.map (pf_u.map φ) := by
      ext W α
      exact congrArg (fun m => m.hom α) (hθ_nat φ (Opposite.op (B_u.obj (Opposite.unop W))))
    have hnat_c : Sh_X.map (U_X.map (pf_u.map φ)) ≫ shAdj_X.counit.app (pf_u.obj F₂) =
        shAdj_X.counit.app (pf_u.obj F₁) ≫ pf_u.map φ :=
      shAdj_X.counit.naturality (pf_u.map φ)
    rw [hwh, Sh_X.map_comp, CategoryTheory.Category.assoc, hnat_c, ← CategoryTheory.Category.assoc]

  have hε₀_ev : ∀ (F : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) (q₀ : F.H 0),
      let q_tilde : (pf_u.obj F).H 0 := CategoryTheory.Abelian.Ext.mk₀
        ((adj_u.homEquiv Fℤ_X F) (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ q₀))
      ev_X (pf_u.obj F) q_tilde =
        (((ε₀ F).hom.hom.app (Opposite.op T_X)).hom)
          (weilOuterTrFibEdgeHom u T_X hT_U F 0 q₀) := by
    intro F q₀ q_tilde
    let P₀ := B_u.op ⋙ F.cohomologyPresheaf 0
    let g_ε : (CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}).obj P₀ ⟶ pf_u.obj F :=
      (ε₀ F).hom
    have hε_unit : shAdj_X.unit.app P₀ ≫ U_X.map (ε₀ F).hom = (θ₀ F).hom := by
      have hu : ((CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).homEquiv
            P₀ (pf_u.obj F)) g_ε =
          (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).unit.app P₀ ≫
            (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}).map g_ε := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
      have hε_symm : g_ε =
          ((CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).homEquiv
            P₀ (pf_u.obj F)).symm (θ₀ F).hom := by
        rw [CategoryTheory.Adjunction.homEquiv_counit]
        rfl
      have h_eq : (CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}).unit.app P₀ ≫
            (CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}).map g_ε = (θ₀ F).hom := by
        rw [← hu, hε_symm, Equiv.apply_symm_apply]
      exact h_eq
    let T_top : U.Etale := B_u.obj T_X
    let s_q₀ := weilPolyP1CohomologyTermToPresheaf U T_top hT_U F 0 q₀
    have h_rhs1 : (((ε₀ F).hom.hom.app (Opposite.op T_X)).hom)
        (weilOuterTrFibEdgeHom u T_X hT_U F 0 q₀) =
        ((θ₀ F).hom.app (Opposite.op T_X)).hom s_q₀ :=
      congrArg (fun m : P₀ ⟶ U_X.obj (pf_u.obj F) => (m.app (Opposite.op T_X)).hom s_q₀)
        hε_unit
    have he_raw_eq : ∀ (V : U.Etale) (G : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
        (f : weilPolyP1CohomologyRepSheaf U V ⟶ G),
        e_raw (Opposite.op V) G (CategoryTheory.Abelian.Ext.mk₀ f) =
          weilPolyP1CohomologyRepHomEquiv U V G f := by
      intro V G f
      dsimp [e_raw, weilPolyP1CohomologyRepHomEquiv, adj_tot]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.comp_homEquiv]
      rfl
    have hRepNat : ∀ (V : U.Etale) {G₁ G₂ : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}}
        (f : weilPolyP1CohomologyRepSheaf U V ⟶ G₁) (φ : G₁ ⟶ G₂),
        weilPolyP1CohomologyRepHomEquiv U V G₂ (f ≫ φ) =
          (φ.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv U V G₁ f) := by
      intro V G₁ G₂ f φ
      dsimp [weilPolyP1CohomologyRepHomEquiv]
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply]
      rfl
    let u_q₀ := CategoryTheory.Abelian.Ext.addEquiv₀ q₀
    let r_U := weilPolyP1CohomologyRepToConst U T_top hT_U
    have hs_q₀ : s_q₀ = CategoryTheory.Abelian.Ext.mk₀ (r_U ≫ u_q₀) := by
      change (CategoryTheory.Abelian.Ext.mk₀ r_U).comp q₀ (Nat.zero_add 0) = _
      have hq₀ : q₀ = CategoryTheory.Abelian.Ext.mk₀ u_q₀ :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply q₀).symm
      rw [hq₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    let adj_cU := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT_U
    have hr_U : weilPolyP1CohomologyRepHomEquiv U T_top Fℤ_U r_U =
        (adj_cU.unit.app Aℤ).hom (ULift.up (1 : ℤ)) :=
      (weilPolyP1CohomologyRepHomEquiv U T_top Fℤ_U).apply_symm_apply _
    have h_rhs2 : ((θ₀ F).hom.app (Opposite.op T_X)).hom s_q₀ =
        (u_q₀.hom.app (Opposite.op T_top)).hom
          ((adj_cU.unit.app Aℤ).hom (ULift.up (1 : ℤ))) := by
      change e_raw (Opposite.op T_top) F s_q₀ = _
      rw [hs_q₀, he_raw_eq, hRepNat, hr_U]
    have hq_tilde_ext : CategoryTheory.Abelian.Ext.addEquiv₀ q_tilde =
        (adj_u.homEquiv Fℤ_X F) (πℤ ≫ u_q₀) := by
      dsimp [q_tilde, u_q₀]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
    have hπℤ_adj : (adj_u.homEquiv Fℤ_X Fℤ_U) πℤ =
        (adj_cX.homEquiv Aℤ (pf_u.obj Fℤ_U)).symm (adj_cU.unit.app Aℤ) := by
      have h_inner : CategoryTheory.CategoryStruct.comp (adj_cU.unit.app Aℤ)
            (Fℤ_U.obj.map (hT_U.from (B_u.obj T_X)).op) =
          adj_cU.unit.app Aℤ := by
        have hτ_id : hT_U.from (B_u.obj T_X) = 𝟙 T_top := hT_U.hom_ext _ _
        rw [hτ_id, op_id, CategoryTheory.Functor.map_id]
        exact CategoryTheory.Category.comp_id _
      have h_symm : (adj_u.homEquiv Fℤ_X Fℤ_U) πℤ =
          (adj_cX.homEquiv Aℤ (pf_u.obj Fℤ_U)).symm
            (CategoryTheory.CategoryStruct.comp (adj_cU.unit.app Aℤ)
              (Fℤ_U.obj.map (hT_U.from (B_u.obj T_X)).op)) :=
        Equiv.apply_symm_apply _ _
      exact h_symm.trans (congrArg (adj_cX.homEquiv Aℤ (pf_u.obj Fℤ_U)).symm h_inner)
    have hcancel_cX : (adj_cX.homEquiv Aℤ (pf_u.obj Fℤ_U))
        ((adj_cX.homEquiv Aℤ (pf_u.obj Fℤ_U)).symm (adj_cU.unit.app Aℤ)) =
        adj_cU.unit.app Aℤ :=
      Equiv.apply_symm_apply _ _
    have h_lhs : ev_X (pf_u.obj F) q_tilde =
        (u_q₀.hom.app (Opposite.op T_top)).hom
          ((adj_cU.unit.app Aℤ).hom (ULift.up (1 : ℤ))) := by
      dsimp [ev_X]
      rw [hq_tilde_ext, CategoryTheory.Adjunction.homEquiv_naturality_right, hπℤ_adj,
        CategoryTheory.Adjunction.homEquiv_naturality_right, hcancel_cX]
      rfl
    rw [h_lhs, h_rhs1, h_rhs2]

  
  have hInjAcyc : ∀ (J_sh : CategoryTheory.Sheaf J_U AddCommGrpCat.{u})
      [CategoryTheory.Injective J_sh] (p : ℕ), 1 ≤ p →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u p J_sh) := by
    intro J_sh _ p hp
    obtain ⟨m, rfl⟩ : ∃ m : ℕ, p = m + 1 := ⟨p - 1, (Nat.sub_add_cancel hp).symm⟩
    let Q_pre := CategoryTheory.Functor.comp B_u.op
      (CategoryTheory.Sheaf.cohomologyPresheaf J_sh (m + 1))
    have hQ_zero : CategoryTheory.Limits.IsZero Q_pre := by
      rw [CategoryTheory.Functor.isZero_iff]
      intro W
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply AddCommGrpCat.ext
      intro α
      change α = 0
      exact CategoryTheory.Abelian.Ext.eq_zero_of_injective α
    have _ : Sh_X.IsLeftAdjoint := shAdj_X.isLeftAdjoint
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts Sh_X :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts Sh_X
    have _ : Sh_X.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts Sh_X
    exact Sh_X.map_isZero hQ_zero

  have hExact_pf_δ₀ : ∀ (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf J_U AddCommGrpCat.{u}))
      (hSE : SC.ShortExact),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u 1 SC.X₂) →
      let δ_tilde₀ : pf_u.obj SC.X₃ ⟶ weilEtaleHigherDirectImage u 1 SC.X₁ :=
        (ε₀ SC.X₃).inv ≫ weilSingDevAlgBCConnHom u SC hSE 0
      ∃ (hcomp : pf_u.map SC.g ≫ δ_tilde₀ = 0),
        CategoryTheory.Epi δ_tilde₀ ∧
        (CategoryTheory.ShortComplex.mk (pf_u.map SC.g) δ_tilde₀ hcomp).Exact := by
    intro SC hSE hZ1_X2 δ_tilde₀
    let δ₀ := weilSingDevAlgBCConnHom u SC hSE 0
    obtain ⟨_, h₂_0, h₃_0, _, hEx₂_0, hEx₃_0⟩ := (hBase.2.2.2 u SC hSE).2 0
    have hι1_zero : weilEtaleHigherDirectImageMap u 1 SC.f = 0 := hZ1_X2.eq_of_tgt _ 0
    haveI : CategoryTheory.Epi δ₀ := hEx₃_0.epi_f hι1_zero
    have hEpi_δ_tilde : CategoryTheory.Epi δ_tilde₀ := CategoryTheory.epi_comp (ε₀ SC.X₃).inv δ₀
    have hcomp_δ_tilde : pf_u.map SC.g ≫ δ_tilde₀ = 0 := by
      apply (cancel_epi (ε₀ SC.X₂).hom).mp
      rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc,
        ← hε₀_nat SC.g]
      change (weilEtaleHigherDirectImageMap u 0 SC.g ≫ (ε₀ SC.X₃).hom) ≫
        ((ε₀ SC.X₃).inv ≫ δ₀) = 0
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (ε₀ SC.X₃).hom (ε₀ SC.X₃).inv δ₀,
        (ε₀ SC.X₃).hom_inv_id, CategoryTheory.Category.id_comp, h₂_0]
    let e_SC0 : CategoryTheory.ShortComplex.mk
          (weilEtaleHigherDirectImageMap u 0 SC.g) δ₀ h₂_0 ≅
        CategoryTheory.ShortComplex.mk (pf_u.map SC.g) δ_tilde₀ hcomp_δ_tilde :=
      CategoryTheory.ShortComplex.isoMk
        (ε₀ SC.X₂) (ε₀ SC.X₃) (CategoryTheory.Iso.refl _)
        (hε₀_nat SC.g).symm
        (by
          dsimp [δ_tilde₀]
          rw [← CategoryTheory.Category.assoc, (ε₀ SC.X₃).hom_inv_id,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    exact ⟨hcomp_δ_tilde, hEpi_δ_tilde, (CategoryTheory.ShortComplex.exact_iff_of_iso e_SC0).mp hEx₂_0⟩

  
  have hGen : ∀ (k_steps : ℕ)
      (G : CategoryTheory.Sheaf J_U AddCommGrpCat.{u}),
      (∀ a : ℕ, 1 ≤ a → a ≤ k_steps →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u a G)) →
      ∀ z : G.H (k_steps + 1),
        weilOuterTrFibEdgeHom u T_X hT_U G (k_steps + 1) z = 0 →
        ∃ w : (pf_u.obj G).H (k_steps + 1),
          leray_u G (k_steps + 1) w = z := by
    intro k_steps
    induction k_steps with
    | zero =>
      
      intro G _ z hz
      let I := CategoryTheory.Injective.under G
      let ι_G := CategoryTheory.Injective.ι G
      let Q := CategoryTheory.Limits.cokernel ι_G
      let π_G := CategoryTheory.Limits.cokernel.π ι_G
      let SC_U := CategoryTheory.ShortComplex.mk ι_G π_G (CategoryTheory.Limits.cokernel.condition ι_G)
      have hSE_U : SC_U.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι_G) inferInstance inferInstance
      have _ : CategoryTheory.Injective SC_U.X₂ := CategoryTheory.Injective.injective_under G
      obtain ⟨q₀_raw, hq₀⟩ := hConnSurj Fℤ_U hSE_U 0 z
      let q₀ : Q.H 0 := q₀_raw
      have hq₀_comp : q₀.comp hSE_U.extClass (rfl : 0 + 1 = 1) = z := hq₀
      let δ₀ := weilSingDevAlgBCConnHom u SC_U hSE_U 0
      have hδ₀_edge : ((δ₀.hom.app (Opposite.op T_X)).hom)
          (weilOuterTrFibEdgeHom u T_X hT_U Q 0 q₀) = 0 := by
        rw [hConnEdge SC_U hSE_U 0 q₀, hq₀_comp, hz]
      let δ_tilde₀ : pf_u.obj Q ⟶ weilEtaleHigherDirectImage u 1 G := (ε₀ Q).inv ≫ δ₀
      let q_tilde : (pf_u.obj Q).H 0 := CategoryTheory.Abelian.Ext.mk₀
