                      rw [hinv, one_pow, mul_one]
              _ = ((z₁ - z₂) * (algebraMap ↥B₂_0 (Localization.Away f_B₂) f_B₂) ^ n) *
                    (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) ^ n := by
                      rw [mul_pow, mul_assoc]
