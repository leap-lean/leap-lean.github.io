        change (φ_K₀ 0) (MvPolynomial.C a) = algebraMap R₂ K₀ (MvPolynomial.C a)
        rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply k R₂ K₀, MvPolynomial.algebraMap_eq]
      · intro j
        fin_cases j
        · change (φ_K₀ 0) (MvPolynomial.X 0) = x₁'
          dsimp [φ_K₀]; rw [MvPolynomial.aeval_X]
          exact div_one x₁'
        · change (φ_K₀ 0) (MvPolynomial.X 1) = x₂'
          dsimp [φ_K₀]; rw [MvPolynomial.aeval_X]
          exact div_one x₂'
    let alg0 : Algebra R₂ K₀ := inferInstance
    have hFrac0 : @IsFractionRing R₂ _ K₀ _ alg0 := inferInstance
    have hTransFrac : ∀ (φ : R₂ →+* K₀) (α : K₀ ≃+* K₀),
        α.toRingHom.comp (algebraMap R₂ K₀) = φ →
        @IsFractionRing R₂ _ K₀ _ φ.toAlgebra := by
      intro φ α hα
      let _ : Algebra R₂ K₀ := φ.toAlgebra
      refine
        { map_units := fun y => by
            have hy_unit : IsUnit (@algebraMap R₂ K₀ _ _ alg0 y.1) :=
              @IsLocalization.map_units R₂ _ (nonZeroDivisors R₂) K₀ _ alg0 hFrac0 y
            change IsUnit (φ y.1)
            rw [← hα]
            exact hy_unit.map α.toRingHom
          surj := fun z => by
            obtain ⟨⟨r, s⟩, hrs⟩ :=
              @IsLocalization.surj R₂ _ (nonZeroDivisors R₂) K₀ _ alg0 hFrac0 (α.symm z)
            refine ⟨⟨r, s⟩, ?_⟩
            have hm := congrArg α hrs
            rw [map_mul, α.apply_symm_apply] at hm
            change z * φ s.1 = φ r
            rw [← hα]
            exact hm
          exists_of_eq := fun {r₁ r₂} h_eq => by
            change φ r₁ = φ r₂ at h_eq
            rw [← hα, RingHom.comp_apply, RingHom.comp_apply] at h_eq
            have h1 := α.injective h_eq
            have h2 := (@IsFractionRing.injective R₂ _ K₀ _ alg0 hFrac0) h1
            exact ⟨1, by rw [OneMemClass.coe_one, one_mul, one_mul, h2]⟩ }
    let m₀₁ : R₂ := MvPolynomial.X 0 * MvPolynomial.X 1
    have hm₀₁_ne : m₀₁ ≠ 0 := mul_ne_zero (MvPolynomial.X_ne_zero 0) (MvPolynomial.X_ne_zero 1)
    let L₀₁ := Localization.Away m₀₁
    let ι_L : R₂ →+* L₀₁ := algebraMap R₂ L₀₁
    have hX0_unit_L : IsUnit (ι_L (MvPolynomial.X 0)) := by
      have hmul : IsUnit (ι_L m₀₁) := IsLocalization.Away.algebraMap_isUnit m₀₁
      rw [map_mul] at hmul
      exact isUnit_of_mul_isUnit_left hmul
    have hX1_unit_L : IsUnit (ι_L (MvPolynomial.X 1)) := by
      have hmul : IsUnit (ι_L m₀₁) := IsLocalization.Away.algebraMap_isUnit m₀₁
      rw [map_mul] at hmul
      exact isUnit_of_mul_isUnit_right hmul
    obtain ⟨u₀, hu₀⟩ := hX0_unit_L
    obtain ⟨u₁, hu₁⟩ := hX1_unit_L
    have hm₀₁_unit_K : IsUnit (algebraMap R₂ K₀ m₀₁) := by
      dsimp [m₀₁]; rw [map_mul]
      exact (IsUnit.mk0 x₁' hx₁_ne).mul (IsUnit.mk0 x₂' hx₂_ne)
    let j_LK : L₀₁ →+* K₀ := IsLocalization.Away.lift m₀₁ hm₀₁_unit_K
    have hj_LK_eq : ∀ r : R₂, j_LK (ι_L r) = algebraMap R₂ K₀ r :=
      fun r => IsLocalization.Away.lift_eq m₀₁ hm₀₁_unit_K r
    have hj_u0_inv : j_LK ↑(u₀⁻¹) = x₁'⁻¹ := by
      apply mul_left_cancel₀ hx₁_ne
      rw [mul_inv_cancel₀ hx₁_ne]
      calc x₁' * j_LK ↑(u₀⁻¹)
          = j_LK (ι_L (MvPolynomial.X 0)) * j_LK ↑(u₀⁻¹) := by rw [hj_LK_eq]
        _ = j_LK (↑u₀ * ↑(u₀⁻¹)) := by rw [← hu₀, ← map_mul]
        _ = 1 := by rw [Units.mul_inv, map_one]
    have hj_u1_inv : j_LK ↑(u₁⁻¹) = x₂'⁻¹ := by
      apply mul_left_cancel₀ hx₂_ne
      rw [mul_inv_cancel₀ hx₂_ne]
      calc x₂' * j_LK ↑(u₁⁻¹)
          = j_LK (ι_L (MvPolynomial.X 1)) * j_LK ↑(u₁⁻¹) := by rw [hj_LK_eq]
        _ = j_LK (↑u₁ * ↑(u₁⁻¹)) := by rw [← hu₁, ← map_mul]
        _ = 1 := by rw [Units.mul_inv, map_one]
    let ρ₁_R : R₂ →+* L₀₁ :=
      MvPolynomial.eval₂Hom (ι_L.comp MvPolynomial.C) ![↑(u₀⁻¹), ↑(u₁ * u₀⁻¹)]
    have hρ₁_X0 : ρ₁_R (MvPolynomial.X 0) = ↑(u₀⁻¹) := by
      dsimp [ρ₁_R]; rw [MvPolynomial.eval₂Hom_X']; rfl
    have hρ₁_X1 : ρ₁_R (MvPolynomial.X 1) = ↑(u₁ * u₀⁻¹) := by
      dsimp [ρ₁_R]; rw [MvPolynomial.eval₂Hom_X']; rfl
    have hρ₁_m : IsUnit (ρ₁_R m₀₁) := by
      dsimp [m₀₁]; rw [map_mul, hρ₁_X0, hρ₁_X1]
      exact (u₀⁻¹).isUnit.mul (u₁ * u₀⁻¹).isUnit
    let ρ₁_L : L₀₁ →+* L₀₁ := IsLocalization.Away.lift m₀₁ hρ₁_m
    have hρ₁_L_inv : ρ₁_L.comp ρ₁_L = RingHom.id L₀₁ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers m₀₁)
      apply MvPolynomial.ringHom_ext
      · intro c₀
        change ρ₁_L (ρ₁_L (ι_L (MvPolynomial.C c₀))) = ι_L (MvPolynomial.C c₀)
        rw [IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
          IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        have h_u0_fwd : ρ₁_L ↑u₀ = ↑(u₀⁻¹) := by
          rw [hu₀, IsLocalization.Away.lift_eq, hρ₁_X0]
        have h_u0 : ρ₁_L ↑(u₀⁻¹) = ↑u₀ := by
          have h1 : ρ₁_L ↑u₀ * ρ₁_L ↑(u₀⁻¹) = 1 := by rw [← map_mul, Units.mul_inv, map_one]
          rw [h_u0_fwd] at h1
          calc ρ₁_L ↑(u₀⁻¹) = ↑u₀ * (↑(u₀⁻¹) * ρ₁_L ↑(u₀⁻¹)) := by
                rw [← mul_assoc, Units.mul_inv, one_mul]
            _ = ↑u₀ := by rw [h1, mul_one]
        have h_u1 : ρ₁_L ↑u₁ = ↑(u₁ * u₀⁻¹) := by
          rw [hu₁, IsLocalization.Away.lift_eq, hρ₁_X1]
        fin_cases j
        · change ρ₁_L (ρ₁_L (ι_L (MvPolynomial.X 0))) = ι_L (MvPolynomial.X 0)
          rw [IsLocalization.Away.lift_eq, hρ₁_X0, h_u0, hu₀]
        · change ρ₁_L (ρ₁_L (ι_L (MvPolynomial.X 1))) = ι_L (MvPolynomial.X 1)
          rw [IsLocalization.Away.lift_eq, hρ₁_X1, Units.val_mul, map_mul, h_u1, h_u0,
            Units.val_mul, mul_assoc, Units.inv_mul, mul_one, hu₁]
    let ρ₂_R : R₂ →+* L₀₁ :=
      MvPolynomial.eval₂Hom (ι_L.comp MvPolynomial.C) ![↑(u₁⁻¹), ↑(u₀ * u₁⁻¹)]
    let σ₂_R : R₂ →+* L₀₁ :=
      MvPolynomial.eval₂Hom (ι_L.comp MvPolynomial.C) ![↑(u₁ * u₀⁻¹), ↑(u₀⁻¹)]
    have hρ₂_X0 : ρ₂_R (MvPolynomial.X 0) = ↑(u₁⁻¹) := by
      dsimp [ρ₂_R]; rw [MvPolynomial.eval₂Hom_X']; rfl
    have hρ₂_X1 : ρ₂_R (MvPolynomial.X 1) = ↑(u₀ * u₁⁻¹) := by
      dsimp [ρ₂_R]; rw [MvPolynomial.eval₂Hom_X']; rfl
    have hσ₂_X0 : σ₂_R (MvPolynomial.X 0) = ↑(u₁ * u₀⁻¹) := by
      dsimp [σ₂_R]; rw [MvPolynomial.eval₂Hom_X']; rfl
    have hσ₂_X1 : σ₂_R (MvPolynomial.X 1) = ↑(u₀⁻¹) := by
      dsimp [σ₂_R]; rw [MvPolynomial.eval₂Hom_X']; rfl
    have hρ₂_m : IsUnit (ρ₂_R m₀₁) := by
      dsimp [m₀₁]; rw [map_mul, hρ₂_X0, hρ₂_X1]
      exact (u₁⁻¹).isUnit.mul (u₀ * u₁⁻¹).isUnit
    have hσ₂_m : IsUnit (σ₂_R m₀₁) := by
      dsimp [m₀₁]; rw [map_mul, hσ₂_X0, hσ₂_X1]
      exact (u₁ * u₀⁻¹).isUnit.mul (u₀⁻¹).isUnit
    let ρ₂_L : L₀₁ →+* L₀₁ := IsLocalization.Away.lift m₀₁ hρ₂_m
    let σ₂_L : L₀₁ →+* L₀₁ := IsLocalization.Away.lift m₀₁ hσ₂_m
    have hσρ₂ : σ₂_L.comp ρ₂_L = RingHom.id L₀₁ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers m₀₁)
      apply MvPolynomial.ringHom_ext
      · intro c₀
        change σ₂_L (ρ₂_L (ι_L (MvPolynomial.C c₀))) = ι_L (MvPolynomial.C c₀)
        rw [IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
          IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        have h_u0 : σ₂_L ↑u₀ = ↑(u₁ * u₀⁻¹) := by
          rw [hu₀, IsLocalization.Away.lift_eq, hσ₂_X0]
        have h_u1 : σ₂_L ↑u₁ = ↑(u₀⁻¹) := by
          rw [hu₁, IsLocalization.Away.lift_eq, hσ₂_X1]
        have h_u1_inv : σ₂_L ↑(u₁⁻¹) = ↑u₀ := by
          have h1 : σ₂_L ↑u₁ * σ₂_L ↑(u₁⁻¹) = 1 := by rw [← map_mul, Units.mul_inv, map_one]
          rw [h_u1] at h1
          calc σ₂_L ↑(u₁⁻¹) = ↑u₀ * (↑(u₀⁻¹) * σ₂_L ↑(u₁⁻¹)) := by
                rw [← mul_assoc, Units.mul_inv, one_mul]
            _ = ↑u₀ := by rw [h1, mul_one]
        fin_cases j
        · change σ₂_L (ρ₂_L (ι_L (MvPolynomial.X 0))) = ι_L (MvPolynomial.X 0)
          rw [IsLocalization.Away.lift_eq, hρ₂_X0, h_u1_inv, hu₀]
        · change σ₂_L (ρ₂_L (ι_L (MvPolynomial.X 1))) = ι_L (MvPolynomial.X 1)
          rw [IsLocalization.Away.lift_eq, hρ₂_X1, Units.val_mul, map_mul, h_u0, h_u1_inv,
            Units.val_mul, mul_assoc, Units.inv_mul, mul_one, hu₁]
    have hρσ₂ : ρ₂_L.comp σ₂_L = RingHom.id L₀₁ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers m₀₁)
      apply MvPolynomial.ringHom_ext
      · intro c₀
        change ρ₂_L (σ₂_L (ι_L (MvPolynomial.C c₀))) = ι_L (MvPolynomial.C c₀)
        rw [IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
          IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      · intro j
        have h_u0 : ρ₂_L ↑u₀ = ↑(u₁⁻¹) := by
          rw [hu₀, IsLocalization.Away.lift_eq, hρ₂_X0]
        have h_u1 : ρ₂_L ↑u₁ = ↑(u₀ * u₁⁻¹) := by
          rw [hu₁, IsLocalization.Away.lift_eq, hρ₂_X1]
        have h_u0_inv : ρ₂_L ↑(u₀⁻¹) = ↑u₁ := by
          have h1 : ρ₂_L ↑u₀ * ρ₂_L ↑(u₀⁻¹) = 1 := by rw [← map_mul, Units.mul_inv, map_one]
          rw [h_u0] at h1
          calc ρ₂_L ↑(u₀⁻¹) = ↑u₁ * (↑(u₁⁻¹) * ρ₂_L ↑(u₀⁻¹)) := by
                rw [← mul_assoc, Units.mul_inv, one_mul]
            _ = ↑u₁ := by rw [h1, mul_one]
        fin_cases j
        · change ρ₂_L (σ₂_L (ι_L (MvPolynomial.X 0))) = ι_L (MvPolynomial.X 0)
          rw [IsLocalization.Away.lift_eq, hσ₂_X0, Units.val_mul, map_mul, h_u1, h_u0_inv,
            Units.val_mul, mul_assoc, Units.inv_mul, mul_one, hu₀]
        · change ρ₂_L (σ₂_L (ι_L (MvPolynomial.X 1))) = ι_L (MvPolynomial.X 1)
          rw [IsLocalization.Away.lift_eq, hσ₂_X1, h_u0_inv, hu₁]
    have hj_LK_inj : Function.Injective j_LK := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨n, r, hrn⟩ := IsLocalization.Away.surj m₀₁ z
      have hmr : j_LK (z * ι_L m₀₁ ^ n) = 0 := by rw [map_mul, hz, zero_mul]
      rw [hrn, hj_LK_eq] at hmr
      have hr0 : r = 0 := (IsFractionRing.injective R₂ K₀) (hmr.trans (map_zero _).symm)
      have hunit : IsUnit (ι_L m₀₁ ^ n) := (IsLocalization.Away.algebraMap_isUnit m₀₁).pow n
      obtain ⟨u_m, hu_m⟩ := hunit
      calc z = (z * ↑u_m) * ↑(u_m⁻¹) := by rw [mul_assoc, Units.mul_inv, mul_one]
        _ = ι_L r * ↑(u_m⁻¹) := by rw [hu_m, hrn]
        _ = 0 := by rw [hr0, map_zero, zero_mul]
    have hLiftEquiv : ∀ e_L : L₀₁ ≃+* L₀₁,
        ∃ α : K₀ ≃+* K₀, α.toRingHom.comp (algebraMap R₂ K₀) =
          j_LK.comp (e_L.toRingHom.comp ι_L) := by
      intro e_L
      let f_fwd : R₂ →+* K₀ := j_LK.comp (e_L.toRingHom.comp ι_L)
      let f_bwd : R₂ →+* K₀ := j_LK.comp (e_L.symm.toRingHom.comp ι_L)
      have hfwd_inj : Function.Injective f_fwd :=
        hj_LK_inj.comp (e_L.injective.comp
          (IsLocalization.injective L₀₁
            (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hm₀₁_ne))))
      have hbwd_inj : Function.Injective f_bwd :=
        hj_LK_inj.comp (e_L.symm.injective.comp
          (IsLocalization.injective L₀₁
            (Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hm₀₁_ne))))
      have hfwd_units : ∀ y : nonZeroDivisors R₂, IsUnit (f_fwd y) := fun y =>
        IsUnit.mk0 _ ((map_ne_zero_iff f_fwd hfwd_inj).mpr (mem_nonZeroDivisors_iff_ne_zero.mp y.2))
      have hbwd_units : ∀ y : nonZeroDivisors R₂, IsUnit (f_bwd y) := fun y =>
        IsUnit.mk0 _ ((map_ne_zero_iff f_bwd hbwd_inj).mpr (mem_nonZeroDivisors_iff_ne_zero.mp y.2))
      obtain ⟨α_fwd, hα_fwd_eq⟩ : ∃ α_fwd : K₀ →+* K₀,
          ∀ r : R₂, α_fwd (algebraMap R₂ K₀ r) = f_fwd r :=
        ⟨IsLocalization.lift hfwd_units, IsLocalization.lift_eq hfwd_units⟩
      obtain ⟨α_bwd, hα_bwd_eq⟩ : ∃ α_bwd : K₀ →+* K₀,
          ∀ r : R₂, α_bwd (algebraMap R₂ K₀ r) = f_bwd r :=
        ⟨IsLocalization.lift hbwd_units, IsLocalization.lift_eq hbwd_units⟩
      have h_fwd_L : α_fwd.comp j_LK = j_LK.comp e_L.toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers m₀₁)
        apply RingHom.ext; intro r
        change α_fwd (j_LK (ι_L r)) = f_fwd r
        rw [hj_LK_eq, hα_fwd_eq]
      have h_bwd_L : α_bwd.comp j_LK = j_LK.comp e_L.symm.toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers m₀₁)
        apply RingHom.ext; intro r
        change α_bwd (j_LK (ι_L r)) = f_bwd r
        rw [hj_LK_eq, hα_bwd_eq]
      have h_comp1 : α_bwd.comp α_fwd = RingHom.id K₀ := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R₂)
        apply RingHom.ext; intro r
        change α_bwd (α_fwd (algebraMap R₂ K₀ r)) = algebraMap R₂ K₀ r
        rw [hα_fwd_eq]
        change (α_bwd.comp j_LK) (e_L (ι_L r)) = algebraMap R₂ K₀ r
        rw [h_bwd_L, RingHom.comp_apply]
        change j_LK (e_L.symm (e_L (ι_L r))) = algebraMap R₂ K₀ r
        rw [e_L.symm_apply_apply, hj_LK_eq]
      have h_comp2 : α_fwd.comp α_bwd = RingHom.id K₀ := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R₂)
        apply RingHom.ext; intro r
        change α_fwd (α_bwd (algebraMap R₂ K₀ r)) = algebraMap R₂ K₀ r
        rw [hα_bwd_eq]
        change (α_fwd.comp j_LK) (e_L.symm (ι_L r)) = algebraMap R₂ K₀ r
        rw [h_fwd_L, RingHom.comp_apply]
        change j_LK (e_L (e_L.symm (ι_L r))) = algebraMap R₂ K₀ r
        rw [e_L.apply_symm_apply, hj_LK_eq]
      refine ⟨{ α_fwd with
                invFun := α_bwd
                left_inv := fun z => RingHom.congr_fun h_comp1 z
                right_inv := fun z => RingHom.congr_fun h_comp2 z }, ?_⟩
      apply RingHom.ext; intro r; exact hα_fwd_eq r
    refine ⟨hφ0', fun c => ?_⟩
    fin_cases c
    · exact hTransFrac (φ_K₀ 0).toRingHom (RingEquiv.refl K₀) hφ0'.symm
    · let e₁_L : L₀₁ ≃+* L₀₁ :=
        { ρ₁_L with
          invFun := ρ₁_L
          left_inv := fun z => RingHom.congr_fun hρ₁_L_inv z
          right_inv := fun z => RingHom.congr_fun hρ₁_L_inv z }
      obtain ⟨α₁, hα₁⟩ := hLiftEquiv e₁_L
      refine hTransFrac (φ_K₀ 1).toRingHom α₁ (hα₁.trans ?_)
      apply MvPolynomial.ringHom_ext
      · intro a
        change j_LK (ρ₁_L (ι_L (MvPolynomial.C a))) = (φ_K₀ 1) (MvPolynomial.C a)
        rw [IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hj_LK_eq,
          MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply k R₂ K₀, MvPolynomial.algebraMap_eq]
      · intro j
        fin_cases j
        · change j_LK (ρ₁_L (ι_L (MvPolynomial.X 0))) = (φ_K₀ 1) (MvPolynomial.X 0)
          rw [IsLocalization.Away.lift_eq, hρ₁_X0, hj_u0_inv]
          dsimp [φ_K₀]; rw [MvPolynomial.aeval_X]
          exact (one_div x₁').symm
        · change j_LK (ρ₁_L (ι_L (MvPolynomial.X 1))) = (φ_K₀ 1) (MvPolynomial.X 1)
          rw [IsLocalization.Away.lift_eq, hρ₁_X1, Units.val_mul, map_mul, hj_u0_inv]
          have hj1 : j_LK ↑u₁ = x₂' := by rw [hu₁, hj_LK_eq]
          rw [hj1]; dsimp [φ_K₀]; rw [MvPolynomial.aeval_X]
          exact (div_eq_mul_inv x₂' x₁').symm
    · let e₂_L : L₀₁ ≃+* L₀₁ :=
        { ρ₂_L with
          invFun := σ₂_L
          left_inv := fun z => RingHom.congr_fun hσρ₂ z
          right_inv := fun z => RingHom.congr_fun hρσ₂ z }
      obtain ⟨α₂, hα₂⟩ := hLiftEquiv e₂_L
      refine hTransFrac (φ_K₀ 2).toRingHom α₂ (hα₂.trans ?_)
      apply MvPolynomial.ringHom_ext
      · intro a
        change j_LK (ρ₂_L (ι_L (MvPolynomial.C a))) = (φ_K₀ 2) (MvPolynomial.C a)
        rw [IsLocalization.Away.lift_eq, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hj_LK_eq,
          MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply k R₂ K₀, MvPolynomial.algebraMap_eq]
      · intro j
        fin_cases j
        · change j_LK (ρ₂_L (ι_L (MvPolynomial.X 0))) = (φ_K₀ 2) (MvPolynomial.X 0)
          rw [IsLocalization.Away.lift_eq, hρ₂_X0, hj_u1_inv]
          dsimp [φ_K₀]; rw [MvPolynomial.aeval_X]
