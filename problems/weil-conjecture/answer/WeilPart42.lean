      have hmap_P₁ : MvPolynomial.map χ₁ P_R₁ = Q_quad := by
        dsimp [P_R₁, Q_quad]
        rw [map_sub, map_sum, MvPolynomial.map_C, hχ₁_h₁, map_zero, sub_zero]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
      obtain ⟨π₁, hπ₁_X, _, hPb_C₁⟩ := hMvQuotIsPullback χ₁ P_R₁ Q_quad hmap_P₁
      let c₂ : κ := χ₂ h₂
      let Q_c₂ : MvPolynomial (Fin (m + 1) × Fin 2) κ := Q_quad - MvPolynomial.C c₂
