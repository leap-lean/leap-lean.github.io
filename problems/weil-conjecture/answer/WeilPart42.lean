  have hCont_Mw' : M_w'.IsContinuous V_U.smallEtaleTopology Z_U.smallEtaleTopology := hCont_M hw'
  let _ := hCont_Mw'
  let R_w' := M_w'.sheafPushforwardContinuous AddCommGrpCat.{u} V_U.smallEtaleTopology Z_U.smallEtaleTopology
  let pf_w' := B_w'.sheafPushforwardContinuous AddCommGrpCat.{u} Z_U.smallEtaleTopology V_U.smallEtaleTopology
  let pb_w' := B_w'.sheafPullback AddCommGrpCat.{u} Z_U.smallEtaleTopology V_U.smallEtaleTopology
  let adj_w' := B_w'.sheafAdjunctionContinuous AddCommGrpCat.{u} Z_U.smallEtaleTopology V_U.smallEtaleTopology
