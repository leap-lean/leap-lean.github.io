            πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ q₀ := by
          have hsymm : (adj_u.homEquiv Fℤ_X Q).symm ((adj_u.homEquiv Fℤ_X Q)
              (πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ q₀)) =
              πℤ ≫ CategoryTheory.Abelian.Ext.addEquiv₀ q₀ :=
            Equiv.symm_apply_apply _ _
