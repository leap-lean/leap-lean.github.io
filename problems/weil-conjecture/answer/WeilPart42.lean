        (∀ v : Fin N → ZMod m_mod,
          ∃ s_v : ↑(𝒱_r'.obj.obj (Opposite.op W_V')),
            ∀ (σ' : B_V' ≃ₐ[R₀] B_V') (u_σ' : Quiver.Hom W_V' W_V'),
              ((AlgebraicGeometry.Scheme.Etale.forget U).map u_σ').left =
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ'.toRingHom) →
              ∀ (δ₁ : Quiver.Hom V_r' (CategoryTheory.Limits.pullback h_WV' π_r')),
                CategoryTheory.CategoryStruct.comp δ₁
                    (CategoryTheory.Limits.pullback.fst h_WV' π_r') =
                  CategoryTheory.CategoryStruct.id V_r' →
                CategoryTheory.CategoryStruct.comp δ₁
                    (CategoryTheory.Limits.pullback.snd h_WV' π_r') =
                  CategoryTheory.CategoryStruct.id V_r' →
                ∀ y₀ : ↥V_r',
                  triv_r' W_V' ((𝒱_r'.obj.map (Opposite.op u_σ')).hom s_v) (δ₁.base y₀) -
                    triv_r' W_V' s_v (δ₁.base y₀) =
                    ((ρ' σ').val).mulVec v - v) := by
    obtain ⟨hInj_R₀, m_id, equiv_Γ, e_id, hIdemp, hOrth, hSum, hEval, hAbsorb⟩ :=
      weil_etale_galois_domain_idempotents_and_aut_lift.{u}.1 R₀ B_V' (RatFunc F) L_V'
    obtain ⟨⟨hEt_π, _⟩, _, hSheets⟩ :=
      weil_scheme_galois_torsor_clopen_sheets.{u} R₀ B_V' hInj_R₀ m_id equiv_Γ e_id
        hIdemp hOrth hSum hEval hAbsorb U e_U
    refine ⟨hEt_π, ?_, ?_⟩
    · 
      intro σ'
      have : AlgebraicGeometry.Etale π_r' := hEt_π
      let φ_σ' : V_r' ⟶ V_r' := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ'.toRingHom)
      have hφ_over : φ_σ' ≫ π_r' = π_r' := by
        dsimp only [φ_σ', π_r']
