      · have h1 := congrArg (e.inv.hom.app (Opposite.op U)).hom hab
        have hid1 := congrArg (fun (f : 𝒢₁ ⟶ 𝒢₁) => (f.hom.app (Opposite.op U)).hom a) e.hom_inv_id
        have hid2 := congrArg (fun (f : 𝒢₁ ⟶ 𝒢₁) => (f.hom.app (Opposite.op U)).hom b) e.hom_inv_id
