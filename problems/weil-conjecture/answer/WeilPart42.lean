    CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ w hw trivial
  have hCont_Mw : M_w.IsContinuous V.smallEtaleTopology Z.smallEtaleTopology := hCont_M hw
  let _ := hCont_Mw
  let R_w := M_w.sheafPushforwardContinuous AddCommGrpCat.{u} V.smallEtaleTopology Z.smallEtaleTopology
  let pf_w := B_w.sheafPushforwardContinuous AddCommGrpCat.{u} Z.smallEtaleTopology V.smallEtaleTopology
