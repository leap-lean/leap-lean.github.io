        have hEt_base : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap C₂_ring (Localization.Away x₀_κ)))) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom (algebraMap C₂_ring (Localization.Away x₀_κ)))).mpr
            (RingHom.etale_algebraMap.mpr inferInstance)
        have _ : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S))) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom (algebraMap S₀ S))).mpr
            (RingHom.etale_algebraMap.mpr inferInstance)
        have _ : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_cone₂)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom ψ_cone₂)).mpr hEt_cone₂
        refine CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) _ _ hEt_base ?_
        rw [hcomp_spec]
        infer_instance
      obtain ⟨Φ, hΦ_C⟩ := hConeAwayEquiv κ m c₂ idx₀
      let P_sm := MvPolynomial (Fin (2 * m + 1)) κ
      let X0 : P_sm := MvPolynomial.X (0 : Fin (2 * m + 1))
      let ψ_sm : P_sm →+* S :=
        ψ_loc₂.comp (Φ.toRingHom.comp (algebraMap P_sm (Localization.Away X0)))
      have hEt_sm : ψ_sm.Etale := by
        refine (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
          (φ := CommRingCat.ofHom ψ_sm)).mp ?_
        have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc₂) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P_sm (Localization.Away X0))) := by
          dsimp [ψ_sm]
          rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        rw [hfac]
        have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc₂)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom ψ_loc₂)).mpr hEt_loc₂
        have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.toRingHom)) :=
          ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ.symm.toRingHom),
            by
              rw [← AlgebraicGeometry.Spec.map_comp]
              exact (congrArg AlgebraicGeometry.Spec.map (by
                apply CommRingCat.hom_ext; apply RingHom.ext; intro x
                exact Φ.apply_symm_apply x)).trans (AlgebraicGeometry.Spec.map_id _),
            by
              rw [← AlgebraicGeometry.Spec.map_comp]
              exact (congrArg AlgebraicGeometry.Spec.map (by
                apply CommRingCat.hom_ext; apply RingHom.ext; intro x
                exact Φ.symm_apply_apply x)).trans (AlgebraicGeometry.Spec.map_id _)⟩
        have _ : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P_sm (Localization.Away X0)))) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom (algebraMap P_sm (Localization.Away X0)))).mpr
            (RingHom.etale_algebraMap.mpr inferInstance)
        infer_instance
      let ψ_cone : (MvPolynomial (Fin (m + 1) × Fin 2) κ ⧸ Ideal.span {Q_quad}) →+* S :=
        (algebraMap S₀ S).comp ψ_cone₁
      have hEt_cone : ψ_cone.Etale := by
        refine (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
          (φ := CommRingCat.ofHom ψ_cone)).mp ?_
        have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_cone) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_cone₁) := by
          dsimp [ψ_cone]
          rw [← AlgebraicGeometry.Spec.map_comp]
        rw [hfac]
        have _ : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap S₀ S))) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom (algebraMap S₀ S))).mpr
            (RingHom.etale_algebraMap.mpr inferInstance)
        have _ : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_cone₁)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom ψ_cone₁)).mpr hEt_cone₁
        infer_instance
      have hψ_sm_C : ψ_sm.comp MvPolynomial.C = (algebraMap S₀ S).comp ι_S := by
        ext c
        change ψ_loc₂ (Φ (algebraMap P_sm _ (MvPolynomial.C c))) = algebraMap S₀ S (ι_S c)
        rw [hΦ_C c]
        dsimp only [ψ_loc₂]
        rw [IsLocalization.Away.lift_eq]
        change algebraMap S₀ S (ψ_cone₂ (Ideal.Quotient.mk _ (MvPolynomial.C c))) = _
        congr 1
        exact RingHom.congr_fun hψ_cone₂_ι c
      have hε_sm : (ε_S.comp ψ_sm).comp MvPolynomial.C = RingHom.id κ := by
        ext c
        rw [RingHom.comp_assoc, hψ_sm_C]
        change ε_S (algebraMap S₀ S (ι_S c)) = c
        rw [IsLocalization.Away.lift_eq]
        exact RingHom.congr_fun hε_ι c
      have h_compat : ψ_cone.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) =
          ψ_sm.comp MvPolynomial.C := by
        rw [hψ_sm_C, RingHom.comp_assoc, hψ_cone₁_ι]
      have hVtx : ∀ idx : Fin (m + 1) × Fin 2,
          ε_S (ψ_cone (Ideal.Quotient.mk _ (MvPolynomial.X idx))) = 0 := by
        intro idx
        change ε_S (algebraMap S₀ S (ψ_cone₁ (Ideal.Quotient.mk _ (MvPolynomial.X idx)))) = 0
        rw [IsLocalization.Away.lift_eq, ← hπ₁_X idx]
        change (ε₀.comp (ψ_cone₁.comp π₁)) (Ideal.Quotient.mk _ (MvPolynomial.X idx)) = 0
        rw [← RingHom.mem_ker, hker_cone₁]
        exact hv₁_X idx
      exact hConeVsSmoothAlg κ m S ε_S ψ_sm ψ_cone hε_sm h_compat hEt_sm hEt_cone hVtx
  have hEtaleResidueFiniteSeparable : ∀ {W S : AlgebraicGeometry.Scheme.{u}}
      (f : W ⟶ S) [AlgebraicGeometry.Etale f] (w : W),
      let K_s := ↥(S.residueField (f.base w))
      let K_w := ↥(W.residueField w)
      let _ : Algebra K_s K_w := (f.residueFieldMap w).hom.toAlgebra
      FiniteDimensional K_s K_w ∧ Algebra.IsSeparable K_s K_w :=
    fun {W S} f [AlgebraicGeometry.Etale f] w => by
    intro K_s K_w _
    let _ : CommRing K_s := Field.toCommRing
    let _ : DivisionRing K_s := Field.toDivisionRing
    let _ : CommRing K_w := Field.toCommRing
    let _ : DivisionRing K_w := Field.toDivisionRing
    classical
    let s := f.base w
    let W_s := CategoryTheory.Limits.pullback f (S.fromSpecResidueField s)
    let p₁ : W_s ⟶ W := CategoryTheory.Limits.pullback.fst f (S.fromSpecResidueField s)
    let p₂ : W_s ⟶ AlgebraicGeometry.Spec (S.residueField s) :=
      CategoryTheory.Limits.pullback.snd f (S.fromSpecResidueField s)
    let ι_w : AlgebraicGeometry.Spec (W.residueField w) ⟶ W_s :=
      CategoryTheory.Limits.pullback.lift
        (W.fromSpecResidueField w)
        (AlgebraicGeometry.Spec.map (f.residueFieldMap w))
        (f.SpecMap_residueFieldMap_fromSpecResidueField w).symm
    let pt_w : AlgebraicGeometry.Spec (W.residueField w) := IsLocalRing.closedPoint K_w
    let w_s : W_s := ι_w.base pt_w
    have hw_s_p₁ : p₁.base w_s = w := by
      change (ι_w ≫ p₁).base pt_w = w
      rw [CategoryTheory.Limits.pullback.lift_fst]
      exact W.fromSpecResidueField_apply w pt_w
    obtain ⟨A_cat, j_A, hj_A_open, hmem_A, _⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : W_s.Opens)) (x := w_s) trivial
    obtain ⟨q_A, hq_A⟩ := hmem_A
    let A : Type u := ↥A_cat
    let φ_KA_cat : S.residueField s ⟶ A_cat := AlgebraicGeometry.Spec.preimage (j_A ≫ p₂)
    have hEt_KA : φ_KA_cat.hom.Etale := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
        AlgebraicGeometry.Spec.map_preimage]
      infer_instance
    let _ : Algebra K_s A := φ_KA_cat.hom.toAlgebra
    have _ : Algebra.Etale K_s A := RingHom.etale_algebraMap.mp hEt_KA
    obtain ⟨I, hFinI, A_i, hField_i, hAlg_i, ⟨e_prod, hFinSep_i⟩⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K_s A).mp inferInstance
    let _ := hField_i
    let _ := hAlg_i
    let _ : Fintype I := Fintype.ofFinite I
    let K_q := ↥((AlgebraicGeometry.Spec A_cat).residueField q_A)
    obtain ⟨hker_q, hSub_q⟩ := hSpecResidueSubfieldEqTop A q_A
    let ι_q : A →+* K_q :=
      (AlgebraicGeometry.Spec.preimage ((AlgebraicGeometry.Spec A_cat).fromSpecResidueField q_A)).hom
    have hex_i₀ : ∃ i₀ : I, e_prod.symm (Pi.single i₀ 1) ∉ q_A.asIdeal := by
      by_contra hall
      push Not at hall
      have hsum1 : (∑ i : I, e_prod.symm (Pi.single i (1 : A_i i))) = 1 := by
        apply e_prod.injective
        ext j
        simp only [map_sum, map_one, AlgEquiv.apply_symm_apply, Finset.sum_apply]
        rw [Finset.sum_eq_single j]
        · simp
        · intro b _ hb; exact Pi.single_eq_of_ne' hb 1
        · intro hj; exact False.elim (hj (Finset.mem_univ j))
      have h1_mem : (1 : A) ∈ q_A.asIdeal := by
        rw [← hsum1]
        exact Ideal.sum_mem q_A.asIdeal fun i _ => hall i
      exact q_A.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ h1_mem isUnit_one)
    obtain ⟨i₀, hi₀⟩ := hex_i₀
    let u₀ : A := e_prod.symm (Pi.single i₀ 1)
    have hu₀_idem : u₀ * u₀ = u₀ := by
      apply e_prod.injective
      ext j
      simp only [u₀, map_mul, AlgEquiv.apply_symm_apply, Pi.mul_apply]
      by_cases hj : j = i₀
      · subst hj; simp
      · simp [Pi.single_eq_of_ne hj]
    have hι_u₀_ne : ι_q u₀ ≠ 0 := by
      intro h0
      apply hi₀
      rw [← hker_q]
      exact h0
    have hι_u₀_one : ι_q u₀ = 1 := by
      have hmul : ι_q u₀ * (ι_q u₀ - 1) = 0 := by
        calc ι_q u₀ * (ι_q u₀ - 1) = ι_q (u₀ * u₀) - ι_q u₀ := by rw [map_mul]; ring
          _ = 0 := by rw [hu₀_idem, sub_self]
      exact sub_eq_zero.mp ((mul_eq_zero.mp hmul).resolve_left hι_u₀_ne)
    let α₁ : S.residueField s ⟶ W.residueField w := f.residueFieldMap w
    let α₂ : W.residueField w ⟶ W_s.residueField w_s :=
      (W.residueFieldCongr hw_s_p₁.symm).hom ≫ p₁.residueFieldMap w_s
    let α₃ : W_s.residueField w_s ⟶ (AlgebraicGeometry.Spec A_cat).residueField q_A :=
      (W_s.residueFieldCongr hq_A.symm).hom ≫ j_A.residueFieldMap q_A
    have hTower_eq : (α₁ ≫ α₂ ≫ α₃).hom = ι_q.comp φ_KA_cat.hom := by
      have hSpec_eq : AlgebraicGeometry.Spec.map (α₁ ≫ α₂ ≫ α₃) ≫ S.fromSpecResidueField s =
          AlgebraicGeometry.Spec.map
            (φ_KA_cat ≫ AlgebraicGeometry.Spec.preimage
              ((AlgebraicGeometry.Spec A_cat).fromSpecResidueField q_A)) ≫
            S.fromSpecResidueField s := by
        have h3 : AlgebraicGeometry.Spec.map α₃ ≫ W_s.fromSpecResidueField w_s =
            (AlgebraicGeometry.Spec A_cat).fromSpecResidueField q_A ≫ j_A := by
          dsimp [α₃]
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
            W_s.residueFieldCongr_fromSpecResidueField hq_A.symm,
            j_A.SpecMap_residueFieldMap_fromSpecResidueField q_A]
        have h2 : AlgebraicGeometry.Spec.map α₂ ≫ W.fromSpecResidueField w =
            W_s.fromSpecResidueField w_s ≫ p₁ := by
          dsimp [α₂]
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
            W.residueFieldCongr_fromSpecResidueField hw_s_p₁.symm,
