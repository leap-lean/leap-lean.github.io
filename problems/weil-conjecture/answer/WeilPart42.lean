        (Submodule.smul_mem_smul (Ideal.subset_span (by simp)) hb'_ker)
    have hN_bot : N_ker = ⊥ :=
      Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (IsLocalRing.maximalIdeal R_loc) N_ker hN_fg
