                  rw [mul_inv_cancel₀ (pow_ne_zero n hf_L₂_ne), mul_one]
            _ = x.1 * f_L₂ ^ n * algebraMap A₀ L₂ g * (f_L₂ ^ n)⁻¹ := by ring
        exists_of_eq := by
          intro z₁ z₂ hz_eq
          rw [hAlg_C] at hz_eq
          have hsub : φ_C (z₁ - z₂) = 0 := by
            rw [map_sub, hz_eq, sub_self]
