  obtain ⟨w, hw⟩ := hGen n (weilEtaleTorsionSheaf U m₀) hZero y hy
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
  let πM₀ : pb_u.obj (weilEtaleTorsionSheaf X m₀) ⟶ weilEtaleTorsionSheaf U m₀ :=
    weilEtaleConstPullbackHom u (weilEtaleIdTerminalIsTerminal.{u} U) hT_X AM
  let η_u : weilEtaleTorsionSheaf X m₀ ⟶ pf_u.obj (weilEtaleTorsionSheaf U m₀) :=
    (adj_u.homEquiv (weilEtaleTorsionSheaf X m₀) (weilEtaleTorsionSheaf U m₀)) πM₀
  letI : CategoryTheory.IsIso η_u := hIso_η
  let η_inv : pf_u.obj (weilEtaleTorsionSheaf U m₀) ⟶ weilEtaleTorsionSheaf X m₀ :=
    CategoryTheory.inv η_u
  let ξ : weilEtaleTorsionH X m₀ (n + 1) :=
    w.comp (CategoryTheory.Abelian.Ext.mk₀ η_inv) (Nat.add_zero (n + 1))
  have hξ_η : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ η_u) (Nat.add_zero (n + 1)) = w := by
    dsimp [ξ]
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.IsIso.inv_hom_id η_u,
      CategoryTheory.Abelian.Ext.comp_mk₀_id]
  rcases hp_u with ⟨hc', hr', hAdd', hLim', hColim', T'₁, hT'₁, T'₂, hT'₂, ι'ℤ, hι'1, _, hp_eq⟩
  rcases Subsingleton.elim hc' (sys u).hCont with rfl
  rcases Subsingleton.elim hr' (sys u).hAdj with rfl
  rcases Subsingleton.elim hAdd' (sys u).hAdd_pb with rfl
  rcases Subsingleton.elim hLim' (sys u).hLim_pb with rfl
  rcases Subsingleton.elim hColim' (sys u).hColim_pb with rfl
  have hπ'ℤ : weilEtaleConstPullbackHom u hT'₁ hT'₂ Aℤ = πℤ :=
    hConstIndep hT'₁ hT_U hT'₂ hT_X Aℤ
  have hπ'M : weilEtaleConstPullbackHom u hT'₁ hT'₂ AM = πM₀ :=
    hConstIndep hT'₁ (weilEtaleIdTerminalIsTerminal.{u} U) hT'₂ hT_X AM
  have hι'1_fold : ι'ℤ ≫ weilEtaleConstPullbackHom u hT'₁ hT'₂ Aℤ =
      CategoryTheory.CategoryStruct.id Fℤ_U := hι'1
  have hι'_eq : ι'ℤ = ιℤ := by
    calc ι'ℤ = ι'ℤ ≫ CategoryTheory.CategoryStruct.id (pb_u.obj Fℤ_X) :=
          (CategoryTheory.Category.comp_id _).symm
      _ = ι'ℤ ≫ (πℤ ≫ ιℤ) := by rw [hι2]
