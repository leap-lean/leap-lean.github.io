        symm; rw [hprod_expand, hswap, add_assoc, ← Finset.sum_add_distrib]
        simp_rw [hcocycle, Finset.sum_add_distrib, ← Finset.mul_sum]
        change ℓ x * ℓ y + ((∑ j : Fin n, δ (x * y) (b j) * ℓ (bDual j)) + δ x y * η) = g₀ (x * y)
        rw [hδη]; dsimp [g₀, δ]; ring
      have hg_comm : ∀ r : R, g₀ (algebraMap R S r) = algebraMap R Q r := by
        intro r
        have h1 : algebraMap R S r = r • (1 : S) := by rw [Algebra.smul_def, mul_one]
        have hsmul : ∀ (c : R) (x : S), g₀ (c • x) = c • g₀ x := by
          intro c x; dsimp [g₀, δ]; rw [LinearMap.map_smul, smul_add, Finset.smul_sum]; congr 1
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [smul_mul_assoc, LinearMap.map_smul, smul_mul_assoc, ← smul_sub, smul_mul_assoc]
        rw [h1, hsmul, hg_one, Algebra.smul_def, mul_one]
