      have hq_tilde_ker :
          q_tilde.comp (CategoryTheory.Abelian.Ext.mk₀ δ_tilde₀) (Nat.add_zero 0) = 0 := by
        apply hev_inj
        rw [hev_nat δ_tilde₀ q_tilde, hε₀_ev Q q₀]
        have hcancel_ε : (((ε₀ Q).inv ≫ δ₀).hom.app (Opposite.op T_X)).hom
