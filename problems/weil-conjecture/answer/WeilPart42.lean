              CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_target :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hα_snd : α_γ ≫ CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target =
              CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          rw [← cancel_mono U_Y.ι]
          dsimp only [j_tot, τ_UY]
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hL : ((α_γ ≫ (e_YΩ_tgt.hom ≫ j_Y_open)) ≫ U_Y.ι) ≫
                CategoryTheory.Limits.pullback.fst f_line.left g_V_line =
                α_γ ≫ e_YΩ_tgt.hom ≫
                  CategoryTheory.Limits.pullback.fst f_line.left η_V_line := by
              calc ((α_γ ≫ (e_YΩ_tgt.hom ≫ j_Y_open)) ≫ U_Y.ι) ≫
                    CategoryTheory.Limits.pullback.fst f_line.left g_V_line
                  = α_γ ≫ e_YΩ_tgt.hom ≫ ((j_Y_open ≫ U_Y.ι) ≫
                      CategoryTheory.Limits.pullback.fst f_line.left g_V_line) := by
                    simp only [Category.assoc]
                _ = α_γ ≫ e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.fst f_line.left η_V_line := by
                    rw [hjY_fst]
            have hR : (((e_YΩ_tgt.hom ≫ j_Y_open) ≫ τ_UY_hom) ≫ U_Y.ι) ≫
                CategoryTheory.Limits.pullback.fst f_line.left g_V_line =
                e_YΩ_tgt.hom ≫
                  CategoryTheory.Limits.pullback.fst f_line.left η_V_line := by
              calc (((e_YΩ_tgt.hom ≫ j_Y_open) ≫ τ_UY_hom) ≫ U_Y.ι) ≫
                    CategoryTheory.Limits.pullback.fst f_line.left g_V_line
                  = e_YΩ_tgt.hom ≫ j_Y_open ≫ (τ_UY_hom ≫ U_Y.ι) ≫
                      CategoryTheory.Limits.pullback.fst f_line.left g_V_line := by
                    simp only [Category.assoc]
                _ = e_YΩ_tgt.hom ≫ ((j_Y_open ≫ U_Y.ι) ≫
                      (τ_Y.hom ≫ CategoryTheory.Limits.pullback.fst f_line.left g_V_line)) := by
                    rw [hτ_UY_fac]; simp only [Category.assoc]
                _ = e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.fst f_line.left η_V_line := by
                    rw [hτY_fst, hjY_fst]
            rw [hL, hR]
            apply (CategoryTheory.IsPullback.of_hasPullback g₂_k.left g_line).hom_ext
            · calc (α_γ ≫ e_YΩ_tgt.hom ≫
                    CategoryTheory.Limits.pullback.fst f_line.left η_V_line) ≫
                    CategoryTheory.Limits.pullback.fst g₂_k.left g_line
                  = α_γ ≫ (e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.fst f_line.left η_V_line ≫
                      CategoryTheory.Limits.pullback.fst g₂_k.left g_line) := by
                    simp only [Category.assoc]
                _ = α_γ ≫ CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_target := by
                    rw [heYΩ_tgt_fst]
                _ = CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_target := hα_fst
                _ = (e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.fst f_line.left η_V_line) ≫
                      CategoryTheory.Limits.pullback.fst g₂_k.left g_line := by
                    rw [Category.assoc, heYΩ_tgt_fst]
            · have hcond : CategoryTheory.Limits.pullback.fst f_line.left η_V_line ≫ f_line.left =
                  CategoryTheory.Limits.pullback.snd f_line.left η_V_line ≫ η_V_line :=
                CategoryTheory.Limits.pullback.condition
              change (α_γ ≫ e_YΩ_tgt.hom ≫
                  CategoryTheory.Limits.pullback.fst f_line.left η_V_line) ≫ f_line.left =
                (e_YΩ_tgt.hom ≫
                  CategoryTheory.Limits.pullback.fst f_line.left η_V_line) ≫ f_line.left
              calc (α_γ ≫ e_YΩ_tgt.hom ≫
                    CategoryTheory.Limits.pullback.fst f_line.left η_V_line) ≫ f_line.left
                  = α_γ ≫ e_YΩ_tgt.hom ≫
                      (CategoryTheory.Limits.pullback.fst f_line.left η_V_line ≫ f_line.left) := by
                    simp only [Category.assoc]
                _ = α_γ ≫ (e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.snd f_line.left η_V_line) ≫ η_V_line := by
                    rw [hcond]; simp only [Category.assoc]
                _ = (α_γ ≫ CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target) ≫
                      (j_V ≫ g_V_line) := by
                    rw [heYΩ_tgt_snd]; simp only [η_V_line, Category.assoc]
                _ = CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ j_V) ≫
                      g_V_line := by
                    rw [hα_snd]; simp only [Category.assoc]
                _ = CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫ j_V ≫
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom) ≫
                        g_V_line) := by
                    rw [hγ_jV]; simp only [Category.assoc]
                _ = (e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.snd f_line.left η_V_line) ≫ η_V_line := by
                    rw [hγV_gVline, heYΩ_tgt_snd]
                _ = (e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.fst f_line.left η_V_line) ≫ f_line.left := by
                    rw [Category.assoc, ← hcond, ← Category.assoc]
          · have hL2 : ((α_γ ≫ (e_YΩ_tgt.hom ≫ j_Y_open)) ≫ U_Y.ι) ≫
                CategoryTheory.Limits.pullback.snd f_line.left g_V_line =
                CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
                  (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ j_V) := by
              calc ((α_γ ≫ (e_YΩ_tgt.hom ≫ j_Y_open)) ≫ U_Y.ι) ≫
                    CategoryTheory.Limits.pullback.snd f_line.left g_V_line
                  = α_γ ≫ e_YΩ_tgt.hom ≫ ((j_Y_open ≫ U_Y.ι) ≫
                      CategoryTheory.Limits.pullback.snd f_line.left g_V_line) := by
                    simp only [Category.assoc]
                _ = (α_γ ≫ (e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.snd f_line.left η_V_line)) ≫ j_V := by
                    rw [hjY_snd]; simp only [Category.assoc]; rfl
                _ = (α_γ ≫ CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target) ≫ j_V := by
                    rw [heYΩ_tgt_snd]
                _ = CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
                      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ j_V) := by
                    rw [hα_snd, Category.assoc]
            have hR2 : (((e_YΩ_tgt.hom ≫ j_Y_open) ≫ τ_UY_hom) ≫ U_Y.ι) ≫
                CategoryTheory.Limits.pullback.snd f_line.left g_V_line =
                CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
                  (j_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom)) := by
              calc (((e_YΩ_tgt.hom ≫ j_Y_open) ≫ τ_UY_hom) ≫ U_Y.ι) ≫
                    CategoryTheory.Limits.pullback.snd f_line.left g_V_line
                  = e_YΩ_tgt.hom ≫ j_Y_open ≫ (τ_UY_hom ≫ U_Y.ι) ≫
                      CategoryTheory.Limits.pullback.snd f_line.left g_V_line := by
                    simp only [Category.assoc]
                _ = e_YΩ_tgt.hom ≫ ((j_Y_open ≫ U_Y.ι) ≫
                      (τ_Y.hom ≫ CategoryTheory.Limits.pullback.snd f_line.left g_V_line)) := by
                    rw [hτ_UY_fac]; simp only [Category.assoc]
                _ = e_YΩ_tgt.hom ≫ (((j_Y_open ≫ U_Y.ι) ≫
                      CategoryTheory.Limits.pullback.snd f_line.left g_V_line) ≫
                      AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom)) := by
                    rw [hτY_snd]; simp only [Category.assoc]
                _ = (e_YΩ_tgt.hom ≫
                      CategoryTheory.Limits.pullback.snd f_line.left η_V_line) ≫
                      (j_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom)) := by
                    rw [hjY_snd]; simp only [Category.assoc]; rfl
                _ = CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
                      (j_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom)) := by
                    rw [heYΩ_tgt_snd]
            rw [hL2, hR2, hγ_jV]

        obtain ⟨p_γ, hp_γ⟩ := hPullEx α_γ m₀ (2 * m + 1)
        obtain ⟨p_e_tgt, hp_e_tgt⟩ := hPullEx e_YΩ_tgt.hom m₀ (2 * m + 1)
        obtain ⟨p_jY, hp_jY⟩ := hPullEx j_Y_open m₀ (2 * m + 1)
        obtain ⟨p_jtot, hp_jtot⟩ := hPullEx j_tot m₀ (2 * m + 1)
        obtain ⟨p_jtot_aut, hp_jtot_aut⟩ := hPullEx (α_γ ≫ j_tot) m₀ (2 * m + 1)
        have hBij_etgt : Function.Bijective p_e_tgt :=
          hPullIsoBij e_YΩ_tgt m₀ (2 * m + 1) p_e_tgt hp_e_tgt
        have hBij_jY_mid : Function.Bijective p_jY := hBij_jY (2 * m + 1) p_jY hp_jY
        have hcomp_jtot : p_jtot = p_e_tgt.comp p_jY :=
          hPullComp e_YΩ_tgt.hom j_Y_open m₀ (2 * m + 1) p_e_tgt p_jY p_jtot
            hp_e_tgt hp_jY hp_jtot
        have hBij_jtot : Function.Bijective p_jtot := by
          rw [hcomp_jtot]
          exact hBij_etgt.comp hBij_jY_mid
        have hEq_jtot : ∀ y, p_γ (p_jtot y) = p_jtot (p_τUY y) := fun y =>
          (hPullTri α_γ j_tot (α_γ ≫ j_tot) m₀ (2 * m + 1)
            p_γ p_jtot p_jtot_aut rfl hp_γ hp_jtot hp_jtot_aut y).symm.trans
          (hPullTri j_tot τ_UY.hom (α_γ ≫ j_tot) m₀ (2 * m + 1)
            p_jtot p_τUY p_jtot_aut hcomm_jtot.symm hp_jtot hp_τUY hp_jtot_aut y)
        have hUnip_γ : ∀ v : weilEtaleTorsionH Y_Ω_target m₀ (2 * m + 1),
            p_γ (p_γ v - v) = p_γ v - v := by
          intro v
          obtain ⟨y, rfl⟩ := hBij_jtot.2 v
          rw [hEq_jtot y, ← map_sub, hEq_jtot (p_τUY y - y), hUnip_UY y]

        
        let p_pow : ℕ → (weilEtaleTorsionH Y_Ω_target m₀ (2 * m + 1) →+
            weilEtaleTorsionH Y_Ω_target m₀ (2 * m + 1)) :=
          fun n => Nat.rec (AddMonoidHom.id _) (fun _ acc => p_γ.comp acc) n
        have hp_pow_pull : ∀ n : ℕ,
            WeilIsTorsionEtalePullback (weilSchemeEndPow α_γ n) m₀ (2 * m + 1) (p_pow n) ∧
            weilSchemeEndPow α_γ n ≫ CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_target =
              CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_target ∧
            weilSchemeEndPow α_γ n ≫ CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target =
              CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((γ ^ n).toRingHom)) := by
          intro n
          induction n with
          | zero =>
            obtain ⟨p_id, hp_id⟩ := hPullEx (𝟙 Y_Ω_target) m₀ (2 * m + 1)
            have hid_eq : p_id = AddMonoidHom.id _ := hPullId m₀ (2 * m + 1) p_id hp_id
            rw [hid_eq] at hp_id
            refine ⟨hp_id, Category.id_comp _, ?_⟩
            change (𝟙 Y_Ω_target) ≫ _ = _ ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id Ω_κ₁))
            rw [Category.id_comp]
            change _ = _ ≫ AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of Ω_κ₁))
            rw [AlgebraicGeometry.Spec.map_id, Category.comp_id]
          | succ n ih =>
            obtain ⟨hp_n, hfst_n, hsnd_n⟩ := ih
            obtain ⟨p_step, hp_step⟩ :=
              hPullEx (α_γ ≫ weilSchemeEndPow α_γ n) m₀ (2 * m + 1)
            have hstep_eq : p_step = p_γ.comp (p_pow n) :=
              hPullComp α_γ (weilSchemeEndPow α_γ n) m₀ (2 * m + 1)
                p_γ (p_pow n) p_step hp_γ hp_n hp_step
            rw [hstep_eq] at hp_step
            refine ⟨hp_step, ?_, ?_⟩
            · change (α_γ ≫ weilSchemeEndPow α_γ n) ≫ _ = _
              rw [Category.assoc, hfst_n, CategoryTheory.Limits.pullback.lift_fst]
            · change (α_γ ≫ weilSchemeEndPow α_γ n) ≫ _ = _
              rw [Category.assoc, hsnd_n, ← Category.assoc,
                CategoryTheory.Limits.pullback.lift_snd, Category.assoc]
              congr 1
              rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
              exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
                (RingHom.ext fun z => by rw [pow_succ']; rfl)
        have hIter_p : ∀ (n : ℕ) (v : weilEtaleTorsionH Y_Ω_target m₀ (2 * m + 1)),
            p_pow n v = v + n • (p_γ v - v) := by
          intro n v
          induction n with
          | zero => simp [p_pow]
          | succ n ih =>
            change p_γ (p_pow n v) = v + (n + 1) • (p_γ v - v)
            rw [ih, map_add, map_nsmul, hUnip_γ v, succ_nsmul]
            abel
        have hp_m₀_id : ∀ v : weilEtaleTorsionH Y_Ω_target m₀ (2 * m + 1),
            p_pow m₀ v = v := by
          intro v
          rw [hIter_p m₀ v, hAnn_YΩ (p_γ v - v), add_zero]
        have hγ_pow_K₂ : ∀ (n : ℕ) (x : K₂), (γ ^ n) (ψ_Ω x) = ψ_Ω x := by
          intro n x
          induction n with
          | zero => rfl
          | succ n ih =>
            rw [pow_succ']
            change γ ((γ ^ n) (ψ_Ω x)) = ψ_Ω x
            rw [ih, hγ_K₂ x]
        have hγ_pow_iL : ∀ (n : ℕ) (z : L₂), (γ ^ n) (i_L z) = i_L ((σ ^ n) z) := by
          intro n
          induction n with
          | zero => intro _; rfl
          | succ n ih =>
            intro z
            rw [pow_succ', pow_succ']
            change γ ((γ ^ n) (i_L z)) = i_L (σ ((σ ^ n) z))
            rw [ih z, hγ_iL ((σ ^ n) z)]
        obtain ⟨hp_m₀, hfst_m₀, hsnd_m₀⟩ := hp_pow_pull m₀
        have hγ_m₀_fix_L : ∀ z : L₂, (γ ^ m₀) (i_L z) = i_L z :=
          (hFaithful_L₂ Ω_κ₁ ψ_Ω i_L hi_K₂ (γ ^ m₀) (hγ_pow_K₂ m₀)
            (weilSchemeEndPow α_γ m₀) hfst_m₀ hsnd_m₀ (p_pow m₀) hp_m₀).mpr hp_m₀_id
        ext z
        exact i_L.injective ((hγ_pow_iL m₀ z).symm.trans (hγ_m₀_fix_L z))

      
      by_cases hchar0 : ringChar k = 0
      · exact Or.inl hchar0
      · right
        set p_ch := ringChar k
        have _ : CharP k p_ch := ringChar.charP k
        have hp_prime : Nat.Prime p_ch :=
          (CharP.char_is_prime_or_zero k p_ch).resolve_right hchar0
        have hp_ne_ℓ : p_ch ≠ ℓ := by
          intro h_eq
          have hp0 : (p_ch : k) = 0 := ringChar.Nat.cast_ringChar
          rw [h_eq] at hp0
          exact hℓ_k hp0
        let _ : Algebra R₂ L₂ := algL_0
        have hMap_int : ∀ (τ : L₂ ≃ₐ[K₂] L₂) (y : ↥B₂_0), τ (y : L₂) ∈ B₂_0 := by
          intro τ y
          obtain ⟨P_int, hP_mon, hP_ev⟩ := y.2
          refine ⟨P_int, hP_mon, ?_⟩
          have hcomm : τ.toRingHom.comp (algebraMap R₂ L₂) = algebraMap R₂ L₂ := by
            apply RingHom.ext; intro r
            change τ (algebraMap K₂ L₂ ((φ_K₂ 0) r)) = algebraMap K₂ L₂ ((φ_K₂ 0) r)
            exact τ.commutes ((φ_K₂ 0) r)
          have hev := congrArg τ.toRingHom hP_ev
          rw [Polynomial.hom_eval₂, hcomm, map_zero] at hev
          exact hev
        have hMul_inert : ∀ {σ₁ σ₂ : L₂ ≃ₐ[K₂] L₂},
            (∀ y : ↥B₂_0, σ₁ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0)) →
            (∀ y : ↥B₂_0, σ₂ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0)) →
            (∀ y : ↥B₂_0,
              (σ₁ * σ₂) (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0)) := by
          intro σ₁ σ₂ h₁ h₂ y
          obtain ⟨q₁, hq₁, hq₁_eq⟩ := h₁ ⟨σ₂ (y : L₂), hMap_int σ₂ y⟩
          obtain ⟨q₂, hq₂, hq₂_eq⟩ := h₂ y
          refine ⟨q₁ + q₂, Q_C.add_mem hq₁ hq₂, ?_⟩
          change (q₁ : L₂) + (q₂ : L₂) = σ₁ (σ₂ (y : L₂)) - (y : L₂)
          rw [hq₁_eq, hq₂_eq]
          dsimp
          ring
        have hOne_inert : ∀ y : ↥B₂_0,
            (1 : L₂ ≃ₐ[K₂] L₂) (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0) :=
          fun y => ⟨0, Q_C.zero_mem, by simp⟩
        have hPow_inert : ∀ (n : ℕ) {σ : L₂ ≃ₐ[K₂] L₂},
            (∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0)) →
            (∀ y : ↥B₂_0, (σ ^ n) (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0)) := by
          intro n
          induction n with
          | zero => intro _ _; exact hOne_inert
          | succ n ih =>
            intro σ hσ
            rw [pow_succ']
            exact hMul_inert hσ (ih hσ)
        have hm₀_pos : 1 ≤ m₀ := Nat.one_le_pow _ _ (Fact.out : Nat.Prime ℓ).pos
        let I_sub : Subgroup (L₂ ≃ₐ[K₂] L₂) :=
          { carrier := { σ : L₂ ≃ₐ[K₂] L₂ |
              ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0) }
            one_mem' := hOne_inert
            mul_mem' := hMul_inert
            inv_mem' := fun {σ} hσ => by
              have hpow := hPow1 σ hσ
              have hinv_eq : σ⁻¹ = σ ^ (m₀ - 1) := by
                apply inv_eq_of_mul_eq_one_right
                rw [← pow_succ', Nat.sub_add_cancel hm₀_pos]
                exact hpow
              rw [hinv_eq]
              exact hPow_inert (m₀ - 1) hσ }
        rw [hp_prime.coprime_iff_not_dvd]
        intro hdvd_card
        have _ : Fact (Nat.Prime p_ch) := ⟨hp_prime⟩
        have hdvd_sub : p_ch ∣ Nat.card ↥I_sub := hdvd_card
        obtain ⟨g, hg_ord⟩ := exists_prime_orderOf_dvd_card' (G := ↥I_sub) p_ch hdvd_sub
        have hg_pow : g ^ m₀ = 1 := Subtype.ext (hPow1 g.1 g.2)
        have hdvd_m₀ : p_ch ∣ m₀ := hg_ord ▸ orderOf_dvd_of_pow_eq_one hg_pow
        have hdvd_ℓ : p_ch ∣ ℓ := hp_prime.dvd_of_dvd_pow hdvd_m₀
        rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd p_ch hdvd_ℓ with hp1 | hpℓ
        · exact hp_prime.ne_one hp1
        · exact hp_ne_ℓ hpℓ

theorem weil_net_p2_curve_open_baseChange_to_algClosed (F : Type u) [Finite F] [Field F]
    (d_rel ℓ r' : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    [AlgebraicGeometry.IsOpenImmersion j_aff]
    (hj_aff_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    [AlgebraicGeometry.SmoothOfRelativeDimension d_rel (f₀.left ∣_ U₀)]
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra F k]
    (Δ_F : Polynomial F) (hΔ_F_ne : Δ_F ≠ 0)
