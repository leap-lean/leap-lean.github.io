  have hTor_1 : ℓ • CategoryTheory.CategoryStruct.id
      (weilEtaleTorsionSheaf Z_bar.left (ℓ ^ 1)) = 0 := by
    rw [pow_one]
    exact (weil_outer_bc_const_pullback_and_bockstein_ses.2.2.1 f_bar.left 0 ℓ).2

  let P_sch := (weilProjectiveSpaceOver k 1).left
  let m₀ := ℓ ^ (r' + 1)
  let Λ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  let Z_gal := CategoryTheory.Limits.pullback f_bar.left h_gal
  let g'_gal := CategoryTheory.Limits.pullback.fst f_bar.left h_gal
  let f_gal := CategoryTheory.Limits.pullback.snd f_bar.left h_gal
  let Z_Ω := CategoryTheory.Limits.pullback f_bar.left η_bar
  let g'_Ω := CategoryTheory.Limits.pullback.fst f_bar.left η_bar
  let f_Ω := CategoryTheory.Limits.pullback.snd f_bar.left η_bar
  have hPb_gal_sq : CategoryTheory.IsPullback g'_gal f_gal f_bar.left h_gal :=
    CategoryTheory.IsPullback.of_hasPullback f_bar.left h_gal
  have hPb_Ω_sq : CategoryTheory.IsPullback g'_Ω f_Ω f_bar.left η_bar :=
    CategoryTheory.IsPullback.of_hasPullback f_bar.left η_bar
  have h_lift_gal : g'_Ω ≫ f_bar.left = (f_Ω ≫ w_Ω) ≫ h_gal := by
    rw [CategoryTheory.Category.assoc, hw_η]
    exact CategoryTheory.Limits.pullback.condition
  let ι_Ω : Z_Ω ⟶ Z_gal :=
    CategoryTheory.Limits.pullback.lift g'_Ω (f_Ω ≫ w_Ω) h_lift_gal
  have hι_fst : ι_Ω ≫ g'_gal = g'_Ω :=
    CategoryTheory.Limits.pullback.lift_fst g'_Ω (f_Ω ≫ w_Ω) h_lift_gal
  have h_sq_w : ι_Ω ≫ f_gal = f_Ω ≫ w_Ω :=
    CategoryTheory.Limits.pullback.lift_snd g'_Ω (f_Ω ≫ w_Ω) h_lift_gal

  let ℛ_gal := weilEtaleHigherDirectImage f_gal d_rel (weilEtaleTorsionSheaf Z_gal m₀)
  let ℛ_Ω := weilEtaleHigherDirectImage f_Ω d_rel (weilEtaleTorsionSheaf Z_Ω m₀)

  have hUpgrade : ∀ {X₀ S₀ S₁ X₁ : AlgebraicGeometry.Scheme.{u}}
      (f₀ : Quiver.Hom X₀ S₀) (b₀ : Quiver.Hom S₁ S₀)
      (f₁ : Quiver.Hom X₁ S₁) (b₁ : Quiver.Hom X₁ X₀)
      (h_sq : CategoryTheory.CategoryStruct.comp b₁ f₀ = CategoryTheory.CategoryStruct.comp f₁ b₀),
      (∃ γ, WeilIsSingDevAlgBCConstPush f₀ b₀ f₁ b₁ h_sq Λ d_rel γ) ∧
      (∀ {β},
        WeilIsSingDevAlgBCBCPush f₀ b₀ f₁ b₁ h_sq (weilEtaleTorsionSheaf X₀ m₀) d_rel β →
        CategoryTheory.IsIso
          ((((weilEtaleSitePullback b₀).sheafAdjunctionContinuous
            AddCommGrpCat.{u} S₀.smallEtaleTopology S₁.smallEtaleTopology).homEquiv _ _).symm β) →
        ∃ γ, WeilIsSingDevAlgBCConstPush f₀ b₀ f₁ b₁ h_sq Λ d_rel γ ∧
          CategoryTheory.IsIso
            ((((weilEtaleSitePullback b₀).sheafAdjunctionContinuous
              AddCommGrpCat.{u} S₀.smallEtaleTopology S₁.smallEtaleTopology).homEquiv _ _).symm γ)) := by
    intro X₀ S₀ S₁ X₁ f₀ b₀ f₁ b₁ h_sq
    let pf_b := (weilEtaleSitePullback b₀).sheafPushforwardContinuous
      AddCommGrpCat.{u} S₀.smallEtaleTopology S₁.smallEtaleTopology
    let adj_b := (weilEtaleSitePullback b₀).sheafAdjunctionContinuous
      AddCommGrpCat.{u} S₀.smallEtaleTopology S₁.smallEtaleTopology
    let c_Λ := weilEtaleConstPullbackHom b₁
      (weilEtaleIdTerminalIsTerminal.{u} X₁)
      (weilEtaleIdTerminalIsTerminal.{u} X₀) Λ
    have _ : CategoryTheory.IsIso c_Λ := (hSys b₁).hConstIso _ _ Λ
    let c_iso := CategoryTheory.asIso c_Λ
    let r_hom := weilEtaleHigherDirectImageMap f₁ d_rel c_Λ
    let r_inv := weilEtaleHigherDirectImageMap f₁ d_rel c_iso.inv
    have hr_hom_inv : r_hom ≫ r_inv = 𝟙 _ :=
      ((hBCBase.2.1 f₁ d_rel).2.1 c_Λ c_iso.inv).symm.trans
        ((congrArg (weilEtaleHigherDirectImageMap f₁ d_rel) c_iso.hom_inv_id).trans
          ((hBCBase.2.1 f₁ d_rel).1 _))
    have hr_inv_hom : r_inv ≫ r_hom = 𝟙 _ :=
      ((hBCBase.2.1 f₁ d_rel).2.1 c_iso.inv c_Λ).symm.trans
        ((congrArg (weilEtaleHigherDirectImageMap f₁ d_rel) c_iso.inv_hom_id).trans
          ((hBCBase.2.1 f₁ d_rel).1 _))
    have _ : CategoryTheory.IsIso r_hom := ⟨⟨r_inv, hr_hom_inv, hr_inv_hom⟩⟩
    obtain ⟨β₀, hβ₀⟩ := ((hBCBase.2.2.1 f₀ b₀ f₁ b₁ h_sq).1 (weilEtaleTorsionSheaf X₀ m₀) d_rel).1
    refine ⟨⟨β₀ ≫ pf_b.map r_hom, β₀, hβ₀, rfl⟩, ?_⟩
    intro β hβ hIso_β
    let γ := β ≫ pf_b.map r_hom
    let m_β := (adj_b.homEquiv _ _).symm β
    have _ : CategoryTheory.IsIso m_β := hIso_β
    have hmate_γ : (adj_b.homEquiv _ _).symm γ = m_β ≫ r_hom := by
      apply (adj_b.homEquiv _ _).injective
      rw [(adj_b.homEquiv _ _).apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_unit, pf_b.map_comp,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Adjunction.homEquiv_unit,
        (adj_b.homEquiv _ _).apply_symm_apply]
    have _ : CategoryTheory.IsIso (m_β ≫ r_hom) := CategoryTheory.IsIso.comp_isIso
    exact ⟨γ, ⟨β, hβ, rfl⟩, hmate_γ.symm ▸ inferInstance⟩

  obtain ⟨β_h, hβ_h⟩ :=
    ((hBCBase.2.2.1 f_bar.left h_gal f_gal g'_gal hPb_gal_sq.w).1
      (weilEtaleTorsionSheaf Z_bar.left m₀) d_rel).1
  have hIso_βh : CategoryTheory.IsIso
      ((((weilEtaleSitePullback h_gal).sheafAdjunctionContinuous
        AddCommGrpCat.{u} P_sch.smallEtaleTopology V_gal.smallEtaleTopology).homEquiv _ _).symm β_h) :=
    hBCPullPrimePower ℓ f_bar.left h_gal f_gal g'_gal hPb_gal_sq.w
      (fun q _ hbc₀ => hPBC_k k ℓ hℓ_k Z_bar (weilProjectiveSpaceOver k 1) f_bar
        h_gal f_gal g'_gal hPb_gal_sq (weilEtaleTorsionSheaf Z_bar.left (ℓ ^ 1)) hTor_1 q hbc₀)
      r' d_rel hβ_h
  obtain ⟨γ_h, hγ_h, hIso_γh⟩ :=
    (hUpgrade f_bar.left h_gal f_gal g'_gal hPb_gal_sq.w).2 hβ_h hIso_βh

  obtain ⟨β_η, hβ_η⟩ :=
    ((hBCBase.2.2.1 f_bar.left η_bar f_Ω g'_Ω hPb_Ω_sq.w).1
      (weilEtaleTorsionSheaf Z_bar.left m₀) d_rel).1
  have hIso_βη : CategoryTheory.IsIso
      ((((weilEtaleSitePullback η_bar).sheafAdjunctionContinuous
        AddCommGrpCat.{u} P_sch.smallEtaleTopology S_Ω.smallEtaleTopology).homEquiv _ _).symm β_η) :=
    hBCPullPrimePower ℓ f_bar.left η_bar f_Ω g'_Ω hPb_Ω_sq.w
      (fun q _ hbc₀ => hPBC_k k ℓ hℓ_k Z_bar (weilProjectiveSpaceOver k 1) f_bar
        η_bar f_Ω g'_Ω hPb_Ω_sq (weilEtaleTorsionSheaf Z_bar.left (ℓ ^ 1)) hTor_1 q hbc₀)
      r' d_rel hβ_η
  obtain ⟨γ_η, hγ_η, hIso_γη⟩ :=
    (hUpgrade f_bar.left η_bar f_Ω g'_Ω hPb_Ω_sq.w).2 hβ_η hIso_βη

  obtain ⟨γ_w, hγ_w⟩ := (hUpgrade f_gal w_Ω f_Ω ι_Ω h_sq_w).1
  have hPaste_w :=
    hPastePkg.1 f_bar.left h_gal f_gal g'_gal w_Ω f_Ω ι_Ω η_bar g'_Ω
      hPb_gal_sq.w h_sq_w hw_η hι_fst hPb_Ω_sq.w Λ d_rel hγ_h hγ_w hγ_η
  have hIso_γw : CategoryTheory.IsIso
      ((((weilEtaleSitePullback w_Ω).sheafAdjunctionContinuous
        AddCommGrpCat.{u} V_gal.smallEtaleTopology S_Ω.smallEtaleTopology).homEquiv
        ℛ_gal ℛ_Ω).symm γ_w) :=
    h_s11_mate h_gal w_Ω η_bar hw_η ℛ_P ℛ_gal ℛ_Ω γ_h γ_w γ_η hPaste_w hIso_γh hIso_γη

  let T_V := weilEtaleIdTerminal.{u} V_gal
  let hT_V := weilEtaleIdTerminalIsTerminal.{u} V_gal
  let T_Ω := weilEtaleIdTerminal.{u} S_Ω
  let hT_Ω := weilEtaleIdTerminalIsTerminal.{u} S_Ω
  let δ_h : Quiver.Hom T_V ((weilEtaleSitePullback h_gal).obj E_P) :=
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift (𝟙 V_gal) (𝟙 V_gal) rfl)
      (CategoryTheory.Limits.pullback.lift_snd (𝟙 V_gal) (𝟙 V_gal) rfl)
      trivial
  obtain ⟨hConst_gal, hBij_Ψ⟩ :=
    h_s10 h_gal hh_gal A₀ ℛ_P ℛ_gal hPB_gal γ_h hIso_γh

  obtain ⟨hT_Bw⟩ := hBCBase.1 w_Ω hT_V
  let σ_w : Quiver.Hom T_Ω ((weilEtaleSitePullback w_Ω).obj T_V) := hT_Bw.from T_Ω
  have hUnitBij_w :=
    (weil_outer_tr_fib_algClosed_spec_edge_and_const_eval_bijective Ω).2
      V_gal w_Ω T_V hT_V hT_Bw A₀
  have hBij_eval :=
    h_s11_eval w_Ω T_V T_Ω hT_Ω hT_Bw A₀ ℛ_gal ℛ_Ω hConst_gal hUnitBij_w γ_w σ_w hIso_γw

  have h_sw_comm : w_Ω ≫ E_P.hom = 𝟙 S_Ω ≫ η_bar :=
    hw_η.trans (CategoryTheory.Category.id_comp η_bar).symm
  let s_w : Quiver.Hom T_Ω ((weilEtaleSitePullback η_bar).obj E_P) :=
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift w_Ω (𝟙 S_Ω) h_sw_comm)
      (CategoryTheory.Limits.pullback.lift_snd w_Ω (𝟙 S_Ω) h_sw_comm)
      trivial
  let Φ_Ω : ↑(ℛ_P.obj.obj (Opposite.op E_P)) → ↑(ℛ_Ω.obj.obj (Opposite.op T_Ω)) :=
    fun z => (ℛ_Ω.obj.map (Opposite.op s_w)).hom ((γ_η.hom.app (Opposite.op E_P)).hom z)
  have hs_w_fst : s_w.left ≫ CategoryTheory.Limits.pullback.fst E_P.hom η_bar =
      w_Ω ≫ (δ_h.left ≫ CategoryTheory.Limits.pullback.fst E_P.hom h_gal) :=
    (CategoryTheory.Limits.pullback.lift_fst w_Ω (𝟙 S_Ω) h_sw_comm).trans
      ((CategoryTheory.Category.comp_id w_Ω).symm.trans
        (congrArg (w_Ω ≫ ·)
          (CategoryTheory.Limits.pullback.lift_fst (𝟙 V_gal) (𝟙 V_gal) rfl).symm))
  have hΦ_factor : ∀ z : ↑(ℛ_P.obj.obj (Opposite.op E_P)),
      Φ_Ω z =
        (((ℛ_Ω.obj.map (Opposite.op σ_w)).hom).comp ((γ_w.hom.app (Opposite.op T_V)).hom))
          ((((ℛ_gal.obj.map (Opposite.op δ_h)).hom).comp
            ((γ_h.hom.app (Opposite.op E_P)).hom)) z) :=
    fun z => h_s12_prism w_Ω h_gal η_bar hw_η E_P σ_w δ_h s_w hs_w_fst
      ℛ_P ℛ_gal ℛ_Ω γ_h γ_w γ_η hPaste_w z
  have hInj_Φ : Function.Injective Φ_Ω := by
    intro a b hab
    have hab' := (hΦ_factor a).symm.trans (hab.trans (hΦ_factor b))
    exact hBij_Ψ.1 (hBij_eval.1 hab')

  let v_τ : S_Ω ⟶ S_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom)
  have hv_η : v_τ ≫ η_bar = η_bar := by
    rw [← hw_η, ← CategoryTheory.Category.assoc, hτ_w, CategoryTheory.Category.assoc, hu_h]
  have hα_comm : g'_Ω ≫ f_bar.left = (f_Ω ≫ v_τ) ≫ η_bar := by
    rw [CategoryTheory.Category.assoc, hv_η]
    exact CategoryTheory.Limits.pullback.condition
  let α_τ_bar : Z_Ω ⟶ Z_Ω :=
    CategoryTheory.Limits.pullback.lift g'_Ω (f_Ω ≫ v_τ) hα_comm
  have hα_fst : α_τ_bar ≫ g'_Ω = g'_Ω :=
    CategoryTheory.Limits.pullback.lift_fst g'_Ω (f_Ω ≫ v_τ) hα_comm
  have hα_snd : α_τ_bar ≫ f_Ω = f_Ω ≫ v_τ :=
    CategoryTheory.Limits.pullback.lift_snd g'_Ω (f_Ω ≫ v_τ) hα_comm

  obtain ⟨γ_v, hγ_v⟩ := (hUpgrade f_Ω v_τ f_Ω α_τ_bar hα_snd).1
  have hPaste_τ :=
    hPastePkg.1 f_bar.left η_bar f_Ω g'_Ω v_τ f_Ω α_τ_bar η_bar g'_Ω
      hPb_Ω_sq.w hα_snd hv_η hα_fst hPb_Ω_sq.w Λ d_rel hγ_η hγ_v hγ_η

  let B_η := weilEtaleSitePullback η_bar
  let s₂_τ : Quiver.Hom T_Ω (B_η.obj E_P) := s_w ≫ B_η.map ū_P
  have hū_left : ū_P.left = u := hū
  have hBη_map : (B_η.map ū_P).left =
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst E_P.hom η_bar ≫ ū_P.left)
        (CategoryTheory.Limits.pullback.snd E_P.hom η_bar)
        ((CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.Limits.pullback.fst E_P.hom η_bar ≫ ·)
            (CategoryTheory.MorphismProperty.Over.w ū_P)).trans
            CategoryTheory.Limits.pullback.condition)) :=
    CategoryTheory.MorphismProperty.Over.pullback_map_left (@AlgebraicGeometry.Etale) ⊤ η_bar ū_P
  have hs₂_τ_fst : s₂_τ.left ≫ CategoryTheory.Limits.pullback.fst E_P.hom η_bar =
      v_τ ≫ (s_w.left ≫ CategoryTheory.Limits.pullback.fst E_P.hom η_bar) := by
    have hmap_fst : (B_η.map ū_P).left ≫ CategoryTheory.Limits.pullback.fst E_P.hom η_bar =
        CategoryTheory.Limits.pullback.fst E_P.hom η_bar ≫ ū_P.left :=
      (congrArg (· ≫ CategoryTheory.Limits.pullback.fst E_P.hom η_bar) hBη_map).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have hsw_fst : s_w.left ≫ CategoryTheory.Limits.pullback.fst E_P.hom η_bar = w_Ω :=
      CategoryTheory.Limits.pullback.lift_fst w_Ω (𝟙 S_Ω) h_sw_comm
    exact (CategoryTheory.Category.assoc s_w.left _ _).trans
      ((congrArg (s_w.left ≫ ·) hmap_fst).trans
        ((CategoryTheory.Category.assoc s_w.left _ ū_P.left).symm.trans
          (((congrArg (· ≫ ū_P.left) hsw_fst).trans (congrArg (w_Ω ≫ ·) hū_left)).trans
            (hτ_w.symm.trans (congrArg (v_τ ≫ ·) hsw_fst.symm)))))

  have hnat_ū : ℛ_P.obj.map (Opposite.op ū_P) ≫ γ_η.hom.app (Opposite.op E_P) =
      γ_η.hom.app (Opposite.op E_P) ≫ ℛ_Ω.obj.map (Opposite.op (B_η.map ū_P)) :=
    γ_η.hom.naturality (Opposite.op ū_P)
  have hΦ_ū_step1 : Φ_Ω ((ℛ_P.obj.map (Opposite.op ū_P)).hom x) =
      (ℛ_Ω.obj.map (Opposite.op s₂_τ)).hom ((γ_η.hom.app (Opposite.op E_P)).hom x) := by
    have hmor : (ℛ_P.obj.map (Opposite.op ū_P) ≫ γ_η.hom.app (Opposite.op E_P)) ≫
        ℛ_Ω.obj.map (Opposite.op s_w) =
        γ_η.hom.app (Opposite.op E_P) ≫ ℛ_Ω.obj.map (Opposite.op s₂_τ) :=
      (congrArg (· ≫ ℛ_Ω.obj.map (Opposite.op s_w)) hnat_ū).trans
        ((CategoryTheory.Category.assoc _ _ _).trans
          (congrArg (γ_η.hom.app (Opposite.op E_P) ≫ ·)
            (ℛ_Ω.obj.map_comp _ _).symm))
    exact congrArg (fun f => f.hom x) hmor

  obtain ⟨hT_Bv⟩ := hBCBase.1 v_τ hT_Ω
  let σ_v : Quiver.Hom T_Ω ((weilEtaleSitePullback v_τ).obj T_Ω) := hT_Bv.from T_Ω
  have hΦ_ū_step2 : (ℛ_Ω.obj.map (Opposite.op s₂_τ)).hom
      ((γ_η.hom.app (Opposite.op E_P)).hom x) =
      (ℛ_Ω.obj.map (Opposite.op σ_v)).hom
        ((γ_v.hom.app (Opposite.op T_Ω)).hom (Φ_Ω x)) :=
    h_s12_prism v_τ η_bar η_bar hv_η E_P σ_v s_w s₂_τ hs₂_τ_fst
      ℛ_P ℛ_Ω ℛ_Ω γ_η γ_v γ_η hPaste_τ x

  obtain ⟨hT_ZΩ⟩ := hBCBase.1 f_Ω hT_Ω
  obtain ⟨y_coh, hy_coh⟩ :=
    (hSpecEdgeBij Ω f_Ω T_Ω hT_Ω hT_ZΩ (weilEtaleTorsionSheaf Z_Ω m₀) d_rel).2 (Φ_Ω x)
  obtain ⟨p_τ_bar, hp_τ⟩ := weil_etale_torsion_pullback_functoriality.1 α_τ_bar m₀ d_rel
  have hp_τ_id : p_τ_bar y_coh = y_coh :=
    hFibTriv α_τ_bar hα_fst hα_snd p_τ_bar hp_τ y_coh
  have hP3 :=
    hPastePkg.2.2 f_Ω v_τ f_Ω α_τ_bar hα_snd T_Ω hT_Ω hT_ZΩ T_Ω hT_Ω hT_ZΩ σ_v
      m₀ d_rel hγ_v hp_τ y_coh
  have hΦ_ū_eq : Φ_Ω ((ℛ_P.obj.map (Opposite.op ū_P)).hom x) = Φ_Ω x := by
    have hstep3 : (ℛ_Ω.obj.map (Opposite.op σ_v)).hom
        ((γ_v.hom.app (Opposite.op T_Ω)).hom (Φ_Ω x)) = Φ_Ω x := by
      rw [← hy_coh]
      exact hP3.trans ((congrArg
        (weilOuterTrFibEdgeHom f_Ω T_Ω hT_ZΩ (weilEtaleTorsionSheaf Z_Ω m₀) d_rel) hp_τ_id))
    exact hΦ_ū_step1.trans (hΦ_ū_step2.trans hstep3)
  exact hInj_Φ hΦ_ū_eq

theorem weil_net_p2_etale_slice_and_galois_torsor_const_descent (S V_Sigma V_open V_gal : AlgebraicGeometry.Scheme.{u})
    [ConnectedSpace ↥V_open] [Nonempty ↥V_open]
    [ConnectedSpace ↥V_gal] [Nonempty ↥V_gal]
    (h_Sigma : V_Sigma ⟶ S) [AlgebraicGeometry.Etale h_Sigma]
    (j_open : V_open ⟶ V_Sigma) [AlgebraicGeometry.Etale j_open]
    (q_gal : V_gal ⟶ V_open) [AlgebraicGeometry.Etale q_gal]
    (hq_surj : AlgebraicGeometry.Surjective q_gal)
    (ℱ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
    (ℋ_Sigma : CategoryTheory.Sheaf V_Sigma.smallEtaleTopology AddCommGrpCat.{u})
    (hPB_Sigma : WeilIsEtaleSheafPullback h_Sigma ℱ ℋ_Sigma)
    (A₀ : AddCommGrpCat.{u}) [Finite ↥A₀]
    (hPB_gal_Sigma : WeilIsEtaleSheafPullback (q_gal ≫ j_open) ℋ_Sigma
      ((CategoryTheory.constantSheaf V_gal.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (Γ : Type u) (act : Γ → (V_gal ⟶ V_gal))
    (hact_q : ∀ γ : Γ, act γ ≫ q_gal = q_gal)
    (δ : Γ → (V_gal ⟶ CategoryTheory.Limits.pullback q_gal q_gal))
    (hδ_fst : ∀ γ : Γ, δ γ ≫ CategoryTheory.Limits.pullback.fst q_gal q_gal = 𝟙 V_gal)
    (hδ_snd : ∀ γ : Γ, δ γ ≫ CategoryTheory.Limits.pullback.snd q_gal q_gal = act γ)
    (hδ_et : ∀ γ : Γ, AlgebraicGeometry.Etale (δ γ))
    (hδ_cov : (⋃ γ : Γ, Set.range (δ γ).base) = Set.univ)
    (hDeckTriv :
      let hh_gal : AlgebraicGeometry.Etale (q_gal ≫ j_open ≫ h_Sigma) := inferInstance
      let E_P : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (q_gal ≫ j_open ≫ h_Sigma) hh_gal
      ∀ (γ : Γ) (ū_P : E_P ⟶ E_P),
        ((AlgebraicGeometry.Scheme.Etale.forget S).map ū_P).left = act γ →
        ∀ x : ↑(ℱ.obj.obj (Opposite.op E_P)),
          (ℱ.obj.map (Opposite.op ū_P)).hom x = x) :
    ∃ (A_open : AddCommGrpCat.{u}),
      Finite ↥A_open ∧
      WeilIsEtaleSheafPullback j_open ℋ_Sigma
        ((CategoryTheory.constantSheaf V_open.smallEtaleTopology AddCommGrpCat.{u}).obj A_open) :=
by
  let P_Et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  have : P_Et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
