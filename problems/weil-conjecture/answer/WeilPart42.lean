    have hRegPow :
        ∀ {R : Type u} [CommRing R] {u_el : R},
          (∀ z : R, u_el * z = 0 → z = 0) →
          ∀ (n : ℕ) (z : R), u_el ^ n * z = 0 → z = 0 := by
      intro R _ u_el hu_reg n
      induction n with
      | zero =>
        intro z hz
        simpa only [pow_zero, one_mul] using hz
      | succ n ih =>
        intro z hz
        rw [pow_succ', mul_assoc] at hz
        exact ih z (hu_reg _ hz)

    have hConductor :
        ∀ (R : Type u) [CommRing R] (u_el b : R) (m : ℕ),
          (∀ z : R, u_el * z = 0 → z = 0) →
          (∀ (𝔪 : Ideal R) [𝔪.IsPrime], 𝔪.IsMaximal → IsDomain (Localization.AtPrime 𝔪)) →
          b * (b - u_el ^ m) = 0 →
          ∃ e : R, e * e = e ∧ b = e * u_el ^ m := by
      intro R _ u_el b m hu_reg hLocDom hb_eq
      let J_cond : Ideal R :=
        { carrier := { r : R | ∃ q : R, r * b = q * u_el ^ m }
          zero_mem' := ⟨0, by simp⟩
          add_mem' := by
            rintro r₁ r₂ ⟨q₁, h₁⟩ ⟨q₂, h₂⟩
            exact ⟨q₁ + q₂, by rw [add_mul, h₁, h₂, ← add_mul]⟩
          smul_mem' := by
            rintro c₀ r ⟨q, h⟩
            exact ⟨c₀ * q, by simp only [smul_eq_mul]; rw [mul_assoc, h, ← mul_assoc]⟩ }
