            ℓ x * (δ y (b j) * ℓ (bDual j)) + δ x (y * b j) * ℓ (bDual j) =
              δ (x * y) (b j) * ℓ (bDual j) + δ x y * (ℓ (b j) * ℓ (bDual j)) := by
          intro j; dsimp [δ]; rw [mul_assoc x y (b j)]; ring
