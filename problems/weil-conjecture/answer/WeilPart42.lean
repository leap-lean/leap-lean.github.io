      have heq : γ.toRingHom.comp i_L = i_L := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors B₀)
        apply RingHom.ext
        intro b
        have hb : i_L (algebraMap B₀ L₀ b) = β_B0 b := RingHom.congr_fun hi_B0 b
        change γ (i_L (algebraMap B₀ L₀ b)) = i_L (algebraMap B₀ L₀ b)
        rw [hb, hγ_B0 b]
      intro z
      exact RingHom.congr_fun heq z
