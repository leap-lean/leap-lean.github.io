  obtain ⟨hChartPrime, hBdryDisj, hSmLin⟩ := hs3
  intro d_Sigma H_Sigma F_disc_hom P₀ P₁ P₂ L₂
    _ _ _ _hd_Sigma hP₀_mon hSm_HSigma hCharts_Sigma hDisj_T0
    hEtale_3charts hLocFree_3charts hInj_φ hFin_B₂
    c hc_ne0 hPc_ne
  letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
  intro B₂_c I_hc uc_bar
