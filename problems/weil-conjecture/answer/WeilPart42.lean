                      (u_σ (M_w'.map v.unop) (π_V V₁.unop) ≫ κ_inv V₁.unop)
                      (κ_inv V₂.unop ≫ v.unop)
                      ((Category.comp_id _).trans (Category.id_comp _).symm)).symm }
              invFun := fun ψ =>
                { app := fun Z₀ =>
                    CategoryTheory.Limits.Sigma.desc (fun σ : Z₀.unop ⟶ W_u =>
                      ψ.app (Opposite.op (Z_σ Z₀.unop σ)) ≫ Q.map (lam_σ Z₀.unop σ).op)
                  naturality := fun {Z₁ Z₂} f => by
                    apply CategoryTheory.Limits.Sigma.hom_ext
                    intro σ
                    dsimp [L_pre]
                    rw [CategoryTheory.Limits.Sigma.ι_comp_desc_assoc, Category.assoc,
                      CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
                      ← Category.assoc, ψ.naturality (u_σ f.unop σ).op]
                    dsimp
                    rw [Category.assoc, Category.assoc, ← Q.map_comp, ← Q.map_comp,
