        (β_n.comp (θ_n_inv.toAddMonoidHom.comp ev_ℛ.symm.toAddMonoidHom)))
  refine ⟨ι_trans, ?_, ?_⟩
  · exact e_η_inv.injective.comp
      (EX₂.injective.comp (hβ_inj.comp (θ_n_inv.injective.comp ev_ℛ.symm.injective)))
  · intro s
    obtain ⟨z₀, hz₀⟩ : ∃ z₀ : ℛ.H 0, ev_ℛ.symm s = z₀ := ⟨ev_ℛ.symm s, rfl⟩
    have hsec_eq : ev_ℛ.symm
        ((ℛ.obj.map (Opposite.op σ_g)).hom ((γ.hom.app (Opposite.op T_X)).hom s)) =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g z₀) (Nat.zero_add 0)).comp
