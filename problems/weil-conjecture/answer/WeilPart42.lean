    let b_R : Module.Basis (Fin r) R_loc B := Module.Basis.mk he_LI hspan_e.ge
    have hLI_K : LinearIndependent K_loc (fun i : Fin r => (b_R i : L_loc)) := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
