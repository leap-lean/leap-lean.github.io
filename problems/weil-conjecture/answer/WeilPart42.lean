        have h_id : (e_k1.inv.hom.app (Opposite.op T_X)).hom
            (((e_k1.hom.hom.app (Opposite.op T_X)).hom)
              (weilOuterTrFibEdgeHom u T_X hT_U Q (k + 1) z')) =
            weilOuterTrFibEdgeHom u T_X hT_U Q (k + 1) z' := by
          change (((e_k1.hom ≫ e_k1.inv).hom.app (Opposite.op T_X)).hom)
            (weilOuterTrFibEdgeHom u T_X hT_U Q (k + 1) z') = _
