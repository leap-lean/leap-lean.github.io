                _ = ((b * ϖ_B ^ (n * (e - 1)) : ↥B'_p) : L'_2) := by simp [hϖ_B_coe]
            rw [h_eq]
            exact (b * ϖ_B ^ (n * (e - 1))).2
          rcases (hIntCrit (x.1 * f_L₂ ^ n)).mp hInt_xf with ⟨y, g, hg_ev, hy_eq⟩
          refine ⟨(algebraMap ↥B₂_0 (Localization.Away f_B₂) y *
            (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) ^ n,
            ⟨α₀ g, g, hg_ev, rfl⟩), ?_⟩
          apply Subtype.ext
          change C_pf.subtype (x * algebraMap (Localization.Away f_B₂) ↥C_pf (α₀ g)) =
            C_pf.subtype (algebraMap (Localization.Away f_B₂) ↥C_pf
