        obtain ⟨⟨y, s⟩, hms⟩ := IsLocalization.surj 𝔭₁.primeCompl m
        dsimp only at hms
        have hy_max : algebraMap R_loc R₁ y ∈ IsLocalRing.maximalIdeal R₁ := by
          rw [← hms]; exact Ideal.mul_mem_right _ _ hm
        have hy_p1 : y ∈ 𝔭₁ := (hmem_max_R₁ y).mpr hy_max
        obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp ((h𝔭₁_iff y).mp hy_p1)
        refine ⟨IsLocalization.mk' R₁ c s, ?_⟩
        have hs_ne : algebraMap R_loc K_loc s.1 ≠ 0 := (h_units_p1 s).ne_zero
        have hms_K : φ₁ m * algebraMap R_loc K_loc s.1 = algebraMap R_loc K_loc y := by
          have h := congrArg φ₁ hms; rwa [map_mul, hφ₁_eq, hφ₁_eq] at h
        have hmk_K : φ₁ (IsLocalization.mk' R₁ c s) * algebraMap R_loc K_loc s.1 =
            algebraMap R_loc K_loc c := by
          have h := congrArg φ₁ (IsLocalization.mk'_spec' R₁ c s)
          rw [map_mul, hφ₁_eq, hφ₁_eq] at h; linear_combination h
        have hc_K : algebraMap R_loc K_loc y * algebraMap R_loc K_loc z =
            algebraMap R_loc K_loc Δ * algebraMap R_loc K_loc c := by
          rw [← map_mul, ← map_mul, hc]
        dsimp [u₁]; apply mul_right_cancel₀ hs_ne
        calc
          algebraMap R_loc K_loc z / algebraMap R_loc K_loc Δ * φ₁ m * algebraMap R_loc K_loc s.1 =
              algebraMap R_loc K_loc z / algebraMap R_loc K_loc Δ *
                (φ₁ m * algebraMap R_loc K_loc s.1) := by ring
          _ = (algebraMap R_loc K_loc y * algebraMap R_loc K_loc z) / algebraMap R_loc K_loc Δ := by
              rw [hms_K]; ring
          _ = algebraMap R_loc K_loc c := by rw [hc_K, mul_div_cancel_left₀ _ hΔ_K_ne]
          _ = φ₁ (IsLocalization.mk' R₁ c s) * algebraMap R_loc K_loc s.1 := hmk_K.symm
      letI : Algebra R₁ K_loc := φ₁.toAlgebra
      have hex_unit₁ : ∃ m₀ ∈ IsLocalRing.maximalIdeal R₁, ∃ v₀ : R₁,
          u₁ * φ₁ m₀ = φ₁ v₀ ∧ v₀ ∉ IsLocalRing.maximalIdeal R₁ := by
        by_contra h_all; push_neg at h_all
        let J₁ : Submodule R₁ K_loc :=
          Submodule.map (Algebra.linearMap R₁ K_loc) (IsLocalRing.maximalIdeal R₁)
        have hJ₁_fg : J₁.FG :=
          Submodule.FG.map _ (IsNoetherian.noetherian (IsLocalRing.maximalIdeal R₁))
        have hJ₁_ne : J₁ ≠ ⊥ := by
          intro hbot
          have hΔ_max₁ : algebraMap R_loc R₁ Δ ∈ IsLocalRing.maximalIdeal R₁ :=
            (hmem_max_R₁ Δ).mp hΔ_mem_p1
          have hΔ_J₁ : Algebra.linearMap R₁ K_loc (algebraMap R_loc R₁ Δ) ∈ J₁ :=
            Submodule.mem_map_of_mem hΔ_max₁
          rw [hbot, Submodule.mem_bot] at hΔ_J₁
          change φ₁ (algebraMap R_loc R₁ Δ) = 0 at hΔ_J₁
          rw [hφ₁_eq] at hΔ_J₁; exact hΔ_K_ne hΔ_J₁
        have hu₁_stab : ∀ x ∈ J₁, u₁ • x ∈ J₁ := by
          rintro _ ⟨m, hm, rfl⟩
          obtain ⟨v, hv⟩ := hu₁_mul_max m hm
          exact ⟨v, h_all m hm v hv, hv.symm⟩
        have hu₁_int : IsIntegral R₁ u₁ :=
          isIntegral_of_smul_mem_submodule J₁ hJ₁_ne hJ₁_fg u₁ hu₁_stab
        obtain ⟨P, hP_monic, hP_eval⟩ := hu₁_int
        let d := P.natDegree
        choose p_cf hp_cf using fun k : ℕ => IsLocalization.surj 𝔭₁.primeCompl (P.coeff k)
        let S : 𝔭₁.primeCompl := ∏ k ∈ Finset.range d, (p_cf k).2
        have hS_dvd : ∀ k ∈ Finset.range d, ∃ q_k : R_loc, S.1 = (p_cf k).2.1 * q_k := by
          intro k hk
          obtain ⟨q_sub, hq_sub⟩ := Finset.dvd_prod_of_mem (fun j => (p_cf j).2) hk
          exact ⟨q_sub.1, congrArg Subtype.val hq_sub⟩
        choose q_cf hq_cf using hS_dvd
        let c_R : ℕ → R_loc := fun k =>
          if hk : k ∈ Finset.range d then S.1 ^ (d - 1 - k) * ((p_cf k).1 * q_cf k hk) else 0
        let Q_R : Polynomial R_loc :=
          Polynomial.X ^ d + ∑ k ∈ Finset.range d, Polynomial.C (c_R k) * Polynomial.X ^ k
        have hQ_monic : Q_R.Monic := by
          apply Polynomial.monic_X_pow_add
          have hdeg_lt : ∀ m : ℕ, m ≤ d →
              (∑ k ∈ Finset.range m, Polynomial.C (c_R k) * Polynomial.X ^ k).degree <
                (d : WithBot ℕ) := by
            intro m hm
            induction m with
            | zero =>
              simp only [Finset.range_zero, Finset.sum_empty, Polynomial.degree_zero]
              exact WithBot.bot_lt_coe d
            | succ m ih =>
              rw [Finset.sum_range_succ]
              refine (Polynomial.degree_add_le _ _).trans_lt (max_lt (ih (Nat.le_of_succ_le hm)) ?_)
              exact (Polynomial.degree_C_mul_X_pow_le m (c_R m)).trans_lt (WithBot.coe_lt_coe.mpr hm)
          exact hdeg_lt d le_rfl
        have hP_sum : u₁ ^ d + ∑ k ∈ Finset.range d, φ₁ (P.coeff k) * u₁ ^ k = 0 := by
          have hev : Polynomial.eval₂ φ₁ u₁ P = 0 := hP_eval
          rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, hP_monic.coeff_natDegree,
            map_one, one_mul, add_comm] at hev
          exact hev
        have hQ_eval : Polynomial.aeval (algebraMap R_loc K_loc S.1 * u₁) Q_R = 0 := by
          dsimp [Q_R]
          rw [map_add, map_pow, Polynomial.aeval_X, map_sum]
          have hterm : ∀ k ∈ Finset.range d,
              (Polynomial.aeval (algebraMap R_loc K_loc S.1 * u₁))
                (Polynomial.C (c_R k) * Polynomial.X ^ k) =
                (algebraMap R_loc K_loc S.1) ^ d * (φ₁ (P.coeff k) * u₁ ^ k) := by
            intro k hk
            have hk_lt : k < d := Finset.mem_range.mp hk
            have hcoeff_S : φ₁ (P.coeff k) * algebraMap R_loc K_loc S.1 =
                algebraMap R_loc K_loc ((p_cf k).1 * q_cf k hk) := by
              have h1 := congrArg φ₁ (hp_cf k)
              rw [map_mul, hφ₁_eq, hφ₁_eq] at h1
              rw [hq_cf k hk, map_mul, ← mul_assoc, h1, map_mul]
            have hd_split : (algebraMap R_loc K_loc S.1) ^ d =
                (algebraMap R_loc K_loc S.1) ^ (d - 1 - k) *
                  algebraMap R_loc K_loc S.1 * (algebraMap R_loc K_loc S.1) ^ k := by
              rw [← pow_succ, ← pow_add]; congr 1; omega
            rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X]
            have hc_eq : algebraMap R_loc K_loc (c_R k) =
                (algebraMap R_loc K_loc S.1) ^ (d - 1 - k) *
                  algebraMap R_loc K_loc ((p_cf k).1 * q_cf k hk) := by
              dsimp [c_R]; rw [dif_pos hk, map_mul, map_pow]
            rw [hc_eq, ← hcoeff_S, mul_pow, hd_split]; ring
          rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, mul_pow, ← mul_add, hP_sum, mul_zero]
        have huS_int_R : IsIntegral R_loc (algebraMap R_loc K_loc S.1 * u₁) :=
          ⟨Q_R, hQ_monic, hQ_eval⟩
        obtain ⟨r_u, hr_u⟩ := IsIntegrallyClosed.isIntegral_iff.mp huS_int_R
        apply hu₁_not_range
        refine ⟨IsLocalization.mk' R₁ r_u S, ?_⟩
        have hs_ne : algebraMap R_loc K_loc S.1 ≠ 0 := (h_units_p1 S).ne_zero
        apply mul_right_cancel₀ hs_ne
        have hmk := congrArg φ₁ (IsLocalization.mk'_spec' R₁ r_u S)
        rw [map_mul, hφ₁_eq, hφ₁_eq] at hmk
        calc
          φ₁ (IsLocalization.mk' R₁ r_u S) * algebraMap R_loc K_loc S.1 =
              algebraMap R_loc K_loc r_u := by linear_combination hmk
          _ = u₁ * algebraMap R_loc K_loc S.1 := by rw [hr_u]; ring
      obtain ⟨m₀, hm₀_max, v₀, hv₀_eq, hv₀_not_max⟩ := hex_unit₁
      obtain ⟨uv₀, huv₀⟩ := IsLocalRing.notMem_maximalIdeal.mp hv₀_not_max
      let π₁ : R₁ := ↑(uv₀⁻¹) * m₀
      have hπ₁_max : π₁ ∈ IsLocalRing.maximalIdeal R₁ := Ideal.mul_mem_left _ _ hm₀_max
      have hu₁π₁ : u₁ * φ₁ π₁ = 1 := by
        dsimp [π₁]; rw [map_mul]
        have hinv : φ₁ ↑(uv₀⁻¹) * φ₁ v₀ = 1 := by rw [← huv₀, ← map_mul, Units.inv_mul, map_one]
        calc
          u₁ * (φ₁ ↑(uv₀⁻¹) * φ₁ m₀) = φ₁ ↑(uv₀⁻¹) * (u₁ * φ₁ m₀) := by ring
          _ = φ₁ ↑(uv₀⁻¹) * φ₁ v₀ := by rw [hv₀_eq]
          _ = 1 := hinv
      have hmax₁_prin_eq : IsLocalRing.maximalIdeal R₁ = Ideal.span {π₁} := by
        apply le_antisymm
        · intro m hm
          obtain ⟨v, hv⟩ := hu₁_mul_max m hm
          have hmv : m = v * π₁ := by
            apply hφ₁_inj; rw [map_mul]
            calc
              φ₁ m = φ₁ m * (u₁ * φ₁ π₁) := by rw [hu₁π₁, mul_one]
              _ = (u₁ * φ₁ m) * φ₁ π₁ := by ring
              _ = φ₁ v * φ₁ π₁ := by rw [hv]
          exact Ideal.mem_span_singleton.mpr ⟨v, by rw [hmv]; ring⟩
        · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπ₁_max)
      have hprime₁_bot : ∀ (P : Ideal R₁), P.IsPrime → P < IsLocalRing.maximalIdeal R₁ → P = ⊥ := by
        intro P hP hP_lt
        have hπ_not_P : π₁ ∉ P := fun hmem =>
          not_le_of_gt hP_lt (by rw [hmax₁_prin_eq]; exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem))
        apply eq_bot_iff.mpr
        intro x hx
        have hx_pow : ∀ k : ℕ, x ∈ (IsLocalRing.maximalIdeal R₁) ^ k := by
          intro k
          induction k with
          | zero => simp
          | succ k ih =>
            rw [hmax₁_prin_eq, Ideal.span_singleton_pow] at ih ⊢
            obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp ih
            have hy_P : y ∈ P := by
              rcases hP.mem_or_mem hx with hpow | hy
              · exact absurd (hP.mem_of_pow_mem k hpow) hπ_not_P
              · exact hy
            have hy_max : y ∈ Ideal.span {π₁} := by rw [← hmax₁_prin_eq]; exact hP_lt.le hy_P
            obtain ⟨y', rfl⟩ := Ideal.mem_span_singleton.mp hy_max
            exact Ideal.mem_span_singleton.mpr ⟨y', by ring⟩
        have hx_iInf : x ∈ ⨅ k : ℕ, (IsLocalRing.maximalIdeal R₁) ^ k := Ideal.mem_iInf.mpr hx_pow
        rwa [Ideal.iInf_pow_eq_bot_of_isLocalRing _
          (IsLocalRing.maximalIdeal.isMaximal R₁).ne_top] at hx_iInf
      have h𝔭₁_ne_max : 𝔭₁ ≠ IsLocalRing.maximalIdeal R_loc := by
        intro heq
        have hdisj_t1 : Disjoint (𝔭₁.primeCompl : Set R_loc) (Ideal.span {t₁} : Set R_loc) := by
          rw [Set.disjoint_left]; intro s hs hst1; apply hs; rw [heq, hmax]
          exact Ideal.span_mono (by simp) hst1
        let P_t1 : Ideal R₁ := (Ideal.span {t₁}).map (algebraMap R_loc R₁)
        have hPt1_prime : P_t1.IsPrime :=
          IsLocalization.isPrime_of_isPrime_disjoint 𝔭₁.primeCompl R₁ (Ideal.span {t₁}) ht₁_prime hdisj_t1
        have hPt1_le : P_t1 ≤ IsLocalRing.maximalIdeal R₁ := by
          rw [← Localization.AtPrime.map_eq_maximalIdeal]; refine Ideal.map_mono ?_
          rw [heq, hmax]; exact Ideal.span_mono (by simp)
        have hPt1_lt : P_t1 < IsLocalRing.maximalIdeal R₁ := by
          refine lt_of_le_of_ne hPt1_le ?_
          intro heq_max
          have ht2_mem_max : t₂ ∈ 𝔭₁ := by rw [heq, hmax]; exact Ideal.subset_span (by simp)
          have ht2_Pt1 : algebraMap R_loc R₁ t₂ ∈ P_t1 := by
            rw [heq_max]; exact (hmem_max_R₁ t₂).mp ht2_mem_max
          have ht2_under : t₂ ∈ Ideal.under R_loc (Ideal.map (algebraMap R_loc R₁) (Ideal.span {t₁})) := ht2_Pt1
          rw [IsLocalization.comap_map_of_isPrime_disjoint 𝔭₁.primeCompl R₁ ht₁_prime hdisj_t1] at ht2_under
          exact ht₂_not_mem ht2_under
        have hPt1_bot : P_t1 = ⊥ := hprime₁_bot P_t1 hPt1_prime hPt1_lt
        have ht1_Pt1 : algebraMap R_loc R₁ t₁ ∈ P_t1 := Ideal.mem_map_of_mem _ (Ideal.subset_span rfl)
        rw [hPt1_bot, Submodule.mem_bot] at ht1_Pt1
        exact ht₁_ne (IsLocalization.injective R₁ 𝔭₁.primeCompl_le_nonZeroDivisors
          (ht1_Pt1.trans (map_zero _).symm))
      have hR₁_not_field : ¬ IsField R₁ := by
        intro hF; letI : Field R₁ := hF.toField
        have hΔ_max₁ : algebraMap R_loc R₁ Δ ∈ IsLocalRing.maximalIdeal R₁ :=
          (hmem_max_R₁ Δ).mp hΔ_mem_p1
        have hΔ_ne₁ : algebraMap R_loc R₁ Δ ≠ 0 := fun h0 =>
