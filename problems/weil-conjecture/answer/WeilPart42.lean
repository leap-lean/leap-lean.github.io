    have he_mul : (e : ↥S_ϖ) * e_inv_S = 1 := by
      have he_eq : (e : ↥S_ϖ) = ψ (algebraMap k R'_p (e : k)) := by
        rw [map_natCast, map_natCast]
      rw [he_eq]
      dsimp [e_inv_S]
      rw [← map_mul, ← map_mul, mul_inv_cancel₀ he_ne, map_one, map_one]
    let f_C : ↥C_pf := ι_B₂C f_B₂
    have hα_pow : α_S ^ e = algebraMap ↥C_pf ↥S_ϖ f_C := by
      apply Subtype.ext
      change ϖ_L ^ e = algebraMap L₂ L'_2 (f_B₂ : L₂)
      rw [Subalgebra.coe_algebraMap B₂_0 f₀]
      exact hf_L'_eq.symm
    have hGen : ∀ z : ↥S_ϖ, ∃ (m : ℕ) (c : Fin m → ↥C_pf),
        z = ∑ j : Fin m, algebraMap ↥C_pf ↥S_ϖ (c j) * α_S ^ (j : ℕ) := by
      intro z
      have hk_mem : ∀ c : k, algebraMap R'_p L'_2 (algebraMap k R'_p c) ∈ S_ϖ := by
        intro c
        rw [← hψ_coe]
        exact (ψ (algebraMap k R'_p c)).2
      have hα1 : (algebraMap L₂ L'_2 (1 : L₂))⁻¹ * ϖ_L = ϖ_L := by
        rw [map_one, inv_one, one_mul]
      have hα1_mem : (algebraMap L₂ L'_2 (1 : L₂))⁻¹ * ϖ_L ∈ S_ϖ := by
        rw [hα1]; exact hϖ_S
      have hα1_inv_mem : ((algebraMap L₂ L'_2 (1 : L₂))⁻¹ * ϖ_L)⁻¹ ∈ S_ϖ := by
        rw [hα1]; exact hϖ_inv_S
      obtain ⟨m, c, hc_mem, hz_eq⟩ :=
        hKummerOrth 1 one_ne_zero S_ϖ hk_mem hσ_S hα1_mem hα1_inv_mem z.1 z.2
      refine ⟨m, fun j => ⟨c j, hc_mem j⟩, ?_⟩
      apply Subtype.ext
      change S_ϖ.subtype z =
        S_ϖ.subtype (∑ j : Fin m, algebraMap ↥C_pf ↥S_ϖ ⟨c j, hc_mem j⟩ * α_S ^ (j : ℕ))
      rw [map_sum]
      change z.1 = _
      rw [hz_eq]
      refine Finset.sum_congr rfl fun j _ => ?_
      simp only [map_mul, map_pow]
      change algebraMap L₂ L'_2 (c j) * ((algebraMap L₂ L'_2 1)⁻¹ * ϖ_L) ^ (j : ℕ) =
        algebraMap L₂ L'_2 (c j) * ϖ_L ^ (j : ℕ)
      rw [hα1]
    let D := KaehlerDifferential.D ↥C_pf ↥S_ϖ
    have hDα_ann : ((e : ↥S_ϖ) * α_S ^ (e - 1)) • D α_S = 0 := by
      have h1 := congrArg D hα_pow
      rw [Derivation.map_algebraMap, Derivation.leibniz_pow,
        ← Nat.cast_smul_eq_nsmul ↥S_ϖ e _, smul_smul] at h1
      exact h1
    have hDα : D α_S = 0 := by
      let u_S : ↥S_ϖ := e_inv_S * α_inv_S ^ (e - 1)
      have hu_mul : u_S * ((e : ↥S_ϖ) * α_S ^ (e - 1)) = 1 := by
        calc
          u_S * ((e : ↥S_ϖ) * α_S ^ (e - 1))
              = (e_inv_S * (e : ↥S_ϖ)) * (α_inv_S ^ (e - 1) * α_S ^ (e - 1)) := by
                dsimp [u_S]; ring
          _ = ((e : ↥S_ϖ) * e_inv_S) * ((α_S * α_inv_S) ^ (e - 1)) := by
                rw [mul_comm e_inv_S, ← mul_pow, mul_comm α_inv_S]
          _ = 1 := by rw [he_mul, hα_mul, one_pow, mul_one]
      calc
        D α_S = (1 : ↥S_ϖ) • D α_S := (one_smul _ _).symm
        _ = (u_S * ((e : ↥S_ϖ) * α_S ^ (e - 1))) • D α_S := by rw [hu_mul]
        _ = u_S • (((e : ↥S_ϖ) * α_S ^ (e - 1)) • D α_S) := mul_smul _ _ _
        _ = u_S • 0 := by rw [hDα_ann]
        _ = 0 := smul_zero _
    have hDz : ∀ z : ↥S_ϖ, D z = 0 := by
      intro z
      obtain ⟨m, c, rfl⟩ := hGen z
      rw [map_sum]
      refine Finset.sum_eq_zero fun j _ => ?_
      simp [Derivation.leibniz, Derivation.leibniz_pow, hDα]
    have hSub : Subsingleton Ω[↥S_ϖ⁄↥C_pf] := by
      apply subsingleton_of_forall_eq 0
      intro ω
      have hle : Submodule.span ↥S_ϖ (Set.range D) ≤ ⊥ := by
        rw [Submodule.span_le]
        rintro _ ⟨z, rfl⟩
        rw [hDz z]
        exact Submodule.zero_mem ⊥
      rw [KaehlerDifferential.span_range_derivation ↥C_pf ↥S_ϖ] at hle
      exact (Submodule.mem_bot (R := ↥S_ϖ)).mp (hle Submodule.mem_top)
    have _ : Algebra.FormallyUnramified ↥C_pf ↥S_ϖ := Algebra.FormallyUnramified.mk hSub
    exact RingHom.formallyUnramified_algebraMap.mpr inferInstance

  
  let φ₁ : A₀ →+* Localization.Away f₀ := algebraMap A₀ (Localization.Away f₀)
  have hφ₁_unram : φ₁.FormallyUnramified := by
    have _ : Algebra.FormallyUnramified A₀ (Localization.Away f₀) :=
      Algebra.FormallyUnramified.of_isLocalization (Submonoid.powers f₀)
    exact RingHom.formallyUnramified_algebraMap.mpr inferInstance
  let φ₂ : Localization.Away f₀ →+* Localization.Away f_B₂ :=
    Localization.awayMap (algebraMap A₀ ↥B₂_0) f₀
  have hφ₂_unram :
      @RingHom.FormallyUnramified (Localization.Away f₀) (Localization.Away f_B₂)
        inferInstance inferInstance φ₂ :=
    ((@RingHom.etale_iff_formallyUnramified_and_smooth
      (Localization.Away f₀) (Localization.Away f_B₂) inferInstance inferInstance φ₂).mp
      hEtale_away).1
  have hDiag : ψ.comp (algebraMap A₀ R'_p) = φ_CS.comp (φ_C.comp (φ₂.comp φ₁)) := by
    apply RingHom.ext
    intro a
    apply Subtype.ext
    have hmap : φ₂ (φ₁ a) =
        algebraMap ↥B₂_0 (Localization.Away f_B₂) (algebraMap A₀ ↥B₂_0 a) := by
      dsimp [φ₁, φ₂, Localization.awayMap, IsLocalization.Away.map]
      exact IsLocalization.map_eq _ a
    change (ψ (algebraMap A₀ R'_p a) : L'_2) = (φ_CS (φ_C (φ₂ (φ₁ a))) : L'_2)
    rw [hψ_coe, hCompat_apply, hmap, hφ_C_eq]
    change _ = algebraMap L₂ L'_2 (algebraMap A₀ ↥B₂_0 a : L₂)
    rw [Subalgebra.coe_algebraMap B₂_0 a]
  have hφ₁₂_unram :
      @RingHom.FormallyUnramified A₀ (Localization.Away f_B₂)
        inferInstance inferInstance (φ₂.comp φ₁) :=
    @RingHom.FormallyUnramified.comp A₀ (Localization.Away f₀) inferInstance inferInstance
      (Localization.Away f_B₂) inferInstance φ₁ φ₂ hφ₁_unram hφ₂_unram
  have hφ₁₂C_unram :
      @RingHom.FormallyUnramified A₀ ↥C_pf
        inferInstance inferInstance (φ_C.comp (φ₂.comp φ₁)) :=
    @RingHom.FormallyUnramified.comp A₀ (Localization.Away f_B₂) inferInstance inferInstance
      ↥C_pf inferInstance (φ₂.comp φ₁) φ_C hφ₁₂_unram hφ_C_unram
  have hComp_unram : (ψ.comp (algebraMap A₀ R'_p)).FormallyUnramified := by
    rw [hDiag]
    exact hφ₁₂C_unram.comp hφ_CS_unram
  have hψ_unram : ψ.FormallyUnramified :=
    RingHom.FormallyUnramified.of_comp hComp_unram
  have he_loc_unram :
      @RingHom.FormallyUnramified ↥S_ϖ (Localization.Away ϖ_B)
        inferInstance inferInstance e_loc.toRingHom :=
    @RingHom.FormallyUnramified.of_surjective ↥S_ϖ (Localization.Away ϖ_B)
      inferInstance inferInstance e_loc.toRingHom e_loc.surjective
  have hLoc_alg_unram :
      @RingHom.FormallyUnramified R'_p (Localization.Away ϖ_B)
        inferInstance inferInstance (algebraMap R'_p (Localization.Away ϖ_B)) := by
    rw [← he_loc_comp]
    exact @RingHom.FormallyUnramified.comp R'_p ↥S_ϖ inferInstance inferInstance
      (Localization.Away ϖ_B) inferInstance ψ e_loc.toRingHom hψ_unram he_loc_unram
  have _ : Algebra.FormallyUnramified R'_p (Localization.Away ϖ_B) :=
    RingHom.formallyUnramified_algebraMap.mp hLoc_alg_unram
  have hSubLocus : (PrimeSpectrum.basicOpen ϖ_B : Set (PrimeSpectrum ↥B'_p)) ⊆
      Algebra.unramifiedLocus R'_p ↥B'_p :=
    (Algebra.basicOpen_subset_unramifiedLocus_iff (R := R'_p) (A := ↥B'_p) (f := ϖ_B)).mpr
      inferInstance
  exact hSubLocus ((PrimeSpectrum.mem_basicOpen ϖ_B ⟨Q', inferInstance⟩).mpr hϖ_not_mem)

theorem weil_kummer_divisor_ramification_cancellation_unramified (k : Type u) [Field k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂]
      (f₀ : A₀),
      Irreducible f₀ →
      ∀ (p : Fin 2 → k),
        MvPolynomial.eval p f₀ = 0 →
        ∀ (e : ℕ), 1 ≤ e → (e : k) ≠ 0 →
          (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
           let B₂_0 := integralClosure A₀ L₂
           ∀ (𝔓_C : Ideal A₀) [𝔓_C.IsPrime]
             (Q_C : Ideal ↥B₂_0) [Q_C.IsPrime]
             (hOver : 𝔓_C = Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C),
             𝔓_C = Ideal.span {f₀} →
             IsDiscreteValuationRing (Localization.AtPrime Q_C) ∧
             (∃ (π_C : Localization.AtPrime Q_C) (u_C : (Localization.AtPrime Q_C)ˣ),
               π_C ≠ 0 ∧
               IsLocalRing.maximalIdeal (Localization.AtPrime Q_C) = Ideal.span {π_C} ∧
               algebraMap ↥B₂_0 (Localization.AtPrime Q_C) (algebraMap A₀ ↥B₂_0 f₀) =
                 (u_C : Localization.AtPrime Q_C) * π_C ^ e) ∧
             @Algebra.IsSeparable 𝔓_C.ResidueField Q_C.ResidueField _ _
               (Ideal.ResidueField.map 𝔓_C Q_C (algebraMap A₀ ↥B₂_0) hOver).toAlgebra) →
          ∀ (R'_p K'_2 L'_2 : Type u)
            [CommRing R'_p] [IsDomain R'_p] [IsNoetherianRing R'_p]
            [IsIntegrallyClosed R'_p] [IsLocalRing R'_p]
            [Field K'_2] [Algebra R'_p K'_2] [IsFractionRing R'_p K'_2]
            [Field L'_2] [Algebra K₂ L'_2] [Algebra L₂ L'_2] [IsScalarTower K₂ L₂ L'_2]
            [Algebra K'_2 L'_2] [FiniteDimensional K'_2 L'_2] [Algebra.IsSeparable K'_2 L'_2]
            [Algebra R'_p L'_2] [IsScalarTower R'_p K'_2 L'_2]
            [Algebra k R'_p] [Algebra A₀ R'_p] [IsScalarTower k A₀ R'_p]
            (ϖ : R'_p),
            ϖ ≠ 0 →
            ϖ ^ e = algebraMap A₀ R'_p f₀ →
            Ideal.comap (algebraMap A₀ R'_p) (Ideal.span {ϖ}) = Ideal.span {f₀} →
            (∀ (q' : Ideal R'_p) [q'.IsPrime],
               ϖ ∈ q' →
               q' ≠ IsLocalRing.maximalIdeal R'_p →
               q' = Ideal.span {ϖ}) →
            (algebraMap R'_p L'_2).comp (algebraMap A₀ R'_p) =
              (algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)) →
            (∀ r : R'_p, ∃ (g : A₀) (c : Fin e → A₀),
               MvPolynomial.eval p g ≠ 0 ∧
               r * algebraMap A₀ R'_p g =
                 ∑ i : Fin e, algebraMap A₀ R'_p (c i) * ϖ ^ (i : ℕ)) →
            (∀ (t : L₂), t ≠ 0 →
               ∀ (S : Subring L'_2),
                 (∀ c : k, algebraMap R'_p L'_2 (algebraMap k R'_p c) ∈ S) →
                 (∀ σ : L'_2 ≃ₐ[L₂] L'_2, ∀ z ∈ S, σ z ∈ S) →
                 let α : L'_2 := (algebraMap L₂ L'_2 t)⁻¹ * algebraMap R'_p L'_2 ϖ
                 α ∈ S → α⁻¹ ∈ S →
                 ∀ z ∈ S, ∃ (m : ℕ) (c : Fin m → L₂),
                   (∀ j : Fin m, algebraMap L₂ L'_2 (c j) ∈ S) ∧
                   z = ∑ j : Fin m, algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ)) →
            ∀ (Q' : Ideal ↥(integralClosure R'_p L'_2)) [Q'.IsPrime],
              algebraMap R'_p ↥(integralClosure R'_p L'_2) ϖ ∈ Q' →
              Ideal.comap (algebraMap R'_p ↥(integralClosure R'_p L'_2)) Q' ≠
                IsLocalRing.maximalIdeal R'_p →
              Algebra.IsUnramifiedAt R'_p Q' :=
by
  intro A₀ K₂ L₂ _ _ _ f₀ _hIrr_f₀ p hp_f₀ e he_pos he_ne hDivUnifSep
    R'_p K'_2 L'_2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ϖ
    _hϖ_ne hϖ_pow hComap_ϖ hHeight1_ϖ hTower_A₀ hExp_R' hKummerOrth
    Q' _ hϖ_mem hq'_ne_max

  have he_ne_zero : e ≠ 0 := Nat.one_le_iff_ne_zero.mp he_pos

  
  have hLocEmbed : ∀ (R₀ K₀ E₀ : Type u) [CommRing R₀] [IsDomain R₀]
      [Field K₀] [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
      [Field E₀] [Algebra K₀ E₀] [FiniteDimensional K₀ E₀]
      [Algebra R₀ E₀] [IsScalarTower R₀ K₀ E₀]
      (P : Ideal ↥(integralClosure R₀ E₀)) [P.IsPrime],
      let B₀ := integralClosure R₀ E₀
      let 𝒪_P := Localization.AtPrime P
      ∃ (j_P : 𝒪_P →+* E₀),
        Function.Injective j_P ∧
        (∀ b : ↥B₀, j_P (algebraMap ↥B₀ 𝒪_P b) = b.1) ∧
        IsDomain 𝒪_P ∧
        IsIntegrallyClosed 𝒪_P ∧
        @IsFractionRing 𝒪_P _ E₀ _ j_P.toAlgebra := by
    intro R₀ K₀ E₀ _ _ _ _ _ _ _ _ _ _ P _ B₀ 𝒪_P
    have _ : IsFractionRing ↥B₀ E₀ :=
      integralClosure.isFractionRing_of_finite_extension (A := R₀) K₀ E₀
    have _ : IsIntegrallyClosed ↥B₀ :=
      integralClosure.isIntegrallyClosedOfFiniteExtension (R := R₀) (L := E₀) K₀
    have _ : IsIntegrallyClosed 𝒪_P :=
      isIntegrallyClosed_of_isLocalization 𝒪_P P.primeCompl
        (Ideal.primeCompl_le_nonZeroDivisors P)
    have hUnits : ∀ s : P.primeCompl, IsUnit (algebraMap ↥B₀ E₀ s.1) := by
      intro s
      have hs_ne : (s.1 : ↥B₀) ≠ 0 := fun h0 => s.2 (h0 ▸ P.zero_mem)
      have hsE_ne : (s.1 : E₀) ≠ 0 := fun h0 => hs_ne (Subtype.ext h0)
      exact IsUnit.mk0 (algebraMap ↥B₀ E₀ s.1) hsE_ne
    let j_P : 𝒪_P →+* E₀ := IsLocalization.lift (M := P.primeCompl) hUnits
    have hj_P : ∀ b : ↥B₀, j_P (algebraMap ↥B₀ 𝒪_P b) = b.1 :=
      fun b => IsLocalization.lift_eq hUnits b
    have hj_inj : Function.Injective j_P := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj P.primeCompl z
      have hb0_E : (b : E₀) = 0 := by
        calc (b : E₀) = j_P (algebraMap ↥B₀ 𝒪_P b) := (hj_P b).symm
          _ = j_P (z * algebraMap ↥B₀ 𝒪_P s.1) := by rw [hbs]
          _ = j_P z * j_P (algebraMap ↥B₀ 𝒪_P s.1) := map_mul j_P _ _
          _ = 0 := by rw [hz, zero_mul]
      have hb0 : b = 0 := Subtype.ext hb0_E
      have hmul0 : z * algebraMap ↥B₀ 𝒪_P s.1 = 0 := by rw [hbs, hb0, map_zero]
      exact (IsLocalization.map_units 𝒪_P s).mul_left_eq_zero.mp hmul0
    have hDom_P : IsDomain 𝒪_P := Function.Injective.isDomain j_P hj_inj
    let _ : IsDomain 𝒪_P := hDom_P
    let _ : Algebra 𝒪_P E₀ := j_P.toAlgebra
    have hAlgB_inj : Function.Injective (algebraMap ↥B₀ 𝒪_P) :=
      IsLocalization.injective 𝒪_P (Ideal.primeCompl_le_nonZeroDivisors P)
    have hFrac_P : IsFractionRing 𝒪_P E₀ := by
      refine IsLocalization'.mk (Submonoid.IsLocalizationMap.mk ?_ ?_ ?_)
      · intro x
        have hx_ne : (x.1 : 𝒪_P) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp x.2
        have hjx_ne : j_P x.1 ≠ 0 := fun h0 => hx_ne (hj_inj (h0.trans (map_zero j_P).symm))
        exact IsUnit.mk0 (algebraMap 𝒪_P E₀ x.1) hjx_ne
      · intro y
        obtain ⟨⟨b₁, b₂⟩, hb⟩ := IsLocalization.surj (nonZeroDivisors ↥B₀) y
        have hb₂_ne : (b₂.1 : ↥B₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b₂.2
        have hb₂_loc_ne : algebraMap ↥B₀ 𝒪_P b₂.1 ≠ 0 :=
          (map_ne_zero_iff _ hAlgB_inj).mpr hb₂_ne
        refine ⟨(algebraMap ↥B₀ 𝒪_P b₁,
          ⟨algebraMap ↥B₀ 𝒪_P b₂.1, mem_nonZeroDivisors_of_ne_zero hb₂_loc_ne⟩), ?_⟩
        change y * j_P (algebraMap ↥B₀ 𝒪_P b₂.1) = j_P (algebraMap ↥B₀ 𝒪_P b₁)
        rw [hj_P, hj_P]
        exact hb
      · intro x₁ x₂ h_eq
        have hx12 : x₁ = x₂ := hj_inj h_eq
        exact ⟨1, by rw [hx12]⟩
    exact ⟨j_P, hj_inj, hj_P, hDom_P, inferInstance, hFrac_P⟩

  
  have hUnitRootUnram : ∀ (D L L' : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D]
      [Field L] [Algebra D L] [IsFractionRing D L]
      [Field L'] [Algebra L L'] [Algebra D L'] [IsScalarTower D L L'],
      IsUnit (e : D) →
      ∀ (π : D), π ≠ 0 →
        ∀ (u : Dˣ) (ϖ_L : L'),
          ϖ_L ^ e = algebraMap D L' ((u : D) * π ^ e) →
          (let C := integralClosure D L'
           let w : L' := (algebraMap D L' π)⁻¹ * ϖ_L
           (∀ σ : L' ≃ₐ[L] L', ∀ z ∈ C, σ z ∈ C) →
           w ∈ C → w⁻¹ ∈ C →
           ∀ z ∈ C, ∃ (m : ℕ) (c : Fin m → L),
             (∀ j : Fin m, algebraMap L L' (c j) ∈ C) ∧
             z = ∑ j : Fin m, algebraMap L L' (c j) * w ^ (j : ℕ)) →
          let C := integralClosure D L'
          let w : L' := (algebraMap D L' π)⁻¹ * ϖ_L
          (∃ u_w : (↥C)ˣ, ((u_w : ↥C) : L') = w ∧ ϖ_L = algebraMap D L' π * w) ∧
          Algebra.FiniteType D ↥C ∧
          Algebra.FormallyUnramified D ↥C := by
    intro D L L' _ _ _ _ _ _ _ _ _ _ he_unit π hπ_ne u ϖ_L hϖ_pow_D hKummer_C C w
    have hπ_L_ne : algebraMap D L π ≠ 0 :=
      (map_ne_zero_iff (algebraMap D L) (IsFractionRing.injective D L)).mpr hπ_ne
    have hπ_L'_ne : algebraMap D L' π ≠ 0 := by
      rw [IsScalarTower.algebraMap_apply D L L' π]
      exact (map_ne_zero_iff (algebraMap L L') (algebraMap L L').injective).mpr hπ_L_ne
    have hϖ_eq_πw : ϖ_L = algebraMap D L' π * w :=
      (mul_inv_cancel_left₀ hπ_L'_ne ϖ_L).symm
    have hw_pow : w ^ e = algebraMap D L' (u : D) := by
      have hπ_pow_ne : (algebraMap D L' π) ^ e ≠ 0 := pow_ne_zero e hπ_L'_ne
      calc w ^ e = ((algebraMap D L' π)⁻¹) ^ e * ϖ_L ^ e := mul_pow _ _ e
        _ = ((algebraMap D L' π) ^ e)⁻¹ * (algebraMap D L' (u : D) * (algebraMap D L' π) ^ e) := by
              rw [inv_pow, hϖ_pow_D, map_mul, map_pow]
        _ = ((algebraMap D L' π) ^ e)⁻¹ * ((algebraMap D L' π) ^ e * algebraMap D L' (u : D)) := by
              rw [mul_comm (algebraMap D L' (u : D))]
        _ = algebraMap D L' (u : D) := inv_mul_cancel_left₀ hπ_pow_ne _
    have hw_mem : w ∈ C := by
      refine ⟨Polynomial.X ^ e - Polynomial.C (u : D),
        Polynomial.monic_X_pow_sub_C (n := e) (u : D) he_ne_zero, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hw_pow, sub_self]
    let w_inv : L' := algebraMap D L' (↑u⁻¹ : D) * w ^ (e - 1)
    have hw_inv_mem : w_inv ∈ C :=
      C.mul_mem (C.algebraMap_mem _) (C.pow_mem hw_mem (e - 1))
    have hw_mul_inv : w * w_inv = 1 := by
      have h_exp : 1 + (e - 1) = e := by omega
      have hw_pow_split : w * w ^ (e - 1) = algebraMap D L' (u : D) := by
        calc w * w ^ (e - 1) = w ^ 1 * w ^ (e - 1) := by rw [pow_one]
          _ = w ^ (1 + (e - 1)) := (pow_add w 1 (e - 1)).symm
          _ = w ^ e := by rw [h_exp]
          _ = algebraMap D L' (u : D) := hw_pow
      calc w * w_inv
          = algebraMap D L' (↑u⁻¹ : D) * (w * w ^ (e - 1)) := by dsimp [w_inv]; ring
        _ = algebraMap D L' (↑u⁻¹ : D) * algebraMap D L' (u : D) := by rw [hw_pow_split]
        _ = algebraMap D L' ((↑u⁻¹ : D) * (u : D)) := (map_mul (algebraMap D L') _ _).symm
        _ = 1 := by rw [Units.inv_mul, map_one]
    have hw_inv_in_C : w⁻¹ ∈ C := (inv_eq_of_mul_eq_one_right hw_mul_inv) ▸ hw_inv_mem
    let u_w : (↥C)ˣ :=
      { val := ⟨w, hw_mem⟩
        inv := ⟨w_inv, hw_inv_mem⟩
        val_inv := Subtype.ext hw_mul_inv
        inv_val := Subtype.ext (by change w_inv * w = 1; rw [mul_comm, hw_mul_inv]) }
    have hGal_C : ∀ σ : L' ≃ₐ[L] L', ∀ z ∈ C, σ z ∈ C := by
      intro σ z hz
      rcases hz with ⟨P, hP_mon, hP_eval⟩
      refine ⟨P, hP_mon, ?_⟩
      have hcomm : σ.toRingHom.comp (algebraMap D L') = algebraMap D L' := by
        apply RingHom.ext
        intro d
        rw [RingHom.comp_apply, IsScalarTower.algebraMap_apply D L L' d]
        exact σ.commutes (algebraMap D L d)
      have h1 := Polynomial.hom_eval₂ P (algebraMap D L') σ.toRingHom z
      rw [hcomm, hP_eval, map_zero] at h1
      exact h1.symm
    have hAdjoin_C : Algebra.adjoin D ({(u_w : ↥C)} : Set ↥C) = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨m, c, hc_mem, hz_eq⟩ := hKummer_C hGal_C hw_mem hw_inv_in_C z.1 z.2
      have hc_desc : ∀ j : Fin m, ∃ d : D, algebraMap D L d = c j := by
        intro j
        have hc_int_L' : IsIntegral D (IsScalarTower.toAlgHom D L L' (c j)) := hc_mem j
        have hc_int_L : IsIntegral D (c j) :=
          (isIntegral_algHom_iff (IsScalarTower.toAlgHom D L L')
            (algebraMap L L').injective).mp hc_int_L'
        exact IsIntegrallyClosed.isIntegral_iff.mp hc_int_L
      choose d hd using hc_desc
      have hz_sub : z = ∑ j : Fin m, algebraMap D ↥C (d j) * (u_w : ↥C) ^ (j : ℕ) := by
        apply Subtype.ext
        change z.1 = C.val (∑ j : Fin m, algebraMap D ↥C (d j) * (u_w : ↥C) ^ (j : ℕ))
        rw [hz_eq, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, map_pow, ← hd j, ← IsScalarTower.algebraMap_apply D L L' (d j)]
        rfl
      rw [hz_sub]
      exact Subalgebra.sum_mem _ fun j _ =>
        Subalgebra.mul_mem _
          (Subalgebra.algebraMap_mem _ (d j))
          (Subalgebra.pow_mem _ (Algebra.self_mem_adjoin_singleton D (u_w : ↥C)) (j : ℕ))
    have hFT_C : Algebra.FiniteType D ↥C :=
      ⟨⟨{(u_w : ↥C)}, by simpa using hAdjoin_C⟩⟩
    have hFU_C : Algebra.FormallyUnramified D ↥C := by
      let δ := KaehlerDifferential.D D ↥C
      let x_w : ↥C := (u_w : ↥C)
      have hxw_pow : x_w ^ e = algebraMap D ↥C (u : D) := Subtype.ext hw_pow
      have hδ_pow : δ (x_w ^ e) = 0 := by
        rw [hxw_pow]
        exact Derivation.map_algebraMap δ (u : D)
      rw [Derivation.leibniz_pow δ x_w e, ← Nat.cast_smul_eq_nsmul ↥C e, smul_smul] at hδ_pow
      have he_unit_C : IsUnit (e : ↥C) := by
        rw [← map_natCast (algebraMap D ↥C) e]
        exact he_unit.map (algebraMap D ↥C)
      have hη_unit : IsUnit ((e : ↥C) * x_w ^ (e - 1)) :=
        he_unit_C.mul (u_w.isUnit.pow (e - 1))
      rcases hη_unit with ⟨u_η, hu_η⟩
      have hδ_xw : δ x_w = 0 := by
        calc δ x_w = (1 : ↥C) • δ x_w := (one_smul _ _).symm
          _ = ((↑u_η⁻¹ : ↥C) * (u_η : ↥C)) • δ x_w := by rw [Units.inv_mul]
          _ = (↑u_η⁻¹ : ↥C) • ((u_η : ↥C) • δ x_w) := mul_smul _ _ _
          _ = (↑u_η⁻¹ : ↥C) • (((e : ↥C) * x_w ^ (e - 1)) • δ x_w) := by rw [hu_η]
          _ = 0 := by rw [hδ_pow, smul_zero]
      have hδ_zero : δ = 0 := by
        refine Derivation.ext_of_adjoin_eq_top ({x_w} : Set ↥C) hAdjoin_C ?_
        intro x hx
        rw [Set.mem_singleton_iff.mp hx]
        exact hδ_xw
      have hSub_Ω : Subsingleton (Ω[↥C⁄D]) := by
        have hSpan : Submodule.span ↥C (Set.range δ) = ⊤ :=
          KaehlerDifferential.span_range_derivation D ↥C
        have hTop_le : (⊤ : Submodule ↥C (Ω[↥C⁄D])) ≤ ⊥ := by
          rw [← hSpan, Submodule.span_le]
          rintro _ ⟨x, rfl⟩
          rw [SetLike.mem_coe, Submodule.mem_bot, hδ_zero]
          rfl
        refine ⟨fun a b => ?_⟩
        have ha : a ∈ (⊥ : Submodule ↥C (Ω[↥C⁄D])) := hTop_le Submodule.mem_top
        have hb : b ∈ (⊥ : Submodule ↥C (Ω[↥C⁄D])) := hTop_le Submodule.mem_top
        rw [Submodule.mem_bot] at ha hb
        exact ha.trans hb.symm
      exact Algebra.FormallyUnramified.mk hSub_Ω
    exact ⟨⟨u_w, rfl, hϖ_eq_πw⟩, hFT_C, hFU_C⟩

  
  have hResidueSquareUnram : ∀ (A B R S : Type u) [CommRing A] [CommRing B] [CommRing R] [CommRing S]
      [Algebra A B] [Algebra A R] [Algebra R S] [Algebra A S] [IsScalarTower A R S]
      [Algebra.EssFiniteType R S]
      (𝔓 : Ideal A) [𝔓.IsPrime]
      (Q_B : Ideal B) [Q_B.IsPrime]
      (q : Ideal R) [q.IsPrime]
      (Q : Ideal S) [Q.IsPrime]
      (ι_BS : B →+* S),
      ι_BS.comp (algebraMap A B) = algebraMap A S →
      ∀ (hOver_B : 𝔓 = Ideal.comap (algebraMap A B) Q_B)
        (hOver_Q : Q_B = Ideal.comap ι_BS Q),
        q = Ideal.comap (algebraMap R S) Q →
        @Algebra.IsSeparable 𝔓.ResidueField Q_B.ResidueField _ _
          (Ideal.ResidueField.map 𝔓 Q_B (algebraMap A B) hOver_B).toAlgebra →
        (letI : Algebra (Localization.AtPrime Q_B) (Localization.AtPrime Q) :=
           (Localization.localRingHom Q_B Q ι_BS hOver_Q).toAlgebra
         Algebra.EssFiniteType (Localization.AtPrime Q_B) (Localization.AtPrime Q) ∧
         Algebra.FormallyUnramified (Localization.AtPrime Q_B) (Localization.AtPrime Q)) →
        ∀ (π_B : Localization.AtPrime Q_B) (ϖ_R : R) (u_Q : (Localization.AtPrime Q)ˣ),
          IsLocalRing.maximalIdeal (Localization.AtPrime Q_B) = Ideal.span {π_B} →
          q = Ideal.span {ϖ_R} →
          algebraMap R (Localization.AtPrime Q) ϖ_R =
            Localization.localRingHom Q_B Q ι_BS hOver_Q π_B * (u_Q : Localization.AtPrime Q) →
          Algebra.IsUnramifiedAt R Q := by
    intro A B R S _ _ _ _ _ _ _ _ _ _ 𝔓 _ Q_B _ q _ Q _ ι_BS hCompat
      hOver_B hOver_Q hq_eq hSep_B hLoc π_B ϖ_R u_Q hmax_QB hq_span hϖ_OQ
    let f_loc := Localization.localRingHom Q_B Q ι_BS hOver_Q
    let alg_QB_Q : Algebra Q_B.ResidueField Q.ResidueField :=
      letI : Algebra (Localization.AtPrime Q_B) (Localization.AtPrime Q) := f_loc.toAlgebra
      haveI : IsLocalHom (algebraMap (Localization.AtPrime Q_B) (Localization.AtPrime Q)) :=
        Localization.isLocalHom_localRingHom Q_B Q ι_BS hOver_Q
      inferInstance
    have hLoc_iff :
        @Algebra.IsSeparable Q_B.ResidueField Q.ResidueField _ _ alg_QB_Q ∧
        Ideal.map f_loc (IsLocalRing.maximalIdeal (Localization.AtPrime Q_B)) =
          IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
      let _ : Algebra (Localization.AtPrime Q_B) (Localization.AtPrime Q) := f_loc.toAlgebra
      have _ : IsLocalHom (algebraMap (Localization.AtPrime Q_B) (Localization.AtPrime Q)) :=
        Localization.isLocalHom_localRingHom Q_B Q ι_BS hOver_Q
      have _ : Algebra.EssFiniteType (Localization.AtPrime Q_B) (Localization.AtPrime Q) := hLoc.1
      exact (Algebra.FormallyUnramified.iff_map_maximalIdeal_eq
        (R := Localization.AtPrime Q_B) (S := Localization.AtPrime Q)).mp hLoc.2
    obtain ⟨hSep_loc, hMax_loc⟩ := hLoc_iff
    have _ : Q.LiesOver q := (Ideal.liesOver_iff Q q).mpr hq_eq
    let _ : Algebra (Localization.AtPrime q) (Localization.AtPrime Q) :=
      Localization.AtPrime.algebraOfLiesOver q Q
    have _ : IsScalarTower R (Localization.AtPrime q) (Localization.AtPrime Q) :=
      Localization.AtPrime.instIsScalarTower q Q
    let alg_q_Q : Algebra q.ResidueField Q.ResidueField := inferInstance
    have hMax_R : Ideal.map (algebraMap R (Localization.AtPrime Q)) q =
        IsLocalRing.maximalIdeal (Localization.AtPrime Q) := by
      rw [hq_span, Ideal.map_span, Set.image_singleton, hϖ_OQ,
        Ideal.span_singleton_mul_right_unit u_Q.isUnit]
      have hmap_π : Ideal.span {f_loc π_B} = Ideal.map f_loc (Ideal.span {π_B}) := by
        rw [Ideal.map_span, Set.image_singleton]
      rw [hmap_π, ← hmax_QB, hMax_loc]
    have hOver_R : 𝔓 = Ideal.comap (algebraMap A R) q := by
      apply Ideal.ext
      intro a
      have h1 := Ideal.ext_iff.mp hOver_B a
      rw [h1, hOver_Q, hq_eq]
      simp only [Ideal.mem_comap, ← RingHom.comp_apply, hCompat,
        IsScalarTower.algebraMap_eq A R S]
    let φ₁ : 𝔓.ResidueField →+* Q_B.ResidueField :=
      Ideal.ResidueField.map 𝔓 Q_B (algebraMap A B) hOver_B
    let φ₂ : Q_B.ResidueField →+* Q.ResidueField := @algebraMap _ _ _ _ alg_QB_Q
    let ψ₁ : 𝔓.ResidueField →+* q.ResidueField :=
      Ideal.ResidueField.map 𝔓 q (algebraMap A R) hOver_R
    let ψ₂ : q.ResidueField →+* Q.ResidueField := @algebraMap _ _ _ _ alg_q_Q
    have hComm_res : φ₂.comp φ₁ = ψ₂.comp ψ₁ := by
      apply Ideal.ResidueField.ringHom_ext
      apply RingHom.ext
      intro a
      simp only [RingHom.comp_apply]
      rw [Ideal.ResidueField.map_algebraMap, Ideal.ResidueField.map_algebraMap]
      have hLHS : φ₂ (algebraMap B Q_B.ResidueField (algebraMap A B a)) =
          IsLocalRing.residue (Localization.AtPrime Q)
            (algebraMap R (Localization.AtPrime Q) (algebraMap A R a)) := by
        rw [IsScalarTower.algebraMap_apply B (Localization.AtPrime Q_B) Q_B.ResidueField,
          IsLocalRing.ResidueField.algebraMap_eq (Localization.AtPrime Q_B)]
        have h_res_QB : φ₂ (IsLocalRing.residue (Localization.AtPrime Q_B)
            (algebraMap B (Localization.AtPrime Q_B) (algebraMap A B a))) =
            IsLocalRing.residue (Localization.AtPrime Q)
              (f_loc (algebraMap B (Localization.AtPrime Q_B) (algebraMap A B a))) := by
          let _ : Algebra (Localization.AtPrime Q_B) (Localization.AtPrime Q) := f_loc.toAlgebra
          have _ : IsLocalHom (algebraMap (Localization.AtPrime Q_B) (Localization.AtPrime Q)) :=
            Localization.isLocalHom_localRingHom Q_B Q ι_BS hOver_Q
          exact IsLocalRing.ResidueField.algebraMap_residue
            (R := Localization.AtPrime Q_B) (S := Localization.AtPrime Q) _
        rw [h_res_QB, Localization.localRingHom_to_map]
        have h_comp_a : ι_BS (algebraMap A B a) = algebraMap R S (algebraMap A R a) := by
          calc ι_BS (algebraMap A B a) = (ι_BS.comp (algebraMap A B)) a := rfl
            _ = algebraMap A S a := by rw [hCompat]
            _ = algebraMap R S (algebraMap A R a) := IsScalarTower.algebraMap_apply A R S a
        rw [h_comp_a, ← IsScalarTower.algebraMap_apply R S (Localization.AtPrime Q)]
      have hRHS : ψ₂ (algebraMap R q.ResidueField (algebraMap A R a)) =
          IsLocalRing.residue (Localization.AtPrime Q)
            (algebraMap R (Localization.AtPrime Q) (algebraMap A R a)) := by
        rw [IsScalarTower.algebraMap_apply R (Localization.AtPrime q) q.ResidueField,
          IsLocalRing.ResidueField.algebraMap_eq (Localization.AtPrime q),
          IsLocalRing.ResidueField.algebraMap_residue
            (R := Localization.AtPrime q) (S := Localization.AtPrime Q),
          ← IsScalarTower.algebraMap_apply R (Localization.AtPrime q) (Localization.AtPrime Q)]
      exact hLHS.trans hRHS.symm
    have hSep_top : @Algebra.IsSeparable 𝔓.ResidueField Q.ResidueField _ _ (φ₂.comp φ₁).toAlgebra :=
      @Algebra.IsSeparable.trans 𝔓.ResidueField Q_B.ResidueField _ _ φ₁.toAlgebra
        Q.ResidueField _ (φ₂.comp φ₁).toAlgebra alg_QB_Q
        (@IsScalarTower.of_algebraMap_eq' 𝔓.ResidueField Q_B.ResidueField Q.ResidueField
          _ _ _ φ₁.toAlgebra alg_QB_Q (φ₂.comp φ₁).toAlgebra rfl)
        hSep_B hSep_loc
    have hSep_R : @Algebra.IsSeparable q.ResidueField Q.ResidueField _ _ alg_q_Q :=
      @Algebra.isSeparable_tower_top_of_isSeparable 𝔓.ResidueField q.ResidueField _
        Q.ResidueField _ _ ψ₁.toAlgebra (φ₂.comp φ₁).toAlgebra alg_q_Q
        (@IsScalarTower.of_algebraMap_eq' 𝔓.ResidueField q.ResidueField Q.ResidueField
          _ _ _ ψ₁.toAlgebra alg_q_Q (φ₂.comp φ₁).toAlgebra hComm_res)
        hSep_top
    exact (Algebra.isUnramifiedAt_iff_map_eq R q Q).mpr ⟨hSep_R, hMax_R⟩

  
  have hSandwich : ∀ (B'_sub D O_Q' : Type u)
      [CommRing B'_sub] [CommRing D] [IsDomain D] [IsIntegrallyClosed D] [CommRing O_Q']
      [IsDomain O_Q'] [IsIntegrallyClosed O_Q']
      [Algebra R'_p B'_sub] [Algebra B'_sub L'_2] [IsScalarTower R'_p B'_sub L'_2]
      [IsIntegralClosure B'_sub R'_p L'_2]
      [Algebra B'_sub O_Q']
      (Q_sub : Ideal B'_sub) [Q_sub.IsPrime] [IsLocalization Q_sub.primeCompl O_Q']
      (j_D : D →+* L₂) (j_OQ : O_Q' →+* L'_2) (f_D_OQ : D →+* O_Q'),
      Function.Injective j_D →
      @IsFractionRing D _ L₂ _ j_D.toAlgebra →
      Function.Injective j_OQ →
      (∀ b : B'_sub, j_OQ (algebraMap B'_sub O_Q' b) = algebraMap B'_sub L'_2 b) →
      @IsFractionRing O_Q' _ L'_2 _ j_OQ.toAlgebra →
      j_OQ.comp f_D_OQ = (algebraMap L₂ L'_2).comp j_D →
      (∀ a : A₀, ∃ d_a : D,
        algebraMap R'_p L'_2 (algebraMap A₀ R'_p a) = algebraMap L₂ L'_2 (j_D d_a) ∧
        (MvPolynomial.eval p a ≠ 0 → IsUnit d_a)) →
      IsUnit (e : D) →
      ∀ (π_D : D), π_D ≠ 0 →
        ∀ (u_D : Dˣ),
          (algebraMap R'_p L'_2 ϖ) ^ e =
            ((algebraMap L₂ L'_2).comp j_D) ((u_D : D) * π_D ^ e) →
          (letI : Algebra D O_Q' := f_D_OQ.toAlgebra
           Algebra.EssFiniteType D O_Q' ∧ Algebra.FormallyUnramified D O_Q') ∧
          ∃ u_Q : O_Q'ˣ,
            algebraMap B'_sub O_Q' (algebraMap R'_p B'_sub ϖ) =
              f_D_OQ π_D * (u_Q : O_Q') := by
    intro B'_sub D O_Q' _ _ _ _ _ _ _ _ _ _ _ _ Q_sub _ _
      j_D j_OQ f_D_OQ _hj_D_inj hFrac_D hj_OQ_inj hj_OQ_B hFrac_OQ hj_floc
      hA₀_D he_unit_D π_D hπ_D_ne u_D hϖ_pow_D
    let _ : Algebra D L₂ := j_D.toAlgebra
    have _ : IsFractionRing D L₂ := hFrac_D
    let _ : Algebra D L'_2 := ((algebraMap L₂ L'_2).comp j_D).toAlgebra
    have _ : IsScalarTower D L₂ L'_2 := IsScalarTower.of_algebraMap_eq' rfl
    let C_D := integralClosure D L'_2
    let ϖ_L : L'_2 := algebraMap R'_p L'_2 ϖ
    have hϖ_in_C : ϖ_L ∈ C_D := by
      refine ⟨Polynomial.X ^ e - Polynomial.C ((u_D : D) * π_D ^ e),
        Polynomial.monic_X_pow_sub_C (n := e) _ he_ne_zero, ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      exact sub_eq_zero.mpr hϖ_pow_D
    have hR'_in_C : ∀ r : R'_p, algebraMap R'_p L'_2 r ∈ C_D := by
      intro r
      obtain ⟨g, c, hg_eval, hrg⟩ := hExp_R' r
      obtain ⟨d_g, hd_g_eq, hd_g_unit⟩ := hA₀_D g
      rcases hd_g_unit hg_eval with ⟨u_g, hu_g_eq⟩
      choose d_c hd_c using fun i : Fin e => hA₀_D (c i)
      have hrg_L : algebraMap R'_p L'_2 r * algebraMap D L'_2 (u_g : D) =
          ∑ i : Fin e, algebraMap D L'_2 (d_c i) * ϖ_L ^ (i : ℕ) := by
        calc algebraMap R'_p L'_2 r * algebraMap D L'_2 (u_g : D)
            = algebraMap R'_p L'_2 r * algebraMap L₂ L'_2 (j_D d_g) := by
                rw [hu_g_eq]; rfl
          _ = algebraMap R'_p L'_2 r * algebraMap R'_p L'_2 (algebraMap A₀ R'_p g) := by
                rw [← hd_g_eq]
          _ = algebraMap R'_p L'_2 (r * algebraMap A₀ R'_p g) :=
                (map_mul (algebraMap R'_p L'_2) _ _).symm
          _ = algebraMap R'_p L'_2 (∑ i : Fin e, algebraMap A₀ R'_p (c i) * ϖ ^ (i : ℕ)) := by
                rw [hrg]
          _ = ∑ i : Fin e, algebraMap D L'_2 (d_c i) * ϖ_L ^ (i : ℕ) := by
                rw [map_sum]
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [map_mul, map_pow, (hd_c i).1]
                rfl
      have hSum_in_C : (∑ i : Fin e, algebraMap D L'_2 (d_c i) * ϖ_L ^ (i : ℕ)) ∈ C_D :=
        C_D.sum_mem fun i _ =>
          C_D.mul_mem (C_D.algebraMap_mem _) (C_D.pow_mem hϖ_in_C (i : ℕ))
      have hr_eq : algebraMap R'_p L'_2 r =
          (algebraMap R'_p L'_2 r * algebraMap D L'_2 (u_g : D)) *
            algebraMap D L'_2 (↑u_g⁻¹ : D) := by
        rw [mul_assoc, ← map_mul, Units.mul_inv, map_one, mul_one]
      rw [hr_eq, hrg_L]
      exact C_D.mul_mem hSum_in_C (C_D.algebraMap_mem _)
    have hB'_in_C : ∀ b : B'_sub, algebraMap B'_sub L'_2 b ∈ C_D := by
      intro b
      have _ : Algebra.IsIntegral D ↥C_D := IsIntegralClosure.isIntegral_algebra D L'_2
      let φ_R'_C : R'_p →+* ↥C_D :=
        { toFun := fun r => ⟨algebraMap R'_p L'_2 r, hR'_in_C r⟩
          map_one' := Subtype.ext (map_one (algebraMap R'_p L'_2))
          map_mul' := fun x y => Subtype.ext (map_mul (algebraMap R'_p L'_2) x y)
          map_zero' := Subtype.ext (map_zero (algebraMap R'_p L'_2))
          map_add' := fun x y => Subtype.ext (map_add (algebraMap R'_p L'_2) x y) }
      let _ : Algebra R'_p ↥C_D := φ_R'_C.toAlgebra
      have _ : IsScalarTower R'_p ↥C_D L'_2 := IsScalarTower.of_algebraMap_eq fun _ => rfl
      have hb_R' : IsIntegral R'_p (algebraMap B'_sub L'_2 b) :=
        IsIntegral.map (IsScalarTower.toAlgHom R'_p B'_sub L'_2)
          (IsIntegralClosure.isIntegral R'_p L'_2 b)
      have hb_C : IsIntegral ↥C_D (algebraMap B'_sub L'_2 b) := IsIntegral.tower_top hb_R'
      exact isIntegral_trans (algebraMap B'_sub L'_2 b) hb_C
    let ι_B'_C : B'_sub →+* ↥C_D :=
      { toFun := fun b => ⟨algebraMap B'_sub L'_2 b, hB'_in_C b⟩
        map_one' := Subtype.ext (map_one (algebraMap B'_sub L'_2))
        map_mul' := fun x y => Subtype.ext (map_mul (algebraMap B'_sub L'_2) x y)
        map_zero' := Subtype.ext (map_zero (algebraMap B'_sub L'_2))
        map_add' := fun x y => Subtype.ext (map_add (algebraMap B'_sub L'_2) x y) }
    have hC_in_OQ : ∀ z : ↥C_D, ∃ y : O_Q', j_OQ y = z.1 := by
      let _ : Algebra O_Q' L'_2 := j_OQ.toAlgebra
      have _ : IsFractionRing O_Q' L'_2 := hFrac_OQ
      intro z
      have hz_int : IsIntegral O_Q' z.1 := by
        rcases z.2 with ⟨P, hP_mon, hP_eval⟩
        refine ⟨P.map f_D_OQ, hP_mon.map f_D_OQ, ?_⟩
        change Polynomial.eval₂ j_OQ z.1 (P.map f_D_OQ) = 0
        rw [Polynomial.eval₂_map, hj_floc]
        exact hP_eval
      exact IsIntegrallyClosed.isIntegral_iff.mp hz_int
    let ι_C_OQ : ↥C_D →+* O_Q' :=
      { toFun := fun z => Classical.choose (hC_in_OQ z)
        map_one' := hj_OQ_inj (by
          rw [Classical.choose_spec (hC_in_OQ 1), map_one]; rfl)
        map_mul' := fun z₁ z₂ => hj_OQ_inj (by
          rw [Classical.choose_spec (hC_in_OQ (z₁ * z₂)), map_mul,
            Classical.choose_spec (hC_in_OQ z₁), Classical.choose_spec (hC_in_OQ z₂)]; rfl)
        map_zero' := hj_OQ_inj (by
          rw [Classical.choose_spec (hC_in_OQ 0), map_zero]; rfl)
        map_add' := fun z₁ z₂ => hj_OQ_inj (by
          rw [Classical.choose_spec (hC_in_OQ (z₁ + z₂)), map_add,
            Classical.choose_spec (hC_in_OQ z₁), Classical.choose_spec (hC_in_OQ z₂)]; rfl) }
    have hι_j : ∀ z : ↥C_D, j_OQ (ι_C_OQ z) = z.1 :=
      fun z => Classical.choose_spec (hC_in_OQ z)
    have hι_floc : ι_C_OQ.comp (algebraMap D ↥C_D) = f_D_OQ := by
      apply RingHom.ext
      intro d
      apply hj_OQ_inj
      rw [RingHom.comp_apply, hι_j]
      change algebraMap D L'_2 d = (j_OQ.comp f_D_OQ) d
      rw [hj_floc]
      rfl
    have hι_B' : ∀ b : B'_sub, ι_C_OQ (ι_B'_C b) = algebraMap B'_sub O_Q' b := by
      intro b
      apply hj_OQ_inj
      rw [hι_j, hj_OQ_B]
      rfl
    let M' : Submonoid ↥C_D := Q_sub.primeCompl.map ι_B'_C.toMonoidHom
    have hLoc_M' : @IsLocalization ↥C_D _ M' O_Q' _ ι_C_OQ.toAlgebra := by
      let _ : Algebra ↥C_D O_Q' := ι_C_OQ.toAlgebra
      refine IsLocalization'.mk (Submonoid.IsLocalizationMap.mk ?_ ?_ ?_)
      · intro m
        rcases m.2 with ⟨s, hs, hsm⟩
        change IsUnit (ι_C_OQ m.1)
        rw [← hsm]
        change IsUnit (ι_C_OQ (ι_B'_C s))
        rw [hι_B']
        exact IsLocalization.map_units O_Q' (⟨s, hs⟩ : Q_sub.primeCompl)
      · intro y
        obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj Q_sub.primeCompl y
        refine ⟨(ι_B'_C b, ⟨ι_B'_C s.1, ⟨s.1, s.2, rfl⟩⟩), ?_⟩
        change y * ι_C_OQ (ι_B'_C s.1) = ι_C_OQ (ι_B'_C b)
        rw [hι_B', hι_B']
        exact hbs
      · intro z₁ z₂ hz
        have hz_eq : z₁ = z₂ := by
          apply Subtype.ext
          rw [← hι_j z₁, ← hι_j z₂]
          exact congrArg j_OQ hz
        exact ⟨1, by rw [hz_eq]⟩
    let t_π : L₂ := j_D π_D
    have ht_π_ne : t_π ≠ 0 :=
      (map_ne_zero_iff (algebraMap D L₂) (IsFractionRing.injective D L₂)).mpr hπ_D_ne
    let S_C : Subring L'_2 := C_D.toSubring
    have hKummer_CD :
        let w : L'_2 := (algebraMap D L'_2 π_D)⁻¹ * ϖ_L
        (∀ σ : L'_2 ≃ₐ[L₂] L'_2, ∀ z ∈ C_D, σ z ∈ C_D) →
        w ∈ C_D → w⁻¹ ∈ C_D →
        ∀ z ∈ C_D, ∃ (m : ℕ) (c : Fin m → L₂),
          (∀ j : Fin m, algebraMap L₂ L'_2 (c j) ∈ C_D) ∧
          z = ∑ j : Fin m, algebraMap L₂ L'_2 (c j) * w ^ (j : ℕ) := by
      intro w hGal hw hwinv z hz
      exact hKummerOrth t_π ht_π_ne S_C
        (fun c₀ => hR'_in_C (algebraMap k R'_p c₀))
        hGal hw hwinv z hz
    obtain ⟨⟨u_w, hu_w_val, hϖ_eq_πw⟩, hFT_CD, hFU_CD⟩ :=
      hUnitRootUnram D L₂ L'_2 he_unit_D π_D hπ_D_ne u_D ϖ_L hϖ_pow_D hKummer_CD
    have hLoc_D_OQ :
        letI : Algebra D O_Q' := f_D_OQ.toAlgebra
        Algebra.EssFiniteType D O_Q' ∧ Algebra.FormallyUnramified D O_Q' := by
      let _ : Algebra D O_Q' := f_D_OQ.toAlgebra
      let _ : Algebra ↥C_D O_Q' := ι_C_OQ.toAlgebra
      have _ : IsScalarTower D ↥C_D O_Q' := IsScalarTower.of_algebraMap_eq' hι_floc.symm
      have _ : IsLocalization M' O_Q' := hLoc_M'
      have _ : Algebra.FiniteType D ↥C_D := hFT_CD
      have _ : Algebra.FormallyUnramified D ↥C_D := hFU_CD
      have _ : Algebra.EssFiniteType D ↥C_D := Algebra.EssFiniteType.of_finiteType D ↥C_D
      have _ : Algebra.EssFiniteType ↥C_D O_Q' := Algebra.EssFiniteType.of_isLocalization O_Q' M'
      have _ : Algebra.FormallyUnramified ↥C_D O_Q' :=
        Algebra.FormallyUnramified.of_isLocalization (Rₘ := O_Q') M'
      exact ⟨Algebra.EssFiniteType.comp D ↥C_D O_Q',
        Algebra.FormallyUnramified.comp D ↥C_D O_Q'⟩
    let u_Q : O_Q'ˣ := Units.map ι_C_OQ.toMonoidHom u_w
    have hϖ_OQ :
        algebraMap B'_sub O_Q' (algebraMap R'_p B'_sub ϖ) = f_D_OQ π_D * (u_Q : O_Q') := by
      apply hj_OQ_inj
      rw [hj_OQ_B, ← IsScalarTower.algebraMap_apply R'_p B'_sub L'_2 ϖ, map_mul]
      have hj_floc_π : j_OQ (f_D_OQ π_D) = algebraMap D L'_2 π_D :=
        RingHom.congr_fun hj_floc π_D
      have hj_uQ : j_OQ (u_Q : O_Q') = (u_w : ↥C_D).1 := hι_j (u_w : ↥C_D)
      rw [hj_floc_π, hj_uQ, hu_w_val]
      exact hϖ_eq_πw
    exact ⟨hLoc_D_OQ, u_Q, hϖ_OQ⟩

  
  let _ : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
  have _ : IsScalarTower A₀ K₂ L₂ := IsScalarTower.of_algebraMap_eq' rfl
  let B₂_0 := integralClosure A₀ L₂
  let B'_p := integralClosure R'_p L'_2

  let q' : Ideal R'_p := Ideal.comap (algebraMap R'_p ↥B'_p) Q'
  have hq'_prime : q'.IsPrime := Ideal.IsPrime.comap (algebraMap R'_p ↥B'_p)
  have hq'_eq : q' = Ideal.span {ϖ} := hHeight1_ϖ q' hϖ_mem hq'_ne_max
  have hϖ_prime : (Ideal.span {ϖ} : Ideal R'_p).IsPrime := hq'_eq ▸ hq'_prime
  let 𝔓_C : Ideal A₀ := Ideal.span {f₀}
  have _ : 𝔓_C.IsPrime := by
    change (Ideal.span {f₀} : Ideal A₀).IsPrime
    rw [← hComap_ϖ]
    have _ : (Ideal.span {ϖ} : Ideal R'_p).IsPrime := hϖ_prime
    exact Ideal.IsPrime.comap (algebraMap A₀ R'_p)

  have hB₂_to_B' : ∀ y : ↥B₂_0, algebraMap L₂ L'_2 y.1 ∈ B'_p := by
    intro y
    rcases y.2 with ⟨P, hP_mon, hP_eval⟩
    refine ⟨P.map (algebraMap A₀ R'_p), hP_mon.map (algebraMap A₀ R'_p), ?_⟩
    rw [Polynomial.eval₂_map, hTower_A₀]
    change Polynomial.eval₂ ((algebraMap L₂ L'_2).comp (algebraMap A₀ L₂))
        (algebraMap L₂ L'_2 y.1) P = 0
    rw [← Polynomial.hom_eval₂, hP_eval, map_zero]

  let ι_B₂_B' : ↥B₂_0 →+* ↥B'_p :=
    { toFun := fun y => ⟨algebraMap L₂ L'_2 y.1, hB₂_to_B' y⟩
      map_one' := Subtype.ext (map_one (algebraMap L₂ L'_2))
      map_mul' := fun x y => Subtype.ext (map_mul (algebraMap L₂ L'_2) x.1 y.1)
      map_zero' := Subtype.ext (map_zero (algebraMap L₂ L'_2))
      map_add' := fun x y => Subtype.ext (map_add (algebraMap L₂ L'_2) x.1 y.1) }

  have hCompat_B :
      ι_B₂_B'.comp (algebraMap A₀ ↥B₂_0) =
        (algebraMap R'_p ↥B'_p).comp (algebraMap A₀ R'_p) := by
    apply RingHom.ext
    intro a
    exact Subtype.ext (RingHom.congr_fun hTower_A₀ a).symm

  let Q_C : Ideal ↥B₂_0 := Ideal.comap ι_B₂_B' Q'
  have _ : Q_C.IsPrime := Ideal.IsPrime.comap ι_B₂_B'
  have hOver_Q : Q_C = Ideal.comap ι_B₂_B' Q' := rfl
  have hOver_B : 𝔓_C = Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C := by
    have h1 : Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C =
        Ideal.comap (algebraMap A₀ R'_p) q' := by
      apply Ideal.ext
      intro a
      simp only [Q_C, q', Ideal.mem_comap, ← RingHom.comp_apply, hCompat_B]
    rw [h1, hq'_eq, hComap_ϖ]

  obtain ⟨_hDVR_QC, ⟨π_C, u_C, hπ_ne, hmax_QC, hf₀_QC⟩, hSep_QC⟩ :=
    hDivUnifSep 𝔓_C Q_C hOver_B rfl

  obtain ⟨j_QC, _hj_QC_inj, hj_QC, hDom_QC, hIC_QC, hFrac_QC⟩ :=
    hLocEmbed A₀ K₂ L₂ Q_C
  obtain ⟨j_Q', hj_Q'_inj, hj_Q', hDom_Q', hIC_Q', hFrac_Q'⟩ :=
    hLocEmbed R'_p K'_2 L'_2 Q'

  let f_loc := Localization.localRingHom Q_C Q' ι_B₂_B' hOver_Q
  have hj_f_loc : j_Q'.comp f_loc = (algebraMap L₂ L'_2).comp j_QC := by
    apply IsLocalization.ringHom_ext Q_C.primeCompl
    apply RingHom.ext
    intro y
    simp only [RingHom.comp_apply, f_loc]
    rw [Localization.localRingHom_to_map, hj_Q' (ι_B₂_B' y), hj_QC y]
    rfl

  have hA₀_QC : ∀ a : A₀, ∃ d_a : Localization.AtPrime Q_C,
      algebraMap R'_p L'_2 (algebraMap A₀ R'_p a) = algebraMap L₂ L'_2 (j_QC d_a) ∧
      (MvPolynomial.eval p a ≠ 0 → IsUnit d_a) := by
    intro a
    refine ⟨algebraMap ↥B₂_0 (Localization.AtPrime Q_C) (algebraMap A₀ ↥B₂_0 a), ?_, ?_⟩
    · rw [hj_QC]
      exact RingHom.congr_fun hTower_A₀ a
    · intro ha_eval
      have ha_not_QC : algebraMap A₀ ↥B₂_0 a ∉ Q_C := by
        intro ha_mem
        have ha_𝔓 : a ∈ 𝔓_C := by
          rw [hOver_B]
          exact ha_mem
        rcases Ideal.mem_span_singleton.mp ha_𝔓 with ⟨q₀, hq₀⟩
        apply ha_eval
        rw [hq₀, map_mul, hp_f₀, zero_mul]
      exact IsLocalization.map_units (Localization.AtPrime Q_C)
        (⟨algebraMap A₀ ↥B₂_0 a, ha_not_QC⟩ : Q_C.primeCompl)

  have he_unit_QC : IsUnit (e : Localization.AtPrime Q_C) := by
    let ψ_k : k →+* Localization.AtPrime Q_C :=
      (algebraMap ↥B₂_0 (Localization.AtPrime Q_C)).comp
        ((algebraMap A₀ ↥B₂_0).comp MvPolynomial.C)
    rw [← map_natCast ψ_k e]
    exact (IsUnit.mk0 (e : k) he_ne).map ψ_k

  have hϖ_pow_QC :
      (algebraMap R'_p L'_2 ϖ) ^ e =
        ((algebraMap L₂ L'_2).comp j_QC) ((u_C : Localization.AtPrime Q_C) * π_C ^ e) := by
    calc (algebraMap R'_p L'_2 ϖ) ^ e
        = algebraMap R'_p L'_2 (ϖ ^ e) := (map_pow (algebraMap R'_p L'_2) ϖ e).symm
      _ = algebraMap R'_p L'_2 (algebraMap A₀ R'_p f₀) := by rw [hϖ_pow]
      _ = ((algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂))) f₀ :=
            RingHom.congr_fun hTower_A₀ f₀
      _ = algebraMap L₂ L'_2 (algebraMap A₀ ↥B₂_0 f₀).1 := rfl
      _ = ((algebraMap L₂ L'_2).comp j_QC)
            (algebraMap ↥B₂_0 (Localization.AtPrime Q_C) (algebraMap A₀ ↥B₂_0 f₀)) := by
            rw [RingHom.comp_apply, hj_QC]
      _ = ((algebraMap L₂ L'_2).comp j_QC) ((u_C : Localization.AtPrime Q_C) * π_C ^ e) := by
            rw [hf₀_QC]

  obtain ⟨hLoc_QC_Q', u_Q, hϖ_OQ'_sub⟩ := by
    let _ : IsDomain (Localization.AtPrime Q_C) := hDom_QC
    have _ : IsIntegrallyClosed (Localization.AtPrime Q_C) := hIC_QC
    let _ : IsDomain (Localization.AtPrime Q') := hDom_Q'
    have _ : IsIntegrallyClosed (Localization.AtPrime Q') := hIC_Q'
    exact hSandwich ↥B'_p (Localization.AtPrime Q_C) (Localization.AtPrime Q')
      Q' j_QC j_Q' f_loc _hj_QC_inj hFrac_QC hj_Q'_inj hj_Q' hFrac_Q' hj_f_loc
      hA₀_QC he_unit_QC π_C hπ_ne u_C hϖ_pow_QC

  have hϖ_OQ' : algebraMap R'_p (Localization.AtPrime Q') ϖ =
      f_loc π_C * (u_Q : Localization.AtPrime Q') := by
    rw [IsScalarTower.algebraMap_apply R'_p ↥B'_p (Localization.AtPrime Q') ϖ]
    exact hϖ_OQ'_sub

  have _ : Module.Finite R'_p ↥B'_p := IsIntegralClosure.finite R'_p K'_2 L'_2 ↥B'_p
  have _ : Algebra.FiniteType R'_p ↥B'_p := Module.Finite.finiteType (R := R'_p) ↥B'_p
  have _ : Algebra.EssFiniteType R'_p ↥B'_p := Algebra.EssFiniteType.of_finiteType R'_p ↥B'_p

  let _ : Algebra A₀ ↥B'_p := ((algebraMap R'_p ↥B'_p).comp (algebraMap A₀ R'_p)).toAlgebra
  have _ : IsScalarTower A₀ R'_p ↥B'_p := IsScalarTower.of_algebraMap_eq' rfl

  exact hResidueSquareUnram A₀ ↥B₂_0 R'_p ↥B'_p 𝔓_C Q_C q' Q' ι_B₂_B'
    hCompat_B hOver_B hOver_Q rfl hSep_QC hLoc_QC_Q' π_C ϖ u_Q hmax_QC hq'_eq hϖ_OQ'

theorem weil_abhyankar_kummer_regular_local_and_codim1_unramified (k : Type u) [Field k]
    [IsAlgClosed k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
      (h₀ f₀ : A₀),
      Irreducible h₀ →
      Irreducible f₀ →
      ∀ (p : Fin 2 → k),
        MvPolynomial.eval p h₀ = 0 →
        MvPolynomial.eval p f₀ = 0 →
        ∀ (𝔪_p : Ideal A₀) [𝔪_p.IsMaximal],
          (∀ g : A₀, g ∈ 𝔪_p ↔ MvPolynomial.eval p g = 0) →
          (let 𝒪_p := Localization.AtPrime 𝔪_p
           let f_p := algebraMap A₀ 𝒪_p f₀
           let h_p := algebraMap A₀ 𝒪_p h₀
           f_p ≠ 0 ∧ h_p ≠ 0 ∧
           (Ideal.span {f_p}).IsPrime ∧ (Ideal.span {h_p}).IsPrime ∧
           h_p ∉ Ideal.span {f_p} ∧ f_p ∉ Ideal.span {h_p} ∧
           IsLocalRing.maximalIdeal 𝒪_p = Ideal.span {f_p, h_p}) →
          (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
           let B₂_0 := integralClosure A₀ L₂
           @RingHom.Etale
             (Localization.Away f₀)
             (Localization.Away (algebraMap A₀ ↥B₂_0 f₀))
             inferInstance inferInstance
             (Localization.awayMap (algebraMap A₀ ↥B₂_0) f₀)) →
          ∀ (e : ℕ), 1 ≤ e → (e : k) ≠ 0 →
            (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
             let B₂_0 := integralClosure A₀ L₂
             ∀ (𝔓_C : Ideal A₀) [𝔓_C.IsPrime]
               (Q_C : Ideal ↥B₂_0) [Q_C.IsPrime]
               (hOver : 𝔓_C = Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C),
               𝔓_C = Ideal.span {f₀} →
               IsDiscreteValuationRing (Localization.AtPrime Q_C) ∧
               (∃ (π_C : Localization.AtPrime Q_C) (u_C : (Localization.AtPrime Q_C)ˣ),
                 π_C ≠ 0 ∧
                 IsLocalRing.maximalIdeal (Localization.AtPrime Q_C) = Ideal.span {π_C} ∧
                 algebraMap ↥B₂_0 (Localization.AtPrime Q_C) (algebraMap A₀ ↥B₂_0 f₀) =
                   (u_C : Localization.AtPrime Q_C) * π_C ^ e) ∧
               @Algebra.IsSeparable 𝔓_C.ResidueField Q_C.ResidueField _ _
                 (Ideal.ResidueField.map 𝔓_C Q_C (algebraMap A₀ ↥B₂_0) hOver).toAlgebra) →
            letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
            let B₂_0 := integralClosure A₀ L₂
            ∃ (R'_p K'_2 L'_2 : Type u)
              (_ : CommRing R'_p) (_ : IsDomain R'_p) (_ : IsNoetherianRing R'_p)
              (_ : IsIntegrallyClosed R'_p) (_ : IsLocalRing R'_p)
              (_ : Field K'_2) (_ : Algebra R'_p K'_2) (_ : IsFractionRing R'_p K'_2)
              (_ : Field L'_2) (_ : Algebra K₂ L'_2) (_ : FiniteDimensional K₂ L'_2)
              (_ : IsGalois K₂ L'_2)
              (_ : Algebra L₂ L'_2) (_ : IsScalarTower K₂ L₂ L'_2)
              (_ : FiniteDimensional L₂ L'_2) (_ : IsGalois L₂ L'_2)
              (_ : Algebra K'_2 L'_2) (_ : FiniteDimensional K'_2 L'_2)
              (_ : Algebra.IsSeparable K'_2 L'_2)
              (_ : Algebra R'_p L'_2) (_ : IsScalarTower R'_p K'_2 L'_2)
              (_ : Algebra k R'_p) (_ : Algebra A₀ R'_p) (_ : IsScalarTower k A₀ R'_p)
              (ϖ : R'_p),
              ((algebraMap R'_p L'_2).comp (algebraMap A₀ R'_p) =
                 (algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)) ∧
               (∀ g : A₀, MvPolynomial.eval p g ≠ 0 → IsUnit (algebraMap A₀ R'_p g)) ∧
               (∀ x : L₂,
                 IsIntegral R'_p (algebraMap L₂ L'_2 x) ↔
                   ∃ (y : ↥B₂_0) (g : A₀),
                     MvPolynomial.eval p g ≠ 0 ∧
                     x * algebraMap A₀ L₂ g = (y : L₂))) ∧
              (let h'_0 := algebraMap A₀ R'_p h₀
               ϖ ≠ 0 ∧ h'_0 ≠ 0 ∧
               ϖ ^ e = algebraMap A₀ R'_p f₀ ∧
               (Ideal.span {ϖ}).IsPrime ∧ (Ideal.span {h'_0}).IsPrime ∧
               h'_0 ∉ Ideal.span {ϖ} ∧ ϖ ∉ Ideal.span {h'_0} ∧
               IsLocalRing.maximalIdeal R'_p = Ideal.span {ϖ, h'_0} ∧
               Ideal.comap (algebraMap A₀ R'_p) (Ideal.span {ϖ}) = Ideal.span {f₀} ∧
               (∀ r : R'_p, ∃ c : k, r - algebraMap k R'_p c ∈ IsLocalRing.maximalIdeal R'_p)) ∧
              ((Nat.card (L'_2 ≃ₐ[L₂] L'_2) : k) ≠ 0 ∧
               ∀ τ : L'_2 ≃ₐ[K₂] L'_2,
                 (∃ ζ : k, ζ ^ e = 1 ∧
                   τ (algebraMap R'_p L'_2 ϖ) =
                     algebraMap R'_p L'_2 (algebraMap k R'_p ζ * ϖ)) ∧
                 (∀ r : R'_p, ∃ r' : R'_p,
                   τ (algebraMap R'_p L'_2 r) = algebraMap R'_p L'_2 r') ∧
                 (∀ r : R'_p, ∃ s : R'_p,
                   τ (algebraMap R'_p L'_2 r) - algebraMap R'_p L'_2 r =
                     algebraMap R'_p L'_2 (ϖ * s))) ∧
              (∀ (Q' : Ideal ↥(integralClosure R'_p L'_2)) [Q'.IsPrime],
                 Ideal.comap (algebraMap R'_p ↥(integralClosure R'_p L'_2)) Q' ≠ ⊥ →
                 Ideal.comap (algebraMap R'_p ↥(integralClosure R'_p L'_2)) Q' ≠
                   IsLocalRing.maximalIdeal R'_p →
                 Algebra.IsUnramifiedAt R'_p Q') :=
by
  intro A₀ K₂ L₂ _ _ _ _ h₀ f₀ hIrr_h₀ hIrr_f₀ p hp_h₀ hp_f₀ 𝔪_p _ h𝔪_p hReg hEtale_away
    e he_pos he_ne hDivUnifSep
  have hf₀_ne : f₀ ≠ 0 := hIrr_f₀.ne_zero
  obtain ⟨R'_p, K'_2, hCR, hDom, hNoeth, hIC, hLoc,
      hFK, hARK, hFracK, hAK₂K', hAkR', hAA₀R', hSTkA₀R', ϖ,
      hK'_lift_pkg, hUnits_exp, hOut2, hHeight1_ϖ⟩ :=
    weil_kummer_local_ring_regular_and_integrally_closed k h₀ f₀ hIrr_h₀ hIrr_f₀
      p hp_h₀ hp_f₀ 𝔪_p h𝔪_p hReg e he_pos he_ne
  let _ : CommRing R'_p := hCR
  let _ : IsDomain R'_p := hDom
  let _ : IsNoetherianRing R'_p := hNoeth
  let _ : IsIntegrallyClosed R'_p := hIC
  let _ : IsLocalRing R'_p := hLoc
  let _ : Field K'_2 := hFK
  let _ : Algebra R'_p K'_2 := hARK
  let _ : IsFractionRing R'_p K'_2 := hFracK
  let _ : Algebra K₂ K'_2 := hAK₂K'
  let _ : Algebra k R'_p := hAkR'
  let _ : Algebra A₀ R'_p := hAA₀R'
  let _ : IsScalarTower k A₀ R'_p := hSTkA₀R'
  have ⟨hϖ_ne, _, hϖ_pow, _, _, _, _, _, hComap_ϖ, _⟩ := hOut2
  obtain ⟨L'_2, hFL, hAK₂L, hFDK₂L, hGalK₂L,
      hAL₂L, hSTK₂L₂L, hFDL₂L, hGalL₂L,
      hAK'L, hFDK'L, hSepK'L, hAR'L, hSTR'K'L,
      hOut1_ac, hOut3, hKummerOrth⟩ :=
    weil_kummer_composite_galois_and_character_orthogonality k L₂ f₀ hf₀_ne
      p e he_pos he_ne R'_p K'_2 ϖ hϖ_pow hK'_lift_pkg.1 hK'_lift_pkg.2.2
      hUnits_exp.1 hUnits_exp.2
  let _ : Field L'_2 := hFL
  let _ : Algebra K₂ L'_2 := hAK₂L
  let _ : FiniteDimensional K₂ L'_2 := hFDK₂L
  let _ : IsGalois K₂ L'_2 := hGalK₂L
  let _ : Algebra L₂ L'_2 := hAL₂L
  let _ : IsScalarTower K₂ L₂ L'_2 := hSTK₂L₂L
  let _ : FiniteDimensional L₂ L'_2 := hFDL₂L
  let _ : IsGalois L₂ L'_2 := hGalL₂L
  let _ : Algebra K'_2 L'_2 := hAK'L
  let _ : FiniteDimensional K'_2 L'_2 := hFDK'L
  let _ : Algebra.IsSeparable K'_2 L'_2 := hSepK'L
  let _ : Algebra R'_p L'_2 := hAR'L
  let _ : IsScalarTower R'_p K'_2 L'_2 := hSTR'K'L
  refine ⟨R'_p, K'_2, L'_2, hCR, hDom, hNoeth, hIC, hLoc,
    hFK, hARK, hFracK, hFL, hAK₂L, hFDK₂L, hGalK₂L,
    hAL₂L, hSTK₂L₂L, hFDL₂L, hGalL₂L,
    hAK'L, hFDK'L, hSepK'L, hAR'L, hSTR'K'L,
    hAkR', hAA₀R', hSTkA₀R', ϖ,
    ⟨hOut1_ac.1, hUnits_exp.1, hOut1_ac.2⟩, hOut2, hOut3, ?_⟩
  intro Q' _ _hq'_ne_bot hq'_ne_max
  by_cases hϖ_mem : algebraMap R'_p ↥(integralClosure R'_p L'_2) ϖ ∈ Q'
  · exact weil_kummer_divisor_ramification_cancellation_unramified k L₂ f₀ hIrr_f₀
      p hp_f₀ e he_pos he_ne hDivUnifSep R'_p K'_2 L'_2 ϖ
      hϖ_ne hϖ_pow hComap_ϖ hHeight1_ϖ hOut1_ac.1 hUnits_exp.2 hKummerOrth
      Q' hϖ_mem hq'_ne_max
  · exact weil_kummer_off_divisor_unramified k L₂ f₀ hIrr_f₀
