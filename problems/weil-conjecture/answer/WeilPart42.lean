          (CategoryTheory.yoneda.obj U₁) (weilPolyP1CohomologyRepSheaf X U₂).obj)
          (α ≫ (shAdj.homEquiv P₂ (weilPolyP1CohomologyRepSheaf X U₂)) (𝟙 _))) =
