          (letI : Algebra ↥F'₁ ↥F_β := (Subfield.inclusion hF_le).toAlgebra
           FiniteDimensional ↥F'₁ ↥F_β ∧ IsGalois ↥F'₁ ↥F_β) ∧
          ∀ a ∈ S, (ι_κ₁ a) ^ (q ^ n) ∈ F_β := by
