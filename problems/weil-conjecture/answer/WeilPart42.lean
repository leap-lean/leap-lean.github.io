      obtain ⟨w', hw'⟩ := ih Q hZeroQ z' hz'_edge
      obtain ⟨hcomp_δ_tilde, _, hEx_δ_tilde⟩ :=
        hExact_pf_δ₀ SC_U hSE_U (hInjAcyc I 1 (le_refl 1))
      have hZ1_G : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u 1 G) :=
        hZeroG 1 (le_refl 1) (by omega)
      have hδ_tilde_zero : ((ε₀ Q).inv ≫ weilSingDevAlgBCConnHom u SC_U hSE_U 0) = 0 :=
        hZ1_G.eq_of_tgt _ 0
      have hEpi_pf_π : CategoryTheory.Epi (pf_u.map π_G) := hEx_δ_tilde.epi_f hδ_tilde_zero
