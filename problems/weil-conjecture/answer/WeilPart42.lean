  obtain rfl : @hr_all = fun {S₁ S₂} h => (sys h).hAdj := Subsingleton.elim _ _

  
  have hPbComp : ∀ {Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u}}
