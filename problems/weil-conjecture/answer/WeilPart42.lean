theorem weil_equiv_roof_equivariant_leray_transgression_inj (sys : WeilEtaleSitePullbackSys.{u})
    (hBase : WeilSingDevAlgBCBaseProps.{u} sys)
    (X U : AlgebraicGeometry.Scheme.{u})
    (u : U ⟶ X) (g : X ⟶ X) (g' : U ⟶ U)
    (h_sq : CategoryTheory.CategoryStruct.comp g' u = CategoryTheory.CategoryStruct.comp u g)
    (m₀ n : ℕ)
    (hIso_η :
      letI := (sys u).hCont
      letI := (sys u).hAdj
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
      let adj_u := (weilEtaleSitePullback u).sheafAdjunctionContinuous
        AddCommGrpCat.{u} X.smallEtaleTopology U.smallEtaleTopology
      CategoryTheory.IsIso
        ((adj_u.homEquiv (weilEtaleTorsionSheaf X m₀) (weilEtaleTorsionSheaf U m₀))
          (weilEtaleConstPullbackHom u
            (weilEtaleIdTerminalIsTerminal.{u} U)
            (weilEtaleIdTerminalIsTerminal.{u} X) AM)))
    (hZero : ∀ a : ℕ, 1 ≤ a → a ≤ n →
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage u a (weilEtaleTorsionSheaf U m₀)))
    (hSurj : ∃ p_mid : weilEtaleTorsionH X m₀ (n + 1) →+ weilEtaleTorsionH U m₀ (n + 1),
      WeilIsTorsionEtalePullback u m₀ (n + 1) p_mid ∧ Function.Surjective p_mid) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
      fun h => (sys h).hCont
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        ((weilEtaleSitePullback h).sheafPushforwardContinuous
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint :=
      fun h => (sys h).hAdj
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive :=
      fun h => (sys h).hAdd_pb
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.Limits.PreservesFiniteLimits
          ((weilEtaleSitePullback h).sheafPullback
            AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
      fun h => (sys h).hLim_pb
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.Limits.PreservesFiniteColimits
          ((weilEtaleSitePullback h).sheafPullback
            AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
