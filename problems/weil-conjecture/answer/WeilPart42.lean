      have hℓ_b : ∀ i : Fin n, ℓ (b i) = π (MvPolynomial.X i) := fun i => b.constr_basis R _ i
      have hφℓ_lin : φ.toLinearMap.comp ℓ = LinearMap.id := by
        apply b.ext; intro i
        simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, LinearMap.id_apply, hℓ_b, hφπ]
