          exact ⟨1, by rw [hz12]⟩ }
    have _ : Algebra.FormallyUnramified (Localization.Away f_B₂) ↥C_pf :=
      Algebra.FormallyUnramified.of_isLocalization M_p
    exact RingHom.formallyUnramified_algebraMap.mpr inferInstance

  
  let φ_CS : ↥C_pf →+* ↥S_ϖ :=
    { toFun := fun x => ⟨algebraMap L₂ L'_2 x.1, x.2⟩
      map_one' := by apply Subtype.ext; exact map_one _
      map_mul' := fun x y => by apply Subtype.ext; exact map_mul _ x.1 y.1
      map_zero' := by apply Subtype.ext; exact map_zero _
      map_add' := fun x y => by apply Subtype.ext; exact map_add _ x.1 y.1 }
  have hφ_CS_unram : φ_CS.FormallyUnramified := by
    let _ : Algebra ↥C_pf ↥S_ϖ := φ_CS.toAlgebra
