              have hs_I₁ : a * (s : R) = 0 := by
                change (s : R) ∈ I₁
                rw [← hS_eq]
                exact Ideal.subset_span s.2
              have hmul0 : algebraMap R R_𝔪 a * algebraMap R R_𝔪 (s : R) = 0 := by
                rw [← map_mul, hs_I₁, map_zero]
              have hs0 : algebraMap R R_𝔪 (s : R) = 0 :=
                (mul_eq_zero.mp hmul0).resolve_left ha0
              exact (IsLocalization.map_eq_zero_iff 𝔪.primeCompl R_𝔪 (s : R)).mp hs0
            choose t_fn ht_fn using hs_ann
            let t_prod : R := ∏ s ∈ S.attach, (t_fn s : R)
            have ht_prod_mem : t_prod ∈ 𝔪.primeCompl :=
              Submonoid.prod_mem 𝔪.primeCompl (fun s _ => (t_fn s).2)
            have ht_prod_I₂ : t_prod ∈ I₂ := by
              apply h_mem_I₂_of_S
              intro s hs
              obtain ⟨q, hq⟩ :=
                Finset.dvd_prod_of_mem (fun x : ↥S => (t_fn x : R))
                  (Finset.mem_attach S ⟨s, hs⟩)
              dsimp only [t_prod]
              rw [hq, ← mul_assoc, mul_comm s (t_fn ⟨s, hs⟩ : R), ht_fn ⟨s, hs⟩, zero_mul]
            exact ht_prod_mem (hI₂_le ht_prod_I₂)
        have h1_sup : (1 : R) ∈ I₁ ⊔ I₂ := by
          rw [hSup_top]
          exact Submodule.mem_top
        obtain ⟨e₁, he₁, e₂, he₂, he_sum⟩ := Submodule.mem_sup.mp h1_sup
        have he₁₂ : e₁ * e₂ = 0 := he₂ e₁ he₁
        have he₁_sq : e₁ ^ 2 = e₁ := by
          calc
            e₁ ^ 2 = e₁ * (e₁ + e₂) - e₁ * e₂ := by ring
            _ = e₁ * 1 - 0 := by rw [he_sum, he₁₂]
            _ = e₁ := by ring
        rcases hIdemp e₁ he₁_sq with rfl | rfl
        · right
          have he₂_one : e₂ = 1 := by simpa using he_sum
          rw [he₂_one] at he₂
          have hb_I₁ : b ∈ I₁ := hab
          simpa using he₂ b hb_I₁
        · left
          have h1_I₁ : (1 : R) ∈ I₁ := he₁
          change a * 1 = 0 at h1_I₁
          simpa using h1_I₁⟩
      have : IsDomain R := NoZeroDivisors.to_isDomain R
      refine ⟨inferInstance, IsIntegrallyClosed.of_localization_maximal ?_⟩
      intro p _ hp_max
      have : p.IsPrime := hp_max.isPrime
      exact (hLoc p hp_max).2

    
    have hAwayTransfer :
        ∀ (B_0 B_c : Type u) [CommRing B_0] [CommRing B_c]
          (q_0 : A →+* B_0) (q_c : A →+* B_c),
          q_c.IsIntegral →
          ∀ (v0_bar : B_0) (uc_bar : B_c)
            (Ψ : Localization.Away v0_bar ≃+* Localization.Away uc_bar),
            (∀ c₀ : k,
              Ψ (algebraMap B_0 (Localization.Away v0_bar) (q_0 (MvPolynomial.C c₀))) =
                algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.C c₀))) →
            (∀ (𝔪_0 : Ideal B_0) [𝔪_0.IsPrime], 𝔪_0.IsMaximal →
              IsDomain (Localization.AtPrime 𝔪_0) ∧
                IsIntegrallyClosed (Localization.AtPrime 𝔪_0)) →
            ∀ (𝔪_bar : Ideal B_c) [𝔪_bar.IsPrime]
              (R_bar : Type u) [CommRing R_bar] [Algebra B_c R_bar]
              [IsLocalization.AtPrime R_bar 𝔪_bar],
              𝔪_bar.IsMaximal →
              uc_bar ∉ 𝔪_bar →
              IsDomain R_bar ∧ IsIntegrallyClosed R_bar := by
      intro B_0 B_c _ _ q_0 q_c hInt_c v0_bar uc_bar Ψ hΨ_C hLoc0 𝔪_bar _ R_bar _ _ _ h𝔪_max huc_not
      have : 𝔪_bar.IsMaximal := h𝔪_max
      have h𝔪A_max : (Ideal.comap q_c 𝔪_bar).IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal q_c hInt_c 𝔪_bar
      obtain ⟨p_pt, hp_van⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := Ideal.comap q_c 𝔪_bar)).mp h𝔪A_max
      let ev_p : A →+* k := (MvPolynomial.aeval (R := k) p_pt).toRingHom
      have hqc_mem_iff : ∀ g : A, q_c g ∈ 𝔪_bar ↔ ev_p g = 0 := by
        intro g
        change g ∈ Ideal.comap q_c 𝔪_bar ↔ (MvPolynomial.aeval p_pt) g = 0
        rw [hp_van]
        exact MvPolynomial.mem_vanishingIdeal_singleton_iff p_pt g
      let F_c := B_c ⧸ 𝔪_bar
      let _instFieldFc : Field F_c := Ideal.Quotient.field 𝔪_bar
      let π_c : B_c →+* F_c := Ideal.Quotient.mk 𝔪_bar
      let ι_k : k →+* F_c := π_c.comp (q_c.comp MvPolynomial.C)
      let _instAlgkFc : Algebra k F_c := ι_k.toAlgebra
      have hπ_qc : π_c.comp q_c = ι_k.comp ev_p := by
        refine RingHom.ext fun g => ?_
        have hdiff : q_c (g - MvPolynomial.C (ev_p g)) ∈ 𝔪_bar := by
          rw [hqc_mem_iff, map_sub]
          have hC : ev_p (MvPolynomial.C (ev_p g)) = ev_p g := MvPolynomial.aeval_C p_pt (ev_p g)
          rw [hC, sub_self]
        rw [map_sub] at hdiff
        exact Ideal.Quotient.eq.mpr hdiff
      have : Algebra.IsIntegral k F_c := ⟨by
        intro y_bar
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y_bar
        obtain ⟨P, hP_mon, hP_eval⟩ := hInt_c y
        refine ⟨P.map ev_p, hP_mon.map _, ?_⟩
        rw [Polynomial.eval₂_map]
        change Polynomial.eval₂ (ι_k.comp ev_p) (π_c y) P = 0
        rw [← hπ_qc, ← Polynomial.hom_eval₂, hP_eval, map_zero]⟩
      have hSurj_k : Function.Surjective (algebraMap k F_c) :=
        (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := F_c)).2
      have hRes_Bc : ∀ y : B_c, ∃ c₀ : k, y - q_c (MvPolynomial.C c₀) ∈ 𝔪_bar := by
        intro y
        obtain ⟨c₀, hc₀⟩ := hSurj_k (π_c y)
        refine ⟨c₀, ?_⟩
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub]
        exact sub_eq_zero.mpr hc₀.symm
      let S_0 : Submonoid B_0 := Submonoid.powers v0_bar
      let S_c : Submonoid B_c := Submonoid.powers uc_bar
      let L_0 := Localization.Away v0_bar
      let L_c := Localization.Away uc_bar
      have hDisj_c : Disjoint (S_c : Set B_c) (𝔪_bar : Set B_c) := by
        rw [Set.disjoint_left]
        rintro _ ⟨n, rfl⟩ hn_mem
        exact huc_not (Ideal.IsPrime.mem_of_pow_mem inferInstance n hn_mem)
      let M_c : Ideal L_c := Ideal.map (algebraMap B_c L_c) 𝔪_bar
      have hMc_prime : M_c.IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint S_c L_c 𝔪_bar inferInstance hDisj_c
      have hMc_under : Ideal.comap (algebraMap B_c L_c) M_c = 𝔪_bar :=
        IsLocalization.under_map_of_isPrime_disjoint S_c L_c inferInstance hDisj_c
      have hRes_Lc : ∀ z : L_c, ∃ c₀ : k,
          z - algebraMap B_c L_c (q_c (MvPolynomial.C c₀)) ∈ M_c := by
        intro z
        obtain ⟨⟨y, s⟩, hzs⟩ := IsLocalization.surj S_c (S := L_c) z
        obtain ⟨c_y, hcy⟩ := hRes_Bc y
        obtain ⟨c_s, hcs⟩ := hRes_Bc (s : B_c)
        have hcs_ne : c_s ≠ 0 := by
          intro h0
          subst h0
          rw [map_zero, map_zero, sub_zero] at hcs
          exact Set.disjoint_left.mp hDisj_c s.2 hcs
        let c₀ : k := c_y / c_s
        have hc₀_mul : c₀ * c_s = c_y := div_mul_cancel₀ c_y hcs_ne
        have hdiff_Bc : y - q_c (MvPolynomial.C c₀) * (s : B_c) ∈ 𝔪_bar := by
          have hC_mul : q_c (MvPolynomial.C c₀) * q_c (MvPolynomial.C c_s) =
              q_c (MvPolynomial.C c_y) := by
            rw [← map_mul, ← map_mul, hc₀_mul]
          have hrew : y - q_c (MvPolynomial.C c₀) * (s : B_c) =
              (y - q_c (MvPolynomial.C c_y)) -
                q_c (MvPolynomial.C c₀) * ((s : B_c) - q_c (MvPolynomial.C c_s)) := by
            calc
              y - q_c (MvPolynomial.C c₀) * (s : B_c)
                  = (y - q_c (MvPolynomial.C c₀) * q_c (MvPolynomial.C c_s)) -
                      q_c (MvPolynomial.C c₀) * ((s : B_c) - q_c (MvPolynomial.C c_s)) := by ring
              _ = (y - q_c (MvPolynomial.C c_y)) -
                      q_c (MvPolynomial.C c₀) * ((s : B_c) - q_c (MvPolynomial.C c_s)) := by
                    rw [hC_mul]
          rw [hrew]
          exact sub_mem hcy (𝔪_bar.mul_mem_left _ hcs)
        have hprod_Mc :
            (z - algebraMap B_c L_c (q_c (MvPolynomial.C c₀))) * algebraMap B_c L_c (s : B_c) ∈ M_c := by
          have heq :
              (z - algebraMap B_c L_c (q_c (MvPolynomial.C c₀))) * algebraMap B_c L_c (s : B_c) =
                algebraMap B_c L_c (y - q_c (MvPolynomial.C c₀) * (s : B_c)) := by
            rw [sub_mul, hzs, map_sub, map_mul]
          rw [heq]
          exact Ideal.mem_map_of_mem _ hdiff_Bc
        obtain ⟨u_s, hu_s⟩ := IsLocalization.map_units L_c s
        refine ⟨c₀, ?_⟩
        have hmul_inv := M_c.mul_mem_right (↑u_s⁻¹ : L_c) hprod_Mc
        rwa [← hu_s, mul_assoc, Units.mul_inv, mul_one] at hmul_inv
      let M_0 : Ideal L_0 := Ideal.comap Ψ.toRingHom M_c
      have hM0_prime : M_0.IsPrime := Ideal.IsPrime.comap Ψ.toRingHom
      let 𝔪_0 : Ideal B_0 := Ideal.comap (algebraMap B_0 L_0) M_0
      have h𝔪0_prime : 𝔪_0.IsPrime := Ideal.IsPrime.comap (algebraMap B_0 L_0)
      have h𝔪0_max : 𝔪_0.IsMaximal := by
        rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
        refine
          { exists_pair_ne := ⟨0, 1, fun h01 => by
              have h1_in : (1 : B_0) ∈ 𝔪_0 := Ideal.Quotient.eq_zero_iff_mem.mp h01.symm
              exact h𝔪0_prime.ne_top (top_unique fun x _ => by simpa using 𝔪_0.mul_mem_left x h1_in)⟩
            mul_comm := mul_comm
            mul_inv_cancel := ?_ }
        intro x_bar hx_ne
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
        have hb_not : b ∉ 𝔪_0 := fun hb_in =>
          hx_ne (Ideal.Quotient.eq_zero_iff_mem.mpr hb_in)
        obtain ⟨c₀, hc₀⟩ := hRes_Lc (Ψ (algebraMap B_0 L_0 b))
        rw [← hΨ_C c₀, ← map_sub, ← map_sub] at hc₀
        have hb_c0 : b - q_0 (MvPolynomial.C c₀) ∈ 𝔪_0 := hc₀
        have hc₀_ne : c₀ ≠ 0 := by
          intro h0
          subst h0
          rw [map_zero, map_zero, sub_zero] at hb_c0
          exact hb_not hb_c0
        refine ⟨Ideal.Quotient.mk 𝔪_0 (q_0 (MvPolynomial.C c₀⁻¹)), ?_⟩
        have hmk_eq : Ideal.Quotient.mk 𝔪_0 b = Ideal.Quotient.mk 𝔪_0 (q_0 (MvPolynomial.C c₀)) :=
          Ideal.Quotient.eq.mpr hb_c0
        rw [hmk_eq, ← map_mul, ← map_mul, ← map_mul, mul_inv_cancel₀ hc₀_ne,
          map_one, map_one, map_one]
      let e₁ : Localization.AtPrime 𝔪_0 ≃+* Localization.AtPrime M_0 :=
        (IsLocalization.localizationLocalizationAtPrimeIsoLocalization S_0 M_0).toRingEquiv
      have hSub_Ψ : Submonoid.map Ψ.toMonoidHom M_0.primeCompl = M_c.primeCompl := by
        ext y
        constructor
        · rintro ⟨x, hx, rfl⟩
          exact hx
        · intro hy
          refine ⟨Ψ.symm y, ?_, Ψ.apply_symm_apply y⟩
          change Ψ (Ψ.symm y) ∉ M_c
          rwa [Ψ.apply_symm_apply]
      let e₂ : Localization.AtPrime M_0 ≃+* Localization.AtPrime M_c :=
        IsLocalization.ringEquivOfRingEquiv (Localization.AtPrime M_0) (Localization.AtPrime M_c)
          Ψ hSub_Ψ
      let e₃ : Localization.AtPrime M_c ≃+* Localization.AtPrime (Ideal.comap (algebraMap B_c L_c) M_c) :=
        (IsLocalization.localizationLocalizationAtPrimeIsoLocalization S_c M_c).symm.toRingEquiv
      have hSub_Bc :
          Submonoid.map (RingEquiv.refl B_c).toMonoidHom
            (Ideal.comap (algebraMap B_c L_c) M_c).primeCompl = 𝔪_bar.primeCompl := by
        ext y
        constructor
        · rintro ⟨x, hx, rfl⟩
          change x ∉ Ideal.comap (algebraMap B_c L_c) M_c at hx
          rwa [hMc_under] at hx
        · intro hy
          refine ⟨y, ?_, rfl⟩
          change y ∉ Ideal.comap (algebraMap B_c L_c) M_c
          rwa [hMc_under]
      let e₄ : Localization.AtPrime (Ideal.comap (algebraMap B_c L_c) M_c) ≃+* R_bar :=
        IsLocalization.ringEquivOfRingEquiv
          (Localization.AtPrime (Ideal.comap (algebraMap B_c L_c) M_c)) R_bar
          (RingEquiv.refl B_c) hSub_Bc
      let e_tot : Localization.AtPrime 𝔪_0 ≃+* R_bar :=
        ((e₁.trans e₂).trans e₃).trans e₄
      obtain ⟨hDom0, hIntCl0⟩ := hLoc0 𝔪_0 h𝔪0_max
      have : IsDomain (Localization.AtPrime 𝔪_0) := hDom0
      have : IsIntegrallyClosed (Localization.AtPrime 𝔪_0) := hIntCl0
      exact ⟨Function.Injective.isDomain e_tot.symm.toRingHom e_tot.symm.injective,
        IsIntegrallyClosed.of_equiv e_tot⟩

    
    have hFin3_succAbove :
        ∀ c c' : Fin 3, c ≠ c' → ∃ j : Fin 2, c'.succAbove j = c := by
      decide

    have hFin3_offdiag :
        ∀ c c' : Fin 3, c ≠ c' →
          (∃ j₀ : Fin 2, c = (0 : Fin 3).succAbove j₀ ∧ c' = 0) ∨
          (∃ j₀ : Fin 2, c = 0 ∧ c' = (0 : Fin 3).succAbove j₀) ∨
          (c = 1 ∧ c' = 2) ∨
          (c = 2 ∧ c' = 1) := by
      decide

    have hAlg_Bc :
        ∀ {R : Type u} [CommRing R] (u t b e0 q0 qc hc h0 : R) (Nc mc d kq : ℕ),
          Nc = kq + d →
          u * t = 1 →
          b * t ^ mc = e0 →
          qc * t ^ kq = q0 →
          hc * t ^ d = h0 →
          e0 ^ 2 - e0 = h0 * q0 →
          (u ^ Nc * (b * (b - u ^ mc))) * t ^ (Nc + 2 * mc) =
            (hc * (u ^ (2 * mc) * qc)) * t ^ (Nc + 2 * mc) := by
      intro R _ u t b e0 q0 qc hc h0 Nc mc d kq hNc hut hbt hqt hht he0
      subst hNc
      have hUN : u ^ (kq + d) * t ^ (kq + d) = 1 := by rw [← mul_pow, hut, one_pow]
      have hUm : u ^ mc * t ^ mc = 1 := by rw [← mul_pow, hut, one_pow]
      have h1 : t ^ (kq + d + 2 * mc) = t ^ (kq + d) * t ^ mc * t ^ mc := by
        simp only [two_mul, pow_add]
        ring
      have h2 : t ^ (kq + d + 2 * mc) = t ^ kq * t ^ d * t ^ mc * t ^ mc := by
        simp only [two_mul, pow_add]
        ring
      have h3 : u ^ (2 * mc) = u ^ mc * u ^ mc := by rw [two_mul, pow_add]
      have hL : (u ^ (kq + d) * (b * (b - u ^ mc))) * t ^ (kq + d + 2 * mc) = e0 ^ 2 - e0 := by
        rw [h1]
        calc
          (u ^ (kq + d) * (b * (b - u ^ mc))) * (t ^ (kq + d) * t ^ mc * t ^ mc)
              = (u ^ (kq + d) * t ^ (kq + d)) * (b * t ^ mc) *
                  (b * t ^ mc - u ^ mc * t ^ mc) := by ring
          _ = 1 * e0 * (e0 - 1) := by rw [hUN, hbt, hUm]
          _ = e0 ^ 2 - e0 := by ring
      have hR : (hc * (u ^ (2 * mc) * qc)) * t ^ (kq + d + 2 * mc) = h0 * q0 := by
        rw [h2, h3]
        calc
          (hc * ((u ^ mc * u ^ mc) * qc)) * (t ^ kq * t ^ d * t ^ mc * t ^ mc)
              = (hc * t ^ d) * (u ^ mc * t ^ mc) * (u ^ mc * t ^ mc) * (qc * t ^ kq) := by ring
          _ = h0 * 1 * 1 * q0 := by rw [hht, hUm, hqt]
          _ = h0 * q0 := by ring
      rw [hL, hR, he0]

    have hAlg_12 :
        ∀ {R : Type u} [CommRing R]
          (u v t1 t2 e1 e2 r1 r2 E21 R21 h1 h2 : R)
          (m1 m2 K d : ℕ),
          u * t1 = 1 →
          u * t2 = v →
          h1 = h2 * v ^ d →
          E21 = e2 * v ^ K →
          R21 = r2 * v ^ K →
          e2 - e1 = h1 * (r1 * t1 ^ m1) - h2 * (r2 * t2 ^ m2) →
          (u ^ (m1 + m2) * (E21 * v ^ d - e1 * v ^ (K + d))) * (t1 ^ m1 * t2 ^ m2) =
            (h1 * (r1 * u ^ m2 * v ^ (K + d) - R21 * u ^ m1 * v ^ m2)) * (t1 ^ m1 * t2 ^ m2) := by
      intro R _ u v t1 t2 e1 e2 r1 r2 E21 R21 h1 h2 m1 m2 K d hut1 hut2 hh1 hE hR he21
      have hUm1 : u ^ m1 * t1 ^ m1 = 1 := by rw [← mul_pow, hut1, one_pow]
      have hUm2 : u ^ m2 * t2 ^ m2 = v ^ m2 := by rw [← mul_pow, hut2]
      rw [pow_add u m1 m2, hE, hR, pow_add v K d]
      calc
        ((u ^ m1 * u ^ m2) * (e2 * v ^ K * v ^ d - e1 * (v ^ K * v ^ d))) * (t1 ^ m1 * t2 ^ m2)
            = (u ^ m1 * t1 ^ m1) * (u ^ m2 * t2 ^ m2) * (e2 - e1) * (v ^ K * v ^ d) := by ring
        _ = 1 * v ^ m2 * (h1 * (r1 * t1 ^ m1) - h2 * (r2 * t2 ^ m2)) * (v ^ K * v ^ d) := by
              rw [hUm1, hUm2, he21]
        _ = v ^ m2 * h1 * (r1 * t1 ^ m1) * (v ^ K * v ^ d) -
            v ^ m2 * (h2 * v ^ d) * (r2 * t2 ^ m2) * v ^ K := by ring
        _ = (u ^ m2 * t2 ^ m2) * h1 * (r1 * t1 ^ m1) * (v ^ K * v ^ d) -
            v ^ m2 * h1 * (u ^ m1 * t1 ^ m1) * (r2 * t2 ^ m2) * v ^ K := by
              rw [← hh1, ← hUm2, hUm1]
              ring
        _ = (h1 * (r1 * u ^ m2 * (v ^ K * v ^ d) - r2 * v ^ K * u ^ m1 * v ^ m2)) *
            (t1 ^ m1 * t2 ^ m2) := by ring

    
    let B₂_type : Fin 3 → Type u := fun c =>
      ↥(letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        integralClosure A L₂)
    let _instCommRingB₂ : ∀ c : Fin 3, CommRing (B₂_type c) := fun c =>
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      inferInstance
    let mapB : ∀ c : Fin 3, A →+* B₂_type c := fun c =>
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      algebraMap A (B₂_type c)
    let valB : ∀ c : Fin 3, B₂_type c →+* L₂ := fun c =>
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      (integralClosure A L₂).val.toRingHom
    let I_h : ∀ c : Fin 3, Ideal (B₂_type c) := fun c =>
      Ideal.span {mapB c (eval_c c H_Sigma)}
    let B_quot : Fin 3 → Type u := fun c => B₂_type c ⧸ I_h c
    let _instCommRingBquot : ∀ c : Fin 3, CommRing (B_quot c) := fun c =>
      Ideal.Quotient.commRing (I_h c)

    have hLoc0_std :
        ∀ (𝔪_0 : Ideal (B_quot 0)) [𝔪_0.IsPrime], 𝔪_0.IsMaximal →
          IsDomain (Localization.AtPrime 𝔪_0) ∧
            IsIntegrallyClosed (Localization.AtPrime 𝔪_0) := by
      intro 𝔪_0 _ h𝔪0_max
      exact hLocalDVR_0 (B_quot 0) 𝔪_0 (Localization.AtPrime 𝔪_0) h𝔪0_max
        ⟨RingEquiv.refl (B_quot 0)⟩

    have hAllLoc_c :
        ∀ (j₀ : Fin 2),
          let c : Fin 3 := (0 : Fin 3).succAbove j₀
          ![P₀, P₁, P₂] c ≠ 0 →
          ∀ (B_bar : Type u) [CommRing B_bar]
            (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
            (R_bar : Type u) [CommRing R_bar] [Algebra B_bar R_bar]
            [IsLocalization.AtPrime R_bar 𝔪_bar],
            𝔪_bar.IsMaximal →
            Nonempty (B_quot c ≃+* B_bar) →
            IsDomain R_bar ∧ IsIntegrallyClosed R_bar := by
      intro j₀ c hPc B_bar _ 𝔪_bar _ R_bar _ _ _ h𝔪_max ⟨e_bar⟩
      have hc_ne0 : c ≠ 0 := Fin.succAbove_ne 0 j₀
      let uc_bar_0 : B_quot c := Ideal.Quotient.mk (I_h c) (mapB c (MvPolynomial.X 0))
      by_cases h_in : e_bar uc_bar_0 ∈ 𝔪_bar
      · exact (hBdry c hc_ne0 hPc).2 B_bar 𝔪_bar R_bar e_bar h𝔪_max h_in
      · let q_0 : A →+* B_quot 0 := (Ideal.Quotient.mk (I_h 0)).comp (mapB 0)
        let q_c : A →+* B_bar := e_bar.toRingHom.comp ((Ideal.Quotient.mk (I_h c)).comp (mapB c))
        have hInt_qc : q_c.IsIntegral := by
          intro y
          obtain ⟨z, hz_mk⟩ := Ideal.Quotient.mk_surjective (e_bar.symm y)
          have hz_eq : e_bar (Ideal.Quotient.mk (I_h c) z) = y := by
            rw [hz_mk, e_bar.apply_symm_apply]
          obtain ⟨P, hP_mon, hP_eval⟩ := z.2
          refine ⟨P, hP_mon, ?_⟩
          have hz_B2 : Polynomial.eval₂ (mapB c) z P = 0 := by
            apply Subtype.ext
            have hcomp : (valB c).comp (mapB c) = (algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom :=
              RingHom.ext fun _ => rfl
            have hval : (valB c) (Polynomial.eval₂ (mapB c) z P) =
                Polynomial.eval₂ ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom) (z : L₂) P := by
              rw [Polynomial.hom_eval₂, hcomp]
              rfl
            exact hval.trans hP_eval
          have hy_eval :
              Polynomial.eval₂ q_c y P =
                e_bar (Ideal.Quotient.mk (I_h c) (Polynomial.eval₂ (mapB c) z P)) := by
            rw [← hz_eq]
            exact (Polynomial.hom_eval₂ P (mapB c)
              (e_bar.toRingHom.comp (Ideal.Quotient.mk (I_h c))) z).symm
          rw [hy_eval, hz_B2, map_zero, map_zero]
        obtain ⟨_, Ψ, hΨ_C⟩ :=
          hOv0c j₀ (B_quot 0) B_bar q_0 q_c
            ⟨RingEquiv.refl (B_quot 0), fun _ => rfl⟩
            ⟨e_bar, fun _ => rfl⟩
        exact hAwayTransfer (B_quot 0) B_bar q_0 q_c hInt_qc (q_0 (MvPolynomial.X j₀))
          (q_c (MvPolynomial.X 0)) Ψ hΨ_C hLoc0_std 𝔪_bar R_bar h𝔪_max h_in

    
    let τ : Fin 3 → L₂ := fun c => algebraMap K₂ L₂ (homCoord c)
    let h_tilde : Fin 3 → L₂ := fun c => algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))

    have hτ_0 : τ 0 = 1 := by
      dsimp [τ]
      rw [hCoord0, map_one]

    have hτ_ne : ∀ c : Fin 3, τ c ≠ 0 := by
      intro c
      dsimp [τ]
      exact (map_ne_zero_iff (algebraMap K₂ L₂) (algebraMap K₂ L₂).injective).mpr (hHomNe0 c)

    have hh_scale : ∀ c c' : Fin 3, h_tilde c' * (τ c') ^ d_Sigma = h_tilde c * (τ c) ^ d_Sigma := by
      intro c c'
      dsimp [h_tilde, τ]
      rw [← map_pow, ← map_mul, ← map_pow, ← map_mul, hHomScale c c']

    have hh_scale_0 : ∀ c : Fin 3, h_tilde c * (τ c) ^ d_Sigma = h_tilde 0 := by
      intro c
      have h0 := hh_scale 0 c
      rw [hτ_0, one_pow, mul_one] at h0
      exact h0

    have hφ0_X : ∀ j₀ : Fin 2,
        algebraMap K₂ L₂ (φ_K₂ 0 (MvPolynomial.X j₀)) = τ ((0 : Fin 3).succAbove j₀) := by
      intro j₀
      rw [hCoord_φ0 j₀]

    have hφc_X0_mul : ∀ j₀ : Fin 2,
        let c : Fin 3 := (0 : Fin 3).succAbove j₀
        algebraMap K₂ L₂ (φ_K₂ c (MvPolynomial.X 0)) * τ c = 1 := by
      intro j₀ c
      dsimp [τ]
      rw [← map_mul, hCoord_φc_X0 j₀, map_one]

    have hφ1_X0_τ2 :
        algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 0)) * τ 2 =
          algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1)) := by
      dsimp [τ]
      rw [← map_mul, hCoord_1_X0]

    have hφ12_X1_mul :
        algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1)) *
          algebraMap K₂ L₂ (φ_K₂ 2 (MvPolynomial.X 1)) = 1 := by
      rw [← map_mul, hCoord_12_X1, map_one]

    have hv1_ne : algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1)) ≠ 0 := by
      intro h0
      rw [h0, zero_mul] at hφ12_X1_mul
      exact zero_ne_one hφ12_X1_mul

    have hh_12_scale :
        h_tilde 2 * (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ d_Sigma = h_tilde 1 := by
      let u₁_L := algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 0))
      have hu₁_τ1 : u₁_L * τ 1 = 1 := by
        have h := hφc_X0_mul 0
        have hsa0 : (0 : Fin 3).succAbove 0 = 1 := by decide
        dsimp only at h
        rwa [hsa0] at h
      have hu₁_τ2 : u₁_L * τ 2 = algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1)) := hφ1_X0_τ2
      calc
        h_tilde 2 * (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ d_Sigma
            = h_tilde 2 * (u₁_L ^ d_Sigma * (τ 2) ^ d_Sigma) := by rw [← hu₁_τ2, mul_pow]
        _ = (h_tilde 2 * (τ 2) ^ d_Sigma) * u₁_L ^ d_Sigma := by
              rw [mul_comm (u₁_L ^ d_Sigma), ← mul_assoc]
        _ = (h_tilde 1 * (τ 1) ^ d_Sigma) * u₁_L ^ d_Sigma := by rw [hh_scale 1 2]
        _ = h_tilde 1 * (u₁_L * τ 1) ^ d_Sigma := by
              rw [mul_assoc, mul_comm ((τ 1) ^ d_Sigma), mul_pow]
        _ = h_tilde 1 := by rw [hu₁_τ1, one_pow, mul_one]

    have hInt_sup_comm :
        ∀ (c₁ c₂ : Fin 3) (w : L₂),
          (let R₁₂ : Subalgebra k K₂ := (φ_K₂ c₁).range ⊔ (φ_K₂ c₂).range
           letI : Algebra ↥R₁₂ L₂ := ((algebraMap K₂ L₂).comp R₁₂.val.toRingHom).toAlgebra
           _root_.IsIntegral ↥R₁₂ w) →
          (let R₂₁ : Subalgebra k K₂ := (φ_K₂ c₂).range ⊔ (φ_K₂ c₁).range
           letI : Algebra ↥R₂₁ L₂ := ((algebraMap K₂ L₂).comp R₂₁.val.toRingHom).toAlgebra
           _root_.IsIntegral ↥R₂₁ w) := by
      intro c₁ c₂ w hw
      dsimp only at hw ⊢
      let R₁₂ : Subalgebra k K₂ := (φ_K₂ c₁).range ⊔ (φ_K₂ c₂).range
      let R₂₁ : Subalgebra k K₂ := (φ_K₂ c₂).range ⊔ (φ_K₂ c₁).range
      let ι_ov : ↥R₁₂ →+* ↥R₂₁ :=
        (Subalgebra.inclusion (le_of_eq (sup_comm (φ_K₂ c₁).range (φ_K₂ c₂).range))).toRingHom
      obtain ⟨P, hP_mon, hP_eval⟩ := hw
      refine ⟨P.map ι_ov, hP_mon.map ι_ov, ?_⟩
      rw [Polynomial.eval₂_map]
      exact hP_eval

    have hClear_0c :
        ∀ (j₀ : Fin 2) (z₀ : L₂),
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
           _root_.IsIntegral A z₀) →
          let c : Fin 3 := (0 : Fin 3).succAbove j₀
          ∃ (m : ℕ) (z_c : B₂_type c),
            (z_c : L₂) * (τ c) ^ m = z₀ := by
      intro j₀ z₀ hz₀
      let c : Fin 3 := (0 : Fin 3).succAbove j₀
      let q_0 : A →+* B_quot 0 := (Ideal.Quotient.mk (I_h 0)).comp (mapB 0)
      let q_c : A →+* B_quot c := (Ideal.Quotient.mk (I_h c)).comp (mapB c)
      exact (hOv0c j₀ (B_quot 0) (B_quot c) q_0 q_c
        ⟨RingEquiv.refl (B_quot 0), fun _ => rfl⟩
        ⟨RingEquiv.refl (B_quot c), fun _ => rfl⟩).1 z₀ hz₀

    have hChart0_idemp_triv :
        ∀ e_bar : B_quot 0, e_bar ^ 2 = e_bar → e_bar = 0 ∨ e_bar = 1 := by
      intro e_bar he_bar
      obtain ⟨e₀, he₀_mk⟩ := Ideal.Quotient.mk_surjective e_bar
      have he₀_mem : e₀ ^ 2 - e₀ ∈ I_h 0 := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [map_sub, map_pow, he₀_mk, he_bar, sub_self]
      obtain ⟨q₀, hq₀_eq⟩ := Ideal.mem_span_singleton.mp he₀_mem
      have he₀_L : (e₀ : L₂) ^ 2 - (e₀ : L₂) = h_tilde 0 * (q₀ : L₂) :=
        congrArg (valB 0) hq₀_eq
      have hP₀_ne0 : ![P₀, P₁, P₂] 0 ≠ 0 := hP₀_mon.ne_zero

      have hLift_all :
          ∀ c : Fin 3,
            ∃ (e_c : B₂_type c),
              (∀ hc0 : c = 0, e_c = hc0 ▸ e₀) ∧
              e_c ^ 2 - e_c ∈ I_h c ∧
              (![P₀, P₁, P₂] c = 0 → (e_c : L₂) = 0) ∧
              (∀ j₀ : Fin 2, (0 : Fin 3).succAbove j₀ = c → ![P₀, P₁, P₂] c ≠ 0 →
                ∃ (m₀_c : ℕ) (r_c : B₂_type c),
                  (e₀ : L₂) - (e_c : L₂) = h_tilde c * ((r_c : L₂) * (τ c) ^ (m₀_c + d_Sigma))) := by
        intro c
        by_cases hc0 : c = 0
        · subst hc0
          refine ⟨e₀, fun _ => rfl, he₀_mem, fun h0 => absurd h0 hP₀_ne0, ?_⟩
          intro j₀ hj₀
          exact absurd hj₀ (Fin.succAbove_ne 0 j₀)
        · obtain ⟨j₀, hj₀⟩ := hFin3_succAbove c 0 hc0
          subst hj₀
          let cs : Fin 3 := (0 : Fin 3).succAbove j₀
          by_cases hPc : ![P₀, P₁, P₂] cs = 0
          · refine ⟨0, fun h0 => absurd h0 hc0, ?_, fun _ => rfl, fun _ _ hne => absurd hPc hne⟩
            have h0 : (0 : B₂_type cs) ^ 2 - 0 = 0 := by rw [sq, zero_mul, sub_zero]
            rw [h0]
            exact (I_h cs).zero_mem
          · obtain ⟨m₀, b₀, hb₀_eq⟩ := hClear_0c j₀ (e₀ : L₂) e₀.2
            obtain ⟨k_q, q_c, hqc_eq⟩ := hClear_0c j₀ (q₀ : L₂) q₀.2
            let u_Bc : B₂_type cs := mapB cs (MvPolynomial.X 0)
            let h_Bc : B₂_type cs := mapB cs (eval_c cs H_Sigma)
            have hu_Bc_τ : (u_Bc : L₂) * τ cs = 1 := hφc_X0_mul j₀
            let m_c : ℕ := m₀ + d_Sigma
            let b_c : B₂_type cs := b₀ * u_Bc ^ d_Sigma
            let N_c : ℕ := k_q + d_Sigma
            have hbc_τ : (b_c : L₂) * (τ cs) ^ m_c = (e₀ : L₂) := by
              have hbc_val : (b_c : L₂) = (b₀ : L₂) * (u_Bc : L₂) ^ d_Sigma := rfl
              dsimp only [m_c]
              rw [hbc_val, pow_add, mul_mul_mul_comm, hb₀_eq, ← mul_pow, hu_Bc_τ, one_pow, mul_one]
            have h_id_Bc :
                u_Bc ^ N_c * (b_c * (b_c - u_Bc ^ m_c)) = h_Bc * (u_Bc ^ (2 * m_c) * q_c) := by
              apply Subtype.ext
              apply mul_right_cancel₀ (pow_ne_zero (N_c + 2 * m_c) (hτ_ne cs))
              exact hAlg_Bc (u_Bc : L₂) (τ cs) (b_c : L₂) (e₀ : L₂) (q₀ : L₂) (q_c : L₂)
                (h_tilde cs) (h_tilde 0) N_c m_c d_Sigma k_q rfl hu_Bc_τ hbc_τ hqc_eq
                (hh_scale_0 cs) he₀_L
            let π_c : B₂_type cs →+* B_quot cs := Ideal.Quotient.mk (I_h cs)
            let uc_bar : B_quot cs := π_c u_Bc
            have h_quot_eq : uc_bar ^ N_c * (π_c b_c * (π_c b_c - uc_bar ^ m_c)) = 0 := by
              have hmap := congrArg π_c h_id_Bc
              have hh_zero : π_c h_Bc = 0 :=
                Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
              simpa only [map_mul, map_sub, map_pow, hh_zero, zero_mul] using hmap
            have h_bc_bar : π_c b_c * (π_c b_c - uc_bar ^ m_c) = 0 :=
              hRegPow (hBdry cs hc0 hPc).1 N_c _ h_quot_eq
            have hLocDom_cs :
                ∀ (𝔪 : Ideal (B_quot cs)) [𝔪.IsPrime], 𝔪.IsMaximal →
                  IsDomain (Localization.AtPrime 𝔪) := by
              intro 𝔪 _ h𝔪
              exact (hAllLoc_c j₀ hPc (B_quot cs) 𝔪 (Localization.AtPrime 𝔪) h𝔪
                ⟨RingEquiv.refl (B_quot cs)⟩).1
            obtain ⟨e_bar_c, he_bar_c_sq, hbc_bar_eq⟩ :=
              hConductor (B_quot cs) uc_bar (π_c b_c) m_c
                (hBdry cs hc0 hPc).1 hLocDom_cs h_bc_bar
            obtain ⟨e_c, hec_mk⟩ := Ideal.Quotient.mk_surjective e_bar_c
            have hec_mem : e_c ^ 2 - e_c ∈ I_h cs := by
              apply Ideal.Quotient.eq_zero_iff_mem.mp
              change π_c (e_c ^ 2 - e_c) = 0
              rw [sq, map_sub, map_mul, hec_mk, he_bar_c_sq, sub_self]
            have hbc_diff_mem : b_c - e_c * u_Bc ^ m_c ∈ I_h cs := by
              apply Ideal.Quotient.eq_zero_iff_mem.mp
              change π_c (b_c - e_c * u_Bc ^ m_c) = 0
              rw [map_sub, hbc_bar_eq, map_mul, map_pow, hec_mk, sub_self]
            obtain ⟨r_c, hrc_eq⟩ := Ideal.mem_span_singleton.mp hbc_diff_mem
            have he0_sub_ec :
                (e₀ : L₂) - (e_c : L₂) = h_tilde cs * ((r_c : L₂) * (τ cs) ^ (m₀ + d_Sigma)) := by
              have hval := congrArg (valB cs) hrc_eq
              change (b_c : L₂) - (e_c : L₂) * (u_Bc : L₂) ^ m_c = h_tilde cs * (r_c : L₂) at hval
              have hUm : (u_Bc : L₂) ^ m_c * (τ cs) ^ m_c = 1 := by
                rw [← mul_pow, hu_Bc_τ, one_pow]
              calc
                (e₀ : L₂) - (e_c : L₂)
                    = (b_c : L₂) * (τ cs) ^ m_c - (e_c : L₂) * ((u_Bc : L₂) ^ m_c * (τ cs) ^ m_c) := by
                      rw [hbc_τ, hUm, mul_one]
                _ = ((b_c : L₂) - (e_c : L₂) * (u_Bc : L₂) ^ m_c) * (τ cs) ^ m_c := by
                      rw [sub_mul, mul_assoc]
                _ = (h_tilde cs * (r_c : L₂)) * (τ cs) ^ m_c := by rw [hval]
                _ = h_tilde cs * ((r_c : L₂) * (τ cs) ^ (m₀ + d_Sigma)) := by
                      dsimp only [m_c]; rw [mul_assoc]
            refine ⟨e_c, fun h0 => absurd h0 hc0, hec_mem, fun h0 => absurd h0 hPc, ?_⟩
            intro j₀' hj₀' _
            have hj_eq : j₀' = j₀ := Fin.succAbove_right_injective hj₀'
            subst hj_eq
            exact ⟨m₀, r_c, he0_sub_ec⟩

      choose e_chart he_chart_0_imp he_chart_idemp he_chart_zero_of_deg he_chart_rel using hLift_all
      have he_chart_0 : e_chart 0 = e₀ := he_chart_0_imp 0 rfl

      have hOv_12_nondeg :
          ![P₀, P₁, P₂] 1 ≠ 0 → ![P₀, P₁, P₂] 2 ≠ 0 →
          ∃ (K_pow : ℕ) (r₁₂ : B₂_type 1),
            ((e_chart 2 : L₂) - (e_chart 1 : L₂)) *
              (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ (K_pow + d_Sigma) =
              h_tilde 1 * (r₁₂ : L₂) := by
        intro hP₁ hP₂
        have hsa0 : (0 : Fin 3).succAbove 0 = 1 := by decide
        have hsa1 : (0 : Fin 3).succAbove 1 = 2 := by decide
        obtain ⟨m₀_1, r₁_B, hrel1⟩ := he_chart_rel 1 0 hsa0 hP₁
        obtain ⟨m₀_2, r₂_B, hrel2⟩ := he_chart_rel 2 1 hsa1 hP₂
        let m₁ : ℕ := m₀_1 + d_Sigma
        let m₂ : ℕ := m₀_2 + d_Sigma
        have he2_sub_e1 :
            (e_chart 2 : L₂) - (e_chart 1 : L₂) =
              h_tilde 1 * ((r₁_B : L₂) * (τ 1) ^ m₁) -
                h_tilde 2 * ((r₂_B : L₂) * (τ 2) ^ m₂) := by
          dsimp only [m₁, m₂]
          calc
            (e_chart 2 : L₂) - (e_chart 1 : L₂)
                = ((e₀ : L₂) - (e_chart 1 : L₂)) - ((e₀ : L₂) - (e_chart 2 : L₂)) := by ring
            _ = h_tilde 1 * ((r₁_B : L₂) * (τ 1) ^ (m₀_1 + d_Sigma)) -
                  h_tilde 2 * ((r₂_B : L₂) * (τ 2) ^ (m₀_2 + d_Sigma)) := by rw [hrel1, hrel2]
        let u_B1 : B₂_type 1 := mapB 1 (MvPolynomial.X 0)
        let v_B1 : B₂_type 1 := mapB 1 (MvPolynomial.X 1)
        let h_B1 : B₂_type 1 := mapB 1 (eval_c 1 H_Sigma)
        have hv_B1_val : (v_B1 : L₂) = algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1)) := rfl
        have hu1_τ1 : (u_B1 : L₂) * τ 1 = 1 := by
          have h := hφc_X0_mul 0
          dsimp only at h
          rwa [hsa0] at h
        have hu1_τ2 : (u_B1 : L₂) * τ 2 = (v_B1 : L₂) := hφ1_X0_τ2
        obtain ⟨k_e, e₂₁_raw, he₂₁_eq⟩ := hOv21.1 (e_chart 2 : L₂) (e_chart 2).2
        obtain ⟨k_r, r₂₁_raw, hr₂₁_eq⟩ := hOv21.1 (r₂_B : L₂) (r₂_B).2
        let e₂₁ : B₂_type 1 := e₂₁_raw
        let r₂₁ : B₂_type 1 := r₂₁_raw
        let K_pow : ℕ := k_e + k_r
        let E₂₁ : B₂_type 1 := e₂₁ * v_B1 ^ k_r
        let R₂₁ : B₂_type 1 := r₂₁ * v_B1 ^ k_e
        have hE₂₁_L : (E₂₁ : L₂) = (e_chart 2 : L₂) * (v_B1 : L₂) ^ K_pow := by
          change (e₂₁_raw : L₂) * (v_B1 : L₂) ^ k_r = (e_chart 2 : L₂) * (v_B1 : L₂) ^ (k_e + k_r)
          rw [he₂₁_eq, ← hv_B1_val, pow_add, mul_assoc]
        have hR₂₁_L : (R₂₁ : L₂) = (r₂_B : L₂) * (v_B1 : L₂) ^ K_pow := by
          change (r₂₁_raw : L₂) * (v_B1 : L₂) ^ k_e = (r₂_B : L₂) * (v_B1 : L₂) ^ (k_e + k_r)
          rw [hr₂₁_eq, ← hv_B1_val, add_comm k_e k_r, pow_add, mul_assoc]
        have h_id_B1 :
            u_B1 ^ (m₁ + m₂) * (E₂₁ * v_B1 ^ d_Sigma - e_chart 1 * v_B1 ^ (K_pow + d_Sigma)) =
              h_B1 * (r₁_B * u_B1 ^ m₂ * v_B1 ^ (K_pow + d_Sigma) -
                R₂₁ * u_B1 ^ m₁ * v_B1 ^ m₂) := by
          apply Subtype.ext
          have hT12_ne : (τ 1) ^ m₁ * (τ 2) ^ m₂ ≠ 0 :=
            mul_ne_zero (pow_ne_zero m₁ (hτ_ne 1)) (pow_ne_zero m₂ (hτ_ne 2))
          apply mul_right_cancel₀ hT12_ne
          exact hAlg_12 (u_B1 : L₂) (v_B1 : L₂) (τ 1) (τ 2) (e_chart 1 : L₂) (e_chart 2 : L₂)
            (r₁_B : L₂) (r₂_B : L₂) (E₂₁ : L₂) (R₂₁ : L₂) (h_tilde 1) (h_tilde 2)
            m₁ m₂ K_pow d_Sigma hu1_τ1 hu1_τ2 hh_12_scale.symm hE₂₁_L hR₂₁_L he2_sub_e1
        let π₁ : B₂_type 1 →+* B_quot 1 := Ideal.Quotient.mk (I_h 1)
        have h_quot_B1 :
            (π₁ u_B1) ^ (m₁ + m₂) *
              π₁ (E₂₁ * v_B1 ^ d_Sigma - e_chart 1 * v_B1 ^ (K_pow + d_Sigma)) = 0 := by
          have hmap := congrArg π₁ h_id_B1
          have hh1_zero : π₁ h_B1 = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          simpa only [map_mul, map_pow, hh1_zero, zero_mul] using hmap
        have h_diff_zero :
            π₁ (E₂₁ * v_B1 ^ d_Sigma - e_chart 1 * v_B1 ^ (K_pow + d_Sigma)) = 0 :=
          hRegPow (hBdry 1 (by decide) hP₁).1 (m₁ + m₂) _ h_quot_B1
        obtain ⟨r₁₂, hr₁₂_eq⟩ :=
          Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h_diff_zero)
        refine ⟨K_pow, r₁₂, ?_⟩
        have hval := congrArg (valB 1) hr₁₂_eq
        change (E₂₁ : L₂) * (v_B1 : L₂) ^ d_Sigma -
          (e_chart 1 : L₂) * (v_B1 : L₂) ^ (K_pow + d_Sigma) = h_tilde 1 * (r₁₂ : L₂) at hval
        rw [← hv_B1_val, ← hval, hE₂₁_L, sub_mul, pow_add, ← mul_assoc]

      have he_chart_ov :
          ∀ c c' : Fin 3,
            let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
            letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
            ∃ w : L₂,
              _root_.IsIntegral ↥R_ov w ∧
              (e_chart c' : L₂) - (e_chart c : L₂) = h_tilde c * w := by
        intro c c'
        dsimp only
        by_cases hcc' : c = c'
        · subst hcc'
          let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c).range
          exact ⟨0, @isIntegral_zero ↥R_ov L₂ _ _
            (((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra), by rw [sub_self, mul_zero]⟩
        · by_cases hPc : ![P₀, P₁, P₂] c = 0
          · obtain ⟨g_inv, hg_inv⟩ := isUnit_iff_exists_inv.mp (hDegUnit c hPc)
            let w : L₂ := (e_chart c' : L₂) * algebraMap K₂ L₂ (φ_K₂ c g_inv)
            have hw_int_symm := hOv21.2 c' c (e_chart c' : L₂) (e_chart c').2 g_inv
            have hw_int := hInt_sup_comm c' c w hw_int_symm
            refine ⟨w, hw_int, ?_⟩
            have hec0 : (e_chart c : L₂) = 0 := he_chart_zero_of_deg c hPc
            have hh_inv : h_tilde c * algebraMap K₂ L₂ (φ_K₂ c g_inv) = 1 := by
              dsimp [h_tilde]
              rw [← map_mul, ← map_mul, hg_inv, map_one, map_one]
            rw [hec0, sub_zero]
            dsimp [w]
            rw [← mul_assoc, mul_right_comm (h_tilde c), hh_inv, one_mul]
          · by_cases hPc' : ![P₀, P₁, P₂] c' = 0
            · obtain ⟨g_inv, hg_inv⟩ := isUnit_iff_exists_inv.mp (hDegUnit c' hPc')
              obtain ⟨j, hj_eq⟩ := hFin3_succAbove c c' hcc'
              let g' : A := (MvPolynomial.X j) ^ d_Sigma * g_inv
              let w : L₂ := (-(e_chart c : L₂)) * algebraMap K₂ L₂ (φ_K₂ c' g')
              have hw_int := hOv21.2 c c' (-(e_chart c : L₂)) (-e_chart c).2 g'
              refine ⟨w, hw_int, ?_⟩
              have hec'0 : (e_chart c' : L₂) = 0 := he_chart_zero_of_deg c' hPc'
              have hXj_mul : algebraMap K₂ L₂ (φ_K₂ c' (MvPolynomial.X j)) * τ c' = τ c := by
                dsimp [τ]
                rw [← map_mul, hCoord_succ c c' j hj_eq]
              have hh_g' : h_tilde c * algebraMap K₂ L₂ (φ_K₂ c' g') = 1 := by
                apply mul_right_cancel₀ (pow_ne_zero d_Sigma (hτ_ne c))
                have h_inv_L : h_tilde c' * algebraMap K₂ L₂ (φ_K₂ c' g_inv) = 1 := by
                  dsimp [h_tilde]
                  rw [← map_mul, ← map_mul, hg_inv, map_one, map_one]
                have h_g'_L :
                    algebraMap K₂ L₂ (φ_K₂ c' g') =
                      (algebraMap K₂ L₂ (φ_K₂ c' (MvPolynomial.X j))) ^ d_Sigma *
                        algebraMap K₂ L₂ (φ_K₂ c' g_inv) := by
                  dsimp [g']
                  rw [map_mul, map_pow, map_mul, map_pow]
                rw [h_g'_L, one_mul]
                calc
                  (h_tilde c * ((algebraMap K₂ L₂ (φ_K₂ c' (MvPolynomial.X j))) ^ d_Sigma *
                      algebraMap K₂ L₂ (φ_K₂ c' g_inv))) * (τ c) ^ d_Sigma
                      = (h_tilde c * (τ c) ^ d_Sigma) *
                          (algebraMap K₂ L₂ (φ_K₂ c' (MvPolynomial.X j))) ^ d_Sigma *
                          algebraMap K₂ L₂ (φ_K₂ c' g_inv) := by ring
                  _ = (h_tilde c' * (τ c') ^ d_Sigma) *
                        (algebraMap K₂ L₂ (φ_K₂ c' (MvPolynomial.X j))) ^ d_Sigma *
                        algebraMap K₂ L₂ (φ_K₂ c' g_inv) := by rw [← hh_scale c c']
                  _ = (h_tilde c' * algebraMap K₂ L₂ (φ_K₂ c' g_inv)) *
                        (algebraMap K₂ L₂ (φ_K₂ c' (MvPolynomial.X j)) * τ c') ^ d_Sigma := by
                        rw [mul_pow]; ring
                  _ = (τ c) ^ d_Sigma := by rw [h_inv_L, hXj_mul, one_mul]
              rw [hec'0, zero_sub]
              dsimp [w]
              rw [← mul_assoc, mul_right_comm (h_tilde c), hh_g', one_mul]
            · have hPair_0_succ :
                  ∀ j₀ : Fin 2,
                    let cs : Fin 3 := (0 : Fin 3).succAbove j₀
                    ![P₀, P₁, P₂] cs ≠ 0 →
                    (let R_ov : Subalgebra k K₂ := (φ_K₂ cs).range ⊔ (φ_K₂ 0).range
                     letI : Algebra ↥R_ov L₂ :=
                       ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
                     ∃ w : L₂,
                       _root_.IsIntegral ↥R_ov w ∧
                       (e_chart 0 : L₂) - (e_chart cs : L₂) = h_tilde cs * w) ∧
                    (let R_ov : Subalgebra k K₂ := (φ_K₂ 0).range ⊔ (φ_K₂ cs).range
                     letI : Algebra ↥R_ov L₂ :=
                       ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
                     ∃ w : L₂,
                       _root_.IsIntegral ↥R_ov w ∧
                       (e_chart cs : L₂) - (e_chart 0 : L₂) = h_tilde 0 * w) := by
                intro j₀ cs hPcs
                obtain ⟨m₀_c, r_c, hrel⟩ := he_chart_rel cs j₀ rfl hPcs
                refine ⟨?_, ?_⟩
                · dsimp only
                  let g' : A := (MvPolynomial.X j₀) ^ (m₀_c + d_Sigma)
                  let w : L₂ := (r_c : L₂) * algebraMap K₂ L₂ (φ_K₂ 0 g')
                  refine ⟨w, hOv21.2 cs 0 (r_c : L₂) (r_c).2 g', ?_⟩
                  have hg'_L : algebraMap K₂ L₂ (φ_K₂ 0 g') = (τ cs) ^ (m₀_c + d_Sigma) := by
                    dsimp [g']
                    rw [map_pow, map_pow, hφ0_X j₀]
                  rw [he_chart_0, hrel]
                  change h_tilde cs * ((r_c : L₂) * (τ cs) ^ (m₀_c + d_Sigma)) =
                    h_tilde cs * ((r_c : L₂) * algebraMap K₂ L₂ (φ_K₂ 0 g'))
                  rw [hg'_L]
                · dsimp only
                  let g' : A := (MvPolynomial.X j₀) ^ m₀_c
                  let w : L₂ := (-(r_c : L₂)) * algebraMap K₂ L₂ (φ_K₂ 0 g')
                  have hw_symm := hOv21.2 cs 0 (-(r_c : L₂)) (-r_c).2 g'
                  refine ⟨w, hInt_sup_comm cs 0 w hw_symm, ?_⟩
                  have hg'_L : algebraMap K₂ L₂ (φ_K₂ 0 g') = (τ cs) ^ m₀_c := by
                    dsimp [g']
                    rw [map_pow, map_pow, hφ0_X j₀]
                  rw [he_chart_0]
                  change (e_chart cs : L₂) - (e₀ : L₂) =
                    h_tilde 0 * (-(r_c : L₂) * algebraMap K₂ L₂ (φ_K₂ 0 g'))
                  rw [hg'_L, ← neg_sub (e₀ : L₂) (e_chart cs : L₂), hrel, pow_add, ← hh_scale_0 cs]
                  ring
              rcases hFin3_offdiag c c' hcc' with
                ⟨j₀, rfl, rfl⟩ | ⟨j₀, rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
              · exact (hPair_0_succ j₀ hPc).1
              · exact (hPair_0_succ j₀ hPc').2
              · obtain ⟨K_pow, r₁₂, hr₁₂_rel⟩ := hOv_12_nondeg hPc hPc'
                let g' : A := (MvPolynomial.X 1) ^ (K_pow + d_Sigma)
                let w : L₂ := (r₁₂ : L₂) * algebraMap K₂ L₂ (φ_K₂ 2 g')
                refine ⟨w, hOv21.2 1 2 (r₁₂ : L₂) (r₁₂).2 g', ?_⟩
                have hv_cancel :
                    (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ (K_pow + d_Sigma) *
                      algebraMap K₂ L₂ (φ_K₂ 2 g') = 1 := by
                  dsimp [g']
                  rw [map_pow, map_pow, ← mul_pow, hφ12_X1_mul, one_pow]
                dsimp [w]
                rw [← mul_assoc, ← hr₁₂_rel, mul_assoc, hv_cancel, mul_one]
              · obtain ⟨K_pow, r₁₂, hr₁₂_rel⟩ := hOv_12_nondeg hPc' hPc
                have hr₁₂_rel' :
                    ((e_chart 2 : L₂) - (e_chart 1 : L₂)) *
                      (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ K_pow =
                      h_tilde 2 * (r₁₂ : L₂) := by
                  apply mul_right_cancel₀ (pow_ne_zero d_Sigma hv1_ne)
                  rw [mul_assoc, ← pow_add, hr₁₂_rel, ← hh_12_scale, mul_right_comm]
                let g' : A := (MvPolynomial.X 1) ^ K_pow
                let w : L₂ := (-(r₁₂ : L₂)) * algebraMap K₂ L₂ (φ_K₂ 2 g')
                have hw_symm := hOv21.2 1 2 (-(r₁₂ : L₂)) (-r₁₂).2 g'
                refine ⟨w, hInt_sup_comm 1 2 w hw_symm, ?_⟩
                have hv_cancel :
                    (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ K_pow *
                      algebraMap K₂ L₂ (φ_K₂ 2 g') = 1 := by
                  dsimp [g']
                  rw [map_pow, map_pow, ← mul_pow, hφ12_X1_mul, one_pow]
                dsimp [w]
                calc
                  (e_chart 1 : L₂) - (e_chart 2 : L₂)
                      = -(((e_chart 2 : L₂) - (e_chart 1 : L₂)) *
                          ((algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ K_pow *
                            algebraMap K₂ L₂ (φ_K₂ 2 g'))) := by rw [hv_cancel, mul_one]; ring
                  _ = -((((e_chart 2 : L₂) - (e_chart 1 : L₂)) *
                          (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ K_pow) *
                          algebraMap K₂ L₂ (φ_K₂ 2 g')) := by ring
                  _ = h_tilde 2 * (-(r₁₂ : L₂) * algebraMap K₂ L₂ (φ_K₂ 2 g')) := by
                        rw [hr₁₂_rel']; ring

      rcases hESZ_connected e_chart he_chart_idemp he_chart_ov with h0_in | h1_in
      · left
        rw [← he₀_mk, ← he_chart_0]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr h0_in
      · right
        rw [← he₀_mk]
        apply sub_eq_zero.mp
        rw [← he_chart_0]
        change Ideal.Quotient.mk (I_h 0) (e_chart 0 - 1) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr h1_in

    
    refine ⟨?_, ?_⟩
    · change IsDomain (B_quot 0) ∧ IsIntegrallyClosed (B_quot 0)
      have : IsNoetherianRing (B₂_type 0) := hNoethContr0.1
      have : IsNoetherianRing (B_quot 0) := Ideal.Quotient.isNoetherianRing (I_h 0)
      have hI_ne_top : I_h 0 ≠ ⊤ := by
        intro h_top
        have h1_mem : mapB 0 1 ∈ I_h 0 := by
          rw [h_top]
          exact Submodule.mem_top
        have h1_A : (1 : A) ∈ Ideal.span {eval_c 0 H_Sigma} :=
          (hNoethContr0.2 1 (eval_c 0 H_Sigma)).mp h1_mem
        obtain ⟨q_u, hq_u⟩ := Ideal.mem_span_singleton.mp h1_A
        exact hIrr_H0.not_isUnit (isUnit_iff_exists_inv.mpr ⟨q_u, hq_u.symm⟩)
      have : Nontrivial (B_quot 0) := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
      exact hDoubleAnn (B_quot 0) hLoc0_std hChart0_idemp_triv
    · intro j₀ c hPc B_bar _ 𝔪_bar _ R_bar _ _ _ h𝔪_max hNonempty
      exact (hAllLoc_c j₀ hPc B_bar 𝔪_bar R_bar h𝔪_max hNonempty).2

  
  
  
  intro A K₂ x₁ x₂ homCoord eval_c φ_K₂
    d_Sigma H_Sigma P₀ P₁ P₂ L₂ _ _ _
    hP₀_mon hIrr_H0 hDegUnit hLocalDVR_0 hESZ_connected
    hHomNe0 hHomScale hNoethContr0 hOv0c hOv21 hBdry
  have hFin3_succ0 : ∀ j₀ : Fin 2, ((0 : Fin 3).succAbove j₀).succAbove 0 = 0 := by
    decide
  have hCoord0 : homCoord 0 = 1 := rfl
  have hCoord_φ0 : ∀ j₀ : Fin 2,
      φ_K₂ 0 (MvPolynomial.X j₀) = homCoord ((0 : Fin 3).succAbove j₀) := by
    intro j₀
    dsimp [φ_K₂]
    rw [MvPolynomial.aeval_X, hCoord0, div_one]
  have hCoord_φc_X0 : ∀ j₀ : Fin 2,
      let c : Fin 3 := (0 : Fin 3).succAbove j₀
      φ_K₂ c (MvPolynomial.X 0) * homCoord c = 1 := by
    intro j₀ c
    dsimp [φ_K₂]
    rw [MvPolynomial.aeval_X, hFin3_succ0 j₀, hCoord0, div_mul_cancel₀ _ (hHomNe0 c)]
  have hCoord_1_X0 : φ_K₂ 1 (MvPolynomial.X 0) * homCoord 2 = φ_K₂ 1 (MvPolynomial.X 1) := by
    have h10 : (1 : Fin 3).succAbove 0 = 0 := rfl
    have h11 : (1 : Fin 3).succAbove 1 = 2 := rfl
    dsimp [φ_K₂]
    rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, h10, h11, hCoord0, one_div_mul_eq_div]
  have hCoord_12_X1 : φ_K₂ 1 (MvPolynomial.X 1) * φ_K₂ 2 (MvPolynomial.X 1) = 1 := by
    have h11 : (1 : Fin 3).succAbove 1 = 2 := rfl
    have h21 : (2 : Fin 3).succAbove 1 = 1 := rfl
    dsimp [φ_K₂]
    rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, h11, h21,
      div_mul_div_comm, mul_comm (homCoord 2) (homCoord 1),
      div_self (mul_ne_zero (hHomNe0 1) (hHomNe0 2))]
  have hCoord_succ : ∀ (c c' : Fin 3) (j : Fin 2),
      c'.succAbove j = c → φ_K₂ c' (MvPolynomial.X j) * homCoord c' = homCoord c := by
    intro c c' j hj_eq
    dsimp [φ_K₂]
    rw [MvPolynomial.aeval_X, hj_eq, div_mul_cancel₀ _ (hHomNe0 c')]
  exact hAbstractMain K₂ homCoord eval_c φ_K₂
    hCoord0 hCoord_φ0 hCoord_φc_X0 hCoord_1_X0 hCoord_12_X1 hCoord_succ
    d_Sigma H_Sigma P₀ P₁ P₂ L₂
    hP₀_mon hIrr_H0 hDegUnit hLocalDVR_0 hESZ_connected
    hHomNe0 hHomScale hNoethContr0 hOv0c hOv21 hBdry

theorem weil_curve_idemp_chart_domain_and_ratfunc_embedding (k : Type u) [Field k] :
    let A := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A
    let x₁ : K₂ := algebraMap A K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap A K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] A :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → A →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (d_Sigma : ℕ)
      (H_Sigma : MvPolynomial (Fin 3) k)
      (P₀ P₁ P₂ : Polynomial k)
      (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂],
      P₀.Monic →
      (∀ c : Fin 3,
        (![P₀, P₁, P₂] c = 0 ∧ IsUnit (eval_c c H_Sigma)) ∨
        (![P₀, P₁, P₂] c ≠ 0 ∧
          let θ_c : A →ₐ[k] RatFunc k :=
            MvPolynomial.aeval (fun j : Fin 2 =>
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
          RingHom.ker θ_c.toRingHom = Ideal.span {eval_c c H_Sigma} ∧
          Set.range θ_c =
            { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
                Q.natDegree ≤ n * d_Sigma ∧
                f = algebraMap (Polynomial k) (RatFunc k) Q /
                  (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n })) →
      (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
       let B₂_0 := integralClosure A L₂
       let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
       IsDomain (↥B₂_0 ⧸ I_h₀) ∧ IsIntegrallyClosed (↥B₂_0 ⧸ I_h₀)) →
      (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
       let B₂_0 := integralClosure A L₂
       ∀ a h : A,
         algebraMap A ↥B₂_0 a ∈ Ideal.span {algebraMap A ↥B₂_0 h} ↔ a ∈ Ideal.span {h}) →
      (∀ (j₀ : Fin 2)
         (B_0 B_c : Type u) [CommRing B_0] [CommRing B_c]
         (q_0 : A →+* B_0) (q_c : A →+* B_c),
        let c : Fin 3 := (0 : Fin 3).succAbove j₀
        (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
         let B₂_0 := integralClosure A L₂
         let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
         ∃ e_0 : (↥B₂_0 ⧸ I_h₀) ≃+* B_0,
           ∀ g : A, e_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) = q_0 g) →
        (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
         let B₂_c := integralClosure A L₂
         let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
         ∃ e_c : (↥B₂_c ⧸ I_hc) ≃+* B_c,
           ∀ g : A, e_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g)) = q_c g) →
        let v0_bar : B_0 := q_0 (MvPolynomial.X j₀)
        let uc_bar : B_c := q_c (MvPolynomial.X 0)
        ∃ Ψ : Localization.Away v0_bar ≃+* Localization.Away uc_bar,
          (∀ c₀ : k,
            Ψ (algebraMap B_0 (Localization.Away v0_bar) (q_0 (MvPolynomial.C c₀))) =
              algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.C c₀))) ∧
          Ψ (algebraMap B_0 (Localization.Away v0_bar) v0_bar) *
            algebraMap B_c (Localization.Away uc_bar) uc_bar = 1 ∧
          Ψ (algebraMap B_0 (Localization.Away v0_bar)
              (q_0 (MvPolynomial.X (Fin.rev j₀)))) *
            algebraMap B_c (Localization.Away uc_bar) uc_bar =
            algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.X 1))) →
      (∀ j₀ : Fin 2,
        let c : Fin 3 := (0 : Fin 3).succAbove j₀
        ![P₀, P₁, P₂] c ≠ 0 →
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
        let uc_bar : ↥B₂_c ⧸ I_hc := Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c (MvPolynomial.X 0))
        ∀ z : ↥B₂_c ⧸ I_hc, uc_bar * z = 0 → z = 0) →
      (∀ j₀ : Fin 2,
        let c : Fin 3 := (0 : Fin 3).succAbove j₀
        ![P₀, P₁, P₂] c ≠ 0 →
        ∀ (B_bar : Type u) [CommRing B_bar]
          (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
          (R_bar : Type u) [CommRing R_bar] [Algebra B_bar R_bar]
          [IsLocalization.AtPrime R_bar 𝔪_bar],
          𝔪_bar.IsMaximal →
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
           let B₂_c := integralClosure A L₂
           let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
           Nonempty ((↥B₂_c ⧸ I_hc) ≃+* B_bar)) →
          IsIntegrallyClosed R_bar) →
      ∀ c : Fin 3, ![P₀, P₁, P₂] c ≠ 0 →
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
        let θ_c : A →ₐ[k] RatFunc k :=
          MvPolynomial.aeval (fun j : Fin 2 =>
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
        (IsDomain (↥B₂_c ⧸ I_hc) ∧ IsIntegrallyClosed (↥B₂_c ⧸ I_hc)) ∧
        ∀ (L_Sigma : Type u) [Field L_Sigma] [Algebra k L_Sigma] [Algebra (RatFunc k) L_Sigma]
          [IsScalarTower k (RatFunc k) L_Sigma],
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
           let B₂_0 := integralClosure A L₂
           let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
           let θ_0 : A →ₐ[k] RatFunc k :=
             MvPolynomial.aeval (fun j : Fin 2 =>
               algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] ((0 : Fin 3).succAbove j)) /
               algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] 0))
           ∀ (ι_0 : (↥B₂_0 ⧸ I_h₀) →+* L_Sigma),
             (letI : Algebra (↥B₂_0 ⧸ I_h₀) L_Sigma := ι_0.toAlgebra
              IsFractionRing (↥B₂_0 ⧸ I_h₀) L_Sigma) →
             (∀ g : A,
               ι_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) =
                 algebraMap (RatFunc k) L_Sigma (θ_0 g)) →
             ∃ ι_c : (↥B₂_c ⧸ I_hc) →+* L_Sigma,
               Function.Injective ι_c ∧
               (∀ g : A,
                 ι_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g)) =
                   algebraMap (RatFunc k) L_Sigma (θ_c g)) ∧
               (let D_c : Subalgebra k (RatFunc k) := θ_c.range
                letI : Algebra ↥D_c L_Sigma :=
                  ((algebraMap (RatFunc k) L_Sigma).comp D_c.val.toRingHom).toAlgebra
                ∀ z : L_Sigma, z ∈ Set.range ι_c ↔ IsIntegral ↥D_c z)) :=
by
  intro A K₂ x₁ x₂ homCoord eval_c φ_K₂
    d_Sigma H_Sigma P₀ P₁ P₂ L₂ _ _ _
    hP₀_mon hCharts_Sigma hPart1 hContr0 hOv0c_iso hReg_u hLocInt_c

  
  have hFracEquiv : ∀ (R₁ R₂ F_fld : Type u) [CommRing R₁] [IsDomain R₁]
      [CommRing R₂] [IsDomain R₂] [Field F_fld]
      (e : R₁ ≃+* R₂) (ι₁ : R₁ →+* F_fld),
      (letI : Algebra R₁ F_fld := ι₁.toAlgebra; IsFractionRing R₁ F_fld) →
      (letI : Algebra R₂ F_fld := (ι₁.comp e.symm.toRingHom).toAlgebra
       IsFractionRing R₂ F_fld) := by
    intro R₁ R₂ F_fld _ _ _ _ _ e ι₁ hFrac₁
    have hι₁_inj : Function.Injective ι₁ := by
      letI : Algebra R₁ F_fld := ι₁.toAlgebra
      exact IsFractionRing.injective R₁ F_fld
    have hSurj₁ : ∀ z : F_fld, ∃ p : R₁ × nonZeroDivisors R₁, z * ι₁ p.2.1 = ι₁ p.1 := by
      letI : Algebra R₁ F_fld := ι₁.toAlgebra
      exact fun z => IsLocalization.surj (nonZeroDivisors R₁) z
    let ι₂ : R₂ →+* F_fld := ι₁.comp e.symm.toRingHom
    have hι₂_inj : Function.Injective ι₂ := hι₁_inj.comp e.symm.injective
    letI : Algebra R₂ F_fld := ι₂.toAlgebra
    refine ⟨?_, ?_, ?_⟩
    · intro y
      have hy_ne : (y : R₂) ≠ 0 := nonZeroDivisors.coe_ne_zero y
      have hmap_ne : ι₂ y.1 ≠ 0 := fun h0 => hy_ne (hι₂_inj (h0.trans (map_zero ι₂).symm))
      exact IsUnit.mk0 (ι₂ y.1) hmap_ne
    · intro z
      obtain ⟨⟨a₁, b₁⟩, hz₁⟩ := hSurj₁ z
      have hb₁_ne : (b₁ : R₁) ≠ 0 := nonZeroDivisors.coe_ne_zero b₁
      have hb₂_ne : e b₁.1 ≠ 0 := fun h0 => hb₁_ne (e.injective (h0.trans (map_zero e).symm))
      refine ⟨⟨e a₁, ⟨e b₁.1, mem_nonZeroDivisors_of_ne_zero hb₂_ne⟩⟩, ?_⟩
      change z * ι₁ (e.symm (e b₁.1)) = ι₁ (e.symm (e a₁))
      rw [RingEquiv.symm_apply_apply, RingEquiv.symm_apply_apply]
      exact hz₁
    · intro x y hxy
      exact ⟨1, by rw [OneMemClass.coe_one, one_mul, one_mul, hι₂_inj hxy]⟩

  
  
  have hOverlapTransfer :
      ∀ {B_0 B_c : Type u} [CommRing B_0] [IsDomain B_0] [CommRing B_c]
        (v0_bar : B_0) (_hv0 : v0_bar ≠ 0)
        (uc_bar : B_c) (_huc_reg : ∀ z : B_c, uc_bar * z = 0 → z = 0)
        (Ψ : Localization.Away v0_bar ≃+* Localization.Away uc_bar),
        IsDomain B_c ∧
        ((∀ (𝔪 : Ideal B_c) [𝔪.IsMaximal],
            IsIntegrallyClosed (Localization.AtPrime 𝔪)) →
          IsIntegrallyClosed B_c) ∧
        (Ψ (algebraMap B_0 (Localization.Away v0_bar) v0_bar) *
            algebraMap B_c (Localization.Away uc_bar) uc_bar = 1 →
          ∀ (L_Sigma : Type u) [Field L_Sigma] (ι_0 : B_0 →+* L_Sigma),
            (letI : Algebra B_0 L_Sigma := ι_0.toAlgebra; IsFractionRing B_0 L_Sigma) →
            ∃ ι_c : B_c →+* L_Sigma,
              Function.Injective ι_c ∧
              (letI : Algebra B_c L_Sigma := ι_c.toAlgebra; IsFractionRing B_c L_Sigma) ∧
              ι_0 v0_bar * ι_c uc_bar = 1 ∧
              (∀ (x₀ : B_0) (x_c : B_c),
                Ψ (algebraMap B_0 (Localization.Away v0_bar) x₀) =
                  algebraMap B_c (Localization.Away uc_bar) x_c →
                ι_c x_c = ι_0 x₀) ∧
              (∀ (x₀ : B_0) (x_c : B_c),
                Ψ (algebraMap B_0 (Localization.Away v0_bar) x₀) *
                  algebraMap B_c (Localization.Away uc_bar) uc_bar =
                  algebraMap B_c (Localization.Away uc_bar) x_c →
                ι_0 x₀ * ι_c uc_bar = ι_c x_c)) := by
    intro B_0 B_c _ _ _ v0_bar hv0 uc_bar huc_reg Ψ
    have hv0_nzd : v0_bar ∈ nonZeroDivisors B_0 := mem_nonZeroDivisors_of_ne_zero hv0
    have hv0_le : Submonoid.powers v0_bar ≤ nonZeroDivisors B_0 :=
      Submonoid.powers_le.mpr hv0_nzd
    have hDom_Away0 : IsDomain (Localization.Away v0_bar) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away v0_bar) hv0_le
    letI : IsDomain (Localization.Away v0_bar) := hDom_Away0
    have hmap_0_inj : Function.Injective (algebraMap B_0 (Localization.Away v0_bar)) :=
      IsLocalization.injective (Localization.Away v0_bar) hv0_le
    have huc_nzd : uc_bar ∈ nonZeroDivisors B_c :=
      mem_nonZeroDivisors_iff_right.mpr fun z hz => huc_reg z (by rw [mul_comm]; exact hz)
    have huc_le : Submonoid.powers uc_bar ≤ nonZeroDivisors B_c :=
      Submonoid.powers_le.mpr huc_nzd
    have hmap_c_inj : Function.Injective (algebraMap B_c (Localization.Away uc_bar)) :=
      IsLocalization.injective (Localization.Away uc_bar) huc_le
    let emb : B_c →+* Localization.Away v0_bar :=
      Ψ.symm.toRingHom.comp (algebraMap B_c (Localization.Away uc_bar))
    have hemb_inj : Function.Injective emb := Ψ.symm.injective.comp hmap_c_inj
    have hDom_Bc : IsDomain B_c := Function.Injective.isDomain emb hemb_inj
    letI : IsDomain B_c := hDom_Bc
    refine ⟨hDom_Bc, ?_, ?_⟩
    · intro hLocMax
      exact IsIntegrallyClosed.of_localization_maximal fun p _ _ => hLocMax p
    · intro hΨ_inv L_Sigma _ ι_0 hFrac0
      have hι0_inj : Function.Injective ι_0 := by
        letI : Algebra B_0 L_Sigma := ι_0.toAlgebra
        exact IsFractionRing.injective B_0 L_Sigma
      have hSurj0 : ∀ z : L_Sigma, ∃ p : B_0 × nonZeroDivisors B_0, z * ι_0 p.2.1 = ι_0 p.1 := by
        letI : Algebra B_0 L_Sigma := ι_0.toAlgebra
        exact fun z => IsLocalization.surj (nonZeroDivisors B_0) z
      have hv0_map_ne : ι_0 v0_bar ≠ 0 := fun h0 =>
        hv0 (hι0_inj (h0.trans (map_zero ι_0).symm))
      have hv0_unit : IsUnit (ι_0 v0_bar) := IsUnit.mk0 (ι_0 v0_bar) hv0_map_ne
      let ι_tilde_0 : Localization.Away v0_bar →+* L_Sigma :=
        IsLocalization.Away.lift (S := Localization.Away v0_bar) v0_bar (g := ι_0) hv0_unit
      have hι_tilde_eq : ∀ a : B_0,
          ι_tilde_0 (algebraMap B_0 (Localization.Away v0_bar) a) = ι_0 a :=
        fun a => IsLocalization.Away.lift_eq (S := Localization.Away v0_bar) v0_bar hv0_unit a
      have hι_tilde_inj : Function.Injective ι_tilde_0 := by
        rw [injective_iff_map_eq_zero]
        intro w hw
        obtain ⟨⟨b, ⟨_, n, rfl⟩⟩, hbw⟩ := IsLocalization.surj (Submonoid.powers v0_bar) w
        have hbw' : w * (algebraMap B_0 (Localization.Away v0_bar) v0_bar) ^ n =
            algebraMap B_0 (Localization.Away v0_bar) b := by
          simpa only [map_pow] using hbw
        have hb0 : ι_0 b = 0 := by
          calc ι_0 b = ι_tilde_0 (algebraMap B_0 (Localization.Away v0_bar) b) :=
                (hι_tilde_eq b).symm
            _ = ι_tilde_0 (w * (algebraMap B_0 (Localization.Away v0_bar) v0_bar) ^ n) := by
                rw [← hbw']
            _ = ι_tilde_0 w * ι_tilde_0 ((algebraMap B_0 (Localization.Away v0_bar) v0_bar) ^ n) :=
                map_mul _ _ _
            _ = 0 := by rw [hw, zero_mul]
        have hb_eq : b = 0 := hι0_inj (hb0.trans (map_zero ι_0).symm)
        rw [hb_eq, map_zero] at hbw'
        have hpow_ne : (algebraMap B_0 (Localization.Away v0_bar) v0_bar) ^ n ≠ 0 :=
          (IsLocalization.Away.algebraMap_pow_isUnit
            (S := Localization.Away v0_bar) v0_bar n).ne_zero
        exact (mul_eq_zero.mp hbw').resolve_right hpow_ne
      let f_ov : Localization.Away uc_bar →+* L_Sigma :=
        ι_tilde_0.comp Ψ.symm.toRingHom
      let ι_c : B_c →+* L_Sigma :=
        f_ov.comp (algebraMap B_c (Localization.Away uc_bar))
      have hιc_inj : Function.Injective ι_c :=
        hι_tilde_inj.comp (Ψ.symm.injective.comp hmap_c_inj)
      have hf_ov_0 : ∀ x₀ : B_0,
          f_ov (Ψ (algebraMap B_0 (Localization.Away v0_bar) x₀)) = ι_0 x₀ := by
        intro x₀
        change ι_tilde_0 (Ψ.symm (Ψ (algebraMap B_0 (Localization.Away v0_bar) x₀))) = ι_0 x₀
        rw [RingEquiv.symm_apply_apply]
        exact hι_tilde_eq x₀
      have hf_ov_c : ∀ x_c : B_c,
          f_ov (algebraMap B_c (Localization.Away uc_bar) x_c) = ι_c x_c := fun _ => rfl
      have hDom_Awayc : IsDomain (Localization.Away uc_bar) :=
        IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away uc_bar) huc_le
      letI : IsDomain (Localization.Away uc_bar) := hDom_Awayc
      have hFrac_c : (letI : Algebra B_c L_Sigma := ι_c.toAlgebra; IsFractionRing B_c L_Sigma) := by
        letI : Algebra B_c L_Sigma := ι_c.toAlgebra
        refine ⟨?_, ?_, ?_⟩
        · intro y
          have hy_ne : (y : B_c) ≠ 0 := nonZeroDivisors.coe_ne_zero y
          have hmap_ne : ι_c y.1 ≠ 0 := fun h0 => hy_ne (hιc_inj (h0.trans (map_zero ι_c).symm))
          exact IsUnit.mk0 (ι_c y.1) hmap_ne
        · intro z
          obtain ⟨⟨a₀, b₀⟩, hz₀⟩ := hSurj0 z
          have hb₀_ne : (b₀ : B_0) ≠ 0 := nonZeroDivisors.coe_ne_zero b₀
          let x_u : Localization.Away uc_bar :=
            Ψ (algebraMap B_0 (Localization.Away v0_bar) a₀)
          let y_u : Localization.Away uc_bar :=
            Ψ (algebraMap B_0 (Localization.Away v0_bar) b₀.1)
          have hy_u_ne : y_u ≠ 0 := by
            intro hy0
            apply hb₀_ne
            apply hmap_0_inj
            rw [map_zero]
            exact Ψ.injective (hy0.trans (map_zero Ψ).symm)
          obtain ⟨⟨r_x, ⟨_, m_x, rfl⟩⟩, hx_u⟩ :=
            IsLocalization.surj (Submonoid.powers uc_bar) x_u
          obtain ⟨⟨r_y, ⟨_, m_y, rfl⟩⟩, hy_u⟩ :=
            IsLocalization.surj (Submonoid.powers uc_bar) y_u
          have hry_ne : r_y ≠ 0 := by
            intro hry0
            have hy_u' : y_u * (algebraMap B_c (Localization.Away uc_bar) uc_bar) ^ m_y = 0 := by
              have h1 := hy_u
              rw [hry0, map_zero, map_pow] at h1
              exact h1
            have hpow_ne : (algebraMap B_c (Localization.Away uc_bar) uc_bar) ^ m_y ≠ 0 :=
              (IsLocalization.Away.algebraMap_pow_isUnit
                (S := Localization.Away uc_bar) uc_bar m_y).ne_zero
            exact hy_u_ne ((mul_eq_zero.mp hy_u').resolve_right hpow_ne)
          have huc_ne : uc_bar ≠ 0 :=
            nonZeroDivisors.coe_ne_zero ⟨uc_bar, huc_nzd⟩
          let a_c : B_c := r_x * uc_bar ^ m_y
          let b_c_val : B_c := r_y * uc_bar ^ m_x
          have hbc_ne : b_c_val ≠ 0 := mul_ne_zero hry_ne (pow_ne_zero m_x huc_ne)
          have hx_f : ι_0 a₀ * ι_c (uc_bar ^ m_x) = ι_c r_x := by
            have h := congrArg f_ov hx_u
            rwa [map_mul, hf_ov_0, hf_ov_c, hf_ov_c] at h
          have hy_f : ι_0 b₀.1 * ι_c (uc_bar ^ m_y) = ι_c r_y := by
            have h := congrArg f_ov hy_u
            rwa [map_mul, hf_ov_0, hf_ov_c, hf_ov_c] at h
          refine ⟨⟨a_c, ⟨b_c_val, mem_nonZeroDivisors_of_ne_zero hbc_ne⟩⟩, ?_⟩
          change z * ι_c (r_y * uc_bar ^ m_x) = ι_c (r_x * uc_bar ^ m_y)
          rw [map_mul, map_mul, ← hx_f, ← hy_f]
          calc z * (ι_0 b₀.1 * ι_c (uc_bar ^ m_y) * ι_c (uc_bar ^ m_x))
              = (z * ι_0 b₀.1) * ι_c (uc_bar ^ m_x) * ι_c (uc_bar ^ m_y) := by ring
            _ = ι_0 a₀ * ι_c (uc_bar ^ m_x) * ι_c (uc_bar ^ m_y) := by rw [hz₀]
        · intro x y hxy
          exact ⟨1, by rw [OneMemClass.coe_one, one_mul, one_mul, hιc_inj hxy]⟩
      refine ⟨ι_c, hιc_inj, hFrac_c, ?_, ?_, ?_⟩
      · have h := congrArg f_ov hΨ_inv
        rwa [map_mul, map_one, hf_ov_0, hf_ov_c] at h
      · intro x₀ x_c hEq
        have h := congrArg f_ov hEq
        rw [hf_ov_0, hf_ov_c] at h
        exact h.symm
      · intro x₀ x_c hMul
        have h := congrArg f_ov hMul
        rwa [map_mul, hf_ov_0, hf_ov_c, hf_ov_c] at h

  
  have hParamAlign :
      ∀ (j₀ : Fin 2),
        let c : Fin 3 := (0 : Fin 3).succAbove j₀
        ![P₀, P₁, P₂] c ≠ 0 →
        let θ_0 : A →ₐ[k] RatFunc k :=
          MvPolynomial.aeval (fun j : Fin 2 =>
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] ((0 : Fin 3).succAbove j)) /
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] 0))
        let θ_c : A →ₐ[k] RatFunc k :=
          MvPolynomial.aeval (fun j : Fin 2 =>
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
        θ_0 (MvPolynomial.X j₀) ≠ 0 ∧
        ∀ (L_Sigma : Type u) [Field L_Sigma] [Algebra (RatFunc k) L_Sigma]
          (f_0 f_c : A →+* L_Sigma),
          (∀ g : A, f_0 g = algebraMap (RatFunc k) L_Sigma (θ_0 g)) →
          (∀ c₀ : k, f_c (MvPolynomial.C c₀) = f_0 (MvPolynomial.C c₀)) →
          f_0 (MvPolynomial.X j₀) * f_c (MvPolynomial.X 0) = 1 →
          f_0 (MvPolynomial.X (Fin.rev j₀)) * f_c (MvPolynomial.X 0) = f_c (MvPolynomial.X 1) →
          ∀ g : A, f_c g = algebraMap (RatFunc k) L_Sigma (θ_c g) := by
    intro j₀ c hPc θ_0 θ_c
    have hc_sa0 : c.succAbove 0 = 0 := by
      dsimp [c]
      fin_cases j₀ <;> rfl
    have hc_sa1 : c.succAbove 1 = (0 : Fin 3).succAbove (Fin.rev j₀) := by
      dsimp [c]
      fin_cases j₀ <;> rfl
    let d₀ : RatFunc k := algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] 0)
    let d_c : RatFunc k := algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)
    have hd₀_ne : d₀ ≠ 0 := RatFunc.algebraMap_ne_zero hP₀_mon.ne_zero
    have hdc_ne : d_c ≠ 0 := RatFunc.algebraMap_ne_zero hPc
    have hθ0_Xj₀ : θ_0 (MvPolynomial.X j₀) = d_c / d₀ := by
      dsimp [θ_0, c, d₀, d_c]
      exact MvPolynomial.aeval_X _ j₀
    have hθ0_ne : θ_0 (MvPolynomial.X j₀) ≠ 0 := by
      rw [hθ0_Xj₀]
      exact div_ne_zero hdc_ne hd₀_ne
    refine ⟨hθ0_ne, ?_⟩
    intro L_Sigma _ _ f_0 f_c hf0_align hfc_C hfc_X0 hfc_X1
    have hθc_X0 : θ_c (MvPolynomial.X 0) = d₀ / d_c := by
      change MvPolynomial.aeval _ (MvPolynomial.X 0) = d₀ / d_c
      rw [MvPolynomial.aeval_X, hc_sa0]
    have hθ0_Xrev : θ_0 (MvPolynomial.X (Fin.rev j₀)) =
        algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove 1)) / d₀ := by
      change MvPolynomial.aeval _ (MvPolynomial.X (Fin.rev j₀)) = _
      rw [MvPolynomial.aeval_X, hc_sa1]
    have hθc_X1 : θ_c (MvPolynomial.X 1) =
        algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove 1)) / d_c := by
      change MvPolynomial.aeval _ (MvPolynomial.X 1) = _
      rw [MvPolynomial.aeval_X]
    have hMul_RF_0 : θ_0 (MvPolynomial.X j₀) * θ_c (MvPolynomial.X 0) = 1 := by
      rw [hθ0_Xj₀, hθc_X0, div_mul_div_cancel₀ hd₀_ne, div_self hdc_ne]
    have hMul_RF_1 : θ_0 (MvPolynomial.X (Fin.rev j₀)) * θ_c (MvPolynomial.X 0) =
        θ_c (MvPolynomial.X 1) := by
      rw [hθ0_Xrev, hθc_X0, hθc_X1]
      exact div_mul_div_cancel₀ hd₀_ne
    let rhs : A →+* L_Sigma := (algebraMap (RatFunc k) L_Sigma).comp θ_c.toRingHom
    suffices hHomEq : f_c = rhs from fun g => RingHom.congr_fun hHomEq g
    apply MvPolynomial.ringHom_ext
    · intro c₀
      rw [hfc_C c₀, hf0_align (MvPolynomial.C c₀)]
      change algebraMap (RatFunc k) L_Sigma (θ_0 (MvPolynomial.C c₀)) =
        algebraMap (RatFunc k) L_Sigma (θ_c (MvPolynomial.C c₀))
      rw [MvPolynomial.aeval_C, MvPolynomial.aeval_C]
    · intro i
      have hX0_eq : f_c (MvPolynomial.X 0) = rhs (MvPolynomial.X 0) := by
        have h1 : f_0 (MvPolynomial.X j₀) * rhs (MvPolynomial.X 0) = 1 := by
          rw [hf0_align (MvPolynomial.X j₀)]
          change algebraMap (RatFunc k) L_Sigma (θ_0 (MvPolynomial.X j₀)) *
              algebraMap (RatFunc k) L_Sigma (θ_c (MvPolynomial.X 0)) = 1
          rw [← map_mul, hMul_RF_0, map_one]
        have hf0_ne : f_0 (MvPolynomial.X j₀) ≠ 0 := by
          intro h0
          rw [h0, zero_mul] at hfc_X0
          exact zero_ne_one hfc_X0
        exact mul_left_cancel₀ hf0_ne (hfc_X0.trans h1.symm)
      fin_cases i
      · exact hX0_eq
      · change f_c (MvPolynomial.X 1) = rhs (MvPolynomial.X 1)
        rw [← hfc_X1, hX0_eq, hf0_align (MvPolynomial.X (Fin.rev j₀))]
        change algebraMap (RatFunc k) L_Sigma (θ_0 (MvPolynomial.X (Fin.rev j₀))) *
            algebraMap (RatFunc k) L_Sigma (θ_c (MvPolynomial.X 0)) =
          algebraMap (RatFunc k) L_Sigma (θ_c (MvPolynomial.X 1))
        rw [← map_mul, hMul_RF_1]

  
  have hRangeIff :
      ∀ (instAlg : Algebra A L₂) (h : A) (θ : A →ₐ[k] RatFunc k),
        RingHom.ker θ.toRingHom = Ideal.span {h} →
        letI : Algebra A L₂ := instAlg
        let B₂ := integralClosure A L₂
        let I_h : Ideal ↥B₂ := Ideal.span {algebraMap A ↥B₂ h}
        IsIntegrallyClosed (↥B₂ ⧸ I_h) →
        ∀ (L_Sigma : Type u) [Field L_Sigma] [Algebra (RatFunc k) L_Sigma]
          (ι : (↥B₂ ⧸ I_h) →+* L_Sigma),
          (letI : Algebra (↥B₂ ⧸ I_h) L_Sigma := ι.toAlgebra
           IsFractionRing (↥B₂ ⧸ I_h) L_Sigma) →
          (∀ g : A,
            ι (Ideal.Quotient.mk I_h (algebraMap A ↥B₂ g)) =
              algebraMap (RatFunc k) L_Sigma (θ g)) →
          let D : Subalgebra k (RatFunc k) := θ.range
          letI : Algebra ↥D L_Sigma :=
            ((algebraMap (RatFunc k) L_Sigma).comp D.val.toRingHom).toAlgebra
          ∀ z : L_Sigma, z ∈ Set.range ι ↔ IsIntegral ↥D z := by
    intro instAlg h θ hKer
    letI : Algebra A L₂ := instAlg
    intro B₂ I_h hIntCl L_Sigma _ _ ι hFrac hAlign D
    letI : Algebra ↥D L_Sigma :=
      ((algebraMap (RatFunc k) L_Sigma).comp D.val.toRingHom).toAlgebra
    intro z
    constructor
    · rintro ⟨x_bar, rfl⟩
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x_bar
      let π_z : ↥B₂ →+* L_Sigma := ι.comp (Ideal.Quotient.mk I_h)
      obtain ⟨p, hp_mon, hp_eval⟩ := integralClosure.isIntegral y
      let q : Polynomial ↥D := p.map θ.rangeRestrict.toRingHom
      have hcomp_eq :
          (algebraMap ↥D L_Sigma).comp θ.rangeRestrict.toRingHom =
            π_z.comp (algebraMap A ↥B₂) := by
        apply RingHom.ext
        intro g
        exact (hAlign g).symm
      refine ⟨q, hp_mon.map θ.rangeRestrict.toRingHom, ?_⟩
      change Polynomial.eval₂ (algebraMap ↥D L_Sigma) (π_z y) (p.map θ.rangeRestrict.toRingHom) = 0
      rw [Polynomial.eval₂_map, hcomp_eq, ← Polynomial.hom_eval₂, hp_eval, map_zero]
    · intro hz
      let q_std : A →+* (↥B₂ ⧸ I_h) := (Ideal.Quotient.mk I_h).comp (algebraMap A ↥B₂)
      have hq_wd : ∀ g₁ g₂ : A, θ g₁ = θ g₂ → q_std g₁ = q_std g₂ := by
        intro g₁ g₂ hg_eq
        have hmem_ker : g₁ - g₂ ∈ RingHom.ker θ.toRingHom := by
          rw [RingHom.mem_ker]
          change θ (g₁ - g₂) = 0
          rw [map_sub, hg_eq, sub_self]
        rw [hKer, Ideal.mem_span_singleton] at hmem_ker
        rcases hmem_ker with ⟨r, hr⟩
        have hmem_Ih : algebraMap A ↥B₂ (g₁ - g₂) ∈ I_h := by
          dsimp [I_h]
          rw [Ideal.mem_span_singleton]
          exact ⟨algebraMap A ↥B₂ r, by rw [hr, map_mul]⟩
        have hq_sub : q_std (g₁ - g₂) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr hmem_Ih
        rw [map_sub] at hq_sub
        exact sub_eq_zero.mp hq_sub
      let γ : ↥D → A := fun d => Classical.choose d.2
      have hγ : ∀ d : ↥D, θ (γ d) = d.1 := fun d => Classical.choose_spec d.2
      let j_D : ↥D →+* (↥B₂ ⧸ I_h) :=
        { toFun := fun d => q_std (γ d)
          map_one' := (hq_wd (γ 1) 1 ((hγ 1).trans (map_one θ).symm)).trans (map_one q_std)
          map_mul' := fun x y =>
            (hq_wd (γ (x * y)) (γ x * γ y)
              (by rw [hγ, Subalgebra.coe_mul, map_mul, hγ, hγ])).trans (map_mul q_std _ _)
          map_zero' := (hq_wd (γ 0) 0 ((hγ 0).trans (map_zero θ).symm)).trans (map_zero q_std)
          map_add' := fun x y =>
            (hq_wd (γ (x + y)) (γ x + γ y)
              (by rw [hγ, Subalgebra.coe_add, map_add, hγ, hγ])).trans (map_add q_std _ _) }
      have hι_jD : ι.comp j_D = algebraMap ↥D L_Sigma := by
        apply RingHom.ext
        intro d
        change ι (Ideal.Quotient.mk I_h (algebraMap A ↥B₂ (γ d))) =
          algebraMap (RatFunc k) L_Sigma d.1
        rw [hAlign (γ d), hγ d]
      rcases hz with ⟨q, hq_mon, hq_eval⟩
      letI : Algebra (↥B₂ ⧸ I_h) L_Sigma := ι.toAlgebra
      letI : IsFractionRing (↥B₂ ⧸ I_h) L_Sigma := hFrac
      have hz_B : IsIntegral (↥B₂ ⧸ I_h) z := by
        refine ⟨q.map j_D, hq_mon.map j_D, ?_⟩
        change Polynomial.eval₂ ι z (q.map j_D) = 0
        rw [Polynomial.eval₂_map, hι_jD]
        exact hq_eval
      exact (IsIntegrallyClosed.isIntegral_iff (R := ↥B₂ ⧸ I_h) (K := L_Sigma) (x := z)).mp hz_B

  
  have hKer_of_ne : ∀ (c' : Fin 3), ![P₀, P₁, P₂] c' ≠ 0 →
      let θ_c' : A →ₐ[k] RatFunc k :=
        MvPolynomial.aeval (fun j : Fin 2 =>
          algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c'.succAbove j)) /
          algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c'))
      RingHom.ker θ_c'.toRingHom = Ideal.span {eval_c c' H_Sigma} := by
    intro c' hPc'
    rcases hCharts_Sigma c' with ⟨h0, _⟩ | ⟨_, hKer, _⟩
    · exact absurd h0 hPc'
    · exact hKer

  have hP0_ne : ![P₀, P₁, P₂] 0 ≠ 0 := hP₀_mon.ne_zero
  have hKer0 := hKer_of_ne 0 hP0_ne

  
  intro c hPc
  have hc_cases : c = 0 ∨ ∃ j₀ : Fin 2, c = (0 : Fin 3).succAbove j₀ := by
    fin_cases c
    · exact Or.inl rfl
    · exact Or.inr ⟨0, rfl⟩
    · exact Or.inr ⟨1, rfl⟩

  rcases hc_cases with rfl | ⟨j₀, rfl⟩
  · 
    refine ⟨hPart1, ?_⟩
    intro L_Sigma _ _ _ _
    dsimp only
    intro ι_0 hFrac0 hAlign0
    have hι0_inj : Function.Injective ι_0 := by
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      let B₂_0 := integralClosure A L₂
      let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
      letI : IsDomain (↥B₂_0 ⧸ I_h₀) := hPart1.1
      letI : Algebra (↥B₂_0 ⧸ I_h₀) L_Sigma := ι_0.toAlgebra
      exact IsFractionRing.injective (↥B₂_0 ⧸ I_h₀) L_Sigma
    exact ⟨ι_0, hι0_inj, hAlign0,
      hRangeIff ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
        (eval_c 0 H_Sigma) _ hKer0 hPart1.2 L_Sigma ι_0 hFrac0 hAlign0⟩
  · 
    set c : Fin 3 := (0 : Fin 3).succAbove j₀
    have hKer_c := hKer_of_ne c hPc
    obtain ⟨hθ0_Xj₀_ne, hAlign_ext⟩ := hParamAlign j₀ hPc

    
    
    have hPkg0 :
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
        let B₂_0 := integralClosure A L₂
        let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
        ∃ (B_0 : Type u) (_ : CommRing B_0) (q_0 : A →+* B_0)
          (e_0 : (↥B₂_0 ⧸ I_h₀) ≃+* B_0),
          ∀ g : A, e_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) = q_0 g := by
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      let B₂_0 := integralClosure A L₂
      let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
      exact ⟨↥B₂_0 ⧸ I_h₀, inferInstance,
        (Ideal.Quotient.mk I_h₀).comp (algebraMap A ↥B₂_0),
        RingEquiv.refl _, fun _ => rfl⟩
    obtain ⟨B_0, instCR_B0, q_0, e_0, he_0⟩ := hPkg0
    letI : CommRing B_0 := instCR_B0

    have hPkgc :
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
        ∃ (B_c : Type u) (_ : CommRing B_c) (q_c : A →+* B_c)
          (e_c : (↥B₂_c ⧸ I_hc) ≃+* B_c),
          ∀ g : A, e_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g)) = q_c g := by
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      let B₂_c := integralClosure A L₂
      let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
      exact ⟨↥B₂_c ⧸ I_hc, inferInstance,
        (Ideal.Quotient.mk I_hc).comp (algebraMap A ↥B₂_c),
        RingEquiv.refl _, fun _ => rfl⟩
    obtain ⟨B_c, instCR_Bc, q_c, e_c, he_c⟩ := hPkgc
    letI : CommRing B_c := instCR_Bc

    have hDom_B0 : IsDomain B_0 := by
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      let B₂_0 := integralClosure A L₂
      let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
      letI : IsDomain (↥B₂_0 ⧸ I_h₀) := hPart1.1
      exact Function.Injective.isDomain e_0.symm.toRingHom e_0.symm.injective
    letI : IsDomain B_0 := hDom_B0

    
    have hv0_ne : q_0 (MvPolynomial.X j₀) ≠ 0 := by
      intro hv0_zero
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      let B₂_0 := integralClosure A L₂
      let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
      have hmk0 : Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 (MvPolynomial.X j₀)) = 0 := by
        apply e_0.injective
        rw [he_0, map_zero]
        exact hv0_zero
      have hmem_Ih0 : algebraMap A ↥B₂_0 (MvPolynomial.X j₀) ∈ I_h₀ :=
        Ideal.Quotient.eq_zero_iff_mem.mp hmk0
      have hmem_span : MvPolynomial.X j₀ ∈ Ideal.span {eval_c 0 H_Sigma} :=
        (hContr0 (MvPolynomial.X j₀) (eval_c 0 H_Sigma)).mp hmem_Ih0
      rw [← hKer0] at hmem_span
      exact hθ0_Xj₀_ne (RingHom.mem_ker.mp hmem_span)

    
    have huc_reg : ∀ z : B_c, q_c (MvPolynomial.X 0) * z = 0 → z = 0 := by
      intro z hz
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      let B₂_c := integralClosure A L₂
      let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
      have hmul_quot :
          Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c (MvPolynomial.X 0)) * e_c.symm z = 0 := by
        apply e_c.injective
        rw [map_mul, he_c, RingEquiv.apply_symm_apply, map_zero]
        exact hz
      have hsymm0 : e_c.symm z = 0 := hReg_u j₀ hPc (e_c.symm z) hmul_quot
      calc z = e_c (e_c.symm z) := (RingEquiv.apply_symm_apply e_c z).symm
        _ = 0 := by rw [hsymm0, map_zero]

    obtain ⟨Ψ, hΨ_C, hΨ_X0, hΨ_X1⟩ :=
      hOv0c_iso j₀ B_0 B_c q_0 q_c ⟨e_0, he_0⟩ ⟨e_c, he_c⟩

    obtain ⟨hDom_Bc, hIntCl_Bc_fn, hEmbed_Bc_fn⟩ :=
      hOverlapTransfer (q_0 (MvPolynomial.X j₀)) hv0_ne (q_c (MvPolynomial.X 0)) huc_reg Ψ
    letI : IsDomain B_c := hDom_Bc

    have hIntCl_Bc : IsIntegrallyClosed B_c :=
      hIntCl_Bc_fn fun 𝔪 h𝔪 =>
        hLocInt_c j₀ hPc B_c 𝔪 (Localization.AtPrime 𝔪) h𝔪 ⟨e_c⟩

    have hDom_quot_c :
        (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
         let B₂_c := integralClosure A L₂
         let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
         IsDomain (↥B₂_c ⧸ I_hc)) := by
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      exact Function.Injective.isDomain e_c.toRingHom e_c.injective

    have hIntCl_quot_c :
        (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
         let B₂_c := integralClosure A L₂
         let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
         IsIntegrallyClosed (↥B₂_c ⧸ I_hc)) := by
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      letI : IsIntegrallyClosed B_c := hIntCl_Bc
      exact IsIntegrallyClosed.of_equiv e_c.symm

    refine ⟨⟨hDom_quot_c, hIntCl_quot_c⟩, ?_⟩
    intro L_Sigma _ _ _ _
    dsimp only
    intro ι_0 hFrac0 hAlign0
    let ι'_0 : B_0 →+* L_Sigma := ι_0.comp e_0.symm.toRingHom
    have hFrac'_0 : (letI : Algebra B_0 L_Sigma := ι'_0.toAlgebra; IsFractionRing B_0 L_Sigma) := by
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      let B₂_0 := integralClosure A L₂
      let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
      letI : IsDomain (↥B₂_0 ⧸ I_h₀) := hPart1.1
      exact hFracEquiv (↥B₂_0 ⧸ I_h₀) B_0 L_Sigma e_0 ι_0 hFrac0

    obtain ⟨ι'_c, hι'c_inj, hFrac'_c, hMul_u, hEq_Ψ, hMul_Ψ⟩ :=
      hEmbed_Bc_fn hΨ_X0 L_Sigma ι'_0 hFrac'_0

    letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
    let B₂_c := integralClosure A L₂
    let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
    letI : IsDomain (↥B₂_c ⧸ I_hc) := hDom_quot_c

    let ι_c : (↥B₂_c ⧸ I_hc) →+* L_Sigma := ι'_c.comp e_c.toRingHom
    have hιc_inj : Function.Injective ι_c := hι'c_inj.comp e_c.injective
    have hFrac_c :
        (letI : Algebra (↥B₂_c ⧸ I_hc) L_Sigma := ι_c.toAlgebra
         IsFractionRing (↥B₂_c ⧸ I_hc) L_Sigma) := by
      have hSurj'_c :
          ∀ z : L_Sigma, ∃ p : B_c × nonZeroDivisors B_c, z * ι'_c p.2.1 = ι'_c p.1 := by
        letI : Algebra B_c L_Sigma := ι'_c.toAlgebra
        exact fun z => IsLocalization.surj (nonZeroDivisors B_c) z
      letI : Algebra (↥B₂_c ⧸ I_hc) L_Sigma := ι_c.toAlgebra
      refine ⟨?_, ?_, ?_⟩
      · intro y
        have hy_ne : (y : ↥B₂_c ⧸ I_hc) ≠ 0 := nonZeroDivisors.coe_ne_zero y
        have hmap_ne : ι_c y.1 ≠ 0 := fun h0 => hy_ne (hιc_inj (h0.trans (map_zero ι_c).symm))
        exact IsUnit.mk0 (ι_c y.1) hmap_ne
      · intro z
        obtain ⟨⟨a_c, b_c⟩, hzc⟩ := hSurj'_c z
        have hbc_ne : (b_c : B_c) ≠ 0 := nonZeroDivisors.coe_ne_zero b_c
        have hsymm_ne : e_c.symm b_c.1 ≠ 0 := fun h0 =>
          hbc_ne (e_c.symm.injective (h0.trans (map_zero e_c.symm).symm))
        refine ⟨⟨e_c.symm a_c, ⟨e_c.symm b_c.1, mem_nonZeroDivisors_of_ne_zero hsymm_ne⟩⟩, ?_⟩
        change z * ι'_c (e_c (e_c.symm b_c.1)) = ι'_c (e_c (e_c.symm a_c))
        rw [RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
        exact hzc
      · intro x y hxy
        exact ⟨1, by rw [OneMemClass.coe_one, one_mul, one_mul, hιc_inj hxy]⟩

    let f_0 : A →+* L_Sigma := ι'_0.comp q_0
    let f_c : A →+* L_Sigma := ι'_c.comp q_c
    have hf0_align : ∀ g : A, f_0 g =
        algebraMap (RatFunc k) L_Sigma
          (MvPolynomial.aeval (fun j : Fin 2 =>
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] ((0 : Fin 3).succAbove j)) /
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] 0)) g) := by
      intro g
      dsimp [f_0, ι'_0]
      rw [← he_0 g, RingEquiv.symm_apply_apply]
      exact hAlign0 g
    have hfc_C : ∀ c₀ : k, f_c (MvPolynomial.C c₀) = f_0 (MvPolynomial.C c₀) :=
      fun c₀ => hEq_Ψ (q_0 (MvPolynomial.C c₀)) (q_c (MvPolynomial.C c₀)) (hΨ_C c₀)
    have hfc_X0 : f_0 (MvPolynomial.X j₀) * f_c (MvPolynomial.X 0) = 1 := hMul_u
    have hfc_X1 :
        f_0 (MvPolynomial.X (Fin.rev j₀)) * f_c (MvPolynomial.X 0) = f_c (MvPolynomial.X 1) :=
      hMul_Ψ (q_0 (MvPolynomial.X (Fin.rev j₀))) (q_c (MvPolynomial.X 1)) hΨ_X1

    have hAlign_c : ∀ g : A,
        ι_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g)) =
          algebraMap (RatFunc k) L_Sigma
            (MvPolynomial.aeval (fun j : Fin 2 =>
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) g) := by
      intro g
      change ι'_c (e_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g))) = _
      rw [he_c g]
      exact hAlign_ext L_Sigma f_0 f_c hf0_align hfc_C hfc_X0 hfc_X1 g

    refine ⟨ι_c, hιc_inj, hAlign_c, ?_⟩
    exact hRangeIff ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
      (eval_c c H_Sigma) _ hKer_c hIntCl_quot_c L_Sigma ι_c hFrac_c hAlign_c

theorem weil_net_curve_three_chart_idempotent_gluing_domain (k : Type u) [Field k] [IsAlgClosed k] :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (d_Sigma d_disc : ℕ)
      (H_Sigma F_disc_hom : MvPolynomial (Fin 3) k)
      (P₀ P₁ P₂ : Polynomial k)
      (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂],
      1 ≤ d_Sigma → 1 ≤ d_disc →
