      have hσ_B0_diff : ∀ y : ↥B₂_0, σ_B0 y - y ∈ 𝔐₀ := by
        intro y
        obtain ⟨z, hz_mem, hz_eq⟩ := hσ_𝔐₀ y
        have hsub : σ_B0 y - y = z := Subtype.ext hz_eq.symm
        rwa [hsub]
      have hσ_fix_A₀ : ∀ g : A₀, σ (algebraMap A₀ L₂ g) = algebraMap A₀ L₂ g :=
        fun g => σ.commutes (algebraMap A₀ K₂ g)
      have hσ_C_mem : ∀ c : ↥C_p, σ c.1 ∈ C_p := by
        intro c
        obtain ⟨y, g, hg, hcg⟩ := (hInt_char c.1).mp c.2
        change _root_.IsIntegral R'_p (algebraMap L₂ L'_2 (σ c.1))
        refine (hInt_char (σ c.1)).mpr ⟨σ_B0 y, g, hg, ?_⟩
        calc
          σ c.1 * algebraMap A₀ L₂ g = σ c.1 * σ (algebraMap A₀ L₂ g) := by rw [hσ_fix_A₀]
          _ = σ (c.1 * algebraMap A₀ L₂ g) := (map_mul σ _ _).symm
          _ = σ y.1 := congrArg σ hcg
          _ = (σ_B0 y : L₂) := rfl
      let σ_C : ↥C_p →+* ↥C_p :=
        { toFun := fun c => ⟨σ c.1, hσ_C_mem c⟩
          map_one' := Subtype.ext (map_one σ)
          map_mul' := fun _ _ => Subtype.ext (map_mul σ _ _)
          map_zero' := Subtype.ext (map_zero σ)
          map_add' := fun _ _ => Subtype.ext (map_add σ _ _) }
      have hσ_C_diff : ∀ c : ↥C_p, σ_C c - c ∈ 𝔐_C := by
        intro c
        obtain ⟨⟨y, m⟩, hcm⟩ := IsLocalization.surj M c
        change c * j₀ m.1 = j₀ y at hcm
        have hm_fix : σ_C (j₀ m.1) = j₀ m.1 := by
          rcases m with ⟨_, g, _, rfl⟩
          exact Subtype.ext (hσ_fix_A₀ g)
        have hrel : (σ_C c - c) * j₀ m.1 = j₀ (σ_B0 y - y) := by
          have h1 : σ_C c * j₀ m.1 = j₀ (σ_B0 y) := by
            calc
              σ_C c * j₀ m.1 = σ_C c * σ_C (j₀ m.1) := by rw [hm_fix]
              _ = σ_C (c * j₀ m.1) := (map_mul σ_C _ _).symm
              _ = σ_C (j₀ y) := congrArg σ_C hcm
              _ = j₀ (σ_B0 y) := rfl
          rw [sub_mul, h1, hcm, map_sub]
        have hdiff_m : (σ_C c - c) * j₀ m.1 ∈ 𝔐_C :=
          hrel ▸ Ideal.mem_map_of_mem j₀ (hσ_B0_diff y)
        rcases (IsLocalization.map_units ↥C_p m).exists_right_inv with ⟨um_inv, hum⟩
        change j₀ m.1 * um_inv = 1 at hum
        have h2 := Ideal.mul_mem_right um_inv _ hdiff_m
        rwa [mul_assoc, hum, mul_one] at h2
      have hσ_C_comap : Ideal.comap σ_C 𝔐_C = 𝔐_C := by
        ext c
        change σ_C c ∈ 𝔐_C ↔ c ∈ 𝔐_C
        rw [show σ_C c = (σ_C c - c) + c from (sub_add_cancel _ _).symm]
        exact Ideal.add_mem_iff_right 𝔐_C (hσ_C_diff c)
      obtain ⟨σ₁, hσ₁_ext⟩ := AlgEquiv.restrictNormalHom_surjective (F := K₂) (K₁ := L₂) L'_2 σ
      have hσ₁_L₂ : ∀ x : L₂, σ₁ (algebraMap L₂ L'_2 x) = algebraMap L₂ L'_2 (σ x) := by
        intro x
        have h1 := (σ₁.restrictNormal_commutes L₂ x).symm
        have h2 : σ₁.restrictNormal L₂ = σ := hσ₁_ext
        rwa [h2] at h1
      let 𝔐'_1 : Ideal ↥B'_p := Ideal.comap (τ_to_B σ₁) 𝔐'
      haveI : 𝔐'_1.IsPrime := Ideal.comap_isPrime (τ_to_B σ₁) 𝔐'
      have h𝔐'_1_under : Ideal.under ↥C_p 𝔐'_1 = Ideal.under ↥C_p 𝔐' := by
        have hcomp_C : (τ_to_B σ₁).comp j' = j'.comp σ_C :=
          RingHom.ext (fun c => Subtype.ext (hσ₁_L₂ c.1))
        have h_c1 : Ideal.under ↥C_p 𝔐'_1 = Ideal.comap ((τ_to_B σ₁).comp j') 𝔐' := by
          ext x; rfl
        have h_c2 : Ideal.comap (j'.comp σ_C) 𝔐' = Ideal.comap σ_C (Ideal.under ↥C_p 𝔐') := by
          ext x; rfl
        rw [h_c1, hcomp_C, h_c2, h𝔐'_under_C, hσ_C_comap]
      obtain ⟨h, hh_smul⟩ :=
        Algebra.IsInvariant.exists_smul_of_under_eq ↥C_p ↥B'_p H₀ 𝔐'_1 𝔐' h𝔐'_1_under
      let τ : L'_2 ≃ₐ[K₂] L'_2 := σ₁ * (h.restrictScalars K₂)⁻¹
      let τ_B : ↥B'_p →+* ↥B'_p := τ_to_B τ
      have hτ_B_comap : Ideal.comap τ_B 𝔐' = 𝔐' := by
        ext b
        have hτ_apply : τ_B b = τ_to_B σ₁ (h⁻¹ • b) := by
          apply Subtype.ext
          rfl
        change τ_B b ∈ 𝔐' ↔ b ∈ 𝔐'
        rw [hτ_apply]
        change h⁻¹ • b ∈ 𝔐'_1 ↔ b ∈ 𝔐'
        rw [← Ideal.mem_pointwise_smul_iff_inv_smul_mem, ← hh_smul]
      let I_ϖ : Ideal ↥B'_p := Ideal.span {algebraMap R'_p ↥B'_p ϖ}
      have hτ_B_ϖ : τ_B (algebraMap R'_p ↥B'_p ϖ) ∈ I_ϖ := by
        obtain ⟨ζ, _, hτϖ⟩ := (hTau_props τ).1
        have heq : τ_B (algebraMap R'_p ↥B'_p ϖ) =
            algebraMap R'_p ↥B'_p (algebraMap k R'_p ζ) * algebraMap R'_p ↥B'_p ϖ :=
          Subtype.ext (by
            change τ (algebraMap R'_p L'_2 ϖ) =
              algebraMap R'_p L'_2 (algebraMap k R'_p ζ) * algebraMap R'_p L'_2 ϖ
            rw [hτϖ, map_mul])
        rw [heq]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      have hτ_B_R : ∀ r : R'_p,
          τ_B (algebraMap R'_p ↥B'_p r) - algebraMap R'_p ↥B'_p r ∈ I_ϖ := by
        intro r
        obtain ⟨s, hτr⟩ := (hTau_props τ).2.2 r
        have heq : τ_B (algebraMap R'_p ↥B'_p r) - algebraMap R'_p ↥B'_p r =
            algebraMap R'_p ↥B'_p s * algebraMap R'_p ↥B'_p ϖ :=
          Subtype.ext (by
            change τ (algebraMap R'_p L'_2 r) - algebraMap R'_p L'_2 r =
              algebraMap R'_p L'_2 s * algebraMap R'_p L'_2 ϖ
            rw [hτr, map_mul, mul_comm])
        rw [heq]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      intro y
      obtain ⟨z₀, _, hz₀_eq⟩ := hσ_𝔐₀ y
      have hι_z₀ : ι_B0 z₀ = τ_B (ι_B0 y) - ι_B0 y := by
        apply Subtype.ext
        change algebraMap L₂ L'_2 z₀.1 = τ (algebraMap L₂ L'_2 y.1) - algebraMap L₂ L'_2 y.1
        have hτ_y : τ (algebraMap L₂ L'_2 y.1) = algebraMap L₂ L'_2 (σ y.1) := by
          change σ₁ ((h⁻¹ : H₀) (algebraMap L₂ L'_2 y.1)) = algebraMap L₂ L'_2 (σ y.1)
          rw [AlgEquiv.commutes h⁻¹ y.1, hσ₁_L₂]
        rw [hz₀_eq, map_sub, hτ_y]
      have hz₀_Q : z₀ ∈ Q_C := by
        change ι_B0 z₀ ∈ 𝔔'_C
        rw [hι_z₀]
        exact hRigid τ_B hτ_B_comap hτ_B_ϖ hτ_B_R (ι_B0 y)
      exact ⟨z₀, hz₀_Q, hz₀_eq⟩

theorem weil_net_abhyankar_transverse_dvr_and_inertia_eq (k : Type u) [Field k] [IsAlgClosed k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
      (h₀ f₀ : A₀),
      (∀ (R_loc K_loc L_loc : Type u)
         [CommRing R_loc] [IsDomain R_loc] [IsNoetherianRing R_loc]
         [IsIntegrallyClosed R_loc] [IsLocalRing R_loc]
         [Field K_loc] [Algebra R_loc K_loc] [IsFractionRing R_loc K_loc]
         [Field L_loc] [Algebra K_loc L_loc] [FiniteDimensional K_loc L_loc]
         [Algebra.IsSeparable K_loc L_loc]
         [Algebra R_loc L_loc] [IsScalarTower R_loc K_loc L_loc]
         (t₁ t₂ : R_loc),
         t₁ ≠ 0 →
         (Ideal.span {t₁}).IsPrime →
         t₂ ∉ Ideal.span {t₁} →
         IsLocalRing.maximalIdeal R_loc = Ideal.span {t₁, t₂} →
         Nonempty (Module.Basis (Fin (Module.finrank K_loc L_loc)) R_loc
           ↥(integralClosure R_loc L_loc)) ∧
         ((∀ (Q : Ideal ↥(integralClosure R_loc L_loc)) [Q.IsPrime],
             Ideal.comap (algebraMap R_loc ↥(integralClosure R_loc L_loc)) Q ≠ ⊥ →
             Ideal.comap (algebraMap R_loc ↥(integralClosure R_loc L_loc)) Q ≠
               IsLocalRing.maximalIdeal R_loc →
             Algebra.IsUnramifiedAt R_loc Q) →
           Algebra.Etale R_loc ↥(integralClosure R_loc L_loc))) →
      Irreducible h₀ →
      Irreducible f₀ →
      (∃ p_wit : Fin 2 → k, MvPolynomial.eval p_wit h₀ = 0 ∧ MvPolynomial.eval p_wit f₀ = 0) →
      (∀ p : Fin 2 → k,
        MvPolynomial.eval p h₀ = 0 →
        MvPolynomial.eval p (MvPolynomial.pderiv 0 h₀) ≠ 0 ∨
        MvPolynomial.eval p (MvPolynomial.pderiv 1 h₀) ≠ 0) →
      (∀ p : Fin 2 → k,
        MvPolynomial.eval p h₀ = 0 →
        MvPolynomial.eval p f₀ = 0 →
        MvPolynomial.eval p (MvPolynomial.pderiv 0 f₀) *
          MvPolynomial.eval p (MvPolynomial.pderiv 1 h₀) -
        MvPolynomial.eval p (MvPolynomial.pderiv 1 f₀) *
          MvPolynomial.eval p (MvPolynomial.pderiv 0 h₀) ≠ 0) →
      (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
       let B₂_0 := integralClosure A₀ L₂
       @RingHom.Etale
         (Localization.Away f₀)
         (Localization.Away (algebraMap A₀ ↥B₂_0 f₀))
         inferInstance inferInstance
         (Localization.awayMap (algebraMap A₀ ↥B₂_0) f₀)) →
      (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
       let B₂_0 := integralClosure A₀ L₂
       ∀ (Q_C : Ideal ↥B₂_0), Q_C.IsPrime →
         Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C = Ideal.span {f₀} →
         ringChar k = 0 ∨
         Nat.Coprime (ringChar k)
           (Nat.card { σ : L₂ ≃ₐ[K₂] L₂ //
             ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0) })) →
      (∀ (B_bar : Type u) [CommRing B_bar]
         (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
         (R_bar : Type u) [CommRing R_bar] [Algebra B_bar R_bar]
         [IsLocalization.AtPrime R_bar 𝔪_bar],
        𝔪_bar.IsMaximal →
        (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
         let B₂_0 := integralClosure A₀ L₂
         let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A₀ ↥B₂_0 h₀}
         Nonempty ((↥B₂_0 ⧸ I_h₀) ≃+* B_bar)) →
        IsDomain R_bar ∧ IsIntegrallyClosed R_bar) ∧
      (∀ p : Fin 2 → k,
         MvPolynomial.eval p h₀ = 0 →
         MvPolynomial.eval p f₀ = 0 →
         letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
         let B₂_0 := integralClosure A₀ L₂
         ∀ (𝔐₀ : Ideal ↥B₂_0), 𝔐₀.IsMaximal →
           (∀ g : A₀, algebraMap A₀ ↥B₂_0 g ∈ 𝔐₀ ↔ MvPolynomial.eval p g = 0) →
           ∃ Q_C : Ideal ↥B₂_0,
             Q_C.IsPrime ∧
             (∀ x : ↥B₂_0, x ∈ Q_C → x ∈ 𝔐₀) ∧
             Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C = Ideal.span {f₀} ∧
             ∀ σ : L₂ ≃ₐ[K₂] L₂,
               (∀ y : ↥B₂_0, ∃ z ∈ Q_C, (z : L₂) = σ y.1 - y.1) ↔
               (∀ y : ↥B₂_0, ∃ z ∈ 𝔐₀, (z : L₂) = σ y.1 - y.1)) :=
by
  intro A₀ K₂ L₂ _ _ _ _ h₀ f₀ hPurity2D hIrr_h₀ hIrr_f₀ _hWit hSm_h₀ hTransv hEtale_away hTame
  obtain ⟨hNull, hDVR1D, hOffDisc, hTransvParams⟩ :=
    weil_abhyankar_plane_taylor_and_off_disc_etale_dvr k
  obtain ⟨e, he_pos, he_ne, hDivUnifSep⟩ :=
    weil_abhyankar_tame_divisor_ramification_and_residue_sep k L₂ f₀ hIrr_f₀ hTame
  have hKerMax : ∀ p : Fin 2 → k, (RingHom.ker (MvPolynomial.eval p : A₀ →+* k)).IsMaximal :=
    fun p => RingHom.ker_isMaximal_of_surjective (MvPolynomial.eval p)
      (fun c => ⟨MvPolynomial.C c, MvPolynomial.eval_C c⟩)
  letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
  let B₂_0 := integralClosure A₀ L₂
  let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A₀ ↥B₂_0 h₀}
  have hOnDisc : ∀ (p : Fin 2 → k),
      MvPolynomial.eval p h₀ = 0 →
      MvPolynomial.eval p f₀ = 0 →
      (∀ (𝔐₀ : Ideal ↥B₂_0), 𝔐₀.IsMaximal →
         (∀ g : A₀, algebraMap A₀ ↥B₂_0 g ∈ 𝔐₀ ↔ MvPolynomial.eval p g = 0) →
         ∀ (B_bar : Type u) [CommRing B_bar]
           (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
           (R_bar : Type u) [CommRing R_bar] [Algebra B_bar R_bar]
           [IsLocalization.AtPrime R_bar 𝔪_bar],
           𝔪_bar.IsMaximal →
           ∀ (e_bar : (↥B₂_0 ⧸ I_h₀) ≃+* B_bar),
             Ideal.comap (e_bar.toRingHom.comp (Ideal.Quotient.mk I_h₀)) 𝔪_bar = 𝔐₀ →
             IsDomain R_bar ∧ IsIntegrallyClosed R_bar) ∧
      (∀ (𝔐₀ : Ideal ↥B₂_0), 𝔐₀.IsMaximal →
         (∀ g : A₀, algebraMap A₀ ↥B₂_0 g ∈ 𝔐₀ ↔ MvPolynomial.eval p g = 0) →
         ∃ Q_C : Ideal ↥B₂_0,
           Q_C.IsPrime ∧
           (∀ x : ↥B₂_0, x ∈ Q_C → x ∈ 𝔐₀) ∧
           Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C = Ideal.span {f₀} ∧
           ∀ σ : L₂ ≃ₐ[K₂] L₂,
             (∀ y : ↥B₂_0, ∃ z ∈ Q_C, (z : L₂) = σ y.1 - y.1) ↔
             (∀ y : ↥B₂_0, ∃ z ∈ 𝔐₀, (z : L₂) = σ y.1 - y.1)) := by
    intro p hp_h₀ hp_f₀
    let 𝔪_p : Ideal A₀ := RingHom.ker (MvPolynomial.eval p)
    letI : 𝔪_p.IsMaximal := hKerMax p
    have h𝔪_p_mem : ∀ g : A₀, g ∈ 𝔪_p ↔ MvPolynomial.eval p g = 0 := fun _ => Iff.rfl
    have hReg := hTransvParams h₀ f₀ hIrr_h₀ hIrr_f₀ p hp_h₀ hp_f₀
      (hTransv p hp_h₀ hp_f₀) 𝔪_p h𝔪_p_mem
    obtain ⟨R'_p, K'_2, L'_2, hCR, hDom, hNoeth, hIC, hLoc,
        hFK, hARK, hFracK, hFL, hAK₂L, hFDK₂L, hGalK₂L,
        hAL₂L, hSTK₂L₂L, hFDL₂L, hGalL₂L,
        hAK'L, hFDK'L, hSepK'L, hAR'L, hSTR'K'L,
        hAkR', hAA₀R', hSTkA₀R', ϖ,
        hOut1, hOut2, hOut3, hCodim1⟩ :=
      weil_abhyankar_kummer_regular_local_and_codim1_unramified k L₂ h₀ f₀ hIrr_h₀ hIrr_f₀
        p hp_h₀ hp_f₀ 𝔪_p h𝔪_p_mem hReg hEtale_away e he_pos he_ne hDivUnifSep
    letI := hCR; letI := hDom; letI := hNoeth; letI := hIC; letI := hLoc
    letI := hFK; letI := hARK; letI := hFracK
    letI := hFL; letI := hAK₂L; letI := hFDK₂L; letI := hGalK₂L
    letI := hAL₂L; letI := hSTK₂L₂L; letI := hFDL₂L; letI := hGalL₂L
    letI := hAK'L; letI := hFDK'L; letI := hSepK'L; letI := hAR'L; letI := hSTR'K'L
    letI := hAkR'; letI := hAA₀R'; letI := hSTkA₀R'
    have ⟨hϖ_ne, _, _, hϖ_prime, _, hh'_not_ϖ, _, hmax_R', _, _⟩ := hOut2
    have hEtale_R' : Algebra.Etale R'_p ↥(integralClosure R'_p L'_2) :=
      (hPurity2D R'_p K'_2 L'_2 ϖ (algebraMap A₀ R'_p h₀)
        hϖ_ne hϖ_prime hh'_not_ϖ hmax_R').2 hCodim1
    exact weil_abhyankar_reynolds_dvr_and_unramified_inertia_descent k L₂ h₀ f₀ hIrr_h₀ hIrr_f₀
      p hp_h₀ hp_f₀ e he_pos he_ne hDVR1D R'_p K'_2 L'_2 ϖ hOut1 hOut2 hOut3 hEtale_R'
  refine ⟨?_, ?_⟩
  · intro B_bar _ 𝔪_bar _ R_bar _ _ _ h𝔪_max ⟨e_bar⟩
    let π_bar : ↥B₂_0 →+* B_bar := e_bar.toRingHom.comp (Ideal.Quotient.mk I_h₀)
    have hπ_surj : Function.Surjective π_bar :=
      e_bar.surjective.comp Ideal.Quotient.mk_surjective
    let 𝔐₀ : Ideal ↥B₂_0 := Ideal.comap π_bar 𝔪_bar
    have h𝔐₀_max : 𝔐₀.IsMaximal :=
      @Ideal.comap_isMaximal_of_surjective _ _ _ _ _ _ _ π_bar hπ_surj 𝔪_bar h𝔪_max
    obtain ⟨p, hp_mem⟩ := hNull ↥B₂_0 𝔐₀ h𝔐₀_max
    have hh₀_in_𝔐₀ : algebraMap A₀ ↥B₂_0 h₀ ∈ 𝔐₀ := by
      change e_bar (Ideal.Quotient.mk I_h₀ (algebraMap A₀ ↥B₂_0 h₀)) ∈ 𝔪_bar
      have hq0 : Ideal.Quotient.mk I_h₀ (algebraMap A₀ ↥B₂_0 h₀) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      rw [hq0, map_zero]
      exact 𝔪_bar.zero_mem
    have hp_h₀ : MvPolynomial.eval p h₀ = 0 := (hp_mem h₀).mp hh₀_in_𝔐₀
    by_cases hp_f₀ : MvPolynomial.eval p f₀ = 0
    · exact (hOnDisc p hp_h₀ hp_f₀).1 𝔐₀ h𝔐₀_max hp_mem B_bar 𝔪_bar R_bar h𝔪_max e_bar rfl
    · exact hOffDisc L₂ h₀ f₀ hIrr_h₀ hIrr_f₀ hSm_h₀ hEtale_away p hp_h₀ hp_f₀
        𝔐₀ h𝔐₀_max hp_mem B_bar 𝔪_bar R_bar h𝔪_max e_bar rfl
  · intro p hp_h₀ hp_f₀
    dsimp only
    intro 𝔐₀ h𝔐₀_max hp_mem
    exact (hOnDisc p hp_h₀ hp_f₀).2 𝔐₀ h𝔐₀_max hp_mem

theorem weil_esz_p2_chart_laurent_cech_and_neg_twist_vanishing (k : Type u) [Field k] :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ((∀ c : Fin 3, homCoord c ≠ 0) ∧
      Function.Injective (φ_K₂ 0) ∧
      Function.Injective (φ_K₂ 1) ∧
      (∀ P : MvPolynomial (Fin 2) k,
        φ_K₂ 0 P = algebraMap (MvPolynomial (Fin 2) k) K₂ P) ∧
      (∀ (b : ℕ) (P : MvPolynomial (Fin 2) k),
        P.totalDegree ≤ b → (x₁⁻¹) ^ b * φ_K₂ 0 P ∈ (φ_K₂ 1).range)) ∧
    @IsFractionRing (MvPolynomial (Fin 2) k) _ K₂ _ (φ_K₂ 1).toRingHom.toAlgebra ∧
    (∀ (d_Sigma : ℕ) (H_Sigma : MvPolynomial (Fin 3) k),
      H_Sigma.IsHomogeneous d_Sigma →
      ∀ c : Fin 3,
        φ_K₂ c (eval_c c H_Sigma) * (homCoord c) ^ d_Sigma = φ_K₂ 0 (eval_c 0 H_Sigma)) ∧
    (∀ c c' : Fin 3,
      homCoord c' / homCoord c ∈ (φ_K₂ c).range ∧
      ∀ u ∈ (φ_K₂ c).range ⊔ (φ_K₂ c').range,
        ∃ N : ℕ, (homCoord c' / homCoord c) ^ N * u ∈ (φ_K₂ c).range) ∧
    ((∀ (d : ℕ) (f : K₂),
        1 ≤ d → f ∈ (φ_K₂ 0).range → x₁ ^ d * f ∈ (φ_K₂ 1).range → f = 0) ∧
      (∀ f : K₂,
        f ∈ (φ_K₂ 0).range → f ∈ (φ_K₂ 1).range → ∃ c₀ : k, algebraMap k K₂ c₀ = f)) ∧
    (∀ (d : ℕ) (u₀₁ u₁₂ u₀₂ : K₂),
      1 ≤ d →
      u₀₁ ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 1).range →
      u₀₂ ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 2).range →
      x₁ ^ d * u₁₂ ∈ (φ_K₂ 1).range ⊔ (φ_K₂ 2).range →
      u₀₁ + u₁₂ = u₀₂ →
      ∃ v₀ v₁ : K₂,
        v₀ ∈ (φ_K₂ 0).range ∧ x₁ ^ d * v₁ ∈ (φ_K₂ 1).range ∧ v₁ - v₀ = u₀₁) :=
by
  classical
  let A := MvPolynomial (Fin 2) k
  suffices h_gen : ∀ (K₂ : Type u) [Field K₂] [Algebra k K₂] [Algebra A K₂]
      [IsScalarTower k A K₂] [IsFractionRing A K₂],
      let x₁ : K₂ := algebraMap A K₂ (MvPolynomial.X 0)
      let x₂ : K₂ := algebraMap A K₂ (MvPolynomial.X 1)
      let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
      let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] A :=
        fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
      let φ_K₂ : Fin 3 → A →ₐ[k] K₂ :=
        fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
      ((∀ c : Fin 3, homCoord c ≠ 0) ∧
        Function.Injective (φ_K₂ 0) ∧
        Function.Injective (φ_K₂ 1) ∧
        (∀ P : A, φ_K₂ 0 P = algebraMap A K₂ P) ∧
        (∀ (b : ℕ) (P : A),
          P.totalDegree ≤ b → (x₁⁻¹) ^ b * φ_K₂ 0 P ∈ (φ_K₂ 1).range)) ∧
      @IsFractionRing A _ K₂ _ (φ_K₂ 1).toRingHom.toAlgebra ∧
      (∀ (d_Sigma : ℕ) (H_Sigma : MvPolynomial (Fin 3) k),
        H_Sigma.IsHomogeneous d_Sigma →
        ∀ c : Fin 3,
          φ_K₂ c (eval_c c H_Sigma) * (homCoord c) ^ d_Sigma = φ_K₂ 0 (eval_c 0 H_Sigma)) ∧
      (∀ c c' : Fin 3,
        homCoord c' / homCoord c ∈ (φ_K₂ c).range ∧
        ∀ u ∈ (φ_K₂ c).range ⊔ (φ_K₂ c').range,
          ∃ N : ℕ, (homCoord c' / homCoord c) ^ N * u ∈ (φ_K₂ c).range) ∧
      ((∀ (d : ℕ) (f : K₂),
          1 ≤ d → f ∈ (φ_K₂ 0).range → x₁ ^ d * f ∈ (φ_K₂ 1).range → f = 0) ∧
        (∀ f : K₂,
          f ∈ (φ_K₂ 0).range → f ∈ (φ_K₂ 1).range → ∃ c₀ : k, algebraMap k K₂ c₀ = f)) ∧
      (∀ (d : ℕ) (u₀₁ u₁₂ u₀₂ : K₂),
        1 ≤ d →
        u₀₁ ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 1).range →
        u₀₂ ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 2).range →
        x₁ ^ d * u₁₂ ∈ (φ_K₂ 1).range ⊔ (φ_K₂ 2).range →
        u₀₁ + u₁₂ = u₀₂ →
        ∃ v₀ v₁ : K₂,
          v₀ ∈ (φ_K₂ 0).range ∧ x₁ ^ d * v₁ ∈ (φ_K₂ 1).range ∧ v₁ - v₀ = u₀₁) from
    h_gen (FractionRing A)
  intro K₂ _ _ _ _ _ x₁ x₂ homCoord eval_c φ_K₂

  
  have hA_inj : Function.Injective (algebraMap A K₂) := IsFractionRing.injective A K₂
  have hx₁_ne : x₁ ≠ 0 :=
    (map_ne_zero_iff (algebraMap A K₂) hA_inj).mpr (MvPolynomial.X_ne_zero 0)
  have hx₂_ne : x₂ ≠ 0 :=
    (map_ne_zero_iff (algebraMap A K₂) hA_inj).mpr (MvPolynomial.X_ne_zero 1)
  have hCoord_ne : ∀ c : Fin 3, homCoord c ≠ 0 := by
    intro c
    fin_cases c <;> simp [homCoord, hx₁_ne, hx₂_ne]

  have hx₁_pow_inv : ∀ n : ℕ, x₁ ^ n * (x₁⁻¹) ^ n = 1 :=
    fun n => by rw [inv_pow, mul_inv_cancel₀ (pow_ne_zero n hx₁_ne)]
  have hx₁_inv_pow : ∀ n : ℕ, (x₁⁻¹) ^ n * x₁ ^ n = 1 :=
    fun n => by rw [inv_pow, inv_mul_cancel₀ (pow_ne_zero n hx₁_ne)]

  have hcoeff_zero : ∀ m : Fin 2 →₀ ℕ, (0 : A).coeff m = 0 := fun _ => rfl
  have hcoeff_add : ∀ (P Q : A) (m : Fin 2 →₀ ℕ), (P + Q).coeff m = P.coeff m + Q.coeff m :=
    fun _ _ _ => rfl

  have hφ0_eq : φ_K₂ 0 = IsScalarTower.toAlgHom k A K₂ := by
    apply MvPolynomial.algHom_ext
    intro j
    fin_cases j
    · dsimp [φ_K₂, homCoord]
      rw [MvPolynomial.aeval_X, div_one]
      rfl
    · dsimp [φ_K₂, homCoord]
      rw [MvPolynomial.aeval_X, div_one]
      rfl
  have hφ0_apply : ∀ P : A, φ_K₂ 0 P = algebraMap A K₂ P :=
    fun P => AlgHom.congr_fun hφ0_eq P
  have hφ0_inj : Function.Injective (φ_K₂ 0) :=
    fun P Q h => hA_inj ((hφ0_apply P).symm.trans (h.trans (hφ0_apply Q)))

  let mk2 : ℕ → ℕ → (Fin 2 →₀ ℕ) := fun a b => Finsupp.single 0 a + Finsupp.single 1 b
  have hmk2_0 : ∀ a b : ℕ, mk2 a b 0 = a := fun a b => by simp [mk2]
  have hmk2_1 : ∀ a b : ℕ, mk2 a b 1 = b := fun a b => by simp [mk2]
  have h_finsupp2_ext : ∀ {m₁ m₂ : Fin 2 →₀ ℕ}, m₁ 0 = m₂ 0 → m₁ 1 = m₂ 1 → m₁ = m₂ := by
    intro m₁ m₂ h0 h1
    ext i
    fin_cases i <;> assumption

  have h_supp_le_tot : ∀ (P : A) {m : Fin 2 →₀ ℕ}, m ∈ P.support → m 0 + m 1 ≤ P.totalDegree := by
    intro P m hm
    have hle := MvPolynomial.le_totalDegree hm
    rwa [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at hle

  have hφ0_mon : ∀ (m : Fin 2 →₀ ℕ) (r : k),
      φ_K₂ 0 (MvPolynomial.monomial m r) = algebraMap k K₂ r * (x₁ ^ m 0 * x₂ ^ m 1) := by
    intro m r
    dsimp [φ_K₂, homCoord]
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
      Fin.prod_univ_two]
    simp

  have hφ1_mon : ∀ (m : Fin 2 →₀ ℕ) (r : k),
      φ_K₂ 1 (MvPolynomial.monomial m r) =
        algebraMap k K₂ r * ((x₁⁻¹) ^ m 0 * (x₂ / x₁) ^ m 1) := by
    intro m r
    dsimp [φ_K₂, homCoord]
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
      Fin.prod_univ_two]
    simp

  
  have hMirror1_pkg : ∃ mirror1 : ℕ → A → A,
      (∀ (D : ℕ) (P : A), P.totalDegree ≤ D → (mirror1 D P).totalDegree ≤ D) ∧
      (∀ (D : ℕ) (P : A), P.totalDegree ≤ D → x₁ ^ D * φ_K₂ 1 P = φ_K₂ 0 (mirror1 D P)) ∧
      (∀ (D : ℕ) (P : A), P.totalDegree ≤ D → (x₁⁻¹) ^ D * φ_K₂ 0 P = φ_K₂ 1 (mirror1 D P)) ∧
      (∀ (D : ℕ) (P : A), P.totalDegree ≤ D → mirror1 D P = 0 → P = 0) := by
    let mirror1 : ℕ → A → A := fun D P =>
      ∑ m ∈ P.support, MvPolynomial.monomial (mk2 (D - (m 0 + m 1)) (m 1)) (P.coeff m)
    refine ⟨mirror1, ?_, ?_, ?_, ?_⟩
    · intro D P hPD
      refine (MvPolynomial.totalDegree_finsetSum P.support _).trans ?_
      rw [Finset.sup_le_iff]
      intro m hm
      have hm_le : m 0 + m 1 ≤ D := (h_supp_le_tot P hm).trans hPD
      refine (MvPolynomial.totalDegree_monomial_le _ _).trans ?_
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
      dsimp [id]
      rw [hmk2_0, hmk2_1]
      omega
    · intro D P hPD
      conv_lhs => rw [MvPolynomial.as_sum P]
      dsimp only [mirror1]
      rw [map_sum, Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl fun m hm => ?_
      have hm_le : m 0 + m 1 ≤ D := (h_supp_le_tot P hm).trans hPD
      have hD_split : D = (D - (m 0 + m 1)) + m 0 + m 1 := by omega
      rw [hφ1_mon, hφ0_mon, hmk2_0, hmk2_1]
      calc x₁ ^ D * (algebraMap k K₂ (P.coeff m) * ((x₁⁻¹) ^ m 0 * (x₂ / x₁) ^ m 1))
          = algebraMap k K₂ (P.coeff m) * (x₁ ^ (D - (m 0 + m 1)) * x₂ ^ m 1) *
              (x₁ ^ m 0 * (x₁⁻¹) ^ m 0) * (x₁ ^ m 1 * (x₁⁻¹) ^ m 1) := by
              conv_lhs => rw [hD_split]
              rw [pow_add, pow_add, div_eq_mul_inv, mul_pow]
              ring
        _ = algebraMap k K₂ (P.coeff m) * (x₁ ^ (D - (m 0 + m 1)) * x₂ ^ m 1) := by
              rw [hx₁_pow_inv, hx₁_pow_inv, mul_one, mul_one]
    · intro D P hPD
      conv_lhs => rw [MvPolynomial.as_sum P]
      dsimp only [mirror1]
      rw [map_sum, Finset.mul_sum, map_sum]
      refine Finset.sum_congr rfl fun m hm => ?_
      have hm_le : m 0 + m 1 ≤ D := (h_supp_le_tot P hm).trans hPD
      have hD_split : D = (D - (m 0 + m 1)) + m 0 + m 1 := by omega
      rw [hφ0_mon, hφ1_mon, hmk2_0, hmk2_1]
      calc (x₁⁻¹) ^ D * (algebraMap k K₂ (P.coeff m) * (x₁ ^ m 0 * x₂ ^ m 1))
          = algebraMap k K₂ (P.coeff m) * ((x₁⁻¹) ^ (D - (m 0 + m 1)) * (x₂ * x₁⁻¹) ^ m 1) *
              ((x₁⁻¹) ^ m 0 * x₁ ^ m 0) := by
              conv_lhs => rw [hD_split]
              rw [pow_add, pow_add, mul_pow]
              ring
        _ = algebraMap k K₂ (P.coeff m) * ((x₁⁻¹) ^ (D - (m 0 + m 1)) * (x₂ / x₁) ^ m 1) := by
              rw [hx₁_inv_pow, mul_one, ← div_eq_mul_inv]
    · intro D P hPD hmir0
      rw [MvPolynomial.ext_iff]
      intro m₀
      rw [hcoeff_zero]
      by_contra hc₀
      have hm₀ : m₀ ∈ P.support := MvPolynomial.mem_support_iff.mpr hc₀
      have hm₀_le : m₀ 0 + m₀ 1 ≤ D := (h_supp_le_tot P hm₀).trans hPD
      let μ₀ := mk2 (D - (m₀ 0 + m₀ 1)) (m₀ 1)
      have hcoeff0 : (mirror1 D P).coeff μ₀ = 0 := by rw [hmir0, hcoeff_zero]
      dsimp only [mirror1] at hcoeff0
      rw [MvPolynomial.coeff_sum] at hcoeff0
      have hsum_eq :
          (∑ m ∈ P.support,
            (MvPolynomial.monomial (mk2 (D - (m 0 + m 1)) (m 1)) (P.coeff m)).coeff μ₀) =
          ∑ m ∈ P.support, if m = m₀ then P.coeff m else 0 := by
        refine Finset.sum_congr rfl fun m hm => ?_
        have hm_le : m 0 + m 1 ≤ D := (h_supp_le_tot P hm).trans hPD
        rw [MvPolynomial.coeff_monomial]
        have hiff : mk2 (D - (m 0 + m 1)) (m 1) = μ₀ ↔ m = m₀ := by
          constructor
          · intro heq
            have he0 : mk2 (D - (m 0 + m 1)) (m 1) 0 = μ₀ 0 := congrArg (· 0) heq
            have he1 : mk2 (D - (m 0 + m 1)) (m 1) 1 = μ₀ 1 := congrArg (· 1) heq
            dsimp only [μ₀] at he0 he1
            rw [hmk2_0, hmk2_0] at he0
            rw [hmk2_1, hmk2_1] at he1
            exact h_finsupp2_ext (by omega) he1
          · rintro rfl; rfl
        simp [hiff]
      rw [hsum_eq, Finset.sum_ite_eq' P.support m₀ (fun m => P.coeff m)] at hcoeff0
      simp only [hm₀, ↓reduceIte] at hcoeff0
      exact hc₀ hcoeff0

  obtain ⟨mirror1, h_mir_deg, h_mir_1to0, h_mir_0to1, h_mir_zero⟩ := hMirror1_pkg

  have hφ1_inj : Function.Injective (φ_K₂ 1) := by
    intro P Q hPQ
    let R := P - Q
    have hR0 : φ_K₂ 1 R = 0 := by rw [map_sub, hPQ, sub_self]
    have hmir0 : φ_K₂ 0 (mirror1 R.totalDegree R) = 0 := by
      rw [← h_mir_1to0 R.totalDegree R (le_refl _), hR0, mul_zero]
    have hR_mir_zero : mirror1 R.totalDegree R = 0 :=
      hφ0_inj (hmir0.trans (map_zero (φ_K₂ 0)).symm)
    exact sub_eq_zero.mp (h_mir_zero R.totalDegree R (le_refl _) hR_mir_zero)

  have hPole_shift : ∀ (b : ℕ) (P : A),
      P.totalDegree ≤ b → (x₁⁻¹) ^ b * φ_K₂ 0 P ∈ (φ_K₂ 1).range :=
    fun b P hPb => ⟨mirror1 b P, (h_mir_0to1 b P hPb).symm⟩

  have hsurj_chart0 : ∀ z : K₂,
      ∃ x : A × nonZeroDivisors A, z * algebraMap A K₂ x.2 = algebraMap A K₂ x.1 :=
    IsLocalization.surj (nonZeroDivisors A)

  have hFrac1 : @IsFractionRing A _ K₂ _ (φ_K₂ 1).toRingHom.toAlgebra := by
    let _ : Algebra A K₂ := (φ_K₂ 1).toRingHom.toAlgebra
    refine ⟨?_, ?_, ?_⟩
    · intro y
      have hy_ne : (y : A) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hmap_ne : φ_K₂ 1 (y : A) ≠ 0 :=
        fun h0 => hy_ne (hφ1_inj (h0.trans (map_zero (φ_K₂ 1)).symm))
      exact IsUnit.mk0 (φ_K₂ 1 (y : A)) hmap_ne
    · intro z
      obtain ⟨⟨P₀, S₀⟩, hz_eq⟩ := hsurj_chart0 z
      have hz_φ0 : z * φ_K₂ 0 (S₀ : A) = φ_K₂ 0 P₀ := by
        rwa [hφ0_apply, hφ0_apply]
      have hS₀_ne : (S₀ : A) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp S₀.2
      let E := max P₀.totalDegree (S₀ : A).totalDegree
      have hP₀_le : P₀.totalDegree ≤ E := le_max_left _ _
      have hS₀_le : (S₀ : A).totalDegree ≤ E := le_max_right _ _
      have hS_mir_ne : mirror1 E (S₀ : A) ≠ 0 :=
        fun h0 => hS₀_ne (h_mir_zero E (S₀ : A) hS₀_le h0)
      let S_mir : nonZeroDivisors A :=
        ⟨mirror1 E (S₀ : A), mem_nonZeroDivisors_iff_ne_zero.mpr hS_mir_ne⟩
      refine ⟨(mirror1 E P₀, S_mir), ?_⟩
      change z * φ_K₂ 1 (mirror1 E (S₀ : A)) = φ_K₂ 1 (mirror1 E P₀)
      rw [← h_mir_0to1 E (S₀ : A) hS₀_le, ← h_mir_0to1 E P₀ hP₀_le, ← hz_φ0]
      ring
    · intro a b hab
      have heq : a = b := hφ1_inj hab
      exact ⟨1, by simp [heq]⟩

  
  have hφ_X : ∀ (c : Fin 3) (j : Fin 2),
      φ_K₂ c (MvPolynomial.X j) = homCoord (c.succAbove j) / homCoord c :=
    fun c j => MvPolynomial.aeval_X _ j
  have heval_X : ∀ (c r : Fin 3),
      eval_c c (MvPolynomial.X r) = Fin.succAboveCases c 1 MvPolynomial.X r :=
    fun c r => MvPolynomial.aeval_X _ r

  have hComp_eval : ∀ c : Fin 3,
      (φ_K₂ c).comp (eval_c c) = MvPolynomial.aeval (fun r : Fin 3 => homCoord r / homCoord c) := by
    intro c
    apply MvPolynomial.algHom_ext
    intro r
    change φ_K₂ c (eval_c c (MvPolynomial.X r)) =
      MvPolynomial.aeval (fun r' : Fin 3 => homCoord r' / homCoord c) (MvPolynomial.X r)
    rw [heval_X, MvPolynomial.aeval_X]
    fin_cases c <;> fin_cases r <;>
      simp [Fin.succAboveCases, Fin.succAbove, hφ_X, homCoord, hx₁_ne, hx₂_ne]

  have hHom_formula : ∀ (d_Sigma : ℕ) (H_Sigma : MvPolynomial (Fin 3) k),
      H_Sigma.IsHomogeneous d_Sigma →
      ∀ c : Fin 3,
        φ_K₂ c (eval_c c H_Sigma) * (homCoord c) ^ d_Sigma =
          ∑ v ∈ H_Sigma.support,
            algebraMap k K₂ (H_Sigma.coeff v) *
              ((homCoord 0) ^ v 0 * (homCoord 1) ^ v 1 * (homCoord 2) ^ v 2) := by
    intro d_Sigma H_Sigma hHom c
    have h_app : φ_K₂ c (eval_c c H_Sigma) =
        MvPolynomial.aeval (fun r : Fin 3 => homCoord r / homCoord c) H_Sigma :=
      AlgHom.congr_fun (hComp_eval c) H_Sigma
    rw [h_app]
    conv_lhs => rw [MvPolynomial.as_sum H_Sigma]
    rw [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl fun v hv => ?_
    have hv_ne : H_Sigma.coeff v ≠ 0 := MvPolynomial.mem_support_iff.mp hv
    have hv_deg : v 0 + v 1 + v 2 = d_Sigma := by
      have hw := hHom hv_ne
      rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (fun _ => by simp),
        Fin.sum_univ_three] at hw
      simpa only [Pi.one_apply, smul_eq_mul, mul_one] using hw
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
      Fin.prod_univ_three]
    set u := homCoord c
    have hu : u ≠ 0 := hCoord_ne c
    calc (algebraMap k K₂ (H_Sigma.coeff v) *
            ((homCoord 0 / u) ^ v 0 * (homCoord 1 / u) ^ v 1 * (homCoord 2 / u) ^ v 2)) *
          u ^ d_Sigma
        = algebraMap k K₂ (H_Sigma.coeff v) *
            (((homCoord 0) ^ v 0 / u ^ v 0 * u ^ v 0) *
              ((homCoord 1) ^ v 1 / u ^ v 1 * u ^ v 1) *
              ((homCoord 2) ^ v 2 / u ^ v 2 * u ^ v 2)) := by
            rw [← hv_deg, pow_add, pow_add, div_pow, div_pow, div_pow]
            ring
      _ = algebraMap k K₂ (H_Sigma.coeff v) *
            ((homCoord 0) ^ v 0 * (homCoord 1) ^ v 1 * (homCoord 2) ^ v 2) := by
            rw [div_mul_cancel₀ _ (pow_ne_zero _ hu),
              div_mul_cancel₀ _ (pow_ne_zero _ hu),
              div_mul_cancel₀ _ (pow_ne_zero _ hu)]

  have hHom_scale : ∀ (d_Sigma : ℕ) (H_Sigma : MvPolynomial (Fin 3) k),
      H_Sigma.IsHomogeneous d_Sigma →
      ∀ c : Fin 3,
        φ_K₂ c (eval_c c H_Sigma) * (homCoord c) ^ d_Sigma = φ_K₂ 0 (eval_c 0 H_Sigma) := by
    intro d_Sigma H_Sigma hHom c
    have hc := hHom_formula d_Sigma H_Sigma hHom c
    have h0 := hHom_formula d_Sigma H_Sigma hHom 0
    have hc0 : (homCoord 0) ^ d_Sigma = 1 := by dsimp [homCoord]; exact one_pow d_Sigma
    rw [hc0, mul_one] at h0
    exact hc.trans h0.symm

  
  have hRatio_mem : ∀ c c' : Fin 3, homCoord c' / homCoord c ∈ (φ_K₂ c).range := by
    intro c c'
    by_cases hcc : c = c'
    · subst hcc
      rw [div_self (hCoord_ne c)]
      exact (φ_K₂ c).range.one_mem
    · fin_cases c <;> fin_cases c'
      · exact False.elim (hcc rfl)
      · exact ⟨MvPolynomial.X 0, hφ_X 0 0⟩
      · exact ⟨MvPolynomial.X 1, hφ_X 0 1⟩
      · exact ⟨MvPolynomial.X 0, hφ_X 1 0⟩
      · exact False.elim (hcc rfl)
      · exact ⟨MvPolynomial.X 1, hφ_X 1 1⟩
      · exact ⟨MvPolynomial.X 0, hφ_X 2 0⟩
      · exact ⟨MvPolynomial.X 1, hφ_X 2 1⟩
      · exact False.elim (hcc rfl)

  have hOv_clear : ∀ c c' : Fin 3,
      ∀ u ∈ (φ_K₂ c).range ⊔ (φ_K₂ c').range,
        ∃ N : ℕ, (homCoord c' / homCoord c) ^ N * u ∈ (φ_K₂ c).range := by
    intro c c'
    let R_c : Subalgebra k K₂ := (φ_K₂ c).range
    let t : K₂ := homCoord c' / homCoord c
    have ht_mem : t ∈ R_c := hRatio_mem c c'
    let S : Subalgebra k K₂ :=
      { carrier := { u : K₂ | ∃ N : ℕ, t ^ N * u ∈ R_c }
        mul_mem' := by
          rintro u₁ u₂ ⟨N₁, h₁⟩ ⟨N₂, h₂⟩
          refine ⟨N₁ + N₂, ?_⟩
          have heq : t ^ (N₁ + N₂) * (u₁ * u₂) = (t ^ N₁ * u₁) * (t ^ N₂ * u₂) := by
            rw [pow_add]; ring
          rw [heq]
          exact R_c.mul_mem h₁ h₂
        one_mem' := ⟨0, by rw [pow_zero, one_mul]; exact R_c.one_mem⟩
        add_mem' := by
          rintro u₁ u₂ ⟨N₁, h₁⟩ ⟨N₂, h₂⟩
          refine ⟨N₁ + N₂, ?_⟩
          have heq : t ^ (N₁ + N₂) * (u₁ + u₂) =
              t ^ N₂ * (t ^ N₁ * u₁) + t ^ N₁ * (t ^ N₂ * u₂) := by
            rw [pow_add]; ring
          rw [heq]
          exact R_c.add_mem (R_c.mul_mem (R_c.pow_mem ht_mem N₂) h₁)
            (R_c.mul_mem (R_c.pow_mem ht_mem N₁) h₂)
        zero_mem' := ⟨0, by rw [mul_zero]; exact R_c.zero_mem⟩
        algebraMap_mem' := fun r =>
          ⟨0, by rw [pow_zero, one_mul]; exact R_c.algebraMap_mem r⟩ }
    have hle : (φ_K₂ c).range ⊔ (φ_K₂ c').range ≤ S := by
      apply sup_le
      · intro u hu
        exact ⟨0, by rw [pow_zero, one_mul]; exact hu⟩
      · rintro u ⟨P, rfl⟩
        induction P using MvPolynomial.induction_on with
        | C r =>
          change φ_K₂ c' (MvPolynomial.C r) ∈ S
          rw [MvPolynomial.aeval_C]
          exact S.algebraMap_mem r
        | add p q ihp ihq =>
          rw [map_add]
          exact S.add_mem ihp ihq
        | mul_X p j ihp =>
          rw [map_mul]
          refine S.mul_mem ihp ⟨1, ?_⟩
          rw [pow_one]
          change t * φ_K₂ c' (MvPolynomial.X j) ∈ R_c
          have hXj : φ_K₂ c' (MvPolynomial.X j) =
              homCoord (c'.succAbove j) / homCoord c' := MvPolynomial.aeval_X _ j
          rw [hXj]
          have hc' : homCoord c' ≠ 0 := hCoord_ne c'
          have hcancel : t * (homCoord (c'.succAbove j) / homCoord c') =
              homCoord (c'.succAbove j) / homCoord c := by
            dsimp [t]
            calc (homCoord c' / homCoord c) * (homCoord (c'.succAbove j) / homCoord c')
                = (homCoord (c'.succAbove j) / homCoord c) * (homCoord c' / homCoord c') := by ring
              _ = homCoord (c'.succAbove j) / homCoord c := by rw [div_self hc', mul_one]
          rw [hcancel]
          exact hRatio_mem c (c'.succAbove j)
    intro u hu
    exact hle hu

  
  have hInter_deg : ∀ (d : ℕ) (P Q : A),
      x₁ ^ d * φ_K₂ 0 P = φ_K₂ 1 Q →
      ∀ {m : Fin 2 →₀ ℕ}, m ∈ P.support → m 0 + m 1 + d ≤ 0 := by
    intro d P Q hPQ m hm
    let D := Q.totalDegree
    have hLHS : φ_K₂ 0 (MvPolynomial.monomial (mk2 (D + d) 0) 1 * P) =
        φ_K₂ 0 (mirror1 D Q) := by
      rw [map_mul, hφ0_mon, hmk2_0, hmk2_1, map_one, pow_zero, mul_one, one_mul, pow_add,
        mul_assoc, hPQ, h_mir_1to0 D Q (le_refl D)]
    have hEqA : MvPolynomial.monomial (mk2 (D + d) 0) 1 * P = mirror1 D Q := hφ0_inj hLHS
    let μ := mk2 (D + d) 0 + m
    have hμ_coeff : (mirror1 D Q).coeff μ = P.coeff m := by
      rw [← hEqA]
      dsimp only [μ]
      rw [MvPolynomial.coeff_monomial_mul, one_mul]
    have hμ_mem : μ ∈ (mirror1 D Q).support := by
      rw [MvPolynomial.mem_support_iff, hμ_coeff]
      exact MvPolynomial.mem_support_iff.mp hm
    have hμ_tot : μ 0 + μ 1 ≤ D :=
      (h_supp_le_tot (mirror1 D Q) hμ_mem).trans (h_mir_deg D Q (le_refl D))
    have hμ0 : μ 0 = (D + d) + m 0 := by dsimp only [μ]; rw [Finsupp.add_apply, hmk2_0]
    have hμ1 : μ 1 = 0 + m 1 := by dsimp only [μ]; rw [Finsupp.add_apply, hmk2_1]
    omega

  have hNeg_vanish : ∀ (d : ℕ) (f : K₂),
      1 ≤ d → f ∈ (φ_K₂ 0).range → x₁ ^ d * f ∈ (φ_K₂ 1).range → f = 0 := by
    rintro d f hd ⟨P, rfl⟩ ⟨Q, hQ⟩
    have hQ' : φ_K₂ 1 Q = x₁ ^ d * φ_K₂ 0 P := hQ
    have hP0 : P = 0 := by
      rw [MvPolynomial.ext_iff]
      intro m
      rw [hcoeff_zero]
      by_contra hcm
      have hdeg := hInter_deg d P Q hQ'.symm (MvPolynomial.mem_support_iff.mpr hcm)
      omega
    change φ_K₂ 0 P = 0
    rw [hP0, map_zero]

  have hConst_inter : ∀ f : K₂,
      f ∈ (φ_K₂ 0).range → f ∈ (φ_K₂ 1).range → ∃ c₀ : k, algebraMap k K₂ c₀ = f := by
    rintro f ⟨P, rfl⟩ ⟨Q, hQ⟩
    have hQ' : φ_K₂ 1 Q = φ_K₂ 0 P := hQ
    have hPQ : x₁ ^ 0 * φ_K₂ 0 P = φ_K₂ 1 Q := by rw [pow_zero, one_mul, hQ']
    refine ⟨P.coeff 0, ?_⟩
    have hPC : P = MvPolynomial.C (P.coeff 0) := by
      rw [MvPolynomial.ext_iff]
      intro m
      rw [MvPolynomial.coeff_C]
      by_cases hm0 : 0 = m
      · subst hm0; simp
      · simp only [hm0, ↓reduceIte]
        by_contra hcm
        have hdeg := hInter_deg 0 P Q hPQ (MvPolynomial.mem_support_iff.mpr hcm)
        have h00 : (0 : Fin 2 →₀ ℕ) 0 = 0 := rfl
        have h01 : (0 : Fin 2 →₀ ℕ) 1 = 0 := rfl
        have hm_eq0 : (0 : Fin 2 →₀ ℕ) = m := h_finsupp2_ext (by omega) (by omega)
        exact hm0 hm_eq0
    change algebraMap k K₂ (P.coeff 0) = φ_K₂ 0 P
    calc algebraMap k K₂ (P.coeff 0)
        = φ_K₂ 0 (MvPolynomial.C (P.coeff 0)) := (MvPolynomial.aeval_C _ (P.coeff 0)).symm
      _ = φ_K₂ 0 P := congrArg (φ_K₂ 0) hPC.symm

  
  have h_mon_mul_supp : ∀ (s m : Fin 2 →₀ ℕ) (P : A),
      (MvPolynomial.monomial s (1 : k) * P).coeff m ≠ 0 → ∃ p ∈ P.support, s + p = m := by
    intro s m P hne
    have hsum_ne :
        (∑ p ∈ P.support,
          (MvPolynomial.monomial s (1 : k) * MvPolynomial.monomial p (P.coeff p)).coeff m) ≠ 0 := by
      rw [← MvPolynomial.coeff_sum, ← Finset.mul_sum, ← MvPolynomial.as_sum P]
      exact hne
    obtain ⟨p, hp, hp_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hsum_ne
    rw [MvPolynomial.monomial_mul_monomial, one_mul, MvPolynomial.coeff_monomial] at hp_ne
    by_cases hsp : s + p = m
    · exact ⟨p, hp, hsp⟩
    · simp only [hsp, ↓reduceIte] at hp_ne
      exact False.elim (hp_ne rfl)

  have hCech_H1 : ∀ (d : ℕ) (u₀₁ u₁₂ u₀₂ : K₂),
      1 ≤ d →
      u₀₁ ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 1).range →
      u₀₂ ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 2).range →
      x₁ ^ d * u₁₂ ∈ (φ_K₂ 1).range ⊔ (φ_K₂ 2).range →
      u₀₁ + u₁₂ = u₀₂ →
      ∃ v₀ v₁ : K₂,
        v₀ ∈ (φ_K₂ 0).range ∧ x₁ ^ d * v₁ ∈ (φ_K₂ 1).range ∧ v₁ - v₀ = u₀₁ := by
    intro d u₀₁ u₁₂ u₀₂ _hd hu₀₁ hu₀₂ hu₁₂ hcoc
    obtain ⟨L₁, P₀₁, hP₀₁_raw⟩ := hOv_clear 0 1 u₀₁ hu₀₁
    have hP₀₁ : φ_K₂ 0 P₀₁ = x₁ ^ L₁ * u₀₁ := by
      have hr01 : homCoord 1 / homCoord 0 = x₁ := by dsimp [homCoord]; exact div_one x₁
      exact (show φ_K₂ 0 P₀₁ = _ from hP₀₁_raw).trans (by rw [hr01])
    obtain ⟨L₂', P₀₂, hP₀₂_raw⟩ := hOv_clear 0 2 u₀₂ hu₀₂
    have hP₀₂ : φ_K₂ 0 P₀₂ = x₂ ^ L₂' * u₀₂ := by
      have hr02 : homCoord 2 / homCoord 0 = x₂ := by dsimp [homCoord]; exact div_one x₂
      exact (show φ_K₂ 0 P₀₂ = _ from hP₀₂_raw).trans (by rw [hr02])
    obtain ⟨L₃, Q₁₂, hQ₁₂_raw⟩ := hOv_clear 1 2 (x₁ ^ d * u₁₂) hu₁₂
    have hQ₁₂ : φ_K₂ 1 Q₁₂ = (x₂ / x₁) ^ L₃ * (x₁ ^ d * u₁₂) := hQ₁₂_raw
    let D₃ := Q₁₂.totalDegree
    let Q₁₂_mir := mirror1 D₃ Q₁₂
    have hQ₁₂_deg : Q₁₂_mir.totalDegree ≤ D₃ := h_mir_deg D₃ Q₁₂ (le_refl D₃)
    have hQ₁₂_mir : φ_K₂ 0 Q₁₂_mir = x₁ ^ D₃ * ((x₂ / x₁) ^ L₃ * (x₁ ^ d * u₁₂)) := by
      rw [← h_mir_1to0 D₃ Q₁₂ (le_refl D₃), hQ₁₂]

    let L := L₁ + L₂' + L₃ + D₃ + d
    let s₀₁ := mk2 (L - L₁) L
    let s₀₂ := mk2 L (L - L₂')
    let s₁₂ := mk2 (L + L₃ - D₃ - d) (L - L₃)
    let F₀₁ : A := MvPolynomial.monomial s₀₁ 1 * P₀₁
    let F₀₂ : A := MvPolynomial.monomial s₀₂ 1 * P₀₂
    let F₁₂ : A := MvPolynomial.monomial s₁₂ 1 * Q₁₂_mir

    have hF₀₁_eval : φ_K₂ 0 F₀₁ = x₁ ^ L * x₂ ^ L * u₀₁ := by
      have he : (L - L₁) + L₁ = L := by omega
      dsimp [F₀₁, s₀₁]
      rw [map_mul, hφ0_mon, hmk2_0, hmk2_1, map_one, one_mul, hP₀₁]
      calc (x₁ ^ (L - L₁) * x₂ ^ L) * (x₁ ^ L₁ * u₀₁)
          = (x₁ ^ (L - L₁) * x₁ ^ L₁) * x₂ ^ L * u₀₁ := by ring
        _ = x₁ ^ L * x₂ ^ L * u₀₁ := by rw [← pow_add, he]

    have hF₀₂_eval : φ_K₂ 0 F₀₂ = x₁ ^ L * x₂ ^ L * u₀₂ := by
      have he : (L - L₂') + L₂' = L := by omega
      dsimp [F₀₂, s₀₂]
      rw [map_mul, hφ0_mon, hmk2_0, hmk2_1, map_one, one_mul, hP₀₂]
      calc (x₁ ^ L * x₂ ^ (L - L₂')) * (x₂ ^ L₂' * u₀₂)
          = x₁ ^ L * (x₂ ^ (L - L₂') * x₂ ^ L₂') * u₀₂ := by ring
        _ = x₁ ^ L * x₂ ^ L * u₀₂ := by rw [← pow_add, he]

    have hF₁₂_eval : φ_K₂ 0 F₁₂ = x₁ ^ L * x₂ ^ L * u₁₂ := by
      have he1 : (L + L₃ - D₃ - d) + D₃ + d = L + L₃ := by omega
      have he2 : (L - L₃) + L₃ = L := by omega
      dsimp [F₁₂, s₁₂]
      rw [map_mul, hφ0_mon, hmk2_0, hmk2_1, map_one, one_mul, hQ₁₂_mir]
      calc (x₁ ^ (L + L₃ - D₃ - d) * x₂ ^ (L - L₃)) *
            (x₁ ^ D₃ * ((x₂ / x₁) ^ L₃ * (x₁ ^ d * u₁₂)))
          = ((x₁ ^ (L + L₃ - D₃ - d) * x₁ ^ D₃) * x₁ ^ d) * (x₁⁻¹) ^ L₃ *
              (x₂ ^ (L - L₃) * x₂ ^ L₃) * u₁₂ := by
              rw [div_eq_mul_inv, mul_pow]
              ring
        _ = x₁ ^ L * (x₁ ^ L₃ * (x₁⁻¹) ^ L₃) * x₂ ^ L * u₁₂ := by
              rw [← pow_add, ← pow_add, he1, pow_add x₁ L L₃, ← pow_add x₂, he2]
              ring
        _ = x₁ ^ L * x₂ ^ L * u₁₂ := by rw [hx₁_pow_inv, mul_one]

    have hF_coc : F₀₁ + F₁₂ = F₀₂ := by
      apply hφ0_inj
      rw [map_add, hF₀₁_eval, hF₁₂_eval, hF₀₂_eval, ← mul_add, hcoc]

    have hF₀₁_m1 : ∀ {m : Fin 2 →₀ ℕ}, m ∈ F₀₁.support → L ≤ m 1 := by
      intro m hm
      obtain ⟨p, -, hsp⟩ := h_mon_mul_supp s₀₁ m P₀₁ (MvPolynomial.mem_support_iff.mp hm)
      have h1 : (s₀₁ + p) 1 = m 1 := congrArg (· 1) hsp
      simp only [Finsupp.add_apply, s₀₁, hmk2_1] at h1
      omega

    have hF₀₂_m0 : ∀ {m : Fin 2 →₀ ℕ}, ¬ L ≤ m 0 → F₀₂.coeff m = 0 := by
      intro m hlt
      by_contra hne
      obtain ⟨p, -, hsp⟩ := h_mon_mul_supp s₀₂ m P₀₂ hne
      have h0 : (s₀₂ + p) 0 = m 0 := congrArg (· 0) hsp
      simp only [Finsupp.add_apply, s₀₂, hmk2_0] at h0
      omega

    have hF₁₂_tot : ∀ {m : Fin 2 →₀ ℕ}, F₁₂.coeff m ≠ 0 → m 0 + m 1 + d ≤ 2 * L := by
      intro m hne
      obtain ⟨p, hp, hsp⟩ := h_mon_mul_supp s₁₂ m Q₁₂_mir hne
      have hp_deg : p 0 + p 1 ≤ D₃ := (h_supp_le_tot Q₁₂_mir hp).trans hQ₁₂_deg
      have h0 : (s₁₂ + p) 0 = m 0 := congrArg (· 0) hsp
      have h1 : (s₁₂ + p) 1 = m 1 := congrArg (· 1) hsp
      simp only [Finsupp.add_apply, s₁₂, hmk2_0, hmk2_1] at h0 h1
      omega

    let S_ge := F₀₁.support.filter (fun m => L ≤ m 0)
    let S_lt := F₀₁.support.filter (fun m => ¬ L ≤ m 0)
    let P_v₀ : A := - ∑ m ∈ S_ge, MvPolynomial.monomial (mk2 (m 0 - L) (m 1 - L)) (F₀₁.coeff m)
    let P_v₁ : A := ∑ m ∈ S_lt,
      MvPolynomial.monomial (mk2 (2 * L - m 0 - m 1 - d) (m 1 - L)) (F₀₁.coeff m)
    let v₀ : K₂ := φ_K₂ 0 P_v₀
    let v₁ : K₂ := (x₁⁻¹) ^ d * φ_K₂ 1 P_v₁
    refine ⟨v₀, v₁, ⟨P_v₀, rfl⟩, ?_, ?_⟩
    · refine ⟨P_v₁, ?_⟩
      dsimp [v₁]
      rw [← mul_assoc, hx₁_pow_inv, one_mul]
    · have hL_ne : x₁ ^ L * x₂ ^ L ≠ 0 :=
        mul_ne_zero (pow_ne_zero _ hx₁_ne) (pow_ne_zero _ hx₂_ne)
      apply mul_left_cancel₀ hL_ne
      have h_sum_ge : x₁ ^ L * x₂ ^ L * (-v₀) =
          ∑ m ∈ S_ge, φ_K₂ 0 (MvPolynomial.monomial m (F₀₁.coeff m)) := by
        dsimp [v₀, P_v₀]
        rw [map_neg, neg_neg, map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun m hm => ?_
        rw [Finset.mem_filter] at hm
        have hm0 : L ≤ m 0 := hm.2
        have hm1 : L ≤ m 1 := hF₀₁_m1 hm.1
        have he0 : L + (m 0 - L) = m 0 := by omega
        have he1 : L + (m 1 - L) = m 1 := by omega
        rw [hφ0_mon, hφ0_mon, hmk2_0, hmk2_1]
        calc x₁ ^ L * x₂ ^ L * (algebraMap k K₂ (F₀₁.coeff m) * (x₁ ^ (m 0 - L) * x₂ ^ (m 1 - L)))
            = algebraMap k K₂ (F₀₁.coeff m) *
                ((x₁ ^ L * x₁ ^ (m 0 - L)) * (x₂ ^ L * x₂ ^ (m 1 - L))) := by ring
          _ = algebraMap k K₂ (F₀₁.coeff m) * (x₁ ^ m 0 * x₂ ^ m 1) := by
                rw [← pow_add, ← pow_add, he0, he1]
      have h_sum_lt : x₁ ^ L * x₂ ^ L * v₁ =
          ∑ m ∈ S_lt, φ_K₂ 0 (MvPolynomial.monomial m (F₀₁.coeff m)) := by
        dsimp [v₁, P_v₁]
        rw [map_sum, Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun m hm => ?_
        rw [Finset.mem_filter] at hm
        have hm_supp : m ∈ F₀₁.support := hm.1
        have hm0_lt : ¬ L ≤ m 0 := hm.2
        have hm1 : L ≤ m 1 := hF₀₁_m1 hm_supp
        have hF₁₂_ne : F₁₂.coeff m ≠ 0 := by
          intro h0
          have hadd : (F₀₁ + F₁₂).coeff m = F₀₂.coeff m := congrArg (fun P => P.coeff m) hF_coc
          rw [hcoeff_add, h0, add_zero, hF₀₂_m0 hm0_lt] at hadd
          exact (MvPolynomial.mem_support_iff.mp hm_supp) hadd
        have htot_le : m 0 + m 1 + d ≤ 2 * L := hF₁₂_tot hF₁₂_ne
        set k₁ := 2 * L - m 0 - m 1 - d
        set k₂ := m 1 - L
        have he_x1 : L = m 0 + d + k₁ + k₂ := by omega
        have he_x2 : L + k₂ = m 1 := by omega
        have hx1_L : x₁ ^ L = x₁ ^ m 0 * x₁ ^ d * x₁ ^ k₁ * x₁ ^ k₂ := by
          rw [he_x1, pow_add, pow_add, pow_add]
        rw [hφ1_mon, hφ0_mon, hmk2_0, hmk2_1]
        calc x₁ ^ L * x₂ ^ L *
              ((x₁⁻¹) ^ d * (algebraMap k K₂ (F₀₁.coeff m) * ((x₁⁻¹) ^ k₁ * (x₂ / x₁) ^ k₂)))
            = algebraMap k K₂ (F₀₁.coeff m) * (x₁ ^ m 0 * (x₂ ^ L * x₂ ^ k₂)) *
                (x₁ ^ d * (x₁⁻¹) ^ d) * (x₁ ^ k₁ * (x₁⁻¹) ^ k₁) * (x₁ ^ k₂ * (x₁⁻¹) ^ k₂) := by
                rw [hx1_L, div_eq_mul_inv, mul_pow]
                ring
          _ = algebraMap k K₂ (F₀₁.coeff m) * (x₁ ^ m 0 * x₂ ^ m 1) := by
                rw [hx₁_pow_inv, hx₁_pow_inv, hx₁_pow_inv, mul_one, mul_one, mul_one,
                  ← pow_add, he_x2]
      calc x₁ ^ L * x₂ ^ L * (v₁ - v₀)
          = x₁ ^ L * x₂ ^ L * (-v₀) + x₁ ^ L * x₂ ^ L * v₁ := by ring
        _ = (∑ m ∈ S_ge, φ_K₂ 0 (MvPolynomial.monomial m (F₀₁.coeff m))) +
            (∑ m ∈ S_lt, φ_K₂ 0 (MvPolynomial.monomial m (F₀₁.coeff m))) := by
              rw [h_sum_ge, h_sum_lt]
        _ = ∑ m ∈ F₀₁.support, φ_K₂ 0 (MvPolynomial.monomial m (F₀₁.coeff m)) :=
              Finset.sum_filter_add_sum_filter_not F₀₁.support (fun m => L ≤ m 0) _
        _ = φ_K₂ 0 F₀₁ := by
              rw [← map_sum, ← MvPolynomial.as_sum F₀₁]
        _ = x₁ ^ L * x₂ ^ L * u₀₁ := hF₀₁_eval

  exact ⟨⟨hCoord_ne, hφ0_inj, hφ1_inj, hφ0_apply, hPole_shift⟩,
    hFrac1, hHom_scale, fun c c' => ⟨hRatio_mem c c', hOv_clear c c'⟩,
    ⟨hNeg_vanish, hConst_inter⟩, hCech_H1⟩

theorem weil_esz_trace_dual_reflexive_and_global_presentation (k : Type u) [Field k] :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂],
      (∀ c : Fin 3, homCoord c ≠ 0) →
      Function.Injective (φ_K₂ 0) →
      Function.Injective (φ_K₂ 1) →
      (∀ P : MvPolynomial (Fin 2) k,
        φ_K₂ 0 P = algebraMap (MvPolynomial (Fin 2) k) K₂ P) →
      (∀ (b : ℕ) (P : MvPolynomial (Fin 2) k),
        P.totalDegree ≤ b → (x₁⁻¹) ^ b * φ_K₂ 0 P ∈ (φ_K₂ 1).range) →
      (∀ c c' : Fin 3,
        homCoord c' / homCoord c ∈ (φ_K₂ c).range ∧
        ∀ u ∈ (φ_K₂ c).range ⊔ (φ_K₂ c').range,
          ∃ N : ℕ, (homCoord c' / homCoord c) ^ N * u ∈ (φ_K₂ c).range) →
      (∀ (c : Fin 3) (𝔪 : Ideal (MvPolynomial (Fin 2) k)),
        𝔪.IsMaximal →
        letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
          ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
        ∃ (s : MvPolynomial (Fin 2) k) (b : Fin (Module.finrank K₂ L₂) → ↥B₂_c),
          s ∉ 𝔪 ∧
          LinearIndependent K₂ (fun i => (b i : L₂)) ∧
          ∀ z : ↥B₂_c, ∃ a : Fin (Module.finrank K₂ L₂) → MvPolynomial (Fin 2) k,
            algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c s * z =
              ∑ i, algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c (a i) * b i) →
      ∃ (r₀ r₁ a_pole b_pole : ℕ)
        (Φ₀ : L₂ →ₗ[K₂] (Fin r₀ → K₂))
        (Ψ₀ : (Fin r₀ → K₂) →ₗ[K₂] (Fin r₁ → K₂)),
        Function.Injective Φ₀ ∧
        (∀ u : Fin r₀ → K₂, Ψ₀ u = 0 ↔ u ∈ LinearMap.range Φ₀) ∧
        (∀ (c' : Fin 3) (δ : L₂),
          (let R_ov : Subalgebra k K₂ := (φ_K₂ 0).range ⊔ (φ_K₂ c').range
           letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
           IsIntegral ↥R_ov δ) →
          ∀ α : Fin r₀, Φ₀ δ α ∈ (φ_K₂ 0).range ⊔ (φ_K₂ c').range) ∧
        (∀ (d : ℕ) (δ : L₂),
          (let R_ov : Subalgebra k K₂ := (φ_K₂ 1).range ⊔ (φ_K₂ 2).range
           letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
           IsIntegral ↥R_ov ((algebraMap K₂ L₂ x₁) ^ (d + a_pole) * δ)) →
          ∀ α : Fin r₀, x₁ ^ d * Φ₀ δ α ∈ (φ_K₂ 1).range ⊔ (φ_K₂ 2).range) ∧
        (∀ z : L₂,
          (∀ α : Fin r₀, Φ₀ z α ∈ (φ_K₂ 0).range) →
          letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
            ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
          z ∈ integralClosure (MvPolynomial (Fin 2) k) L₂) ∧
        (∀ (d : ℕ) (z : L₂),
          (∀ α : Fin r₀, x₁ ^ d * Φ₀ z α ∈ (φ_K₂ 1).range) →
          letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
            ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
          (algebraMap K₂ L₂ x₁) ^ (d + a_pole) * z ∈
            integralClosure (MvPolynomial (Fin 2) k) L₂) ∧
        (∀ v₀ : Fin r₀ → K₂,
          (∀ α : Fin r₀, v₀ α ∈ (φ_K₂ 0).range) →
          ∀ β : Fin r₁, Ψ₀ v₀ β ∈ (φ_K₂ 0).range) ∧
        (∀ (k_tw : ℕ) (v₁ : Fin r₀ → K₂),
          (∀ α : Fin r₀, x₁ ^ (k_tw + b_pole) * v₁ α ∈ (φ_K₂ 1).range) →
          ∀ β : Fin r₁, x₁ ^ k_tw * Ψ₀ v₁ β ∈ (φ_K₂ 1).range) :=
by
  
  suffices h_gen :
      ∀ (K₂ : Type u) [Field K₂] [Algebra k K₂]
        [Algebra (MvPolynomial (Fin 2) k) K₂]
        [IsFractionRing (MvPolynomial (Fin 2) k) K₂],
        let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
        let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
        let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
        let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
          fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
        ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂],
          (∀ c : Fin 3, homCoord c ≠ 0) →
          Function.Injective (φ_K₂ 0) →
          Function.Injective (φ_K₂ 1) →
          (∀ P : MvPolynomial (Fin 2) k,
            φ_K₂ 0 P = algebraMap (MvPolynomial (Fin 2) k) K₂ P) →
          (∀ (b : ℕ) (P : MvPolynomial (Fin 2) k),
            P.totalDegree ≤ b → (x₁⁻¹) ^ b * φ_K₂ 0 P ∈ (φ_K₂ 1).range) →
          (∀ c c' : Fin 3,
            homCoord c' / homCoord c ∈ (φ_K₂ c).range ∧
            ∀ u ∈ (φ_K₂ c).range ⊔ (φ_K₂ c').range,
              ∃ N : ℕ, (homCoord c' / homCoord c) ^ N * u ∈ (φ_K₂ c).range) →
          (∀ (c : Fin 3) (𝔪 : Ideal (MvPolynomial (Fin 2) k)),
            𝔪.IsMaximal →
            letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
              ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
            let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
            ∃ (s : MvPolynomial (Fin 2) k) (b : Fin (Module.finrank K₂ L₂) → ↥B₂_c),
              s ∉ 𝔪 ∧
              LinearIndependent K₂ (fun i => (b i : L₂)) ∧
              ∀ z : ↥B₂_c, ∃ a : Fin (Module.finrank K₂ L₂) → MvPolynomial (Fin 2) k,
                algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c s * z =
                  ∑ i, algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c (a i) * b i) →
          ∃ (r₀ r₁ a_pole b_pole : ℕ)
            (Φ₀ : L₂ →ₗ[K₂] (Fin r₀ → K₂))
            (Ψ₀ : (Fin r₀ → K₂) →ₗ[K₂] (Fin r₁ → K₂)),
            Function.Injective Φ₀ ∧
            (∀ u : Fin r₀ → K₂, Ψ₀ u = 0 ↔ u ∈ LinearMap.range Φ₀) ∧
            (∀ (c' : Fin 3) (δ : L₂),
              (let R_ov : Subalgebra k K₂ := (φ_K₂ 0).range ⊔ (φ_K₂ c').range
               letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
               IsIntegral ↥R_ov δ) →
              ∀ α : Fin r₀, Φ₀ δ α ∈ (φ_K₂ 0).range ⊔ (φ_K₂ c').range) ∧
            (∀ (d : ℕ) (δ : L₂),
              (let R_ov : Subalgebra k K₂ := (φ_K₂ 1).range ⊔ (φ_K₂ 2).range
               letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
               IsIntegral ↥R_ov ((algebraMap K₂ L₂ x₁) ^ (d + a_pole) * δ)) →
              ∀ α : Fin r₀, x₁ ^ d * Φ₀ δ α ∈ (φ_K₂ 1).range ⊔ (φ_K₂ 2).range) ∧
            (∀ z : L₂,
              (∀ α : Fin r₀, Φ₀ z α ∈ (φ_K₂ 0).range) →
              letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
                ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
              z ∈ integralClosure (MvPolynomial (Fin 2) k) L₂) ∧
            (∀ (d : ℕ) (z : L₂),
              (∀ α : Fin r₀, x₁ ^ d * Φ₀ z α ∈ (φ_K₂ 1).range) →
              letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
                ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
              (algebraMap K₂ L₂ x₁) ^ (d + a_pole) * z ∈
                integralClosure (MvPolynomial (Fin 2) k) L₂) ∧
            (∀ v₀ : Fin r₀ → K₂,
              (∀ α : Fin r₀, v₀ α ∈ (φ_K₂ 0).range) →
              ∀ β : Fin r₁, Ψ₀ v₀ β ∈ (φ_K₂ 0).range) ∧
            (∀ (k_tw : ℕ) (v₁ : Fin r₀ → K₂),
              (∀ α : Fin r₀, x₁ ^ (k_tw + b_pole) * v₁ α ∈ (φ_K₂ 1).range) →
              ∀ β : Fin r₁, x₁ ^ k_tw * Ψ₀ v₁ β ∈ (φ_K₂ 1).range)
    from h_gen (FractionRing (MvPolynomial (Fin 2) k))

  
  have h_s2 :
      ∀ (A K₂ L₂ : Type u) [CommRing A] [IsNoetherianRing A] [Algebra k A]
        [Field K₂] [Algebra k K₂] [Field L₂] [Algebra K₂ L₂]
        [FiniteDimensional K₂ L₂] [Algebra.IsSeparable K₂ L₂]
        (φ : A →ₐ[k] K₂),
        Function.Injective φ →
        (∀ (𝔪 : Ideal A), 𝔪.IsMaximal →
          letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
          let B := integralClosure A L₂
          ∃ (s : A) (b : Fin (Module.finrank K₂ L₂) → ↥B),
            s ∉ 𝔪 ∧
            LinearIndependent K₂ (fun i => (b i : L₂)) ∧
            ∀ z : ↥B, ∃ a : Fin (Module.finrank K₂ L₂) → A,
              algebraMap A ↥B s * z = ∑ i, algebraMap A ↥B (a i) * b i) →
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
        let B := integralClosure A L₂
        ∃ (S_B S_D : Finset L₂),
          ((∀ z ∈ S_B, z ∈ B) ∧ (∀ z : L₂, z ∈ B → z ∈ Submodule.span A (S_B : Set L₂))) ∧
          (∀ y ∈ S_D, ∀ z : L₂, z ∈ B → Algebra.trace K₂ L₂ (y * z) ∈ φ.range) ∧
          (∀ z : L₂, (∀ y ∈ S_D, Algebra.trace K₂ L₂ (y * z) ∈ φ.range) → z ∈ B) ∧
          (∀ z : L₂, (∀ y ∈ S_D, Algebra.trace K₂ L₂ (y * z) = 0) → z = 0) := by
    intro A K₂ L₂ _ _ _ _ _ _ _ _ _ φ hφ_inj hLocFree
    letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
    let B := integralClosure A L₂
    set n := Module.finrank K₂ L₂
    have _ : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp Module.finrank_pos
    have _ : Nontrivial A :=
      ⟨⟨0, 1, fun h01 => (zero_ne_one : (0 : K₂) ≠ 1) (by rw [← map_zero φ, h01, map_one])⟩⟩
    have h_smul_eq : ∀ (r : A) (x : L₂), r • x = (φ r) • x := by
      intro r x
      rw [Algebra.smul_def, Algebra.smul_def]
      rfl
    have hB_val_mul : ∀ (r : A) (z : ↥B),
        ((algebraMap A ↥B r * z : ↥B) : L₂) = (φ r) • (z : L₂) := by
      intro r z
      change B.val (algebraMap A ↥B r * z) = (φ r) • (z : L₂)
      rw [map_mul, AlgHom.commutes, ← h_smul_eq, Algebra.smul_def]
      rfl
    have hB_val_sum : ∀ (g : Fin n → ↥B),
        ((∑ j : Fin n, g j : ↥B) : L₂) = ∑ j : Fin n, (g j : L₂) :=
      fun g => map_sum B.val g Finset.univ
    have h_repr_dual : ∀ (B_bas : Module.Basis (Fin n) K₂ L₂) (x : L₂) (i : Fin n),
        B_bas.repr x i = Algebra.trace K₂ L₂ (x * B_bas.traceDual i) := by
      intro B_bas x i
      conv_lhs => rw [← B_bas.traceDual_traceDual]
      rw [Module.Basis.traceDual_repr_apply, Algebra.traceForm_apply]
    let D : Submodule A L₂ :=
      { carrier := { y : L₂ | ∀ z : ↥B, Algebra.trace K₂ L₂ (y * (z : L₂)) ∈ φ.range }
        zero_mem' := by
          intro z
          rw [zero_mul, map_zero]
          exact φ.range.zero_mem
        add_mem' := by
          intro y₁ y₂ hy₁ hy₂ z
          rw [add_mul, map_add]
          exact φ.range.add_mem (hy₁ z) (hy₂ z)
        smul_mem' := by
          intro r y hy z
          rw [h_smul_eq, smul_mul_assoc, LinearMap.map_smul, smul_eq_mul]
          exact φ.range.mul_mem (φ.mem_range_self r) (hy z) }
    have h_local_dual : ∀ (s : A) (b : Fin n → ↥B)
        (hb_li : LinearIndependent K₂ (fun i => (b i : L₂))),
        (∀ z : ↥B, ∃ a : Fin n → A,
          algebraMap A ↥B s * z = ∑ j, algebraMap A ↥B (a j) * b j) →
        let B_bas := basisOfLinearIndependentOfCardEqFinrank hb_li (Fintype.card_fin n)
        (∀ (z : ↥B) (i : Fin n), B_bas.repr ((φ s) • (z : L₂)) i ∈ φ.range) ∧
        (∀ i : Fin n, s • B_bas.traceDual i ∈ D) := by
      intro s b hb_li hb_span B_bas
      have hB_bas_apply : ∀ j : Fin n, B_bas j = (b j : L₂) := fun j =>
        congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hb_li (Fintype.card_fin n)) j
      have h_repr_mem : ∀ (z : ↥B) (i : Fin n), B_bas.repr ((φ s) • (z : L₂)) i ∈ φ.range := by
        intro z i
        obtain ⟨a, ha⟩ := hb_span z
        have ha_L₂ : (φ s) • (z : L₂) = ∑ j : Fin n, (φ (a j)) • B_bas j := by
          have h1 : ((algebraMap A ↥B s * z : ↥B) : L₂) =
              ((∑ j : Fin n, algebraMap A ↥B (a j) * b j : ↥B) : L₂) :=
            congrArg Subtype.val ha
          rw [hB_val_mul, hB_val_sum] at h1
          refine h1.trans (Finset.sum_congr rfl fun j _ => ?_)
          rw [hB_val_mul, hB_bas_apply]
        refine ⟨a i, ?_⟩
        rw [ha_L₂, map_sum, Finsupp.finsetSum_apply]
        simp [Module.Basis.repr_self, Finsupp.single_apply]
      refine ⟨h_repr_mem, fun i z => ?_⟩
      have h_eq : (s • B_bas.traceDual i) * (z : L₂) = ((φ s) • (z : L₂)) * B_bas.traceDual i := by
        rw [h_smul_eq, Algebra.smul_def, Algebra.smul_def]
        ring
      rw [h_eq, ← h_repr_dual]
      exact h_repr_mem z i

    obtain ⟨𝔪₀, h𝔪₀⟩ := Ideal.exists_maximal A
    obtain ⟨s₀, b₀, hs₀_not_mem, hb₀_li, hb₀_span⟩ := hLocFree 𝔪₀ h𝔪₀
    have hs₀_ne : s₀ ≠ 0 := fun h0 => hs₀_not_mem (h0 ▸ 𝔪₀.zero_mem)
    have hφs₀_ne : φ s₀ ≠ 0 := fun h0 => hs₀_ne (hφ_inj (h0.trans (map_zero φ).symm))
    let B₀ : Module.Basis (Fin n) K₂ L₂ :=
      basisOfLinearIndependentOfCardEqFinrank hb₀_li (Fintype.card_fin n)
    have hB₀_apply : ∀ j : Fin n, B₀ j = (b₀ j : L₂) := fun j =>
      congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hb₀_li (Fintype.card_fin n)) j
    obtain ⟨hB₀_repr_mem, hB₀_dual_mem⟩ := h_local_dual s₀ b₀ hb₀_li hb₀_span
    let e_φ : A ≃ₐ[k] ↥φ.range := AlgEquiv.ofInjective φ hφ_inj
    have he_φ_symm : ∀ (x : ↥φ.range), φ (e_φ.symm x) = (x : K₂) := by
      intro x
      have h := AlgEquiv.ofInjective_apply φ hφ_inj (e_φ.symm x)
      change ↑(e_φ (e_φ.symm x)) = φ (e_φ.symm x) at h
      rw [e_φ.apply_symm_apply] at h
      exact h.symm

    let f_B : ↥B.toSubmodule →ₗ[A] (Fin n → A) :=
      { toFun := fun z j =>
          e_φ.symm ⟨B₀.repr ((φ s₀) • (z : L₂)) j, hB₀_repr_mem ⟨z.1, z.2⟩ j⟩
        map_add' := by
          intro z₁ z₂
          ext j
          apply hφ_inj
          simp only [Pi.add_apply, map_add, he_φ_symm]
          change B₀.repr ((φ s₀) • ((z₁ : L₂) + (z₂ : L₂))) j = _
          rw [smul_add, map_add, Finsupp.add_apply]
        map_smul' := by
          intro r z
          ext j
          apply hφ_inj
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, map_mul, he_φ_symm]
          change B₀.repr ((φ s₀) • (r • (z : L₂))) j = _
          rw [h_smul_eq, smul_comm (φ s₀) (φ r), LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul] }
    have hf_B_inj : Function.Injective f_B := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      have h_repr0 : B₀.repr ((φ s₀) • (z : L₂)) = 0 := by
        ext j
        have hj : f_B z j = 0 := congrFun hz j
        have hφj := congrArg φ hj
        rw [map_zero] at hφj
        exact (he_φ_symm _).symm.trans hφj
      have h_smul0 : (φ s₀) • (z : L₂) = 0 := B₀.repr.map_eq_zero_iff.mp h_repr0
      have hz0 : (z : L₂) = 0 := (smul_eq_zero.mp h_smul0).resolve_left hφs₀_ne
      exact Subtype.ext hz0

    let f_D : ↥D →ₗ[A] (Fin n → A) :=
      { toFun := fun y j =>
          e_φ.symm ⟨Algebra.trace K₂ L₂ ((y : L₂) * (b₀ j : L₂)), y.2 (b₀ j)⟩
        map_add' := by
          intro y₁ y₂
          ext j
          apply hφ_inj
          simp only [Pi.add_apply, map_add, he_φ_symm]
          change Algebra.trace K₂ L₂ (((y₁ : L₂) + (y₂ : L₂)) * (b₀ j : L₂)) = _
          rw [add_mul, map_add]
        map_smul' := by
          intro r y
          ext j
          apply hφ_inj
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, map_mul, he_φ_symm]
          change Algebra.trace K₂ L₂ ((r • (y : L₂)) * (b₀ j : L₂)) = _
          rw [h_smul_eq, smul_mul_assoc, LinearMap.map_smul, smul_eq_mul] }
    have hf_D_inj : Function.Injective f_D := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      have h_repr0 : B₀.traceDual.repr (y : L₂) = 0 := by
        ext j
        rw [Module.Basis.traceDual_repr_apply, Algebra.traceForm_apply, hB₀_apply]
        have hj : f_D y j = 0 := congrFun hy j
        have hφj := congrArg φ hj
        rw [map_zero] at hφj
        exact (he_φ_symm _).symm.trans hφj
      exact Subtype.ext (B₀.traceDual.repr.map_eq_zero_iff.mp h_repr0)

    have _ : IsNoetherian A (Fin n → A) := isNoetherian_pi'
    have _ : IsNoetherian A ↥B.toSubmodule := isNoetherian_of_injective f_B hf_B_inj
    have _ : IsNoetherian A ↥D := isNoetherian_of_injective f_D hf_D_inj
    have hB_fg : B.toSubmodule.FG :=
      Submodule.map_subtype_top B.toSubmodule ▸
        (IsNoetherian.noetherian (⊤ : Submodule A ↥B.toSubmodule)).map B.toSubmodule.subtype
    have hD_fg : D.FG :=
      Submodule.map_subtype_top D ▸
        (IsNoetherian.noetherian (⊤ : Submodule A ↥D)).map D.subtype
    rcases hB_fg with ⟨S_B, hS_B⟩
    rcases hD_fg with ⟨S_D, hS_D⟩

    refine ⟨S_B, S_D, ⟨?_, ?_⟩, ?_, ?_, ?_⟩
    · intro z hz
      have hz' : z ∈ Submodule.span A (S_B : Set L₂) := Submodule.subset_span hz
      rwa [hS_B] at hz'
    · intro z hz
      rw [hS_B]
      exact hz
    · intro y hy z hz
      have hy' : y ∈ Submodule.span A (S_D : Set L₂) := Submodule.subset_span hy
      rw [hS_D] at hy'
      exact hy' ⟨z, hz⟩
    · intro z hz_SD
      have hz_D : ∀ y ∈ D, Algebra.trace K₂ L₂ (y * z) ∈ φ.range := by
        intro y hy
        rw [← hS_D] at hy
        induction hy using Submodule.span_induction with
        | mem w hw => exact hz_SD w hw
        | zero =>
          rw [zero_mul, map_zero]
          exact φ.range.zero_mem
        | add w₁ w₂ _ _ ih₁ ih₂ =>
          rw [add_mul, map_add]
          exact φ.range.add_mem ih₁ ih₂
        | smul r w _ ih =>
          rw [h_smul_eq, smul_mul_assoc, LinearMap.map_smul, smul_eq_mul]
          exact φ.range.mul_mem (φ.mem_range_self r) ih
      let J_z : Ideal A :=
        { carrier := { t : A | t • z ∈ B }
          zero_mem' := by
            show (0 : A) • z ∈ B
            rw [zero_smul]
            exact B.zero_mem
          add_mem' := by
            intro t₁ t₂ ht₁ ht₂
            show (t₁ + t₂) • z ∈ B
            rw [add_smul]
            exact B.add_mem ht₁ ht₂
          smul_mem' := by
            intro r t ht
            show (r • t) • z ∈ B
            rw [smul_eq_mul, mul_smul]
            exact B.toSubmodule.smul_mem r ht }
      have hJ_top : J_z = ⊤ := by
        by_contra hJ_ne
        obtain ⟨𝔪, h𝔪_max, hJ_le⟩ := Ideal.exists_le_maximal J_z hJ_ne
        obtain ⟨s, b, hs_not_mem, hb_li, hb_span⟩ := hLocFree 𝔪 h𝔪_max
        let B_bas : Module.Basis (Fin n) K₂ L₂ :=
          basisOfLinearIndependentOfCardEqFinrank hb_li (Fintype.card_fin n)
        have hB_bas_apply : ∀ j : Fin n, B_bas j = (b j : L₂) := fun j =>
          congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hb_li (Fintype.card_fin n)) j
        obtain ⟨_, h_dual_D⟩ := h_local_dual s b hb_li hb_span
        have h_repr_sz : ∀ i : Fin n, B_bas.repr (s • z) i ∈ φ.range := by
          intro i
          rw [h_repr_dual]
          have h_comm : (s • z) * B_bas.traceDual i = (s • B_bas.traceDual i) * z := by
            rw [h_smul_eq, h_smul_eq, Algebra.smul_def, Algebra.smul_def]
            ring
          rw [h_comm]
          exact hz_D (s • B_bas.traceDual i) (h_dual_D i)
        choose c hc using h_repr_sz
        have hc' : ∀ i : Fin n, φ (c i) = B_bas.repr (s • z) i := hc
        have hsz_eq : s • z = ∑ i : Fin n, (c i) • (b i : L₂) := by
          conv_lhs => rw [← B_bas.sum_repr (s • z)]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← hc' i, hB_bas_apply i, ← h_smul_eq]
        have hsz_mem : s • z ∈ B := by
          rw [hsz_eq]
          exact B.toSubmodule.sum_mem fun i _ => B.toSubmodule.smul_mem (c i) (b i).2
        exact hs_not_mem (hJ_le hsz_mem)
      have h1_mem : (1 : A) ∈ J_z := by
        rw [hJ_top]
        trivial
      change (1 : A) • z ∈ B at h1_mem
      rwa [one_smul] at h1_mem
    · intro z hz_SD
      have hz_D : ∀ y ∈ D, Algebra.trace K₂ L₂ (y * z) = 0 := by
        intro y hy
        rw [← hS_D] at hy
        induction hy using Submodule.span_induction with
        | mem w hw => exact hz_SD w hw
        | zero => rw [zero_mul, map_zero]
        | add w₁ w₂ _ _ ih₁ ih₂ => rw [add_mul, map_add, ih₁, ih₂, add_zero]
        | smul r w _ ih => rw [h_smul_eq, smul_mul_assoc, LinearMap.map_smul, ih, smul_zero]
      have h_repr0 : B₀.repr z = 0 := by
        ext i
        have h0 := hz_D (s₀ • B₀.traceDual i) (hB₀_dual_mem i)
        have h_eq : (s₀ • B₀.traceDual i) * z = (φ s₀) • (z * B₀.traceDual i) := by
          rw [h_smul_eq, Algebra.smul_def, Algebra.smul_def]
          ring
        rw [h_eq, LinearMap.map_smul, smul_eq_mul, ← h_repr_dual] at h0
        exact (mul_eq_zero.mp h0).resolve_left hφs₀_ne
      exact B₀.repr.map_eq_zero_iff.mp h_repr0

  
  have h_s3 :
      ∀ (A K₂ L₂ : Type u) [CommRing A] [Algebra k A]
        [Field K₂] [Algebra k K₂] [Field L₂] [Algebra K₂ L₂]
        (φ φ' : A →ₐ[k] K₂) (t : K₂),
        t ≠ 0 →
        t ∈ φ.range →
        t⁻¹ ∈ φ'.range →
        (∀ u ∈ φ.range ⊔ φ'.range, ∃ N : ℕ, t ^ N * u ∈ φ.range) →
        (∀ w : L₂,
          (let R_ov : Subalgebra k K₂ := φ.range ⊔ φ'.range
           letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
           IsIntegral ↥R_ov w) →
          ∃ K : ℕ,
            letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
            (algebraMap K₂ L₂ t) ^ K * w ∈ integralClosure A L₂) ∧
        (∀ (y δ : L₂),
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
           ∀ z : L₂, z ∈ integralClosure A L₂ → Algebra.trace K₂ L₂ (y * z) ∈ φ.range) →
          (let R_ov : Subalgebra k K₂ := φ.range ⊔ φ'.range
           letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
           IsIntegral ↥R_ov δ) →
          Algebra.trace K₂ L₂ (δ * y) ∈ φ.range ⊔ φ'.range) ∧
        (∀ z : L₂,
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ'.toRingHom).toAlgebra
           z ∈ integralClosure A L₂) →
          (let R_ov : Subalgebra k K₂ := φ.range ⊔ φ'.range
           letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
           IsIntegral ↥R_ov z)) := by
    intro A K₂ L₂ _ _ _ _ _ _ φ φ' t ht_ne ht_mem ht_inv_mem h_clear
    have h_part1 : ∀ w : L₂,
        (let R_ov : Subalgebra k K₂ := φ.range ⊔ φ'.range
         letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
         IsIntegral ↥R_ov w) →
        ∃ K : ℕ,
          letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
          (algebraMap K₂ L₂ t) ^ K * w ∈ integralClosure A L₂ := by
      intro w hw
      let R_ov : Subalgebra k K₂ := φ.range ⊔ φ'.range
      letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
      rcases hw with ⟨p, hp_monic, hp_eval⟩
      set d := p.natDegree
      choose N hN using fun i : Fin d => h_clear (p.coeff i : K₂) (p.coeff i).2
      let K : ℕ := Finset.univ.sup N
      have h_coeff_mem : ∀ i : Fin d, (t ^ K) ^ (d - (i : ℕ)) * (p.coeff i : K₂) ∈ φ.range := by
        intro i
        have hNi : N i ≤ K := Finset.le_sup (Finset.mem_univ i)
        have hi_lt : (i : ℕ) < d := i.isLt
        have hsub1 : d - (i : ℕ) = (d - (i : ℕ) - 1) + 1 := by omega
        have hsubK : K = (K - N i) + N i := by omega
        have hexp : K * (d - (i : ℕ)) = (K * (d - (i : ℕ) - 1) + (K - N i)) + N i := by
          calc
            K * (d - (i : ℕ)) = K * ((d - (i : ℕ) - 1) + 1) := by conv_lhs => rw [hsub1]
            _ = K * (d - (i : ℕ) - 1) + K := by rw [mul_add, mul_one]
            _ = K * (d - (i : ℕ) - 1) + ((K - N i) + N i) := by conv_rhs => rw [← hsubK]
            _ = (K * (d - (i : ℕ) - 1) + (K - N i)) + N i := by rw [add_assoc]
        rw [← pow_mul, hexp, pow_add, mul_assoc]
        exact φ.range.mul_mem (φ.range.pow_mem ht_mem _) (hN i)
      choose q hq using h_coeff_mem
      have hq' : ∀ i : Fin d, φ (q i) = (t ^ K) ^ (d - (i : ℕ)) * (p.coeff i : K₂) := hq
      refine ⟨K, ?_⟩
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
      let Q : Polynomial A :=
        Polynomial.X ^ d + ∑ i : Fin d, Polynomial.C (q i) * Polynomial.X ^ (i : ℕ)
      have hQ_monic : Q.Monic := Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt q)
      set τ : L₂ := (algebraMap K₂ L₂ t) ^ K
      refine ⟨Q, hQ_monic, ?_⟩
      dsimp [Q]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
      have h_sum_eq :
          (∑ i : Fin d,
            Polynomial.eval₂ (algebraMap A L₂) (τ * w) (Polynomial.C (q i) * Polynomial.X ^ (i : ℕ))) =
          ∑ i ∈ Finset.range d, τ ^ d * (algebraMap ↥R_ov L₂ (p.coeff i) * w ^ i) := by
        have h_term : ∀ i : Fin d,
            Polynomial.eval₂ (algebraMap A L₂) (τ * w)
              (Polynomial.C (q i) * Polynomial.X ^ (i : ℕ)) =
            τ ^ d * (algebraMap ↥R_ov L₂ (p.coeff i) * w ^ (i : ℕ)) := by
          intro i
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
          have hqi : algebraMap A L₂ (q i) =
              τ ^ (d - (i : ℕ)) * algebraMap ↥R_ov L₂ (p.coeff i) := by
            change algebraMap K₂ L₂ (φ (q i)) =
              ((algebraMap K₂ L₂ t) ^ K) ^ (d - (i : ℕ)) * algebraMap K₂ L₂ (p.coeff i : K₂)
            rw [hq' i, map_mul, map_pow, map_pow]
          have h_add : d - (i : ℕ) + (i : ℕ) = d := Nat.sub_add_cancel (le_of_lt i.isLt)
          calc
            algebraMap A L₂ (q i) * (τ * w) ^ (i : ℕ)
              = (τ ^ (d - (i : ℕ)) * algebraMap ↥R_ov L₂ (p.coeff i)) * (τ ^ (i : ℕ) * w ^ (i : ℕ)) := by
                  rw [hqi, mul_pow]
            _ = (τ ^ (d - (i : ℕ)) * τ ^ (i : ℕ)) * (algebraMap ↥R_ov L₂ (p.coeff i) * w ^ (i : ℕ)) := by
                  ring
            _ = τ ^ d * (algebraMap ↥R_ov L₂ (p.coeff i) * w ^ (i : ℕ)) := by
                  rw [← pow_add, h_add]
        calc
          (∑ i : Fin d,
              Polynomial.eval₂ (algebraMap A L₂) (τ * w) (Polynomial.C (q i) * Polynomial.X ^ (i : ℕ)))
            = ∑ i : Fin d, τ ^ d * (algebraMap ↥R_ov L₂ (p.coeff (i : ℕ)) * w ^ (i : ℕ)) :=
                Finset.sum_congr rfl fun i _ => h_term i
          _ = ∑ i ∈ Finset.range d, τ ^ d * (algebraMap ↥R_ov L₂ (p.coeff i) * w ^ i) :=
                Fin.sum_univ_eq_sum_range
                  (fun m => τ ^ d * (algebraMap ↥R_ov L₂ (p.coeff m) * w ^ m)) d
      rw [h_sum_eq, ← Finset.mul_sum]
      have h_lead : (τ * w) ^ d = τ ^ d * (algebraMap ↥R_ov L₂ (p.coeff d) * w ^ d) := by
        rw [hp_monic.coeff_natDegree, map_one, one_mul, mul_pow]
      rw [h_lead, ← mul_add, add_comm, ← Finset.sum_range_succ,
        ← Polynomial.eval₂_eq_sum_range, hp_eval, mul_zero]

    refine ⟨h_part1, ?_, ?_⟩
    · intro y δ hy hδ
      let R_ov : Subalgebra k K₂ := φ.range ⊔ φ'.range
      obtain ⟨K, hz_K⟩ := h_part1 δ hδ
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ.toRingHom).toAlgebra
      have h_tr_mem : t ^ K * Algebra.trace K₂ L₂ (δ * y) ∈ R_ov := by
        have h_arg : y * ((algebraMap K₂ L₂ t) ^ K * δ) = (t ^ K) • (δ * y) := by
          rw [Algebra.smul_def, map_pow]
          ring
        have h_in_φ : Algebra.trace K₂ L₂ (y * ((algebraMap K₂ L₂ t) ^ K * δ)) ∈ φ.range :=
          hy _ hz_K
        rw [h_arg, LinearMap.map_smul, smul_eq_mul] at h_in_φ
        exact Algebra.mem_sup_left h_in_φ
      have ht_inv_Rov : (t⁻¹) ^ K ∈ R_ov :=
        R_ov.pow_mem (Algebra.mem_sup_right ht_inv_mem) K
      have h_prod := R_ov.mul_mem ht_inv_Rov h_tr_mem
      have h_cancel : (t⁻¹) ^ K * (t ^ K * Algebra.trace K₂ L₂ (δ * y)) =
          Algebra.trace K₂ L₂ (δ * y) := by
        rw [← mul_assoc, ← mul_pow, inv_mul_cancel₀ ht_ne, one_pow, one_mul]
      rwa [h_cancel] at h_prod
    · intro z hz
      let R_ov : Subalgebra k K₂ := φ.range ⊔ φ'.range
      letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp φ'.toRingHom).toAlgebra
      rcases hz with ⟨p, hp_monic, hp_eval⟩
      let ι_Rov : A →+* ↥R_ov :=
        (Subalgebra.inclusion le_sup_right).toRingHom.comp φ'.rangeRestrict.toRingHom
      have h_comp : (algebraMap ↥R_ov L₂).comp ι_Rov = algebraMap A L₂ := by
        ext r
        rfl
      refine ⟨p.map ι_Rov, hp_monic.map ι_Rov, ?_⟩
      rw [Polynomial.eval₂_map, h_comp, hp_eval]

  
  have h_s4 :
      ∀ (K₂ : Type u) [Field K₂] [Algebra k K₂]
        [Algebra (MvPolynomial (Fin 2) k) K₂]
        [IsFractionRing (MvPolynomial (Fin 2) k) K₂]
        (φ₀ φ₁ : MvPolynomial (Fin 2) k →ₐ[k] K₂) (x₁ : K₂),
        x₁ ≠ 0 →
        (∀ P : MvPolynomial (Fin 2) k, φ₀ P = algebraMap (MvPolynomial (Fin 2) k) K₂ P) →
        (∀ (b : ℕ) (P : MvPolynomial (Fin 2) k),
          P.totalDegree ≤ b → (x₁⁻¹) ^ b * φ₀ P ∈ φ₁.range) →
        ∀ (r₀ : ℕ) (W : Submodule K₂ (Fin r₀ → K₂)),
          ∃ (r₁ b_pole : ℕ) (Ψ₀ : (Fin r₀ → K₂) →ₗ[K₂] (Fin r₁ → K₂)),
            (∀ u : Fin r₀ → K₂, Ψ₀ u = 0 ↔ u ∈ W) ∧
            (∀ v₀ : Fin r₀ → K₂, (∀ α : Fin r₀, v₀ α ∈ φ₀.range) →
              ∀ β : Fin r₁, Ψ₀ v₀ β ∈ φ₀.range) ∧
            (∀ (k_tw : ℕ) (v₁ : Fin r₀ → K₂),
              (∀ α : Fin r₀, x₁ ^ (k_tw + b_pole) * v₁ α ∈ φ₁.range) →
              ∀ β : Fin r₁, x₁ ^ k_tw * Ψ₀ v₁ β ∈ φ₁.range) := by
    intro K₂ _ _ _ _ φ₀ φ₁ x₁ hx₁_ne hφ₀_eq hMirror_R1 r₀ W
    let A := MvPolynomial (Fin 2) k
    let Q_quot := (Fin r₀ → K₂) ⧸ W
    let r₁ := Module.finrank K₂ Q_quot
    let B_Q : Module.Basis (Fin r₁) K₂ Q_quot := Module.finBasis K₂ Q_quot
    let Ψ_raw : (Fin r₀ → K₂) →ₗ[K₂] (Fin r₁ → K₂) :=
      B_Q.equivFun.toLinearMap.comp (Submodule.mkQ W)
    have hΨ_raw_ker : ∀ u : Fin r₀ → K₂, Ψ_raw u = 0 ↔ u ∈ W := by
      intro u
      change B_Q.equivFun (Submodule.mkQ W u) = 0 ↔ u ∈ W
      rw [B_Q.equivFun.map_eq_zero_iff]
      exact Submodule.Quotient.mk_eq_zero W
    have h_surj : ∀ (β : Fin r₁) (α : Fin r₀),
        ∃ x : A × nonZeroDivisors A,
          Ψ_raw (Pi.single α 1) β * φ₀ (x.2 : A) = φ₀ x.1 := by
      intro β α
      obtain ⟨x, hx⟩ := IsLocalization.surj (nonZeroDivisors A) (Ψ_raw (Pi.single α 1) β)
      refine ⟨x, ?_⟩
      rwa [hφ₀_eq, hφ₀_eq]
    choose frac hfrac using h_surj
    let p_num : Fin r₁ → Fin r₀ → A := fun β α => (frac β α).1
    let s_den : Fin r₁ → Fin r₀ → A := fun β α => ((frac β α).2 : A)
    have hs_ne : ∀ (β : Fin r₁) (α : Fin r₀), φ₀ (s_den β α) ≠ 0 := by
      intro β α
      have hs_A : s_den β α ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp (frac β α).2.2
      rw [hφ₀_eq]
      exact fun h0 => hs_A (IsFractionRing.injective A K₂ (h0.trans (map_zero _).symm))
    let d_row : Fin r₁ → A := fun β => ∏ γ : Fin r₀, s_den β γ
    have hd_row_ne : ∀ β : Fin r₁, φ₀ (d_row β) ≠ 0 := by
      intro β
      dsimp [d_row]
      rw [map_prod]
      exact Finset.prod_ne_zero_iff.mpr fun γ _ => hs_ne β γ
    let P_mat : Fin r₁ → Fin r₀ → A := fun β α =>
      p_num β α * ∏ γ ∈ Finset.univ.erase α, s_den β γ
    have h_clear_entry : ∀ (β : Fin r₁) (α : Fin r₀),
        φ₀ (d_row β) * Ψ_raw (Pi.single α 1) β = φ₀ (P_mat β α) := by
      intro β α
      have hd_eq : d_row β = s_den β α * ∏ γ ∈ Finset.univ.erase α, s_den β γ :=
        (Finset.mul_prod_erase Finset.univ (fun γ => s_den β γ) (Finset.mem_univ α)).symm
      calc
        φ₀ (d_row β) * Ψ_raw (Pi.single α 1) β
          = (φ₀ (s_den β α) * φ₀ (∏ γ ∈ Finset.univ.erase α, s_den β γ)) *
              Ψ_raw (Pi.single α 1) β := by rw [hd_eq, map_mul]
        _ = (Ψ_raw (Pi.single α 1) β * φ₀ (s_den β α)) *
              φ₀ (∏ γ ∈ Finset.univ.erase α, s_den β γ) := by ring
        _ = φ₀ (p_num β α) * φ₀ (∏ γ ∈ Finset.univ.erase α, s_den β γ) := by rw [hfrac β α]
        _ = φ₀ (P_mat β α) := by rw [← map_mul]

    let Ψ₀ : (Fin r₀ → K₂) →ₗ[K₂] (Fin r₁ → K₂) :=
      { toFun := fun u β => φ₀ (d_row β) * Ψ_raw u β
        map_add' := by
          intro u₁ u₂
          ext β
          simp [mul_add]
        map_smul' := by
          intro c u
          ext β
          simp [mul_left_comm] }
    have hΨ₀_sum : ∀ (u : Fin r₀ → K₂) (β : Fin r₁),
        Ψ₀ u β = ∑ α : Fin r₀, φ₀ (P_mat β α) * u α := by
      intro u β
      change φ₀ (d_row β) * Ψ_raw u β = _
      conv_lhs => rw [pi_eq_sum_univ' u]
      rw [map_sum, Finset.sum_apply, Finset.mul_sum]
      refine Finset.sum_congr rfl fun α _ => ?_
      rw [LinearMap.map_smul, Pi.smul_apply, smul_eq_mul, ← mul_left_comm, h_clear_entry β α, mul_comm]

    let b_pole : ℕ :=
      Finset.univ.sup fun β : Fin r₁ => Finset.univ.sup fun α : Fin r₀ => (P_mat β α).totalDegree
    refine ⟨r₁, b_pole, Ψ₀, ?_, ?_, ?_⟩
    · intro u
      rw [← hΨ_raw_ker u]
      constructor
      · intro h0
        ext β
        have hβ : φ₀ (d_row β) * Ψ_raw u β = 0 := congrFun h0 β
        exact (mul_eq_zero.mp hβ).resolve_left (hd_row_ne β)
      · intro h0
        ext β
        change φ₀ (d_row β) * Ψ_raw u β = 0
        rw [h0, Pi.zero_apply, mul_zero]
    · intro v₀ hv₀ β
      rw [hΨ₀_sum]
      exact φ₀.range.sum_mem fun α _ => φ₀.range.mul_mem (φ₀.mem_range_self _) (hv₀ α)
    · intro k_tw v₁ hv₁ β
      rw [hΨ₀_sum, Finset.mul_sum]
      refine φ₁.range.sum_mem fun α _ => ?_
      have hdeg1 :
          (P_mat β α).totalDegree ≤
            Finset.univ.sup (fun α' : Fin r₀ => (P_mat β α').totalDegree) :=
        Finset.le_sup (f := fun α' : Fin r₀ => (P_mat β α').totalDegree) (Finset.mem_univ α)
      have hdeg2 :
          Finset.univ.sup (fun α' : Fin r₀ => (P_mat β α').totalDegree) ≤ b_pole :=
        Finset.le_sup
          (f := fun β' : Fin r₁ => Finset.univ.sup fun α' : Fin r₀ => (P_mat β' α').totalDegree)
          (Finset.mem_univ β)
      have hdeg : (P_mat β α).totalDegree ≤ b_pole := le_trans hdeg1 hdeg2
      have hP_R1 : (x₁⁻¹) ^ b_pole * φ₀ (P_mat β α) ∈ φ₁.range := hMirror_R1 b_pole (P_mat β α) hdeg
      have h_prod := φ₁.range.mul_mem hP_R1 (hv₁ α)
      have h_eq :
          ((x₁⁻¹) ^ b_pole * φ₀ (P_mat β α)) * (x₁ ^ (k_tw + b_pole) * v₁ α) =
          x₁ ^ k_tw * (φ₀ (P_mat β α) * v₁ α) := by
        have h_inv : (x₁⁻¹) ^ b_pole * x₁ ^ b_pole = 1 := by
          rw [← mul_pow, inv_mul_cancel₀ hx₁_ne, one_pow]
        calc
          ((x₁⁻¹) ^ b_pole * φ₀ (P_mat β α)) * (x₁ ^ (k_tw + b_pole) * v₁ α)
            = ((x₁⁻¹) ^ b_pole * x₁ ^ b_pole) * (x₁ ^ k_tw * (φ₀ (P_mat β α) * v₁ α)) := by
                rw [pow_add]
                ring
          _ = x₁ ^ k_tw * (φ₀ (P_mat β α) * v₁ α) := by rw [h_inv, one_mul]
      rwa [h_eq] at h_prod

  
  intro K₂ _ _ _ _ x₁ x₂ homCoord φ_K₂ L₂ _ _ _ _
    hCoord_ne hφ0_inj hφ1_inj hφ0_apply hMirror_R1 hOv_pkg hLocFree
  let A := MvPolynomial (Fin 2) k
  have _ : Algebra.IsSeparable K₂ L₂ := IsGalois.to_isSeparable
  have hx₁_ne : x₁ ≠ 0 := hCoord_ne 1
  have hx₁_R0 : x₁ ∈ (φ_K₂ 0).range := by
    have h01 := (hOv_pkg 0 1).1
    have hc0 : homCoord 0 = 1 := rfl
    have hc1 : homCoord 1 = x₁ := rfl
    rwa [hc0, hc1, div_one] at h01
  have hx₁inv_R1 : x₁⁻¹ ∈ (φ_K₂ 1).range := by
    have h10 := (hOv_pkg 1 0).1
    have hc0 : homCoord 0 = 1 := rfl
    have hc1 : homCoord 1 = x₁ := rfl
    rwa [hc0, hc1, one_div] at h10

  have h_ov_all : ∀ c c' : Fin 3,
      (∀ (y δ : L₂),
        (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
         ∀ z : L₂, z ∈ integralClosure A L₂ → Algebra.trace K₂ L₂ (y * z) ∈ (φ_K₂ c).range) →
        (let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
         letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
         IsIntegral ↥R_ov δ) →
        Algebra.trace K₂ L₂ (δ * y) ∈ (φ_K₂ c).range ⊔ (φ_K₂ c').range) ∧
      (∀ z : L₂,
        (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c').toRingHom).toAlgebra
         z ∈ integralClosure A L₂) →
        (let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
         letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
         IsIntegral ↥R_ov z)) := by
    intro c c'
    have ht_ne : homCoord c' / homCoord c ≠ 0 := div_ne_zero (hCoord_ne c') (hCoord_ne c)
    have ht_inv : (homCoord c' / homCoord c)⁻¹ ∈ (φ_K₂ c').range := by
      rw [inv_div]
      exact (hOv_pkg c' c).1
    have h3 := h_s3 A K₂ L₂ (φ_K₂ c) (φ_K₂ c') (homCoord c' / homCoord c)
      ht_ne (hOv_pkg c c').1 ht_inv (hOv_pkg c c').2
    exact ⟨h3.2.1, h3.2.2⟩

  obtain ⟨S_B0, S_D0, ⟨hSB0_mem, hSB0_span⟩, hSD0_tr, hSD0_refl, hSD0_nondeg⟩ :=
    h_s2 A K₂ L₂ (φ_K₂ 0) hφ0_inj (hLocFree 0)
  obtain ⟨S_B1, S_D1, ⟨hSB1_mem, hSB1_span⟩, hSD1_tr, hSD1_refl, _⟩ :=
    h_s2 A K₂ L₂ (φ_K₂ 1) hφ1_inj (hLocFree 1)

  
  have h_cross_01 : ∀ p : ↥S_D0 × ↥S_B1,
      ∃ N : ℕ, (x₁⁻¹) ^ N * Algebra.trace K₂ L₂ ((p.1 : L₂) * (p.2 : L₂)) ∈ (φ_K₂ 1).range := by
    intro p
    have hz_ov := (h_ov_all 0 1).2 (p.2 : L₂) (hSB1_mem p.2.1 p.2.2)
    have htr_ov := (h_ov_all 0 1).1 (p.1 : L₂) (p.2 : L₂) (hSD0_tr p.1.1 p.1.2) hz_ov
    rw [mul_comm (p.2 : L₂) (p.1 : L₂), sup_comm] at htr_ov
    obtain ⟨N, hN⟩ := (hOv_pkg 1 0).2 _ htr_ov
    have hratio : homCoord 0 / homCoord 1 = x₁⁻¹ := by
      change (1 : K₂) / x₁ = x₁⁻¹
      exact one_div x₁
    rw [hratio] at hN
    exact ⟨N, hN⟩
  choose N₀₁ hN₀₁ using h_cross_01

  have h_cross_10 : ∀ p : ↥S_D1 × ↥S_B0,
      ∃ N : ℕ, x₁ ^ N * Algebra.trace K₂ L₂ ((p.1 : L₂) * (p.2 : L₂)) ∈ (φ_K₂ 0).range := by
    intro p
    have hz_ov := (h_ov_all 1 0).2 (p.2 : L₂) (hSB0_mem p.2.1 p.2.2)
    have htr_ov := (h_ov_all 1 0).1 (p.1 : L₂) (p.2 : L₂) (hSD1_tr p.1.1 p.1.2) hz_ov
    rw [mul_comm (p.2 : L₂) (p.1 : L₂), sup_comm] at htr_ov
    obtain ⟨N, hN⟩ := (hOv_pkg 0 1).2 _ htr_ov
    have hratio : homCoord 1 / homCoord 0 = x₁ := by
      change x₁ / (1 : K₂) = x₁
      exact div_one x₁
    rw [hratio] at hN
    exact ⟨N, hN⟩
  choose N₁₀ hN₁₀ using h_cross_10

  let a_pole : ℕ := max (Finset.univ.sup N₀₁) (Finset.univ.sup N₁₀)
  let m₀ := S_D0.card
  let m₁ := S_D1.card
  let r₀ := m₀ + m₁
  let e_D0 : Fin m₀ ≃ ↥S_D0 := S_D0.equivFin.symm
  let e_D1 : Fin m₁ ≃ ↥S_D1 := S_D1.equivFin.symm
  let η : Fin r₀ → L₂ :=
    Fin.addCases (fun j => (e_D0 j : L₂))
      (fun l => algebraMap K₂ L₂ (x₁ ^ a_pole) * (e_D1 l : L₂))

  have hη_D0 : ∀ α : Fin r₀,
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      ∀ z : L₂, z ∈ integralClosure A L₂ → Algebra.trace K₂ L₂ (η α * z) ∈ (φ_K₂ 0).range := by
    intro α
    letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
    refine Fin.addCases (fun j z hz => ?_) (fun l z hz => ?_) α
    · dsimp [η]
      rw [Fin.addCases_left]
      exact hSD0_tr (e_D0 j).1 (e_D0 j).2 z hz
    · dsimp [η]
      rw [Fin.addCases_right]
      have hz_span : z ∈ Submodule.span A (S_B0 : Set L₂) := hSB0_span z hz
      clear hz
      induction hz_span using Submodule.span_induction with
      | mem w hw =>
        let p : ↥S_D1 × ↥S_B0 := (e_D1 l, ⟨w, hw⟩)
        have hN_le : N₁₀ p ≤ a_pole :=
          le_trans (Finset.le_sup (Finset.mem_univ p)) (le_max_right _ _)
        have h_split : a_pole = (a_pole - N₁₀ p) + N₁₀ p := by omega
        have h_smul : (algebraMap K₂ L₂ (x₁ ^ a_pole) * (e_D1 l : L₂)) * w =
            (x₁ ^ a_pole) • ((e_D1 l : L₂) * w) := by
          rw [Algebra.smul_def]
          ring
        rw [h_smul, LinearMap.map_smul, smul_eq_mul, h_split, pow_add, mul_assoc]
        exact (φ_K₂ 0).range.mul_mem ((φ_K₂ 0).range.pow_mem hx₁_R0 _) (hN₁₀ p)
      | zero =>
        rw [mul_zero, map_zero]
        exact (φ_K₂ 0).range.zero_mem
      | add w₁ w₂ _ _ ih₁ ih₂ =>
        rw [mul_add, map_add]
        exact (φ_K₂ 0).range.add_mem ih₁ ih₂
      | smul r w _ ih =>
        have h_rw : (algebraMap K₂ L₂ (x₁ ^ a_pole) * (e_D1 l : L₂)) * (r • w) =
            (φ_K₂ 0 r) • ((algebraMap K₂ L₂ (x₁ ^ a_pole) * (e_D1 l : L₂)) * w) := by
          rw [Algebra.smul_def, Algebra.smul_def]
          change _ * (algebraMap K₂ L₂ (φ_K₂ 0 r) * w) = algebraMap K₂ L₂ (φ_K₂ 0 r) * _
          ring
        rw [h_rw, LinearMap.map_smul, smul_eq_mul]
        exact (φ_K₂ 0).range.mul_mem ((φ_K₂ 0).mem_range_self r) ih

  have hη_D1 : ∀ α : Fin r₀,
      letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
      ∀ z : L₂, z ∈ integralClosure A L₂ →
        Algebra.trace K₂ L₂ ((algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * η α) * z) ∈ (φ_K₂ 1).range := by
    intro α
    letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
    refine Fin.addCases (fun j z hz => ?_) (fun l z hz => ?_) α
    · dsimp [η]
      rw [Fin.addCases_left]
      have hz_span : z ∈ Submodule.span A (S_B1 : Set L₂) := hSB1_span z hz
      clear hz
      induction hz_span using Submodule.span_induction with
      | mem w hw =>
        let p : ↥S_D0 × ↥S_B1 := (e_D0 j, ⟨w, hw⟩)
        have hN_le : N₀₁ p ≤ a_pole :=
          le_trans (Finset.le_sup (Finset.mem_univ p)) (le_max_left _ _)
        have h_split : a_pole = (a_pole - N₀₁ p) + N₀₁ p := by omega
        have h_smul : (algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * (e_D0 j : L₂)) * w =
            ((x₁⁻¹) ^ a_pole) • ((e_D0 j : L₂) * w) := by
          rw [Algebra.smul_def]
          ring
        rw [h_smul, LinearMap.map_smul, smul_eq_mul, h_split, pow_add, mul_assoc]
        exact (φ_K₂ 1).range.mul_mem ((φ_K₂ 1).range.pow_mem hx₁inv_R1 _) (hN₀₁ p)
      | zero =>
        rw [mul_zero, map_zero]
        exact (φ_K₂ 1).range.zero_mem
      | add w₁ w₂ _ _ ih₁ ih₂ =>
        rw [mul_add, map_add]
        exact (φ_K₂ 1).range.add_mem ih₁ ih₂
      | smul r w _ ih =>
        have h_rw : (algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * (e_D0 j : L₂)) * (r • w) =
            (φ_K₂ 1 r) • ((algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * (e_D0 j : L₂)) * w) := by
          rw [Algebra.smul_def, Algebra.smul_def]
          change _ * (algebraMap K₂ L₂ (φ_K₂ 1 r) * w) = algebraMap K₂ L₂ (φ_K₂ 1 r) * _
          ring
        rw [h_rw, LinearMap.map_smul, smul_eq_mul]
        exact (φ_K₂ 1).range.mul_mem ((φ_K₂ 1).mem_range_self r) ih
    · dsimp [η]
      rw [Fin.addCases_right]
      have h_cancel :
          algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * (algebraMap K₂ L₂ (x₁ ^ a_pole) * (e_D1 l : L₂)) =
          (e_D1 l : L₂) := by
        rw [← mul_assoc, ← map_mul, ← mul_pow, inv_mul_cancel₀ hx₁_ne, one_pow, map_one, one_mul]
      rw [h_cancel]
      exact hSD1_tr (e_D1 l).1 (e_D1 l).2 z hz

  let Φ₀ : L₂ →ₗ[K₂] (Fin r₀ → K₂) :=
    { toFun := fun z α => Algebra.trace K₂ L₂ (z * η α)
      map_add' := by
        intro z₁ z₂
        ext α
        simp [add_mul]
      map_smul' := by
        intro c z
        ext α
        simp }

  obtain ⟨r₁, b_pole, Ψ₀, hΨ₀_ker, hΨ₀_R0, hΨ₀_R1⟩ :=
    h_s4 K₂ (φ_K₂ 0) (φ_K₂ 1) x₁ hx₁_ne hφ0_apply hMirror_R1 r₀ (LinearMap.range Φ₀)

  refine ⟨r₀, r₁, a_pole, b_pole, Φ₀, Ψ₀, ?_, hΨ₀_ker, ?_, ?_, ?_, ?_, hΨ₀_R0, hΨ₀_R1⟩
  · 
    rw [injective_iff_map_eq_zero]
    intro z hz
    apply hSD0_nondeg z
    intro y hy
    let j : Fin m₀ := e_D0.symm ⟨y, hy⟩
    have hj : (e_D0 j : L₂) = y := congrArg Subtype.val (e_D0.apply_symm_apply ⟨y, hy⟩)
    have hα : Φ₀ z (Fin.castAdd m₁ j) = 0 := congrFun hz (Fin.castAdd m₁ j)
    change Algebra.trace K₂ L₂ (z * η (Fin.castAdd m₁ j)) = 0 at hα
    dsimp [η] at hα
    rw [Fin.addCases_left, hj, mul_comm] at hα
    exact hα
  · 
    intro c' δ hδ α
    exact (h_ov_all 0 c').1 (η α) δ (hη_D0 α) hδ
  · 
    intro d δ hδ α
    have h_tr := (h_ov_all 1 2).1
      (algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * η α)
      ((algebraMap K₂ L₂ x₁) ^ (d + a_pole) * δ)
      (hη_D1 α) hδ
    have h_arg :
        ((algebraMap K₂ L₂ x₁) ^ (d + a_pole) * δ) *
          (algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * η α) =
        (x₁ ^ d) • (δ * η α) := by
      have h_inv : x₁ ^ a_pole * (x₁⁻¹) ^ a_pole = 1 := by
        rw [← mul_pow, mul_inv_cancel₀ hx₁_ne, one_pow]
      calc
        ((algebraMap K₂ L₂ x₁) ^ (d + a_pole) * δ) *
            (algebraMap K₂ L₂ ((x₁⁻¹) ^ a_pole) * η α)
          = (algebraMap K₂ L₂ (x₁ ^ d) *
              algebraMap K₂ L₂ (x₁ ^ a_pole * (x₁⁻¹) ^ a_pole)) * (δ * η α) := by
              rw [← map_pow, pow_add, map_mul, map_mul]
              ring
        _ = (x₁ ^ d) • (δ * η α) := by
              rw [h_inv, map_one, mul_one, Algebra.smul_def]
    rwa [h_arg, LinearMap.map_smul, smul_eq_mul] at h_tr
  · 
    intro z hz
    apply hSD0_refl z
    intro y hy
    let j : Fin m₀ := e_D0.symm ⟨y, hy⟩
    have hj : (e_D0 j : L₂) = y := congrArg Subtype.val (e_D0.apply_symm_apply ⟨y, hy⟩)
    have hα := hz (Fin.castAdd m₁ j)
    change Algebra.trace K₂ L₂ (z * η (Fin.castAdd m₁ j)) ∈ (φ_K₂ 0).range at hα
    dsimp [η] at hα
    rwa [Fin.addCases_left, hj, mul_comm] at hα
  · 
    intro d z hz
    apply hSD1_refl ((algebraMap K₂ L₂ x₁) ^ (d + a_pole) * z)
    intro y hy
    let l : Fin m₁ := e_D1.symm ⟨y, hy⟩
    have hl : (e_D1 l : L₂) = y := congrArg Subtype.val (e_D1.apply_symm_apply ⟨y, hy⟩)
    have hα := hz (Fin.natAdd m₀ l)
    change x₁ ^ d * Algebra.trace K₂ L₂ (z * η (Fin.natAdd m₀ l)) ∈ (φ_K₂ 1).range at hα
    dsimp [η] at hα
    rw [Fin.addCases_right, hl] at hα
    have h_arg :
        y * ((algebraMap K₂ L₂ x₁) ^ (d + a_pole) * z) =
        (x₁ ^ d) • (z * (algebraMap K₂ L₂ (x₁ ^ a_pole) * y)) := by
      rw [← map_pow, pow_add, map_mul, Algebra.smul_def]
      ring
    rwa [h_arg, LinearMap.map_smul, smul_eq_mul]

theorem weil_esz_hensel_idempotent_lift_and_constant_mod (k : Type u) [Field k] [IsAlgClosed k] :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (H_Sigma : MvPolynomial (Fin 3) k)
      (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂],
      Irreducible (eval_c 0 H_Sigma) →
      Function.Injective (φ_K₂ 0) →
      (∀ P : MvPolynomial (Fin 2) k,
        φ_K₂ 0 P = algebraMap (MvPolynomial (Fin 2) k) K₂ P) →
      @IsFractionRing (MvPolynomial (Fin 2) k) _ K₂ _ (φ_K₂ 1).toRingHom.toAlgebra →
      (∀ f : K₂,
        f ∈ (φ_K₂ 0).range → f ∈ (φ_K₂ 1).range → ∃ c₀ : k, algebraMap k K₂ c₀ = f) →
      (∀ (k_iter : ℕ)
        (e_chart : ∀ c : Fin 3,
          ↥(@integralClosure (MvPolynomial (Fin 2) k) L₂ _ _
            ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra)),
        (∀ c : Fin 3,
          letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
            ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
          let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
          (e_chart c) ^ 2 - e_chart c ∈
            Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c (eval_c c H_Sigma)}) →
        (∀ c c' : Fin 3,
          let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
          letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
          ∃ w : L₂,
            IsIntegral ↥R_ov w ∧
            (e_chart c' : L₂) - (e_chart c : L₂) =
              algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma)) * w) →
        ∃ (e_lift : ∀ c : Fin 3,
            ↥(@integralClosure (MvPolynomial (Fin 2) k) L₂ _ _
              ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra)),
          (letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
             ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
           let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
           e_lift 0 - e_chart 0 ∈
             Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 H_Sigma)}) ∧
          (∀ c c' : Fin 3,
            let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
            letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
            ∃ w_m : L₂,
              IsIntegral ↥R_ov w_m ∧
              (e_lift c' : L₂) - (e_lift c : L₂) =
                (algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))) ^ (2 ^ k_iter) * w_m)) ∧
      ((∀ e_glob : L₂,
          e_glob ∈ @integralClosure (MvPolynomial (Fin 2) k) L₂ _ _
            ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra →
          e_glob ∈ @integralClosure (MvPolynomial (Fin 2) k) L₂ _ _
            ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra →
          ∃ c₀ : k, algebraMap K₂ L₂ (algebraMap k K₂ c₀) = e_glob) ∧
        (∀ (c₀ : k)
           (e₀ : ↥(@integralClosure (MvPolynomial (Fin 2) k) L₂ _ _
             ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra)),
           (letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
              ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
            let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
            e₀ ^ 2 - e₀ ∈
              Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 H_Sigma)}) →
           (letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
              ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
            let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
            e₀ - algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (MvPolynomial.C c₀) ∈
              Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 H_Sigma)}) →
           letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
             ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
           let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
           let I₀ : Ideal ↥B₂_0 :=
             Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 H_Sigma)}
           e₀ ∈ I₀ ∨ e₀ - 1 ∈ I₀)) :=
by
  intro K₂ x₁ x₂ homCoord eval_c φ_K₂ H_Sigma L₂ _ _ _
    _hIrr_H0 _hφ0_inj hφ0_apply hFrac1 hConst_inter
  let A := MvPolynomial (Fin 2) k
  refine ⟨?_, ?_, ?_⟩
  · 
    intro k_iter e_chart hIdemp hOverlap
    have hInt_ov : ∀ (c c' : Fin 3)
        (z : ↥(@integralClosure A L₂ _ _
          ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra)),
        let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
        letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
        IsIntegral ↥R_ov (z : L₂) := by
      intro c c' z
      let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
      letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
      obtain ⟨p, hp_monic, hp_eval⟩ := z.2
      let ι_ov : A →+* ↥R_ov :=
        { toFun := fun a => ⟨φ_K₂ c a, Algebra.mem_sup_left (AlgHom.mem_range_self (φ_K₂ c) a)⟩
          map_one' := Subtype.ext (map_one (φ_K₂ c))
          map_mul' := fun a b => Subtype.ext (map_mul (φ_K₂ c) a b)
          map_zero' := Subtype.ext (map_zero (φ_K₂ c))
          map_add' := fun a b => Subtype.ext (map_add (φ_K₂ c) a b) }
      have hcomp : (algebraMap ↥R_ov L₂).comp ι_ov =
          (algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom :=
        RingHom.ext fun _ => rfl
      refine ⟨p.map ι_ov, hp_monic.map ι_ov, ?_⟩
      rw [Polynomial.eval₂_map, hcomp]
      exact hp_eval
    have hInt_h : ∀ (c c' : Fin 3),
        let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
        letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
        IsIntegral ↥R_ov (algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))) := by
      intro c c'
      let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
      letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
      let r_h : ↥R_ov := ⟨φ_K₂ c (eval_c c H_Sigma),
        Algebra.mem_sup_left (AlgHom.mem_range_self (φ_K₂ c) _)⟩
      exact @isIntegral_algebraMap ↥R_ov L₂ _ _ _ r_h
    have hStrong : ∃ (e_lift : ∀ c : Fin 3,
        ↥(@integralClosure A L₂ _ _
          ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra)),
      (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
       let B₂_0 := integralClosure A L₂
       e_lift 0 - e_chart 0 ∈
         Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}) ∧
      (∀ c : Fin 3,
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        (e_lift c) ^ 2 - e_lift c ∈
          Ideal.span {(algebraMap A ↥B₂_c (eval_c c H_Sigma)) ^ (2 ^ k_iter)}) ∧
      (∀ c c' : Fin 3,
        let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
        letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
        ∃ w_m : L₂,
          IsIntegral ↥R_ov w_m ∧
          (e_lift c' : L₂) - (e_lift c : L₂) =
            (algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))) ^ (2 ^ k_iter) * w_m) := by
      induction k_iter with
      | zero =>
        refine ⟨e_chart, ?_, ?_, ?_⟩
        · letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
          dsimp only
          rw [sub_self]
          exact Ideal.zero_mem _
        · intro c
          letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
          dsimp only
          rw [pow_zero, pow_one]
          exact hIdemp c
        · intro c c'
          dsimp only
          rw [pow_zero, pow_one]
          exact hOverlap c c'
      | succ k_it ih =>
        obtain ⟨e_prev, hAnchor, hId_prev, hOv_prev⟩ := ih
        let e_next : ∀ c : Fin 3,
            ↥(@integralClosure A L₂ _ _
              ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra) :=
          fun c =>
            letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
            3 * (e_prev c) ^ 2 - 2 * (e_prev c) ^ 3
        have he_next_val : ∀ c : Fin 3,
            (e_next c : L₂) = 3 * (e_prev c : L₂) ^ 2 - 2 * (e_prev c : L₂) ^ 3 := by
          intro c
          letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
          change ((3 * (e_prev c) ^ 2 - 2 * (e_prev c) ^ 3 :
            ↥(integralClosure A L₂)) : L₂) = _
          push_cast
          rfl
        refine ⟨e_next, ?_, ?_, ?_⟩
        · letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
          let B₂_0 := integralClosure A L₂
          let hbar0 : ↥B₂_0 := algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)
          let I₀ : Ideal ↥B₂_0 := Ideal.span {hbar0}
          have hId0 := hId_prev 0
          dsimp only at hId0
          rw [Ideal.mem_span_singleton] at hId0
          obtain ⟨u₀, hu₀⟩ := hId0
          have hm_ge : 1 ≤ 2 ^ k_it := Nat.one_le_two_pow
          have hm_split : 2 ^ k_it = 1 + (2 ^ k_it - 1) := by omega
          have hstep_mem : e_next 0 - e_prev 0 ∈ I₀ := by
            rw [Ideal.mem_span_singleton]
            refine ⟨hbar0 ^ (2 ^ k_it - 1) * u₀ * (1 - 2 * e_prev 0), ?_⟩
            have hH2 : e_next 0 - e_prev 0 =
                ((e_prev 0) ^ 2 - e_prev 0) * (1 - 2 * e_prev 0) := by
              change (3 * (e_prev 0) ^ 2 - 2 * (e_prev 0) ^ 3) - e_prev 0 = _
              ring
            rw [hH2, hu₀]
            conv_lhs => rw [hm_split, pow_add, pow_one]
            ring
          have hsum : e_next 0 - e_chart 0 =
              (e_next 0 - e_prev 0) + (e_prev 0 - e_chart 0) := by abel
          dsimp only
          rw [hsum]
          exact I₀.add_mem hstep_mem hAnchor
        · intro c
          letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
          let B₂_c := integralClosure A L₂
          let hbar_c : ↥B₂_c := algebraMap A ↥B₂_c (eval_c c H_Sigma)
          have hId_c := hId_prev c
          dsimp only at hId_c
          rw [Ideal.mem_span_singleton] at hId_c
          obtain ⟨u_c, hu_c⟩ := hId_c
          dsimp only
          rw [Ideal.mem_span_singleton]
          refine ⟨u_c ^ 2 * (4 * (e_prev c) ^ 2 - 4 * e_prev c - 3), ?_⟩
          have hH1 : (e_next c) ^ 2 - e_next c =
              ((e_prev c) ^ 2 - e_prev c) ^ 2 *
                (4 * (e_prev c) ^ 2 - 4 * e_prev c - 3) := by
            change (3 * (e_prev c) ^ 2 - 2 * (e_prev c) ^ 3) ^ 2 -
              (3 * (e_prev c) ^ 2 - 2 * (e_prev c) ^ 3) = _
            ring
          rw [hH1, hu_c, pow_succ 2 k_it, pow_mul]
          ring
        · intro c c'
          obtain ⟨u_c, hu_c_L₂⟩ : ∃ u_c :
              ↥(@integralClosure A L₂ _ _
                ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra),
              (e_prev c : L₂) ^ 2 - (e_prev c : L₂) =
                (algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))) ^ (2 ^ k_it) *
                  (u_c : L₂) := by
            letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
            let B₂_c := integralClosure A L₂
            have hId_c := hId_prev c
            dsimp only at hId_c
            rw [Ideal.mem_span_singleton] at hId_c
            obtain ⟨u_c, hu_c⟩ := hId_c
            refine ⟨u_c, ?_⟩
            have hval := congrArg Subtype.val hu_c
            push_cast at hval
            exact hval
          let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
          letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
          let IC := integralClosure ↥R_ov L₂
          obtain ⟨w, hw_int, hw_eq⟩ := hOv_prev c c'
          let htilde_c : L₂ := algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))
          let w' : L₂ :=
            -6 * (u_c : L₂) * w + (3 - 6 * (e_prev c : L₂)) * w ^ 2 -
              2 * htilde_c ^ (2 ^ k_it) * w ^ 3
          have hw'_int : IsIntegral ↥R_ov w' := by
            change w' ∈ IC
            have hu_mem : (u_c : L₂) ∈ IC := hInt_ov c c' u_c
            have he_mem : (e_prev c : L₂) ∈ IC := hInt_ov c c' (e_prev c)
            have hh_mem : htilde_c ∈ IC := hInt_h c c'
            have hw_mem : w ∈ IC := hw_int
            have h2 : (2 : L₂) ∈ IC := by
              rw [show (2 : L₂) = 1 + 1 by norm_num]
              exact IC.add_mem IC.one_mem IC.one_mem
            have h3 : (3 : L₂) ∈ IC := by
              rw [show (3 : L₂) = (2 : L₂) + 1 by norm_num]
              exact IC.add_mem h2 IC.one_mem
            have h6 : (6 : L₂) ∈ IC := by
              rw [show (6 : L₂) = (3 : L₂) * (2 : L₂) by norm_num]
              exact IC.mul_mem h3 h2
            exact IC.sub_mem
              (IC.add_mem
                (IC.mul_mem (IC.mul_mem (IC.neg_mem h6) hu_mem) hw_mem)
                (IC.mul_mem (IC.sub_mem h3 (IC.mul_mem h6 he_mem)) (IC.pow_mem hw_mem 2)))
              (IC.mul_mem (IC.mul_mem h2 (IC.pow_mem hh_mem (2 ^ k_it))) (IC.pow_mem hw_mem 3))
          refine ⟨w', hw'_int, ?_⟩
          rw [he_next_val c', he_next_val c]
          have hH3 : (3 * (e_prev c' : L₂) ^ 2 - 2 * (e_prev c' : L₂) ^ 3) -
              (3 * (e_prev c : L₂) ^ 2 - 2 * (e_prev c : L₂) ^ 3) =
              -6 * ((e_prev c : L₂) ^ 2 - (e_prev c : L₂)) *
                ((e_prev c' : L₂) - (e_prev c : L₂)) +
              (3 - 6 * (e_prev c : L₂)) * ((e_prev c' : L₂) - (e_prev c : L₂)) ^ 2 -
              2 * ((e_prev c' : L₂) - (e_prev c : L₂)) ^ 3 := by ring
          rw [hH3, hu_c_L₂, hw_eq, pow_succ 2 k_it, pow_mul]
          dsimp [w', htilde_c]
          ring
    obtain ⟨e_lift, h1, _, h3⟩ := hStrong
    exact ⟨e_lift, h1, h3⟩
  · 
    intro e_glob he0 he1
    haveI : Algebra.IsIntegral K₂ L₂ := Algebra.IsIntegral.of_finite K₂ L₂
    have he_K₂ : IsIntegral K₂ e_glob := Algebra.IsIntegral.isIntegral e_glob
    let p_min : Polynomial K₂ := minpoly K₂ e_glob
    have hp_monic : p_min.Monic := minpoly.monic he_K₂
    have hp_aeval : Polynomial.aeval e_glob p_min = 0 := minpoly.aeval K₂ e_glob
    have h_mem0 : ∀ i : ℕ, p_min.coeff i ∈ (φ_K₂ 0).range := by
      have hφ0_rh : (φ_K₂ 0).toRingHom = algebraMap A K₂ := RingHom.ext hφ0_apply
      have he0_std : @IsIntegral A L₂ _ _
          ((algebraMap K₂ L₂).comp (algebraMap A K₂)).toAlgebra e_glob := by
        change e_glob ∈ @integralClosure A L₂ _ _
          ((algebraMap K₂ L₂).comp (algebraMap A K₂)).toAlgebra
        rwa [← hφ0_rh]
      let algL0 : Algebra A L₂ := ((algebraMap K₂ L₂).comp (algebraMap A K₂)).toAlgebra
      have st0 : @IsScalarTower A K₂ L₂ _ _ algL0.toSMul :=
        @IsScalarTower.of_algebraMap_eq' A K₂ L₂ _ _ _ _ _ algL0 rfl
      have hp0 : p_min = (@minpoly A L₂ _ _ algL0 e_glob).map (algebraMap A K₂) :=
        @minpoly.isIntegrallyClosed_eq_field_fractions'
          A L₂ _ _ _ algL0 K₂ _ _ _ _ _ _ st0 e_glob he0_std
      intro i
      rw [hp0, Polynomial.coeff_map, ← hφ0_apply]
      exact AlgHom.mem_range_self (φ_K₂ 0) _
    have h_mem1 : ∀ i : ℕ, p_min.coeff i ∈ (φ_K₂ 1).range := by
      let algK1 : Algebra A K₂ := (φ_K₂ 1).toRingHom.toAlgebra
      let algL1 : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
      have st1 : @IsScalarTower A K₂ L₂ algK1.toSMul _ algL1.toSMul :=
        @IsScalarTower.of_algebraMap_eq' A K₂ L₂ _ _ _ algK1 _ algL1 rfl
      have he1' : @IsIntegral A L₂ _ _ algL1 e_glob := he1
      have hp1 : p_min = (@minpoly A L₂ _ _ algL1 e_glob).map (φ_K₂ 1).toRingHom :=
        @minpoly.isIntegrallyClosed_eq_field_fractions'
          A L₂ _ _ _ algL1 K₂ _ algK1 hFrac1 _ _ _ st1 e_glob he1'
      intro i
      rw [hp1, Polynomial.coeff_map]
      exact AlgHom.mem_range_self (φ_K₂ 1) _
    have h_coeff_k : ∀ i : ℕ, ∃ c : k, algebraMap k K₂ c = p_min.coeff i :=
      fun i => hConst_inter (p_min.coeff i) (h_mem0 i) (h_mem1 i)
    choose coeff_k hcoeff_k using h_coeff_k
    let P_k : Polynomial k := ∑ i ∈ p_min.support, Polynomial.monomial i (coeff_k i)
    have hPk_map : P_k.map (algebraMap k K₂) = p_min := by
      dsimp [P_k]
      rw [Polynomial.map_sum]
      simp_rw [Polynomial.map_monomial, hcoeff_k]
      exact (Polynomial.as_sum_support p_min).symm
    have hPk_monic : P_k.Monic := by
      haveI : Nontrivial K₂ := inferInstance
      exact (Polynomial.monic_map_iff (f := algebraMap k K₂)).mp (by rwa [hPk_map])
    have hPk_splits := IsAlgClosed.splits P_k
    rw [Polynomial.splits_iff_exists_multiset] at hPk_splits
    obtain ⟨m_roots, hm_roots⟩ := hPk_splits
    rw [hPk_monic.leadingCoeff, map_one, one_mul] at hm_roots
    let ι_kL : k →+* L₂ := (algebraMap K₂ L₂).comp (algebraMap k K₂)
    have heval_zero : Polynomial.eval₂ ι_kL e_glob P_k = 0 := by
      dsimp [ι_kL]
      rw [← Polynomial.eval₂_map, hPk_map]
      exact hp_aeval
    rw [hm_roots, Polynomial.eval₂_multiset_prod, Multiset.map_map] at heval_zero
    have h0_mem := Multiset.prod_eq_zero_iff.mp heval_zero
    rw [Multiset.mem_map] at h0_mem
    obtain ⟨c₀, _, hy_zero⟩ := h0_mem
    dsimp [Function.comp] at hy_zero
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at hy_zero
    exact ⟨c₀, (sub_eq_zero.mp hy_zero).symm⟩
  · 
    intro c₀ e₀ h_id h_congr
    letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
    let B₂_0 := integralClosure A L₂
    let I₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H_Sigma)}
    let ψ : k →+* ↥B₂_0 := (algebraMap A ↥B₂_0).comp MvPolynomial.C
    change e₀ ^ 2 - e₀ ∈ I₀ at h_id
    change e₀ - ψ c₀ ∈ I₀ at h_congr
    change e₀ ∈ I₀ ∨ e₀ - 1 ∈ I₀
    by_cases hc0 : c₀ = 0
    · left
      subst hc0
      simpa only [map_zero, sub_zero] using h_congr
    · by_cases hc1 : c₀ = 1
      · right
        subst hc1
        simpa only [map_one] using h_congr
      · left
        let u : k := c₀ ^ 2 - c₀
        have hu_ne : u ≠ 0 := by
          have hfac : u = c₀ * (c₀ - 1) := by dsimp [u]; ring
          rw [hfac]
          exact mul_ne_zero hc0 (sub_ne_zero.mpr hc1)
        have hψu_eq : ψ u = (e₀ ^ 2 - e₀) - (e₀ - ψ c₀) * (e₀ + ψ c₀ - 1) := by
          dsimp [u]
          rw [map_sub, map_pow]
          ring
        have hψu_mem : ψ u ∈ I₀ := by
          rw [hψu_eq]
          exact I₀.sub_mem h_id (I₀.mul_mem_right (e₀ + ψ c₀ - 1) h_congr)
        have h_inv : ψ u⁻¹ * ψ u = 1 := by
          rw [← map_mul, inv_mul_cancel₀ hu_ne, map_one]
        have he₀_eq : e₀ = (e₀ * ψ u⁻¹) * ψ u := by
          rw [mul_assoc, h_inv, mul_one]
        rw [he₀_eq]
        exact I₀.mul_mem_left (e₀ * ψ u⁻¹) hψu_mem

theorem weil_net_esz_three_chart_trace_dual_connected (k : Type u) [Field k] [IsAlgClosed k] :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (d_Sigma : ℕ) (H_Sigma : MvPolynomial (Fin 3) k)
      (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂],
      1 ≤ d_Sigma →
      H_Sigma.IsHomogeneous d_Sigma →
      Irreducible (eval_c 0 H_Sigma) →
      (∀ (c : Fin 3) (𝔪 : Ideal (MvPolynomial (Fin 2) k)),
        𝔪.IsMaximal →
        letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
          ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
        ∃ (s : MvPolynomial (Fin 2) k) (b : Fin (Module.finrank K₂ L₂) → ↥B₂_c),
          s ∉ 𝔪 ∧
          LinearIndependent K₂ (fun i => (b i : L₂)) ∧
          ∀ z : ↥B₂_c, ∃ a : Fin (Module.finrank K₂ L₂) → MvPolynomial (Fin 2) k,
            algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c s * z =
              ∑ i, algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c (a i) * b i) →
      ∀ (e_chart : ∀ c : Fin 3,
          ↥(letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
              ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
            integralClosure (MvPolynomial (Fin 2) k) L₂)),
        (∀ c : Fin 3,
          letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
            ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
          let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
          (e_chart c) ^ 2 - e_chart c ∈
            Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c (eval_c c H_Sigma)}) →
        (∀ c c' : Fin 3,
          let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
          letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
          ∃ w : L₂,
            IsIntegral ↥R_ov w ∧
            (e_chart c' : L₂) - (e_chart c : L₂) =
              algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma)) * w) →
        letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
          ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
        let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
        let I₀ : Ideal ↥B₂_0 :=
          Ideal.span {algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 H_Sigma)}
        e_chart 0 ∈ I₀ ∨ e_chart 0 - 1 ∈ I₀ :=
by
  intro K₂ x₁ x₂ homCoord eval_c φ_K₂ d_Sigma H_Sigma L₂ _ _ _ _
    hd_Sigma hHom hIrr_H0 hLocFree e_chart hIdemp hOverlap
  obtain ⟨⟨hCoord_ne, hφ0_inj, hφ1_inj, hφ0_apply, hMirror_R1⟩,
      hFrac1, hHom_scale, hOv_pkg, ⟨hNeg_vanish, hConst_inter⟩, hCech_H1⟩ :=
    weil_esz_p2_chart_laurent_cech_and_neg_twist_vanishing k
  obtain ⟨r₀, r₁, a_pole, b_pole, Φ₀, Ψ₀, hΦ₀_inj, hΨ₀_ker,
      hΦ₀_ov0, hΦ₀_ov12, hΦ₀_back0, hΦ₀_back1, hΨ₀_R0, hΨ₀_R1⟩ :=
    weil_esz_trace_dual_reflexive_and_global_presentation k L₂
      hCoord_ne hφ0_inj hφ1_inj hφ0_apply hMirror_R1 hOv_pkg hLocFree
  obtain ⟨hHensel_lift, hConst_descent, hIdemp_dichot⟩ :=
    weil_esz_hensel_idempotent_lift_and_constant_mod k H_Sigma L₂
      hIrr_H0 hφ0_inj hφ0_apply hFrac1 hConst_inter

  let k_iter := a_pole + b_pole + 1
  obtain ⟨m_pow, hm_pow_eq⟩ : ∃ m : ℕ, m = 2 ^ k_iter := ⟨2 ^ k_iter, rfl⟩
  let M_deg := m_pow * d_Sigma
  let d_tw := M_deg - a_pole
  let k_tw := d_tw - b_pole
  have hm_gt : k_iter < m_pow := hm_pow_eq ▸ Nat.lt_two_pow_self
  have hM_ge : a_pole + b_pole + 1 ≤ M_deg := by
    have h1 : m_pow * 1 ≤ m_pow * d_Sigma := Nat.mul_le_mul_left m_pow hd_Sigma
    dsimp [M_deg, k_iter] at hm_gt ⊢
    omega
  have hM_split : M_deg = d_tw + a_pole := by omega
  have hd_split : d_tw = k_tw + b_pole := by omega
  have hd_ge_one : 1 ≤ d_tw := by omega
  have hk_ge_one : 1 ≤ k_tw := by omega
  have hm_ge_one : 1 ≤ m_pow := hm_pow_eq ▸ Nat.one_le_two_pow

  obtain ⟨e_lift, h_lift_mod0, h_lift_ov⟩ :=
    hHensel_lift k_iter e_chart hIdemp hOverlap
  let htilde0 : K₂ := φ_K₂ 0 (eval_c 0 H_Sigma)
  have hhtilde0_ne : htilde0 ≠ 0 :=
    fun h0 => hIrr_H0.ne_zero (hφ0_inj (h0.trans (map_zero (φ_K₂ 0)).symm))
  let denom : L₂ := (algebraMap K₂ L₂ htilde0) ^ m_pow
  have hdenom_ne : denom ≠ 0 := by
    apply pow_ne_zero m_pow
    intro h0
    exact hhtilde0_ne ((RingHom.injective (algebraMap K₂ L₂)) (by rwa [map_zero]))

  let δ_ov : Fin 3 → Fin 3 → L₂ := fun c c' =>
    ((e_lift c' : L₂) - (e_lift c : L₂)) / denom
  have hδ_cocycle : δ_ov 0 1 + δ_ov 1 2 = δ_ov 0 2 := by
    dsimp [δ_ov]
    ring
  have hδ_int : ∀ c c' : Fin 3,
      let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
      letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
      IsIntegral ↥R_ov ((algebraMap K₂ L₂ (homCoord c)) ^ M_deg * δ_ov c c') := by
    intro c c'
    obtain ⟨w_m, hw_int, hw_eq⟩ := h_lift_ov c c'
    rw [← hm_pow_eq] at hw_eq
    have h_scale_pow : (φ_K₂ c (eval_c c H_Sigma)) ^ m_pow * (homCoord c) ^ M_deg =
        htilde0 ^ m_pow := by
      dsimp [M_deg, htilde0]
      rw [mul_comm m_pow d_Sigma, pow_mul, ← mul_pow, hHom_scale d_Sigma H_Sigma hHom c]
    have h_scale_L₂ :
        (algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))) ^ m_pow *
          (algebraMap K₂ L₂ (homCoord c)) ^ M_deg = denom := by
      have hmap := congrArg (algebraMap K₂ L₂) h_scale_pow
      simpa only [map_mul, map_pow] using hmap
    have h_eq_w : (algebraMap K₂ L₂ (homCoord c)) ^ M_deg * δ_ov c c' = w_m := by
      dsimp [δ_ov]
      rw [hw_eq, mul_div_assoc']
      have hmul : (algebraMap K₂ L₂ (homCoord c)) ^ M_deg *
          ((algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))) ^ m_pow * w_m) =
          ((algebraMap K₂ L₂ (φ_K₂ c (eval_c c H_Sigma))) ^ m_pow *
            (algebraMap K₂ L₂ (homCoord c)) ^ M_deg) * w_m := by ring
      rw [hmul, h_scale_L₂, mul_div_cancel_left₀ w_m hdenom_ne]
    rwa [h_eq_w]

  have hCech_coord : ∀ α : Fin r₀,
      ∃ v₀_α v₁_α : K₂,
        v₀_α ∈ (φ_K₂ 0).range ∧
        x₁ ^ d_tw * v₁_α ∈ (φ_K₂ 1).range ∧
        v₁_α - v₀_α = Φ₀ (δ_ov 0 1) α := by
    intro α
    have hu01 : Φ₀ (δ_ov 0 1) α ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 1).range := by
      have h0 := hδ_int 0 1
      have hc0 : homCoord 0 = 1 := rfl
      rw [hc0, map_one, one_pow, one_mul] at h0
      exact hΦ₀_ov0 1 (δ_ov 0 1) h0 α
    have hu02 : Φ₀ (δ_ov 0 2) α ∈ (φ_K₂ 0).range ⊔ (φ_K₂ 2).range := by
      have h0 := hδ_int 0 2
      have hc0 : homCoord 0 = 1 := rfl
      rw [hc0, map_one, one_pow, one_mul] at h0
      exact hΦ₀_ov0 2 (δ_ov 0 2) h0 α
    have hu12 : x₁ ^ d_tw * Φ₀ (δ_ov 1 2) α ∈ (φ_K₂ 1).range ⊔ (φ_K₂ 2).range := by
      have h1 := hδ_int 1 2
      have hc1 : homCoord 1 = x₁ := rfl
      rw [hc1, hM_split] at h1
      exact hΦ₀_ov12 d_tw (δ_ov 1 2) h1 α
    have hcoc : Φ₀ (δ_ov 0 1) α + Φ₀ (δ_ov 1 2) α = Φ₀ (δ_ov 0 2) α := by
      rw [← Pi.add_apply, ← map_add, hδ_cocycle]
    exact hCech_H1 d_tw (Φ₀ (δ_ov 0 1) α) (Φ₀ (δ_ov 1 2) α) (Φ₀ (δ_ov 0 2) α)
      hd_ge_one hu01 hu02 hu12 hcoc

  choose v₀_vec v₁_vec hv₀_vec hv₁_vec hv_diff using hCech_coord
  have hv_sub_range : v₁_vec - v₀_vec ∈ LinearMap.range Φ₀ := by
    refine ⟨δ_ov 0 1, ?_⟩
    ext α
    exact (hv_diff α).symm
  have hΨ_eq : Ψ₀ v₁_vec = Ψ₀ v₀_vec := by
    have h0 : Ψ₀ (v₁_vec - v₀_vec) = 0 := (hΨ₀_ker _).mpr hv_sub_range
    rwa [map_sub, sub_eq_zero] at h0
  have hΨ_v0_zero : Ψ₀ v₀_vec = 0 := by
    ext β
    apply hNeg_vanish k_tw (Ψ₀ v₀_vec β) hk_ge_one (hΨ₀_R0 v₀_vec hv₀_vec β)
    rw [← hΨ_eq]
    refine hΨ₀_R1 k_tw v₁_vec ?_ β
    intro α
    rw [← hd_split]
    exact hv₁_vec α
  have hΨ_v1_zero : Ψ₀ v₁_vec = 0 := hΨ_eq.trans hΨ_v0_zero

  obtain ⟨z₀, hz₀_Φ⟩ := (hΨ₀_ker v₀_vec).mp hΨ_v0_zero
  obtain ⟨z₁, hz₁_Φ⟩ := (hΨ₀_ker v₁_vec).mp hΨ_v1_zero
  have hz_diff : z₁ - z₀ = δ_ov 0 1 := by
    apply hΦ₀_inj
    rw [map_sub, hz₁_Φ, hz₀_Φ]
    ext α
    exact hv_diff α

  let e_glob : L₂ := (e_lift 0 : L₂) - denom * z₀
  have he_glob_eq1 : e_glob = (e_lift 1 : L₂) - denom * z₁ := by
    have h1 : denom * (z₁ - z₀) = (e_lift 1 : L₂) - (e_lift 0 : L₂) := by
      rw [hz_diff]
      dsimp [δ_ov]
      exact mul_div_cancel₀ _ hdenom_ne
    have hab : ((e_lift 0 : L₂) - denom * z₀) - ((e_lift 1 : L₂) - denom * z₁) =
        (denom * z₁ - denom * z₀) - ((e_lift 1 : L₂) - (e_lift 0 : L₂)) := by abel
    rw [← mul_sub, h1, sub_self] at hab
    exact sub_eq_zero.mp hab

  have hz₀_B0 :
      letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
        ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      z₀ ∈ integralClosure (MvPolynomial (Fin 2) k) L₂ := by
    apply hΦ₀_back0 z₀
    intro α
    rw [hz₀_Φ]
    exact hv₀_vec α

  have hz₁_B1 :
      letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
        ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
      (algebraMap K₂ L₂ x₁) ^ M_deg * z₁ ∈ integralClosure (MvPolynomial (Fin 2) k) L₂ := by
    rw [hM_split]
    apply hΦ₀_back1 d_tw z₁
    intro α
    rw [hz₁_Φ]
    exact hv₁_vec α

  have he_glob_B0 :
      letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
        ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
      e_glob ∈ integralClosure (MvPolynomial (Fin 2) k) L₂ := by
    letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
      ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
    let B₀_ic := integralClosure (MvPolynomial (Fin 2) k) L₂
    have hden_B0 : denom ∈ B₀_ic :=
      B₀_ic.pow_mem (B₀_ic.algebraMap_mem (eval_c 0 H_Sigma)) m_pow
    exact B₀_ic.sub_mem (e_lift 0).2 (B₀_ic.mul_mem hden_B0 hz₀_B0)

  have he_glob_B1 :
      letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
        ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
      e_glob ∈ integralClosure (MvPolynomial (Fin 2) k) L₂ := by
    letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
      ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
    let B₁_ic := integralClosure (MvPolynomial (Fin 2) k) L₂
    have h_scale1 : (φ_K₂ 1 (eval_c 1 H_Sigma)) ^ m_pow * x₁ ^ M_deg = htilde0 ^ m_pow := by
      dsimp [M_deg, htilde0]
      rw [mul_comm m_pow d_Sigma, pow_mul, ← mul_pow]
      exact congrArg (· ^ m_pow) (hHom_scale d_Sigma H_Sigma hHom 1)
    have h_scale1_L₂ :
        (algebraMap K₂ L₂ (φ_K₂ 1 (eval_c 1 H_Sigma))) ^ m_pow *
          (algebraMap K₂ L₂ x₁) ^ M_deg = denom := by
      have hmap := congrArg (algebraMap K₂ L₂) h_scale1
      simpa only [map_mul, map_pow] using hmap
    have hden_z1 : denom * z₁ =
        (algebraMap K₂ L₂ (φ_K₂ 1 (eval_c 1 H_Sigma))) ^ m_pow *
          ((algebraMap K₂ L₂ x₁) ^ M_deg * z₁) := by
      rw [← mul_assoc, h_scale1_L₂]
    rw [he_glob_eq1, hden_z1]
    have hh1_B1 : (algebraMap K₂ L₂ (φ_K₂ 1 (eval_c 1 H_Sigma))) ^ m_pow ∈ B₁_ic :=
      B₁_ic.pow_mem (B₁_ic.algebraMap_mem (eval_c 1 H_Sigma)) m_pow
    exact B₁_ic.sub_mem (e_lift 1).2 (B₁_ic.mul_mem hh1_B1 hz₁_B1)

  obtain ⟨c₀, hc₀⟩ := hConst_descent e_glob he_glob_B0 he_glob_B1
  letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
    ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
  let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
  let hbar0 : ↥B₂_0 := algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 H_Sigma)
  let I₀ : Ideal ↥B₂_0 := Ideal.span {hbar0}
  let γ₀ : ↥B₂_0 := algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (MvPolynomial.C c₀)
  have hγ₀_val : (γ₀ : L₂) = e_glob := by
    change algebraMap K₂ L₂ (φ_K₂ 0 (MvPolynomial.C c₀)) = e_glob
    dsimp [φ_K₂]
    rw [MvPolynomial.aeval_C]
    exact hc₀
  have h_lift_sub_γ : e_lift 0 - γ₀ ∈ I₀ := by
    let zbar0 : ↥B₂_0 := ⟨z₀, hz₀_B0⟩
    have h_eq : e_lift 0 - γ₀ = hbar0 ^ m_pow * zbar0 := by
      apply Subtype.ext
      push_cast
      rw [hγ₀_val]
      dsimp [e_glob, denom, htilde0, hbar0, zbar0]
      change (e_lift 0 : L₂) -
          ((e_lift 0 : L₂) - (algebraMap K₂ L₂ (φ_K₂ 0 (eval_c 0 H_Sigma))) ^ m_pow * z₀) =
        (algebraMap K₂ L₂ (φ_K₂ 0 (eval_c 0 H_Sigma))) ^ m_pow * z₀
      abel
    rw [h_eq, Ideal.mem_span_singleton]
    have hsp : m_pow = 1 + (m_pow - 1) := by omega
    refine ⟨hbar0 ^ (m_pow - 1) * zbar0, ?_⟩
    conv_lhs => rw [hsp, pow_add, pow_one]
    exact mul_assoc hbar0 (hbar0 ^ (m_pow - 1)) zbar0
  have he0_sub_γ : e_chart 0 - γ₀ ∈ I₀ := by
    have hdiff : e_chart 0 - γ₀ = (e_lift 0 - γ₀) - (e_lift 0 - e_chart 0) := by abel
    rw [hdiff]
    exact I₀.sub_mem h_lift_sub_γ h_lift_mod0
  exact hIdemp_dichot c₀ (e_chart 0) (hIdemp 0) he0_sub_γ

theorem weil_curve_idemp_p2_chart_laurent_and_overlap_iso (k : Type u) [Field k] :
    let A := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A
    let x₁ : K₂ := algebraMap A K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap A K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] A :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → A →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂],
      (∀ c : Fin 3, homCoord c ≠ 0 ∧ Function.Injective (φ_K₂ c)) ∧
      (∀ (d : ℕ) (H : MvPolynomial (Fin 3) k), H.IsHomogeneous d →
        ∀ c c' : Fin 3,
          φ_K₂ c' (eval_c c' H) * (homCoord c') ^ d =
            φ_K₂ c (eval_c c H) * (homCoord c) ^ d) ∧
      (∀ c : Fin 3,
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        Module.Finite A ↥B₂_c ∧
        IsNoetherianRing ↥B₂_c ∧
        (∀ a h : A,
          algebraMap A ↥B₂_c a ∈ Ideal.span {algebraMap A ↥B₂_c h} ↔
            a ∈ Ideal.span {h})) ∧
      (∀ (d : ℕ) (H : MvPolynomial (Fin 3) k), H.IsHomogeneous d →
        ∀ (j₀ : Fin 2)
          (B_0 B_c : Type u) [CommRing B_0] [CommRing B_c]
          (q_0 : A →+* B_0) (q_c : A →+* B_c),
          let c : Fin 3 := (0 : Fin 3).succAbove j₀
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
           let B₂_0 := integralClosure A L₂
           let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H)}
           ∃ e_0 : (↥B₂_0 ⧸ I_h₀) ≃+* B_0,
             ∀ g : A, e_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) = q_0 g) →
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
           let B₂_c := integralClosure A L₂
           let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H)}
           ∃ e_c : (↥B₂_c ⧸ I_hc) ≃+* B_c,
             ∀ g : A, e_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g)) = q_c g) →
          let v0_bar : B_0 := q_0 (MvPolynomial.X j₀)
          let uc_bar : B_c := q_c (MvPolynomial.X 0)
          (∀ z₀ : L₂,
            (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
             IsIntegral A z₀) →
            letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
            ∃ (m : ℕ) (z_c : ↥(integralClosure A L₂)),
              (z_c : L₂) * (algebraMap K₂ L₂ (homCoord c)) ^ m = z₀) ∧
          (∃ Ψ : Localization.Away v0_bar ≃+* Localization.Away uc_bar,
            (∀ c₀ : k,
              Ψ (algebraMap B_0 (Localization.Away v0_bar) (q_0 (MvPolynomial.C c₀))) =
                algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.C c₀))) ∧
            Ψ (algebraMap B_0 (Localization.Away v0_bar) v0_bar) *
              algebraMap B_c (Localization.Away uc_bar) uc_bar = 1 ∧
            Ψ (algebraMap B_0 (Localization.Away v0_bar)
                (q_0 (MvPolynomial.X (Fin.rev j₀)))) *
              algebraMap B_c (Localization.Away uc_bar) uc_bar =
              algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.X 1)))) ∧
      ((∀ z₂ : L₂,
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 2).toRingHom).toAlgebra
           IsIntegral A z₂) →
          letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ 1).toRingHom).toAlgebra
          ∃ (k_pow : ℕ) (z₁ : ↥(integralClosure A L₂)),
            (z₁ : L₂) = z₂ * (algebraMap K₂ L₂ (φ_K₂ 1 (MvPolynomial.X 1))) ^ k_pow) ∧
       (∀ (c c' : Fin 3) (z : L₂),
          (letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
           IsIntegral A z) →
          ∀ g' : A,
            let R_ov : Subalgebra k K₂ := (φ_K₂ c).range ⊔ (φ_K₂ c').range
            letI : Algebra ↥R_ov L₂ := ((algebraMap K₂ L₂).comp R_ov.val.toRingHom).toAlgebra
            IsIntegral ↥R_ov (z * algebraMap K₂ L₂ (φ_K₂ c' g')))) :=
by
  intro A K₂ x₁_init x₂_init homCoord_init eval_c φ_K₂_init L₂ _ _ _ _
  let ι₀_init : A →ₐ[k] K₂ := IsScalarTower.toAlgHom k A K₂
  have hι₀_inj_init : Function.Injective ι₀_init := IsFractionRing.injective A K₂
  have hι₀_surj_init : ∀ z : K₂, ∃ a b : A, b ≠ 0 ∧ z * ι₀_init b = ι₀_init a := by
    intro z
    obtain ⟨⟨a, b, hb⟩, hz⟩ := IsLocalization.surj (nonZeroDivisors A) z
    exact ⟨a, b, mem_nonZeroDivisors_iff_ne_zero.mp hb, hz⟩
  suffices h_gen :
      ∀ (K : Type u) [Field K] [Algebra k K] (ι₀ : A →ₐ[k] K),
        Function.Injective ι₀ →
        (∀ z : K, ∃ a b : A, b ≠ 0 ∧ z * ι₀ b = ι₀ a) →
        let x₁ : K := ι₀ (MvPolynomial.X 0)
        let x₂ : K := ι₀ (MvPolynomial.X 1)
        let homCoord : Fin 3 → K := ![1, x₁, x₂]
        let φ_K : Fin 3 → A →ₐ[k] K :=
          fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
        ∀ (L : Type u) [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L],
          (∀ c : Fin 3, homCoord c ≠ 0 ∧ Function.Injective (φ_K c)) ∧
          (∀ (d : ℕ) (H : MvPolynomial (Fin 3) k), H.IsHomogeneous d →
            ∀ c c' : Fin 3,
              φ_K c' (eval_c c' H) * (homCoord c') ^ d =
                φ_K c (eval_c c H) * (homCoord c) ^ d) ∧
          (∀ c : Fin 3,
            letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
            let B₂_c := integralClosure A L
            Module.Finite A ↥B₂_c ∧
            IsNoetherianRing ↥B₂_c ∧
            (∀ a h : A,
              algebraMap A ↥B₂_c a ∈ Ideal.span {algebraMap A ↥B₂_c h} ↔
                a ∈ Ideal.span {h})) ∧
          (∀ (d : ℕ) (H : MvPolynomial (Fin 3) k), H.IsHomogeneous d →
            ∀ (j₀ : Fin 2)
              (B_0 B_c : Type u) [CommRing B_0] [CommRing B_c]
              (q_0 : A →+* B_0) (q_c : A →+* B_c),
              let c : Fin 3 := (0 : Fin 3).succAbove j₀
              (letI : Algebra A L := ((algebraMap K L).comp (φ_K 0).toRingHom).toAlgebra
               let B₂_0 := integralClosure A L
               let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H)}
               ∃ e_0 : (↥B₂_0 ⧸ I_h₀) ≃+* B_0,
                 ∀ g : A, e_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) = q_0 g) →
              (letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
               let B₂_c := integralClosure A L
               let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H)}
               ∃ e_c : (↥B₂_c ⧸ I_hc) ≃+* B_c,
                 ∀ g : A, e_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g)) = q_c g) →
              let v0_bar : B_0 := q_0 (MvPolynomial.X j₀)
              let uc_bar : B_c := q_c (MvPolynomial.X 0)
              (∀ z₀ : L,
                (letI : Algebra A L := ((algebraMap K L).comp (φ_K 0).toRingHom).toAlgebra
                 IsIntegral A z₀) →
                letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
                ∃ (m : ℕ) (z_c : ↥(integralClosure A L)),
                  (z_c : L) * (algebraMap K L (homCoord c)) ^ m = z₀) ∧
              (∃ Ψ : Localization.Away v0_bar ≃+* Localization.Away uc_bar,
                (∀ c₀ : k,
                  Ψ (algebraMap B_0 (Localization.Away v0_bar) (q_0 (MvPolynomial.C c₀))) =
                    algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.C c₀))) ∧
                Ψ (algebraMap B_0 (Localization.Away v0_bar) v0_bar) *
                  algebraMap B_c (Localization.Away uc_bar) uc_bar = 1 ∧
                Ψ (algebraMap B_0 (Localization.Away v0_bar)
                    (q_0 (MvPolynomial.X (Fin.rev j₀)))) *
                  algebraMap B_c (Localization.Away uc_bar) uc_bar =
                  algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.X 1)))) ∧
          ((∀ z₂ : L,
              (letI : Algebra A L := ((algebraMap K L).comp (φ_K 2).toRingHom).toAlgebra
               IsIntegral A z₂) →
              letI : Algebra A L := ((algebraMap K L).comp (φ_K 1).toRingHom).toAlgebra
              ∃ (k_pow : ℕ) (z₁ : ↥(integralClosure A L)),
                (z₁ : L) = z₂ * (algebraMap K L (φ_K 1 (MvPolynomial.X 1))) ^ k_pow) ∧
           (∀ (c c' : Fin 3) (z : L),
              (letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
               IsIntegral A z) →
              ∀ g' : A,
                let R_ov : Subalgebra k K := (φ_K c).range ⊔ (φ_K c').range
                letI : Algebra ↥R_ov L := ((algebraMap K L).comp R_ov.val.toRingHom).toAlgebra
                IsIntegral ↥R_ov (z * algebraMap K L (φ_K c' g'))))
    from h_gen K₂ ι₀_init hι₀_inj_init hι₀_surj_init L₂
  intro K _ _ ι₀ hι₀_inj hι₀_surj x₁ x₂ homCoord φ_K L _ _ _ _

  have fin2_all : ∀ {P : Fin 2 → Prop}, P 0 → P 1 → ∀ i : Fin 2, P i := by
    intro P h0 h1 i
    fin_cases i
    · exact h0
    · exact h1
  have fin3_all : ∀ {P : Fin 3 → Prop}, P 0 → P 1 → P 2 → ∀ c : Fin 3, P c := by
    intro P h0 h1 h2 c
    fin_cases c
    · exact h0
    · exact h1
    · exact h2

  
  have hHom0 : homCoord 0 = 1 := rfl
  have hHom1 : homCoord 1 = x₁ := rfl
  have hHom2 : homCoord 2 = x₂ := rfl
  have hx₁ : x₁ ≠ 0 := by
    intro h
    exact MvPolynomial.X_ne_zero (R := k) (0 : Fin 2) (hι₀_inj (h.trans (map_zero ι₀).symm))
  have hx₂ : x₂ ≠ 0 := by
    intro h
    exact MvPolynomial.X_ne_zero (R := k) (1 : Fin 2) (hι₀_inj (h.trans (map_zero ι₀).symm))
  have hHom_ne : ∀ c : Fin 3, homCoord c ≠ 0 :=
    fin3_all one_ne_zero hx₁ hx₂
  have hφ0_X0 : φ_K 0 (MvPolynomial.X 0) = x₁ := by
    dsimp [φ_K]
    rw [MvPolynomial.aeval_X]
    change homCoord 1 / homCoord 0 = x₁
    rw [hHom1, hHom0, div_one]
  have hφ0_X1 : φ_K 0 (MvPolynomial.X 1) = x₂ := by
    dsimp [φ_K]
    rw [MvPolynomial.aeval_X]
    change homCoord 2 / homCoord 0 = x₂
    rw [hHom2, hHom0, div_one]
  have hφ0_eq : φ_K 0 = ι₀ := by
    apply MvPolynomial.algHom_ext
    exact fin2_all hφ0_X0 hφ0_X1
  have hφ1_X0 : φ_K 1 (MvPolynomial.X 0) = 1 / x₁ := by
    dsimp [φ_K]
    rw [MvPolynomial.aeval_X]
    have hs : (1 : Fin 3).succAbove 0 = 0 := by decide
    rw [hs, hHom0, hHom1]
  have hφ1_X1 : φ_K 1 (MvPolynomial.X 1) = x₂ / x₁ := by
    dsimp [φ_K]
    rw [MvPolynomial.aeval_X]
    have hs : (1 : Fin 3).succAbove 1 = 2 := by decide
    rw [hs, hHom2, hHom1]
  have hφ2_X0 : φ_K 2 (MvPolynomial.X 0) = 1 / x₂ := by
    dsimp [φ_K]
    rw [MvPolynomial.aeval_X]
    have hs : (2 : Fin 3).succAbove 0 = 0 := by decide
    rw [hs, hHom0, hHom2]
  have hφ2_X1 : φ_K 2 (MvPolynomial.X 1) = x₁ / x₂ := by
    dsimp [φ_K]
    rw [MvPolynomial.aeval_X]
    have hs : (2 : Fin 3).succAbove 1 = 1 := by decide
    rw [hs, hHom1, hHom2]

  
  have hφ_inj : ∀ c : Fin 3, Function.Injective (φ_K c) := by
    let S₁ := Localization.Away (MvPolynomial.X 0 : A)
    let S₂ := Localization.Away (MvPolynomial.X 1 : A)
    have hS₁_le : Submonoid.powers (MvPolynomial.X 0 : A) ≤ nonZeroDivisors A :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero (MvPolynomial.X_ne_zero 0))
    have hMapS₁_inj : Function.Injective (algebraMap A S₁) :=
      IsLocalization.injective S₁ hS₁_le
    have hx₁_unit : IsUnit (ι₀.toRingHom (MvPolynomial.X 0)) := IsUnit.mk0 x₁ hx₁
    have hx₂_unit : IsUnit (ι₀.toRingHom (MvPolynomial.X 1)) := IsUnit.mk0 x₂ hx₂
    let j₁ : S₁ →+* K := IsLocalization.Away.lift (MvPolynomial.X 0 : A) hx₁_unit
    let j₂ : S₂ →+* K := IsLocalization.Away.lift (MvPolynomial.X 1 : A) hx₂_unit
    have hj₁_eq : ∀ a : A, j₁ (algebraMap A S₁ a) = ι₀ a :=
      IsLocalization.Away.lift_eq (S := S₁) (MvPolynomial.X 0 : A) hx₁_unit
    have hj₂_eq : ∀ a : A, j₂ (algebraMap A S₂ a) = ι₀ a :=
      IsLocalization.Away.lift_eq (S := S₂) (MvPolynomial.X 1 : A) hx₂_unit
    have hj₁_inj : Function.Injective j₁ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨p, m, hm⟩, hp⟩ := IsLocalization.surj (Submonoid.powers (MvPolynomial.X 0 : A)) z
      have hp0 : ι₀ p = 0 := by
        have h1 := congrArg j₁ hp
        rw [map_mul, hz, zero_mul, hj₁_eq] at h1
        exact h1.symm
      have hp_eq : p = 0 := hι₀_inj (hp0.trans (map_zero ι₀).symm)
      rw [hp_eq, map_zero] at hp
      let um : S₁ˣ := (IsLocalization.map_units S₁ ⟨m, hm⟩).unit
      have hum : (um : S₁) = algebraMap A S₁ m := rfl
      calc
        z = z * ((um : S₁) * ↑(um⁻¹)) := by rw [Units.mul_inv, mul_one]
        _ = (z * algebraMap A S₁ m) * ↑(um⁻¹) := by rw [← hum]; ring
        _ = 0 := by rw [hp, zero_mul]
    have hj₂_inj : Function.Injective j₂ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨p, m, hm⟩, hp⟩ := IsLocalization.surj (Submonoid.powers (MvPolynomial.X 1 : A)) z
      have hp0 : ι₀ p = 0 := by
        have h1 := congrArg j₂ hp
        rw [map_mul, hz, zero_mul, hj₂_eq] at h1
        exact h1.symm
      have hp_eq : p = 0 := hι₀_inj (hp0.trans (map_zero ι₀).symm)
      rw [hp_eq, map_zero] at hp
      let um : S₂ˣ := (IsLocalization.map_units S₂ ⟨m, hm⟩).unit
      have hum : (um : S₂) = algebraMap A S₂ m := rfl
      calc
        z = z * ((um : S₂) * ↑(um⁻¹)) := by rw [Units.mul_inv, mul_one]
        _ = (z * algebraMap A S₂ m) * ↑(um⁻¹) := by rw [← hum]; ring
        _ = 0 := by rw [hp, zero_mul]
    let u₀ : S₁ˣ := (IsLocalization.Away.algebraMap_isUnit (S := S₁) (MvPolynomial.X 0 : A)).unit
    have hu₀_coe : (u₀ : S₁) = algebraMap A S₁ (MvPolynomial.X 0) := rfl
    let ξ₁ : S₁ := algebraMap A S₁ (MvPolynomial.X 1)
    let cS₁ : k →+* S₁ := (algebraMap A S₁).comp MvPolynomial.C
    let α₁ : A →+* S₁ := MvPolynomial.eval₂Hom cS₁ ![↑(u₀⁻¹), ξ₁ * ↑(u₀⁻¹)]
    have hα₁_C : ∀ r : k, α₁ (MvPolynomial.C r) = algebraMap A S₁ (MvPolynomial.C r) := by
      intro r
      change MvPolynomial.eval₂ cS₁ ![↑(u₀⁻¹), ξ₁ * ↑(u₀⁻¹)] (MvPolynomial.C r) = _
      rw [MvPolynomial.eval₂_C]
      rfl
    have hα₁_X0 : α₁ (MvPolynomial.X 0) = ↑(u₀⁻¹) := by
      change (MvPolynomial.eval₂Hom cS₁ ![↑(u₀⁻¹), ξ₁ * ↑(u₀⁻¹)]) (MvPolynomial.X 0) = _
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    have hα₁_X1 : α₁ (MvPolynomial.X 1) = ξ₁ * ↑(u₀⁻¹) := by
      change (MvPolynomial.eval₂Hom cS₁ ![↑(u₀⁻¹), ξ₁ * ↑(u₀⁻¹)]) (MvPolynomial.X 1) = _
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    have hj₁_u₀_inv : j₁ (↑(u₀⁻¹)) = 1 / x₁ := by
      have hmul : j₁ (↑(u₀⁻¹)) * x₁ = 1 := by
        change j₁ (↑(u₀⁻¹)) * ι₀ (MvPolynomial.X 0) = 1
        rw [← hj₁_eq (MvPolynomial.X 0), ← hu₀_coe, ← map_mul, Units.inv_mul, map_one]
      calc
        j₁ (↑(u₀⁻¹)) = j₁ (↑(u₀⁻¹)) * (x₁ / x₁) := by rw [div_self hx₁, mul_one]
        _ = (j₁ (↑(u₀⁻¹)) * x₁) / x₁ := by ring
        _ = 1 / x₁ := by rw [hmul]
    have hj₁_α₁ : j₁.comp α₁ = (φ_K 1).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change j₁ (α₁ (MvPolynomial.C r)) = (φ_K 1) (algebraMap k A r)
        rw [hα₁_C, hj₁_eq]
        change ι₀ (algebraMap k A r) = (φ_K 1) (algebraMap k A r)
        rw [AlgHom.commutes, AlgHom.commutes]
      · refine fin2_all ?_ ?_
        · change j₁ (α₁ (MvPolynomial.X 0)) = φ_K 1 (MvPolynomial.X 0)
          rw [hα₁_X0, hj₁_u₀_inv, hφ1_X0]
        · change j₁ (α₁ (MvPolynomial.X 1)) = φ_K 1 (MvPolynomial.X 1)
          rw [hα₁_X1, map_mul, hj₁_eq (MvPolynomial.X 1), hj₁_u₀_inv]
          change x₂ * (1 / x₁) = φ_K 1 (MvPolynomial.X 1)
          rw [hφ1_X1]
          ring
    have hα₁_unit : IsUnit (α₁ (MvPolynomial.X 0)) := hα₁_X0 ▸ (u₀⁻¹).isUnit
    let α₁_lift : S₁ →+* S₁ := IsLocalization.Away.lift (MvPolynomial.X 0 : A) hα₁_unit
    have hα₁_lift_eq : ∀ a : A, α₁_lift (algebraMap A S₁ a) = α₁ a :=
      IsLocalization.Away.lift_eq (S := S₁) (MvPolynomial.X 0 : A) hα₁_unit
    have hα₁_lift_inv : α₁_lift (↑(u₀⁻¹)) = ↑u₀ := by
      have h0 : α₁_lift (↑u₀) = ↑(u₀⁻¹) := by
        rw [hu₀_coe, hα₁_lift_eq, hα₁_X0]
      have hmul : α₁_lift (↑(u₀⁻¹)) * ↑(u₀⁻¹) = 1 := by
        calc
          α₁_lift (↑(u₀⁻¹)) * ↑(u₀⁻¹) = α₁_lift (↑(u₀⁻¹)) * α₁_lift (↑u₀) := by rw [h0]
          _ = α₁_lift (↑(u₀⁻¹) * ↑u₀) := (map_mul α₁_lift _ _).symm
          _ = 1 := by rw [Units.inv_mul, map_one]
      calc
        α₁_lift (↑(u₀⁻¹)) = α₁_lift (↑(u₀⁻¹)) * (↑(u₀⁻¹) * ↑u₀) := by rw [Units.inv_mul, mul_one]
        _ = (α₁_lift (↑(u₀⁻¹)) * ↑(u₀⁻¹)) * ↑u₀ := by ring
        _ = ↑u₀ := by rw [hmul, one_mul]
    have hα₁_comp : α₁_lift.comp α₁ = algebraMap A S₁ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change α₁_lift (α₁ (MvPolynomial.C r)) = algebraMap A S₁ (MvPolynomial.C r)
        rw [hα₁_C, hα₁_lift_eq, hα₁_C]
      · refine fin2_all ?_ ?_
        · change α₁_lift (α₁ (MvPolynomial.X 0)) = algebraMap A S₁ (MvPolynomial.X 0)
          rw [hα₁_X0, hα₁_lift_inv, hu₀_coe]
        · change α₁_lift (α₁ (MvPolynomial.X 1)) = algebraMap A S₁ (MvPolynomial.X 1)
          rw [hα₁_X1, map_mul, hα₁_lift_eq (MvPolynomial.X 1), hα₁_X1, hα₁_lift_inv]
          calc
            (ξ₁ * ↑(u₀⁻¹)) * ↑u₀ = ξ₁ * (↑(u₀⁻¹) * ↑u₀) := by ring
            _ = ξ₁ := by rw [Units.inv_mul, mul_one]
    have hα₁_inj : Function.Injective α₁ :=
      Function.Injective.of_comp (f := α₁_lift) (by rwa [← RingHom.coe_comp, hα₁_comp])
    let u₁ : S₂ˣ := (IsLocalization.Away.algebraMap_isUnit (S := S₂) (MvPolynomial.X 1 : A)).unit
    have hu₁_coe : (u₁ : S₂) = algebraMap A S₂ (MvPolynomial.X 1) := rfl
    let ξ₀ : S₂ := algebraMap A S₂ (MvPolynomial.X 0)
    let cS₂ : k →+* S₂ := (algebraMap A S₂).comp MvPolynomial.C
    let α₂ : A →+* S₂ := MvPolynomial.eval₂Hom cS₂ ![↑(u₁⁻¹), ξ₀ * ↑(u₁⁻¹)]
    have hα₂_C : ∀ r : k, α₂ (MvPolynomial.C r) = algebraMap A S₂ (MvPolynomial.C r) := by
      intro r
      change MvPolynomial.eval₂ cS₂ ![↑(u₁⁻¹), ξ₀ * ↑(u₁⁻¹)] (MvPolynomial.C r) = _
      rw [MvPolynomial.eval₂_C]
      rfl
    have hα₂_X0 : α₂ (MvPolynomial.X 0) = ↑(u₁⁻¹) := by
      change (MvPolynomial.eval₂Hom cS₂ ![↑(u₁⁻¹), ξ₀ * ↑(u₁⁻¹)]) (MvPolynomial.X 0) = _
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    have hα₂_X1 : α₂ (MvPolynomial.X 1) = ξ₀ * ↑(u₁⁻¹) := by
      change (MvPolynomial.eval₂Hom cS₂ ![↑(u₁⁻¹), ξ₀ * ↑(u₁⁻¹)]) (MvPolynomial.X 1) = _
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    have hj₂_u₁_inv : j₂ (↑(u₁⁻¹)) = 1 / x₂ := by
      have hmul : j₂ (↑(u₁⁻¹)) * x₂ = 1 := by
        change j₂ (↑(u₁⁻¹)) * ι₀ (MvPolynomial.X 1) = 1
        rw [← hj₂_eq (MvPolynomial.X 1), ← hu₁_coe, ← map_mul, Units.inv_mul, map_one]
      calc
        j₂ (↑(u₁⁻¹)) = j₂ (↑(u₁⁻¹)) * (x₂ / x₂) := by rw [div_self hx₂, mul_one]
        _ = (j₂ (↑(u₁⁻¹)) * x₂) / x₂ := by ring
        _ = 1 / x₂ := by rw [hmul]
    have hj₂_α₂ : j₂.comp α₂ = (φ_K 2).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change j₂ (α₂ (MvPolynomial.C r)) = (φ_K 2) (algebraMap k A r)
        rw [hα₂_C, hj₂_eq]
        change ι₀ (algebraMap k A r) = (φ_K 2) (algebraMap k A r)
        rw [AlgHom.commutes, AlgHom.commutes]
      · refine fin2_all ?_ ?_
        · change j₂ (α₂ (MvPolynomial.X 0)) = φ_K 2 (MvPolynomial.X 0)
          rw [hα₂_X0, hj₂_u₁_inv, hφ2_X0]
        · change j₂ (α₂ (MvPolynomial.X 1)) = φ_K 2 (MvPolynomial.X 1)
          rw [hα₂_X1, map_mul, hj₂_eq (MvPolynomial.X 0), hj₂_u₁_inv]
          change x₁ * (1 / x₂) = φ_K 2 (MvPolynomial.X 1)
          rw [hφ2_X1]
          ring
    let β₂ : A →+* S₁ := MvPolynomial.eval₂Hom cS₁ ![ξ₁ * ↑(u₀⁻¹), ↑(u₀⁻¹)]
    have hβ₂_C : ∀ r : k, β₂ (MvPolynomial.C r) = algebraMap A S₁ (MvPolynomial.C r) := by
      intro r
      change MvPolynomial.eval₂ cS₁ ![ξ₁ * ↑(u₀⁻¹), ↑(u₀⁻¹)] (MvPolynomial.C r) = _
      rw [MvPolynomial.eval₂_C]
      rfl
    have hβ₂_X0 : β₂ (MvPolynomial.X 0) = ξ₁ * ↑(u₀⁻¹) := by
      change (MvPolynomial.eval₂Hom cS₁ ![ξ₁ * ↑(u₀⁻¹), ↑(u₀⁻¹)]) (MvPolynomial.X 0) = _
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    have hβ₂_X1 : β₂ (MvPolynomial.X 1) = ↑(u₀⁻¹) := by
      change (MvPolynomial.eval₂Hom cS₁ ![ξ₁ * ↑(u₀⁻¹), ↑(u₀⁻¹)]) (MvPolynomial.X 1) = _
      rw [MvPolynomial.eval₂Hom_X']
      rfl
    have hβ₂_unit : IsUnit (β₂ (MvPolynomial.X 1)) := hβ₂_X1 ▸ (u₀⁻¹).isUnit
    let β₂_lift : S₂ →+* S₁ := IsLocalization.Away.lift (MvPolynomial.X 1 : A) hβ₂_unit
    have hβ₂_lift_eq : ∀ a : A, β₂_lift (algebraMap A S₂ a) = β₂ a :=
      IsLocalization.Away.lift_eq (S := S₂) (MvPolynomial.X 1 : A) hβ₂_unit
    have hβ₂_lift_inv : β₂_lift (↑(u₁⁻¹)) = ↑u₀ := by
      have h0 : β₂_lift (↑u₁) = ↑(u₀⁻¹) := by
        rw [hu₁_coe, hβ₂_lift_eq, hβ₂_X1]
      have hmul : β₂_lift (↑(u₁⁻¹)) * ↑(u₀⁻¹) = 1 := by
        rw [← h0, ← map_mul, Units.inv_mul, map_one]
      calc
        β₂_lift (↑(u₁⁻¹)) = β₂_lift (↑(u₁⁻¹)) * (↑(u₀⁻¹) * ↑u₀) := by rw [Units.inv_mul, mul_one]
        _ = (β₂_lift (↑(u₁⁻¹)) * ↑(u₀⁻¹)) * ↑u₀ := by ring
        _ = ↑u₀ := by rw [hmul, one_mul]
    have hβ₂_comp : β₂_lift.comp α₂ = algebraMap A S₁ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        change β₂_lift (α₂ (MvPolynomial.C r)) = algebraMap A S₁ (MvPolynomial.C r)
        rw [hα₂_C, hβ₂_lift_eq, hβ₂_C]
      · refine fin2_all ?_ ?_
        · change β₂_lift (α₂ (MvPolynomial.X 0)) = algebraMap A S₁ (MvPolynomial.X 0)
          rw [hα₂_X0, hβ₂_lift_inv, hu₀_coe]
        · change β₂_lift (α₂ (MvPolynomial.X 1)) = algebraMap A S₁ (MvPolynomial.X 1)
          rw [hα₂_X1, map_mul, hβ₂_lift_eq (MvPolynomial.X 0), hβ₂_X0, hβ₂_lift_inv]
          calc
            (ξ₁ * ↑(u₀⁻¹)) * ↑u₀ = ξ₁ * (↑(u₀⁻¹) * ↑u₀) := by ring
            _ = ξ₁ := by rw [Units.inv_mul, mul_one]
    have hα₂_inj : Function.Injective α₂ :=
      Function.Injective.of_comp (f := β₂_lift) (by rwa [← RingHom.coe_comp, hβ₂_comp])
    refine fin3_all ?_ ?_ ?_
    · rw [hφ0_eq]
      exact hι₀_inj
    · change Function.Injective (φ_K 1).toRingHom
      rw [← hj₁_α₁]
      exact hj₁_inj.comp hα₁_inj
    · change Function.Injective (φ_K 2).toRingHom
      rw [← hj₂_α₂]
      exact hj₂_inj.comp hα₂_inj

  have hRatio : ∀ c c' : Fin 3, ∃ u_cc' : A, φ_K c u_cc' = homCoord c' / homCoord c := by
    refine fin3_all (fin3_all ?_ ?_ ?_) (fin3_all ?_ ?_ ?_) (fin3_all ?_ ?_ ?_)
    · exact ⟨1, by rw [map_one, hHom0, div_one]⟩
    · exact ⟨MvPolynomial.X 0, by rw [hφ0_X0, hHom1, hHom0, div_one]⟩
    · exact ⟨MvPolynomial.X 1, by rw [hφ0_X1, hHom2, hHom0, div_one]⟩
    · exact ⟨MvPolynomial.X 0, by rw [hφ1_X0, hHom0, hHom1]⟩
    · exact ⟨1, by rw [map_one, div_self (hHom_ne 1)]⟩
    · exact ⟨MvPolynomial.X 1, by rw [hφ1_X1, hHom2, hHom1]⟩
    · exact ⟨MvPolynomial.X 0, by rw [hφ2_X0, hHom0, hHom2]⟩
    · exact ⟨MvPolynomial.X 1, by rw [hφ2_X1, hHom1, hHom2]⟩
    · exact ⟨1, by rw [map_one, div_self (hHom_ne 2)]⟩

  have hPoly_clear : ∀ (c c' : Fin 3) (a : A),
      ∃ (N : ℕ) (b : A), φ_K c' a * (homCoord c' / homCoord c) ^ N = φ_K c b := by
    intro c c' a
    obtain ⟨u_t, hu_t⟩ := hRatio c c'
    induction a using MvPolynomial.induction_on with
    | C r =>
      refine ⟨0, MvPolynomial.C r, ?_⟩
      rw [pow_zero, mul_one]
      change (φ_K c') (algebraMap k A r) = (φ_K c) (algebraMap k A r)
      rw [AlgHom.commutes, AlgHom.commutes]
    | add p q ihp ihq =>
      obtain ⟨N₁, b₁, hb₁⟩ := ihp
      obtain ⟨N₂, b₂, hb₂⟩ := ihq
      refine ⟨N₁ + N₂, b₁ * u_t ^ N₂ + b₂ * u_t ^ N₁, ?_⟩
      calc
        φ_K c' (p + q) * (homCoord c' / homCoord c) ^ (N₁ + N₂)
            = (φ_K c' p * (homCoord c' / homCoord c) ^ N₁) * (homCoord c' / homCoord c) ^ N₂ +
              (φ_K c' q * (homCoord c' / homCoord c) ^ N₂) * (homCoord c' / homCoord c) ^ N₁ := by
          rw [map_add, pow_add]
          ring
        _ = φ_K c b₁ * (φ_K c u_t) ^ N₂ + φ_K c b₂ * (φ_K c u_t) ^ N₁ := by
          rw [hb₁, hb₂, hu_t]
        _ = φ_K c (b₁ * u_t ^ N₂ + b₂ * u_t ^ N₁) := by
          simp only [map_add, map_mul, map_pow]
    | mul_X p j ihp =>
      obtain ⟨N₁, b₁, hb₁⟩ := ihp
      obtain ⟨v_j, hv_j⟩ := hRatio c (c'.succAbove j)
      refine ⟨N₁ + 1, b₁ * v_j, ?_⟩
      have hXj : φ_K c' (MvPolynomial.X j) * (homCoord c' / homCoord c) =
          homCoord (c'.succAbove j) / homCoord c := by
        dsimp [φ_K]
        rw [MvPolynomial.aeval_X]
        have hc'_ne : homCoord c' ≠ 0 := hHom_ne c'
        calc
          (homCoord (c'.succAbove j) / homCoord c') * (homCoord c' / homCoord c)
              = ((homCoord (c'.succAbove j) / homCoord c') * homCoord c') / homCoord c := by ring
          _ = homCoord (c'.succAbove j) / homCoord c := by rw [div_mul_cancel₀ _ hc'_ne]
      calc
        φ_K c' (p * MvPolynomial.X j) * (homCoord c' / homCoord c) ^ (N₁ + 1)
            = (φ_K c' p * (homCoord c' / homCoord c) ^ N₁) *
              (φ_K c' (MvPolynomial.X j) * (homCoord c' / homCoord c)) := by
          rw [map_mul, pow_succ]
          ring
        _ = φ_K c b₁ * φ_K c v_j := by rw [hb₁, hXj, hv_j]
        _ = φ_K c (b₁ * v_j) := (map_mul (φ_K c) b₁ v_j).symm

  have hFrac_c : ∀ c : Fin 3, @IsFractionRing A _ K _ (φ_K c).toRingHom.toAlgebra := by
    intro c
    letI : Algebra A K := (φ_K c).toRingHom.toAlgebra
    refine ⟨⟨?_, ?_, ?_⟩⟩
    · intro y
      have hy : (y : A) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hmap_ne : φ_K c (y : A) ≠ 0 := by
        intro h0
        exact hy ((hφ_inj c) (h0.trans (map_zero (φ_K c)).symm))
      exact IsUnit.mk0 (φ_K c (y : A)) hmap_ne
    · intro z
      obtain ⟨a₀, b₀, hb₀_ne, hz₀⟩ := hι₀_surj z
      rw [← hφ0_eq] at hz₀
      obtain ⟨u_c, hu_c⟩ := hRatio c 0
      obtain ⟨N_a, a_tilde, ha_clear⟩ := hPoly_clear c 0 a₀
      obtain ⟨N_b, b_tilde, hb_clear⟩ := hPoly_clear c 0 b₀
      let a_c : A := a_tilde * u_c ^ N_b
      let b_c : A := b_tilde * u_c ^ N_a
      have ht_ne : homCoord 0 / homCoord c ≠ 0 := div_ne_zero (hHom_ne 0) (hHom_ne c)
      have hb₀_map_ne : φ_K 0 b₀ ≠ 0 := by
        intro h0
        exact hb₀_ne ((hφ_inj 0) (h0.trans (map_zero (φ_K 0)).symm))
      have hbc_map : φ_K c b_c = φ_K 0 b₀ * (homCoord 0 / homCoord c) ^ (N_b + N_a) := by
        dsimp [b_c]
        rw [map_mul, map_pow, hu_c, ← hb_clear, pow_add]
        ring
      have hbc_ne : b_c ≠ 0 := by
        intro h0
        have hmap0 : φ_K c b_c = 0 := by rw [h0, map_zero]
        rw [hbc_map] at hmap0
        exact mul_ne_zero hb₀_map_ne (pow_ne_zero _ ht_ne) hmap0
      refine ⟨⟨a_c, ⟨b_c, mem_nonZeroDivisors_of_ne_zero hbc_ne⟩⟩, ?_⟩
      change z * φ_K c b_c = φ_K c a_c
      dsimp [a_c]
      rw [hbc_map, map_mul, map_pow, hu_c, ← ha_clear]
      calc
        z * (φ_K 0 b₀ * (homCoord 0 / homCoord c) ^ (N_b + N_a))
            = (z * φ_K 0 b₀) * (homCoord 0 / homCoord c) ^ (N_b + N_a) := by ring
        _ = φ_K 0 a₀ * (homCoord 0 / homCoord c) ^ (N_b + N_a) := by rw [hz₀]
        _ = φ_K 0 a₀ * (homCoord 0 / homCoord c) ^ N_a * (homCoord 0 / homCoord c) ^ N_b := by
          rw [pow_add]
          ring
    · intro x y hxy
      have h_eq : x = y := (hφ_inj c) hxy
      exact ⟨1, by rw [h_eq]⟩

  
  have hConj2 : ∀ (d : ℕ) (H : MvPolynomial (Fin 3) k), H.IsHomogeneous d →
      ∀ c c' : Fin 3,
        φ_K c' (eval_c c' H) * (homCoord c') ^ d =
          φ_K c (eval_c c H) * (homCoord c) ^ d := by
    have hComp_eval : ∀ c : Fin 3,
        (φ_K c).comp (eval_c c) = MvPolynomial.aeval (fun r : Fin 3 => homCoord r / homCoord c) := by
      intro c
      apply MvPolynomial.algHom_ext
      intro r
      simp only [AlgHom.coe_comp, Function.comp_apply, eval_c, MvPolynomial.aeval_X]
      rw [Fin.succAbove_cases_eq_insertNth]
      by_cases hrc : r = c
      · subst hrc
        rw [Fin.insertNth_apply_same, map_one, div_self (hHom_ne r)]
      · obtain ⟨j, rfl⟩ := Fin.exists_succAbove_eq hrc
        rw [Fin.insertNth_apply_succAbove]
        dsimp [φ_K]
        rw [MvPolynomial.aeval_X]
    intro d H hHom c c'
    have hEvalH : ∀ b : Fin 3,
        φ_K b (eval_c b H) = MvPolynomial.aeval (fun r : Fin 3 => homCoord r / homCoord b) H := by
      intro b
      rw [← hComp_eval b]
      rfl
    rw [hEvalH c', hEvalH c]
    conv_lhs => rw [MvPolynomial.as_sum H]
    conv_rhs => rw [MvPolynomial.as_sum H]
    rw [map_sum, map_sum, Finset.sum_mul, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro v hv
    have hv_ne := MvPolynomial.mem_support_iff.mp hv
    have hdeg : Finsupp.degree v = d := by
      by_contra hne
      exact hv_ne (hHom.coeff_eq_zero hne)
    have hsum_v : (∑ r : Fin 3, v r) = d := by
      rw [← Finsupp.degree_eq_sum, hdeg]
    have hprod : ∀ b : Fin 3,
        (v.prod fun r e => (homCoord r / homCoord b) ^ e) * (homCoord b) ^ d =
          ∏ r : Fin 3, (homCoord r) ^ (v r) := by
      intro b
      rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), ← hsum_v, ← Finset.prod_pow_eq_pow_sum,
        ← Finset.prod_mul_distrib]
      apply Finset.prod_congr rfl
      intro r _
      rw [div_pow, div_mul_cancel₀ _ (pow_ne_zero (v r) (hHom_ne b))]
    rw [MvPolynomial.aeval_monomial, MvPolynomial.aeval_monomial, mul_assoc, mul_assoc,
      hprod c', hprod c]

  have hConj3 : ∀ c : Fin 3,
      letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
      let B₂_c := integralClosure A L
      Module.Finite A ↥B₂_c ∧
      IsNoetherianRing ↥B₂_c ∧
      (∀ a h : A,
        algebraMap A ↥B₂_c a ∈ Ideal.span {algebraMap A ↥B₂_c h} ↔
          a ∈ Ideal.span {h}) := by
    intro c
    letI : Algebra A K := (φ_K c).toRingHom.toAlgebra
    letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
    haveI : IsScalarTower A K L := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsFractionRing A K := hFrac_c c
    haveI : Algebra.IsSeparable K L := IsGalois.to_isSeparable
    let B₂_c := integralClosure A L
    have hFin : Module.Finite A ↥B₂_c := IsIntegralClosure.finite A K L ↥B₂_c
    have hNoeth : IsNoetherianRing ↥B₂_c := IsIntegralClosure.isNoetherianRing A K L ↥B₂_c
    refine ⟨hFin, hNoeth, ?_⟩
    intro a h
    rw [Ideal.mem_span_singleton, Ideal.mem_span_singleton]
    constructor
    · rintro ⟨z, hz⟩
      have hL : algebraMap K L (φ_K c a) = algebraMap K L (φ_K c h) * (z : L) :=
        congrArg Subtype.val hz
      by_cases hh : h = 0
      · subst hh
        rw [map_zero, map_zero, zero_mul] at hL
        have hφa : φ_K c a = 0 :=
          (algebraMap K L).injective (hL.trans (map_zero (algebraMap K L)).symm)
        have ha0 : a = 0 := (hφ_inj c) (hφa.trans (map_zero (φ_K c)).symm)
        exact ⟨0, by rw [ha0, zero_mul]⟩
      · have hφh_ne : φ_K c h ≠ 0 := by
          intro h0
          exact hh ((hφ_inj c) (h0.trans (map_zero (φ_K c)).symm))
        have hLh_ne : algebraMap K L (φ_K c h) ≠ 0 := by
          intro h0
          exact hφh_ne ((algebraMap K L).injective (h0.trans (map_zero (algebraMap K L)).symm))
        have hz_eq : (z : L) = IsScalarTower.toAlgHom A K L (φ_K c a / φ_K c h) := by
          change (z : L) = algebraMap K L (φ_K c a / φ_K c h)
          rw [map_div₀]
          calc
            (z : L) = (algebraMap K L (φ_K c h) * (z : L)) / algebraMap K L (φ_K c h) := by
              rw [mul_div_cancel_left₀ _ hLh_ne]
            _ = algebraMap K L (φ_K c a) / algebraMap K L (φ_K c h) := by rw [← hL]
        have hz_int_L : IsIntegral A (IsScalarTower.toAlgHom A K L (φ_K c a / φ_K c h)) := by
          rw [← hz_eq]
          exact z.2
        have h_int_K : IsIntegral A (φ_K c a / φ_K c h) :=
          (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K L) (algebraMap K L).injective).mp
            hz_int_L
        obtain ⟨q, hq⟩ := IsIntegrallyClosed.isIntegral_iff.mp h_int_K
        have hφ_hq : φ_K c (h * q) = φ_K c a := by
          rw [map_mul]
          change φ_K c h * algebraMap A K q = φ_K c a
          rw [hq, mul_div_cancel₀ _ hφh_ne]
        exact ⟨q, (hφ_inj c) hφ_hq.symm⟩
    · rintro ⟨q, rfl⟩
      exact ⟨algebraMap A ↥B₂_c q, map_mul (algebraMap A ↥B₂_c) h q⟩

  
  have hInt_clear : ∀ (c c' : Fin 3) (z : L),
      (letI : Algebra A L := ((algebraMap K L).comp (φ_K c').toRingHom).toAlgebra
       IsIntegral A z) →
      letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
      ∃ (m : ℕ) (z_c : ↥(integralClosure A L)),
        (z_c : L) = z * (algebraMap K L (homCoord c' / homCoord c)) ^ m := by
    intro c c' z hz
    let f_c' : A →+* L := (algebraMap K L).comp (φ_K c').toRingHom
    let f_c : A →+* L := (algebraMap K L).comp (φ_K c).toRingHom
    obtain ⟨p, hp_monic, hp_eval⟩ : ∃ p : Polynomial A, p.Monic ∧ Polynomial.eval₂ f_c' z p = 0 :=
      hz
    let r : ℕ := p.natDegree
    let t : K := homCoord c' / homCoord c
    let τ : L := algebraMap K L t
    obtain ⟨u_c, hu_c⟩ := hRatio c c'
    have h_choice : ∀ i : Fin r, ∃ N : ℕ, ∃ b : A, φ_K c' (p.coeff i) * t ^ N = φ_K c b :=
      fun i => hPoly_clear c c' (p.coeff i)
    let N : Fin r → ℕ := fun i => Classical.choose (h_choice i)
    let b : Fin r → A := fun i => Classical.choose (Classical.choose_spec (h_choice i))
    have hb : ∀ i : Fin r, φ_K c' (p.coeff i) * t ^ (N i) = φ_K c (b i) :=
      fun i => Classical.choose_spec (Classical.choose_spec (h_choice i))
    let m : ℕ := Finset.univ.sup N
    have hNi_le : ∀ i : Fin r, N i ≤ (r - (i : ℕ)) * m := by
      intro i
      have h1 : N i ≤ m := Finset.le_sup (Finset.mem_univ i)
      have h2 : 1 ≤ r - (i : ℕ) := by
        have hi : (i : ℕ) < r := i.2
        omega
      calc
        N i ≤ 1 * m := by rw [one_mul]; exact h1
        _ ≤ (r - (i : ℕ)) * m := Nat.mul_le_mul_right m h2
    let c_coeff : Fin r → A := fun i => b i * u_c ^ ((r - (i : ℕ)) * m - N i)
    have hc_coeff : ∀ i : Fin r,
        f_c (c_coeff i) = f_c' (p.coeff i) * τ ^ ((r - (i : ℕ)) * m) := by
      intro i
      have hK : φ_K c (c_coeff i) = φ_K c' (p.coeff i) * t ^ ((r - (i : ℕ)) * m) := by
        dsimp [c_coeff]
        rw [map_mul, map_pow, hu_c, ← hb i, mul_assoc, ← pow_add, Nat.add_sub_of_le (hNi_le i)]
      change algebraMap K L (φ_K c (c_coeff i)) =
        algebraMap K L (φ_K c' (p.coeff i)) * (algebraMap K L t) ^ ((r - (i : ℕ)) * m)
      rw [hK, map_mul, map_pow]
    let q : Polynomial A :=
      Polynomial.X ^ r + ∑ i : Fin r, Polynomial.C (c_coeff i) * Polynomial.X ^ (i : ℕ)
    have hq_monic : q.Monic :=
      Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt c_coeff)
    have hp_sum : Polynomial.eval₂ f_c' z p =
        z ^ r + ∑ i : Fin r, f_c' (p.coeff i) * z ^ (i : ℕ) := by
      conv_lhs => rw [Polynomial.Monic.as_sum hp_monic]
      rw [← Fin.sum_univ_eq_sum_range (fun j => Polynomial.C (p.coeff j) * Polynomial.X ^ j) r]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
    have hq_eval : Polynomial.eval₂ f_c (z * τ ^ m) q = 0 := by
      dsimp [q]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finset_sum]
      have hlead : (z * τ ^ m) ^ r = z ^ r * τ ^ (r * m) := by
        rw [mul_pow, ← pow_mul, mul_comm m r]
      have hsum_eq :
          (∑ i : Fin r, Polynomial.eval₂ f_c (z * τ ^ m)
              (Polynomial.C (c_coeff i) * Polynomial.X ^ (i : ℕ))) =
            (∑ i : Fin r, f_c' (p.coeff i) * z ^ (i : ℕ)) * τ ^ (r * m) := by
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro i _
        rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow, hc_coeff i,
          mul_pow, ← pow_mul]
        have hexp : (r - (i : ℕ)) * m + m * (i : ℕ) = r * m := by
          have hi : (i : ℕ) ≤ r := le_of_lt i.2
          calc
            (r - (i : ℕ)) * m + m * (i : ℕ) = ((r - (i : ℕ)) + (i : ℕ)) * m := by ring
            _ = r * m := by rw [Nat.sub_add_cancel hi]
        calc
          (f_c' (p.coeff i) * τ ^ ((r - (i : ℕ)) * m)) * (z ^ (i : ℕ) * τ ^ (m * (i : ℕ)))
              = (f_c' (p.coeff i) * z ^ (i : ℕ)) *
                (τ ^ ((r - (i : ℕ)) * m) * τ ^ (m * (i : ℕ))) := by ring
          _ = (f_c' (p.coeff i) * z ^ (i : ℕ)) * τ ^ (r * m) := by rw [← pow_add, hexp]
      rw [hlead, hsum_eq, ← add_mul, ← hp_sum, hp_eval, zero_mul]
    letI : Algebra A L := f_c.toAlgebra
    exact ⟨m, ⟨z * τ ^ m, ⟨q, hq_monic, hq_eval⟩⟩, rfl⟩

  have hConj5 :
      (∀ z₂ : L,
          (letI : Algebra A L := ((algebraMap K L).comp (φ_K 2).toRingHom).toAlgebra
           IsIntegral A z₂) →
          letI : Algebra A L := ((algebraMap K L).comp (φ_K 1).toRingHom).toAlgebra
          ∃ (k_pow : ℕ) (z₁ : ↥(integralClosure A L)),
            (z₁ : L) = z₂ * (algebraMap K L (φ_K 1 (MvPolynomial.X 1))) ^ k_pow) ∧
      (∀ (c c' : Fin 3) (z : L),
          (letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
           IsIntegral A z) →
          ∀ g' : A,
            let R_ov : Subalgebra k K := (φ_K c).range ⊔ (φ_K c').range
            letI : Algebra ↥R_ov L := ((algebraMap K L).comp R_ov.val.toRingHom).toAlgebra
            IsIntegral ↥R_ov (z * algebraMap K L (φ_K c' g'))) := by
    refine ⟨?_, ?_⟩
    · intro z₂ hz₂
      obtain ⟨k_pow, z₁, hz₁⟩ := hInt_clear 1 2 z₂ hz₂
      refine ⟨k_pow, z₁, ?_⟩
      rw [hz₁, hHom2, hHom1, ← hφ1_X1]
    · intro c c' z hz g'
      let R_ov : Subalgebra k K := (φ_K c).range ⊔ (φ_K c').range
      letI : Algebra ↥R_ov L := ((algebraMap K L).comp R_ov.val.toRingHom).toAlgebra
      letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
      let ρ_c : A →+* ↥R_ov :=
        { toFun := fun a => ⟨φ_K c a, Algebra.mem_sup_left ⟨a, rfl⟩⟩
          map_one' := Subtype.ext (map_one (φ_K c))
          map_mul' := fun x y => Subtype.ext (map_mul (φ_K c) x y)
          map_zero' := Subtype.ext (map_zero (φ_K c))
          map_add' := fun x y => Subtype.ext (map_add (φ_K c) x y) }
      have hz_Rov : IsIntegral ↥R_ov z :=
        IsIntegral.map_of_comp_eq ρ_c (RingHom.id L) rfl hz
      let y' : ↥R_ov := ⟨φ_K c' g', Algebra.mem_sup_right ⟨g', rfl⟩⟩
      have hy'_Rov : IsIntegral ↥R_ov (algebraMap K L (φ_K c' g')) :=
        isIntegral_algebraMap (R := ↥R_ov) (x := y')
      exact IsIntegral.mul hz_Rov hy'_Rov

  
  have hConj4 : ∀ (d : ℕ) (H : MvPolynomial (Fin 3) k), H.IsHomogeneous d →
      ∀ (j₀ : Fin 2)
        (B_0 B_c : Type u) [CommRing B_0] [CommRing B_c]
        (q_0 : A →+* B_0) (q_c : A →+* B_c),
        let c : Fin 3 := (0 : Fin 3).succAbove j₀
        (letI : Algebra A L := ((algebraMap K L).comp (φ_K 0).toRingHom).toAlgebra
         let B₂_0 := integralClosure A L
         let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A ↥B₂_0 (eval_c 0 H)}
         ∃ e_0 : (↥B₂_0 ⧸ I_h₀) ≃+* B_0,
           ∀ g : A, e_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) = q_0 g) →
        (letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
         let B₂_c := integralClosure A L
         let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H)}
         ∃ e_c : (↥B₂_c ⧸ I_hc) ≃+* B_c,
           ∀ g : A, e_c (Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c g)) = q_c g) →
        let v0_bar : B_0 := q_0 (MvPolynomial.X j₀)
        let uc_bar : B_c := q_c (MvPolynomial.X 0)
        (∀ z₀ : L,
          (letI : Algebra A L := ((algebraMap K L).comp (φ_K 0).toRingHom).toAlgebra
           IsIntegral A z₀) →
          letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
          ∃ (m : ℕ) (z_c : ↥(integralClosure A L)),
            (z_c : L) * (algebraMap K L (homCoord c)) ^ m = z₀) ∧
        (∃ Ψ : Localization.Away v0_bar ≃+* Localization.Away uc_bar,
          (∀ c₀ : k,
            Ψ (algebraMap B_0 (Localization.Away v0_bar) (q_0 (MvPolynomial.C c₀))) =
              algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.C c₀))) ∧
          Ψ (algebraMap B_0 (Localization.Away v0_bar) v0_bar) *
            algebraMap B_c (Localization.Away uc_bar) uc_bar = 1 ∧
          Ψ (algebraMap B_0 (Localization.Away v0_bar)
              (q_0 (MvPolynomial.X (Fin.rev j₀)))) *
            algebraMap B_c (Localization.Away uc_bar) uc_bar =
            algebraMap B_c (Localization.Away uc_bar) (q_c (MvPolynomial.X 1))) := by
    intro d H hHom j₀ B_0 B_c _ _ q_0 q_c c hB0 hBc v0_bar uc_bar
    let τ_c : L := algebraMap K L (homCoord c)
    have hτ_ne : τ_c ≠ 0 := by
      intro h0
      exact (hHom_ne c) ((algebraMap K L).injective (h0.trans (map_zero (algebraMap K L)).symm))
    have hClear_0c : ∀ z₀ : L,
        (letI : Algebra A L := ((algebraMap K L).comp (φ_K 0).toRingHom).toAlgebra
         IsIntegral A z₀) →
        letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
        ∃ (m : ℕ) (z_c : ↥(integralClosure A L)),
          (z_c : L) * τ_c ^ m = z₀ := by
      intro z₀ hz₀
      obtain ⟨m, z_c, hzc⟩ := hInt_clear c 0 z₀ hz₀
      refine ⟨m, z_c, ?_⟩
      rw [hzc, hHom0]
      have hmul1 : algebraMap K L (1 / homCoord c) * τ_c = 1 := by
        dsimp [τ_c]
        rw [← map_mul, one_div_mul_cancel (hHom_ne c), map_one]
      calc
        z₀ * (algebraMap K L (1 / homCoord c)) ^ m * τ_c ^ m
            = z₀ * (algebraMap K L (1 / homCoord c) * τ_c) ^ m := by rw [mul_assoc, ← mul_pow]
        _ = z₀ := by rw [hmul1, one_pow, mul_one]
    have hClear_c0 : ∀ z_c : L,
        (letI : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
         IsIntegral A z_c) →
        letI : Algebra A L := ((algebraMap K L).comp (φ_K 0).toRingHom).toAlgebra
        ∃ (m' : ℕ) (z₀' : ↥(integralClosure A L)),
          (z₀' : L) = z_c * τ_c ^ m' := by
      intro z_c hzc
      obtain ⟨m', z₀', hz₀'⟩ := hInt_clear 0 c z_c hzc
      refine ⟨m', z₀', ?_⟩
      rwa [hHom0, div_one] at hz₀'
    refine ⟨hClear_0c, ?_⟩

    
    let alg0 : Algebra A L := ((algebraMap K L).comp (φ_K 0).toRingHom).toAlgebra
    let algc : Algebra A L := ((algebraMap K L).comp (φ_K c).toRingHom).toAlgebra
    let B₂_0 := @integralClosure A L _ _ alg0
    let B₂_c := @integralClosure A L _ _ algc
    letI instCR0 : CommRing ↥B₂_0 := (letI := alg0; inferInstance)
    letI instCRc : CommRing ↥B₂_c := (letI := algc; inferInstance)
    let map0 : A →+* ↥B₂_0 := (letI := alg0; algebraMap A ↥B₂_0)
    let mapc : A →+* ↥B₂_c := (letI := algc; algebraMap A ↥B₂_c)
    let val0 : ↥B₂_0 →+* L := (letI := alg0; B₂_0.val.toRingHom)
    let valc : ↥B₂_c →+* L := (letI := algc; B₂_c.val.toRingHom)
    have hval0_inj : Function.Injective val0 := Subtype.val_injective
    have hvalc_inj : Function.Injective valc := Subtype.val_injective
    have hval0_map : ∀ g : A, val0 (map0 g) = algebraMap K L (φ_K 0 g) := fun _ => rfl
    have hvalc_map : ∀ g : A, valc (mapc g) = algebraMap K L (φ_K c g) := fun _ => rfl

    let I_h₀ : Ideal ↥B₂_0 := Ideal.span {map0 (eval_c 0 H)}
    let I_hc : Ideal ↥B₂_c := Ideal.span {mapc (eval_c c H)}
    obtain ⟨e_0, he_0⟩ : ∃ e_0 : (↥B₂_0 ⧸ I_h₀) ≃+* B_0,
        ∀ g : A, e_0 (Ideal.Quotient.mk I_h₀ (map0 g)) = q_0 g := hB0
    obtain ⟨e_c, he_c⟩ : ∃ e_c : (↥B₂_c ⧸ I_hc) ≃+* B_c,
        ∀ g : A, e_c (Ideal.Quotient.mk I_hc (mapc g)) = q_c g := hBc
    let π_0 : ↥B₂_0 →+* B_0 := e_0.toRingHom.comp (Ideal.Quotient.mk I_h₀)
    let π_c : ↥B₂_c →+* B_c := e_c.toRingHom.comp (Ideal.Quotient.mk I_hc)
    have hπ0_map : ∀ g : A, π_0 (map0 g) = q_0 g := he_0
    have hπc_map : ∀ g : A, π_c (mapc g) = q_c g := he_c
    have hπ0_surj : Function.Surjective π_0 := e_0.surjective.comp Ideal.Quotient.mk_surjective
    have hπc_surj : Function.Surjective π_c := e_c.surjective.comp Ideal.Quotient.mk_surjective

    have hc_succ0 : c.succAbove 0 = 0 := by
      dsimp [c]
      fin_cases j₀ <;> decide
    have hc_succ1 : c.succAbove 1 = (0 : Fin 3).succAbove (Fin.rev j₀) := by
      dsimp [c]
      fin_cases j₀ <;> decide

    let v_B0 : ↥B₂_0 := map0 (MvPolynomial.X j₀)
    let u_Bc : ↥B₂_c := mapc (MvPolynomial.X 0)
    have hv_val : val0 v_B0 = τ_c := by
      dsimp [v_B0, τ_c, c]
      rw [hval0_map]
      dsimp [φ_K]
      rw [MvPolynomial.aeval_X, hHom0, div_one]
    have hu_val : valc u_Bc = algebraMap K L (1 / homCoord c) := by
      dsimp [u_Bc]
      rw [hvalc_map]
      dsimp [φ_K]
      rw [MvPolynomial.aeval_X, hc_succ0, hHom0]
    have h_tau_u : τ_c * valc u_Bc = 1 := by
      rw [hu_val]
      dsimp [τ_c]
      rw [← map_mul, mul_one_div_cancel (hHom_ne c), map_one]
    have h_u_tau : valc u_Bc * τ_c = 1 := by rw [mul_comm, h_tau_u]

    let L_0 := Localization.Away v0_bar
    let L_c := Localization.Away uc_bar
    let ι_L0 : B_0 →+* L_0 := algebraMap B_0 L_0
    let ι_Lc : B_c →+* L_c := algebraMap B_c L_c
    let U_0 : L_0ˣ := (IsLocalization.Away.algebraMap_isUnit (S := L_0) v0_bar).unit
    let U_c : L_cˣ := (IsLocalization.Away.algebraMap_isUnit (S := L_c) uc_bar).unit
    have hU0_coe : (U_0 : L_0) = ι_L0 v0_bar := rfl
    have hUc_coe : (U_c : L_c) = ι_Lc uc_bar := rfl
    have hπ0_v : π_0 v_B0 = v0_bar := hπ0_map (MvPolynomial.X j₀)
    have hπc_u : π_c u_Bc = uc_bar := hπc_map (MvPolynomial.X 0)

    
    have h_wit_0c : ∀ z₀ : ↥B₂_0, ∃ (m : ℕ) (z_c : ↥B₂_c), valc z_c * τ_c ^ m = val0 z₀ :=
      fun z₀ => hClear_0c (val0 z₀) z₀.2
    let m_wit : ↥B₂_0 → ℕ := fun z₀ => Classical.choose (h_wit_0c z₀)
    let zc_wit : ↥B₂_0 → ↥B₂_c := fun z₀ => Classical.choose (Classical.choose_spec (h_wit_0c z₀))
    have hzc_wit : ∀ z₀ : ↥B₂_0, valc (zc_wit z₀) * τ_c ^ (m_wit z₀) = val0 z₀ :=
      fun z₀ => Classical.choose_spec (Classical.choose_spec (h_wit_0c z₀))
    let f₀_fun : ↥B₂_0 → L_c := fun z₀ => ι_Lc (π_c (zc_wit z₀)) * (↑(U_c⁻¹) : L_c) ^ (m_wit z₀)
    have hf₀_eq : ∀ (z₀ : ↥B₂_0) (n : ℕ) (w_c : ↥B₂_c),
        valc w_c * τ_c ^ n = val0 z₀ →
        f₀_fun z₀ = ι_Lc (π_c w_c) * (↑(U_c⁻¹) : L_c) ^ n := by
      intro z₀ n w_c hw
      let m := m_wit z₀
      let z_c := zc_wit z₀
      have hz_eq : valc z_c * τ_c ^ m = valc w_c * τ_c ^ n := (hzc_wit z₀).trans hw.symm
      have h1m : τ_c ^ m * (valc u_Bc) ^ m = 1 := by rw [← mul_pow, h_tau_u, one_pow]
      have h1n : τ_c ^ n * (valc u_Bc) ^ n = 1 := by rw [← mul_pow, h_tau_u, one_pow]
      have h_sub_L : valc (z_c * u_Bc ^ n) = valc (w_c * u_Bc ^ m) := by
        rw [map_mul, map_pow, map_mul, map_pow]
        calc
          valc z_c * (valc u_Bc) ^ n
              = valc z_c * (τ_c ^ m * (valc u_Bc) ^ m) * (valc u_Bc) ^ n := by rw [h1m, mul_one]
          _ = (valc z_c * τ_c ^ m) * ((valc u_Bc) ^ m * (valc u_Bc) ^ n) := by ring
          _ = (valc w_c * τ_c ^ n) * ((valc u_Bc) ^ n * (valc u_Bc) ^ m) := by
            rw [hz_eq, mul_comm ((valc u_Bc) ^ m)]
          _ = valc w_c * (τ_c ^ n * (valc u_Bc) ^ n) * (valc u_Bc) ^ m := by ring
          _ = valc w_c * (valc u_Bc) ^ m := by rw [h1n, mul_one]
      have h_sub_Bc : z_c * u_Bc ^ n = w_c * u_Bc ^ m := hvalc_inj h_sub_L
      have h_Lc : ι_Lc (π_c z_c) * (U_c : L_c) ^ n = ι_Lc (π_c w_c) * (U_c : L_c) ^ m := by
        have hmap := congrArg (ι_Lc.comp π_c) h_sub_Bc
        simp only [RingHom.coe_comp, Function.comp_apply, map_mul, map_pow, hπc_u, ← hUc_coe]
          at hmap
        exact hmap
      have hUm : (U_c : L_c) ^ m * (↑(U_c⁻¹) : L_c) ^ m = 1 := by
        rw [← mul_pow, Units.mul_inv, one_pow]
      have hUn : (U_c : L_c) ^ n * (↑(U_c⁻¹) : L_c) ^ n = 1 := by
        rw [← mul_pow, Units.mul_inv, one_pow]
      dsimp [f₀_fun]
      calc
        ι_Lc (π_c z_c) * (↑(U_c⁻¹) : L_c) ^ m
            = ι_Lc (π_c z_c) * ((U_c : L_c) ^ n * (↑(U_c⁻¹) : L_c) ^ n) *
              (↑(U_c⁻¹) : L_c) ^ m := by rw [hUn, mul_one]
        _ = (ι_Lc (π_c z_c) * (U_c : L_c) ^ n) *
            ((↑(U_c⁻¹) : L_c) ^ n * (↑(U_c⁻¹) : L_c) ^ m) := by ring
        _ = (ι_Lc (π_c w_c) * (U_c : L_c) ^ m) *
            ((↑(U_c⁻¹) : L_c) ^ m * (↑(U_c⁻¹) : L_c) ^ n) := by
          rw [h_Lc, mul_comm ((↑(U_c⁻¹) : L_c) ^ n)]
        _ = ι_Lc (π_c w_c) * ((U_c : L_c) ^ m * (↑(U_c⁻¹) : L_c) ^ m) *
            (↑(U_c⁻¹) : L_c) ^ n := by ring
        _ = ι_Lc (π_c w_c) * (↑(U_c⁻¹) : L_c) ^ n := by rw [hUm, mul_one]

    let f₀ : ↥B₂_0 →+* L_c :=
      { toFun := f₀_fun
        map_one' := by
          rw [hf₀_eq 1 0 1 (by rw [map_one, pow_zero, mul_one, map_one])]
          simp
        map_mul' := fun x y => by
          have hxy : valc (zc_wit x * zc_wit y) * τ_c ^ (m_wit x + m_wit y) = val0 (x * y) := by
            rw [map_mul, pow_add, map_mul]
            calc
              (valc (zc_wit x) * valc (zc_wit y)) * (τ_c ^ m_wit x * τ_c ^ m_wit y)
                  = (valc (zc_wit x) * τ_c ^ m_wit x) * (valc (zc_wit y) * τ_c ^ m_wit y) := by
                ring
              _ = val0 x * val0 y := by rw [hzc_wit x, hzc_wit y]
          rw [hf₀_eq (x * y) (m_wit x + m_wit y) (zc_wit x * zc_wit y) hxy]
          simp only [map_mul, pow_add, f₀_fun]
          ring
        map_zero' := by
          rw [hf₀_eq 0 0 0 (by rw [map_zero, zero_mul, map_zero])]
          simp
        map_add' := fun x y => by
          let m₁ := m_wit x
          let m₂ := m_wit y
          let w₁ := zc_wit x
          let w₂ := zc_wit y
          have h1 : (valc u_Bc) ^ m₂ * τ_c ^ m₂ = 1 := by rw [← mul_pow, h_u_tau, one_pow]
          have h2 : (valc u_Bc) ^ m₁ * τ_c ^ m₁ = 1 := by rw [← mul_pow, h_u_tau, one_pow]
          have hadd : valc (w₁ * u_Bc ^ m₂ + w₂ * u_Bc ^ m₁) * τ_c ^ (m₁ + m₂) = val0 (x + y) := by
            simp only [map_add, map_mul, map_pow, pow_add]
            calc
              (valc w₁ * (valc u_Bc) ^ m₂ + valc w₂ * (valc u_Bc) ^ m₁) * (τ_c ^ m₁ * τ_c ^ m₂)
                  = (valc w₁ * τ_c ^ m₁) * ((valc u_Bc) ^ m₂ * τ_c ^ m₂) +
                    (valc w₂ * τ_c ^ m₂) * ((valc u_Bc) ^ m₁ * τ_c ^ m₁) := by ring
              _ = val0 x + val0 y := by rw [hzc_wit x, hzc_wit y, h1, h2, mul_one, mul_one]
          have hU1 : (U_c : L_c) ^ m₂ * (↑(U_c⁻¹) : L_c) ^ m₂ = 1 := by
            rw [← mul_pow, Units.mul_inv, one_pow]
          have hU2 : (U_c : L_c) ^ m₁ * (↑(U_c⁻¹) : L_c) ^ m₁ = 1 := by
            rw [← mul_pow, Units.mul_inv, one_pow]
          rw [hf₀_eq (x + y) (m₁ + m₂) (w₁ * u_Bc ^ m₂ + w₂ * u_Bc ^ m₁) hadd]
          simp only [map_add, map_mul, map_pow, hπc_u, ← hUc_coe, pow_add, f₀_fun]
          calc
            (ι_Lc (π_c w₁) * (U_c : L_c) ^ m₂ + ι_Lc (π_c w₂) * (U_c : L_c) ^ m₁) *
                ((↑(U_c⁻¹) : L_c) ^ m₁ * (↑(U_c⁻¹) : L_c) ^ m₂)
                = ι_Lc (π_c w₁) * (↑(U_c⁻¹) : L_c) ^ m₁ *
                    ((U_c : L_c) ^ m₂ * (↑(U_c⁻¹) : L_c) ^ m₂) +
                  ι_Lc (π_c w₂) * (↑(U_c⁻¹) : L_c) ^ m₂ *
                    ((U_c : L_c) ^ m₁ * (↑(U_c⁻¹) : L_c) ^ m₁) := by ring
            _ = ι_Lc (π_c w₁) * (↑(U_c⁻¹) : L_c) ^ m₁ +
                ι_Lc (π_c w₂) * (↑(U_c⁻¹) : L_c) ^ m₂ := by rw [hU1, hU2, mul_one, mul_one] }

    have hScale_H : valc (mapc (eval_c c H)) * τ_c ^ d = val0 (map0 (eval_c 0 H)) := by
      dsimp [τ_c]
      rw [hvalc_map, hval0_map, ← map_pow, ← map_mul]
      congr 1
      have hsc := hConj2 d H hHom 0 c
      rwa [hHom0, one_pow, mul_one] at hsc
    have hf₀_ker : ∀ x ∈ I_h₀, f₀ x = 0 := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      rcases hx with ⟨y, rfl⟩
      rw [map_mul]
      have hf₀_gen : f₀ (map0 (eval_c 0 H)) = 0 := by
        change f₀_fun (map0 (eval_c 0 H)) = 0
        rw [hf₀_eq (map0 (eval_c 0 H)) d (mapc (eval_c c H)) hScale_H]
        have hmk0 : Ideal.Quotient.mk I_hc (mapc (eval_c c H)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        have hπc0 : π_c (mapc (eval_c c H)) = 0 := by
          dsimp [π_c]
          rw [hmk0, map_zero]
        rw [hπc0, map_zero, zero_mul]
      rw [hf₀_gen, zero_mul]
    let φ_bar0 : B_0 →+* L_c := (Ideal.Quotient.lift I_h₀ f₀ hf₀_ker).comp e_0.symm.toRingHom
    have hφ_bar0_π0 : ∀ z₀ : ↥B₂_0, φ_bar0 (π_0 z₀) = f₀ z₀ := by
      intro z₀
      dsimp [φ_bar0, π_0]
      rw [RingEquiv.symm_apply_apply, Ideal.Quotient.lift_mk]
    have hφ_bar0_v : φ_bar0 v0_bar = ↑(U_c⁻¹) := by
      rw [← hπ0_v, hφ_bar0_π0]
      change f₀_fun v_B0 = ↑(U_c⁻¹)
      have hv_rel : valc 1 * τ_c ^ 1 = val0 v_B0 := by rw [map_one, one_mul, pow_one, hv_val]
      rw [hf₀_eq v_B0 1 1 hv_rel, map_one, map_one, one_mul, pow_one]
    have hφ0_unit : IsUnit (φ_bar0 v0_bar) := hφ_bar0_v ▸ (U_c⁻¹).isUnit
    let F : L_0 →+* L_c := IsLocalization.Away.lift v0_bar hφ0_unit
    have hF_eq : ∀ b : B_0, F (ι_L0 b) = φ_bar0 b :=
      IsLocalization.Away.lift_eq (S := L_0) v0_bar hφ0_unit

    
    have h_wit_c0 : ∀ z_c : ↥B₂_c, ∃ (m' : ℕ) (z₀' : ↥B₂_0), val0 z₀' = valc z_c * τ_c ^ m' :=
      fun z_c => hClear_c0 (valc z_c) z_c.2
    let m'_wit : ↥B₂_c → ℕ := fun z_c => Classical.choose (h_wit_c0 z_c)
    let z0_wit : ↥B₂_c → ↥B₂_0 := fun z_c => Classical.choose (Classical.choose_spec (h_wit_c0 z_c))
    have hz0_wit : ∀ z_c : ↥B₂_c, val0 (z0_wit z_c) = valc z_c * τ_c ^ (m'_wit z_c) :=
      fun z_c => Classical.choose_spec (Classical.choose_spec (h_wit_c0 z_c))
    let fc_fun : ↥B₂_c → L_0 := fun z_c => ι_L0 (π_0 (z0_wit z_c)) * (↑(U_0⁻¹) : L_0) ^ (m'_wit z_c)
    have hfc_eq : ∀ (z_c : ↥B₂_c) (n : ℕ) (w_0 : ↥B₂_0),
        val0 w_0 = valc z_c * τ_c ^ n →
        fc_fun z_c = ι_L0 (π_0 w_0) * (↑(U_0⁻¹) : L_0) ^ n := by
      intro z_c n w_0 hw
      let m' := m'_wit z_c
      let z_0 := z0_wit z_c
      have h_sub_L : val0 (z_0 * v_B0 ^ n) = val0 (w_0 * v_B0 ^ m') := by
        rw [map_mul, map_pow, map_mul, map_pow, hv_val, hz0_wit z_c, hw]
        ring
      have h_sub_B0 : z_0 * v_B0 ^ n = w_0 * v_B0 ^ m' := hval0_inj h_sub_L
      have h_L0 : ι_L0 (π_0 z_0) * (U_0 : L_0) ^ n = ι_L0 (π_0 w_0) * (U_0 : L_0) ^ m' := by
        have hmap := congrArg (ι_L0.comp π_0) h_sub_B0
        simp only [RingHom.coe_comp, Function.comp_apply, map_mul, map_pow, hπ0_v, ← hU0_coe]
          at hmap
        exact hmap
      have hUm : (U_0 : L_0) ^ m' * (↑(U_0⁻¹) : L_0) ^ m' = 1 := by
        rw [← mul_pow, Units.mul_inv, one_pow]
      have hUn : (U_0 : L_0) ^ n * (↑(U_0⁻¹) : L_0) ^ n = 1 := by
        rw [← mul_pow, Units.mul_inv, one_pow]
      dsimp [fc_fun]
      calc
        ι_L0 (π_0 z_0) * (↑(U_0⁻¹) : L_0) ^ m'
            = ι_L0 (π_0 z_0) * ((U_0 : L_0) ^ n * (↑(U_0⁻¹) : L_0) ^ n) *
              (↑(U_0⁻¹) : L_0) ^ m' := by rw [hUn, mul_one]
        _ = (ι_L0 (π_0 z_0) * (U_0 : L_0) ^ n) *
            ((↑(U_0⁻¹) : L_0) ^ n * (↑(U_0⁻¹) : L_0) ^ m') := by ring
        _ = (ι_L0 (π_0 w_0) * (U_0 : L_0) ^ m') *
            ((↑(U_0⁻¹) : L_0) ^ m' * (↑(U_0⁻¹) : L_0) ^ n) := by
          rw [h_L0, mul_comm ((↑(U_0⁻¹) : L_0) ^ n)]
        _ = ι_L0 (π_0 w_0) * ((U_0 : L_0) ^ m' * (↑(U_0⁻¹) : L_0) ^ m') *
            (↑(U_0⁻¹) : L_0) ^ n := by ring
        _ = ι_L0 (π_0 w_0) * (↑(U_0⁻¹) : L_0) ^ n := by rw [hUm, mul_one]

    let f_c : ↥B₂_c →+* L_0 :=
      { toFun := fc_fun
        map_one' := by
          rw [hfc_eq 1 0 1 (by rw [map_one, map_one, pow_zero, mul_one])]
          simp
        map_mul' := fun x y => by
          have hxy : val0 (z0_wit x * z0_wit y) = valc (x * y) * τ_c ^ (m'_wit x + m'_wit y) := by
            rw [map_mul, hz0_wit x, hz0_wit y, map_mul, pow_add]
            ring
          rw [hfc_eq (x * y) (m'_wit x + m'_wit y) (z0_wit x * z0_wit y) hxy]
          simp only [map_mul, pow_add, fc_fun]
          ring
        map_zero' := by
          rw [hfc_eq 0 0 0 (by rw [map_zero, map_zero, zero_mul])]
          simp
        map_add' := fun x y => by
          let m₁ := m'_wit x
          let m₂ := m'_wit y
          let w₁ := z0_wit x
          let w₂ := z0_wit y
          have hadd : val0 (w₁ * v_B0 ^ m₂ + w₂ * v_B0 ^ m₁) =
              valc (x + y) * τ_c ^ (m₁ + m₂) := by
            dsimp only [w₁, w₂]
            rw [map_add, map_mul, map_pow, map_mul, map_pow, hv_val, hz0_wit x, hz0_wit y,
              map_add, pow_add]
            ring
          have hU1 : (U_0 : L_0) ^ m₂ * (↑(U_0⁻¹) : L_0) ^ m₂ = 1 := by
            rw [← mul_pow, Units.mul_inv, one_pow]
          have hU2 : (U_0 : L_0) ^ m₁ * (↑(U_0⁻¹) : L_0) ^ m₁ = 1 := by
            rw [← mul_pow, Units.mul_inv, one_pow]
          rw [hfc_eq (x + y) (m₁ + m₂) (w₁ * v_B0 ^ m₂ + w₂ * v_B0 ^ m₁) hadd]
          simp only [map_add, map_mul, map_pow, hπ0_v, ← hU0_coe, pow_add, fc_fun]
          calc
            (ι_L0 (π_0 w₁) * (U_0 : L_0) ^ m₂ + ι_L0 (π_0 w₂) * (U_0 : L_0) ^ m₁) *
                ((↑(U_0⁻¹) : L_0) ^ m₁ * (↑(U_0⁻¹) : L_0) ^ m₂)
                = ι_L0 (π_0 w₁) * (↑(U_0⁻¹) : L_0) ^ m₁ *
                    ((U_0 : L_0) ^ m₂ * (↑(U_0⁻¹) : L_0) ^ m₂) +
                  ι_L0 (π_0 w₂) * (↑(U_0⁻¹) : L_0) ^ m₂ *
                    ((U_0 : L_0) ^ m₁ * (↑(U_0⁻¹) : L_0) ^ m₁) := by ring
            _ = ι_L0 (π_0 w₁) * (↑(U_0⁻¹) : L_0) ^ m₁ +
                ι_L0 (π_0 w₂) * (↑(U_0⁻¹) : L_0) ^ m₂ := by rw [hU1, hU2, mul_one, mul_one] }

    have hfc_ker : ∀ x ∈ I_hc, f_c x = 0 := by
      intro x hx
      rw [Ideal.mem_span_singleton] at hx
      rcases hx with ⟨y, rfl⟩
      rw [map_mul]
      have hfc_gen : f_c (mapc (eval_c c H)) = 0 := by
        change fc_fun (mapc (eval_c c H)) = 0
        rw [hfc_eq (mapc (eval_c c H)) d (map0 (eval_c 0 H)) hScale_H.symm]
        have hmk0 : Ideal.Quotient.mk I_h₀ (map0 (eval_c 0 H)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        have hπ00 : π_0 (map0 (eval_c 0 H)) = 0 := by
          dsimp [π_0]
          rw [hmk0, map_zero]
        rw [hπ00, map_zero, zero_mul]
      rw [hfc_gen, zero_mul]
    let φ_barc : B_c →+* L_0 := (Ideal.Quotient.lift I_hc f_c hfc_ker).comp e_c.symm.toRingHom
    have hφ_barc_πc : ∀ z_c : ↥B₂_c, φ_barc (π_c z_c) = f_c z_c := by
      intro z_c
      dsimp [φ_barc, π_c]
      rw [RingEquiv.symm_apply_apply, Ideal.Quotient.lift_mk]
    have hφ_barc_u : φ_barc uc_bar = ↑(U_0⁻¹) := by
      rw [← hπc_u, hφ_barc_πc]
      change fc_fun u_Bc = ↑(U_0⁻¹)
      have hu_rel : val0 1 = valc u_Bc * τ_c ^ 1 := by rw [map_one, pow_one, h_u_tau]
      rw [hfc_eq u_Bc 1 1 hu_rel, map_one, map_one, one_mul, pow_one]
    have hφc_unit : IsUnit (φ_barc uc_bar) := hφ_barc_u ▸ (U_0⁻¹).isUnit
    let G : L_c →+* L_0 := IsLocalization.Away.lift uc_bar hφc_unit
    have hG_eq : ∀ b : B_c, G (ι_Lc b) = φ_barc b :=
      IsLocalization.Away.lift_eq (S := L_c) uc_bar hφc_unit

    
    have hF_inv : F (↑(U_0⁻¹)) = ↑U_c := by
      have hmul : F (↑(U_0⁻¹)) * ↑(U_c⁻¹) = 1 := by
        rw [← hφ_bar0_v, ← hF_eq v0_bar, ← hU0_coe, ← map_mul, Units.inv_mul, map_one]
      calc
        F (↑(U_0⁻¹)) = F (↑(U_0⁻¹)) * (↑(U_c⁻¹) * ↑U_c) := by rw [Units.inv_mul, mul_one]
        _ = (F (↑(U_0⁻¹)) * ↑(U_c⁻¹)) * ↑U_c := by ring
        _ = ↑U_c := by rw [hmul, one_mul]
    have hG_inv : G (↑(U_c⁻¹)) = ↑U_0 := by
      have hmul : G (↑(U_c⁻¹)) * ↑(U_0⁻¹) = 1 := by
        rw [← hφ_barc_u, ← hG_eq uc_bar, ← hUc_coe, ← map_mul, Units.inv_mul, map_one]
      calc
        G (↑(U_c⁻¹)) = G (↑(U_c⁻¹)) * (↑(U_0⁻¹) * ↑U_0) := by rw [Units.inv_mul, mul_one]
        _ = (G (↑(U_c⁻¹)) * ↑(U_0⁻¹)) * ↑U_0 := by ring
        _ = ↑U_0 := by rw [hmul, one_mul]

    have hGF : G.comp F = RingHom.id L_0 := by
      apply IsLocalization.ringHom_ext (Submonoid.powers v0_bar)
      ext b
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply]
      obtain ⟨z₀, rfl⟩ := hπ0_surj b
      rw [hF_eq, hφ_bar0_π0]
      change G (ι_Lc (π_c (zc_wit z₀)) * (↑(U_c⁻¹) : L_c) ^ (m_wit z₀)) = ι_L0 (π_0 z₀)
      rw [map_mul, map_pow, hG_inv, hG_eq, hφ_barc_πc]
      change fc_fun (zc_wit z₀) * (U_0 : L_0) ^ (m_wit z₀) = ι_L0 (π_0 z₀)
      rw [hfc_eq (zc_wit z₀) (m_wit z₀) z₀ (hzc_wit z₀).symm]
      calc
        ι_L0 (π_0 z₀) * (↑(U_0⁻¹) : L_0) ^ (m_wit z₀) * (U_0 : L_0) ^ (m_wit z₀)
            = ι_L0 (π_0 z₀) * ((↑(U_0⁻¹) : L_0) * (U_0 : L_0)) ^ (m_wit z₀) := by
          rw [mul_assoc, ← mul_pow]
        _ = ι_L0 (π_0 z₀) := by rw [Units.inv_mul, one_pow, mul_one]

    have hFG : F.comp G = RingHom.id L_c := by
      apply IsLocalization.ringHom_ext (Submonoid.powers uc_bar)
      ext b
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply]
      obtain ⟨z_c, rfl⟩ := hπc_surj b
      rw [hG_eq, hφ_barc_πc]
      change F (ι_L0 (π_0 (z0_wit z_c)) * (↑(U_0⁻¹) : L_0) ^ (m'_wit z_c)) = ι_Lc (π_c z_c)
      rw [map_mul, map_pow, hF_inv, hF_eq, hφ_bar0_π0]
      change f₀_fun (z0_wit z_c) * (U_c : L_c) ^ (m'_wit z_c) = ι_Lc (π_c z_c)
      rw [hf₀_eq (z0_wit z_c) (m'_wit z_c) z_c (hz0_wit z_c).symm]
      calc
        ι_Lc (π_c z_c) * (↑(U_c⁻¹) : L_c) ^ (m'_wit z_c) * (U_c : L_c) ^ (m'_wit z_c)
            = ι_Lc (π_c z_c) * ((↑(U_c⁻¹) : L_c) * (U_c : L_c)) ^ (m'_wit z_c) := by
          rw [mul_assoc, ← mul_pow]
        _ = ι_Lc (π_c z_c) := by rw [Units.inv_mul, one_pow, mul_one]

    let Ψ : L_0 ≃+* L_c := RingEquiv.ofRingHom F G hFG hGF
    have hΨ_apply : ∀ x : L_0, Ψ x = F x := fun _ => rfl
    refine ⟨Ψ, ?_, ?_, ?_⟩
    · intro c₀
      rw [hΨ_apply]
      change F (ι_L0 (q_0 (MvPolynomial.C c₀))) = ι_Lc (q_c (MvPolynomial.C c₀))
      rw [← hπ0_map (MvPolynomial.C c₀), hF_eq, hφ_bar0_π0]
      change f₀_fun (map0 (MvPolynomial.C c₀)) = ι_Lc (q_c (MvPolynomial.C c₀))
      have hC_rel : valc (mapc (MvPolynomial.C c₀)) * τ_c ^ 0 =
          val0 (map0 (MvPolynomial.C c₀)) := by
        rw [pow_zero, mul_one, hvalc_map, hval0_map]
        change algebraMap K L ((φ_K c) (algebraMap k A c₀)) =
          algebraMap K L ((φ_K 0) (algebraMap k A c₀))
        rw [AlgHom.commutes, AlgHom.commutes]
      rw [hf₀_eq (map0 (MvPolynomial.C c₀)) 0 (mapc (MvPolynomial.C c₀)) hC_rel,
        pow_zero, mul_one, hπc_map]
    · rw [hΨ_apply]
      change F (ι_L0 v0_bar) * (U_c : L_c) = 1
      rw [hF_eq, hφ_bar0_v, Units.inv_mul]
    · rw [hΨ_apply]
      change F (ι_L0 (q_0 (MvPolynomial.X (Fin.rev j₀)))) * (U_c : L_c) =
        ι_Lc (q_c (MvPolynomial.X 1))
      rw [← hπ0_map (MvPolynomial.X (Fin.rev j₀)), hF_eq, hφ_bar0_π0]
      change f₀_fun (map0 (MvPolynomial.X (Fin.rev j₀))) * (U_c : L_c) =
        ι_Lc (q_c (MvPolynomial.X 1))
      have hX_rel : valc (mapc (MvPolynomial.X 1)) * τ_c ^ 1 =
          val0 (map0 (MvPolynomial.X (Fin.rev j₀))) := by
        rw [pow_one, hvalc_map, hval0_map]
        dsimp [τ_c, φ_K]
        rw [MvPolynomial.aeval_X, MvPolynomial.aeval_X, hc_succ1, hHom0, div_one,
          ← map_mul, div_mul_cancel₀ _ (hHom_ne c), Fin.succAbove_zero_apply]
      rw [hf₀_eq (map0 (MvPolynomial.X (Fin.rev j₀))) 1 (mapc (MvPolynomial.X 1)) hX_rel,
        pow_one, hπc_map, mul_assoc, Units.inv_mul, mul_one]

  exact ⟨fun c => ⟨hHom_ne c, hφ_inj c⟩, hConj2, hConj3, hConj4, hConj5⟩

theorem weil_curve_idemp_boundary_smooth_etale_dvr (k : Type u) [Field k] [IsAlgClosed k] :
    let A := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A
    let x₁ : K₂ := algebraMap A K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap A K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] A :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → A →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∀ (d_Sigma : ℕ)
      (H_Sigma F_disc_hom : MvPolynomial (Fin 3) k)
      (P₀ P₁ P₂ : Polynomial k)
      (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂],
      1 ≤ d_Sigma →
      P₀.Monic →
      (∀ (c : Fin 3) (p : Fin 2 → k),
        MvPolynomial.eval p (eval_c c H_Sigma) = 0 →
        MvPolynomial.eval p (MvPolynomial.pderiv 0 (eval_c c H_Sigma)) ≠ 0 ∨
        MvPolynomial.eval p (MvPolynomial.pderiv 1 (eval_c c H_Sigma)) ≠ 0) →
      (∀ c : Fin 3,
        (![P₀, P₁, P₂] c = 0 ∧ IsUnit (eval_c c H_Sigma)) ∨
        (![P₀, P₁, P₂] c ≠ 0 ∧
          let θ_c : A →ₐ[k] RatFunc k :=
            MvPolynomial.aeval (fun j : Fin 2 =>
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
          RingHom.ker θ_c.toRingHom = Ideal.span {eval_c c H_Sigma} ∧
          Set.range θ_c =
            { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
                Q.natDegree ≤ n * d_Sigma ∧
                f = algebraMap (Polynomial k) (RatFunc k) Q /
                  (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n })) →
      (∀ x₁' x₂' : k,
        MvPolynomial.eval ![0, x₁', x₂'] H_Sigma = 0 →
        MvPolynomial.eval ![0, x₁', x₂'] F_disc_hom = 0 →
        x₁' = 0 ∧ x₂' = 0) →
      (∀ c : Fin 3,
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        @RingHom.Etale
          (Localization.Away (eval_c c F_disc_hom))
          (Localization.Away (algebraMap A ↥B₂_c (eval_c c F_disc_hom)))
          inferInstance inferInstance
          (Localization.awayMap (algebraMap A ↥B₂_c) (eval_c c F_disc_hom))) →
      (∀ (c : Fin 3) (𝔪 : Ideal A),
        𝔪.IsMaximal →
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        ∃ (s : A) (b : Fin (Module.finrank K₂ L₂) → ↥B₂_c),
          s ∉ 𝔪 ∧
          LinearIndependent K₂ (fun i => (b i : L₂)) ∧
          ∀ z : ↥B₂_c, ∃ a : Fin (Module.finrank K₂ L₂) → A,
            algebraMap A ↥B₂_c s * z =
              ∑ i, algebraMap A ↥B₂_c (a i) * b i) →
      (∀ c : Fin 3, Function.Injective (φ_K₂ c)) →
      (∀ c : Fin 3,
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        Module.Finite A ↥(integralClosure A L₂)) →
      ∀ c : Fin 3, c ≠ 0 → ![P₀, P₁, P₂] c ≠ 0 →
        letI : Algebra A L₂ := ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure A L₂
        let I_hc : Ideal ↥B₂_c := Ideal.span {algebraMap A ↥B₂_c (eval_c c H_Sigma)}
        let uc_bar : ↥B₂_c ⧸ I_hc := Ideal.Quotient.mk I_hc (algebraMap A ↥B₂_c (MvPolynomial.X 0))
        (∀ z : ↥B₂_c ⧸ I_hc, uc_bar * z = 0 → z = 0) ∧
        (∀ (B_bar : Type u) [CommRing B_bar]
           (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
           (R_bar : Type u) [CommRing R_bar] [Algebra B_bar R_bar]
           [IsLocalization.AtPrime R_bar 𝔪_bar]
           (e_bar : (↥B₂_c ⧸ I_hc) ≃+* B_bar),
          𝔪_bar.IsMaximal →
          e_bar uc_bar ∈ 𝔪_bar →
          IsDomain R_bar ∧ IsIntegrallyClosed R_bar) :=
by
  intro A K₂ _x₁ _x₂ _homCoord eval_c φ_K₂

  
  
  
  have hNull : ∀ (B : Type u) [CommRing B] [Algebra A B] [Algebra.IsIntegral A B]
      (𝔐 : Ideal B), 𝔐.IsMaximal →
      ∃ p : Fin 2 → k, ∀ g : A, algebraMap A B g ∈ 𝔐 ↔ MvPolynomial.eval p g = 0 := by
    intro B _ _ _ 𝔐 h𝔐_max
    letI : 𝔐.IsMaximal := h𝔐_max
    let 𝔪 : Ideal A := Ideal.comap (algebraMap A B) 𝔐
    have h𝔪_max : 𝔪.IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap A B)
        (Algebra.isIntegral_def.mp inferInstance) 𝔐
    obtain ⟨p, hp⟩ := (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := 𝔪)).mp h𝔪_max
    refine ⟨p, fun g => ?_⟩
    change g ∈ 𝔪 ↔ MvPolynomial.eval p g = 0
    rw [hp, MvPolynomial.mem_vanishingIdeal_singleton_iff, MvPolynomial.aeval_eq_eval]

  
  
  
  have hDVR1D : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsNoetherianRing D] [IsLocalRing D]
      (π_D : D),
      π_D ≠ 0 →
      IsLocalRing.maximalIdeal D = Ideal.span {π_D} →
      ∀ (S : Type u) [CommRing S] [Algebra D S] [Module.Finite D S] [Algebra.Etale D S]
        (𝔫 : Ideal S) [𝔫.IsMaximal]
        (E : Type u) [CommRing E] [Algebra S E] [IsLocalization.AtPrime E 𝔫],
        let π_E := algebraMap S E (algebraMap D S π_D)
        ∃ (_ : IsDomain E) (_ : IsLocalRing E),
          IsDiscreteValuationRing E ∧ IsIntegrallyClosed E ∧
          (∀ x : E, π_E * x = 0 → x = 0) ∧
          IsLocalRing.maximalIdeal E = Ideal.span {π_E} := by
    intro D _ _ _ _ π_D hπ_ne hmax_D S _ _ _ _ 𝔫 _ E _ _ _ π_E
    letI : 𝔫.IsPrime := Ideal.IsMaximal.isPrime inferInstance
    letI hLocE : IsLocalRing E := IsLocalization.AtPrime.isLocalRing E 𝔫
    letI : Algebra D E := ((algebraMap S E).comp (algebraMap D S)).toAlgebra
    haveI : IsScalarTower D S E := IsScalarTower.of_algebraMap_eq' rfl
    have hπ_eq : π_E = algebraMap D E π_D := rfl
    haveI : Module.Flat D S := Algebra.Smooth.flat D S
    haveI : Module.Flat S E := IsLocalization.flat E 𝔫.primeCompl
    haveI : Module.Flat D E := Module.Flat.trans D S E
    haveI : Module.IsTorsionFree D E := Module.Flat.isTorsionFree
    have hπ_nzd : ∀ x : E, π_E * x = 0 → x = 0 := by
      intro x hx
      rw [hπ_eq, ← Algebra.smul_def] at hx
      exact (smul_eq_zero_iff_right hπ_ne).mp hx
    have hπE_ne : π_E ≠ 0 := by
      intro h0
      exact one_ne_zero (hπ_nzd 1 (by rw [h0, zero_mul]))
    have hπ_pow_nzd : ∀ (r : ℕ) (z : E), π_E ^ r * z = 0 → z = 0 := by
      intro r
      induction r with
      | zero =>
        intro z hz
        simpa using hz
      | succ r ih =>
        intro z hz
        rw [pow_succ, mul_assoc] at hz
        exact hπ_nzd z (ih (π_E * z) hz)
    haveI : Algebra.IsIntegral D S := Algebra.IsIntegral.of_finite D S
    have h𝔫_D_max : (Ideal.comap (algebraMap D S) 𝔫).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap D S)
        (Algebra.isIntegral_def.mp inferInstance) 𝔫
    have h𝔫_D_eq : Ideal.comap (algebraMap D S) 𝔫 = IsLocalRing.maximalIdeal D :=
      IsLocalRing.eq_maximalIdeal h𝔫_D_max
    have hunder_SE : Ideal.comap (algebraMap S E) (IsLocalRing.maximalIdeal E) = 𝔫 :=
      IsLocalization.AtPrime.under_maximalIdeal E 𝔫
    have hcomap_DE : Ideal.comap (algebraMap D E) (IsLocalRing.maximalIdeal E) =
        IsLocalRing.maximalIdeal D := by
      change Ideal.comap ((algebraMap S E).comp (algebraMap D S)) (IsLocalRing.maximalIdeal E) = _
      rw [← Ideal.comap_comap, hunder_SE, h𝔫_D_eq]
    haveI : IsLocalHom (algebraMap D E) := ⟨fun a ha => by
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal D := by
        by_contra hm_not
        exact hna (IsLocalRing.notMem_maximalIdeal.mp hm_not)
      rw [← hcomap_DE, Ideal.mem_comap] at hm
      exact IsLocalRing.notMem_maximalIdeal.mpr ha hm⟩
    haveI : IsNoetherianRing S := IsNoetherianRing.of_finite D S
    haveI : IsNoetherianRing E := IsLocalization.isNoetherianRing 𝔫.primeCompl E inferInstance
    haveI : Algebra.FormallyUnramified S E :=
      Algebra.FormallyUnramified.of_isLocalization 𝔫.primeCompl
    haveI : Algebra.FormallyUnramified D E := Algebra.FormallyUnramified.comp D S E
    haveI : Algebra.EssFiniteType S E := Algebra.EssFiniteType.of_isLocalization E 𝔫.primeCompl
    haveI : Algebra.EssFiniteType D E := Algebra.EssFiniteType.comp D S E
    have hmax_E : IsLocalRing.maximalIdeal E = Ideal.span {π_E} := by
      rw [← Algebra.FormallyUnramified.map_maximalIdeal (R := D) (S := E), hmax_D,
        Ideal.map_span, Set.image_singleton]
      rfl
    let 𝔪_E : Ideal E := IsLocalRing.maximalIdeal E
    have hKrull : (⨅ n : ℕ, 𝔪_E ^ n) = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing 𝔪_E (Ideal.IsMaximal.ne_top inferInstance)
    have hpow_E : ∀ n : ℕ, 𝔪_E ^ n = Ideal.span {π_E ^ n} := by
      intro n
      dsimp [𝔪_E]
      rw [hmax_E, Ideal.span_singleton_pow]
    have hFactor : ∀ x : E, x ≠ 0 → ∃ (m : ℕ) (u : E), IsUnit u ∧ x = u * π_E ^ m := by
      intro x hx_ne
      have hex : ∃ k : ℕ, x ∉ 𝔪_E ^ (k + 1) := by
        by_contra h_all
        push_neg at h_all
        have hx_iInf : x ∈ ⨅ n : ℕ, 𝔪_E ^ n := by
          rw [Ideal.mem_iInf]
          intro n
          cases n with
          | zero =>
            rw [pow_zero, Ideal.one_eq_top]
            exact Submodule.mem_top
          | succ k => exact h_all k
        rw [hKrull, Ideal.mem_bot] at hx_iInf
        exact hx_ne hx_iInf
      classical
      let m : ℕ := Nat.find hex
      have hm_not : x ∉ 𝔪_E ^ (m + 1) := Nat.find_spec hex
      have hm_mem : x ∈ 𝔪_E ^ m := by
        rcases Nat.eq_zero_or_pos m with hm0 | hm_pos
        · rw [hm0, pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        · obtain ⟨m', hm'⟩ : ∃ m' : ℕ, m = m' + 1 := ⟨m - 1, (Nat.sub_add_cancel hm_pos).symm⟩
          have hlt : m' < m := by omega
          have hmin := Nat.find_min hex hlt
          rw [hm']
          exact not_not.mp hmin
      rw [hpow_E m, Ideal.mem_span_singleton] at hm_mem
      obtain ⟨u, hu_eq⟩ := hm_mem
      have hx_eq : x = u * π_E ^ m := by rw [hu_eq, mul_comm]
      have hu_unit : IsUnit u := by
        apply IsLocalRing.notMem_maximalIdeal.mp
        intro hu_in
        rw [hmax_E, Ideal.mem_span_singleton] at hu_in
        obtain ⟨v, hv⟩ := hu_in
        apply hm_not
        rw [hpow_E (m + 1), Ideal.mem_span_singleton]
        refine ⟨v, ?_⟩
        rw [hx_eq, hv, pow_succ]
        ring
      exact ⟨m, u, hu_unit, hx_eq⟩
    haveI : NoZeroDivisors E := ⟨fun {x y} hxy => by
      by_contra hne
      push_neg at hne
      obtain ⟨hx, hy⟩ := hne
      obtain ⟨m, u, hu, rfl⟩ := hFactor x hx
      obtain ⟨n, v, hv, rfl⟩ := hFactor y hy
      have hprod : π_E ^ (m + n) * (u * v) = 0 := by
        calc π_E ^ (m + n) * (u * v) = (u * π_E ^ m) * (v * π_E ^ n) := by rw [pow_add]; ring
          _ = 0 := hxy
      exact (hu.mul hv).ne_zero (hπ_pow_nzd (m + n) (u * v) hprod)⟩
    letI hDomE : IsDomain E := NoZeroDivisors.to_isDomain E
    haveI hPIRE : IsPrincipalIdealRing E := ⟨fun I => by
      by_cases hI : I = ⊥
      · refine ⟨0, ?_⟩
        rw [hI, Submodule.span_zero_singleton]
      · have hex_nz : ∃ x ∈ I, x ≠ 0 := by
          by_contra hall
          push_neg at hall
          apply hI
          ext x
          simp only [Submodule.mem_bot]
          exact ⟨hall x, fun hx0 => hx0.symm ▸ I.zero_mem⟩
        obtain ⟨x₀, hx₀_I, hx₀_ne⟩ := hex_nz
        obtain ⟨m₀_wit, u₀_wit, hu₀_wit, hx₀_eq⟩ := hFactor x₀ hx₀_ne
        have hex_pow : ∃ m : ℕ, π_E ^ m ∈ I := by
          rcases hu₀_wit with ⟨u_u, rfl⟩
          refine ⟨m₀_wit, ?_⟩
          have hmem := I.mul_mem_left (↑u_u⁻¹ : E) hx₀_I
          rwa [hx₀_eq, ← mul_assoc, Units.inv_mul, one_mul] at hmem
        classical
        let m₀ : ℕ := Nat.find hex_pow
        have hm₀_mem : π_E ^ m₀ ∈ I := Nat.find_spec hex_pow
        refine ⟨π_E ^ m₀, ?_⟩
        change I = Ideal.span {π_E ^ m₀}
        apply le_antisymm
        · intro y hy
          by_cases hy0 : y = 0
          · rw [hy0]
            exact (Ideal.span {π_E ^ m₀}).zero_mem
          · obtain ⟨n, v, hv_unit, hy_eq⟩ := hFactor y hy0
            have hpow_n : π_E ^ n ∈ I := by
              rcases hv_unit with ⟨v_u, rfl⟩
              have hmem := I.mul_mem_left (↑v_u⁻¹ : E) hy
              rwa [hy_eq, ← mul_assoc, Units.inv_mul, one_mul] at hmem
            have hle : m₀ ≤ n := Nat.find_min' hex_pow hpow_n
            rw [Ideal.mem_span_singleton]
            refine ⟨v * π_E ^ (n - m₀), ?_⟩
            calc y = v * π_E ^ n := hy_eq
              _ = v * π_E ^ (m₀ + (n - m₀)) := by rw [Nat.add_sub_of_le hle]
              _ = π_E ^ m₀ * (v * π_E ^ (n - m₀)) := by rw [pow_add]; ring
        · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hm₀_mem)⟩
    have hmax_ne_bot : IsLocalRing.maximalIdeal E ≠ ⊥ := by
      intro hbot
      have hm : π_E ∈ IsLocalRing.maximalIdeal E := by
        rw [hmax_E]
        exact Ideal.mem_span_singleton_self π_E
      rw [hbot, Ideal.mem_bot] at hm
      exact hπE_ne hm
    haveI hDVRE : IsDiscreteValuationRing E := IsDiscreteValuationRing.mk hmax_ne_bot
    exact ⟨hDomE, hLocE, hDVRE, inferInstance, hπ_nzd, hmax_E⟩

  
  
  
  have hTransv : ∀ (h₀ f₀ : A),
      Irreducible h₀ →
      ∀ (p : Fin 2 → k),
        MvPolynomial.eval p h₀ = 0 →
        MvPolynomial.eval p f₀ = 0 →
        MvPolynomial.eval p (MvPolynomial.pderiv 0 f₀) *
          MvPolynomial.eval p (MvPolynomial.pderiv 1 h₀) -
        MvPolynomial.eval p (MvPolynomial.pderiv 1 f₀) *
          MvPolynomial.eval p (MvPolynomial.pderiv 0 h₀) ≠ 0 →
        ∀ (𝔪_p : Ideal A) [𝔪_p.IsMaximal],
          (∀ g : A, g ∈ 𝔪_p ↔ MvPolynomial.eval p g = 0) →
          let 𝒪_p := Localization.AtPrime 𝔪_p
          let f_p := algebraMap A 𝒪_p f₀
          let h_p := algebraMap A 𝒪_p h₀
          f_p ≠ 0 ∧ h_p ≠ 0 ∧
          (Ideal.span {h_p}).IsPrime ∧
          h_p ∉ Ideal.span {f_p} ∧ f_p ∉ Ideal.span {h_p} ∧
          IsLocalRing.maximalIdeal 𝒪_p = Ideal.span {f_p, h_p} := by
    intro h₀ f₀ hIrr_h₀ p hp_h₀ hp_f₀ hJac 𝔪_p _ h𝔪_p 𝒪_p f_p h_p
    have h_nzd : 𝔪_p.primeCompl ≤ nonZeroDivisors A := by
      intro s hs
      apply mem_nonZeroDivisors_of_ne_zero
      intro hs0
      apply hs
      change s ∈ 𝔪_p
      rw [h𝔪_p, hs0, map_zero]
    have h_inj : Function.Injective (algebraMap A 𝒪_p) :=
      IsLocalization.injective 𝒪_p h_nzd
    have hf₀_ne : f₀ ≠ 0 := by
      intro hf0
      apply hJac
      rw [hf0]
      simp
    have hfp_ne : f_p ≠ 0 := (map_ne_zero_iff (algebraMap A 𝒪_p) h_inj).mpr hf₀_ne
    have hhp_ne : h_p ≠ 0 := (map_ne_zero_iff (algebraMap A 𝒪_p) h_inj).mpr hIrr_h₀.ne_zero
    have hPrime_hp : (Ideal.span {h_p}).IsPrime := by
      have hh_prime : Prime h₀ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrr_h₀
      have hI_prime : (Ideal.span {h₀}).IsPrime :=
        (Ideal.span_singleton_prime hIrr_h₀.ne_zero).mpr hh_prime
      have hI_le : Ideal.span {h₀} ≤ 𝔪_p :=
        Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ((h𝔪_p h₀).mpr hp_h₀))
      have hDisj : Disjoint (𝔪_p.primeCompl : Set A) (Ideal.span {h₀}) :=
        Set.disjoint_left.mpr fun x hx_c hx_i => hx_c (hI_le hx_i)
      have hMap_prime : (Ideal.map (algebraMap A 𝒪_p) (Ideal.span {h₀})).IsPrime :=
        IsLocalization.isPrime_of_isPrime_disjoint 𝔪_p.primeCompl 𝒪_p (Ideal.span {h₀})
          hI_prime hDisj
      rwa [Ideal.map_span, Set.image_singleton] at hMap_prime
    let u₀ : A := MvPolynomial.X 0 - MvPolynomial.C (p 0)
    let u₁ : A := MvPolynomial.X 1 - MvPolynomial.C (p 1)
    let J_p : Ideal A := Ideal.span {u₀, u₁}
    have hu₀_J : u₀ ∈ J_p := Ideal.subset_span (Set.mem_insert u₀ {u₁})
    have hu₁_J : u₁ ∈ J_p := Ideal.subset_span (Set.mem_insert_of_mem u₀ (Set.mem_singleton u₁))
    have hu₀_p : MvPolynomial.eval p u₀ = 0 := by
      dsimp [u₀]
      rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_self]
    have hu₁_p : MvPolynomial.eval p u₁ = 0 := by
      dsimp [u₁]
      rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_self]
    have hJ_le_𝔪 : J_p ≤ 𝔪_p := by
      rw [Ideal.span_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with rfl | hx1
      · exact (h𝔪_p u₀).mpr hu₀_p
      · rw [Set.mem_singleton_iff.mp hx1]
        exact (h𝔪_p u₁).mpr hu₁_p
    let T_p : A → A := fun g =>
      MvPolynomial.C (MvPolynomial.eval p g) +
      MvPolynomial.C (MvPolynomial.eval p (MvPolynomial.pderiv 0 g)) * u₀ +
      MvPolynomial.C (MvPolynomial.eval p (MvPolynomial.pderiv 1 g)) * u₁
    have hmul_J2 : ∀ {x y : A}, x ∈ J_p → y ∈ J_p → x * y ∈ J_p ^ 2 := by
      intro x y hx hy
      rw [sq]
      exact Ideal.mul_mem_mul hx hy
    have hTaylor : ∀ g : A, g - T_p g ∈ J_p ^ 2 := by
      intro g
      induction g using MvPolynomial.induction_on with
      | C a =>
        dsimp [T_p]
        rw [MvPolynomial.eval_C, MvPolynomial.pderiv_C, MvPolynomial.pderiv_C,
          map_zero, map_zero, zero_mul, zero_mul, add_zero, add_zero, sub_self]
        exact (J_p ^ 2).zero_mem
      | add g₁ g₂ ih₁ ih₂ =>
        have heq : (g₁ + g₂) - T_p (g₁ + g₂) = (g₁ - T_p g₁) + (g₂ - T_p g₂) := by
          dsimp [T_p]
          simp only [map_add]
          ring
        rw [heq]
        exact (J_p ^ 2).add_mem ih₁ ih₂
      | mul_X q i ih =>
        let r : A := q - T_p q
        have hr_mem : r ∈ J_p ^ 2 := ih
        let c : k := MvPolynomial.eval p q
        let d₀ : k := MvPolynomial.eval p (MvPolynomial.pderiv 0 q)
        let d₁ : k := MvPolynomial.eval p (MvPolynomial.pderiv 1 q)
        have hq_eq : q = MvPolynomial.C c + MvPolynomial.C d₀ * u₀ +
            MvPolynomial.C d₁ * u₁ + r := by
          dsimp [r, T_p, c, d₀, d₁]
          ring
        fin_cases i
        · have hX₀ : (MvPolynomial.X 0 : A) = MvPolynomial.C (p 0) + u₀ := by
            dsimp [u₀]; ring
          have hev : MvPolynomial.eval p (q * MvPolynomial.X 0) = c * p 0 := by
            rw [map_mul, MvPolynomial.eval_X]
          have hpd0 : MvPolynomial.eval p (MvPolynomial.pderiv 0 (q * MvPolynomial.X 0)) =
              d₀ * p 0 + c := by
            rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self, map_add, map_mul,
              MvPolynomial.eval_X, map_mul, map_one, mul_one]
          have hpd1 : MvPolynomial.eval p (MvPolynomial.pderiv 1 (q * MvPolynomial.X 0)) =
              d₁ * p 0 := by
            rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_of_ne (by decide),
              mul_zero, add_zero, map_mul, MvPolynomial.eval_X]
          have hdiff : q * MvPolynomial.X 0 - T_p (q * MvPolynomial.X 0) =
              MvPolynomial.C d₀ * (u₀ * u₀) + MvPolynomial.C d₁ * (u₁ * u₀) +
              r * MvPolynomial.X 0 := by
            dsimp [T_p]
            rw [hev, hpd0, hpd1]
            conv_lhs => rw [hq_eq, hX₀]
            simp only [map_add, map_mul]
            ring
          change q * MvPolynomial.X 0 - T_p (q * MvPolynomial.X 0) ∈ J_p ^ 2
          rw [hdiff]
          exact (J_p ^ 2).add_mem
            ((J_p ^ 2).add_mem
              ((J_p ^ 2).mul_mem_left _ (hmul_J2 hu₀_J hu₀_J))
              ((J_p ^ 2).mul_mem_left _ (hmul_J2 hu₁_J hu₀_J)))
            ((J_p ^ 2).mul_mem_right _ hr_mem)
        · have hX₁ : (MvPolynomial.X 1 : A) = MvPolynomial.C (p 1) + u₁ := by
            dsimp [u₁]; ring
          have hev : MvPolynomial.eval p (q * MvPolynomial.X 1) = c * p 1 := by
            rw [map_mul, MvPolynomial.eval_X]
          have hpd0 : MvPolynomial.eval p (MvPolynomial.pderiv 0 (q * MvPolynomial.X 1)) =
              d₀ * p 1 := by
            rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_of_ne (by decide),
              mul_zero, add_zero, map_mul, MvPolynomial.eval_X]
          have hpd1 : MvPolynomial.eval p (MvPolynomial.pderiv 1 (q * MvPolynomial.X 1)) =
              d₁ * p 1 + c := by
            rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self, map_add, map_mul,
              MvPolynomial.eval_X, map_mul, map_one, mul_one]
          have hdiff : q * MvPolynomial.X 1 - T_p (q * MvPolynomial.X 1) =
              MvPolynomial.C d₀ * (u₀ * u₁) + MvPolynomial.C d₁ * (u₁ * u₁) +
              r * MvPolynomial.X 1 := by
            dsimp [T_p]
            rw [hev, hpd0, hpd1]
            conv_lhs => rw [hq_eq, hX₁]
            simp only [map_add, map_mul]
            ring
          change q * MvPolynomial.X 1 - T_p (q * MvPolynomial.X 1) ∈ J_p ^ 2
          rw [hdiff]
          exact (J_p ^ 2).add_mem
            ((J_p ^ 2).add_mem
              ((J_p ^ 2).mul_mem_left _ (hmul_J2 hu₀_J hu₁_J))
              ((J_p ^ 2).mul_mem_left _ (hmul_J2 hu₁_J hu₁_J)))
            ((J_p ^ 2).mul_mem_right _ hr_mem)
    have h𝔪_eq_J : 𝔪_p = J_p := by
      apply le_antisymm _ hJ_le_𝔪
      intro g hg
      have hgp : MvPolynomial.eval p g = 0 := (h𝔪_p g).mp hg
      have hTp_mem : T_p g ∈ J_p := by
        dsimp [T_p]
        rw [hgp, map_zero, zero_add]
        exact J_p.add_mem (J_p.mul_mem_left _ hu₀_J) (J_p.mul_mem_left _ hu₁_J)
      have hr_J : g - T_p g ∈ J_p := by
        have h2 := hTaylor g
        rw [sq] at h2
        exact Ideal.mul_le_right h2
      have hsum := J_p.add_mem hr_J hTp_mem
      rwa [sub_add_cancel] at hsum
    let a₀₀ : k := MvPolynomial.eval p (MvPolynomial.pderiv 0 f₀)
    let a₀₁ : k := MvPolynomial.eval p (MvPolynomial.pderiv 1 f₀)
    let a₁₀ : k := MvPolynomial.eval p (MvPolynomial.pderiv 0 h₀)
    let a₁₁ : k := MvPolynomial.eval p (MvPolynomial.pderiv 1 h₀)
    let δ : k := a₀₀ * a₁₁ - a₀₁ * a₁₀
    have hδ_ne : δ ≠ 0 := hJac
    let r_f : A := f₀ - T_p f₀
    let r_h : A := h₀ - T_p h₀
    have hrf_mem : r_f ∈ 𝔪_p ^ 2 := by rw [h𝔪_eq_J]; exact hTaylor f₀
    have hrh_mem : r_h ∈ 𝔪_p ^ 2 := by rw [h𝔪_eq_J]; exact hTaylor h₀
    have hf₀_lin : f₀ = MvPolynomial.C a₀₀ * u₀ + MvPolynomial.C a₀₁ * u₁ + r_f := by
      dsimp [r_f, T_p, a₀₀, a₀₁]
      rw [hp_f₀, map_zero, zero_add]
      ring
    have hh₀_lin : h₀ = MvPolynomial.C a₁₀ * u₀ + MvPolynomial.C a₁₁ * u₁ + r_h := by
      dsimp [r_h, T_p, a₁₀, a₁₁]
      rw [hp_h₀, map_zero, zero_add]
      ring
    have hCδ_inv : MvPolynomial.C δ⁻¹ * MvPolynomial.C δ = (1 : A) := by
      rw [← map_mul, inv_mul_cancel₀ hδ_ne, map_one]
    let L₀ : A := MvPolynomial.C δ⁻¹ * (MvPolynomial.C a₁₁ * f₀ - MvPolynomial.C a₀₁ * h₀)
    let L₁ : A := MvPolynomial.C δ⁻¹ * (MvPolynomial.C a₀₀ * h₀ - MvPolynomial.C a₁₀ * f₀)
    have hL₀_sub : L₀ - u₀ ∈ 𝔪_p ^ 2 := by
      have heq : L₀ - u₀ = MvPolynomial.C δ⁻¹ *
          (MvPolynomial.C a₁₁ * r_f - MvPolynomial.C a₀₁ * r_h) := by
        dsimp [L₀]
        rw [hf₀_lin, hh₀_lin]
        have hlin :
            MvPolynomial.C a₁₁ * (MvPolynomial.C a₀₀ * u₀ + MvPolynomial.C a₀₁ * u₁ + r_f) -
              MvPolynomial.C a₀₁ * (MvPolynomial.C a₁₀ * u₀ + MvPolynomial.C a₁₁ * u₁ + r_h) =
            MvPolynomial.C δ * u₀ + (MvPolynomial.C a₁₁ * r_f - MvPolynomial.C a₀₁ * r_h) := by
          dsimp [δ]
          simp only [map_sub, map_mul]
          ring
        rw [hlin, mul_add, ← mul_assoc, hCδ_inv, one_mul]
        ring
      rw [heq]
      exact (𝔪_p ^ 2).mul_mem_left _
        ((𝔪_p ^ 2).sub_mem ((𝔪_p ^ 2).mul_mem_left _ hrf_mem)
          ((𝔪_p ^ 2).mul_mem_left _ hrh_mem))
    have hL₁_sub : L₁ - u₁ ∈ 𝔪_p ^ 2 := by
      have heq : L₁ - u₁ = MvPolynomial.C δ⁻¹ *
          (MvPolynomial.C a₀₀ * r_h - MvPolynomial.C a₁₀ * r_f) := by
        dsimp [L₁]
        rw [hf₀_lin, hh₀_lin]
        have hlin :
            MvPolynomial.C a₀₀ * (MvPolynomial.C a₁₀ * u₀ + MvPolynomial.C a₁₁ * u₁ + r_h) -
              MvPolynomial.C a₁₀ * (MvPolynomial.C a₀₀ * u₀ + MvPolynomial.C a₀₁ * u₁ + r_f) =
            MvPolynomial.C δ * u₁ + (MvPolynomial.C a₀₀ * r_h - MvPolynomial.C a₁₀ * r_f) := by
          dsimp [δ]
          simp only [map_sub, map_mul]
          ring
        rw [hlin, mul_add, ← mul_assoc, hCδ_inv, one_mul]
        ring
      rw [heq]
      exact (𝔪_p ^ 2).mul_mem_left _
        ((𝔪_p ^ 2).sub_mem ((𝔪_p ^ 2).mul_mem_left _ hrh_mem)
          ((𝔪_p ^ 2).mul_mem_left _ hrf_mem))
    let M_𝒪 : Ideal 𝒪_p := IsLocalRing.maximalIdeal 𝒪_p
    let N_𝒪 : Ideal 𝒪_p := Ideal.span {f_p, h_p}
    have hf_N : f_p ∈ N_𝒪 := Ideal.subset_span (Set.mem_insert f_p {h_p})
    have hh_N : h_p ∈ N_𝒪 := Ideal.subset_span (Set.mem_insert_of_mem f_p (Set.mem_singleton h_p))
    have hM_map : M_𝒪 = Ideal.map (algebraMap A 𝒪_p) 𝔪_p :=
      (IsLocalization.AtPrime.map_eq_maximalIdeal 𝔪_p 𝒪_p).symm
    have hM_map_J : M_𝒪 = Ideal.map (algebraMap A 𝒪_p) J_p :=
      hM_map.trans (congrArg (Ideal.map (algebraMap A 𝒪_p)) h𝔪_eq_J)
    have hN_le_M : N_𝒪 ≤ M_𝒪 := by
      rw [hM_map, Ideal.span_le]
      intro x hx
      rcases Set.mem_insert_iff.mp hx with rfl | hx1
      · exact Ideal.mem_map_of_mem _ ((h𝔪_p f₀).mpr hp_f₀)
      · rw [Set.mem_singleton_iff.mp hx1]
        exact Ideal.mem_map_of_mem _ ((h𝔪_p h₀).mpr hp_h₀)
    have hM_sq_map : ∀ w : A, w ∈ 𝔪_p ^ 2 → algebraMap A 𝒪_p w ∈ M_𝒪 • M_𝒪 := by
      intro w hw
      have hm : algebraMap A 𝒪_p w ∈ Ideal.map (algebraMap A 𝒪_p) (𝔪_p ^ 2) :=
        Ideal.mem_map_of_mem _ hw
      rw [Ideal.map_pow, ← hM_map, sq, ← Ideal.smul_eq_mul] at hm
      exact hm
    have hL₀_N : algebraMap A 𝒪_p L₀ ∈ N_𝒪 := by
      dsimp [L₀]
      rw [map_mul, map_sub, map_mul, map_mul]
      exact N_𝒪.mul_mem_left _ (N_𝒪.sub_mem (N_𝒪.mul_mem_left _ hf_N) (N_𝒪.mul_mem_left _ hh_N))
    have hL₁_N : algebraMap A 𝒪_p L₁ ∈ N_𝒪 := by
      dsimp [L₁]
      rw [map_mul, map_sub, map_mul, map_mul]
      exact N_𝒪.mul_mem_left _ (N_𝒪.sub_mem (N_𝒪.mul_mem_left _ hh_N) (N_𝒪.mul_mem_left _ hf_N))
    have hu₀_sup : algebraMap A 𝒪_p u₀ ∈ N_𝒪 ⊔ M_𝒪 • M_𝒪 := by
      have heq : algebraMap A 𝒪_p u₀ =
          algebraMap A 𝒪_p L₀ - algebraMap A 𝒪_p (L₀ - u₀) := by
        rw [← map_sub, sub_sub_cancel]
      rw [heq]
      exact (N_𝒪 ⊔ M_𝒪 • M_𝒪).sub_mem
        (Submodule.mem_sup_left hL₀_N)
        (Submodule.mem_sup_right (hM_sq_map (L₀ - u₀) hL₀_sub))
    have hu₁_sup : algebraMap A 𝒪_p u₁ ∈ N_𝒪 ⊔ M_𝒪 • M_𝒪 := by
      have heq : algebraMap A 𝒪_p u₁ =
          algebraMap A 𝒪_p L₁ - algebraMap A 𝒪_p (L₁ - u₁) := by
        rw [← map_sub, sub_sub_cancel]
      rw [heq]
      exact (N_𝒪 ⊔ M_𝒪 • M_𝒪).sub_mem
        (Submodule.mem_sup_left hL₁_N)
        (Submodule.mem_sup_right (hM_sq_map (L₁ - u₁) hL₁_sub))
    have hM_le_sup : M_𝒪 ≤ N_𝒪 ⊔ M_𝒪 • M_𝒪 := by
      conv_lhs => rw [hM_map_J, Ideal.map_span]
      rw [Ideal.span_le]
      rintro _ ⟨x, hx, rfl⟩
      rcases Set.mem_insert_iff.mp hx with rfl | hx1
      · exact hu₀_sup
      · rw [Set.mem_singleton_iff.mp hx1]
        exact hu₁_sup
    haveI : IsNoetherianRing 𝒪_p :=
      IsLocalization.isNoetherianRing 𝔪_p.primeCompl 𝒪_p inferInstance
    have hM_fg : M_𝒪.FG := IsNoetherian.noetherian M_𝒪
    have hM_jac : M_𝒪 ≤ (⊥ : Ideal 𝒪_p).jacobson := by
      rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal 𝒪_p) bot_ne_top]
    have hmax_𝒪 : M_𝒪 = N_𝒪 :=
      le_antisymm (Submodule.le_of_le_smul_of_le_jacobson_bot hM_fg hM_jac hM_le_sup) hN_le_M
    have hh_not_f : h_p ∉ Ideal.span {f_p} := by
      intro hh_in
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hh_in
      obtain ⟨⟨q, s⟩, hqs⟩ := IsLocalization.surj 𝔪_p.primeCompl r
      have heq_𝒪 : algebraMap A 𝒪_p (s.1 * h₀) = algebraMap A 𝒪_p (f₀ * q) := by
        rw [map_mul, map_mul]
        calc algebraMap A 𝒪_p s.1 * h_p = algebraMap A 𝒪_p s.1 * (f_p * r) := by rw [hr]
          _ = f_p * (r * algebraMap A 𝒪_p s.1) := by ring
          _ = f_p * algebraMap A 𝒪_p q := by rw [hqs]
      have heq_A : s.1 * h₀ = f₀ * q := h_inj heq_𝒪
      have hd0 : MvPolynomial.eval p s.1 * a₁₀ = a₀₀ * MvPolynomial.eval p q := by
        have h := congrArg (fun g => MvPolynomial.eval p (MvPolynomial.pderiv 0 g)) heq_A
        dsimp only [a₀₀, a₁₀] at h ⊢
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add, map_add,
          map_mul, map_mul, map_mul, map_mul, hp_h₀, hp_f₀] at h
        linear_combination h
      have hd1 : MvPolynomial.eval p s.1 * a₁₁ = a₀₁ * MvPolynomial.eval p q := by
        have h := congrArg (fun g => MvPolynomial.eval p (MvPolynomial.pderiv 1 g)) heq_A
        dsimp only [a₀₁, a₁₁] at h ⊢
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add, map_add,
          map_mul, map_mul, map_mul, map_mul, hp_h₀, hp_f₀] at h
        linear_combination h
      have hsp_ne : MvPolynomial.eval p s.1 ≠ 0 := fun h0 => s.2 ((h𝔪_p s.1).mpr h0)
      have hzero : MvPolynomial.eval p s.1 * δ = 0 := by
        dsimp only [δ]
        linear_combination a₀₀ * hd1 - a₀₁ * hd0
      exact mul_ne_zero hsp_ne hδ_ne hzero
    have hf_not_h : f_p ∉ Ideal.span {h_p} := by
      intro hf_in
      obtain ⟨r, hr⟩ := Ideal.mem_span_singleton.mp hf_in
      obtain ⟨⟨q, s⟩, hqs⟩ := IsLocalization.surj 𝔪_p.primeCompl r
      have heq_𝒪 : algebraMap A 𝒪_p (s.1 * f₀) = algebraMap A 𝒪_p (h₀ * q) := by
        rw [map_mul, map_mul]
        calc algebraMap A 𝒪_p s.1 * f_p = algebraMap A 𝒪_p s.1 * (h_p * r) := by rw [hr]
          _ = h_p * (r * algebraMap A 𝒪_p s.1) := by ring
          _ = h_p * algebraMap A 𝒪_p q := by rw [hqs]
      have heq_A : s.1 * f₀ = h₀ * q := h_inj heq_𝒪
      have hd0 : MvPolynomial.eval p s.1 * a₀₀ = a₁₀ * MvPolynomial.eval p q := by
        have h := congrArg (fun g => MvPolynomial.eval p (MvPolynomial.pderiv 0 g)) heq_A
        dsimp only [a₀₀, a₁₀] at h ⊢
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add, map_add,
          map_mul, map_mul, map_mul, map_mul, hp_h₀, hp_f₀] at h
        linear_combination h
      have hd1 : MvPolynomial.eval p s.1 * a₀₁ = a₁₁ * MvPolynomial.eval p q := by
        have h := congrArg (fun g => MvPolynomial.eval p (MvPolynomial.pderiv 1 g)) heq_A
        dsimp only [a₀₁, a₁₁] at h ⊢
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add, map_add,
          map_mul, map_mul, map_mul, map_mul, hp_h₀, hp_f₀] at h
        linear_combination h
      have hsp_ne : MvPolynomial.eval p s.1 ≠ 0 := fun h0 => s.2 ((h𝔪_p s.1).mpr h0)
      have hzero : MvPolynomial.eval p s.1 * δ = 0 := by
        dsimp only [δ]
        linear_combination a₁₁ * hd0 - a₁₀ * hd1
      exact mul_ne_zero hsp_ne hδ_ne hzero
    exact ⟨hfp_ne, hhp_ne, hPrime_hp, hh_not_f, hf_not_h, hmax_𝒪⟩

  
  
  
  
  have hs2 :
      ∀ (A_r K₂_r L₂_r B_r : Type u)
        [CommRing A_r] [Field K₂_r] [Field L₂_r] [Algebra K₂_r L₂_r]
        [CommRing B_r] [Algebra A_r B_r]
        (φ : A_r →+* K₂_r) (ι : B_r →+* L₂_r) (n : ℕ),
        Function.Injective φ →
        (∀ a : A_r, ι (algebraMap A_r B_r a) = algebraMap K₂_r L₂_r (φ a)) →
        (∀ 𝔪 : Ideal A_r, 𝔪.IsMaximal →
          ∃ (s : A_r) (b : Fin n → B_r),
            s ∉ 𝔪 ∧
            LinearIndependent K₂_r (fun i => ι (b i)) ∧
            ∀ y : B_r, ∃ a : Fin n → A_r,
              algebraMap A_r B_r s * y = ∑ i, algebraMap A_r B_r (a i) * b i) →
        ∀ (h u : A_r),
          (Ideal.span {h}).IsPrime →
          u ∉ Ideal.span {h} →
          let I_h : Ideal B_r := Ideal.span {algebraMap A_r B_r h}
          let u_bar : B_r ⧸ I_h := Ideal.Quotient.mk I_h (algebraMap A_r B_r u)
          ∀ z : B_r ⧸ I_h, u_bar * z = 0 → z = 0 := by
    intro A_r K₂_r L₂_r B_r _ _ _ _ _ _ φ ι n hφ_inj hι_comm hLocFree h u hPrime hu_not_h
      I_h u_bar z huz
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
    have huy_mem : algebraMap A_r B_r u * y ∈ I_h := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_mul]
      exact huz
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp huy_mem
    let q : B_r →+* B_r ⧸ I_h := Ideal.Quotient.mk I_h
    let K_z : Ideal (B_r ⧸ I_h) :=
      LinearMap.ker (LinearMap.toSpanSingleton (B_r ⧸ I_h) (B_r ⧸ I_h) (q y))
    let J : Ideal A_r := Ideal.comap (q.comp (algebraMap A_r B_r)) K_z
    have hJ_mem : ∀ r : A_r, r ∈ J ↔ algebraMap A_r B_r r * y ∈ I_h := by
      intro r
      change q (algebraMap A_r B_r r) • q y = 0 ↔ _
      rw [smul_eq_mul]
      change Ideal.Quotient.mk I_h (algebraMap A_r B_r r) * Ideal.Quotient.mk I_h y = 0 ↔ _
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
    by_contra hz_ne
    have h1_not_J : (1 : A_r) ∉ J := by
      intro h1
      have hy_mem : y ∈ I_h := by
        have h1' := (hJ_mem 1).mp h1
        rwa [map_one, one_mul] at h1'
      exact hz_ne (Ideal.Quotient.eq_zero_iff_mem.mpr hy_mem)
    have hJ_ne_top : J ≠ ⊤ := by
      intro htop
      apply h1_not_J
      rw [htop]
      exact Submodule.mem_top
    obtain ⟨𝔪, h𝔪_max, hJ_le_𝔪⟩ := Ideal.exists_le_maximal J hJ_ne_top
    obtain ⟨s, b, hs_not_𝔪, hb_li, hspan⟩ := hLocFree 𝔪 h𝔪_max
    obtain ⟨a, ha_eq⟩ := hspan y
    obtain ⟨d, hd_eq⟩ := hspan w
    have hsum_B : ∑ i : Fin n, algebraMap A_r B_r (u * a i - h * d i) * b i = 0 := by
      have hlhs : ∑ i : Fin n, algebraMap A_r B_r (u * a i) * b i =
          algebraMap A_r B_r u * (algebraMap A_r B_r s * y) := by
        rw [ha_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, mul_assoc]
      have hrhs : ∑ i : Fin n, algebraMap A_r B_r (h * d i) * b i =
          algebraMap A_r B_r h * (algebraMap A_r B_r s * w) := by
        rw [hd_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul, mul_assoc]
      have hmid : algebraMap A_r B_r u * (algebraMap A_r B_r s * y) =
          algebraMap A_r B_r h * (algebraMap A_r B_r s * w) := by
        calc algebraMap A_r B_r u * (algebraMap A_r B_r s * y)
            = algebraMap A_r B_r s * (algebraMap A_r B_r u * y) := by ring
          _ = algebraMap A_r B_r s * (algebraMap A_r B_r h * w) := by rw [hw]
          _ = algebraMap A_r B_r h * (algebraMap A_r B_r s * w) := by ring
      have heq_sums : ∑ i : Fin n, algebraMap A_r B_r (u * a i) * b i =
          ∑ i : Fin n, algebraMap A_r B_r (h * d i) * b i := by
        rw [hlhs, hmid, hrhs]
      calc ∑ i : Fin n, algebraMap A_r B_r (u * a i - h * d i) * b i
          = ∑ i : Fin n,
              (algebraMap A_r B_r (u * a i) * b i - algebraMap A_r B_r (h * d i) * b i) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_sub, sub_mul]
        _ = (∑ i : Fin n, algebraMap A_r B_r (u * a i) * b i) -
              (∑ i : Fin n, algebraMap A_r B_r (h * d i) * b i) := Finset.sum_sub_distrib _ _
        _ = 0 := sub_eq_zero.mpr heq_sums
    have hsum_L₂ : ∑ i : Fin n, φ (u * a i - h * d i) • ι (b i) = 0 := by
      have hι0 : ι (∑ i : Fin n, algebraMap A_r B_r (u * a i - h * d i) * b i) = 0 := by
        rw [hsum_B, map_zero]
      rw [map_sum] at hι0
      rw [← hι0]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def, ← hι_comm, map_mul]
    have hcoeff_zero :=
      Fintype.linearIndependent_iff.mp hb_li (fun i => φ (u * a i - h * d i)) hsum_L₂
    have hsy_mem : algebraMap A_r B_r s * y ∈ I_h := by
      rw [ha_eq]
      refine Submodule.sum_mem I_h fun i _ => ?_
      have hφ0 : φ (u * a i - h * d i) = φ 0 := by rw [hcoeff_zero i, map_zero]
      have hua_eq : u * a i = h * d i := sub_eq_zero.mp (hφ_inj hφ0)
      have hua_mem : u * a i ∈ Ideal.span {h} :=
        Ideal.mem_span_singleton.mpr ⟨d i, hua_eq⟩
      have hai_mem : a i ∈ Ideal.span {h} :=
        (hPrime.mem_or_mem hua_mem).resolve_left hu_not_h
      obtain ⟨q_i, hqi⟩ := Ideal.mem_span_singleton.mp hai_mem
      refine Ideal.mem_span_singleton.mpr ⟨algebraMap A_r B_r q_i * b i, ?_⟩
      rw [hqi, map_mul, mul_assoc]
    exact hs_not_𝔪 (hJ_le_𝔪 ((hJ_mem s).mpr hsy_mem))

  
  
  
  have hs3 :
      let A₀ := MvPolynomial (Fin 2) k
      let eval_c₀ : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] A₀ :=
        fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
      (∀ (P₀ P₁ P₂ : Polynomial k) (c : Fin 3) (h_c : A₀),
        P₀.Monic → c ≠ 0 → ![P₀, P₁, P₂] c ≠ 0 →
        (let θ_c : A₀ →ₐ[k] RatFunc k :=
          MvPolynomial.aeval (fun j : Fin 2 =>
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
            algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
         RingHom.ker θ_c.toRingHom = Ideal.span {h_c}) →
        (Ideal.span {h_c}).IsPrime ∧ MvPolynomial.X 0 ∉ Ideal.span {h_c}) ∧
      (∀ (H_Sigma F_disc_hom : MvPolynomial (Fin 3) k),
        (∀ x₁' x₂' : k,
          MvPolynomial.eval ![0, x₁', x₂'] H_Sigma = 0 →
          MvPolynomial.eval ![0, x₁', x₂'] F_disc_hom = 0 →
          x₁' = 0 ∧ x₂' = 0) →
        ∀ (c : Fin 3) (p : Fin 2 → k),
          c ≠ 0 → p 0 = 0 →
          MvPolynomial.eval p (eval_c₀ c H_Sigma) = 0 →
          MvPolynomial.eval p (eval_c₀ c F_disc_hom) ≠ 0) ∧
      (∀ (h : A₀) (p : Fin 2 → k),
        (Ideal.span {h}).IsPrime →
        MvPolynomial.eval p h = 0 →
        (MvPolynomial.eval p (MvPolynomial.pderiv 0 h) ≠ 0 ∨
          MvPolynomial.eval p (MvPolynomial.pderiv 1 h) ≠ 0) →
        Irreducible h ∧
        ∃ t₀ : A₀,
          Irreducible t₀ ∧
          MvPolynomial.eval p t₀ = 0 ∧
          MvPolynomial.eval p (MvPolynomial.pderiv 0 t₀) *
            MvPolynomial.eval p (MvPolynomial.pderiv 1 h) -
          MvPolynomial.eval p (MvPolynomial.pderiv 1 t₀) *
            MvPolynomial.eval p (MvPolynomial.pderiv 0 h) ≠ 0) := by
    intro A₀ eval_c₀
    refine ⟨?_, ?_, ?_⟩
    · intro P₀ P₁ P₂ c h_c hP₀_mon hc_ne0 hPc_ne hker
      let θ_c : A₀ →ₐ[k] RatFunc k :=
        MvPolynomial.aeval (fun j : Fin 2 =>
          algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
          algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
      change RingHom.ker θ_c.toRingHom = Ideal.span {h_c} at hker
      have hPrime : (Ideal.span {h_c}).IsPrime := hker ▸ RingHom.ker_isPrime θ_c.toRingHom
      refine ⟨hPrime, ?_⟩
      rw [← hker, RingHom.mem_ker]
      change θ_c (MvPolynomial.X 0) ≠ 0
      dsimp only [θ_c]
      rw [MvPolynomial.aeval_X]
      have hc0 : c.succAbove 0 = 0 := by
        fin_cases c
        · exact absurd rfl hc_ne0
        · rfl
        · rfl
      rw [hc0]
      change algebraMap (Polynomial k) (RatFunc k) P₀ /
        algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c) ≠ 0
      have hinj := IsFractionRing.injective (Polynomial k) (RatFunc k)
      have hnum_ne : algebraMap (Polynomial k) (RatFunc k) P₀ ≠ 0 :=
        fun h0 => hP₀_mon.ne_zero (hinj (h0.trans (map_zero _).symm))
      have hden_ne : algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c) ≠ 0 :=
        fun h0 => hPc_ne (hinj (h0.trans (map_zero _).symm))
      exact div_ne_zero hnum_ne hden_ne
    · intro H_Sigma F_disc_hom hDisj_T0 c p hc_ne0 hp0 hp_H hp_F
      have hFin3 : ∀ x : Fin 3, x = 0 ∨ x = 1 ∨ x = 2 := by decide
      have h_eq_ins : ∀ (c₀ : Fin 3) (j₀ : Fin 2),
          Fin.succAboveCases c₀ (1 : A₀) MvPolynomial.X (c₀.succAbove j₀) =
            MvPolynomial.X j₀ := by
        intro c₀ j₀
        rw [Fin.succAbove_cases_eq_insertNth]
        exact @Fin.insertNth_apply_succAbove 2 (fun _ => A₀) c₀ 1 MvPolynomial.X j₀
      have h_eq_same : ∀ c₀ : Fin 3,
          Fin.succAboveCases c₀ (1 : A₀) MvPolynomial.X c₀ = (1 : A₀) := by
        intro c₀
        rw [Fin.succAbove_cases_eq_insertNth]
        exact @Fin.insertNth_apply_same 2 (fun _ => A₀) c₀ 1 MvPolynomial.X
      rcases hFin3 c with rfl | rfl | rfl
      · exact absurd rfl hc_ne0
      · have heval1 : ∀ G : MvPolynomial (Fin 3) k,
            MvPolynomial.eval p (eval_c₀ 1 G) = MvPolynomial.eval ![0, 1, p 1] G := by
          intro G
          change ((MvPolynomial.eval p).comp (eval_c₀ 1).toRingHom) G =
            MvPolynomial.eval ![0, 1, p 1] G
          congr 1
          apply MvPolynomial.ringHom_ext
          · intro r
            change MvPolynomial.eval p (eval_c₀ 1 (MvPolynomial.C r)) =
              MvPolynomial.eval ![0, 1, p 1] (MvPolynomial.C r)
            dsimp only [eval_c₀]
            rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
              MvPolynomial.eval_C, MvPolynomial.eval_C]
          · intro i
            change MvPolynomial.eval p (eval_c₀ 1 (MvPolynomial.X i)) =
              MvPolynomial.eval ![0, 1, p 1] (MvPolynomial.X i)
            dsimp only [eval_c₀]
            rw [MvPolynomial.aeval_X, MvPolynomial.eval_X]
            rcases hFin3 i with rfl | rfl | rfl
            · have h10 : Fin.succAboveCases (1 : Fin 3) (1 : A₀) MvPolynomial.X 0 =
                  MvPolynomial.X 0 := h_eq_ins 1 0
              rw [h10, MvPolynomial.eval_X, hp0]
              rfl
            · rw [h_eq_same 1, map_one]
              rfl
            · have h12 : Fin.succAboveCases (1 : Fin 3) (1 : A₀) MvPolynomial.X 2 =
                  MvPolynomial.X 1 := h_eq_ins 1 1
              rw [h12, MvPolynomial.eval_X]
              rfl
        rw [heval1] at hp_H hp_F
        exact one_ne_zero (hDisj_T0 1 (p 1) hp_H hp_F).1
      · have heval2 : ∀ G : MvPolynomial (Fin 3) k,
            MvPolynomial.eval p (eval_c₀ 2 G) = MvPolynomial.eval ![0, p 1, 1] G := by
          intro G
          change ((MvPolynomial.eval p).comp (eval_c₀ 2).toRingHom) G =
            MvPolynomial.eval ![0, p 1, 1] G
          congr 1
          apply MvPolynomial.ringHom_ext
          · intro r
            change MvPolynomial.eval p (eval_c₀ 2 (MvPolynomial.C r)) =
              MvPolynomial.eval ![0, p 1, 1] (MvPolynomial.C r)
            dsimp only [eval_c₀]
            rw [MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq,
              MvPolynomial.eval_C, MvPolynomial.eval_C]
          · intro i
            change MvPolynomial.eval p (eval_c₀ 2 (MvPolynomial.X i)) =
              MvPolynomial.eval ![0, p 1, 1] (MvPolynomial.X i)
            dsimp only [eval_c₀]
            rw [MvPolynomial.aeval_X, MvPolynomial.eval_X]
            rcases hFin3 i with rfl | rfl | rfl
            · have h20 : Fin.succAboveCases (2 : Fin 3) (1 : A₀) MvPolynomial.X 0 =
                  MvPolynomial.X 0 := h_eq_ins 2 0
              rw [h20, MvPolynomial.eval_X, hp0]
              rfl
            · have h21 : Fin.succAboveCases (2 : Fin 3) (1 : A₀) MvPolynomial.X 1 =
                  MvPolynomial.X 1 := h_eq_ins 2 1
              rw [h21, MvPolynomial.eval_X]
              rfl
            · rw [h_eq_same 2, map_one]
              rfl
        rw [heval2] at hp_H hp_F
        exact one_ne_zero (hDisj_T0 (p 1) 1 hp_H hp_F).2
    · intro h p hh_prime hp_h hp_sm
      have hh_ne0 : h ≠ 0 := by
        rintro rfl
        rcases hp_sm with hd0 | hd1
        · rw [map_zero, map_zero] at hd0
          exact hd0 rfl
        · rw [map_zero, map_zero] at hd1
          exact hd1 rfl
      have hIrr_h : Irreducible h :=
        ((Ideal.span_singleton_prime hh_ne0).mp hh_prime).irreducible
      have hIrrLin : ∀ (i : Fin 2) (a : k),
          Irreducible (MvPolynomial.X i - MvPolynomial.C a : A₀) := by
        intro i a
        let u : A₀ := MvPolynomial.X i - MvPolynomial.C a
        have hu_ne0 : u ≠ 0 := by
          intro hu0
          let q : Fin 2 → k := fun j => if j = i then a + 1 else 0
          have hq : MvPolynomial.eval q u = 0 := by rw [hu0, map_zero]
          dsimp only [u, q] at hq
          rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, if_pos rfl,
            add_sub_cancel_left] at hq
          exact one_ne_zero hq
        let ψ : A₀ →ₐ[k] Polynomial k :=
          MvPolynomial.aeval (fun j : Fin 2 => if j = i then Polynomial.C a else Polynomial.X)
        let σ : Polynomial k →ₐ[k] A₀ :=
          Polynomial.aeval (MvPolynomial.X (Fin.rev i))
        have hsec : ∀ g : A₀, g - σ (ψ g) ∈ Ideal.span {u} := by
          intro g
          refine MvPolynomial.induction_on
            (motive := fun g => g - σ (ψ g) ∈ Ideal.span {u}) g ?_ ?_ ?_
          · intro r
            have hC : σ (ψ (MvPolynomial.C r)) = MvPolynomial.C r := by
              dsimp only [ψ, σ]
              rw [MvPolynomial.aeval_C, Polynomial.algebraMap_eq,
                Polynomial.aeval_C, MvPolynomial.algebraMap_eq]
            rw [hC, sub_self]
            exact (Ideal.span {u}).zero_mem
          · intro g₁ g₂ ih₁ ih₂
            have hadd : (g₁ + g₂) - σ (ψ (g₁ + g₂)) = (g₁ - σ (ψ g₁)) + (g₂ - σ (ψ g₂)) := by
              rw [map_add, map_add]
              ring
            rw [hadd]
            exact (Ideal.span {u}).add_mem ih₁ ih₂
          · intro g₁ j ih
            have hmul : g₁ * MvPolynomial.X j - σ (ψ (g₁ * MvPolynomial.X j)) =
                (g₁ - σ (ψ g₁)) * MvPolynomial.X j +
                  σ (ψ g₁) * (MvPolynomial.X j - σ (ψ (MvPolynomial.X j))) := by
              rw [map_mul, map_mul]
              ring
            rw [hmul]
            apply (Ideal.span {u}).add_mem
            · exact Ideal.mul_mem_right _ _ ih
            · apply Ideal.mul_mem_left
              dsimp only [ψ, σ]
              rw [MvPolynomial.aeval_X]
              by_cases hji : j = i
              · subst hji
                rw [if_pos rfl, Polynomial.aeval_C, MvPolynomial.algebraMap_eq]
                exact Ideal.mem_span_singleton_self u
              · rw [if_neg hji, Polynomial.aeval_X]
                have hj_rev : j = Fin.rev i := by
                  fin_cases i <;> fin_cases j <;> simp_all
                rw [hj_rev, sub_self]
                exact (Ideal.span {u}).zero_mem
        have hker_ψ : RingHom.ker ψ.toRingHom = Ideal.span {u} := by
          apply le_antisymm
          · intro g hg
            rw [RingHom.mem_ker] at hg
            have hσ0 : σ (ψ g) = 0 := by
              change σ (ψ.toRingHom g) = 0
              rw [hg, map_zero]
            have hmem := hsec g
            rwa [hσ0, sub_zero] at hmem
          · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
            change ψ u = 0
            dsimp only [u, ψ]
            rw [map_sub, MvPolynomial.aeval_X, if_pos rfl, MvPolynomial.aeval_C,
              Polynomial.algebraMap_eq, sub_self]
        have hu_prime_ideal : (Ideal.span {u}).IsPrime :=
          hker_ψ ▸ RingHom.ker_isPrime ψ.toRingHom
        exact ((Ideal.span_singleton_prime hu_ne0).mp hu_prime_ideal).irreducible
      refine ⟨hIrr_h, ?_⟩
      rcases hp_sm with hd0 | hd1
      · let t₀ : A₀ := MvPolynomial.X 1 - MvPolynomial.C (p 1)
        refine ⟨t₀, hIrrLin 1 (p 1), ?_, ?_⟩
        · dsimp only [t₀]
          rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_self]
        · have hp0 : (MvPolynomial.pderiv 0) t₀ = 0 := by
            dsimp only [t₀]
            rw [map_sub, MvPolynomial.pderiv_X_of_ne (by decide), MvPolynomial.pderiv_C, sub_zero]
          have hp1 : (MvPolynomial.pderiv 1) t₀ = 1 := by
            dsimp only [t₀]
            rw [map_sub, MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_C, sub_zero]
          rw [hp0, hp1, map_zero, map_one, zero_mul, one_mul, zero_sub]
          exact neg_ne_zero.mpr hd0
      · let t₀ : A₀ := MvPolynomial.X 0 - MvPolynomial.C (p 0)
        refine ⟨t₀, hIrrLin 0 (p 0), ?_, ?_⟩
        · dsimp only [t₀]
          rw [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, sub_self]
        · have hp0 : (MvPolynomial.pderiv 0) t₀ = 1 := by
            dsimp only [t₀]
            rw [map_sub, MvPolynomial.pderiv_X_self, MvPolynomial.pderiv_C, sub_zero]
          have hp1 : (MvPolynomial.pderiv 1) t₀ = 0 := by
            dsimp only [t₀]
            rw [map_sub, MvPolynomial.pderiv_X_of_ne (by decide), MvPolynomial.pderiv_C, sub_zero]
          rw [hp0, hp1, map_one, map_zero, one_mul, zero_mul, sub_zero]
          exact hd1

  
  
  
  
  have hs4 :
      ∀ (A_base B_int 𝒪_p D A_f B_f B_bar R_bar : Type u)
        [CommRing A_base] [CommRing B_int] [CommRing 𝒪_p] [CommRing D]
        [CommRing A_f] [CommRing B_f] [CommRing B_bar] [CommRing R_bar]
        [IsDomain D] [IsNoetherianRing D] [IsLocalRing D]
        (π_D : D),
        π_D ≠ 0 →
        IsLocalRing.maximalIdeal D = Ideal.span {π_D} →
        ∀ (ev : A_base →+* k) (h₀ f₀ : A_base)
          (𝔪_p : Ideal A_base) [𝔪_p.IsMaximal],
          (∀ g : A_base, g ∈ 𝔪_p ↔ ev g = 0) →
          ev f₀ ≠ 0 →
          ∀ [Algebra A_base B_int] [Module.Finite A_base B_int]
            [Algebra A_base 𝒪_p] [IsLocalization.AtPrime 𝒪_p 𝔪_p]
            (q_D : 𝒪_p →+* D),
            Function.Surjective q_D →
            q_D (algebraMap A_base 𝒪_p h₀) = 0 →
            (∀ (α : 𝒪_p →+* R_bar), α (algebraMap A_base 𝒪_p h₀) = 0 →
              ∃ ψ_D : D →+* R_bar, ∀ o : 𝒪_p, ψ_D (q_D o) = α o) →
            ∀ [Algebra A_base A_f] [IsLocalization.Away f₀ A_f]
              [Algebra B_int B_f] [IsLocalization.Away (algebraMap A_base B_int f₀) B_f]
              [Algebra A_f B_f] [Algebra.Etale A_f B_f],
              (∀ g : A_base, algebraMap A_f B_f (algebraMap A_base A_f g) =
                algebraMap B_int B_f (algebraMap A_base B_int g)) →
              ∀ (𝔐₀ : Ideal B_int) (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
                [Algebra B_bar R_bar] [IsLocalization.AtPrime R_bar 𝔪_bar],
                𝔪_bar.IsMaximal →
                (∀ g : A_base, algebraMap A_base B_int g ∈ 𝔐₀ ↔ ev g = 0) →
                ∀ (π_bar : B_int →+* B_bar),
                  Function.Surjective π_bar →
                  π_bar (algebraMap A_base B_int h₀) = 0 →
                  (∀ (S_tgt : Type u) [CommRing S_tgt] (γ : B_int →+* S_tgt),
                    γ (algebraMap A_base B_int h₀) = 0 →
                    ∃ ι : B_bar →+* S_tgt, ∀ y : B_int, ι (π_bar y) = γ y) →
                  Ideal.comap π_bar 𝔪_bar = 𝔐₀ →
                  IsDomain R_bar ∧ IsIntegrallyClosed R_bar := by
    intro A_base B_int 𝒪_p D A_f B_f B_bar R_bar
      _ _ _ _ _ _ _ _ _ _ _
      π_D hπ_D_ne hmax_D ev h₀ f₀ 𝔪_p _ h𝔪_p_mem hp_f₀
      _ _ _ _ q_D hq_D_surj hq_D_h₀ hq_D_lift
      _ _ _ _ _ _ haway_comm
      𝔐₀ 𝔪_bar _ algB_R locB_R h𝔪_max h𝔐₀_mem
      π_bar hπ_bar_surj hπ_bar_h₀ hπ_bar_lift hcomap_bar
    let f_B : B_int := algebraMap A_base B_int f₀
    haveI : Module.Finite A_f B_f := by
      obtain ⟨s₀, hs₀⟩ := @Module.Finite.fg_top A_base B_int _ _ _ inferInstance
      classical
      let s_f : Finset B_f := s₀.image (algebraMap B_int B_f)
      apply Module.Finite.of_fg_top
      refine ⟨s_f, ?_⟩
      rw [eq_top_iff]
      intro z _
      obtain ⟨n, y, hzy⟩ := IsLocalization.Away.surj f_B z
      have hy_mem : y ∈ Submodule.span A_base (s₀ : Set B_int) := by
        rw [hs₀]; exact Submodule.mem_top
      obtain ⟨c, _, hc⟩ := Submodule.mem_span_finset.mp hy_mem
      let u_f : A_f := IsLocalization.Away.invSelf (S := A_f) f₀
      have huf_mul : algebraMap A_base A_f f₀ * u_f = 1 :=
        IsLocalization.Away.mul_invSelf (S := A_f) f₀
      have huf_Bf : algebraMap B_int B_f f_B * algebraMap A_f B_f u_f = 1 := by
        dsimp [f_B]
        rw [← haway_comm f₀, ← map_mul, huf_mul, map_one]
      have huf_pow : (algebraMap B_int B_f f_B) ^ n * (algebraMap A_f B_f u_f) ^ n = 1 := by
        rw [← mul_pow, huf_Bf, one_pow]
      have hz_eq : z = (u_f ^ n) • algebraMap B_int B_f y := by
        rw [Algebra.smul_def, map_pow]
        calc z = z * 1 := (mul_one z).symm
          _ = z * ((algebraMap B_int B_f f_B) ^ n * (algebraMap A_f B_f u_f) ^ n) := by
              rw [huf_pow]
          _ = (z * (algebraMap B_int B_f f_B) ^ n) * (algebraMap A_f B_f u_f) ^ n := by ring
          _ = algebraMap B_int B_f y * (algebraMap A_f B_f u_f) ^ n := by rw [hzy]
          _ = (algebraMap A_f B_f u_f) ^ n * algebraMap B_int B_f y := by ring
      rw [hz_eq, ← hc, map_sum]
      apply Submodule.smul_mem _ (u_f ^ n)
      refine Submodule.sum_mem _ fun b hb => ?_
      have hterm : algebraMap B_int B_f (c b • b) =
          (algebraMap A_base A_f (c b)) • algebraMap B_int B_f b := by
        rw [Algebra.smul_def, map_mul, ← haway_comm (c b), Algebra.smul_def]
      rw [hterm]
      exact Submodule.smul_mem _ _
        (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hb)))
    have h_not_𝔪p : ∀ {g : A_base}, ev g ≠ 0 → g ∈ 𝔪_p.primeCompl := by
      intro g hg hmem
      exact hg ((h𝔪_p_mem g).mp hmem)
    let g_A₀_D : A_base →+* D := q_D.comp (algebraMap A_base 𝒪_p)
    have hf_unit_D : IsUnit (g_A₀_D f₀) :=
      (IsLocalization.map_units 𝒪_p ⟨f₀, h_not_𝔪p hp_f₀⟩).map q_D
    let φ_Af_D : A_f →+* D := IsLocalization.Away.lift (S := A_f) (g := g_A₀_D) f₀ hf_unit_D
    letI : Algebra A_f D := φ_Af_D.toAlgebra
    have hAf_D_eq : ∀ g : A_base,
