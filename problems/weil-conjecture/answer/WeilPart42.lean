theorem weil_abhyankar_tame_divisor_ramification_and_residue_sep (k : Type u) [Field k]
    [IsAlgClosed k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
      (f₀ : A₀),
      Irreducible f₀ →
      (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
       let B₂_0 := integralClosure A₀ L₂
       ∀ (Q_C : Ideal ↥B₂_0), Q_C.IsPrime →
         Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C = Ideal.span {f₀} →
         ringChar k = 0 ∨
         Nat.Coprime (ringChar k)
           (Nat.card { σ : L₂ ≃ₐ[K₂] L₂ //
             ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0) })) →
      letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
      let B₂_0 := integralClosure A₀ L₂
      ∃ e : ℕ, 1 ≤ e ∧ (e : k) ≠ 0 ∧
        ∀ (𝔓_C : Ideal A₀) [𝔓_C.IsPrime]
          (Q_C : Ideal ↥B₂_0) [Q_C.IsPrime]
          (hOver : 𝔓_C = Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C),
          𝔓_C = Ideal.span {f₀} →
          IsDiscreteValuationRing (Localization.AtPrime Q_C) ∧
          (∃ (π_C : Localization.AtPrime Q_C) (u_C : (Localization.AtPrime Q_C)ˣ),
            π_C ≠ 0 ∧
            IsLocalRing.maximalIdeal (Localization.AtPrime Q_C) = Ideal.span {π_C} ∧
            algebraMap ↥B₂_0 (Localization.AtPrime Q_C) (algebraMap A₀ ↥B₂_0 f₀) =
              (u_C : Localization.AtPrime Q_C) * π_C ^ e) ∧
          @Algebra.IsSeparable 𝔓_C.ResidueField Q_C.ResidueField _ _
            (Ideal.ResidueField.map 𝔓_C Q_C (algebraMap A₀ ↥B₂_0) hOver).toAlgebra :=
by
  intro A₀ K₂ L₂ _ _ _ _ f₀ hIrr hTame
  letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
  haveI : IsScalarTower A₀ K₂ L₂ := IsScalarTower.of_algebraMap_eq' rfl
  let B₂_0 := integralClosure A₀ L₂
  let G := (L₂ ≃ₐ[K₂] L₂)
  change ∃ e : ℕ, 1 ≤ e ∧ (e : k) ≠ 0 ∧
    ∀ (𝔓_C : Ideal A₀) [𝔓_C.IsPrime]
      (Q_C : Ideal ↥B₂_0) [Q_C.IsPrime]
      (hOver : 𝔓_C = Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C),
      𝔓_C = Ideal.span {f₀} → _

  
  have hDedekindCore :
      ∀ (R C : Type u) [CommRing R] [IsDomain R] [IsDedekindDomain R]
        [CommRing C] [IsDomain C] [IsDedekindDomain C]
        [Algebra R C] [Algebra.IsIntegral R C] [Module.Finite R C]
        [MulSemiringAction G C] [IsGaloisGroup G R C]
        (π : R) (hπ_ne : π ≠ 0)
        (𝔭 : Ideal R) [𝔭.IsMaximal] (h𝔭_eq : 𝔭 = Ideal.span {π})
        (hInj : Function.Injective (algebraMap R C))
        (φ_R : k →+* R),
        let e : ℕ := 𝔭.ramificationIdxIn C
        1 ≤ e ∧
        (∃ Q'_0 : Ideal C, Q'_0.IsMaximal ∧ Ideal.comap (algebraMap R C) Q'_0 = 𝔭) ∧
        (∀ (Q' : Ideal C) [Q'.IsPrime] [Q'.LiesOver 𝔭],
          (ringChar k = 0 ∨ Nat.Coprime (ringChar k) (Nat.card ↥(Ideal.inertia G Q'))) →
          (e : k) ≠ 0 ∧
          ∀ (κ_bot κ_top : Type u) [Field κ_bot] [Field κ_top]
            (ρ_bot : R →+* κ_bot) (ρ_top : C →+* κ_top) (f_res : κ_bot →+* κ_top),
            (∀ r ∈ 𝔭, ρ_bot r = 0) →
            (∀ z ∈ Q', ρ_top z = 0) →
            (∀ ξ : κ_top, ∃ (b u : C), u ∉ Q' ∧ ξ * ρ_top u = ρ_top b) →
            (∀ r : R, f_res (ρ_bot r) = ρ_top (algebraMap R C r)) →
            @Algebra.IsSeparable κ_bot κ_top _ _ f_res.toAlgebra) ∧
        (∀ (Q' : Ideal C) [Q'.IsPrime] [Q'.LiesOver 𝔭]
          (E_Q : Type u) [CommRing E_Q] [IsDomain E_Q] [IsLocalRing E_Q]
          [Algebra C E_Q] [IsLocalization.AtPrime E_Q Q'],
          IsDiscreteValuationRing E_Q ∧
          ∃ (π_C : E_Q) (u_C : E_Qˣ),
            π_C ≠ 0 ∧
            IsLocalRing.maximalIdeal E_Q = Ideal.span {π_C} ∧
            algebraMap C E_Q (algebraMap R C π) = (u_C : E_Q) * π_C ^ e) := by
    intro R C _ _ _ _ _ _ _ _ _ _ _ π hπ_ne 𝔭 h𝔭_max h𝔭_eq hInj φ_R e
    letI : MulSemiringAction G (Ideal C) := Ideal.pointwiseMulSemiringAction
    have hπ_mem : π ∈ 𝔭 := h𝔭_eq ▸ Ideal.mem_span_singleton_self π
    have h𝔭_ne_bot : 𝔭 ≠ ⊥ := fun hbot => hπ_ne (Ideal.mem_bot.mp (hbot ▸ hπ_mem))
    haveI : Module.IsTorsionFree R C :=
      ⟨fun r hr x y hxy => by
        have hr0 : r ≠ 0 := fun h0 => one_ne_zero (hr.left (by simp [h0] : r * 1 = r * 0))
        have hmap0 : algebraMap R C r ≠ 0 :=
          fun h => hr0 (hInj (h.trans (map_zero _).symm))
        change r • x = r • y at hxy
        rw [Algebra.smul_def, Algebra.smul_def] at hxy
        exact mul_left_cancel₀ hmap0 hxy⟩
    haveI : Module.Flat R C := Module.Flat.instOfIsDedekindDomainOfIsTorsionFree
    have hDegEq : (𝔭.primesOver C).ncard * (e * 𝔭.inertiaDegIn C) = Nat.card G :=
      Ideal.ncard_primesOver_mul_ramificationIdxIn_mul_inertiaDegIn 𝔭 C G
    have hCardG_pos : 0 < Nat.card G := Nat.card_pos
    have he_pos : 1 ≤ e := by
      by_contra h
      have he0 : e = 0 := by omega
      rw [he0, zero_mul, mul_zero] at hDegEq
      omega
    have hKer_le : RingHom.ker (algebraMap R C) ≤ 𝔭 := by
      rw [(RingHom.injective_iff_ker_eq_bot _).mp hInj]
      exact bot_le
    obtain ⟨Q'_0, hQ'_0_max, hQ'_0_under⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := C) 𝔭 hKer_le
    refine ⟨he_pos, ⟨Q'_0, hQ'_0_max, hQ'_0_under⟩, ?_, ?_⟩
    · intro Q' hQ'_prime hQ'_over hTameQ'
