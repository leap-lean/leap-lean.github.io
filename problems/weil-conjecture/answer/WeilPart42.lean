  have hCont_M : ∀ {X S : AlgebraicGeometry.Scheme.{u}} {u : X ⟶ S} (hu : P_et u),
      (CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hu : X.Etale ⥤ S.Etale).IsContinuous
