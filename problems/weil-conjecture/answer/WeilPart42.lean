theorem weil_net_p2_shifted_coords_and_transversality (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z₁.hom]
    [AlgebraicGeometry.IsProper Z₁.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z₁.hom]
    (P : WeilRationalLefschetzPencil F m Z₁)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    (U_disc_reg : C_disc.left.Opens)
    (hSing : WeilTransvTriIsSingularDatum F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc U_disc_reg)
    (a : F) (_ha : a ∈ S_aff)
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra F k] [Algebra.IsAlgebraic F k]
    (S_aff_k : Finset k)
    (Δ_k : Polynomial k) :
    (∀ x : k, x ∈ S_aff_k ↔ ∃ s ∈ S_aff, algebraMap F k s = x) →
    Δ_k = (∏ s_k ∈ S_aff_k, (Polynomial.X - Polynomial.C s_k : Polynomial k)) →
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
