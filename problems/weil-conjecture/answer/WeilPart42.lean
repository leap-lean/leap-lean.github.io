theorem weil_odp_slice_generic_line_pullback_transfer (F : Type u) [Field F]
    (m : ℕ)
    (Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (g₂ : Y₂ ⟶ weilProjectiveSpaceOver F 2)
    (k : Type u) [Field k] [Algebra F k]
    (π_P2 : (weilProjectiveSpaceOver k 2).left ⟶ (weilProjectiveSpaceOver F 2).left)
    (Y₂_k : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g₂_k : Y₂_k ⟶ weilProjectiveSpaceOver k 2)
    (π_Y₂ : Y₂_k.left ⟶ Y₂.left)
    (hPb_Y₂ : CategoryTheory.IsPullback π_Y₂ g₂_k.left g₂.left π_P2)
    (j_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
      (weilProjectiveSpaceOver k 2).left)
    [AlgebraicGeometry.IsOpenImmersion j_0]
    (f₀ : MvPolynomial (Fin 2) k)
    (hf₀_irr : Irreducible f₀)
    (η_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)))
    (hη_0_ideal : η_0.asIdeal = Ideal.span {f₀})
    (y_η : Y₂.left)
    (hy_η_base : g₂.left.base y_η = (j_0 ≫ π_P2).base η_0)
    (hy_η_sm : ∀ y' : Y₂.left,
      g₂.left.base y' = (j_0 ≫ π_P2).base η_0 →
      y' ≠ y_η →
      ∃ V : Y₂.left.Opens, y' ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ g₂.left))
    (hy_η_res_surj : Function.Surjective
      (AlgebraicGeometry.Scheme.Hom.residueFieldMap g₂.left y_η).hom)
    (R'_η : CommRingCat.{u})
    (u_η : AlgebraicGeometry.Spec R'_η)
    (e_Bη : AlgebraicGeometry.Spec R'_η ⟶ (weilProjectiveSpaceOver F 2).left)
    (h_η : R'_η)
    (V'_η : AlgebraicGeometry.Scheme.{u})
    (v_η : V'_η)
    (e_Yη : V'_η ⟶ Y₂.left)
    (q_η_roof : V'_η ⟶ AlgebraicGeometry.Spec (CommRingCat.of
      (MvPolynomial (Fin (m + 1) × Fin 2) R'_η ⧸ Ideal.span
        {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
          MvPolynomial.C h_η})))
    (he_Bη_et : AlgebraicGeometry.Etale e_Bη)
    (he_Yη_et : AlgebraicGeometry.Etale e_Yη)
    (hq_η_et : AlgebraicGeometry.Etale q_η_roof)
    (he_Yη_pt : e_Yη.base v_η = y_η)
    (hv_η_u : (AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C))).base
        (q_η_roof.base v_η) = u_η)
    (hv_η_X : ∀ idx : Fin (m + 1) × Fin 2,
      Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_η_roof.base v_η).asIdeal)
    (hv_η_C : Ideal.Quotient.mk _ (MvPolynomial.C h_η) ∈ (q_η_roof.base v_η).asIdeal)
    (hComm_η : e_Yη ≫ g₂.left =
      q_η_roof ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_Bη)
    (R_η : CommRingCat.{u})
    (α_R'η : R'_η ⟶ R_η)
    (φ_η ψ_η : MvPolynomial (Fin 2) k →+* R_η)
    (q_η : PrimeSpectrum R_η)
    (hφ_η_et : φ_η.Etale)
    (hψ_η_h : ψ_η (MvPolynomial.X 0) = α_R'η.hom h_η)
    (hψ_η_disc : ∀ u : PrimeSpectrum R_η,
      ψ_η (MvPolynomial.X 0) ∈ u.asIdeal ↔ φ_η f₀ ∈ u.asIdeal)
    (hα_e_Bη : AlgebraicGeometry.Spec.map α_R'η ≫ e_Bη =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_η) ≫ j_0 ≫ π_P2)
    (hα_q_η : (AlgebraicGeometry.Spec.map α_R'η).base q_η = u_η)
    (hq_η_comap : Ideal.comap φ_η q_η.asIdeal = Ideal.span {f₀}) :
    ∀ (s₀ : R_η),
      s₀ ∉ q_η.asIdeal →
      ∀ (κ₁ : Type u) [Field κ₁] [IsAlgClosed κ₁] [Algebra k κ₁]
        (ι_slice : MvPolynomial (Fin 2) k →+* Polynomial κ₁),
        ι_slice.comp MvPolynomial.C = Polynomial.C.comp (algebraMap k κ₁) →
        Ideal.comap ι_slice (Ideal.span {Polynomial.X}) = Ideal.span {f₀} →
        let g_line : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ₁)) ⟶
            (weilProjectiveSpaceOver k 2).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_slice) ≫ j_0
        let B_line : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ₁)) :=
          CategoryTheory.Over.mk
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : κ₁ →+* Polynomial κ₁)))
        let Y_line : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ₁)) :=
          CategoryTheory.Over.mk
            (CategoryTheory.Limits.pullback.snd g₂_k.left g_line ≫ B_line.hom)
        let f_line : Y_line ⟶ B_line :=
          CategoryTheory.Over.homMk
            (CategoryTheory.Limits.pullback.snd g₂_k.left g_line) rfl
        let s_zero : AlgebraicGeometry.Spec (CommRingCat.of κ₁) ⟶ B_line.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ₁)))
        ∃ (x_zero : AlgebraicGeometry.Spec (CommRingCat.of κ₁) ⟶ Y_line.left)
          (R_line : CommRingCat.{u})
          (α_1 : Polynomial κ₁ →+* R_line)
          (α_2 : Localization.Away s₀ →+* R_line)
          (ε_line : R_line →+* κ₁),
          α_1.Etale ∧
          α_1.comp ι_slice = α_2.comp ((algebraMap R_η (Localization.Away s₀)).comp φ_η) ∧
          ε_line.comp α_1 = Polynomial.evalRingHom 0 ∧
          x_zero ≫ f_line.left = s_zero ∧
          (∀ z : Y_line.left,
            f_line.left.base z ∈ Set.range s_zero.base →
            z ∉ Set.range x_zero.base →
            ∃ V : Y_line.left.Opens, z ∈ V ∧
              AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f_line.left)) ∧
          (∀ g_et : R_line,
            ε_line g_et ≠ 0 →
            (Polynomial.eval₂RingHom
              ((algebraMap R_line (Localization.Away g_et)).comp (α_1.comp Polynomial.C))
              (algebraMap R_line (Localization.Away g_et)
                (α_2 (algebraMap R_η (Localization.Away s₀) (ψ_η (MvPolynomial.X 0)))))).Etale →
            ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of κ₁),
              IsEtaleSplitOdpPointOver m f_line (x_zero.base pt) (s_zero.base pt)) :=
by
  let _ := hf₀_irr
  let _ := hη_0_ideal
  
  have h_etale_lift :
      ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
        φ.Etale →
        ∀ (q : PrimeSpectrum B) (κ₁ : Type u) [Field κ₁] [IsAlgClosed κ₁] (χ_A : A →+* κ₁),
          RingHom.ker χ_A = Ideal.comap φ q.asIdeal →
          ∃ χ_B : B →+* κ₁, RingHom.ker χ_B = q.asIdeal ∧ χ_B.comp φ = χ_A := by
    intro A B _ _ φ hφ q κ₁ _ _ χ_A hker
    letI : Algebra A B := φ.toAlgebra
    haveI : Algebra.Etale A B := hφ
    let p : Ideal A := Ideal.comap (algebraMap A B) q.asIdeal
    haveI hp_prime : p.IsPrime := q.isPrime.comap (algebraMap A B)
    haveI hq_prime : q.asIdeal.IsPrime := q.isPrime
    let D_A := A ⧸ p
    let K_A := FractionRing D_A
    let D_B := B ⧸ q.asIdeal
    let L_B := FractionRing D_B
    let χ_DA : D_A →+* κ₁ := Ideal.Quotient.lift p χ_A (fun a ha => by
      rw [← RingHom.mem_ker, hker]; exact ha)
    have hχ_DA_inj : Function.Injective χ_DA := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      change χ_A a = 0 at hx
      have ha : a ∈ p := by
        change a ∈ Ideal.comap φ q.asIdeal
        rw [← hker]
        exact hx
      exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
    let ι_KA : K_A →+* κ₁ := IsFractionRing.lift hχ_DA_inj
    let ψ_B : B →+* L_B := algebraMap B L_B
    have hψ_B_eq : ψ_B = (algebraMap D_B L_B).comp (Ideal.Quotient.mk q.asIdeal) := by
      ext b
      exact IsScalarTower.algebraMap_apply B D_B L_B b
    have hker_ψB : RingHom.ker ψ_B = q.asIdeal := by
      rw [hψ_B_eq]
      ext b
      simp only [RingHom.mem_ker, RingHom.comp_apply]
      rw [map_eq_zero_iff _ (IsFractionRing.injective D_B L_B), Ideal.Quotient.eq_zero_iff_mem]
    let ψ_DA : D_A →+* L_B := Ideal.Quotient.lift p (algebraMap A L_B) (fun a ha => by
      rw [IsScalarTower.algebraMap_apply A B L_B a]
      change ψ_B (φ a) = 0
      rw [← RingHom.mem_ker, hker_ψB]
      exact ha)
    have hψ_DA_inj : Function.Injective ψ_DA := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
      change algebraMap A L_B a = 0 at hx
      rw [IsScalarTower.algebraMap_apply A B L_B a] at hx
      change ψ_B (φ a) = 0 at hx
      rw [← RingHom.mem_ker, hker_ψB] at hx
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
    let j_KL : K_A →+* L_B := IsFractionRing.lift hψ_DA_inj
    letI : Algebra K_A L_B := j_KL.toAlgebra
    haveI : IsScalarTower A K_A L_B := IsScalarTower.of_algebraMap_eq fun a => by
      rw [IsScalarTower.algebraMap_apply A D_A K_A a]
      exact (IsFractionRing.lift_algebraMap hψ_DA_inj (algebraMap A D_A a)).symm
    haveI : Algebra.Etale K_A (TensorProduct A K_A B) := Algebra.Etale.baseChange A B K_A
    haveI hFin_T : Module.Finite K_A (TensorProduct A K_A B) := by
      obtain ⟨I_et, hFinI, Ai, hFieldAi, hAlgAi, e_prod, hFinSep⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K_A (TensorProduct A K_A B)).mp inferInstance
      letI := hFinI
      letI := fun i => (hFieldAi i).toCommRing
      letI := hAlgAi
      haveI : ∀ i, Module.Finite K_A (Ai i) := fun i => (hFinSep i).1
      exact Module.Finite.equiv e_prod.symm.toLinearEquiv
    let ψ_B_alg : B →ₐ[A] L_B := IsScalarTower.toAlgHom A B L_B
    let Ψ : TensorProduct A K_A B →ₐ[K_A] L_B :=
      Algebra.TensorProduct.lift (Algebra.ofId K_A L_B) ψ_B_alg (fun _ _ => Commute.all _ _)
    let S_im : Subalgebra K_A L_B := Ψ.range
    haveI : Module.Finite K_A ↥S_im :=
      Module.Finite.of_surjective Ψ.rangeRestrict.toLinearMap Ψ.rangeRestrict_surjective
    haveI : Algebra.IsIntegral K_A ↥S_im := Algebra.IsIntegral.of_finite K_A ↥S_im
    have hField_Sim : IsField ↥S_im :=
      (Algebra.IsIntegral.isField_iff_isField (algebraMap K_A ↥S_im).injective).mp
        (Field.toIsField K_A)
    have hΨ_surj : Function.Surjective Ψ := by
      intro z
      obtain ⟨⟨x_num, s_den⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors D_B) z
      obtain ⟨b₁, hb₁⟩ := Ideal.Quotient.mk_surjective x_num
      obtain ⟨b₂, hb₂⟩ := Ideal.Quotient.mk_surjective s_den.1
      have hψ_b₁ : ψ_B b₁ = algebraMap D_B L_B x_num := by
        rw [hψ_B_eq]
        change algebraMap D_B L_B (Ideal.Quotient.mk q.asIdeal b₁) = _
        rw [hb₁]
      have hψ_b₂ : ψ_B b₂ = algebraMap D_B L_B s_den.1 := by
        rw [hψ_B_eq]
        change algebraMap D_B L_B (Ideal.Quotient.mk q.asIdeal b₂) = _
        rw [hb₂]
      have hm₁ : ψ_B b₁ ∈ S_im := ⟨(1 : K_A) ⊗ₜ[A] b₁, by simp [Ψ, ψ_B_alg, ψ_B]⟩
      have hm₂ : ψ_B b₂ ∈ S_im := ⟨(1 : K_A) ⊗ₜ[A] b₂, by simp [Ψ, ψ_B_alg, ψ_B]⟩
      have hb₂_ne : (⟨ψ_B b₂, hm₂⟩ : ↥S_im) ≠ 0 := by
        intro h0
        have hval : ψ_B b₂ = 0 := congrArg Subtype.val h0
        rw [hψ_b₂, map_eq_zero_iff _ (IsFractionRing.injective D_B L_B)] at hval
        exact mem_nonZeroDivisors_iff_ne_zero.mp s_den.2 hval
      obtain ⟨u_inv, hu_inv⟩ := hField_Sim.mul_inv_cancel hb₂_ne
      have hu_val : ψ_B b₂ * u_inv.1 = 1 := congrArg Subtype.val hu_inv
      have hz_eq : z = ψ_B b₁ * u_inv.1 := by
        calc z = z * 1 := (mul_one z).symm
          _ = z * (ψ_B b₂ * u_inv.1) := by rw [hu_val]
          _ = (z * algebraMap D_B L_B s_den.1) * u_inv.1 := by rw [hψ_b₂, mul_assoc]
          _ = ψ_B b₁ * u_inv.1 := by rw [hzs, hψ_b₁]
      rw [hz_eq]
      exact S_im.mul_mem hm₁ u_inv.2
    haveI : Module.Finite K_A L_B := Module.Finite.of_surjective Ψ.toLinearMap hΨ_surj
    haveI : Algebra.IsAlgebraic K_A L_B := Algebra.IsAlgebraic.of_finite K_A L_B
    letI : Algebra K_A κ₁ := ι_KA.toAlgebra
    let σ : L_B →ₐ[K_A] κ₁ := IsAlgClosed.lift
    let χ_B : B →+* κ₁ := σ.toRingHom.comp ψ_B
    refine ⟨χ_B, ?_, ?_⟩
    · ext b
      simp only [RingHom.mem_ker, χ_B, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
        AlgHom.coe_toRingHom]
      rw [map_eq_zero_iff σ σ.injective, ← RingHom.mem_ker, hker_ψB]
    · ext a
      change σ (algebraMap A L_B a) = χ_A a
      rw [IsScalarTower.algebraMap_apply A K_A L_B a, σ.commutes,
        IsScalarTower.algebraMap_apply A D_A K_A a]
      exact IsFractionRing.lift_algebraMap hχ_DA_inj (Ideal.Quotient.mk p a)

  
  have h_odp_pushout :
      ∀ (R₁ R₂ : CommRingCat.{u}) (β : R₁ ⟶ R₂) (h₁ : R₁) (h₂ : R₂),
        β.hom h₁ = h₂ →
        let I₁ : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R₁) :=
          Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C h₁}
        let I₂ : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R₂) :=
          Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C h₂}
        let M₁ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R₁ ⧸ I₁)
        let M₂ : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R₂ ⧸ I₂)
        ∃ (π_M : M₁ ⟶ M₂),
          (∀ idx : Fin (m + 1) × Fin 2,
            π_M.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx)) =
              Ideal.Quotient.mk I₂ (MvPolynomial.X idx)) ∧
          (∀ r : R₁,
            π_M.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C r)) =
              Ideal.Quotient.mk I₂ (MvPolynomial.C (β.hom r))) ∧
          CategoryTheory.IsPushout
            (CommRingCat.ofHom ((Ideal.Quotient.mk I₁).comp MvPolynomial.C))
            β
            π_M
            (CommRingCat.ofHom ((Ideal.Quotient.mk I₂).comp MvPolynomial.C)) := by
    intro R₁ R₂ β h₁ h₂ hβ I₁ I₂ M₁ M₂
    let f_poly : MvPolynomial (Fin (m + 1) × Fin 2) R₂ →+* M₂ := Ideal.Quotient.mk I₂
    have hI₁_le : I₁ ≤ RingHom.ker (f_poly.comp (MvPolynomial.map β.hom)) := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker, RingHom.comp_apply]
      have hmap_gen : MvPolynomial.map β.hom
          ((∑ j : Fin (m + 1),
            (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R₁) *
              MvPolynomial.X (j, 1)) -
            MvPolynomial.C h₁) =
          (∑ j : Fin (m + 1),
            (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) R₂) *
              MvPolynomial.X (j, 1)) -
            MvPolynomial.C h₂ := by
        simp [hβ]
      exact (congrArg f_poly hmap_gen).trans
        (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _))
    let π_hom : M₁ →+* M₂ :=
      Ideal.Quotient.lift I₁ (f_poly.comp (MvPolynomial.map β.hom)) (fun _ hp => hI₁_le hp)
    let π_M : M₁ ⟶ M₂ := CommRingCat.ofHom π_hom
    let ι₁ : R₁ ⟶ M₁ := CommRingCat.ofHom ((Ideal.Quotient.mk I₁).comp MvPolynomial.C)
    let ι₂ : R₂ ⟶ M₂ := CommRingCat.ofHom ((Ideal.Quotient.mk I₂).comp MvPolynomial.C)
    have hπ_X : ∀ idx : Fin (m + 1) × Fin 2,
        π_M.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx)) =
          Ideal.Quotient.mk I₂ (MvPolynomial.X idx) := by
      intro idx
      change f_poly (MvPolynomial.map β.hom (MvPolynomial.X idx)) = _
      rw [MvPolynomial.map_X]
    have hπ_C : ∀ r : R₁,
        π_M.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C r)) =
          Ideal.Quotient.mk I₂ (MvPolynomial.C (β.hom r)) := by
      intro r
      change f_poly (MvPolynomial.map β.hom (MvPolynomial.C r)) = _
      rw [MvPolynomial.map_C]
    have hw : ι₁ ≫ π_M = β ≫ ι₂ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      exact hπ_C r
    have hColim : CategoryTheory.Limits.IsColimit
        (CategoryTheory.Limits.PushoutCocone.mk π_M ι₂ hw) := by
      refine CategoryTheory.Limits.PushoutCocone.isColimitAux' _ fun s => ?_
      let Φ_raw : MvPolynomial (Fin (m + 1) × Fin 2) R₂ →+* s.pt :=
        MvPolynomial.eval₂Hom s.inr.hom
          (fun idx => s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx)))
      have hI₂_ker : I₂ ≤ RingHom.ker Φ_raw := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        have hcond_h : s.inr.hom h₂ = s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C h₁)) := by
          rw [← hβ]
          exact (RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) h₁).symm
        have hsum_eq : Φ_raw (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) =
            s.inl.hom (Ideal.Quotient.mk I₁
              (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) := by
          rw [map_sum, map_sum, map_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [map_mul, map_mul, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
        have hC_eq : Φ_raw (MvPolynomial.C h₂) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C h₁)) :=
          (MvPolynomial.eval₂Hom_C _ _ h₂).trans hcond_h
        rw [map_sub, hsum_eq, hC_eq, ← map_sub, ← map_sub]
        have hgen0 : Ideal.Quotient.mk I₁
            ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
              MvPolynomial.C h₁) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        rw [hgen0, map_zero]
      let l : M₂ ⟶ s.pt :=
        CommRingCat.ofHom (Ideal.Quotient.lift I₂ Φ_raw (fun _ hp => hI₂_ker hp))
      have hl_X : ∀ idx : Fin (m + 1) × Fin 2,
          l.hom (Ideal.Quotient.mk I₂ (MvPolynomial.X idx)) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx)) :=
        fun idx => MvPolynomial.eval₂Hom_X' _ _ idx
      have hl_C : ∀ r₂ : R₂,
          l.hom (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂)) = s.inr.hom r₂ :=
        fun r₂ => MvPolynomial.eval₂Hom_C _ _ r₂
      refine ⟨l, ?_, ?_, fun {m} hm₁ hm₂ => ?_⟩
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r
          have hcond_r := RingHom.congr_fun (congrArg CommRingCat.Hom.hom s.condition) r
          change l.hom (π_M.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C r))) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.C r))
          rw [hπ_C r, hl_C]
          exact hcond_r.symm
        · intro idx
          change l.hom (π_M.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx))) =
            s.inl.hom (Ideal.Quotient.mk I₁ (MvPolynomial.X idx))
          rw [hπ_X idx, hl_X]
      · apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r₂
        exact hl_C r₂
      · apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext
        · intro r₂
          have hm₂_r := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₂) r₂
          change m.hom (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂)) =
            l.hom (Ideal.Quotient.mk I₂ (MvPolynomial.C r₂))
          exact hm₂_r.trans (hl_C r₂).symm
        · intro idx
          have hm₁_x := RingHom.congr_fun (congrArg CommRingCat.Hom.hom hm₁)
            (Ideal.Quotient.mk I₁ (MvPolynomial.X idx))
          change m.hom (Ideal.Quotient.mk I₂ (MvPolynomial.X idx)) =
            l.hom (Ideal.Quotient.mk I₂ (MvPolynomial.X idx))
          rw [← hπ_X idx]
          exact hm₁_x.trans ((congrArg l.hom (hπ_X idx)).trans (hl_X idx)).symm
    exact ⟨π_M, hπ_X, hπ_C, CategoryTheory.IsPushout.of_isColimit hColim⟩

  
  intro s₀ hs₀ κ₁ _ _ _ ι_slice _hι_C hι_comap g_line B_line Y_line f_line s_zero
  let θ₀ : MvPolynomial (Fin 2) k →+* κ₁ := (Polynomial.evalRingHom (0 : κ₁)).comp ι_slice
  have hker_θ₀ : RingHom.ker θ₀ = Ideal.comap φ_η q_η.asIdeal := by
    rw [hq_η_comap, ← hι_comap]
    ext g
    simp only [RingHom.mem_ker, θ₀, RingHom.comp_apply, Polynomial.coe_evalRingHom,
      Ideal.mem_comap, Ideal.mem_span_singleton]
    change Polynomial.IsRoot (ι_slice g) 0 ↔ Polynomial.X ∣ ι_slice g
    rw [← Polynomial.dvd_iff_isRoot, Polynomial.C_0, sub_zero]
  obtain ⟨χ_η, hker_χη, hχη_φ⟩ := h_etale_lift φ_η hφ_η_et q_η κ₁ θ₀ hker_θ₀
  have hs₀_ne : χ_η s₀ ≠ 0 := by
    intro h0
    apply hs₀
    rw [← hker_χη]
    exact h0
  have hs₀_unit : IsUnit (χ_η s₀) := isUnit_iff_ne_zero.mpr hs₀_ne
  let R_ηloc := Localization.Away s₀
  let χ_loc : R_ηloc →+* κ₁ := IsLocalization.Away.lift s₀ hs₀_unit
  have hχ_loc_comp : χ_loc.comp (algebraMap R_η R_ηloc) = χ_η := by
    ext r
    exact IsLocalization.Away.lift_eq s₀ hs₀_unit r
  let φ_ηloc : MvPolynomial (Fin 2) k →+* R_ηloc := (algebraMap R_η R_ηloc).comp φ_η
  have hAlg_et : (algebraMap R_η R_ηloc).Etale := RingHom.etale_algebraMap.mpr inferInstance
  have hφ_ηloc_et : φ_ηloc.Etale :=
    RingHom.Etale.stableUnderComposition φ_η (algebraMap R_η R_ηloc) hφ_η_et hAlg_et
  have hχ_loc_φ : χ_loc.comp φ_ηloc = (Polynomial.evalRingHom (0 : κ₁)).comp ι_slice := by
    rw [← RingHom.comp_assoc, hχ_loc_comp, hχη_φ]

  let f₁ : CommRingCat.of (MvPolynomial (Fin 2) k) ⟶ CommRingCat.of (Polynomial κ₁) :=
    CommRingCat.ofHom ι_slice
  let f₂ : CommRingCat.of (MvPolynomial (Fin 2) k) ⟶ CommRingCat.of R_ηloc :=
    CommRingCat.ofHom φ_ηloc
  let R_line : CommRingCat.{u} := CategoryTheory.Limits.pushout f₁ f₂
  let inl : CommRingCat.of (Polynomial κ₁) ⟶ R_line := CategoryTheory.Limits.pushout.inl f₁ f₂
  let inr : CommRingCat.of R_ηloc ⟶ R_line := CategoryTheory.Limits.pushout.inr f₁ f₂
  have hcond_push : f₁ ≫ CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ₁)) =
      f₂ ≫ CommRingCat.ofHom χ_loc :=
    CommRingCat.hom_ext hχ_loc_φ.symm
  let ε_mor : R_line ⟶ CommRingCat.of κ₁ :=
    CategoryTheory.Limits.pushout.desc
      (CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ₁)))
      (CommRingCat.ofHom χ_loc)
      hcond_push
  let α_1 : Polynomial κ₁ →+* R_line := inl.hom
  let α_2 : R_ηloc →+* R_line := inr.hom
  let ε_line : R_line →+* κ₁ := ε_mor.hom
  have hPb_Rline : CategoryTheory.IsPullback
      (AlgebraicGeometry.Spec.map inl)
      (AlgebraicGeometry.Spec.map inr)
      (AlgebraicGeometry.Spec.map f₁)
      (AlgebraicGeometry.Spec.map f₂) :=
    AlgebraicGeometry.isPullback_SpecMap_of_isPushout f₁ f₂ inl inr
      (CategoryTheory.IsPushout.of_hasPushout f₁ f₂)
  have hf₂_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f₂) :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_ηloc_et
  have hinl_et : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map inl) :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.Etale) hPb_Rline.flip hf₂_et
  have hα_1_et : α_1.Etale :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hinl_et
  have hα_comm : α_1.comp ι_slice = α_2.comp ((algebraMap R_η R_ηloc).comp φ_η) :=
    congrArg CommRingCat.Hom.hom (CategoryTheory.Limits.pushout.condition (f := f₁) (g := f₂))
  have hε_α1 : ε_line.comp α_1 = Polynomial.evalRingHom 0 :=
    congrArg CommRingCat.Hom.hom (CategoryTheory.Limits.pushout.inl_desc _ _ hcond_push)
  have hε_α2_loc : ε_line.comp α_2 = χ_loc :=
    congrArg CommRingCat.Hom.hom (CategoryTheory.Limits.pushout.inr_desc _ _ hcond_push)
  have hε_α2 : (ε_line.comp α_2).comp (algebraMap R_η R_ηloc) = χ_η := by
    rw [hε_α2_loc, hχ_loc_comp]

  
  let χ'_R'η : R'_η →+* κ₁ := χ_η.comp α_R'η.hom
  have hker_χ' : RingHom.ker χ'_R'η = u_η.asIdeal := by
    rw [← hα_q_η]
    ext r'
    change χ_η (α_R'η.hom r') = 0 ↔ r' ∈ Ideal.comap α_R'η.hom q_η.asIdeal
    rw [← RingHom.mem_ker, hker_χη, Ideal.mem_comap]
  let I_η : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R'_η) :=
    Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
      MvPolynomial.C h_η}
