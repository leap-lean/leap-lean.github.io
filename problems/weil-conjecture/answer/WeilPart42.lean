    dsimp [e_Y', q']
    rw [Category.assoc, heY_f, Category.assoc]
  have hcomm_eaff : (p_V0 ≫ e_Y') ≫ f_line.left = p_Vbar ≫ g_V := by
    rw [Category.assoc, heY'_f, ← Category.assoc q', ← Category.assoc p_V0,
      Limits.pullback.condition, Category.assoc, hg_R'_eB]
  let e_aff : V_aff ⟶ Y_V := Limits.pullback.lift (p_V0 ≫ e_Y') p_Vbar hcomm_eaff
  have _ : AlgebraicGeometry.Etale e_aff := by
    let B_et := Limits.pullback g_V e_B
    let p_B1 : B_et ⟶ Spec (CommRingCat.of ↥V_0) := Limits.pullback.fst g_V e_B
    let p_B2 : B_et ⟶ Spec R'_cat := Limits.pullback.snd g_V e_B
    have hp_B1_et : Etale p_B1 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g_V e_B).flip he_B
    let σ_B : Spec (CommRingCat.of ↥V_0) ⟶ B_et :=
      Limits.pullback.lift (𝟙 _) g_R' (by rw [Category.id_comp, hg_R'_eB])
    have hσ_B_et : Etale σ_B := by
      refine CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale) σ_B p_B1 hp_B1_et ?_
      rw [Limits.pullback.lift_fst]
      infer_instance
    let P_et := Limits.pullback fst_V e_Y'
    let π_1 : P_et ⟶ Y_V := Limits.pullback.fst fst_V e_Y'
    let π_2 : P_et ⟶ V₀ := Limits.pullback.snd fst_V e_Y'
    have _ : Etale π_1 :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback fst_V e_Y').flip inferInstance
    have hcomm_β : (π_1 ≫ snd_V) ≫ g_V = (π_2 ≫ (q' ≫ π_M')) ≫ e_B := by
      rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, Limits.pullback.condition,
        Category.assoc, heY'_f]
      simp only [π_2, q', Category.assoc]
    let β_et : P_et ⟶ B_et := Limits.pullback.lift (π_1 ≫ snd_V) (π_2 ≫ (q' ≫ π_M')) hcomm_β
    have hPb_Pet_0 : CategoryTheory.IsPullback (π_1 ≫ snd_V) π_2 g_V ((q' ≫ π_M') ≫ e_B) := by
      have hPaste := (CategoryTheory.IsPullback.of_hasPullback fst_V e_Y').paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f_line.left g_V).flip
      rw [heY'_f, ← Category.assoc q'] at hPaste
      exact hPaste
    have hPb_β : CategoryTheory.IsPullback β_et π_2 p_B2 (q' ≫ π_M') := by
      refine CategoryTheory.IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback g_V e_B)
      rw [Limits.pullback.lift_fst]
      exact hPb_Pet_0
    let α : V_aff ⟶ P_et := Limits.pullback.lift e_aff p_V0 (Limits.pullback.lift_fst _ _ _)
    have hα_β : α ≫ β_et = p_Vbar ≫ σ_B := by
      have hp_cond : p_V0 ≫ (q' ≫ π_M') = p_Vbar ≫ g_R' := Limits.pullback.condition
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_fst, Category.comp_id]
      · calc (α ≫ β_et) ≫ Limits.pullback.snd g_V e_B
            = (α ≫ π_2) ≫ (q' ≫ π_M') := by
              rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc]
          _ = p_V0 ≫ (q' ≫ π_M') := by rw [Limits.pullback.lift_snd]
          _ = p_Vbar ≫ g_R' := hp_cond
          _ = (p_Vbar ≫ σ_B) ≫ Limits.pullback.snd g_V e_B := by
              rw [Category.assoc, Limits.pullback.lift_snd]
    have hPb_α : CategoryTheory.IsPullback α p_Vbar β_et σ_B := by
      refine CategoryTheory.IsPullback.of_right ?_ hα_β hPb_β.flip
      rw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      exact CategoryTheory.IsPullback.of_hasPullback (q' ≫ π_M') g_R'
    have _ : Etale α :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_α.flip hσ_B_et
    have hα_π1 : α ≫ π_1 = e_aff := Limits.pullback.lift_fst _ _ _
    rw [← hα_π1]
    infer_instance
  have hv_eaff : v_aff ≫ e_aff = x_bar_V := by
    apply Limits.pullback.hom_ext
    · change (v_aff ≫ e_aff) ≫ fst_V = x_bar_V ≫ fst_V
      rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
        hv_eY', hx_fst]
    · change (v_aff ≫ e_aff) ≫ snd_V = x_bar_V ≫ snd_V
      rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, hx_snd]
  have hv_qaff : v_aff ≫ q_aff = zero_M := by
    let θ_hom : CommRingCat.of M_V_ring ⟶ CommRingCat.of κ := Spec.preimage (v_aff ≫ q_aff)
    have hSpec_θ : Spec.map θ_hom = v_aff ≫ q_aff := Spec.map_preimage (v_aff ≫ q_aff)
    rw [← hSpec_θ]
    dsimp [zero_M]
    congr 1
    apply CommRingCat.hom_ext
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext'
    · ext r
      have hC_eq : Spec.map (c_MV ≫ θ_hom) = i_cl := by
        rw [Spec.map_comp, hSpec_θ, Category.assoc, hPb_M.lift_snd, Limits.pullback.lift_snd]
      have hC_hom := congrArg (fun φ => φ.hom r) (Spec.map_injective hC_eq)
      change θ_hom.hom (Ideal.Quotient.mk I_V (MvPolynomial.C r)) = ε_pre (MvPolynomial.C r)
      rw [MvPolynomial.eval₂Hom_C]
      exact hC_hom
    · intro idx
      have hX_eq : Spec.map (ψ_M_hom ≫ θ_hom) = v_tilde ≫ q' := by
        rw [Spec.map_comp, hSpec_θ, Category.assoc, hPb_M.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst]
      have hpt_eq := congrArg (fun f => f.base pt_κ) hX_eq
      have hmem : Ideal.Quotient.mk I' (MvPolynomial.X idx) ∈
          ((Spec.map (ψ_M_hom ≫ θ_hom)).base pt_κ).asIdeal := by
        rw [hpt_eq]
        change Ideal.Quotient.mk I' (MvPolynomial.X idx) ∈
          (q.base (O_V.ι.base (v_tilde.base pt_κ))).asIdeal
        rw [hv_pt]
        exact hq_X idx
      have hval0 : θ_hom.hom (ψ_M_hom.hom (Ideal.Quotient.mk I' (MvPolynomial.X idx))) = 0 := hmem
      have hψ_X_idx : ψ_M_hom.hom (Ideal.Quotient.mk I' (MvPolynomial.X idx)) =
          Ideal.Quotient.mk I_V (MvPolynomial.X idx) := by
        change Ideal.Quotient.mk I_V (MvPolynomial.map β_V (MvPolynomial.X idx)) = _
        rw [MvPolynomial.map_X]
      rw [hψ_X_idx] at hval0
      change θ_hom.hom (Ideal.Quotient.mk I_V (MvPolynomial.X idx)) = ε_pre (MvPolynomial.X idx)
      rw [hval0, MvPolynomial.eval₂Hom_X']

  
  let w_star : ↥V_aff := v_aff.base pt_κ
  have hSpurClosed : ∀ (X : Scheme.{u}) (x_0 : Spec (CommRingCat.of κ) ⟶ X)
      [IsClosedImmersion x_0] (f : V_aff ⟶ X) [Etale f],
      v_aff ≫ f = x_0 →
      IsClosed ((f.base ⁻¹' Set.range x_0.base) \ {w_star}) := by
    intro X x_0 _ f _ hf
    let F_x := Limits.pullback f x_0
    let ι_F : F_x ⟶ V_aff := Limits.pullback.fst f x_0
    let π_F : F_x ⟶ Spec (CommRingCat.of κ) := Limits.pullback.snd f x_0
    have _ : IsAffine F_x := AlgebraicGeometry.isAffine_of_isAffineHom ι_F
    let z_star : ↥F_x := (Limits.pullback.lift v_aff (𝟙 _) (by rw [Category.id_comp, hf])).base pt_κ
    have hz_star : ι_F.base z_star = w_star := by
      change (Limits.pullback.lift v_aff (𝟙 _) _ ≫ ι_F).base pt_κ = w_star
      rw [Limits.pullback.lift_fst]
    let A_F_cat := F_x.presheaf.obj (Opposite.op ⊤)
    let A_F := ↑A_F_cat
    have _ : Etale (F_x.isoSpec.inv ≫ π_F) := inferInstance
    let c_F_hom := Spec.preimage (F_x.isoSpec.inv ≫ π_F)
    have hc_et : c_F_hom.hom.Etale :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mp (by rw [Spec.map_preimage]; infer_instance)
    let _ : Algebra κ A_F := c_F_hom.hom.toAlgebra
    have _ : Algebra.Etale κ A_F := RingHom.etale_algebraMap.mp hc_et
    obtain ⟨I_idx, hFin_I, L_fld, hFld_L, _, Φ, _⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ A_F).mp inferInstance
    let _ : ∀ i : I_idx, Field (L_fld i) := hFld_L
    let _ : Fintype I_idx := Fintype.ofFinite I_idx
    let _ : DecidableEq I_idx := Classical.decEq I_idx
    let p_star : PrimeSpectrum A_F := F_x.isoSpec.hom.base z_star
    let δ_fn : I_idx → (∀ i : I_idx, L_fld i) :=
      fun c i => if i = c then 1 else 0
    have hsum1 : (∑ c : I_idx, Φ.symm (δ_fn c)) = 1 := by
      rw [← map_sum]
      have h1 : (∑ c : I_idx, δ_fn c) = 1 := by
        ext i
        simp [δ_fn]
      rw [h1, map_one]
    have hex_c0 : ∃ c₀ : I_idx, Φ.symm (δ_fn c₀) ∉ p_star.asIdeal := by
      by_contra h_none
      have h_all : ∀ c : I_idx, Φ.symm (δ_fn c) ∈ p_star.asIdeal := fun c =>
        Classical.not_not.mp (fun hnc => h_none ⟨c, hnc⟩)
      have h1_mem : (1 : A_F) ∈ p_star.asIdeal := by
        rw [← hsum1]
        exact Ideal.sum_mem p_star.asIdeal (fun c _ => h_all c)
      exact p_star.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr h1_mem)
    obtain ⟨c₀, hc₀⟩ := hex_c0
    have hMemIff : ∀ (q_p : PrimeSpectrum A_F),
        Φ.symm (δ_fn c₀) ∉ q_p.asIdeal → ∀ a : A_F, a ∈ q_p.asIdeal ↔ (Φ a) c₀ = 0 := by
      intro q_p hqp a
      constructor
      · intro ha
        by_contra hne
        let b_inv : ∀ i : I_idx, L_fld i := fun i => ((Φ a) i)⁻¹ * δ_fn c₀ i
        have hmul : Φ a * b_inv = δ_fn c₀ := by
          ext i
          by_cases hi : i = c₀
          · subst hi
            change Φ a i * ((Φ a i)⁻¹ * (if i = i then 1 else 0)) = if i = i then 1 else 0
            simp only [↓reduceIte, mul_one]
            exact mul_inv_cancel₀ hne
          · change Φ a i * ((Φ a i)⁻¹ * (if i = c₀ then 1 else 0)) = if i = c₀ then 1 else 0
            simp [hi]
        have hmul_A : a * Φ.symm b_inv = Φ.symm (δ_fn c₀) := by
          apply Φ.injective
          rw [map_mul, Φ.apply_symm_apply, Φ.apply_symm_apply, hmul]
        exact hqp (hmul_A ▸ q_p.asIdeal.mul_mem_right _ ha)
      · intro h0
        have hmul : Φ a * δ_fn c₀ = 0 := by
          ext i
          by_cases hi : i = c₀
          · subst hi
            simp [δ_fn, h0]
          · simp [δ_fn, hi]
        have hmul_A : a * Φ.symm (δ_fn c₀) = 0 := by
          apply Φ.injective
          rw [map_mul, Φ.apply_symm_apply, hmul, map_zero]
        rcases q_p.isPrime.mem_or_mem (hmul_A ▸ q_p.asIdeal.zero_mem) with ha | hδ
        · exact ha
        · exact False.elim (hqp hδ)
    have hBasicEq : (PrimeSpectrum.basicOpen (Φ.symm (δ_fn c₀)) : Set (PrimeSpectrum A_F)) =
        {p_star} := by
      ext q_p
      change Φ.symm (δ_fn c₀) ∉ q_p.asIdeal ↔ q_p = p_star
      constructor
      · intro hqp
        apply PrimeSpectrum.ext
        ext a
        exact (hMemIff q_p hqp a).trans (hMemIff p_star hc₀ a).symm
      · rintro rfl
        exact hc₀
    have hOpen_p : IsOpen ({p_star} : Set (PrimeSpectrum A_F)) := by
      rw [← hBasicEq]
      exact (PrimeSpectrum.basicOpen _).isOpen
    have hPre_z : F_x.isoSpec.hom.base ⁻¹' ({p_star} : Set (PrimeSpectrum A_F)) = {z_star} := by
      ext z
      change F_x.isoSpec.hom.base z = p_star ↔ z = z_star
      constructor
      · intro hz
        have h1 := congrArg F_x.isoSpec.inv.base hz
        change (F_x.isoSpec.hom ≫ F_x.isoSpec.inv).base z =
          (F_x.isoSpec.hom ≫ F_x.isoSpec.inv).base z_star at h1
        simpa using h1
      · rintro rfl
        rfl
    have hOpen_z : IsOpen ({z_star} : Set ↥F_x) := by
      rw [← hPre_z]
      exact F_x.isoSpec.hom.continuous.isOpen_preimage _ hOpen_p
    have hClosed_compl : IsClosed (({z_star} : Set ↥F_x)ᶜ) := hOpen_z.isClosed_compl
    have hImg_eq : ι_F.base '' (({z_star} : Set ↥F_x)ᶜ) =
        (f.base ⁻¹' Set.range x_0.base) \ {w_star} := by
      have hInj : Function.Injective ι_F.base := ι_F.isClosedEmbedding.injective
      have hRng : Set.range ι_F.base = f.base ⁻¹' Set.range x_0.base :=
        AlgebraicGeometry.Scheme.Pullback.range_fst f x_0
      ext y
      simp only [Set.mem_image, Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_sdiff, ← hRng,
        Set.mem_range]
      constructor
      · rintro ⟨z, hz_ne, rfl⟩
        exact ⟨⟨z, rfl⟩, fun h_eq => hz_ne (hInj (h_eq.trans hz_star.symm))⟩
      · rintro ⟨⟨z, rfl⟩, hy_ne⟩
        exact ⟨z, fun hz_eq => hy_ne (hz_eq ▸ hz_star), rfl⟩
    rw [← hImg_eq]
    exact ι_F.isClosedEmbedding.isClosedMap _ hClosed_compl
  have hC_e : IsClosed ((e_aff.base ⁻¹' Set.range x_bar_V.base) \ {w_star}) :=
    hSpurClosed Y_V x_bar_V e_aff hv_eaff
  have hC_q : IsClosed ((q_aff.base ⁻¹' Set.range zero_M.base) \ {w_star}) :=
    hSpurClosed _ zero_M q_aff hv_qaff
  let C_bad : Set ↥V_aff :=
    ((e_aff.base ⁻¹' Set.range x_bar_V.base) \ {w_star}) ∪
      ((q_aff.base ⁻¹' Set.range zero_M.base) \ {w_star})
  let U_good : V_aff.Opens := ⟨C_badᶜ, (hC_e.union hC_q).isOpen_compl⟩
  have hw_good : w_star ∈ U_good := by
    change w_star ∉ C_bad
    simp [C_bad]
  have hRange_vaff : Set.range v_aff.base ⊆ Set.range U_good.ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨pt, rfl⟩
    rw [hFieldPt pt]
    exact hw_good
  let W_V := U_good.toScheme
  let v_W : Spec (CommRingCat.of κ) ⟶ W_V := IsOpenImmersion.lift U_good.ι v_aff hRange_vaff
  have hv_W_fac : v_W ≫ U_good.ι = v_aff := IsOpenImmersion.lift_fac U_good.ι v_aff hRange_vaff
  let e_W : W_V ⟶ Y_V := U_good.ι ≫ e_aff
  let q_M : W_V ⟶ weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V := U_good.ι ≫ q_aff
  have hvW_eW : v_W ≫ e_W = x_bar_V := by
    dsimp [e_W]
    rw [← Category.assoc, hv_W_fac, hv_eaff]
  have hvW_qM : v_W ≫ q_M = zero_M := by
    dsimp [q_M]
    rw [← Category.assoc, hv_W_fac, hv_qaff]
  have hPre_e : e_W.base ⁻¹' (Set.range x_bar_V.base) = Set.range v_W.base := by
    ext u
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · intro hu
      have hu_good : U_good.ι.base u ∈ U_good := u.2
      change U_good.ι.base u ∉ C_bad at hu_good
      have hu_eq : U_good.ι.base u = w_star := by
        by_contra hne
        exact hu_good (Or.inl ⟨hu, hne⟩)
      refine ⟨pt_κ, U_good.ι.isOpenEmbedding.injective ?_⟩
      change (v_W ≫ U_good.ι).base pt_κ = U_good.ι.base u
      rw [hv_W_fac, hu_eq]
    · rintro ⟨pt, rfl⟩
      exact ⟨pt, congrArg (fun φ => φ.base pt) hvW_eW.symm⟩
  have hPre_q : q_M.base ⁻¹' (Set.range zero_M.base) = Set.range v_W.base := by
    ext u
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · intro hu
      have hu_good : U_good.ι.base u ∈ U_good := u.2
      change U_good.ι.base u ∉ C_bad at hu_good
      have hu_eq : U_good.ι.base u = w_star := by
        by_contra hne
        exact hu_good (Or.inr ⟨hu, hne⟩)
      refine ⟨pt_κ, U_good.ι.isOpenEmbedding.injective ?_⟩
      change (v_W ≫ U_good.ι).base pt_κ = U_good.ι.base u
      rw [hv_W_fac, hu_eq]
    · rintro ⟨pt, rfl⟩
      exact ⟨pt, congrArg (fun φ => φ.base pt) hvW_qM.symm⟩

  
  have hMapGood : ∀ (α_V : V_aff ≅ V_aff) (α_Y : Y_V ≅ Y_V)
      (α_M : weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V ≅
        weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V),
      v_aff ≫ α_V.hom = v_aff →
      x_bar_V ≫ α_Y.inv = x_bar_V →
      zero_M ≫ α_M.inv = zero_M →
      α_V.hom ≫ e_aff = e_aff ≫ α_Y.hom →
      α_V.hom ≫ q_aff = q_aff ≫ α_M.hom →
      Set.range (U_good.ι ≫ α_V.hom).base ⊆ Set.range U_good.ι.base := by
    intro α_V α_Y α_M hα_v hαY_inv hαM_inv hα_e hα_q
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨u, rfl⟩
    have hu_good : u.1 ∉ C_bad := u.2
    intro hbad
    have hw_ne : α_V.hom.base u.1 ≠ w_star → u.1 ≠ w_star := by
      intro hne h_eq
      apply hne
      rw [h_eq]
      exact congrArg (fun φ => φ.base pt_κ) hα_v
    rcases hbad with ⟨⟨pt, hpt⟩, hne⟩ | ⟨⟨pt, hpt⟩, hne⟩
    · have he_u : e_aff.base u.1 = x_bar_V.base pt := by
        calc e_aff.base u.1
            = (e_aff ≫ α_Y.hom ≫ α_Y.inv).base u.1 := by
              rw [α_Y.hom_inv_id, Category.comp_id]
          _ = α_Y.inv.base ((α_V.hom ≫ e_aff).base u.1) := by
              rw [hα_e]; rfl
          _ = (x_bar_V ≫ α_Y.inv).base pt := congrArg α_Y.inv.base hpt.symm
          _ = x_bar_V.base pt := by rw [hαY_inv]
      exact hu_good (Or.inl ⟨⟨pt, he_u.symm⟩, hw_ne hne⟩)
    · have hq_u : q_aff.base u.1 = zero_M.base pt := by
        calc q_aff.base u.1
            = (q_aff ≫ α_M.hom ≫ α_M.inv).base u.1 := by
              rw [α_M.hom_inv_id, Category.comp_id]
          _ = α_M.inv.base ((α_V.hom ≫ q_aff).base u.1) := by
              rw [hα_q]; rfl
          _ = (zero_M ≫ α_M.inv).base pt := congrArg α_M.inv.base hpt.symm
          _ = zero_M.base pt := by rw [hαM_inv]
      exact hu_good (Or.inr ⟨⟨pt, hq_u.symm⟩, hw_ne hne⟩)
  have hEquiv : ∀ (γ_V : ↥V_0 ≃+* ↥V_0),
      γ_V.toRingHom.comp p_V = p_V →
      π_V0.comp γ_V.toRingHom = π_V0 →
      γ_V h_V = h_V ∧
      ∀ (τ_Y : Y_V ≅ Y_V)
        (τ_M : weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V ≅
          weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V),
        τ_Y.hom ≫ fst_V = fst_V →
        τ_Y.hom ≫ snd_V =
          snd_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom) →
        (∀ idx : Fin (m + 1) × Fin 2,
          (AlgebraicGeometry.Spec.preimage τ_M.hom).hom
            (Ideal.Quotient.mk _ (MvPolynomial.X idx)) =
          Ideal.Quotient.mk _ (MvPolynomial.X idx)) →
        (∀ r : ↥V_0,
          (AlgebraicGeometry.Spec.preimage τ_M.hom).hom
            (Ideal.Quotient.mk _ (MvPolynomial.C r)) =
          Ideal.Quotient.mk _ (MvPolynomial.C (γ_V r))) →
        ∃ τ_W : W_V ≅ W_V,
          v_W ≫ τ_W.hom = v_W ∧
          τ_W.hom ≫ e_W = e_W ≫ τ_Y.hom ∧
          τ_W.hom ≫ q_M = q_M ≫ τ_M.hom := by
    intro γ_V hγ_pV hπ_γ
    have hγ_β : γ_V.toRingHom.comp β_V = β_V := by
      refine hβ_uniq (γ_V.toRingHom.comp β_V) ⟨?_, ?_⟩
      · rw [RingHom.comp_assoc, hβ_θ, hγ_pV]
      · rw [← RingHom.comp_assoc, hπ_γ, hπ_β]
    have hγ_hV : γ_V h_V = h_V := RingHom.congr_fun hγ_β h
    have hγ_symm_β : γ_V.symm.toRingHom.comp β_V = β_V := by
      apply RingHom.ext
      intro r
      apply γ_V.injective
      change γ_V (γ_V.symm (β_V r)) = γ_V (β_V r)
      rw [γ_V.apply_symm_apply]
      exact (RingHom.congr_fun hγ_β r).symm
    refine ⟨hγ_hV, fun τ_Y τ_M hτY_fst hτY_snd hτM_X hτM_C => ?_⟩
    let α_γ : Spec (CommRingCat.of ↥V_0) ⟶ Spec (CommRingCat.of ↥V_0) :=
      Spec.map (CommRingCat.ofHom γ_V.toRingHom)
    let α_γ_inv : Spec (CommRingCat.of ↥V_0) ⟶ Spec (CommRingCat.of ↥V_0) :=
      Spec.map (CommRingCat.ofHom γ_V.symm.toRingHom)
    have hα_gR' : α_γ ≫ g_R' = g_R' := by
      dsimp [α_γ, g_R']
      rw [← Spec.map_comp]
      apply congrArg Spec.map
      apply CommRingCat.hom_ext
      exact hγ_β
    have hα_inv_gR' : α_γ_inv ≫ g_R' = g_R' := by
      dsimp [α_γ_inv, g_R']
      rw [← Spec.map_comp]
      apply congrArg Spec.map
      apply CommRingCat.hom_ext
      exact hγ_symm_β
    have hi_cl_α : i_cl ≫ α_γ = i_cl := by
      dsimp [i_cl, α_γ]
      rw [← Spec.map_comp]
      apply congrArg Spec.map
      apply CommRingCat.hom_ext
      exact hπ_γ
    have hα_hom_inv : α_γ ≫ α_γ_inv = 𝟙 _ := by
      dsimp [α_γ, α_γ_inv]
      rw [← Spec.map_comp, ← Spec.map_id]
      apply congrArg Spec.map
      apply CommRingCat.hom_ext
      exact RingHom.ext γ_V.apply_symm_apply
    have hα_inv_hom : α_γ_inv ≫ α_γ = 𝟙 _ := by
      dsimp [α_γ, α_γ_inv]
      rw [← Spec.map_comp, ← Spec.map_id]
      apply congrArg Spec.map
      apply CommRingCat.hom_ext
      exact RingHom.ext γ_V.symm_apply_apply
    have hp_Vaff_cond : p_V0 ≫ (q' ≫ π_M') = p_Vbar ≫ g_R' := Limits.pullback.condition
    let τ_aff : V_aff ≅ V_aff :=
      { hom := Limits.pullback.lift p_V0 (p_Vbar ≫ α_γ)
          (by rw [Category.assoc p_Vbar, hα_gR']; exact hp_Vaff_cond)
        inv := Limits.pullback.lift p_V0 (p_Vbar ≫ α_γ_inv)
          (by rw [Category.assoc p_Vbar, hα_inv_gR']; exact hp_Vaff_cond)
        hom_inv_id := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
              Category.id_comp]
          · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
              Limits.pullback.lift_snd, Category.assoc, hα_hom_inv, Category.comp_id,
              Category.id_comp]
        inv_hom_id := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
              Category.id_comp]
          · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
              Limits.pullback.lift_snd, Category.assoc, hα_inv_hom, Category.comp_id,
              Category.id_comp] }
    have hτaff_v : v_aff ≫ τ_aff.hom = v_aff := by
      apply Limits.pullback.hom_ext
      · dsimp [τ_aff]
        rw [Category.assoc, Limits.pullback.lift_fst]
      · dsimp [τ_aff]
        rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.lift_snd, hi_cl_α]
    have hτaff_e : τ_aff.hom ≫ e_aff = e_aff ≫ τ_Y.hom := by
      apply Limits.pullback.hom_ext
      · change (τ_aff.hom ≫ e_aff) ≫ fst_V = (e_aff ≫ τ_Y.hom) ≫ fst_V
        dsimp [τ_aff, e_aff]
        rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst, Category.assoc, hτY_fst, Limits.pullback.lift_fst]
      · change (τ_aff.hom ≫ e_aff) ≫ snd_V = (e_aff ≫ τ_Y.hom) ≫ snd_V
        dsimp [τ_aff, e_aff]
        rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd,
          Category.assoc, hτY_snd, ← Category.assoc, Limits.pullback.lift_snd]
    have hτaff_q : τ_aff.hom ≫ q_aff = q_aff ≫ τ_M.hom := by
      let φ_τM : CommRingCat.of M_V_ring ⟶ CommRingCat.of M_V_ring := Spec.preimage τ_M.hom
      have hSpec_τM : Spec.map φ_τM = τ_M.hom := Spec.map_preimage τ_M.hom
      have hτM_ψ : τ_M.hom ≫ Spec.map ψ_M_hom = Spec.map ψ_M_hom := by
        rw [← hSpec_τM, ← Spec.map_comp]
        apply congrArg Spec.map
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply MvPolynomial.ringHom_ext'
        · ext r
          change φ_τM.hom (Ideal.Quotient.mk I_V (MvPolynomial.map β_V (MvPolynomial.C r))) =
            Ideal.Quotient.mk I_V (MvPolynomial.map β_V (MvPolynomial.C r))
          rw [MvPolynomial.map_C, hτM_C (β_V r)]
          have hγ_r : γ_V (β_V r) = β_V r := RingHom.congr_fun hγ_β r
          rw [hγ_r]
        · intro idx
          change φ_τM.hom (Ideal.Quotient.mk I_V (MvPolynomial.map β_V (MvPolynomial.X idx))) =
            Ideal.Quotient.mk I_V (MvPolynomial.map β_V (MvPolynomial.X idx))
          rw [MvPolynomial.map_X, hτM_X idx]
      have hτM_π : τ_M.hom ≫ π_MV = π_MV ≫ α_γ := by
        dsimp [π_MV, α_γ]
        rw [← hSpec_τM, ← Spec.map_comp, ← Spec.map_comp]
        apply congrArg Spec.map
        apply CommRingCat.hom_ext
        ext r
        exact hτM_C r
      apply hPb_M.hom_ext
      · rw [Category.assoc, hPb_M.lift_fst, ← Category.assoc,
          Limits.pullback.lift_fst (f := q' ≫ π_M'), Category.assoc, hτM_ψ, hPb_M.lift_fst]
      · rw [Category.assoc, hPb_M.lift_snd, Category.assoc, hτM_π, ← Category.assoc,
          hPb_M.lift_snd]
        exact Limits.pullback.lift_snd _ _ _
    have hτaff_inv_v : v_aff ≫ τ_aff.inv = v_aff := by
      calc v_aff ≫ τ_aff.inv = (v_aff ≫ τ_aff.hom) ≫ τ_aff.inv := by rw [hτaff_v]
        _ = v_aff := by rw [Category.assoc, τ_aff.hom_inv_id, Category.comp_id]
    have hτY_x : x_bar_V ≫ τ_Y.hom = x_bar_V := by
      rw [← hv_eaff, Category.assoc, ← hτaff_e, ← Category.assoc, hτaff_v]
    have hτY_inv_x : x_bar_V ≫ τ_Y.inv = x_bar_V := by
      calc x_bar_V ≫ τ_Y.inv = (x_bar_V ≫ τ_Y.hom) ≫ τ_Y.inv := by rw [hτY_x]
        _ = x_bar_V := by rw [Category.assoc, τ_Y.hom_inv_id, Category.comp_id]
    have hτM_z : zero_M ≫ τ_M.hom = zero_M := by
      rw [← hv_qaff, Category.assoc, ← hτaff_q, ← Category.assoc, hτaff_v]
    have hτM_inv_z : zero_M ≫ τ_M.inv = zero_M := by
      calc zero_M ≫ τ_M.inv = (zero_M ≫ τ_M.hom) ≫ τ_M.inv := by rw [hτM_z]
        _ = zero_M := by rw [Category.assoc, τ_M.hom_inv_id, Category.comp_id]
    have hτaff_inv_e : τ_aff.inv ≫ e_aff = e_aff ≫ τ_Y.inv := by
      calc τ_aff.inv ≫ e_aff
          = τ_aff.inv ≫ (e_aff ≫ τ_Y.hom) ≫ τ_Y.inv := by
            rw [Category.assoc, τ_Y.hom_inv_id, Category.comp_id]
        _ = (τ_aff.inv ≫ τ_aff.hom) ≫ e_aff ≫ τ_Y.inv := by
            rw [← hτaff_e]; simp only [Category.assoc]
        _ = e_aff ≫ τ_Y.inv := by rw [τ_aff.inv_hom_id, Category.id_comp]
    have hτaff_inv_q : τ_aff.inv ≫ q_aff = q_aff ≫ τ_M.inv := by
      calc τ_aff.inv ≫ q_aff
          = τ_aff.inv ≫ (q_aff ≫ τ_M.hom) ≫ τ_M.inv := by
            rw [Category.assoc, τ_M.hom_inv_id, Category.comp_id]
        _ = (τ_aff.inv ≫ τ_aff.hom) ≫ q_aff ≫ τ_M.inv := by
            rw [← hτaff_q]; simp only [Category.assoc]
        _ = q_aff ≫ τ_M.inv := by rw [τ_aff.inv_hom_id, Category.id_comp]
    have hRange_hom : Set.range (U_good.ι ≫ τ_aff.hom).base ⊆ Set.range U_good.ι.base :=
      hMapGood τ_aff τ_Y τ_M hτaff_v hτY_inv_x hτM_inv_z hτaff_e hτaff_q
    have hRange_inv : Set.range (U_good.ι ≫ τ_aff.inv).base ⊆ Set.range U_good.ι.base :=
      hMapGood τ_aff.symm τ_Y.symm τ_M.symm hτaff_inv_v hτY_x hτM_z hτaff_inv_e hτaff_inv_q
    let τ_W_hom : W_V ⟶ W_V := IsOpenImmersion.lift U_good.ι (U_good.ι ≫ τ_aff.hom) hRange_hom
    let τ_W_inv : W_V ⟶ W_V := IsOpenImmersion.lift U_good.ι (U_good.ι ≫ τ_aff.inv) hRange_inv
    have hτW_hom_fac : τ_W_hom ≫ U_good.ι = U_good.ι ≫ τ_aff.hom :=
      IsOpenImmersion.lift_fac U_good.ι (U_good.ι ≫ τ_aff.hom) hRange_hom
    have hτW_inv_fac : τ_W_inv ≫ U_good.ι = U_good.ι ≫ τ_aff.inv :=
      IsOpenImmersion.lift_fac U_good.ι (U_good.ι ≫ τ_aff.inv) hRange_inv
    let τ_W : W_V ≅ W_V :=
      { hom := τ_W_hom
        inv := τ_W_inv
        hom_inv_id := by
          rw [← cancel_mono U_good.ι, Category.assoc, hτW_inv_fac, ← Category.assoc,
            hτW_hom_fac, Category.assoc, τ_aff.hom_inv_id, Category.comp_id, Category.id_comp]
        inv_hom_id := by
          rw [← cancel_mono U_good.ι, Category.assoc, hτW_hom_fac, ← Category.assoc,
            hτW_inv_fac, Category.assoc, τ_aff.inv_hom_id, Category.comp_id, Category.id_comp] }
    refine ⟨τ_W, ?_, ?_, ?_⟩
    · rw [← cancel_mono U_good.ι, Category.assoc, hτW_hom_fac, ← Category.assoc,
        hv_W_fac, hτaff_v]
    · dsimp [τ_W, e_W]
      rw [← Category.assoc, hτW_hom_fac, Category.assoc, hτaff_e, ← Category.assoc]
    · dsimp [τ_W, q_M]
      rw [← Category.assoc, hτW_hom_fac, Category.assoc, hτaff_q, ← Category.assoc]

  refine ⟨h_V, x_bar_V, U_Y, j_Y_open, zero_M, W_V, v_W, e_W, q_M,
    ⟨hh_max, hh_ne⟩,
    ⟨hx_Y_cl, rfl, ?_, ?_⟩,
    hAtlas,
    ⟨inferInstance, inferInstance, hvW_eW, hvW_qM, hzero_X, hzero_C, hPre_e, hPre_q⟩,
    hEquiv⟩
  · rw [hj_Y_fac]
    exact Limits.pullback.lift_fst _ _ _
  · rw [hj_Y_fac]
    exact Limits.pullback.lift_snd _ _ _

theorem weil_dvr_slice_equivariant_quadric_degeneration_and_charts (κ : Type u) [Field κ] [IsAlgClosed κ] (m : ℕ)
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (hSpec2 : ∀ q : Ideal R_bar, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal R_bar)
    (p_R : Polynomial κ →+* R_bar)
    (π_cl : R_bar →+* κ)
    (hπ_ker : RingHom.ker π_cl = IsLocalRing.maximalIdeal R_bar)
    (hπ_pR : π_cl.comp p_R = Polynomial.evalRingHom 0)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (φ_R_Ω : R_bar →+* Ω) (hφ_inj : Function.Injective φ_R_Ω)
    (h_R : R_bar)
    (hh_max : h_R ∈ IsLocalRing.maximalIdeal R_bar) (hh_ne : h_R ≠ 0) :
    let F_amb_k : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) κ :=
      ∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) κ) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
    let F_amb_Ω : MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω :=
      ∑ j ∈ Finset.range (m + 1 + 1),
        if h : 2 * j + 1 < 2 * (m + 1) + 1 + 1 then
          (MvPolynomial.X ⟨2 * j, Nat.lt_of_succ_lt h⟩ :
            MvPolynomial (Fin (2 * (m + 1) + 1 + 1)) Ω) *
            MvPolynomial.X ⟨2 * j + 1, h⟩
        else 0
    let g_k_R : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of κ) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_R.comp Polynomial.C))
    let j_R : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of R_bar) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
    let S_d1 := weilAffineSpaceOver κ (2 * m + 1)
    let A1_R := CategoryTheory.Limits.pullback S_d1.hom g_k_R
    let A1_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d1.hom g_k_R)
    let j_A1 : A1_Ω ⟶ A1_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d1.hom g_k_R)
    let S_d2 := weilAffineSpaceOver κ (2 * (m + 1))
    let A2_R := CategoryTheory.Limits.pullback S_d2.hom g_k_R
    let A2_Ω := CategoryTheory.Limits.pullback j_R
      (CategoryTheory.Limits.pullback.snd S_d2.hom g_k_R)
    let j_A2 : A2_Ω ⟶ A2_R :=
      CategoryTheory.Limits.pullback.snd j_R
        (CategoryTheory.Limits.pullback.snd S_d2.hom g_k_R)
    ∃ (Q_fam : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ)))
      (π_Qfam : Q_fam ⟶ weilPolyLineSpecOver κ)
      (_ : AlgebraicGeometry.IsProper π_Qfam.left)
      (g_hR : AlgebraicGeometry.Spec (CommRingCat.of R_bar) ⟶ (weilPolyLineSpecOver κ).left)
      (Q_succ Z_cone : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ)))
      (_ : AlgebraicGeometry.IsProper Q_succ.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_succ.hom)
      (_ : AlgebraicGeometry.IsProper Z_cone.hom)
      (ι_succ : Q_succ.left ⟶ (weilProjectiveSpaceOver κ (2 * (m + 1) + 1)).left)
      (hι_succ : ι_succ ≫ (weilProjectiveSpaceOver κ (2 * (m + 1) + 1)).hom = Q_succ.hom)
      (i_Z : Z_cone ⟶ Q_succ)
      (Q_amb_Ω Q_sm_Ω : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (_ : AlgebraicGeometry.IsProper Q_amb_Ω.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * (m + 1)) Q_amb_Ω.hom)
      (_ : AlgebraicGeometry.IsProper Q_sm_Ω.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Q_sm_Ω.hom)
      (ι_amb_Ω : Q_amb_Ω.left ⟶ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).left)
      (hι_amb_Ω : ι_amb_Ω ≫ (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1)).hom = Q_amb_Ω.hom)
      (i_sm_Ω : Q_sm_Ω ⟶ Q_amb_Ω)
      (i_hyp_R : CategoryTheory.Limits.pullback π_Qfam.left g_hR ⟶
        CategoryTheory.Limits.pullback Q_succ.hom g_k_R)
      (e_Qk : CategoryTheory.Limits.pullback π_Qfam.left
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) ≫ g_hR) ≅ Z_cone.left)
      (zero_Q : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
        CategoryTheory.Limits.pullback π_Qfam.left g_hR)
      (ι_aff_Q : weilOdpModelSpec m (CommRingCat.of R_bar) h_R ⟶
        CategoryTheory.Limits.pullback π_Qfam.left g_hR)
      (U_Q : (CategoryTheory.Limits.pullback π_Qfam.left g_hR).Opens)
      (j_Q_open : Q_sm_Ω.left ⟶ U_Q.toScheme)
      (j_amb_open : Q_amb_Ω.left ⟶ CategoryTheory.Limits.pullback Q_succ.hom g_k_R),
      (g_hR ≫ (weilPolyLineSpecOver κ).hom = g_k_R ∧
        IsHomogeneousHypersurfacePullbackOver κ (2 * (m + 1) + 1) 2
          (𝟙 (weilProjectiveSpaceOver κ (2 * (m + 1) + 1))) F_amb_k ι_succ ∧
        IsHomogeneousHypersurfacePullbackOver κ (2 * (m + 1) + 1) 1
          (CategoryTheory.Over.homMk ι_succ hι_succ) (MvPolynomial.X 0) i_Z.left ∧
        IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 2
          (𝟙 (weilProjectiveSpaceOver Ω (2 * (m + 1) + 1))) F_amb_Ω ι_amb_Ω ∧
        IsHomogeneousHypersurfacePullbackOver Ω (2 * (m + 1) + 1) 1
          (CategoryTheory.Over.homMk ι_amb_Ω hι_amb_Ω)
          (MvPolynomial.X 0 + MvPolynomial.C (φ_R_Ω h_R) * MvPolynomial.X 1) i_sm_Ω.left) ∧
      (AlgebraicGeometry.IsClosedImmersion zero_Q ∧
        AlgebraicGeometry.IsOpenImmersion ι_aff_Q ∧
        (∀ zero_M : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
            weilOdpModelSpec m (CommRingCat.of R_bar) h_R,
          (∀ (pt : AlgebraicGeometry.Spec (CommRingCat.of κ)) (idx : Fin (m + 1) × Fin 2),
            Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (zero_M.base pt).asIdeal) →
          zero_M ≫ AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_cl) →
          zero_M ≫ ι_aff_Q = zero_Q) ∧
        (U_Q : Set ↥(CategoryTheory.Limits.pullback π_Qfam.left g_hR)) =
          (Set.range zero_Q.base)ᶜ ∧
        j_Q_open ≫ U_Q.ι ≫ i_hyp_R = i_sm_Ω.left ≫ j_amb_open) ∧
      (∀ x : ↥U_Q.toScheme,
        ∃ (V : U_Q.toScheme.Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A1_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Q_sm_Ω.left) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A1_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_Q_open V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A1 φ) ∧
      (∀ x : ↥(CategoryTheory.Limits.pullback Q_succ.hom g_k_R),
        ∃ (V : (CategoryTheory.Limits.pullback Q_succ.hom g_k_R).Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A2_R) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Q_amb_Ω.left) (j_V : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A2_Ω),
          CategoryTheory.IsPullback ι_VU j_V j_amb_open V.ι ∧
          CategoryTheory.IsPullback φ_U j_V j_A2 φ) ∧
      (let Q_R := CategoryTheory.Limits.pullback π_Qfam.left g_hR
       ∀ (γ_V : R_bar ≃+* R_bar),
         γ_V.toRingHom.comp (p_R.comp Polynomial.C) = p_R.comp Polynomial.C →
         π_cl.comp γ_V.toRingHom = π_cl →
         γ_V h_R = h_R →
         AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom) ≫ g_hR = g_hR ∧
         ∀ (τ_M : weilOdpModelSpec m (CommRingCat.of R_bar) h_R ≅
             weilOdpModelSpec m (CommRingCat.of R_bar) h_R),
           (∀ idx : Fin (m + 1) × Fin 2,
             (AlgebraicGeometry.Spec.preimage τ_M.hom).hom
               (Ideal.Quotient.mk _ (MvPolynomial.X idx)) =
             Ideal.Quotient.mk _ (MvPolynomial.X idx)) →
           (∀ r : R_bar,
             (AlgebraicGeometry.Spec.preimage τ_M.hom).hom
               (Ideal.Quotient.mk _ (MvPolynomial.C r)) =
             Ideal.Quotient.mk _ (MvPolynomial.C (γ_V r))) →
           ∃ (τ_Q : Q_R ≅ Q_R) (τ_UQ : U_Q.toScheme ≅ U_Q.toScheme),
             τ_Q.hom ≫ CategoryTheory.Limits.pullback.fst π_Qfam.left g_hR =
               CategoryTheory.Limits.pullback.fst π_Qfam.left g_hR ∧
             τ_Q.hom ≫ CategoryTheory.Limits.pullback.snd π_Qfam.left g_hR =
               CategoryTheory.Limits.pullback.snd π_Qfam.left g_hR ≫
                 AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom) ∧
             zero_Q ≫ τ_Q.hom = zero_Q ∧
             τ_UQ.hom ≫ U_Q.ι = U_Q.ι ≫ τ_Q.hom ∧
             τ_M.hom ≫ ι_aff_Q = ι_aff_Q ≫ τ_Q.hom) :=
by
