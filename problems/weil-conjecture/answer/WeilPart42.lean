    have _ : AlgebraicGeometry.Etale h_Px := hh_Px_et
    have hv_et : AlgebraicGeometry.Etale v_x.left := inferInstance
    have hv_p : v_x.left.base p_x = x :=
      (congrArg π₁.base hh_Px_p).trans hz₁
    let t_Ex : E_x ⟶ T_V := hT_V.from E_x
    let ev_C : ↥A_open →+ ↥(C_V.obj.obj (Opposite.op E_x)) :=
      ((C_V.obj.map (Opposite.op t_Ex)).hom).comp (adj_const.unit.app A_open).hom
    have hev_C_eq : ∀ a : ↥A_open,
        ev_C a = θ_V E_x (LocallyConstant.const ↥E_x.left a) :=
      fun a => (congrArg (C_V.obj.map (Opposite.op t_Ex)).hom (hθ_V_unit a).symm).trans
        (hθ_V_nat t_Ex (LocallyConstant.const ↥T_V.left a))
    have _ : IsDomain ↑R_x := hDom_x
    have hev_C_bij : Function.Bijective ev_C := by
      have h_fn : (ev_C : ↥A_open → ↥(C_V.obj.obj (Opposite.op E_x))) =
          θ_V E_x ∘ LocallyConstant.constAddMonoidHom (X := ↥E_x.left) (Y := ↥A_open) :=
        funext hev_C_eq
      rw [h_fn]
      exact (θ_V E_x).bijective.comp (hConstBij ↑R_x ↥A_open)
    have hΦ_ev : ∀ a : ↥A_open,
        (Φ.hom.app (Opposite.op E_x)).hom (ev_C a) =
          (ℋ.obj.map (Opposite.op u_x)).hom (s_y y a) := by
      intro a
      have hnat : (Φ.hom.app (Opposite.op E_x)).hom (ev_C a) =
          (ℋ.obj.map (Opposite.op t_Ex)).hom
            ((Φ.hom.app (Opposite.op T_V)).hom ((adj_const.unit.app A_open).hom a)) :=
        ConcreteCategory.congr_hom (Φ.hom.naturality (Opposite.op t_Ex))
          ((adj_const.unit.app A_open).hom a)
      have h_unit_a : (Φ.hom.app (Opposite.op T_V)).hom ((adj_const.unit.app A_open).hom a) =
          α_glob.hom a :=
        ConcreteCategory.congr_hom hΦ_unit a
      have ht_eq : t_Ex = u_x ≫ u_cov y := hT_V.hom_ext t_Ex (u_x ≫ u_cov y)
      exact hnat.trans
        ((congrArg (ℋ.obj.map (Opposite.op t_Ex)).hom h_unit_a).trans
          ((congrArg (fun m => (ℋ.obj.map (Opposite.op m)).hom (α_glob.hom a)) ht_eq).trans
            ((hResComp u_x (u_cov y) (α_glob.hom a)).trans
              (congrArg (ℋ.obj.map (Opposite.op u_x)).hom (hα_glob_res y a)))))
    have h_rhs_bij : Function.Bijective (((ℋ.obj.map (Opposite.op u_x)).hom) ∘ s_y y) :=
      (hResDomBij y R_x hDom_x φ_x h_et_x u_x).comp (hs_y_bij y)
    have h_comp_bij : Function.Bijective ((Φ.hom.app (Opposite.op E_x)).hom ∘ ev_C) := by
      have h_fn : ((Φ.hom.app (Opposite.op E_x)).hom ∘ ev_C) =
          ((ℋ.obj.map (Opposite.op u_x)).hom ∘ s_y y) := funext hΦ_ev
      rw [h_fn]
      exact h_rhs_bij
    exact ⟨E_x, v_x, p_x, hv_et, hv_p, (Function.Bijective.of_comp_iff _ hev_C_bij).mp h_comp_bij⟩
  have hLocInj_Φ : CategoryTheory.Presheaf.IsLocallyInjective V.smallEtaleTopology Φ.hom :=
    CategoryTheory.Presheaf.IsLocallyInjective.mk fun {U} c₁ c₂ h_eq =>
      (hMem V U.unop _).mpr fun x => by
        obtain ⟨E_x, v_x, p_x, hv_et, hv_p, hv_bij⟩ := hRefBij U.unop x
        have hnat₁ := ConcreteCategory.congr_hom (Φ.hom.naturality (Opposite.op v_x)) c₁
        have hnat₂ := ConcreteCategory.congr_hom (Φ.hom.naturality (Opposite.op v_x)) c₂
        have h_ap : (Φ.hom.app (Opposite.op E_x)).hom ((C_V.obj.map (Opposite.op v_x)).hom c₁) =
            (Φ.hom.app (Opposite.op E_x)).hom ((C_V.obj.map (Opposite.op v_x)).hom c₂) :=
          hnat₁.trans ((congrArg (ℋ.obj.map (Opposite.op v_x)).hom h_eq).trans hnat₂.symm)
        exact ⟨E_x, v_x, p_x, hv_bij.1 h_ap, hv_et, hv_p⟩
  have hLocSurj_Φ : CategoryTheory.Presheaf.IsLocallySurjective V.smallEtaleTopology Φ.hom :=
    CategoryTheory.Presheaf.IsLocallySurjective.mk fun {U} t =>
      (hMem V U _).mpr fun x => by
        obtain ⟨E_x, v_x, p_x, hv_et, hv_p, hv_bij⟩ := hRefBij U x
        obtain ⟨c_x, hc_x⟩ := hv_bij.2 ((ℋ.obj.map (Opposite.op v_x)).hom t)
        exact ⟨E_x, v_x, p_x, ⟨c_x, hc_x⟩, hv_et, hv_p⟩
  have hW_Φ : V.smallEtaleTopology.W Φ.hom :=
    (CategoryTheory.GrothendieckTopology.W_iff_isLocallyBijective V.smallEtaleTopology Φ.hom).mpr
      ⟨hLocInj_Φ, hLocSurj_Φ⟩
  have hIso_mapΦ : CategoryTheory.IsIso
      ((CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map Φ.hom) :=
    (CategoryTheory.GrothendieckTopology.W_iff _ _).mp hW_Φ
  let adj_sh_V := CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}
  have h_counit_nat : adj_sh_V.counit.app C_V ≫ Φ =
      (CategoryTheory.presheafToSheaf V.smallEtaleTopology AddCommGrpCat.{u}).map Φ.hom ≫
        adj_sh_V.counit.app ℋ :=
    (adj_sh_V.counit.naturality Φ).symm
  have hIso_comp : CategoryTheory.IsIso (adj_sh_V.counit.app C_V ≫ Φ) :=
    h_counit_nat.symm ▸ @CategoryTheory.IsIso.comp_isIso' _ _ _ _ _ _ _ hIso_mapΦ inferInstance
  have hIso_Φ : CategoryTheory.IsIso Φ :=
    @CategoryTheory.IsIso.of_isIso_comp_left _ _ _ _ _ (adj_sh_V.counit.app C_V) Φ
      inferInstance hIso_comp
  exact ⟨A_open, hFin_open, ⟨(@CategoryTheory.asIso _ _ _ _ Φ hIso_Φ).symm⟩⟩

theorem weil_net_p2_curve_cover_open_pullback_triv (F : Type u) [Finite F] [Field F]
    (m ℓ r' : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (Z_tilde : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.IsProper Z_tilde.hom]
    (f₀ : Z_tilde ⟶ weilProjectiveSpaceOver F 1)
    [AlgebraicGeometry.IsProper f₀.left]
    [AlgebraicGeometry.Surjective f₀.left]
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    [AlgebraicGeometry.IsOpenImmersion j_aff]
    (hj_aff_hom : j_aff ≫ (weilProjectiveSpaceOver F 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C))
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f₀.left ∣_ U₀)]
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra F k]
    (Δ_F : Polynomial F) (hΔ_F_ne : Δ_F ≠ 0)
    (Δ_k : Polynomial k) (hΔ_k_ne : Δ_k ≠ 0)
    (hΔ_map : Δ_k = Δ_F.map (algebraMap F k))
    (R₀ : Type u) [CommRing R₀] [Algebra (Polynomial F) R₀] [IsLocalization.Away Δ_F R₀]
    (R₀_k : Type u) [CommRing R₀_k] [Algebra k R₀_k] [Algebra (Polynomial k) R₀_k]
    [IsScalarTower k (Polynomial k) R₀_k] [IsLocalization.Away Δ_k R₀_k]
    (j_R₀k : R₀ →+* R₀_k)
    (hj_R₀k : j_R₀k.comp (algebraMap (Polynomial F) R₀) =
      (algebraMap (Polynomial k) R₀_k).comp (Polynomial.mapRingHom (algebraMap F k)))
    (e_U : AlgebraicGeometry.Spec (CommRingCat.of R₀) ≅ U₀.toScheme)
    (he_U : e_U.hom ≫ U₀.ι =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)) ≫ j_aff)
    (B_Sigma L_Sigma : Type u) [CommRing B_Sigma] [IsDomain B_Sigma] [Field L_Sigma]
    [Algebra k B_Sigma] [Algebra (Polynomial k) B_Sigma] [Algebra R₀_k B_Sigma]
    [Algebra k L_Sigma] [Algebra (Polynomial k) L_Sigma] [Algebra (RatFunc k) L_Sigma]
    [Algebra B_Sigma L_Sigma] [Algebra R₀_k L_Sigma]
    [IsScalarTower k (Polynomial k) B_Sigma]
    [IsScalarTower (Polynomial k) R₀_k B_Sigma]
    [IsScalarTower k (RatFunc k) L_Sigma]
    [IsScalarTower (Polynomial k) (RatFunc k) L_Sigma]
    [IsScalarTower (Polynomial k) B_Sigma L_Sigma]
    [IsScalarTower R₀_k B_Sigma L_Sigma]
    [Module.Finite R₀_k B_Sigma] [Algebra.Etale R₀_k B_Sigma]
    [IsFractionRing B_Sigma L_Sigma] [IsIntegralClosure B_Sigma R₀_k L_Sigma]
    [FiniteDimensional (RatFunc k) L_Sigma] [IsGalois (RatFunc k) L_Sigma] :
    let Ω_Sigma := AlgebraicClosure L_Sigma
    let η_Sigma : AlgebraicGeometry.Spec (CommRingCat.of Ω_Sigma) ⟶
        (weilProjectiveSpaceOver F 1).left :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom
          ((((algebraMap B_Sigma Ω_Sigma).comp
            ((algebraMap R₀_k B_Sigma).comp j_R₀k)).comp (algebraMap (Polynomial F) R₀)))) ≫ j_aff
    (∀ (τ : Ω_Sigma ≃ₐ[L_Sigma] Ω_Sigma)
      (α_τ : CategoryTheory.Limits.pullback f₀.left η_Sigma ⟶
        CategoryTheory.Limits.pullback f₀.left η_Sigma),
      α_τ ≫ CategoryTheory.Limits.pullback.fst f₀.left η_Sigma =
        CategoryTheory.Limits.pullback.fst f₀.left η_Sigma →
      α_τ ≫ CategoryTheory.Limits.pullback.snd f₀.left η_Sigma =
        CategoryTheory.Limits.pullback.snd f₀.left η_Sigma ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) →
      ∀ (p_τ : weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀.left η_Sigma)
          (ℓ ^ (r' + 1)) (2 * m + 1) →+
        weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀.left η_Sigma)
          (ℓ ^ (r' + 1)) (2 * m + 1)),
        WeilIsTorsionEtalePullback α_τ (ℓ ^ (r' + 1)) (2 * m + 1) p_τ →
        ∀ v, p_τ v = v) →
    ∃ A_triv : AddCommGrpCat.{u},
      Finite ↥A_triv ∧
      WeilIsEtaleSheafPullback
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap R₀_k B_Sigma).comp j_R₀k)))
          e_U.hom)
        (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r')
        ((CategoryTheory.constantSheaf
          (AlgebraicGeometry.Spec (CommRingCat.of B_Sigma)).smallEtaleTopology
          AddCommGrpCat.{u}).obj A_triv) :=
by
  intro Ω_Sigma η_Sigma hGalTriv
  have hℓ_k : (ℓ : k) ≠ 0 := by
    intro h0
    have hF0 : (ℓ : F) = 0 := by
      apply (algebraMap F k).injective
      rw [map_natCast, h0, map_zero]
    have hdvd : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp hF0
    rcases Nat.Prime.eq_one_or_self_of_dvd (Fact.out : Nat.Prime ℓ) (ringChar F) hdvd with h1 | heq
    · exact CharP.char_ne_one F (ringChar F) h1
    · exact hℓ heq.symm
  have _ : IsDedekindDomain B_Sigma := by
    have h_le : Submonoid.powers Δ_k ≤ nonZeroDivisors (Polynomial k) := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hΔ_k_ne)
    have _ : IsDomain R₀_k := IsLocalization.isDomain_of_le_nonZeroDivisors R₀_k h_le
    have _ : IsDedekindDomain R₀_k := IsLocalization.isDedekindDomain (Polynomial k) h_le R₀_k
    have hUnit_RF : IsUnit (algebraMap (Polynomial k) (RatFunc k) Δ_k) :=
      IsUnit.mk0 _ (RatFunc.algebraMap_ne_zero hΔ_k_ne)
    let φ_Rk_RF : R₀_k →+* RatFunc k := IsLocalization.Away.lift Δ_k hUnit_RF
    let _ : Algebra R₀_k (RatFunc k) := φ_Rk_RF.toAlgebra
    have h_lift_eq : φ_Rk_RF.comp (algebraMap (Polynomial k) R₀_k) =
        algebraMap (Polynomial k) (RatFunc k) :=
      RingHom.ext fun p => IsLocalization.Away.lift_eq Δ_k hUnit_RF p
    have _ : IsScalarTower (Polynomial k) R₀_k (RatFunc k) :=
      IsScalarTower.of_algebraMap_eq' h_lift_eq.symm
    have _ : IsFractionRing R₀_k (RatFunc k) :=
      IsFractionRing.isFractionRing_of_isLocalization (Submonoid.powers Δ_k) R₀_k (RatFunc k) h_le
    have h_tower_RL : (algebraMap (RatFunc k) L_Sigma).comp (algebraMap R₀_k (RatFunc k)) =
        algebraMap R₀_k L_Sigma := by
      apply IsLocalization.ringHom_ext (Submonoid.powers Δ_k)
      refine RingHom.ext fun p => ?_
      simp only [RingHom.comp_apply]
      change algebraMap (RatFunc k) L_Sigma (φ_Rk_RF (algebraMap (Polynomial k) R₀_k p)) = _
      rw [IsLocalization.Away.lift_eq Δ_k hUnit_RF p,
        ← IsScalarTower.algebraMap_apply (Polynomial k) (RatFunc k) L_Sigma,
        IsScalarTower.algebraMap_apply R₀_k B_Sigma L_Sigma,
        ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k B_Sigma,
        ← IsScalarTower.algebraMap_apply (Polynomial k) B_Sigma L_Sigma]
    have _ : IsScalarTower R₀_k (RatFunc k) L_Sigma :=
      IsScalarTower.of_algebraMap_eq' h_tower_RL.symm
    have _ : Algebra.IsSeparable (RatFunc k) L_Sigma := IsGalois.to_isSeparable
    exact IsIntegralClosure.isDedekindDomain R₀_k (RatFunc k) L_Sigma B_Sigma
  obtain ⟨hPB_ex, hPB_iso, hPB_comp, hPB_const, -, -⟩ :=
    weil_etale_pullback_exact_and_pseudofunctor ℓ
  obtain ⟨Z_bar, hProp_Zbar, f_bar, hProp_fbar, hSurj_fbar, j_k, hOpen_jk, hj_k_hom,
      U_bar, hSm_Ubar, e_Rk, he_Rk, hPB_Ubar_U₀, hFib_triv⟩ :=
    weil_net_p2_curve_open_baseChange_to_algClosed F (2 * m + 1) ℓ r' hℓ Z_tilde f₀
      j_aff hj_aff_hom U₀ k Δ_F hΔ_F_ne Δ_k hΔ_k_ne hΔ_map R₀ R₀_k j_R₀k hj_R₀k e_U he_U
  have _ : AlgebraicGeometry.IsProper Z_bar.hom := hProp_Zbar
  have _ : AlgebraicGeometry.IsProper f_bar.left := hProp_fbar
  have _ : AlgebraicGeometry.Surjective f_bar.left := hSurj_fbar
  have _ : AlgebraicGeometry.IsOpenImmersion j_k := hOpen_jk
  have _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f_bar.left ∣_ U_bar) := hSm_Ubar
  have hLC_Ubar :=
    weil_net_p2_algClosed_punctured_line_prime_power_locConst k (2 * m + 1) ℓ r' hℓ_k
      Z_bar f_bar j_k hj_k_hom Δ_k hΔ_k_ne R₀_k U_bar e_Rk he_Rk
  let V_Sigma := AlgebraicGeometry.Spec (CommRingCat.of B_Sigma)
  have _ : AlgebraicGeometry.Etale
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀_k B_Sigma))) := by
    rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)]
    change (algebraMap R₀_k B_Sigma).Etale
    rwa [RingHom.etale_algebraMap]
  let π_Sigma : V_Sigma ⟶ U_bar.toScheme :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀_k B_Sigma)) ≫ e_Rk.hom
  have _ : AlgebraicGeometry.Etale π_Sigma := inferInstance
  let h_Sigma : V_Sigma ⟶ (weilProjectiveSpaceOver k 1).left := π_Sigma ≫ U_bar.ι
  have _ : AlgebraicGeometry.Etale h_Sigma := inferInstance
  obtain ⟨ℋ_Sigma, hPB_π, -, -⟩ := hPB_ex π_Sigma _
  have hPB_target_ℋ : WeilIsEtaleSheafPullback
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap R₀_k B_Sigma).comp j_R₀k)))
        e_U.hom)
      (weilMidDevOpenHigherDirectImage F f₀ U₀ ℓ (2 * m + 1) r')
      ℋ_Sigma := by
    have hPB_comp_U₀ :=
      (hPB_comp π_Sigma
        (e_Rk.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_R₀k) ≫ e_U.hom)
        _ _ _).1 hPB_Ubar_U₀ hPB_π
    have h_eq : π_Sigma ≫
        (e_Rk.inv ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_R₀k) ≫ e_U.hom) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap R₀_k B_Sigma).comp j_R₀k)) ≫ e_U.hom := by
      dsimp [π_Sigma]
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_Rk.hom e_Rk.inv _,
        e_Rk.hom_inv_id, CategoryTheory.Category.id_comp,
        ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
    rwa [h_eq] at hPB_comp_U₀
  have hPB_open_bar :=
    weil_bockstein_open_higherDirectImage_pullback Z_bar.left (weilProjectiveSpaceOver k 1).left
      f_bar.left U_bar (ℓ ^ (r' + 1)) (2 * m + 1)
  have hPB_hSigma : WeilIsEtaleSheafPullback h_Sigma
      (weilEtaleHigherDirectImage f_bar.left (2 * m + 1)
        (weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r' + 1))))
      ℋ_Sigma :=
    (hPB_comp π_Sigma U_bar.ι _ _ _).1 hPB_open_bar hPB_π
  have hLC_Sigma : ∀ y : ↥V_Sigma,
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ V_Sigma) (A_y : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale w ∧
        y ∈ Set.range w.base ∧
        Finite ↥A_y ∧
        WeilIsEtaleSheafPullback w ℋ_Sigma
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A_y) := by
    intro y
    obtain ⟨W, w, A_y, hw_et, ⟨z, hz⟩, hFin_Ay, hPB_w⟩ := hLC_Ubar (π_Sigma.base y)
    have _ : AlgebraicGeometry.Etale w := hw_et
    let W' := CategoryTheory.Limits.pullback w π_Sigma
    let p_W : W' ⟶ W := CategoryTheory.Limits.pullback.fst w π_Sigma
    let w' : W' ⟶ V_Sigma := CategoryTheory.Limits.pullback.snd w π_Sigma
    obtain ⟨z', -, hz'_snd⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z y hz
    have hPB_pW := hPB_const p_W A_y
    have hPB_comp_W' := (hPB_comp p_W w _ _ _).1 hPB_w hPB_pW
    rw [CategoryTheory.Limits.pullback.condition] at hPB_comp_W'
    exact ⟨W', w', A_y, inferInstance, ⟨z', hz'_snd⟩, hFin_Ay,
      (hPB_comp w' π_Sigma _ _ _).2 hPB_π hPB_comp_W'⟩
  obtain ⟨y₀⟩ : Nonempty ↥V_Sigma := inferInstance
  obtain ⟨W_gen, w_gen, A₀, hw_gen, ⟨z₀, -⟩, hFin_A₀, hPB_gen⟩ := hLC_Sigma y₀
  have hW_gen : Nonempty ↥W_gen := ⟨z₀⟩
  let χ_Rk : R₀_k →+* Ω_Sigma := (algebraMap B_Sigma Ω_Sigma).comp (algebraMap R₀_k B_Sigma)
  let η_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω_Sigma) ⟶
      (weilProjectiveSpaceOver k 1).left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_Sigma Ω_Sigma)) ≫ h_Sigma
  have hη_F_eq : η_Sigma = AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom ((χ_Rk.comp j_R₀k).comp (algebraMap (Polynomial F) R₀))) ≫ j_aff := rfl
  have hη_k_eq : η_bar =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ_Rk) ≫ e_Rk.hom ≫ U_bar.ι := by
    dsimp [η_bar, h_Sigma, π_Sigma, χ_Rk]
    rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      CategoryTheory.Category.assoc]
  have hGalTriv_bar : ∀ (τ : Ω_Sigma ≃ₐ[L_Sigma] Ω_Sigma)
      (α_τ_bar : CategoryTheory.Limits.pullback f_bar.left η_bar ⟶
        CategoryTheory.Limits.pullback f_bar.left η_bar),
      α_τ_bar ≫ CategoryTheory.Limits.pullback.fst f_bar.left η_bar =
        CategoryTheory.Limits.pullback.fst f_bar.left η_bar →
      α_τ_bar ≫ CategoryTheory.Limits.pullback.snd f_bar.left η_bar =
        CategoryTheory.Limits.pullback.snd f_bar.left η_bar ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) →
      ∀ (p_τ_bar : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left η_bar)
            (ℓ ^ (r' + 1)) (2 * m + 1) →+
          weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left η_bar)
            (ℓ ^ (r' + 1)) (2 * m + 1)),
        WeilIsTorsionEtalePullback α_τ_bar (ℓ ^ (r' + 1)) (2 * m + 1) p_τ_bar →
        ∀ v, p_τ_bar v = v := by
    intro τ
    have hτ_fix : ∀ x : R₀_k, τ.toRingEquiv (χ_Rk x) = χ_Rk x := by
      intro x
      change τ (algebraMap B_Sigma Ω_Sigma (algebraMap R₀_k B_Sigma x)) = _
      rw [IsScalarTower.algebraMap_apply B_Sigma L_Sigma Ω_Sigma]
      exact τ.commutes _
    exact hFib_triv Ω_Sigma χ_Rk η_Sigma η_bar hη_F_eq hη_k_eq τ.toRingEquiv hτ_fix (hGalTriv τ)
  obtain ⟨b₀, hb₀, A_open, hFin_open, hPB_open⟩ :=
    weil_net_p2_generic_galois_deck_triv_on_basicOpen k (2 * m + 1) ℓ r' hℓ_k Z_bar f_bar
