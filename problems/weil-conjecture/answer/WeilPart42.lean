theorem weil_net_p2_algClosed_punctured_line_prime_power_locConst (k : Type u) [Field k]
    [IsAlgClosed k]
    (d_rel ℓ r' : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Z_bar.hom]
    (f_bar : Z_bar ⟶ weilProjectiveSpaceOver k 1)
    [AlgebraicGeometry.IsProper f_bar.left]
    [AlgebraicGeometry.Surjective f_bar.left]
    (j_k : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
