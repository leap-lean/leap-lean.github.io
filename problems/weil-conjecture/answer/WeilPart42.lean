                (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) ^ n))
          simp only [hAlg_C, map_mul, map_pow]
          change x.1 * (φ_C (α₀ g) : L₂) =
            (φ_C (algebraMap ↥B₂_0 (Localization.Away f_B₂) y) : L₂) *
              (φ_C (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) : L₂) ^ n
          rw [hφ_C_α₀, hφ_C_eq]
