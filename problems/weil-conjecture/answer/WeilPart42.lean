    have hψ_ι : ∀ b : B_bar, ψ (ι_S b) = α_bar b := by
      intro b
      obtain ⟨y, rfl⟩ := hπ_bar_surj b
      rw [hι_π, hγ_apply, hψ_tmul, map_one, one_mul, hψ_B_eq]
      rfl
    have hClear : ∀ z : S, ∃ (g : A_base) (b : B_bar),
