    have hp := hSq_RΩ.flip.paste_horiz hPb_amb_Ω.flip
    rwa [hι_amb_Ω, hι_succ, hγ_Ω_C_spec] at hp
  let j_amb_open : Q_amb_Ω.left ⟶ Q_amb_R :=
    CategoryTheory.Limits.pullback.lift u_Ω (Q_amb_Ω.hom ≫ j_R)
      (by rw [Category.assoc]; exact hPb_amb_tot.w.symm)
  have hPb_j_amb : CategoryTheory.IsPullback Q_amb_Ω.hom j_amb_open j_R
      (CategoryTheory.Limits.pullback.snd Q_succ.hom g_k_R) :=
    (CategoryTheory.IsPullback.of_right
      (by rw [CategoryTheory.Limits.pullback.lift_fst]; exact hPb_amb_tot.flip)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback Q_succ.hom g_k_R)).flip

  obtain ⟨e_slice_Ω, he_slice_Ω⟩ :=
    hS6_slice Ω (γ_Ω Polynomial.X) Q_amb_Ω Q_sm_Ω ι_amb_Ω hι_amb_Ω hSplit_amb.1 i_sm_Ω Λ_Ω
      (by rw [hγ_Ω_X]; exact hSplit_sm) hΛ_Ω_0 hΛ_Ω_ne hΛ_Ω_1 hΛ_Ω_a
  let v_Ω : Q_sm_Ω.left ⟶ (weilProjectiveSpaceOver Ω M).left :=
    e_slice_Ω.hom ≫ CategoryTheory.Limits.pullback.snd ι_amb_Ω Λ_Ω
  have hSq_LΩ : CategoryTheory.IsPullback i_sm_Ω.left v_Ω ι_amb_Ω Λ_Ω :=
    CategoryTheory.IsPullback.of_iso_pullback
      ⟨by dsimp [v_Ω]; rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition, ← Category.assoc, he_slice_Ω]⟩
      e_slice_Ω he_slice_Ω rfl
  have hv_Ω_hom : v_Ω ≫ (weilProjectiveSpaceOver Ω M).hom = Q_sm_Ω.hom := by
    rw [← hΛ_Ω_hom, ← Category.assoc, ← hSq_LΩ.w, Category.assoc, hι_amb_Ω, i_sm_Ω.w]

  have hSq_LRΩ : CategoryTheory.IsPullback (i_sm_Ω.left ≫ u_Ω) v_Ω ι_succ (π_PΩ ≫ Ψ_fam) := by
    have hp := hSq_LΩ.paste_horiz hSq_RΩ
    rwa [← hfac_Ω] at hp
  let w_Ω : Q_sm_Ω.left ⟶ Q_fam_sch :=
    CategoryTheory.Limits.pullback.lift (i_sm_Ω.left ≫ u_Ω) (v_Ω ≫ π_PΩ)
      (by rw [Category.assoc]; exact hSq_LRΩ.w)
  have hSq_wΩ : CategoryTheory.IsPullback w_Ω v_Ω
      (CategoryTheory.Limits.pullback.snd ι_succ Ψ_fam) π_PΩ :=
    CategoryTheory.IsPullback.of_right
      (by rw [CategoryTheory.Limits.pullback.lift_fst]; exact hSq_LRΩ)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback ι_succ Ψ_fam)
  have hPb_sm_tot : CategoryTheory.IsPullback Q_sm_Ω.hom w_Ω (j_R ≫ g_hR) π_Qfam.left := by
    have hp := hSq_wΩ.flip.paste_horiz hPb_PΩ.flip
    rwa [hv_Ω_hom, hγ_Ω_spec] at hp
  let j_Q_tot : Q_sm_Ω.left ⟶ Q_R :=
    CategoryTheory.Limits.pullback.lift w_Ω (Q_sm_Ω.hom ≫ j_R)
      (by rw [Category.assoc]; exact hPb_sm_tot.w.symm)
  have hPb_j_Q_tot : CategoryTheory.IsPullback Q_sm_Ω.hom j_Q_tot j_R pr₂_Q :=
    (CategoryTheory.IsPullback.of_right
      (by rw [CategoryTheory.Limits.pullback.lift_fst]; exact hPb_sm_tot.flip)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback π_Qfam.left g_hR)).flip

  have hjQ_tot_comm : j_Q_tot ≫ i_hyp_R = i_sm_Ω.left ≫ j_amb_open := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        ← Category.assoc j_Q_tot, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst,
        Category.assoc, CategoryTheory.Limits.pullback.lift_fst]
    · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd,
        Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        ← Category.assoc, i_sm_Ω.w]

  
  have hψF_eq : ∀ (R : Type u) [CommRing R] (c_R : κ →+* R) (t_R : R),
      let v_R : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) R :=
        Fin.cases (-MvPolynomial.C t_R * MvPolynomial.X 0)
          (Fin.cases (MvPolynomial.X 0) (fun a : Fin M => MvPolynomial.X a.succ))
      let ψ_R : MvPolynomial (Fin (M + 1 + 1)) κ →+* MvPolynomial (Fin (M + 1)) R :=
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp c_R) v_R
      ψ_R F_amb_k =
        -MvPolynomial.C t_R * MvPolynomial.X 0 * MvPolynomial.X 0 +
          ∑ j : Fin (m + 1),
            (MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ : MvPolynomial (Fin (M + 1)) R) *
              MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩ := by
    intro R _ c_R t_R v_R ψ_R
    dsimp [F_amb_k]
    rw [Finset.sum_range_succ', map_add, map_sum, add_comm (∑ _ ∈ _, _)]
    congr 1
    · have h0 : 2 * 0 + 1 < 2 * (m + 1) + 1 + 1 := by omega
      simp only [h0, ↓reduceDIte, map_mul]
      have hx0 : (⟨2 * 0, Nat.lt_of_succ_lt h0⟩ : Fin (M + 1 + 1)) = 0 := Fin.ext rfl
      have hx1 : (⟨2 * 0 + 1, h0⟩ : Fin (M + 1 + 1)) = (0 : Fin (M + 1)).succ := Fin.ext rfl
      rw [hx0, hx1]
      dsimp only [ψ_R]
      rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      dsimp only [v_R, Fin.cases_zero, Fin.cases_succ]
    · rw [← Fin.sum_univ_eq_sum_range]
      refine Finset.sum_congr rfl fun j _ => ?_
      have hj : 2 * (j.1 + 1) + 1 < 2 * (m + 1) + 1 + 1 := by omega
      simp only [hj, ↓reduceDIte, map_mul]
      have ha0 : (⟨2 * (j.1 + 1), Nat.lt_of_succ_lt hj⟩ : Fin (M + 1 + 1)) =
          (⟨2 * j.1, by omega⟩ : Fin M).succ.succ := Fin.ext (by dsimp; omega)
      have ha1 : (⟨2 * (j.1 + 1) + 1, hj⟩ : Fin (M + 1 + 1)) =
          (⟨2 * j.1 + 1, by omega⟩ : Fin M).succ.succ := Fin.ext (by dsimp; omega)
      rw [ha0, ha1]
      dsimp only [ψ_R]
      rw [MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X']
      dsimp only [v_R, Fin.cases_succ]
      rfl

  have hG_hom : ∀ (R : Type u) [CommRing R] (t_R : R),
      (-MvPolynomial.C t_R * MvPolynomial.X 0 * MvPolynomial.X 0 +
        ∑ j : Fin (m + 1),
          (MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ : MvPolynomial (Fin (M + 1)) R) *
            MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩ :
        MvPolynomial (Fin (M + 1)) R) ∈
      MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R ((2 : ℕ) • 1) := by
    intro R _ t_R
    rw [MvPolynomial.mem_homogeneousSubmodule]
    change MvPolynomial.IsHomogeneous _ (1 + 1)
    refine MvPolynomial.IsHomogeneous.add ?_ (MvPolynomial.IsHomogeneous.sum _ _ _ fun j _ => ?_)
    · have hneg : -MvPolynomial.C t_R * (MvPolynomial.X 0 : MvPolynomial (Fin (M + 1)) R) =
          MvPolynomial.C (-t_R) * MvPolynomial.X 0 := by rw [map_neg, neg_mul]
      rw [hneg]
      exact MvPolynomial.IsHomogeneous.mul
        (MvPolynomial.IsHomogeneous.C_mul (MvPolynomial.isHomogeneous_X R (0 : Fin (M + 1))) (-t_R))
        (MvPolynomial.isHomogeneous_X R (0 : Fin (M + 1)))
    · exact MvPolynomial.IsHomogeneous.mul
        (MvPolynomial.isHomogeneous_X R (⟨2 * j.1 + 1, by omega⟩ : Fin (M + 1)))
        (MvPolynomial.isHomogeneous_X R (⟨2 * j.1 + 2, by omega⟩ : Fin (M + 1)))

  let specEquivIso : ∀ {A B : Type u} [CommRing A] [CommRing B] (θ : A ≃+* B),
      AlgebraicGeometry.Spec (CommRingCat.of B) ≅ AlgebraicGeometry.Spec (CommRingCat.of A) :=
    fun θ =>
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : θ.toRingHom.comp θ.symm.toRingHom = RingHom.id _ :=
            RingHom.ext θ.apply_symm_apply
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id _
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : θ.symm.toRingHom.comp θ.toRingHom = RingHom.id _ :=
            RingHom.ext θ.symm_apply_apply
          rw [hid]
          exact AlgebraicGeometry.Spec.map_id _ }

  
  have hSm_Qsm : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) Q_sm_Ω.hom := by
    obtain ⟨π_PR_Ω, hPb_PR_Ω, hD1_Ω, hDa_Ω, hφ0_Ω, hφa_Ω⟩ := hΨ_commRing Ω γ_Ω
    let α_Ω : (weilProjectiveSpaceOver Ω M).left ≅ (weilProjectiveSpaceOver Ω M).left :=
      hPb_PΩ.isoPullback ≪≫ hPb_PR_Ω.isoPullback.symm
    have hα_π : α_Ω.hom ≫ π_PR_Ω = π_PΩ := by
      dsimp [α_Ω]
      rw [Category.assoc, CategoryTheory.IsPullback.isoPullback_inv_fst,
        CategoryTheory.IsPullback.isoPullback_hom_fst]
    have hα_hom : α_Ω.hom ≫ (weilProjectiveSpaceOver Ω M).hom =
        (weilProjectiveSpaceOver Ω M).hom := by
      dsimp [α_Ω]
      rw [Category.assoc, CategoryTheory.IsPullback.isoPullback_inv_snd,
        CategoryTheory.IsPullback.isoPullback_hom_snd]
    let Q'_Ω := CategoryTheory.Limits.pullback ι_succ (π_PR_Ω ≫ Ψ_fam)
    let p_sub_Ω := CategoryTheory.Limits.pullback.snd ι_succ (π_PR_Ω ≫ Ψ_fam)
    let p'_Ω := p_sub_Ω ≫ (weilProjectiveSpaceOver Ω M).hom
    let β_Ω : CategoryTheory.Limits.pullback ι_succ (π_PΩ ≫ Ψ_fam) ≅ Q'_Ω :=
      { hom := CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst ι_succ (π_PΩ ≫ Ψ_fam))
          (CategoryTheory.Limits.pullback.snd ι_succ (π_PΩ ≫ Ψ_fam) ≫ α_Ω.hom)
          (by rw [Category.assoc, ← Category.assoc α_Ω.hom, hα_π]
              exact CategoryTheory.Limits.pullback.condition)
        inv := CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst ι_succ (π_PR_Ω ≫ Ψ_fam))
          (CategoryTheory.Limits.pullback.snd ι_succ (π_PR_Ω ≫ Ψ_fam) ≫ α_Ω.inv)
          (by
            have hinv : α_Ω.inv ≫ π_PΩ = π_PR_Ω := by
              rw [← hα_π, ← Category.assoc, α_Ω.inv_hom_id, Category.id_comp]
            rw [Category.assoc, ← Category.assoc α_Ω.inv, hinv]
            exact CategoryTheory.Limits.pullback.condition)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              Category.assoc, α_Ω.hom_inv_id, Category.comp_id, Category.id_comp]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              CategoryTheory.Limits.pullback.lift_fst, Category.id_comp]
          · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              Category.assoc, α_Ω.inv_hom_id, Category.comp_id, Category.id_comp] }
    let e_Qsm_CR : Q_sm_Ω.left ≅ Q'_Ω := hSq_LRΩ.isoPullback ≪≫ β_Ω
    have he_Qsm_p' : e_Qsm_CR.hom ≫ p'_Ω = Q_sm_Ω.hom := by
      dsimp [e_Qsm_CR, β_Ω, p'_Ω, p_sub_Ω]
      rw [Category.assoc, ← Category.assoc (CategoryTheory.Limits.pullback.lift _ _ _),
        CategoryTheory.Limits.pullback.lift_snd, Category.assoc, hα_hom,
        ← Category.assoc, CategoryTheory.IsPullback.isoPullback_hom_snd, hv_Ω_hom]

    let v_Ω_fn : Fin (M + 1 + 1) → MvPolynomial (Fin (M + 1)) Ω :=
      Fin.cases (-MvPolynomial.C (γ_Ω Polynomial.X) * MvPolynomial.X 0)
        (Fin.cases (MvPolynomial.X 0) (fun a : Fin M => MvPolynomial.X a.succ))
    let ψ_Ω_fn : MvPolynomial (Fin (M + 1 + 1)) κ →+* MvPolynomial (Fin (M + 1)) Ω :=
      MvPolynomial.eval₂Hom (MvPolynomial.C.comp (γ_Ω.comp Polynomial.C)) v_Ω_fn
    have hψ_G_Ω : ψ_Ω_fn F_amb_k =
        -MvPolynomial.C (φ_R_Ω h_R) * MvPolynomial.X 0 * MvPolynomial.X 0 +
          ∑ j : Fin (m + 1),
            (MvPolynomial.X ⟨2 * j.1 + 1, by omega⟩ : MvPolynomial (Fin (M + 1)) Ω) *
              MvPolynomial.X ⟨2 * j.1 + 2, by omega⟩ := by
      change MvPolynomial.eval₂Hom _ _ F_amb_k = _
      rw [hψF_eq Ω (γ_Ω.comp Polynomial.C) (γ_Ω Polynomial.X), hγ_Ω_X]
    have hF_Ω_hom : ψ_Ω_fn F_amb_k ∈
        MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω ((2 : ℕ) • 1) := by
      rw [hψ_G_Ω]
      exact hG_hom Ω (φ_R_Ω h_R)

    obtain ⟨hCov_Q'Ω, ⟨e₀_Ω, _, hOpen0_Ω⟩, he_a_Ω⟩ :=
      hS6_chart κ Ω (γ_Ω.comp Polynomial.C) 2 (γ_Ω Polynomial.X) (by decide)
        F_amb_k hF_Ω_hom Q_succ ι_succ (π_PR_Ω ≫ Ψ_fam)
        hSplit_succ hD1_Ω hDa_Ω hφ0_Ω hφa_Ω
    obtain ⟨⟨θ₀_Ω, _, hθ₀_Ω_X⟩, hθ_a_Ω⟩ :=
      weil_odp_qdeg_dehom_chart_ring_equivalences Ω m (φ_R_Ω h_R)
        (ψ_Ω_fn F_amb_k) hψ_G_Ω hF_Ω_hom

    let ℬ_Ω := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) Ω
    let _ : GradedAlgebra ℬ_Ω := MvPolynomial.gradedAlgebra
    let U'_0_Ω : Q'_Ω.Opens :=
      (TopologicalSpace.Opens.map p_sub_Ω.base).obj (weilProjBasicOpen Ω M 0)
    let V'_Ω : Fin M → Q'_Ω.Opens :=
      fun a => (TopologicalSpace.Opens.map p_sub_Ω.base).obj (weilProjBasicOpen Ω M a.succ)

    have hV'_Ω_top : (⨆ a : Fin M, V'_Ω a) = ⊤ := by
      have hle : U'_0_Ω ≤ ⨆ a : Fin M, V'_Ω a := by
        intro y hy
        by_contra hnot
        let f₀_M := AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_Ω.symm.toRingHom) ≫ e₀_Ω.hom
        have hf₀_surj : Function.Surjective f₀_M.base :=
          ((specEquivIso θ₀_Ω).symm ≪≫ e₀_Ω).hom.homeomorph.surjective
        obtain ⟨z, hz⟩ := hf₀_surj ⟨y, hy⟩
        have hz_val : (f₀_M ≫ U'_0_Ω.ι).base z = y := congrArg Subtype.val hz
        have hX_mem : ∀ (j : Fin (m + 1)) (b : Fin 2),
            Ideal.Quotient.mk _ (MvPolynomial.X (j, b)) ∈ z.asIdeal := by
          intro j b
          let a : Fin M := ⟨2 * j.1 + b.1, by omega⟩
          have hy_not_a : y ∉ V'_Ω a := fun hya => hnot (TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hya⟩)
          have hz_not : z ∉ (TopologicalSpace.Opens.map (f₀_M ≫ U'_0_Ω.ι).base).obj (V'_Ω a) := by
            intro hmem
            exact hy_not_a (hz_val ▸ hmem)
          have hpre_eq :
              (TopologicalSpace.Opens.map (f₀_M ≫ U'_0_Ω.ι).base).obj (V'_Ω a) =
                PrimeSpectrum.basicOpen (θ₀_Ω.symm (Ideal.Quotient.mk _
                  (HomogeneousLocalization.Away.isLocalizationElem
                    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                      (MvPolynomial.isHomogeneous_X Ω 0))
                    ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                      (MvPolynomial.isHomogeneous_X Ω a.succ))))) := by
            change (TopologicalSpace.Opens.map
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ₀_Ω.symm.toRingHom)).base).obj
              ((TopologicalSpace.Opens.map (e₀_Ω.hom ≫ U'_0_Ω.ι).base).obj (V'_Ω a)) = _
            rw [hOpen0_Ω a]
            ext p
            exact Iff.rfl
          have hθ_symm :
              θ₀_Ω.symm (Ideal.Quotient.mk _
                (HomogeneousLocalization.Away.isLocalizationElem
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X Ω 0))
                  ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
                    (MvPolynomial.isHomogeneous_X Ω a.succ)))) =
              Ideal.Quotient.mk _ (MvPolynomial.X (j, b)) := by
            apply θ₀_Ω.injective
            rw [θ₀_Ω.apply_symm_apply, hθ₀_Ω_X j b]
            rfl
          rw [hpre_eq, hθ_symm] at hz_not
          exact Classical.not_not.mp hz_not
        let I_odp : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) Ω) :=
          Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
            MvPolynomial.C (φ_R_Ω h_R)}
        have hsum_mem :
            Ideal.Quotient.mk I_odp
              (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) ∈ z.asIdeal := by
          rw [map_sum]
          refine Ideal.sum_mem _ fun j _ => ?_
          rw [map_mul]
          exact Ideal.mul_mem_right _ _ (hX_mem j 0)
        have hrel_zero :
            Ideal.Quotient.mk I_odp
              ((∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
                MvPolynomial.C (φ_R_Ω h_R)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        have hc0_mem :
            Ideal.Quotient.mk I_odp (MvPolynomial.C (φ_R_Ω h_R)) ∈ z.asIdeal := by
          rw [map_sub, sub_eq_zero] at hrel_zero
          exact Eq.mp (congrArg (fun u => u ∈ z.asIdeal) hrel_zero) hsum_mem
        have h1_mem : (1 : _) ∈ z.asIdeal := by
          have hmul := z.asIdeal.mul_mem_right
            (Ideal.Quotient.mk _ (MvPolynomial.C (φ_R_Ω h_R)⁻¹)) hc0_mem
          rwa [← map_mul, ← map_mul, mul_inv_cancel₀ hc0_ne, map_one, map_one] at hmul
        exact z.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
      rw [← hCov_Q'Ω]
      exact (sup_eq_right.mpr hle).symm

    let C_Ω : Fin M → Q_sm_Ω.left.Opens :=
      fun a => (TopologicalSpace.Opens.map e_Qsm_CR.hom.base).obj (V'_Ω a)
    have hC_Ω_cov : (⨆ a : Fin M, C_Ω a) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      have hx : e_Qsm_CR.hom.base x ∈ (⨆ a : Fin M, V'_Ω a) := by
        rw [hV'_Ω_top]
        trivial
      obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hxa⟩
    have hC_Ω_iso : ∀ a : Fin M,
        ∃ e_i : (C_Ω a).toScheme ≅ (weilAffineSpaceOver Ω (2 * m + 1)).left,
          e_i.hom ≫ (weilAffineSpaceOver Ω (2 * m + 1)).hom = (C_Ω a).ι ≫ Q_sm_Ω.hom := by
      intro a
      obtain ⟨e_a, he_a⟩ := he_a_Ω a
      obtain ⟨θ_a, hθ_a⟩ := hθ_a_Ω a
      have hrange_Ca :
          Set.range ((C_Ω a).ι ≫ e_Qsm_CR.hom).base = Set.range (V'_Ω a).ι.base := by
        ext y
        constructor
        · rintro ⟨⟨x, hx⟩, rfl⟩
          exact ⟨⟨e_Qsm_CR.hom.base x, hx⟩, rfl⟩
        · rintro ⟨⟨y', hy'⟩, rfl⟩
          refine ⟨⟨e_Qsm_CR.inv.base y', ?_⟩, ?_⟩
