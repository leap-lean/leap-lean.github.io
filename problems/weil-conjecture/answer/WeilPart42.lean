      ∀ (R'_a : CommRingCat.{u}) (e_Ba : AlgebraicGeometry.Spec R'_a ⟶ B.left)
        (h_a : R'_a) (V'_a : AlgebraicGeometry.Scheme.{u}) (v_a : V'_a)
        (e_Ya : V'_a ⟶ Y.left)
        (q_a : V'_a ⟶ AlgebraicGeometry.Spec (CommRingCat.of
          (MvPolynomial (Fin (m + 1) × Fin 2) R'_a ⧸ Ideal.span
            {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
              MvPolynomial.C h_a}))),
      AlgebraicGeometry.Etale e_Ba →
      AlgebraicGeometry.Etale e_Ya →
      AlgebraicGeometry.Etale q_a →
      e_Ya.base v_a = y_a →
      e_Ba.base ⁻¹' Z_disc = { u : AlgebraicGeometry.Spec R'_a | h_a ∈ u.asIdeal } →
      (∀ idx : Fin (m + 1) × Fin 2,
        Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_a.base v_a).asIdeal) →
      e_Ya ≫ g.left = q_a ≫ AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) ≫ e_Ba →
      (∀ v : V'_a, e_Ya.base v = y_η →
        ∀ idx : Fin (m + 1) × Fin 2,
          Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (q_a.base v).asIdeal) →
      False :=
    fun (F : Type u) [Field F] (m : ℕ) Y B g [AlgebraicGeometry.IsProper g.left]
        (A_L : Type u) [CommRing A_L] [IsDomain A_L] [IsNoetherianRing A_L]
        [IsDiscreteValuationRing A_L]
        g_L y_η y_a hy_η_base hy_a_base u₁ u₂ hu_ne hu₁_g hu₂_g hu₁_pt hu₂_pt
        Z_sing hZ_sing_cl hy_η_sing hy_a_uniq y_sec hy_sec_hom hy_sec_pt
        Z_disc hg_L_disc R'_a e_Ba h_a V'_a v_a e_Ya q_a
        hEt_Ba hEt_Ya hEt_qa hv_a_eq he_Ba_disc hv_a_X hcomm_a hv_η_vtx => by
    let _ : CommRing F := Field.toCommRing
    let _ : DivisionRing F := Field.toDivisionRing
    let _ : IsDomain F := Field.isDomain
    classical
    have _ := hEt_Ba; have _ := hEt_Ya; have _ := hEt_qa
    
    let L := FractionRing A_L
    let _ : CommRing L := Field.toCommRing
    let _ : DivisionRing L := Field.toDivisionRing
    let _ : IsDomain L := Field.isDomain
    let j_gen : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A_L) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A_L L))
    let Y_L := CategoryTheory.Limits.pullback g.left g_L
    let pr_Y : Y_L ⟶ Y.left := CategoryTheory.Limits.pullback.fst g.left g_L
    let π_L : Y_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_L) :=
      CategoryTheory.Limits.pullback.snd g.left g_L
    let s_1 : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Y_L :=
      CategoryTheory.Limits.pullback.lift u₁ j_gen hu₁_g
    let s_2 : AlgebraicGeometry.Spec (CommRingCat.of L) ⟶ Y_L :=
      CategoryTheory.Limits.pullback.lift u₂ j_gen hu₂_g
    have hs_ne : s_1 ≠ s_2 := fun h => hu_ne (by
      have hfst := congrArg (fun f => f ≫ pr_Y) h
      dsimp only [s_1, s_2] at hfst
      rw [CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst] at hfst
      exact hfst)
    let pt_L : AlgebraicGeometry.Spec (CommRingCat.of L) := IsLocalRing.closedPoint L
    have hj_gen_pt : j_gen.base pt_L = (⊥ : PrimeSpectrum A_L) := by
      apply PrimeSpectrum.ext
      rw [hSpecMapAsIdeal, hFieldSpecAsIdealBot L pt_L]
      ext a
      simp only [Ideal.mem_comap, Ideal.mem_bot]
      exact ⟨fun ha => IsFractionRing.injective A_L L (ha.trans (map_zero _).symm),
        fun ha => ha ▸ map_zero _⟩
    let ξ_1 : Y_L := s_1.base pt_L
    let ξ_2 : Y_L := s_2.base pt_L
    have hξ_ne : ξ_1 ≠ ξ_2 := by
      intro hξ
      have hj_gen_surj : Function.Surjective (j_gen.residueFieldMap pt_L).hom := by
        obtain ⟨_, hSub_ptL⟩ := hSpecResidueSubfieldEqTop L pt_L
        let ι_ptL : L →+* ↥((AlgebraicGeometry.Spec (CommRingCat.of L)).residueField pt_L) :=
          (AlgebraicGeometry.Spec.preimage
            ((AlgebraicGeometry.Spec (CommRingCat.of L)).fromSpecResidueField pt_L)).hom
        let ι_botAL : A_L →+* ↥((AlgebraicGeometry.Spec (CommRingCat.of A_L)).residueField (j_gen.base pt_L)) :=
          (AlgebraicGeometry.Spec.preimage
            ((AlgebraicGeometry.Spec (CommRingCat.of A_L)).fromSpecResidueField (j_gen.base pt_L))).hom
        have hcomm_ι : ((j_gen.residueFieldMap pt_L).hom).comp ι_botAL =
            ι_ptL.comp (algebraMap A_L L) := by
          have hSpec := j_gen.SpecMap_residueFieldMap_fromSpecResidueField pt_L
          have hSpec' : AlgebraicGeometry.Spec.map
              (AlgebraicGeometry.Spec.preimage
                ((AlgebraicGeometry.Spec (CommRingCat.of A_L)).fromSpecResidueField (j_gen.base pt_L)) ≫
                j_gen.residueFieldMap pt_L) =
              AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap A_L L) ≫
                  AlgebraicGeometry.Spec.preimage
                    ((AlgebraicGeometry.Spec (CommRingCat.of L)).fromSpecResidueField pt_L)) := by
            rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
              AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
            exact hSpec
          exact congrArg CommRingCat.Hom.hom (hSpecMapInj hSpec')
        have hRangeTop : (j_gen.residueFieldMap pt_L).hom.fieldRange = ⊤ := by
          apply hSub_ptL
          intro z
          obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors A_L) z
          have hb_unit : IsUnit (ι_ptL (algebraMap A_L L b.1)) :=
            (IsLocalization.map_units L b).map ι_ptL
          have ha_mem : ι_ptL (algebraMap A_L L a) ∈ (j_gen.residueFieldMap pt_L).hom.fieldRange := by
            change (ι_ptL.comp (algebraMap A_L L)) a ∈ _
            rw [← hcomm_ι]; exact ⟨ι_botAL a, rfl⟩
          have hb_mem : ι_ptL (algebraMap A_L L b.1) ∈ (j_gen.residueFieldMap pt_L).hom.fieldRange := by
            change (ι_ptL.comp (algebraMap A_L L)) b.1 ∈ _
            rw [← hcomm_ι]; exact ⟨ι_botAL b.1, rfl⟩
          have hdiv : ι_ptL z = ι_ptL (algebraMap A_L L a) * (ι_ptL (algebraMap A_L L b.1))⁻¹ := by
            apply mul_right_cancel₀ hb_unit.ne_zero
            rw [inv_mul_cancel_right₀ hb_unit.ne_zero, ← map_mul, hab]
          rw [hdiv]
          exact Subfield.mul_mem _ ha_mem (Subfield.inv_mem _ hb_mem)
        intro w
        have hw : w ∈ (j_gen.residueFieldMap pt_L).hom.fieldRange := by rw [hRangeTop]; trivial
        exact hw
      obtain ⟨_, hSub_ptL⟩ := hSpecResidueSubfieldEqTop L pt_L
      let ι_ptL := AlgebraicGeometry.Spec.preimage
        ((AlgebraicGeometry.Spec (CommRingCat.of L)).fromSpecResidueField pt_L)
      have hι_surj : Function.Surjective ι_ptL.hom := by
        have hRangeTop : ι_ptL.hom.fieldRange = ⊤ := hSub_ptL _ (fun r => ⟨r, rfl⟩)
        intro w
        have hw : w ∈ ι_ptL.hom.fieldRange := by rw [hRangeTop]; trivial
        exact hw
      have _ : CategoryTheory.IsIso ι_ptL :=
        (ConcreteCategory.isIso_iff_bijective ι_ptL).mpr ⟨ι_ptL.hom.injective, hι_surj⟩
      have _ : CategoryTheory.IsIso
          ((AlgebraicGeometry.Spec (CommRingCat.of L)).fromSpecResidueField pt_L) := by
        rw [← AlgebraicGeometry.Spec.map_preimage
          ((AlgebraicGeometry.Spec (CommRingCat.of L)).fromSpecResidueField pt_L)]
        infer_instance
      have hs1_π : s_1 ≫ π_L = j_gen := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hs2_π : s_2 ≫ π_L = j_gen := CategoryTheory.Limits.pullback.lift_snd _ _ _
      let β₁ : Y_L.residueField ξ_1 ⟶ (AlgebraicGeometry.Spec (CommRingCat.of L)).residueField pt_L :=
        s_1.residueFieldMap pt_L
      let β₂ : Y_L.residueField ξ_1 ⟶ (AlgebraicGeometry.Spec (CommRingCat.of L)).residueField pt_L :=
        (Y_L.residueFieldCongr hξ).hom ≫ s_2.residueFieldMap pt_L
      have hπ_ξ : π_L.base ξ_1 = j_gen.base pt_L := by rw [← hs1_π]; rfl
      let α : (AlgebraicGeometry.Spec (CommRingCat.of A_L)).residueField (j_gen.base pt_L) ⟶
          Y_L.residueField ξ_1 :=
        ((AlgebraicGeometry.Spec (CommRingCat.of A_L)).residueFieldCongr hπ_ξ.symm).hom ≫
          π_L.residueFieldMap ξ_1
      have hSpec_α : AlgebraicGeometry.Spec.map α ≫
          (AlgebraicGeometry.Spec (CommRingCat.of A_L)).fromSpecResidueField (j_gen.base pt_L) =
          Y_L.fromSpecResidueField ξ_1 ≫ π_L := by
        dsimp [α]
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
          (AlgebraicGeometry.Spec (CommRingCat.of A_L)).residueFieldCongr_fromSpecResidueField hπ_ξ.symm,
          π_L.SpecMap_residueFieldMap_fromSpecResidueField ξ_1]
      have hα_β₁ : α ≫ β₁ = j_gen.residueFieldMap pt_L := by
        apply hSpecMapInj
        apply (cancel_mono ((AlgebraicGeometry.Spec (CommRingCat.of A_L)).fromSpecResidueField (j_gen.base pt_L))).mp
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, hSpec_α,
          ← Category.assoc, s_1.SpecMap_residueFieldMap_fromSpecResidueField pt_L,
          Category.assoc, hs1_π, ← j_gen.SpecMap_residueFieldMap_fromSpecResidueField pt_L]
      have hα_β₂ : α ≫ β₂ = j_gen.residueFieldMap pt_L := by
        apply hSpecMapInj
        apply (cancel_mono ((AlgebraicGeometry.Spec (CommRingCat.of A_L)).fromSpecResidueField (j_gen.base pt_L))).mp
        dsimp [β₂]
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, hSpec_α,
          AlgebraicGeometry.Spec.map_comp, Category.assoc,
          ← Category.assoc (AlgebraicGeometry.Spec.map (Y_L.residueFieldCongr hξ).hom),
          Y_L.residueFieldCongr_fromSpecResidueField hξ,
          ← Category.assoc, s_2.SpecMap_residueFieldMap_fromSpecResidueField pt_L,
          Category.assoc, hs2_π, ← j_gen.SpecMap_residueFieldMap_fromSpecResidueField pt_L]
      have hβ_hom_eq : β₁.hom = β₂.hom := by
        apply hFieldCancelLeft (α := α.hom)
        · rw [show β₁.hom.comp α.hom = (α ≫ β₁).hom from rfl, hα_β₁]
          exact hj_gen_surj
        · change (α ≫ β₁).hom = (α ≫ β₂).hom
          rw [hα_β₁, hα_β₂]
      have hβ_eq : β₁ = β₂ := CommRingCat.hom_ext hβ_hom_eq
      have hfrom_s : (AlgebraicGeometry.Spec (CommRingCat.of L)).fromSpecResidueField pt_L ≫ s_1 =
          (AlgebraicGeometry.Spec (CommRingCat.of L)).fromSpecResidueField pt_L ≫ s_2 := by
        rw [← s_1.SpecMap_residueFieldMap_fromSpecResidueField pt_L,
          ← s_2.SpecMap_residueFieldMap_fromSpecResidueField pt_L]
        change AlgebraicGeometry.Spec.map β₁ ≫ Y_L.fromSpecResidueField ξ_1 =
          AlgebraicGeometry.Spec.map (s_2.residueFieldMap pt_L) ≫ Y_L.fromSpecResidueField ξ_2
        rw [hβ_eq]
        dsimp [β₂]
        rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
          Y_L.residueFieldCongr_fromSpecResidueField hξ]
      exact hs_ne ((cancel_epi _).mp hfrom_s)
    
    have _ : AlgebraicGeometry.IsProper π_L :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback g.left g_L) inferInstance
    have hClosed_πL : IsClosedMap π_L.base := AlgebraicGeometry.Scheme.Hom.isClosedMap π_L
    have hex_z : ∀ i : Fin 2,
        let ξ_i := if i = 0 then ξ_1 else ξ_2
        ∃ z_i : Y_L, (ξ_i ⤳ z_i) ∧ π_L.base z_i = IsLocalRing.closedPoint A_L ∧
          pr_Y.base z_i = y_a := by
      intro i ξ_i
      have hπ_ξi : π_L.base ξ_i = (⊥ : PrimeSpectrum A_L) := by
        dsimp [ξ_i]
        split_ifs with hi
        · change (s_1 ≫ π_L).base pt_L = _
          rw [CategoryTheory.Limits.pullback.lift_snd, hj_gen_pt]
        · change (s_2 ≫ π_L).base pt_L = _
          rw [CategoryTheory.Limits.pullback.lift_snd, hj_gen_pt]
      have hpr_ξi : pr_Y.base ξ_i = y_η := by
        dsimp [ξ_i]
        split_ifs with hi
        · change (s_1 ≫ pr_Y).base pt_L = _
          rw [CategoryTheory.Limits.pullback.lift_fst, hu₁_pt]
        · change (s_2 ≫ pr_Y).base pt_L = _
          rw [CategoryTheory.Limits.pullback.lift_fst, hu₂_pt]
      have hcl_img : IsClosed (π_L.base '' closure ({ξ_i} : Set Y_L)) :=
        hClosed_πL _ isClosed_closure
      have hbot_in : (⊥ : PrimeSpectrum A_L) ∈ π_L.base '' closure ({ξ_i} : Set Y_L) :=
        ⟨ξ_i, subset_closure (Set.mem_singleton ξ_i), hπ_ξi⟩
      have hbot_spec_cl : (⊥ : PrimeSpectrum A_L) ⤳ IsLocalRing.closedPoint A_L :=
        (PrimeSpectrum.le_iff_specializes _ _).mp bot_le
      have hcl_in_img : IsLocalRing.closedPoint A_L ∈ π_L.base '' closure ({ξ_i} : Set Y_L) := by
        have hsub := closure_minimal (Set.singleton_subset_iff.mpr hbot_in) hcl_img
        exact hsub (specializes_iff_mem_closure.mp hbot_spec_cl)
      obtain ⟨z_i, hz_i_cl, hz_i_π⟩ := hcl_in_img
      have hz_i_sing : pr_Y.base z_i ∈ Z_sing := by
        have hpre_cl : IsClosed (pr_Y.base ⁻¹' Z_sing) :=
          hZ_sing_cl.preimage pr_Y.base.hom.continuous
        have hξ_in : ξ_i ∈ pr_Y.base ⁻¹' Z_sing := by
          change pr_Y.base ξ_i ∈ Z_sing
          rwa [hpr_ξi]
        exact closure_minimal (Set.singleton_subset_iff.mpr hξ_in) hpre_cl hz_i_cl
      have hg_zi : g.left.base (pr_Y.base z_i) = g_L.base (IsLocalRing.closedPoint A_L) := by
        calc g.left.base (pr_Y.base z_i) = (pr_Y ≫ g.left).base z_i := rfl
          _ = (π_L ≫ g_L).base z_i := by rw [CategoryTheory.Limits.pullback.condition]
          _ = g_L.base (π_L.base z_i) := rfl
          _ = g_L.base (IsLocalRing.closedPoint A_L) := by rw [hz_i_π]
      exact ⟨z_i, specializes_iff_mem_closure.mpr hz_i_cl, hz_i_π,
        hy_a_uniq (pr_Y.base z_i) hz_i_sing hg_zi⟩
    obtain ⟨z_1, hξ1_z1, hz1_π, hz1_pr⟩ := hex_z 0
    obtain ⟨z_2, hξ2_z2, hz2_π, hz2_pr⟩ := hex_z 1
    dsimp at hξ1_z1 hξ2_z2
    have hIso_res_ya : CategoryTheory.IsIso (g.left.residueFieldMap y_a) := by
      let pt_F : AlgebraicGeometry.Spec (CommRingCat.of F) := IsLocalRing.closedPoint F
      have hy_sec_base : y_sec.base pt_F = y_a := hy_sec_pt pt_F
      have hcomp_F : y_sec ≫ g.left ≫ B.hom = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of F)) := by
        rw [g.w]
        exact hy_sec_hom
      have hpt_eq : B.hom.base (g.left.base y_a) = pt_F := Subsingleton.elim _ _
      let φ_head := ((AlgebraicGeometry.Spec (CommRingCat.of F)).residueFieldCongr hpt_eq.symm).hom ≫
        B.hom.residueFieldMap (g.left.base y_a)
      let φ_tail := (Y.left.residueFieldCongr hy_sec_base.symm).hom ≫ y_sec.residueFieldMap pt_F
      let ψ_tot := φ_head ≫ g.left.residueFieldMap y_a ≫ φ_tail
      have hψ_id : ψ_tot = 𝟙 _ := by
        apply hSpecMapInj
        apply (cancel_mono ((AlgebraicGeometry.Spec (CommRingCat.of F)).fromSpecResidueField pt_F)).mp
        have h1 : AlgebraicGeometry.Spec.map φ_head ≫
            (AlgebraicGeometry.Spec (CommRingCat.of F)).fromSpecResidueField pt_F =
            B.left.fromSpecResidueField (g.left.base y_a) ≫ B.hom := by
          dsimp [φ_head]
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
            (AlgebraicGeometry.Spec (CommRingCat.of F)).residueFieldCongr_fromSpecResidueField hpt_eq.symm,
            B.hom.SpecMap_residueFieldMap_fromSpecResidueField (g.left.base y_a)]
        have h2 : AlgebraicGeometry.Spec.map φ_tail ≫ Y.left.fromSpecResidueField y_a =
            (AlgebraicGeometry.Spec (CommRingCat.of F)).fromSpecResidueField pt_F ≫ y_sec := by
          dsimp [φ_tail]
          rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
            Y.left.residueFieldCongr_fromSpecResidueField hy_sec_base.symm,
            y_sec.SpecMap_residueFieldMap_fromSpecResidueField pt_F]
        dsimp [ψ_tot]
        rw [AlgebraicGeometry.Spec.map_id, Category.id_comp,
          AlgebraicGeometry.Spec.map_comp, Category.assoc, h1,
          AlgebraicGeometry.Spec.map_comp, Category.assoc,
          ← Category.assoc (AlgebraicGeometry.Spec.map (g.left.residueFieldMap y_a)),
          g.left.SpecMap_residueFieldMap_fromSpecResidueField y_a,
          Category.assoc, ← Category.assoc (AlgebraicGeometry.Spec.map φ_tail), h2,
          Category.assoc, hcomp_F, Category.comp_id]
      have hsurj_ya : Function.Surjective (g.left.residueFieldMap y_a).hom := by
        intro w
        have hval : ψ_tot.hom (φ_tail.hom w) = φ_tail.hom w := by
          rw [hψ_id]; rfl
        refine ⟨φ_head.hom (φ_tail.hom w), ?_⟩
        apply φ_tail.hom.injective
        exact hval
      exact (ConcreteCategory.isIso_iff_bijective (g.left.residueFieldMap y_a)).mpr
        ⟨(g.left.residueFieldMap y_a).hom.injective, hsurj_ya⟩
    have hz1_eq_z2 : z_1 = z_2 := by
      let T₁ := AlgebraicGeometry.Scheme.Pullback.Triplet.ofPoint z_1
      let T₂ := AlgebraicGeometry.Scheme.Pullback.Triplet.ofPoint z_2
      have hT_eq : T₁ = T₂ := by
        apply AlgebraicGeometry.Scheme.Pullback.Triplet.ext
        · rw [AlgebraicGeometry.Scheme.Pullback.Triplet.ofPoint_x,
            AlgebraicGeometry.Scheme.Pullback.Triplet.ofPoint_x, hz1_pr, hz2_pr]
        · rw [AlgebraicGeometry.Scheme.Pullback.Triplet.ofPoint_y,
            AlgebraicGeometry.Scheme.Pullback.Triplet.ofPoint_y, hz1_π, hz2_π]
      have hPb_T₂ := T₂.isPullback_SpecMap_tensor
      have hT₂_x : T₂.x = y_a := by
        rw [AlgebraicGeometry.Scheme.Pullback.Triplet.ofPoint_x, hz2_pr]
      have _ : CategoryTheory.IsIso (g.left.residueFieldMap T₂.x) := by
        rw [hT₂_x]
        exact hIso_res_ya
      have hIso_fT₂ : CategoryTheory.IsIso
          (AlgebraicGeometry.Spec.map ((B.left.residueFieldCongr T₂.hx).inv ≫
            g.left.residueFieldMap T₂.x)) := inferInstance
      have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map T₂.tensorInr) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_T₂ hIso_fT₂
      let e_inr := CategoryTheory.asIso (AlgebraicGeometry.Spec.map T₂.tensorInr)
      have hInj_inr : Function.Injective e_inr.hom.base := by
        intro p₁ p₂ hp
        have h1 := congrArg (fun f => f.base p₁) e_inr.hom_inv_id
        have h2 := congrArg (fun f => f.base p₂) e_inr.hom_inv_id
        change e_inr.inv.base (e_inr.hom.base p₁) = p₁ at h1
        change e_inr.inv.base (e_inr.hom.base p₂) = p₂ at h2
        rw [← h1, ← h2, hp]
      have hSub_tensor : Subsingleton ↥(AlgebraicGeometry.Spec T₂.tensor) :=
        hInj_inr.subsingleton
      apply AlgebraicGeometry.Scheme.Pullback.carrierEquiv.injective
      rw [AlgebraicGeometry.Scheme.Pullback.carrierEquiv_eq_iff]
      exact ⟨hT_eq, @Subsingleton.elim _ hSub_tensor _ _⟩
    let z_star : Y_L := z_1
    have hξ1_z : ξ_1 ⤳ z_star := hξ1_z1
    have hξ2_z : ξ_2 ⤳ z_star := by
      change ξ_2 ⤳ z_1
      rwa [hz1_eq_z2]
    
    let W_L := CategoryTheory.Limits.pullback e_Ya pr_Y
    let p_V : W_L ⟶ V'_a := CategoryTheory.Limits.pullback.fst e_Ya pr_Y
    let p_W : W_L ⟶ Y_L := CategoryTheory.Limits.pullback.snd e_Ya pr_Y
    obtain ⟨w_star, hw_star_V, hw_star_Y⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v_a z_star
        (hv_a_eq.trans hz1_pr.symm)
    obtain ⟨w_1, hw1_spec, hw1_pW⟩ :=
      AlgebraicGeometry.Flat.generalizingMap p_W (hw_star_Y.symm ▸ hξ1_z)
    obtain ⟨w_2, hw2_spec, hw2_pW⟩ :=
      AlgebraicGeometry.Flat.generalizingMap p_W (hw_star_Y.symm ▸ hξ2_z)
    have hw1_ne_w2 : w_1 ≠ w_2 := fun h => hξ_ne (by rw [← hw1_pW, ← hw2_pW, h])
    let P_Ra : MvPolynomial (Fin (m + 1) × Fin 2) R'_a :=
      (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h_a
    let M_Ra : CommRingCat.{u} :=
      CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R'_a ⧸ Ideal.span {P_Ra})
    let f_Ra : R'_a ⟶ M_Ra := CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
    let π_mod_a : AlgebraicGeometry.Spec M_Ra ⟶ AlgebraicGeometry.Spec R'_a :=
      AlgebraicGeometry.Spec.map f_Ra
    let B'_L := CategoryTheory.Limits.pullback e_Ba g_L
    let pr_Ba : B'_L ⟶ AlgebraicGeometry.Spec R'_a := CategoryTheory.Limits.pullback.fst e_Ba g_L
    let π'_B : B'_L ⟶ AlgebraicGeometry.Spec (CommRingCat.of A_L) :=
      CategoryTheory.Limits.pullback.snd e_Ba g_L
    have hw_WB' : (p_V ≫ q_a ≫ π_mod_a) ≫ e_Ba = (p_W ≫ π_L) ≫ g_L := by
      rw [Category.assoc, Category.assoc, ← hcomm_a, ← Category.assoc p_V,
        CategoryTheory.Limits.pullback.condition, Category.assoc,
        CategoryTheory.Limits.pullback.condition, Category.assoc]
    let π_WB' : W_L ⟶ B'_L := CategoryTheory.Limits.pullback.lift
      (p_V ≫ q_a ≫ π_mod_a) (p_W ≫ π_L) hw_WB'
    have hPb_WB' : CategoryTheory.IsPullback p_V π_WB' (q_a ≫ π_mod_a) pr_Ba := by
      refine (CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback e_Ba g_L).flip).flip
      have hsnd : π_WB' ≫ π'_B = p_W ≫ π_L := CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hbot : (q_a ≫ π_mod_a) ≫ e_Ba = e_Ya ≫ g.left := by
        rw [Category.assoc, ← hcomm_a]
      rw [hsnd, hbot]
      exact ((CategoryTheory.IsPullback.of_hasPullback e_Ya pr_Y).flip).paste_horiz
        ((CategoryTheory.IsPullback.of_hasPullback g.left g_L).flip)
    obtain ⟨S'_cat, j_B', hj_B'_open, hmem_B', _⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : B'_L.Opens)) (x := π_WB'.base w_star) trivial
    let S'_L : Type u := ↥S'_cat
    let α_AL : A_L →+* S'_L := (AlgebraicGeometry.Spec.preimage (j_B' ≫ π'_B)).hom
    let β_Ra : ↑R'_a →+* S'_L := (AlgebraicGeometry.Spec.preimage (j_B' ≫ pr_Ba)).hom
    have hEt_AL_S' : α_AL.Etale := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
        AlgebraicGeometry.Spec.map_preimage]
      infer_instance
    let _ : Algebra A_L S'_L := α_AL.toAlgebra
    have _ : Algebra.Etale A_L S'_L := RingHom.etale_algebraMap.mp hEt_AL_S'
    
    have hh_L_nil : ∀ 𝔲 : PrimeSpectrum S'_L, β_Ra h_a ∈ 𝔲.asIdeal := by
      intro 𝔲
      have hSpec_β : AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_Ra) = j_B' ≫ pr_Ba :=
        AlgebraicGeometry.Spec.map_preimage _
      have hin_disc : e_Ba.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_Ra)).base 𝔲) ∈ Z_disc := by
        rw [hSpec_β]
        change (j_B' ≫ pr_Ba ≫ e_Ba).base 𝔲 ∈ Z_disc
        rw [CategoryTheory.Limits.pullback.condition]
        exact hg_L_disc _
      have hin_pre : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_Ra)).base 𝔲 ∈ e_Ba.base ⁻¹' Z_disc :=
        hin_disc
      rw [he_Ba_disc] at hin_pre
      exact hin_pre
    have hh_L_isNil : IsNilpotent (β_Ra h_a) := by
      rw [← mem_nilradical, nilradical_eq_sInf, Ideal.mem_sInf]
      intro I hI_prime
      exact hh_L_nil ⟨I, hI_prime⟩
    obtain ⟨N_nil, hN_nil⟩ := hh_L_isNil
    have hh_L_zero : β_Ra h_a = 0 := by
      let S'_K := TensorProduct A_L L S'_L
      have _ : Algebra.Etale L S'_K := inferInstance
      have hInj_lin : Function.Injective (Algebra.linearMap A_L L) :=
        IsFractionRing.injective A_L L
      have hInj_ten : Function.Injective (LinearMap.rTensor S'_L (Algebra.linearMap A_L L)) :=
        Module.Flat.rTensor_preserves_injective_linearMap _ hInj_lin
      have hInj_S' : Function.Injective (fun s : S'_L => (1 : L) ⊗ₜ[A_L] s) := by
        intro s₁ s₂ hs
        have h1 : LinearMap.rTensor S'_L (Algebra.linearMap A_L L) ((1 : A_L) ⊗ₜ[A_L] s₁) =
            LinearMap.rTensor S'_L (Algebra.linearMap A_L L) ((1 : A_L) ⊗ₜ[A_L] s₂) := by
          simpa using hs
        have h2 := congrArg (TensorProduct.lid A_L S'_L) (hInj_ten h1)
        simpa using h2
      have hpow_zero : ((1 : L) ⊗ₜ[A_L] (β_Ra h_a) : S'_K) ^ N_nil = 0 := by
        have hmap : ((Algebra.TensorProduct.includeRight : S'_L →ₐ[A_L] S'_K) (β_Ra h_a)) ^ N_nil = 0 := by
          rw [← map_pow, hN_nil, map_zero]
        exact hmap
      have hRed_pow : ∀ (k : ℕ) (z : S'_K), z ^ k = 0 → z = 0 := by
        intro k
        induction k with
        | zero =>
          intro z hz
          rw [pow_zero] at hz
          exact (mul_one z).symm.trans (hz ▸ mul_zero z)
        | succ k ih =>
          intro z hz
          rcases Nat.eq_zero_or_pos k with rfl | hk_pos
          · simpa using hz
          · have hzk_sq : (z ^ k) * (z ^ k) = 0 := by
              have hadd : k + k = (k + 1) + (k - 1) := by omega
              rw [← pow_add, hadd, pow_add, hz, zero_mul]
            obtain ⟨v_k, hv_k⟩ := hEtaleFieldVNR L S'_K (z ^ k)
            have hzk0 : z ^ k = 0 := by
              rw [← hv_k, hzk_sq, zero_mul]
            exact ih z hzk0
      apply hInj_S'
      dsimp only
      rw [TensorProduct.tmul_zero]
      exact hRed_pow N_nil _ hpow_zero
    let Q_quad_S' : MvPolynomial (Fin (m + 1) × Fin 2) S'_L :=
      ∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)
    have hmap_PRa : MvPolynomial.map β_Ra P_Ra = Q_quad_S' := by
      dsimp [P_Ra, Q_quad_S']
      rw [map_sub, map_sum, MvPolynomial.map_C, hh_L_zero, map_zero, sub_zero]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
    obtain ⟨π_MS', hπ_MS'_X, _, hPb_MS'⟩ := hMvQuotIsPullback β_Ra P_Ra Q_quad_S' hmap_PRa
    let M_S'_cat : CommRingCat.{u} :=
      CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) S'_L ⧸ Ideal.span {Q_quad_S'})
    let f_S'M : S'_cat ⟶ M_S'_cat :=
      CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
    let W_S' := CategoryTheory.Limits.pullback π_WB' j_B'
    let j_WS' : W_S' ⟶ W_L := CategoryTheory.Limits.pullback.fst π_WB' j_B'
    let π_WS' : W_S' ⟶ AlgebraicGeometry.Spec S'_cat := CategoryTheory.Limits.pullback.snd π_WB' j_B'
    have _ : AlgebraicGeometry.IsOpenImmersion j_WS' := inferInstance
    have hPb_WS'_Ra : CategoryTheory.IsPullback (j_WS' ≫ p_V) π_WS' (q_a ≫ π_mod_a)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_Ra)) := by
      have hSpec_β : AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_Ra) = j_B' ≫ pr_Ba :=
        AlgebraicGeometry.Spec.map_preimage _
      rw [hSpec_β]
      exact (CategoryTheory.IsPullback.of_hasPullback π_WB' j_B').paste_horiz hPb_WB'
    have hw_WS'_M : (j_WS' ≫ p_V ≫ q_a) ≫ π_mod_a =
        π_WS' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_Ra) := by
      simpa [Category.assoc] using hPb_WS'_Ra.w
    let q_WS' : W_S' ⟶ AlgebraicGeometry.Spec M_S'_cat :=
      hPb_MS'.lift (j_WS' ≫ p_V ≫ q_a) π_WS' hw_WS'_M
    have hPb_qWS' : CategoryTheory.IsPullback (j_WS' ≫ p_V) q_WS' q_a
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_MS')) := by
      refine (CategoryTheory.IsPullback.of_right ?_
        (by rw [Category.assoc]; exact hPb_MS'.lift_fst _ _ _) hPb_MS'.flip).flip
      rw [show q_WS' ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) = π_WS' from
        hPb_MS'.lift_snd _ _ _]
      exact hPb_WS'_Ra.flip
    have _ : AlgebraicGeometry.Etale q_WS' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_qWS' inferInstance
    obtain ⟨u_B'_star, hu_B'_star⟩ := hmem_B'
    obtain ⟨w'_star, hw'_star_j, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w_star u_B'_star hu_B'_star.symm
    obtain ⟨E_cat, j_EW', hj_EW'_open, hmem_E, _⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : W_S'.Opens)) (x := w'_star) trivial
    let j_EW : AlgebraicGeometry.Spec E_cat ⟶ W_L := j_EW' ≫ j_WS'
    have _ : AlgebraicGeometry.IsOpenImmersion j_EW := inferInstance
    obtain ⟨𝔮_star, h𝔮_star⟩ := hmem_E
    have hj_EW_star : j_EW.base 𝔮_star = w_star := by
      change j_WS'.base (j_EW'.base 𝔮_star) = w_star
      rw [h𝔮_star, hw'_star_j]
    have hw_in_E : ∀ w : W_L, (w ⤳ w_star) → ∃ 𝔮 : AlgebraicGeometry.Spec E_cat,
        j_EW.base 𝔮 = w ∧ 𝔮.asIdeal ≤ 𝔮_star.asIdeal := by
      intro w hw_sp
      have hw_mem : w ∈ Set.range j_EW.base := by
        by_contra hnot
        have hcl : IsClosed ((Set.range j_EW.base)ᶜ) := j_EW.isOpenEmbedding.isOpen_range.isClosed_compl
        have hsub := closure_minimal (Set.singleton_subset_iff.mpr hnot) hcl
        exact hsub (specializes_iff_mem_closure.mp hw_sp) ⟨𝔮_star, hj_EW_star⟩
      obtain ⟨𝔮, h𝔮⟩ := hw_mem
      have h𝔮_sp : 𝔮 ⤳ 𝔮_star := by
        rw [← j_EW.isOpenEmbedding.isInducing.specializes_iff, h𝔮, hj_EW_star]
        exact hw_sp
      exact ⟨𝔮, h𝔮, (PrimeSpectrum.le_iff_specializes 𝔮 𝔮_star).mpr h𝔮_sp⟩
    obtain ⟨𝔮_1, h𝔮_1, h𝔮1_le⟩ := hw_in_E w_1 hw1_spec
    obtain ⟨𝔮_2, h𝔮_2, h𝔮2_le⟩ := hw_in_E w_2 hw2_spec
    have h𝔮1_ne_𝔮2 : 𝔮_1 ≠ 𝔮_2 := fun h => hw1_ne_w2 (by rw [← h𝔮_1, ← h𝔮_2, h])
    let E_L : Type u := ↥E_cat
    let q_L_cat : M_S'_cat ⟶ E_cat := AlgebraicGeometry.Spec.preimage (j_EW' ≫ q_WS')
    let q_L : ↥M_S'_cat →+* E_L := q_L_cat.hom
    have hEt_qL : q_L.Etale := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
        AlgebraicGeometry.Spec.map_preimage]
      infer_instance
    let _ : Algebra ↥M_S'_cat E_L := q_L.toAlgebra
    have _ : Algebra.Etale ↥M_S'_cat E_L := RingHom.etale_algebraMap.mp hEt_qL
    let ε_0_mv : MvPolynomial (Fin (m + 1) × Fin 2) S'_L →+* S'_L :=
      MvPolynomial.eval₂Hom (RingHom.id S'_L) (fun _ => 0)
    have hKer_ε0 : ∀ P ∈ Ideal.span {Q_quad_S'}, ε_0_mv P = 0 := by
      intro P hP
      obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton.mp hP
      have hQ0 : ε_0_mv Q_quad_S' = 0 := by
        simp [ε_0_mv, Q_quad_S']
      rw [map_mul, hQ0, zero_mul]
    let ε_0 : ↥M_S'_cat →+* S'_L := Ideal.Quotient.lift (Ideal.span {Q_quad_S'}) ε_0_mv hKer_ε0
    let I_X : Ideal ↥M_S'_cat := RingHom.ker ε_0
    have hI_X_X : ∀ x ∈ I_X, q_L x ∈ 𝔮_star.asIdeal ∧ q_L x ∈ 𝔮_1.asIdeal ∧ q_L x ∈ 𝔮_2.asIdeal := by
      have hX_mem : ∀ (𝔮 : AlgebraicGeometry.Spec E_cat),
          (e_Ya.base (p_V.base (j_EW.base 𝔮)) = y_η ∨ p_V.base (j_EW.base 𝔮) = v_a) →
          ∀ idx : Fin (m + 1) × Fin 2,
            q_L (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ 𝔮.asIdeal := by
        intro 𝔮 hcase idx
        have hSpec_qL : AlgebraicGeometry.Spec.map q_L_cat ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_MS') =
            j_EW ≫ p_V ≫ q_a := by
          rw [AlgebraicGeometry.Spec.map_preimage, Category.assoc]
          have hq_fst : q_WS' ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_MS') =
              j_WS' ≫ p_V ≫ q_a := hPb_MS'.lift_fst _ _ _
          rw [hq_fst]
          rfl
        have hbase_𝔮 := congrArg (fun f => (f.base 𝔮).asIdeal) hSpec_qL
        change Ideal.comap π_MS' (Ideal.comap q_L 𝔮.asIdeal) =
          (q_a.base (p_V.base (j_EW.base 𝔮))).asIdeal at hbase_𝔮
        have hidx_qa : Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈
            (q_a.base (p_V.base (j_EW.base 𝔮))).asIdeal := by
          rcases hcase with hy | hva
          · exact hv_η_vtx _ hy idx
          · rw [hva]; exact hv_a_X idx
        rw [← hbase_𝔮] at hidx_qa
        change π_MS' (Ideal.Quotient.mk _ (MvPolynomial.X idx)) ∈ Ideal.comap q_L 𝔮.asIdeal at hidx_qa
        rw [hπ_MS'_X idx] at hidx_qa
        exact hidx_qa
      have hcase_star : e_Ya.base (p_V.base (j_EW.base 𝔮_star)) = y_η ∨
          p_V.base (j_EW.base 𝔮_star) = v_a := by
        rw [hj_EW_star, hw_star_V]; exact Or.inr rfl
      have hcase_1 : e_Ya.base (p_V.base (j_EW.base 𝔮_1)) = y_η ∨
          p_V.base (j_EW.base 𝔮_1) = v_a := by
        left
        rw [h𝔮_1]
        change (p_V ≫ e_Ya).base w_1 = y_η
        rw [CategoryTheory.Limits.pullback.condition]
        change pr_Y.base (p_W.base w_1) = y_η
        rw [hw1_pW]
        change (s_1 ≫ pr_Y).base pt_L = y_η
        rw [CategoryTheory.Limits.pullback.lift_fst, hu₁_pt]
      have hcase_2 : e_Ya.base (p_V.base (j_EW.base 𝔮_2)) = y_η ∨
          p_V.base (j_EW.base 𝔮_2) = v_a := by
        left
        rw [h𝔮_2]
        change (p_V ≫ e_Ya).base w_2 = y_η
        rw [CategoryTheory.Limits.pullback.condition]
        change pr_Y.base (p_W.base w_2) = y_η
        rw [hw2_pW]
        change (s_2 ≫ pr_Y).base pt_L = y_η
        rw [CategoryTheory.Limits.pullback.lift_fst, hu₂_pt]
      intro x hx
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      have hdecomp : Ideal.Quotient.mk (Ideal.span {Q_quad_S'}) P =
          Ideal.Quotient.mk _ (P - MvPolynomial.C (ε_0_mv P)) := by
        have hev0 : ε_0_mv P = 0 := hx
        rw [hev0, map_zero, sub_zero]
      rw [hdecomp]
      have hVan : ∀ Q : MvPolynomial (Fin (m + 1) × Fin 2) S'_L,
          let d := Q - MvPolynomial.C (ε_0_mv Q)
          q_L (Ideal.Quotient.mk _ d) ∈ 𝔮_star.asIdeal ∧
            q_L (Ideal.Quotient.mk _ d) ∈ 𝔮_1.asIdeal ∧
            q_L (Ideal.Quotient.mk _ d) ∈ 𝔮_2.asIdeal := by
        intro Q
        induction Q using MvPolynomial.induction_on with
        | C s => simp [ε_0_mv]
        | add p₁ p₂ hp₁ hp₂ =>
          dsimp only
          have hadd : p₁ + p₂ - MvPolynomial.C (ε_0_mv (p₁ + p₂)) =
              (p₁ - MvPolynomial.C (ε_0_mv p₁)) + (p₂ - MvPolynomial.C (ε_0_mv p₂)) := by
            rw [map_add, map_add]; ring
          rw [hadd, map_add, map_add]
          exact ⟨Ideal.add_mem _ hp₁.1 hp₂.1, Ideal.add_mem _ hp₁.2.1 hp₂.2.1,
            Ideal.add_mem _ hp₁.2.2 hp₂.2.2⟩
        | mul_X p idx _ =>
          dsimp only
          have hmul : p * MvPolynomial.X idx - MvPolynomial.C (ε_0_mv (p * MvPolynomial.X idx)) =
              p * MvPolynomial.X idx := by
            simp [ε_0_mv]
          rw [hmul, map_mul, map_mul]
          exact ⟨Ideal.mul_mem_left _ _ (hX_mem 𝔮_star hcase_star idx),
            Ideal.mul_mem_left _ _ (hX_mem 𝔮_1 hcase_1 idx),
            Ideal.mul_mem_left _ _ (hX_mem 𝔮_2 hcase_2 idx)⟩
      exact hVan P
    let J_E : Ideal E_L := Ideal.map q_L I_X
    let E_bar : Type u := E_L ⧸ J_E
    have hε0_surj : Function.Surjective ε_0 := fun s =>
      ⟨Ideal.Quotient.mk _ (MvPolynomial.C s), by
        change ε_0_mv (MvPolynomial.C s) = s
        exact MvPolynomial.eval₂Hom_C _ _ s⟩
    let e_quot_S' : (↥M_S'_cat ⧸ I_X) ≃+* S'_L :=
      RingHom.quotientKerEquivOfSurjective hε0_surj
    let φ_S'_Ebar : S'_L →+* E_bar :=
      (Ideal.Quotient.mk J_E).comp (q_L.comp f_S'M.hom)
    let _ : Algebra S'_L E_bar := φ_S'_Ebar.toAlgebra
    have hEt_S'_Ebar : Algebra.Etale S'_L E_bar := by
      let _ : Algebra ↥M_S'_cat S'_L := ε_0.toAlgebra
      let e_ten : E_bar ≃ₐ[E_L] TensorProduct ↥M_S'_cat E_L (↥M_S'_cat ⧸ I_X) :=
        Algebra.TensorProduct.quotIdealMapEquivTensorQuot E_L I_X
      let e_rhs : TensorProduct ↥M_S'_cat E_L (↥M_S'_cat ⧸ I_X) ≃+*
          TensorProduct ↥M_S'_cat E_L S'_L :=
        (Algebra.TensorProduct.congr (@AlgEquiv.refl ↥M_S'_cat E_L _ _ _)
          { e_quot_S' with commutes' := fun _ => rfl }).toRingEquiv
      let e_comm : TensorProduct ↥M_S'_cat E_L S'_L ≃ₐ[↥M_S'_cat]
          TensorProduct ↥M_S'_cat S'_L E_L :=
        Algebra.TensorProduct.comm ↥M_S'_cat E_L S'_L
      have _ : Algebra.Etale S'_L (TensorProduct ↥M_S'_cat S'_L E_L) := inferInstance
      let e_tot := (e_ten.toRingEquiv.trans e_rhs).trans e_comm.toRingEquiv
      let Φ_alg : TensorProduct ↥M_S'_cat S'_L E_L ≃ₐ[S'_L] E_bar :=
        AlgEquiv.ofRingEquiv
          (f := e_tot.symm)
          (fun s => by
            apply e_tot.injective
            rw [RingEquiv.apply_symm_apply]
            symm
            change e_comm (e_rhs (e_ten (Ideal.Quotient.mk J_E (q_L (f_S'M.hom s))))) =
              s ⊗ₜ[↥M_S'_cat] (1 : E_L)
            have h1 : e_ten (Ideal.Quotient.mk J_E (q_L (f_S'M.hom s))) =
                q_L (f_S'M.hom s) ⊗ₜ[↥M_S'_cat] (1 : ↥M_S'_cat ⧸ I_X) := rfl
            rw [h1]
            have h2 : q_L (f_S'M.hom s) ⊗ₜ[↥M_S'_cat] (1 : ↥M_S'_cat ⧸ I_X) =
                (1 : E_L) ⊗ₜ[↥M_S'_cat] (Ideal.Quotient.mk I_X (f_S'M.hom s)) := by
              let r_M : ↥M_S'_cat := f_S'M.hom s
              have hsmul1 : q_L (f_S'M.hom s) = r_M • (1 : E_L) := by
                rw [Algebra.smul_def, mul_one]; rfl
              have hsmul2 : r_M • (1 : ↥M_S'_cat ⧸ I_X) = Ideal.Quotient.mk I_X (f_S'M.hom s) := by
                change Ideal.Quotient.mk I_X (r_M * 1) = Ideal.Quotient.mk I_X r_M
                rw [mul_one]
              rw [hsmul1, ← hsmul2]
              exact TensorProduct.smul_tmul (R := ↥M_S'_cat) (R' := ↥M_S'_cat)
                r_M (1 : E_L) (1 : ↥M_S'_cat ⧸ I_X)
            rw [h2]
            change e_comm ((1 : E_L) ⊗ₜ[↥M_S'_cat] e_quot_S' (Ideal.Quotient.mk I_X (f_S'M.hom s))) = _
            have h3 : e_quot_S' (Ideal.Quotient.mk I_X (f_S'M.hom s)) = s := by
              change ε_0_mv (MvPolynomial.C s) = s
              exact MvPolynomial.eval₂Hom_C _ _ s
            rw [h3]
            rfl)
      exact Algebra.Etale.of_equiv Φ_alg
    let _ : Algebra A_L E_bar := (φ_S'_Ebar.comp α_AL).toAlgebra
    have _ : IsScalarTower A_L S'_L E_bar := IsScalarTower.of_algebraMap_eq' rfl
