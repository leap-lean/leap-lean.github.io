        exact IsLocalRing.notMem_maximalIdeal.mpr (IsUnit.mk0 _ hΔ_ne₁) hΔ_max₁
      have hmax₁_prin : (IsLocalRing.maximalIdeal R₁).IsPrincipal := ⟨⟨π₁, hmax₁_prin_eq⟩⟩
      have hDedR₁ : IsDedekindDomain R₁ :=
        ((IsDiscreteValuationRing.TFAE R₁ hR₁_not_field).out 5 3 (by rfl) (by rfl)).mp hmax₁_prin
      exact ⟨h𝔭₁_ne_max, hDedR₁⟩
    obtain ⟨h𝔭₁_ne_max, hDed_AtPrime⟩ := hStep2
    haveI : IsDomain (Localization.AtPrime 𝔭₁) :=
      IsLocalization.isDomain_localization 𝔭₁.primeCompl_le_nonZeroDivisors
    haveI : IsDedekindDomain (Localization.AtPrime 𝔭₁) := hDed_AtPrime
    suffices hStep3 : ∀ (R₁ : Type u) [CommRing R₁] [IsDomain R₁] [IsDedekindDomain R₁]
        [IsLocalRing R₁] [Algebra R_loc R₁] [IsLocalization.AtPrime R₁ 𝔭₁], False by
      exact hStep3 (Localization.AtPrime 𝔭₁)
    intro R₁ _ _ _ _ _ _
    have hmem_max_R₁ : ∀ r : R_loc, r ∈ 𝔭₁ ↔ algebraMap R_loc R₁ r ∈ IsLocalRing.maximalIdeal R₁ :=
      fun r => SetLike.ext_iff.mp (IsLocalization.AtPrime.comap_maximalIdeal R₁ 𝔭₁).symm r
    let φ₁ : R₁ →+* K_loc := IsLocalization.lift h_units_p1
    have hφ₁_eq : ∀ r : R_loc, φ₁ (algebraMap R_loc R₁ r) = algebraMap R_loc K_loc r :=
      fun r => IsLocalization.lift_eq h_units_p1 r
    have hφ₁_inj : Function.Injective φ₁ := by
      intro w₁ w₂ hw
      suffices h0 : w₁ - w₂ = 0 by exact sub_eq_zero.mp h0
      have hw0 : φ₁ (w₁ - w₂) = 0 := by rw [map_sub, hw, sub_self]
      obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj 𝔭₁.primeCompl (w₁ - w₂)
      dsimp only at has
      have haK : algebraMap R_loc K_loc a = 0 := by rw [← hφ₁_eq a, ← has, map_mul, hw0, zero_mul]
      have haR : a = 0 := IsFractionRing.injective R_loc K_loc (haK.trans (map_zero _).symm)
      rw [haR, map_zero, mul_comm] at has
      exact (IsLocalization.map_units R₁ s).mul_right_eq_zero.mp has
    letI : Algebra R₁ K_loc := φ₁.toAlgebra
    haveI : IsScalarTower R_loc R₁ K_loc := IsScalarTower.of_algebraMap_eq fun r => (hφ₁_eq r).symm
    haveI hFracR₁ : IsFractionRing R₁ K_loc :=
      { map_units := fun s => IsUnit.mk0 (φ₁ s.1) fun h0 =>
          mem_nonZeroDivisors_iff_ne_zero.mp s.2 (hφ₁_inj (h0.trans (map_zero _).symm))
        surj := fun x => by
          obtain ⟨⟨a, s⟩, hx⟩ := hsurj_K x
          dsimp only at hx
          have hs_ne : algebraMap R_loc R₁ s.1 ≠ 0 := fun h0 =>
            nonZeroDivisors.ne_zero s.2
              (IsLocalization.injective R₁ 𝔭₁.primeCompl_le_nonZeroDivisors (h0.trans (map_zero _).symm))
          refine ⟨⟨algebraMap R_loc R₁ a,
            ⟨algebraMap R_loc R₁ s.1, mem_nonZeroDivisors_iff_ne_zero.mpr hs_ne⟩⟩, ?_⟩
          dsimp only
