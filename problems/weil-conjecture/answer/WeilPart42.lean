          rw [← map_mul, hb_eq, map_zero]
        rcases mul_eq_zero.mp hmul0 with hb0 | hbm0
        · obtain ⟨⟨s, hs_not_mem⟩, hs_eq⟩ :=
            (IsLocalization.map_eq_zero_iff 𝔪.primeCompl R_𝔪 b).mp hb0
          have hs_mem : s ∈ J_cond := ⟨0, by simpa using hs_eq⟩
          exact hs_not_mem (hJ_le hs_mem)
        · obtain ⟨⟨s, hs_not_mem⟩, hs_eq⟩ :=
            (IsLocalization.map_eq_zero_iff 𝔪.primeCompl R_𝔪 (b - u_el ^ m)).mp hbm0
          have hs_mem : s ∈ J_cond := ⟨s, by
            rw [mul_sub] at hs_eq
            exact sub_eq_zero.mp hs_eq⟩
          exact hs_not_mem (hJ_le hs_mem)
      have h1_mem : (1 : R) ∈ J_cond := by
        rw [hJ_top]
        exact Submodule.mem_top
      obtain ⟨e, he_eq⟩ := h1_mem
      have hb_e : b = e * u_el ^ m := by simpa only [one_mul] using he_eq
      have he_idemp_mul : u_el ^ (2 * m) * (e * e - e) = 0 := by
