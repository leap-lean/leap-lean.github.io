      obtain ⟨π₁, hπ₁_X, _, hPb_C₁⟩ := hMvQuotIsPullback χ₁ P_R₁ Q_quad hmap_P₁
      have hmap_P₂ : MvPolynomial.map χ₂ P_R₂ = (0 : MvPolynomial (Fin (2 * m + 1)) κ) :=
        map_zero _
      obtain ⟨π₂, _, _, hPb_C₂⟩ := hMvQuotIsPullback χ₂ P_R₂ 0 hmap_P₂
      obtain ⟨S₀, _, ι_S, ε₀, ψ_cone, ψ_sm0, hε_ι, hEt_cone, hψ_cone_ι, hker_cone,
          hEt_sm0, hψ_sm0_ι, _⟩ :=
        hExtract _ _ π₁ ((Ideal.Quotient.mk _).comp MvPolynomial.C)
          π₂ ((Ideal.Quotient.mk _).comp MvPolynomial.C) hPb_C₁ hPb_C₂
      let _ : CommRing S₀ := ‹CommRing S₀›
      let e_sm_quot : MvPolynomial (Fin (2 * m + 1)) κ ≃+*
          (MvPolynomial (Fin (2 * m + 1)) κ ⧸ Ideal.span {(0 : MvPolynomial (Fin (2 * m + 1)) κ)}) :=
        (RingEquiv.quotientBot _).symm.trans
          (Ideal.quotEquivOfEq (Ideal.span_singleton_eq_bot.mpr rfl)).symm
      let ψ_sm : MvPolynomial (Fin (2 * m + 1)) κ →+* S₀ := ψ_sm0.comp e_sm_quot.toRingHom
      have hEt_sm : ψ_sm.Etale := by
        refine (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
          (φ := CommRingCat.ofHom ψ_sm)).mp ?_
        have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm0) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sm_quot.toRingHom) := by
          dsimp [ψ_sm]
          rw [← AlgebraicGeometry.Spec.map_comp]
        rw [hfac]
        have _ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sm0)) :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
            (φ := CommRingCat.ofHom ψ_sm0)).mpr hEt_sm0
        have _ : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sm_quot.toRingHom)) :=
          ⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_sm_quot.symm.toRingHom),
            by
              rw [← AlgebraicGeometry.Spec.map_comp]
              exact (congrArg AlgebraicGeometry.Spec.map (by
                apply CommRingCat.hom_ext; apply RingHom.ext; intro x
                exact e_sm_quot.apply_symm_apply x)).trans (AlgebraicGeometry.Spec.map_id _),
            by
              rw [← AlgebraicGeometry.Spec.map_comp]
              exact (congrArg AlgebraicGeometry.Spec.map (by
                apply CommRingCat.hom_ext; apply RingHom.ext; intro x
                exact e_sm_quot.symm_apply_apply x)).trans (AlgebraicGeometry.Spec.map_id _)⟩
