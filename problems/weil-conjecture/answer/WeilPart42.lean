theorem weil_dvr_slice_2d_separable_pderiv_and_transverse_slice (k : Type u) [Field k] [IsAlgClosed k]
    (H : MvPolynomial (Fin 2) k) (hH_irr : Irreducible H) :
    (MvPolynomial.pderiv 0 H ≠ 0 ∨ MvPolynomial.pderiv 1 H ≠ 0) ∧
    (MvPolynomial.pderiv 0 H ≠ 0 →
      let F₁ := FractionRing (Polynomial k)
      let κ₁ := AlgebraicClosure F₁
      let φ_k_κ₁ : k →+* κ₁ :=
        (algebraMap F₁ κ₁).comp ((algebraMap (Polynomial k) F₁).comp Polynomial.C)
      let x₁ : κ₁ := algebraMap F₁ κ₁ (algebraMap (Polynomial k) F₁ Polynomial.X)
      ∃ (α₀ : κ₁),
        let ι_slice : MvPolynomial (Fin 2) k →+* Polynomial κ₁ :=
          MvPolynomial.eval₂Hom (Polynomial.C.comp φ_k_κ₁)
            ![Polynomial.X + Polynomial.C α₀, Polynomial.C x₁]
        Function.Injective ι_slice ∧
        ι_slice.comp MvPolynomial.C = Polynomial.C.comp φ_k_κ₁ ∧
        Ideal.comap ι_slice (Ideal.span {Polynomial.X}) = Ideal.span {H} ∧
        (Polynomial.derivative (ι_slice H)).eval 0 ≠ 0 ∧
        ∀ g : Polynomial k, g ≠ 0 →
          Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) g ∉ Ideal.span {H}) :=
by
  have hConj1 : MvPolynomial.pderiv 0 H ≠ 0 ∨ MvPolynomial.pderiv 1 H ≠ 0 := by
    by_contra h_not
    rcases not_or.mp h_not with ⟨hp0_not, hp1_not⟩
    have hp0 : MvPolynomial.pderiv 0 H = 0 := not_ne_iff.mp hp0_not
    have hp1 : MvPolynomial.pderiv 1 H = 0 := not_ne_iff.mp hp1_not
    have hp_all : ∀ i : Fin 2, MvPolynomial.pderiv i H = 0 :=
      Fin.forall_fin_two.mpr ⟨hp0, hp1⟩
    have hm_cast : ∀ m ∈ H.support, ∀ i : Fin 2, (m i : k) = 0 := by
      intro m hm i
      have hm_ne : H.coeff m ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      by_cases hmi : m i = 0
      · simp [hmi]
      · have hmi_ge : 1 ≤ m i := Nat.one_le_iff_ne_zero.mpr hmi
        let d : Fin 2 →₀ ℕ := m - Finsupp.single i 1
        have h_le : Finsupp.single i 1 ≤ m := Finsupp.single_le_iff.mpr hmi_ge
        have h_dm : d + Finsupp.single i 1 = m := tsub_add_cancel_of_le h_le
        have h_di : d i + 1 = m i := by
          have h_eval := DFunLike.congr_fun h_dm i
          simpa [Finsupp.add_apply] using h_eval
        have h_di_cast : (d i : k) + 1 = (m i : k) := by
          rw [← h_di, Nat.cast_add, Nat.cast_one]
        have h_coeff : (MvPolynomial.pderiv i H).coeff d = 0 := by
          simp [hp_all i]
        rw [MvPolynomial.coeff_pderiv, h_dm] at h_coeff
        simp only [h_di_cast, mul_eq_zero, hm_ne, false_or] at h_coeff
        exact h_coeff
    by_cases hchar0 : ringChar k = 0
    · have : CharP k 0 := hchar0 ▸ ringChar.charP k
      have : CharZero k := CharP.charP_to_charZero k
      have hm_zero : ∀ m ∈ H.support, m = 0 := by
        intro m hm
        ext i
        fin_cases i
        · simpa using Nat.cast_eq_zero.mp (hm_cast m hm 0)
        · simpa using Nat.cast_eq_zero.mp (hm_cast m hm 1)
      have hH_eq_C : H = MvPolynomial.C (H.coeff 0) := by
        ext m
        rw [MvPolynomial.coeff_C]
        split_ifs with hm0
        · subst hm0; rfl
        · by_contra hne
          have hm_eq : m = 0 := hm_zero m (MvPolynomial.mem_support_iff.mpr hne)
          simp [hm_eq] at hm0
      by_cases hc : H.coeff 0 = 0
      · rw [hc, map_zero] at hH_eq_C
        exact hH_irr.ne_zero hH_eq_C
      · have h_unit : IsUnit H := by
          rw [hH_eq_C]
          exact (IsUnit.mk0 (H.coeff 0) hc).map MvPolynomial.C
        exact hH_irr.not_isUnit h_unit
    · set p := ringChar k
      have : CharP k p := ringChar.charP k
      have hp_prime : Nat.Prime p := (CharP.char_is_prime_or_zero k p).resolve_right hchar0
      have : Fact (Nat.Prime p) := ⟨hp_prime⟩
      have : ExpChar k p := ExpChar.prime hp_prime
      have : PerfectRing k p := IsAlgClosed.perfectRing k p
      have hdvd : ∀ m ∈ H.support, ∀ i : Fin 2, p ∣ m i := by
        intro m hm i
        exact (CharP.cast_eq_zero_iff k p (m i)).mp (hm_cast m hm i)
      let G : MvPolynomial (Fin 2) k :=
        ∑ m ∈ H.support,
          MvPolynomial.monomial (m.mapRange (· / p) (Nat.zero_div p))
            ((frobeniusEquiv k p).symm (H.coeff m))
      have hGp : G ^ p = H := by
        rw [← MvPolynomial.map_frobenius_expand p]
        dsimp only [G]
        rw [map_sum, map_sum]
        have h_sum :
            (∑ x ∈ H.support,
              (MvPolynomial.map (frobenius k p))
                ((MvPolynomial.expand p)
                  (MvPolynomial.monomial (x.mapRange (· / p) (Nat.zero_div p))
                    ((frobeniusEquiv k p).symm (H.coeff x))))) =
            ∑ x ∈ H.support, MvPolynomial.monomial x (H.coeff x) := by
          apply Finset.sum_congr rfl
          intro m hm
          rw [MvPolynomial.expand_monomial, MvPolynomial.map_monomial]
          have hm_coeff : (frobenius k p) ((frobeniusEquiv k p).symm (H.coeff m)) = H.coeff m := by
            rw [← frobeniusEquiv_apply k p]
            exact (frobeniusEquiv k p).apply_symm_apply (H.coeff m)
          rw [hm_coeff]
          apply congrArg (fun s => MvPolynomial.monomial s (H.coeff m))
          ext i
          simp [Nat.mul_div_cancel' (hdvd m hm i)]
        rw [h_sum, ← MvPolynomial.as_sum H]
      have hp_ge2 : 2 ≤ p := hp_prime.two_le
      have hp_split : p = 1 + (p - 1) := by omega
      have hH_prod : H = G * G ^ (p - 1) := by
        rw [← hGp]
        conv_lhs => rw [hp_split]
        rw [pow_add, pow_one]
      have hG_unit : IsUnit G := by
        rcases hH_irr.isUnit_or_isUnit hH_prod with hG | hGpow
        · exact hG
        · exact (isUnit_pow_iff (by omega : p - 1 ≠ 0)).mp hGpow
      have hH_unit : IsUnit H := by
        rw [← hGp]
        exact hG_unit.pow p
      exact hH_irr.not_isUnit hH_unit
  refine ⟨hConj1, fun h_pd0 => ?_⟩
  intro F₁ κ₁ φ_k_κ₁ x₁
  let sw : Fin 2 ≃ Fin 2 := Equiv.swap 0 1
  let e_sw : MvPolynomial (Fin 2) k ≃ₐ[k] MvPolynomial (Fin 2) k := MvPolynomial.renameEquiv k sw
  let e_biv : Polynomial (Polynomial k) ≃ₐ[k] MvPolynomial (Fin 2) k :=
    Polynomial.Bivariate.equivMvPolynomial k
  let e_poly : MvPolynomial (Fin 2) k ≃ₐ[k] Polynomial (Polynomial k) := e_sw.trans e_biv.symm
  have he_X0 : e_poly (MvPolynomial.X 0) = Polynomial.X := by
    change e_biv.symm (e_sw (MvPolynomial.X 0)) = Polynomial.X
    have h1 : e_sw (MvPolynomial.X 0) = MvPolynomial.X 1 := by
      simp [e_sw, sw]
    rw [h1, ← Polynomial.Bivariate.equivMvPolynomial_X (R := k)]
    exact e_biv.symm_apply_apply Polynomial.X
  have he_X1 : e_poly (MvPolynomial.X 1) = Polynomial.C Polynomial.X := by
    change e_biv.symm (e_sw (MvPolynomial.X 1)) = Polynomial.C Polynomial.X
    have h1 : e_sw (MvPolynomial.X 1) = MvPolynomial.X 0 := by
      simp [e_sw, sw]
    rw [h1, ← Polynomial.Bivariate.equivMvPolynomial_C_X (R := k)]
    exact e_biv.symm_apply_apply (Polynomial.C Polynomial.X)
  have he_aeval : ∀ g : Polynomial k,
      e_poly (Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) g) = Polynomial.C g := by
    let f₁ : Polynomial k →+* Polynomial (Polynomial k) :=
      e_poly.toRingHom.comp (Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin 2) k)).toRingHom
    let f₂ : Polynomial k →+* Polynomial (Polynomial k) := Polynomial.C
    have hf_eq : f₁ = f₂ := by
      apply Polynomial.ringHom_ext'
      · apply RingHom.ext
        intro c
        change e_poly (Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin 2) k)
          (Polynomial.C c)) = Polynomial.C (Polynomial.C c)
        rw [Polynomial.aeval_C, e_poly.commutes c,
          IsScalarTower.algebraMap_apply k (Polynomial k) (Polynomial (Polynomial k)),
          Polynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      · change e_poly (Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) Polynomial.X) =
          Polynomial.C Polynomial.X
        rw [Polynomial.aeval_X, he_X1]
    intro g
    exact RingHom.congr_fun hf_eq g
  have he_deriv : ∀ F : MvPolynomial (Fin 2) k,
      Polynomial.derivative (e_poly F) = e_poly (MvPolynomial.pderiv 0 F) := by
    intro F
    apply e_biv.injective
    have h1 : e_biv (Polynomial.derivative (e_poly F)) = MvPolynomial.pderiv 1 (e_biv (e_poly F)) := by
      simpa [e_biv] using (Polynomial.Bivariate.pderiv_one_equivMvPolynomial (R := k) (e_poly F)).symm
    rw [h1]
    have h2 : e_biv (e_poly F) = e_sw F := e_biv.apply_symm_apply (e_sw F)
    have h3 : e_biv (e_poly (MvPolynomial.pderiv 0 F)) = e_sw (MvPolynomial.pderiv 0 F) :=
      e_biv.apply_symm_apply (e_sw (MvPolynomial.pderiv 0 F))
    rw [h2, h3]
    have hsw0 : (1 : Fin 2) = sw 0 := by decide
    rw [hsw0]
    dsimp [e_sw]
    rw [MvPolynomial.renameEquiv_apply, MvPolynomial.renameEquiv_apply]
    exact MvPolynomial.pderiv_rename sw.injective 0 F
  let P : Polynomial (Polynomial k) := e_poly H
  have hP_irr : Irreducible P :=
    (MulEquiv.irreducible_iff e_poly.toRingEquiv.toMulEquiv).mpr hH_irr
  have hP_deriv : Polynomial.derivative P ≠ 0 := by
    intro h0
    rw [he_deriv H] at h0
    exact h_pd0 (e_poly.injective (h0.trans (map_zero e_poly).symm))
  have hdeg_pos : 1 ≤ P.natDegree := by
    by_contra hlt
    have h0 : P.natDegree = 0 := by omega
    rcases Polynomial.natDegree_eq_zero.mp h0 with ⟨a, ha⟩
    apply hP_deriv
    rw [← ha, Polynomial.derivative_C]
  have h_not_dvd_C : ∀ g : Polynomial k, g ≠ 0 → ¬ (P ∣ Polynomial.C g) := by
    intro g hg hdvd
    have hCg_ne : (Polynomial.C g : Polynomial (Polynomial k)) ≠ 0 := Polynomial.C_ne_zero.mpr hg
    have hle := Polynomial.natDegree_le_of_dvd hdvd hCg_ne
    rw [Polynomial.natDegree_C] at hle
    omega
  have hP_prim : P.IsPrimitive := by
    rw [Polynomial.isPrimitive_iff_isUnit_of_C_dvd]
    intro r hr
    rcases hr with ⟨Q₁, hQ₁⟩
    rcases hP_irr.isUnit_or_isUnit hQ₁ with hCr | hQ₁_unit
    · exact Polynomial.isUnit_C.mp hCr
    · exfalso
      have hQ₁_deg : Q₁.natDegree = 0 := Polynomial.natDegree_eq_zero_of_isUnit hQ₁_unit
      have hle : P.natDegree ≤ (Polynomial.C r).natDegree + Q₁.natDegree := by
        rw [hQ₁]
        exact Polynomial.natDegree_mul_le
      rw [Polynomial.natDegree_C, hQ₁_deg] at hle
      omega
  let ι_AF : Polynomial k →+* F₁ := algebraMap (Polynomial k) F₁
  let ι_Fκ : F₁ →+* κ₁ := algebraMap F₁ κ₁
  let φ_coeff : Polynomial k →+* κ₁ := ι_Fκ.comp ι_AF
  have hAF_inj : Function.Injective ι_AF := IsFractionRing.injective (Polynomial k) F₁
  have hFκ_inj : Function.Injective ι_Fκ := RingHom.injective ι_Fκ
  have hφ_inj : Function.Injective φ_coeff := hFκ_inj.comp hAF_inj
  let P_tilde : Polynomial F₁ := P.map ι_AF
  have hPt_irr : Irreducible P_tilde :=
    (Polynomial.IsPrimitive.irreducible_iff_irreducible_map_fraction_map hP_prim).mp hP_irr
  have hPt_deriv : Polynomial.derivative P_tilde ≠ 0 := by
    rw [Polynomial.derivative_map]
    intro h0
    apply hP_deriv
    exact Polynomial.map_injective ι_AF hAF_inj (by simpa using h0)
  have hPt_sep : P_tilde.Separable :=
    (Polynomial.separable_iff_derivative_ne_zero hPt_irr).mpr hPt_deriv
  have hPt_deg : P_tilde.degree ≠ 0 := ne_of_gt (Irreducible.degree_pos hPt_irr)
  obtain ⟨α₀, hα₀_root⟩ := IsAlgClosed.exists_aeval_eq_zero κ₁ P_tilde hPt_deg
  have hα₀_deriv : Polynomial.aeval α₀ (Polynomial.derivative P_tilde) ≠ 0 :=
    Polynomial.Separable.aeval_derivative_ne_zero hPt_sep hα₀_root
  let τ : Polynomial (Polynomial k) →+* Polynomial κ₁ :=
    (Polynomial.compRingHom (Polynomial.X + Polynomial.C α₀)).comp (Polynomial.mapRingHom φ_coeff)
  have hτ_apply : ∀ Q : Polynomial (Polynomial k),
      τ Q = (Q.map φ_coeff).comp (Polynomial.X + Polynomial.C α₀) := fun _ => rfl
  have h_eval0 : ∀ Q : Polynomial (Polynomial k),
      (τ Q).eval 0 = Polynomial.aeval α₀ (Q.map ι_AF) := by
    intro Q
    rw [hτ_apply, Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X,
      Polynomial.eval_C, zero_add]
    have hmap : Q.map φ_coeff = (Q.map ι_AF).map ι_Fκ := by
      dsimp [φ_coeff]
      rw [Polynomial.map_map]
    rw [hmap, Polynomial.eval_map, ← Polynomial.aeval_def]
  have h_X_dvd : ∀ R_κ : Polynomial κ₁, Polynomial.X ∣ R_κ ↔ R_κ.eval 0 = 0 := by
    intro R_κ
    have hX : (Polynomial.X : Polynomial κ₁) = Polynomial.X - Polynomial.C 0 := by simp
    rw [hX, Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def]
  have hτ_inj : Function.Injective τ := by
    rw [injective_iff_map_eq_zero]
    intro Q hQ0
    rw [hτ_apply] at hQ0
    have hcomp := congrArg (fun R_κ : Polynomial κ₁ => R_κ.comp (Polynomial.X - Polynomial.C α₀)) hQ0
    simp only [Polynomial.zero_comp, Polynomial.comp_assoc, Polynomial.add_comp,
      Polynomial.X_comp, Polynomial.C_comp] at hcomp
    exact Polynomial.map_injective φ_coeff hφ_inj (by simpa using hcomp)
  have hτ_deriv : (Polynomial.derivative (τ P)).eval 0 ≠ 0 := by
    have hderiv_eq : Polynomial.derivative (τ P) = τ (Polynomial.derivative P) := by
      rw [hτ_apply, hτ_apply]
      simp only [Polynomial.derivative_comp, Polynomial.derivative_X_add_C,
        one_mul, Polynomial.derivative_map]
    rw [hderiv_eq, h_eval0, ← Polynomial.derivative_map]
    exact hα₀_deriv
  have hτ_dvd_iff : ∀ Q : Polynomial (Polynomial k), Polynomial.X ∣ τ Q ↔ P ∣ Q := by
    intro Q
    constructor
    · intro hXdvd
      have hq_root : Polynomial.aeval α₀ (Q.map ι_AF) = 0 := by
        rw [← h_eval0]
        exact (h_X_dvd (τ Q)).mp hXdvd
      have h_dvd_F : P_tilde ∣ Q.map ι_AF := by
        by_contra h_ndvd
        have hcop : IsCoprime P_tilde (Q.map ι_AF) :=
          (Irreducible.coprime_iff_not_dvd hPt_irr).mpr h_ndvd
        rcases hcop with ⟨u, v, huv⟩
        have hev := congrArg (Polynomial.aeval α₀) huv
        simp only [map_add, map_mul, hα₀_root, hq_root, mul_zero, add_zero, map_one] at hev
        exact zero_ne_one hev
      exact Polynomial.IsPrimitive.dvd_of_fraction_map_dvd_fraction_map hP_prim h_dvd_F
    · intro hPdvd
      have hτP_dvd : τ P ∣ τ Q := map_dvd τ hPdvd
      have hX_τP : Polynomial.X ∣ τ P := by
        rw [h_X_dvd, h_eval0]
        exact hα₀_root
      exact dvd_trans hX_τP hτP_dvd
  refine ⟨α₀, ?_⟩
  intro ι_slice
  have hι_hom : ι_slice = τ.comp e_poly.toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change (MvPolynomial.eval₂Hom (Polynomial.C.comp φ_k_κ₁)
        ![Polynomial.X + Polynomial.C α₀, Polynomial.C x₁]) (MvPolynomial.C c) =
        τ (e_poly (MvPolynomial.C c))
      rw [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      have heC : e_poly (MvPolynomial.C c) = Polynomial.C (Polynomial.C c) := by
        rw [← MvPolynomial.algebraMap_eq, e_poly.commutes c,
          IsScalarTower.algebraMap_apply k (Polynomial k) (Polynomial (Polynomial k)),
          Polynomial.algebraMap_eq, Polynomial.algebraMap_eq]
      rw [heC, hτ_apply, Polynomial.map_C, Polynomial.C_comp]
      rfl
    · intro i
      change (MvPolynomial.eval₂Hom (Polynomial.C.comp φ_k_κ₁)
        ![Polynomial.X + Polynomial.C α₀, Polynomial.C x₁]) (MvPolynomial.X i) =
        τ (e_poly (MvPolynomial.X i))
      rw [MvPolynomial.eval₂Hom_X']
      fin_cases i
      · simp only [Fin.zero_eta, Matrix.cons_val_zero]
        rw [he_X0, hτ_apply, Polynomial.map_X, Polynomial.X_comp]
      · simp only [Fin.mk_one, Matrix.cons_val_one]
        rw [he_X1, hτ_apply, Polynomial.map_C, Polynomial.C_comp]
        rfl
  have hι_eq : ∀ F : MvPolynomial (Fin 2) k, ι_slice F = τ (e_poly F) :=
    fun F => RingHom.congr_fun hι_hom F
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have hfn : (ι_slice : MvPolynomial (Fin 2) k → Polynomial κ₁) = τ ∘ e_poly :=
      funext hι_eq
    rw [hfn]
    exact hτ_inj.comp e_poly.injective
  · apply RingHom.ext
    intro c
    exact MvPolynomial.eval₂Hom_C _ _ c
  · ext F
    simp only [Ideal.mem_comap, Ideal.mem_span_singleton, hι_eq F, hτ_dvd_iff (e_poly F)]
    constructor
    · intro hdvd
      have h1 := map_dvd e_poly.symm hdvd
      simpa [P] using h1
    · intro hdvd
      exact map_dvd e_poly hdvd
  · rw [hι_eq H]
    exact hτ_deriv
  · intro g hg hmem
    rw [Ideal.mem_span_singleton] at hmem
    have hdvd : P ∣ Polynomial.C g := by
      rw [← he_aeval g]
      exact map_dvd e_poly hmem
    exact h_not_dvd_C g hg hdvd

theorem weil_dvr_slice_transcendental_const_field_galois_disjointness (Ω : Type u) [Field Ω]
    (F₁ F_β K₀ E_L : Subfield Ω) (u₀ : Ω)
    (hF_le : F₁ ≤ F_β)
    (hK₀_eq : K₀ = F₁ ⊔ Subfield.closure {u₀})
    (hK₀_le_E : K₀ ≤ E_L)
    (hu₀_tr : Function.Injective (Polynomial.eval₂RingHom F_β.subtype u₀)) :
    letI algF : Algebra ↥F₁ ↥F_β := (Subfield.inclusion hF_le).toAlgebra
    letI algKE : Algebra ↥K₀ ↥E_L := (Subfield.inclusion hK₀_le_E).toAlgebra
    let E_β : Subfield Ω := E_L ⊔ F_β
    letI algEEβ : Algebra ↥E_L ↥E_β := (Subfield.inclusion le_sup_left).toAlgebra
    FiniteDimensional ↥F₁ ↥F_β →
    IsGalois ↥F₁ ↥F_β →
    FiniteDimensional ↥K₀ ↥E_L →
    IsGalois ↥K₀ ↥E_L →
    (E_L ⊓ (F_β ⊔ Subfield.closure {u₀}) = (E_L ⊓ F_β) ⊔ Subfield.closure {u₀}) ∧
    FiniteDimensional ↥E_L ↥E_β ∧
    Algebra.IsSeparable ↥E_L ↥E_β ∧
    ∃ (n : ℕ) (e e_dual : Fin n → Ω),
      (∀ i : Fin n, e i ∈ F_β ∧ e_dual i ∈ F_β) ∧
      ∀ w : ↥E_β, ∃ c : Fin n → ↥E_L,
        (w : Ω) = ∑ i : Fin n, (c i : Ω) * e i ∧
        ∀ i : Fin n, ∀ h_ed : e_dual i ∈ E_β,
          c i = Algebra.trace ↥E_L ↥E_β (w * ⟨e_dual i, h_ed⟩) :=
by
  intro E_β hFinF hGalF _hFinKE _hGalKE
  let : Algebra ↥F₁ ↥F_β := (Subfield.inclusion hF_le).toAlgebra
  let : Algebra ↥E_L ↥E_β := (Subfield.inclusion le_sup_left).toAlgebra
  let _ := hu₀_tr
  let _ := hK₀_le_E

  
  have hFinEquiv : ∀ {R₀ S₀ R₁ S₁ : Type u} [Field R₀] [Field S₀] [Algebra R₀ S₀]
      [Field R₁] [Field S₁] [Algebra R₁ S₁] [FiniteDimensional R₀ S₀]
      (i : R₀ ≃+* R₁) (j : S₀ ≃+* S₁),
      (algebraMap R₁ S₁).comp i.toRingHom = j.toRingHom.comp (algebraMap R₀ S₀) →
      FiniteDimensional R₁ S₁ := by
    intro R₀ S₀ R₁ S₁ _ _ _ _ _ _ hFin₀ i j hcomm
    have : Module.Finite R₀ S₀ := hFin₀
    let b₀ := Module.finBasis R₀ S₀
    let f : Fin (Module.finrank R₀ S₀) → S₁ := fun k => j (b₀ k)
    have htop : (⊤ : Submodule R₁ S₁) ≤ Submodule.span R₁ (Set.range f) := by
      intro y _
      have hy0 : ∑ k, (b₀.repr (j.symm y) k) • b₀ k = j.symm y := b₀.sum_repr (j.symm y)
      have hy1 : y = ∑ k, j ((b₀.repr (j.symm y) k) • b₀ k) := by
        calc
          y = j (j.symm y) := (j.apply_symm_apply y).symm
          _ = j (∑ k, (b₀.repr (j.symm y) k) • b₀ k) := by rw [hy0]
          _ = ∑ k, j ((b₀.repr (j.symm y) k) • b₀ k) := map_sum j _ _
      rw [hy1]
      refine Submodule.sum_mem _ (fun k _ => ?_)
      have hsmul : j ((b₀.repr (j.symm y) k) • b₀ k) = (i (b₀.repr (j.symm y) k)) • f k := by
        rw [Algebra.smul_def, map_mul, Algebra.smul_def]
        have hc := RingHom.congr_fun hcomm (b₀.repr (j.symm y) k)
        exact congrArg (· * f k) hc.symm
      rw [hsmul]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩)
    have hspan_eq : Submodule.span R₁ (Set.range f) = ⊤ := top_unique htop
    have hFinSpan : FiniteDimensional R₁ ↥(Submodule.span R₁ (Set.range f)) :=
      FiniteDimensional.span_of_finite R₁ (Set.finite_range f)
    rw [hspan_eq] at hFinSpan
    exact @Module.Finite.equiv R₁ ↥(⊤ : Submodule R₁ S₁) S₁ _ _ _ _ _ hFinSpan Submodule.topEquiv

  
  have hSpanSubfield : ∀ (E_int M M_β : Subfield Ω)
      (hEF : E_int ≤ F_β) (hEM : E_int ≤ M) (hMMβ : M ≤ M_β) (hFMβ : F_β ≤ M_β),
      M ⊔ F_β = M_β →
      ∀ {ι : Type} [Fintype ι],
        letI : Algebra ↥E_int ↥F_β := (Subfield.inclusion hEF).toAlgebra
        letI : Algebra ↥M ↥M_β := (Subfield.inclusion hMMβ).toAlgebra
        ∀ (b : Module.Basis ι ↥E_int ↥F_β),
          ⊤ ≤ Submodule.span ↥M
            (Set.range (fun i : ι => Subfield.inclusion hFMβ (b i))) := by
    intro E_int M M_β hEF hEM hMMβ hFMβ hMβ_eq ι _
    let : Algebra ↥E_int ↥F_β := (Subfield.inclusion hEF).toAlgebra
    let : Algebra ↥M ↥M_β := (Subfield.inclusion hMMβ).toAlgebra
    intro b
    let ι_F : ↥F_β →+* ↥M_β := Subfield.inclusion hFMβ
    let ι_M : ↥M →+* ↥M_β := Subfield.inclusion hMMβ
    let ι_EM : ↥E_int →+* ↥M := Subfield.inclusion hEM
    let v : ι → ↥M_β := fun i => ι_F (b i)
    let S_M : Submodule ↥M ↥M_β := Submodule.span ↥M (Set.range v)
    have hF_mem : ∀ x : ↥F_β, ι_F x ∈ S_M := by
      intro x
      have hx : ∑ i : ι, (b.repr x i) • b i = x := b.sum_repr x
      have hx' : ι_F (∑ i : ι, (b.repr x i) • b i) =
          ∑ i : ι, (ι_EM (b.repr x i)) • v i := by
        rw [map_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        apply Subtype.ext
        rfl
      rw [hx] at hx'
      rw [hx']
      exact S_M.sum_mem (fun i _ => S_M.smul_mem _ (Submodule.subset_span ⟨i, rfl⟩))
    have hone_mem : (1 : ↥M_β) ∈ S_M := by
      rw [← map_one ι_F]
      exact hF_mem 1
    have hM_mem : ∀ m : ↥M, ι_M m ∈ S_M := by
      intro m
      have hm : ι_M m = m • (1 : ↥M_β) := by
        apply Subtype.ext
        exact (mul_one m.1).symm
      rw [hm]
      exact S_M.smul_mem m hone_mem
    have hmul_mem : ∀ {z₁ z₂ : ↥M_β}, z₁ ∈ S_M → z₂ ∈ S_M → z₁ * z₂ ∈ S_M := by
      intro z₁ z₂ hz₁ hz₂
      induction hz₁ using Submodule.span_induction with
      | mem x hx =>
        rcases hx with ⟨i, rfl⟩
        induction hz₂ using Submodule.span_induction with
        | mem y hy =>
          rcases hy with ⟨j, rfl⟩
          change ι_F (b i) * ι_F (b j) ∈ S_M
          rw [← map_mul]
          exact hF_mem (b i * b j)
        | zero =>
          rw [mul_zero]
          exact S_M.zero_mem
        | add y₁ y₂ _ _ ih₁ ih₂ =>
          rw [mul_add]
          exact S_M.add_mem ih₁ ih₂
        | smul c y _ ih =>
          rw [mul_smul_comm]
          exact S_M.smul_mem c ih
      | zero =>
        rw [zero_mul]
        exact S_M.zero_mem
      | add x₁ x₂ _ _ ih₁ ih₂ =>
        rw [add_mul]
        exact S_M.add_mem ih₁ ih₂
      | smul c x _ ih =>
        rw [smul_mul_assoc]
        exact S_M.smul_mem c ih
    have hinv_mem : ∀ {z : ↥M_β}, z ∈ S_M → z⁻¹ ∈ S_M := by
      intro z hz
      by_cases hz0 : z = 0
      · rw [hz0, inv_zero]
        exact S_M.zero_mem
      · have : Module.Finite ↥M ↥S_M :=
          FiniteDimensional.span_of_finite ↥M (Set.finite_range v)
        let L_z : ↥S_M →ₗ[↥M] ↥S_M :=
          { toFun := fun u => ⟨z * u.1, hmul_mem hz u.2⟩
            map_add' := fun u₁ u₂ => Subtype.ext (mul_add z u₁.1 u₂.1)
            map_smul' := fun c u => Subtype.ext (mul_smul_comm c z u.1) }
        have hInj : Function.Injective L_z := by
          intro u₁ u₂ heq
          exact Subtype.ext (mul_left_cancel₀ hz0 (congrArg Subtype.val heq))
        obtain ⟨u, hu⟩ := LinearMap.surjective_of_injective hInj ⟨1, hone_mem⟩
        have hzu : z * u.1 = 1 := congrArg Subtype.val hu
        have hinv_eq : z⁻¹ = u.1 :=
          mul_left_cancel₀ hz0 (by rw [mul_inv_cancel₀ hz0, hzu])
        rw [hinv_eq]
        exact u.2
    let S_sub : Subfield ↥M_β :=
      { carrier := S_M
        mul_mem' := fun h₁ h₂ => hmul_mem h₁ h₂
        one_mem' := hone_mem
        add_mem' := fun h₁ h₂ => S_M.add_mem h₁ h₂
        zero_mem' := S_M.zero_mem
        neg_mem' := fun h => S_M.neg_mem h
        inv_mem' := fun _ h => hinv_mem h }
    let S_Ω : Subfield Ω := S_sub.map M_β.subtype
    have hM_le : M ≤ S_Ω := fun a ha => ⟨ι_M ⟨a, ha⟩, hM_mem ⟨a, ha⟩, rfl⟩
    have hF_le_S : F_β ≤ S_Ω := fun a ha => ⟨ι_F ⟨a, ha⟩, hF_mem ⟨a, ha⟩, rfl⟩
    have hMβ_le : M_β ≤ S_Ω := hMβ_eq ▸ sup_le hM_le hF_le_S
    intro w _
    obtain ⟨u, hu_mem, hu_eq⟩ := hMβ_le w.2
    have huw : u = w := Subtype.ext hu_eq
    rwa [← huw]

  
  have hNatIrr : ∀ (M E_int M_β : Subfield Ω)
      (hFM : F₁ ≤ M) (hEF : E_int ≤ F_β) (hMMβ : M ≤ M_β),
      M ⊓ F_β = E_int →
      M ⊔ F_β = M_β →
      letI : Algebra ↥E_int ↥F_β := (Subfield.inclusion hEF).toAlgebra
      letI : Algebra ↥M ↥M_β := (Subfield.inclusion hMMβ).toAlgebra
      FiniteDimensional ↥E_int ↥F_β ∧
      Algebra.IsSeparable ↥E_int ↥F_β ∧
      FiniteDimensional ↥M ↥M_β ∧
      Algebra.IsSeparable ↥M ↥M_β ∧
      Module.finrank ↥M ↥M_β = Module.finrank ↥E_int ↥F_β := by
    intro M E_int M_β hFM hEF hMMβ hInf hSup
    let : Algebra ↥E_int ↥F_β := (Subfield.inclusion hEF).toAlgebra
    let : Algebra ↥M ↥M_β := (Subfield.inclusion hMMβ).toAlgebra
    have hEM : E_int ≤ M := hInf ▸ inf_le_left
    have hFMβ : F_β ≤ M_β := hSup ▸ le_sup_right
    have hFinGal_EintF : FiniteDimensional ↥E_int ↥F_β ∧ IsGalois ↥E_int ↥F_β := by
      have hF_Eint : F₁ ≤ E_int := hInf ▸ le_inf hFM hF_le
      let : Algebra ↥F₁ ↥E_int := (Subfield.inclusion hF_Eint).toAlgebra
      have : IsScalarTower ↥F₁ ↥E_int ↥F_β := IsScalarTower.of_algebraMap_eq' rfl
      exact ⟨@Module.Finite.right ↥F₁ ↥E_int ↥F_β _ _ _ _ _ _ _ hFinF,
        @IsGalois.tower_top_of_isGalois ↥F₁ ↥E_int ↥F_β _ _ _ _ _ _ _ hGalF⟩
    have hFin_EintF : Module.Finite ↥E_int ↥F_β := hFinGal_EintF.1
    have : IsGalois ↥E_int ↥F_β := hFinGal_EintF.2
    have hSep_EintF : Algebra.IsSeparable ↥E_int ↥F_β := IsGalois.to_isSeparable

    set n := Module.finrank ↥E_int ↥F_β
    let b : Module.Basis (Fin n) ↥E_int ↥F_β := Module.finBasis ↥E_int ↥F_β
    let v : Fin n → ↥M_β := fun i => Subfield.inclusion hFMβ (b i)
    have htop_span : ⊤ ≤ Submodule.span ↥M (Set.range v) :=
      hSpanSubfield E_int M M_β hEF hEM hMMβ hFMβ hSup b
    have hspan_eq_top : Submodule.span ↥M (Set.range v) = ⊤ := top_unique htop_span
    have hFin_MMβ : Module.Finite ↥M ↥M_β := by
      have hFinSpan : Module.Finite ↥M ↥(Submodule.span ↥M (Set.range v)) :=
        FiniteDimensional.span_of_finite ↥M (Set.finite_range v)
      rw [hspan_eq_top] at hFinSpan
      exact @Module.Finite.equiv ↥M ↥(⊤ : Submodule ↥M ↥M_β) ↥M_β _ _ _ _ _ hFinSpan
        Submodule.topEquiv
    have hdim_le : Module.finrank ↥M ↥M_β ≤ n := by
      classical
      have h1 : Module.finrank ↥M ↥(Submodule.span ↥M (Set.range v)) ≤
          (Set.range v).toFinset.card := finrank_span_le_card (R := ↥M) (Set.range v)
      have h2 : Module.finrank ↥M ↥M_β = Module.finrank ↥M ↥(Submodule.span ↥M (Set.range v)) := by
        rw [hspan_eq_top]
        exact (LinearEquiv.finrank_eq (Submodule.topEquiv (R := ↥M) (M := ↥M_β))).symm
      have h3 : (Set.range v).toFinset.card ≤ n := by
        rw [Set.toFinset_range]
        exact (Finset.card_image_le).trans (by simp [n])
      exact (h2 ▸ h1).trans h3

    
    let : Algebra ↥E_int ↥M_β := (Subfield.inclusion (hEM.trans hMMβ)).toAlgebra
    let K_int : IntermediateField ↥E_int ↥M_β :=
      (F_β.comap M_β.subtype).toIntermediateField (fun x => hEF x.2)
    let L_int : IntermediateField ↥E_int ↥M_β :=
      (M.comap M_β.subtype).toIntermediateField (fun x => hEM x.2)
    have h_inf : K_int ⊓ L_int = ⊥ := by
      apply le_antisymm _ bot_le
      intro z hz
      have hzE : z.1 ∈ E_int := hInf ▸ ⟨hz.2, hz.1⟩
      exact IntermediateField.mem_bot.mpr ⟨⟨z.1, hzE⟩, Subtype.ext rfl⟩
    have h_sup : K_int ⊔ L_int = ⊤ := by
      apply top_unique
      let S_KL : Subfield Ω := (K_int ⊔ L_int).toSubfield.map M_β.subtype
      have hK_le : F_β ≤ S_KL := fun a ha =>
        ⟨⟨a, hFMβ ha⟩,
          (@le_sup_left (IntermediateField ↥E_int ↥M_β) _ K_int L_int) ha, rfl⟩
      have hL_le : M ≤ S_KL := fun a ha =>
        ⟨⟨a, hMMβ ha⟩,
          (@le_sup_right (IntermediateField ↥E_int ↥M_β) _ K_int L_int) ha, rfl⟩
      have hMβ_le : M_β ≤ S_KL := hSup ▸ sup_le hL_le hK_le
      intro z _
      obtain ⟨u, hu_mem, hu_eq⟩ := hMβ_le z.2
      have huz : u = z := Subtype.ext hu_eq
      rwa [← huz]
    let e_K : ↥F_β ≃ₐ[↥E_int] ↥K_int :=
      { toFun := fun x => ⟨⟨x.1, hFMβ x.2⟩, x.2⟩
        invFun := fun y => ⟨y.1.1, y.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext (Subtype.ext rfl)
        map_mul' := fun _ _ => Subtype.ext (Subtype.ext rfl)
        map_add' := fun _ _ => Subtype.ext (Subtype.ext rfl)
        commutes' := fun _ => Subtype.ext (Subtype.ext rfl) }
    have : Module.Finite ↥E_int ↥K_int := Module.Finite.equiv e_K.toLinearEquiv
    have : IsGalois ↥E_int ↥K_int := IsGalois.of_algEquiv e_K
    have : Normal ↥E_int ↥K_int := IsGalois.to_normal
    have hdim_K : Module.finrank ↥E_int ↥K_int = n :=
      (LinearEquiv.finrank_eq e_K.toLinearEquiv).symm

    let e_L : ↥M ≃+* ↥L_int :=
      { toFun := fun x => ⟨⟨x.1, hMMβ x.2⟩, x.2⟩
        invFun := fun y => ⟨y.1.1, y.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext (Subtype.ext rfl)
        map_mul' := fun _ _ => Subtype.ext (Subtype.ext rfl)
        map_add' := fun _ _ => Subtype.ext (Subtype.ext rfl) }
    have hcomm_L :
        (algebraMap ↥L_int ↥M_β).comp e_L.toRingHom =
          (RingEquiv.refl ↥M_β).toRingHom.comp (Subfield.inclusion hMMβ) :=
      RingHom.ext (fun _ => Subtype.ext rfl)
    have : Module.Finite ↥L_int ↥M_β :=
      hFinEquiv e_L (RingEquiv.refl ↥M_β) hcomm_L
    have hdim_L : Module.finrank ↥M ↥M_β = Module.finrank ↥L_int ↥M_β :=
      Algebra.finrank_eq_of_equiv_equiv e_L (RingEquiv.refl ↥M_β) hcomm_L

    have : IsGalois ↥L_int ↥M_β := IsGalois.sup_right K_int L_int h_sup
    have hSurj := IntermediateField.restrictRestrictAlgEquivMapHom_surjective K_int L_int h_inf
    have : Fintype (↥M_β ≃ₐ[↥L_int] ↥M_β) := by classical exact AlgEquiv.fintype ↥L_int ↥M_β
    have hcard_le : Nat.card (↥K_int ≃ₐ[↥E_int] ↥K_int) ≤ Nat.card (↥M_β ≃ₐ[↥L_int] ↥M_β) :=
      Nat.card_le_card_of_surjective _ hSurj
    rw [IsGalois.card_aut_eq_finrank ↥E_int ↥K_int,
      IsGalois.card_aut_eq_finrank ↥L_int ↥M_β, hdim_K, ← hdim_L] at hcard_le
    have hdim_eq : Module.finrank ↥M ↥M_β = n := le_antisymm hdim_le hcard_le

    have : Algebra.IsSeparable ↥L_int ↥M_β := @IsGalois.to_isSeparable ↥L_int _ ↥M_β _ _ _
    have hSep_MMβ : Algebra.IsSeparable ↥M ↥M_β := by
      classical
      rw [Algebra.isSeparable_def]
      intro z
      let q : Polynomial ↥L_int := minpoly ↥L_int z
      have hq_sep : q.Separable := Algebra.IsSeparable.isSeparable ↥L_int z
      let P : Polynomial ↥M := q.map e_L.symm.toRingHom
      have hP_sep : P.Separable := hq_sep.map
      have hcomp_symm : (Subfield.inclusion hMMβ).comp e_L.symm.toRingHom =
          algebraMap ↥L_int ↥M_β := RingHom.ext (fun _ => Subtype.ext rfl)
      have hP_eval : Polynomial.aeval z P = 0 := by
        change Polynomial.eval₂ (Subfield.inclusion hMMβ) z (q.map e_L.symm.toRingHom) = 0
        rw [Polynomial.eval₂_map, hcomp_symm]
        exact minpoly.aeval ↥L_int z
      exact hP_sep.of_dvd (minpoly.dvd ↥M z hP_eval)

    exact ⟨hFin_EintF, hSep_EintF, hFin_MMβ, hSep_MMβ, hdim_eq⟩

  
  have hModSqueeze : ∀ (M₁ M₂ K_β E_int : Subfield Ω),
      F₁ ≤ M₁ →
      M₁ ≤ M₂ →
      M₂ ≤ K_β →
      E_int ≤ F_β →
      M₁ ⊓ F_β = E_int →
      M₂ ⊓ F_β = E_int →
      M₁ ⊔ F_β = K_β →
      M₂ ⊔ F_β = K_β →
      M₂ = M₁ := by
    intro M₁ M₂ K_β E_int hF₁_M₁ h₁₂ h₂β hEF hM₁_inf hM₂_inf hM₁_sup hM₂_sup
    have h₁β : M₁ ≤ K_β := h₁₂.trans h₂β
    have hF₁_M₂ : F₁ ≤ M₂ := hF₁_M₁.trans h₁₂
    let : Algebra ↥E_int ↥F_β := (Subfield.inclusion hEF).toAlgebra
    let : Algebra ↥M₁ ↥K_β := (Subfield.inclusion h₁β).toAlgebra
    let : Algebra ↥M₂ ↥K_β := (Subfield.inclusion h₂β).toAlgebra
    let : Algebra ↥M₁ ↥M₂ := (Subfield.inclusion h₁₂).toAlgebra
    obtain ⟨_, _, hFin_M₁Kβ, _, hDim₁⟩ := hNatIrr M₁ E_int K_β hF₁_M₁ hEF h₁β hM₁_inf hM₁_sup
    obtain ⟨_, _, hFin_M₂Kβ, _, hDim₂⟩ := hNatIrr M₂ E_int K_β hF₁_M₂ hEF h₂β hM₂_inf hM₂_sup
    have : Module.Finite ↥M₁ ↥K_β := hFin_M₁Kβ
    have : Module.Finite ↥M₂ ↥K_β := hFin_M₂Kβ
    have : IsScalarTower ↥M₁ ↥M₂ ↥K_β :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext (fun _ => Subtype.ext rfl))
    have : Module.Finite ↥M₁ ↥M₂ := FiniteDimensional.left ↥M₁ ↥M₂ ↥K_β
    have hmul : Module.finrank ↥M₁ ↥M₂ * Module.finrank ↥M₂ ↥K_β =
        1 * Module.finrank ↥M₂ ↥K_β := by
      rw [Module.finrank_mul_finrank ↥M₁ ↥M₂ ↥K_β, one_mul, hDim₁, hDim₂]
    have hpos : 0 < Module.finrank ↥M₂ ↥K_β := Module.finrank_pos
    have hfin1 : Module.finrank ↥M₁ ↥M₂ = 1 := Nat.mul_right_cancel hpos hmul
    have hbot_top : (⊥ : IntermediateField ↥M₁ ↥M₂) = ⊤ :=
      IntermediateField.bot_eq_top_iff_finrank_eq_one.mpr hfin1
    refine le_antisymm ?_ h₁₂
    intro z hz
    have hz_bot : (⟨z, hz⟩ : ↥M₂) ∈ (⊥ : IntermediateField ↥M₁ ↥M₂) := by
      rw [hbot_top]
      trivial
    obtain ⟨y, hy⟩ := IntermediateField.mem_bot.mp hz_bot
    have hyz : y.1 = z := congrArg Subtype.val hy
    exact hyz ▸ y.2

  
  have hTraceDualBasis : ∀ (E_int E_β_op : Subfield Ω)
      (hEF : E_int ≤ F_β) (hEL : E_int ≤ E_L) (hEEβ : E_L ≤ E_β_op),
      E_L ⊔ F_β = E_β_op →
      letI : Algebra ↥E_int ↥F_β := (Subfield.inclusion hEF).toAlgebra
      letI : Algebra ↥E_L ↥E_β_op := (Subfield.inclusion hEEβ).toAlgebra
      FiniteDimensional ↥E_int ↥F_β →
      Algebra.IsSeparable ↥E_int ↥F_β →
      FiniteDimensional ↥E_L ↥E_β_op →
      Module.finrank ↥E_L ↥E_β_op = Module.finrank ↥E_int ↥F_β →
      ∃ (n : ℕ) (e e_dual : Fin n → Ω),
        (∀ i : Fin n, e i ∈ F_β ∧ e_dual i ∈ F_β) ∧
        ∀ w : ↥E_β_op, ∃ c : Fin n → ↥E_L,
          (w : Ω) = ∑ i : Fin n, (c i : Ω) * e i ∧
          ∀ i : Fin n, ∀ h_ed : e_dual i ∈ E_β_op,
            c i = Algebra.trace ↥E_L ↥E_β_op (w * ⟨e_dual i, h_ed⟩) := by
    intro E_int E_β_op hEF hEL hEEβ hSup hFin_EintF hSep_EintF hFin_EEβ hEqDim
    let : Algebra ↥E_int ↥F_β := (Subfield.inclusion hEF).toAlgebra
    let : Algebra ↥E_L ↥E_β_op := (Subfield.inclusion hEEβ).toAlgebra
    have : Module.Finite ↥E_int ↥F_β := hFin_EintF
    have : Algebra.IsSeparable ↥E_int ↥F_β := hSep_EintF
    have : Module.Finite ↥E_L ↥E_β_op := hFin_EEβ
    have hFEβ : F_β ≤ E_β_op := hSup ▸ le_sup_right
    set n := Module.finrank ↥E_int ↥F_β
    let b : Module.Basis (Fin n) ↥E_int ↥F_β := Module.finBasis ↥E_int ↥F_β
    let b_dual : Module.Basis (Fin n) ↥E_int ↥F_β := b.traceDual
    let e : Fin n → Ω := fun i => (b i : Ω)
    let e_dual : Fin n → Ω := fun i => (b_dual i : Ω)
    let ι_F : ↥F_β →+* ↥E_β_op := Subfield.inclusion hFEβ
    let ι_E : ↥E_int →+* ↥E_L := Subfield.inclusion hEL
    let v : Fin n → ↥E_β_op := fun i => ι_F (b i)

    have h_span : ⊤ ≤ Submodule.span ↥E_L (Set.range v) :=
      hSpanSubfield E_int E_L E_β_op hEF hEL hEEβ hFEβ hSup b
    have h_card : Fintype.card (Fin n) = Module.finrank ↥E_L ↥E_β_op := by
      rw [Fintype.card_fin, hEqDim]
    let b_E : Module.Basis (Fin n) ↥E_L ↥E_β_op := basisOfTopLeSpanOfCardEqFinrank v h_span h_card
    have hb_E_apply : ∀ i : Fin n, b_E i = ι_F (b i) :=
      congrFun (coe_basisOfTopLeSpanOfCardEqFinrank v h_span h_card)

    have hTraceCompat : ∀ x : ↥F_β,
        Algebra.trace ↥E_L ↥E_β_op (ι_F x) = ι_E (Algebra.trace ↥E_int ↥F_β x) := by
      intro x
      have hMat : ∀ i k : Fin n,
          Algebra.leftMulMatrix b_E (ι_F x) i k =
            ι_E (Algebra.leftMulMatrix b x i k) := by
        intro i k
        rw [Algebra.leftMulMatrix_eq_repr_mul, Algebra.leftMulMatrix_eq_repr_mul]
        have hxb : ∑ j : Fin n, (b.repr (x * b k) j) • b j = x * b k := b.sum_repr (x * b k)
        have hxb_E : ι_F x * b_E k = ∑ j : Fin n, (ι_E (b.repr (x * b k) j)) • b_E j := by
          rw [hb_E_apply k, ← map_mul]
          have hsum_F : ι_F (∑ j : Fin n, (b.repr (x * b k) j) • b j) =
              ∑ j : Fin n, (ι_E (b.repr (x * b k) j)) • b_E j := by
            rw [map_sum]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [hb_E_apply j]
            apply Subtype.ext
            rfl
          rwa [hxb] at hsum_F
        rw [hxb_E, map_sum, Finsupp.coe_finsetSum, Finset.sum_apply]
        have hterm : ∀ j : Fin n,
            (b_E.repr ((ι_E (b.repr (x * b k) j)) • b_E j)) i =
              if j = i then ι_E (b.repr (x * b k) j) else 0 := by
          intro j
          rw [map_smul, Finsupp.smul_apply, b_E.repr_self, smul_eq_mul, Finsupp.single_apply]
          split_ifs <;> simp
        rw [Finset.sum_congr rfl (fun j _ => hterm j), Finset.sum_ite_eq']
        simp only [Finset.mem_univ, ↓reduceIte]
      rw [Algebra.trace_eq_matrix_trace b_E (ι_F x), Algebra.trace_eq_matrix_trace b x]
      unfold Matrix.trace
      simp only [Matrix.diag_apply, map_sum]
      exact Finset.sum_congr rfl (fun i _ => hMat i i)

    refine ⟨n, e, e_dual, fun i => ⟨(b i).2, (b_dual i).2⟩, fun w => ?_⟩
    let c : Fin n → ↥E_L := fun j => b_E.repr w j
    refine ⟨c, ?_, ?_⟩
    · have hw : ∑ j : Fin n, c j • b_E j = w := b_E.sum_repr w
      have hw_Ω : (w : Ω) = E_β_op.subtype (∑ j : Fin n, c j • b_E j) := by
        rw [hw]
        rfl
      rw [hw_Ω, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      have hb_Ω : ((b_E j : ↥E_β_op) : Ω) = e j := by
        rw [hb_E_apply j]
        rfl
      change ((c j • b_E j : ↥E_β_op) : Ω) = (c j : Ω) * e j
      rw [← hb_Ω]
      rfl
    · intro i h_ed
      have hed_eq : (⟨e_dual i, h_ed⟩ : ↥E_β_op) = ι_F (b_dual i) := Subtype.ext rfl
      have hw : w = ∑ j : Fin n, c j • b_E j := (b_E.sum_repr w).symm
      have hw_mul : w * ⟨e_dual i, h_ed⟩ =
          ∑ j : Fin n, c j • ι_F (b j * b_dual i) := by
        rw [hed_eq, hw, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hb_E_apply j, smul_mul_assoc, ← map_mul]
      rw [hw_mul, map_sum]
      have hterm : ∀ j : Fin n,
          Algebra.trace ↥E_L ↥E_β_op (c j • ι_F (b j * b_dual i)) =
            if j = i then c j else 0 := by
        intro j
        rw [map_smul, smul_eq_mul, hTraceCompat (b j * b_dual i)]
        have horth : Algebra.trace ↥E_int ↥F_β (b j * b_dual i) = if j = i then 1 else 0 :=
          b.trace_mul_traceDual j i
        rw [horth]
        split_ifs <;> simp
      rw [Finset.sum_congr rfl (fun j _ => hterm j), Finset.sum_ite_eq']
      simp only [Finset.mem_univ, ↓reduceIte]

  
  have hF₁_K₀ : F₁ ≤ K₀ := hK₀_eq.symm ▸ le_sup_left
  have hF₁_E : F₁ ≤ E_L := hF₁_K₀.trans hK₀_le_E
  have hF₁_Eint : F₁ ≤ E_L ⊓ F_β := le_inf hF₁_E hF_le

  
  have hConj1 : E_L ⊓ (F_β ⊔ Subfield.closure {u₀}) = (E_L ⊓ F_β) ⊔ Subfield.closure {u₀} := by
    let K_β : Subfield Ω := K₀ ⊔ F_β
    let M₁ : Subfield Ω := K₀ ⊔ (E_L ⊓ F_β)
    let M₂ : Subfield Ω := E_L ⊓ K_β
    have hKβ_eq : K_β = F_β ⊔ Subfield.closure {u₀} := by
      dsimp [K_β]
      rw [hK₀_eq, sup_comm (F₁ ⊔ Subfield.closure {u₀}) F_β, ← sup_assoc,
        sup_eq_left.mpr hF_le]
    have hM₁_eq : M₁ = (E_L ⊓ F_β) ⊔ Subfield.closure {u₀} := by
      dsimp [M₁]
      rw [hK₀_eq, sup_comm (F₁ ⊔ Subfield.closure {u₀}) (E_L ⊓ F_β), ← sup_assoc,
        sup_eq_left.mpr hF₁_Eint]
    rw [← hKβ_eq, ← hM₁_eq]
    have h₁₂ : M₁ ≤ M₂ :=
      sup_le (le_inf hK₀_le_E le_sup_left) (le_inf inf_le_left (inf_le_right.trans le_sup_right))
    have h₂β : M₂ ≤ K_β := inf_le_right
    have hF₁_M₁ : F₁ ≤ M₁ := hF₁_K₀.trans le_sup_left
    have hM₁_sup : M₁ ⊔ F_β = K_β :=
      le_antisymm (sup_le (h₁₂.trans h₂β) le_sup_right)
        (sup_le (le_sup_left.trans le_sup_left) le_sup_right)
    have hM₂_sup : M₂ ⊔ F_β = K_β :=
      le_antisymm (sup_le h₂β le_sup_right)
        (sup_le ((le_inf hK₀_le_E le_sup_left).trans le_sup_left) le_sup_right)
    have hM₂_inf : M₂ ⊓ F_β = E_L ⊓ F_β :=
      le_antisymm (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
        (le_inf (le_inf inf_le_left (inf_le_right.trans le_sup_right)) inf_le_right)
    have hM₁_inf : M₁ ⊓ F_β = E_L ⊓ F_β :=
      le_antisymm ((inf_le_inf_right F_β h₁₂).trans hM₂_inf.le)
        (le_inf le_sup_right inf_le_right)
    exact hModSqueeze M₁ M₂ K_β (E_L ⊓ F_β) hF₁_M₁ h₁₂ h₂β inf_le_right
      hM₁_inf hM₂_inf hM₁_sup hM₂_sup

  
  obtain ⟨hFin_EintF, hSep_EintF, hFin_EEβ, hSep_EEβ, hEqDim⟩ :=
    hNatIrr E_L (E_L ⊓ F_β) E_β hF₁_E inf_le_right le_sup_left rfl rfl
  exact ⟨hConj1, hFin_EEβ, hSep_EEβ,
    hTraceDualBasis (E_L ⊓ F_β) E_β inf_le_right inf_le_left le_sup_left rfl
      hFin_EintF hSep_EintF hFin_EEβ hEqDim⟩

theorem weil_dvr_slice_compositum_inertia_dvr_stabilization (k : Type u) [Field k]
    (K₂ L₂ : Type u) [Field K₂] [Field L₂]
    [Algebra (MvPolynomial (Fin 2) k) K₂]
    [IsFractionRing (MvPolynomial (Fin 2) k) K₂]
    [Algebra K₂ L₂] [Algebra (MvPolynomial (Fin 2) k) L₂]
    [IsScalarTower (MvPolynomial (Fin 2) k) K₂ L₂]
    [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
    (H : MvPolynomial (Fin 2) k) (hH_irr : Irreducible H)
    (Q : Ideal ↥(integralClosure (MvPolynomial (Fin 2) k) L₂)) [Q.IsPrime]
    (hQ_comap : Ideal.comap
      (algebraMap (MvPolynomial (Fin 2) k) ↥(integralClosure (MvPolynomial (Fin 2) k) L₂)) Q =
      Ideal.span {H})
    (hX1_not_mem : ∀ g : Polynomial k, g ≠ 0 →
      Polynomial.aeval (MvPolynomial.X 1 : MvPolynomial (Fin 2) k) g ∉ Ideal.span {H})
    (hDisj :
      let F₁ := FractionRing (Polynomial k)
      let κ₁ := AlgebraicClosure F₁
      let P_κ₁ := Polynomial κ₁
      let Ω₁ := AlgebraicClosure (FractionRing P_κ₁)
      ∀ (F₁_s F_β K₀ E_L : Subfield Ω₁) (u₀ : Ω₁)
        (hF_le : F₁_s ≤ F_β)
        (hK₀_eq : K₀ = F₁_s ⊔ Subfield.closure {u₀})
        (hK₀_le_E : K₀ ≤ E_L)
        (hu₀_tr : Function.Injective (Polynomial.eval₂RingHom F_β.subtype u₀)),
        letI algF : Algebra ↥F₁_s ↥F_β := (Subfield.inclusion hF_le).toAlgebra
        letI algKE : Algebra ↥K₀ ↥E_L := (Subfield.inclusion hK₀_le_E).toAlgebra
        let E_β : Subfield Ω₁ := E_L ⊔ F_β
        letI algEEβ : Algebra ↥E_L ↥E_β := (Subfield.inclusion le_sup_left).toAlgebra
        FiniteDimensional ↥F₁_s ↥F_β →
        IsGalois ↥F₁_s ↥F_β →
        FiniteDimensional ↥K₀ ↥E_L →
        IsGalois ↥K₀ ↥E_L →
        (E_L ⊓ (F_β ⊔ Subfield.closure {u₀}) = (E_L ⊓ F_β) ⊔ Subfield.closure {u₀}) ∧
        FiniteDimensional ↥E_L ↥E_β ∧
        Algebra.IsSeparable ↥E_L ↥E_β ∧
        ∃ (n : ℕ) (e e_dual : Fin n → Ω₁),
          (∀ i : Fin n, e i ∈ F_β ∧ e_dual i ∈ F_β) ∧
          ∀ w : ↥E_β, ∃ c : Fin n → ↥E_L,
            (w : Ω₁) = ∑ i : Fin n, (c i : Ω₁) * e i ∧
            ∀ i : Fin n, ∀ h_ed : e_dual i ∈ E_β,
              c i = Algebra.trace ↥E_L ↥E_β (w * ⟨e_dual i, h_ed⟩)) :
    let R₂ := MvPolynomial (Fin 2) k
    let B₂ := integralClosure R₂ L₂
    let F₁ := FractionRing (Polynomial k)
    let κ₁ := AlgebraicClosure F₁
    let P_κ₁ := Polynomial κ₁
    let Ω₁ := AlgebraicClosure (FractionRing P_κ₁)
    let φ_k_κ₁ : k →+* κ₁ :=
      (algebraMap F₁ κ₁).comp ((algebraMap (Polynomial k) F₁).comp Polynomial.C)
    let x₁ : κ₁ := algebraMap F₁ κ₁ (algebraMap (Polynomial k) F₁ Polynomial.X)
    ∀ (α₀ : κ₁),
      let ι_slice : R₂ →+* P_κ₁ :=
        MvPolynomial.eval₂Hom (Polynomial.C.comp φ_k_κ₁)
          ![Polynomial.X + Polynomial.C α₀, Polynomial.C x₁]
      Function.Injective ι_slice →
      Ideal.comap ι_slice (Ideal.span {Polynomial.X}) = Ideal.span {H} →
      ∀ (V_0 : ValuationSubring Ω₁) (p_V : P_κ₁ →+* ↥V_0) (π_V0 : ↥V_0 →+* κ₁),
        V_0.subtype.comp p_V = algebraMap P_κ₁ Ω₁ →
        π_V0.comp p_V = Polynomial.evalRingHom 0 →
        RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 →
        ∃ (ψ_Ω : K₂ →+* Ω₁) (i_L : L₂ →+* Ω₁) (M : Subfield Ω₁),
          ψ_Ω.comp (algebraMap R₂ K₂) = (algebraMap P_κ₁ Ω₁).comp ι_slice ∧
          i_L.comp (algebraMap K₂ L₂) = ψ_Ω ∧
          Algebra.IsAlgebraic ↥M Ω₁ ∧
          (∀ f : P_κ₁, algebraMap P_κ₁ Ω₁ f ∈ M) ∧
          (∀ x : K₂, ψ_Ω x ∈ M) ∧
          (∀ z : L₂, i_L z ∈ M) ∧
          IsDedekindDomain ↥(V_0.comap M.subtype) ∧
          IsLocalRing.maximalIdeal ↥(V_0.comap M.subtype) ≠ ⊥ ∧
          ∀ (σ : L₂ ≃ₐ[K₂] L₂),
            (∀ y : ↥B₂, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q : Set ↥B₂)) →
            ∃ (σ_M : ↥M ≃+* ↥M),
              (∀ f : P_κ₁, ∀ hf : algebraMap P_κ₁ Ω₁ f ∈ M,
                (σ_M ⟨algebraMap P_κ₁ Ω₁ f, hf⟩ : Ω₁) = algebraMap P_κ₁ Ω₁ f) ∧
              (∀ x : K₂, ∀ hx : ψ_Ω x ∈ M, (σ_M ⟨ψ_Ω x, hx⟩ : Ω₁) = ψ_Ω x) ∧
              (∀ z : L₂, ∀ hz : i_L z ∈ M, (σ_M ⟨i_L z, hz⟩ : Ω₁) = i_L (σ z)) ∧
              (∀ w : ↥M, (w : Ω₁) ∈ V_0 ↔ (σ_M w : Ω₁) ∈ V_0) :=
by
  let helper_fieldRangeEquiv : ∀ {F Ω : Type u} [Field F] [Field Ω] (f : F →+* Ω),
      F ≃+* ↥f.fieldRange := fun {F Ω} _ _ f =>
    RingEquiv.ofBijective
      ({ toFun := fun x => ⟨f x, ⟨x, rfl⟩⟩
         map_one' := Subtype.ext (map_one f)
         map_mul' := fun x y => Subtype.ext (map_mul f x y)
         map_zero' := Subtype.ext (map_zero f)
         map_add' := fun x y => Subtype.ext (map_add f x y) } : F →+* ↥f.fieldRange)
      ⟨fun _ _ hxy => f.injective (congrArg Subtype.val hxy),
       fun ⟨_, ⟨x, hx⟩⟩ => ⟨x, Subtype.ext hx⟩⟩
  have helper_fieldRangeEquiv_apply : ∀ {F Ω : Type u} [Field F] [Field Ω] (f : F →+* Ω) (x : F),
      ((helper_fieldRangeEquiv f x : ↥f.fieldRange) : Ω) = f x := fun _ _ => rfl
  have mem_sup_left' : ∀ {Ω : Type u} [Field Ω] {A B : Subfield Ω} {x : Ω},
      x ∈ A → x ∈ A ⊔ B := fun {_} _ {A B _} hx => (@le_sup_left (Subfield _) _ A B) hx
  have mem_sup_right' : ∀ {Ω : Type u} [Field Ω] {A B : Subfield Ω} {x : Ω},
      x ∈ B → x ∈ A ⊔ B := fun {_} _ {A B _} hx => (@le_sup_right (Subfield _) _ A B) hx
  have helper_dvr_domination : ∀ (D F : Type u) [CommRing D] [IsDomain D]
      [IsDiscreteValuationRing D] [Field F] [Algebra D F] [IsFractionRing D F]
      (W : ValuationSubring F) (α : D →+* ↥W),
      W.subtype.comp α = algebraMap D F →
      (∀ d : D, IsUnit (α d) → IsUnit d) →
      Function.Bijective α := by
    intro D F _ _ _ _ _ _ W α hα_comp hα_unit
    refine ⟨?_, ?_⟩
    · intro d₁ d₂ h12
      have hF : (W.subtype.comp α) d₁ = (W.subtype.comp α) d₂ := by
        rw [RingHom.comp_apply, h12]; rfl
      rw [hα_comp] at hF
      exact IsFractionRing.injective D F hF
    · intro w
      obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors D) (w : F)
      dsimp only at hab
      have hb_ne : (b : D) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
      have hmap_b_ne : algebraMap D F b ≠ 0 := fun h0 =>
        hb_ne (IsFractionRing.injective D F (h0.trans (map_zero (algebraMap D F)).symm))
      obtain ⟨c, hcond⟩ := ValuationRing.cond a (b : D)
      rcases hcond with hac | hbc
      · by_cases ha0 : a = 0
        · exfalso
          rw [ha0, zero_mul] at hac
          exact hb_ne hac.symm
        · have hmap_a_ne : algebraMap D F a ≠ 0 := fun h0 =>
            ha0 (IsFractionRing.injective D F (h0.trans (map_zero (algebraMap D F)).symm))
          have hw_c : (w : F) * (α c : F) = 1 := by
            have hαc : (α c : F) = algebraMap D F c := RingHom.congr_fun hα_comp c
            rw [hαc]
            apply mul_left_cancel₀ hmap_a_ne
            calc
              algebraMap D F a * ((w : F) * algebraMap D F c)
                  = (w : F) * algebraMap D F (a * c) := by rw [map_mul]; ring
              _ = (w : F) * algebraMap D F b := by rw [hac]
              _ = algebraMap D F a * 1 := by rw [hab, mul_one]
          have hw_c_W : w * α c = 1 := Subtype.ext hw_c
          have hαc_unit : IsUnit (α c) := ⟨⟨α c, w, by rw [mul_comm, hw_c_W], hw_c_W⟩, rfl⟩
          have hu_c : IsUnit c := hα_unit c hαc_unit
          obtain ⟨u, rfl⟩ := hu_c
          refine ⟨↑(u⁻¹), Subtype.ext ?_⟩
          have hαu : (α ↑(u⁻¹) : F) = algebraMap D F ↑(u⁻¹) := RingHom.congr_fun hα_comp ↑(u⁻¹)
          rw [hαu]
          apply mul_right_cancel₀ hmap_b_ne
          rw [hab, ← map_mul, ← hac, mul_comm a ↑u, ← mul_assoc, Units.inv_mul, one_mul]
      · refine ⟨c, Subtype.ext ?_⟩
        have hαc : (α c : F) = algebraMap D F c := RingHom.congr_fun hα_comp c
        rw [hαc]
        apply mul_right_cancel₀ hmap_b_ne
        rw [hab, ← map_mul, mul_comm, hbc]
  have helper_subfield_val_maxIdeal : ∀ {Ω : Type u} [Field Ω]
      (V_0 : ValuationSubring Ω) (E : Subfield Ω) (x : ↥(V_0.comap E.subtype)),
      x ∈ IsLocalRing.maximalIdeal ↥(V_0.comap E.subtype) ↔
        (⟨(x : Ω), x.2⟩ : ↥V_0) ∈ IsLocalRing.maximalIdeal ↥V_0 := by
    intro Ω _ V_0 E x
    rw [← not_iff_not, IsLocalRing.notMem_maximalIdeal, IsLocalRing.notMem_maximalIdeal]
    let j : ↥(V_0.comap E.subtype) →+* ↥V_0 :=
      { toFun := fun y => ⟨(y : Ω), y.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    refine ⟨fun hx => hx.map j, fun hx => ?_⟩
    obtain ⟨u, hu⟩ := hx
    have hx_val : ((u : ↥V_0) : Ω) = (x : Ω) := congrArg Subtype.val hu
    have hx_ne_Ω : (x : Ω) ≠ 0 := by
      rw [← hx_val]
      intro h0
      exact Units.ne_zero u (Subtype.ext h0)
    have hinv_V : (((x.1 : ↥E)⁻¹ : ↥E) : Ω) ∈ V_0 := by
      change (x : Ω)⁻¹ ∈ V_0
      have hmul : (x : Ω) * (((u⁻¹ : (↥V_0)ˣ) : ↥V_0) : Ω) = 1 := by
        rw [← hx_val]
        exact_mod_cast Units.mul_inv u
      have hinv_eq : (x : Ω)⁻¹ = (((u⁻¹ : (↥V_0)ˣ) : ↥V_0) : Ω) :=
        inv_eq_of_mul_eq_one_right hmul
      rw [hinv_eq]
      exact ((u⁻¹ : (↥V_0)ˣ) : ↥V_0).2
    let y : ↥(V_0.comap E.subtype) := ⟨(x.1 : ↥E)⁻¹, hinv_V⟩
    have hxy : x * y = 1 := Subtype.ext (Subtype.ext (mul_inv_cancel₀ hx_ne_Ω))
    exact ⟨⟨x, y, hxy, by rw [mul_comm, hxy]⟩, rfl⟩
  
  have step2_prime_aligned :
      let R₂ := MvPolynomial (Fin 2) k
      let B₂ := integralClosure R₂ L₂
      let F₁ := FractionRing (Polynomial k)
      let κ₁ := AlgebraicClosure F₁
      let P_κ₁ := Polynomial κ₁
      let Ω₁ := AlgebraicClosure (FractionRing P_κ₁)
      let φ_k_κ₁ : k →+* κ₁ :=
        (algebraMap F₁ κ₁).comp ((algebraMap (Polynomial k) F₁).comp Polynomial.C)
      let x₁ : κ₁ := algebraMap F₁ κ₁ (algebraMap (Polynomial k) F₁ Polynomial.X)
      let ι_κ₁ : κ₁ →+* Ω₁ := (algebraMap P_κ₁ Ω₁).comp Polynomial.C
      let F'₁ : Subfield Ω₁ := (ι_κ₁.comp (algebraMap F₁ κ₁)).fieldRange
      ∀ (α₀ : κ₁),
        let ι_slice : R₂ →+* P_κ₁ :=
          MvPolynomial.eval₂Hom (Polynomial.C.comp φ_k_κ₁)
            ![Polynomial.X + Polynomial.C α₀, Polynomial.C x₁]
        let u₀ : Ω₁ := algebraMap P_κ₁ Ω₁ (Polynomial.X + Polynomial.C α₀)
        Function.Injective ι_slice →
        Ideal.comap ι_slice (Ideal.span {Polynomial.X}) = Ideal.span {H} →
        ∀ (V_0 : ValuationSubring Ω₁) (p_V : P_κ₁ →+* ↥V_0) (π_V0 : ↥V_0 →+* κ₁),
          V_0.subtype.comp p_V = algebraMap P_κ₁ Ω₁ →
          π_V0.comp p_V = Polynomial.evalRingHom 0 →
          RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 →
          ∃ (ψ_Ω : K₂ →+* Ω₁) (i_L : L₂ →+* Ω₁)
            (A₀ : Type u) (_ : CommRing A₀) (_ : IsDomain A₀) (_ : IsDedekindDomain A₀)
            (φ_A_K₀ : A₀ →+* ↥ψ_Ω.fieldRange) (φ_A_L₂ : A₀ →+* L₂),
            ψ_Ω.comp (algebraMap R₂ K₂) = (algebraMap P_κ₁ Ω₁).comp ι_slice ∧
            i_L.comp (algebraMap K₂ L₂) = ψ_Ω ∧
            ψ_Ω.fieldRange = F'₁ ⊔ Subfield.closure {u₀} ∧
            @IsFractionRing A₀ _ ↥ψ_Ω.fieldRange _ φ_A_K₀.toAlgebra ∧
            (∀ a : A₀, i_L (φ_A_L₂ a) = (φ_A_K₀ a : Ω₁)) ∧
            (∀ a : A₀, (φ_A_K₀ a : Ω₁) ∈ V_0) ∧
            (∃ a₀ : A₀, a₀ ≠ 0 ∧ ∃ ha₀ : (φ_A_K₀ a₀ : Ω₁) ∈ V_0,
              (⟨(φ_A_K₀ a₀ : Ω₁), ha₀⟩ : ↥V_0) ∈ IsLocalRing.maximalIdeal ↥V_0) ∧
            (∀ c ∈ F'₁, ∃ a : A₀, (φ_A_K₀ a : Ω₁) = c) ∧
            ∀ (σ : L₂ ≃ₐ[K₂] L₂),
              (∀ y : ↥B₂, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q : Set ↥B₂)) →
              ∀ (z : L₂), @IsIntegral A₀ L₂ _ _ φ_A_L₂.toAlgebra z →
                ∃ (hz : i_L z ∈ V_0) (hσz : i_L (σ z) ∈ V_0),
                  (⟨i_L (σ z), hσz⟩ : ↥V_0) - ⟨i_L z, hz⟩ ∈ IsLocalRing.maximalIdeal ↥V_0 := by
    intro R₂ B₂ F₁ κ₁ P_κ₁ Ω₁ φ_k_κ₁ x₁ ι_κ₁ F'₁ α₀ ι_slice u₀ hι_inj hι_comap
      V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker
    have halgP_inj : Function.Injective (algebraMap P_κ₁ Ω₁) := by
      rw [IsScalarTower.algebraMap_eq P_κ₁ (FractionRing P_κ₁) Ω₁]
      exact (RingHom.injective (algebraMap (FractionRing P_κ₁) Ω₁)).comp
        (IsFractionRing.injective P_κ₁ (FractionRing P_κ₁))
    let θ_R₂ : R₂ →+* Ω₁ := (algebraMap P_κ₁ Ω₁).comp ι_slice
    have hθ_inj : Function.Injective θ_R₂ := halgP_inj.comp hι_inj
    have hθ_units : ∀ y : nonZeroDivisors R₂, IsUnit (θ_R₂ y) := by
      intro y
      refine IsUnit.mk0 (θ_R₂ y) (fun h0 => ?_)
      exact mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hθ_inj (h0.trans (map_zero θ_R₂).symm))
    let ψ_Ω : K₂ →+* Ω₁ := IsLocalization.lift (M := nonZeroDivisors R₂) hθ_units
    have hψ_comp : ψ_Ω.comp (algebraMap R₂ K₂) = θ_R₂ :=
      IsLocalization.lift_comp hθ_units
    have hK₀_eq : ψ_Ω.fieldRange = F'₁ ⊔ Subfield.closure {u₀} := by
      apply le_antisymm
      · have hR₂_mem : ∀ r : R₂, θ_R₂ r ∈ F'₁ ⊔ Subfield.closure {u₀} := by
          intro r
          induction r using MvPolynomial.induction_on with
          | C c =>
            have hc : θ_R₂ (MvPolynomial.C c) ∈ F'₁ := by
              refine ⟨algebraMap (Polynomial k) F₁ (Polynomial.C c), ?_⟩
              dsimp [θ_R₂, ι_slice, ι_κ₁, φ_k_κ₁]
              rw [MvPolynomial.eval₂Hom_C]
              rfl
            exact mem_sup_left' hc
          | add p q hp hq =>
            rw [map_add]
            exact add_mem hp hq
          | mul_X p i hp =>
            rw [map_mul]
            refine mul_mem hp ?_
            fin_cases i <;> dsimp
            · have h0 : θ_R₂ (MvPolynomial.X 0) = u₀ := by
                dsimp [θ_R₂, ι_slice, u₀]
                rw [MvPolynomial.eval₂Hom_X']
                rfl
              rw [h0]
              exact mem_sup_right' (Subfield.subset_closure (Set.mem_singleton u₀))
            · have h1 : θ_R₂ (MvPolynomial.X 1) ∈ F'₁ := by
                refine ⟨algebraMap (Polynomial k) F₁ Polynomial.X, ?_⟩
                dsimp [θ_R₂, ι_slice, ι_κ₁, x₁]
                rw [MvPolynomial.eval₂Hom_X']
                rfl
              exact mem_sup_left' h1
        rintro _ ⟨x, rfl⟩
        obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj (nonZeroDivisors R₂) x
        have hrs' : ψ_Ω x * θ_R₂ s = θ_R₂ r := by
          have h1 := congrArg ψ_Ω hrs
          rw [map_mul] at h1
          change ψ_Ω x * (ψ_Ω.comp (algebraMap R₂ K₂)) s = (ψ_Ω.comp (algebraMap R₂ K₂)) r at h1
          rwa [hψ_comp] at h1
        have hs_ne : θ_R₂ s ≠ 0 := (hθ_units s).ne_zero
        have hx_eq : ψ_Ω x = θ_R₂ r * (θ_R₂ s)⁻¹ := by
          rw [← hrs', mul_inv_cancel_right₀ hs_ne]
        rw [hx_eq]
        exact mul_mem (hR₂_mem r) (inv_mem (hR₂_mem s))
      · refine sup_le ?_ ?_
        · let η₁ : Polynomial k →+* R₂ := (Polynomial.aeval (MvPolynomial.X 1 : R₂)).toRingHom
          have hη₁_eq : θ_R₂.comp η₁ =
              (ι_κ₁.comp (algebraMap F₁ κ₁)).comp (algebraMap (Polynomial k) F₁) := by
            apply Polynomial.ringHom_ext'
            · ext c
              dsimp [θ_R₂, η₁, ι_slice, ι_κ₁, φ_k_κ₁]
              rw [Polynomial.aeval_C, MvPolynomial.algebraMap_eq, MvPolynomial.eval₂Hom_C]
              rfl
            · dsimp [θ_R₂, η₁, ι_slice, ι_κ₁, x₁]
              rw [Polynomial.aeval_X, MvPolynomial.eval₂Hom_X']
              rfl
          rintro _ ⟨y, rfl⟩
          obtain ⟨⟨g₁, g₂⟩, hg⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial k)) y
          let φ_F₁_Ω : F₁ →+* Ω₁ := ι_κ₁.comp (algebraMap F₁ κ₁)
          have hg' : φ_F₁_Ω y * θ_R₂ (η₁ g₂) = θ_R₂ (η₁ g₁) := by
            have h1 := congrArg φ_F₁_Ω hg
            rw [map_mul] at h1
            change φ_F₁_Ω y * (φ_F₁_Ω.comp (algebraMap (Polynomial k) F₁)) g₂ =
              (φ_F₁_Ω.comp (algebraMap (Polynomial k) F₁)) g₁ at h1
            rwa [← hη₁_eq] at h1
          have hg₂_ne : (g₂ : Polynomial k) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp g₂.2
          have hmap_g₂_ne : algebraMap (Polynomial k) F₁ g₂ ≠ 0 := fun h0 =>
            hg₂_ne (IsFractionRing.injective (Polynomial k) F₁
              (h0.trans (map_zero (algebraMap (Polynomial k) F₁)).symm))
          have hθg₂_ne : θ_R₂ (η₁ g₂) ≠ 0 := by
            change (θ_R₂.comp η₁) g₂ ≠ 0
            rw [hη₁_eq]
            intro h0
            exact hmap_g₂_ne (φ_F₁_Ω.injective (h0.trans (map_zero φ_F₁_Ω).symm))
          refine ⟨algebraMap R₂ K₂ (η₁ g₁) * (algebraMap R₂ K₂ (η₁ g₂))⁻¹, ?_⟩
          rw [map_mul, map_inv₀]
          change (ψ_Ω.comp (algebraMap R₂ K₂)) (η₁ g₁) *
            ((ψ_Ω.comp (algebraMap R₂ K₂)) (η₁ g₂))⁻¹ = φ_F₁_Ω y
          rw [hψ_comp, ← hg', mul_inv_cancel_right₀ hθg₂_ne]
