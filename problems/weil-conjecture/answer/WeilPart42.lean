  have hBase_align : η_Sigma ≫ P.ι_line.left = q_κ ≫ π_P2 := by
    rw [hη_Sig_eq, hq_κ_eq, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    exact hDP0_align κ χ_poly hχ_P₀_ne
  let Z_κ := CategoryTheory.Limits.pullback P.f₀.left η_Sigma
  have hPb_left : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst P.f₀.left η_Sigma ≫ P.ι_Ytilde.left)
      (CategoryTheory.Limits.pullback.snd P.f₀.left η_Sigma)
      P.g₂.left (η_Sigma ≫ P.ι_line.left) :=
    (CategoryTheory.IsPullback.of_hasPullback P.f₀.left η_Sigma).paste_horiz P.hPb_line
  have hPb_right0 : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst g₂_k.left q_κ ≫ π_Y₂)
      (CategoryTheory.Limits.pullback.snd g₂_k.left q_κ)
      P.g₂.left (q_κ ≫ π_P2) :=
    (CategoryTheory.IsPullback.of_hasPullback g₂_k.left q_κ).paste_horiz hPb_Y₂
  have hPb_right : CategoryTheory.IsPullback
      (CategoryTheory.Limits.pullback.fst g₂_k.left q_κ ≫ π_Y₂)
      (CategoryTheory.Limits.pullback.snd g₂_k.left q_κ)
      P.g₂.left (η_Sigma ≫ P.ι_line.left) := by
    rwa [hBase_align]
  let e_pb : Z_κ ≅ Y_0_κ :=
    hPb_left.isLimit.conePointUniqueUpToIso hPb_right.isLimit
  have he_fst : e_pb.hom ≫ (CategoryTheory.Limits.pullback.fst g₂_k.left q_κ ≫ π_Y₂) =
      CategoryTheory.Limits.pullback.fst P.f₀.left η_Sigma ≫ P.ι_Ytilde.left :=
    hPb_left.isLimit.conePointUniqueUpToIso_hom_comp
      hPb_right.isLimit CategoryTheory.Limits.WalkingCospan.left
  have he_snd : e_pb.hom ≫ CategoryTheory.Limits.pullback.snd g₂_k.left q_κ =
      CategoryTheory.Limits.pullback.snd P.f₀.left η_Sigma :=
    hPb_left.isLimit.conePointUniqueUpToIso_hom_comp
      hPb_right.isLimit CategoryTheory.Limits.WalkingCospan.right
  have he_aut : e_pb.hom ≫ α_τ_Y = α_τ ≫ e_pb.hom := by
    have hαY_fst : α_τ_Y ≫ CategoryTheory.Limits.pullback.fst g₂_k.left q_κ =
        CategoryTheory.Limits.pullback.fst g₂_k.left q_κ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hαY_snd : α_τ_Y ≫ CategoryTheory.Limits.pullback.snd g₂_k.left q_κ =
        CategoryTheory.Limits.pullback.snd g₂_k.left q_κ ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    apply hPb_right.hom_ext
    · rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc α_τ_Y, hαY_fst, he_fst,
