            (by rw [Category.assoc, hγ_η_tgt]; exact CategoryTheory.Limits.pullback.condition)
        let j_tot : Y_Ω_target ⟶ U_Y.toScheme := e_YΩ_tgt.hom ≫ j_Y_open
        have hcomm_jtot : α_γ ≫ j_tot = j_tot ≫ τ_UY.hom := by
          have hγ_jV : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ j_V =
              j_V ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom) := by
            dsimp only [j_V]
            rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
              ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
            exact congrArg (fun f => AlgebraicGeometry.Spec.map (CommRingCat.ofHom f))
              (RingHom.ext fun _ => rfl)
          have hτY_fst : τ_Y.hom ≫ CategoryTheory.Limits.pullback.fst f_line.left g_V_line =
              CategoryTheory.Limits.pullback.fst f_line.left g_V_line :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hτY_snd : τ_Y.hom ≫ CategoryTheory.Limits.pullback.snd f_line.left g_V_line =
              CategoryTheory.Limits.pullback.snd f_line.left g_V_line ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom) :=
