      have : ExpChar ↥F_sep q := RingHom.expChar F_sep.val.toRingHom F_sep.val.injective q
      have : IsPurelyInseparable ↥F_sep κ₁ := separableClosure.isPurelyInseparable F₁ κ₁
      have : IsGalois F₁ ↥F_sep := separableClosure.isGalois F₁ κ₁
      have hex : ∀ a : κ₁, ∃ m : ℕ, a ^ (q ^ m) ∈ (algebraMap ↥F_sep κ₁).range :=
        fun a => IsPurelyInseparable.pow_mem ↥F_sep q a
