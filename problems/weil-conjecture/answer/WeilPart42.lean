              CategoryTheory.Abelian.Ext.comp_add, ih, CategoryTheory.Abelian.Ext.comp_mk₀_id]
        intro w
        rw [← hExt_nsmul w m₀, hFM_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]

      let B₂_0 := @integralClosure R₂ L₂ _ _ algL_0
      have hPow1 : ∀ σ : L₂ ≃ₐ[K₂] L₂,
          (∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0)) →
          σ ^ m₀ = 1 := by
        intro σ hσ_inert
        obtain ⟨γ, hγ_Pκ₁, hγ_K₂, hγ_V0_iff, hγ_iL⟩ := hEx_γ σ hσ_inert
        let γ_V : ↥V_0 ≃+* ↥V_0 :=
          { toFun := fun v => ⟨γ v.1, (hγ_V0_iff v.1).mp v.2⟩
            invFun := fun v => ⟨γ.symm v.1, (hγ_V0_iff (γ.symm v.1)).mpr (by
              rw [γ.apply_symm_apply]; exact v.2)⟩
            left_inv := fun v => Subtype.ext (γ.symm_apply_apply v.1)
            right_inv := fun v => Subtype.ext (γ.apply_symm_apply v.1)
            map_mul' := fun a b => Subtype.ext (map_mul γ a.1 b.1)
            map_add' := fun a b => Subtype.ext (map_add γ a.1 b.1) }
        have hγV_pV : γ_V.toRingHom.comp p_V = p_V := by
          apply RingHom.ext; intro f
          apply V_0.subtype_injective
          change γ (V_0.subtype (p_V f)) = V_0.subtype (p_V f)
          have hp := RingHom.congr_fun hpV_sub f
          rw [RingHom.comp_apply] at hp
          rw [hp, hγ_Pκ₁ f]
        have hγV_symm_pV : γ_V.symm.toRingHom.comp p_V = p_V := by
          apply RingHom.ext; intro f
          apply γ_V.injective
          change γ_V (γ_V.symm (p_V f)) = (γ_V.toRingHom.comp p_V) f
          rw [γ_V.apply_symm_apply, hγV_pV]
        have hπ_γV : π_V0.comp γ_V.toRingHom = π_V0 := by
          apply RingHom.ext; intro v
          change π_V0 (γ_V v) = π_V0 v
          let c₀ := π_V0 v
          have hm_ker : v - p_V (Polynomial.C c₀) ∈ RingHom.ker π_V0 := by
            rw [RingHom.mem_ker, map_sub]
            have hc : π_V0 (p_V (Polynomial.C c₀)) = c₀ := by
              change (π_V0.comp p_V) (Polynomial.C c₀) = c₀
              rw [hπ_pV, Polynomial.coe_evalRingHom, Polynomial.eval_C]
            rw [hc, sub_self]
          have hm_max : v - p_V (Polynomial.C c₀) ∈ IsLocalRing.maximalIdeal ↥V_0 :=
            hπ_ker ▸ hm_ker
          have hγm_max : γ_V (v - p_V (Polynomial.C c₀)) ∈ IsLocalRing.maximalIdeal ↥V_0 := by
            rw [IsLocalRing.mem_maximalIdeal] at hm_max ⊢
            intro h_unit
            exact hm_max (by simpa using h_unit.map γ_V.symm.toRingHom)
          have hγm_ker : γ_V (v - p_V (Polynomial.C c₀)) ∈ RingHom.ker π_V0 :=
            hπ_ker.symm ▸ hγm_max
          have hγ_pC : γ_V (p_V (Polynomial.C c₀)) = p_V (Polynomial.C c₀) :=
            RingHom.congr_fun hγV_pV (Polynomial.C c₀)
          rw [map_sub, hγ_pC, RingHom.mem_ker, map_sub] at hγm_ker
          have hc : π_V0 (p_V (Polynomial.C c₀)) = c₀ := by
            change (π_V0.comp p_V) (Polynomial.C c₀) = c₀
            rw [hπ_pV, Polynomial.coe_evalRingHom, Polynomial.eval_C]
          rw [hc] at hγm_ker
          exact sub_eq_zero.mp hγm_ker
        have hγV_pC : γ_V.toRingHom.comp (p_V.comp Polynomial.C) = p_V.comp Polynomial.C := by
          rw [← RingHom.comp_assoc, hγV_pV]

        obtain ⟨hγ_hV, hLift_τW⟩ := hEquiv_W γ_V hγV_pV hπ_γV
        have hγ_symm_hV : γ_V.symm h_V = h_V := by
          calc γ_V.symm h_V = γ_V.symm (γ_V h_V) := by rw [hγ_hV]
