                    rw [Category.assoc, Category.assoc, ← φ.naturality (M_w'.map v.unop).op]
                    dsimp [L_pre]
                    rw [← Category.assoc (CategoryTheory.Limits.Sigma.ι _ _),
                      CategoryTheory.Limits.Sigma.ι_comp_desc]
                    simp only [← Category.assoc]
                    congr 1
                    rw [← P.map_comp, ← P.map_comp, ← Quiver.Hom.op_unop v, ← op_comp, ← op_comp]
                    have hπ : M_w'.map v.unop ≫ π_V V₁.unop = π_V V₂.unop :=
