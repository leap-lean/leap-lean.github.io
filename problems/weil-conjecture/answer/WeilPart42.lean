    have step2 : β_n (θ_n_inv w₁) =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g (β_n (θ_n_inv z₀)))
          (Nat.zero_add 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ ψ_G) (Nat.add_zero 2) :=
      (congrArg β_n step1).trans (hβ_equiv (θ_n_inv z₀))
    have step3 : EX₂ (β_n (θ_n_inv w₁)) =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g (EX₂ (β_n (θ_n_inv z₀))))
          (Nat.zero_add (n + 2))).comp
          (CategoryTheory.Abelian.Ext.mk₀ ψ₀_tilde) (Nat.add_zero (n + 2)) :=
      (congrArg EX₂ step2).trans (hEX₂_equiv (β_n (θ_n_inv z₀)))
    let u₂ := EX₂ (β_n (θ_n_inv z₀))
    have step4 : e_η_inv (EX₂ (β_n (θ_n_inv w₁))) =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g (e_η_inv u₂))
          (Nat.zero_add (n + 2))).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM_g) (Nat.add_zero (n + 2)) :=
      (congrArg e_η_inv step3).trans
        ((he_η_inv _).trans
          ((hPullH_mor ψ₀_tilde πM_g iso_η.symm.hom (n + 2) hη_inv_comm u₂).trans
            (congrArg (fun v =>
              ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
                (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g v)
                (Nat.zero_add (n + 2))).comp
                (CategoryTheory.Abelian.Ext.mk₀ πM_g) (Nat.add_zero (n + 2)))
              (he_η_inv u₂).symm)))
    exact step4.trans (hp_g_all (n + 2) p_g hp_g (e_η_inv u₂)).symm

theorem weil_dvr_slice_equivariant_roof_unipotent_specialization (κ : Type u) [Field κ] [IsAlgClosed κ]
    (N_deg ℓ r : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : κ) ≠ 0) (hN : 1 ≤ N_deg)
    (Z_R Q_R W_R : AlgebraicGeometry.Scheme.{u})
    (x_Z : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ Z_R)
    (hx_Z : AlgebraicGeometry.IsClosedImmersion x_Z)
    (U_Z : Z_R.Opens) (hU_Z : (U_Z : Set Z_R) = (Set.range x_Z.base)ᶜ)
    (x_Q : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ Q_R)
    (hx_Q : AlgebraicGeometry.IsClosedImmersion x_Q)
    (U_Q : Q_R.Opens) (hU_Q : (U_Q : Set Q_R) = (Set.range x_Q.base)ᶜ)
    (v_W : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ W_R)
    (e_W : W_R ⟶ Z_R) [AlgebraicGeometry.Etale e_W]
    (q_W : W_R ⟶ Q_R) [AlgebraicGeometry.Etale q_W]
    (hv_e : v_W ≫ e_W = x_Z)
    (hv_q : v_W ≫ q_W = x_Q)
    (hpre_e : e_W.base ⁻¹' (Set.range x_Z.base) = Set.range v_W.base)
    (hpre_q : q_W.base ⁻¹' (Set.range x_Q.base) = Set.range v_W.base)
    (τ_Z : Z_R ≅ Z_R) (τ_Q : Q_R ≅ Q_R) (τ_W : W_R ≅ W_R)
    (τ_UZ : U_Z.toScheme ≅ U_Z.toScheme) (τ_UQ : U_Q.toScheme ≅ U_Q.toScheme)
    (hτ_xZ : x_Z ≫ τ_Z.hom = x_Z)
    (hτ_xQ : x_Q ≫ τ_Q.hom = x_Q)
    (hτ_vW : v_W ≫ τ_W.hom = v_W)
    (hτ_UZ : τ_UZ.hom ≫ U_Z.ι = U_Z.ι ≫ τ_Z.hom)
    (hτ_UQ : τ_UQ.hom ≫ U_Q.ι = U_Q.ι ≫ τ_Q.hom)
    (hτ_eW : τ_W.hom ≫ e_W = e_W ≫ τ_Z.hom)
    (hτ_qW : τ_W.hom ≫ q_W = q_W ≫ τ_Q.hom)
    (hBij_low : ∀ (q : ℕ), q ≤ N_deg →
      ∀ (p_u : weilEtaleTorsionH Q_R (ℓ ^ (r + 1)) q →+
          weilEtaleTorsionH U_Q.toScheme (ℓ ^ (r + 1)) q),
        WeilIsTorsionEtalePullback U_Q.ι (ℓ ^ (r + 1)) q p_u →
        Function.Bijective p_u)
    (hFix_Q_top : ∃ (p_τQ : weilEtaleTorsionH Q_R (ℓ ^ (r + 1)) (N_deg + 1) →+
        weilEtaleTorsionH Q_R (ℓ ^ (r + 1)) (N_deg + 1)),
      WeilIsTorsionEtalePullback τ_Q.hom (ℓ ^ (r + 1)) (N_deg + 1) p_τQ ∧
      ∀ w : weilEtaleTorsionH Q_R (ℓ ^ (r + 1)) (N_deg + 1), p_τQ w = w)
    (hFix_Z_mid : ∃ (p_τZ : weilEtaleTorsionH Z_R (ℓ ^ (r + 1)) N_deg →+
        weilEtaleTorsionH Z_R (ℓ ^ (r + 1)) N_deg),
      WeilIsTorsionEtalePullback τ_Z.hom (ℓ ^ (r + 1)) N_deg p_τZ ∧
      ∀ w : weilEtaleTorsionH Z_R (ℓ ^ (r + 1)) N_deg, p_τZ w = w)
    (p_τU : weilEtaleTorsionH U_Z.toScheme (ℓ ^ (r + 1)) N_deg →+
      weilEtaleTorsionH U_Z.toScheme (ℓ ^ (r + 1)) N_deg)
    (hp_τU : WeilIsTorsionEtalePullback τ_UZ.hom (ℓ ^ (r + 1)) N_deg p_τU) :
    ∀ y : weilEtaleTorsionH U_Z.toScheme (ℓ ^ (r + 1)) N_deg,
      p_τU (p_τU y - y) = p_τU y - y :=
by
  let _ := hℓ
  let _ := hτ_xZ
  let _ := hτ_xQ
  obtain ⟨n, rfl⟩ : ∃ n : ℕ, N_deg = n + 1 := ⟨N_deg - 1, (Nat.sub_add_cancel hN).symm⟩
  let m₀ : ℕ := ℓ ^ (r + 1)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
  obtain ⟨hc_all, hr_all, hExact_all, _, hConstIso_all, _⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria.{u}
  have sys : WeilEtaleSitePullbackSys.{u} := fun h =>
    { hCont := hc_all h
      hAdj := hr_all h
      hAdd_pb := (hExact_all h).1
      hAdd_pf := (hExact_all h).2.1
      hLim_pb := (hExact_all h).2.2.1
      hColim_pb := (hExact_all h).2.2.2
      hConstIso := fun {_} hT₁ {_} hT₂ A => hConstIso_all h hT₁ hT₂ A }
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    fun h => (sys h).hCont
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint :=
    fun h => (sys h).hAdj
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPullback
        AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive :=
    fun h => (sys h).hAdd_pb
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteLimits
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
    fun h => (sys h).hLim_pb
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteColimits
        ((weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} Z₂.smallEtaleTopology Z₁.smallEtaleTopology) :=
    fun h => (sys h).hColim_pb
  obtain ⟨hBase, hPaste⟩ := weil_sing_dev_algBC_beck_chevalley_and_long_exact_calculus.{u} sys
  have hExConstPush : ∀ {X S S' X' : AlgebraicGeometry.Scheme.{u}}
      (f : Quiver.Hom X S) (g : Quiver.Hom S' S) (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
      (h_sq : CategoryTheory.CategoryStruct.comp g' f = CategoryTheory.CategoryStruct.comp f' g)
      (A : AddCommGrpCat.{u}) (q : ℕ),
      ∃ γ, WeilIsSingDevAlgBCConstPush f g f' g' h_sq A q γ := by
    intro X S S' X' f g f' g' h_sq A q
    let pf_g := (weilEtaleSitePullback g).sheafPushforwardContinuous
      AddCommGrpCat.{u} S.smallEtaleTopology S'.smallEtaleTopology
    let F_X := (CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj A
    obtain ⟨β, hβ⟩ := ((hBase.2.2.1 f g f' g' h_sq).1 F_X q).1
    exact ⟨CategoryTheory.CategoryStruct.comp β
      (pf_g.map (weilEtaleHigherDirectImageMap f' q
        (weilEtaleConstPullbackHom g'
          (weilEtaleIdTerminalIsTerminal.{u} X')
          (weilEtaleIdTerminalIsTerminal.{u} X) A))), β, hβ, rfl⟩
  have hHDI_tors : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S) (b : ℕ),
      (ℓ ^ (r + 1)) • CategoryTheory.CategoryStruct.id
        (weilEtaleHigherDirectImage f b (weilEtaleTorsionSheaf X m₀)) = 0 := by
    intro X S f b
    have hhom_nsmul : ∀ {A : AddCommGrpCat.{u}} (k : ℕ) (φ : A ⟶ A) (z : A),
        (k • φ).hom z = k • (φ.hom z) := by
      intro A k φ z
      induction k with
      | zero => simp
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul, ← ih]
        rfl
    have hAM_tors : m₀ • CategoryTheory.CategoryStruct.id AM = 0 := by
      apply AddCommGrpCat.ext
      intro x
      change (m₀ • CategoryTheory.CategoryStruct.id AM).hom x = 0
      rw [hhom_nsmul]
      rcases x with ⟨z⟩
      apply ULift.ext
      change m₀ • z = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    let hTerm : CategoryTheory.Limits.IsTerminal (weilEtaleIdTerminal.{u} X) :=
      weilEtaleIdTerminalIsTerminal.{u} X
    let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
    have _ : C_X.IsLeftAdjoint :=
      (CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hTerm).isLeftAdjoint
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts C_X :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts C_X
    have _ : C_X.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts C_X
    let F := weilEtaleTorsionSheaf X m₀
    have hF_tors : m₀ • CategoryTheory.CategoryStruct.id F = 0 := by
      change m₀ • CategoryTheory.CategoryStruct.id (C_X.obj AM) = 0
      rw [← C_X.map_id, ← C_X.map_nsmul, hAM_tors, C_X.map_zero]
    let B : CategoryTheory.Functor S.Etale X.Etale := weilEtaleSitePullback f
    let P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Sheaf.cohomologyPresheaf F b
    let Q : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B.op P
    have hQ_tors : m₀ • CategoryTheory.CategoryStruct.id Q = 0 := by
      ext W x
      have happ : ∀ (k : ℕ) (τ : Q ⟶ Q), (k • τ).app W = k • (τ.app W) := by
        intro k τ
        induction k with
        | zero => simp
        | succ k ih => rw [succ_nsmul, CategoryTheory.NatTrans.app_add, ih, succ_nsmul]
      change ((m₀ • CategoryTheory.CategoryStruct.id Q).app W).hom x = 0
      rw [happ, CategoryTheory.NatTrans.id_app, hhom_nsmul]
      change m₀ • x = 0
      have hExt_tors : ∀ {Z₀ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
          (α : CategoryTheory.Abelian.Ext Z₀ F b), m₀ • α = 0 := by
        intro Z₀ α
        have hcomp_nsmul : ∀ (k : ℕ),
            (k • α).comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
              (Nat.add_zero b) =
            α.comp (CategoryTheory.Abelian.Ext.mk₀ (k • CategoryTheory.CategoryStruct.id F))
              (Nat.add_zero b) := by
          intro k
          induction k with
          | zero => simp
          | succ k ih =>
            rw [succ_nsmul, CategoryTheory.Abelian.Ext.add_comp, ih,
              CategoryTheory.Abelian.Ext.comp_mk₀_id, succ_nsmul,
              CategoryTheory.Abelian.Ext.mk₀_add, CategoryTheory.Abelian.Ext.comp_add,
              CategoryTheory.Abelian.Ext.comp_mk₀_id]
        calc m₀ • α
            = (m₀ • α).comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id F))
                (Nat.add_zero b) := (CategoryTheory.Abelian.Ext.comp_mk₀_id (m₀ • α)).symm
          _ = α.comp (CategoryTheory.Abelian.Ext.mk₀ (m₀ • CategoryTheory.CategoryStruct.id F))
                (Nat.add_zero b) := hcomp_nsmul m₀
          _ = 0 := by
              rw [hF_tors, CategoryTheory.Abelian.Ext.mk₀_zero, CategoryTheory.Abelian.Ext.comp_zero]
      exact hExt_tors x
    let L_S := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have _ : CategoryTheory.Limits.PreservesBinaryBiproducts L_S :=
      CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts L_S
    have _ : L_S.Additive := CategoryTheory.Functor.additive_of_preservesBinaryBiproducts L_S
    change m₀ • CategoryTheory.CategoryStruct.id (L_S.obj Q) = 0
    rw [← L_S.map_id, ← L_S.map_nsmul, hQ_tors, L_S.map_zero]
  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}
  obtain ⟨p_Q0, hp_Q0⟩ := hPullEx U_Q.ι m₀ 0
  obtain ⟨p_Q1, hp_Q1⟩ := hPullEx U_Q.ι m₀ 1
  obtain ⟨p_Q_mid, hp_Q_mid⟩ := hPullEx U_Q.ι m₀ (n + 1)
  obtain ⟨p_Z, hp_Z⟩ := hPullEx U_Z.ι m₀ (n + 1)
  have hBij_Q0 : Function.Bijective p_Q0 :=
    hBij_low 0 (Nat.zero_le (n + 1)) p_Q0 hp_Q0
  have hInj_Q1 : Function.Injective p_Q1 :=
