      obtain ⟨z'_raw, hz'⟩ := hConnSurj Fℤ_U hSE_U (k + 1) z
      let z' : Q.H (k + 1) := z'_raw
      have hz'_comp : z'.comp hSE_U.extClass (rfl : (k + 1) + 1 = k + 2) = z := hz'
      have hZeroQ : ∀ a : ℕ, 1 ≤ a → a ≤ k →
