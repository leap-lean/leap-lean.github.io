  intro γ hγ
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  letI : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
