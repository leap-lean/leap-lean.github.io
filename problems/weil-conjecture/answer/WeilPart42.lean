    let h : R' :=
      algebraMap R_line (Localization.Away g_et)
        (α_2 (algebraMap R_η R_ηloc (ψ_η (MvPolynomial.X 0))))
    let β_R' : R'_η ⟶ R' :=
      CommRingCat.ofHom
        ((algebraMap R_line (Localization.Away g_et)).comp
          (α_2.comp ((algebraMap R_η R_ηloc).comp α_R'η.hom)))
    have hβ_h : β_R'.hom h_η = h := by
      change algebraMap R_line (Localization.Away g_et)
        (α_2 (algebraMap R_η R_ηloc (α_R'η.hom h_η))) = h
      rw [← hψ_η_h]
    have hg_unit : IsUnit (ε_line g_et) := isUnit_iff_ne_zero.mpr hg_ne
    let ε' : R' →+* κ₁ := IsLocalization.Away.lift g_et hg_unit
    have hε'_comp : ε'.comp (algebraMap R_line (Localization.Away g_et)) = ε_line := by
      ext x
      exact IsLocalization.Away.lift_eq g_et hg_unit x
    have hε'_φ1 : ε'.comp φ_1 = Polynomial.evalRingHom 0 := by
      dsimp [φ_1]
      rw [← RingHom.comp_assoc, hε'_comp, hε_α1]
    have hε'_h : ε' h = 0 := by
      have h1 : ε' h = χ_η (ψ_η (MvPolynomial.X 0)) := by
        dsimp [h]
        change (ε'.comp (algebraMap R_line (Localization.Away g_et)))
          (α_2 (algebraMap R_η R_ηloc (ψ_η (MvPolynomial.X 0)))) = _
        rw [hε'_comp]
        exact RingHom.congr_fun hε_α2 (ψ_η (MvPolynomial.X 0))
      rw [h1]
      have hf₀_in_q : φ_η f₀ ∈ q_η.asIdeal := by
        change f₀ ∈ Ideal.comap φ_η q_η.asIdeal
        rw [hq_η_comap]
        exact Ideal.mem_span_singleton_self f₀
      have hψ_in_q : ψ_η (MvPolynomial.X 0) ∈ q_η.asIdeal :=
        (hψ_η_disc q_η).mpr hf₀_in_q
      rw [← hker_χη] at hψ_in_q
      exact hψ_in_q
    have hβ_eB : AlgebraicGeometry.Spec.map β_R' ≫ e_Bη =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_1) ≫ b_line := by
      have hβ_fac : β_R' = α_R'η ≫ CommRingCat.ofHom
          ((algebraMap R_line (Localization.Away g_et)).comp (α_2.comp (algebraMap R_η R_ηloc))) :=
        rfl
      rw [hβ_fac, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc, hα_e_Bη]
      have hφ_fac : CommRingCat.ofHom φ_η ≫ CommRingCat.ofHom
          ((algebraMap R_line (Localization.Away g_et)).comp (α_2.comp (algebraMap R_η R_ηloc))) =
          CommRingCat.ofHom ι_slice ≫ CommRingCat.ofHom φ_1 := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro P
        change algebraMap R_line (Localization.Away g_et)
          ((α_2.comp ((algebraMap R_η R_ηloc).comp φ_η)) P) =
          algebraMap R_line (Localization.Away g_et) ((α_1.comp ι_slice) P)
        rw [hα_comm]
      rw [← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map _),
        ← AlgebraicGeometry.Spec.map_comp, hφ_fac, AlgebraicGeometry.Spec.map_comp]
      dsimp [b_line, g_line]
      simp only [CategoryTheory.Category.assoc]

    
    let I_R' : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) R') :=
      Ideal.span {(∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) -
        MvPolynomial.C h}
    let M_R' : CommRingCat.{u} := CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R' ⧸ I_R')
    obtain ⟨π_M, hπ_X, hπ_C, hPush_M⟩ := h_odp_pushout R'_η R' β_R' h_η h hβ_h
    let ε_MR'_raw : MvPolynomial (Fin (m + 1) × Fin 2) R' →+* κ₁ :=
      MvPolynomial.eval₂Hom ε' 0
    have hI_R'_ker : I_R' ≤ RingHom.ker ε_MR'_raw := by
      rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
      dsimp [ε_MR'_raw]
      simp [hε'_h]
    let ε_MR' : M_R' →+* κ₁ := Ideal.Quotient.lift I_R' ε_MR'_raw (fun _ hp => hI_R'_ker hp)
    have hε_MR'_X : ∀ idx : Fin (m + 1) × Fin 2,
        ε_MR' (Ideal.Quotient.mk I_R' (MvPolynomial.X idx)) = 0 :=
      fun idx => MvPolynomial.eval₂Hom_X' ε' 0 idx
    have hε_MR'_C : ∀ r : R',
        ε_MR' (Ideal.Quotient.mk I_R' (MvPolynomial.C r)) = ε' r :=
      fun r => MvPolynomial.eval₂Hom_C ε' 0 r
    have hε_MR'_π : π_M ≫ CommRingCat.ofHom ε_MR' = CommRingCat.ofHom ε_Mη := by
      apply CommRingCat.hom_ext
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r'
        change ε_MR' (π_M.hom (Ideal.Quotient.mk I_η (MvPolynomial.C r'))) =
          ε_Mη (Ideal.Quotient.mk I_η (MvPolynomial.C r'))
        rw [hπ_C r', hε_MR'_C, hε_Mη_C]
        change (ε'.comp (algebraMap R_line (Localization.Away g_et)))
          ((α_2.comp (algebraMap R_η R_ηloc)) (α_R'η.hom r')) = χ_η (α_R'η.hom r')
        rw [hε'_comp]
        exact RingHom.congr_fun hε_α2 (α_R'η.hom r')
      · intro idx
        change ε_MR' (π_M.hom (Ideal.Quotient.mk I_η (MvPolynomial.X idx))) =
          ε_Mη (Ideal.Quotient.mk I_η (MvPolynomial.X idx))
        rw [hπ_X idx, hε_MR'_X]
        exact (MvPolynomial.eval₂Hom_X' χ'_R'η 0 idx).symm
    have hs_vη_q' : s_vη ≫ q_η_roof =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_MR') ≫ AlgebraicGeometry.Spec.map π_M := by
      rw [hs_vη_q, ← AlgebraicGeometry.Spec.map_comp, hε_MR'_π]

    
    let π_mod_η : AlgebraicGeometry.Spec M_η ⟶ AlgebraicGeometry.Spec R'_η :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_η).comp MvPolynomial.C))
    let π_mod_R' : AlgebraicGeometry.Spec M_R' ⟶ AlgebraicGeometry.Spec R' :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((Ideal.Quotient.mk I_R').comp MvPolynomial.C))
    let u₀ : AlgebraicGeometry.Spec R' :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε')).base pt
    let e_B : AlgebraicGeometry.Spec R' ⟶ B_line.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_1)
    have he_B_et : AlgebraicGeometry.Etale e_B :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ_1_et
    let V' : AlgebraicGeometry.Scheme.{u} :=
      CategoryTheory.Limits.pullback q_η_roof (AlgebraicGeometry.Spec.map π_M)
    let p_V : V' ⟶ V'_η :=
      CategoryTheory.Limits.pullback.fst q_η_roof (AlgebraicGeometry.Spec.map π_M)
    let q : V' ⟶ AlgebraicGeometry.Spec M_R' :=
      CategoryTheory.Limits.pullback.snd q_η_roof (AlgebraicGeometry.Spec.map π_M)
    have hq_et : AlgebraicGeometry.Etale q :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale)
        (CategoryTheory.IsPullback.of_hasPullback q_η_roof (AlgebraicGeometry.Spec.map π_M))
        hq_η_et
    let s_V' : AlgebraicGeometry.Spec (CommRingCat.of κ₁) ⟶ V' :=
      CategoryTheory.Limits.pullback.lift s_vη
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_MR')) hs_vη_q'
    let v₀ : V' := s_V'.base pt
    have hPb_Spec_M : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map π_M) π_mod_R' π_mod_η (AlgebraicGeometry.Spec.map β_R') :=
      AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_M
    have he_Y_comm : (p_V ≫ e_Yη) ≫ g₂.left = (q ≫ π_mod_R' ≫ e_B) ≫ b_line := by
      calc (p_V ≫ e_Yη) ≫ g₂.left
          = p_V ≫ (q_η_roof ≫ π_mod_η ≫ e_Bη) := by
            rw [CategoryTheory.Category.assoc, hComm_η]
        _ = (p_V ≫ q_η_roof) ≫ π_mod_η ≫ e_Bη := by
            simp only [CategoryTheory.Category.assoc]
        _ = (q ≫ AlgebraicGeometry.Spec.map π_M) ≫ π_mod_η ≫ e_Bη := by
            rw [CategoryTheory.Limits.pullback.condition]
        _ = q ≫ (AlgebraicGeometry.Spec.map π_M ≫ π_mod_η) ≫ e_Bη := by
            simp only [CategoryTheory.Category.assoc]
        _ = q ≫ (π_mod_R' ≫ AlgebraicGeometry.Spec.map β_R') ≫ e_Bη := by
            rw [hPb_Spec_M.w]
        _ = q ≫ π_mod_R' ≫ (AlgebraicGeometry.Spec.map β_R' ≫ e_Bη) := by
            simp only [CategoryTheory.Category.assoc]
        _ = (q ≫ π_mod_R' ≫ e_B) ≫ b_line := by
            rw [hβ_eB]
            dsimp [e_B]
            simp only [CategoryTheory.Category.assoc]
    let e_Y : V' ⟶ Y_line.left :=
      hPb_line.lift (p_V ≫ e_Yη) (q ≫ π_mod_R' ≫ e_B) he_Y_comm
    have he_Y_H : e_Y ≫ H_line = p_V ≫ e_Yη := hPb_line.lift_fst _ _ he_Y_comm
    have he_Y_f : e_Y ≫ f_line.left = q ≫ π_mod_R' ≫ e_B := hPb_line.lift_snd _ _ he_Y_comm

    
    let W_η := CategoryTheory.Limits.pullback g₂.left e_Bη
    let fst_η : W_η ⟶ Y₂.left := CategoryTheory.Limits.pullback.fst g₂.left e_Bη
    let snd_η : W_η ⟶ AlgebraicGeometry.Spec R'_η :=
      CategoryTheory.Limits.pullback.snd g₂.left e_Bη
    have hfst_η_et : AlgebraicGeometry.Etale fst_η :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale)
        (CategoryTheory.IsPullback.of_hasPullback g₂.left e_Bη).flip he_Bη_et
    let e'_Yη : V'_η ⟶ W_η :=
      CategoryTheory.Limits.pullback.lift e_Yη (q_η_roof ≫ π_mod_η)
        (hComm_η.trans (CategoryTheory.Category.assoc _ _ _).symm)
    have he'_Yη_fst : e'_Yη ≫ fst_η = e_Yη :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have he'_Yη_snd : e'_Yη ≫ snd_η = q_η_roof ≫ π_mod_η :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have he'_Yη_et : AlgebraicGeometry.Etale e'_Yη :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale) e'_Yη fst_η hfst_η_et
        (he'_Yη_fst.symm ▸ he_Yη_et)

    let W_line := CategoryTheory.Limits.pullback f_line.left e_B
    let fst_line : W_line ⟶ Y_line.left := CategoryTheory.Limits.pullback.fst f_line.left e_B
    let snd_line : W_line ⟶ AlgebraicGeometry.Spec R' :=
      CategoryTheory.Limits.pullback.snd f_line.left e_B
    have hfst_line_et : AlgebraicGeometry.Etale fst_line :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale)
        (CategoryTheory.IsPullback.of_hasPullback f_line.left e_B).flip he_B_et
    have hPb_W_outer : CategoryTheory.IsPullback
        (fst_line ≫ H_line) snd_line g₂.left (AlgebraicGeometry.Spec.map β_R' ≫ e_Bη) := by
      have h1 : CategoryTheory.IsPullback
          (fst_line ≫ H_line) snd_line g₂.left (e_B ≫ b_line) :=
        (CategoryTheory.IsPullback.of_hasPullback f_line.left e_B).paste_horiz hPb_line
      have hβ_eB' : AlgebraicGeometry.Spec.map β_R' ≫ e_Bη = e_B ≫ b_line := hβ_eB
      rwa [← hβ_eB'] at h1
    have hτ_W_comm : (fst_line ≫ H_line) ≫ g₂.left =
        (snd_line ≫ AlgebraicGeometry.Spec.map β_R') ≫ e_Bη :=
      hPb_W_outer.w.trans (CategoryTheory.Category.assoc _ _ _).symm
    let τ_W : W_line ⟶ W_η :=
      CategoryTheory.Limits.pullback.lift (fst_line ≫ H_line)
        (snd_line ≫ AlgebraicGeometry.Spec.map β_R') hτ_W_comm
    have hPb_W : CategoryTheory.IsPullback τ_W snd_line snd_η
        (AlgebraicGeometry.Spec.map β_R') := by
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ hτ_W_comm)
        (CategoryTheory.IsPullback.of_hasPullback g₂.left e_Bη)
      rwa [CategoryTheory.Limits.pullback.lift_fst _ _ hτ_W_comm]

    let e'_Y : V' ⟶ W_line :=
      CategoryTheory.Limits.pullback.lift e_Y (q ≫ π_mod_R')
        (he_Y_f.trans (CategoryTheory.Category.assoc _ _ _).symm)
    have he'_Y_fst : e'_Y ≫ fst_line = e_Y :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have he'_Y_snd : e'_Y ≫ snd_line = q ≫ π_mod_R' :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have h_e'Y_comm_W : e'_Y ≫ τ_W = p_V ≫ e'_Yη := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc (e'_Y ≫ τ_W) ≫ fst_η
            = e'_Y ≫ (τ_W ≫ fst_η) := CategoryTheory.Category.assoc _ _ _
          _ = (e'_Y ≫ fst_line) ≫ H_line := by
              rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc]
          _ = p_V ≫ e_Yη := by rw [he'_Y_fst, he_Y_H]
          _ = (p_V ≫ e'_Yη) ≫ fst_η := by
              rw [CategoryTheory.Category.assoc, he'_Yη_fst]
      · calc (e'_Y ≫ τ_W) ≫ snd_η
            = e'_Y ≫ (τ_W ≫ snd_η) := CategoryTheory.Category.assoc _ _ _
          _ = (e'_Y ≫ snd_line) ≫ AlgebraicGeometry.Spec.map β_R' := by
              rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
          _ = q ≫ (π_mod_R' ≫ AlgebraicGeometry.Spec.map β_R') := by
              rw [he'_Y_snd, CategoryTheory.Category.assoc]
          _ = (q ≫ AlgebraicGeometry.Spec.map π_M) ≫ π_mod_η := by
              rw [← hPb_Spec_M.w, CategoryTheory.Category.assoc]
          _ = p_V ≫ (q_η_roof ≫ π_mod_η) := by
              rw [← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
          _ = (p_V ≫ e'_Yη) ≫ snd_η := by
              rw [← he'_Yη_snd, CategoryTheory.Category.assoc]
    have hPb_V_M : CategoryTheory.IsPullback
        p_V (q ≫ π_mod_R') (q_η_roof ≫ π_mod_η) (AlgebraicGeometry.Spec.map β_R') :=
      (CategoryTheory.IsPullback.of_hasPullback q_η_roof
        (AlgebraicGeometry.Spec.map π_M)).paste_vert hPb_Spec_M
    have hPb_e'Y : CategoryTheory.IsPullback p_V e'_Y e'_Yη τ_W := by
      have hflip : CategoryTheory.IsPullback e'_Y p_V τ_W e'_Yη := by
        refine CategoryTheory.IsPullback.of_right ?_ h_e'Y_comm_W hPb_W.flip
        rw [he'_Y_snd, he'_Yη_snd]
        exact hPb_V_M.flip
      exact hflip.flip
    have he'_Y_et : AlgebraicGeometry.Etale e'_Y :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (P := @AlgebraicGeometry.Etale) hPb_e'Y he'_Yη_et
    have he_Y_et : AlgebraicGeometry.Etale e_Y := by
      rw [← he'_Y_fst]
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        e'_Y fst_line he'_Y_et hfst_line_et

    
    have h_base_eq : f_line.left.base (x_zero.base pt) = s_zero.base pt :=
      congrArg (fun u => u.base pt) hx_sec
    have he_B_u₀ : e_B.base u₀ = s_zero.base pt := by
      have hcomp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε') ≫ e_B = s_zero := by
        dsimp [e_B, s_zero]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        exact CommRingCat.hom_ext hε'_φ1
      exact congrArg (fun u => u.base pt) hcomp
    have hs_V'_eY : s_V' ≫ e_Y = x_zero := by
      apply hPb_line.hom_ext
      · rw [CategoryTheory.Category.assoc, he_Y_H, ← CategoryTheory.Category.assoc s_V',
          CategoryTheory.Limits.pullback.lift_fst, hx_H]
      · rw [CategoryTheory.Category.assoc, he_Y_f, ← CategoryTheory.Category.assoc s_V',
          CategoryTheory.Limits.pullback.lift_snd, hx_sec]
        have hε_MR'_mod : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_MR') ≫ π_mod_R' =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε') := by
          dsimp [π_mod_R']
          rw [← AlgebraicGeometry.Spec.map_comp]
          congr 1
          apply CommRingCat.hom_ext
          ext r
          exact hε_MR'_C r
        rw [← CategoryTheory.Category.assoc, hε_MR'_mod]
        dsimp [e_B, s_zero]
        rw [← AlgebraicGeometry.Spec.map_comp]
        congr 1
        exact CommRingCat.hom_ext hε'_φ1
    have he_Y_v₀ : e_Y.base v₀ = x_zero.base pt :=
      congrArg (fun u => u.base pt) hs_V'_eY

    let ψ_B : Polynomial κ₁ →+* R' :=
      Polynomial.eval₂RingHom ((algebraMap R_line (Localization.Away g_et)).comp
        (α_1.comp Polynomial.C)) h
    have hψ_B_X : ψ_B Polynomial.X = h := Polynomial.eval₂_X _ h
    have hψ_B_Spec_et : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_B_et
    have he_B_hom : e_B ≫ B_line.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) := by
      dsimp [e_B, B_line]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro c
      change φ_1 (Polynomial.C c) =
        Polynomial.eval₂ ((algebraMap R_line (Localization.Away g_et)).comp
          (α_1.comp Polynomial.C)) h (Polynomial.C c)
      rw [Polynomial.eval₂_C]
      rfl

    have hu₀_h : h ∈ u₀.asIdeal := by
      change ε' h ∈ pt.asIdeal
      rw [hε'_h]
      exact pt.asIdeal.zero_mem
    have hq_v₀ : q.base v₀ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ε_MR')).base pt :=
      congrArg (fun u => u.base pt) (CategoryTheory.Limits.pullback.lift_snd _ _ hs_vη_q')
    have hv₀_X : ∀ idx : Fin (m + 1) × Fin 2,
        Ideal.Quotient.mk I_R' (MvPolynomial.X idx) ∈ (q.base v₀).asIdeal := by
      intro idx
      rw [hq_v₀]
      change ε_MR' (Ideal.Quotient.mk I_R' (MvPolynomial.X idx)) ∈ pt.asIdeal
      rw [hε_MR'_X idx]
      exact pt.asIdeal.zero_mem
    have hv₀_C : Ideal.Quotient.mk I_R' (MvPolynomial.C h) ∈ (q.base v₀).asIdeal := by
      rw [hq_v₀]
      change ε_MR' (Ideal.Quotient.mk I_R' (MvPolynomial.C h)) ∈ pt.asIdeal
      rw [hε_MR'_C h, hε'_h]
      exact pt.asIdeal.zero_mem

    exact ⟨h_base_eq, R', u₀, e_B, h, V', v₀, e_Y, q, he_B_et, he_Y_et, hq_et,
      he_B_u₀, he_Y_v₀, ⟨ψ_B, hψ_B_X, hψ_B_Spec_et, he_B_hom⟩,
      hu₀_h, hv₀_X, hv₀_C, he_Y_f⟩

theorem weil_p2_net_odp_roof_pullback_and_generic_slice (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z₁.hom]
    [AlgebraicGeometry.IsProper Z₁.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z₁.hom]
    (P : WeilRationalLefschetzPencil F m Z₁)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    (U_disc_reg : C_disc.left.Opens)
    (hSing : WeilTransvTriIsSingularDatum F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc U_disc_reg)
    (a : F) (ha : a ∈ S_aff)
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra F k]
    (π_P2 : (weilProjectiveSpaceOver k 2).left ⟶ (weilProjectiveSpaceOver F 2).left)
    (hπ_P2 : IsFieldPullbackModel F k (weilProjectiveSpaceOver F 2) (weilProjectiveSpaceOver k 2) π_P2)
    (j_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
      (weilProjectiveSpaceOver k 2).left)
    [AlgebraicGeometry.IsOpenImmersion j_0]
    (hj_0_hom : j_0 ≫ (weilProjectiveSpaceOver k 2).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (h₀ f₀ : MvPolynomial (Fin 2) k)
    (hh₀_irr : Irreducible h₀)
    (hf₀_irr : Irreducible f₀)
    (hj_0_Sigma : j_0.base ⁻¹' (π_P2.base ⁻¹' (Set.range P.ι_line.left.base)) =
      { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) | h₀ ∈ p.asIdeal })
