    have hpb_W : CategoryTheory.IsPullback p₁ p₂ w_hom i :=
      CategoryTheory.IsPullback.of_hasPullback w_hom i
    have : AlgebraicGeometry.IsClosedImmersion p₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_W.flip hi
    have hp₁_cl : Topology.IsClosedEmbedding p₁.base := p₁.isClosedEmbedding
    let f_τ : S ⟶ P_W := (Fgt_S.map τ_W).left
    have hf_snd : f_τ ≫ p₂ = 𝟙 S := CategoryTheory.MorphismProperty.Over.w τ_W
    have : CategoryTheory.Mono f_τ := @CategoryTheory.SplitMono.mono _ _ _ _ f_τ ⟨p₂, hf_snd⟩
    have : AlgebraicGeometry.Etale f_τ :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) f_τ p₂
        (B_i.obj W).prop (by rw [hf_snd]; exact T_S.prop)
    have : AlgebraicGeometry.IsOpenImmersion f_τ :=
      AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono f_τ
    let K₀ : Set ↥P_W := (Set.range f_τ.base)ᶜ
    have hK₀_cl : IsClosed K₀ := f_τ.isOpenEmbedding.isOpen_range.isClosed_compl
    let Z₀ : Set ↥W_sch := p₁.base '' K₀
    have hZ₀_cl : IsClosed Z₀ := hp₁_cl.isClosedMap K₀ hK₀_cl
    let O : W_sch.Opens := ⟨Z₀ᶜ, hZ₀_cl.isOpen_compl⟩
    let W' : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ w_hom) inferInstance
    let g : Quiver.Hom W' W := CategoryTheory.MorphismProperty.Over.homMk O.ι rfl trivial
    have h_sub : Set.range (f_τ ≫ p₁).base ⊆ Set.range O.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨s₀, rfl⟩
      change p₁.base (f_τ.base s₀) ∉ Z₀
      rintro ⟨q, hq_K₀, hq_eq⟩
      exact hq_K₀ ⟨s₀, (hp₁_cl.injective hq_eq).symm⟩
    let u_O : S ⟶ O.toScheme := AlgebraicGeometry.IsOpenImmersion.lift O.ι (f_τ ≫ p₁) h_sub
    have hu_O : u_O ≫ O.ι = f_τ ≫ p₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac O.ι (f_τ ≫ p₁) h_sub
    have h_cond : u_O ≫ (O.ι ≫ w_hom) = 𝟙 S ≫ i := by
      calc u_O ≫ (O.ι ≫ w_hom)
          = (u_O ≫ O.ι) ≫ w_hom := (Category.assoc u_O O.ι w_hom).symm
        _ = (f_τ ≫ p₁) ≫ w_hom := by rw [hu_O]
        _ = f_τ ≫ (p₁ ≫ w_hom) := Category.assoc f_τ p₁ w_hom
        _ = f_τ ≫ (p₂ ≫ i) := by rw [hpb_W.w]
        _ = (f_τ ≫ p₂) ≫ i := (Category.assoc f_τ p₂ i).symm
        _ = 𝟙 S ≫ i := by rw [hf_snd]
    let P_W' : AlgebraicGeometry.Scheme.{u} := (Fgt_S.obj (B_i.obj W')).left
    let p₁' : P_W' ⟶ O.toScheme := CategoryTheory.Limits.pullback.fst (O.ι ≫ w_hom) i
    let p₂' : P_W' ⟶ S := (Fgt_S.obj (B_i.obj W')).hom
    have : AlgebraicGeometry.Etale p₂' := (B_i.obj W').prop
    let f_τ' : S ⟶ P_W' := CategoryTheory.Limits.pullback.lift u_O (𝟙 S) h_cond
    have hf'_fst : f_τ' ≫ p₁' = u_O :=
      CategoryTheory.Limits.pullback.lift_fst u_O (𝟙 S) h_cond
    have hf'_snd : f_τ' ≫ p₂' = 𝟙 S :=
      CategoryTheory.Limits.pullback.lift_snd u_O (𝟙 S) h_cond
    let τ_W' : Quiver.Hom T_S (B_i.obj W') :=
      CategoryTheory.MorphismProperty.Over.homMk f_τ' hf'_snd trivial
    let g_S : P_W' ⟶ P_W := (Fgt_S.map (B_i.map g)).left
    have hgS_fst : g_S ≫ p₁ = p₁' ≫ O.ι :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hgS_snd : g_S ≫ p₂ = p₂' :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hf_fac : f_τ' ≫ g_S = f_τ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (f_τ' ≫ g_S) ≫ p₁ = f_τ ≫ p₁
        rw [Category.assoc, hgS_fst, ← Category.assoc, hf'_fst, hu_O]
      · change (f_τ' ≫ g_S) ≫ p₂ = f_τ ≫ p₂
        rw [Category.assoc, hgS_snd, hf'_snd, hf_snd]
    have hτ_fac : CategoryTheory.CategoryStruct.comp τ_W' (B_i.map g) = τ_W :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext hf_fac (Subsingleton.elim _ _)
    have : CategoryTheory.Mono f_τ' := @CategoryTheory.SplitMono.mono _ _ _ _ f_τ' ⟨p₂', hf'_snd⟩
    have : AlgebraicGeometry.Etale f_τ' :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) f_τ' p₂'
        (B_i.obj W').prop (by rw [hf'_snd]; exact T_S.prop)
    have : AlgebraicGeometry.IsOpenImmersion f_τ' :=
      AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono f_τ'
    have hpb_W'_flip : CategoryTheory.IsPullback (g_S ≫ p₂) p₁' i (O.ι ≫ w_hom) := by
      rw [hgS_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (O.ι ≫ w_hom) i).flip
    have hpb_left : CategoryTheory.IsPullback g_S p₁' p₁ O.ι :=
      CategoryTheory.IsPullback.of_right hpb_W'_flip hgS_fst hpb_W.flip
    have : AlgebraicGeometry.IsOpenImmersion g_S :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hpb_left.flip inferInstance
    have hSurj : Function.Surjective f_τ'.base := by
      intro q'
      let q : ↥P_W := g_S.base q'
      have hq_p₁ : p₁.base q = O.ι.base (p₁'.base q') := by
        change (g_S ≫ p₁).base q' = (p₁' ≫ O.ι).base q'
        rw [hgS_fst]
      have hq_not_Z₀ : p₁.base q ∉ Z₀ := by
        rw [hq_p₁]
        exact (p₁'.base q').2
      have hq_not_K₀ : q ∉ K₀ := fun hq_K₀ => hq_not_Z₀ ⟨q, hq_K₀, rfl⟩
      have hq_range : q ∈ Set.range f_τ.base := Set.notMem_compl_iff.mp hq_not_K₀
      obtain ⟨s₀, hs₀⟩ := hq_range
      refine ⟨s₀, g_S.isOpenEmbedding.injective ?_⟩
      change (f_τ' ≫ g_S).base s₀ = q
      rw [hf_fac]
      exact hs₀
    have : CategoryTheory.Epi f_τ'.base := (TopCat.epi_iff_surjective f_τ'.base).mpr hSurj
    obtain ⟨⟨f_inv, hf_hom_inv, hf_inv_hom⟩⟩ := AlgebraicGeometry.IsOpenImmersion.isIso f_τ'
    have hinv_w : f_inv ≫ 𝟙 S = p₂' := by
      calc f_inv ≫ 𝟙 S = f_inv ≫ (f_τ' ≫ p₂') := by rw [hf'_snd]
        _ = (f_inv ≫ f_τ') ≫ p₂' := (Category.assoc f_inv f_τ' p₂').symm
        _ = 𝟙 P_W' ≫ p₂' := by rw [hf_inv_hom]
        _ = p₂' := Category.id_comp p₂'
    let τ_W'_inv : Quiver.Hom (B_i.obj W') T_S :=
      CategoryTheory.MorphismProperty.Over.homMk f_inv hinv_w trivial
    have h1 : CategoryTheory.CategoryStruct.comp τ_W' τ_W'_inv =
        CategoryTheory.CategoryStruct.id T_S :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (by change f_τ' ≫ f_inv = 𝟙 S; exact hf_hom_inv) (Subsingleton.elim _ _)
    have h2 : CategoryTheory.CategoryStruct.comp τ_W'_inv τ_W' =
        CategoryTheory.CategoryStruct.id (B_i.obj W') :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext
        (by change f_inv ≫ f_τ' = 𝟙 P_W'; exact hf_inv_hom) (Subsingleton.elim _ _)
    exact ⟨W', g, τ_W', τ_W'_inv, hτ_fac, h1, h2⟩

  
  have hDichot : ∀ (Ω : Type u) [Field Ω]
      (y : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ X),
      let S_κ := AlgebraicGeometry.Spec (CommRingCat.of κ)
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      ((∃ y_U : S_Ω ⟶ U.toScheme, y_U ≫ U.ι = y) ∧
        ∀ (W : X.Etale)
          (τ_W : Quiver.Hom (weilEtaleIdTerminal.{u} S_Ω) ((weilEtaleSitePullback y).obj W)),
          ∃ (W' : X.Etale) (g : Quiver.Hom W' W)
            (τ_W' : Quiver.Hom (weilEtaleIdTerminal.{u} S_Ω) ((weilEtaleSitePullback y).obj W')),
            CategoryTheory.CategoryStruct.comp τ_W' ((weilEtaleSitePullback y).map g) = τ_W ∧
            IsEmpty ↥(((AlgebraicGeometry.Scheme.Etale.forget S_κ).obj
              ((weilEtaleSitePullback x₀).obj W')).left)) ∨
      (∃ u : S_Ω ⟶ S_κ, u ≫ x₀ = y) := by
    intro Ω _ y
    have : AlgebraicGeometry.IsClosedImmersion x₀ := hx₀
    let S_κ := AlgebraicGeometry.Spec (CommRingCat.of κ)
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have hSpecSub : ∀ (K : Type u) [Field K],
        Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      intro K _
      refine ⟨fun (a b : PrimeSpectrum K) => PrimeSpectrum.ext ?_⟩
      have hbot : ∀ p : PrimeSpectrum K, p.asIdeal = ⊥ := by
        intro p
        ext r
        rw [Ideal.mem_bot]
        constructor
        · intro hr
          by_contra hr0
          exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hr (isUnit_iff_ne_zero.mpr hr0))
        · rintro rfl
          exact p.asIdeal.zero_mem
      exact (hbot a).trans (hbot b).symm
    have : Subsingleton ↥S_Ω := hSpecSub Ω
    have : Subsingleton ↥S_κ := hSpecSub κ
    have : Finite ↥S_Ω := Finite.of_subsingleton
    have : Finite ↥S_κ := Finite.of_subsingleton
    let pt_Ω : ↥S_Ω := (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum Ω)
    by_cases hy_in : y.base pt_Ω ∈ (U : Set X)
    · left
      have hy_range : Set.range y.base ⊆ Set.range U.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨t, rfl⟩
        rw [Subsingleton.elim t pt_Ω]
        exact hy_in
      refine ⟨⟨AlgebraicGeometry.IsOpenImmersion.lift U.ι y hy_range,
        AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι y hy_range⟩, ?_⟩
      intro W τ_W
      let Fgt_X := AlgebraicGeometry.Scheme.Etale.forget X
      let Fgt_Ω := AlgebraicGeometry.Scheme.Etale.forget S_Ω
      let Fgt_κ := AlgebraicGeometry.Scheme.Etale.forget S_κ
      let B_y := weilEtaleSitePullback y
      let B_x₀ := weilEtaleSitePullback x₀
      let W_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_X.obj W).left
      let w_hom : W_sch ⟶ X := (Fgt_X.obj W).hom
      have : AlgebraicGeometry.Etale w_hom := W.prop
      let O_W : W_sch.Opens := (TopologicalSpace.Opens.map w_hom.base).obj U
      let W' : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_W.ι ≫ w_hom) inferInstance
      let g : Quiver.Hom W' W := CategoryTheory.MorphismProperty.Over.homMk O_W.ι rfl trivial
      let P_Wy : AlgebraicGeometry.Scheme.{u} := (Fgt_Ω.obj (B_y.obj W)).left
      let p₁ : P_Wy ⟶ W_sch := CategoryTheory.Limits.pullback.fst w_hom y
      let p₂ : P_Wy ⟶ S_Ω := (Fgt_Ω.obj (B_y.obj W)).hom
      have hp₁₂ : p₁ ≫ w_hom = p₂ ≫ y := CategoryTheory.Limits.pullback.condition
      let f_τ : S_Ω ⟶ P_Wy := (Fgt_Ω.map τ_W).left
      have hf_snd : f_τ ≫ p₂ = 𝟙 S_Ω := CategoryTheory.MorphismProperty.Over.w τ_W
      have h_sub : Set.range (f_τ ≫ p₁).base ⊆ Set.range O_W.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨t, rfl⟩
        change w_hom.base ((f_τ ≫ p₁).base t) ∈ (U : Set X)
        have h_eq : (f_τ ≫ (p₁ ≫ w_hom)).base t = (f_τ ≫ (p₂ ≫ y)).base t := by rw [hp₁₂]
        have h_lhs : (f_τ ≫ (p₁ ≫ w_hom)).base t = w_hom.base ((f_τ ≫ p₁).base t) := rfl
        have h_rhs : (f_τ ≫ (p₂ ≫ y)).base t = y.base pt_Ω := by
          rw [← Category.assoc, hf_snd, Category.id_comp, Subsingleton.elim t pt_Ω]
        rw [← h_lhs, h_eq, h_rhs]
        exact hy_in
      let u_O : S_Ω ⟶ O_W.toScheme := AlgebraicGeometry.IsOpenImmersion.lift O_W.ι (f_τ ≫ p₁) h_sub
      have hu_O : u_O ≫ O_W.ι = f_τ ≫ p₁ :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac O_W.ι (f_τ ≫ p₁) h_sub
      have h_cond : u_O ≫ (O_W.ι ≫ w_hom) = 𝟙 S_Ω ≫ y := by
        calc u_O ≫ (O_W.ι ≫ w_hom)
            = (u_O ≫ O_W.ι) ≫ w_hom := (Category.assoc u_O O_W.ι w_hom).symm
          _ = (f_τ ≫ p₁) ≫ w_hom := by rw [hu_O]
          _ = f_τ ≫ (p₁ ≫ w_hom) := Category.assoc f_τ p₁ w_hom
          _ = f_τ ≫ (p₂ ≫ y) := by rw [hp₁₂]
          _ = (f_τ ≫ p₂) ≫ y := (Category.assoc f_τ p₂ y).symm
          _ = 𝟙 S_Ω ≫ y := by rw [hf_snd]
      let P_W'y : AlgebraicGeometry.Scheme.{u} := (Fgt_Ω.obj (B_y.obj W')).left
      let p₁' : P_W'y ⟶ O_W.toScheme := CategoryTheory.Limits.pullback.fst (O_W.ι ≫ w_hom) y
      let p₂' : P_W'y ⟶ S_Ω := (Fgt_Ω.obj (B_y.obj W')).hom
      let f_τ' : S_Ω ⟶ P_W'y := CategoryTheory.Limits.pullback.lift u_O (𝟙 S_Ω) h_cond
      have hf'_fst : f_τ' ≫ p₁' = u_O :=
        CategoryTheory.Limits.pullback.lift_fst u_O (𝟙 S_Ω) h_cond
      have hf'_snd : f_τ' ≫ p₂' = 𝟙 S_Ω :=
        CategoryTheory.Limits.pullback.lift_snd u_O (𝟙 S_Ω) h_cond
      let τ_W' : Quiver.Hom (weilEtaleIdTerminal.{u} S_Ω) (B_y.obj W') :=
        CategoryTheory.MorphismProperty.Over.homMk f_τ' hf'_snd trivial
      let g_Ω : P_W'y ⟶ P_Wy := (Fgt_Ω.map (B_y.map g)).left
      have hg_fst : g_Ω ≫ p₁ = p₁' ≫ O_W.ι :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hg_snd : g_Ω ≫ p₂ = p₂' :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hf_fac : f_τ' ≫ g_Ω = f_τ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · change (f_τ' ≫ g_Ω) ≫ p₁ = f_τ ≫ p₁
          rw [Category.assoc, hg_fst, ← Category.assoc, hf'_fst, hu_O]
        · change (f_τ' ≫ g_Ω) ≫ p₂ = f_τ ≫ p₂
          rw [Category.assoc, hg_snd, hf'_snd, hf_snd]
      have hτ_fac : CategoryTheory.CategoryStruct.comp τ_W' (B_y.map g) = τ_W :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hf_fac (Subsingleton.elim _ _)
      have hEmp : IsEmpty ↥((Fgt_κ.obj (B_x₀.obj W')).left) := by
        refine ⟨fun p => ?_⟩
        let q₁ := (CategoryTheory.Limits.pullback.fst (O_W.ι ≫ w_hom) x₀).base p
        let q₂ := (CategoryTheory.Limits.pullback.snd (O_W.ι ≫ w_hom) x₀).base p
        have hcond : (O_W.ι ≫ w_hom).base q₁ = x₀.base q₂ := by
          change (CategoryTheory.Limits.pullback.fst (O_W.ι ≫ w_hom) x₀ ≫ (O_W.ι ≫ w_hom)).base p =
            (CategoryTheory.Limits.pullback.snd (O_W.ι ≫ w_hom) x₀ ≫ x₀).base p
          rw [CategoryTheory.Limits.pullback.condition]
        have hq₁_U : (O_W.ι ≫ w_hom).base q₁ ∈ (U : Set X) := q₁.2
        rw [hcond, hU] at hq₁_U
        exact hq₁_U ⟨q₂, rfl⟩
      exact ⟨W', g, τ_W', hτ_fac, hEmp⟩
    · right
      have hy_mem_x₀ : y.base pt_Ω ∈ Set.range x₀.base :=
        Set.notMem_compl_iff.mp (hU ▸ hy_in)
      have h_range : Set.range y.base ⊆ Set.range x₀.base := by
        rintro _ ⟨t, rfl⟩
        rw [Subsingleton.elim t pt_Ω]
        exact hy_mem_x₀
      have : AlgebraicGeometry.QuasiCompact y := ⟨fun _ _ _ => (Set.toFinite _).isCompact⟩
      have : AlgebraicGeometry.QuasiCompact x₀ := ⟨fun _ _ _ => (Set.toFinite _).isCompact⟩
      have h_supp : y.ker.support ≤ x₀.ker.support := by
        change (y.ker.support : Set X) ⊆ (x₀.ker.support : Set X)
        rw [y.support_ker, x₀.support_ker]
        exact closure_mono h_range
      have hx₀_le_rad : x₀.ker ≤ y.ker.radical := by
        calc x₀.ker ≤ x₀.ker.radical := x₀.ker.le_radical
          _ = AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal x₀.ker.support :=
              x₀.ker.vanishingIdeal_support.symm
          _ ≤ AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal y.ker.support :=
              AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_antimono h_supp
          _ = y.ker.radical :=
              y.ker.vanishingIdeal_support
      have : AlgebraicGeometry.IsReduced S_Ω := inferInstance
      have hy_rad_le : y.ker.radical ≤ y.ker := by
        rw [AlgebraicGeometry.Scheme.IdealSheafData.le_def]
        intro V r hr
        rw [AlgebraicGeometry.Scheme.IdealSheafData.radical_ideal] at hr
        obtain ⟨n, hn⟩ := hr
        rw [y.ker_apply] at hn ⊢
        rw [RingHom.mem_ker, map_pow] at hn
        rw [RingHom.mem_ker]
        exact IsNilpotent.eq_zero ⟨n, hn⟩
      have h_ker : x₀.ker ≤ y.ker := hx₀_le_rad.trans hy_rad_le
      exact ⟨AlgebraicGeometry.IsClosedImmersion.lift x₀ y h_ker,
        AlgebraicGeometry.IsClosedImmersion.lift_fac x₀ y h_ker⟩

  
  let S_κ := AlgebraicGeometry.Spec (CommRingCat.of κ)
  let T_κ : S_κ.Etale := weilEtaleIdTerminal.{u} S_κ
  let T_X : X.Etale := weilEtaleIdTerminal.{u} X
  let B_x₀ := weilEtaleSitePullback x₀
  let pf_x₀ := B_x₀.sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology S_κ.smallEtaleTopology
  let pb_x₀ := B_x₀.sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology S_κ.smallEtaleTopology
  let adj_x₀ := B_x₀.sheafAdjunctionContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology S_κ.smallEtaleTopology
  let M := pb_x₀.obj 𝒢
  let η_x₀ := adj_x₀.unit.app 𝒢
  let ε_M := adj_x₀.counit.app M
  obtain ⟨_, hFaithful_κ, _, hColim_κ⟩ :=
    weil_etale_algClosed_spec_unit_iso_and_stalk_colimit.{u} κ

  have hInj_ε : Function.Injective (ε_M.hom.app (Opposite.op T_κ)).hom := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨W, τ_W, s, hs_rep⟩ := (hColim_κ X x₀ (pf_x₀.obj M)).1 z
    have hs_eval : (M.obj.map (Opposite.op τ_W)).hom s = 0 := by
      have h1 : (ε_M.hom.app (Opposite.op T_κ)).hom z = (M.obj.map (Opposite.op τ_W)).hom s :=
        (congrArg ((ε_M.hom.app (Opposite.op T_κ)).hom) hs_rep.symm).trans
          (hRightTriEval x₀ T_κ M W τ_W s)
      exact h1.symm.trans hz
    obtain ⟨W', g, τ_W', τ_W'_inv, h_fac, _, hτ_inv_hom⟩ := hShrinkIso x₀ hx₀ W τ_W
    let s' : ↥((pf_x₀.obj M).obj.obj (Opposite.op W')) :=
      ((pf_x₀.obj M).obj.map (Opposite.op g)).hom s
    have hs'_eval : (M.obj.map (Opposite.op τ_W')).hom s' = 0 := by
      have hmap : M.obj.map (Opposite.op τ_W) =
          M.obj.map (Opposite.op (B_x₀.map g)) ≫ M.obj.map (Opposite.op τ_W') := by
        rw [← h_fac]
        exact M.obj.map_comp ((B_x₀.map g).op) (τ_W'.op)
      have h_comp : (M.obj.map (Opposite.op τ_W)).hom s =
          (M.obj.map (Opposite.op τ_W')).hom s' := by
        change ((M.obj.map (Opposite.op τ_W)).hom) s =
          (M.obj.map (Opposite.op τ_W')).hom ((M.obj.map (Opposite.op (B_x₀.map g))).hom s)
        rw [hmap]
        rfl
      exact h_comp.symm.trans hs_eval
    have hs'_zero : s' = 0 := by
      have hmap_inv : M.obj.map (Opposite.op τ_W') ≫ M.obj.map (Opposite.op τ_W'_inv) =
          𝟙 (M.obj.obj (Opposite.op (B_x₀.obj W'))) := by
        rw [← M.obj.map_comp]
        exact (congrArg (fun v => M.obj.map (Opposite.op v)) hτ_inv_hom).trans
          (M.obj.map_id (Opposite.op (B_x₀.obj W')))
      have h_ret : (M.obj.map (Opposite.op τ_W'_inv)).hom
          ((M.obj.map (Opposite.op τ_W')).hom s') = s' :=
        ConcreteCategory.congr_hom hmap_inv s'
      exact h_ret.symm.trans
        ((congrArg ((M.obj.map (Opposite.op τ_W'_inv)).hom) hs'_eval).trans
          (map_zero ((M.obj.map (Opposite.op τ_W'_inv)).hom)))
    have hz_zero := hResVanish x₀ T_κ (pf_x₀.obj M) W W' g τ_W τ_W' s h_fac hs'_zero
    exact hs_rep.symm.trans hz_zero

  have hSurj_ε : Function.Surjective (ε_M.hom.app (Opposite.op T_κ)).hom := by
    let π_T : Quiver.Hom (B_x₀.obj T_X) T_κ :=
      (weilEtaleIdTerminalIsTerminal.{u} S_κ).from (B_x₀.obj T_X)
    have h_top_cond : x₀ ≫ 𝟙 X = 𝟙 S_κ ≫ x₀ :=
      (Category.comp_id x₀).trans (Category.id_comp x₀).symm
