        congr 1
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul, MvPolynomial.map_X, MvPolynomial.map_X]
      obtain ⟨π₂, hπ₂_X, _, hPb_C₂⟩ := hMvQuotIsPullback χ₂ P_R₂ Q_c₂ hmap_P₂
      obtain ⟨S₀, _, ι_S, ε₀, ψ_cone₁, ψ_cone₂, hε_ι, hEt_cone₁, hψ_cone₁_ι, hker_cone₁,
