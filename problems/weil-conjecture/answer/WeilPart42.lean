        _ = (r_sol * φ c_b * algebraMap C R_bar (ℛ u)) * ut_inv := by ring
        _ = (φ c_a * algebraMap C R_bar (ℛ u)) * ut_inv := by rw [h1]
        _ = φ c_a * (algebraMap C R_bar (ℛ u) * ut_inv) := by ring
        _ = φ c_a := by rw [hut, mul_one]
    refine ⟨r_sol, ?_⟩
    have hcb_unit : IsUnit (algebraMap R_bar (FractionRing R_bar) (φ c_b)) :=
