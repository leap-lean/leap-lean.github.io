      CategoryTheory.yoneda ⋙
        ((CategoryTheory.Functor.whiskeringRight (Opposite X.Etale) (Type u) AddCommGrpCat.{u}).obj
          AddCommGrpCat.free ⋙
          CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u})
    have hmap_z : (((G.cohomologyPresheaf 0).map u.op).hom z) =
        (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map u)).comp z (Nat.zero_add 0) := by
      have hmap : (G.cohomologyPresheaf 0).map u.op =
          ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map u.op)).app G := rfl
      rw [hmap, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map u.op) G]
      rfl
    rw [hmap_z]
    let f_z := CategoryTheory.Abelian.Ext.addEquiv₀ z
    have hz : z = CategoryTheory.Abelian.Ext.mk₀ f_z :=
      (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply z).symm
    have hcomp : (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map u)).comp z (Nat.zero_add 0) =
        CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map u ≫ f_z) := by
      rw [hz]
      exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hcomp]
    have hmk : CategoryTheory.Abelian.Ext.addEquiv₀
        (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.map u ≫ f_z)) =
        Z_fun.map u ≫ f_z := by
      apply (CategoryTheory.Abelian.Ext.mk₀_bijective (X := weilPolyP1CohomologyRepSheaf X U₂) (Y := G)).1
      exact CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply _
    rw [hmk, hRep_comp X U₂ (Z_fun.map u) f_z]
    have hrm : weilPolyP1CohomologyRepHomEquiv X U₂ (Z_fun.obj U₁) (Z_fun.map u) =
        ((weilPolyP1CohomologyRepSheaf X U₁).obj.map u.op).hom (ι₀ U₁) := hRep_map u
    rw [hrm]
    have hfnat := congrArg (fun m => m.hom (ι₀ U₁)) (f_z.hom.naturality u.op)
    dsimp at hfnat
    rw [← hRep_eval U₁ G f_z] at hfnat
    exact hfnat

  have hUnitIso : ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ S)
      (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (θ_X : G.cohomologyPresheaf 0 ≅ G.obj),
      let B_f := weilEtaleSitePullback f
      let P_fG := B_f.op ⋙ G.cohomologyPresheaf 0
      let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
        S.smallEtaleTopology X.smallEtaleTopology
      let shAdj_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
      ∃ e₀ : weilEtaleHigherDirectImage f 0 G ≅ pf_f.obj G,
        ∀ W₀ : S.Etale,
          (shAdj_S.unit.app P_fG).app (Opposite.op W₀) ≫ e₀.hom.hom.app (Opposite.op W₀) =
            θ_X.hom.app (Opposite.op (B_f.obj W₀)) := by
    intro X S f G θ_X B_f P_fG pf_f shAdj_S
    let θ_fG : P_fG ≅ (pf_f.obj G).obj := CategoryTheory.Functor.isoWhiskerLeft B_f.op θ_X
    have hcounit : CategoryTheory.IsIso (shAdj_S.counit.app (pf_f.obj G)) :=
      CategoryTheory.isIso_sheafificationAdjunction_counit (pf_f.obj G)
    let e₀ : weilEtaleHigherDirectImage f 0 G ≅ pf_f.obj G :=
      ((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).mapIso θ_fG) ≪≫
        @CategoryTheory.asIso _ _ _ _ (shAdj_S.counit.app (pf_f.obj G)) hcounit
    refine ⟨e₀, fun W₀ => ?_⟩
    let ι_S := CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}
    let L_S := CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}
    have hnat : shAdj_S.unit.app P_fG ≫
        (ι_S.map (L_S.map θ_fG.hom) ≫ ι_S.map (shAdj_S.counit.app (pf_f.obj G))) = θ_fG.hom :=
      ((Category.assoc _ _ _).symm.trans
        (congrArg (· ≫ ι_S.map (shAdj_S.counit.app (pf_f.obj G)))
          (shAdj_S.unit.naturality θ_fG.hom).symm)).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (θ_fG.hom ≫ ·) (shAdj_S.right_triangle_components (pf_f.obj G))).trans
            (Category.comp_id _)))
    have hcomp_map : ι_S.map (L_S.map θ_fG.hom ≫ shAdj_S.counit.app (pf_f.obj G)) =
        ι_S.map (L_S.map θ_fG.hom) ≫ ι_S.map (shAdj_S.counit.app (pf_f.obj G)) :=
      ι_S.map_comp _ _
    exact congrArg (fun m => m.app (Opposite.op W₀))
      ((congrArg (shAdj_S.unit.app P_fG ≫ ·) hcomp_map).trans hnat)

  have hSandwich : ∀ {A₁ A₂ A₀ A₃ B₀ A₅ : AddCommGrpCat.{u}}
      (u : A₁ ⟶ A₂) (e_A : A₂ ≅ A₀) (θ_A : A₁ ≅ A₀)
      (m : A₂ ⟶ A₃) (e_B : A₃ ≅ B₀) (ξ_B : B₀ ≅ A₅) (φ_iso : A₁ ≅ A₅),
      u ≫ e_A.hom = θ_A.hom →
      u ≫ m ≫ e_B.hom ≫ ξ_B.hom = φ_iso.hom →
      CategoryTheory.IsIso m := by
    intro A₁ A₂ A₀ A₃ B₀ A₅ u e_A θ_A m e_B ξ_B φ_iso hu hφ
    let u_inv : A₂ ⟶ A₁ := e_A.hom ≫ θ_A.inv
    have hu_left : u_inv ≫ u = 𝟙 A₂ := by
      have h1 : (u_inv ≫ u) ≫ e_A.hom = e_A.hom := by
        dsimp [u_inv]
        rw [Category.assoc, Category.assoc, hu, θ_A.inv_hom_id, Category.comp_id]
      have h2 := congrArg (· ≫ e_A.inv) h1
      rwa [Category.assoc, e_A.hom_inv_id, Category.comp_id] at h2
    let m_inv : A₃ ⟶ A₂ := e_B.hom ≫ ξ_B.hom ≫ φ_iso.inv ≫ u
    refine ⟨⟨m_inv, ?_, ?_⟩⟩
    · have h1 : u ≫ (m ≫ m_inv) = u := by
        dsimp [m_inv]
        calc u ≫ m ≫ e_B.hom ≫ ξ_B.hom ≫ φ_iso.inv ≫ u
          _ = (u ≫ m ≫ e_B.hom ≫ ξ_B.hom) ≫ φ_iso.inv ≫ u := by simp only [Category.assoc]
          _ = φ_iso.hom ≫ φ_iso.inv ≫ u := by rw [hφ]
          _ = u := by rw [φ_iso.hom_inv_id_assoc]
      have h2 := congrArg (u_inv ≫ ·) h1
      rwa [← Category.assoc, hu_left, Category.id_comp] at h2
    · have h1 : (m_inv ≫ m) ≫ e_B.hom ≫ ξ_B.hom = e_B.hom ≫ ξ_B.hom := by
        dsimp [m_inv]
        calc (e_B.hom ≫ ξ_B.hom ≫ φ_iso.inv ≫ u) ≫ m ≫ e_B.hom ≫ ξ_B.hom
          _ = e_B.hom ≫ ξ_B.hom ≫ φ_iso.inv ≫ (u ≫ m ≫ e_B.hom ≫ ξ_B.hom) := by
              simp only [Category.assoc]
          _ = e_B.hom ≫ ξ_B.hom ≫ φ_iso.inv ≫ φ_iso.hom := by rw [hφ]
          _ = e_B.hom ≫ ξ_B.hom := by rw [φ_iso.inv_hom_id, Category.comp_id]
      have h2 := congrArg (· ≫ (ξ_B.inv ≫ e_B.inv)) h1
      simp only [Category.assoc] at h2
      rwa [ξ_B.hom_inv_id_assoc, e_B.hom_inv_id, Category.comp_id] at h2

  have hCongr_fst : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} {f₁ f₂ : Y₁ ⟶ Y₂}
      (heq : f₁ = f₂) (A₀ : Y₂.Etale),
      ((CategoryTheory.MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) heq).inv.app A₀).left ≫
        CategoryTheory.Limits.pullback.fst A₀.hom f₁ =
      CategoryTheory.Limits.pullback.fst A₀.hom f₂ := by
    intro Y₁ Y₂ f₁ f₂ heq A₀
    subst heq
    change (CategoryTheory.Limits.pullback.congrHom (rfl : A₀.hom = A₀.hom) (rfl : f₁ = f₁)).inv ≫
        CategoryTheory.Limits.pullback.fst A₀.hom f₁ =
      CategoryTheory.Limits.pullback.fst A₀.hom f₁
    simp

  have hDeg0 : ∀ (F : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}) {β₀},
      WeilIsSingDevAlgBCBCPush h w j' w' hpb.w F 0 β₀ →
      CategoryTheory.IsIso ((adj_w.homEquiv _ _).symm β₀) := by
    intro F β₀ hβ₀
    let 𝒜 := weilEtaleHigherDirectImage h 0 F
    let ℬ := weilEtaleHigherDirectImage j' 0 (pb_w'.obj F)
    have hMate_eq : (adj_w.homEquiv 𝒜 ℬ).symm β₀ =
        ξ_w.hom.app 𝒜 ≫ (adj_Rw.homEquiv 𝒜 ℬ).symm β₀ := by
      apply (adj_w.homEquiv 𝒜 ℬ).injective
      rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Functor.map_comp, ← Category.assoc,
        CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app,
        ← CategoryTheory.Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
    rw [hMate_eq]
    suffices hIso_Rw : CategoryTheory.IsIso ((adj_Rw.homEquiv 𝒜 ℬ).symm β₀) by
      exact CategoryTheory.IsIso.comp_isIso
    have hIso_psh : CategoryTheory.IsIso
        ((CategoryTheory.sheafToPresheaf V.smallEtaleTopology AddCommGrpCat.{u}).map
          ((adj_Rw.homEquiv 𝒜 ℬ).symm β₀)) := by
      rw [CategoryTheory.NatTrans.isIso_iff_isIso_app]
      intro E_op
      let E : V.Etale := E_op.unop
      obtain ⟨θ_ZU, hθ_ZU⟩ := hTheta_ex Z_U F
      obtain ⟨θ_VU, hθ_VU⟩ := hTheta_ex V_U (pb_w'.obj F)
      obtain ⟨e₀_h, he₀_h_unit⟩ := hUnitIso h F θ_ZU
      obtain ⟨e₀_j', he₀_j_unit⟩ := hUnitIso j' (pb_w'.obj F) θ_VU
      let B_h := weilEtaleSitePullback h
      let B_j' := weilEtaleSitePullback j'
      let P_hF := B_h.op ⋙ F.cohomologyPresheaf 0
      let P_jF := B_j'.op ⋙ (pb_w'.obj F).cohomologyPresheaf 0
      let shAdj_Z := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
      let shAdj_V := CategoryTheory.sheafificationAdjunction V.smallEtaleTopology AddCommGrpCat.{u}

      let W₀ : Z.Etale := M_w.obj E
      let e₀_h_W₀ : 𝒜.obj.obj (Opposite.op W₀) ≅ F.obj.obj (Opposite.op (B_h.obj W₀)) :=
        { hom := e₀_h.hom.hom.app (Opposite.op W₀)
          inv := e₀_h.inv.hom.app (Opposite.op W₀)
          hom_inv_id := congrArg (fun m => m.hom.app (Opposite.op W₀)) e₀_h.hom_inv_id
          inv_hom_id := congrArg (fun m => m.hom.app (Opposite.op W₀)) e₀_h.inv_hom_id }
      let e₀_j_E : ℬ.obj.obj (Opposite.op E) ≅ (pb_w'.obj F).obj.obj (Opposite.op (B_j'.obj E)) :=
        { hom := e₀_j'.hom.hom.app (Opposite.op E)
          inv := e₀_j'.inv.hom.app (Opposite.op E)
          hom_inv_id := congrArg (fun m => m.hom.app (Opposite.op E)) e₀_j'.hom_inv_id
          inv_hom_id := congrArg (fun m => m.hom.app (Opposite.op E)) e₀_j'.inv_hom_id }
      let ξ_w'_E : (pb_w'.obj F).obj.obj (Opposite.op (B_j'.obj E)) ≅
          F.obj.obj (Opposite.op (M_w'.obj (B_j'.obj E))) :=
        { hom := (ξ_w'.hom.app F).hom.app (Opposite.op (B_j'.obj E))
          inv := (ξ_w'.inv.app F).hom.app (Opposite.op (B_j'.obj E))
          hom_inv_id := congrArg (fun m => m.hom.app (Opposite.op (B_j'.obj E))) (ξ_w'.hom_inv_id_app F)
          inv_hom_id := congrArg (fun m => m.hom.app (Opposite.op (B_j'.obj E))) (ξ_w'.inv_hom_id_app F) }

      let η_MB : E ⟶ B_w.obj W₀ := adj_MB_w.unit.app E
      let e_fun : CategoryTheory.Iso (CategoryTheory.Functor.comp B_h B_w')
          (CategoryTheory.Functor.comp B_w B_j') :=
        CategoryTheory.Iso.trans
          (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp w' h))
          (CategoryTheory.Iso.trans
            (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb.w)
            (CategoryTheory.MorphismProperty.Over.pullbackComp j' w))
      let τ_E : B_j'.obj E ⟶ B_w'.obj (B_h.obj W₀) :=
        B_j'.map η_MB ≫ e_fun.inv.app W₀
      let ψ_E : M_w'.obj (B_j'.obj E) ⟶ B_h.obj W₀ :=
        M_w'.map τ_E ≫ adj_MB_w'.counit.app (B_h.obj W₀)

      have hψ_snd : ψ_E.left ≫ CategoryTheory.Limits.pullback.snd (E.hom ≫ w) h =
          CategoryTheory.Limits.pullback.snd E.hom j' ≫ w' :=
        CategoryTheory.MorphismProperty.Over.w ψ_E
      have hψ_fst : ψ_E.left ≫ CategoryTheory.Limits.pullback.fst (E.hom ≫ w) h =
          CategoryTheory.Limits.pullback.fst E.hom j' := by
        have hcounit_left : (adj_MB_w'.counit.app (B_h.obj W₀)).left =
            CategoryTheory.Limits.pullback.fst (B_h.obj W₀).hom w' :=
          congrArg (fun m => m.left)
            (CategoryTheory.MorphismProperty.Over.mapPullbackAdj_counit_app P_et ⊤ w' hw' trivial (B_h.obj W₀))
        let m_bj : CategoryTheory.Limits.pullback E.hom j' ⟶
            CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd W₀.hom w) j' :=
          (B_j'.map η_MB).left
        let m_jw : CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd W₀.hom w) j' ⟶
            CategoryTheory.Limits.pullback W₀.hom (j' ≫ w) :=
          ((CategoryTheory.MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) j' w).inv.app W₀).left
        let m_cg : CategoryTheory.Limits.pullback W₀.hom (j' ≫ w) ⟶
            CategoryTheory.Limits.pullback W₀.hom (w' ≫ h) :=
          ((CategoryTheory.MorphismProperty.Over.pullbackCongr (P := P_et) (Q := ⊤) hpb.w).inv.app W₀).left
        let m_wh : CategoryTheory.Limits.pullback W₀.hom (w' ≫ h) ⟶
            CategoryTheory.Limits.pullback (CategoryTheory.Limits.pullback.snd W₀.hom h) w' :=
          ((CategoryTheory.MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) w' h).hom.app W₀).left
        have hτ_left : τ_E.left = m_bj ≫ (m_jw ≫ m_cg) ≫ m_wh := rfl
        let p_fst_wh := CategoryTheory.Limits.pullback.fst (B_h.obj W₀).hom w'
        let p_fst_h := CategoryTheory.Limits.pullback.fst W₀.hom h
        have hψ_unfold : ψ_E.left =
            m_bj ≫ m_jw ≫ m_cg ≫ m_wh ≫ p_fst_wh :=
          (congrArg (· ≫ (adj_MB_w'.counit.app (B_h.obj W₀)).left) hτ_left).trans
            ((congrArg ((m_bj ≫ (m_jw ≫ m_cg) ≫ m_wh) ≫ ·) hcounit_left).trans
              ((Category.assoc m_bj ((m_jw ≫ m_cg) ≫ m_wh) p_fst_wh).trans
                (congrArg (m_bj ≫ ·)
                  ((Category.assoc (m_jw ≫ m_cg) m_wh p_fst_wh).trans
                    (Category.assoc m_jw m_cg (m_wh ≫ p_fst_wh))))))
        have hcomp_wh : m_wh ≫ (p_fst_wh ≫ p_fst_h) =
            CategoryTheory.Limits.pullback.fst W₀.hom (w' ≫ h) :=
          CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst (P := P_et) (Q := ⊤) w' h W₀
        have hcomp_jw : m_jw ≫ CategoryTheory.Limits.pullback.fst W₀.hom (j' ≫ w) =
            CategoryTheory.Limits.pullback.fst (B_w.obj W₀).hom j' ≫
              CategoryTheory.Limits.pullback.fst W₀.hom w := by
          have h1 := CategoryTheory.MorphismProperty.Over.pullbackComp_left_fst_fst
            (P := P_et) (Q := ⊤) j' w W₀
          have hinv : m_jw ≫
              ((CategoryTheory.MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) j' w).hom.app W₀).left =
              𝟙 _ :=
            congrArg (fun m => m.left)
              ((CategoryTheory.MorphismProperty.Over.pullbackComp (P := P_et) (Q := ⊤) j' w).inv_hom_id_app W₀)
          exact (congrArg (m_jw ≫ ·) h1.symm).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) hinv).trans (Category.id_comp _)))
        have hmap_j : m_bj ≫ CategoryTheory.Limits.pullback.fst (B_w.obj W₀).hom j' =
            CategoryTheory.Limits.pullback.fst E.hom j' ≫ η_MB.left :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.fst (B_w.obj W₀).hom j')
            (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ j' η_MB)).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have hunit_left : η_MB.left ≫ CategoryTheory.Limits.pullback.fst W₀.hom w = 𝟙 E.left :=
          (congrArg (· ≫ CategoryTheory.Limits.pullback.fst W₀.hom w)
            (congrArg (fun m => m.left)
              (CategoryTheory.MorphismProperty.Over.mapPullbackAdj_unit_app P_et ⊤ w hw trivial E))).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        have hassoc_init : ψ_E.left ≫ CategoryTheory.Limits.pullback.fst (E.hom ≫ w) h =
            m_bj ≫ m_jw ≫ m_cg ≫ (m_wh ≫ (p_fst_wh ≫ p_fst_h)) :=
          (congrArg (· ≫ p_fst_h) hψ_unfold).trans
            ((Category.assoc m_bj _ p_fst_h).trans
              (congrArg (m_bj ≫ ·)
                ((Category.assoc m_jw _ p_fst_h).trans
                  (congrArg (m_jw ≫ ·)
                    ((Category.assoc m_cg _ p_fst_h).trans
                      (congrArg (m_cg ≫ ·) (Category.assoc m_wh p_fst_wh p_fst_h)))))))
        exact hassoc_init.trans
          ((congrArg (fun x => m_bj ≫ m_jw ≫ m_cg ≫ x) hcomp_wh).trans
            ((congrArg (fun x => m_bj ≫ m_jw ≫ x) (hCongr_fst hpb.w W₀)).trans
              ((congrArg (fun x => m_bj ≫ x) hcomp_jw).trans
                ((Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst W₀.hom w) hmap_j).trans
                    ((Category.assoc _ _ _).trans
                      ((congrArg (CategoryTheory.Limits.pullback.fst E.hom j' ≫ ·) hunit_left).trans
                        (Category.comp_id _))))))))
      let hpb_E := (((CategoryTheory.IsPullback.of_hasPullback E.hom j').flip).paste_horiz hpb).flip
      have hψ_iso_left : ψ_E.left = hpb_E.isoPullback.hom := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact hψ_fst.trans hpb_E.isoPullback_hom_fst.symm
        · exact hψ_snd.trans hpb_E.isoPullback_hom_snd.symm
      let ψ_E_inv : B_h.obj W₀ ⟶ M_w'.obj (B_j'.obj E) :=
        CategoryTheory.MorphismProperty.Over.homMk hpb_E.isoPullback.inv
          ((congrArg (hpb_E.isoPullback.inv ≫ ·) hpb_E.isoPullback_hom_snd.symm).trans
            ((Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ _) hpb_E.isoPullback.inv_hom_id).trans (Category.id_comp _))))
          trivial
      let ψ_E_iso : M_w'.obj (B_j'.obj E) ≅ B_h.obj W₀ :=
        { hom := ψ_E
          inv := ψ_E_inv
          hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext
            ((congrArg (· ≫ hpb_E.isoPullback.inv) hψ_iso_left).trans hpb_E.isoPullback.hom_inv_id)
          inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext
            ((congrArg (hpb_E.isoPullback.inv ≫ ·) hψ_iso_left).trans hpb_E.isoPullback.inv_hom_id) }

      let m_target : 𝒜.obj.obj (Opposite.op W₀) ⟶ ℬ.obj.obj (Opposite.op E) :=
        β₀.hom.app (Opposite.op W₀) ≫ ℬ.obj.map η_MB.op
      let Φ_E : P_hF.obj (Opposite.op W₀) ⟶ F.obj.obj (Opposite.op (M_w'.obj (B_j'.obj E))) :=
        (shAdj_Z.unit.app P_hF).app (Opposite.op W₀) ≫
          m_target ≫
          e₀_j_E.hom ≫
          ξ_w'_E.hom
      have hΦ_eq : Φ_E = θ_ZU.hom.app (Opposite.op (B_h.obj W₀)) ≫ F.obj.map ψ_E.op := by
        have hΦ_step1 : Φ_E =
            weilSingDevAlgBCBCPushApp h w j' w' hpb.w F 0 W₀ ≫
              ℬ.obj.map η_MB.op ≫
              e₀_j_E.hom ≫
              ξ_w'_E.hom :=
          (congrArg ((shAdj_Z.unit.app P_hF).app (Opposite.op W₀) ≫ ·)
            (Category.assoc (β₀.hom.app (Opposite.op W₀)) (ℬ.obj.map η_MB.op) _)).trans
            ((Category.assoc ((shAdj_Z.unit.app P_hF).app (Opposite.op W₀))
              (β₀.hom.app (Opposite.op W₀)) _).symm.trans
