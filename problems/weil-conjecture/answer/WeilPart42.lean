        { toFun := g₀, map_one' := hg_one, map_mul' := hg_mul,
          map_zero' := by have h := hg_comm 0; rwa [map_zero, map_zero] at h,
          map_add' := hg_add, commutes' := hg_comm }
      have hsplit : f.kerSquareLift.comp g = AlgHom.id R S := by
        ext x; simp only [AlgHom.comp_apply, AlgHom.id_apply]; change φ (g₀ x) = x
        dsimp [g₀]; rw [map_add φ, hφℓ, map_sum]
        have h0 : (∑ i : Fin n, φ (δ x (b i) * ℓ (bDual i))) = 0 := by
          refine Finset.sum_eq_zero fun i _ => ?_; rw [map_mul φ, hφδ, zero_mul]
        rw [h0, add_zero]
      exact Algebra.FormallySmooth.of_split f g hsplit
    haveI : Module.Finite R S := Module.Finite.of_basis b
    haveI : Module.FinitePresentation R S := Module.finitePresentation_of_finite R S
    haveI : Algebra.FinitePresentation R S := Algebra.FinitePresentation.of_finitePresentation R S
    haveI : Algebra.FormallyEtale R S :=
      Algebra.FormallyEtale.of_formallyUnramified_and_formallySmooth
    exact Algebra.Etale.mk
  
  have hPillar4 :
