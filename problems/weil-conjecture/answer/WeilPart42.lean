        ← IsScalarTower.algebraMap_apply (Polynomial k) R₀_k B_Sigma,
        ← IsScalarTower.algebraMap_apply (Polynomial k) B_Sigma L_Sigma]
    let g_RF : R₀ →+* K_k := (algebraMap R₀_k K_k).comp j_R₀k
    have hg_RF_unit : ∀ y : nonZeroDivisors R₀, IsUnit (g_RF y) := by
      intro y
      have hy0 : (y : R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hjy0 : j_R₀k y ≠ 0 := (map_ne_zero_iff j_R₀k hj_R₀k).mpr hy0
      exact isUnit_iff_ne_zero.mpr
        ((map_ne_zero_iff _ (IsFractionRing.injective R₀_k K_k)).mpr hjy0)
    let j_RF : RatFunc F →+* K_k := IsLocalization.lift hg_RF_unit
    have hj_RF_eq : ∀ r : R₀,
        j_RF (algebraMap R₀ (RatFunc F) r) = algebraMap R₀_k K_k (j_R₀k r) :=
      fun r => IsLocalization.lift_eq hg_RF_unit r
    
    let Ω := AlgebraicClosure K_k
    let S_sep := separableClosure K_k Ω
    let Ω_sep : Type u := ↥S_sep
    have : IsGalois K_k Ω_sep := inferInstance
    have : Algebra.IsAlgebraic K_k M_r := Algebra.IsAlgebraic.of_finite K_k M_r
    have : Algebra.IsAlgebraic K_k L_Sigma := Algebra.IsAlgebraic.of_finite K_k L_Sigma
    let ψ_M : M_r →ₐ[K_k] Ω := IsAlgClosed.lift
    let ψ_Sigma : L_Sigma →ₐ[K_k] Ω := IsAlgClosed.lift
    have h_alg_mem_sep : ∀ {E : Type u} [Field E] [Algebra K_k E] [IsGalois K_k E]
        (ψ : E →ₐ[K_k] Ω) (x : E), ψ x ∈ S_sep := by
      intro E _ _ _ ψ x
      rw [mem_separableClosure_iff]
      have hsep : (minpoly K_k x).Separable := IsGalois.separable K_k x
      have heval : Polynomial.aeval (ψ x) (minpoly K_k x) = 0 := by
        rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
      exact Polynomial.Separable.of_dvd hsep (minpoly.dvd K_k (ψ x) heval)
    let ψ_M' : M_r →ₐ[K_k] Ω_sep := ψ_M.codRestrict S_sep.toSubalgebra (h_alg_mem_sep ψ_M)
    let ψ_Sigma' : L_Sigma →ₐ[K_k] Ω_sep :=
      ψ_Sigma.codRestrict S_sep.toSubalgebra (h_alg_mem_sep ψ_Sigma)
    let g_rc : B_r →+* L_V' := (algebraMap B_V' L_V').comp ι_rc.toRingHom
    have hg_rc_unit : ∀ y : nonZeroDivisors B_r, IsUnit (g_rc y) := by
      intro y
      have hy0 : (y : B_r) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hiy0 : ι_rc y ≠ 0 := (map_ne_zero_iff ι_rc hι_rc_inj).mpr hy0
      exact isUnit_iff_ne_zero.mpr
        ((map_ne_zero_iff _ (IsFractionRing.injective B_V' L_V')).mpr hiy0)
    let i_Lr : L_r →+* L_V' := IsLocalization.lift hg_rc_unit
    have hi_Lr_B : ∀ b : B_r,
        i_Lr (algebraMap B_r L_r b) = algebraMap B_V' L_V' (ι_rc b) :=
      fun b => IsLocalization.lift_eq hg_rc_unit b
    have hi_Lr_RF : ∀ q : RatFunc F,
        i_Lr (algebraMap (RatFunc F) L_r q) = algebraMap (RatFunc F) L_V' q := by
      have h_ext : i_Lr.comp (algebraMap (RatFunc F) L_r) = algebraMap (RatFunc F) L_V' := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R₀)
        ext r
        simp only [RingHom.comp_apply]
        rw [← IsScalarTower.algebraMap_apply R₀ (RatFunc F) L_r,
          ← IsScalarTower.algebraMap_apply R₀ (RatFunc F) L_V',
          IsScalarTower.algebraMap_apply R₀ B_r L_r, hi_Lr_B,
          ι_rc.commutes r, ← IsScalarTower.algebraMap_apply R₀ B_V' L_V']
      exact fun q => congrFun (congrArg DFunLike.coe h_ext) q
    let g_Bk : B_r →+* M_r := (algebraMap B_k M_r).comp j_Bk
    have hg_Bk_unit : ∀ y : nonZeroDivisors B_r, IsUnit (g_Bk y) := by
      intro y
      have hy0 : (y : B_r) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hjy0 : j_Bk y ≠ 0 := (map_ne_zero_iff j_Bk hj_Bk_inj).mpr hy0
      exact isUnit_iff_ne_zero.mpr
        ((map_ne_zero_iff _ (IsFractionRing.injective B_k M_r)).mpr hjy0)
    let j_LM : L_r →+* M_r := IsLocalization.lift hg_Bk_unit
    have hj_LM_B : ∀ b : B_r,
        j_LM (algebraMap B_r L_r b) = algebraMap B_k M_r (j_Bk b) :=
      fun b => IsLocalization.lift_eq hg_Bk_unit b
    have hj_LM_RF : ∀ q : RatFunc F,
        j_LM (algebraMap (RatFunc F) L_r q) = algebraMap K_k M_r (j_RF q) := by
      have h_ext : j_LM.comp (algebraMap (RatFunc F) L_r) =
          (algebraMap K_k M_r).comp j_RF := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R₀)
        ext r
        simp only [RingHom.comp_apply]
        have hj_Bk_r : j_Bk (algebraMap R₀ B_r r) = algebraMap R₀_k B_k (j_R₀k r) :=
          congrFun (congrArg DFunLike.coe hj_Bk_comp) r
        rw [← IsScalarTower.algebraMap_apply R₀ (RatFunc F) L_r,
          IsScalarTower.algebraMap_apply R₀ B_r L_r, hj_LM_B, hj_Bk_r,
          ← IsScalarTower.algebraMap_apply R₀_k B_k M_r,
          hj_RF_eq r, ← IsScalarTower.algebraMap_apply R₀_k K_k M_r]
      exact fun q => congrFun (congrArg DFunLike.coe h_ext) q
    have hex_ψV' : ∃ ψ_V' : L_V' →+* Ω, ∀ x : L_r, ψ_V' (i_Lr x) = ψ_M (j_LM x) := by
      let _ : Algebra L_r L_V' := i_Lr.toAlgebra
      let _ : Algebra L_r Ω := (ψ_M.toRingHom.comp j_LM).toAlgebra
      have : IsScalarTower (RatFunc F) L_r L_V' :=
        IsScalarTower.of_algebraMap_eq fun q => (hi_Lr_RF q).symm
      have : FiniteDimensional L_r L_V' :=
        Module.Finite.of_restrictScalars_finite (RatFunc F) L_r L_V'
      have : Algebra.IsAlgebraic L_r L_V' := Algebra.IsAlgebraic.of_finite L_r L_V'
      let φ : L_V' →ₐ[L_r] Ω := IsAlgClosed.lift
      exact ⟨φ.toRingHom, fun x => φ.commutes x⟩
    obtain ⟨ψ_V', hψ_V'_Lr⟩ := hex_ψV'
    have hψ_V'_RF : ∀ q : RatFunc F,
        ψ_V' (algebraMap (RatFunc F) L_V' q) = algebraMap K_k Ω (j_RF q) := by
      intro q
      rw [← hi_Lr_RF q, hψ_V'_Lr, hj_LM_RF q, ψ_M.commutes]
    have hψ_V'_mem : ∀ y : L_V', ψ_V' y ∈ S_sep := by
      intro y
      rw [mem_separableClosure_iff]
      let P_y := minpoly (RatFunc F) y
      let Q_y : Polynomial K_k := P_y.map j_RF
      have hQy_sep : Q_y.Separable :=
        Polynomial.Separable.map (IsGalois.separable (RatFunc F) y)
      have heval_Qy : Polynomial.aeval (ψ_V' y) Q_y = 0 := by
        dsimp only [Q_y]
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        have hcomp : (algebraMap K_k Ω).comp j_RF = ψ_V'.comp (algebraMap (RatFunc F) L_V') :=
          RingHom.ext fun q => (hψ_V'_RF q).symm
        rw [hcomp, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, minpoly.aeval, map_zero]
      exact Polynomial.Separable.of_dvd hQy_sep (minpoly.dvd K_k (ψ_V' y) heval_Qy)
    let ψ_V'' : L_V' →+* Ω_sep :=
      { toFun := fun y => ⟨ψ_V' y, hψ_V'_mem y⟩
        map_one' := Subtype.ext ψ_V'.map_one
        map_mul' := fun a b => Subtype.ext (ψ_V'.map_mul a b)
        map_zero' := Subtype.ext ψ_V'.map_zero
        map_add' := fun a b => Subtype.ext (ψ_V'.map_add a b) }
    have hψ_V''_RF : ∀ q : RatFunc F,
        ψ_V'' (algebraMap (RatFunc F) L_V' q) = algebraMap K_k Ω_sep (j_RF q) :=
      fun q => Subtype.ext (hψ_V'_RF q)
    let i_V' : B_V' →+* Ω_sep := ψ_V''.comp (algebraMap B_V' L_V')
    let i_Sigma : B_Sigma →+* Ω_sep := ψ_Sigma'.toRingHom.comp (algebraMap B_Sigma L_Sigma)
    have hi_comm : i_V'.comp (algebraMap R₀ B_V') =
        (i_Sigma.comp (algebraMap R₀_k B_Sigma)).comp j_R₀k := by
      apply RingHom.ext
      intro r
      apply Subtype.ext
      change ψ_V' (algebraMap B_V' L_V' (algebraMap R₀ B_V' r)) =
        ψ_Sigma (algebraMap B_Sigma L_Sigma (algebraMap R₀_k B_Sigma (j_R₀k r)))
      rw [← IsScalarTower.algebraMap_apply R₀ B_V' L_V',
        IsScalarTower.algebraMap_apply R₀ (RatFunc F) L_V', hψ_V'_RF, hj_RF_eq r,
        ← IsScalarTower.algebraMap_apply R₀_k B_Sigma L_Sigma,
        IsScalarTower.algebraMap_apply R₀_k K_k L_Sigma, ψ_Sigma.commutes]
    refine ⟨hDom_R₀, ⟨instAlg_R₀, hFrac_R₀, hST_R₀_LV'⟩,
      ⟨Ω_sep, inferInstance, i_V', i_Sigma, hi_comm, ?_⟩⟩
    
    intro hHyp
    let F_Sigma : IntermediateField K_k Ω_sep := ψ_Sigma'.fieldRange
    have hM_in_FSigma : ∀ m : M_r, ψ_M' m ∈ F_Sigma := by
      intro m
      rw [← InfiniteGalois.fixedField_fixingSubgroup F_Sigma,
        IntermediateField.mem_fixedField_iff]
      intro γ hγ_mem
      have hγ_Sigma : γ.toRingEquiv.toRingHom.comp i_Sigma = i_Sigma := by
        apply RingHom.ext
        intro b_s
        exact (IntermediateField.mem_fixingSubgroup_iff F_Sigma γ).mp hγ_mem
          (ψ_Sigma' (algebraMap B_Sigma L_Sigma b_s)) ⟨algebraMap B_Sigma L_Sigma b_s, rfl⟩
      have h_stab : ∀ y : L_V', ∃ a : L_V', ψ_V'' a = γ (ψ_V'' y) := by
        intro y
        let P_y := minpoly (RatFunc F) y
        let Q_y : Polynomial K_k := P_y.map j_RF
        have h_splits : (P_y.map (algebraMap (RatFunc F) L_V')).Splits :=
          Normal.splits (inferInstance : Normal (RatFunc F) L_V') y
        obtain ⟨m_roots, hm_roots⟩ := Polynomial.splits_iff_exists_multiset.mp h_splits
        have hlc : (P_y.map (algebraMap (RatFunc F) L_V')).leadingCoeff = 1 :=
          ((minpoly.monic (Algebra.IsIntegral.isIntegral y)).map _).leadingCoeff
        rw [hlc, Polynomial.C_1, one_mul] at hm_roots
        have heval_y : Polynomial.aeval (ψ_V'' y) Q_y = 0 := by
          dsimp only [Q_y]
          rw [Polynomial.aeval_def, Polynomial.eval₂_map]
          have hcomp : (algebraMap K_k Ω_sep).comp j_RF =
              ψ_V''.comp (algebraMap (RatFunc F) L_V') :=
            RingHom.ext fun q => (hψ_V''_RF q).symm
          rw [hcomp, ← Polynomial.hom_eval₂, ← Polynomial.aeval_def, minpoly.aeval, map_zero]
        have heval_γy : Polynomial.aeval (γ (ψ_V'' y)) Q_y = 0 := by
          rw [Polynomial.aeval_algHom_apply, heval_y, map_zero]
        let ev_z : Polynomial L_V' →+* Ω_sep :=
          Polynomial.eval₂RingHom ψ_V'' (γ (ψ_V'' y))
        have hev_lhs : ev_z (P_y.map (algebraMap (RatFunc F) L_V')) = 0 := by
          change Polynomial.eval₂ ψ_V'' (γ (ψ_V'' y)) (P_y.map (algebraMap (RatFunc F) L_V')) = 0
          rw [Polynomial.eval₂_map]
          have hcomp : ψ_V''.comp (algebraMap (RatFunc F) L_V') =
              (algebraMap K_k Ω_sep).comp j_RF :=
            RingHom.ext hψ_V''_RF
          rw [hcomp, ← Polynomial.eval₂_map, ← Polynomial.aeval_def]
          exact heval_γy
        rw [hm_roots, map_multiset_prod, Multiset.map_map] at hev_lhs
        have hz_mem : (0 : Ω_sep) ∈
            Multiset.map (⇑ev_z ∘ fun x => Polynomial.X - Polynomial.C x) m_roots :=
          Multiset.prod_eq_zero_iff.mp hev_lhs
        obtain ⟨a, _, ha_eq⟩ := Multiset.mem_map.mp hz_mem
        refine ⟨a, ?_⟩
        change Polynomial.eval₂ ψ_V'' (γ (ψ_V'' y)) (Polynomial.X - Polynomial.C a) = 0 at ha_eq
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at ha_eq
        exact (sub_eq_zero.mp ha_eq).symm
      let σ'_fn : L_V' → L_V' := fun y => Classical.choose (h_stab y)
      have hσ'_fn : ∀ y : L_V', ψ_V'' (σ'_fn y) = γ (ψ_V'' y) :=
        fun y => Classical.choose_spec (h_stab y)
      have hψ_V''_inj : Function.Injective ψ_V'' := ψ_V''.injective
      let σ'_hom : L_V' →ₐ[RatFunc F] L_V' :=
        { toFun := σ'_fn
          map_one' := hψ_V''_inj (by rw [hσ'_fn, map_one, map_one])
          map_mul' := fun x y =>
            hψ_V''_inj (by rw [hσ'_fn, map_mul, map_mul, map_mul, hσ'_fn, hσ'_fn])
          map_zero' := hψ_V''_inj (by rw [hσ'_fn, map_zero, map_zero])
          map_add' := fun x y =>
            hψ_V''_inj (by rw [hσ'_fn, map_add, map_add, map_add, hσ'_fn, hσ'_fn])
          commutes' := fun q => hψ_V''_inj (by rw [hσ'_fn, hψ_V''_RF, γ.commutes]) }
      have hσ'_bij : Function.Bijective σ'_hom :=
        ⟨σ'_hom.toRingHom.injective,
          (LinearMap.injective_iff_surjective (f := σ'_hom.toLinearMap)).mp
            σ'_hom.toRingHom.injective⟩
      let σ'_L : L_V' ≃ₐ[RatFunc F] L_V' := AlgEquiv.ofBijective σ'_hom hσ'_bij
      let e_IC : B_V' ≃ₐ[R₀] ↥(integralClosure R₀ L_V') :=
        IsIntegralClosure.equiv R₀ B_V' L_V' ↥(integralClosure R₀ L_V')
      let σ' : B_V' ≃ₐ[R₀] B_V' :=
        (e_IC.trans (AlgEquiv.mapIntegralClosure (σ'_L.restrictScalars R₀))).trans e_IC.symm
      have hσ'_L_B : ∀ b' : B_V',
          algebraMap B_V' L_V' (σ' b') = σ'_L (algebraMap B_V' L_V' b') := by
        intro b'
        have h1 := IsIntegralClosure.algebraMap_equiv R₀ B_V' L_V' ↥(integralClosure R₀ L_V') (σ' b')
        have h2 := IsIntegralClosure.algebraMap_equiv R₀ B_V' L_V' ↥(integralClosure R₀ L_V') b'
        change (↑(e_IC (σ' b')) : L_V') = algebraMap B_V' L_V' (σ' b') at h1
        change (↑(e_IC b') : L_V') = algebraMap B_V' L_V' b' at h2
        rw [← h1, ← h2]
        dsimp only [σ']
        simp only [AlgEquiv.trans_apply, e_IC.apply_symm_apply]
        exact AlgEquiv.coe_mapIntegralClosure (σ'_L.restrictScalars R₀) (e_IC b')
      have hγ_V' : γ.toRingEquiv.toRingHom.comp i_V' = i_V'.comp σ'.toRingHom := by
        apply RingHom.ext
        intro b'
        change γ (ψ_V'' (algebraMap B_V' L_V' b')) = ψ_V'' (algebraMap B_V' L_V' (σ' b'))
        rw [hσ'_L_B b']
        exact (hσ'_fn (algebraMap B_V' L_V' b')).symm
      have hσ'_fix : ∀ b : B_r, σ' (ι_rc b) = ι_rc b :=
        hHyp σ' ⟨γ.toRingEquiv, hγ_Sigma, hγ_V'⟩
      have hBk_fix : ∀ x : B_k,
          γ (ψ_M' (algebraMap B_k M_r x)) = ψ_M' (algebraMap B_k M_r x) := by
        intro x
        have hx : x ∈ Algebra.adjoin R₀_k (Set.range j_Bk) := by
          rw [hj_Bk_adjoin]
          exact Algebra.mem_top
        induction hx using Algebra.adjoin_induction with
        | mem z hz =>
          rcases hz with ⟨b, rfl⟩
          have h_align_b : ψ_M' (algebraMap B_k M_r (j_Bk b)) = i_V' (ι_rc b) := by
            apply Subtype.ext
            change ψ_M (algebraMap B_k M_r (j_Bk b)) = ψ_V' (algebraMap B_V' L_V' (ι_rc b))
            rw [← hj_LM_B b, ← hψ_V'_Lr (algebraMap B_r L_r b), hi_Lr_B b]
          rw [h_align_b]
          calc γ (i_V' (ι_rc b))
              = i_V' (σ' (ι_rc b)) := congrFun (congrArg DFunLike.coe hγ_V') (ι_rc b)
            _ = i_V' (ι_rc b) := by rw [hσ'_fix b]
        | algebraMap r_k =>
          rw [← IsScalarTower.algebraMap_apply R₀_k B_k M_r,
            IsScalarTower.algebraMap_apply R₀_k K_k M_r, ψ_M'.commutes, γ.commutes]
        | add u v _ _ ihu ihv =>
          rw [map_add, map_add, map_add, ihu, ihv]
        | mul u v _ _ ihu ihv =>
          rw [map_mul, map_mul, map_mul, ihu, ihv]
      obtain ⟨x_num, y_den, _, hdiv⟩ := IsFractionRing.div_surjective B_k m
      rw [← hdiv, map_div₀, map_div₀, hBk_fix x_num, hBk_fix y_den]
    have hψ_Sigma'_inj : Function.Injective ψ_Sigma' := ψ_Sigma'.injective
    let ι_M_fn : M_r → L_Sigma := fun m => Classical.choose (hM_in_FSigma m)
    have hι_M_fn : ∀ m : M_r, ψ_Sigma' (ι_M_fn m) = ψ_M' m :=
      fun m => Classical.choose_spec (hM_in_FSigma m)
    exact ⟨{
      toFun := ι_M_fn
      map_one' := hψ_Sigma'_inj (by rw [hι_M_fn, map_one, map_one])
      map_mul' := fun x y => hψ_Sigma'_inj (by rw [hι_M_fn, map_mul, map_mul, hι_M_fn, hι_M_fn])
      map_zero' := hψ_Sigma'_inj (by rw [hι_M_fn, map_zero, map_zero])
      map_add' := fun x y => hψ_Sigma'_inj (by rw [hι_M_fn, map_add, map_add, hι_M_fn, hι_M_fn])
      commutes' := fun q => hψ_Sigma'_inj (by rw [hι_M_fn, ψ_Sigma'.commutes, ψ_M'.commutes])
    }⟩

  obtain ⟨hDom_R₀, ⟨instAlg_R₀, hFrac_R₀, hST_R₀_LV'⟩,
    ⟨Ω_sep, hFld_Ω, i_V', i_Sigma, hi_comm, hAlign⟩⟩ := h_s6
  have : IsDomain R₀ := hDom_R₀
  let _ : Algebra R₀ (RatFunc F) := instAlg_R₀
  have : IsFractionRing R₀ (RatFunc F) := hFrac_R₀
  have : IsScalarTower R₀ (RatFunc F) L_V' := hST_R₀_LV'
  let _ : Field Ω_sep := hFld_Ω

  
  
  
  let U := U₀.toScheme
  let V_r' := AlgebraicGeometry.Spec (CommRingCat.of B_V')
  let π_r' : V_r' ⟶ U :=
    CategoryTheory.CategoryStruct.comp
