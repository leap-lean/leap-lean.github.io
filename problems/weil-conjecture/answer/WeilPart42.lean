theorem weil_mid_dev_net_p2_smooth_monodromy_and_odp_tameness (F : Type u) [Finite F] [Field F]
    (m : ℕ)
    (Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    [AlgebraicGeometry.GeometricallyIrreducible Z₁.hom]
    [AlgebraicGeometry.IsProper Z₁.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 2) Z₁.hom]
    (P : WeilRationalLefschetzPencil F m Z₁)
    (j_aff : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial F)) ⟶
      (weilProjectiveSpaceOver F 1).left)
    (s_inf : AlgebraicGeometry.Spec (CommRingCat.of F) ⟶ (weilProjectiveSpaceOver F 1).left)
    (S_aff : Finset F)
    (U₀ : (weilProjectiveSpaceOver F 1).left.Opens)
    (C_disc : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of F)))
    (ι_disc : C_disc ⟶ weilProjectiveSpaceOver F 2)
    (U_disc_reg : C_disc.left.Opens)
    (hSing : WeilTransvTriIsSingularDatum F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc U_disc_reg)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar F)
    (r' : ℕ)
    (a : F) (_ha : a ∈ S_aff)
    (k : Type u) [Field k] [IsAlgClosed k] [Algebra F k] [Algebra.IsAlgebraic F k]
    (S_aff_k : Finset k)
    (Δ_F : Polynomial F) (Δ_k : Polynomial k)
    (R₀ : Type u) [CommRing R₀] [Algebra (Polynomial F) R₀]
    (R₀_k : Type u) [CommRing R₀_k] [Algebra k R₀_k] [Algebra (Polynomial k) R₀_k]
    [IsScalarTower k (Polynomial k) R₀_k]
    (_hR₀ : IsLocalization.Away Δ_F R₀)
    (_hR₀_k : IsLocalization.Away Δ_k R₀_k) :
    (∀ x : k, x ∈ S_aff_k ↔ ∃ s ∈ S_aff, algebraMap F k s = x) →
    Δ_F = (∏ s ∈ S_aff, (Polynomial.X - Polynomial.C s : Polynomial F)) →
    Δ_k = (∏ s_k ∈ S_aff_k, (Polynomial.X - Polynomial.C s_k : Polynomial k)) →
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    ∃ (d_Sigma d_disc : ℕ)
      (H_Sigma F_disc_hom : MvPolynomial (Fin 3) k)
      (P₀ P₁ P₂ : Polynomial k)
      (L₂ : Type u)
      (_ : Field L₂)
      (_ : Algebra K₂ L₂)
      (_ : FiniteDimensional K₂ L₂)
      (_ : IsGalois K₂ L₂),
      1 ≤ d_Sigma ∧ 1 ≤ d_disc ∧
      H_Sigma.IsHomogeneous d_Sigma ∧ F_disc_hom.IsHomogeneous d_disc ∧
      P₀.Monic ∧ P₀.natDegree = d_Sigma ∧ P₁.natDegree ≤ d_Sigma ∧ P₂.natDegree ≤ d_Sigma ∧
      Irreducible (eval_c 0 H_Sigma) ∧ Irreducible (eval_c 0 F_disc_hom) ∧
      MvPolynomial.eval₂ Polynomial.C ![P₀, P₁, P₂] H_Sigma = 0 ∧
      (∀ (c : Fin 3) (p : Fin 2 → k),
        MvPolynomial.eval p (eval_c c H_Sigma) = 0 →
        MvPolynomial.eval p (MvPolynomial.pderiv 0 (eval_c c H_Sigma)) ≠ 0 ∨
        MvPolynomial.eval p (MvPolynomial.pderiv 1 (eval_c c H_Sigma)) ≠ 0) ∧
      (∀ c : Fin 3,
        (![P₀, P₁, P₂] c = 0 ∧ IsUnit (eval_c c H_Sigma)) ∨
        (![P₀, P₁, P₂] c ≠ 0 ∧
          let θ_c : MvPolynomial (Fin 2) k →ₐ[k] RatFunc k :=
            MvPolynomial.aeval (fun j : Fin 2 =>
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] (c.succAbove j)) /
              algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c))
          RingHom.ker θ_c.toRingHom = Ideal.span {eval_c c H_Sigma} ∧
          Set.range θ_c =
            { f : RatFunc k | ∃ (n : ℕ) (Q : Polynomial k),
                Q.natDegree ≤ n * d_Sigma ∧
                f = algebraMap (Polynomial k) (RatFunc k) Q /
                  (algebraMap (Polynomial k) (RatFunc k) (![P₀, P₁, P₂] c)) ^ n })) ∧
      (∀ x₁' x₂' : k,
        MvPolynomial.eval ![0, x₁', x₂'] H_Sigma = 0 →
        MvPolynomial.eval ![0, x₁', x₂'] F_disc_hom = 0 →
        x₁' = 0 ∧ x₂' = 0) ∧
      (∀ p : Fin 2 → k,
        MvPolynomial.eval p (eval_c 0 H_Sigma) = 0 →
        MvPolynomial.eval p (eval_c 0 F_disc_hom) = 0 →
        MvPolynomial.eval p (MvPolynomial.pderiv 0 (eval_c 0 F_disc_hom)) *
          MvPolynomial.eval p (MvPolynomial.pderiv 1 (eval_c 0 H_Sigma)) -
        MvPolynomial.eval p (MvPolynomial.pderiv 1 (eval_c 0 F_disc_hom)) *
          MvPolynomial.eval p (MvPolynomial.pderiv 0 (eval_c 0 H_Sigma)) ≠ 0) ∧
      (∀ s_k ∈ S_aff_k,
        P₀.eval s_k ≠ 0 ∧
        MvPolynomial.eval ![P₁.eval s_k / P₀.eval s_k, P₂.eval s_k / P₀.eval s_k]
          (eval_c 0 F_disc_hom) = 0) ∧
      (∀ b : k,
        P₀.eval b ≠ 0 →
        MvPolynomial.eval ![P₁.eval b / P₀.eval b, P₂.eval b / P₀.eval b]
          (eval_c 0 F_disc_hom) = 0 →
        b ∈ S_aff_k) ∧
      (MvPolynomial.eval ![P₁.coeff d_Sigma, P₂.coeff d_Sigma] (eval_c 0 F_disc_hom) = 0 ∧
        MvPolynomial.eval ![P₁.coeff d_Sigma, P₂.coeff d_Sigma] (eval_c 0 H_Sigma) = 0) ∧
      (∀ b : k,
        P₀.eval b = 0 →
        Δ_k.eval b ≠ 0 ∧
        (P₁.eval b ≠ 0 ∨ P₂.eval b ≠ 0) ∧
        MvPolynomial.eval ![0, P₁.eval b, P₂.eval b] F_disc_hom ≠ 0) ∧
      (∀ (c : Fin 3) (H_D : MvPolynomial (Fin 2) k),
        Irreducible H_D →
        eval_c c F_disc_hom ∉ Ideal.span {H_D} →
        letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
          ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
        let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
        ∀ (Q : Ideal ↥B₂_c) [Q.IsPrime],
          Ideal.comap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c) Q = Ideal.span {H_D} →
          Algebra.IsUnramifiedAt (MvPolynomial (Fin 2) k) Q) ∧
      (letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
         ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
       let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
       ∀ (Q_C : Ideal ↥B₂_0), Q_C.IsPrime →
         Ideal.comap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0) Q_C =
           Ideal.span {eval_c 0 F_disc_hom} →
         ringChar k = 0 ∨
         Nat.Coprime (ringChar k)
           (Nat.card { σ : L₂ ≃ₐ[K₂] L₂ //
             ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0) })) ∧
      ((∀ c : Fin 3,
          letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
            ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
          let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
          (Localization.awayMap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c)
            (eval_c c F_disc_hom)).Etale) →
        ∀ (j_R₀k : R₀ →+* R₀_k),
          j_R₀k.comp (algebraMap (Polynomial F) R₀) =
            (algebraMap (Polynomial k) R₀_k).comp (Polynomial.mapRingHom (algebraMap F k)) →
          ∀ (e_U : CategoryTheory.Iso (AlgebraicGeometry.Spec (CommRingCat.of R₀)) U₀.toScheme),
            CategoryTheory.CategoryStruct.comp e_U.hom U₀.ι =
              CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial F) R₀)))
                j_aff →
            ∀ (B_Sigma L_Sigma : Type u) [CommRing B_Sigma] [IsDomain B_Sigma] [Field L_Sigma]
              [Algebra k B_Sigma] [Algebra (Polynomial k) B_Sigma] [Algebra R₀_k B_Sigma]
              [Algebra k L_Sigma] [Algebra (Polynomial k) L_Sigma] [Algebra (RatFunc k) L_Sigma]
              [Algebra B_Sigma L_Sigma] [Algebra R₀_k L_Sigma]
              [IsScalarTower k (Polynomial k) B_Sigma]
              [IsScalarTower (Polynomial k) R₀_k B_Sigma]
              [IsScalarTower k (RatFunc k) L_Sigma]
              [IsScalarTower (Polynomial k) (RatFunc k) L_Sigma]
              [IsScalarTower (Polynomial k) B_Sigma L_Sigma]
              [IsScalarTower R₀_k B_Sigma L_Sigma]
              [Module.Finite R₀_k B_Sigma] [Algebra.Etale R₀_k B_Sigma]
              [IsFractionRing B_Sigma L_Sigma] [IsIntegralClosure B_Sigma R₀_k L_Sigma]
              [FiniteDimensional (RatFunc k) L_Sigma] [IsGalois (RatFunc k) L_Sigma],
              (letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
                 ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
               let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
               let f_B0 : ↥B₂_0 :=
                 algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0 (eval_c 0 F_disc_hom)
               let p₀_BSigma : B_Sigma :=
                 algebraMap R₀_k B_Sigma (algebraMap (Polynomial k) R₀_k P₀)
               let ι_B0 : MvPolynomial (Fin 2) k →+* Localization.Away f_B0 :=
                 (algebraMap ↥B₂_0 (Localization.Away f_B0)).comp
                   (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0)
               let ι_BSigma : Polynomial k →+* Localization.Away p₀_BSigma :=
                 (algebraMap B_Sigma (Localization.Away p₀_BSigma)).comp
                   ((algebraMap R₀_k B_Sigma).comp (algebraMap (Polynomial k) R₀_k))
               ∃ ψ_0 : Localization.Away f_B0 →+* Localization.Away p₀_BSigma,
                 (∀ c₀ : k, ψ_0 (ι_B0 (MvPolynomial.C c₀)) = ι_BSigma (Polynomial.C c₀)) ∧
                 ψ_0 (ι_B0 (MvPolynomial.X 0)) * ι_BSigma P₀ = ι_BSigma P₁ ∧
                 ψ_0 (ι_B0 (MvPolynomial.X 1)) * ι_BSigma P₀ = ι_BSigma P₂) →
              ∃ A_triv : AddCommGrpCat.{u},
                Finite ↥A_triv ∧
                WeilIsEtaleSheafPullback
                  (CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map
                      (CommRingCat.ofHom ((algebraMap R₀_k B_Sigma).comp j_R₀k)))
                    e_U.hom)
                  (weilMidDevOpenHigherDirectImage F P.f₀ U₀ ℓ (2 * m + 1) r')
                  ((CategoryTheory.constantSheaf
                    (AlgebraicGeometry.Spec (CommRingCat.of B_Sigma)).smallEtaleTopology
                    AddCommGrpCat.{u}).obj A_triv)) :=
by
  intro hS_aff_k hΔ_F hΔ_k K₂ x₁ x₂ homCoord eval_c φ_K₂
  have hAlgClosedMemRange : ∀ (ξ : RatFunc k) (n : ℕ) (g : Polynomial k),
      g.natDegree ≤ n → g ≠ 0 → Polynomial.aeval ξ g = 0 →
      ξ ∈ Set.range (algebraMap k (RatFunc k)) := by
    intro ξ n
    induction n with
    | zero =>
      intro g hdeg hg_ne h_ev
      have hdeg0 : g.natDegree = 0 := Nat.eq_zero_of_le_zero hdeg
      rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg0] at hg_ne h_ev
      rw [Polynomial.aeval_C] at h_ev
      have hc_ne : g.coeff 0 ≠ 0 := fun hc => hg_ne (by rw [hc, map_zero])
      exact False.elim (hc_ne ((algebraMap k (RatFunc k)).injective (h_ev.trans (map_zero _).symm)))
    | succ n ih =>
      intro g hdeg hg_ne h_ev
      by_cases hle : g.natDegree ≤ n
      · exact ih g hle hg_ne h_ev
      · have hpos : 0 < g.natDegree := by omega
        have hdeg_ne : g.degree ≠ 0 := ne_of_gt (Polynomial.natDegree_pos_iff_degree_pos.mp hpos)
        obtain ⟨r, hr⟩ := IsAlgClosed.exists_root g hdeg_ne
        obtain ⟨q, hq_eq⟩ := Polynomial.dvd_iff_isRoot.mpr hr
        have hXr_ne : (Polynomial.X - Polynomial.C r : Polynomial k) ≠ 0 :=
          (Polynomial.monic_X_sub_C r).ne_zero
        have hq_ne : q ≠ 0 := fun h0 => hg_ne (by rw [hq_eq, h0, mul_zero])
        have hdeg_sum : g.natDegree = 1 + q.natDegree := by
          rw [hq_eq, Polynomial.natDegree_mul hXr_ne hq_ne, Polynomial.natDegree_X_sub_C]
        have hq_deg : q.natDegree ≤ n := by omega
        rw [hq_eq, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C] at h_ev
        rcases mul_eq_zero.mp h_ev with hlin | hq_ev
        · exact ⟨r, (sub_eq_zero.mp hlin).symm⟩
        · exact ih q hq_deg hq_ne hq_ev
  have hAwayLift : ∀ {A B : Type u} [CommRing A] [CommRing B]
      (x : A) (g : A →+* B), IsUnit (g x) →
      ∃ φ : Localization.Away x →+* B,
        ∀ a : A, φ (algebraMap A (Localization.Away x) a) = g a := by
    intro A B _ _ x g hx
    exact ⟨IsLocalization.Away.lift x hx, fun a => IsLocalization.Away.lift_eq x hx a⟩
  have hFracLiftAutFix : ∀ {R₂ K₀ B₀ L₀ Ω₀ : Type u}
      [CommRing R₂] [IsDomain R₂] [Field K₀] [CommRing B₀] [IsDomain B₀] [Field L₀] [Field Ω₀]
      [Algebra R₂ K₀] [IsFractionRing R₂ K₀]
      [Algebra R₂ B₀] [Algebra B₀ L₀] [Algebra R₂ L₀] [Algebra K₀ L₀]
      [IsScalarTower R₂ B₀ L₀] [IsScalarTower R₂ K₀ L₀]
      [IsFractionRing B₀ L₀]
      (ι_R : R₂ →+* Ω₀) (_hι_inj : Function.Injective ι_R),
      ∃ ψ_Ω : K₀ →+* Ω₀,
        ψ_Ω.comp (algebraMap R₂ K₀) = ι_R ∧
        ∀ (β_B0 : B₀ →+* Ω₀),
          β_B0.comp (algebraMap R₂ B₀) = ι_R →
          Function.Injective β_B0 →
          ∃ i_L : L₀ →+* Ω₀,
            i_L.comp (algebraMap K₀ L₀) = ψ_Ω ∧
            ∀ (γ : Ω₀ ≃+* Ω₀),
              (∀ r : R₂, γ (ι_R r) = ι_R r) →
              (∀ b : B₀, γ (β_B0 b) = β_B0 b) →
              (∀ x : K₀, γ (ψ_Ω x) = ψ_Ω x) ∧
              (∀ z : L₀, γ (i_L z) = i_L z) := by
    intro R₂ K₀ B₀ L₀ Ω₀ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ι_R hι_inj
    let ψ_Ω : K₀ →+* Ω₀ := IsFractionRing.lift hι_inj
    have hψ_Ω : ψ_Ω.comp (algebraMap R₂ K₀) = ι_R := by
      apply RingHom.ext
      intro r
      exact IsFractionRing.lift_algebraMap hι_inj r
    refine ⟨ψ_Ω, hψ_Ω, fun β_B0 hβ_R hβ_inj => ?_⟩
    let i_L : L₀ →+* Ω₀ := IsFractionRing.lift hβ_inj
    have hi_B0 : i_L.comp (algebraMap B₀ L₀) = β_B0 := by
      apply RingHom.ext
      intro b
      exact IsFractionRing.lift_algebraMap hβ_inj b
    have hi_K₀ : i_L.comp (algebraMap K₀ L₀) = ψ_Ω := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors R₂)
      rw [RingHom.comp_assoc, ← IsScalarTower.algebraMap_eq R₂ K₀ L₀,
        IsScalarTower.algebraMap_eq R₂ B₀ L₀,
        ← RingHom.comp_assoc, hi_B0, hβ_R, hψ_Ω]
    refine ⟨i_L, hi_K₀, fun γ hγ_R hγ_B0 => ?_⟩
    have hγ_K₀ : ∀ x : K₀, γ (ψ_Ω x) = ψ_Ω x := by
      have heq : γ.toRingHom.comp ψ_Ω = ψ_Ω := by
        apply IsLocalization.ringHom_ext (nonZeroDivisors R₂)
        apply RingHom.ext
        intro r
        have hr : ψ_Ω (algebraMap R₂ K₀ r) = ι_R r := RingHom.congr_fun hψ_Ω r
        change γ (ψ_Ω (algebraMap R₂ K₀ r)) = ψ_Ω (algebraMap R₂ K₀ r)
        rw [hr, hγ_R r]
      intro x
      exact RingHom.congr_fun heq x
