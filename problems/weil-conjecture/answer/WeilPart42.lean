            ext Z₀ : 2
            apply CategoryTheory.Limits.Sigma.hom_ext
            intro σ
            dsimp [L_pre]
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Limits.Sigma.ι_map_assoc,
