        refine ⟨⟨ι_S (w.1 * u_B g), hc_not_𝔫⟩, ?_⟩
        change ι_S (w.1 * u_B g) * x₁ = ι_S (w.1 * u_B g) * x₂
        rw [← sub_eq_zero, ← mul_sub]
        calc ι_S (w.1 * u_B g) * (x₁ - x₂)
            = ι_S w.1 * (ι_S (u_B g) * z) := by rw [map_mul]; dsimp [z]; ring
          _ = ι_S w.1 * ι_S b := by rw [hgz]
