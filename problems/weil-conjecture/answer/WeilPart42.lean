    intro X S u hu
    let M_u : X.Etale ⥤ S.Etale := CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hu
    have hCompat : CategoryTheory.CompatiblePreserving S.smallEtaleTopology M_u := by
      refine ⟨fun ℱ {Z₀} {T} {x} hx {Y₁ Y₂} {W_ov} f₁ f₂ {g₁} {g₂} hg₁ hg₂ hcomm => ?_⟩
      have hf_left : f₁.left ≫ g₁.left = f₂.left ≫ g₂.left :=
        congrArg (fun m => m.left) hcomm
      have hw₁ : (f₁.left ≫ Y₁.hom) ≫ u = W_ov.hom :=
        (Category.assoc _ _ _).trans (CategoryTheory.MorphismProperty.Over.w f₁)
      have het_w : P_et (f₁.left ≫ Y₁.hom) :=
        CategoryTheory.MorphismProperty.of_postcomp P_et (f₁.left ≫ Y₁.hom) u hu
          (hw₁.symm ▸ W_ov.prop)
      let W' : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f₁.left ≫ Y₁.hom) het_w
      have hw₂ : f₂.left ≫ Y₂.hom = f₁.left ≫ Y₁.hom :=
        (congrArg (f₂.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₂).symm).trans
          ((Category.assoc f₂.left g₂.left Z₀.hom).symm.trans
            ((congrArg (· ≫ Z₀.hom) hf_left.symm).trans
              ((Category.assoc f₁.left g₁.left Z₀.hom).trans
                (congrArg (f₁.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w g₁)))))
      let f₁_lift : W' ⟶ Y₁ := CategoryTheory.MorphismProperty.Over.homMk f₁.left rfl trivial
      let f₂_lift : W' ⟶ Y₂ := CategoryTheory.MorphismProperty.Over.homMk f₂.left hw₂ trivial
      have hcomm_lift : f₁_lift ≫ g₁ = f₂_lift ≫ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hf_left
      have hx_eq := hx f₁_lift f₂_lift hg₁ hg₂ hcomm_lift
      let ε_W : W_ov ⟶ M_u.obj W' :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 W_ov.left)
          ((Category.id_comp _).trans hw₁) trivial
      have hε₁ : ε_W ≫ M_u.map f₁_lift = f₁ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (Category.id_comp f₁.left)
      have hε₂ : ε_W ≫ M_u.map f₂_lift = f₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext (Category.id_comp f₂.left)
      have hmap := congrArg (ConcreteCategory.hom (ℱ.obj.map ε_W.op)) hx_eq
      dsimp [Functor.comp] at hmap ⊢
      have hm1 : (ConcreteCategory.hom (ℱ.obj.map ε_W.op))
          ((ConcreteCategory.hom (ℱ.obj.map (M_u.map f₁_lift).op)) (x g₁ hg₁)) =
          (ConcreteCategory.hom (ℱ.obj.map f₁.op)) (x g₁ hg₁) := by
        rw [← hε₁, op_comp, ℱ.obj.map_comp]
