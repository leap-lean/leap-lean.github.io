        hInjHdiZero h I_sh inferInstance k
      rcases (hBase.2.2.2 h SC hSE).2 k with ⟨_, h₂_h, _, _, hEx₂_h, hEx₃_h⟩
      have h_ιh_zero : weilEtaleHigherDirectImageMap h (k + 1) SC.f = 0 :=
