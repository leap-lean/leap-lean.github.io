      have hψ_sm_C : ψ_sm.comp MvPolynomial.C = ι_S := by
        ext c
        change ψ_sm0 (Ideal.Quotient.mk _ (MvPolynomial.C c)) = ι_S c
        exact RingHom.congr_fun hψ_sm0_ι c
      have hε_sm : (ε₀.comp ψ_sm).comp MvPolynomial.C = RingHom.id κ := by
        rw [RingHom.comp_assoc, hψ_sm_C, hε_ι]
