        (weilEtaleTorsionSheaf U m₀)).symm η_u = πM₀ :=
      Equiv.symm_apply_apply _ πM₀
    rw [← hsymm, CategoryTheory.Adjunction.homEquiv_counit]
  have hFactor : ∀ x : weilEtaleTorsionH X m₀ (n + 1),
      p_u x = leray_u (weilEtaleTorsionSheaf U m₀) (n + 1)
        (x.comp (CategoryTheory.Abelian.Ext.mk₀ η_u) (Nat.add_zero (n + 1))) := by
    intro x
    have hp_fold : p_u x =
        ((CategoryTheory.Abelian.Ext.mk₀ ι'ℤ).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u x) (Nat.zero_add (n + 1))).comp
