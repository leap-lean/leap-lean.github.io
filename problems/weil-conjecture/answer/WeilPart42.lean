      obtain ⟨β_Q, hβ_Q⟩ := (hBC.1 Q_sh k).1
      let μ_I := (adj_w.homEquiv _ _).symm β_I
      let μ_Q := (adj_w.homEquiv _ _).symm β_Q
      let μ_F := (adj_w.homEquiv _ _).symm β
