      (M.obj.map (Opposite.op π_T)).hom m
    let z : ↥((pb_x₀.obj (pf_x₀.obj M)).obj.obj (Opposite.op T_κ)) :=
      ((pb_x₀.obj (pf_x₀.obj M)).obj.map (Opposite.op τ_T)).hom
        (((adj_x₀.unit.app (pf_x₀.obj M)).hom.app (Opposite.op T_X)).hom s)
    refine ⟨z, ?_⟩
    have h1 : (ε_M.hom.app (Opposite.op T_κ)).hom z = (M.obj.map (Opposite.op τ_T)).hom s :=
