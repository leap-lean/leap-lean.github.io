        let gen_V : MvPolynomial (Fin (m + 1) × Fin 2) ↥V_0 :=
          (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h_V
        let I_V : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) ↥V_0) := Ideal.span {gen_V}
        have hmap_gen : ∀ (e : ↥V_0 →+* ↥V_0), e h_V = h_V →
            MvPolynomial.map e gen_V = gen_V := by
