  let y : S_Ω ⟶ V₀ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom i₀)
  let fst_Ω := CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω
  let f_Ω := CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω
  let ℛ_Ω := weilEtaleHigherDirectImage f_Ω d_rel (weilEtaleTorsionSheaf Y_Ω m₀)
  let ι_y : Y_Ω ⟶ Y_L₀ :=
    CategoryTheory.Limits.pullback.lift fst_Ω (f_Ω ≫ y)
      (by rw [CategoryTheory.Category.assoc]; exact CategoryTheory.Limits.pullback.condition)
  have h_ι_fst : ι_y ≫ fst_L₀ = fst_Ω := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have h_sq_y : ι_y ≫ g_L₀ = f_Ω ≫ y := CategoryTheory.Limits.pullback.lift_snd _ _ _
  obtain ⟨β_y, hβ_y⟩ :=
    ((hBCBase.2.2.1 g_L₀ y f_Ω ι_y h_sq_y).1 (weilEtaleTorsionSheaf Y_L₀ m₀) d_rel).1
  let c_y := β_y ≫
    ((weilEtaleSitePullback y).sheafPushforwardContinuous
      AddCommGrpCat.{u} V₀.smallEtaleTopology S_Ω.smallEtaleTopology).map
      (weilEtaleHigherDirectImageMap f_Ω d_rel
        (weilEtaleConstPullbackHom ι_y
          (weilEtaleIdTerminalIsTerminal.{u} Y_Ω)
          (weilEtaleIdTerminalIsTerminal.{u} Y_L₀) AM))
  have hc_y : WeilIsSingDevAlgBCConstPush g_L₀ y f_Ω ι_y h_sq_y AM d_rel c_y :=
    ⟨β_y, hβ_y, rfl⟩
  have hPb_L₀ : CategoryTheory.IsPullback fst_L₀ g_L₀ g₂_k.left η_L₀ :=
    CategoryTheory.IsPullback.of_hasPullback g₂_k.left η_L₀
  have hPb_Ω : CategoryTheory.IsPullback fst_Ω f_Ω g₂_k.left η_Ω :=
    CategoryTheory.IsPullback.of_hasPullback g₂_k.left η_Ω
  obtain ⟨β_L₀, hβ_L₀⟩ :=
    ((hBCBase.2.2.1 g₂_k.left η_L₀ g_L₀ fst_L₀ hPb_L₀.w).1
      (weilEtaleTorsionSheaf Y₂_k.left m₀) d_rel).1
  obtain ⟨β_Ω, hβ_Ω⟩ :=
    ((hBCBase.2.2.1 g₂_k.left η_Ω f_Ω fst_Ω hPb_Ω.w).1
      (weilEtaleTorsionSheaf Y₂_k.left m₀) d_rel).1
  have hIso_β_L₀ : CategoryTheory.IsIso
      ((((weilEtaleSitePullback η_L₀).sheafAdjunctionContinuous
        AddCommGrpCat.{u} S₂.left.smallEtaleTopology V₀.smallEtaleTopology).homEquiv
        _ _).symm β_L₀) :=
    hBCPullPrimePower ℓ g₂_k.left η_L₀ g_L₀ fst_L₀ hPb_L₀.w
      (fun q {bc₀} hbc₀ =>
        hPBC_k k ℓ hℓ_k Y₂_k S₂ g₂_k η_L₀ g_L₀ fst_L₀ hPb_L₀
          (weilEtaleTorsionSheaf Y₂_k.left (ℓ ^ 1)) hTor_1 q hbc₀)
      r' d_rel hβ_L₀
  have hIso_β_Ω : CategoryTheory.IsIso
      ((((weilEtaleSitePullback η_Ω).sheafAdjunctionContinuous
        AddCommGrpCat.{u} S₂.left.smallEtaleTopology S_Ω.smallEtaleTopology).homEquiv
        _ _).symm β_Ω) :=
    hBCPullPrimePower ℓ g₂_k.left η_Ω f_Ω fst_Ω hPb_Ω.w
      (fun q {bc₀} hbc₀ =>
        hPBC_k k ℓ hℓ_k Y₂_k S₂ g₂_k η_Ω f_Ω fst_Ω hPb_Ω
          (weilEtaleTorsionSheaf Y₂_k.left (ℓ ^ 1)) hTor_1 q hbc₀)
      r' d_rel hβ_Ω
  have hIso_cy : CategoryTheory.IsIso
      ((((weilEtaleSitePullback y).sheafAdjunctionContinuous
        AddCommGrpCat.{u} V₀.smallEtaleTopology S_Ω.smallEtaleTopology).homEquiv
        ℛ_L₀ ℛ_Ω).symm c_y) :=
    h_s8 g₂_k.left η_L₀ g_L₀ fst_L₀ y f_Ω ι_y η_Ω fst_Ω
      hPb_L₀.w h_sq_y rfl h_ι_fst hPb_Ω.w AM d_rel
      hβ_L₀ hIso_β_L₀ hβ_Ω hIso_β_Ω hc_y
  obtain ⟨hT_By⟩ := hBCBase.1 y hT_V₀
  let σ_y : T_Ω ⟶ (weilEtaleSitePullback y).obj T_V₀ := hT_By.from T_Ω
  have hUnitBij :=
    (weil_outer_tr_fib_algClosed_spec_edge_and_const_eval_bijective.{u} Ω).2
      V₀ y T_V₀ hT_V₀ hT_By A_fib
  let eval_y : H₀ →+ ↑(ℛ_Ω.obj.obj (Opposite.op T_Ω)) :=
    ((ℛ_Ω.obj.map (Opposite.op σ_y)).hom).comp ((c_y.hom.app (Opposite.op T_V₀)).hom)
  have hBij_eval : Function.Bijective eval_y :=
    h_s9 y T_V₀ T_Ω hT_Ω hT_By A_fib ℛ_L₀ ℛ_Ω hConst hUnitBij c_y σ_y hIso_cy
  obtain ⟨hT_Y_Ω⟩ := hBCBase.1 f_Ω hT_Ω
  let edge_Ω : weilEtaleTorsionH Y_Ω m₀ d_rel →+ ↑(ℛ_Ω.obj.obj (Opposite.op T_Ω)) :=
    weilOuterTrFibEdgeHom f_Ω T_Ω hT_Y_Ω (weilEtaleTorsionSheaf Y_Ω m₀) d_rel
  have hBij_edge : Function.Bijective edge_Ω :=
    hSpecEdgeBij Ω f_Ω T_Ω hT_Ω hT_Y_Ω (weilEtaleTorsionSheaf Y_Ω m₀) d_rel
  let e_eval : H₀ ≃+ ↑(ℛ_Ω.obj.obj (Opposite.op T_Ω)) :=
    AddEquiv.ofBijective eval_y hBij_eval
  let e_edge : weilEtaleTorsionH Y_Ω m₀ d_rel ≃+ ↑(ℛ_Ω.obj.obj (Opposite.op T_Ω)) :=
    AddEquiv.ofBijective edge_Ω hBij_edge
  let Φ : H₀ ≃+ weilEtaleTorsionH Y_Ω m₀ d_rel := e_eval.trans e_edge.symm
  have hΦ_edge : ∀ x : H₀,
      edge_Ω (Φ x) =
        (ℛ_Ω.obj.map (Opposite.op σ_y)).hom ((c_y.hom.app (Opposite.op T_V₀)).hom x) := by
    intro x
    change edge_Ω (e_edge.symm (e_eval x)) = eval_y x
    have h1 : edge_Ω (e_edge.symm (e_eval x)) = e_edge (e_edge.symm (e_eval x)) := rfl
    rw [h1, e_edge.apply_symm_apply]
    rfl
  refine ⟨Φ, ?_⟩
  intro σ hσ γ hγ_comm α_γ hα_fst hα_snd p_γ hp_γ h
  let u_γ : S_Ω ⟶ S_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom)
  have h_base : u_γ ≫ y = y ≫ u_of σ := by
    dsimp only [u_γ, y, u_of]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    have h_ring : γ.toRingHom.comp i₀ = i₀.comp σ := RingHom.ext hγ_comm
    rw [h_ring, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
  have h_top : α_γ ≫ ι_y = ι_y ≫ α_of σ hσ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, h_ι_fst, hα_fst, CategoryTheory.Category.assoc,
        CategoryTheory.Limits.pullback.lift_fst, h_ι_fst]
    · rw [CategoryTheory.Category.assoc, h_sq_y, ← CategoryTheory.Category.assoc α_γ,
        hα_snd, CategoryTheory.Category.assoc, h_base, CategoryTheory.Category.assoc,
        h_sq_of σ hσ, ← CategoryTheory.Category.assoc ι_y, h_sq_y,
        CategoryTheory.Category.assoc]
  have h_edge_intertwine :
      edge_Ω (p_γ (Φ h)) = edge_Ω (Φ (Ψ σ hσ h)) :=
    (h_s10 g_L₀ f_Ω (u_of σ) (α_of σ hσ) y ι_y u_γ α_γ
      (h_sq_of σ hσ) h_sq_y hα_snd h_base h_top
      T_V₀ hT_V₀ T_Ω hT_Ω hT_Y_Ω (τ_of σ) σ_y m₀ d_rel p_γ h (Φ h)
      (hc_of σ hσ) hc_y hp_γ (hΦ_edge h)).trans (hΦ_edge (Ψ σ hσ h)).symm
  exact hBij_edge.1 h_edge_intertwine

theorem weil_net_p2_gen_monodromy_galois_fixedField_iff (K₂ L₀ : Type u) [Field K₂] [Field L₀] [Algebra K₂ L₀]
    [FiniteDimensional K₂ L₀] [IsGalois K₂ L₀]
    (H₀ : Type u) [AddCommGroup H₀]
    (ρ₀ : (L₀ ≃ₐ[K₂] L₀) →* (AddMonoid.End H₀)ˣ) :
    ∃ (L₂ : Type u)
      (_ : Field L₂)
      (_ : Algebra K₂ L₂)
      (_ : FiniteDimensional K₂ L₂)
      (_ : IsGalois K₂ L₂),
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (ψ_Ω : K₂ →+* Ω)
        (i_L : L₂ →+* Ω),
        i_L.comp (algebraMap K₂ L₂) = ψ_Ω →
        ∀ (γ : Ω ≃+* Ω),
          (∀ x : K₂, γ (ψ_Ω x) = ψ_Ω x) →
          ∃ (i₀ : L₀ →+* Ω) (σ_γ : L₀ ≃ₐ[K₂] L₀),
            i₀.comp (algebraMap K₂ L₀) = ψ_Ω ∧
            (∀ w : L₀, γ (i₀ w) = i₀ (σ_γ w)) ∧
            ((∀ z : L₂, γ (i_L z) = i_L z) ↔
              (∀ h : H₀, (ρ₀ σ_γ).val h = h)) :=
by
  let N : Subgroup (L₀ ≃ₐ[K₂] L₀) := ρ₀.ker
  let F₂ : IntermediateField K₂ L₀ := IntermediateField.fixedField N
  refine ⟨↥F₂, inferInstance, inferInstance, inferInstance, inferInstance, ?_⟩
  intro Ω _ _ ψ_Ω i_L hi_L γ hγ
  have h_i₀ : ∃ i₀ : L₀ →+* Ω,
      (∀ z : ↥F₂, i₀ z.1 = i_L z) ∧ i₀.comp (algebraMap K₂ L₀) = ψ_Ω := by
    have _ : Algebra.IsAlgebraic K₂ L₀ := Algebra.IsAlgebraic.of_finite K₂ L₀
    let _ : Algebra ↥F₂ Ω := i_L.toAlgebra
    let j : L₀ →ₐ[↥F₂] Ω := IsAlgClosed.lift
    let i₀ : L₀ →+* Ω := j.toRingHom
    have hi₀_F₂ : ∀ z : ↥F₂, i₀ z.1 = i_L z := by
      intro z
      have hz : (z : L₀) = algebraMap (↥F₂) L₀ z := (IntermediateField.algebraMap_apply F₂ z).symm
      change j (z : L₀) = i_L z
      rw [hz, j.commutes z]
      rfl
    have hi₀_K₂ : i₀.comp (algebraMap K₂ L₀) = ψ_Ω := by
      apply RingHom.ext
      intro x
      have hx : algebraMap K₂ L₀ x = (algebraMap K₂ (↥F₂) x : L₀) :=
        (IntermediateField.coe_algebraMap_apply F₂ x).symm
      change i₀ (algebraMap K₂ L₀ x) = ψ_Ω x
      rw [hx, hi₀_F₂ (algebraMap K₂ (↥F₂) x)]
      exact RingHom.congr_fun hi_L x
    exact ⟨i₀, hi₀_F₂, hi₀_K₂⟩
  obtain ⟨i₀, hi₀_F₂, hi₀_K₂⟩ := h_i₀
  let _ : Algebra K₂ Ω := ψ_Ω.toAlgebra
  let _ : Algebra L₀ Ω := i₀.toAlgebra
  have _ : IsScalarTower K₂ L₀ Ω := IsScalarTower.of_algebraMap_eq' hi₀_K₂.symm
  let γ_K : Ω ≃ₐ[K₂] Ω := AlgEquiv.ofRingEquiv (f := γ) (fun x => hγ x)
  let σ_γ : L₀ ≃ₐ[K₂] L₀ := γ_K.restrictNormal L₀
  have h_comm : ∀ w : L₀, γ (i₀ w) = i₀ (σ_γ w) := by
    intro w
    have hc := AlgEquiv.restrictNormal_commutes γ_K L₀ w
    exact hc.symm
  have h_iff : (∀ z : ↥F₂, γ (i_L z) = i_L z) ↔ (∀ h : H₀, (ρ₀ σ_γ).val h = h) := by
    have h1 : (∀ z : ↥F₂, γ (i_L z) = i_L z) ↔ (∀ z : ↥F₂, σ_γ z.1 = z.1) := by
      refine forall_congr' fun z => ?_
      rw [← hi₀_F₂ z, h_comm z.1]
      exact i₀.injective.eq_iff
    have h2 : (∀ z : ↥F₂, σ_γ z.1 = z.1) ↔ σ_γ ∈ F₂.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      exact Subtype.forall
    have h3 : σ_γ ∈ F₂.fixingSubgroup ↔ σ_γ ∈ N := by
      dsimp [F₂]
      rw [IntermediateField.fixingSubgroup_fixedField]
    have h4 : σ_γ ∈ N ↔ (∀ h : H₀, (ρ₀ σ_γ).val h = h) := by
      dsimp [N]
      rw [MonoidHom.mem_ker, Units.ext_iff, Units.val_one, DFunLike.ext_iff]
      rfl
    exact h1.trans (h2.trans (h3.trans h4))
  exact ⟨i₀, σ_γ, hi₀_K₂, h_comm, h_iff⟩

theorem weil_net_p2_generic_monodromy_galois_field (k : Type u) [Field k] [IsAlgClosed k]
    (d_rel ℓ r' : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (Y₂_k : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Y₂_k.hom]
    (g₂_k : Y₂_k ⟶ weilProjectiveSpaceOver k 2)
    [AlgebraicGeometry.IsProper g₂_k.left]
    [AlgebraicGeometry.Surjective g₂_k.left]
    (j_0 : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
      (weilProjectiveSpaceOver k 2).left)
    [AlgebraicGeometry.IsOpenImmersion j_0]
    (hj_0_hom : j_0 ≫ (weilProjectiveSpaceOver k 2).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C))
    (U₂_sm_k : (weilProjectiveSpaceOver k 2).left.Opens)
    [AlgebraicGeometry.SmoothOfRelativeDimension d_rel (g₂_k.left ∣_ U₂_sm_k)]
    (f_0 : MvPolynomial (Fin 2) k) (hf_0_ne : f_0 ≠ 0)
    (hU₂_chart0 : j_0.base ⁻¹' (U₂_sm_k : Set (weilProjectiveSpaceOver k 2).left) =
      { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
        f_0 ∉ p.asIdeal }) :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let η_K₂ : AlgebraicGeometry.Spec (CommRingCat.of K₂) ⟶
        (weilProjectiveSpaceOver k 2).left :=
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin 2) k) K₂)) ≫ j_0
    ∃ (L₂ : Type u)
      (_ : Field L₂)
      (_ : Algebra K₂ L₂)
      (_ : FiniteDimensional K₂ L₂)
      (_ : IsGalois K₂ L₂),
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (ψ_Ω : K₂ →+* Ω)
        (i_L : L₂ →+* Ω),
        i_L.comp (algebraMap K₂ L₂) = ψ_Ω →
        let η_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
            (weilProjectiveSpaceOver k 2).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω) ≫ η_K₂
        let Y_Ω := CategoryTheory.Limits.pullback g₂_k.left η_Ω
        ∀ (γ : Ω ≃+* Ω),
          (∀ x : K₂, γ (ψ_Ω x) = ψ_Ω x) →
          ∀ (α_γ : Y_Ω ⟶ Y_Ω),
            α_γ ≫ CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω =
              CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω →
            α_γ ≫ CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω =
              CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) →
            ∀ (p_γ : weilEtaleTorsionH Y_Ω (ℓ ^ (r' + 1)) d_rel →+
                weilEtaleTorsionH Y_Ω (ℓ ^ (r' + 1)) d_rel),
              WeilIsTorsionEtalePullback α_γ (ℓ ^ (r' + 1)) d_rel p_γ →
              ((∀ z : L₂, γ (i_L z) = i_L z) ↔
                (∀ v : weilEtaleTorsionH Y_Ω (ℓ ^ (r' + 1)) d_rel, p_γ v = v)) :=
by
  let K₂ := FractionRing (MvPolynomial (Fin 2) k)
  let η_K₂ : AlgebraicGeometry.Spec (CommRingCat.of K₂) ⟶
      (weilProjectiveSpaceOver k 2).left :=
    AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin 2) k) K₂)) ≫ j_0
  obtain ⟨hPull_ex, hPull_id, hPull_comp, -, -⟩ := weil_etale_torsion_pullback_functoriality
  obtain ⟨L₀, hField_L₀, hAlg_L₀, hFD_L₀, hGal_L₀, A_fib, _, hConst⟩ :=
    weil_net_p2_gen_monodromy_galois_cover_triv k d_rel ℓ r' hℓ_k Y₂_k g₂_k j_0 hj_0_hom
  let _ : Field L₀ := hField_L₀
  let _ : Algebra K₂ L₀ := hAlg_L₀
  let _ : FiniteDimensional K₂ L₀ := hFD_L₀
  let _ : IsGalois K₂ L₀ := hGal_L₀
  let η_L₀ : AlgebraicGeometry.Spec (CommRingCat.of L₀) ⟶
      (weilProjectiveSpaceOver k 2).left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₂ L₀)) ≫ η_K₂
  obtain ⟨H₀, hAddGrp_H₀, Ψ, hEval⟩ :=
    weil_net_p2_gen_monodromy_spec_eval_and_intertwine k d_rel ℓ r' hℓ_k Y₂_k g₂_k
      L₀ η_L₀ A_fib hConst
  let _ : AddCommGroup H₀ := hAddGrp_H₀
  have hσ_η : ∀ σ : L₀ ≃ₐ[K₂] L₀,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ.toRingHom) ≫ η_L₀ = η_L₀ := by
    intro σ
    dsimp only [η_L₀]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomm : σ.toRingHom.comp (algebraMap K₂ L₀) = algebraMap K₂ L₀ :=
      RingHom.ext σ.commutes
    rw [hcomm]
  let f_end : (L₀ ≃ₐ[K₂] L₀) → AddMonoid.End H₀ := fun σ => Ψ σ.toRingHom (hσ_η σ)
  let Ω_std : Type u := AlgebraicClosure K₂
  have _ : Algebra.IsAlgebraic K₂ L₀ := Algebra.IsAlgebraic.of_finite K₂ L₀
  let j_std : L₀ →ₐ[K₂] Ω_std := IsAlgClosed.lift
  let _ : Algebra L₀ Ω_std := j_std.toRingHom.toAlgebra
  have _ : IsScalarTower K₂ L₀ Ω_std := IsScalarTower.of_algebraMap_eq' j_std.comp_algebraMap.symm
  let η_std : AlgebraicGeometry.Spec (CommRingCat.of Ω_std) ⟶
      (weilProjectiveSpaceOver k 2).left :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_std.toRingHom) ≫ η_L₀
  let Y_std := CategoryTheory.Limits.pullback g₂_k.left η_std
  obtain ⟨Φ_std, hΦ_std⟩ := hEval Ω_std j_std.toRingHom
  have hf_one : f_end 1 = 1 := by
    let γ_id : Ω_std ≃+* Ω_std := RingEquiv.refl Ω_std
    have hu_id : AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_id.toRingHom) =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω_std)) := by
      have hrh : γ_id.toRingHom = RingHom.id Ω_std := RingHom.ext fun _ => rfl
      rw [hrh, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    obtain ⟨p_id, hp_id⟩ :=
      hPull_ex (CategoryTheory.CategoryStruct.id Y_std) (ℓ ^ (r' + 1)) d_rel
    have hp_id_eq : p_id = AddMonoidHom.id _ :=
      hPull_id (ℓ ^ (r' + 1)) d_rel p_id hp_id
    apply DFunLike.ext
    intro h
    apply Φ_std.injective
    have h1 := hΦ_std (1 : L₀ ≃ₐ[K₂] L₀).toRingHom (hσ_η 1) γ_id (fun _ => rfl)
      (CategoryTheory.CategoryStruct.id Y_std)
      (CategoryTheory.Category.id_comp _)
      (by rw [CategoryTheory.Category.id_comp, hu_id, CategoryTheory.Category.comp_id])
      p_id hp_id h
    rw [hp_id_eq] at h1
    exact h1.symm
  have hu_std_η : ∀ (σ : L₀ ≃ₐ[K₂] L₀) (χ : Ω_std ≃ₐ[K₂] Ω_std),
      (∀ w : L₀, χ (j_std w) = j_std (σ w)) →
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ.toRingEquiv.toRingHom) ≫ η_std = η_std := by
    intro σ χ hχ
    dsimp only [η_std]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    have hcomp : χ.toRingEquiv.toRingHom.comp j_std.toRingHom =
        j_std.toRingHom.comp σ.toRingHom := RingHom.ext hχ
    rw [hcomp, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc, hσ_η σ]
  have hf_mul : ∀ σ₁ σ₂ : L₀ ≃ₐ[K₂] L₀, f_end (σ₁ * σ₂) = f_end σ₁ * f_end σ₂ := by
    intro σ₁ σ₂
    let χ₁ : Ω_std ≃ₐ[K₂] Ω_std := σ₁.liftNormal Ω_std
    let χ₂ : Ω_std ≃ₐ[K₂] Ω_std := σ₂.liftNormal Ω_std
    let χ₁₂ : Ω_std ≃ₐ[K₂] Ω_std := χ₁ * χ₂
    have hχ₁ : ∀ w : L₀, χ₁ (j_std w) = j_std (σ₁ w) :=
      fun w => AlgEquiv.liftNormal_commutes σ₁ Ω_std w
    have hχ₂ : ∀ w : L₀, χ₂ (j_std w) = j_std (σ₂ w) :=
      fun w => AlgEquiv.liftNormal_commutes σ₂ Ω_std w
    have hχ₁₂ : ∀ w : L₀, χ₁₂ (j_std w) = j_std ((σ₁ * σ₂) w) := by
      intro w
      change χ₁ (χ₂ (j_std w)) = j_std (σ₁ (σ₂ w))
      rw [hχ₂, hχ₁]
    let α₁ : Y_std ⟶ Y_std :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₂_k.left η_std)
        (CategoryTheory.Limits.pullback.snd g₂_k.left η_std ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ₁.toRingEquiv.toRingHom))
        (by rw [CategoryTheory.Category.assoc, hu_std_η σ₁ χ₁ hχ₁,
          CategoryTheory.Limits.pullback.condition])
    let α₂ : Y_std ⟶ Y_std :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₂_k.left η_std)
        (CategoryTheory.Limits.pullback.snd g₂_k.left η_std ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ₂.toRingEquiv.toRingHom))
        (by rw [CategoryTheory.Category.assoc, hu_std_η σ₂ χ₂ hχ₂,
          CategoryTheory.Limits.pullback.condition])
    let α₁₂ : Y_std ⟶ Y_std :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst g₂_k.left η_std)
        (CategoryTheory.Limits.pullback.snd g₂_k.left η_std ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom χ₁₂.toRingEquiv.toRingHom))
        (by rw [CategoryTheory.Category.assoc, hu_std_η (σ₁ * σ₂) χ₁₂ hχ₁₂,
          CategoryTheory.Limits.pullback.condition])
    have hα_comp : CategoryTheory.CategoryStruct.comp α₁ α₂ = α₁₂ := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc α₁, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hrh : χ₁.toRingEquiv.toRingHom.comp χ₂.toRingEquiv.toRingHom =
            χ₁₂.toRingEquiv.toRingHom := RingHom.ext fun _ => rfl
        rw [hrh]
    obtain ⟨p₁, hp₁⟩ := hPull_ex α₁ (ℓ ^ (r' + 1)) d_rel
    obtain ⟨p₂, hp₂⟩ := hPull_ex α₂ (ℓ ^ (r' + 1)) d_rel
    obtain ⟨p₁₂, hp₁₂⟩ := hPull_ex α₁₂ (ℓ ^ (r' + 1)) d_rel
    have hp₁₂_comp : WeilIsTorsionEtalePullback
        (CategoryTheory.CategoryStruct.comp α₁ α₂) (ℓ ^ (r' + 1)) d_rel p₁₂ := by
      rwa [hα_comp]
    have hp_eq : p₁₂ = p₁.comp p₂ :=
      hPull_comp α₁ α₂ (ℓ ^ (r' + 1)) d_rel p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂_comp
    apply DFunLike.ext
    intro h
    apply Φ_std.injective
    have he₁ := hΦ_std σ₁.toRingHom (hσ_η σ₁) χ₁.toRingEquiv hχ₁ α₁
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) p₁ hp₁ (f_end σ₂ h)
    have he₂ := hΦ_std σ₂.toRingHom (hσ_η σ₂) χ₂.toRingEquiv hχ₂ α₂
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) p₂ hp₂ h
    have he₁₂ := hΦ_std (σ₁ * σ₂).toRingHom (hσ_η (σ₁ * σ₂)) χ₁₂.toRingEquiv hχ₁₂ α₁₂
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) p₁₂ hp₁₂ h
    calc
      Φ_std (f_end (σ₁ * σ₂) h) = p₁₂ (Φ_std h) := he₁₂.symm
      _ = p₁ (p₂ (Φ_std h)) := by rw [hp_eq]; rfl
      _ = p₁ (Φ_std (f_end σ₂ h)) := by rw [he₂]; rfl
      _ = Φ_std (f_end σ₁ (f_end σ₂ h)) := he₁
      _ = Φ_std ((f_end σ₁ * f_end σ₂) h) := rfl
  let ρ₀ : (L₀ ≃ₐ[K₂] L₀) →* (AddMonoid.End H₀)ˣ :=
    { toFun := fun σ =>
        { val := f_end σ
          inv := f_end σ⁻¹
          val_inv := by rw [← hf_mul, mul_inv_cancel, hf_one]
          inv_val := by rw [← hf_mul, inv_mul_cancel, hf_one] }
      map_one' := Units.ext hf_one
      map_mul' := fun σ₁ σ₂ => Units.ext (hf_mul σ₁ σ₂) }
  obtain ⟨L₂, hField_L₂, hAlg_L₂, hFD_L₂, hGal_L₂, hGalIff⟩ :=
    weil_net_p2_gen_monodromy_galois_fixedField_iff K₂ L₀ H₀ ρ₀
  let _ : Field L₂ := hField_L₂
  let _ : Algebra K₂ L₂ := hAlg_L₂
  refine ⟨L₂, hField_L₂, hAlg_L₂, hFD_L₂, hGal_L₂, ?_⟩
  intro Ω _ _ ψ_Ω i_L hi_L η_Ω Y_Ω γ hγ_K₂ α_γ hα_fst hα_snd p_γ hp_γ
  obtain ⟨i₀, σ_γ, hi₀_K₂, hσ_γ_comm, hFix_iff⟩ :=
    hGalIff Ω ψ_Ω i_L hi_L γ hγ_K₂
  have hη_Ω_eq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom i₀) ≫ η_L₀ = η_Ω := by
    dsimp only [η_L₀, η_Ω]
    rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hi₀_K₂]
  have hEval_Ω := hEval Ω i₀
  dsimp only [] at hEval_Ω
  rw [hη_Ω_eq] at hEval_Ω
  obtain ⟨Φ, hΦ_intertwine⟩ := hEval_Ω
  have hp_Φ : ∀ h : H₀, p_γ (Φ h) = Φ ((ρ₀ σ_γ).val h) :=
    hΦ_intertwine σ_γ.toRingHom (hσ_η σ_γ) γ hσ_γ_comm α_γ hα_fst hα_snd p_γ hp_γ
  rw [hFix_iff]
  constructor
  · intro h_id v
    obtain ⟨h, rfl⟩ := Φ.surjective v
    rw [hp_Φ h, h_id h]
  · intro hp_id h
    apply Φ.injective
    rw [← hp_Φ h, hp_id (Φ h)]

theorem weil_dvr_slice_valSubring_hensel_lift_and_aut_conj (κ : Type u) [Field κ] [IsAlgClosed κ] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R_bar : Type u) [CommRing R_bar] [IsDomain R_bar] [IsLocalRing R_bar]
    (p_R : Polynomial κ →+* R_bar) (t_bar : R_bar)
    (π_cl : R_bar →+* κ)
    (φ_R_Ω : R_bar →+* AlgebraicClosure (FractionRing (Polynomial κ)))
    (ℐ : Type u) [CategoryTheory.SmallCategory ℐ] [CategoryTheory.IsFiltered ℐ]
    (D_col : ℐ ⥤ CommRingCat.{u})
    (α_col : (CategoryTheory.Functor.const ℐ).obj (CommRingCat.of (Polynomial κ)) ⟶ D_col)
    (c_col : CategoryTheory.Limits.Cocone D_col)
    (hc_col : CategoryTheory.Limits.IsColimit c_col)
    (e_pt : c_col.pt ≅ CommRingCat.of R_bar)
    (hBasic : p_R Polynomial.X = t_bar ∧
      π_cl.comp p_R = Polynomial.evalRingHom 0 ∧
      φ_R_Ω.comp p_R = algebraMap (Polynomial κ)
        (AlgebraicClosure (FractionRing (Polynomial κ))) ∧
      Function.Injective φ_R_Ω ∧
      @IsLocalization.Away R_bar _ t_bar
        (AlgebraicClosure (FractionRing (Polynomial κ))) _ φ_R_Ω.toAlgebra)
    (hCocone : ∀ i : ℐ,
      (α_col.app i) ≫ (c_col.ι.app i) ≫ e_pt.hom = CommRingCat.ofHom p_R ∧
      Function.Injective ((c_col.ι.app i) ≫ e_pt.hom).hom)
    (hStage : ∀ i : ℐ,
      ∃ (ϖ : ↑(D_col.obj i)) (u : (↑(D_col.obj i))ˣ) (e : ℕ)
        (ψ_i : Polynomial κ →+* ↑(D_col.obj i)),
        1 ≤ e ∧
        ((c_col.ι.app i) ≫ e_pt.hom).hom ϖ ∈ IsLocalRing.maximalIdeal R_bar ∧
        (α_col.app i).hom Polynomial.X = ↑u * ϖ ^ e ∧
        ψ_i.comp Polynomial.C = (α_col.app i).hom.comp Polynomial.C ∧
        ψ_i Polynomial.X = ϖ ∧
        ψ_i.Etale ∧
        ∃ (i₁ : ℐ) (θ : i ⟶ i₁) (β : ↑(D_col.obj i₁))
          (ψ₁ : Polynomial κ →+* ↑(D_col.obj i₁)),
          (D_col.map θ).hom ϖ = β ^ ℓ ∧
          ψ₁.comp Polynomial.C = (α_col.app i₁).hom.comp Polynomial.C ∧
          ψ₁ Polynomial.X = β ∧
          ψ₁.Etale) :
    let P_κ := Polynomial κ
    let Ω_κ := AlgebraicClosure (FractionRing P_κ)
    ∃ (V_0 : ValuationSubring Ω_κ)
      (e_RV : R_bar ≃+* ↥V_0)
      (p_V : P_κ →+* ↥V_0)
      (π_V0 : ↥V_0 →+* κ)
      (_ : HenselianLocalRing ↥V_0),
      V_0.subtype.comp e_RV.toRingHom = φ_R_Ω ∧
      e_RV.toRingHom.comp p_R = p_V ∧
      π_V0.comp e_RV.toRingHom = π_cl ∧
      V_0.subtype.comp p_V = algebraMap P_κ Ω_κ ∧
      π_V0.comp p_V = Polynomial.evalRingHom 0 ∧
      RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 ∧
      @IsLocalization.Away ↥V_0 _ (p_V Polynomial.X) Ω_κ _ V_0.subtype.toAlgebra ∧
      (∀ q : Ideal ↥V_0, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal ↥V_0) ∧
      (∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
        φ.Etale →
        ∀ (α_V : A →+* ↥V_0) (s_0 : B →+* κ),
          s_0.comp φ = π_V0.comp α_V →
          ∃! β_V : B →+* ↥V_0, β_V.comp φ = α_V ∧ π_V0.comp β_V = s_0) ∧
      (∀ (τ : κ ≃+* κ),
        ∃ (γ : Ω_κ ≃+* Ω_κ) (γ_V : ↥V_0 →+* ↥V_0),
          V_0.subtype.comp γ_V = γ.toRingHom.comp V_0.subtype ∧
          π_V0.comp γ_V = τ.toRingHom.comp π_V0 ∧
          ∀ f : P_κ,
            γ (algebraMap P_κ Ω_κ f) =
              algebraMap P_κ Ω_κ (Polynomial.map τ.toRingHom f)) :=
by
  let P_κ := Polynomial κ
  let Ω_κ := AlgebraicClosure (FractionRing P_κ)

  
  
  
  have hPillar1 :
      ∃ (V_0 : ValuationSubring Ω_κ)
        (e_RV : R_bar ≃+* ↥V_0)
        (p_V : P_κ →+* ↥V_0)
        (π_V0 : ↥V_0 →+* κ)
        (_ : HenselianLocalRing ↥V_0),
        V_0.subtype.comp e_RV.toRingHom = φ_R_Ω ∧
        e_RV.toRingHom.comp p_R = p_V ∧
        π_V0.comp e_RV.toRingHom = π_cl ∧
        V_0.subtype.comp p_V = algebraMap P_κ Ω_κ ∧
        π_V0.comp p_V = Polynomial.evalRingHom 0 ∧
        RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 ∧
        @IsLocalization.Away ↥V_0 _ (p_V Polynomial.X) Ω_κ _ V_0.subtype.toAlgebra ∧
        (∀ q : Ideal ↥V_0, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal ↥V_0) := by
    obtain ⟨ht_eq, hπ_pR, hφ_pR, hφ_inj, hLoc_R⟩ := hBasic
    have halg_P_Ω_inj : Function.Injective (algebraMap P_κ Ω_κ) := by
      rw [IsScalarTower.algebraMap_eq P_κ (FractionRing P_κ) Ω_κ, RingHom.coe_comp]
      exact (RingHom.injective (algebraMap (FractionRing P_κ) Ω_κ)).comp
        (IsFractionRing.injective P_κ (FractionRing P_κ))
    have ht_ne : t_bar ≠ 0 := by
      intro ht0
      have hX0 : φ_R_Ω (p_R Polynomial.X) = 0 := by rw [ht_eq, ht0, map_zero]
      have hX_alg : φ_R_Ω (p_R Polynomial.X) = algebraMap P_κ Ω_κ Polynomial.X :=
        RingHom.congr_fun hφ_pR Polynomial.X
      rw [hX_alg] at hX0
      exact Polynomial.X_ne_zero (halg_P_Ω_inj (hX0.trans (map_zero _).symm))

    
    let ι : ∀ i : ℐ, ↑(D_col.obj i) →+* R_bar :=
      fun i => ((c_col.ι.app i) ≫ e_pt.hom).hom
    have hι_w : ∀ {i j : ℐ} (θ : i ⟶ j) (x : ↑(D_col.obj i)),
        ι j ((D_col.map θ).hom x) = ι i x := by
      intro i j θ x
      have hw : D_col.map θ ≫ c_col.ι.app j ≫ e_pt.hom = c_col.ι.app i ≫ e_pt.hom := by
        rw [← Category.assoc, c_col.w θ]
      exact RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hw) x
    have hJointSurj : ∀ r : R_bar, ∃ (i : ℐ) (x : ↑(D_col.obj i)), ι i x = r := by
      obtain ⟨i₀⟩ := CategoryTheory.IsFiltered.nonempty (C := ℐ)
      let S_img : Subring R_bar :=
        { carrier := { r : R_bar | ∃ (i : ℐ) (x : ↑(D_col.obj i)), ι i x = r }
          mul_mem' := by
            rintro _ _ ⟨i, x, rfl⟩ ⟨j, y, rfl⟩
            let k := CategoryTheory.IsFiltered.max i j
            let f := CategoryTheory.IsFiltered.leftToMax i j
            let g := CategoryTheory.IsFiltered.rightToMax i j
            exact ⟨k, (D_col.map f).hom x * (D_col.map g).hom y, by
              rw [map_mul, hι_w f x, hι_w g y]⟩
          one_mem' := ⟨i₀, 1, map_one (ι i₀)⟩
          add_mem' := by
            rintro _ _ ⟨i, x, rfl⟩ ⟨j, y, rfl⟩
            let k := CategoryTheory.IsFiltered.max i j
            let f := CategoryTheory.IsFiltered.leftToMax i j
            let g := CategoryTheory.IsFiltered.rightToMax i j
            exact ⟨k, (D_col.map f).hom x + (D_col.map g).hom y, by
              rw [map_add, hι_w f x, hι_w g y]⟩
          zero_mem' := ⟨i₀, 0, map_zero (ι i₀)⟩
          neg_mem' := by
            rintro _ ⟨i, x, rfl⟩
            exact ⟨i, -x, map_neg (ι i) x⟩ }
      let c_sub : CategoryTheory.Limits.Cocone D_col :=
        { pt := CommRingCat.of ↥S_img
          ι :=
            { app := fun i => CommRingCat.ofHom ((ι i).codRestrict S_img (fun x => ⟨i, x, rfl⟩))
              naturality := fun i j θ => by
                ext x
                exact Subtype.ext (hι_w θ x) } }
      let desc_sub : c_col.pt ⟶ CommRingCat.of ↥S_img := hc_col.desc c_sub
      have hdesc_comp : desc_sub ≫ CommRingCat.ofHom S_img.subtype = e_pt.hom := by
        apply hc_col.hom_ext
        intro i
        rw [← Category.assoc, hc_col.fac c_sub i]
        ext x
        rfl
      let sec : CommRingCat.of R_bar ⟶ CommRingCat.of ↥S_img := e_pt.inv ≫ desc_sub
      have hsec_id : sec ≫ CommRingCat.ofHom S_img.subtype = 𝟙 (CommRingCat.of R_bar) := by
        dsimp [sec]
        rw [Category.assoc, hdesc_comp, e_pt.inv_hom_id]
      intro r
      have hr : S_img.subtype (sec.hom r) = r := by
        change (sec ≫ CommRingCat.ofHom S_img.subtype).hom r = r
        rw [hsec_id]
        rfl
      obtain ⟨i, x, hx⟩ := (sec.hom r).2
      exact ⟨i, x, hx.trans hr⟩

    
    have hStageFactor : ∀ (S : Type u) [CommRing S] (ι_S : S →+* R_bar),
        Function.Injective ι_S →
        ∀ (ϖ : S), ι_S ϖ ∈ IsLocalRing.maximalIdeal R_bar →
        ∀ (ψ : P_κ →+* S), ψ Polynomial.X = ϖ → ψ.Etale →
        ∀ (a_S : S), a_S ≠ 0 →
        ∃ (k : ℕ) (v_a : R_barˣ), ι_S a_S = ↑v_a * (ι_S ϖ) ^ k := by
      intro S _ ι_S hι_inj ϖ hϖ_max ψ hψ_X hψ_et a_S ha_ne
      haveI : IsDomain S := Function.Injective.isDomain ι_S hι_inj
      letI : Algebra P_κ S := ψ.toAlgebra
      haveI : Algebra.Etale P_κ S := RingHom.etale_algebraMap.mpr hψ_et
      haveI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing P_κ S
      letI : Algebra P_κ κ := (Polynomial.evalRingHom (0 : κ)).toAlgebra
      let T := TensorProduct P_κ κ S
      haveI : Algebra.Etale κ T := inferInstance
      let q_T : S →+* T := (@Algebra.TensorProduct.includeRight P_κ κ S _ _ _ _ _).toRingHom
      have hq_surj : Function.Surjective q_T := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => exact ⟨0, map_zero q_T⟩
        | tmul c s =>
          refine ⟨ψ (Polynomial.C c) * s, ?_⟩
          change (1 : κ) ⊗ₜ[P_κ] (Polynomial.C c • s) = c ⊗ₜ[P_κ] s
          rw [← TensorProduct.smul_tmul]
          congr 1
          change (Polynomial.evalRingHom (0 : κ)) (Polynomial.C c) * 1 = c
          simp
        | add x y ihx ihy =>
          obtain ⟨sx, rfl⟩ := ihx
          obtain ⟨sy, rfl⟩ := ihy
          exact ⟨sx + sy, map_add q_T sx sy⟩
      have hq_ker : ∀ s : S, q_T s = 0 ↔ s ∈ Ideal.span {ϖ} := by
        intro s
        constructor
        · intro hs0
          let Q_S := S ⧸ Ideal.span {ϖ}
          let mk_Q : S →+* Q_S := Ideal.Quotient.mk (Ideal.span {ϖ})
          have hmk_ϖ : mk_Q ϖ = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self ϖ)
          have hpoly_mod : ∀ p : P_κ, mk_Q (ψ (Polynomial.C (p.eval 0))) = mk_Q (ψ p) := by
            intro p
            have hroot : (p - Polynomial.C (p.eval 0)).IsRoot 0 := by
              rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_C, sub_self]
            obtain ⟨g, hg⟩ := Polynomial.dvd_iff_isRoot.mpr hroot
            rw [map_zero, sub_zero] at hg
            have hsub : ψ p - ψ (Polynomial.C (p.eval 0)) = ϖ * ψ g := by
              rw [← map_sub, hg, map_mul, hψ_X]
            symm
            apply sub_eq_zero.mp
            rw [← map_sub, hsub, map_mul, hmk_ϖ, zero_mul]
          let B_bilin : κ →ₗ[P_κ] S →ₗ[P_κ] Q_S :=
            LinearMap.mk₂ P_κ (fun c r => mk_Q (ψ (Polynomial.C c) * r))
              (fun c₁ c₂ r => by rw [map_add, map_add, right_distrib, map_add])
              (fun p c r => by
                change mk_Q (ψ (Polynomial.C (p.eval 0 * c)) * r) =
                  mk_Q (ψ p) * mk_Q (ψ (Polynomial.C c) * r)
                rw [Polynomial.C_mul, map_mul ψ, mul_assoc,
                  map_mul mk_Q (ψ (Polynomial.C (p.eval 0))), hpoly_mod p])
              (fun c r₁ r₂ => by rw [mul_add, map_add])
              (fun p c r => by
                change mk_Q (ψ (Polynomial.C c) * (ψ p * r)) =
                  mk_Q (ψ p) * mk_Q (ψ (Polynomial.C c) * r)
                rw [map_mul, map_mul, map_mul]
                ring)
          have hret : TensorProduct.lift B_bilin (q_T s) = mk_Q s := by
            change TensorProduct.lift B_bilin ((1 : κ) ⊗ₜ[P_κ] s) = mk_Q s
            rw [TensorProduct.lift.tmul]
            change mk_Q (ψ (Polynomial.C 1) * s) = mk_Q s
            rw [Polynomial.C_1, map_one, one_mul]
          rw [hs0, map_zero] at hret
          exact Ideal.Quotient.eq_zero_iff_mem.mp hret.symm
        · intro hs_mem
          obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hs_mem
          rw [map_mul]
          have hqϖ : q_T ϖ = 0 := by
            change (1 : κ) ⊗ₜ[P_κ] ϖ = 0
            have hϖ_smul : ϖ = (Polynomial.X : P_κ) • (1 : S) := by
              change ϖ = ψ Polynomial.X * 1
              rw [hψ_X, mul_one]
            rw [hϖ_smul, ← TensorProduct.smul_tmul]
            have hX0 : (Polynomial.X : P_κ) • (1 : κ) = 0 := by
              change (Polynomial.evalRingHom (0 : κ)) Polynomial.X * 1 = 0
              simp
            rw [hX0, TensorProduct.zero_tmul]
          rw [hqϖ, zero_mul]

      obtain ⟨I_idx, hFinI, A_f, hFieldA, hAlgA, e_T, _⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod κ T).mp inferInstance
      letI : Fintype I_idx := Fintype.ofFinite I_idx
      letI : DecidableEq I_idx := Classical.decEq I_idx
      let φ_prod : S →+* (∀ b : I_idx, A_f b) := e_T.toRingHom.comp q_T
      have hφ_surj : Function.Surjective φ_prod := e_T.surjective.comp hq_surj
      have hφ_ker : ∀ s : S, φ_prod s = 0 ↔ s ∈ Ideal.span {ϖ} := by
        intro s
        change e_T (q_T s) = 0 ↔ s ∈ Ideal.span {ϖ}
        rw [map_eq_zero_iff e_T e_T.injective, hq_ker]

      let m_S : Ideal S := Ideal.comap ι_S (IsLocalRing.maximalIdeal R_bar)
      haveI : m_S.IsPrime := Ideal.comap_isPrime ι_S (IsLocalRing.maximalIdeal R_bar)
      have hspan_le_m : Ideal.span {ϖ} ≤ m_S := by
        rw [Ideal.span_le]
        rintro _ rfl
        exact hϖ_max

      choose e_lift he_lift using fun b : I_idx => hφ_surj (Pi.single b 1)
      have hsum_diff : (∑ b : I_idx, e_lift b) - 1 ∈ m_S := by
        apply hspan_le_m
        rw [← hφ_ker]
        ext c
        simp only [map_sub, map_sum, map_one, Pi.sub_apply, Finset.sum_apply, Pi.one_apply,
          Pi.zero_apply, he_lift]
        rw [Finset.sum_eq_single c (fun b _ hb => Pi.single_eq_of_ne hb.symm 1)
          (fun hc => False.elim (hc (Finset.mem_univ c))), Pi.single_eq_same, sub_self]
      have hex_b₀ : ∃ b₀ : I_idx, e_lift b₀ ∉ m_S := by
        by_contra h_all
        have hsum_mem : (∑ b : I_idx, e_lift b) ∈ m_S :=
          m_S.sum_mem fun b _ => Classical.not_not.mp fun hnot => h_all ⟨b, hnot⟩
        have h1_mem : (1 : S) ∈ m_S := by
          have := m_S.sub_mem hsum_mem hsum_diff
          simpa using this
        exact (Ideal.IsPrime.ne_top ‹_›) (m_S.eq_top_of_isUnit_mem h1_mem isUnit_one)
      obtain ⟨b₀, hb₀_not_mem⟩ := hex_b₀
      let f₀ : S := e_lift b₀
      have hf₀_not_mem : f₀ ∉ m_S := hb₀_not_mem

      have hkill_m : ∀ y ∈ m_S, y * f₀ ∈ Ideal.span {ϖ} := by
        intro y hy
        have hy_b₀ : φ_prod y b₀ = 0 := by
          by_contra hc_ne
          obtain ⟨z, hz⟩ := hφ_surj (Pi.single b₀ (φ_prod y b₀)⁻¹)
          have hzy_ker : z * y - f₀ ∈ Ideal.span {ϖ} := by
            rw [← hφ_ker]
            ext b
            simp only [map_sub, map_mul, Pi.sub_apply, Pi.mul_apply, hz, f₀, he_lift]
            by_cases hb : b = b₀
            · subst hb
              simp [inv_mul_cancel₀ hc_ne]
            · simp [Pi.single_eq_of_ne hb]
          have hzy_m : z * y - f₀ ∈ m_S := hspan_le_m hzy_ker
          have hf₀_m : f₀ ∈ m_S := by
            have := m_S.sub_mem (m_S.mul_mem_left z hy) hzy_m
            simpa using this
          exact hf₀_not_mem hf₀_m
        rw [← hφ_ker]
        ext b
        simp only [map_mul, Pi.mul_apply, f₀, he_lift]
        by_cases hb : b = b₀
        · subst hb
          simp [hy_b₀]
        · simp [Pi.single_eq_of_ne hb]

      
      let L_S := Localization.AtPrime m_S
      have hm_le_nzd : m_S.primeCompl ≤ nonZeroDivisors S := by
        intro s hs
        exact mem_nonZeroDivisors_of_ne_zero fun h0 => hs (h0 ▸ m_S.zero_mem)
      haveI : IsDomain L_S := IsLocalization.isDomain_of_le_nonZeroDivisors L_S hm_le_nzd
      haveI : IsNoetherianRing L_S :=
        IsLocalization.isNoetherianRing m_S.primeCompl L_S ‹IsNoetherianRing S›
      have halg_LS_inj : Function.Injective (algebraMap S L_S) :=
        IsLocalization.injective L_S hm_le_nzd

      let ϖ_L : L_S := algebraMap S L_S ϖ
      have hmax_LS : IsLocalRing.maximalIdeal L_S = Ideal.span {ϖ_L} := by
        apply le_antisymm
        · intro w hw
          obtain ⟨⟨y, s⟩, hws⟩ := IsLocalization.surj m_S.primeCompl w
          have hy_map_max : algebraMap S L_S y ∈ IsLocalRing.maximalIdeal L_S := by
            rw [← hws]
            exact (IsLocalRing.maximalIdeal L_S).mul_mem_right _ hw
          have hy_m : y ∈ m_S :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff L_S m_S y).mp hy_map_max
          obtain ⟨q_s, hq_s⟩ := Ideal.mem_span_singleton.mp (hkill_m y hy_m)
          let u_s : L_Sˣ := (IsLocalization.map_units L_S s).unit
          let u_f : L_Sˣ := (IsLocalization.map_units L_S (⟨f₀, hf₀_not_mem⟩ : m_S.primeCompl)).unit
          rw [Ideal.mem_span_singleton]
          refine ⟨algebraMap S L_S q_s * ↑(u_f⁻¹) * ↑(u_s⁻¹), ?_⟩
          have heq1 : w * ↑u_s * ↑u_f = ϖ_L * algebraMap S L_S q_s := by
            change w * algebraMap S L_S s.1 * algebraMap S L_S f₀ = ϖ_L * algebraMap S L_S q_s
            rw [hws, ← map_mul, hq_s, map_mul]
          calc
            w = (w * ↑u_s * ↑u_f) * ↑(u_f⁻¹) * ↑(u_s⁻¹) := by
              simp [mul_assoc]
            _ = ϖ_L * (algebraMap S L_S q_s * ↑(u_f⁻¹) * ↑(u_s⁻¹)) := by
              rw [heq1]; ring
        · rw [Ideal.span_le]
          rintro _ rfl
          exact (IsLocalization.AtPrime.to_map_mem_maximal_iff L_S m_S ϖ).mpr hϖ_max

      
      let a_L : L_S := algebraMap S L_S a_S
      have ha_L_ne : a_L ≠ 0 :=
        fun h0 => ha_ne (halg_LS_inj (h0.trans (map_zero _).symm))
      have hiInf : (⨅ n : ℕ, (IsLocalRing.maximalIdeal L_S) ^ n) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal L_S)
          (IsLocalRing.maximalIdeal.isMaximal L_S).ne_top
      have hex_not_mem : ∃ n : ℕ, a_L ∉ (IsLocalRing.maximalIdeal L_S) ^ n := by
        by_contra hall
        have hbot : a_L ∈ (⊥ : Ideal L_S) := by
          rw [← hiInf, Ideal.mem_iInf]
          exact fun n => Classical.not_not.mp fun hn => hall ⟨n, hn⟩
        exact ha_L_ne (Ideal.mem_bot.mp hbot)
      classical
      let n₀ : ℕ := Nat.find hex_not_mem
      have hn₀_spec : a_L ∉ (IsLocalRing.maximalIdeal L_S) ^ n₀ := Nat.find_spec hex_not_mem
      have hn₀_pos : 0 < n₀ := by
        rcases Nat.eq_zero_or_pos n₀ with h0 | hpos
        · exfalso
          apply hn₀_spec
          rw [h0, pow_zero, Ideal.one_eq_top]
          exact Submodule.mem_top
        · exact hpos
      let k : ℕ := n₀ - 1
      have hk_succ : k + 1 = n₀ := Nat.sub_add_cancel hn₀_pos
      have ha_mem_k : a_L ∈ (IsLocalRing.maximalIdeal L_S) ^ k := by
        by_contra hnot
        exact Nat.find_min hex_not_mem (by omega : k < n₀) hnot
      rw [hmax_LS, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at ha_mem_k
      obtain ⟨u_L, hu_L_eq⟩ := ha_mem_k
      have hu_L_unit : IsUnit u_L := by
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hu_mem
        rw [hmax_LS, Ideal.mem_span_singleton] at hu_mem
        obtain ⟨z_L, rfl⟩ := hu_mem
        apply hn₀_spec
        rw [← hk_succ, hmax_LS, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
        exact ⟨z_L, by rw [hu_L_eq]; ring⟩

      
      have hm_units : ∀ s : m_S.primeCompl, IsUnit (ι_S s.1) := by
        intro s
        exact IsLocalRing.notMem_maximalIdeal.mp s.2
      let ι_loc : L_S →+* R_bar := IsLocalization.lift hm_units
      have hι_loc_a : ι_loc a_L = ι_S a_S := IsLocalization.lift_eq hm_units a_S
      have hι_loc_ϖ : ι_loc ϖ_L = ι_S ϖ := IsLocalization.lift_eq hm_units ϖ
      refine ⟨k, Units.map ι_loc.toMonoidHom hu_L_unit.unit, ?_⟩
      calc
        ι_S a_S = ι_loc a_L := hι_loc_a.symm
        _ = ι_loc (ϖ_L ^ k * u_L) := by rw [hu_L_eq]
        _ = (ι_loc ϖ_L) ^ k * ι_loc (↑hu_L_unit.unit) := by
          rw [map_mul, map_pow, IsUnit.unit_spec]
        _ = ↑(Units.map ι_loc.toMonoidHom hu_L_unit.unit) * (ι_S ϖ) ^ k := by
          rw [hι_loc_ϖ, mul_comm]; rfl

    
    have hFactor_R : ∀ a : R_bar, a ≠ 0 →
        ∃ (k e : ℕ) (v_a v_t : R_barˣ) (w : R_bar),
          1 ≤ e ∧ w ∈ IsLocalRing.maximalIdeal R_bar ∧
          a = ↑v_a * w ^ k ∧ t_bar = ↑v_t * w ^ e := by
      intro a ha_ne
      obtain ⟨i, a_i, rfl⟩ := hJointSurj a
      have ha_i_ne : a_i ≠ 0 := fun h0 => ha_ne (by rw [h0, map_zero])
      obtain ⟨ϖ, u, e, ψ_i, he1, hϖ_max, hαX, _, hψX, hψ_et, _⟩ := hStage i
      have hα_ι : ι i ((α_col.app i).hom Polynomial.X) = t_bar := by
        have hcomp := (hCocone i).1
        have h1 : ((α_col.app i) ≫ (c_col.ι.app i) ≫ e_pt.hom).hom Polynomial.X =
            p_R Polynomial.X :=
          RingHom.congr_fun (CommRingCat.Hom.ext_iff.mp hcomp) Polynomial.X
        exact h1.trans ht_eq
      have ht_fac : t_bar = ↑(Units.map (ι i).toMonoidHom u) * (ι i ϖ) ^ e := by
        rw [← hα_ι, hαX, map_mul, map_pow]; rfl
      obtain ⟨k, v_a, ha_fac⟩ :=
        hStageFactor (↑(D_col.obj i)) (ι i) (hCocone i).2 ϖ hϖ_max ψ_i hψX hψ_et a_i ha_i_ne
      exact ⟨k, e, v_a, Units.map (ι i).toMonoidHom u, ι i ϖ, he1, hϖ_max, ha_fac, ht_fac⟩

    
    letI alg_R_Ω : Algebra R_bar Ω_κ := φ_R_Ω.toAlgebra
    have h_dichotomy : ∀ z : Ω_κ, z ∈ φ_R_Ω.range ∨ z⁻¹ ∈ φ_R_Ω.range := by
      intro z
      by_cases hz0 : z = 0
      · left; exact ⟨0, (map_zero φ_R_Ω).trans hz0.symm⟩
      · obtain ⟨⟨a, ⟨_, ⟨m, rfl⟩⟩⟩, hza⟩ :=
          @IsLocalization.surj R_bar _ (Submonoid.powers t_bar) Ω_κ _ alg_R_Ω hLoc_R z
        change z * φ_R_Ω (t_bar ^ m) = φ_R_Ω a at hza
        have htm_ne : φ_R_Ω (t_bar ^ m) ≠ 0 :=
          (map_ne_zero_iff φ_R_Ω hφ_inj).mpr (pow_ne_zero m ht_ne)
        have ha_ne : a ≠ 0 := by
          intro ha0
          rw [ha0, map_zero] at hza
          exact mul_ne_zero hz0 htm_ne hza
        obtain ⟨k, e, v_a, v_t, w, he1, _, ha_fac, ht_fac⟩ := hFactor_R a ha_ne
        by_cases hle : m * e ≤ k
        · left
          let r : R_bar := ↑v_a * (↑(v_t⁻¹) : R_bar) ^ m * w ^ (k - m * e)
          refine ⟨r, ?_⟩
          have hr_mul : r * t_bar ^ m = a := by
            dsimp [r]
            rw [ha_fac, ht_fac, mul_pow, ← pow_mul]
            have hvt : (↑(v_t⁻¹) : R_bar) * ↑v_t = 1 := v_t.inv_val
            calc
              ↑v_a * (↑(v_t⁻¹) : R_bar) ^ m * w ^ (k - m * e) * ((↑v_t : R_bar) ^ m * w ^ (e * m))
                = ↑v_a * ((↑(v_t⁻¹) : R_bar) * ↑v_t) ^ m * (w ^ (k - m * e) * w ^ (m * e)) := by
                  ring
              _ = ↑v_a * w ^ k := by
                  rw [hvt, one_pow, mul_one, ← pow_add, Nat.sub_add_cancel hle]
          apply mul_right_cancel₀ htm_ne
          rw [← map_mul, hr_mul, hza]
        · right
          have hle' : k ≤ m * e := Nat.le_of_not_ge hle
          let r' : R_bar := (↑v_t : R_bar) ^ m * ↑(v_a⁻¹) * w ^ (m * e - k)
          refine ⟨r', ?_⟩
          have hr'_mul : r' * a = t_bar ^ m := by
            dsimp [r']
            rw [ha_fac, ht_fac, mul_pow, ← pow_mul]
            have hva : (↑(v_a⁻¹) : R_bar) * ↑v_a = 1 := v_a.inv_val
            calc
              (↑v_t : R_bar) ^ m * ↑(v_a⁻¹) * w ^ (m * e - k) * (↑v_a * w ^ k)
                = (↑v_t : R_bar) ^ m * ((↑(v_a⁻¹) : R_bar) * ↑v_a) * (w ^ (m * e - k) * w ^ k) := by
                  ring
              _ = (↑v_t : R_bar) ^ m * w ^ (e * m) := by
                  rw [hva, mul_one, ← pow_add, Nat.sub_add_cancel hle', mul_comm m e]
          have h1 : φ_R_Ω r' * z = 1 := by
            apply mul_right_cancel₀ htm_ne
            calc
              (φ_R_Ω r' * z) * φ_R_Ω (t_bar ^ m)
                = φ_R_Ω r' * (z * φ_R_Ω (t_bar ^ m)) := by ring
              _ = φ_R_Ω (r' * a) := by rw [hza, ← map_mul]
              _ = 1 * φ_R_Ω (t_bar ^ m) := by rw [hr'_mul, one_mul]
          exact (inv_eq_of_mul_eq_one_left h1).symm

    let V_0 : ValuationSubring Ω_κ :=
      { φ_R_Ω.range with mem_or_inv_mem' := h_dichotomy }
    let e_RV : R_bar ≃+* ↥V_0 :=
      RingEquiv.ofBijective φ_R_Ω.rangeRestrict
        ⟨fun x y h => hφ_inj (congrArg Subtype.val h), φ_R_Ω.rangeRestrict_surjective⟩
    let p_V : P_κ →+* ↥V_0 := e_RV.toRingHom.comp p_R
    let π_V0 : ↥V_0 →+* κ := π_cl.comp e_RV.symm.toRingHom

    have hSub_eRV : V_0.subtype.comp e_RV.toRingHom = φ_R_Ω := by
      ext r; rfl
    have heRV_pR : e_RV.toRingHom.comp p_R = p_V := rfl
    have hπ_eRV : π_V0.comp e_RV.toRingHom = π_cl := by
      ext r
      change π_cl (e_RV.symm (e_RV r)) = π_cl r
      rw [e_RV.symm_apply_apply]
    have hpV_sub : V_0.subtype.comp p_V = algebraMap P_κ Ω_κ := by
      rw [← heRV_pR, ← RingHom.comp_assoc, hSub_eRV, hφ_pR]
    have hπ_pV : π_V0.comp p_V = Polynomial.evalRingHom 0 := by
      rw [← heRV_pR, ← RingHom.comp_assoc, hπ_eRV, hπ_pR]
    have hπ_surj : Function.Surjective π_V0 := by
      intro c
      refine ⟨p_V (Polynomial.C c), ?_⟩
      change (π_V0.comp p_V) (Polynomial.C c) = c
      rw [hπ_pV, Polynomial.coe_evalRingHom, Polynomial.eval_C]
    have hπ_ker : RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective π_V0 hπ_surj)

    
    have hpV_X : p_V Polynomial.X = e_RV t_bar := by
      change e_RV (p_R Polynomial.X) = e_RV t_bar
      rw [ht_eq]
    have hLoc_V0 : @IsLocalization.Away ↥V_0 _ (p_V Polynomial.X) Ω_κ _ V_0.subtype.toAlgebra := by
      letI : Algebra ↥V_0 Ω_κ := V_0.subtype.toAlgebra
      refine
        { map_units := ?_
          surj := ?_
          exists_of_eq := ?_ }
      · rintro ⟨_, ⟨n, rfl⟩⟩
        change IsUnit (V_0.subtype ((p_V Polynomial.X) ^ n))
        rw [hpV_X, ← map_pow]
        change IsUnit ((V_0.subtype.comp e_RV.toRingHom) (t_bar ^ n))
        rw [hSub_eRV]
        exact @IsLocalization.map_units R_bar _ (Submonoid.powers t_bar) Ω_κ _ alg_R_Ω hLoc_R
          ⟨t_bar ^ n, ⟨n, rfl⟩⟩
      · intro z
        obtain ⟨⟨a, ⟨_, ⟨n, rfl⟩⟩⟩, hza⟩ :=
          @IsLocalization.surj R_bar _ (Submonoid.powers t_bar) Ω_κ _ alg_R_Ω hLoc_R z
        refine ⟨⟨e_RV a, ⟨(p_V Polynomial.X) ^ n, ⟨n, rfl⟩⟩⟩, ?_⟩
        change z * V_0.subtype ((p_V Polynomial.X) ^ n) = V_0.subtype (e_RV a)
        rw [hpV_X, ← map_pow]
        exact hza
      · intro x y hxy
        exact ⟨1, congrArg (1 * ·) (V_0.subtype_injective hxy)⟩

    
    have hSpec2 : ∀ q : Ideal ↥V_0, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal ↥V_0 := by
      intro q hq
      by_cases hbot : q = ⊥
      · exact Or.inl hbot
      · right
        have hex_x : ∃ x ∈ q, x ≠ 0 := by
          by_contra hall
          apply hbot
          ext x
          simp only [Ideal.mem_bot]
          exact ⟨fun hx => by_contra fun hne => hall ⟨x, hx, hne⟩, fun h0 => h0 ▸ q.zero_mem⟩
        obtain ⟨x, hx_q, hx_ne⟩ := hex_x
        letI : Algebra ↥V_0 Ω_κ := V_0.subtype.toAlgebra
        have hx_Ω_ne : V_0.subtype x ≠ 0 :=
          (map_ne_zero_iff V_0.subtype V_0.subtype_injective).mpr hx_ne
        obtain ⟨⟨y, ⟨_, ⟨m, rfl⟩⟩⟩, hxy⟩ :=
          @IsLocalization.surj ↥V_0 _ (Submonoid.powers (p_V Polynomial.X)) Ω_κ _ _ hLoc_V0
            (V_0.subtype x)⁻¹
        change (V_0.subtype x)⁻¹ * V_0.subtype ((p_V Polynomial.X) ^ m) = V_0.subtype y at hxy
        have hXm_eq : (p_V Polynomial.X) ^ m = x * y := by
          apply V_0.subtype_injective
          rw [map_mul, ← hxy, ← mul_assoc, mul_inv_cancel₀ hx_Ω_ne, one_mul]
        have hpVX_q : p_V Polynomial.X ∈ q :=
          hq.mem_of_pow_mem m (hXm_eq ▸ q.mul_mem_right y hx_q)
        have hmax_le : IsLocalRing.maximalIdeal ↥V_0 ≤ q := by
          intro z hz_max
          by_cases hz0 : z = 0
          · exact hz0 ▸ q.zero_mem
          · let a : R_bar := e_RV.symm z
            have ha_ne : a ≠ 0 :=
              (map_ne_zero_iff e_RV.symm e_RV.symm.injective).mpr hz0
            have ha_max : a ∈ IsLocalRing.maximalIdeal R_bar := by
              rw [IsLocalRing.mem_maximalIdeal] at hz_max ⊢
              intro ha_unit
              exact hz_max (by simpa [a] using ha_unit.map e_RV.toRingHom)
            obtain ⟨k, e, v_a, v_t, w, he1, _, ha_fac, ht_fac⟩ := hFactor_R a ha_ne
            have hk_pos : 1 ≤ k := by
              rcases Nat.eq_zero_or_pos k with hk0 | hkpos
              · exfalso
                rw [hk0, pow_zero, mul_one] at ha_fac
                exact (IsLocalRing.mem_maximalIdeal a).mp ha_max (ha_fac ▸ v_a.isUnit)
              · exact hkpos
            let c_R : R_bar := (↑v_a : R_bar) ^ e * ↑(v_t⁻¹) * w ^ ((k - 1) * e)
            have hc_eq : a ^ e = c_R * t_bar := by
              dsimp [c_R]
              rw [ha_fac, ht_fac, mul_pow]
              have hvt : (↑(v_t⁻¹) : R_bar) * ↑v_t = 1 := v_t.inv_val
              have hexp : (k - 1) * e + e = k * e := by
                calc
                  (k - 1) * e + e = (k - 1 + 1) * e := by ring
                  _ = k * e := by rw [Nat.sub_add_cancel hk_pos]
              calc
                (↑v_a : R_bar) ^ e * (w ^ k) ^ e
                  = (↑v_a : R_bar) ^ e * 1 * w ^ (k * e) := by rw [mul_one, ← pow_mul]
                _ = (↑v_a : R_bar) ^ e * ((↑(v_t⁻¹) : R_bar) * ↑v_t) * w ^ ((k - 1) * e + e) := by
                    rw [hvt, hexp]
                _ = (↑v_a : R_bar) ^ e * ↑(v_t⁻¹) * w ^ ((k - 1) * e) * (↑v_t * w ^ e) := by
                    rw [pow_add]; ring
            have hze : z ^ e = e_RV c_R * p_V Polynomial.X := by
              have h1 := congrArg e_RV hc_eq
              simpa [a, map_pow, map_mul, hpV_X] using h1
            exact hq.mem_of_pow_mem e (hze ▸ q.mul_mem_left (e_RV c_R) hpVX_q)
        exact (((IsLocalRing.maximalIdeal.isMaximal ↥V_0).eq_of_le hq.ne_top hmax_le).symm)

    
    have hHens_V0 : HenselianLocalRing ↥V_0 := by
      refine HenselianLocalRing.mk ?_
      intro f hf_mon a₀ hfa₀ _
      let f_Ω : Polynomial Ω_κ := f.map V_0.subtype
      have hfΩ_mon : f_Ω.Monic := hf_mon.map V_0.subtype
      have hfΩ_splits : f_Ω.Splits := IsAlgClosed.splits f_Ω
      have hroots_mem : ∀ α ∈ f_Ω.roots, α ∈ V_0 := by
        intro α hα
        have h_eval : Polynomial.aeval α f = 0 := by
          change Polynomial.eval₂ V_0.subtype α f = 0
          rw [← Polynomial.eval_map]
          exact Polynomial.isRoot_of_mem_roots hα
        have h_int : IsIntegral ↥V_0 α := ⟨f, hf_mon, h_eval⟩
        obtain ⟨r, hr⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥V_0) (K := Ω_κ)).mp h_int
        exact hr ▸ r.2
      let M_V : Multiset ↥V_0 := f_Ω.roots.pmap Subtype.mk hroots_mem
      have hmap_MV : M_V.map V_0.subtype = f_Ω.roots := by
        have h_pmap : ∀ (M : Multiset Ω_κ) (hM : ∀ α ∈ M, α ∈ V_0),
            (M.pmap Subtype.mk hM).map V_0.subtype = M := by
          intro M
          induction M using Multiset.induction_on with
          | empty => intro _; rfl
          | cons a s ih =>
            intro hM
            simp only [Multiset.pmap_cons, Multiset.map_cons]
            exact congrArg (a ::ₘ ·) (ih _)
        exact h_pmap f_Ω.roots hroots_mem
      have hsub_eval : ∀ r : ↥V_0, V_0.subtype (f.eval r) = f_Ω.eval (V_0.subtype r) := by
        intro r
        dsimp [f_Ω]
        rw [Polynomial.eval_map]
        change V_0.subtype (f.eval₂ (RingHom.id ↥V_0) r) = f.eval₂ V_0.subtype (V_0.subtype r)
        rw [Polynomial.hom_eval₂, RingHom.comp_id]
      have heval_prod : f.eval a₀ = (M_V.map (fun r => a₀ - r)).prod := by
        apply V_0.subtype_injective
        rw [hsub_eval a₀, Polynomial.Splits.eval_eq_prod_roots_of_monic hfΩ_splits hfΩ_mon,
          map_multiset_prod, ← hmap_MV, Multiset.map_map, Multiset.map_map]
        congr 1
      rw [heval_prod] at hfa₀
      have hmax_prime : (IsLocalRing.maximalIdeal ↥V_0).IsPrime := inferInstance
      obtain ⟨y, hy_mem, hy_max⟩ :=
        (Ideal.IsPrime.multiset_prod_mem_iff_exists_mem hmax_prime _).mp hfa₀
      obtain ⟨r, hr_MV, rfl⟩ := Multiset.mem_map.mp hy_mem
      refine ⟨r, ?_, ?_⟩
      · change f.eval r = 0
        apply V_0.subtype_injective
        rw [map_zero, hsub_eval r]
        have hr_Ω : V_0.subtype r ∈ f_Ω.roots := by
          rw [← hmap_MV]
          exact Multiset.mem_map_of_mem V_0.subtype hr_MV
        exact Polynomial.isRoot_of_mem_roots hr_Ω
      · have hneg := (IsLocalRing.maximalIdeal ↥V_0).neg_mem hy_max
        simpa using hneg

    exact ⟨V_0, e_RV, p_V, π_V0, hHens_V0,
      hSub_eRV, heRV_pR, hπ_eRV, hpV_sub, hπ_pV, hπ_ker, hLoc_V0, hSpec2⟩

  
  
  
  have hPillar2 :
      ∀ (R : Type u) [CommRing R] [IsDomain R] [IsLocalRing R] [HenselianLocalRing R]
        (π : R →+* κ),
        Function.Surjective π →
        RingHom.ker π = IsLocalRing.maximalIdeal R →
        ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
          φ.Etale →
          ∀ (α_V : A →+* R) (s_0 : B →+* κ),
            s_0.comp φ = π.comp α_V →
            ∃! β_V : B →+* R, β_V.comp φ = α_V ∧ π.comp β_V = s_0 := by
    intro R _ _ _ _ π hπ_surj hπ_ker A B _ _ φ hφ α_V s_0 hcomm
    letI : Algebra A R := α_V.toAlgebra
    letI : Algebra A B := φ.toAlgebra
    letI : Algebra R κ := π.toAlgebra
    letI : Algebra A κ := (π.comp α_V).toAlgebra
    haveI : IsScalarTower A R κ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.Etale A B := RingHom.etale_algebraMap.mpr hφ

    let B' := TensorProduct A R B
    haveI : Algebra.Etale R B' := inferInstance
    let s_0_alg : B →ₐ[A] κ :=
      { s_0 with commutes' := fun a => RingHom.congr_fun hcomm a }
    let s'_0 : B' →ₐ[R] κ :=
      Algebra.TensorProduct.lift (Algebra.ofId R κ) s_0_alg (fun _ _ => mul_comm _ _)

    
    let q_0 : Ideal B' := RingHom.ker s'_0.toRingHom
    haveI : q_0.IsPrime := RingHom.ker_isPrime s'_0.toRingHom
    haveI : Algebra.FinitePresentation R B' := inferInstance
    haveI : Algebra.IsEtaleAt R q_0 := inferInstance
    obtain ⟨g_loc, hg_not_mem, hStd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) q_0
    let S_loc := Localization.Away g_loc
    haveI : Algebra.IsStandardEtale R S_loc := hStd
    obtain ⟨pres⟩ := Algebra.IsStandardEtale.nonempty_standardEtalePresentation (R := R) (S := S_loc)
    let loc_alg : B' →ₐ[R] S_loc := IsScalarTower.toAlgHom R B' S_loc

    have hg_ne_κ : s'_0 g_loc ≠ 0 := hg_not_mem
    have hg_unit_κ : IsUnit (s'_0.toRingHom g_loc) := isUnit_iff_ne_zero.mpr hg_ne_κ
    let s_loc_ring : S_loc →+* κ := IsLocalization.Away.lift g_loc hg_unit_κ
    let s_loc : S_loc →ₐ[R] κ :=
      { s_loc_ring with
        commutes' := fun r => by
          change s_loc_ring (algebraMap B' S_loc (algebraMap R B' r)) = algebraMap R κ r
          rw [IsLocalization.Away.lift_eq g_loc hg_unit_κ]
          exact s'_0.commutes r }

    let c_0 : κ := s_loc pres.x
    have hc0_map : pres.P.HasMap c_0 := pres.hasMap.map s_loc
    have hc0_f : Polynomial.aeval c_0 pres.P.f = 0 := hc0_map.1
    have hc0_g : IsUnit (Polynomial.aeval c_0 pres.P.g) := hc0_map.2
    have hc0_df : IsUnit (Polynomial.aeval c_0 (Polynomial.derivative pres.P.f)) :=
      StandardEtalePair.HasMap.isUnit_derivative_f pres.P hc0_map

    have hπ_eval : ∀ (Q : Polynomial R) (r : R), π (Q.eval r) = Polynomial.aeval (π r) Q := by
      intro Q r
      change π (Q.eval₂ (RingHom.id R) r) = Q.eval₂ π (π r)
      rw [Polynomial.hom_eval₂, RingHom.comp_id]

    
    obtain ⟨a_0, ha_0⟩ := hπ_surj c_0
    have hf_a0_max : pres.P.f.eval a_0 ∈ IsLocalRing.maximalIdeal R := by
      rw [← hπ_ker, RingHom.mem_ker, hπ_eval, ha_0]
      exact hc0_f
    have hdf_a0_unit : IsUnit ((Polynomial.derivative pres.P.f).eval a_0) := by
      rw [← IsLocalRing.notMem_maximalIdeal, ← hπ_ker, RingHom.mem_ker, hπ_eval, ha_0]
      exact hc0_df.ne_zero
    obtain ⟨a, ha_root, ha_diff⟩ :=
      HenselianLocalRing.is_henselian pres.P.f pres.P.monic_f a_0 hf_a0_max hdf_a0_unit
    have hπ_a : π a = c_0 := by
      rw [← hπ_ker, RingHom.mem_ker, map_sub] at ha_diff
      rw [sub_eq_zero.mp ha_diff, ha_0]
    have ha_map : pres.P.HasMap a := by
      refine ⟨?_, ?_⟩
      · change pres.P.f.eval a = 0
        exact ha_root
      · change IsUnit (pres.P.g.eval a)
        rw [← IsLocalRing.notMem_maximalIdeal, ← hπ_ker, RingHom.mem_ker, hπ_eval, hπ_a]
        exact hc0_g.ne_zero

    let γ_R : S_loc →ₐ[R] R := (pres.P.lift a ha_map).comp pres.equivRing.toAlgHom
    let β'_ex : B' →ₐ[R] R := γ_R.comp loc_alg
    have hγ_R_π : (Algebra.ofId R κ).comp γ_R = s_loc := by
      have heq_symm : ((Algebra.ofId R κ).comp γ_R).comp pres.equivRing.symm.toAlgHom =
          s_loc.comp pres.equivRing.symm.toAlgHom := by
        apply StandardEtalePair.hom_ext
        change π (pres.P.lift a ha_map (pres.equivRing (pres.equivRing.symm pres.P.X))) =
          s_loc (pres.equivRing.symm pres.P.X)
        have hsymm_X : pres.equivRing.symm pres.P.X = pres.x :=
          pres.equivRing.injective (by rw [pres.equivRing.apply_symm_apply, pres.equivRing_x])
        rw [pres.equivRing.apply_symm_apply, StandardEtalePair.lift_X, hπ_a, hsymm_X]
      apply AlgHom.ext
      intro z
      have hz := AlgHom.congr_fun heq_symm (pres.equivRing z)
      simpa using hz
    have hβ'_ex_π : (Algebra.ofId R κ).comp β'_ex = s'_0 := by
      apply AlgHom.ext
      intro t
      change ((Algebra.ofId R κ).comp γ_R) (loc_alg t) = s'_0 t
      rw [hγ_R_π]
      exact IsLocalization.Away.lift_eq g_loc hg_unit_κ t

    
    have hβ'_uniq : ∀ β'_1 β'_2 : B' →ₐ[R] R,
        (Algebra.ofId R κ).comp β'_1 = s'_0 →
        (Algebra.ofId R κ).comp β'_2 = s'_0 →
        β'_1 = β'_2 := by
      intro β'_1 β'_2 h1 h2
      have hunit_loc : ∀ β' : B' →ₐ[R] R, (Algebra.ofId R κ).comp β' = s'_0 →
          IsUnit (β'.toRingHom g_loc) := by
        intro β' hβ'
        rw [← IsLocalRing.notMem_maximalIdeal, ← hπ_ker, RingHom.mem_ker]
        change π (β' g_loc) ≠ 0
        have hπg : π (β' g_loc) = s'_0 g_loc := AlgHom.congr_fun hβ' g_loc
        rw [hπg]
        exact hg_ne_κ
      have hu1 := hunit_loc β'_1 h1
      have hu2 := hunit_loc β'_2 h2
      let γ_1_ring : S_loc →+* R := IsLocalization.Away.lift g_loc hu1
      let γ_2_ring : S_loc →+* R := IsLocalization.Away.lift g_loc hu2
      let γ_1 : S_loc →ₐ[R] R :=
        { γ_1_ring with
          commutes' := fun r => by
            change γ_1_ring (algebraMap B' S_loc (algebraMap R B' r)) = r
            rw [IsLocalization.Away.lift_eq g_loc hu1]
            exact β'_1.commutes r }
      let γ_2 : S_loc →ₐ[R] R :=
        { γ_2_ring with
          commutes' := fun r => by
            change γ_2_ring (algebraMap B' S_loc (algebraMap R B' r)) = r
            rw [IsLocalization.Away.lift_eq g_loc hu2]
            exact β'_2.commutes r }
      have hγ1_π : π.comp γ_1.toRingHom = s_loc.toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers g_loc)
        apply RingHom.ext
        intro b
        change π (γ_1_ring (algebraMap B' S_loc b)) = s_loc_ring (algebraMap B' S_loc b)
        rw [IsLocalization.Away.lift_eq g_loc hu1, IsLocalization.Away.lift_eq g_loc hg_unit_κ]
        exact AlgHom.congr_fun h1 b
      have hγ2_π : π.comp γ_2.toRingHom = s_loc.toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers g_loc)
        apply RingHom.ext
        intro b
        change π (γ_2_ring (algebraMap B' S_loc b)) = s_loc_ring (algebraMap B' S_loc b)
        rw [IsLocalization.Away.lift_eq g_loc hu2, IsLocalization.Away.lift_eq g_loc hg_unit_κ]
        exact AlgHom.congr_fun h2 b

      let r_1 : R := γ_1 pres.x
      let r_2 : R := γ_2 pres.x
      have hr1_root : pres.P.f.IsRoot r_1 := (pres.hasMap.map γ_1).1
      have hr2_root : pres.P.f.IsRoot r_2 := (pres.hasMap.map γ_2).1
      have hπ_r1 : π r_1 = c_0 := RingHom.congr_fun hγ1_π pres.x
      have hπ_r2 : π r_2 = c_0 := RingHom.congr_fun hγ2_π pres.x

      obtain ⟨q_f, hqf_eq⟩ := Polynomial.dvd_iff_isRoot.mpr hr1_root
      have hprod_zero : (r_2 - r_1) * q_f.eval r_2 = 0 := by
        have hev : pres.P.f.eval r_2 = 0 := hr2_root
        rw [hqf_eq, Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X,
          Polynomial.eval_C] at hev
        exact hev
      have hdf_eq : Polynomial.derivative pres.P.f =
          q_f + (Polynomial.X - Polynomial.C r_1) * Polynomial.derivative q_f := by
        rw [hqf_eq, Polynomial.derivative_mul, Polynomial.derivative_sub,
          Polynomial.derivative_X, Polynomial.derivative_C, sub_zero, one_mul]
      have hqf_ne : q_f.eval r_2 ≠ 0 := by
        intro hqf0
        have hdf_r2 : π ((Polynomial.derivative pres.P.f).eval r_2) = 0 := by
          rw [hdf_eq, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub,
            Polynomial.eval_X, Polynomial.eval_C, hqf0, zero_add, map_mul, map_sub,
            hπ_r2, hπ_r1, sub_self, zero_mul]
        rw [hπ_eval, hπ_r2] at hdf_r2
        exact hc0_df.ne_zero hdf_r2
      have hr_eq : r_1 = r_2 :=
        (sub_eq_zero.mp ((mul_eq_zero.mp hprod_zero).resolve_right hqf_ne)).symm

      have hγ_eq : γ_1 = γ_2 := by
        have heq_symm : γ_1.comp pres.equivRing.symm.toAlgHom =
            γ_2.comp pres.equivRing.symm.toAlgHom := by
          apply StandardEtalePair.hom_ext
          have hsymm_X : pres.equivRing.symm pres.P.X = pres.x :=
            pres.equivRing.injective (by rw [pres.equivRing.apply_symm_apply, pres.equivRing_x])
          change γ_1 (pres.equivRing.symm pres.P.X) = γ_2 (pres.equivRing.symm pres.P.X)
          rw [hsymm_X]
          exact hr_eq
        apply AlgHom.ext
        intro z
        have hz := AlgHom.congr_fun heq_symm (pres.equivRing z)
        simpa using hz

      apply AlgHom.ext
      intro b
      calc
        β'_1 b = γ_1_ring (algebraMap B' S_loc b) :=
          (IsLocalization.Away.lift_eq g_loc hu1 b).symm
        _ = γ_1 (loc_alg b) := rfl
        _ = γ_2 (loc_alg b) := by rw [hγ_eq]
        _ = β'_2 b := IsLocalization.Away.lift_eq g_loc hu2 b

    
    let incR : B →+* B' := (@Algebra.TensorProduct.includeRight A R B _ _ _ _ _).toRingHom
    let β_V : B →+* R := β'_ex.toRingHom.comp incR
    refine ⟨β_V, ⟨?_, ?_⟩, ?_⟩
    · apply RingHom.ext
      intro a
      change β'_ex ((1 : R) ⊗ₜ[A] (algebraMap A B a)) = α_V a
      have hsmul : (1 : R) ⊗ₜ[A] (algebraMap A B a) = algebraMap R B' (α_V a) := by
        rw [Algebra.algebraMap_eq_smul_one, ← TensorProduct.smul_tmul]
        change (α_V a * 1) ⊗ₜ[A] (1 : B) = (α_V a) ⊗ₜ[A] (1 : B)
        rw [mul_one]
      rw [hsmul, β'_ex.commutes]
      rfl
    · apply RingHom.ext
      intro b
      change ((Algebra.ofId R κ).comp β'_ex) ((1 : R) ⊗ₜ[A] b) = s_0 b
      rw [hβ'_ex_π]
      exact (Algebra.TensorProduct.lift_tmul (Algebra.ofId R κ) s_0_alg _ (1 : R) b).trans
        (by rw [map_one, one_mul]; rfl)
    · intro β_other ⟨hβ_φ, hβ_π⟩
      let β_other_alg : B →ₐ[A] R :=
        { β_other with commutes' := fun a => RingHom.congr_fun hβ_φ a }
      let β'_other : B' →ₐ[R] R :=
        Algebra.TensorProduct.lift (AlgHom.id R R) β_other_alg (fun _ _ => mul_comm _ _)
      have hβ'_other_π : (Algebra.ofId R κ).comp β'_other = s'_0 := by
        apply AlgHom.ext
        intro t
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul r b =>
          change π (r * β_other b) = π r * s_0 b
          rw [map_mul]
          congr 1
          exact RingHom.congr_fun hβ_π b
        | add x y ihx ihy =>
          simp only [map_add, ihx, ihy]
      have heq := hβ'_uniq β'_other β'_ex hβ'_other_π hβ'_ex_π
      apply RingHom.ext
      intro b
      have hb : β'_other ((1 : R) ⊗ₜ[A] b) = β'_ex ((1 : R) ⊗ₜ[A] b) :=
        AlgHom.congr_fun heq ((1 : R) ⊗ₜ[A] b)
      have htmul : β'_other ((1 : R) ⊗ₜ[A] b) = β_other b :=
        (Algebra.TensorProduct.lift_tmul (AlgHom.id R R) β_other_alg _ (1 : R) b).trans
          (by rw [map_one, one_mul]; rfl)
      exact htmul.symm.trans hb

  
  
  
  have hPillar3 :
      ∀ (V_0 : ValuationSubring Ω_κ)
        (p_V : P_κ →+* ↥V_0)
        (π_V0 : ↥V_0 →+* κ),
        V_0.subtype.comp p_V = algebraMap P_κ Ω_κ →
        π_V0.comp p_V = Polynomial.evalRingHom 0 →
        RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 →
        ∀ (τ : κ ≃+* κ),
          ∃ (γ : Ω_κ ≃+* Ω_κ) (γ_V : ↥V_0 →+* ↥V_0),
            V_0.subtype.comp γ_V = γ.toRingHom.comp V_0.subtype ∧
            π_V0.comp γ_V = τ.toRingHom.comp π_V0 ∧
            ∀ f : P_κ,
              γ (algebraMap P_κ Ω_κ f) =
                algebraMap P_κ Ω_κ (Polynomial.map τ.toRingHom f) := by
    intro V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker τ
    let K := FractionRing P_κ

    
    let τ_P : P_κ ≃+* P_κ := Polynomial.mapEquiv τ
    have hτP_nzd : Submonoid.map τ_P.toMonoidHom (nonZeroDivisors P_κ) = nonZeroDivisors P_κ := by
      ext g
      simp only [Submonoid.mem_map, mem_nonZeroDivisors_iff_ne_zero]
      constructor
      · rintro ⟨f, hf, rfl⟩
        exact (map_ne_zero_iff τ_P τ_P.injective).mpr hf
      · intro hg
        exact ⟨τ_P.symm g, (map_ne_zero_iff τ_P.symm τ_P.symm.injective).mpr hg,
          τ_P.apply_symm_apply g⟩
    let τ_K : K ≃+* K := IsLocalization.ringEquivOfRingEquiv K K τ_P hτP_nzd
    let γ_0 : Ω_κ ≃+* Ω_κ := IsAlgClosure.equivOfEquiv Ω_κ Ω_κ τ_K
    have hγ0_P : ∀ f : P_κ,
        γ_0 (algebraMap P_κ Ω_κ f) = algebraMap P_κ Ω_κ (Polynomial.map τ.toRingHom f) := by
      intro f
      rw [IsScalarTower.algebraMap_eq P_κ K Ω_κ, RingHom.comp_apply,
        IsAlgClosure.equivOfEquiv_algebraMap, IsLocalization.ringEquivOfRingEquiv_eq]
      rfl
    have hγ0_symm_P : ∀ f : P_κ,
        γ_0.symm (algebraMap P_κ Ω_κ f) =
          algebraMap P_κ Ω_κ (Polynomial.map τ.symm.toRingHom f) := by
      intro f
      apply γ_0.injective
      rw [γ_0.apply_symm_apply, hγ0_P, Polynomial.map_map]
      have hid : τ.toRingHom.comp τ.symm.toRingHom = RingHom.id κ :=
        RingHom.ext τ.apply_symm_apply
      rw [hid, Polynomial.map_id]

    
    let W : ValuationSubring Ω_κ := V_0.comap γ_0.symm.toRingHom
    have hW_iff : ∀ x : Ω_κ, γ_0 x ∈ W ↔ x ∈ V_0 := by
      intro x
      change γ_0.symm (γ_0 x) ∈ V_0 ↔ x ∈ V_0
      rw [γ_0.symm_apply_apply]
    let A_V : ValuationSubring K := V_0.comap (algebraMap K Ω_κ)
    let A_W : ValuationSubring K := W.comap (algebraMap K Ω_κ)

    have halg_PK_inj : Function.Injective (algebraMap P_κ K) :=
      IsFractionRing.injective P_κ K

    
    have hpV_mem : ∀ f : P_κ, algebraMap P_κ Ω_κ f ∈ V_0 := by
      intro f
      have hf := RingHom.congr_fun hpV_sub f
      rw [← hf]
      exact (p_V f).2
    have hpV_inv_mem : ∀ f : P_κ, f.eval 0 ≠ 0 → (algebraMap P_κ Ω_κ f)⁻¹ ∈ V_0 := by
      intro f hf0
      have h_not_ker : p_V f ∉ RingHom.ker π_V0 := by
        rw [RingHom.mem_ker]
        have hev : π_V0 (p_V f) = f.eval 0 := by
          change (π_V0.comp p_V) f = f.eval 0
          rw [hπ_pV, Polynomial.coe_evalRingHom]
        rw [hev]
        exact hf0
      rw [hπ_ker] at h_not_ker
      have hu : IsUnit (p_V f) := IsLocalRing.notMem_maximalIdeal.mp h_not_ker
      have hf_eq : V_0.subtype (p_V f) = algebraMap P_κ Ω_κ f := RingHom.congr_fun hpV_sub f
      have hmul1 : V_0.subtype (↑(hu.unit⁻¹)) * algebraMap P_κ Ω_κ f = 1 := by
        rw [← hf_eq, ← map_mul, IsUnit.val_inv_mul, map_one]
      rw [inv_eq_of_mul_eq_one_left hmul1]
      exact (↑(hu.unit⁻¹) : ↥V_0).2
    have hpV_X_inv_not_mem : (algebraMap P_κ Ω_κ Polynomial.X)⁻¹ ∉ V_0 := by
      intro hmem
      have hX_ne : algebraMap P_κ Ω_κ Polynomial.X ≠ 0 := by
        rw [IsScalarTower.algebraMap_eq P_κ K Ω_κ, RingHom.comp_apply]
        exact (map_ne_zero_iff _ (RingHom.injective _)).mpr
          ((map_ne_zero_iff _ halg_PK_inj).mpr Polynomial.X_ne_zero)
      have h1 : V_0.subtype (p_V Polynomial.X * ⟨_, hmem⟩) = 1 := by
        rw [map_mul]
        have hf_eq : V_0.subtype (p_V Polynomial.X) = algebraMap P_κ Ω_κ Polynomial.X :=
          RingHom.congr_fun hpV_sub Polynomial.X
        exact (by rw [hf_eq]; exact mul_inv_cancel₀ hX_ne)
      have hpX_unit : IsUnit (p_V Polynomial.X) :=
        isUnit_iff_exists_inv.mpr ⟨⟨_, hmem⟩, V_0.subtype_injective h1⟩
      have h0_unit : IsUnit (π_V0 (p_V Polynomial.X)) := hpX_unit.map π_V0
      have hev0 : π_V0 (p_V Polynomial.X) = 0 := by
        change (π_V0.comp p_V) Polynomial.X = 0
        rw [hπ_pV, Polynomial.coe_evalRingHom, Polynomial.eval_X]
      rw [hev0] at h0_unit
      exact not_isUnit_zero h0_unit

    
    let M_X : Ideal P_κ := Ideal.span {Polynomial.X}
    have hMX_mem_iff : ∀ f : P_κ, f ∈ M_X ↔ f.eval 0 = 0 := by
      intro f
      rw [Ideal.mem_span_singleton]
      simpa using (Polynomial.dvd_iff_isRoot : Polynomial.X - Polynomial.C (0 : κ) ∣ f ↔ f.IsRoot 0)
    have hMX_eq_ker : M_X = RingHom.ker (Polynomial.evalRingHom (0 : κ)) := by
      ext f
      exact hMX_mem_iff f
    haveI : M_X.IsPrime := by
      rw [hMX_eq_ker]
      exact RingHom.ker_isPrime _
    have hMX_ne_bot : M_X ≠ ⊥ := by
      intro hbot
      have hX : (Polynomial.X : P_κ) ∈ (⊥ : Ideal P_κ) := hbot ▸ Ideal.mem_span_singleton_self _
      exact Polynomial.X_ne_zero (Ideal.mem_bot.mp hX)

    let R_X := Localization.AtPrime M_X
    have hMX_units_K : ∀ s : M_X.primeCompl, IsUnit (algebraMap P_κ K s.1) := by
      intro s
      have hs_ne : s.1 ≠ 0 := fun h0 => s.2 (h0 ▸ M_X.zero_mem)
      exact isUnit_iff_ne_zero.mpr ((map_ne_zero_iff _ halg_PK_inj).mpr hs_ne)
    let j_X : R_X →+* K := IsLocalization.lift hMX_units_K
    have hjX_inj : Function.Injective j_X := by
      rw [injective_iff_map_eq_zero]
      intro w hw
      obtain ⟨⟨f, s⟩, hws⟩ := IsLocalization.surj M_X.primeCompl w
      have hf0 : algebraMap P_κ K f = 0 := by
        calc
          algebraMap P_κ K f = j_X (algebraMap P_κ R_X f) :=
            (IsLocalization.lift_eq hMX_units_K f).symm
          _ = j_X (w * algebraMap P_κ R_X s.1) := by rw [← hws]
          _ = j_X w * j_X (algebraMap P_κ R_X s.1) := map_mul _ _ _
          _ = 0 := by rw [hw, zero_mul]
      have hf_eq0 : f = 0 := halg_PK_inj (hf0.trans (map_zero _).symm)
      have hw_mul : w * algebraMap P_κ R_X s.1 = 0 := by rw [hws, hf_eq0, map_zero]
      exact (IsLocalization.map_units R_X s).mul_left_eq_zero.mp hw_mul

    
    have hPolyFactor : ∀ (d : ℕ) (f : P_κ), f.natDegree ≤ d → f ≠ 0 →
        ∃ (a : ℕ) (f_0 : P_κ), f_0.eval 0 ≠ 0 ∧ f = Polynomial.X ^ a * f_0 := by
      intro d
      induction d with
      | zero =>
        intro f hdeg hf_ne
        refine ⟨0, f, ?_, by rw [pow_zero, one_mul]⟩
        intro hev0
        obtain ⟨g, hg⟩ := (Ideal.mem_span_singleton.mp ((hMX_mem_iff f).mpr hev0))
        have hg_ne : g ≠ 0 := fun hg0 => hf_ne (by rw [hg, hg0, mul_zero])
        have hdeg_f : f.natDegree = 1 + g.natDegree := by
          rw [hg, Polynomial.natDegree_mul Polynomial.X_ne_zero hg_ne, Polynomial.natDegree_X]
        omega
      | succ d ih =>
        intro f hdeg hf_ne
        by_cases hev0 : f.eval 0 = 0
        · obtain ⟨g, hg⟩ := Ideal.mem_span_singleton.mp ((hMX_mem_iff f).mpr hev0)
          have hg_ne : g ≠ 0 := fun hg0 => hf_ne (by rw [hg, hg0, mul_zero])
          have hdeg_g : g.natDegree ≤ d := by
            have hdeg_f : f.natDegree = 1 + g.natDegree := by
              rw [hg, Polynomial.natDegree_mul Polynomial.X_ne_zero hg_ne, Polynomial.natDegree_X]
            omega
          obtain ⟨a, f_0, hf0, hg_eq⟩ := ih g hdeg_g hg_ne
          exact ⟨a + 1, f_0, hf0, by rw [hg, hg_eq, pow_succ', mul_assoc]⟩
        · exact ⟨0, f, hev0, by rw [pow_zero, one_mul]⟩

    
    have hChar_RX : ∀ U : ValuationSubring K,
        (∀ f : P_κ, algebraMap P_κ K f ∈ U) →
        (∀ f : P_κ, f.eval 0 ≠ 0 → (algebraMap P_κ K f)⁻¹ ∈ U) →
        (algebraMap P_κ K Polynomial.X)⁻¹ ∉ U →
        ∀ z : K, z ∈ U ↔ z ∈ j_X.range := by
      intro U hU_poly hU_unit hU_X z
      constructor
      · intro hzU
        by_cases hz0 : z = 0
        · exact ⟨0, (map_zero j_X).trans hz0.symm⟩
        · obtain ⟨f, g, hg_nzd, hfg⟩ := IsFractionRing.div_surjective (A := P_κ) z
          have hg_ne : g ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hg_nzd
          have hf_ne : f ≠ 0 := by
            intro hf0
            rw [hf0, map_zero, zero_div] at hfg
            exact hz0 hfg.symm
          obtain ⟨a, f_0, hf0, rfl⟩ := hPolyFactor f.natDegree f le_rfl hf_ne
          obtain ⟨b, g_0, hg0, rfl⟩ := hPolyFactor g.natDegree g le_rfl hg_ne
          let t_K : K := algebraMap P_κ K Polynomial.X
          have htK_ne : t_K ≠ 0 := (map_ne_zero_iff _ halg_PK_inj).mpr Polynomial.X_ne_zero
          have hf0_ne : algebraMap P_κ K f_0 ≠ 0 :=
            (map_ne_zero_iff _ halg_PK_inj).mpr (fun h0 => hf0 (by rw [h0, Polynomial.eval_zero]))
          have hg0_ne : algebraMap P_κ K g_0 ≠ 0 :=
            (map_ne_zero_iff _ halg_PK_inj).mpr (fun h0 => hg0 (by rw [h0, Polynomial.eval_zero]))
          have hdenom_ne : t_K ^ b * algebraMap P_κ K g_0 ≠ 0 :=
            mul_ne_zero (pow_ne_zero b htK_ne) hg0_ne
          have hfg_mul : t_K ^ a * algebraMap P_κ K f_0 =
              z * (t_K ^ b * algebraMap P_κ K g_0) := by
            rw [map_mul, map_pow, map_mul, map_pow] at hfg
            exact (div_eq_iff hdenom_ne).mp hfg
          have hblea : b ≤ a := by
            by_contra hlt
            have hab : a + 1 ≤ b := Nat.lt_of_not_ge hlt
            let d := b - (a + 1)
            have hb_eq : b = a + (d + 1) := by omega
            have hcancel_a : algebraMap P_κ K f_0 =
                (z * algebraMap P_κ K g_0 * t_K ^ d) * t_K := by
              apply mul_left_cancel₀ (pow_ne_zero a htK_ne)
              calc
                t_K ^ a * algebraMap P_κ K f_0
                  = z * (t_K ^ b * algebraMap P_κ K g_0) := hfg_mul
                _ = z * (t_K ^ a * (t_K ^ d * t_K) * algebraMap P_κ K g_0) := by
                  rw [hb_eq, pow_add, pow_succ]
                _ = t_K ^ a * ((z * algebraMap P_κ K g_0 * t_K ^ d) * t_K) := by ring
            have hmul1 : ((algebraMap P_κ K f_0)⁻¹ * z * algebraMap P_κ K g_0 * t_K ^ d) * t_K =
                1 := by
              calc
                ((algebraMap P_κ K f_0)⁻¹ * z * algebraMap P_κ K g_0 * t_K ^ d) * t_K
                  = (algebraMap P_κ K f_0)⁻¹ * ((z * algebraMap P_κ K g_0 * t_K ^ d) * t_K) := by
                    ring
                _ = (algebraMap P_κ K f_0)⁻¹ * algebraMap P_κ K f_0 := by rw [← hcancel_a]
                _ = 1 := inv_mul_cancel₀ hf0_ne
            have ht_inv_eq : t_K⁻¹ =
                (algebraMap P_κ K f_0)⁻¹ * z * algebraMap P_κ K g_0 * t_K ^ d :=
              inv_eq_of_mul_eq_one_left hmul1
            have ht_mem : t_K⁻¹ ∈ U := by
              rw [ht_inv_eq]
              exact mul_mem (mul_mem (mul_mem (hU_unit f_0 hf0) hzU) (hU_poly g_0))
                (pow_mem (hU_poly Polynomial.X) d)
            exact hU_X ht_mem
          let f' : P_κ := Polynomial.X ^ (a - b) * f_0
          have hg0_compl : g_0 ∈ M_X.primeCompl := fun hmem => hg0 ((hMX_mem_iff g_0).mp hmem)
          refine ⟨IsLocalization.mk' R_X f' ⟨g_0, hg0_compl⟩, ?_⟩
          change j_X (IsLocalization.mk' R_X f' ⟨g_0, hg0_compl⟩) = z
          rw [IsLocalization.lift_mk'_spec]
          dsimp [f']
          rw [map_mul, map_pow]
          apply mul_right_cancel₀ (pow_ne_zero b htK_ne)
          calc
            t_K ^ (a - b) * algebraMap P_κ K f_0 * t_K ^ b
              = (t_K ^ (a - b) * t_K ^ b) * algebraMap P_κ K f_0 := by ring
            _ = t_K ^ a * algebraMap P_κ K f_0 := by rw [← pow_add, Nat.sub_add_cancel hblea]
            _ = z * (t_K ^ b * algebraMap P_κ K g_0) := hfg_mul
            _ = algebraMap P_κ K g_0 * z * t_K ^ b := by ring
      · rintro ⟨w, rfl⟩
        obtain ⟨⟨f, s⟩, hws⟩ := IsLocalization.surj M_X.primeCompl w
        have hs0 : s.1.eval 0 ≠ 0 := fun h0 => s.2 ((hMX_mem_iff s.1).mpr h0)
        have hs_ne : algebraMap P_κ K s.1 ≠ 0 :=
          (map_ne_zero_iff _ halg_PK_inj).mpr (fun h0 => hs0 (by rw [h0, Polynomial.eval_zero]))
        have hjw : j_X w = algebraMap P_κ K f * (algebraMap P_κ K s.1)⁻¹ := by
          apply mul_right_cancel₀ hs_ne
          rw [inv_mul_cancel_right₀ hs_ne]
          calc
            j_X w * algebraMap P_κ K s.1
              = j_X w * j_X (algebraMap P_κ R_X s.1) := by
                rw [IsLocalization.lift_eq hMX_units_K s.1]
            _ = j_X (algebraMap P_κ R_X f) := by rw [← map_mul, hws]
            _ = algebraMap P_κ K f := IsLocalization.lift_eq hMX_units_K f
        rw [hjw]
        exact mul_mem (hU_poly f) (hU_unit s.1 hs0)

    have hAV_range : ∀ z : K, z ∈ A_V ↔ z ∈ j_X.range := by
      apply hChar_RX A_V
      · intro f
        change algebraMap K Ω_κ (algebraMap P_κ K f) ∈ V_0
        rw [← IsScalarTower.algebraMap_apply P_κ K Ω_κ]
        exact hpV_mem f
      · intro f hf0
        change algebraMap K Ω_κ (algebraMap P_κ K f)⁻¹ ∈ V_0
        rw [map_inv₀, ← IsScalarTower.algebraMap_apply P_κ K Ω_κ]
        exact hpV_inv_mem f hf0
      · change algebraMap K Ω_κ (algebraMap P_κ K Polynomial.X)⁻¹ ∉ V_0
        rw [map_inv₀, ← IsScalarTower.algebraMap_apply P_κ K Ω_κ]
        exact hpV_X_inv_not_mem

    have hAW_range : ∀ z : K, z ∈ A_W ↔ z ∈ j_X.range := by
      apply hChar_RX A_W
      · intro f
        change γ_0.symm (algebraMap K Ω_κ (algebraMap P_κ K f)) ∈ V_0
        rw [← IsScalarTower.algebraMap_apply P_κ K Ω_κ, hγ0_symm_P]
        exact hpV_mem _
      · intro f hf0
        change γ_0.symm (algebraMap K Ω_κ (algebraMap P_κ K f)⁻¹) ∈ V_0
        rw [map_inv₀, map_inv₀, ← IsScalarTower.algebraMap_apply P_κ K Ω_κ, hγ0_symm_P]
        apply hpV_inv_mem
        rw [← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_map,
          Polynomial.coeff_zero_eq_eval_zero]
        exact (map_ne_zero_iff τ.symm τ.symm.injective).mpr hf0
      · change γ_0.symm (algebraMap K Ω_κ (algebraMap P_κ K Polynomial.X)⁻¹) ∉ V_0
        rw [map_inv₀, map_inv₀, ← IsScalarTower.algebraMap_apply P_κ K Ω_κ, hγ0_symm_P,
          Polynomial.map_X]
        exact hpV_X_inv_not_mem

    have hAW_eq_AV : A_W = A_V := by
      ext z
      exact (hAW_range z).trans (hAV_range z).symm

    
    have hMX_nzd : M_X.primeCompl ≤ nonZeroDivisors P_κ := by
      intro s hs
      exact mem_nonZeroDivisors_of_ne_zero fun h0 => hs (h0 ▸ M_X.zero_mem)
    haveI : IsDomain R_X := IsLocalization.isDomain_of_le_nonZeroDivisors R_X hMX_nzd
    haveI : IsDiscreteValuationRing R_X :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain P_κ hMX_ne_bot R_X
    let e_RX_AV : R_X ≃+* ↥A_V :=
      RingEquiv.ofBijective
        (j_X.codRestrict A_V.toSubring fun w => (hAV_range (j_X w)).mpr ⟨w, rfl⟩)
        ⟨fun x y h => hjX_inj (congrArg Subtype.val h),
          fun ⟨z, hz⟩ => by
            obtain ⟨w, rfl⟩ := (hAV_range z).mp hz
            exact ⟨w, rfl⟩⟩
    haveI : IsDiscreteValuationRing ↥A_V :=
      IsDiscreteValuationRing.RingEquivClass.isDiscreteValuationRing e_RX_AV
    haveI : IsDedekindDomain ↥A_V := inferInstance

    
    let K_sep := ↥(separableClosure K Ω_κ)
    haveI : IsGalois K K_sep := separableClosure.isGalois K Ω_κ
    haveI : Algebra.IsSeparable K K_sep := separableClosure.isSeparable K Ω_κ
    haveI : IsPurelyInseparable K_sep Ω_κ := separableClosure.isPurelyInseparable K Ω_κ

    letI : Algebra ↥A_V K_sep := ((algebraMap K K_sep).comp (algebraMap ↥A_V K)).toAlgebra
    haveI : IsScalarTower ↥A_V K K_sep := IsScalarTower.of_algebraMap_eq' rfl

    let G := K_sep ≃ₐ[K] K_sep
    let B_sep := integralClosure ↥A_V K_sep
    haveI : SMulCommClass G ↥A_V ↥B_sep :=
      ⟨fun σ a b => Subtype.ext <| by
        change σ (algebraMap ↥A_V K_sep a * (b : K_sep)) =
          algebraMap ↥A_V K_sep a * σ (b : K_sep)
        rw [map_mul, IsScalarTower.algebraMap_apply ↥A_V K K_sep, σ.commutes]⟩

    letI : TopologicalSpace ↥B_sep := ⊥
    haveI : DiscreteTopology ↥B_sep := ⟨rfl⟩
    haveI : ContinuousSMul G ↥B_sep := by
      refine ContinuousSMul.mk ?_
      rw [continuous_iff_continuousAt]
      rintro ⟨σ₀, b₀⟩
      rw [ContinuousAt, nhds_prod_eq, @nhds_discrete ↥B_sep, Filter.tendsto_pure]
      let E : IntermediateField K K_sep := IntermediateField.adjoin K {(b₀ : K_sep)}
      have hb₀_int : IsIntegral K (b₀ : K_sep) :=
        (Algebra.IsAlgebraic.isAlgebraic (b₀ : K_sep)).isIntegral
      haveI : FiniteDimensional K ↥E := IntermediateField.adjoin.finiteDimensional hb₀_int
      have hfix_nhds1 : (E.fixingSubgroup : Set G) ∈ nhds (1 : G) :=
        (krullTopology_mem_nhds_one_iff K K_sep _).mpr ⟨E, inferInstance, le_rfl⟩
      have hcont_mul : ContinuousAt (fun τ : G => σ₀⁻¹ * τ) σ₀ :=
        continuous_const.mul continuous_id |>.continuousAt
      have hU_nhds : {τ : G | σ₀⁻¹ * τ ∈ E.fixingSubgroup} ∈ nhds σ₀ := by
        have hmem1 : (E.fixingSubgroup : Set G) ∈ nhds (σ₀⁻¹ * σ₀) := by
          rw [inv_mul_cancel]
          exact hfix_nhds1
        exact hcont_mul hmem1
      refine Filter.mem_of_superset (Filter.prod_mem_prod hU_nhds (Filter.mem_pure.mpr rfl)) ?_
      rintro ⟨τ_g, b⟩ ⟨hτ_mem, rfl⟩
      apply Subtype.ext
      change τ_g (b₀ : K_sep) = σ₀ (b₀ : K_sep)
      have hfix_b₀ : (σ₀⁻¹ * τ_g) (b₀ : K_sep) = (b₀ : K_sep) :=
        hτ_mem ⟨(b₀ : K_sep), IntermediateField.mem_adjoin_simple_self K (b₀ : K_sep)⟩
      calc
        τ_g (b₀ : K_sep) = (σ₀ * (σ₀⁻¹ * τ_g)) (b₀ : K_sep) := by
          rw [← mul_assoc, mul_inv_cancel, one_mul]
        _ = σ₀ ((σ₀⁻¹ * τ_g) (b₀ : K_sep)) := rfl
        _ = σ₀ (b₀ : K_sep) := congrArg σ₀ hfix_b₀

    haveI : Algebra.IsInvariant ↥A_V ↥B_sep G := by
      refine Algebra.IsInvariant.mk ?_
      intro b hb_fix
      have hfix_K : ∀ σ : G, σ (b : K_sep) = (b : K_sep) := fun σ =>
        congrArg Subtype.val (hb_fix σ)
      obtain ⟨x, hx⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed (b : K_sep)).mpr hfix_K
      have hx_int_sep : IsIntegral ↥A_V (algebraMap K K_sep x) := hx.symm ▸ b.2
      have hx_int_K : IsIntegral ↥A_V x := by
        obtain ⟨P_m, hPm_mon, hPm_ev⟩ := hx_int_sep
        refine ⟨P_m, hPm_mon, (RingHom.injective (algebraMap K K_sep)) ?_⟩
        rw [map_zero, ← hPm_ev]
        change (algebraMap K K_sep) (Polynomial.eval₂ (algebraMap ↥A_V K) x P_m) =
          Polynomial.eval₂ (algebraMap ↥A_V K_sep) (algebraMap K K_sep x) P_m
        rw [Polynomial.hom_eval₂]
        rfl
      obtain ⟨a, ha⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥A_V) (K := K)).mp hx_int_K
      refine ⟨a, Subtype.ext ?_⟩
      change algebraMap ↥A_V K_sep a = (b : K_sep)
      rw [IsScalarTower.algebraMap_apply ↥A_V K K_sep, ha, hx]

    let V_1 : ValuationSubring K_sep := V_0.comap (algebraMap K_sep Ω_κ)
    let V_2 : ValuationSubring K_sep := W.comap (algebraMap K_sep Ω_κ)
    have hV1_K : V_1.comap (algebraMap K K_sep) = A_V := by
      ext z
      change algebraMap K_sep Ω_κ (algebraMap K K_sep z) ∈ V_0 ↔ algebraMap K Ω_κ z ∈ V_0
      rw [← IsScalarTower.algebraMap_apply K K_sep Ω_κ]
    have hV2_K : V_2.comap (algebraMap K K_sep) = A_V := by
      rw [← hAW_eq_AV]
      ext z
      change algebraMap K_sep Ω_κ (algebraMap K K_sep z) ∈ W ↔ algebraMap K Ω_κ z ∈ W
      rw [← IsScalarTower.algebraMap_apply K K_sep Ω_κ]

    have hBsep_mem : ∀ (U : ValuationSubring K_sep),
        U.comap (algebraMap K K_sep) = A_V → ∀ b : ↥B_sep, (b : K_sep) ∈ U := by
      intro U hUK b
      let φ_AV_U : ↥A_V →+* ↥U :=
        { toFun := fun a => ⟨algebraMap K K_sep a.1, by
            change a.1 ∈ U.comap (algebraMap K K_sep)
            rw [hUK]; exact a.2⟩
          map_one' := Subtype.ext (map_one _)
          map_mul' := fun x y => Subtype.ext (map_mul _ _ _)
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun x y => Subtype.ext (map_add _ _ _) }
      obtain ⟨P_mon, hP_mon, hP_ev⟩ := b.2
      have h_int_U : IsIntegral ↥U (b : K_sep) := by
        refine ⟨P_mon.map φ_AV_U, hP_mon.map φ_AV_U, ?_⟩
        rw [Polynomial.eval₂_map]
        exact hP_ev
      obtain ⟨u, hu⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥U) (K := K_sep)).mp h_int_U
      exact hu ▸ u.2

    let ι_B1 : ↥B_sep →+* ↥V_1 :=
      { toFun := fun b => ⟨(b : K_sep), hBsep_mem V_1 hV1_K b⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let ι_B2 : ↥B_sep →+* ↥V_2 :=
      { toFun := fun b => ⟨(b : K_sep), hBsep_mem V_2 hV2_K b⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }

    let P_1 : Ideal ↥B_sep := Ideal.comap ι_B1 (IsLocalRing.maximalIdeal ↥V_1)
    let P_2 : Ideal ↥B_sep := Ideal.comap ι_B2 (IsLocalRing.maximalIdeal ↥V_2)
    haveI : P_1.IsPrime := Ideal.comap_isPrime ι_B1 (IsLocalRing.maximalIdeal ↥V_1)
    haveI : P_2.IsPrime := Ideal.comap_isPrime ι_B2 (IsLocalRing.maximalIdeal ↥V_2)

    have hUnder_eq : ∀ (U : ValuationSubring K_sep) (hUK : U.comap (algebraMap K K_sep) = A_V)
        (ι_BU : ↥B_sep →+* ↥U),
        (∀ b : ↥B_sep, (ι_BU b : K_sep) = (b : K_sep)) →
        Ideal.under ↥A_V (Ideal.comap ι_BU (IsLocalRing.maximalIdeal ↥U)) =
          IsLocalRing.maximalIdeal ↥A_V := by
      intro U hUK ι_BU hι_val
      ext a
      simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal]
      apply not_iff_not.mpr
      constructor
      · intro hu_U
        by_cases ha0 : a = 0
        · subst ha0
          rw [map_zero, map_zero] at hu_U
          exact False.elim (not_isUnit_zero hu_U)
        · let a_K : K := a.1
          have haK_ne : a_K ≠ 0 := fun h0 => ha0 (Subtype.ext h0)
          obtain ⟨v_u, hv_u⟩ := hu_U
          have hval_inv : (algebraMap K K_sep a_K)⁻¹ = (↑(v_u⁻¹) : ↥U).1 := by
            have h1 : (↑(v_u⁻¹) : ↥U).1 * algebraMap K K_sep a_K = 1 := by
              have h2 := congrArg Subtype.val v_u.inv_val
              rw [Subring.coe_mul, hv_u, hι_val] at h2
              exact h2
            exact inv_eq_of_mul_eq_one_left h1
          have hmem_comap : a_K⁻¹ ∈ U.comap (algebraMap K K_sep) := by
            change algebraMap K K_sep a_K⁻¹ ∈ U
            rw [map_inv₀, hval_inv]
            exact (↑(v_u⁻¹) : ↥U).2
          have ha_inv_AV : a_K⁻¹ ∈ A_V := hUK ▸ hmem_comap
          exact isUnit_iff_exists_inv.mpr ⟨⟨a_K⁻¹, ha_inv_AV⟩,
            Subtype.ext (mul_inv_cancel₀ haK_ne)⟩
      · intro hu_AV
        exact (hu_AV.map (algebraMap ↥A_V ↥B_sep)).map ι_BU

    have hP_under : Ideal.under ↥A_V P_2 = Ideal.under ↥A_V P_1 :=
      (hUnder_eq V_2 hV2_K ι_B2 fun _ => rfl).trans
        (hUnder_eq V_1 hV1_K ι_B1 fun _ => rfl).symm

    obtain ⟨σ_sep, hP1_eq⟩ :=
      Algebra.IsInvariant.exists_smul_of_under_eq_of_profinite (G := G) P_2 P_1 hP_under

    
    have hDVR_div : ∀ (B₀ : Type u) [CommRing B₀] [IsDedekindDomain B₀]
        (p₀ : Ideal B₀) [p₀.IsPrime], p₀ ≠ ⊥ →
        ∀ (φ₀ : B₀ →+* ↥V_2),
          (∀ y : B₀, y ∈ p₀ ↔ φ₀ y ∈ IsLocalRing.maximalIdeal ↥V_2) →
          ∀ (w_v2 : ↥V_2) (a b : B₀),
            φ₀ b ≠ 0 →
            φ₀ a = w_v2 * φ₀ b →
            ∃ (c₀ s₀ : B₀), s₀ ∉ p₀ ∧ b * c₀ = a * s₀ := by
      intro B₀ _ _ p₀ _ hp₀_ne φ₀ hφ₀_iff w_v2 a b hφb_ne hφ_ab_eq
      let L₀ := Localization.AtPrime p₀
      have hp₀_nzd : p₀.primeCompl ≤ nonZeroDivisors B₀ :=
        fun s hs => mem_nonZeroDivisors_of_ne_zero fun h0 => hs (h0 ▸ p₀.zero_mem)
      haveI : IsDomain L₀ := IsLocalization.isDomain_of_le_nonZeroDivisors L₀ hp₀_nzd
      haveI : IsDiscreteValuationRing L₀ :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain B₀ hp₀_ne L₀
      haveI : ValuationRing L₀ := inferInstance
      have halg_L0_inj : Function.Injective (algebraMap B₀ L₀) :=
        IsLocalization.injective L₀ hp₀_nzd
      have hp₀_units : ∀ s : p₀.primeCompl, IsUnit (φ₀ s.1) :=
        fun s => IsLocalRing.notMem_maximalIdeal.mp (mt (hφ₀_iff s.1).mpr s.2)
      let φ_L0 : L₀ →+* ↥V_2 := IsLocalization.lift hp₀_units
      have hFromDiv : ∀ d : L₀, algebraMap B₀ L₀ b * d = algebraMap B₀ L₀ a →
          ∃ (c₀ s₀ : B₀), s₀ ∉ p₀ ∧ b * c₀ = a * s₀ := by
        intro d hd
        obtain ⟨⟨c₀, s₀⟩, hds⟩ := IsLocalization.surj p₀.primeCompl d
        refine ⟨c₀, s₀.1, s₀.2, halg_L0_inj ?_⟩
        rw [map_mul, map_mul, ← hd, mul_assoc, hds]
      obtain ⟨d, hd | hd⟩ := ValuationRing.cond (algebraMap B₀ L₀ a) (algebraMap B₀ L₀ b)
      · by_cases hd_unit : IsUnit d
        · refine hFromDiv (↑(hd_unit.unit⁻¹)) ?_
          rw [← hd, mul_assoc, IsUnit.mul_val_inv, mul_one]
        · exfalso
          have hd_max : d ∈ IsLocalRing.maximalIdeal L₀ :=
            (IsLocalRing.mem_maximalIdeal d).mpr hd_unit
          obtain ⟨⟨y, s⟩, hys⟩ := IsLocalization.surj p₀.primeCompl d
          have hy_map_max : algebraMap B₀ L₀ y ∈ IsLocalRing.maximalIdeal L₀ := by
            rw [← hys]
            exact (IsLocalRing.maximalIdeal L₀).mul_mem_right _ hd_max
          have hy_p0 : y ∈ p₀ :=
            (IsLocalization.AtPrime.to_map_mem_maximal_iff L₀ p₀ y).mp hy_map_max
          have hφy_max : φ₀ y ∈ IsLocalRing.maximalIdeal ↥V_2 := (hφ₀_iff y).mp hy_p0
          let u_s : (↥V_2)ˣ := (hp₀_units s).unit
          have hmul_eq : φ_L0 d * ↑u_s = φ₀ y := by
            change φ_L0 d * φ₀ s.1 = φ₀ y
            rw [← IsLocalization.lift_eq (S := L₀) hp₀_units s.1, ← map_mul, hys,
              IsLocalization.lift_eq (S := L₀) hp₀_units y]
          have hd_eq : φ_L0 d = φ₀ y * ↑(u_s⁻¹) := by
            rw [← hmul_eq, mul_assoc, Units.mul_inv, mul_one]
          have hφd_max : φ_L0 d ∈ IsLocalRing.maximalIdeal ↥V_2 :=
            hd_eq ▸ (IsLocalRing.maximalIdeal ↥V_2).mul_mem_right _ hφy_max
          have hφ_b_eq : φ₀ b = (w_v2 * φ_L0 d) * φ₀ b := by
            have h1 := congrArg φ_L0 hd.symm
            rw [map_mul, IsLocalization.lift_eq hp₀_units b,
              IsLocalization.lift_eq hp₀_units a, hφ_ab_eq] at h1
            calc
              φ₀ b = (w_v2 * φ₀ b) * φ_L0 d := h1
              _ = (w_v2 * φ_L0 d) * φ₀ b := by ring
          have h1_eq : (1 : ↥V_2) = w_v2 * φ_L0 d := by
            apply mul_right_cancel₀ hφb_ne
            rw [one_mul, ← hφ_b_eq]
          have h1_max : (1 : ↥V_2) ∈ IsLocalRing.maximalIdeal ↥V_2 :=
            h1_eq ▸ (IsLocalRing.maximalIdeal ↥V_2).mul_mem_left _ hφd_max
          exact (IsLocalRing.maximalIdeal.isMaximal ↥V_2).ne_top
            ((IsLocalRing.maximalIdeal ↥V_2).eq_top_of_isUnit_mem h1_max isUnit_one)
      · exact hFromDiv d hd

    have hFrac_V2 : ∀ w : K_sep, w ∈ V_2 →
        ∃ (c s : ↥B_sep), s ∉ P_2 ∧ w = (c : K_sep) * (s : K_sep)⁻¹ := by
      intro w hw
      let E : IntermediateField K K_sep := IntermediateField.adjoin K {w}
      have hw_int : IsIntegral K w := (Algebra.IsAlgebraic.isAlgebraic w).isIntegral
      haveI : FiniteDimensional K ↥E := IntermediateField.adjoin.finiteDimensional hw_int
      haveI : Algebra.IsSeparable K ↥E := inferInstance
      letI : Algebra ↥A_V ↥E := ((algebraMap K ↥E).comp (algebraMap ↥A_V K)).toAlgebra
      haveI : IsScalarTower ↥A_V K ↥E := IsScalarTower.of_algebraMap_eq' rfl

      let B_E := integralClosure ↥A_V ↥E
      haveI : IsDedekindDomain ↥B_E := integralClosure.isDedekindDomain ↥A_V K ↥E
      haveI : IsFractionRing ↥B_E ↥E :=
        integralClosure.isFractionRing_of_finite_extension (A := ↥A_V) K ↥E

      let j_BE : ↥B_E →+* ↥B_sep :=
        { toFun := fun x => ⟨(x : ↥E).1, x.2.map E.val⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      let p_E : Ideal ↥B_E := Ideal.comap j_BE P_2
      haveI : p_E.IsPrime := Ideal.comap_isPrime j_BE P_2
      have hp_E_ne_bot : p_E ≠ ⊥ := by
        intro hbot
        let t_X : K := algebraMap P_κ K Polynomial.X
        let t_AV : ↥A_V := ⟨t_X, by
          change algebraMap K Ω_κ t_X ∈ V_0
          rw [← IsScalarTower.algebraMap_apply P_κ K Ω_κ]
          exact hpV_mem Polynomial.X⟩
        let t_BE : ↥B_E := algebraMap ↥A_V ↥B_E t_AV
        have ht_mem_P2 : j_BE t_BE ∈ P_2 := by
          have ht_AV_max : t_AV ∈ IsLocalRing.maximalIdeal ↥A_V := by
            rw [IsLocalRing.mem_maximalIdeal]
            intro hu_t
            obtain ⟨v_t, hv_t⟩ := hu_t
            have hinv_mem : t_X⁻¹ ∈ A_V := by
              have h1 : (↑(v_t⁻¹) : ↥A_V).1 * t_X = 1 := by
                have h2 := congrArg Subtype.val v_t.inv_val
                rw [Subring.coe_mul, hv_t] at h2
                exact h2
              rw [inv_eq_of_mul_eq_one_left h1]
              exact (↑(v_t⁻¹) : ↥A_V).2
            change algebraMap K Ω_κ t_X⁻¹ ∈ V_0 at hinv_mem
            rw [map_inv₀, ← IsScalarTower.algebraMap_apply P_κ K Ω_κ] at hinv_mem
            exact hpV_X_inv_not_mem hinv_mem
          have hjb_eq : j_BE t_BE = algebraMap ↥A_V ↥B_sep t_AV := Subtype.ext <| by
            change ((algebraMap ↥A_V ↥E t_AV : ↥E) : K_sep) = algebraMap ↥A_V K_sep t_AV
            rw [IsScalarTower.algebraMap_apply ↥A_V K ↥E,
              IsScalarTower.algebraMap_apply ↥A_V K K_sep]
            rfl
          rw [hjb_eq]
          change t_AV ∈ Ideal.under ↥A_V P_2
          rw [hUnder_eq V_2 hV2_K ι_B2 fun _ => rfl]
          exact ht_AV_max
        have ht_bot : t_BE ∈ (⊥ : Ideal ↥B_E) := hbot ▸ ht_mem_P2
        have ht_zero : (t_BE : ↥E).1 = 0 := congrArg (fun x : ↥B_E => (x : ↥E).1)
          (Ideal.mem_bot.mp ht_bot)
        have ht_ne : ((t_BE : ↥E) : K_sep) ≠ 0 := by
          change algebraMap K K_sep t_X ≠ 0
          exact (map_ne_zero_iff _ (RingHom.injective _)).mpr
            ((map_ne_zero_iff _ halg_PK_inj).mpr Polynomial.X_ne_zero)
        exact ht_ne ht_zero

      let w_E : ↥E := ⟨w, IntermediateField.mem_adjoin_simple_self K w⟩
      obtain ⟨a, b, hb_nzd, hab_div⟩ := IsFractionRing.div_surjective (A := ↥B_E) w_E
      have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
      have hb_Ksep_ne : ((b : ↥E) : K_sep) ≠ 0 := by
        intro h0
        exact hb_ne (Subtype.ext (Subtype.ext h0))
      have ha_eq_wb : ((a : ↥E) : K_sep) = w * ((b : ↥E) : K_sep) := by
        have h1 := congrArg (fun x : ↥E => (x : K_sep)) hab_div
        change ((a : ↥E) : K_sep) / ((b : ↥E) : K_sep) = w at h1
        exact (div_eq_iff hb_Ksep_ne).mp h1

      have hφb_ne : (ι_B2.comp j_BE) b ≠ 0 :=
        fun h0 => hb_Ksep_ne (congrArg Subtype.val h0)
      have ha_v2 : (ι_B2.comp j_BE) a = ⟨w, hw⟩ * (ι_B2.comp j_BE) b :=
        Subtype.ext ha_eq_wb
      obtain ⟨c₀, s₀, hs₀_not_pE, h_eq_BE⟩ :=
        hDVR_div ↥B_E p_E hp_E_ne_bot (ι_B2.comp j_BE) (fun _ => Iff.rfl) ⟨w, hw⟩ a b
          hφb_ne ha_v2

      have h_eq_Ksep : ((b : ↥E) : K_sep) * (j_BE c₀ : K_sep) =
          (w * ((b : ↥E) : K_sep)) * (j_BE s₀ : K_sep) := by
        rw [← ha_eq_wb]
        exact congrArg (fun x : ↥B_E => ((x : ↥E) : K_sep)) h_eq_BE
      have hs0_ne : (j_BE s₀ : K_sep) ≠ 0 := by
        intro h0
        have hs0_zero : s₀ = 0 := Subtype.ext (Subtype.ext h0)
        exact hs₀_not_pE (hs0_zero ▸ p_E.zero_mem)
      have hw_s0 : w * (j_BE s₀ : K_sep) = (j_BE c₀ : K_sep) := by
        apply mul_left_cancel₀ hb_Ksep_ne
        calc
          ((b : ↥E) : K_sep) * (w * (j_BE s₀ : K_sep))
            = (w * ((b : ↥E) : K_sep)) * (j_BE s₀ : K_sep) := by ring
          _ = ((b : ↥E) : K_sep) * (j_BE c₀ : K_sep) := h_eq_Ksep.symm
      refine ⟨j_BE c₀, j_BE s₀, hs₀_not_pE, ?_⟩
      rw [← hw_s0, mul_inv_cancel_right₀ hs0_ne]

    
    have hsmul_P_iff : ∀ b : ↥B_sep, σ_sep • b ∈ P_1 ↔ b ∈ P_2 := by
      intro b
      rw [hP1_eq]
      exact Ideal.smul_mem_pointwise_smul_iff

    have hV2_fwd : ∀ w : K_sep, w ∈ V_2 → σ_sep w ∈ V_1 := by
      intro w hw
      obtain ⟨c, s, hs_not_P2, rfl⟩ := hFrac_V2 w hw
      have hs_not_P1 : σ_sep • s ∉ P_1 := mt (hsmul_P_iff s).mp hs_not_P2
      have hs_unit : IsUnit (ι_B1 (σ_sep • s)) :=
        IsLocalRing.notMem_maximalIdeal.mp hs_not_P1
      have hs_inv_V1 : (σ_sep (s : K_sep))⁻¹ ∈ V_1 := by
        obtain ⟨u_s, hu_s⟩ := hs_unit
        have hmul1 : (↑(u_s⁻¹) : ↥V_1).1 * σ_sep (s : K_sep) = 1 := by
          have h2 := congrArg Subtype.val u_s.inv_val
          rw [Subring.coe_mul, hu_s] at h2
          exact h2
        rw [inv_eq_of_mul_eq_one_left hmul1]
        exact (↑(u_s⁻¹) : ↥V_1).2
      rw [map_mul, map_inv₀]
      exact mul_mem (hBsep_mem V_1 hV1_K (σ_sep • c)) hs_inv_V1

    have hV12_iff : ∀ z : K_sep, z ∈ V_2 ↔ σ_sep z ∈ V_1 := by
      intro z
      refine ⟨hV2_fwd z, ?_⟩
      intro hz_V1
      by_contra hz_not_V2
      have hz_ne : z ≠ 0 := fun h0 => hz_not_V2 (h0 ▸ V_2.zero_mem)
      have hz_inv_V2 : z⁻¹ ∈ V_2 := (V_2.mem_or_inv_mem z).resolve_left hz_not_V2
      obtain ⟨c, s, hs_not_P2, hinv_eq⟩ := hFrac_V2 z⁻¹ hz_inv_V2
      have hc_P2 : c ∈ P_2 := by
        by_contra hc_not_P2
        have hc_unit : IsUnit (ι_B2 c) := IsLocalRing.notMem_maximalIdeal.mp hc_not_P2
        obtain ⟨u_c, hu_c⟩ := hc_unit
        have hc_inv_V2 : (c : K_sep)⁻¹ ∈ V_2 := by
          have hmul1 : (↑(u_c⁻¹) : ↥V_2).1 * (c : K_sep) = 1 := by
            have h2 := congrArg Subtype.val u_c.inv_val
            rw [Subring.coe_mul, hu_c] at h2
            exact h2
          rw [inv_eq_of_mul_eq_one_left hmul1]
          exact (↑(u_c⁻¹) : ↥V_2).2
        have hz_eq_sc : z = (s : K_sep) * (c : K_sep)⁻¹ := by
          have h1 := congrArg Inv.inv hinv_eq
          rw [inv_inv, mul_inv, inv_inv, mul_comm] at h1
          exact h1
        exact hz_not_V2 (hz_eq_sc ▸ mul_mem (hBsep_mem V_2 hV2_K s) hc_inv_V2)
      have hc_P1 : σ_sep • c ∈ P_1 := (hsmul_P_iff c).mpr hc_P2
      have hs_not_P1 : σ_sep • s ∉ P_1 := mt (hsmul_P_iff s).mp hs_not_P2
      have hs_unit : IsUnit (ι_B1 (σ_sep • s)) := IsLocalRing.notMem_maximalIdeal.mp hs_not_P1
      obtain ⟨u_s, hu_s⟩ := hs_unit
      have hσ_z_ne : σ_sep z ≠ 0 := (map_ne_zero_iff σ_sep σ_sep.injective).mpr hz_ne
      have hinv_σ : (σ_sep z)⁻¹ = (ι_B1 (σ_sep • c) * ↑(u_s⁻¹) : ↥V_1).1 := by
        have h1 := congrArg σ_sep hinv_eq
        rw [map_inv₀, map_mul, map_inv₀] at h1
        have hmul1 : (↑(u_s⁻¹) : ↥V_1).1 * σ_sep (s : K_sep) = 1 := by
          have h2 := congrArg Subtype.val u_s.inv_val
          rw [Subring.coe_mul, hu_s] at h2
          exact h2
        rw [h1, inv_eq_of_mul_eq_one_left hmul1]
        rfl
      have hinv_max : (ι_B1 (σ_sep • c) * ↑(u_s⁻¹) : ↥V_1) ∈ IsLocalRing.maximalIdeal ↥V_1 :=
        (IsLocalRing.maximalIdeal ↥V_1).mul_mem_right _ hc_P1
      have h1_eq : (⟨σ_sep z, hz_V1⟩ : ↥V_1) * (ι_B1 (σ_sep • c) * ↑(u_s⁻¹)) = 1 := by
        apply Subtype.ext
        change σ_sep z * (ι_B1 (σ_sep • c) * ↑(u_s⁻¹) : ↥V_1).1 = 1
        rw [← hinv_σ, mul_inv_cancel₀ hσ_z_ne]
      have h1_max : (1 : ↥V_1) ∈ IsLocalRing.maximalIdeal ↥V_1 :=
        h1_eq ▸ (IsLocalRing.maximalIdeal ↥V_1).mul_mem_left _ hinv_max
      exact (IsLocalRing.maximalIdeal.isMaximal ↥V_1).ne_top
        ((IsLocalRing.maximalIdeal ↥V_1).eq_top_of_isUnit_mem h1_max isUnit_one)

    
    haveI : Algebra.IsAlgebraic K_sep Ω_κ :=
      Algebra.IsAlgebraic.tower_top (K := K) (L := K_sep) (A := Ω_κ)
    haveI : IsAlgClosure K_sep Ω_κ := IsAlgClosure.mk inferInstance inferInstance
    let σ_Ω : Ω_κ ≃+* Ω_κ := IsAlgClosure.equivOfEquiv Ω_κ Ω_κ σ_sep.toRingEquiv
    have hσΩ_Ksep : ∀ y : K_sep,
        σ_Ω (algebraMap K_sep Ω_κ y) = algebraMap K_sep Ω_κ (σ_sep y) :=
      fun y => IsAlgClosure.equivOfEquiv_algebraMap Ω_κ Ω_κ σ_sep.toRingEquiv y
    have hσΩ_K : ∀ x : K, σ_Ω (algebraMap K Ω_κ x) = algebraMap K Ω_κ x := by
      intro x
      rw [IsScalarTower.algebraMap_apply K K_sep Ω_κ, hσΩ_Ksep, σ_sep.commutes]

    have hPow_mem_iff : ∀ (U : ValuationSubring Ω_κ) (z : Ω_κ) (m : ℕ),
        1 ≤ m → (z ∈ U ↔ z ^ m ∈ U) := by
      intro U z m hm
      refine ⟨fun hz => pow_mem hz m, fun hzm => ?_⟩
      by_contra hz_not
      have hz_ne : z ≠ 0 := fun h0 => hz_not (h0 ▸ U.zero_mem)
      have hz_inv : z⁻¹ ∈ U := (U.mem_or_inv_mem z).resolve_left hz_not
      have hm_eq : m = (m - 1) + 1 := (Nat.sub_add_cancel hm).symm
      have hz_eq : z = z ^ m * (z⁻¹) ^ (m - 1) := by
        nth_rw 1 [hm_eq]
        rw [pow_succ, mul_comm (z ^ (m - 1)) z, mul_assoc, ← mul_pow,
          mul_inv_cancel₀ hz_ne, one_pow, mul_one]
      exact hz_not (hz_eq ▸ mul_mem hzm (pow_mem hz_inv (m - 1)))

    let q_exp := ringExpChar K_sep
    haveI : ExpChar K_sep q_exp := ringExpChar.expChar K_sep
    have hq_pos : 0 < q_exp := expChar_pos K_sep q_exp

    have hW_V0_iff : ∀ z : Ω_κ, z ∈ W ↔ σ_Ω z ∈ V_0 := by
      intro z
      obtain ⟨n, y, hy⟩ := IsPurelyInseparable.pow_mem K_sep q_exp z
      have hqn : 1 ≤ q_exp ^ n := Nat.one_le_pow n q_exp hq_pos
      calc
        z ∈ W ↔ z ^ (q_exp ^ n) ∈ W := hPow_mem_iff W z (q_exp ^ n) hqn
        _ ↔ algebraMap K_sep Ω_κ y ∈ W := by rw [← hy]
        _ ↔ y ∈ V_2 := Iff.rfl
        _ ↔ σ_sep y ∈ V_1 := hV12_iff y
        _ ↔ algebraMap K_sep Ω_κ (σ_sep y) ∈ V_0 := Iff.rfl
        _ ↔ σ_Ω (algebraMap K_sep Ω_κ y) ∈ V_0 := by rw [← hσΩ_Ksep]
        _ ↔ (σ_Ω z) ^ (q_exp ^ n) ∈ V_0 := by rw [hy, map_pow]
        _ ↔ σ_Ω z ∈ V_0 := (hPow_mem_iff V_0 (σ_Ω z) (q_exp ^ n) hqn).symm

    
    let γ : Ω_κ ≃+* Ω_κ := γ_0.trans σ_Ω
    have hγ_P : ∀ f : P_κ,
        γ (algebraMap P_κ Ω_κ f) = algebraMap P_κ Ω_κ (Polynomial.map τ.toRingHom f) := by
      intro f
      change σ_Ω (γ_0 (algebraMap P_κ Ω_κ f)) = _
      rw [hγ0_P, IsScalarTower.algebraMap_apply P_κ K Ω_κ, hσΩ_K]
    have hγ_V0_iff : ∀ x : Ω_κ, x ∈ V_0 ↔ γ x ∈ V_0 := by
      intro x
      exact (hW_iff x).symm.trans (hW_V0_iff (γ_0 x))
    let γ_V_eq : ↥V_0 ≃+* ↥V_0 :=
      { toFun := fun v => ⟨γ v.1, (hγ_V0_iff v.1).mp v.2⟩
        invFun := fun v => ⟨γ.symm v.1, (hγ_V0_iff (γ.symm v.1)).mpr (by
          rw [γ.apply_symm_apply]; exact v.2)⟩
        left_inv := fun v => Subtype.ext (γ.symm_apply_apply v.1)
        right_inv := fun v => Subtype.ext (γ.apply_symm_apply v.1)
        map_mul' := fun a b => Subtype.ext (map_mul γ a.1 b.1)
        map_add' := fun a b => Subtype.ext (map_add γ a.1 b.1) }
    let γ_V : ↥V_0 →+* ↥V_0 := γ_V_eq.toRingHom

    refine ⟨γ, γ_V, ?_, ?_, hγ_P⟩
    · ext v; rfl
    · ext v
      change π_V0 (γ_V v) = τ (π_V0 v)
      let c := π_V0 v
      have hπ_C : ∀ d : κ, π_V0 (p_V (Polynomial.C d)) = d := by
        intro d
        change (π_V0.comp p_V) (Polynomial.C d) = d
        rw [hπ_pV, Polynomial.coe_evalRingHom, Polynomial.eval_C]
      have hm_ker : v - p_V (Polynomial.C c) ∈ RingHom.ker π_V0 := by
        rw [RingHom.mem_ker, map_sub, hπ_C c, sub_self]
      have hm_max : v - p_V (Polynomial.C c) ∈ IsLocalRing.maximalIdeal ↥V_0 :=
        hπ_ker ▸ hm_ker
      have hγm_max : γ_V (v - p_V (Polynomial.C c)) ∈ IsLocalRing.maximalIdeal ↥V_0 := by
        rw [IsLocalRing.mem_maximalIdeal] at hm_max ⊢
        intro hu
        exact hm_max (by simpa [γ_V] using hu.map γ_V_eq.symm.toRingHom)
      have hγm_ker : π_V0 (γ_V (v - p_V (Polynomial.C c))) = 0 :=
        RingHom.mem_ker.mp (hπ_ker.symm ▸ hγm_max)
      have hγ_pC : γ_V (p_V (Polynomial.C c)) = p_V (Polynomial.C (τ c)) := by
        apply V_0.subtype_injective
        change γ (V_0.subtype (p_V (Polynomial.C c))) = V_0.subtype (p_V (Polynomial.C (τ c)))
        have hp1 : V_0.subtype (p_V (Polynomial.C c)) = algebraMap P_κ Ω_κ (Polynomial.C c) :=
          RingHom.congr_fun hpV_sub (Polynomial.C c)
        have hp2 : V_0.subtype (p_V (Polynomial.C (τ c))) =
            algebraMap P_κ Ω_κ (Polynomial.C (τ c)) :=
          RingHom.congr_fun hpV_sub (Polynomial.C (τ c))
        rw [hp1, hp2, hγ_P, Polynomial.map_C]
        rfl
      rw [map_sub, hγ_pC, map_sub, hπ_C (τ c)] at hγm_ker
      exact sub_eq_zero.mp hγm_ker

  
  
  
  obtain ⟨V_0, e_RV, p_V, π_V0, hHens_V0,
    hSub_eRV, heRV_pR, hπ_eRV, hpV_sub, hπ_pV, hπ_ker, hLoc_V0, hSpec2⟩ := hPillar1
  letI : HenselianLocalRing ↥V_0 := hHens_V0
  have hπ_surj : Function.Surjective π_V0 := fun c =>
    ⟨p_V (Polynomial.C c), by
      change (π_V0.comp p_V) (Polynomial.C c) = c
      rw [hπ_pV, Polynomial.coe_evalRingHom, Polynomial.eval_C]⟩
  refine ⟨V_0, e_RV, p_V, π_V0, hHens_V0,
    hSub_eRV, heRV_pR, hπ_eRV, hpV_sub, hπ_pV, hπ_ker, hLoc_V0, hSpec2, ?_, ?_⟩
  · intro A B _ _ φ hφ α_V s_0 hcomm
    exact hPillar2 ↥V_0 π_V0 hπ_surj hπ_ker φ hφ α_V s_0 hcomm
  · intro τ
    exact hPillar3 V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker τ

theorem weil_dvr_slice_polymorphic_odp_roof_shrink_and_equivariant_atlas (κ : Type u) [Field κ] [IsAlgClosed κ] (m : ℕ)
    (Y_line : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ)))
    (f_line : Y_line ⟶ CategoryTheory.Over.mk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : κ →+* Polynomial κ))))
    [AlgebraicGeometry.IsProper f_line.left]
    (δ_loc : Polynomial κ) (hδ_ev : δ_loc.eval 0 ≠ 0)
    (U_sm_line : (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ))).Opens)
    (hU_sm_mem : ∀ p : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ)),
      Polynomial.X * δ_loc ∉ p.asIdeal → p ∈ U_sm_line)
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (f_line.left ∣_ U_sm_line)]
    (x_zero : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ Y_line.left)
    (hx_zero : x_zero ≫ f_line.left =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ))))
    (hSm_away : ∀ z : Y_line.left,
      f_line.left.base z ∈ Set.range
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ)))).base →
      z ∉ Set.range x_zero.base →
      ∃ V : Y_line.left.Opens, z ∈ V ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f_line.left))
    (hOdp_zero : ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of κ),
      IsEtaleSplitOdpPointOver m f_line (x_zero.base pt)
        ((AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ)))).base pt))
    (V_0 : ValuationSubring (AlgebraicClosure (FractionRing (Polynomial κ))))
    (p_V : Polynomial κ →+* ↥V_0)
    (π_V0 : ↥V_0 →+* κ)
    (hpV_sub : V_0.subtype.comp p_V =
      algebraMap (Polynomial κ) (AlgebraicClosure (FractionRing (Polynomial κ))))
    (hπ_pV : π_V0.comp p_V = Polynomial.evalRingHom 0)
    (hπ_ker : RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0)
    (hSpec2 : ∀ q : Ideal ↥V_0, q.IsPrime → q = ⊥ ∨ q = IsLocalRing.maximalIdeal ↥V_0)
    (hEtLift : ∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
      φ.Etale →
      ∀ (α_V : A →+* ↥V_0) (s_0 : B →+* κ),
        s_0.comp φ = π_V0.comp α_V →
        ∃! β_V : B →+* ↥V_0, β_V.comp φ = α_V ∧ π_V0.comp β_V = s_0) :
    let P_κ := Polynomial κ
    let Ω_κ := AlgebraicClosure (FractionRing P_κ)
    let g_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom p_V)
    let j_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom V_0.subtype)
    let η_V := j_V ≫ g_V
    let Y_V := CategoryTheory.Limits.pullback f_line.left g_V
    let Y_Ω := CategoryTheory.Limits.pullback f_line.left η_V
    let S_d := weilAffineSpaceOver κ (2 * m + 1)
    let g_κ_V := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (p_V.comp Polynomial.C))
    let A_V := CategoryTheory.Limits.pullback S_d.hom g_κ_V
    let A_Ω := CategoryTheory.Limits.pullback j_V
      (CategoryTheory.Limits.pullback.snd S_d.hom g_κ_V)
    let j_A : A_Ω ⟶ A_V :=
      CategoryTheory.Limits.pullback.snd j_V
        (CategoryTheory.Limits.pullback.snd S_d.hom g_κ_V)
    ∃ (h_V : ↥V_0)
      (x_bar_V : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ Y_V)
      (U_Y : Y_V.Opens)
      (j_Y_open : Y_Ω ⟶ U_Y.toScheme)
      (zero_M : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶
        weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V)
      (W_V : AlgebraicGeometry.Scheme.{u})
      (v_W : AlgebraicGeometry.Spec (CommRingCat.of κ) ⟶ W_V)
      (e_W : W_V ⟶ Y_V)
      (q_M : W_V ⟶ weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V),
      (h_V ∈ IsLocalRing.maximalIdeal ↥V_0 ∧ h_V ≠ 0) ∧
      (AlgebraicGeometry.IsClosedImmersion x_bar_V ∧
        (U_Y : Set Y_V) = (Set.range x_bar_V.base)ᶜ ∧
        (j_Y_open ≫ U_Y.ι) ≫ CategoryTheory.Limits.pullback.fst f_line.left g_V =
          CategoryTheory.Limits.pullback.fst f_line.left η_V ∧
        (j_Y_open ≫ U_Y.ι) ≫ CategoryTheory.Limits.pullback.snd f_line.left g_V =
          CategoryTheory.Limits.pullback.snd f_line.left η_V ≫ j_V) ∧
      (∀ x : ↥U_Y.toScheme,
        ∃ (V : U_Y.toScheme.Opens) (_ : x ∈ V)
          (φ : V.toScheme ⟶ A_V) (_ : AlgebraicGeometry.Etale φ)
          (V_U : AlgebraicGeometry.Scheme.{u})
          (ι_VU : V_U ⟶ Y_Ω) (j_V' : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
          CategoryTheory.IsPullback ι_VU j_V' j_Y_open V.ι ∧
          CategoryTheory.IsPullback φ_U j_V' j_A φ) ∧
      (AlgebraicGeometry.Etale e_W ∧
        AlgebraicGeometry.Etale q_M ∧
        v_W ≫ e_W = x_bar_V ∧
        v_W ≫ q_M = zero_M ∧
        (∀ (pt : AlgebraicGeometry.Spec (CommRingCat.of κ)) (idx : Fin (m + 1) × Fin 2),
          Ideal.Quotient.mk _ (MvPolynomial.X idx) ∈ (zero_M.base pt).asIdeal) ∧
        zero_M ≫ AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_V0) ∧
        e_W.base ⁻¹' (Set.range x_bar_V.base) = Set.range v_W.base ∧
        q_M.base ⁻¹' (Set.range zero_M.base) = Set.range v_W.base) ∧
      (∀ (γ_V : ↥V_0 ≃+* ↥V_0),
        γ_V.toRingHom.comp p_V = p_V →
        π_V0.comp γ_V.toRingHom = π_V0 →
        γ_V h_V = h_V ∧
        ∀ (τ_Y : Y_V ≅ Y_V)
          (τ_M : weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V ≅
            weilOdpModelSpec m (CommRingCat.of ↥V_0) h_V),
          τ_Y.hom ≫ CategoryTheory.Limits.pullback.fst f_line.left g_V =
            CategoryTheory.Limits.pullback.fst f_line.left g_V →
          τ_Y.hom ≫ CategoryTheory.Limits.pullback.snd f_line.left g_V =
            CategoryTheory.Limits.pullback.snd f_line.left g_V ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ_V.toRingHom) →
          (∀ idx : Fin (m + 1) × Fin 2,
            (AlgebraicGeometry.Spec.preimage τ_M.hom).hom
              (Ideal.Quotient.mk _ (MvPolynomial.X idx)) =
            Ideal.Quotient.mk _ (MvPolynomial.X idx)) →
          (∀ r : ↥V_0,
            (AlgebraicGeometry.Spec.preimage τ_M.hom).hom
              (Ideal.Quotient.mk _ (MvPolynomial.C r)) =
            Ideal.Quotient.mk _ (MvPolynomial.C (γ_V r))) →
          ∃ τ_W : W_V ≅ W_V,
            v_W ≫ τ_W.hom = v_W ∧
            τ_W.hom ≫ e_W = e_W ≫ τ_Y.hom ∧
            τ_W.hom ≫ q_M = q_M ≫ τ_M.hom) :=
by
  intro P_κ Ω_κ g_V j_V η_V Y_V Y_Ω S_d g_κ_V A_V A_Ω j_A
  
  have hFieldPt : ∀ {K : Type u} [Field K] (pt : PrimeSpectrum K),
      pt = ⟨⊥, inferInstance⟩ := by
    intro K _ pt
    apply PrimeSpectrum.ext
    ext x
    change x ∈ pt.asIdeal ↔ x = 0
    constructor
    · intro hx
      by_contra hne
      have h1 : (1 : K) ∈ pt.asIdeal := by
        rw [← mul_inv_cancel₀ hne]
        exact pt.asIdeal.mul_mem_right x⁻¹ hx
      exact pt.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
    · rintro rfl
      exact pt.asIdeal.zero_mem
  have hSpecPush : ∀ {A B C P_r : CommRingCat.{u}} (f : A ⟶ B) (g : A ⟶ C)
      (inl : B ⟶ P_r) (inr : C ⟶ P_r),
      CategoryTheory.IsPushout f g inl inr →
      CategoryTheory.IsPullback (Spec.map inl) (Spec.map inr) (Spec.map f) (Spec.map g) := by
    intro A B C P_r f g inl inr h
    have h0 := AlgebraicGeometry.isPullback_SpecMap_pushout f g
    let e_iso : Spec P_r ≅ Spec (Limits.pushout f g) :=
      { hom := Spec.map h.isoPushout.inv
        inv := Spec.map h.isoPushout.hom
        hom_inv_id := by rw [← Spec.map_comp, h.isoPushout.hom_inv_id, Spec.map_id]
        inv_hom_id := by rw [← Spec.map_comp, h.isoPushout.inv_hom_id, Spec.map_id] }
    refine h0.of_iso e_iso.symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
      ?_ ?_ (by simp) (by simp)
    · dsimp [e_iso]
      rw [Category.comp_id, ← Spec.map_comp, IsPushout.inl_isoPushout_hom]
    · dsimp [e_iso]
      rw [Category.comp_id, ← Spec.map_comp, IsPushout.inr_isoPushout_hom]
  have hP_Ω_inj : Function.Injective (algebraMap P_κ Ω_κ) := by
    intro a b hab
    have h1 : algebraMap (FractionRing P_κ) Ω_κ (algebraMap P_κ (FractionRing P_κ) a) =
        algebraMap (FractionRing P_κ) Ω_κ (algebraMap P_κ (FractionRing P_κ) b) := by
      rwa [← IsScalarTower.algebraMap_apply P_κ (FractionRing P_κ) Ω_κ,
        ← IsScalarTower.algebraMap_apply P_κ (FractionRing P_κ) Ω_κ]
    have h2 : algebraMap (Polynomial κ) (FractionRing P_κ) a =
        algebraMap (Polynomial κ) (FractionRing P_κ) b :=
      (RingHom.injective (algebraMap (FractionRing P_κ) Ω_κ)) h1
    exact IsFractionRing.injective (Polynomial κ) (FractionRing P_κ) h2

  
  let pt_κ : PrimeSpectrum κ := ⟨⊥, inferInstance⟩
  let pt_Ω : PrimeSpectrum Ω_κ := ⟨⊥, inferInstance⟩
  let s_zero : Spec (CommRingCat.of κ) ⟶ Spec (CommRingCat.of (Polynomial κ)) :=
    Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ)))
  have hs_surj : Function.Surjective (Polynomial.evalRingHom (0 : κ)) := fun c =>
    ⟨Polynomial.C c, Polynomial.eval_C⟩
  have _ : IsClosedImmersion s_zero := IsClosedImmersion.spec_of_surjective _ hs_surj
  have hπ_surj : Function.Surjective π_V0 := by
    intro c
    refine ⟨p_V (Polynomial.C c), ?_⟩
    have hc := RingHom.congr_fun hπ_pV (Polynomial.C c)
    simpa using hc
  let i_cl : Spec (CommRingCat.of κ) ⟶ Spec (CommRingCat.of ↥V_0) :=
    Spec.map (CommRingCat.ofHom π_V0)
  have _ : IsClosedImmersion i_cl := IsClosedImmersion.spec_of_surjective _ hπ_surj
  have hi_gV : i_cl ≫ g_V = s_zero := by
    dsimp [i_cl, g_V, s_zero]
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hπ_pV]
  let fst_V : Y_V ⟶ Y_line.left := Limits.pullback.fst f_line.left g_V
  let snd_V : Y_V ⟶ Spec (CommRingCat.of ↥V_0) := Limits.pullback.snd f_line.left g_V
  let x_bar_V : Spec (CommRingCat.of κ) ⟶ Y_V :=
    Limits.pullback.lift x_zero i_cl (by rw [hx_zero, hi_gV])
  have hx_fst : x_bar_V ≫ fst_V = x_zero := Limits.pullback.lift_fst _ _ _
  have hx_snd : x_bar_V ≫ snd_V = i_cl := Limits.pullback.lift_snd _ _ _
  have hx_Y_cl : IsClosedImmersion x_bar_V := by
    have _ : IsClosedImmersion (x_bar_V ≫ snd_V) := by rw [hx_snd]; infer_instance
    exact IsClosedImmersion.of_comp x_bar_V snd_V
  let U_Y : Y_V.Opens := ⟨(Set.range x_bar_V.base)ᶜ, x_bar_V.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let fst_η : Y_Ω ⟶ Y_line.left := Limits.pullback.fst f_line.left η_V
  let snd_η : Y_Ω ⟶ Spec (CommRingCat.of Ω_κ) := Limits.pullback.snd f_line.left η_V
  let ι_Y_Ω : Y_Ω ⟶ Y_V :=
    Limits.pullback.lift fst_η (snd_η ≫ j_V) (by rw [Category.assoc]; exact Limits.pullback.condition)
  have hPb_ιY : CategoryTheory.IsPullback ι_Y_Ω snd_η snd_V j_V := by
    have hBot : CategoryTheory.IsPullback snd_η ι_Y_Ω j_V snd_V := by
      refine CategoryTheory.IsPullback.of_bot ?_ (Limits.pullback.lift_snd _ _ _).symm
        (CategoryTheory.IsPullback.of_hasPullback f_line.left g_V).flip
      rw [Limits.pullback.lift_fst]
      exact (CategoryTheory.IsPullback.of_hasPullback f_line.left η_V).flip
    exact hBot.flip
  have hRange_ιY : Set.range ι_Y_Ω.base ⊆ Set.range U_Y.ι.base := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    change ι_Y_Ω.base z ∉ Set.range x_bar_V.base
    rintro ⟨pt, h_eq⟩
    have hsnd_eq : (x_bar_V ≫ snd_V).base pt = (ι_Y_Ω ≫ snd_V).base z :=
      congrArg snd_V.base h_eq
    rw [hx_snd, Limits.pullback.lift_snd] at hsnd_eq
    let t_0 : ↥V_0 := p_V Polynomial.X
    have ht_cl : t_0 ∈ (i_cl.base pt).asIdeal := by
      rw [hFieldPt pt]
      change π_V0 (p_V Polynomial.X) = 0
      have hX := RingHom.congr_fun hπ_pV Polynomial.X
      simpa using hX
    rw [hsnd_eq] at ht_cl
    have ht_Ω : V_0.subtype t_0 = 0 := by
      have hq : snd_η.base z = pt_Ω := hFieldPt (snd_η.base z)
      change t_0 ∈ (j_V.base (snd_η.base z)).asIdeal at ht_cl
      rw [hq] at ht_cl
      exact ht_cl
    have hX_map : V_0.subtype t_0 = algebraMap P_κ Ω_κ Polynomial.X :=
      RingHom.congr_fun hpV_sub Polynomial.X
    rw [ht_Ω] at hX_map
    exact Polynomial.X_ne_zero (hP_Ω_inj (hX_map.symm.trans (map_zero _).symm))
  let j_Y_open : Y_Ω ⟶ U_Y.toScheme := IsOpenImmersion.lift U_Y.ι ι_Y_Ω hRange_ιY
  have hj_Y_fac : j_Y_open ≫ U_Y.ι = ι_Y_Ω := IsOpenImmersion.lift_fac U_Y.ι ι_Y_Ω hRange_ιY
  let π_UY : U_Y.toScheme ⟶ Spec (CommRingCat.of ↥V_0) := U_Y.ι ≫ snd_V
  have hPb_jY : CategoryTheory.IsPullback j_Y_open snd_η π_UY j_V := by
    have hcomm_jY : j_Y_open ≫ π_UY = snd_η ≫ j_V := by
      dsimp [π_UY]
      rw [← Category.assoc, hj_Y_fac]
      exact hPb_ιY.w
    refine CategoryTheory.IsPullback.of_isLimit
      (Limits.PullbackCone.IsLimit.mk hcomm_jY
        (fun c => hPb_ιY.lift (c.fst ≫ U_Y.ι) c.snd (by rw [Category.assoc]; exact c.condition))
        (fun c => ?_) (fun c => hPb_ιY.lift_snd _ _ _) (fun c m_hom hm1 hm2 => ?_))
    · rw [← cancel_mono U_Y.ι, Category.assoc, hj_Y_fac]
      exact hPb_ιY.lift_fst _ _ _
    · refine hPb_ιY.hom_ext ?_ (hm2.trans (hPb_ιY.lift_snd _ _ _).symm)
      rw [hPb_ιY.lift_fst, ← hj_Y_fac, ← Category.assoc, hm1]

  
  have hSm_UY : ∀ x : ↥U_Y.toScheme, ∃ W : U_Y.toScheme.Opens,
      x ∈ W ∧ AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W.ι ≫ π_UY) := by
    have hPb_xz : CategoryTheory.IsPullback (Limits.pullback.fst fst_V x_zero ≫ snd_V)
        (Limits.pullback.snd fst_V x_zero) g_V s_zero := by
      have hPaste := (CategoryTheory.IsPullback.of_hasPullback fst_V x_zero).paste_horiz
        (CategoryTheory.IsPullback.of_hasPullback f_line.left g_V).flip
      rwa [hx_zero] at hPaste
    have _ : IsClosedImmersion (Limits.pullback.fst fst_V x_zero ≫ snd_V) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_xz.flip inferInstance
    intro x
    let z_V : ↥Y_V := U_Y.ι.base x
    have hz_notin : z_V ∉ Set.range x_bar_V.base := x.2
    let q_V : PrimeSpectrum ↥V_0 := snd_V.base z_V
    have hW₀_ex : ∃ W₀ : Y_line.left.Opens, fst_V.base z_V ∈ W₀ ∧
        AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W₀.ι ≫ f_line.left) := by
      rcases hSpec2 q_V.asIdeal q_V.isPrime with hq_bot | hq_max
      · have hf_in_Usm : f_line.left.base (fst_V.base z_V) ∈ U_sm_line := by
          have h1 : f_line.left.base (fst_V.base z_V) = g_V.base q_V :=
            congrArg (fun φ => φ.base z_V) (Limits.pullback.condition (f := f_line.left) (g := g_V))
          rw [h1]
          refine hU_sm_mem (g_V.base q_V) ?_
          intro hmem
          have hp_mem : p_V (Polynomial.X * δ_loc) ∈ q_V.asIdeal := hmem
          rw [hq_bot, Ideal.mem_bot] at hp_mem
          have hmap0 : algebraMap P_κ Ω_κ (Polynomial.X * δ_loc) = 0 := by
            rw [← RingHom.congr_fun hpV_sub (Polynomial.X * δ_loc)]
            change V_0.subtype (p_V (Polynomial.X * δ_loc)) = 0
            rw [hp_mem, map_zero]
          have hmul0 : (Polynomial.X : Polynomial κ) * δ_loc = 0 :=
            hP_Ω_inj (hmap0.trans (map_zero _).symm)
          rcases mul_eq_zero.mp hmul0 with hX0 | hδ0
          · exact Polynomial.X_ne_zero hX0
          · rw [hδ0, Polynomial.eval_zero] at hδ_ev
            exact hδ_ev rfl
        let W₀ : Y_line.left.Opens := (TopologicalSpace.Opens.map f_line.left.base).obj U_sm_line
        refine ⟨W₀, hf_in_Usm, ?_⟩
        rw [← AlgebraicGeometry.morphismRestrict_ι f_line.left U_sm_line]
        have hcomp_sm : AlgebraicGeometry.SmoothOfRelativeDimension ((2 * m + 1) + 0)
            ((f_line.left ∣_ U_sm_line) ≫ U_sm_line.ι) := inferInstance
        simpa using hcomp_sm
      · have hq_eq : q_V = i_cl.base pt_κ := by
          apply PrimeSpectrum.ext
          rw [hq_max, ← hπ_ker]
          rfl
        have hf_in_s : f_line.left.base (fst_V.base z_V) ∈ Set.range s_zero.base := by
          have h1 : f_line.left.base (fst_V.base z_V) = g_V.base q_V :=
            congrArg (fun φ => φ.base z_V) (Limits.pullback.condition (f := f_line.left) (g := g_V))
          rw [h1, hq_eq]
          change (i_cl ≫ g_V).base pt_κ ∈ Set.range s_zero.base
          rw [hi_gV]
          exact ⟨pt_κ, rfl⟩
        have h_not_xz : fst_V.base z_V ∉ Set.range x_zero.base := by
          rintro ⟨pt_u, hxz_eq⟩
          obtain ⟨w, hw_1, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z_V pt_u hxz_eq.symm
          let σ_κ : Spec (CommRingCat.of κ) ⟶ Limits.pullback fst_V x_zero :=
            Limits.pullback.lift x_bar_V (𝟙 _) (by rw [Category.id_comp]; exact hx_fst)
          have hw_eq : w = σ_κ.base pt_κ := by
            apply (Limits.pullback.fst fst_V x_zero ≫ snd_V).isClosedEmbedding.injective
            have hL : (Limits.pullback.fst fst_V x_zero ≫ snd_V).base w = i_cl.base pt_κ := by
              change snd_V.base ((Limits.pullback.fst fst_V x_zero).base w) = i_cl.base pt_κ
              rw [hw_1]
              exact hq_eq
            have hR : (Limits.pullback.fst fst_V x_zero ≫ snd_V).base (σ_κ.base pt_κ) =
                i_cl.base pt_κ := by
              change (σ_κ ≫ Limits.pullback.fst fst_V x_zero ≫ snd_V).base pt_κ = i_cl.base pt_κ
              rw [← Category.assoc, Limits.pullback.lift_fst, hx_snd]
            exact hL.trans hR.symm
          apply hz_notin
          refine ⟨pt_κ, ?_⟩
          have h1 : x_bar_V.base pt_κ = (Limits.pullback.fst fst_V x_zero).base (σ_κ.base pt_κ) :=
            congrArg (fun φ => φ.base pt_κ)
              (Limits.pullback.lift_fst x_bar_V (𝟙 _) (by rw [Category.id_comp]; exact hx_fst)).symm
          rw [h1, ← hw_eq, hw_1]
        exact hSm_away (fst_V.base z_V) hf_in_s h_not_xz
    obtain ⟨W₀, hz_W₀, hSm_W₀⟩ := hW₀_ex
    let W_Y : Y_V.Opens := (TopologicalSpace.Opens.map fst_V.base).obj W₀
    have hPb_WY : CategoryTheory.IsPullback (fst_V ∣_ W₀) (W_Y.ι ≫ snd_V) (W₀.ι ≫ f_line.left) g_V :=
      (AlgebraicGeometry.isPullback_morphismRestrict fst_V W₀).paste_vert
        (CategoryTheory.IsPullback.of_hasPullback f_line.left g_V)
    have _ : AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (W_Y.ι ≫ snd_V) :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_WY hSm_W₀
    let W : U_Y.toScheme.Opens := (TopologicalSpace.Opens.map U_Y.ι.base).obj W_Y
    have hx_W : x ∈ W := hz_W₀
    refine ⟨W, hx_W, ?_⟩
    dsimp [π_UY]
    rw [← Category.assoc, ← AlgebraicGeometry.morphismRestrict_ι U_Y.ι W_Y, Category.assoc]
    have hcomp_sm : AlgebraicGeometry.SmoothOfRelativeDimension (0 + (2 * m + 1))
        ((U_Y.ι ∣_ W_Y) ≫ (W_Y.ι ≫ snd_V)) := inferInstance
    simpa using hcomp_sm

  
  have hAtlas : ∀ x : ↥U_Y.toScheme,
      ∃ (V : U_Y.toScheme.Opens) (_ : x ∈ V)
        (φ : V.toScheme ⟶ A_V) (_ : AlgebraicGeometry.Etale φ)
        (V_U : AlgebraicGeometry.Scheme.{u})
        (ι_VU : V_U ⟶ Y_Ω) (j_V' : V_U ⟶ V.toScheme) (φ_U : V_U ⟶ A_Ω),
        CategoryTheory.IsPullback ι_VU j_V' j_Y_open V.ι ∧
        CategoryTheory.IsPullback φ_U j_V' j_A φ := by
    let d_rel := 2 * m + 1
    have hMvPb : ∀ (R₀ : Type u) [CommRing R₀] (c₀ : κ →+* R₀),
        CategoryTheory.IsPullback
          (Spec.map (CommRingCat.ofHom (MvPolynomial.map c₀ :
            MvPolynomial (Fin d_rel) κ →+* MvPolynomial (Fin d_rel) R₀)) :
            Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R₀)) ⟶ S_d.left)
          (Spec.map (CommRingCat.ofHom (MvPolynomial.C : R₀ →+* MvPolynomial (Fin d_rel) R₀)))
          S_d.hom
          (Spec.map (CommRingCat.ofHom c₀)) := by
      intro R₀ _ c₀
      let f_κ : CommRingCat.of κ ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) κ) :=
        CommRingCat.ofHom MvPolynomial.C
      let g_κ : CommRingCat.of κ ⟶ CommRingCat.of R₀ := CommRingCat.ofHom c₀
      let inl_κ : CommRingCat.of (MvPolynomial (Fin d_rel) κ) ⟶
          CommRingCat.of (MvPolynomial (Fin d_rel) R₀) :=
        CommRingCat.ofHom (MvPolynomial.map c₀)
      let inr_κ : CommRingCat.of R₀ ⟶ CommRingCat.of (MvPolynomial (Fin d_rel) R₀) :=
        CommRingCat.ofHom MvPolynomial.C
      have hcomm : f_κ ≫ inl_κ = g_κ ≫ inr_κ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        exact MvPolynomial.map_C c₀ a
      have hPush : CategoryTheory.IsPushout f_κ g_κ inl_κ inr_κ := by
        refine CategoryTheory.IsPushout.of_isColimit
          (Limits.PushoutCocone.IsColimit.mk hcomm
            (fun sc => CommRingCat.ofHom
              (MvPolynomial.eval₂Hom sc.inr.hom (fun i => sc.inl.hom (MvPolynomial.X i))))
            (fun sc => ?_) (fun sc => ?_) (fun sc m_hom hm1 hm2 => ?_))
        · apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · ext a
            change MvPolynomial.eval₂Hom sc.inr.hom _ (MvPolynomial.map c₀ (MvPolynomial.C a)) =
              sc.inl.hom (MvPolynomial.C a)
            rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
            exact (congrArg (fun φ => φ.hom a) sc.condition).symm
          · intro i
            change MvPolynomial.eval₂Hom sc.inr.hom _ (MvPolynomial.map c₀ (MvPolynomial.X i)) = _
            rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        · apply CommRingCat.hom_ext
          ext r
          exact MvPolynomial.eval₂Hom_C _ _ r
        · apply CommRingCat.hom_ext
          apply MvPolynomial.ringHom_ext'
          · ext r
            have hr := congrArg (fun φ => φ.hom r) hm2
            simpa [inr_κ] using hr
          · intro i
            have hi := congrArg (fun φ => φ.hom (MvPolynomial.X i)) hm1
            change m_hom.hom (MvPolynomial.X i) =
              MvPolynomial.eval₂Hom sc.inr.hom (fun j => sc.inl.hom (MvPolynomial.X j))
                (MvPolynomial.X i)
            rw [MvPolynomial.eval₂Hom_X']
            have hXi : MvPolynomial.map c₀ (MvPolynomial.X i : MvPolynomial (Fin d_rel) κ) =
                MvPolynomial.X i := MvPolynomial.map_X c₀ i
            rw [← hXi]
            exact hi
      exact hSpecPush f_κ g_κ inl_κ inr_κ hPush
    intro x
    obtain ⟨W, hx_W, hSm_W⟩ := hSm_UY x
    obtain ⟨O_R, hAff_OR, O_W, hAff_OW, hx_OW, he_OW, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff d_rel (W.ι ≫ π_UY)).mp hSm_W ⟨x, hx_W⟩
    obtain ⟨γ, hγ_C, hγ_et⟩ := hStd.exists_etale_mvPolynomial
    let R_OR := ↑((Spec (CommRingCat.of ↥V_0)).presheaf.obj (Opposite.op O_R))
    let R_OW := ↑((↑W : Scheme.{u}).presheaf.obj (Opposite.op O_W))
    let from_OW : Spec (CommRingCat.of R_OW) ⟶ ↑W := hAff_OW.fromSpec
    let from_OR : Spec (CommRingCat.of R_OR) ⟶ Spec (CommRingCat.of ↥V_0) := hAff_OR.fromSpec
    have _ : IsOpenImmersion from_OW := hAff_OW.isOpenImmersion_fromSpec
    have _ : IsOpenImmersion from_OR := hAff_OR.isOpenImmersion_fromSpec
    let j_OW : Spec (CommRingCat.of R_OW) ⟶ U_Y.toScheme := from_OW ≫ W.ι
    let V : U_Y.toScheme.Opens := j_OW.opensRange
    have hx_V : x ∈ V := by
      change x ∈ Set.range j_OW.base
      refine ⟨hAff_OW.primeIdealOf ⟨⟨x, hx_W⟩, hx_OW⟩, ?_⟩
      simp only [j_OW, from_OW, Scheme.Hom.comp_base, TopCat.coe_comp]
      change W.ι.base (hAff_OW.fromSpec.base (hAff_OW.primeIdealOf ⟨⟨x, hx_W⟩, hx_OW⟩)) = x
      rw [hAff_OW.fromSpec_primeIdealOf ⟨⟨x, hx_W⟩, hx_OW⟩]
      rfl
    let e_VO : V.toScheme ≅ Spec (CommRingCat.of R_OW) :=
      IsOpenImmersion.isoOfRangeEq V.ι j_OW (by simp [V])
    have he_VO : e_VO.hom ≫ j_OW = V.ι :=
      IsOpenImmersion.isoOfRangeEq_hom_fac V.ι j_OW _
    have _ : AlgebraicGeometry.Etale (Spec.map (CommRingCat.ofHom γ)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hγ_et
    let φ₀ : V.toScheme ⟶ Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R_OR)) :=
      e_VO.hom ≫ Spec.map (CommRingCat.ofHom γ)
    have _ : AlgebraicGeometry.Etale φ₀ := inferInstance
    let C_OR : R_OR →+* MvPolynomial (Fin d_rel) R_OR := MvPolynomial.C
    have hφ₀_comm : φ₀ ≫ Spec.map (CommRingCat.ofHom C_OR) ≫ from_OR = V.ι ≫ π_UY := by
      dsimp [φ₀]
      rw [Category.assoc, ← Spec.map_comp_assoc, ← CommRingCat.ofHom_comp, hγ_C]
      have happ : Spec.map (CommRingCat.ofHom ((W.ι ≫ π_UY).appLE O_R O_W he_OW).hom) ≫ from_OR =
          from_OW ≫ (W.ι ≫ π_UY) :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec (W.ι ≫ π_UY) hAff_OR hAff_OW he_OW
      rw [happ, ← Category.assoc, ← Category.assoc]
      exact congrArg (· ≫ π_UY) he_VO
    let c_OR : κ →+* R_OR := (Spec.preimage (from_OR ≫ g_κ_V)).hom
    have hc_OR : Spec.map (CommRingCat.ofHom c_OR) = from_OR ≫ g_κ_V :=
      Spec.map_preimage (from_OR ≫ g_κ_V)
    let p₁_OR : Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R_OR)) ⟶ S_d.left :=
      Spec.map (CommRingCat.ofHom (MvPolynomial.map c_OR))
    let p₂_OR : Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R_OR)) ⟶ Spec (CommRingCat.of R_OR) :=
      Spec.map (CommRingCat.ofHom C_OR)
    have hPb_OR : CategoryTheory.IsPullback p₁_OR p₂_OR S_d.hom (from_OR ≫ g_κ_V) := by
      rw [← hc_OR]
      exact hMvPb R_OR c_OR
    let snd_AV := Limits.pullback.snd S_d.hom g_κ_V
    have hcomm_OR : p₁_OR ≫ S_d.hom = (p₂_OR ≫ from_OR) ≫ g_κ_V := by
      rw [Category.assoc]
      exact hPb_OR.w
    let ι_OR_AV : Spec (CommRingCat.of (MvPolynomial (Fin d_rel) R_OR)) ⟶ A_V :=
      Limits.pullback.lift p₁_OR (p₂_OR ≫ from_OR) hcomm_OR
    have hPb_ιAV : CategoryTheory.IsPullback ι_OR_AV p₂_OR snd_AV from_OR := by
      refine CategoryTheory.IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback S_d.hom g_κ_V)
      rw [Limits.pullback.lift_fst]
      exact hPb_OR
    have _ : AlgebraicGeometry.Etale ι_OR_AV :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        hPb_ιAV.flip inferInstance
    let φ : V.toScheme ⟶ A_V := φ₀ ≫ ι_OR_AV
    have hφ_et : AlgebraicGeometry.Etale φ := inferInstance
    have hφ_snd : φ ≫ snd_AV = V.ι ≫ π_UY := by
      dsimp [φ, ι_OR_AV, snd_AV]
      rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc]
      exact hφ₀_comm
    let V_U := Limits.pullback (V.ι ≫ π_UY) j_V
    let j_V' : V_U ⟶ V.toScheme := Limits.pullback.fst (V.ι ≫ π_UY) j_V
    let p_Ω : V_U ⟶ Spec (CommRingCat.of Ω_κ) := Limits.pullback.snd (V.ι ≫ π_UY) j_V
    let ι_VU : V_U ⟶ Y_Ω :=
      hPb_jY.lift (j_V' ≫ V.ι) p_Ω (by rw [Category.assoc]; exact Limits.pullback.condition)
    have hPb_1 : CategoryTheory.IsPullback ι_VU j_V' j_Y_open V.ι := by
      refine CategoryTheory.IsPullback.of_right ?_ (hPb_jY.lift_fst _ _ _) hPb_jY.flip
        
      rw [hPb_jY.lift_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback (V.ι ≫ π_UY) j_V).flip
    let φ_U : V_U ⟶ A_Ω :=
      Limits.pullback.lift p_Ω (j_V' ≫ φ) (by
        rw [Category.assoc, hφ_snd, ← Category.assoc]
        exact Limits.pullback.condition.symm)
    have hPb_2 : CategoryTheory.IsPullback φ_U j_V' j_A φ := by
      refine CategoryTheory.IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback j_V snd_AV)
      rw [Limits.pullback.lift_fst]
      have hOuter : CategoryTheory.IsPullback p_Ω j_V' j_V (V.ι ≫ π_UY) :=
        (CategoryTheory.IsPullback.of_hasPullback (V.ι ≫ π_UY) j_V).flip
      rwa [← hφ_snd] at hOuter
    exact ⟨V, hx_V, φ, hφ_et, V_U, ι_VU, j_V', φ_U, hPb_1, hPb_2⟩

  
  obtain ⟨_, R'_cat, _, e_B, h, V', v₀, e_Y, q,
    he_B, he_Y, hq_et, _, hv₀, ⟨ψ_B, hψ_X, hψ_et_spec, heB_hom⟩, _, hq_X, hq_h, heY_f⟩ :=
    hOdp_zero pt_κ
  obtain ⟨O_V, hAff_OV, hv₀_OV, -⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := v₀) trivial
  let V₀ : Scheme.{u} := O_V.toScheme
  have _ : IsAffine V₀ := hAff_OV
  let v₀' : ↥V₀ := ⟨v₀, hv₀_OV⟩
  let e_Y' : V₀ ⟶ Y_line.left := O_V.ι ≫ e_Y
  let q' : V₀ ⟶ weilOdpModelSpec m R'_cat h := O_V.ι ≫ q
  have _ : Etale e_Y' := by dsimp [e_Y']; infer_instance
  have _ : Etale q' := by dsimp [q']; infer_instance
  have hv₀' : e_Y'.base v₀' = x_zero.base pt_κ := by
    change e_Y.base (O_V.ι.base v₀') = x_zero.base pt_κ
    exact hv₀
  have hv_tilde_ex : ∃ v_tilde : Spec (CommRingCat.of κ) ⟶ V₀,
      v_tilde.base pt_κ = v₀' ∧ v_tilde ≫ e_Y' = x_zero := by
    let P_v := Limits.pullback e_Y' x_zero
    let p_v1 : P_v ⟶ V₀ := Limits.pullback.fst e_Y' x_zero
    let p_vκ : P_v ⟶ Spec (CommRingCat.of κ) := Limits.pullback.snd e_Y' x_zero
    have _ : Etale p_vκ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback e_Y' x_zero) inferInstance
    obtain ⟨z_v, hzv_1, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
        (f := e_Y') (g := x_zero) v₀' pt_κ hv₀'
    obtain ⟨O_v, hAff_Ov, hzv_Ov, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (x := z_v) trivial
    let E_v_cat : CommRingCat.{u} := P_v.presheaf.obj (Opposite.op O_v)
    let p_E : PrimeSpectrum ↑E_v_cat := hAff_Ov.primeIdealOf ⟨z_v, hzv_Ov⟩
    have hp_E : hAff_Ov.fromSpec.base p_E = z_v := hAff_Ov.fromSpec_primeIdealOf ⟨z_v, hzv_Ov⟩
    have _ : Etale (hAff_Ov.fromSpec ≫ p_vκ) := inferInstance
    let c_Ev_hom : CommRingCat.of κ ⟶ E_v_cat := Spec.preimage (hAff_Ov.fromSpec ≫ p_vκ)
    have hc_Ev_et : c_Ev_hom.hom.Etale :=
      (HasRingHomProperty.Spec_iff (P := @Etale)).mp (by rw [Spec.map_preimage]; infer_instance)
    let _ : Algebra κ ↑E_v_cat := c_Ev_hom.hom.toAlgebra
    have _ : Algebra.Etale κ ↑E_v_cat := RingHom.etale_algebraMap.mp hc_Ev_et
    obtain ⟨I_v, hFin_Iv, L_v, hFld_Lv, hAlg_Lv, Θ_v, hFinMod_v⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod κ ↑E_v_cat).mp inferInstance
    let _ : ∀ i : I_v, Field (L_v i) := hFld_Lv
    let _ : ∀ i : I_v, Algebra κ (L_v i) := hAlg_Lv
    let _ : Fintype I_v := Fintype.ofFinite I_v
    let _ : DecidableEq I_v := Classical.decEq I_v
    let δ_v : I_v → (∀ i : I_v, L_v i) := fun c i => if i = c then 1 else 0
    have hsum1_v : (∑ c : I_v, Θ_v.symm (δ_v c)) = 1 := by
      rw [← map_sum]
      have h1 : (∑ c : I_v, δ_v c) = 1 := by ext i; simp [δ_v]
      rw [h1, map_one]
    have hex_i0 : ∃ i₀ : I_v, Θ_v.symm (δ_v i₀) ∉ p_E.asIdeal := by
      by_contra h_none
      have h_all : ∀ c : I_v, Θ_v.symm (δ_v c) ∈ p_E.asIdeal := fun c =>
        Classical.not_not.mp (fun hnc => h_none ⟨c, hnc⟩)
      have h1_mem : (1 : ↑E_v_cat) ∈ p_E.asIdeal := by
        rw [← hsum1_v]
        exact Ideal.sum_mem p_E.asIdeal (fun c _ => h_all c)
      exact p_E.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr h1_mem)
    obtain ⟨i₀, hi₀⟩ := hex_i0
    have hMem_pE : ∀ a : ↑E_v_cat, a ∈ p_E.asIdeal ↔ (Θ_v a) i₀ = 0 := by
      intro a
      constructor
      · intro ha
        by_contra hne
        let b_inv : ∀ i : I_v, L_v i := fun i => ((Θ_v a) i)⁻¹ * δ_v i₀ i
        have hmul : Θ_v a * b_inv = δ_v i₀ := by
          ext i
          by_cases hi : i = i₀
          · subst hi
            change Θ_v a i * ((Θ_v a i)⁻¹ * (if i = i then 1 else 0)) = if i = i then 1 else 0
            simp only [↓reduceIte, mul_one]
            exact mul_inv_cancel₀ hne
          · change Θ_v a i * ((Θ_v a i)⁻¹ * (if i = i₀ then 1 else 0)) = if i = i₀ then 1 else 0
            simp [hi]
        have hmul_E : a * Θ_v.symm b_inv = Θ_v.symm (δ_v i₀) := by
          apply Θ_v.injective
          rw [map_mul, Θ_v.apply_symm_apply, Θ_v.apply_symm_apply, hmul]
        exact hi₀ (hmul_E ▸ p_E.asIdeal.mul_mem_right _ ha)
      · intro h0
        have hmul : Θ_v a * δ_v i₀ = 0 := by
          ext i
          by_cases hi : i = i₀
          · subst hi; simp [δ_v, h0]
          · simp [δ_v, hi]
        have hmul_E : a * Θ_v.symm (δ_v i₀) = 0 := by
          apply Θ_v.injective
          rw [map_mul, Θ_v.apply_symm_apply, hmul, map_zero]
        rcases p_E.isPrime.mem_or_mem (hmul_E ▸ p_E.asIdeal.zero_mem) with ha | hδ
        · exact ha
        · exact False.elim (hi₀ hδ)
    let _ : Module.Finite κ (L_v i₀) := (hFinMod_v i₀).1
    have _ : Algebra.IsAlgebraic κ (L_v i₀) := Algebra.IsAlgebraic.of_finite κ (L_v i₀)
    let ι_Lv : L_v i₀ →ₐ[κ] κ := IsAlgClosed.lift
    let ψ_Ev : ↑E_v_cat →ₐ[κ] κ := ι_Lv.comp ((Pi.evalAlgHom κ L_v i₀).comp Θ_v.toAlgHom)
    let φ_Ev_κ : E_v_cat ⟶ CommRingCat.of κ := CommRingCat.ofHom ψ_Ev.toRingHom
    have hφ_c : c_Ev_hom ≫ φ_Ev_κ = 𝟙 (CommRingCat.of κ) := by
      apply CommRingCat.hom_ext
      ext a
      exact ψ_Ev.commutes a
    let v_tilde : Spec (CommRingCat.of κ) ⟶ V₀ := Spec.map φ_Ev_κ ≫ hAff_Ov.fromSpec ≫ p_v1
    refine ⟨v_tilde, ?_, ?_⟩
    · have hp_map : (Spec.map φ_Ev_κ).base pt_κ = p_E := by
        apply PrimeSpectrum.ext
        ext x
        change ι_Lv ((Θ_v x) i₀) = 0 ↔ x ∈ p_E.asIdeal
        rw [map_eq_zero_iff ι_Lv ι_Lv.injective, hMem_pE x]
      change p_v1.base (hAff_Ov.fromSpec.base ((Spec.map φ_Ev_κ).base pt_κ)) = v₀'
      rw [hp_map, hp_E, hzv_1]
    · dsimp [v_tilde]
      rw [Category.assoc, Category.assoc, Limits.pullback.condition]
      rw [← Category.assoc hAff_Ov.fromSpec, ← Spec.map_preimage (hAff_Ov.fromSpec ≫ p_vκ)]
      change Spec.map φ_Ev_κ ≫ Spec.map c_Ev_hom ≫ x_zero = x_zero
      rw [← Spec.map_comp_assoc, hφ_c, Spec.map_id, Category.id_comp]
