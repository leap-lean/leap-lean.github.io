    have hnat := ConcreteCategory.congr_hom
      ((adj_h.counit.app N).hom.naturality (Opposite.op τ_W)) u_W
    have hrt := ConcreteCategory.congr_hom
      (congrArg (fun φ => φ.hom.app (Opposite.op W)) (adj_h.right_triangle_components N)) s
    exact hnat.trans (congrArg ((N.obj.map (Opposite.op τ_W)).hom) hrt)

  have hResVanish : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
      (T₁ : Z₁.Etale)
      (G : CategoryTheory.Sheaf Z₂.smallEtaleTopology AddCommGrpCat.{u})
