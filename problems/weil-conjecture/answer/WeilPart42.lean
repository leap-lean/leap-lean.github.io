      have hGal_Fβ : IsGalois ↥F'₁ ↥F_β := IsGalois.of_equiv_equiv (f := e_F₁) (g := e_L) hcomm_FL
      refine ⟨n, F_β, hF_le, hF_κ, ⟨hFD_Fβ, hGal_Fβ⟩, fun a ha => ?_⟩
