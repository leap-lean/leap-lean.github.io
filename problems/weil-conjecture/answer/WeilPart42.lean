  have hTwoRowCoker : ∀ {X₁ Y₁ Z₁ X₂ Y₂ Z₂ : CategoryTheory.Sheaf V.smallEtaleTopology AddCommGrpCat.{u}}
      (u₁ : X₁ ⟶ Y₁) (v₁ : Y₁ ⟶ Z₁) (h₁ : u₁ ≫ v₁ = 0)
      (_ : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.CokernelCofork.ofπ v₁ h₁))
      (u₂ : X₂ ⟶ Y₂) (v₂ : Y₂ ⟶ Z₂) (h₂ : u₂ ≫ v₂ = 0)
      (_ : CategoryTheory.Limits.IsColimit (CategoryTheory.Limits.CokernelCofork.ofπ v₂ h₂))
      (eX : X₁ ⟶ X₂) [CategoryTheory.IsIso eX]
      (eY : Y₁ ⟶ Y₂) [CategoryTheory.IsIso eY]
      (eZ : Z₁ ⟶ Z₂),
      u₁ ≫ eY = eX ≫ u₂ → v₁ ≫ eZ = eY ≫ v₂ → CategoryTheory.IsIso eZ := by
    intro X₁ Y₁ Z₁ X₂ Y₂ Z₂ u₁ v₁ h₁ hc₁ u₂ v₂ h₂ hc₂ eX _ eY _ eZ hsq₁ hsq₂
    have hcond : u₂ ≫ (CategoryTheory.inv eY ≫ v₁) = 0 := by
      calc u₂ ≫ (CategoryTheory.inv eY ≫ v₁)
        _ = (CategoryTheory.inv eX ≫ eX) ≫ u₂ ≫ CategoryTheory.inv eY ≫ v₁ := by
            rw [CategoryTheory.IsIso.inv_hom_id, Category.id_comp]
        _ = CategoryTheory.inv eX ≫ (eX ≫ u₂) ≫ CategoryTheory.inv eY ≫ v₁ := by
            simp only [Category.assoc]
        _ = CategoryTheory.inv eX ≫ (u₁ ≫ eY) ≫ CategoryTheory.inv eY ≫ v₁ := by
            rw [← hsq₁]
        _ = CategoryTheory.inv eX ≫ u₁ ≫ (eY ≫ CategoryTheory.inv eY) ≫ v₁ := by
            simp only [Category.assoc]
        _ = CategoryTheory.inv eX ≫ u₁ ≫ v₁ := by
            rw [CategoryTheory.IsIso.hom_inv_id, Category.id_comp]
        _ = 0 := by
            rw [h₁, CategoryTheory.Limits.comp_zero]
    let cf := CategoryTheory.Limits.CokernelCofork.ofπ (CategoryTheory.inv eY ≫ v₁) hcond
    let invZ : Z₂ ⟶ Z₁ := hc₂.desc cf
    have hv₂_invZ : v₂ ≫ invZ = CategoryTheory.inv eY ≫ v₁ :=
      hc₂.fac cf CategoryTheory.Limits.WalkingParallelPair.one
    refine ⟨⟨invZ, ?_, ?_⟩⟩
    · apply CategoryTheory.Limits.Cofork.IsColimit.hom_ext hc₁
      change v₁ ≫ (eZ ≫ invZ) = v₁ ≫ 𝟙 Z₁
      rw [← Category.assoc, hsq₂, Category.assoc, hv₂_invZ, ← Category.assoc,
        CategoryTheory.IsIso.hom_inv_id, Category.id_comp, Category.comp_id]
    · apply CategoryTheory.Limits.Cofork.IsColimit.hom_ext hc₂
      change v₂ ≫ (invZ ≫ eZ) = v₂ ≫ 𝟙 Z₂
      rw [← Category.assoc, hv₂_invZ, Category.assoc, hsq₂, ← Category.assoc,
        CategoryTheory.IsIso.inv_hom_id, Category.id_comp, Category.comp_id]

  have hMapCoker : ∀ {X₀ Y₀ Z₀ : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (u₀ : X₀ ⟶ Y₀) (v₀ : Y₀ ⟶ Z₀) (h₀ : u₀ ≫ v₀ = 0),
