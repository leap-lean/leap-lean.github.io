          have hfix : γ.toRingHom.comp ψ_Ω = ψ_Ω := RingHom.ext hγ_K₂
          rw [hfix]
        let α_γ : Y_Ω_target ⟶ Y_Ω_target :=
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_target)
            (CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_target ≫
