              (weilOuterTrFibEdgeHom u T_X hT_U Q 0 q₀)) =
            ((δ₀.hom.app (Opposite.op T_X)).hom)
              (weilOuterTrFibEdgeHom u T_X hT_U Q 0 q₀) := by
          change ((δ₀.hom.app (Opposite.op T_X)).hom)
            (((((ε₀ Q).hom ≫ (ε₀ Q).inv).hom.app (Opposite.op T_X)).hom)
              (weilOuterTrFibEdgeHom u T_X hT_U Q 0 q₀)) = _
          rw [(ε₀ Q).hom_inv_id]
          rfl
        exact hcancel_ε.trans hδ₀_edge
      obtain ⟨hcomp_δ_tilde, hEpi_δ_tilde, hEx_δ_tilde⟩ :=
        hExact_pf_δ₀ SC_U hSE_U (hInjAcyc I 1 (le_refl 1))
      haveI : CategoryTheory.Epi δ_tilde₀ := hEpi_δ_tilde
      haveI : CategoryTheory.Limits.PreservesFiniteLimits pf_u := ⟨fun _ _ _ => inferInstance⟩
      obtain ⟨hEx_pf, hMono_pf_ι⟩ :=
        (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono pf_u).mp
          inferInstance SC_U hSE_U
      haveI : CategoryTheory.Mono (pf_u.map ι_G) := hMono_pf_ι
      obtain ⟨hfq, hmδ, hSE₁, hSE₂⟩ :=
        hSplitSES (pf_u.map ι_G) (pf_u.map π_G) (SC_U.map pf_u).zero hEx_pf
          δ_tilde₀ hcomp_δ_tilde hEx_δ_tilde
      let M := CategoryTheory.Limits.image (pf_u.map π_G)
      let q_π : pf_u.obj I ⟶ M := CategoryTheory.Limits.factorThruImage (pf_u.map π_G)
      let m_π : M ⟶ pf_u.obj Q := CategoryTheory.Limits.image.ι (pf_u.map π_G)
      let SC₁ := CategoryTheory.ShortComplex.mk (pf_u.map ι_G) q_π hfq
      obtain ⟨w₀_raw, hw₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ_X hSE₂ q_tilde hq_tilde_ker
      let w₀ : M.H 0 := w₀_raw
      refine ⟨w₀.comp hSE₁.extClass (rfl : 0 + 1 = 1), ?_⟩
      let hSE₁_pb : (SC₁.map pb_u).ShortExact := hSE₁.map_of_exact pb_u
      let Φ_G : SC₁.map pb_u ⟶ SC_U :=
        CategoryTheory.ShortComplex.Hom.mk
          (adj_u.counit.app G)
          (adj_u.counit.app I)
          (pb_u.map m_π ≫ adj_u.counit.app Q)
          (adj_u.counit.naturality ι_G).symm
          (by
            change adj_u.counit.app I ≫ π_G = pb_u.map q_π ≫ (pb_u.map m_π ≫ adj_u.counit.app Q)
            rw [← CategoryTheory.Category.assoc, ← pb_u.map_comp,
