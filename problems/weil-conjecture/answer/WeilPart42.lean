    let b_K : Module.Basis (Fin r) K_loc L_loc := Module.Basis.mk hLI_K hSpan_K
    have hr_eq : Module.finrank K_loc L_loc = r := by
      rw [Module.finrank_eq_card_basis b_K, Fintype.card_fin]
    exact ⟨b_R.reindex (finCongr hr_eq.symm)⟩
  
  have hPillar2 : ∀ (R_loc K_loc L_loc : Type u)
      [CommRing R_loc] [IsDomain R_loc] [IsNoetherianRing R_loc]
