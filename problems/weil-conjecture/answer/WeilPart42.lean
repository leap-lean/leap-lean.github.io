    intro w hw_V0
    obtain ⟨n, F_β, hF_le, hF_κ, ⟨hFD_F, hGal_F⟩, hw_pow⟩ := hAbs_M (w : Ω₁) w.2
    obtain ⟨_, hFD_EEβ, hSep_EEβ, hDual⟩ :=
      hDisj F'₁ F_β K₀ E_L u₀ hF_le hK₀_eq hK₀_le_E (hu₀_tr F_β hF_κ)
        hFD_F hGal_F hFD_KE hGal_KE
    obtain ⟨_, hStab_β⟩ :=
      step5_trace_dual_crux κ₁ Ω₁ V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker A₀ F'₁ F_β K₀ E_L
        hF_le hF_κ hK₀_le_E φ_A_K₀ hFrac_A hA_V0 hA_max hF'₁_in_A
        hFD_F hGal_F hFD_KE hSep_KE σ_E hInert_E
    let E_β : Subfield Ω₁ := E_L ⊔ F_β
    have hκ'₁_Ksl : ι_κ₁.fieldRange ≤ K_sl := by
      rintro _ ⟨c, rfl⟩
      exact hf_in_Ksl (Polynomial.C c)
    have hEβ_le_M : E_β ≤ M := sup_le le_sup_left ((hF_κ.trans hκ'₁_Ksl).trans le_sup_right)
    let Pre_β : Subfield Ω₁ :=
      { carrier := {x : Ω₁ | ∃ hx : x ∈ M, (σ₁ ⟨x, hx⟩ : Ω₁) ∈ E_β}
        add_mem' := by
          rintro x y ⟨hx, hσx⟩ ⟨hy, hσy⟩
          refine ⟨add_mem hx hy, ?_⟩
          change ((σ₁ (⟨x, hx⟩ + ⟨y, hy⟩) : ↥M) : Ω₁) ∈ E_β
          rw [map_add, Subfield.coe_add]
          exact add_mem hσx hσy
        zero_mem' := ⟨zero_mem _, by
          change ((σ₁ 0 : ↥M) : Ω₁) ∈ E_β
          rw [map_zero]
          exact zero_mem E_β⟩
        neg_mem' := by
          rintro x ⟨hx, hσx⟩
          refine ⟨neg_mem hx, ?_⟩
          change ((σ₁ (-⟨x, hx⟩) : ↥M) : Ω₁) ∈ E_β
          rw [map_neg, Subfield.coe_neg]
          exact neg_mem hσx
        mul_mem' := by
          rintro x y ⟨hx, hσx⟩ ⟨hy, hσy⟩
          refine ⟨mul_mem hx hy, ?_⟩
          change ((σ₁ (⟨x, hx⟩ * ⟨y, hy⟩) : ↥M) : Ω₁) ∈ E_β
          rw [map_mul, Subfield.coe_mul]
          exact mul_mem hσx hσy
        one_mem' := ⟨one_mem _, by
          change ((σ₁ 1 : ↥M) : Ω₁) ∈ E_β
          rw [map_one]
          exact one_mem E_β⟩
        inv_mem' := by
          rintro x ⟨hx, hσx⟩
          refine ⟨inv_mem hx, ?_⟩
          change ((σ₁ (⟨x, hx⟩⁻¹) : ↥M) : Ω₁) ∈ E_β
          rw [map_inv₀, Subfield.coe_inv]
          exact inv_mem hσx }
    have hEβ_in_Pre : E_β ≤ Pre_β := by
      refine sup_le ?_ ?_
      · intro z hz
        refine ⟨mem_sup_left' hz, ?_⟩
        rw [hσ₁_EL ⟨z, hz⟩ (mem_sup_left' hz)]
        exact mem_sup_left' (σ_E ⟨z, hz⟩).2
      · intro b hb
        have hb_Ksl : b ∈ K_sl := hκ'₁_Ksl (hF_κ hb)
        refine ⟨mem_sup_right' hb_Ksl, ?_⟩
        have hc := congrArg Subtype.val (σ₁.commutes ⟨b, hb_Ksl⟩)
        change (σ₁ ⟨b, mem_sup_right' hb_Ksl⟩ : Ω₁) = b at hc
        rw [hc]
        exact mem_sup_right' hb
    let σ_β : ↥E_β →+* ↥E_β :=
      { toFun := fun x =>
          ⟨(σ₁ ⟨(x : Ω₁), hEβ_le_M x.2⟩ : Ω₁), by
            obtain ⟨_, hmem⟩ := hEβ_in_Pre x.2
            exact hmem⟩
        map_one' := by
          apply Subtype.ext
          change ((σ₁ 1 : ↥M) : Ω₁) = 1
          rw [map_one]
          rfl
        map_mul' := fun x y => by
          apply Subtype.ext
          change ((σ₁ (⟨(x : Ω₁), hEβ_le_M x.2⟩ * ⟨(y : Ω₁), hEβ_le_M y.2⟩) : ↥M) : Ω₁) = _
          rw [map_mul]
          rfl
        map_zero' := by
          apply Subtype.ext
          change ((σ₁ 0 : ↥M) : Ω₁) = 0
          rw [map_zero]
          rfl
        map_add' := fun x y => by
          apply Subtype.ext
          change ((σ₁ (⟨(x : Ω₁), hEβ_le_M x.2⟩ + ⟨(y : Ω₁), hEβ_le_M y.2⟩) : ↥M) : Ω₁) = _
          rw [map_add]
          rfl }
    have hσβ_EL : ∀ z : ↥E_L, ∀ hzβ : (z : Ω₁) ∈ E_β,
        (σ_β ⟨(z : Ω₁), hzβ⟩ : Ω₁) = (σ_E z : Ω₁) :=
      fun z hzβ => hσ₁_EL z (hEβ_le_M hzβ)
    have hσβ_Fβ : ∀ b : ↥F_β, ∀ hbβ : (b : Ω₁) ∈ E_β,
        (σ_β ⟨(b : Ω₁), hbβ⟩ : Ω₁) = (b : Ω₁) := by
      intro b _
      have hb_Ksl : (b : Ω₁) ∈ K_sl := hκ'₁_Ksl (hF_κ b.2)
      exact congrArg Subtype.val (σ₁.commutes ⟨(b : Ω₁), hb_Ksl⟩)
    let u_β : ↥E_β := ⟨(w : Ω₁) ^ (q ^ n), hw_pow⟩
    have hu_β_V0 : (u_β : Ω₁) ∈ V_0 := pow_mem hw_V0 (q ^ n)
    have hσu_V0 : (σ_β u_β : Ω₁) ∈ V_0 :=
      hStab_β hFD_EEβ hSep_EEβ hDual σ_β hσβ_EL hσβ_Fβ u_β hu_β_V0
    have hσw_pow_V0 : (σ₁ w : Ω₁) ^ (q ^ n) ∈ V_0 := by
      have h1 : (σ_β u_β : Ω₁) = (σ₁ (w ^ (q ^ n)) : Ω₁) := rfl
      rw [map_pow] at h1
      change (σ_β u_β : Ω₁) = (σ₁ w : Ω₁) ^ (q ^ n) at h1
      rwa [← h1]
    set z : Ω₁ := (σ₁ w : Ω₁)
    rcases ValuationSubring.mem_or_inv_mem V_0 z with hz | hz_inv
    · exact hz
    · by_cases hz0 : z = 0
      · rw [hz0]; exact zero_mem V_0
      · have hqn_pos : 1 ≤ q ^ n := (hPow_inj n).1
        have hz_eq : z = z ^ (q ^ n) * (z⁻¹) ^ (q ^ n - 1) := by
          have hexp : q ^ n = (q ^ n - 1) + 1 := (Nat.sub_add_cancel hqn_pos).symm
          nth_rw 1 [hexp]
          rw [pow_succ, mul_right_comm, ← mul_pow, mul_inv_cancel₀ hz0, one_pow, one_mul]
        rw [hz_eq]
        exact mul_mem hσw_pow_V0 (pow_mem hz_inv (q ^ n - 1))
  have hPow_V0 : ∀ (m : ℕ) (w : ↥M), (w : Ω₁) ∈ V_0 → (((σ₁ ^ m) w) : Ω₁) ∈ V_0 := by
    intro m
    induction m with
    | zero => intro w hw; exact hw
    | succ m ih =>
      intro w hw
      rw [pow_succ', AlgEquiv.mul_apply]
      exact hFwd_V0 _ (ih w hw)
  let _ : Fintype (↥M ≃ₐ[↥K_sl] ↥M) := AlgEquiv.fintype ↥K_sl ↥M
  have : Finite (↥M ≃ₐ[↥K_sl] ↥M) := Finite.of_fintype _
  have hord_pos : 1 ≤ orderOf σ₁ := orderOf_pos σ₁
  refine ⟨σ_M, ?_, ?_, ?_, ?_⟩
  · intro f hf
    exact congrArg Subtype.val (σ₁.commutes ⟨algebraMap P_κ₁ Ω₁ f, hf_in_Ksl f⟩)
  · intro x hx
    have hx_K₀ : ψ_Ω x ∈ K₀ := ⟨x, rfl⟩
    have hx_E : ψ_Ω x ∈ E_L := hK₀_le_E hx_K₀
    rw [show (σ_M ⟨ψ_Ω x, hx⟩ : Ω₁) = (σ_E ⟨ψ_Ω x, hx_E⟩ : Ω₁) from hσ₁_EL ⟨ψ_Ω x, hx_E⟩ hx]
    exact congrArg Subtype.val (σ_E.commutes ⟨ψ_Ω x, hx_K₀⟩)
  · intro z hz
    rw [show (σ_M ⟨i_L z, hz⟩ : Ω₁) = (σ_E ⟨i_L z, ⟨z, rfl⟩⟩ : Ω₁) from hσ₁_EL ⟨i_L z, ⟨z, rfl⟩⟩ hz]
    exact hσ_E_apply z
  · intro w
    refine ⟨hFwd_V0 w, fun hσw => ?_⟩
    have h_iter := hPow_V0 (orderOf σ₁ - 1) (σ₁ w) hσw
    have h_id : (σ₁ ^ (orderOf σ₁ - 1)) (σ₁ w) = w := by
      rw [← AlgEquiv.mul_apply, ← pow_succ, Nat.sub_add_cancel hord_pos,
        pow_orderOf_eq_one σ₁]
      rfl
    rwa [h_id] at h_iter

theorem weil_dvr_slice_algClosure_valuation_aut_extension (M Ω : Type u) [Field M] [Field Ω] [Algebra M Ω]
    [IsAlgClosed Ω] [Algebra.IsAlgebraic M Ω]
    (V : ValuationSubring Ω)
    (hDed : IsDedekindDomain ↥(V.comap (algebraMap M Ω)))
    (hMax_ne : IsLocalRing.maximalIdeal ↥(V.comap (algebraMap M Ω)) ≠ ⊥)
    (σ_M : M ≃+* M)
    (hStab : ∀ x : M, algebraMap M Ω x ∈ V ↔ algebraMap M Ω (σ_M x) ∈ V) :
    ∃ γ : Ω ≃+* Ω,
      (∀ x : M, γ (algebraMap M Ω x) = algebraMap M Ω (σ_M x)) ∧
      (∀ z : Ω, z ∈ V ↔ γ z ∈ V) :=
by
  have hMemOfIntElem : ∀ {A K : Type u} [CommRing A] [Field K] (f : A →+* K)
      (W : ValuationSubring K), (∀ a : A, f a ∈ W) → ∀ {x : K}, f.IsIntegralElem x → x ∈ W := by
    intro A K _ _ f W hfW x ⟨p, hp_mon, hp_ev⟩
    let ι : A →+* ↥W :=
      { toFun := fun a => ⟨f a, hfW a⟩
        map_one' := Subtype.ext f.map_one
        map_mul' := fun a b => Subtype.ext (f.map_mul a b)
        map_zero' := Subtype.ext f.map_zero
        map_add' := fun a b => Subtype.ext (f.map_add a b) }
    have hcomp : (algebraMap ↥W K).comp ι = f := RingHom.ext fun _ => rfl
    have hx_int : IsIntegral ↥W x := ⟨p.map ι, hp_mon.map ι, by
      rw [Polynomial.eval₂_map, hcomp]
      exact hp_ev⟩
    exact Subring.isIntegrallyClosed_iff.mp inferInstance hx_int

  have hStepProfinite : ∀ (L : Type u) [Field L] [Algebra M L] [IsGalois M L]
      (W₀ W₁ : ValuationSubring L),
      W₀.comap (algebraMap M L) = W₁.comap (algebraMap M L) →
      ∃ g : L ≃ₐ[M] L,
        ∀ b : L,
          ((algebraMap M L).comp (W₀.comap (algebraMap M L)).subtype).IsIntegralElem b →
          (b ∈ W₁.nonunits ↔ g b ∈ W₀.nonunits) := by
    intro L _ _ _ W₀ W₁ hComap
    let R_M : ValuationSubring M := W₀.comap (algebraMap M L)
    let φ_RL : ↥R_M →+* L := (algebraMap M L).comp R_M.subtype
    let _ : Algebra ↥R_M L := φ_RL.toAlgebra
    have _ : IsScalarTower ↥R_M M L := IsScalarTower.of_algebraMap_eq' rfl
    let B : Subalgebra ↥R_M L := integralClosure ↥R_M L
    let G := L ≃ₐ[M] L
    let _ : TopologicalSpace ↥B := ⊥
    have _ : DiscreteTopology ↥B := ⟨rfl⟩
    have _ : ContinuousSMul G ↥B := by
      refine ContinuousSMul.mk ?_
      rw [continuous_iff_continuousAt]
      rintro ⟨g₀, b₀⟩ S hS
      have hgb_mem : g₀ • b₀ ∈ S := mem_of_mem_nhds hS
      let E : IntermediateField M L := IntermediateField.adjoin M {(b₀ : L)}
      have hb₀_int : IsIntegral M (b₀ : L) := Algebra.IsSeparable.isIntegral M (b₀ : L)
      have _ : FiniteDimensional M ↥E := IntermediateField.adjoin.finiteDimensional hb₀_int
      have hOpenH : IsOpen (E.fixingSubgroup : Set G) := IntermediateField.fixingSubgroup_isOpen E
      let U : Set G := (fun g : G => g₀⁻¹ * g) ⁻¹' (E.fixingSubgroup : Set G)
      have hU_open : IsOpen U := hOpenH.preimage (continuous_const.mul continuous_id)
      have hg₀_U : g₀ ∈ U := by
        change g₀⁻¹ * g₀ ∈ E.fixingSubgroup
        rw [inv_mul_cancel]
        exact E.fixingSubgroup.one_mem
      rw [Filter.mem_map, nhds_prod_eq]
      refine Filter.mem_of_superset
        (Filter.prod_mem_prod (hU_open.mem_nhds hg₀_U)
          ((isOpen_discrete ({b₀} : Set ↥B)).mem_nhds (Set.mem_singleton b₀))) ?_
      rintro ⟨g, b⟩ ⟨hgU, hb_eq⟩
      have hb_eq' : b = b₀ := hb_eq
      subst hb_eq'
      have hfix_L : (g₀⁻¹ * g) (b : L) = (b : L) :=
        hgU ⟨(b : L), IntermediateField.mem_adjoin_simple_self M (b : L)⟩
      have hg_eq : g (b : L) = g₀ (b : L) := by
        have h1 : (g₀⁻¹ * g) • (b : L) = (b : L) := hfix_L
        have h2 : g₀ • ((g₀⁻¹ * g) • (b : L)) = g₀ • (b : L) := congrArg (g₀ • ·) h1
        rw [← mul_smul, ← mul_assoc, mul_inv_cancel, one_mul] at h2
        exact h2
      have hsmul_eq : g • b = g₀ • b := Subtype.ext hg_eq
      change g • b ∈ S
      rwa [hsmul_eq]
    have _ : IsGaloisGroup G M L := IsGaloisGroup.of_isGalois M L
    have _ : Algebra.IsInvariant ↥R_M ↥B G := by
      refine Algebra.IsInvariant.mk fun b hb => ?_
      have hb_L : ∀ g : G, g • (b : L) = (b : L) := fun g => congrArg Subtype.val (hb g)
      obtain ⟨x, hx⟩ := Algebra.IsInvariant.isInvariant (A := M) (B := L) (G := G) (b : L) hb_L
      have hx_int : φ_RL.IsIntegralElem (algebraMap M L x) := hx.symm ▸ b.2
      have hx_W₀ : algebraMap M L x ∈ W₀ := hMemOfIntElem φ_RL W₀ (fun r => r.2) hx_int
      exact ⟨⟨x, hx_W₀⟩, Subtype.ext hx⟩
    have hb_W₀ : ∀ b : ↥B, (b : L) ∈ W₀ := fun b => hMemOfIntElem φ_RL W₀ (fun r => r.2) b.2
    have hb_W₁ : ∀ b : ↥B, (b : L) ∈ W₁ := fun b =>
      hMemOfIntElem φ_RL W₁ (fun r => by
        have hr : (r : M) ∈ W₀.comap (algebraMap M L) := r.2
        rw [hComap] at hr
        exact hr) b.2
    let ι₀ : ↥B →+* ↥W₀ :=
      { toFun := fun b => ⟨(b : L), hb_W₀ b⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let ι₁ : ↥B →+* ↥W₁ :=
      { toFun := fun b => ⟨(b : L), hb_W₁ b⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    let P₀ : Ideal ↥B := Ideal.comap ι₀ (IsLocalRing.maximalIdeal ↥W₀)
    let P₁ : Ideal ↥B := Ideal.comap ι₁ (IsLocalRing.maximalIdeal ↥W₁)
    have _ : P₀.IsPrime := Ideal.IsPrime.comap ι₀
    have _ : P₁.IsPrime := Ideal.IsPrime.comap ι₁
    have hR_nonunits : ∀ (W : ValuationSubring L),
        R_M = W.comap (algebraMap M L) →
        ∀ r : ↥R_M, algebraMap M L (r : M) ∈ W.nonunits ↔ r ∈ IsLocalRing.maximalIdeal ↥R_M := by
      intro W hRW r
      rw [← ValuationSubring.coe_mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or,
        ValuationSubring.mem_nonunits_iff_or,
        map_eq_zero_iff (algebraMap M L) (algebraMap M L).injective, ← map_inv₀ (algebraMap M L)]
      change ((r : M) = 0 ∨ (r : M)⁻¹ ∉ W.comap (algebraMap M L)) ↔
        ((r : M) = 0 ∨ (r : M)⁻¹ ∉ R_M)
      rw [← hRW]
    have hUnder : Ideal.under ↥R_M P₁ = Ideal.under ↥R_M P₀ := by
      ext r
      rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap,
        ← ValuationSubring.coe_mem_nonunits_iff, ← ValuationSubring.coe_mem_nonunits_iff]
      change algebraMap M L (r : M) ∈ W₁.nonunits ↔ algebraMap M L (r : M) ∈ W₀.nonunits
      rw [hR_nonunits W₁ hComap r, hR_nonunits W₀ rfl r]
    obtain ⟨g, hg_eq⟩ :=
      Algebra.IsInvariant.exists_smul_of_under_eq_of_profinite (G := G) P₁ P₀ hUnder
    refine ⟨g, fun b hb => ?_⟩
    let b_B : ↥B := ⟨b, hb⟩
    have hmem_P : b_B ∈ P₁ ↔ g • b_B ∈ P₀ := by
      rw [hg_eq, Ideal.mem_pointwise_smul_iff_inv_smul_mem, inv_smul_smul]
    rw [Ideal.mem_comap, Ideal.mem_comap, ← ValuationSubring.coe_mem_nonunits_iff,
      ← ValuationSubring.coe_mem_nonunits_iff] at hmem_P
    exact hmem_P

  have hStepDedekind : ∀ (L : Type u) [Field L] [Algebra M L] [Algebra.IsSeparable M L]
      (W₀ W₁ : ValuationSubring L),
      W₀.comap (algebraMap M L) = W₁.comap (algebraMap M L) →
      IsDedekindDomain ↥(W₀.comap (algebraMap M L)) →
      IsLocalRing.maximalIdeal ↥(W₀.comap (algebraMap M L)) ≠ ⊥ →
      ∀ (g : L ≃ₐ[M] L),
        (∀ b : L,
          ((algebraMap M L).comp (W₀.comap (algebraMap M L)).subtype).IsIntegralElem b →
          (b ∈ W₁.nonunits ↔ g b ∈ W₀.nonunits)) →
        ∀ y : L, y ∈ W₁ ↔ g y ∈ W₀ := by
    intro L _ _ _
    have hFwd : ∀ (W₀' W₁' : ValuationSubring L),
        W₀'.comap (algebraMap M L) = W₁'.comap (algebraMap M L) →
        IsDedekindDomain ↥(W₀'.comap (algebraMap M L)) →
        IsLocalRing.maximalIdeal ↥(W₀'.comap (algebraMap M L)) ≠ ⊥ →
        ∀ (g' : L ≃ₐ[M] L),
          (∀ b : L,
            ((algebraMap M L).comp (W₀'.comap (algebraMap M L)).subtype).IsIntegralElem b →
            (b ∈ W₁'.nonunits ↔ g' b ∈ W₀'.nonunits)) →
          ∀ y : L, y ∈ W₁' → g' y ∈ W₀' := by
      intro W₀' W₁' hComap' hDed' hMax_ne' g' hNonunits' y hy
      let R' : ValuationSubring M := W₀'.comap (algebraMap M L)
      have _ : IsDedekindDomain ↥R' := hDed'
      let F_y : IntermediateField M L := IntermediateField.adjoin M {y}
      have hy_int_M : IsIntegral M y := Algebra.IsSeparable.isIntegral M y
      have _ : FiniteDimensional M ↥F_y := IntermediateField.adjoin.finiteDimensional hy_int_M
      let φ_RF : ↥R' →+* ↥F_y := (algebraMap M ↥F_y).comp R'.subtype
      let _ : Algebra ↥R' ↥F_y := φ_RF.toAlgebra
      have _ : IsScalarTower ↥R' M ↥F_y := IsScalarTower.of_algebraMap_eq' rfl
      let O_y : Subalgebra ↥R' ↥F_y := integralClosure ↥R' ↥F_y
      have _ : IsDedekindDomain ↥O_y := integralClosure.isDedekindDomain ↥R' M ↥F_y
      have _ : IsFractionRing ↥O_y ↥F_y := integralClosure.isFractionRing_of_finite_extension M ↥F_y
      let φ_RL' : ↥R' →+* L := (algebraMap M L).comp R'.subtype
      have hφ_comp : (algebraMap ↥F_y L).comp φ_RF = φ_RL' :=
        RingHom.ext fun r => IsScalarTower.algebraMap_apply M ↥F_y L (r : M)
      have hu_int : ∀ u : ↥O_y, φ_RL'.IsIntegralElem ((u : ↥F_y) : L) := fun u => by
        rw [← hφ_comp]
        exact RingHom.IsIntegralElem.map u.2 (algebraMap ↥F_y L)
      have hg_φ : g'.toRingHom.comp φ_RL' = φ_RL' :=
        RingHom.ext fun r => g'.commutes (r : M)
      have hgu_int : ∀ u : ↥O_y, φ_RL'.IsIntegralElem (g' ((u : ↥F_y) : L)) := fun u => by
        rw [← hg_φ]
        exact RingHom.IsIntegralElem.map (hu_int u) g'.toRingHom
      have hu_W₁' : ∀ u : ↥O_y, ((u : ↥F_y) : L) ∈ W₁' := fun u =>
        hMemOfIntElem φ_RL' W₁' (fun r => by
          have hr : (r : M) ∈ W₀'.comap (algebraMap M L) := r.2
          rw [hComap'] at hr
          exact hr) (hu_int u)
      have hgu_W₀' : ∀ u : ↥O_y, g' ((u : ↥F_y) : L) ∈ W₀' := fun u =>
        hMemOfIntElem φ_RL' W₀' (fun r => r.2) (hgu_int u)
      let ι_Oy : ↥O_y →+* ↥W₁' :=
        { toFun := fun u => ⟨((u : ↥F_y) : L), hu_W₁' u⟩
          map_one' := rfl
          map_mul' := fun _ _ => rfl
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      let q_y : Ideal ↥O_y := Ideal.comap ι_Oy (IsLocalRing.maximalIdeal ↥W₁')
      have _ : q_y.IsPrime := Ideal.IsPrime.comap ι_Oy
      have hqy_ne : q_y ≠ ⊥ := by
        obtain ⟨π₀, hπ_mem, hπ_ne⟩ := (Submodule.ne_bot_iff _).mp hMax_ne'
        let π_O : ↥O_y := algebraMap ↥R' ↥O_y π₀
        have hπM_ne : (π₀ : M) ≠ 0 := fun h0 => hπ_ne (Subtype.ext h0)
        have hπL_eq : ((π_O : ↥F_y) : L) = algebraMap M L (π₀ : M) :=
          IsScalarTower.algebraMap_apply M ↥F_y L (π₀ : M)
        have hπO_ne : π_O ≠ 0 := by
          intro h0
          have h1 : ((π_O : ↥F_y) : L) = 0 := by rw [h0]; rfl
          rw [hπL_eq, map_eq_zero_iff (algebraMap M L) (algebraMap M L).injective] at h1
          exact hπM_ne h1
        have hπO_mem : π_O ∈ q_y := by
          rw [Ideal.mem_comap, ← ValuationSubring.coe_mem_nonunits_iff]
          change ((π_O : ↥F_y) : L) ∈ W₁'.nonunits
          rw [hπL_eq, ValuationSubring.mem_nonunits_iff_or,
            map_eq_zero_iff (algebraMap M L) (algebraMap M L).injective,
            ← map_inv₀ (algebraMap M L)]
          have hπ_nonunit : (π₀ : M) ∈ R'.nonunits :=
            ValuationSubring.coe_mem_nonunits_iff.mpr hπ_mem
          rw [ValuationSubring.mem_nonunits_iff_or] at hπ_nonunit
          change (π₀ : M) = 0 ∨ (π₀ : M)⁻¹ ∉ W₁'.comap (algebraMap M L)
          rwa [← hComap']
        intro hbot
        rw [hbot] at hπO_mem
        exact hπO_ne hπO_mem
      have _ : IsDiscreteValuationRing (Localization.AtPrime q_y) :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
          ↥O_y hqy_ne (Localization.AtPrime q_y)
      have hVR : ValuationRing (Localization.AtPrime q_y) := inferInstance
      have _ : PreValuationRing (Localization.AtPrime q_y) := hVR.toPreValuationRing
      have hs_unit : ∀ s : q_y.primeCompl, IsUnit (ι_Oy s) :=
        fun s => IsLocalRing.notMem_maximalIdeal.mp s.2
      let φ_loc : Localization.AtPrime q_y →+* ↥W₁' := IsLocalization.lift hs_unit
      have hφ_loc_eq : ∀ u : ↥O_y, φ_loc (algebraMap ↥O_y (Localization.AtPrime q_y) u) = ι_Oy u :=
        IsLocalization.lift_eq hs_unit
      let y_F : ↥F_y := ⟨y, IntermediateField.mem_adjoin_simple_self M y⟩
      obtain ⟨a, b, hb_nzd, hab_div⟩ := IsFractionRing.div_surjective (A := ↥O_y) y_F
      have hb_ne : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb_nzd
      have hbF_ne : (b : ↥F_y) ≠ 0 := fun h0 => hb_ne (Subtype.ext h0)
      have hbL_ne : ((b : ↥F_y) : L) ≠ 0 := fun h0 => hbF_ne (Subtype.ext h0)
      have hab_F : (a : ↥F_y) = y_F * (b : ↥F_y) := (div_eq_iff hbF_ne).mp hab_div
      have hab_L : ((a : ↥F_y) : L) = y * ((b : ↥F_y) : L) := congrArg Subtype.val hab_F
      set a_L : Localization.AtPrime q_y := algebraMap ↥O_y (Localization.AtPrime q_y) a
      set b_L : Localization.AtPrime q_y := algebraMap ↥O_y (Localization.AtPrime q_y) b
      have hφ_ab : φ_loc a_L = ⟨y, hy⟩ * φ_loc b_L := by
        rw [hφ_loc_eq a, hφ_loc_eq b]
        exact Subtype.ext hab_L
      have hφb_ne : φ_loc b_L ≠ 0 := by
        rw [hφ_loc_eq b]
        intro h0
        exact hbL_ne (congrArg Subtype.val h0)
      have hd_exists : ∃ d_L : Localization.AtPrime q_y, b_L * d_L = a_L := by
        rcases ValuationRing.cond b_L a_L with ⟨d_L, hd | hd⟩
        · exact ⟨d_L, hd⟩
        · by_cases hdu : IsUnit d_L
          · rcases hdu with ⟨u_d, rfl⟩
            refine ⟨↑(u_d⁻¹), ?_⟩
            rw [← hd, mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one]
          · exfalso
            obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj q_y.primeCompl d_L
            dsimp only at hcs
            have hc_mem : c ∈ q_y := by
              by_contra hc_not_mem
              have hc_unit : IsUnit (algebraMap ↥O_y (Localization.AtPrime q_y) c) :=
                IsLocalization.map_units (Localization.AtPrime q_y)
                  (⟨c, hc_not_mem⟩ : q_y.primeCompl)
              obtain ⟨u_s, hus⟩ := IsLocalization.map_units (Localization.AtPrime q_y) s
              rw [← hus] at hcs
              have hd_eq : d_L = algebraMap ↥O_y (Localization.AtPrime q_y) c * ↑(u_s⁻¹) := by
                rw [← hcs, mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one]
              exact hdu (hd_eq ▸ hc_unit.mul u_s⁻¹.isUnit)
            have hφ_cs : φ_loc d_L * ι_Oy s = ι_Oy c := by
              have h1 := congrArg φ_loc hcs
              rwa [map_mul, hφ_loc_eq s, hφ_loc_eq c] at h1
            obtain ⟨v_s, hvs⟩ := hs_unit s
            have hφd_eq : φ_loc d_L = ι_Oy c * ↑(v_s⁻¹) := by
              rw [← hvs] at hφ_cs
              rw [← hφ_cs, mul_assoc, ← Units.val_mul, mul_inv_cancel, Units.val_one, mul_one]
            have hφd_max : φ_loc d_L ∈ IsLocalRing.maximalIdeal ↥W₁' := by
              rw [hφd_eq]
              exact Ideal.mul_mem_right _ _ hc_mem
            have hφ_hd : φ_loc b_L * (⟨y, hy⟩ * φ_loc d_L) = φ_loc b_L * 1 := by
              have h1 := congrArg φ_loc hd
              rw [map_mul, hφ_ab] at h1
              calc
                φ_loc b_L * (⟨y, hy⟩ * φ_loc d_L) = ⟨y, hy⟩ * φ_loc b_L * φ_loc d_L := by ring
                _ = φ_loc b_L := h1
                _ = φ_loc b_L * 1 := (mul_one _).symm
            have h1_eq : ⟨y, hy⟩ * φ_loc d_L = 1 := mul_left_cancel₀ hφb_ne hφ_hd
            have h1_mem : (1 : ↥W₁') ∈ IsLocalRing.maximalIdeal ↥W₁' := by
              rw [← h1_eq]
              exact Ideal.mul_mem_left _ _ hφd_max
            exact IsLocalRing.notMem_maximalIdeal.mpr isUnit_one h1_mem
      obtain ⟨d_L, hd_eq⟩ := hd_exists
      obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj q_y.primeCompl d_L
      dsimp only at hcs
      have has_eq_bc_L :
          algebraMap ↥O_y (Localization.AtPrime q_y) (a * (s : ↥O_y)) =
            algebraMap ↥O_y (Localization.AtPrime q_y) (b * c) := by
        rw [map_mul, map_mul]
        change a_L * algebraMap ↥O_y (Localization.AtPrime q_y) (s : ↥O_y) =
          b_L * algebraMap ↥O_y (Localization.AtPrime q_y) c
        rw [← hd_eq, mul_assoc, hcs]
      have hle_nzd : q_y.primeCompl ≤ nonZeroDivisors ↥O_y :=
        fun x hx => mem_nonZeroDivisors_iff_ne_zero.mpr fun hx0 => hx (hx0 ▸ q_y.zero_mem)
      have has_eq_bc : a * (s : ↥O_y) = b * c :=
        IsLocalization.injective (Localization.AtPrime q_y) hle_nzd has_eq_bc_L
      let c_val : L := ((c : ↥F_y) : L)
      let s_val : L := (((s : ↥O_y) : ↥F_y) : L)
      have hys_eq : y * s_val = c_val := by
        have h1 : ((a : ↥F_y) : L) * s_val = ((b : ↥F_y) : L) * c_val :=
          congrArg (fun u : ↥O_y => ((u : ↥F_y) : L)) has_eq_bc
        rw [hab_L] at h1
        have h2 : ((b : ↥F_y) : L) * (y * s_val) = ((b : ↥F_y) : L) * c_val := by
          calc
            ((b : ↥F_y) : L) * (y * s_val) = y * ((b : ↥F_y) : L) * s_val := by ring
            _ = ((b : ↥F_y) : L) * c_val := h1
        exact mul_left_cancel₀ hbL_ne h2
      have hsO_ne : (s : ↥O_y) ≠ 0 := fun h0 => s.2 (h0 ▸ q_y.zero_mem)
      have hsF_ne : ((s : ↥O_y) : ↥F_y) ≠ 0 := fun h0 => hsO_ne (Subtype.ext h0)
      have hs_val_ne : s_val ≠ 0 := fun h0 => hsF_ne (Subtype.ext h0)
      have hs_not_nonunit : s_val ∉ W₁'.nonunits := by
        intro hs_nu
        have hs_max : ι_Oy s ∈ IsLocalRing.maximalIdeal ↥W₁' :=
          ValuationSubring.coe_mem_nonunits_iff.mp hs_nu
        exact s.2 hs_max
      have hgs_not_nonunit : g' s_val ∉ W₀'.nonunits :=
        fun hgs_nu => hs_not_nonunit ((hNonunits' s_val (hu_int s)).mpr hgs_nu)
      have hgs_inv_W₀' : (g' s_val)⁻¹ ∈ W₀' := by
        by_contra hinv
        exact hgs_not_nonunit ((ValuationSubring.mem_nonunits_iff_or W₀').mpr (Or.inr hinv))
      have hy_div : y = c_val * s_val⁻¹ := by
        rw [← hys_eq, mul_assoc, mul_inv_cancel₀ hs_val_ne, mul_one]
      rw [hy_div, map_mul, map_inv₀]
      exact W₀'.toSubring.mul_mem (hgu_W₀' c) hgs_inv_W₀'
    intro W₀ W₁ hComap hDed₀ hMax₀ g hNonunits y
    refine ⟨hFwd W₀ W₁ hComap hDed₀ hMax₀ g hNonunits y, fun hy₀ => ?_⟩
    have hNonunits_symm : ∀ b : L,
        ((algebraMap M L).comp (W₁.comap (algebraMap M L)).subtype).IsIntegralElem b →
        (b ∈ W₀.nonunits ↔ g.symm b ∈ W₁.nonunits) := by
      intro b hb₁
      have hb₀ : ((algebraMap M L).comp (W₀.comap (algebraMap M L)).subtype).IsIntegralElem b :=
        hComap.symm ▸ hb₁
      have hg_symm_comp :
          g.symm.toRingHom.comp ((algebraMap M L).comp (W₀.comap (algebraMap M L)).subtype) =
            (algebraMap M L).comp (W₀.comap (algebraMap M L)).subtype :=
        RingHom.ext fun r => g.symm.commutes (r : M)
      have hgsb₀ :
          ((algebraMap M L).comp (W₀.comap (algebraMap M L)).subtype).IsIntegralElem (g.symm b) := by
        rw [← hg_symm_comp]
        exact RingHom.IsIntegralElem.map hb₀ g.symm.toRingHom
      have hiff := (hNonunits (g.symm b) hgsb₀).symm
      rwa [g.apply_symm_apply] at hiff
    have hback := hFwd W₁ W₀ hComap.symm (hComap ▸ hDed₀) (hComap ▸ hMax₀)
      g.symm hNonunits_symm (g y) hy₀
    rwa [g.symm_apply_apply] at hback

  have hPowMem : ∀ (U : ValuationSubring Ω) (w : Ω) (m : ℕ),
      1 ≤ m → (w ∈ U ↔ w ^ m ∈ U) := by
    intro U w m hm
    refine ⟨fun hw => U.toSubring.pow_mem hw m, fun hwm => ?_⟩
    by_contra hw
    have hw_ne : w ≠ 0 := fun h0 => hw (h0 ▸ U.toSubring.zero_mem)
    have hw_inv : w⁻¹ ∈ U := (ValuationSubring.mem_or_inv_mem U w).resolve_left hw
    have hw_inv_pow : (w⁻¹) ^ (m - 1) ∈ U := U.toSubring.pow_mem hw_inv (m - 1)
    have hwm_split : w ^ m = w ^ (m - 1) * w := by
      rw [← pow_succ, Nat.sub_add_cancel hm]
    have hprod_eq : w ^ m * (w⁻¹) ^ (m - 1) = w := by
      rw [hwm_split, inv_pow, mul_right_comm,
        mul_inv_cancel₀ (pow_ne_zero (m - 1) hw_ne), one_mul]
    exact hw (hprod_eq ▸ U.toSubring.mul_mem hwm hw_inv_pow)

  have _ : IsAlgClosure M Ω := IsAlgClosure.mk inferInstance inferInstance
  have _ : Normal M Ω := IsAlgClosure.normal M Ω
  let M_sep : IntermediateField M Ω := separableClosure M Ω
  have _ : IsGalois M ↥M_sep := separableClosure.isGalois M Ω
  have _ : Algebra.IsSeparable M ↥M_sep := separableClosure.isSeparable M Ω
  let γ₀ : Ω ≃+* Ω := IsAlgClosure.equivOfEquiv Ω Ω σ_M
  have hγ₀_M : ∀ x : M, γ₀ (algebraMap M Ω x) = algebraMap M Ω (σ_M x) :=
    IsAlgClosure.equivOfEquiv_algebraMap Ω Ω σ_M
  let V₁ : ValuationSubring Ω := V.comap γ₀.toRingHom
  have hComap_Ω : V.comap (algebraMap M Ω) = V₁.comap (algebraMap M Ω) := by
    ext x
    change algebraMap M Ω x ∈ V ↔ γ₀ (algebraMap M Ω x) ∈ V
    rw [hγ₀_M x]
    exact hStab x
  let W₀ : ValuationSubring ↥M_sep := V.comap (algebraMap ↥M_sep Ω)
  let W₁ : ValuationSubring ↥M_sep := V₁.comap (algebraMap ↥M_sep Ω)
  have hTower_M_sep : (algebraMap ↥M_sep Ω).comp (algebraMap M ↥M_sep) = algebraMap M Ω :=
    RingHom.ext (IsScalarTower.algebraMap_apply M ↥M_sep Ω)
  have hW₀_eq : W₀.comap (algebraMap M ↥M_sep) = V.comap (algebraMap M Ω) := by
    rw [ValuationSubring.comap_comap, hTower_M_sep]
  have hW₁_eq : W₁.comap (algebraMap M ↥M_sep) = V₁.comap (algebraMap M Ω) := by
    rw [ValuationSubring.comap_comap, hTower_M_sep]
  have hW_comap : W₀.comap (algebraMap M ↥M_sep) = W₁.comap (algebraMap M ↥M_sep) :=
    hW₀_eq.trans (hComap_Ω.trans hW₁_eq.symm)
  have hDed_W₀ : IsDedekindDomain ↥(W₀.comap (algebraMap M ↥M_sep)) := hW₀_eq.symm ▸ hDed
  have hMax_W₀ : IsLocalRing.maximalIdeal ↥(W₀.comap (algebraMap M ↥M_sep)) ≠ ⊥ :=
    hW₀_eq.symm ▸ hMax_ne

  obtain ⟨g, hg_nonunits⟩ := hStepProfinite ↥M_sep W₀ W₁ hW_comap
  have hg_W : ∀ y : ↥M_sep, y ∈ W₁ ↔ g y ∈ W₀ :=
    hStepDedekind ↥M_sep W₀ W₁ hW_comap hDed_W₀ hMax_W₀ g hg_nonunits
  have hg_V : ∀ y : ↥M_sep, (y : Ω) ∈ V₁ ↔ (g y : Ω) ∈ V := hg_W

  have _ : Algebra.IsAlgebraic ↥M_sep Ω :=
    Algebra.IsAlgebraic.tower_top (K := M) (A := Ω) ↥M_sep
  have _ : IsAlgClosure ↥M_sep Ω := IsAlgClosure.mk inferInstance inferInstance
  let h : Ω ≃+* Ω := IsAlgClosure.equivOfEquiv Ω Ω g.toRingEquiv
  have hh_sep : ∀ y : ↥M_sep, h (y : Ω) = (g y : Ω) :=
    IsAlgClosure.equivOfEquiv_algebraMap Ω Ω g.toRingEquiv
  have hh_M : ∀ x : M, h (algebraMap M Ω x) = algebraMap M Ω x := by
    intro x
    rw [IsScalarTower.algebraMap_apply M ↥M_sep Ω x, IntermediateField.algebraMap_apply,
      hh_sep (algebraMap M ↥M_sep x)]
    exact congrArg Subtype.val (g.commutes x)

  let q : ℕ := ringExpChar ↥M_sep
  have _ : ExpChar ↥M_sep q := ringExpChar.expChar ↥M_sep
  have _ : IsPurelyInseparable ↥M_sep Ω := separableClosure.isPurelyInseparable M Ω
  have hq_pos : 0 < q := expChar_pos ↥M_sep q
  have hh_V : ∀ z : Ω, z ∈ V₁ ↔ h z ∈ V := by
    intro z
    obtain ⟨n, y, hy_eq⟩ := IsPurelyInseparable.pow_mem ↥M_sep q z
    have hqn_ge : 1 ≤ q ^ n := Nat.one_le_pow n q hq_pos
    have hy_coe : (y : Ω) = z ^ (q ^ n) := hy_eq
    have hhz_pow : (h z) ^ (q ^ n) = (g y : Ω) := by
      rw [← map_pow h z (q ^ n), ← hy_coe, hh_sep y]
    rw [hPowMem V₁ z (q ^ n) hqn_ge, ← hy_coe, hg_V y, ← hhz_pow, ← hPowMem V (h z) (q ^ n) hqn_ge]

  let γ : Ω ≃+* Ω := h.symm.trans γ₀
  refine ⟨γ, fun x => ?_, fun z => ?_⟩
  · have hsymm_x : h.symm (algebraMap M Ω x) = algebraMap M Ω x := by
      have h1 := congrArg h.symm (hh_M x)
      rw [h.symm_apply_apply] at h1
      exact h1.symm
    change γ₀ (h.symm (algebraMap M Ω x)) = algebraMap M Ω (σ_M x)
    rw [hsymm_x, hγ₀_M x]
  · change z ∈ V ↔ γ₀ (h.symm z) ∈ V
    have hz_eq : z = h (h.symm z) := (h.apply_symm_apply z).symm
    conv_lhs => rw [hz_eq]
    rw [← hh_V (h.symm z)]
    rfl

theorem weil_dvr_slice_trivial_inertia_implies_isUnramifiedAt (k : Type u) [Field k]
    (K₂ L₂ : Type u) [Field K₂] [Field L₂]
    [Algebra (MvPolynomial (Fin 2) k) K₂]
    [IsFractionRing (MvPolynomial (Fin 2) k) K₂]
    [Algebra K₂ L₂] [Algebra (MvPolynomial (Fin 2) k) L₂]
    [IsScalarTower (MvPolynomial (Fin 2) k) K₂ L₂]
    [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
    (H : MvPolynomial (Fin 2) k) (hH_irr : Irreducible H)
    (Q : Ideal ↥(integralClosure (MvPolynomial (Fin 2) k) L₂)) [Q.IsPrime]
    (hQ_comap : Ideal.comap
      (algebraMap (MvPolynomial (Fin 2) k) ↥(integralClosure (MvPolynomial (Fin 2) k) L₂)) Q =
      Ideal.span {H})
    (hTrivInert : ∀ σ : L₂ ≃ₐ[K₂] L₂,
      (∀ y : ↥(integralClosure (MvPolynomial (Fin 2) k) L₂),
        σ (y : L₂) - (y : L₂) ∈
          Subtype.val '' (Q : Set ↥(integralClosure (MvPolynomial (Fin 2) k) L₂))) →
      σ = 1) :
    Algebra.IsUnramifiedAt (MvPolynomial (Fin 2) k) Q :=
by
  
  have hFieldAutSqueeze : ∀ (F E : Type u) [Field F] [Field E] [Algebra F E]
      [FiniteDimensional F E],
      Finite (E ≃ₐ[F] E) ∧
      1 ≤ Module.finrank F ↥(separableClosure F E) ∧
      Module.finrank F ↥(separableClosure F E) ≤ Module.finrank F E ∧
      Nat.card (E ≃ₐ[F] E) ≤ Module.finrank F ↥(separableClosure F E) ∧
      (Module.finrank F E ≤ Module.finrank F ↥(separableClosure F E) →
        Algebra.IsSeparable F E) := by
    intro F E _ _ _ _
    let F_sep := separableClosure F E
    have hfsep_pos : 1 ≤ Module.finrank F ↥F_sep := Module.finrank_pos
    have hfinsep_pos : 1 ≤ Module.finrank ↥F_sep E := Module.finrank_pos
    have hmul : Module.finrank F ↥F_sep * Module.finrank ↥F_sep E = Module.finrank F E :=
      Module.finrank_mul_finrank F ↥F_sep E
    have hfsep_le : Module.finrank F ↥F_sep ≤ Module.finrank F E := by
      calc Module.finrank F ↥F_sep = Module.finrank F ↥F_sep * 1 := (Nat.mul_one _).symm
        _ ≤ Module.finrank F ↥F_sep * Module.finrank ↥F_sep E :=
          Nat.mul_le_mul_left _ hfinsep_pos
        _ = Module.finrank F E := hmul
    have hSepOfLe : Module.finrank F E ≤ Module.finrank F ↥F_sep → Algebra.IsSeparable F E := by
      intro hle
      have hmul_le : Module.finrank F ↥F_sep * Module.finrank ↥F_sep E ≤
          Module.finrank F ↥F_sep * 1 := by
        rw [hmul, Nat.mul_one]
        exact hle
      have hfinsep_le_one : Module.finrank ↥F_sep E ≤ 1 :=
        Nat.le_of_mul_le_mul_left hmul_le hfsep_pos
      have hfinsep_eq_one : Module.finrank ↥F_sep E = 1 :=
        Nat.le_antisymm hfinsep_le_one hfinsep_pos
      have htop : F_sep = ⊤ := IntermediateField.finrank_eq_one_iff_eq_top.mp hfinsep_eq_one
      haveI : Algebra.IsSeparable F ↥F_sep := separableClosure.isSeparable F E
      exact AlgEquiv.Algebra.isSeparable
        ((IntermediateField.equivOfEq htop).trans IntermediateField.topEquiv)
    let ρ : (E ≃ₐ[F] E) → (↥F_sep →ₐ[F] E) := fun α => α.toAlgHom.comp F_sep.val
    have hρ_inj : Function.Injective ρ := by
      intro α₁ α₂ hEq
      haveI : Algebra.IsAlgebraic F E := Algebra.IsAlgebraic.of_finite F E
      haveI : IsPurelyInseparable ↥F_sep E := separableClosure.isPurelyInseparable F E
      let q := ringExpChar E
      haveI : ExpChar E q := ringExpChar.expChar E
      haveI : ExpChar ↥F_sep q :=
        RingHom.expChar (algebraMap ↥F_sep E) (RingHom.injective _) q
      ext x
      obtain ⟨n, y, hy⟩ := IsPurelyInseparable.pow_mem ↥F_sep q x
      have hy_eq : α₁ (algebraMap ↥F_sep E y) = α₂ (algebraMap ↥F_sep E y) :=
        AlgHom.congr_fun hEq y
      have hpow_eq : (α₁ x) ^ q ^ n = (α₂ x) ^ q ^ n := by
        rw [← map_pow, ← map_pow, ← hy, hy_eq]
      have hsub_pow : (α₁ x - α₂ x) ^ q ^ n = 0 := by
        rw [sub_pow_expChar_pow (α₁ x) (α₂ x) n, hpow_eq, sub_self]
      exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hsub_pow)
    have hFinAut : Finite (E ≃ₐ[F] E) := Finite.of_injective ρ hρ_inj
    have hCardLe : Nat.card (E ≃ₐ[F] E) ≤ Module.finrank F ↥F_sep :=
      (Nat.card_le_card_of_injective ρ hρ_inj).trans (card_algHom_le_finrank F ↥F_sep E)
    exact ⟨hFinAut, hfsep_pos, hfsep_le, hCardLe, hSepOfLe⟩

  
  let R₂ := MvPolynomial (Fin 2) k
  let B₂ := integralClosure R₂ L₂
  letI : CommRing ↥B₂ := Subalgebra.toCommRing B₂
  let 𝔭₀ : Ideal R₂ := Ideal.span {H}
  haveI h𝔭₀_prime : 𝔭₀.IsPrime := by
    dsimp [𝔭₀]
    rw [← hQ_comap]
    exact Ideal.IsPrime.comap (algebraMap R₂ ↥B₂)
  let S₀ : Submonoid R₂ := 𝔭₀.primeCompl
  let A₀ := Localization.AtPrime 𝔭₀
  have hS₀_nzd : S₀ ≤ nonZeroDivisors R₂ := 𝔭₀.primeCompl_le_nonZeroDivisors
  haveI : IsNoetherianRing A₀ := IsLocalization.isNoetherianRing S₀ A₀ inferInstance
  haveI : IsDomain A₀ := IsLocalization.isDomain_localization hS₀_nzd
  have hinj_RA : Function.Injective (algebraMap R₂ A₀) := IsLocalization.injective A₀ hS₀_nzd
  have hinj_RK : Function.Injective (algebraMap R₂ K₂) := IsFractionRing.injective R₂ K₂
  have hinj_RL : Function.Injective (algebraMap R₂ L₂) := by
    intro r₁ r₂ hr
    rw [IsScalarTower.algebraMap_apply R₂ K₂ L₂, IsScalarTower.algebraMap_apply R₂ K₂ L₂] at hr
    exact hinj_RK ((RingHom.injective (algebraMap K₂ L₂)) hr)

  let 𝔪₀ : Ideal A₀ := IsLocalRing.maximalIdeal A₀
  haveI h𝔪₀_max : 𝔪₀.IsMaximal := IsLocalRing.maximalIdeal.isMaximal A₀
  let h_A₀ : A₀ := algebraMap R₂ A₀ H
  have h𝔪₀_span : 𝔪₀ = Ideal.span {h_A₀} := by
    have hmap := (IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭₀ A₀).symm
    change 𝔪₀ = Ideal.map (algebraMap R₂ A₀) (Ideal.span {H}) at hmap
    rw [hmap, Ideal.map_span, Set.image_singleton]
  have hhA₀_ne : h_A₀ ≠ 0 := fun h0 =>
    hH_irr.ne_zero (hinj_RA (h0.trans (map_zero (algebraMap R₂ A₀)).symm))
  have hhA₀_mem : h_A₀ ∈ 𝔪₀ := by
    rw [h𝔪₀_span]
    exact Ideal.mem_span_singleton_self h_A₀
  have h𝔪₀_ne : 𝔪₀ ≠ ⊥ := by
    intro hbot
    rw [hbot, Ideal.mem_bot] at hhA₀_mem
    exact hhA₀_ne hhA₀_mem
  have hNotField_A₀ : ¬ IsField A₀ := by
    intro hF
    obtain ⟨u, hu⟩ := hF.mul_inv_cancel hhA₀_ne
    have h1_mem : (1 : A₀) ∈ 𝔪₀ := hu ▸ Ideal.mul_mem_right u 𝔪₀ hhA₀_mem
    exact h𝔪₀_max.ne_top ((Ideal.eq_top_iff_one 𝔪₀).mpr h1_mem)
  have hPrinc_𝔪₀ : Submodule.IsPrincipal (IsLocalRing.maximalIdeal A₀) :=
    ⟨⟨h_A₀, h𝔪₀_span.trans (Ideal.span_singleton_eq_span_singleton.mpr Associated.rfl)⟩⟩
  haveI hDed_A₀ : IsDedekindDomain A₀ :=
    ((IsDiscreteValuationRing.TFAE A₀ hNotField_A₀).out 5 3).mp hPrinc_𝔪₀

  
  have hS₀_units_K₂ : ∀ y : S₀, IsUnit (algebraMap R₂ K₂ y.1) := by
    intro y
    refine IsUnit.mk0 _ ?_
    intro h0
    have hy0 : y.1 = 0 := hinj_RK (h0.trans (map_zero (algebraMap R₂ K₂)).symm)
    exact y.2 (hy0 ▸ 𝔭₀.zero_mem)
  let φ_AK : A₀ →+* K₂ := IsLocalization.lift hS₀_units_K₂
  letI algAK : Algebra A₀ K₂ := φ_AK.toAlgebra
  letI algAL : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp φ_AK).toAlgebra
  haveI : IsScalarTower R₂ A₀ K₂ :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun r =>
      (IsLocalization.lift_eq hS₀_units_K₂ r).symm)
  haveI : IsScalarTower A₀ K₂ L₂ := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower R₂ A₀ L₂ :=
    IsScalarTower.of_algebraMap_eq fun r => by
      change algebraMap R₂ L₂ r = algebraMap K₂ L₂ (φ_AK (algebraMap R₂ A₀ r))
      rw [IsLocalization.lift_eq hS₀_units_K₂ r, IsScalarTower.algebraMap_apply R₂ K₂ L₂]

  have hinj_AK : Function.Injective (algebraMap A₀ K₂) := by
    rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_bot_iff_eq_zero]
    intro a ha
    obtain ⟨⟨r, s⟩, hrs⟩ := IsLocalization.surj S₀ a
    have hmul : algebraMap A₀ K₂ (a * algebraMap R₂ A₀ s.1) = 0 := by
      rw [map_mul, ha, zero_mul]
    rw [hrs, ← IsScalarTower.algebraMap_apply R₂ A₀ K₂] at hmul
    have hr0 : r = 0 := hinj_RK (hmul.trans (map_zero _).symm)
    have hs_unit : IsUnit (algebraMap R₂ A₀ s.1) := IsLocalization.map_units A₀ s
    rw [hr0, map_zero] at hrs
    exact hs_unit.mul_left_eq_zero.mp hrs

  haveI hFrac_AK : IsFractionRing A₀ K₂ :=
    { map_units := fun y => by
        have hy_ne : (y : A₀) ≠ 0 := nonZeroDivisors.ne_zero y.2
        exact IsUnit.mk0 _ (fun h0 => hy_ne (hinj_AK (h0.trans (map_zero _).symm)))
      surj := fun z => by
        obtain ⟨⟨r, t⟩, hzt⟩ := IsLocalization.surj (nonZeroDivisors R₂) z
        have ht_ne : (t : R₂) ≠ 0 := nonZeroDivisors.ne_zero t.2
        have htA_ne : algebraMap R₂ A₀ t.1 ≠ 0 := fun h0 =>
          ht_ne (hinj_RA (h0.trans (map_zero _).symm))
        refine ⟨⟨algebraMap R₂ A₀ r, ⟨algebraMap R₂ A₀ t.1,
          mem_nonZeroDivisors_iff_ne_zero.mpr htA_ne⟩⟩, ?_⟩
        dsimp only
        rw [← IsScalarTower.algebraMap_apply R₂ A₀ K₂,
          ← IsScalarTower.algebraMap_apply R₂ A₀ K₂]
        exact hzt
      exists_of_eq := fun {x y} hxy => ⟨1, by simp [hinj_AK hxy]⟩ }

  
  let C₀ := integralClosure A₀ L₂
  letI : CommRing ↥C₀ := Subalgebra.toCommRing C₀
  let ι_BC : ↥B₂ →+* ↥C₀ :=
    { toFun := fun y => ⟨y.1, IsIntegral.tower_top (R := R₂) y.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hinj_BC : Function.Injective ι_BC := fun y₁ y₂ h =>
    Subtype.ext (congrArg (Subtype.val : ↥C₀ → L₂) h)
  letI algBC : Algebra ↥B₂ ↥C₀ := ι_BC.toAlgebra
  haveI : IsScalarTower ↥B₂ ↥C₀ L₂ := IsScalarTower.of_algebraMap_eq' rfl
  haveI hST_RBC : IsScalarTower R₂ ↥B₂ ↥C₀ :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl

  haveI hLoc_L₂ : IsLocalization (Algebra.algebraMapSubmonoid L₂ S₀) L₂ := by
    refine IsLocalization.of_le_isUnit ?_
    rintro _ ⟨s, hs, rfl⟩
    refine IsUnit.mk0 _ ?_
    intro h0
    have hs0 : s = 0 := hinj_RL (h0.trans (map_zero (algebraMap R₂ L₂)).symm)
    exact hs (hs0 ▸ 𝔭₀.zero_mem)

  let M_B : Submonoid ↥B₂ := Algebra.algebraMapSubmonoid ↥B₂ S₀
  haveI hLoc_BC : IsLocalization M_B ↥C₀ :=
    @IsLocalization.integralClosure R₂ _ L₂ _ _ A₀ L₂ _ _ _ (Algebra.id L₂) _ _
      IsScalarTower.right inferInstance S₀ inferInstance hLoc_L₂ algBC inferInstance hST_RBC

  
  have hDisj_MB_Q : Disjoint (M_B : Set ↥B₂) (Q : Set ↥B₂) := by
    rw [Set.disjoint_left]
    rintro _ ⟨s, hs, rfl⟩ hmemQ
    have hs_in : s ∈ Ideal.comap (algebraMap R₂ ↥B₂) Q := hmemQ
    rw [hQ_comap] at hs_in
    exact hs hs_in

  let Q₀ : Ideal ↥C₀ := Ideal.map (algebraMap ↥B₂ ↥C₀) Q
  haveI hQ₀_prime : Q₀.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint M_B ↥C₀ Q inferInstance hDisj_MB_Q
  have hQ₀_under_B : Ideal.comap (algebraMap ↥B₂ ↥C₀) Q₀ = Q :=
    IsLocalization.under_map_of_isPrime_disjoint M_B ↥C₀ inferInstance hDisj_MB_Q

  haveI hDed_C₀ : IsDedekindDomain ↥C₀ := integralClosure.isDedekindDomain A₀ K₂ L₂
  have hQ₀_ne : Q₀ ≠ ⊥ := by
    have hH_mem_comap : H ∈ Ideal.comap (algebraMap R₂ ↥B₂) Q := by
      rw [hQ_comap]
      exact Ideal.mem_span_singleton_self H
    let b_H : ↥B₂ := algebraMap R₂ ↥B₂ H
    have hbH_mem : b_H ∈ Q := hH_mem_comap
    have hcH_mem : algebraMap ↥B₂ ↥C₀ b_H ∈ Q₀ := Ideal.mem_map_of_mem _ hbH_mem
    have hcH_ne : algebraMap ↥B₂ ↥C₀ b_H ≠ 0 := by
      intro h0
      have hL0 : algebraMap R₂ L₂ H = 0 := congrArg Subtype.val h0
      exact hH_irr.ne_zero (hinj_RL (hL0.trans (map_zero _).symm))
    intro hbot
    rw [hbot, Ideal.mem_bot] at hcH_mem
    exact hcH_ne hcH_mem

  haveI hQ₀_max : Q₀.IsMaximal :=
    @Ideal.IsPrime.isMaximal ↥C₀ _ inferInstance Q₀ hQ₀_prime hQ₀_ne
  have hQ₀_over_𝔪₀ : 𝔪₀ = Ideal.comap (algebraMap A₀ ↥C₀) Q₀ := by
    have hH_mem_Q : algebraMap R₂ ↥B₂ H ∈ Q := by
      change H ∈ Ideal.comap (algebraMap R₂ ↥B₂) Q
      rw [hQ_comap]
      exact Ideal.mem_span_singleton_self H
    have hhA₀_in : h_A₀ ∈ Ideal.comap (algebraMap A₀ ↥C₀) Q₀ := by
      change algebraMap A₀ ↥C₀ (algebraMap R₂ A₀ H) ∈ Q₀
      rw [← IsScalarTower.algebraMap_apply R₂ A₀ ↥C₀,
        IsScalarTower.algebraMap_apply R₂ ↥B₂ ↥C₀]
      exact Ideal.mem_map_of_mem _ hH_mem_Q
    have hle : 𝔪₀ ≤ Ideal.comap (algebraMap A₀ ↥C₀) Q₀ := by
      rw [h𝔪₀_span, Ideal.span_singleton_le_iff_mem]
      exact hhA₀_in
    have hcomap_prime : (Ideal.comap (algebraMap A₀ ↥C₀) Q₀).IsPrime :=
      Ideal.IsPrime.comap (algebraMap A₀ ↥C₀)
    exact h𝔪₀_max.eq_of_le hcomap_prime.ne_top hle
  haveI hQ₀_liesOver : Q₀.LiesOver 𝔪₀ := ⟨hQ₀_over_𝔪₀⟩

  
  have hTrivInert_C₀ : ∀ σ : L₂ ≃ₐ[K₂] L₂,
      (∀ z : ↥C₀, σ (z : L₂) - (z : L₂) ∈ Subtype.val '' (Q₀ : Set ↥C₀)) →
      σ = 1 := by
    intro σ hσ
    apply hTrivInert σ
    intro y
    have hσy_int : IsIntegral R₂ (σ (y : L₂)) := by
      let σ_R : L₂ ≃ₐ[R₂] L₂ := σ.restrictScalars R₂
      exact IsIntegral.map σ_R y.2
    let d : ↥B₂ := ⟨σ (y : L₂), hσy_int⟩ - y
    obtain ⟨q₀, hq₀_mem, hq₀_eq⟩ := hσ (algebraMap ↥B₂ ↥C₀ y)
    have hd_eq : (algebraMap ↥B₂ ↥C₀ d : L₂) = (q₀ : L₂) := by
      change σ (y : L₂) - (y : L₂) = (q₀ : L₂)
      exact hq₀_eq.symm
    have hd_C₀ : algebraMap ↥B₂ ↥C₀ d = q₀ := Subtype.ext hd_eq
    have hd_in_Q : d ∈ Q := by
      rw [← hQ₀_under_B]
      change algebraMap ↥B₂ ↥C₀ d ∈ Q₀
      rw [hd_C₀]
      exact hq₀_mem
    exact ⟨d, hd_in_Q, rfl⟩

  
  have hDedGalois : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDedekindDomain A]
      (K L : Type u) [Field K] [Field L]
      [Algebra A K] [IsFractionRing A K]
      [Algebra K L] [Algebra A L] [IsScalarTower A K L]
      [FiniteDimensional K L] [IsGalois K L]
      (𝔪 : Ideal A) [𝔪.IsMaximal] (_ : 𝔪 ≠ ⊥)
      (Q' : Ideal ↥(integralClosure A L)) [Q'.IsMaximal] [Q'.LiesOver 𝔪] (_ : Q' ≠ ⊥),
      (∀ σ : L ≃ₐ[K] L,
        (∀ z : ↥(integralClosure A L),
          σ (z : L) - (z : L) ∈ Subtype.val '' (Q' : Set ↥(integralClosure A L))) →
        σ = 1) →
      Algebra.IsUnramifiedAt A Q' := by
    intro A _ _ _ K L _ _ _ _ _ _ _ _ _ 𝔪 _ h𝔪_ne Q' _ hQ'_lies hQ'_ne hTrivInert_C
    let C := integralClosure A L
    letI : CommRing ↥C := Subalgebra.toCommRing C
    letI : Algebra (A ⧸ 𝔪) (↥C ⧸ Q') := inferInstance
    open scoped Pointwise in
    let G := L ≃ₐ[K] L
    haveI : IsDedekindDomain ↥C := integralClosure.isDedekindDomain A K L
    haveI : IsFractionRing ↥C L := integralClosure.isFractionRing_of_finite_extension K L
    haveI : Module.Finite A ↥C := IsIntegralClosure.finite A K L ↥C
    have hinj_AK' : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
    have hinj_AC : Function.Injective (algebraMap A ↥C) := by
      intro a₁ a₂ ha
      have hL : algebraMap A L a₁ = algebraMap A L a₂ := congrArg Subtype.val ha
      rw [IsScalarTower.algebraMap_apply A K L, IsScalarTower.algebraMap_apply A K L] at hL
      exact hinj_AK' ((RingHom.injective (algebraMap K L)) hL)
    haveI hTF_AC : Module.IsTorsionFree A ↥C :=
      ⟨fun r hr z₁ z₂ hz => by
        have hr_ne : r ≠ 0 := hr.ne_zero
        have hrc_ne : algebraMap A ↥C r ≠ 0 := fun h0 =>
          hr_ne (hinj_AC (h0.trans (map_zero _).symm))
        dsimp only at hz
        rw [Algebra.smul_def, Algebra.smul_def] at hz
        exact mul_left_cancel₀ hrc_ne hz⟩
    haveI : Module.Flat A ↥C :=
      @Module.Flat.instOfIsDedekindDomainOfIsTorsionFree A ↥C _ _ _ inferInstance hTF_AC
    letI actG : MulSemiringAction G ↥C :=
      { smul := fun σ z => ⟨σ (z : L), by
          let σ_A : L ≃ₐ[A] L := σ.restrictScalars A
          exact IsIntegral.map σ_A z.2⟩
        one_smul := fun z => Subtype.ext (one_smul G (z : L))
        mul_smul := fun σ₁ σ₂ z => Subtype.ext (mul_smul σ₁ σ₂ (z : L))
        smul_zero := fun σ => Subtype.ext (map_zero σ)
        smul_add := fun σ z₁ z₂ => Subtype.ext (map_add σ (z₁ : L) (z₂ : L))
        smul_one := fun σ => Subtype.ext (map_one σ)
        smul_mul := fun σ z₁ z₂ => Subtype.ext (map_mul σ (z₁ : L) (z₂ : L)) }
    haveI : SMulCommClass G A ↥C :=
      ⟨fun σ a z => Subtype.ext (by
        rw [Algebra.smul_def, Algebra.smul_def]
        change σ (algebraMap A L a * (z : L)) = algebraMap A L a * σ (z : L)
        rw [map_mul, IsScalarTower.algebraMap_apply A K L, σ.commutes])⟩
    haveI : SMulDistribClass G ↥C L := ⟨fun σ z x => map_mul σ (z : L) x⟩
    haveI : IsGaloisGroup G A ↥C := IsGaloisGroup.of_isFractionRing G A ↥C K L

    have hOrbit_eq : MulAction.orbit G Q' = 𝔪.primesOver ↥C := by
      ext P
      change (P ∈ MulAction.orbit G Q') ↔ (P.IsPrime ∧ P.LiesOver 𝔪)
      rw [MulAction.mem_orbit_iff]
      constructor
      · rintro ⟨σ, rfl⟩
        refine ⟨Ideal.IsPrime.smul σ, ⟨?_⟩⟩
        rw [Ideal.under_smul A Q' σ]
        exact hQ'_lies.over
      · rintro ⟨hP_prime, hP_lies⟩
        have hunder : Ideal.under A Q' = Ideal.under A P :=
          hQ'_lies.over.symm.trans hP_lies.over
        obtain ⟨σ, hσ⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A ↥C G Q' P hunder
        exact ⟨σ, hσ.symm⟩

    let D := MulAction.stabilizer G Q'
    have hCard_orbit_stab : (𝔪.primesOver ↥C).ncard * Nat.card ↥D = Nat.card G := by
      haveI : Finite ↥(MulAction.orbit G Q') :=
        (Set.finite_range (fun σ : G => σ • Q')).to_subtype
      letI : Fintype G := Fintype.ofFinite G
      letI : Fintype ↥(MulAction.orbit G Q') := Fintype.ofFinite _
      letI : Fintype ↥D := Fintype.ofFinite _
      have hOS := MulAction.card_orbit_mul_card_stabilizer_eq_card_group G Q'
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
        ← Nat.card_eq_fintype_card] at hOS
      have hncard : Nat.card ↥(MulAction.orbit G Q') = (𝔪.primesOver ↥C).ncard := by
        rw [hOrbit_eq, Nat.card_coe_set_eq]
      rwa [hncard] at hOS

    have hefg : (𝔪.primesOver ↥C).ncard *
        (Q'.ramificationIdx A * Module.finrank (A ⧸ 𝔪) (↥C ⧸ Q')) = Nat.card G := by
      have h1 := Ideal.ncard_primesOver_mul_ramificationIdxIn_mul_inertiaDegIn 𝔪 ↥C G
      rw [Ideal.ramificationIdxIn_eq_ramificationIdx 𝔪 Q' G,
        Ideal.inertiaDegIn_eq_inertiaDeg 𝔪 Q' G,
        Ideal.inertiaDeg_eq_of_isMaximal 𝔪 Q'] at h1
      exact h1

    have hG_pos : 1 ≤ Nat.card G := Nat.card_pos
    have hg_pos : 1 ≤ (𝔪.primesOver ↥C).ncard := by
      by_contra h0
      have hz : (𝔪.primesOver ↥C).ncard = 0 := by omega
      rw [hz, zero_mul] at hCard_orbit_stab
      omega
    have he_pos : 1 ≤ Q'.ramificationIdx A := by
      by_contra h0
      have hz : Q'.ramificationIdx A = 0 := by omega
      rw [hz, zero_mul, mul_zero] at hefg
      omega

    have hef_eq_D : Q'.ramificationIdx A * Module.finrank (A ⧸ 𝔪) (↥C ⧸ Q') = Nat.card ↥D :=
      Nat.eq_of_mul_eq_mul_left hg_pos (hefg.trans hCard_orbit_stab.symm)

    have hInert_bot : Ideal.inertia G Q' = ⊥ := by
      rw [eq_bot_iff]
      intro σ hσ
      rw [Subgroup.mem_bot]
      rw [Ideal.mem_inertia] at hσ
      refine hTrivInert_C σ fun z => ?_
      exact ⟨σ • z - z, hσ z, rfl⟩

    let φ := Ideal.Quotient.stabilizerHom Q' 𝔪 G
    have hφ_inj : Function.Injective φ := by
      rw [← MonoidHom.ker_eq_bot_iff, eq_bot_iff]
      intro x hx
      have hmap : x.1 ∈ Subgroup.map D.subtype φ.ker := ⟨x, hx, rfl⟩
      rw [Ideal.Quotient.map_ker_stabilizer_subtype Q' 𝔪 G, hInert_bot,
        Subgroup.mem_bot] at hmap
      exact Subtype.ext hmap

    letI fA : Field (A ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    letI fC : Field (↥C ⧸ Q') := Ideal.Quotient.field Q'
    haveI : FiniteDimensional (A ⧸ 𝔪) (↥C ⧸ Q') := inferInstance
    obtain ⟨hFinAut, hfsep_pos, hfsep_le_f, hAut_le_fsep, hSep_of_le⟩ :=
      hFieldAutSqueeze (A ⧸ 𝔪) (↥C ⧸ Q')
    haveI : Finite ((↥C ⧸ Q') ≃ₐ[A ⧸ 𝔪] (↥C ⧸ Q')) := hFinAut
    have hD_le_fsep : Nat.card ↥D ≤
        Module.finrank (A ⧸ 𝔪) ↥(separableClosure (A ⧸ 𝔪) (↥C ⧸ Q')) :=
      (Nat.card_le_card_of_injective φ hφ_inj).trans hAut_le_fsep

    have hef_le_fsep : Q'.ramificationIdx A * Module.finrank (A ⧸ 𝔪) (↥C ⧸ Q') ≤
        Module.finrank (A ⧸ 𝔪) ↥(separableClosure (A ⧸ 𝔪) (↥C ⧸ Q')) := by
      rwa [hef_eq_D]
    have hf_pos : 0 < Module.finrank (A ⧸ 𝔪) (↥C ⧸ Q') :=
      Nat.lt_of_lt_of_le hfsep_pos hfsep_le_f
    have he_le_one : Q'.ramificationIdx A ≤ 1 := by
      apply Nat.le_of_mul_le_mul_right _ hf_pos
      rw [one_mul]
      exact hef_le_fsep.trans hfsep_le_f
    have he1 : Q'.ramificationIdx A = 1 := Nat.le_antisymm he_le_one he_pos
    have hf_le_fsep : Module.finrank (A ⧸ 𝔪) (↥C ⧸ Q') ≤
        Module.finrank (A ⧸ 𝔪) ↥(separableClosure (A ⧸ 𝔪) (↥C ⧸ Q')) := by
      simpa [he1] using hef_le_fsep
    have hSep_quot : Algebra.IsSeparable (A ⧸ 𝔪) (↥C ⧸ Q') := hSep_of_le hf_le_fsep

    letI : Algebra (Localization.AtPrime 𝔪) (Localization.AtPrime Q') :=
      (Localization.localRingHom 𝔪 Q' (algebraMap A ↥C) hQ'_lies.over).toAlgebra
    haveI : IsScalarTower A (Localization.AtPrime 𝔪) (Localization.AtPrime Q') :=
      IsScalarTower.of_algebraMap_eq fun x =>
        (Localization.localRingHom_to_map 𝔪 Q' (algebraMap A ↥C) hQ'_lies.over x).symm
    have hSep_res : Algebra.IsSeparable 𝔪.ResidueField Q'.ResidueField :=
      (Algebra.isSeparable_residueField_iff (p := 𝔪) (q := Q')).mpr hSep_quot
    have hram'_eq_one : 𝔪.ramificationIdx' Q' = 1 := by
      rw [Ideal.ramificationIdx'_eq_ramificationIdx 𝔪 Q' h𝔪_ne]
      exact he1
    have hmap_le : Ideal.map (algebraMap A ↥C) 𝔪 ≤ Q' :=
      Ideal.map_le_iff_le_comap.mpr hQ'_lies.over.le
    have hMax_eq : Ideal.map (algebraMap A (Localization.AtPrime Q')) 𝔪 =
        IsLocalRing.maximalIdeal (Localization.AtPrime Q') :=
      (Ideal.IsDedekindDomain.ramificationIdx'_eq_one_iff hQ'_ne hmap_le).mp hram'_eq_one
    exact (Algebra.isUnramifiedAt_iff_map_eq A 𝔪 Q').mpr ⟨hSep_res, hMax_eq⟩

  have hUnram_A₀ : Algebra.IsUnramifiedAt A₀ (A := ↥C₀) Q₀ :=
    @hDedGalois A₀ _ _ hDed_A₀ K₂ L₂ _ _ algAK hFrac_AK _ algAL _ _ _
      𝔪₀ h𝔪₀_max h𝔪₀_ne Q₀ hQ₀_max hQ₀_liesOver hQ₀_ne hTrivInert_C₀

  
  haveI : Algebra.FormallyUnramified R₂ A₀ := Algebra.FormallyUnramified.of_isLocalization S₀
  haveI : Algebra.FormallyUnramified A₀ (Localization.AtPrime Q₀) := hUnram_A₀
  haveI : Algebra.FormallyUnramified R₂ (Localization.AtPrime Q₀) :=
    Algebra.FormallyUnramified.comp R₂ A₀ (Localization.AtPrime Q₀)

  have hinj_CQ : Function.Injective (algebraMap ↥C₀ (Localization.AtPrime Q₀)) :=
    IsLocalization.injective (Localization.AtPrime Q₀) Q₀.primeCompl_le_nonZeroDivisors
  have hinj_BCQ : Function.Injective (algebraMap ↥B₂ (Localization.AtPrime Q₀)) :=
    hinj_CQ.comp hinj_BC

  haveI hLoc_Q_CQ : IsLocalization Q.primeCompl (Localization.AtPrime Q₀) :=
    { map_units := fun y => by
        have hy_not_Q₀ : algebraMap ↥B₂ ↥C₀ y.1 ∉ Q₀ := by
          intro hmem
          have hy_Q : y.1 ∈ Ideal.comap (algebraMap ↥B₂ ↥C₀) Q₀ := hmem
          rw [hQ₀_under_B] at hy_Q
          exact y.2 hy_Q
        exact IsLocalization.map_units (Localization.AtPrime Q₀)
          (⟨algebraMap ↥B₂ ↥C₀ y.1, hy_not_Q₀⟩ : Q₀.primeCompl)
      surj := fun w => by
        obtain ⟨⟨z₁, z₂⟩, hw⟩ := IsLocalization.surj Q₀.primeCompl w
        obtain ⟨⟨b₁, m₁⟩, hz₁⟩ := IsLocalization.surj M_B z₁
        obtain ⟨⟨b₂, m₂⟩, hz₂⟩ := IsLocalization.surj M_B z₂.1
        have hm₁_not_Q : m₁.1 ∉ Q :=
          Set.disjoint_left.mp hDisj_MB_Q m₁.2
        have hm₂_unit : IsUnit (algebraMap ↥B₂ ↥C₀ m₂.1) :=
          IsLocalization.map_units ↥C₀ m₂
        have hm₂_not_Q₀ : algebraMap ↥B₂ ↥C₀ m₂.1 ∉ Q₀ := fun hmem =>
          hQ₀_prime.ne_top (Ideal.eq_top_of_isUnit_mem Q₀ hmem hm₂_unit)
        have hb₂_not_Q : b₂ ∉ Q := by
          intro hb₂_Q
          have hb₂_Q₀ : algebraMap ↥B₂ ↥C₀ b₂ ∈ Q₀ := Ideal.mem_map_of_mem _ hb₂_Q
          rw [← hz₂] at hb₂_Q₀
          rcases hQ₀_prime.mem_or_mem hb₂_Q₀ with hz₂_Q₀ | hm₂_Q₀
          · exact z₂.2 hz₂_Q₀
          · exact hm₂_not_Q₀ hm₂_Q₀
        refine ⟨⟨b₁ * m₂.1, ⟨m₁.1 * b₂, Submonoid.mul_mem _ hm₁_not_Q hb₂_not_Q⟩⟩, ?_⟩
        change w * algebraMap ↥C₀ (Localization.AtPrime Q₀)
            (algebraMap ↥B₂ ↥C₀ (m₁.1 * b₂)) =
          algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ (b₁ * m₂.1))
        have hstep1 : algebraMap ↥B₂ ↥C₀ (m₁.1 * b₂) =
            algebraMap ↥B₂ ↥C₀ m₁.1 * (z₂.1 * algebraMap ↥B₂ ↥C₀ m₂.1) := by
          rw [map_mul, ← hz₂]
        have hstep2 : algebraMap ↥B₂ ↥C₀ (b₁ * m₂.1) =
            (z₁ * algebraMap ↥B₂ ↥C₀ m₁.1) * algebraMap ↥B₂ ↥C₀ m₂.1 := by
          rw [map_mul, ← hz₁]
        rw [hstep1, hstep2]
        simp only [map_mul]
        calc w * (algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₁.1) *
              (algebraMap ↥C₀ (Localization.AtPrime Q₀) z₂.1 *
                algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₂.1)))
            = (w * algebraMap ↥C₀ (Localization.AtPrime Q₀) z₂.1) *
                (algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₁.1) *
                  algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₂.1)) := by
              ring
          _ = algebraMap ↥C₀ (Localization.AtPrime Q₀) z₁ *
                (algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₁.1) *
                  algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₂.1)) := by
              rw [hw]
          _ = algebraMap ↥C₀ (Localization.AtPrime Q₀) z₁ *
                algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₁.1) *
                  algebraMap ↥C₀ (Localization.AtPrime Q₀) (algebraMap ↥B₂ ↥C₀ m₂.1) := by
              ring
      exists_of_eq := fun {x₁ x₂} hx => ⟨1, by simp [hinj_BCQ hx]⟩ }

  let e_BQ : Localization.AtPrime Q₀ ≃ₐ[↥B₂] Localization.AtPrime Q :=
    IsLocalization.algEquiv Q.primeCompl (Localization.AtPrime Q₀) (Localization.AtPrime Q)
  exact Algebra.FormallyUnramified.of_surjective
    (e_BQ.toAlgHom.restrictScalars R₂) e_BQ.surjective

theorem weil_dvr_slice_2d_codim1_inertia_lift_and_unramified (k : Type u) [Field k] [IsAlgClosed k]
    (K₂ L₂ : Type u) [Field K₂] [Field L₂]
    [Algebra (MvPolynomial (Fin 2) k) K₂]
    [IsFractionRing (MvPolynomial (Fin 2) k) K₂]
    [Algebra K₂ L₂] [Algebra (MvPolynomial (Fin 2) k) L₂]
    [IsScalarTower (MvPolynomial (Fin 2) k) K₂ L₂]
    [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
    (H : MvPolynomial (Fin 2) k) (hH_irr : Irreducible H)
    (Q : Ideal ↥(integralClosure (MvPolynomial (Fin 2) k) L₂)) [Q.IsPrime]
    (hQ_comap : Ideal.comap
      (algebraMap (MvPolynomial (Fin 2) k) ↥(integralClosure (MvPolynomial (Fin 2) k) L₂)) Q =
      Ideal.span {H}) :
    let R₂ := MvPolynomial (Fin 2) k
    let B₂ := integralClosure R₂ L₂
    (∃ (κ₁ : Type u) (_ : Field κ₁) (_ : IsAlgClosed κ₁) (_ : Algebra k κ₁)
       (ι_slice : R₂ →+* Polynomial κ₁),
      Function.Injective ι_slice ∧
      ι_slice.comp MvPolynomial.C = Polynomial.C.comp (algebraMap k κ₁) ∧
      Ideal.comap ι_slice (Ideal.span {Polynomial.X}) = Ideal.span {H} ∧
      (Polynomial.derivative (ι_slice H)).eval 0 ≠ 0 ∧
      ∀ (V_0 : ValuationSubring (AlgebraicClosure (FractionRing (Polynomial κ₁))))
        (p_V : Polynomial κ₁ →+* ↥V_0)
        (π_V0 : ↥V_0 →+* κ₁),
        V_0.subtype.comp p_V =
          algebraMap (Polynomial κ₁) (AlgebraicClosure (FractionRing (Polynomial κ₁))) →
        π_V0.comp p_V = Polynomial.evalRingHom 0 →
        RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 →
        ∃ (ψ_Ω : K₂ →+* AlgebraicClosure (FractionRing (Polynomial κ₁)))
          (i_L : L₂ →+* AlgebraicClosure (FractionRing (Polynomial κ₁))),
          ψ_Ω.comp (algebraMap R₂ K₂) =
            (algebraMap (Polynomial κ₁)
              (AlgebraicClosure (FractionRing (Polynomial κ₁)))).comp ι_slice ∧
          i_L.comp (algebraMap K₂ L₂) = ψ_Ω ∧
          ∀ (σ : L₂ ≃ₐ[K₂] L₂),
            (∀ y : ↥B₂, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q : Set ↥B₂)) →
            ∃ (γ : AlgebraicClosure (FractionRing (Polynomial κ₁)) ≃+*
                AlgebraicClosure (FractionRing (Polynomial κ₁))),
              (∀ f : Polynomial κ₁,
                γ (algebraMap (Polynomial κ₁) _ f) = algebraMap (Polynomial κ₁) _ f) ∧
              (∀ x : K₂, γ (ψ_Ω x) = ψ_Ω x) ∧
              (∀ z : AlgebraicClosure (FractionRing (Polynomial κ₁)),
                z ∈ V_0 ↔ γ z ∈ V_0) ∧
              (∀ z : L₂, γ (i_L z) = i_L (σ z))) ∧
    ((∀ σ : L₂ ≃ₐ[K₂] L₂,
        (∀ y : ↥B₂, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q : Set ↥B₂)) →
        σ = 1) →
      Algebra.IsUnramifiedAt R₂ Q) :=
by
  let R₂ := MvPolynomial (Fin 2) k
  refine ⟨?_, weil_dvr_slice_trivial_inertia_implies_isUnramifiedAt k K₂ L₂ H hH_irr Q hQ_comap⟩
  have hConjA_pd0 :
      ∀ (K₂' L₂' : Type u) [Field K₂'] [Field L₂']
        [Algebra R₂ K₂'] [IsFractionRing R₂ K₂']
        [Algebra K₂' L₂'] [Algebra R₂ L₂'] [IsScalarTower R₂ K₂' L₂']
        [FiniteDimensional K₂' L₂'] [IsGalois K₂' L₂']
        (H' : R₂), Irreducible H' →
        ∀ (Q' : Ideal ↥(integralClosure R₂ L₂')) [Q'.IsPrime],
          Ideal.comap (algebraMap R₂ ↥(integralClosure R₂ L₂')) Q' = Ideal.span {H'} →
          MvPolynomial.pderiv 0 H' ≠ 0 →
          let B₂' := integralClosure R₂ L₂'
          ∃ (κ₁ : Type u) (_ : Field κ₁) (_ : IsAlgClosed κ₁) (_ : Algebra k κ₁)
            (ι_slice : R₂ →+* Polynomial κ₁),
            Function.Injective ι_slice ∧
            ι_slice.comp MvPolynomial.C = Polynomial.C.comp (algebraMap k κ₁) ∧
            Ideal.comap ι_slice (Ideal.span {Polynomial.X}) = Ideal.span {H'} ∧
            (Polynomial.derivative (ι_slice H')).eval 0 ≠ 0 ∧
            ∀ (V_0 : ValuationSubring (AlgebraicClosure (FractionRing (Polynomial κ₁))))
              (p_V : Polynomial κ₁ →+* ↥V_0)
              (π_V0 : ↥V_0 →+* κ₁),
              V_0.subtype.comp p_V =
                algebraMap (Polynomial κ₁) (AlgebraicClosure (FractionRing (Polynomial κ₁))) →
              π_V0.comp p_V = Polynomial.evalRingHom 0 →
              RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 →
              ∃ (ψ_Ω : K₂' →+* AlgebraicClosure (FractionRing (Polynomial κ₁)))
                (i_L : L₂' →+* AlgebraicClosure (FractionRing (Polynomial κ₁))),
                ψ_Ω.comp (algebraMap R₂ K₂') =
                  (algebraMap (Polynomial κ₁)
                    (AlgebraicClosure (FractionRing (Polynomial κ₁)))).comp ι_slice ∧
                i_L.comp (algebraMap K₂' L₂') = ψ_Ω ∧
                ∀ (σ : L₂' ≃ₐ[K₂'] L₂'),
                  (∀ y : ↥B₂', σ (y : L₂') - (y : L₂') ∈ Subtype.val '' (Q' : Set ↥B₂')) →
                  ∃ (γ : AlgebraicClosure (FractionRing (Polynomial κ₁)) ≃+*
                      AlgebraicClosure (FractionRing (Polynomial κ₁))),
                    (∀ f : Polynomial κ₁,
                      γ (algebraMap (Polynomial κ₁) _ f) = algebraMap (Polynomial κ₁) _ f) ∧
                    (∀ x : K₂', γ (ψ_Ω x) = ψ_Ω x) ∧
                    (∀ z : AlgebraicClosure (FractionRing (Polynomial κ₁)),
                      z ∈ V_0 ↔ γ z ∈ V_0) ∧
                    (∀ z : L₂', γ (i_L z) = i_L (σ z)) := by
    intro K₂' L₂' _ _ _ _ _ _ _ _ _ H' hH'_irr Q' _ hQ'_comap h_pd0
    let F₁ := FractionRing (Polynomial k)
    let κ₁ := AlgebraicClosure F₁
    let P_κ₁ := Polynomial κ₁
    let Ω₁ := AlgebraicClosure (FractionRing P_κ₁)
    let φ_k_κ₁ : k →+* κ₁ :=
      (algebraMap F₁ κ₁).comp ((algebraMap (Polynomial k) F₁).comp Polynomial.C)
    let x₁ : κ₁ := algebraMap F₁ κ₁ (algebraMap (Polynomial k) F₁ Polynomial.X)
    obtain ⟨α₀, hι_inj, hι_C, hι_comap, hι_deriv, hX1_not_mem⟩ :=
      (weil_dvr_slice_2d_separable_pderiv_and_transverse_slice k H' hH'_irr).2 h_pd0
    let ι'_slice : R₂ →+* P_κ₁ :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp φ_k_κ₁)
        ![Polynomial.X + Polynomial.C α₀, Polynomial.C x₁]
    let alg_k_κ₁ : Algebra k κ₁ := φ_k_κ₁.toAlgebra
    refine ⟨κ₁, inferInstance, inferInstance, alg_k_κ₁, ι'_slice,
      hι_inj, hι_C, hι_comap, hι_deriv, ?_⟩
    intro V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker
    obtain ⟨ψ_Ω, i_L, M, hψ_comp, hi_K₂, hAlg_M, hP_M, hK₂_M, hL₂_M, hDed_M, hMax_M, hLift_M⟩ :=
      weil_dvr_slice_compositum_inertia_dvr_stabilization k K₂' L₂' H' hH'_irr Q' hQ'_comap
        hX1_not_mem (weil_dvr_slice_transcendental_const_field_galois_disjointness Ω₁)
        α₀ hι_inj hι_comap V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker
    refine ⟨ψ_Ω, i_L, hψ_comp, hi_K₂, fun σ hσ => ?_⟩
    obtain ⟨σ_M, hσ_P, hσ_K₂, hσ_L₂, hσ_V0⟩ := hLift_M σ hσ
    have _ : Algebra.IsAlgebraic ↥M Ω₁ := hAlg_M
    obtain ⟨γ, hγ_M, hγ_V0⟩ :=
      weil_dvr_slice_algClosure_valuation_aut_extension ↥M Ω₁ V_0 hDed_M hMax_M σ_M hσ_V0
    refine ⟨γ, fun f => ?_, fun x => ?_, hγ_V0, fun z => ?_⟩
    · exact (hγ_M ⟨algebraMap P_κ₁ Ω₁ f, hP_M f⟩).trans (hσ_P f (hP_M f))
    · exact (hγ_M ⟨ψ_Ω x, hK₂_M x⟩).trans (hσ_K₂ x (hK₂_M x))
    · exact (hγ_M ⟨i_L z, hL₂_M z⟩).trans (hσ_L₂ z (hL₂_M z))
  rcases (weil_dvr_slice_2d_separable_pderiv_and_transverse_slice k H hH_irr).1 with h_pd0 | h_pd1
  · exact hConjA_pd0 K₂ L₂ H hH_irr Q hQ_comap h_pd0
  · let sw : Fin 2 ≃ Fin 2 := Equiv.swap 0 1
    let e_sw : R₂ ≃ₐ[k] R₂ := MvPolynomial.renameEquiv k sw
    let H' : R₂ := e_sw H
    have hH'_irr : Irreducible H' :=
      (MulEquiv.irreducible_iff e_sw.toRingEquiv.toMulEquiv).mpr hH_irr
    have hsw1 : sw 1 = 0 := Equiv.swap_apply_right 0 1
    have hH'_pd0 : MvPolynomial.pderiv 0 H' ≠ 0 := by
      have hpderiv_eq : MvPolynomial.pderiv 0 H' = e_sw (MvPolynomial.pderiv 1 H) := by
        dsimp [H', e_sw]
        rw [← hsw1, MvPolynomial.renameEquiv_apply, MvPolynomial.pderiv_rename sw.injective 1 H,
          ← MvPolynomial.renameEquiv_apply]
      rw [hpderiv_eq]
      intro h0
      exact h_pd1 (e_sw.injective (h0.trans (map_zero e_sw).symm))
    let B₂ := integralClosure (MvPolynomial (Fin 2) k) L₂
    let algK₀ : Algebra R₂ K₂ := inferInstance
    have hFrac₀ : @IsFractionRing R₂ _ K₂ _ algK₀ := inferInstance
    let algL₀ : Algebra R₂ L₂ := inferInstance
    let ι₀_K : R₂ →+* K₂ := algebraMap R₂ K₂
    let ι₀_L : R₂ →+* L₂ := algebraMap R₂ L₂
    let ι₀_B : R₂ →+* ↥B₂ := algebraMap R₂ ↥B₂
    have hST₀ : ∀ r : R₂, algebraMap K₂ L₂ (ι₀_K r) = ι₀_L r :=
      fun r => (IsScalarTower.algebraMap_apply R₂ K₂ L₂ r).symm
    let φ_K' : R₂ →+* K₂ := ι₀_K.comp e_sw.symm.toRingHom
    have hφ_K'_apply : ∀ x : R₂, φ_K' x = ι₀_K (e_sw.symm x) := fun _ => rfl
    let algK' : Algebra R₂ K₂ := φ_K'.toAlgebra
    have hFrac' : @IsFractionRing R₂ _ K₂ _ algK' := by
      let _ : Algebra R₂ K₂ := algK'
      refine
        { map_units := fun y => by
            have hy_ne : (y : R₂) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
            have hsw_ne : e_sw.symm (y : R₂) ≠ 0 :=
              fun h0 => hy_ne (e_sw.symm.injective (h0.trans (map_zero e_sw.symm).symm))
            have hsw_nzd : e_sw.symm (y : R₂) ∈ nonZeroDivisors R₂ :=
              mem_nonZeroDivisors_iff_ne_zero.mpr hsw_ne
            exact @IsLocalization.map_units R₂ _ (nonZeroDivisors R₂) K₂ _ algK₀ hFrac₀
              ⟨e_sw.symm (y : R₂), hsw_nzd⟩
          surj := fun z => by
            obtain ⟨⟨r, s⟩, hrs⟩ :=
              @IsLocalization.surj R₂ _ (nonZeroDivisors R₂) K₂ _ algK₀ hFrac₀ z
            have hs_ne : (s : R₂) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
            have hsw_s_ne : e_sw (s : R₂) ≠ 0 :=
              fun h0 => hs_ne (e_sw.injective (h0.trans (map_zero e_sw).symm))
            refine ⟨⟨e_sw r, ⟨e_sw (s : R₂), mem_nonZeroDivisors_iff_ne_zero.mpr hsw_s_ne⟩⟩, ?_⟩
            change z * φ_K' (e_sw (s : R₂)) = φ_K' (e_sw r)
            rw [hφ_K'_apply, hφ_K'_apply, e_sw.symm_apply_apply, e_sw.symm_apply_apply]
            exact hrs
          exists_of_eq := fun {r₁ r₂} h_eq => by
            change φ_K' r₁ = φ_K' r₂ at h_eq
            rw [hφ_K'_apply, hφ_K'_apply] at h_eq
            have h1 := (@IsFractionRing.injective R₂ _ K₂ _ algK₀ hFrac₀) h_eq
            have h2 := e_sw.symm.injective h1
            exact ⟨1, by rw [OneMemClass.coe_one, one_mul, one_mul, h2]⟩ }
    let algL' : Algebra R₂ L₂ := ((algebraMap K₂ L₂).comp φ_K').toAlgebra
    have hST' : @IsScalarTower R₂ K₂ L₂ algK'.toSMul _ algL'.toSMul :=
      @IsScalarTower.of_algebraMap_eq' R₂ K₂ L₂ _ _ _ algK' _ algL' rfl
    let B₂' := @integralClosure R₂ L₂ _ _ algL'
    have halg_comp : (@algebraMap R₂ L₂ _ _ algL').comp e_sw.toRingEquiv.toRingHom =
        @algebraMap R₂ L₂ _ _ algL₀ := by
      apply RingHom.ext
      intro r
      change algebraMap K₂ L₂ (φ_K' (e_sw r)) = ι₀_L r
      rw [hφ_K'_apply, e_sw.symm_apply_apply, hST₀]
    have hInt_iff : ∀ z : L₂, z ∈ B₂ ↔ z ∈ B₂' := by
      intro z
      change @IsIntegral R₂ L₂ _ _ algL₀ z ↔ @IsIntegral R₂ L₂ _ _ algL' z
      exact @RingEquiv.isIntegral_iff R₂ L₂ R₂ _ _ _ algL₀ algL' e_sw.toRingEquiv halg_comp z
    let e_B : ↥B₂' ≃+* ↥B₂ :=
      { toFun := fun y => ⟨y.1, (hInt_iff y.1).mpr y.2⟩
        invFun := fun y => ⟨y.1, (hInt_iff y.1).mp y.2⟩
        left_inv := fun y => Subtype.ext rfl
        right_inv := fun y => Subtype.ext rfl
        map_mul' := fun _ _ => Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl }
    let Q' : Ideal ↥B₂' := Ideal.comap e_B.toRingHom Q
    have hQ'_prime : Q'.IsPrime := Ideal.IsPrime.comap e_B.toRingHom
    have hQ'_comap :
        Ideal.comap (@algebraMap R₂ ↥B₂' _ _ (@Subalgebra.algebra R₂ L₂ _ _ algL' B₂')) Q' =
          Ideal.span {H'} := by
      ext r
      have hmem_Q' :
          r ∈ Ideal.comap (@algebraMap R₂ ↥B₂' _ _ (@Subalgebra.algebra R₂ L₂ _ _ algL' B₂')) Q' ↔
            e_sw.symm r ∈ Ideal.comap ι₀_B Q := by
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_comap]
        have heq_B : e_B (@algebraMap R₂ ↥B₂' _ _ (@Subalgebra.algebra R₂ L₂ _ _ algL' B₂') r) =
            ι₀_B (e_sw.symm r) := by
          apply Subtype.ext
          change algebraMap K₂ L₂ (φ_K' r) = ι₀_L (e_sw.symm r)
          rw [hφ_K'_apply, hST₀]
        change e_B (@algebraMap R₂ ↥B₂' _ _ (@Subalgebra.algebra R₂ L₂ _ _ algL' B₂') r) ∈ Q ↔
          ι₀_B (e_sw.symm r) ∈ Q
        rw [heq_B]
      rw [hmem_Q', hQ_comap, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
      constructor
      · rintro ⟨q, hq⟩
        refine ⟨e_sw q, ?_⟩
        have h1 := congrArg e_sw hq
        rw [e_sw.apply_symm_apply, map_mul] at h1
        exact h1
      · rintro ⟨q, hq⟩
        refine ⟨e_sw.symm q, ?_⟩
        have h1 := congrArg e_sw.symm hq
        rw [map_mul, e_sw.symm_apply_apply] at h1
        exact h1
    obtain ⟨κ₁, hFld_κ₁, hAC_κ₁, hAlg_κ₁, ι'_slice, hι'_inj, hι'_C, hι'_comap, hι'_deriv,
      hLift'⟩ :=
      @hConjA_pd0 K₂ L₂ _ _ algK' hFrac' _ algL' hST' _ _ H' hH'_irr Q' hQ'_prime hQ'_comap hH'_pd0
    let _ : Field κ₁ := hFld_κ₁
    let _ : IsAlgClosed κ₁ := hAC_κ₁
    let _ : Algebra k κ₁ := hAlg_κ₁
    let ι_slice : R₂ →+* Polynomial κ₁ := ι'_slice.comp e_sw.toRingHom
    refine ⟨κ₁, hFld_κ₁, hAC_κ₁, hAlg_κ₁, ι_slice, hι'_inj.comp e_sw.injective, ?_, ?_, ?_, ?_⟩
    · apply RingHom.ext
      intro a
      change ι'_slice (e_sw (MvPolynomial.C a)) = (Polynomial.C.comp (algebraMap k κ₁)) a
      have heC : e_sw (MvPolynomial.C a) = MvPolynomial.C a := by
        dsimp [e_sw]
        rw [MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
      rw [heC, ← RingHom.comp_apply ι'_slice MvPolynomial.C, hι'_C]
    · ext r
      have hmem : r ∈ Ideal.comap ι_slice (Ideal.span {Polynomial.X}) ↔
          e_sw r ∈ Ideal.comap ι'_slice (Ideal.span {Polynomial.X}) := Iff.rfl
      rw [hmem, hι'_comap, Ideal.mem_span_singleton, Ideal.mem_span_singleton]
      constructor
      · rintro ⟨q, hq⟩
        refine ⟨e_sw.symm q, ?_⟩
        have h1 := congrArg e_sw.symm hq
        rw [e_sw.symm_apply_apply, map_mul, e_sw.symm_apply_apply] at h1
        exact h1
      · rintro ⟨q, hq⟩
        refine ⟨e_sw q, ?_⟩
        have h1 := congrArg e_sw hq
        rw [map_mul] at h1
        exact h1
    · change (Polynomial.derivative (ι'_slice H')).eval 0 ≠ 0
      exact hι'_deriv
    · intro V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker
      obtain ⟨ψ_Ω, i_L, hψ'_comp, hi_K₂, hEx'⟩ :=
        hLift' V_0 p_V π_V0 hpV_sub hπ_pV hπ_ker
      refine ⟨ψ_Ω, i_L, ?_, hi_K₂, fun σ hσ => ?_⟩
      · apply RingHom.ext
        intro r
        have h1 := RingHom.congr_fun hψ'_comp (e_sw r)
        change ψ_Ω (φ_K' (e_sw r)) =
          algebraMap (Polynomial κ₁) _ (ι'_slice (e_sw r)) at h1
        rw [hφ_K'_apply, e_sw.symm_apply_apply] at h1
        exact h1
      · apply hEx' σ
        intro y'
        obtain ⟨q, hq_mem, hq_eq⟩ := hσ (e_B y')
        exact ⟨e_B.symm q, hq_mem, hq_eq⟩

theorem weil_net_p2_dvr_slice_smooth_and_odp_inertia (k : Type u) [Field k] [IsAlgClosed k]
    (m ℓ r' : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (Y₂_k : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper Y₂_k.hom]
    (g₂_k : Y₂_k ⟶ weilProjectiveSpaceOver k 2)
    [AlgebraicGeometry.IsProper g₂_k.left]
    (U₂_sm_k : (weilProjectiveSpaceOver k 2).left.Opens)
    [AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (g₂_k.left ∣_ U₂_sm_k)] :
    let K₂ := FractionRing (MvPolynomial (Fin 2) k)
    let x₁ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 0)
    let x₂ : K₂ := algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X 1)
    let homCoord : Fin 3 → K₂ := ![1, x₁, x₂]
    let eval_c : Fin 3 → MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
      fun c => MvPolynomial.aeval (Fin.succAboveCases c 1 MvPolynomial.X)
    let φ_K₂ : Fin 3 → MvPolynomial (Fin 2) k →ₐ[k] K₂ :=
      fun c => MvPolynomial.aeval (fun j : Fin 2 => homCoord (c.succAbove j) / homCoord c)
    (∀ (κ : Type u) [Field κ] [IsAlgClosed κ] [Algebra k κ],
      let P_κ := Polynomial κ
      let Ω_κ := AlgebraicClosure (FractionRing P_κ)
      ∃ (V_0 : ValuationSubring Ω_κ)
        (p_V : P_κ →+* ↥V_0)
        (π_V0 : ↥V_0 →+* κ),
        V_0.subtype.comp p_V = algebraMap P_κ Ω_κ ∧
        π_V0.comp p_V = Polynomial.evalRingHom 0 ∧
        RingHom.ker π_V0 = IsLocalRing.maximalIdeal ↥V_0 ∧
        (∀ {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B),
          φ.Etale →
          ∀ (α_V : A →+* ↥V_0) (s_0 : B →+* κ),
            s_0.comp φ = π_V0.comp α_V →
            ∃! β_V : B →+* ↥V_0, β_V.comp φ = α_V ∧ π_V0.comp β_V = s_0) ∧
        ∀ (g_line : AlgebraicGeometry.Spec (CommRingCat.of P_κ) ⟶
            (weilProjectiveSpaceOver k 2).left),
          g_line ≫ (weilProjectiveSpaceOver k 2).hom =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Polynomial.C.comp (algebraMap k κ))) →
          (∃ Δ₀ : P_κ, Δ₀.eval 0 ≠ 0 ∧
            ∀ p : AlgebraicGeometry.Spec (CommRingCat.of P_κ),
              Δ₀ ∉ p.asIdeal → g_line.base p ∈ U₂_sm_k) →
          ∀ (τ : κ ≃ₐ[k] κ),
            AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (Polynomial.mapRingHom τ.toRingHom)) ≫ g_line = g_line →
            ∃ (γ : Ω_κ ≃+* Ω_κ) (γ_V : ↥V_0 →+* ↥V_0),
              V_0.subtype.comp γ_V = γ.toRingHom.comp V_0.subtype ∧
              π_V0.comp γ_V = τ.toRingHom.comp π_V0 ∧
              (∀ f : P_κ,
                γ (algebraMap P_κ Ω_κ f) =
                  algebraMap P_κ Ω_κ (Polynomial.map τ.toRingHom f)) ∧
              let η_Ω_κ :=
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap P_κ Ω_κ)) ≫ g_line
              let Y_Ω_κ := CategoryTheory.Limits.pullback g₂_k.left η_Ω_κ
              let q_κ :=
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom 0)) ≫ g_line
              let Y_0_κ := CategoryTheory.Limits.pullback g₂_k.left q_κ
              (∃ (α_γ : Y_Ω_κ ⟶ Y_Ω_κ)
                  (p_γ : weilEtaleTorsionH Y_Ω_κ (ℓ ^ (r' + 1)) (2 * m + 1) →+
                    weilEtaleTorsionH Y_Ω_κ (ℓ ^ (r' + 1)) (2 * m + 1)),
                α_γ ≫ CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_κ =
                  CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω_κ ∧
                α_γ ≫ CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_κ =
                  CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω_κ ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ∧
                WeilIsTorsionEtalePullback α_γ (ℓ ^ (r' + 1)) (2 * m + 1) p_γ ∧
                ∀ v : weilEtaleTorsionH Y_Ω_κ (ℓ ^ (r' + 1)) (2 * m + 1), p_γ v = v) →
              ∀ (α_τ : Y_0_κ ⟶ Y_0_κ),
                α_τ ≫ CategoryTheory.Limits.pullback.fst g₂_k.left q_κ =
                  CategoryTheory.Limits.pullback.fst g₂_k.left q_κ →
                α_τ ≫ CategoryTheory.Limits.pullback.snd g₂_k.left q_κ =
                  CategoryTheory.Limits.pullback.snd g₂_k.left q_κ ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) →
                ∀ (p_τ : weilEtaleTorsionH Y_0_κ (ℓ ^ (r' + 1)) (2 * m + 1) →+
                    weilEtaleTorsionH Y_0_κ (ℓ ^ (r' + 1)) (2 * m + 1)),
                  WeilIsTorsionEtalePullback α_τ (ℓ ^ (r' + 1)) (2 * m + 1) p_τ →
                  ∀ v : weilEtaleTorsionH Y_0_κ (ℓ ^ (r' + 1)) (2 * m + 1), p_τ v = v) ∧
    (∀ (F_disc_hom : MvPolynomial (Fin 3) k),
      Irreducible (eval_c 0 F_disc_hom) →
      ∀ (j_chart : Fin 3 →
          (AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) ⟶
            (weilProjectiveSpaceOver k 2).left)),
        (∀ c : Fin 3,
          AlgebraicGeometry.IsOpenImmersion (j_chart c) ∧
          j_chart c ≫ (weilProjectiveSpaceOver k 2).hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) ∧
          (j_chart c).base ⁻¹' (U₂_sm_k : Set (weilProjectiveSpaceOver k 2).left) =
            { p : AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 2) k)) |
              eval_c c F_disc_hom ∉ p.asIdeal } ∧
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K₂ c).toRingHom) ≫ j_chart c =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_K₂ 0).toRingHom) ≫ j_chart 0) →
        (∀ (κ₁ : Type u) [Field κ₁] [IsAlgClosed κ₁] [Algebra k κ₁]
            (ι_slice : MvPolynomial (Fin 2) k →+* Polynomial κ₁),
          ι_slice.comp MvPolynomial.C = Polynomial.C.comp (algebraMap k κ₁) →
          Ideal.comap ι_slice (Ideal.span {Polynomial.X}) = Ideal.span {eval_c 0 F_disc_hom} →
          (Polynomial.derivative (ι_slice (eval_c 0 F_disc_hom))).eval 0 ≠ 0 →
          let g_line : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial κ₁)) ⟶
              (weilProjectiveSpaceOver k 2).left :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_slice) ≫ j_chart 0
          let B_line : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ₁)) :=
            CategoryTheory.Over.mk
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : κ₁ →+* Polynomial κ₁)))
          let Y_line : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of κ₁)) :=
            CategoryTheory.Over.mk
              (CategoryTheory.Limits.pullback.snd g₂_k.left g_line ≫ B_line.hom)
          let f_line : Y_line ⟶ B_line :=
            CategoryTheory.Over.homMk
              (CategoryTheory.Limits.pullback.snd g₂_k.left g_line) rfl
          let s_zero : AlgebraicGeometry.Spec (CommRingCat.of κ₁) ⟶ B_line.left :=
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.evalRingHom (0 : κ₁)))
          ∃ (δ_loc : Polynomial κ₁)
            (x_zero : AlgebraicGeometry.Spec (CommRingCat.of κ₁) ⟶ Y_line.left),
            δ_loc.eval 0 ≠ 0 ∧
            ι_slice (eval_c 0 F_disc_hom) = (Polynomial.X : Polynomial κ₁) * δ_loc ∧
            x_zero ≫ f_line.left = s_zero ∧
            (∀ z : Y_line.left,
              f_line.left.base z ∈ Set.range s_zero.base →
              z ∉ Set.range x_zero.base →
              ∃ V : Y_line.left.Opens, z ∈ V ∧
                AlgebraicGeometry.SmoothOfRelativeDimension (2 * m + 1) (V.ι ≫ f_line.left)) ∧
            ∀ pt : AlgebraicGeometry.Spec (CommRingCat.of κ₁),
              IsEtaleSplitOdpPointOver m f_line (x_zero.base pt) (s_zero.base pt)) →
        ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂],
          (let η_K₂ : AlgebraicGeometry.Spec (CommRingCat.of K₂) ⟶
              (weilProjectiveSpaceOver k 2).left :=
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap (MvPolynomial (Fin 2) k) K₂)) ≫ j_chart 0
          ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
            (ψ_Ω : K₂ →+* Ω)
            (i_L : L₂ →+* Ω),
            i_L.comp (algebraMap K₂ L₂) = ψ_Ω →
            let η_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
                (weilProjectiveSpaceOver k 2).left :=
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_Ω) ≫ η_K₂
            let Y_Ω := CategoryTheory.Limits.pullback g₂_k.left η_Ω
            ∀ (γ : Ω ≃+* Ω),
              (∀ x : K₂, γ (ψ_Ω x) = ψ_Ω x) →
              ∀ (α_γ : Y_Ω ⟶ Y_Ω),
                α_γ ≫ CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω =
                  CategoryTheory.Limits.pullback.fst g₂_k.left η_Ω →
                α_γ ≫ CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω =
                  CategoryTheory.Limits.pullback.snd g₂_k.left η_Ω ≫
                    AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) →
                ∀ (p_γ : weilEtaleTorsionH Y_Ω (ℓ ^ (r' + 1)) (2 * m + 1) →+
                    weilEtaleTorsionH Y_Ω (ℓ ^ (r' + 1)) (2 * m + 1)),
                  WeilIsTorsionEtalePullback α_γ (ℓ ^ (r' + 1)) (2 * m + 1) p_γ →
                  ((∀ z : L₂, γ (i_L z) = i_L z) ↔
                    (∀ v : weilEtaleTorsionH Y_Ω (ℓ ^ (r' + 1)) (2 * m + 1), p_γ v = v))) →
          (∀ (c : Fin 3) (H_D : MvPolynomial (Fin 2) k),
            Irreducible H_D →
            eval_c c F_disc_hom ∉ Ideal.span {H_D} →
            letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
              ((algebraMap K₂ L₂).comp (φ_K₂ c).toRingHom).toAlgebra
            let B₂_c := integralClosure (MvPolynomial (Fin 2) k) L₂
            ∀ (Q : Ideal ↥B₂_c) [Q.IsPrime],
              Ideal.comap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_c) Q = Ideal.span {H_D} →
              Algebra.IsUnramifiedAt (MvPolynomial (Fin 2) k) Q) ∧
          (letI : Algebra (MvPolynomial (Fin 2) k) L₂ :=
             ((algebraMap K₂ L₂).comp (φ_K₂ 0).toRingHom).toAlgebra
           let B₂_0 := integralClosure (MvPolynomial (Fin 2) k) L₂
           ∀ (Q_C : Ideal ↥B₂_0), Q_C.IsPrime →
             Ideal.comap (algebraMap (MvPolynomial (Fin 2) k) ↥B₂_0) Q_C =
               Ideal.span {eval_c 0 F_disc_hom} →
             ringChar k = 0 ∨
             Nat.Coprime (ringChar k)
               (Nat.card { σ : L₂ ≃ₐ[K₂] L₂ //
                 ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q_C : Set ↥B₂_0) }))) :=
by
  intro K₂ x₁ x₂ homCoord eval_c φ_K₂
  let R₂ := MvPolynomial (Fin 2) k
  let m₀ := ℓ ^ (r' + 1)
  obtain ⟨hPullEx, hPullId, hPullComp, -, -⟩ := weil_etale_torsion_pullback_functoriality.{u}

  have hPullTri : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : S₁ ⟶ S₂) (h₂ : S₂ ⟶ S₃) (h₁₂ : S₁ ⟶ S₃) (n_mod q : ℕ)
      (p₁ : weilEtaleTorsionH S₂ n_mod q →+ weilEtaleTorsionH S₁ n_mod q)
      (p₂ : weilEtaleTorsionH S₃ n_mod q →+ weilEtaleTorsionH S₂ n_mod q)
      (p₁₂ : weilEtaleTorsionH S₃ n_mod q →+ weilEtaleTorsionH S₁ n_mod q),
      h₁ ≫ h₂ = h₁₂ →
      WeilIsTorsionEtalePullback h₁ n_mod q p₁ →
      WeilIsTorsionEtalePullback h₂ n_mod q p₂ →
      WeilIsTorsionEtalePullback h₁₂ n_mod q p₁₂ →
      ∀ z : weilEtaleTorsionH S₃ n_mod q, p₁₂ z = p₁ (p₂ z) := by
    intro S₁ S₂ S₃ h₁ h₂ h₁₂ n_mod q p₁ p₂ p₁₂ h_eq hp₁ hp₂ hp₁₂ z
    subst h_eq
    exact DFunLike.congr_fun (hPullComp h₁ h₂ n_mod q p₁ p₂ p₁₂ hp₁ hp₂ hp₁₂) z

  have hPullIsoBij : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (e : S₁ ≅ S₂) (n_mod q : ℕ)
      (p_hom : weilEtaleTorsionH S₂ n_mod q →+ weilEtaleTorsionH S₁ n_mod q),
      WeilIsTorsionEtalePullback e.hom n_mod q p_hom →
      Function.Bijective p_hom := by
    intro S₁ S₂ e n_mod q p_hom hp_hom
    obtain ⟨p_inv, hp_inv⟩ := hPullEx e.inv n_mod q
    obtain ⟨p_id₁, hp_id₁⟩ := hPullEx (𝟙 S₁) n_mod q
    obtain ⟨p_id₂, hp_id₂⟩ := hPullEx (𝟙 S₂) n_mod q
    have hid₁ := hPullId n_mod q p_id₁ hp_id₁
    have hid₂ := hPullId n_mod q p_id₂ hp_id₂
    refine Function.bijective_iff_has_inverse.mpr ⟨p_inv, fun y => ?_, fun x => ?_⟩
    · have h := hPullTri e.inv e.hom (𝟙 S₂) n_mod q p_inv p_hom p_id₂
        e.inv_hom_id hp_inv hp_hom hp_id₂ y
      rw [hid₂, AddMonoidHom.id_apply] at h
      exact h.symm
    · have h := hPullTri e.hom e.inv (𝟙 S₁) n_mod q p_hom p_inv p_id₁
        e.hom_inv_id hp_hom hp_inv hp_id₁ x
      rw [hid₁, AddMonoidHom.id_apply] at h
      exact h.symm

  have hSmPull : ∀ {Y P2 S : AlgebraicGeometry.Scheme.{u}} (d_sm : ℕ)
      (g₂ : Y ⟶ P2) (U_sm : P2.Opens)
      [AlgebraicGeometry.SmoothOfRelativeDimension d_sm (g₂ ∣_ U_sm)]
      (u : S ⟶ P2),
      (∀ p : S, u.base p ∈ U_sm) →
      AlgebraicGeometry.SmoothOfRelativeDimension d_sm
        (CategoryTheory.Limits.pullback.snd g₂ u) := by
    intro Y P2 S d_sm g₂ U_sm _ u hu_mem
    have hrange : Set.range u.base ⊆ Set.range U_sm.ι.base := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨p, rfl⟩
      exact hu_mem p
    let u_sm : S ⟶ U_sm.toScheme := IsOpenImmersion.lift U_sm.ι u hrange
    have hu_fac : u_sm ≫ U_sm.ι = u := IsOpenImmersion.lift_fac U_sm.ι u hrange
    have hPb_res : CategoryTheory.IsPullback
        ((g₂ ⁻¹ᵁ U_sm).ι) (g₂ ∣_ U_sm) g₂ U_sm.ι :=
      (AlgebraicGeometry.isPullback_morphismRestrict g₂ U_sm).flip
    have hPb_tot : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst g₂ u)
        (CategoryTheory.Limits.pullback.snd g₂ u)
        g₂ (u_sm ≫ U_sm.ι) := by
      rw [hu_fac]
      exact CategoryTheory.IsPullback.of_hasPullback g₂ u
    let fst_sm : CategoryTheory.Limits.pullback g₂ u ⟶ ↑(g₂ ⁻¹ᵁ U_sm) :=
      hPb_res.lift (CategoryTheory.Limits.pullback.fst g₂ u)
        (CategoryTheory.Limits.pullback.snd g₂ u ≫ u_sm)
        (by rw [Category.assoc, hu_fac]; exact CategoryTheory.Limits.pullback.condition)
    have hPb_left : CategoryTheory.IsPullback
        fst_sm (CategoryTheory.Limits.pullback.snd g₂ u) (g₂ ∣_ U_sm) u_sm := by
      refine CategoryTheory.IsPullback.of_right ?_ (hPb_res.lift_snd _ _ _) hPb_res
      rw [hPb_res.lift_fst]
      exact hPb_tot
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_left inferInstance

  have hValPkg : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] [Algebra k κ],
      let P_κ := Polynomial κ
      let Ω_κ := AlgebraicClosure (FractionRing P_κ)
      (ℓ : κ) ≠ 0 ∧
      (ℓ : Ω_κ) ≠ 0 ∧
      WeilProperModPrimeBaseChangeHolds κ ℓ ∧
      ∃ (V_0 : ValuationSubring Ω_κ)
        (p_V : P_κ →+* ↥V_0)
        (π_V0 : ↥V_0 →+* κ)
        (_ : HenselianLocalRing ↥V_0),
        V_0.subtype.comp p_V = algebraMap P_κ Ω_κ ∧
        π_V0.comp p_V = Polynomial.evalRingHom 0 ∧
