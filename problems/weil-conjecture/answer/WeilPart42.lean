          obtain ⟨p_Qk, hp_Qk⟩ := hPullEx ι_Qk m₀ (2 * m + 2)
          have hBij_Qk : Function.Bijective p_Qk := hBij_Qk_all (2 * m + 2) p_Qk hp_Qk
          have hιQk_τQ : ι_Qk ≫ τ_Q.hom = ι_Qk := by
            apply CategoryTheory.Limits.pullback.hom_ext
            · rw [Category.assoc, hτQ_fst]
            · rw [Category.assoc, hτQ_snd, ← Category.assoc,
                CategoryTheory.Limits.pullback.lift_snd, Category.assoc, hi_cl_γV]
          apply hBij_Qk.1
          exact (hPullTri ι_Qk τ_Q.hom ι_Qk m₀ (2 * m + 2)
            p_Qk p_τQ p_Qk hιQk_τQ hp_Qk hp_τQ hp_Qk w).symm

