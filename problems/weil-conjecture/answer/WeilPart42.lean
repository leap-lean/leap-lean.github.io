      AlgebraicGeometry.Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField ↥E X f_E
    let δ : X.residueField q ⟶ CommRingCat.of ↥E :=
      (X.residueFieldCongr hq'_eq.symm).hom ≫ δ₀
    have hδ_fac : AlgebraicGeometry.Spec.map δ ≫ X.fromSpecResidueField q = f_E := by
      dsimp [δ]
      rw [AlgebraicGeometry.Spec.map_comp, Category.assoc,
        X.residueFieldCongr_fromSpecResidueField hq'_eq.symm]
      exact hδ₀_fac
    have hmono_eq : AlgebraicGeometry.Spec.map (δ ≫ CommRingCat.ofHom E.subtype) ≫
        X.fromSpecResidueField q =
        AlgebraicGeometry.Spec.map (𝟙 (X.residueField q)) ≫ X.fromSpecResidueField q := by
      rw [AlgebraicGeometry.Spec.map_comp, Category.assoc, hδ_fac]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom E.subtype) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_E) = _
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp_E, hSpec_ι,
        AlgebraicGeometry.Spec.map_id, Category.id_comp]
    have hid_eq : δ ≫ CommRingCat.ofHom E.subtype = 𝟙 (X.residueField q) :=
      hSpecMapInj ((cancel_mono (X.fromSpecResidueField q)).mp hmono_eq)
    rw [eq_top_iff]
    intro x _
    have hx : E.subtype (δ.hom x) = x :=
      RingHom.congr_fun (congrArg CommRingCat.Hom.hom hid_eq) x
    rw [← hx]
    exact (δ.hom x).2
  have hConeVsSmoothAlg : ∀ (κ : Type u) [Field κ] (m : ℕ)
      (S : Type u) [CommRing S] (ε_S : S →+* κ)
      (ψ_sm : MvPolynomial (Fin (2 * m + 1)) κ →+* S)
      (ψ_cone : (MvPolynomial (Fin (m + 1) × Fin 2) κ ⧸ Ideal.span
        {∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)}) →+* S),
      (ε_S.comp ψ_sm).comp MvPolynomial.C = RingHom.id κ →
      ψ_cone.comp ((Ideal.Quotient.mk _).comp MvPolynomial.C) = ψ_sm.comp MvPolynomial.C →
      ψ_sm.Etale →
      ψ_cone.Etale →
      (∀ idx : Fin (m + 1) × Fin 2,
        ε_S (ψ_cone (Ideal.Quotient.mk _ (MvPolynomial.X idx))) = 0) →
      False :=
    fun (κ : Type u) [Field κ] (m : ℕ) (S : Type u) [CommRing S] ε_S ψ_sm ψ_cone
        hε_sm h_compat hEt_sm hEt_cone hVtx => by
    let _ : CommRing κ := Field.toCommRing
    let _ : DivisionRing κ := Field.toDivisionRing
    let _ : Algebra κ S := (ψ_sm.comp MvPolynomial.C).toAlgebra
    have hε_alg : ∀ c : κ, ε_S (ψ_sm (MvPolynomial.C c)) = c := fun c =>
      RingHom.congr_fun hε_sm c
    let _ : Module S κ := Module.compHom κ ε_S
    have _ : IsScalarTower κ S κ :=
      ⟨fun c s x => by
        rw [Algebra.smul_def c s]
        change ε_S (ψ_sm (MvPolynomial.C c) * s) * x = c * (ε_S s * x)
        rw [map_mul, hε_alg, mul_assoc]⟩
    have hDerEtale : ∀ (A : Type u) [CommRing A] [Algebra κ A] [Module A κ]
        [IsScalarTower κ A κ] (φ : A →ₐ[κ] S),
        (∀ (a : A) (x : κ), a • x = ε_S (φ a) * x) →
        φ.toRingHom.Etale → Nonempty (Derivation κ S κ ≃ₗ[κ] Derivation κ A κ) := by
      intro A _ _ _ _ φ hsmulA hφ_et
      let _ : Algebra A S := φ.toRingHom.toAlgebra
      have _ : IsScalarTower κ A S := IsScalarTower.of_algebraMap_eq fun c => (φ.commutes c).symm
      have _ : Algebra.Etale A S := RingHom.etale_algebraMap.mp hφ_et
      have _ : IsScalarTower A S κ :=
        ⟨fun a s x => by
          rw [Algebra.smul_def a s, hsmulA]
          change ε_S (φ a * s) * x = ε_S (φ a) * (ε_S s * x)
          rw [map_mul, mul_assoc]⟩
      let e1 : Derivation κ S κ ≃ₗ[κ] (KaehlerDifferential κ S →ₗ[S] κ) :=
        (KaehlerDifferential.linearMapEquivDerivation κ S).symm.restrictScalars κ
      let e2 : (KaehlerDifferential κ S →ₗ[S] κ) ≃ₗ[κ]
          (TensorProduct A S (KaehlerDifferential κ A) →ₗ[S] κ) :=
        LinearEquiv.congrLeft κ κ (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale κ A S).symm
      let e3 : (TensorProduct A S (KaehlerDifferential κ A) →ₗ[S] κ) ≃ₗ[κ]
          (KaehlerDifferential κ A →ₗ[A] κ) :=
        (LinearMap.liftBaseChangeEquiv S).symm.restrictScalars κ
      let e4 : (KaehlerDifferential κ A →ₗ[A] κ) ≃ₗ[κ] Derivation κ A κ :=
        (KaehlerDifferential.linearMapEquivDerivation κ A).restrictScalars κ
      exact ⟨((e1.trans e2).trans e3).trans e4⟩
    let A_sm := MvPolynomial (Fin (2 * m + 1)) κ
    let φ_sm_alg : A_sm →ₐ[κ] S := { ψ_sm with commutes' := fun _ => rfl }
    let _ : Module A_sm κ := Module.compHom κ (ε_S.comp ψ_sm)
    have _ : IsScalarTower κ A_sm κ :=
      ⟨fun c p x => by
        rw [Algebra.smul_def c p]
        change ε_S (ψ_sm (algebraMap κ A_sm c * p)) * x = c * (ε_S (ψ_sm p) * x)
        rw [map_mul, map_mul, show ε_S (ψ_sm (algebraMap κ A_sm c)) = c from hε_alg c, mul_assoc]⟩
    obtain ⟨e_sm⟩ := hDerEtale A_sm φ_sm_alg (fun _ _ => rfl) hEt_sm
    let Q_quad : MvPolynomial (Fin (m + 1) × Fin 2) κ :=
      ∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)
    let I_cone : Ideal (MvPolynomial (Fin (m + 1) × Fin 2) κ) := Ideal.span {Q_quad}
    let A_cone := MvPolynomial (Fin (m + 1) × Fin 2) κ ⧸ I_cone
    let φ_cone_alg : A_cone →ₐ[κ] S :=
      { ψ_cone with commutes' := fun c => RingHom.congr_fun h_compat c }
    let ε_cone : A_cone →+* κ := ε_S.comp ψ_cone
    have hε_cone_alg : ∀ c : κ, ε_cone (algebraMap κ A_cone c) = c := fun c => by
      change ε_S (ψ_cone (Ideal.Quotient.mk I_cone (MvPolynomial.C c))) = c
      rw [show ψ_cone (Ideal.Quotient.mk I_cone (MvPolynomial.C c)) = ψ_sm (MvPolynomial.C c) from
        RingHom.congr_fun h_compat c]
      exact hε_alg c
    let _ : Module A_cone κ := Module.compHom κ ε_cone
    have _ : IsScalarTower κ A_cone κ :=
      ⟨fun c p x => by
        rw [Algebra.smul_def c p]
        change ε_cone (algebraMap κ A_cone c * p) * x = c * (ε_cone p * x)
        rw [map_mul, hε_cone_alg c, mul_assoc]⟩
    obtain ⟨e_cone⟩ := hDerEtale A_cone φ_cone_alg (fun _ _ => rfl) hEt_cone
    let e_poly_sm : Derivation κ A_sm κ ≃ₗ[κ] (Fin (2 * m + 1) → κ) :=
      { toFun := fun D i => D (MvPolynomial.X i)
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        invFun := fun v => MvPolynomial.mkDerivation κ v
        left_inv := fun D => by
          ext i
          exact MvPolynomial.mkDerivation_X κ _ i
        right_inv := fun v => by
          ext i
          exact MvPolynomial.mkDerivation_X κ v i }
    let ε_mv : MvPolynomial (Fin (m + 1) × Fin 2) κ →+* κ :=
      ε_cone.comp (Ideal.Quotient.mk I_cone)
    let _ : Module (MvPolynomial (Fin (m + 1) × Fin 2) κ) κ := Module.compHom κ ε_mv
    have _ : IsScalarTower κ (MvPolynomial (Fin (m + 1) × Fin 2) κ) κ :=
      ⟨fun c p x => by
        rw [Algebra.smul_def c p]
        change ε_mv (algebraMap κ _ c * p) * x = c * (ε_mv p * x)
        rw [map_mul, show ε_mv (algebraMap κ _ c) = c from hε_cone_alg c, mul_assoc]⟩
    have hε_X : ∀ idx : Fin (m + 1) × Fin 2, ε_mv (MvPolynomial.X idx) = 0 := hVtx
    have hε_Q : ε_mv Q_quad = 0 := by
      simp only [Q_quad, map_sum, map_mul, hε_X, zero_mul, Finset.sum_const_zero]
    let liftConeDerFun : (Fin (m + 1) × Fin 2 → κ) → Derivation κ A_cone κ := fun v =>
      let D₀ : Derivation κ (MvPolynomial (Fin (m + 1) × Fin 2) κ) κ :=
        MvPolynomial.mkDerivation κ v
      have hDQ : D₀ Q_quad = 0 := by
        simp only [Q_quad, map_sum, Derivation.leibniz]
        refine Finset.sum_eq_zero fun j _ => ?_
        change ε_mv (MvPolynomial.X (j, 0)) * D₀ (MvPolynomial.X (j, 1)) +
          ε_mv (MvPolynomial.X (j, 1)) * D₀ (MvPolynomial.X (j, 0)) = 0
        rw [hε_X, hε_X, zero_mul, zero_mul, add_zero]
      have hKer : I_cone.restrictScalars κ ≤ LinearMap.ker D₀.toLinearMap := by
        intro P hP
        change D₀ P = 0
        obtain ⟨R, rfl⟩ := Ideal.mem_span_singleton.mp hP
        rw [mul_comm, Derivation.leibniz]
        change ε_mv R * D₀ Q_quad + ε_mv Q_quad * D₀ R = 0
        rw [hDQ, hε_Q, mul_zero, zero_mul, add_zero]
      let L_cone : A_cone →ₗ[κ] κ := Submodule.liftQ (I_cone.restrictScalars κ) D₀.toLinearMap hKer
      { toLinearMap := L_cone
        map_one_eq_zero' := D₀.map_one_eq_zero
        leibniz' := fun x y => by
          refine Quotient.inductionOn₂' x y fun P₁ P₂ => ?_
          exact D₀.leibniz P₁ P₂ }
    let liftConeDer : (Fin (m + 1) × Fin 2 → κ) →ₗ[κ] (Fin (2 * m + 1) → κ) :=
      { toFun := fun v => e_poly_sm (e_sm (e_cone.symm (liftConeDerFun v)))
        map_add' := fun v₁ v₂ => by
          have hadd : liftConeDerFun (v₁ + v₂) = liftConeDerFun v₁ + liftConeDerFun v₂ := by
            have hD : MvPolynomial.mkDerivation κ (v₁ + v₂) =
                MvPolynomial.mkDerivation κ v₁ + MvPolynomial.mkDerivation κ v₂ := by
              ext idx
              simp [MvPolynomial.mkDerivation_X]
            apply Derivation.ext
            intro x
            refine Quotient.inductionOn' x fun P => ?_
            exact Derivation.congr_fun hD P
          rw [hadd, map_add, map_add, map_add]
        map_smul' := fun c v => by
          have hsmul : liftConeDerFun (c • v) = c • liftConeDerFun v := by
            have hD : MvPolynomial.mkDerivation κ (c • v) =
                c • MvPolynomial.mkDerivation κ v := by
              ext idx
              simp [MvPolynomial.mkDerivation_X]
            apply Derivation.ext
            intro x
            refine Quotient.inductionOn' x fun P => ?_
            exact Derivation.congr_fun hD P
          rw [hsmul, map_smul, map_smul, map_smul]
          rfl }
    have hInj : Function.Injective liftConeDer := by
      intro v₁ v₂ hv
      have hv' : liftConeDerFun v₁ = liftConeDerFun v₂ :=
        e_cone.symm.injective (e_sm.injective (e_poly_sm.injective hv))
      ext idx
      have hidx := Derivation.congr_fun hv' (Ideal.Quotient.mk I_cone (MvPolynomial.X idx))
      change (MvPolynomial.mkDerivation κ v₁) (MvPolynomial.X idx) =
        (MvPolynomial.mkDerivation κ v₂) (MvPolynomial.X idx) at hidx
      simpa only [MvPolynomial.mkDerivation_X] using hidx
    have hle := LinearMap.finrank_le_finrank_of_injective hInj
    rw [Module.finrank_pi, Module.finrank_pi, Fintype.card_fin, Fintype.card_prod,
      Fintype.card_fin, Fintype.card_fin] at hle
    omega
  have hConeAwayEquiv : ∀ (κ : Type u) [Field κ] (m : ℕ) (c₂ : κ)
      (idx₀ : Fin (m + 1) × Fin 2),
      let Q_c : MvPolynomial (Fin (m + 1) × Fin 2) κ :=
        (∑ j : Fin (m + 1), (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) κ) *
          MvPolynomial.X (j, 1)) - MvPolynomial.C c₂
      let A₂ := MvPolynomial (Fin (m + 1) × Fin 2) κ ⧸ Ideal.span {Q_c}
      let x₀ : A₂ := Ideal.Quotient.mk _ (MvPolynomial.X idx₀)
      ∃ Φ : Localization.Away (MvPolynomial.X (0 : Fin (2 * m + 1)) : MvPolynomial (Fin (2 * m + 1)) κ) ≃+*
          Localization.Away x₀,
        ∀ c : κ,
          Φ (algebraMap (MvPolynomial (Fin (2 * m + 1)) κ) _ (MvPolynomial.C c)) =
            algebraMap A₂ _ (Ideal.Quotient.mk _ (MvPolynomial.C c)) := by
    intro κ _ m c₂ ⟨j₀, b₀⟩ Q_c A₂ x₀
    let _ : CommRing κ := Field.toCommRing
    let _ : DivisionRing κ := Field.toDivisionRing
    classical
    let b₁ : Fin 2 := if b₀ = 0 then 1 else 0
    have hb₁_ne : b₁ ≠ b₀ := by
      dsimp [b₁]
      fin_cases b₀ <;> decide
    have hidx₀_ne : (j₀, b₀) ≠ (j₀, b₁) := fun h => hb₁_ne (Prod.mk.inj h).2.symm
    let Idx' := { idx : Fin (m + 1) × Fin 2 // idx ≠ (j₀, b₁) }
    have hCard : Fintype.card (Fin (2 * m + 1)) = Fintype.card Idx' := by
      rw [Fintype.card_fin, Fintype.card_subtype_compl, Fintype.card_prod, Fintype.card_fin,
        Fintype.card_fin, Fintype.card_unique]
      omega
    let e₀ : Fin (2 * m + 1) ≃ Idx' := Fintype.equivOfCardEq hCard
    let k₀ : Fin (2 * m + 1) := e₀.symm ⟨(j₀, b₀), hidx₀_ne⟩
    let e_idx : Fin (2 * m + 1) ≃ Idx' := (Equiv.swap 0 k₀).trans e₀
    have he_idx0 : e_idx 0 = ⟨(j₀, b₀), hidx₀_ne⟩ := by
      dsimp [e_idx, k₀]
      rw [Equiv.swap_apply_left, Equiv.apply_symm_apply]
    let P₁ := MvPolynomial (Fin (2 * m + 1)) κ
    let X0 : P₁ := MvPolynomial.X (0 : Fin (2 * m + 1))
    let L₁ := Localization.Away X0
    let L₂ := Localization.Away x₀
    let φ₀ : P₁ →+* L₂ :=
      MvPolynomial.eval₂Hom ((algebraMap A₂ L₂).comp ((Ideal.Quotient.mk _).comp MvPolynomial.C))
        (fun k => algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.X (e_idx k).1)))
    have hφ₀_X0_eq : φ₀ X0 = algebraMap A₂ L₂ x₀ := by
      change φ₀ (MvPolynomial.X 0) = algebraMap A₂ L₂ x₀
      rw [MvPolynomial.eval₂Hom_X', he_idx0]
    have hφ₀_X0 : IsUnit (φ₀ X0) := by
      rw [hφ₀_X0_eq]
      exact IsLocalization.Away.algebraMap_isUnit x₀
    let Φ_hom : L₁ →+* L₂ := IsLocalization.Away.lift X0 hφ₀_X0
    have hj_ne : ∀ (j : { j : Fin (m + 1) // j ∈ Finset.univ.erase j₀ }) (b : Fin 2),
        (j.1, b) ≠ (j₀, b₁) := fun j _ h =>
      (Finset.ne_of_mem_erase j.2) (Prod.mk.inj h).1
    let rest_poly : P₁ :=
      ∑ j ∈ (Finset.univ.erase j₀).attach,
        MvPolynomial.X (e_idx.symm ⟨(j.1, 0), hj_ne j 0⟩) *
          MvPolynomial.X (e_idx.symm ⟨(j.1, 1), hj_ne j 1⟩)
    let val_X : Fin (m + 1) × Fin 2 → L₁ := fun idx =>
      if h : idx = (j₀, b₁) then
        IsLocalization.Away.invSelf (S := L₁) X0 *
          algebraMap P₁ L₁ (MvPolynomial.C c₂ - rest_poly)
      else
        algebraMap P₁ L₁ (MvPolynomial.X (e_idx.symm ⟨idx, h⟩))
    let ψ_mv : MvPolynomial (Fin (m + 1) × Fin 2) κ →+* L₁ :=
      MvPolynomial.eval₂Hom ((algebraMap P₁ L₁).comp MvPolynomial.C) val_X
    have hψ_val_b0 : val_X (j₀, b₀) = algebraMap P₁ L₁ X0 := by
      simp only [val_X, hidx₀_ne, ↓reduceDIte]
      have hsymm0 : e_idx.symm ⟨(j₀, b₀), hidx₀_ne⟩ = 0 := by
        rw [← he_idx0, Equiv.symm_apply_apply]
      rw [hsymm0]
    have hψ_val_b1 : val_X (j₀, b₁) =
        IsLocalization.Away.invSelf (S := L₁) X0 *
          algebraMap P₁ L₁ (MvPolynomial.C c₂ - rest_poly) := by
      simp only [val_X, ↓reduceDIte]
    have hψ_j0 : val_X (j₀, 0) * val_X (j₀, 1) =
        algebraMap P₁ L₁ (MvPolynomial.C c₂ - rest_poly) := by
      have hmul_inv : algebraMap P₁ L₁ X0 * IsLocalization.Away.invSelf (S := L₁) X0 = 1 :=
        IsLocalization.Away.mul_invSelf X0
      have hjb : (j₀, 0) = (j₀, b₀) ∧ (j₀, 1) = (j₀, b₁) ∨
          (j₀, 0) = (j₀, b₁) ∧ (j₀, 1) = (j₀, b₀) := by
        dsimp [b₁]
        fin_cases b₀
        · exact Or.inl ⟨rfl, rfl⟩
        · exact Or.inr ⟨rfl, rfl⟩
      rcases hjb with ⟨h0, h1⟩ | ⟨h0, h1⟩
      · rw [h0, h1, hψ_val_b0, hψ_val_b1, ← mul_assoc, hmul_inv, one_mul]
      · rw [h0, h1, hψ_val_b1, hψ_val_b0, mul_comm _ (algebraMap P₁ L₁ X0), ← mul_assoc,
          hmul_inv, one_mul]
    have hψ_Q : ψ_mv Q_c = 0 := by
      dsimp only [Q_c]
      rw [map_sub, map_sum, ← Finset.add_sum_erase _ _ (Finset.mem_univ j₀)]
      have hC_eval : ψ_mv (MvPolynomial.C c₂) = algebraMap P₁ L₁ (MvPolynomial.C c₂) :=
        MvPolynomial.eval₂Hom_C _ _ c₂
      rw [hC_eval]
      simp only [map_mul, ψ_mv, MvPolynomial.eval₂Hom_X']
      rw [hψ_j0, ← Finset.sum_attach (Finset.univ.erase j₀)]
      have hsum_eq : (∑ x ∈ (Finset.univ.erase j₀).attach, val_X (x.1, 0) * val_X (x.1, 1)) =
          algebraMap P₁ L₁ rest_poly := by
        dsimp only [rest_poly]
        rw [map_sum]
        refine Finset.sum_congr rfl fun x _ => ?_
        simp only [val_X, hj_ne x 0, hj_ne x 1, ↓reduceDIte, map_mul]
      rw [hsum_eq, map_sub]
      ring
    have hKer_Q : ∀ P ∈ Ideal.span {Q_c}, ψ_mv P = 0 := by
      intro P hP
      obtain ⟨R, rfl⟩ := Ideal.mem_span_singleton.mp hP
      rw [map_mul, hψ_Q, zero_mul]
    let ψ₀ : A₂ →+* L₁ := Ideal.Quotient.lift (Ideal.span {Q_c}) ψ_mv hKer_Q
    have hψ₀_x0 : IsUnit (ψ₀ x₀) := by
      have hEq : ψ₀ x₀ = algebraMap P₁ L₁ X0 := by
        change ψ_mv (MvPolynomial.X (j₀, b₀)) = _
        rw [MvPolynomial.eval₂Hom_X']
        exact hψ_val_b0
      rw [hEq]
      exact IsLocalization.Away.algebraMap_isUnit X0
    let Ψ_hom : L₂ →+* L₁ := IsLocalization.Away.lift x₀ hψ₀_x0
    have hΨΦ : Ψ_hom.comp Φ_hom = RingHom.id L₁ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers X0)
      apply MvPolynomial.ringHom_ext
      · intro c
        change Ψ_hom (Φ_hom (algebraMap P₁ L₁ (MvPolynomial.C c))) = algebraMap P₁ L₁ (MvPolynomial.C c)
        dsimp only [Φ_hom, Ψ_hom]
        rw [IsLocalization.Away.lift_eq]
        have hφc : φ₀ (MvPolynomial.C c) =
            algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.C c)) :=
          MvPolynomial.eval₂Hom_C _ _ c
        rw [hφc, IsLocalization.Away.lift_eq]
        exact MvPolynomial.eval₂Hom_C _ _ c
      · intro k
        change Ψ_hom (Φ_hom (algebraMap P₁ L₁ (MvPolynomial.X k))) = algebraMap P₁ L₁ (MvPolynomial.X k)
        dsimp only [Φ_hom, Ψ_hom]
        rw [IsLocalization.Away.lift_eq]
        have hφk : φ₀ (MvPolynomial.X k) =
            algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.X (e_idx k).1)) :=
          MvPolynomial.eval₂Hom_X' _ _ k
        rw [hφk, IsLocalization.Away.lift_eq]
        change ψ_mv (MvPolynomial.X (e_idx k).1) = _
        rw [MvPolynomial.eval₂Hom_X']
        simp only [val_X, (e_idx k).2, ↓reduceDIte]
        have hsymm : e_idx.symm ⟨(e_idx k).1, (e_idx k).2⟩ = k := by
          simp
        rw [hsymm]
    have hΦΨ : Φ_hom.comp Ψ_hom = RingHom.id L₂ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers x₀)
      apply RingHom.ext
      intro x
      refine Quotient.inductionOn' x fun P => ?_
      change (Φ_hom.comp Ψ_hom) (algebraMap A₂ L₂ (Ideal.Quotient.mk _ P)) =
        algebraMap A₂ L₂ (Ideal.Quotient.mk _ P)
      induction P using MvPolynomial.induction_on with
      | C c =>
        change Φ_hom (Ψ_hom (algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.C c)))) =
          algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.C c))
        dsimp only [Φ_hom, Ψ_hom]
        rw [IsLocalization.Away.lift_eq]
        have hψc : ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.C c)) =
            algebraMap P₁ L₁ (MvPolynomial.C c) :=
          MvPolynomial.eval₂Hom_C _ _ c
        rw [hψc, IsLocalization.Away.lift_eq]
        exact MvPolynomial.eval₂Hom_C _ _ c
      | add p q hp hq =>
        rw [map_add, map_add, map_add, hp, hq]
      | mul_X p idx hp =>
        rw [map_mul, map_mul, map_mul, hp]
        congr 1
        change Φ_hom (Ψ_hom (algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx)))) =
          algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx))
        dsimp only [Ψ_hom]
        rw [IsLocalization.Away.lift_eq]
        have hψX : ψ₀ (Ideal.Quotient.mk _ (MvPolynomial.X idx)) = val_X idx :=
          MvPolynomial.eval₂Hom_X' _ _ idx
        rw [hψX]
        dsimp only [val_X]
        split_ifs with h
        · subst h
          rw [map_mul]
          have hinv_map : Φ_hom (IsLocalization.Away.invSelf (S := L₁) X0) *
              algebraMap A₂ L₂ x₀ = 1 := by
            have h1 := congrArg Φ_hom (IsLocalization.Away.mul_invSelf (S := L₁) X0)
            dsimp only [Φ_hom] at h1 ⊢
            rw [map_mul, map_one, IsLocalization.Away.lift_eq, hφ₀_X0_eq, mul_comm] at h1
            exact h1
          have hrest_map : Φ_hom (algebraMap P₁ L₁ (MvPolynomial.C c₂ - rest_poly)) =
              algebraMap A₂ L₂ x₀ * algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.X (j₀, b₁))) := by
            dsimp only [Φ_hom]
            rw [IsLocalization.Away.lift_eq]
            dsimp only [rest_poly]
            rw [map_sub, show φ₀ (MvPolynomial.C c₂) = algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.C c₂)) from
              MvPolynomial.eval₂Hom_C _ _ c₂, map_sum]
            have hsum2 : (∑ x ∈ (Finset.univ.erase j₀).attach,
                φ₀ (MvPolynomial.X (e_idx.symm ⟨(x.1, 0), hj_ne x 0⟩) *
                  MvPolynomial.X (e_idx.symm ⟨(x.1, 1), hj_ne x 1⟩))) =
                algebraMap A₂ L₂ (Ideal.Quotient.mk _
                  (∑ j ∈ Finset.univ.erase j₀, MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1))) := by
              rw [← Finset.sum_attach (Finset.univ.erase j₀), map_sum, map_sum]
              refine Finset.sum_congr rfl fun x _ => ?_
              rw [map_mul]
              have h0 : φ₀ (MvPolynomial.X (e_idx.symm ⟨(x.1, 0), hj_ne x 0⟩)) =
                  algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.X (x.1, 0))) := by
                change MvPolynomial.eval₂Hom _ _ (MvPolynomial.X _) = _
                rw [MvPolynomial.eval₂Hom_X', Equiv.apply_symm_apply]
              have h1 : φ₀ (MvPolynomial.X (e_idx.symm ⟨(x.1, 1), hj_ne x 1⟩)) =
                  algebraMap A₂ L₂ (Ideal.Quotient.mk _ (MvPolynomial.X (x.1, 1))) := by
                change MvPolynomial.eval₂Hom _ _ (MvPolynomial.X _) = _
                rw [MvPolynomial.eval₂Hom_X', Equiv.apply_symm_apply]
              rw [h0, h1, ← map_mul, ← map_mul]
            rw [hsum2, ← map_sub, ← map_mul]
            congr 1
            let π_Qc : MvPolynomial (Fin (m + 1) × Fin 2) κ →+* A₂ := Ideal.Quotient.mk (Ideal.span {Q_c})
            have hQ0 : π_Qc
                ((∑ j : Fin (m + 1), (MvPolynomial.X (j, 0) : MvPolynomial (Fin (m + 1) × Fin 2) κ) *
                  MvPolynomial.X (j, 1)) - MvPolynomial.C c₂) = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self Q_c)
            rw [map_sub, ← Finset.add_sum_erase _ _ (Finset.mem_univ j₀), map_add,
              sub_eq_zero] at hQ0
            dsimp only [π_Qc] at hQ0
            have hjb : MvPolynomial.X (j₀, 0) * MvPolynomial.X (j₀, 1) =
                (MvPolynomial.X (j₀, b₀) : MvPolynomial (Fin (m + 1) × Fin 2) κ) *
                  MvPolynomial.X (j₀, b₁) := by
              dsimp [b₁]
              fin_cases b₀
              · rfl
              · exact mul_comm _ _
            rw [← hQ0, hjb, map_mul]
            dsimp only [x₀]
            ring
          rw [hrest_map, ← mul_assoc, hinv_map, one_mul]
        · dsimp only [Φ_hom]
          rw [IsLocalization.Away.lift_eq]
          change MvPolynomial.eval₂Hom _ _ (MvPolynomial.X (e_idx.symm ⟨idx, h⟩)) = _
          rw [MvPolynomial.eval₂Hom_X', Equiv.apply_symm_apply]
    let e_loc : L₁ ≃+* L₂ :=
      { toFun := Φ_hom
        invFun := Ψ_hom
        left_inv := RingHom.congr_fun hΨΦ
        right_inv := RingHom.congr_fun hΦΨ
        map_mul' := map_mul Φ_hom
        map_add' := map_add Φ_hom }
    refine ⟨e_loc, fun c => ?_⟩
    change Φ_hom (algebraMap P₁ L₁ (MvPolynomial.C c)) = _
    dsimp only [Φ_hom]
    rw [IsLocalization.Away.lift_eq]
    exact MvPolynomial.eval₂Hom_C _ _ c
  have hMvQuotIsPullback : ∀ {σ : Type} {R S : Type u} [CommRing R] [CommRing S]
      (φ : R →+* S) (P_R : MvPolynomial σ R) (P_S : MvPolynomial σ S),
      MvPolynomial.map φ P_R = P_S →
      let A_R := MvPolynomial σ R ⧸ Ideal.span {P_R}
      let A_S := MvPolynomial σ S ⧸ Ideal.span {P_S}
      let f_R : R →+* A_R := (Ideal.Quotient.mk _).comp MvPolynomial.C
      let f_S : S →+* A_S := (Ideal.Quotient.mk _).comp MvPolynomial.C
      ∃ π_RS : A_R →+* A_S,
