          (triv_open (E'_y y) (q_y y) ∘ (((ℋ.obj.map (Opposite.op (q_y y))).hom).comp s_open)) := by
        rw [h_comp]
        exact hConstBij (C'_y y) ↥A_open
      exact ((triv_open (E'_y y) (q_y y)).bijective.of_comp_iff' _).mp h_c
    exact (res_y y).symm.bijective.comp hq_bij
  
  have hOverlapAff : ∀ (y₁ y₂ : ↥V) (T : Type u) [CommRing T] [Algebra B T] [Algebra.Etale B T]
      (h_et_T : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T))))
      (g₁ : @AlgebraicGeometry.Scheme.Etale.mk _ _
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T))) h_et_T ⟶ E_y y₁)
      (g₂ : @AlgebraicGeometry.Scheme.Etale.mk _ _
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T))) h_et_T ⟶ E_y y₂)
      (a : ↥A_open),
      (ℋ.obj.map (Opposite.op g₁)).hom (s_y y₁ a) =
        (ℋ.obj.map (Opposite.op g₂)).hom (s_y y₂ a) := by
    intro y₁ y₂ T _ _ _ h_et_T g₁ g₂ a
    let E_T : V.Etale := @AlgebraicGeometry.Scheme.Etale.mk _ _
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T))) h_et_T
    let t₀ : T := algebraMap B T b₀
    let T' := Localization.Away t₀
    have _ : Algebra.Etale T T' := Algebra.Etale.of_isLocalizationAway t₀
    have hEt_BT' : Algebra.Etale B T' := Algebra.Etale.comp B T T'
    have h_et_T' : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T'))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hEt_BT')
    let E_T' : V.Etale := @AlgebraicGeometry.Scheme.Etale.mk _ _
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T'))) h_et_T'
    let u_T : E_T' ⟶ E_T := CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap T T')))
      (by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap T T')) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T'))
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp])
      trivial
    have hLiftOpen : ∀ (y : ↥V) (g : E_T ⟶ E_y y),
        ∃ h : E_T' ⟶ E'_y y, u_T ≫ g = h ≫ i_y y := by
      intro y g
      let g_hom : CommRingCat.of ↑(R_y y) ⟶ CommRingCat.of T :=
        AlgebraicGeometry.Spec.preimage g.left
      have hg_map : AlgebraicGeometry.Spec.map g_hom = g.left :=
        AlgebraicGeometry.Spec.map_preimage g.left
      let θ : ↑(R_y y) →+* T := g_hom.hom
      have hθ_comp : θ.comp (φ_y y) = algebraMap B T := by
        have h_spec : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (θ.comp (φ_y y))) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T)) := by
          rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
          change AlgebraicGeometry.Spec.map g_hom ≫ (E_y y).hom = E_T.hom
          rw [hg_map]
          exact CategoryTheory.MorphismProperty.Over.w g
        have h_pre := congrArg AlgebraicGeometry.Spec.preimage h_spec
        rw [AlgebraicGeometry.Spec.preimage_map, AlgebraicGeometry.Spec.preimage_map] at h_pre
        exact congrArg CommRingCat.Hom.hom h_pre
      have hθ_cy : θ (c_y y) = t₀ := by
        change (θ.comp (φ_y y)) b₀ = algebraMap B T b₀
        rw [hθ_comp]
      have hu_cy : IsUnit ((algebraMap T T').comp θ (c_y y)) := by
        rw [RingHom.comp_apply, hθ_cy]
        exact IsLocalization.Away.algebraMap_isUnit t₀
      let θ' : C'_y y →+* T' := IsLocalization.Away.lift (c_y y) hu_cy
      have hθ'_sq : θ'.comp (algebraMap (↑(R_y y)) (C'_y y)) = (algebraMap T T').comp θ := by
        apply RingHom.ext
        intro x
        rw [RingHom.comp_apply]
        exact IsLocalization.Away.lift_eq (S := C'_y y) (c_y y) hu_cy x
      have hθ'_B : θ'.comp (φ'_y y) = algebraMap B T' := by
        change (θ'.comp (algebraMap (↑(R_y y)) (C'_y y))).comp (φ_y y) = algebraMap B T'
        rw [hθ'_sq, RingHom.comp_assoc, hθ_comp]
        rfl
      let h : E_T' ⟶ E'_y y := CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ'))
        (by
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ') ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ'_y y)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B T'))
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hθ'_B])
        trivial
      refine ⟨h, CategoryTheory.MorphismProperty.Over.Hom.ext ?_⟩
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap T T')) ≫ g.left =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ') ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↑(R_y y)) (C'_y y)))
      rw [← hg_map]
      change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap T T')) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ) = _
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hθ'_sq]
    obtain ⟨h₁, hh₁⟩ := hLiftOpen y₁ g₁
    obtain ⟨h₂, hh₂⟩ := hLiftOpen y₂ g₂
    have h_open_eq : h₁ ≫ q_y y₁ = h₂ ≫ q_y y₂ := by
      let k₁ : E_T' ⟶ E_open := h₁ ≫ q_y y₁
      let k₂ : E_T' ⟶ E_open := h₂ ≫ q_y y₂
      have hk : (k₁.left : E_T'.left ⟶ V_open) ≫ j_open =
          (k₂.left : E_T'.left ⟶ V_open) ≫ j_open :=
        (CategoryTheory.MorphismProperty.Over.w k₁).trans
          (CategoryTheory.MorphismProperty.Over.w k₂).symm
      exact CategoryTheory.MorphismProperty.Over.Hom.ext ((cancel_mono j_open).mp hk)
    have h_uT_eq : (ℋ.obj.map (Opposite.op u_T)).hom ((ℋ.obj.map (Opposite.op g₁)).hom (s_y y₁ a)) =
        (ℋ.obj.map (Opposite.op u_T)).hom ((ℋ.obj.map (Opposite.op g₂)).hom (s_y y₂ a)) :=
      (hResComp u_T g₁ (s_y y₁ a)).symm.trans
        ((congrArg (fun m => (ℋ.obj.map (Opposite.op m)).hom (s_y y₁ a)) hh₁).trans
          ((hResComp h₁ (i_y y₁) (s_y y₁ a)).trans
            ((congrArg (ℋ.obj.map (Opposite.op h₁)).hom (hs_y_res y₁ a)).trans
              ((hResComp h₁ (q_y y₁) (s_open a)).symm.trans
                ((congrArg (fun m => (ℋ.obj.map (Opposite.op m)).hom (s_open a)) h_open_eq).trans
                  ((hResComp h₂ (q_y y₂) (s_open a)).trans
                    ((congrArg (ℋ.obj.map (Opposite.op h₂)).hom (hs_y_res y₂ a).symm).trans
                      ((hResComp h₂ (i_y y₂) (s_y y₂ a)).symm.trans
                        ((congrArg (fun m => (ℋ.obj.map (Opposite.op m)).hom (s_y y₂ a)) hh₂.symm).trans
                          (hResComp u_T g₂ (s_y y₂ a)))))))))))
    let δ : ↥(ℋ.obj.obj (Opposite.op E_T)) :=
      (ℋ.obj.map (Opposite.op g₁)).hom (s_y y₁ a) - (ℋ.obj.map (Opposite.op g₂)).hom (s_y y₂ a)
    have hδ_res : (ℋ.obj.map (Opposite.op u_T)).hom δ = 0 :=
      (map_sub (ℋ.obj.map (Opposite.op u_T)).hom _ _).trans (sub_eq_zero.mpr h_uT_eq)
    have hδ_comap : (triv_y y₁ E_T g₁ δ).comap u_T.left.base.hom = 0 :=
      (htriv_y_nat y₁ u_T g₁ δ).symm.trans
        ((congrArg (triv_y y₁ E_T' (u_T ≫ g₁)) hδ_res).trans (map_zero _))
    have hδ_triv : triv_y y₁ E_T g₁ δ = 0 :=
      hDenseZero T ↥(A_stalk y₁) (triv_y y₁ E_T g₁ δ) fun q => DFunLike.congr_fun hδ_comap q
    have hδ0 : δ = 0 := (triv_y y₁ E_T g₁).injective (hδ_triv.trans (map_zero _).symm)
    exact sub_eq_zero.mp hδ0
  
  have hOfArrowsEx : ∀ {I : Type u} {X : V.Etale} (E : I → V.Etale) (u : ∀ i : I, E i ⟶ X)
      {Z : V.Etale} (h : Z ⟶ X),
      (CategoryTheory.Sieve.ofArrows E u).arrows h →
      ∃ (idx : I) (g : Z ⟶ E idx), g ≫ u idx = h := by
    intro I X E u Z h ⟨W', g, u', hu', hfac⟩
    cases hu'
    exact ⟨_, g, hfac⟩
  have hOverlapAll : ∀ (y₁ y₂ : ↥V) (Z : V.Etale) (f₁ : Z ⟶ E_y y₁) (f₂ : Z ⟶ E_y y₂),
      AddCommGrpCat.ofHom (((ℋ.obj.map (Opposite.op f₁)).hom).comp (s_y y₁)) =
        AddCommGrpCat.ofHom (((ℋ.obj.map (Opposite.op f₂)).hom).comp (s_y y₂)) := by
    intro y₁ y₂ Z f₁ f₂
    have hAffZ : ∀ z : ↥Z.left,
        ∃ (R_z : CommRingCat.{u}) (j_z : AlgebraicGeometry.Spec R_z ⟶ Z.left)
          (p_z : ↥(AlgebraicGeometry.Spec R_z)),
          AlgebraicGeometry.IsOpenImmersion j_z ∧ j_z.base p_z = z := by
      intro z
      obtain ⟨R_z, j_z, hj_open, ⟨p_z, hp_z⟩, -⟩ :=
        @AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset Z.left z ⊤ trivial
      exact ⟨R_z, j_z, p_z, hj_open, hp_z⟩
    let R_z : ↥Z.left → CommRingCat.{u} := fun z => Classical.choose (hAffZ z)
    let j_z : ∀ z : ↥Z.left, AlgebraicGeometry.Spec (R_z z) ⟶ Z.left :=
      fun z => Classical.choose (Classical.choose_spec (hAffZ z))
    let p_z : ∀ z : ↥Z.left, ↥(AlgebraicGeometry.Spec (R_z z)) :=
      fun z => Classical.choose (Classical.choose_spec (Classical.choose_spec (hAffZ z)))
    have hj_z_open : ∀ z : ↥Z.left, AlgebraicGeometry.IsOpenImmersion (j_z z) :=
      fun z => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hAffZ z)))).1
    have hp_z : ∀ z : ↥Z.left, (j_z z).base (p_z z) = z :=
      fun z => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hAffZ z)))).2
    let φ_z : ∀ z : ↥Z.left, B →+* ↑(R_z z) :=
      fun z => (AlgebraicGeometry.Spec.preimage (j_z z ≫ Z.hom)).hom
    have hφ_z_map : ∀ z : ↥Z.left,
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_z z)) = j_z z ≫ Z.hom :=
      fun z => AlgebraicGeometry.Spec.map_preimage (j_z z ≫ Z.hom)
    have h_et_z : ∀ z : ↥Z.left,
        AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_z z))) := by
      intro z
      have _ : AlgebraicGeometry.IsOpenImmersion (j_z z) := hj_z_open z
      have _ : AlgebraicGeometry.Etale Z.hom := Z.prop
      have h_comp : AlgebraicGeometry.Etale (j_z z ≫ Z.hom) := inferInstance
      exact (hφ_z_map z).symm ▸ h_comp
    let E_z : ↥Z.left → V.Etale := fun z =>
      @AlgebraicGeometry.Scheme.Etale.mk _ _
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_z z))) (h_et_z z)
    let u_z : ∀ z : ↥Z.left, E_z z ⟶ Z := fun z =>
      CategoryTheory.MorphismProperty.Over.homMk (j_z z) (hφ_z_map z).symm trivial
    let S_Z : CategoryTheory.Sieve Z := CategoryTheory.Sieve.ofArrows E_z u_z
    have hS_Z : S_Z ∈ V.smallEtaleTopology Z :=
      (hMem V Z S_Z).mpr fun z => ⟨E_z z, u_z z, p_z z,
        CategoryTheory.Sieve.ofArrows_mk E_z u_z z,
        by have _ := hj_z_open z; exact inferInstance, hp_z z⟩
    let lim_Z := Classical.choice
      ((CategoryTheory.Presheaf.isSheaf_iff_isLimit V.smallEtaleTopology ℋ.obj).mp
        ℋ.property S_Z hS_Z)
    apply lim_Z.hom_ext
    intro w
    let Z₀ : V.Etale := w.unop.obj.left
    let f_w : Z₀ ⟶ Z := w.unop.obj.hom
    have hprop : S_Z.arrows f_w := w.unop.property
    obtain ⟨z, g_arr, hfac⟩ := hOfArrowsEx (Z := Z₀) E_z u_z f_w hprop
    apply AddCommGrpCat.ext
    intro a
    let _ : Algebra B ↑(R_z z) := (φ_z z).toAlgebra
    have hφ_et : (φ_z z).Etale :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp (h_et_z z)
    have _ : Algebra.Etale B ↑(R_z z) := RingHom.etale_algebraMap.mp hφ_et
    have h_aff := hOverlapAff y₁ y₂ (↑(R_z z)) (h_et_z z) (u_z z ≫ f₁) (u_z z ≫ f₂) a
    have h_l : (ℋ.obj.map (Opposite.op f_w : Opposite.op Z ⟶ Opposite.op Z₀)).hom
          ((ℋ.obj.map (Opposite.op f₁)).hom (s_y y₁ a)) =
        (ℋ.obj.map (Opposite.op g_arr : Opposite.op (E_z z) ⟶ Opposite.op Z₀)).hom
          ((ℋ.obj.map (Opposite.op (u_z z ≫ f₁))).hom (s_y y₁ a)) :=
      (congrArg (fun (m : Z₀ ⟶ Z) =>
        (ℋ.obj.map (Opposite.op m : Opposite.op Z ⟶ Opposite.op Z₀)).hom
          ((ℋ.obj.map (Opposite.op f₁)).hom (s_y y₁ a))) hfac.symm).trans
        ((hResComp g_arr (u_z z) _).trans
          (congrArg (ℋ.obj.map (Opposite.op g_arr : Opposite.op (E_z z) ⟶ Opposite.op Z₀)).hom
            (hResComp (u_z z) f₁ _).symm))
    have h_r : (ℋ.obj.map (Opposite.op f_w : Opposite.op Z ⟶ Opposite.op Z₀)).hom
          ((ℋ.obj.map (Opposite.op f₂)).hom (s_y y₂ a)) =
        (ℋ.obj.map (Opposite.op g_arr : Opposite.op (E_z z) ⟶ Opposite.op Z₀)).hom
          ((ℋ.obj.map (Opposite.op (u_z z ≫ f₂))).hom (s_y y₂ a)) :=
      (congrArg (fun (m : Z₀ ⟶ Z) =>
        (ℋ.obj.map (Opposite.op m : Opposite.op Z ⟶ Opposite.op Z₀)).hom
          ((ℋ.obj.map (Opposite.op f₂)).hom (s_y y₂ a))) hfac.symm).trans
        ((hResComp g_arr (u_z z) _).trans
          (congrArg (ℋ.obj.map (Opposite.op g_arr : Opposite.op (E_z z) ⟶ Opposite.op Z₀)).hom
            (hResComp (u_z z) f₂ _).symm))
    exact h_l.trans
      ((congrArg (ℋ.obj.map (Opposite.op g_arr : Opposite.op (E_z z) ⟶ Opposite.op Z₀)).hom h_aff).trans
        h_r.symm)
  
  obtain ⟨hT_V, θ_V, hθ_V_nat, hθ_V_unit⟩ := hLocConst V A_open
  let T_V : V.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 V)
