            hBij_UQ_low hFix_Q_top hFix_Y_mid p_τUY hp_τUY

        
        have hγ_η_tgt :
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom γ.toRingHom) ≫ η_Ω_target =
