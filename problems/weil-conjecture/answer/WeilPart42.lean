      have hbij2 := hSheafAppBij (pf_y.mapIso (pb_y.mapIso e_const)) T_V
      have hhom_eq : ((adj_y.unit.app ℛ_V).hom.app (Opposite.op T_V)).hom =
          (((pf_y.mapIso (pb_y.mapIso e_const)).hom.hom.app (Opposite.op T_V)).hom).comp
