by
  have hFieldIsNoetherian : ∀ (K : Type u) [Field K], IsNoetherianRing K := by
    intro K _
    let _ : CommRing K := Field.toCommRing
    let _ : DivisionRing K := Field.toDivisionRing
    let _ : Nontrivial K := DivisionRing.toNontrivial
    rw [isNoetherianRing_iff_ideal_fg]
    intro I
    by_cases hI : ∃ x ∈ I, x ≠ 0
    · obtain ⟨x, hx, hne⟩ := hI
      refine ⟨{1}, ?_⟩
      simp only [Finset.coe_singleton, Ideal.span_singleton_one]
      exact (Ideal.eq_top_of_isUnit_mem I hx (IsUnit.mk0 x hne)).symm
    · push Not at hI
      refine ⟨∅, ?_⟩
      simp only [Finset.coe_empty, Ideal.span_empty]
      ext x
      simp only [Submodule.mem_bot]
      exact ⟨fun hx => hx ▸ I.zero_mem, fun hx => hI x hx⟩
  have hFieldIsLocalRing : ∀ (K : Type u) [Field K], IsLocalRing K := by
    intro K _
    let _ : CommRing K := Field.toCommRing
    let _ : DivisionRing K := Field.toDivisionRing
    let _ : Nontrivial K := DivisionRing.toNontrivial
    exact IsLocalRing.of_nonunits_add (fun a b ha hb hab => by
      by_cases ha0 : a = 0
      · subst ha0; rw [zero_add] at hab; exact False.elim (hb hab)
      · exact ha (IsUnit.mk0 a ha0))
  let _ : ∀ (K : Type u) [Field K], Nontrivial K := fun _ _ => DivisionRing.toNontrivial
  let _ : ∀ (K : Type u) [Field K], IsDomain K := fun _ _ => Field.isDomain
  let _ : ∀ (K : Type u) [Field K], IsLocalRing K := hFieldIsLocalRing
  let _ : ∀ (K : Type u) [Field K], IsNoetherianRing K := hFieldIsNoetherian
  let _ : ∀ (K : Type u) [Field K], StrongRankCondition K :=
    fun K _ => strongRankCondition_of_orzechProperty K
  let _ : CommRing F := Field.toCommRing
  let _ : DivisionRing F := Field.toDivisionRing
  have hKrullDomain : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (ϖ : A),
      ϖ ∈ IsLocalRing.maximalIdeal A →
      (∀ x : A, ϖ * x = 0 → x = 0) →
      IsDomain (A ⧸ Ideal.span ({ϖ} : Set A)) →
      IsDomain A :=
    fun (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] (ϖ : A)
        hϖ_mem hϖ_reg hQuotDom => by
    let I : Ideal A := Ideal.span ({ϖ} : Set A)
    have hI_le : I ≤ IsLocalRing.maximalIdeal A :=
      Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hϖ_mem)
    have hI_ne_top : I ≠ ⊤ :=
      ne_of_lt (lt_of_le_of_lt hI_le (lt_top_iff_ne_top.mpr (IsLocalRing.maximalIdeal.isMaximal A).ne_top))
    have hKrull : ⨅ n : ℕ, I ^ n = ⊥ :=
      Ideal.iInf_pow_eq_bot_of_isLocalRing I hI_ne_top
    have hNontriv : Nontrivial A := by
      refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
      have hq : (0 : A ⧸ I) = 1 := by
        rw [← map_zero (Ideal.Quotient.mk I), ← map_one (Ideal.Quotient.mk I), h01]
      exact zero_ne_one hq
    have hStep : ∀ (m : ℕ) (a b : A), a * b = 0 → b ∉ I ^ m → a = 0 := by
      intro m
      induction m with
      | zero =>
        intro a b _ hb
        rw [pow_zero, Ideal.one_eq_top] at hb
        exact False.elim (hb Submodule.mem_top)
      | succ m ih =>
        intro a b hab hb
        by_cases hb1 : b ∈ I
        · obtain ⟨b₁, rfl⟩ := Ideal.mem_span_singleton.mp hb1
          have hab₁ : a * b₁ = 0 := hϖ_reg (a * b₁) (by linear_combination hab)
          have hb₁_not : b₁ ∉ I ^ m := by
            intro hb₁_mem
            apply hb
            rw [pow_succ']
            exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self ϖ) hb₁_mem
          exact ih a b₁ hab₁ hb₁_not
        · have hmk_b : Ideal.Quotient.mk I b ≠ 0 :=
            mt Ideal.Quotient.eq_zero_iff_mem.mp hb1
          have hPow : ∀ k : ℕ, ∃ c : A, a = ϖ ^ k * c ∧ c * b = 0 := by
            intro k
            induction k with
            | zero => exact ⟨a, by simp, hab⟩
            | succ k ihk =>
              obtain ⟨c, rfl, hcb⟩ := ihk
              have hmk_mul : Ideal.Quotient.mk I c * Ideal.Quotient.mk I b = 0 := by
                rw [← map_mul, hcb, map_zero]
              have hmk_c : Ideal.Quotient.mk I c = 0 :=
                (mul_eq_zero.mp hmk_mul).resolve_right hmk_b
              obtain ⟨c', rfl⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hmk_c)
              refine ⟨c', by ring, hϖ_reg (c' * b) (by linear_combination hcb)⟩
          have ha_mem : a ∈ ⨅ k : ℕ, I ^ k := by
            rw [Ideal.mem_iInf]
            intro k
            obtain ⟨c, ha_eq, _⟩ := hPow k
            rw [Ideal.span_singleton_pow]
            exact Ideal.mem_span_singleton.mpr ⟨c, ha_eq⟩
          rwa [hKrull, Ideal.mem_bot] at ha_mem
    have hNZD : NoZeroDivisors A := ⟨fun {a b} hab => by
      by_cases hb : b = 0
      · exact Or.inr hb
      · have hb_not_iInf : b ∉ ⨅ n : ℕ, I ^ n := by
          rw [hKrull, Ideal.mem_bot]
          exact hb
        rw [Ideal.mem_iInf, not_forall] at hb_not_iInf
        obtain ⟨m, hbm⟩ := hb_not_iInf
        exact Or.inl (hStep m a b hab hbm)⟩
    exact @NoZeroDivisors.to_isDomain A _ hNontriv hNZD
  have hEtaleFieldVNR : ∀ (K E : Type u) [Field K] [CommRing E] [Algebra K E] [Algebra.Etale K E],
      ∀ x : E, ∃ y : E, x * x * y = x :=
    fun (K E : Type u) [Field K] [CommRing E] [Algebra K E] [Algebra.Etale K E] => by
    obtain ⟨I, _, A_i, hField_i, hAlg_i, ⟨e, _⟩⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K E).mp inferInstance
    let _ := hField_i
    let _ := hAlg_i
    intro x
    refine ⟨e.symm (fun i => (e x i)⁻¹), ?_⟩
    apply e.injective
    ext i
    simp only [map_mul, AlgEquiv.apply_symm_apply]
    by_cases hi : e x i = 0
    · simp [hi]
    · exact mul_inv_cancel_right₀ hi (e x i)
  have hLocalVNRIsField : ∀ (R : Type u) [CommRing R] [IsLocalRing R],
      (∀ x : R, ∃ y : R, x * x * y = x) → IsField R :=
    fun (R : Type u) [CommRing R] [IsLocalRing R] hvNR => by
    refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, fun {x} hx => ?_⟩
    obtain ⟨y, hy⟩ := hvNR x
    have h0 : x * (1 - x * y) = 0 := by linear_combination -hy
    have hx_not_mem : x ∉ IsLocalRing.maximalIdeal R := by
      intro hx_mem
      have h1_not_mem : 1 - x * y ∉ IsLocalRing.maximalIdeal R := by
        intro hsub
        have h1 : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
          have hxy : x * y ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right y _ hx_mem
          simpa using Ideal.add_mem _ hsub hxy
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
      obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp h1_not_mem
      apply hx
      calc x = x * (↑u * ↑u⁻¹) := by simp
        _ = (x * (1 - x * y)) * ↑u⁻¹ := by rw [hu]; ring
        _ = 0 := by rw [h0, zero_mul]
    exact (IsLocalRing.notMem_maximalIdeal.mp hx_not_mem).exists_right_inv
  have hFieldCancelLeft : ∀ {K₁ M K₂ : Type u} [Field K₁] [Field M] [Field K₂]
      {α : K₁ →+* M} {β₁ β₂ : M →+* K₂},
      Function.Surjective (β₁.comp α) → β₁.comp α = β₂.comp α → β₁ = β₂ :=
    fun {K₁ M K₂ : Type u} [Field K₁] [Field M] [Field K₂] {α} {β₁ β₂} hsurj heq => by
    let _ : DivisionRing M := Field.toDivisionRing
    let _ : DivisionRing K₂ := Field.toDivisionRing
    ext m
    obtain ⟨c, hc⟩ := hsurj (β₁ m)
    have hαc : α c = m := β₁.injective hc
    rw [← hαc]
    exact RingHom.congr_fun heq c
  have hSpecMapAsIdeal : ∀ {R S : CommRingCat.{u}} (φ : R ⟶ S) (p : AlgebraicGeometry.Spec S),
      ((AlgebraicGeometry.Spec.map φ).base p).asIdeal = Ideal.comap φ.hom p.asIdeal :=
    fun _ _ => rfl
  have hFieldSpecAsIdealBot : ∀ (K : Type u) [Field K]
      (pt : AlgebraicGeometry.Spec (CommRingCat.of K)), pt.asIdeal = ⊥ :=
    fun (K : Type u) [Field K] pt =>
      let _ : CommRing K := Field.toCommRing
      let _ : IsDomain K := Field.isDomain
      congrArg PrimeSpectrum.asIdeal (Subsingleton.elim pt (⊥ : PrimeSpectrum K))
  have hSpecMapInj : ∀ {R S : CommRingCat.{u}} {f g : R ⟶ S},
      AlgebraicGeometry.Spec.map f = AlgebraicGeometry.Spec.map g → f = g :=
    fun h => congrArg Opposite.unop (AlgebraicGeometry.Spec.fullyFaithful.map_injective h)
  have hSpecResidueSubfieldEqTop : ∀ (R : Type u) [CommRing R]
      (q : AlgebraicGeometry.Spec (CommRingCat.of R)),
      let X := AlgebraicGeometry.Spec (CommRingCat.of R)
      let ι_q : R →+* ↥(X.residueField q) :=
        (AlgebraicGeometry.Spec.preimage (X.fromSpecResidueField q)).hom
      RingHom.ker ι_q = q.asIdeal ∧
        ∀ E : Subfield ↥(X.residueField q), (∀ r : R, ι_q r ∈ E) → E = ⊤ :=
    fun (R : Type u) [CommRing R] q => by
    intro X ι_q
    let _ : CommRing ↥(X.residueField q) := Field.toCommRing
    let _ : DivisionRing ↥(X.residueField q) := Field.toDivisionRing
    let _ : IsDomain ↥(X.residueField q) := Field.isDomain
    have hSpec_ι : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_q) = X.fromSpecResidueField q :=
      AlgebraicGeometry.Spec.map_preimage (X.fromSpecResidueField q)
    let pt_q : AlgebraicGeometry.Spec (X.residueField q) :=
      IsLocalRing.closedPoint ↥(X.residueField q)
    have hpt_apply : (X.fromSpecResidueField q).base pt_q = q :=
      X.fromSpecResidueField_apply q pt_q
    have hker : RingHom.ker ι_q = q.asIdeal := by
      have hbase := congrArg (fun f : AlgebraicGeometry.Spec (X.residueField q) ⟶ X =>
        (f.base pt_q).asIdeal) hSpec_ι
      rw [hpt_apply, hSpecMapAsIdeal, hFieldSpecAsIdealBot ↥(X.residueField q) pt_q] at hbase
      exact hbase
    refine ⟨hker, fun E hE => ?_⟩
    let _ : CommRing ↥E := Field.toCommRing
    let _ : DivisionRing ↥E := Field.toDivisionRing
    let _ : IsDomain ↥E := Field.isDomain
    let ι_E : R →+* ↥E := ι_q.codRestrict E.toSubring hE
    have hcomp_E : E.subtype.comp ι_E = ι_q := by ext r; rfl
    let f_E : AlgebraicGeometry.Spec (CommRingCat.of ↥E) ⟶ X :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_E)
    let q' : ↥X := f_E.base (IsLocalRing.closedPoint ↥E)
    have hq'_eq : q' = q := by
      have hsub_pt : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom E.subtype)).base pt_q =
          IsLocalRing.closedPoint ↥E := Subsingleton.elim _ _
      calc q' = f_E.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom E.subtype)).base pt_q) := by
            rw [hsub_pt]
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom E.subtype) ≫ f_E).base pt_q := rfl
        _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (E.subtype.comp ι_E))).base pt_q := by
            rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        _ = (X.fromSpecResidueField q).base pt_q := by rw [hcomp_E, hSpec_ι]
        _ = q := hpt_apply
    let δ₀ : X.residueField q' ⟶ CommRingCat.of ↥E :=
      AlgebraicGeometry.Scheme.descResidueField (AlgebraicGeometry.Scheme.stalkClosedPointTo f_E)
