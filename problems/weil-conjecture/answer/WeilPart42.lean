    haveI : FaithfulSMul R₁ B₁ := (faithfulSMul_iff_algebraMap_injective R₁ B₁).mpr halg_R₁B₁_inj
    haveI : Nontrivial R₁ := inferInstance
    haveI : Module.IsTorsionFree R₁ B₁ := FaithfulSMul.to_isTorsionFree R₁ B₁
    haveI : IsScalarTower R_loc R₁ B₁ := by
      refine IsScalarTower.of_algebraMap_eq fun r => ?_
      apply Subtype.ext; exact IsScalarTower.algebraMap_apply R_loc R₁ L_loc r
    let ι_BB₁ : B →+* B₁ :=
      { toFun := fun x => ⟨x.1, IsIntegral.tower_top x.2⟩
        map_one' := rfl, map_mul' := fun _ _ => rfl, map_zero' := rfl, map_add' := fun _ _ => rfl }
    letI : Algebra B B₁ := ι_BB₁.toAlgebra
    haveI : IsScalarTower B B₁ L_loc := IsScalarTower.of_algebraMap_eq fun _ => rfl
    haveI : IsScalarTower R_loc B B₁ := by
      refine IsScalarTower.of_algebraMap_eq fun r => ?_
      apply Subtype.ext; exact IsScalarTower.algebraMap_apply R_loc B L_loc r
    haveI hLocL_p1 : IsLocalization (Algebra.algebraMapSubmonoid L_loc 𝔭₁.primeCompl) L_loc :=
      { map_units := fun s => by
          obtain ⟨r, hr, hsr⟩ := s.2
          refine IsUnit.mk0 s.1 fun h0 => ?_
          rw [← hsr, IsScalarTower.algebraMap_apply R_loc K_loc L_loc] at h0
          have hrK : algebraMap R_loc K_loc r = 0 :=
            (algebraMap K_loc L_loc).injective (h0.trans (map_zero _).symm)
          exact nonZeroDivisors.ne_zero (𝔭₁.primeCompl_le_nonZeroDivisors hr)
            (IsFractionRing.injective R_loc K_loc (hrK.trans (map_zero _).symm))
        surj := fun x => ⟨⟨x, 1⟩, by simp⟩
        exists_of_eq := fun {x y} hxy => ⟨1, by simpa using hxy⟩ }
    haveI hLocB₁ : IsLocalization (Algebra.algebraMapSubmonoid B 𝔭₁.primeCompl) B₁ :=
      IsLocalization.integralClosure 𝔭₁.primeCompl
    have halg_R₁FB₁_inj : Function.Injective (algebraMap R₁ (FractionRing B₁)) := by
      have heq : algebraMap R₁ (FractionRing B₁) =
          (algebraMap B₁ (FractionRing B₁)).comp (algebraMap R₁ B₁) := by
        ext r; exact IsScalarTower.algebraMap_apply R₁ B₁ (FractionRing B₁) r
      rw [heq]
      exact (IsFractionRing.injective B₁ (FractionRing B₁)).comp halg_R₁B₁_inj
    haveI : FaithfulSMul R₁ (FractionRing B₁) :=
      (faithfulSMul_iff_algebraMap_injective R₁ (FractionRing B₁)).mpr halg_R₁FB₁_inj
    haveI : IsDomain B₁ := inferInstance
    letI : Algebra (FractionRing R₁) (FractionRing B₁) := Ring.instAlgebraFractionRing R₁ B₁
    haveI : IsScalarTower R₁ (FractionRing R₁) (FractionRing B₁) :=
      FractionRing.instIsScalarTower R₁ (FractionRing B₁)
    let eK : FractionRing R₁ ≃ₐ[R₁] K_loc := FractionRing.algEquiv R₁ K_loc
    let eL : FractionRing B₁ ≃ₐ[B₁] L_loc := FractionRing.algEquiv B₁ L_loc
    have hcomm_frac : RingHom.comp (algebraMap K_loc L_loc) eK.toRingEquiv.toRingHom =
        RingHom.comp eL.toRingEquiv.toRingHom (algebraMap (FractionRing R₁) (FractionRing B₁)) := by
      apply IsLocalization.ringHom_ext (nonZeroDivisors R₁)
      ext r
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe]
      change algebraMap K_loc L_loc (eK (algebraMap R₁ (FractionRing R₁) r)) =
        eL (algebraMap (FractionRing R₁) (FractionRing B₁) (algebraMap R₁ (FractionRing R₁) r))
      rw [AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply R₁ K_loc L_loc,
        ← IsScalarTower.algebraMap_apply R₁ (FractionRing R₁) (FractionRing B₁),
        IsScalarTower.algebraMap_apply R₁ B₁ (FractionRing B₁),
        AlgEquiv.commutes, ← IsScalarTower.algebraMap_apply R₁ B₁ L_loc]
    haveI : Algebra.IsSeparable (FractionRing R₁) (FractionRing B₁) :=
      Algebra.IsSeparable.of_equiv_equiv eK.symm.toRingEquiv eL.symm.toRingEquiv (by
        ext x
        have hx := RingHom.congr_fun hcomm_frac (eK.symm x)
        simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe] at hx
        change algebraMap K_loc L_loc (eK (eK.symm x)) =
          eL (algebraMap (FractionRing R₁) (FractionRing B₁) (eK.symm x)) at hx
        rw [eK.apply_symm_apply] at hx; symm
        change eL.symm (algebraMap K_loc L_loc x) =
          algebraMap (FractionRing R₁) (FractionRing B₁) (eK.symm x)
        rw [hx, eL.symm_apply_apply])
    have hDiff_top : differentIdeal R₁ B₁ = ⊤ := by
      by_contra hne_top
      obtain ⟨Q₁, hQ₁_max, hDiff_le⟩ := Ideal.exists_le_maximal (differentIdeal R₁ B₁) hne_top
      haveI : Q₁.IsMaximal := hQ₁_max
      haveI : Q₁.IsPrime := hQ₁_max.isPrime
      have hQ₁_dvd : Q₁ ∣ differentIdeal R₁ B₁ := Ideal.dvd_iff_le.mpr hDiff_le
      have hQ₁_comap_max : (Ideal.comap (algebraMap R₁ B₁) Q₁).IsMaximal :=
        Ideal.IsMaximal.under R₁ Q₁
      have hQ₁_comap_R₁ : Ideal.comap (algebraMap R₁ B₁) Q₁ = IsLocalRing.maximalIdeal R₁ :=
        IsLocalRing.eq_maximalIdeal hQ₁_comap_max
      let Q : Ideal B := Ideal.comap (algebraMap B B₁) Q₁
      haveI : Q.IsPrime := Ideal.IsPrime.comap (algebraMap B B₁)
      have hQ_comap_R : Ideal.comap (algebraMap R_loc B) Q = 𝔭₁ := by
        change Ideal.comap ((algebraMap B B₁).comp (algebraMap R_loc B)) Q₁ = 𝔭₁
        rw [← IsScalarTower.algebraMap_eq R_loc B B₁,
          IsScalarTower.algebraMap_eq R_loc R₁ B₁, ← Ideal.comap_comap, hQ₁_comap_R₁]
        exact IsLocalization.AtPrime.comap_maximalIdeal R₁ 𝔭₁
      have hUnram_Q : Algebra.IsUnramifiedAt R_loc Q :=
        hUnram Q (hQ_comap_R.symm ▸ h𝔭₁_ne_bot) (hQ_comap_R.symm ▸ h𝔭₁_ne_max)
      have hQ_not_supp : (⟨Q, inferInstance⟩ : PrimeSpectrum B) ∉ Module.support B Ω[B⁄R_loc] := by
        have hmem : (⟨Q, inferInstance⟩ : PrimeSpectrum B) ∈ Algebra.unramifiedLocus R_loc B := hUnram_Q
        rwa [Algebra.unramifiedLocus_eq_compl_support] at hmem
      have hQ₁_not_supp : (⟨Q₁, inferInstance⟩ : PrimeSpectrum B₁) ∉ Module.support B₁ Ω[B₁⁄R₁] := by
        rw [Module.notMem_support_iff'] at hQ_not_supp ⊢
        intro ω₁
        haveI hLocMod : IsLocalizedModule 𝔭₁.primeCompl
            ((KaehlerDifferential.map R_loc R₁ B B₁).restrictScalars R_loc) :=
          KaehlerDifferential.isLocalizedModule R_loc R₁ B B₁ 𝔭₁.primeCompl
        obtain ⟨⟨ω, s⟩, hωs⟩ := IsLocalizedModule.surj 𝔭₁.primeCompl
          ((KaehlerDifferential.map R_loc R₁ B B₁).restrictScalars R_loc) ω₁
        dsimp only at hωs
        obtain ⟨t, ht_not_Q, htω⟩ := hQ_not_supp ω
        have hs_unit : IsUnit (algebraMap R₁ B₁ (algebraMap R_loc R₁ s.1)) :=
          (IsLocalization.map_units R₁ s).map (algebraMap R₁ B₁)
        have hs_not_Q₁ : algebraMap R₁ B₁ (algebraMap R_loc R₁ s.1) ∉ Q₁ :=
          fun hmem => hQ₁_max.ne_top (Ideal.eq_top_of_isUnit_mem Q₁ hmem hs_unit)
        have ht_not_Q₁ : algebraMap B B₁ t ∉ Q₁ := ht_not_Q
        refine ⟨algebraMap B B₁ t * algebraMap R₁ B₁ (algebraMap R_loc R₁ s.1),
          fun hmul => (hQ₁_max.isPrime.mem_or_mem hmul).elim ht_not_Q₁ hs_not_Q₁, ?_⟩
        rw [mul_smul]
        have hs_smul : algebraMap R₁ B₁ (algebraMap R_loc R₁ s.1) • ω₁ =
            KaehlerDifferential.map R_loc R₁ B B₁ ω := by
          rw [← algebra_compatible_smul B₁ (algebraMap R_loc R₁ s.1) ω₁,
            IsScalarTower.algebraMap_smul R₁ s.1 ω₁]; exact hωs
        rw [hs_smul]
        have hmap_smul : algebraMap B B₁ t • KaehlerDifferential.map R_loc R₁ B B₁ ω =
            KaehlerDifferential.map R_loc R₁ B B₁ (t • ω) :=
          (KaehlerDifferential.map R_loc R₁ B B₁).map_smulₛₗ t ω |>.symm
        rw [hmap_smul, htω, map_zero]
      have hUnram_Q₁ : Algebra.IsUnramifiedAt R₁ Q₁ := by
        change (⟨Q₁, inferInstance⟩ : PrimeSpectrum B₁) ∈ Algebra.unramifiedLocus R₁ B₁
        rwa [Algebra.unramifiedLocus_eq_compl_support]
      exact (not_dvd_differentIdeal_iff.mpr hUnram_Q₁) hQ₁_dvd
    have h1_mem_diff : (1 : L_loc) ∈ IsLocalization.coeSubmodule L_loc (differentIdeal R₁ B₁) := by
      rw [hDiff_top]; exact ⟨1, Submodule.mem_top, rfl⟩
    rw [coeSubmodule_differentIdeal R₁ K_loc B₁, Submodule.mem_div_iff_forall_mul_mem] at h1_mem_diff
    let M_K : Matrix (Fin n) (Fin n) K_loc := Algebra.traceMatrix K_loc b_K
    have hDet_K : IsUnit M_K.det := by rwa [← Algebra.discr_def]
    obtain ⟨uMK, huMK⟩ := (Matrix.isUnit_iff_isUnit_det M_K).mpr hDet_K
    let N_K : Matrix (Fin n) (Fin n) K_loc := uMK.inv
    have hNK_MK : N_K * M_K = 1 := by dsimp [N_K]; rw [← huMK]; exact uMK.inv_val
    let bDual_K : Fin n → L_loc := fun i => ∑ k : Fin n, N_K i k • b_K k
    have hTrDual_K : ∀ i j : Fin n,
        Algebra.trace K_loc L_loc (bDual_K i * b_K j) = if i = j then 1 else 0 := by
      intro i j; dsimp [bDual_K]; rw [Finset.sum_mul, map_sum]
      have hsum : (∑ k : Fin n, Algebra.trace K_loc L_loc (N_K i k • b_K k * b_K j)) =
          (N_K * M_K) i j := by
        rw [Matrix.mul_apply]; refine Finset.sum_congr rfl fun k _ => ?_
        rw [smul_mul_assoc, LinearMap.map_smul, smul_eq_mul]; rfl
      rw [hsum, hNK_MK, Matrix.one_apply]
    have hbDual_in_B₁ : ∀ i : Fin n, ∃ z₁ : B₁, (z₁ : L_loc) = bDual_K i := by
      intro i
      have hmem_dual : bDual_K i ∈ Submodule.traceDual R₁ K_loc (1 : Submodule B₁ L_loc) := by
        rw [Submodule.mem_traceDual]
        intro y hy
        rw [Submodule.one_eq_span, Submodule.mem_span_singleton] at hy
        obtain ⟨z_y, rfl⟩ := hy
        obtain ⟨⟨z₀, s⟩, hzs⟩ := IsLocalization.surj
          (Algebra.algebraMapSubmonoid B 𝔭₁.primeCompl) z_y
        dsimp only at hzs
        obtain ⟨s₀, hs₀, hs_eq⟩ := s.2
        have hs₀_ne : algebraMap R_loc K_loc s₀ ≠ 0 := (h_units_p1 ⟨s₀, hs₀⟩).ne_zero
        have hz_y_eq : (z_y • (1 : L_loc)) =
            ∑ j : Fin n,
              (algebraMap R_loc K_loc (b.repr z₀ j) / algebraMap R_loc K_loc s₀) • b_K j := by
          have hsL_ne : algebraMap K_loc L_loc (algebraMap R_loc K_loc s₀) ≠ 0 :=
            fun h0 => hs₀_ne ((algebraMap K_loc L_loc).injective (h0.trans (map_zero _).symm))
          apply mul_right_cancel₀ hsL_ne
          have hzs' : (z_y • (1 : L_loc)) * algebraMap K_loc L_loc (algebraMap R_loc K_loc s₀) =
              (z₀ : L_loc) := by
            rw [Algebra.smul_def, mul_one, ← IsScalarTower.algebraMap_apply R_loc K_loc L_loc,
              IsScalarTower.algebraMap_apply R_loc B L_loc, hs_eq,
              IsScalarTower.algebraMap_apply B B₁ L_loc]
            change algebraMap B₁ L_loc (z_y * algebraMap B B₁ s.1) =
              algebraMap B₁ L_loc (algebraMap B B₁ z₀)
            rw [hzs]
          rw [hzs', Finset.sum_mul]; conv_lhs => rw [← b.sum_repr z₀]
          change algebraMap B L_loc (∑ j : Fin n, b.repr z₀ j • b j) = _; rw [map_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [Algebra.smul_def, Algebra.smul_def, hb_K_apply, map_mul,
            ← IsScalarTower.algebraMap_apply R_loc B L_loc,
            IsScalarTower.algebraMap_apply R_loc K_loc L_loc, map_div₀]
          change _ * (b j : L_loc) = _; field_simp [hsL_ne]
        rw [Algebra.traceForm_apply, hz_y_eq, Finset.mul_sum, map_sum]
        have hterm : ∀ j : Fin n,
            Algebra.trace K_loc L_loc
              (bDual_K i * ((algebraMap R_loc K_loc (b.repr z₀ j) / algebraMap R_loc K_loc s₀) • b_K j)) =
              (algebraMap R_loc K_loc (b.repr z₀ j) / algebraMap R_loc K_loc s₀) *
                (if i = j then 1 else 0) := by
          intro j; rw [mul_smul_comm, LinearMap.map_smul, smul_eq_mul, hTrDual_K]
        simp_rw [hterm, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
        refine ⟨IsLocalization.mk' R₁ (b.repr z₀ i) ⟨s₀, hs₀⟩, ?_⟩
        apply mul_right_cancel₀ hs₀_ne
        have hmk := congrArg φ₁ (IsLocalization.mk'_spec' R₁ (b.repr z₀ i) ⟨s₀, hs₀⟩)
        rw [map_mul, hφ₁_eq, hφ₁_eq] at hmk
        calc
          φ₁ (IsLocalization.mk' R₁ (b.repr z₀ i) ⟨s₀, hs₀⟩) * algebraMap R_loc K_loc s₀ =
              algebraMap R_loc K_loc (b.repr z₀ i) := by linear_combination hmk
          _ = (algebraMap R_loc K_loc (b.repr z₀ i) / algebraMap R_loc K_loc s₀) *
                algebraMap R_loc K_loc s₀ := by field_simp [hs₀_ne]
      have h1 := h1_mem_diff (bDual_K i) hmem_dual
      rw [one_mul, Submodule.one_eq_span, Submodule.mem_span_singleton] at h1
      obtain ⟨z₁, hz₁⟩ := h1
      refine ⟨z₁, ?_⟩; rw [Algebra.smul_def, mul_one] at hz₁; exact hz₁
    choose zDual hzDual using hbDual_in_B₁
    have hzDual_R₁ : ∀ i : Fin n, ∃ c_i : Fin n → R₁,
        bDual_K i = ∑ k : Fin n, φ₁ (c_i k) • b_K k := by
      intro i
      obtain ⟨⟨w_i, s⟩, hws⟩ := IsLocalization.surj
        (Algebra.algebraMapSubmonoid B 𝔭₁.primeCompl) (zDual i)
      dsimp only at hws
      obtain ⟨s₀, hs₀, hs_eq⟩ := s.2
      have hs₀_ne : algebraMap R_loc K_loc s₀ ≠ 0 := (h_units_p1 ⟨s₀, hs₀⟩).ne_zero
      refine ⟨fun k => IsLocalization.mk' R₁ (b.repr w_i k) ⟨s₀, hs₀⟩, ?_⟩
      have hmk_k : ∀ k : Fin n,
          φ₁ (IsLocalization.mk' R₁ (b.repr w_i k) ⟨s₀, hs₀⟩) =
            algebraMap R_loc K_loc (b.repr w_i k) / algebraMap R_loc K_loc s₀ := by
        intro k; apply mul_right_cancel₀ hs₀_ne
        have hmk := congrArg φ₁ (IsLocalization.mk'_spec' R₁ (b.repr w_i k) ⟨s₀, hs₀⟩)
        rw [map_mul, hφ₁_eq, hφ₁_eq] at hmk
        calc
          φ₁ (IsLocalization.mk' R₁ (b.repr w_i k) ⟨s₀, hs₀⟩) * algebraMap R_loc K_loc s₀ =
              algebraMap R_loc K_loc (b.repr w_i k) := by linear_combination hmk
          _ = (algebraMap R_loc K_loc (b.repr w_i k) / algebraMap R_loc K_loc s₀) *
                algebraMap R_loc K_loc s₀ := by field_simp [hs₀_ne]
      simp_rw [hmk_k]; rw [← hzDual i]
      have hsL_ne : algebraMap K_loc L_loc (algebraMap R_loc K_loc s₀) ≠ 0 :=
        fun h0 => hs₀_ne ((algebraMap K_loc L_loc).injective (h0.trans (map_zero _).symm))
      apply mul_right_cancel₀ hsL_ne
      have hws' : (zDual i : L_loc) * algebraMap K_loc L_loc (algebraMap R_loc K_loc s₀) =
          (w_i : L_loc) := by
        rw [← IsScalarTower.algebraMap_apply R_loc K_loc L_loc,
          IsScalarTower.algebraMap_apply R_loc B L_loc, hs_eq,
          IsScalarTower.algebraMap_apply B B₁ L_loc]
        change algebraMap B₁ L_loc (zDual i * algebraMap B B₁ s.1) =
          algebraMap B₁ L_loc (algebraMap B B₁ w_i); rw [hws]
      rw [hws', Finset.sum_mul]; conv_lhs => rw [← b.sum_repr w_i]
      change algebraMap B L_loc (∑ k : Fin n, b.repr w_i k • b k) = _; rw [map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [Algebra.smul_def, Algebra.smul_def, hb_K_apply, map_mul,
        ← IsScalarTower.algebraMap_apply R_loc B L_loc,
        IsScalarTower.algebraMap_apply R_loc K_loc L_loc, map_div₀]
      change _ * (b k : L_loc) = _; field_simp [hsL_ne]
    choose C₁ hC₁ using hzDual_R₁
    let MatC₁ : Matrix (Fin n) (Fin n) R₁ := Matrix.of C₁
    let MatM₁ : Matrix (Fin n) (Fin n) R₁ := (Algebra.traceMatrix R_loc b).map (algebraMap R_loc R₁)
    have hMat_prod : MatC₁ * MatM₁ = 1 := by
      ext i j; apply hφ₁_inj; rw [Matrix.mul_apply, map_sum, Matrix.one_apply]
      have h1 : (∑ k : Fin n, φ₁ (MatC₁ i k * MatM₁ k j)) =
          Algebra.trace K_loc L_loc (bDual_K i * b_K j) := by
        rw [hC₁ i, Finset.sum_mul, map_sum]; refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_mul, smul_mul_assoc, LinearMap.map_smul, smul_eq_mul]
        dsimp [MatC₁, MatM₁]; rw [hφ₁_eq, hTrace_K, hb_K_apply, hb_K_apply]; rfl
      rw [h1, hTrDual_K]; split_ifs <;> simp
    have hdet_prod : MatC₁.det * algebraMap R_loc R₁ Δ = 1 := by
      have hd := congrArg Matrix.det hMat_prod
      rw [Matrix.det_mul, Matrix.det_one] at hd
      have hdM : MatM₁.det = algebraMap R_loc R₁ Δ := by
        dsimp [MatM₁, Δ]; rw [Algebra.discr_def, ← RingHom.mapMatrix_apply, RingHom.map_det]
      rwa [hdM] at hd
    have hΔ_unit_R₁ : IsUnit (algebraMap R_loc R₁ Δ) :=
      ⟨⟨algebraMap R_loc R₁ Δ, MatC₁.det, mul_comm _ _ |>.trans hdet_prod, hdet_prod⟩, rfl⟩
    have hΔ_max_R₁ : algebraMap R_loc R₁ Δ ∈ IsLocalRing.maximalIdeal R₁ :=
      (hmem_max_R₁ Δ).mp hΔ_mem_p1
    exact (IsLocalRing.maximalIdeal.isMaximal R₁).ne_top
      (Ideal.eq_top_of_isUnit_mem _ hΔ_max_R₁ hΔ_unit_R₁)
  
  have hPillar3 : ∀ (R S : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S]
      (n : ℕ) (b : Module.Basis (Fin n) R S),
      IsUnit (Algebra.discr R b) → Algebra.Etale R S := by
    intro R S _ _ _ _ n b hUnit
    let M : Matrix (Fin n) (Fin n) R := Algebra.traceMatrix R b
    have hDet : IsUnit M.det := by rwa [← Algebra.discr_def]
    obtain ⟨uM, huM⟩ := (Matrix.isUnit_iff_isUnit_det M).mpr hDet
    let N : Matrix (Fin n) (Fin n) R := uM.inv
    have hNM : N * M = 1 := by dsimp [N]; rw [← huM]; exact uM.inv_val
    have hMN : M * N = 1 := by dsimp [N]; rw [← huM]; exact uM.val_inv
    let bDual : Fin n → S := fun i => ∑ k : Fin n, N i k • b k
    have hTrDual : ∀ i j : Fin n, Algebra.trace R S (bDual i * b j) = if i = j then 1 else 0 := by
      intro i j; dsimp [bDual]; rw [Finset.sum_mul, map_sum]
      have hsum : (∑ k : Fin n, Algebra.trace R S (N i k • b k * b j)) = (N * M) i j := by
        rw [Matrix.mul_apply]; refine Finset.sum_congr rfl fun k _ => ?_
        rw [smul_mul_assoc, LinearMap.map_smul, smul_eq_mul]; rfl
      rw [hsum, hNM, Matrix.one_apply]
    have hRepr : ∀ (x : S) (i : Fin n), Algebra.trace R S (bDual i * x) = b.repr x i := by
      intro x i; conv_lhs => rw [← b.sum_repr x]
      rw [Finset.mul_sum, map_sum]
      have hsum : ∀ j : Fin n,
          Algebra.trace R S (bDual i * (b.repr x j • b j)) =
            b.repr x j * (if i = j then 1 else 0) := by
        intro j; rw [mul_smul_comm, LinearMap.map_smul, smul_eq_mul, hTrDual]
      simp_rw [hsum, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
    have hExp1 : ∀ x : S, (∑ i : Fin n, Algebra.trace R S (bDual i * x) • b i) = x := by
      intro x; simp_rw [hRepr]; exact b.sum_repr x
    have hExp2 : ∀ x : S, (∑ i : Fin n, Algebra.trace R S (x * b i) • bDual i) = x := by
      intro x
      have hTr_xb : ∀ i : Fin n,
          Algebra.trace R S (x * b i) = ∑ j : Fin n, b.repr x j * M j i := by
        intro i; conv_lhs => rw [← b.sum_repr x]; rw [Finset.sum_mul, map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [smul_mul_assoc, LinearMap.map_smul, smul_eq_mul]; rfl
      dsimp [bDual]; simp_rw [hTr_xb, Finset.smul_sum, smul_smul]; rw [Finset.sum_comm]
      have hinner : ∀ k : Fin n,
          (∑ i : Fin n, ((∑ j : Fin n, b.repr x j * M j i) * N i k) • b k) = b.repr x k • b k := by
        intro k; rw [← Finset.sum_smul]; congr 1
        simp_rw [Finset.sum_mul, mul_assoc]; rw [Finset.sum_comm]
        have hMN_jk : ∀ j : Fin n,
            (∑ i : Fin n, b.repr x j * (M j i * N i k)) = b.repr x j * (M * N) j k := by
          intro j; rw [← Finset.mul_sum, ← Matrix.mul_apply]
        simp_rw [hMN_jk, hMN, Matrix.one_apply, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_eq', Finset.mem_univ, ite_true]
      simp_rw [hinner]; exact b.sum_repr x
    have hSepId : (∑ i : Fin n, b i * bDual i) = 1 := by
      have hTrEq : ∀ w : S,
          Algebra.trace R S w = Algebra.trace R S (w * ∑ i : Fin n, b i * bDual i) := by
        intro w; rw [Algebra.trace_eq_matrix_trace b w, Matrix.trace, Finset.mul_sum, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Matrix.diag_apply, Algebra.leftMulMatrix_eq_repr_mul, ← hRepr]; congr 1; ring
      set e₁ : S := ∑ i : Fin n, b i * bDual i
      have h0 : e₁ - 1 = 0 := by
        rw [← hExp1 (e₁ - 1)]; refine Finset.sum_eq_zero fun i _ => ?_
        have htr0 : Algebra.trace R S (bDual i * (e₁ - 1)) = 0 := by
          rw [mul_sub, mul_one, map_sub, ← hTrEq (bDual i), sub_self]
        rw [htr0, zero_smul]
      exact sub_eq_zero.mp h0
    have hUnram : Algebra.FormallyUnramified R S := by
      let D := KaehlerDifferential.D R S
      have hD0 : ∀ s : S, D s = 0 := by
        intro s
        have h1 : (∑ i : Fin n, bDual i • D (s * b i)) =
            (∑ i : Fin n, (bDual i * s) • D (b i)) + D s := by
          have hleib : ∀ i : Fin n,
              bDual i • D (s * b i) = (bDual i * s) • D (b i) + (bDual i * b i) • D s := by
            intro i; rw [D.leibniz, smul_add, smul_smul, smul_smul]
