                CategoryTheory.Limits.Sigma.ι_map, CategoryTheory.Limits.Sigma.ι_map_assoc,
                CategoryTheory.Limits.Sigma.ι_comp_desc, ← Category.assoc, α.naturality, Category.assoc] }
        map_id := fun P => by
          ext Z₀ : 2
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro σ
          dsimp
          simp
        map_comp := fun α β => by
          ext Z₀ : 2
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro σ
          dsimp
