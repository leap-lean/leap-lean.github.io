            have hc := congrArg M.subtype (γ.commutes ⟨(c : Ω₁), c.2.2⟩)
            exact hc) }
      let res : (↥M ≃ₐ[↥K_sl] ↥M) →* (↥E_L ≃ₐ[↥E_cap] ↥E_L) :=
