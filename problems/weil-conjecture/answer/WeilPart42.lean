    { map_units := by
        rintro ⟨_, a, ha, rfl⟩
        have ha_ne : a ≠ 0 := nonZeroDivisors.ne_zero (hLe_nzd ha)
        have hmap_ne : algebraMap A₀ L₂ a ≠ 0 :=
          fun h0 => ha_ne (hInj_A₀_L₂ (h0.trans (map_zero _).symm))
        exact isUnit_iff_ne_zero.mpr hmap_ne
      surj := fun z => ⟨⟨z, 1⟩, by simp⟩
      exists_of_eq := fun h => ⟨1, by simpa using h⟩ }
  let S_B : Submonoid ↥B₂_0 := Algebra.algebraMapSubmonoid ↥B₂_0 𝔓₀.primeCompl
  haveI : IsLocalization S_B ↥B_C :=
    IsLocalization.integralClosure (R := A₀) (S := L₂) (Rf := R_C) (Sf := L₂) 𝔓₀.primeCompl

  have hDown : ∀ (Q' : Ideal ↥B_C) [Q'.IsPrime],
      Ideal.comap (algebraMap R_C ↥B_C) Q' = 𝔭_C →
      let Q : Ideal ↥B₂_0 := Ideal.comap ι_B Q'
      Q.IsPrime ∧ Ideal.comap (algebraMap A₀ ↥B₂_0) Q = 𝔓₀ ∧
      (∀ σ : G,
        (∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' (Q : Set ↥B₂_0)) ↔
          σ ∈ Ideal.inertia G Q') := by
    intro Q' hQ'_prime hQ'_comap Q
    have hQ_prime : Q.IsPrime := Ideal.IsPrime.comap ι_B
    have hComp : ι_B.comp (algebraMap A₀ ↥B₂_0) = (algebraMap R_C ↥B_C).comp (algebraMap A₀ R_C) := by
      apply RingHom.ext
      intro a
      exact Subtype.ext (IsScalarTower.algebraMap_apply A₀ R_C L₂ a)
    have hQ_comap : Ideal.comap (algebraMap A₀ ↥B₂_0) Q = 𝔓₀ := by
      change Ideal.comap (algebraMap A₀ ↥B₂_0) (Ideal.comap ι_B Q') = 𝔓₀
      rw [Ideal.comap_comap, hComp, ← Ideal.comap_comap, hQ'_comap]
      exact IsLocalization.AtPrime.under_maximalIdeal R_C 𝔓₀
    refine ⟨hQ_prime, hQ_comap, fun σ => ?_⟩
    rw [AddSubgroup.mem_inertia]
    constructor
    · intro hy z
      obtain ⟨⟨y, s_B⟩, hzs⟩ := IsLocalization.surj S_B z
      dsimp only at hzs
      rcases s_B with ⟨s_val, s, hs_mem, rfl⟩
      obtain ⟨d, hd_mem, hd_val⟩ := hy y
      have h_eq : (σ • z - z) * algebraMap ↥B₂_0 ↥B_C (algebraMap A₀ ↥B₂_0 s) = ι_B d := by
        apply Subtype.ext
        have hs_fix : σ (algebraMap A₀ L₂ s) = algebraMap A₀ L₂ s :=
          σ.commutes (algebraMap A₀ K₂ s)
        have hzs_val : z.1 * algebraMap A₀ L₂ s = y.1 := congrArg Subtype.val hzs
        calc
          ((σ • z - z) * algebraMap ↥B₂_0 ↥B_C (algebraMap A₀ ↥B₂_0 s)).1
              = (σ z.1 - z.1) * algebraMap A₀ L₂ s := rfl
          _ = σ (z.1 * algebraMap A₀ L₂ s) - z.1 * algebraMap A₀ L₂ s := by
              rw [sub_mul, map_mul, hs_fix]
          _ = σ y.1 - y.1 := by rw [hzs_val]
          _ = (ι_B d).1 := hd_val.symm
      let s_elem : S_B := ⟨algebraMap A₀ ↥B₂_0 s, s, hs_mem, rfl⟩
      rcases IsLocalization.map_units ↥B_C s_elem with ⟨u_s, hu_eq⟩
      have hprod_mem : (σ • z - z) * (u_s : ↥B_C) ∈ Q' := by
        rw [hu_eq]
        change (σ • z - z) * algebraMap ↥B₂_0 ↥B_C (algebraMap A₀ ↥B₂_0 s) ∈ Q'
        rw [h_eq]
        exact hd_mem
      simpa [mul_assoc] using Q'.mul_mem_right (↑u_s⁻¹ : ↥B_C) hprod_mem
    · intro hz y
      let d : ↥B₂_0 := σ • y - y
      have h_id : ι_B d = σ • (ι_B y) - ι_B y := rfl
      have hd_mem : d ∈ Q := by
        change ι_B d ∈ Q'
        rw [h_id]
        exact hz (ι_B y)
      exact ⟨d, hd_mem, rfl⟩

  
  haveI : Q'_0.IsMaximal := hQ'_0_max
  haveI : Q'_0.IsPrime := hQ'_0_max.isPrime
  haveI : Q'_0.LiesOver 𝔭_C := ⟨hQ'_0_under.symm⟩
  obtain ⟨hQ0_prime, hQ0_comap, hQ0_inert⟩ := hDown Q'_0 hQ'_0_under
  have hTame_Q'_0 : ringChar k = 0 ∨ Nat.Coprime (ringChar k) (Nat.card ↥(Ideal.inertia G Q'_0)) := by
    have hT := hTame (Ideal.comap ι_B Q'_0) hQ0_prime hQ0_comap
    have hCardEq :
        Nat.card { σ : G //
          ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' ((Ideal.comap ι_B Q'_0 : Ideal ↥B₂_0) : Set ↥B₂_0) } =
        Nat.card ↥(Ideal.inertia G Q'_0) :=
      Nat.card_congr (Equiv.subtypeEquivRight hQ0_inert)
    rwa [hCardEq] at hT
  have he_ne : (e : k) ≠ 0 := (hGaloisTame Q'_0 hTame_Q'_0).1

  
  refine ⟨e, he_pos, he_ne, ?_⟩
  intro 𝔓_C h𝔓_C_prime Q_C hQC_prime hOver h𝔓_eq
  subst h𝔓_eq
  have hPrime_eq : h𝔓_C_prime = h𝔓₀_prime := Subsingleton.elim _ _
  subst hPrime_eq

  have hDisj_SB : Disjoint (S_B : Set ↥B₂_0) (Q_C : Set ↥B₂_0) := by
    rw [Set.disjoint_left]
    rintro _ ⟨s, hs_not_mem, rfl⟩ hs_in_QC
    apply hs_not_mem
    change s ∈ Ideal.span {f₀}
    rw [hOver]
    exact hs_in_QC
  let Q'_C : Ideal ↥B_C := Ideal.map ι_B Q_C
  haveI hQ'_C_prime : Q'_C.IsPrime :=
    IsLocalization.isPrime_of_isPrime_disjoint S_B ↥B_C Q_C hQC_prime hDisj_SB
  have hQ'_C_comap_B : Ideal.comap ι_B Q'_C = Q_C :=
    IsLocalization.under_map_of_isPrime_disjoint S_B ↥B_C hQC_prime hDisj_SB
  have hQ'_C_comap_R : Ideal.comap (algebraMap R_C ↥B_C) Q'_C = 𝔭_C := by
    apply le_antisymm
    · exact IsLocalRing.le_maximalIdeal (Ideal.IsPrime.comap (algebraMap R_C ↥B_C)).ne_top
    · rw [h𝔭_C_eq, Ideal.span_singleton_le_iff_mem]
      change algebraMap R_C ↥B_C (algebraMap A₀ R_C f₀) ∈ Q'_C
      have hf₀_B : algebraMap A₀ ↥B₂_0 f₀ ∈ Q_C := by
        have hf₀_span : f₀ ∈ Ideal.span {f₀} := Ideal.mem_span_singleton_self f₀
        rwa [hOver] at hf₀_span
      have h_eq_f : algebraMap R_C ↥B_C (algebraMap A₀ R_C f₀) = ι_B (algebraMap A₀ ↥B₂_0 f₀) :=
        Subtype.ext (IsScalarTower.algebraMap_apply A₀ R_C L₂ f₀).symm
      rw [h_eq_f]
      exact Ideal.mem_map_of_mem ι_B hf₀_B
  haveI hQ'_C_over : Q'_C.LiesOver 𝔭_C := ⟨hQ'_C_comap_R.symm⟩

  let E_Q := Localization.AtPrime Q_C
  have hLe_QC_nzd : Q_C.primeCompl ≤ nonZeroDivisors ↥B₂_0 := fun s hs =>
    mem_nonZeroDivisors_of_ne_zero fun h0 => hs (h0 ▸ Q_C.zero_mem)
  haveI : IsDomain E_Q := IsLocalization.isDomain_of_le_nonZeroDivisors E_Q hLe_QC_nzd
  have hInj_B₂_EQ : Function.Injective (algebraMap ↥B₂_0 E_Q) :=
    IsLocalization.injective E_Q hLe_QC_nzd
  have hSB_le_QC : S_B ≤ Q_C.primeCompl := fun s hs hsQ =>
    Set.disjoint_left.mp hDisj_SB hs hsQ
  have hUnits_SB_EQ : ∀ y : S_B, IsUnit (algebraMap ↥B₂_0 E_Q y) :=
    fun y => IsLocalization.map_units E_Q ⟨y.1, hSB_le_QC y.2⟩
  let ℓ_EQ : ↥B_C →+* E_Q := IsLocalization.lift hUnits_SB_EQ
  letI : Algebra ↥B_C E_Q := ℓ_EQ.toAlgebra
  have hℓ_comp : ∀ y : ↥B₂_0, algebraMap ↥B_C E_Q (ι_B y) = algebraMap ↥B₂_0 E_Q y :=
    fun y => IsLocalization.lift_eq hUnits_SB_EQ y
  haveI : IsLocalization.AtPrime E_Q Q'_C :=
    { map_units := by
        rintro ⟨z, hz⟩
        obtain ⟨⟨y, s_B⟩, hzs⟩ := IsLocalization.surj S_B z
        dsimp only at hzs
        have hs_not_Q' : ι_B s_B.1 ∉ Q'_C := by
          rw [← Ideal.mem_comap, hQ'_C_comap_B]
          exact hSB_le_QC s_B.2
        have hy_not_Q' : ι_B y ∉ Q'_C := fun hyQ' =>
          hQ'_C_prime.mul_mem_iff_mem_or_mem.mp (show z * ι_B s_B.1 ∈ Q'_C from hzs ▸ hyQ')
            |>.elim hz hs_not_Q'
        have hy_compl : y ∈ Q_C.primeCompl := by
          change y ∉ Q_C
          rwa [← hQ'_C_comap_B]
        have hmap_mul :
            algebraMap ↥B_C E_Q z * algebraMap ↥B₂_0 E_Q s_B.1 = algebraMap ↥B₂_0 E_Q y := by
          rw [← hℓ_comp s_B.1, ← map_mul]
          change algebraMap ↥B_C E_Q (z * algebraMap ↥B₂_0 ↥B_C s_B.1) = _
          rw [hzs]
          exact hℓ_comp y
        have hu_y : IsUnit (algebraMap ↥B₂_0 E_Q y) := IsLocalization.map_units E_Q ⟨y, hy_compl⟩
        rw [← hmap_mul] at hu_y
        exact isUnit_of_mul_isUnit_left hu_y
      surj := by
        intro w
        obtain ⟨⟨y, u⟩, hwu⟩ := IsLocalization.surj Q_C.primeCompl w
        dsimp only at hwu
        have hu_Q' : ι_B u.1 ∈ Q'_C.primeCompl := by
          change ι_B u.1 ∉ Q'_C
          rw [← Ideal.mem_comap, hQ'_C_comap_B]
          exact u.2
        refine ⟨⟨ι_B y, ⟨ι_B u.1, hu_Q'⟩⟩, ?_⟩
        dsimp only
        rwa [hℓ_comp u.1, hℓ_comp y]
      exists_of_eq := by
        intro z₁ z₂ hz
        obtain ⟨⟨y, s_B⟩, hzs⟩ := IsLocalization.surj S_B (z₁ - z₂)
        dsimp only at hzs
        have hz_add : z₂ + (z₁ - z₂) = z₁ := Subtype.ext (add_sub_cancel z₂.1 z₁.1)
        have hdiff : algebraMap ↥B_C E_Q (z₁ - z₂) = 0 := by
          calc
            algebraMap ↥B_C E_Q (z₁ - z₂)
                = (algebraMap ↥B_C E_Q z₂ + algebraMap ↥B_C E_Q (z₁ - z₂)) -
                    algebraMap ↥B_C E_Q z₂ := by ring
            _ = algebraMap ↥B_C E_Q z₂ - algebraMap ↥B_C E_Q z₂ := by
                rw [← map_add, hz_add, hz]
            _ = 0 := sub_self _
        have hmap_y : algebraMap ↥B₂_0 E_Q y = 0 := by
          rw [← hℓ_comp y]
          change algebraMap ↥B_C E_Q (algebraMap ↥B₂_0 ↥B_C y) = 0
          rw [← hzs, map_mul, hdiff, zero_mul]
        have hy0 : y = 0 := hInj_B₂_EQ (hmap_y.trans (map_zero _).symm)
        rw [hy0, map_zero] at hzs
        have hsub0 : z₁ - z₂ = 0 :=
          (mul_eq_zero.mp hzs).resolve_right (IsLocalization.map_units ↥B_C s_B).ne_zero
        have hz_eq : z₁ = z₂ := Subtype.ext (sub_eq_zero.mp (congrArg Subtype.val hsub0))
        exact ⟨1, by simp [hz_eq]⟩ }

  obtain ⟨hDVR_EQ, π_C, u_C, hπ_C_ne, hMax_EQ, hu_C⟩ := hLocalPow Q'_C E_Q
  have hMap_f₀_eq :
      algebraMap ↥B_C E_Q (algebraMap R_C ↥B_C π_R) =
        algebraMap ↥B₂_0 E_Q (algebraMap A₀ ↥B₂_0 f₀) := by
    have h1 : algebraMap R_C ↥B_C π_R = ι_B (algebraMap A₀ ↥B₂_0 f₀) :=
      Subtype.ext (IsScalarTower.algebraMap_apply A₀ R_C L₂ f₀).symm
    rw [h1, hℓ_comp (algebraMap A₀ ↥B₂_0 f₀)]
  rw [hMap_f₀_eq] at hu_C

  obtain ⟨_, _, hQC_inert⟩ := hDown Q'_C hQ'_C_comap_R
  have hTame_Q'_C : ringChar k = 0 ∨
      Nat.Coprime (ringChar k) (Nat.card ↥(@Ideal.inertia ↥B_C _ G _ _ Q'_C)) := by
    have hT := hTame Q_C hQC_prime hOver.symm
    rw [← hQ'_C_comap_B] at hT
    have hCardEq :
        Nat.card { σ : G //
          ∀ y : ↥B₂_0, σ (y : L₂) - (y : L₂) ∈ Subtype.val '' ((Ideal.comap ι_B Q'_C : Ideal ↥B₂_0) : Set ↥B₂_0) } =
        Nat.card ↥(@Ideal.inertia ↥B_C _ G _ _ Q'_C) :=
      Nat.card_congr (Equiv.subtypeEquivRight hQC_inert)
    rwa [hCardEq] at hT

  let ρ_bot : R_C →+* (Ideal.span {f₀}).ResidueField := IsLocalRing.residue R_C
  let ρ_top : ↥B_C →+* Q_C.ResidueField := (IsLocalRing.residue E_Q).comp (algebraMap ↥B_C E_Q)
  let f_res : (Ideal.span {f₀}).ResidueField →+* Q_C.ResidueField :=
    Ideal.ResidueField.map (Ideal.span {f₀}) Q_C (algebraMap A₀ ↥B₂_0) hOver

  have hρ_bot_ker : ∀ r ∈ 𝔭_C, ρ_bot r = 0 := fun r hr =>
    RingHom.mem_ker.mp ((IsLocalRing.ker_residue (R := R_C)).symm ▸ hr)
  have hρ_top_ker : ∀ z ∈ Q'_C, ρ_top z = 0 := by
    intro z hz
    change IsLocalRing.residue E_Q (algebraMap ↥B_C E_Q z) = 0
    rw [← RingHom.mem_ker, IsLocalRing.ker_residue]
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff E_Q Q'_C z).mpr hz
  have hFrac_surj : ∀ ξ : Q_C.ResidueField, ∃ (b u : ↥B_C), u ∉ Q'_C ∧ ξ * ρ_top u = ρ_top b := by
    intro ξ
    obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective ξ
    obtain ⟨⟨b, u⟩, hwu⟩ := IsLocalization.surj Q'_C.primeCompl w
    dsimp only at hwu
    refine ⟨b, u.1, u.2, ?_⟩
    change IsLocalRing.residue E_Q w * IsLocalRing.residue E_Q (algebraMap ↥B_C E_Q u.1) =
      IsLocalRing.residue E_Q (algebraMap ↥B_C E_Q b)
    rw [← map_mul, hwu]
  have hComm_A₀ : ∀ a : A₀, f_res (ρ_bot (algebraMap A₀ R_C a)) = ρ_top (algebraMap R_C ↥B_C (algebraMap A₀ R_C a)) := by
    intro a
    have hL : ρ_bot (algebraMap A₀ R_C a) = algebraMap A₀ (Ideal.span {f₀}).ResidueField a := rfl
    rw [hL, Ideal.ResidueField.map_algebraMap]
    change algebraMap ↥B₂_0 Q_C.ResidueField (algebraMap A₀ ↥B₂_0 a) =
      IsLocalRing.residue E_Q (algebraMap ↥B_C E_Q (algebraMap R_C ↥B_C (algebraMap A₀ R_C a)))
    have h_eq_a : algebraMap R_C ↥B_C (algebraMap A₀ R_C a) =
        ι_B (algebraMap A₀ ↥B₂_0 a) :=
      Subtype.ext (IsScalarTower.algebraMap_apply A₀ R_C L₂ a).symm
    rw [h_eq_a, hℓ_comp (algebraMap A₀ ↥B₂_0 a)]
    rfl
  have hComm_R : ∀ r : R_C, f_res (ρ_bot r) = ρ_top (algebraMap R_C ↥B_C r) := by
    intro r
    obtain ⟨⟨a, s⟩, hrs⟩ := IsLocalization.surj 𝔓₀.primeCompl r
    dsimp only at hrs
    have hs_not_𝔭 : algebraMap A₀ R_C s.1 ∉ 𝔭_C := by
      rw [IsLocalization.AtPrime.to_map_mem_maximal_iff R_C 𝔓₀ s.1]
      exact s.2
    have hρ_s_ne : ρ_bot (algebraMap A₀ R_C s.1) ≠ 0 := by
      intro h0
      have hker : algebraMap A₀ R_C s.1 ∈ RingHom.ker (IsLocalRing.residue R_C) :=
        RingHom.mem_ker.mpr h0
      rw [IsLocalRing.ker_residue] at hker
      exact hs_not_𝔭 hker
    have hf_s_ne : f_res (ρ_bot (algebraMap A₀ R_C s.1)) ≠ 0 :=
      fun h0 => hρ_s_ne ((RingHom.injective f_res) (h0.trans (map_zero _).symm))
    apply mul_right_cancel₀ hf_s_ne
    calc
      f_res (ρ_bot r) * f_res (ρ_bot (algebraMap A₀ R_C s.1))
          = f_res (ρ_bot (algebraMap A₀ R_C a)) := by rw [← map_mul, ← map_mul, hrs]
      _ = ρ_top (algebraMap R_C ↥B_C (algebraMap A₀ R_C a)) := hComm_A₀ a
      _ = ρ_top (algebraMap R_C ↥B_C r) * ρ_top (algebraMap R_C ↥B_C (algebraMap A₀ R_C s.1)) := by
          rw [← hrs, map_mul, map_mul]
      _ = ρ_top (algebraMap R_C ↥B_C r) * f_res (ρ_bot (algebraMap A₀ R_C s.1)) := by
          rw [hComm_A₀ s.1]

  have hSep_res : @Algebra.IsSeparable (Ideal.span {f₀}).ResidueField Q_C.ResidueField _ _
      f_res.toAlgebra :=
    (hGaloisTame Q'_C hTame_Q'_C).2 (Ideal.span {f₀}).ResidueField Q_C.ResidueField
      ρ_bot ρ_top f_res hρ_bot_ker hρ_top_ker hFrac_surj hComm_R

  exact ⟨hDVR_EQ, ⟨π_C, u_C, hπ_C_ne, hMax_EQ, hu_C⟩, hSep_res⟩

theorem weil_kummer_local_ring_regular_and_integrally_closed (k : Type u) [Field k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (h₀ f₀ : A₀),
      Irreducible h₀ →
      Irreducible f₀ →
      ∀ (p : Fin 2 → k),
        MvPolynomial.eval p h₀ = 0 →
        MvPolynomial.eval p f₀ = 0 →
        ∀ (𝔪_p : Ideal A₀) [𝔪_p.IsMaximal],
          (∀ g : A₀, g ∈ 𝔪_p ↔ MvPolynomial.eval p g = 0) →
          (let 𝒪_p := Localization.AtPrime 𝔪_p
           let f_p := algebraMap A₀ 𝒪_p f₀
           let h_p := algebraMap A₀ 𝒪_p h₀
           f_p ≠ 0 ∧ h_p ≠ 0 ∧
           (Ideal.span {f_p}).IsPrime ∧ (Ideal.span {h_p}).IsPrime ∧
           h_p ∉ Ideal.span {f_p} ∧ f_p ∉ Ideal.span {h_p} ∧
           IsLocalRing.maximalIdeal 𝒪_p = Ideal.span {f_p, h_p}) →
          ∀ (e : ℕ), 1 ≤ e → (e : k) ≠ 0 →
            ∃ (R'_p K'_2 : Type u)
              (_ : CommRing R'_p) (_ : IsDomain R'_p) (_ : IsNoetherianRing R'_p)
              (_ : IsIntegrallyClosed R'_p) (_ : IsLocalRing R'_p)
              (_ : Field K'_2) (_ : Algebra R'_p K'_2) (_ : IsFractionRing R'_p K'_2)
              (_ : Algebra K₂ K'_2)
              (_ : Algebra k R'_p) (_ : Algebra A₀ R'_p) (_ : IsScalarTower k A₀ R'_p)
              (ϖ : R'_p),
              ((algebraMap K₂ K'_2).comp (algebraMap A₀ K₂) =
                 (algebraMap R'_p K'_2).comp (algebraMap A₀ R'_p) ∧
               (algebraMap R'_p K'_2 ϖ) ^ e =
                 algebraMap K₂ K'_2 (algebraMap A₀ K₂ f₀) ∧
               ∀ (E : Type u) [Field E] [Algebra K₂ E] (w_E : E),
                 w_E ^ e = algebraMap K₂ E (algebraMap A₀ K₂ f₀) →
                 ∃ ψ : K'_2 →ₐ[K₂] E, ψ (algebraMap R'_p K'_2 ϖ) = w_E) ∧
              ((∀ g : A₀, MvPolynomial.eval p g ≠ 0 → IsUnit (algebraMap A₀ R'_p g)) ∧
               (∀ r : R'_p, ∃ (g : A₀) (c : Fin e → A₀),
                 MvPolynomial.eval p g ≠ 0 ∧
                 r * algebraMap A₀ R'_p g =
                   ∑ i : Fin e, algebraMap A₀ R'_p (c i) * ϖ ^ (i : ℕ))) ∧
              (let h'_0 := algebraMap A₀ R'_p h₀
               ϖ ≠ 0 ∧ h'_0 ≠ 0 ∧
               ϖ ^ e = algebraMap A₀ R'_p f₀ ∧
               (Ideal.span {ϖ}).IsPrime ∧ (Ideal.span {h'_0}).IsPrime ∧
               h'_0 ∉ Ideal.span {ϖ} ∧ ϖ ∉ Ideal.span {h'_0} ∧
               IsLocalRing.maximalIdeal R'_p = Ideal.span {ϖ, h'_0} ∧
               Ideal.comap (algebraMap A₀ R'_p) (Ideal.span {ϖ}) = Ideal.span {f₀} ∧
               (∀ r : R'_p, ∃ c : k, r - algebraMap k R'_p c ∈ IsLocalRing.maximalIdeal R'_p)) ∧
              (∀ (q' : Ideal R'_p) [q'.IsPrime],
                 ϖ ∈ q' →
                 q' ≠ IsLocalRing.maximalIdeal R'_p →
                 q' = Ideal.span {ϖ}) :=
by
  have hEisenstein : ∀ (D : Type u) [CommRing D] [IsDomain D] (π : D),
      π ≠ 0 → (Ideal.span {π}).IsPrime → ∀ (e_exp : ℕ), 1 ≤ e_exp →
        Irreducible (Polynomial.X ^ e_exp - Polynomial.C π : Polynomial D) := by
    intro D _ _ π hπ_ne hπ_prime e_exp he_exp
    let P : Polynomial D := Polynomial.X ^ e_exp - Polynomial.C π
    have he_ne0 : e_exp ≠ 0 := by omega
    have hMon : P.Monic := Polynomial.monic_X_pow_sub_C π he_ne0
    have hDeg : P.natDegree = e_exp := Polynomial.natDegree_X_pow_sub_C
    have hEis : P.IsEisensteinAt (Ideal.span {π}) := by
      refine hMon.isEisensteinAt_of_mem_of_notMem hπ_prime.ne_top ?_ ?_
      · intro n hn
        rw [hDeg] at hn
        dsimp [P]
        rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, if_neg (by omega),
          Polynomial.coeff_C, zero_sub]
        split_ifs with hn0
        · exact neg_mem (Ideal.mem_span_singleton_self π)
        · rw [neg_zero]
          exact Ideal.zero_mem _
      · dsimp [P]
        rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, if_neg (by omega),
          Polynomial.coeff_C, if_pos rfl, zero_sub, Ideal.span_singleton_pow]
        intro hmem
        rcases Ideal.mem_span_singleton.mp hmem with ⟨r, hr⟩
        have hmul : π * (1 + π * r) = 0 := by
          calc
            π * (1 + π * r) = π + π ^ 2 * r := by ring
            _ = π + (-π) := by rw [← hr]
            _ = 0 := by ring
        have h1 : 1 + π * r = 0 := (mul_eq_zero.mp hmul).resolve_left hπ_ne
        have h1_mem : (1 : D) ∈ Ideal.span {π} := by
          refine Ideal.mem_span_singleton.mpr ⟨-r, ?_⟩
          calc
            (1 : D) = 1 + π * r - π * r := by ring
            _ = 0 - π * r := by rw [h1]
            _ = π * (-r) := by ring
        exact hπ_prime.ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
    exact hEis.irreducible hπ_prime hMon.isPrimitive (by rw [hDeg]; omega)

  have hS3 : ∀ (R K : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
      [IsIntegrallyClosed R] [Field K] [Algebra R K] [IsFractionRing R K]
      (f : R), f ≠ 0 → (Ideal.span {f}).IsPrime → ∀ (e_exp : ℕ), 1 ≤ e_exp →
        let P_R : Polynomial R := Polynomial.X ^ e_exp - Polynomial.C f
        let R' := AdjoinRoot P_R
        let ϖ : R' := AdjoinRoot.root P_R
        ∃ (_ : IsDomain R') (_ : IsNoetherianRing R') (_ : Module.Finite R R')
          (K' : Type u) (_ : Field K') (_ : Algebra R' K') (_ : IsFractionRing R' K')
          (_ : Algebra K K') (_ : Algebra R K')
          (_ : IsScalarTower R K K') (_ : IsScalarTower R R' K'),
          (algebraMap R' K' ϖ) ^ e_exp = algebraMap K K' (algebraMap R K f) ∧
          (∃ b : Module.Basis (Fin e_exp) K K',
            ∀ i : Fin e_exp, b i = (algebraMap R' K' ϖ) ^ (i : ℕ)) ∧
          (∀ (E : Type u) [Field E] [Algebra K E] (w_E : E),
            w_E ^ e_exp = algebraMap K E (algebraMap R K f) →
            ∃ ψ : K' →ₐ[K] E, ψ (algebraMap R' K' ϖ) = w_E) ∧
          (∀ r : R', ∃ c : Fin e_exp → R,
            r = ∑ i : Fin e_exp, algebraMap R R' (c i) * ϖ ^ (i : ℕ)) := by
    intro R K _ _ _ _ _ _ _ f hf_ne hf_prime e_exp he_exp
    let P_R : Polynomial R := Polynomial.X ^ e_exp - Polynomial.C f
    let R' := AdjoinRoot P_R
    let ϖ : R' := AdjoinRoot.root P_R
    have he_ne0 : e_exp ≠ 0 := by omega
    have hIrr_R : Irreducible P_R := hEisenstein R f hf_ne hf_prime e_exp he_exp
    have hMon_R : P_R.Monic := Polynomial.monic_X_pow_sub_C f he_ne0
    have hDeg_R : P_R.natDegree = e_exp := Polynomial.natDegree_X_pow_sub_C
    let P_K : Polynomial K := P_R.map (algebraMap R K)
    have hPK_eq : P_K = Polynomial.X ^ e_exp - Polynomial.C (algebraMap R K f) := by
      dsimp [P_K, P_R]
      rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
    have hIrr_K : Irreducible P_K :=
      (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hMon_R).mp hIrr_R
    have hMon_K : P_K.Monic := by
      rw [hPK_eq]
      exact Polynomial.monic_X_pow_sub_C _ he_ne0
    have hDeg_K : P_K.natDegree = e_exp := by
      rw [hPK_eq]
      exact Polynomial.natDegree_X_pow_sub_C
    letI : Fact (Irreducible P_K) := ⟨hIrr_K⟩
    let K' : Type u := AdjoinRoot P_K
    let ϖ_K : K' := AdjoinRoot.root P_K
    let pb_R := AdjoinRoot.powerBasis' hMon_R
    have hDim_R : pb_R.dim = e_exp := (AdjoinRoot.powerBasis'_dim hMon_R).trans hDeg_R
    let b_R : Module.Basis (Fin e_exp) R R' := pb_R.basis.reindex (finCongr hDim_R)
    have hb_R : ∀ i : Fin e_exp, b_R i = ϖ ^ (i : ℕ) := by
      intro i
      dsimp [b_R]
      rw [Module.Basis.reindex_apply, PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
      rfl
    let pb_K := AdjoinRoot.powerBasis' hMon_K
    have hDim_K : pb_K.dim = e_exp := (AdjoinRoot.powerBasis'_dim hMon_K).trans hDeg_K
    let b_K : Module.Basis (Fin e_exp) K K' := pb_K.basis.reindex (finCongr hDim_K)
    have hb_K : ∀ i : Fin e_exp, b_K i = ϖ_K ^ (i : ℕ) := by
      intro i
      dsimp [b_K]
      rw [Module.Basis.reindex_apply, PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
      rfl
    have hFin_R' : Module.Finite R R' := Module.Finite.of_basis b_R
    have hNoeth_R' : IsNoetherianRing R' := Ideal.Quotient.isNoetherianRing _
    have hExp_R' : ∀ r : R', ∃ c : Fin e_exp → R,
        r = ∑ i : Fin e_exp, algebraMap R R' (c i) * ϖ ^ (i : ℕ) := by
      intro r
      refine ⟨fun i => b_R.repr r i, ?_⟩
      conv_lhs => rw [← b_R.sum_repr r]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Algebra.smul_def, hb_R i]
    have hEval_PK : Polynomial.eval₂ ((algebraMap K K').comp (algebraMap R K)) ϖ_K P_R = 0 := by
      rw [← Polynomial.eval₂_map]
      exact AdjoinRoot.eval₂_root P_K
    let ι : R' →+* K' := AdjoinRoot.lift ((algebraMap K K').comp (algebraMap R K)) ϖ_K hEval_PK
    let instAlgR'K' : Algebra R' K' := ι.toAlgebra
    let instAlgRK' : Algebra R K' := ((algebraMap K K').comp (algebraMap R K)).toAlgebra
    letI : Algebra R' K' := instAlgR'K'
    have hAlgMap_comp : ∀ c : R,
        algebraMap R' K' (algebraMap R R' c) = algebraMap K K' (algebraMap R K c) := by
      intro c
      change ι (algebraMap R R' c) = _
      rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of]
      rfl
    have hι_ϖ : algebraMap R' K' ϖ = ϖ_K := AdjoinRoot.lift_root hEval_PK
    have hPow_ϖK : ϖ_K ^ e_exp = algebraMap K K' (algebraMap R K f) := by
      have h0 := hEval_PK
      dsimp [P_R] at h0
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, RingHom.comp_apply] at h0
      exact sub_eq_zero.mp h0
    have hInj_RK : Function.Injective (algebraMap R K) := IsFractionRing.injective R K
    have hInj_ι : Function.Injective (algebraMap R' K') := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      have hx_sum : x = ∑ i : Fin e_exp, algebraMap R R' (b_R.repr x i) * ϖ ^ (i : ℕ) := by
        conv_lhs => rw [← b_R.sum_repr x]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Algebra.smul_def, hb_R i]
      have hxK : ∑ i : Fin e_exp, (algebraMap R K (b_R.repr x i)) • b_K i = 0 := by
        calc
          ∑ i : Fin e_exp, (algebraMap R K (b_R.repr x i)) • b_K i =
              ∑ i : Fin e_exp,
                algebraMap R' K' (algebraMap R R' (b_R.repr x i) * ϖ ^ (i : ℕ)) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [Algebra.smul_def, hb_K i, map_mul, map_pow, hι_ϖ, hAlgMap_comp]
          _ = algebraMap R' K' x := by
            rw [← map_sum, ← hx_sum]
          _ = 0 := hx
      have hc0 : ∀ j : Fin e_exp, b_R.repr x j = 0 := by
        intro j
        have hj : b_K.repr (∑ i : Fin e_exp, (algebraMap R K (b_R.repr x i)) • b_K i) j = 0 := by
          rw [hxK, map_zero, Finsupp.zero_apply]
        rw [map_sum] at hj
        simp only [map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
          Finsupp.finset_sum_apply, Finsupp.single_apply, Finset.sum_ite_eq', Finset.mem_univ,
          ↓reduceIte] at hj
        exact hInj_RK (hj.trans (map_zero _).symm)
      rw [hx_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [hc0 i, map_zero, zero_mul]
    haveI : IsDomain R' := Function.Injective.isDomain (algebraMap R' K') hInj_ι
    have hInj_RR' : Function.Injective (algebraMap R R') := by
      intro x y hxy
      apply hInj_RK
      apply (algebraMap K K').injective
      rw [← hAlgMap_comp x, ← hAlgMap_comp y, hxy]
    have hFracR'K' : IsFractionRing R' K' :=
      ⟨fun y => IsUnit.mk0 _ fun h0 =>
          nonZeroDivisors.ne_zero y.2 (hInj_ι (h0.trans (map_zero _).symm)),
       fun z => by
         let a : Fin e_exp → K := fun i => b_K.repr z i
         let sec : Fin e_exp → R × nonZeroDivisors R :=
           fun i => IsLocalization.sec (nonZeroDivisors R) (a i)
         let D_R : nonZeroDivisors R := ∏ i : Fin e_exp, (sec i).2
         have hDR_val : (D_R : R) = ∏ i : Fin e_exp, ((sec i).2 : R) :=
           Submonoid.coe_finset_prod _ _ Finset.univ
         have hd'_ne : algebraMap R R' (D_R : R) ≠ 0 := fun h0 =>
           nonZeroDivisors.ne_zero D_R.2 (hInj_RR' (h0.trans (map_zero _).symm))
         let d' : nonZeroDivisors R' := ⟨algebraMap R R' (D_R : R), mem_nonZeroDivisors_of_ne_zero hd'_ne⟩
         let n' : R' := ∑ i : Fin e_exp,
           algebraMap R R' ((sec i).1 * ∏ j ∈ Finset.univ.erase i, ((sec j).2 : R)) * ϖ ^ (i : ℕ)
         refine ⟨⟨n', d'⟩, ?_⟩
         have hz_eq : z = ∑ i : Fin e_exp, algebraMap K K' (a i) * ϖ_K ^ (i : ℕ) := by
           conv_lhs => rw [← b_K.sum_repr z]
           refine Finset.sum_congr rfl fun i _ => ?_
           rw [Algebra.smul_def, hb_K i]
         rw [hz_eq, Finset.sum_mul]
         simp only [n', d', map_sum, map_mul, map_pow, hι_ϖ]
         refine Finset.sum_congr rfl fun i _ => ?_
         have hsec_i : a i * algebraMap R K ((sec i).2 : R) = algebraMap R K (sec i).1 :=
           IsLocalization.sec_spec (nonZeroDivisors R) (a i)
         have hprod_i : ((sec i).2 : R) * ∏ j ∈ Finset.univ.erase i, ((sec j).2 : R) = (D_R : R) := by
           rw [hDR_val]
           exact Finset.mul_prod_erase Finset.univ (fun j => ((sec j).2 : R)) (Finset.mem_univ i)
         have hscalar : algebraMap R' K' (algebraMap R R' (D_R : R)) =
             algebraMap K K' (algebraMap R K ((sec i).2 : R)) *
               algebraMap K K' (algebraMap R K (∏ j ∈ Finset.univ.erase i, ((sec j).2 : R))) := by
           rw [hAlgMap_comp, ← hprod_i, map_mul, map_mul]
         rw [hscalar, hAlgMap_comp, hAlgMap_comp]
         calc
           algebraMap K K' (a i) * ϖ_K ^ (i : ℕ) *
               (algebraMap K K' (algebraMap R K ((sec i).2 : R)) *
                 algebraMap K K' (algebraMap R K (∏ j ∈ Finset.univ.erase i, ((sec j).2 : R)))) =
               algebraMap K K' (a i * algebraMap R K ((sec i).2 : R)) *
                 algebraMap K K' (algebraMap R K (∏ j ∈ Finset.univ.erase i, ((sec j).2 : R))) *
                 ϖ_K ^ (i : ℕ) := by
             rw [map_mul]
             ring
           _ = algebraMap K K' (algebraMap R K (sec i).1) *
                 algebraMap K K' (algebraMap R K (∏ j ∈ Finset.univ.erase i, ((sec j).2 : R))) *
                 ϖ_K ^ (i : ℕ) := by
             rw [hsec_i],
       fun {x y} hxy => ⟨1, by simp [hInj_ι hxy]⟩⟩
    refine ⟨inferInstance, hNoeth_R', hFin_R', K', inferInstance, instAlgR'K', hFracR'K',
      inferInstance, instAlgRK',
      @IsScalarTower.of_algebraMap_eq' R K K' _ _ _ inferInstance inferInstance instAlgRK' rfl,
      @IsScalarTower.of_algebraMap_eq R R' K' _ _ _ inferInstance instAlgR'K' instAlgRK'
        (fun r => (hAlgMap_comp r).symm),
      ?_, ⟨b_K, ?_⟩, ?_, hExp_R'⟩
    · rw [hι_ϖ]
      exact hPow_ϖK
    · intro i
      rw [hι_ϖ]
      exact hb_K i
    · intro E _ _ w_E hw
      have hEval_E : Polynomial.eval₂ (↑(Algebra.ofId K E)) w_E P_K = 0 := by
        rw [hPK_eq, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
          Polynomial.eval₂_C]
        change w_E ^ e_exp - (Algebra.ofId K E) (algebraMap R K f) = 0
        rw [Algebra.ofId_apply, hw, sub_self]
      refine ⟨AdjoinRoot.liftAlgHom P_K (Algebra.ofId K E) w_E hEval_E, ?_⟩
      rw [hι_ϖ]
      exact AdjoinRoot.liftAlgHom_root P_K (Algebra.ofId K E) w_E hEval_E

  have hS4 : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsLocalRing R]
      (ι_k : k →+* R) (ev_R : R →+* k),
      (∀ c : k, ev_R (ι_k c) = c) →
      (∀ x : R, x ∈ IsLocalRing.maximalIdeal R ↔ ev_R x = 0) →
      ∀ (f h : R),
        f ≠ 0 → h ≠ 0 →
        (Ideal.span {f}).IsPrime → (Ideal.span {h}).IsPrime →
        h ∉ Ideal.span {f} → f ∉ Ideal.span {h} →
        IsLocalRing.maximalIdeal R = Ideal.span {f, h} →
        ∀ (e_exp : ℕ), 1 ≤ e_exp →
          let P_R : Polynomial R := Polynomial.X ^ e_exp - Polynomial.C f
          let R' := AdjoinRoot P_R
          let ϖ : R' := AdjoinRoot.root P_R
          let h' : R' := algebraMap R R' h
          ∃ (_ : IsLocalRing R'),
            (ϖ ≠ 0 ∧ h' ≠ 0 ∧ ϖ ^ e_exp = algebraMap R R' f) ∧
            ((Ideal.span {ϖ}).IsPrime ∧ (Ideal.span {h'}).IsPrime) ∧
            (h' ∉ Ideal.span {ϖ} ∧ ϖ ∉ Ideal.span {h'}) ∧
            IsLocalRing.maximalIdeal R' = Ideal.span {ϖ, h'} ∧
            Ideal.comap (algebraMap R R') (Ideal.span {ϖ}) = Ideal.span {f} ∧
            (∀ r : R', ∃ c : k, r - algebraMap R R' (ι_k c) ∈ IsLocalRing.maximalIdeal R') ∧
            (∀ (q' : Ideal R') [q'.IsPrime],
              ϖ ∈ q' → q' ≠ IsLocalRing.maximalIdeal R' → q' = Ideal.span {ϖ}) := by
    intro R _ _ _ _ ι_k ev_R hEv_c hEv_max f h hf_ne hh_ne hf_prime hh_prime
      hh_not_f hf_not_h hMax_R e_exp he_exp
    let P_R : Polynomial R := Polynomial.X ^ e_exp - Polynomial.C f
    let R' := AdjoinRoot P_R
    let ϖ : R' := AdjoinRoot.root P_R
    let h' : R' := algebraMap R R' h
    have he_ne0 : e_exp ≠ 0 := by omega
    have hMon_R : P_R.Monic := Polynomial.monic_X_pow_sub_C f he_ne0
    have hDeg_R : P_R.natDegree = e_exp := Polynomial.natDegree_X_pow_sub_C
    let pb_R := AdjoinRoot.powerBasis' hMon_R
    have hDim_R : pb_R.dim = e_exp := (AdjoinRoot.powerBasis'_dim hMon_R).trans hDeg_R
    let b : Module.Basis (Fin e_exp) R R' := pb_R.basis.reindex (finCongr hDim_R)
    have hb : ∀ i : Fin e_exp, b i = ϖ ^ (i : ℕ) := by
      intro i
      dsimp [b]
      rw [Module.Basis.reindex_apply, PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
      rfl
    letI : Module.Finite R R' := Module.Finite.of_basis b
    let i₀ : Fin e_exp := ⟨0, by omega⟩
    have hb0 : b i₀ = 1 := by
      rw [hb i₀]
      exact pow_zero ϖ
    have hRepr_alg : ∀ x : R, b.repr (algebraMap R R' x) i₀ = x := by
      intro x
      have hsmul : algebraMap R R' x = x • b i₀ := by
        rw [hb0, Algebra.smul_def, mul_one]
      rw [hsmul, map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
        Finsupp.single_eq_same]
    have hInj_R : Function.Injective (algebraMap R R') := by
      intro x y hxy
      rw [← hRepr_alg x, ← hRepr_alg y, hxy]
    have hϖ_pow : ϖ ^ e_exp = algebraMap R R' f := by
      have h0 : Polynomial.eval₂ (algebraMap R R') ϖ P_R = 0 := AdjoinRoot.eval₂_root P_R
      dsimp [P_R] at h0
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C] at h0
      exact sub_eq_zero.mp h0
    have hϖ_ne : ϖ ≠ 0 := by
      intro h0
      apply hf_ne
      apply hInj_R
      rw [← hϖ_pow, h0, zero_pow he_ne0, map_zero]
    have hh'_ne : h' ≠ 0 := fun h0 => hh_ne (hInj_R (h0.trans (map_zero _).symm))
    have hDecomp : ∀ r : R', ∃ r₁ : R', r = algebraMap R R' (b.repr r i₀) + ϖ * r₁ := by
      intro r
      refine ⟨∑ i ∈ Finset.univ.erase i₀, algebraMap R R' (b.repr r i) * ϖ ^ ((i : ℕ) - 1), ?_⟩
      conv_lhs => rw [← b.sum_repr r]
      rw [← Finset.add_sum_erase Finset.univ (fun i => (b.repr r i) • b i) (Finset.mem_univ i₀)]
      rw [hb0, Algebra.smul_def, mul_one, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun i hi => ?_
      have hi_ne : (i : ℕ) ≠ 0 := by
        have hne : i ≠ i₀ := Finset.ne_of_mem_erase hi
        intro h0
        exact hne (Fin.ext h0)
      have hpow : ϖ ^ (i : ℕ) = ϖ * ϖ ^ ((i : ℕ) - 1) := by
        conv_lhs => rw [← Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hi_ne), pow_succ']
      rw [Algebra.smul_def, hb i, hpow]
      ring

    have hPrimeIn1D : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsNoetherianRing D]
        [IsLocalRing D] (π : D),
        π ≠ 0 → IsLocalRing.maximalIdeal D = Ideal.span {π} →
        ∀ (P : Ideal D) [P.IsPrime], P ≠ Ideal.span {π} → P = ⊥ := by
      intro D _ _ _ _ π hπ_ne hMax_D P hP hP_ne
      have hP_le : P ≤ Ideal.span {π} := by
        rw [← hMax_D]
        exact IsLocalRing.le_maximalIdeal hP.ne_top
      have hπ_not_P : π ∉ P := fun hmem =>
        hP_ne (le_antisymm hP_le ((Ideal.span_singleton_le_iff_mem P).mpr hmem))
      rw [eq_bot_iff]
      intro x hxP
      have hx_pow : ∀ n : ℕ, ∃ y ∈ P, x = π ^ n * y := by
        intro n
        induction n with
        | zero => exact ⟨x, hxP, by simp⟩
        | succ n ih =>
          rcases ih with ⟨y, hyP, hxy⟩
          rcases Ideal.mem_span_singleton.mp (hP_le hyP) with ⟨z, rfl⟩
          have hzP : z ∈ P := (hP.mem_or_mem hyP).resolve_left hπ_not_P
          exact ⟨z, hzP, by rw [hxy]; ring⟩
      have hx_iInf : x ∈ ⨅ n : ℕ, (IsLocalRing.maximalIdeal D) ^ n := by
        rw [Ideal.mem_iInf]
        intro n
        rcases hx_pow n with ⟨y, _, rfl⟩
        rw [hMax_D, Ideal.span_singleton_pow]
        exact Ideal.mem_span_singleton.mpr ⟨y, rfl⟩
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _
        (IsLocalRing.maximalIdeal.isMaximal D).ne_top] at hx_iInf
      exact hx_iInf

    have hQuot1D : ∀ (u v : R) [(Ideal.span {u}).IsPrime],
        v ∉ Ideal.span {u} →
        IsLocalRing.maximalIdeal R = Ideal.span {u, v} →
        let D_u := R ⧸ Ideal.span {u}
        let q_u := Ideal.Quotient.mk (Ideal.span {u})
        ∃ (_ : IsDomain D_u) (_ : IsNoetherianRing D_u) (_ : IsLocalRing D_u),
          q_u v ≠ 0 ∧ IsLocalRing.maximalIdeal D_u = Ideal.span {q_u v} := by
      intro u v _ hv_not_u hMax_uv
      let I_u : Ideal R := Ideal.span {u}
      let D_u := R ⧸ I_u
      let q_u : R →+* D_u := Ideal.Quotient.mk I_u
      letI : IsDomain D_u := Ideal.Quotient.isDomain I_u
      letI : IsNoetherianRing D_u := Ideal.Quotient.isNoetherianRing I_u
      letI : IsLocalRing D_u := IsLocalRing.of_surjective' q_u Ideal.Quotient.mk_surjective
      have hqv_ne : q_u v ≠ 0 := fun h0 =>
        hv_not_u (Ideal.Quotient.eq_zero_iff_mem.mp h0)
      have hker_le : RingHom.ker q_u ≤ IsLocalRing.maximalIdeal R := by
        rw [Ideal.mk_ker, hMax_uv]
        exact Ideal.span_mono (by simp)
      have hMap_max : (Ideal.map q_u (IsLocalRing.maximalIdeal R)).IsMaximal :=
        @Ideal.IsMaximal.map_of_surjective_of_ker_le _ _ _ _ _ _ _ q_u
          Ideal.Quotient.mk_surjective (IsLocalRing.maximalIdeal R)
          (IsLocalRing.maximalIdeal.isMaximal R) hker_le
      have hEq_max : Ideal.map q_u (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal D_u :=
        IsLocalRing.eq_maximalIdeal hMap_max
      have hSpan_eq : Ideal.map q_u (IsLocalRing.maximalIdeal R) = Ideal.span {q_u v} := by
        rw [hMax_uv, Ideal.map_span, Set.image_pair]
        have hqu0 : q_u u = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self u)
        rw [hqu0, Ideal.span_insert_zero]
      exact ⟨inferInstance, inferInstance, inferInstance, hqv_ne, hEq_max.symm.trans hSpan_eq⟩

    let I_f : Ideal R := Ideal.span {f}
    let D_f := R ⧸ I_f
    let q_f : R →+* D_f := Ideal.Quotient.mk I_f
    obtain ⟨hDom_Df, hNoeth_Df, hLoc_Df, hqfh_ne, hMax_Df⟩ := hQuot1D f h hh_not_f hMax_R
    letI : IsDomain D_f := hDom_Df
    letI : IsNoetherianRing D_f := hNoeth_Df
    letI : IsLocalRing D_f := hLoc_Df
    have hEval_qf : Polynomial.eval₂ q_f (0 : D_f) P_R = 0 := by
      dsimp [P_R]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
        zero_pow he_ne0, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f),
        sub_self]
    let π_ϖ : R' →+* D_f := AdjoinRoot.lift q_f 0 hEval_qf
    have hSurj_π : Function.Surjective π_ϖ := by
      intro y
      rcases Ideal.Quotient.mk_surjective y with ⟨x, rfl⟩
      exact ⟨algebraMap R R' x, AdjoinRoot.lift_of hEval_qf⟩
    have hKer_π : RingHom.ker π_ϖ = Ideal.span {ϖ} := by
      apply le_antisymm
      · intro r hr
        rcases hDecomp r with ⟨r₁, hr_eq⟩
        have hqf0 : q_f (b.repr r i₀) = 0 := by
          have h0 : π_ϖ r = 0 := hr
          rw [hr_eq, map_add, map_mul] at h0
          dsimp [π_ϖ, ϖ] at h0
          rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of, AdjoinRoot.lift_root,
            zero_mul, add_zero] at h0
          exact h0
        rcases Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hqf0) with ⟨u, hu⟩
        have hpow_split : ϖ ^ e_exp = ϖ * ϖ ^ (e_exp - 1) := by
          conv_lhs => rw [← Nat.sub_add_cancel he_exp, pow_succ']
        rw [hr_eq, hu, map_mul, ← hϖ_pow, hpow_split]
        refine Ideal.mem_span_singleton.mpr ⟨ϖ ^ (e_exp - 1) * algebraMap R R' u + r₁, ?_⟩
        ring
      · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        exact AdjoinRoot.lift_root hEval_qf
    have e_Df : (R' ⧸ Ideal.span {ϖ}) ≃+* D_f :=
      (Ideal.quotEquivOfEq hKer_π.symm).trans (RingHom.quotientKerEquivOfSurjective hSurj_π)
    have hDom_Qϖ : IsDomain (R' ⧸ Ideal.span {ϖ}) := e_Df.toMulEquiv.isDomain D_f
    have hPrime_ϖ : (Ideal.span {ϖ}).IsPrime :=
      (Ideal.Quotient.isDomain_iff_prime (Ideal.span {ϖ})).mp hDom_Qϖ
    have hComap_ϖ : Ideal.comap (algebraMap R R') (Ideal.span {ϖ}) = Ideal.span {f} := by
      ext x
      rw [Ideal.mem_comap, ← hKer_π, RingHom.mem_ker]
      change π_ϖ (AdjoinRoot.of P_R x) = 0 ↔ x ∈ I_f
      rw [AdjoinRoot.lift_of, Ideal.Quotient.eq_zero_iff_mem]
    have hh'_not_ϖ : h' ∉ Ideal.span {ϖ} := by
      intro hmem
      have hh_mem : h ∈ Ideal.comap (algebraMap R R') (Ideal.span {ϖ}) := hmem
      rw [hComap_ϖ] at hh_mem
      exact hh_not_f hh_mem

    have hMax_hf : IsLocalRing.maximalIdeal R = Ideal.span {h, f} := by
      rw [hMax_R, Set.pair_comm]
    let I_h : Ideal R := Ideal.span {h}
    let D_h := R ⧸ I_h
    let q_h : R →+* D_h := Ideal.Quotient.mk I_h
    obtain ⟨hDom_Dh, hNoeth_Dh, hLoc_Dh, hqhf_ne, hMax_Dh⟩ := hQuot1D h f hf_not_h hMax_hf
    letI : IsDomain D_h := hDom_Dh
    letI : IsNoetherianRing D_h := hNoeth_Dh
    letI : IsLocalRing D_h := hLoc_Dh
    letI : IsPrincipalIdealRing D_h := IsPrincipalIdealRing.of_prime fun P hP => by
      by_cases hP_eq : P = Ideal.span {q_h f}
      · rw [hP_eq]
        exact ⟨⟨q_h f, rfl⟩⟩
      · have hbot : P = ⊥ := @hPrimeIn1D D_h _ _ _ _ (q_h f) hqhf_ne hMax_Dh P hP hP_eq
        rw [hbot]
        exact bot_isPrincipal
    letI : UniqueFactorizationMonoid D_h := PrincipalIdealRing.to_uniqueFactorizationMonoid
    have hqhf_prime : (Ideal.span {q_h f}).IsPrime := by
      rw [← hMax_Dh]
      exact (IsLocalRing.maximalIdeal.isMaximal D_h).isPrime
    have hPbar_eq : P_R.map q_h = Polynomial.X ^ e_exp - Polynomial.C (q_h f) := by
      dsimp [P_R]
      rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
    have hIrr_Pbar : Irreducible (P_R.map q_h) := by
      rw [hPbar_eq]
      exact hEisenstein D_h (q_h f) hqhf_ne hqhf_prime e_exp he_exp
    have hPrime_Pbar : (Ideal.span {P_R.map q_h}).IsPrime :=
      (Ideal.span_singleton_prime hIrr_Pbar.ne_zero).mpr
        (UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrr_Pbar)
    letI : IsDomain (Polynomial D_h ⧸ Ideal.span {P_R.map q_h}) :=
      Ideal.Quotient.isDomain (Ideal.span {P_R.map q_h})
    have hMap_Ih : Ideal.span {h'} = Ideal.map (AdjoinRoot.of P_R) I_h := by
      dsimp [I_h, h']
      rw [Ideal.map_span, Set.image_singleton, AdjoinRoot.algebraMap_eq]
    have e_Dh : (R' ⧸ Ideal.span {h'}) ≃+* (Polynomial D_h ⧸ Ideal.span {P_R.map q_h}) :=
      (Ideal.quotEquivOfEq hMap_Ih).trans (AdjoinRoot.quotAdjoinRootEquivQuotPolynomialQuot I_h P_R)
    have hDom_Qh : IsDomain (R' ⧸ Ideal.span {h'}) := e_Dh.toMulEquiv.isDomain _
    have hPrime_h' : (Ideal.span {h'}).IsPrime :=
      (Ideal.Quotient.isDomain_iff_prime (Ideal.span {h'})).mp hDom_Qh
    have hϖ_not_h' : ϖ ∉ Ideal.span {h'} := by
      intro hmem
      have hf_mem : algebraMap R R' f ∈ Ideal.span {h'} := by
        rw [← hϖ_pow]
        exact Ideal.pow_mem_of_mem _ hmem e_exp he_exp
      rcases Ideal.mem_span_singleton.mp hf_mem with ⟨s, hs⟩
      have hhs : h' * s = h • s := by
        dsimp [h']
        rw [Algebra.smul_def]
      have hrepr : f = h * b.repr s i₀ := by
        calc
          f = b.repr (algebraMap R R' f) i₀ := (hRepr_alg f).symm
          _ = b.repr (h • s) i₀ := by rw [hs, hhs]
          _ = h * b.repr s i₀ := by rw [map_smul, Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul]
      exact hf_not_h (Ideal.mem_span_singleton.mpr ⟨b.repr s i₀, hrepr⟩)

    have hev_f : ev_R f = 0 := (hEv_max f).mp (by rw [hMax_R]; exact Ideal.subset_span (by simp))
    have hev_h : ev_R h = 0 := (hEv_max h).mp (by rw [hMax_R]; exact Ideal.subset_span (by simp))
    have hEval_ev : Polynomial.eval₂ ev_R (0 : k) P_R = 0 := by
      dsimp [P_R]
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
        zero_pow he_ne0, hev_f, sub_self]
    let ev' : R' →+* k := AdjoinRoot.lift ev_R 0 hEval_ev
    have hEv'_c : ∀ c : k, ev' (algebraMap R R' (ι_k c)) = c := by
      intro c
      change ev' (AdjoinRoot.of P_R (ι_k c)) = c
      rw [AdjoinRoot.lift_of, hEv_c]
    have hSurj_ev' : Function.Surjective ev' := fun c => ⟨algebraMap R R' (ι_k c), hEv'_c c⟩
    have hKer_ev' : RingHom.ker ev' = Ideal.span {ϖ, h'} := by
      apply le_antisymm
      · intro r hr
        rcases hDecomp r with ⟨r₁, hr_eq⟩
        have hev_c0 : ev_R (b.repr r i₀) = 0 := by
          have h0 : ev' r = 0 := hr
          rw [hr_eq, map_add, map_mul] at h0
          dsimp [ev', ϖ] at h0
          rw [AdjoinRoot.algebraMap_eq, AdjoinRoot.lift_of, AdjoinRoot.lift_root,
            zero_mul, add_zero] at h0
          exact h0
        have hc0_mem : b.repr r i₀ ∈ Ideal.span {f, h} := by
          rw [← hMax_R, hEv_max]
          exact hev_c0
        rcases Ideal.mem_span_pair.mp hc0_mem with ⟨a, d, had⟩
        have hpow_split : ϖ ^ e_exp = ϖ * ϖ ^ (e_exp - 1) := by
          conv_lhs => rw [← Nat.sub_add_cancel he_exp, pow_succ']
        rw [hr_eq, ← had, map_add, map_mul, map_mul, ← hϖ_pow, hpow_split]
        refine Ideal.mem_span_pair.mpr
          ⟨algebraMap R R' a * ϖ ^ (e_exp - 1) + r₁, algebraMap R R' d, ?_⟩
        dsimp [h']
        ring
      · rw [Ideal.span_le]
        intro x hx
        rcases Set.mem_insert_iff.mp hx with rfl | hx'
        · rw [SetLike.mem_coe, RingHom.mem_ker]
          exact AdjoinRoot.lift_root hEval_ev
        · rw [Set.mem_singleton_iff.mp hx', SetLike.mem_coe, RingHom.mem_ker]
          change ev' (AdjoinRoot.of P_R h) = 0
          rw [AdjoinRoot.lift_of, hev_h]
    have hMax_span : (Ideal.span {ϖ, h'}).IsMaximal := by
      rw [← hKer_ev']
      exact RingHom.ker_isMaximal_of_surjective ev' hSurj_ev'
    letI : Algebra.IsIntegral R R' := Algebra.IsIntegral.of_finite R R'
    have hUnique_max : ∀ M : Ideal R', M.IsMaximal → M = Ideal.span {ϖ, h'} := by
      intro M hM
      letI : M.IsMaximal := hM
      have hUnder_max : (Ideal.comap (algebraMap R R') M).IsMaximal := by
        rw [← Ideal.under_def R M]
        exact Ideal.IsMaximal.under R M
      have hUnder_eq : Ideal.comap (algebraMap R R') M = Ideal.span {f, h} :=
        (IsLocalRing.eq_maximalIdeal hUnder_max).trans hMax_R
      have hfM : algebraMap R R' f ∈ M := by
        have : f ∈ Ideal.comap (algebraMap R R') M := by
          rw [hUnder_eq]
          exact Ideal.subset_span (by simp)
        exact this
      have hϖM : ϖ ∈ M := by
        rw [← hϖ_pow] at hfM
        exact hM.isPrime.mem_of_pow_mem e_exp hfM
      have hh'M : h' ∈ M := by
        have : h ∈ Ideal.comap (algebraMap R R') M := by
          rw [hUnder_eq]
          exact Ideal.subset_span (by simp)
        exact this
      have hle : Ideal.span {ϖ, h'} ≤ M := by
        rw [Ideal.span_le]
        intro x hx
        rcases Set.mem_insert_iff.mp hx with rfl | hx'
        · exact hϖM
        · rw [Set.mem_singleton_iff.mp hx']
          exact hh'M
      exact (hMax_span.eq_of_le hM.ne_top hle).symm
    letI : IsLocalRing R' :=
      IsLocalRing.of_unique_max_ideal ⟨Ideal.span {ϖ, h'}, hMax_span, hUnique_max⟩
    have hMax_R' : IsLocalRing.maximalIdeal R' = Ideal.span {ϖ, h'} :=
      (IsLocalRing.eq_maximalIdeal hMax_span).symm
    refine ⟨inferInstance, ⟨hϖ_ne, hh'_ne, hϖ_pow⟩, ⟨hPrime_ϖ, hPrime_h'⟩,
      ⟨hh'_not_ϖ, hϖ_not_h'⟩, hMax_R', hComap_ϖ, ?_, ?_⟩
    · intro r
      refine ⟨ev' r, ?_⟩
      rw [hMax_R', ← hKer_ev', RingHom.mem_ker, map_sub, hEv'_c, sub_self]
    · intro q' hq'_prime hϖ_q' hq'_ne_max
      have hKer_le_q' : RingHom.ker π_ϖ ≤ q' := by
        rw [hKer_π, Ideal.span_singleton_le_iff_mem]
        exact hϖ_q'
      let P : Ideal D_f := Ideal.map π_ϖ q'
      haveI : P.IsPrime := Ideal.map_isPrime_of_surjective hSurj_π hKer_le_q'
      have hComap_P : Ideal.comap π_ϖ P = q' := by
        dsimp [P]
        rw [Ideal.comap_map_of_surjective' π_ϖ hSurj_π q', sup_eq_left.mpr hKer_le_q']
      have hP_ne_max : P ≠ Ideal.span {q_f h} := by
        intro hP_eq
        apply hq'_ne_max
        have hh'_q' : h' ∈ q' := by
          rw [← hComap_P, Ideal.mem_comap, hP_eq]
          change π_ϖ (AdjoinRoot.of P_R h) ∈ Ideal.span {q_f h}
          rw [AdjoinRoot.lift_of]
          exact Ideal.mem_span_singleton_self (q_f h)
        have hmax_le_q' : IsLocalRing.maximalIdeal R' ≤ q' := by
          rw [hMax_R', Ideal.span_le]
          intro x hx
          rcases Set.mem_insert_iff.mp hx with rfl | hx'
          · exact hϖ_q'
          · rw [Set.mem_singleton_iff.mp hx']
            exact hh'_q'
        exact le_antisymm (IsLocalRing.le_maximalIdeal hq'_prime.ne_top) hmax_le_q'
      have hP_bot : P = ⊥ := hPrimeIn1D D_f (q_f h) hqfh_ne hMax_Df P hP_ne_max
      rw [← hComap_P, hP_bot]
      exact hKer_π

  have hS5 : ∀ (R K R' K' : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
      [Field K] [Algebra R K] [IsFractionRing R K]
      [CommRing R'] [IsDomain R'] [Algebra R R'] [Module.Finite R R']
      [Field K'] [Algebra R' K'] [IsFractionRing R' K']
      [Algebra K K'] [Algebra R K'] [IsScalarTower R K K'] [IsScalarTower R R' K']
      (f : R) (ϖ : R') (e_exp : ℕ),
      1 ≤ e_exp → ϖ ≠ 0 → IsUnit (e_exp : R) →
      ϖ ^ e_exp = algebraMap R R' f →
      (Ideal.span {ϖ}).IsPrime →
      (∃ b : Module.Basis (Fin e_exp) K K',
        ∀ i : Fin e_exp, b i = (algebraMap R' K' ϖ) ^ (i : ℕ)) →
      IsIntegrallyClosed R' := by
    intro R K R' K' _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ f ϖ e_exp
      he_exp hϖ_ne he_unit hϖ_pow hϖ_prime ⟨b, hb⟩
    let ϖ_K : K' := algebraMap R' K' ϖ
    let f_K : K := algebraMap R K f
    have hInj_R' : Function.Injective (algebraMap R' K') := IsFractionRing.injective R' K'
    have hϖK_ne : ϖ_K ≠ 0 := fun h0 => hϖ_ne (hInj_R' (h0.trans (map_zero _).symm))
    letI : FiniteDimensional K K' := Module.Finite.of_basis b
    letI : Module.Free K K' := Module.Free.of_basis b
    have hFinrank : Module.finrank K K' = e_exp := by
      rw [Module.finrank_eq_card_basis b, Fintype.card_fin]
    have hϖK_pow : ϖ_K ^ e_exp = f_K • (1 : K') := by
      dsimp [ϖ_K, f_K]
      rw [← map_pow, hϖ_pow, ← IsScalarTower.algebraMap_apply R R' K',
        IsScalarTower.algebraMap_apply R K K', Algebra.algebraMap_eq_smul_one]
    have hTr_one : Algebra.trace K K' 1 = (e_exp : K) := by
      have h1 : (1 : K') = algebraMap K K' 1 := (map_one _).symm
      rw [h1, Algebra.trace_algebraMap, hFinrank, nsmul_one]
    have hTr_pow : ∀ j : ℕ, 1 ≤ j → j < e_exp → Algebra.trace K K' (ϖ_K ^ j) = 0 := by
      intro j hj1 hje
      rw [Algebra.trace_eq_matrix_trace b (ϖ_K ^ j), Matrix.trace]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [Matrix.diag_apply, Algebra.leftMulMatrix_eq_repr_mul, hb i, ← pow_add]
      by_cases hlt : j + (i : ℕ) < e_exp
      · let m : Fin e_exp := ⟨j + (i : ℕ), hlt⟩
        have hm_ne : i ≠ m := by
          intro heq
          have : (i : ℕ) = j + (i : ℕ) := congrArg Fin.val heq
          omega
        have hbm : ϖ_K ^ (j + (i : ℕ)) = b m := (hb m).symm
        rw [hbm, Module.Basis.repr_self, Finsupp.single_apply, if_neg hm_ne.symm]
      · let m : Fin e_exp := ⟨j + (i : ℕ) - e_exp, by omega⟩
        have hm_ne : i ≠ m := by
          intro heq
          have : (i : ℕ) = j + (i : ℕ) - e_exp := congrArg Fin.val heq
          omega
        have hexp : j + (i : ℕ) = e_exp + (m : ℕ) := by
          dsimp [m]
          omega
        have hbm : ϖ_K ^ (j + (i : ℕ)) = f_K • b m := by
          rw [hexp, pow_add, hϖK_pow, hb m, smul_mul_assoc, one_mul]
        rw [hbm, map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
          Finsupp.single_apply, if_neg hm_ne.symm]

    rw [isIntegrallyClosed_iff K']
    intro z hz
    letI : Algebra.IsIntegral R R' := Algebra.IsIntegral.of_finite R R'
    have hz_R : IsIntegral R z := isIntegral_trans z hz
    have hϖK_R : IsIntegral R ϖ_K :=
      isIntegral_trans ϖ_K (isIntegral_algebraMap (x := ϖ))
    have hTr_mem : ∀ m : ℕ, ∃ t : R, algebraMap R K t = Algebra.trace K K' (z * ϖ_K ^ m) := by
      intro m
      have hInt_m : IsIntegral R (z * ϖ_K ^ m) := hz_R.mul (hϖK_R.pow m)
      exact (isIntegrallyClosed_iff K).mp inferInstance (Algebra.isIntegral_trace hInt_m)
    rcases he_unit with ⟨u_e, hu_e⟩
    have hue_inv : (e_exp : K) * algebraMap R K (↑u_e⁻¹ : R) = 1 := by
      have heK : (e_exp : K) = algebraMap R K (u_e : R) := by
        rw [hu_e, map_natCast]
      rw [heK, ← map_mul, Units.mul_inv, map_one]
    let a : Fin e_exp → K := fun r => b.repr z r
    have hz_sum : z = ∑ r : Fin e_exp, (a r) • b r := (b.sum_repr z).symm
    have hCoeff_mem : ∀ r : Fin e_exp, ∃ c_r : R, algebraMap R K c_r = f_K * a r := by
      intro r
      by_cases hr0 : (r : ℕ) = 0
      · rcases hTr_mem 0 with ⟨t₀, ht₀⟩
        rw [pow_zero, mul_one, hz_sum, map_sum] at ht₀
        have hsum_eq : (∑ j : Fin e_exp, Algebra.trace K K' ((a j) • b j)) =
            a r * (e_exp : K) := by
          rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ r)]
          have hr_term : Algebra.trace K K' ((a r) • b r) = a r * (e_exp : K) := by
            rw [LinearMap.map_smul, smul_eq_mul, hb r, hr0, pow_zero, hTr_one]
          have hrest : ∑ j ∈ Finset.univ.erase r, Algebra.trace K K' ((a j) • b j) = 0 := by
            refine Finset.sum_eq_zero fun j hj => ?_
            have hj_ne : j ≠ r := Finset.ne_of_mem_erase hj
            have hj_pos : 1 ≤ (j : ℕ) := by
              by_contra hle
              have hj0 : (j : ℕ) = 0 := by omega
              exact hj_ne (Fin.ext (hj0.trans hr0.symm))
            rw [LinearMap.map_smul, smul_eq_mul, hb j, hTr_pow (j : ℕ) hj_pos j.2, mul_zero]
          rw [hr_term, hrest, add_zero]
        rw [hsum_eq] at ht₀
        refine ⟨f * (t₀ * ↑u_e⁻¹), ?_⟩
        rw [map_mul, map_mul, ht₀]
        calc
          f_K * (a r * (e_exp : K) * algebraMap R K (↑u_e⁻¹ : R)) =
              f_K * a r * ((e_exp : K) * algebraMap R K (↑u_e⁻¹ : R)) := by ring
          _ = f_K * a r := by rw [hue_inv, mul_one]
      · have hr_pos : 1 ≤ (r : ℕ) := by omega
        rcases hTr_mem (e_exp - (r : ℕ)) with ⟨t_r, ht_r⟩
        have hmul_sum : z * ϖ_K ^ (e_exp - (r : ℕ)) =
            ∑ j : Fin e_exp, (a j) • ϖ_K ^ ((j : ℕ) + (e_exp - (r : ℕ))) := by
          conv_lhs => rw [hz_sum, Finset.sum_mul]
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [hb j, smul_mul_assoc, ← pow_add]
        rw [hmul_sum, map_sum] at ht_r
        have hsum_eq : (∑ j : Fin e_exp,
              Algebra.trace K K' ((a j) • ϖ_K ^ ((j : ℕ) + (e_exp - (r : ℕ))))) =
            f_K * a r * (e_exp : K) := by
          rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ r)]
          have hr_term : Algebra.trace K K' ((a r) • ϖ_K ^ ((r : ℕ) + (e_exp - (r : ℕ)))) =
              f_K * a r * (e_exp : K) := by
            have hexp : (r : ℕ) + (e_exp - (r : ℕ)) = e_exp := by omega
            rw [hexp, hϖK_pow, LinearMap.map_smul, LinearMap.map_smul, hTr_one,
              smul_eq_mul, smul_eq_mul]
            ring
          have hrest : ∑ j ∈ Finset.univ.erase r,
              Algebra.trace K K' ((a j) • ϖ_K ^ ((j : ℕ) + (e_exp - (r : ℕ)))) = 0 := by
            refine Finset.sum_eq_zero fun j hj => ?_
            have hj_ne : (j : ℕ) ≠ (r : ℕ) := fun heq =>
              Finset.ne_of_mem_erase hj (Fin.ext heq)
            rw [LinearMap.map_smul, smul_eq_mul]
            by_cases hlt : (j : ℕ) < (r : ℕ)
            · rw [hTr_pow _ (by omega) (by omega), mul_zero]
            · have hexp : (j : ℕ) + (e_exp - (r : ℕ)) = e_exp + ((j : ℕ) - (r : ℕ)) := by omega
              rw [hexp, pow_add, hϖK_pow, smul_mul_assoc, one_mul, LinearMap.map_smul,
                smul_eq_mul, hTr_pow _ (by omega) (by omega), mul_zero, mul_zero]
          rw [hr_term, hrest, add_zero]
        rw [hsum_eq] at ht_r
        refine ⟨t_r * ↑u_e⁻¹, ?_⟩
        rw [map_mul, ht_r]
        calc
          f_K * a r * (e_exp : K) * algebraMap R K (↑u_e⁻¹ : R) =
              f_K * a r * ((e_exp : K) * algebraMap R K (↑u_e⁻¹ : R)) := by ring
          _ = f_K * a r := by rw [hue_inv, mul_one]

    have hPow_mem : ∃ u₀ : R', algebraMap R' K' u₀ = ϖ_K ^ e_exp * z := by
      choose c hc using hCoeff_mem
      refine ⟨∑ r : Fin e_exp, algebraMap R R' (c r) * ϖ ^ (r : ℕ), ?_⟩
      rw [hϖK_pow, smul_mul_assoc, one_mul, hz_sum, Finset.smul_sum, map_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [map_mul, map_pow, ← IsScalarTower.algebraMap_apply R R' K',
        IsScalarTower.algebraMap_apply R K K', hc r, hb r, smul_smul, Algebra.smul_def]

    rcases hz with ⟨P, hP_mon, hP_eval⟩
    let n := P.natDegree
    have hn_pos : 1 ≤ n := by
      by_contra h0
      have hn0 : P.natDegree = 0 := by omega
      have hP1 : P = 1 := Polynomial.eq_one_of_monic_natDegree_zero hP_mon hn0
      rw [hP1, Polynomial.eval₂_one] at hP_eval
      exact one_ne_zero hP_eval
    have hP_sum : (∑ j ∈ Finset.range n, algebraMap R' K' (P.coeff j) * z ^ j) + z ^ n = 0 := by
      have hsum := Polynomial.sum_over_range' P
        (f := fun j a => algebraMap R' K' a * z ^ j)
        (fun j => by rw [map_zero, zero_mul]) (n + 1) (Nat.lt_succ_self n)
      rw [Polynomial.eval₂_eq_sum, hsum, Finset.sum_range_succ] at hP_eval
      have hlead : P.coeff n = 1 := hP_mon.coeff_natDegree
      rw [hlead, map_one, one_mul] at hP_eval
      exact hP_eval

    have hStep : ∀ (m : ℕ) (u : R'),
        algebraMap R' K' u = ϖ_K ^ (m + 1) * z →
        ∃ v : R', algebraMap R' K' v = ϖ_K ^ m * z := by
      intro m u hu
      let q : R' := ϖ ^ (m + 1)
      let q_K : K' := algebraMap R' K' q
      have hqK_eq : q_K = ϖ_K ^ (m + 1) := map_pow (algebraMap R' K') ϖ (m + 1)
      have hqz : q_K * z = algebraMap R' K' u := by
        rw [hqK_eq, ← hu]
      have hScaled : algebraMap R' K'
          ((∑ j ∈ Finset.range n, P.coeff j * u ^ j * q ^ (n - j)) + u ^ n) = 0 := by
        calc
          algebraMap R' K' ((∑ j ∈ Finset.range n, P.coeff j * u ^ j * q ^ (n - j)) + u ^ n) =
              (∑ j ∈ Finset.range n,
                algebraMap R' K' (P.coeff j) * (q_K * z) ^ j * q_K ^ (n - j)) +
                (q_K * z) ^ n := by
            rw [map_add, map_sum, map_pow, ← hqz]
            congr 1
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [map_mul, map_mul, map_pow, map_pow, ← hqz]
          _ = ((∑ j ∈ Finset.range n, algebraMap R' K' (P.coeff j) * z ^ j) + z ^ n) *
                q_K ^ n := by
            rw [add_mul, Finset.sum_mul, mul_pow, mul_comm (z ^ n) (q_K ^ n)]
            congr 1
            refine Finset.sum_congr rfl fun j hj => ?_
            have hj_lt : j < n := Finset.mem_range.mp hj
            have hpow_n : q_K ^ n = q_K ^ j * q_K ^ (n - j) := by
              rw [← pow_add, Nat.add_sub_of_le hj_lt.le]
            rw [hpow_n, mul_pow]
            ring
          _ = 0 := by rw [hP_sum, zero_mul]
      have hR'_eq : u ^ n = -(∑ j ∈ Finset.range n, P.coeff j * u ^ j * q ^ (n - j)) := by
        have h0 := hInj_R' (hScaled.trans (map_zero _).symm)
        calc
          u ^ n = ((∑ j ∈ Finset.range n, P.coeff j * u ^ j * q ^ (n - j)) + u ^ n) -
              (∑ j ∈ Finset.range n, P.coeff j * u ^ j * q ^ (n - j)) := by ring
          _ = 0 - (∑ j ∈ Finset.range n, P.coeff j * u ^ j * q ^ (n - j)) := by rw [h0]
          _ = -(∑ j ∈ Finset.range n, P.coeff j * u ^ j * q ^ (n - j)) := by ring
      have hun_mem : u ^ n ∈ Ideal.span {ϖ} := by
        rw [hR'_eq]
        refine neg_mem (Ideal.sum_mem _ fun j hj => ?_)
        have hj_lt : j < n := Finset.mem_range.mp hj
        have hq_mem : q ∈ Ideal.span {ϖ} := by
          dsimp [q]
          rw [pow_succ']
          exact Ideal.mem_span_singleton.mpr ⟨ϖ ^ m, rfl⟩
        have hq_pow_mem : q ^ (n - j) ∈ Ideal.span {ϖ} :=
          Ideal.pow_mem_of_mem _ hq_mem (n - j) (by omega)
        exact Ideal.mul_mem_left _ _ hq_pow_mem
      have hu_mem : u ∈ Ideal.span {ϖ} := hϖ_prime.mem_of_pow_mem n hun_mem
      rcases Ideal.mem_span_singleton.mp hu_mem with ⟨v, rfl⟩
      refine ⟨v, ?_⟩
      apply mul_left_cancel₀ hϖK_ne
      calc
        ϖ_K * algebraMap R' K' v = algebraMap R' K' (ϖ * v) := (map_mul _ _ _).symm
        _ = ϖ_K ^ (m + 1) * z := hu
        _ = ϖ_K * (ϖ_K ^ m * z) := by rw [pow_succ']; ring

    have hCancel : ∀ step : ℕ, step ≤ e_exp →
        ∃ u : R', algebraMap R' K' u = ϖ_K ^ (e_exp - step) * z := by
      intro step
      induction step with
      | zero =>
        intro _
        rw [Nat.sub_zero]
        exact hPow_mem
      | succ step ih =>
        intro hle
        rcases ih (by omega) with ⟨u, hu⟩
        have hexp : e_exp - step = (e_exp - (step + 1)) + 1 := by omega
        rw [hexp] at hu
        exact hStep (e_exp - (step + 1)) u hu
    rcases hCancel e_exp (le_refl e_exp) with ⟨v, hv⟩
    rw [Nat.sub_self, pow_zero, one_mul] at hv
    exact ⟨v, hv⟩

  intro A₀ K₂ h₀ f₀ hIrr_h₀ hIrr_f₀ p hp_h₀ hp_f₀ 𝔪_p _ h𝔪_p hReg e he he_ne
  let 𝒪_p := Localization.AtPrime 𝔪_p
  let f_p := algebraMap A₀ 𝒪_p f₀
  let h_p := algebraMap A₀ 𝒪_p h₀
  rcases hReg with ⟨hf_ne, hh_ne, hf_prime, hh_prime, hh_not_f, hf_not_h, hMax_𝒪⟩

  have hSub : 𝔪_p.primeCompl ≤ nonZeroDivisors A₀ := by
    intro s hs
    refine mem_nonZeroDivisors_of_ne_zero ?_
    intro hs0
    subst hs0
    exact hs 𝔪_p.zero_mem
  haveI : IsDomain 𝒪_p := IsLocalization.isDomain_localization hSub
  haveI : IsNoetherianRing 𝒪_p := IsLocalization.isNoetherianRing 𝔪_p.primeCompl 𝒪_p inferInstance
  have hUFD_A₀ : UniqueFactorizationMonoid A₀ := MvPolynomial.uniqueFactorizationMonoid (Fin 2)
  have hIC_A₀ : IsIntegrallyClosed A₀ :=
    @UniqueFactorizationMonoid.instIsIntegrallyClosed A₀ _ inferInstance hUFD_A₀
  haveI : IsIntegrallyClosed 𝒪_p :=
    @isIntegrallyClosed_of_isLocalization A₀ 𝒪_p _ _ _ hIC_A₀ inferInstance 𝔪_p.primeCompl hSub _
  let instAlg𝒪K : Algebra 𝒪_p K₂ :=
    IsLocalization.localizationAlgebraOfSubmonoidLe 𝒪_p K₂ 𝔪_p.primeCompl (nonZeroDivisors A₀) hSub
  letI : Algebra 𝒪_p K₂ := instAlg𝒪K
  letI : IsScalarTower A₀ 𝒪_p K₂ :=
    IsLocalization.localization_isScalarTower_of_submonoid_le 𝒪_p K₂
      𝔪_p.primeCompl (nonZeroDivisors A₀) hSub
  letI : IsFractionRing 𝒪_p K₂ :=
    IsFractionRing.isFractionRing_of_isLocalization 𝔪_p.primeCompl 𝒪_p K₂ hSub

  let φ_p : A₀ →+* k := MvPolynomial.eval p
  have hUnits_p : ∀ y : 𝔪_p.primeCompl, IsUnit (φ_p y) := by
    intro y
    refine IsUnit.mk0 (φ_p y) ?_
    intro h0
    exact y.2 ((h𝔪_p y.1).mpr h0)
  let ev_p : 𝒪_p →+* k := IsLocalization.lift hUnits_p
  let ι_k : k →+* 𝒪_p := (algebraMap A₀ 𝒪_p).comp (algebraMap k A₀)
  have hEv_c : ∀ c : k, ev_p (ι_k c) = c := by
    intro c
    dsimp [ev_p, ι_k]
    rw [IsLocalization.lift_eq]
    change MvPolynomial.eval p (algebraMap k A₀ c) = c
    rw [MvPolynomial.algebraMap_eq, MvPolynomial.eval_C]
  have hEv_surj : Function.Surjective ev_p := fun c => ⟨ι_k c, hEv_c c⟩
  have hKer_ev : RingHom.ker ev_p = IsLocalRing.maximalIdeal 𝒪_p :=
    IsLocalRing.ker_eq_maximalIdeal ev_p hEv_surj
  have hEv_max : ∀ x : 𝒪_p, x ∈ IsLocalRing.maximalIdeal 𝒪_p ↔ ev_p x = 0 := by
    intro x
    rw [← hKer_ev, RingHom.mem_ker]
  have hUnit_e : IsUnit (e : 𝒪_p) := by
    by_contra hnu
    have hmem : (e : 𝒪_p) ∈ IsLocalRing.maximalIdeal 𝒪_p :=
      (IsLocalRing.mem_maximalIdeal (e : 𝒪_p)).mpr hnu
    have he0 : ev_p (e : 𝒪_p) = 0 := (hEv_max (e : 𝒪_p)).mp hmem
    rw [map_natCast] at he0
    exact he_ne he0
  have hUnits_𝒪 : ∀ g : A₀, MvPolynomial.eval p g ≠ 0 → IsUnit (algebraMap A₀ 𝒪_p g) := by
    intro g hg
    have hg_compl : g ∈ 𝔪_p.primeCompl := fun hmem => hg ((h𝔪_p g).mp hmem)
    exact IsLocalization.map_units 𝒪_p ⟨g, hg_compl⟩
  have hComap_f₀ : Ideal.comap (algebraMap A₀ 𝒪_p) (Ideal.span {f_p}) = Ideal.span {f₀} := by
    apply le_antisymm
    · intro a ha
      rcases Ideal.mem_span_singleton.mp ha with ⟨q, hq⟩
      rcases IsLocalization.surj 𝔪_p.primeCompl q with ⟨⟨b, s⟩, hbs⟩
      have hInj_A₀ : Function.Injective (algebraMap A₀ 𝒪_p) :=
        IsLocalization.injective 𝒪_p hSub
      have heq_A₀ : a * (s : A₀) = f₀ * b := by
        apply hInj_A₀
        calc
          algebraMap A₀ 𝒪_p (a * (s : A₀)) =
              algebraMap A₀ 𝒪_p a * algebraMap A₀ 𝒪_p (s : A₀) := map_mul _ _ _
          _ = (f_p * q) * algebraMap A₀ 𝒪_p (s : A₀) := by rw [hq]
          _ = f_p * (q * algebraMap A₀ 𝒪_p (s : A₀)) := by ring
          _ = f_p * algebraMap A₀ 𝒪_p b := by rw [hbs]
          _ = algebraMap A₀ 𝒪_p (f₀ * b) := (map_mul _ _ _).symm
      have hf₀_prime : (Ideal.span {f₀}).IsPrime :=
        (Ideal.span_singleton_prime hIrr_f₀.ne_zero).mpr
          (UniqueFactorizationMonoid.irreducible_iff_prime.mp hIrr_f₀)
      have hprod_mem : a * (s : A₀) ∈ Ideal.span {f₀} :=
        Ideal.mem_span_singleton.mpr ⟨b, heq_A₀⟩
      have hs_not_f₀ : (s : A₀) ∉ Ideal.span {f₀} := by
        intro hsf
        rcases Ideal.mem_span_singleton.mp hsf with ⟨t, ht⟩
        apply s.2
        exact (h𝔪_p (s : A₀)).mpr (by rw [ht, map_mul, hp_f₀, zero_mul])
      exact (hf₀_prime.mem_or_mem hprod_mem).resolve_right hs_not_f₀
    · rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      exact Ideal.mem_span_singleton_self f_p
  have hClearDenom : ∀ c_p : Fin e → 𝒪_p,
      ∃ (g : A₀) (c : Fin e → A₀),
        MvPolynomial.eval p g ≠ 0 ∧
        ∀ i : Fin e, c_p i * algebraMap A₀ 𝒪_p g = algebraMap A₀ 𝒪_p (c i) := by
    intro c_p
    let sec : Fin e → A₀ × 𝔪_p.primeCompl := fun i => IsLocalization.sec 𝔪_p.primeCompl (c_p i)
    let g : A₀ := ∏ i : Fin e, ((sec i).2 : A₀)
    let c : Fin e → A₀ := fun i => (sec i).1 * ∏ j ∈ Finset.univ.erase i, ((sec j).2 : A₀)
    refine ⟨g, c, ?_, ?_⟩
    · rw [show g = ∏ i : Fin e, ((sec i).2 : A₀) from rfl, map_prod, Finset.prod_ne_zero_iff]
      intro i _ h0
      exact (sec i).2.2 ((h𝔪_p ((sec i).2 : A₀)).mpr h0)
    · intro i
      have hsec_i : c_p i * algebraMap A₀ 𝒪_p ((sec i).2 : A₀) = algebraMap A₀ 𝒪_p (sec i).1 :=
        IsLocalization.sec_spec 𝔪_p.primeCompl (c_p i)
      have hg_split : g = ((sec i).2 : A₀) * ∏ j ∈ Finset.univ.erase i, ((sec j).2 : A₀) := by
        dsimp [g]
        exact (Finset.mul_prod_erase Finset.univ (fun j => ((sec j).2 : A₀)) (Finset.mem_univ i)).symm
      calc
        c_p i * algebraMap A₀ 𝒪_p g =
            (c_p i * algebraMap A₀ 𝒪_p ((sec i).2 : A₀)) *
              algebraMap A₀ 𝒪_p (∏ j ∈ Finset.univ.erase i, ((sec j).2 : A₀)) := by
          rw [hg_split, map_mul]
          ring
        _ = algebraMap A₀ 𝒪_p (c i) := by
          rw [hsec_i, ← map_mul]

  let P_R : Polynomial 𝒪_p := Polynomial.X ^ e - Polynomial.C f_p
  let R'_p : Type u := AdjoinRoot P_R
  let ϖ : R'_p := AdjoinRoot.root P_R

  obtain ⟨hDom_R', hNoeth_R', hFin_R', K'_2, hField_K', hAlgR'K', hFracR'K',
      hAlgK₂K', hAlg𝒪K', hST𝒪K₂K', hST𝒪R'K',
      hPow_K', hBasis_K', hLift_K', hExp_R'⟩ :=
    hS3 𝒪_p K₂ f_p hf_ne hf_prime e he
  letI : IsDomain R'_p := hDom_R'
  letI : IsNoetherianRing R'_p := hNoeth_R'
  letI : Module.Finite 𝒪_p R'_p := hFin_R'
  letI : Field K'_2 := hField_K'
  letI : Algebra R'_p K'_2 := hAlgR'K'
  letI : IsFractionRing R'_p K'_2 := hFracR'K'
  letI : Algebra K₂ K'_2 := hAlgK₂K'
  letI : Algebra 𝒪_p K'_2 := hAlg𝒪K'
  letI : IsScalarTower 𝒪_p K₂ K'_2 := hST𝒪K₂K'
  letI : IsScalarTower 𝒪_p R'_p K'_2 := hST𝒪R'K'

  obtain ⟨hLoc_R', ⟨hϖ_ne, hh'_ne, hϖ_pow⟩, ⟨hPrime_ϖ, hPrime_h'⟩,
      ⟨hh'_not_ϖ, hϖ_not_h'⟩, hMax_R', hComap_R, hRes_R', hHeight1⟩ :=
    hS4 𝒪_p ι_k ev_p hEv_c hEv_max f_p h_p hf_ne hh_ne hf_prime hh_prime
      hh_not_f hf_not_h hMax_𝒪 e he
  letI : IsLocalRing R'_p := hLoc_R'

  have hIC_R' : IsIntegrallyClosed R'_p :=
    hS5 𝒪_p K₂ R'_p K'_2 f_p ϖ e he hϖ_ne hUnit_e hϖ_pow hPrime_ϖ hBasis_K'
  letI : IsIntegrallyClosed R'_p := hIC_R'

  let instAA₀R' : Algebra A₀ R'_p := ((algebraMap 𝒪_p R'_p).comp (algebraMap A₀ 𝒪_p)).toAlgebra
  let instAkR' : Algebra k R'_p := ((algebraMap 𝒪_p R'_p).comp ι_k).toAlgebra

  have hf_K₂ : algebraMap A₀ K₂ f₀ = algebraMap 𝒪_p K₂ f_p :=
    IsScalarTower.algebraMap_apply A₀ 𝒪_p K₂ f₀

  refine ⟨R'_p, K'_2, inferInstance, hDom_R', hNoeth_R', hIC_R', hLoc_R',
    hField_K', hAlgR'K', hFracR'K', hAlgK₂K', instAkR', instAA₀R',
    @IsScalarTower.of_algebraMap_eq' k A₀ R'_p _ _ _ inferInstance instAA₀R' instAkR'
      (RingHom.ext fun _ => rfl),
    ϖ, ⟨?_, ?_, ?_⟩, ⟨?_, ?_⟩, ?_, hHeight1⟩
  · refine RingHom.ext fun a => ?_
    simp only [RingHom.comp_apply]
    rw [IsScalarTower.algebraMap_apply A₀ 𝒪_p K₂ a,
      ← IsScalarTower.algebraMap_apply 𝒪_p K₂ K'_2,
      IsScalarTower.algebraMap_apply 𝒪_p R'_p K'_2]
    rfl
  · rw [hf_K₂]
    exact hPow_K'
  · intro E _ _ w_E hw
    rw [hf_K₂] at hw
    exact hLift_K' E w_E hw
  · intro g hg
    exact RingHom.isUnit_map (algebraMap 𝒪_p R'_p) (hUnits_𝒪 g hg)
  · intro r
    rcases hExp_R' r with ⟨c_p, hr⟩
    rcases hClearDenom c_p with ⟨g, c, hg, hc⟩
    refine ⟨g, c, hg, ?_⟩
    change r * algebraMap 𝒪_p R'_p (algebraMap A₀ 𝒪_p g) =
      ∑ i : Fin e, algebraMap 𝒪_p R'_p (algebraMap A₀ 𝒪_p (c i)) * ϖ ^ (i : ℕ)
    rw [hr, Finset.sum_mul]
    refine Finset.sum_congr rfl fun i _ => ?_
    calc
      algebraMap 𝒪_p R'_p (c_p i) * ϖ ^ (i : ℕ) * algebraMap 𝒪_p R'_p (algebraMap A₀ 𝒪_p g) =
          algebraMap 𝒪_p R'_p (c_p i * algebraMap A₀ 𝒪_p g) * ϖ ^ (i : ℕ) := by
        rw [map_mul]
        ring
      _ = algebraMap 𝒪_p R'_p (algebraMap A₀ 𝒪_p (c i)) * ϖ ^ (i : ℕ) := by
        rw [hc i]
  · refine ⟨hϖ_ne, hh'_ne, hϖ_pow, hPrime_ϖ, hPrime_h', hh'_not_ϖ, hϖ_not_h',
      hMax_R', ?_, hRes_R'⟩
    change Ideal.comap ((algebraMap 𝒪_p R'_p).comp (algebraMap A₀ 𝒪_p)) (Ideal.span {ϖ}) =
      Ideal.span {f₀}
    rw [← Ideal.comap_comap, hComap_R, hComap_f₀]

theorem weil_kummer_composite_galois_and_character_orthogonality (k : Type u) [Field k]
    [IsAlgClosed k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
      (f₀ : A₀),
      f₀ ≠ 0 →
      ∀ (p : Fin 2 → k) (e : ℕ), 1 ≤ e → (e : k) ≠ 0 →
        ∀ (R'_p K'_2 : Type u) [CommRing R'_p] [IsDomain R'_p]
          [Field K'_2] [Algebra R'_p K'_2] [IsFractionRing R'_p K'_2]
          [Algebra K₂ K'_2]
          [Algebra k R'_p] [Algebra A₀ R'_p] [IsScalarTower k A₀ R'_p]
          (ϖ : R'_p),
          ϖ ^ e = algebraMap A₀ R'_p f₀ →
          (algebraMap K₂ K'_2).comp (algebraMap A₀ K₂) =
            (algebraMap R'_p K'_2).comp (algebraMap A₀ R'_p) →
          (∀ (E : Type u) [Field E] [Algebra K₂ E] (w_E : E),
            w_E ^ e = algebraMap K₂ E (algebraMap A₀ K₂ f₀) →
            ∃ ψ : K'_2 →ₐ[K₂] E, ψ (algebraMap R'_p K'_2 ϖ) = w_E) →
          (∀ g : A₀, MvPolynomial.eval p g ≠ 0 → IsUnit (algebraMap A₀ R'_p g)) →
          (∀ r : R'_p, ∃ (g : A₀) (c : Fin e → A₀),
            MvPolynomial.eval p g ≠ 0 ∧
            r * algebraMap A₀ R'_p g =
              ∑ i : Fin e, algebraMap A₀ R'_p (c i) * ϖ ^ (i : ℕ)) →
          letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
          let B₂_0 := integralClosure A₀ L₂
          ∃ (L'_2 : Type u)
            (_ : Field L'_2) (_ : Algebra K₂ L'_2) (_ : FiniteDimensional K₂ L'_2)
            (_ : IsGalois K₂ L'_2)
            (_ : Algebra L₂ L'_2) (_ : IsScalarTower K₂ L₂ L'_2)
            (_ : FiniteDimensional L₂ L'_2) (_ : IsGalois L₂ L'_2)
            (_ : Algebra K'_2 L'_2) (_ : FiniteDimensional K'_2 L'_2)
            (_ : Algebra.IsSeparable K'_2 L'_2)
            (_ : Algebra R'_p L'_2) (_ : IsScalarTower R'_p K'_2 L'_2),
            ((algebraMap R'_p L'_2).comp (algebraMap A₀ R'_p) =
               (algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)) ∧
             (∀ x : L₂,
               IsIntegral R'_p (algebraMap L₂ L'_2 x) ↔
                 ∃ (y : ↥B₂_0) (g : A₀),
                   MvPolynomial.eval p g ≠ 0 ∧
                   x * algebraMap A₀ L₂ g = (y : L₂))) ∧
            ((Nat.card (L'_2 ≃ₐ[L₂] L'_2) : k) ≠ 0 ∧
             ∀ τ : L'_2 ≃ₐ[K₂] L'_2,
               (∃ ζ : k, ζ ^ e = 1 ∧
                 τ (algebraMap R'_p L'_2 ϖ) =
                   algebraMap R'_p L'_2 (algebraMap k R'_p ζ * ϖ)) ∧
               (∀ r : R'_p, ∃ r' : R'_p,
                 τ (algebraMap R'_p L'_2 r) = algebraMap R'_p L'_2 r') ∧
               (∀ r : R'_p, ∃ s : R'_p,
                 τ (algebraMap R'_p L'_2 r) - algebraMap R'_p L'_2 r =
                   algebraMap R'_p L'_2 (ϖ * s))) ∧
            (∀ (t : L₂), t ≠ 0 →
               ∀ (S : Subring L'_2),
                 (∀ c : k, algebraMap R'_p L'_2 (algebraMap k R'_p c) ∈ S) →
                 (∀ σ : L'_2 ≃ₐ[L₂] L'_2, ∀ z ∈ S, σ z ∈ S) →
                 let α : L'_2 := (algebraMap L₂ L'_2 t)⁻¹ * algebraMap R'_p L'_2 ϖ
                 α ∈ S → α⁻¹ ∈ S →
                 ∀ z ∈ S, ∃ (m : ℕ) (c : Fin m → L₂),
                   (∀ j : Fin m, algebraMap L₂ L'_2 (c j) ∈ S) ∧
                   z = ∑ j : Fin m, algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ)) :=
by
  intro A₀ K₂ L₂ _ _ _ _ f₀ hf₀_ne p e he_pos he_ne R'_p K'_2 _ _ _ _ _ _ _ _ _
    ϖ hϖ_pow hCompat_K' hK'_lift hUnits hExp
  classical
  let _ : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
  let B₂_0 := integralClosure A₀ L₂
  have he_ne_zero : e ≠ 0 := by omega

  
  
  
  let f_K₂ : K₂ := algebraMap A₀ K₂ f₀
  let f_L₂ : L₂ := algebraMap K₂ L₂ f_K₂
  have hf_K₂_ne : f_K₂ ≠ 0 :=
    fun h => hf₀_ne (IsFractionRing.injective A₀ K₂ (by simpa [f_K₂] using h))
  have hf_L₂_ne : f_L₂ ≠ 0 :=
    fun h => hf_K₂_ne ((algebraMap K₂ L₂).injective (by simpa [f_L₂] using h))

  let ι_kK₂ : k →+* K₂ := (algebraMap A₀ K₂).comp (algebraMap k A₀)
  have he_K₂ : (e : K₂) ≠ 0 := by
    intro h
    apply he_ne
    exact ι_kK₂.injective (by rw [map_natCast, h, map_zero])
  have he_L₂ : (e : L₂) ≠ 0 := by
    intro h
    apply he_K₂
    exact (algebraMap K₂ L₂).injective (by rw [map_natCast, h, map_zero])

  let F_K₂ : Polynomial K₂ := Polynomial.X ^ e - Polynomial.C f_K₂
  let F_L₂ : Polynomial L₂ := Polynomial.X ^ e - Polynomial.C f_L₂
  have hFL₂_map : F_K₂.map (algebraMap K₂ L₂) = F_L₂ := by
    dsimp [F_K₂, F_L₂, f_L₂]
    rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  have hFK₂_mon : F_K₂.Monic := Polynomial.monic_X_pow_sub_C f_K₂ he_ne_zero
  have hFL₂_mon : F_L₂.Monic := Polynomial.monic_X_pow_sub_C f_L₂ he_ne_zero
  have hFL₂_deg : F_L₂.natDegree = e := Polynomial.natDegree_X_pow_sub_C
  have hFL₂_not_unit : ¬IsUnit F_L₂ :=
    Polynomial.not_isUnit_of_natDegree_pos F_L₂ (by rw [hFL₂_deg]; omega)
  have hFK₂_sep : F_K₂.Separable := Polynomial.separable_X_pow_sub_C f_K₂ he_K₂ hf_K₂_ne
  have hFL₂_sep : F_L₂.Separable := Polynomial.separable_X_pow_sub_C f_L₂ he_L₂ hf_L₂_ne

  obtain ⟨g₀, hg₀_irr, hg₀_dvd⟩ :=
    WfDvdMonoid.exists_irreducible_factor hFL₂_not_unit hFL₂_mon.ne_zero
  let u₀ : L₂ := g₀.leadingCoeff
  have hu₀_ne : u₀ ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hg₀_irr.ne_zero
  let g : Polynomial L₂ := Polynomial.C u₀⁻¹ * g₀
  have hg_mon : g.Monic := by
    dsimp [Polynomial.Monic, g, u₀]
    rw [Polynomial.leadingCoeff_mul, Polynomial.leadingCoeff_C, inv_mul_cancel₀ hu₀_ne]
  have hg₀_eq : g₀ = Polynomial.C u₀ * g := by
    dsimp [g]
    rw [← mul_assoc, ← Polynomial.C_mul, mul_inv_cancel₀ hu₀_ne, Polynomial.C_1, one_mul]
  have hg_assoc : Associated g₀ g := by
    refine ⟨⟨Polynomial.C u₀⁻¹, Polynomial.C u₀, ?_, ?_⟩, ?_⟩
    · rw [← Polynomial.C_mul, inv_mul_cancel₀ hu₀_ne, Polynomial.C_1]
    · rw [← Polynomial.C_mul, mul_inv_cancel₀ hu₀_ne, Polynomial.C_1]
    · exact mul_comm g₀ (Polynomial.C u₀⁻¹)
  have hg_irr : Irreducible g := hg_assoc.irreducible hg₀_irr
  have hg_dvd : g ∣ F_L₂ := dvd_trans ⟨Polynomial.C u₀, by rw [hg₀_eq, mul_comm]⟩ hg₀_dvd
  have hg_sep : g.Separable := Polynomial.Separable.of_dvd hFL₂_sep hg_dvd

  let _ : Fact (Irreducible g) := ⟨hg_irr⟩
  let L'_2 : Type u := AdjoinRoot g
  let instFieldL' : Field L'_2 := inferInstance
  let instAlgL₂L' : Algebra L₂ L'_2 := inferInstance
  let ϖ₀ : L'_2 := AdjoinRoot.root g

  have hϖ₀_pow : ϖ₀ ^ e = algebraMap L₂ L'_2 f_L₂ := by
    rcases hg_dvd with ⟨q, hq⟩
    have h0 : Polynomial.aeval ϖ₀ F_L₂ = 0 := by
      rw [hq, map_mul, show Polynomial.aeval ϖ₀ g = 0 from AdjoinRoot.eval₂_root g, zero_mul]
    dsimp [F_L₂] at h0
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C] at h0
    exact sub_eq_zero.mp h0
  have hϖ₀_ne : ϖ₀ ≠ 0 := by
    intro h0
    have hpow0 : ϖ₀ ^ e = 0 := by rw [h0, zero_pow he_ne_zero]
    rw [hϖ₀_pow] at hpow0
    exact hf_L₂_ne ((algebraMap L₂ L'_2).injective (by simpa using hpow0))

  let instAlgK₂L' : Algebra K₂ L'_2 := inferInstance
  let instSTK₂L₂L' : IsScalarTower K₂ L₂ L'_2 := inferInstance

  let pb : PowerBasis L₂ L'_2 := AdjoinRoot.powerBasis' hg_mon
  have hpb_gen : pb.gen = ϖ₀ := AdjoinRoot.powerBasis'_gen hg_mon
  let instFDL₂L' : FiniteDimensional L₂ L'_2 := PowerBasis.finite pb
  let instFDK₂L' : FiniteDimensional K₂ L'_2 := Module.Finite.trans L₂ L'_2

  have hϖ₀_pow_K₂ : ϖ₀ ^ e = algebraMap K₂ L'_2 (algebraMap A₀ K₂ f₀) := by
    rw [hϖ₀_pow, IsScalarTower.algebraMap_apply K₂ L₂ L'_2]
  obtain ⟨ψ, hψ_ϖ⟩ := hK'_lift L'_2 ϖ₀ hϖ₀_pow_K₂

  let instAlgK'L' : Algebra K'_2 L'_2 := ψ.toRingHom.toAlgebra
  let instAlgR'L' : Algebra R'_p L'_2 := (ψ.toRingHom.comp (algebraMap R'_p K'_2)).toAlgebra
  let instSTR'K'L' : IsScalarTower R'_p K'_2 L'_2 := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let instSTK₂K'L' : IsScalarTower K₂ K'_2 L'_2 :=
    IsScalarTower.of_algebraMap_eq fun x => (ψ.commutes x).symm
  let instFDK'L' : FiniteDimensional K'_2 L'_2 :=
    Module.Finite.of_restrictScalars_finite K₂ K'_2 L'_2

  have hϖ_eq : algebraMap R'_p L'_2 ϖ = ϖ₀ := hψ_ϖ

  
  have hBasis : ∀ z : L'_2, ∃ c₀ : Fin (Module.finrank L₂ L'_2) → L₂,
      z = ∑ j : Fin (Module.finrank L₂ L'_2), algebraMap L₂ L'_2 (c₀ j) * ϖ₀ ^ (j : ℕ) := by
    intro z
    let b' : Module.Basis (Fin (Module.finrank L₂ L'_2)) L₂ L'_2 :=
      pb.basis.reindex (finCongr pb.finrank.symm)
    refine ⟨fun j => b'.repr z j, ?_⟩
    conv_lhs => rw [← b'.sum_repr z]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Algebra.smul_def]
    congr 1
    dsimp [b']
    rw [Module.Basis.reindex_apply, PowerBasis.coe_basis, hpb_gen]
    rfl

  
  have hRigid : ∀ σ₁ σ₂ : L'_2 ≃ₐ[L₂] L'_2, σ₁ ϖ₀ = σ₂ ϖ₀ → σ₁ = σ₂ := by
    intro σ₁ σ₂ hσ
    have hext : σ₁.toAlgHom = σ₂.toAlgHom := AdjoinRoot.algHom_ext hσ
    exact AlgEquiv.ext fun x => AlgHom.congr_fun hext x

  
  let ι_kL' : k →+* L'_2 := (algebraMap K₂ L'_2).comp ι_kK₂
  have hSplits_pow : (Polynomial.X ^ e - Polynomial.C (ϖ₀ ^ e) : Polynomial L'_2).Splits := by
    let P₁ : Polynomial k := Polynomial.X ^ e - Polynomial.C (1 : k)
    have hP₁_splits : P₁.Splits := IsAlgClosed.splits P₁
    have hQ₁_splits : (Polynomial.X ^ e - Polynomial.C (1 : L'_2) : Polynomial L'_2).Splits := by
      have hm := hP₁_splits.map ι_kL'
      dsimp [P₁] at hm
      rwa [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C, map_one] at hm
    have hQ₂_splits :
        ((Polynomial.X ^ e - Polynomial.C (1 : L'_2)).comp
          (Polynomial.C ϖ₀⁻¹ * Polynomial.X)).Splits :=
      hQ₁_splits.comp_of_degree_le_one (Polynomial.degree_C_mul_X_le ϖ₀⁻¹)
    have hQ₃_splits :
        (Polynomial.C (ϖ₀ ^ e) *
          ((Polynomial.X ^ e - Polynomial.C (1 : L'_2)).comp
            (Polynomial.C ϖ₀⁻¹ * Polynomial.X))).Splits :=
      (Polynomial.Splits.C (ϖ₀ ^ e)).mul hQ₂_splits
    have hQ₃_eq :
        Polynomial.C (ϖ₀ ^ e) *
          ((Polynomial.X ^ e - Polynomial.C (1 : L'_2)).comp
            (Polynomial.C ϖ₀⁻¹ * Polynomial.X)) =
        Polynomial.X ^ e - Polynomial.C (ϖ₀ ^ e) := by
      rw [Polynomial.sub_comp, Polynomial.pow_comp, Polynomial.X_comp, Polynomial.C_comp,
        mul_pow, ← Polynomial.C_pow, mul_sub, ← mul_assoc, ← Polynomial.C_mul, ← Polynomial.C_mul,
        inv_pow, mul_inv_cancel₀ (pow_ne_zero e hϖ₀_ne), mul_one, Polynomial.C_1, one_mul]
    rwa [hQ₃_eq] at hQ₃_splits

  have hFL₂_splits_L' : (F_L₂.map (algebraMap L₂ L'_2)).Splits := by
    have heq : F_L₂.map (algebraMap L₂ L'_2) = Polynomial.X ^ e - Polynomial.C (ϖ₀ ^ e) := by
      dsimp [F_L₂]
      rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C, hϖ₀_pow]
    rwa [heq]

  have hFK₂_splits_L' : (F_K₂.map (algebraMap K₂ L'_2)).Splits := by
    have heq : F_K₂.map (algebraMap K₂ L'_2) = Polynomial.X ^ e - Polynomial.C (ϖ₀ ^ e) := by
      dsimp [F_K₂]
      rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C, hϖ₀_pow_K₂]
    rwa [heq]

  
  let instGalL₂L' : IsGalois L₂ L'_2 := by
    have hg_splits : (g.map (algebraMap L₂ L'_2)).Splits :=
      hFL₂_splits_L'.of_dvd (hFL₂_mon.map (algebraMap L₂ L'_2)).ne_zero
        (Polynomial.map_dvd (algebraMap L₂ L'_2) hg_dvd)
    have hϖ₀_mem : ϖ₀ ∈ g.rootSet L'_2 :=
      Polynomial.mem_rootSet.mpr ⟨hg_mon.ne_zero, AdjoinRoot.eval₂_root g⟩
    have hg_adjoin : Algebra.adjoin L₂ (g.rootSet L'_2) = ⊤ := by
      rw [eq_top_iff, ← AdjoinRoot.adjoinRoot_eq_top (f := g)]
      exact Algebra.adjoin_mono (Set.singleton_subset_iff.mpr hϖ₀_mem)
    let _ : Polynomial.IsSplittingField L₂ L'_2 g := Polynomial.IsSplittingField.mk hg_splits hg_adjoin
    exact IsGalois.of_separable_splitting_field hg_sep

  
  let instSepK₂L₂ : Algebra.IsSeparable K₂ L₂ := IsGalois.to_isSeparable
  let instSepL₂L' : Algebra.IsSeparable L₂ L'_2 := IsGalois.to_isSeparable
  let instSepK₂L' : Algebra.IsSeparable K₂ L'_2 := Algebra.IsSeparable.trans K₂ L₂ L'_2
  let instSepK'L' : Algebra.IsSeparable K'_2 L'_2 :=
    Algebra.isSeparable_tower_top_of_isSeparable K₂ K'_2 L'_2

  let instGalK₂L' : IsGalois K₂ L'_2 := by
    obtain ⟨p₀, hp₀_sep, hp₀_split⟩ := IsGalois.is_separable_splitting_field K₂ L₂
    let _ : Polynomial.IsSplittingField K₂ L₂ p₀ := hp₀_split
    have hp₀_ne : p₀ ≠ 0 := hp₀_sep.ne_zero
    let P_tot : Polynomial K₂ := p₀ * F_K₂
    have hPtot_ne : P_tot ≠ 0 := mul_ne_zero hp₀_ne hFK₂_mon.ne_zero
    have hp₀_splits_L' : (p₀.map (algebraMap K₂ L'_2)).Splits := by
      have h1 : (p₀.map (algebraMap K₂ L₂)).Splits := Polynomial.IsSplittingField.splits L₂ p₀
      have h2 := h1.map (algebraMap L₂ L'_2)
      rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq K₂ L₂ L'_2] at h2
      exact h2
    have hPtot_splits : (P_tot.map (algebraMap K₂ L'_2)).Splits := by
      dsimp [P_tot]
      rw [Polynomial.map_mul]
      exact hp₀_splits_L'.mul hFK₂_splits_L'
    let S_gen : Subalgebra K₂ L'_2 := Algebra.adjoin K₂ (P_tot.rootSet L'_2)
    have hL₂_in_S : ∀ x : L₂, algebraMap L₂ L'_2 x ∈ S_gen := by
      let ι_L : L₂ →ₐ[K₂] L'_2 := IsScalarTower.toAlgHom K₂ L₂ L'_2
      have hsub : p₀.rootSet L₂ ⊆ (S_gen.comap ι_L : Set L₂) := by
        intro r hr
        obtain ⟨_, hr_eval⟩ := Polynomial.mem_rootSet.mp hr
        apply Algebra.subset_adjoin
        refine Polynomial.mem_rootSet.mpr ⟨hPtot_ne, ?_⟩
        dsimp [P_tot]
        rw [map_mul, Polynomial.aeval_algHom_apply ι_L r p₀, hr_eval, map_zero, zero_mul]
      have htop : (⊤ : Subalgebra K₂ L₂) ≤ S_gen.comap ι_L := by
        rw [← Polynomial.IsSplittingField.adjoin_rootSet L₂ p₀]
        exact Algebra.adjoin_le_iff.mpr hsub
      intro x
      exact htop Algebra.mem_top
    have hϖ₀_in_S : ϖ₀ ∈ S_gen := by
      apply Algebra.subset_adjoin
      refine Polynomial.mem_rootSet.mpr ⟨hPtot_ne, ?_⟩
      dsimp [P_tot, F_K₂, f_K₂]
      rw [map_mul, map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
        hϖ₀_pow_K₂, sub_self, mul_zero]
    have hPtot_adjoin : S_gen = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨c₀, rfl⟩ := hBasis z
      exact S_gen.sum_mem fun j _ => S_gen.mul_mem (hL₂_in_S (c₀ j)) (S_gen.pow_mem hϖ₀_in_S _)
    let _ : Polynomial.IsSplittingField K₂ L'_2 P_tot :=
      Polynomial.IsSplittingField.mk hPtot_splits hPtot_adjoin
    let _ : Normal K₂ L'_2 := Normal.of_isSplittingField P_tot
    exact IsGalois.mk

  
  have hCompat_K₂ :
      (algebraMap R'_p L'_2).comp (algebraMap A₀ R'_p) =
        (algebraMap K₂ L'_2).comp (algebraMap A₀ K₂) := by
    apply RingHom.ext
    intro a
    calc
      algebraMap R'_p L'_2 (algebraMap A₀ R'_p a)
        = algebraMap K'_2 L'_2 (algebraMap R'_p K'_2 (algebraMap A₀ R'_p a)) :=
            IsScalarTower.algebraMap_apply R'_p K'_2 L'_2 _
      _ = algebraMap K'_2 L'_2 (algebraMap K₂ K'_2 (algebraMap A₀ K₂ a)) := by
            congr 1
            exact RingHom.congr_fun hCompat_K'.symm a
      _ = algebraMap K₂ L'_2 (algebraMap A₀ K₂ a) :=
            (IsScalarTower.algebraMap_apply K₂ K'_2 L'_2 _).symm

  have hCompat :
      (algebraMap R'_p L'_2).comp (algebraMap A₀ R'_p) =
        (algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)) := by
    apply RingHom.ext
    intro a
    have h1 := RingHom.congr_fun hCompat_K₂ a
    simpa [RingHom.comp_apply, IsScalarTower.algebraMap_apply K₂ L₂ L'_2] using h1

  have hCompat_apply : ∀ a : A₀,
      algebraMap R'_p L'_2 (algebraMap A₀ R'_p a) = algebraMap L₂ L'_2 (algebraMap A₀ L₂ a) :=
    fun a => RingHom.congr_fun hCompat a

  
  
  
  have hIntCrit : ∀ x : L₂,
      IsIntegral R'_p (algebraMap L₂ L'_2 x) ↔
        ∃ (y : ↥B₂_0) (g_den : A₀),
          MvPolynomial.eval p g_den ≠ 0 ∧
          x * algebraMap A₀ L₂ g_den = (y : L₂) := by
    have hA₀L₂_inj : Function.Injective (algebraMap A₀ L₂) :=
      (algebraMap K₂ L₂).injective.comp (IsFractionRing.injective A₀ K₂)
    intro x
    constructor
    · intro hx_int
      let A_p : Subring L₂ :=
        { carrier := { w : L₂ | ∃ (a g_d : A₀), MvPolynomial.eval p g_d ≠ 0 ∧
            w * algebraMap A₀ L₂ g_d = algebraMap A₀ L₂ a }
          mul_mem' := by
            rintro w₁ w₂ ⟨a₁, g₁, hg₁, hw₁⟩ ⟨a₂, g₂, hg₂, hw₂⟩
            refine ⟨a₁ * a₂, g₁ * g₂, ?_, ?_⟩
            · rw [map_mul]; exact mul_ne_zero hg₁ hg₂
            · calc
                (w₁ * w₂) * algebraMap A₀ L₂ (g₁ * g₂)
                  = (w₁ * algebraMap A₀ L₂ g₁) * (w₂ * algebraMap A₀ L₂ g₂) := by
                      rw [map_mul]; ring
                _ = algebraMap A₀ L₂ (a₁ * a₂) := by rw [hw₁, hw₂, map_mul]
          one_mem' := ⟨1, 1, by simp, by simp⟩
          add_mem' := by
            rintro w₁ w₂ ⟨a₁, g₁, hg₁, hw₁⟩ ⟨a₂, g₂, hg₂, hw₂⟩
            refine ⟨a₁ * g₂ + a₂ * g₁, g₁ * g₂, ?_, ?_⟩
            · rw [map_mul]; exact mul_ne_zero hg₁ hg₂
            · calc
                (w₁ + w₂) * algebraMap A₀ L₂ (g₁ * g₂)
                  = (w₁ * algebraMap A₀ L₂ g₁) * algebraMap A₀ L₂ g₂ +
                    (w₂ * algebraMap A₀ L₂ g₂) * algebraMap A₀ L₂ g₁ := by
                      rw [map_mul]; ring
                _ = algebraMap A₀ L₂ (a₁ * g₂ + a₂ * g₁) := by
                      rw [hw₁, hw₂, map_add, map_mul, map_mul]
          zero_mem' := ⟨0, 1, by simp, by simp⟩
          neg_mem' := by
            rintro w ⟨a, g_d, hg_d, hw⟩
            refine ⟨-a, g_d, hg_d, ?_⟩
            rw [neg_mul, hw, map_neg] }
      have hA₀_mem_Ap : ∀ a : A₀, algebraMap A₀ L₂ a ∈ A_p :=
        fun a => ⟨a, 1, by simp, by simp⟩
      have hInv_mem_Ap : ∀ g_d : A₀, MvPolynomial.eval p g_d ≠ 0 →
          (algebraMap A₀ L₂ g_d)⁻¹ ∈ A_p := by
        intro g_d hg_d
        have hg_ne : g_d ≠ 0 := fun h0 => hg_d (by rw [h0, map_zero])
        have hgL_ne : algebraMap A₀ L₂ g_d ≠ 0 :=
          fun h0 => hg_ne (hA₀L₂_inj (by rw [h0, map_zero]))
        refine ⟨1, g_d, hg_d, ?_⟩
        rw [inv_mul_cancel₀ hgL_ne, map_one]

      let _ : Algebra ↥A_p L'_2 := inferInstance
      let _ : IsScalarTower ↥A_p L₂ L'_2 := inferInstance
      let C_p : Subalgebra ↥A_p L'_2 := integralClosure ↥A_p L'_2

      have hϖ_mem_Cp : algebraMap R'_p L'_2 ϖ ∈ C_p := by
        let f_Ap : ↥A_p := ⟨algebraMap A₀ L₂ f₀, hA₀_mem_Ap f₀⟩
        refine ⟨Polynomial.X ^ e - Polynomial.C f_Ap,
          Polynomial.monic_X_pow_sub_C f_Ap he_ne_zero, ?_⟩
        change Polynomial.aeval (algebraMap R'_p L'_2 ϖ)
          (Polynomial.X ^ e - Polynomial.C f_Ap) = 0
        rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
          IsScalarTower.algebraMap_apply ↥A_p L₂ L'_2 f_Ap,
          ← map_pow, hϖ_pow, hCompat_apply]
        exact sub_self _

      have hR'_in_Cp : ∀ r : R'_p, algebraMap R'_p L'_2 r ∈ C_p := by
        intro r
        obtain ⟨g_d, c_r, hg_d, hr_eq⟩ := hExp r
        have hg_ne : g_d ≠ 0 := fun h0 => hg_d (by rw [h0, map_zero])
        have hgL_ne : algebraMap A₀ L₂ g_d ≠ 0 :=
          fun h0 => hg_ne (hA₀L₂_inj (by rw [h0, map_zero]))
        have hr_L' :
            algebraMap R'_p L'_2 r * algebraMap L₂ L'_2 (algebraMap A₀ L₂ g_d) =
              ∑ i : Fin e,
                algebraMap L₂ L'_2 (algebraMap A₀ L₂ (c_r i)) *
                  (algebraMap R'_p L'_2 ϖ) ^ (i : ℕ) := by
          have hm := congrArg (algebraMap R'_p L'_2) hr_eq
          rw [map_mul, hCompat_apply, map_sum] at hm
          rw [hm]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul, hCompat_apply, map_pow]
        let sum_val : L'_2 :=
          ∑ i : Fin e,
            algebraMap L₂ L'_2 (algebraMap A₀ L₂ (c_r i)) *
              (algebraMap R'_p L'_2 ϖ) ^ (i : ℕ)
        have hsum_Cp : sum_val ∈ C_p := by
          refine C_p.sum_mem fun i _ => C_p.mul_mem ?_ (C_p.pow_mem hϖ_mem_Cp _)
          have hc_mem := C_p.algebraMap_mem ⟨algebraMap A₀ L₂ (c_r i), hA₀_mem_Ap (c_r i)⟩
          rwa [IsScalarTower.algebraMap_apply ↥A_p L₂ L'_2] at hc_mem
        have hinv_Cp : algebraMap L₂ L'_2 ((algebraMap A₀ L₂ g_d)⁻¹) ∈ C_p := by
          have hi_mem := C_p.algebraMap_mem ⟨(algebraMap A₀ L₂ g_d)⁻¹, hInv_mem_Ap g_d hg_d⟩
          rwa [IsScalarTower.algebraMap_apply ↥A_p L₂ L'_2] at hi_mem
        have hr_prod :
            algebraMap R'_p L'_2 r =
              sum_val * algebraMap L₂ L'_2 ((algebraMap A₀ L₂ g_d)⁻¹) := by
          calc
            algebraMap R'_p L'_2 r
              = algebraMap R'_p L'_2 r *
                  algebraMap L₂ L'_2 (algebraMap A₀ L₂ g_d * (algebraMap A₀ L₂ g_d)⁻¹) := by
                    rw [mul_inv_cancel₀ hgL_ne, map_one, mul_one]
            _ = (algebraMap R'_p L'_2 r * algebraMap L₂ L'_2 (algebraMap A₀ L₂ g_d)) *
                  algebraMap L₂ L'_2 ((algebraMap A₀ L₂ g_d)⁻¹) := by
                    rw [map_mul, mul_assoc]
            _ = sum_val * algebraMap L₂ L'_2 ((algebraMap A₀ L₂ g_d)⁻¹) := by
                    rw [hr_L']
        rw [hr_prod]
        exact C_p.mul_mem hsum_Cp hinv_Cp

      let φ_RC : R'_p →+* ↥C_p := (algebraMap R'_p L'_2).codRestrict C_p.toSubring hR'_in_Cp
      have hx_Cp : IsIntegral ↥C_p (algebraMap L₂ L'_2 x) := by
        rcases hx_int with ⟨P₀, hP₀_mon, hP₀_eval⟩
        refine ⟨P₀.map φ_RC, hP₀_mon.map φ_RC, ?_⟩
        rw [Polynomial.eval₂_map]
        have hcomp : (algebraMap ↥C_p L'_2).comp φ_RC = algebraMap R'_p L'_2 := by
          ext r; rfl
        rwa [hcomp]
      have hx_Ap_L' : IsIntegral ↥A_p (algebraMap L₂ L'_2 x) :=
        isIntegral_trans (R := ↥A_p) (A := ↥C_p) (algebraMap L₂ L'_2 x) hx_Cp
      have hx_Ap : IsIntegral ↥A_p x :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom ↥A_p L₂ L'_2)
          (algebraMap L₂ L'_2).injective).mp hx_Ap_L'

      rcases hx_Ap with ⟨P, hP_mon, hP_eval⟩
      let n : ℕ := P.natDegree
      have hP_sum : x ^ n + ∑ i : Fin n, (P.coeff (i : ℕ) : L₂) * x ^ (i : ℕ) = 0 := by
        have h1 := hP_eval
        rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ,
          ← Fin.sum_univ_eq_sum_range, show P.coeff n = 1 from hP_mon.coeff_natDegree,
          map_one, one_mul, add_comm] at h1
        exact h1

      choose a_fn g_fn hg_fn ha_fn using fun i : Fin n => (P.coeff (i : ℕ)).2
      let g_tot : A₀ := ∏ j : Fin n, g_fn j
      have hg_tot_eval : MvPolynomial.eval p g_tot ≠ 0 := by
        dsimp [g_tot]
        rw [map_prod]
        exact Finset.prod_ne_zero_iff.mpr fun j _ => hg_fn j
      let h_fn : Fin n → A₀ := fun i => ∏ j ∈ Finset.univ.erase i, g_fn j
      have hgh : ∀ i : Fin n, g_fn i * h_fn i = g_tot :=
        fun i => Finset.mul_prod_erase Finset.univ g_fn (Finset.mem_univ i)
      let b_fn : Fin n → A₀ := fun i => a_fn i * h_fn i * g_tot ^ (n - 1 - (i : ℕ))
      let Q : Polynomial A₀ :=
        Polynomial.X ^ n + ∑ i : Fin n, Polynomial.C (b_fn i) * Polynomial.X ^ (i : ℕ)
      have hQ_mon : Q.Monic := Polynomial.monic_X_pow_add (Polynomial.degree_sum_fin_lt b_fn)
      have hQ_eval : Polynomial.eval₂ (algebraMap A₀ L₂) (x * algebraMap A₀ L₂ g_tot) Q = 0 := by
        let G_L : L₂ := algebraMap A₀ L₂ g_tot
        change Polynomial.eval₂ (algebraMap A₀ L₂) (x * G_L)
          (Polynomial.X ^ n + ∑ i : Fin n, Polynomial.C (b_fn i) * Polynomial.X ^ (i : ℕ)) = 0
        rw [Polynomial.eval₂_add, Polynomial.eval₂_X_pow, Polynomial.eval₂_finsetSum]
        have hterms :
            (∑ i : Fin n,
              Polynomial.eval₂ (algebraMap A₀ L₂) (x * G_L)
                (Polynomial.C (b_fn i) * Polynomial.X ^ (i : ℕ))) =
            ∑ i : Fin n, G_L ^ n * ((P.coeff (i : ℕ) : L₂) * x ^ (i : ℕ)) := by
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
          dsimp [b_fn, G_L]
          rw [map_mul, map_mul, map_pow, ← ha_fn i]
          have hgh_L : algebraMap A₀ L₂ (g_fn i) * algebraMap A₀ L₂ (h_fn i) =
              algebraMap A₀ L₂ g_tot := by
            rw [← map_mul, hgh i]
          have hexp : 1 + (n - 1 - (i : ℕ)) + (i : ℕ) = n := by omega
          calc
            (P.coeff (i : ℕ) : L₂) * algebraMap A₀ L₂ (g_fn i) * algebraMap A₀ L₂ (h_fn i) *
                (algebraMap A₀ L₂ g_tot) ^ (n - 1 - (i : ℕ)) *
                (x * algebraMap A₀ L₂ g_tot) ^ (i : ℕ)
              = ((algebraMap A₀ L₂ (g_fn i) * algebraMap A₀ L₂ (h_fn i)) *
                  (algebraMap A₀ L₂ g_tot) ^ (n - 1 - (i : ℕ)) *
                  (algebraMap A₀ L₂ g_tot) ^ (i : ℕ)) *
                ((P.coeff (i : ℕ) : L₂) * x ^ (i : ℕ)) := by ring
            _ = ((algebraMap A₀ L₂ g_tot) ^ 1 *
                  (algebraMap A₀ L₂ g_tot) ^ (n - 1 - (i : ℕ)) *
                  (algebraMap A₀ L₂ g_tot) ^ (i : ℕ)) *
                ((P.coeff (i : ℕ) : L₂) * x ^ (i : ℕ)) := by rw [hgh_L, pow_one]
            _ = (algebraMap A₀ L₂ g_tot) ^ n * ((P.coeff (i : ℕ) : L₂) * x ^ (i : ℕ)) := by
                  rw [← pow_add, ← pow_add, hexp]
        rw [hterms, ← Finset.mul_sum]
        calc
          (x * G_L) ^ n + G_L ^ n * ∑ i : Fin n, (P.coeff (i : ℕ) : L₂) * x ^ (i : ℕ)
            = G_L ^ n * (x ^ n + ∑ i : Fin n, (P.coeff (i : ℕ) : L₂) * x ^ (i : ℕ)) := by ring
          _ = 0 := by rw [hP_sum, mul_zero]
      exact ⟨⟨x * algebraMap A₀ L₂ g_tot, ⟨Q, hQ_mon, hQ_eval⟩⟩, g_tot, hg_tot_eval, rfl⟩
    · rintro ⟨y, g_den, hg_den, hx_eq⟩
      rcases y.2 with ⟨P, hP_mon, hP_eval⟩
      have hy_int : IsIntegral R'_p (algebraMap L₂ L'_2 (y : L₂)) := by
        refine ⟨P.map (algebraMap A₀ R'_p), hP_mon.map (algebraMap A₀ R'_p), ?_⟩
        have hcomp_eq :
            (algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)) =
              (algebraMap L₂ L'_2).comp (algebraMap A₀ L₂) := rfl
        rw [Polynomial.eval₂_map, hCompat, hcomp_eq,
          ← Polynomial.hom_eval₂ P (algebraMap A₀ L₂) (algebraMap L₂ L'_2) (y : L₂),
          hP_eval, map_zero]
      rcases hUnits g_den hg_den with ⟨u_g, hu_g⟩
      let v_g : R'_p := ↑(u_g⁻¹)
      have huv : (u_g : R'_p) * v_g = 1 := Units.mul_inv u_g
      have hx_prod :
          algebraMap L₂ L'_2 x =
            algebraMap L₂ L'_2 (y : L₂) * algebraMap R'_p L'_2 v_g := by
        calc
          algebraMap L₂ L'_2 x
            = algebraMap L₂ L'_2 x * algebraMap R'_p L'_2 ((u_g : R'_p) * v_g) := by
                rw [huv, map_one, mul_one]
          _ = (algebraMap L₂ L'_2 x * algebraMap L₂ L'_2 (algebraMap A₀ L₂ g_den)) *
                algebraMap R'_p L'_2 v_g := by
                rw [map_mul, ← mul_assoc, hu_g, hCompat_apply]
          _ = algebraMap L₂ L'_2 (y : L₂) * algebraMap R'_p L'_2 v_g := by
                rw [← map_mul, hx_eq]
      rw [hx_prod]
      exact hy_int.mul (isIntegral_algebraMap (x := v_g))

  
  
  
  let ϖ_L : L'_2 := algebraMap R'_p L'_2 ϖ
  have hϖ_L_ne : ϖ_L ≠ 0 := by rwa [show ϖ_L = ϖ₀ from hϖ_eq]
  have hϖ_L_pow : ϖ_L ^ e = algebraMap K₂ L'_2 f_K₂ := by
    rw [show ϖ_L = ϖ₀ from hϖ_eq, hϖ₀_pow_K₂]
  let ι_k : k →+* L'_2 := (algebraMap R'_p L'_2).comp (algebraMap k R'_p)

  have hGalK₂ : ∀ τ : L'_2 ≃ₐ[K₂] L'_2,
      (∃ ζ : k, ζ ^ e = 1 ∧
        τ (algebraMap R'_p L'_2 ϖ) = algebraMap R'_p L'_2 (algebraMap k R'_p ζ * ϖ)) ∧
      (∀ r : R'_p, ∃ r' : R'_p, τ (algebraMap R'_p L'_2 r) = algebraMap R'_p L'_2 r') ∧
      (∀ r : R'_p, ∃ s : R'_p,
        τ (algebraMap R'_p L'_2 r) - algebraMap R'_p L'_2 r =
          algebraMap R'_p L'_2 (ϖ * s)) := by
    intro τ
    have hτ_pow : (τ ϖ_L) ^ e = ϖ_L ^ e := by
      rw [← map_pow, hϖ_L_pow, τ.commutes]
    let u : L'_2 := τ ϖ_L * ϖ_L⁻¹
    have hu_mul : u * ϖ_L = τ ϖ_L := by
      dsimp [u]
      rw [mul_assoc, inv_mul_cancel₀ hϖ_L_ne, mul_one]
    have hu_pow : u ^ e = 1 := by
      dsimp [u]
      rw [mul_pow, hτ_pow, inv_pow, mul_inv_cancel₀ (pow_ne_zero e hϖ_L_ne)]

    have hZeta : ∃ ζ : k, ζ ^ e = 1 ∧ τ ϖ_L = algebraMap R'_p L'_2 (algebraMap k R'_p ζ * ϖ) := by
      let P₁ : Polynomial k := Polynomial.X ^ e - Polynomial.C (1 : k)
      have hP₁_mon : P₁.Monic := Polynomial.monic_X_pow_sub_C (1 : k) he_ne_zero
      obtain ⟨m, hm⟩ := Polynomial.splits_iff_exists_multiset.mp (IsAlgClosed.splits P₁)
      rw [hP₁_mon.leadingCoeff, Polynomial.C_1, one_mul] at hm
      have heval : (Polynomial.eval₂RingHom ι_k u) P₁ = 0 := by
        change Polynomial.eval₂ ι_k u (Polynomial.X ^ e - Polynomial.C (1 : k)) = 0
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
          map_one, hu_pow, sub_self]
      rw [hm, map_multiset_prod, Multiset.map_map] at heval
      obtain ⟨ζ, _, hζ_eq⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp heval)
      have hu_ζ : ι_k ζ = u := by
        dsimp [Function.comp] at hζ_eq
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C] at hζ_eq
        exact (sub_eq_zero.mp hζ_eq).symm
      have hζ_pow : ζ ^ e = 1 :=
        ι_k.injective (by rw [map_pow, hu_ζ, hu_pow, map_one])
      refine ⟨ζ, hζ_pow, ?_⟩
      rw [← hu_mul, ← hu_ζ, map_mul]
      rfl

    obtain ⟨ζ, hζ_pow, hτ_ϖ⟩ := hZeta
    have hτ_A₀ : ∀ a : A₀,
        τ (algebraMap R'_p L'_2 (algebraMap A₀ R'_p a)) =
          algebraMap R'_p L'_2 (algebraMap A₀ R'_p a) := by
      intro a
      have ha := RingHom.congr_fun hCompat_K₂ a
      dsimp at ha
      rw [ha, τ.commutes]

    have hBoth : ∀ r : R'_p,
        ∃ s : R'_p,
          τ (algebraMap R'_p L'_2 r) = algebraMap R'_p L'_2 (r + ϖ * s) := by
      intro r
      obtain ⟨g_d, c_r, hg_d, hr_eq⟩ := hExp r
      rcases hUnits g_d hg_d with ⟨u_g, hu_g⟩
      let v_g : R'_p := ↑(u_g⁻¹)
      have huv : (u_g : R'_p) * v_g = 1 := Units.mul_inv u_g
      have hr_val :
          r = v_g * ∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * ϖ ^ (i : ℕ) := by
        calc
          r = r * ((u_g : R'_p) * v_g) := by rw [huv, mul_one]
          _ = v_g * (r * algebraMap A₀ R'_p g_d) := by rw [hu_g]; ring
          _ = v_g * ∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * ϖ ^ (i : ℕ) := by rw [hr_eq]
      let G_L : L'_2 := algebraMap R'_p L'_2 (u_g : R'_p)
      let V_L : L'_2 := algebraMap R'_p L'_2 v_g
      have hGV : G_L * V_L = 1 := by
        dsimp [G_L, V_L]
        rw [← map_mul, huv, map_one]
      have hGL_ne : G_L ≠ 0 := left_ne_zero_of_mul_eq_one hGV
      have hτ_GL : τ G_L = G_L := by
        dsimp [G_L]
        rw [hu_g, hτ_A₀]
      have hτ_VL : τ V_L = V_L := by
        apply mul_left_cancel₀ hGL_ne
        calc
          G_L * τ V_L = τ G_L * τ V_L := by rw [hτ_GL]
          _ = τ (G_L * V_L) := (map_mul τ G_L V_L).symm
          _ = 1 := by rw [hGV, map_one]
          _ = G_L * V_L := hGV.symm

      let ζ_R : R'_p := algebraMap k R'_p ζ
      let δ : ℕ → R'_p
        | 0 => 0
        | m + 1 => (ζ_R ^ (m + 1) - 1) * ϖ ^ m
      have hδ_ident : ∀ n : ℕ, (ζ_R * ϖ) ^ n = ϖ ^ n + ϖ * δ n := by
        intro n
        cases n with
        | zero => simp [δ]
        | succ m => dsimp [δ]; ring
      let s : R'_p := v_g * ∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * δ (i : ℕ)
      have hr'_eq :
          r + ϖ * s = v_g * ∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * (ζ_R * ϖ) ^ (i : ℕ) := by
        have h1 :
            r + ϖ * s =
              v_g * ∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * (ϖ ^ (i : ℕ) + ϖ * δ (i : ℕ)) := by
          calc
            r + ϖ * s
              = v_g * (∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * ϖ ^ (i : ℕ)) +
                  v_g * (ϖ * ∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * δ (i : ℕ)) := by
                    conv_lhs => rw [hr_val]
                    dsimp [s]
                    ring
            _ = v_g * ((∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * ϖ ^ (i : ℕ)) +
                  ∑ i : Fin e, ϖ * (algebraMap A₀ R'_p (c_r i) * δ (i : ℕ))) := by
                    rw [Finset.mul_sum (a := ϖ), mul_add]
            _ = v_g * ∑ i : Fin e, algebraMap A₀ R'_p (c_r i) * (ϖ ^ (i : ℕ) + ϖ * δ (i : ℕ)) := by
                  rw [← Finset.sum_add_distrib]
                  congr 1
                  refine Finset.sum_congr rfl fun i _ => ?_
                  ring
        rw [h1]
        congr 1
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hδ_ident]
      refine ⟨s, ?_⟩
      calc
        τ (algebraMap R'_p L'_2 r)
          = τ (V_L * ∑ i : Fin e,
              algebraMap R'_p L'_2 (algebraMap A₀ R'_p (c_r i)) * ϖ_L ^ (i : ℕ)) := by
                congr 1
                conv_lhs => rw [hr_val]
                rw [map_mul, map_sum]
                congr 1
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [map_mul, map_pow]
        _ = V_L * ∑ i : Fin e,
              algebraMap R'_p L'_2 (algebraMap A₀ R'_p (c_r i)) *
                (algebraMap R'_p L'_2 (ζ_R * ϖ)) ^ (i : ℕ) := by
                rw [map_mul, hτ_VL, map_sum]
                congr 1
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [map_mul, hτ_A₀, map_pow, hτ_ϖ]
        _ = algebraMap R'_p L'_2 (r + ϖ * s) := by
                symm
                rw [hr'_eq, map_mul, map_sum]
                congr 1
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [map_mul, map_pow]

    refine ⟨⟨ζ, hζ_pow, hτ_ϖ⟩, ?_, ?_⟩
    · intro r
      obtain ⟨s, hs⟩ := hBoth r
      exact ⟨r + ϖ * s, hs⟩
    · intro r
      obtain ⟨s, hs⟩ := hBoth r
      refine ⟨s, ?_⟩
      rw [hs, ← map_sub, add_sub_cancel_left]

  
  
  
  let H₀ := (L'_2 ≃ₐ[L₂] L'_2)
  let _ : Fintype H₀ := AlgEquiv.fintype L₂ L'_2
  let d : ℕ := Module.finrank L₂ L'_2
  have hcard_H₀ : Nat.card H₀ = d := IsGalois.card_aut_eq_finrank L₂ L'_2
  have hfintype_H₀ : Fintype.card H₀ = d := by
    rw [← Nat.card_eq_fintype_card, hcard_H₀]

  have hι_k_L₂ : ∀ c : k,
      ι_k c = algebraMap L₂ L'_2 (algebraMap A₀ L₂ (algebraMap k A₀ c)) := by
    intro c
    dsimp [ι_k]
    rw [IsScalarTower.algebraMap_apply k A₀ R'_p c, hCompat_apply]

  have hσ_ι_k : ∀ (σ : H₀) (c : k), σ (ι_k c) = ι_k c := by
    intro σ c
    rw [hι_k_L₂, σ.commutes]

  choose ψ_fn hψ_pow hψ_act_raw using fun σ : H₀ => (hGalK₂ (σ.restrictScalars K₂)).1
  have hψ_act : ∀ σ : H₀, σ ϖ_L = ι_k (ψ_fn σ) * ϖ_L := by
    intro σ
    have h := hψ_act_raw σ
    change σ ϖ_L = algebraMap R'_p L'_2 (algebraMap k R'_p (ψ_fn σ) * ϖ) at h
    rw [h, map_mul]
    rfl
  have hψ_ne : ∀ σ : H₀, ψ_fn σ ≠ 0 := by
    intro σ h0
    have hp := hψ_pow σ
    rw [h0, zero_pow he_ne_zero] at hp
    exact zero_ne_one hp
  have hψ_uniq : ∀ (σ : H₀) (z : k), σ ϖ_L = ι_k z * ϖ_L → ψ_fn σ = z := by
    intro σ z hz
    have h1 : ι_k (ψ_fn σ) * ϖ_L = ι_k z * ϖ_L := (hψ_act σ).symm.trans hz
    exact ι_k.injective (mul_right_cancel₀ hϖ_L_ne h1)
  have hψ_one : ψ_fn 1 = 1 :=
    hψ_uniq 1 1 (by rw [AlgEquiv.one_apply, map_one, one_mul])
  have hψ_mul : ∀ σ τ : H₀, ψ_fn (σ * τ) = ψ_fn σ * ψ_fn τ := by
    intro σ τ
    apply hψ_uniq
    rw [AlgEquiv.mul_apply, hψ_act τ, map_mul, hσ_ι_k σ (ψ_fn τ), hψ_act σ, map_mul]
    ring
  have hψ_inj : Function.Injective ψ_fn := by
    intro σ₁ σ₂ h12
    apply hRigid
    rw [← hϖ_eq]
    change σ₁ ϖ_L = σ₂ ϖ_L
    rw [hψ_act σ₁, hψ_act σ₂, h12]

  let χ : H₀ →* kˣ :=
    { toFun := fun σ => Units.mk0 (ψ_fn σ) (hψ_ne σ)
      map_one' := Units.ext hψ_one
      map_mul' := fun σ τ => Units.ext (hψ_mul σ τ) }
  have hχ_inj : Function.Injective χ :=
    fun σ₁ σ₂ h => hψ_inj (congrArg Units.val h)
  have hψ_inv : ∀ σ : H₀, ψ_fn σ⁻¹ = (ψ_fn σ)⁻¹ := by
    intro σ
    have h := congrArg Units.val (map_inv χ σ)
    simpa [χ] using h

  have hd_ne_zero : (Nat.card H₀ : k) ≠ 0 := by
    let μ_e : Subgroup kˣ := (powMonoidHom e : kˣ →* kˣ).ker
    have hχ_mem : ∀ σ : H₀, χ σ ∈ μ_e := by
      intro σ
      change (χ σ) ^ e = 1
      exact Units.ext (by simp [χ, hψ_pow σ])
    let χ' : H₀ →* ↥μ_e := χ.codRestrict μ_e hχ_mem
    have hχ'_inj : Function.Injective χ' :=
      fun σ₁ σ₂ h => hχ_inj (congrArg Subtype.val h)
    let P_e : Polynomial k := Polynomial.X ^ e - Polynomial.C (1 : k)
    have hPe_mon : P_e.Monic := Polynomial.monic_X_pow_sub_C (1 : k) he_ne_zero
    have hPe_sep : P_e.Separable :=
      Polynomial.separable_X_pow_sub_C (1 : k) he_ne one_ne_zero
    have hPe_card : P_e.roots.toFinset.card = e := by
      rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hPe_sep),
        ← (IsAlgClosed.splits P_e).natDegree_eq_card_roots,
        Polynomial.natDegree_X_pow_sub_C]
    let e_mu : ↥μ_e ≃ ↥(P_e.roots.toFinset) :=
      { toFun := fun u =>
          ⟨(u.1 : k), by
            rw [Multiset.mem_toFinset, Polynomial.mem_roots hPe_mon.ne_zero]
            change Polynomial.eval (u.1 : k) P_e = 0
            have hu : (u.1 : kˣ) ^ e = 1 := u.2
            have hu_k : (u.1 : k) ^ e = 1 := by
              simpa only [Units.val_pow_eq_pow_val, Units.val_one] using congrArg Units.val hu
            simp [P_e, hu_k]⟩
        invFun := fun (z : ↥(P_e.roots.toFinset)) =>
          have hz_root : Polynomial.IsRoot P_e z.1 :=
            (Polynomial.mem_roots hPe_mon.ne_zero).mp (Multiset.mem_toFinset.mp z.2)
          have hz_pow : z.1 ^ e = 1 := by
            change Polynomial.eval z.1 P_e = 0 at hz_root
            simp only [P_e, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
              Polynomial.eval_C] at hz_root
            exact sub_eq_zero.mp hz_root
          have hz_ne : z.1 ≠ 0 := by
            intro h0
            rw [h0, zero_pow he_ne_zero] at hz_pow
            exact zero_ne_one hz_pow
          ⟨Units.mk0 z.1 hz_ne, by
            change (Units.mk0 z.1 hz_ne) ^ e = 1
            exact Units.ext (by simp [hz_pow])⟩
        left_inv := fun u => Subtype.ext (Units.ext rfl)
        right_inv := fun z => Subtype.ext rfl }
    let _ : Finite ↥μ_e := Finite.of_equiv _ e_mu.symm
    have hcard_mu : Nat.card ↥μ_e = e := by
      rw [Nat.card_congr e_mu, Nat.card_eq_fintype_card, Fintype.card_coe, hPe_card]
    have hdvd_mu : Nat.card ↥(χ'.range) ∣ Nat.card ↥μ_e :=
      Subgroup.card_subgroup_dvd_card χ'.range
    have hcard_range : Nat.card ↥(χ'.range) = Nat.card H₀ := by
      symm
      exact Nat.card_congr (Equiv.ofInjective χ' hχ'_inj)
    rw [hcard_range, hcard_mu] at hdvd_mu
    rcases hdvd_mu with ⟨q, hq⟩
    intro h0
    apply he_ne
    rw [hq, Nat.cast_mul, h0, zero_mul]

  have hSumPowZero : ∀ n : ℕ, 1 ≤ n → n < d → (∑ σ : H₀, (ψ_fn σ) ^ n) = 0 := by
    intro n hn_pos hn_lt
    have hn_ne : n ≠ 0 := by omega
    have hex : ∃ σ₀ : H₀, (ψ_fn σ₀) ^ n ≠ 1 := by
      by_contra! hall
      let P_n : Polynomial k := Polynomial.X ^ n - Polynomial.C (1 : k)
      have hPn_mon : P_n.Monic := Polynomial.monic_X_pow_sub_C (1 : k) hn_ne
      have hsub : Finset.univ.image ψ_fn ⊆ P_n.roots.toFinset := by
        intro z hz
        rcases Finset.mem_image.mp hz with ⟨σ, _, rfl⟩
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hPn_mon.ne_zero]
        change Polynomial.eval (ψ_fn σ) P_n = 0
        simp [P_n, hall σ]
      have hle : d ≤ n := by
        calc
          d = Fintype.card H₀ := hfintype_H₀.symm
          _ = (Finset.univ.image ψ_fn).card := by
                rw [Finset.card_image_of_injective _ hψ_inj, Finset.card_univ]
          _ ≤ P_n.roots.toFinset.card := Finset.card_le_card hsub
          _ ≤ P_n.roots.card := Multiset.toFinset_card_le P_n.roots
          _ ≤ P_n.natDegree := Polynomial.card_roots' P_n
          _ = n := Polynomial.natDegree_X_pow_sub_C
      omega
    rcases hex with ⟨σ₀, hσ₀⟩
    let S_n : k := ∑ σ : H₀, (ψ_fn σ) ^ n
    have hshift : (ψ_fn σ₀) ^ n * S_n = S_n := by
      calc
        (ψ_fn σ₀) ^ n * S_n
          = ∑ σ : H₀, (ψ_fn σ₀) ^ n * (ψ_fn σ) ^ n := Finset.mul_sum _ _ _
        _ = ∑ σ : H₀, (ψ_fn (σ₀ * σ)) ^ n := by
              refine Finset.sum_congr rfl fun σ _ => ?_
              rw [hψ_mul, mul_pow]
        _ = S_n :=
              Fintype.sum_equiv (Equiv.mulLeft σ₀)
                (fun σ => (ψ_fn (σ₀ * σ)) ^ n) (fun σ => (ψ_fn σ) ^ n) (fun _ => rfl)
    have hzero : ((ψ_fn σ₀) ^ n - 1) * S_n = 0 := by
      rw [sub_mul, one_mul, hshift, sub_self]
    exact (mul_eq_zero.mp hzero).resolve_left (sub_ne_zero.mpr hσ₀)

  have hCharOrth : ∀ r j : Fin d,
      (∑ σ : H₀, ((ψ_fn σ)⁻¹) ^ (r : ℕ) * (ψ_fn σ) ^ (j : ℕ)) =
        if j = r then (d : k) else 0 := by
    intro r j
    by_cases hjr : j = r
    · subst hjr
      simp only [↓reduceIte]
      have h1 :
          (∑ σ : H₀, ((ψ_fn σ)⁻¹) ^ (j : ℕ) * (ψ_fn σ) ^ (j : ℕ)) =
            ∑ _σ : H₀, (1 : k) := by
        refine Finset.sum_congr rfl fun σ _ => ?_
        rw [← mul_pow, inv_mul_cancel₀ (hψ_ne σ), one_pow]
      rw [h1, Finset.sum_const, Finset.card_univ, hfintype_H₀, nsmul_eq_mul, mul_one]
    · simp only [hjr, ↓reduceIte]
      have hval_ne : (j : ℕ) ≠ (r : ℕ) := Fin.val_ne_of_ne hjr
      rcases Nat.lt_or_gt_of_ne hval_ne with hj_lt_r | hr_lt_j
      · let n : ℕ := (r : ℕ) - (j : ℕ)
        have hn_pos : 1 ≤ n := by omega
        have hn_lt : n < d := by omega
        have hr_eq : (r : ℕ) = (j : ℕ) + n := by omega
        have h1 :
            (∑ σ : H₀, ((ψ_fn σ)⁻¹) ^ (r : ℕ) * (ψ_fn σ) ^ (j : ℕ)) =
              ∑ σ : H₀, (ψ_fn σ⁻¹) ^ n := by
          refine Finset.sum_congr rfl fun σ _ => ?_
          rw [hr_eq, pow_add, mul_right_comm, ← mul_pow, inv_mul_cancel₀ (hψ_ne σ),
            one_pow, one_mul, hψ_inv]
        rw [h1]
        have h2 : (∑ σ : H₀, (ψ_fn σ⁻¹) ^ n) = ∑ σ : H₀, (ψ_fn σ) ^ n :=
          Fintype.sum_equiv (Equiv.inv H₀)
            (fun σ => (ψ_fn σ⁻¹) ^ n) (fun σ => (ψ_fn σ) ^ n) (fun _ => rfl)
        rw [h2]
        exact hSumPowZero n hn_pos hn_lt
      · let n : ℕ := (j : ℕ) - (r : ℕ)
        have hn_pos : 1 ≤ n := by omega
        have hn_lt : n < d := by omega
        have hj_eq : (j : ℕ) = (r : ℕ) + n := by omega
        have h1 :
            (∑ σ : H₀, ((ψ_fn σ)⁻¹) ^ (r : ℕ) * (ψ_fn σ) ^ (j : ℕ)) =
              ∑ σ : H₀, (ψ_fn σ) ^ n := by
          refine Finset.sum_congr rfl fun σ _ => ?_
          rw [hj_eq, pow_add, ← mul_assoc, ← mul_pow, inv_mul_cancel₀ (hψ_ne σ),
            one_pow, one_mul]
        rw [h1]
        exact hSumPowZero n hn_pos hn_lt

  have hSubringSpan : ∀ (t : L₂), t ≠ 0 →
      ∀ (S : Subring L'_2),
        (∀ c : k, algebraMap R'_p L'_2 (algebraMap k R'_p c) ∈ S) →
        (∀ σ : L'_2 ≃ₐ[L₂] L'_2, ∀ z ∈ S, σ z ∈ S) →
        let α : L'_2 := (algebraMap L₂ L'_2 t)⁻¹ * algebraMap R'_p L'_2 ϖ
        α ∈ S → α⁻¹ ∈ S →
        ∀ z ∈ S, ∃ (m : ℕ) (c : Fin m → L₂),
          (∀ j : Fin m, algebraMap L₂ L'_2 (c j) ∈ S) ∧
          z = ∑ j : Fin m, algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ) := by
    intro t ht S hk_S hGal_S α _hα_S hα_inv_S z hz
    let t_L : L'_2 := algebraMap L₂ L'_2 t
    have ht_L_ne : t_L ≠ 0 :=
      fun h0 => ht ((algebraMap L₂ L'_2).injective (by simpa [t_L] using h0))
    have hα_ne : α ≠ 0 := mul_ne_zero (inv_ne_zero ht_L_ne) hϖ_L_ne
    have htα : t_L * α = ϖ_L := by
      dsimp [α, t_L, ϖ_L]
      rw [← mul_assoc, mul_inv_cancel₀ ht_L_ne, one_mul]
    have hϖ_pow_α : ∀ n : ℕ, ϖ_L ^ n = algebraMap L₂ L'_2 (t ^ n) * α ^ n := by
      intro n
      rw [← htα, mul_pow, map_pow]
    have hσ_α : ∀ (σ : H₀) (n : ℕ), σ (α ^ n) = ι_k ((ψ_fn σ) ^ n) * α ^ n := by
      intro σ n
      have h1 : σ α = ι_k (ψ_fn σ) * α := by
        dsimp [α, ϖ_L]
        rw [map_mul, map_inv₀, σ.commutes, hψ_act σ]
        ring
      rw [map_pow, h1, mul_pow, ← map_pow]

    obtain ⟨c₀, hz_c₀⟩ := hBasis z
    let c : Fin d → L₂ := fun j => c₀ j * t ^ (j : ℕ)
    have hz_eq : z = ∑ j : Fin d, algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ) := by
      conv_lhs => rw [hz_c₀]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← hϖ_eq, show algebraMap R'_p L'_2 ϖ = ϖ_L from rfl, hϖ_pow_α (j : ℕ)]
      dsimp [c]
      rw [map_mul, mul_assoc]

    refine ⟨d, c, ?_, hz_eq⟩
    intro r
    let W_r : L'_2 := ∑ σ : H₀, ι_k (((ψ_fn σ)⁻¹) ^ (r : ℕ)) * σ z
    have hW_mem : W_r ∈ S :=
      S.sum_mem fun σ _ => S.mul_mem (hk_S _) (hGal_S σ z hz)
    have hW_eval : W_r = algebraMap L₂ L'_2 (c r) * α ^ (r : ℕ) * ι_k (d : k) := by
      dsimp [W_r]
      have hstep1 :
          (∑ σ : H₀, ι_k (((ψ_fn σ)⁻¹) ^ (r : ℕ)) * σ z) =
            ∑ σ : H₀, ∑ j : Fin d,
              algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ) *
                ι_k (((ψ_fn σ)⁻¹) ^ (r : ℕ) * (ψ_fn σ) ^ (j : ℕ)) := by
        refine Finset.sum_congr rfl fun σ _ => ?_
        conv_lhs => rw [hz_eq]
        rw [map_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_mul σ, σ.commutes, hσ_α σ (j : ℕ), ι_k.map_mul]
        ring
      rw [hstep1, Finset.sum_comm]
      have hstep2 :
          (∑ j : Fin d, ∑ σ : H₀,
            algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ) *
              ι_k (((ψ_fn σ)⁻¹) ^ (r : ℕ) * (ψ_fn σ) ^ (j : ℕ))) =
          ∑ j : Fin d,
            algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ) *
              ι_k (if j = r then (d : k) else 0) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← Finset.mul_sum, ← map_sum, hCharOrth r j]
      rw [hstep2, Finset.sum_eq_single r]
      · simp
      · intro j _ hjr
        simp [hjr]
      · intro hr_not
        exact absurd (Finset.mem_univ r) hr_not

    have hd_k_ne : (d : k) ≠ 0 := by rwa [← hcard_H₀]
    have hc_recover :
        algebraMap L₂ L'_2 (c r) = W_r * ι_k ((d : k)⁻¹) * (α⁻¹) ^ (r : ℕ) := by
      rw [hW_eval]
      have hd_inv : ι_k (d : k) * ι_k ((d : k)⁻¹) = 1 := by
        rw [← map_mul, mul_inv_cancel₀ hd_k_ne, map_one]
      have hα_inv : α ^ (r : ℕ) * (α⁻¹) ^ (r : ℕ) = 1 := by
        rw [← mul_pow, mul_inv_cancel₀ hα_ne, one_pow]
      calc
        algebraMap L₂ L'_2 (c r)
          = algebraMap L₂ L'_2 (c r) * (α ^ (r : ℕ) * (α⁻¹) ^ (r : ℕ)) *
              (ι_k (d : k) * ι_k ((d : k)⁻¹)) := by
                rw [hα_inv, hd_inv, mul_one, mul_one]
        _ = algebraMap L₂ L'_2 (c r) * α ^ (r : ℕ) * ι_k (d : k) *
              ι_k ((d : k)⁻¹) * (α⁻¹) ^ (r : ℕ) := by ring
    rw [hc_recover]
    exact S.mul_mem (S.mul_mem hW_mem (hk_S _)) (S.pow_mem hα_inv_S _)

  
  
  
  exact ⟨L'_2, instFieldL', instAlgK₂L', instFDK₂L', instGalK₂L',
    instAlgL₂L', instSTK₂L₂L', instFDL₂L', instGalL₂L',
    instAlgK'L', instFDK'L', instSepK'L', instAlgR'L', instSTR'K'L',
    ⟨hCompat, hIntCrit⟩, ⟨hd_ne_zero, hGalK₂⟩, hSubringSpan⟩

theorem weil_kummer_off_divisor_unramified (k : Type u) [Field k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂]
      (f₀ : A₀),
      Irreducible f₀ →
      ∀ (p : Fin 2 → k),
        (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
         let B₂_0 := integralClosure A₀ L₂
         @RingHom.Etale
           (Localization.Away f₀)
           (Localization.Away (algebraMap A₀ ↥B₂_0 f₀))
           inferInstance inferInstance
           (Localization.awayMap (algebraMap A₀ ↥B₂_0) f₀)) →
        ∀ (e : ℕ), 1 ≤ e → (e : k) ≠ 0 →
          ∀ (R'_p K'_2 L'_2 : Type u)
            [CommRing R'_p] [IsDomain R'_p]
            [Field K'_2] [Algebra R'_p K'_2] [IsFractionRing R'_p K'_2]
            [Field L'_2] [Algebra K₂ L'_2] [Algebra L₂ L'_2] [IsScalarTower K₂ L₂ L'_2]
            [Algebra K'_2 L'_2] [FiniteDimensional K'_2 L'_2]
            [Algebra R'_p L'_2] [IsScalarTower R'_p K'_2 L'_2]
            [Algebra k R'_p] [Algebra A₀ R'_p] [IsScalarTower k A₀ R'_p]
            (ϖ : R'_p),
            ϖ ≠ 0 →
            ϖ ^ e = algebraMap A₀ R'_p f₀ →
            (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
             let B₂_0 := integralClosure A₀ L₂
             (algebraMap R'_p L'_2).comp (algebraMap A₀ R'_p) =
               (algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)) ∧
             (∀ g : A₀, MvPolynomial.eval p g ≠ 0 → IsUnit (algebraMap A₀ R'_p g)) ∧
             (∀ x : L₂,
               IsIntegral R'_p (algebraMap L₂ L'_2 x) ↔
                 ∃ (y : ↥B₂_0) (g : A₀),
                   MvPolynomial.eval p g ≠ 0 ∧
                   x * algebraMap A₀ L₂ g = (y : L₂))) →
            (∀ σ : L'_2 ≃ₐ[L₂] L'_2,
               (∃ ζ : k, ζ ^ e = 1 ∧
                 σ (algebraMap R'_p L'_2 ϖ) =
                   algebraMap R'_p L'_2 (algebraMap k R'_p ζ * ϖ)) ∧
               (∀ r : R'_p, ∃ r' : R'_p,
                 σ (algebraMap R'_p L'_2 r) = algebraMap R'_p L'_2 r')) →
            (∀ (t : L₂), t ≠ 0 →
               ∀ (S : Subring L'_2),
                 (∀ c : k, algebraMap R'_p L'_2 (algebraMap k R'_p c) ∈ S) →
                 (∀ σ : L'_2 ≃ₐ[L₂] L'_2, ∀ z ∈ S, σ z ∈ S) →
                 let α : L'_2 := (algebraMap L₂ L'_2 t)⁻¹ * algebraMap R'_p L'_2 ϖ
                 α ∈ S → α⁻¹ ∈ S →
                 ∀ z ∈ S, ∃ (m : ℕ) (c : Fin m → L₂),
                   (∀ j : Fin m, algebraMap L₂ L'_2 (c j) ∈ S) ∧
                   z = ∑ j : Fin m, algebraMap L₂ L'_2 (c j) * α ^ (j : ℕ)) →
            ∀ (Q' : Ideal ↥(integralClosure R'_p L'_2)) [Q'.IsPrime],
              algebraMap R'_p ↥(integralClosure R'_p L'_2) ϖ ∉ Q' →
              Algebra.IsUnramifiedAt R'_p Q' :=
by
  intro A₀ K₂ L₂ _ _ _ f₀ hIrr_f₀ p hEtale_away e he_pos he_ne
    R'_p K'_2 L'_2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ ϖ hϖ_ne hϖ_pow
    hCompat hGal_σ hKummerOrth Q' _ hϖ_not_mem
  let _ : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
  let B₂_0 := integralClosure A₀ L₂
  let B'_p := integralClosure R'_p L'_2
  let ϖ_B : ↥B'_p := algebraMap R'_p ↥B'_p ϖ
  let ϖ_L : L'_2 := algebraMap R'_p L'_2 ϖ
  let f_B₂ : ↥B₂_0 := algebraMap A₀ ↥B₂_0 f₀
  let f_L₂ : L₂ := algebraMap A₀ L₂ f₀
  rcases hCompat with ⟨hAlgCompat, hLocalUnits, hIntCrit⟩
  have hf₀_ne : f₀ ≠ 0 := hIrr_f₀.ne_zero
  have hInj_A₀_L₂ : Function.Injective (algebraMap A₀ L₂) :=
    (algebraMap K₂ L₂).injective.comp (IsFractionRing.injective A₀ K₂)
  have hf_L₂_ne : f_L₂ ≠ 0 := by
    intro h0
    apply hf₀_ne
    apply hInj_A₀_L₂
    simpa [f_L₂] using h0
  have hInj_R'_L' : Function.Injective (algebraMap R'_p L'_2) := by
    rw [IsScalarTower.algebraMap_eq R'_p K'_2 L'_2]
    exact (algebraMap K'_2 L'_2).injective.comp (IsFractionRing.injective R'_p K'_2)
  have hϖ_L_ne : ϖ_L ≠ 0 := by
    intro h0
    apply hϖ_ne
    apply hInj_R'_L'
    simpa [ϖ_L] using h0
  have hCompat_apply : ∀ a : A₀,
      algebraMap R'_p L'_2 (algebraMap A₀ R'_p a) = algebraMap L₂ L'_2 (algebraMap A₀ L₂ a) := by
    intro a
    exact RingHom.congr_fun hAlgCompat a
  have hf_L'_eq : algebraMap L₂ L'_2 f_L₂ = ϖ_L ^ e := by
    dsimp [f_L₂, ϖ_L]
    rw [← hCompat_apply f₀, ← hϖ_pow, map_pow]
  have hϖ_B_coe : (ϖ_B : L'_2) = ϖ_L := Subalgebra.coe_algebraMap B'_p ϖ

  
  let S_ϖ : Subring L'_2 :=
    { carrier := { z : L'_2 | ∃ (b : ↥B'_p) (n : ℕ), z * ϖ_L ^ n = (b : L'_2) }
      mul_mem' := by
        rintro z₁ z₂ ⟨b₁, n₁, h₁⟩ ⟨b₂, n₂, h₂⟩
        refine ⟨b₁ * b₂, n₁ + n₂, ?_⟩
        calc
          (z₁ * z₂) * ϖ_L ^ (n₁ + n₂)
              = (z₁ * ϖ_L ^ n₁) * (z₂ * ϖ_L ^ n₂) := by rw [pow_add]; ring
          _ = (b₁ : L'_2) * (b₂ : L'_2) := by rw [h₁, h₂]
          _ = ((b₁ * b₂ : ↥B'_p) : L'_2) := rfl
      one_mem' := ⟨1, 0, by simp⟩
      add_mem' := by
        rintro z₁ z₂ ⟨b₁, n₁, h₁⟩ ⟨b₂, n₂, h₂⟩
        refine ⟨b₁ * ϖ_B ^ n₂ + b₂ * ϖ_B ^ n₁, n₁ + n₂, ?_⟩
        calc
          (z₁ + z₂) * ϖ_L ^ (n₁ + n₂)
              = (z₁ * ϖ_L ^ n₁) * ϖ_L ^ n₂ + (z₂ * ϖ_L ^ n₂) * ϖ_L ^ n₁ := by
                rw [pow_add]; ring
          _ = (b₁ : L'_2) * ϖ_L ^ n₂ + (b₂ : L'_2) * ϖ_L ^ n₁ := by rw [h₁, h₂]
          _ = ((b₁ * ϖ_B ^ n₂ + b₂ * ϖ_B ^ n₁ : ↥B'_p) : L'_2) := by
                simp [hϖ_B_coe]
      zero_mem' := ⟨0, 0, by simp⟩
      neg_mem' := by
        rintro z ⟨b, n, h⟩
        refine ⟨-b, n, ?_⟩
        calc
          (-z) * ϖ_L ^ n = -(z * ϖ_L ^ n) := by ring
          _ = -(b : L'_2) := by rw [h]
          _ = ((-b : ↥B'_p) : L'_2) := rfl }
  have hϖ_S : ϖ_L ∈ S_ϖ := ⟨ϖ_B, 0, by simp [hϖ_B_coe]⟩
  have hϖ_inv_S : ϖ_L⁻¹ ∈ S_ϖ := ⟨1, 1, by simp [inv_mul_cancel₀ hϖ_L_ne]⟩
  let ι_BS : ↥B'_p →+* ↥S_ϖ :=
    { toFun := fun b => ⟨(b : L'_2), ⟨b, 0, by simp⟩⟩
      map_one' := by apply Subtype.ext; rfl
      map_mul' := fun _ _ => by apply Subtype.ext; rfl
      map_zero' := by apply Subtype.ext; rfl
      map_add' := fun _ _ => by apply Subtype.ext; rfl }
  let ψ : R'_p →+* ↥S_ϖ := ι_BS.comp (algebraMap R'_p ↥B'_p)
  have hψ_coe : ∀ r : R'_p, (ψ r : L'_2) = algebraMap R'_p L'_2 r :=
    fun r => Subalgebra.coe_algebraMap B'_p r
  have hLoc_S : ∃ (e_loc : ↥S_ϖ ≃+* Localization.Away ϖ_B),
      e_loc.toRingHom.comp ψ = algebraMap R'_p (Localization.Away ϖ_B) := by
    let _ : Algebra ↥B'_p ↥S_ϖ := ι_BS.toAlgebra
    have hAlg_BS : algebraMap ↥B'_p ↥S_ϖ = ι_BS := rfl
    have hUnit_ϖ : IsUnit (algebraMap ↥B'_p ↥S_ϖ ϖ_B) := by
      refine ⟨⟨⟨ϖ_L, hϖ_S⟩, ⟨ϖ_L⁻¹, hϖ_inv_S⟩, ?_, ?_⟩, rfl⟩
      · apply Subtype.ext; exact mul_inv_cancel₀ hϖ_L_ne
      · apply Subtype.ext; exact inv_mul_cancel₀ hϖ_L_ne
    have _ : IsLocalization (Submonoid.powers ϖ_B) ↥S_ϖ :=
      { map_units := by
          rintro ⟨_, n, rfl⟩
          rw [map_pow]
          exact hUnit_ϖ.pow n
        surj := by
          intro z
          rcases z.2 with ⟨b, n, hz⟩
          refine ⟨(b, ⟨ϖ_B ^ n, n, rfl⟩), ?_⟩
          apply Subtype.ext
          simpa [hAlg_BS, ι_BS, hϖ_B_coe] using hz
        exists_of_eq := by
          intro b₁ b₂ h_eq
          have hb : b₁ = b₂ := by
            apply Subtype.ext
            exact congrArg (Subtype.val : ↥S_ϖ → L'_2) h_eq
          exact ⟨1, by rw [hb]⟩ }
    let e_alg := IsLocalization.algEquiv (Submonoid.powers ϖ_B) ↥S_ϖ (Localization.Away ϖ_B)
    refine ⟨e_alg.toRingEquiv, ?_⟩
    apply RingHom.ext
    intro r
    calc
      e_alg.toRingEquiv (ψ r)
          = e_alg (algebraMap ↥B'_p ↥S_ϖ (algebraMap R'_p ↥B'_p r)) := rfl
      _ = algebraMap ↥B'_p (Localization.Away ϖ_B) (algebraMap R'_p ↥B'_p r) :=
          e_alg.commutes (algebraMap R'_p ↥B'_p r)
      _ = algebraMap R'_p (Localization.Away ϖ_B) r :=
          (IsScalarTower.algebraMap_apply R'_p ↥B'_p (Localization.Away ϖ_B) r).symm
  rcases hLoc_S with ⟨e_loc, he_loc_comp⟩
  have hσ_S : ∀ σ : L'_2 ≃ₐ[L₂] L'_2, ∀ z ∈ S_ϖ, σ z ∈ S_ϖ := by
    intro σ z hz
    rcases hz with ⟨b, n, hz_eq⟩
    obtain ⟨⟨ζ, hζ_pow, hσ_ϖ⟩, hσ_R'⟩ := hGal_σ σ
    let ρ_fn : R'_p → R'_p := fun r => Classical.choose (hσ_R' r)
    have hρ_spec : ∀ r : R'_p, algebraMap R'_p L'_2 (ρ_fn r) = σ (algebraMap R'_p L'_2 r) :=
      fun r => (Classical.choose_spec (hσ_R' r)).symm
    let ρ : R'_p →+* R'_p :=
      { toFun := ρ_fn
        map_one' := hInj_R'_L' (by rw [hρ_spec, map_one, map_one])
        map_mul' := fun x y => hInj_R'_L' (by rw [hρ_spec, map_mul, map_mul, map_mul, hρ_spec, hρ_spec])
        map_zero' := hInj_R'_L' (by rw [hρ_spec, map_zero, map_zero])
        map_add' := fun x y => hInj_R'_L' (by rw [hρ_spec, map_add, map_add, map_add, hρ_spec, hρ_spec]) }
    have hρ_comp : (algebraMap R'_p L'_2).comp ρ = σ.toRingHom.comp (algebraMap R'_p L'_2) := by
      apply RingHom.ext
      intro r
      exact hρ_spec r
    have hb_int : IsIntegral R'_p (σ (b : L'_2)) := by
      rcases b.2 with ⟨P, hP_mon, hP_eval⟩
      refine ⟨P.map ρ, hP_mon.map ρ, ?_⟩
      rw [Polynomial.eval₂_map, hρ_comp]
      change Polynomial.eval₂ (σ.toRingHom.comp (algebraMap R'_p L'_2)) (σ.toRingHom (b : L'_2)) P = 0
      rw [← Polynomial.hom_eval₂, hP_eval, map_zero]
    have hζ_ne : ζ ≠ 0 := by
      intro hζ0
      rw [hζ0, zero_pow (by omega : e ≠ 0)] at hζ_pow
      exact zero_ne_one hζ_pow
    let ζ_L : L'_2 := algebraMap R'_p L'_2 (algebraMap k R'_p ζ)
    have hσ_ϖ' : σ ϖ_L = ζ_L * ϖ_L := by
      dsimp [ϖ_L, ζ_L]
      rw [hσ_ϖ, map_mul]
    let η_R : R'_p := algebraMap k R'_p ((ζ⁻¹) ^ n)
    have hηζ : algebraMap R'_p L'_2 η_R * ζ_L ^ n = 1 := by
      dsimp [η_R, ζ_L]
      rw [← map_pow, ← map_pow, ← map_mul, ← map_mul, ← mul_pow, inv_mul_cancel₀ hζ_ne,
        one_pow, map_one, map_one]
    refine ⟨algebraMap R'_p ↥B'_p η_R * ⟨σ (b : L'_2), hb_int⟩, n, ?_⟩
    have h_ap := congrArg σ hz_eq
    rw [map_mul, map_pow, hσ_ϖ', mul_pow] at h_ap
    calc
      σ z * ϖ_L ^ n
          = (algebraMap R'_p L'_2 η_R * ζ_L ^ n) * (σ z * ϖ_L ^ n) := by rw [hηζ, one_mul]
      _ = algebraMap R'_p L'_2 η_R * (σ z * (ζ_L ^ n * ϖ_L ^ n)) := by ring
      _ = algebraMap R'_p L'_2 η_R * σ (b : L'_2) := by rw [h_ap]
      _ = ((algebraMap R'_p ↥B'_p η_R * ⟨σ (b : L'_2), hb_int⟩ : ↥B'_p) : L'_2) := by
          simp

  
  let C_pf : Subring L₂ := S_ϖ.comap (algebraMap L₂ L'_2)
  have hB₂_mem_C : ∀ y : ↥B₂_0, (y : L₂) ∈ C_pf := by
    intro y
    have hInt : IsIntegral R'_p (algebraMap L₂ L'_2 (y : L₂)) := by
      rw [hIntCrit (y : L₂)]
      exact ⟨y, 1, by simp, by simp⟩
    exact ⟨⟨algebraMap L₂ L'_2 (y : L₂), hInt⟩, 0, by simp⟩
  let ι_B₂C : ↥B₂_0 →+* ↥C_pf :=
    { toFun := fun y => ⟨(y : L₂), hB₂_mem_C y⟩
      map_one' := by ext; rfl
      map_mul' := fun _ _ => by ext; rfl
      map_zero' := by ext; rfl
      map_add' := fun _ _ => by ext; rfl }
  have hf_B₂_coe : (ι_B₂C f_B₂ : L₂) = f_L₂ := Subalgebra.coe_algebraMap B₂_0 f₀
  have hf_inv_mem_C : f_L₂⁻¹ ∈ C_pf := by
    refine ⟨1, e, ?_⟩
    rw [map_inv₀, hf_L'_eq, inv_mul_cancel₀ (pow_ne_zero e hϖ_L_ne)]
    rfl
  have hu_f : IsUnit (ι_B₂C f_B₂) := by
    refine ⟨⟨ι_B₂C f_B₂, ⟨f_L₂⁻¹, hf_inv_mem_C⟩, ?_, ?_⟩, rfl⟩
    · ext; simpa [hf_B₂_coe] using mul_inv_cancel₀ hf_L₂_ne
    · ext; simpa [hf_B₂_coe] using inv_mul_cancel₀ hf_L₂_ne
  let φ_C : Localization.Away f_B₂ →+* ↥C_pf :=
    IsLocalization.Away.lift (S := Localization.Away f_B₂) f_B₂ hu_f
  have hφ_C_eq : ∀ y : ↥B₂_0, φ_C (algebraMap ↥B₂_0 (Localization.Away f_B₂) y) = ι_B₂C y :=
    fun y => IsLocalization.Away.lift_eq (S := Localization.Away f_B₂) f_B₂ hu_f y
  have hφ_C_unram :
      @RingHom.FormallyUnramified (Localization.Away f_B₂) ↥C_pf inferInstance inferInstance φ_C := by
    let _ : Algebra (Localization.Away f_B₂) ↥C_pf := φ_C.toAlgebra
    have hAlg_C : algebraMap (Localization.Away f_B₂) ↥C_pf = φ_C := rfl
    let U_p : Submonoid A₀ :=
      { carrier := { g : A₀ | MvPolynomial.eval p g ≠ 0 }
        one_mem' := by simp
        mul_mem' := by
          intro a b ha hb
          change MvPolynomial.eval p (a * b) ≠ 0
          rw [map_mul]
          exact mul_ne_zero ha hb }
    let α₀ : A₀ →+* Localization.Away f_B₂ :=
      (algebraMap ↥B₂_0 (Localization.Away f_B₂)).comp (algebraMap A₀ ↥B₂_0)
    let M_p : Submonoid (Localization.Away f_B₂) := U_p.map α₀
    have hφ_C_α₀ : ∀ a : A₀, (φ_C (α₀ a) : L₂) = algebraMap A₀ L₂ a := by
      intro a
      dsimp [α₀]
      rw [hφ_C_eq]
      exact Subalgebra.coe_algebraMap B₂_0 a
    have hφ_C_invSelf :
        (φ_C (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) : L₂) = f_L₂⁻¹ := by
      have hmul := congrArg (C_pf.subtype.comp φ_C)
        (IsLocalization.Away.mul_invSelf (S := Localization.Away f_B₂) f_B₂)
      simp only [RingHom.comp_apply, map_mul, map_one, hφ_C_eq] at hmul
      change (ι_B₂C f_B₂ : L₂) *
        (φ_C (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) : L₂) = 1 at hmul
      rw [hf_B₂_coe] at hmul
      calc
        (φ_C (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) : L₂)
            = f_L₂⁻¹ *
                (f_L₂ * (φ_C (IsLocalization.Away.invSelf (S := Localization.Away f_B₂) f_B₂) : L₂)) := by
              rw [← mul_assoc, inv_mul_cancel₀ hf_L₂_ne, one_mul]
        _ = f_L₂⁻¹ := by rw [hmul, mul_one]
    have _ : IsLocalization M_p ↥C_pf :=
      { map_units := by
          rintro ⟨_, g, hg_ev, rfl⟩
          have hg_ne : g ≠ 0 := by
            intro hg0
            apply hg_ev
            rw [hg0, map_zero]
          let g_L₂ : L₂ := algebraMap A₀ L₂ g
          have hg_L₂_ne : g_L₂ ≠ 0 := by
            intro h0
            apply hg_ne
            apply hInj_A₀_L₂
            simpa [g_L₂] using h0
          have hg_L'_ne : algebraMap L₂ L'_2 g_L₂ ≠ 0 :=
            fun h0 => hg_L₂_ne ((algebraMap L₂ L'_2).injective (by simpa using h0))
          rcases hLocalUnits g hg_ev with ⟨u_g, hu_g⟩
          have hu_mul : algebraMap L₂ L'_2 g_L₂ * algebraMap R'_p L'_2 (↑u_g⁻¹ : R'_p) = 1 := by
            dsimp [g_L₂]
            rw [← hCompat_apply g, ← hu_g, ← map_mul, Units.mul_inv, map_one]
          have hg_inv_C : g_L₂⁻¹ ∈ C_pf := by
            refine ⟨algebraMap R'_p ↥B'_p (↑u_g⁻¹ : R'_p), 0, ?_⟩
            rw [pow_zero, mul_one, map_inv₀]
            calc
              (algebraMap L₂ L'_2 g_L₂)⁻¹
                  = (algebraMap L₂ L'_2 g_L₂)⁻¹ *
                      (algebraMap L₂ L'_2 g_L₂ * algebraMap R'_p L'_2 (↑u_g⁻¹ : R'_p)) := by
                      rw [hu_mul, mul_one]
              _ = algebraMap R'_p L'_2 (↑u_g⁻¹ : R'_p) := by
                      rw [← mul_assoc, inv_mul_cancel₀ hg_L'_ne, one_mul]
              _ = (algebraMap R'_p ↥B'_p (↑u_g⁻¹ : R'_p) : L'_2) :=
                      (Subalgebra.coe_algebraMap B'_p _).symm
          refine ⟨⟨φ_C (α₀ g), ⟨g_L₂⁻¹, hg_inv_C⟩, ?_, ?_⟩, rfl⟩
          · apply Subtype.ext; simpa [hφ_C_α₀, g_L₂] using mul_inv_cancel₀ hg_L₂_ne
          · apply Subtype.ext; simpa [hφ_C_α₀, g_L₂] using inv_mul_cancel₀ hg_L₂_ne
        surj := by
          intro x
          rcases x.2 with ⟨b, n, hx⟩
          have hn_eq : n + n * (e - 1) = n * e := by
            rcases e with _ | e'
            · omega
            · simp; ring
          have hInt_xf : IsIntegral R'_p (algebraMap L₂ L'_2 (x.1 * f_L₂ ^ n)) := by
            have h_eq : algebraMap L₂ L'_2 (x.1 * f_L₂ ^ n) =
                ((b * ϖ_B ^ (n * (e - 1)) : ↥B'_p) : L'_2) := by
              calc
                algebraMap L₂ L'_2 (x.1 * f_L₂ ^ n)
                    = algebraMap L₂ L'_2 x.1 * (algebraMap L₂ L'_2 f_L₂) ^ n := by
                      rw [map_mul, map_pow]
                _ = algebraMap L₂ L'_2 x.1 * (ϖ_L ^ e) ^ n := by rw [hf_L'_eq]
                _ = algebraMap L₂ L'_2 x.1 * ϖ_L ^ (n * e) := by
                      rw [← pow_mul, mul_comm e n]
                _ = algebraMap L₂ L'_2 x.1 * ϖ_L ^ (n + n * (e - 1)) := by rw [← hn_eq]
                _ = (algebraMap L₂ L'_2 x.1 * ϖ_L ^ n) * ϖ_L ^ (n * (e - 1)) := by
                      rw [pow_add, mul_assoc]
