      rw [← CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ Φ_G.τ₃) hSE_U.extClass
          (Nat.add_zero 0) (Nat.zero_add 1) (by omega),
        hτ₃,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u (CategoryTheory.Abelian.Ext.mk₀ m_π))
          (CategoryTheory.Abelian.Ext.mk₀ (adj_u.counit.app Q)) (Nat.add_zero 0),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_u (CategoryTheory.Abelian.Ext.mk₀ m_π))
          (Nat.zero_add 0),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp]
      change (leray_u Q 0 (w₀.comp (CategoryTheory.Abelian.Ext.mk₀ m_π) (Nat.add_zero 0))).comp
        hSE_U.extClass (rfl : 0 + 1 = 1) = z
      rw [hw₀, hq_tilde_leray, hq₀_comp]
    | succ k ih =>
      
      intro G hZeroG z hz
      let I := CategoryTheory.Injective.under G
      let ι_G := CategoryTheory.Injective.ι G
      let Q := CategoryTheory.Limits.cokernel ι_G
      let π_G := CategoryTheory.Limits.cokernel.π ι_G
      let SC_U := CategoryTheory.ShortComplex.mk ι_G π_G (CategoryTheory.Limits.cokernel.condition ι_G)
      have hSE_U : SC_U.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι_G) inferInstance inferInstance
      have _ : CategoryTheory.Injective SC_U.X₂ := CategoryTheory.Injective.injective_under G
      have hIso_δ : ∀ q : ℕ, 1 ≤ q →
          CategoryTheory.IsIso (weilSingDevAlgBCConnHom u SC_U hSE_U q) := by
        intro q hq
        obtain ⟨_, h₂_q, h₃_q, _, hEx₂_q, hEx₃_q⟩ := (hBase.2.2.2 u SC_U hSE_U).2 q
        have hZq_I : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u q I) :=
          hInjAcyc I q hq
        have hZq1_I : CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage u (q + 1) I) :=
          hInjAcyc I (q + 1) (by omega)
        have hg_zero : weilEtaleHigherDirectImageMap u q π_G = 0 := hZq_I.eq_of_src _ 0
        have hf_zero : weilEtaleHigherDirectImageMap u (q + 1) ι_G = 0 := hZq1_I.eq_of_tgt _ 0
        haveI : CategoryTheory.Mono (weilSingDevAlgBCConnHom u SC_U hSE_U q) :=
