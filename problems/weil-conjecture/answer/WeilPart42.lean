          ψ_sm.comp MvPolynomial.C := hψ_cone_ι.trans hψ_sm_C.symm
      have hVtx : ∀ idx : Fin (m + 1) × Fin 2,
          ε₀ (ψ_cone (Ideal.Quotient.mk _ (MvPolynomial.X idx))) = 0 := by
        intro idx
        rw [← hπ₁_X idx]
        change (ε₀.comp (ψ_cone.comp π₁)) (Ideal.Quotient.mk _ (MvPolynomial.X idx)) = 0
        rw [← RingHom.mem_ker, hker_cone]
        exact hv₁_X idx
      exact hConeVsSmoothAlg κ m S₀ ε₀ ψ_sm ψ_cone hε_sm h_compat hEt_sm hEt_cone hVtx
    · intro R'₂ e_B₂ h₂ V'₂ v₂ e_Y₂ q₂ hEt_B₂ hEt_Y₂ hEt_q₂ hv₂ hcomm₂ idx₀
      by_contra hx₀_not_mem
      have _ := hEt_B₂; have _ := hEt_Y₂; have _ := hEt_q₂
      let P_R₂ : MvPolynomial (Fin (m + 1) × Fin 2) R'₂ :=
        (∑ j : Fin (m + 1), MvPolynomial.X (j, 0) * MvPolynomial.X (j, 1)) - MvPolynomial.C h₂
      let A₂ : CommRingCat.{u} :=
        CommRingCat.of (MvPolynomial (Fin (m + 1) × Fin 2) R'₂ ⧸ Ideal.span {P_R₂})
      let f₂ : R'₂ ⟶ A₂ := CommRingCat.ofHom ((Ideal.Quotient.mk _).comp MvPolynomial.C)
      obtain ⟨κ, _, χ₁, χ₂, hker_χ₁, _, hExtract⟩ :=
        hCommonEtalePointFiber g y₀ R'₁ A₁ f₁ e_B₁ V'₁ v₁ e_Y₁ q₁ hv₁ hcomm₁
          R'₂ A₂ f₂ e_B₂ V'₂ v₂ e_Y₂ q₂ hv₂ hcomm₂
      let _ : Field κ := ‹Field κ›
      have hχ₁_h₁ : χ₁ h₁ = 0 := by
        rw [← RingHom.mem_ker, hker_χ₁]
        exact hh₁_mem
      let Q_quad : MvPolynomial (Fin (m + 1) × Fin 2) κ :=
