            intro i; rw [mul_assoc]
            have hz : δ x (b i) * δ (bDual i) y = 0 := hSqZero _ _ (hφδ x (b i)) (hφδ (bDual i) y)
            dsimp [δ] at hz; linear_combination -hz
          simp_rw [hstep1]
          have hstep2 : ∀ i : Fin n,
              δ x (b i) * ℓ (bDual i * y) =
                ∑ j : Fin n, (Algebra.trace R S ((y * b j) * bDual i) • δ x (b i)) * ℓ (bDual j) := by
            intro i; conv_lhs => rw [← hExp2 (bDual i * y)]; rw [map_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            have hcomm_arg : (bDual i * y) * b j = (y * b j) * bDual i := by ring
            rw [hcomm_arg, LinearMap.map_smul, mul_smul_comm, smul_mul_assoc]
          simp_rw [hstep2]; rw [Finset.sum_comm]; refine Finset.sum_congr rfl fun j _ => ?_
          rw [← Finset.sum_mul]; congr 1
          have hδ_lin : ∀ (r : R) (v : S), r • δ x v = ℓ (x * (r • v)) - ℓ x * ℓ (r • v) := by
            intro r v; dsimp [δ]
            rw [mul_smul_comm, LinearMap.map_smul, LinearMap.map_smul, mul_smul_comm, smul_sub]
          simp_rw [hδ_lin, Finset.sum_sub_distrib, ← map_sum, ← Finset.mul_sum, ← map_sum]
          have hexp_ybj : (∑ i : Fin n, Algebra.trace R S ((y * b j) * bDual i) • b i) = y * b j := by
            have hcomm_tr : ∀ i : Fin n, (y * b j) * bDual i = bDual i * (y * b j) := fun i => mul_comm _ _
            simp_rw [hcomm_tr]; exact hExp1 (y * b j)
          rw [hexp_ybj]
