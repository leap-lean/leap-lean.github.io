    let π_V : ∀ E₀ : V_U.Etale, M_w'.obj E₀ ⟶ W_u := fun E₀ =>
      CategoryTheory.MorphismProperty.Over.homMk E₀.hom rfl trivial
    let κ_inv : ∀ E₀ : V_U.Etale, Z_σ (M_w'.obj E₀) (π_V E₀) ⟶ E₀ := fun E₀ =>
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 E₀.left) (Category.id_comp E₀.hom) trivial
    let lam_σ : ∀ (Z₀ : Z_U.Etale) (σ : Z₀ ⟶ W_u), Z₀ ⟶ M_w'.obj (Z_σ Z₀ σ) := fun Z₀ σ =>
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 Z₀.left)
