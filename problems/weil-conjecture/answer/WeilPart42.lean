        have hd : m 0 + m 1 ≤ D := le_trans (hdeg_le p m hm) hD
        have hpm : algebraMap A K₂ (MvPolynomial.monomial m (p.coeff m)) =
            algebraMap k K₂ (p.coeff m) * (x₁ ^ m 0 * x₂ ^ m 1) := by
          have hm_eq : m = mkMon (m 0) (m 1) := by ext i; fin_cases i <;> simp [mkMon]
          have hmon_eq : MvPolynomial.monomial m (p.coeff m) =
              MvPolynomial.monomial (mkMon (m 0) (m 1)) (p.coeff m) := by rw [← hm_eq]
          rw [hmon_eq, hmon_K₂]
        have hX0 : φ_K₂ 1 (MvPolynomial.X 0) = 1 / x₁ := by
          dsimp [φ_K₂, homCoord]; rw [MvPolynomial.aeval_X]; rfl
        rw [hpm, hX0, MvPolynomial.aeval_monomial]
        have hprod : (f1 m).prod (fun j e => (homCoord ((1 : Fin 3).succAbove j) / homCoord 1) ^ e) =
            (1 / x₁) ^ (D - (m 0 + m 1)) * (x₂ / x₁) ^ m 1 := by
          rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two, hmkMon0, hmkMon1]; rfl
        rw [hprod, mul_assoc, hdiv_pow_inv x₁ x₂ hx₁_ne D (m 0) (m 1) hd]
    have hflip2 : ∀ (p : A) (D : ℕ), p.totalDegree ≤ D →
        (∃ q : A, (p ≠ 0 → q ≠ 0) ∧ x₂ ^ D * φ_K₂ 2 p = algebraMap A K₂ q) ∧
        (∃ q' : A, algebraMap A K₂ p * (φ_K₂ 2 (MvPolynomial.X 0)) ^ D = φ_K₂ 2 q') := by
      intro p D hD; refine ⟨?_, ?_⟩
      · let f2 : (Fin 2 →₀ ℕ) → (Fin 2 →₀ ℕ) := fun m => mkMon (m 1) (D - (m 0 + m 1))
        let q : A := ∑ m ∈ p.support, MvPolynomial.monomial (f2 m) (p.coeff m)
        have hf2_inj : ∀ m₁ ∈ p.support, ∀ m₂ ∈ p.support, f2 m₁ = f2 m₂ → m₁ = m₂ := by
          intro m₁ hm₁ m₂ hm₂ heq
          have h0 : f2 m₁ 0 = f2 m₂ 0 := congrArg (fun f => f 0) heq
          have h1 : f2 m₁ 1 = f2 m₂ 1 := congrArg (fun f => f 1) heq
          dsimp [f2] at h0 h1; rw [hmkMon0, hmkMon0] at h0; rw [hmkMon1, hmkMon1] at h1
          have hd₁ : m₁ 0 + m₁ 1 ≤ D := le_trans (hdeg_le p m₁ hm₁) hD
          have hd₂ : m₂ 0 + m₂ 1 ≤ D := le_trans (hdeg_le p m₂ hm₂) hD
          ext i; fin_cases i
          · change m₁ 0 = m₂ 0; omega
          · change m₁ 1 = m₂ 1; omega
        refine ⟨q, ?_, ?_⟩
        · intro hp_ne hq0
          obtain ⟨m₀, hm₀⟩ := MvPolynomial.support_nonempty.mpr hp_ne
          have hc : q.coeff (f2 m₀) = p.coeff m₀ := by
            dsimp [q]; rw [MvPolynomial.coeff_sum]; simp_rw [MvPolynomial.coeff_monomial]
            rw [Finset.sum_eq_single m₀]
            · simp
            · intro m hm hne; rw [if_neg]; exact fun heq => hne (hf2_inj m hm m₀ hm₀ heq)
            · intro hnot; exact absurd hm₀ hnot
          rw [hq0, MvPolynomial.coeff_zero] at hc
          exact (MvPolynomial.mem_support_iff.mp hm₀) hc.symm
        · conv_lhs => rw [MvPolynomial.as_sum p]
          rw [map_sum, Finset.mul_sum]; dsimp [q]; rw [map_sum]
          refine Finset.sum_congr rfl fun m hm => ?_
          have hd : m 0 + m 1 ≤ D := le_trans (hdeg_le p m hm) hD
          rw [hmon_K₂, MvPolynomial.aeval_monomial]
          have hprod : m.prod (fun j e => (homCoord ((2 : Fin 3).succAbove j) / homCoord 2) ^ e) =
              (1 / x₂) ^ m 0 * (x₁ / x₂) ^ m 1 := by
            rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]; rfl
          rw [hprod]
          calc
            x₂ ^ D * (algebraMap k K₂ (p.coeff m) * ((1 / x₂) ^ m 0 * (x₁ / x₂) ^ m 1))
                = algebraMap k K₂ (p.coeff m) * (x₂ ^ D * ((1 / x₂) ^ m 0 * (x₁ / x₂) ^ m 1)) := by ring
            _ = algebraMap k K₂ (p.coeff m) * (x₂ ^ (D - (m 0 + m 1)) * x₁ ^ m 1) := by
                rw [hdiv_pow_fwd x₂ x₁ hx₂_ne D (m 0) (m 1) hd]
            _ = algebraMap k K₂ (p.coeff m) * (x₁ ^ m 1 * x₂ ^ (D - (m 0 + m 1))) := by ring
      · let f2' : (Fin 2 →₀ ℕ) → (Fin 2 →₀ ℕ) := fun m => mkMon (D - (m 0 + m 1)) (m 0)
        let q' : A := ∑ m ∈ p.support, MvPolynomial.monomial (f2' m) (p.coeff m)
        refine ⟨q', ?_⟩
        conv_lhs => rw [MvPolynomial.as_sum p]
        rw [map_sum, Finset.sum_mul]; dsimp [q']; rw [map_sum]
        refine Finset.sum_congr rfl fun m hm => ?_
        have hd : m 0 + m 1 ≤ D := le_trans (hdeg_le p m hm) hD
        have hpm : algebraMap A K₂ (MvPolynomial.monomial m (p.coeff m)) =
            algebraMap k K₂ (p.coeff m) * (x₁ ^ m 0 * x₂ ^ m 1) := by
          have hm_eq : m = mkMon (m 0) (m 1) := by ext i; fin_cases i <;> simp [mkMon]
          have hmon_eq : MvPolynomial.monomial m (p.coeff m) =
              MvPolynomial.monomial (mkMon (m 0) (m 1)) (p.coeff m) := by rw [← hm_eq]
          rw [hmon_eq, hmon_K₂]
        have hX0 : φ_K₂ 2 (MvPolynomial.X 0) = 1 / x₂ := by
          dsimp [φ_K₂, homCoord]; rw [MvPolynomial.aeval_X]; rfl
        rw [hpm, hX0, MvPolynomial.aeval_monomial]
        have hprod : (f2' m).prod (fun j e => (homCoord ((2 : Fin 3).succAbove j) / homCoord 2) ^ e) =
            (1 / x₂) ^ (D - (m 0 + m 1)) * (x₁ / x₂) ^ m 0 := by
          rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two, hmkMon0, hmkMon1]; rfl
        have hd' : m 1 + m 0 ≤ D := by omega
        have hsub_eq : D - (m 1 + m 0) = D - (m 0 + m 1) := by omega
        rw [hprod]
        calc
          algebraMap k K₂ (p.coeff m) * (x₁ ^ m 0 * x₂ ^ m 1) * (1 / x₂) ^ D
              = algebraMap k K₂ (p.coeff m) * ((x₂ ^ m 1 * x₁ ^ m 0) * (1 / x₂) ^ D) := by ring
          _ = algebraMap k K₂ (p.coeff m) * ((1 / x₂) ^ (D - (m 1 + m 0)) * (x₁ / x₂) ^ m 0) := by
              rw [hdiv_pow_inv x₂ x₁ hx₂_ne D (m 1) (m 0) hd']
          _ = algebraMap k K₂ (p.coeff m) * ((1 / x₂) ^ (D - (m 0 + m 1)) * (x₁ / x₂) ^ m 0) := by
              rw [hsub_eq]
    have hφ_inj : ∀ c : Fin 3, Function.Injective (φ_K₂ c) := by
      intro c p₁ p₂ heq
      have h0 : φ_K₂ c (p₁ - p₂) = 0 := by rw [map_sub, heq, sub_self]
      suffices hp : p₁ - p₂ = 0 by exact sub_eq_zero.mp hp
      set p := p₁ - p₂; by_contra hp_ne
      fin_cases c
      · change φ_K₂ 0 p = 0 at h0
        have h0' : algebraMap A K₂ p = 0 := by rw [← hφ0_eq]; exact h0
        exact hp_ne (IsFractionRing.injective A K₂ (h0'.trans (map_zero _).symm))
      · change φ_K₂ 1 p = 0 at h0
        obtain ⟨q, hq_ne, hq_eq, _⟩ := hflip1 p p.totalDegree le_rfl
        rw [h0, mul_zero] at hq_eq
        exact hq_ne hp_ne (IsFractionRing.injective A K₂ (hq_eq.symm.trans (map_zero _).symm))
      · change φ_K₂ 2 p = 0 at h0
        obtain ⟨⟨q, hq_ne, hq_eq⟩, _⟩ := hflip2 p p.totalDegree le_rfl
        rw [h0, mul_zero] at hq_eq
        exact hq_ne hp_ne (IsFractionRing.injective A K₂ (hq_eq.symm.trans (map_zero _).symm))
    have hsurj_std : ∀ z : K₂, ∃ x : A × nonZeroDivisors A,
        z * algebraMap A K₂ x.2.1 = algebraMap A K₂ x.1 :=
      fun z => IsLocalization.surj (nonZeroDivisors A) z
    have hinj_std : Function.Injective (algebraMap A K₂) := IsFractionRing.injective A K₂
    let map_std : A →+* K₂ := algebraMap A K₂
    have hFrac : ∀ c : Fin 3,
        letI : Algebra A K₂ := (φ_K₂ c).toRingHom.toAlgebra
        IsFractionRing A K₂ := by
      intro c; letI : Algebra A K₂ := (φ_K₂ c).toRingHom.toAlgebra
      have halg_c : ∀ p : A, algebraMap A K₂ p = φ_K₂ c p := fun _ => rfl
      refine
        { map_units := fun s => by
            rw [halg_c]; refine IsUnit.mk0 _ fun h0 => ?_
            exact mem_nonZeroDivisors_iff_ne_zero.mp s.2 (hφ_inj c (h0.trans (map_zero _).symm))
          surj := fun z => by
            obtain ⟨⟨num, den⟩, hz⟩ := hsurj_std z; dsimp only at hz
            have hden_ne : den.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp den.2
            have hden_K₂ : map_std den.1 ≠ 0 := fun h0 => hden_ne (hinj_std (h0.trans (map_zero _).symm))
            fin_cases c
            · refine ⟨⟨num, den⟩, ?_⟩; dsimp only
              change z * (φ_K₂ 0).toRingHom den.1 = (φ_K₂ 0).toRingHom num; rw [hφ0_eq]; exact hz
            · let D := max num.totalDegree den.1.totalDegree
              obtain ⟨q_num, _, _, hq_num⟩ := hflip1 num D (le_max_left _ _)
              obtain ⟨q_den, hq_den_ne, _, hq_den⟩ := hflip1 den.1 D (le_max_right _ _)
              refine ⟨⟨q_num, ⟨q_den, mem_nonZeroDivisors_iff_ne_zero.mpr (hq_den_ne hden_ne)⟩⟩, ?_⟩
              dsimp only; change z * φ_K₂ 1 q_den = φ_K₂ 1 q_num
              rw [← hq_den, ← hq_num, ← mul_assoc]; change (z * map_std den.1) * _ = _; rw [hz]
            · let D := max num.totalDegree den.1.totalDegree
              obtain ⟨_, ⟨q_num, hq_num⟩⟩ := hflip2 num D (le_max_left _ _)
              obtain ⟨_, ⟨q_den, hq_den⟩⟩ := hflip2 den.1 D (le_max_right _ _)
              have hX0_ne : φ_K₂ 2 (MvPolynomial.X 0) ≠ 0 := fun h0 =>
                MvPolynomial.X_ne_zero (R := k) (0 : Fin 2) (hφ_inj 2 (h0.trans (map_zero _).symm))
              have hq_den_ne : q_den ≠ 0 := by
                intro h0; rw [h0, map_zero] at hq_den
                exact mul_ne_zero hden_K₂ (pow_ne_zero D hX0_ne) hq_den
              refine ⟨⟨q_num, ⟨q_den, mem_nonZeroDivisors_iff_ne_zero.mpr hq_den_ne⟩⟩, ?_⟩
              dsimp only; change z * φ_K₂ 2 q_den = φ_K₂ 2 q_num
              rw [← hq_den, ← hq_num, ← mul_assoc]; change (z * map_std den.1) * _ = _; rw [hz]
          exists_of_eq := fun {p₁ p₂} hp => by rw [halg_c, halg_c] at hp; exact ⟨1, by simp [hφ_inj c hp]⟩ }
    have hNeZero : ∀ (d_disc : ℕ) (F_disc_hom : MvPolynomial (Fin 3) k),
        F_disc_hom.IsHomogeneous d_disc →
        Irreducible (eval_c 0 F_disc_hom) →
        ∀ c : Fin 3, eval_c c F_disc_hom ≠ 0 := by
      intro d_disc F_disc_hom hHom hIrr0 c
      have hcomp : ∀ c' : Fin 3,
          (φ_K₂ c').comp (eval_c c') = MvPolynomial.aeval (fun i : Fin 3 => homCoord i / homCoord c') := by
        intro c'; apply MvPolynomial.algHom_ext; intro i
        rcases Fin.eq_self_or_eq_succAbove c' i with rfl | ⟨j, rfl⟩
        · simp [eval_c, div_self (hhom_ne i)]
        · simp [eval_c, φ_K₂]
      have hscale : ∀ c' : Fin 3,
          φ_K₂ c' (eval_c c' F_disc_hom) =
            (homCoord c')⁻¹ ^ d_disc * MvPolynomial.aeval homCoord F_disc_hom := by
        intro c'; change ((φ_K₂ c').comp (eval_c c')) F_disc_hom = _; rw [hcomp c']
        conv_lhs => rw [MvPolynomial.as_sum F_disc_hom]
        conv_rhs => rw [MvPolynomial.as_sum F_disc_hom]
        rw [map_sum, map_sum, Finset.mul_sum]; refine Finset.sum_congr rfl fun m hm => ?_
        have hm_deg : ∑ i : Fin 3, m i = d_disc := by
          have hw := hHom (MvPolynomial.mem_support_iff.mp hm)
          change (m.sum fun i e => e • (1 : ℕ)) = d_disc at hw
          rw [Finsupp.sum_fintype _ _ (fun _ => by simp)] at hw; simpa using hw
        rw [MvPolynomial.aeval_monomial, MvPolynomial.aeval_monomial,
          Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
        have hdiv_prod : (∏ i : Fin 3, (homCoord i / homCoord c') ^ m i) =
            (homCoord c')⁻¹ ^ d_disc * ∏ i : Fin 3, homCoord i ^ m i := by
          simp_rw [div_eq_mul_inv, mul_pow]
          rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hm_deg, mul_comm]
        rw [hdiv_prod]; ring
      have haeval_ne : MvPolynomial.aeval homCoord F_disc_hom ≠ 0 := by
        have h0 := hscale 0; dsimp [homCoord] at h0; rw [inv_one, one_pow, one_mul] at h0
        rw [← h0]; intro hz; exact hIrr0.ne_zero (hφ_inj 0 (hz.trans (map_zero _).symm))
      intro hc0; have hsc := hscale c; rw [hc0, map_zero] at hsc
      exact mul_ne_zero (pow_ne_zero d_disc (inv_ne_zero (hhom_ne c))) haeval_ne hsc.symm
    have hRegMax : ∀ (𝔪 : Ideal A) (h𝔪 : 𝔪.IsMaximal),
        letI : 𝔪.IsPrime := h𝔪.isPrime
        ∃ t₁ t₂ : Localization.AtPrime 𝔪,
          t₁ ≠ 0 ∧ (Ideal.span {t₁}).IsPrime ∧ t₂ ∉ Ideal.span {t₁} ∧
          IsLocalRing.maximalIdeal (Localization.AtPrime 𝔪) = Ideal.span {t₁, t₂} := by
      intro 𝔪 h𝔪; letI : 𝔪.IsPrime := h𝔪.isPrime
      obtain ⟨p, hp⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp h𝔪
      let u₀ : A := MvPolynomial.X 0 - MvPolynomial.C (p 0)
      let u₁ : A := MvPolynomial.X 1 - MvPolynomial.C (p 1)
      have h𝔪_eq : 𝔪 = Ideal.span {u₀, u₁} := by
        apply le_antisymm
        · intro f hf
          rw [hp, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hf
          change MvPolynomial.eval p f = 0 at hf
          let I₀ : Ideal A := Ideal.span {u₀, u₁}
          let π₀ : A →+* A ⧸ I₀ := Ideal.Quotient.mk I₀
          have hu₀_mem : u₀ ∈ I₀ := Ideal.subset_span (by simp)
          have hu₁_mem : u₁ ∈ I₀ := Ideal.subset_span (by simp)
          have hπ₀_X0 : π₀ (MvPolynomial.X 0) = π₀ (MvPolynomial.C (p 0)) := by
            rw [← sub_eq_zero, ← map_sub]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr hu₀_mem
          have hπ₀_X1 : π₀ (MvPolynomial.X 1) = π₀ (MvPolynomial.C (p 1)) := by
            rw [← sub_eq_zero, ← map_sub]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr hu₁_mem
          have hπ₀_eq : π₀ = (π₀.comp MvPolynomial.C).comp (MvPolynomial.eval p) := by
            apply MvPolynomial.ringHom_ext
            · intro r
              simp
            · intro j
              fin_cases j
              · simp [hπ₀_X0]
              · simp [hπ₀_X1]
          have hπf : π₀ f = 0 := by rw [RingHom.congr_fun hπ₀_eq f]; simp [hf]
          exact Ideal.Quotient.eq_zero_iff_mem.mp hπf
        · rw [Ideal.span_le]
          rintro g (rfl | rfl) <;>
            rw [SetLike.mem_coe, hp, MvPolynomial.mem_vanishingIdeal_singleton_iff] <;>
            simp [u₀, u₁]
      have hu₀_ne : u₀ ≠ 0 := by
        intro h0; have hev := congrArg (MvPolynomial.eval ![p 0 + 1, 0]) h0; simp [u₀] at hev
      let ev₀ : A →+* Polynomial k :=
        (MvPolynomial.aeval ![Polynomial.C (p 0), Polynomial.X]).toRingHom
      have hker_ev₀ : RingHom.ker ev₀ = Ideal.span {u₀} := by
        apply le_antisymm
        · intro f hf; change ev₀ f = 0 at hf
          let I₁ : Ideal A := Ideal.span {u₀}
          let π₁ : A →+* A ⧸ I₁ := Ideal.Quotient.mk I₁
          have hπ₁_X0 : π₁ (MvPolynomial.X 0) = π₁ (MvPolynomial.C (p 0)) := by
            rw [← sub_eq_zero, ← map_sub]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
          let lift₁ : Polynomial k →+* A ⧸ I₁ :=
            Polynomial.eval₂RingHom (π₁.comp MvPolynomial.C) (π₁ (MvPolynomial.X 1))
          have hcomp₁ : lift₁.comp ev₀ = π₁ := by
            apply MvPolynomial.ringHom_ext
            · intro r
              simp [lift₁, ev₀]
            · intro j
              fin_cases j
              · simp [lift₁, ev₀, hπ₁_X0]
              · simp [lift₁, ev₀]
          have hπ₁f : π₁ f = 0 := by rw [← RingHom.congr_fun hcomp₁ f]; simp [hf]
          exact Ideal.Quotient.eq_zero_iff_mem.mp hπ₁f
        · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
          change (MvPolynomial.aeval ![Polynomial.C (p 0), Polynomial.X]) u₀ = 0
          dsimp [u₀]; rw [map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]; simp
      have hu₀_prime : (Ideal.span {u₀}).IsPrime := by rw [← hker_ev₀]; exact RingHom.ker_isPrime ev₀
      have hu₁_not_mem : u₁ ∉ Ideal.span {u₀} := by
        rw [← hker_ev₀, RingHom.mem_ker]
        change (MvPolynomial.aeval ![Polynomial.C (p 0), Polynomial.X]) u₁ ≠ 0
        dsimp [u₁]; rw [map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
        exact Polynomial.X_sub_C_ne_zero (p 1)
      let R_loc := Localization.AtPrime 𝔪
      let t₁ : R_loc := algebraMap A R_loc u₀
      let t₂ : R_loc := algebraMap A R_loc u₁
      have hdisj : Disjoint (𝔪.primeCompl : Set A) (Ideal.span {u₀} : Set A) := by
        rw [Set.disjoint_left]; intro s hs hsu; apply hs; rw [h𝔪_eq]
        exact Ideal.span_mono (by simp) hsu
      have hmap_u₀ : (Ideal.span {u₀}).map (algebraMap A R_loc) = Ideal.span {t₁} := by
        rw [Ideal.map_span, Set.image_singleton]
      refine ⟨t₁, t₂, ?_, ?_, ?_, ?_⟩
      · intro ht₁
        exact hu₀_ne (IsLocalization.injective R_loc 𝔪.primeCompl_le_nonZeroDivisors
          (ht₁.trans (map_zero _).symm))
      · rw [← hmap_u₀]
        exact IsLocalization.isPrime_of_isPrime_disjoint 𝔪.primeCompl R_loc
          (Ideal.span {u₀}) hu₀_prime hdisj
      · intro ht₂; rw [← hmap_u₀] at ht₂
        have hmem : u₁ ∈ Ideal.under A ((Ideal.span {u₀}).map (algebraMap A R_loc)) := ht₂
        rw [IsLocalization.comap_map_of_isPrime_disjoint 𝔪.primeCompl R_loc hu₀_prime hdisj] at hmem
        exact hu₁_not_mem hmem
      · rw [← Localization.AtPrime.map_eq_maximalIdeal]
        refine (congrArg (Ideal.map (algebraMap A R_loc)) h𝔪_eq).trans ?_
        rw [Ideal.map_span, Set.image_pair]
    have hHt1 : ∀ 𝔭 𝔪 : Ideal A,
        𝔭.IsPrime → 𝔪.IsMaximal → 𝔭 ≤ 𝔪 → 𝔭 ≠ ⊥ → 𝔭 ≠ 𝔪 →
        ∃ H_D : A, Irreducible H_D ∧ 𝔭 = Ideal.span {H_D} := by
      intro 𝔭 𝔪 h𝔭 h𝔪 hle hne_bot hne_max
      obtain ⟨H_D, hH_mem, hH_prime⟩ := h𝔭.exists_mem_prime_of_ne_bot hne_bot
      refine ⟨H_D, hH_prime.irreducible, ?_⟩
      have hspan_le : Ideal.span {H_D} ≤ 𝔭 := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hH_mem)
      by_contra hne_span
      have hlt0 : (⊥ : Ideal A) < Ideal.span {H_D} := by
        rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]; exact hH_prime.ne_zero
      have hlt1 : Ideal.span {H_D} < 𝔭 := lt_of_le_of_ne hspan_le (Ne.symm hne_span)
      have hlt2 : 𝔭 < 𝔪 := lt_of_le_of_ne hle hne_max
      have hH_ideal_prime : (Ideal.span {H_D}).IsPrime :=
        (Ideal.span_singleton_prime hH_prime.ne_zero).mpr hH_prime
      haveI : 𝔪.IsPrime := h𝔪.isPrime
      let ser : LTSeries (PrimeSpectrum A) :=
