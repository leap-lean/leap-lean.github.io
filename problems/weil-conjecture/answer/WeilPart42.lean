      let _ : CommRing S₀ := ‹CommRing S₀›
      let C₂_ring := MvPolynomial (Fin (m + 1) × Fin 2) κ ⧸ Ideal.span {Q_c₂}
      let x₀_κ : C₂_ring := Ideal.Quotient.mk _ (MvPolynomial.X idx₀)
      let s₀ : S₀ := ψ_cone₂ x₀_κ
      have hε₀_s₀_ne : ε₀ s₀ ≠ 0 := by
        intro h0
        apply hx₀_not_mem
        rw [← hker_cone₂, RingHom.mem_ker]
        change ε₀ (ψ_cone₂ (π₂ (Ideal.Quotient.mk _ (MvPolynomial.X idx₀)))) = 0
        rwa [hπ₂_X idx₀]
      let S := Localization.Away s₀
      let ε_S : S →+* κ := IsLocalization.Away.lift s₀ (isUnit_iff_ne_zero.mpr hε₀_s₀_ne)
      have hs₀_unit_S : IsUnit (((algebraMap S₀ S).comp ψ_cone₂) x₀_κ) :=
