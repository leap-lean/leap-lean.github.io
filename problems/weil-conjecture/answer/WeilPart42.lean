      Finite ↥A_triv ∧
      Nonempty (ℋ ≅ (CategoryTheory.constantSheaf
        (AlgebraicGeometry.Spec (CommRingCat.of B)).smallEtaleTopology
        AddCommGrpCat.{u}).obj A_triv) :=
by
  classical
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
  let isoToAddEquiv : ∀ {G₁ G₂ : AddCommGrpCat.{u}}, (G₁ ≅ G₂) → (↥G₁ ≃+ ↥G₂) := fun e =>
    { toFun := e.hom.hom
      invFun := e.inv.hom
      left_inv := fun x => ConcreteCategory.congr_hom e.hom_inv_id x
      right_inv := fun y => ConcreteCategory.congr_hom e.inv_hom_id y
      map_add' := map_add e.hom.hom }
  
  have hDomShrink : ∀ (D : Type u) [CommRing D] [Algebra B D] [Algebra.Etale B D]
      (Q : Ideal D) [Q.IsPrime],
      ∃ s₀ : D,
        s₀ ∉ Q ∧
        IsDomain (Localization.Away s₀) ∧
        (Ideal.map (algebraMap D (Localization.Away s₀)) Q).IsPrime ∧
        Ideal.comap (algebraMap D (Localization.Away s₀))
          (Ideal.map (algebraMap D (Localization.Away s₀)) Q) = Q := by
    intro D _ _ _ Q _
    let p : Ideal B := Ideal.comap (algebraMap B D) Q
    have : p.IsPrime := Ideal.comap_isPrime (algebraMap B D) Q
    let R := Localization.AtPrime p
    let S := Localization.AtPrime Q
    let _ : Algebra R S := (Localization.localRingHom p Q (algebraMap B D) rfl).toAlgebra
    have : IsLocalHom (algebraMap R S) :=
      Localization.isLocalHom_localRingHom p Q (algebraMap B D) rfl
    have : IsScalarTower B R S :=
      IsScalarTower.of_algebraMap_eq fun b =>
        (IsScalarTower.algebraMap_apply B D S b).trans
          (Localization.localRingHom_to_map p Q (algebraMap B D) rfl b).symm
    have : IsNoetherianRing D := Algebra.FiniteType.isNoetherianRing B D
    have : IsNoetherianRing S := IsLocalization.isNoetherianRing Q.primeCompl S inferInstance
    have : Algebra.FormallyUnramified D S := Algebra.FormallyUnramified.of_isLocalization Q.primeCompl
    have : Algebra.FormallyUnramified B S := Algebra.FormallyUnramified.comp B D S
    have : Algebra.FormallyUnramified R S := Algebra.FormallyUnramified.of_restrictScalars B R S
    have : Algebra.EssFiniteType B D := Algebra.EssFiniteType.of_finiteType B D
    have : Algebra.EssFiniteType D S := Algebra.EssFiniteType.of_isLocalization S Q.primeCompl
    have : Algebra.EssFiniteType B S := Algebra.EssFiniteType.comp B D S
    have : Algebra.EssFiniteType R S := Algebra.EssFiniteType.of_comp B R S
    have h_max : Ideal.map (algebraMap R S) (IsLocalRing.maximalIdeal R) =
        IsLocalRing.maximalIdeal S :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hDomS : IsDomain S := by
      by_cases hp : p = ⊥
      · have hmR : IsLocalRing.maximalIdeal R = ⊥ :=
          Localization.AtPrime.map_eq_maximalIdeal.symm.trans
            ((congrArg (Ideal.map (algebraMap B R)) hp).trans Ideal.map_bot)
        have hmS : IsLocalRing.maximalIdeal S = ⊥ := by
          rw [← h_max, hmR, Ideal.map_bot]
        have hNZD : NoZeroDivisors S := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · have hx_unit : IsUnit x := by
              apply IsLocalRing.notMem_maximalIdeal.mp
              rw [hmS]
              exact hx
            exact Or.inr (hx_unit.mul_left_cancel (hxy.trans (mul_zero x).symm))⟩
        exact IsDomain.mk
      · have h_le : p.primeCompl ≤ nonZeroDivisors B := by
          intro b hb
          exact mem_nonZeroDivisors_of_ne_zero (fun hb0 => hb (hb0 ▸ p.zero_mem))
        have : IsDomain R := IsLocalization.isDomain_of_le_nonZeroDivisors R h_le
        have : IsDiscreteValuationRing R :=
          IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain B hp R
        obtain ⟨ϖ, hϖ_irr⟩ := IsDiscreteValuationRing.exists_irreducible R
        have hϖ_ne : ϖ ≠ 0 := hϖ_irr.ne_zero
        have hmR : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} := hϖ_irr.maximalIdeal_eq
        set t : S := algebraMap R S ϖ
        have hmS : IsLocalRing.maximalIdeal S = Ideal.span {t} := by
          rw [← h_max, hmR, Ideal.map_span, Set.image_singleton]
        have ht_reg : ∀ z : S, t * z = 0 → z = 0 := by
          obtain ⟨⟨a₀, u⟩, h_surj⟩ := IsLocalization.surj p.primeCompl ϖ
          have ha₀_ne : a₀ ≠ 0 := by
            intro ha₀0
            rw [ha₀0, map_zero] at h_surj
            have h0 : ϖ = 0 := (IsLocalization.map_units R u).mul_right_cancel
              (h_surj.trans (zero_mul _).symm)
            exact hϖ_ne h0
          have ht_eq : t * algebraMap B S u.1 = algebraMap B S a₀ := by
            have h1 := congrArg (algebraMap R S) h_surj
            simpa only [map_mul, ← IsScalarTower.algebraMap_apply B R S] using h1
          have : Module.Flat D S := IsLocalization.flat S Q.primeCompl
          have : Module.Flat B S := Module.Flat.trans B D S
          have : Module.IsTorsionFree B S := inferInstance
          intro z htz
          have h_smul : a₀ • z = 0 := by
            rw [Algebra.smul_def, ← ht_eq, mul_comm t _, mul_assoc, htz, mul_zero]
          exact (smul_eq_zero.mp h_smul).resolve_left ha₀_ne
        have ht_pow_reg : ∀ (n : ℕ) (z : S), t ^ n * z = 0 → z = 0 := by
          intro n
          induction n with
          | zero => intro z hz; simpa only [pow_zero, one_mul] using hz
          | succ n ih =>
            intro z hz
            rw [pow_succ', mul_assoc] at hz
            exact ih z (ht_reg _ hz)
        have hKrull : (⨅ n : ℕ, (IsLocalRing.maximalIdeal S) ^ n) = ⊥ :=
          Ideal.iInf_pow_eq_bot_of_isLocalRing _ (IsLocalRing.maximalIdeal.isMaximal S).ne_top
        have hNZD : NoZeroDivisors S := ⟨fun {x y} hxy => by
          by_cases hx : x = 0
          · exact Or.inl hx
          · have hx_not_bot : x ∉ (⊥ : Ideal S) := hx
            rw [← hKrull, Ideal.mem_iInf, not_forall] at hx_not_bot
            let n₀ := Nat.find hx_not_bot
            have hn₀_spec : x ∉ (IsLocalRing.maximalIdeal S) ^ n₀ := Nat.find_spec hx_not_bot
            have hn₀_ne : n₀ ≠ 0 := by
              intro h0
              apply hn₀_spec
              rw [h0, pow_zero, Ideal.one_eq_top]
              trivial
            obtain ⟨m, hm_eq⟩ : ∃ m : ℕ, n₀ = m + 1 :=
              ⟨n₀ - 1, (Nat.sub_add_cancel (Nat.pos_of_ne_zero hn₀_ne)).symm⟩
            have hm_lt : m < n₀ := by omega
            have hx_in : x ∈ (IsLocalRing.maximalIdeal S) ^ m := by
              by_contra hnot
              exact Nat.find_min hx_not_bot hm_lt hnot
            have hx_out : x ∉ (IsLocalRing.maximalIdeal S) ^ (m + 1) := hm_eq ▸ hn₀_spec
            rw [hmS, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hx_in hx_out
            obtain ⟨v_x, hv_x⟩ := hx_in
            have hv_not_mem : v_x ∉ IsLocalRing.maximalIdeal S := by
              rw [hmS, Ideal.mem_span_singleton]
              rintro ⟨w, rfl⟩
              apply hx_out
              refine ⟨w, ?_⟩
              rw [hv_x, pow_succ, mul_assoc]
            have hv_unit : IsUnit v_x := IsLocalRing.notMem_maximalIdeal.mp hv_not_mem
            rw [hv_x, mul_assoc] at hxy
            have hvy : v_x * y = 0 := ht_pow_reg m (v_x * y) hxy
            exact Or.inr (hv_unit.mul_left_cancel (hvy.trans (mul_zero v_x).symm))⟩
        exact IsDomain.mk
    let I₀ : Ideal D := RingHom.ker (algebraMap D S)
    obtain ⟨G, hG⟩ := IsNoetherian.noetherian I₀
    have hAnn_el : ∀ g : D, g ∈ I₀ → ∃ c : Q.primeCompl, c.1 * g = 0 :=
      fun g hg => (IsLocalization.map_eq_zero_iff Q.primeCompl S g).mp hg
    let f : D → Q.primeCompl := fun g =>
      if hg : g ∈ I₀ then Classical.choose (hAnn_el g hg) else 1
    let u₀ : Q.primeCompl := ∏ g ∈ G, f g
    let s₀ : D := u₀.1
    have hs₀_not_Q : s₀ ∉ Q := u₀.2
    have hs₀_ann_G : (↑G : Set D) ⊆ (LinearMap.ker (LinearMap.mulLeft D s₀) : Set D) := by
      intro g hg
      have hg_I₀ : g ∈ I₀ := hG ▸ Ideal.subset_span hg
      have hfg : (f g).1 * g = 0 := by
        simp only [f, hg_I₀, ↓reduceDIte]
        exact Classical.choose_spec (hAnn_el g hg_I₀)
      obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem (fun x => (f x).1) hg
      have hu₀_eq : s₀ = ∏ x ∈ G, (f x).1 := Submonoid.coe_finsetProd Q.primeCompl f G
      change s₀ * g = 0
      rw [hu₀_eq, hk, mul_comm (f g).1 k, mul_assoc, hfg, mul_zero]
    have hs₀_ann : ∀ x ∈ I₀, s₀ * x = 0 := by
      intro x hx
      have hle : I₀ ≤ LinearMap.ker (LinearMap.mulLeft D s₀) := by
        rw [← hG, Ideal.span_le]
        exact hs₀_ann_G
      exact hle hx
    let C := Localization.Away s₀
    let ψ : C →+* S := IsLocalization.Away.lift s₀ (IsLocalization.map_units S u₀)
    have hψ_inj : Function.Injective ψ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨⟨d, ⟨_, n, rfl⟩⟩, h_surj⟩ := IsLocalization.surj (Submonoid.powers s₀) z
      dsimp only at h_surj
      have hψ_surj := congrArg ψ h_surj
      rw [map_mul, hz, zero_mul, IsLocalization.Away.lift_eq] at hψ_surj
      have hd_I₀ : d ∈ I₀ := hψ_surj.symm
      have hsd : s₀ * d = 0 := hs₀_ann d hd_I₀
      have hC0 : z * (algebraMap D C s₀ ^ n * algebraMap D C s₀) = 0 := by
        calc z * (algebraMap D C s₀ ^ n * algebraMap D C s₀)
          _ = (z * algebraMap D C (s₀ ^ n)) * algebraMap D C s₀ := by rw [map_pow, mul_assoc]
          _ = algebraMap D C d * algebraMap D C s₀ := by rw [h_surj]
          _ = algebraMap D C (s₀ * d) := by rw [← map_mul, mul_comm]
          _ = 0 := by rw [hsd, map_zero]
      have hu_C : IsUnit (algebraMap D C s₀ ^ n * algebraMap D C s₀) :=
        ((IsLocalization.Away.algebraMap_isUnit s₀).pow n).mul
          (IsLocalization.Away.algebraMap_isUnit s₀)
      exact hu_C.mul_right_cancel (hC0.trans (zero_mul _).symm)
    have hDomC : IsDomain C := Function.Injective.isDomain ψ hψ_inj
    have hDisj : Disjoint (Submonoid.powers s₀ : Set D) (Q : Set D) := by
      rw [Set.disjoint_left]
      rintro _ ⟨n, rfl⟩ hmem
      exact (u₀ ^ n).2 (by simpa only [SubmonoidClass.coe_pow] using hmem)
    exact ⟨s₀, hs₀_not_Q, hDomC,
      IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers s₀) C Q inferInstance hDisj,
      IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers s₀) C inferInstance hDisj⟩
  
  have hDomLoc : ∀ (C : Type u) [CommRing C] [IsDomain C] [Algebra B C] [Algebra.Etale B C],
      let c₀ : C := algebraMap B C b₀
      c₀ ≠ 0 ∧
      IsDomain (Localization.Away c₀) ∧
      Algebra.Etale B (Localization.Away c₀) ∧
      ∃ φ : Localization.Away b₀ →+* Localization.Away c₀,
        φ.comp (algebraMap B (Localization.Away b₀)) =
          algebraMap B (Localization.Away c₀) := by
    intro C _ _ _ _
    set c₀ : C := algebraMap B C b₀
    have hc₀ : c₀ ≠ 0 := by
      intro h0
      have hsmul : b₀ • (1 : C) = 0 := by
        rw [Algebra.smul_def, mul_one]
        exact h0
      exact (smul_eq_zero.mp hsmul).elim hb₀ one_ne_zero
    have h_le : Submonoid.powers c₀ ≤ nonZeroDivisors C :=
      Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero hc₀)
    have hDomC' : IsDomain (Localization.Away c₀) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away c₀) h_le
    have : Algebra.Etale C (Localization.Away c₀) := Algebra.Etale.of_isLocalizationAway c₀
    have hEtC' : Algebra.Etale B (Localization.Away c₀) :=
      Algebra.Etale.comp B C (Localization.Away c₀)
    have hu : IsUnit (algebraMap B (Localization.Away c₀) b₀) := by
      rw [IsScalarTower.algebraMap_apply B C (Localization.Away c₀)]
      exact IsLocalization.Away.algebraMap_isUnit c₀
    let φ : Localization.Away b₀ →+* Localization.Away c₀ :=
      IsLocalization.Away.lift b₀ hu
    have hφ : φ.comp (algebraMap B (Localization.Away b₀)) =
        algebraMap B (Localization.Away c₀) := by
      apply RingHom.ext
      intro x
      rw [RingHom.comp_apply]
      exact IsLocalization.Away.lift_eq (S := Localization.Away b₀) b₀ hu x
    exact ⟨hc₀, hDomC', hEtC', φ, hφ⟩
  have hDenseZero : ∀ (T : Type u) [CommRing T] [Algebra B T] [Algebra.Etale B T]
      (M : Type u) [Zero M]
      (g : LocallyConstant ↥(AlgebraicGeometry.Spec (CommRingCat.of T)) M),
      (∀ q : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (algebraMap B T b₀)))),
        g ((AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap T (Localization.Away (algebraMap B T b₀))))).base q) = 0) →
      g = 0 := by
    intro T _ _ _ M _ g hg0
    set t₀ : T := algebraMap B T b₀
    ext p
    let p' : PrimeSpectrum T := p
    change g p' = 0
    have hOpen : IsOpen ((g : PrimeSpectrum T → M) ⁻¹' {g p'}) := g.isLocallyConstant {g p'}
    obtain ⟨_, ⟨h, rfl⟩, hp_mem, hh_sub⟩ :=
      TopologicalSpace.IsTopologicalBasis.mem_nhds_iff
        (PrimeSpectrum.isTopologicalBasis_basic_opens (R := T)) |>.mp (hOpen.mem_nhds rfl)
    have hp_mem' : p' ∈ PrimeSpectrum.basicOpen h := hp_mem
    have h_ne_bot : PrimeSpectrum.basicOpen (h * t₀) ≠ ⊥ := by
      intro hbot
      obtain ⟨n, hn⟩ := (PrimeSpectrum.basicOpen_eq_bot_iff (h * t₀)).mp hbot
      have hsmul : (b₀ ^ n) • (h ^ n) = 0 := by
        rw [Algebra.smul_def, map_pow]
        change t₀ ^ n * h ^ n = 0
        rw [mul_comm, ← mul_pow]
        exact hn
      have hhn : h ^ n = 0 := (smul_eq_zero.mp hsmul).resolve_left (pow_ne_zero n hb₀)
      have hh_bot : PrimeSpectrum.basicOpen h = ⊥ :=
        (PrimeSpectrum.basicOpen_eq_bot_iff h).mpr ⟨n, hhn⟩
      rw [hh_bot] at hp_mem'
      exact hp_mem'
    have h_nonempty : (PrimeSpectrum.basicOpen (h * t₀) : Set (PrimeSpectrum T)).Nonempty := by
      rw [Set.nonempty_iff_ne_empty]
      intro hempty
      apply h_ne_bot
      ext x
      exact ⟨fun hx => False.elim (hempty.subset hx), False.elim⟩
    obtain ⟨r, hr⟩ := h_nonempty
    rw [PrimeSpectrum.basicOpen_mul] at hr
    have hgr : g r = g p' := hh_sub hr.1
    have hr_range : r ∈ Set.range (PrimeSpectrum.comap (algebraMap T (Localization.Away t₀))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away t₀) t₀]
      exact hr.2
    obtain ⟨q, hq⟩ := hr_range
    have hgr0 : g r = 0 := by
      rw [← hq]
      exact hg0 q
    exact hgr.symm.trans hgr0
  have hConstBij : ∀ (C : Type u) [CommRing C] [IsDomain C] (A : Type u) [AddCommGroup A],
      Function.Bijective
        (LocallyConstant.constAddMonoidHom
          (X := ↥(AlgebraicGeometry.Spec (CommRingCat.of C))) (Y := A)) := by
    intro C _ _ A _
    refine ⟨?_, ?_⟩
    · intro a₁ a₂ ha
      let x₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of C)) := Classical.arbitrary _
      exact DFunLike.congr_fun ha x₀
    · intro g
      have : Nonempty A := ⟨0⟩
      obtain ⟨a, ha⟩ := LocallyConstant.exists_eq_const g
      exact ⟨a, ha.symm⟩
  
  have hMem : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ x : ↥W.left, ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have h_eq : S.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S le_rfl
    exact (iff_of_eq (congrFun (congrArg (fun J => J W) h_eq) R)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) W R)
  
  have hLocConst : ∀ (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
      let C_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj A
      let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)
      ∃ (hT_S : CategoryTheory.Limits.IsTerminal T_S)
        (θ_S : ∀ Y : S.Etale, LocallyConstant ↥Y.left ↥A ≃+ ↥(C_S.obj.obj (Opposite.op Y))),
        (∀ {Y₁ Y₂ : S.Etale} (f : Y₁ ⟶ Y₂) (g : LocallyConstant ↥Y₂.left ↥A),
          (C_S.obj.map (Opposite.op f)).hom (θ_S Y₂ g) =
            θ_S Y₁ (g.comap f.left.base.hom)) ∧
        (∀ a : ↥A, θ_S T_S (LocallyConstant.const ↥T_S.left a) =
          ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S).unit.app A).hom a) := by
    intro S A
    let C_S := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj A
    let T_S : S.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 S)
    let hT_S : CategoryTheory.Limits.IsTerminal T_S :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun Y => CategoryTheory.MorphismProperty.Over.homMk Y.hom (Category.comp_id Y.hom) trivial)
        (fun Y m => CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.MorphismProperty.Over.w m).trans (Category.comp_id Y.hom).symm))
    let P_loc : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
      { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥U.unop.left ↥A)
        map := fun f => AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom f.unop.left.base.hom)
        map_id := fun _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl
        map_comp := fun _ _ => AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
    have hSheaf_loc : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology P_loc := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro W R hR
      have hCov := (hMem S W R).mp hR
      let Y_p : ↥W.left → S.Etale := fun p => Classical.choose (hCov p)
      let f_p : ∀ p : ↥W.left, Y_p p ⟶ W := fun p => Classical.choose (Classical.choose_spec (hCov p))
      let y_p : ∀ p : ↥W.left, ↥(Y_p p).left := fun p =>
        Classical.choose (Classical.choose_spec (Classical.choose_spec (hCov p)))
      have hf_p : ∀ p : ↥W.left, R.arrows (f_p p) := fun p =>
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov p)))).1
      have het_p : ∀ p : ↥W.left, AlgebraicGeometry.Etale (f_p p).left := fun p =>
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov p)))).2.1
      have hy_p : ∀ p : ↥W.left, (f_p p).left.base (y_p p) = p := fun p =>
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov p)))).2.2
      let mkObj : ∀ {Y : S.Etale} (f : Y ⟶ W), R.arrows f → (R.arrows.category)ᵒᵖ :=
        fun f hf => Opposite.op ⟨CategoryTheory.Over.mk f, hf⟩
      let evArr : ∀ (c : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_loc))
          (_ : ↥c.pt) {Y : S.Etale} (f : Y ⟶ W), R.arrows f → LocallyConstant ↥Y.left ↥A :=
        fun c x _ f hf => (c.π.app (mkObj f hf)).hom x
      have hAgree : ∀ (c : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_loc))
          (x : ↥c.pt)
          {Y₁ : S.Etale} (f₁ : Y₁ ⟶ W) (hf₁ : R.arrows f₁) (y₁ : ↥Y₁.left)
          {Y₂ : S.Etale} (f₂ : Y₂ ⟶ W) (hf₂ : R.arrows f₂) (y₂ : ↥Y₂.left),
          f₁.left.base y₁ = f₂.left.base y₂ →
          evArr c x f₁ hf₁ y₁ = evArr c x f₂ hf₂ y₂ := by
        intro c x Y₁ f₁ hf₁ y₁ Y₂ f₂ hf₂ y₂ heq
        have hY₁_w : f₁.left ≫ W.hom = Y₁.hom := CategoryTheory.MorphismProperty.Over.w f₁
        have hY₂_w : f₂.left ≫ W.hom = Y₂.hom := CategoryTheory.MorphismProperty.Over.w f₂
        have _ : AlgebraicGeometry.Etale f₁.left :=
