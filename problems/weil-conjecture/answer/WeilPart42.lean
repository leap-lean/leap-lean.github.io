      (fun σ => ⟨(hOut3.2 (σ.restrictScalars K₂)).1, (hOut3.2 (σ.restrictScalars K₂)).2.1⟩)
      hKummerOrth Q' hϖ_mem

theorem weil_abhyankar_reynolds_dvr_and_unramified_inertia_descent (k : Type u) [Field k]
    [IsAlgClosed k] :
    let A₀ := MvPolynomial (Fin 2) k
    let K₂ := FractionRing A₀
    ∀ (L₂ : Type u) [Field L₂] [Algebra K₂ L₂] [FiniteDimensional K₂ L₂] [IsGalois K₂ L₂]
      (h₀ f₀ : A₀),
      Irreducible h₀ →
      Irreducible f₀ →
      ∀ (p : Fin 2 → k),
        MvPolynomial.eval p h₀ = 0 →
        MvPolynomial.eval p f₀ = 0 →
        ∀ (e : ℕ), 1 ≤ e → (e : k) ≠ 0 →
          (∀ (D : Type u) [CommRing D] [IsDomain D] [IsNoetherianRing D] [IsLocalRing D]
             (π_D : D),
             π_D ≠ 0 →
             IsLocalRing.maximalIdeal D = Ideal.span {π_D} →
             ∀ (S : Type u) [CommRing S] [Algebra D S] [Module.Finite D S] [Algebra.Etale D S]
               (𝔫 : Ideal S) [𝔫.IsMaximal]
               (E : Type u) [CommRing E] [Algebra S E] [IsLocalization.AtPrime E 𝔫],
               let π_E := algebraMap S E (algebraMap D S π_D)
               ∃ (_ : IsDomain E) (_ : IsLocalRing E),
                 IsDiscreteValuationRing E ∧ IsIntegrallyClosed E ∧
                 (∀ x : E, π_E * x = 0 → x = 0) ∧
                 IsLocalRing.maximalIdeal E = Ideal.span {π_E}) →
          ∀ (R'_p K'_2 L'_2 : Type u)
            [CommRing R'_p] [IsDomain R'_p] [IsNoetherianRing R'_p]
            [IsIntegrallyClosed R'_p] [IsLocalRing R'_p]
            [Field K'_2] [Algebra R'_p K'_2] [IsFractionRing R'_p K'_2]
            [Field L'_2] [Algebra K₂ L'_2] [FiniteDimensional K₂ L'_2] [IsGalois K₂ L'_2]
            [Algebra L₂ L'_2] [IsScalarTower K₂ L₂ L'_2]
            [FiniteDimensional L₂ L'_2] [IsGalois L₂ L'_2]
            [Algebra K'_2 L'_2] [FiniteDimensional K'_2 L'_2] [Algebra.IsSeparable K'_2 L'_2]
            [Algebra R'_p L'_2] [IsScalarTower R'_p K'_2 L'_2]
            [Algebra k R'_p] [Algebra A₀ R'_p] [IsScalarTower k A₀ R'_p]
            (ϖ : R'_p),
            (letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
             let B₂_0 := integralClosure A₀ L₂
             ((algebraMap R'_p L'_2).comp (algebraMap A₀ R'_p) =
                (algebraMap L₂ L'_2).comp ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)) ∧
              (∀ g : A₀, MvPolynomial.eval p g ≠ 0 → IsUnit (algebraMap A₀ R'_p g)) ∧
              (∀ x : L₂,
                IsIntegral R'_p (algebraMap L₂ L'_2 x) ↔
                  ∃ (y : ↥B₂_0) (g : A₀),
                    MvPolynomial.eval p g ≠ 0 ∧
                    x * algebraMap A₀ L₂ g = (y : L₂)))) →
            (let h'_0 := algebraMap A₀ R'_p h₀
             ϖ ≠ 0 ∧ h'_0 ≠ 0 ∧
             ϖ ^ e = algebraMap A₀ R'_p f₀ ∧
             (Ideal.span {ϖ}).IsPrime ∧ (Ideal.span {h'_0}).IsPrime ∧
             h'_0 ∉ Ideal.span {ϖ} ∧ ϖ ∉ Ideal.span {h'_0} ∧
             IsLocalRing.maximalIdeal R'_p = Ideal.span {ϖ, h'_0} ∧
             Ideal.comap (algebraMap A₀ R'_p) (Ideal.span {ϖ}) = Ideal.span {f₀} ∧
             (∀ r : R'_p, ∃ c : k, r - algebraMap k R'_p c ∈ IsLocalRing.maximalIdeal R'_p)) →
            ((Nat.card (L'_2 ≃ₐ[L₂] L'_2) : k) ≠ 0 ∧
             ∀ τ : L'_2 ≃ₐ[K₂] L'_2,
               (∃ ζ : k, ζ ^ e = 1 ∧
                 τ (algebraMap R'_p L'_2 ϖ) =
                   algebraMap R'_p L'_2 (algebraMap k R'_p ζ * ϖ)) ∧
               (∀ r : R'_p, ∃ r' : R'_p,
                 τ (algebraMap R'_p L'_2 r) = algebraMap R'_p L'_2 r') ∧
               (∀ r : R'_p, ∃ s : R'_p,
                 τ (algebraMap R'_p L'_2 r) - algebraMap R'_p L'_2 r =
                   algebraMap R'_p L'_2 (ϖ * s))) →
            Algebra.Etale R'_p ↥(integralClosure R'_p L'_2) →
            letI : Algebra A₀ L₂ := ((algebraMap K₂ L₂).comp (algebraMap A₀ K₂)).toAlgebra
            let B₂_0 := integralClosure A₀ L₂
            let I_h₀ : Ideal ↥B₂_0 := Ideal.span {algebraMap A₀ ↥B₂_0 h₀}
            (∀ (𝔐₀ : Ideal ↥B₂_0), 𝔐₀.IsMaximal →
               (∀ g : A₀, algebraMap A₀ ↥B₂_0 g ∈ 𝔐₀ ↔ MvPolynomial.eval p g = 0) →
               ∀ (B_bar : Type u) [CommRing B_bar]
                 (𝔪_bar : Ideal B_bar) [𝔪_bar.IsPrime]
                 (R_bar : Type u) [CommRing R_bar] [Algebra B_bar R_bar]
                 [IsLocalization.AtPrime R_bar 𝔪_bar],
                 𝔪_bar.IsMaximal →
                 ∀ (e_bar : (↥B₂_0 ⧸ I_h₀) ≃+* B_bar),
                   Ideal.comap (e_bar.toRingHom.comp (Ideal.Quotient.mk I_h₀)) 𝔪_bar = 𝔐₀ →
                   IsDomain R_bar ∧ IsIntegrallyClosed R_bar) ∧
            (∀ (𝔐₀ : Ideal ↥B₂_0), 𝔐₀.IsMaximal →
               (∀ g : A₀, algebraMap A₀ ↥B₂_0 g ∈ 𝔐₀ ↔ MvPolynomial.eval p g = 0) →
               ∃ Q_C : Ideal ↥B₂_0,
                 Q_C.IsPrime ∧
                 (∀ x : ↥B₂_0, x ∈ Q_C → x ∈ 𝔐₀) ∧
                 Ideal.comap (algebraMap A₀ ↥B₂_0) Q_C = Ideal.span {f₀} ∧
                 ∀ σ : L₂ ≃ₐ[K₂] L₂,
                   (∀ y : ↥B₂_0, ∃ z ∈ Q_C, (z : L₂) = σ y.1 - y.1) ↔
                   (∀ y : ↥B₂_0, ∃ z ∈ 𝔐₀, (z : L₂) = σ y.1 - y.1)) :=
by
  open scoped Pointwise in
  intro A₀ K₂ L₂ _ _ _ _ h₀ f₀ _hIrr_h₀ _hIrr_f₀ p _hp_h₀ _hp_f₀ e _he_pos _he_ne hDVR1D
    R'_p K'_2 L'_2
    _ _ _ _ _
    _ _ _
    _ _ _ _
    _ _ _ _
    _ _ _
    _ _
    _ _ _
    ϖ hOut1 hOut2 hOut3 hEtale_R'
  
  have hQuotEtale : ∀ (R B : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R]
      [IsLocalRing R] [Algebra k R] [CommRing B] [Algebra R B] [Module.Finite R B]
      [Algebra.Etale R B] (t₁ t₂ : R),
      (Ideal.span {t₁}).IsPrime →
      t₂ ∉ Ideal.span {t₁} →
      IsLocalRing.maximalIdeal R = Ideal.span {t₁, t₂} →
      (∀ r : R, ∃ c : k, r - algebraMap k R c ∈ IsLocalRing.maximalIdeal R) →
      let I_B : Ideal B := Ideal.span {algebraMap R B t₁}
      let S_quot := B ⧸ I_B
      (∀ (𝔫 : Ideal S_quot) [𝔫.IsMaximal],
        IsDomain (Localization.AtPrime 𝔫) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔫)) ∧
      (∀ (𝔐' : Ideal B) [𝔐'.IsMaximal],
        ∃ 𝔔' : Ideal B,
          𝔔'.IsPrime ∧
          𝔔' ≤ 𝔐' ∧
          Ideal.comap (algebraMap R B) 𝔔' = Ideal.span {t₁} ∧
          ∀ τ_B : B →+* B,
            Ideal.comap τ_B 𝔐' = 𝔐' →
            τ_B (algebraMap R B t₁) ∈ I_B →
            (∀ r : R, τ_B (algebraMap R B r) - algebraMap R B r ∈ I_B) →
            ∀ b : B, τ_B b - b ∈ 𝔔') := by
    intro R B _ _ _ _ _ _ _ _ _ t₁ t₂ ht₁_prime ht₂_not hmax_R hRes_k I_B S_quot
    let I_R : Ideal R := Ideal.span {t₁}
    haveI : I_R.IsPrime := ht₁_prime
    let D := R ⧸ I_R
    let q_R : R →+* D := Ideal.Quotient.mk I_R
    haveI : IsDomain D := (Ideal.Quotient.isDomain_iff_prime I_R).mpr ht₁_prime
    haveI : IsNoetherianRing D := Ideal.Quotient.isNoetherianRing I_R
    haveI : IsLocalRing D := IsLocalRing.of_surjective' q_R Ideal.Quotient.mk_surjective
    let π_D : D := q_R t₂
    have hπ_D_ne : π_D ≠ 0 := fun h0 => ht₂_not (Ideal.Quotient.eq_zero_iff_mem.mp h0)
    have hmax_D : IsLocalRing.maximalIdeal D = Ideal.span {π_D} := by
      apply le_antisymm
      · have hspan_le : Ideal.span {t₁, t₂} ≤ Ideal.comap q_R (Ideal.span {π_D}) := by
          rw [Ideal.span_le]
          intro z hz
          rcases Set.mem_insert_iff.mp hz with hzt₁ | hz'
          · rw [hzt₁]
            change q_R t₁ ∈ Ideal.span {π_D}
            have h0 : q_R t₁ = 0 :=
              Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self t₁)
            rw [h0]
            exact Ideal.zero_mem _
          · rw [Set.mem_singleton_iff.mp hz']
            exact Ideal.mem_span_singleton_self π_D
        intro x hx
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hr_not_unit : ¬ IsUnit r := fun hu =>
          (IsLocalRing.notMem_maximalIdeal.mpr (hu.map q_R)) hx
        have hr_mem : r ∈ IsLocalRing.maximalIdeal R := by
          by_contra hnot
          exact hr_not_unit (IsLocalRing.notMem_maximalIdeal.mp hnot)
        exact hspan_le (hmax_R ▸ hr_mem)
      · rw [Ideal.span_singleton_le_iff_mem]
        by_contra hnot
        have hu : IsUnit π_D := IsLocalRing.notMem_maximalIdeal.mp hnot
        rcases hu.exists_right_inv with ⟨u, hu_eq⟩
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective u
        have hmem1 : t₂ * s - 1 ∈ I_R := Ideal.Quotient.eq_zero_iff_mem.mp (by
          rw [map_sub, map_mul, map_one]
          exact sub_eq_zero.mpr hu_eq)
        have ht₁_le : I_R ≤ IsLocalRing.maximalIdeal R := by
          rw [hmax_R]
          exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert t₁ {t₂}))
        have ht₂_mem : t₂ ∈ IsLocalRing.maximalIdeal R := by
          rw [hmax_R]
          exact Ideal.subset_span (Set.mem_insert_of_mem t₁ (Set.mem_singleton t₂))
        have h1_mem : (1 : R) ∈ IsLocalRing.maximalIdeal R := by
          have hsub := Ideal.sub_mem (IsLocalRing.maximalIdeal R)
            (Ideal.mul_mem_right s _ ht₂_mem) (ht₁_le hmem1)
          rwa [sub_sub_cancel] at hsub
        exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h1_mem)
    let q_B : B →+* S_quot := Ideal.Quotient.mk I_B
    have h_ker_D : ∀ r ∈ I_R, (q_B.comp (algebraMap R B)) r = 0 := by
      have hle : I_R ≤ RingHom.ker (q_B.comp (algebraMap R B)) := by
        rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      exact fun r hr => hle hr
    let φ_DS : D →+* S_quot := Ideal.Quotient.lift I_R (q_B.comp (algebraMap R B)) h_ker_D
    letI : Algebra D S_quot := φ_DS.toAlgebra
    haveI : IsScalarTower R D S_quot := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Module.Finite R S_quot :=
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ R I_B).toLinearMap
        Ideal.Quotient.mk_surjective
    haveI : Module.Finite D S_quot := Module.Finite.of_restrictScalars_finite R D S_quot
    haveI : Algebra.Etale D S_quot := by
      let f_fwd : TensorProduct R D B →ₐ[D] S_quot :=
        Algebra.TensorProduct.lift (Algebra.ofId D S_quot) (Ideal.Quotient.mkₐ R I_B)
          (fun _ _ => Commute.all _ _)
      let incR : B →ₐ[R] TensorProduct R D B := Algebra.TensorProduct.includeRight
      have h_inc_ker : ∀ x ∈ I_B, incR.toRingHom x = 0 := by
        have hle : I_B ≤ RingHom.ker incR.toRingHom := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          change (1 : D) ⊗ₜ[R] (algebraMap R B t₁) = 0
          have hb1 : algebraMap R B t₁ = t₁ • (1 : B) := by rw [Algebra.smul_def, mul_one]
          rw [hb1, ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
          have h0 : algebraMap R D t₁ = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self t₁)
          rw [h0, TensorProduct.zero_tmul]
        exact fun x hx => hle hx
      let g_inv : S_quot →+* TensorProduct R D B :=
        Ideal.Quotient.lift I_B incR.toRingHom h_inc_ker
      have h_fg : ∀ y : S_quot, f_fwd (g_inv y) = y := by
        intro y
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        change f_fwd ((1 : D) ⊗ₜ[R] b) = q_B b
        simp [f_fwd]
        rfl
      have h_gf : ∀ z : TensorProduct R D B, g_inv (f_fwd z) = z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul d b =>
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective d
          have htmul : q_R r ⊗ₜ[R] b = (1 : D) ⊗ₜ[R] (algebraMap R B r * b) := by
            have h1 : q_R r = r • (1 : D) := by
              rw [Algebra.smul_def, mul_one]
              rfl
            rw [h1, TensorProduct.smul_tmul, Algebra.smul_def]
          rw [htmul]
          have h1 : f_fwd ((1 : D) ⊗ₜ[R] (algebraMap R B r * b)) = q_B (algebraMap R B r * b) := by
            simp [f_fwd]
            rfl
          rw [h1]
          rfl
        | add x y hx hy => rw [map_add, map_add, hx, hy]
      let e_ring : TensorProduct R D B ≃+* S_quot :=
        { f_fwd.toRingHom with
          invFun := g_inv
          left_inv := h_gf
          right_inv := h_fg }
      let e_quot : TensorProduct R D B ≃ₐ[D] S_quot :=
        AlgEquiv.ofRingEquiv (f := e_ring) (fun x => f_fwd.commutes x)
      haveI : Algebra.Etale D (TensorProduct R D B) := Algebra.Etale.baseChange R B D
      exact Algebra.Etale.of_equiv e_quot
    refine ⟨?_, ?_⟩
    · intro 𝔫 _
      obtain ⟨hDomE, _, _, hICE, _, _⟩ :=
        hDVR1D D π_D hπ_D_ne hmax_D S_quot 𝔫 (Localization.AtPrime 𝔫)
      exact ⟨hDomE, hICE⟩
    · intro 𝔐' h𝔐'_max
      haveI : Algebra.IsIntegral R B := Algebra.IsIntegral.of_finite R B
      have h𝔐'_comap_max : (Ideal.comap (algebraMap R B) 𝔐').IsMaximal :=
        Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R B)
          (Algebra.IsIntegral.isIntegral (R := R) (A := B)) 𝔐'
      have h𝔐'_under : Ideal.comap (algebraMap R B) 𝔐' = IsLocalRing.maximalIdeal R :=
        IsLocalRing.eq_maximalIdeal h𝔐'_comap_max
      have hIB_le_𝔐' : I_B ≤ 𝔐' := by
        rw [Ideal.span_singleton_le_iff_mem, ← Ideal.mem_comap, h𝔐'_under, hmax_R]
        exact Ideal.subset_span (Set.mem_insert t₁ {t₂})
      let 𝔫 : Ideal S_quot := Ideal.map q_B 𝔐'
      have hker_qB : Ideal.comap q_B ⊥ = I_B := by
        ext x
        exact Ideal.Quotient.eq_zero_iff_mem
      have h𝔫_comap : Ideal.comap q_B 𝔫 = 𝔐' := by
        rw [Ideal.comap_map_of_surjective q_B Ideal.Quotient.mk_surjective, hker_qB]
        exact sup_eq_left.mpr hIB_le_𝔐'
      haveI : 𝔫.IsMaximal := by
        rw [Ideal.isMaximal_iff]
        refine ⟨fun h1 => h𝔐'_max.ne_top ((Ideal.eq_top_iff_one _).mpr (h𝔫_comap ▸ h1)),
          fun J x hJ hx_not hx_J => ?_⟩
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hb_not : b ∉ 𝔐' := fun hb => hx_not (Ideal.mem_map_of_mem q_B hb)
        exact (Ideal.isMaximal_iff.mp h𝔐'_max).2 (Ideal.comap q_B J) b
          (h𝔫_comap ▸ Ideal.comap_mono hJ) hb_not hx_J
      suffices hWithE : ∀ (E : Type u) [CommRing E] [Algebra S_quot E]
          [IsLocalization.AtPrime E 𝔫],
          ∃ 𝔔' : Ideal B,
            𝔔'.IsPrime ∧
            𝔔' ≤ 𝔐' ∧
            Ideal.comap (algebraMap R B) 𝔔' = Ideal.span {t₁} ∧
            ∀ τ_B : B →+* B,
              Ideal.comap τ_B 𝔐' = 𝔐' →
              τ_B (algebraMap R B t₁) ∈ I_B →
              (∀ r : R, τ_B (algebraMap R B r) - algebraMap R B r ∈ I_B) →
              ∀ b : B, τ_B b - b ∈ 𝔔' from hWithE (Localization.AtPrime 𝔫)
      intro E _ _ _
      let ψ : B →+* E := (algebraMap S_quot E).comp q_B
      obtain ⟨hDomE, hLocE, _, _, hπE_reg, hmax_E⟩ :=
        hDVR1D D π_D hπ_D_ne hmax_D S_quot 𝔫 E
      letI : IsDomain E := hDomE
      letI : IsLocalRing E := hLocE
      let π_E : E := algebraMap S_quot E (algebraMap D S_quot π_D)
      have hπ_E_ne : π_E ≠ 0 := by
        intro h0
        dsimp [π_E] at h0
        exact one_ne_zero (hπE_reg 1 (by rw [h0, zero_mul]))
      let 𝔔' : Ideal B := RingHom.ker ψ
      haveI : 𝔔'.IsPrime := RingHom.ker_isPrime ψ
      have h𝔔'_le : 𝔔' ≤ 𝔐' := by
        intro b hb
        by_contra hb_not
        have hq_not : q_B b ∉ 𝔫 := fun hq => hb_not (by rw [← h𝔫_comap]; exact hq)
        exact (IsLocalization.map_units E (⟨q_B b, hq_not⟩ : 𝔫.primeCompl)).ne_zero hb
      have h𝔔'_comap : Ideal.comap (algebraMap R B) 𝔔' = Ideal.span {t₁} := by
        let 𝔭 : Ideal R := Ideal.comap (algebraMap R B) 𝔔'
        have h𝔭_prime : 𝔭.IsPrime := Ideal.comap_isPrime _ 𝔔'
        have hI_le_𝔭 : I_R ≤ 𝔭 := by
          rw [Ideal.span_singleton_le_iff_mem]
          change algebraMap S_quot E (q_B (algebraMap R B t₁)) = 0
          rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
        have ht₂_not_𝔭 : t₂ ∉ 𝔭 := fun ht₂ => hπ_E_ne ht₂
        let 𝔭_D : Ideal D := Ideal.map q_R 𝔭
        have hker_qR : Ideal.comap q_R ⊥ = I_R := by
          ext x
          exact Ideal.Quotient.eq_zero_iff_mem
        have h𝔭_D_comap : Ideal.comap q_R 𝔭_D = 𝔭 := by
          rw [Ideal.comap_map_of_surjective q_R Ideal.Quotient.mk_surjective, hker_qR]
          exact sup_eq_left.mpr hI_le_𝔭
        have hπ_not_𝔭D : π_D ∉ 𝔭_D := fun h => ht₂_not_𝔭 (by rw [← h𝔭_D_comap]; exact h)
        have h𝔭D_prime : 𝔭_D.IsPrime := by
          refine ⟨fun htop => hπ_not_𝔭D (htop ▸ trivial), fun {x y} hxy => ?_⟩
          obtain ⟨rx, rfl⟩ := Ideal.Quotient.mk_surjective x
          obtain ⟨ry, rfl⟩ := Ideal.Quotient.mk_surjective y
          have hrxy : rx * ry ∈ 𝔭 := by
            rw [← h𝔭_D_comap]
            simpa [map_mul] using hxy
          rcases h𝔭_prime.mem_or_mem hrxy with hrx | hry
          · exact Or.inl (Ideal.mem_map_of_mem q_R hrx)
          · exact Or.inr (Ideal.mem_map_of_mem q_R hry)
        have h𝔭D_le_max : 𝔭_D ≤ Ideal.span {π_D} :=
          hmax_D ▸ IsLocalRing.le_maximalIdeal h𝔭D_prime.ne_top
        have h𝔭D_pow : ∀ n : ℕ, 𝔭_D ≤ (IsLocalRing.maximalIdeal D) ^ n := by
          intro n
          induction n with
          | zero => rw [pow_zero, Ideal.one_eq_top]; exact le_top
          | succ n ih =>
            intro x hx
            obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp (h𝔭D_le_max hx)
            have hy : y ∈ 𝔭_D := (h𝔭D_prime.mem_or_mem hx).resolve_right hπ_not_𝔭D
            rw [pow_succ]
            exact Ideal.mul_mem_mul (ih hy) (hmax_D ▸ Ideal.mem_span_singleton_self π_D)
        have h_iInf := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal D)
          (IsLocalRing.maximalIdeal.isMaximal D).ne_top
        have h𝔭D_bot : 𝔭_D = ⊥ := le_bot_iff.mp (h_iInf ▸ le_iInf h𝔭D_pow)
        apply le_antisymm _ hI_le_𝔭
        intro r hr
        have hr0 : q_R r ∈ 𝔭_D := Ideal.mem_map_of_mem q_R hr
        rw [h𝔭D_bot, Ideal.mem_bot] at hr0
        exact Ideal.Quotient.eq_zero_iff_mem.mp hr0
      refine ⟨𝔔', inferInstance, h𝔔'_le, h𝔔'_comap, ?_⟩
      intro τ_B hτ_𝔐' hτ_t₁ hτ_R b
      have hτ_ker : ∀ x ∈ I_B, (q_B.comp τ_B) x = 0 := by
        have hle : I_B ≤ RingHom.ker (q_B.comp τ_B) := by
          rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr hτ_t₁
        exact fun x hx => hle hx
      let τ_S_ring : S_quot →+* S_quot := Ideal.Quotient.lift I_B (q_B.comp τ_B) hτ_ker
      have hτ_S_comm : ∀ d : D, τ_S_ring (algebraMap D S_quot d) = algebraMap D S_quot d := by
        intro d
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective d
        change q_B (τ_B (algebraMap R B r)) = q_B (algebraMap R B r)
        exact sub_eq_zero.mp (by
          rw [← map_sub]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (hτ_R r))
      let τ_S : S_quot →ₐ[D] S_quot := { τ_S_ring with commutes' := hτ_S_comm }
      have hτ_S_𝔫 : ∀ s : S_quot, s ∈ 𝔫 ↔ τ_S s ∈ 𝔫 := by
        intro s
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective s
        change q_B x ∈ 𝔫 ↔ q_B (τ_B x) ∈ 𝔫
        rw [← Ideal.mem_comap, ← Ideal.mem_comap, h𝔫_comap]
        exact (SetLike.ext_iff.mp hτ_𝔐' x).symm
      letI : Algebra D E := ((algebraMap S_quot E).comp (algebraMap D S_quot)).toAlgebra
      haveI : IsScalarTower D S_quot E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      have hτ_units : ∀ y : 𝔫.primeCompl,
          IsUnit (((algebraMap S_quot E).comp τ_S.toRingHom) y.1) :=
        fun y => IsLocalization.map_units E
          (⟨τ_S y.1, fun h => y.2 ((hτ_S_𝔫 y.1).mpr h)⟩ : 𝔫.primeCompl)
      obtain ⟨τ_E_ring, hτ_E_eq⟩ : ∃ τ_E_ring : E →+* E,
          ∀ s : S_quot, τ_E_ring (algebraMap S_quot E s) = algebraMap S_quot E (τ_S s) :=
        ⟨IsLocalization.lift hτ_units, IsLocalization.lift_eq hτ_units⟩
      let τ_E : E →ₐ[D] E :=
        { τ_E_ring with
          commutes' := fun d => by
            change τ_E_ring (algebraMap D E d) = algebraMap D E d
            rw [IsScalarTower.algebraMap_apply D S_quot E, hτ_E_eq, τ_S.commutes] }
      have hτ_E_mod_max : ∀ w : E, τ_E w - w ∈ IsLocalRing.maximalIdeal E := by
        let κ_S := S_quot ⧸ 𝔫
        letI : Field κ_S := Ideal.Quotient.field 𝔫
        let κ_R := R ⧸ IsLocalRing.maximalIdeal R
        let φ_kR : k →+* κ_R := algebraMap k κ_R
        have hφ_kR_surj : Function.Surjective φ_kR := by
          intro x
          obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
          obtain ⟨c, hc⟩ := hRes_k r
          exact ⟨c, (Ideal.Quotient.eq.mpr hc).symm⟩
        have h_ker_Rκ : ∀ r ∈ IsLocalRing.maximalIdeal R,
            ((Ideal.Quotient.mk 𝔫).comp (q_B.comp (algebraMap R B))) r = 0 := by
          intro r hr
          have hrB : algebraMap R B r ∈ 𝔐' := by
            change r ∈ Ideal.comap (algebraMap R B) 𝔐'
            rwa [h𝔐'_under]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem q_B hrB)
        let φ_Rκ : κ_R →+* κ_S :=
          Ideal.Quotient.lift (IsLocalRing.maximalIdeal R)
            ((Ideal.Quotient.mk 𝔫).comp (q_B.comp (algebraMap R B))) h_ker_Rκ
        let φ_kS : k →+* κ_S := φ_Rκ.comp φ_kR
        letI : Algebra κ_R κ_S := φ_Rκ.toAlgebra
        letI : Algebra k κ_S := φ_kS.toAlgebra
        haveI : IsScalarTower k κ_R κ_S := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
        haveI : Algebra.IsIntegral k κ_R := Algebra.isIntegral_of_surjective hφ_kR_surj
        haveI : Algebra.IsIntegral κ_R κ_S := ⟨fun z => by
          obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective z
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective s
          exact _root_.IsIntegral.map_of_comp_eq
            (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R))
            ((Ideal.Quotient.mk 𝔫).comp q_B) rfl (Algebra.IsIntegral.isIntegral x)⟩
        haveI : Algebra.IsIntegral k κ_S := Algebra.IsIntegral.trans κ_R
        have hφ_kS_surj : Function.Surjective φ_kS :=
          (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := κ_S)).2
        have hS_mod : ∀ s : S_quot,
            τ_E (algebraMap S_quot E s) - algebraMap S_quot E s ∈ IsLocalRing.maximalIdeal E := by
          intro s
          obtain ⟨c, hc⟩ := hφ_kS_surj (Ideal.Quotient.mk 𝔫 s)
          let d_c : D := q_R (algebraMap k R c)
          have hns_mem : s - algebraMap D S_quot d_c ∈ 𝔫 := by
            apply Ideal.Quotient.eq_zero_iff_mem.mp
            rw [map_sub]
            exact sub_eq_zero.mpr hc.symm
          let n_s := s - algebraMap D S_quot d_c
          have hτns_mem : τ_S n_s ∈ 𝔫 := (hτ_S_𝔫 n_s).mp hns_mem
          have hmap_max : Ideal.map (algebraMap S_quot E) 𝔫 = IsLocalRing.maximalIdeal E :=
            IsLocalization.AtPrime.map_eq_maximalIdeal 𝔫 E
          have hnE : algebraMap S_quot E n_s ∈ IsLocalRing.maximalIdeal E :=
            hmap_max ▸ Ideal.mem_map_of_mem (algebraMap S_quot E) hns_mem
          have hτnE : algebraMap S_quot E (τ_S n_s) ∈ IsLocalRing.maximalIdeal E :=
            hmap_max ▸ Ideal.mem_map_of_mem (algebraMap S_quot E) hτns_mem
          have hs_eq : s = n_s + algebraMap D S_quot d_c := (sub_add_cancel s _).symm
          rw [hs_eq, map_add, map_add]
          have hd_fix : τ_E (algebraMap S_quot E (algebraMap D S_quot d_c)) =
              algebraMap S_quot E (algebraMap D S_quot d_c) := τ_E.commutes d_c
          have hn_eval : τ_E (algebraMap S_quot E n_s) = algebraMap S_quot E (τ_S n_s) :=
            hτ_E_eq n_s
          rw [hd_fix, hn_eval, add_sub_add_right_eq_sub]
          exact Ideal.sub_mem _ hτnE hnE
        intro w
        obtain ⟨⟨s, u⟩, hwu⟩ := IsLocalization.surj 𝔫.primeCompl w
        have h_diff : (τ_E w - w) * algebraMap S_quot E u.1 ∈ IsLocalRing.maximalIdeal E := by
          have h1 : (τ_E w - w) * algebraMap S_quot E u.1 =
              (τ_E (algebraMap S_quot E s) - algebraMap S_quot E s) -
              τ_E w * (τ_E (algebraMap S_quot E u.1) - algebraMap S_quot E u.1) := by
            have hτwu : τ_E w * τ_E (algebraMap S_quot E u.1) = τ_E (algebraMap S_quot E s) := by
              rw [← map_mul, hwu]
            linear_combination hτwu - hwu
          rw [h1]
          exact Ideal.sub_mem _ (hS_mod s) (Ideal.mul_mem_left _ _ (hS_mod u.1))
        rcases (IsLocalization.map_units E u).exists_right_inv with ⟨v, hv⟩
        have h2 := Ideal.mul_mem_right v _ h_diff
        rwa [mul_assoc, hv, mul_one] at h2
      haveI : Algebra.FormallyUnramified D S_quot := inferInstance
      haveI : Algebra.FormallyUnramified S_quot E :=
        Algebra.FormallyUnramified.of_isLocalization 𝔫.primeCompl
      haveI : Algebra.FormallyUnramified D E := Algebra.FormallyUnramified.comp D S_quot E
      have hτ_E_pow : ∀ (m : ℕ) (w : E), τ_E w - w ∈ (IsLocalRing.maximalIdeal E) ^ m := by
        intro m
        induction m with
        | zero => intro w; rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
        | succ m _ =>
          let J_m : Ideal E := (IsLocalRing.maximalIdeal E) ^ (m + 1)
          let q_m : E →ₐ[D] E ⧸ J_m := Ideal.Quotient.mkₐ D J_m
          let I_m : Ideal (E ⧸ J_m) :=
            Ideal.map (Ideal.Quotient.mk J_m) (IsLocalRing.maximalIdeal E)
          have hNil : IsNilpotent I_m := ⟨m + 1,
            ((Ideal.map_pow (Ideal.Quotient.mk J_m) (IsLocalRing.maximalIdeal E) (m + 1)).symm.trans
              (Ideal.map_quotient_self J_m)).trans Ideal.zero_eq_bot.symm⟩
          have h_ext : q_m.comp τ_E = q_m :=
            @Algebra.FormallyUnramified.ext D _ E _ _ (E ⧸ J_m) _ _ I_m inferInstance hNil
              (q_m.comp τ_E) q_m (fun x => Ideal.Quotient.eq.mpr (by
                change Ideal.Quotient.mk J_m (τ_E x) - Ideal.Quotient.mk J_m x ∈ I_m
                rw [← RingHom.map_sub]
                exact Ideal.mem_map_of_mem (Ideal.Quotient.mk J_m) (hτ_E_mod_max x)))
          intro w
          have hw0 : q_m (τ_E w) = q_m w := AlgHom.congr_fun h_ext w
          apply Ideal.Quotient.eq_zero_iff_mem.mp
          change q_m (τ_E w - w) = 0
          rw [map_sub, hw0, sub_self]
      haveI : IsNoetherianRing S_quot := IsNoetherianRing.of_finite D S_quot
      haveI : IsNoetherianRing E := IsLocalization.isNoetherianRing 𝔫.primeCompl E inferInstance
      have h_iInf_E := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal E)
        (IsLocalRing.maximalIdeal.isMaximal E).ne_top
      have hτ_E_id : ∀ w : E, τ_E w = w := by
        intro w
        have hmem : τ_E w - w ∈ ⨅ m : ℕ, (IsLocalRing.maximalIdeal E) ^ m :=
          Ideal.mem_iInf.mpr (fun m => hτ_E_pow m w)
        rw [h_iInf_E, Ideal.mem_bot] at hmem
        exact sub_eq_zero.mp hmem
      change ψ (τ_B b - b) = 0
      rw [map_sub]
      change algebraMap S_quot E (τ_S (q_B b)) - ψ b = 0
      rw [← hτ_E_eq]
      change τ_E (ψ b) - ψ b = 0
      rw [hτ_E_id (ψ b), sub_self]

  
  have hReynoldsDescent : ∀ (C B H : Type u) [CommRing C] [CommRing B] [Algebra C B]
      [Group H] [Finite H] [MulSemiringAction H B] [SMulCommClass H C B]
      (ℛ : B →ₗ[C] C),
      (∀ c : C, ℛ (algebraMap C B c) = c) →
      (∀ b : B, (∀ g : H, g • b = b) → algebraMap C B (ℛ b) = b) →
      (∀ (𝔑 : Ideal B) [𝔑.IsMaximal],
        IsDomain (Localization.AtPrime 𝔑) ∧ IsIntegrallyClosed (Localization.AtPrime 𝔑)) →
      ∀ (𝔪 : Ideal C) [𝔪.IsMaximal]
        (R_bar : Type u) [CommRing R_bar] [Algebra C R_bar] [IsLocalization.AtPrime R_bar 𝔪],
        IsDomain R_bar ∧ IsIntegrallyClosed R_bar := by
    intro C B H _ _ _ _ _ _ _ ℛ hℛ_id hℛ_inv hLocal 𝔪 h𝔪_max R_bar _ _ _
    let j : C →+* B := algebraMap C B
    have hj_inj : Function.Injective j := fun c₁ c₂ hc => by
      have := congrArg ℛ hc
      rwa [hℛ_id, hℛ_id] at this
    haveI : Algebra.IsInvariant C B H :=
      Algebra.IsInvariant.mk (fun b hb => ⟨ℛ b, hℛ_inv b hb⟩)
    haveI : Algebra.IsIntegral C B := Algebra.IsInvariant.isIntegral C B H
    have hConductor : ∀ (J : Ideal B),
        (∀ (𝔑 : Ideal B) [𝔑.IsMaximal], Ideal.comap j 𝔑 = 𝔪 → ¬ (J ≤ 𝔑)) →
        ∃ u ∈ J, ℛ u ∉ 𝔪 := by
      intro J hJ_not_le
      have hsup_top : J ⊔ Ideal.map j 𝔪 = ⊤ := by
        by_contra hne
        obtain ⟨𝔑, h𝔑_max, hle⟩ := Ideal.exists_le_maximal (J ⊔ Ideal.map j 𝔪) hne
        have hJ_le : J ≤ 𝔑 := le_sup_left.trans hle
        have hmap_le : Ideal.map j 𝔪 ≤ 𝔑 := le_sup_right.trans hle
        have h𝔪_le : 𝔪 ≤ Ideal.comap j 𝔑 := Ideal.le_comap_of_map_le hmap_le
        have hcomap_ne_top : Ideal.comap j 𝔑 ≠ ⊤ := fun htop =>
          h𝔑_max.ne_top ((Ideal.eq_top_iff_one _).mpr
            (by simpa using (Ideal.eq_top_iff_one _).mp htop))
        have hcomap_eq : Ideal.comap j 𝔑 = 𝔪 := (h𝔪_max.eq_of_le hcomap_ne_top h𝔪_le).symm
        exact @hJ_not_le 𝔑 h𝔑_max hcomap_eq hJ_le
      have h1_mem : (1 : B) ∈ J ⊔ Ideal.map j 𝔪 := hsup_top ▸ trivial
      rcases Submodule.mem_sup.mp h1_mem with ⟨u, hu_J, w, hw_map, huw⟩
      let K_𝔪 : Ideal B :=
        { carrier := { x : B | ∀ b : B, ℛ (b * x) ∈ 𝔪 }
          add_mem' := fun {x y} hx hy b => by rw [mul_add, map_add]; exact 𝔪.add_mem (hx b) (hy b)
          zero_mem' := fun b => by rw [mul_zero, map_zero]; exact 𝔪.zero_mem
          smul_mem' := fun c {x} hx b => by
            change ℛ (b * (c * x)) ∈ 𝔪
            rw [← mul_assoc]
            exact hx (b * c) }
      have hmap_le_K : Ideal.map j 𝔪 ≤ K_𝔪 := by
        rw [Ideal.map, Ideal.span_le]
        rintro _ ⟨m, hm, rfl⟩ b
        change ℛ (b * algebraMap C B m) ∈ 𝔪
        rw [mul_comm, ← Algebra.smul_def, LinearMap.map_smul, smul_eq_mul]
        exact Ideal.mul_mem_right _ 𝔪 hm
      have hℛw : ℛ w ∈ 𝔪 := by
        have hwK : w ∈ K_𝔪 := hmap_le_K hw_map
        simpa [one_mul] using hwK 1
      refine ⟨u, hu_J, fun hℛu => h𝔪_max.ne_top ((Ideal.eq_top_iff_one _).mpr ?_)⟩
      have h1_C : ℛ u + ℛ w = 1 := by
        rw [← map_add, huw, ← map_one (algebraMap C B)]
        exact hℛ_id 1
      rw [← h1_C]
      exact 𝔪.add_mem hℛu hℛw
    haveI : IsLocalRing R_bar := IsLocalization.AtPrime.isLocalRing R_bar 𝔪
    let φ : C →+* R_bar := algebraMap C R_bar
    have hker_le : RingHom.ker j ≤ 𝔪 := by
      intro c hc
      have hc0 : c = 0 := hj_inj (hc.trans (map_zero j).symm)
      rw [hc0]
      exact 𝔪.zero_mem
    obtain ⟨𝔑₁, h𝔑₁_max, h𝔑₁_under⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral 𝔪 hker_le
    have hLocInj : ∀ (𝔑 : Ideal B) [𝔑.IsMaximal] (h𝔑_over : Ideal.comap j 𝔑 = 𝔪),
        ∃ lam_𝔑 : R_bar →+* Localization.AtPrime 𝔑,
          Function.Injective lam_𝔑 ∧
          ∀ c : C, lam_𝔑 (φ c) = algebraMap B (Localization.AtPrime 𝔑) (j c) := by
      intro 𝔑 h𝔑_max h𝔑_over
      let E_𝔑 := Localization.AtPrime 𝔑
      let ι_𝔑 := algebraMap B E_𝔑
      have h_units : ∀ s : 𝔪.primeCompl, IsUnit ((ι_𝔑.comp j) s.1) :=
        fun s => IsLocalization.map_units E_𝔑
          (⟨j s.1, fun h => s.2 ((SetLike.ext_iff.mp h𝔑_over s.1).mp h)⟩ : 𝔑.primeCompl)
      obtain ⟨lam_𝔑, hlam_eq⟩ : ∃ lam_𝔑 : R_bar →+* E_𝔑,
          ∀ c : C, lam_𝔑 (φ c) = ι_𝔑 (j c) :=
        ⟨IsLocalization.lift h_units, IsLocalization.lift_eq h_units⟩
      refine ⟨lam_𝔑, (injective_iff_map_eq_zero lam_𝔑).mpr ?_, hlam_eq⟩
      intro r hr0
      obtain ⟨⟨c, s⟩, hrs⟩ := IsLocalization.surj 𝔪.primeCompl r
      have hι_jc : ι_𝔑 (j c) = 0 := by
        rw [← hlam_eq, ← hrs, map_mul, hr0, zero_mul]
      have hι_eq0 : ι_𝔑 (j c) = ι_𝔑 0 := by rw [hι_jc, map_zero]
      obtain ⟨u₀, hu₀_eq⟩ := IsLocalization.exists_of_eq (M := 𝔑.primeCompl) hι_eq0
      rw [mul_zero] at hu₀_eq
      let J_c : Ideal B :=
        { carrier := { u : B | u * j c = 0 }
          add_mem' := fun {x y} hx hy => by
            change (x + y) * j c = 0
            rw [add_mul, hx, hy, add_zero]
          zero_mem' := zero_mul _
          smul_mem' := fun b {x} hx => by change (b * x) * j c = 0; rw [mul_assoc, hx, mul_zero] }
      have hJc_not_le : ∀ (𝔑' : Ideal B) [𝔑'.IsMaximal], Ideal.comap j 𝔑' = 𝔪 → ¬ (J_c ≤ 𝔑') := by
        intro 𝔑' h𝔑'_max h𝔑'_over hle
        have h_under : Ideal.under C 𝔑 = Ideal.under C 𝔑' := h𝔑_over.trans h𝔑'_over.symm
        obtain ⟨g, hg_eq⟩ := Algebra.IsInvariant.exists_smul_of_under_eq C B H 𝔑 𝔑' h_under
        have hgu_mem : g • u₀.1 ∈ J_c := by
          change (g • u₀.1) * algebraMap C B c = 0
          rw [mul_comm, ← Algebra.smul_def, ← smul_comm g c u₀.1, Algebra.smul_def, mul_comm,
            hu₀_eq, smul_zero]
        have hgu_not : g • u₀.1 ∉ 𝔑' := by
          rw [hg_eq, Ideal.mem_pointwise_smul_iff_inv_smul_mem, inv_smul_smul]
          exact u₀.2
        exact hgu_not (hle hgu_mem)
      obtain ⟨u, hu_Jc, hℛu_not⟩ := hConductor J_c hJc_not_le
      have hct : c * ℛ u = 0 := by
        calc
          c * ℛ u = c • ℛ u := (smul_eq_mul c (ℛ u)).symm
          _ = ℛ (c • u) := (LinearMap.map_smul ℛ c u).symm
          _ = ℛ (u * j c) := by rw [Algebra.smul_def, mul_comm]
          _ = ℛ 0 := congrArg ℛ hu_Jc
          _ = 0 := map_zero ℛ
      have hφc : φ c = 0 := by
        have hmul0 : φ c * algebraMap C R_bar (ℛ u) = 0 := by
          change φ c * φ (ℛ u) = 0
          rw [← map_mul, hct, map_zero]
        rcases (IsLocalization.map_units R_bar (⟨ℛ u, hℛu_not⟩ : 𝔪.primeCompl)).exists_right_inv
          with ⟨v, hv⟩
        have h1 := congrArg (· * v) hmul0
        rw [mul_assoc, hv, mul_one, zero_mul] at h1
        exact h1
      rcases (IsLocalization.map_units R_bar s).exists_right_inv with ⟨vs, hvs⟩
      have hrs0 : r * algebraMap C R_bar s.1 = 0 := by
        change r * φ s.1 = 0
        rw [hrs, hφc]
      have h2 := congrArg (· * vs) hrs0
      rw [mul_assoc, hvs, mul_one, zero_mul] at h2
      exact h2
    haveI : IsDomain R_bar := by
      letI : 𝔑₁.IsMaximal := h𝔑₁_max
      letI : IsDomain (Localization.AtPrime 𝔑₁) := (hLocal 𝔑₁).1
      obtain ⟨lam₁, hlam1_inj, _⟩ := hLocInj 𝔑₁ h𝔑₁_under
      exact Function.Injective.isDomain lam₁ hlam1_inj
    refine ⟨inferInstance, (isIntegrallyClosed_iff (FractionRing R_bar)).mpr ?_⟩
    intro z hz
    let κ := algebraMap R_bar (FractionRing R_bar)
