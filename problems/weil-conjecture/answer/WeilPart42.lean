  have hPresInj : ∀ (I : CategoryTheory.Sheaf Z_U.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Injective I → CategoryTheory.Injective (pb_w'.obj I) := by
    let W_u : Z_U.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ w' hw'
    let Z_σ : ∀ (Z₀ : Z_U.Etale), (Z₀ ⟶ W_u) → V_U.Etale := fun Z₀ σ =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ σ.left
        (CategoryTheory.MorphismProperty.of_postcomp P_et σ.left w' hw'
          ((CategoryTheory.MorphismProperty.Over.w σ).symm ▸ Z₀.prop))
    let u_σ : ∀ {Z₁ Z₂ : Z_U.Etale} (f : Z₂ ⟶ Z₁) (σ : Z₁ ⟶ W_u),
        Z_σ Z₂ (f ≫ σ) ⟶ Z_σ Z₁ σ := fun f _ =>
      CategoryTheory.MorphismProperty.Over.homMk f.left rfl trivial
    have hSigma_congr : ∀ (P : V_U.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) (Z₀ : Z_U.Etale)
        {σ₁ σ₂ : Z₀ ⟶ W_u} (hσ : σ₁ = σ₂) {Y : V_U.Etale}
        (m₁ : Z_σ Z₀ σ₁ ⟶ Y) (m₂ : Z_σ Z₀ σ₂ ⟶ Y),
        m₁.left = m₂.left →
        P.map m₁.op ≫ CategoryTheory.Limits.Sigma.ι (fun σ : Z₀ ⟶ W_u => P.obj (Opposite.op (Z_σ Z₀ σ))) σ₁ =
        P.map m₂.op ≫ CategoryTheory.Limits.Sigma.ι (fun σ : Z₀ ⟶ W_u => P.obj (Opposite.op (Z_σ Z₀ σ))) σ₂ := by
      intro P Z₀ σ₁ σ₂ hσ Y m₁ m₂ hm
      subst hσ
      have hm_eq : m₁ = m₂ := CategoryTheory.MorphismProperty.Over.Hom.ext hm
      subst hm_eq
      rfl
    let L_pre : (V_U.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) ⥤ (Z_U.Etaleᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      { obj := fun P =>
          { obj := fun Z₀ =>
              CategoryTheory.Limits.sigmaObj (fun σ : Z₀.unop ⟶ W_u => P.obj (Opposite.op (Z_σ Z₀.unop σ)))
            map := fun {Z₁ Z₂} f =>
              CategoryTheory.Limits.Sigma.desc (fun σ : Z₁.unop ⟶ W_u =>
                P.map (u_σ f.unop σ).op ≫
                  CategoryTheory.Limits.Sigma.ι
                    (fun τ : Z₂.unop ⟶ W_u => P.obj (Opposite.op (Z_σ Z₂.unop τ))) (f.unop ≫ σ))
            map_id := fun Z₀ => by
              apply CategoryTheory.Limits.Sigma.hom_ext
              intro σ
              rw [CategoryTheory.Limits.Sigma.ι_comp_desc, Category.comp_id]
              exact (hSigma_congr P Z₀.unop (Category.id_comp σ)
                (u_σ (𝟙 Z₀.unop) σ) (𝟙 (Z_σ Z₀.unop σ)) rfl).trans
                (by rw [op_id, P.map_id, Category.id_comp])
            map_comp := fun {Z₁ Z₂ Z₃} f g => by
              apply CategoryTheory.Limits.Sigma.hom_ext
              intro σ
              rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Limits.Sigma.ι_comp_desc_assoc,
                Category.assoc, CategoryTheory.Limits.Sigma.ι_comp_desc, ← Category.assoc,
                ← P.map_comp, ← op_comp]
              exact hSigma_congr P Z₃.unop (Category.assoc g.unop f.unop σ)
                (u_σ (g.unop ≫ f.unop) σ) (u_σ g.unop (f.unop ≫ σ) ≫ u_σ f.unop σ) rfl }
        map := fun {P₁ P₂} α =>
          { app := fun Z₀ =>
              CategoryTheory.Limits.Sigma.map (fun σ : Z₀.unop ⟶ W_u =>
                α.app (Opposite.op (Z_σ Z₀.unop σ)))
            naturality := fun {Z₁ Z₂} f => by
              apply CategoryTheory.Limits.Sigma.hom_ext
              intro σ
              dsimp
