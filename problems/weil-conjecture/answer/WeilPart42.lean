      exact Ideal.subset_span (Set.mem_singleton h₀)
    exact hm
  
  
  
  have hθ_frac : ∀ f : RatFunc k, ∃ a c : A, θ_0 c ≠ 0 ∧ f * θ_0 c = θ_0 a := by
    intro f
    obtain ⟨⟨Q₁, Q₂⟩, hQ⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial k)) f
    have hQ₂_ne : Q₂.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp Q₂.2
    let N : ℕ := max Q₁.natDegree Q₂.1.natDegree
    have hN_mul : N ≤ N * d_Sigma := by
      calc N = N * 1 := (Nat.mul_one N).symm
        _ ≤ N * d_Sigma := Nat.mul_le_mul_left N hd_Sigma
    have hQ₁_deg : Q₁.natDegree ≤ N * d_Sigma := le_trans (le_max_left _ _) hN_mul
    have hQ₂_deg : Q₂.1.natDegree ≤ N * d_Sigma := le_trans (le_max_right _ _) hN_mul
    let p₀_RF : RatFunc k := algebraMap (Polynomial k) (RatFunc k) P₀
    have hp₀_RF_ne : p₀_RF ≠ 0 :=
      (map_ne_zero_iff (algebraMap (Polynomial k) (RatFunc k)) (RatFunc.algebraMap_injective k)).mpr hP₀_ne
    have hq₂_RF_ne : algebraMap (Polynomial k) (RatFunc k) Q₂.1 ≠ 0 :=
      (map_ne_zero_iff (algebraMap (Polynomial k) (RatFunc k)) (RatFunc.algebraMap_injective k)).mpr hQ₂_ne
    have h_num_mem : algebraMap (Polynomial k) (RatFunc k) Q₁ / p₀_RF ^ N ∈ Set.range θ_0 := by
      rw [hθ_range]
      exact ⟨N, Q₁, hQ₁_deg, rfl⟩
    have h_den_mem : algebraMap (Polynomial k) (RatFunc k) Q₂.1 / p₀_RF ^ N ∈ Set.range θ_0 := by
      rw [hθ_range]
      exact ⟨N, Q₂.1, hQ₂_deg, rfl⟩
    rcases h_num_mem with ⟨a, ha⟩
    rcases h_den_mem with ⟨c, hc⟩
    refine ⟨a, c, ?_, ?_⟩
    · rw [hc]
      exact div_ne_zero hq₂_RF_ne (pow_ne_zero N hp₀_RF_ne)
    · rw [hc, ha, ← mul_div_assoc, hQ]

  have hComap_h₀ : ∀ g : A, algebraMap A ↥B₂_0 g ∈ I_h₀ ↔ g ∈ Ideal.span {h₀} := by
    intro g
    constructor
    · intro hg
      rcases Ideal.mem_span_singleton.mp hg with ⟨z, hz⟩
      have hz_val : algebraMap A L₂ g = algebraMap A L₂ h₀ * (z : L₂) :=
        congrArg Subtype.val hz
      rw [hAlgAL₂_eq g, hAlgAL₂_eq h₀] at hz_val
      let h₀_K₂ : K₂ := algebraMap A K₂ h₀
      let g_K₂ : K₂ := algebraMap A K₂ g
      have hh₀_K₂_ne : h₀_K₂ ≠ 0 :=
        (map_ne_zero_iff (algebraMap A K₂) (IsFractionRing.injective A K₂)).mpr hh₀_ne
      have hh₀_L₂_ne : algebraMap K₂ L₂ h₀_K₂ ≠ 0 :=
        (map_ne_zero_iff (algebraMap K₂ L₂) (algebraMap K₂ L₂).injective).mpr hh₀_K₂_ne
      have hz_eq : (z : L₂) = IsScalarTower.toAlgHom A K₂ L₂ (g_K₂ / h₀_K₂) := by
        apply mul_left_cancel₀ hh₀_L₂_ne
        calc algebraMap K₂ L₂ h₀_K₂ * (z : L₂)
            = algebraMap K₂ L₂ g_K₂ := hz_val.symm
          _ = algebraMap K₂ L₂ (h₀_K₂ * (g_K₂ / h₀_K₂)) := by
              rw [mul_div_cancel₀ g_K₂ hh₀_K₂_ne]
          _ = algebraMap K₂ L₂ h₀_K₂ * IsScalarTower.toAlgHom A K₂ L₂ (g_K₂ / h₀_K₂) := by
              simp [IsScalarTower.toAlgHom]
      have hInt_L₂ : IsIntegral A (IsScalarTower.toAlgHom A K₂ L₂ (g_K₂ / h₀_K₂)) := by
        rw [← hz_eq]
        exact z.2
      have hInt_K₂ : IsIntegral A (g_K₂ / h₀_K₂) :=
        (isIntegral_algHom_iff (IsScalarTower.toAlgHom A K₂ L₂) (algebraMap K₂ L₂).injective).mp hInt_L₂
      obtain ⟨q, hq⟩ := IsIntegrallyClosed.isIntegral_iff.mp hInt_K₂
      have hg_eq : g = h₀ * q := by
        apply IsFractionRing.injective A K₂
        rw [map_mul, hq]
        exact (mul_div_cancel₀ g_K₂ hh₀_K₂_ne).symm
      exact Ideal.mem_span_singleton.mpr ⟨q, hg_eq⟩
    · intro hg
      rcases Ideal.mem_span_singleton.mp hg with ⟨q, hq⟩
      rw [hq, map_mul]
      exact Ideal.mem_span_singleton.mpr ⟨algebraMap A ↥B₂_0 q, rfl⟩

  have hBase : ∃ (L_Sigma : Type u)
      (_ : Field L_Sigma)
      (_ : Algebra k L_Sigma)
      (_ : Algebra (Polynomial k) L_Sigma)
      (_ : Algebra (RatFunc k) L_Sigma)
      (_ : IsScalarTower k (Polynomial k) L_Sigma)
      (_ : IsScalarTower k (RatFunc k) L_Sigma)
      (_ : IsScalarTower (Polynomial k) (RatFunc k) L_Sigma)
      (ι_0 : (↥B₂_0 ⧸ I_h₀) →+* L_Sigma),
      Function.Injective ι_0 ∧
      (letI : Algebra (↥B₂_0 ⧸ I_h₀) L_Sigma := ι_0.toAlgebra
       IsFractionRing (↥B₂_0 ⧸ I_h₀) L_Sigma) ∧
      (∀ g : A, ι_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) =
        algebraMap (RatFunc k) L_Sigma (θ_0 g)) ∧
      (let D_0 : Subalgebra k (RatFunc k) := θ_0.range
       letI : Algebra ↥D_0 L_Sigma :=
         ((algebraMap (RatFunc k) L_Sigma).comp D_0.val.toRingHom).toAlgebra
       ∀ z : L_Sigma, z ∈ Set.range ι_0 ↔ IsIntegral ↥D_0 z) := by
    let ι_raw : (↥B₂_0 ⧸ I_h₀) →+* FractionRing (↥B₂_0 ⧸ I_h₀) :=
      algebraMap (↥B₂_0 ⧸ I_h₀) (FractionRing (↥B₂_0 ⧸ I_h₀))
    have hι_raw_inj : Function.Injective ι_raw :=
      IsFractionRing.injective (↥B₂_0 ⧸ I_h₀) (FractionRing (↥B₂_0 ⧸ I_h₀))
    have hFrac_raw :
        (letI : Algebra (↥B₂_0 ⧸ I_h₀) (FractionRing (↥B₂_0 ⧸ I_h₀)) := ι_raw.toAlgebra
         IsFractionRing (↥B₂_0 ⧸ I_h₀) (FractionRing (↥B₂_0 ⧸ I_h₀))) := by
      let h0 : IsFractionRing (↥B₂_0 ⧸ I_h₀) (FractionRing (↥B₂_0 ⧸ I_h₀)) := inferInstance
      letI : Algebra (↥B₂_0 ⧸ I_h₀) (FractionRing (↥B₂_0 ⧸ I_h₀)) := ι_raw.toAlgebra
      exact { map_units := @h0.map_units, surj := @h0.surj, exists_of_eq := @h0.exists_of_eq }
    let D_0 : Subalgebra k (RatFunc k) := θ_0.range
    letI : IsFractionRing ↥D_0 (RatFunc k) :=
      { map_units := fun y => by
          have hy_ne : (y.1 : ↥D_0) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
          have hy_val_ne : (y.1 : RatFunc k) ≠ 0 := fun h => hy_ne (Subtype.ext h)
          exact IsUnit.mk0 (algebraMap ↥D_0 (RatFunc k) y.1) hy_val_ne
        surj := fun f => by
          obtain ⟨a, c, hc_ne, hfc⟩ := hθ_frac f
          let d_a : ↥D_0 := ⟨θ_0 a, ⟨a, rfl⟩⟩
          let d_c : ↥D_0 := ⟨θ_0 c, ⟨c, rfl⟩⟩
          have hdc_ne : d_c ≠ 0 := fun h => hc_ne (congrArg Subtype.val h)
          refine ⟨⟨d_a, ⟨d_c, mem_nonZeroDivisors_of_ne_zero hdc_ne⟩⟩, ?_⟩
          exact hfc
        exists_of_eq := fun {x y} hxy => ⟨1, by simp [Subtype.ext hxy]⟩ }
    let π_A : A →+* (↥B₂_0 ⧸ I_h₀) := (Ideal.Quotient.mk I_h₀).comp (algebraMap A ↥B₂_0)
    have hπ_iff : ∀ g : A, π_A g = 0 ↔ θ_0 g = 0 := by
      intro g
      change Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g) = 0 ↔ θ_0 g = 0
      rw [Ideal.Quotient.eq_zero_iff_mem, hComap_h₀, ← hθ_ker]
      rfl
    let α_fn : ↥D_0 → (↥B₂_0 ⧸ I_h₀) := fun d => π_A (Classical.choose d.2)
    have hchoose : ∀ d : ↥D_0, θ_0 (Classical.choose d.2) = d.1 :=
      fun d => Classical.choose_spec d.2
    have hα_spec : ∀ (g : A) (d : ↥D_0), θ_0 g = d.1 → α_fn d = π_A g := by
      intro g d hgd
      have hsub : θ_0 (Classical.choose d.2 - g) = 0 := by
        rw [map_sub, hchoose d, hgd, sub_self]
      have hπ_sub : π_A (Classical.choose d.2 - g) = 0 := (hπ_iff _).mpr hsub
      rw [map_sub] at hπ_sub
      exact sub_eq_zero.mp hπ_sub
    let α_0 : ↥D_0 →+* (↥B₂_0 ⧸ I_h₀) :=
      { toFun := α_fn
        map_one' := by
          rw [hα_spec 1 1 (map_one θ_0)]
          exact map_one π_A
        map_mul' := fun d₁ d₂ => by
          have hm : θ_0 (Classical.choose d₁.2 * Classical.choose d₂.2) = (d₁ * d₂).1 := by
            rw [map_mul, hchoose d₁, hchoose d₂]; rfl
          rw [hα_spec _ (d₁ * d₂) hm, map_mul]
        map_zero' := by
          rw [hα_spec 0 0 (map_zero θ_0)]
          exact map_zero π_A
        map_add' := fun d₁ d₂ => by
          have ha : θ_0 (Classical.choose d₁.2 + Classical.choose d₂.2) = (d₁ + d₂).1 := by
            rw [map_add, hchoose d₁, hchoose d₂]; rfl
          rw [hα_spec _ (d₁ + d₂) ha, map_add] }
    have hα_apply : ∀ (g : A) (d : ↥D_0), θ_0 g = d.1 → α_0 d = π_A g := hα_spec
    have hα_inj : Function.Injective α_0 := by
      intro d₁ d₂ heq
      have hsub : π_A (Classical.choose d₁.2 - Classical.choose d₂.2) = 0 := by
        rw [map_sub]
        exact sub_eq_zero.mpr heq
      have hθ_sub : θ_0 (Classical.choose d₁.2 - Classical.choose d₂.2) = 0 :=
        (hπ_iff _).mp hsub
      rw [map_sub, hchoose d₁, hchoose d₂] at hθ_sub
      exact Subtype.ext (sub_eq_zero.mp hθ_sub)
    let g_lift : ↥D_0 →+* FractionRing (↥B₂_0 ⧸ I_h₀) := ι_raw.comp α_0
    have hg_units : ∀ y : nonZeroDivisors ↥D_0, IsUnit (g_lift y.1) := by
      intro y
      have hy_ne : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      have hgy_ne : g_lift y.1 ≠ 0 :=
        (map_ne_zero_iff g_lift (hι_raw_inj.comp hα_inj)).mpr hy_ne
      exact IsUnit.mk0 (g_lift y.1) hgy_ne
    let j_RF : RatFunc k →+* FractionRing (↥B₂_0 ⧸ I_h₀) := IsLocalization.lift hg_units
    have hj_RF_eq : ∀ d : ↥D_0, j_RF d.1 = ι_raw (α_0 d) :=
      fun d => IsLocalization.lift_eq hg_units d
    let instAlg_RF : Algebra (RatFunc k) (FractionRing (↥B₂_0 ⧸ I_h₀)) := j_RF.toAlgebra
    let instAlg_P : Algebra (Polynomial k) (FractionRing (↥B₂_0 ⧸ I_h₀)) :=
      (j_RF.comp (algebraMap (Polynomial k) (RatFunc k))).toAlgebra
    let instAlg_k : Algebra k (FractionRing (↥B₂_0 ⧸ I_h₀)) :=
      (j_RF.comp (algebraMap k (RatFunc k))).toAlgebra
    have hST_kP : @IsScalarTower k (Polynomial k) (FractionRing (↥B₂_0 ⧸ I_h₀))
        _ instAlg_P.toSMul instAlg_k.toSMul := by
      letI : Algebra (Polynomial k) (FractionRing (↥B₂_0 ⧸ I_h₀)) := instAlg_P
      letI : Algebra k (FractionRing (↥B₂_0 ⧸ I_h₀)) := instAlg_k
      refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
      change j_RF (algebraMap k (RatFunc k) c) =
        j_RF (algebraMap (Polynomial k) (RatFunc k) (algebraMap k (Polynomial k) c))
      rw [← IsScalarTower.algebraMap_apply k (Polynomial k) (RatFunc k)]
    have hST_kRF : @IsScalarTower k (RatFunc k) (FractionRing (↥B₂_0 ⧸ I_h₀))
        _ instAlg_RF.toSMul instAlg_k.toSMul := by
      letI : Algebra (RatFunc k) (FractionRing (↥B₂_0 ⧸ I_h₀)) := instAlg_RF
      letI : Algebra k (FractionRing (↥B₂_0 ⧸ I_h₀)) := instAlg_k
      exact IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hST_PRF : @IsScalarTower (Polynomial k) (RatFunc k) (FractionRing (↥B₂_0 ⧸ I_h₀))
        _ instAlg_RF.toSMul instAlg_P.toSMul := by
      letI : Algebra (RatFunc k) (FractionRing (↥B₂_0 ⧸ I_h₀)) := instAlg_RF
      letI : Algebra (Polynomial k) (FractionRing (↥B₂_0 ⧸ I_h₀)) := instAlg_P
      exact IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hAlign_raw : ∀ g : A,
        ι_raw (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 g)) = j_RF (θ_0 g) := by
      intro g
      let d_g : ↥D_0 := ⟨θ_0 g, ⟨g, rfl⟩⟩
      change ι_raw (π_A g) = j_RF d_g.1
      rw [hj_RF_eq d_g, hα_apply g d_g rfl]
    refine ⟨FractionRing (↥B₂_0 ⧸ I_h₀), inferInstance, instAlg_k, instAlg_P, instAlg_RF,
      hST_kP, hST_kRF, hST_PRF, ι_raw, hι_raw_inj, hFrac_raw, hAlign_raw, ?_⟩
    dsimp only
    letI : Algebra (RatFunc k) (FractionRing (↥B₂_0 ⧸ I_h₀)) := instAlg_RF
    letI : Algebra ↥D_0 (FractionRing (↥B₂_0 ⧸ I_h₀)) :=
      ((algebraMap (RatFunc k) (FractionRing (↥B₂_0 ⧸ I_h₀))).comp D_0.val.toRingHom).toAlgebra
    have hAlgD0_eq : ∀ d : ↥D_0,
        algebraMap ↥D_0 (FractionRing (↥B₂_0 ⧸ I_h₀)) d = ι_raw (α_0 d) := by
      intro d
      exact hj_RF_eq d
    intro z
    constructor
    · rintro ⟨u, rfl⟩
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective u
      rcases y.2 with ⟨P, hP_mon, hP_eval⟩
      have hP_B2 : Polynomial.eval₂ (algebraMap A ↥B₂_0) y P = 0 := by
        apply Subtype.ext
        calc (Polynomial.eval₂ (algebraMap A ↥B₂_0) y P).1
            = B₂_0.val.toRingHom (Polynomial.eval₂ (algebraMap A ↥B₂_0) y P) := rfl
          _ = Polynomial.eval₂ (B₂_0.val.toRingHom.comp (algebraMap A ↥B₂_0)) y.1 P :=
                Polynomial.hom_eval₂ P (algebraMap A ↥B₂_0) B₂_0.val.toRingHom y
          _ = Polynomial.eval₂ (algebraMap A L₂) y.1 P := rfl
          _ = 0 := hP_eval
      let θ_D0 : A →+* ↥D_0 := θ_0.rangeRestrict.toRingHom
      refine ⟨P.map θ_D0, hP_mon.map θ_D0, ?_⟩
      rw [Polynomial.eval₂_map]
      let ψ_B : ↥B₂_0 →+* FractionRing (↥B₂_0 ⧸ I_h₀) := ι_raw.comp (Ideal.Quotient.mk I_h₀)
      have hcomp_eq :
          (algebraMap ↥D_0 (FractionRing (↥B₂_0 ⧸ I_h₀))).comp θ_D0 =
            ψ_B.comp (algebraMap A ↥B₂_0) := by
        apply RingHom.ext
        intro a
        exact (hAlign_raw a).symm
      rw [hcomp_eq]
      change Polynomial.eval₂ (ψ_B.comp (algebraMap A ↥B₂_0)) (ψ_B y) P = 0
      rw [← Polynomial.hom_eval₂, hP_B2, map_zero]
    · rintro ⟨P, hP_mon, hP_eval⟩
      have hInt_Q0 : IsIntegral (↥B₂_0 ⧸ I_h₀) z := by
        refine ⟨P.map α_0, hP_mon.map α_0, ?_⟩
        rw [Polynomial.eval₂_map]
        have hcomp_eq :
            (algebraMap (↥B₂_0 ⧸ I_h₀) (FractionRing (↥B₂_0 ⧸ I_h₀))).comp α_0 =
              algebraMap ↥D_0 (FractionRing (↥B₂_0 ⧸ I_h₀)) := by
          apply RingHom.ext
          intro d
          exact (hAlgD0_eq d).symm
        rw [hcomp_eq]
        exact hP_eval
      exact IsIntegrallyClosed.isIntegral_iff.mp hInt_Q0

  rcases hBase with ⟨L_Sigma, instFld, instAlg_k, instAlg_P, instAlg_RF,
    hST_kP, hST_kRF, hST_PRF, ι_0, hι0_inj, hFrac0, hAlign0, hIntCl0⟩
  letI : Field L_Sigma := instFld
  letI : Algebra k L_Sigma := instAlg_k
  letI : Algebra (Polynomial k) L_Sigma := instAlg_P
  letI : Algebra (RatFunc k) L_Sigma := instAlg_RF
  letI : IsScalarTower k (Polynomial k) L_Sigma := hST_kP
  letI : IsScalarTower k (RatFunc k) L_Sigma := hST_kRF
  letI : IsScalarTower (Polynomial k) (RatFunc k) L_Sigma := hST_PRF

  
  
  
  let p_inf : Fin 2 → k := ![P₁.coeff d_Sigma, P₂.coeff d_Sigma]
  let ev_inf : A →+* k := MvPolynomial.eval p_inf
  have hev_surj : Function.Surjective ev_inf :=
    fun c => ⟨MvPolynomial.C c, MvPolynomial.eval_C c⟩
  let 𝔪_inf : Ideal A := RingHom.ker ev_inf
  have h𝔪_max : 𝔪_inf.IsMaximal := RingHom.ker_isMaximal_of_surjective ev_inf hev_surj
  obtain ⟨s, b, hs_not_mem, hb_indep, hb_span⟩ := hLocFree_3charts 0 𝔪_inf h𝔪_max
  have hs_eval_ne : MvPolynomial.eval p_inf s ≠ 0 := hs_not_mem
  have hs_ne : s ≠ 0 := by
    intro hs0
    apply hs_eval_ne
    rw [hs0, map_zero]
  have hθs_ne : θ_0 s ≠ 0 := by
    intro hθs0
    have hs_ker : s ∈ RingHom.ker θ_0.toRingHom := hθs0
    rw [hθ_ker] at hs_ker
    rcases Ideal.mem_span_singleton.mp hs_ker with ⟨q, hq⟩
    apply hs_eval_ne
    rw [hq, map_mul, hPt_inf.2, zero_mul]

  let n := Module.finrank K₂ L₂
  let b_bar : Fin n → L_Sigma := fun i => ι_0 (Ideal.Quotient.mk I_h₀ (b i))

  have hb_bar_indep : LinearIndependent (RatFunc k) b_bar := by
    rw [Fintype.linearIndependent_iff]
    intro r hr i₀
    choose a_r c_r hc_r hrc using fun i => hθ_frac (r i)
    let C : A := ∏ j : Fin n, c_r j
    let d_i : Fin n → A := fun i => a_r i * ∏ j ∈ Finset.univ.erase i, c_r j
    have hθC_ne : θ_0 C ≠ 0 := by
      rw [map_prod]
      exact Finset.prod_ne_zero_iff.mpr (fun j _ => hc_r j)
    have hθd_eq : ∀ i : Fin n, θ_0 (d_i i) = θ_0 C * r i := by
      intro i
      have hC_split : C = c_r i * ∏ j ∈ Finset.univ.erase i, c_r j :=
        (Finset.mul_prod_erase Finset.univ c_r (Finset.mem_univ i)).symm
      calc θ_0 (d_i i)
          = θ_0 (a_r i) * θ_0 (∏ j ∈ Finset.univ.erase i, c_r j) := map_mul θ_0 _ _
        _ = (r i * θ_0 (c_r i)) * θ_0 (∏ j ∈ Finset.univ.erase i, c_r j) := by rw [← hrc i]
        _ = r i * (θ_0 (c_r i) * θ_0 (∏ j ∈ Finset.univ.erase i, c_r j)) := by ring
        _ = r i * θ_0 C := by rw [← map_mul, ← hC_split]
        _ = θ_0 C * r i := mul_comm _ _
    have hsum_L : ι_0 (Ideal.Quotient.mk I_h₀ (∑ i : Fin n, algebraMap A ↥B₂_0 (d_i i) * b i)) = 0 := by
      calc ι_0 (Ideal.Quotient.mk I_h₀ (∑ i : Fin n, algebraMap A ↥B₂_0 (d_i i) * b i))
          = ∑ i : Fin n, ι_0 (Ideal.Quotient.mk I_h₀ (algebraMap A ↥B₂_0 (d_i i))) * b_bar i := by
              simp only [map_sum, map_mul, b_bar]
        _ = ∑ i : Fin n, algebraMap (RatFunc k) L_Sigma (θ_0 (d_i i)) * b_bar i := by
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [hAlign0 (d_i i)]
        _ = ∑ i : Fin n, algebraMap (RatFunc k) L_Sigma (θ_0 C) * (r i • b_bar i) := by
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [hθd_eq i, map_mul, Algebra.smul_def, mul_assoc]
        _ = algebraMap (RatFunc k) L_Sigma (θ_0 C) * (∑ i : Fin n, r i • b_bar i) := by
              rw [Finset.mul_sum]
        _ = 0 := by rw [hr, mul_zero]
    have hsum_mem : (∑ i : Fin n, algebraMap A ↥B₂_0 (d_i i) * b i) ∈ I_h₀ := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      apply hι0_inj
      rw [hsum_L, map_zero]
    rcases Ideal.mem_span_singleton.mp hsum_mem with ⟨w, hw⟩
    obtain ⟨e_w, he_w⟩ := hb_span w
    have hrel_B : ∑ i : Fin n, algebraMap A ↥B₂_0 (s * d_i i - h₀ * e_w i) * b i = 0 := by
      have h1 : algebraMap A ↥B₂_0 s * (∑ i : Fin n, algebraMap A ↥B₂_0 (d_i i) * b i) =
          ∑ i : Fin n, algebraMap A ↥B₂_0 (s * d_i i) * b i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [← mul_assoc, ← map_mul]
      have h2 : algebraMap A ↥B₂_0 s * (algebraMap A ↥B₂_0 h₀ * w) =
          ∑ i : Fin n, algebraMap A ↥B₂_0 (h₀ * e_w i) * b i := by
        calc algebraMap A ↥B₂_0 s * (algebraMap A ↥B₂_0 h₀ * w)
            = algebraMap A ↥B₂_0 h₀ * (algebraMap A ↥B₂_0 s * w) := by ring
          _ = algebraMap A ↥B₂_0 h₀ * (∑ i : Fin n, algebraMap A ↥B₂_0 (e_w i) * b i) := by
              rw [he_w]
          _ = ∑ i : Fin n, algebraMap A ↥B₂_0 (h₀ * e_w i) * b i := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [← mul_assoc, ← map_mul]
      have heq_B : ∑ i : Fin n, algebraMap A ↥B₂_0 (s * d_i i) * b i =
          ∑ i : Fin n, algebraMap A ↥B₂_0 (h₀ * e_w i) * b i := by
        rw [← h1, hw, h2]
      calc ∑ i : Fin n, algebraMap A ↥B₂_0 (s * d_i i - h₀ * e_w i) * b i
          = (∑ i : Fin n, algebraMap A ↥B₂_0 (s * d_i i) * b i) -
            (∑ i : Fin n, algebraMap A ↥B₂_0 (h₀ * e_w i) * b i) := by
              rw [← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [map_sub, sub_mul]
        _ = 0 := sub_eq_zero.mpr heq_B
    have hrel_L₂ : ∑ i : Fin n, (algebraMap A K₂ (s * d_i i - h₀ * e_w i)) • (b i : L₂) = 0 := by
      have hval := congrArg Subtype.val hrel_B
      change (↑(∑ i : Fin n, algebraMap A ↥B₂_0 (s * d_i i - h₀ * e_w i) * b i) : L₂) = 0 at hval
      rw [AddSubmonoidClass.coe_finsetSum] at hval
      convert hval using 1
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def, ← hAlgAL₂_eq]
      rfl
    have hcoeff_zero : algebraMap A K₂ (s * d_i i₀ - h₀ * e_w i₀) = 0 :=
      Fintype.linearIndependent_iff.mp hb_indep _ hrel_L₂ i₀
    have hA_eq : s * d_i i₀ = h₀ * e_w i₀ :=
      sub_eq_zero.mp ((map_eq_zero_iff (algebraMap A K₂) (IsFractionRing.injective A K₂)).mp hcoeff_zero)
    have hθ_prod : θ_0 s * θ_0 (d_i i₀) = 0 := by
      rw [← map_mul, hA_eq, map_mul, hθ_h₀, zero_mul]
    have hθd_zero : θ_0 (d_i i₀) = 0 := (mul_eq_zero.mp hθ_prod).resolve_left hθs_ne
    rw [hθd_eq i₀] at hθd_zero
    exact (mul_eq_zero.mp hθd_zero).resolve_left hθC_ne

  let V : Submodule (RatFunc k) L_Sigma := Submodule.span (RatFunc k) (Set.range b_bar)
  letI : FiniteDimensional (RatFunc k) ↥V :=
    FiniteDimensional.span_of_finite (RatFunc k) (Set.finite_range b_bar)
  have hRange_sub_V : ∀ u : ↥B₂_0 ⧸ I_h₀, ι_0 u ∈ V := by
    intro u
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective u
    obtain ⟨a_y, ha_y⟩ := hb_span y
    have h_eq : (θ_0 s) • ι_0 (Ideal.Quotient.mk I_h₀ y) =
        ∑ i : Fin n, (θ_0 (a_y i)) • b_bar i := by
      rw [Algebra.smul_def, ← hAlign0 s, ← map_mul, ← map_mul, ha_y,
        map_sum, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_mul, hAlign0 (a_y i), Algebra.smul_def]
    have hsum_mem : (∑ i : Fin n, (θ_0 (a_y i)) • b_bar i) ∈ V :=
      Submodule.sum_mem V (fun i _ => Submodule.smul_mem V _ (Submodule.subset_span ⟨i, rfl⟩))
    have hinv_mem : (θ_0 s)⁻¹ • ((θ_0 s) • ι_0 (Ideal.Quotient.mk I_h₀ y)) ∈ V := by
      rw [h_eq]
      exact Submodule.smul_mem V _ hsum_mem
    rwa [smul_smul, inv_mul_cancel₀ hθs_ne, one_smul] at hinv_mem

  have hSpan_top : ⊤ ≤ V := by
    intro z _
    have hz_surj : ∃ (x w : ↥B₂_0 ⧸ I_h₀), w ≠ 0 ∧ z * ι_0 w = ι_0 x := by
      letI : Algebra (↥B₂_0 ⧸ I_h₀) L_Sigma := ι_0.toAlgebra
      obtain ⟨⟨x, w⟩, hzw⟩ :=
        @IsLocalization.surj (↥B₂_0 ⧸ I_h₀) _ (nonZeroDivisors (↥B₂_0 ⧸ I_h₀))
          L_Sigma _ ι_0.toAlgebra hFrac0 z
      exact ⟨x, w.1, mem_nonZeroDivisors_iff_ne_zero.mp w.2, hzw⟩
    obtain ⟨x, w, hw_ne, hzw⟩ := hz_surj
    have hιw_ne : ι_0 w ≠ 0 := (map_ne_zero_iff ι_0 hι0_inj).mpr hw_ne
    let T_w : L_Sigma →ₗ[RatFunc k] L_Sigma :=
      { toFun := fun v => ι_0 w * v
        map_add' := fun v₁ v₂ => mul_add (ι_0 w) v₁ v₂
        map_smul' := fun r v => by
          simp only [Algebra.smul_def, RingHom.id_apply]
          ring }
    have hMaps_V : ∀ v ∈ V, T_w v ∈ V := by
      have hle : V ≤ Submodule.comap T_w V := by
        rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        change ι_0 w * ι_0 (Ideal.Quotient.mk I_h₀ (b i)) ∈ V
        rw [← map_mul]
        exact hRange_sub_V _
      exact fun v hv => hle hv
    let T_V : ↥V →ₗ[RatFunc k] ↥V :=
      { toFun := fun v => ⟨T_w v.1, hMaps_V v.1 v.2⟩
        map_add' := fun v₁ v₂ => Subtype.ext (T_w.map_add v₁.1 v₂.1)
        map_smul' := fun r v => Subtype.ext (T_w.map_smul r v.1) }
    have hTV_inj : Function.Injective T_V := by
      intro v₁ v₂ heq
      apply Subtype.ext
      exact mul_left_cancel₀ hιw_ne (congrArg Subtype.val heq)
    have hTV_surj : Function.Surjective T_V :=
      LinearMap.injective_iff_surjective.mp hTV_inj
    obtain ⟨⟨v, hv_mem⟩, hv_eq⟩ := hTV_surj ⟨ι_0 x, hRange_sub_V x⟩
    have hv_val : ι_0 w * v = ι_0 x := congrArg Subtype.val hv_eq
    have hz_eq_v : z = v := by
      apply mul_left_cancel₀ hιw_ne
      rw [hv_val, ← hzw, mul_comm]
    rwa [hz_eq_v]

  let B_bas : Module.Basis (Fin n) (RatFunc k) L_Sigma :=
    Module.Basis.mk hb_bar_indep hSpan_top
  letI : FiniteDimensional (RatFunc k) L_Sigma := Module.Finite.of_basis B_bas
  have hFinrank : Module.finrank (RatFunc k) L_Sigma = n := by
    rw [Module.finrank_eq_card_basis B_bas, Fintype.card_fin]

  
  let σ_B₂ : (L₂ ≃ₐ[K₂] L₂) → ↥B₂_0 →+* ↥B₂_0 := fun σ =>
    { toFun := fun y => ⟨σ y.1, IsIntegral.map σ y.2⟩
      map_one' := Subtype.ext (map_one σ)
      map_mul' := fun y₁ y₂ => Subtype.ext (map_mul σ y₁.1 y₂.1)
      map_zero' := Subtype.ext (map_zero σ)
      map_add' := fun y₁ y₂ => Subtype.ext (map_add σ y₁.1 y₂.1) }
  have hσ_B₂_fixA : ∀ (σ : L₂ ≃ₐ[K₂] L₂) (a : A),
      σ_B₂ σ (algebraMap A ↥B₂_0 a) = algebraMap A ↥B₂_0 a := by
    intro σ a
    apply Subtype.ext
    change σ (algebraMap A L₂ a) = algebraMap A L₂ a
    rw [hAlgAL₂_eq a]
    exact σ.commutes (algebraMap A K₂ a)
  let σ_Q₀ : (L₂ ≃ₐ[K₂] L₂) → (↥B₂_0 ⧸ I_h₀) →+* (↥B₂_0 ⧸ I_h₀) := fun σ =>
    Ideal.Quotient.lift I_h₀ ((Ideal.Quotient.mk I_h₀).comp (σ_B₂ σ)) (by
      intro y hy
      change Ideal.Quotient.mk I_h₀ (σ_B₂ σ y) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      rcases Ideal.mem_span_singleton.mp hy with ⟨z, rfl⟩
      rw [map_mul, hσ_B₂_fixA σ h₀]
      exact Ideal.mem_span_singleton.mpr ⟨σ_B₂ σ z, rfl⟩)
  have hσ_Q₀_mk : ∀ (σ : L₂ ≃ₐ[K₂] L₂) (y : ↥B₂_0),
      σ_Q₀ σ (Ideal.Quotient.mk I_h₀ y) = Ideal.Quotient.mk I_h₀ (σ_B₂ σ y) :=
    fun _ _ => rfl
  have hσ_Q₀_one : ∀ u : ↥B₂_0 ⧸ I_h₀, σ_Q₀ 1 u = u := by
    intro u
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective u
    rfl
  have hσ_Q₀_mul : ∀ (σ₁ σ₂ : L₂ ≃ₐ[K₂] L₂) (u : ↥B₂_0 ⧸ I_h₀),
      σ_Q₀ (σ₁ * σ₂) u = σ_Q₀ σ₁ (σ_Q₀ σ₂ u) := by
    intro σ₁ σ₂ u
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective u
    rfl
  have hσ_Q₀_inj : ∀ σ : L₂ ≃ₐ[K₂] L₂, Function.Injective (σ_Q₀ σ) := by
    intro σ u₁ u₂ heq
    have h1 := congrArg (σ_Q₀ σ⁻¹) heq
    rw [← hσ_Q₀_mul σ⁻¹ σ u₁, ← hσ_Q₀_mul σ⁻¹ σ u₂, inv_mul_cancel,
      hσ_Q₀_one, hσ_Q₀_one] at h1
    exact h1

  have hLift_ext : ∀ {F₁ F₂ : L_Sigma →+* L_Sigma},
      (∀ u : ↥B₂_0 ⧸ I_h₀, F₁ (ι_0 u) = F₂ (ι_0 u)) → F₁ = F₂ := by
    intro F₁ F₂ hF
    letI : Algebra (↥B₂_0 ⧸ I_h₀) L_Sigma := ι_0.toAlgebra
    letI : IsFractionRing (↥B₂_0 ⧸ I_h₀) L_Sigma := hFrac0
    exact @IsLocalization.ringHom_ext (↥B₂_0 ⧸ I_h₀) _ (nonZeroDivisors (↥B₂_0 ⧸ I_h₀))
      L_Sigma _ ι_0.toAlgebra hFrac0 L_Sigma _ F₁ F₂ (RingHom.ext hF)

  have hLift_exists : ∀ σ : L₂ ≃ₐ[K₂] L₂,
      ∃ F_σ : L_Sigma →+* L_Sigma, ∀ u : ↥B₂_0 ⧸ I_h₀, F_σ (ι_0 u) = ι_0 (σ_Q₀ σ u) := by
    intro σ
    letI : Algebra (↥B₂_0 ⧸ I_h₀) L_Sigma := ι_0.toAlgebra
    letI : IsFractionRing (↥B₂_0 ⧸ I_h₀) L_Sigma := hFrac0
    let g_σ : (↥B₂_0 ⧸ I_h₀) →+* L_Sigma := ι_0.comp (σ_Q₀ σ)
    have hg_σ : ∀ w : nonZeroDivisors (↥B₂_0 ⧸ I_h₀), IsUnit (g_σ w.1) := by
      intro w
      have hw_ne : w.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp w.2
      have hgw_ne : g_σ w.1 ≠ 0 :=
        (map_ne_zero_iff g_σ (hι0_inj.comp (hσ_Q₀_inj σ))).mpr hw_ne
      exact IsUnit.mk0 (g_σ w.1) hgw_ne
    refine ⟨@IsLocalization.lift (↥B₂_0 ⧸ I_h₀) _ (nonZeroDivisors (↥B₂_0 ⧸ I_h₀))
      L_Sigma _ ι_0.toAlgebra L_Sigma _ hFrac0 g_σ hg_σ, fun u => ?_⟩
    exact @IsLocalization.lift_eq (↥B₂_0 ⧸ I_h₀) _ (nonZeroDivisors (↥B₂_0 ⧸ I_h₀))
      L_Sigma _ ι_0.toAlgebra L_Sigma _ hFrac0 g_σ hg_σ u

  let F_aut : (L₂ ≃ₐ[K₂] L₂) → (L_Sigma →+* L_Sigma) := fun σ => Classical.choose (hLift_exists σ)
  have hF_aut_spec : ∀ (σ : L₂ ≃ₐ[K₂] L₂) (u : ↥B₂_0 ⧸ I_h₀),
      F_aut σ (ι_0 u) = ι_0 (σ_Q₀ σ u) :=
    fun σ => Classical.choose_spec (hLift_exists σ)
  have hF_aut_one : F_aut 1 = RingHom.id L_Sigma := by
    apply hLift_ext
    intro u
    rw [hF_aut_spec 1 u, hσ_Q₀_one u, RingHom.id_apply]
  have hF_aut_mul : ∀ σ₁ σ₂ : L₂ ≃ₐ[K₂] L₂, F_aut (σ₁ * σ₂) = (F_aut σ₁).comp (F_aut σ₂) := by
    intro σ₁ σ₂
    apply hLift_ext
    intro u
    rw [hF_aut_spec (σ₁ * σ₂) u, hσ_Q₀_mul σ₁ σ₂ u, RingHom.comp_apply,
      hF_aut_spec σ₂ u, hF_aut_spec σ₁]
  have hF_aut_commutes : ∀ (σ : L₂ ≃ₐ[K₂] L₂) (f : RatFunc k),
      F_aut σ (algebraMap (RatFunc k) L_Sigma f) = algebraMap (RatFunc k) L_Sigma f := by
    intro σ f
    have hθ_fix : ∀ g : A,
        F_aut σ (algebraMap (RatFunc k) L_Sigma (θ_0 g)) =
          algebraMap (RatFunc k) L_Sigma (θ_0 g) := by
      intro g
      rw [← hAlign0 g, hF_aut_spec, hσ_Q₀_mk, hσ_B₂_fixA]
    obtain ⟨a, c, hc_ne, hfc⟩ := hθ_frac f
    have hθc_L_ne : algebraMap (RatFunc k) L_Sigma (θ_0 c) ≠ 0 :=
      (map_ne_zero_iff (algebraMap (RatFunc k) L_Sigma)
        (algebraMap (RatFunc k) L_Sigma).injective).mpr hc_ne
    apply mul_right_cancel₀ hθc_L_ne
    calc F_aut σ (algebraMap (RatFunc k) L_Sigma f) * algebraMap (RatFunc k) L_Sigma (θ_0 c)
        = F_aut σ (algebraMap (RatFunc k) L_Sigma f) *
            F_aut σ (algebraMap (RatFunc k) L_Sigma (θ_0 c)) := by rw [hθ_fix c]
      _ = F_aut σ (algebraMap (RatFunc k) L_Sigma (f * θ_0 c)) := by
            rw [← map_mul, ← map_mul]
      _ = algebraMap (RatFunc k) L_Sigma (θ_0 a) := by rw [hfc, hθ_fix a]
      _ = algebraMap (RatFunc k) L_Sigma f * algebraMap (RatFunc k) L_Sigma (θ_0 c) := by
            rw [← hfc, map_mul]

  let Ψ_fun : (L₂ ≃ₐ[K₂] L₂) → (L_Sigma ≃ₐ[RatFunc k] L_Sigma) := fun σ =>
    { toFun := F_aut σ
      invFun := F_aut σ⁻¹
      left_inv := fun z => by
        have hcomp := congrArg (fun φ : L_Sigma →+* L_Sigma => φ z) (hF_aut_mul σ⁻¹ σ)
        rw [inv_mul_cancel, hF_aut_one] at hcomp
        exact hcomp.symm
      right_inv := fun z => by
        have hcomp := congrArg (fun φ : L_Sigma →+* L_Sigma => φ z) (hF_aut_mul σ σ⁻¹)
        rw [mul_inv_cancel, hF_aut_one] at hcomp
        exact hcomp.symm
      map_mul' := (F_aut σ).map_mul
      map_add' := (F_aut σ).map_add
      commutes' := hF_aut_commutes σ }
  let Ψ : (L₂ ≃ₐ[K₂] L₂) →* (L_Sigma ≃ₐ[RatFunc k] L_Sigma) :=
    { toFun := Ψ_fun
      map_one' := by
        ext z
        change F_aut 1 z = z
        rw [hF_aut_one, RingHom.id_apply]
      map_mul' := fun σ₁ σ₂ => by
        ext z
        change F_aut (σ₁ * σ₂) z = F_aut σ₁ (F_aut σ₂ z)
        rw [hF_aut_mul σ₁ σ₂, RingHom.comp_apply] }
  have hΨ_compat : ∀ (σ : L₂ ≃ₐ[K₂] L₂) (y y' : ↥B₂_0),
      (y' : L₂) = σ (y : L₂) →
      (Ψ σ) (ι_0 (Ideal.Quotient.mk I_h₀ y)) = ι_0 (Ideal.Quotient.mk I_h₀ y') := by
    intro σ y y' hy'
    have hy_eq : y' = σ_B₂ σ y := Subtype.ext hy'
    change F_aut σ (ι_0 (Ideal.Quotient.mk I_h₀ y)) = ι_0 (Ideal.Quotient.mk I_h₀ y')
    rw [hF_aut_spec, hσ_Q₀_mk, hy_eq]

  
  
  
  have h_not_dvd : ¬ (h₀ ∣ f₀) := by
    rintro ⟨q, hfq⟩
    have hp0 : MvPolynomial.eval p_inf (MvPolynomial.pderiv 0 f₀) =
        MvPolynomial.eval p_inf (MvPolynomial.pderiv 0 h₀) * MvPolynomial.eval p_inf q := by
      rw [hfq, MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hPt_inf.2, zero_mul, add_zero]
    have hp1 : MvPolynomial.eval p_inf (MvPolynomial.pderiv 1 f₀) =
        MvPolynomial.eval p_inf (MvPolynomial.pderiv 1 h₀) * MvPolynomial.eval p_inf q := by
      rw [hfq, MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hPt_inf.2, zero_mul, add_zero]
    apply hTransv_0 p_inf hPt_inf.2 hPt_inf.1
    change MvPolynomial.eval p_inf (MvPolynomial.pderiv 0 f₀) *
        MvPolynomial.eval p_inf (MvPolynomial.pderiv 1 h₀) -
      MvPolynomial.eval p_inf (MvPolynomial.pderiv 1 f₀) *
        MvPolynomial.eval p_inf (MvPolynomial.pderiv 0 h₀) = 0
    rw [hp0, hp1]
    ring

  have hh₀_deg_pos : 1 ≤ h₀.totalDegree := by
    by_contra hdeg_lt
    have hdeg0 : h₀.totalDegree = 0 := by omega
    have hC_eq : h₀ = MvPolynomial.C (h₀.coeff 0) :=
      MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hdeg0
    by_cases hc0 : h₀.coeff 0 = 0
    · rw [hc0, map_zero] at hC_eq
      exact hh₀_ne hC_eq
    · have hunit : IsUnit h₀ := by
        rw [hC_eq]
        exact IsUnit.map MvPolynomial.C (IsUnit.mk0 (h₀.coeff 0) hc0)
      exact hIrr_H0.not_isUnit hunit

  have hh₀_pow_deg : ∀ M : ℕ, (h₀ ^ M).totalDegree = M * h₀.totalDegree := by
    intro M
    induction M with
    | zero => simp
    | succ m ih =>
      rw [pow_succ, MvPolynomial.totalDegree_mul_of_isDomain (pow_ne_zero m hh₀_ne) hh₀_ne,
        ih, Nat.succ_mul]

  have hh₀_pow_zero : ∀ c : A, (∀ M : ℕ, h₀ ^ M ∣ c) → c = 0 := by
    intro c hc
    by_contra hc_ne
    obtain ⟨q, hq⟩ := hc (c.totalDegree + 1)
    have hq_ne : q ≠ 0 := by
      intro hq0
      rw [hq0, mul_zero] at hq
      exact hc_ne hq
    have hdeg_eq : c.totalDegree =
        (c.totalDegree + 1) * h₀.totalDegree + q.totalDegree := by
      conv_lhs => rw [hq]
      rw [MvPolynomial.totalDegree_mul_of_isDomain
        (pow_ne_zero (c.totalDegree + 1) hh₀_ne) hq_ne, hh₀_pow_deg]
    have hle : c.totalDegree + 1 ≤ (c.totalDegree + 1) * h₀.totalDegree := by
      calc c.totalDegree + 1 = (c.totalDegree + 1) * 1 := (Nat.mul_one _).symm
        _ ≤ (c.totalDegree + 1) * h₀.totalDegree := Nat.mul_le_mul_left _ hh₀_deg_pos
    omega

  have hΨ_ker_triv : ∀ σ : L₂ ≃ₐ[K₂] L₂, Ψ σ = 1 → σ = 1 := by
    intro σ hΨσ
    let τ : ↥B₂_0 →+* ↥B₂_0 := σ_B₂ σ
    have hτ_mod : ∀ y : ↥B₂_0, τ y - y ∈ I_h₀ := by
      intro y
      apply Ideal.Quotient.eq.mp
      apply hι0_inj
      have hcompat := hΨ_compat σ y (τ y) rfl
      rw [hΨσ, AlgEquiv.one_apply] at hcompat
      exact hcompat.symm
    let h_B₂ : ↥B₂_0 := algebraMap A ↥B₂_0 h₀
    let f_B₂ : ↥B₂_0 := algebraMap A ↥B₂_0 f₀
    letI : CommRing (Localization.Away f₀) := inferInstance
    letI : CommRing (Localization.Away f_B₂) := inferInstance
    let φ_away : Localization.Away f₀ →+* Localization.Away f_B₂ :=
      Localization.awayMap (algebraMap A ↥B₂_0) f₀
    have hEt0 : @RingHom.Etale (Localization.Away f₀) (Localization.Away f_B₂)
        inferInstance inferInstance φ_away := hEtale_3charts 0
    letI : Algebra (Localization.Away f₀) (Localization.Away f_B₂) := φ_away.toAlgebra
    have hEtAlg : Algebra.Etale (Localization.Away f₀) (Localization.Away f_B₂) :=
      RingHom.etale_algebraMap.mp hEt0
    letI : Algebra.Etale (Localization.Away f₀) (Localization.Away f_B₂) := hEtAlg
    have hτ_f : τ f_B₂ = f_B₂ := hσ_B₂_fixA σ f₀
    let g_τ : ↥B₂_0 →+* Localization.Away f_B₂ :=
      (algebraMap ↥B₂_0 (Localization.Away f_B₂)).comp τ
    have hg_τ_unit : IsUnit (g_τ f_B₂) := by
      change IsUnit (algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ f_B₂))
      rw [hτ_f]
      exact IsLocalization.Away.algebraMap_isUnit f_B₂
    let σ_f_ring : Localization.Away f_B₂ →+* Localization.Away f_B₂ :=
      IsLocalization.Away.lift f_B₂ hg_τ_unit
    have hσ_f_eq : ∀ y : ↥B₂_0,
        σ_f_ring (algebraMap ↥B₂_0 (Localization.Away f_B₂) y) =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ y) :=
      fun y => IsLocalization.Away.lift_eq f_B₂ hg_τ_unit y
    have hφ_away_eq : ∀ a : A,
        φ_away (algebraMap A (Localization.Away f₀) a) =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) (algebraMap A ↥B₂_0 a) := by
      intro a
      exact IsLocalization.map_eq _ a
    have hσ_f_commutes : ∀ r : Localization.Away f₀, σ_f_ring (φ_away r) = φ_away r := by
      have hext : σ_f_ring.comp φ_away = φ_away := by
        apply IsLocalization.ringHom_ext (Submonoid.powers f₀)
        apply RingHom.ext
        intro a
        change σ_f_ring (φ_away (algebraMap A (Localization.Away f₀) a)) =
          φ_away (algebraMap A (Localization.Away f₀) a)
        rw [hφ_away_eq a, hσ_f_eq, hσ_B₂_fixA σ a]
      exact fun r => congrArg (fun ψ : Localization.Away f₀ →+* Localization.Away f_B₂ => ψ r) hext
    let σ_f : Localization.Away f_B₂ →ₐ[Localization.Away f₀] Localization.Away f_B₂ :=
      { σ_f_ring with commutes' := hσ_f_commutes }
    let J : Ideal (Localization.Away f_B₂) :=
      Ideal.span {algebraMap ↥B₂_0 (Localization.Away f_B₂) h_B₂}
    have hσ_f_mod_J : ∀ x : Localization.Away f_B₂, σ_f x - x ∈ J := by
      intro x
      obtain ⟨⟨y, u⟩, hxu⟩ := IsLocalization.surj (Submonoid.powers f_B₂) x
      dsimp only at hxu
      rcases u.2 with ⟨k_pow, hk_pow⟩
      dsimp only at hk_pow
      have hτ_u : τ u.1 = u.1 := by
        rw [← hk_pow, map_pow, hτ_f]
      have hσ_u : σ_f (algebraMap ↥B₂_0 (Localization.Away f_B₂) u.1) =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) u.1 := by
        change σ_f_ring (algebraMap ↥B₂_0 (Localization.Away f_B₂) u.1) =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) u.1
        rw [hσ_f_eq, hτ_u]
      let U_unit : (Localization.Away f_B₂)ˣ :=
        (IsLocalization.map_units (Localization.Away f_B₂) u).unit
      have hU_val : (U_unit : Localization.Away f_B₂) =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) u.1 := rfl
      have hdiff_mul : (σ_f x - x) * (U_unit : Localization.Away f_B₂) =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ y - y) := by
        have hx_app : σ_f x * algebraMap ↥B₂_0 (Localization.Away f_B₂) u.1 =
            algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ y) := by
          have h1 := congrArg σ_f hxu
          rw [map_mul, hσ_u] at h1
          exact h1.trans (hσ_f_eq y)
        rw [sub_mul, hU_val, hx_app, hxu, ← map_sub]
      rcases Ideal.mem_span_singleton.mp (hτ_mod y) with ⟨z, hz⟩
      have hval : σ_f x - x =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) h_B₂ *
            (algebraMap ↥B₂_0 (Localization.Away f_B₂) z * ↑U_unit⁻¹) := by
        calc σ_f x - x
            = ((σ_f x - x) * (U_unit : Localization.Away f_B₂)) * ↑U_unit⁻¹ := by simp
          _ = algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ y - y) * ↑U_unit⁻¹ := by
              rw [hdiff_mul]
          _ = algebraMap ↥B₂_0 (Localization.Away f_B₂) h_B₂ *
                (algebraMap ↥B₂_0 (Localization.Away f_B₂) z * ↑U_unit⁻¹) := by
              rw [hz, map_mul, mul_assoc]
      exact Ideal.mem_span_singleton.mpr ⟨_, hval⟩

    have hMod_pow : ∀ (y : ↥B₂_0) (M : ℕ), 1 ≤ M →
        ∃ (R_exp : ℕ) (u_M : ↥B₂_0), f_B₂ ^ R_exp * (τ y - y) = h_B₂ ^ M * u_M := by
      intro y M _hM
      let JM : Ideal (Localization.Away f_B₂) := J ^ M
      letI : CommRing (Localization.Away f_B₂ ⧸ JM) := inferInstance
      let q_M : Localization.Away f_B₂ →ₐ[Localization.Away f₀]
          (Localization.Away f_B₂ ⧸ JM) := Ideal.Quotient.mkₐ (Localization.Away f₀) JM
      let I_M : Ideal (Localization.Away f_B₂ ⧸ JM) :=
        Ideal.map (Ideal.Quotient.mk JM) J
      have hNil : IsNilpotent I_M := by
        refine ⟨M, ?_⟩
        dsimp [I_M, JM]
        rw [← Ideal.map_pow, Ideal.map_quotient_self]
      let g₁ : Localization.Away f_B₂ →ₐ[Localization.Away f₀]
          (Localization.Away f_B₂ ⧸ JM) := q_M.comp σ_f
      let g₂ : Localization.Away f_B₂ →ₐ[Localization.Away f₀]
          (Localization.Away f_B₂ ⧸ JM) := q_M
      have hg_eq : g₁ = g₂ := by
        apply Algebra.FormallyUnramified.ext I_M hNil
        intro x
        apply Ideal.Quotient.eq.mpr
        change Ideal.Quotient.mk JM (σ_f x) - Ideal.Quotient.mk JM x ∈ I_M
        rw [← RingHom.map_sub (Ideal.Quotient.mk JM)]
        exact Ideal.mem_map_of_mem _ (hσ_f_mod_J x)
      have hy_eq : Ideal.Quotient.mk JM
          (algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ y)) =
          Ideal.Quotient.mk JM
          (algebraMap ↥B₂_0 (Localization.Away f_B₂) y) := by
        have h_at := congrArg (fun ψ : Localization.Away f_B₂ →ₐ[Localization.Away f₀]
          (Localization.Away f_B₂ ⧸ JM) =>
            ψ (algebraMap ↥B₂_0 (Localization.Away f_B₂) y)) hg_eq
        change Ideal.Quotient.mk JM
          (σ_f_ring (algebraMap ↥B₂_0 (Localization.Away f_B₂) y)) = _ at h_at
        rwa [hσ_f_eq] at h_at
      have hy_mem : algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ y - y) ∈ J ^ M := by
        rw [RingHom.map_sub]
        exact Ideal.Quotient.eq.mp hy_eq
      rw [Ideal.span_singleton_pow, ← RingHom.map_pow] at hy_mem
      rcases Ideal.mem_span_singleton.mp hy_mem with ⟨q_S, hq_S⟩
      obtain ⟨⟨u_0, v_pow⟩, hqu⟩ := IsLocalization.surj (Submonoid.powers f_B₂) q_S
      dsimp only at hqu
      rcases v_pow.2 with ⟨r₁, hr₁⟩
      dsimp only at hr₁
      have hS_eq : algebraMap ↥B₂_0 (Localization.Away f_B₂) (f_B₂ ^ r₁ * (τ y - y)) =
          algebraMap ↥B₂_0 (Localization.Away f_B₂) (h_B₂ ^ M * u_0) := by
        calc algebraMap ↥B₂_0 (Localization.Away f_B₂) (f_B₂ ^ r₁ * (τ y - y))
            = algebraMap ↥B₂_0 (Localization.Away f_B₂) (τ y - y) *
                algebraMap ↥B₂_0 (Localization.Away f_B₂) v_pow.1 := by
                  rw [map_mul, hr₁, mul_comm]
          _ = algebraMap ↥B₂_0 (Localization.Away f_B₂) (h_B₂ ^ M) *
                (q_S * algebraMap ↥B₂_0 (Localization.Away f_B₂) v_pow.1) := by
                  rw [hq_S, mul_assoc]
          _ = algebraMap ↥B₂_0 (Localization.Away f_B₂) (h_B₂ ^ M * u_0) := by
                  rw [hqu, ← map_mul]
      obtain ⟨c_pow, hc_eq⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers f_B₂) (Localization.Away f_B₂)).mp hS_eq
      rcases c_pow.2 with ⟨r₂, hr₂⟩
      dsimp only at hr₂
      rw [← hr₂] at hc_eq
      refine ⟨r₂ + r₁, f_B₂ ^ r₂ * u_0, ?_⟩
      calc f_B₂ ^ (r₂ + r₁) * (τ y - y)
          = f_B₂ ^ r₂ * (f_B₂ ^ r₁ * (τ y - y)) := by rw [pow_add, mul_assoc]
        _ = f_B₂ ^ r₂ * (h_B₂ ^ M * u_0) := hc_eq
        _ = h_B₂ ^ M * (f_B₂ ^ r₂ * u_0) := by ring

    have hCancel_pow : ∀ (R_exp m : ℕ) (x y_q : A),
        f₀ ^ R_exp * x = h₀ ^ m * y_q → h₀ ^ m ∣ x := by
      intro R_exp m
      induction m with
      | zero =>
        intro x _ _
        rw [pow_zero]
        exact one_dvd x
      | succ m ih =>
        intro x y_q heq
        have hdvd_prod : h₀ ∣ f₀ ^ R_exp * x :=
          ⟨h₀ ^ m * y_q, by rw [heq, pow_succ', mul_assoc]⟩
        have hdvd_x : h₀ ∣ x := by
          rcases hh₀_prime.dvd_or_dvd hdvd_prod with hf_dvd | hx_dvd
          · exfalso
            exact h_not_dvd (hh₀_prime.dvd_of_dvd_pow hf_dvd)
          · exact hx_dvd
        rcases hdvd_x with ⟨x', rfl⟩
        have heq' : f₀ ^ R_exp * x' = h₀ ^ m * y_q := by
          apply mul_left_cancel₀ hh₀_ne
          calc h₀ * (f₀ ^ R_exp * x')
              = f₀ ^ R_exp * (h₀ * x') := by ring
            _ = h₀ ^ (m + 1) * y_q := heq
            _ = h₀ * (h₀ ^ m * y_q) := by rw [pow_succ', mul_assoc]
        rcases ih x' y_q heq' with ⟨x'', rfl⟩
        exact ⟨x'', by rw [pow_succ', mul_assoc]⟩

    have hFix_B₂ : ∀ y : ↥B₂_0, σ (y : L₂) = (y : L₂) := by
      intro y
      let w : ↥B₂_0 := τ y - y
      obtain ⟨c_w, hc_w⟩ := hb_span w
      have hc_zero : ∀ i : Fin n, c_w i = 0 := by
        intro i
        apply hh₀_pow_zero (c_w i)
        intro M
        rcases Nat.eq_zero_or_pos M with rfl | hM_pos
        · rw [pow_zero]; exact one_dvd _
        · obtain ⟨R_exp, u_M, hu_M⟩ := hMod_pow y M hM_pos
          obtain ⟨a_M, ha_M⟩ := hb_span u_M
          have hrel_B : ∑ j : Fin n, algebraMap A ↥B₂_0 (f₀ ^ R_exp * c_w j - h₀ ^ M * a_M j) * b j = 0 := by
            have h1 : f_B₂ ^ R_exp * (algebraMap A ↥B₂_0 s * w) =
                ∑ j : Fin n, algebraMap A ↥B₂_0 (f₀ ^ R_exp * c_w j) * b j := by
              rw [hc_w, Finset.mul_sum]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              dsimp [f_B₂]
              rw [map_mul, map_pow, mul_assoc]
            have h2 : h_B₂ ^ M * (algebraMap A ↥B₂_0 s * u_M) =
                ∑ j : Fin n, algebraMap A ↥B₂_0 (h₀ ^ M * a_M j) * b j := by
              rw [ha_M, Finset.mul_sum]
              refine Finset.sum_congr rfl (fun j _ => ?_)
              dsimp [h_B₂]
              rw [map_mul, map_pow, mul_assoc]
            have heq_B : ∑ j : Fin n, algebraMap A ↥B₂_0 (f₀ ^ R_exp * c_w j) * b j =
                ∑ j : Fin n, algebraMap A ↥B₂_0 (h₀ ^ M * a_M j) * b j := by
              rw [← h1, ← h2]
              calc f_B₂ ^ R_exp * (algebraMap A ↥B₂_0 s * w)
                  = algebraMap A ↥B₂_0 s * (f_B₂ ^ R_exp * w) := by ring
                _ = algebraMap A ↥B₂_0 s * (h_B₂ ^ M * u_M) := by rw [hu_M]
                _ = h_B₂ ^ M * (algebraMap A ↥B₂_0 s * u_M) := by ring
            calc ∑ j : Fin n, algebraMap A ↥B₂_0 (f₀ ^ R_exp * c_w j - h₀ ^ M * a_M j) * b j
                = (∑ j : Fin n, algebraMap A ↥B₂_0 (f₀ ^ R_exp * c_w j) * b j) -
                  (∑ j : Fin n, algebraMap A ↥B₂_0 (h₀ ^ M * a_M j) * b j) := by
                    rw [← Finset.sum_sub_distrib]
                    refine Finset.sum_congr rfl (fun j _ => ?_)
                    rw [map_sub, sub_mul]
              _ = 0 := sub_eq_zero.mpr heq_B
          have hrel_L₂ : ∑ j : Fin n,
              (algebraMap A K₂ (f₀ ^ R_exp * c_w j - h₀ ^ M * a_M j)) • (b j : L₂) = 0 := by
            have hval := congrArg Subtype.val hrel_B
            change (↑(∑ j : Fin n,
              algebraMap A ↥B₂_0 (f₀ ^ R_exp * c_w j - h₀ ^ M * a_M j) * b j) : L₂) = 0 at hval
            rw [AddSubmonoidClass.coe_finsetSum] at hval
            convert hval using 1
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Algebra.smul_def, ← hAlgAL₂_eq]
            rfl
          have hcoeff0 := Fintype.linearIndependent_iff.mp hb_indep _ hrel_L₂ i
          have hA_eq : f₀ ^ R_exp * c_w i = h₀ ^ M * a_M i :=
            sub_eq_zero.mp ((map_eq_zero_iff (algebraMap A K₂)
              (IsFractionRing.injective A K₂)).mp hcoeff0)
          exact hCancel_pow R_exp M (c_w i) (a_M i) hA_eq
      have hsw_zero : algebraMap A ↥B₂_0 s * w = 0 := by
        rw [hc_w]
        refine Finset.sum_eq_zero (fun i _ => ?_)
        rw [hc_zero i, map_zero, zero_mul]
      have hsw_L₂ : algebraMap A L₂ s * (w : L₂) = 0 :=
        congrArg Subtype.val hsw_zero
      have hs_K₂_ne : algebraMap A K₂ s ≠ 0 :=
        (map_ne_zero_iff (algebraMap A K₂) (IsFractionRing.injective A K₂)).mpr hs_ne
      have hs_L₂_ne : algebraMap A L₂ s ≠ 0 := by
        rw [hAlgAL₂_eq s]
        exact (map_ne_zero_iff (algebraMap K₂ L₂) (algebraMap K₂ L₂).injective).mpr hs_K₂_ne
      have hw_zero : (w : L₂) = 0 := (mul_eq_zero.mp hsw_L₂).resolve_left hs_L₂_ne
      exact sub_eq_zero.mp hw_zero

    letI : IsFractionRing ↥B₂_0 L₂ :=
      integralClosure.isFractionRing_of_finite_extension K₂ L₂
    ext x
    obtain ⟨⟨y, d⟩, hxd⟩ := IsLocalization.surj (nonZeroDivisors ↥B₂_0) x
    have hd_ne : d.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
    have hd_L₂_ne : (d.1 : L₂) ≠ 0 := fun h => hd_ne (Subtype.ext h)
    apply mul_right_cancel₀ hd_L₂_ne
    have hxd' : x * (d.1 : L₂) = (y : L₂) := hxd
    calc σ x * (d.1 : L₂)
        = σ x * σ (d.1 : L₂) := by rw [hFix_B₂ d.1]
      _ = σ (x * (d.1 : L₂)) := (map_mul σ _ _).symm
      _ = σ (y : L₂) := by rw [hxd']
      _ = (y : L₂) := hFix_B₂ y
      _ = x * (d.1 : L₂) := hxd'.symm

  have hΨ_inj : Function.Injective Ψ := by
    intro σ₁ σ₂ heq
    have h1 : Ψ (σ₁⁻¹ * σ₂) = 1 := by
      rw [map_mul, map_inv, heq, inv_mul_cancel]
    exact inv_mul_eq_one.mp (hΨ_ker_triv (σ₁⁻¹ * σ₂) h1)

  
  
  
  letI : Fintype (L₂ ≃ₐ[K₂] L₂) := AlgEquiv.fintype K₂ L₂
  letI : Fintype (L_Sigma ≃ₐ[RatFunc k] L_Sigma) := AlgEquiv.fintype (RatFunc k) L_Sigma
  have hCard_L₂ : Fintype.card (L₂ ≃ₐ[K₂] L₂) = n := by
    rw [← Nat.card_eq_fintype_card]
    exact IsGalois.card_aut_eq_finrank K₂ L₂
  have hLe₁ : Fintype.card (L₂ ≃ₐ[K₂] L₂) ≤ Fintype.card (L_Sigma ≃ₐ[RatFunc k] L_Sigma) :=
    Fintype.card_le_of_injective Ψ hΨ_inj
  have hLe₂ : Fintype.card (L_Sigma ≃ₐ[RatFunc k] L_Sigma) ≤ Module.finrank (RatFunc k) L_Sigma :=
    AlgEquiv.card_le
  have hCard_LSigma : Fintype.card (L_Sigma ≃ₐ[RatFunc k] L_Sigma) =
      Module.finrank (RatFunc k) L_Sigma := by
    omega
  have hGal_LSigma : IsGalois (RatFunc k) L_Sigma := by
    apply IsGalois.of_card_aut_eq_finrank
    rw [Nat.card_eq_fintype_card]
    exact hCard_LSigma
  have hΨ_bij : Function.Bijective Ψ := by
    rw [Fintype.bijective_iff_injective_and_card]
    exact ⟨hΨ_inj, by omega⟩

  exact ⟨L_Sigma, instFld, instAlg_k, instAlg_P, instAlg_RF,
    hST_kP, hST_kRF, hST_PRF, inferInstance, hGal_LSigma,
    ι_0, Ψ, hι0_inj, hFrac0, hAlign0, hIntCl0, hΨ_bij, hΨ_compat⟩

