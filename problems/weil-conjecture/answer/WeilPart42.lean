                hτ_UY_inv_fac, Category.assoc, τ_Y.inv_hom_id, Category.comp_id, Category.id_comp] }

        have hτW_qW : τ_W.hom ≫ q_W = q_W ≫ τ_Q.hom := by
          dsimp only [q_W]
