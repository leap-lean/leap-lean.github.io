      weilEtaleConstPullbackHom g hT_X hT_X AM
    let ψ₀_tilde :=
      (adj_g.homEquiv (pf_u.obj (weilEtaleTorsionSheaf U m₀))
        (pf_u.obj (weilEtaleTorsionSheaf U m₀))).symm
        (CategoryTheory.CategoryStruct.comp
          (pf_u.map
            ((adj_g'.homEquiv (weilEtaleTorsionSheaf U m₀) (weilEtaleTorsionSheaf U m₀))
              (weilEtaleConstPullbackHom g' hT_U hT_U AM)))
          (CategoryTheory.ObjectProperty.homMk
            (CategoryTheory.Functor.whiskerRight
              (CategoryTheory.NatTrans.op (weilOuterBCFunIso u g u g' h_sq).inv)
              (weilEtaleTorsionSheaf U m₀).obj)))
    have hη_inv_comm : CategoryTheory.CategoryStruct.comp (pb_g.map iso_η.symm.hom) πM_g =
        CategoryTheory.CategoryStruct.comp ψ₀_tilde iso_η.symm.hom := by
      have h1 : CategoryTheory.CategoryStruct.comp (pb_g.map iso_η.hom) ψ₀_tilde =
          CategoryTheory.CategoryStruct.comp πM_g iso_η.hom := hη_comm
      calc CategoryTheory.CategoryStruct.comp (pb_g.map iso_η.symm.hom) πM_g
          = CategoryTheory.CategoryStruct.comp (pb_g.map iso_η.inv)
              (CategoryTheory.CategoryStruct.comp πM_g
                (CategoryTheory.CategoryStruct.comp iso_η.hom iso_η.inv)) := by
            rw [iso_η.hom_inv_id, CategoryTheory.Category.comp_id]
            rfl
        _ = CategoryTheory.CategoryStruct.comp
              (CategoryTheory.CategoryStruct.comp (pb_g.map iso_η.inv) (pb_g.map iso_η.hom))
              (CategoryTheory.CategoryStruct.comp ψ₀_tilde iso_η.inv) := by
            rw [← CategoryTheory.Category.assoc πM_g, ← h1]
            simp only [CategoryTheory.Category.assoc]
        _ = CategoryTheory.CategoryStruct.comp ψ₀_tilde iso_η.symm.hom := by
            rw [← pb_g.map_comp, iso_η.inv_hom_id, pb_g.map_id,
              CategoryTheory.Category.id_comp]
            rfl
    change e_η_inv (EX₂ (β_n (θ_n_inv
        (ev_ℛ.symm ((ℛ.obj.map (Opposite.op σ_g)).hom ((γ.hom.app (Opposite.op T_X)).hom s)))))) =
      p_g (e_η_inv (EX₂ (β_n (θ_n_inv (ev_ℛ.symm s)))))
    refine (congrArg (fun x => e_η_inv (EX₂ (β_n (θ_n_inv x)))) hsec_eq).trans ?_
    refine Eq.trans ?_
      (congrArg (fun x => p_g (e_η_inv (EX₂ (β_n (θ_n_inv x))))) hz₀).symm
    clear σ_g s hz₀ hsec_eq hev_ℛ ev_ℛ ι_trans T_X
    let w₁ : ℛ.H 0 :=
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g z₀) (Nat.zero_add 0)).comp
        (CategoryTheory.Abelian.Ext.mk₀ ((adj_g.homEquiv ℛ ℛ).symm γ)) (Nat.add_zero 0)
    have step1 : θ_n_inv w₁ =
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_g).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor pb_g (θ_n_inv z₀)) (Nat.zero_add 0)).comp
          (CategoryTheory.Abelian.Ext.mk₀ γ₁_tilde) (Nat.add_zero 0) :=
      (hθ_n_inv w₁).trans
        ((hPullH_mor ((adj_g.homEquiv ℛ ℛ).symm γ) γ₁_tilde Θ_n.symm.hom 0 hΘ_comm z₀).trans
