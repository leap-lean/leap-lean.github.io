  have hSurj_Q_mid : ∃ p_mid : weilEtaleTorsionH Q_R m₀ (n + 1) →+
      weilEtaleTorsionH U_Q.toScheme m₀ (n + 1),
      WeilIsTorsionEtalePullback U_Q.ι m₀ (n + 1) p_mid ∧ Function.Surjective p_mid :=
    ⟨p_Q_mid, hp_Q_mid, (hBij_low (n + 1) (le_refl (n + 1)) p_Q_mid hp_Q_mid).2⟩
  have hSkyZero_Q : ∀ 𝒢 : CategoryTheory.Sheaf Q_R.smallEtaleTopology AddCommGrpCat.{u},
      m₀ • CategoryTheory.CategoryStruct.id 𝒢 = 0 →
      (∃ 𝒢_U : CategoryTheory.Sheaf U_Q.toScheme.smallEtaleTopology AddCommGrpCat.{u},
        WeilIsEtaleSheafPullback U_Q.ι 𝒢 𝒢_U ∧ CategoryTheory.Limits.IsZero 𝒢_U) →
      Subsingleton (𝒢.H 0) → CategoryTheory.Limits.IsZero 𝒢 :=
    fun 𝒢 hTors hZeroU =>
      (weil_iso_roof_coker_closed_point_skyscraper_eval κ ℓ (r + 1)
        Q_R x_Q hx_Q U_Q hU_Q 𝒢 hTors hZeroU).1
  obtain ⟨hIso_ηQ_all, hIso_ηZ_all⟩ :=
    weil_iso_roof_coker_deg0_unit_iso_and_roof_transfer κ m₀ Z_R Q_R W_R
      x_Z U_Z hU_Z x_Q U_Q hU_Q v_W e_W q_W
      hv_e hpre_e hpre_q hSkyZero_Q p_Q0 hp_Q0 hBij_Q0 p_Q1 hp_Q1 hInj_Q1
  have hIso_ηQ := @hIso_ηQ_all (sys U_Q.ι).hCont (sys U_Q.ι).hAdj
    (weilEtaleIdTerminal.{u} U_Q.toScheme) (weilEtaleIdTerminalIsTerminal.{u} U_Q.toScheme)
