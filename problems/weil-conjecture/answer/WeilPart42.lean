        exists_of_eq := fun {x y} hxy => ⟨1, by simp [hφ₁_inj hxy]⟩ }
    letI : Algebra R₁ L_loc := ((algebraMap K_loc L_loc).comp φ₁).toAlgebra
    haveI : IsScalarTower R₁ K_loc L_loc := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower R_loc R₁ L_loc := by
      refine IsScalarTower.of_algebraMap_eq fun r => ?_
      change algebraMap R_loc L_loc r = algebraMap K_loc L_loc (φ₁ (algebraMap R_loc R₁ r))
      rw [hφ₁_eq, ← IsScalarTower.algebraMap_apply R_loc K_loc L_loc]
    let B₁ := ↥(integralClosure R₁ L_loc)
    haveI : IsDedekindDomain B₁ := integralClosure.isDedekindDomain R₁ K_loc L_loc
    haveI : Module.Finite R₁ B₁ := IsIntegralClosure.finite R₁ K_loc L_loc B₁
    haveI : Algebra.FiniteType R₁ B₁ := Module.Finite.finiteType B₁
    haveI : Algebra.IsIntegral R₁ B₁ := Algebra.IsIntegral.of_finite R₁ B₁
    haveI : IsFractionRing B₁ L_loc := integralClosure.isFractionRing_of_finite_extension K_loc L_loc
    have halg_R₁B₁_inj : Function.Injective (algebraMap R₁ B₁) := by
      intro r₁ r₂ h; apply hφ₁_inj; apply (algebraMap K_loc L_loc).injective
      change algebraMap R₁ L_loc r₁ = algebraMap R₁ L_loc r₂
      rw [IsScalarTower.algebraMap_apply R₁ B₁ L_loc,
