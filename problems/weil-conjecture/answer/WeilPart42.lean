        intro a ha hak
        let e_a : weilEtaleHigherDirectImage u a Q ≅ weilEtaleHigherDirectImage u (a + 1) G :=
          @CategoryTheory.asIso _ _ _ _ (weilSingDevAlgBCConnHom u SC_U hSE_U a) (hIso_δ a ha)
        exact (hZeroG (a + 1) (by omega) (by omega)).of_iso e_a
      have hz'_edge : weilOuterTrFibEdgeHom u T_X hT_U Q (k + 1) z' = 0 := by
        let e_k1 : weilEtaleHigherDirectImage u (k + 1) Q ≅
            weilEtaleHigherDirectImage u (k + 2) G :=
