                  CategoryTheory.MorphismProperty.Over.Hom.ext (Category.id_comp σ.left)
                exact (hSigma_congr P Z₀.unop hπ
                  (u_σ (lam_σ Z₀.unop σ) (π_V (Z_σ Z₀.unop σ)) ≫ κ_inv (Z_σ Z₀.unop σ))
                  (𝟙 (Z_σ Z₀.unop σ)) (Category.id_comp _)).trans
                  (by rw [op_id, P.map_id, Category.id_comp])
              right_inv := fun ψ => by
                ext E₀ : 2
                dsimp
                rw [CategoryTheory.Limits.Sigma.ι_comp_desc, ← Category.assoc,
                  ψ.naturality (κ_inv E₀.unop).op]
                dsimp
                rw [Category.assoc, ← Q.map_comp, ← op_comp]
                have hlam : lam_σ (M_w'.obj E₀.unop) (π_V E₀.unop) ≫ M_w'.map (κ_inv E₀.unop) =
