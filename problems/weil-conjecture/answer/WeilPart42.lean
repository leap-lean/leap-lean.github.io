    have hCov : CategoryTheory.CoverPreserving X.smallEtaleTopology S.smallEtaleTopology M_u := by
      refine ⟨fun {U} S_cov hS => ?_⟩
      have hEqX : X.smallEtaleTopology =
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := X)).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X le_rfl
      have hEqS : S.smallEtaleTopology =
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := S)).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S le_rfl
      have hS' : S_cov ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et (S := X)).toGrothendieck U :=
        hEqX ▸ hS
      rcases (CategoryTheory.Pretopology.mem_toGrothendieck _ _ _).mp hS' with ⟨R, hR, hRS⟩
      have hR₁ := CategoryTheory.Precoverage.mem_comap_iff.mp hR
      have hR₂ := CategoryTheory.Precoverage.mem_comap_iff.mp hR₁
