    · rw [CategoryTheory.Category.assoc, hαY_snd, ← CategoryTheory.Category.assoc, he_snd,
        CategoryTheory.Category.assoc, he_snd, hα_τ_snd]
  obtain ⟨p_e, hp_e⟩ := hPull_ex e_pb.hom (ℓ ^ (r' + 1)) (2 * m + 1)
  obtain ⟨p_e_inv, hp_e_inv⟩ := hPull_ex e_pb.inv (ℓ ^ (r' + 1)) (2 * m + 1)
  obtain ⟨p_id, hp_id⟩ :=
    hPull_ex (CategoryTheory.CategoryStruct.id Z_κ) (ℓ ^ (r' + 1)) (2 * m + 1)
  obtain ⟨p_lhs, hp_lhs⟩ := hPull_ex (e_pb.hom ≫ α_τ_Y) (ℓ ^ (r' + 1)) (2 * m + 1)
  have hp_id_eq : p_id = AddMonoidHom.id _ := hPull_id _ _ p_id hp_id
  have hp_inv_comp : p_id = p_e.comp p_e_inv :=
    hPull_comp e_pb.hom e_pb.inv _ _ p_e p_e_inv p_id hp_e hp_e_inv
      (by rwa [e_pb.hom_inv_id])
  have hp_lhs1 : p_lhs = p_e.comp p_τ_Y :=
    hPull_comp e_pb.hom α_τ_Y _ _ p_e p_τ_Y p_lhs hp_e hp_τ_Y hp_lhs
  have hp_lhs2 : p_lhs = p_τ.comp p_e :=
    hPull_comp α_τ e_pb.hom _ _ p_τ p_e p_lhs hp_τ hp_e (by rwa [← he_aut])
  have hp_comm : p_τ.comp p_e = p_e.comp p_τ_Y := hp_lhs2.symm.trans hp_lhs1
  have hsurj : p_e (p_e_inv v) = v := by
    change (p_e.comp p_e_inv) v = v
    rw [← hp_inv_comp, hp_id_eq]
    rfl
  calc
    p_τ v = p_τ (p_e (p_e_inv v)) := congrArg p_τ hsurj.symm
    _ = (p_τ.comp p_e) (p_e_inv v) := rfl
    _ = (p_e.comp p_τ_Y) (p_e_inv v) := by rw [hp_comm]
    _ = p_e (p_τ_Y (p_e_inv v)) := rfl
    _ = p_e (p_e_inv v) := by rw [hp_τ_Y_id (p_e_inv v)]
    _ = v := hsurj

