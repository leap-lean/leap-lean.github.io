  let Φ : C_V ⟶ ℋ := (adj_const.homEquiv A_open ℋ).symm α_glob
  have hΦ_unit : adj_const.unit.app A_open ≫ Φ.hom.app (Opposite.op T_V) = α_glob :=
    (adj_const.homEquiv_unit A_open ℋ Φ).symm.trans
