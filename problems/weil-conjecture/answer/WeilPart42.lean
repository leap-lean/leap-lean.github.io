            calc u_pt.1 = (τ_Y.inv ≫ τ_Y.hom).base u_pt.1 := by rw [τ_Y.inv_hom_id]; rfl
              _ = τ_Y.hom.base ((U_Y.ι ≫ τ_Y.inv).base u_pt) := rfl
              _ = (x_bar_V ≫ τ_Y.hom).base pt := congrArg τ_Y.hom.base hpt.symm
