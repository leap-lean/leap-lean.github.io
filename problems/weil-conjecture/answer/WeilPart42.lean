          (congrArg (adj_S.homEquiv (L_pre.obj 𝒢'.obj) ℱ).symm
            (adj_pre.homEquiv_naturality_left_symm α.hom ψ')).trans
            (adj_S.homEquiv_naturality_left_symm (L_pre.map α.hom)
