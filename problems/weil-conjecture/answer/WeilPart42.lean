                ext U : 3
                exact (φ.hom.naturality (adj_MB.counit.app U.unop).op).symm }
          counit :=
            { app := fun 𝒢 =>
                { hom :=
                    { app := fun V => 𝒢.obj.map (adj_MB.unit.app V.unop).op
                      naturality := fun {V₁ V₂} f => by
                        dsimp [R_u, pf_u, CategoryTheory.Functor.sheafPushforwardContinuous]
                        rw [← 𝒢.obj.map_comp, ← 𝒢.obj.map_comp, ← Quiver.Hom.op_unop f, ← op_comp, ← op_comp]
                        exact congrArg (fun m => 𝒢.obj.map m.op) (adj_MB.unit.naturality f.unop).symm } }
              naturality := fun {𝒢₁ 𝒢₂} ψ => by
                ext V : 3
                exact (ψ.hom.naturality (adj_MB.unit.app V.unop).op).symm }
          left_triangle := CategoryTheory.NatTrans.ext (funext fun ℱ =>
            CategoryTheory.Sheaf.hom_ext (CategoryTheory.NatTrans.ext (funext fun V => by
              dsimp [R_u, pf_u, CategoryTheory.Functor.sheafPushforwardContinuous]
              rw [Category.id_comp, ← ℱ.obj.map_comp, ← op_comp,
                adj_MB.left_triangle_components V.unop, op_id, ℱ.obj.map_id])))
