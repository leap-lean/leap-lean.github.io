          (weilEtaleHigherDirectImage j' (k + 1) (pb_w'.obj I_sh)) :=
        hInjHdiZero j' (pb_w'.obj I_sh) hInj_pbI k
      rcases (hBase.2.2.2 j' (SC.map pb_w') hSE').2 k with ⟨_, h₂_j, _, _, hEx₂_j, hEx₃_j⟩
      have h_ιj_zero : weilEtaleHigherDirectImageMap j' (k + 1) (SC.map pb_w').f = 0 :=
        hZero_jI.eq_of_tgt _ 0
      haveI : CategoryTheory.Epi (weilSingDevAlgBCConnHom j' (SC.map pb_w') hSE' k) :=
        CategoryTheory.ShortComplex.Exact.epi_f hEx₃_j h_ιj_zero
