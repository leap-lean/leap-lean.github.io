            ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hπ_γ]
      have hzero_τX_inv : zero_X ≫ τ_X.inv = zero_X := by
        calc zero_X ≫ τ_X.inv = (zero_X ≫ τ_X.hom) ≫ τ_X.inv := by rw [hzero_τX]
          _ = zero_X := by rw [Category.assoc, τ_X.hom_inv_id, Category.comp_id]
      have hrange_fwd : Set.range (U_X.ι ≫ τ_X.hom).base ⊆ Set.range U_X.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hUX_compl]
        rintro _ ⟨u_pt, rfl⟩ ⟨pt, hpt⟩
        have hu_eq : u_pt.1 = zero_X.base pt := by
          calc u_pt.1 = (τ_X.hom ≫ τ_X.inv).base u_pt.1 := by rw [τ_X.hom_inv_id]; rfl
            _ = τ_X.inv.base ((U_X.ι ≫ τ_X.hom).base u_pt) := rfl
            _ = (zero_X ≫ τ_X.inv).base pt := congrArg τ_X.inv.base hpt.symm
            _ = zero_X.base pt := by rw [hzero_τX_inv]
        have hu_mem : u_pt.1 ∈ (Set.range zero_X.base)ᶜ := by
          rw [← hUX_compl]; exact u_pt.2
        exact hu_mem ⟨pt, hu_eq.symm⟩
      have hrange_inv : Set.range (U_X.ι ≫ τ_X.inv).base ⊆ Set.range U_X.ι.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι, hUX_compl]
        rintro _ ⟨u_pt, rfl⟩ ⟨pt, hpt⟩
        have hu_eq : u_pt.1 = zero_X.base pt := by
          calc u_pt.1 = (τ_X.inv ≫ τ_X.hom).base u_pt.1 := by rw [τ_X.inv_hom_id]; rfl
            _ = τ_X.hom.base ((U_X.ι ≫ τ_X.inv).base u_pt) := rfl
            _ = (zero_X ≫ τ_X.hom).base pt := congrArg τ_X.hom.base hpt.symm
            _ = zero_X.base pt := by rw [hzero_τX]
        have hu_mem : u_pt.1 ∈ (Set.range zero_X.base)ᶜ := by
          rw [← hUX_compl]; exact u_pt.2
        exact hu_mem ⟨pt, hu_eq.symm⟩
      let τ_UX_hom : U_X.toScheme ⟶ U_X.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_X.ι (U_X.ι ≫ τ_X.hom) hrange_fwd
      let τ_UX_inv : U_X.toScheme ⟶ U_X.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U_X.ι (U_X.ι ≫ τ_X.inv) hrange_inv
      have hτ_UX_fac : τ_UX_hom ≫ U_X.ι = U_X.ι ≫ τ_X.hom :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_X.ι (U_X.ι ≫ τ_X.hom) hrange_fwd
      have hτ_UX_inv_fac : τ_UX_inv ≫ U_X.ι = U_X.ι ≫ τ_X.inv :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U_X.ι (U_X.ι ≫ τ_X.inv) hrange_inv
      let τ_UX : U_X.toScheme ≅ U_X.toScheme :=
        { hom := τ_UX_hom
          inv := τ_UX_inv
          hom_inv_id := by
            rw [← cancel_mono U_X.ι, Category.assoc, hτ_UX_inv_fac, ← Category.assoc,
              hτ_UX_fac, Category.assoc, τ_X.hom_inv_id, Category.comp_id, Category.id_comp]
          inv_hom_id := by
            rw [← cancel_mono U_X.ι, Category.assoc, hτ_UX_fac, ← Category.assoc,
              hτ_UX_inv_fac, Category.assoc, τ_X.inv_hom_id, Category.comp_id, Category.id_comp] }
      have hτ_M_comm : τ_M.hom ≫ (e_M.hom ≫ U_0.ι) = (e_M.hom ≫ U_0.ι) ≫ τ_X.hom := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, he_M_pr1, ← Category.assoc, ← Category.assoc, hτ_Φ,
            Category.assoc, Category.assoc, hτX_pr1, ← Category.assoc, he_M_pr1, Category.assoc]
        · rw [Category.assoc, he_M_pr2, hτ_π,
            Category.assoc, hτX_pr2, ← Category.assoc, he_M_pr2]
