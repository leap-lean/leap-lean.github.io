      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (Polynomial k) R₀_k)) ≫ j_k) :
    ∀ x : ↥U_bar.toScheme,
      ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U_bar.toScheme) (A₀ : AddCommGrpCat.{u}),
        AlgebraicGeometry.Etale w ∧
        x ∈ Set.range w.base ∧
        Finite ↥A₀ ∧
        WeilIsEtaleSheafPullback w
          (weilEtaleHigherDirectImage (f_bar.left ∣_ U_bar) d_rel
            (weilEtaleTorsionSheaf (f_bar.left ⁻¹ᵁ U_bar).toScheme (ℓ ^ (r' + 1))))
          ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀) :=
by
  classical
  let D_bar := weilProjectiveSpaceOver k 1
  obtain ⟨_, hProj_all, _, _⟩ := weil_canonical_and_projective_baseChange_models.2.2.2 1
  have _ : AlgebraicGeometry.IsProper D_bar.hom :=
    weil_canonical_and_projective_baseChange_models.1 k D_bar (hProj_all k)
  let ψ_loc : Localization.Away Δ_k ≃ₐ[Polynomial k] R₀_k :=
    Localization.algEquiv (Submonoid.powers Δ_k) R₀_k
  let e_Spec : AlgebraicGeometry.Spec (CommRingCat.of R₀_k) ≅
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away Δ_k)) :=
    { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc.toRingHom)
      inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_loc.symm.toRingHom)
      hom_inv_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_id : ψ_loc.toRingHom.comp ψ_loc.symm.toRingHom = RingHom.id R₀_k :=
          RingHom.ext ψ_loc.apply_symm_apply
        rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      inv_hom_id := by
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have h_id : ψ_loc.symm.toRingHom.comp ψ_loc.toRingHom =
            RingHom.id (Localization.Away Δ_k) :=
          RingHom.ext ψ_loc.symm_apply_apply
        rw [h_id, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
  let e_U_loc : U_bar.toScheme ≅
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away Δ_k)) :=
    e_Rk.symm.trans e_Spec
  have he_U_loc : U_bar.ι = e_U_loc.hom ≫
      AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away Δ_k))) ≫ j_k := by
    have h_alg : ψ_loc.toRingHom.comp
        (algebraMap (Polynomial k) (Localization.Away Δ_k)) =
        algebraMap (Polynomial k) R₀_k :=
      RingHom.ext ψ_loc.commutes
    have h_spec : e_Spec.hom ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial k) (Localization.Away Δ_k))) =
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap (Polynomial k) R₀_k)) := by
      dsimp only [e_Spec]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_alg]
    symm
    change (e_Rk.inv ≫ e_Spec.hom) ≫ _ ≫ j_k = U_bar.ι
    rw [CategoryTheory.Category.assoc,
      ← CategoryTheory.Category.assoc e_Spec.hom _ j_k,
      h_spec, ← he_Rk, ← CategoryTheory.Category.assoc,
      e_Rk.inv_hom_id, CategoryTheory.Category.id_comp]
  let X_U : AlgebraicGeometry.Scheme.{u} := (f_bar.left ⁻¹ᵁ U_bar).toScheme
  let g_bar : X_U ⟶ U_bar.toScheme := f_bar.left ∣_ U_bar
  let LocConstAt := fun (y : ↥U_bar.toScheme)
      (ℱ : CategoryTheory.Sheaf U_bar.toScheme.smallEtaleTopology AddCommGrpCat.{u}) =>
    ∃ (W : AlgebraicGeometry.Scheme.{u}) (w : W ⟶ U_bar.toScheme) (A₀ : AddCommGrpCat.{u}),
      AlgebraicGeometry.Etale w ∧
      y ∈ Set.range w.base ∧
      Finite ↥A₀ ∧
      WeilIsEtaleSheafPullback w ℱ
        ((CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}).obj A₀)
  have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
    weil_etale_proper_base_change_mod_prime k ℓ hℓ_k
  have hCurve : ∀ (k₀ : Type u) [Field k₀] [IsAlgClosed k₀]
      (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k₀)))
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom],
      AlgebraicGeometry.IsIntegral C.left →
      IsProjectiveOverField k₀ C →
      (ℓ : k₀) ≠ 0 →
      (∀ q₀ : ℕ, Finite (weilEtaleTorsionH C.left ℓ q₀)) ∧
      (∀ q₀ : ℕ, 3 ≤ q₀ → Subsingleton (weilEtaleTorsionH C.left ℓ q₀)) ∧
      Nat.card (weilEtaleTorsionH C.left ℓ 0) = ℓ ∧
      Nat.card (weilEtaleTorsionH C.left ℓ 2) = ℓ :=
    fun k₀ _ _ C _ hIntC hProjC hℓ₀ =>
      weil_etale_smooth_proj_curve_mod_prime_cohomology k₀ C hIntC hProjC ℓ hℓ₀
  have hP1 : WeilP1ConstructiblePushforwardHolds k ℓ :=
    weil_etale_p1_constructible_pushforward k ℓ hℓ_k hCurve hPBC
  have hF_Zbar : WeilIsConstructibleModPrimeSheaf ℓ Z_bar.left
      (weilEtaleTorsionSheaf Z_bar.left ℓ) :=
    (weil_etale_constructible_mod_prime_extraction_over_algClosed k Z_bar ℓ 0).1
  have hConstruct : ∀ q₀ : ℕ,
      WeilIsConstructibleModPrimeSheaf ℓ D_bar.left
        (weilEtaleHigherDirectImage f_bar.left q₀ (weilEtaleTorsionSheaf Z_bar.left ℓ)) :=
    fun q₀ => weil_etale_proper_constructible_pushforward k ℓ hℓ_k hPBC hP1 Z_bar D_bar f_bar
      inferInstance (weilEtaleTorsionSheaf Z_bar.left ℓ) hF_Zbar q₀
  have h_mod_ell : ∀ (q₀ : ℕ) (y : ↥U_bar.toScheme),
      LocConstAt y (weilEtaleHigherDirectImage g_bar q₀ (weilEtaleTorsionSheaf X_U ℓ)) :=
    weil_sing_dev_deg2m2_mod_prime_punctured_line_locConst k d_rel Z_bar D_bar
      (CategoryTheory.Iso.refl D_bar) f_bar ℓ hℓ_k hPBC hConstruct j_k hj_k_hom
      Δ_k hΔ_k_ne U_bar e_U_loc he_U_loc
  have _ : IsNoetherianRing R₀_k :=
    IsLocalization.isNoetherianRing (Submonoid.powers Δ_k) R₀_k inferInstance
  have h_all : ∀ (r₀ q₀ : ℕ) (y : ↥U_bar.toScheme),
      LocConstAt y
        (weilEtaleHigherDirectImage g_bar q₀
          (weilEtaleTorsionSheaf X_U (ℓ ^ (r₀ + 1)))) := by
    intro r₀
    induction r₀ with
    | zero =>
      intro q₀ y
      rw [zero_add, pow_one]
      exact h_mod_ell q₀ y
    | succ r₀ ih =>
      obtain ⟨μ, π, h0_AM, hSE_AM⟩ :=
        weil_outer_bc_const_pullback_and_bockstein_ses.2.2.2 ℓ (r₀ + 1)
      obtain ⟨T_X, ⟨hT_X⟩⟩ :=
        (weil_outer_bc_const_pullback_and_bockstein_ses.1 (𝟙 X_U)).1
      let C_X := CategoryTheory.constantSheaf X_U.smallEtaleTopology AddCommGrpCat.{u}
      let adj_X := CategoryTheory.constantSheafAdj X_U.smallEtaleTopology AddCommGrpCat.{u} hT_X
      have _ : C_X.IsLeftAdjoint := adj_X.isLeftAdjoint
      have _ : C_X.Additive := by
        dsimp [C_X]; unfold CategoryTheory.constantSheaf; infer_instance
      have _ : CategoryTheory.Limits.PreservesFiniteColimits C_X := inferInstance
      have _ : CategoryTheory.Limits.PreservesFiniteLimits C_X := by
        dsimp [C_X, CategoryTheory.constantSheaf]; infer_instance
      let SC_AM := CategoryTheory.ShortComplex.mk μ π h0_AM
      let SC_X := SC_AM.map C_X
      have hSE_X : SC_X.ShortExact := hSE_AM.map_of_exact C_X
      have hPushCalc := weil_outer_bc_push_and_conn_calculus.1 g_bar
      intro q₀ y
      rcases q₀ with _ | q'
      · let A_zero : AddCommGrpCat.{u} := AddCommGrpCat.of PUnit.{u + 1}
        let C_zero :=
          (CategoryTheory.constantSheaf U_bar.toScheme.smallEtaleTopology AddCommGrpCat.{u}).obj
            A_zero
        have hLC_zero : LocConstAt y C_zero :=
          ⟨U_bar.toScheme, 𝟙 U_bar.toScheme, A_zero, inferInstance, ⟨y, rfl⟩, inferInstance,
            (weil_etale_pullback_exact_and_pseudofunctor ℓ).2.2.2.1 (𝟙 U_bar.toScheme) A_zero⟩
        have _ : CategoryTheory.Mono SC_X.f := hSE_X.mono_f
        have _ : CategoryTheory.Mono (weilEtaleHigherDirectImageMap g_bar 0 SC_X.f) :=
          hPushCalc.2.2.1 SC_X.f
        let d₀ : C_zero ⟶ weilEtaleHigherDirectImage g_bar 0 SC_X.X₁ := 0
        have hd₀f : d₀ ≫ weilEtaleHigherDirectImageMap g_bar 0 SC_X.f = 0 :=
          CategoryTheory.Limits.zero_comp
        have hEx₀ :
            (CategoryTheory.ShortComplex.mk d₀
              (weilEtaleHigherDirectImageMap g_bar 0 SC_X.f) hd₀f).Exact :=
          (CategoryTheory.ShortComplex.exact_iff_mono _ rfl).mpr inferInstance
        obtain ⟨δ₀, _, h0_mid, h0_left, _, hEx_mid, hEx_left, _⟩ :=
          hPushCalc.2.2.2.1 hSE_X 0
        exact weil_mid_dev_raw_locConst_noetherian_five_term_exact_ext
          R₀_k U_bar.toScheme e_Rk
          C_zero
          (weilEtaleHigherDirectImage g_bar 0 SC_X.X₁)
          (weilEtaleHigherDirectImage g_bar 0 SC_X.X₂)
          (weilEtaleHigherDirectImage g_bar 0 SC_X.X₃)
          (weilEtaleHigherDirectImage g_bar 1 SC_X.X₁)
          d₀
          (weilEtaleHigherDirectImageMap g_bar 0 SC_X.f)
          (weilEtaleHigherDirectImageMap g_bar 0 SC_X.g)
          δ₀
          hd₀f h0_mid h0_left hEx₀ hEx_mid hEx_left y
          hLC_zero (h_mod_ell 0 y) (ih 0 y) (h_mod_ell 1 y)
      · obtain ⟨δ_prev, _, _, _, h0_right, _, _, hEx_right⟩ :=
          hPushCalc.2.2.2.1 hSE_X q'
        obtain ⟨δ_curr, _, h0_mid, h0_left, _, hEx_mid, hEx_left, _⟩ :=
          hPushCalc.2.2.2.1 hSE_X (q' + 1)
        exact weil_mid_dev_raw_locConst_noetherian_five_term_exact_ext
          R₀_k U_bar.toScheme e_Rk
          (weilEtaleHigherDirectImage g_bar q' SC_X.X₃)
          (weilEtaleHigherDirectImage g_bar (q' + 1) SC_X.X₁)
          (weilEtaleHigherDirectImage g_bar (q' + 1) SC_X.X₂)
          (weilEtaleHigherDirectImage g_bar (q' + 1) SC_X.X₃)
          (weilEtaleHigherDirectImage g_bar (q' + 2) SC_X.X₁)
          δ_prev
          (weilEtaleHigherDirectImageMap g_bar (q' + 1) SC_X.f)
          (weilEtaleHigherDirectImageMap g_bar (q' + 1) SC_X.g)
          δ_curr
          h0_right h0_mid h0_left hEx_right hEx_mid hEx_left y
          (ih q' y) (h_mod_ell (q' + 1) y) (ih (q' + 1) y) (h_mod_ell (q' + 2) y)
  exact fun x => h_all r' d_rel x

theorem weil_net_p2_noetherian_etale_of_traceMatrix_det_isUnit (R S : Type u) [CommRing R] [IsNoetherianRing R] [CommRing S] [Algebra R S]
    (n : ℕ) (v : Module.Basis (Fin n) R S)
    (hDet : IsUnit (Algebra.traceMatrix R ⇑v).det) :
    Module.Finite R S ∧ Algebra.Etale R S :=
by
  have hFin : Module.Finite R S := Module.Finite.of_basis v
  have : Module.Finite R S := hFin
  let T : Matrix (Fin n) (Fin n) R := Algebra.traceMatrix R ⇑v
  have hT_apply : ∀ i j : Fin n, T i j = Algebra.trace R S (v i * v j) :=
    fun _ _ => rfl
  have hT_symm : ∀ k j : Fin n, T k j = T j k := by
    intro k j
    rw [hT_apply, hT_apply, mul_comm]
  let U : Matrix (Fin n) (Fin n) R := T⁻¹
  have hTU : T * U = 1 := Matrix.mul_nonsing_inv T hDet
  have hUT : U * T = 1 := Matrix.nonsing_inv_mul T hDet
  let v_star : Fin n → S := fun i => ∑ j : Fin n, U i j • v j
  have hBiorth : ∀ k i : Fin n,
      Algebra.trace R S (v k * v_star i) = (1 : Matrix (Fin n) (Fin n) R) i k := by
    intro k i
    have hmul : v k * v_star i = ∑ j : Fin n, U i j • (v k * v j) := by
      dsimp [v_star]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [mul_smul_comm]
    rw [hmul, map_sum]
    have hsum : (∑ j : Fin n, (Algebra.trace R S) (U i j • (v k * v j))) =
        ∑ j : Fin n, U i j * T j k := by
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [LinearMap.map_smul, smul_eq_mul, ← hT_apply k j, hT_symm k j]
    rw [hsum, ← Matrix.mul_apply, hUT]
  have hDualExp : ∀ z : S, (∑ r : Fin n, (Algebra.trace R S (z * v r)) • v_star r) = z := by
    intro z
    have hTr_z : ∀ r : Fin n,
        Algebra.trace R S (z * v r) = ∑ k : Fin n, v.repr z k * T k r := by
      intro r
      conv_lhs => rw [← v.sum_repr z]
      rw [Finset.sum_mul, map_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [smul_mul_assoc, LinearMap.map_smul, smul_eq_mul, hT_apply]
    calc
      (∑ r : Fin n, (Algebra.trace R S (z * v r)) • v_star r)
          = ∑ r : Fin n, ∑ j : Fin n, ((∑ k : Fin n, v.repr z k * T k r) * U r j) • v j := by
            refine Finset.sum_congr rfl fun r _ => ?_
            rw [hTr_z r]
            dsimp [v_star]
            rw [Finset.smul_sum]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [smul_smul]
      _ = ∑ j : Fin n, (∑ r : Fin n, (∑ k : Fin n, v.repr z k * T k r) * U r j) • v j := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun j _ => ?_
            rw [Finset.sum_smul]
      _ = ∑ j : Fin n, (∑ k : Fin n, v.repr z k * (T * U) k j) • v j := by
            refine Finset.sum_congr rfl fun j _ => ?_
            congr 1
            calc
              (∑ r : Fin n, (∑ k : Fin n, v.repr z k * T k r) * U r j)
                  = ∑ r : Fin n, ∑ k : Fin n, v.repr z k * (T k r * U r j) := by
                    refine Finset.sum_congr rfl fun r _ => ?_
                    rw [Finset.sum_mul]
                    refine Finset.sum_congr rfl fun k _ => mul_assoc _ _ _
              _ = ∑ k : Fin n, ∑ r : Fin n, v.repr z k * (T k r * U r j) := Finset.sum_comm
              _ = ∑ k : Fin n, v.repr z k * (T * U) k j := by
                    refine Finset.sum_congr rfl fun k _ => ?_
                    rw [← Finset.mul_sum, ← Matrix.mul_apply]
      _ = ∑ j : Fin n, v.repr z j • v j := by
            refine Finset.sum_congr rfl fun j _ => ?_
            congr 1
            rw [hTU]
            have h1 : ∀ k : Fin n, v.repr z k * (1 : Matrix (Fin n) (Fin n) R) k j =
                if k = j then v.repr z k else 0 := by
              intro k
              rw [Matrix.one_apply]
              split_ifs <;> simp
            simp_rw [h1]
            simp
      _ = z := v.sum_repr z
  have hLeftMul : ∀ (x : S) (i : Fin n),
      x * v i = ∑ k : Fin n, (Algebra.leftMulMatrix v x k i) • v k := by
    intro x i
    conv_lhs => rw [← v.sum_repr (x * v i)]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Algebra.leftMulMatrix_eq_repr_mul]
  have hSum : (∑ i : Fin n, v i * v_star i) = 1 := by
    rw [← hDualExp (∑ i : Fin n, v i * v_star i), ← hDualExp 1]
    refine Finset.sum_congr rfl fun r _ => ?_
    congr 1
    rw [one_mul]
    have hexp : (∑ i : Fin n, v i * v_star i) * v r =
        ∑ i : Fin n, ∑ k : Fin n, (Algebra.leftMulMatrix v (v r) k i) • (v k * v_star i) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      have hcomm : v i * v_star i * v r = (v r * v i) * v_star i := by ring
      rw [hcomm, hLeftMul (v r) i, Finset.sum_mul]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [smul_mul_assoc]
    rw [hexp, map_sum]
    have hdiag : (∑ i : Fin n, (Algebra.trace R S)
          (∑ k : Fin n, (Algebra.leftMulMatrix v (v r) k i) • (v k * v_star i))) =
        ∑ i : Fin n, Algebra.leftMulMatrix v (v r) i i := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_sum]
      have hterm : ∀ k : Fin n,
          (Algebra.trace R S) ((Algebra.leftMulMatrix v (v r) k i) • (v k * v_star i)) =
          if i = k then Algebra.leftMulMatrix v (v r) k i else 0 := by
        intro k
        rw [LinearMap.map_smul, smul_eq_mul, hBiorth k i, Matrix.one_apply]
        split_ifs <;> simp
      simp_rw [hterm]
      simp
    rw [hdiag, Algebra.trace_eq_matrix_trace v (v r)]
    simp [Matrix.trace]
  have hMul : ∀ (x : S) (k : Fin n),
      x * v_star k = ∑ i : Fin n, (Algebra.leftMulMatrix v x k i) • v_star i := by
    intro x k
    rw [← hDualExp (x * v_star k)]
    refine Finset.sum_congr rfl fun i _ => ?_
    congr 1
    have hexp : x * v_star k * v i =
        ∑ l : Fin n, (Algebra.leftMulMatrix v x l i) • (v l * v_star k) := by
      have hcomm : x * v_star k * v i = (x * v i) * v_star k := by ring
      rw [hcomm, hLeftMul x i, Finset.sum_mul]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [smul_mul_assoc]
    rw [hexp, map_sum]
    have hterm : ∀ l : Fin n,
        (Algebra.trace R S) ((Algebra.leftMulMatrix v x l i) • (v l * v_star k)) =
        if k = l then Algebra.leftMulMatrix v x l i else 0 := by
      intro l
      rw [LinearMap.map_smul, smul_eq_mul, hBiorth l k, Matrix.one_apply]
      split_ifs <;> simp
    simp_rw [hterm]
    simp
  have hUnram : Algebra.FormallyUnramified R S := by
    let D := KaehlerDifferential.D R S
    have hSmulComm : ∀ (s : S) (r : R) (ω : Ω[S⁄R]), s • (r • ω) = (r • s) • ω := by
      intro s r ω
      rw [← algebraMap_smul S r ω, smul_smul, mul_comm s (algebraMap R S r), ← Algebra.smul_def r s]
    have hD_zero : ∀ x : S, D x = 0 := by
      intro x
      have hW1 : (∑ i : Fin n, v_star i • D (x * v i)) =
          (∑ i : Fin n, (x * v_star i) • D (v i)) + D x := by
        calc
          (∑ i : Fin n, v_star i • D (x * v i))
              = ∑ i : Fin n, ((x * v_star i) • D (v i) + (v i * v_star i) • D x) := by
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [D.leibniz x (v i), smul_add, smul_smul, smul_smul,
                  mul_comm (v_star i) x, mul_comm (v_star i) (v i)]
          _ = (∑ i : Fin n, (x * v_star i) • D (v i)) +
                (∑ i : Fin n, (v i * v_star i) • D x) := Finset.sum_add_distrib
          _ = (∑ i : Fin n, (x * v_star i) • D (v i)) + D x := by
                rw [← Finset.sum_smul, hSum, one_smul]
      have hW2 : (∑ i : Fin n, v_star i • D (x * v i)) =
          ∑ k : Fin n, (x * v_star k) • D (v k) := by
        calc
          (∑ i : Fin n, v_star i • D (x * v i))
              = ∑ i : Fin n, ∑ k : Fin n,
                  ((Algebra.leftMulMatrix v x k i) • v_star i) • D (v k) := by
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [hLeftMul x i, map_sum, Finset.smul_sum]
                refine Finset.sum_congr rfl fun k _ => ?_
                rw [D.map_smul, hSmulComm]
          _ = ∑ k : Fin n, ∑ i : Fin n,
                ((Algebra.leftMulMatrix v x k i) • v_star i) • D (v k) := Finset.sum_comm
          _ = ∑ k : Fin n, (x * v_star k) • D (v k) := by
                refine Finset.sum_congr rfl fun k _ => ?_
                rw [← Finset.sum_smul, ← hMul x k]
      have heq : (∑ i : Fin n, (x * v_star i) • D (v i)) + D x =
          (∑ i : Fin n, (x * v_star i) • D (v i)) + 0 := by
        rw [add_zero, ← hW1, hW2]
      exact add_left_cancel heq
    have hZero : ∀ ω : Ω[S⁄R], ω = 0 := by
      intro ω
      have htop : ω ∈ (⊤ : Submodule S Ω[S⁄R]) := Submodule.mem_top
      rw [← KaehlerDifferential.span_range_derivation R S] at htop
      have hle : Submodule.span S (Set.range ⇑D) ≤ ⊥ := by
        rw [Submodule.span_le]
        rintro _ ⟨x, rfl⟩
        simp only [SetLike.mem_coe, Submodule.mem_bot]
        exact hD_zero x
      have hbot : ω ∈ (⊥ : Submodule S Ω[S⁄R]) := hle htop
      simpa only [Submodule.mem_bot] using hbot
    exact Algebra.FormallyUnramified.mk ⟨fun a b => (hZero a).trans (hZero b).symm⟩
  have hSmooth : Algebra.FormallySmooth R S := by
    let P := MvPolynomial (Fin n) R
    let f : P →ₐ[R] S := MvPolynomial.aeval v
    let J : Ideal P := RingHom.ker f.toRingHom
    let Q := P ⧸ (J ^ 2)
    let π : Q →ₐ[R] S := f.kerSquareLift
    have hSqZero : ∀ u₁ u₂ : Q, π u₁ = 0 → π u₂ = 0 → u₁ * u₂ = 0 := by
      intro u₁ u₂ hu₁ hu₂
      obtain ⟨p₁, rfl⟩ := Ideal.Quotient.mk_surjective u₁
      obtain ⟨p₂, rfl⟩ := Ideal.Quotient.mk_surjective u₂
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, pow_two]
      have hm₁ : p₁ ∈ J := by
        change f p₁ = 0
        exact (AlgHom.kerSquareLift_mk f p₁).symm.trans hu₁
      have hm₂ : p₂ ∈ J := by
        change f p₂ = 0
        exact (AlgHom.kerSquareLift_mk f p₂).symm.trans hu₂
      exact Ideal.mul_mem_mul hm₁ hm₂
    let ψ : S →ₗ[R] Q :=
      v.constr R (fun i : Fin n => Ideal.Quotient.mkₐ R (J ^ 2) (MvPolynomial.X i))
    have hπψ_lin : π.toLinearMap.comp ψ = LinearMap.id := by
      refine v.ext fun i => ?_
      simp only [LinearMap.comp_apply, AlgHom.toLinearMap_apply, LinearMap.id_apply]
      dsimp only [π, ψ, J]
      rw [Module.Basis.constr_basis, Ideal.Quotient.mkₐ_eq_mk, AlgHom.kerSquareLift_mk]
      dsimp only [f]
      rw [MvPolynomial.aeval_X]
    have hπψ : ∀ x : S, π (ψ x) = x := fun x =>
      LinearMap.congr_fun hπψ_lin x
    let Δ : S → S → Q := fun x y => ψ (x * y) - ψ x * ψ y
    have hπΔ : ∀ x y : S, π (Δ x y) = 0 := by
      intro x y
      dsimp only [Δ]
      rw [map_sub π, map_mul π, hπψ (x * y), hπψ x, hπψ y, sub_self]
    have hπOne : π (1 - ψ 1) = 0 := by
      rw [map_sub π, map_one π, hπψ 1, sub_self]
    have hAbsOne : ∀ u : Q, π u = 0 → u * ψ 1 = u := by
      intro u hu
      have h0 : u * (1 - ψ 1) = 0 := hSqZero u (1 - ψ 1) hu hπOne
      have hsub : u - u * ψ 1 = 0 := by
        calc
          u - u * ψ 1 = u * (1 - ψ 1) := by ring
          _ = 0 := h0
      exact (sub_eq_zero.mp hsub).symm
    have hAbsMul : ∀ (u : Q) (y₁ y₂ : S), π u = 0 → u * ψ (y₁ * y₂) = u * ψ y₁ * ψ y₂ := by
      intro u y₁ y₂ hu
      have h0 : u * Δ y₁ y₂ = 0 := hSqZero u (Δ y₁ y₂) hu (hπΔ y₁ y₂)
      have hsub : u * ψ (y₁ * y₂) - u * ψ y₁ * ψ y₂ = 0 := by
        calc
          u * ψ (y₁ * y₂) - u * ψ y₁ * ψ y₂ = u * Δ y₁ y₂ := by
            dsimp [Δ]
            ring
          _ = 0 := h0
      exact sub_eq_zero.mp hsub
    have hΔ_add_left : ∀ x₁ x₂ y : S, Δ (x₁ + x₂) y = Δ x₁ y + Δ x₂ y := by
      intro x₁ x₂ y
      dsimp [Δ]
      rw [add_mul, map_add, map_add]
      ring
    have hΔ_smul_left : ∀ (r : R) (x y : S), Δ (r • x) y = r • Δ x y := by
      intro r x y
      dsimp [Δ]
      rw [smul_mul_assoc, LinearMap.map_smul, LinearMap.map_smul, smul_mul_assoc, smul_sub]
    let Δ_right (x : S) : S →ₗ[R] Q :=
      { toFun := fun y => Δ x y
        map_add' := fun y₁ y₂ => by
          dsimp [Δ]
          rw [mul_add, map_add, map_add]
          ring
        map_smul' := fun r y => by
          dsimp [Δ]
          rw [mul_smul_comm, LinearMap.map_smul, LinearMap.map_smul, mul_smul_comm, smul_sub] }
    have hCocycle : ∀ x y z : S,
        Δ (x * y) z = Δ x (y * z) + ψ x * Δ y z - Δ x y * ψ z := by
      intro x y z
      dsimp [Δ]
      rw [mul_assoc x y z]
      ring
    let η : S → Q := fun x => ∑ i : Fin n, Δ x (v i) * ψ (v_star i)
    let φ₀ : S → Q := fun x => ψ x + η x
    have hπη : ∀ x : S, π (η x) = 0 := by
      intro x
      dsimp [η]
      rw [map_sum]
      refine Finset.sum_eq_zero fun i _ => ?_
      rw [map_mul π, hπΔ, zero_mul]
    have hπφ₀ : ∀ x : S, π (φ₀ x) = x := by
      intro x
      dsimp [φ₀]
      rw [map_add π, hπψ, hπη, add_zero]
    have hη_mul : ∀ x y : S, η x * η y = 0 :=
      fun x y => hSqZero (η x) (η y) (hπη x) (hπη y)
    have hφ₀_add : ∀ x y : S, φ₀ (x + y) = φ₀ x + φ₀ y := by
      intro x y
      have hη_add : η (x + y) = η x + η y := by
        dsimp [η]
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hΔ_add_left, add_mul]
      dsimp [φ₀]
      rw [map_add, hη_add]
      ring
    have hφ₀_smul : ∀ (r : R) (x : S), φ₀ (r • x) = r • φ₀ x := by
      intro r x
      have hη_smul : η (r • x) = r • η x := by
        dsimp [η]
        rw [Finset.smul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hΔ_smul_left, smul_mul_assoc]
      dsimp [φ₀]
      rw [LinearMap.map_smul, hη_smul, smul_add]
    have hφ₀_zero : φ₀ 0 = 0 := by
      simpa using hφ₀_smul 0 0
    have hφ₀_one : φ₀ 1 = 1 := by
      have hη_one : η 1 = 1 - ψ 1 := by
        calc
          η 1 = ∑ i : Fin n, ((1 - ψ 1) * ψ (v i)) * ψ (v_star i) := by
                dsimp [η, Δ]
                refine Finset.sum_congr rfl fun i _ => ?_
                rw [one_mul]
                ring
          _ = ∑ i : Fin n, (1 - ψ 1) * ψ (v i * v_star i) := by
                refine Finset.sum_congr rfl fun i _ => ?_
                exact (hAbsMul (1 - ψ 1) (v i) (v_star i) hπOne).symm
          _ = (1 - ψ 1) * ψ (∑ i : Fin n, v i * v_star i) := by
                rw [← Finset.mul_sum, ← map_sum]
          _ = (1 - ψ 1) * ψ 1 := by rw [hSum]
          _ = 1 - ψ 1 := hAbsOne (1 - ψ 1) hπOne
      dsimp [φ₀]
      rw [hη_one]
      ring
    have hφ₀_mul : ∀ x y : S, φ₀ (x * y) = φ₀ x * φ₀ y := by
      intro x y
      have hS₁ : (∑ i : Fin n, Δ x (y * v i) * ψ (v_star i)) = η x * ψ y := by
        calc
          (∑ i : Fin n, Δ x (y * v i) * ψ (v_star i))
              = ∑ i : Fin n, ∑ k : Fin n,
                  Δ x (v k) * ψ ((Algebra.leftMulMatrix v y k i) • v_star i) := by
                refine Finset.sum_congr rfl fun i _ => ?_
                have hlin : Δ x (y * v i) =
                    ∑ k : Fin n, (Algebra.leftMulMatrix v y k i) • Δ x (v k) := by
                  change Δ_right x (y * v i) = _
                  rw [hLeftMul y i, map_sum]
                  refine Finset.sum_congr rfl fun k _ => (Δ_right x).map_smul _ _
                rw [hlin, Finset.sum_mul]
                refine Finset.sum_congr rfl fun k _ => ?_
                rw [smul_mul_assoc, ← mul_smul_comm, LinearMap.map_smul]
          _ = ∑ k : Fin n, ∑ i : Fin n,
                Δ x (v k) * ψ ((Algebra.leftMulMatrix v y k i) • v_star i) := Finset.sum_comm
          _ = ∑ k : Fin n, Δ x (v k) * ψ (y * v_star k) := by
                refine Finset.sum_congr rfl fun k _ => ?_
                rw [← Finset.mul_sum, ← map_sum, ← hMul y k]
          _ = ∑ k : Fin n, (Δ x (v k) * ψ (v_star k)) * ψ y := by
                refine Finset.sum_congr rfl fun k _ => ?_
                rw [hAbsMul (Δ x (v k)) y (v_star k) (hπΔ x (v k))]
                ring
          _ = η x * ψ y := by
                dsimp [η]
                rw [← Finset.sum_mul]
      have hS₂ : (∑ i : Fin n, (ψ x * Δ y (v i)) * ψ (v_star i)) = ψ x * η y := by
        dsimp [η]
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => mul_assoc _ _ _
      have hS₃ : (∑ i : Fin n, (Δ x y * ψ (v i)) * ψ (v_star i)) = Δ x y := by
        calc
          (∑ i : Fin n, (Δ x y * ψ (v i)) * ψ (v_star i))
              = ∑ i : Fin n, Δ x y * ψ (v i * v_star i) := by
                refine Finset.sum_congr rfl fun i _ =>
                  (hAbsMul (Δ x y) (v i) (v_star i) (hπΔ x y)).symm
          _ = Δ x y * ψ (∑ i : Fin n, v i * v_star i) := by
                rw [← Finset.mul_sum, ← map_sum]
          _ = Δ x y * ψ 1 := by rw [hSum]
          _ = Δ x y := hAbsOne (Δ x y) (hπΔ x y)
      have hη_xy : η (x * y) = η x * ψ y + ψ x * η y - Δ x y := by
        calc
          η (x * y) = ∑ i : Fin n,
              ((Δ x (y * v i) * ψ (v_star i) + (ψ x * Δ y (v i)) * ψ (v_star i)) -
                (Δ x y * ψ (v i)) * ψ (v_star i)) := by
            dsimp [η]
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [hCocycle x y (v i)]
            ring
          _ = (∑ i : Fin n, Δ x (y * v i) * ψ (v_star i)) +
              (∑ i : Fin n, (ψ x * Δ y (v i)) * ψ (v_star i)) -
              (∑ i : Fin n, (Δ x y * ψ (v i)) * ψ (v_star i)) := by
            rw [Finset.sum_sub_distrib, Finset.sum_add_distrib]
          _ = η x * ψ y + ψ x * η y - Δ x y := by
            rw [hS₁, hS₂, hS₃]
      dsimp [φ₀]
      rw [hη_xy]
      dsimp [Δ]
      calc
        ψ (x * y) + (η x * ψ y + ψ x * η y - (ψ (x * y) - ψ x * ψ y))
            = ψ x * ψ y + η x * ψ y + ψ x * η y + 0 := by ring
        _ = ψ x * ψ y + η x * ψ y + ψ x * η y + η x * η y := by rw [← hη_mul x y]
        _ = (ψ x + η x) * (ψ y + η y) := by ring
    let φ : S →ₐ[R] Q :=
      { toFun := φ₀
        map_one' := hφ₀_one
        map_mul' := hφ₀_mul
        map_zero' := hφ₀_zero
        map_add' := hφ₀_add
        commutes' := fun r => by
          rw [Algebra.algebraMap_eq_smul_one, hφ₀_smul, hφ₀_one,
            Algebra.algebraMap_eq_smul_one] }
    have hSplit : f.kerSquareLift.comp φ = AlgHom.id R S :=
      AlgHom.ext fun x => hπφ₀ x
    exact Algebra.FormallySmooth.of_split f φ hSplit
  have hFEt : Algebra.FormallyEtale R S :=
    (Algebra.FormallyEtale.iff_formallyUnramified_and_formallySmooth).mpr ⟨hUnram, hSmooth⟩
  have hFT : Algebra.FiniteType R S := Module.Finite.finiteType S
  have hFP : Algebra.FinitePresentation R S := Algebra.FinitePresentation.of_finiteType.mp hFT
  exact ⟨hFin, @Algebra.Etale.mk R S _ _ _ hFEt hFP⟩

theorem weil_net_p2_dedekind_galois_closure_free_basis_spread (B L : Type u) [CommRing B] [IsDedekindDomain B] [Field L] [Algebra B L] [IsFractionRing B L]
    (f₁ : B) (hf₁ : f₁ ≠ 0)
    (C₁ : Type u) [CommRing C₁] [IsDomain C₁] [Algebra (Localization.Away f₁) C₁]
    [Module.Finite (Localization.Away f₁) C₁]
    [Algebra.IsIntegral (Localization.Away f₁) C₁]
    [Algebra.Etale (Localization.Away f₁) C₁]
    (hSurj_C₁ : Function.Surjective (PrimeSpectrum.comap (algebraMap (Localization.Away f₁) C₁))) :
    ∃ (b₀ : B) (_ : b₀ ≠ 0)
      (C_gal M : Type u)
      (hCR : CommRing C_gal) (_ : IsDomain C_gal) (hFld : Field M)
      (hAlgBL : Algebra (Localization.Away b₀) L)
      (hAlgBC : Algebra (Localization.Away b₀) C_gal)
      (hAlgLM : Algebra L M) (hAlgCM : Algebra C_gal M)
      (hAlgBM : Algebra (Localization.Away b₀) M),
      letI := hCR; letI := hFld
      letI := hAlgBL; letI := hAlgBC; letI := hAlgLM; letI := hAlgCM; letI := hAlgBM
      IsScalarTower B (Localization.Away b₀) L ∧
      IsScalarTower (Localization.Away b₀) L M ∧
      IsScalarTower (Localization.Away b₀) C_gal M ∧
      IsFractionRing (Localization.Away b₀) L ∧
      IsFractionRing C_gal M ∧
      IsIntegralClosure C_gal (Localization.Away b₀) M ∧
      FiniteDimensional L M ∧
      IsGalois L M ∧
      ∃ (j_C₁ : C₁ →+* C_gal)
        (n : ℕ)
        (v_gal : Module.Basis (Fin n) (Localization.Away b₀) C_gal),
        IsUnit (Algebra.traceMatrix (Localization.Away b₀) ⇑v_gal).det ∧
        j_C₁.comp ((algebraMap (Localization.Away f₁) C₁).comp
          (algebraMap B (Localization.Away f₁))) =
          (algebraMap (Localization.Away b₀) C_gal).comp (algebraMap B (Localization.Away b₀)) :=
by
  
  let B₁ : Type u := Localization.Away f₁
  have hf₁_nzd : Submonoid.powers f₁ ≤ nonZeroDivisors B :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hf₁)
  have : IsDomain B₁ := IsLocalization.isDomain_localization hf₁_nzd
  have hf₁_L_ne : algebraMap B L f₁ ≠ 0 := fun h0 =>
    hf₁ (IsFractionRing.injective B L (h0.trans (map_zero _).symm))
  have hUnit_f₁ : IsUnit (algebraMap B L f₁) := IsUnit.mk0 _ hf₁_L_ne
  let φ₁ : B₁ →+* L := IsLocalization.Away.lift f₁ hUnit_f₁
  letI : Algebra B₁ L := φ₁.toAlgebra
  have hφ₁_eq : ∀ r : B, φ₁ (algebraMap B B₁ r) = algebraMap B L r :=
    IsLocalization.Away.lift_eq f₁ hUnit_f₁
  have : IsScalarTower B B₁ L := IsScalarTower.of_algebraMap_eq fun r => (hφ₁_eq r).symm
  have : IsFractionRing B₁ L :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers f₁) B₁ L

  have hbot_prime : (⊥ : Ideal B₁).IsPrime :=
    ⟨bot_ne_top, fun {a b} hab => by
      rw [Ideal.mem_bot] at hab ⊢
      exact mul_eq_zero.mp hab⟩
  obtain ⟨P₀, hP₀⟩ := hSurj_C₁ ⟨⊥, hbot_prime⟩
  have hP₀_comap : Ideal.comap (algebraMap B₁ C₁) P₀.asIdeal = ⊥ :=
    congrArg PrimeSpectrum.asIdeal hP₀
  have hInj_B₁_C₁ : Function.Injective (algebraMap B₁ C₁) := by
    intro x y hxy
    have hsub : algebraMap B₁ C₁ (x - y) ∈ P₀.asIdeal := by
      rw [map_sub, hxy, sub_self]
      exact P₀.asIdeal.zero_mem
    have hmem : x - y ∈ (⊥ : Ideal B₁) := hP₀_comap ▸ hsub
    exact sub_eq_zero.mp (Ideal.mem_bot.mp hmem)

  let F₁ : Type u := FractionRing C₁
  have hg₁_inj : Function.Injective (algebraMap B₁ F₁) := by
    rw [IsScalarTower.algebraMap_eq B₁ C₁ F₁]
    exact (IsFractionRing.injective C₁ F₁).comp hInj_B₁_C₁
  let ψ_LF₁ : L →+* F₁ := IsFractionRing.lift (K := L) hg₁_inj
  letI : Algebra L F₁ := ψ_LF₁.toAlgebra
  have hψ_LF₁_eq : ∀ r₁ : B₁, algebraMap L F₁ (φ₁ r₁) = algebraMap B₁ F₁ r₁ :=
    fun r₁ => IsFractionRing.lift_algebraMap hg₁_inj r₁
  have : IsScalarTower B₁ L F₁ :=
    ⟨fun r₁ l x => by
      simp only [Algebra.smul_def, map_mul, mul_assoc]
      change algebraMap L F₁ (φ₁ r₁) * (algebraMap L F₁ l * x) =
        algebraMap B₁ F₁ r₁ * (algebraMap L F₁ l * x)
      rw [hψ_LF₁_eq r₁]⟩

  
  have : FiniteDimensional L F₁ := by
    obtain ⟨S, hS_fin, hS_span⟩ := Submodule.fg_def.mp (Module.Finite.fg_top : (⊤ : Submodule B₁ C₁).FG)
    let T₀ : Set F₁ := (algebraMap C₁ F₁) '' S
    have hT₀_fin : T₀.Finite := hS_fin.image (algebraMap C₁ F₁)
    let V₀ : Submodule L F₁ := Submodule.span L T₀
    have : FiniteDimensional L ↥V₀ := FiniteDimensional.span_of_finite L hT₀_fin
    have hC₁_mem : ∀ c : C₁, algebraMap C₁ F₁ c ∈ V₀ := by
      intro c
      have hc_mem : c ∈ Submodule.span B₁ S := hS_span.symm ▸ Submodule.mem_top
      exact @Submodule.span_induction B₁ C₁ _ _ _ S (fun x _ => algebraMap C₁ F₁ x ∈ V₀)
        (fun x hx => Submodule.subset_span ⟨x, hx, rfl⟩)
        (by rw [map_zero]; exact V₀.zero_mem)
        (fun x y _ _ hx hy => by rw [map_add]; exact V₀.add_mem hx hy)
        (fun r₁ x _ hx => by
          rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply B₁ C₁ F₁,
            ← hψ_LF₁_eq r₁, ← Algebra.smul_def]
          exact V₀.smul_mem (φ₁ r₁) hx)
        c hc_mem
    have hMul_mem : ∀ (c : C₁) {v : F₁}, v ∈ V₀ → algebraMap C₁ F₁ c * v ∈ V₀ := by
      intro c v hv
      exact @Submodule.span_induction L F₁ _ _ _ T₀
        (fun x _ => algebraMap C₁ F₁ c * x ∈ V₀)
        (fun x hx => by
          rcases hx with ⟨s, _, rfl⟩
          rw [← map_mul]
          exact hC₁_mem (c * s))
        (by rw [mul_zero]; exact V₀.zero_mem)
        (fun x y _ _ hx hy => by rw [mul_add]; exact V₀.add_mem hx hy)
        (fun l x _ hx => by
          rw [mul_smul_comm]
          exact V₀.smul_mem l hx)
        v hv
    have hV₀_top : V₀ = ⊤ := by
      rw [eq_top_iff]
      intro z _
      obtain ⟨⟨num, den⟩, hzd⟩ := IsLocalization.surj (nonZeroDivisors C₁) z
      have hden_c_ne : (den : C₁) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp den.2
      have hden_ne : algebraMap C₁ F₁ (den : C₁) ≠ 0 := fun h0 =>
        hden_c_ne (IsFractionRing.injective C₁ F₁ (h0.trans (map_zero _).symm))
      let L_den : ↥V₀ →ₗ[L] ↥V₀ :=
        { toFun := fun u => ⟨algebraMap C₁ F₁ (den : C₁) * u.1, hMul_mem (den : C₁) u.2⟩
          map_add' := fun u₁ u₂ => Subtype.ext (mul_add _ u₁.1 u₂.1)
          map_smul' := fun l u => Subtype.ext (mul_smul_comm l _ u.1) }
      have hL_inj : Function.Injective L_den := by
        intro u₁ u₂ hu
        exact Subtype.ext (mul_left_cancel₀ hden_ne (congrArg Subtype.val hu))
      have hL_surj : Function.Surjective L_den :=
        (LinearMap.injective_iff_surjective (f := L_den)).mp hL_inj
      obtain ⟨u, hu⟩ := hL_surj ⟨algebraMap C₁ F₁ num, hC₁_mem num⟩
      have hu_eq : z * algebraMap C₁ F₁ (den : C₁) = u.1 * algebraMap C₁ F₁ (den : C₁) := by
        rw [hzd, mul_comm u.1]
        exact (congrArg Subtype.val hu).symm
      rw [mul_right_cancel₀ hden_ne hu_eq]
      exact u.2
    exact LinearEquiv.finiteDimensional (LinearEquiv.ofTop V₀ hV₀_top)

  have : Algebra.FormallyUnramified C₁ F₁ :=
    Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors C₁)
  have : Algebra.FormallyUnramified B₁ F₁ :=
    Algebra.FormallyUnramified.comp B₁ C₁ F₁
  have : Algebra.FormallyUnramified L F₁ :=
    Algebra.FormallyUnramified.of_restrictScalars B₁ L F₁
  have : Algebra.IsSeparable L F₁ :=
    Algebra.FormallyUnramified.isSeparable L F₁

  
  have : Algebra.IsAlgebraic L F₁ := Algebra.IsAlgebraic.of_finite L F₁
  have : Algebra.IsIntegral L F₁ := Algebra.IsIntegral.of_finite L F₁
  let j_F₁ : F₁ →ₐ[L] AlgebraicClosure L := IsAlgClosed.lift
  obtain ⟨θ, hθ_top⟩ := Field.exists_primitive_element L F₁
  let P : Polynomial L := minpoly L θ
  have hP_ne : P ≠ 0 := minpoly.ne_zero (Algebra.IsIntegral.isIntegral (R := L) θ)
  have hP_sep : P.Separable := Algebra.IsSeparable.isSeparable L θ
  let L₀ : IntermediateField L (AlgebraicClosure L) :=
    IntermediateField.adjoin L (P.rootSet (AlgebraicClosure L))
  let M : Type u := ↥L₀
  have : Polynomial.IsSplittingField L M P :=
    IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)
  have hFD_M : FiniteDimensional L M := Polynomial.IsSplittingField.finiteDimensional M P
  have hGal_M : IsGalois L M := @IsGalois.of_separable_splitting_field L _ M _ _ P _ hP_sep

  have hjθ_mem : j_F₁ θ ∈ L₀ := by
    apply IntermediateField.subset_adjoin
    rw [Polynomial.mem_rootSet]
    refine ⟨hP_ne, ?_⟩
    rw [Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
  have hj_le : IntermediateField.adjoin L ({j_F₁ θ} : Set (AlgebraicClosure L)) ≤ L₀ :=
    (IntermediateField.adjoin_simple_le_iff).mpr hjθ_mem
  have hj_mem : ∀ x : F₁, j_F₁ x ∈ L₀.toSubalgebra := by
    intro x
    change j_F₁ x ∈ L₀
    apply hj_le
    have hx_top : x ∈ IntermediateField.adjoin L ({θ} : Set F₁) := by
      rw [hθ_top]
      trivial
    have hx_map : j_F₁ x ∈ (IntermediateField.adjoin L ({θ} : Set F₁)).map j_F₁ :=
      (IntermediateField.mem_map _).mpr ⟨x, hx_top, rfl⟩
    rwa [IntermediateField.adjoin_map, Set.image_singleton] at hx_map
  let ι_F₁_M : F₁ →ₐ[L] M := j_F₁.codRestrict L₀.toSubalgebra hj_mem
  let ψ₁ : C₁ →+* M := ι_F₁_M.toRingHom.comp (algebraMap C₁ F₁)
  have hψ₁_B₁ : ∀ r₁ : B₁, ψ₁ (algebraMap B₁ C₁ r₁) = algebraMap L M (φ₁ r₁) := by
    intro r₁
    change ι_F₁_M (algebraMap C₁ F₁ (algebraMap B₁ C₁ r₁)) = algebraMap L M (φ₁ r₁)
    rw [← IsScalarTower.algebraMap_apply B₁ C₁ F₁, ← hψ_LF₁_eq r₁, ι_F₁_M.commutes]

  
  letI : Algebra B M := ((algebraMap L M).comp (algebraMap B L)).toAlgebra
  have : IsScalarTower B L M := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Algebra.IsSeparable L M := IsGalois.to_isSeparable
  let C_int : Type u := ↥(integralClosure B M)
  have : IsIntegralClosure C_int B M := integralClosure.isIntegralClosure B M
  have : Module.Finite B C_int := IsIntegralClosure.finite B L M C_int
  obtain ⟨S_int, hSint_fin, hSint_span⟩ :=
    Submodule.fg_def.mp (Module.Finite.fg_top : (⊤ : Submodule B C_int).FG)
  let G_int : Finset C_int := hSint_fin.toFinset

  let n : ℕ := Module.finrank L M
  let w₀ : Module.Basis (Fin n) L M := Module.finBasis L M
  have : Algebra.IsIntegral L M := Algebra.IsIntegral.of_finite L M
  have hd_exists : ∀ i : Fin n, ∃ d : nonZeroDivisors B, IsIntegral B ((d : B) • w₀ i) := by
    intro i
    obtain ⟨d, hd⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      (nonZeroDivisors B) (w₀ i) (Algebra.IsIntegral.isIntegral (R := L) (w₀ i))
    exact ⟨d, hd⟩
  choose d_fn hd_fn using hd_exists
  have hw_unit : ∀ i : Fin n, IsUnit (algebraMap B L (d_fn i : B)) := by
    intro i
    have hd_ne : (d_fn i : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp (d_fn i).2
    refine IsUnit.mk0 _ (fun h0 => hd_ne ?_)
    exact IsFractionRing.injective B L (h0.trans (map_zero _).symm)
  let v : Module.Basis (Fin n) L M := w₀.isUnitSMul hw_unit
  have hv_int : ∀ i : Fin n, IsIntegral B (v i) := by
    intro i
    rw [w₀.isUnitSMul_apply hw_unit i, IsScalarTower.algebraMap_smul L (d_fn i : B) (w₀ i)]
    exact hd_fn i

  let Δ_v : L := (Algebra.traceMatrix L ⇑v).det
  have hΔ_unit : IsUnit Δ_v := by
    dsimp only [Δ_v]
    rw [← Algebra.discr_def L ⇑v]
    exact Algebra.discr_isUnit_of_basis L v
  have hΔ_ne : Δ_v ≠ 0 := hΔ_unit.ne_zero

  have hs₀_exists : ∃ s₀ : nonZeroDivisors B,
      IsLocalization.IsInteger B ((s₀ : B) • Δ_v) ∧
      IsLocalization.IsInteger B ((s₀ : B) • Δ_v⁻¹) ∧
      ∀ g ∈ G_int, ∀ i : Fin n, IsLocalization.IsInteger B ((s₀ : B) • v.repr g.1 i) := by
    classical
    let S_L : Finset L := insert Δ_v (insert Δ_v⁻¹
      (G_int.biUnion fun g => Finset.univ.image fun i : Fin n => v.repr g.1 i))
    obtain ⟨s₀, hs₀⟩ := IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors B) S_L
    refine ⟨s₀, hs₀ Δ_v (by simp [S_L]), hs₀ Δ_v⁻¹ (by simp [S_L]), fun g hg i => hs₀ _ ?_⟩
    simp only [S_L, Finset.mem_insert, Finset.mem_biUnion, Finset.mem_image, Finset.mem_univ,
      true_and]
    right; right
    exact ⟨g, hg, i, rfl⟩
  obtain ⟨s₀, hInt_Δ, hInt_Δ_inv, hInt_coord⟩ := hs₀_exists
  have hs₀_ne : (s₀ : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s₀.2
  let b₀ : B := f₁ * (s₀ : B)
  have hb₀ : b₀ ≠ 0 := mul_ne_zero hf₁ hs₀_ne

  
  let B' : Type u := Localization.Away b₀
  have hb₀_nzd : Submonoid.powers b₀ ≤ nonZeroDivisors B :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hb₀)
  have : IsDomain B' := IsLocalization.isDomain_localization hb₀_nzd
  have hb₀_L_ne : algebraMap B L b₀ ≠ 0 := fun h0 =>
    hb₀ (IsFractionRing.injective B L (h0.trans (map_zero _).symm))
  have hUnit_b₀_L : IsUnit (algebraMap B L b₀) := IsUnit.mk0 _ hb₀_L_ne
  let φ_b₀ : B' →+* L := IsLocalization.Away.lift b₀ hUnit_b₀_L
  have hφ_b₀_eq : ∀ r : B, φ_b₀ (algebraMap B B' r) = algebraMap B L r :=
    IsLocalization.Away.lift_eq b₀ hUnit_b₀_L

  let hAlgBL : Algebra B' L := φ_b₀.toAlgebra
  letI : Algebra B' L := hAlgBL
  let hAlgBM : Algebra B' M := ((algebraMap L M).comp φ_b₀).toAlgebra
  letI : Algebra B' M := hAlgBM
  let C_gal : Type u := ↥(integralClosure B' M)
  let hCR : CommRing C_gal := inferInstance
  let hDom_gal : IsDomain C_gal := inferInstance
  let hFld : Field M := inferInstance
  let hAlgBC : Algebra B' C_gal := inferInstance
  let hAlgLM : Algebra L M := inferInstance
  let hAlgCM : Algebra C_gal M := inferInstance

  have hST_BB'L : IsScalarTower B B' L :=
    IsScalarTower.of_algebraMap_eq fun r => (hφ_b₀_eq r).symm
  have hST_B'LM : IsScalarTower B' L M := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hST_B'CM : IsScalarTower B' C_gal M := inferInstance
  have hFR_B'L : IsFractionRing B' L :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization (Submonoid.powers b₀) B' L
  have hφ_b₀_inj : Function.Injective φ_b₀ := IsFractionRing.injective B' L
  have hFR_CM : IsFractionRing C_gal M :=
    integralClosure.isFractionRing_of_finite_extension (A := B') L M
  have hIC_CM : IsIntegralClosure C_gal B' M := integralClosure.isIntegralClosure B' M
  have : IsScalarTower B B' M := IsScalarTower.of_algebraMap_eq fun r => by
    change algebraMap L M (algebraMap B L r) = algebraMap L M (φ_b₀ (algebraMap B B' r))
    rw [hφ_b₀_eq]

  
  have hb₀_unit_B' : IsUnit (algebraMap B B' b₀) := IsLocalization.Away.algebraMap_isUnit b₀
  have hb₀_mul_B' : IsUnit (algebraMap B B' f₁ * algebraMap B B' (s₀ : B)) := by
    rwa [← map_mul]
  have hs₀_unit_B' : IsUnit (algebraMap B B' (s₀ : B)) :=
    isUnit_of_mul_isUnit_right hb₀_mul_B'
  have hf₁_unit_B' : IsUnit (algebraMap B B' f₁) :=
    isUnit_of_mul_isUnit_left hb₀_mul_B'
  obtain ⟨u_s₀, hu_s₀⟩ := hs₀_unit_B'
  have hs₀_L_ne : algebraMap B L (s₀ : B) ≠ 0 := fun h0 =>
    hs₀_ne (IsFractionRing.injective B L (h0.trans (map_zero _).symm))
  have hLift_int : ∀ y : L, IsLocalization.IsInteger B ((s₀ : B) • y) → ∃ c : B', φ_b₀ c = y := by
    intro y ⟨r_y, hr_y⟩
    refine ⟨algebraMap B B' r_y * ↑(u_s₀⁻¹), ?_⟩
    apply mul_left_cancel₀ hs₀_L_ne
    calc
      algebraMap B L (s₀ : B) * φ_b₀ (algebraMap B B' r_y * ↑(u_s₀⁻¹))
          = φ_b₀ (algebraMap B B' (s₀ : B)) * (φ_b₀ (algebraMap B B' r_y) * φ_b₀ ↑(u_s₀⁻¹)) := by
              rw [hφ_b₀_eq, map_mul]
      _ = φ_b₀ (algebraMap B B' r_y) * φ_b₀ ((u_s₀ : B') * ↑(u_s₀⁻¹)) := by
              rw [← hu_s₀, map_mul]
              ring
      _ = algebraMap B L r_y := by
              rw [Units.mul_inv, map_one, mul_one, hφ_b₀_eq]
      _ = algebraMap B L (s₀ : B) * y := by
              rwa [Algebra.smul_def] at hr_y

  
  let v_gal_fn : Fin n → C_gal := fun i => ⟨v i, IsIntegral.tower_top (A := B') (hv_int i)⟩
  have hLinInd_gal : LinearIndependent B' v_gal_fn := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hc_M : ∑ i : Fin n, (φ_b₀ (c i)) • v i = 0 := by
      have hc_val : (∑ i : Fin n, c i • v_gal_fn i).1 = 0 := congrArg Subtype.val hc
      rw [AddSubmonoidClass.coe_finsetSum] at hc_val
      convert hc_val using 1
      apply Finset.sum_congr rfl
      intro i _
      change (algebraMap B' L) (c i) • v i = c i • v i
      exact IsScalarTower.algebraMap_smul L (c i) (v i)
    intro i
    have h0 : φ_b₀ (c i) = 0 :=
      (Fintype.linearIndependent_iff.mp v.linearIndependent) (fun j => φ_b₀ (c j)) hc_M i
    exact hφ_b₀_inj (h0.trans (map_zero φ_b₀).symm)

  have hSpan_gal : ⊤ ≤ Submodule.span B' (Set.range v_gal_fn) := by
    let W : Submodule B' C_gal := Submodule.span B' (Set.range v_gal_fn)
    have hG_mem : ∀ g ∈ G_int, (⟨g.1, IsIntegral.tower_top (A := B') g.2⟩ : C_gal) ∈ W := by
      intro g hg
      have hcoord : ∀ i : Fin n, ∃ c : B', φ_b₀ c = v.repr g.1 i :=
        fun i => hLift_int (v.repr g.1 i) (hInt_coord g hg i)
      choose c_fn hc_fn using hcoord
      have hg_eq : (⟨g.1, IsIntegral.tower_top (A := B') g.2⟩ : C_gal) =
          ∑ i : Fin n, c_fn i • v_gal_fn i := by
        apply Subtype.ext
        rw [AddSubmonoidClass.coe_finsetSum]
        conv_lhs => rw [← v.sum_repr g.1]
        apply Finset.sum_congr rfl
        intro i _
        change v.repr g.1 i • v i = c_fn i • v i
        rw [← hc_fn i]
        change (algebraMap B' L) (c_fn i) • v i = c_fn i • v i
        exact IsScalarTower.algebraMap_smul L (c_fn i) (v i)
      rw [hg_eq]
      exact Submodule.sum_mem W fun i _ => W.smul_mem (c_fn i) (Submodule.subset_span ⟨i, rfl⟩)
    have hCint_mem : ∀ y : C_int, (⟨y.1, IsIntegral.tower_top (A := B') y.2⟩ : C_gal) ∈ W := by
      intro y
      have hy_mem : y ∈ Submodule.span B (G_int : Set C_int) := by
        rw [hSint_fin.coe_toFinset, hSint_span]
        exact Submodule.mem_top
      exact @Submodule.span_induction B C_int _ _ _ (G_int : Set C_int)
        (fun z _ => (⟨z.1, IsIntegral.tower_top (A := B') z.2⟩ : C_gal) ∈ W)
        (fun z hz => hG_mem z (Finset.mem_coe.mp hz))
        (W.zero_mem)
        (fun z₁ z₂ _ _ hz₁ hz₂ => W.add_mem hz₁ hz₂)
        (fun r z _ hz => by
          have hsmul_eq : (⟨(r • z).1, IsIntegral.tower_top (A := B') (r • z).2⟩ : C_gal) =
              (algebraMap B B' r) • (⟨z.1, IsIntegral.tower_top (A := B') z.2⟩ : C_gal) := by
            apply Subtype.ext
            change r • z.1 = (algebraMap B B' r) • z.1
            rw [Algebra.smul_def, Algebra.smul_def]
            change algebraMap L M (algebraMap B L r) * z.1 =
              algebraMap L M (φ_b₀ (algebraMap B B' r)) * z.1
            rw [hφ_b₀_eq]
          rw [hsmul_eq]
          exact W.smul_mem (algebraMap B B' r) hz)
        y hy_mem
    intro x _
    obtain ⟨m, hm_int⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      (Submonoid.powers b₀) x.1 x.2
    obtain ⟨k, hk⟩ := m.2
    have hm_unit : IsUnit (algebraMap B B' (m : B)) := by
      rw [← hk, map_pow]
      exact hb₀_unit_B'.pow k
    obtain ⟨u_m, hu_m⟩ := hm_unit
    let y_m : C_int := ⟨(m : B) • x.1, hm_int⟩
    have hy_m_W : (⟨y_m.1, IsIntegral.tower_top (A := B') y_m.2⟩ : C_gal) ∈ W := hCint_mem y_m
    have hx_eq : x = (↑(u_m⁻¹) : B') • (⟨y_m.1, IsIntegral.tower_top (A := B') y_m.2⟩ : C_gal) := by
      apply Subtype.ext
      have hym_eq : y_m.1 = (algebraMap B B' (m : B)) • x.1 := by
        change (m : B) • x.1 = (algebraMap B B' (m : B)) • x.1
        rw [Algebra.smul_def, Algebra.smul_def]
        change algebraMap L M (algebraMap B L (m : B)) * x.1 =
          algebraMap L M (φ_b₀ (algebraMap B B' (m : B))) * x.1
        rw [hφ_b₀_eq]
      change x.1 = (↑(u_m⁻¹) : B') • y_m.1
      rw [hym_eq, ← hu_m, Algebra.smul_def, Algebra.smul_def, ← mul_assoc, ← map_mul,
        Units.inv_mul, map_one, one_mul]
    rw [hx_eq]
    exact W.smul_mem (↑(u_m⁻¹) : B') hy_m_W

  let v_gal : Module.Basis (Fin n) B' C_gal := Module.Basis.mk hLinInd_gal hSpan_gal
  have hv_gal_apply : ∀ i : Fin n, (v_gal i).1 = v i := by
    intro i
    rw [Module.Basis.mk_apply]

  
  have hRepr_compat : ∀ (z : C_gal) (k : Fin n), φ_b₀ (v_gal.repr z k) = v.repr z.1 k := by
    intro z k
    have hz_sum : z.1 = ∑ r : Fin n, (φ_b₀ (v_gal.repr z r)) • v r := by
      conv_lhs => rw [← v_gal.sum_repr z]
      rw [AddSubmonoidClass.coe_finsetSum]
      apply Finset.sum_congr rfl
      intro r _
      change (v_gal.repr z r) • (v_gal r).1 = (algebraMap B' L) (v_gal.repr z r) • v r
      rw [hv_gal_apply r]
      exact (IsScalarTower.algebraMap_smul L (v_gal.repr z r) (v r)).symm
    have hrepr := congrArg (fun m : M => v.repr m k) hz_sum
    rw [map_sum] at hrepr
    simp_rw [LinearEquiv.map_smul, v.repr_self] at hrepr
    rw [Finsupp.finsetSum_apply] at hrepr
    simp only [Finsupp.coe_smul, Pi.smul_apply, Finsupp.single_apply, smul_eq_mul, mul_boole,
      Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at hrepr
    exact hrepr.symm

  have hTrace_compat : ∀ x : C_gal, φ_b₀ (Algebra.trace B' C_gal x) = Algebra.trace L M x.1 := by
    intro x
    rw [Algebra.trace_eq_matrix_trace v_gal x, Algebra.trace_eq_matrix_trace v x.1]
    simp only [Matrix.trace, Matrix.diag_apply, map_sum, Algebra.leftMulMatrix_eq_repr_mul]
    apply Finset.sum_congr rfl
    intro k _
    rw [hRepr_compat (x * v_gal k) k]
    change (v.repr (x.1 * (v_gal k).1)) k = (v.repr (x.1 * v k)) k
    rw [hv_gal_apply k]

  have hTraceMat_map :
      φ_b₀.mapMatrix (Algebra.traceMatrix B' ⇑v_gal) = Algebra.traceMatrix L ⇑v := by
    ext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, Algebra.traceMatrix_apply,
      Algebra.traceForm_apply, Algebra.traceMatrix_apply, Algebra.traceForm_apply,
      hTrace_compat (v_gal i * v_gal j)]
    change Algebra.trace L M ((v_gal i).1 * (v_gal j).1) = Algebra.trace L M (v i * v j)
    rw [hv_gal_apply i, hv_gal_apply j]

  have hDet_map : φ_b₀ (Algebra.traceMatrix B' ⇑v_gal).det = Δ_v := by
    rw [RingHom.map_det, hTraceMat_map]

  obtain ⟨d₁, hd₁⟩ := hLift_int Δ_v hInt_Δ
  obtain ⟨d₂, hd₂⟩ := hLift_int Δ_v⁻¹ hInt_Δ_inv
  have hDet_eq_d₁ : (Algebra.traceMatrix B' ⇑v_gal).det = d₁ :=
    hφ_b₀_inj (hDet_map.trans hd₁.symm)
  have hd₁₂ : d₁ * d₂ = 1 := by
    apply hφ_b₀_inj
    rw [map_mul, map_one, hd₁, hd₂, mul_inv_cancel₀ hΔ_ne]
  have hDet_unit : IsUnit (Algebra.traceMatrix B' ⇑v_gal).det := by
    rw [hDet_eq_d₁]
    exact ⟨⟨d₁, d₂, hd₁₂, mul_comm d₁ d₂ ▸ hd₁₂⟩, rfl⟩

  
  let ι_10 : B₁ →+* B' := IsLocalization.Away.lift f₁ hf₁_unit_B'
  have hι_10_B : ∀ b : B, ι_10 (algebraMap B B₁ b) = algebraMap B B' b :=
    IsLocalization.Away.lift_eq f₁ hf₁_unit_B'
  have hφ_comp_ι : φ_b₀.comp ι_10 = φ₁ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers f₁)
    ext b
    simp only [RingHom.comp_apply, hι_10_B, hφ_b₀_eq, hφ₁_eq]
  have hψ₁_ι : ∀ r₁ : B₁, ψ₁ (algebraMap B₁ C₁ r₁) = algebraMap B' M (ι_10 r₁) := by
    intro r₁
    rw [hψ₁_B₁ r₁]
    have hcomp_r₁ : φ_b₀ (ι_10 r₁) = φ₁ r₁ := RingHom.congr_fun hφ_comp_ι r₁
    rw [← hcomp_r₁]
    rfl

  have hψ₁_int : ∀ c : C₁, ψ₁ c ∈ integralClosure B' M := by
    intro c
    rw [mem_integralClosure_iff]
    obtain ⟨Q, hQ_mon, hQ_ev⟩ := Algebra.IsIntegral.isIntegral (R := B₁) c
    refine ⟨Q.map ι_10, hQ_mon.map ι_10, ?_⟩
    rw [Polynomial.eval₂_map]
    have hhom_eq : (algebraMap B' M).comp ι_10 = ψ₁.comp (algebraMap B₁ C₁) := by
      apply RingHom.ext
      intro r₁
      exact (hψ₁_ι r₁).symm
    rw [hhom_eq, ← Polynomial.hom_eval₂, hQ_ev, map_zero]

  let j_C₁ : C₁ →+* C_gal :=
    { toFun := fun c => ⟨ψ₁ c, hψ₁_int c⟩
      map_one' := Subtype.ext ψ₁.map_one
      map_mul' := fun x y => Subtype.ext (ψ₁.map_mul x y)
      map_zero' := Subtype.ext ψ₁.map_zero
      map_add' := fun x y => Subtype.ext (ψ₁.map_add x y) }
  have hj_comp : j_C₁.comp ((algebraMap B₁ C₁).comp (algebraMap B B₁)) =
      (algebraMap B' C_gal).comp (algebraMap B B') := by
    apply RingHom.ext
    intro b
    apply Subtype.ext
    change ψ₁ (algebraMap B₁ C₁ (algebraMap B B₁ b)) =
      (algebraMap B' C_gal (algebraMap B B' b)).1
    rw [hψ₁_ι (algebraMap B B₁ b), hι_10_B b]
    rfl

  exact ⟨b₀, hb₀, C_gal, M, hCR, hDom_gal, hFld, hAlgBL, hAlgBC, hAlgLM, hAlgCM, hAlgBM,
    hST_BB'L, hST_B'LM, hST_B'CM, hFR_B'L, hFR_CM, hIC_CM, hFD_M, hGal_M,
    j_C₁, n, v_gal, hDet_unit, hj_comp⟩

theorem weil_net_p2_proper_bc_geom_fiber_deck_triv (k : Type u) [Field k] [IsAlgClosed k]
    (d_rel ℓ r' : ℕ) [Fact (Nat.Prime ℓ)] (hℓ_k : (ℓ : k) ≠ 0)
    (Z_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f_bar : Z_bar ⟶ weilProjectiveSpaceOver k 1)
    [AlgebraicGeometry.IsProper f_bar.left]
    (V_gal : AlgebraicGeometry.Scheme.{u}) [Nonempty ↥V_gal] [PreconnectedSpace ↥V_gal]
    (h_gal : V_gal ⟶ (weilProjectiveSpaceOver k 1).left)
    (hh_gal : AlgebraicGeometry.Etale h_gal)
    (A₀ : AddCommGrpCat.{u})
    (hPB_gal : WeilIsEtaleSheafPullback h_gal
      (weilEtaleHigherDirectImage f_bar.left d_rel
        (weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r' + 1))))
      ((CategoryTheory.constantSheaf V_gal.smallEtaleTopology AddCommGrpCat.{u}).obj A₀))
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (w_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ V_gal)
    (η_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (weilProjectiveSpaceOver k 1).left)
    (hw_η : w_Ω ≫ h_gal = η_bar)
    (u : V_gal ⟶ V_gal) (hu_h : u ≫ h_gal = h_gal)
    (τ : Ω ≃+* Ω)
    (hτ_w : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) ≫ w_Ω = w_Ω ≫ u)
    (hFibTriv : ∀ (α_τ_bar : CategoryTheory.Limits.pullback f_bar.left η_bar ⟶
          CategoryTheory.Limits.pullback f_bar.left η_bar),
        α_τ_bar ≫ CategoryTheory.Limits.pullback.fst f_bar.left η_bar =
          CategoryTheory.Limits.pullback.fst f_bar.left η_bar →
        α_τ_bar ≫ CategoryTheory.Limits.pullback.snd f_bar.left η_bar =
          CategoryTheory.Limits.pullback.snd f_bar.left η_bar ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ.toRingHom) →
        ∀ (p_τ_bar : weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left η_bar)
              (ℓ ^ (r' + 1)) d_rel →+
            weilEtaleTorsionH (CategoryTheory.Limits.pullback f_bar.left η_bar)
              (ℓ ^ (r' + 1)) d_rel),
          WeilIsTorsionEtalePullback α_τ_bar (ℓ ^ (r' + 1)) d_rel p_τ_bar →
          ∀ v, p_τ_bar v = v) :
    let ℛ_P := weilEtaleHigherDirectImage f_bar.left d_rel
      (weilEtaleTorsionSheaf Z_bar.left (ℓ ^ (r' + 1)))
    let E_P : (weilProjectiveSpaceOver k 1).left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ h_gal hh_gal
    ∀ (ū_P : E_P ⟶ E_P),
      ((AlgebraicGeometry.Scheme.Etale.forget (weilProjectiveSpaceOver k 1).left).map ū_P).left = u →
      ∀ x : ↑(ℛ_P.obj.obj (Opposite.op E_P)),
        (ℛ_P.obj.map (Opposite.op ū_P)).hom x = x :=
by
  intro ℛ_P E_P ū_P hū x
