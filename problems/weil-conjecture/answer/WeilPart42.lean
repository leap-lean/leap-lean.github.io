            apply Subtype.ext
            change ((γ (⟨(x : Ω₁), mem_sup_left' x.2⟩ + ⟨(y : Ω₁), mem_sup_left' y.2⟩) : ↥M) : Ω₁) = _
            rw [map_add]
            rfl
