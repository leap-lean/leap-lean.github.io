    rw [hΔ_k]
    exact Polynomial.monic_prod_of_monic _ _ fun s_k _ => Polynomial.monic_X_sub_C s_k
  have hS_eq : S_aff_k = S_aff.map ⟨algebraMap F k, (algebraMap F k).injective⟩ := by
    ext x
    rw [hS_aff_k, Finset.mem_map]
    rfl
  have hΔ_map : Δ_k = Δ_F.map (algebraMap F k) := by
    rw [hΔ_k, hS_eq, Finset.prod_map, hΔ_F, Polynomial.map_prod]
    refine Finset.prod_congr rfl fun s _ => ?_
    simp [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  have hφ0 : (φ_K₂ 0).toRingHom = algebraMap (MvPolynomial (Fin 2) k) K₂ := by
    apply MvPolynomial.ringHom_ext
    · intro c
      change (φ_K₂ 0) (MvPolynomial.C c) = algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.C c)
      rw [MvPolynomial.aeval_C, IsScalarTower.algebraMap_apply k (MvPolynomial (Fin 2) k) K₂]
      rfl
    · intro j
      change (φ_K₂ 0) (MvPolynomial.X j) = algebraMap (MvPolynomial (Fin 2) k) K₂ (MvPolynomial.X j)
      rw [MvPolynomial.aeval_X]
      fin_cases j <;> simp [homCoord, x₁, x₂]
  obtain ⟨d_Sigma, d_disc, H_Sigma, F_disc_hom, P₀, P₁, P₂, Y₂_k, hProp_Y₂k, g₂_k,
    hProp_g₂k, hSurj_g₂k, π_Y₂, π_P2, j_chart, U₂_sm_k, hSm_g₂k,
    hGeomC, hCharts, ⟨hPb_Y₂, hDP0_align⟩, hSliceOdp⟩ :=
    weil_net_p2_shifted_coords_and_transversality F m Z₁ P j_aff s_inf S_aff U₀ C_disc ι_disc
