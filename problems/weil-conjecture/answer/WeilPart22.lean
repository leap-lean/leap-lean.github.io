        obtain ⟨m, hm_max, hq_le_m⟩ := Ideal.exists_le_maximal q hq_prime.ne_top
        have hq_lt_m : q < m := lt_of_le_of_ne hq_le_m (fun h_eq => hq_not_max (h_eq ▸ hm_max))
        have hbot_lt_q : (⊥ : Ideal A) < q := bot_lt_iff_ne_bot.mpr hq_ne_bot
