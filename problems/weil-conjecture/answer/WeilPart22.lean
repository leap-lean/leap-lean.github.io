      let R_Vx : Type u := ↑(V_x.toScheme.presheaf.obj (Opposite.op ⊤))
      let R_Wx : Type u := ↑(((Fgt₂.obj V_obj).left).presheaf.obj (Opposite.op ⊤))
      let S_Vx : Type u := ↑(U_chart.toScheme.presheaf.obj (Opposite.op ⊤))
      let S_Bx : Type u := ↑(((Fgt₁.obj (B.obj V_obj)).left).presheaf.obj (Opposite.op ⊤))
