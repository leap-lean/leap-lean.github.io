  have hRange_of_isPullback :
      ∀ {P_pb X_pb Y_pb B_pb : AlgebraicGeometry.Scheme.{u}}
        {m_pb : P_pb ⟶ X_pb} {p₁_pb : P_pb ⟶ Y_pb}
        {p₂_pb : X_pb ⟶ B_pb} {v_pb : Y_pb ⟶ B_pb},
        CategoryTheory.IsPullback m_pb p₁_pb p₂_pb v_pb →
        Set.range m_pb.base = p₂_pb.base ⁻¹' Set.range v_pb.base := by
    intro P_pb X_pb Y_pb B_pb m_pb p₁_pb p₂_pb v_pb hPB
    let e_pb := hPB.isoPullback
    have hfac : e_pb.hom ≫ CategoryTheory.Limits.pullback.fst p₂_pb v_pb = m_pb :=
      hPB.isoPullback_hom_fst
    have hSurj : Function.Surjective e_pb.hom.base := by
      intro w
      refine ⟨e_pb.inv.base w, ?_⟩
      change (e_pb.inv ≫ e_pb.hom).base w = w
      rw [e_pb.inv_hom_id]
      rfl
    calc
      Set.range m_pb.base
        = Set.range (e_pb.hom ≫ CategoryTheory.Limits.pullback.fst p₂_pb v_pb).base := by
            rw [hfac]
      _ = Set.range ((CategoryTheory.Limits.pullback.fst p₂_pb v_pb).base ∘ e_pb.hom.base) := rfl
      _ = Set.range (CategoryTheory.Limits.pullback.fst p₂_pb v_pb).base :=
            hSurj.range_comp _
      _ = p₂_pb.base ⁻¹' Set.range v_pb.base :=
            AlgebraicGeometry.Scheme.Pullback.range_fst p₂_pb v_pb

  have hPB_map_left :
      ∀ {X' X Y B : AlgebraicGeometry.Scheme.{u}}
        (f' : X' ⟶ B) (f : X ⟶ B) (g : Y ⟶ B) (u : X' ⟶ X) (hu : u ≫ f = f'),
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.map f' g f g u (𝟙 Y) (𝟙 B)
            (by rw [hu, CategoryTheory.Category.comp_id])
            (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]))
          (CategoryTheory.Limits.pullback.fst f' g)
          (CategoryTheory.Limits.pullback.fst f g)
          u := by
    intro X' X Y B f' f g u hu
    let m_map := CategoryTheory.Limits.pullback.map f' g f g u (𝟙 Y) (𝟙 B)
      (by rw [hu, CategoryTheory.Category.comp_id])
      (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    have hRight : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.snd f g)
        (CategoryTheory.Limits.pullback.fst f g) g f :=
      (CategoryTheory.IsPullback.of_hasPullback f g).flip
    have hTop : m_map ≫ CategoryTheory.Limits.pullback.snd f g =
        CategoryTheory.Limits.pullback.snd f' g := by
      dsimp [m_map, CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
    have hBot : m_map ≫ CategoryTheory.Limits.pullback.fst f g =
        CategoryTheory.Limits.pullback.fst f' g ≫ u :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hOuter : CategoryTheory.IsPullback
        (m_map ≫ CategoryTheory.Limits.pullback.snd f g)
        (CategoryTheory.Limits.pullback.fst f' g) g (u ≫ f) := by
      rw [hTop, hu]
      exact (CategoryTheory.IsPullback.of_hasPullback f' g).flip
    exact CategoryTheory.IsPullback.of_right hOuter hBot hRight

  have hPB_map_right :
      ∀ {X Y' Y B : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ B) (g' : Y' ⟶ B) (g : Y ⟶ B) (v : Y' ⟶ Y) (hv : v ≫ g = g'),
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.map f g' f g (𝟙 X) v (𝟙 B)
            (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
            (by rw [hv, CategoryTheory.Category.comp_id]))
          (CategoryTheory.Limits.pullback.snd f g')
          (CategoryTheory.Limits.pullback.snd f g)
          v := by
    intro X Y' Y B f g' g v hv
    let m_map := CategoryTheory.Limits.pullback.map f g' f g (𝟙 X) v (𝟙 B)
      (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      (by rw [hv, CategoryTheory.Category.comp_id])
    have hRight : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f g)
        (CategoryTheory.Limits.pullback.snd f g) f g :=
      CategoryTheory.IsPullback.of_hasPullback f g
    have hTop : m_map ≫ CategoryTheory.Limits.pullback.fst f g =
        CategoryTheory.Limits.pullback.fst f g' := by
      dsimp [m_map, CategoryTheory.Limits.pullback.map]
      rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
    have hBot : m_map ≫ CategoryTheory.Limits.pullback.snd f g =
        CategoryTheory.Limits.pullback.snd f g' ≫ v :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOuter : CategoryTheory.IsPullback
        (m_map ≫ CategoryTheory.Limits.pullback.fst f g)
        (CategoryTheory.Limits.pullback.snd f g') f (v ≫ g) := by
      rw [hTop, hv]
      exact CategoryTheory.IsPullback.of_hasPullback f g'
    exact CategoryTheory.IsPullback.of_right hOuter hBot hRight

  have hPB_section_right :
      ∀ {X Y B : AlgebraicGeometry.Scheme.{u}}
        (f : X ⟶ B) (g : Y ⟶ B) (s_sec : B ⟶ Y) (hs : s_sec ≫ g = 𝟙 B),
        CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.lift (𝟙 X) (f ≫ s_sec)
            (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs,
              CategoryTheory.Category.comp_id]))
          f
          (CategoryTheory.Limits.pullback.snd f g)
          s_sec := by
    intro X Y B f g s_sec hs
    let i_sec := CategoryTheory.Limits.pullback.lift (𝟙 X) (f ≫ s_sec)
      (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs,
        CategoryTheory.Category.comp_id])
    have hRight : CategoryTheory.IsPullback
        (CategoryTheory.Limits.pullback.fst f g)
        (CategoryTheory.Limits.pullback.snd f g) f g :=
      CategoryTheory.IsPullback.of_hasPullback f g
    have hTop : i_sec ≫ CategoryTheory.Limits.pullback.fst f g = 𝟙 X :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hBot : i_sec ≫ CategoryTheory.Limits.pullback.snd f g = f ≫ s_sec :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hOuter : CategoryTheory.IsPullback
        (i_sec ≫ CategoryTheory.Limits.pullback.fst f g)
        f f (s_sec ≫ g) := by
      rw [hTop, hs]
      exact CategoryTheory.IsPullback.of_horiz_isIso
        ⟨by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
    exact CategoryTheory.IsPullback.of_right hOuter hBot hRight

  haveI : AlgebraicGeometry.IsProper P1.hom := hCoord.1
  haveI : AlgebraicGeometry.IsOpenImmersion ι_P1 := hCoord.2.2.2.2.1
  have hιP1_over : ι_P1 ≫ P1.hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) :=
    hCoord.2.2.2.2.2.1
  obtain ⟨s_inf, _, hs_over, hDisj_inf, hUniv_inf, _⟩ := hCoord.2.2.2.2.2.2.1
  haveI : AlgebraicGeometry.IsClosedImmersion s_inf := by
    haveI : AlgebraicGeometry.IsClosedImmersion (s_inf ≫ P1.hom) := by
      rw [hs_over]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp s_inf P1.hom
  have hCompl_sinf : (Set.range s_inf.base)ᶜ = Set.range ι_P1.base := by
    ext x
    constructor
    · intro hx
      have hu : x ∈ Set.range ι_P1.base ∪ Set.range s_inf.base := by
        rw [hUniv_inf]
        trivial
      rcases hu with h1 | h2
      · exact h1
      · exact False.elim (hx h2)
    · intro hx h_in_s
      exact Set.disjoint_left.mp hDisj_inf hx h_in_s

  let coordProj : ∀ d : ℕ, Fin d → ((Pd d).left ⟶ P1.left) :=
    Nat.rec Fin.elim0 (fun d prev =>
      Fin.lastCases
        (CategoryTheory.Limits.pullback.snd (Pd d).hom P1.hom)
        (fun j => CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom ≫ prev j))

  let O_coord : ∀ d : ℕ, Fin d → (Pd d).left.Opens :=
    fun d j => (TopologicalSpace.Opens.map (coordProj d j).base).obj ι_P1.opensRange

  have hO_coord_coe : ∀ (d : ℕ) (j : Fin d),
      (O_coord d j : Set ↥(Pd d).left) = (coordProj d j).base ⁻¹' Set.range ι_P1.base :=
    fun _ _ => rfl

  have hHyper_pkg : ∀ (m : ℕ) (j : Fin (m + 1)),
      ∃ i_Hj : (Pd m).left ⟶ (Pd (m + 1)).left,
        i_Hj ≫ (Pd (m + 1)).hom = (Pd m).hom ∧
        AlgebraicGeometry.IsClosedImmersion i_Hj ∧
        Set.range i_Hj.base = (O_coord (m + 1) j : Set ↥(Pd (m + 1)).left)ᶜ := by
    have hLast_step : ∀ m : ℕ,
        ∃ i_last : (Pd m).left ⟶ (Pd (m + 1)).left,
          i_last ≫ (Pd (m + 1)).hom = (Pd m).hom ∧
          AlgebraicGeometry.IsClosedImmersion i_last ∧
          Set.range i_last.base =
            (O_coord (m + 1) (Fin.last m) : Set ↥(Pd (m + 1)).left)ᶜ := by
      intro m
      let i_last : (Pd m).left ⟶ (Pd (m + 1)).left :=
        CategoryTheory.Limits.pullback.lift (𝟙 (Pd m).left) ((Pd m).hom ≫ s_inf)
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hs_over,
            CategoryTheory.Category.comp_id])
      have hPB_last : CategoryTheory.IsPullback i_last (Pd m).hom
          (CategoryTheory.Limits.pullback.snd (Pd m).hom P1.hom) s_inf :=
        hPB_section_right (Pd m).hom P1.hom s_inf hs_over
      have hCl_last : AlgebraicGeometry.IsClosedImmersion i_last :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hPB_last.flip inferInstance
      have hOver_last : i_last ≫ (Pd (m + 1)).hom = (Pd m).hom :=
        (CategoryTheory.Category.assoc i_last
          (CategoryTheory.Limits.pullback.fst (Pd m).hom P1.hom) (Pd m).hom).symm.trans
          ((congrArg (· ≫ (Pd m).hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            (CategoryTheory.Category.id_comp (Pd m).hom))
      have hproj_last : coordProj (m + 1) (Fin.last m) =
          CategoryTheory.Limits.pullback.snd (Pd m).hom P1.hom :=
        Fin.lastCases_last
      have hRange_last :
          Set.range i_last.base =
            (O_coord (m + 1) (Fin.last m) : Set ↥(Pd (m + 1)).left)ᶜ :=
        (hRange_of_isPullback hPB_last).trans
          ((congrArg (fun s => (CategoryTheory.Limits.pullback.snd (Pd m).hom P1.hom).base ⁻¹' s)
              (compl_compl (Set.range s_inf.base)).symm).trans
            ((congrArg
                (fun s => ((CategoryTheory.Limits.pullback.snd (Pd m).hom P1.hom).base ⁻¹' s)ᶜ)
                hCompl_sinf).trans
              (congrArg (fun f : (Pd (m + 1)).left ⟶ P1.left =>
                  (f.base ⁻¹' Set.range ι_P1.base)ᶜ)
                hproj_last.symm)))
      exact ⟨i_last, hOver_last, hCl_last, hRange_last⟩
    intro m
    induction m with
    | zero =>
      intro j
      have hj : j = Fin.last 0 := Fin.ext (by omega)
      rw [hj]
      exact hLast_step 0
    | succ m' ih =>
      refine Fin.lastCases (hLast_step (m' + 1)) (fun j' => ?_)
      obtain ⟨f', hf'_over, hf'_cl, hf'_range⟩ := ih j'
      letI : AlgebraicGeometry.IsClosedImmersion f' := hf'_cl
      let i_cast : (Pd (m' + 1)).left ⟶ (Pd (m' + 2)).left :=
        CategoryTheory.Limits.pullback.map (Pd m').hom P1.hom (Pd (m' + 1)).hom P1.hom
          f' (𝟙 P1.left) (𝟙 S_k)
          (by rw [hf'_over, CategoryTheory.Category.comp_id])
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      have hPB_cast : CategoryTheory.IsPullback i_cast
          (CategoryTheory.Limits.pullback.fst (Pd m').hom P1.hom)
          (CategoryTheory.Limits.pullback.fst (Pd (m' + 1)).hom P1.hom)
          f' :=
        hPB_map_left (Pd m').hom (Pd (m' + 1)).hom P1.hom f' hf'_over
      have hCl_cast : AlgebraicGeometry.IsClosedImmersion i_cast :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          hPB_cast.flip inferInstance
      have hOver_cast : i_cast ≫ (Pd (m' + 2)).hom = (Pd (m' + 1)).hom :=
        (CategoryTheory.Category.assoc i_cast
          (CategoryTheory.Limits.pullback.fst (Pd (m' + 1)).hom P1.hom)
          (Pd (m' + 1)).hom).symm.trans
          ((congrArg (· ≫ (Pd (m' + 1)).hom)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc _ _ _).trans
              (congrArg (CategoryTheory.Limits.pullback.fst (Pd m').hom P1.hom ≫ ·) hf'_over)))
      have hproj_cast : coordProj (m' + 2) (Fin.castSucc j') =
          CategoryTheory.Limits.pullback.fst (Pd (m' + 1)).hom P1.hom ≫
            coordProj (m' + 1) j' :=
        Fin.lastCases_castSucc j'
      have hRange_cast :
          Set.range i_cast.base =
            (O_coord (m' + 2) (Fin.castSucc j') : Set ↥(Pd (m' + 2)).left)ᶜ :=
        (hRange_of_isPullback hPB_cast).trans
          ((congrArg
              (fun s => (CategoryTheory.Limits.pullback.fst (Pd (m' + 1)).hom P1.hom).base ⁻¹' s)
              hf'_range).trans
            (congrArg (fun f : (Pd (m' + 2)).left ⟶ P1.left =>
                (f.base ⁻¹' Set.range ι_P1.base)ᶜ)
              hproj_cast.symm))
      exact ⟨i_cast, hOver_cast, hCl_cast, hRange_cast⟩

  have hRange_aff_inter : ∀ (d : ℕ) (z : ↥(Pd d).left),
      z ∈ Set.range (ι_aff d).base ↔ ∀ j : Fin d, z ∈ O_coord d j := by
    intro d
    induction d with
    | zero =>
      intro z
      rw [hRange_aff0]
      exact ⟨fun _ j => Fin.elim0 j, fun _ => trivial⟩
    | succ d ih =>
      let f_Ad : (Ad d).left ⟶ S_k :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (MvPolynomial (Fin d) k)))
      let f_A1 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ S_k :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))
      have hf_Ad : f_Ad = (Ad d).hom := rfl
      have hf_A1 : ι_P1 ≫ P1.hom = f_A1 := hιP1_over
      let f_alg : TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k) →ₐ[k]
          MvPolynomial (Fin (d + 1)) k :=
        Algebra.TensorProduct.lift
          (MvPolynomial.rename Fin.castSucc)
          (Polynomial.aeval (MvPolynomial.X (Fin.last d)))
          (fun _ _ => Commute.all _ _)
      let g_alg : MvPolynomial (Fin (d + 1)) k →ₐ[k]
          TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k) :=
        MvPolynomial.aeval
          (Fin.lastCases ((1 : MvPolynomial (Fin d) k) ⊗ₜ[k] Polynomial.X)
            (fun i => MvPolynomial.X i ⊗ₜ[k] (1 : Polynomial k)))
      have hfg : f_alg.comp g_alg = AlgHom.id k (MvPolynomial (Fin (d + 1)) k) := by
        apply MvPolynomial.algHom_ext
        intro j
        refine Fin.lastCases ?_ ?_ j
        · simp [f_alg, g_alg]
        · intro i; simp [f_alg, g_alg]
      have hgf : g_alg.comp f_alg =
          AlgHom.id k (TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k)) := by
        apply Algebra.TensorProduct.ext
        · apply MvPolynomial.algHom_ext
          intro i; simp [f_alg, g_alg]
        · apply Polynomial.algHom_ext
          simp [f_alg, g_alg]
      let e_ring : CommRingCat.of (TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k)) ≅
          CommRingCat.of (MvPolynomial (Fin (d + 1)) k) :=
        { hom := CommRingCat.ofHom f_alg.toRingHom
          inv := CommRingCat.ofHom g_alg.toRingHom
          hom_inv_id := CommRingCat.hom_ext (RingHom.ext (AlgHom.congr_fun hgf))
          inv_hom_id := CommRingCat.hom_ext (RingHom.ext (AlgHom.congr_fun hfg)) }
      let e_spec : (Ad (d + 1)).left ≅
          AlgebraicGeometry.Spec
            (CommRingCat.of (TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k))) :=
        { hom := AlgebraicGeometry.Spec.map e_ring.hom
          inv := AlgebraicGeometry.Spec.map e_ring.inv
          hom_inv_id :=
            (AlgebraicGeometry.Spec.map_comp e_ring.inv e_ring.hom).symm.trans
              ((congrArg AlgebraicGeometry.Spec.map e_ring.inv_hom_id).trans
                (AlgebraicGeometry.Spec.map_id _))
          inv_hom_id :=
            (AlgebraicGeometry.Spec.map_comp e_ring.hom e_ring.inv).symm.trans
              ((congrArg AlgebraicGeometry.Spec.map e_ring.hom_inv_id).trans
                (AlgebraicGeometry.Spec.map_id _)) }
      let e_aff : (Ad (d + 1)).left ≅ CategoryTheory.Limits.pullback f_Ad f_A1 :=
        e_spec ≪≫ (AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin d) k) (Polynomial k)).symm
      let ι_left : CommRingCat.of (MvPolynomial (Fin d) k) ⟶
          CommRingCat.of (TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k)) :=
        CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
      let ι_right : CommRingCat.of (Polynomial k) ⟶
          CommRingCat.of (TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k)) :=
        CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight :
            Polynomial k →ₐ[k]
              TensorProduct k (MvPolynomial (Fin d) k) (Polynomial k)).toRingHom
      have hf_left :
          ι_left ≫ e_ring.hom =
            CommRingCat.ofHom
              (MvPolynomial.rename Fin.castSucc :
                MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin (d + 1)) k).toRingHom := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        change f_alg (p ⊗ₜ[k] (1 : Polynomial k)) = (MvPolynomial.rename Fin.castSucc) p
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      have hf_right :
          ι_right ≫ e_ring.hom =
          CommRingCat.ofHom
            (Polynomial.aeval (R := k)
              (MvPolynomial.X (Fin.last d) : MvPolynomial (Fin (d + 1)) k)).toRingHom := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        change f_alg ((1 : MvPolynomial (Fin d) k) ⊗ₜ[k] p) =
          Polynomial.aeval (MvPolynomial.X (Fin.last d)) p
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      have he_fst : e_aff.hom ≫ CategoryTheory.Limits.pullback.fst f_Ad f_A1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (MvPolynomial.rename Fin.castSucc :
              MvPolynomial (Fin d) k →ₐ[k] MvPolynomial (Fin (d + 1)) k).toRingHom) :=
        (CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map e_ring.hom)
          (AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin d) k) (Polynomial k)).inv
          (CategoryTheory.Limits.pullback.fst f_Ad f_A1)).trans
          ((congrArg (AlgebraicGeometry.Spec.map e_ring.hom ≫ ·)
            (AlgebraicGeometry.pullbackSpecIso_inv_fst k (MvPolynomial (Fin d) k)
              (Polynomial k))).trans
            ((AlgebraicGeometry.Spec.map_comp ι_left e_ring.hom).symm.trans
              (congrArg AlgebraicGeometry.Spec.map hf_left)))
      have he_snd : e_aff.hom ≫ CategoryTheory.Limits.pullback.snd f_Ad f_A1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (R := k)
              (MvPolynomial.X (Fin.last d) : MvPolynomial (Fin (d + 1)) k)).toRingHom) :=
        (CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map e_ring.hom)
          (AlgebraicGeometry.pullbackSpecIso k (MvPolynomial (Fin d) k) (Polynomial k)).inv
          (CategoryTheory.Limits.pullback.snd f_Ad f_A1)).trans
          ((congrArg (AlgebraicGeometry.Spec.map e_ring.hom ≫ ·)
            (AlgebraicGeometry.pullbackSpecIso_inv_snd k (MvPolynomial (Fin d) k)
              (Polynomial k))).trans
            ((AlgebraicGeometry.Spec.map_comp ι_right e_ring.hom).symm.trans
              (congrArg AlgebraicGeometry.Spec.map hf_right)))

      have hCoord_d := hCoord.2.2.2.2.2.2.2.2 d
      have hιd_over : ι_aff d ≫ (Pd d).hom = f_Ad := hCoord_d.2.2.1.trans hf_Ad.symm
      let P_mid := CategoryTheory.Limits.pullback (Pd d).hom f_A1
      let μ₁ : CategoryTheory.Limits.pullback f_Ad f_A1 ⟶ P_mid :=
        CategoryTheory.Limits.pullback.map f_Ad f_A1 (Pd d).hom f_A1 (ι_aff d) (𝟙 _) (𝟙 S_k)
          (by rw [hιd_over, CategoryTheory.Category.comp_id])
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
      let μ₂ : P_mid ⟶ CategoryTheory.Limits.pullback (Pd d).hom P1.hom :=
        CategoryTheory.Limits.pullback.map (Pd d).hom f_A1 (Pd d).hom P1.hom (𝟙 _) ι_P1 (𝟙 S_k)
          (by rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
          (by rw [hf_A1, CategoryTheory.Category.comp_id])
      have hμ₁_fst : μ₁ ≫ CategoryTheory.Limits.pullback.fst (Pd d).hom f_A1 =
          CategoryTheory.Limits.pullback.fst f_Ad f_A1 ≫ ι_aff d :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hμ₁_snd : μ₁ ≫ CategoryTheory.Limits.pullback.snd (Pd d).hom f_A1 =
          CategoryTheory.Limits.pullback.snd f_Ad f_A1 := by
        dsimp [μ₁, CategoryTheory.Limits.pullback.map]
        rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
      have hμ₂_fst : μ₂ ≫ CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom =
          CategoryTheory.Limits.pullback.fst (Pd d).hom f_A1 := by
        dsimp [μ₂, CategoryTheory.Limits.pullback.map]
        rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.comp_id]
      have hμ₂_snd : μ₂ ≫ CategoryTheory.Limits.pullback.snd (Pd d).hom P1.hom =
          CategoryTheory.Limits.pullback.snd (Pd d).hom f_A1 ≫ ι_P1 :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hFactor : e_aff.hom ≫ (μ₁ ≫ μ₂) = ι_aff (d + 1) := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc
            (e_aff.hom ≫ (μ₁ ≫ μ₂)) ≫ CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom
              = e_aff.hom ≫ μ₁ ≫ (μ₂ ≫ CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom) := by
                  simp only [CategoryTheory.Category.assoc]
            _ = e_aff.hom ≫ (μ₁ ≫ CategoryTheory.Limits.pullback.fst (Pd d).hom f_A1) := by
                  rw [hμ₂_fst]
            _ = (e_aff.hom ≫ CategoryTheory.Limits.pullback.fst f_Ad f_A1) ≫ ι_aff d := by
                  rw [hμ₁_fst, ← CategoryTheory.Category.assoc]
            _ = (ι_aff (d + 1)) ≫ CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom := by
                  rw [he_fst]; exact hCoord_d.2.2.2.1.symm
        · calc
            (e_aff.hom ≫ (μ₁ ≫ μ₂)) ≫ CategoryTheory.Limits.pullback.snd (Pd d).hom P1.hom
              = e_aff.hom ≫ μ₁ ≫ (μ₂ ≫ CategoryTheory.Limits.pullback.snd (Pd d).hom P1.hom) := by
                  simp only [CategoryTheory.Category.assoc]
            _ = e_aff.hom ≫ (μ₁ ≫ CategoryTheory.Limits.pullback.snd (Pd d).hom f_A1) ≫ ι_P1 := by
                  rw [hμ₂_snd, CategoryTheory.Category.assoc]
            _ = (e_aff.hom ≫ CategoryTheory.Limits.pullback.snd f_Ad f_A1) ≫ ι_P1 := by
                  rw [hμ₁_snd, CategoryTheory.Category.assoc]
            _ = (ι_aff (d + 1)) ≫ CategoryTheory.Limits.pullback.snd (Pd d).hom P1.hom := by
                  rw [he_snd]; exact hCoord_d.2.2.2.2.symm

      have hSurj_e : Function.Surjective e_aff.hom.base := by
        intro w
        refine ⟨e_aff.inv.base w, ?_⟩
        change (e_aff.inv ≫ e_aff.hom).base w = w
        rw [e_aff.inv_hom_id]
        rfl
      have hRange_eq_μ : Set.range (ι_aff (d + 1)).base = Set.range (μ₁ ≫ μ₂).base := by
        rw [← hFactor]
        exact hSurj_e.range_comp (μ₁ ≫ μ₂).base

      have hPB_μ₁ := hPB_map_left f_Ad (Pd d).hom f_A1 (ι_aff d) hιd_over
      have hPB_μ₂ := hPB_map_right (Pd d).hom f_A1 P1.hom ι_P1 hf_A1
      have hRange_μ₁ : Set.range μ₁.base =
          μ₂.base ⁻¹' ((CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom).base ⁻¹'
            Set.range (ι_aff d).base) := by
        have hr1 : Set.range μ₁.base =
            (CategoryTheory.Limits.pullback.fst (Pd d).hom f_A1).base ⁻¹'
              Set.range (ι_aff d).base :=
          hRange_of_isPullback hPB_μ₁
        rw [hr1, ← hμ₂_fst]
        rfl
      have hproj_last : coordProj (d + 1) (Fin.last d) =
          CategoryTheory.Limits.pullback.snd (Pd d).hom P1.hom :=
        Fin.lastCases_last
      have hRange_μ₂ : Set.range μ₂.base =
          (O_coord (d + 1) (Fin.last d) : Set ↥(Pd (d + 1)).left) :=
        (hRange_of_isPullback hPB_μ₂).trans
          (congrArg (fun f : (Pd (d + 1)).left ⟶ P1.left => f.base ⁻¹' Set.range ι_P1.base)
            hproj_last.symm)
      have hmem_pre :
          ∀ (g₁ g₂ : (Pd (d + 1)).left ⟶ P1.left), g₁ = g₂ →
            ∀ p : ↥(Pd (d + 1)).left,
              (p ∈ g₁.base ⁻¹' Set.range ι_P1.base ↔ p ∈ g₂.base ⁻¹' Set.range ι_P1.base) := by
        intro g₁ g₂ hg p
        subst hg
        rfl

      intro z
      rw [hRange_eq_μ]
      constructor
      · rintro ⟨w, rfl⟩ j
        refine Fin.lastCases ?_ (fun j' => ?_) j
        · exact (Set.ext_iff.mp hRange_μ₂ ((μ₁ ≫ μ₂).base w)).mp ⟨μ₁.base w, rfl⟩
        · have hw_μ₁ : μ₁.base w ∈ Set.range μ₁.base := ⟨w, rfl⟩
          rw [hRange_μ₁] at hw_μ₁
          have hfst_in : (CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom).base
              ((μ₁ ≫ μ₂).base w) ∈ Set.range (ι_aff d).base := hw_μ₁
          have hj' := (ih _).mp hfst_in j'
          have hproj : coordProj (d + 1) (Fin.castSucc j') =
              CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom ≫ coordProj d j' :=
            Fin.lastCases_castSucc j'
          exact (hmem_pre _ _ hproj ((μ₁ ≫ μ₂).base w)).mpr hj'
      · intro hall
        have hz_μ₂ : z ∈ Set.range μ₂.base :=
          (Set.ext_iff.mp hRange_μ₂ z).mpr (hall (Fin.last d))
        obtain ⟨y, rfl⟩ := hz_μ₂
        have hy_fst : (CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom).base (μ₂.base y) ∈
            Set.range (ι_aff d).base := by
          rw [ih]
          intro j'
          have hproj : coordProj (d + 1) (Fin.castSucc j') =
              CategoryTheory.Limits.pullback.fst (Pd d).hom P1.hom ≫ coordProj d j' :=
            Fin.lastCases_castSucc j'
          have hj' : μ₂.base y ∈
              (coordProj (d + 1) (Fin.castSucc j')).base ⁻¹' Set.range ι_P1.base :=
            hall (Fin.castSucc j')
          exact (hmem_pre _ _ hproj (μ₂.base y)).mp hj'
        have hy_μ₁ : y ∈ Set.range μ₁.base := by
          rw [hRange_μ₁]
          exact hy_fst
