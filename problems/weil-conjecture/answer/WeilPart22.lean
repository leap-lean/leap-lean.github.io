                      (CategoryTheory.Category.assoc (Θ.toPresheafFiber X x F₁.obj)
                        (Θ.sheafFiber.map hF) ((homEquiv_Θ F₂ M).symm β))))))
          homEquiv_naturality_right := fun {F M₁ M₂} α hM => by
            ext X z x; rfl }⟩
    have hPointPull :
        ∀ {C D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} C]
          [CategoryTheory.Category.{u, u + 1} D]
          (J : CategoryTheory.GrothendieckTopology C)
          (K : CategoryTheory.GrothendieckTopology D)
          [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
          [CategoryTheory.HasWeakSheafify K AddCommGrpCat.{u}]
          (G : C ⥤ D) [G.IsContinuous J K]
          [(G.sheafPushforwardContinuous AddCommGrpCat.{u} J K).IsRightAdjoint]
          (Ψ : CategoryTheory.GrothendieckTopology.Point.{u} J)
          (Φ : CategoryTheory.GrothendieckTopology.Point.{u} K)
          (e : G ⋙ Φ.fiber ≅ Ψ.fiber),
          Nonempty (((G.sheafPullback AddCommGrpCat.{u} J K) ⋙
            (Φ.sheafFiber (A := AddCommGrpCat.{u}))) ≅
            (Ψ.sheafFiber (A := AddCommGrpCat.{u}))) := by
      intro C D _ _ J K _ _ G _ _ Ψ Φ e
      obtain ⟨adj_Ψ⟩ := hSkyAdj J Ψ
      obtain ⟨adj_Φ⟩ := hSkyAdj K Φ
      let pf_G := G.sheafPushforwardContinuous AddCommGrpCat.{u} J K
      let e_pre_M : ∀ M : AddCommGrpCat.{u},
          ((skySheaf K Φ ⋙ pf_G).obj M).obj ≅ ((skySheaf J Ψ).obj M).obj :=
        fun M => CategoryTheory.NatIso.ofComponents
          (fun X =>
            { hom := AddCommGrpCat.ofHom
                { toFun := fun s y => s ((e.inv.app X.unop) y)
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
              inv := AddCommGrpCat.ofHom
                { toFun := fun s x => s ((e.hom.app X.unop) x)
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
              hom_inv_id := AddCommGrpCat.hom_ext (AddMonoidHom.ext fun s => funext fun x =>
                congrArg s (ConcreteCategory.congr_hom (e.hom_inv_id_app X.unop) x))
              inv_hom_id := AddCommGrpCat.hom_ext (AddMonoidHom.ext fun s => funext fun y =>
                congrArg s (ConcreteCategory.congr_hom (e.inv_hom_id_app X.unop) y)) })
          (fun {X₁ X₂} k => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun s => funext fun y =>
            congrArg s (ConcreteCategory.congr_hom (e.inv.naturality k.unop) y).symm))
      let e_S : skySheaf K Φ ⋙ pf_G ≅ skySheaf J Ψ :=
        CategoryTheory.NatIso.ofComponents
          (fun M =>
            { hom := ⟨(e_pre_M M).hom⟩
              inv := ⟨(e_pre_M M).inv⟩
              hom_inv_id := by ext1; exact (e_pre_M M).hom_inv_id
              inv_hom_id := by ext1; exact (e_pre_M M).inv_hom_id })
          (fun {M₁ M₂} φ => by
            ext1
            exact CategoryTheory.NatTrans.ext (funext fun X =>
              AddCommGrpCat.hom_ext (AddMonoidHom.ext fun s => funext fun y => rfl)))
      let adj_comp := ((G.sheafAdjunctionContinuous AddCommGrpCat.{u} J K).comp adj_Φ).ofNatIsoRight e_S
      exact ⟨CategoryTheory.Adjunction.leftAdjointUniq adj_comp adj_Ψ⟩

    let T_spec : ∀ (Ω : Type u) [Field Ω],
        (AlgebraicGeometry.Spec (CommRingCat.of Ω)).Etale :=
      fun Ω _ => CategoryTheory.MorphismProperty.Over.mk ⊤
        (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
        (inferInstance : AlgebraicGeometry.Etale (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω))))
    let geomFib : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z), Z.Etale ⥤ Type u :=
      fun Z Ω _ z_bar =>
        weilEtaleSitePullback z_bar ⋙ CategoryTheory.coyoneda.obj (Opposite.op (T_spec Ω))
    have hGeomPtProps : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z),
        CategoryTheory.IsCofiltered (geomFib Z Ω z_bar).Elements ∧
        CategoryTheory.InitiallySmall.{u} (geomFib Z Ω z_bar).Elements ∧
        (∀ {X : Z.Etale}, ∀ R ∈ Z.smallEtaleTopology X, ∀ x : (geomFib Z Ω z_bar).obj X,
          ∃ (Y' : Z.Etale) (k : Y' ⟶ X) (_ : R.arrows k) (y : (geomFib Z Ω z_bar).obj Y'),
            (geomFib Z Ω z_bar).map k y = x) := by
      intro Z Ω _ _ z_bar
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let B_z : Z.Etale ⥤ S_Ω.Etale := weilEtaleSitePullback z_bar
      let F_z : Z.Etale ⥤ Type u := geomFib Z Ω z_bar
      have : CategoryTheory.Limits.PreservesFiniteLimits B_z :=
        CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback
          (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) z_bar
      have hCofil : CategoryTheory.IsCofiltered F_z.Elements :=
        CategoryTheory.Functor.isCofiltered_elements F_z
      have hJoint : ∀ {X : Z.Etale}, ∀ R ∈ Z.smallEtaleTopology X, ∀ x : F_z.obj X,
          ∃ (Y' : Z.Etale) (k : Y' ⟶ X) (_ : R.arrows k) (y : F_z.obj Y'),
            F_z.map k y = x := by
        intro X R hR σ
        let α : S_Ω ⟶ X.left := σ.left ≫ CategoryTheory.Limits.pullback.fst X.hom z_bar
        have hα_Z : α ≫ X.hom = z_bar :=
          (CategoryTheory.Category.assoc σ.left
              (CategoryTheory.Limits.pullback.fst X.hom z_bar) X.hom).trans
            ((congrArg (σ.left ≫ ·)
                (CategoryTheory.Limits.pullback.condition (f := X.hom) (g := z_bar))).trans
              ((CategoryTheory.Category.assoc σ.left
                  (CategoryTheory.Limits.pullback.snd X.hom z_bar) z_bar).symm.trans
                ((congrArg (· ≫ z_bar) (CategoryTheory.MorphismProperty.Over.w σ)).trans
                  (CategoryTheory.Category.id_comp z_bar))))
        let p₀ : ↥S_Ω := default
        obtain ⟨V, k, v₀, hkR, hEt_k, hv₀⟩ := (hMemSmallEtale Z X R).mp hR (α.base p₀)
        let Q := CategoryTheory.Limits.pullback α k.left
        let fst_Q : Q ⟶ S_Ω := CategoryTheory.Limits.pullback.fst α k.left
        let snd_Q : Q ⟶ V.left := CategoryTheory.Limits.pullback.snd α k.left
        have hEt_fst : AlgebraicGeometry.Etale fst_Q :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (CategoryTheory.IsPullback.of_hasPullback α k.left).flip hEt_k
        obtain ⟨q₀, hq₀, -⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback p₀ v₀ hv₀.symm
        have hSurj_fst : AlgebraicGeometry.Surjective fst_Q :=
          ⟨fun pt => ⟨q₀, hq₀.trans (Subsingleton.elim p₀ pt)⟩⟩
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
          @AlgebraicGeometry.Etale
        have hTopEq : AlgebraicGeometry.Scheme.etaleTopology =
            (AlgebraicGeometry.Scheme.jointlySurjectivePretopology ⊓ P_et.pretopology).toGrothendieck :=
          AlgebraicGeometry.Scheme.grothendieckTopology_eq_inf P_et
        have hMemInf : CategoryTheory.Presieve.singleton fst_Q ∈
            (AlgebraicGeometry.Scheme.jointlySurjectivePretopology ⊓ P_et.pretopology) S_Ω := by
          refine ⟨?_, fun {_ _} hg => by cases hg; exact hEt_fst⟩
          dsimp [AlgebraicGeometry.Scheme.jointlySurjectivePretopology,
            AlgebraicGeometry.Scheme.jointlySurjectivePrecoverage,
            CategoryTheory.Precoverage.toPretopology]
          rw [CategoryTheory.Presieve.mem_comap_jointlySurjectivePrecoverage_iff]
          intro pt
          exact ⟨Q, fst_Q, CategoryTheory.Presieve.singleton.mk, hSurj_fst.surj pt⟩
        have hMemTop : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton fst_Q) ∈
            AlgebraicGeometry.Scheme.etaleTopology S_Ω := by
          rw [hTopEq]
          exact (CategoryTheory.Pretopology.mem_toGrothendieck _ _ _).mpr
            ⟨_, hMemInf, CategoryTheory.Sieve.le_generate _⟩
        obtain ⟨W_big, u_big, ⟨Q', s_Q', f_Q', ⟨⟩, hu_eq⟩, y_big, hy_big⟩ :=
          (AlgebraicGeometry.Scheme.geometricFiber Ω).jointly_surjective _ hMemTop (𝟙 S_Ω)
        let sec_Q : S_Ω ⟶ Q := y_big ≫ s_Q'
        have hsec_fst : sec_Q ≫ fst_Q = 𝟙 S_Ω :=
          (CategoryTheory.Category.assoc y_big s_Q' fst_Q).trans
            ((congrArg (y_big ≫ ·) hu_eq).trans hy_big)
        let β : S_Ω ⟶ V.left := sec_Q ≫ snd_Q
        have hβ_k : β ≫ k.left = α :=
          (CategoryTheory.Category.assoc sec_Q snd_Q k.left).trans
            ((congrArg (sec_Q ≫ ·)
                (CategoryTheory.Limits.pullback.condition (f := α) (g := k.left)).symm).trans
              ((CategoryTheory.Category.assoc sec_Q fst_Q α).symm.trans
                ((congrArg (· ≫ α) hsec_fst).trans (CategoryTheory.Category.id_comp α))))
        have hβ_Z : β ≫ V.hom = 𝟙 S_Ω ≫ z_bar :=
          (congrArg (β ≫ ·) (CategoryTheory.MorphismProperty.Over.w k).symm).trans
            ((CategoryTheory.Category.assoc β k.left X.hom).symm.trans
              ((congrArg (· ≫ X.hom) hβ_k).trans
                (hα_Z.trans (CategoryTheory.Category.id_comp z_bar).symm)))
        let τ_hom : T_spec Ω ⟶ B_z.obj V := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift β (𝟙 S_Ω) hβ_Z)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        refine ⟨V, k, hkR, τ_hom, ?_⟩
        refine CategoryTheory.MorphismProperty.Over.Hom.ext ?_
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc τ_hom.left (B_z.map k).left
              (CategoryTheory.Limits.pullback.fst X.hom z_bar)).trans
            ((congrArg (τ_hom.left ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Category.assoc τ_hom.left
                  (CategoryTheory.Limits.pullback.fst V.hom z_bar) k.left).symm.trans
                ((congrArg (· ≫ k.left)
                    (CategoryTheory.Limits.pullback.lift_fst β (𝟙 S_Ω) hβ_Z)).trans hβ_k)))
        · exact (CategoryTheory.Category.assoc τ_hom.left (B_z.map k).left
              (CategoryTheory.Limits.pullback.snd X.hom z_bar)).trans
            ((congrArg (τ_hom.left ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              ((CategoryTheory.Limits.pullback.lift_snd β (𝟙 S_Ω) hβ_Z).trans
                (CategoryTheory.MorphismProperty.Over.w σ).symm))
      have hSmall : CategoryTheory.InitiallySmall.{u} F_z.Elements := by
        let M_Z := CategoryTheory.SmallModel.{u} Z.AffineEtale
        let e_sm := CategoryTheory.equivSmallModel.{u} Z.AffineEtale
        let S_spec := AlgebraicGeometry.Scheme.AffineEtale.Spec Z
        let G_Z : M_Z ⥤ Z.Etale := e_sm.inverse ⋙ S_spec
        let idx : Type u := Σ m : M_Z, F_z.obj (G_Z.obj m)
        let emb : idx → F_z.Elements := fun p => CategoryTheory.Functor.elementsMk F_z (G_Z.obj p.1) p.2
        have : Small.{u} ↑(Set.range emb) := small_range emb
        refine CategoryTheory.initiallySmall_of_small_weakly_initial_set (Set.range emb) ?_
        intro elem
        obtain ⟨Y', k, hk, y, hy⟩ := hJoint _ (hSmallModelCover Z elem.1) elem.2
        rcases hk with ⟨⟨m, v', map_m, hv'_eq⟩⟩
        refine ⟨CategoryTheory.Functor.elementsMk F_z (G_Z.obj m) (F_z.map v' y),
          ⟨⟨m, F_z.map v' y⟩, rfl⟩, ⟨⟨map_m, ?_⟩⟩⟩
        calc
          F_z.map map_m (F_z.map v' y) = (F_z.map v' ≫ F_z.map map_m) y := rfl
          _ = F_z.map (v' ≫ map_m) y := by rw [← F_z.map_comp]
          _ = F_z.map k y := by rw [hv'_eq]
          _ = elem.2 := hy
      exact ⟨hCofil, hSmall, @hJoint⟩
    let geomPt : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (z_bar : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z),
        CategoryTheory.GrothendieckTopology.Point.{u} Z.smallEtaleTopology :=
      fun Z Ω _ _ z_bar =>
        CategoryTheory.GrothendieckTopology.Point.mk (geomFib Z Ω z_bar)
          (hGeomPtProps Z Ω z_bar).1
          (hGeomPtProps Z Ω z_bar).2.1
          @(hGeomPtProps Z Ω z_bar).2.2
    let pb_g := (weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
      Y.smallEtaleTopology W.smallEtaleTopology
    refine ⟨fun {G₁ G₂} u hu => ?_⟩
    let K_sh := CategoryTheory.Limits.kernel (pb_g.map u)
    have hK_zero : CategoryTheory.Limits.IsZero K_sh := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      ext V s
      have hSep := K_sh.2.isSeparated V.unop
      let R_s : CategoryTheory.Sieve V.unop :=
        { arrows := fun {U} k => (K_sh.obj.map k.op).hom s = 0
          downward_closed := fun {U₁ U₂} k hk h_arr => by
            change (K_sh.obj.map (k.op ≫ h_arr.op)).hom s = 0
            rw [K_sh.obj.map_comp]
            change (K_sh.obj.map h_arr.op).hom ((K_sh.obj.map k.op).hom s) = 0
            rw [hk, map_zero] }
      have hR_mem : R_s ∈ W.smallEtaleTopology V.unop := by
        refine (hMemSmallEtale W V.unop R_s).mpr fun v => ?_
        let κ := V.unop.left.residueField v
        let Ω := AlgebraicClosure ↥κ
        let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
        let α_v : S_Ω ⟶ V.unop.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥κ Ω)) ≫
            V.unop.left.fromSpecResidueField v
        let w_bar : S_Ω ⟶ W := α_v ≫ V.unop.hom
        let Φ_W := geomPt W Ω w_bar
        let Φ_Y := geomPt Y Ω (w_bar ≫ g)
        let e_pb : weilEtaleSitePullback (w_bar ≫ g) ≅
            weilEtaleSitePullback g ⋙ weilEtaleSitePullback w_bar :=
          CategoryTheory.MorphismProperty.Over.pullbackComp w_bar g
        let c_Ω : S_Ω.Etale ⥤ Type u := CategoryTheory.coyoneda.obj (Opposite.op (T_spec Ω))
        let e_fib : weilEtaleSitePullback g ⋙ Φ_W.fiber ≅ Φ_Y.fiber :=
          (CategoryTheory.Functor.associator (weilEtaleSitePullback g)
            (weilEtaleSitePullback w_bar) c_Ω).symm ≪≫
            CategoryTheory.Functor.isoWhiskerRight e_pb.symm c_Ω
        obtain ⟨iso_pull⟩ := hPointPull Y.smallEtaleTopology W.smallEtaleTopology
          (weilEtaleSitePullback g) Φ_Y Φ_W e_fib
        let F_W := Φ_W.sheafFiber (A := AddCommGrpCat.{u})
        let F_Y := Φ_Y.sheafFiber (A := AddCommGrpCat.{u})
        have hMono_FY : CategoryTheory.Mono (F_Y.map u) := inferInstance
        have hMono_FW : CategoryTheory.Mono (F_W.map (pb_g.map u)) := by
          have hnat : F_W.map (pb_g.map u) ≫ iso_pull.hom.app G₂ =
              iso_pull.hom.app G₁ ≫ F_Y.map u :=
            iso_pull.hom.naturality u
          have hIso_u : F_W.map (pb_g.map u) =
              (iso_pull.app G₁).hom ≫ F_Y.map u ≫ (iso_pull.app G₂).inv :=
            (CategoryTheory.Category.comp_id (F_W.map (pb_g.map u))).symm.trans
              ((congrArg (F_W.map (pb_g.map u) ≫ ·) (iso_pull.app G₂).hom_inv_id.symm).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ (iso_pull.app G₂).inv) hnat).trans
                    (CategoryTheory.Category.assoc _ _ _))))
          rw [hIso_u]
