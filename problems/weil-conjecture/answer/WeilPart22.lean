  have hEtaEqCanon : ∀ (T₁' : X₁.Etale) (hT₁' : CategoryTheory.Limits.IsTerminal T₁')
      (T₂' : X₂.Etale) (hT₂' : CategoryTheory.Limits.IsTerminal T₂') (A : AddCommGrpCat.{u}),
