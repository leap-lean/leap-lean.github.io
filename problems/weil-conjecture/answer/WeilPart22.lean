      change IsDomain ↑(C_bar.left.presheaf.stalk (p_pt : ↥C_bar.left)) at hDom_stalkP
      change @IsDiscreteValuationRing ↑(C_bar.left.presheaf.stalk (p_pt : ↥C_bar.left)) _ hDom_stalkP
        at hDVR_stalkP
      have : IsDomain ↑(P1_over.left.presheaf.stalk (q_pt : ↥P1_over.left)) := hDom_stalkQ
      have : IsDiscreteValuationRing ↑(P1_over.left.presheaf.stalk (q_pt : ↥P1_over.left)) := hDVR_stalkQ
      have : IsDomain ↑(C_bar.left.presheaf.stalk (p_pt : ↥C_bar.left)) := hDom_stalkP
      have : IsDiscreteValuationRing ↑(C_bar.left.presheaf.stalk (p_pt : ↥C_bar.left)) := hDVR_stalkP
      have hDVR_B : IsDiscreteValuationRing (Localization.AtPrime m_Q) :=
        hDVR_of_loc m_Q hDom_stalkQ hDVR_stalkQ
      have hDVR_A : IsDiscreteValuationRing (Localization.AtPrime P_id) :=
        hDVR_of_loc P_id hDom_stalkP hDVR_stalkP
      have hDim1_A : ∀ q : Ideal A, q.IsPrime → q ≠ ⊥ → q.IsMaximal := by
        have hHomeo : IsHomeomorph hAff_U.fromSpec.isOpenEmbedding.isEmbedding.toHomeomorph :=
