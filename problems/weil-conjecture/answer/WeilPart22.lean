            CategoryTheory.MorphismProperty.Over.homMk U_star.ι rfl trivial
          let y₀_Z' : ↥U_star := ⟨z₀, hz₀_star⟩
          have hs_Z'_ne : L₀.obj.map (Opposite.op w_star₀) s_Z ≠ 0 := by
