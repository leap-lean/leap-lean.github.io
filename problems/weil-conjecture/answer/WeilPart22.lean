      have h_inv_w : e_sch.inv ≫ (Sig_g'.obj (B_f'.obj W)).hom = (B_f.obj Z).hom := by
        change e_sch.inv ≫ (CategoryTheory.Limits.pullback.snd W.hom f' ≫ g') =
