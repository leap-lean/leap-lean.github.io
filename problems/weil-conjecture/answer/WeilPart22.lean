            refine (Θ.presheafFiber_hom_ext_iff (P := F₁.obj)).mpr fun X x => ?_
            have hL : Θ.toPresheafFiber X x F₁.obj ≫ (homEquiv_Θ F₁ M).symm (hF ≫ β) =
                (hF ≫ β).hom.app (Opposite.op X) ≫ evalAt x M :=
              Θ.toPresheafFiber_presheafFiberDesc (P := F₁.obj) (T := M)
                (fun X₀ x₀ => (hF ≫ β).hom.app (Opposite.op X₀) ≫ evalAt x₀ M)
