                                (CategoryTheory.Category.comp_id p_P)))).trans
                          ((CategoryTheory.Category.assoc p_P (Fgt_P.obj U_P).hom π_snd).symm.trans
                            ((congrArg (fun m => m ≫ π_snd)
                                (CategoryTheory.Limits.pullback.condition
                                  (f := (Fgt_P.obj U_P).hom) (g := ι_σ))).trans
                              ((CategoryTheory.Category.assoc q_P ι_σ π_snd).trans
