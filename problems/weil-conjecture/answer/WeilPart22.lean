import WeilPart21
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_etale_weil_restriction_base_change_lift (δ : ℕ) (hδ : 1 ≤ δ)
    (R A C : Type u) [CommRing R] [CommRing A] [CommRing C]
    [Algebra R A] [Algebra A C]
    (b : Module.Basis (Fin δ) R A)
    (hEt : Algebra.Etale A C)
    (hSurj : ∀ q : PrimeSpectrum A, ∃ Q : PrimeSpectrum C,
      PrimeSpectrum.comap (algebraMap A C) Q = q)
    (p : PrimeSpectrum R) :
    ∃ (R' : CommRingCat.{u}) (f_R : Quiver.Hom (CommRingCat.of R) R'),
      RingHom.Etale f_R.hom ∧
      (∃ p' : PrimeSpectrum ↑R', PrimeSpectrum.comap f_R.hom p' = p) ∧
      ∀ (S : Type u) [CommRing S] (α_A : A →+* S) (α_R' : ↑R' →+* S),
        (∀ r : R, α_A (algebraMap R A r) = α_R' (f_R.hom r)) →
        ∃ ψ_S : C →+* S, ∀ a : A, ψ_S (algebraMap A C a) = α_A a :=
by
  let _ := hδ
  have hStep1 :
      ∃ (coord : ∀ (B : Type u) [CommRing B] [Algebra R B],
          TensorProduct R A B →ₗ[R] (Fin δ → B))
        (uncoord : ∀ (B : Type u) [CommRing B] [Algebra R B],
          (Fin δ → B) →ₗ[R] TensorProduct R A B),
        (∀ (B : Type u) [CommRing B] [Algebra R B] (a : A) (x : B) (m : Fin δ),
          coord B (a ⊗ₜ[R] x) m = (b.repr a m) • x) ∧
        (∀ (B : Type u) [CommRing B] [Algebra R B] (v : Fin δ → B),
          uncoord B v = ∑ m : Fin δ, b m ⊗ₜ[R] v m) ∧
        (∀ (B : Type u) [CommRing B] [Algebra R B] (v : Fin δ → B),
          coord B (uncoord B v) = v) ∧
        (∀ (B : Type u) [CommRing B] [Algebra R B] (w : TensorProduct R A B),
          uncoord B (coord B w) = w) ∧
        (∀ (B₁ B₂ : Type u) [CommRing B₁] [Algebra R B₁] [CommRing B₂] [Algebra R B₂]
          (h : B₁ →ₐ[R] B₂) (w : TensorProduct R A B₁) (m : Fin δ),
          coord B₂ ((Algebra.TensorProduct.map (AlgHom.id A A) h) w) m = h (coord B₁ w m)) := by
    classical
    let c_fn : ∀ (B : Type u) [CommRing B] [Algebra R B],
        TensorProduct R A B →ₗ[R] (Fin δ → B) :=
      fun B _ _ => LinearMap.pi fun m =>
        TensorProduct.lift ((LinearMap.lsmul R B).comp (b.coord m))
    let u_fn : ∀ (B : Type u) [CommRing B] [Algebra R B],
        (Fin δ → B) →ₗ[R] TensorProduct R A B :=
      fun B _ _ => ∑ m : Fin δ, (TensorProduct.mk R A B (b m)).comp (LinearMap.proj m)
    have hc_tmul : ∀ (B : Type u) [CommRing B] [Algebra R B]
        (a : A) (x : B) (m : Fin δ),
        c_fn B (a ⊗ₜ[R] x) m = (b.repr a m) • x := by
      intro B _ _ a x m
      simp [c_fn, Module.Basis.coord_apply]
    have hu_app : ∀ (B : Type u) [CommRing B] [Algebra R B] (v : Fin δ → B),
        u_fn B v = ∑ m : Fin δ, b m ⊗ₜ[R] v m := by
      intro B _ _ v
      simp [u_fn, LinearMap.sum_apply]
    have hcu : ∀ (B : Type u) [CommRing B] [Algebra R B] (v : Fin δ → B),
        c_fn B (u_fn B v) = v := by
      intro B _ _ v
      ext m₀
      rw [hu_app, map_sum, Finset.sum_apply]
      simp only [hc_tmul, Module.Basis.repr_self, Finsupp.single_apply]
      rw [Finset.sum_eq_single m₀]
      · simp
      · intro m _ hm
        simp [hm]
      · intro hm₀
        exact False.elim (hm₀ (Finset.mem_univ m₀))
    have huc : ∀ (B : Type u) [CommRing B] [Algebra R B] (w : TensorProduct R A B),
        u_fn B (c_fn B w) = w := by
      intro B _ _ w
      have hext : (u_fn B).comp (c_fn B) = LinearMap.id := by
        apply TensorProduct.ext'
        intro a x
        simp only [LinearMap.comp_apply, LinearMap.id_apply, hu_app, hc_tmul]
        have h_smul : ∀ m : Fin δ, b m ⊗ₜ[R] ((b.repr a m) • x) = ((b.repr a m) • b m) ⊗ₜ[R] x :=
          fun m => (TensorProduct.smul_tmul (b.repr a m) (b m) x).symm
        simp_rw [h_smul]
        have h_sum : (∑ m : Fin δ, (b.repr a m • b m)) ⊗ₜ[R] x =
            ∑ m : Fin δ, ((b.repr a m • b m) ⊗ₜ[R] x) :=
          map_sum ((TensorProduct.mk R A B).flip x) (fun m => b.repr a m • b m) Finset.univ
        rw [← h_sum, b.sum_repr a]
      exact LinearMap.congr_fun hext w
    have hcmap : ∀ (B₁ B₂ : Type u) [CommRing B₁] [Algebra R B₁]
        [CommRing B₂] [Algebra R B₂] (h : B₁ →ₐ[R] B₂) (w : TensorProduct R A B₁) (m : Fin δ),
        c_fn B₂ ((Algebra.TensorProduct.map (AlgHom.id A A) h) w) m = h (c_fn B₁ w m) := by
      intro B₁ B₂ _ _ _ _ h w m
      let u : Fin δ → B₂ := fun l => h (c_fn B₁ w l)
      have hu : u_fn B₂ u = (Algebra.TensorProduct.map (AlgHom.id A A) h) w := by
        calc
          u_fn B₂ u = ∑ l : Fin δ, b l ⊗ₜ[R] h (c_fn B₁ w l) := hu_app B₂ u
          _ = ∑ l : Fin δ, (Algebra.TensorProduct.map (AlgHom.id A A) h) (b l ⊗ₜ[R] c_fn B₁ w l) := by
            simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
          _ = (Algebra.TensorProduct.map (AlgHom.id A A) h) (u_fn B₁ (c_fn B₁ w)) := by
            rw [hu_app, map_sum]
          _ = (Algebra.TensorProduct.map (AlgHom.id A A) h) w := by
            rw [huc]
      have hc := congrArg (fun z => c_fn B₂ z m) hu
      rw [hcu] at hc
      exact hc.symm
    exact ⟨c_fn, u_fn, hc_tmul, hu_app, hcu, huc, hcmap⟩
  have hStep2 :
      ∀ [Algebra.FinitePresentation A C]
        (coord : ∀ (B : Type u) [CommRing B] [Algebra R B], TensorProduct R A B →ₗ[R] (Fin δ → B))
        (uncoord : ∀ (B : Type u) [CommRing B] [Algebra R B], (Fin δ → B) →ₗ[R] TensorProduct R A B),
        (∀ (B : Type u) [CommRing B] [Algebra R B] (v : Fin δ → B),
          uncoord B v = ∑ m : Fin δ, b m ⊗ₜ[R] v m) →
        (∀ (B : Type u) [CommRing B] [Algebra R B] (v : Fin δ → B),
          coord B (uncoord B v) = v) →
        (∀ (B : Type u) [CommRing B] [Algebra R B] (w : TensorProduct R A B),
          uncoord B (coord B w) = w) →
        (∀ (B₁ B₂ : Type u) [CommRing B₁] [Algebra R B₁] [CommRing B₂] [Algebra R B₂]
          (h : B₁ →ₐ[R] B₂) (w : TensorProduct R A B₁) (m : Fin δ),
          coord B₂ ((Algebra.TensorProduct.map (AlgHom.id A A) h) w) m = h (coord B₁ w m)) →
        ∃ (R_res : Type u) (hComm : CommRing R_res) (hAlg : Algebra R R_res),
          letI : CommRing R_res := hComm
          letI : Algebra R R_res := hAlg
          Algebra.FinitePresentation R R_res ∧
          ∃ η_univ : C →ₐ[A] TensorProduct R A R_res,
            ∀ (B : Type u) [CommRing B] [Algebra R B],
              Function.Bijective
                (fun φ : R_res →ₐ[R] B =>
                  (Algebra.TensorProduct.map (AlgHom.id A A) φ).comp η_univ) := by
    intro _ coord uncoord h_uncoord_apply h_coord_uncoord h_uncoord_coord h_coord_map
    obtain ⟨n, f, hf_surj, hf_fg⟩ := Algebra.FinitePresentation.out (R := A) (A := C)
    obtain ⟨s, hs⟩ := hf_fg
    let g_rel : ↥s → MvPolynomial (Fin n) A := Subtype.val
    have hs_range : Ideal.span (Set.range g_rel) = RingHom.ker f.toRingHom := by
      rwa [Subtype.range_coe_subtype, Finset.setOf_mem]
    have _ : Algebra.FinitePresentation R (MvPolynomial (Fin n × Fin δ) R) :=
      Algebra.FinitePresentation.mvPolynomial R R (Fin n × Fin δ)
    let Z : Fin n → TensorProduct R A (MvPolynomial (Fin n × Fin δ) R) :=
      fun k => uncoord (MvPolynomial (Fin n × Fin δ) R) (fun l => MvPolynomial.X (k, l))
    let gen_res : ↥s × Fin δ → MvPolynomial (Fin n × Fin δ) R :=
      fun q => coord (MvPolynomial (Fin n × Fin δ) R) (MvPolynomial.aeval Z (g_rel q.1)) q.2
    let I_res : Ideal (MvPolynomial (Fin n × Fin δ) R) := Ideal.span (Set.range gen_res)
    have hFG_res : I_res.FG := Submodule.fg_span (Set.finite_range gen_res)
    have hFP : Algebra.FinitePresentation R (MvPolynomial (Fin n × Fin δ) R ⧸ I_res) :=
      Algebra.FinitePresentation.quotient hFG_res
    suffices h_quot : ∀ (R_q : Type u) [CommRing R_q] [Algebra R R_q]
        (π_res : MvPolynomial (Fin n × Fin δ) R →ₐ[R] R_q),
        Function.Surjective π_res →
        (∀ p_pol, π_res p_pol = 0 ↔ p_pol ∈ I_res) →
        (∀ (B : Type u) [CommRing B] [Algebra R B]
          (α : MvPolynomial (Fin n × Fin δ) R →ₐ[R] B),
          (∀ p_pol ∈ I_res, α p_pol = 0) →
          ∃ φ : R_q →ₐ[R] B, φ.comp π_res = α) →
        ∃ η_univ : C →ₐ[A] TensorProduct R A R_q,
          ∀ (B : Type u) [CommRing B] [Algebra R B],
            Function.Bijective
              (fun φ : R_q →ₐ[R] B =>
                (Algebra.TensorProduct.map (AlgHom.id A A) φ).comp η_univ) by
      obtain ⟨η, hBij⟩ := h_quot (MvPolynomial (Fin n × Fin δ) R ⧸ I_res)
        (Ideal.Quotient.mkₐ R I_res)
        Ideal.Quotient.mk_surjective
        (fun p_pol => Ideal.Quotient.eq_zero_iff_mem)
        (fun B _ _ α hα => ⟨Ideal.Quotient.liftₐ I_res α hα,
          Ideal.Quotient.liftₐ_comp I_res α hα⟩)
      exact ⟨MvPolynomial (Fin n × Fin δ) R ⧸ I_res, inferInstance, inferInstance, hFP, η, hBij⟩
    intro R_q _ _ π_res hπ_surj hπ_ker hπ_lift
    let Z_res : Fin n → TensorProduct R A R_q :=
      fun k => (Algebra.TensorProduct.map (AlgHom.id A A) π_res) (Z k)
    have h_aeval_map : ∀ (B : Type u) [CommRing B] [Algebra R B]
        (α : MvPolynomial (Fin n × Fin δ) R →ₐ[R] B),
        (Algebra.TensorProduct.map (AlgHom.id A A) α).comp (MvPolynomial.aeval Z) =
          MvPolynomial.aeval (fun k => (Algebra.TensorProduct.map (AlgHom.id A A) α) (Z k)) := by
      intro B _ _ α
      apply MvPolynomial.algHom_ext
      intro k
      simp only [AlgHom.comp_apply, MvPolynomial.aeval_X]
    have h_ker : RingHom.ker f.toRingHom ≤ RingHom.ker (MvPolynomial.aeval Z_res).toRingHom := by
      rw [← hs_range, Ideal.span_le, Set.range_subset_iff]
      intro j
      rw [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      have h_coord_zero : coord R_q (MvPolynomial.aeval Z_res (g_rel j)) = 0 := by
        ext m
        have h_eq : MvPolynomial.aeval Z_res (g_rel j) =
            (Algebra.TensorProduct.map (AlgHom.id A A) π_res) (MvPolynomial.aeval Z (g_rel j)) :=
          (AlgHom.congr_fun (h_aeval_map R_q π_res) (g_rel j)).symm
        rw [h_eq, h_coord_map _ R_q π_res (MvPolynomial.aeval Z (g_rel j)) m, Pi.zero_apply, hπ_ker]
        exact Ideal.subset_span ⟨(j, m), rfl⟩
      rw [← h_uncoord_coord R_q (MvPolynomial.aeval Z_res (g_rel j)), h_coord_zero, map_zero]
    let η : C →ₐ[A] TensorProduct R A R_q :=
      AlgHom.liftOfSurjective f hf_surj (MvPolynomial.aeval Z_res) h_ker
    have hη_apply : ∀ P : MvPolynomial (Fin n) A, η (f P) = MvPolynomial.aeval Z_res P :=
      AlgHom.liftOfSurjective_apply f hf_surj (MvPolynomial.aeval Z_res) h_ker
    refine ⟨η, fun B _ _ => ?_⟩
    let Φ : (R_q →ₐ[R] B) → (C →ₐ[A] TensorProduct R A B) :=
      fun φ => (Algebra.TensorProduct.map (AlgHom.id A A) φ).comp η
    have hΨ_ex : ∀ ψ : C →ₐ[A] TensorProduct R A B,
        ∃ φ : R_q →ₐ[R] B,
          φ.comp π_res =
            MvPolynomial.aeval
              (fun idx : Fin n × Fin δ => coord B (ψ (f (MvPolynomial.X idx.1))) idx.2) := by
      intro ψ
      let t_ψ : Fin n × Fin δ → B := fun idx => coord B (ψ (f (MvPolynomial.X idx.1))) idx.2
      let α_ψ : MvPolynomial (Fin n × Fin δ) R →ₐ[R] B := MvPolynomial.aeval t_ψ
      have h_Z_eval : ∀ k : Fin n,
          (Algebra.TensorProduct.map (AlgHom.id A A) α_ψ) (Z k) = ψ (f (MvPolynomial.X k)) := by
        intro k
        dsimp [Z]
        rw [h_uncoord_apply, map_sum]
        simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, α_ψ, MvPolynomial.aeval_X]
        change ∑ x : Fin δ, b x ⊗ₜ[R] coord B (ψ (f (MvPolynomial.X k))) x = _
        rw [← h_uncoord_apply, h_uncoord_coord]
      have h_comp_eq : (Algebra.TensorProduct.map (AlgHom.id A A) α_ψ).comp (MvPolynomial.aeval Z) =
          ψ.comp f := by
        rw [h_aeval_map B α_ψ]
        apply MvPolynomial.algHom_ext
        intro k
        simp only [AlgHom.comp_apply, MvPolynomial.aeval_X, h_Z_eval k]
      have h_le : I_res ≤ RingHom.ker α_ψ.toRingHom := by
        rw [Ideal.span_le, Set.range_subset_iff]
        rintro ⟨j, m⟩
        rw [SetLike.mem_coe, RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
        dsimp [gen_res]
        rw [← h_coord_map _ B α_ψ (MvPolynomial.aeval Z (g_rel j)) m]
        have hg_ker : f (g_rel j) = 0 := by
          have hg_mem : g_rel j ∈ RingHom.ker f.toRingHom := by
            rw [← hs_range]
            exact Ideal.subset_span ⟨j, rfl⟩
          exact hg_mem
        have h_eval_g : (Algebra.TensorProduct.map (AlgHom.id A A) α_ψ)
            (MvPolynomial.aeval Z (g_rel j)) = ψ (f (g_rel j)) :=
          AlgHom.congr_fun h_comp_eq (g_rel j)
        rw [h_eval_g, hg_ker, map_zero, map_zero, Pi.zero_apply]
      exact hπ_lift B α_ψ (fun p_pol hp => h_le hp)
    let Ψ : (C →ₐ[A] TensorProduct R A B) → (R_q →ₐ[R] B) :=
      fun ψ => Classical.choose (hΨ_ex ψ)
    have hΨ_spec : ∀ ψ : C →ₐ[A] TensorProduct R A B,
        (Ψ ψ).comp π_res =
          MvPolynomial.aeval
            (fun idx : Fin n × Fin δ => coord B (ψ (f (MvPolynomial.X idx.1))) idx.2) :=
      fun ψ => Classical.choose_spec (hΨ_ex ψ)
    refine Function.bijective_iff_has_inverse.mpr ⟨Ψ, ?_, ?_⟩
    · intro φ
      ext x_q
      obtain ⟨P_pol, rfl⟩ := hπ_surj x_q
      change ((Ψ (Φ φ)).comp π_res) P_pol = (φ.comp π_res) P_pol
      congr 1
      rw [hΨ_spec (Φ φ)]
      apply MvPolynomial.algHom_ext
      rintro ⟨k, l⟩
      simp only [MvPolynomial.aeval_X, AlgHom.comp_apply]
      have h_phi_X : (Φ φ) (f (MvPolynomial.X k)) =
          uncoord B (fun l' => φ (π_res (MvPolynomial.X (k, l')))) := by
        dsimp [Φ]
        rw [hη_apply, MvPolynomial.aeval_X]
        dsimp [Z_res, Z]
        rw [h_uncoord_apply, map_sum, map_sum, h_uncoord_apply]
        simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
      rw [h_phi_X, h_coord_uncoord]
    · intro ψ
      ext c
      obtain ⟨P, rfl⟩ := hf_surj c
      change ((Φ (Ψ ψ)).comp f) P = (ψ.comp f) P
      congr 1
      apply MvPolynomial.algHom_ext
      intro k
      simp only [AlgHom.comp_apply, Φ, hη_apply, MvPolynomial.aeval_X]
      dsimp [Z_res, Z]
      rw [h_uncoord_apply, map_sum, map_sum]
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
      have h_psi_X : ∀ x : Fin δ,
          (Ψ ψ) (π_res (MvPolynomial.X (k, x))) = coord B (ψ (f (MvPolynomial.X k))) x := by
        intro x
        have h_ev := AlgHom.congr_fun (hΨ_spec ψ) (MvPolynomial.X (k, x))
        simpa only [AlgHom.comp_apply, MvPolynomial.aeval_X] using h_ev
      simp_rw [h_psi_X]
      rw [← h_uncoord_apply, h_uncoord_coord]
  have hStep3 :
      ∀ (R_res : Type u) [CommRing R_res] [Algebra R R_res] [Algebra.FormallyEtale A C]
        (coord : ∀ (B : Type u) [CommRing B] [Algebra R B], TensorProduct R A B →ₗ[R] (Fin δ → B))
        (uncoord : ∀ (B : Type u) [CommRing B] [Algebra R B], (Fin δ → B) →ₗ[R] TensorProduct R A B),
        (∀ (B : Type u) [CommRing B] [Algebra R B] (v : Fin δ → B),
          uncoord B v = ∑ m : Fin δ, b m ⊗ₜ[R] v m) →
        (∀ (B : Type u) [CommRing B] [Algebra R B] (w : TensorProduct R A B),
          uncoord B (coord B w) = w) →
        (∀ (B₁ B₂ : Type u) [CommRing B₁] [Algebra R B₁] [CommRing B₂] [Algebra R B₂]
          (h : B₁ →ₐ[R] B₂) (w : TensorProduct R A B₁) (m : Fin δ),
          coord B₂ ((Algebra.TensorProduct.map (AlgHom.id A A) h) w) m = h (coord B₁ w m)) →
        ∀ (η_univ : C →ₐ[A] TensorProduct R A R_res),
          (∀ (B : Type u) [CommRing B] [Algebra R B],
            Function.Bijective
              (fun φ : R_res →ₐ[R] B =>
                (Algebra.TensorProduct.map (AlgHom.id A A) φ).comp η_univ)) →
          Algebra.FormallyEtale R R_res := by
    intro R_res _ _ _ coord uncoord h_uncoord_apply h_uncoord_coord h_coord_map η_univ hUniv
    classical
    rw [Algebra.FormallyEtale.iff_comp_bijective]
    intro B _ _ I hI
    let q_R : B →ₐ[R] B ⧸ I := Ideal.Quotient.mkₐ R I
    let q_A : TensorProduct R A B →ₐ[A] TensorProduct R A (B ⧸ I) :=
      Algebra.TensorProduct.map (AlgHom.id A A) q_R
    have hq_surj : Function.Surjective q_A := by
      intro u
      let x : Fin δ → B := fun m =>
        Classical.choose (Ideal.Quotient.mk_surjective (coord (B ⧸ I) u m))
      have hx : ∀ m : Fin δ, q_R (x m) = coord (B ⧸ I) u m :=
        fun m => Classical.choose_spec (Ideal.Quotient.mk_surjective (coord (B ⧸ I) u m))
      refine ⟨uncoord B x, ?_⟩
      rw [h_uncoord_apply, map_sum]
      simp only [q_A, Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hx]
      rw [← h_uncoord_apply, h_uncoord_coord]
    let K : Ideal (TensorProduct R A B) := RingHom.ker q_A
    have hK_le : K ≤ Ideal.map Algebra.TensorProduct.includeRight.toRingHom I := by
      intro w hw
      rw [RingHom.mem_ker] at hw
      rw [← h_uncoord_coord B w, h_uncoord_apply]
      apply Ideal.sum_mem
      intro m _
      have hm_I : coord B w m ∈ I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        change q_R (coord B w m) = 0
        rw [← h_coord_map B (B ⧸ I) q_R w m, hw, map_zero, Pi.zero_apply]
      have h_fac : b m ⊗ₜ[R] coord B w m =
          (b m ⊗ₜ[R] (1 : B)) * Algebra.TensorProduct.includeRight (coord B w m) := by
        simp only [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
      rw [h_fac]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ hm_I)
    have hK_sq : K ^ 2 = ⊥ := by
      rw [eq_bot_iff]
      calc
        K ^ 2 = K * K := sq K
        _ ≤ Ideal.map Algebra.TensorProduct.includeRight.toRingHom I *
              Ideal.map Algebra.TensorProduct.includeRight.toRingHom I :=
            Submodule.mul_le.mpr fun x hx y hy => Ideal.mul_mem_mul (hK_le hx) (hK_le hy)
        _ = Ideal.map Algebra.TensorProduct.includeRight.toRingHom I ^ 2 := (sq _).symm
        _ = Ideal.map Algebra.TensorProduct.includeRight.toRingHom (I ^ 2) := (Ideal.map_pow _ _ 2).symm
        _ = ⊥ := by rw [hI, Ideal.map_bot]
    let e_K : (TensorProduct R A B ⧸ K) ≃ₐ[A] TensorProduct R A (B ⧸ I) :=
      Ideal.quotientKerAlgEquivOfSurjective hq_surj
    have hqA_fac : q_A = e_K.toAlgHom.comp (Ideal.Quotient.mkₐ A K) := by
      ext w
      rfl
    have h_mkK_bij : Function.Bijective
        ((Ideal.Quotient.mkₐ A K).comp : (C →ₐ[A] TensorProduct R A B) → _) :=
      Algebra.FormallyEtale.comp_bijective A C K hK_sq
    have h_eK_bij : Function.Bijective
        (e_K.toAlgHom.comp : (C →ₐ[A] TensorProduct R A B ⧸ K) → _) := by
      refine Function.bijective_iff_has_inverse.mpr ⟨e_K.symm.toAlgHom.comp, ?_, ?_⟩
      · intro g; ext c; exact e_K.symm_apply_apply (g c)
      · intro g; ext c; exact e_K.apply_symm_apply (g c)
    have h_qA_bij : Function.Bijective (q_A.comp : (C →ₐ[A] TensorProduct R A B) → _) := by
      have h_comp_fn : (q_A.comp : (C →ₐ[A] TensorProduct R A B) → _) =
          (e_K.toAlgHom.comp) ∘ ((Ideal.Quotient.mkₐ A K).comp) := by
        funext g
        rw [hqA_fac]
        rfl
      rw [h_comp_fn]
      exact h_eK_bij.comp h_mkK_bij
    let Φ_B : (R_res →ₐ[R] B) → (C →ₐ[A] TensorProduct R A B) :=
      fun φ => (Algebra.TensorProduct.map (AlgHom.id A A) φ).comp η_univ
    let Φ_BI : (R_res →ₐ[R] B ⧸ I) → (C →ₐ[A] TensorProduct R A (B ⧸ I)) :=
      fun φ => (Algebra.TensorProduct.map (AlgHom.id A A) φ).comp η_univ
    have h_comm_sq : Φ_BI ∘ q_R.comp = q_A.comp ∘ Φ_B := by
      funext φ
      dsimp [Φ_BI, Φ_B, q_A]
      ext c
      have h_map : Algebra.TensorProduct.map (AlgHom.id A A) (q_R.comp φ) =
          (Algebra.TensorProduct.map (AlgHom.id A A) q_R).comp
            (Algebra.TensorProduct.map (AlgHom.id A A) φ) := by
        rw [← Algebra.TensorProduct.map_comp, AlgHom.id_comp]
      simp only [AlgHom.comp_apply, h_map]
    have h_lhs_bij : Function.Bijective (Φ_BI ∘ q_R.comp) := by
      rw [h_comm_sq]
      exact h_qA_bij.comp (hUniv B)
    let e_BI := Equiv.ofBijective Φ_BI (hUniv (B ⧸ I))
    have h_qR_eq : (q_R.comp : (R_res →ₐ[R] B) → _) = e_BI.symm ∘ (Φ_BI ∘ q_R.comp) := by
      funext φ
      exact (e_BI.symm_apply_apply (q_R.comp φ)).symm
    rw [h_qR_eq]
    exact e_BI.symm.bijective.comp h_lhs_bij
  have hStep4 :
      ∀ (Ω D : Type u) [Field Ω] [IsAlgClosed Ω]
        [CommRing D] [Algebra A D] [Algebra Ω D] [Module.Finite Ω D]
        [Algebra.Etale A C],
        Nonempty (C →ₐ[A] D) := by
    intro Ω D _ _ _ _ _ _ _
    classical
    have hFieldSplit : ∀ (F C_F : Type u) [Field F] [IsAlgClosed F]
        [CommRing C_F] [Algebra F C_F] [Nontrivial C_F] [Algebra.Etale F C_F],
        Nonempty (C_F →ₐ[F] F) := by
      intro F C_F _ _ _ _ _ _
      obtain ⟨I_idx, _, Ai, hField_i, hAlg_i, e_F, hMod_i⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod F C_F).mp inferInstance
      letI : ∀ i, Field (Ai i) := hField_i
      letI : ∀ i, Algebra F (Ai i) := hAlg_i
      have hNonempty_I : Nonempty I_idx := by
        by_contra hEmpty
        rw [not_nonempty_iff] at hEmpty
        have _ : Subsingleton C_F := e_F.injective.subsingleton
        exact false_of_nontrivial_of_subsingleton C_F
      obtain ⟨i₀⟩ := hNonempty_I
      have _ : Module.Finite F (Ai i₀) := (hMod_i i₀).1
      have _ : Algebra.IsIntegral F (Ai i₀) := Algebra.IsIntegral.of_finite F (Ai i₀)
      have hBij_i₀ : Function.Bijective (algebraMap F (Ai i₀)) :=
        IsAlgClosed.algebraMap_bijective_of_isIntegral
      let e_i₀ : Ai i₀ ≃ₐ[F] F :=
        (AlgEquiv.ofBijective (Algebra.ofId F (Ai i₀)) hBij_i₀).symm
      exact ⟨e_i₀.toAlgHom.comp ((Pi.evalAlgHom F Ai i₀).comp e_F.toAlgHom)⟩
    have hBaseFieldSplit : ∀ (D' F C_D : Type u) [CommRing D'] [Field F] [IsAlgClosed F]
        [Algebra D' F] [CommRing C_D] [Algebra D' C_D]
        [Module.FaithfullyFlat D' C_D] [Algebra.Etale D' C_D],
        Nonempty (C_D →ₐ[D'] F) := by
      intro D' F C_D _ _ _ _ _ _ _ _
      have _ : Nontrivial (TensorProduct D' F C_D) :=
        Module.FaithfullyFlat.rTensor_nontrivial D' C_D F
      obtain ⟨proj_F⟩ := hFieldSplit F (TensorProduct D' F C_D)
      let inc_CD : C_D →ₐ[D'] TensorProduct D' F C_D := Algebra.TensorProduct.includeRight
      exact ⟨(proj_F.restrictScalars D').comp inc_CD⟩
    have _ : IsArtinianRing D := IsArtinianRing.of_finite Ω D
    have _ : Module.FaithfullyFlat A C := Module.FaithfullyFlat.of_comap_surjective hSurj
    have hCD_sec : ∀ (C_D : Type u) [CommRing C_D] [Algebra D C_D]
        [Module.FaithfullyFlat D C_D] [Algebra.Etale D C_D],
        Nonempty (C_D →ₐ[D] D) := by
      intro C_D _ _ _ _
      have hσ_ex : ∀ 𝔪 : MaximalSpectrum D, Nonempty (C_D →ₐ[D] D ⧸ 𝔪.asIdeal) := by
        intro 𝔪
        have _ : 𝔪.asIdeal.IsMaximal := 𝔪.isMaximal
        letI : Field (D ⧸ 𝔪.asIdeal) := Ideal.Quotient.field 𝔪.asIdeal
        have _ : Module.Finite Ω (D ⧸ 𝔪.asIdeal) :=
          Module.Finite.of_surjective (Ideal.Quotient.mkₐ Ω 𝔪.asIdeal).toLinearMap
            Ideal.Quotient.mk_surjective
        have _ : Algebra.IsIntegral Ω (D ⧸ 𝔪.asIdeal) :=
          Algebra.IsIntegral.of_finite Ω (D ⧸ 𝔪.asIdeal)
        have hBij_Ω_F : Function.Bijective (algebraMap Ω (D ⧸ 𝔪.asIdeal)) :=
          IsAlgClosed.algebraMap_bijective_of_isIntegral
        have _ : IsAlgClosed (D ⧸ 𝔪.asIdeal) :=
          IsAlgClosed.of_ringEquiv Ω (D ⧸ 𝔪.asIdeal)
            (RingEquiv.ofBijective (algebraMap Ω (D ⧸ 𝔪.asIdeal)) hBij_Ω_F)
        exact hBaseFieldSplit D (D ⧸ 𝔪.asIdeal) C_D
      let σ : ∀ 𝔪 : MaximalSpectrum D, C_D →ₐ[D] D ⧸ 𝔪.asIdeal :=
        fun 𝔪 => Classical.choice (hσ_ex 𝔪)
      let ψ_pi : C_D →ₐ[D] (∀ 𝔪 : MaximalSpectrum D, D ⧸ 𝔪.asIdeal) :=
        Pi.algHom D (fun 𝔪 : MaximalSpectrum D => D ⧸ 𝔪.asIdeal) σ
      let ψ_red : C_D →ₐ[D] D ⧸ nilradical D :=
        (IsArtinianRing.quotNilradicalEquivPi D).symm.toAlgHom.comp ψ_pi
      exact ⟨Algebra.FormallySmooth.lift (nilradical D) IsArtinianRing.isNilpotent_nilradical ψ_red⟩
    have _ : Module.FaithfullyFlat D (TensorProduct A D C) :=
      Module.FaithfullyFlat.instTensorProduct A C D
    obtain ⟨ψ_D⟩ := hCD_sec (TensorProduct A D C)
    exact ⟨{ ψ_D.toRingHom.comp Algebra.TensorProduct.includeRight.toRingHom with
      commutes' := fun a => by
        simp only [RingHom.toFun_eq_coe, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe]
        have h_inc : (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A D C)
            (algebraMap A C a) = algebraMap D (TensorProduct A D C) (algebraMap A D a) := by
          rw [AlgHom.commutes, IsScalarTower.algebraMap_apply A D (TensorProduct A D C) a]
        exact (congrArg ψ_D h_inc).trans (ψ_D.commutes (algebraMap A D a)) }⟩
  have hStep5 :
      ∀ (R_res : Type u) [CommRing R_res] [Algebra R R_res]
        (hEt_res : Algebra.Etale R R_res)
        (η_univ : C →ₐ[A] TensorProduct R A R_res)
        (hUniv : ∀ (B : Type u) [CommRing B] [Algebra R B],
          Function.Bijective
            (fun φ : R_res →ₐ[R] B =>
              (Algebra.TensorProduct.map (AlgHom.id A A) φ).comp η_univ))
        (hArtSec : ∀ (Ω D : Type u) [Field Ω] [IsAlgClosed Ω]
          [CommRing D] [Algebra A D] [Algebra Ω D] [Module.Finite Ω D],
          Nonempty (C →ₐ[A] D)),
        ∃ (R' : CommRingCat.{u}) (f_R : Quiver.Hom (CommRingCat.of R) R'),
          RingHom.Etale f_R.hom ∧
          (∃ p' : PrimeSpectrum ↑R', PrimeSpectrum.comap f_R.hom p' = p) ∧
          ∀ (S : Type u) [CommRing S] (α_A : A →+* S) (α_R' : ↑R' →+* S),
            (∀ r : R, α_A (algebraMap R A r) = α_R' (f_R.hom r)) →
            ∃ ψ_S : C →+* S, ∀ a : A, ψ_S (algebraMap A C a) = α_A a := by
    intro R_res _ _ hEt_res η_univ hUniv hArtSec
    have hGeomLift : ∀ (κ Ω : Type u) [Field κ] [Algebra R κ]
        [Field Ω] [IsAlgClosed Ω] [Algebra κ Ω] [Algebra R Ω] [IsScalarTower R κ Ω],
        RingHom.ker (algebraMap R κ) = p.asIdeal →
        ∃ p' : PrimeSpectrum R_res, PrimeSpectrum.comap (algebraMap R R_res) p' = p := by
      intro κ Ω _ _ _ _ _ _ _ hker_κ
      let b_Ω : Module.Basis (Fin δ) Ω (TensorProduct R Ω A) := Algebra.TensorProduct.basis Ω b
      have _ : Module.Finite Ω (TensorProduct R Ω A) := Module.Finite.of_basis b_Ω
      letI : Algebra A (TensorProduct R Ω A) :=
        Algebra.TensorProduct.includeRight.toRingHom.toAlgebra
      obtain ⟨ψ₀⟩ := hArtSec Ω (TensorProduct R Ω A)
      let ψ_Ω : C →ₐ[A] TensorProduct R A Ω :=
        { (Algebra.TensorProduct.comm R Ω A).toRingHom.comp ψ₀.toRingHom with
          commutes' := fun a => by
            simp only [RingHom.toFun_eq_coe, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
              RingHom.coe_coe, ψ₀.commutes a]
            rfl }
      obtain ⟨τ_Ω, -⟩ := (hUniv Ω).2 ψ_Ω
      refine ⟨⟨RingHom.ker τ_Ω.toRingHom, RingHom.ker_isPrime τ_Ω.toRingHom⟩, ?_⟩
      ext r
      change τ_Ω (algebraMap R R_res r) = 0 ↔ r ∈ p.asIdeal
      rw [τ_Ω.commutes r, IsScalarTower.algebraMap_apply R κ Ω r]
      rw [map_eq_zero_iff (algebraMap κ Ω) (RingHom.injective (algebraMap κ Ω))]
      rw [← RingHom.mem_ker, hker_κ]
    let R' : CommRingCat.{u} := CommRingCat.of R_res
    let f_R : Quiver.Hom (CommRingCat.of R) R' := CommRingCat.ofHom (algebraMap R R_res)
    refine ⟨R', f_R, RingHom.etale_algebraMap.mpr hEt_res,
      hGeomLift p.asIdeal.ResidueField (AlgebraicClosure p.asIdeal.ResidueField)
        (Ideal.ker_algebraMap_residueField p.asIdeal), ?_⟩
    intro S _ α_A α_R' h_comm
    letI : Algebra R S := (α_R'.comp (algebraMap R R_res)).toAlgebra
    let α_A_alg : A →ₐ[R] S := { α_A with commutes' := h_comm }
    let α_R'_alg : R_res →ₐ[R] S := { α_R' with commutes' := fun _ => rfl }
    let μ_S : TensorProduct R A R_res →ₐ[R] S :=
      Algebra.TensorProduct.lift α_A_alg α_R'_alg (fun _ _ => Commute.all _ _)
    refine ⟨μ_S.toRingHom.comp η_univ.toRingHom, fun a => ?_⟩
    simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    rw [η_univ.commutes a, Algebra.TensorProduct.algebraMap_apply,
      Algebra.TensorProduct.lift_tmul]
    simp [α_A_alg, α_R'_alg]
  obtain ⟨coord, uncoord, _, h_uncoord_apply, h_coord_uncoord, h_uncoord_coord, h_coord_map⟩ :=
    hStep1
  have hFP_AC : Algebra.FinitePresentation A C := hEt.finitePresentation
  have hFE_AC : Algebra.FormallyEtale A C := hEt.formallyEtale
  obtain ⟨R_res, hComm_res, hAlg_res, hFP_res, η_univ, hUniv⟩ :=
    @hStep2 hFP_AC coord uncoord h_uncoord_apply h_coord_uncoord h_uncoord_coord h_coord_map
  have hFE_res : @Algebra.FormallyEtale R R_res _ hComm_res hAlg_res :=
    @hStep3 R_res hComm_res hAlg_res hFE_AC coord uncoord h_uncoord_apply h_uncoord_coord
      h_coord_map η_univ hUniv
  have hEt_res : @Algebra.Etale R R_res _ hComm_res hAlg_res :=
    @Algebra.Etale.mk R R_res _ hComm_res hAlg_res hFE_res hFP_res
  exact @hStep5 R_res hComm_res hAlg_res hEt_res η_univ hUniv
    (fun Ω D _ _ _ _ _ _ => @hStep4 Ω D _ _ _ _ _ _ hEt)

theorem weil_finite_free_etale_pushforward_preserves_colimits (δ : ℕ) (hδ : 1 ≤ δ)
    {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
    (hf_free : WeilTopDegFiniteLocallyFreeOfRank δ f)
    (hWeilRes : ∀ (R A C : Type u) [CommRing R] [CommRing A] [CommRing C]
      [Algebra R A] [Algebra A C],
      Module.Basis (Fin δ) R A →
      Algebra.Etale A C →
      (∀ q : PrimeSpectrum A, ∃ Q : PrimeSpectrum C,
        PrimeSpectrum.comap (algebraMap A C) Q = q) →
      ∀ p : PrimeSpectrum R,
        ∃ (R' : CommRingCat.{u}) (f_R : Quiver.Hom (CommRingCat.of R) R'),
          RingHom.Etale f_R.hom ∧
          (∃ p' : PrimeSpectrum ↑R', PrimeSpectrum.comap f_R.hom p' = p) ∧
          ∀ (S : Type u) [CommRing S] (α_A : A →+* S) (α_R' : ↑R' →+* S),
            (∀ r : R, α_A (algebraMap R A r) = α_R' (f_R.hom r)) →
            ∃ ψ_S : C →+* S, ∀ a : A, ψ_S (algebraMap A C a) = α_A a) :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    ∀ (hCont : B.IsContinuous J₂ J₁),
      CategoryTheory.Limits.PreservesFiniteColimits
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
          AddCommGrpCat.{u} _ J₂ J₁ hCont) :=
by
  classical
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  intro B J₁ J₂ hCont
  letI : B.IsContinuous J₂ J₁ := hCont
  let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
    AddCommGrpCat.{u} _ J₂ J₁ hCont
  let U_sh₁ := CategoryTheory.sheafToPresheaf J₁ AddCommGrpCat.{u}
  let U_sh₂ := CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}
  let W_B := (CategoryTheory.Functor.whiskeringLeft (X₂.Etale)ᵒᵖ (X₁.Etale)ᵒᵖ AddCommGrpCat.{u}).obj B.op
  haveI : CategoryTheory.Limits.PreservesFiniteLimits (U_sh₁.comp W_B) :=
    @CategoryTheory.Limits.comp_preservesFiniteLimits _ _ _ _ _ _ U_sh₁ W_B inferInstance inferInstance
  let e_push_pre : U_sh₁.comp W_B ≅ P_push.comp U_sh₂ :=
    CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _)
      (fun φ => by
        apply CategoryTheory.NatTrans.ext
        funext X
        simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.NatTrans.comp_app,
          CategoryTheory.NatTrans.id_app, Category.comp_id, Category.id_comp]
        rfl)
  haveI : CategoryTheory.Limits.PreservesFiniteLimits P_push := by
    refine CategoryTheory.Limits.preservesFiniteLimits_of_preservesFiniteLimitsOfSize P_push
      (fun (J : Type) {𝒥} hFin => ?_)
    letI : CategoryTheory.FinCategory J := hFin
    haveI : CategoryTheory.Limits.PreservesLimitsOfShape J (U_sh₁.comp W_B) := inferInstance
    haveI : CategoryTheory.Limits.PreservesLimitsOfShape J (P_push.comp U_sh₂) :=
      CategoryTheory.Limits.preservesLimitsOfShape_of_natIso e_push_pre
    exact CategoryTheory.Limits.preservesLimitsOfShape_of_reflects_of_preserves P_push U_sh₂
  haveI : CategoryTheory.Limits.PreservesBinaryBiproducts P_push :=
    CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBinaryProducts P_push
  haveI : P_push.Additive :=
    CategoryTheory.Functor.additive_of_preservesBinaryBiproducts P_push
  letI : AlgebraicGeometry.IsAffineHom f := hf_free.1.toIsAffineHom
  letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    ⟨fun _ _ hf' hg' => by haveI := hf'; haveI := hg'; infer_instance⟩
  letI : CategoryTheory.MorphismProperty.IsMultiplicative (@AlgebraicGeometry.Etale) :=
    { id_mem := fun _ => inferInstance }

  
  have hEtTop_iff :
      ∀ {X : AlgebraicGeometry.Scheme.{u}} {V : X.Etale} (S : CategoryTheory.Sieve V),
        S ∈ X.smallEtaleTopology V ↔
          ∀ x : ↥V.left, ∃ (Y : X.Etale) (h : Quiver.Hom Y V) (z : ↥Y.left),
            S.arrows h ∧ AlgebraicGeometry.Etale h.left ∧ h.left.base z = x := by
    intro X V S
    unfold AlgebraicGeometry.Scheme.smallEtaleTopology
    erw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X le_rfl,
      AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology]
    rfl

  have hSpec_appTop :
      ∀ {B₁ B₂ : CommRingCat.{u}} (g : B₁ ⟶ B₂),
        (AlgebraicGeometry.Spec.map g).appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso B₁).hom ≫ g ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso B₂).inv := by
    intro B₁ B₂ g
    rw [← Iso.cancel_iso_hom_right _ _ (AlgebraicGeometry.Scheme.ΓSpecIso B₂),
      AlgebraicGeometry.Scheme.ΓSpecIso_naturality g]
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]

  let Eℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let zHom : ∀ (M_ab : AddCommGrpCat.{u}), ↑M_ab → Quiver.Hom Eℤ M_ab :=
    fun M_ab m_el => AddCommGrpCat.ofHom
      { toFun := fun z => z.down • m_el
        map_zero' := zero_zsmul m_el
        map_add' := fun a b => add_zsmul m_el a.down b.down }
  have hzHom_comp :
      ∀ {M₁ M₂ : AddCommGrpCat.{u}} (m₁ : ↑M₁) (g : Quiver.Hom M₁ M₂),
        zHom M₁ m₁ ≫ g = zHom M₂ (g m₁) := by
    intro M₁ M₂ m₁ g
    apply AddCommGrpCat.hom_ext
    ext ⟨z⟩
    exact map_zsmul g.hom z m₁
  have hzHom_eval :
      ∀ {M₁ : AddCommGrpCat.{u}} (m₁ : ↑M₁),
        (zHom M₁ m₁) (ULift.up 1) = m₁ :=
    fun m₁ => one_zsmul m₁

  
  
  
  have hPointwiseLift :
      ∀ (𝒢₁ 𝒢₂ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
        (φ : Quiver.Hom 𝒢₁ 𝒢₂),
        CategoryTheory.Sheaf.IsLocallySurjective φ →
        ∀ (U : X₂.Etale)
          (t : ↑(𝒢₂.obj.obj (Opposite.op (B.obj U))))
          (y : ↥U.left),
          ∃ (W_y : X₂.Etale) (g_y : Quiver.Hom W_y U),
            AlgebraicGeometry.Etale g_y.left ∧
            y ∈ Set.range g_y.left.base ∧
            ∃ s_y : ↑(𝒢₁.obj.obj (Opposite.op (B.obj W_y))),
              (φ.hom.app (Opposite.op (B.obj W_y))) s_y =
                (𝒢₂.obj.map (Opposite.op (B.map g_y))) t := by
    intro 𝒢₁ 𝒢₂ φ hLoc U t y
    haveI : AlgebraicGeometry.Etale U.hom := U.prop

    
    
    
    obtain ⟨V_f, hy_Vf, hAff_Vf, hAff_Uf, M_f, hAdd_f, hMod_f, e_f, he_f, ⟨b_f⟩⟩ :=
      hf_free.2 (U.hom.base y)
    let U_f : X₁.Opens := (TopologicalSpace.Opens.map f.base).obj V_f
    let R₀_cat : CommRingCat.{u} := X₂.presheaf.obj (Opposite.op V_f)
    let A₀_cat : CommRingCat.{u} := X₁.presheaf.obj (Opposite.op U_f)
    let R₀ : Type u := ↑R₀_cat
    let A₀ : Type u := ↑A₀_cat
    letI : AddCommGroup M_f := hAdd_f
    letI : Module R₀ M_f := hMod_f
    letI : Algebra R₀ A₀ := (f.app V_f).hom.toAlgebra
    let e_lin₀ : M_f ≃ₗ[R₀] A₀ :=
      { e_f with
        map_smul' := fun r₀ m => by
          change e_f (r₀ • m) = (f.app V_f).hom r₀ * e_f m
          exact he_f r₀ m }
    let b₀ : Module.Basis (Fin δ) R₀ A₀ := b_f.map e_lin₀

    let O_in : U.left.Opens := (TopologicalSpace.Opens.map U.hom.base).obj V_f
    have hy_Oin : y ∈ O_in := hy_Vf
    obtain ⟨O_y, hAff_Oy, hy_Oy, hOy_sub⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_Oin
    let R_cat : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op O_y)
    let R : Type u := ↑R_cat
    have hy_range_Oy : y ∈ Set.range hAff_Oy.fromSpec.base := by
      rw [hAff_Oy.range_fromSpec]
      exact hy_Oy
    obtain ⟨p_y, hp_y⟩ := hy_range_Oy

    let U_R : X₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (hAff_Oy.fromSpec ≫ U.hom) inferInstance
    haveI : AlgebraicGeometry.Etale U_R.hom := U_R.prop
    let u_R : Quiver.Hom U_R U :=
      CategoryTheory.MorphismProperty.Over.homMk hAff_Oy.fromSpec rfl trivial

    have h_range_UR : Set.range U_R.hom.base ⊆ Set.range V_f.ι.base := by
      rintro _ ⟨z, rfl⟩
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      apply hOy_sub
      have hz : hAff_Oy.fromSpec.base z ∈ (O_y : Set ↥U.left) := by
        rw [← hAff_Oy.range_fromSpec]
        exact ⟨z, rfl⟩
      exact hz
    let g_RV : AlgebraicGeometry.Spec R_cat ⟶ V_f.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift V_f.ι U_R.hom h_range_UR
    have hg_RV : g_RV ≫ V_f.ι = U_R.hom :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac V_f.ι U_R.hom h_range_UR

    let ψ_R₀_R : R₀_cat ⟶ R_cat :=
      AlgebraicGeometry.Spec.preimage (g_RV ≫ hAff_Vf.isoSpec.hom)
    have h_map_R : AlgebraicGeometry.Spec.map ψ_R₀_R = g_RV ≫ hAff_Vf.isoSpec.hom :=
      AlgebraicGeometry.Spec.map_preimage (g_RV ≫ hAff_Vf.isoSpec.hom)
    letI : Algebra R₀ R := ψ_R₀_R.hom.toAlgebra

    let g₁ : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R))
    let g₂ : AlgebraicGeometry.Spec (CommRingCat.of A₀) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ A₀))
    have hg₁_eq : g₁ = g_RV ≫ hAff_Vf.isoSpec.hom := h_map_R
    have hg₂_eq : g₂ = AlgebraicGeometry.Spec.map (f.app V_f) := rfl
    have h_res_spec : (f ∣_ V_f) ≫ hAff_Vf.isoSpec.hom = hAff_Uf.isoSpec.hom ≫ g₂ := by
      rw [hAff_Vf.isoSpec_hom, hAff_Uf.isoSpec_hom, hg₂_eq]
      exact (AlgebraicGeometry.Scheme.Opens.toSpecΓ_naturality f V_f).symm

    have hPB_res : CategoryTheory.IsPullback (f ∣_ V_f) U_f.ι V_f.ι f :=
      AlgebraicGeometry.isPullback_morphismRestrict f V_f
    let p_fst : (B.obj U_R).left ⟶ AlgebraicGeometry.Spec R_cat :=
      CategoryTheory.Limits.pullback.fst U_R.hom f
    let p_snd : (B.obj U_R).left ⟶ X₁ :=
      CategoryTheory.Limits.pullback.snd U_R.hom f
    have hq_comm : (p_fst ≫ g_RV) ≫ V_f.ι = p_snd ≫ f := by
      rw [Category.assoc, hg_RV]
      exact CategoryTheory.Limits.pullback.condition
    let q_U : (B.obj U_R).left ⟶ U_f.toScheme :=
      hPB_res.lift (p_fst ≫ g_RV) p_snd hq_comm
    have hq_fst : q_U ≫ (f ∣_ V_f) = p_fst ≫ g_RV :=
      hPB_res.lift_fst (p_fst ≫ g_RV) p_snd hq_comm
    have hq_snd : q_U ≫ U_f.ι = p_snd :=
      hPB_res.lift_snd (p_fst ≫ g_RV) p_snd hq_comm
    have hPB_outer : CategoryTheory.IsPullback (q_U ≫ U_f.ι) p_fst f (g_RV ≫ V_f.ι) := by
      rw [hq_snd, hg_RV]
      exact (CategoryTheory.IsPullback.of_hasPullback U_R.hom f).flip
    have hPB_chart : CategoryTheory.IsPullback p_fst q_U g_RV (f ∣_ V_f) :=
      (CategoryTheory.IsPullback.of_right hPB_outer hq_fst hPB_res.flip).flip

    have hu_pb_comm : p_fst ≫ g₁ = (q_U ≫ hAff_Uf.isoSpec.hom) ≫ g₂ := by
      rw [hg₁_eq, ← Category.assoc, ← hq_fst, Category.assoc, h_res_spec, Category.assoc]
    let PB_spec := CategoryTheory.Limits.pullback g₁ g₂
    let u_pb : (B.obj U_R).left ⟶ PB_spec :=
      CategoryTheory.Limits.pullback.lift p_fst (q_U ≫ hAff_Uf.isoSpec.hom) hu_pb_comm
    have hv_pb_comm : CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ g_RV =
        (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ hAff_Uf.isoSpec.inv) ≫ (f ∣_ V_f) := by
      rw [← cancel_mono hAff_Vf.isoSpec.hom]
      calc
        (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ g_RV) ≫ hAff_Vf.isoSpec.hom
          = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ g₁ := by
              rw [Category.assoc, hg₁_eq]
        _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ g₂ :=
              CategoryTheory.Limits.pullback.condition
        _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ hAff_Uf.isoSpec.inv ≫
              (hAff_Uf.isoSpec.hom ≫ g₂) := by
              rw [← Category.assoc hAff_Uf.isoSpec.inv, hAff_Uf.isoSpec.inv_hom_id, Category.id_comp]
        _ = ((CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ hAff_Uf.isoSpec.inv) ≫ (f ∣_ V_f)) ≫
              hAff_Vf.isoSpec.hom := by
              rw [← h_res_spec, Category.assoc, Category.assoc]
    let v_pb : PB_spec ⟶ (B.obj U_R).left :=
      hPB_chart.lift (CategoryTheory.Limits.pullback.fst g₁ g₂)
        (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ hAff_Uf.isoSpec.inv) hv_pb_comm
    let e_pb : (B.obj U_R).left ≅ PB_spec :=
      { hom := u_pb
        inv := v_pb
        hom_inv_id := hPB_chart.hom_ext
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, hPB_chart.lift_fst, CategoryTheory.Limits.pullback.lift_fst,
              Category.id_comp])
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, hPB_chart.lift_snd, ← Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
              Iso.hom_inv_id, Category.comp_id, Category.id_comp])
        inv_hom_id := CategoryTheory.Limits.pullback.hom_ext
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              hPB_chart.lift_fst, Category.id_comp])
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← Category.assoc, hPB_chart.lift_snd, Category.assoc,
              Iso.inv_hom_id, Category.comp_id, Category.id_comp]) }

    let A : Type u := TensorProduct R₀ R A₀
    let b : Module.Basis (Fin δ) R A := Algebra.TensorProduct.basis R b₀
    let e_pull : AlgebraicGeometry.Spec (CommRingCat.of A) ≅ (B.obj U_R).left :=
      (AlgebraicGeometry.pullbackSpecIso R₀ R A₀).symm ≪≫ e_pb.symm
    have he_pull_fst : e_pull.hom ≫ p_fst =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A)) := by
      dsimp [e_pull, e_pb, v_pb]
      rw [Category.assoc, hPB_chart.lift_fst]
      exact AlgebraicGeometry.pullbackSpecIso_inv_fst R₀ R A₀

    
    
    
    let V₀ : X₁.Etale := B.obj U_R
    haveI : AlgebraicGeometry.Etale V₀.hom := V₀.prop
    haveI : CategoryTheory.Presheaf.IsLocallySurjective J₁ φ.hom := hLoc
    let t₀ : ↑(𝒢₂.obj.obj (Opposite.op V₀)) := (𝒢₂.obj.map (Opposite.op (B.map u_R))) t
    have hMem₀ : CategoryTheory.Presheaf.imageSieve φ.hom t₀ ∈ X₁.smallEtaleTopology V₀ :=
      CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem (J := J₁) (f := φ.hom) t₀
    have hPre₀ : ∀ x : ↥V₀.left,
        ∃ (Y_x : X₁.Etale) (h_x : Quiver.Hom Y_x V₀) (z_x : ↥Y_x.left),
          (CategoryTheory.Presheaf.imageSieve φ.hom t₀).arrows h_x ∧
          AlgebraicGeometry.Etale h_x.left ∧
          h_x.left.base z_x = x :=
      (hEtTop_iff _).mp hMem₀

    have h_aff_q : ∀ q : PrimeSpectrum A,
        ∃ (C_q : Type u) (hRing_q : CommRing C_q) (hAlg_q : Algebra A C_q),
          letI := hRing_q
          letI := hAlg_q
          Algebra.Etale A C_q ∧
          (∃ p_q : PrimeSpectrum C_q, PrimeSpectrum.comap (algebraMap A C_q) p_q = q) ∧
          IsOpen (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q))).base) ∧
          ∃ (hEt_Vq : AlgebraicGeometry.Etale
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫
                (e_pull.hom ≫ V₀.hom))),
            let V_q : X₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫
                (e_pull.hom ≫ V₀.hom)) hEt_Vq
            let v_q : Quiver.Hom V_q V₀ := CategoryTheory.MorphismProperty.Over.homMk
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫ e_pull.hom)
              (Category.assoc _ _ _) trivial
            ∃ s_q : ↑(𝒢₁.obj.obj (Opposite.op V_q)),
              (φ.hom.app (Opposite.op V_q)) s_q = (𝒢₂.obj.map (Opposite.op v_q)) t₀ := by
      intro q
      obtain ⟨Y_q, h_q, z_q, hSieve_q, hEt_hq, hz_q⟩ := hPre₀ (e_pull.hom.base q)
      haveI : AlgebraicGeometry.Etale h_q.left := hEt_hq
      haveI : AlgebraicGeometry.Etale Y_q.hom := Y_q.prop
      obtain ⟨W_q, hAff_Wq, hz_Wq, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := (⊤ : Y_q.left.Opens)) (x := z_q) trivial
      let C_q_cat : CommRingCat.{u} := Y_q.left.presheaf.obj (Opposite.op W_q)
      let C_q : Type u := ↑C_q_cat
      have hz_range_Wq : z_q ∈ Set.range hAff_Wq.fromSpec.base := by
        rw [hAff_Wq.range_fromSpec]
        exact hz_Wq
      obtain ⟨p_q, hp_q⟩ := hz_range_Wq
      let mor_q : AlgebraicGeometry.Spec (CommRingCat.of C_q) ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
        hAff_Wq.fromSpec ≫ h_q.left ≫ e_pull.inv
      haveI : AlgebraicGeometry.Etale mor_q := by
        dsimp [mor_q]
        infer_instance
      let ψ_q : CommRingCat.of A ⟶ CommRingCat.of C_q := AlgebraicGeometry.Spec.preimage mor_q
      have h_map_q : AlgebraicGeometry.Spec.map ψ_q = mor_q :=
        AlgebraicGeometry.Spec.map_preimage mor_q
      let alg_q : Algebra A C_q := ψ_q.hom.toAlgebra
      letI : Algebra A C_q := alg_q
      have h_ofHom_q : CommRingCat.ofHom (algebraMap A C_q) = ψ_q := rfl
      have hEt_ring_q : RingHom.Etale (algebraMap A C_q) := by
        have hEt_spec : AlgebraicGeometry.Etale
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q))) := by
          rw [h_ofHom_q, h_map_q]
          infer_instance
        exact (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec
      have hEt_alg_q : Algebra.Etale A C_q := RingHom.etale_algebraMap.mp hEt_ring_q
      have hp_comap : PrimeSpectrum.comap (algebraMap A C_q) p_q = q := by
        change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q))).base p_q = q
        rw [h_ofHom_q, h_map_q]
        change e_pull.inv.base (h_q.left.base (hAff_Wq.fromSpec.base p_q)) = q
        rw [hp_q, hz_q]
        change (e_pull.hom ≫ e_pull.inv).base q = q
        rw [e_pull.hom_inv_id]
        rfl
      have hOpen_q : IsOpen (Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q))).base) := by
        rw [h_ofHom_q, h_map_q, ← Set.image_univ]
        exact (AlgebraicGeometry.Scheme.Hom.isOpenMap mor_q) Set.univ isOpen_univ
      have h_comp_pull : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫ e_pull.hom =
          hAff_Wq.fromSpec ≫ h_q.left := by
        rw [h_ofHom_q, h_map_q]
        dsimp [mor_q]
        rw [Category.assoc, Category.assoc, e_pull.inv_hom_id, Category.comp_id]
      have hEt_Vq : AlgebraicGeometry.Etale
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫ (e_pull.hom ≫ V₀.hom)) := by
        rw [← Category.assoc, h_comp_pull, Category.assoc, CategoryTheory.MorphismProperty.Over.w h_q]
        infer_instance
      let V_q : X₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫ (e_pull.hom ≫ V₀.hom)) hEt_Vq
      let v_q : Quiver.Hom V_q V₀ := CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫ e_pull.hom)
        (Category.assoc _ _ _) trivial
      let w_q : Quiver.Hom V_q Y_q := CategoryTheory.MorphismProperty.Over.homMk
        hAff_Wq.fromSpec
        (by
          change hAff_Wq.fromSpec ≫ Y_q.hom =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C_q)) ≫ (e_pull.hom ≫ V₀.hom)
          rw [← Category.assoc, h_comp_pull, Category.assoc, CategoryTheory.MorphismProperty.Over.w h_q])
        trivial
      have hv_eq : w_q ≫ h_q = v_q := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext
        · exact h_comp_pull.symm
        · exact Subsingleton.elim _ _
      have h_arr_vq : (CategoryTheory.Presheaf.imageSieve φ.hom t₀).arrows v_q := by
        rw [← hv_eq]
        exact (CategoryTheory.Presheaf.imageSieve φ.hom t₀).downward_closed hSieve_q w_q
      rw [CategoryTheory.Presheaf.imageSieve_apply] at h_arr_vq
      obtain ⟨s_q, hs_q⟩ := h_arr_vq
      exact ⟨C_q, inferInstance, alg_q, hEt_alg_q, ⟨p_q, hp_comap⟩, hOpen_q, hEt_Vq, s_q, hs_q⟩

    choose C_q hRing_q hAlg_q hEt_q hSurj_q hOpen_q hEt_Vq s_q hs_q using h_aff_q
    letI : ∀ q, CommRing (C_q q) := hRing_q
    letI : ∀ q, Algebra A (C_q q) := hAlg_q
    letI : ∀ q, Algebra.Etale A (C_q q) := hEt_q

    let U_open : PrimeSpectrum A → Set ↥(AlgebraicGeometry.Spec (CommRingCat.of A)) := fun q =>
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (C_q q)))).base
    have hCov_univ : (Set.univ : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of A))) ⊆
        ⋃ q : PrimeSpectrum A, U_open q := by
      intro q _
      rw [Set.mem_iUnion]
      obtain ⟨p_q, hp_q⟩ := hSurj_q q
      exact ⟨q, p_q, hp_q⟩
    obtain ⟨F_sub, hF_cov⟩ :=
      isCompact_univ.elim_finite_subcover U_open hOpen_q hCov_univ

    let m : ℕ := Fintype.card ↥F_sub
    let idx : Fin m ≃ ↥F_sub := (Fintype.equivFin ↥F_sub).symm
    let C_fam : Fin m → Type u := fun k => C_q (idx k).1
    letI : ∀ k : Fin m, CommRing (C_fam k) := fun k => hRing_q (idx k).1
    letI : ∀ k : Fin m, Algebra A (C_fam k) := fun k => hAlg_q (idx k).1
    letI : ∀ k : Fin m, Algebra.Etale A (C_fam k) := fun k => hEt_q (idx k).1
    letI : ∀ k : Fin m, Algebra.FormallyEtale A (C_fam k) := fun _ => inferInstance
    letI : ∀ k : Fin m, Algebra.FinitePresentation A (C_fam k) := fun _ => inferInstance

    let C : Type u := ∀ k : Fin m, C_fam k
    have hFE_C : Algebra.FormallyEtale A C :=
      (Algebra.FormallyEtale.pi_iff C_fam).mpr (fun _ => inferInstance)
    have hFP_C : Algebra.FinitePresentation A C := inferInstance
    have hEt_C : Algebra.Etale A C := @Algebra.Etale.mk A C _ _ _ hFE_C hFP_C

    have hSurj_C : ∀ q : PrimeSpectrum A, ∃ Q : PrimeSpectrum C,
        PrimeSpectrum.comap (algebraMap A C) Q = q := by
      intro q
      let q_spec : ↥(AlgebraicGeometry.Spec (CommRingCat.of A)) := q
      have hq_mem : q_spec ∈ ⋃ q₀ ∈ F_sub, U_open q₀ := hF_cov (Set.mem_univ q_spec)
      rw [Set.mem_iUnion₂] at hq_mem
      obtain ⟨q₀, hq₀_mem, P₀, hP₀⟩ := hq_mem
      obtain ⟨k, hk⟩ := idx.surjective ⟨q₀, hq₀_mem⟩
      have hk_val : q₀ = (idx k).1 := (congrArg Subtype.val hk).symm
      clear hk hq₀_mem
      subst hk_val
      let Q_k : PrimeSpectrum (C_fam k) := P₀
      have hQk_eq : PrimeSpectrum.comap (algebraMap A (C_fam k)) Q_k = q := hP₀
      let π_k : C →+* C_fam k := Pi.evalRingHom C_fam k
      refine ⟨PrimeSpectrum.comap π_k Q_k, ?_⟩
      have h_comp_alg : π_k.comp (algebraMap A C) = algebraMap A (C_fam k) :=
        RingHom.ext (fun _ => rfl)
      rw [← PrimeSpectrum.comap_comp_apply, h_comp_alg, hQk_eq]

    
    haveI : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
        (RingHom.etale_algebraMap.mpr hEt_C)
    have hEt_VC : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ (e_pull.hom ≫ V₀.hom)) :=
      inferInstance
    let V_C : X₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ (e_pull.hom ≫ V₀.hom)) hEt_VC
    let v_C : Quiver.Hom V_C V₀ := CategoryTheory.MorphismProperty.Over.homMk
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e_pull.hom)
      (Category.assoc _ _ _) trivial

    let V_fam : Fin m → X₁.Etale := fun k =>
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (C_fam k))) ≫
          (e_pull.hom ≫ V₀.hom)) (hEt_Vq (idx k).1)
    let v_fam : ∀ k : Fin m, Quiver.Hom (V_fam k) V₀ := fun k =>
      CategoryTheory.MorphismProperty.Over.homMk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (C_fam k))) ≫ e_pull.hom)
        (Category.assoc _ _ _) trivial
    let s_fam : ∀ k : Fin m, ↑(𝒢₁.obj.obj (Opposite.op (V_fam k))) := fun k => s_q (idx k).1
    have hs_fam : ∀ k : Fin m,
        (φ.hom.app (Opposite.op (V_fam k))) (s_fam k) = (𝒢₂.obj.map (Opposite.op (v_fam k))) t₀ :=
      fun k => hs_q (idx k).1

    let e_idem : Fin m → C := fun k => Pi.single k 1
    let π_eval : ∀ k : Fin m, C →+* C_fam k := fun k => Pi.evalRingHom C_fam k
    let ι_sch : ∀ k : Fin m,
        AlgebraicGeometry.Spec (CommRingCat.of (C_fam k)) ⟶ AlgebraicGeometry.Spec (CommRingCat.of C) :=
      fun k => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (π_eval k))

    have hOpenImm_ι : ∀ k : Fin m, AlgebraicGeometry.IsOpenImmersion (ι_sch k) := by
      intro k
      letI : Algebra C (C_fam k) := (π_eval k).toAlgebra
      haveI : IsLocalization.Away (e_idem k) (C_fam k) := by
        apply IsLocalization.Away.mk (e_idem k)
        · change IsUnit ((Pi.single k (1 : C_fam k) : ∀ j, C_fam j) k)
          rw [Pi.single_eq_same]
          exact isUnit_one
        · intro z
          refine ⟨0, Pi.single k z, ?_⟩
          rw [pow_zero, mul_one]
          change z = (Pi.single k z : ∀ j, C_fam j) k
          exact (Pi.single_eq_same k z).symm
        · intro c₁ c₂ hc
          refine ⟨1, ?_⟩
          funext j
          rw [pow_one]
          change (Pi.single k (1 : C_fam k) : ∀ i, C_fam i) j * c₁ j =
            (Pi.single k (1 : C_fam k) : ∀ i, C_fam i) j * c₂ j
          by_cases hjk : j = k
          · subst hjk
            have hc' : c₁ j = c₂ j := hc
            simp [hc']
          · simp [hjk]
      exact AlgebraicGeometry.IsOpenImmersion.of_isLocalization (e_idem k)

    have h_ι_alg : ∀ k : Fin m,
        ι_sch k ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (C_fam k))) := by
      intro k
      dsimp [ι_sch]
      rw [← AlgebraicGeometry.Spec.map_comp]
      rfl

    let ι_mor : ∀ k : Fin m, Quiver.Hom (V_fam k) V_C := fun k =>
      CategoryTheory.MorphismProperty.Over.homMk (ι_sch k)
        (by
          change ι_sch k ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ (e_pull.hom ≫ V₀.hom)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (C_fam k))) ≫ (e_pull.hom ≫ V₀.hom)
          rw [← Category.assoc, h_ι_alg k])
        trivial
    have h_ι_vC : ∀ k : Fin m, ι_mor k ≫ v_C = v_fam k := by
      intro k
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · change ι_sch k ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e_pull.hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (C_fam k))) ≫ e_pull.hom
        rw [← Category.assoc, h_ι_alg k]
      · exact Subsingleton.elim _ _

    have hCov_C : CategoryTheory.Sieve.ofArrows V_fam ι_mor ∈ J₁ V_C := by
      apply (hEtTop_iff _).mpr
      intro Q
      have h_sum_one : (∑ j : Fin m, e_idem j) = (1 : C) := by
        funext j
        change (∑ x : Fin m, (Pi.single x (1 : C_fam x) : ∀ i, C_fam i)) j = (1 : C_fam j)
        rw [Finset.sum_apply, Finset.sum_eq_single j]
        · exact Pi.single_eq_same j 1
        · intro x _ hxj
          have hne : j ≠ x := Ne.symm hxj
          simp [hne]
        · intro hj
          exact False.elim (hj (Finset.mem_univ j))
      have h_not_all : ¬ ∀ k : Fin m, e_idem k ∈ Q.asIdeal := by
        intro hall
        have h1_mem : (1 : C) ∈ Q.asIdeal := by
          rw [← h_sum_one]
          exact Ideal.sum_mem Q.asIdeal (fun j _ => hall j)
        exact Q.isPrime.ne_top ((Ideal.eq_top_iff_one Q.asIdeal).mpr h1_mem)
      obtain ⟨k, hek⟩ := not_forall.mp h_not_all
      have h_single_mul : ∀ (a b : C_fam k),
          (Pi.single k (a * b) : C) = Pi.single k a * Pi.single k b := by
        intro a b
        funext j
        change (Pi.single k (a * b) : ∀ i, C_fam i) j =
          (Pi.single k a : ∀ i, C_fam i) j * (Pi.single k b : ∀ i, C_fam i) j
        by_cases hjk : j = k
        · subst hjk; simp
        · simp [hjk]
      let I_k : Ideal (C_fam k) :=
        { carrier := { z : C_fam k | (Pi.single k z : C) ∈ Q.asIdeal }
          zero_mem' := by
            change (Pi.single k 0 : C) ∈ Q.asIdeal
            rw [Pi.single_zero]
            exact Q.asIdeal.zero_mem
          add_mem' := fun {a b} ha hb => by
            change (Pi.single k (a + b) : C) ∈ Q.asIdeal
            rw [Pi.single_add]
            exact Q.asIdeal.add_mem ha hb
          smul_mem' := fun a {b} hb => by
            change (Pi.single k (a * b) : C) ∈ Q.asIdeal
            rw [h_single_mul]
            exact Q.asIdeal.mul_mem_left _ hb }
      have hIk_prime : I_k.IsPrime := by
        refine ⟨?_, ?_⟩
        · intro htop
          have h1_Ik : (1 : C_fam k) ∈ I_k := htop ▸ Submodule.mem_top
          exact hek h1_Ik
        · intro a b hab
          have hab' : (Pi.single k a : C) * Pi.single k b ∈ Q.asIdeal := by
            rw [← h_single_mul]
            exact hab
          exact Q.isPrime.mem_or_mem hab'
      let P_k : PrimeSpectrum (C_fam k) := ⟨I_k, hIk_prime⟩
      have hPk_map : (ι_mor k).left.base P_k = Q := by
        change PrimeSpectrum.comap (π_eval k) P_k = Q
        ext c
        change c k ∈ I_k ↔ c ∈ Q.asIdeal
        have h_ek_c : e_idem k * c = Pi.single k (c k) := by
          funext j
          change (Pi.single k (1 : C_fam k) : ∀ i, C_fam i) j * c j =
            (Pi.single k (c k) : ∀ i, C_fam i) j
          by_cases hjk : j = k
          · subst hjk; simp
          · simp [hjk]
        change (Pi.single k (c k) : C) ∈ Q.asIdeal ↔ c ∈ Q.asIdeal
        rw [← h_ek_c]
        constructor
        · intro hmul
          exact (Q.isPrime.mem_or_mem hmul).resolve_left hek
        · intro hc
          exact Q.asIdeal.mul_mem_left (e_idem k) hc
      haveI : AlgebraicGeometry.IsOpenImmersion (ι_sch k) := hOpenImm_ι k
      refine ⟨V_fam k, ι_mor k, P_k, CategoryTheory.Sieve.ofArrows_mk V_fam ι_mor k, ?_, hPk_map⟩
      change AlgebraicGeometry.Etale (ι_sch k)
      infer_instance

    let x_sec : ∀ k : Fin m, Quiver.Hom Eℤ (𝒢₁.obj.obj (Opposite.op (V_fam k))) :=
      fun k => zHom (𝒢₁.obj.obj (Opposite.op (V_fam k))) (s_fam k)

    have hx_compat : ∀ ⦃W : X₁.Etale⦄ ⦃k₁ k₂ : Fin m⦄
        (a_w : Quiver.Hom W (V_fam k₁)) (b_w : Quiver.Hom W (V_fam k₂)),
        a_w ≫ ι_mor k₁ = b_w ≫ ι_mor k₂ →
        x_sec k₁ ≫ 𝒢₁.obj.map a_w.op = x_sec k₂ ≫ 𝒢₁.obj.map b_w.op := by
      intro W k₁ k₂ a_w b_w hab
      have hab_left : a_w.left ≫ ι_sch k₁ = b_w.left ≫ ι_sch k₂ :=
        congrArg (fun g => g.left) hab
      by_cases hk : k₁ = k₂
      · subst hk
        haveI : AlgebraicGeometry.IsOpenImmersion (ι_sch k₁) := hOpenImm_ι k₁
        have ha_eq_b_left : a_w.left = b_w.left := (cancel_mono (ι_sch k₁)).mp hab_left
        have ha_eq_b : a_w = b_w :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext ha_eq_b_left (Subsingleton.elim _ _)
        rw [ha_eq_b]
      · have hBot : (⊥ : CategoryTheory.Sieve W) ∈ J₁ W := by
          apply (hEtTop_iff _).mpr
          intro w
          exfalso
          let P₁_w : PrimeSpectrum (C_fam k₁) := a_w.left.base w
          let P₂_w : PrimeSpectrum (C_fam k₂) := b_w.left.base w
          have hQw_eq : PrimeSpectrum.comap (π_eval k₁) P₁_w = PrimeSpectrum.comap (π_eval k₂) P₂_w := by
            change (a_w.left ≫ ι_sch k₁).base w = (b_w.left ≫ ι_sch k₂).base w
            rw [hab_left]
          have h_not_mem : e_idem k₁ ∉ (PrimeSpectrum.comap (π_eval k₁) P₁_w).asIdeal := by
            change (Pi.single k₁ (1 : C_fam k₁) : ∀ i, C_fam i) k₁ ∉ P₁_w.asIdeal
            rw [Pi.single_eq_same]
            exact fun h1_mem => P₁_w.isPrime.ne_top ((Ideal.eq_top_iff_one P₁_w.asIdeal).mpr h1_mem)
          have h_mem : e_idem k₁ ∈ (PrimeSpectrum.comap (π_eval k₂) P₂_w).asIdeal := by
            change (Pi.single k₁ (1 : C_fam k₁) : ∀ i, C_fam i) k₂ ∈ P₂_w.asIdeal
            have h0 : (Pi.single k₁ (1 : C_fam k₁) : ∀ i, C_fam i) k₂ = 0 := by
              simp [Ne.symm hk]
            rw [h0]
            exact P₂_w.asIdeal.zero_mem
          rw [hQw_eq] at h_not_mem
          exact h_not_mem h_mem
        have hTerm := CategoryTheory.Sheaf.isTerminalOfBotCover 𝒢₁ W hBot
        exact hTerm.hom_ext _ _

    let s_C_hom : Quiver.Hom Eℤ (𝒢₁.obj.obj (Opposite.op V_C)) :=
      𝒢₁.property.amalgamateOfArrows ι_mor hCov_C x_sec hx_compat
    let s_C : ↑(𝒢₁.obj.obj (Opposite.op V_C)) := s_C_hom (ULift.up 1)
    have hs_C_hom : s_C_hom ≫ φ.hom.app (Opposite.op V_C) =
        zHom (𝒢₂.obj.obj (Opposite.op V_C)) ((𝒢₂.obj.map (Opposite.op v_C)) t₀) := by
      apply 𝒢₂.property.hom_ext_ofArrows ι_mor hCov_C
      intro k
      have h_amalg_k : s_C_hom ≫ 𝒢₁.obj.map (ι_mor k).op = x_sec k :=
        𝒢₁.property.amalgamateOfArrows_map ι_mor hCov_C x_sec hx_compat k
      have h_rhs_k :
          (𝒢₂.obj.map (ι_mor k).op) ((𝒢₂.obj.map (Opposite.op v_C)) t₀) =
            (𝒢₂.obj.map (Opposite.op (v_fam k))) t₀ := by
        change (𝒢₂.obj.map v_C.op ≫ 𝒢₂.obj.map (ι_mor k).op) t₀ =
          (𝒢₂.obj.map (v_fam k).op) t₀
        rw [← 𝒢₂.obj.map_comp, ← op_comp, h_ι_vC k]
      calc
        (s_C_hom ≫ φ.hom.app (Opposite.op V_C)) ≫ 𝒢₂.obj.map (ι_mor k).op
          = s_C_hom ≫ (φ.hom.app (Opposite.op V_C) ≫ 𝒢₂.obj.map (ι_mor k).op) :=
              Category.assoc _ _ _
        _ = (s_C_hom ≫ 𝒢₁.obj.map (ι_mor k).op) ≫ φ.hom.app (Opposite.op (V_fam k)) := by
              rw [← φ.hom.naturality (ι_mor k).op, Category.assoc]
        _ = x_sec k ≫ φ.hom.app (Opposite.op (V_fam k)) := by
              rw [h_amalg_k]
        _ = zHom (𝒢₂.obj.obj (Opposite.op (V_fam k)))
              ((φ.hom.app (Opposite.op (V_fam k))) (s_fam k)) :=
              hzHom_comp (s_fam k) (φ.hom.app (Opposite.op (V_fam k)))
        _ = zHom (𝒢₂.obj.obj (Opposite.op (V_fam k)))
              ((𝒢₂.obj.map (ι_mor k).op) ((𝒢₂.obj.map (Opposite.op v_C)) t₀)) := by
              rw [hs_fam k, h_rhs_k]
        _ = zHom (𝒢₂.obj.obj (Opposite.op V_C)) ((𝒢₂.obj.map (Opposite.op v_C)) t₀) ≫
              𝒢₂.obj.map (ι_mor k).op :=
              (hzHom_comp ((𝒢₂.obj.map (Opposite.op v_C)) t₀) (𝒢₂.obj.map (ι_mor k).op)).symm
    have hs_C : (φ.hom.app (Opposite.op V_C)) s_C = (𝒢₂.obj.map (Opposite.op v_C)) t₀ := by
      have hs_C_eval := congrArg
        (fun g : Quiver.Hom Eℤ (𝒢₂.obj.obj (Opposite.op V_C)) =>
          (CategoryTheory.ConcreteCategory.hom g) (ULift.up 1)) hs_C_hom
      exact hs_C_eval.trans (hzHom_eval ((𝒢₂.obj.map (Opposite.op v_C)) t₀))

    
    
    
    obtain ⟨R', f_R, hEt_R', ⟨p', hp'⟩, hExt⟩ :=
      hWeilRes R A C b hEt_C hSurj_C p_y
    have hEt_fR : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f_R) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_R'
    haveI : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f_R) := hEt_fR
    have hEt_Wy : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f_R ≫ U_R.hom) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale)).comp_mem _ _ hEt_fR U_R.prop
    let W_y : X₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤
      (AlgebraicGeometry.Spec.map f_R ≫ U_R.hom) hEt_Wy
    let g_R : Quiver.Hom W_y U_R :=
      CategoryTheory.MorphismProperty.Over.homMk (AlgebraicGeometry.Spec.map f_R) rfl trivial
    let g_y : Quiver.Hom W_y U := g_R ≫ u_R
    have hEt_gy : AlgebraicGeometry.Etale g_y.left := by
      change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f_R ≫ hAff_Oy.fromSpec)
      infer_instance
    have hy_range : y ∈ Set.range g_y.left.base := by
      refine ⟨p', ?_⟩
      change hAff_Oy.fromSpec.base ((AlgebraicGeometry.Spec.map f_R).base p') = y
      have hp'_eq : (AlgebraicGeometry.Spec.map f_R).base p' = p_y := hp'
      rw [hp'_eq, hp_y]

    let Z_W : AlgebraicGeometry.Scheme.{u} := (B.obj W_y).left
    let S_W_cat : CommRingCat.{u} := Z_W.presheaf.obj (Opposite.op ⊤)
    let S_W : Type u := ↑S_W_cat
    let h_WA : Z_W ⟶ AlgebraicGeometry.Spec (CommRingCat.of A) :=
      (B.map g_R).left ≫ e_pull.inv
    let p_WR' : Z_W ⟶ AlgebraicGeometry.Spec R' :=
      CategoryTheory.Limits.pullback.fst W_y.hom f
    let α_A_cat : CommRingCat.of A ⟶ S_W_cat :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ h_WA.appTop
    let α_R'_cat : R' ⟶ S_W_cat :=
      (AlgebraicGeometry.Scheme.ΓSpecIso R').inv ≫ p_WR'.appTop
    let α_A : A →+* S_W := α_A_cat.hom
    let α_R' : ↑R' →+* S_W := α_R'_cat.hom

    have h_BgR_fst : (B.map g_R).left ≫ p_fst = p_WR' ≫ AlgebraicGeometry.Spec.map f_R := by
      have h_lift_comm : (CategoryTheory.Limits.pullback.fst W_y.hom f ≫ g_R.left) ≫ U_R.hom =
          CategoryTheory.Limits.pullback.snd W_y.hom f ≫ f := by
        rw [Category.assoc, CategoryTheory.MorphismProperty.Over.w g_R,
          CategoryTheory.Limits.pullback.condition]
      have h_map : (B.map g_R).left =
          CategoryTheory.Limits.pullback.lift
            (CategoryTheory.Limits.pullback.fst W_y.hom f ≫ g_R.left)
            (CategoryTheory.Limits.pullback.snd W_y.hom f) h_lift_comm :=
        CategoryTheory.MorphismProperty.Over.pullback_map_left (@AlgebraicGeometry.Etale) ⊤ f g_R
      exact (congrArg (· ≫ p_fst) h_map).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _)

    have h_sch_comm : h_WA ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R A)) =
        p_WR' ≫ AlgebraicGeometry.Spec.map f_R := by
      dsimp [h_WA]
      rw [← he_pull_fst, Category.assoc, ← Category.assoc e_pull.inv, e_pull.inv_hom_id,
        Category.id_comp, h_BgR_fst]

    have h_ring_comm : ∀ r : R, α_A (algebraMap R A r) = α_R' (f_R.hom r) := by
      suffices h_cat : CommRingCat.ofHom (algebraMap R A) ≫ α_A_cat = f_R ≫ α_R'_cat from
        fun r => congrArg (fun ψ => ψ.hom r) h_cat
      rw [← Iso.cancel_iso_hom_left (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R))]
      have happ := congrArg AlgebraicGeometry.Scheme.Hom.appTop h_sch_comm
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop h_WA,
        AlgebraicGeometry.Scheme.Hom.comp_appTop p_WR',
        hSpec_appTop, hSpec_appTop] at happ
      simpa only [α_A_cat, α_R'_cat, Category.assoc] using happ

    obtain ⟨ψ_S, hψ_S⟩ := hExt S_W α_A α_R' h_ring_comm
    let ψ_sch : Z_W ⟶ AlgebraicGeometry.Spec (CommRingCat.of C) :=
      Z_W.toSpecΓ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_S)

    have h_toSpecΓ_id : (AlgebraicGeometry.Spec (CommRingCat.of A)).toSpecΓ ≫
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of A)) := by
      haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec (CommRingCat.of A)).toSpecΓ := by
        change CategoryTheory.IsIso (AlgebraicGeometry.Spec (CommRingCat.of A)).isoSpec.hom
        infer_instance
      rw [← cancel_mono (AlgebraicGeometry.Spec (CommRingCat.of A)).toSpecΓ,
        Category.assoc, AlgebraicGeometry.SpecMap_ΓSpecIso_inv_toSpecΓ,
        Category.comp_id, Category.id_comp]

    have hψ_sch_A : ψ_sch ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) = h_WA := by
      have hψ_cat : CommRingCat.ofHom (algebraMap A C) ≫ CommRingCat.ofHom ψ_S = α_A_cat := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        exact hψ_S a
      dsimp [ψ_sch]
      rw [Category.assoc, ← AlgebraicGeometry.Spec.map_comp, hψ_cat]
      dsimp [α_A_cat]
      rw [AlgebraicGeometry.Spec.map_comp, ← Category.assoc,
        ← AlgebraicGeometry.Scheme.toSpecΓ_naturality h_WA, Category.assoc,
        h_toSpecΓ_id, Category.comp_id]

    have hψ_vC_left : ψ_sch ≫ v_C.left = (B.map g_R).left := by
      change ψ_sch ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A C)) ≫ e_pull.hom) =
        (B.map g_R).left
      rw [← Category.assoc, hψ_sch_A]
      dsimp [h_WA]
      rw [Category.assoc, e_pull.inv_hom_id, Category.comp_id]

    have hψ_mor_w : ψ_sch ≫ V_C.hom = (B.obj W_y).hom :=
      (Category.assoc ψ_sch v_C.left V₀.hom).symm.trans
        ((congrArg (· ≫ V₀.hom) hψ_vC_left).trans
          (CategoryTheory.MorphismProperty.Over.w (B.map g_R)))
    let ψ_mor : Quiver.Hom (B.obj W_y) V_C :=
      CategoryTheory.MorphismProperty.Over.homMk ψ_sch hψ_mor_w trivial

    have hψ_comm : ψ_mor ≫ (v_C ≫ B.map u_R) = B.map g_y := by
      have hψ_gR : ψ_mor ≫ v_C = B.map g_R :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext hψ_vC_left (Subsingleton.elim _ _)
      rw [← Category.assoc, hψ_gR, ← B.map_comp]

    let s_y : ↑(𝒢₁.obj.obj (Opposite.op (B.obj W_y))) := (𝒢₁.obj.map (Opposite.op ψ_mor)) s_C
    refine ⟨W_y, g_y, hEt_gy, hy_range, s_y, ?_⟩
    have h_nat_ψ :
        (φ.hom.app (Opposite.op (B.obj W_y))) s_y =
          (𝒢₂.obj.map (Opposite.op ψ_mor)) ((φ.hom.app (Opposite.op V_C)) s_C) := by
      change (𝒢₁.obj.map ψ_mor.op ≫ φ.hom.app (Opposite.op (B.obj W_y))) s_C =
        (φ.hom.app (Opposite.op V_C) ≫ 𝒢₂.obj.map ψ_mor.op) s_C
      rw [φ.hom.naturality ψ_mor.op]
    calc
      (φ.hom.app (Opposite.op (B.obj W_y))) s_y
        = (𝒢₂.obj.map (Opposite.op ψ_mor)) ((φ.hom.app (Opposite.op V_C)) s_C) := h_nat_ψ
      _ = (𝒢₂.obj.map (Opposite.op ψ_mor)) ((𝒢₂.obj.map (Opposite.op v_C)) t₀) := by
            rw [hs_C]
      _ = (𝒢₂.obj.map (Opposite.op (ψ_mor ≫ (v_C ≫ B.map u_R)))) t := by
            dsimp [t₀]
            change ((𝒢₂.obj.map (B.map u_R).op ≫ 𝒢₂.obj.map v_C.op) ≫ 𝒢₂.obj.map ψ_mor.op) t =
              (𝒢₂.obj.map (ψ_mor ≫ (v_C ≫ B.map u_R)).op) t
            rw [← 𝒢₂.obj.map_comp, ← op_comp, ← 𝒢₂.obj.map_comp, ← op_comp]
      _ = (𝒢₂.obj.map (Opposite.op (B.map g_y))) t := by
            rw [hψ_comm]

  
  
  
  change CategoryTheory.Limits.PreservesFiniteColimits P_push
  rw [CategoryTheory.Functor.preservesFiniteColimits_iff_forall_exact_map_and_epi]
  intro S₀ hS₀
  refine ⟨?_, ?_⟩
  · exact hS₀.exact.map_of_mono_of_preservesKernel P_push hS₀.mono_f inferInstance
  · haveI : CategoryTheory.Epi S₀.g := hS₀.epi_g
    have hLoc : CategoryTheory.Sheaf.IsLocallySurjective S₀.g :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} S₀.g).mpr inferInstance
    haveI : CategoryTheory.Sheaf.IsLocallySurjective (P_push.map S₀.g) := by
      refine CategoryTheory.Presheaf.IsLocallySurjective.mk (fun {U} t => ?_)
      apply (hEtTop_iff _).mpr
      intro y
      obtain ⟨W_y, g_y, hEt_gy, ⟨z_y, hz_y⟩, s_y, hs_y⟩ :=
        hPointwiseLift S₀.X₂ S₀.X₃ S₀.g hLoc U t y
      refine ⟨W_y, g_y, z_y, ?_, hEt_gy, hz_y⟩
      rw [CategoryTheory.Presheaf.imageSieve_apply]
      exact ⟨s_y, hs_y⟩
    infer_instance

theorem weil_etale_exact_pushforward_leray_and_degree_eval (n q δ : ℕ) {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂) :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor X₂.Etale X₁.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    ∀ (hCont : B.IsContinuous J₂ J₁),
      let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
        AddCommGrpCat.{u} _ J₂ J₁ hCont
      CategoryTheory.Limits.PreservesFiniteColimits P_push →
      (∀ (I : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
        CategoryTheory.Injective I → CategoryTheory.Injective (P_push.obj I)) →
      (∀ (T₂ : X₂.Etale),
