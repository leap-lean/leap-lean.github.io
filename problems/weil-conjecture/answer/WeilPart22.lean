                   Θ.toPresheafFiber_w k.unop x F.obj
                 exact congrArg (fun φ : F.obj.obj X₁ ⟶ Θ.presheafFiber.obj F.obj =>
                   (φ ≫ α).hom z) hnat }⟩
          invFun := fun β =>
            Θ.presheafFiberDesc
