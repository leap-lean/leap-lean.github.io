    let app_v := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt.map v_hom).left)
    let z' : ↥(O_a : AlgebraicGeometry.Scheme.{u}) := z
    have hz'_mem : O_a.ι z' ∈ Set.range ⇑O_a.ι := Set.mem_range_self z'
    rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hz'_mem
    have hz'_pre : z' ∈ (TopologicalSpace.Opens.map O_a.ι.base).obj O_a := hz'_mem
    rw [AlgebraicGeometry.Scheme.preimage_basicOpen O_a.ι g_a] at hz'_pre
    have hz_basic : z ∈ (Fgt.obj W).left.basicOpen (app_v g_a) := hz'_pre
    have hz_unit : IsUnit (((Fgt.obj W).left.presheaf.Γgerm z).hom (app_v g_a)) :=
      (AlgebraicGeometry.RingedSpace.mem_top_basicOpen (Fgt.obj W).left.toRingedSpace
        (app_v g_a) z).mp hz_basic
    have hzero_W : (app_v v_sec - app_v (kMap U (ν a))) * app_v g_a = 0 := by
      rw [← map_sub, ← map_mul, hmul_ga, map_zero]
    have hzero_z := congrArg (((Fgt.obj W).left.presheaf.Γgerm z).hom) hzero_W
    rw [map_mul, map_sub, map_zero] at hzero_z
    exact sub_eq_zero.mp (hz_unit.mul_left_eq_zero.mp hzero_z)

  have hEt_jC : AlgebraicGeometry.Etale j_C := inferInstance
  let U_j : C_bar.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j_C hEt_jC
  have hExcision :
      (∀ q : ℕ, 3 ≤ q → Subsingleton (weilEtaleLocalTorsionH C_bar.left ℓ U_j q)) ∧
      Function.Bijective (weilEtaleLocalTorsionCounitH C_bar.left ℓ U_j 2) := by
    let S := C_bar.left
    let J := S.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let L_sh := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let P_loc := CategoryTheory.Presheaf.freeYoneda U_j AM
    let P_const := (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM
    let c_pre : P_loc ⟶ P_const := CategoryTheory.Presheaf.freeYonedaHomEquiv.symm (𝟙 AM)
    let c := weilEtaleLocalTorsionCounit S ℓ U_j
    let Λ_S := weilEtaleTorsionSheaf S ℓ

    have hEquiv_comp :
        ∀ {W_et : S.Etale}
          {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
          (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W_et AM ⟶ F)
          (g : F ⟶ G),
          CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
      intro W_et F G α g
      let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
                AddCommGrpCat.{u}).homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                  AddCommGrpCat.{u}).map g) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

    have hSub_Uj : ∀ W : S.Etale, Subsingleton (W ⟶ U_j) := by
      intro W
      refine ⟨fun u₁ u₂ => ?_⟩
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      have hw₁ : u₁.left ≫ j_C = W.hom := CategoryTheory.MorphismProperty.Over.w u₁
      have hw₂ : u₂.left ≫ j_C = W.hom := CategoryTheory.MorphismProperty.Over.w u₂
      exact (cancel_mono j_C).mp (hw₁.trans hw₂.symm)

    have hL_cpre : L_sh.map c_pre = c := by
      apply (CategoryTheory.Sheaf.freeYonedaHomEquiv (F := Λ_S)).injective
      let f₁ : P_loc ⟶ Λ_S.obj := (shAdj.homEquiv P_loc Λ_S) (L_sh.map c_pre)
      have hf₁_app : f₁.app (Opposite.op U_j) =
          c_pre.app (Opposite.op U_j) ≫ (shAdj.unit.app P_const).app (Opposite.op U_j) := by
        have hunit : f₁ = c_pre ≫ shAdj.unit.app P_const := by
          change shAdj.unit.app P_loc ≫
              (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map (L_sh.map c_pre) =
            c_pre ≫ shAdj.unit.app P_const
          exact (shAdj.unit.naturality c_pre).symm
        exact congrArg (fun φ => φ.app (Opposite.op U_j)) hunit
      let ι_id : AM ⟶ P_loc.obj (Opposite.op U_j) :=
        CategoryTheory.Limits.Sigma.ι (fun (_ : U_j ⟶ U_j) => AM) (𝟙 U_j)
      let c_Uj : P_loc.obj (Opposite.op U_j) ⟶ AM := c_pre.app (Opposite.op U_j)
      let η_Uj : AM ⟶ Λ_S.obj.obj (Opposite.op U_j) :=
        (shAdj.unit.app P_const).app (Opposite.op U_j)
      have hcpre_iota : ι_id ≫ c_Uj = 𝟙 AM :=
        (CategoryTheory.Presheaf.freeYonedaHomEquiv (F := P_const)).apply_symm_apply (𝟙 AM)
      have hf₁_app' : f₁.app (Opposite.op U_j) = c_Uj ≫ η_Uj := hf₁_app
      have hlhs_def : CategoryTheory.Sheaf.freeYonedaHomEquiv (L_sh.map c_pre) =
          ι_id ≫ f₁.app (Opposite.op U_j) := rfl
      have lhs_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv (L_sh.map c_pre) = η_Uj :=
        hlhs_def.trans
          ((congrArg (ι_id ≫ ·) hf₁_app').trans
            ((CategoryTheory.Category.assoc ι_id c_Uj η_Uj).symm.trans
              ((congrArg (· ≫ η_Uj) hcpre_iota).trans (CategoryTheory.Category.id_comp η_Uj))))
      have rhs_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv c = η_Uj :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
      exact lhs_eq.trans rhs_eq.symm

    have hMono_cpre : CategoryTheory.Mono c_pre := by
      rw [CategoryTheory.NatTrans.mono_iff_mono_app]
      intro opW
      let W : S.Etale := Opposite.unop opW
      have : Subsingleton (W ⟶ U_j) := hSub_Uj W
      change CategoryTheory.Mono (c_pre.app (Opposite.op W))
      let f_idx : (W ⟶ U_j) → AddCommGrpCat.{u} := fun _ => AM
      let c_W : (∐ f_idx) ⟶ AM := c_pre.app (Opposite.op W)
      change CategoryTheory.Mono c_W
      by_cases hne : Nonempty (W ⟶ U_j)
      · obtain ⟨u₀⟩ := hne
        let r_inv : AM ⟶ ∐ f_idx := CategoryTheory.Limits.Sigma.ι f_idx u₀
        have h_retract : c_W ≫ r_inv = 𝟙 (∐ f_idx) := by
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro u
          have hu : u = u₀ := Subsingleton.elim u u₀
          subst hu
          have h_iota : CategoryTheory.Limits.Sigma.ι f_idx u ≫ c_W = 𝟙 AM := by
            change CategoryTheory.Limits.Sigma.ι f_idx u ≫
              CategoryTheory.Limits.Sigma.desc (fun φ : W ⟶ U_j => 𝟙 AM ≫ 𝟙 AM) = 𝟙 AM
            rw [CategoryTheory.Limits.Sigma.ι_comp_desc, CategoryTheory.Category.id_comp]
          calc
            CategoryTheory.Limits.Sigma.ι f_idx u ≫ (c_W ≫ r_inv)
              = (CategoryTheory.Limits.Sigma.ι f_idx u ≫ c_W) ≫ r_inv :=
                  (CategoryTheory.Category.assoc _ _ _).symm
            _ = 𝟙 AM ≫ r_inv := by rw [h_iota]
            _ = r_inv := CategoryTheory.Category.id_comp _
            _ = CategoryTheory.Limits.Sigma.ι f_idx u ≫ 𝟙 (∐ f_idx) :=
                  (CategoryTheory.Category.comp_id _).symm
        refine ⟨fun g₁ g₂ hg => ?_⟩
        have h1 := congrArg (· ≫ r_inv) hg
        simpa only [CategoryTheory.Category.assoc, h_retract, CategoryTheory.Category.comp_id] using h1
      · have : IsEmpty (W ⟶ U_j) := not_nonempty_iff.mp hne
        have hid_zero : 𝟙 (∐ f_idx) = 0 := by
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro u
          exact IsEmpty.elim inferInstance u
        refine ⟨fun g₁ g₂ _ => ?_⟩
        calc
          g₁ = g₁ ≫ 𝟙 (∐ f_idx) := (CategoryTheory.Category.comp_id g₁).symm
          _ = g₁ ≫ 0 := by rw [hid_zero]
          _ = 0 := CategoryTheory.Limits.comp_zero
          _ = g₂ ≫ 0 := CategoryTheory.Limits.comp_zero.symm
          _ = g₂ ≫ 𝟙 (∐ f_idx) := by rw [← hid_zero]
          _ = g₂ := CategoryTheory.Category.comp_id g₂

    haveI : CategoryTheory.Mono c := by
      rw [← hL_cpre]
      exact L_sh.map_mono c_pre

    let 𝒬 := CategoryTheory.Limits.cokernel c
    let π : Λ_S ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π c
    have h₀ : c ≫ π = 0 := CategoryTheory.Limits.cokernel.condition c
    let SC := CategoryTheory.ShortComplex.mk c π h₀
    have hEx : SC.Exact :=
      CategoryTheory.ShortComplex.exact_of_g_is_cokernel SC (CategoryTheory.Limits.cokernelIsCokernel c)
    have hSE : SC.ShortExact := CategoryTheory.ShortComplex.ShortExact.mk hEx

    have hℓ_AM : ℓ • 𝟙 AM = 0 := by
      ext ⟨z⟩
      change ULift.up (ℓ • z) = ULift.up 0
      congr 1
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    have hℓ_Λ : ℓ • 𝟙 Λ_S = 0 := by
      dsimp only [Λ_S, weilEtaleTorsionSheaf]
      rw [← (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).map_id AM,
        ← CategoryTheory.Functor.map_nsmul, hℓ_AM, CategoryTheory.Functor.map_zero]
    have hℓ_𝒬 : ℓ • CategoryTheory.CategoryStruct.id 𝒬 = 0 := by
      apply (cancel_epi π).mp
      calc
        π ≫ (ℓ • 𝟙 𝒬) = ℓ • (π ≫ 𝟙 𝒬) := CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = ℓ • (𝟙 Λ_S ≫ π) := by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        _ = (ℓ • 𝟙 Λ_S) ≫ π := (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = 0 ≫ π := by rw [hℓ_Λ]
        _ = 0 := CategoryTheory.Limits.zero_comp
        _ = π ≫ 0 := CategoryTheory.Limits.comp_zero.symm

    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hJ_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S le_rfl
    have hGeomLift : ∀ {Ω : Type u} [Field Ω] [IsAlgClosed Ω]
        (W : S.Etale)
        (w : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (Fgt.obj W).left)
        (R_sieve : CategoryTheory.Sieve W),
        R_sieve ∈ J W →
        ∃ (W' : S.Etale) (v : W' ⟶ W)
          (w' : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (Fgt.obj W').left),
          R_sieve.arrows v ∧ w' ≫ (Fgt.map v).left = w := by
      intro Ω _ _ W w R_sieve hR
      have hNonempty_Ω : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
        (PrimeSpectrum.nonempty_iff_nontrivial (R := Ω)).mpr inferInstance
      let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := Classical.choice hNonempty_Ω
      have hmem := AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) W R_sieve
      have hR_pre := ((congrArg (fun K => R_sieve ∈ K W) hJ_eq).to_iff.trans hmem).mp hR
      obtain ⟨W'_raw, v_raw, y'_raw, hv_arr_raw, hEt_v_raw, hy'_raw⟩ := hR_pre (w.base pt_Ω)
      let W' : S.Etale := W'_raw
      let v : W' ⟶ W := v_raw
      let v_sch : (Fgt.obj W').left ⟶ (Fgt.obj W).left := (Fgt.map v).left
      let y' : ↥(Fgt.obj W').left := y'_raw
      have hv_arr : R_sieve.arrows v := hv_arr_raw
      haveI : AlgebraicGeometry.Etale v_sch := hEt_v_raw
      have hy' : v_sch.base y' = w.base pt_Ω := hy'_raw
      obtain ⟨z_P, _, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := v_sch) (g := w) y' pt_Ω hy'
      let P := CategoryTheory.Limits.pullback v_sch w
      let p₁ : P ⟶ (Fgt.obj W').left := CategoryTheory.Limits.pullback.fst v_sch w
      let p₂ : P ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) :=
        CategoryTheory.Limits.pullback.snd v_sch w
      obtain ⟨A_P, hAff_AP, hz_AP, _⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
          (U := (⊤ : P.Opens)) (by trivial : z_P ∈ (⊤ : P.Opens))
      let B_cat := P.presheaf.obj (Opposite.op A_P)
      let φ_Ω : CommRingCat.of Ω ⟶ B_cat := AlgebraicGeometry.Spec.preimage (hAff_AP.fromSpec ≫ p₂)
      have hmap_φ : AlgebraicGeometry.Spec.map φ_Ω = hAff_AP.fromSpec ≫ p₂ :=
        AlgebraicGeometry.Spec.map_preimage (hAff_AP.fromSpec ≫ p₂)
      have hFT_hom : RingHom.FiniteType φ_Ω.hom := by
        rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType),
          hmap_φ]
        infer_instance
      let _ : Algebra Ω ↑B_cat := φ_Ω.hom.toAlgebra
      have hFT_alg : Algebra.FiniteType Ω ↑B_cat := hFT_hom
      have hz_in_range : z_P ∈ Set.range ⇑hAff_AP.fromSpec.base := by
        rw [hAff_AP.range_fromSpec]
        exact hz_AP
      obtain ⟨pt_B, _⟩ := hz_in_range
      have hNontriv_B : Nontrivial ↑B_cat :=
        (PrimeSpectrum.nonempty_iff_nontrivial (R := ↑B_cat)).mp ⟨pt_B⟩
      obtain ⟨m_B, hm_B⟩ := Ideal.exists_maximal (↑B_cat)
      obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
      let q_hom : MvPolynomial (Fin n_mv) Ω →+* ↑B_cat := q_mv.toRingHom
      have hq_hom_surj : Function.Surjective q_hom := hq_surj
      let m_mv : Ideal (MvPolynomial (Fin n_mv) Ω) := Ideal.comap q_hom m_B
      have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
      obtain ⟨a_pt, ha_pt⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
      let ev_hom : MvPolynomial (Fin n_mv) Ω →+* Ω := (MvPolynomial.aeval a_pt).toRingHom
      have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
        intro f_p hf_p
        rw [RingHom.mem_ker] at hf_p
        have hmem : f_p ∈ m_mv := by
          change q_hom f_p ∈ m_B
          rw [hf_p]
          exact m_B.zero_mem
        rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
      let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
      let σ_B : ↑B_cat →+* Ω :=
        (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
      have hσ_comp : φ_Ω ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of Ω) := by
        ext c_val
        change σ_B (algebraMap Ω (↑B_cat) c_val) = c_val
        have hq_C : q_hom (MvPolynomial.C c_val) = algebraMap Ω (↑B_cat) c_val := q_mv.commutes c_val
        rw [← hq_C]
        dsimp [σ_B]
        have heq_q : e_quot.symm (q_hom (MvPolynomial.C c_val)) =
            Ideal.Quotient.mk (RingHom.ker q_hom) (MvPolynomial.C c_val) := by
          apply e_quot.injective
          simp [e_quot]
        rw [heq_q, Ideal.Quotient.lift_mk]
        exact (MvPolynomial.aeval a_pt).commutes c_val
      let s_P : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ P :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ hAff_AP.fromSpec
      have hs_P : s_P ≫ p₂ = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
        dsimp [s_P]
        rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp, hσ_comp,
          AlgebraicGeometry.Spec.map_id]
      refine ⟨W', v, s_P ≫ p₁, hv_arr, ?_⟩
      change (s_P ≫ p₁) ≫ v_sch = w
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
        ← CategoryTheory.Category.assoc, hs_P, CategoryTheory.Category.id_comp]

    have hOpenZero : ∀ x : ↥S, x ∈ j_C.opensRange → WeilAltCdStalkZeroAt S 𝒬 x := by
      intro x hx_open U u hu_gx s
      let Ω := AlgebraicClosure ↥(S.residueField x)
      let gx : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω)) ≫
          S.fromSpecResidueField x
      have hNonempty_Ω : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
        (PrimeSpectrum.nonempty_iff_nontrivial (R := Ω)).mpr inferInstance
      let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := Classical.choice hNonempty_Ω
      have hSub_Ω : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
        change Subsingleton (PrimeSpectrum Ω)
        infer_instance
      have hgx_pt : gx.base pt_Ω = x := by
        have hmem : gx.base pt_Ω ∈ Set.range ⇑(S.fromSpecResidueField x) := by
          change (S.fromSpecResidueField x)
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(S.residueField x) Ω))) pt_Ω) ∈
            Set.range ⇑(S.fromSpecResidueField x)
          exact Set.mem_range_self _
        rwa [AlgebraicGeometry.Scheme.range_fromSpecResidueField, Set.mem_singleton_iff] at hmem
      let O_U : ((Fgt.obj U).left).Opens :=
        (TopologicalSpace.Opens.map ((Fgt.obj U).hom).base).obj j_C.opensRange
      have hEt_U : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
      have hEt_U₁ : AlgebraicGeometry.Etale (O_U.ι ≫ (Fgt.obj U).hom) := inferInstance
      let U₁ : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_U.ι ≫ (Fgt.obj U).hom) hEt_U₁
      let v₁ : U₁ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O_U.ι rfl trivial
      have hrange_u : Set.range ⇑u ⊆ Set.range ⇑O_U.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨pt', rfl⟩
        rw [hSub_Ω.elim pt' pt_Ω]
        have hcomp_pt : ((Fgt.obj U).hom).base (u.base pt_Ω) = gx.base pt_Ω :=
          (AlgebraicGeometry.Scheme.Hom.comp_apply u ((Fgt.obj U).hom) pt_Ω).symm.trans
            (congrArg (fun φ => φ.base pt_Ω) hu_gx)
        change ((Fgt.obj U).hom).base (u.base pt_Ω) ∈ j_C.opensRange
        rw [hcomp_pt, hgx_pt]
        exact hx_open
      let u₁_raw : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ ↑O_U :=
        AlgebraicGeometry.IsOpenImmersion.lift O_U.ι u hrange_u
      have hu₁_raw_fac : u₁_raw ≫ O_U.ι = u :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac O_U.ι u hrange_u
      let u₁ : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (Fgt.obj U₁).left := u₁_raw
      have hu₁_fac : u₁ ≫ (Fgt.map v₁).left = u := hu₁_raw_fac
      have hrange_U₁ : Set.range ⇑((Fgt.obj U₁).hom) ⊆ Set.range ⇑j_C := by
        rintro _ ⟨y, rfl⟩
        have hy_mem : O_U.ι y ∈ Set.range ⇑O_U.ι := Set.mem_range_self y
        rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hy_mem
        exact hy_mem
      let q_sch : (Fgt.obj U₁).left ⟶ C :=
        AlgebraicGeometry.IsOpenImmersion.lift j_C (Fgt.obj U₁).hom hrange_U₁
      have hq_fac : q_sch ≫ j_C = (Fgt.obj U₁).hom :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac j_C (Fgt.obj U₁).hom hrange_U₁
      let q_j : U₁ ⟶ U_j := CategoryTheory.MorphismProperty.Over.homMk q_sch hq_fac trivial

      haveI : CategoryTheory.Presheaf.IsLocallySurjective J π.hom :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
      have hMem_π : CategoryTheory.Presheaf.imageSieve π.hom (𝒬.obj.map v₁.op s) ∈ J U₁ :=
        CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem (𝒬.obj.map v₁.op s)
      obtain ⟨U₂, v₂, u₂, ⟨t₂, ht₂⟩, hu₂_fac⟩ := hGeomLift U₁ u₁ _ hMem_π

