  refine ⟨eSheafify_p, eSheafify_q, sliceRIso,
    heSheafify_p_nat, heSheafify_q_nat, heSheafify_p_unit, heSheafify_q_unit, ?_, ?_⟩

  · intro q F₁ F₂ φ
    let φ_X' := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map (res_q.map φ)
    let φ_X := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).map φ
    let w₁ := CategoryTheory.Functor.whiskerLeft B_f'.op φ_X'
    let w_mid := CategoryTheory.Functor.whiskerLeft B_f'.op (CategoryTheory.Functor.whiskerLeft M_q.op φ_X)
    let w₂ := CategoryTheory.Functor.whiskerLeft M_p.op (CategoryTheory.Functor.whiskerLeft B_f.op φ_X)
    let c₁ := CategoryTheory.Functor.whiskerLeft B_f'.op (eCohom q F₁).hom
    let c₂ := CategoryTheory.Functor.whiskerLeft B_f'.op (eCohom q F₂).hom
