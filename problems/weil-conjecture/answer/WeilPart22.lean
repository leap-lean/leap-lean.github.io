        A (P_push.obj (C₁.obj A))).symm
        (CategoryTheory.CategoryStruct.comp
          ((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁').unit.app A)
          ((C₁.obj A).obj.map (Opposite.op (hT₁'.from (B.obj T₂'))))) =
      ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
        ((CategoryTheory.Functor.const (X₂.Etale)ᵒᵖ).obj A) (P_push.obj (C₁.obj A))).symm
        (CategoryTheory.Functor.whiskerLeft B.op
          ((CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app
            ((CategoryTheory.Functor.const (X₁.Etale)ᵒᵖ).obj A))) := by
    intro T₁' hT₁' T₂' hT₂' A
    let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    let P₁ := (CategoryTheory.Functor.const (X₁.Etale)ᵒᵖ).obj A
