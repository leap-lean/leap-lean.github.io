      (∀ d₀ : ↥(𝒬.obj.obj (Opposite.op T_X)),
        ∃ f_q : Quiver.Hom Fℤ 𝒬,
          (f_q.hom.app (Opposite.op T_X)).hom ((adj_c.unit.app Aℤ).hom (ULift.up 1)) = d₀) :=
by
  classical
  let J := X.smallEtaleTopology
  let sh := CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}
  let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
  let S₁ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := sh.obj P₁
  let S₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := sh.obj P₂
  let T_X : X.Etale := weilEtaleIdTerminal.{u} X
  let hT_X : CategoryTheory.Limits.IsTerminal T_X := weilEtaleIdTerminalIsTerminal.{u} X
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ := (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
  let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_X
  let η₁ := shAdj.unit.app P₁
  let η₂ := shAdj.unit.app P₂

  let S'₁ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P₁, hP₁⟩
  let S'₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P₂, hP₂⟩
  let ι' : S'₁ ⟶ S'₂ := { hom := ι_pre }
  let π' : S'₂ ⟶ 𝒬 := { hom := π_pre }

  have h0' : CategoryTheory.CategoryStruct.comp ι' π' = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    ext U u
    exact hZero U.unop u

  have hMono' : CategoryTheory.Mono ι' := ⟨fun {W} g₁ g₂ h_eq => by
    apply CategoryTheory.Sheaf.hom_ext
    ext U w
    apply hInj U.unop
    exact congrArg (fun φ : W ⟶ S'₂ => (φ.hom.app U).hom w) h_eq⟩

  have hKer_mem : ∀ {W : CategoryTheory.Sheaf J AddCommGrpCat.{u}} (g' : W ⟶ S'₂),
      CategoryTheory.CategoryStruct.comp g' π' = 0 →
      ∀ (U : Opposite X.Etale) (w : ↥(W.obj.obj U)),
        (g'.hom.app U).hom w ∈ Set.range (ι_pre.app U).hom := by
    intro W g' hg' U w
    apply hExact U.unop
    exact congrArg (fun φ : W ⟶ 𝒬 => (φ.hom.app U).hom w) hg'

  have hKer : CategoryTheory.Limits.IsLimit (CategoryTheory.Limits.KernelFork.ofι ι' h0') := by
    refine CategoryTheory.Limits.KernelFork.IsLimit.ofι ι' h0'
      (fun {W} g' hg' => ?_) (fun {W} g' hg' => ?_) (fun {W} g' hg' m hm => ?_)
    · let liftFun : ∀ (U : Opposite X.Etale), ↥(W.obj.obj U) → ↥(P₁.obj U) :=
        fun U w => (hKer_mem g' hg' U w).choose
      have hliftFun : ∀ (U : Opposite X.Etale) (w : ↥(W.obj.obj U)),
          (ι_pre.app U).hom (liftFun U w) = (g'.hom.app U).hom w :=
        fun U w => (hKer_mem g' hg' U w).choose_spec
      refine { hom :=
        { app := fun U => AddCommGrpCat.ofHom
            { toFun := liftFun U
              map_zero' := hInj U.unop
                ((hliftFun U 0).trans ((map_zero (g'.hom.app U).hom).trans
                  (map_zero (ι_pre.app U).hom).symm))
              map_add' := fun w₁ w₂ => hInj U.unop
                ((hliftFun U (w₁ + w₂)).trans
                  ((map_add (g'.hom.app U).hom w₁ w₂).trans
                    ((congrArg₂ (· + ·) (hliftFun U w₁).symm (hliftFun U w₂).symm).trans
                      (map_add (ι_pre.app U).hom _ _).symm))) }
          naturality := fun U₁ U₂ f => by
            ext w
            apply hInj U₂.unop
            change (ι_pre.app U₂).hom (liftFun U₂ ((W.obj.map f).hom w)) =
              (ι_pre.app U₂).hom ((P₁.map f).hom (liftFun U₁ w))
            rw [hliftFun U₂]
            have hnat_g := congrArg (fun τ : W.obj.obj U₁ ⟶ P₂.obj U₂ => τ.hom w)
              (g'.hom.naturality f)
            have hnat_ι := congrArg (fun τ : P₁.obj U₁ ⟶ P₂.obj U₂ => τ.hom (liftFun U₁ w))
              (ι_pre.naturality f)
            exact hnat_g.trans ((congrArg (P₂.map f).hom (hliftFun U₁ w).symm).trans hnat_ι.symm) } }
    · apply CategoryTheory.Sheaf.hom_ext
      ext U w
      exact (hKer_mem g' hg' U w).choose_spec
    · apply CategoryTheory.Sheaf.hom_ext
      ext U w
      apply hInj U.unop
      have hm_app := congrArg (fun φ : W ⟶ S'₂ => (φ.hom.app U).hom w) hm
      exact hm_app.trans (hKer_mem g' hg' U w).choose_spec.symm

  have hExact' : (CategoryTheory.ShortComplex.mk ι' π' h0').Exact :=
    CategoryTheory.ShortComplex.exact_of_f_is_kernel (CategoryTheory.ShortComplex.mk ι' π' h0') hKer

  have hEpi' : CategoryTheory.Epi π' := ⟨fun {F} α₁ α₂ hα => by
    apply CategoryTheory.Sheaf.hom_ext
    ext U_op d
    let U : X.Etale := U_op.unop
    change (α₁.hom.app (Opposite.op U)).hom d = (α₂.hom.app (Opposite.op U)).hom d
    let V : ↥U.left → U.left.Opens := fun u₀ => (hLocSurj U d u₀).choose
    have hu₀ : ∀ u₀ : ↥U.left, u₀ ∈ V u₀ := fun u₀ => (hLocSurj U d u₀).choose_spec.choose
    let W : ↥U.left → X.Etale := fun u₀ =>
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (CategoryTheory.CategoryStruct.comp (V u₀).ι U.hom)
        (by have : AlgebraicGeometry.Etale U.hom := U.prop; infer_instance)
    let j : ∀ u₀ : ↥U.left, W u₀ ⟶ U := fun u₀ =>
      CategoryTheory.MorphismProperty.Over.homMk (V u₀).ι rfl trivial
    let s : ∀ u₀ : ↥U.left, ↥(P₂.obj (Opposite.op (W u₀))) := fun u₀ =>
      (hLocSurj U d u₀).choose_spec.choose_spec.choose
    have hs : ∀ u₀ : ↥U.left,
        (𝒬.obj.map (Opposite.op (j u₀))).hom d =
          (π_pre.app (Opposite.op (W u₀))).hom (s u₀) :=
      fun u₀ => (hLocSurj U d u₀).choose_spec.choose_spec.choose_spec
    let P₀ : CategoryTheory.Presieve U := CategoryTheory.Presieve.ofArrows W j
    let R : CategoryTheory.Sieve U := CategoryTheory.Sieve.generate P₀
    have hR_eq : R = CategoryTheory.Sieve.ofArrows W j := rfl
    have hR : R ∈ J U := by
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      have hMult : P_et.IsMultiplicative := inferInstance
      have : P_et.ContainsIdentities := hMult.toContainsIdentities
      have : P_et.IsStableUnderComposition := hMult.toIsStableUnderComposition
      have hJ_eq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) X le_rfl
      have hMem_iff : R ∈ J U ↔ ∀ (x : ↥U.left), ∃ Y f y, R.arrows f ∧ P_et f.left ∧ f.left y = x :=
        (Eq.to_iff (congrArg (fun G : CategoryTheory.GrothendieckTopology (P_et.Over ⊤ X) => R ∈ G U)
          hJ_eq)).trans
          (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U R)
      rw [hMem_iff]
      intro x
      refine ⟨W x, j x, (⟨x, hu₀ x⟩ : ↥(V x)), ?_, ?_, rfl⟩
      · rw [hR_eq]
        exact CategoryTheory.Sieve.ofArrows_mk W j x
      · exact (inferInstance : AlgebraicGeometry.Etale (V x).ι)
    let F_type : CategoryTheory.Functor (Opposite X.Etale) (Type u) :=
      F.obj.comp (CategoryTheory.forget AddCommGrpCat.{u})
    have hSheaf_F : CategoryTheory.Presieve.IsSheaf J F_type :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J F_type).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J F.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) F.property)
    have hSep : CategoryTheory.Presieve.IsSeparatedFor F_type P₀ :=
      (hSheaf_F.isSheafFor P₀ hR).isSeparatedFor
    refine hSep.ext (fun Y f hf => ?_)
    rcases hf with ⟨u₀⟩
    have hnat₁ := congrArg (fun τ : 𝒬.obj.obj (Opposite.op U) ⟶ F.obj.obj (Opposite.op (W u₀)) => τ.hom d)
      (α₁.hom.naturality (Opposite.op (j u₀)))
    have hnat₂ := congrArg (fun τ : 𝒬.obj.obj (Opposite.op U) ⟶ F.obj.obj (Opposite.op (W u₀)) => τ.hom d)
      (α₂.hom.naturality (Opposite.op (j u₀)))
    change (F.obj.map (Opposite.op (j u₀))).hom ((α₁.hom.app (Opposite.op U)).hom d) =
      (F.obj.map (Opposite.op (j u₀))).hom ((α₂.hom.app (Opposite.op U)).hom d)
    have h1 : (F.obj.map (Opposite.op (j u₀))).hom ((α₁.hom.app (Opposite.op U)).hom d) =
        ((π' ≫ α₁).hom.app (Opposite.op (W u₀))).hom (s u₀) :=
      hnat₁.symm.trans (congrArg (α₁.hom.app (Opposite.op (W u₀))).hom (hs u₀))
    have h2 : (F.obj.map (Opposite.op (j u₀))).hom ((α₂.hom.app (Opposite.op U)).hom d) =
        ((π' ≫ α₂).hom.app (Opposite.op (W u₀))).hom (s u₀) :=
      hnat₂.symm.trans (congrArg (α₂.hom.app (Opposite.op (W u₀))).hom (hs u₀))
    rw [h1, h2, hα]⟩

  have hSE' : (CategoryTheory.ShortComplex.mk ι' π' h0').ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' hExact' hMono' hEpi'

  let mkUnitIso : ∀ (P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})
      (hP : CategoryTheory.Presheaf.IsSheaf J P),
      (⟨P, hP⟩ : CategoryTheory.Sheaf J AddCommGrpCat.{u}) ≅ sh.obj P :=
    fun P hP =>
      let S' : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P, hP⟩
      let S : CategoryTheory.Sheaf J AddCommGrpCat.{u} := sh.obj P
      let η : P ⟶ S.obj := shAdj.unit.app P
      let hom : S' ⟶ S := { hom := η }
      let inv : S ⟶ S' := (shAdj.homEquiv P S').symm (CategoryTheory.CategoryStruct.id P)
      have h_hom_inv_pre : CategoryTheory.CategoryStruct.comp η inv.hom =
          CategoryTheory.CategoryStruct.id P :=
        (shAdj.homEquiv_unit P S' inv).symm.trans
          ((shAdj.homEquiv P S').apply_symm_apply (CategoryTheory.CategoryStruct.id P))
      { hom := hom
        inv := inv
        hom_inv_id := CategoryTheory.Sheaf.hom_ext h_hom_inv_pre
        inv_hom_id := (shAdj.homEquiv P S).injective (by
          rw [shAdj.homEquiv_unit P S (CategoryTheory.CategoryStruct.comp inv hom),
            shAdj.homEquiv_unit P S (CategoryTheory.CategoryStruct.id S)]
          change CategoryTheory.CategoryStruct.comp η (CategoryTheory.CategoryStruct.comp inv.hom η) =
            CategoryTheory.CategoryStruct.comp η (CategoryTheory.CategoryStruct.id S.obj)
          rw [← CategoryTheory.Category.assoc, h_hom_inv_pre]
          exact (CategoryTheory.Category.id_comp η).trans
            (CategoryTheory.Category.comp_id η).symm) }

  let e₁ : S'₁ ≅ S₁ := mkUnitIso P₁ hP₁
  let e₂ : S'₂ ≅ S₂ := mkUnitIso P₂ hP₂
  let ι_sh : S₁ ⟶ S₂ := sh.map ι_pre
  let π_sh : S₂ ⟶ 𝒬 := (shAdj.homEquiv P₂ 𝒬).symm π_pre

  have h_nat₁ : CategoryTheory.CategoryStruct.comp η₁ ι_sh.hom =
      CategoryTheory.CategoryStruct.comp ι_pre η₂ :=
    (shAdj.unit.naturality ι_pre).symm

  have h_nat₂ : CategoryTheory.CategoryStruct.comp η₂ π_sh.hom = π_pre :=
    (shAdj.homEquiv_unit P₂ 𝒬 π_sh).symm.trans ((shAdj.homEquiv P₂ 𝒬).apply_symm_apply π_pre)

  have h_sq₁ : CategoryTheory.CategoryStruct.comp e₁.hom ι_sh =
      CategoryTheory.CategoryStruct.comp ι' e₂.hom :=
    CategoryTheory.Sheaf.hom_ext h_nat₁

  have h_sq₂ : CategoryTheory.CategoryStruct.comp e₂.hom π_sh =
      CategoryTheory.CategoryStruct.comp π' (CategoryTheory.Iso.refl 𝒬).hom :=
    CategoryTheory.Sheaf.hom_ext (h_nat₂.trans (CategoryTheory.Category.comp_id π_pre).symm)

  have h0_sh : CategoryTheory.CategoryStruct.comp ι_sh π_sh = 0 := by
    apply (CategoryTheory.cancel_epi e₁.hom).mp
    calc
      CategoryTheory.CategoryStruct.comp e₁.hom (CategoryTheory.CategoryStruct.comp ι_sh π_sh)
        = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp e₁.hom ι_sh) π_sh :=
            (CategoryTheory.Category.assoc e₁.hom ι_sh π_sh).symm
      _ = CategoryTheory.CategoryStruct.comp (CategoryTheory.CategoryStruct.comp ι' e₂.hom) π_sh := by
            rw [h_sq₁]
      _ = CategoryTheory.CategoryStruct.comp ι' (CategoryTheory.CategoryStruct.comp e₂.hom π_sh) :=
            CategoryTheory.Category.assoc ι' e₂.hom π_sh
      _ = CategoryTheory.CategoryStruct.comp ι' π' := by
            rw [h_sq₂, CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      _ = 0 := h0'
      _ = CategoryTheory.CategoryStruct.comp e₁.hom 0 :=
            (CategoryTheory.Limits.comp_zero (f := e₁.hom)).symm

  let e_sc : CategoryTheory.ShortComplex.mk ι' π' h0' ≅
      CategoryTheory.ShortComplex.mk ι_sh π_sh h0_sh :=
    CategoryTheory.ShortComplex.isoMk e₁ e₂ (CategoryTheory.Iso.refl 𝒬) h_sq₁ h_sq₂

  have hSE : (CategoryTheory.ShortComplex.mk ι_sh π_sh h0_sh).ShortExact :=
    (CategoryTheory.ShortComplex.shortExact_iff_of_iso e_sc).mp hSE'

  let u₁ : ↥(Fℤ.obj.obj (Opposite.op T_X)) := (adj_c.unit.app Aℤ).hom (ULift.up 1)

  let φ_Z : ℤ →+ ℤ :=
    { toFun := fun n => n • (1 : ℤ)
      map_zero' := zero_zsmul (1 : ℤ)
      map_add' := fun m n => add_zsmul (1 : ℤ) m n }

  have hφ_nat : ∀ k : ℕ, φ_Z (k : ℤ) = (k : ℤ) := by
    intro k
    induction k with
    | zero => exact zero_zsmul (1 : ℤ)
    | succ k ih =>
      have hsucc : ((k + 1 : ℕ) : ℤ) = (k : ℤ) + 1 := by omega
      rw [hsucc, map_add, ih]
      exact congrArg ((k : ℤ) + ·) (one_zsmul (1 : ℤ))

  have hφ_int : ∀ n : ℤ, n • (1 : ℤ) = n := by
    intro n
    change φ_Z n = n
    by_cases hn : 0 ≤ n
    · have heq : n = (n.toNat : ℤ) := by omega
      rw [heq, hφ_nat]
    · have hsum : n + ((-n).toNat : ℤ) = 0 := by omega
      have hmap : φ_Z n + φ_Z ((-n).toNat : ℤ) = 0 := by
        rw [← map_add, hsum, map_zero]
      rw [hφ_nat] at hmap
      omega

  let uliftUpHom : ℤ →+ ULift.{u} ℤ :=
    { toFun := ULift.up
      map_zero' := rfl
      map_add' := fun _ _ => rfl }

  let e_Z : ∀ (M : AddCommGrpCat.{u}), (Aℤ ⟶ M) ≃+ ↥M := fun M =>
    { toFun := fun g => g.hom (ULift.up 1)
      invFun := fun m => AddCommGrpCat.ofHom
        { toFun := fun z => z.down • m
          map_zero' := zero_zsmul m
          map_add' := fun a b => add_zsmul m a.down b.down }
      left_inv := fun g => by
        ext z
        have hz : z = z.down • (ULift.up 1 : ULift.{u} ℤ) := by
          have h1 : uliftUpHom (z.down • (1 : ℤ)) = z.down • uliftUpHom 1 :=
            map_zsmul uliftUpHom z.down (1 : ℤ)
          rw [hφ_int z.down] at h1
          exact h1
        change z.down • g.hom (ULift.up 1) = g.hom z
        exact (map_zsmul g.hom z.down (ULift.up 1)).symm.trans (congrArg g.hom hz.symm)
      right_inv := fun m => one_zsmul m
      map_add' := fun _ _ => rfl }

  let e_adj : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      (Fℤ ⟶ F) ≃+ (Aℤ ⟶ F.obj.obj (Opposite.op T_X)) := fun F =>
    { adj_c.homEquiv Aℤ F with
      map_add' := fun f₁ f₂ => by
        change adj_c.homEquiv Aℤ F (f₁ + f₂) = adj_c.homEquiv Aℤ F f₁ + adj_c.homEquiv Aℤ F f₂
        rw [adj_c.homEquiv_unit, adj_c.homEquiv_unit, adj_c.homEquiv_unit]
        ext z
        rfl }

  let e_hom : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
      (Fℤ ⟶ F) ≃+ ↥(F.obj.obj (Opposite.op T_X)) :=
    fun F => (e_adj F).trans (e_Z (F.obj.obj (Opposite.op T_X)))

  have h_hom : ∀ (F : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (f : Fℤ ⟶ F),
      e_hom F f = (f.hom.app (Opposite.op T_X)).hom u₁ := by
    intro F f
    exact congrArg (fun g : Aℤ ⟶ F.obj.obj (Opposite.op T_X) => g.hom (ULift.up 1))
      (adj_c.homEquiv_unit Aℤ F f)

  let ev_equiv : 𝒬.H 0 ≃+ ↥(𝒬.obj.obj (Opposite.op T_X)) :=
    CategoryTheory.Abelian.Ext.addEquiv₀.trans (e_hom 𝒬)
  let ev_H0 : 𝒬.H 0 →+ ↥(𝒬.obj.obj (Opposite.op T_X)) := ev_equiv.toAddMonoidHom

  have hEv_mk0 : ∀ f_q : Quiver.Hom Fℤ 𝒬,
      ev_H0 (CategoryTheory.Abelian.Ext.mk₀ f_q) = (f_q.hom.app (Opposite.op T_X)).hom u₁ := by
    intro f_q
    change e_hom 𝒬 (CategoryTheory.Abelian.Ext.addEquiv₀ (CategoryTheory.Abelian.Ext.mk₀ f_q)) = _
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply f_q,
      AddEquiv.apply_symm_apply, h_hom 𝒬 f_q]

  have hη₁_app : ∀ (U : X.Etale) (u : ↥(P₁.obj (Opposite.op U))),
      (ι_sh.hom.app (Opposite.op U)).hom ((η₁.app (Opposite.op U)).hom u) =
        (η₂.app (Opposite.op U)).hom ((ι_pre.app (Opposite.op U)).hom u) :=
    fun U u => congrArg (fun τ : P₁ ⟶ S₂.obj => (τ.app (Opposite.op U)).hom u) h_nat₁

  have hη₂_app : ∀ (U : X.Etale) (s : ↥(P₂.obj (Opposite.op U))),
      (π_sh.hom.app (Opposite.op U)).hom ((η₂.app (Opposite.op U)).hom s) =
        (π_pre.app (Opposite.op U)).hom s :=
    fun U s => congrArg (fun τ : P₂ ⟶ 𝒬.obj => (τ.app (Opposite.op U)).hom s) h_nat₂

  refine ⟨ι_sh, π_sh, h0_sh, hSE, ev_H0, hη₁_app, hη₂_app, ev_equiv.bijective, hEv_mk0, ?_, ?_, ?_⟩
  · intro hSub ξ
    have hξ0 : ξ.comp (CategoryTheory.Abelian.Ext.mk₀ ι_sh) (Nat.add_zero 1) = 0 :=
      @Subsingleton.elim (S₂.H 1) hSub _ 0
    exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE ξ hξ0 (Nat.zero_add 1)
  · intro s₀
    let t₀ : ↥(S₂.obj.obj (Opposite.op T_X)) := (η₂.app (Opposite.op T_X)).hom s₀
    let f_k : Fℤ ⟶ S₂ := (e_hom S₂).symm t₀
    have hf_k : (f_k.hom.app (Opposite.op T_X)).hom u₁ = t₀ :=
      (h_hom S₂ f_k).symm.trans ((e_hom S₂).apply_symm_apply t₀)
    refine ⟨CategoryTheory.Abelian.Ext.mk₀ f_k, ?_⟩
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ f_k π_sh, hEv_mk0 (f_k ≫ π_sh)]
    change (π_sh.hom.app (Opposite.op T_X)).hom ((f_k.hom.app (Opposite.op T_X)).hom u₁) = _
    rw [hf_k]
    exact hη₂_app T_X s₀
  · intro d₀
    let f_q : Fℤ ⟶ 𝒬 := (e_hom 𝒬).symm d₀
    refine ⟨f_q, (h_hom 𝒬 f_q).symm.trans ((e_hom 𝒬).apply_symm_apply d₀)⟩

theorem weil_polyP1_last_coord_open_affine_line_point_equiv (k : Type u) [Field k] [IsAlgClosed k]
    (P1 : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral P1]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) P1)
    [AlgebraicGeometry.IsOpenImmersion ι_P1]
    (q_inf : ↥P1)
    (hCompl : (Set.range ι_P1.base)ᶜ = ({q_inf} : Set ↥P1))
    (hDVR : ∀ x : { x : ↥P1 // IsClosed ({x} : Set ↥P1) },
      ∃ hDom : IsDomain ↑(P1.presheaf.stalk x.1),
        @IsDiscreteValuationRing ↑(P1.presheaf.stalk x.1) _ hDom)
    (deg_Cl : weilCurveClGroup P1 →+ ℤ)
    (hDeg : ∀ D : ({ x : ↥P1 // IsClosed ({x} : Set ↥P1) } →₀ ℤ),
      deg_Cl (QuotientAddGroup.mk' (weilCurvePrincipalSubgroup P1) D) =
        D.sum (fun _ n => n))
    (Q₁ Q₂ : { x : ↥P1 // IsClosed ({x} : Set ↥P1) }) :
    Finsupp.single Q₁ 1 - Finsupp.single Q₂ 1 ∈ weilCurvePrincipalSubgroup P1 :=
by
  classical
  let Pt := { x : ↥P1 // IsClosed ({x} : Set ↥P1) }
  let ι : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P1 := ι_P1
  have : AlgebraicGeometry.IsOpenImmersion ι := inferInstance
  have hOpen_range : IsOpen (Set.range ι.base) :=
    AlgebraicGeometry.IsOpenImmersion.isOpen_range ι
  have hClosed_inf : IsClosed ({q_inf} : Set ↥P1) := by
    rw [← hCompl]
    exact hOpen_range.isClosed_compl
  let Q_inf : Pt := ⟨q_inf, hClosed_inf⟩
  have hMax_of_closed : ∀ (p : PrimeSpectrum (Polynomial k)),
      IsClosed ({ι.base p} : Set ↥P1) → p.asIdeal.IsMaximal := by
    intro p hcl
    rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal p]
    have hpre : ι.base ⁻¹' ({ι.base p} : Set ↥P1) = {p} := by
      ext q
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ι.isOpenEmbedding.injective.eq_iff
    have hcl_pre : IsClosed (ι.base ⁻¹' ({ι.base p} : Set ↥P1)) :=
      hcl.preimage ι.continuous
    exact hpre ▸ hcl_pre
  have hMaxSpan : ∀ (p_id : Ideal (Polynomial k)), p_id.IsMaximal →
      ∃ a₀ : k,
        p_id = Ideal.span ({Polynomial.X - Polynomial.C a₀} : Set (Polynomial k)) ∧
        ∀ (q_id : Ideal (Polynomial k)), q_id.IsMaximal → q_id ≠ p_id →
          Polynomial.X - Polynomial.C a₀ ∉ q_id := by
    intro p_id hp_max
    let g : Polynomial k := Submodule.IsPrincipal.generator p_id
    have hg_span : Ideal.span ({g} : Set (Polynomial k)) = p_id :=
      Ideal.span_singleton_generator p_id
    have hg_not_unit : ¬ IsUnit g := by
      intro hgu
      exact hp_max.ne_top (hg_span ▸ Ideal.span_singleton_eq_top.mpr hgu)
    have hg_deg : g.degree ≠ 0 :=
      fun hd0 => hg_not_unit (Polynomial.isUnit_iff_degree_eq_zero.mpr hd0)
    obtain ⟨a₀, ha₀⟩ := IsAlgClosed.exists_root g hg_deg
    have hdvd : Polynomial.X - Polynomial.C a₀ ∣ g :=
      Polynomial.dvd_iff_isRoot.mpr ha₀
    let ψ : Polynomial k := Polynomial.X - Polynomial.C a₀
    have hp_le_ψ : p_id ≤ Ideal.span ({ψ} : Set (Polynomial k)) := by
      rw [← hg_span, Ideal.span_singleton_le_span_singleton]
      exact hdvd
    have hψ_deg : ψ.degree ≠ 0 := by
      dsimp [ψ]
      rw [Polynomial.degree_X_sub_C]
      exact one_ne_zero
    have hψ_not_unit : ¬ IsUnit ψ :=
      mt Polynomial.isUnit_iff_degree_eq_zero.mp hψ_deg
    have hψ_ne_top : Ideal.span ({ψ} : Set (Polynomial k)) ≠ ⊤ :=
      mt Ideal.span_singleton_eq_top.mp hψ_not_unit
    have hp_eq_ψ : p_id = Ideal.span ({ψ} : Set (Polynomial k)) :=
      hp_max.eq_of_le hψ_ne_top hp_le_ψ
    refine ⟨a₀, hp_eq_ψ, ?_⟩
    intro q_id hq_max hq_ne hψ_in
    apply hq_ne
    symm
    apply hp_max.eq_of_le hq_max.ne_top
    rw [hp_eq_ψ, Ideal.span_le, Set.singleton_subset_iff]
    exact hψ_in
  have hStalkSpan : ∀ (p₀ : PrimeSpectrum (Polynomial k)) (ψ : Polynomial k),
      ψ ≠ 0 →
      p₀.asIdeal = Ideal.span ({ψ} : Set (Polynomial k)) →
      ∃ f : Units ↑P1.functionField,
        ∀ p : PrimeSpectrum (Polynomial k),
          let Rx := ↑(P1.presheaf.stalk (ι.base p))
          let mx := IsLocalRing.maximalIdeal Rx
          ∃ a : Rx,
            a ≠ 0 ∧
            algebraMap Rx ↑P1.functionField a = (f : ↑P1.functionField) ∧
            (p = p₀ → Ideal.span ({a} : Set Rx) = mx) ∧
            (ψ ∉ p.asIdeal → Ideal.span ({a} : Set Rx) = ⊤) := by
    intro p₀ ψ hψ_ne hp₀_span
    let U_aff : P1.Opens := ι.opensRange
    have hAff_U : AlgebraicGeometry.IsAffineOpen U_aff :=
      AlgebraicGeometry.isAffineOpen_opensRange ι
    have hx_mem : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))),
        ι.base p ∈ (U_aff : Set ↥P1) := by
      intro p
      rw [AlgebraicGeometry.Scheme.Hom.coe_opensRange]
      exact ⟨p, rfl⟩
    let x_pt : PrimeSpectrum (Polynomial k) → ↥U_aff :=
      fun p => ⟨ι.base p, hx_mem p⟩
    have : Nonempty ↥(U_aff : AlgebraicGeometry.Scheme.{u}) := ⟨x_pt p₀⟩
    let R_U_cat : CommRingCat.{u} := P1.presheaf.obj (Opposite.op U_aff)
    let R_U : Type u := ↑R_U_cat
    have hrange : Set.range ⇑ι = Set.range ⇑hAff_U.fromSpec := by
      rw [← AlgebraicGeometry.Scheme.Hom.coe_opensRange, hAff_U.range_fromSpec]
    let e_sch : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ≅
        AlgebraicGeometry.Spec R_U_cat :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq ι hAff_U.fromSpec hrange
    have he_fac : e_sch.hom ≫ hAff_U.fromSpec = ι :=
      AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq_hom_fac ι hAff_U.fromSpec hrange
    let φ_hom : CommRingCat.of (Polynomial k) ⟶ R_U_cat :=
      AlgebraicGeometry.Spec.preimage e_sch.inv
    let φ_inv : R_U_cat ⟶ CommRingCat.of (Polynomial k) :=
      AlgebraicGeometry.Spec.preimage e_sch.hom
    have hφ1 : φ_hom ≫ φ_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_sch.hom_inv_id,
        AlgebraicGeometry.Spec.map_id]
    have hφ2 : φ_inv ≫ φ_hom = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_sch.inv_hom_id,
        AlgebraicGeometry.Spec.map_id]
    have hprime_pt : ∀ p : PrimeSpectrum (Polynomial k),
        hAff_U.primeIdealOf (x_pt p) = (AlgebraicGeometry.Spec.map φ_inv).base p := by
      intro p
      apply hAff_U.fromSpec.isOpenEmbedding.injective
      rw [hAff_U.fromSpec_primeIdealOf (x_pt p), AlgebraicGeometry.Spec.map_preimage]
      change ι.base p = hAff_U.fromSpec.base (e_sch.hom.base p)
      rw [← he_fac]
      rfl
    let ψ_U : R_U := φ_hom.hom ψ
    have hφ_inv_ψ : φ_inv.hom ψ_U = ψ :=
      congrArg (fun g : CommRingCat.of (Polynomial k) ⟶ _ => g.hom ψ) hφ1
    have hψU_ne : ψ_U ≠ 0 := by
      intro h0
      apply hψ_ne
      rw [← hφ_inv_ψ, h0, map_zero]
    have hp₀_U : (hAff_U.primeIdealOf (x_pt p₀)).asIdeal = Ideal.span ({ψ_U} : Set R_U) := by
      rw [hprime_pt p₀]
      change Ideal.comap φ_inv.hom p₀.asIdeal = Ideal.span ({ψ_U} : Set R_U)
      rw [hp₀_span]
      ext z
      rw [Ideal.mem_comap, Submodule.mem_span_singleton, Submodule.mem_span_singleton]
      constructor
      · rintro ⟨c, hc⟩
        refine ⟨φ_hom.hom c, ?_⟩
        calc
          φ_hom.hom c • ψ_U = φ_hom.hom (c * ψ) := by
            simp only [ψ_U, smul_eq_mul, map_mul]
          _ = φ_hom.hom (φ_inv.hom z) := by rw [← smul_eq_mul, hc]
          _ = z := congrArg (fun g : R_U_cat ⟶ R_U_cat => g.hom z) hφ2
      · rintro ⟨c', rfl⟩
        refine ⟨φ_inv.hom c', ?_⟩
        simp only [smul_eq_mul, map_mul, hφ_inv_ψ]
    have : IrreducibleSpace ↥P1 := AlgebraicGeometry.irreducibleSpace_of_isIntegral P1
    let f_K : ↑P1.functionField := (P1.germToFunctionField U_aff).hom ψ_U
    have hf_K : f_K ≠ 0 := by
      intro h0
      apply hψU_ne
      exact (P1.germToFunctionField_injective U_aff) (h0.trans (map_zero _).symm)
    let f : Units ↑P1.functionField := Units.mk0 f_K hf_K
    refine ⟨f, fun p => ?_⟩
    dsimp only
    let xp : ↥U_aff := x_pt p
    let Rx := ↑(P1.presheaf.stalk (ι.base p))
    let mx := IsLocalRing.maximalIdeal Rx
    let _ : Algebra R_U Rx := TopCat.Presheaf.algebra_section_stalk P1.presheaf xp
    have : IsLocalization.AtPrime Rx (hAff_U.primeIdealOf xp).asIdeal :=
      hAff_U.isLocalization_stalk xp
    let a : Rx := algebraMap R_U Rx ψ_U
    have ha_K : algebraMap Rx ↑P1.functionField a = (f : ↑P1.functionField) := by
      dsimp [a, f, f_K]
      rw [TopCat.Presheaf.stalk_open_algebraMap P1.presheaf xp]
      exact congrArg (fun g => g.hom ψ_U)
        (TopCat.Presheaf.germ_stalkSpecializes P1.presheaf xp.2
          (genericPoint_specializes (ι.base p)))
    have ha_ne : a ≠ 0 := by
      intro ha0
      apply hf_K
      change (f : ↑P1.functionField) = 0
      rw [← ha_K, ha0, map_zero]
    refine ⟨a, ha_ne, ha_K, ?_, ?_⟩
    · rintro rfl
      have hmax :=
        IsLocalization.AtPrime.map_eq_maximalIdeal (hAff_U.primeIdealOf (x_pt p)).asIdeal Rx
      rw [← hmax, hp₀_U, Ideal.map_span, Set.image_singleton]
    · intro hψ_not_p
      have hψU_compl : ψ_U ∈ (hAff_U.primeIdealOf xp).asIdeal.primeCompl := by
        change ψ_U ∉ (hAff_U.primeIdealOf xp).asIdeal
        rw [hprime_pt p]
        change φ_inv.hom ψ_U ∉ p.asIdeal
        rwa [hφ_inv_ψ]
      have ha_unit : IsUnit a :=
        (IsLocalization.AtPrime.isUnit_to_map_iff Rx (hAff_U.primeIdealOf xp).asIdeal ψ_U).mpr
          hψU_compl
      exact Ideal.span_singleton_eq_top.mpr ha_unit
  have hDVR_decomp : ∀ (R K : Type u) [CommRing R] [Field K] [Algebra R K] [IsFractionRing R K]
      (hDom : IsDomain R) (_ : @IsDiscreteValuationRing R _ hDom) (f : Units K),
      ∃ (a b : R) (na nb : ℕ),
        a ≠ 0 ∧ b ≠ 0 ∧
        algebraMap R K a = (f : K) * algebraMap R K b ∧
        Ideal.span ({a} : Set R) = (IsLocalRing.maximalIdeal R) ^ na ∧
        Ideal.span ({b} : Set R) = (IsLocalRing.maximalIdeal R) ^ nb := by
    intro R K _ _ _ _ hDom hDVR_R f
    let _ : IsDomain R := hDom
    let _ : IsDiscreteValuationRing R := hDVR_R
    obtain ⟨⟨a, b⟩, hab_mul⟩ := IsLocalization.surj (nonZeroDivisors R) (f : K)
    have hb_ne : b.1 ≠ 0 := nonZeroDivisors.ne_zero b.2
    have hb_K : algebraMap R K b.1 ≠ 0 :=
      fun h0 => hb_ne (IsFractionRing.injective R K (h0.trans (map_zero _).symm))
    have hab : algebraMap R K a = (f : K) * algebraMap R K b.1 := hab_mul.symm
    have ha_ne : a ≠ 0 := by
      intro ha0
      have ha_K : algebraMap R K a = 0 := by rw [ha0, map_zero]
      exact mul_ne_zero f.ne_zero hb_K (hab.symm.trans ha_K)
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hm_eq : IsLocalRing.maximalIdeal R = Ideal.span ({ϖ} : Set R) :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    obtain ⟨na, hna⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha_ne hϖ
    obtain ⟨nb, hnb⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb_ne hϖ
    have hspan_a : Ideal.span ({a} : Set R) = (IsLocalRing.maximalIdeal R) ^ na := by
      rw [hm_eq, Ideal.span_singleton_pow]
      exact Ideal.span_singleton_eq_span_singleton.mpr hna
    have hspan_b : Ideal.span ({b.1} : Set R) = (IsLocalRing.maximalIdeal R) ^ nb := by
      rw [hm_eq, Ideal.span_singleton_pow]
      exact Ideal.span_singleton_eq_span_singleton.mpr hnb
    exact ⟨a, b.1, na, nb, ha_ne, hb_ne, hab, hspan_a, hspan_b⟩
  have h_to_inf : ∀ Q : Pt,
      Finsupp.single Q 1 - Finsupp.single Q_inf 1 ∈ weilCurvePrincipalSubgroup P1 := by
    intro Q
    by_cases hQ_inf : Q = Q_inf
    · rw [hQ_inf, sub_self]
      exact AddSubgroup.zero_mem _
    · have hQ_val_ne : Q.1 ≠ q_inf := fun h => hQ_inf (Subtype.ext h)
      have hQ_range : Q.1 ∈ Set.range ι.base := by
        by_contra hnot
        have hmem_compl : Q.1 ∈ (Set.range ι_P1.base)ᶜ := hnot
        rw [hCompl, Set.mem_singleton_iff] at hmem_compl
        exact hQ_val_ne hmem_compl
      obtain ⟨p₀, hp₀⟩ := hQ_range
      have hp₀_max : p₀.asIdeal.IsMaximal :=
        hMax_of_closed p₀ (hp₀.symm ▸ Q.2)
      obtain ⟨a₀, hp₀_span, h_other_max⟩ := hMaxSpan p₀.asIdeal hp₀_max
      let ψ : Polynomial k := Polynomial.X - Polynomial.C a₀
      have hψ_ne : ψ ≠ 0 := Polynomial.X_sub_C_ne_zero a₀
      obtain ⟨f, hf_aff⟩ := hStalkSpan p₀ ψ hψ_ne hp₀_span
      obtain ⟨hDom_inf, hDVR_inf⟩ := hDVR Q_inf
      obtain ⟨a_inf, b_inf, na_inf, nb_inf, ha_inf_ne, hb_inf_ne, hab_inf,
          hspan_a_inf, hspan_b_inf⟩ :=
        hDVR_decomp ↑(P1.presheaf.stalk Q_inf.1) ↑P1.functionField hDom_inf hDVR_inf f
      let n_inf : ℤ := (na_inf : ℤ) - (nb_inf : ℤ)
      let D_ψ : Pt →₀ ℤ := Finsupp.single Q 1 + Finsupp.single Q_inf n_inf
      have hDψ_prin : D_ψ ∈ weilCurvePrincipalSubgroup P1 := by
        apply AddSubgroup.subset_closure
        refine ⟨f, fun x => ?_⟩
        by_cases hx_inf : x = Q_inf
        · subst hx_inf
          refine ⟨a_inf, b_inf, na_inf, nb_inf, ha_inf_ne, hb_inf_ne, hab_inf,
            hspan_a_inf, hspan_b_inf, ?_⟩
          simp [D_ψ, Ne.symm hQ_inf, n_inf]
        · rcases x with ⟨x_val, hx_cl⟩
          have hx_val_ne : x_val ≠ q_inf := fun h => hx_inf (Subtype.ext h)
          have hx_range : x_val ∈ Set.range ι.base := by
            by_contra hnot
            have hmem_compl : x_val ∈ (Set.range ι_P1.base)ᶜ := hnot
            rw [hCompl, Set.mem_singleton_iff] at hmem_compl
            exact hx_val_ne hmem_compl
          obtain ⟨p, hp⟩ := hx_range
          subst hp
          obtain ⟨a, ha_ne, ha_K, ha_p₀, ha_not⟩ := hf_aff p
          have : Nontrivial ↑(P1.presheaf.stalk (ι.base p)) := ⟨⟨a, 0, ha_ne⟩⟩
          by_cases hxQ : (⟨ι.base p, hx_cl⟩ : Pt) = Q
          · have hp_eq : p = p₀ :=
              ι.isOpenEmbedding.injective ((congrArg Subtype.val hxQ).trans hp₀.symm)
            refine ⟨a, 1, 1, 0, ha_ne, one_ne_zero, ?_, ?_, ?_, ?_⟩
            · rw [map_one, mul_one]
              exact ha_K
            · rw [pow_one]
              exact ha_p₀ hp_eq
            · rw [pow_zero, Ideal.one_eq_top]
              exact Ideal.span_singleton_one
            · rw [hxQ]
              simp [D_ψ, hQ_inf]
          · have hp_ne : p ≠ p₀ := by
              rintro rfl
              exact hxQ (Subtype.ext hp₀)
            have hp_id_ne : p.asIdeal ≠ p₀.asIdeal :=
              fun h => hp_ne (PrimeSpectrum.ext h)
            have hp_max : p.asIdeal.IsMaximal := hMax_of_closed p hx_cl
            have hψ_not_p : ψ ∉ p.asIdeal := h_other_max p.asIdeal hp_max hp_id_ne
            refine ⟨a, 1, 0, 0, ha_ne, one_ne_zero, ?_, ?_, ?_, ?_⟩
            · rw [map_one, mul_one]
              exact ha_K
            · rw [pow_zero, Ideal.one_eq_top]
              exact ha_not hψ_not_p
            · rw [pow_zero, Ideal.one_eq_top]
              exact Ideal.span_singleton_one
            · simp [D_ψ, hxQ, hx_inf]
      have hmk_zero : QuotientAddGroup.mk' (weilCurvePrincipalSubgroup P1) D_ψ = 0 := by
        rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
        exact hDψ_prin
      have hdeg_zero : D_ψ.sum (fun _ n => n) = 0 := by
        rw [← hDeg D_ψ, hmk_zero, map_zero]
      have hsum_eval : D_ψ.sum (fun _ n => n) = 1 + n_inf := by
        dsimp [D_ψ]
        rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
          Finsupp.sum_single_index rfl, Finsupp.sum_single_index rfl]
      have hn_inf : n_inf = -1 := by omega
      have hDψ_eq : D_ψ = Finsupp.single Q 1 - Finsupp.single Q_inf 1 := by
        dsimp [D_ψ]
        rw [hn_inf, Finsupp.single_neg, ← sub_eq_add_neg]
      rwa [← hDψ_eq]
  rw [← sub_sub_sub_cancel_right (Finsupp.single Q₁ (1 : ℤ))
    (Finsupp.single Q₂ (1 : ℤ)) (Finsupp.single Q_inf (1 : ℤ))]
  exact AddSubgroup.sub_mem _ (h_to_inf Q₁) (h_to_inf Q₂)

theorem weil_polyP1_last_coord_curve_cartier_weil_point_span (k : Type u) [Field k] [IsAlgClosed k] :
    (∀ (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.IsIntegral C₀.left]
        (_ : IsProjectiveOverField k C₀)
        [AlgebraicGeometry.IsProper C₀.hom]
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom],
      topologicalKrullDim C₀.left = (1 : WithBot ℕ∞) →
      ((∀ x : { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) },
          StrictAnti (fun n : ℕ => IsLocalRing.maximalIdeal ↑(C₀.left.presheaf.stalk x.1) ^ n)) ∧
        (∀ (U : C₀.left.Etale)
            (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C₀.left) }),
          ∃ hDom : IsDomain ↑(U.left.presheaf.stalk y.1),
            @IsDiscreteValuationRing ↑(U.left.presheaf.stalk y.1) _ hDom) ∧
        (∀ {U₁ U₂ : C₀.left.Etale} (g : U₁ ⟶ U₂)
            (y₁ : { y : ↥U₁.left // IsClosed ({U₁.hom.base y} : Set ↥C₀.left) }),
          let y₂ : { y : ↥U₂.left // IsClosed ({U₂.hom.base y} : Set ↥C₀.left) } :=
            ⟨g.left.base y₁.1, by
              rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, CategoryTheory.MorphismProperty.Over.w g]
              exact y₁.2⟩
          Function.Injective (g.left.stalkMap y₁.1).hom ∧
          ∀ n : ℕ,
            Ideal.map (g.left.stalkMap y₁.1).hom
              (IsLocalRing.maximalIdeal ↑(U₂.left.presheaf.stalk y₂.1) ^ n) =
            IsLocalRing.maximalIdeal ↑(U₁.left.presheaf.stalk y₁.1) ^ n) ∧
        (∀ (U : C₀.left.Etale) (u₀ : ↥U.left),
          ∃ (W₀ : C₀.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen W₀)
            (V₀ : U.left.Opens) (_ : AlgebraicGeometry.IsAffineOpen V₀) (_ : u₀ ∈ V₀)
            (e : V₀ ≤ (TopologicalSpace.Opens.map U.hom.base).obj W₀),
            IsDomain ↑(U.left.presheaf.obj (Opposite.op V₀)) ∧
            Function.Injective (U.hom.appLE W₀ V₀ e).hom ∧
            (∀ q : Ideal ↑(U.left.presheaf.obj (Opposite.op V₀)),
              q.IsPrime → Ideal.comap (U.hom.appLE W₀ V₀ e).hom q = ⊥ → q = ⊥) ∧
            (∀ m : Ideal ↑(U.left.presheaf.obj (Opposite.op V₀)),
              m.IsMaximal → m ≠ ⊥ →
              ∃ (y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C₀.left) }) (hy : y.1 ∈ V₀),
                Ideal.comap (U.left.presheaf.germ V₀ y.1 hy).hom
                  (IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1)) = m) ∧
            (∀ y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C₀.left) },
              IsOpen ((V₀ : Set ↥U.left) \ {y.1})) ∧
            (∀ d : ↑(U.left.presheaf.obj (Opposite.op V₀)),
              d ≠ 0 →
              { y : { y : ↥U.left // IsClosed ({U.hom.base y} : Set ↥C₀.left) } |
                ∃ hy : y.1 ∈ V₀,
                  (U.left.presheaf.germ V₀ y.1 hy).hom d ∈
                    IsLocalRing.maximalIdeal ↑(U.left.presheaf.stalk y.1) }.Finite))) →
      let Pt := { x : ↥C₀.left // IsClosed ({x} : Set ↥C₀.left) }
      ∃ (Q_div : CategoryTheory.Sheaf C₀.left.smallEtaleTopology AddCommGrpCat.{u})
        (ι_div : Quiver.Hom (weilEtaleGmSheaf C₀.left) (weilEtaleKSheaf C₀.left))
        (π_div : Quiver.Hom (weilEtaleKSheaf C₀.left) Q_div)
        (h0_div : CategoryTheory.CategoryStruct.comp ι_div π_div = 0)
        (hSE_div : (CategoryTheory.ShortComplex.mk ι_div π_div h0_div).ShortExact)
        (div_H0 : Q_div.H 0 →+ (Pt →₀ ℤ)),
        Function.Bijective div_H0 ∧
