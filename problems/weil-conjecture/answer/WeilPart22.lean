      | succ b' =>
        have hv_zero : R_map (b' + 1) (CategoryTheory.ShortComplex.mk u v huv).g = 0 :=
          (hZero (b' + 1) (Nat.succ_pos b')).eq_of_src _ 0
        have hv_zero' : R'_map (b' + 1) ((CategoryTheory.ShortComplex.mk u v huv).map pb').g = 0 :=
          (hZero' (b' + 1) (Nat.succ_pos b')).eq_of_src _ 0
