      ext r
      obtain ⟨c, rfl⟩ := hBij_kR.2 r
      exact congrArg (fun ψ => ψ.hom c) hk_comp
    have hφ_id : φ = CategoryTheory.CategoryStruct.id X.left := by
      apply (CategoryTheory.cancel_mono X.left.toSpecΓ).mp
      rw [CategoryTheory.Category.id_comp, AlgebraicGeometry.Scheme.toSpecΓ_naturality φ,
        hφ_appTop_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.comp_id]
    refine ⟨hφ_id, ?_⟩
    rw [hφ_id] at hφ_free
    obtain ⟨_, hcharts⟩ := hφ_free
    obtain ⟨V_f, hη_Vf, _, _, M, hAddM, hModM, e, he, ⟨bM⟩⟩ := hcharts η
    have hVf_top : V_f = ⊤ := hOpen_eq_top V_f ⟨η, hη_Vf⟩
    subst hVf_top
    let _ : AddCommGroup M := hAddM
    let _ : Module R M := hModM
    let eR : M ≃+ R := e
    let e_lin : M ≃ₗ[R] R :=
      { eR with
        map_smul' := fun b m => by
          have h := he b m
          have hid_b : (CommRingCat.Hom.hom
              (AlgebraicGeometry.Scheme.Hom.app (CategoryTheory.CategoryStruct.id X.left) ⊤)) b = b := by
            rw [AlgebraicGeometry.Scheme.Hom.id_app]
            rfl
          exact h.trans (congrArg (· * eR m) hid_b) }
    have hcard := Module.finrank_eq_card_basis bM
    rw [Fintype.card_fin, LinearEquiv.finrank_eq e_lin, Module.finrank_self R] at hcard
    exact hcard.symm

theorem weil_polyP1_last_coord_base_agreement_and_fiber_decomp (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff)
    (hCurve1D : ∀ (C : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine C] [AlgebraicGeometry.IsIntegral C]
        (v₁ v₂ : Quiver.Hom C (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))),
      AlgebraicGeometry.Etale v₁ →
      AlgebraicGeometry.Etale v₂ →
      CategoryTheory.CategoryStruct.comp v₁
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) =
        CategoryTheory.CategoryStruct.comp v₂
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) →
      ∀ (hEt₁ : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp v₁ ι_P1))
        (hEt₂ : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp v₂ ι_P1)),
        let P1_over := weilProjectiveSpaceOver k 1
        let U_C1 : P1_over.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.comp v₁ ι_P1) hEt₁
        let U_C2 : P1_over.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.comp v₂ ι_P1) hEt₂
        ∀ (hRoof_C : WeilIsAffineRoofIso k P1_over P1_over U_C1 U_C2 (CategoryTheory.Iso.refl C))
          (z_C : weilEtaleLocalTorsionH P1_over.left (ℓ ^ r) U_C1 2),
          weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U_C1 2 z_C =
            weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U_C2 2
              (Ψ P1_over P1_over U_C1 U_C2 (CategoryTheory.Iso.refl C) hRoof_C r 2 z_C))
    (m : ℕ)
    (U₁ U₂ : (weilPolyP1Over k (m + 1)).left.Etale)
    (u₁ : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₁).left
      (weilAffineSpaceOver k (m + 1)).left)
    (u₂ : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₂).left
      (weilAffineSpaceOver k (m + 1)).left)
    (e : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₁).left
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₂).left)
    (h : WeilIsAffineRoofIso k (weilPolyP1Over k (m + 1)) (weilPolyP1Over k (m + 1)) U₁ U₂ e)
    (hu₁ : AlgebraicGeometry.Etale u₁)
    (hu₂ : AlgebraicGeometry.Etale u₂)
    (hcomp₁ : CategoryTheory.CategoryStruct.comp u₁ (ι_aff (m + 1)) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₁).hom)
    (hcomp₂ : CategoryTheory.CategoryStruct.comp u₂ (ι_aff (m + 1)) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₂).hom)
    (hagree : ∀ (i : Fin (m + 1)), i ≠ Fin.last m →
      let pr_i : Quiver.Hom (weilAffineSpaceOver k (m + 1)).left
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k)).toRingHom)
      CategoryTheory.CategoryStruct.comp u₁ pr_i =
        CategoryTheory.CategoryStruct.comp e.hom
          (CategoryTheory.CategoryStruct.comp u₂ pr_i)) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P1_over := weilProjectiveSpaceOver k 1
    let P_m := weilPolyP1Over k m
    let P := weilPolyP1Over k (m + 1)
    let Fgt_P := AlgebraicGeometry.Scheme.Etale.forget P.left
    let Fgt_P1 := AlgebraicGeometry.Scheme.Etale.forget P1_over.left
    let π_fst := CategoryTheory.Limits.pullback.fst P_m.hom P1_over.hom
    CategoryTheory.CategoryStruct.comp (Fgt_P.obj U₁).hom π_fst =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp e.hom (Fgt_P.obj U₂).hom) π_fst ∧
    ∀ (σ : Quiver.Hom S_k P_m.left)
      (hσ : CategoryTheory.CategoryStruct.comp σ P_m.hom = CategoryTheory.CategoryStruct.id S_k),
      let ι_σ : Quiver.Hom P1_over.left P.left :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.CategoryStruct.comp P1_over.hom σ)
          (CategoryTheory.CategoryStruct.id P1_over.left)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp _) hσ).trans
              (CategoryTheory.Category.comp_id _) |>.trans
                (CategoryTheory.Category.id_comp _).symm))
      let U₁_σ : P1_over.left.Etale := (weilEtaleSitePullback ι_σ).obj U₁
      let U₂_σ : P1_over.left.Etale := (weilEtaleSitePullback ι_σ).obj U₂
      ∀ (e_σ : CategoryTheory.Iso (Fgt_P1.obj U₁_σ).left (Fgt_P1.obj U₂_σ).left),
        CategoryTheory.CategoryStruct.comp e_σ.hom
            (CategoryTheory.Limits.pullback.fst (Fgt_P.obj U₂).hom ι_σ) =
          CategoryTheory.CategoryStruct.comp
            (CategoryTheory.Limits.pullback.fst (Fgt_P.obj U₁).hom ι_σ) e.hom →
        ∀ (hRoof_σ : WeilIsAffineRoofIso k P1_over P1_over U₁_σ U₂_σ e_σ)
          (z_σ : weilEtaleLocalTorsionH P1_over.left (ℓ ^ r) U₁_σ 2),
          weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U₁_σ 2 z_σ =
            weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U₂_σ 2
              (Ψ P1_over P1_over U₁_σ U₂_σ e_σ hRoof_σ r 2 z_σ) :=
by
  classical
  intro S_k P1_over P_m P Fgt_P Fgt_P1 π_fst
  let π_fst_P : Quiver.Hom P.left P_m.left := π_fst
  let π_snd : CategoryTheory.Limits.pullback P_m.hom P1_over.hom ⟶ P1_over.left :=
    CategoryTheory.Limits.pullback.snd P_m.hom P1_over.hom
  let π_snd_P : Quiver.Hom P.left P1_over.left := π_snd

  have hOpen_ιP1 : AlgebraicGeometry.IsOpenImmersion ι_P1 := hCoord.2.2.2.2.1
  have _ : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen_ιP1
  have hEt_ιP1 : AlgebraicGeometry.Etale ι_P1 := inferInstance
  have hιP1_hom :
      CategoryTheory.CategoryStruct.comp ι_P1 P1_over.hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) :=
    hCoord.2.2.2.2.2.1
  have hCoord_δ := hCoord.2.2.2.2.2.2.2.2
  have hιaff_hom_succ :
      CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) P.hom =
        (weilAffineSpaceOver k (m + 1)).hom :=
    (hCoord_δ (m + 1)).2.2.1
  let ren_hom :
      CommRingCat.of (MvPolynomial (Fin m) k) ⟶
        CommRingCat.of (MvPolynomial (Fin (m + 1)) k) :=
    CommRingCat.ofHom
      (MvPolynomial.rename Fin.castSucc :
        MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin (m + 1)) k).toRingHom
  let π_head : (weilAffineSpaceOver k (m + 1)).left ⟶ (weilAffineSpaceOver k m).left :=
    AlgebraicGeometry.Spec.map ren_hom
  have hιaff_fst :
      CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) π_fst_P =
        CategoryTheory.CategoryStruct.comp π_head (ι_aff m) :=
    (hCoord_δ m).2.2.2.1
  let pr_last :
      (weilAffineSpaceOver k (m + 1)).left ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      (Polynomial.aeval (R := k)
        (MvPolynomial.X (Fin.last m) : MvPolynomial (Fin (m + 1)) k)).toRingHom)
  have hιaff_snd :
      CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) π_snd_P =
        CategoryTheory.CategoryStruct.comp pr_last ι_P1 :=
    (hCoord_δ m).2.2.2.2

  
  let W₁ : AlgebraicGeometry.Scheme.{u} := (Fgt_P.obj U₁).left
  have _ : AlgebraicGeometry.IsAffine W₁ := h.2.2.1
  have he_over :
      CategoryTheory.CategoryStruct.comp e.hom
        (CategoryTheory.CategoryStruct.comp (Fgt_P.obj U₂).hom P.hom) =
        CategoryTheory.CategoryStruct.comp (Fgt_P.obj U₁).hom P.hom :=
    h.2.2.2
  have h_base :
      CategoryTheory.CategoryStruct.comp (Fgt_P.obj U₁).hom π_fst_P =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.CategoryStruct.comp e.hom (Fgt_P.obj U₂).hom) π_fst_P := by
    let R₁ : CommRingCat.{u} := W₁.presheaf.obj (Opposite.op ⊤)
    let e_W₁ : W₁ ≅ AlgebraicGeometry.Spec R₁ := W₁.isoSpec
    let u₁_aff : W₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (m + 1)) k)) := u₁
    let u₂_aff : W₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin (m + 1)) k)) :=
      e.hom ≫ u₂
    let φ₁ : CommRingCat.of (MvPolynomial (Fin (m + 1)) k) ⟶ R₁ :=
      AlgebraicGeometry.Spec.preimage (e_W₁.inv ≫ u₁_aff)
    let φ₂ : CommRingCat.of (MvPolynomial (Fin (m + 1)) k) ⟶ R₁ :=
      AlgebraicGeometry.Spec.preimage (e_W₁.inv ≫ u₂_aff)
    have hC_eq :
        CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (m + 1)) k) ≫ φ₁ =
          CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (m + 1)) k) ≫ φ₂ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
        AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      change (e_W₁.inv ≫ u₁) ≫ (weilAffineSpaceOver k (m + 1)).hom =
        (e_W₁.inv ≫ (e.hom ≫ u₂)) ≫ (weilAffineSpaceOver k (m + 1)).hom
      rw [← hιaff_hom_succ]
      calc
        (e_W₁.inv ≫ u₁) ≫ (ι_aff (m + 1) ≫ P.hom)
          = e_W₁.inv ≫ ((u₁ ≫ ι_aff (m + 1)) ≫ P.hom) := by
              simp only [CategoryTheory.Category.assoc]
        _ = e_W₁.inv ≫ ((Fgt_P.obj U₁).hom ≫ P.hom) := by rw [hcomp₁]
        _ = e_W₁.inv ≫ (e.hom ≫ ((Fgt_P.obj U₂).hom ≫ P.hom)) := by rw [← he_over]
        _ = e_W₁.inv ≫ (e.hom ≫ ((u₂ ≫ ι_aff (m + 1)) ≫ P.hom)) := by rw [hcomp₂]
        _ = (e_W₁.inv ≫ (e.hom ≫ u₂)) ≫ (ι_aff (m + 1) ≫ P.hom) := by
              simp only [CategoryTheory.Category.assoc]
    have hren_eq : ren_hom ≫ φ₁ = ren_hom ≫ φ₂ := by
      apply CommRingCat.hom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        change φ₁.hom ((MvPolynomial.rename Fin.castSucc) (MvPolynomial.C c)) =
          φ₂.hom ((MvPolynomial.rename Fin.castSucc) (MvPolynomial.C c))
        rw [MvPolynomial.rename_C]
        exact congrArg (fun g : CommRingCat.of k ⟶ R₁ => g.hom c) hC_eq
      · intro j
        let pr_j :
            (weilAffineSpaceOver k (m + 1)).left ⟶
              AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (R := k)
              (MvPolynomial.X j.castSucc : MvPolynomial (Fin (m + 1)) k)).toRingHom)
        have hj_agree : u₁ ≫ pr_j = e.hom ≫ (u₂ ≫ pr_j) :=
          hagree j.castSucc (Fin.castSucc_ne_last j)
        have hj_ring :
            CommRingCat.ofHom
                (Polynomial.aeval (R := k) (MvPolynomial.X j.castSucc :
                  MvPolynomial (Fin (m + 1)) k)).toRingHom ≫ φ₁ =
              CommRingCat.ofHom
                (Polynomial.aeval (R := k) (MvPolynomial.X j.castSucc :
                  MvPolynomial (Fin (m + 1)) k)).toRingHom ≫ φ₂ := by
          apply AlgebraicGeometry.Spec.map_injective
          rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
            AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
          change (e_W₁.inv ≫ u₁) ≫ pr_j = (e_W₁.inv ≫ (e.hom ≫ u₂)) ≫ pr_j
          simp only [CategoryTheory.Category.assoc, hj_agree]
        have hj_X :=
          congrArg (fun g : CommRingCat.of (Polynomial k) ⟶ R₁ => g.hom Polynomial.X) hj_ring
        change φ₁.hom ((Polynomial.aeval (R := k) (MvPolynomial.X j.castSucc)) Polynomial.X) =
          φ₂.hom ((Polynomial.aeval (R := k) (MvPolynomial.X j.castSucc)) Polynomial.X) at hj_X
        rw [Polynomial.aeval_X] at hj_X
        change φ₁.hom ((MvPolynomial.rename Fin.castSucc) (MvPolynomial.X j)) =
          φ₂.hom ((MvPolynomial.rename Fin.castSucc) (MvPolynomial.X j))
        rw [MvPolynomial.rename_X]
        exact hj_X
    have hu_aff :
        u₁_aff ≫ AlgebraicGeometry.Spec.map ren_hom =
          u₂_aff ≫ AlgebraicGeometry.Spec.map ren_hom := by
      apply (cancel_epi e_W₁.inv).mp
      have h_map1 : AlgebraicGeometry.Spec.map φ₁ = e_W₁.inv ≫ u₁_aff :=
        AlgebraicGeometry.Spec.map_preimage _
      have h_map2 : AlgebraicGeometry.Spec.map φ₂ = e_W₁.inv ≫ u₂_aff :=
        AlgebraicGeometry.Spec.map_preimage _
      calc
        e_W₁.inv ≫ (u₁_aff ≫ AlgebraicGeometry.Spec.map ren_hom)
          = (e_W₁.inv ≫ u₁_aff) ≫ AlgebraicGeometry.Spec.map ren_hom :=
              (CategoryTheory.Category.assoc e_W₁.inv u₁_aff _).symm
        _ = AlgebraicGeometry.Spec.map φ₁ ≫ AlgebraicGeometry.Spec.map ren_hom := by
              rw [← h_map1]
        _ = AlgebraicGeometry.Spec.map (ren_hom ≫ φ₁) :=
              (AlgebraicGeometry.Spec.map_comp ren_hom φ₁).symm
        _ = AlgebraicGeometry.Spec.map (ren_hom ≫ φ₂) := by rw [hren_eq]
        _ = AlgebraicGeometry.Spec.map φ₂ ≫ AlgebraicGeometry.Spec.map ren_hom :=
              AlgebraicGeometry.Spec.map_comp ren_hom φ₂
        _ = (e_W₁.inv ≫ u₂_aff) ≫ AlgebraicGeometry.Spec.map ren_hom := by
              rw [h_map2]
        _ = e_W₁.inv ≫ (u₂_aff ≫ AlgebraicGeometry.Spec.map ren_hom) :=
              CategoryTheory.Category.assoc e_W₁.inv u₂_aff _
    have hu_head : u₁ ≫ π_head = (e.hom ≫ u₂) ≫ π_head := hu_aff
    calc
      (Fgt_P.obj U₁).hom ≫ π_fst_P
        = (u₁ ≫ ι_aff (m + 1)) ≫ π_fst_P := by rw [← hcomp₁]
      _ = (u₁ ≫ π_head) ≫ ι_aff m := by
            rw [CategoryTheory.Category.assoc, hιaff_fst, ← CategoryTheory.Category.assoc]
      _ = ((e.hom ≫ u₂) ≫ π_head) ≫ ι_aff m := by rw [hu_head]
      _ = (e.hom ≫ (u₂ ≫ ι_aff (m + 1))) ≫ π_fst_P := by
            rw [CategoryTheory.Category.assoc (e.hom ≫ u₂) π_head (ι_aff m), ← hιaff_fst,
              ← CategoryTheory.Category.assoc e.hom, ← CategoryTheory.Category.assoc]
      _ = (e.hom ≫ (Fgt_P.obj U₂).hom) ≫ π_fst_P := by rw [hcomp₂]

  
  have hClopenCurveCover :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (v : Quiver.Hom W (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))),
        AlgebraicGeometry.Etale v →
        ∃ (s : ℕ)
          (C : Fin s → AlgebraicGeometry.Scheme.{u})
          (ι : ∀ a : Fin s, Quiver.Hom (C a) W),
          (∀ a : Fin s, AlgebraicGeometry.IsAffine (C a)) ∧
          (∀ a : Fin s, AlgebraicGeometry.IsIntegral (C a)) ∧
          (∀ a : Fin s, AlgebraicGeometry.IsOpenImmersion (ι a)) ∧
          (∀ a b : Fin s, a ≠ b → Disjoint (Set.range (ι a).base) (Set.range (ι b).base)) ∧
          (⋃ a : Fin s, Set.range (ι a).base) = Set.univ := by
    intro W hAffW v hv
    let B_cat : CommRingCat.{u} := W.presheaf.obj (Opposite.op ⊤)
    let B : Type u := ↑B_cat
    let e_W : W ≅ AlgebraicGeometry.Spec B_cat := W.isoSpec
    let φ_cat : CommRingCat.of (Polynomial k) ⟶ B_cat :=
      AlgebraicGeometry.Spec.preimage (e_W.inv ≫ v)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_cat = e_W.inv ≫ v :=
      AlgebraicGeometry.Spec.map_preimage _
    have hEt_spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_cat) := by
      rw [hmap_φ]
      infer_instance
    have hEt_hom : RingHom.Etale φ_cat.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_spec
    let _ : Algebra (Polynomial k) B := φ_cat.hom.toAlgebra
    have _ : Algebra.Etale (Polynomial k) B := RingHom.etale_algebraMap.mp hEt_hom
    let _ : Algebra k B := (φ_cat.hom.comp Polynomial.C).toAlgebra
    have _ : IsScalarTower k (Polynomial k) B := IsScalarTower.of_algebraMap_eq' rfl
    have _ : Algebra.FiniteType (Polynomial k) B := inferInstance
    have _ : Algebra.FiniteType k B :=
      Algebra.FiniteType.trans (R := k) (S := Polynomial k) (A := B) inferInstance inferInstance
    have _ : IsNoetherianRing (Polynomial k) := Polynomial.isNoetherianRing
    have _ : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing (Polynomial k) B

    have hAtPrimeDomain : ∀ (m₀ : Ideal B) [m₀.IsMaximal], IsDomain (Localization.AtPrime m₀) := by
      intro m₀ hm₀
      obtain ⟨n_mv, q_mv, hq_surj⟩ :=
        Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (inferInstance : Algebra.FiniteType k B)
      let q_hom : MvPolynomial (Fin n_mv) k →+* B := q_mv.toRingHom
      have hq_hom_surj : Function.Surjective q_hom := hq_surj
      let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom m₀
      have hm_mv : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
      obtain ⟨a_pt, ha_pt⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv
      let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
      have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
        intro f_p hf_p
        rw [RingHom.mem_ker] at hf_p
        have hmem : f_p ∈ m_mv := by
          change q_hom f_p ∈ m₀
          rw [hf_p]
          exact m₀.zero_mem
        rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
        exact hmem
      let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
      let ε : B →+* k :=
        (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
      have hε_q : ∀ f_p : MvPolynomial (Fin n_mv) k, ε (q_hom f_p) = ev_hom f_p := by
        intro f_p
        dsimp [ε]
        have heq_q : e_quot.symm (q_hom f_p) =
            Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
          apply e_quot.injective
          simp [e_quot]
        rw [heq_q, Ideal.Quotient.lift_mk]
      have hε_k : ∀ c₀ : k, ε (algebraMap k B c₀) = c₀ := by
        intro c₀
        have hq_C : q_hom (MvPolynomial.C c₀) = algebraMap k B c₀ := q_mv.commutes c₀
        rw [← hq_C, hε_q]
        exact (MvPolynomial.aeval a_pt).commutes c₀
      have hε_ker : ∀ b : B, ε b = 0 ↔ b ∈ m₀ := by
        intro b
        obtain ⟨f_p, rfl⟩ := hq_hom_surj b
        rw [hε_q]
        change (MvPolynomial.aeval a_pt) f_p = 0 ↔ f_p ∈ m_mv
        rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]

      let c : k := ε (algebraMap (Polynomial k) B Polynomial.X)
      let p : Polynomial k := Polynomial.X - Polynomial.C c
      let t : B := algebraMap (Polynomial k) B p
      have ht_m₀ : t ∈ m₀ := by
        rw [← hε_ker]
        dsimp [t, p]
        rw [map_sub, map_sub]
        have hC : algebraMap (Polynomial k) B (Polynomial.C c) = algebraMap k B c := rfl
        rw [hC, hε_k, sub_self]
      let J : Ideal B := m₀ ^ 2 ⊔ Ideal.span {t}
      let Q := B ⧸ J
      let I_Q : Ideal Q := Ideal.map (Ideal.Quotient.mk J) m₀
      have hIQ_sq : I_Q ^ 2 = ⊥ := by
        dsimp [I_Q]
        rw [← Ideal.map_pow, Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
        exact le_sup_left
      let f₁ : B →ₐ[Polynomial k] Q := Ideal.Quotient.mkₐ (Polynomial k) J
      let f₂_ring : B →+* Q := (algebraMap k Q).comp ε
      have hf₂_comm : f₂_ring.comp (algebraMap (Polynomial k) B) = algebraMap (Polynomial k) Q := by
        apply Polynomial.ringHom_ext
        · intro a
          simp only [f₂_ring, RingHom.comp_apply]
          have h1 : algebraMap (Polynomial k) B (Polynomial.C a) = algebraMap k B a := rfl
          have h2 : algebraMap (Polynomial k) Q (Polynomial.C a) = algebraMap k Q a :=
            (IsScalarTower.algebraMap_apply k (Polynomial k) Q a).symm
          rw [h1, hε_k, h2]
        · simp only [f₂_ring, RingHom.comp_apply]
          have ht_in_J : t ∈ J :=
            (le_sup_right : Ideal.span {t} ≤ J) (Ideal.mem_span_singleton_self t)
          have ht_zero : Ideal.Quotient.mk J t = 0 :=
            Ideal.Quotient.eq_zero_iff_mem.mpr ht_in_J
          have hsub : algebraMap (Polynomial k) Q Polynomial.X - algebraMap k Q c = 0 := by
            have h1 : algebraMap (Polynomial k) Q (Polynomial.C c) = algebraMap k Q c :=
              (IsScalarTower.algebraMap_apply k (Polynomial k) Q c).symm
            rw [← h1, ← map_sub]
            exact ht_zero
          exact (sub_eq_zero.mp hsub).symm
      let f₂ : B →ₐ[Polynomial k] Q :=
        { f₂_ring with
          commutes' := fun r₀ => DFunLike.congr_fun hf₂_comm r₀ }
      have hf_mod : (Ideal.Quotient.mkₐ (Polynomial k) I_Q).comp f₁ =
          (Ideal.Quotient.mkₐ (Polynomial k) I_Q).comp f₂ := by
        ext b
        change Ideal.Quotient.mk I_Q (Ideal.Quotient.mk J b) =
          Ideal.Quotient.mk I_Q (algebraMap k Q (ε b))
        rw [Ideal.Quotient.eq]
        have h_alg : algebraMap k Q (ε b) = Ideal.Quotient.mk J (algebraMap k B (ε b)) :=
          IsScalarTower.algebraMap_apply k B Q (ε b)
        rw [h_alg, ← map_sub]
        apply Ideal.mem_map_of_mem
        rw [← hε_ker, map_sub, hε_k, sub_self]
      have hf_eq : f₁ = f₂ :=
        Algebra.FormallyUnramified.comp_injective I_Q hIQ_sq hf_mod
      have hm₀_eq_J : m₀ ≤ J := by
        intro b hb
        have hb0 : ε b = 0 := (hε_ker b).mpr hb
        have hmk0 : Ideal.Quotient.mk J b = 0 := by
          change f₁ b = 0
          rw [hf_eq]
          change algebraMap k Q (ε b) = 0
          rw [hb0, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0

      let S_loc := Localization.AtPrime m₀
      have _ : IsNoetherianRing S_loc :=
        IsLocalization.isNoetherianRing m₀.primeCompl S_loc inferInstance
      let M_S : Ideal S_loc := IsLocalRing.maximalIdeal S_loc
      let t_S : S_loc := algebraMap B S_loc t
      have hMS_map : M_S = Ideal.map (algebraMap B S_loc) m₀ :=
        (Localization.AtPrime.map_eq_maximalIdeal (I := m₀)).symm
      have hMS_le_sup : M_S ≤ Ideal.span ({t_S} : Set S_loc) ⊔ M_S • M_S := by
        calc
          M_S = Ideal.map (algebraMap B S_loc) m₀ := hMS_map
          _ ≤ Ideal.map (algebraMap B S_loc) J := Ideal.map_mono hm₀_eq_J
          _ = Ideal.map (algebraMap B S_loc) (m₀ ^ 2) ⊔
                Ideal.map (algebraMap B S_loc) (Ideal.span {t}) :=
              Ideal.map_sup _ _ _
          _ = M_S ^ 2 ⊔ Ideal.span ({t_S} : Set S_loc) := by
              rw [Ideal.map_pow, ← hMS_map, Ideal.map_span, Set.image_singleton]
          _ = Ideal.span ({t_S} : Set S_loc) ⊔ M_S • M_S := by
              rw [sup_comm, pow_two, smul_eq_mul]
      have hMS_le_span : M_S ≤ Ideal.span ({t_S} : Set S_loc) :=
        Submodule.le_of_le_smul_of_le_jacobson_bot
          (IsNoetherian.noetherian M_S)
          (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal S_loc))
          hMS_le_sup
      have hMS_eq : M_S = Ideal.span ({t_S} : Set S_loc) := by
        apply le_antisymm hMS_le_span
        rw [Ideal.span_singleton_le_iff_mem, hMS_map]
        exact Ideal.mem_map_of_mem _ ht_m₀

      have ht_pow_ne : ∀ n : ℕ, t_S ^ n ≠ 0 := by
        intro n htn
        rw [← map_pow] at htn
        obtain ⟨s₀, hs₀_eq⟩ := (IsLocalization.map_eq_zero_iff m₀.primeCompl S_loc (t ^ n)).mp htn
        let B' := Polynomial k ⧸ Ideal.span ({p ^ (n + 1)} : Set (Polynomial k))
        let _ : CommRing B' := Ideal.Quotient.commRing _
        let _ : Algebra (Polynomial k) B' := Ideal.Quotient.algebra (Polynomial k)
        let _ : Algebra k B' := Ideal.Quotient.algebra k
        have _ : IsScalarTower k (Polynomial k) B' :=
          Ideal.Quotient.isScalarTower k (Polynomial k) _
        let p_bar : B' := Ideal.Quotient.mk (Ideal.span ({p ^ (n + 1)} : Set (Polynomial k))) p
        let I : Ideal B' := Ideal.span ({p_bar} : Set B')
        have hI_nil : IsNilpotent I := by
          refine ⟨n + 1, ?_⟩
          dsimp [I]
          rw [Ideal.span_singleton_pow, Ideal.span_singleton_eq_bot]
          dsimp [p_bar]
          rw [← map_pow]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
        let g_ring : B →+* (B' ⧸ I) := (algebraMap k (B' ⧸ I)).comp ε
        have hg_comm : g_ring.comp (algebraMap (Polynomial k) B) =
            algebraMap (Polynomial k) (B' ⧸ I) := by
          apply Polynomial.ringHom_ext
          · intro a
            simp only [g_ring, RingHom.comp_apply]
            have h1 : algebraMap (Polynomial k) B (Polynomial.C a) = algebraMap k B a := rfl
            have h2 : algebraMap (Polynomial k) (B' ⧸ I) (Polynomial.C a) =
                algebraMap k (B' ⧸ I) a :=
              (IsScalarTower.algebraMap_apply k (Polynomial k) (B' ⧸ I) a).symm
            rw [h1, hε_k, h2]
          · simp only [g_ring, RingHom.comp_apply]
            have hp_zero : algebraMap (Polynomial k) (B' ⧸ I) p = (0 : B' ⧸ I) := by
              have h1 : algebraMap (Polynomial k) (B' ⧸ I) p = Ideal.Quotient.mk I p_bar := rfl
              rw [h1]
              exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self p_bar)
            have hsub : algebraMap (Polynomial k) (B' ⧸ I) Polynomial.X -
                algebraMap k (B' ⧸ I) c = 0 := by
              have h1 : algebraMap (Polynomial k) (B' ⧸ I) (Polynomial.C c) =
                  algebraMap k (B' ⧸ I) c :=
                (IsScalarTower.algebraMap_apply k (Polynomial k) (B' ⧸ I) c).symm
              rw [← h1, ← map_sub]
              exact hp_zero
            exact (sub_eq_zero.mp hsub).symm
        let g : B →ₐ[Polynomial k] (B' ⧸ I) :=
          { g_ring with
            commutes' := fun r₀ => DFunLike.congr_fun hg_comm r₀ }
        obtain ⟨f_lift, hf_lift⟩ := Algebra.FormallySmooth.exists_lift I hI_nil g
        let u_part : B' := algebraMap k B' (ε (s₀ : B))
        let r_part : B' := f_lift (s₀ : B) - u_part
        have hs₀_notMem : (s₀ : B) ∉ m₀ := s₀.2
        have hε_s₀_ne : ε (s₀ : B) ≠ 0 := fun h0 => hs₀_notMem ((hε_ker _).mp h0)
        have hu_unit : IsUnit u_part := (Ne.isUnit hε_s₀_ne).map (algebraMap k B')
        have hr_mem : r_part ∈ I := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          dsimp [r_part]
          rw [map_sub, sub_eq_zero]
          have h1 : Ideal.Quotient.mk I (f_lift (s₀ : B)) =
              ((Ideal.Quotient.mkₐ (Polynomial k) I).comp f_lift) (s₀ : B) := rfl
          rw [h1, hf_lift]
          exact (IsScalarTower.algebraMap_apply k B' (B' ⧸ I) (ε (s₀ : B))).symm
        have hr_nil : IsNilpotent r_part := by
          refine ⟨n + 1, ?_⟩
          have hpow_mem : r_part ^ (n + 1) ∈ I ^ (n + 1) := Ideal.pow_mem_pow hr_mem (n + 1)
          have hI_bot : I ^ (n + 1) = ⊥ := by
            dsimp [I]
            rw [Ideal.span_singleton_pow, Ideal.span_singleton_eq_bot, ← map_pow]
            exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
          rwa [hI_bot, Ideal.mem_bot] at hpow_mem
        have hfs₀_unit : IsUnit (f_lift (s₀ : B)) := by
          have heq : u_part + r_part = f_lift (s₀ : B) := add_sub_cancel u_part _
          rw [← heq]
          exact IsNilpotent.isUnit_add_left_of_commute hr_nil hu_unit (Commute.all _ _)
        have hprod_zero : f_lift (s₀ : B) * p_bar ^ n = 0 := by
          have hft : f_lift t = p_bar := f_lift.commutes p
          rw [← hft, ← map_pow, ← map_mul, hs₀_eq, map_zero]
        have hpbar_zero : p_bar ^ n = 0 := hfs₀_unit.mul_right_eq_zero.mp hprod_zero
        rw [← map_pow] at hpbar_zero
        have hdvd : p ^ (n + 1) ∣ p ^ n :=
          Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hpbar_zero)
        have hp_monic : p.Monic := Polynomial.monic_X_sub_C c
        have hpn_ne : p ^ n ≠ 0 := (hp_monic.pow n).ne_zero
        have hdeg := Polynomial.natDegree_le_of_dvd hdvd hpn_ne
        have hdeg1 : (p ^ (n + 1)).natDegree = n + 1 := by
          rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C, mul_one]
        have hdeg2 : (p ^ n).natDegree = n := by
          rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C, mul_one]
        omega

      have hMS_ne_top : M_S ≠ ⊤ := Ideal.IsPrime.ne_top inferInstance
      have hKrull : (⨅ i : ℕ, M_S ^ i) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing M_S hMS_ne_top
      have hUnitPow : ∀ x : S_loc, x ≠ 0 → ∃ (a : ℕ) (u : S_loc), IsUnit u ∧ x = u * t_S ^ a := by
        intro x hx
        have hx_ex : ∃ i : ℕ, x ∉ M_S ^ i := by
          by_contra h_all
          have hx_in_bot : x ∈ (⨅ i : ℕ, M_S ^ i) :=
            Ideal.mem_iInf.mpr (fun i => of_not_not (fun hni => h_all ⟨i, hni⟩))
          rw [hKrull, Ideal.mem_bot] at hx_in_bot
          exact hx hx_in_bot
        let k_min := Nat.find hx_ex
        have hk_spec : x ∉ M_S ^ k_min := Nat.find_spec hx_ex
        have hk_pos : 0 < k_min := by
          by_contra hk0
          have hk_eq0 : k_min = 0 := by omega
          rw [hk_eq0, pow_zero, Ideal.one_eq_top] at hk_spec
          exact hk_spec Submodule.mem_top
        let a := k_min - 1
        have ha_succ : a + 1 = k_min := by omega
        have hx_in : x ∈ M_S ^ a := by
          by_contra h_not
          have hle := Nat.find_min' hx_ex h_not
          omega
        rw [hMS_eq, Ideal.span_singleton_pow] at hx_in hk_spec
        obtain ⟨u, hu_eq⟩ := Ideal.mem_span_singleton'.mp hx_in
        have hu_notMem : u ∉ M_S := by
          intro hu_in
          rw [hMS_eq] at hu_in
          obtain ⟨u', hu'_eq⟩ := Ideal.mem_span_singleton'.mp hu_in
          apply hk_spec
          rw [Ideal.mem_span_singleton']
          refine ⟨u', ?_⟩
          calc
            u' * t_S ^ k_min = u' * t_S ^ (a + 1) := by rw [ha_succ]
            _ = (u' * t_S) * t_S ^ a := by rw [pow_succ']; ring
            _ = u * t_S ^ a := by rw [hu'_eq]
            _ = x := hu_eq
        exact ⟨a, u, IsLocalRing.notMem_maximalIdeal.mp hu_notMem, hu_eq.symm⟩
      refine @NoZeroDivisors.to_isDomain S_loc _ _ ⟨fun {x y} hxy => ?_⟩
      by_contra h_both
      have hx : x ≠ 0 := fun hx0 => h_both (Or.inl hx0)
      have hy : y ≠ 0 := fun hy0 => h_both (Or.inr hy0)
      obtain ⟨a, u, hu, rfl⟩ := hUnitPow x hx
      obtain ⟨b, v, hv, rfl⟩ := hUnitPow y hy
      have hmul : (u * v) * t_S ^ (a + b) = 0 := by
        calc
          (u * v) * t_S ^ (a + b) = (u * t_S ^ a) * (v * t_S ^ b) := by
            rw [pow_add]
            ring
          _ = 0 := hxy
      exact ht_pow_ne (a + b) ((hu.mul hv).mul_right_eq_zero.mp hmul)

    have hAwayDomain : ∀ (m₀ : Ideal B) [m₀.IsMaximal],
        ∃ f : B, f ∉ m₀ ∧ IsDomain (Localization.Away f) := by
      intro m₀ hm₀
      have _ : IsDomain (Localization.AtPrime m₀) := hAtPrimeDomain m₀
      let K_ker : Ideal B := RingHom.ker (algebraMap B (Localization.AtPrime m₀))
      obtain ⟨G, hG_span⟩ := (IsNoetherian.noetherian K_ker)
      have hex_kill : ∀ g : ↥G, ∃ s : m₀.primeCompl, (s : B) * g.1 = 0 := by
        intro g
        have hg_ker : g.1 ∈ K_ker := by
          rw [← hG_span]
          exact Ideal.subset_span g.2
        rw [RingHom.mem_ker] at hg_ker
        exact (IsLocalization.map_eq_zero_iff m₀.primeCompl
          (Localization.AtPrime m₀) g.1).mp hg_ker
      choose s_fn hs_fn using hex_kill
      let s_prod : m₀.primeCompl := ∏ g : ↥G, s_fn g
      let f : B := s_prod.1
      have hf_notMem : f ∉ m₀ := s_prod.2
      have hf_kill_gen : ∀ g ∈ (G : Set B), f * g = 0 := by
        intro g hg
        let g_sub : ↥G := ⟨g, hg⟩
        have hdvd : s_fn g_sub ∣ s_prod := Finset.dvd_prod_of_mem s_fn (Finset.mem_univ g_sub)
        obtain ⟨q_s, hq_s⟩ := hdvd
        have hf_eq : f = q_s.1 * (s_fn g_sub : B) := by
          change s_prod.1 = _
          rw [hq_s, Submonoid.coe_mul, mul_comm]
        rw [hf_eq, mul_assoc]
        exact (congrArg (q_s.1 * ·) (hs_fn g_sub)).trans (mul_zero _)
      have hf_kill : ∀ x ∈ K_ker, f * x = 0 := by
        intro x hx
        rw [← hG_span] at hx
        refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
        · intro g hg
          exact hf_kill_gen g hg
        · exact mul_zero f
        · intro x₁ x₂ _ _ hx₁ hx₂
          rw [mul_add, hx₁, hx₂, add_zero]
        · intro r₀ x₀ _ hx₀
          rw [smul_eq_mul, ← mul_assoc, mul_comm f r₀, mul_assoc, hx₀, mul_zero]
      have hf_unit : IsUnit (algebraMap B (Localization.AtPrime m₀) f) :=
        IsLocalization.map_units (Localization.AtPrime m₀) s_prod
      let ι_loc : Localization.Away f →+* Localization.AtPrime m₀ :=
        IsLocalization.Away.lift f hf_unit
      have hι_inj : Function.Injective ι_loc := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        have hsec := IsLocalization.Away.sec_spec f z
        let k_z := (IsLocalization.Away.sec f z).2
        let b_z := (IsLocalization.Away.sec f z).1
        have h_b_ker : b_z ∈ K_ker := by
          rw [RingHom.mem_ker, ← IsLocalization.Away.lift_eq (S := Localization.Away f) f hf_unit b_z]
          change ι_loc (algebraMap B (Localization.Away f) b_z) = 0
          rw [← hsec, map_mul, hz, zero_mul]
        have hfb0 : f * b_z = 0 := hf_kill b_z h_b_ker
        have hb_loc0 : algebraMap B (Localization.Away f) b_z = 0 := by
          have h1 : algebraMap B (Localization.Away f) f *
              algebraMap B (Localization.Away f) b_z = 0 := by
            rw [← map_mul, hfb0, map_zero]
          exact (IsLocalization.Away.algebraMap_isUnit f).mul_right_eq_zero.mp h1
        have h_fk_unit : IsUnit (algebraMap B (Localization.Away f) (f ^ k_z)) := by
          rw [map_pow]
          exact (IsLocalization.Away.algebraMap_isUnit f).pow k_z
        rw [hb_loc0, mul_comm] at hsec
        exact h_fk_unit.mul_right_eq_zero.mp hsec
      exact ⟨f, hf_notMem, Function.Injective.isDomain ι_loc hι_inj⟩

    have _ : IsReduced B := by
      refine ⟨fun b ⟨n, hbn⟩ => ?_⟩
      let ann_b : Ideal B :=
        { carrier := { r₀ : B | r₀ * b = 0 }
          add_mem' := fun {r₁ r₂} h₁ h₂ => by dsimp at *; rw [add_mul, h₁, h₂, add_zero]
          zero_mem' := by dsimp; exact zero_mul b
          smul_mem' := fun c {r₀} hr => by dsimp at *; rw [mul_assoc, hr, mul_zero] }
      have hann_top : ann_b = ⊤ := by
        by_contra h_ne_top
        obtain ⟨m₀, hm₀_max, hm₀_le⟩ := Ideal.exists_le_maximal ann_b h_ne_top
        let _ : m₀.IsMaximal := hm₀_max
        have _ : IsDomain (Localization.AtPrime m₀) := hAtPrimeDomain m₀
        have hb_loc_pow : (algebraMap B (Localization.AtPrime m₀) b) ^ n = 0 := by
          rw [← map_pow, hbn, map_zero]
        have hb_loc0 : algebraMap B (Localization.AtPrime m₀) b = 0 :=
          eq_zero_of_pow_eq_zero hb_loc_pow
        obtain ⟨s, hs⟩ :=
          (IsLocalization.map_eq_zero_iff m₀.primeCompl (Localization.AtPrime m₀) b).mp hb_loc0
        exact s.2 (hm₀_le hs)
      have h1_in : (1 : B) ∈ ann_b := by rw [hann_top]; trivial
      simpa [ann_b] using h1_in

    let X := PrimeSpectrum B
    have hIrrBasic : ∀ p : X, ∃ f : B, p ∈ PrimeSpectrum.basicOpen f ∧
        IsIrreducible (PrimeSpectrum.basicOpen f : Set X) := by
      intro p
      obtain ⟨m₀, hm₀_max, hm₀_le⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
      let _ : m₀.IsMaximal := hm₀_max
      obtain ⟨f, hf_not_m₀, hDom_f⟩ := hAwayDomain m₀
      have _ : IsDomain (Localization.Away f) := hDom_f
      have hp_in : p ∈ PrimeSpectrum.basicOpen f := by
        change f ∉ p.asIdeal
        exact fun h_in => hf_not_m₀ (hm₀_le h_in)
      have hRange := PrimeSpectrum.localization_away_comap_range (Localization.Away f) f
      have hIrrSpec : IrreducibleSpace (PrimeSpectrum (Localization.Away f)) := by
        change IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away f)))
        exact AlgebraicGeometry.irreducibleSpace_of_isIntegral _
      have hIrrUniv : IsIrreducible (Set.univ : Set (PrimeSpectrum (Localization.Away f))) :=
        IrreducibleSpace.isIrreducible_univ _
      have hCont : Continuous (PrimeSpectrum.comap (algebraMap B (Localization.Away f))) :=
        (PrimeSpectrum.localization_away_isOpenEmbedding (Localization.Away f) f).continuous
      have hIrrImg :
          IsIrreducible (Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away f)))) := by
        rw [← Set.image_univ]
        exact hIrrUniv.image _ hCont.continuousOn
      rw [hRange] at hIrrImg
      exact ⟨f, hp_in, hIrrImg⟩

    have hCompEqClosure : ∀ (E : Set X), E ∈ irreducibleComponents X →
        ∀ (x : X), x ∈ E → ∀ (U_x : Set X), IsOpen U_x → x ∈ U_x → IsIrreducible U_x →
        closure U_x = E := by
      intro E hE x hxE U_x hOpenU hxU hIrrU
      have hSub : E ⊆ closure U_x ∪ U_xᶜ := by
        intro y _
        by_cases hy : y ∈ U_x
        · exact Or.inl (subset_closure hy)
        · exact Or.inr hy
      have hOr := (isPreirreducible_iff_isClosed_union_isClosed.mp hE.1.isPreirreducible)
        (closure U_x) (U_xᶜ) isClosed_closure hOpenU.isClosed_compl hSub
      have hE_le : E ⊆ closure U_x := by
        rcases hOr with h1 | h2
        · exact h1
        · exfalso
          exact (h2 hxE) hxU
      have hCl_le : closure U_x ⊆ E := hE.2 hIrrU.closure hE_le
      exact Set.Subset.antisymm hCl_le hE_le

    have hFinComp : (irreducibleComponents X).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    let F_comp : Finset (Set X) := hFinComp.toFinset
    let s : ℕ := Fintype.card ↥F_comp
    let e_idx : Fin s ≃ ↥F_comp := (Fintype.equivFin ↥F_comp).symm
    let E_a : Fin s → Set X := fun a => (e_idx a).1
    have hEa_mem : ∀ a : Fin s, E_a a ∈ irreducibleComponents X :=
      fun a => hFinComp.mem_toFinset.mp (e_idx a).2

    have hEa_clopen : ∀ a : Fin s, IsClopen (E_a a) := by
      intro a
      refine ⟨isClosed_of_mem_irreducibleComponents (E_a a) (hEa_mem a), ?_⟩
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      obtain ⟨f, hx_f, hIrr_f⟩ := hIrrBasic x
      have hCl := hCompEqClosure (E_a a) (hEa_mem a) x hx (PrimeSpectrum.basicOpen f)
        (PrimeSpectrum.basicOpen f).isOpen hx_f hIrr_f
      exact ⟨PrimeSpectrum.basicOpen f, subset_closure.trans hCl.le,
        (PrimeSpectrum.basicOpen f).isOpen, hx_f⟩

    have hEa_disj : ∀ a b : Fin s, a ≠ b → Disjoint (E_a a) (E_a b) := by
      intro a b hab
      rw [Set.disjoint_left]
      intro x hxa hxb
      obtain ⟨f, hx_f, hIrr_f⟩ := hIrrBasic x
      have h1 := hCompEqClosure (E_a a) (hEa_mem a) x hxa (PrimeSpectrum.basicOpen f)
        (PrimeSpectrum.basicOpen f).isOpen hx_f hIrr_f
      have h2 := hCompEqClosure (E_a b) (hEa_mem b) x hxb (PrimeSpectrum.basicOpen f)
        (PrimeSpectrum.basicOpen f).isOpen hx_f hIrr_f
      apply hab
      apply e_idx.injective
      apply Subtype.ext
      exact h1.symm.trans h2

    have hex_idemp : ∀ a : Fin s, ∃ e₀ : B, E_a a = (PrimeSpectrum.basicOpen e₀ : Set X) := by
      intro a
      obtain ⟨e₀, _, he_eq⟩ := PrimeSpectrum.isClopen_iff.mp (hEa_clopen a)
      exact ⟨e₀, he_eq⟩
    choose e_fn he_fn using hex_idemp

    let C : Fin s → AlgebraicGeometry.Scheme.{u} :=
      fun a => AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (e_fn a)))
    let ι_spec : ∀ a : Fin s, Quiver.Hom (C a) (AlgebraicGeometry.Spec B_cat) :=
      fun a => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap B (Localization.Away (e_fn a))))
    let ι : ∀ a : Fin s, Quiver.Hom (C a) W :=
      fun a => ι_spec a ≫ e_W.inv

    have hRange_spec : ∀ a : Fin s, Set.range (ι_spec a).base = E_a a := by
      intro a
      change Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away (e_fn a)))) = E_a a
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away (e_fn a)) (e_fn a),
        ← he_fn a]

    refine ⟨s, C, ι, ?_, ?_, ?_, ?_, ?_⟩
    · intro a
      dsimp [C]
      infer_instance
    · intro a
      rw [AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced]
      have _ : IsReduced (Localization.Away (e_fn a)) := by
        refine ⟨fun z ⟨n, hzn⟩ => ?_⟩
        have hsec := IsLocalization.Away.sec_spec (e_fn a) z
        let k_z := (IsLocalization.Away.sec (e_fn a) z).2
        let b_z := (IsLocalization.Away.sec (e_fn a) z).1
        have hb_pow0 : algebraMap B (Localization.Away (e_fn a)) (b_z ^ n) = 0 := by
          rw [map_pow, ← hsec, mul_pow, hzn, zero_mul]
        obtain ⟨⟨_, m_exp, rfl⟩, hm_eq⟩ :=
          (IsLocalization.map_eq_zero_iff (Submonoid.powers (e_fn a))
            (Localization.Away (e_fn a)) (b_z ^ n)).mp hb_pow0
        have hm_eq' : e_fn a ^ m_exp * b_z ^ n = 0 := hm_eq
        have heb_pow : (e_fn a * b_z) ^ (m_exp + n) = 0 := by
          calc
            (e_fn a * b_z) ^ (m_exp + n)
              = (e_fn a ^ n * b_z ^ m_exp) * (e_fn a ^ m_exp * b_z ^ n) := by
                rw [mul_pow, pow_add, pow_add]
                ring
            _ = 0 := by rw [hm_eq', mul_zero]
        have heb0 : e_fn a * b_z = 0 := eq_zero_of_pow_eq_zero heb_pow
        have hb_loc0 : algebraMap B (Localization.Away (e_fn a)) b_z = 0 := by
          have h1 : algebraMap B (Localization.Away (e_fn a)) (e_fn a) *
              algebraMap B (Localization.Away (e_fn a)) b_z = 0 := by
            rw [← map_mul, heb0, map_zero]
          exact (IsLocalization.Away.algebraMap_isUnit (e_fn a)).mul_right_eq_zero.mp h1
        have h_ek_unit : IsUnit (algebraMap B (Localization.Away (e_fn a)) (e_fn a ^ k_z)) := by
          rw [map_pow]
          exact (IsLocalization.Away.algebraMap_isUnit (e_fn a)).pow k_z
        rw [hb_loc0, mul_comm] at hsec
        exact h_ek_unit.mul_right_eq_zero.mp hsec
      have hIrr_Ca : IrreducibleSpace ↥(C a) := by
        change IrreducibleSpace (PrimeSpectrum (Localization.Away (e_fn a)))
        let R_set := Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away (e_fn a))))
        let hHomeo : PrimeSpectrum (Localization.Away (e_fn a)) ≃ₜ ↥R_set :=
          (PrimeSpectrum.localization_away_isOpenEmbedding
            (Localization.Away (e_fn a)) (e_fn a)).isEmbedding.toHomeomorph
        have hIrr_Ea : IrreducibleSpace ↥R_set := by
          have hEqRange : R_set = E_a a := hRange_spec a
          rw [hEqRange]
          exact isIrreducible_iff_irreducibleSpace.mp (hEa_mem a).1
        have hIrrUniv_R : IsIrreducible (Set.univ : Set ↥R_set) :=
          IrreducibleSpace.isIrreducible_univ _
        have hIrrUniv_C :
            IsIrreducible (Set.univ : Set (PrimeSpectrum (Localization.Away (e_fn a)))) := by
          have h_img : hHomeo.symm '' (Set.univ : Set ↥R_set) = Set.univ :=
            Set.image_univ.trans hHomeo.symm.surjective.range_eq
          rw [← h_img]
          exact hIrrUniv_R.image _ hHomeo.symm.continuous.continuousOn
        obtain ⟨pt₀, _⟩ := hIrrUniv_C.nonempty
        exact { isPreirreducible_univ := hIrrUniv_C.isPreirreducible
                toNonempty := ⟨pt₀⟩ }
      exact ⟨hIrr_Ca, by dsimp [C]; infer_instance⟩
    · intro a
      dsimp [ι, ι_spec, C]
      have _ : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap B (Localization.Away (e_fn a))))) :=
        AlgebraicGeometry.IsOpenImmersion.of_isLocalization (e_fn a)
      infer_instance
    · intro a b hab
      have hRange_ι : ∀ c : Fin s, Set.range (ι c).base = e_W.inv.base '' (E_a c) := by
        intro c
        change Set.range (e_W.inv.base ∘ (ι_spec c).base) = _
        rw [Set.range_comp, hRange_spec c]
      rw [hRange_ι a, hRange_ι b]
      have hInj_inv : Function.Injective e_W.inv.base := by
        intro x₁ x₂ hx
        have h1 : (e_W.inv ≫ e_W.hom).base x₁ = (e_W.inv ≫ e_W.hom).base x₂ :=
          congrArg e_W.hom.base hx
        rwa [e_W.inv_hom_id] at h1
      exact Set.disjoint_image_of_injective hInj_inv (hEa_disj a b hab)
    · ext w
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      let x : X := e_W.hom.base w
      have hx_mem_comp : irreducibleComponent x ∈ F_comp :=
        hFinComp.mem_toFinset.mpr (irreducibleComponent_mem_irreducibleComponents x)
      let a : Fin s := e_idx.symm ⟨irreducibleComponent x, hx_mem_comp⟩
      have hEa_eq : E_a a = irreducibleComponent x := by
        dsimp [E_a, a]
        rw [Equiv.apply_symm_apply]
      have hx_in_Ea : x ∈ E_a a := by
        rw [hEa_eq]
        exact mem_irreducibleComponent
      rw [← hRange_spec a] at hx_in_Ea
      obtain ⟨y, hy⟩ := hx_in_Ea
      refine ⟨a, y, ?_⟩
      change e_W.inv.base ((ι_spec a).base y) = w
      rw [hy]
      change (e_W.hom ≫ e_W.inv).base w = w
      rw [e_W.hom_inv_id]
      rfl

  
  have hLocalTorsionPkg :
      let S := P1_over.left
      let n := ℓ ^ r
      let q := 2
      (∀ (U : S.Etale) (z : weilEtaleLocalTorsionH S n U q),
        weilEtaleLocalTorsionMapH S n (CategoryTheory.CategoryStruct.id U) q z = z) ∧
      (∀ {V₁ V₂ V₃ : S.Etale} (v₁ : Quiver.Hom V₁ V₂) (v₂ : Quiver.Hom V₂ V₃)
        (z : weilEtaleLocalTorsionH S n V₁ q),
        weilEtaleLocalTorsionMapH S n (CategoryTheory.CategoryStruct.comp v₁ v₂) q z =
          weilEtaleLocalTorsionMapH S n v₂ q (weilEtaleLocalTorsionMapH S n v₁ q z)) ∧
      (∀ {U' U : S.Etale} (w : Quiver.Hom U' U)
        (z' : weilEtaleLocalTorsionH S n U' q),
        weilEtaleLocalTorsionCounitH S n U q
            (weilEtaleLocalTorsionMapH S n w q z') =
          weilEtaleLocalTorsionCounitH S n U' q z') ∧
      (∀ (U : S.Etale) (s : ℕ) (U_a : Fin s → S.Etale)
        (w : ∀ a : Fin s, Quiver.Hom (U_a a) U),
        (∀ a : Fin s, AlgebraicGeometry.IsOpenImmersion
          (((AlgebraicGeometry.Scheme.Etale.forget S).map (w a)).left)) →
        (∀ a b : Fin s, a ≠ b →
          Disjoint
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (w a)).left).base)
            (Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (w b)).left).base)) →
        (⋃ a : Fin s,
          Set.range (((AlgebraicGeometry.Scheme.Etale.forget S).map (w a)).left).base) =
          Set.univ →
        ∀ (z : weilEtaleLocalTorsionH S n U q),
          ∃ (z_a : ∀ a : Fin s, weilEtaleLocalTorsionH S n (U_a a) q),
            z = ∑ a : Fin s, weilEtaleLocalTorsionMapH S n (w a) q (z_a a)) := by
    dsimp only
    let S := P1_over.left
    let n := ℓ ^ r
    let q := 2
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hEquiv_comp :
        ∀ {W_et : S.Etale}
          {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
          (α : CategoryTheory.Sheaf.freeYoneda S.smallEtaleTopology W_et AM ⟶ F)
          (g : F ⟶ G),
          CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
      intro W_et F G α g
      let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
          (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
      calc
        CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
          = CategoryTheory.Presheaf.freeYonedaHomEquiv
              (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
                AddCommGrpCat.{u}).homEquiv _ F) α' ≫
                (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map g) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
              CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

    have hLocMap_id : ∀ (U : S.Etale),
        weilEtaleLocalTorsionMap S n (𝟙 U) = 𝟙 (weilEtaleLocalTorsionSheaf S n U) := by
      intro U
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S n (𝟙 U)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n U)) ≫
            (weilEtaleLocalTorsionSheaf S n U).obj.map (𝟙 (Opposite.op U)) :=
        Equiv.apply_symm_apply _ _
      rw [h1, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]

    have hLocMap_comp : ∀ {V₁ V₂ V₃ : S.Etale} (v₁ : V₁ ⟶ V₂) (v₂ : V₂ ⟶ V₃),
        weilEtaleLocalTorsionMap S n (v₁ ≫ v₂) =
          weilEtaleLocalTorsionMap S n v₁ ≫ weilEtaleLocalTorsionMap S n v₂ := by
      intro V₁ V₂ V₃ v₁ v₂
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S n (v₁ ≫ v₂))
          = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n V₃)) ≫
              (weilEtaleLocalTorsionSheaf S n V₃).obj.map (Opposite.op (v₁ ≫ v₂)) :=
              Equiv.apply_symm_apply _ _
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n V₃)) ≫
              (weilEtaleLocalTorsionSheaf S n V₃).obj.map (Opposite.op v₂)) ≫
              (weilEtaleLocalTorsionSheaf S n V₃).obj.map (Opposite.op v₁) := by
              have hop : Opposite.op (v₁ ≫ v₂) =
                  (Opposite.op v₂ ≫ Opposite.op v₁ : Opposite.op V₃ ⟶ Opposite.op V₁) := rfl
              rw [hop, CategoryTheory.Functor.map_comp, CategoryTheory.Category.assoc]
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n V₂)) ≫
              (weilEtaleLocalTorsionMap S n v₂).hom.app (Opposite.op V₂)) ≫
              (weilEtaleLocalTorsionSheaf S n V₃).obj.map (Opposite.op v₁) := by
              have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf S n V₂)) ≫
                  (weilEtaleLocalTorsionMap S n v₂).hom.app (Opposite.op V₂) =
                  CategoryTheory.Sheaf.freeYonedaHomEquiv
                    (𝟙 (weilEtaleLocalTorsionSheaf S n V₃)) ≫
                  (weilEtaleLocalTorsionSheaf S n V₃).obj.map (Opposite.op v₂) := by
                rw [← hEquiv_comp (𝟙 _) (weilEtaleLocalTorsionMap S n v₂),
                  CategoryTheory.Category.id_comp]
                exact Equiv.apply_symm_apply _ _
              rw [h2]
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n V₂)) ≫
              (weilEtaleLocalTorsionSheaf S n V₂).obj.map (Opposite.op v₁)) ≫
              (weilEtaleLocalTorsionMap S n v₂).hom.app (Opposite.op V₁) := by
              rw [CategoryTheory.Category.assoc,
                ← (weilEtaleLocalTorsionMap S n v₂).hom.naturality (Opposite.op v₁),
                CategoryTheory.Category.assoc]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S n v₁) ≫
              (weilEtaleLocalTorsionMap S n v₂).hom.app (Opposite.op V₁) := by
              have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S n v₁) =
                  CategoryTheory.Sheaf.freeYonedaHomEquiv
                    (𝟙 (weilEtaleLocalTorsionSheaf S n V₂)) ≫
                  (weilEtaleLocalTorsionSheaf S n V₂).obj.map (Opposite.op v₁) :=
                Equiv.apply_symm_apply _ _
              rw [h1]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
              (weilEtaleLocalTorsionMap S n v₁ ≫ weilEtaleLocalTorsionMap S n v₂) :=
              (hEquiv_comp _ _).symm

    have hCounit_comp : ∀ {U' U : S.Etale} (w : U' ⟶ U),
        weilEtaleLocalTorsionMap S n w ≫ weilEtaleLocalTorsionCounit S n U =
          weilEtaleLocalTorsionCounit S n U' := by
      intro U' U w
      let P_const := (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM
      let η_const : P_const ⟶ (weilEtaleTorsionSheaf S n).obj :=
        (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          P_const
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h_map_w : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S n w) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n U)) ≫
            (weilEtaleLocalTorsionSheaf S n U).obj.map (Opposite.op w) :=
        Equiv.apply_symm_apply _ _
      have h_counit_U :
          CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S n U) =
            η_const.app (Opposite.op U) :=
        Equiv.apply_symm_apply _ _
      have h_counit_U' :
          CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S n U') =
            η_const.app (Opposite.op U') :=
        Equiv.apply_symm_apply _ _
      have hnat : η_const.app (Opposite.op U) ≫ (weilEtaleTorsionSheaf S n).obj.map (Opposite.op w) =
          η_const.app (Opposite.op U') := by
        have h1 := η_const.naturality (Opposite.op w)
        change P_const.map (Opposite.op w) ≫ η_const.app (Opposite.op U') =
          η_const.app (Opposite.op U) ≫ (weilEtaleTorsionSheaf S n).obj.map (Opposite.op w) at h1
        rw [← h1]
        exact CategoryTheory.Category.id_comp _
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap S n w ≫ weilEtaleLocalTorsionCounit S n U)
          = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n U)) ≫
              (weilEtaleLocalTorsionSheaf S n U).obj.map (Opposite.op w)) ≫
              (weilEtaleLocalTorsionCounit S n U).hom.app (Opposite.op U') := by
              rw [hEquiv_comp, h_map_w]
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (weilEtaleLocalTorsionSheaf S n U)) ≫
              (weilEtaleLocalTorsionCounit S n U).hom.app (Opposite.op U)) ≫
              (weilEtaleTorsionSheaf S n).obj.map (Opposite.op w) := by
              have h_nat_w :
                  (weilEtaleLocalTorsionSheaf S n U).obj.map (Opposite.op w) ≫
                    (weilEtaleLocalTorsionCounit S n U).hom.app (Opposite.op U') =
                  (weilEtaleLocalTorsionCounit S n U).hom.app (Opposite.op U) ≫
                    (weilEtaleTorsionSheaf S n).obj.map (Opposite.op w) :=
                (weilEtaleLocalTorsionCounit S n U).hom.naturality (Opposite.op w)
              rw [CategoryTheory.Category.assoc, h_nat_w, ← CategoryTheory.Category.assoc]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S n U) ≫
              (weilEtaleTorsionSheaf S n).obj.map (Opposite.op w) := by
              rw [← hEquiv_comp (𝟙 _) _, CategoryTheory.Category.id_comp]
        _ = η_const.app (Opposite.op U) ≫ (weilEtaleTorsionSheaf S n).obj.map (Opposite.op w) := by
              rw [h_counit_U]
        _ = η_const.app (Opposite.op U') := hnat
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S n U') :=
              h_counit_U'.symm

    refine ⟨?_, ?_, ?_, ?_⟩
    · intro U z
      change z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S n (𝟙 U)))
        (Nat.add_zero q) = z
      rw [hLocMap_id]
      exact CategoryTheory.Abelian.Ext.comp_mk₀_id z
    · intro V₁ V₂ V₃ v₁ v₂ z
      change z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S n (v₁ ≫ v₂)))
          (Nat.add_zero q) =
        (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S n v₁))
          (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S n v₂)) (Nat.add_zero q)
