  let R_fun : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Functor Z.Etale (CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun Z =>
      CategoryTheory.yoneda ⋙
        ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u) AddCommGrpCat.{u}).obj
          AddCommGrpCat.free ⋙
          CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u})

  have hYonedaComp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale)
      {A B : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (α : weilPolyP1CohomologyRepSheaf Z W ⟶ A) (g : A ⟶ B),
      weilPolyP1CohomologyRepHomEquiv Z W B (α ≫ g) =
        (g.hom.app (Opposite.op W)).hom (weilPolyP1CohomologyRepHomEquiv Z W A α) := by
    intro Z W A B α g
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    have h1 := adj_sh.homEquiv_naturality_right α g
    have h2 := adj_fr.homEquiv_naturality_right
      ((adj_sh.homEquiv (CategoryTheory.yoneda.obj W ⋙ AddCommGrpCat.free) A) α) g.hom
    exact (congrArg CategoryTheory.yonedaEquiv
      ((congrArg (adj_fr.homEquiv (CategoryTheory.yoneda.obj W) B.obj) h1).trans h2))

  have hYonedaPrecomp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W₁ W₂ : Z.Etale} (u : W₁ ⟶ W₂)
      {G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
      (g : weilPolyP1CohomologyRepSheaf Z W₂ ⟶ G),
      weilPolyP1CohomologyRepHomEquiv Z W₁ G ((R_fun Z).map u ≫ g) =
        (G.obj.map (Opposite.op u)).hom (weilPolyP1CohomologyRepHomEquiv Z W₂ G g) := by
    intro Z W₁ W₂ u G g
    let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
    let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
    let w_u := ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u)
      AddCommGrpCat.{u}).obj AddCommGrpCat.free).map (CategoryTheory.yoneda.map u)
    have h1 : (adj_sh.homEquiv _ G) ((CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).map w_u ≫ g) =
        w_u ≫ (adj_sh.homEquiv _ G) g :=
      adj_sh.homEquiv_naturality_left w_u g
    have h2 : (adj_fr.homEquiv _ G.obj) (w_u ≫ (adj_sh.homEquiv _ G) g) =
        CategoryTheory.yoneda.map u ≫ (adj_fr.homEquiv _ G.obj) ((adj_sh.homEquiv _ G) g) :=
      adj_fr.homEquiv_naturality_left (CategoryTheory.yoneda.map u) ((adj_sh.homEquiv _ G) g)
    let γ := (adj_fr.homEquiv (CategoryTheory.yoneda.obj W₂) G.obj) ((adj_sh.homEquiv _ G) g)
    have h12 : CategoryTheory.yonedaEquiv
        ((adj_fr.homEquiv (CategoryTheory.yoneda.obj W₁) G.obj)
          ((adj_sh.homEquiv _ G) ((R_fun Z).map u ≫ g))) =
        CategoryTheory.yonedaEquiv (CategoryTheory.yoneda.map u ≫ γ) :=
      congrArg CategoryTheory.yonedaEquiv
        ((congrArg (adj_fr.homEquiv (CategoryTheory.yoneda.obj W₁) G.obj) h1).trans h2)
    have hnat := congrArg
      (a₁ := (CategoryTheory.yoneda.obj W₂).map (Opposite.op u) ≫ γ.app (Opposite.op W₁))
      (fun m => m (𝟙 W₂)) (γ.naturality (Opposite.op u))
    dsimp at hnat
    have hu_id : 𝟙 W₁ ≫ u = u ≫ 𝟙 W₂ :=
      (CategoryTheory.Category.id_comp u).trans (CategoryTheory.Category.comp_id u).symm
    exact h12.trans ((congrArg (γ.app (Opposite.op W₁)) hu_id).trans hnat)

