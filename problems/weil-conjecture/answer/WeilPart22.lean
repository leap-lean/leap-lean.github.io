        (pb' : 𝒜 ⥤ 𝒜') [pb'.Additive]
        [CategoryTheory.Limits.PreservesFiniteLimits pb']
        [CategoryTheory.Limits.PreservesFiniteColimits pb']
        (R : ℕ → 𝒜 → ℬ)
        (R_map : ∀ (b : ℕ) {F₁ F₂ : 𝒜}, (F₁ ⟶ F₂) → (R b F₁ ⟶ R b F₂))
        (R' : ℕ → 𝒜' → ℬ')
        (R'_map : ∀ (b : ℕ) {G₁ G₂ : 𝒜'}, (G₁ ⟶ G₂) → (R' b G₁ ⟶ R' b G₂))
        (δ : ∀ {SC : CategoryTheory.ShortComplex 𝒜},
          SC.ShortExact → ∀ (b : ℕ), R b SC.X₃ ⟶ R (b + 1) SC.X₁)
        (δ' : ∀ {SC' : CategoryTheory.ShortComplex 𝒜'},
          SC'.ShortExact → ∀ (b : ℕ), R' b SC'.X₃ ⟶ R' (b + 1) SC'.X₁)
        (bc_fam : ∀ (b : ℕ) (F : 𝒜), pb.obj (R b F) ⟶ R' b (pb'.obj F))
        (P_cls : 𝒜 → Prop),
        (∀ {SC : CategoryTheory.ShortComplex 𝒜} (hSE : SC.ShortExact) (b : ℕ),
          ∃ (hz₃ : R_map b SC.g ≫ δ hSE b = 0)
            (hz₁ : δ hSE b ≫ R_map (b + 1) SC.f = 0),
            (CategoryTheory.ShortComplex.mk (R_map b SC.g) (δ hSE b) hz₃).Exact ∧
            (CategoryTheory.ShortComplex.mk (δ hSE b) (R_map (b + 1) SC.f) hz₁).Exact) →
        (∀ {SC' : CategoryTheory.ShortComplex 𝒜'} (hSE' : SC'.ShortExact) (b : ℕ),
          ∃ (hz₃' : R'_map b SC'.g ≫ δ' hSE' b = 0)
            (hz₁' : δ' hSE' b ≫ R'_map (b + 1) SC'.f = 0),
            (CategoryTheory.ShortComplex.mk (R'_map b SC'.g) (δ' hSE' b) hz₃').Exact ∧
            (CategoryTheory.ShortComplex.mk (δ' hSE' b) (R'_map (b + 1) SC'.f) hz₁').Exact) →
        (∀ (b : ℕ) {F₁ F₂ : 𝒜} (φ : F₁ ⟶ F₂),
          pb.map (R_map b φ) ≫ bc_fam b F₂ = bc_fam b F₁ ≫ R'_map b (pb'.map φ)) →
        (∀ {SC : CategoryTheory.ShortComplex 𝒜} (hSE : SC.ShortExact) (b : ℕ),
          pb.map (δ hSE b) ≫ bc_fam (b + 1) SC.X₁ =
            bc_fam b SC.X₃ ≫ δ' (hSE.map_of_exact pb') b) →
        (∀ (F : 𝒜), P_cls F → CategoryTheory.IsIso (bc_fam 0 F)) →
        (∀ (F : 𝒜), P_cls F →
