  obtain ⟨σ_e_σ, V_compl, w_compl, hσ_e_σ, hσ_inv, h_compl_disj, h_lift⟩ :=
    @h_s2 W_bar_σ.left W_bar.left P1_over.left P.left
      g'_W π_leg π_leg_σ ι_σ hProp_leg h_sq
      U_W U_P e_leg σ_e hσ_e e_leg_σ.hom hU_σ_comm he_σ_fst
  obtain ⟨α_π_σ, hMate, hId_trans, hZero_trans⟩ :=
    @h_s3 W_bar_σ.left W_bar.left P1_over.left P.left
