        fun x M => AddCommGrpCat.ofHom
          { toFun := fun s => s x, map_zero' := rfl, map_add' := fun _ _ => rfl }
      have hDescCompat : ∀ {F : CategoryTheory.Sheaf L AddCommGrpCat.{u}} {M : AddCommGrpCat.{u}}
          (β : F ⟶ S_Θ.obj M) ⦃X Y' : E⦄ (k : X ⟶ Y') (x : Θ.fiber.obj X),
          F.obj.map k.op ≫ (β.hom.app (Opposite.op X) ≫ evalAt x M) =
            β.hom.app (Opposite.op Y') ≫ evalAt (Θ.fiber.map k x) M := by
        intro F M β X Y' k x
        ext z
        exact congrArg (fun φ : F.obj.obj (Opposite.op Y') ⟶ ((skyPre Θ.fiber).obj M).obj (Opposite.op X) =>
