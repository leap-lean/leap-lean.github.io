              (fun X₀ Y₀ f₀ x₀ => by
                ext z
                have hnat := Θ.toPresheafFiber_w f₀ x₀ F.obj
                exact congrArg (fun φ : F.obj.obj (Opposite.op Y₀) ⟶ Θ.presheafFiber.obj F.obj =>
                  (φ ≫ α).hom z) hnat) X x
            exact h
          right_inv := fun β => by
            ext X z x
            have h := Θ.toPresheafFiber_presheafFiberDesc
