      hCont_leg hAdj_leg
      (@hc_all _ _ g'_W) (@hr_all _ _ g'_W)
      (@hc_all _ _ ι_σ) (@hr_all _ _ ι_σ)
      (@hc_all _ _ π_leg_σ) (@hr_all _ _ π_leg_σ)
      (@hc_all _ _ (CategoryTheory.CategoryStruct.comp g'_W π_leg))
      (@hr_all _ _ (CategoryTheory.CategoryStruct.comp g'_W π_leg))
      U_W U_P α_π
  refine ⟨hProp_Wσ, hπ_σ_over, hAff_UWσ, hAff_UPσ,
