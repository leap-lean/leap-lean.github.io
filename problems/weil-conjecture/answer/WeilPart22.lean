            map_add' := fun a b => add_zsmul s a.down b.down }
      have hz_zero : z_hom = 0 := by
        refine (F.property).hom_ext ⟨S_cov, hS_mem⟩ z_hom 0 (fun I => ?_)
        rw [CategoryTheory.Limits.zero_comp]
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro n
        change F.obj.map I.f.op (n.down • s) = 0
        rw [map_zsmul, h_van I.f I.hf, zsmul_zero]
      have hz1 := congrArg (fun f => f (ULift.up (1 : ℤ))) hz_zero
