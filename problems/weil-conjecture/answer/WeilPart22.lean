          exact hPairDisj β₀ hβ₀_mem β hβ_mem h_ne_w t hT_ne ht_eq'
        have hW₀_ex : ∃ (W₀ : S'.Etale) (e_W₀ : CategoryTheory.Iso (M_p.obj W₀) Z'),
