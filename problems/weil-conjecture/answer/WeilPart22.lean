      let SC_l := CategoryTheory.ShortComplex.mk (mapCoeff ι_bock Z W) (mapCoeff π_cast Z W) h0_l
      let e_l : ((SC_A.map P_W).map Sh_Z) ≅ SC_l :=
        CategoryTheory.ShortComplex.isoMk
