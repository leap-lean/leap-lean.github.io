        CategoryTheory.CategoryStruct.comp u (weilPolyP1Over k δ).hom =
          CategoryTheory.CategoryStruct.comp v P1.hom →
        { l : Quiver.Hom Z (weilPolyP1Over k (δ + 1)).left //
          CategoryTheory.CategoryStruct.comp l (p_fst δ) = u ∧
          CategoryTheory.CategoryStruct.comp l (p_snd δ) = v } :=
      fun δ {Z} u v huv =>
        ⟨CategoryTheory.Limits.pullback.lift u v huv,
         by
           dsimp only [p_fst, weilPolyP1Over, CategoryTheory.Over.mk_left]
           exact CategoryTheory.Limits.pullback.lift_fst u v huv,
         by
           dsimp only [p_snd, weilPolyP1Over, CategoryTheory.Over.mk_left]
           exact CategoryTheory.Limits.pullback.lift_snd u v huv⟩

    let rec_proj : ∀ δ : ℕ, Fin δ → Quiver.Hom (weilPolyP1Over k δ).left P1.left :=
      Nat.rec
        (motive := fun δ => Fin δ → Quiver.Hom (weilPolyP1Over k δ).left P1.left)
        (fun i => Fin.elim0 i)
        (fun δ prev =>
          Fin.lastCases
            (p_snd δ)
            (fun i₀ => CategoryTheory.CategoryStruct.comp (p_fst δ) (prev i₀)))
    have h_proj_last : ∀ δ : ℕ, rec_proj (δ + 1) (Fin.last δ) = p_snd δ :=
      fun δ => Fin.lastCases_last
        (motive := fun _ => Quiver.Hom (weilPolyP1Over k (δ + 1)).left P1.left)
    have h_proj_cast : ∀ (δ : ℕ) (i₀ : Fin δ),
        rec_proj (δ + 1) i₀.castSucc =
          CategoryTheory.CategoryStruct.comp (p_fst δ) (rec_proj δ i₀) :=
      fun δ i₀ => Fin.lastCases_castSucc
        (motive := fun _ => Quiver.Hom (weilPolyP1Over k (δ + 1)).left P1.left) i₀
    have hProj_over : ∀ (δ : ℕ) (i : Fin δ),
        CategoryTheory.CategoryStruct.comp (rec_proj δ i) P1.hom = (weilPolyP1Over k δ).hom := by
      intro δ
      induction δ with
      | zero => intro i; exact Fin.elim0 i
      | succ δ ih =>
        intro i
        refine Fin.lastCases ?_ ?_ i
        · rw [h_proj_last, ← hp_cond δ, hp_hom_succ δ]
        · intro i₀
          rw [h_proj_cast, CategoryTheory.Category.assoc, ih i₀, hp_hom_succ δ]
    have polyP1_hom_ext : ∀ (δ : ℕ) {Z : AlgebraicGeometry.Scheme.{u}}
        (f₁ f₂ : Quiver.Hom Z (weilPolyP1Over k δ).left),
        CategoryTheory.CategoryStruct.comp f₁ (weilPolyP1Over k δ).hom =
          CategoryTheory.CategoryStruct.comp f₂ (weilPolyP1Over k δ).hom →
        (∀ i : Fin δ, CategoryTheory.CategoryStruct.comp f₁ (rec_proj δ i) =
          CategoryTheory.CategoryStruct.comp f₂ (rec_proj δ i)) →
        f₁ = f₂ := by
      intro δ
      induction δ with
      | zero =>
        intro Z f₁ f₂ hf _
        rwa [hp_hom_zero f₁, hp_hom_zero f₂] at hf
      | succ δ ih =>
        intro Z f₁ f₂ hf hproj
        apply hp_hom_ext δ
        · apply ih
          · rw [hp_hom_succ δ, ← CategoryTheory.Category.assoc,
              ← CategoryTheory.Category.assoc] at hf
            exact hf
          · intro i₀
            have hi₀ := hproj i₀.castSucc
            rwa [h_proj_cast, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
              at hi₀
        · have hlast := hproj (Fin.last δ)
          rwa [h_proj_last] at hlast
    let polyP1_lift : ∀ (δ : ℕ) {Z : AlgebraicGeometry.Scheme.{u}}
        (s_Z : Quiver.Hom Z S_k)
        (g : Fin δ → Quiver.Hom Z P1.left),
        (∀ i : Fin δ, CategoryTheory.CategoryStruct.comp (g i) P1.hom = s_Z) →
        { l : Quiver.Hom Z (weilPolyP1Over k δ).left //
          CategoryTheory.CategoryStruct.comp l (weilPolyP1Over k δ).hom = s_Z ∧
          ∀ i : Fin δ, CategoryTheory.CategoryStruct.comp l (rec_proj δ i) = g i } :=
      Nat.rec
        (motive := fun δ => ∀ {Z : AlgebraicGeometry.Scheme.{u}}
          (s_Z : Quiver.Hom Z S_k)
          (g : Fin δ → Quiver.Hom Z P1.left),
          (∀ i : Fin δ, CategoryTheory.CategoryStruct.comp (g i) P1.hom = s_Z) →
          { l : Quiver.Hom Z (weilPolyP1Over k δ).left //
            CategoryTheory.CategoryStruct.comp l (weilPolyP1Over k δ).hom = s_Z ∧
            ∀ i : Fin δ, CategoryTheory.CategoryStruct.comp l (rec_proj δ i) = g i })
        (fun s_Z _ _ => ⟨s_Z, CategoryTheory.Category.comp_id s_Z, fun i => Fin.elim0 i⟩)
        (fun δ ih {Z} s_Z g hg =>
          let prev := ih s_Z (fun i₀ => g i₀.castSucc) (fun i₀ => hg i₀.castSucc)
          let step := hp_lift δ prev.1 (g (Fin.last δ)) (prev.2.1.trans (hg (Fin.last δ)).symm)
          ⟨step.1,
           by
             rw [hp_hom_succ δ, ← CategoryTheory.Category.assoc, step.2.1]
             exact prev.2.1,
           fun i => by
             refine Fin.lastCases ?_ ?_ i
             · rw [h_proj_last]
               exact step.2.2
             · intro i₀
               rw [h_proj_cast, ← CategoryTheory.Category.assoc, step.2.1]
               exact prev.2.2 i₀⟩)
    let aff_cast : ∀ δ : ℕ,
        Quiver.Hom (weilAffineSpaceOver k (δ + 1)).left (weilAffineSpaceOver k δ).left :=
      fun δ => AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (MvPolynomial.rename Fin.castSucc :
          MvPolynomial (Fin δ) k →ₐ[k] MvPolynomial (Fin (δ + 1)) k).toRingHom)
    let pr_aff : ∀ δ : ℕ, Fin δ → Quiver.Hom (weilAffineSpaceOver k δ).left
        (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
      fun δ idx => AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        (Polynomial.aeval (MvPolynomial.X idx : MvPolynomial (Fin δ) k)).toRingHom)
    have h_ιaff_proj : ∀ (δ : ℕ) (i : Fin δ),
        CategoryTheory.CategoryStruct.comp (ι_aff δ) (rec_proj δ i) =
          CategoryTheory.CategoryStruct.comp (pr_aff δ i) ι_P1 := by
      intro δ
      induction δ with
      | zero => intro i; exact Fin.elim0 i
      | succ δ ih =>
        have hδ := hCoord.2.2.2.2.2.2.2.2 δ
        have hδ_fst :
            CategoryTheory.CategoryStruct.comp (ι_aff (δ + 1)) (p_fst δ) =
              CategoryTheory.CategoryStruct.comp (aff_cast δ) (ι_aff δ) := hδ.2.2.2.1
        have hδ_snd :
            CategoryTheory.CategoryStruct.comp (ι_aff (δ + 1)) (p_snd δ) =
              CategoryTheory.CategoryStruct.comp (pr_aff (δ + 1) (Fin.last δ)) ι_P1 := hδ.2.2.2.2
        intro i
        refine Fin.lastCases ?_ ?_ i
        · rw [h_proj_last]
          exact hδ_snd
        · intro i₀
          rw [h_proj_cast, ← CategoryTheory.Category.assoc, hδ_fst,
            CategoryTheory.Category.assoc, ih i₀, ← CategoryTheory.Category.assoc]
          congr 1
          dsimp only [aff_cast, pr_aff, weilAffineSpaceOver, CategoryTheory.Over.mk_left]
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          congr 2
          apply Polynomial.ringHom_ext
          · intro c
            change (MvPolynomial.rename Fin.castSucc)
              ((Polynomial.aeval (MvPolynomial.X i₀ : MvPolynomial (Fin δ) k)) (Polynomial.C c)) =
              (Polynomial.aeval (MvPolynomial.X i₀.castSucc : MvPolynomial (Fin (δ + 1)) k))
                (Polynomial.C c)
            rw [Polynomial.aeval_C, Polynomial.aeval_C]
            exact (MvPolynomial.rename Fin.castSucc).commutes c
          · change (MvPolynomial.rename Fin.castSucc)
              ((Polynomial.aeval (MvPolynomial.X i₀ : MvPolynomial (Fin δ) k)) Polynomial.X) =
              (Polynomial.aeval (MvPolynomial.X i₀.castSucc : MvPolynomial (Fin (δ + 1)) k))
                Polynomial.X
            rw [Polynomial.aeval_X, Polynomial.aeval_X, MvPolynomial.rename_X]
    constructor
    · intro α_j hαj_over hαj_pr
      let P := weilPolyP1Over k (m + 1)
      let σ : Equiv.Perm (Fin (m + 1)) := Equiv.swap j (Fin.last m)
      let β_pack := polyP1_lift (m + 1) P.hom (fun i => rec_proj (m + 1) (σ i))
        (fun i => hProj_over (m + 1) (σ i))
      let β_hom : Quiver.Hom P.left P.left := β_pack.1
      have hβ_over : CategoryTheory.CategoryStruct.comp β_hom P.hom = P.hom := β_pack.2.1
      have hβ_proj : ∀ i : Fin (m + 1),
          CategoryTheory.CategoryStruct.comp β_hom (rec_proj (m + 1) i) =
            rec_proj (m + 1) (σ i) := β_pack.2.2
      have hβ_sq : CategoryTheory.CategoryStruct.comp β_hom β_hom =
          CategoryTheory.CategoryStruct.id P.left := by
        apply polyP1_hom_ext (m + 1)
        · rw [CategoryTheory.Category.assoc, hβ_over, hβ_over, CategoryTheory.Category.id_comp]
        · intro i
          rw [CategoryTheory.Category.assoc, hβ_proj i, hβ_proj (σ i),
            CategoryTheory.Category.id_comp]
          have hσ_inv : σ (σ i) = i := Equiv.swap_apply_self j (Fin.last m) i
          rw [hσ_inv]
      let β_j : CategoryTheory.Iso P.left P.left := ⟨β_hom, β_hom, hβ_sq, hβ_sq⟩
      have hι_over_m1 : CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) P.hom =
          (weilAffineSpaceOver k (m + 1)).hom :=
        (hCoord.2.2.2.2.2.2.2.2 (m + 1)).2.2.1
      have hαβ : CategoryTheory.CategoryStruct.comp α_j.hom (ι_aff (m + 1)) =
          CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) β_j.hom := by
        apply polyP1_hom_ext (m + 1)
        · rw [CategoryTheory.Category.assoc, hι_over_m1, hαj_over,
            CategoryTheory.Category.assoc]
          change _ = CategoryTheory.CategoryStruct.comp (ι_aff (m + 1))
            (CategoryTheory.CategoryStruct.comp β_hom P.hom)
          rw [hβ_over, hι_over_m1]
        · intro i
          rw [CategoryTheory.Category.assoc, h_ιaff_proj (m + 1) i,
            ← CategoryTheory.Category.assoc]
          have hpr_step :
              CategoryTheory.CategoryStruct.comp α_j.hom (pr_aff (m + 1) i) =
                pr_aff (m + 1) (σ i) := hαj_pr i
          rw [hpr_step, CategoryTheory.Category.assoc]
          change CategoryTheory.CategoryStruct.comp (pr_aff (m + 1) (σ i)) ι_P1 =
            CategoryTheory.CategoryStruct.comp (ι_aff (m + 1))
              (CategoryTheory.CategoryStruct.comp β_hom (rec_proj (m + 1) i))
          rw [hβ_proj i, h_ιaff_proj (m + 1) (σ i)]
      have hβ_last : j = Fin.last m → β_j = CategoryTheory.Iso.refl P.left := by
        intro hj_eq
        apply CategoryTheory.Iso.ext
        change β_hom = CategoryTheory.CategoryStruct.id P.left
        apply polyP1_hom_ext (m + 1)
        · rw [hβ_over, CategoryTheory.Category.id_comp]
        · intro i
          rw [hβ_proj i, CategoryTheory.Category.id_comp]
          have hσ_id : σ i = i := by
            dsimp only [σ]
            rw [hj_eq, Equiv.swap_self, Equiv.refl_apply]
          rw [hσ_id]
      exact ⟨β_j, hβ_over, hαβ, hβ_last⟩
    · intro α_neg hαneg_fst hαneg_snd
      obtain ⟨_, ν_neg, _, _, _, hν_over_raw, hν_aff, _⟩ := hCoord.2.2.2.2.2.2.1
      have hν_over : CategoryTheory.CategoryStruct.comp ν_neg.hom P1.hom = P1.hom := hν_over_raw
      have hν_inv_over : CategoryTheory.CategoryStruct.comp ν_neg.inv P1.hom = P1.hom := by
        calc
          CategoryTheory.CategoryStruct.comp ν_neg.inv P1.hom
            = CategoryTheory.CategoryStruct.comp ν_neg.inv
                (CategoryTheory.CategoryStruct.comp ν_neg.hom P1.hom) := by rw [hν_over]
          _ = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.comp ν_neg.inv ν_neg.hom) P1.hom :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = CategoryTheory.CategoryStruct.comp
                (CategoryTheory.CategoryStruct.id P1.left) P1.hom := by rw [ν_neg.inv_hom_id]
          _ = P1.hom := CategoryTheory.Category.id_comp P1.hom
      let δ_hom_pack := hp_lift m (p_fst m)
        (CategoryTheory.CategoryStruct.comp (p_snd m) ν_neg.hom)
        (by rw [CategoryTheory.Category.assoc, hν_over, hp_cond m])
      let δ_inv_pack := hp_lift m (p_fst m)
        (CategoryTheory.CategoryStruct.comp (p_snd m) ν_neg.inv)
        (by rw [CategoryTheory.Category.assoc, hν_inv_over, hp_cond m])
      let δ_hom := δ_hom_pack.1
      let δ_inv := δ_inv_pack.1
      have hδ_hom_fst : CategoryTheory.CategoryStruct.comp δ_hom (p_fst m) = p_fst m :=
        δ_hom_pack.2.1
      have hδ_hom_snd : CategoryTheory.CategoryStruct.comp δ_hom (p_snd m) =
          CategoryTheory.CategoryStruct.comp (p_snd m) ν_neg.hom :=
        δ_hom_pack.2.2
      have hδ_inv_fst : CategoryTheory.CategoryStruct.comp δ_inv (p_fst m) = p_fst m :=
        δ_inv_pack.2.1
      have hδ_inv_snd : CategoryTheory.CategoryStruct.comp δ_inv (p_snd m) =
          CategoryTheory.CategoryStruct.comp (p_snd m) ν_neg.inv :=
        δ_inv_pack.2.2
      have hδ_hom_inv : CategoryTheory.CategoryStruct.comp δ_hom δ_inv =
          CategoryTheory.CategoryStruct.id (weilPolyP1Over k (m + 1)).left := by
        apply hp_hom_ext m
        · rw [CategoryTheory.Category.assoc, hδ_inv_fst, hδ_hom_fst,
            CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hδ_inv_snd, ← CategoryTheory.Category.assoc,
            hδ_hom_snd, CategoryTheory.Category.assoc, ν_neg.hom_inv_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      have hδ_inv_hom : CategoryTheory.CategoryStruct.comp δ_inv δ_hom =
          CategoryTheory.CategoryStruct.id (weilPolyP1Over k (m + 1)).left := by
        apply hp_hom_ext m
        · rw [CategoryTheory.Category.assoc, hδ_hom_fst, hδ_inv_fst,
            CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hδ_hom_snd, ← CategoryTheory.Category.assoc,
            hδ_inv_snd, CategoryTheory.Category.assoc, ν_neg.inv_hom_id,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      let δ_neg : CategoryTheory.Iso
          (weilPolyP1Over k (m + 1)).left (weilPolyP1Over k (m + 1)).left :=
        ⟨δ_hom, δ_inv, hδ_hom_inv, hδ_inv_hom⟩
      have hδ_over : CategoryTheory.CategoryStruct.comp δ_neg.hom (weilPolyP1Over k (m + 1)).hom =
          (weilPolyP1Over k (m + 1)).hom := by
        change CategoryTheory.CategoryStruct.comp δ_hom (weilPolyP1Over k (m + 1)).hom = _
        rw [hp_hom_succ m, ← CategoryTheory.Category.assoc, hδ_hom_fst]
      have hαδ : CategoryTheory.CategoryStruct.comp α_neg.hom (ι_aff (m + 1)) =
          CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) δ_neg.hom := by
        have hm := hCoord.2.2.2.2.2.2.2.2 m
        have hm_fst :
            CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) (p_fst m) =
              CategoryTheory.CategoryStruct.comp (aff_cast m) (ι_aff m) := hm.2.2.2.1
        have hm_snd :
            CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) (p_snd m) =
              CategoryTheory.CategoryStruct.comp (pr_aff (m + 1) (Fin.last m)) ι_P1 := hm.2.2.2.2
        have hαneg_fst' :
            CategoryTheory.CategoryStruct.comp α_neg.hom (aff_cast m) = aff_cast m := hαneg_fst
        have hαneg_snd' :
            CategoryTheory.CategoryStruct.comp α_neg.hom (pr_aff (m + 1) (Fin.last m)) =
              CategoryTheory.CategoryStruct.comp (pr_aff (m + 1) (Fin.last m))
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  (Polynomial.aeval (R := k) (-Polynomial.X : Polynomial k)).toRingHom)) :=
          hαneg_snd
        change CategoryTheory.CategoryStruct.comp α_neg.hom (ι_aff (m + 1)) =
          CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) δ_hom
        apply hp_hom_ext m
        · rw [CategoryTheory.Category.assoc, hm_fst, ← CategoryTheory.Category.assoc,
            hαneg_fst', CategoryTheory.Category.assoc, hδ_hom_fst, hm_fst]
        · rw [CategoryTheory.Category.assoc, hm_snd, ← CategoryTheory.Category.assoc,
            hαneg_snd', CategoryTheory.Category.assoc, hν_aff, ← CategoryTheory.Category.assoc,
            ← hm_snd, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hδ_hom_snd]
      exact ⟨ν_neg, δ_neg, hν_over_raw, hδ_over, hδ_hom_fst, hδ_hom_snd, hαδ⟩

  
  obtain ⟨u_swap, u_neg, hu_swap_val, hu_neg_val, hMat_ne⟩ := hMat
  obtain ⟨α_rep, hα_over, hα_trans, hα_symm, hα_perm, hα_neg_proj⟩ := hAffRep
  obtain ⟨hPoly1, hPoly2⟩ := hPoly
  have hαj_pr := hα_perm (Equiv.swap j (Fin.last m)) u_swap hu_swap_val
  obtain ⟨β_j, hβ_over, hαβ, hβ_last⟩ := hPoly1 (α_rep u_swap) (hα_over u_swap) hαj_pr
  obtain ⟨hαneg_fst, hαneg_snd⟩ := hα_neg_proj u_neg hu_neg_val
  obtain ⟨ν_neg, δ_neg, hν_over, hδ_over, hδ_fst, hδ_snd, hαδ⟩ :=
    hPoly2 (α_rep u_neg) hαneg_fst hαneg_snd
  refine ⟨α_rep u_swap, β_j, hβ_over, hαβ, hαj_pr, hβ_last, ?_⟩
  intro hj
  obtain ⟨u_Elj, u_Ejl, u_X, u_Y, hComm_u, hConj_u, hFour_u⟩ := hMat_ne hj
  refine ⟨ν_neg, α_rep u_neg, δ_neg, α_rep u_Elj, α_rep u_Ejl, α_rep u_X, α_rep u_Y,
    hν_over, hα_over u_neg, hδ_over, hδ_fst, hδ_snd, hαδ,
    hα_over u_Elj, hα_over u_Ejl, hα_over u_X, hα_over u_Y, ?_, ?_, ?_⟩
  · rw [hα_symm u_X, hα_symm u_Y, hα_trans u_X⁻¹ u_Y⁻¹,
      hα_trans u_Y (u_Y⁻¹ * u_X⁻¹),
      hα_trans u_X (u_Y⁻¹ * u_X⁻¹ * u_Y), hComm_u]
  · rw [hα_symm u_swap, hα_trans u_Elj u_swap⁻¹,
      hα_trans u_swap (u_swap⁻¹ * u_Elj), hConj_u]
  · rw [hα_symm u_Elj, hα_trans u_Ejl u_neg,
      hα_trans u_Elj⁻¹ (u_neg * u_Ejl),
      hα_trans u_Ejl (u_neg * u_Ejl * u_Elj⁻¹), hFour_u]

theorem weil_etale_pinned_global_iso_roof_pullback (k : Type u) [Field k] (ℓ : ℕ)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (β : CategoryTheory.Iso Y.left Y.left)
    (hβ : CategoryTheory.CategoryStruct.comp β.hom Y.hom = Y.hom)
    (U U' : Y.left.Etale)
    (e₀ : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).left
      ((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U').left)
    (h₀ : WeilIsAffineRoofIso k Y Y U U' e₀)
    (hcomm : CategoryTheory.CategoryStruct.comp
      (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U).hom) β.hom =
      CategoryTheory.CategoryStruct.comp e₀.hom
        (((AlgebraicGeometry.Scheme.Etale.forget Y.left).obj U').hom))
    (r q : ℕ)
    (p_β : weilEtaleTorsionH Y.left (ℓ ^ r) q →+ weilEtaleTorsionH Y.left (ℓ ^ r) q)
    (hp_β : WeilIsTorsionEtalePullback β.hom (ℓ ^ r) q p_β)
    (z : weilEtaleLocalTorsionH Y.left (ℓ ^ r) U q) :
    weilEtaleLocalTorsionCounitH Y.left (ℓ ^ r) U q z =
      p_β (weilEtaleLocalTorsionCounitH Y.left (ℓ ^ r) U' q
        (Ψ Y Y U U' e₀ h₀ r q z)) :=
by
  rcases hp_β with ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ, hιπ, hπι, hp_formula⟩
  let S : AlgebraicGeometry.Scheme.{u} := Y.left
  let m : ℕ := ℓ ^ r
  let J := S.smallEtaleTopology
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let B_β : CategoryTheory.Functor S.Etale S.Etale := weilEtaleSitePullback β.hom
  letI : B_β.IsContinuous J J := hCont
  let pf_β := B_β.sheafPushforwardContinuous AddCommGrpCat.{u} J J
  letI : pf_β.IsRightAdjoint := hAdj
  let pb_β := B_β.sheafPullback AddCommGrpCat.{u} J J
  let adj_β := B_β.sheafAdjunctionContinuous AddCommGrpCat.{u} J J
  letI : pb_β.Additive := hAdd
  letI : CategoryTheory.Limits.PreservesFiniteLimits pb_β := hLim
  letI : CategoryTheory.Limits.PreservesFiniteColimits pb_β := hColim
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
  let Fℤ := C.obj Aℤ
  let FM := weilEtaleTorsionSheaf S m
  let L_U := weilEtaleLocalTorsionSheaf S m U
  let L_U' := weilEtaleLocalTorsionSheaf S m U'
  let adj₁ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₁
  let adj₂ := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT₂
  let τ : Quiver.Hom (B_β.obj T₂) T₁ := hT₁.from (B_β.obj T₂)
  let ρ_M : Quiver.Hom FM (pf_β.obj FM) :=
    (adj₂.homEquiv AM (pf_β.obj FM)).symm
      (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM) (FM.obj.map τ.op))
  let π_M : Quiver.Hom (pb_β.obj FM) FM :=
    (adj_β.homEquiv FM FM).symm ρ_M

  let W : AlgebraicGeometry.Scheme.{u} := (Fgt.obj U).left
  let p_U : W ⟶ S := (Fgt.obj U).hom
  let W' : AlgebraicGeometry.Scheme.{u} := (Fgt.obj U').left
  let p_U' : W' ⟶ S := (Fgt.obj U').hom
  let P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback p_U' β.hom
  let p_fst : P ⟶ W' := CategoryTheory.Limits.pullback.fst p_U' β.hom
  let p_snd : P ⟶ S := CategoryTheory.Limits.pullback.snd p_U' β.hom
  let s_hom : W ⟶ P := CategoryTheory.Limits.pullback.lift e₀.hom p_U hcomm.symm
  have hs_fst : s_hom ≫ p_fst = e₀.hom :=
    CategoryTheory.Limits.pullback.lift_fst e₀.hom p_U hcomm.symm
  have hs_snd : s_hom ≫ p_snd = p_U :=
    CategoryTheory.Limits.pullback.lift_snd e₀.hom p_U hcomm.symm
  let s_inv : P ⟶ W := p_fst ≫ e₀.inv
  have hs_inv_over : s_inv ≫ p_U = p_snd := by
    calc
      (p_fst ≫ e₀.inv) ≫ p_U
        = ((p_fst ≫ e₀.inv) ≫ p_U) ≫ (β.hom ≫ β.inv) := by
            rw [β.hom_inv_id, CategoryTheory.Category.comp_id]
      _ = p_fst ≫ e₀.inv ≫ (p_U ≫ β.hom) ≫ β.inv := by
            simp only [CategoryTheory.Category.assoc]
      _ = p_fst ≫ e₀.inv ≫ (e₀.hom ≫ p_U') ≫ β.inv := by
            rw [hcomm]
      _ = p_fst ≫ (e₀.inv ≫ e₀.hom) ≫ p_U' ≫ β.inv := by
            simp only [CategoryTheory.Category.assoc]
      _ = (p_fst ≫ p_U') ≫ β.inv := by
            rw [e₀.inv_hom_id, CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc]
      _ = (p_snd ≫ β.hom) ≫ β.inv := by
            rw [CategoryTheory.Limits.pullback.condition]
      _ = p_snd ≫ (β.hom ≫ β.inv) := CategoryTheory.Category.assoc _ _ _
      _ = p_snd := by rw [β.hom_inv_id, CategoryTheory.Category.comp_id]
  have hs_hom_inv : s_hom ≫ s_inv = 𝟙 W := by
    dsimp [s_inv]
    rw [← CategoryTheory.Category.assoc, hs_fst, e₀.hom_inv_id]
  have hs_inv_hom : s_inv ≫ s_hom = 𝟙 P := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hs_fst, CategoryTheory.Category.id_comp]
      dsimp [s_inv]
      rw [CategoryTheory.Category.assoc, e₀.inv_hom_id, CategoryTheory.Category.comp_id]
    · rw [CategoryTheory.Category.assoc, hs_snd, hs_inv_over, CategoryTheory.Category.id_comp]
  let σ_e : U ⟶ B_β.obj U' :=
    CategoryTheory.MorphismProperty.Over.homMk s_hom hs_snd trivial
  let σ_inv : B_β.obj U' ⟶ U :=
    CategoryTheory.MorphismProperty.Over.homMk s_inv hs_inv_over trivial
  have hσ_fst : CategoryTheory.CategoryStruct.comp ((Fgt.map σ_e).left) p_fst = e₀.hom := hs_fst
  have hσ_hom_inv : σ_e ≫ σ_inv = 𝟙 U :=
    CategoryTheory.MorphismProperty.Over.Hom.ext hs_hom_inv

  let ξ₀ : Quiver.Hom AM ((pf_β.obj L_U).obj.obj (Opposite.op U')) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ L_U.obj.map σ_inv.op
  let α_π : Quiver.Hom L_U' (pf_β.obj L_U) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ξ₀
  let ξ := CategoryTheory.Sheaf.freeYonedaHomEquiv α_π
  have hξ_eq : ξ = ξ₀ := Equiv.apply_symm_apply _ _
  have hξ_σ :
      CategoryTheory.CategoryStruct.comp ξ (L_U.obj.map (Opposite.op σ_e)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_U) := by
    rw [hξ_eq]
    change (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ L_U.obj.map σ_inv.op) ≫
        L_U.obj.map σ_e.op =
      CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U)
    rw [CategoryTheory.Category.assoc, ← L_U.obj.map_comp]
    have hop : (σ_inv.op ≫ σ_e.op : Opposite.op U ⟶ Opposite.op U) = (σ_e ≫ σ_inv).op := rfl
    have hop_id : (𝟙 U : U ⟶ U).op = 𝟙 (Opposite.op U) := rfl
    rw [hop, hσ_hom_inv, hop_id, L_U.obj.map_id, CategoryTheory.Category.comp_id]
  have hξ_disj :
      ∀ (V : S.Etale) (w : Quiver.Hom V (B_β.obj U')),
        Disjoint (Set.range ((Fgt.map w).left).base) (Set.range ((Fgt.map σ_e).left).base) →
        CategoryTheory.CategoryStruct.comp ξ (L_U.obj.map (Opposite.op w)) = 0 := by
    intro V w hDisj
    have hEmpty : ∀ x : ↥V.left, False := by
      intro x
      let y : ↥P := ((Fgt.map w).left).base x
      have hy₁ : y ∈ Set.range ((Fgt.map w).left).base := ⟨x, rfl⟩
      have hy₂ : y ∈ Set.range ((Fgt.map σ_e).left).base := by
        refine ⟨s_inv.base y, ?_⟩
        change (s_inv ≫ s_hom).base y = (𝟙 P : P ⟶ P).base y
        rw [hs_inv_hom]
      exact Set.disjoint_left.mp hDisj hy₁ hy₂
    have hBot : (⊥ : CategoryTheory.Sieve V) ∈ J V := by
      let botV : CategoryTheory.Sieve V := ⊥
      have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
        ⟨fun _ _ hf hg => by have := hf; have := hg; infer_instance⟩
      change botV ∈ S.smallGrothendieckTopology (@AlgebraicGeometry.Etale) V
      rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
        (le_refl (@AlgebraicGeometry.Etale))]
      exact (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (@AlgebraicGeometry.Etale) (@AlgebraicGeometry.Etale) S _ _ _ _ _ V botV).mpr
        (fun x => False.elim (hEmpty x))
    have hTermV : CategoryTheory.Limits.IsTerminal (L_U.obj.obj (Opposite.op V)) :=
      CategoryTheory.Sheaf.isTerminalOfBotCover L_U V hBot
    exact hTermV.hom_ext _ 0

  let ε_U : Quiver.Hom L_U FM := weilEtaleLocalTorsionCounit S m U
  let ε_U' : Quiver.Hom L_U' FM := weilEtaleLocalTorsionCounit S m U'
  let ψ_π : Quiver.Hom (pb_β.obj L_U') L_U := (adj_β.homEquiv L_U' L_U).symm α_π
  have hEquiv_comp :
      ∀ {W_et : S.Etale}
        {ℱ 𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (α : CategoryTheory.Sheaf.freeYoneda J W_et AM ⟶ ℱ)
        (g : ℱ ⟶ 𝒢),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro W_et ℱ 𝒢 α g
    let α' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ ℱ := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ 𝒢) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ ℱ) α' ≫
              (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _
  let u_M := (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
    ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)
  let u_M_app : ∀ V : S.Etale, Quiver.Hom AM (FM.obj.obj (Opposite.op V)) :=
    fun V => u_M.app (Opposite.op V)
  have hu_M :
      ∀ {V₁ V₂ : S.Etale} (v : Quiver.Hom V₁ V₂),
        u_M_app V₂ ≫ FM.obj.map v.op = u_M_app V₁ := by
    intro V₁ V₂ v
    have hnat := (u_M.naturality v.op).symm
    change u_M_app V₂ ≫ FM.obj.map v.op = 𝟙 AM ≫ u_M_app V₁ at hnat
    rwa [CategoryTheory.Category.id_comp] at hnat
  have hadj_unit :
      ∀ (T : S.Etale) (hT : CategoryTheory.Limits.IsTerminal T),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app AM =
          u_M_app T := by
    intro T hT
    dsimp [u_M_app, u_M, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp]
    exact CategoryTheory.Category.id_comp _
  have hε_U_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv ε_U = u_M_app U :=
    Equiv.apply_symm_apply _ _
  have hε_U'_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv ε_U' = u_M_app U' :=
    Equiv.apply_symm_apply _ _
  have hRightMate :
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α_π ≫ pf_β.map ε_U) =
        u_M_app (B_β.obj U') := by
    rw [hEquiv_comp α_π (pf_β.map ε_U),
      show CategoryTheory.Sheaf.freeYonedaHomEquiv α_π = ξ₀ from hξ_eq]
    change (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ L_U.obj.map σ_inv.op) ≫
        ε_U.hom.app (Opposite.op (B_β.obj U')) =
      u_M_app (B_β.obj U')
    calc
      (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ L_U.obj.map σ_inv.op) ≫
          ε_U.hom.app (Opposite.op (B_β.obj U'))
        = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫
            (L_U.obj.map σ_inv.op ≫ ε_U.hom.app (Opposite.op (B_β.obj U'))) :=
            CategoryTheory.Category.assoc _ _ _
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫
            (ε_U.hom.app (Opposite.op U) ≫ FM.obj.map σ_inv.op) := by
            rw [ε_U.hom.naturality σ_inv.op]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ ε_U.hom.app (Opposite.op U)) ≫
            FM.obj.map σ_inv.op :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv ε_U ≫ FM.obj.map σ_inv.op := by
            rw [← hEquiv_comp (𝟙 L_U) ε_U, CategoryTheory.Category.id_comp]
      _ = u_M_app U ≫ FM.obj.map σ_inv.op := by rw [hε_U_eq]
      _ = u_M_app (B_β.obj U') := hu_M σ_inv
  have hLeftMate :
      CategoryTheory.Sheaf.freeYonedaHomEquiv (ε_U' ≫ ρ_M) =
        u_M_app (B_β.obj U') := by
    let t_U' : Quiver.Hom U' T₂ := hT₂.from U'
    let ρ_T₂ : Quiver.Hom (FM.obj.obj (Opposite.op T₂))
        (FM.obj.obj (Opposite.op (B_β.obj T₂))) := ρ_M.hom.app (Opposite.op T₂)
    have hLeft1 :
        CategoryTheory.Sheaf.freeYonedaHomEquiv (ε_U' ≫ ρ_M) =
          (u_M_app T₂ ≫ ρ_M.hom.app (Opposite.op T₂)) ≫ (pf_β.obj FM).obj.map t_U'.op := by
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (ε_U' ≫ ρ_M)
          = CategoryTheory.Sheaf.freeYonedaHomEquiv ε_U' ≫ ρ_M.hom.app (Opposite.op U') :=
              hEquiv_comp ε_U' ρ_M
        _ = u_M_app U' ≫ ρ_M.hom.app (Opposite.op U') := by rw [hε_U'_eq]
        _ = (u_M_app T₂ ≫ FM.obj.map t_U'.op) ≫ ρ_M.hom.app (Opposite.op U') := by
              rw [← hu_M t_U']
        _ = u_M_app T₂ ≫ (FM.obj.map t_U'.op ≫ ρ_M.hom.app (Opposite.op U')) :=
              CategoryTheory.Category.assoc _ _ _
        _ = u_M_app T₂ ≫ (ρ_M.hom.app (Opposite.op T₂) ≫ (pf_β.obj FM).obj.map t_U'.op) := by
              rw [ρ_M.hom.naturality t_U'.op]
        _ = (u_M_app T₂ ≫ ρ_M.hom.app (Opposite.op T₂)) ≫ (pf_β.obj FM).obj.map t_U'.op :=
              (CategoryTheory.Category.assoc _ _ _).symm
    have hLeft1' :
        CategoryTheory.Sheaf.freeYonedaHomEquiv (ε_U' ≫ ρ_M) =
          (u_M_app T₂ ≫ ρ_T₂) ≫ FM.obj.map (B_β.map t_U').op := hLeft1
    have hρ_u : u_M_app T₂ ≫ ρ_T₂ = u_M_app T₁ ≫ FM.obj.map τ.op := by
      have h1 : (adj₂.homEquiv AM (pf_β.obj FM)) ρ_M =
          adj₂.unit.app AM ≫ ρ_M.hom.app (Opposite.op T₂) := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        rfl
      have h1' : (adj₂.homEquiv AM (pf_β.obj FM)) ρ_M = adj₂.unit.app AM ≫ ρ_T₂ := h1
      rw [hadj_unit T₂ hT₂] at h1'
      have h2 : (adj₂.homEquiv AM (pf_β.obj FM)) ρ_M =
          adj₁.unit.app AM ≫ FM.obj.map τ.op :=
        Equiv.apply_symm_apply _ _
      rw [hadj_unit T₁ hT₁] at h2
      exact h1'.symm.trans h2
    have hLeft2 :
        (u_M_app T₂ ≫ ρ_T₂) ≫ FM.obj.map (B_β.map t_U').op = u_M_app (B_β.obj U') := by
      calc
        (u_M_app T₂ ≫ ρ_T₂) ≫ FM.obj.map (B_β.map t_U').op
          = (u_M_app T₁ ≫ FM.obj.map τ.op) ≫ FM.obj.map (B_β.map t_U').op := by rw [hρ_u]
        _ = u_M_app T₁ ≫ (FM.obj.map τ.op ≫ FM.obj.map (B_β.map t_U').op) :=
              CategoryTheory.Category.assoc _ _ _
        _ = u_M_app T₁ ≫ FM.obj.map (B_β.map t_U' ≫ τ).op := by
              rw [← FM.obj.map_comp]
              rfl
        _ = u_M_app (B_β.obj U') := hu_M (B_β.map t_U' ≫ τ)
    exact hLeft1'.trans hLeft2
  have h_mate : ε_U' ≫ ρ_M = α_π ≫ pf_β.map ε_U :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv.injective (hLeftMate.trans hRightMate.symm)
  have h_counit_compat : ψ_π ≫ ε_U = pb_β.map ε_U' ≫ π_M :=
    (CategoryTheory.Adjunction.homEquiv_naturality_right_square adj_β ε_U' ρ_M α_π ε_U h_mate).symm

  let z' : weilEtaleLocalTorsionH S m U' q := Ψ Y Y U U' e₀ h₀ r q z
  let u_z' : CategoryTheory.Abelian.Ext.{u} Fℤ (pb_β.obj L_U') q :=
    (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
      ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_β _ _ _ _ _ Fℤ L_U' q) z')
      (Nat.zero_add q)
  have hΨ_inst :=
    hΨ.2.2.2.2 Y Y β.hom U U' e₀ h₀ hβ hcomm hCont hAdj hAdd hLim hColim
      T₁ hT₁ T₂ hT₂ ιℤ σ_e r α_π hιπ hπι hσ_fst hξ_σ hξ_disj q z'
  have hz_eq : z = u_z'.comp (CategoryTheory.Abelian.Ext.mk₀ ψ_π) (Nat.add_zero q) := by
    have hsymm : (Ψ Y Y U U' e₀ h₀ r q).symm z' = z :=
      (Ψ Y Y U U' e₀ h₀ r q).symm_apply_apply z
    rw [hsymm] at hΨ_inst
    exact hΨ_inst
  have hLHS :
      weilEtaleLocalTorsionCounitH S m U q z =
        u_z'.comp (CategoryTheory.Abelian.Ext.mk₀ (ψ_π ≫ ε_U)) (Nat.add_zero q) := by
    rw [hz_eq]
    change (u_z'.comp (CategoryTheory.Abelian.Ext.mk₀ ψ_π) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ ε_U) (Nat.add_zero q) =
      u_z'.comp (CategoryTheory.Abelian.Ext.mk₀ (ψ_π ≫ ε_U)) (Nat.add_zero q)
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero u_z'
        (CategoryTheory.Abelian.Ext.mk₀ ψ_π) (CategoryTheory.Abelian.Ext.mk₀ ε_U) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
  have hMapExt :
      (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_β _ _ _ _ _ Fℤ FM q)
        (weilEtaleLocalTorsionCounitH S m U' q z') =
      ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_β _ _ _ _ _ Fℤ L_U' q) z').comp
        (CategoryTheory.Abelian.Ext.mk₀ (pb_β.map ε_U')) (Nat.add_zero q) := by
    change (@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_β _ _ _ _ _ Fℤ FM q)
        (z'.comp (CategoryTheory.Abelian.Ext.mk₀ ε_U') (Nat.add_zero q)) = _
    rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
  have hRHS :
      p_β (weilEtaleLocalTorsionCounitH S m U' q z') =
        u_z'.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_β.map ε_U' ≫ π_M)) (Nat.add_zero q) := by
    rw [hp_formula (weilEtaleLocalTorsionCounitH S m U' q z'), hMapExt]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        (((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_β _ _ _ _ _ Fℤ L_U' q) z').comp
          (CategoryTheory.Abelian.Ext.mk₀ (pb_β.map ε_U')) (Nat.add_zero q))
        (Nat.zero_add q)).comp (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero q) = _
    rw [← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ pb_β _ _ _ _ _ Fℤ L_U' q) z')
        (CategoryTheory.Abelian.Ext.mk₀ (pb_β.map ε_U')) (Nat.zero_add q)]
    change (u_z'.comp (CategoryTheory.Abelian.Ext.mk₀ (pb_β.map ε_U')) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero q) = _
    rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero u_z'
        (CategoryTheory.Abelian.Ext.mk₀ (pb_β.map ε_U'))
        (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
  change weilEtaleLocalTorsionCounitH S m U q z =
    p_β (weilEtaleLocalTorsionCounitH S m U' q z')
  rw [hLHS, hRHS, h_counit_compat]

theorem weil_etale_scheme_iso_higherDirectImage_acyclic_and_const_iso (Y₀ : AlgebraicGeometry.Scheme.{u}) (e : CategoryTheory.Iso Y₀ Y₀)
    (hCont_hom : (weilEtaleSitePullback e.hom).IsContinuous Y₀.smallEtaleTopology Y₀.smallEtaleTopology)
    (hCont_inv : (weilEtaleSitePullback e.inv).IsContinuous Y₀.smallEtaleTopology Y₀.smallEtaleTopology)
    (hAdj_hom : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback e.hom)
      AddCommGrpCat.{u} _ Y₀.smallEtaleTopology Y₀.smallEtaleTopology hCont_hom).IsRightAdjoint) :
    letI := hCont_hom
    letI := hAdj_hom
    let pf_hom := (weilEtaleSitePullback e.hom).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₀.smallEtaleTopology
    let adj_hom := (weilEtaleSitePullback e.hom).sheafAdjunctionContinuous
      AddCommGrpCat.{u} Y₀.smallEtaleTopology Y₀.smallEtaleTopology
    (∀ (q : ℕ), 1 ≤ q → ∀ (G : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}),
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage e.hom q G)) ∧
    (∀ {T₁ T₂ : Y₀.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
       (hT₂ : CategoryTheory.Limits.IsTerminal T₂) (A : AddCommGrpCat.{u}),
      let F_A := (CategoryTheory.constantSheaf Y₀.smallEtaleTopology AddCommGrpCat.{u}).obj A
      let β_A : Quiver.Hom F_A (pf_hom.obj F_A) :=
        (adj_hom.homEquiv F_A F_A) (weilEtaleConstPullbackHom e.hom hT₁ hT₂ A)
      ∃ (α_A : Quiver.Hom (pf_hom.obj F_A) F_A),
        CategoryTheory.CategoryStruct.comp β_A α_A = CategoryTheory.CategoryStruct.id F_A ∧
        CategoryTheory.CategoryStruct.comp α_A β_A = CategoryTheory.CategoryStruct.id (pf_hom.obj F_A)) :=
by
  let _ := hCont_hom
  let _ := hAdj_hom
  let J_Y := Y₀.smallEtaleTopology
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget Y₀
  let B_hom := weilEtaleSitePullback e.hom
  let B_inv := weilEtaleSitePullback e.inv
  let pf_hom := B_hom.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_Y
  let pf_inv := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B_inv AddCommGrpCat.{u} _ J_Y J_Y hCont_inv
  let adj_hom := B_hom.sheafAdjunctionContinuous AddCommGrpCat.{u} J_Y J_Y
