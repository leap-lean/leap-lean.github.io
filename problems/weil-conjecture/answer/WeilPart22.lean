      · have hR_unfold : CategoryTheory.Presieve.map (CategoryTheory.Over.forget Z₂)
            (CategoryTheory.Presieve.map (AlgebraicGeometry.Scheme.Etale.forget Z₂) R) ∈
            (AlgebraicGeometry.Scheme.precoverage PEt).coverings U.left :=
          CategoryTheory.Precoverage.mem_comap_iff.mp
            (CategoryTheory.Precoverage.mem_comap_iff.mp hR)
        apply CategoryTheory.Precoverage.mem_comap_iff.mpr
        apply CategoryTheory.Precoverage.mem_comap_iff.mpr
        have hUnpackMap : ∀ {C D : Type (u + 1)} [CategoryTheory.Category.{u} C]
            [CategoryTheory.Category.{u} D] {X₀ : C} (F : C ⥤ D) (R₀ : CategoryTheory.Presieve X₀)
            {Y₀ : D} {g₀ : Y₀ ⟶ F.obj X₀},
            CategoryTheory.Presieve.map F R₀ g₀ →
            ∃ (W : C) (w : W ⟶ X₀), R₀ w ∧ Y₀ = F.obj W ∧ HEq g₀ (F.map w) := by
          intro C D _ _ X₀ F R₀ Y₀ g₀ hm
          cases hm with
          | @of W w hw => exact ⟨W, w, hw, rfl, HEq.rfl⟩
        let ι : Type (u + 1) := { vw : Σ (W : Z₂.Etale), (W ⟶ U) // R vw.2 }
        let X_fam : ι → AlgebraicGeometry.Scheme.{u} := fun i => i.1.1.left
        let f_fam : ∀ i : ι, X_fam i ⟶ U.left := fun i => i.1.2.left
        have hEq₂ : CategoryTheory.Presieve.ofArrows X_fam f_fam =
            CategoryTheory.Presieve.map (CategoryTheory.Over.forget Z₂)
              (CategoryTheory.Presieve.map (AlgebraicGeometry.Scheme.Etale.forget Z₂) R) := by
          funext W₀ g₀
          apply propext
          constructor
          · rintro ⟨i⟩
            exact CategoryTheory.Presieve.map.of (CategoryTheory.Presieve.map.of i.2)
          · intro hg₀
            obtain ⟨W_ov, w_ov, hg₁, hW₀, hg₀_eq⟩ :=
              hUnpackMap (CategoryTheory.Over.forget Z₂)
                (CategoryTheory.Presieve.map (AlgebraicGeometry.Scheme.Etale.forget Z₂) R) hg₀
            subst hW₀
            cases hg₀_eq
            obtain ⟨W, w, hw, hW_ov, hw_ov⟩ :=
