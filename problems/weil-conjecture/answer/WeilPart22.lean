    have hgerm_eq :
        (P1_over.left.presheaf.germ V₁ Q₀.1 hQ_in_V₁).hom det₁ =
          algebraMap B ↑(P1_over.left.presheaf.stalk (q_pt : ↥P1_over.left)) Δ := by
      rw [TopCat.Presheaf.stalk_open_algebraMap P1_over.left.presheaf q_pt]
      exact P1_over.left.presheaf.germ_res_apply (CategoryTheory.homOfLE hV₁_le) Q₀.1 hQ_in_V₁ Δ
    rw [hgerm_eq]
    exact hSpan_to_loc m_Q Δ hdet_span

  obtain ⟨s₁_P1, f_q_P1, hs₁_P1, hfq_P11, hfq_P12, hdiv_fq_P1⟩ :=
    hUnif_P1 V₁ V₂ hcov_V Q₀ hQ_in_V₁ rfl det₁ u_V (IsUnit.unit_spec hUnit_det₁) hspan_stalkQ
  have hMV_P1 : δ_MV P1_over V₁ V₂ hcov_V u_V = cl_P1 Q₀ := by
    rw [hMV_se P1_over V₁ V₂ hcov_V u_V (weilEtaleKSheaf P1_over.left) Q_P1
      ι_div_P1 π_div_P1 h0_div_P1 hSE_P1 s₁_P1 f_q_P1 hs₁_P1 hfq_P11 hfq_P12]
    have hmk_eq : CategoryTheory.Abelian.Ext.mk₀ f_q_P1 = e_div_P1.symm (Finsupp.single Q₀ 1) :=
      e_div_P1.injective (hdiv_fq_P1.trans (e_div_P1.apply_symm_apply _).symm)
    change (CategoryTheory.Abelian.Ext.mk₀ f_q_P1).comp hSE_P1.extClass (Nat.zero_add 1) =
      (e_div_P1.symm (Finsupp.single Q₀ 1)).comp hSE_P1.extClass (Nat.zero_add 1)
    rw [hmk_eq]

  let x₀ : weilEtaleTorsionH C_bar.left (ℓ ^ 1) 2 :=
    κ C_bar (δ_MV C_bar U₁ U₂ hcov_U u_U)
  have hx₀_eq : u_shriek x₀ = κ P1_over (cl_P1 Q₀) := by
    dsimp only [x₀]
    rw [hf_gm_κ]
    congr 1
    rw [hf_gm_MV V₁ V₂ hcov_V hcov_U hAff_V₁ hAff_U₁ A₁ inferInstance inferInstance
      bA₁ (AddEquiv.refl A₁) (fun _ _ => rfl) g₁ L_g (fun _ => rfl) u_U u_V hu_U_val hu_V_val]
    exact hMV_P1

  have hcl_P1_span :
      ∀ η : (weilEtaleGmSheaf P1_over.left).H 1, ∃ z : ℤ, η = z • cl_P1 Q₀ := by
    intro η
    obtain ⟨q, rfl⟩ := hSurj_P1 η
    let ψ : (Pt_P1 →₀ ℤ) →+ (weilEtaleGmSheaf P1_over.left).H 1 :=
      δ_P1.comp e_div_P1.symm.toAddMonoidHom
    have hψ_q : ψ (e_div_P1 q) = δ_P1 q := by
      change δ_P1 (e_div_P1.symm (e_div_P1 q)) = δ_P1 q
      rw [e_div_P1.symm_apply_apply]
    change ∃ z : ℤ, δ_P1 q = z • cl_P1 Q₀
    rw [← hψ_q]
    refine Finsupp.induction (e_div_P1 q) ?_ ?_
    · exact ⟨0, by rw [map_zero, zero_zsmul]⟩
    · intro Q n D' _ _ ⟨z', hz'⟩
      have hsingle : Finsupp.single Q n = n • Finsupp.single Q (1 : ℤ) := by
        ext pt
        simp [Finsupp.single_apply]
      refine ⟨n + z', ?_⟩
      have hcl_Q : ψ (Finsupp.single Q 1) = cl_P1 Q₀ := hcl_P1_eq Q Q₀
      rw [map_add, hsingle, map_zsmul, hcl_Q, hz', ← add_zsmul]

  have hSubGm2_P1 : Subsingleton ((weilEtaleGmSheaf P1_over.left).H 2) :=
    (weil_etale_smooth_proj_curve_gm_cohomology_and_divisor_iso k P1_over hProj_P1 ℓ).2.2
      2 (le_refl 2)
  intro w
  obtain ⟨η, rfl⟩ := hκ_surj P1_over hSubGm2_P1 w
  obtain ⟨z, rfl⟩ := hcl_P1_span η
  refine ⟨z • x₀, ?_⟩
  rw [map_zsmul, hx₀_eq, ← map_zsmul]

theorem weil_etale_algClosed_spec_unit_iso_and_stalk_colimit (k : Type u) [Field k] [IsAlgClosed k] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
    (∀ (P : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u}),
      CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P).app (Opposite.op T_k))) ∧
    (∀ {G₁ G₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
        (φ : Quiver.Hom G₁ G₂),
      φ.hom.app (Opposite.op T_k) = 0 → φ = 0) ∧
    (∀ (Y : CategoryTheory.Over S_k) (q : ℕ),
      ∃ e_H : ∀ (G : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
          ↥((weilEtaleHigherDirectImage Y.hom q G).obj.obj (Opposite.op T_k)) ≃+ G.H q,
        ∀ {G₁ G₂ : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom G₁ G₂)
          (x : ↥((weilEtaleHigherDirectImage Y.hom q G₁).obj.obj (Opposite.op T_k))),
          e_H G₂ (((weilEtaleHigherDirectImageMap Y.hom q φ).hom.app (Opposite.op T_k)).hom x) =
            (CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
              ((CategoryTheory.constantSheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              (Nat.add_zero q) (e_H G₁ x)) ∧
    (∀ (Z : AlgebraicGeometry.Scheme.{u}) (z : Quiver.Hom S_k Z)
        [_hc : (weilEtaleSitePullback z).IsContinuous
          Z.smallEtaleTopology S_k.smallEtaleTopology]
        [_hr : ((weilEtaleSitePullback z).sheafPushforwardContinuous AddCommGrpCat.{u}
          Z.smallEtaleTopology S_k.smallEtaleTopology).IsRightAdjoint]
        (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      let pb_z := (weilEtaleSitePullback z).sheafPullback AddCommGrpCat.{u}
        Z.smallEtaleTopology S_k.smallEtaleTopology
      let adj_z := (weilEtaleSitePullback z).sheafAdjunctionContinuous AddCommGrpCat.{u}
        Z.smallEtaleTopology S_k.smallEtaleTopology
      (∀ (x : ↥((pb_z.obj G).obj.obj (Opposite.op T_k))),
        ∃ (W : Z.Etale)
          (τ_W : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W))
          (s : ↥(G.obj.obj (Opposite.op W))),
          ((pb_z.obj G).obj.map (Opposite.op τ_W)).hom
            (((adj_z.unit.app G).hom.app (Opposite.op W)).hom s) = x) ∧
      (∀ (W : Z.Etale)
          (τ_W : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W))
          (s : ↥(G.obj.obj (Opposite.op W))),
        ((pb_z.obj G).obj.map (Opposite.op τ_W)).hom
          (((adj_z.unit.app G).hom.app (Opposite.op W)).hom s) = 0 →
        ∃ (W' : Z.Etale) (g : Quiver.Hom W' W)
          (τ_W' : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W')),
          CategoryTheory.CategoryStruct.comp τ_W' ((weilEtaleSitePullback z).map g) = τ_W ∧
          (G.obj.map (Opposite.op g)).hom s = 0)) :=
by
  intro S_k T_k
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hUniq_Sk : Unique ↥S_k := PrimeSpectrum.instUnique
  have hSub_Sk : Subsingleton ↥S_k := hUniq_Sk.instSubsingleton

  
  have hSplit : ∀ (V : AlgebraicGeometry.Scheme.{u}) (q : V ⟶ S_k),
      AlgebraicGeometry.Etale q → Function.Surjective q.base →
      ∃ σ : S_k ⟶ V, σ ≫ q = 𝟙 S_k := by
    intro V q hqEt hqSurj
    let R_q : CategoryTheory.Sieve S_k :=
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton q)
    have hSing : R_q ∈ AlgebraicGeometry.Scheme.etaleTopology S_k :=
      CategoryTheory.Precoverage.generate_mem_toGrothendieck
        ((AlgebraicGeometry.Scheme.singleton_mem_precoverage_iff P_et q).mpr ⟨hqSurj, hqEt⟩)
    obtain ⟨Y', f, hf, y, hy⟩ :=
      (AlgebraicGeometry.Scheme.geometricFiber k).jointly_surjective R_q hSing (𝟙 S_k)
    rcases hf with ⟨W', g, h, hh, rfl⟩
    cases hh
    exact ⟨y ≫ g, (CategoryTheory.Category.assoc y g q).trans hy⟩

  
  have hTop_Tk : ∀ R ∈ S_k.smallEtaleTopology T_k, R = ⊤ := by
    intro R hR
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S_k (le_refl P_et)
    have hmem := (iff_of_eq (congrArg (fun J => R ∈ J T_k) heq)).mp hR
    obtain ⟨W, u, w₀, huR, huEt, -⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_k) T_k R).mp hmem pt_k
    have huSurj : Function.Surjective u.left.base :=
      fun (x : ↥S_k) => ⟨w₀, @Subsingleton.elim ↥S_k hSub_Sk _ x⟩
    obtain ⟨s, hs⟩ := hSplit W.left u.left huEt huSurj
    have hu_w : u.left = W.hom :=
      (CategoryTheory.Category.comp_id u.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w u)
    have hs_hom : s ≫ W.hom = T_k.hom :=
      (congrArg (CategoryTheory.CategoryStruct.comp s) hu_w.symm).trans hs
    let s_et : T_k ⟶ W :=
      CategoryTheory.MorphismProperty.Over.homMk s hs_hom trivial
    have hcomp_id : s_et ≫ u = 𝟙 T_k :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext hs (Subsingleton.elim _ _)
    exact CategoryTheory.Sieve.id_mem_iff_eq_top.mp (hcomp_id ▸ R.downward_closed huR s_et)

  
  have hGen_Tk : ∀ (U : S_k.Etale) (R : CategoryTheory.Sieve U),
      (∀ (τ : Quiver.Hom T_k U), R.arrows τ) → R ∈ S_k.smallEtaleTopology U := by
    intro U R hArrows
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        S_k (le_refl P_et)
    refine (iff_of_eq (congrArg (fun J => R ∈ J U) heq)).mpr ?_
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) (S := S_k) U R).mpr ?_
    intro x
    obtain ⟨O, hAff, hx_O, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
    let R_O : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op O)
    let W : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec R_O
    have hx_range : x ∈ Set.range hAff.fromSpec.base := by
      rw [hAff.range_fromSpec]
      exact hx_O
    obtain ⟨p, hp_x⟩ := hx_range
    let p_W : W ⟶ S_k := hAff.fromSpec ≫ U.hom
    have : AlgebraicGeometry.Etale U.hom := U.prop
    have : AlgebraicGeometry.Etale p_W := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType p_W := inferInstance
    let φ_k : CommRingCat.of k ⟶ R_O := AlgebraicGeometry.Spec.preimage p_W
    have hφ_map : AlgebraicGeometry.Spec.map φ_k = p_W :=
      AlgebraicGeometry.Spec.map_preimage p_W
    have hFT_hom : RingHom.FiniteType φ_k.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp (hφ_map.symm ▸ inferInstance)
    let _ : Algebra k ↑R_O := φ_k.hom.toAlgebra
    have hFT_alg : Algebra.FiniteType k ↑R_O := hFT_hom
    obtain ⟨m, hm_max, hm_le⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
    have : m.IsMaximal := hm_max
    let q_pt : PrimeSpectrum ↑R_O := ⟨m, hm_max.isPrime⟩
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_mv.toRingHom m
    have : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_mv.toRingHom hq_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp inferInstance
    have hker_eval : ∀ f ∈ RingHom.ker q_mv.toRingHom,
        (MvPolynomial.aeval a_pt).toRingHom f = 0 := by
      intro f hf
      have hmem_mv : f ∈ m_mv := by
        change q_mv.toRingHom f ∈ m
        rw [RingHom.mem_ker.mp hf]
        exact m.zero_mem
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem_mv
      exact hmem_mv
    let σ_R : ↑R_O →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_mv.toRingHom)
        (MvPolynomial.aeval a_pt).toRingHom hker_eval).comp
        (RingHom.quotientKerEquivOfSurjective hq_surj).symm.toRingHom
    have hσ_q : ∀ f : MvPolynomial (Fin n_mv) k, σ_R (q_mv f) = MvPolynomial.aeval a_pt f := by
      intro f
      change (Ideal.Quotient.lift (RingHom.ker q_mv.toRingHom)
        (MvPolynomial.aeval a_pt).toRingHom hker_eval)
        ((RingHom.quotientKerEquivOfSurjective hq_surj).symm (q_mv.toRingHom f)) = _
      have h_symm : (RingHom.quotientKerEquivOfSurjective hq_surj).symm (q_mv.toRingHom f) =
          Ideal.Quotient.mk (RingHom.ker q_mv.toRingHom) f := by
        apply (RingHom.quotientKerEquivOfSurjective hq_surj).injective
        rw [RingEquiv.apply_symm_apply]
        rfl
      rw [h_symm]
      rfl
    have hφ_σ : φ_k ≫ CommRingCat.ofHom σ_R = 𝟙 (CommRingCat.of k) := by
      apply CommRingCat.hom_ext
      ext c
      change σ_R (algebraMap k (↑R_O) c) = algebraMap k k c
      rw [← q_mv.commutes c, hσ_q (algebraMap k _ c), (MvPolynomial.aeval a_pt).commutes c]
    have hcomap_σ : Ideal.comap σ_R ⊥ = m := by
      ext r
      obtain ⟨f, rfl⟩ := hq_surj r
      change σ_R (q_mv f) ∈ (⊥ : Ideal k) ↔ q_mv f ∈ m
      rw [Ideal.mem_bot, hσ_q f, ← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← ha_pt]
      rfl
    let σ : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_R)
    have hσ_pW : σ ≫ p_W = 𝟙 S_k := by
      dsimp [σ]
      rw [← hφ_map, ← AlgebraicGeometry.Spec.map_comp, hφ_σ, AlgebraicGeometry.Spec.map_id]
    have hσ_pt : σ.base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      exact hcomap_σ
    have hEt_σ : AlgebraicGeometry.Etale σ := by
      have hEt_comp : AlgebraicGeometry.Etale (σ ≫ p_W) := by
        rw [hσ_pW]
        infer_instance
      exact CategoryTheory.MorphismProperty.of_postcomp
        (W' := P_et) P_et σ p_W inferInstance hEt_comp
    have : AlgebraicGeometry.Etale σ := hEt_σ
    have hOpen_σ : IsOpen (Set.range σ.base) := σ.isOpenMap.isOpen_range
    have hq_mem_cl : q_pt ∈ closure ({(p : ↥W)} : Set ↥W) :=
      (PrimeSpectrum.le_iff_mem_closure p q_pt).mp hm_le
    have hq_mem_rng : q_pt ∈ Set.range σ.base := ⟨pt_k, hσ_pt⟩
    obtain ⟨w_pt, h_in_rng, h_in_sing⟩ :=
      mem_closure_iff.mp hq_mem_cl (Set.range σ.base) hOpen_σ hq_mem_rng
    obtain ⟨z_pt, hz_pt⟩ := h_in_rng
    have hw_eq_p : w_pt = p := Set.mem_singleton_iff.mp h_in_sing
    have hp_eq : σ.base pt_k = p :=
      (congrArg σ.base (@Subsingleton.elim ↥S_k hSub_Sk pt_k z_pt)).trans
        (hz_pt.trans hw_eq_p)
    let s_U : S_k ⟶ U.left := σ ≫ hAff.fromSpec
    have hs_U_hom : s_U ≫ U.hom = T_k.hom :=
      (CategoryTheory.Category.assoc σ hAff.fromSpec U.hom).trans hσ_pW
    have hs_U_et : AlgebraicGeometry.Etale s_U := inferInstance
    let τ_x : T_k ⟶ U :=
      CategoryTheory.MorphismProperty.Over.homMk s_U hs_U_hom trivial
    refine ⟨T_k, τ_x, pt_k, hArrows τ_x, hs_U_et, ?_⟩
    exact (congrArg hAff.fromSpec.base hp_eq).trans hp_x

  
  let R_pre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u} :=
    fun M =>
      { obj := fun W => AddCommGrpCat.of ((T_k ⟶ Opposite.unop W) → ↥M)
        map := fun f => AddCommGrpCat.ofHom
          { toFun := fun g τ => g (τ ≫ f.unop)
            map_zero' := rfl
            map_add' := fun _ _ => rfl }
        map_id := fun _ =>
          AddCommGrpCat.ext fun g => funext fun τ =>
            congrArg g (CategoryTheory.Category.comp_id τ)
        map_comp := fun f₁ f₂ =>
          AddCommGrpCat.ext fun g => funext fun τ =>
            congrArg g (CategoryTheory.Category.assoc τ f₂.unop f₁.unop).symm }
  have hR_sheaf : ∀ M : AddCommGrpCat.{u},
      CategoryTheory.Presheaf.IsSheaf S_k.smallEtaleTopology (R_pre M) := by
    intro M A₀ U S hS x hx
    have hτ : ∀ τ : T_k ⟶ U, S.arrows τ := by
      intro τ
      have hp : S.pullback τ = ⊤ := hTop_Tk (S.pullback τ)
        (S_k.smallEtaleTopology.pullback_stable τ hS)
      have hid : (S.pullback τ).arrows (𝟙 T_k) := by rw [hp]; trivial
      simpa [CategoryTheory.Category.id_comp] using hid
    let s_amalg : A₀ ⟶ (R_pre M).obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := fun a τ => (x τ (hτ τ)).hom a (𝟙 T_k)
          map_zero' := by
            ext τ
            exact map_zero ((x τ (hτ τ)).hom) ▸ rfl
          map_add' := fun a b => by
            ext τ
            exact congrFun (map_add (x τ (hτ τ)).hom a b) (𝟙 T_k) }
    refine ⟨s_amalg, ?_, ?_⟩
    · intro V f hf
      refine AddCommGrpCat.ext fun a => funext fun ρ => ?_
      have hc := hx (𝟙 T_k) ρ (hτ (ρ ≫ f)) hf (CategoryTheory.Category.id_comp (ρ ≫ f))
      have hc_a := congrFun (ConcreteCategory.congr_hom hc a) (𝟙 T_k)
      simpa [s_amalg, R_pre, CategoryTheory.Category.id_comp] using hc_a
    · intro s' hs'
      refine AddCommGrpCat.ext fun a => funext fun τ => ?_
      have h1 := congrFun (ConcreteCategory.congr_hom (hs' τ (hτ τ)) a) (𝟙 T_k)
      simpa [s_amalg, R_pre, CategoryTheory.Category.id_comp] using h1
  let R_sh : AddCommGrpCat.{u} →
      CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u} :=
    fun M => ⟨R_pre M, hR_sheaf M⟩

  let liftPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}), (Q.obj (Opposite.op T_k) ⟶ M) → (Q ⟶ R_pre M) :=
    fun Q M f =>
      { app := fun W => AddCommGrpCat.ofHom
          { toFun := fun q τ => f.hom ((Q.map τ.op).hom q)
            map_zero' := by
              ext τ
              simp
            map_add' := fun q₁ q₂ => by
              ext τ
              simp }
        naturality := fun {W₁ W₂} u => by
          ext q τ
          change f.hom ((Q.map τ.op).hom ((Q.map u).hom q)) =
            f.hom ((Q.map (τ ≫ u.unop).op).hom q)
          have hop : (τ ≫ u.unop).op = u ≫ τ.op := rfl
          rw [hop, Q.map_comp]
          rfl }
  let evPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}), (Q ⟶ R_pre M) → (Q.obj (Opposite.op T_k) ⟶ M) :=
    fun _ _ β => AddCommGrpCat.ofHom
      { toFun := fun q => (β.app (Opposite.op T_k)).hom q (𝟙 T_k)
        map_zero' := by
          change (β.app (Opposite.op T_k)).hom 0 (𝟙 T_k) = 0
          rw [map_zero]
          rfl
        map_add' := fun q₁ q₂ => congrFun (map_add (β.app (Opposite.op T_k)).hom q₁ q₂) (𝟙 T_k) }
  have evPre_liftPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}) (f : Q.obj (Opposite.op T_k) ⟶ M),
      evPre Q M (liftPre Q M f) = f := by
    intro Q M f
    ext q
    change f.hom ((Q.map (𝟙 T_k).op).hom q) = f.hom q
    have hop : (𝟙 T_k).op = 𝟙 (Opposite.op T_k) := rfl
    rw [hop, Q.map_id]
    rfl
  have liftPre_evPre : ∀ (Q : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}) (β : Q ⟶ R_pre M),
      liftPre Q M (evPre Q M β) = β := by
    intro Q M β
    ext W q τ
    have hnat := congrFun (ConcreteCategory.congr_hom (β.naturality τ.op) q) (𝟙 T_k)
    change (β.app (Opposite.op T_k)).hom ((Q.map τ.op).hom q) (𝟙 T_k) =
      (β.app W).hom q (𝟙 T_k ≫ τ) at hnat
    exact hnat.trans (congrArg ((β.app W).hom q) (CategoryTheory.Category.id_comp τ))

  
  let shAdj := CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology AddCommGrpCat.{u}
  have hConj1 : ∀ (P : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u}),
      CategoryTheory.IsIso ((shAdj.unit.app P).app (Opposite.op T_k)) := by
    intro P
    let P_sh := (CategoryTheory.presheafToSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj P
    let M₁ := P.obj (Opposite.op T_k)
    let M₂ := P_sh.obj.obj (Opposite.op T_k)
    let η_T : M₁ ⟶ M₂ := (shAdj.unit.app P).app (Opposite.op T_k)
    let r₁ : P_sh ⟶ R_sh M₁ := (shAdj.homEquiv P (R_sh M₁)).symm (liftPre P M₁ (𝟙 M₁))
    have hr₁ : shAdj.unit.app P ≫ r₁.hom = liftPre P M₁ (𝟙 M₁) := by
      have h := (shAdj.homEquiv P (R_sh M₁)).apply_symm_apply (liftPre P M₁ (𝟙 M₁))
      rwa [CategoryTheory.Adjunction.homEquiv_unit] at h
    let inv_η : M₂ ⟶ M₁ := evPre P_sh.obj M₁ r₁.hom
    have h_lr : η_T ≫ inv_η = 𝟙 M₁ := by
      have h1 : η_T ≫ inv_η = evPre P M₁ (shAdj.unit.app P ≫ r₁.hom) := rfl
      rw [h1, hr₁, evPre_liftPre]
    let u₁ : P_sh ⟶ R_sh M₂ := ⟨liftPre P_sh.obj M₂ (inv_η ≫ η_T)⟩
    let u₂ : P_sh ⟶ R_sh M₂ := ⟨liftPre P_sh.obj M₂ (𝟙 M₂)⟩
    have hu_eq : u₁ = u₂ := by
      apply (shAdj.homEquiv P (R_sh M₂)).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
      have hev : evPre P M₂ (shAdj.unit.app P ≫ u₁.hom) =
          evPre P M₂ (shAdj.unit.app P ≫ u₂.hom) := by
        have he₁ : evPre P M₂ (shAdj.unit.app P ≫ u₁.hom) =
            η_T ≫ evPre P_sh.obj M₂ u₁.hom := rfl
        have he₂ : evPre P M₂ (shAdj.unit.app P ≫ u₂.hom) =
            η_T ≫ evPre P_sh.obj M₂ u₂.hom := rfl
        rw [he₁, he₂]
        change η_T ≫ evPre P_sh.obj M₂ (liftPre P_sh.obj M₂ (inv_η ≫ η_T)) =
          η_T ≫ evPre P_sh.obj M₂ (liftPre P_sh.obj M₂ (𝟙 M₂))
        rw [evPre_liftPre, evPre_liftPre, ← CategoryTheory.Category.assoc, h_lr,
          CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      calc
        shAdj.unit.app P ≫ u₁.hom = liftPre P M₂ (evPre P M₂ (shAdj.unit.app P ≫ u₁.hom)) :=
          (liftPre_evPre P M₂ _).symm
        _ = liftPre P M₂ (evPre P M₂ (shAdj.unit.app P ≫ u₂.hom)) := by rw [hev]
        _ = shAdj.unit.app P ≫ u₂.hom := liftPre_evPre P M₂ _
    have h_rl : inv_η ≫ η_T = 𝟙 M₂ := by
      calc
        inv_η ≫ η_T = evPre P_sh.obj M₂ u₁.hom :=
          (evPre_liftPre P_sh.obj M₂ (inv_η ≫ η_T)).symm
        _ = evPre P_sh.obj M₂ u₂.hom := by rw [hu_eq]
        _ = 𝟙 M₂ := evPre_liftPre P_sh.obj M₂ (𝟙 M₂)
    exact ⟨⟨inv_η, h_lr, h_rl⟩⟩

  
  have hConj2 : ∀ {G₁ G₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : Quiver.Hom G₁ G₂), φ.hom.app (Opposite.op T_k) = 0 → φ = 0 := by
    intro G₁ G₂ φ h0
    apply CategoryTheory.Sheaf.hom_ext
    ext U_op s
    let U : S_k.Etale := Opposite.unop U_op
    let y : ↥(G₂.obj.obj (Opposite.op U)) := (φ.hom.app (Opposite.op U)).hom s
    change y = 0
    let R_y : CategoryTheory.Sieve U :=
      { arrows := fun _ u => (G₂.obj.map u.op).hom y = 0
        downward_closed := by
          intro V W u hu g
          have hop : (g ≫ u).op = u.op ≫ g.op := rfl
          rw [hop, G₂.obj.map_comp]
          change (G₂.obj.map g.op).hom ((G₂.obj.map u.op).hom y) = 0
          rw [hu, map_zero] }
    have hRy : R_y ∈ S_k.smallEtaleTopology U := by
      apply hGen_Tk U R_y
      intro τ
      change (G₂.obj.map τ.op).hom ((φ.hom.app (Opposite.op U)).hom s) = 0
      have hnat := ConcreteCategory.congr_hom (φ.hom.naturality τ.op) s
      change (φ.hom.app (Opposite.op T_k)).hom ((G₁.obj.map τ.op).hom s) =
        (G₂.obj.map τ.op).hom ((φ.hom.app (Opposite.op U)).hom s) at hnat
      rw [← hnat, h0]
      rfl
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let homOfSec : Aℤ ⟶ G₂.obj.obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • y
          map_zero' := zero_zsmul y
          map_add' := fun a b => add_zsmul y a.down b.down }
    have hHomZero : homOfSec = 0 := by
      refine (G₂.property Aℤ R_y hRy).isSeparatedFor.ext ?_
      intro V u hu
      refine AddCommGrpCat.ext fun ⟨n⟩ => ?_
      change (G₂.obj.map u.op).hom (n • y) = (G₂.obj.map u.op).hom 0
      rw [map_zsmul, hu, zsmul_zero, map_zero]
    have h1 := ConcreteCategory.congr_hom hHomZero (ULift.up (1 : ℤ))
    simpa [homOfSec, one_zsmul] using h1

  
  have hConj3 : ∀ (Y : CategoryTheory.Over S_k) (q : ℕ),
      ∃ e_H : ∀ (G : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}),
          ↥((weilEtaleHigherDirectImage Y.hom q G).obj.obj (Opposite.op T_k)) ≃+ G.H q,
        ∀ {G₁ G₂ : CategoryTheory.Sheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom G₁ G₂)
          (x : ↥((weilEtaleHigherDirectImage Y.hom q G₁).obj.obj (Opposite.op T_k))),
          e_H G₂ (((weilEtaleHigherDirectImageMap Y.hom q φ).hom.app (Opposite.op T_k)).hom x) =
            (CategoryTheory.Abelian.Ext.mk₀ φ).postcomp
              ((CategoryTheory.constantSheaf Y.left.smallEtaleTopology AddCommGrpCat.{u}).obj
                (AddCommGrpCat.of (ULift.{u} ℤ)))
              (Nat.add_zero q) (e_H G₁ x) := by
    intro Y q
    let B_Y : CategoryTheory.Functor S_k.Etale Y.left.Etale := weilEtaleSitePullback Y.hom
    let T_Y : Y.left.Etale := B_Y.obj T_k
    let id_Sk : S_k ⟶ S_k := 𝟙 S_k
    let hPbId : CategoryTheory.Limits.pullback id_Sk Y.hom ≅ Y.left :=
      { hom := CategoryTheory.Limits.pullback.snd id_Sk Y.hom
        inv := CategoryTheory.Limits.pullback.lift Y.hom (𝟙 Y.left)
          ((CategoryTheory.Category.comp_id Y.hom).trans
            (CategoryTheory.Category.id_comp Y.hom).symm)
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Limits.pullback.condition]
            dsimp [id_Sk]
            rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
    let e_TY : T_Y ≅ weilEtaleIdTerminal.{u} Y.left :=
      CategoryTheory.MorphismProperty.Over.isoMk
        (A := T_Y) (B := weilEtaleIdTerminal.{u} Y.left) hPbId
        (CategoryTheory.Category.comp_id (CategoryTheory.Limits.pullback.snd id_Sk Y.hom))
    let hTerm_Y : CategoryTheory.Limits.IsTerminal T_Y :=
      (weilEtaleIdTerminalIsTerminal.{u} Y.left).ofIso e_TY.symm
    let J_Y := Y.left.smallEtaleTopology
    let Z_ulift : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
    let e_yon : ∀ W : Opposite Y.left.Etale,
        ((CategoryTheory.yoneda.obj T_Y).obj W) ≅ PUnit.{u + 1} :=
      fun W => Equiv.toIso
        { toFun := fun _ => PUnit.unit
          invFun := fun _ => hTerm_Y.from (Opposite.unop W)
          left_inv := fun g => hTerm_Y.hom_ext _ g
          right_inv := fun ⟨⟩ => rfl }
    let u_hom : AddCommGrpCat.free.obj PUnit.{u + 1} ⟶ Z_ulift :=
      (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Z_ulift).symm
        (TypeCat.ofHom (fun _ : PUnit.{u + 1} => ULift.up.{u} (1 : ℤ)))
    let gen₀ : ↥(AddCommGrpCat.free.obj PUnit.{u + 1}) :=
      (AddCommGrpCat.adj.unit.app PUnit.{u + 1}) PUnit.unit
    have hu_gen₀ : u_hom.hom gen₀ = ULift.up.{u} (1 : ℤ) := by
      have h := (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Z_ulift).apply_symm_apply
        (TypeCat.ofHom (fun _ : PUnit.{u + 1} => ULift.up.{u} (1 : ℤ)))
      rw [CategoryTheory.Adjunction.homEquiv_unit] at h
      exact ConcreteCategory.congr_hom h PUnit.unit
    let u_inv : Z_ulift ⟶ AddCommGrpCat.free.obj PUnit.{u + 1} :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • gen₀
          map_zero' := zero_zsmul gen₀
          map_add' := fun a b => add_zsmul gen₀ a.down b.down }
    let e_ℤ : AddCommGrpCat.free.obj PUnit.{u + 1} ≅ Z_ulift :=
      { hom := u_hom
        inv := u_inv
        hom_inv_id := by
          apply (AddCommGrpCat.adj.homEquiv PUnit.{u + 1}
            (AddCommGrpCat.free.obj PUnit.{u + 1})).injective
          rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
          ext ⟨⟩
          change u_inv.hom (u_hom.hom gen₀) = gen₀
          rw [hu_gen₀]
          exact one_zsmul gen₀
        inv_hom_id := by
          refine AddCommGrpCat.ext fun ⟨n⟩ => ?_
          change u_hom.hom (n • gen₀) = ULift.up n
          rw [map_zsmul, hu_gen₀]
          exact ULift.ext _ _ (zsmul_one n) }
    let φ_pre : (CategoryTheory.yoneda.obj T_Y).comp AddCommGrpCat.free ≅
        (CategoryTheory.Functor.const (Opposite Y.left.Etale)).obj Z_ulift :=
      CategoryTheory.NatIso.ofComponents
        (fun W => (AddCommGrpCat.free.mapIso (e_yon W)) ≪≫ e_ℤ)
        (fun {W₁ W₂} f => by
          simp only [CategoryTheory.Functor.comp_obj, CategoryTheory.Functor.comp_map,
            CategoryTheory.Functor.const_obj_obj, CategoryTheory.Functor.const_obj_map,
            CategoryTheory.Category.comp_id, CategoryTheory.Iso.trans_hom,
            CategoryTheory.Functor.mapIso_hom, ← CategoryTheory.Category.assoc]
          congr 1
          rw [← AddCommGrpCat.free.map_comp]
          congr 1)
    let Z_TY := (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj
      ((CategoryTheory.yoneda.obj T_Y).comp AddCommGrpCat.free)
    let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Z_ulift
    let φ_ℤ : Z_TY ≅ Fℤ_Y :=
      (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).mapIso φ_pre
    let e_coh : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        ↥((G.cohomologyPresheaf q).obj (Opposite.op T_Y)) ≃+ G.H q :=
      fun G =>
        { toFun := (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv).precomp G (Nat.zero_add q)
          invFun := (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom).precomp G (Nat.zero_add q)
          left_inv := fun (y : CategoryTheory.Abelian.Ext Z_TY G q) =>
            (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc φ_ℤ.hom φ_ℤ.inv y).trans
              ((congrArg (fun m => (CategoryTheory.Abelian.Ext.mk₀ m).comp y (Nat.zero_add q))
                φ_ℤ.hom_inv_id).trans
                (CategoryTheory.Abelian.Ext.mk₀_id_comp y))
          right_inv := fun (z : CategoryTheory.Abelian.Ext Fℤ_Y G q) =>
            (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc φ_ℤ.inv φ_ℤ.hom z).trans
              ((congrArg (fun m => (CategoryTheory.Abelian.Ext.mk₀ m).comp z (Nat.zero_add q))
                φ_ℤ.inv_hom_id).trans
                (CategoryTheory.Abelian.Ext.mk₀_id_comp z))
          map_add' := map_add _ }
    let iso_sh : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        ((G.cohomologyPresheaf q).obj (Opposite.op T_Y)) ≅
          ((weilEtaleHigherDirectImage Y.hom q G).obj.obj (Opposite.op T_k)) :=
      fun G =>
        @CategoryTheory.asIso _ _ _ _
          ((shAdj.unit.app (B_Y.op.comp (G.cohomologyPresheaf q))).app (Opposite.op T_k))
          (hConj1 (B_Y.op.comp (G.cohomologyPresheaf q)))
    let e_sh : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
        ↥((weilEtaleHigherDirectImage Y.hom q G).obj.obj (Opposite.op T_k)) ≃+
          ↥((G.cohomologyPresheaf q).obj (Opposite.op T_Y)) :=
      fun G =>
        { toFun := (iso_sh G).inv.hom
          invFun := (iso_sh G).hom.hom
          left_inv := fun x => ConcreteCategory.congr_hom (iso_sh G).inv_hom_id x
          right_inv := fun y => ConcreteCategory.congr_hom (iso_sh G).hom_inv_id y
          map_add' := map_add _ }
    refine ⟨fun G => (e_sh G).trans (e_coh G), ?_⟩
    intro G₁ G₂ φ x
    let α_φ := CategoryTheory.Functor.whiskerLeft B_Y.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map φ)
    have hnat_unit := CategoryTheory.NatTrans.congr_app (shAdj.unit.naturality α_φ)
      (Opposite.op T_k)
    have h_sh_comm : e_sh G₂ (((weilEtaleHigherDirectImageMap Y.hom q φ).hom.app
        (Opposite.op T_k)).hom x) =
        ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map φ).app
          (Opposite.op T_Y)).hom (e_sh G₁ x)) := by
      have h1 := ConcreteCategory.congr_hom hnat_unit (e_sh G₁ x)
      have hx_inv : (iso_sh G₁).hom.hom (e_sh G₁ x) = x :=
        ConcreteCategory.congr_hom (iso_sh G₁).inv_hom_id x
      change (iso_sh G₂).hom.hom
          ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map φ).app
            (Opposite.op T_Y)).hom (e_sh G₁ x)) =
        (((weilEtaleHigherDirectImageMap Y.hom q φ).hom.app (Opposite.op T_k)).hom
          ((iso_sh G₁).hom.hom (e_sh G₁ x))) at h1
      rw [hx_inv] at h1
      have h2 := congrArg (iso_sh G₂).inv.hom h1
      have hy_inv : (iso_sh G₂).inv.hom ((iso_sh G₂).hom.hom
          ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map φ).app
            (Opposite.op T_Y)).hom (e_sh G₁ x))) =
          ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_Y q).map φ).app
            (Opposite.op T_Y)).hom (e_sh G₁ x)) :=
        ConcreteCategory.congr_hom (iso_sh G₂).hom_inv_id _
      exact h2.symm.trans hy_inv
    change e_coh G₂ (e_sh G₂ (((weilEtaleHigherDirectImageMap Y.hom q φ).hom.app
      (Opposite.op T_k)).hom x)) =
      (CategoryTheory.Abelian.Ext.mk₀ φ).postcomp Fℤ_Y (Nat.add_zero q) (e_coh G₁ (e_sh G₁ x))
    rw [h_sh_comm]
    exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
      (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv) (e_sh G₁ x)
      (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.zero_add q)).symm

  
  refine ⟨hConj1, hConj2, hConj3, ?_⟩
  intro Z z _hc _hr G
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et z :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et z :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_z : CategoryTheory.Functor Z.Etale S_k.Etale := weilEtaleSitePullback z
  let F_z : CategoryTheory.Functor Z.Etale (Type u) :=
    B_z.comp (CategoryTheory.coyoneda.obj (Opposite.op T_k))

  
  have hCof_z : CategoryTheory.IsCofiltered F_z.Elements := by
    let _ : CategoryTheory.Limits.PreservesFiniteLimits B_z :=
      CategoryTheory.MorphismProperty.Over.instPreservesFiniteLimitsTopPullback P_et z
    let _ : CategoryTheory.Limits.PreservesFiniteLimits F_z :=
      CategoryTheory.Limits.comp_preservesFiniteLimits B_z
        (CategoryTheory.coyoneda.obj (Opposite.op T_k))
    exact CategoryTheory.Functor.isCofiltered_elements F_z

  
  have hJoint_z : ∀ {W : Z.Etale}, ∀ R ∈ Z.smallEtaleTopology W, ∀ (σ : F_z.obj W),
      ∃ (V : Z.Etale) (f : Quiver.Hom V W) (_ : R.arrows f) (τ : F_z.obj V),
        F_z.map f τ = σ := by
    intro W R hR σ
    have heq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Z (le_refl P_et)
    have hmem := (iff_of_eq (congrArg (fun J => R ∈ J W) heq)).mp hR
    let α : S_k ⟶ W.left := σ.left ≫ CategoryTheory.Limits.pullback.fst W.hom z
    have hσ_snd : σ.left ≫ CategoryTheory.Limits.pullback.snd W.hom z = 𝟙 S_k :=
      CategoryTheory.MorphismProperty.Over.w σ
    have hα_W : α ≫ W.hom = z :=
      (CategoryTheory.Category.assoc σ.left
        (CategoryTheory.Limits.pullback.fst W.hom z) W.hom).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp σ.left)
          (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := z))).trans
          ((CategoryTheory.Category.assoc σ.left
            (CategoryTheory.Limits.pullback.snd W.hom z) z).symm.trans
            ((congrArg (fun m => m ≫ z) hσ_snd).trans
              (CategoryTheory.Category.id_comp z))))
    obtain ⟨V, f, v₀, hfR, hfEt, hfv₀⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := Z) W R).mp hmem (α.base pt_k)
    have : AlgebraicGeometry.Etale f.left := hfEt
    let Q := CategoryTheory.Limits.pullback α f.left
    let fst_Q : Q ⟶ S_k := CategoryTheory.Limits.pullback.fst α f.left
    have hSurj_Q : Function.Surjective fst_Q.base := by
      obtain ⟨q₀, hq₀_fst, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback pt_k v₀ hfv₀.symm
      exact fun x => ⟨q₀, hq₀_fst.trans (@Subsingleton.elim ↥S_k hSub_Sk pt_k x)⟩
    obtain ⟨s_Q, hs_Q⟩ := hSplit Q fst_Q inferInstance hSurj_Q
    let β : S_k ⟶ V.left := s_Q ≫ CategoryTheory.Limits.pullback.snd α f.left
    have hβ_f : β ≫ f.left = α :=
      (CategoryTheory.Category.assoc s_Q
        (CategoryTheory.Limits.pullback.snd α f.left) f.left).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp s_Q)
          (CategoryTheory.Limits.pullback.condition (f := α) (g := f.left)).symm).trans
          ((CategoryTheory.Category.assoc s_Q fst_Q α).symm.trans
            ((congrArg (fun m => m ≫ α) hs_Q).trans
              (CategoryTheory.Category.id_comp α))))
    have hβ_V : β ≫ V.hom = z :=
      (congrArg (CategoryTheory.CategoryStruct.comp β)
        (CategoryTheory.MorphismProperty.Over.w f).symm).trans
        ((CategoryTheory.Category.assoc β f.left W.hom).symm.trans
          ((congrArg (fun m => m ≫ W.hom) hβ_f).trans hα_W))
    let τ_left : S_k ⟶ (B_z.obj V).left :=
      CategoryTheory.Limits.pullback.lift β (𝟙 S_k)
        (hβ_V.trans (CategoryTheory.Category.id_comp z).symm)
    let τ : F_z.obj V :=
      CategoryTheory.MorphismProperty.Over.homMk τ_left
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
    have h_left : τ_left ≫ (B_z.map f).left = σ.left := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · have hmap_fst : (B_z.map f).left ≫ CategoryTheory.Limits.pullback.fst W.hom z =
            CategoryTheory.Limits.pullback.fst V.hom z ≫ f.left :=
          (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.fst W.hom z)
            (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ z f)).trans
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        exact (CategoryTheory.Category.assoc τ_left _ _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp τ_left) hmap_fst).trans
            ((CategoryTheory.Category.assoc τ_left _ _).symm.trans
              ((congrArg (fun m => m ≫ f.left)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans hβ_f)))
      · have hmap_snd : (B_z.map f).left ≫ CategoryTheory.Limits.pullback.snd W.hom z =
            CategoryTheory.Limits.pullback.snd V.hom z :=
          (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.snd W.hom z)
            (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ z f)).trans
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        exact (CategoryTheory.Category.assoc τ_left _ _).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp τ_left) hmap_snd).trans
            ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans hσ_snd.symm))
    exact ⟨V, f, hfR, τ,
      CategoryTheory.MorphismProperty.Comma.Hom.ext h_left (Subsingleton.elim _ _)⟩

  
  have hInit_z : CategoryTheory.InitiallySmall.{u} F_z.Elements := by
    have : CategoryTheory.IsCofiltered F_z.Elements := hCof_z
    let G_aff := AlgebraicGeometry.Scheme.AffineEtale.Spec Z
    let e_sm := CategoryTheory.equivSmallModel.{u} Z.AffineEtale
    let ι_Z := e_sm.inverse.comp G_aff
    let idxFn : (Σ m : CategoryTheory.SmallModel.{u} Z.AffineEtale, F_z.obj (ι_Z.obj m)) →
        F_z.Elements :=
      fun p => CategoryTheory.Functor.elementsMk F_z (ι_Z.obj p.1) p.2
    refine CategoryTheory.initiallySmall_of_small_weakly_initial_set (Set.range idxFn) ?_
    intro x
    have hCov : CategoryTheory.Sieve.coverByImage G_aff x.1 ∈ Z.smallEtaleTopology x.1 :=
      CategoryTheory.Functor.IsCoverDense.is_cover (G := G_aff) x.1
    obtain ⟨V, f, hf, τ, hτ_eq⟩ := hJoint_z _ hCov x.2
    rcases hf with ⟨s_cov⟩
    let A := s_cov.obj
    let m : CategoryTheory.SmallModel.{u} Z.AffineEtale := e_sm.functor.obj A
    let u_A : G_aff.obj A ⟶ ι_Z.obj m := G_aff.map (e_sm.unitIso.hom.app A)
    let v_A : ι_Z.obj m ⟶ G_aff.obj A := G_aff.map (e_sm.unitIso.inv.app A)
    have huv_A : u_A ≫ v_A = 𝟙 (G_aff.obj A) := by
      dsimp [u_A, v_A]
      rw [← G_aff.map_comp, e_sm.unitIso.hom_inv_id_app A]
      exact G_aff.map_id A
    let τ_m : F_z.obj (ι_Z.obj m) := F_z.map (s_cov.lift ≫ u_A) τ
    let k_m : ι_Z.obj m ⟶ x.1 := v_A ≫ s_cov.map
    have hk_eq : (s_cov.lift ≫ u_A) ≫ k_m = f := by
      dsimp [k_m]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc u_A v_A s_cov.map,
        huv_A, CategoryTheory.Category.id_comp]
      exact s_cov.fac
    have hmap_km : F_z.map k_m τ_m = x.2 := by
      change (τ ≫ B_z.map (s_cov.lift ≫ u_A)) ≫ B_z.map k_m = x.2
      rw [CategoryTheory.Category.assoc, ← B_z.map_comp, hk_eq]
      exact hτ_eq
    exact ⟨idxFn ⟨m, τ_m⟩, ⟨⟨m, τ_m⟩, rfl⟩,
      ⟨CategoryTheory.Functor.Elements.homMk
        (x := idxFn ⟨m, τ_m⟩) (y := x) k_m hmap_km⟩⟩

  
  let Φ_z : CategoryTheory.GrothendieckTopology.Point.{u} Z.smallEtaleTopology :=
    { fiber := F_z
      isCofiltered := hCof_z
      initiallySmall := hInit_z
      jointly_surjective := @hJoint_z }
  let pf_z := B_z.sheafPushforwardContinuous AddCommGrpCat.{u}
    Z.smallEtaleTopology S_k.smallEtaleTopology
  let pb_z := B_z.sheafPullback AddCommGrpCat.{u}
    Z.smallEtaleTopology S_k.smallEtaleTopology
  let adj_z := B_z.sheafAdjunctionContinuous AddCommGrpCat.{u}
    Z.smallEtaleTopology S_k.smallEtaleTopology
  let A : AddCommGrpCat.{u} := (pb_z.obj G).obj.obj (Opposite.op T_k)
  let B_fib : AddCommGrpCat.{u} := Φ_z.presheafFiber.obj G.obj
  let c_leg : ∀ (W : Z.Etale), Φ_z.fiber.obj W → (G.obj.obj (Opposite.op W) ⟶ A) :=
    fun W τ_W => (adj_z.unit.app G).hom.app (Opposite.op W) ≫ (pb_z.obj G).obj.map (Opposite.op τ_W)
  have hc_compat : ∀ ⦃W' W : Z.Etale⦄ (g : W' ⟶ W) (τ_W' : Φ_z.fiber.obj W'),
      G.obj.map g.op ≫ c_leg W' τ_W' = c_leg W (Φ_z.fiber.map g τ_W') := by
    intro W' W g τ_W'
    have h1 : G.obj.map g.op ≫
        ((adj_z.unit.app G).hom.app (Opposite.op W') ≫
          (pb_z.obj G).obj.map (Opposite.op τ_W')) =
        (G.obj.map g.op ≫ (adj_z.unit.app G).hom.app (Opposite.op W')) ≫
          (pb_z.obj G).obj.map (Opposite.op τ_W') :=
      (CategoryTheory.Category.assoc _ _ _).symm
    have h2 : G.obj.map g.op ≫ (adj_z.unit.app G).hom.app (Opposite.op W') =
        (adj_z.unit.app G).hom.app (Opposite.op W) ≫
          (pb_z.obj G).obj.map (B_z.map g).op :=
      (adj_z.unit.app G).hom.naturality g.op
    have h3 : (pb_z.obj G).obj.map (B_z.map g).op ≫
        (pb_z.obj G).obj.map (Opposite.op τ_W') =
        (pb_z.obj G).obj.map (Opposite.op (τ_W' ≫ B_z.map g)) :=
      ((pb_z.obj G).obj.map_comp (B_z.map g).op (Opposite.op τ_W')).symm
    exact h1.trans ((congrArg (fun m => m ≫ (pb_z.obj G).obj.map (Opposite.op τ_W')) h2).trans
      ((CategoryTheory.Category.assoc _ _ _).trans
        (congrArg (CategoryTheory.CategoryStruct.comp
          ((adj_z.unit.app G).hom.app (Opposite.op W))) h3)))
  let ψ_BA : B_fib ⟶ A := Φ_z.presheafFiberDesc c_leg hc_compat

  have hBij_ψ : ∀ M : AddCommGrpCat.{u}, Function.Bijective (fun f : A ⟶ M => ψ_BA ≫ f) := by
    intro M
    let E₁ : (A ⟶ M) ≃ (pb_z.obj G ⟶ R_sh M) :=
      { toFun := fun f => ⟨liftPre (pb_z.obj G).obj M f⟩
        invFun := fun u => evPre (pb_z.obj G).obj M u.hom
        left_inv := fun f => evPre_liftPre (pb_z.obj G).obj M f
        right_inv := fun u =>
          CategoryTheory.Sheaf.hom_ext (liftPre_evPre (pb_z.obj G).obj M u.hom) }
    let E₂ : (pb_z.obj G ⟶ R_sh M) ≃ (G ⟶ pf_z.obj (R_sh M)) :=
      adj_z.homEquiv G (R_sh M)
    let d_leg : (G ⟶ pf_z.obj (R_sh M)) →
        ∀ (W : Z.Etale), Φ_z.fiber.obj W → (G.obj.obj (Opposite.op W) ⟶ M) :=
      fun η W τ_W => AddCommGrpCat.ofHom
        { toFun := fun s => (η.hom.app (Opposite.op W)).hom s τ_W
          map_zero' := by
            change (η.hom.app (Opposite.op W)).hom 0 τ_W = 0
            rw [map_zero]
            rfl
          map_add' := fun s₁ s₂ =>
            congrFun (map_add (η.hom.app (Opposite.op W)).hom s₁ s₂) τ_W }
    have hd_compat : ∀ (η : G ⟶ pf_z.obj (R_sh M)) ⦃W' W : Z.Etale⦄
        (g : W' ⟶ W) (τ_W' : Φ_z.fiber.obj W'),
        G.obj.map g.op ≫ d_leg η W' τ_W' = d_leg η W (Φ_z.fiber.map g τ_W') := by
      intro η W' W g τ_W'
      ext s
      exact congrFun (ConcreteCategory.congr_hom (η.hom.naturality g.op) s) τ_W'
    let E₃ : (G ⟶ pf_z.obj (R_sh M)) ≃ (B_fib ⟶ M) :=
      { toFun := fun η => Φ_z.presheafFiberDesc (d_leg η) (hd_compat η)
        invFun := fun k =>
          ⟨{ app := fun W => AddCommGrpCat.ofHom
               { toFun := fun s τ_W =>
                   k.hom ((Φ_z.toPresheafFiber (Opposite.unop W) τ_W G.obj).hom s)
                 map_zero' := by
                   ext τ_W
                   simp
                 map_add' := fun s₁ s₂ => by
                   ext τ_W
                   simp }
             naturality := fun {W₁ W₂} g =>
               AddCommGrpCat.ext fun s => funext fun τ_W => by
                 change k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₂) τ_W G.obj).hom
                     ((G.obj.map g).hom s)) =
                   k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₁)
                     (Φ_z.fiber.map g.unop τ_W) G.obj).hom s)
                 congr 1
                 simpa using Φ_z.toPresheafFiber_w_apply g.unop τ_W G.obj s }⟩
        left_inv := fun η => by
          apply CategoryTheory.Sheaf.hom_ext
          refine CategoryTheory.NatTrans.ext (funext fun W =>
            AddCommGrpCat.ext fun s => funext fun τ_W => ?_)
          have hdesc := Φ_z.toPresheafFiber_presheafFiberDesc
            (d_leg η) (hd_compat η) (Opposite.unop W) τ_W
          exact ConcreteCategory.congr_hom hdesc s
        right_inv := fun k => by
          apply Φ_z.presheafFiber_hom_ext
          intro W τ_W
          let η_k : G ⟶ pf_z.obj (R_sh M) :=
            ⟨{ app := fun W₀ => AddCommGrpCat.ofHom
                 { toFun := fun s τ₀ =>
                     k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₀) τ₀ G.obj).hom s)
                   map_zero' := by ext τ₀; simp
                   map_add' := fun _ _ => by ext τ₀; simp }
               naturality := fun {W₁ W₂} g =>
                 AddCommGrpCat.ext fun s => funext fun τ₀ => by
                   change k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₂) τ₀ G.obj).hom
                       ((G.obj.map g).hom s)) =
                     k.hom ((Φ_z.toPresheafFiber (Opposite.unop W₁)
                       (Φ_z.fiber.map g.unop τ₀) G.obj).hom s)
                   congr 1
                   simpa using Φ_z.toPresheafFiber_w_apply g.unop τ₀ G.obj s }⟩
          exact Φ_z.toPresheafFiber_presheafFiberDesc (d_leg η_k) (hd_compat η_k) W τ_W }
    have hComp_eq : (fun f : A ⟶ M => ψ_BA ≫ f) = E₃ ∘ E₂ ∘ E₁ := by
      funext f
      symm
      apply Φ_z.presheafFiber_hom_ext
      intro W τ_W
      have hLHS := Φ_z.toPresheafFiber_presheafFiberDesc
        (d_leg (E₂ (E₁ f))) (hd_compat (E₂ (E₁ f))) W τ_W
      have hRHS : Φ_z.toPresheafFiber W τ_W G.obj ≫ (ψ_BA ≫ f) = c_leg W τ_W ≫ f :=
        (CategoryTheory.Category.assoc _ _ _).symm.trans
          (congrArg (fun m => m ≫ f)
            (Φ_z.toPresheafFiber_presheafFiberDesc c_leg hc_compat W τ_W))
      refine hLHS.trans (Eq.trans ?_ hRHS.symm)
      ext s
      have hE₂ : E₂ (E₁ f) = adj_z.unit.app G ≫ pf_z.map (E₁ f) := by
        dsimp [E₂]
        rw [CategoryTheory.Adjunction.homEquiv_unit]
      change ((E₂ (E₁ f)).hom.app (Opposite.op W)).hom s τ_W = (c_leg W τ_W ≫ f).hom s
      rw [hE₂]
      rfl
    rw [hComp_eq]
    exact E₃.bijective.comp (E₂.bijective.comp E₁.bijective)

  obtain ⟨φ_AB, h_bf⟩ := (hBij_ψ B_fib).2 (𝟙 B_fib)
  dsimp only at h_bf
  have h_fb : φ_AB ≫ ψ_BA = 𝟙 A := by
    apply (hBij_ψ A).1
    dsimp only
    rw [← CategoryTheory.Category.assoc, h_bf, CategoryTheory.Category.id_comp,
      CategoryTheory.Category.comp_id]

  have := AddCommGrpCat.FilteredColimits.forget_preservesFilteredColimits.{u}
  refine ⟨?_, ?_⟩
  · intro x
    obtain ⟨W, τ_W, s, hs⟩ := Φ_z.toPresheafFiber_jointly_surjective (P := G.obj) (φ_AB.hom x)
    refine ⟨W, τ_W, s, ?_⟩
    have h1 := congrArg ψ_BA.hom hs
    have hdesc := ConcreteCategory.congr_hom
      (Φ_z.toPresheafFiber_presheafFiberDesc c_leg hc_compat W τ_W) s
    have hfb_x := ConcreteCategory.congr_hom h_fb x
    exact hdesc.symm.trans (h1.trans hfb_x)
  · intro W τ_W s h0
    have hdesc_s := ConcreteCategory.congr_hom
      (Φ_z.toPresheafFiber_presheafFiberDesc c_leg hc_compat W τ_W) s
    have hψ_s : ψ_BA.hom ((Φ_z.toPresheafFiber W τ_W G.obj).hom s) = 0 :=
      hdesc_s.trans h0
    have h_eq0 : (Φ_z.toPresheafFiber W τ_W G.obj).hom s =
        (Φ_z.toPresheafFiber W τ_W G.obj).hom 0 := by
      have h2 := congrArg φ_AB.hom hψ_s
      have hbf_s := ConcreteCategory.congr_hom h_bf ((Φ_z.toPresheafFiber W τ_W G.obj).hom s)
      rw [map_zero] at h2 ⊢
      exact hbf_s.symm.trans h2
    obtain ⟨W', g, τ_W', hτ_eq, hs_eq⟩ :=
      (Φ_z.toPresheafFiber_eq_iff' W τ_W s 0).mp h_eq0
    exact ⟨W', g, τ_W', hτ_eq, hs_eq.trans (map_zero _)⟩

theorem weil_etale_openImmersion_baseChange_degZero_isIso {X S S' X' : AlgebraicGeometry.Scheme.{u}}
    (f : Quiver.Hom X S) (g : Quiver.Hom S' S) [AlgebraicGeometry.IsOpenImmersion g]
    (f' : Quiver.Hom X' S') (g' : Quiver.Hom X' X)
    (hpb : CategoryTheory.IsPullback g' f' f g)
    [_hc_f : (weilEtaleSitePullback f).IsContinuous S.smallEtaleTopology X.smallEtaleTopology]
    [_hc_g : (weilEtaleSitePullback g).IsContinuous S.smallEtaleTopology S'.smallEtaleTopology]
    [_hc_f' : (weilEtaleSitePullback f').IsContinuous S'.smallEtaleTopology X'.smallEtaleTopology]
    [_hc_g' : (weilEtaleSitePullback g').IsContinuous X.smallEtaleTopology X'.smallEtaleTopology]
    [_hr_g : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology).IsRightAdjoint]
    [_hr_g' : ((weilEtaleSitePullback g').sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology).IsRightAdjoint]
    (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) :
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_f := weilEtaleSitePullback f
    let B_g := weilEtaleSitePullback g
    let B_f' := weilEtaleSitePullback f'
    let B_g' := weilEtaleSitePullback g'
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology X.smallEtaleTopology
    let pf_f' := B_f'.sheafPushforwardContinuous AddCommGrpCat.{u}
      S'.smallEtaleTopology X'.smallEtaleTopology
    let pb_g' := B_g'.sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology
    let adj_g := B_g.sheafAdjunctionContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology S'.smallEtaleTopology
    let adj_g' := B_g'.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology X'.smallEtaleTopology
    let e_fun : CategoryTheory.Iso
        (CategoryTheory.Functor.comp B_f B_g') (CategoryTheory.Functor.comp B_g B_f') :=
      CategoryTheory.Iso.trans
        (CategoryTheory.Iso.symm (CategoryTheory.MorphismProperty.Over.pullbackComp g' f))
        (CategoryTheory.Iso.trans
          (CategoryTheory.MorphismProperty.Over.pullbackCongr hpb.w)
          (CategoryTheory.MorphismProperty.Over.pullbackComp f' g))
    letI : (CategoryTheory.Functor.comp B_f B_g').IsContinuous
        S.smallEtaleTopology X'.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B_f B_g'
        S.smallEtaleTopology X.smallEtaleTopology X'.smallEtaleTopology
    letI : (CategoryTheory.Functor.comp B_g B_f').IsContinuous
        S.smallEtaleTopology X'.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp B_g B_f'
        S.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
    let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousIso e_fun AddCommGrpCat.{u}
      S.smallEtaleTopology X'.smallEtaleTopology
    CategoryTheory.IsIso ((adj_g.homEquiv (pf_f.obj F) (pf_f'.obj (pb_g'.obj F))).symm
      (CategoryTheory.CategoryStruct.comp
        (pf_f.map (adj_g'.unit.app F))
        (e_pf.hom.app (pb_g'.obj F)))) :=
by
  intro B_f B_g B_f' B_g' pf_f pf_f' pb_g' adj_g adj_g' e_fun e_pf
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : (CategoryTheory.Functor.comp B_f B_g').IsContinuous
      S.smallEtaleTopology X'.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp B_f B_g'
      S.smallEtaleTopology X.smallEtaleTopology X'.smallEtaleTopology
  have : (CategoryTheory.Functor.comp B_g B_f').IsContinuous
      S.smallEtaleTopology X'.smallEtaleTopology :=
    CategoryTheory.Functor.isContinuous_comp B_g B_f'
      S.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
  let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u}
    S.smallEtaleTopology S'.smallEtaleTopology
  let pf_g' := B_g'.sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology X'.smallEtaleTopology
  let bc₀ := (adj_g.homEquiv (pf_f.obj F) (pf_f'.obj (pb_g'.obj F))).symm
    (CategoryTheory.CategoryStruct.comp
      (pf_f.map (adj_g'.unit.app F))
      (e_pf.hom.app (pb_g'.obj F)))

  have : AlgebraicGeometry.IsOpenImmersion g' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb.flip inferInstance
  have hg : AlgebraicGeometry.Etale g := inferInstance
  have hg' : AlgebraicGeometry.Etale g' := inferInstance

  have h_open_adj : ∀ {Y' Y : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y' Y)
      [AlgebraicGeometry.IsOpenImmersion h]
      (hh : AlgebraicGeometry.Etale h)
      [hc_h : (weilEtaleSitePullback h).IsContinuous Y.smallEtaleTopology Y'.smallEtaleTopology],
      let Sig_h := weilEtalePostcomp h hh
      let B_h := weilEtaleSitePullback h
      ∃ (hc_Sig : Sig_h.IsContinuous Y'.smallEtaleTopology Y.smallEtaleTopology),
        letI := hc_Sig
        let res_h := Sig_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y'.smallEtaleTopology Y.smallEtaleTopology
        let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y.smallEtaleTopology Y'.smallEtaleTopology
        ∃ (adj_res : CategoryTheory.Adjunction res_h pf_h),
          (∀ (G : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u}) (U : Y.Etale),
            (adj_res.unit.app G).hom.app (Opposite.op U) =
              G.obj.map (Opposite.op
                (CategoryTheory.MorphismProperty.Over.homMk
                  (CategoryTheory.Limits.pullback.fst U.hom h)
                  CategoryTheory.Limits.pullback.condition trivial :
                  Quiver.Hom (Sig_h.obj (B_h.obj U)) U))) ∧
          (∀ (H : CategoryTheory.Sheaf Y'.smallEtaleTopology AddCommGrpCat.{u}) (W : Y'.Etale),
            (adj_res.counit.app H).hom.app (Opposite.op W) =
              H.obj.map (Opposite.op
                (CategoryTheory.MorphismProperty.Over.homMk
                  (CategoryTheory.Limits.pullback.lift
                    (CategoryTheory.CategoryStruct.id W.left) W.hom
                    (CategoryTheory.Category.id_comp (CategoryTheory.CategoryStruct.comp W.hom h)))
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial :
                  Quiver.Hom W (B_h.obj (Sig_h.obj W))))) := by
    intro Y' Y h _ hh hc_h
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    let Sig_h := weilEtalePostcomp h hh
    let B_h := weilEtaleSitePullback h
    have : CategoryTheory.Mono h := inferInstance
    have : Sig_h.Faithful :=
      ⟨fun {W₁ W₂} {u₁ u₂} hu =>
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (congrArg (fun m => m.left) hu) (Subsingleton.elim _ _)⟩
    have : Sig_h.Full :=
      { map_surjective := fun {W₁ W₂} v =>
          have hw : v.left ≫ W₂.hom = W₁.hom :=
            (cancel_mono h).mp
              ((CategoryTheory.Category.assoc v.left W₂.hom h).trans
                (CategoryTheory.MorphismProperty.Over.w v))
          ⟨CategoryTheory.MorphismProperty.Over.homMk v.left hw trivial,
            CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)⟩ }
    have h_comp : CategoryTheory.CompatiblePreserving Y.smallEtaleTopology Sig_h :=
      CategoryTheory.compatiblePreservingOfDownwardsClosed Y.smallEtaleTopology Sig_h
        (fun {W D} u =>
          have hu_w : u.left ≫ (W.hom ≫ h) = D.hom := CategoryTheory.MorphismProperty.Over.w u
          have hEt_u : AlgebraicGeometry.Etale u.left :=
            CategoryTheory.MorphismProperty.of_postcomp P_et u.left (W.hom ≫ h)
