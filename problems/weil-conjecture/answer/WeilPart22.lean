    have hComm_over := hOver_trans α_X
      (CategoryTheory.Iso.trans α_Y (CategoryTheory.Iso.trans α_X.symm α_Y.symm)) h_X hY_XY_inv
    have hΘ_Elj : Θ α_E_lj h_Elj = AddEquiv.refl (ZMod (ℓ ^ r)) := by
      rw [hΘ_congr α_E_lj _ h_Elj hComm_over hCommId,
        hΘ_trans α_X _ h_X hY_XY_inv hComm_over,
        hΘ_trans α_Y _ h_Y hXY_inv hY_XY_inv,
        hΘ_trans α_X.symm α_Y.symm hX_symm hY_symm hXY_inv,
        hΘ_symm α_X h_X hX_symm,
        hΘ_symm α_Y h_Y hY_symm]
      ext u
      dsimp only [AddEquiv.trans_apply, AddEquiv.refl_apply]
      rw [hZMod_comm (Θ α_X h_X) (Θ α_Y h_Y) u,
        (Θ α_X h_X).symm_apply_apply, (Θ α_Y h_Y).symm_apply_apply]
    have hj_symm := hOver_symm α_j hα_over
    have hElj_jsymm := hOver_trans α_E_lj α_j.symm h_Elj hj_symm
    have hConj_over := hOver_trans α_j (CategoryTheory.Iso.trans α_E_lj α_j.symm) hα_over hElj_jsymm
    have hΘ_Ejl : Θ α_E_jl h_Ejl = AddEquiv.refl (ZMod (ℓ ^ r)) := by
      rw [hΘ_congr α_E_jl _ h_Ejl hConj_over hConjId,
        hΘ_trans α_j _ hα_over hElj_jsymm hConj_over,
        hΘ_trans α_E_lj α_j.symm h_Elj hj_symm hElj_jsymm,
        hΘ_Elj,
        hΘ_symm α_j hα_over hj_symm]
      ext u
      dsimp only [AddEquiv.trans_apply, AddEquiv.refl_apply]
      exact (Θ α_j hα_over).symm_apply_apply u
    obtain ⟨p_δ, hp_δ⟩ := hPullEx δ_neg.hom (ℓ ^ r) q
    have hΘ_neg : Θ α_neg hα_neg = AddEquiv.refl (ZMod (ℓ ^ r)) := by
      ext u
      dsimp only [Θ, AddEquiv.trans_apply, AddEquiv.refl_apply]
      let z₀ := Φ.symm u
      have hcomm_neg :
          CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget P.left).obj U_aff).hom) δ_neg.hom =
          CategoryTheory.CategoryStruct.comp α_neg.hom
            (((AlgebraicGeometry.Scheme.Etale.forget P.left).obj U_aff).hom) :=
        hαδ.symm
      have hPull_neg :=
        weil_etale_pinned_global_iso_roof_pullback k ℓ Ψ hΨ P δ_neg hδ_over
          U_aff U_aff α_neg (hRoof α_neg hα_neg) hcomm_neg r q p_δ hp_δ z₀
      have hTr_neg :=
        weil_polyP1_last_fiber_aut_trace_invariance k ℓ hℓ ζ ι_P1 tr_Pd hTrace
          (@hPullEx) (@hPullComp) m r ν_neg hν_over δ_neg hδ_fst hδ_snd p_δ hp_δ
          (weilEtaleLocalTorsionCounitH P.left (ℓ ^ r) U_aff q
            (Ψ P P U_aff U_aff α_neg (hRoof α_neg hα_neg) r q z₀))
      have hΦ_eq :
          Φ (Ψ P P U_aff U_aff α_neg (hRoof α_neg hα_neg) r q z₀) = Φ z₀ := by
        simp only [Φ, e_counit, e_tr, AddEquiv.trans_apply, AddEquiv.ofBijective_apply]
        rw [hPull_neg, hTr_neg]
      exact hΦ_eq.trans (Φ.apply_symm_apply u)
    have hElj_symm := hOver_symm α_E_lj h_Elj
    have hEjl_neg := hOver_trans α_E_jl α_neg h_Ejl hα_neg
    have h3_over := hOver_trans α_E_lj.symm
      (CategoryTheory.Iso.trans α_E_jl α_neg) hElj_symm hEjl_neg
    have h4_over := hOver_trans α_E_jl
      (CategoryTheory.Iso.trans α_E_lj.symm (CategoryTheory.Iso.trans α_E_jl α_neg))
      h_Ejl h3_over
    have hΘ_j : Θ α_j hα_over = AddEquiv.refl (ZMod (ℓ ^ r)) := by
      rw [hΘ_congr α_j _ hα_over h4_over hFourId,
        hΘ_trans α_E_jl _ h_Ejl h3_over h4_over,
        hΘ_trans α_E_lj.symm _ hElj_symm hEjl_neg h3_over,
        hΘ_trans α_E_jl α_neg h_Ejl hα_neg hEjl_neg,
        hΘ_symm α_E_lj h_Elj hElj_symm,
        hΘ_Ejl, hΘ_Elj, hΘ_neg]
      ext u
      rfl
    let z₀ : weilEtaleLocalTorsionH P.left (ℓ ^ r) U_aff q :=
      (Ψ P P U_aff U_aff α_j (hRoof α_j hα_over) r q).symm (e_counit.symm w)
    have hΨ_z₀ :
        Ψ P P U_aff U_aff α_j (hRoof α_j hα_over) r q z₀ = e_counit.symm w :=
      (Ψ P P U_aff U_aff α_j (hRoof α_j hα_over) r q).apply_symm_apply (e_counit.symm w)
    have hcounit_Ψz₀ :
        weilEtaleLocalTorsionCounitH P.left (ℓ ^ r) U_aff q
          (Ψ P P U_aff U_aff α_j (hRoof α_j hα_over) r q z₀) = w := by
      rw [hΨ_z₀]
      have hw := e_counit.apply_symm_apply w
      simpa only [e_counit, AddEquiv.ofBijective_apply] using hw
    have hcomm_j :
        CategoryTheory.CategoryStruct.comp
          (((AlgebraicGeometry.Scheme.Etale.forget P.left).obj U_aff).hom) β_j.hom =
        CategoryTheory.CategoryStruct.comp α_j.hom
          (((AlgebraicGeometry.Scheme.Etale.forget P.left).obj U_aff).hom) :=
      hαβ.symm
    have hcounit_z₀ :
        weilEtaleLocalTorsionCounitH P.left (ℓ ^ r) U_aff q z₀ = p_β w := by
      have hPull_j :=
        weil_etale_pinned_global_iso_roof_pullback k ℓ Ψ hΨ P β_j hβ_over
          U_aff U_aff α_j (hRoof α_j hα_over) hcomm_j r q p_β hp_β z₀
      rwa [hcounit_Ψz₀] at hPull_j
    have hΦ_z₀ :
        Φ (Ψ P P U_aff U_aff α_j (hRoof α_j hα_over) r q z₀) = Φ z₀ := by
      have hApp := DFunLike.congr_fun hΘ_j (Φ z₀)
      dsimp only [Θ, AddEquiv.trans_apply, AddEquiv.refl_apply] at hApp
      rwa [Φ.symm_apply_apply] at hApp
    have hTr_eq :
        tr_Pd (m + 1) r
          (weilEtaleLocalTorsionCounitH P.left (ℓ ^ r) U_aff q
            (Ψ P P U_aff U_aff α_j (hRoof α_j hα_over) r q z₀)) =
        tr_Pd (m + 1) r (weilEtaleLocalTorsionCounitH P.left (ℓ ^ r) U_aff q z₀) := by
      simpa only [Φ, e_counit, e_tr, AddEquiv.trans_apply, AddEquiv.ofBijective_apply] using hΦ_z₀
    rw [← hcounit_z₀, ← hTr_eq, hcounit_Ψz₀]

theorem weil_connected_etale_dedekind_domain_and_separable_frac (R₀ B : Type u) [CommRing R₀] [IsDedekindDomain R₀]
    [CommRing B] [ConnectedSpace (PrimeSpectrum B)]
    [Algebra R₀ B] [Algebra.Etale R₀ B] :
    IsDomain B ∧
    IsIntegrallyClosed B ∧
    IsDedekindDomain B ∧
    Function.Injective (algebraMap R₀ B) ∧
    ∀ (K₀ K : Type u) [Field K₀] [Field K]
      [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
      [Algebra B K] [IsFractionRing B K]
      [Algebra K₀ K] [Algebra R₀ K]
      [IsScalarTower R₀ K₀ K] [IsScalarTower R₀ B K],
      FiniteDimensional K₀ K ∧ Algebra.IsSeparable K₀ K ∧ 1 ≤ Module.finrank K₀ K :=
by
  classical
  have hNoeth_B : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing R₀ B
  have hFlat_B : Module.Flat R₀ B := Algebra.Smooth.flat R₀ B
  have hLoc : ∀ (q : Ideal B) [q.IsPrime],
      IsDomain (Localization.AtPrime q) ∧ IsPrincipalIdealRing (Localization.AtPrime q) := by
    intro q hq_prime
    let p : Ideal R₀ := Ideal.comap (algebraMap R₀ B) q
    have hp_prime : p.IsPrime := Ideal.IsPrime.comap (algebraMap R₀ B)
    have hp_le_nzd : p.primeCompl ≤ nonZeroDivisors R₀ := by
      intro s hs
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro h0
      exact hs (h0 ▸ p.zero_mem)
    have hDom_Rp : IsDomain (Localization.AtPrime p) :=
      IsLocalization.isDomain_localization hp_le_nzd
    have hNoeth_Bq : IsNoetherianRing (Localization.AtPrime q) :=
      IsLocalization.isNoetherianRing q.primeCompl (Localization.AtPrime q) hNoeth_B
    let φ_loc : Localization.AtPrime p →+* Localization.AtPrime q :=
      Localization.localRingHom p q (algebraMap R₀ B) rfl
    have hLocal_φ : IsLocalHom φ_loc :=
      Localization.isLocalHom_localRingHom p q (algebraMap R₀ B) rfl
    letI : Algebra (Localization.AtPrime p) (Localization.AtPrime q) := φ_loc.toAlgebra
    have : IsLocalHom (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) := hLocal_φ
    have h_comp :
        (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)).comp
          (algebraMap R₀ (Localization.AtPrime p)) =
        algebraMap R₀ (Localization.AtPrime q) := by
      ext r
      exact Localization.localRingHom_to_map p q (algebraMap R₀ B) rfl r
    have : IsScalarTower R₀ (Localization.AtPrime p) (Localization.AtPrime q) :=
      IsScalarTower.of_algebraMap_eq' h_comp.symm
    have : Algebra.EssFiniteType R₀ B := Algebra.EssFiniteType.of_finiteType R₀ B
    have : Algebra.EssFiniteType R₀ (Localization.AtPrime q) :=
      Algebra.instEssFiniteTypeLocalization R₀ B q.primeCompl
    have hEFT_R0_Bq : (algebraMap R₀ (Localization.AtPrime q)).EssFiniteType :=
      RingHom.essFiniteType_algebraMap.mpr inferInstance
    have : Algebra.EssFiniteType (Localization.AtPrime p) (Localization.AtPrime q) :=
      RingHom.essFiniteType_algebraMap.mp
        (RingHom.EssFiniteType.of_comp (algebraMap R₀ (Localization.AtPrime p))
          (h_comp.symm ▸ hEFT_R0_Bq))
    have : Algebra.FormallyUnramified R₀ (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.instLocalization q.primeCompl
    have hFU_R0_Bq : (algebraMap R₀ (Localization.AtPrime q)).FormallyUnramified :=
      RingHom.formallyUnramified_algebraMap.mpr inferInstance
    have : Algebra.FormallyUnramified (Localization.AtPrime p) (Localization.AtPrime q) :=
      RingHom.formallyUnramified_algebraMap.mp
        (RingHom.FormallyUnramified.of_comp (h_comp.symm ▸ hFU_R0_Bq))
    have hMax_map :
        Ideal.map (algebraMap (Localization.AtPrime p) (Localization.AtPrime q))
          (IsLocalRing.maximalIdeal (Localization.AtPrime p)) =
        IsLocalRing.maximalIdeal (Localization.AtPrime q) :=
      Algebra.FormallyUnramified.map_maximalIdeal
    have hFlat_Bq : Module.Flat R₀ (Localization.AtPrime q) := Localization.flat B q.primeCompl
    have hTF_Bq : Module.IsTorsionFree R₀ (Localization.AtPrime q) := Module.Flat.isTorsionFree
    by_cases hp_bot : p = ⊥
    · have hm_Rp : IsLocalRing.maximalIdeal (Localization.AtPrime p) = ⊥ := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal]
        have hmap : ∀ I : Ideal R₀, I = ⊥ →
            Ideal.map (algebraMap R₀ (Localization.AtPrime p)) I = ⊥ := by
          rintro _ rfl
          exact Ideal.map_bot
        exact hmap p hp_bot
      have hm_Bq : IsLocalRing.maximalIdeal (Localization.AtPrime q) = ⊥ := by
        rw [← hMax_map, hm_Rp, Ideal.map_bot]
      have hField : IsField (Localization.AtPrime q) :=
        IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm_Bq
      letI : Field (Localization.AtPrime q) := hField.toField
      exact ⟨inferInstance, inferInstance⟩
    · have : IsDiscreteValuationRing (Localization.AtPrime p) :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain R₀ hp_bot
          (Localization.AtPrime p)
      have hNotField_Rp : ¬ IsField (Localization.AtPrime p) :=
        IsDiscreteValuationRing.not_isField (Localization.AtPrime p)
      let π : Localization.AtPrime p :=
        Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal (Localization.AtPrime p))
      have hπ_span : Ideal.span {π} = IsLocalRing.maximalIdeal (Localization.AtPrime p) :=
        Submodule.IsPrincipal.span_singleton_generator
          (IsLocalRing.maximalIdeal (Localization.AtPrime p))
      have hπ_ne : π ≠ 0 := by
        intro h0
        apply hNotField_Rp
        rw [IsLocalRing.isField_iff_maximalIdeal_eq, ← hπ_span, h0, Ideal.span_singleton_eq_bot]
      let t : Localization.AtPrime q :=
        algebraMap (Localization.AtPrime p) (Localization.AtPrime q) π
      have ht_span : Ideal.span {t} = IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
        rw [← hMax_map, ← hπ_span, Ideal.map_span, Set.image_singleton]
      obtain ⟨⟨r₀, s₀⟩, hπ_surj⟩ := IsLocalization.surj p.primeCompl π
      have hr₀_ne : r₀ ≠ 0 := by
        intro hr0
        have h0 : π * algebraMap R₀ (Localization.AtPrime p) s₀ = 0 := by
          simpa [hr0] using hπ_surj
        have hu_s0 : IsUnit (algebraMap R₀ (Localization.AtPrime p) s₀) :=
          IsLocalization.map_units (Localization.AtPrime p) s₀
        exact hπ_ne (hu_s0.mul_left_eq_zero.mp h0)
      have ht_surj :
          t * algebraMap R₀ (Localization.AtPrime q) s₀ =
            algebraMap R₀ (Localization.AtPrime q) r₀ := by
        have h := congrArg (algebraMap (Localization.AtPrime p) (Localization.AtPrime q)) hπ_surj
        simpa only [map_mul,
          IsScalarTower.algebraMap_apply R₀ (Localization.AtPrime p) (Localization.AtPrime q)]
          using h
      have ht_inj : ∀ z : Localization.AtPrime q, t * z = 0 → z = 0 := by
        intro z hz
        have hsmul : r₀ • z = 0 := by
          rw [Algebra.smul_def, ← ht_surj, mul_assoc,
            mul_comm (algebraMap R₀ (Localization.AtPrime q) s₀) z, ← mul_assoc, hz, zero_mul]
        exact (smul_eq_zero.mp hsmul).resolve_left hr₀_ne
      have ht_pow_inj : ∀ (n : ℕ) (z : Localization.AtPrime q), t ^ n * z = 0 → z = 0 := by
        intro n
        induction n with
        | zero =>
          intro z hz
          simpa using hz
        | succ n ih =>
          intro z hz
          rw [pow_succ', mul_assoc] at hz
          exact ih z (ht_inj _ hz)
      have hKrull : (⨅ n : ℕ, (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ^ n) = ⊥ :=
        Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal (Localization.AtPrime q))
          (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime q)).ne_top
      have hFactor : ∀ x : Localization.AtPrime q, x ≠ 0 →
          ∃ (a : ℕ) (u : Localization.AtPrime q), IsUnit u ∧ x = t ^ a * u := by
        intro x hx
        have hx_not_all : ∃ n : ℕ, x ∉ Ideal.span {t ^ n} := by
          by_contra h_all
          push Not at h_all
          have hx_iInf : x ∈ ⨅ n : ℕ, (IsLocalRing.maximalIdeal (Localization.AtPrime q)) ^ n := by
            rw [Ideal.mem_iInf]
            intro n
            rw [← ht_span, Ideal.span_singleton_pow]
            exact h_all n
          rw [hKrull, Ideal.mem_bot] at hx_iInf
          exact hx hx_iInf
        let m : ℕ := Nat.find hx_not_all
        have hm_spec : x ∉ Ideal.span {t ^ m} := Nat.find_spec hx_not_all
        have hm_ne_zero : m ≠ 0 := by
          intro hm0
          apply hm_spec
          rw [hm0, pow_zero, Ideal.span_singleton_one]
          trivial
        obtain ⟨a, ha_eq⟩ := Nat.exists_eq_succ_of_ne_zero hm_ne_zero
        have ha_lt : a < m := by omega
        have hx_in_a : x ∈ Ideal.span {t ^ a} := not_not.mp (Nat.find_min hx_not_all ha_lt)
        obtain ⟨u, rfl⟩ := Ideal.mem_span_singleton.mp hx_in_a
        have hu_not_mem : u ∉ IsLocalRing.maximalIdeal (Localization.AtPrime q) := by
          intro hu_mem
          rw [← ht_span, Ideal.mem_span_singleton] at hu_mem
          obtain ⟨w, rfl⟩ := hu_mem
          apply hm_spec
          rw [ha_eq, Ideal.mem_span_singleton]
          exact ⟨w, by rw [pow_succ]; ring⟩
        exact ⟨a, u, IsLocalRing.notMem_maximalIdeal.mp hu_not_mem, rfl⟩
      have : NoZeroDivisors (Localization.AtPrime q) :=
        ⟨by
          intro x y hxy
          by_contra h_not
          push Not at h_not
          obtain ⟨hx, hy⟩ := h_not
          obtain ⟨a, u, hu, rfl⟩ := hFactor x hx
          obtain ⟨b, v, hv, rfl⟩ := hFactor y hy
          have hprod : t ^ (a + b) * (u * v) = 0 := by
            calc
              t ^ (a + b) * (u * v) = (t ^ a * u) * (t ^ b * v) := by rw [pow_add]; ring
              _ = 0 := hxy
          exact (hu.mul hv).ne_zero (ht_pow_inj (a + b) (u * v) hprod)⟩
      have hDom_Bq : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _
      have hPID_Bq : IsPrincipalIdealRing (Localization.AtPrime q) :=
        ⟨fun I => by
          by_cases hI : I = ⊥
          · rw [hI]
            exact ⟨0, by simp⟩
          · obtain ⟨x₀, hx₀_mem, hx₀_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
            obtain ⟨a₀, u₀, hu₀, hx₀_eq⟩ := hFactor x₀ hx₀_ne
            have h_ex_pow : ∃ n : ℕ, t ^ n ∈ I := by
              refine ⟨a₀, ?_⟩
              obtain ⟨u_unit, rfl⟩ := hu₀
              have h1 : (↑u_unit⁻¹ : Localization.AtPrime q) * x₀ ∈ I := I.mul_mem_left _ hx₀_mem
              have h2 : (↑u_unit⁻¹ : Localization.AtPrime q) * x₀ = t ^ a₀ := by
                rw [hx₀_eq, mul_comm (t ^ a₀) _, ← mul_assoc, Units.inv_mul, one_mul]
              rwa [h2] at h1
            let k : ℕ := Nat.find h_ex_pow
            have hk_mem : t ^ k ∈ I := Nat.find_spec h_ex_pow
            refine ⟨t ^ k, le_antisymm ?_ (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hk_mem))⟩
            intro y hy
            by_cases hy0 : y = 0
            · rw [hy0]; exact Submodule.zero_mem _
            · obtain ⟨b, v, hv, rfl⟩ := hFactor y hy0
              obtain ⟨v_unit, rfl⟩ := hv
              have htb_mem : t ^ b ∈ I := by
                have h1 : (↑v_unit⁻¹ : Localization.AtPrime q) * (t ^ b * ↑v_unit) ∈ I :=
                  I.mul_mem_left _ hy
                have h2 : (↑v_unit⁻¹ : Localization.AtPrime q) * (t ^ b * ↑v_unit) = t ^ b := by
                  rw [mul_comm (t ^ b) _, ← mul_assoc, Units.inv_mul, one_mul]
                rwa [h2] at h1
              have hkb : k ≤ b := not_lt.mp (fun hlt => Nat.find_min h_ex_pow hlt htb_mem)
              rw [Submodule.mem_span_singleton]
              refine ⟨t ^ (b - k) * ↑v_unit, ?_⟩
              calc
                (t ^ (b - k) * ↑v_unit) • t ^ k
                  = (t ^ k * t ^ (b - k)) * ↑v_unit := by
                    rw [smul_eq_mul]; ring
                _ = t ^ b * ↑v_unit := by
                    rw [← pow_add, Nat.add_sub_of_le hkb]⟩
      exact ⟨hDom_Bq, hPID_Bq⟩
  have hDom_B : IsDomain B := by
    let p_ker : PrimeSpectrum B → Ideal B := fun x =>
      RingHom.ker (algebraMap B (Localization.AtPrime x.asIdeal))
    have hp_prime : ∀ x : PrimeSpectrum B, (p_ker x).IsPrime := fun x => by
      have : x.asIdeal.IsPrime := x.isPrime
      have : IsDomain (Localization.AtPrime x.asIdeal) := (hLoc x.asIdeal).1
      exact RingHom.ker_isPrime (algebraMap B (Localization.AtPrime x.asIdeal))
    have hp_le : ∀ x : PrimeSpectrum B, p_ker x ≤ x.asIdeal := by
      intro x b hb
      have : x.asIdeal.IsPrime := x.isPrime
      have : IsDomain (Localization.AtPrime x.asIdeal) := (hLoc x.asIdeal).1
      by_contra hnot
      have hu : IsUnit (algebraMap B (Localization.AtPrime x.asIdeal) b) :=
        IsLocalization.map_units (Localization.AtPrime x.asIdeal) (⟨b, hnot⟩ : ↥x.asIdeal.primeCompl)
      rw [RingHom.mem_ker.mp hb] at hu
      exact not_isUnit_zero hu
    have hAnn : ∀ x : PrimeSpectrum B, ∃ f : B, f ∉ x.asIdeal ∧ ∀ a ∈ p_ker x, f * a = 0 := by
      intro x
      have : x.asIdeal.IsPrime := x.isPrime
      obtain ⟨G, hG⟩ := Ideal.fg_of_isNoetherianRing (p_ker x)
      have hg_zero : ∀ g ∈ G, ∃ s : ↥x.asIdeal.primeCompl, (s : B) * g = 0 := by
        intro g hg
        have hg_mem : g ∈ p_ker x := hG ▸ Ideal.subset_span hg
        exact (IsLocalization.map_eq_zero_iff x.asIdeal.primeCompl
          (Localization.AtPrime x.asIdeal) g).mp (RingHom.mem_ker.mp hg_mem)
      let s_fn : { g // g ∈ G } → B := fun g => (Classical.choose (hg_zero g.1 g.2)).1
      let f : B := ∏ g ∈ G.attach, s_fn g
      have hf_not : f ∉ x.asIdeal := by
        intro hf_mem
        obtain ⟨g, _, hsg_mem⟩ := (Ideal.IsPrime.prod_mem_iff (p := x.asIdeal)).mp hf_mem
        exact (Classical.choose (hg_zero g.1 g.2)).2 hsg_mem
      refine ⟨f, hf_not, ?_⟩
      let Ann_f : Ideal B :=
        { carrier := { a : B | f * a = 0 }
          add_mem' := fun {a₁ a₂} ha₁ ha₂ => by
            change f * (a₁ + a₂) = 0
            change f * a₁ = 0 at ha₁
            change f * a₂ = 0 at ha₂
            rw [mul_add, ha₁, ha₂, add_zero]
          zero_mem' := by change f * 0 = 0; exact mul_zero f
          smul_mem' := fun c {a} ha => by
            change f * (c • a) = 0
            change f * a = 0 at ha
            rw [smul_eq_mul, ← mul_assoc, mul_comm f c, mul_assoc, ha, mul_zero] }
      have hle_ann : p_ker x ≤ Ann_f := by
        rw [← hG, Ideal.span_le]
        intro g hgG
        have hgG' : g ∈ G := Finset.mem_coe.mp hgG
        change f * g = 0
        obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem s_fn (Finset.mem_attach G ⟨g, hgG'⟩)
        have hsg0 : s_fn ⟨g, hgG'⟩ * g = 0 := Classical.choose_spec (hg_zero g hgG')
        dsimp only [f]
        rw [hc, mul_comm (s_fn ⟨g, hgG'⟩) c, mul_assoc, hsg0, mul_zero]
      intro a ha
      exact hle_ann ha
    let f_ann : PrimeSpectrum B → B := fun x => Classical.choose (hAnn x)
    have hf_not_mem : ∀ x : PrimeSpectrum B, f_ann x ∉ x.asIdeal :=
      fun x => (Classical.choose_spec (hAnn x)).1
    have hf_mul_zero : ∀ (x : PrimeSpectrum B), ∀ a ∈ p_ker x, f_ann x * a = 0 :=
      fun x => (Classical.choose_spec (hAnn x)).2
    have hp_eq_of_le : ∀ x y : PrimeSpectrum B, p_ker x ≤ y.asIdeal → p_ker x = p_ker y := by
      intro x y hxy
      have h_yx : p_ker y ≤ p_ker x := by
        intro b hb
        have h0 : f_ann y * b ∈ p_ker x := by
          rw [hf_mul_zero y b hb]
          exact (p_ker x).zero_mem
        rcases (hp_prime x).mem_or_mem h0 with hfy | hbx
        · exact False.elim (hf_not_mem y (hxy hfy))
        · exact hbx
      have h_xy : p_ker x ≤ p_ker y := by
        intro a ha
        have h0 : f_ann x * a ∈ p_ker y := by
          rw [hf_mul_zero x a ha]
          exact (p_ker y).zero_mem
        rcases (hp_prime y).mem_or_mem h0 with hfx | hay
        · exact False.elim (hf_not_mem x (hp_le x (h_yx hfx)))
        · exact hay
      exact le_antisymm h_xy h_yx
    obtain ⟨q₀⟩ : Nonempty (PrimeSpectrum B) := ConnectedSpace.toNonempty
    let Z₀ : Set (PrimeSpectrum B) := PrimeSpectrum.zeroLocus (p_ker q₀ : Set B)
    have hZ₀_closed : IsClosed Z₀ := PrimeSpectrum.isClosed_zeroLocus _
    have hZ₀_open : IsOpen Z₀ := by
      rw [isOpen_iff_forall_mem_open]
      intro y hy
      have hle_y : p_ker q₀ ≤ y.asIdeal := (PrimeSpectrum.mem_zeroLocus y _).mp hy
      have heq_y : p_ker q₀ = p_ker y := hp_eq_of_le q₀ y hle_y
      refine ⟨(PrimeSpectrum.basicOpen (f_ann y) : Set (PrimeSpectrum B)), ?_,
        (PrimeSpectrum.basicOpen (f_ann y)).isOpen,
        (PrimeSpectrum.mem_basicOpen (f_ann y) y).mpr (hf_not_mem y)⟩
      intro z hz
      have hfz : f_ann y ∉ z.asIdeal := (PrimeSpectrum.mem_basicOpen (f_ann y) z).mp hz
      rw [PrimeSpectrum.mem_zeroLocus]
      intro a ha
      have ha_y : a ∈ p_ker y := heq_y ▸ ha
      have h0 : f_ann y * a ∈ z.asIdeal := by
        rw [hf_mul_zero y a ha_y]
        exact z.asIdeal.zero_mem
      exact (z.isPrime.mem_or_mem h0).resolve_left hfz
    have hq₀_mem : q₀ ∈ Z₀ := (PrimeSpectrum.mem_zeroLocus q₀ _).mpr (hp_le q₀)
    have hZ₀_univ : Z₀ = Set.univ := by
      rcases isClopen_iff.mp ⟨hZ₀_closed, hZ₀_open⟩ with h_emp | h_univ
      · exact False.elim (Set.notMem_empty q₀ (h_emp ▸ hq₀_mem))
      · exact h_univ
    have hp_bot : p_ker q₀ = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro a ha
      let J : Ideal B :=
        { carrier := { s : B | s * a = 0 }
          add_mem' := fun {s₁ s₂} hs₁ hs₂ => by
            change (s₁ + s₂) * a = 0
            change s₁ * a = 0 at hs₁
            change s₂ * a = 0 at hs₂
            rw [add_mul, hs₁, hs₂, add_zero]
          zero_mem' := by change (0 : B) * a = 0; exact zero_mul a
          smul_mem' := fun c {s} hs => by
            change (c • s) * a = 0
            change s * a = 0 at hs
            rw [smul_eq_mul, mul_assoc, hs, mul_zero] }
      have hJ_top : J = ⊤ := by
        by_contra hJ_ne
        obtain ⟨m, hm_max, hJm⟩ := Ideal.exists_le_maximal J hJ_ne
        let y : PrimeSpectrum B := ⟨m, hm_max.isPrime⟩
        have hy_Z₀ : y ∈ Z₀ := by rw [hZ₀_univ]; trivial
        have heq_y : p_ker q₀ = p_ker y :=
          hp_eq_of_le q₀ y ((PrimeSpectrum.mem_zeroLocus y _).mp hy_Z₀)
        have hf_in_J : f_ann y ∈ J := hf_mul_zero y a (heq_y ▸ ha)
        exact hf_not_mem y (hJm hf_in_J)
      have h1 : (1 : B) ∈ J := by rw [hJ_top]; trivial
      have h1' : (1 : B) * a = 0 := h1
      simpa only [one_mul] using h1'
    have : q₀.asIdeal.IsPrime := q₀.isPrime
    have : IsDomain (Localization.AtPrime q₀.asIdeal) := (hLoc q₀.asIdeal).1
    have hinj : Function.Injective (algebraMap B (Localization.AtPrime q₀.asIdeal)) :=
      (RingHom.injective_iff_ker_eq_bot _).mpr hp_bot
    exact Function.Injective.isDomain (algebraMap B (Localization.AtPrime q₀.asIdeal)) hinj
  have hIC_B : IsIntegrallyClosed B := by
    apply IsIntegrallyClosed.of_localization_maximal
    intro p _ hp_max
    have : p.IsPrime := hp_max.isPrime
    have : IsDomain (Localization.AtPrime p) := (hLoc p).1
    have : IsPrincipalIdealRing (Localization.AtPrime p) := (hLoc p).2
    exact inferInstance
  have hDim_B : Ring.DimensionLEOne B := by
    refine Ring.DimensionLEOne.mk ?_
    intro q hq_ne hq_pr
    have : q.IsPrime := hq_pr
    obtain ⟨m, hm_max, hqm⟩ := Ideal.exists_le_maximal q hq_pr.ne_top
    have : m.IsMaximal := hm_max
    have : m.IsPrime := hm_max.isPrime
    have : IsDomain (Localization.AtPrime m) := (hLoc m).1
    have : IsPrincipalIdealRing (Localization.AtPrime m) := (hLoc m).2
    have hDim_Bm : Ring.DimensionLEOne (Localization.AtPrime m) :=
      Ring.DimensionLEOne.principal_ideal_ring (Localization.AtPrime m)
    let e_m := IsLocalization.AtPrime.orderIsoOfPrime (Localization.AtPrime m) m
    let Q := e_m.symm ⟨q, hq_pr, hqm⟩
    let M := e_m.symm ⟨m, hm_max.isPrime, le_rfl⟩
    have hm_nzd : m.primeCompl ≤ nonZeroDivisors B := by
      intro s hs
      rw [mem_nonZeroDivisors_iff_ne_zero]
      intro h0
      exact hs (h0 ▸ m.zero_mem)
    have hinj_Bm : Function.Injective (algebraMap B (Localization.AtPrime m)) :=
      IsLocalization.injective (Localization.AtPrime m) hm_nzd
    obtain ⟨x, hx_q, hx_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq_ne
    have hQ_comap : Ideal.comap (algebraMap B (Localization.AtPrime m)) Q.1 = q :=
      congrArg Subtype.val (e_m.apply_symm_apply ⟨q, hq_pr, hqm⟩)
    have hx_Q : algebraMap B (Localization.AtPrime m) x ∈ Q.1 := by
      change x ∈ Ideal.comap (algebraMap B (Localization.AtPrime m)) Q.1
      rwa [hQ_comap]
    have hQ_ne_bot : Q.1 ≠ ⊥ := by
      intro hbot
      rw [hbot, Ideal.mem_bot] at hx_Q
      exact hx_ne (hinj_Bm (hx_Q.trans (map_zero _).symm))
    have hQ_max : Q.1.IsMaximal := hDim_Bm.maximalOfPrime hQ_ne_bot Q.2
    have hQM_le : Q.1 ≤ M.1 := e_m.symm.monotone hqm
    have hQM_eq : Q = M := Subtype.ext (hQ_max.eq_of_le M.2.ne_top hQM_le)
    have hqm_eq : q = m := by
      have h := congrArg (fun z => (e_m z).1) hQM_eq
      simpa [Q, M] using h
    rwa [hqm_eq]
  have hDed_B : IsDedekindDomain B :=
    (isDedekindDomain_iff B (FractionRing B)).mpr
      ⟨hDom_B, hNoeth_B, hDim_B, fun hx => (isIntegrallyClosed_iff (FractionRing B)).mp hIC_B hx⟩
  have hInj_R0_B : Function.Injective (algebraMap R₀ B) := by
    have : Module.IsTorsionFree R₀ B := Module.Flat.isTorsionFree
    rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
    intro r hr
    rw [RingHom.mem_ker] at hr
    have hsmul : r • (1 : B) = 0 := by
      rw [Algebra.smul_def, hr, zero_mul]
    exact (smul_eq_zero.mp hsmul).resolve_right one_ne_zero
  refine ⟨hDom_B, hIC_B, hDed_B, hInj_R0_B, ?_⟩
  intro K₀ K _ _ _ _ _ _ _ _ _ _
  let E := TensorProduct R₀ K₀ B
  let Φ : E →ₐ[K₀] K :=
    Algebra.TensorProduct.lift (Algebra.ofId K₀ K) (IsScalarTower.toAlgHom R₀ B K)
      (fun _ _ => Commute.all _ _)
  have hΦ_one_tmul : ∀ b : B, Φ (TensorProduct.tmul R₀ (1 : K₀) b) = algebraMap B K b := by
    intro b
    change (Algebra.TensorProduct.lift (Algebra.ofId K₀ K) (IsScalarTower.toAlgHom R₀ B K)
      (fun _ _ => Commute.all _ _)) (TensorProduct.tmul R₀ (1 : K₀) b) = algebraMap B K b
    rw [Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, map_one, one_mul,
      IsScalarTower.coe_toAlgHom']
  have hClear : ∀ z : E, ∃ (s : nonZeroDivisors R₀) (b : B),
      (algebraMap R₀ K₀ s) • z = TensorProduct.tmul R₀ (1 : K₀) b := by
    intro z
    refine TensorProduct.inductionOn z ?_ ?_
    · intro x b₀
      obtain ⟨⟨r, s⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors R₀) x
      refine ⟨s, r • b₀, ?_⟩
      calc
        (algebraMap R₀ K₀ s) • TensorProduct.tmul R₀ x b₀
          = TensorProduct.tmul R₀ (algebraMap R₀ K₀ s * x) b₀ := by
            rw [TensorProduct.smul_tmul', smul_eq_mul]
        _ = TensorProduct.tmul R₀ (algebraMap R₀ K₀ r) b₀ := by
            rw [mul_comm, hsurj]
        _ = TensorProduct.tmul R₀ (r • (1 : K₀)) b₀ := by
            rw [Algebra.smul_def, mul_one]
        _ = TensorProduct.tmul R₀ (1 : K₀) (r • b₀) :=
            TensorProduct.smul_tmul r (1 : K₀) b₀
    · intro z₁ z₂ ⟨s₁, b₁, hz₁⟩ ⟨s₂, b₂, hz₂⟩
      refine ⟨s₁ * s₂, (s₂ : R₀) • b₁ + (s₁ : R₀) • b₂, ?_⟩
      have h1 : (algebraMap R₀ K₀ (s₁ * s₂ : nonZeroDivisors R₀)) • z₁ =
          TensorProduct.tmul R₀ (1 : K₀) ((s₂ : R₀) • b₁) := by
        change (algebraMap R₀ K₀ ((s₁ : R₀) * (s₂ : R₀))) • z₁ = _
        rw [map_mul, mul_comm, mul_smul, hz₁, TensorProduct.smul_tmul', smul_eq_mul,
          ← Algebra.smul_def, TensorProduct.smul_tmul]
      have h2 : (algebraMap R₀ K₀ (s₁ * s₂ : nonZeroDivisors R₀)) • z₂ =
          TensorProduct.tmul R₀ (1 : K₀) ((s₁ : R₀) • b₂) := by
        change (algebraMap R₀ K₀ ((s₁ : R₀) * (s₂ : R₀))) • z₂ = _
        rw [map_mul, mul_smul, hz₂, TensorProduct.smul_tmul', smul_eq_mul,
          ← Algebra.smul_def, TensorProduct.smul_tmul]
      rw [smul_add, h1, h2, ← TensorProduct.tmul_add]
  have hInj_Φ : Function.Injective Φ := by
    rw [← RingHom.coe_coe, RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
    intro z hz
    rw [RingHom.mem_ker] at hz
    change Φ z = 0 at hz
    obtain ⟨s, b, hsb⟩ := hClear z
    have hb_map : algebraMap B K b = 0 := by
      have hΦ_sb : Φ ((algebraMap R₀ K₀ s) • z) = Φ (TensorProduct.tmul R₀ (1 : K₀) b) :=
        congrArg Φ hsb
      rw [map_smul, hz, smul_zero, hΦ_one_tmul] at hΦ_sb
      exact hΦ_sb.symm
    have hb0 : b = 0 :=
      IsFractionRing.injective B K (hb_map.trans (map_zero _).symm)
    rw [hb0, TensorProduct.tmul_zero] at hsb
    have hs_ne : (s : R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
    have hs_K0 : algebraMap R₀ K₀ s ≠ 0 := fun h0 =>
      hs_ne (IsFractionRing.injective R₀ K₀ (h0.trans (map_zero _).symm))
    exact (smul_eq_zero.mp hsb).resolve_left hs_K0
  have : Algebra.Etale K₀ E := Algebra.Etale.baseChange R₀ B K₀
  obtain ⟨I, hFinI, Ai, instFieldAi, instAlgAi, e_prod, hAi⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod K₀ E).mp inferInstance
  letI := instFieldAi
  letI := instAlgAi
  have hDom_E : IsDomain E := Function.Injective.isDomain Φ hInj_Φ
  have hNonempty_I : Nonempty I := by
    by_contra hEmpty
    rw [not_nonempty_iff] at hEmpty
    have h01_pi : e_prod 0 = e_prod 1 := funext fun i => hEmpty.elim i
    exact zero_ne_one (e_prod.injective h01_pi)
  obtain ⟨i₀⟩ := hNonempty_I
  have hSub_I : ∀ i j : I, i = j := by
    intro i j
    by_contra hij
    let u : ∀ k : I, Ai k := fun k => if k = i then 1 else 0
    let v : ∀ k : I, Ai k := fun k => if k = j then 1 else 0
    have huv : u * v = 0 := by
      funext k
      change u k * v k = 0
      dsimp only [u, v]
      split_ifs with hki hkj
      · exact False.elim (hij (hki ▸ hkj))
      · exact mul_zero _
      · exact zero_mul _
      · exact zero_mul _
    have hu_ne : u ≠ 0 := by
      intro hu0
      have h : u i = (0 : ∀ k : I, Ai k) i := congrFun hu0 i
      simp only [u, ↓reduceIte, Pi.zero_apply] at h
      exact one_ne_zero h
    have hv_ne : v ≠ 0 := by
      intro hv0
      have h : v j = (0 : ∀ k : I, Ai k) j := congrFun hv0 j
      simp only [v, ↓reduceIte, Pi.zero_apply] at h
      exact one_ne_zero h
    obtain ⟨u₀, hu₀⟩ := e_prod.surjective u
    obtain ⟨v₀, hv₀⟩ := e_prod.surjective v
    have huv₀ : u₀ * v₀ = 0 := by
      apply e_prod.injective
      rw [map_mul, hu₀, hv₀, huv, map_zero]
    rcases eq_zero_or_eq_zero_of_mul_eq_zero huv₀ with h1 | h2
    · apply hu_ne
      rw [← hu₀, h1, map_zero]
    · apply hv_ne
      rw [← hv₀, h2, map_zero]
  let ev_i₀ : (∀ i : I, Ai i) ≃ₐ[K₀] Ai i₀ :=
    { toFun := fun f => f i₀
      invFun := fun a i => hSub_I i₀ i ▸ a
      left_inv := fun f => by
        funext i
        cases hSub_I i₀ i
        rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl
      commutes' := fun _ => rfl }
  let e_L : E ≃ₐ[K₀] Ai i₀ := e_prod.trans ev_i₀
  have hSurj_Φ : Function.Surjective Φ := by
    intro y
    obtain ⟨⟨b₁, b₂⟩, hy_surj⟩ := IsLocalization.surj (nonZeroDivisors B) y
    have hb₂_ne : (b₂ : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b₂.2
    have hb₂_K : algebraMap B K b₂ ≠ 0 := fun h0 =>
      hb₂_ne (IsFractionRing.injective B K (h0.trans (map_zero _).symm))
    have hΦ_b₂ : Φ (TensorProduct.tmul R₀ (1 : K₀) (b₂ : B)) = algebraMap B K b₂ :=
      hΦ_one_tmul (b₂ : B)
    have hΦ_b₁ : Φ (TensorProduct.tmul R₀ (1 : K₀) b₁) = algebraMap B K b₁ :=
      hΦ_one_tmul b₁
    have heL_ne : e_L (TensorProduct.tmul R₀ (1 : K₀) (b₂ : B)) ≠ 0 := by
      intro h0
      have htmul0 : TensorProduct.tmul R₀ (1 : K₀) (b₂ : B) = 0 :=
        e_L.injective (h0.trans (map_zero e_L).symm)
      rw [htmul0, map_zero] at hΦ_b₂
      exact hb₂_K hΦ_b₂.symm
    let w : E := e_L.symm ((e_L (TensorProduct.tmul R₀ (1 : K₀) (b₂ : B)))⁻¹)
    have hw_mul : TensorProduct.tmul R₀ (1 : K₀) (b₂ : B) * w = 1 := by
      apply e_L.injective
      rw [map_mul, map_one]
      dsimp only [w]
      rw [e_L.apply_symm_apply, mul_inv_cancel₀ heL_ne]
    refine ⟨TensorProduct.tmul R₀ (1 : K₀) b₁ * w, ?_⟩
    apply mul_right_cancel₀ hb₂_K
    calc
      Φ (TensorProduct.tmul R₀ (1 : K₀) b₁ * w) * algebraMap B K b₂
        = Φ (TensorProduct.tmul R₀ (1 : K₀) b₁) *
            (Φ w * Φ (TensorProduct.tmul R₀ (1 : K₀) (b₂ : B))) := by
          rw [map_mul, hΦ_b₂, mul_assoc]
      _ = Φ (TensorProduct.tmul R₀ (1 : K₀) b₁) *
            Φ (TensorProduct.tmul R₀ (1 : K₀) (b₂ : B) * w) := by
          rw [map_mul, mul_comm (Φ w)]
      _ = algebraMap B K b₁ := by
          rw [hw_mul, map_one, mul_one, hΦ_b₁]
      _ = y * algebraMap B K b₂ := hy_surj.symm
  let e_K : K ≃ₐ[K₀] Ai i₀ := (AlgEquiv.ofBijective Φ ⟨hInj_Φ, hSurj_Φ⟩).symm.trans e_L
  have : Module.Finite K₀ (Ai i₀) := (hAi i₀).1
  have : Algebra.IsSeparable K₀ (Ai i₀) := (hAi i₀).2
  have hFinDim : FiniteDimensional K₀ K := Module.Finite.equiv e_K.symm.toLinearEquiv
  have hSep : Algebra.IsSeparable K₀ K := Algebra.IsSeparable.of_algHom K₀ (Ai i₀) e_K.toAlgHom
  have hPos : 1 ≤ Module.finrank K₀ K := Module.finrank_pos
  exact ⟨hFinDim, hSep, hPos⟩

theorem weil_dedekind_atlas_generic_normalization_package (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] [QuasiSeparatedSpace ↥Z]
    (hDedCover : ∀ y : ↥Z, ∃ W : Z.Opens,
      y ∈ W ∧ AlgebraicGeometry.IsAffineOpen W ∧
        IsDedekindDomain ↑(Z.presheaf.obj (Opposite.op W)))
    (hNonGen : ∀ (W : Z.Opens), AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) → ∃ z : ↥W, z.1 ≠ genericPoint ↥Z)
    (K : Type u) [Field K]
    (ξ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of K)) Z)
    [AlgebraicGeometry.QuasiCompact ξ] [AlgebraicGeometry.QuasiSeparated ξ]
    (ψ_K : ↑Z.functionField →+* K)
    (hFinDim : @FiniteDimensional ↑Z.functionField K _ _ ψ_K.toAlgebra.toModule)
    (hSep : @Algebra.IsSeparable ↑Z.functionField K _ _ ψ_K.toAlgebra)
    (hξ_gen : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)), ξ.base pt = genericPoint ↥Z)
    (hξ_app : ∀ (W : Z.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})]
      (he : ⊤ ≤ (TopologicalSpace.Opens.map ξ.base).obj W),
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE ξ W ⊤ he)
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom =
        ψ_K.comp (Z.germToFunctionField W).hom) :
    let Y := AlgebraicGeometry.Scheme.Hom.normalization ξ
    let u_bar : Quiver.Hom Y Z := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
    AlgebraicGeometry.IsIntegral Y ∧
    AlgebraicGeometry.IsFinite u_bar ∧
    AlgebraicGeometry.Surjective u_bar ∧
    ∀ (W : Z.Opens), AlgebraicGeometry.IsAffineOpen W →
      ∀ [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})],
        IsDedekindDomain ↑(Z.presheaf.obj (Opposite.op W)) →
        let A_W := ↑(Z.presheaf.obj (Opposite.op W))
        let W' : Y.Opens := (TopologicalSpace.Opens.map u_bar.base).obj W
        let B_W := ↑(Y.presheaf.obj (Opposite.op W'))
        AlgebraicGeometry.IsAffineOpen W' ∧
        IsDomain B_W ∧
        IsIntegrallyClosed B_W ∧
        IsDedekindDomain B_W ∧
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app u_bar W)).Finite ∧
        ringKrullDim B_W = (1 : WithBot ℕ∞) ∧
        ∃ (ι_K : B_W →+* K),
          Function.Injective ι_K ∧
          ι_K.comp (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app u_bar W)) =
            ψ_K.comp (Z.germToFunctionField W).hom ∧
          @IsFractionRing B_W _ K _ ι_K.toAlgebra ∧
          ∀ x : K, (ψ_K.comp (Z.germToFunctionField W).hom).IsIntegralElem x →
            ∃ b : B_W, ι_K b = x :=
by
  classical
  let X₀ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of K)
  let K₀ : Type u := ↑Z.functionField
  let Y : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Scheme.Hom.normalization ξ
  let u_bar : Y ⟶ Z := AlgebraicGeometry.Scheme.Hom.fromNormalization ξ
  let η_to : X₀ ⟶ Y := AlgebraicGeometry.Scheme.Hom.toNormalization ξ
  haveI hIntHom : AlgebraicGeometry.IsIntegralHom u_bar :=
    AlgebraicGeometry.Scheme.Hom.instIsIntegralHomFromNormalization ξ
  haveI hAffHom : AlgebraicGeometry.IsAffineHom u_bar := inferInstance
  haveI hIrred_Z : IrreducibleSpace ↥Z := inferInstance
  haveI hT0_Z : T0Space ↥Z := inferInstance
  have hη_ubar : η_to ≫ u_bar = ξ :=
    AlgebraicGeometry.Scheme.Hom.toNormalization_fromNormalization ξ

  have hChart : ∀ (W : Z.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})],
      IsDedekindDomain ↑(Z.presheaf.obj (Opposite.op W)) →
      let W' : Y.Opens := (TopologicalSpace.Opens.map u_bar.base).obj W
      let B_W := ↑(Y.presheaf.obj (Opposite.op W'))
      (∃ hW' : AlgebraicGeometry.IsAffineOpen W',
        ∀ pt : ↥X₀, ∃ hy₀ : η_to.base pt ∈ W',
          (hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩).asIdeal = ⊥) ∧
      (AlgebraicGeometry.IsAffineOpen W' ∧
        IsDomain B_W ∧
        IsIntegrallyClosed B_W ∧
        IsDedekindDomain B_W ∧
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app u_bar W)).Finite ∧
        ringKrullDim B_W = (1 : WithBot ℕ∞) ∧
        ∃ (ι_K : B_W →+* K),
          Function.Injective ι_K ∧
          ι_K.comp (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app u_bar W)) =
            ψ_K.comp (Z.germToFunctionField W).hom ∧
          @IsFractionRing B_W _ K _ ι_K.toAlgebra ∧
          ∀ x : K, (ψ_K.comp (Z.germToFunctionField W).hom).IsIntegralElem x →
            ∃ b : B_W, ι_K b = x) := by
    intro W hW hNeW hDedW
    dsimp only
    let A_W_cat : CommRingCat.{u} := Z.presheaf.obj (Opposite.op W)
    let A_W : Type u := ↑A_W_cat
    let W' : Y.Opens := (TopologicalSpace.Opens.map u_bar.base).obj W
    let B_W_cat : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W')
    let B_W : Type u := ↑B_W_cat
    have hW' : AlgebraicGeometry.IsAffineOpen W' :=
      (AlgebraicGeometry.isAffineHom_iff u_bar).mp hAffHom W hW
    have hgen_W : genericPoint ↥Z ∈ W := by
      obtain ⟨w₀⟩ := hNeW
      exact ((genericPoint_spec ↥Z).mem_open_set_iff W.isOpen).mpr ⟨w₀.1, trivial, w₀.2⟩
    have he_W : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map ξ.base).obj W := by
      intro pt _
      change ξ.base pt ∈ W
      rw [hξ_gen pt]
      exact hgen_W
    have hξW_top : (TopologicalSpace.Opens.map ξ.base).obj W = ⊤ := top_unique he_W

    let U_ξ : X₀.Opens := (TopologicalSpace.Opens.map ξ.base).obj W
    let S_W_cat : CommRingCat.{u} := X₀.presheaf.obj (Opposite.op U_ξ)
    let S_W : Type u := ↑S_W_cat
    letI alg_AW_SW : Algebra A_W S_W := (ξ.app W).hom.toAlgebra
    letI alg_AW_K : Algebra A_W K := (ψ_K.comp (Z.germToFunctionField W).hom).toAlgebra
    let e_K_cat : S_W_cat ≅ CommRingCat.of K :=
      X₀.presheaf.mapIso (CategoryTheory.eqToIso hξW_top.symm).op ≪≫
        AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)
    have h_eK_comp : (ξ.app W ≫ e_K_cat.hom).hom =
        ψ_K.comp (Z.germToFunctionField W).hom := by
      have h_hom_eq : (CategoryTheory.eqToIso hξW_top.symm).op.hom =
          (CategoryTheory.homOfLE he_W).op :=
        congrArg Opposite.op (Subsingleton.elim _ _)
      have h_cat : ξ.app W ≫ e_K_cat.hom =
          ξ.appLE W ⊤ he_W ≫ (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).hom := by
        dsimp only [e_K_cat, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom]
        rw [h_hom_eq, ← CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Scheme.Hom.appLE_eq_app ξ,
          AlgebraicGeometry.Scheme.Hom.appLE_map]
      rw [h_cat]
      exact hξ_app W he_W
    let e_K_ring : S_W ≃+* K := e_K_cat.commRingCatIsoToRingEquiv
    let α_W : S_W ≃ₐ[A_W] K :=
      AlgEquiv.ofRingEquiv (f := e_K_ring) (fun a => by
        change (ξ.app W ≫ e_K_cat.hom).hom a = (ψ_K.comp (Z.germToFunctionField W).hom) a
        exact DFunLike.congr_fun h_eK_comp a)
    let β_W : ↥(integralClosure A_W S_W) ≃ₐ[A_W] ↥(integralClosure A_W K) :=
      AlgEquiv.mapIntegralClosure α_W
    let ν_W : B_W_cat ≅ CommRingCat.of ↥(integralClosure A_W S_W) :=
      AlgebraicGeometry.Scheme.Hom.normalizationObjIso ξ hW
    let e_W : B_W ≃+* ↥(integralClosure A_W K) :=
      ν_W.commRingCatIsoToRingEquiv.trans β_W.toRingEquiv
    let ι_K : B_W →+* K := (integralClosure A_W K).val.toRingHom.comp e_W.toRingHom

    have hInj_ιK : Function.Injective ι_K :=
      fun b₁ b₂ hb => e_W.injective (Subtype.ext hb)
    have hComp_ιK : ι_K.comp (u_bar.app W).hom = ψ_K.comp (Z.germToFunctionField W).hom := by
      have h_from : u_bar.app W ≫ ν_W.hom =
          CommRingCat.ofHom (algebraMap A_W ↥(integralClosure A_W S_W)) := by
        rw [AlgebraicGeometry.Scheme.Hom.fromNormalization_app ξ hW,
          CategoryTheory.Category.assoc, ν_W.inv_hom_id, CategoryTheory.Category.comp_id]
      ext a
      have h1 : ν_W.commRingCatIsoToRingEquiv ((u_bar.app W).hom a) =
          algebraMap A_W ↥(integralClosure A_W S_W) a :=
        DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h_from) a
      change (β_W (ν_W.commRingCatIsoToRingEquiv ((u_bar.app W).hom a))).1 =
        algebraMap A_W K a
      rw [h1, β_W.commutes a]
      rfl
    have hInt_iff : ∀ x : K, _root_.IsIntegral A_W x ↔ ∃ b : B_W, ι_K b = x := by
      intro x
      constructor
      · intro hx
        have hx' : x ∈ integralClosure A_W K := (mem_integralClosure_iff A_W K).mpr hx
        refine ⟨e_W.symm ⟨x, hx'⟩, ?_⟩
        exact congrArg Subtype.val (e_W.apply_symm_apply ⟨x, hx'⟩)
      · rintro ⟨b, rfl⟩
        exact (mem_integralClosure_iff A_W K).mp (e_W b).2

    have hBot_fiber : ∀ pt : ↥X₀, ∃ hy₀ : η_to.base pt ∈ W',
        (hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩).asIdeal = ⊥ := by
      have he_η : (⊤ : X₀.Opens) ≤ (TopologicalSpace.Opens.map η_to.base).obj W' := by
        intro pt' _
        change u_bar.base (η_to.base pt') ∈ W
        rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hη_ubar, hξ_gen pt']
        exact hgen_W
      have hηW'_top : (TopologicalSpace.Opens.map η_to.base).obj W' = ⊤ := top_unique he_η
      have hInj_appLE_η : Function.Injective (η_to.appLE W' ⊤ he_η).hom := by
        have happLE_η : η_to.appLE W' ⊤ he_η =
            η_to.app W' ≫ X₀.presheaf.map (CategoryTheory.homOfLE he_η).op := by
          rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app η_to,
            AlgebraicGeometry.Scheme.Hom.appLE_map]
        have h_to := AlgebraicGeometry.Scheme.Hom.toNormalization_app_preimage ξ ⟨W, hW⟩
        change η_to.app W' = _ at h_to
        rw [happLE_η, h_to]
        have h_iso_res : CategoryTheory.homOfLE he_η = (CategoryTheory.eqToIso hηW'_top).inv :=
          Subsingleton.elim _ _
        haveI : CategoryTheory.IsIso (CategoryTheory.homOfLE he_η) := by
          rw [h_iso_res]
          infer_instance
        intro b₁ b₂ hb
        have hm_res : ∀ {U₁ U₂ : (X₀.Opens)ᵒᵖ} (g : U₁ ⟶ U₂) [CategoryTheory.IsIso g],
            Function.Injective (X₀.presheaf.map g).hom :=
          fun g _ => (CategoryTheory.asIso (X₀.presheaf.map g)).commRingCatIsoToRingEquiv.injective
        have hb1 := hm_res (CategoryTheory.homOfLE he_η).op hb
        have hb2 := hm_res _ hb1
        have hb3 : ν_W.hom.hom b₁ = ν_W.hom.hom b₂ := Subtype.ext hb2
        exact ν_W.commRingCatIsoToRingEquiv.injective hb3
      have hSpec_η : AlgebraicGeometry.Spec.map (η_to.appLE W' ⊤ he_η) ≫ hW'.fromSpec =
          X₀.isoSpec.inv ≫ η_to := by
        rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_top (X := X₀)]
        exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec η_to hW'
          (AlgebraicGeometry.isAffineOpen_top X₀) he_η
      let e_top : ↑(X₀.presheaf.obj (Opposite.op ⊤)) ≃+* K :=
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv
      intro pt
      have hy₀ : η_to.base pt ∈ W' := he_η trivial
      refine ⟨hy₀, ?_⟩
      let q₀ : PrimeSpectrum ↑(X₀.presheaf.obj (Opposite.op ⊤)) := X₀.isoSpec.hom.base pt
      have hq₀_bot : q₀.asIdeal = ⊥ := by
        rw [Submodule.eq_bot_iff]
        intro r hr
        by_contra hr0
        have he_ne : e_top r ≠ 0 :=
          fun h0 => hr0 (e_top.injective (h0.trans e_top.map_zero.symm))
        have hu : IsUnit r := by
          refine ⟨⟨r, e_top.symm (e_top r)⁻¹, ?_, ?_⟩, rfl⟩
          · apply e_top.injective
            rw [map_mul, e_top.apply_symm_apply, mul_inv_cancel₀ he_ne, map_one]
          · apply e_top.injective
            rw [map_mul, e_top.apply_symm_apply, inv_mul_cancel₀ he_ne, map_one]
        exact q₀.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem q₀.asIdeal hr hu)
      let p_B : PrimeSpectrum B_W :=
        (AlgebraicGeometry.Spec.map (η_to.appLE W' ⊤ he_η)).base q₀
      have hp_B_bot : p_B.asIdeal = ⊥ := by
        change (PrimeSpectrum.comap (η_to.appLE W' ⊤ he_η).hom q₀).asIdeal = ⊥
        rw [PrimeSpectrum.comap_asIdeal, hq₀_bot, Submodule.eq_bot_iff]
        intro b hb
        have hb0 : (η_to.appLE W' ⊤ he_η).hom b = 0 := hb
        exact hInj_appLE_η (hb0.trans (map_zero _).symm)
      have hbase_eq : hW'.fromSpec.base p_B =
          hW'.fromSpec.base (hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩) := by
        have h1 : hW'.fromSpec.base p_B = (X₀.isoSpec.inv ≫ η_to).base q₀ :=
          congrArg (fun f : AlgebraicGeometry.Spec (X₀.presheaf.obj (Opposite.op ⊤)) ⟶ Y =>
            f.base q₀) hSpec_η
        have h2 : (X₀.isoSpec.inv ≫ η_to).base q₀ = η_to.base pt := by
          change η_to.base (X₀.isoSpec.inv.base (X₀.isoSpec.hom.base pt)) = η_to.base pt
          congr 1
          exact congrArg (fun f : X₀ ⟶ X₀ => f.base pt) X₀.isoSpec.hom_inv_id
        exact h1.trans (h2.trans (hW'.fromSpec_primeIdealOf ⟨η_to.base pt, hy₀⟩).symm)
      have hp_eq : hW'.primeIdealOf ⟨η_to.base pt, hy₀⟩ = p_B :=
        hW'.fromSpec.isOpenEmbedding.injective hbase_eq.symm
      rw [hp_eq]
      exact hp_B_bot

    letI : IsDedekindDomain A_W := hDedW
    letI alg_AW_K0 : Algebra A_W K₀ := (Z.germToFunctionField W).hom.toAlgebra
    haveI hFrac_AW_K0 : IsFractionRing A_W K₀ :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen Z W hW
    letI alg_K0_K : Algebra K₀ K := ψ_K.toAlgebra
    haveI : FiniteDimensional K₀ K := hFinDim
    haveI : Algebra.IsSeparable K₀ K := hSep
    haveI : IsScalarTower A_W K₀ K := IsScalarTower.of_algebraMap_eq' rfl
    letI alg_AW_BW : Algebra A_W B_W := (u_bar.app W).hom.toAlgebra
    letI alg_BW_K : Algebra B_W K := ι_K.toAlgebra
    haveI : IsScalarTower A_W B_W K := IsScalarTower.of_algebraMap_eq' hComp_ιK.symm
    haveI hICl_BW : IsIntegralClosure B_W A_W K :=
      IsIntegralClosure.mk hInj_ιK (fun {x} => hInt_iff x)
    haveI hDom_BW : IsDomain B_W := Function.Injective.isDomain ι_K hInj_ιK
    haveI hDed_BW : IsDedekindDomain B_W :=
      IsIntegralClosure.isDedekindDomain A_W K₀ K B_W
    haveI hIC_BW : IsIntegrallyClosed B_W := inferInstance
    haveI hModFin_BW : Module.Finite A_W B_W :=
      IsIntegralClosure.finite A_W K₀ K B_W
    have hHomFin_W : (u_bar.app W).hom.Finite :=
      RingHom.finite_algebraMap.mpr hModFin_BW
    have hFrac_BW_K : @IsFractionRing B_W _ K _ ι_K.toAlgebra :=
      IsIntegralClosure.isFractionRing_of_finite_extension A_W K₀ K B_W

    obtain ⟨z, hz_ne⟩ := hNonGen W hW hNeW
    let q_z := hW.primeIdealOf z
    have hqz_ne_bot : q_z.asIdeal ≠ ⊥ := by
      intro h_bot
      apply hz_ne
      have hGen_z : IsGenericPoint z.1 Set.univ := by
        rw [isGenericPoint_def]
        apply Set.eq_univ_of_forall
        intro p
        rw [mem_closure_iff]
        intro G hG hpG
        obtain ⟨w₁, -, hw₁G, hw₁W⟩ :=
          PreirreducibleSpace.isPreirreducible_univ G (W : Set ↥Z) hG W.isOpen
            ⟨p, trivial, hpG⟩ ⟨z.1, trivial, z.2⟩
        rw [← hW.range_fromSpec] at hw₁W
        obtain ⟨r₁, rfl⟩ := hw₁W
        have h_le : q_z.asIdeal ≤ r₁.asIdeal := h_bot ▸ bot_le
        have hr₁_cl : r₁ ∈ closure ({q_z} : Set _) :=
          (PrimeSpectrum.le_iff_mem_closure q_z r₁).mp h_le
        have hOpen_O : IsOpen (hW.fromSpec.base ⁻¹' G) :=
          hW.fromSpec.continuous.isOpen_preimage G hG
        obtain ⟨w_spec, hqz_O, hqz_sing⟩ :=
          mem_closure_iff.mp hr₁_cl (hW.fromSpec.base ⁻¹' G) hOpen_O hw₁G
        have hqz_eq : w_spec = q_z := Set.mem_singleton_iff.mp hqz_sing
        have hqz_G : hW.fromSpec.base q_z ∈ G := hqz_eq ▸ hqz_O
        have hz_G : z.1 ∈ G := (hW.fromSpec_primeIdealOf z) ▸ hqz_G
        exact ⟨z.1, hz_G, rfl⟩
      exact hGen_z.eq (genericPoint_spec ↥Z)

    have hInj_φW : Function.Injective (algebraMap A_W B_W) := by
      intro a₁ a₂ ha
      have h1 : (ψ_K.comp (Z.germToFunctionField W).hom) a₁ =
          (ψ_K.comp (Z.germToFunctionField W).hom) a₂ := by
        rw [← hComp_ιK]
        exact congrArg ι_K ha
      exact AlgebraicGeometry.Scheme.germToFunctionField_injective Z W (ψ_K.injective h1)
    have h_under_bot : Ideal.under A_W (⊥ : Ideal B_W) ≤ q_z.asIdeal := by
      intro a ha
      have ha0 : algebraMap A_W B_W a = 0 := ha
      rw [hInj_φW (ha0.trans (map_zero _).symm)]
      exact q_z.asIdeal.zero_mem
    haveI : Algebra.IsIntegral A_W B_W := Algebra.IsIntegral.of_finite A_W B_W
    obtain ⟨P_B, _, hPB_prime, hPB_under⟩ :=
      Ideal.exists_ideal_over_prime_of_isIntegral q_z.asIdeal (⊥ : Ideal B_W) h_under_bot
    have hPB_ne_bot : P_B ≠ ⊥ := by
      intro hPB_bot
      apply hqz_ne_bot
      rw [← hPB_under, hPB_bot, Submodule.eq_bot_iff]
      intro a ha
      have ha0 : algebraMap A_W B_W a = 0 := ha
      exact hInj_φW (ha0.trans (map_zero _).symm)
    have hDim_le : ringKrullDim B_W ≤ (1 : WithBot ℕ∞) :=
      Ring.krullDimLE_iff.mp (inferInstance : Ring.KrullDimLE 1 B_W)
    have hDim_ge : (1 : WithBot ℕ∞) ≤ ringKrullDim B_W := by
      have h_bot_prime : (⊥ : Ideal B_W).IsPrime :=
        ⟨bot_ne_top, fun {a b} hab => by
          rw [Ideal.mem_bot] at hab ⊢
          rw [Ideal.mem_bot]
          exact mul_eq_zero.mp hab⟩
      let x₀ : PrimeSpectrum B_W := ⟨⊥, h_bot_prime⟩
      let x₁ : PrimeSpectrum B_W := ⟨P_B, hPB_prime⟩
      have hx_lt : x₀ < x₁ :=
        lt_of_le_of_ne bot_le (fun hEq => hPB_ne_bot (congrArg PrimeSpectrum.asIdeal hEq).symm)
      let l : LTSeries (PrimeSpectrum B_W) :=
        RelSeries.mk 1 ![x₀, x₁] (fun i => by
          match i with
          | ⟨0, _⟩ => exact hx_lt)
      exact (Order.le_krullDim_iff (α := PrimeSpectrum B_W) (n := 1)).mpr ⟨l, rfl⟩
    have hKrull_BW : ringKrullDim B_W = (1 : WithBot ℕ∞) := le_antisymm hDim_le hDim_ge

    exact ⟨⟨hW', hBot_fiber⟩, hW', hDom_BW, hIC_BW, hDed_BW, hHomFin_W, hKrull_BW,
      ⟨ι_K, hInj_ιK, hComp_ιK, hFrac_BW_K, fun x hx => (hInt_iff x).mp hx⟩⟩

  let W_cov : ↥Z → Z.Opens := fun y => Classical.choose (hDedCover y)
  have hy_cov : ∀ y : ↥Z, y ∈ W_cov y := fun y => (Classical.choose_spec (hDedCover y)).1
  have hAff_cov : ∀ y : ↥Z, AlgebraicGeometry.IsAffineOpen (W_cov y) :=
    fun y => (Classical.choose_spec (hDedCover y)).2.1
  have hDed_cov : ∀ y : ↥Z, IsDedekindDomain ↑(Z.presheaf.obj (Opposite.op (W_cov y))) :=
    fun y => (Classical.choose_spec (hDedCover y)).2.2
  haveI hNe_cov : ∀ y : ↥Z, Nonempty ↥(W_cov y : AlgebraicGeometry.Scheme.{u}) :=
    fun y => ⟨⟨y, hy_cov y⟩⟩
  let W'_cov : ↥Z → Y.Opens := fun y => (TopologicalSpace.Opens.map u_bar.base).obj (W_cov y)
  have hW'_cov : ∀ y : ↥Z, AlgebraicGeometry.IsAffineOpen (W'_cov y) :=
    fun y => (hChart (W_cov y) (hAff_cov y) (hDed_cov y)).2.1
  have hDom_cov : ∀ y : ↥Z, IsDomain ↑(Y.presheaf.obj (Opposite.op (W'_cov y))) :=
    fun y => (hChart (W_cov y) (hAff_cov y) (hDed_cov y)).2.2.1
  have hFin_cov : ∀ y : ↥Z, (u_bar.app (W_cov y)).hom.Finite :=
    fun y => (hChart (W_cov y) (hAff_cov y) (hDed_cov y)).2.2.2.2.2.1

  have hFin_ubar : AlgebraicGeometry.IsFinite u_bar := by
    rw [AlgebraicGeometry.IsFinite.iff_isIntegralHom_and_locallyOfFiniteType]
    refine ⟨hIntHom, ?_⟩
    have hSup_W' : (⨆ y : ↥Z, W'_cov y) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨u_bar.base x, hy_cov (u_bar.base x)⟩
    haveI : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.LocallyOfFiniteType.{u}) :=
      AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource
    refine AlgebraicGeometry.IsZariskiLocalAtSource.of_iSup_eq_top W'_cov hSup_W' (fun y => ?_)
    have h_ι_ubar : (W'_cov y).ι ≫ u_bar =
        (hW'_cov y).isoSpec.hom ≫
          AlgebraicGeometry.Spec.map (u_bar.app (W_cov y)) ≫ (hAff_cov y).fromSpec := by
      rw [← (hW'_cov y).isoSpec_hom_fromSpec, CategoryTheory.Category.assoc]
      congr 1
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app u_bar]
      exact (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec u_bar
        (hAff_cov y) (hW'_cov y) le_rfl).symm
    have hFT_map : AlgebraicGeometry.LocallyOfFiniteType
        (AlgebraicGeometry.Spec.map (u_bar.app (W_cov y))) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr (hFin_cov y).to_finiteType
    rw [h_ι_ubar]
    infer_instance

  let 𝒰 : Y.OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
      (↥Z) (fun y => AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op (W'_cov y))))
      (fun y => (hW'_cov y).fromSpec)
      (fun x => by
        let y := u_bar.base x
        have hx : x ∈ (W'_cov y : Set ↥Y) := hy_cov y
        rw [← (hW'_cov y).range_fromSpec] at hx
        obtain ⟨p, hp⟩ := hx
        exact ⟨y, p, hp⟩)
      (fun y => inferInstance)
  haveI hRed_Y : AlgebraicGeometry.IsReduced Y :=
    @AlgebraicGeometry.IsReduced.of_openCover Y 𝒰 (fun y => by
      haveI : IsDomain ↑(Y.presheaf.obj (Opposite.op (W'_cov y))) := hDom_cov y
      exact (inferInstance : AlgebraicGeometry.IsReduced
        (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op (W'_cov y))))))

  let pt_K : ↥X₀ := IsLocalRing.closedPoint K
  let y₀ : ↥Y := η_to.base pt_K
  have hy₀_gen : u_bar.base y₀ = genericPoint ↥Z := by
    change u_bar.base (η_to.base pt_K) = genericPoint ↥Z
    rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hη_ubar]
    exact hξ_gen pt_K
  have hy₀_in_open : ∀ (G : Set ↥Y), IsOpen G → G.Nonempty → y₀ ∈ G := by
    intro G hG ⟨x, hxG⟩
    let y := u_bar.base x
    have hx_mem : x ∈ W'_cov y := hy_cov y
    obtain ⟨hW'_alt, hBot_y⟩ := (hChart (W_cov y) (hAff_cov y) (hDed_cov y)).1
    obtain ⟨hy₀_mem, hbot_y₀⟩ := hBot_y pt_K
    let q₀ := hW'_alt.primeIdealOf ⟨y₀, hy₀_mem⟩
    let q_x := hW'_alt.primeIdealOf ⟨x, hx_mem⟩
    have h_le : q₀.asIdeal ≤ q_x.asIdeal := hbot_y₀.symm ▸ bot_le
    have hqx_cl : q_x ∈ closure ({q₀} : Set _) :=
      (PrimeSpectrum.le_iff_mem_closure q₀ q_x).mp h_le
    have hOpen_O : IsOpen (hW'_alt.fromSpec.base ⁻¹' G) :=
      hW'_alt.fromSpec.continuous.isOpen_preimage G hG
    have hqx_O : q_x ∈ hW'_alt.fromSpec.base ⁻¹' G := by
      change hW'_alt.fromSpec.base q_x ∈ G
      rw [hW'_alt.fromSpec_primeIdealOf ⟨x, hx_mem⟩]
      exact hxG
    obtain ⟨_, hq₀_O, hq₀_sing⟩ :=
      mem_closure_iff.mp hqx_cl (hW'_alt.fromSpec.base ⁻¹' G) hOpen_O hqx_O
    rw [Set.mem_singleton_iff] at hq₀_sing
    have hq₀_G : hW'_alt.fromSpec.base q₀ ∈ G := hq₀_sing ▸ hq₀_O
    rwa [hW'_alt.fromSpec_primeIdealOf ⟨y₀, hy₀_mem⟩] at hq₀_G
  haveI hIrred_Y : IrreducibleSpace ↥Y :=
    { isPreirreducible_univ := fun U V hU hV ⟨u, _, hu⟩ ⟨v, _, hv⟩ =>
        ⟨y₀, trivial, hy₀_in_open U hU ⟨u, hu⟩, hy₀_in_open V hV ⟨v, hv⟩⟩
      toNonempty := ⟨y₀⟩ }
  have hInt_Y : AlgebraicGeometry.IsIntegral Y :=
    AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced Y

  have hSurj_ubar : AlgebraicGeometry.Surjective u_bar := by
    haveI : AlgebraicGeometry.IsFinite u_bar := hFin_ubar
    have hClosed_range : IsClosed (Set.range u_bar.base) := by
      rw [← Set.image_univ]
      exact u_bar.isClosedMap Set.univ isClosed_univ
    have hSub_range : closure ({genericPoint ↥Z} : Set ↥Z) ⊆ Set.range u_bar.base :=
      hClosed_range.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr ⟨y₀, hy₀_gen⟩)
    rw [isGenericPoint_def.mp (genericPoint_spec ↥Z)] at hSub_range
    rw [AlgebraicGeometry.surjective_iff]
    exact fun z => hSub_range trivial

  exact ⟨hInt_Y, hFin_ubar, hSurj_ubar,
    fun W hW hNeW hDedW => (hChart W hW hDedW).2⟩

theorem weil_dedekind_birational_finiteType_spec_isOpenImmersion (B₁ B K : Type u) [CommRing B₁] [IsDedekindDomain B₁]
    [CommRing B] [IsDomain B] [Field K]
    [Algebra B₁ K] [IsFractionRing B₁ K]
    [Algebra B K] [IsFractionRing B K]
    [Algebra B₁ B] [Algebra.FiniteType B₁ B]
    [IsScalarTower B₁ B K] :
    AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₁ B))) :=
by
  classical
  let φ : B₁ →+* B := algebraMap B₁ B
  have hInjB₁K : Function.Injective (algebraMap B₁ K) := IsFractionRing.injective B₁ K
  have hInjBK : Function.Injective (algebraMap B K) := IsFractionRing.injective B K
  have hInj : Function.Injective φ := by
    have hcomp : ⇑(algebraMap B₁ K) = ⇑(algebraMap B K) ∘ ⇑φ := by
      funext x
      exact IsScalarTower.algebraMap_apply B₁ B K x
    rw [hcomp] at hInjB₁K
    exact Function.Injective.of_comp hInjB₁K

  have hClear : ∀ (q : Ideal B) [q.IsPrime] (b : B),
      ∃ a t : B₁, φ t ∉ q ∧ φ t * b = φ a := by
    intro q hq b
    let p₁ : Ideal B₁ := Ideal.comap φ q
    have hp₁_prime : p₁.IsPrime := Ideal.IsPrime.comap φ
    obtain ⟨⟨n₀, d_sub⟩, hsurj_b⟩ :=
      IsLocalization.surj (nonZeroDivisors B₁) (algebraMap B K b)
    let d₀ : B₁ := d_sub.1
    have hd₀_ne : d₀ ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d_sub.2
    have hd₀_eq : φ d₀ * b = φ n₀ := by
      apply hInjBK
      rw [map_mul, ← IsScalarTower.algebraMap_apply B₁ B K,
        ← IsScalarTower.algebraMap_apply B₁ B K, mul_comm]
      exact hsurj_b
    have hφd₀_ne : φ d₀ ≠ 0 := fun h0 => hd₀_ne (hInj (h0.trans (map_zero φ).symm))
    by_cases hp₁ : p₁ = ⊥
    · refine ⟨n₀, d₀, ?_, hd₀_eq⟩
      change d₀ ∉ p₁
      rw [hp₁, Ideal.mem_bot]
      exact hd₀_ne
    · let ι₁ : B₁ →+* Localization.AtPrime p₁ := algebraMap B₁ (Localization.AtPrime p₁)
      have hDVR : IsDiscreteValuationRing (Localization.AtPrime p₁) :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain B₁ hp₁
          (Localization.AtPrime p₁)
      have hNotField : ¬ IsField (Localization.AtPrime p₁) :=
        fun hf => IsDiscreteValuationRing.not_a_field' (IsLocalRing.isField_iff_maximalIdeal_eq.mp hf)
      have : ValuationRing (Localization.AtPrime p₁) :=
        ((IsDiscreteValuationRing.TFAE (Localization.AtPrime p₁) hNotField).out 1 2).mp hDVR
      have hInj₁ : Function.Injective ι₁ :=
        IsLocalization.injective (Localization.AtPrime p₁) p₁.primeCompl_le_nonZeroDivisors
      obtain ⟨c, hc⟩ := ValuationRing.cond (ι₁ n₀) (ι₁ d₀)
      obtain ⟨⟨m, s_sub⟩, hcs⟩ := IsLocalization.surj p₁.primeCompl c
      let s : B₁ := s_sub.1
      have hs_not_q : φ s ∉ q := s_sub.2
      have hcs' : c * ι₁ s = ι₁ m := hcs
      rcases hc with hc | hc
      · have h_eq_B₁ : n₀ * m = d₀ * s := hInj₁ <| by
          calc
            ι₁ (n₀ * m) = ι₁ n₀ * (c * ι₁ s) := by rw [map_mul, hcs']
            _ = (ι₁ n₀ * c) * ι₁ s := (mul_assoc _ _ _).symm
            _ = ι₁ (d₀ * s) := by rw [hc, map_mul]
        have hm_eq : φ m * b = φ s := by
          apply mul_left_cancel₀ hφd₀_ne
          calc
            φ d₀ * (φ m * b) = (φ d₀ * b) * φ m := by ring
            _ = φ (n₀ * m) := by rw [hd₀_eq, map_mul]
            _ = φ d₀ * φ s := by rw [h_eq_B₁, map_mul]
        have hm_not_q : φ m ∉ q := fun hm_in =>
          hs_not_q (hm_eq ▸ q.mul_mem_right b hm_in)
        exact ⟨s, m, hm_not_q, hm_eq⟩
      · have h_eq_B₁ : d₀ * m = n₀ * s := hInj₁ <| by
          calc
            ι₁ (d₀ * m) = ι₁ d₀ * (c * ι₁ s) := by rw [map_mul, hcs']
            _ = (ι₁ d₀ * c) * ι₁ s := (mul_assoc _ _ _).symm
            _ = ι₁ (n₀ * s) := by rw [hc, map_mul]
        have hs_eq : φ s * b = φ m := by
          apply mul_left_cancel₀ hφd₀_ne
          calc
            φ d₀ * (φ s * b) = (φ d₀ * b) * φ s := by ring
            _ = φ (n₀ * s) := by rw [hd₀_eq, map_mul]
            _ = φ d₀ * φ m := by rw [← h_eq_B₁, map_mul]
        exact ⟨m, s, hs_not_q, hs_eq⟩

  obtain ⟨s_gen, hs_gen⟩ := Algebra.FiniteType.out (R := B₁) (A := B)
  have hLoc : ∀ x : PrimeSpectrum B,
      ∃ (h : B₁) (μ : Localization.Away h →+* Localization.Away (φ h)),
        φ h ∉ x.asIdeal ∧
        (∀ r : B₁, μ (algebraMap B₁ (Localization.Away h) r) =
          algebraMap B (Localization.Away (φ h)) (φ r)) ∧
        Function.Bijective μ := by
    intro x
    let q : Ideal B := x.asIdeal
    have hq : q.IsPrime := x.isPrime
    let a_fn : B → B₁ := fun b => (hClear q b).choose
    let t_fn : B → B₁ := fun b => (hClear q b).choose_spec.choose
    have ht_mem : ∀ b : B, φ (t_fn b) ∉ q :=
      fun b => (hClear q b).choose_spec.choose_spec.1
    have ht_eq : ∀ b : B, φ (t_fn b) * b = φ (a_fn b) :=
      fun b => (hClear q b).choose_spec.choose_spec.2
    let h : B₁ := ∏ b ∈ s_gen, t_fn b
    have hφh_not_q : φ h ∉ q := by
      dsimp only [h]
      rw [map_prod]
      exact Finset.prod_induction (fun b => φ (t_fn b)) (fun y => y ∉ q)
        (fun _ _ ha hb hab => (hq.mem_or_mem hab).elim ha hb)
        (fun h1 => hq.ne_top (q.eq_top_iff_one.mpr h1))
        (fun b _ => ht_mem b)
    have hφh_ne : φ h ≠ 0 := fun h0 => hφh_not_q (h0 ▸ q.zero_mem)
    have hy : Submonoid.powers h ≤ Submonoid.comap φ (Submonoid.powers (φ h)) := by
      rintro _ ⟨n, rfl⟩
      exact ⟨n, (map_pow φ h n).symm⟩
    let μ : Localization.Away h →+* Localization.Away (φ h) :=
      IsLocalization.map (Localization.Away (φ h)) φ hy
    have hμ_eq : ∀ r : B₁,
        μ (algebraMap B₁ (Localization.Away h) r) =
          algebraMap B (Localization.Away (φ h)) (φ r) :=
      IsLocalization.map_eq hy
    have hμ_inj : Function.Injective μ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      have hsec : z * algebraMap B₁ (Localization.Away h) (h ^ (IsLocalization.Away.sec h z).2) =
          algebraMap B₁ (Localization.Away h) (IsLocalization.Away.sec h z).1 :=
        IsLocalization.Away.sec_spec h z
      have h0_S : algebraMap B (Localization.Away (φ h)) (φ (IsLocalization.Away.sec h z).1) =
          algebraMap B (Localization.Away (φ h)) 0 := by
        rw [← hμ_eq, ← hsec, map_mul, hz, zero_mul, map_zero]
      obtain ⟨c, hc0⟩ :=
        (IsLocalization.eq_iff_exists (Submonoid.powers (φ h)) (Localization.Away (φ h))).mp h0_S
      obtain ⟨m, hm⟩ := c.2
      rw [← hm, mul_zero] at hc0
      have hpow_ne : (φ h) ^ m ≠ 0 := pow_ne_zero m hφh_ne
      have hφp_zero : φ (IsLocalization.Away.sec h z).1 = 0 :=
        (mul_eq_zero.mp hc0).resolve_left hpow_ne
      have hp_zero : (IsLocalization.Away.sec h z).1 = 0 :=
        hInj (hφp_zero.trans (map_zero φ).symm)
      rw [hp_zero, map_zero, map_pow] at hsec
      exact ((IsLocalization.Away.algebraMap_isUnit h).pow _).mul_left_eq_zero.mp hsec
    let u_R : (Localization.Away h)ˣ :=
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away h) h).unit
    have hu_R_val : (u_R : Localization.Away h) = algebraMap B₁ (Localization.Away h) h := rfl
    let u_S : (Localization.Away (φ h))ˣ :=
      (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (φ h)) (φ h)).unit
    have hu_S_val : (u_S : Localization.Away (φ h)) =
        algebraMap B (Localization.Away (φ h)) (φ h) := rfl
    have hμ_u : μ u_R = u_S := by
      rw [hu_R_val, hu_S_val, hμ_eq]
    let T_subalg : Subalgebra B₁ B :=
      { (μ.range.comap (algebraMap B (Localization.Away (φ h)))).toSubsemiring with
        algebraMap_mem' := fun r => ⟨algebraMap B₁ (Localization.Away h) r, hμ_eq r⟩ }
    have hs_le : Algebra.adjoin B₁ (↑s_gen : Set B) ≤ T_subalg := by
      rw [Algebra.adjoin_le_iff]
      intro b hb
      have hb_s : b ∈ s_gen := hb
      let r_b : B₁ := ∏ y ∈ s_gen.erase b, t_fn y
      have htr_b : t_fn b * r_b = h := Finset.mul_prod_erase s_gen t_fn hb_s
      let w_b : Localization.Away h :=
        algebraMap B₁ (Localization.Away h) (a_fn b * r_b) * ↑(u_R⁻¹)
      refine ⟨w_b, ?_⟩
      apply (Units.mul_left_inj u_S).mp
      calc
        μ w_b * (u_S : Localization.Away (φ h))
          = μ (w_b * (u_R : Localization.Away h)) := by rw [← hμ_u, ← map_mul]
        _ = μ (algebraMap B₁ (Localization.Away h) (a_fn b * r_b)) := by
            dsimp only [w_b]
            rw [mul_assoc, Units.inv_mul, mul_one]
        _ = algebraMap B (Localization.Away (φ h)) (φ (a_fn b) * φ r_b) := by
            rw [hμ_eq, map_mul]
        _ = algebraMap B (Localization.Away (φ h)) (b * φ (t_fn b * r_b)) := by
            congr 1
            rw [← ht_eq b, map_mul]
            ring
        _ = algebraMap B (Localization.Away (φ h)) b * (u_S : Localization.Away (φ h)) := by
            rw [htr_b, map_mul, hu_S_val]
    have hB_in_range : ∀ y : B, algebraMap B (Localization.Away (φ h)) y ∈ μ.range := by
      intro y
      have hy_top : y ∈ (⊤ : Subalgebra B₁ B) := Algebra.mem_top
      rw [← hs_gen] at hy_top
      exact hs_le hy_top
    have hμ_surj : Function.Surjective μ := by
      intro z
      let p_z := IsLocalization.Away.sec (φ h) z
      have hsec_z : z * algebraMap B (Localization.Away (φ h)) ((φ h) ^ p_z.2) =
          algebraMap B (Localization.Away (φ h)) p_z.1 :=
        IsLocalization.Away.sec_spec (φ h) z
      obtain ⟨w, hw⟩ := hB_in_range p_z.1
      refine ⟨w * ↑((u_R ^ p_z.2)⁻¹), ?_⟩
      apply (Units.mul_left_inj (u_S ^ p_z.2)).mp
      have hu_pow_S : ((u_S ^ p_z.2 : (Localization.Away (φ h))ˣ) : Localization.Away (φ h)) =
          algebraMap B (Localization.Away (φ h)) ((φ h) ^ p_z.2) := by
        rw [Units.val_pow_eq_pow_val, hu_S_val, map_pow]
      have hμ_pow : μ ↑(u_R ^ p_z.2) =
          ((u_S ^ p_z.2 : (Localization.Away (φ h))ˣ) : Localization.Away (φ h)) := by
        rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val, map_pow, hμ_u]
      calc
        μ (w * ↑((u_R ^ p_z.2)⁻¹)) *
            ((u_S ^ p_z.2 : (Localization.Away (φ h))ˣ) : Localization.Away (φ h))
          = μ (w * (↑((u_R ^ p_z.2)⁻¹) * ↑(u_R ^ p_z.2))) := by
            rw [← hμ_pow, ← map_mul, mul_assoc]
        _ = μ w := by rw [Units.inv_mul, mul_one]
        _ = z * ((u_S ^ p_z.2 : (Localization.Away (φ h))ˣ) : Localization.Away (φ h)) := by
            rw [hw, ← hsec_z, hu_pow_S]
    exact ⟨h, μ, hφh_not_q, hμ_eq, ⟨hμ_inj, hμ_surj⟩⟩

  let f : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
  let h_fn : PrimeSpectrum B → B₁ := fun i => (hLoc i).choose
  let μ_fn : ∀ i : PrimeSpectrum B,
      Localization.Away (h_fn i) →+* Localization.Away (φ (h_fn i)) :=
    fun i => (hLoc i).choose_spec.choose
  have hh_mem : ∀ i : PrimeSpectrum B, φ (h_fn i) ∉ i.asIdeal :=
    fun i => (hLoc i).choose_spec.choose_spec.1
  have hμ_comm : ∀ (i : PrimeSpectrum B) (r : B₁),
      μ_fn i (algebraMap B₁ (Localization.Away (h_fn i)) r) =
        algebraMap B (Localization.Away (φ (h_fn i))) (φ r) :=
    fun i => (hLoc i).choose_spec.choose_spec.2.1
  have hμ_bij : ∀ i : PrimeSpectrum B, Function.Bijective (μ_fn i) :=
    fun i => (hLoc i).choose_spec.choose_spec.2.2

  let U_obj : PrimeSpectrum B → AlgebraicGeometry.Scheme.{u} :=
    fun i => AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (φ (h_fn i))))
  let j_S : ∀ i : PrimeSpectrum B, U_obj i ⟶ AlgebraicGeometry.Spec (CommRingCat.of B) :=
    fun i => AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap B (Localization.Away (φ (h_fn i)))))
  let j_R : ∀ i : PrimeSpectrum B,
      AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (h_fn i))) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
    fun i => AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap B₁ (Localization.Away (h_fn i))))

  have hOpen_jS : ∀ i : PrimeSpectrum B, AlgebraicGeometry.IsOpenImmersion (j_S i) :=
    fun i => AlgebraicGeometry.IsOpenImmersion.of_isLocalization (φ (h_fn i))
  have hOpen_jR : ∀ i : PrimeSpectrum B, AlgebraicGeometry.IsOpenImmersion (j_R i) :=
    fun i => AlgebraicGeometry.IsOpenImmersion.of_isLocalization (h_fn i)

  have hOpen_comp : ∀ i : PrimeSpectrum B, AlgebraicGeometry.IsOpenImmersion (j_S i ≫ f) := by
    intro i
    have h_cat_comm :
        CommRingCat.ofHom (algebraMap B₁ (Localization.Away (h_fn i))) ≫
          CommRingCat.ofHom (μ_fn i) =
        CommRingCat.ofHom φ ≫
          CommRingCat.ofHom (algebraMap B (Localization.Away (φ (h_fn i)))) := by
      ext r
      exact hμ_comm i r
    have h_spec_comm : j_S i ≫ f =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_fn i)) ≫ j_R i := by
      dsimp only [j_S, j_R, f]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp, h_cat_comm]
    let e_i : Localization.Away (h_fn i) ≃+* Localization.Away (φ (h_fn i)) :=
      RingEquiv.ofBijective (μ_fn i) (hμ_bij i)
    have he_hom : CommRingCat.ofHom (μ_fn i) = e_i.toCommRingCatIso.hom := rfl
    have : CategoryTheory.IsIso (CommRingCat.ofHom (μ_fn i)) := by
      rw [he_hom]
      infer_instance
    have : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_fn i))) :=
      inferInstance
    have : AlgebraicGeometry.IsOpenImmersion
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (μ_fn i))) :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso _
    have : AlgebraicGeometry.IsOpenImmersion (j_R i) := hOpen_jR i
    rw [h_spec_comm]
    exact AlgebraicGeometry.IsOpenImmersion.comp _ _

  have hSpec_apply : ∀ {R S : CommRingCat.{u}} (g : R ⟶ S) (pt : PrimeSpectrum S),
      (AlgebraicGeometry.Spec.map g) pt = PrimeSpectrum.comap g.hom pt := by
    intro R S g pt
    rw [AlgebraicGeometry.Spec.map_base]
    rfl

  have hRange_jS : ∀ i : PrimeSpectrum B,
      Set.range ⇑(j_S i) = (PrimeSpectrum.basicOpen (φ (h_fn i)) : Set (PrimeSpectrum B)) := by
    intro i
    have hfun : (⇑(j_S i) : PrimeSpectrum (Localization.Away (φ (h_fn i))) → PrimeSpectrum B) =
        PrimeSpectrum.comap (algebraMap B (Localization.Away (φ (h_fn i)))) := by
      funext y
      exact hSpec_apply _ y
    rw [hfun]
    exact PrimeSpectrum.localization_away_comap_range
      (Localization.Away (φ (h_fn i))) (φ (h_fn i))

  have hCov : ∀ x : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)),
      ∃ (i : PrimeSpectrum B) (y : ↥(U_obj i)), (j_S i) y = x := by
    intro x
    have hx_mem : (x : PrimeSpectrum B) ∈
        (PrimeSpectrum.basicOpen (φ (h_fn x)) : Set (PrimeSpectrum B)) :=
      (PrimeSpectrum.mem_basicOpen (φ (h_fn x)) x).mpr (hh_mem x)
    rw [← hRange_jS x] at hx_mem
    obtain ⟨y, hy⟩ := hx_mem
    exact ⟨x, y, hy⟩

  have hInj_f : Function.Injective ⇑f := by
    intro x₁ x₂ hx_eq
    have h1 : f x₁ = PrimeSpectrum.comap φ x₁ := hSpec_apply (CommRingCat.ofHom φ) x₁
    have h2 : f x₂ = PrimeSpectrum.comap φ x₂ := hSpec_apply (CommRingCat.ofHom φ) x₂
    have hcomap_eq : PrimeSpectrum.comap φ x₁ = PrimeSpectrum.comap φ x₂ :=
      h1.symm.trans (hx_eq.trans h2)
    have hx₂_not_mem : φ (h_fn x₁) ∉ (x₂ : PrimeSpectrum B).asIdeal := by
      change h_fn x₁ ∉ (PrimeSpectrum.comap φ x₂).asIdeal
      rw [← hcomap_eq]
      exact hh_mem x₁
    have hx₁_range : (x₁ : PrimeSpectrum B) ∈ Set.range ⇑(j_S x₁) := by
      rw [hRange_jS x₁]
      exact (PrimeSpectrum.mem_basicOpen (φ (h_fn x₁)) x₁).mpr (hh_mem x₁)
    have hx₂_range : (x₂ : PrimeSpectrum B) ∈ Set.range ⇑(j_S x₁) := by
      rw [hRange_jS x₁]
      exact (PrimeSpectrum.mem_basicOpen (φ (h_fn x₁)) x₂).mpr hx₂_not_mem
    obtain ⟨y₁, hy₁⟩ := hx₁_range
    obtain ⟨y₂, hy₂⟩ := hx₂_range
    have : AlgebraicGeometry.IsOpenImmersion (j_S x₁ ≫ f) := hOpen_comp x₁
    have hy_eq : y₁ = y₂ :=
      (j_S x₁ ≫ f).isOpenEmbedding.isEmbedding.injective <| by
        change f ((j_S x₁) y₁) = f ((j_S x₁) y₂)
        rw [hy₁, hy₂]
        exact hx_eq
    calc
      x₁ = (j_S x₁) y₁ := hy₁.symm
      _ = (j_S x₁) y₂ := by rw [hy_eq]
      _ = x₂ := hy₂

  let 𝒰 : (AlgebraicGeometry.Spec (CommRingCat.of B)).OpenCover :=
    AlgebraicGeometry.Scheme.Cover.mkOfCovers (PrimeSpectrum B) U_obj j_S hCov hOpen_jS
  exact AlgebraicGeometry.IsOpenImmersion.of_openCover_source f 𝒰 hInj_f (fun i => hOpen_comp i)

theorem weil_dedekind_finite_torsionFree_away_free_basis (A K₀ B_W K : Type u) [CommRing A] [IsDedekindDomain A]
    [Field K₀] [Algebra A K₀] [IsFractionRing A K₀]
    [CommRing B_W] [IsDomain B_W]
    [Field K] [Algebra B_W K] [IsFractionRing B_W K]
    [Algebra A B_W] [Module.Finite A B_W]
    [Algebra K₀ K] [FiniteDimensional K₀ K]
    [Algebra A K] [IsScalarTower A K₀ K] [IsScalarTower A B_W K]
    (p : Ideal A) [p.IsPrime] :
    ∃ (g : A) (v : Fin (Module.finrank K₀ K) → B_W),
      g ∉ p ∧
      (∀ x : B_W, ∃ c : Fin (Module.finrank K₀ K) → A,
        algebraMap A B_W g * x = ∑ i, algebraMap A B_W (c i) * v i) ∧
      (∀ c : Fin (Module.finrank K₀ K) → A,
        ∑ i, algebraMap A B_W (c i) * v i = 0 → ∀ i, c i = 0) :=
by
  classical
  set d : ℕ := Module.finrank K₀ K
  let A_p := Localization.AtPrime p
  let α : A →+* K₀ := algebraMap A K₀
  let β : B_W →+* K := algebraMap B_W K
  have hInj_AK₀ : Function.Injective α := IsFractionRing.injective A K₀
  have hInj_BWK : Function.Injective β := IsFractionRing.injective B_W K
  have hPrimeCompl_le : p.primeCompl ≤ nonZeroDivisors A := Ideal.primeCompl_le_nonZeroDivisors p
  have hInj_AAp : Function.Injective (algebraMap A A_p) :=
    IsLocalization.injective A_p hPrimeCompl_le
  have hg_K₀ : ∀ y : p.primeCompl, IsUnit (α y.1) :=
    fun y => IsLocalization.map_units K₀ ⟨y.1, hPrimeCompl_le y.2⟩
  let ι_Ap : A_p →+* K₀ := IsLocalization.lift hg_K₀
  have hInj_ιAp : Function.Injective ι_Ap := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj p.primeCompl z
    have ha0 : α a = 0 := by
      calc
        α a = ι_Ap (algebraMap A A_p a) := (IsLocalization.lift_eq hg_K₀ a).symm
        _ = ι_Ap (z * algebraMap A A_p s.1) := by rw [← hzs]
        _ = ι_Ap z * ι_Ap (algebraMap A A_p s.1) := map_mul ι_Ap _ _
        _ = 0 := by rw [hz, zero_mul]
    have ha_eq : a = 0 := hInj_AK₀ (ha0.trans (map_zero α).symm)
    rw [ha_eq, map_zero] at hzs
    have hu_s : IsUnit (algebraMap A A_p s.1) := IsLocalization.map_units A_p s
    exact ( hu_s.mul_left_eq_zero ).mp hzs
  let φ_Ap_K : A_p →+* K := (algebraMap K₀ K).comp ι_Ap
  have hInj_ApK : Function.Injective φ_Ap_K :=
    (RingHom.injective (algebraMap K₀ K)).comp hInj_ιAp
  letI : Algebra A_p K₀ := ι_Ap.toAlgebra
  letI : Algebra A_p K := φ_Ap_K.toAlgebra
  haveI : IsScalarTower A A_p K₀ :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a => (IsLocalization.lift_eq hg_K₀ a).symm)
  haveI : IsScalarTower A_p K₀ K :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower A A_p K :=
    IsScalarTower.of_algebraMap_eq' (RingHom.ext fun a => by
      change algebraMap A K a = algebraMap K₀ K (ι_Ap (algebraMap A A_p a))
      rw [IsLocalization.lift_eq hg_K₀ a, ← IsScalarTower.algebraMap_apply A K₀ K])
  have hβ_smul : ∀ (a : A) (x : B_W),
      β (algebraMap A B_W a * x) = (algebraMap A A_p a) • β x := by
    intro a x
    change algebraMap B_W K (algebraMap A B_W a * x) = (algebraMap A A_p a) • β x
    rw [map_mul, ← IsScalarTower.algebraMap_apply A B_W K,
      IsScalarTower.algebraMap_apply A A_p K, Algebra.smul_def]
  haveI : IsPrincipalIdealRing A_p := by
    by_cases hp : p = ⊥
    · have hSurj_ιAp : Function.Surjective ι_Ap := by
        intro z
        obtain ⟨⟨a, s⟩, hzs⟩ := IsLocalization.surj (nonZeroDivisors A) z
        have hs_ne : s.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        have hs_p : s.1 ∈ p.primeCompl := by
          change s.1 ∉ p
          rw [hp, Ideal.mem_bot]
          exact hs_ne
        have hu_s : IsUnit (algebraMap A A_p s.1) := IsLocalization.map_units A_p ⟨s.1, hs_p⟩
        let u_s : A_pˣ := hu_s.unit
        have hu_s_eq : (u_s : A_p) = algebraMap A A_p s.1 := hu_s.unit_spec
        let w : A_p := algebraMap A A_p a * ↑(u_s⁻¹)
        have hαs_ne : α s.1 ≠ 0 := fun h0 =>
          hs_ne (hInj_AK₀ (h0.trans (map_zero α).symm))
        refine ⟨w, mul_right_cancel₀ hαs_ne ?_⟩
        calc
          ι_Ap w * α s.1 = ι_Ap w * ι_Ap (algebraMap A A_p s.1) := by
            rw [IsLocalization.lift_eq hg_K₀ s.1]
          _ = ι_Ap (algebraMap A A_p a * (↑(u_s⁻¹) * ↑u_s)) := by
            rw [← hu_s_eq, ← map_mul]
            dsimp [w]
            rw [mul_assoc]
          _ = ι_Ap (algebraMap A A_p a) := by
            rw [Units.inv_mul, mul_one]
          _ = α a := IsLocalization.lift_eq hg_K₀ a
          _ = z * α s.1 := hzs.symm
      let e_K₀ : A_p ≃+* K₀ := RingEquiv.ofBijective ι_Ap ⟨hInj_ιAp, hSurj_ιAp⟩
      exact IsPrincipalIdealRing.of_surjective e_K₀.symm.toRingHom e_K₀.symm.surjective
    · haveI : IsDiscreteValuationRing A_p :=
        IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain A hp A_p
      infer_instance
  obtain ⟨S₀, hS₀_fin, hS₀_span⟩ :=
    Submodule.fg_def.mp (Module.Finite.fg_top (R := A) (M := B_W))
  obtain ⟨W_fin, hW_fin_coe⟩ := hS₀_fin.exists_finset_coe
  have hSpan_W : Submodule.span A (W_fin : Set B_W) = ⊤ := by
    rwa [hW_fin_coe]
  let N : Submodule A_p K := Submodule.span A_p (Set.range β)
  have hN_eq : N = Submodule.span A_p ((W_fin.image β) : Set K) := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨x, rfl⟩
      have hx_top : x ∈ (⊤ : Submodule A B_W) := Submodule.mem_top
      rw [← hSpan_W, Submodule.mem_span_finset] at hx_top
      obtain ⟨f_x, -, hf_x⟩ := hx_top
      have hβx : β x = ∑ w ∈ W_fin, (algebraMap A A_p (f_x w)) • β w := by
        rw [← hf_x, map_sum]
        refine Finset.sum_congr rfl fun w _ => ?_
        rw [Algebra.smul_def, hβ_smul]
      rw [hβx]
      refine Submodule.sum_mem _ fun w hw => Submodule.smul_mem _ _ ?_
      exact Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem β hw))
    · apply Submodule.span_mono
      rintro _ hz
      rcases Finset.mem_image.mp (Finset.mem_coe.mp hz) with ⟨w, _, rfl⟩
      exact ⟨w, rfl⟩
  have hN_fg : N.FG := by
    rw [hN_eq]
    exact Submodule.fg_span (W_fin.image β).finite_toSet
  haveI : Module.Finite A_p ↥N := Module.Finite.iff_fg.mpr hN_fg
  haveI : Module.IsTorsionFree A_p ↥N := by
    rw [Module.isTorsionFree_iff_smul_eq_zero]
    intro r m hrm
    have hm0 : φ_Ap_K r * m.1 = 0 := by
      have h1 : (r • m).1 = 0 := congrArg Subtype.val hrm
      rwa [SetLike.val_smul, Algebra.smul_def] at h1
    rcases mul_eq_zero.mp hm0 with hr0 | hm0'
    · left
      exact hInj_ApK (hr0.trans (map_zero φ_Ap_K).symm)
    · right
      exact Subtype.ext hm0'
  obtain ⟨n, b₀⟩ := Module.basisOfFiniteTypeTorsionFree' (R := A_p) (M := ↥N)
  have hClear_N : ∀ {z : K}, z ∈ N → ∃ (t : A) (y : B_W),
      t ∉ p ∧ (algebraMap A A_p t) • z = β y := by
    intro z hz
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨x, rfl⟩
      refine ⟨1, x, Ideal.IsPrime.one_notMem ‹p.IsPrime›, ?_⟩
      rw [map_one, one_smul]
    · refine ⟨1, 0, Ideal.IsPrime.one_notMem ‹p.IsPrime›, ?_⟩
      rw [smul_zero, map_zero]
    · rintro z₁ z₂ _ _ ⟨t₁, y₁, ht₁, hy₁⟩ ⟨t₂, y₂, ht₂, hy₂⟩
      refine ⟨t₁ * t₂, algebraMap A B_W t₂ * y₁ + algebraMap A B_W t₁ * y₂,
        Ideal.IsPrime.mul_notMem ‹p.IsPrime› ht₁ ht₂, ?_⟩
      rw [map_add, hβ_smul, hβ_smul, ← hy₁, ← hy₂, smul_add, smul_smul, smul_smul, map_mul]
      congr 1
      congr 1
      ring
    · rintro r z₀ _ ⟨t, y, ht, hy⟩
      obtain ⟨⟨a, s⟩, hrs⟩ := IsLocalization.surj p.primeCompl r
      refine ⟨s.1 * t, algebraMap A B_W a * y,
        Ideal.IsPrime.mul_notMem ‹p.IsPrime› s.2 ht, ?_⟩
      rw [hβ_smul, ← hy, smul_smul, smul_smul, ← hrs, map_mul]
      congr 1
      ring
  let t₀ : Fin n → A := fun i => Classical.choose (hClear_N (b₀ i).2)
  let v₀ : Fin n → B_W := fun i => Classical.choose (Classical.choose_spec (hClear_N (b₀ i).2))
  have ht₀ : ∀ i : Fin n, t₀ i ∉ p :=
    fun i => (Classical.choose_spec (Classical.choose_spec (hClear_N (b₀ i).2))).1
  have hv₀ : ∀ i : Fin n, (algebraMap A A_p (t₀ i)) • (b₀ i).1 = β (v₀ i) :=
    fun i => (Classical.choose_spec (Classical.choose_spec (hClear_N (b₀ i).2))).2
  let hu₀ : ∀ i : Fin n, IsUnit (algebraMap A A_p (t₀ i)) :=
    fun i => IsLocalization.map_units A_p (⟨t₀ i, ht₀ i⟩ : p.primeCompl)
  let u₀ : Fin n → A_pˣ := fun i => (hu₀ i).unit
  let b_scaled : Module.Basis (Fin n) A_p ↥N := b₀.unitsSMul u₀
  have hb_scaled : ∀ i : Fin n, (b_scaled i).1 = β (v₀ i) := by
    intro i
    dsimp [b_scaled]
    rw [Module.Basis.unitsSMul_apply, Units.smul_def, SetLike.val_smul, (hu₀ i).unit_spec]
    exact hv₀ i
  have hLinInd_K₀ : LinearIndependent K₀ (fun i : Fin n => β (v₀ i)) := by
    rw [Fintype.linearIndependent_iff]
    intro lam hsum_K
    let surj_i : ∀ i : Fin n, A × nonZeroDivisors A :=
      fun i => Classical.choose (IsLocalization.surj (nonZeroDivisors A) (lam i))
    have hsurj_i : ∀ i : Fin n, lam i * α (surj_i i).2.1 = α (surj_i i).1 :=
      fun i => Classical.choose_spec (IsLocalization.surj (nonZeroDivisors A) (lam i))
    let S_all : A := ∏ j : Fin n, (surj_i j).2.1
    have hS_mem : S_all ∈ nonZeroDivisors A :=
      (nonZeroDivisors A).prod_mem (fun j _ => (surj_i j).2.2)
    have hS_ne : S_all ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hS_mem
    have hαS_ne : α S_all ≠ 0 := fun h0 =>
      hS_ne (hInj_AK₀ (h0.trans (map_zero α).symm))
    let Q_i : Fin n → A := fun i => ∏ j ∈ Finset.univ.erase i, (surj_i j).2.1
    let m_i : Fin n → A := fun i => (surj_i i).1 * Q_i i
    have hS_mul_lam : ∀ i : Fin n, α S_all * lam i = algebraMap A_p K₀ (algebraMap A A_p (m_i i)) := by
      intro i
      have hS_split : S_all = (surj_i i).2.1 * Q_i i :=
        (Finset.mul_prod_erase Finset.univ (fun j => (surj_i j).2.1) (Finset.mem_univ i)).symm
      rw [← IsScalarTower.algebraMap_apply A A_p K₀]
      change α S_all * lam i = α (m_i i)
      dsimp [m_i]
      rw [hS_split, map_mul, map_mul, ← hsurj_i i]
      ring
    have hsum_N : ∑ i : Fin n, (algebraMap A A_p (m_i i)) • b_scaled i = 0 := by
      apply Subtype.ext
      rw [Submodule.coe_sum, ZeroMemClass.coe_zero]
      have h1 : α S_all • ∑ i : Fin n, lam i • β (v₀ i) = 0 := by
        rw [hsum_K, smul_zero]
      rw [Finset.smul_sum] at h1
      rw [← h1]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [SetLike.val_smul, hb_scaled i, smul_smul, hS_mul_lam i,
        Algebra.smul_def, Algebra.smul_def]
      rfl
    have hm_zero : ∀ i : Fin n, algebraMap A A_p (m_i i) = 0 :=
      (Fintype.linearIndependent_iff.mp b_scaled.linearIndependent) _ hsum_N
    intro i
    have hmi0 : m_i i = 0 := hInj_AAp ((hm_zero i).trans (map_zero _).symm)
    have hprod0 : α S_all * lam i = 0 := by
      rw [hS_mul_lam i, hmi0, map_zero, map_zero]
    exact (mul_eq_zero.mp hprod0).resolve_left hαS_ne
  let V : Submodule K₀ K := Submodule.span K₀ (Set.range (fun i : Fin n => β (v₀ i)))
  have hBW_mem_V : ∀ x : B_W, β x ∈ V := by
    intro x
    let x_N : ↥N := ⟨β x, Submodule.subset_span ⟨x, rfl⟩⟩
    have hrepr : (∑ i : Fin n, (b_scaled.repr x_N i) • b_scaled i).1 = x_N.1 :=
      congrArg Subtype.val (b_scaled.sum_repr x_N)
    rw [Submodule.coe_sum] at hrepr
    change β x ∈ V
    change x_N.1 ∈ V
    rw [← hrepr]
    refine Submodule.sum_mem V fun i _ => ?_
    have h_eq : ((b_scaled.repr x_N i) • b_scaled i).1 =
        (algebraMap A_p K₀ (b_scaled.repr x_N i)) • β (v₀ i) := by
      rw [SetLike.val_smul, hb_scaled i, Algebra.smul_def, Algebra.smul_def]
      rfl
    rw [h_eq]
    exact Submodule.smul_mem V _ (Submodule.subset_span ⟨i, rfl⟩)
  have hMul_V : ∀ (x : B_W) {w : K}, w ∈ V → β x * w ∈ V := by
    intro x w hw
    have hle : V ≤ V.comap (LinearMap.mulLeft K₀ (β x)) := by
      rw [Submodule.span_le]
      rintro _ ⟨i, rfl⟩
      change β x * β (v₀ i) ∈ V
      rw [← map_mul]
      exact hBW_mem_V (x * v₀ i)
    exact hle hw
  have hSpan_K₀ : ⊤ ≤ V := by
    intro z _
    obtain ⟨⟨x, y⟩, hzy⟩ := IsLocalization.surj (nonZeroDivisors B_W) z
    have hy_ne : y.1 ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
    have hβy_ne : β y.1 ≠ 0 := fun h0 =>
      hy_ne (hInj_BWK (h0.trans (map_zero β).symm))
    let f_y : ↥V →ₗ[K₀] ↥V := (LinearMap.mulLeft K₀ (β y.1)).restrict (fun w hw => hMul_V y.1 hw)
    have hf_inj : Function.Injective f_y := by
      intro w₁ w₂ hw_eq
      apply Subtype.ext
      have hmul : β y.1 * w₁.1 = β y.1 * w₂.1 := congrArg Subtype.val hw_eq
      exact mul_left_cancel₀ hβy_ne hmul
    have hf_surj : Function.Surjective f_y :=
      LinearMap.injective_iff_surjective.mp hf_inj
    have h1_V : (1 : K) ∈ V := by
      rw [← map_one β]
      exact hBW_mem_V 1
    obtain ⟨w_inv, hw_inv⟩ := hf_surj ⟨1, h1_V⟩
    have hw_inv_eq : β y.1 * w_inv.1 = 1 := congrArg Subtype.val hw_inv
    have hz_eq : z = β x * w_inv.1 := by
      calc
        z = z * (β y.1 * w_inv.1) := by rw [hw_inv_eq, mul_one]
        _ = (z * β y.1) * w_inv.1 := (mul_assoc _ _ _).symm
        _ = β x * w_inv.1 := by rw [hzy]
    rw [hz_eq]
    exact hMul_V x w_inv.2
  let b_K : Module.Basis (Fin n) K₀ K := Module.Basis.mk hLinInd_K₀ hSpan_K₀
  have hn_d : n = d := by
    have hfr : d = Fintype.card (Fin n) := Module.finrank_eq_card_basis b_K
    rw [Fintype.card_fin] at hfr
    exact hfr.symm
  let e_nd : Fin n ≃ Fin d := finCongr hn_d
  let b_p : Module.Basis (Fin d) A_p ↥N := b_scaled.reindex e_nd
  let v : Fin d → B_W := fun i => v₀ (e_nd.symm i)
  have hb_p : ∀ i : Fin d, (b_p i).1 = β (v i) := by
    intro i
    rw [Module.Basis.reindex_apply]
    exact hb_scaled (e_nd.symm i)
  have hClear_W : ∀ w : B_W, ∃ (g_w : A) (c_w : Fin d → A),
      g_w ∉ p ∧ algebraMap A B_W g_w * w = ∑ i : Fin d, algebraMap A B_W (c_w i) * v i := by
    intro w
    let w_N : ↥N := ⟨β w, Submodule.subset_span ⟨w, rfl⟩⟩
    let surj_w : ∀ i : Fin d, A × p.primeCompl :=
      fun i => Classical.choose (IsLocalization.surj p.primeCompl (b_p.repr w_N i))
    have hsurj_w : ∀ i : Fin d,
        (b_p.repr w_N i) * algebraMap A A_p (surj_w i).2.1 = algebraMap A A_p (surj_w i).1 :=
      fun i => Classical.choose_spec (IsLocalization.surj p.primeCompl (b_p.repr w_N i))
    let g_w : A := ∏ i : Fin d, (surj_w i).2.1
    have hg_w_mem : g_w ∈ p.primeCompl := p.primeCompl.prod_mem (fun i _ => (surj_w i).2.2)
    let Q_w : Fin d → A := fun i => ∏ j ∈ Finset.univ.erase i, (surj_w j).2.1
    let c_w : Fin d → A := fun i => (surj_w i).1 * Q_w i
    have hg_repr : ∀ i : Fin d,
        algebraMap A A_p g_w * b_p.repr w_N i = algebraMap A A_p (c_w i) := by
      intro i
      have hg_split : g_w = (surj_w i).2.1 * Q_w i :=
        (Finset.mul_prod_erase Finset.univ (fun j => (surj_w j).2.1) (Finset.mem_univ i)).symm
      dsimp [c_w]
      rw [hg_split, map_mul, map_mul]
      calc
        (algebraMap A A_p (surj_w i).2.1 * algebraMap A A_p (Q_w i)) * b_p.repr w_N i
          = (b_p.repr w_N i * algebraMap A A_p (surj_w i).2.1) * algebraMap A A_p (Q_w i) := by ring
        _ = algebraMap A A_p (surj_w i).1 * algebraMap A A_p (Q_w i) := by rw [hsurj_w i]
    refine ⟨g_w, c_w, hg_w_mem, hInj_BWK ?_⟩
    rw [hβ_smul, map_sum]
    have hrepr : (∑ i : Fin d, (b_p.repr w_N i) • b_p i).1 = β w :=
      congrArg Subtype.val (b_p.sum_repr w_N)
    rw [Submodule.coe_sum] at hrepr
    rw [← hrepr, Finset.smul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [SetLike.val_smul, hb_p i, smul_smul, hg_repr i, hβ_smul]
  let g_of : B_W → A := fun w => Classical.choose (hClear_W w)
  let c_of : B_W → Fin d → A := fun w => Classical.choose (Classical.choose_spec (hClear_W w))
  have hg_of : ∀ w : B_W, g_of w ∉ p :=
    fun w => (Classical.choose_spec (Classical.choose_spec (hClear_W w))).1
  have hc_of : ∀ w : B_W,
      algebraMap A B_W (g_of w) * w = ∑ i : Fin d, algebraMap A B_W (c_of w i) * v i :=
    fun w => (Classical.choose_spec (Classical.choose_spec (hClear_W w))).2
  let g : A := ∏ w ∈ W_fin, g_of w
  have hg_notMem : g ∉ p := p.primeCompl.prod_mem (fun w _ => hg_of w)
  refine ⟨g, v, hg_notMem, ?_, ?_⟩
  · intro x
    have hx_top : x ∈ (⊤ : Submodule A B_W) := Submodule.mem_top
    rw [← hSpan_W, Submodule.mem_span_finset] at hx_top
    obtain ⟨f_x, -, hf_x⟩ := hx_top
    let P_of : B_W → A := fun w => ∏ w' ∈ W_fin.erase w, g_of w'
    let c : Fin d → A := fun i => ∑ w ∈ W_fin, f_x w * P_of w * c_of w i
    refine ⟨c, ?_⟩
    calc
      algebraMap A B_W g * x
        = algebraMap A B_W g * ∑ w ∈ W_fin, algebraMap A B_W (f_x w) * w := by
            rw [← hf_x]
            congr 1
            exact Finset.sum_congr rfl fun w _ => Algebra.smul_def (f_x w) w
      _ = ∑ w ∈ W_fin, algebraMap A B_W (f_x w * P_of w) * (algebraMap A B_W (g_of w) * w) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun w hw => ?_
            have hg_split : g = g_of w * P_of w :=
              (Finset.mul_prod_erase W_fin g_of hw).symm
            rw [hg_split, map_mul, map_mul]
            ring
      _ = ∑ w ∈ W_fin, algebraMap A B_W (f_x w * P_of w) *
            ∑ i : Fin d, algebraMap A B_W (c_of w i) * v i := by
            refine Finset.sum_congr rfl fun w _ => ?_
            rw [hc_of w]
      _ = ∑ w ∈ W_fin, ∑ i : Fin d,
            algebraMap A B_W (f_x w * P_of w * c_of w i) * v i := by
            refine Finset.sum_congr rfl fun w _ => ?_
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun i _ => ?_
            simp only [map_mul, mul_assoc]
      _ = ∑ i : Fin d, ∑ w ∈ W_fin,
            algebraMap A B_W (f_x w * P_of w * c_of w i) * v i := Finset.sum_comm
      _ = ∑ i : Fin d, algebraMap A B_W (c i) * v i := by
            refine Finset.sum_congr rfl fun i _ => ?_
            dsimp [c]
            rw [map_sum, Finset.sum_mul]
  · intro c hc_sum
    have hsum_N : ∑ i : Fin d, (algebraMap A A_p (c i)) • b_p i = 0 := by
      apply Subtype.ext
      rw [Submodule.coe_sum, ZeroMemClass.coe_zero]
      have hβ0 : β (∑ i : Fin d, algebraMap A B_W (c i) * v i) = 0 := by
        rw [hc_sum, map_zero]
      rw [map_sum] at hβ0
      rw [← hβ0]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [SetLike.val_smul, hb_p i, hβ_smul]
    have hc_Ap : ∀ i : Fin d, algebraMap A A_p (c i) = 0 :=
      (Fintype.linearIndependent_iff.mp b_p.linearIndependent) _ hsum_N
    intro i
    exact hInj_AAp ((hc_Ap i).trans (map_zero _).symm)

theorem weil_algClosed_connected_etale_curve_completion_over_P1 (k : Type u) [Field k] [IsAlgClosed k]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    [AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom]
    [AlgebraicGeometry.IsIntegral (weilProjectiveSpaceOver k 1).left]
    (hProj_P1 : IsProjectiveOverField k (weilProjectiveSpaceOver k 1))
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 (weilProjectiveSpaceOver k 1).hom]
    [AlgebraicGeometry.IsOpenImmersion ι_P1]
    (hιP1_hom : CategoryTheory.CategoryStruct.comp ι_P1 (weilProjectiveSpaceOver k 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (C : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine C] [ConnectedSpace ↥C]
    (u_C : Quiver.Hom C (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))))
    [AlgebraicGeometry.Etale u_C] :
    ∃ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (j_C : Quiver.Hom C C_bar.left)
      (hOpen_jC : AlgebraicGeometry.IsOpenImmersion j_C)
      (d : ℕ)
      (u_bar : Quiver.Hom C_bar.left (weilProjectiveSpaceOver k 1).left),
      letI : AlgebraicGeometry.IsOpenImmersion j_C := hOpen_jC
      AlgebraicGeometry.IsIntegral C_bar.left ∧
      IsProjectiveOverField k C_bar ∧
      AlgebraicGeometry.IsProper C_bar.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom ∧
      1 ≤ d ∧
      CategoryTheory.CategoryStruct.comp u_bar (weilProjectiveSpaceOver k 1).hom = C_bar.hom ∧
      CategoryTheory.CategoryStruct.comp j_C u_bar =
        CategoryTheory.CategoryStruct.comp u_C ι_P1 ∧
      WeilTopDegFiniteLocallyFreeOfRank d u_bar ∧
      topologicalKrullDim (weilAltClosedComplIdeal C_bar.left j_C.opensRange).subscheme ≤
        (0 : WithBot ℕ∞) :=
by
  classical
  let _ := hιP1_hom
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let R₀ : Type u := Polynomial k
  let A1_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of R₀)
  let P1_ov := weilProjectiveSpaceOver k 1
  let P1 : AlgebraicGeometry.Scheme.{u} := P1_ov.left
  haveI hIrred_P1 : IrreducibleSpace ↥P1 := AlgebraicGeometry.irreducibleSpace_of_isIntegral P1
  haveI hSub_Sk : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  haveI hQS_Sk : QuasiSeparatedSpace ↥S_k := by
    change QuasiSeparatedSpace (PrimeSpectrum k)
    infer_instance
  haveI hQS_P1 : QuasiSeparatedSpace ↥P1 :=
    (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace P1_ov.hom).mp inferInstance

  
  let B_cat : CommRingCat.{u} := C.presheaf.obj (Opposite.op ⊤)
  let B : Type u := ↑B_cat
  let e_C : C ≅ AlgebraicGeometry.Spec B_cat := C.isoSpec
  have hSurj_eC : Function.Surjective e_C.hom.base := fun y =>
    ⟨e_C.inv.base y, by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, e_C.inv_hom_id]
      rfl⟩
  haveI hConn_B : ConnectedSpace (PrimeSpectrum B) := by
    have hConn_Spec : ConnectedSpace ↥(AlgebraicGeometry.Spec B_cat) :=
      hSurj_eC.connectedSpace e_C.hom.continuous
    exact hConn_Spec
  let φ_cat : CommRingCat.of R₀ ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_C.inv ≫ u_C)
  have hSpec_φ : AlgebraicGeometry.Spec.map φ_cat = e_C.inv ≫ u_C :=
    AlgebraicGeometry.Spec.map_preimage (e_C.inv ≫ u_C)
  have hEt_Specφ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_cat) := by
    rw [hSpec_φ]
    infer_instance
  have hEt_φhom : RingHom.Etale φ_cat.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Specφ
  letI : Algebra R₀ B := φ_cat.hom.toAlgebra
  haveI hEt_R₀B : Algebra.Etale R₀ B := RingHom.etale_algebraMap.mp hEt_φhom
  obtain ⟨hDom_B, hIC_B, hDed_B, _hInj_R₀B, hFrac_B⟩ :=
    weil_connected_etale_dedekind_domain_and_separable_frac R₀ B
  letI : IsDomain B := hDom_B
  letI : IsIntegrallyClosed B := hIC_B
  letI : IsDedekindDomain B := hDed_B
  haveI hNonempty_C : Nonempty ↥C := ConnectedSpace.toNonempty
  haveI hInt_C : AlgebraicGeometry.IsIntegral C :=
    @AlgebraicGeometry.isIntegral_of_isAffine_of_isDomain C _ hNonempty_C hDom_B
  haveI hIrred_C : IrreducibleSpace ↥C := AlgebraicGeometry.irreducibleSpace_of_isIntegral C

  
  have hOpen_inter : ∀ {X : Type u} [TopologicalSpace X] [IrreducibleSpace X]
      {U V : Set X}, IsOpen U → IsOpen V → U.Nonempty → V.Nonempty → (U ∩ V).Nonempty := by
    intro X _ _ U V hU hV hUne hVne
    obtain ⟨x, -, hxUV⟩ := PreirreducibleSpace.isPreirreducible_univ U V hU hV
      (by rwa [Set.univ_inter]) (by rwa [Set.univ_inter])
    exact ⟨x, hxUV⟩
  let e_poly_alg : MvPolynomial (Fin 1) k ≃ₐ[k] Polynomial k :=
    (MvPolynomial.finSuccEquiv k 0).trans
      (Polynomial.mapAlgEquiv (MvPolynomial.isEmptyAlgEquiv k (Fin 0)))
  let e_poly_ring : R₀ ≃+* MvPolynomial (Fin 1) k := e_poly_alg.symm.toRingEquiv
  have hDedCover : ∀ y : ↥P1, ∃ W : P1.Opens,
      y ∈ W ∧ AlgebraicGeometry.IsAffineOpen W ∧
        IsDedekindDomain ↑(P1.presheaf.obj (Opposite.op W)) := by
    intro y
    obtain ⟨U_k, _hAff_Uk, W, hW, hyW, he_W, hStd_W⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 P1_ov.hom).mp inferInstance y
    have hUk_top : U_k = ⊤ := by
      ext pt
      exact iff_of_true (by rw [hSub_Sk.elim pt (P1_ov.hom.base y)]; exact he_W hyW) trivial
    let iso_k : CommRingCat.of k ≅ S_k.presheaf.obj (Opposite.op U_k) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).symm ≪≫
        S_k.presheaf.mapIso (CategoryTheory.eqToIso hUk_top).op
    let A_W_cat : CommRingCat.{u} := P1.presheaf.obj (Opposite.op W)
    let A_W : Type u := ↑A_W_cat
    let g_W : S_k.presheaf.obj (Opposite.op U_k) ⟶ A_W_cat :=
      P1_ov.hom.appLE U_k W he_W
    have hStd_k : RingHom.IsStandardSmoothOfRelativeDimension 1 (g_W.hom.comp iso_k.hom.hom) :=
      (RingHom.isStandardSmoothOfRelativeDimension_respectsIso.cancel_left_isIso
        iso_k.hom g_W).mpr hStd_W
    obtain ⟨ψ_mv, _hψ_mv_comp, hψ_mv_et⟩ := hStd_k.exists_etale_mvPolynomial
    have hEt_R₀_AW : RingHom.Etale (ψ_mv.comp e_poly_ring.toRingHom) :=
      (RingHom.Etale.respectsIso.cancel_left_isIso
        e_poly_ring.toCommRingCatIso.hom (CommRingCat.ofHom ψ_mv)).mpr hψ_mv_et
    letI : Algebra R₀ A_W := (ψ_mv.comp e_poly_ring.toRingHom).toAlgebra
    haveI : Algebra.Etale R₀ A_W := RingHom.etale_algebraMap.mp hEt_R₀_AW
    haveI : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨y, hyW⟩⟩
    haveI hDom_AW : IsDomain A_W := AlgebraicGeometry.IsIntegral.component_integral W
    haveI : IrreducibleSpace (PrimeSpectrum A_W) := PrimeSpectrum.irreducibleSpace
    haveI : ConnectedSpace (PrimeSpectrum A_W) := IrreducibleSpace.connectedSpace (PrimeSpectrum A_W)
    have hDed_AW : IsDedekindDomain A_W :=
      (weil_connected_etale_dedekind_domain_and_separable_frac R₀ A_W).2.2.1
    exact ⟨W, hyW, hW, hDed_AW⟩

  
  let V₁ : P1.Opens := ι_P1.opensRange
  have hAff_V1 : AlgebraicGeometry.IsAffineOpen V₁ :=
    AlgebraicGeometry.isAffineOpen_opensRange ι_P1
  let A_V1_cat : CommRingCat.{u} := P1.presheaf.obj (Opposite.op V₁)
  let A_V1 : Type u := ↑A_V1_cat
  have hRange_V1 : Set.range ι_P1.base = Set.range hAff_V1.fromSpec.base :=
    hAff_V1.range_fromSpec.symm
  let lift_V1_to : A1_k ⟶ AlgebraicGeometry.Spec A_V1_cat :=
    AlgebraicGeometry.IsOpenImmersion.lift hAff_V1.fromSpec ι_P1 (le_of_eq hRange_V1)
  let lift_V1_from : AlgebraicGeometry.Spec A_V1_cat ⟶ A1_k :=
    AlgebraicGeometry.IsOpenImmersion.lift ι_P1 hAff_V1.fromSpec (le_of_eq hRange_V1.symm)
  have h_lift_1 : lift_V1_to ≫ lift_V1_from = 𝟙 A1_k := by
    rw [← CategoryTheory.cancel_mono ι_P1, CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsOpenImmersion.lift_fac, AlgebraicGeometry.IsOpenImmersion.lift_fac,
      CategoryTheory.Category.id_comp]
  have h_lift_2 : lift_V1_from ≫ lift_V1_to = 𝟙 (AlgebraicGeometry.Spec A_V1_cat) := by
    rw [← CategoryTheory.cancel_mono hAff_V1.fromSpec, CategoryTheory.Category.assoc,
      AlgebraicGeometry.IsOpenImmersion.lift_fac, AlgebraicGeometry.IsOpenImmersion.lift_fac,
      CategoryTheory.Category.id_comp]
  let φ_V1 : A_V1_cat ⟶ CommRingCat.of R₀ := AlgebraicGeometry.Spec.preimage lift_V1_to
  let φ_V1_inv : CommRingCat.of R₀ ⟶ A_V1_cat := AlgebraicGeometry.Spec.preimage lift_V1_from
  have hφ_V1_1 : φ_V1 ≫ φ_V1_inv = 𝟙 A_V1_cat := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, h_lift_2, AlgebraicGeometry.Spec.map_id]
  have hφ_V1_2 : φ_V1_inv ≫ φ_V1 = 𝟙 (CommRingCat.of R₀) := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, h_lift_1, AlgebraicGeometry.Spec.map_id]
  haveI hIso_φV1 : CategoryTheory.IsIso φ_V1 := ⟨⟨φ_V1_inv, hφ_V1_1, hφ_V1_2⟩⟩
  haveI hIso_φV1_inv : CategoryTheory.IsIso φ_V1_inv := ⟨⟨φ_V1, hφ_V1_2, hφ_V1_1⟩⟩
  let η_A1 : PrimeSpectrum R₀ :=
    ⟨⊥, ⟨bot_ne_top, fun {a b} hab => mul_eq_zero.mp hab⟩⟩
  haveI hNe_V1 : Nonempty ↥(V₁ : AlgebraicGeometry.Scheme.{u}) :=
    ⟨⟨ι_P1.base η_A1, ⟨η_A1, rfl⟩⟩⟩
  haveI hDom_AV1 : IsDomain A_V1 := AlgebraicGeometry.IsIntegral.component_integral V₁
  have hDed_AV1 : IsDedekindDomain A_V1 := by
    have hId : RingHom.Etale (CommRingCat.Hom.hom (𝟙 (CommRingCat.of R₀))) :=
      RingHom.etale_algebraMap.mpr (inferInstance : Algebra.Etale R₀ R₀)
    have hEt_inv : RingHom.Etale φ_V1_inv.hom :=
      (RingHom.Etale.respectsIso.cancel_right_isIso
        (𝟙 (CommRingCat.of R₀)) φ_V1_inv).mpr hId
    letI : Algebra R₀ A_V1 := φ_V1_inv.hom.toAlgebra
    haveI : Algebra.Etale R₀ A_V1 := RingHom.etale_algebraMap.mp hEt_inv
    haveI : IrreducibleSpace (PrimeSpectrum A_V1) := PrimeSpectrum.irreducibleSpace
    haveI : ConnectedSpace (PrimeSpectrum A_V1) :=
      IrreducibleSpace.connectedSpace (PrimeSpectrum A_V1)
    exact (weil_connected_etale_dedekind_domain_and_separable_frac R₀ A_V1).2.2.1

  have hη_A1_gen : ι_P1.base η_A1 = genericPoint ↥P1 := by
    have hGen : IsGenericPoint (ι_P1.base η_A1) Set.univ := by
      rw [isGenericPoint_def]
      apply Set.eq_univ_of_forall
      intro p
      rw [mem_closure_iff]
      intro G hG hpG
      have hInter : (G ∩ (V₁ : Set ↥P1)).Nonempty :=
        hOpen_inter hG V₁.isOpen ⟨p, hpG⟩ ⟨ι_P1.base η_A1, ⟨η_A1, rfl⟩⟩
      obtain ⟨_, hp_in_G, q_G, rfl⟩ := hInter
      have hOpen_pre : IsOpen (ι_P1.base ⁻¹' G) := ι_P1.continuous.isOpen_preimage G hG
      obtain ⟨B_open, ⟨_, ⟨f₀, rfl⟩, rfl⟩, hq_B, hB_sub⟩ :=
        PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open hp_in_G hOpen_pre
      have hf₀_not_mem : f₀ ∉ q_G.asIdeal := (PrimeSpectrum.mem_basicOpen f₀ q_G).mp hq_B
      have hf₀_ne : f₀ ≠ 0 := fun h0 => hf₀_not_mem (h0 ▸ q_G.asIdeal.zero_mem)
      have hη_mem_B : η_A1 ∈ PrimeSpectrum.basicOpen f₀ := by
        rw [PrimeSpectrum.mem_basicOpen]
        exact hf₀_ne
      exact ⟨ι_P1.base η_A1, hB_sub hη_mem_B, rfl⟩
    exact hGen.eq (genericPoint_spec ↥P1)

  have hNonGen : ∀ (W : P1.Opens), AlgebraicGeometry.IsAffineOpen W →
      Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) → ∃ z : ↥W, z.1 ≠ genericPoint ↥P1 := by
    intro W _hW hNeW
    obtain ⟨w₀⟩ := hNeW
    have hInter : ((W : Set ↥P1) ∩ (V₁ : Set ↥P1)).Nonempty :=
      hOpen_inter W.isOpen V₁.isOpen ⟨w₀.1, w₀.2⟩ ⟨ι_P1.base η_A1, ⟨η_A1, rfl⟩⟩
    obtain ⟨_, h_in_W, q₀, rfl⟩ := hInter
    have hOpen_O : IsOpen (ι_P1.base ⁻¹' (W : Set ↥P1)) :=
      ι_P1.continuous.isOpen_preimage _ W.isOpen
    obtain ⟨B_open, ⟨_, ⟨h_poly, rfl⟩, rfl⟩, hq₀_B, hB_sub⟩ :=
      PrimeSpectrum.isBasis_basic_opens.exists_subset_of_mem_open h_in_W hOpen_O
    have hh_not : h_poly ∉ q₀.asIdeal := (PrimeSpectrum.mem_basicOpen h_poly q₀).mp hq₀_B
    have hh_ne : h_poly ≠ 0 := fun h0 => hh_not (h0 ▸ q₀.asIdeal.zero_mem)
    haveI : Infinite k := inferInstance
    obtain ⟨a, ha_not⟩ := Infinite.exists_notMem_finset h_poly.roots.toFinset
    have ha_ev : Polynomial.eval a h_poly ≠ 0 := by
      intro h0
      exact ha_not (Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hh_ne).mpr h0))
    let ev_a : R₀ →+* k := Polynomial.evalRingHom a
    have hSurj_eva : Function.Surjective ev_a :=
      fun c => ⟨Polynomial.C c, Polynomial.eval_C⟩
    have hm_a : (RingHom.ker ev_a).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ev_a hSurj_eva
    let x_a : PrimeSpectrum R₀ := ⟨RingHom.ker ev_a, hm_a.isPrime⟩
    have hxa_B : x_a ∈ PrimeSpectrum.basicOpen h_poly := by
      rw [PrimeSpectrum.mem_basicOpen]
      exact ha_ev
    have hxa_W : ι_P1.base x_a ∈ W := hB_sub hxa_B
    have hxa_ne_η : x_a ≠ η_A1 := by
      intro heq
      have hmem : Polynomial.X - Polynomial.C a ∈ x_a.asIdeal := by
        change Polynomial.eval a (Polynomial.X - Polynomial.C a) = 0
        simp
      rw [heq] at hmem
      exact Polynomial.X_sub_C_ne_zero a hmem
    refine ⟨⟨ι_P1.base x_a, hxa_W⟩, ?_⟩
    rw [← hη_A1_gen]
    exact fun h_eq => hxa_ne_η (ι_P1.isOpenEmbedding.injective h_eq)

  
  let x_C : ↥C := genericPoint ↥C
  let x_P1 : ↥P1 := genericPoint ↥P1
  let K_cat : CommRingCat.{u} := C.functionField
  let K : Type u := ↑K_cat
  let K₀_cat : CommRingCat.{u} := P1.functionField
  let K₀ : Type u := ↑K₀_cat
  let η_C : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C := C.fromSpecStalk x_C
  let p_C : C ⟶ P1 := u_C ≫ ι_P1
  let ξ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ P1 := η_C ≫ p_C
  haveI hQC_ξ : AlgebraicGeometry.QuasiCompact ξ :=
    AlgebraicGeometry.quasiCompact_of_compactSpace ξ
  haveI hQS_ξ : AlgebraicGeometry.QuasiSeparated ξ :=
    (AlgebraicGeometry.quasiSeparated_iff_quasiSeparatedSpace ξ).mpr inferInstance

  have hpC_gen : p_C.base x_C = x_P1 := by
    haveI : AlgebraicGeometry.Etale p_C := by
      dsimp only [p_C]
      infer_instance
    have hGen : IsGenericPoint (p_C.base x_C) Set.univ := by
      rw [isGenericPoint_def]
      apply Set.eq_univ_of_forall
      intro y
      rw [mem_closure_iff]
      intro G hG hyG
      obtain ⟨c₀⟩ := hNonempty_C
      have hInter : (G ∩ Set.range p_C.base).Nonempty :=
        hOpen_inter hG p_C.isOpenMap.isOpen_range ⟨y, hyG⟩ ⟨p_C.base c₀, ⟨c₀, rfl⟩⟩
      obtain ⟨_, hc_G, c₁, rfl⟩ := hInter
      have hOpen_pre : IsOpen (p_C.base ⁻¹' G) := p_C.continuous.isOpen_preimage G hG
      have hxC_pre : x_C ∈ p_C.base ⁻¹' G :=
        ((genericPoint_spec ↥C).mem_open_set_iff hOpen_pre).mpr ⟨c₁, trivial, hc_G⟩
      exact ⟨p_C.base x_C, hxC_pre, rfl⟩
    exact hGen.eq (genericPoint_spec ↥P1)

  have hξ_gen : ∀ pt : ↥(AlgebraicGeometry.Spec (CommRingCat.of K)), ξ.base pt = x_P1 := by
    intro pt
    have hSub_K : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of K)) := by
      change Subsingleton (PrimeSpectrum K)
      infer_instance
    rw [hSub_K.elim pt (IsLocalRing.closedPoint K)]
    change p_C.base (η_C.base (IsLocalRing.closedPoint K)) = x_P1
    rw [AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint]
    exact hpC_gen

  let ψ_cat : K₀_cat ⟶ K_cat :=
    P1.presheaf.stalkSpecializes (specializes_of_eq hpC_gen) ≫ p_C.stalkMap x_C
  let ψ_K : K₀ →+* K := ψ_cat.hom

  have hpC_germ : ∀ (W : P1.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})],
      P1.germToFunctionField W ≫ ψ_cat =
        p_C.app W ≫ C.presheaf.germ ((TopologicalSpace.Opens.map p_C.base).obj W) x_C
          (by
            change p_C.base x_C ∈ W
            rw [hpC_gen]
            obtain ⟨w₀⟩ := ‹Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})›
            exact ((genericPoint_spec ↥P1).mem_open_set_iff W.isOpen).mpr ⟨w₀.1, trivial, w₀.2⟩) := by
    intro W hNeW
    dsimp only [ψ_cat, AlgebraicGeometry.Scheme.germToFunctionField]
    rw [← CategoryTheory.Category.assoc, TopCat.Presheaf.germ_stalkSpecializes,
      AlgebraicGeometry.Scheme.Hom.germ_stalkMap]

  have hξ_app : ∀ (W : P1.Opens) [Nonempty ↥(W : AlgebraicGeometry.Scheme.{u})]
      (he : ⊤ ≤ (TopologicalSpace.Opens.map ξ.base).obj W),
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Hom.appLE ξ W ⊤ he)
