        ((CategoryTheory.Category.assoc p_W (Fgt_W.obj U_W).hom π_leg).symm.trans
          ((congrArg (fun m => m ≫ π_leg)
              (CategoryTheory.Limits.pullback.condition
                (f := (Fgt_W.obj U_W).hom) (g := g'_W))).trans
            ((CategoryTheory.Category.assoc q_W g'_W π_leg).trans
              ((congrArg (CategoryTheory.CategoryStruct.comp q_W) h_sq).trans
