      letI : AddCommGroup M := instAddM
      letI : Module B M := instModM
      let eM_lin : M ≃ₗ[B] A :=
        { eM with
          map_smul' := fun b m => (heM b m).trans (Algebra.smul_def b (eM m)).symm }
      let bA : Module.Basis (Fin d) B A := bM.map eM_lin
      let q_pt : ↥(V_chart : TopologicalSpace.Opens ↥P1_over.left) := ⟨Q₀.1, hQ_in_V⟩
      let p_pt : ↥(U_chart : TopologicalSpace.Opens ↥C_bar.left) := ⟨P₀.1, hP_in_U⟩
      let p_Q : PrimeSpectrum B := hAff_V.primeIdealOf q_pt
      let m_Q : Ideal B := p_Q.asIdeal
      let p_P : PrimeSpectrum A := hAff_U.primeIdealOf p_pt
      let P_id : Ideal A := p_P.asIdeal
      have : m_Q.IsMaximal := by
        rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal p_Q]
        have hpre : hAff_V.fromSpec.base ⁻¹' ({Q₀.1} : Set ↥P1_over.left) = {p_Q} := by
          ext q
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          constructor
          · intro hq
            exact hAff_V.fromSpec.isOpenEmbedding.injective
              (hq.trans (hAff_V.fromSpec_primeIdealOf q_pt).symm)
          · rintro rfl
            exact hAff_V.fromSpec_primeIdealOf q_pt
        have hcl_pre : IsClosed (hAff_V.fromSpec.base ⁻¹' ({Q₀.1} : Set ↥P1_over.left)) :=
          Q₀.2.preimage hAff_V.fromSpec.continuous
        exact hpre ▸ hcl_pre
      have : P_id.IsMaximal := by
        rw [← PrimeSpectrum.isClosed_singleton_iff_isMaximal p_P]
        have hpre : hAff_U.fromSpec.base ⁻¹' ({P₀.1} : Set ↥C_bar.left) = {p_P} := by
          ext q
          simp only [Set.mem_preimage, Set.mem_singleton_iff]
          constructor
          · intro hq
            exact hAff_U.fromSpec.isOpenEmbedding.injective
              (hq.trans (hAff_U.fromSpec_primeIdealOf p_pt).symm)
          · rintro rfl
            exact hAff_U.fromSpec_primeIdealOf p_pt
        have hcl_pre : IsClosed (hAff_U.fromSpec.base ⁻¹' ({P₀.1} : Set ↥C_bar.left)) :=
