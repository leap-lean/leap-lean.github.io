theorem weil_etale_acyclic_comp_higherDirectImage_iso {W Y S : AlgebraicGeometry.Scheme.{u}}
    (g : Quiver.Hom W Y) (f : Quiver.Hom Y S)
    [_hc_g : (weilEtaleSitePullback g).IsContinuous Y.smallEtaleTopology W.smallEtaleTopology]
    (H : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u})
    (hAcyc : ∀ q : ℕ, 1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g q H))
    (b : ℕ) :
    Nonempty
      (CategoryTheory.Iso
        (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.comp g f) b H)
        (weilEtaleHigherDirectImage f b
