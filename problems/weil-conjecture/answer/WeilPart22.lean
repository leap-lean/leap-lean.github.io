    have hFT_φ : RingHom.FiniteType φ_cat.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hSpec_φ]
      infer_instance
    exact (RingHom.finiteType_respectsIso.cancel_left_isIso φ_V1 φ_cat).mpr hFT_φ
  haveI hFT_BV1_B : Algebra.FiniteType B_V1 B :=
    RingHom.FiniteType.of_comp_finiteType (hσ_comp.symm ▸ hFT_pC)
  haveI hOpen_σ : AlgebraicGeometry.IsOpenImmersion
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ)) :=
    weil_dedekind_birational_finiteType_spec_isOpenImmersion B_V1 B K

  let j_C : C ⟶ C_bar.left :=
    e_C.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ) ≫ hW₁.fromSpec
  have hOpen_jC : AlgebraicGeometry.IsOpenImmersion j_C := by
    dsimp only [j_C]
    infer_instance
  have hjC_ubar : j_C ≫ u_bar = u_C ≫ ι_P1 := by
    have hu_V1 : hW₁.fromSpec ≫ u_bar =
        AlgebraicGeometry.Spec.map (u_bar.app V₁) ≫ hAff_V1.fromSpec := by
      rw [← AlgebraicGeometry.Scheme.Hom.appLE_eq_app u_bar]
      exact (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec u_bar hAff_V1 hW₁ le_rfl).symm
    have hσ_cat : u_bar.app V₁ ≫ CommRingCat.ofHom σ = p_C.appLE V₁ ⊤ he_pC :=
      CommRingCat.hom_ext hσ_comp
    dsimp only [j_C]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hu_V1,
      ← CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ)),
      ← AlgebraicGeometry.Spec.map_comp, hσ_cat,
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p_C hAff_V1
        (AlgebraicGeometry.isAffineOpen_top C) he_pC,
      AlgebraicGeometry.IsAffineOpen.fromSpec_top (X := C),
      ← CategoryTheory.Category.assoc, e_C.hom_inv_id, CategoryTheory.Category.id_comp]

  
  have hFLF : WeilTopDegFiniteLocallyFreeOfRank d u_bar := by
    refine ⟨hFin_ubar, ?_⟩
    intro y
    obtain ⟨W, hyW, hW, hDedW⟩ := hDedCover y
    haveI : Nonempty ↥(W : AlgebraicGeometry.Scheme.{u}) := ⟨⟨y, hyW⟩⟩
    obtain ⟨hW', hDom_BW, _hIC_BW, _hDed_BW, hFin_W, _hKrull_BW,
        ι_K, hInj_ιK, hιK_comp, hFrac_BW, _⟩ :=
      hChart_norm W hW hDedW
    let A_W_cat : CommRingCat.{u} := P1.presheaf.obj (Opposite.op W)
    let A_W : Type u := ↑A_W_cat
    let W' : Y.Opens := (TopologicalSpace.Opens.map u_bar.base).obj W
    let B_W_cat : CommRingCat.{u} := Y.presheaf.obj (Opposite.op W')
    let B_W : Type u := ↑B_W_cat
    letI : IsDomain B_W := hDom_BW
    letI : Algebra A_W K₀ := (P1.germToFunctionField W).hom.toAlgebra
    haveI : IsFractionRing A_W K₀ :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen P1 W hW
    letI : Algebra B_W K := ι_K.toAlgebra
    haveI : IsFractionRing B_W K := hFrac_BW
    letI : Algebra A_W B_W := (u_bar.app W).hom.toAlgebra
    haveI : Module.Finite A_W B_W := hFin_W
    letI : Algebra A_W K := (ψ_K.comp (P1.germToFunctionField W).hom).toAlgebra
    haveI : IsScalarTower A_W K₀ K := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower A_W B_W K := IsScalarTower.of_algebraMap_eq' hιK_comp.symm
    let p_y : PrimeSpectrum A_W := hW.primeIdealOf ⟨y, hyW⟩
    obtain ⟨g, v, hg_not_mem, hv_span, hv_indep⟩ :=
      weil_dedekind_finite_torsionFree_away_free_basis A_W K₀ B_W K p_y.asIdeal
    let V : P1.Opens := P1.basicOpen g
    have hyV : y ∈ V := by
      have hmem : p_y ∈ PrimeSpectrum.basicOpen g :=
        (PrimeSpectrum.mem_basicOpen g p_y).mpr hg_not_mem
      rw [← hW.fromSpec_preimage_basicOpen g] at hmem
      change hW.fromSpec.base p_y ∈ V at hmem
      rwa [hW.fromSpec_primeIdealOf ⟨y, hyW⟩] at hmem
    have hV_aff : AlgebraicGeometry.IsAffineOpen V := hW.basicOpen g
    let g' : B_W := (u_bar.app W).hom g
    let V' : Y.Opens := (TopologicalSpace.Opens.map u_bar.base).obj V
    have hV'_eq : V' = Y.basicOpen g' :=
      AlgebraicGeometry.Scheme.Hom.preimage_basicOpen u_bar g
    have hV'_aff : AlgebraicGeometry.IsAffineOpen V' := hV'_eq ▸ hW'.basicOpen g'
    let A_V_cat : CommRingCat.{u} := P1.presheaf.obj (Opposite.op V)
    let A_V : Type u := ↑A_V_cat
    let B_V_cat : CommRingCat.{u} := Y.presheaf.obj (Opposite.op V')
    let B_V : Type u := ↑B_V_cat
    have hle_VW : V ≤ W := P1.basicOpen_le g
    have hle_V'W' : V' ≤ W' := fun _ hz => hle_VW hz
    let res_A : A_W →+* A_V := (P1.presheaf.map (CategoryTheory.homOfLE hle_VW).op).hom
    let res_B : B_W →+* B_V := (Y.presheaf.map (CategoryTheory.homOfLE hle_V'W').op).hom
    let φ_V : A_V →+* B_V := (u_bar.app V).hom
    have hNat_AV : ∀ a : A_W, φ_V (res_A a) = res_B ((u_bar.app W).hom a) := by
      intro a
      have hnat := AlgebraicGeometry.Scheme.Hom.naturality u_bar
        (CategoryTheory.homOfLE hle_VW).op
      exact congrArg (fun f : A_W_cat ⟶ B_V_cat => f.hom a) hnat
    letI : Algebra A_W A_V := res_A.toAlgebra
    haveI : IsLocalization.Away g A_V := hW.isLocalization_basicOpen g
    letI : Algebra B_W B_V := res_B.toAlgebra
    haveI : IsLocalization.Away g' B_V :=
      hW'.isLocalization_of_eq_basicOpen g' (CategoryTheory.homOfLE hle_V'W') hV'_eq
    have hg_ne : g ≠ 0 := fun h0 => hg_not_mem (h0 ▸ p_y.asIdeal.zero_mem)
    have hg'_ne : g' ≠ 0 := by
      intro h0
      have h1 : ι_K g' = ψ_K ((P1.germToFunctionField W).hom g) :=
        congrArg (fun f : A_W →+* K => f g) hιK_comp
      have h2 : ψ_K ((P1.germToFunctionField W).hom g) =
          ψ_K ((P1.germToFunctionField W).hom 0) := by
        rw [← h1, h0, map_zero, map_zero, map_zero]
      exact hg_ne (AlgebraicGeometry.Scheme.germToFunctionField_injective P1 W
        (ψ_K.injective h2))
    haveI hDom_AW : IsDomain A_W := AlgebraicGeometry.IsIntegral.component_integral W
    have hinj_resB : Function.Injective res_B :=
      IsLocalization.injective B_V
        (Submonoid.powers_le.mpr (mem_nonZeroDivisors_iff_ne_zero.mpr hg'_ne))
    let M : Type u := Fin d → A_V
    let e₀ : M →+ B_V :=
      { toFun := fun m => ∑ i : Fin d, φ_V (m i) * res_B (v i)
        map_zero' := by
          change ∑ i : Fin d, φ_V (0 : A_V) * res_B (v i) = 0
          simp only [map_zero, zero_mul, Finset.sum_const_zero]
        map_add' := fun m₁ m₂ => by
          change ∑ i : Fin d, φ_V (m₁ i + m₂ i) * res_B (v i) =
            (∑ i : Fin d, φ_V (m₁ i) * res_B (v i)) + ∑ i : Fin d, φ_V (m₂ i) * res_B (v i)
          simp only [map_add, add_mul, Finset.sum_add_distrib] }
    have he₀_bij : Function.Bijective e₀ := by
      refine ⟨?_, ?_⟩
      · intro m₁ m₂ hm_eq
        have hm0 : e₀ (m₁ - m₂) = 0 := by rw [map_sub, hm_eq, sub_self]
        suffices hdiff : m₁ - m₂ = 0 by exact sub_eq_zero.mp hdiff
        set m := m₁ - m₂
        let N : ℕ := Finset.univ.sup (fun i : Fin d => (IsLocalization.Away.sec g (m i)).2)
        let c : Fin d → A_W := fun i =>
          g ^ (N - (IsLocalization.Away.sec g (m i)).2) * (IsLocalization.Away.sec g (m i)).1
        have hclear : ∀ i : Fin d, res_A (g ^ N) * m i = res_A (c i) := by
          intro i
          let k_i : ℕ := (IsLocalization.Away.sec g (m i)).2
          let q_i : ℕ := N - k_i
          have hle_i : k_i ≤ N :=
            Finset.le_sup (f := fun j : Fin d => (IsLocalization.Away.sec g (m j)).2)
              (Finset.mem_univ i)
          have hN_eq : g ^ N = g ^ q_i * g ^ k_i := by
            rw [← pow_add, Nat.sub_add_cancel hle_i]
          have hsec : m i * res_A (g ^ k_i) =
              res_A ((IsLocalization.Away.sec g (m i)).1) :=
            IsLocalization.Away.sec_spec g (m i)
          calc
            res_A (g ^ N) * m i
              = res_A (g ^ q_i) * (m i * res_A (g ^ k_i)) := by
                rw [hN_eq, map_mul, mul_assoc, mul_comm (res_A (g ^ k_i)) (m i)]
            _ = res_A (c i) := by
                rw [hsec, ← map_mul]
        have hsum0 : res_B (∑ i : Fin d, (u_bar.app W).hom (c i) * v i) = 0 := by
          calc
            res_B (∑ i : Fin d, (u_bar.app W).hom (c i) * v i)
              = ∑ i : Fin d, φ_V (res_A (c i)) * res_B (v i) := by
                rw [map_sum]
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [map_mul, hNat_AV]
            _ = ∑ i : Fin d, φ_V (res_A (g ^ N)) * (φ_V (m i) * res_B (v i)) := by
                refine Finset.sum_congr rfl (fun i _ => ?_)
                rw [← hclear i, map_mul, mul_assoc]
            _ = φ_V (res_A (g ^ N)) * e₀ m := (Finset.mul_sum _ _ _).symm
            _ = 0 := by rw [hm0, mul_zero]
        have hc0 : ∀ i : Fin d, c i = 0 :=
          hv_indep c (hinj_resB (hsum0.trans (map_zero res_B).symm))
        have hu_g : IsUnit (res_A g ^ N) :=
          (IsLocalization.Away.algebraMap_isUnit g).pow N
        funext i
        have hmi0 : res_A g ^ N * m i = 0 := by
          rw [← map_pow, hclear i, hc0 i, map_zero]
        exact hu_g.mul_right_eq_zero.mp hmi0
      · intro z
        let x : B_W := (IsLocalization.Away.sec g' z).1
        let n : ℕ := (IsLocalization.Away.sec g' z).2
        have hsec_z : z * res_B (g' ^ n) = res_B x := IsLocalization.Away.sec_spec g' z
        obtain ⟨c, hc_span⟩ := hv_span x
        have hc_span' : g' * x = ∑ i : Fin d, (u_bar.app W).hom (c i) * v i := hc_span
        let u_g : A_Vˣ := (IsLocalization.Away.algebraMap_isUnit g).unit
        have hug_val : (u_g : A_V) = res_A g := rfl
        let m : M := fun i => ((u_g ^ (n + 1))⁻¹ : A_Vˣ).val * res_A (c i)
        refine ⟨m, ?_⟩
        let u_BV : B_Vˣ := Units.map φ_V.toMonoidHom (u_g ^ (n + 1))
        have hu_BV_val : (u_BV : B_V) = res_B (g' ^ (n + 1)) := by
          change φ_V ((u_g : A_V) ^ (n + 1)) = res_B (g' ^ (n + 1))
          rw [hug_val, map_pow, hNat_AV, ← map_pow]
        apply Units.mul_right_inj u_BV |>.mp
        calc
          (u_BV : B_V) * e₀ m
            = ∑ i : Fin d, ((u_BV : B_V) * φ_V (m i)) * res_B (v i) := by
              change (u_BV : B_V) * ∑ i : Fin d, φ_V (m i) * res_B (v i) = _
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl (fun i _ => (mul_assoc _ _ _).symm)
          _ = ∑ i : Fin d, φ_V (res_A (c i)) * res_B (v i) := by
              refine Finset.sum_congr rfl (fun i _ => ?_)
              congr 1
              change φ_V ((u_g ^ (n + 1) : A_Vˣ).val) *
                  φ_V (((u_g ^ (n + 1))⁻¹ : A_Vˣ).val * res_A (c i)) =
                φ_V (res_A (c i))
              rw [← map_mul, ← mul_assoc, Units.mul_inv, one_mul]
          _ = res_B (∑ i : Fin d, (u_bar.app W).hom (c i) * v i) := by
              rw [map_sum]
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [map_mul, ← hNat_AV]
          _ = res_B (g' * x) := by rw [← hc_span']
          _ = res_B g' * (z * res_B (g' ^ n)) := by rw [map_mul, ← hsec_z]
          _ = (u_BV : B_V) * z := by
              rw [hu_BV_val, pow_succ', map_mul, mul_comm z (res_B (g' ^ n)), mul_assoc]
    let e_equiv : M ≃+ B_V := AddEquiv.ofBijective e₀ he₀_bij
    refine ⟨V, hyV, hV_aff, hV'_aff, M, inferInstance, inferInstance, e_equiv, ?_,
      ⟨Pi.basisFun A_V (Fin d)⟩⟩
    intro b m
    change ∑ i : Fin d, φ_V (b * m i) * res_B (v i) =
      φ_V b * ∑ i : Fin d, φ_V (m i) * res_B (v i)
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun i _ => by rw [map_mul, mul_assoc])

  
  have hBdry_dim :
      letI : AlgebraicGeometry.IsOpenImmersion j_C := hOpen_jC
      topologicalKrullDim (weilAltClosedComplIdeal C_bar.left j_C.opensRange).subscheme ≤
        (0 : WithBot ℕ∞) := by
    letI : AlgebraicGeometry.IsOpenImmersion j_C := hOpen_jC
    let Z_closed : TopologicalSpace.Closeds ↥C_bar.left :=
      ⟨(j_C.opensRange : Set ↥C_bar.left)ᶜ, j_C.opensRange.isOpen.isClosed_compl⟩
    let I_Z : C_bar.left.IdealSheafData := weilAltClosedComplIdeal C_bar.left j_C.opensRange
    have hemb : Topology.IsClosedEmbedding I_Z.subschemeι.base :=
      AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding I_Z.subschemeι
    have hHomeo_dim : topologicalKrullDim I_Z.subscheme =
        topologicalKrullDim ↥(Set.range I_Z.subschemeι.base) :=
      hemb.isEmbedding.toHomeomorph.isHomeomorph.topologicalKrullDim_eq
    have hRange_IZ : Set.range I_Z.subschemeι.base = (Z_closed : Set ↥C_bar.left) := by
      rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι]
      exact AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal Z_closed
    rw [hHomeo_dim, hRange_IZ]
    let Z_set : Set ↥C_bar.left := (j_C.opensRange : Set ↥C_bar.left)ᶜ
    change Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z_set) ≤ (0 : WithBot ℕ∞)
    letI : AlgebraicGeometry.IsIntegral C_bar.left := hInt_Y
    haveI : IrreducibleSpace ↥C_bar.left :=
      AlgebraicGeometry.irreducibleSpace_of_isIntegral C_bar.left
    have hNoLt : ∀ S₁ S₂ : TopologicalSpace.IrreducibleCloseds ↥Z_set, ¬ (S₁ < S₂) := by
      intro S₁ S₂ hlt
      let pushZ : TopologicalSpace.IrreducibleCloseds ↥Z_set →
          TopologicalSpace.IrreducibleCloseds ↥C_bar.left := fun S =>
        ⟨Subtype.val '' (S : Set ↥Z_set),
         S.isIrreducible'.image Subtype.val continuous_subtype_val.continuousOn,
         Z_closed.isClosed.isClosedMap_subtype_val (S : Set ↥Z_set) S.isClosed'⟩
      have hPush_lt : pushZ S₁ < pushZ S₂ := by
        refine lt_of_le_of_ne (Set.image_mono (le_of_lt hlt)) ?_
        intro hEq
        have hImg_eq : Subtype.val '' (S₁ : Set ↥Z_set) = Subtype.val '' (S₂ : Set ↥Z_set) :=
          congrArg SetLike.coe hEq
        have hSet_eq : (S₁ : Set ↥Z_set) = (S₂ : Set ↥Z_set) := by
          ext z
          constructor <;> intro hz
          · obtain ⟨z', hz', heq⟩ := (Set.ext_iff.mp hImg_eq z.1).mp ⟨z, hz, rfl⟩
            exact Subtype.ext heq ▸ hz'
          · obtain ⟨z', hz', heq⟩ := (Set.ext_iff.mp hImg_eq z.1).mpr ⟨z, hz, rfl⟩
            exact Subtype.ext heq ▸ hz'
        exact ne_of_lt hlt (SetLike.ext' hSet_eq)
      let T_univ : TopologicalSpace.IrreducibleCloseds ↥C_bar.left :=
        ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥C_bar.left, isClosed_univ⟩
      have hPush_lt_univ : pushZ S₂ < T_univ := by
        refine lt_of_le_of_ne (Set.subset_univ _) ?_
        obtain ⟨c₀⟩ := hNonempty_C
        intro hUniv
        have hImg_univ : Subtype.val '' (S₂ : Set ↥Z_set) = Set.univ :=
          congrArg SetLike.coe hUniv
        have hc₀_univ : j_C.base c₀ ∈ Subtype.val '' (S₂ : Set ↥Z_set) := by
          rw [hImg_univ]
          trivial
        rcases hc₀_univ with ⟨⟨z, hz_compl⟩, _, hz_eq⟩
        exact hz_compl ⟨c₀, hz_eq.symm⟩
      let bad_series : LTSeries (TopologicalSpace.IrreducibleCloseds ↥C_bar.left) :=
        RelSeries.mk 2 ![pushZ S₁, pushZ S₂, T_univ] (fun i => by
          match i with
          | ⟨0, _⟩ => exact hPush_lt
          | ⟨1, _⟩ => exact hPush_lt_univ)
      have hDim_lt2 : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥C_bar.left) <
          ((2 : ℕ) : WithBot ℕ∞) := by
        change topologicalKrullDim C_bar.left < ((2 : ℕ) : WithBot ℕ∞)
        rw [hDim_Cbar]
        exact WithBot.coe_lt_coe.mpr (ENat.coe_lt_coe.mpr Nat.one_lt_two)
      have hLen_lt2 : bad_series.length < 2 :=
        (Order.krullDim_lt_coe_iff (n := 2)).mp hDim_lt2 bad_series
      exact Nat.lt_irrefl 2 hLen_lt2
    have hLt_one : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z_set) <
        ((1 : ℕ) : WithBot ℕ∞) := by
      rw [Order.krullDim_lt_coe_iff]
      intro l
      by_contra hge
      have hpos : 0 < l.length := Nat.pos_of_ne_zero (fun h0 => hge (h0 ▸ Nat.zero_lt_one))
      exact hNoLt (l ⟨0, Nat.succ_pos _⟩) (l ⟨1, Nat.succ_lt_succ hpos⟩) (l.step ⟨0, hpos⟩)
    rcases h_kd : Order.krullDim (TopologicalSpace.IrreducibleCloseds ↥Z_set) with _ | m
    · exact bot_le
    · rw [h_kd] at hLt_one
      cases m with
      | top => exact absurd hLt_one (not_lt_of_ge (WithBot.coe_le_coe.mpr le_top))
      | coe n =>
        have hn : n < 1 := by
          exact_mod_cast (WithBot.coe_lt_coe.mp hLt_one)
        have hn0 : n = 0 := Nat.lt_one_iff.mp hn
        subst hn0
        exact le_rfl

  exact ⟨C_bar, j_C, hOpen_jC, d, u_bar, hInt_Y, hProj_Cbar, hProp_Cbar, hSmooth_Cbar,
    hd_ge_one, rfl, hjC_ubar, hFLF, hBdry_dim⟩

theorem weil_polyP1_pinned_curve_completion_mod_prime_trace_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (ζ : ℕ → kˣ)
    (hPrim : ∀ r : ℕ, IsPrimitiveRoot ((ζ r : kˣ) : k) (ℓ ^ r))
    (hPow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff)
    (tr_Pd : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r))
    (hBij : ∀ (δ r : ℕ), Function.Bijective (tr_Pd δ r))
    (hTrace : WeilIsPolyP1PinnedKummerLerayTrace k ℓ ζ ι_P1 tr_Pd) :
    Nat.card (weilEtaleTorsionH (weilProjectiveSpaceOver k 1).left ℓ 2) = ℓ ∧
    ∀ (C : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine C] [Nonempty ↥C]
      (u_C : Quiver.Hom C (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))))
      (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (j_C : Quiver.Hom C C_bar.left)
      (d : ℕ)
      (u_bar : Quiver.Hom C_bar.left (weilProjectiveSpaceOver k 1).left)
      [AlgebraicGeometry.Etale u_C]
      [AlgebraicGeometry.IsIntegral C_bar.left]
      (_hProj_Cbar : IsProjectiveOverField k C_bar)
      [AlgebraicGeometry.IsProper C_bar.hom]
      [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom]
      [AlgebraicGeometry.IsOpenImmersion j_C],
      1 ≤ d →
      CategoryTheory.CategoryStruct.comp u_bar (weilProjectiveSpaceOver k 1).hom =
        C_bar.hom →
      CategoryTheory.CategoryStruct.comp j_C u_bar =
        CategoryTheory.CategoryStruct.comp u_C ι_P1 →
      WeilTopDegFiniteLocallyFreeOfRank d u_bar →
      topologicalKrullDim (weilAltClosedComplIdeal C_bar.left j_C.opensRange).subscheme ≤
        (0 : WithBot ℕ∞) →
      ∀ (hEt_pC : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp u_C ι_P1)),
        let U_C : (weilProjectiveSpaceOver k 1).left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.comp u_C ι_P1) hEt_pC
        (∀ q : ℕ, 3 ≤ q →
