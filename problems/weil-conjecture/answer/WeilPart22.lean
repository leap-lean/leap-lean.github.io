  have h_sq : CategoryTheory.CategoryStruct.comp g'_W π_leg =
      CategoryTheory.CategoryStruct.comp π_leg_σ ι_σ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc g'_W π_leg fst_P).trans
        ((congrArg (fun m => g'_W ≫ (π_leg ≫ m)) hπ_eq.symm).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp g'_W) hg).trans
            ((CategoryTheory.Limits.pullback.condition (f := π_W) (g := σ)).trans
              ((congrArg (fun m => m ≫ σ) hπ_σ_over.symm).trans
                ((CategoryTheory.Category.assoc π_leg_σ P1_over.hom σ).trans
