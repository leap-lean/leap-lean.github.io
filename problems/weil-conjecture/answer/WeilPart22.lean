      have hTop₁ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := PEt) (Q := PEt) Z₁ le_rfl
      have hS' : S ∈ (AlgebraicGeometry.Scheme.smallPretopology PEt PEt (S := Z₂)).toGrothendieck U :=
        Eq.mp (congrArg (fun J => S ∈ J U) hTop₂) hS
      obtain ⟨R, hR, hRS⟩ := (CategoryTheory.Pretopology.mem_toGrothendieck _ U S).mp hS'
      apply Eq.mpr (congrArg (fun J => CategoryTheory.Sieve.functorPushforward B_h S ∈ J (B_h.obj U)) hTop₁)
      apply (CategoryTheory.Pretopology.mem_toGrothendieck _ (B_h.obj U) _).mpr
