          ∀ x : D, ∃ a t : A, t ∉ p.asIdeal ∧ ι_A a = ι_A t * j_D x := by
        intro D _ ρ_D j_D hInt_D hj_DC hj_DX x
        have hPoly_mem : ∀ P : Polynomial k, j_D (ρ_D P) ∈ ι_R.range := by
          intro P
          induction P using Polynomial.induction_on' with
          | add P₁ P₂ ih₁ ih₂ =>
            rw [map_add, map_add]
            exact ι_R.range.add_mem ih₁ ih₂
          | monomial n c =>
            have hmon : Polynomial.monomial n c = Polynomial.C c * Polynomial.X ^ n :=
              Polynomial.C_mul_X_pow_eq_monomial.symm
            rw [hmon, map_mul, map_mul, map_pow, map_pow]
            obtain ⟨a_c, hac⟩ := hk_A c
            have hc_mem : j_D (ρ_D (Polynomial.C c)) ∈ ι_R.range := by
              refine ⟨algebraMap A R a_c, ?_⟩
              rw [hι_R_eq a_c, hac]
              exact (DFunLike.congr_fun hj_DC c).symm
            exact ι_R.range.mul_mem hc_mem (ι_R.range.pow_mem hj_DX n)
        let e_R : R ≃+* ↥ι_R.range :=
          RingEquiv.ofBijective ι_R.rangeRestrict
            ⟨fun u v huv => hInj_R (congrArg Subtype.val huv), ι_R.rangeRestrict_surjective⟩
        let ρ_tilde : Polynomial k →+* R :=
          e_R.symm.toRingHom.comp ((j_D.comp ρ_D).codRestrict ι_R.range hPoly_mem)
        have hρ_tilde : ι_R.comp ρ_tilde = j_D.comp ρ_D :=
          RingHom.ext fun P => congrArg Subtype.val (e_R.apply_symm_apply _)
        obtain ⟨Q, hQ_monic, hQ_ev⟩ := hInt_D x
        have hjx_mem : ∃ r : R, ι_R r = j_D x := by
          letI : Algebra R K₀ := ι_R.toAlgebra
          have hInt_jx : _root_.IsIntegral R (j_D x) := by
            refine ⟨Q.map ρ_tilde, hQ_monic.map ρ_tilde, ?_⟩
            change Polynomial.eval₂ ι_R (j_D x) (Q.map ρ_tilde) = 0
            rw [Polynomial.eval₂_map, hρ_tilde]
            have hhom := Polynomial.hom_eval₂ Q ρ_D j_D x
            rw [hQ_ev, map_zero] at hhom
            exact hhom.symm
          exact (@isIntegrallyClosed_iff R _ K₀ _ ι_R.toAlgebra hFrac_R).mp hIC_R hInt_jx
        obtain ⟨r, hr⟩ := hjx_mem
        obtain ⟨⟨a, t⟩, hrt⟩ := IsLocalization.surj p.asIdeal.primeCompl r
        dsimp only at hrt
        refine ⟨a, t.1, t.2, ?_⟩
        have hmap := congrArg ι_R hrt
        rw [map_mul, hr, hι_R_eq t.1, hι_R_eq a, mul_comm] at hmap
        exact hmap.symm
      have hVal_u₀ : @IsLocalization.IsInteger R _ K₀ _ ι_R.toAlgebra u_val ∨
          @IsLocalization.IsInteger R _ K₀ _ ι_R.toAlgebra u_val⁻¹ :=
        @ValuationRing.isInteger_or_isInteger R _ _ K₀ _ ι_R.toAlgebra hFrac_R _ u_val
      rcases hVal_u₀ with ⟨r₀, hr₀⟩ | ⟨r₁, hr₁⟩
      · change ι_R r₀ = u_val at hr₀
        have hX₀_mem : j₀ (ρ₀ Polynomial.X) ∈ ι_R.range := by
          rw [hj₀_X]
          obtain ⟨a_a₀, ha_a₀⟩ := hk_A a₀
          refine ι_R.range.add_mem ⟨r₀, hr₀⟩ ⟨algebraMap A R a_a₀, ?_⟩
          rw [hι_R_eq a_a₀, ha_a₀]
        have hElem₀ := hCapture D₀ ρ₀ j₀ hInt₀ hj₀_C hX₀_mem
        obtain ⟨s, ι_As, γ₀, hs_not_p, hι_As_comp, hγ₀⟩ :=
          hClear D₀ (ρ₀.comp Polynomial.C) j₀ hFT₀ hj₀_C hElem₀
        exact ⟨s, ι_As, hs_not_p, hι_As_comp, Or.inl ⟨γ₀, hγ₀⟩⟩
      · change ι_R r₁ = u_val⁻¹ at hr₁
        have hX₁_mem : j₁ (ρ₁ Polynomial.X) ∈ ι_R.range := by
          have hX₁_eq : j₁ (ρ₁ Polynomial.X) = u_val⁻¹ :=
            mul_right_cancel₀ hu₀ (hj₁_X.trans (inv_mul_cancel₀ hu₀).symm)
          rw [hX₁_eq]
          exact ⟨r₁, hr₁⟩
        have hElem₁ := hCapture D₁ ρ₁ j₁ hInt₁ hj₁_C hX₁_mem
        obtain ⟨s, ι_As, γ₁, hs_not_p, hι_As_comp, hγ₁⟩ :=
          hClear D₁ (ρ₁.comp Polynomial.C) j₁ hFT₁ hj₁_C hElem₁
        exact ⟨s, ι_As, hs_not_p, hι_As_comp, Or.inr ⟨γ₁, hγ₁⟩⟩
  intro K κ_K u₀
  obtain ⟨hIC_B, hInj_φ, hFT_φ, d, φ_K, hd, hφ_K, hFinDim, hSep, hRank⟩ :=
    h_s1 (FractionRing (Polynomial k)) K
  have hInj_BK : Function.Injective (algebraMap B K) := IsFractionRing.injective B K
  have hu₀ : u₀ ≠ 0 := by
    intro h0
    have hφ0 : φ (Polynomial.X - Polynomial.C a₀) = 0 :=
      hInj_BK (h0.trans (map_zero (algebraMap B K)).symm)
    exact Polynomial.X_sub_C_ne_zero a₀ (hInj_φ (hφ0.trans (map_zero φ).symm))
  have hB_units : ∀ y : nonZeroDivisors B, IsUnit (algebraMap B K y.1) :=
    IsLocalization.map_units K
  have hB_surj : ∀ z : K, ∃ x : B × nonZeroDivisors B,
      z * algebraMap B K x.2.1 = algebraMap B K x.1 :=
    IsLocalization.surj (nonZeroDivisors B)
  have hB_eq : ∀ {x₁ x₂ : B}, algebraMap B K x₁ = algebraMap B K x₂ →
      ∃ c : nonZeroDivisors B, c.1 * x₁ = c.1 * x₂ :=
    fun h => IsLocalization.exists_of_eq (M := nonZeroDivisors B) h
  have hFracB_toAlg : @IsFractionRing B _ K _ (algebraMap B K).toAlgebra := by
    letI : Algebra B K := (algebraMap B K).toAlgebra
    exact { map_units := hB_units, surj := hB_surj, exists_of_eq := hB_eq }
  have hClauseA : ∀ (S : Type u) [CommRing S] [IsDomain S] [IsIntegrallyClosed S]
      (ρ : Polynomial k →+* S) (ι_S : S →+* K),
      @IsFractionRing S _ K _ ι_S.toAlgebra →
      (ι_S.comp ρ = (algebraMap B K).comp φ ∨
        (ι_S.comp (ρ.comp Polynomial.C) = κ_K ∧ ι_S (ρ Polynomial.X) * u₀ = 1)) →
      letI : Algebra (Polynomial k) S := ρ.toAlgebra
      let A := ↥(integralClosure (Polynomial k) S)
      IsDomain A ∧
      IsIntegrallyClosed A ∧
      IsNoetherianRing A ∧
      ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) ∧
      ((algebraMap (Polynomial k) A).comp Polynomial.C).FiniteType ∧
      @IsFractionRing A _ K _
        (ι_S.comp (Subalgebra.val (integralClosure (Polynomial k) S)).toRingHom).toAlgebra ∧
      (algebraMap (Polynomial k) A).Finite ∧
      ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module (Polynomial k) M) (e : M ≃+ A),
        (∀ (p : Polynomial k) (m : M), e (p • m) = algebraMap (Polynomial k) A p * e m) ∧
        Nonempty (Module.Basis (Fin d) (Polynomial k) M) := by
    intro S _ _ _ ρ ι_S hFracS hChart
    exact h_s2 K d ((algebraMap B K).comp φ) φ_K hφ_K hFinDim hSep hRank S ρ ι_S hFracS hChart
  refine ⟨hIC_B, hInj_φ, hu₀, d, hd, hClauseA, ?_, ?_⟩
  · dsimp only
    haveI : IsIntegrallyClosed B := hIC_B
    letI : Algebra (Polynomial k) B := φ.toAlgebra
    let A₀ := ↥(integralClosure (Polynomial k) B)
    let j_B : A₀ →+* B := (Subalgebra.val (integralClosure (Polynomial k) B)).toRingHom
    obtain ⟨hDom_A₀, hIC_A₀, hNoeth_A₀, hDim_A₀, _, hFrac_A₀, _, _⟩ :=
      hClauseA B φ (algebraMap B K) hFracB_toAlg (Or.inl rfl)
    haveI : IsDomain A₀ := hDom_A₀
    haveI : IsIntegrallyClosed A₀ := hIC_A₀
    haveI : IsNoetherianRing A₀ := hNoeth_A₀
    have hj_comp : j_B.comp (algebraMap (Polynomial k) A₀) = φ := rfl
    have hj_FT : j_B.FiniteType := RingHom.FiniteType.of_comp_finiteType (hj_comp ▸ hFT_φ)
    intro q
    exact h_s3 A₀ hDim_A₀ B K j_B (algebraMap B K) hj_FT hFracB_toAlg hFrac_A₀ q
  · intro A _ _ _ _ hDimA ι_A hFracA hk_A p S₀ S₁ _ _ _ _ _ _ ρ₀ ι_S₀ ρ₁ ι_S₁
      hFracS₀ hρ₀ hFracS₁ hρ₁_C hρ₁_X
    obtain ⟨_, _, _, _, hFT₀, _, _, _⟩ := hClauseA S₀ ρ₀ ι_S₀ hFracS₀ (Or.inl hρ₀)
    obtain ⟨_, _, _, _, hFT₁, _, _, _⟩ := hClauseA S₁ ρ₁ ι_S₁ hFracS₁ (Or.inr ⟨hρ₁_C, hρ₁_X⟩)
    letI : Algebra (Polynomial k) S₀ := ρ₀.toAlgebra
    letI : Algebra (Polynomial k) S₁ := ρ₁.toAlgebra
    let D₀ := ↥(integralClosure (Polynomial k) S₀)
    let D₁ := ↥(integralClosure (Polynomial k) S₁)
    let j₀ : D₀ →+* K := ι_S₀.comp (Subalgebra.val (integralClosure (Polynomial k) S₀)).toRingHom
    let j₁ : D₁ →+* K := ι_S₁.comp (Subalgebra.val (integralClosure (Polynomial k) S₁)).toRingHom
    have hInt₀ : _root_.RingHom.IsIntegral (algebraMap (Polynomial k) D₀) :=
      fun x => integralClosure.isIntegral x
    have hInt₁ : _root_.RingHom.IsIntegral (algebraMap (Polynomial k) D₁) :=
      fun x => integralClosure.isIntegral x
    have hj₀_C : j₀.comp ((algebraMap (Polynomial k) D₀).comp Polynomial.C) = κ_K := by
      ext c
      change (ι_S₀.comp ρ₀) (Polynomial.C c) = κ_K c
      rw [hρ₀]
      rfl
    have hj₀_X : j₀ (algebraMap (Polynomial k) D₀ Polynomial.X) = u₀ + κ_K a₀ := by
      change (ι_S₀.comp ρ₀) Polynomial.X = u₀ + κ_K a₀
      rw [hρ₀]
      change algebraMap B K (φ Polynomial.X) =
        algebraMap B K (φ (Polynomial.X - Polynomial.C a₀)) +
          algebraMap B K (φ (Polynomial.C a₀))
      rw [← map_add, ← map_add, sub_add_cancel]
    have hj₁_C : j₁.comp ((algebraMap (Polynomial k) D₁).comp Polynomial.C) = κ_K := hρ₁_C
    have hj₁_X : j₁ (algebraMap (Polynomial k) D₁ Polynomial.X) * u₀ = 1 := hρ₁_X
    exact h_s4 K κ_K u₀ hu₀ A hDimA ι_A hFracA hk_A p
      D₀ D₁ (algebraMap (Polynomial k) D₀) j₀ (algebraMap (Polynomial k) D₁) j₁
      hFT₀ hInt₀ hj₀_C hj₀_X hFT₁ hInt₁ hj₁_C hj₁_X

theorem weil_polyP1_last_coord_two_chart_relative_normalization_completion (k : Type u) [Field k] [IsAlgClosed k]
    (ι_P1 ι_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (a₀ : k)
    (τ_inv : Localization.Away (Polynomial.X : Polynomial k) ≃+*
      Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
    (hPropP1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom)
    (hOpen₀ : AlgebraicGeometry.IsOpenImmersion ι_P1)
    (hOpen₁ : AlgebraicGeometry.IsOpenImmersion ι_inf)
    (hOver₀ : CategoryTheory.CategoryStruct.comp ι_P1 (weilProjectiveSpaceOver k 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (hOver₁ : CategoryTheory.CategoryStruct.comp ι_inf (weilProjectiveSpaceOver k 1).hom =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))
    (hCovP1 : Set.range ι_P1.base ∪ Set.range ι_inf.base = Set.univ)
    (hPre₀ : ι_P1.base ⁻¹' (Set.range ι_inf.base) =
      (PrimeSpectrum.basicOpen (Polynomial.X - Polynomial.C a₀ : Polynomial k) :
        Set (PrimeSpectrum (Polynomial k))))
    (hτ_k : ∀ c : k,
      τ_inv (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))
          (Polynomial.C c)) =
        algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
          (Polynomial.C c))
    (hτ_prod :
      τ_inv (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))
          Polynomial.X) *
        algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
          (Polynomial.X - Polynomial.C a₀) = 1)
    (hGlueP1 :
      CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (Polynomial k)
              (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k)))))
          ι_P1 =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv.toRingHom))
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap (Polynomial k)
                (Localization.Away (Polynomial.X : Polynomial k)))))
            ι_inf))
    (hSmAway : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
        [Algebra k A] [Algebra.FiniteType k A],
      ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) →
      ∀ (p : Ideal A) [p.IsPrime], p.height ≤ 1 →
        ∃ f : A, f ∉ p ∧ Algebra.IsStandardSmoothOfRelativeDimension 1 k (Localization.Away f))
    (hEtAlg : ∀ (B : Type u) [CommRing B] [IsDomain B] (φ : Polynomial k →+* B),
      φ.Etale →
      let K := FractionRing B
      let κ_K : k →+* K := (algebraMap B K).comp (φ.comp Polynomial.C)
      let u₀ : K := algebraMap B K (φ (Polynomial.X - Polynomial.C a₀))
      IsIntegrallyClosed B ∧
      Function.Injective φ ∧
      u₀ ≠ 0 ∧
      ∃ d : ℕ,
        1 ≤ d ∧
        (∀ (S : Type u) [CommRing S] [IsDomain S] [IsIntegrallyClosed S]
            (ρ : Polynomial k →+* S) (ι_S : S →+* K),
          @IsFractionRing S _ K _ ι_S.toAlgebra →
          (ι_S.comp ρ = (algebraMap B K).comp φ ∨
            (ι_S.comp (ρ.comp Polynomial.C) = κ_K ∧ ι_S (ρ Polynomial.X) * u₀ = 1)) →
          letI : Algebra (Polynomial k) S := ρ.toAlgebra
          let A := ↥(integralClosure (Polynomial k) S)
          IsDomain A ∧
          IsIntegrallyClosed A ∧
          IsNoetherianRing A ∧
          ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) ∧
          ((algebraMap (Polynomial k) A).comp Polynomial.C).FiniteType ∧
          @IsFractionRing A _ K _
            (ι_S.comp (Subalgebra.val (integralClosure (Polynomial k) S)).toRingHom).toAlgebra ∧
          (algebraMap (Polynomial k) A).Finite ∧
          ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module (Polynomial k) M) (e : M ≃+ A),
            (∀ (p : Polynomial k) (m : M), e (p • m) = algebraMap (Polynomial k) A p * e m) ∧
            Nonempty (Module.Basis (Fin d) (Polynomial k) M)) ∧
        (letI : Algebra (Polynomial k) B := φ.toAlgebra
         let A₀ := ↥(integralClosure (Polynomial k) B)
         let j_B : A₀ →+* B := (Subalgebra.val (integralClosure (Polynomial k) B)).toRingHom
         ∀ q : PrimeSpectrum B,
           ∃ (s : A₀) (j_loc : Localization.Away s →+* Localization.Away (j_B s)),
             j_B s ∉ q.asIdeal ∧
             Function.Bijective j_loc ∧
             j_loc.comp (algebraMap A₀ (Localization.Away s)) =
               (algebraMap B (Localization.Away (j_B s))).comp j_B) ∧
        (∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [IsNoetherianRing A],
          ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) →
          ∀ (ι_A : A →+* K),
            @IsFractionRing A _ K _ ι_A.toAlgebra →
            (∀ c : k, ∃ a : A, ι_A a = κ_K c) →
            ∀ (p : PrimeSpectrum A)
              (S₀ S₁ : Type u) [CommRing S₀] [IsDomain S₀] [IsIntegrallyClosed S₀]
              [CommRing S₁] [IsDomain S₁] [IsIntegrallyClosed S₁]
              (ρ₀ : Polynomial k →+* S₀) (ι_S₀ : S₀ →+* K)
              (ρ₁ : Polynomial k →+* S₁) (ι_S₁ : S₁ →+* K),
              @IsFractionRing S₀ _ K _ ι_S₀.toAlgebra →
              ι_S₀.comp ρ₀ = (algebraMap B K).comp φ →
              @IsFractionRing S₁ _ K _ ι_S₁.toAlgebra →
              ι_S₁.comp (ρ₁.comp Polynomial.C) = κ_K →
              ι_S₁ (ρ₁ Polynomial.X) * u₀ = 1 →
              letI : Algebra (Polynomial k) S₀ := ρ₀.toAlgebra
              letI : Algebra (Polynomial k) S₁ := ρ₁.toAlgebra
              let D₀ := ↥(integralClosure (Polynomial k) S₀)
              let D₁ := ↥(integralClosure (Polynomial k) S₁)
              ∃ (s : A) (ι_As : Localization.Away s →+* K),
                s ∉ p.asIdeal ∧
                ι_As.comp (algebraMap A (Localization.Away s)) = ι_A ∧
                ((∃ γ₀ : D₀ →+* Localization.Away s,
                    ι_As.comp γ₀ =
                      ι_S₀.comp
                        (Subalgebra.val (integralClosure (Polynomial k) S₀)).toRingHom) ∨
                  (∃ γ₁ : D₁ →+* Localization.Away s,
                    ι_As.comp γ₁ =
                      ι_S₁.comp
                        (Subalgebra.val (integralClosure (Polynomial k) S₁)).toRingHom))))
    (C : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine C] [AlgebraicGeometry.IsIntegral C]
    (v₁ v₂ : Quiver.Hom C (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))))
    (hv₁ : AlgebraicGeometry.Etale v₁)
    (hv₂ : AlgebraicGeometry.Etale v₂)
    (hv_over : CategoryTheory.CategoryStruct.comp v₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) =
      CategoryTheory.CategoryStruct.comp v₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))) :
    ∃ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (j : Quiver.Hom C C_bar.left)
      (d₁ d₂ : ℕ)
      (u_bar₁ u_bar₂ : Quiver.Hom C_bar.left (weilProjectiveSpaceOver k 1).left),
      AlgebraicGeometry.IsIntegral C_bar.left ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom ∧
      AlgebraicGeometry.IsOpenImmersion j ∧
      1 ≤ d₁ ∧
      1 ≤ d₂ ∧
      CategoryTheory.CategoryStruct.comp u_bar₁ (weilProjectiveSpaceOver k 1).hom = C_bar.hom ∧
      CategoryTheory.CategoryStruct.comp u_bar₂ (weilProjectiveSpaceOver k 1).hom = C_bar.hom ∧
      WeilTopDegFiniteLocallyFreeOfRank d₁ u_bar₁ ∧
      WeilTopDegFiniteLocallyFreeOfRank d₂ u_bar₂ ∧
      CategoryTheory.CategoryStruct.comp j u_bar₁ = CategoryTheory.CategoryStruct.comp v₁ ι_P1 ∧
      CategoryTheory.CategoryStruct.comp j u_bar₂ = CategoryTheory.CategoryStruct.comp v₂ ι_P1 :=
by
  classical
  have hSpecBase :
      ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (y : PrimeSpectrum S),
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom f)).base y = PrimeSpectrum.comap f y :=
    fun _ _ => rfl
  have hCompBase :
      ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : ↥X),
        (f ≫ g).base x = g.base (f.base x) :=
    fun f g x => AlgebraicGeometry.Scheme.Hom.comp_apply f g x

  
  have hOpenChartIso :
      ∀ (R : Type u) [CommRing R] (X : AlgebraicGeometry.Scheme.{u})
        (ι : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ X)
        [AlgebraicGeometry.IsOpenImmersion ι]
        (W : X.Opens) (hW : AlgebraicGeometry.Scheme.Hom.opensRange ι = W)
        (hAff : AlgebraicGeometry.IsAffineOpen W),
        ∃ e : R ≃+* ↑(X.presheaf.obj (Opposite.op W)),
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom) ≫ ι = hAff.fromSpec ∧
          (AlgebraicGeometry.Scheme.Hom.isoOpensRange ι).hom ≫
              X.homOfLE (le_of_eq hW) ≫ W.toSpecΓ =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom) := by
    clear hPropP1 hOpen₀ hOpen₁ hOver₀ hOver₁ hCovP1 hPre₀ hτ_k hτ_prod hGlueP1
      hSmAway hEtAlg hv₁ hv₂ hv_over
    intro R _ X ι _ W hW hAff
    let V_ι : X.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι
    let u_hom : V_ι.toScheme ⟶ W.toScheme := X.homOfLE (le_of_eq hW)
    let u_inv : W.toScheme ⟶ V_ι.toScheme := X.homOfLE (le_of_eq hW.symm)
    have hu_hom_inv : u_hom ≫ u_inv = 𝟙 _ := by
      apply (cancel_mono V_ι.ι).mp
      rw [CategoryTheory.Category.assoc, X.homOfLE_ι, X.homOfLE_ι,
        CategoryTheory.Category.id_comp]
    have hu_inv_hom : u_inv ≫ u_hom = 𝟙 _ := by
      apply (cancel_mono W.ι).mp
      rw [CategoryTheory.Category.assoc, X.homOfLE_ι, X.homOfLE_ι,
        CategoryTheory.Category.id_comp]
    let iso_W : V_ι.toScheme ≅ W.toScheme := ⟨u_hom, u_inv, hu_hom_inv, hu_inv_hom⟩
    let iso_Spec : AlgebraicGeometry.Spec (CommRingCat.of R) ≅
        AlgebraicGeometry.Spec (X.presheaf.obj (Opposite.op W)) :=
      AlgebraicGeometry.Scheme.Hom.isoOpensRange ι ≪≫ iso_W ≪≫ hAff.isoSpec
    let φ_hom : X.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of R :=
      AlgebraicGeometry.Spec.preimage iso_Spec.hom
    let φ_inv : CommRingCat.of R ⟶ X.presheaf.obj (Opposite.op W) :=
      AlgebraicGeometry.Spec.preimage iso_Spec.inv
    have hφ_inv_hom : φ_inv ≫ φ_hom = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, iso_Spec.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    have hφ_hom_inv : φ_hom ≫ φ_inv = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, iso_Spec.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    let iso_ring : CommRingCat.of R ≅ X.presheaf.obj (Opposite.op W) :=
      ⟨φ_inv, φ_hom, hφ_inv_hom, hφ_hom_inv⟩
    let e : R ≃+* ↑(X.presheaf.obj (Opposite.op W)) := iso_ring.commRingCatIsoToRingEquiv
    have he_hom : CommRingCat.ofHom e.toRingHom = φ_inv := CommRingCat.hom_ext rfl
    have he_symm : CommRingCat.ofHom e.symm.toRingHom = φ_hom := CommRingCat.hom_ext rfl
    refine ⟨e, ?_, ?_⟩
    · rw [he_hom, AlgebraicGeometry.Spec.map_preimage]
      dsimp [iso_Spec, iso_W]
      have h_inv_ι : (AlgebraicGeometry.Scheme.Hom.isoOpensRange ι).inv ≫ ι = V_ι.ι := by
        rw [← CategoryTheory.Iso.cancel_iso_hom_left
            (AlgebraicGeometry.Scheme.Hom.isoOpensRange ι),
          CategoryTheory.Iso.hom_inv_id_assoc,
          AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι]
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, h_inv_ι]
      change hAff.isoSpec.inv ≫ (u_inv ≫ V_ι.ι) = hAff.fromSpec
      rw [X.homOfLE_ι, hAff.isoSpec_inv_ι]
    · rw [he_symm, AlgebraicGeometry.Spec.map_preimage]
      dsimp [iso_Spec, iso_W, u_hom]
      rw [hAff.isoSpec_hom]

  
  have hIntertwineApp :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
        (R S : Type u) [CommRing R] [CommRing S]
        (ι_Y : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Y)
        [AlgebraicGeometry.IsOpenImmersion ι_Y]
        (U : Y.Opens) (hAff_U : AlgebraicGeometry.IsAffineOpen U)
        (θ : R ≃+* ↑(Y.presheaf.obj (Opposite.op U)))
        (_hθ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.toRingHom) ≫ ι_Y = hAff_U.fromSpec)
        (ι_X : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ X)
        [AlgebraicGeometry.IsOpenImmersion ι_X]
        (hAff_W : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map f.base).obj U))
        (δ : S ≃+* ↑(X.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map f.base).obj U))))
        (_hδ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ.toRingHom) ≫ ι_X = hAff_W.fromSpec)
        (α : R →+* S)
        (_hcomm : ι_X ≫ f = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ ι_Y)
        (r : R),
        δ (α r) = (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app f U)) (θ r) := by
    clear hPropP1 hOpen₀ hOpen₁ hOver₀ hOver₁ hCovP1 hPre₀ hτ_k hτ_prod hGlueP1
      hSmAway hEtAlg hv₁ hv₂ hv_over hOpenChartIso
    intro X Y f R S _ _ ι_Y _ U hAff_U θ hθ ι_X _ hAff_W δ hδ α hcomm r
    let W : X.Opens := (TopologicalSpace.Opens.map f.base).obj U
    have happ_spec :
        AlgebraicGeometry.Spec.map (AlgebraicGeometry.Scheme.Hom.app f U) ≫ hAff_U.fromSpec =
          hAff_W.fromSpec ≫ f := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hAff_U hAff_W (le_refl W)
    have hθ_id : CommRingCat.ofHom θ.toRingHom ≫ CommRingCat.ofHom θ.symm.toRingHom = 𝟙 _ :=
      CommRingCat.hom_ext (RingHom.ext θ.symm_apply_apply)
    have hSpec_θ :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.symm.toRingHom) ≫ hAff_U.fromSpec = ι_Y := by
      rw [← hθ, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
        hθ_id, AlgebraicGeometry.Spec.map_id, CategoryTheory.Category.id_comp]
    have hRHS :
        hAff_W.fromSpec ≫ f =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom θ.symm.toRingHom ≫
              CommRingCat.ofHom α ≫
              CommRingCat.ofHom δ.toRingHom) ≫ hAff_U.fromSpec := by
      calc
        hAff_W.fromSpec ≫ f
          = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ.toRingHom) ≫ ι_X) ≫ f := by
              rw [hδ]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ.toRingHom) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ ι_Y) := by
              rw [CategoryTheory.Category.assoc, hcomm]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom δ.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom θ.symm.toRingHom) ≫
              hAff_U.fromSpec := by
              rw [hSpec_θ]
        _ = AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom θ.symm.toRingHom ≫
                CommRingCat.ofHom α ≫
                CommRingCat.ofHom δ.toRingHom) ≫ hAff_U.fromSpec := by
              rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp,
                CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    have hEq_map :
        AlgebraicGeometry.Scheme.Hom.app f U =
          CommRingCat.ofHom θ.symm.toRingHom ≫
            CommRingCat.ofHom α ≫
            CommRingCat.ofHom δ.toRingHom := by
      apply AlgebraicGeometry.Spec.map_injective
      apply (cancel_mono hAff_U.fromSpec).mp
      exact happ_spec.trans hRHS
    have hEval := congrArg (fun g => (CommRingCat.Hom.hom g) (θ r)) hEq_map
    simpa [θ.symm_apply_apply] using hEval.symm

  
  have hIntegralClosureEquiv :
      ∀ (R₁ R₂ S₁ S₂ : Type u) [CommRing R₁] [CommRing R₂] [CommRing S₁] [CommRing S₂]
        (eR : R₁ ≃+* R₂) (eS : S₁ ≃+* S₂)
        (φ₁ : R₁ →+* S₁) (φ₂ : R₂ →+* S₂)
        (_hIntw : ∀ r : R₁, eS (φ₁ r) = φ₂ (eR r)),
        letI : Algebra R₁ S₁ := φ₁.toAlgebra
        letI : Algebra R₂ S₂ := φ₂.toAlgebra
        ∃ eIC : ↥(integralClosure R₁ S₁) ≃+* ↥(integralClosure R₂ S₂),
          (∀ x : ↥(integralClosure R₁ S₁), (eIC x).1 = eS x.1) ∧
          (∀ y : ↥(integralClosure R₂ S₂), (eIC.symm y).1 = eS.symm y.1) ∧
          (∀ r : R₁,
            eIC (algebraMap R₁ ↥(integralClosure R₁ S₁) r) =
              algebraMap R₂ ↥(integralClosure R₂ S₂) (eR r)) := by
    clear hPropP1 hOpen₀ hOpen₁ hOver₀ hOver₁ hCovP1 hPre₀ hτ_k hτ_prod hGlueP1
      hSmAway hEtAlg hv₁ hv₂ hv_over hOpenChartIso hIntertwineApp
    intro R₁ R₂ S₁ S₂ _ _ _ _ eR eS φ₁ φ₂ hIntw
    letI : Algebra R₁ S₁ := φ₁.toAlgebra
    letI : Algebra R₂ S₂ := φ₂.toAlgebra
    have hMapInt :
        ∀ {A₁ A₂ B₁ B₂ : Type u} [CommRing A₁] [CommRing A₂] [CommRing B₁] [CommRing B₂]
          (fA : A₁ →+* A₂) (fB : B₁ →+* B₂) (ψ₁ : A₁ →+* B₁) (ψ₂ : A₂ →+* B₂),
          (∀ a : A₁, fB (ψ₁ a) = ψ₂ (fA a)) →
          ∀ x : B₁, @IsIntegral A₁ B₁ _ _ ψ₁.toAlgebra x →
            @IsIntegral A₂ B₂ _ _ ψ₂.toAlgebra (fB x) := by
      intro A₁ A₂ B₁ B₂ _ _ _ _ fA fB ψ₁ ψ₂ hcomm x hx
      letI : Algebra A₁ B₁ := ψ₁.toAlgebra
      letI : Algebra A₂ B₂ := ψ₂.toAlgebra
      rcases hx with ⟨P, hMonic, hEval⟩
      refine ⟨P.map fA, hMonic.map fA, ?_⟩
      change Polynomial.eval₂ ψ₂ (fB x) (P.map fA) = 0
      rw [Polynomial.eval₂_map]
      have hcomp : ψ₂.comp fA = fB.comp ψ₁ := RingHom.ext (fun a => (hcomm a).symm)
      rw [hcomp, Polynomial.eval₂_eq_sum_range]
      have hEval' : ∑ i ∈ Finset.range (P.natDegree + 1), ψ₁ (P.coeff i) * x ^ i = 0 := by
        rw [← Polynomial.eval₂_eq_sum_range]
        exact hEval
      have hMapSum := congrArg fB hEval'
      rw [map_zero, map_sum] at hMapSum
      refine Eq.trans ?_ hMapSum
      apply Finset.sum_congr rfl
      intro i _
      simp [map_mul, map_pow]
    have hIntw_symm : ∀ r₂ : R₂, eS.symm (φ₂ r₂) = φ₁ (eR.symm r₂) := by
      intro r₂
      apply eS.injective
      rw [eS.apply_symm_apply, hIntw, eR.apply_symm_apply]
    let eIC : ↥(integralClosure R₁ S₁) ≃+* ↥(integralClosure R₂ S₂) :=
      { toFun := fun x => ⟨eS x.1, (mem_integralClosure_iff R₂ S₂).mpr
          (hMapInt eR.toRingHom eS.toRingHom φ₁ φ₂ hIntw x.1
            ((mem_integralClosure_iff R₁ S₁).mp x.2))⟩
        invFun := fun y => ⟨eS.symm y.1, (mem_integralClosure_iff R₁ S₁).mpr
          (hMapInt eR.symm.toRingHom eS.symm.toRingHom φ₂ φ₁ hIntw_symm y.1
            ((mem_integralClosure_iff R₂ S₂).mp y.2))⟩
        left_inv := fun x => Subtype.ext (eS.symm_apply_apply x.1)
        right_inv := fun y => Subtype.ext (eS.apply_symm_apply y.1)
        map_mul' := fun x y => Subtype.ext (map_mul eS x.1 y.1)
        map_add' := fun x y => Subtype.ext (map_add eS x.1 y.1) }
    refine ⟨eIC, fun _ => rfl, fun _ => rfl, fun r => Subtype.ext (hIntw r)⟩

  
  have h_s1 :
      ∀ (A₀ B : Type u) [CommRing A₀] [CommRing B] (j_B : A₀ →+* B),
        (∀ q : PrimeSpectrum B,
          ∃ (s : A₀) (j_loc : Localization.Away s →+* Localization.Away (j_B s)),
            j_B s ∉ q.asIdeal ∧
            Function.Bijective j_loc ∧
            j_loc.comp (algebraMap A₀ (Localization.Away s)) =
              (algebraMap B (Localization.Away (j_B s))).comp j_B) →
        AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B)) := by
    clear hPropP1 hOpen₀ hOpen₁ hOver₀ hOver₁ hCovP1 hPre₀ hτ_k hτ_prod hGlueP1
      hSmAway hEtAlg hv₁ hv₂ hv_over hOpenChartIso hIntertwineApp hIntegralClosureEquiv
    intro A₀ B _ _ j_B hLoc
    let g : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B)
    let s : PrimeSpectrum B → A₀ := fun q => Classical.choose (hLoc q)
    let j_loc : ∀ q : PrimeSpectrum B,
        Localization.Away (s q) →+* Localization.Away (j_B (s q)) :=
      fun q => Classical.choose (Classical.choose_spec (hLoc q))
    have hq_spec : ∀ q : PrimeSpectrum B,
        j_B (s q) ∉ q.asIdeal ∧
        Function.Bijective (j_loc q) ∧
        (j_loc q).comp (algebraMap A₀ (Localization.Away (s q))) =
          (algebraMap B (Localization.Away (j_B (s q)))).comp j_B :=
      fun q => Classical.choose_spec (Classical.choose_spec (hLoc q))
    let β : ∀ q : PrimeSpectrum B,
        AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (j_B (s q)))) ⟶
          AlgebraicGeometry.Spec (CommRingCat.of B) :=
      fun q => AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap B (Localization.Away (j_B (s q)))))
    have hβ_open : ∀ q : PrimeSpectrum B, AlgebraicGeometry.IsOpenImmersion (β q) :=
      fun _ => inferInstance
    have hβg_open : ∀ q : PrimeSpectrum B, AlgebraicGeometry.IsOpenImmersion (β q ≫ g) := by
      intro q
      let e_ring : Localization.Away (s q) ≃+* Localization.Away (j_B (s q)) :=
        RingEquiv.ofBijective (j_loc q) (hq_spec q).2.1
      let φ_hom : CommRingCat.of (Localization.Away (s q)) ⟶
          CommRingCat.of (Localization.Away (j_B (s q))) :=
        CommRingCat.ofHom e_ring.toRingHom
      let φ_inv : CommRingCat.of (Localization.Away (j_B (s q))) ⟶
          CommRingCat.of (Localization.Away (s q)) :=
        CommRingCat.ofHom e_ring.symm.toRingHom
      haveI hIso_φ : CategoryTheory.IsIso φ_hom :=
        ⟨⟨φ_inv, CommRingCat.hom_ext (RingHom.ext e_ring.symm_apply_apply),
          CommRingCat.hom_ext (RingHom.ext e_ring.apply_symm_apply)⟩⟩
      have hfac : β q ≫ g =
          AlgebraicGeometry.Spec.map φ_hom ≫
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (algebraMap A₀ (Localization.Away (s q)))) := by
        dsimp [β, g, φ_hom, e_ring]
        rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
        congr 1
        exact CommRingCat.hom_ext (hq_spec q).2.2.symm
      rw [hfac]
      infer_instance
    have hcov_B : ∀ x : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)),
        ∃ q y, (β q).base y = x := by
      intro (x : PrimeSpectrum B)
      have hx_mem : x ∈ (PrimeSpectrum.basicOpen (j_B (s x)) : Set (PrimeSpectrum B)) :=
        (hq_spec x).1
      rw [← PrimeSpectrum.localization_away_comap_range
        (Localization.Away (j_B (s x))) (j_B (s x))] at hx_mem
      rcases hx_mem with ⟨y, hy⟩
      exact ⟨x, y, hy⟩
    have hg_inj : Function.Injective g.base := by
      intro (q₁ : PrimeSpectrum B) (q₂ : PrimeSpectrum B) hq_eq
      have hcomap : PrimeSpectrum.comap j_B q₁ = PrimeSpectrum.comap j_B q₂ := hq_eq
      have hmem₂ : j_B (s q₁) ∉ q₂.asIdeal := by
        intro hmem
        have h1 : s q₁ ∈ (PrimeSpectrum.comap j_B q₂).asIdeal := hmem
        rw [← hcomap] at h1
        exact (hq_spec q₁).1 h1
      have hr₁ : q₁ ∈
          Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away (j_B (s q₁))))) := by
        rw [PrimeSpectrum.localization_away_comap_range
          (Localization.Away (j_B (s q₁))) (j_B (s q₁))]
        exact (hq_spec q₁).1
      have hr₂ : q₂ ∈
          Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away (j_B (s q₁))))) := by
        rw [PrimeSpectrum.localization_away_comap_range
          (Localization.Away (j_B (s q₁))) (j_B (s q₁))]
        exact hmem₂
      rcases hr₁ with ⟨p₁, hp₁⟩
      rcases hr₂ with ⟨p₂, hp₂⟩
      have hp₁' : (β q₁).base p₁ = q₁ := hp₁
      have hp₂' : (β q₁).base p₂ = q₂ := hp₂
      have hcomp_eq : (β q₁ ≫ g).base p₁ = (β q₁ ≫ g).base p₂ := by
        rw [hCompBase (β q₁) g p₁, hCompBase (β q₁) g p₂, hp₁', hp₂', hq_eq]
      haveI : AlgebraicGeometry.IsOpenImmersion (β q₁ ≫ g) := hβg_open q₁
      have hp_eq : p₁ = p₂ := (β q₁ ≫ g).isOpenEmbedding.injective hcomp_eq
      rw [← hp₁', ← hp₂', hp_eq]
    let 𝒰 : (AlgebraicGeometry.Spec (CommRingCat.of B)).OpenCover :=
      AlgebraicGeometry.Scheme.Cover.mkOfCovers (P := @AlgebraicGeometry.IsOpenImmersion)
        (PrimeSpectrum B)
        (fun q => AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away (j_B (s q)))))
        β hcov_B hβ_open
    exact AlgebraicGeometry.IsOpenImmersion.of_openCover_source g 𝒰 hg_inj hβg_open

  
  letI : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen₀
  letI : AlgebraicGeometry.IsOpenImmersion ι_inf := hOpen₁
  letI : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom := hPropP1
  let P1 := weilProjectiveSpaceOver k 1
  let U₀ : P1.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_P1
  let U_inf : P1.left.Opens := AlgebraicGeometry.Scheme.Hom.opensRange ι_inf
  have hAff_U₀ : AlgebraicGeometry.IsAffineOpen U₀ :=
    AlgebraicGeometry.isAffineOpen_opensRange ι_P1
  have hAff_Uinf : AlgebraicGeometry.IsAffineOpen U_inf :=
    AlgebraicGeometry.isAffineOpen_opensRange ι_inf
  have hCov_U : U₀ ⊔ U_inf = ⊤ := by
    ext x
    change x ∈ Set.range ι_P1.base ∪ Set.range ι_inf.base ↔ True
    rw [hCovP1]
    simp
  obtain ⟨θ₀, hθ₀_from, _⟩ := hOpenChartIso (Polynomial k) P1.left ι_P1 U₀ rfl hAff_U₀
  obtain ⟨θ₁, hθ₁_from, _⟩ := hOpenChartIso (Polynomial k) P1.left ι_inf U_inf rfl hAff_Uinf

  
  have h_s2 :
      ∀ (B : Type u) [CommRing B] [IsDomain B]
        (φ : Polynomial k →+* B)
        (_hIC_B : IsIntegrallyClosed B)
        (_hu₀_ne : algebraMap B (FractionRing B) (φ (Polynomial.X - Polynomial.C a₀)) ≠ 0),
        let K := FractionRing B
        let κ_K : k →+* K := (algebraMap B K).comp (φ.comp Polynomial.C)
        let u₀ : K := algebraMap B K (φ (Polynomial.X - Polynomial.C a₀))
        let η_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of B) :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B K))
        ∃ (N : AlgebraicGeometry.Scheme.{u})
          (j_B : AlgebraicGeometry.Spec (CommRingCat.of B) ⟶ N)
          (u_bar : N ⟶ P1.left)
          (S₁ : Type u) (instRingS₁ : CommRing S₁)
          (ρ₁ : @RingHom (Polynomial k) S₁ _ instRingS₁.toNonAssocSemiring)
          (ι_S₁ : @RingHom S₁ K instRingS₁.toNonAssocSemiring _),
          letI : CommRing S₁ := instRingS₁
          AlgebraicGeometry.IsIntegral N ∧
          N.IsSeparated ∧
          AlgebraicGeometry.IsDominant j_B ∧
          AlgebraicGeometry.IsIntegralHom u_bar ∧
          j_B ≫ u_bar = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ ι_P1 ∧
          IsDomain S₁ ∧
          IsIntegrallyClosed S₁ ∧
          @IsFractionRing S₁ _ K _ ι_S₁.toAlgebra ∧
          ι_S₁.comp (ρ₁.comp Polynomial.C) = κ_K ∧
          ι_S₁ (ρ₁ Polynomial.X) * u₀ = 1 ∧
          (letI : Algebra (Polynomial k) B := φ.toAlgebra
           let D₀ := ↥(integralClosure (Polynomial k) B)
           let j_B0 : D₀ →+* B := (Subalgebra.val (integralClosure (Polynomial k) B)).toRingHom
           letI : Algebra (Polynomial k) S₁ := ρ₁.toAlgebra
           let D₁ := ↥(integralClosure (Polynomial k) S₁)
           ∃ (c₀ : AlgebraicGeometry.Spec (CommRingCat.of D₀) ⟶ N)
             (c₁ : AlgebraicGeometry.Spec (CommRingCat.of D₁) ⟶ N)
             (hOpen_c₀ : AlgebraicGeometry.IsOpenImmersion c₀)
             (hOpen_c₁ : AlgebraicGeometry.IsOpenImmersion c₁)
             (δ₀ : D₀ ≃+*
               ↑(N.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map u_bar.base).obj U₀))))
             (δ₁ : D₁ ≃+*
               ↑(N.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map u_bar.base).obj U_inf)))),
             @AlgebraicGeometry.Scheme.Hom.opensRange _ _ c₀ hOpen_c₀ =
               (TopologicalSpace.Opens.map u_bar.base).obj U₀ ∧
             @AlgebraicGeometry.Scheme.Hom.opensRange _ _ c₁ hOpen_c₁ =
               (TopologicalSpace.Opens.map u_bar.base).obj U_inf ∧
             j_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B0) ≫ c₀ ∧
             AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap B K).comp j_B0)) ≫ c₀ =
               η_K ≫ j_B ∧
             AlgebraicGeometry.Spec.map
                 (CommRingCat.ofHom
                   (ι_S₁.comp (Subalgebra.val (integralClosure (Polynomial k) S₁)).toRingHom)) ≫
               c₁ = η_K ≫ j_B ∧
             c₀ ≫ (u_bar ≫ P1.hom) =
               AlgebraicGeometry.Spec.map
                 (CommRingCat.ofHom ((algebraMap (Polynomial k) D₀).comp Polynomial.C)) ∧
             c₁ ≫ (u_bar ≫ P1.hom) =
               AlgebraicGeometry.Spec.map
                 (CommRingCat.ofHom ((algebraMap (Polynomial k) D₁).comp Polynomial.C)) ∧
             (∀ p : Polynomial k,
               δ₀ (algebraMap (Polynomial k) D₀ p) =
                 (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app u_bar U₀)) (θ₀ p)) ∧
             (∀ p : Polynomial k,
               δ₁ (algebraMap (Polynomial k) D₁ p) =
                 (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app u_bar U_inf)) (θ₁ p))) := by
    clear hSmAway hEtAlg hv₁ hv₂ hv_over h_s1
    intro B _ _ φ hIC_B hu₀_ne
    let K := FractionRing B
    let κ_K : k →+* K := (algebraMap B K).comp (φ.comp Polynomial.C)
    let u₀ : K := algebraMap B K (φ (Polynomial.X - Polynomial.C a₀))
    let C_B : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of B)
    let η_K : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶ C_B :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B K))
    haveI : AlgebraicGeometry.IsIntegral C_B :=
      (AlgebraicGeometry.affine_isIntegral_iff (CommRingCat.of B)).mpr ‹IsDomain B›
    let f : C_B ⟶ P1.left := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ) ≫ ι_P1
    have hSep_P1 : AlgebraicGeometry.IsSeparated P1.hom :=
      AlgebraicGeometry.IsProper.toIsSeparated
    have hAff_fk : AlgebraicGeometry.IsAffineHom (f ≫ P1.hom) := by
      haveI : AlgebraicGeometry.IsAffine C_B := inferInstance
      haveI : AlgebraicGeometry.IsAffine (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
        inferInstance
      infer_instance
    haveI : AlgebraicGeometry.IsAffineHom f :=
      AlgebraicGeometry.IsAffineHom.of_comp f P1.hom
    let N : AlgebraicGeometry.Scheme.{u} := f.normalization
    let j_B : C_B ⟶ N := f.toNormalization
    let u_bar : N ⟶ P1.left := f.fromNormalization
    have hInt_N : AlgebraicGeometry.IsIntegral N := inferInstance
    have hDom_jB : AlgebraicGeometry.IsDominant j_B := inferInstance
    have hIntHom_u : AlgebraicGeometry.IsIntegralHom u_bar := inferInstance
    have hjB_u : j_B ≫ u_bar = f := f.toNormalization_fromNormalization
    have hSep_N : N.IsSeparated := by
      haveI : AlgebraicGeometry.IsAffineHom u_bar := inferInstance
      haveI : AlgebraicGeometry.IsSeparated u_bar :=
        AlgebraicGeometry.IsSeparated.of_isAffineHom u_bar
      let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
      haveI : S_k.IsSeparated := inferInstance
      have hTermEq : CategoryTheory.Limits.terminal.from N =
          u_bar ≫ P1.hom ≫ CategoryTheory.Limits.terminal.from S_k :=
        CategoryTheory.Limits.terminal.hom_ext _ _
      refine AlgebraicGeometry.Scheme.IsSeparated.mk ?_
      rw [hTermEq]
      infer_instance

    
    let U₀_aff : P1.left.affineOpens := ⟨U₀, hAff_U₀⟩
    let O₀ : C_B.Opens := (TopologicalSpace.Opens.map f.base).obj U₀
    have hO₀_top : O₀ = ⊤ := by
      ext x
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      exact ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base x, rfl⟩
    have hId_range : AlgebraicGeometry.Scheme.Hom.opensRange (𝟙 C_B) = O₀ :=
      (AlgebraicGeometry.Scheme.Hom.opensRange_of_isIso (𝟙 C_B)).trans hO₀_top.symm
    have hAff_O₀ : AlgebraicGeometry.IsAffineOpen O₀ := hAff_U₀.preimage f
    obtain ⟨σ₀, hσ₀_from, hσ₀_toSpec⟩ :=
      hOpenChartIso B C_B (𝟙 C_B) O₀ hId_range hAff_O₀
    have hσ₀_φ : ∀ p : Polynomial k,
        σ₀ (φ p) = (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app f U₀)) (θ₀ p) :=
      hIntertwineApp f (Polynomial k) B ι_P1 U₀ hAff_U₀ θ₀ hθ₀_from
        (𝟙 C_B) hAff_O₀ σ₀ hσ₀_from φ (CategoryTheory.Category.id_comp f)
    obtain ⟨eIC₀, heIC₀_val, heIC₀_symm_val, heIC₀_alg⟩ :=
      hIntegralClosureEquiv (Polynomial k) ↑(P1.left.presheaf.obj (Opposite.op U₀))
        B ↑(C_B.presheaf.obj (Opposite.op O₀))
        θ₀ σ₀ φ (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app f U₀)) hσ₀_φ
    let D₀ : Type u :=
      letI : Algebra (Polynomial k) B := φ.toAlgebra
      ↥(integralClosure (Polynomial k) B)
    let instRingD₀ : CommRing D₀ := by
      letI : Algebra (Polynomial k) B := φ.toAlgebra
      infer_instance
    letI : CommRing D₀ := instRingD₀
    let j_B0 : D₀ →+* B :=
      letI : Algebra (Polynomial k) B := φ.toAlgebra
      (Subalgebra.val (integralClosure (Polynomial k) B)).toRingHom
    let α_D₀ : Polynomial k →+* D₀ :=
      letI : Algebra (Polynomial k) B := φ.toAlgebra
      algebraMap (Polynomial k) D₀
    let φ_IC₀_inv : (f.normalizationDiagram).obj (Opposite.op U₀) ⟶ CommRingCat.of D₀ :=
      CommRingCat.ofHom eIC₀.symm.toRingHom
    let φ_IC₀_hom : CommRingCat.of D₀ ⟶ (f.normalizationDiagram).obj (Opposite.op U₀) :=
      CommRingCat.ofHom eIC₀.toRingHom
    have hSpec_hom_inv₀ :
        AlgebraicGeometry.Spec.map φ_IC₀_hom ≫ AlgebraicGeometry.Spec.map φ_IC₀_inv = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.map_comp,
        show φ_IC₀_inv ≫ φ_IC₀_hom = 𝟙 _ from
          CommRingCat.hom_ext (RingHom.ext eIC₀.apply_symm_apply),
        AlgebraicGeometry.Spec.map_id]
    have hSpec_inv_hom₀ :
        AlgebraicGeometry.Spec.map φ_IC₀_inv ≫ AlgebraicGeometry.Spec.map φ_IC₀_hom = 𝟙 _ := by
      rw [← AlgebraicGeometry.Spec.map_comp,
        show φ_IC₀_hom ≫ φ_IC₀_inv = 𝟙 _ from
          CommRingCat.hom_ext (RingHom.ext eIC₀.symm_apply_apply),
        AlgebraicGeometry.Spec.map_id]
    haveI : CategoryTheory.IsIso (AlgebraicGeometry.Spec.map φ_IC₀_inv) :=
      ⟨⟨AlgebraicGeometry.Spec.map φ_IC₀_hom, hSpec_inv_hom₀, hSpec_hom_inv₀⟩⟩
    let c₀ : AlgebraicGeometry.Spec (CommRingCat.of D₀) ⟶ N :=
      AlgebraicGeometry.Spec.map φ_IC₀_inv ≫ (f.normalizationOpenCover).f U₀_aff
    have hOpen_c₀ : AlgebraicGeometry.IsOpenImmersion c₀ :=
      CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion)
        (AlgebraicGeometry.Spec.map φ_IC₀_inv) ((f.normalizationOpenCover).f U₀_aff)
        inferInstance
        (AlgebraicGeometry.Scheme.instIsOpenImmersionF f.normalizationOpenCover U₀_aff)
    have hRange_c₀ : @AlgebraicGeometry.Scheme.Hom.opensRange _ _ c₀ hOpen_c₀ =
        (TopologicalSpace.Opens.map u_bar.base).obj U₀ := by
      ext x
      change x ∈ Set.range c₀.base ↔ x ∈ ((TopologicalSpace.Opens.map u_bar.base).obj U₀ : Set ↥N)
      have hpre := congrArg (fun V : N.Opens => (x ∈ (V : Set ↥N))) (f.fromNormalization_preimage U₀_aff)
      rw [hpre]
      change x ∈ Set.range c₀.base ↔ x ∈ Set.range ((f.normalizationOpenCover).f U₀_aff).base
      constructor
      · rintro ⟨y, rfl⟩
        exact ⟨(AlgebraicGeometry.Spec.map φ_IC₀_inv).base y, rfl⟩
      · rintro ⟨z, rfl⟩
        have h_arrow :
            AlgebraicGeometry.Spec.map φ_IC₀_hom ≫ c₀ = (f.normalizationOpenCover).f U₀_aff :=
          (CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map φ_IC₀_hom)
            (AlgebraicGeometry.Spec.map φ_IC₀_inv)
            ((f.normalizationOpenCover).f U₀_aff)).symm.trans
            ((congrArg (· ≫ (f.normalizationOpenCover).f U₀_aff) hSpec_hom_inv₀).trans
              (CategoryTheory.Category.id_comp ((f.normalizationOpenCover).f U₀_aff)))
        exact ⟨(AlgebraicGeometry.Spec.map φ_IC₀_hom).base z,
          (AlgebraicGeometry.Scheme.Hom.comp_apply
            (AlgebraicGeometry.Spec.map φ_IC₀_hom) c₀ z).symm.trans
            (congrArg (fun g => g.base z) h_arrow)⟩
    have hc₀_u : c₀ ≫ u_bar = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α_D₀) ≫ ι_P1 := by
      refine (CategoryTheory.Category.assoc _ _ _).trans ?_
      refine (congrArg (AlgebraicGeometry.Spec.map φ_IC₀_inv ≫ ·)
        (f.ι_fromNormalization U₀_aff)).trans ?_
      rw [← hθ₀_from, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp]
      apply congrArg (· ≫ ι_P1)
      apply congrArg AlgebraicGeometry.Spec.map
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro p
      exact (congrArg eIC₀.symm (heIC₀_alg p).symm).trans (eIC₀.symm_apply_apply (α_D₀ p))
    have hc₀_k : c₀ ≫ (u_bar ≫ P1.hom) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (α_D₀.comp Polynomial.C)) := by
      rw [← CategoryTheory.Category.assoc, hc₀_u, CategoryTheory.Category.assoc, hOver₀,
        ← AlgebraicGeometry.Spec.map_comp]
      rfl
    have hjB_c₀ : j_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B0) ≫ c₀ := by
      let α_id := (AlgebraicGeometry.Scheme.Hom.isoOpensRange (𝟙 C_B)).hom ≫
        C_B.homOfLE (le_of_eq hId_range)
      have hα_ι : α_id ≫ O₀.ι = 𝟙 C_B := by
        dsimp [α_id]
        rw [CategoryTheory.Category.assoc, C_B.homOfLE_ι,
          AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι]
      have hα_spec : α_id ≫ O₀.toSpecΓ =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ₀.symm.toRingHom) := by
        dsimp [α_id]
        rw [CategoryTheory.Category.assoc]
        exact hσ₀_toSpec
      refine ((CategoryTheory.Category.id_comp f.toNormalization).symm.trans
        ((congrArg (· ≫ f.toNormalization) hα_ι.symm).trans
          ((CategoryTheory.Category.assoc α_id O₀.ι f.toNormalization).trans
            (congrArg (α_id ≫ ·) (f.ι_toNormalization U₀_aff))))).trans ?_
      refine ((CategoryTheory.Category.assoc α_id O₀.toSpecΓ _).symm.trans
        ((congrArg (· ≫ _) hα_spec).trans
          (CategoryTheory.Category.assoc _ _ ((f.normalizationOpenCover).f U₀_aff)).symm)).trans ?_
      refine (congrArg (· ≫ (f.normalizationOpenCover).f U₀_aff) ?_).trans
        (CategoryTheory.Category.assoc (AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_B0))
          (AlgebraicGeometry.Spec.map φ_IC₀_inv) ((f.normalizationOpenCover).f U₀_aff))
      refine (AlgebraicGeometry.Spec.map_comp _ _).symm.trans
        ((congrArg AlgebraicGeometry.Spec.map ?_).trans
          (AlgebraicGeometry.Spec.map_comp _ _))
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro y
      exact (heIC₀_symm_val y).symm
    have hη_c₀ :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((algebraMap B K).comp j_B0)) ≫ c₀ =
          η_K ≫ j_B := by
      rw [hjB_c₀, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
      rfl
    haveI : AlgebraicGeometry.IsAffineHom u_bar := inferInstance
    have hAff_W₀ : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map u_bar.base).obj U₀) :=
      hAff_U₀.preimage u_bar
    obtain ⟨δ₀, hδ₀_from, _⟩ :=
      @hOpenChartIso D₀ instRingD₀ N c₀ hOpen_c₀
        ((TopologicalSpace.Opens.map u_bar.base).obj U₀) hRange_c₀ hAff_W₀
    have hApp₀ : ∀ p : Polynomial k,
        δ₀ (α_D₀ p) = (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app u_bar U₀)) (θ₀ p) :=
      @hIntertwineApp N P1.left u_bar (Polynomial k) D₀ _ instRingD₀ ι_P1 _ U₀ hAff_U₀ θ₀ hθ₀_from
        c₀ hOpen_c₀ hAff_W₀ δ₀ hδ₀_from α_D₀ hc₀_u

    
    let b₀ : B := φ (Polynomial.X - Polynomial.C a₀)
    have hb₀_ne : b₀ ≠ 0 := by
      intro h0
      apply hu₀_ne
      change algebraMap B K b₀ = 0
      rw [h0, map_zero]
    have hSub_nzd : Submonoid.powers b₀ ≤ nonZeroDivisors B := by
      rintro _ ⟨n, rfl⟩
      exact Submonoid.pow_mem (nonZeroDivisors B) (mem_nonZeroDivisors_of_ne_zero hb₀_ne) n
    have hDom_S₁ : IsDomain (Localization.Away b₀) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away b₀) hSub_nzd
    have hIC_S₁ : IsIntegrallyClosed (Localization.Away b₀) := by
      haveI : IsIntegrallyClosed B := hIC_B
      exact isIntegrallyClosed_of_isLocalization (Localization.Away b₀)
        (Submonoid.powers b₀) hSub_nzd
    have hu₀_unit : IsUnit ((algebraMap B K) b₀) := IsUnit.mk0 u₀ hu₀_ne
    let ι_S₁ : Localization.Away b₀ →+* K :=
      IsLocalization.Away.lift (S := Localization.Away b₀) b₀ hu₀_unit
    have hι_S₁_eq : ∀ x : B, ι_S₁ (algebraMap B (Localization.Away b₀) x) = algebraMap B K x :=
      IsLocalization.Away.lift_eq (S := Localization.Away b₀) b₀ hu₀_unit
    have hι_S₁_comp : ι_S₁.comp (algebraMap B (Localization.Away b₀)) = algebraMap B K :=
      RingHom.ext hι_S₁_eq
    have hFrac_S₁ : @IsFractionRing (Localization.Away b₀) _ K _ ι_S₁.toAlgebra := by
      letI : Algebra (Localization.Away b₀) K := ι_S₁.toAlgebra
      haveI : IsScalarTower B (Localization.Away b₀) K :=
        IsScalarTower.of_algebraMap_eq' hι_S₁_comp.symm
      exact IsFractionRing.isFractionRing_of_isDomain_of_isLocalization
        (Submonoid.powers b₀) (Localization.Away b₀) K

    let O_inf : C_B.Opens := (TopologicalSpace.Opens.map f.base).obj U_inf
    have hO_inf_eq : O_inf = PrimeSpectrum.basicOpen b₀ := by
      ext (q : PrimeSpectrum B)
      change f.base q ∈ Set.range ι_inf.base ↔ b₀ ∉ q.asIdeal
      have hf_q : f.base q = ι_P1.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base q) :=
        AlgebraicGeometry.Scheme.Hom.comp_apply
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ι_P1 q
      rw [hf_q]
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)).base q ∈
        ι_P1.base ⁻¹' (Set.range ι_inf.base) ↔ _
      rw [hPre₀, hSpecBase]
      rfl
    let β_inf : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away b₀)) ⟶ C_B :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away b₀)))
    have hβ_inf_open : AlgebraicGeometry.IsOpenImmersion β_inf := inferInstance
    have hβ_inf_range : AlgebraicGeometry.Scheme.Hom.opensRange β_inf = O_inf := by
      ext (q : PrimeSpectrum B)
      change q ∈ Set.range β_inf.base ↔ q ∈ (O_inf : Set ↥C_B)
      rw [hO_inf_eq]
      change q ∈ Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away b₀))) ↔
        q ∈ PrimeSpectrum.basicOpen b₀
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away b₀) b₀]
      rfl
    have hAff_Oinf : AlgebraicGeometry.IsAffineOpen O_inf := hAff_Uinf.preimage f
    obtain ⟨σ₁, hσ₁_from, hσ₁_toSpec⟩ :=
      hOpenChartIso (Localization.Away b₀) C_B β_inf O_inf hβ_inf_range hAff_Oinf
    let ρ₁ : Polynomial k →+* Localization.Away b₀ :=
      σ₁.symm.toRingHom.comp
        ((CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app f U_inf)).comp θ₁.toRingHom)
    have hσ₁_ρ₁ : ∀ p : Polynomial k,
        σ₁ (ρ₁ p) = (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app f U_inf)) (θ₁ p) := by
      intro p
      dsimp [ρ₁]
      exact σ₁.apply_symm_apply _

    
    let ψ₀ : Polynomial k →+* K := (algebraMap B K).comp φ
    have hψ₀_unit : IsUnit (ψ₀ (Polynomial.X - Polynomial.C a₀)) := hu₀_unit
    let ψ₀_loc : Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k) →+* K :=
      IsLocalization.Away.lift
        (S := Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
        (Polynomial.X - Polynomial.C a₀ : Polynomial k) hψ₀_unit
    have hψ₀_loc_eq : ∀ p : Polynomial k,
        ψ₀_loc (algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k)) p) = ψ₀ p :=
      IsLocalization.Away.lift_eq
        (S := Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
        (Polynomial.X - Polynomial.C a₀ : Polynomial k) hψ₀_unit
    let ψ_inf : Polynomial k →+* K :=
      ψ₀_loc.comp (τ_inv.toRingHom.comp
        (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))))
    have hψ_inf_k : ψ_inf.comp Polynomial.C = κ_K := by
      apply RingHom.ext
      intro c
      change ψ₀_loc (τ_inv (algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X : Polynomial k)) (Polynomial.C c))) =
        algebraMap B K (φ (Polynomial.C c))
      rw [hτ_k c]
      exact hψ₀_loc_eq (Polynomial.C c)
    have hψ_inf_prod : ψ_inf Polynomial.X * u₀ = 1 := by
      dsimp [ψ_inf, u₀]
      have hu₀_lift :
          ψ₀_loc (algebraMap (Polynomial k)
            (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
            (Polynomial.X - Polynomial.C a₀)) =
          algebraMap B K (φ (Polynomial.X - Polynomial.C a₀)) :=
        hψ₀_loc_eq (Polynomial.X - Polynomial.C a₀)
      rw [← hu₀_lift, ← map_mul, hτ_prod, map_one]
    have hη_f_eq : η_K ≫ f = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf) ≫ ι_inf := by
      have hψ₀_fac : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap B K) =
          CommRingCat.ofHom
              (algebraMap (Polynomial k)
                (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))) ≫
            CommRingCat.ofHom ψ₀_loc := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro p
        exact (hψ₀_loc_eq p).symm
      calc
        η_K ≫ f
          = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B K)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) ≫ ι_P1 := by
              dsimp [η_K, f]
              rw [CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap B K)) ≫
              ι_P1 := by
              rw [AlgebraicGeometry.Spec.map_comp]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀_loc) ≫
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (algebraMap (Polynomial k)
                  (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k)))) ≫
                ι_P1) := by
              rw [hψ₀_fac, AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀_loc) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv.toRingHom) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k)))) ≫
              ι_inf := by
              rw [hGlueP1]
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_inf) ≫ ι_inf := by
              have hψ_comp : CommRingCat.ofHom ψ_inf =
                  CommRingCat.ofHom
                    (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))) ≫
                  CommRingCat.ofHom τ_inv.toRingHom ≫
                  CommRingCat.ofHom ψ₀_loc := rfl
              rw [hψ_comp, AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
              simp only [CategoryTheory.Category.assoc]
    let C_K := AlgebraicGeometry.Spec (CommRingCat.of K)
    let O_K : C_K.Opens := (TopologicalSpace.Opens.map (η_K ≫ f).base).obj U_inf
    have hOK_top : O_K = ⊤ := by
      ext (pt : PrimeSpectrum K)
      refine ⟨fun _ => trivial, fun _ => ?_⟩
      change η_K.base pt ∈ (O_inf : Set ↥C_B)
      rw [hO_inf_eq]
      change b₀ ∉ (PrimeSpectrum.comap (algebraMap B K) pt).asIdeal
      rw [PrimeSpectrum.comap_asIdeal]
      intro hmem
      exact pt.isPrime.ne_top (pt.asIdeal.eq_top_of_isUnit_mem hmem hu₀_unit)
    have hIdK_range : AlgebraicGeometry.Scheme.Hom.opensRange (𝟙 C_K) = O_K :=
      (AlgebraicGeometry.Scheme.Hom.opensRange_of_isIso (𝟙 C_K)).trans hOK_top.symm
    have hAff_OK : AlgebraicGeometry.IsAffineOpen O_K := by
      rw [hOK_top]
      exact AlgebraicGeometry.isAffineOpen_top C_K
    obtain ⟨γ_K, hγK_from, _⟩ := hOpenChartIso K C_K (𝟙 C_K) O_K hIdK_range hAff_OK
    have hγ_ψ : ∀ p : Polynomial k,
        γ_K (ψ_inf p) =
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.app (η_K ≫ f) U_inf)) (θ₁ p) :=
      hIntertwineApp (η_K ≫ f) (Polynomial k) K ι_inf U_inf hAff_Uinf θ₁ hθ₁_from
        (𝟙 C_K) hAff_OK γ_K hγK_from ψ_inf
        ((CategoryTheory.Category.id_comp (η_K ≫ f)).trans hη_f_eq)
    have hη_β : 𝟙 C_K ≫ η_K = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_S₁) ≫ β_inf := by
