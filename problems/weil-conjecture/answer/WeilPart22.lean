  let φ_iso : Quiver.Hom (Fgt_Wσ.obj U_W_σ).left (Fgt_P1.obj U_P_σ).left :=
    CategoryTheory.Limits.pullback.lift (p_W ≫ e_leg.hom) (q_W ≫ π_leg_σ) hφ_comm
  have hψW_comm : ((p_P ≫ e_leg.inv) ≫ (Fgt_W.obj U_W).hom) ≫ π_W =
      (q_P ≫ P1_over.hom) ≫ σ :=
    (congrArg (fun m => ((p_P ≫ e_leg.inv) ≫ (Fgt_W.obj U_W).hom) ≫ m) hg.symm).trans
      ((CategoryTheory.Category.assoc (p_P ≫ e_leg.inv) (Fgt_W.obj U_W).hom (π_leg ≫ π_fst)).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp (p_P ≫ e_leg.inv))
            ((CategoryTheory.Category.assoc (Fgt_W.obj U_W).hom π_leg π_fst).symm.trans
              (congrArg (fun m => m ≫ π_fst) hU_comm))).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp (p_P ≫ e_leg.inv))
              (CategoryTheory.Category.assoc e_leg.hom (Fgt_P.obj U_P).hom π_fst)).trans
