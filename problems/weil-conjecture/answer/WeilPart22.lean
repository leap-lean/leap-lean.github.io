            W₀.hom = (e_W₀.hom ≫ γ₀).left ∧
            (∀ γ ∈ G_Z', γ ≠ γ₀ →
              ∀ {T : AlgebraicGeometry.Scheme.{u}} (t : Quiver.Hom T W₀.left),
