                β.hom.app (Opposite.op X) ≫ evalAt x M :=
              Θ.toPresheafFiber_presheafFiberDesc (P := F₂.obj) (T := M)
                (fun X₀ x₀ => β.hom.app (Opposite.op X₀) ≫ evalAt x₀ M)
                (hDescCompat β) X x
            have hmap : Θ.toPresheafFiber X x F₁.obj ≫ Θ.sheafFiber.map hF =
                hF.hom.app (Opposite.op X) ≫ Θ.toPresheafFiber X x F₂.obj :=
              Θ.toPresheafFiber_naturality hF.hom X x
