  let mkMulLin : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M : Type u) [AddCommGroup M] [Module R M] (e : M ≃+ S),
      (∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m) →
      (S → (M →ₗ[R] M)) :=
    fun {R S} _ _ ρ M _ _ e he u =>
      { toFun := fun m => e.symm (u * e m)
        map_add' := fun m₁ m₂ => by
          apply e.injective
          rw [e.apply_symm_apply, map_add, map_add, mul_add,
            e.apply_symm_apply, e.apply_symm_apply]
        map_smul' := fun r₀ m => by
          apply e.injective
          dsimp
          rw [e.apply_symm_apply, he r₀ m, mul_left_comm,
            he r₀ (e.symm (u * e m)), e.apply_symm_apply] }
  have hmkMulLin : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M : Type u) [AddCommGroup M] [Module R M] (e : M ≃+ S)
      (he : ∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m) (u : S) (m : M),
      e (mkMulLin ρ M e he u m) = u * e m := by
    intro R S _ _ ρ M _ _ e he u m
    exact e.apply_symm_apply (u * e m)

  have hRing_indep : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M₁ : Type u) [AddCommGroup M₁] [Module R M₁]
      (b₁ : Module.Basis (Fin d) R M₁) (e₁ : M₁ ≃+ S)
      (_ : ∀ (r₀ : R) (m : M₁), e₁ (r₀ • m) = ρ r₀ * e₁ m)
      (M₂ : Type u) [AddCommGroup M₂] [Module R M₂]
      (b₂ : Module.Basis (Fin d) R M₂) (e₂ : M₂ ≃+ S)
      (_ : ∀ (r₀ : R) (m : M₂), e₂ (r₀ • m) = ρ r₀ * e₂ m)
      (u : S) (L₁ : M₁ →ₗ[R] M₁) (L₂ : M₂ →ₗ[R] M₂),
      (∀ m : M₁, e₁ (L₁ m) = u * e₁ m) →
      (∀ m : M₂, e₂ (L₂ m) = u * e₂ m) →
      ((LinearMap.toMatrix b₁ b₁) L₁).det = ((LinearMap.toMatrix b₂ b₂) L₂).det := by
    intro R S _ _ ρ M₁ _ _ b₁ e₁ he₁ M₂ _ _ b₂ e₂ he₂ u L₁ L₂ hL₁ hL₂
    let Φ : M₁ ≃ₗ[R] M₂ :=
      { e₁.trans e₂.symm with
        map_smul' := fun r₀ m₁ => by
          apply e₂.injective
          change e₂ (e₂.symm (e₁ (r₀ • m₁))) = e₂ (r₀ • e₂.symm (e₁ m₁))
          rw [e₂.apply_symm_apply, he₁, he₂, e₂.apply_symm_apply] }
    have hΦ_eval : ∀ m₁ : M₁, e₂ (Φ m₁) = e₁ m₁ :=
      fun m₁ => e₂.apply_symm_apply (e₁ m₁)
    have hΦ_conj : ∀ m₁ : M₁, Φ.symm (L₂ (Φ m₁)) = L₁ m₁ := by
      intro m₁
      apply Φ.injective
      apply e₂.injective
      rw [Φ.apply_symm_apply, hL₂, hΦ_eval, hΦ_eval, hL₁]
    let b' : Module.Basis (Fin d) R M₂ := b₁.map Φ
    have hmat : (LinearMap.toMatrix b' b') L₂ = (LinearMap.toMatrix b₁ b₁) L₁ := by
      ext i j
      rw [LinearMap.toMatrix_apply, LinearMap.toMatrix_apply,
        Module.Basis.map_apply, Module.Basis.map_repr, LinearEquiv.trans_apply, hΦ_conj]
    calc
      ((LinearMap.toMatrix b₁ b₁) L₁).det
        = ((LinearMap.toMatrix b' b') L₂).det := by rw [hmat]
      _ = ((LinearMap.toMatrix b₂ b₂) L₂).det :=
        LinearMap.det_toMatrix_eq_det_toMatrix b' b₂ L₂

  have hRing_unit : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M₀ : Type u) [AddCommGroup M₀] [Module R M₀]
      (b₀ : Module.Basis (Fin d) R M₀) (e₀ : M₀ ≃+ S),
      (∀ (r₀ : R) (m : M₀), e₀ (r₀ • m) = ρ r₀ * e₀ m) →
      ∃ (ν : Units S →* Units R),
        ∀ (M : Type u) [AddCommGroup M] [Module R M]
          (bM : Module.Basis (Fin d) R M) (e : M ≃+ S),
          (∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m) →
          ∀ (w : Units S) (L : M →ₗ[R] M),
            (∀ m : M, e (L m) = (w : S) * e m) →
            ((ν w : Units R) : R) = ((LinearMap.toMatrix bM bM) L).det := by
    intro R S _ _ ρ M₀ _ _ b₀ e₀ he₀
    let L₀ : S → (M₀ →ₗ[R] M₀) := mkMulLin ρ M₀ e₀ he₀
    have hL₀_one : L₀ 1 = LinearMap.id := by
      ext m
      apply e₀.injective
      dsimp [L₀]
      rw [hmkMulLin ρ M₀ e₀ he₀, one_mul]
    have hL₀_mul : ∀ s₁ s₂ : S, L₀ (s₁ * s₂) = (L₀ s₁).comp (L₀ s₂) := by
      intro s₁ s₂
      ext m
      apply e₀.injective
      dsimp [L₀]
      rw [hmkMulLin ρ M₀ e₀ he₀, hmkMulLin ρ M₀ e₀ he₀, hmkMulLin ρ M₀ e₀ he₀, mul_assoc]
    let detHom : S →* R :=
      { toFun := fun s => ((LinearMap.toMatrix b₀ b₀) (L₀ s)).det
        map_one' := by
          rw [hL₀_one, LinearMap.toMatrix_id, Matrix.det_one]
        map_mul' := fun s₁ s₂ => by
          rw [hL₀_mul, LinearMap.toMatrix_comp b₀ b₀ b₀, Matrix.det_mul] }
    refine ⟨Units.map detHom, ?_⟩
    intro M _ _ bM e he w L hL
    rw [Units.coe_map]
    exact hRing_indep ρ M₀ b₀ e₀ he₀ M bM e he w.val (L₀ w.val) L
      (hmkMulLin ρ M₀ e₀ he₀ w.val) hL

  have hPres_bc : ∀ {R R' S S' : Type u} [CommRing R] [CommRing R'] [CommRing S] [CommRing S']
      (ρ : R →+* S) (ρ' : R' →+* S') (ψ_R : R →+* R') (ψ_S : S →+* S'),
      letI : Algebra R R' := RingHom.toAlgebra ψ_R
      letI : Algebra R S := RingHom.toAlgebra ρ
      ∀ (e_tensor : TensorProduct R R' S ≃+ S'),
        (∀ (r' : R') (s : S), e_tensor (r' ⊗ₜ[R] s) = ρ' r' * ψ_S s) →
        ∀ (M : Type u) [AddCommGroup M] [Module R M]
          (_ : Module.Basis (Fin d) R M) (e : M ≃+ S),
          (∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m) →
          ∃ (M' : Type u) (_ : AddCommGroup M') (_ : Module R' M')
            (_ : Module.Basis (Fin d) R' M') (e' : M' ≃+ S'),
            ∀ (r₀' : R') (m' : M'), e' (r₀' • m') = ρ' r₀' * e' m' := by
    intro R R' S S' _ _ _ _ ρ ρ' ψ_R ψ_S
    letI : Algebra R R' := RingHom.toAlgebra ψ_R
    letI : Algebra R S := RingHom.toAlgebra ρ
    intro e_tensor he_tensor M _ _ bM e he
    let e_lin : M ≃ₗ[R] S :=
      { e with
        map_smul' := fun r₀ m => he r₀ m }
    let M' : Type u := TensorProduct R R' M
    let bM' : Module.Basis (Fin d) R' M' := bM.baseChange R'
    let e' : M' ≃+ S' :=
      (LinearEquiv.baseChange R R' M S e_lin).toAddEquiv.trans e_tensor
    refine ⟨M', inferInstance, inferInstance, bM', e', ?_⟩
    intro r₀' m'
    refine TensorProduct.inductionOn m' (fun r' m => ?_) (fun x y ihx ihy => ?_)
    · change e_tensor ((r₀' * r') ⊗ₜ[R] e m) = ρ' r₀' * e_tensor (r' ⊗ₜ[R] e m)
      rw [he_tensor, he_tensor, map_mul, mul_assoc]
    · rw [smul_add, map_add, map_add, mul_add, ihx, ihy]

  have hRing_bc : ∀ {R R' S S' : Type u} [CommRing R] [CommRing R'] [CommRing S] [CommRing S']
      (ρ : R →+* S) (ρ' : R' →+* S') (ψ_R : R →+* R') (ψ_S : S →+* S'),
      letI : Algebra R R' := RingHom.toAlgebra ψ_R
      letI : Algebra R S := RingHom.toAlgebra ρ
      ∀ (e_tensor : TensorProduct R R' S ≃+ S'),
        (∀ (r' : R') (s : S), e_tensor (r' ⊗ₜ[R] s) = ρ' r' * ψ_S s) →
        ∀ (M : Type u) [AddCommGroup M] [Module R M]
          (bM : Module.Basis (Fin d) R M) (e : M ≃+ S)
          (_ : ∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m)
          (M' : Type u) [AddCommGroup M'] [Module R' M']
          (bM' : Module.Basis (Fin d) R' M') (e' : M' ≃+ S')
          (_ : ∀ (r₀' : R') (m' : M'), e' (r₀' • m') = ρ' r₀' * e' m')
          (u : S) (L : M →ₗ[R] M) (L' : M' →ₗ[R'] M'),
