    let Sky_pre : AddCommGrpCat.{u} → CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u} :=
      fun M₀ =>
        { obj := fun opW => AddCommGrpCat.of ((T_k ⟶ Opposite.unop opW) → ↑M₀)
          map := fun {_ _} f => AddCommGrpCat.ofHom
            { toFun := fun φ γ => φ (γ ≫ f.unop)
              map_zero' := rfl
              map_add' := fun _ _ => rfl }
          map_id := fun _ => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun φ =>
            funext fun γ => congrArg φ (CategoryTheory.Category.comp_id γ))
          map_comp := fun _ _ => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun φ =>
            funext fun γ => congrArg φ (CategoryTheory.Category.assoc γ _ _).symm) }
    have hSky_sheaf : ∀ M₀ : AddCommGrpCat.{u},
        CategoryTheory.Presheaf.IsSheaf S_k.smallEtaleTopology (Sky_pre M₀) := by
      intro M₀ E W R hR
      have hArrow_all : ∀ γ : T_k ⟶ W, R.arrows γ := by
        intro γ
        have hpb : R.pullback γ ∈ S_k.smallEtaleTopology T_k :=
          S_k.smallEtaleTopology.pullback_stable γ hR
        have hid := hSieve_top (R.pullback γ) hpb
        change R.arrows (𝟙 T_k ≫ γ) at hid
        rwa [CategoryTheory.Category.id_comp] at hid
      intro x hx
      let amalg : E ⟶ (Sky_pre M₀).obj (Opposite.op W) :=
        AddCommGrpCat.ofHom
          { toFun := fun e γ => ((x γ (hArrow_all γ)).hom e) (𝟙 T_k)
            map_zero' := by
              funext γ
              rw [map_zero]
              rfl
            map_add' := fun e₁ e₂ => by
              funext γ
              rw [map_add]
              rfl }
      refine ⟨amalg, ?_, ?_⟩
      · intro V f hf
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro e
        funext δ
        have hcompat := hx (𝟙 T_k) δ (hArrow_all (δ ≫ f)) hf (CategoryTheory.Category.id_comp (δ ≫ f))
        have hev := congrFun (congrArg (fun m : E ⟶ (Sky_pre M₀).obj (Opposite.op T_k) => m.hom e)
          hcompat) (𝟙 T_k)
        change ((x (δ ≫ f) (hArrow_all (δ ≫ f))).hom e) (𝟙 T_k ≫ 𝟙 T_k) =
          ((x f hf).hom e) (𝟙 T_k ≫ δ) at hev
        rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp] at hev
        exact hev
      · intro y hy
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro e
        funext γ
        have hy_γ := hy γ (hArrow_all γ)
        have hev := congrFun (congrArg (fun m : E ⟶ (Sky_pre M₀).obj (Opposite.op T_k) => m.hom e)
          hy_γ) (𝟙 T_k)
        change (y.hom e) (𝟙 T_k ≫ γ) = ((x γ (hArrow_all γ)).hom e) (𝟙 T_k) at hev
        rw [CategoryTheory.Category.id_comp] at hev
        exact hev
    let Sky : AddCommGrpCat.{u} → CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u} :=
      fun M₀ => ⟨Sky_pre M₀, hSky_sheaf M₀⟩

    let L_Tk := weilEtaleLocalTorsionSheaf S_k m T_k
    let η : AM ⟶ L_Tk.obj.obj (Opposite.op T_k) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_Tk)
    let h₀ : AM ⟶ (Sky AM).obj.obj (Opposite.op T_k) :=
      AddCommGrpCat.ofHom
        { toFun := fun a _ => a
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
    let Φ₀ : L_Tk ⟶ Sky AM := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm h₀
    let ρ : L_Tk.obj.obj (Opposite.op T_k) ⟶ AM :=
      AddCommGrpCat.ofHom
        { toFun := fun z => ((Φ₀.hom.app (Opposite.op T_k)).hom z) (𝟙 T_k)
          map_zero' := by
            rw [map_zero]
            rfl
          map_add' := fun z₁ z₂ => by
            rw [map_add]
            rfl }
    have hηρ : η ≫ ρ = 𝟙 AM := by
      have hηΦ : η ≫ Φ₀.hom.app (Opposite.op T_k) = h₀ := by
        rw [← hEquiv_comp (𝟙 L_Tk) Φ₀, CategoryTheory.Category.id_comp]
        exact Equiv.apply_symm_apply _ _
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro a
      exact congrFun (congrArg (fun m : AM ⟶ (Sky AM).obj.obj (Opposite.op T_k) => m.hom a)
        hηΦ) (𝟙 T_k)
    have hMap_id_Tk : ∀ w : ↑(L_Tk.obj.obj (Opposite.op T_k)),
        (L_Tk.obj.map (Opposite.op (𝟙 T_k))).hom w = w := by
      intro w
      have hop_id : Opposite.op (𝟙 T_k) = 𝟙 (Opposite.op T_k) := rfl
      exact congrArg (fun m : L_Tk.obj.obj (Opposite.op T_k) ⟶ L_Tk.obj.obj (Opposite.op T_k) =>
        m.hom w) ((congrArg L_Tk.obj.map hop_id).trans (L_Tk.obj.map_id (Opposite.op T_k)))
    have hη_epi : ∀ {M₀ : AddCommGrpCat.{u}} (α₁ α₂ : L_Tk.obj.obj (Opposite.op T_k) ⟶ M₀),
        η ≫ α₁ = η ≫ α₂ → α₁ = α₂ := by
      intro M₀ α₁ α₂ hα
      let liftSky : (L_Tk.obj.obj (Opposite.op T_k) ⟶ M₀) → (L_Tk ⟶ Sky M₀) :=
        fun α =>
          { hom :=
              { app := fun opW => AddCommGrpCat.ofHom
                  { toFun := fun z γ => α.hom ((L_Tk.obj.map (Opposite.op γ)).hom z)
                    map_zero' := funext fun γ =>
                      (congrArg α.hom (map_zero _)).trans (map_zero α.hom)
                    map_add' := fun z₁ z₂ => funext fun γ =>
                      (congrArg α.hom (map_add _ z₁ z₂)).trans (map_add α.hom _ _) }
                naturality := fun {opV opW} f => by
                  apply AddCommGrpCat.hom_ext
                  apply AddMonoidHom.ext
                  intro z
                  funext γ
                  have hop : Opposite.op (γ ≫ f.unop) = (f ≫ Opposite.op γ) := rfl
                  have hmap_comp : L_Tk.obj.map f ≫ L_Tk.obj.map (Opposite.op γ) =
                      L_Tk.obj.map (Opposite.op (γ ≫ f.unop)) :=
                    (L_Tk.obj.map_comp f (Opposite.op γ)).symm.trans
                      (congrArg L_Tk.obj.map hop.symm)
                  exact congrArg α.hom
                    (congrArg (fun m : L_Tk.obj.obj opV ⟶ L_Tk.obj.obj (Opposite.op T_k) => m.hom z)
                      hmap_comp) } }
      have hLift_eq : liftSky α₁ = liftSky α₂ := by
        apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (liftSky α₁) =
            η ≫ (liftSky α₁).hom.app (Opposite.op T_k) := by
          rw [← hEquiv_comp (𝟙 L_Tk) (liftSky α₁), CategoryTheory.Category.id_comp]
        have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv (liftSky α₂) =
            η ≫ (liftSky α₂).hom.app (Opposite.op T_k) := by
          rw [← hEquiv_comp (𝟙 L_Tk) (liftSky α₂), CategoryTheory.Category.id_comp]
        rw [h1, h2]
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro a
        funext g
        have hg_id : g = 𝟙 T_k := hT_k.hom_ext g (𝟙 T_k)
        subst hg_id
        change α₁.hom ((L_Tk.obj.map (Opposite.op (𝟙 T_k))).hom (η.hom a)) =
          α₂.hom ((L_Tk.obj.map (Opposite.op (𝟙 T_k))).hom (η.hom a))
        exact (congrArg α₁.hom (hMap_id_Tk (η.hom a))).trans
          ((congrArg (fun m : AM ⟶ M₀ => m.hom a) hα).trans
            (congrArg α₂.hom (hMap_id_Tk (η.hom a))).symm)
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro z
      have hz := congrFun (congrArg
        (fun Φ : L_Tk ⟶ Sky M₀ => (Φ.hom.app (Opposite.op T_k)).hom z) hLift_eq) (𝟙 T_k)
      change α₁.hom ((L_Tk.obj.map (Opposite.op (𝟙 T_k))).hom z) =
        α₂.hom ((L_Tk.obj.map (Opposite.op (𝟙 T_k))).hom z) at hz
      exact (congrArg α₁.hom (hMap_id_Tk z)).symm.trans
        (hz.trans (congrArg α₂.hom (hMap_id_Tk z)))
    have hρη : ρ ≫ η = 𝟙 (L_Tk.obj.obj (Opposite.op T_k)) := by
      apply hη_epi
      rw [← CategoryTheory.Category.assoc, hηρ, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id]
    let e_LTk_AM : ↑(L_Tk.obj.obj (Opposite.op T_k)) ≃+ ↑AM :=
      { toFun := ρ.hom
        invFun := η.hom
        left_inv := fun z => congrArg
          (fun f : L_Tk.obj.obj (Opposite.op T_k) ⟶ L_Tk.obj.obj (Opposite.op T_k) => f.hom z) hρη
        right_inv := fun a => congrArg (fun f : AM ⟶ AM => f.hom a) hηρ
        map_add' := map_add _ }
    let e_AM_ZMod : ↑AM ≃+ ZMod m :=
      { toFun := ULift.down
        invFun := ULift.up
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_add' := fun _ _ => rfl }
    exact ⟨e_LTk_AM.trans e_AM_ZMod⟩

  
  obtain ⟨n, s, hs_sec, hs_open, hs_disj, hs_cov⟩ := hCover_Sk V₀

  
  let s_et : ∀ i : Fin n, Quiver.Hom T_k V₀ :=
    fun i => CategoryTheory.MorphismProperty.Over.homMk (s i) (hs_sec i) trivial
  obtain ⟨e_Sk_V₀⟩ := (hBiprod S_k V₀ n (fun _ => T_k) s_et
    hs_open hs_disj hs_cov).1 T_k
  obtain ⟨e_Tk_ZMod⟩ := hTerm_Sk
  have hCard_RHS :
      Nat.card ↑((weilEtaleLocalTorsionSheaf S_k m V₀).obj.obj (Opposite.op T_k)) = m ^ n := by
    rw [Nat.card_congr e_Sk_V₀.toEquiv, Nat.card_pi]
    have h_prod :
        (∏ _i : Fin n,
          Nat.card ↑((weilEtaleLocalTorsionSheaf S_k m T_k).obj.obj (Opposite.op T_k))) =
        ∏ _i : Fin n, m := by
      refine Finset.prod_congr rfl (fun _ _ => ?_)
      rw [Nat.card_congr e_Tk_ZMod.toEquiv, Nat.card_zmod]
    exact h_prod.trans ((Finset.prod_const m).trans (by rw [Finset.card_fin]))

  
  have hEt_pU₀ : AlgebraicGeometry.Etale p_U₀ := U₀.prop
  let j_Y : ∀ i : Fin n,
      Quiver.Hom (CategoryTheory.Limits.pullback π₀ (s i))
        ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U₀).left :=
    fun i => CategoryTheory.Limits.pullback.fst π₀ (s i)
  have hOpen_Y : ∀ i : Fin n, AlgebraicGeometry.IsOpenImmersion (j_Y i) :=
    fun i => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback π₀ (s i)).flip (hs_open i)
  have hEt_jY : ∀ i : Fin n, AlgebraicGeometry.Etale (j_Y i) := by
    intro i
    have : AlgebraicGeometry.IsOpenImmersion (j_Y i) := hOpen_Y i
    infer_instance
  have hEt_Y : ∀ i : Fin n,
      AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp (j_Y i) p_U₀) := by
    intro i
    have : AlgebraicGeometry.Etale (j_Y i) := hEt_jY i
    change AlgebraicGeometry.Etale (j_Y i ≫ p_U₀)
    infer_instance
  let U_Y : Fin n → Y.Etale :=
    fun i => CategoryTheory.MorphismProperty.Over.mk ⊤
      (CategoryTheory.CategoryStruct.comp (j_Y i) p_U₀) (hEt_Y i)
  let u_Y : ∀ i : Fin n, Quiver.Hom (U_Y i) U₀ :=
    fun i => CategoryTheory.MorphismProperty.Over.homMk (j_Y i) rfl trivial
  have hDisj_Y : ∀ i i' : Fin n, i ≠ i' →
      Disjoint (Set.range ⇑(((AlgebraicGeometry.Scheme.Etale.forget Y).map (u_Y i)).left))
        (Set.range ⇑(((AlgebraicGeometry.Scheme.Etale.forget Y).map (u_Y i')).left)) := by
    intro i i' hii'
    rw [Set.disjoint_left]
    rintro x ⟨z₁, rfl⟩ ⟨z₂, hz₂⟩
    have hcond₁ : ((j_Y i) ≫ π₀).base z₁ =
        (CategoryTheory.Limits.pullback.snd π₀ (s i) ≫ s i).base z₁ :=
      congrArg (fun f => f.base z₁) (CategoryTheory.Limits.pullback.condition (f := π₀) (g := s i))
    have hcond₂ : ((j_Y i') ≫ π₀).base z₂ =
        (CategoryTheory.Limits.pullback.snd π₀ (s i') ≫ s i').base z₂ :=
      congrArg (fun f => f.base z₂) (CategoryTheory.Limits.pullback.condition (f := π₀) (g := s i'))
    have hπ₁ : π₀.base ((j_Y i).base z₁) ∈ Set.range ⇑(s i) :=
      ⟨(CategoryTheory.Limits.pullback.snd π₀ (s i)).base z₁, hcond₁.symm⟩
    have hπ₂ : π₀.base ((j_Y i).base z₁) ∈ Set.range ⇑(s i') := by
      have hx_eq : (j_Y i').base z₂ = (j_Y i).base z₁ := hz₂
      rw [← hx_eq]
      exact ⟨(CategoryTheory.Limits.pullback.snd π₀ (s i')).base z₂, hcond₂.symm⟩
    exact Set.disjoint_left.mp (hs_disj i i' hii') hπ₁ hπ₂
  have hCov_Y : ∀ x : ↥(((AlgebraicGeometry.Scheme.Etale.forget Y).obj U₀).left),
      ∃ i : Fin n,
        x ∈ Set.range ⇑(((AlgebraicGeometry.Scheme.Etale.forget Y).map (u_Y i)).left) := by
    intro x
    obtain ⟨i, q, hq⟩ := hs_cov (π₀.base x)
    obtain ⟨z, hz, _⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := π₀) (g := s i) x q hq.symm
    exact ⟨i, z, hz⟩

  have hSplit_H := (hBiprod Y U₀ n U_Y u_Y hOpen_Y hDisj_Y hCov_Y).2

  refine ⟨?_, ?_⟩
  · intro b hSub
    obtain ⟨e_Hb⟩ := hSplit_H b
    have : ∀ i : Fin n, Subsingleton (weilEtaleLocalTorsionH Y m (U_Y i) b) :=
      fun i => hSub (s i) (hs_sec i) (hEt_Y i)
    exact e_Hb.toEquiv.subsingleton
  · intro b hCard
    obtain ⟨e_Hb⟩ := hSplit_H b
    have hc_i : ∀ i : Fin n, Nat.card (weilEtaleLocalTorsionH Y m (U_Y i) b) = m :=
      fun i => hCard (s i) (hs_sec i) (hEt_Y i)
    have hm_ne : m ≠ 0 := by omega
    have : ∀ i : Fin n, Finite (weilEtaleLocalTorsionH Y m (U_Y i) b) :=
      fun i => Nat.finite_of_card_ne_zero (by rw [hc_i i]; exact hm_ne)
    have hFin_U₀ : Finite (weilEtaleLocalTorsionH Y m U₀ b) :=
      e_Hb.toEquiv.finite_iff.mpr inferInstance
    have hCard_LHS : Nat.card (weilEtaleLocalTorsionH Y m U₀ b) = m ^ n := by
      rw [Nat.card_congr e_Hb.toEquiv, Nat.card_pi]
      have h_prod :
          (∏ i : Fin n, Nat.card (weilEtaleLocalTorsionH Y m (U_Y i) b)) =
          ∏ _i : Fin n, m :=
        Finset.prod_congr rfl (fun i _ => hc_i i)
      exact h_prod.trans ((Finset.prod_const m).trans (by rw [Finset.card_fin]))
    exact ⟨hFin_U₀, hCard_LHS.trans hCard_RHS.symm⟩

