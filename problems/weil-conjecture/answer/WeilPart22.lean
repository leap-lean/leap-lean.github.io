          let γ₀l : Z'_s ⟶ S' := γ₀.left
          have hw_γ₀ : γ₀l ≫ p = z'h := CategoryTheory.MorphismProperty.Over.w γ₀
          have hEt_γ₀ : AlgebraicGeometry.Etale γ₀l :=
            CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) γ₀l p V.prop
