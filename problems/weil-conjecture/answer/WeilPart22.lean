  have hSep_Pd : ∀ d : ℕ, (Pd d).left.IsSeparated := by
    intro d
    haveI : S_k.IsSeparated := inferInstance
    haveI : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S_k) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff S_k).mp inferInstance
    haveI : AlgebraicGeometry.IsProper (Pd d).hom := (hCoord.2.2.2.2.2.2.2.2 d).1
    have hTerm : (Pd d).hom ≫ CategoryTheory.Limits.terminal.from S_k =
        CategoryTheory.Limits.terminal.from (Pd d).left :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    have hSep_term : AlgebraicGeometry.IsSeparated
        (CategoryTheory.Limits.terminal.from (Pd d).left) := by
