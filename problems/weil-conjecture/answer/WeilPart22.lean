  have hB_spec_pb : ∀ {P Z₁ Z₂ Z₀ : AlgebraicGeometry.Scheme.{u}}
      [AlgebraicGeometry.IsAffine P]
      {p₁ : P ⟶ Z₁} {p₂ : P ⟶ Z₂} {f₁ : Z₁ ⟶ Z₀} {f₂ : Z₂ ⟶ Z₀}
      (hPB : CategoryTheory.IsPullback p₁ p₂ f₁ f₂)
      (R₀ R₁ R₂ : Type u) [CommRing R₀] [CommRing R₁] [CommRing R₂]
      (e₀ : Z₀ ≅ AlgebraicGeometry.Spec (CommRingCat.of R₀))
      (e₁ : Z₁ ≅ AlgebraicGeometry.Spec (CommRingCat.of R₁))
      (e₂ : Z₂ ≅ AlgebraicGeometry.Spec (CommRingCat.of R₂))
      (φ₁ : R₀ →+* R₁) (φ₂ : R₀ →+* R₂),
      f₁ ≫ e₀.hom = e₁.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) →
      f₂ ≫ e₀.hom = e₂.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) →
      letI : Algebra R₀ R₁ := RingHom.toAlgebra φ₁
      letI : Algebra R₀ R₂ := RingHom.toAlgebra φ₂
      ∃ e_tensor : TensorProduct R₀ R₁ R₂ ≃+ ↑(P.presheaf.obj (Opposite.op ⊤)),
        ∀ (r₁ : R₁) (r₂ : R₂),
          e_tensor (r₁ ⊗ₜ[R₀] r₂) =
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₁)).inv ≫
              e₁.hom.appTop ≫ p₁.appTop).hom r₁ *
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R₂)).inv ≫
              e₂.hom.appTop ≫ p₂.appTop).hom r₂ := by
    intro P Z₁ Z₂ Z₀ _ p₁ p₂ f₁ f₂ hPB R₀ R₁ R₂ _ _ _ e₀ e₁ e₂ φ₁ φ₂ hf₁ hf₂
    letI : Algebra R₀ R₁ := RingHom.toAlgebra φ₁
    letI : Algebra R₀ R₂ := RingHom.toAlgebra φ₂
    let g₁ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₁))
    let g₂ := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₂))
    have hcomm_to : (p₁ ≫ e₁.hom) ≫ g₁ = (p₂ ≫ e₂.hom) ≫ g₂ := by
      change (p₁ ≫ e₁.hom) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) =
        (p₂ ≫ e₂.hom) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂)
      rw [CategoryTheory.Category.assoc, ← hf₁, ← CategoryTheory.Category.assoc, hPB.w,
        CategoryTheory.Category.assoc, hf₂, CategoryTheory.Category.assoc]
    have hcomm_from :
        (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ e₁.inv) ≫ f₁ =
          (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ e₂.inv) ≫ f₂ := by
      apply (cancel_mono e₀.hom).mp
      simp only [CategoryTheory.Category.assoc]
      rw [hf₁, hf₂, e₁.inv_hom_id_assoc, e₂.inv_hom_id_assoc]
      exact CategoryTheory.Limits.pullback.condition
    let e_pb : P ≅ CategoryTheory.Limits.pullback g₁ g₂ :=
      { hom := CategoryTheory.Limits.pullback.lift (p₁ ≫ e₁.hom) (p₂ ≫ e₂.hom) hcomm_to
        inv := hPB.lift
          (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ e₁.inv)
          (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ e₂.inv)
          hcomm_from
        hom_inv_id := by
          apply hPB.hom_ext
          · simp [CategoryTheory.Limits.pullback.lift_fst_assoc]
          · simp [CategoryTheory.Limits.pullback.lift_snd_assoc]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← CategoryTheory.Category.assoc, hPB.lift_fst, CategoryTheory.Category.assoc,
              e₁.inv_hom_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← CategoryTheory.Category.assoc, hPB.lift_snd, CategoryTheory.Category.assoc,
              e₂.inv_hom_id, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp] }
    let e_sch : P ≅ AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct R₀ R₁ R₂)) :=
      e_pb ≪≫ AlgebraicGeometry.pullbackSpecIso R₀ R₁ R₂
    let incL : CommRingCat.of R₁ ⟶ CommRingCat.of (TensorProduct R₀ R₁ R₂) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
    let incR : CommRingCat.of R₂ ⟶ CommRingCat.of (TensorProduct R₀ R₁ R₂) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
    have he_fst : e_sch.hom ≫ AlgebraicGeometry.Spec.map incL = p₁ ≫ e₁.hom := by
      dsimp [e_sch, e_pb, g₁, g₂, incL]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst,
        CategoryTheory.Limits.pullback.lift_fst]
    have he_snd : e_sch.hom ≫ AlgebraicGeometry.Spec.map incR = p₂ ≫ e₂.hom := by
      dsimp [e_sch, e_pb, g₁, g₂, incR]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_snd,
        CategoryTheory.Limits.pullback.lift_snd]
    let RT := CommRingCat.of (TensorProduct R₀ R₁ R₂)
    let Φ_hom : RT ⟶ P.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso RT).inv ≫ e_sch.hom.appTop
    let Φ_inv : P.presheaf.obj (Opposite.op ⊤) ⟶ RT :=
      e_sch.inv.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso RT).hom
    have hΦ_hom_inv : Φ_hom ≫ Φ_inv = 𝟙 RT := by
      dsimp [Φ_hom, Φ_inv]
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_sch.hom.appTop,
        ← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
        AlgebraicGeometry.Scheme.Hom.id_appTop, CategoryTheory.Category.id_comp,
        (AlgebraicGeometry.Scheme.ΓSpecIso RT).inv_hom_id]
    have hΦ_inv_hom : Φ_inv ≫ Φ_hom = 𝟙 (P.presheaf.obj (Opposite.op ⊤)) := by
      dsimp [Φ_hom, Φ_inv]
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso RT).hom,
