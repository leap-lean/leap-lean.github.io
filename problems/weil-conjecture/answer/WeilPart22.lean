      let ψ_g : R_Vx →+* R_Wx := CommRingCat.Hom.hom g_x.appTop
      let ρ_Wx : R_Wx →+* S_Bx := CommRingCat.Hom.hom
        (CategoryTheory.Limits.pullback.fst (Fgt₂.obj V_obj).hom f).appTop
      let ψ_q : S_Vx →+* S_Bx := CommRingCat.Hom.hom q_x.appTop
      letI : Algebra R_Vx R_Wx := RingHom.toAlgebra ψ_g
      letI : Algebra R_Vx S_Vx := RingHom.toAlgebra φ_res
      have h_top_comm : V_x.topIso.inv ≫ (f ∣_ V_x).appTop = f.app V_x ≫ U_chart.topIso.inv := by
