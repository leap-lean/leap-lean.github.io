            let p₂ := CategoryTheory.IsCofiltered.minToRight e₁ e₂
            exact ⟨CategoryTheory.StructuredArrow.mk z.2,
              CategoryTheory.StructuredArrow.homMk p₁.1 p₁.2,
              CategoryTheory.StructuredArrow.homMk p₂.1 p₂.2, trivial⟩
          cone_maps := fun {j₁ j₂} f₁ f₂ => by
            let e₁ : F_U.Elements := CategoryTheory.Functor.elementsMk F_U j₁.right j₁.hom
            let e₂ : F_U.Elements := CategoryTheory.Functor.elementsMk F_U j₂.right j₂.hom
            let m₁ : e₁ ⟶ e₂ := ⟨f₁.right, CategoryTheory.StructuredArrow.w f₁⟩
            let m₂ : e₁ ⟶ e₂ := ⟨f₂.right, CategoryTheory.StructuredArrow.w f₂⟩
            let z := CategoryTheory.IsCofiltered.eq m₁ m₂
            let q := CategoryTheory.IsCofiltered.eqHom m₁ m₂
            have hq := CategoryTheory.IsCofiltered.eq_condition m₁ m₂
            refine ⟨CategoryTheory.StructuredArrow.mk z.2,
              CategoryTheory.StructuredArrow.homMk q.1 q.2, ?_⟩
            ext1
            exact congrArg (fun k => k.1) hq }
      let T₂ : Y₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Y₂)
        (inferInstance : AlgebraicGeometry.Etale (𝟙 Y₂))
      let u_T : U ⟶ B_h.obj T₂ := CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.lift (U.hom ≫ h) U.hom
          (CategoryTheory.Category.comp_id _).symm)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have : Nonempty (CategoryTheory.StructuredArrow U B_h) :=
        ⟨CategoryTheory.StructuredArrow.mk u_T⟩
      exact CategoryTheory.IsCofiltered.mk
    have hCompat : CategoryTheory.CompatiblePreserving Y₁.smallEtaleTopology B_h :=
      CategoryTheory.compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h
    have hCov : CategoryTheory.CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
      refine ⟨fun {U R} hR => (hMemSmallEtale Y₁ (B_h.obj U) _).mpr fun z => ?_⟩
      let fst_U : (B_h.obj U).left ⟶ U.left := CategoryTheory.Limits.pullback.fst U.hom h
      let snd_U : (B_h.obj U).left ⟶ Y₁ := CategoryTheory.Limits.pullback.snd U.hom h
      obtain ⟨V, k, y, hkR, hEt_k, hy⟩ := (hMemSmallEtale Y₂ U R).mp hR (fst_U.base z)
      let Q := CategoryTheory.Limits.pullback k.left fst_U
      let fst_Q : Q ⟶ V.left := CategoryTheory.Limits.pullback.fst k.left fst_U
      let snd_Q : Q ⟶ (B_h.obj U).left := CategoryTheory.Limits.pullback.snd k.left fst_U
      have hEt_sndQ : AlgebraicGeometry.Etale snd_Q :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback k.left fst_U) hEt_k
      have : AlgebraicGeometry.Etale (B_h.obj U).hom := (B_h.obj U).prop
      have hEt_W' : AlgebraicGeometry.Etale (snd_Q ≫ (B_h.obj U).hom) := inferInstance
      let W' : Y₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (snd_Q ≫ (B_h.obj U).hom) hEt_W'
      let g' : W' ⟶ B_h.obj U := CategoryTheory.MorphismProperty.Over.homMk snd_Q rfl trivial
      have hw_cond : fst_Q ≫ V.hom = (snd_Q ≫ snd_U) ≫ h := by
        have h_kw : k.left ≫ U.hom = V.hom := CategoryTheory.MorphismProperty.Over.w k
        have h_pb1 : fst_Q ≫ k.left = snd_Q ≫ fst_U := CategoryTheory.Limits.pullback.condition
        have h_pb2 : fst_U ≫ U.hom = snd_U ≫ h := CategoryTheory.Limits.pullback.condition
        calc
          fst_Q ≫ V.hom = fst_Q ≫ (k.left ≫ U.hom) := by rw [h_kw]
          _ = (fst_Q ≫ k.left) ≫ U.hom := (CategoryTheory.Category.assoc fst_Q k.left U.hom).symm
          _ = (snd_Q ≫ fst_U) ≫ U.hom := congrArg (· ≫ U.hom) h_pb1
          _ = snd_Q ≫ (fst_U ≫ U.hom) := CategoryTheory.Category.assoc snd_Q fst_U U.hom
          _ = snd_Q ≫ (snd_U ≫ h) := congrArg (snd_Q ≫ ·) h_pb2
          _ = (snd_Q ≫ snd_U) ≫ h := (CategoryTheory.Category.assoc snd_Q snd_U h).symm
      let w_left : Q ⟶ (B_h.obj V).left :=
        CategoryTheory.Limits.pullback.lift fst_Q (snd_Q ≫ snd_U) hw_cond
      let w : W' ⟶ B_h.obj V := CategoryTheory.MorphismProperty.Over.homMk
        w_left (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have hwg : w ≫ B_h.map k = g' := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        have h_bf_fst : (B_h.map k).left ≫ fst_U =
            CategoryTheory.Limits.pullback.fst V.hom h ≫ k.left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h_bf_snd : (B_h.map k).left ≫ snd_U =
            CategoryTheory.Limits.pullback.snd V.hom h :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        have h_w_fst : w_left ≫ CategoryTheory.Limits.pullback.fst V.hom h = fst_Q :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have h_w_snd : w_left ≫ CategoryTheory.Limits.pullback.snd V.hom h = snd_Q ≫ snd_U :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc w_left (B_h.map k).left fst_U).trans
            ((congrArg (w_left ≫ ·) h_bf_fst).trans
              ((CategoryTheory.Category.assoc w_left _ k.left).symm.trans
                ((congrArg (· ≫ k.left) h_w_fst).trans CategoryTheory.Limits.pullback.condition)))
        · exact (CategoryTheory.Category.assoc w_left (B_h.map k).left snd_U).trans
            ((congrArg (w_left ≫ ·) h_bf_snd).trans h_w_snd)
      obtain ⟨q, -, hq_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y z hy
      refine ⟨W', g', q, ?_, hEt_sndQ, hq_snd⟩
      rw [← hwg]
      exact (CategoryTheory.Sieve.functorPushforward B_h R).downward_closed
        (R.image_mem_functorPushforward B_h hkR) w
    exact CategoryTheory.Functor.isContinuous_of_coverPreserving hCompat hCov

  
  have hRightAdj : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂)
      [hc : (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology],
      ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint := by
    intro Y₁ Y₂ h hc
    let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale := weilEtaleSitePullback h
    let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let M₂ := CategoryTheory.SmallModel.{u} Y₂.AffineEtale
    let e_sm := CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale
    let S_spec := AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂
    let G₂ : M₂ ⥤ Y₂.Etale := e_sm.inverse ⋙ S_spec
    have : G₂.Full := CategoryTheory.Functor.Full.comp e_sm.inverse S_spec
    have : G₂.Faithful := CategoryTheory.Functor.Faithful.comp e_sm.inverse S_spec
    have : G₂.IsCoverDense Y₂.smallEtaleTopology := ⟨hSmallModelCover Y₂⟩
    let J_M := G₂.inducedTopology Y₂.smallEtaleTopology
    have : G₂.IsContinuous J_M Y₂.smallEtaleTopology := inferInstance
    let E_M := G₂.sheafInducedTopologyEquivOfIsCoverDense Y₂.smallEtaleTopology AddCommGrpCat.{u}
    let K : M₂ ⥤ Y₁.Etale := G₂ ⋙ B_h
    have : K.IsContinuous J_M Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_comp G₂ B_h
        J_M Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj_K := K.sheafAdjunctionContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology
    let iso_comp : K.sheafPushforwardContinuous AddCommGrpCat.{u} J_M Y₁.smallEtaleTopology ≅
        pf_h ⋙ E_M.inverse :=
      (CategoryTheory.Functor.sheafPushforwardContinuousComp G₂ B_h
        AddCommGrpCat.{u} J_M Y₂.smallEtaleTopology Y₁.smallEtaleTopology).symm
    let adj_K' := adj_K.ofNatIsoRight iso_comp
    let adj_tot := E_M.symm.toAdjunction.comp adj_K'
    let iso_pf : (pf_h ⋙ E_M.inverse) ⋙ E_M.functor ≅ pf_h :=
      CategoryTheory.Functor.associator pf_h E_M.inverse E_M.functor ≪≫
        CategoryTheory.Functor.isoWhiskerLeft pf_h E_M.counitIso ≪≫
        pf_h.rightUnitor
    exact (adj_tot.ofNatIsoRight iso_pf).isRightAdjoint

  
  let g' : W ⟶ Y := g
  let f' : Y ⟶ S := f
  let gf : W ⟶ S := CategoryTheory.CategoryStruct.comp g f
  have hr_g : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y.smallEtaleTopology W.smallEtaleTopology).IsRightAdjoint := hRightAdj g'
  have hc_f : (weilEtaleSitePullback f).IsContinuous S.smallEtaleTopology Y.smallEtaleTopology :=
    hSiteCont f'
  have hc_gf : (weilEtaleSitePullback gf).IsContinuous S.smallEtaleTopology W.smallEtaleTopology :=
    hSiteCont gf

  have hPresMono_g : ((weilEtaleSitePullback g).sheafPullback AddCommGrpCat.{u}
      Y.smallEtaleTopology W.smallEtaleTopology).PreservesMonomorphisms := by
    let skyPre : ∀ {E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E]
        (fib : (E ⥤ Type u)), AddCommGrpCat.{u} ⥤ (Eᵒᵖ ⥤ AddCommGrpCat.{u}) :=
      fun {E} _ fib =>
        { obj := fun M =>
            { obj := fun X => AddCommGrpCat.of (fib.obj X.unop → ↥M)
              map := fun u_op => AddCommGrpCat.ofHom
                { toFun := fun s x => s (fib.map u_op.unop x)
                  map_zero' := rfl
                  map_add' := fun _ _ => rfl }
              map_id := fun X => by
                ext s x
                change s ((fib.map (𝟙 X.unop)) x) = s x
                rw [fib.map_id]; rfl
              map_comp := fun u₁ u₂ => by
                ext s x
                change s ((fib.map (u₂.unop ≫ u₁.unop)) x) =
                  s ((fib.map u₁.unop) ((fib.map u₂.unop) x))
                rw [fib.map_comp]; rfl }
          map := fun φ =>
            { app := fun X => AddCommGrpCat.ofHom
                { toFun := fun s x => φ.hom (s x)
                  map_zero' := funext fun _ => map_zero φ.hom
                  map_add' := fun s₁ s₂ => funext fun x => map_add φ.hom (s₁ x) (s₂ x) }
              naturality := fun _ _ _ => rfl }
          map_id := fun _ => rfl
          map_comp := fun _ _ => rfl }
    have hSkyIsSheaf : ∀ {E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E]
        (L : CategoryTheory.GrothendieckTopology E)
        (Θ : CategoryTheory.GrothendieckTopology.Point.{u} L)
        (M : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf L ((skyPre Θ.fiber).obj M) := by
      intro E _ L Θ M A W₀ R hR x hx
      have h_lift : ∀ w : Θ.fiber.obj W₀,
          ∃ (Y_w : E) (f_w : Y_w ⟶ W₀) (_ : R.arrows f_w) (y_w : Θ.fiber.obj Y_w),
            Θ.fiber.map f_w y_w = w :=
        fun w => Θ.jointly_surjective R hR w
      let Y_fn := fun w => Classical.choose (h_lift w)
      let f_fn := fun w => Classical.choose (Classical.choose_spec (h_lift w))
      let hf_fn := fun w => Classical.choose
        (Classical.choose_spec (Classical.choose_spec (h_lift w)))
      let y_fn := fun w => Classical.choose
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (h_lift w))))
      have hy_fn : ∀ w, Θ.fiber.map (f_fn w) (y_fn w) = w := fun w =>
        Classical.choose_spec
          (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (h_lift w))))
      have h_well : ∀ {Y₁ Y₂ : E} {f₁ : Y₁ ⟶ W₀} {f₂ : Y₂ ⟶ W₀}
          (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂)
          (y₁ : Θ.fiber.obj Y₁) (y₂ : Θ.fiber.obj Y₂),
          Θ.fiber.map f₁ y₁ = Θ.fiber.map f₂ y₂ →
          ∀ a : ↥A, (x f₁ hf₁).hom a y₁ = (x f₂ hf₂).hom a y₂ := by
        intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ heq a
        have : CategoryTheory.IsCofiltered Θ.fiber.Elements := Θ.isCofiltered
        let e₁ : Θ.fiber.Elements := CategoryTheory.Functor.elementsMk Θ.fiber Y₁ y₁
        let e₂ : Θ.fiber.Elements := CategoryTheory.Functor.elementsMk Θ.fiber Y₂ y₂
        let eW : Θ.fiber.Elements := CategoryTheory.Functor.elementsMk Θ.fiber W₀ (Θ.fiber.map f₁ y₁)
        let m₁ : e₁ ⟶ eW := ⟨f₁, rfl⟩
        let m₂ : e₂ ⟶ eW := ⟨f₂, heq.symm⟩
        let z₀ := CategoryTheory.IsCofiltered.min e₁ e₂
        let p₁ : z₀ ⟶ e₁ := CategoryTheory.IsCofiltered.minToLeft e₁ e₂
        let p₂ : z₀ ⟶ e₂ := CategoryTheory.IsCofiltered.minToRight e₁ e₂
        let z₁ := CategoryTheory.IsCofiltered.eq (p₁ ≫ m₁) (p₂ ≫ m₂)
        let q : z₁ ⟶ z₀ := CategoryTheory.IsCofiltered.eqHom (p₁ ≫ m₁) (p₂ ≫ m₂)
        have hq : q ≫ p₁ ≫ m₁ = q ≫ p₂ ≫ m₂ :=
          CategoryTheory.IsCofiltered.eq_condition (p₁ ≫ m₁) (p₂ ≫ m₂)
        let g₁ : z₁.1 ⟶ Y₁ := (q ≫ p₁).1
        let g₂ : z₁.1 ⟶ Y₂ := (q ≫ p₂).1
        have hg_eq : g₁ ≫ f₁ = g₂ ≫ f₂ := by
          simpa [g₁, g₂, m₁, m₂, CategoryTheory.Category.assoc] using
            congrArg (fun k => k.1) hq
        have hz₁ : Θ.fiber.map g₁ z₁.2 = y₁ := (q ≫ p₁).2
        have hz₂ : Θ.fiber.map g₂ z₁.2 = y₂ := (q ≫ p₂).2
        have hc := hx g₁ g₂ hf₁ hf₂ hg_eq
        have hev := congrArg (fun φ : A ⟶ ((skyPre Θ.fiber).obj M).obj (Opposite.op z₁.1) =>
          φ.hom a z₁.2) hc
        change (x f₁ hf₁).hom a (Θ.fiber.map g₁ z₁.2) =
          (x f₂ hf₂).hom a (Θ.fiber.map g₂ z₁.2) at hev
        rwa [hz₁, hz₂] at hev
      let s : A ⟶ ((skyPre Θ.fiber).obj M).obj (Opposite.op W₀) := AddCommGrpCat.ofHom
        { toFun := fun a w => (x (f_fn w) (hf_fn w)).hom a (y_fn w)
          map_zero' := funext fun w => by
            change ((x (f_fn w) (hf_fn w)).hom 0) (y_fn w) = 0
            rw [map_zero]; rfl
          map_add' := fun a₁ a₂ => funext fun w => by
            change ((x (f_fn w) (hf_fn w)).hom (a₁ + a₂)) (y_fn w) = _
            rw [map_add]; rfl }
      refine ⟨s, fun Y' k hk => ?_, fun s' hs' => ?_⟩
      · apply AddCommGrpCat.hom_ext
        ext a y
        exact h_well (hf_fn (Θ.fiber.map k y)) hk (y_fn (Θ.fiber.map k y)) y
          (hy_fn (Θ.fiber.map k y)) a
      · apply AddCommGrpCat.hom_ext
        ext a w
        have hspec := hs' (f_fn w) (hf_fn w)
        have heval := congrArg (fun φ : A ⟶ ((skyPre Θ.fiber).obj M).obj (Opposite.op (Y_fn w)) =>
          φ.hom a (y_fn w)) hspec
        change (s'.hom a) (Θ.fiber.map (f_fn w) (y_fn w)) =
          (x (f_fn w) (hf_fn w)).hom a (y_fn w) at heval
        exact (congrArg (s'.hom a) (hy_fn w).symm).trans heval
    let skySheaf : ∀ {E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E]
        (L : CategoryTheory.GrothendieckTopology E)
        (Θ : CategoryTheory.GrothendieckTopology.Point.{u} L),
        AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf L AddCommGrpCat.{u} :=
      fun {E} _ L Θ =>
        { obj := fun M => ⟨(skyPre Θ.fiber).obj M, hSkyIsSheaf L Θ M⟩
          map := fun φ => ⟨(skyPre Θ.fiber).map φ⟩
          map_id := fun _ => rfl
          map_comp := fun _ _ => rfl }
    have hSkyAdj : ∀ {E : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} E]
        (L : CategoryTheory.GrothendieckTopology E)
        (Θ : CategoryTheory.GrothendieckTopology.Point.{u} L),
        Nonempty ((Θ.sheafFiber (A := AddCommGrpCat.{u})) ⊣ skySheaf L Θ) := by
      intro E _ L Θ
      let S_Θ := skySheaf L Θ
      let evalAt : ∀ {X : E} (x : Θ.fiber.obj X) (M : AddCommGrpCat.{u}),
