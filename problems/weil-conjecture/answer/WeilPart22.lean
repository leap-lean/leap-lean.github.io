        θ₁.app (Opposite.op T₁') := by
      change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT₁').comp shAdj₁).unit.app A = _
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app]
      exact CategoryTheory.Category.id_comp (θ₁.app (Opposite.op T₁'))
    have hθ₁_nat : ∀ (W : X₁.Etale) (w : Quiver.Hom W T₁'),
