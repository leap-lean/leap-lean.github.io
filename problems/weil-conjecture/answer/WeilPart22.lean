      let i_V₀ : W_x.toScheme ⟶ V_x.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift V_x.ι (W_x.ι ≫ (Fgt₂.obj U).hom) hrange
      have hi_V₀ : i_V₀ ≫ V_x.ι = (Fgt₂.obj V₀).hom :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac V_x.ι (W_x.ι ≫ (Fgt₂.obj U).hom) hrange
      have hAff_V₀ : AlgebraicGeometry.IsAffine (Fgt₂.obj V₀).left := hAff_Wx
      obtain ⟨q_V₀, _, e_tens₀, he_tens₀⟩ :=
        hChart_pullback V_x hAff_Vx hAff_Ux V₀ hAff_V₀ i_V₀ hi_V₀
      obtain ⟨M_V₀, hAdd_V₀, hMod_V₀, b_V₀, e_V₀, he_V₀⟩ :=
        hPres_bc (f.app V_x).hom
          ((CategoryTheory.Limits.pullback.fst (Fgt₂.obj V₀).hom f).appTop).hom
          (V_x.topIso.inv ≫ i_V₀.appTop).hom
          (U_x.topIso.inv ≫ q_V₀.appTop).hom
          e_tens₀ he_tens₀ M_x b_x e_x he_x
      exact ⟨V₀, j₀, ⟨hAff_V₀, M_V₀, hAdd_V₀, hMod_V₀, b_V₀, e_V₀, he_V₀⟩,
        (inferInstance : AlgebraicGeometry.Etale W_x.ι), ⟨⟨x, hx_Wx⟩, rfl⟩⟩
    choose V j hGood hj_et hj_mem using hPt
    refine ⟨Idx, V, j, ?_, hGood⟩
    change CategoryTheory.Sieve.ofArrows V j ∈ X₂.smallEtaleTopology U
    unfold AlgebraicGeometry.Scheme.smallEtaleTopology
    haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    erw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      X₂ (le_rfl : (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty _) ≤ _),
      AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology]
    intro x
    obtain ⟨y, hy⟩ := hj_mem x
    exact ⟨V x, j x, y, CategoryTheory.Sieve.ofArrows_mk V j x, hj_et x, hy⟩

  
  
  
  let P₁ : CategoryTheory.Functor (X₂.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    B.op ⋙ weilEtaleGmPresheaf X₁
  let P₂ : CategoryTheory.Functor (X₂.Etale)ᵒᵖ AddCommGrpCat.{u} :=
    weilEtaleGmPresheaf X₂
  have hP₂ : CategoryTheory.Presheaf.IsSheaf J₂ P₂ := hGm X₂
  choose Idx_cov V_cov j_cov hSieve_cov hGood_cov using hEt_cov

  have hSep : ∀ (U : X₂.Etale) (y₁ y₂ : ↑(P₂.obj (Opposite.op U))),
      (∀ (V : X₂.Etale) (_ : Good V) (g : Quiver.Hom V U),
        (P₂.map (Opposite.op g)).hom y₁ = (P₂.map (Opposite.op g)).hom y₂) →
      y₁ = y₂ := by
    intro U y₁ y₂ hy
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let f₁ : Aℤ ⟶ P₂.obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • y₁
          map_zero' := zero_zsmul y₁
          map_add' := fun a b => add_zsmul y₁ a.down b.down }
    let f₂ : Aℤ ⟶ P₂.obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := fun n => n.down • y₂
          map_zero' := zero_zsmul y₂
          map_add' := fun a b => add_zsmul y₂ a.down b.down }
    have hf_eq : f₁ = f₂ := by
      apply hP₂.hom_ext_ofArrows (j_cov U) (hSieve_cov U)
      intro i
      apply AddCommGrpCat.ext
      intro n
      have hy_i : (P₂.map (j_cov U i).op).hom y₁ = (P₂.map (j_cov U i).op).hom y₂ :=
        hy (V_cov U i) (hGood_cov U i) (j_cov U i)
      change (P₂.map (j_cov U i).op).hom (n.down • y₁) =
        (P₂.map (j_cov U i).op).hom (n.down • y₂)
      rw [map_zsmul, map_zsmul, hy_i]
    have h1 := congrArg (fun φ : Aℤ ⟶ P₂.obj (Opposite.op U) => φ.hom (ULift.up (1 : ℤ))) hf_eq
    change (1 : ℤ) • y₁ = (1 : ℤ) • y₂ at h1
    rwa [one_zsmul, one_zsmul] at h1

  have hGood_norm : ∀ (U : X₂.Etale), Good U →
      ∃ (ν : Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) →*
          Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))),
        ∀ (M : Type u) [AddCommGroup M]
          [Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M]
          (bM : Module.Basis (Fin d) ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
          (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
          (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
            e (r₀ • m) =
              @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
                (CommRingCat.Hom.hom
                  (AlgebraicGeometry.Scheme.Hom.appTop
                    (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
                (e m)) →
          ∀ (w : Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)))
            (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
            (∀ m : M, e (L m) = w.val * e m) →
            (ν w).val = ((LinearMap.toMatrix bM bM) L).det := by
    intro U hU
    rcases hU.2 with ⟨M₀, hAdd₀, hMod₀, b₀, e₀, he₀⟩
    letI : AddCommGroup M₀ := hAdd₀
    letI : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M₀ := hMod₀
    exact hRing_unit
      ((CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f).appTop).hom
      M₀ b₀ e₀ he₀

  let ν_good : ∀ (U : X₂.Etale), Good U →
      Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) →*
        Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
    fun U hU => Classical.choose (hGood_norm U hU)
  have hν_good := fun U hU => Classical.choose_spec (hGood_norm U hU)

  let φ_good : ∀ (U : X₂.Etale), Good U →
      Quiver.Hom (P₁.obj (Opposite.op U)) (P₂.obj (Opposite.op U)) :=
    fun U hU => AddCommGrpCat.ofHom (MonoidHom.toAdditive (ν_good U hU))

  have hNat_good : ∀ {U' U : X₂.Etale} (hU' : Good U') (hU : Good U) (v : Quiver.Hom U' U),
      P₁.map v.op ≫ φ_good U' hU' = φ_good U hU ≫ P₂.map v.op := by
    intro U' U hU' hU v
    apply AddCommGrpCat.ext
    intro x
    let w : Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) :=
      @Additive.toMul _ x
    change Additive.ofMul
        (ν_good U' hU' (Units.map (((Fgt₁.map (B.map v)).left).appTop).hom.toMonoidHom w)) =
      Additive.ofMul
        (Units.map (((Fgt₂.map v).left).appTop).hom.toMonoidHom (ν_good U hU w))
    congr 1
    apply Units.ext
    change (ν_good U' hU'
        (Units.map (((Fgt₁.map (B.map v)).left).appTop).hom.toMonoidHom w)).val =
      (((Fgt₂.map v).left).appTop).hom (ν_good U hU w).val
    rcases hU.2 with ⟨M₀, hAdd₀, hMod₀, b₀, e₀, he₀⟩
    rcases hU'.2 with ⟨M'₀, hAdd'₀, hMod'₀, b'₀, e'₀, he'₀⟩
    letI : AddCommGroup M₀ := hAdd₀
    letI : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M₀ := hMod₀
    letI : AddCommGroup M'₀ := hAdd'₀
    letI : Module ↑(((Fgt₂.obj U').left).presheaf.obj (Opposite.op ⊤)) M'₀ := hMod'₀
    let ρ := ((CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f).appTop).hom
    let ρ' := ((CategoryTheory.Limits.pullback.fst (Fgt₂.obj U').hom f).appTop).hom
    let ψ_R := (((Fgt₂.map v).left).appTop).hom
    let ψ_S := (((Fgt₁.map (B.map v)).left).appTop).hom
    let L₀ := mkMulLin ρ M₀ e₀ he₀ w.val
    let L'₀ := mkMulLin ρ' M'₀ e'₀ he'₀ (ψ_S w.val)
    have hdet₀ := @hν_good U hU M₀ _ _ b₀ e₀ he₀ w L₀ (hmkMulLin ρ M₀ e₀ he₀ w.val)
    have hdet'₀ := @hν_good U' hU' M'₀ _ _ b'₀ e'₀ he'₀
      (Units.map ψ_S.toMonoidHom w) L'₀
      (hmkMulLin ρ' M'₀ e'₀ he'₀ (ψ_S w.val))
    obtain ⟨e_tensor, he_tensor⟩ := hEt_bc hU'.1 hU.1 v
    rw [hdet'₀, hdet₀]
    exact hRing_bc ρ ρ' ψ_R ψ_S e_tensor he_tensor M₀ b₀ e₀ he₀ M'₀ b'₀ e'₀ he'₀
      w.val L₀ L'₀ (hmkMulLin ρ M₀ e₀ he₀ w.val)
      (hmkMulLin ρ' M'₀ e'₀ he'₀ (ψ_S w.val))

  let x_cov : ∀ (U : X₂.Etale) (i : Idx_cov U),
      P₁.obj (Opposite.op U) ⟶ P₂.obj (Opposite.op (V_cov U i)) :=
    fun U i => P₁.map (j_cov U i).op ≫ φ_good (V_cov U i) (hGood_cov U i)

  have hx_cov : ∀ (U : X₂.Etale) ⦃W : X₂.Etale⦄ ⦃i₁ i₂ : Idx_cov U⦄
      (g₁ : W ⟶ V_cov U i₁) (g₂ : W ⟶ V_cov U i₂),
      g₁ ≫ j_cov U i₁ = g₂ ≫ j_cov U i₂ →
      x_cov U i₁ ≫ P₂.map g₁.op = x_cov U i₂ ≫ P₂.map g₂.op := by
    intro U W i₁ i₂ g₁ g₂ hcomm
    apply hP₂.hom_ext_ofArrows (j_cov W) (hSieve_cov W)
    intro k
    dsimp [x_cov]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      ← P₂.map_comp, ← P₂.map_comp, ← op_comp, ← op_comp,
      ← hNat_good (hGood_cov W k) (hGood_cov U i₁) (j_cov W k ≫ g₁),
      ← hNat_good (hGood_cov W k) (hGood_cov U i₂) (j_cov W k ≫ g₂),
      ← CategoryTheory.Category.assoc (P₁.map (j_cov U i₁).op),
      ← CategoryTheory.Category.assoc (P₁.map (j_cov U i₂).op),
      ← P₁.map_comp, ← P₁.map_comp, ← op_comp, ← op_comp,
      CategoryTheory.Category.assoc (j_cov W k) g₁, hcomm,
      ← CategoryTheory.Category.assoc (j_cov W k) g₂]

  let τ_app : ∀ U : X₂.Etale, P₁.obj (Opposite.op U) ⟶ P₂.obj (Opposite.op U) :=
    fun U => hP₂.amalgamateOfArrows (j_cov U) (hSieve_cov U) (x_cov U) (hx_cov U)

  have hτ_map : ∀ (U : X₂.Etale) (i : Idx_cov U),
      τ_app U ≫ P₂.map (j_cov U i).op = x_cov U i :=
    fun U i => hP₂.amalgamateOfArrows_map (j_cov U) (hSieve_cov U) (x_cov U) (hx_cov U) i

  have h_good_mor : ∀ {W U : X₂.Etale} (hW : Good W) (w : W ⟶ U),
      τ_app U ≫ P₂.map w.op = P₁.map w.op ≫ φ_good W hW := by
    intro W U hW w
    let S_pull : J₂.Cover W :=
      ⟨CategoryTheory.Sieve.pullback w (CategoryTheory.Sieve.ofArrows (V_cov U) (j_cov U)),
        J₂.pullback_stable w (hSieve_cov U)⟩
    apply hP₂.hom_ext S_pull
    intro I
    rcases I.hf with ⟨Z, q, p_arr, ⟨i⟩, hq⟩
    apply hP₂.hom_ext_ofArrows (j_cov I.Y) (hSieve_cov I.Y)
    intro k
    let p := j_cov I.Y k
    calc
      (τ_app U ≫ P₂.map w.op) ≫ P₂.map I.f.op ≫ P₂.map p.op
        = τ_app U ≫ P₂.map (p ≫ (I.f ≫ w)).op := by
            rw [CategoryTheory.Category.assoc, ← P₂.map_comp, ← P₂.map_comp,
              ← op_comp, ← op_comp, CategoryTheory.Category.assoc]
      _ = τ_app U ≫ P₂.map ((p ≫ q) ≫ j_cov U i).op := by
            rw [← hq, CategoryTheory.Category.assoc]
      _ = (τ_app U ≫ P₂.map (j_cov U i).op) ≫ P₂.map (p ≫ q).op := by
            rw [op_comp, P₂.map_comp, CategoryTheory.Category.assoc]
      _ = P₁.map (j_cov U i).op ≫ (φ_good (V_cov U i) (hGood_cov U i) ≫ P₂.map (p ≫ q).op) := by
            rw [hτ_map U i, CategoryTheory.Category.assoc]
      _ = P₁.map (j_cov U i).op ≫ P₁.map (p ≫ q).op ≫ φ_good (V_cov I.Y k) (hGood_cov I.Y k) := by
            rw [← hNat_good (hGood_cov I.Y k) (hGood_cov U i) (p ≫ q)]
      _ = P₁.map (p ≫ (I.f ≫ w)).op ≫ φ_good (V_cov I.Y k) (hGood_cov I.Y k) := by
            rw [← CategoryTheory.Category.assoc, ← P₁.map_comp, ← op_comp,
              CategoryTheory.Category.assoc p q, hq]
      _ = P₁.map w.op ≫ (P₁.map (p ≫ I.f).op ≫ φ_good (V_cov I.Y k) (hGood_cov I.Y k)) := by
            rw [← CategoryTheory.Category.assoc p I.f w, op_comp, P₁.map_comp,
              CategoryTheory.Category.assoc]
      _ = P₁.map w.op ≫ (φ_good W hW ≫ P₂.map (p ≫ I.f).op) := by
            rw [hNat_good (hGood_cov I.Y k) hW (p ≫ I.f)]
      _ = (P₁.map w.op ≫ φ_good W hW) ≫ P₂.map I.f.op ≫ P₂.map p.op := by
            rw [op_comp, P₂.map_comp, ← CategoryTheory.Category.assoc (P₁.map w.op)]

  have h_good_eq : ∀ (U : X₂.Etale) (hU : Good U), τ_app U = φ_good U hU := by
    intro U hU
    have h1 := h_good_mor hU (𝟙 U)
    simpa only [op_id, P₁.map_id, P₂.map_id, CategoryTheory.Category.comp_id,
      CategoryTheory.Category.id_comp] using h1

  have hτ_nat : ∀ {U' U : X₂.Etale} (u : Quiver.Hom U' U),
      P₁.map u.op ≫ τ_app U' = τ_app U ≫ P₂.map u.op := by
    intro U' U u
    apply hP₂.hom_ext_ofArrows (j_cov U') (hSieve_cov U')
    intro k
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      h_good_mor (hGood_cov U' k) (j_cov U' k),
      ← P₂.map_comp, ← op_comp,
      h_good_mor (hGood_cov U' k) (j_cov U' k ≫ u),
      ← CategoryTheory.Category.assoc, ← P₁.map_comp, ← op_comp]

  
  
  
  let τ_hom : ∀ U : X₂.Etale,
      Additive (Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))) →+
        Additive (Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) :=
    fun U => (τ_app U).hom

  let ν_f : ∀ U : X₂.Etale,
      Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) →*
        Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
    fun U => MonoidHom.toAdditive.symm (τ_hom U)

  have hν_nat : ∀ {U' U : X₂.Etale} (u : Quiver.Hom U' U)
      (w : Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
      Units.map (((Fgt₂.map u).left).appTop).hom.toMonoidHom (ν_f U w) =
        ν_f U' (Units.map (((Fgt₁.map (B.map u)).left).appTop).hom.toMonoidHom w) := by
    intro U' U u w
    have h1 := congrArg
      (fun φ : P₁.obj (Opposite.op U) ⟶ P₂.obj (Opposite.op U') => φ.hom (Additive.ofMul w))
      (hτ_nat u).symm
    have htoAdd : ∀ (W : X₂.Etale)
        (z : Units ↑(((Fgt₁.obj (B.obj W)).left).presheaf.obj (Opposite.op ⊤))),
        τ_hom W (Additive.ofMul z) = Additive.ofMul (ν_f W z) := by
      intro W z
      have heq : MonoidHom.toAdditive (ν_f W) = τ_hom W :=
        MonoidHom.toAdditive.apply_symm_apply (τ_hom W)
      rw [← heq]
      rfl
    have h1' :
        Additive.ofMul
            (Units.map (((Fgt₂.map u).left).appTop).hom.toMonoidHom
              (@Additive.toMul _ (τ_hom U (Additive.ofMul w)))) =
          τ_hom U'
            (Additive.ofMul
              (Units.map (((Fgt₁.map (B.map u)).left).appTop).hom.toMonoidHom w)) := h1
    rw [htoAdd U w, htoAdd U' _] at h1'
    exact congrArg (@Additive.toMul _) h1'

  have hν_det : ∀ (U : X₂.Etale)
      (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj U).left)
      (M : Type u) (_ : AddCommGroup M)
      (_ : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
      (bM : Module.Basis (Fin d)
        ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
      (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
      (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
        e (r₀ • m) =
          @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
            (CommRingCat.Hom.hom
              (AlgebraicGeometry.Scheme.Hom.appTop
                (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
            (e m)) →
      ∀ (w : Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)))
        (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
        (∀ m : M, e (L m) = (w : ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))) * e m) →
        ((ν_f U w : Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) :
          ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) =
          ((LinearMap.toMatrix bM bM) L).det := by
    intro U hAff_U M hAdd hMod bM e he w L hL
    letI : AddCommGroup M := hAdd
    letI : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M := hMod
    have hU : Good U := ⟨hAff_U, M, hAdd, hMod, bM, e, he⟩
    have hν_eq : ν_f U = ν_good U hU := by
      dsimp [ν_f, τ_hom]
      rw [h_good_eq U hU]
      exact MonoidHom.toAdditive.symm_apply_apply (ν_good U hU)
    rw [hν_eq]
    exact @hν_good U hU M hAdd hMod bM e he w L hL

  have hν_sep : ∀ (U : X₂.Etale)
      (y₁ y₂ : Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))),
      (∀ (V : X₂.Etale) (g : Quiver.Hom V U)
          (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj V).left)
          (M : Type u) (_ : AddCommGroup M)
          (_ : Module ↑(((Fgt₂.obj V).left).presheaf.obj (Opposite.op ⊤)) M)
          (_bM : Module.Basis (Fin d)
            ↑(((Fgt₂.obj V).left).presheaf.obj (Opposite.op ⊤)) M)
          (e : M ≃+ ↑(((Fgt₁.obj (B.obj V)).left).presheaf.obj (Opposite.op ⊤))),
        (∀ (r₀ : ↑(((Fgt₂.obj V).left).presheaf.obj (Opposite.op ⊤))) (m : M),
          e (r₀ • m) =
            @Mul.mul ↑(((Fgt₁.obj (B.obj V)).left).presheaf.obj (Opposite.op ⊤)) _
              (CommRingCat.Hom.hom
                (AlgebraicGeometry.Scheme.Hom.appTop
                  (CategoryTheory.Limits.pullback.fst (Fgt₂.obj V).hom f)) r₀)
              (e m)) →
        Units.map (((Fgt₂.map g).left).appTop).hom.toMonoidHom y₁ =
          Units.map (((Fgt₂.map g).left).appTop).hom.toMonoidHom y₂) →
      y₁ = y₂ := by
    intro U y₁ y₂ hy
    have h_add : Additive.ofMul y₁ = Additive.ofMul y₂ := by
      apply hSep U (Additive.ofMul y₁) (Additive.ofMul y₂)
      rintro V ⟨hAff_V, M, hAdd, hMod, bM, e, he⟩ g
      exact congrArg Additive.ofMul (hy V g hAff_V M hAdd hMod bM e he)
    exact congrArg (@Additive.toMul _) h_add

  have h_topIso_homOfLE : ∀ (Z : AlgebraicGeometry.Scheme.{u}) {W' W : Z.Opens} (h : W' ≤ W),
      W.topIso.inv ≫ (Z.homOfLE h).appTop =
        Z.presheaf.map (CategoryTheory.homOfLE h).op ≫ W'.topIso.inv := by
    intro Z W' W h
    apply (cancel_mono W'.topIso.hom).mp
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      W'.topIso.inv_hom_id, CategoryTheory.Category.comp_id]
    erw [AlgebraicGeometry.Scheme.Opens.topIso_inv, AlgebraicGeometry.Scheme.homOfLE_appTop,
      AlgebraicGeometry.Scheme.Opens.topIso_hom, ← Z.presheaf.map_comp, ← Z.presheaf.map_comp]
    rfl

  refine ⟨ν_f, @hν_nat, hν_det, hν_sep, ?_⟩
  intro V₁ V₂
  dsimp only
  let U₁ : X₁.Opens := (TopologicalSpace.Opens.map f.base).obj V₁
  let U₂ : X₁.Opens := (TopologicalSpace.Opens.map f.base).obj V₂
  intro hAff_V₁ hAff_U₁ M₁ hAdd₁ hMod₁ bM₁ eM₁ heM₁ g₁ L_g hLg u_U u_V hu_U hu_V
  letI : AddCommGroup M₁ := hAdd₁
  letI : Module ↑(X₂.presheaf.obj (Opposite.op V₁)) M₁ := hMod₁
  let V₁₂_et : X₂.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (V₁ ⊓ V₂).ι
      (inferInstance : AlgebraicGeometry.Etale (V₁ ⊓ V₂).ι)
  let U₁₂_et : X₁.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (U₁ ⊓ U₂).ι
      (inferInstance : AlgebraicGeometry.Etale (U₁ ⊓ U₂).ι)
  intro ψ₁₂
  let w_U₁₂ := Units.map (((Fgt₁.map ψ₁₂).left).appTop).hom.toMonoidHom
    (Units.map ((U₁ ⊓ U₂).topIso.inv).hom.toMonoidHom u_U)
  let y_RHS := Units.map ((V₁ ⊓ V₂).topIso.inv).hom.toMonoidHom u_V
  apply hν_sep V₁₂_et (ν_f V₁₂_et w_U₁₂) y_RHS
  intro V g hAff_V M hAdd hMod bM e he
  letI : AddCommGroup M := hAdd
  letI : Module ↑(((Fgt₂.obj V).left).presheaf.obj (Opposite.op ⊤)) M := hMod
  rw [hν_nat g w_U₁₂]
  let w_V := Units.map (((Fgt₁.map (B.map g)).left).appTop).hom.toMonoidHom w_U₁₂
  let g₂_sch : (Fgt₂.obj V).left ⟶ (V₁ ⊓ V₂).toScheme := (Fgt₂.map g).left
  let i_V : (Fgt₂.obj V).left ⟶ V₁.toScheme :=
    g₂_sch ≫ X₂.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)
  have hi_V : i_V ≫ V₁.ι = (Fgt₂.obj V).hom := by
    dsimp [i_V]
    rw [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
    exact CategoryTheory.MorphismProperty.Over.w g
  obtain ⟨q_V, hq_V_ι, e_tensor, he_tensor⟩ :=
    hChart_pullback V₁ hAff_V₁ hAff_U₁ V hAff_V i_V hi_V
  let Bg_sch : (Fgt₁.obj (B.obj V)).left ⟶ (Fgt₁.obj (B.obj V₁₂_et)).left :=
    (Fgt₁.map (B.map g)).left
  let ψ₁₂_sch : (Fgt₁.obj (B.obj V₁₂_et)).left ⟶ (U₁ ⊓ U₂).toScheme :=
    (Fgt₁.map ψ₁₂).left
  have hq_V_eq :
      q_V = Bg_sch ≫ ψ₁₂_sch ≫ X₁.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁) := by
    apply (cancel_mono U₁.ι).mp
    rw [hq_V_ι, CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
      AlgebraicGeometry.Scheme.homOfLE_ι]
    have hψ_w : ψ₁₂_sch ≫ (U₁ ⊓ U₂).ι = (Fgt₁.obj (B.obj V₁₂_et)).hom :=
      CategoryTheory.MorphismProperty.Over.w ψ₁₂
    rw [hψ_w]
    exact (CategoryTheory.MorphismProperty.Over.w (B.map g)).symm
  let ψ_R := (V₁.topIso.inv ≫ i_V.appTop).hom
  let ψ_S := (U₁.topIso.inv ≫ q_V.appTop).hom
  have hw_V_val : w_V.val = ψ_S g₁ := by
    have h_map :
        U₁.topIso.inv ≫ q_V.appTop =
          X₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op ≫
            (U₁ ⊓ U₂).topIso.inv ≫ ψ₁₂_sch.appTop ≫ Bg_sch.appTop := by
      rw [hq_V_eq, AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.Hom.comp_appTop,
        ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
        h_topIso_homOfLE X₁ (inf_le_left : U₁ ⊓ U₂ ≤ U₁),
        CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
    have h_app := congrArg (fun φ => φ.hom g₁) h_map
    change Bg_sch.appTop.hom (ψ₁₂_sch.appTop.hom (((U₁ ⊓ U₂).topIso.inv).hom u_U.val)) =
      (U₁.topIso.inv ≫ q_V.appTop).hom g₁
    rw [hu_U]
    exact h_app.symm
  have hy_RHS_val :
      (Units.map (((Fgt₂.map g).left).appTop).hom.toMonoidHom y_RHS).val =
        ψ_R (((LinearMap.toMatrix bM₁ bM₁) L_g).det) := by
    have h_map :
        V₁.topIso.inv ≫ i_V.appTop =
          X₂.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op ≫
            (V₁ ⊓ V₂).topIso.inv ≫ g₂_sch.appTop := by
      dsimp only [i_V]
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, ← CategoryTheory.Category.assoc,
        h_topIso_homOfLE X₂ (inf_le_left : V₁ ⊓ V₂ ≤ V₁), CategoryTheory.Category.assoc]
    have h_app := congrArg (fun φ => φ.hom (((LinearMap.toMatrix bM₁ bM₁) L_g).det)) h_map
    change g₂_sch.appTop.hom (((V₁ ⊓ V₂).topIso.inv).hom u_V.val) =
      (V₁.topIso.inv ≫ i_V.appTop).hom (((LinearMap.toMatrix bM₁ bM₁) L_g).det)
    rw [hu_V]
    exact h_app.symm
  let ρ_V := ((CategoryTheory.Limits.pullback.fst (Fgt₂.obj V).hom f).appTop).hom
  let L_V := mkMulLin ρ_V M e he w_V.val
  have hL_V_w : ∀ m : M, e (L_V m) = w_V.val * e m :=
    hmkMulLin ρ_V M e he w_V.val
  have hL_V_ψ : ∀ m : M, e (L_V m) = ψ_S g₁ * e m := by
    intro m
    rw [hL_V_w m, hw_V_val]
  apply Units.ext
  calc
    (ν_f V w_V).val
      = ((LinearMap.toMatrix bM bM) L_V).det :=
          hν_det V hAff_V M hAdd hMod bM e he w_V L_V hL_V_w
    _ = ψ_R (((LinearMap.toMatrix bM₁ bM₁) L_g).det) :=
          hRing_bc (f.app V₁).hom ρ_V ψ_R ψ_S e_tensor he_tensor
            M₁ bM₁ eM₁ heM₁ M bM e he g₁ L_g L_V hLg hL_V_ψ
    _ = (Units.map (((Fgt₂.map g).left).appTop).hom.toMonoidHom y_RHS).val :=
          hy_RHS_val.symm

theorem weil_polyP1_last_coord_kummer_exact_adjunction_leray_comm {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂) (n : ℕ)
    (hCont : (weilEtaleSitePullback f).IsContinuous
      X₂.smallEtaleTopology X₁.smallEtaleTopology) :
    let B := weilEtaleSitePullback f
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
      AddCommGrpCat.{u} _ J₂ J₁ hCont
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    ∀ (P_pull : CategoryTheory.Functor
          (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
          (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
      (adj_pull : CategoryTheory.Adjunction P_pull P_push)
      (hAdd_pull : P_pull.Additive)
      (hLim_pull : CategoryTheory.Limits.PreservesFiniteLimits P_pull)
      (hColim_pull : CategoryTheory.Limits.PreservesFiniteColimits P_pull)
      (hAdd_push : P_push.Additive)
      (hLim_push : CategoryTheory.Limits.PreservesFiniteLimits P_push)
      (hColim_push : CategoryTheory.Limits.PreservesFiniteColimits P_push)
      (T₁ : X₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : X₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (ιℤ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (C₂.obj Aℤ))),
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
      let ρℤ : Quiver.Hom (C₂.obj Aℤ) (P_push.obj (C₁.obj Aℤ)) :=
        (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))).symm
          (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
            ((C₁.obj Aℤ).obj.map (Opposite.op τ)))
      let πℤ : Quiver.Hom (P_pull.obj (C₂.obj Aℤ)) (C₁.obj Aℤ) :=
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm ρℤ
      let εM : Quiver.Hom (P_pull.obj (P_push.obj (C₁.obj AM))) (C₁.obj AM) :=
        adj_pull.counit.app (C₁.obj AM)
      let leray : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) 2 →
          weilEtaleTorsionH X₁ n 2 :=
        fun α => (CategoryTheory.Abelian.Ext.mk₀ εM).postcomp (C₁.obj Aℤ) (Nat.add_zero 2)
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_pull
              hAdd_pull hLim_pull hColim_pull _ _
              (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) 2) α)
            (Nat.zero_add 2))
      CategoryTheory.CategoryStruct.comp ιℤ πℤ =
        CategoryTheory.CategoryStruct.id (C₁.obj Aℤ) →
      ∀ (G₁ H₁ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u})
        (G₂ H₂ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u})
        (ι_k₁ : Quiver.Hom (C₁.obj AM) G₁)
        (p_k₁ : Quiver.Hom G₁ H₁)
        (h0₁ : CategoryTheory.CategoryStruct.comp ι_k₁ p_k₁ = 0)
        (hSE₁ : (CategoryTheory.ShortComplex.mk ι_k₁ p_k₁ h0₁).ShortExact)
        (ι_k₂ : Quiver.Hom (C₂.obj AM) G₂)
        (p_k₂ : Quiver.Hom G₂ H₂)
        (h0₂ : CategoryTheory.CategoryStruct.comp ι_k₂ p_k₂ = 0)
        (hSE₂ : (CategoryTheory.ShortComplex.mk ι_k₂ p_k₂ h0₂).ShortExact)
        (τM : Quiver.Hom (P_push.obj (C₁.obj AM)) (C₂.obj AM))
        (N_G : Quiver.Hom (P_push.obj G₁) G₂)
        (N_H : Quiver.Hom (P_push.obj H₁) H₂),
        CategoryTheory.CategoryStruct.comp (P_push.map ι_k₁) N_G =
          CategoryTheory.CategoryStruct.comp τM ι_k₂ →
        CategoryTheory.CategoryStruct.comp (P_push.map p_k₁) N_H =
          CategoryTheory.CategoryStruct.comp N_G p_k₂ →
        ∀ (ξ : CategoryTheory.Abelian.Ext (C₁.obj Aℤ) H₁ 1),
          let u : weilEtaleTorsionH X₁ n 2 :=
            ξ.comp hSE₁.extClass (Nat.one_add 1)
          let α : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) 2 :=
            (CategoryTheory.Abelian.Ext.mk₀ ρℤ).comp
              ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_push
                hAdd_push hLim_push hColim_push _ _
                (C₁.obj Aℤ) (C₁.obj AM) 2) u)
              (Nat.zero_add 2)
          leray α = u ∧
          (CategoryTheory.Abelian.Ext.mk₀ τM).postcomp (C₂.obj Aℤ) (Nat.add_zero 2) α =
            (CategoryTheory.Abelian.Ext.comp
              (CategoryTheory.Abelian.Ext.comp
                (CategoryTheory.Abelian.Ext.mk₀ ρℤ)
                ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_push
                  hAdd_push hLim_push hColim_push _ _
                  (C₁.obj Aℤ) H₁ 1) ξ)
                (Nat.zero_add 1))
              (CategoryTheory.Abelian.Ext.mk₀ N_H)
              (Nat.add_zero 1)).comp hSE₂.extClass (Nat.one_add 1) :=
by
  intro B J₁ J₂ P_push Aℤ AM C₁ C₂
    P_pull adj_pull hAdd_pull hLim_pull hColim_pull hAdd_push hLim_push hColim_push
    T₁ hT₁ T₂ hT₂ ιℤ
    adj₁ adj₂ τ ρℤ πℤ εM leray
    hιπ
    G₁ H₁ G₂ H₂ ι_k₁ p_k₁ h0₁ hSE₁ ι_k₂ p_k₂ h0₂ hSE₂ τM N_G N_H
    hSq₁ hSq₂
    ξ u α
  have : P_pull.Additive := hAdd_pull
  have : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim_pull
  have : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim_pull
  have : P_push.Additive := hAdd_push
  have : CategoryTheory.Limits.PreservesFiniteLimits P_push := hLim_push
  have : CategoryTheory.Limits.PreservesFiniteColimits P_push := hColim_push
  let 𝒮₁ := CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}
  have hNatComm :
      ∀ {F₀ F₁ : CategoryTheory.Functor 𝒮₁ 𝒮₁}
        [F₀.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₀]
        [CategoryTheory.Limits.PreservesFiniteColimits F₀]
        [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
        [CategoryTheory.Limits.PreservesFiniteColimits F₁]
        (θ : F₀ ⟶ F₁) (r : ℕ) (X Y : 𝒮₁) (x : CategoryTheory.Abelian.Ext X Y r),
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₀ x).comp
            (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero r) =
          (CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ x) (Nat.zero_add r) := by
    intro F₀ F₁ _ _ _ _ _ _ θ r
    induction r with
    | zero =>
      intro X Y x
      obtain ⟨g, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X Y).2 x
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        θ.naturality g]
    | succ r ih =>
      intro X Y x
      let ι_Y : Y ⟶ CategoryTheory.Injective.under Y := CategoryTheory.Injective.ι Y
      let Q : 𝒮₁ := CategoryTheory.Limits.cokernel ι_Y
      let π_Y : CategoryTheory.Injective.under Y ⟶ Q := CategoryTheory.Limits.cokernel.π ι_Y
      let S_Y : CategoryTheory.ShortComplex 𝒮₁ :=
        CategoryTheory.ShortComplex.mk ι_Y π_Y (CategoryTheory.Limits.cokernel.condition ι_Y)
      have hS_Y : S_Y.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι_Y) inferInstance inferInstance
      have hx0 : x.comp (CategoryTheory.Abelian.Ext.mk₀ S_Y.f) (Nat.add_zero (r + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS_Y x hx0 rfl
      let hS₀ : (S_Y.map F₀).ShortExact := hS_Y.map_of_exact F₀
      let hS₁ : (S_Y.map F₁).ShortExact := hS_Y.map_of_exact F₁
      have hExtNat :
          hS₀.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero 1) =
            (CategoryTheory.Abelian.Ext.mk₀ (θ.app Q)).comp hS₁.extClass (Nat.zero_add 1) := by
        simpa only [CategoryTheory.ShortComplex.mapNatTrans_τ₁,
          CategoryTheory.ShortComplex.mapNatTrans_τ₃] using
          CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₀ hS₁ (S_Y.mapNatTrans θ)
      calc
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₀ (y.comp hS_Y.extClass rfl)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero (r + 1))
          = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₀ y).comp
              hS₀.extClass rfl).comp
              (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero (r + 1)) := by
            rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₀ y).comp
              (hS₀.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero 1))
              rfl :=
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ rfl (Nat.add_zero 1) (Nat.add_zero (r + 1))
        _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₀ y).comp
              ((CategoryTheory.Abelian.Ext.mk₀ (θ.app Q)).comp hS₁.extClass (Nat.zero_add 1))
              rfl := by
            rw [hExtNat]
        _ = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₀ y).comp
              (CategoryTheory.Abelian.Ext.mk₀ (θ.app Q)) (Nat.add_zero r)).comp
              hS₁.extClass rfl :=
            (CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero r) (Nat.zero_add 1)
              (by omega)).symm
        _ = ((CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ y) (Nat.zero_add r)).comp
              hS₁.extClass rfl := by
            rw [ih X Q y]
        _ = (CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp
              ((CategoryTheory.Abelian.Ext.mapExactFunctor F₁ y).comp hS₁.extClass rfl)
              (Nat.zero_add (r + 1)) :=
            CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add r) rfl (by omega)
        _ = (CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ (y.comp hS_Y.extClass rfl))
              (Nat.zero_add (r + 1)) := by
            rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
  refine ⟨?_, ?_⟩
  · let u₀ : CategoryTheory.Abelian.Ext (C₁.obj Aℤ) (C₁.obj AM) 2 :=
      ξ.comp hSE₁.extClass (Nat.one_add 1)
    let m₁₂ : Quiver.Hom (C₁.obj Aℤ) (P_pull.obj (P_push.obj (C₁.obj Aℤ))) :=
      CategoryTheory.CategoryStruct.comp ιℤ (P_pull.map ρℤ)
    let cℤ : Quiver.Hom (P_pull.obj (P_push.obj (C₁.obj Aℤ))) (C₁.obj Aℤ) :=
      adj_pull.counit.app (C₁.obj Aℤ)
    let u_pp : CategoryTheory.Abelian.Ext
        (P_pull.obj (P_push.obj (C₁.obj Aℤ))) (P_pull.obj (P_push.obj (C₁.obj AM))) 2 :=
      CategoryTheory.Abelian.Ext.mapExactFunctor (P_push.comp P_pull) u₀
    have hPullAlpha :
        (P_pull.mapExtAddHom (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) 2) α =
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map ρℤ)).comp u_pp (Nat.zero_add 2) := by
      change (P_pull.mapExtAddHom (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) 2)
          ((CategoryTheory.Abelian.Ext.mk₀ ρℤ).comp
            ((P_push.mapExtAddHom (C₁.obj Aℤ) (C₁.obj AM) 2) u₀) (Nat.zero_add 2)) =
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map ρℤ)).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor (P_push.comp P_pull) u₀) (Nat.zero_add 2)
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_mapExactFunctor]
    have hLeftCollapse :
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
            ((CategoryTheory.Abelian.Ext.mk₀ (P_pull.map ρℤ)).comp u_pp (Nat.zero_add 2))
            (Nat.zero_add 2) =
          (CategoryTheory.Abelian.Ext.mk₀ m₁₂).comp u_pp (Nat.zero_add 2) :=
      (CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ)
        (CategoryTheory.Abelian.Ext.mk₀ (P_pull.map ρℤ))
        u_pp (Nat.zero_add 0) (Nat.zero_add 2) (Nat.zero_add 2)).symm.trans
        (congrArg (fun z => z.comp u_pp (Nat.zero_add 2))
          (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ ιℤ (P_pull.map ρℤ)))
    have hMate :
