      exact ⟨h0_l, CategoryTheory.ShortComplex.ShortExact.mk'
        ((CategoryTheory.ShortComplex.exact_iff_of_iso e_l).mp hSE_Sh.exact)
        hMono_l hEpi_l⟩

theorem weil_etale_slice_restriction_higherDirectImage_iso {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) (V : S.Etale) :
    let S' : AlgebraicGeometry.Scheme.{u} :=
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj V).left
    let p : Quiver.Hom S' S :=
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj V).hom
    let V_top : X.Etale := (weilEtaleSitePullback f).obj V
    let X' : AlgebraicGeometry.Scheme.{u} :=
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_top).left
    let q_X : Quiver.Hom X' X :=
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_top).hom
    let f' : Quiver.Hom X' S' := CategoryTheory.Limits.pullback.fst p f
    let M_p : CategoryTheory.Functor S'.Etale S.Etale := weilEtalePostcomp p V.prop
    let M_q : CategoryTheory.Functor X'.Etale X.Etale := weilEtalePostcomp q_X V_top.prop
    ∃ (hc_p : M_p.IsContinuous S'.smallEtaleTopology S.smallEtaleTopology)
      (hc_q : M_q.IsContinuous X'.smallEtaleTopology X.smallEtaleTopology),
      letI := hc_p
      letI := hc_q
      let res_p := M_p.sheafPushforwardContinuous AddCommGrpCat.{u}
        S'.smallEtaleTopology S.smallEtaleTopology
      let res_q := M_q.sheafPushforwardContinuous AddCommGrpCat.{u}
        X'.smallEtaleTopology X.smallEtaleTopology
      ∃ (eSheafify_p : ∀ P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u},
          CategoryTheory.Iso
            ((CategoryTheory.presheafToSheaf S'.smallEtaleTopology AddCommGrpCat.{u}).obj
              (CategoryTheory.Functor.comp M_p.op P))
            (res_p.obj
              ((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj P)))
        (eSheafify_q : ∀ P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u},
          CategoryTheory.Iso
            ((CategoryTheory.presheafToSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).obj
              (CategoryTheory.Functor.comp M_q.op P))
            (res_q.obj
              ((CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj P)))
        (sliceRIso : ∀ (q : ℕ)
            (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Iso
            (weilEtaleHigherDirectImage f' q (res_q.obj F))
            (res_p.obj (weilEtaleHigherDirectImage f q F))),
        (∀ {P₁ P₂ : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}}
            (α : Quiver.Hom P₁ P₂),
          CategoryTheory.CategoryStruct.comp
              ((CategoryTheory.presheafToSheaf S'.smallEtaleTopology AddCommGrpCat.{u}).map
                (CategoryTheory.Functor.whiskerLeft M_p.op α))
              (eSheafify_p P₂).hom =
            CategoryTheory.CategoryStruct.comp
              (eSheafify_p P₁).hom
              (res_p.map
                ((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map α))) ∧
        (∀ {P₁ P₂ : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}}
            (α : Quiver.Hom P₁ P₂),
          CategoryTheory.CategoryStruct.comp
              ((CategoryTheory.presheafToSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).map
                (CategoryTheory.Functor.whiskerLeft M_q.op α))
              (eSheafify_q P₂).hom =
            CategoryTheory.CategoryStruct.comp
              (eSheafify_q P₁).hom
              (res_q.map
                ((CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).map α))) ∧
        (∀ (P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u}) (W₁ : S'.Etale),
          CategoryTheory.CategoryStruct.comp
              (((CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology
                AddCommGrpCat.{u}).unit.app
                (CategoryTheory.Functor.comp M_p.op P)).app (Opposite.op W₁))
              ((eSheafify_p P).hom.hom.app (Opposite.op W₁)) =
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app P).app (Opposite.op (M_p.obj W₁)))) ∧
        (∀ (P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}) (W₂ : X'.Etale),
          CategoryTheory.CategoryStruct.comp
              (((CategoryTheory.sheafificationAdjunction X'.smallEtaleTopology
                AddCommGrpCat.{u}).unit.app
                (CategoryTheory.Functor.comp M_q.op P)).app (Opposite.op W₂))
              ((eSheafify_q P).hom.hom.app (Opposite.op W₂)) =
            (((CategoryTheory.sheafificationAdjunction X.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app P).app (Opposite.op (M_q.obj W₂)))) ∧
        (∀ (q : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
            (φ : Quiver.Hom F₁ F₂),
          CategoryTheory.CategoryStruct.comp
              (weilPolyP1HigherDirectImageMap f' q (res_q.map φ))
              (sliceRIso q F₂).hom =
            CategoryTheory.CategoryStruct.comp
              (sliceRIso q F₁).hom
              (res_p.map (weilPolyP1HigherDirectImageMap f q φ))) ∧
        (∀ (q : ℕ)
            (F₁ F₂ : CategoryTheory.Sheaf X'.smallEtaleTopology AddCommGrpCat.{u})
            (G : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
            (ι : Quiver.Hom F₁ (res_q.obj G))
            (ρ : Quiver.Hom (res_q.obj G) F₂)
            (Z₁ Z₂ : S'.Etale)
            (e_Z : CategoryTheory.Iso (M_p.obj Z₁) (M_p.obj Z₂)),
          (∀ {T : AlgebraicGeometry.Scheme.{u}} (t : Quiver.Hom T Z₁.left),
            Nonempty ↥T →
            CategoryTheory.CategoryStruct.comp t Z₁.hom ≠
              CategoryTheory.CategoryStruct.comp t
                (CategoryTheory.CategoryStruct.comp e_Z.hom.left Z₂.hom)) →
          (∀ (E₁ E₂ : X'.Etale) (e_E : CategoryTheory.Iso (M_q.obj E₁) (M_q.obj E₂)),
            (∀ {T : AlgebraicGeometry.Scheme.{u}} (t : Quiver.Hom T E₁.left),
              Nonempty ↥T →
              CategoryTheory.CategoryStruct.comp t E₁.hom ≠
                CategoryTheory.CategoryStruct.comp t
                  (CategoryTheory.CategoryStruct.comp e_E.hom.left E₂.hom)) →
            CategoryTheory.CategoryStruct.comp (ι.hom.app (Opposite.op E₂))
              (CategoryTheory.CategoryStruct.comp (G.obj.map (Opposite.op e_E.hom))
                (ρ.hom.app (Opposite.op E₁))) = 0) →
          CategoryTheory.CategoryStruct.comp
              ((weilPolyP1HigherDirectImageMap f' q ι).hom.app (Opposite.op Z₂))
              (CategoryTheory.CategoryStruct.comp
                (((sliceRIso q G).hom).hom.app (Opposite.op Z₂))
                (CategoryTheory.CategoryStruct.comp
                  ((weilEtaleHigherDirectImage f q G).obj.map (Opposite.op e_Z.hom))
                  (CategoryTheory.CategoryStruct.comp
                    (((sliceRIso q G).inv).hom.app (Opposite.op Z₁))
                    ((weilPolyP1HigherDirectImageMap f' q ρ).hom.app (Opposite.op Z₁))))) = 0) :=
by
  classical
  have hc_B_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := by
    clear f V X S
    intro Z₁ Z₂ h
    let B_h := weilEtaleSitePullback h
    let PEt : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
    have hCompat_B : CategoryTheory.CompatiblePreserving Z₁.smallEtaleTopology B_h := by
      refine CategoryTheory.CompatiblePreserving.mk ?_
      intro ℱ Z T x hx W₁ W₂ X₀ f₁ f₂ g₁ g₂ hg₁ hg₂ hfg
      have hEt_g₁ : AlgebraicGeometry.Etale g₁.left :=
        CategoryTheory.MorphismProperty.of_postcomp PEt
          g₁.left Z.hom Z.prop (by rw [CategoryTheory.MorphismProperty.Over.w g₁]; exact W₁.prop)
      have hEt_g₂ : AlgebraicGeometry.Etale g₂.left :=
        CategoryTheory.MorphismProperty.of_postcomp PEt
          g₂.left Z.hom Z.prop (by rw [CategoryTheory.MorphismProperty.Over.w g₂]; exact W₂.prop)
      have : AlgebraicGeometry.Etale W₁.hom := W₁.prop
      have hEt_P : AlgebraicGeometry.Etale
          (CategoryTheory.Limits.pullback.fst g₁.left g₂.left ≫ W₁.hom) := inferInstance
      let P_et : Z₂.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.Limits.pullback.fst g₁.left g₂.left ≫ W₁.hom) hEt_P
      let p₁ : P_et ⟶ W₁ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.fst g₁.left g₂.left) rfl trivial
      let p₂ : P_et ⟶ W₂ :=
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.snd g₁.left g₂.left)
          (by
            change CategoryTheory.Limits.pullback.snd g₁.left g₂.left ≫ W₂.hom =
              CategoryTheory.Limits.pullback.fst g₁.left g₂.left ≫ W₁.hom
            rw [← CategoryTheory.MorphismProperty.Over.w g₁,
              ← CategoryTheory.MorphismProperty.Over.w g₂,
              ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition])
          trivial
      have hp_eq : p₁ ≫ g₁ = p₂ ≫ g₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
      have hfg_left : f₁.left ≫ (B_h.map g₁).left = f₂.left ≫ (B_h.map g₂).left :=
        congrArg (fun (k : X₀ ⟶ B_h.obj Z) => k.left) hfg
      have hbg₁_fst : (B_h.map g₁).left ≫ CategoryTheory.Limits.pullback.fst Z.hom h =
          CategoryTheory.Limits.pullback.fst W₁.hom h ≫ g₁.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hbg₂_fst : (B_h.map g₂).left ≫ CategoryTheory.Limits.pullback.fst Z.hom h =
          CategoryTheory.Limits.pullback.fst W₂.hom h ≫ g₂.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hl_comm : (f₁.left ≫ CategoryTheory.Limits.pullback.fst W₁.hom h) ≫ g₁.left =
          (f₂.left ≫ CategoryTheory.Limits.pullback.fst W₂.hom h) ≫ g₂.left :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (f₁.left ≫ ·) hbg₁_fst.symm).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z.hom h) hfg_left).trans
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (f₂.left ≫ ·) hbg₂_fst).trans
                    (CategoryTheory.Category.assoc _ _ _).symm)))))
      let l_base : X₀.left ⟶ CategoryTheory.Limits.pullback g₁.left g₂.left :=
        CategoryTheory.Limits.pullback.lift
          (f₁.left ≫ CategoryTheory.Limits.pullback.fst W₁.hom h)
          (f₂.left ≫ CategoryTheory.Limits.pullback.fst W₂.hom h)
