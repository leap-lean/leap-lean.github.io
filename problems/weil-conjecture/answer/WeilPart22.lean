        ((C₁.obj A).obj.map (Opposite.op (B.map (hT₂'.from U)))) =
        θ₁.app (Opposite.op (B.obj U)) :=
      (CategoryTheory.Category.assoc (θ₁.app (Opposite.op T₁'))
        ((C₁.obj A).obj.map (Opposite.op (hT₁'.from (B.obj T₂'))))
        ((C₁.obj A).obj.map (Opposite.op (B.map (hT₂'.from U))))).trans
