          map_smul' := fun r m => by
            have h_map_smul : e_map (r • m) = V_x.topIso.hom.hom r • e_map m := by
              ext i
              change V_x.topIso.hom.hom (r * m i) = V_x.topIso.hom.hom r * V_x.topIso.hom.hom (m i)
