                Nonempty ↥T → t ≫ (w_star ≫ β₁).left ≠ t ≫ (w_star ≫ β₂).left) := by
          let Z_s : AlgebraicGeometry.Scheme.{u} := Z.left
          let z_hom : Z_s ⟶ S₀ := Z.hom
          let b_l : (Z ⟶ V) → (Z_s ⟶ S') := fun β => β.left
          have hb_w : ∀ β : Z ⟶ V, b_l β ≫ p = z_hom :=
            fun β => CategoryTheory.MorphismProperty.Over.w β
          let Δ_p : S' ⟶ CategoryTheory.Limits.pullback p p :=
            CategoryTheory.Limits.pullback.diagonal p
          have : AlgebraicGeometry.IsOpenImmersion Δ_p := inferInstance
          have : AlgebraicGeometry.IsClosedImmersion Δ_p := inferInstance
          let δ_pair : (Z ⟶ V) → (Z ⟶ V) → (Z_s ⟶ CategoryTheory.Limits.pullback p p) :=
            fun β₁ β₂ => CategoryTheory.Limits.pullback.lift (b_l β₁) (b_l β₂)
