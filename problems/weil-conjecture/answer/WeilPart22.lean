by
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Z₁ ⟶ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  
  have hMemSmallEtale : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale)
      (R : CategoryTheory.Sieve U),
      R ∈ Z.smallEtaleTopology U ↔
        ∀ x : ↥U.left, ∃ (V : Z.Etale) (k : V ⟶ U) (y : ↥V.left),
          R.arrows k ∧ AlgebraicGeometry.Etale k.left ∧ k.left.base y = x := by
    intro Z U R
    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEq : Z.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        Z (le_refl P)
    exact (Eq.to_iff (congrArg (fun J => R ∈ J U) hEq)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R)

  
  have hSmallModelCover : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale),
      let e_sm := CategoryTheory.equivSmallModel.{u} Z.AffineEtale
      let S_spec := AlgebraicGeometry.Scheme.AffineEtale.Spec Z
