      have hl_over : l_base ≫ P_et.hom = X₀.hom ≫ h :=
        (CategoryTheory.Category.assoc l_base
          (CategoryTheory.Limits.pullback.fst g₁.left g₂.left) W₁.hom).symm.trans
          ((congrArg (· ≫ W₁.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc f₁.left
              (CategoryTheory.Limits.pullback.fst W₁.hom h) W₁.hom).trans
              ((congrArg (f₁.left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
                ((CategoryTheory.Category.assoc f₁.left
                  (CategoryTheory.Limits.pullback.snd W₁.hom h) h).symm.trans
                  (congrArg (· ≫ h) (CategoryTheory.MorphismProperty.Over.w f₁))))))
      let l_sch : X₀.left ⟶ CategoryTheory.Limits.pullback P_et.hom h :=
        CategoryTheory.Limits.pullback.lift l_base X₀.hom hl_over
      let l_et : X₀ ⟶ B_h.obj P_et :=
        CategoryTheory.MorphismProperty.Over.homMk l_sch
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have hl₁ : l_et ≫ B_h.map p₁ = f₁ := by
        apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
        let bp₁ : CategoryTheory.Limits.pullback P_et.hom h ⟶
            CategoryTheory.Limits.pullback W₁.hom h := (B_h.map p₁).left
        have hbp₁_fst : bp₁ ≫ CategoryTheory.Limits.pullback.fst W₁.hom h =
            CategoryTheory.Limits.pullback.fst P_et.hom h ≫ p₁.left :=
          CategoryTheory.Limits.pullback.lift_fst _ _ _
        have hbp₁_snd : bp₁ ≫ CategoryTheory.Limits.pullback.snd W₁.hom h =
            CategoryTheory.Limits.pullback.snd P_et.hom h :=
          CategoryTheory.Limits.pullback.lift_snd _ _ _
        change l_sch ≫ bp₁ = f₁.left
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc l_sch bp₁ _).trans
            ((congrArg (l_sch ≫ ·) hbp₁_fst).trans
