    let g' : A ⟶ ((CategoryTheory.evaluation (X₂.Etale)ᵒᵖ AddCommGrpCat.{u}).obj
        (Opposite.op T₂')).obj (P_push.obj (C₁.obj A)).obj :=
      CategoryTheory.CategoryStruct.comp
