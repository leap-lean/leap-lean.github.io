          have hz₀_not_eq : z₀ ∉ Set.range (i_pair β₁ β₂).base := by
            intro hz₀_in
            have hU_eq : U_pm β₁ β₂ = (i_pair β₁ β₂).opensRange := by
              simp only [U_pm, hz₀_in, ↓reduceIte]
            have hRange_sub : Set.range U_star.ι.base ⊆ Set.range (i_pair β₁ β₂).base := by
              rw [AlgebraicGeometry.Scheme.Opens.range_ι]
              intro x hx
              have hx' : x ∈ U_pm β₁ β₂ := h_le_pair hx
