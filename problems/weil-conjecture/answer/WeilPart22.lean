      (CategoryTheory.Functor.whiskerLeft_comp B_f'.op φ_X' (eCohom q F₂).hom).symm.trans
        ((congrArg (CategoryTheory.Functor.whiskerLeft B_f'.op) (heCohom_nat q φ)).trans
          (CategoryTheory.Functor.whiskerLeft_comp B_f'.op (eCohom q F₁).hom
            (CategoryTheory.Functor.whiskerLeft M_q.op φ_X)))
    have sq2 : w_mid ≫ t₂ = t₁ ≫ w₂ :=
      CategoryTheory.NatTrans.ext (funext fun opZ =>
        (φ_X.naturality (Opposite.op (θ_pb.app (Opposite.unop opZ)).inv)).symm)
    have hePre_nat : w₁ ≫ (ePre q F₂).hom = (ePre q F₁).hom ≫ w₂ :=
      (CategoryTheory.Category.assoc w₁ c₂ t₂).symm.trans
        ((congrArg (· ≫ t₂) sq1).trans
          ((CategoryTheory.Category.assoc c₁ w_mid t₂).trans
            ((congrArg (c₁ ≫ ·) sq2).trans
              (CategoryTheory.Category.assoc c₁ t₁ w₂).symm)))
    have hMapPre : sh_S'.map w₁ ≫ sh_S'.map (ePre q F₂).hom =
        sh_S'.map (ePre q F₁).hom ≫ sh_S'.map w₂ :=
      (sh_S'.map_comp w₁ (ePre q F₂).hom).symm.trans
        ((congrArg sh_S'.map hePre_nat).trans (sh_S'.map_comp (ePre q F₁).hom w₂))
    have hShNat := heSheafify_p_nat (CategoryTheory.Functor.whiskerLeft B_f.op φ_X)
    let m₁ := weilPolyP1HigherDirectImageMap f' q (res_q.map φ)
    let p₁ := sh_S'.map (ePre q F₁).hom
    let p₂ := sh_S'.map (ePre q F₂).hom
    let s₁ := (eSheafify_p (B_f.op ⋙ F₁.cohomologyPresheaf q)).hom
    let s₂ := (eSheafify_p (B_f.op ⋙ F₂.cohomologyPresheaf q)).hom
    let m₂ := res_p.map (weilPolyP1HigherDirectImageMap f q φ)
    exact (CategoryTheory.Category.assoc m₁ p₂ s₂).symm.trans
      ((congrArg (· ≫ s₂) hMapPre).trans
        ((CategoryTheory.Category.assoc p₁ (sh_S'.map w₂) s₂).trans
          ((congrArg (p₁ ≫ ·) hShNat).trans
            (CategoryTheory.Category.assoc p₁ s₁ m₂).symm)))

  · intro q F₁ F₂ G ι ρ Z₁ Z₂ e_Z hDisj_Z hAnn_E
    let P₁ := B_f'.op ⋙ F₁.cohomologyPresheaf q
    let P₂ := B_f'.op ⋙ F₂.cohomologyPresheaf q
    let P₀ := B_f.op ⋙ G.cohomologyPresheaf q
    let α_pre : P₁ ⟶ M_p.op ⋙ P₀ :=
      CategoryTheory.Functor.whiskerLeft B_f'.op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map ι) ≫
        (ePre q G).hom
    let β_pre : M_p.op ⋙ P₀ ⟶ P₂ :=
      (ePre q G).inv ≫
        CategoryTheory.Functor.whiskerLeft B_f'.op
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map ρ)
    have hS4 := h_s4 p V.prop P₁ P₂ P₀ α_pre β_pre (eSheafify_p P₀)
      (heSheafify_p_unit P₀) Z₁ Z₂ e_Z hDisj_Z
    have hRawAnn : ∀ (U'₁ U'₂ : S'.Etale) (e_U' : CategoryTheory.Iso (M_p.obj U'₁) (M_p.obj U'₂)),
        (∀ {T : AlgebraicGeometry.Scheme.{u}} (t : Quiver.Hom T U'₁.left),
          Nonempty ↥T →
          CategoryTheory.CategoryStruct.comp t U'₁.hom ≠
            CategoryTheory.CategoryStruct.comp t
              (CategoryTheory.CategoryStruct.comp e_U'.hom.left U'₂.hom)) →
        CategoryTheory.CategoryStruct.comp (α_pre.app (Opposite.op U'₂))
          (CategoryTheory.CategoryStruct.comp (P₀.map (Opposite.op e_U'.hom))
            (β_pre.app (Opposite.op U'₁))) = 0 := by
      intro U'₁ U'₂ e_U' hDisj_U'
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro y₂
      let Q₁ : X'.Etale := B_f'.obj U'₁
      let Q₂ : X'.Etale := B_f'.obj U'₂
      let Q₀ : X.Etale := B_f.obj (M_p.obj U'₁)
      let X₀ : AlgebraicGeometry.Scheme.{u} := Q₀.left
      let h₀ : X₀ ⟶ X := Q₀.hom
      let τ₁ : M_q.obj Q₁ ≅ Q₀ := θ_pb.app U'₁
      let τ₂ : M_q.obj Q₂ ≅ Q₀ := θ_pb.app U'₂ ≪≫ (B_f.mapIso e_U').symm
      let h₁ : X₀ ⟶ X' := τ₁.inv.left ≫ Q₁.hom
      let h₂ : X₀ ⟶ X' := τ₂.inv.left ≫ Q₂.hom
      have hh₁_eq : h₁ ≫ q_X = h₀ := CategoryTheory.MorphismProperty.Over.w τ₁.inv
      have hh₂_eq : h₂ ≫ q_X = h₀ := CategoryTheory.MorphismProperty.Over.w τ₂.inv
