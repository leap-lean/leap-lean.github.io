        intro y
        dsimp only [Θ]
        rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        exact (CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add r) rfl (by omega)).symm
      have hN2 : ∀ w : CategoryTheory.Abelian.Ext Z₁ I r,
          Θ Q r (w.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero r)) =
            (Θ I r w).comp (CategoryTheory.Abelian.Ext.mk₀ (P.map π)) (Nat.add_zero r) := by
        intro w
        dsimp only [Θ]
        rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
        exact (CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.zero_add r) (Nat.add_zero r) (by omega)).symm
      have hZero : ∀ z : CategoryTheory.Abelian.Ext Z₁ ℱ (r + 1),
          Θ ℱ (r + 1) z = 0 → z = 0 := by
        intro z hz0
        have hzI : z.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (r + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z₁ hS z hzI rfl
        have hy0 : (Θ Q r y).comp hS'.extClass rfl = 0 := by
          rw [← hN1 y, hy, hz0]
        obtain ⟨w', hw'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Z₂ hS'
          (Θ Q r y) rfl hy0
        obtain ⟨w, hw⟩ := (ih I).2 w'
        have hΘ_eq : Θ Q r (w.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero r)) =
            Θ Q r y := by
          rw [hN2 w, hw]
          exact hw'
        have hy_eq : y = w.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero r) :=
          (ih Q).1 hΘ_eq.symm
        rw [← hy, hy_eq]
        have h_assoc := CategoryTheory.Abelian.Ext.comp_assoc w
          (CategoryTheory.Abelian.Ext.mk₀ S.g) hS.extClass
          (Nat.add_zero r) (Nat.zero_add 1) (by omega : r + 0 + 1 = r + 1)
        have h_comp0 : (CategoryTheory.Abelian.Ext.mk₀ S.g).comp hS.extClass (Nat.zero_add 1) = 0 :=
          hS.comp_extClass
        have hw0 : w.comp (0 : CategoryTheory.Abelian.Ext I ℱ 1) rfl = 0 := by
          have hadd := CategoryTheory.Abelian.Ext.comp_add w
            (0 : CategoryTheory.Abelian.Ext I ℱ 1) 0 rfl
          rw [add_zero] at hadd
          exact add_left_cancel (hadd.symm.trans (add_zero _).symm)
        exact h_assoc.trans ((congrArg (fun t => w.comp t rfl) h_comp0).trans hw0)
      refine ⟨?_, ?_⟩
      · intro z₁ z₂ hz
        have hdiff : Θ ℱ (r + 1) (z₁ - z₂) = 0 := by
          dsimp only [Θ] at hz ⊢
          rw [map_sub]
          have hadd := CategoryTheory.Abelian.Ext.comp_add (CategoryTheory.Abelian.Ext.mk₀ ρ)
            ((P.mapExtAddHom Z₁ ℱ (r + 1)) z₁ - (P.mapExtAddHom Z₁ ℱ (r + 1)) z₂)
            ((P.mapExtAddHom Z₁ ℱ (r + 1)) z₂) (Nat.zero_add (r + 1))
          rw [sub_add_cancel, hz] at hadd
          exact add_right_cancel (hadd.symm.trans (zero_add _).symm)
        exact sub_eq_zero.mp (hZero (z₁ - z₂) hdiff)
      · intro z'
        have hz'I : z'.comp (CategoryTheory.Abelian.Ext.mk₀ (S.map P).f) (Nat.add_zero (r + 1)) = 0 :=
          CategoryTheory.Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y', hy'⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z₂ hS' z' hz'I rfl
        obtain ⟨y, hy⟩ := (ih Q).2 y'
        refine ⟨y.comp hS.extClass rfl, ?_⟩
        rw [hN1 y, hy, hy']

  
