      CF_b ⋙ (W_B ⋙ Sh_S)
    let Z_fun := CategoryTheory.yoneda ⋙
      (CategoryTheory.Functor.whiskeringRight (P.left.Etale)ᵒᵖ (Type u)
        AddCommGrpCat.{u}).obj AddCommGrpCat.free ⋙
      CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
    let Z_obj : (P.left.Etale)ᵒᵖ → CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
      fun W => (Z_fun.op.obj W).unop
    have hAdd_CF : CF_b.Additive :=
      { map_add := fun {F₁ F₂} {u₁ u₂} => by
          ext W x
          let x' : CategoryTheory.Abelian.Ext (Z_obj W) F₁ b := x
          have hm1 : (CF_b.map (u₁ + u₂)).app W =
              (CategoryTheory.Abelian.extFunctorObj (Z_obj W) b).map (u₁ + u₂) := rfl
          have hm2 : (CF_b.map u₁).app W =
              (CategoryTheory.Abelian.extFunctorObj (Z_obj W) b).map u₁ := rfl
          have hm3 : (CF_b.map u₂).app W =
              (CategoryTheory.Abelian.extFunctorObj (Z_obj W) b).map u₂ := rfl
