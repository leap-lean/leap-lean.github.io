        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc l_sch bp₂ _).trans
            ((congrArg (l_sch ≫ ·) hbp₂_fst).trans
              ((CategoryTheory.Category.assoc l_sch _ p₂.left).symm.trans
                ((congrArg (· ≫ p₂.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  (CategoryTheory.Limits.pullback.lift_snd _ _ _))))
        · exact (CategoryTheory.Category.assoc l_sch bp₂ _).trans
            ((congrArg (l_sch ≫ ·) hbp₂_snd).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                (CategoryTheory.MorphismProperty.Over.w f₂).symm))
      have hCompat_P :
          (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (B_h.map p₁).op)) (x g₁ hg₁) =
          (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map (B_h.map p₂).op)) (x g₂ hg₂) :=
        hx p₁ p₂ hg₁ hg₂ hp_eq
      have hMap₁ := congrArg (CategoryTheory.ConcreteCategory.hom (ℱ.obj.map l_et.op)) hCompat_P
      have hm1 : ℱ.obj.map f₁.op = ℱ.obj.map (B_h.map p₁).op ≫ ℱ.obj.map l_et.op :=
        (congrArg (fun k => ℱ.obj.map k.op) hl₁.symm).trans
          (ℱ.obj.map_comp (B_h.map p₁).op l_et.op)
      have hm2 : ℱ.obj.map f₂.op = ℱ.obj.map (B_h.map p₂).op ≫ ℱ.obj.map l_et.op :=
        (congrArg (fun k => ℱ.obj.map k.op) hl₂.symm).trans
          (ℱ.obj.map_comp (B_h.map p₂).op l_et.op)
      exact (congrArg
        (fun (m : ℱ.obj.obj (Opposite.op (B_h.obj W₁)) ⟶ ℱ.obj.obj (Opposite.op X₀)) =>
          CategoryTheory.ConcreteCategory.hom m (x g₁ hg₁)) hm1).trans
        (hMap₁.trans (congrArg
          (fun (m : ℱ.obj.obj (Opposite.op (B_h.obj W₂)) ⟶ ℱ.obj.obj (Opposite.op X₀)) =>
            CategoryTheory.ConcreteCategory.hom m (x g₂ hg₂)) hm2).symm)
    have hCover_B : CategoryTheory.CoverPreserving
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology B_h := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro U S hS
      have hTop₂ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
