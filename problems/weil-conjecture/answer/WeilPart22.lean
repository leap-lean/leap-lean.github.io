                  (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂)) ≫
                (weilEtaleLocalTorsionSheaf S₀ m₀ V₂).obj.map (Opposite.op u₁) :=
              Equiv.apply_symm_apply _ _
            rw [h1]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap S₀ m₀ u₁ ≫
              weilEtaleLocalTorsionMap S₀ m₀ u₂) :=
            (hFreeEquiv_comp (weilEtaleLocalTorsionMap S₀ m₀ u₁)
              (weilEtaleLocalTorsionMap S₀ m₀ u₂)).symm

  have hLocCounit_comp :
      ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (m₀ : ℕ)
        {V₁ V₂ : S₀.Etale} (u : V₁ ⟶ V₂),
        weilEtaleLocalTorsionMap S₀ m₀ u ≫ weilEtaleLocalTorsionCounit S₀ m₀ V₂ =
          weilEtaleLocalTorsionCounit S₀ m₀ V₁ := by
    intro S₀ m₀ V₁ V₂ u
    let J₀ := S₀.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let P_const := (CategoryTheory.Functor.const (Opposite S₀.Etale)).obj AM
    let η_const := (CategoryTheory.sheafificationAdjunction J₀ AddCommGrpCat.{u}).unit.app P_const
    have hη_nat : η_const.app (Opposite.op V₂) ≫
        (weilEtaleTorsionSheaf S₀ m₀).obj.map (Opposite.op u) =
        η_const.app (Opposite.op V₁) :=
      (η_const.naturality (Opposite.op u)).symm.trans (CategoryTheory.Category.id_comp _)
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hs1 :
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          (weilEtaleLocalTorsionMap S₀ m₀ u ≫ weilEtaleLocalTorsionCounit S₀ m₀ V₂) =
        η_const.app (Opposite.op V₂) ≫
          (weilEtaleTorsionSheaf S₀ m₀).obj.map (Opposite.op u) := by
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap S₀ m₀ u ≫ weilEtaleLocalTorsionCounit S₀ m₀ V₂)
          = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S₀ m₀ u) ≫
              (weilEtaleLocalTorsionCounit S₀ m₀ V₂).hom.app (Opposite.op V₁) :=
              hFreeEquiv_comp _ _
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
              (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂)) ≫
              (weilEtaleLocalTorsionSheaf S₀ m₀ V₂).obj.map (Opposite.op u)) ≫
              (weilEtaleLocalTorsionCounit S₀ m₀ V₂).hom.app (Opposite.op V₁) := by
              have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S₀ m₀ u) =
                  CategoryTheory.Sheaf.freeYonedaHomEquiv
                    (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂)) ≫
                  (weilEtaleLocalTorsionSheaf S₀ m₀ V₂).obj.map (Opposite.op u) :=
                Equiv.apply_symm_apply _ _
              rw [h1]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
              (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂)) ≫
              ((weilEtaleLocalTorsionSheaf S₀ m₀ V₂).obj.map (Opposite.op u) ≫
                (weilEtaleLocalTorsionCounit S₀ m₀ V₂).hom.app (Opposite.op V₁)) :=
              CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
              (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂)) ≫
              ((weilEtaleLocalTorsionCounit S₀ m₀ V₂).hom.app (Opposite.op V₂) ≫
                (weilEtaleTorsionSheaf S₀ m₀).obj.map (Opposite.op u)) := by
              rw [← (weilEtaleLocalTorsionCounit S₀ m₀ V₂).hom.naturality (Opposite.op u)]
        _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
              (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂)) ≫
              (weilEtaleLocalTorsionCounit S₀ m₀ V₂).hom.app (Opposite.op V₂)) ≫
              (weilEtaleTorsionSheaf S₀ m₀).obj.map (Opposite.op u) := by
              rw [CategoryTheory.Category.assoc]
        _ = η_const.app (Opposite.op V₂) ≫
              (weilEtaleTorsionSheaf S₀ m₀).obj.map (Opposite.op u) := by
              have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂)) ≫
                  (weilEtaleLocalTorsionCounit S₀ m₀ V₂).hom.app (Opposite.op V₂) =
                  η_const.app (Opposite.op V₂) := by
                rw [← hFreeEquiv_comp (𝟙 (weilEtaleLocalTorsionSheaf S₀ m₀ V₂))
                  (weilEtaleLocalTorsionCounit S₀ m₀ V₂), CategoryTheory.Category.id_comp]
                exact Equiv.apply_symm_apply _ _
              exact congrArg (· ≫ (weilEtaleTorsionSheaf S₀ m₀).obj.map (Opposite.op u)) h2
    exact hs1.trans (hη_nat.trans (Equiv.apply_symm_apply _ _).symm)

  have hLocMapH_id :
      ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (m₀ : ℕ) (U : S₀.Etale) (q : ℕ)
        (z : weilEtaleLocalTorsionH S₀ m₀ U q),
        weilEtaleLocalTorsionMapH S₀ m₀ (𝟙 U) q z = z := by
    intro S₀ m₀ U q z
    change z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S₀ m₀ (𝟙 U)))
      (Nat.add_zero q) = z
    rw [hLocMap_id S₀ m₀ U]
    exact CategoryTheory.Abelian.Ext.comp_mk₀_id z

  have hLocMapH_comp :
      ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (m₀ : ℕ)
        {V₁ V₂ V₃ : S₀.Etale} (u₁ : V₁ ⟶ V₂) (u₂ : V₂ ⟶ V₃) (q : ℕ)
        (z : weilEtaleLocalTorsionH S₀ m₀ V₁ q),
        weilEtaleLocalTorsionMapH S₀ m₀ (u₁ ≫ u₂) q z =
          weilEtaleLocalTorsionMapH S₀ m₀ u₂ q (weilEtaleLocalTorsionMapH S₀ m₀ u₁ q z) := by
    intro S₀ m₀ V₁ V₂ V₃ u₁ u₂ q z
    change z.comp (CategoryTheory.Abelian.Ext.mk₀
        (weilEtaleLocalTorsionMap S₀ m₀ (u₁ ≫ u₂))) (Nat.add_zero q) =
      (z.comp (CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleLocalTorsionMap S₀ m₀ u₁)) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleLocalTorsionMap S₀ m₀ u₂)) (Nat.add_zero q)
    rw [hLocMap_comp S₀ m₀ u₁ u₂, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc]
    omega

  have hLocCounitH_comp :
      ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (m₀ : ℕ)
        {V₁ V₂ : S₀.Etale} (u : V₁ ⟶ V₂) (q : ℕ)
        (z : weilEtaleLocalTorsionH S₀ m₀ V₁ q),
        weilEtaleLocalTorsionCounitH S₀ m₀ V₁ q z =
          weilEtaleLocalTorsionCounitH S₀ m₀ V₂ q (weilEtaleLocalTorsionMapH S₀ m₀ u q z) := by
    intro S₀ m₀ V₁ V₂ u q z
    change z.comp (CategoryTheory.Abelian.Ext.mk₀
        (weilEtaleLocalTorsionCounit S₀ m₀ V₁)) (Nat.add_zero q) =
      (z.comp (CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleLocalTorsionMap S₀ m₀ u)) (Nat.add_zero q)).comp
        (CategoryTheory.Abelian.Ext.mk₀
          (weilEtaleLocalTorsionCounit S₀ m₀ V₂)) (Nat.add_zero q)
    rw [← hLocCounit_comp S₀ m₀ u, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc]
    omega

  have hCounitH_univ_bij :
      ∀ (S₀ : AlgebraicGeometry.Scheme.{u}) (m₀ q : ℕ) (U : S₀.Etale),
        AlgebraicGeometry.IsOpenImmersion U.hom →
        Set.range U.hom.base = Set.univ →
        Function.Bijective (weilEtaleLocalTorsionCounitH S₀ m₀ U q) := by
    intro S₀ m₀ q U hOpen hUniv
    let J₀ := S₀.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m₀))
    let T := weilEtaleIdTerminal.{u} S₀
    let hT := weilEtaleIdTerminalIsTerminal.{u} S₀
    let adj_T := CategoryTheory.constantSheafAdj J₀ AddCommGrpCat.{u} hT
    let L_T := weilEtaleLocalTorsionSheaf S₀ m₀ T
    let FM := weilEtaleTorsionSheaf S₀ m₀
    have hUnit_T :
        adj_T.unit.app AM =
          ((CategoryTheory.sheafificationAdjunction J₀ AddCommGrpCat.{u}).unit.app
            ((CategoryTheory.Functor.const (Opposite S₀.Etale)).obj AM)).app (Opposite.op T) := by
      dsimp [adj_T, CategoryTheory.constantSheafAdj]
      rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.Category.id_comp]
      rfl
    let inv_T : FM ⟶ L_T :=
      (adj_T.homEquiv AM L_T).symm (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_T))
    have hCounit_inv : weilEtaleLocalTorsionCounit S₀ m₀ T ≫ inv_T = 𝟙 L_T := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have hc : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S₀ m₀ T) =
          adj_T.unit.app AM := (Equiv.apply_symm_apply _ _).trans hUnit_T.symm
      calc
        CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S₀ m₀ T ≫ inv_T)
          = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S₀ m₀ T) ≫
              inv_T.hom.app (Opposite.op T) := hFreeEquiv_comp _ _
        _ = adj_T.unit.app AM ≫ ((CategoryTheory.sheafSections J₀ AddCommGrpCat.{u}).obj
              (Opposite.op T)).map inv_T := by
              rw [hc]; rfl
        _ = adj_T.homEquiv AM L_T inv_T :=
              (CategoryTheory.Adjunction.homEquiv_unit adj_T AM L_T inv_T).symm
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_T) :=
              Equiv.apply_symm_apply _ _
    have hInv_counit : inv_T ≫ weilEtaleLocalTorsionCounit S₀ m₀ T = 𝟙 FM := by
      apply (adj_T.homEquiv AM FM).injective
      calc
        adj_T.homEquiv AM FM (inv_T ≫ weilEtaleLocalTorsionCounit S₀ m₀ T)
          = adj_T.homEquiv AM L_T inv_T ≫
              (weilEtaleLocalTorsionCounit S₀ m₀ T).hom.app (Opposite.op T) := by
              rw [CategoryTheory.Adjunction.homEquiv_naturality_right]; rfl
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_T) ≫
              (weilEtaleLocalTorsionCounit S₀ m₀ T).hom.app (Opposite.op T) := by
              rw [Equiv.apply_symm_apply]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S₀ m₀ T) := by
              rw [← hFreeEquiv_comp, CategoryTheory.Category.id_comp]
        _ = adj_T.unit.app AM := (Equiv.apply_symm_apply _ _).trans hUnit_T.symm
        _ = adj_T.unit.app AM ≫ 𝟙 _ := (CategoryTheory.Category.comp_id _).symm
        _ = adj_T.homEquiv AM FM (𝟙 FM) :=
              (CategoryTheory.Adjunction.homEquiv_unit adj_T AM FM (𝟙 FM)).symm
    have hBij_T : Function.Bijective (weilEtaleLocalTorsionCounitH S₀ m₀ T q) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun w => w.comp (CategoryTheory.Abelian.Ext.mk₀ inv_T) (Nat.add_zero q), ?_, ?_⟩
      · intro z
        change (z.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S₀ m₀ T))
            (Nat.add_zero q)).comp (CategoryTheory.Abelian.Ext.mk₀ inv_T) (Nat.add_zero q) = z
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
            (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hCounit_inv,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
      · intro w
        change (w.comp (CategoryTheory.Abelian.Ext.mk₀ inv_T) (Nat.add_zero q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S₀ m₀ T))
            (Nat.add_zero q) = w
        rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero q) (Nat.add_zero 0)
            (by omega),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hInv_counit,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    letI : AlgebraicGeometry.IsOpenImmersion U.hom := hOpen
    have hOpensTop : U.hom.opensRange = ⊤ := by
      ext x
      change x ∈ Set.range U.hom.base ↔ True
      rw [hUniv]
      simp
    have hIso : CategoryTheory.IsIso (U.hom : U.left ⟶ S₀) :=
      AlgebraicGeometry.isIso_of_isOpenImmersion_of_opensRange_eq_top U.hom hOpensTop
    obtain ⟨g_inv, hg₁, hg₂⟩ := hIso.out
    let u₁ : U ⟶ T :=
      CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom)
    let u₂ : T ⟶ U :=
      CategoryTheory.MorphismProperty.Over.homMk g_inv hg₂
    have hu₁₂ : u₁ ≫ u₂ = 𝟙 U := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hg₁
    have hu₂₁ : u₂ ≫ u₁ = 𝟙 T := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact hg₂
    have hBij_u₁ : Function.Bijective (weilEtaleLocalTorsionMapH S₀ m₀ u₁ q) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨weilEtaleLocalTorsionMapH S₀ m₀ u₂ q, ?_, ?_⟩
      · intro z
        rw [← hLocMapH_comp S₀ m₀ u₁ u₂ q z, hu₁₂, hLocMapH_id]
      · intro z
        rw [← hLocMapH_comp S₀ m₀ u₂ u₁ q z, hu₂₁, hLocMapH_id]
    have hEq_fun :
        (weilEtaleLocalTorsionCounitH S₀ m₀ U q : _ → _) =
          (weilEtaleLocalTorsionCounitH S₀ m₀ T q) ∘ (weilEtaleLocalTorsionMapH S₀ m₀ u₁ q) := by
      funext z
      exact hLocCounitH_comp S₀ m₀ u₁ q z
    rw [hEq_fun]
    exact hBij_T.comp hBij_u₁

  
  have hOpenCompl_excision :
      ∀ {Z S₀ : AlgebraicGeometry.Scheme.{u}} [S₀.IsSeparated]
        (i : Z ⟶ S₀) [AlgebraicGeometry.IsClosedImmersion i]
        (n q₀ : ℕ)
        (hVanishZ₀ : ∀ (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
          n • CategoryTheory.CategoryStruct.id 𝒢 = 0 → Subsingleton (𝒢.H q₀))
        (hVanishZ₁ : ∀ (𝒢 : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
          n • CategoryTheory.CategoryStruct.id 𝒢 = 0 → Subsingleton (𝒢.H (q₀ + 1)))
        (V O : S₀.Opens) (hO : (O : Set ↥S₀) = (Set.range i.base)ᶜ),
        let U_VO : S₀.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (V ⊓ O).ι inferInstance
        let U_V : S₀.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ V.ι inferInstance
        let u_inc : U_VO ⟶ U_V :=
          CategoryTheory.MorphismProperty.Over.homMk (S₀.homOfLE inf_le_left)
            (AlgebraicGeometry.Scheme.homOfLE_ι S₀ inf_le_left)
        Function.Bijective (weilEtaleLocalTorsionMapH S₀ n u_inc (q₀ + 1)) := by
    intro Z S₀ _ i _ n q₀ hVanishZ₀ hVanishZ₁ V O hO U_VO U_V u_inc
    let J₀ := S₀.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let P₁ := CategoryTheory.Presheaf.freeYoneda U_VO AM
    let P₂ := CategoryTheory.Presheaf.freeYoneda U_V AM
    let L₁ := weilEtaleLocalTorsionSheaf S₀ n U_VO
    let L₂ := weilEtaleLocalTorsionSheaf S₀ n U_V
    let ι : L₁ ⟶ L₂ := weilEtaleLocalTorsionMap S₀ n u_inc

    have hSub_open : ∀ (W_op : S₀.Opens) (Y : S₀.Etale),
        Subsingleton
          (Y ⟶ (CategoryTheory.MorphismProperty.Over.mk ⊤ W_op.ι inferInstance : S₀.Etale)) := by
      intro W_op Y
      refine ⟨fun f₁ f₂ => CategoryTheory.MorphismProperty.Over.Hom.ext ?_⟩
      have hw₁ : f₁.left ≫ W_op.ι = Y.hom := CategoryTheory.MorphismProperty.Over.w f₁
      have hw₂ : f₂.left ≫ W_op.ι = Y.hom := CategoryTheory.MorphismProperty.Over.w f₂
      exact (cancel_mono W_op.ι).mp (hw₁.trans hw₂.symm)
    have hSub_VO : ∀ Y : S₀.Etale, Subsingleton (Y ⟶ U_VO) := hSub_open (V ⊓ O)
    have hSub_V : ∀ Y : S₀.Etale, Subsingleton (Y ⟶ U_V) := hSub_open V

    let φ_pre : P₁ ⟶ P₂ :=
      { app := fun Y =>
          CategoryTheory.Limits.Sigma.desc (fun (f : Y.unop ⟶ U_VO) =>
            CategoryTheory.Limits.Sigma.ι (fun _ : Y.unop ⟶ U_V => AM) (f ≫ u_inc))
        naturality := fun {Y₁ Y₂} h => by
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro f
          dsimp [P₁, P₂, CategoryTheory.Presheaf.freeYoneda]
          simp only [CategoryTheory.Limits.Sigma.ι_comp_map'_assoc,
            CategoryTheory.Limits.colimit.ι_desc, CategoryTheory.Limits.Cofan.mk_pt,
            CategoryTheory.Limits.Cofan.mk_ι_app, CategoryTheory.Category.id_comp,
            CategoryTheory.Limits.colimit.ι_desc_assoc, CategoryTheory.Limits.Sigma.ι_comp_map',
            CategoryTheory.Category.assoc] }

    have hEquiv_φ_pre :
        CategoryTheory.Presheaf.freeYonedaHomEquiv φ_pre =
          CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₂) ≫ P₂.map (Opposite.op u_inc) := by
      change CategoryTheory.Limits.Sigma.ι (fun _ : U_VO ⟶ U_VO => AM) (𝟙 U_VO) ≫
          CategoryTheory.Limits.Sigma.desc (fun (f : U_VO ⟶ U_VO) =>
            CategoryTheory.Limits.Sigma.ι (fun _ : U_VO ⟶ U_V => AM) (f ≫ u_inc)) =
        (CategoryTheory.Limits.Sigma.ι (fun _ : U_V ⟶ U_V => AM) (𝟙 U_V) ≫
            𝟙 (∐ fun _ : U_V ⟶ U_V => AM)) ≫
          CategoryTheory.Limits.Sigma.map' (fun g : U_V ⟶ U_V => u_inc ≫ g) (fun _ => 𝟙 AM)
      simp only [CategoryTheory.Limits.colimit.ι_desc, CategoryTheory.Limits.Cofan.mk_pt,
        CategoryTheory.Limits.Cofan.mk_ι_app, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.comp_id, CategoryTheory.Limits.Sigma.ι_comp_map']

    let adj_sh := CategoryTheory.sheafificationAdjunction J₀ AddCommGrpCat.{u}
    have hMap_φ_pre :
        (CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).map φ_pre = ι := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have hAdjNat :
          adj_sh.homEquiv P₁ L₂
            ((CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).map φ_pre) =
          φ_pre ≫ adj_sh.unit.app P₂ :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_sh P₁ L₂
          ((CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).map φ_pre)).trans
          (adj_sh.unit.naturality φ_pre).symm
      have hNat_u :
          P₂.map (Opposite.op u_inc) ≫ (adj_sh.unit.app P₂).app (Opposite.op U_VO) =
            (adj_sh.unit.app P₂).app (Opposite.op U_V) ≫ L₂.obj.map (Opposite.op u_inc) :=
        (adj_sh.unit.app P₂).naturality (Opposite.op u_inc)
      have hm1 :
          CategoryTheory.Sheaf.freeYonedaHomEquiv
            ((CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).map φ_pre) =
          (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₂) ≫ P₂.map (Opposite.op u_inc)) ≫
            (adj_sh.unit.app P₂).app (Opposite.op U_VO) :=
        (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv hAdjNat).trans
          ((CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _).trans
            (congrArg (· ≫ (adj_sh.unit.app P₂).app (Opposite.op U_VO)) hEquiv_φ_pre))
      have hm2 :
          (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₂) ≫ P₂.map (Opposite.op u_inc)) ≫
            (adj_sh.unit.app P₂).app (Opposite.op U_VO) =
          (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₂) ≫
            (adj_sh.unit.app P₂).app (Opposite.op U_V)) ≫
            L₂.obj.map (Opposite.op u_inc) :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₂) ≫ ·) hNat_u).trans
            (CategoryTheory.Category.assoc _ _ _).symm)
      have hIdL₂ : adj_sh.homEquiv P₂ L₂ (𝟙 L₂) = adj_sh.unit.app P₂ :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_sh P₂ L₂ (𝟙 L₂)).trans
          ((congrArg (adj_sh.unit.app P₂ ≫ ·)
            ((CategoryTheory.sheafToPresheaf J₀ AddCommGrpCat.{u}).map_id L₂)).trans
            (CategoryTheory.Category.comp_id _))
      have hm3 :
          (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₂) ≫
            (adj_sh.unit.app P₂).app (Opposite.op U_V)) ≫
            L₂.obj.map (Opposite.op u_inc) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv ι :=
        (congrArg (· ≫ L₂.obj.map (Opposite.op u_inc))
          ((CategoryTheory.Presheaf.freeYonedaHomEquiv_comp (𝟙 P₂)
              (adj_sh.unit.app P₂)).symm.trans
            (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
              ((CategoryTheory.Category.id_comp (adj_sh.unit.app P₂)).trans hIdL₂.symm)))).trans
          (Equiv.apply_symm_apply _ _).symm
      exact hm1.trans (hm2.trans hm3)

    have hSplit_VO : ∀ (W : S₀.Etale), Nonempty (W ⟶ U_VO) →
        ∃ r_W : P₂.obj (Opposite.op W) ⟶ P₁.obj (Opposite.op W),
          φ_pre.app (Opposite.op W) ≫ r_W = 𝟙 _ ∧
          r_W ≫ φ_pre.app (Opposite.op W) = 𝟙 _ := by
      intro W ⟨g₀⟩
      haveI := hSub_VO W
      haveI := hSub_V W
      let r_W : P₂.obj (Opposite.op W) ⟶ P₁.obj (Opposite.op W) :=
        CategoryTheory.Limits.Sigma.desc (fun (_ : W ⟶ U_V) =>
          CategoryTheory.Limits.Sigma.ι (fun _ : W ⟶ U_VO => AM) g₀)
      refine ⟨r_W, ?_, ?_⟩
      · apply CategoryTheory.Limits.Sigma.hom_ext
        intro f
        dsimp [φ_pre, r_W, P₁, P₂, CategoryTheory.Presheaf.freeYoneda]
        simp only [CategoryTheory.Limits.colimit.ι_desc_assoc, CategoryTheory.Limits.Cofan.mk_pt,
          CategoryTheory.Limits.Cofan.mk_ι_app, CategoryTheory.Limits.colimit.ι_desc,
          CategoryTheory.Category.comp_id]
        rw [Subsingleton.elim g₀ f]
      · apply CategoryTheory.Limits.Sigma.hom_ext
        intro j
        dsimp [φ_pre, r_W, P₁, P₂, CategoryTheory.Presheaf.freeYoneda]
        simp only [CategoryTheory.Limits.colimit.ι_desc_assoc, CategoryTheory.Limits.Cofan.mk_pt,
          CategoryTheory.Limits.Cofan.mk_ι_app, CategoryTheory.Limits.colimit.ι_desc,
          CategoryTheory.Category.comp_id]
        rw [Subsingleton.elim (g₀ ≫ u_inc) j]

    haveI hMono_app : ∀ Y : (S₀.Etale)ᵒᵖ, CategoryTheory.Mono (φ_pre.app Y) := by
      intro Y
      by_cases hY : Nonempty (Y.unop ⟶ U_VO)
      · obtain ⟨r_Y, hr₁, _⟩ := hSplit_VO Y.unop hY
        refine ⟨fun {X_ab} a b hab => ?_⟩
        calc
          a = a ≫ 𝟙 _ := (CategoryTheory.Category.comp_id a).symm
          _ = a ≫ (φ_pre.app Y ≫ r_Y) := by rw [hr₁]
          _ = (a ≫ φ_pre.app Y) ≫ r_Y := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (b ≫ φ_pre.app Y) ≫ r_Y := by rw [hab]
          _ = b ≫ (φ_pre.app Y ≫ r_Y) := CategoryTheory.Category.assoc _ _ _
          _ = b ≫ 𝟙 _ := by rw [hr₁]
          _ = b := CategoryTheory.Category.comp_id b
      · have hEmpty : IsEmpty (Y.unop ⟶ U_VO) := not_nonempty_iff.mp hY
        have hId0 : 𝟙 (P₁.obj Y) = 0 := by
          apply CategoryTheory.Limits.Sigma.hom_ext
          intro f
          exact hEmpty.elim f
        refine ⟨fun {X_ab} a b _ => ?_⟩
        calc
          a = a ≫ 𝟙 (P₁.obj Y) := (CategoryTheory.Category.comp_id a).symm
          _ = a ≫ 0 := by rw [hId0]
          _ = 0 := CategoryTheory.Limits.comp_zero
          _ = b ≫ 0 := CategoryTheory.Limits.comp_zero.symm
          _ = b ≫ 𝟙 (P₁.obj Y) := by rw [hId0]
          _ = b := CategoryTheory.Category.comp_id b

    haveI : CategoryTheory.Mono φ_pre := CategoryTheory.NatTrans.mono_of_mono_app φ_pre
    haveI : CategoryTheory.Mono ι :=
      hMap_φ_pre ▸
        CategoryTheory.Functor.map_mono (CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}) φ_pre

    let 𝒬 := CategoryTheory.Limits.cokernel ι
    let π : L₂ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π ι
    let sc := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
    have hExact : sc.Exact :=
      CategoryTheory.ShortComplex.exact_of_g_is_cokernel sc
        (CategoryTheory.Limits.cokernelIsCokernel ι)
    have hSE : sc.ShortExact :=
      CategoryTheory.ShortComplex.ShortExact.mk' hExact inferInstance inferInstance

    have hTor_AM : n • (𝟙 AM) = 0 := by
      ext ⟨x⟩
      apply ULift.ext
      change n • x = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]

    have hTor_P₂ : n • (𝟙 P₂) = 0 := by
      ext Y : 2
      apply CategoryTheory.Limits.Sigma.hom_ext
      intro j
      change CategoryTheory.Limits.Sigma.ι (fun _ : Y.unop ⟶ U_V => AM) j ≫
          (n • 𝟙 (∐ fun _ : Y.unop ⟶ U_V => AM)) =
        CategoryTheory.Limits.Sigma.ι (fun _ : Y.unop ⟶ U_V => AM) j ≫ 0
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id,
        ← CategoryTheory.Category.id_comp
          (CategoryTheory.Limits.Sigma.ι (fun _ : Y.unop ⟶ U_V => AM) j),
        ← CategoryTheory.Preadditive.nsmul_comp, hTor_AM,
        CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

    have hTor_L₂ : n • (𝟙 L₂) = 0 := by
      change n • 𝟙 ((CategoryTheory.presheafToSheaf J₀ AddCommGrpCat.{u}).obj P₂) = 0
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hTor_P₂,
        CategoryTheory.Functor.map_zero]

    have hTor_𝒬 : n • CategoryTheory.CategoryStruct.id 𝒬 = 0 := by
      apply (cancel_epi π).mp
      calc
        π ≫ (n • 𝟙 𝒬)
          = n • (π ≫ 𝟙 𝒬) := CategoryTheory.Preadditive.comp_nsmul _ _ _
        _ = n • (𝟙 L₂ ≫ π) := by
              rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
        _ = (n • 𝟙 L₂) ≫ π := (CategoryTheory.Preadditive.nsmul_comp _ _ _).symm
        _ = 0 ≫ π := by rw [hTor_L₂]
        _ = 0 := CategoryTheory.Limits.zero_comp
        _ = π ≫ 0 := CategoryTheory.Limits.comp_zero.symm

    have hZeroOut : ∀ U : S₀.Etale,
        Set.range U.hom.base ⊆ (Set.range i.base)ᶜ →
        Subsingleton ↥(𝒬.obj.obj (Opposite.op U)) := by
      let η₂ : P₂ ⟶ L₂.obj := CategoryTheory.toSheafify J₀ P₂
      haveI : CategoryTheory.Presheaf.IsLocallySurjective J₀ η₂ :=
        CategoryTheory.GrothendieckTopology.instIsLocallySurjectiveToSheafify P₂
      haveI : CategoryTheory.Presheaf.IsLocallySurjective J₀ π.hom :=
        (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} π).mpr inferInstance
      let ψ : P₂ ⟶ 𝒬.obj := η₂ ≫ π.hom
      haveI : CategoryTheory.Presheaf.IsLocallySurjective J₀ ψ :=
        CategoryTheory.Presheaf.isLocallySurjective_comp J₀ η₂ π.hom
      have hφψ_zero : φ_pre ≫ ψ = 0 := by
        have hη_eq : η₂ = adj_sh.unit.app P₂ := rfl
        have hnat : φ_pre ≫ η₂ = adj_sh.unit.app P₁ ≫ ι.hom := by
          rw [hη_eq, ← hMap_φ_pre]
          exact adj_sh.unit.naturality φ_pre
        calc
          φ_pre ≫ ψ = (φ_pre ≫ η₂) ≫ π.hom := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (adj_sh.unit.app P₁ ≫ ι.hom) ≫ π.hom := by rw [hnat]
          _ = adj_sh.unit.app P₁ ≫ (ι ≫ π).hom := CategoryTheory.Category.assoc _ _ _
          _ = adj_sh.unit.app P₁ ≫ (0 : L₁ ⟶ 𝒬).hom := by
                rw [CategoryTheory.Limits.cokernel.condition]
          _ = 0 := CategoryTheory.Limits.comp_zero
      intro U hU_out
      have hAllZero : ∀ y : ↥(𝒬.obj.obj (Opposite.op U)), y = 0 := by
        intro y
        let R := CategoryTheory.Presheaf.imageSieve ψ y
        have hR : R ∈ J₀ U := CategoryTheory.Presheaf.imageSieve_mem J₀ ψ y
        refine 𝒬.property.isSeparated U R hR y 0 (fun W g hg => ?_)
        rw [CategoryTheory.Presheaf.imageSieve_apply] at hg
        obtain ⟨x₂, hx₂⟩ := hg
        have hW_O : Set.range W.hom.base ⊆ (O : Set ↥S₀) := by
          rintro _ ⟨w, rfl⟩
          have hgw : g.left ≫ U.hom = W.hom := CategoryTheory.MorphismProperty.Over.w g
          have hmem_U : W.hom.base w ∈ Set.range U.hom.base :=
            ⟨g.left.base w, congrArg (fun f : W.left ⟶ S₀ => f.base w) hgw⟩
          rw [hO]
          exact hU_out hmem_U
        have hψx₂ : ψ.app (Opposite.op W) x₂ = 0 := by
          by_cases hWV : Nonempty (W ⟶ U_V)
          · obtain ⟨j₀⟩ := hWV
            have hW_VO : Set.range W.hom.base ⊆ Set.range (V ⊓ O).ι.base := by
              rw [AlgebraicGeometry.Scheme.Opens.range_ι]
              rintro _ ⟨w, rfl⟩
              have hjw : j₀.left ≫ V.ι = W.hom := CategoryTheory.MorphismProperty.Over.w j₀
              have hmem_V : W.hom.base w ∈ Set.range V.ι.base :=
                ⟨j₀.left.base w, congrArg (fun f : W.left ⟶ S₀ => f.base w) hjw⟩
              rw [AlgebraicGeometry.Scheme.Opens.range_ι] at hmem_V
              exact ⟨hmem_V, hW_O ⟨w, rfl⟩⟩
            let g_lift : W.left ⟶ (V ⊓ O).toScheme :=
              AlgebraicGeometry.IsOpenImmersion.lift (V ⊓ O).ι W.hom hW_VO
            let g₀ : W ⟶ U_VO :=
              CategoryTheory.MorphismProperty.Over.homMk g_lift
                (AlgebraicGeometry.IsOpenImmersion.lift_fac (V ⊓ O).ι W.hom hW_VO)
            obtain ⟨r_W, _, hr₂⟩ := hSplit_VO W ⟨g₀⟩
            have hx₁ : φ_pre.app (Opposite.op W) (r_W x₂) = x₂ := by
              calc
                φ_pre.app (Opposite.op W) (r_W x₂)
                  = (r_W ≫ φ_pre.app (Opposite.op W)) x₂ := rfl
                _ = (𝟙 (P₂.obj (Opposite.op W))) x₂ := by rw [hr₂]
                _ = x₂ := rfl
            calc
              ψ.app (Opposite.op W) x₂
                = ψ.app (Opposite.op W) (φ_pre.app (Opposite.op W) (r_W x₂)) := by rw [hx₁]
              _ = (φ_pre ≫ ψ).app (Opposite.op W) (r_W x₂) := rfl
              _ = (0 : P₁ ⟶ 𝒬.obj).app (Opposite.op W) (r_W x₂) := by rw [hφψ_zero]
              _ = 0 := rfl
          · have hEmptyV : IsEmpty (W ⟶ U_V) := not_nonempty_iff.mp hWV
            have hId0_W : 𝟙 (P₂.obj (Opposite.op W)) = 0 := by
              apply CategoryTheory.Limits.Sigma.hom_ext
              intro j
              exact hEmptyV.elim j
            have hx₂0 : x₂ = 0 := by
              calc
                x₂ = (𝟙 (P₂.obj (Opposite.op W))) x₂ := rfl
                _ = (0 : P₂.obj (Opposite.op W) ⟶ P₂.obj (Opposite.op W)) x₂ := by rw [hId0_W]
                _ = 0 := rfl
            rw [hx₂0]
            exact map_zero (ψ.app (Opposite.op W)).hom
        have hmap0 : 𝒬.obj.map g.op (0 : ↥(𝒬.obj.obj (Opposite.op U))) = 0 :=
          map_zero (𝒬.obj.map g.op).hom
        exact (hx₂.symm.trans hψx₂).trans hmap0.symm
      exact ⟨fun a b => (hAllZero a).trans (hAllZero b).symm⟩

    have hSub₀ : Subsingleton (𝒬.H q₀) :=
      weil_alt_cd_closed_immersion_support_cohomology_vanishing i n q₀ hVanishZ₀ 𝒬 hTor_𝒬 hZeroOut
    have hSub₁ : Subsingleton (𝒬.H (q₀ + 1)) :=
      weil_alt_cd_closed_immersion_support_cohomology_vanishing i n (q₀ + 1) hVanishZ₁ 𝒬
        hTor_𝒬 hZeroOut
    let Fℤ := (CategoryTheory.constantSheaf J₀ AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    refine ⟨?_, ?_⟩
    · rw [injective_iff_map_eq_zero]
      intro x₁ hx₁
      have hx₁_comp : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ sc.f) (Nat.add_zero (q₀ + 1)) = 0 :=
        hx₁
      obtain ⟨x₃, hx₃⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hSE x₁ hx₁_comp rfl
      have hx₃0 : x₃ = 0 := hSub₀.elim x₃ 0
      rw [← hx₃, hx₃0]
      exact CategoryTheory.Abelian.Ext.zero_comp Fℤ q₀ hSE.extClass (q₀ + 1) rfl
    · intro x₂
      have hx₂_comp : x₂.comp (CategoryTheory.Abelian.Ext.mk₀ sc.g) (Nat.add_zero (q₀ + 1)) = 0 :=
        hSub₁.elim _ 0
      obtain ⟨x₁, hx₁⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₂ Fℤ hSE x₂ hx₂_comp
      exact ⟨x₁, hx₁⟩

  
  
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let P1 := weilProjectiveSpaceOver k 1
  let Pd := weilPolyP1Over k
  let Ad := weilAffineSpaceOver k

  have hRange_aff0 : Set.range (ι_aff 0).base = Set.univ := by
    have hNonempty_A0 : Nonempty ↥(Ad 0).left :=
      (PrimeSpectrum.nonempty_iff_nontrivial (R := MvPolynomial (Fin 0) k)).mpr inferInstance
    obtain ⟨x₀⟩ := hNonempty_A0
    have hSub_P0 : Subsingleton ↥(Pd 0).left := by
