      have hQ₀_cl : IsClosed ({f.base P₀.1} : Set ↥P1_over.left) := by
        rw [← Set.image_singleton]
        exact f.isClosedMap {P₀.1} P₀.2
      let Q₀ : Pt_P1 := ⟨f.base P₀.1, hQ₀_cl⟩
      refine ⟨Q₀, ?_⟩
      obtain ⟨V_chart, hQ_in_V, hAff_V, hAff_U, M, instAddM, instModM, eM, heM, ⟨bM⟩⟩ :=
        hf_free.2 Q₀.1
      let U_chart : C_bar.left.Opens := (TopologicalSpace.Opens.map f.base).obj V_chart
      have hP_in_U : P₀.1 ∈ U_chart := hQ_in_V
      let B : Type u := ↑(P1_over.left.presheaf.obj (Opposite.op V_chart))
      let A : Type u := ↑(C_bar.left.presheaf.obj (Opposite.op U_chart))
      have : IsDomain B :=
        @AlgebraicGeometry.IsIntegral.component_integral P1_over.left _ V_chart ⟨⟨Q₀.1, hQ_in_V⟩⟩
      have : IsDomain A :=
        @AlgebraicGeometry.IsIntegral.component_integral C_bar.left _ U_chart ⟨⟨P₀.1, hP_in_U⟩⟩
      let kToB : k →+* B :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          P1_over.hom.appLE ⊤ V_chart le_top).hom
      let kToA : k →+* A :=
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫
          C_bar.hom.appLE ⊤ U_chart le_top).hom
      let φ : B →+* A := (f.app V_chart).hom
      letI : Algebra k B := kToB.toAlgebra
      letI : Algebra k A := kToA.toAlgebra
      letI : Algebra B A := φ.toAlgebra
      have halg_BA : algebraMap B A = φ := rfl
      have : IsScalarTower k B A :=
        IsScalarTower.of_algebraMap_eq fun c => by
          change kToA c = φ (kToB c)
          have hcomp_app :
              P1_over.hom.appLE ⊤ V_chart le_top ≫ f.app V_chart =
