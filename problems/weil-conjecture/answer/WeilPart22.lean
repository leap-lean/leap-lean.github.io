        have hσ_iff : (j = σ i) ↔ (i = ℓ_last) := by
          have hσ_l : σ ℓ_last = j := Equiv.swap_apply_right j ℓ_last
          constructor
          · intro h_eq
            apply σ.injective
            rw [hσ_l]
            exact h_eq.symm
          · intro hi
            rw [hi, hσ_l]
