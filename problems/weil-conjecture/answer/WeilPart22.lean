            CategoryTheory.Limits.pullback.lift (t_Z ≫ b_l β₁) t_Z ht_δ
          have hl_T_snd : l_T ≫ i_pair β₁ β₂ = t_Z :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          obtain ⟨q₀⟩ := hT_ne
          have hpt_in_range : t_Z.base q₀ ∈ Set.range (i_pair β₁ β₂).base :=
            ⟨l_T.base q₀, congrArg (fun u : T ⟶ Z_s => u.base q₀) hl_T_snd⟩
          have hpt_in_star : t_Z.base q₀ ∈ U_star := (t_u.base q₀).2
          have hpt_in_compl : t_Z.base q₀ ∈ U_pm β₁ β₂ := h_le_pair hpt_in_star
          rw [hU_compl] at hpt_in_compl
          exact hpt_in_compl hpt_in_range
        obtain ⟨Z', w_star, hZ'_ne, hs_Z'_ne, hPairDisj⟩ := hOpen_Z'
        let s_Z' : ↥(L₀.obj.obj (Opposite.op Z')) := L₀.obj.map (Opposite.op w_star) s_Z
