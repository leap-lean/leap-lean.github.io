        obtain ⟨W₀, e_W₀, ⟨y₀_W₀⟩, hw_diag, hW₀_disj⟩ := hW₀_ex
        have hΨ_Z'_zero : Ψ.hom.app (Opposite.op Z') s_Z' = 0 := by
          have hn := Ψ.hom.naturality (Opposite.op w_star)
          have hn_app := congrArg (fun f => f s_Z) hn
          change Ψ.hom.app (Opposite.op Z') s_Z' =
            ℋ.obj.map (Opposite.op w_star) (Ψ.hom.app (Opposite.op Z) s_Z) at hn_app
          rw [hn_app, hΨ_zero, map_zero]
        have hMapCoeff_app : ∀ (γ : Z' ⟶ V) (a : ↥(A m₀)),
            (mapCoeff φ S₀ V).hom.app (Opposite.op Z')
              ((ξ₀ ≫ L₀.obj.map (Opposite.op γ)) a) =
              (ξ_m ≫ L_m.obj.map (Opposite.op γ)) (φ.hom a) := by
