          refine ⟨Z'₀, w_star₀, ⟨y₀_Z'⟩, hs_Z'_ne, ?_⟩
          intro β₁ hβ₁_mem β₂ hβ₂_mem hβ₁₂_ne T t hT_ne ht_eq
