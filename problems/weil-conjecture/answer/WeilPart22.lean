    obtain ⟨iso_gf₀⟩ := (hHDICalc gf).1 H₀
    obtain ⟨iso_f₀⟩ := (hHDICalc f').1 (pf_g.obj H₀)
    exact ⟨iso_gf₀.trans ((e_pf.app H₀).trans iso_f₀.symm)⟩

  have hInjAcyc : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (J : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
      [CategoryTheory.Injective J] (p : ℕ),
      1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h p J) := by
    intro X₁ X₂ h J _ p hp
    cases p with
    | zero => omega
    | succ n =>
      let B_h : CategoryTheory.Functor X₂.Etale X₁.Etale :=
        CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
      let P : CategoryTheory.Functor (Opposite X₁.Etale) AddCommGrpCat.{u} :=
        CategoryTheory.Sheaf.cohomologyPresheaf J (n + 1)
      have hPU : ∀ U : Opposite X₁.Etale, CategoryTheory.Limits.IsZero (P.obj U) := by
        intro U
        rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
        ext x
        exact CategoryTheory.Abelian.Ext.eq_zero_of_injective x
      have hZ_pre : CategoryTheory.Limits.IsZero (CategoryTheory.Functor.comp B_h.op P) :=
        (CategoryTheory.Functor.isZero_iff (CategoryTheory.Functor.comp B_h.op P)).mpr
          (fun V => hPU (B_h.op.obj V))
      exact CategoryTheory.Functor.map_isZero
        (CategoryTheory.presheafToSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}) hZ_pre

  have hPos : ∀ (n : ℕ) (H₀ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ q : ℕ, 1 ≤ q → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g q H₀)) →
      Nonempty (CategoryTheory.Iso
        (weilEtaleHigherDirectImage gf (n + 1) H₀)
        (weilEtaleHigherDirectImage f (n + 1) (pf_g.obj H₀))) := by
    intro n
    induction n with
    | zero =>
      intro H₀ hAcyc₀
      let I := CategoryTheory.Injective.under H₀
      let ι_H₀ : H₀ ⟶ I := CategoryTheory.Injective.ι H₀
      let Q := CategoryTheory.Limits.cokernel ι_H₀
      let π_Q : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι_H₀
      let SC_H₀ := CategoryTheory.ShortComplex.mk ι_H₀ π_Q
        (CategoryTheory.Limits.cokernel.condition ι_H₀)
      have hSE_H₀ : SC_H₀.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι_H₀ }
      have : CategoryTheory.Injective (pf_g.obj I) :=
        CategoryTheory.Injective.injective_of_adjoint adj_g I
      have hAcyc_g_I : ∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g p I) :=
        fun p hp => hInjAcyc g' I p hp
      have hAcyc_gf_I : ∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage gf p I) :=
        fun p hp => hInjAcyc gf I p hp
      have hAcyc_f_pfgI : ∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p (pf_g.obj I)) :=
        fun p hp => hInjAcyc f' (pf_g.obj I) p hp
      have hSE_pfg : (SC_H₀.map pf_g).ShortExact :=
        (((hHDICalc g').2 SC_H₀ hSE_H₀ hAcyc_g_I).2.1) (hAcyc₀ 1 (le_refl 1))
      obtain ⟨δ₀_gf, hcomp_gf, hEpi_gf, hEx_gf⟩ :=
        ((hHDICalc gf).2 SC_H₀ hSE_H₀ hAcyc_gf_I).1
      have := hEpi_gf
      let iso_gf₁ :=
        CategoryTheory.Limits.IsColimit.coconePointUniqueUpToIso
          (CategoryTheory.ShortComplex.Exact.gIsCokernel hEx_gf)
          (CategoryTheory.Limits.cokernelIsCokernel (pf_gf.map π_Q))
      obtain ⟨δ₀_f, hcomp_f, hEpi_f, hEx_f⟩ :=
        ((hHDICalc f').2 (SC_H₀.map pf_g) hSE_pfg hAcyc_f_pfgI).1
      have := hEpi_f
      let iso_f₁ :=
        CategoryTheory.Limits.IsColimit.coconePointUniqueUpToIso
          (CategoryTheory.ShortComplex.Exact.gIsCokernel hEx_f)
          (CategoryTheory.Limits.cokernelIsCokernel (pf_f.map (pf_g.map π_Q)))
      let iso_cok : CategoryTheory.Limits.cokernel (pf_gf.map π_Q) ≅
          CategoryTheory.Limits.cokernel (pf_f.map (pf_g.map π_Q)) :=
        CategoryTheory.Limits.cokernel.mapIso
          (pf_gf.map π_Q) (pf_f.map (pf_g.map π_Q))
          (e_pf.app I) (e_pf.app Q) (e_pf.hom.naturality π_Q)
      exact ⟨iso_gf₁.trans (iso_cok.trans iso_f₁.symm)⟩
    | succ k ih =>
      intro H₀ hAcyc₀
      let I := CategoryTheory.Injective.under H₀
      let ι_H₀ : H₀ ⟶ I := CategoryTheory.Injective.ι H₀
      let Q := CategoryTheory.Limits.cokernel ι_H₀
      let π_Q : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι_H₀
      let SC_H₀ := CategoryTheory.ShortComplex.mk ι_H₀ π_Q
        (CategoryTheory.Limits.cokernel.condition ι_H₀)
      have hSE_H₀ : SC_H₀.ShortExact :=
        { exact := CategoryTheory.ShortComplex.exact_cokernel ι_H₀ }
      have : CategoryTheory.Injective (pf_g.obj I) :=
        CategoryTheory.Injective.injective_of_adjoint adj_g I
      have hAcyc_g_I : ∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g p I) :=
        fun p hp => hInjAcyc g' I p hp
      have hAcyc_gf_I : ∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage gf p I) :=
        fun p hp => hInjAcyc gf I p hp
      have hAcyc_f_pfgI : ∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f p (pf_g.obj I)) :=
        fun p hp => hInjAcyc f' (pf_g.obj I) p hp
      have hCalc_g := (hHDICalc g').2 SC_H₀ hSE_H₀ hAcyc_g_I
      have hSE_pfg : (SC_H₀.map pf_g).ShortExact :=
        (hCalc_g.2.1) (hAcyc₀ 1 (le_refl 1))
      have hAcyc_Q : ∀ p : ℕ, 1 ≤ p →
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g p Q) := by
        intro p hp
        obtain ⟨iso_shift_g⟩ := hCalc_g.2.2 p hp
        exact (hAcyc₀ (p + 1) (by omega)).of_iso iso_shift_g.symm
      have hk1 : 1 ≤ k + 1 := Nat.succ_le_succ (Nat.zero_le k)
      obtain ⟨iso_shift_gf⟩ :=
        ((hHDICalc gf).2 SC_H₀ hSE_H₀ hAcyc_gf_I).2.2 (k + 1) hk1
      obtain ⟨iso_IH⟩ := ih Q hAcyc_Q
      obtain ⟨iso_shift_f⟩ :=
        ((hHDICalc f').2 (SC_H₀.map pf_g) hSE_pfg hAcyc_f_pfgI).2.2 (k + 1) hk1
      exact ⟨iso_shift_gf.trans (iso_IH.trans iso_shift_f.symm)⟩
  cases b with
  | zero => exact hDeg0 H
  | succ n => exact hPos n H hAcyc

theorem weil_polyP1_last_coord_single_leg_and_rel_direct_image_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (r m : ℕ)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCD_Pd1 : ∀ (F : CategoryTheory.Sheaf (weilPolyP1Over k 1).left.smallEtaleTopology
        AddCommGrpCat.{u}) (b : ℕ),
      (ℓ ^ 1) • CategoryTheory.CategoryStruct.id F = 0 →
      2 * 1 < b →
      Subsingleton (F.H b))
    (hProp_Pm : AlgebraicGeometry.IsProper (weilPolyP1Over k m).hom)
    (hProp_P1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom)
    (W_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper W_bar.hom]
    (π_leg : Quiver.Hom W_bar.left (weilPolyP1Over k (m + 1)).left)
    (hπ_over : CategoryTheory.CategoryStruct.comp π_leg (weilPolyP1Over k (m + 1)).hom = W_bar.hom)
    [_hCont : (weilEtaleSitePullback π_leg).IsContinuous
      (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology]
    [_hAdj : ((weilEtaleSitePullback π_leg).sheafPushforwardContinuous AddCommGrpCat.{u}
      (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology).IsRightAdjoint]
    (U_W : W_bar.left.Etale)
    (U_P : (weilPolyP1Over k (m + 1)).left.Etale)
    [AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left]
    (e_leg : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).left
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U_P).left)
    (hU_comm : CategoryTheory.CategoryStruct.comp
        ((AlgebraicGeometry.Scheme.Etale.forget W_bar.left).obj U_W).hom π_leg =
      CategoryTheory.CategoryStruct.comp e_leg.hom
        ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U_P).hom) :
    let P_m := weilPolyP1Over k m
    let P1_over := weilProjectiveSpaceOver k 1
    let P := weilPolyP1Over k (m + 1)
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
    let Fgt_P := AlgebraicGeometry.Scheme.Etale.forget P.left
    let B_π := weilEtaleSitePullback π_leg
    let pf_π := B_π.sheafPushforwardContinuous AddCommGrpCat.{u}
      P.left.smallEtaleTopology W_bar.left.smallEtaleTopology
    let π_fst := CategoryTheory.Limits.pullback.fst P_m.hom P1_over.hom
    let L_P := weilEtaleLocalTorsionSheaf P.left (ℓ ^ r) U_P
    let L_W := weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r) U_W
    CategoryTheory.IsIso
      (weilEtaleConstPullbackHom π_leg
        (weilEtaleIdTerminalIsTerminal W_bar.left)
        (weilEtaleIdTerminalIsTerminal P.left)
        (AddCommGrpCat.of (ULift.{u} ℤ))) ∧
    ∃ (σ_e : Quiver.Hom U_W (B_π.obj U_P))
      (α_π : Quiver.Hom L_P (pf_π.obj L_W)),
      CategoryTheory.CategoryStruct.comp ((Fgt_W.map σ_e).left)
        (CategoryTheory.Limits.pullback.fst (Fgt_P.obj U_P).hom π_leg) = e_leg.hom ∧
      CategoryTheory.CategoryStruct.comp (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π)
        (L_W.obj.map (Opposite.op σ_e)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_W) ∧
      (∀ (V : W_bar.left.Etale) (w : Quiver.Hom V (B_π.obj U_P)),
        Disjoint (Set.range ((Fgt_W.map w).left).base)
          (Set.range ((Fgt_W.map σ_e).left).base) →
        CategoryTheory.CategoryStruct.comp (CategoryTheory.Sheaf.freeYonedaHomEquiv α_π)
          (L_W.obj.map (Opposite.op w)) = 0) ∧
      CategoryTheory.IsIso α_π ∧
      (∀ q : ℕ, 1 ≤ q →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π_leg q L_W)) ∧
      (∀ b : ℕ, 3 ≤ b →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π_fst b (pf_π.obj L_W))) ∧
      (∀ b : ℕ, 3 ≤ b →
        CategoryTheory.Limits.IsZero
          (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.comp π_leg π_fst) b L_W)) :=
by
  classical
  obtain ⟨hc_all, hr_all, _, _, hConstIso, hFreePull,
    hZeroStalk, hIsoStalk, hClopenPkg, _, _⟩ :=
    weil_etale_pinned_clopen_section_and_stalk_criteria.{u}
  cases Subsingleton.elim _hCont (hc_all π_leg)
  cases Subsingleton.elim _hAdj (hr_all π_leg)
  intro P_m P1_over P Fgt_W Fgt_P B_π pf_π π_fst L_P L_W
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      (weilEtaleSitePullback f).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
    @hc_all
  have : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom S₁ S₂),
      ((weilEtaleSitePullback f).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint :=
    @hr_all
  refine ⟨hConstIso π_leg
    (weilEtaleIdTerminalIsTerminal W_bar.left)
    (weilEtaleIdTerminalIsTerminal P.left)
    (AddCommGrpCat.of (ULift.{u} ℤ)), ?_⟩

  
  have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
      (@AlgebraicGeometry.IsProper) P_m.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have hProp_πfst : AlgebraicGeometry.IsProper π_fst :=
    CategoryTheory.MorphismProperty.pullback_fst (P := @AlgebraicGeometry.IsProper)
      P_m.hom P1_over.hom hProp_P1
  have hProp_P : AlgebraicGeometry.IsProper P.hom :=
    CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsProper)
      π_fst P_m.hom hProp_πfst hProp_Pm
  have : AlgebraicGeometry.IsProper P.hom := hProp_P
  have : AlgebraicGeometry.IsProper π_leg := by
    have : AlgebraicGeometry.IsProper (CategoryTheory.CategoryStruct.comp π_leg P.hom) := by
      rw [hπ_over]
      infer_instance
    exact AlgebraicGeometry.IsProper.of_comp π_leg P.hom
  have : AlgebraicGeometry.IsAffine (Fgt_P.obj U_P).left :=
    AlgebraicGeometry.IsAffine.of_isIso e_leg.inv
  have : AlgebraicGeometry.IsAffineHom
      (CategoryTheory.CategoryStruct.comp (Fgt_P.obj U_P).hom P.hom) :=
    AlgebraicGeometry.isAffineHom_of_isAffine _
  have hAffHom_UP : AlgebraicGeometry.IsAffineHom (Fgt_P.obj U_P).hom :=
    AlgebraicGeometry.IsAffineHom.of_comp (Fgt_P.obj U_P).hom P.hom

  
  have hPrime : Nat.Prime ℓ := Fact.out
  have hTor_ℓ :
      ℓ • CategoryTheory.CategoryStruct.id
        (weilEtaleLocalTorsionSheaf W_bar.left ℓ U_W) = 0 := by
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let P₀ := CategoryTheory.Presheaf.freeYoneda U_W AM
    let L := (CategoryTheory.presheafToSheaf W_bar.left.smallEtaleTopology AddCommGrpCat.{u}).obj P₀
    let adj := CategoryTheory.sheafificationAdjunction W_bar.left.smallEtaleTopology AddCommGrpCat.{u}
    have hAM_tor : ℓ • CategoryTheory.CategoryStruct.id AM = 0 := by
      ext ⟨x⟩
      apply ULift.ext
      change ℓ • x = 0
      rw [nsmul_eq_mul, CharP.cast_eq_zero, zero_mul]
    have hEval : ∀ (g : L ⟶ L),
        CategoryTheory.Sheaf.freeYonedaHomEquiv g =
          CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₀) ≫
            ((adj.homEquiv P₀ L) g).app (Opposite.op U_W) := by
      intro g
      let η : P₀ ⟶
          (CategoryTheory.sheafToPresheaf W_bar.left.smallEtaleTopology AddCommGrpCat.{u}).obj L :=
        (adj.homEquiv P₀ L) g
      change CategoryTheory.Presheaf.freeYonedaHomEquiv η =
        CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₀) ≫ η.app (Opposite.op U_W)
      rw [← CategoryTheory.Presheaf.freeYonedaHomEquiv_comp (𝟙 P₀) η,
        CategoryTheory.Category.id_comp]
    change ℓ • CategoryTheory.CategoryStruct.id L = 0
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hEval (ℓ • 𝟙 L), hEval 0]
    have hHom_nsmul : ((adj.homEquiv P₀ L) (ℓ • 𝟙 L)).app (Opposite.op U_W) =
        ℓ • ((adj.unit.app P₀).app (Opposite.op U_W)) := by
      have hUnit : (adj.homEquiv P₀ L) (ℓ • 𝟙 L) =
          adj.unit.app P₀ ≫
            (CategoryTheory.sheafToPresheaf W_bar.left.smallEtaleTopology
              AddCommGrpCat.{u}).map (ℓ • 𝟙 L) :=
        CategoryTheory.Adjunction.homEquiv_unit adj P₀ L (ℓ • 𝟙 L)
      have hMap : (CategoryTheory.sheafToPresheaf W_bar.left.smallEtaleTopology
          AddCommGrpCat.{u}).map (ℓ • 𝟙 L) =
          ℓ • 𝟙 ((CategoryTheory.sheafToPresheaf W_bar.left.smallEtaleTopology
            AddCommGrpCat.{u}).obj L) := by
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rw [hUnit, hMap, CategoryTheory.NatTrans.comp_app]
      change (adj.unit.app P₀).app (Opposite.op U_W) ≫ (ℓ • 𝟙 _) = _
      rw [CategoryTheory.Preadditive.comp_nsmul, CategoryTheory.Category.comp_id]
    have hHom_zero : ((adj.homEquiv P₀ L) 0).app (Opposite.op U_W) = 0 := by
      have hUnit : (adj.homEquiv P₀ L) 0 =
          adj.unit.app P₀ ≫
            (CategoryTheory.sheafToPresheaf W_bar.left.smallEtaleTopology
              AddCommGrpCat.{u}).map (0 : L ⟶ L) :=
        CategoryTheory.Adjunction.homEquiv_unit adj P₀ L 0
      rw [hUnit, CategoryTheory.Functor.map_zero, CategoryTheory.Limits.comp_zero]
      rfl
    rw [hHom_nsmul, hHom_zero, CategoryTheory.Preadditive.comp_nsmul,
      CategoryTheory.Limits.comp_zero]
    calc
      ℓ • (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₀) ≫
          (adj.unit.app P₀).app (Opposite.op U_W))
        = (ℓ • 𝟙 AM) ≫
            (CategoryTheory.Presheaf.freeYonedaHomEquiv (𝟙 P₀) ≫
              (adj.unit.app P₀).app (Opposite.op U_W)) := by
          rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp]
      _ = 0 := by
          rw [hAM_tor, CategoryTheory.Limits.zero_comp]

  
  obtain ⟨hR0Iso, hBockstein, _, _⟩ :=
    weil_etale_bockstein_and_degenerate_leray_ext_calculus.{u}
  obtain ⟨σ_e, α_std, hσ_e, _, hα_std_char, hStalkInj, hCoeffNat⟩ :=
    hClopenPkg π_leg U_W U_P e_leg hU_comm
  have hFiberData : ∀ (y : ↥P.left),
      let κ := P.left.residueField y
      let Ω := AlgebraicClosure ↥κ
      let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
      let bar_y : Quiver.Hom S_Ω P.left :=
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
          (P.left.fromSpecResidueField y)
      let pb_y := (weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
        P.left.smallEtaleTopology S_Ω.smallEtaleTopology
      let T_Ω := weilEtaleIdTerminal S_Ω
      (∀ (q : ℕ), 1 ≤ q →
        Subsingleton ↥((pb_y.obj
          (weilEtaleHigherDirectImage π_leg q
            (weilEtaleLocalTorsionSheaf W_bar.left ℓ U_W))).obj.obj (Opposite.op T_Ω))) ∧
      Function.Bijective
        ((pb_y.map (α_std ℓ)).hom.app (Opposite.op T_Ω)) := by
    intro y
    let κ := P.left.residueField y
    let Ω := AlgebraicClosure ↥κ
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    let bar_y : Quiver.Hom S_Ω P.left :=
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (↥κ) Ω)))
        (P.left.fromSpecResidueField y)
    let pb_y := (weilEtaleSitePullback bar_y).sheafPullback AddCommGrpCat.{u}
      P.left.smallEtaleTopology S_Ω.smallEtaleTopology
    let T_Ω := weilEtaleIdTerminal S_Ω
    let W_ybar := CategoryTheory.Limits.pullback π_leg bar_y
    let g'_sch : Quiver.Hom W_ybar W_bar.left := CategoryTheory.Limits.pullback.fst π_leg bar_y
    let π_ybar : Quiver.Hom W_ybar S_Ω := CategoryTheory.Limits.pullback.snd π_leg bar_y
    let S'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp bar_y P.hom)
    let X'_ov : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.comp g'_sch W_bar.hom)
    let f_ov : W_bar ⟶ P := CategoryTheory.Over.homMk π_leg hπ_over
    let g_ov : S'_ov ⟶ P := CategoryTheory.Over.homMk bar_y rfl
    let g'_ov : X'_ov ⟶ W_bar := CategoryTheory.Over.homMk g'_sch rfl
    let f'_ov : X'_ov ⟶ S'_ov := CategoryTheory.Over.homMk π_ybar (by
      change π_ybar ≫ (bar_y ≫ P.hom) = g'_sch ≫ W_bar.hom
      rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
        CategoryTheory.Category.assoc, hπ_over])
    let U₀ : W_ybar.Etale := (weilEtaleSitePullback g'_sch).obj U_W
    let V₀ : S_Ω.Etale := (weilEtaleSitePullback bar_y).obj U_P
