                      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm).trans
                    (CategoryTheory.Category.assoc π_leg_σ ι_σ fst_P).symm))))))
    · exact (CategoryTheory.Category.assoc g'_W π_leg π_snd).trans
        ((CategoryTheory.Category.comp_id π_leg_σ).symm.trans
