  rw [h_ev_step]
  let y₁ := ev_of b (pb_ι₀.obj (pb_j'₀.obj F₁)) (e_stalk b F₁ h₁ x)
  change (y₁.comp (Abelian.Ext.mk₀ ψ_φ) (Nat.add_zero b)).comp
      (Abelian.Ext.mk₀ (η_ι.inv.app F₂)) (Nat.add_zero b) =
    (y₁.comp (Abelian.Ext.mk₀ (η_ι.inv.app F₁)) (Nat.add_zero b)).comp
      (Abelian.Ext.mk₀ (pb_ι.map φ)) (Nat.add_zero b)
  rw [Abelian.Ext.comp_assoc y₁ (Abelian.Ext.mk₀ ψ_φ) (Abelian.Ext.mk₀ (η_ι.inv.app F₂))
      (Nat.add_zero b) (Nat.zero_add 0) (Nat.add_zero b),
    Abelian.Ext.comp_assoc y₁ (Abelian.Ext.mk₀ (η_ι.inv.app F₁)) (Abelian.Ext.mk₀ (pb_ι.map φ))
      (Nat.add_zero b) (Nat.zero_add 0) (Nat.add_zero b),
    Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
  exact congrArg (fun m => y₁.comp (Abelian.Ext.mk₀ m) (Nat.add_zero b)) (η_ι.inv.naturality φ)

theorem weil_etale_localTorsion_and_counit_pullback_iso (Y₁ Y₂ : AlgebraicGeometry.Scheme.{u})
    (h : Quiver.Hom Y₁ Y₂)
    (m : ℕ)
    (U₂ : Y₂.Etale)
    (U₁ : Y₁.Etale)
    (g_U : Quiver.Hom ((AlgebraicGeometry.Scheme.Etale.forget Y₁).obj U₁).left
      ((AlgebraicGeometry.Scheme.Etale.forget Y₂).obj U₂).left)
    (hpb_U : CategoryTheory.IsPullback g_U
      (((AlgebraicGeometry.Scheme.Etale.forget Y₁).obj U₁).hom)
      (((AlgebraicGeometry.Scheme.Etale.forget Y₂).obj U₂).hom) h)
    [_hc : (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology]
    [_hr : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint] :
    let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    ∃ (e_loc : CategoryTheory.Iso (pb_h.obj (weilEtaleLocalTorsionSheaf Y₂ m U₂))
        (weilEtaleLocalTorsionSheaf Y₁ m U₁))
      (e_const : CategoryTheory.Iso (pb_h.obj (weilEtaleTorsionSheaf Y₂ m))
        (weilEtaleTorsionSheaf Y₁ m)),
      CategoryTheory.CategoryStruct.comp
        (pb_h.map (weilEtaleLocalTorsionCounit Y₂ m U₂)) e_const.hom =
      CategoryTheory.CategoryStruct.comp
        e_loc.hom (weilEtaleLocalTorsionCounit Y₁ m U₁) :=
by
  dsimp only
  let _ : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let B_h : CategoryTheory.Functor Y₂.Etale Y₁.Etale := weilEtaleSitePullback h
  let J₁ := Y₁.smallEtaleTopology
  let J₂ := Y₂.smallEtaleTopology
  let pf_h := B_h.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
  let pb_h := B_h.sheafPullback AddCommGrpCat.{u} J₂ J₁
  let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
  let shAdj₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
  let shAdj₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
  let M : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let hpb_U' : CategoryTheory.IsPullback g_U U₁.hom U₂.hom h := hpb_U
  let w_iso : U₁ ≅ B_h.obj U₂ :=
    CategoryTheory.MorphismProperty.Over.isoMk hpb_U'.isoPullback hpb_U'.isoPullback_hom_snd
  let T₁ : Y₁.Etale := weilEtaleIdTerminal Y₁
  let T₂ : Y₂.Etale := weilEtaleIdTerminal Y₂
  let hT₁ : CategoryTheory.Limits.IsTerminal T₁ := weilEtaleIdTerminalIsTerminal Y₁
  let hT₂ : CategoryTheory.Limits.IsTerminal T₂ := weilEtaleIdTerminalIsTerminal Y₂
  let pb_id_left : CategoryTheory.Limits.pullback (𝟙 Y₂) h ≅ Y₁ :=
    { hom := CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h
      inv := CategoryTheory.Limits.pullback.lift h (𝟙 Y₁)
        ((CategoryTheory.Category.comp_id h).trans (CategoryTheory.Category.id_comp h).symm)
      hom_inv_id := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
            ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      inv_hom_id := CategoryTheory.Limits.pullback.lift_snd _ _ _ }
  let e_T : B_h.obj T₂ ≅ T₁ :=
    CategoryTheory.MorphismProperty.Over.isoMk pb_id_left
      (CategoryTheory.Category.comp_id (CategoryTheory.Limits.pullback.snd (𝟙 Y₂) h))
  let PM₁ := (CategoryTheory.Functor.const (Opposite Y₁.Etale)).obj M
  let PM₂ := (CategoryTheory.Functor.const (Opposite Y₂.Etale)).obj M
  let FM₁ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} := weilEtaleTorsionSheaf Y₁ m
  let FM₂ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u} := weilEtaleTorsionSheaf Y₂ m
  let η₀ : PM₂ ⟶ (pf_h.obj FM₁).obj :=
    CategoryTheory.Functor.whiskerLeft B_h.op (shAdj₁.unit.app PM₁)
  let uM : FM₂ ⟶ pf_h.obj FM₁ := (shAdj₂.homEquiv PM₂ (pf_h.obj FM₁)).symm η₀
  let cM : pb_h.obj FM₂ ⟶ FM₁ := (adj_h.homEquiv FM₂ FM₁).symm uM
  let constEv : ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D]
      {W₀ : D} (hW₀ : CategoryTheory.Limits.IsTerminal W₀)
      (Q : CategoryTheory.Functor (Opposite D) AddCommGrpCat.{u}),
      (((CategoryTheory.Functor.const (Opposite D)).obj M) ⟶ Q) ≃
        (M ⟶ Q.obj (Opposite.op W₀)) :=
    fun {D} _ {W₀} hW₀ Q =>
      { toFun := fun α => α.app (Opposite.op W₀)
        invFun := fun g =>
          { app := fun W => g ≫ Q.map (hW₀.from (Opposite.unop W)).op
            naturality := fun {W₁ W₂} f => by
              dsimp
              rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, ← Q.map_comp]
              congr 2
              exact congrArg Quiver.Hom.op (hW₀.hom_ext _ _) }
        left_inv := fun α => by
          apply CategoryTheory.NatTrans.ext
          funext W
          dsimp
          have hnat := α.naturality (hW₀.from (Opposite.unop W)).op
          dsimp at hnat
          rw [CategoryTheory.Category.id_comp] at hnat
          exact hnat.symm
        right_inv := fun g => by
          dsimp
          have hid : hW₀.from W₀ = 𝟙 W₀ := hW₀.hom_ext _ _
          rw [hid]
          change g ≫ Q.map (𝟙 (Opposite.op W₀)) = g
          rw [Q.map_id, CategoryTheory.Category.comp_id] }
  have hBij : ∀ (F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
      Function.Bijective (fun φ : FM₁ ⟶ F => cM ≫ φ) := by
    intro F
    let E₁ : (pb_h.obj FM₂ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op (B_h.obj T₂))) :=
      (adj_h.homEquiv FM₂ F).trans
        ((shAdj₂.homEquiv PM₂ (pf_h.obj F)).trans (constEv hT₂ (pf_h.obj F).obj))
    let e_map : F.obj.obj (Opposite.op T₁) ≅ F.obj.obj (Opposite.op (B_h.obj T₂)) :=
      F.obj.mapIso e_T.op
    let postIso : (M ⟶ F.obj.obj (Opposite.op T₁)) ≃
        (M ⟶ F.obj.obj (Opposite.op (B_h.obj T₂))) :=
      { toFun := fun g => g ≫ e_map.hom
        invFun := fun g => g ≫ e_map.inv
        left_inv := fun g => by
          dsimp only
          rw [CategoryTheory.Category.assoc, e_map.hom_inv_id, CategoryTheory.Category.comp_id]
        right_inv := fun g => by
          dsimp only
          rw [CategoryTheory.Category.assoc, e_map.inv_hom_id, CategoryTheory.Category.comp_id] }
    let E₂ : (FM₁ ⟶ F) ≃ (M ⟶ F.obj.obj (Opposite.op (B_h.obj T₂))) :=
      (shAdj₁.homEquiv PM₁ F).trans ((constEv hT₁ F.obj).trans postIso)
    have hE₁₂ : ∀ φ : FM₁ ⟶ F, E₁ (cM ≫ φ) = E₂ φ := by
      intro φ
      have h1a : (adj_h.homEquiv FM₂ F) (cM ≫ φ) =
          (adj_h.homEquiv FM₂ FM₁) cM ≫ pf_h.map φ :=
        CategoryTheory.Adjunction.homEquiv_naturality_right adj_h cM φ
      have h1b : (adj_h.homEquiv FM₂ FM₁) cM = uM :=
        (adj_h.homEquiv FM₂ FM₁).apply_symm_apply uM
      have h1 : (adj_h.homEquiv FM₂ F) (cM ≫ φ) = uM ≫ pf_h.map φ :=
        h1a.trans (congrArg (· ≫ pf_h.map φ) h1b)
      have h2a : (shAdj₂.homEquiv PM₂ (pf_h.obj F)) (uM ≫ pf_h.map φ) =
          (shAdj₂.homEquiv PM₂ (pf_h.obj FM₁)) uM ≫
            (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).map (pf_h.map φ) :=
        CategoryTheory.Adjunction.homEquiv_naturality_right shAdj₂ uM (pf_h.map φ)
      have h2b : (shAdj₂.homEquiv PM₂ (pf_h.obj FM₁)) uM = η₀ :=
        (shAdj₂.homEquiv PM₂ (pf_h.obj FM₁)).apply_symm_apply η₀
      have h2 : (shAdj₂.homEquiv PM₂ (pf_h.obj F)) ((adj_h.homEquiv FM₂ F) (cM ≫ φ)) =
          η₀ ≫ (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).map (pf_h.map φ) :=
        (congrArg (shAdj₂.homEquiv PM₂ (pf_h.obj F)) h1).trans
          (h2a.trans (congrArg (· ≫ _) h2b))
      have h3 : E₁ (cM ≫ φ) =
          (η₀ ≫ (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).map
            (pf_h.map φ)).app (Opposite.op T₂) :=
        congrArg (fun α => α.app (Opposite.op T₂)) h2
      let ψ : PM₁ ⟶ F.obj := (shAdj₁.homEquiv PM₁ F) φ
      have hψ : ψ = shAdj₁.unit.app PM₁ ≫ φ.hom :=
        CategoryTheory.Adjunction.homEquiv_unit shAdj₁ PM₁ F φ
      have h3' : (η₀ ≫ (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).map
          (pf_h.map φ)).app (Opposite.op T₂) = ψ.app (Opposite.op (B_h.obj T₂)) := by
        rw [hψ]
        rfl
      have hnat := ψ.naturality e_T.hom.op
      dsimp [PM₁] at hnat
      rw [CategoryTheory.Category.id_comp] at hnat
      exact (h3.trans h3').trans hnat
    have hEq : (fun φ : FM₁ ⟶ F => cM ≫ φ) = (E₂.trans E₁.symm) := by
      funext φ
      exact E₁.injective ((hE₁₂ φ).trans (E₁.apply_symm_apply (E₂ φ)).symm)
    rw [hEq]
    exact (E₂.trans E₁.symm).bijective
  obtain ⟨dM, h_cd⟩ := (hBij (pb_h.obj FM₂)).2 (𝟙 (pb_h.obj FM₂))
  dsimp only at h_cd
  have h_dc : dM ≫ cM = 𝟙 FM₁ := by
    apply (hBij FM₁).1
    dsimp only
    rw [← CategoryTheory.Category.assoc, h_cd, CategoryTheory.Category.id_comp,
      CategoryTheory.Category.comp_id]
  let e_const : CategoryTheory.Iso (pb_h.obj FM₂) FM₁ :=
    { hom := cM
      inv := dM
      hom_inv_id := h_cd
      inv_hom_id := h_dc }
  let L₁ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} := weilEtaleLocalTorsionSheaf Y₁ m U₁
  let L₂ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u} := weilEtaleLocalTorsionSheaf Y₂ m U₂
  have hEquiv_comp :
      ∀ {D : Type (u + 1)} [CategoryTheory.Category.{u, u + 1} D]
        (K : CategoryTheory.GrothendieckTopology D)
        [CategoryTheory.HasWeakSheafify K AddCommGrpCat.{u}]
        {W : D} {F G : CategoryTheory.Sheaf K AddCommGrpCat.{u}}
        (α : CategoryTheory.Sheaf.freeYoneda K W M ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro D _ K _ W F G α g
    let α' : (CategoryTheory.presheafToSheaf K AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W M) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction K AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction K AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf K AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _
  let postW : ∀ (G : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
      (M ⟶ G.obj.obj (Opposite.op (B_h.obj U₂))) ≃ (M ⟶ G.obj.obj (Opposite.op U₁)) :=
    fun G =>
      let e_w : G.obj.obj (Opposite.op (B_h.obj U₂)) ≅ G.obj.obj (Opposite.op U₁) :=
        G.obj.mapIso w_iso.op
      { toFun := fun ξ => ξ ≫ e_w.hom
        invFun := fun ζ => ζ ≫ e_w.inv
        left_inv := fun ξ => by
          dsimp only
          rw [CategoryTheory.Category.assoc, e_w.hom_inv_id, CategoryTheory.Category.comp_id]
        right_inv := fun ζ => by
          dsimp only
          rw [CategoryTheory.Category.assoc, e_w.inv_hom_id, CategoryTheory.Category.comp_id] }
  let Φ : ∀ (G : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}),
      (pb_h.obj L₂ ⟶ G) ≃ (L₁ ⟶ G) :=
    fun G =>
      (adj_h.homEquiv L₂ G).trans
        (CategoryTheory.Sheaf.freeYonedaHomEquiv.trans
          ((postW G).trans CategoryTheory.Sheaf.freeYonedaHomEquiv.symm))
  have hΦ_nat : ∀ {G G' : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}}
      (f : pb_h.obj L₂ ⟶ G) (ψ : G ⟶ G'),
      Φ G' (f ≫ ψ) = Φ G f ≫ ψ := by
    intro G G' f ψ
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    let ξ₀ := CategoryTheory.Sheaf.freeYonedaHomEquiv ((adj_h.homEquiv L₂ G) f)
    let ξ : M ⟶ G.obj.obj (Opposite.op (B_h.obj U₂)) := ξ₀
    have hL : CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ G' (f ≫ ψ)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv ((adj_h.homEquiv L₂ G') (f ≫ ψ)) ≫
          G'.obj.map w_iso.hom.op :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have hR₀ : CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ G f) =
        ξ ≫ G.obj.map w_iso.hom.op :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply (ξ ≫ G.obj.map w_iso.hom.op)
    have hR : CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ G f ≫ ψ) =
        (ξ ≫ G.obj.map w_iso.hom.op) ≫ ψ.hom.app (Opposite.op U₁) :=
      (hEquiv_comp J₁ (Φ G f) ψ).trans (congrArg (· ≫ ψ.hom.app (Opposite.op U₁)) hR₀)
    have h1a : CategoryTheory.Sheaf.freeYonedaHomEquiv ((adj_h.homEquiv L₂ G') (f ≫ ψ)) =
        ξ₀ ≫ (pf_h.map ψ).hom.app (Opposite.op U₂) :=
      (congrArg (fun x : L₂ ⟶ pf_h.obj G' => CategoryTheory.Sheaf.freeYonedaHomEquiv x)
        (CategoryTheory.Adjunction.homEquiv_naturality_right adj_h f ψ)).trans
        (hEquiv_comp J₂ ((adj_h.homEquiv L₂ G) f) (pf_h.map ψ))
    have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv ((adj_h.homEquiv L₂ G') (f ≫ ψ)) =
        ξ ≫ ψ.hom.app (Opposite.op (B_h.obj U₂)) := h1a
    exact hL.trans
      ((congrArg (fun g : M ⟶ G'.obj.obj (Opposite.op (B_h.obj U₂)) =>
            g ≫ G'.obj.map w_iso.hom.op) h1).trans
        ((CategoryTheory.Category.assoc ξ (ψ.hom.app (Opposite.op (B_h.obj U₂)))
            (G'.obj.map w_iso.hom.op)).trans
          ((congrArg (ξ ≫ ·) (ψ.hom.naturality w_iso.hom.op).symm).trans
            ((CategoryTheory.Category.assoc ξ (G.obj.map w_iso.hom.op)
                (ψ.hom.app (Opposite.op U₁))).symm.trans hR.symm))))
  let hom_loc : pb_h.obj L₂ ⟶ L₁ := (Φ L₁).symm (𝟙 L₁)
  let inv_loc : L₁ ⟶ pb_h.obj L₂ := Φ (pb_h.obj L₂) (𝟙 (pb_h.obj L₂))
  have hΦ_hom_loc : ∀ {G : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}} (ψ : L₁ ⟶ G),
      Φ G (hom_loc ≫ ψ) = ψ := by
    intro G ψ
    rw [hΦ_nat hom_loc ψ, (Φ L₁).apply_symm_apply, CategoryTheory.Category.id_comp]
  have h_hom_inv : hom_loc ≫ inv_loc = 𝟙 (pb_h.obj L₂) :=
    (Φ (pb_h.obj L₂)).injective (hΦ_hom_loc inv_loc)
  have h_inv_hom : inv_loc ≫ hom_loc = 𝟙 L₁ := by
    calc
      inv_loc ≫ hom_loc = Φ L₁ (hom_loc ≫ (inv_loc ≫ hom_loc)) :=
        (hΦ_hom_loc (inv_loc ≫ hom_loc)).symm
      _ = Φ L₁ ((hom_loc ≫ inv_loc) ≫ hom_loc) := by
        rw [CategoryTheory.Category.assoc]
      _ = Φ L₁ hom_loc := by
        rw [h_hom_inv, CategoryTheory.Category.id_comp]
      _ = 𝟙 L₁ := (Φ L₁).apply_symm_apply (𝟙 L₁)
  let e_loc : CategoryTheory.Iso (pb_h.obj L₂) L₁ :=
    { hom := hom_loc
      inv := inv_loc
      hom_inv_id := h_hom_inv
      inv_hom_id := h_inv_hom }
  let counit₂ : L₂ ⟶ FM₂ := weilEtaleLocalTorsionCounit Y₂ m U₂
  let counit₁ : L₁ ⟶ FM₁ := weilEtaleLocalTorsionCounit Y₁ m U₁
  have h_comm : pb_h.map counit₂ ≫ e_const.hom = e_loc.hom ≫ counit₁ := by
    apply (Φ FM₁).injective
    rw [hΦ_hom_loc counit₁]
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    let η₂_U : M ⟶ FM₂.obj.obj (Opposite.op U₂) :=
      (shAdj₂.unit.app PM₂).app (Opposite.op U₂)
    let η₁_BU : M ⟶ FM₁.obj.obj (Opposite.op (B_h.obj U₂)) :=
      (shAdj₁.unit.app PM₁).app (Opposite.op (B_h.obj U₂))
    let η₁_U : M ⟶ FM₁.obj.obj (Opposite.op U₁) :=
      (shAdj₁.unit.app PM₁).app (Opposite.op U₁)
    have hL : CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ FM₁ (pb_h.map counit₂ ≫ cM)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          ((adj_h.homEquiv L₂ FM₁) (pb_h.map counit₂ ≫ cM)) ≫
          FM₁.obj.map w_iso.hom.op :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have hR : CategoryTheory.Sheaf.freeYonedaHomEquiv counit₁ = η₁_U :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have hc₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv counit₂ = η₂_U :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.apply_symm_apply _
    have h_adj_left : (adj_h.homEquiv L₂ FM₁) (pb_h.map counit₂ ≫ cM) = counit₂ ≫ uM := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left]
      exact congrArg (counit₂ ≫ ·) ((adj_h.homEquiv FM₂ FM₁).apply_symm_apply uM)
    have h_uM_unit : shAdj₂.unit.app PM₂ ≫ uM.hom = η₀ := by
      have h1 := (shAdj₂.homEquiv PM₂ (pf_h.obj FM₁)).apply_symm_apply η₀
      have h2 := CategoryTheory.Adjunction.homEquiv_unit shAdj₂ PM₂ (pf_h.obj FM₁) uM
      exact h2.symm.trans h1
    have h_uM_app : η₂_U ≫ uM.hom.app (Opposite.op U₂) = η₁_BU :=
      congrArg (fun α => α.app (Opposite.op U₂)) h_uM_unit
    have h_counit_uM : CategoryTheory.Sheaf.freeYonedaHomEquiv (counit₂ ≫ uM) = η₁_BU :=
      (hEquiv_comp J₂ counit₂ uM).trans
        ((congrArg (· ≫ uM.hom.app (Opposite.op U₂)) hc₂).trans h_uM_app)
    have h_unit_nat : η₁_BU ≫ FM₁.obj.map w_iso.hom.op = η₁_U := by
      have hnat := ((shAdj₁.unit.app PM₁).naturality w_iso.hom.op).symm
      dsimp [PM₁] at hnat
      rwa [CategoryTheory.Category.id_comp] at hnat
    have h_lhs_BU :
        CategoryTheory.Sheaf.freeYonedaHomEquiv
          ((adj_h.homEquiv L₂ FM₁) (pb_h.map counit₂ ≫ cM)) = η₁_BU :=
      (congrArg (fun x : L₂ ⟶ pf_h.obj FM₁ => CategoryTheory.Sheaf.freeYonedaHomEquiv x)
        h_adj_left).trans h_counit_uM
    exact hL.trans
      ((congrArg (fun g : M ⟶ FM₁.obj.obj (Opposite.op (B_h.obj U₂)) =>
          g ≫ FM₁.obj.map w_iso.hom.op) h_lhs_BU).trans
        (h_unit_nat.trans hR.symm))
  exact ⟨e_loc, e_const, h_comm⟩

theorem weil_algClosed_affine_etale_base_fiber_localTorsion_split (k : Type u) [Field k] [IsAlgClosed k]
    (m : ℕ) (hm : 1 ≤ m)
    (Y : AlgebraicGeometry.Scheme.{u})
    (V₀ : (AlgebraicGeometry.Spec (CommRingCat.of k)).Etale)
    [AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget
        (AlgebraicGeometry.Spec (CommRingCat.of k))).obj V₀).left]
    (U₀ : Y.Etale)
    (π₀ : Quiver.Hom ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U₀).left
      ((AlgebraicGeometry.Scheme.Etale.forget
        (AlgebraicGeometry.Spec (CommRingCat.of k))).obj V₀).left) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k := weilEtaleIdTerminal S_k
    let W_V₀ := ((AlgebraicGeometry.Scheme.Etale.forget S_k).obj V₀).left
    let p_V₀ := ((AlgebraicGeometry.Scheme.Etale.forget S_k).obj V₀).hom
    let p_U₀ := ((AlgebraicGeometry.Scheme.Etale.forget Y).obj U₀).hom
    (∀ (b : ℕ),
      (∀ (s : Quiver.Hom S_k W_V₀),
        CategoryTheory.CategoryStruct.comp s p_V₀ = CategoryTheory.CategoryStruct.id S_k →
        ∀ (hEt_s : AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst π₀ s) p_U₀)),
          Subsingleton (weilEtaleLocalTorsionH Y m
            (CategoryTheory.MorphismProperty.Over.mk ⊤
              (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst π₀ s) p_U₀)
              hEt_s) b)) →
      Subsingleton (weilEtaleLocalTorsionH Y m U₀ b)) ∧
    (∀ (b : ℕ),
      (∀ (s : Quiver.Hom S_k W_V₀),
        CategoryTheory.CategoryStruct.comp s p_V₀ = CategoryTheory.CategoryStruct.id S_k →
        ∀ (hEt_s : AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst π₀ s) p_U₀)),
          Nat.card (weilEtaleLocalTorsionH Y m
            (CategoryTheory.MorphismProperty.Over.mk ⊤
              (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.fst π₀ s) p_U₀)
              hEt_s) b) = m) →
      Finite (weilEtaleLocalTorsionH Y m U₀ b) ∧
      Nat.card (weilEtaleLocalTorsionH Y m U₀ b) =
        Nat.card ↑((weilEtaleLocalTorsionSheaf S_k m V₀).obj.obj (Opposite.op T_k))) :=
by
  classical
  intro S_k T_k W_V₀ p_V₀ p_U₀
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let pt_k₀ : PrimeSpectrum k := ⟨RingHom.ker (RingHom.id k), RingHom.ker_isPrime (RingHom.id k)⟩

  
  have hEquiv_comp :
      ∀ {Z : AlgebraicGeometry.Scheme.{u}} {W : Z.Etale}
        {F G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (α : CategoryTheory.Sheaf.freeYoneda Z.smallEtaleTopology W AM ⟶ F)
        (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) := by
    intro Z W F G α g
    let α' : (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf Z.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  
  have hCover_Sk :
      ∀ (W : S_k.Etale),
        let W_sch := ((AlgebraicGeometry.Scheme.Etale.forget S_k).obj W).left
        let p_W := ((AlgebraicGeometry.Scheme.Etale.forget S_k).obj W).hom
        ∀ [AlgebraicGeometry.IsAffine W_sch],
        ∃ (n : ℕ) (s : Fin n → Quiver.Hom S_k W_sch),
          (∀ i : Fin n, CategoryTheory.CategoryStruct.comp (s i) p_W =
            CategoryTheory.CategoryStruct.id S_k) ∧
          (∀ i : Fin n, AlgebraicGeometry.IsOpenImmersion (s i)) ∧
          (∀ i j : Fin n, i ≠ j → Disjoint (Set.range ⇑(s i)) (Set.range ⇑(s j))) ∧
          (∀ x : ↥W_sch, ∃ i : Fin n, x ∈ Set.range ⇑(s i)) := by
    intro W W_sch p_W hAff_W
    have hEt_pW : AlgebraicGeometry.Etale p_W := W.prop
    let R₀ : CommRingCat.{u} := W_sch.presheaf.obj (Opposite.op ⊤)
    let e₀ : W_sch ≅ AlgebraicGeometry.Spec R₀ := W_sch.isoSpec
    let φ₀ : CommRingCat.of k ⟶ R₀ := AlgebraicGeometry.Spec.preimage (e₀.inv ≫ p_W)
    have hSpec_φ₀ : AlgebraicGeometry.Spec.map φ₀ = e₀.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e₀.inv ≫ p_W)
    have hEt_map : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ₀) := by
      rw [hSpec_φ₀]
      infer_instance
    have hEt_hom : RingHom.Etale φ₀.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_map
    let _ : Algebra k ↑R₀ := φ₀.hom.toAlgebra
    have hAlgEt : Algebra.Etale k ↑R₀ := RingHom.etale_algebraMap.mp hEt_hom
    obtain ⟨I, hFinI, A_I, hFieldA, hAlgA, ψ_I, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k ↑R₀).mp hAlgEt
    let _ : Finite I := hFinI
    let _ : ∀ a : I, Field (A_I a) := hFieldA
    let _ : ∀ a : I, Algebra k (A_I a) := hAlgA
    have hBijA : ∀ a : I, Function.Bijective (algebraMap k (A_I a)) := by
      intro a
      have : Module.Finite k (A_I a) := (hFinSep a).1
      have : Algebra.IsIntegral k (A_I a) := Algebra.IsIntegral.of_finite k (A_I a)
      exact IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := A_I a)
    let θ : ∀ a : I, A_I a ≃ₐ[k] k :=
      fun a => (AlgEquiv.ofBijective (Algebra.ofId k (A_I a)) (hBijA a)).symm
    let _ : Fintype I := Fintype.ofFinite I
    let n : ℕ := Fintype.card I
    let κ : I ≃ Fin n := Fintype.equivFin I
    let Ψ : ↑R₀ ≃ₐ[k] (Fin n → k) :=
      { toFun := fun r i => θ (κ.symm i) (ψ_I r (κ.symm i))
        invFun := fun f => ψ_I.symm (fun a => (θ a).symm (f (κ a)))
        left_inv := fun r => by
          dsimp only
          have h1 : (fun a : I => (θ a).symm (θ (κ.symm (κ a)) (ψ_I r (κ.symm (κ a))))) = ψ_I r := by
            funext a
            rw [κ.symm_apply_apply, AlgEquiv.symm_apply_apply]
          rw [h1, ψ_I.symm_apply_apply]
        right_inv := fun f => by
          dsimp only
          funext i
          rw [ψ_I.apply_symm_apply, AlgEquiv.apply_symm_apply, κ.apply_symm_apply]
        map_mul' := fun x y => by
          funext i
          simp [map_mul]
        map_add' := fun x y => by
          funext i
          simp [map_add]
        commutes' := fun c => by
          funext i
          have hc : ψ_I (algebraMap k ↑R₀ c) (κ.symm i) = algebraMap k (A_I (κ.symm i)) c := by
            rw [ψ_I.commutes]
            rfl
          rw [hc, (θ (κ.symm i)).commutes]
          rfl }
    let ev : ∀ i : Fin n, ↑R₀ →ₐ[k] k :=
      fun i => (Pi.evalAlgHom k (fun _ : Fin n => k) i).comp Ψ.toAlgHom
    let e_idemp : Fin n → ↑R₀ :=
      fun i => Ψ.symm (Pi.single i (1 : k))
    let s : Fin n → Quiver.Hom S_k W_sch :=
      fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev i).toRingHom) ≫ e₀.inv
    have hev_same : ∀ i : Fin n, ev i (e_idemp i) = 1 := by
      intro i
      change Ψ (Ψ.symm (Pi.single i (1 : k))) i = 1
      rw [Ψ.apply_symm_apply, Pi.single_eq_same]
    have hev_ne : ∀ (i j : Fin n), i ≠ j → ev j (e_idemp i) = 0 := by
      intro i j hij
      change Ψ (Ψ.symm (Pi.single i (1 : k))) j = 0
      rw [Ψ.apply_symm_apply, Pi.single_eq_of_ne (Ne.symm hij)]
    refine ⟨n, s, ?_, ?_, ?_, ?_⟩
    · intro i
      have hφ_ev : φ₀ ≫ CommRingCat.ofHom (ev i).toRingHom = 𝟙 (CommRingCat.of k) := by
        apply CommRingCat.hom_ext
        ext c
        exact (ev i).commutes c
      change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev i).toRingHom) ≫ e₀.inv) ≫ p_W =
        𝟙 S_k
      rw [CategoryTheory.Category.assoc, ← hSpec_φ₀, ← AlgebraicGeometry.Spec.map_comp,
        hφ_ev, AlgebraicGeometry.Spec.map_id]
    · intro i
      let alg_i : Algebra (↑R₀) k := (ev i).toRingHom.toAlgebra
      have hLoc : @IsLocalization.Away (↑R₀) _ (e_idemp i) k _ alg_i := by
        letI : Algebra (↑R₀) k := alg_i
        change IsLocalization (Submonoid.powers (e_idemp i)) k
        refine ⟨?_, ?_, ?_⟩
        · rintro ⟨_, m_pow, rfl⟩
          have h1 : (ev i).toRingHom (e_idemp i) = 1 := hev_same i
          change IsUnit ((ev i).toRingHom (e_idemp i ^ m_pow))
          rw [map_pow, h1, one_pow]
          exact isUnit_one
        · intro z
          refine ⟨⟨Ψ.symm (Pi.single i z), 1⟩, ?_⟩
          have h_z : algebraMap (↑R₀) k (Ψ.symm (Pi.single i z)) = z := by
            change Ψ (Ψ.symm (Pi.single i z)) i = z
            rw [Ψ.apply_symm_apply, Pi.single_eq_same]
          simp [h_z]
        · intro x₁ x₂ hx
          refine ⟨⟨e_idemp i, Submonoid.mem_powers (e_idemp i)⟩, ?_⟩
          apply Ψ.injective
          funext j
          have hx' : Ψ x₁ i = Ψ x₂ i := hx
          simp only [map_mul, Pi.mul_apply, e_idemp, Ψ.apply_symm_apply]
          by_cases hji : j = i
          · subst hji
            simp [Pi.single_eq_same, hx']
          · simp [Pi.single_eq_of_ne hji]
      have hOpen_map : AlgebraicGeometry.IsOpenImmersion
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev i).toRingHom)) :=
        @AlgebraicGeometry.IsOpenImmersion.of_isLocalization (↑R₀) k _ _ alg_i (e_idemp i) hLoc
      exact CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.IsOpenImmersion) _ _
        hOpen_map (inferInstance : AlgebraicGeometry.IsOpenImmersion e₀.inv)
    · intro i j hij
      rw [Set.disjoint_left]
      rintro x ⟨p₁, rfl⟩ ⟨p₂, hp₂⟩
      have h_inv_inj : ∀ y₁ y₂ : ↥(AlgebraicGeometry.Spec R₀),
          e₀.inv.base y₁ = e₀.inv.base y₂ → y₁ = y₂ := by
        intro y₁ y₂ hy
        have h1 : (e₀.inv ≫ e₀.hom).base y₁ = (e₀.inv ≫ e₀.hom).base y₂ :=
          congrArg e₀.hom.base hy
        rwa [e₀.inv_hom_id] at h1
      have heq_spec :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev i).toRingHom)).base p₁ =
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev j).toRingHom)).base p₂ :=
        h_inv_inj _ _ hp₂.symm
      rw [AlgebraicGeometry.Spec.map_apply, AlgebraicGeometry.Spec.map_apply] at heq_spec
      have hmem_j : e_idemp i ∈
          (PrimeSpectrum.comap (CommRingCat.ofHom (ev j).toRingHom).hom p₂).asIdeal := by
        change (ev j) (e_idemp i) ∈ p₂.asIdeal
        rw [hev_ne i j hij]
        exact p₂.asIdeal.zero_mem
      rw [← heq_spec] at hmem_j
      have hmem_i : (1 : k) ∈ p₁.asIdeal := by
        rw [← hev_same i]
        exact hmem_j
      exact p₁.isPrime.ne_top (p₁.asIdeal.eq_top_of_isUnit_mem hmem_i isUnit_one)
    · intro x
      let p : PrimeSpectrum ↑R₀ := e₀.hom.base x
      have hsum_one : (∑ i : Fin n, e_idemp i) = 1 := by
        apply Ψ.injective
        funext j
        rw [map_sum, map_one, Finset.sum_apply, Pi.one_apply]
        have hterm : ∀ i : Fin n, Ψ (e_idemp i) j = (Pi.single i (1 : k) : Fin n → k) j := by
          intro i
          dsimp [e_idemp]
          rw [Ψ.apply_symm_apply]
        simp_rw [hterm]
        rw [Finset.sum_eq_single j]
        · simp [Pi.single_eq_same]
        · intro i _ hij
          simp [Pi.single_eq_of_ne (Ne.symm hij)]
        · intro hj
          exact False.elim (hj (Finset.mem_univ j))
      have hex_not_mem : ∃ i : Fin n, e_idemp i ∉ p.asIdeal := by
        by_contra hall
        simp only [not_exists, not_not] at hall
        have h1_mem : (1 : ↑R₀) ∈ p.asIdeal := by
          rw [← hsum_one]
          exact Submodule.sum_mem p.asIdeal (fun i _ => hall i)
        exact p.isPrime.ne_top (p.asIdeal.eq_top_of_isUnit_mem h1_mem isUnit_one)
      obtain ⟨i, hi_not_mem⟩ := hex_not_mem
      have hp_eq : PrimeSpectrum.comap (CommRingCat.ofHom (ev i).toRingHom).hom pt_k₀ = p := by
        ext r
        change ev i r = 0 ↔ r ∈ p.asIdeal
        let c : k := ev i r
        have hmul_zero : e_idemp i * (r - algebraMap k (↑R₀) c) = 0 := by
          apply Ψ.injective
          funext j
          rw [map_zero, Pi.zero_apply, map_mul, Pi.mul_apply, map_sub, Pi.sub_apply]
          dsimp [e_idemp]
          rw [Ψ.apply_symm_apply]
          by_cases hji : j = i
          · subst hji
            have hc_eq : Ψ (algebraMap k (↑R₀) c) j = c := by
              rw [Ψ.commutes]
              rfl
            have hr_eq : Ψ r j = c := rfl
            rw [Pi.single_eq_same, one_mul, hr_eq, hc_eq, sub_self]
          · rw [Pi.single_eq_of_ne hji, zero_mul]
        have hsub_mem : r - algebraMap k (↑R₀) c ∈ p.asIdeal := by
          have hprod_mem : e_idemp i * (r - algebraMap k (↑R₀) c) ∈ p.asIdeal := by
            rw [hmul_zero]
            exact p.asIdeal.zero_mem
          exact (p.isPrime.mem_or_mem hprod_mem).resolve_left hi_not_mem
        constructor
        · intro hc0
          have halg0 : algebraMap k (↑R₀) c = 0 := by
            change algebraMap k (↑R₀) (ev i r) = 0
            rw [hc0, map_zero]
          rw [halg0, sub_zero] at hsub_mem
          exact hsub_mem
        · intro hr_mem
          have halg_mem : algebraMap k (↑R₀) c ∈ p.asIdeal := by
            have hdiff := p.asIdeal.sub_mem hr_mem hsub_mem
            simpa using hdiff
          by_contra hc_ne
          have hunit : IsUnit (algebraMap k (↑R₀) c) := (IsUnit.mk0 c hc_ne).map _
          exact p.isPrime.ne_top (p.asIdeal.eq_top_of_isUnit_mem halg_mem hunit)
      have hmap_pt :
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev i).toRingHom)).base pt_k₀ =
            e₀.hom.base x :=
        (AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (ev i).toRingHom) pt_k₀).trans hp_eq
      refine ⟨i, pt_k₀, ?_⟩
      change e₀.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev i).toRingHom)).base pt_k₀) = x
      rw [hmap_pt]
      change (e₀.hom ≫ e₀.inv).base x = x
      rw [e₀.hom_inv_id]
      rfl

  
  have hBiprod :
      ∀ (Z : AlgebraicGeometry.Scheme.{u}) (U : Z.Etale) (n : ℕ)
        (U_fam : Fin n → Z.Etale) (u : ∀ i : Fin n, Quiver.Hom (U_fam i) U),
        let Fgt := AlgebraicGeometry.Scheme.Etale.forget Z
        (∀ i : Fin n, AlgebraicGeometry.IsOpenImmersion ((Fgt.map (u i)).left)) →
        (∀ i j : Fin n, i ≠ j →
          Disjoint (Set.range ⇑((Fgt.map (u i)).left)) (Set.range ⇑((Fgt.map (u j)).left))) →
        (∀ x : ↥((Fgt.obj U).left), ∃ i : Fin n, x ∈ Set.range ⇑((Fgt.map (u i)).left)) →
        (∀ W₀ : Z.Etale,
          Nonempty (↑((weilEtaleLocalTorsionSheaf Z m U).obj.obj (Opposite.op W₀)) ≃+
            ((i : Fin n) →
              ↑((weilEtaleLocalTorsionSheaf Z m (U_fam i)).obj.obj (Opposite.op W₀))))) ∧
        (∀ b : ℕ,
          Nonempty (weilEtaleLocalTorsionH Z m U b ≃+
            ((i : Fin n) → weilEtaleLocalTorsionH Z m (U_fam i) b))) := by
    intro Z U n U_fam u Fgt hOpen hDisj hCov
    let J_Z := Z.smallEtaleTopology
    let _ : CategoryTheory.Limits.HasFiniteBiproducts
        (CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}) :=
      CategoryTheory.Abelian.hasFiniteBiproducts

    
    let homZToElem : ∀ {M : AddCommGrpCat.{u}}, (Aℤ ⟶ M) → ↑M :=
      fun φ => φ.hom (ULift.up (1 : ℤ))
    let elemToHomZ : ∀ {M : AddCommGrpCat.{u}}, ↑M → (Aℤ ⟶ M) :=
      fun x => AddCommGrpCat.ofHom
        { toFun := fun z => z.down • x
          map_zero' := zero_zsmul x
          map_add' := fun a b => add_zsmul x a.down b.down }
    have hHomZ_left : ∀ {M : AddCommGrpCat.{u}} (φ : Aℤ ⟶ M), elemToHomZ (homZToElem φ) = φ := by
      intro M φ
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro z
      have hz : z = z.down • ULift.up (1 : ℤ) := by
        apply ULift.ext
        change z.down = z.down • (1 : ℤ)
        simp
      change z.down • φ.hom (ULift.up (1 : ℤ)) = φ.hom z
      rw [← map_zsmul φ.hom z.down (ULift.up (1 : ℤ)), ← hz]
    have hHomZ_right : ∀ {M : AddCommGrpCat.{u}} (x : ↑M), homZToElem (elemToHomZ x) = x := by
      intro M x
      change (1 : ℤ) • x = x
      exact one_zsmul x

    
    have hEmpty_sub :
        ∀ (G : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}) (V : Z.Etale),
          IsEmpty ↥((Fgt.obj V).left) →
          Subsingleton (Aℤ ⟶ G.obj.obj (Opposite.op V)) := by
      intro G V hEmp
      let bot_V : CategoryTheory.Sieve V := ⊥
      have hBot_mem : bot_V ∈ J_Z V := by
        have hEq := congrArg (fun J : CategoryTheory.GrothendieckTopology Z.Etale =>
            bot_V ∈ J V)
          (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
            (S := Z) (P := P_et) (Q := P_et) (le_refl P_et))
        exact (iff_of_eq hEq).mpr
          ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
            (P := P_et) (Q := P_et) V bot_V).mpr
            (fun x => hEmp.elim x))
      have hGen_bot : CategoryTheory.Sieve.generate (⊥ : CategoryTheory.Presieve V) ∈ J_Z V := by
        rwa [CategoryTheory.Sieve.generate_bot]
      have hFor_bot := (G.property Aℤ).isSheafFor (⊥ : CategoryTheory.Presieve V) hGen_bot
      refine ⟨fun φ₁ φ₂ => hFor_bot.isSeparatedFor.ext (fun _ _ hf => False.elim hf)⟩

    
    let S_cov : CategoryTheory.Sieve U :=
      { arrows := fun {V} g => ∃ (i : Fin n) (ℓ : V ⟶ U_fam i), ℓ ≫ u i = g
        downward_closed := by
          rintro V W g ⟨i, ℓ, rfl⟩ h
          exact ⟨i, h ≫ ℓ, CategoryTheory.Category.assoc h ℓ (u i)⟩ }
    have hScov_mem : S_cov ∈ J_Z U := by
      have hEq := congrArg (fun J : CategoryTheory.GrothendieckTopology Z.Etale => S_cov ∈ J U)
        (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (S := Z) (P := P_et) (Q := P_et) (le_refl P_et))
      refine (iff_of_eq hEq).mpr
        ((AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) U S_cov).mpr ?_)
      intro x
      obtain ⟨i, y, hy⟩ := hCov x
      have hOpen_i : AlgebraicGeometry.IsOpenImmersion ((Fgt.map (u i)).left) := hOpen i
      have hEt_ui : P_et (u i).left := by
        change AlgebraicGeometry.Etale ((Fgt.map (u i)).left)
        infer_instance
      exact ⟨U_fam i, u i, y, ⟨i, 𝟙 (U_fam i), CategoryTheory.Category.id_comp (u i)⟩,
        hEt_ui, hy⟩
    have hScov_gen : CategoryTheory.Sieve.generate S_cov.arrows ∈ J_Z U := by
      rwa [CategoryTheory.Sieve.generate_sieve]

    
    have hRes_bij :
        ∀ (G : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}),
          Function.Bijective
            (fun (x : ↑(G.obj.obj (Opposite.op U))) (i : Fin n) =>
              (G.obj.map (Opposite.op (u i))).hom x) := by
      intro G
      have hFor := (G.property Aℤ).isSheafFor S_cov.arrows hScov_gen
      have hWellDef :
          ∀ (t : ∀ i : Fin n, Aℤ ⟶ G.obj.obj (Opposite.op (U_fam i)))
            {V : Z.Etale} (g : V ⟶ U)
            (i₁ : Fin n) (ℓ₁ : V ⟶ U_fam i₁)
            (i₂ : Fin n) (ℓ₂ : V ⟶ U_fam i₂),
            ℓ₁ ≫ u i₁ = g → ℓ₂ ≫ u i₂ = g →
            t i₁ ≫ G.obj.map (Opposite.op ℓ₁) = t i₂ ≫ G.obj.map (Opposite.op ℓ₂) := by
        intro t V g i₁ ℓ₁ i₂ ℓ₂ h₁ h₂
        by_cases h_idx : i₁ = i₂
        · subst h_idx
          have : AlgebraicGeometry.IsOpenImmersion ((Fgt.map (u i₁)).left) := hOpen i₁
          have : CategoryTheory.Mono ((Fgt.map (u i₁)).left) := inferInstance
          have hleft_eq : (Fgt.map ℓ₁).left ≫ (Fgt.map (u i₁)).left =
              (Fgt.map ℓ₂).left ≫ (Fgt.map (u i₁)).left := by
            have hc := h₁.trans h₂.symm
            exact congrArg (fun f => (Fgt.map f).left) hc
          have hℓ_left : (Fgt.map ℓ₁).left = (Fgt.map ℓ₂).left :=
            (cancel_mono ((Fgt.map (u i₁)).left)).mp hleft_eq
          have hℓ_eq : ℓ₁ = ℓ₂ :=
            CategoryTheory.MorphismProperty.Comma.Hom.ext hℓ_left (Subsingleton.elim _ _)
          rw [hℓ_eq]
        · have hEmp : IsEmpty ↥((Fgt.obj V).left) := by
            refine ⟨fun v => ?_⟩
            have hv₁ : ((Fgt.map g).left) v ∈ Set.range ⇑((Fgt.map (u i₁)).left) := by
              rw [← h₁]
              exact ⟨((Fgt.map ℓ₁).left) v, rfl⟩
            have hv₂ : ((Fgt.map g).left) v ∈ Set.range ⇑((Fgt.map (u i₂)).left) := by
              rw [← h₂]
              exact ⟨((Fgt.map ℓ₂).left) v, rfl⟩
            exact Set.disjoint_left.mp (hDisj i₁ i₂ h_idx) hv₁ hv₂
          have : Subsingleton (Aℤ ⟶ G.obj.obj (Opposite.op V)) := hEmpty_sub G V hEmp
          exact Subsingleton.elim _ _
      refine ⟨?_, ?_⟩
      · intro x₁ x₂ hx
        have hφ_eq : elemToHomZ x₁ = elemToHomZ x₂ := by
          refine hFor.isSeparatedFor.ext ?_
          rintro V g ⟨i, ℓ, rfl⟩
          have hi : elemToHomZ ((G.obj.map (Opposite.op (u i))).hom x₁) =
              elemToHomZ ((G.obj.map (Opposite.op (u i))).hom x₂) :=
            congrArg elemToHomZ (congrFun hx i)
          have hcomp : ∀ x : ↑(G.obj.obj (Opposite.op U)),
              elemToHomZ x ≫ G.obj.map (Opposite.op (ℓ ≫ u i)) =
                elemToHomZ ((G.obj.map (Opposite.op (u i))).hom x) ≫ G.obj.map (Opposite.op ℓ) := by
            intro x
            have hop : Opposite.op (ℓ ≫ u i) =
                (Opposite.op (u i) ≫ Opposite.op ℓ : Opposite.op U ⟶ Opposite.op V) := rfl
            rw [hop, G.obj.map_comp, ← CategoryTheory.Category.assoc]
            congr 1
            have h1 : homZToElem (elemToHomZ x ≫ G.obj.map (Opposite.op (u i))) =
                (G.obj.map (Opposite.op (u i))).hom x := by
              change (G.obj.map (Opposite.op (u i))).hom (homZToElem (elemToHomZ x)) = _
              rw [hHomZ_right]
            rw [← h1, hHomZ_left]
          change elemToHomZ x₁ ≫ G.obj.map (Opposite.op (ℓ ≫ u i)) =
            elemToHomZ x₂ ≫ G.obj.map (Opposite.op (ℓ ≫ u i))
          rw [hcomp x₁, hcomp x₂, hi]
        calc
          x₁ = homZToElem (elemToHomZ x₁) := (hHomZ_right x₁).symm
          _ = homZToElem (elemToHomZ x₂) := congrArg homZToElem hφ_eq
          _ = x₂ := hHomZ_right x₂
      · intro y
        let t : ∀ i : Fin n, Aℤ ⟶ G.obj.obj (Opposite.op (U_fam i)) :=
          fun i => elemToHomZ (y i)
        let fam : CategoryTheory.Presieve.FamilyOfElements
            (G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op Aℤ)) S_cov.arrows :=
          fun V g hg =>
            let i := Classical.choose hg
            let ℓ := Classical.choose (Classical.choose_spec hg)
            t i ≫ G.obj.map (Opposite.op ℓ)
        have hfam_eq : ∀ {V : Z.Etale} (g : V ⟶ U) (hg : S_cov.arrows g)
            (i : Fin n) (ℓ : V ⟶ U_fam i), ℓ ≫ u i = g →
            fam g hg = t i ≫ G.obj.map (Opposite.op ℓ) := by
          intro V g hg i ℓ hℓ
          exact hWellDef t g _ _ i ℓ
            (Classical.choose_spec (Classical.choose_spec hg)) hℓ
        have hCompat : CategoryTheory.Presieve.FamilyOfElements.Compatible fam := by
          rw [CategoryTheory.Presieve.compatible_iff_sieveCompatible]
          intro V W f g hf
          obtain ⟨i, ℓ, hℓ⟩ := id hf
          have hgf : S_cov.arrows (g ≫ f) := S_cov.downward_closed hf g
          rw [hfam_eq f hf i ℓ hℓ,
            hfam_eq (g ≫ f) hgf i (g ≫ ℓ)
              ((CategoryTheory.Category.assoc g ℓ (u i)).trans (congrArg (g ≫ ·) hℓ))]
          have hop : Opposite.op (g ≫ ℓ) =
              (Opposite.op ℓ ≫ Opposite.op g : Opposite.op (U_fam i) ⟶ Opposite.op W) := rfl
          change t i ≫ G.obj.map (Opposite.op (g ≫ ℓ)) =
            (t i ≫ G.obj.map (Opposite.op ℓ)) ≫ G.obj.map (Opposite.op g)
          rw [hop, G.obj.map_comp, CategoryTheory.Category.assoc]
        let φ_amalg := hFor.amalgamate fam hCompat
        refine ⟨homZToElem φ_amalg, ?_⟩
        funext i
        have hui : S_cov.arrows (u i) := ⟨i, 𝟙 (U_fam i), CategoryTheory.Category.id_comp (u i)⟩
        have hglue : φ_amalg ≫ G.obj.map (Opposite.op (u i)) = fam (u i) hui :=
          hFor.valid_glue hCompat (u i) hui
        rw [hfam_eq (u i) hui i (𝟙 (U_fam i)) (CategoryTheory.Category.id_comp (u i))] at hglue
        have hop_id : Opposite.op (𝟙 (U_fam i)) = 𝟙 (Opposite.op (U_fam i)) := rfl
        rw [hop_id, G.obj.map_id, CategoryTheory.Category.comp_id] at hglue
        have heval := congrArg homZToElem hglue
        change (G.obj.map (Opposite.op (u i))).hom (homZToElem φ_amalg) = homZToElem (t i) at heval
        rwa [hHomZ_right] at heval

    
    let L_U := weilEtaleLocalTorsionSheaf Z m U
    let L_fam : Fin n → CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} :=
      fun i => weilEtaleLocalTorsionSheaf Z m (U_fam i)
    let B : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u} := ⨁ L_fam
    let Φ_sum : B ⟶ L_U :=
      CategoryTheory.Limits.biproduct.desc (fun i : Fin n => weilEtaleLocalTorsionMap Z m (u i))
    let res_B_hom : ↑(B.obj.obj (Opposite.op U)) →+
        ((i : Fin n) → ↑(B.obj.obj (Opposite.op (U_fam i)))) :=
      AddMonoidHom.pi (fun i => (B.obj.map (Opposite.op (u i))).hom)
    let e_res_B : ↑(B.obj.obj (Opposite.op U)) ≃+
        ((i : Fin n) → ↑(B.obj.obj (Opposite.op (U_fam i)))) :=
      AddEquiv.ofBijective res_B_hom (hRes_bij B)
    let ι_gen : ∀ i : Fin n, AM ⟶ B.obj.obj (Opposite.op (U_fam i)) :=
      fun i => CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.Limits.biproduct.ι L_fam i)
    let Ξ : AM ⟶ B.obj.obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        (e_res_B.symm.toAddMonoidHom.comp (AddMonoidHom.pi (fun i => (ι_gen i).hom)))
    let Ψ_inv : L_U ⟶ B := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm Ξ
    have hΨ_equiv : CategoryTheory.Sheaf.freeYonedaHomEquiv Ψ_inv = Ξ :=
      Equiv.apply_symm_apply _ _
    have hΞ_proj : ∀ i : Fin n, Ξ ≫ B.obj.map (Opposite.op (u i)) = ι_gen i := by
      intro i
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro a
      have happ : e_res_B (Ξ.hom a) = fun j : Fin n => (ι_gen j).hom a :=
        e_res_B.apply_symm_apply _
      exact congrFun happ i
    have hΦΨ : Φ_sum ≫ Ψ_inv = 𝟙 B := by
      apply CategoryTheory.Limits.biproduct.hom_ext'
      intro i
      rw [CategoryTheory.Category.comp_id, ← CategoryTheory.Category.assoc,
        CategoryTheory.Limits.biproduct.ι_desc]
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquiv_comp]
      have hmap_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap Z m (u i)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ L_U.obj.map (Opposite.op (u i)) :=
        Equiv.apply_symm_apply _ _
      have hnat_i : L_U.obj.map (Opposite.op (u i)) ≫ Ψ_inv.hom.app (Opposite.op (U_fam i)) =
          Ψ_inv.hom.app (Opposite.op U) ≫ B.obj.map (Opposite.op (u i)) :=
        Ψ_inv.hom.naturality (Opposite.op (u i))
      rw [hmap_eq, CategoryTheory.Category.assoc, hnat_i,
        ← CategoryTheory.Category.assoc, ← hEquiv_comp (𝟙 L_U) Ψ_inv,
        CategoryTheory.Category.id_comp, hΨ_equiv, hΞ_proj i]
    have hΨΦ : Ψ_inv ≫ Φ_sum = 𝟙 L_U := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hEquiv_comp, hΨ_equiv]
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro a
      apply (hRes_bij L_U).1
      funext i
      change (L_U.obj.map (Opposite.op (u i))).hom ((Φ_sum.hom.app (Opposite.op U)).hom (Ξ.hom a)) =
        (L_U.obj.map (Opposite.op (u i))).hom
          ((CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U)).hom a)
      have hnat : (L_U.obj.map (Opposite.op (u i))).hom
          ((Φ_sum.hom.app (Opposite.op U)).hom (Ξ.hom a)) =
          (Φ_sum.hom.app (Opposite.op (U_fam i))).hom
            ((B.obj.map (Opposite.op (u i))).hom (Ξ.hom a)) := by
        change (Φ_sum.hom.app (Opposite.op U) ≫ L_U.obj.map (Opposite.op (u i))).hom (Ξ.hom a) =
          (B.obj.map (Opposite.op (u i)) ≫ Φ_sum.hom.app (Opposite.op (U_fam i))).hom (Ξ.hom a)
        rw [Φ_sum.hom.naturality (Opposite.op (u i))]
      rw [hnat]
      have hproj_a : (B.obj.map (Opposite.op (u i))).hom (Ξ.hom a) = (ι_gen i).hom a := by
        change (Ξ ≫ B.obj.map (Opposite.op (u i))).hom a = (ι_gen i).hom a
        rw [hΞ_proj i]
      rw [hproj_a]
      change (ι_gen i ≫ Φ_sum.hom.app (Opposite.op (U_fam i))).hom a =
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ L_U.obj.map (Opposite.op (u i))).hom a
      have hdesc_i : ι_gen i ≫ Φ_sum.hom.app (Opposite.op (U_fam i)) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ L_U.obj.map (Opposite.op (u i)) := by
        rw [← hEquiv_comp (CategoryTheory.Limits.biproduct.ι L_fam i) Φ_sum,
          CategoryTheory.Limits.biproduct.ι_desc]
        exact Equiv.apply_symm_apply _ _
      rw [hdesc_i]
    let e_biprod : B ≅ L_U :=
      { hom := Φ_sum
        inv := Ψ_inv
        hom_inv_id := hΦΨ
        inv_hom_id := hΨΦ }

    refine ⟨?_, ?_⟩
    · intro W₀
      have hSum_app :
          ∀ (S : Finset (Fin n)) (f_fam : Fin n → (B ⟶ B)) (x : ↑(B.obj.obj (Opposite.op W₀))),
            (((∑ i ∈ S, f_fam i).hom.app (Opposite.op W₀)).hom x) =
              ∑ i ∈ S, (((f_fam i).hom.app (Opposite.op W₀)).hom x) := by
        intro S f_fam x
        induction S using Finset.induction_on with
        | empty =>
          rw [Finset.sum_empty, Finset.sum_empty]
          rfl
        | @insert j s hj ih =>
          rw [Finset.sum_insert hj, Finset.sum_insert hj]
          change (((f_fam j).hom.app (Opposite.op W₀)).hom x) +
              (((∑ i ∈ s, f_fam i).hom.app (Opposite.op W₀)).hom x) = _
          rw [ih]
      let e_UB : ↑(L_U.obj.obj (Opposite.op W₀)) ≃+ ↑(B.obj.obj (Opposite.op W₀)) :=
        { toFun := (e_biprod.inv.hom.app (Opposite.op W₀)).hom
          invFun := (e_biprod.hom.hom.app (Opposite.op W₀)).hom
          left_inv := fun x => by
            change ((e_biprod.inv ≫ e_biprod.hom).hom.app (Opposite.op W₀)).hom x = x
            rw [e_biprod.inv_hom_id]
            rfl
          right_inv := fun x => by
            change ((e_biprod.hom ≫ e_biprod.inv).hom.app (Opposite.op W₀)).hom x = x
            rw [e_biprod.hom_inv_id]
            rfl
          map_add' := map_add _ }
      let e_BPi : ↑(B.obj.obj (Opposite.op W₀)) ≃+
          ((i : Fin n) → ↑((L_fam i).obj.obj (Opposite.op W₀))) :=
        { toFun := fun x i =>
            ((CategoryTheory.Limits.biproduct.π L_fam i).hom.app (Opposite.op W₀)).hom x
          invFun := fun v =>
            ∑ i : Fin n,
              ((CategoryTheory.Limits.biproduct.ι L_fam i).hom.app (Opposite.op W₀)).hom (v i)
          left_inv := fun x => by
            have htot := hSum_app Finset.univ
              (fun i => CategoryTheory.Limits.biproduct.π L_fam i ≫
                CategoryTheory.Limits.biproduct.ι L_fam i) x
            rw [CategoryTheory.Limits.biproduct.total] at htot
            exact htot.symm
          right_inv := fun v => by
            dsimp only
            funext i
            rw [map_sum]
            rw [Finset.sum_eq_single i]
            · change (((CategoryTheory.Limits.biproduct.ι L_fam i ≫
                  CategoryTheory.Limits.biproduct.π L_fam i).hom.app (Opposite.op W₀)).hom (v i)) =
                v i
              rw [CategoryTheory.Limits.biproduct.ι_π_self]
              rfl
            · intro j _ hji
              change (((CategoryTheory.Limits.biproduct.ι L_fam j ≫
                  CategoryTheory.Limits.biproduct.π L_fam i).hom.app (Opposite.op W₀)).hom (v j)) =
                0
              rw [CategoryTheory.Limits.biproduct.ι_π_ne _ hji]
              rfl
            · intro hi
              exact False.elim (hi (Finset.mem_univ i))
          map_add' := fun x y => by
            funext i
            exact map_add _ x y }
      exact ⟨e_UB.trans e_BPi⟩
    · intro b
      let Fℤ_Z := (CategoryTheory.constantSheaf J_Z AddCommGrpCat.{u}).obj Aℤ
      have hPost_comp :
          ∀ {G₁ G₂ G₃ : CategoryTheory.Sheaf J_Z AddCommGrpCat.{u}}
            (f₁ : G₁ ⟶ G₂) (f₂ : G₂ ⟶ G₃) (w : G₁.H b),
            w.comp (CategoryTheory.Abelian.Ext.mk₀ (f₁ ≫ f₂)) (Nat.add_zero b) =
              (w.comp (CategoryTheory.Abelian.Ext.mk₀ f₁) (Nat.add_zero b)).comp
                (CategoryTheory.Abelian.Ext.mk₀ f₂) (Nat.add_zero b) := by
        intro G₁ G₂ G₃ f₁ f₂ w
        rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, ← CategoryTheory.Abelian.Ext.comp_assoc]
        omega
      let e_H_UB : L_U.H b ≃+ B.H b :=
        { toFun := (CategoryTheory.Abelian.Ext.mk₀ e_biprod.inv).postcomp Fℤ_Z (Nat.add_zero b)
          invFun := (CategoryTheory.Abelian.Ext.mk₀ e_biprod.hom).postcomp Fℤ_Z (Nat.add_zero b)
          left_inv := fun w => by
            change (w.comp (CategoryTheory.Abelian.Ext.mk₀ e_biprod.inv) (Nat.add_zero b)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_biprod.hom) (Nat.add_zero b) = w
            rw [← hPost_comp, e_biprod.inv_hom_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
          right_inv := fun w => by
            change (w.comp (CategoryTheory.Abelian.Ext.mk₀ e_biprod.hom) (Nat.add_zero b)).comp
              (CategoryTheory.Abelian.Ext.mk₀ e_biprod.inv) (Nat.add_zero b) = w
            rw [← hPost_comp, e_biprod.hom_inv_id, CategoryTheory.Abelian.Ext.comp_mk₀_id]
          map_add' := map_add _ }
      let e_H_BPi : B.H b ≃+ ((i : Fin n) → (L_fam i).H b) :=
        CategoryTheory.Abelian.Ext.addEquivBiproduct Fℤ_Z
          (CategoryTheory.Limits.biproduct.isBilimit L_fam) b
      exact ⟨e_H_UB.trans e_H_BPi⟩

  
  have hTerm_Sk :
