        (hEdge_nat P.left π_fst_P (pf₂.obj G) Λ_P φ₂ hpf_tor₂ hTor_std hz_f₂ hz_std y₂)
    have h3 : (CategoryTheory.Abelian.Ext.mk₀ map_φ₂).postcomp Fℤ_Pm
          (Nat.add_zero (2 * m)) (E_edge P.left π_fst_P (pf₂.obj G) hpf_tor₂ hz_f₂ y₂) =
        (CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.comp e_R2_2.inv map_φ₂)).postcomp Fℤ_Pm
          (Nat.add_zero (2 * m)) w_edge :=
      (he_R2_2_edge Λ_P φ₂ y₂).symm.trans
        (congrArg (fun u_W =>
          (CategoryTheory.Abelian.Ext.mk₀
            (CategoryTheory.CategoryStruct.comp e_R2_2.inv map_φ₂)).postcomp Fℤ_Pm
            (Nat.add_zero (2 * m)) (E_edge W_bar.left π_W G hG_tor hz_gf u_W)) hyW_leray₂)
    have h4 : (CategoryTheory.Abelian.Ext.mk₀ Tr_rel_P).postcomp Fℤ_Pm (Nat.add_zero (2 * m))
        ((CategoryTheory.Abelian.Ext.mk₀
          (CategoryTheory.CategoryStruct.comp e_R2_2.inv map_φ₂)).postcomp Fℤ_Pm
          (Nat.add_zero (2 * m)) w_edge) =
        (CategoryTheory.Abelian.Ext.mk₀ τ₂).postcomp Fℤ_Pm (Nat.add_zero (2 * m)) w_edge :=
      (hPostcomp_comp_gen (CategoryTheory.CategoryStruct.comp e_R2_2.inv map_φ₂)
        Tr_rel_P (2 * m) w_edge).trans
        (congrArg (fun g => (CategoryTheory.Abelian.Ext.mk₀ g).postcomp Fℤ_Pm (Nat.add_zero (2 * m)) w_edge)
          (CategoryTheory.Category.assoc e_R2_2.inv map_φ₂ Tr_rel_P))
    exact h1.trans (congrArg (tr_Pd m r)
      ((congrArg ((CategoryTheory.Abelian.Ext.mk₀ Tr_rel_P).postcomp Fℤ_Pm (Nat.add_zero (2 * m)))
        (h2.trans h3)).trans h4))
  exact hLHS.trans
    ((congrArg (fun τ =>
        tr_Pd m r ((CategoryTheory.Abelian.Ext.mk₀ τ).postcomp Fℤ_Pm (Nat.add_zero (2 * m)) w_edge))
      hτ_eq).trans hRHS.symm)

theorem weil_polyP1_last_coord_pinned_reciprocal_chart_of_coordCompactification (k : Type u) [Field k] [IsAlgClosed k]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff) :
    ∃ (a₀ : k)
      (ι_inf : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
        (weilProjectiveSpaceOver k 1).left)
      (τ_inv : Localization.Away (Polynomial.X : Polynomial k) ≃+*
        Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k)),
      AlgebraicGeometry.IsOpenImmersion ι_inf ∧
      CategoryTheory.CategoryStruct.comp ι_inf (weilProjectiveSpaceOver k 1).hom =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) ∧
      Set.range ι_P1.base ∪ Set.range ι_inf.base = Set.univ ∧
      ι_P1.base ⁻¹' (Set.range ι_inf.base) =
        (PrimeSpectrum.basicOpen (Polynomial.X - Polynomial.C a₀ : Polynomial k) :
          Set (PrimeSpectrum (Polynomial k))) ∧
      ι_inf.base ⁻¹' (Set.range ι_P1.base) =
        (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) :
          Set (PrimeSpectrum (Polynomial k))) ∧
      (∀ c : k,
        τ_inv (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))
            (Polynomial.C c)) =
          algebraMap (Polynomial k)
            (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
            (Polynomial.C c)) ∧
      τ_inv (algebraMap (Polynomial k) (Localization.Away (Polynomial.X : Polynomial k))
          Polynomial.X) *
        algebraMap (Polynomial k)
          (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k))
          (Polynomial.X - Polynomial.C a₀) = 1 ∧
      CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap (Polynomial k)
              (Localization.Away (Polynomial.X - Polynomial.C a₀ : Polynomial k)))))
          ι_P1 =
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_inv.toRingHom))
          (CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap (Polynomial k)
                (Localization.Away (Polynomial.X : Polynomial k)))))
            ι_inf) :=
by
  classical
  obtain ⟨hPropP1, _, _, _, hOpen₀, hOver₀,
    ⟨s_inf, _, hs_inf_over, hDisj_inf, hUniv_inf, _⟩, _, _⟩ := hCoord
  let P1 := weilProjectiveSpaceOver k 1
  let p_k : P1.left ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) := P1.hom
  have : AlgebraicGeometry.IsProper p_k := hPropP1
  have : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen₀
  have hSub_k : Subsingleton ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)) := (⊥ : PrimeSpectrum k)

  
  
  
  let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k
  let _ : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
  have hX_mem : ∀ l : Fin (1 + 1),
      (MvPolynomial.X l : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 1 :=
    fun l => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k l)

  have h_homog_chart : ∀ (i j : Fin (1 + 1)), i ≠ j →
      ∃ e : Polynomial k ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        e.symm.toRingHom.comp
          ((HomogeneousLocalization.fromZeroRingHom 𝒜
            (Submonoid.powers (MvPolynomial.X i))).comp (algebraMap k ↥(𝒜 0))) =
            Polynomial.C ∧
        e.symm (HomogeneousLocalization.Away.isLocalizationElem (hX_mem i) (hX_mem j)) =
          Polynomial.X := by
    intro i j hij
    let Xi : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X i
    let Xj : MvPolynomial (Fin (1 + 1)) k := MvPolynomial.X j
    let R_i := HomogeneousLocalization.Away 𝒜 Xi
    let L_i := Localization.Away Xi
    let ι_mv : MvPolynomial (Fin (1 + 1)) k →+* L_i :=
      algebraMap (MvPolynomial (Fin (1 + 1)) k) L_i
    let val_hom : R_i →+* L_i := algebraMap R_i L_i
    let κ_i : k →+* R_i :=
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers Xi)).comp
        (algebraMap k ↥(𝒜 0))
    let t_ij : R_i := HomogeneousLocalization.Away.isLocalizationElem (hX_mem i) (hX_mem j)
    let Ψ : Polynomial k →+* R_i := Polynomial.eval₂RingHom κ_i t_ij
    let ev_alg : MvPolynomial (Fin (1 + 1)) k →ₐ[k] Polynomial k :=
      MvPolynomial.aeval (fun l : Fin (1 + 1) => if l = i then (1 : Polynomial k) else Polynomial.X)
    let ev : MvPolynomial (Fin (1 + 1)) k →+* Polynomial k := ev_alg.toRingHom
    have hev_Xi_eq : ev Xi = 1 := by
      change (MvPolynomial.aeval (fun l : Fin (1 + 1) =>
        if l = i then (1 : Polynomial k) else Polynomial.X)) (MvPolynomial.X i) = 1
      rw [MvPolynomial.aeval_X]
      simp
    have hev_Xj_eq : ev Xj = Polynomial.X := by
      change (MvPolynomial.aeval (fun l : Fin (1 + 1) =>
        if l = i then (1 : Polynomial k) else Polynomial.X)) (MvPolynomial.X j) = Polynomial.X
      rw [MvPolynomial.aeval_X, ite_eq_right_iff]
      intro hji
      exact False.elim (hij hji.symm)
    have hev_C_eq : ∀ c : k, ev (MvPolynomial.C c) = Polynomial.C c := by
      intro c
      change (MvPolynomial.aeval _) (MvPolynomial.C c) = Polynomial.C c
      rw [MvPolynomial.aeval_C, Polynomial.algebraMap_eq]
    have hev_Xi : IsUnit (ev Xi) := hev_Xi_eq.symm ▸ isUnit_one
    let ev_loc : L_i →+* Polynomial k := IsLocalization.Away.lift Xi hev_Xi
    let Φ : R_i →+* Polynomial k := ev_loc.comp val_hom
    have hκ_val : ∀ c : k, val_hom (κ_i c) = ι_mv (MvPolynomial.C c) := by
      intro c
      dsimp [val_hom, ι_mv]
      rw [HomogeneousLocalization.algebraMap_apply]
      change Localization.mk (↑(algebraMap k ↥(𝒜 0) c) : MvPolynomial (Fin (1 + 1)) k) 1 =
        algebraMap (MvPolynomial (Fin (1 + 1)) k) L_i (MvPolynomial.C c)
      rw [Localization.mk_one_eq_algebraMap]
      congr 1
    have ht_val : val_hom t_ij * ι_mv Xi = ι_mv Xj := by
      dsimp [val_hom, ι_mv, t_ij, HomogeneousLocalization.Away.isLocalizationElem]
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
        Localization.mk_eq_mk']
      have hmem1 : Xi ^ 1 ∈ Submonoid.powers Xi := Submonoid.pow_mem _ (Submonoid.mem_powers Xi) 1
      have hspec := IsLocalization.mk'_spec L_i (M := Submonoid.powers Xi) (Xj ^ 1) ⟨Xi ^ 1, hmem1⟩
      change IsLocalization.mk' L_i (Xj ^ 1) ⟨Xi ^ 1, hmem1⟩ *
          algebraMap (MvPolynomial (Fin (1 + 1)) k) L_i (Xi ^ 1) =
        algebraMap (MvPolynomial (Fin (1 + 1)) k) L_i (Xj ^ 1) at hspec
      simpa only [pow_one] using hspec
    have hΨ_C : ∀ c : k, Ψ (Polynomial.C c) = κ_i c :=
      fun c => Polynomial.eval₂_C κ_i t_ij
    have hΨ_X : Ψ Polynomial.X = t_ij :=
      Polynomial.eval₂_X κ_i t_ij
    have hΦΨ : Φ.comp Ψ = RingHom.id (Polynomial k) := by
      apply Polynomial.ringHom_ext
      · intro c
        rw [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hΨ_C]
        change ev_loc (val_hom (κ_i c)) = Polynomial.C c
        rw [hκ_val]
        dsimp [ι_mv, ev_loc]
        rw [IsLocalization.Away.lift_eq (S := L_i) Xi hev_Xi, hev_C_eq]
      · rw [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hΨ_X]
        change ev_loc (val_hom t_ij) = Polynomial.X
        have h1 : ev_loc (ι_mv Xi) = 1 := by
          dsimp [ι_mv, ev_loc]
          rw [IsLocalization.Away.lift_eq (S := L_i) Xi hev_Xi, hev_Xi_eq]
        calc
          ev_loc (val_hom t_ij) = ev_loc (val_hom t_ij) * 1 := (mul_one _).symm
          _ = ev_loc (val_hom t_ij) * ev_loc (ι_mv Xi) := by rw [h1]
          _ = ev_loc (val_hom t_ij * ι_mv Xi) := (map_mul _ _ _).symm
          _ = ev_loc (ι_mv Xj) := by rw [ht_val]
          _ = ev Xj := IsLocalization.Away.lift_eq (S := L_i) Xi hev_Xi Xj
          _ = Polynomial.X := hev_Xj_eq
    have hΨΦ : Ψ.comp Φ = RingHom.id R_i := by
      apply RingHom.ext
      intro z
      rw [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply,
        HomogeneousLocalization.ext_iff_val]
      obtain ⟨m, F, hF, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX_mem i) z
      change val_hom (Ψ (Φ (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF))) =
        val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF)
      have hz_val : val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF) *
          (ι_mv Xi) ^ m = ι_mv F := by
        dsimp [val_hom, ι_mv]
        rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
          Localization.mk_eq_mk', ← map_pow]
        have hmem_m : Xi ^ m ∈ Submonoid.powers Xi :=
          Submonoid.pow_mem _ (Submonoid.mem_powers Xi) m
        exact IsLocalization.mk'_spec L_i (M := Submonoid.powers Xi) F ⟨Xi ^ m, hmem_m⟩
      have hΦ_eq : Φ (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF) = ev F := by
        dsimp [Φ]
        have h1 : ev_loc (ι_mv Xi) = 1 := by
          dsimp [ι_mv, ev_loc]
          rw [IsLocalization.Away.lift_eq (S := L_i) Xi hev_Xi, hev_Xi_eq]
        calc
          ev_loc (val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF)) =
              ev_loc (val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF)) *
                (ev_loc (ι_mv Xi)) ^ m := by rw [h1, one_pow, mul_one]
          _ = ev_loc (val_hom (HomogeneousLocalization.Away.mk 𝒜 (hX_mem i) m F hF) *
                (ι_mv Xi) ^ m) := by rw [← map_pow, ← map_mul]
          _ = ev_loc (ι_mv F) := by rw [hz_val]
          _ = ev F := IsLocalization.Away.lift_eq (S := L_i) Xi hev_Xi F
      rw [hΦ_eq]
      have hu_pow : IsUnit ((ι_mv Xi) ^ m) :=
        (IsLocalization.Away.algebraMap_isUnit Xi).pow m
      apply hu_pow.mul_right_cancel
      rw [hz_val]
      have hF_mem : F ∈ MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) k m := by
        simpa [𝒜] using hF
      have hF_hom : F.IsHomogeneous m :=
        (MvPolynomial.mem_homogeneousSubmodule m F).mp hF_mem
      have hF_sum := MvPolynomial.as_sum F
      conv_lhs => rw [hF_sum]
      conv_rhs => rw [hF_sum]
      rw [map_sum, map_sum, map_sum, Finset.sum_mul, map_sum]
      refine Finset.sum_congr rfl fun s hs => ?_
      have hs_ne : F.coeff s ≠ 0 := MvPolynomial.mem_support_iff.mp hs
      have hs_wt : (Finsupp.weight 1) s = m := hF_hom hs_ne
      have hs_deg_supp : ∑ l ∈ s.support, s l = m := by
        rw [Finsupp.weight_apply, Finsupp.sum] at hs_wt
        simpa using hs_wt
      have hs_deg_univ : ∑ l : Fin (1 + 1), s l = m := by
        rw [← hs_deg_supp]
        exact (Finset.sum_subset (Finset.subset_univ _)
          (fun l _ hl => Finsupp.notMem_support_iff.mp hl)).symm
      have hs_deg : s i + s j = m := by
        rw [← hs_deg_univ]
        fin_cases i <;> fin_cases j <;> simp at hij ⊢
        omega
      have hmon_eq : MvPolynomial.monomial s (F.coeff s) =
          MvPolynomial.C (F.coeff s) * Xi ^ (s i) * Xj ^ (s j) := by
        rw [MvPolynomial.monomial_eq]
        have hprod : s.prod (fun l e => (MvPolynomial.X l : MvPolynomial (Fin (1 + 1)) k) ^ e) =
            Xi ^ (s i) * Xj ^ (s j) := by
          rw [Finsupp.prod_fintype _ _ (fun _ => pow_zero _)]
          dsimp [Xi, Xj]
          fin_cases i <;> fin_cases j <;> simp at hij ⊢
          exact mul_comm _ _
        rw [hprod, mul_assoc]
      rw [hmon_eq]
      have hev_mon : ev (MvPolynomial.C (F.coeff s) * Xi ^ (s i) * Xj ^ (s j)) =
          Polynomial.C (F.coeff s) * Polynomial.X ^ (s j) := by
        rw [map_mul, map_mul, map_pow, map_pow, hev_C_eq, hev_Xi_eq, hev_Xj_eq, one_pow, mul_one]
      rw [hev_mon]
      have hΨ_mon : val_hom (Ψ (Polynomial.C (F.coeff s) * Polynomial.X ^ (s j))) =
          ι_mv (MvPolynomial.C (F.coeff s)) * (val_hom t_ij) ^ (s j) := by
        rw [map_mul, map_pow, map_mul, map_pow, hΨ_C, hΨ_X, hκ_val]
      rw [hΨ_mon, ← hs_deg, pow_add]
      calc
        ι_mv (MvPolynomial.C (F.coeff s)) * val_hom t_ij ^ s j *
            (ι_mv Xi ^ s i * ι_mv Xi ^ s j) =
          ι_mv (MvPolynomial.C (F.coeff s)) * ι_mv Xi ^ s i *
            (val_hom t_ij * ι_mv Xi) ^ s j := by
          rw [mul_pow]; ring
        _ = ι_mv (MvPolynomial.C (F.coeff s)) * ι_mv Xi ^ s i *
            ι_mv Xj ^ s j := by rw [ht_val]
        _ = ι_mv (MvPolynomial.C (F.coeff s) * Xi ^ s i * Xj ^ s j) := by
          simp only [map_mul, map_pow]
    let e : Polynomial k ≃+* R_i :=
      RingEquiv.ofRingHom Ψ Φ hΨΦ hΦΨ
    refine ⟨e, ?_, ?_⟩
    · apply RingHom.ext
      intro c
      change e.symm (κ_i c) = Polynomial.C c
      have hΨC : e (Polynomial.C c) = κ_i c := hΨ_C c
      rw [← hΨC, e.symm_apply_apply]
    · change e.symm t_ij = Polynomial.X
      have hΨX : e Polynomial.X = t_ij := hΨ_X
      rw [← hΨX, e.symm_apply_apply]

  have h10_ne : (1 : Fin (1 + 1)) ≠ 0 := by decide
  have h01_ne : (0 : Fin (1 + 1)) ≠ 1 := by decide
  obtain ⟨e10, he10_C, he10_X⟩ := h_homog_chart 1 0 h10_ne
  obtain ⟨e01, he01_C, he01_X⟩ := h_homog_chart 0 1 h01_ne

  let away₁ : AlgebraicGeometry.Spec
      (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))) ⟶
      AlgebraicGeometry.Proj 𝒜 :=
    AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one
  let away₀ : AlgebraicGeometry.Spec
      (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0))) ⟶
      AlgebraicGeometry.Proj 𝒜 :=
    AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one

  have : AlgebraicGeometry.IsOpenImmersion away₁ := by
    dsimp [away₁]
    infer_instance
  have : AlgebraicGeometry.IsOpenImmersion away₀ := by
    dsimp [away₀]
    infer_instance

  let spec_e10 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      AlgebraicGeometry.Spec
        (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom)
  let spec_e01 : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      AlgebraicGeometry.Spec
        (CommRingCat.of (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0))) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom)

  let ψ₁' : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      AlgebraicGeometry.Proj 𝒜 :=
    spec_e10 ≫ away₁
  let ψ₀' : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      AlgebraicGeometry.Proj 𝒜 :=
    spec_e01 ≫ away₀

  let ψ₁ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P1.left := ψ₁'
  let ψ₀ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P1.left := ψ₀'

  have hIso_ring : ∀ {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S),
      CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom)) := by
    intro R S _ _ e
    have : CategoryTheory.IsIso (CommRingCat.ofHom e.symm.toRingHom) :=
      ⟨⟨CommRingCat.ofHom e.toRingHom,
        CommRingCat.hom_ext (RingHom.ext e.apply_symm_apply),
        CommRingCat.hom_ext (RingHom.ext e.symm_apply_apply)⟩⟩
    infer_instance

  have hRange_comp_iso : ∀ {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S)
      {Y : AlgebraicGeometry.Scheme.{u}}
      (f : AlgebraicGeometry.Spec (CommRingCat.of S) ⟶ Y),
      Set.range (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom) ≫ f).base =
        Set.range f.base := by
    intro R S _ _ e Y f
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨_, rfl⟩
    · rintro ⟨z, rfl⟩
      refine ⟨(AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom)).base z, ?_⟩
      have hcomp : AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom) = 𝟙 _ := by
        rw [← AlgebraicGeometry.Spec.map_comp]
        have hid : CommRingCat.ofHom e.symm.toRingHom ≫ CommRingCat.ofHom e.toRingHom = 𝟙 _ :=
          CommRingCat.hom_ext (RingHom.ext e.apply_symm_apply)
        rw [hid, AlgebraicGeometry.Spec.map_id]
      change ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.toRingHom) ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom e.symm.toRingHom)) ≫ f).base z = f.base z
      rw [hcomp, CategoryTheory.Category.id_comp]

  have hOpen_ψ₁ : AlgebraicGeometry.IsOpenImmersion ψ₁ := by
    have : CategoryTheory.IsIso spec_e10 := hIso_ring e10
    have : AlgebraicGeometry.IsOpenImmersion spec_e10 := inferInstance
    exact AlgebraicGeometry.IsOpenImmersion.comp spec_e10 away₁
  have hOpen_ψ₀ : AlgebraicGeometry.IsOpenImmersion ψ₀ := by
    have : CategoryTheory.IsIso spec_e01 := hIso_ring e01
    have : AlgebraicGeometry.IsOpenImmersion spec_e01 := inferInstance
    exact AlgebraicGeometry.IsOpenImmersion.comp spec_e01 away₀

  have hOver_ψ₁ : ψ₁ ≫ p_k =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e10.symm.toRingHom) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
      (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one),
      AlgebraicGeometry.Proj.awayι_toSpecZero,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
  have hOver_ψ₀ : ψ₀ ≫ p_k =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) := by
    change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom e01.symm.toRingHom) ≫
        AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one) ≫
      (AlgebraicGeometry.Proj.toSpecZero 𝒜 ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k ↥(𝒜 0)))) = _
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
      (AlgebraicGeometry.Proj.awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one),
      AlgebraicGeometry.Proj.awayι_toSpecZero,
      ← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2

  have hRange_ψ₁' : Set.range ψ₁'.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1)).carrier :=
    (hRange_comp_iso e10 away₁).trans
      (congrArg TopologicalSpace.Opens.carrier
        (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 1) (hX_mem 1) zero_lt_one))
  have hRange_ψ₀' : Set.range ψ₀'.base =
      (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)).carrier :=
    (hRange_comp_iso e01 away₀).trans
      (congrArg TopologicalSpace.Opens.carrier
        (AlgebraicGeometry.Proj.opensRange_awayι 𝒜 (MvPolynomial.X 0) (hX_mem 0) zero_lt_one))

  have hCov_10 : Set.range ψ₁.base ∪ Set.range ψ₀.base = Set.univ := by
    change Set.range ψ₁'.base ∪ Set.range ψ₀'.base = Set.univ
    ext y
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    by_contra h_not
    rw [not_or] at h_not
    rcases h_not with ⟨hy1, hy0⟩
    rw [hRange_ψ₁'] at hy1
    rw [hRange_ψ₀'] at hy0
    have hx1 : MvPolynomial.X 1 ∈ y.asHomogeneousIdeal := by
      by_contra h1
      exact hy1 ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 1) y).mpr h1)
    have hx0 : MvPolynomial.X 0 ∈ y.asHomogeneousIdeal := by
      by_contra h0
      exact hy0 ((AlgebraicGeometry.Proj.mem_basicOpen 𝒜 (MvPolynomial.X 0) y).mpr h0)
    have hX_in : ∀ l : Fin (1 + 1), MvPolynomial.X l ∈ y.asHomogeneousIdeal.toIdeal := by
      intro l
      fin_cases l
      · exact HomogeneousIdeal.mem_iff.mpr hx0
      · exact HomogeneousIdeal.mem_iff.mpr hx1
    let π₀ : MvPolynomial (Fin (1 + 1)) k →+* MvPolynomial (Fin (1 + 1)) k :=
      GradedRing.projZeroRingHom 𝒜
    have h_mod : ∀ G : MvPolynomial (Fin (1 + 1)) k,
        G - π₀ G ∈ y.asHomogeneousIdeal.toIdeal := by
      intro G
      induction G using MvPolynomial.induction_on with
      | C c =>
        have hc0 : (MvPolynomial.C c : MvPolynomial (Fin (1 + 1)) k) ∈ 𝒜 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ c)
        have hπC : π₀ (MvPolynomial.C c) = MvPolynomial.C c := by
          dsimp [π₀]
          rw [GradedRing.projZeroRingHom_apply]
          exact DirectSum.decompose_of_mem_same 𝒜 hc0
        rw [hπC, sub_self]
        exact Ideal.zero_mem _
      | add P Q ihP ihQ =>
        have h_eq : P + Q - π₀ (P + Q) = (P - π₀ P) + (Q - π₀ Q) := by
          rw [map_add]; ring
        rw [h_eq]
        exact Ideal.add_mem _ ihP ihQ
      | mul_X P l _ =>
        have hπX : π₀ (MvPolynomial.X l) = 0 := by
          dsimp [π₀]
          rw [GradedRing.projZeroRingHom_apply]
          exact DirectSum.decompose_of_mem_ne 𝒜 (hX_mem l) Nat.one_ne_zero
        rw [map_mul, hπX, mul_zero, sub_zero]
        exact Ideal.mul_mem_left _ P (hX_in l)
    apply y.not_irrelevant_le
    intro G hG
    have hπG : π₀ G = 0 := by
      have hproj0 : GradedRing.proj 𝒜 0 G = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜 G).mp hG
      dsimp [π₀]
      rw [GradedRing.projZeroRingHom_apply, ← GradedRing.proj_apply]
      exact hproj0
    have hG_mem := h_mod G
    rw [hπG, sub_zero] at hG_mem
    exact HomogeneousIdeal.mem_iff.mp hG_mem

  have hPre_01 : ψ₀.base ⁻¹' (Set.range ψ₁.base) =
      (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) :
        Set (PrimeSpectrum (Polynomial k))) := by
    ext q
    change ψ₀'.base q ∈ Set.range ψ₁'.base ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [hRange_ψ₁']
    have h_away := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem 0) zero_lt_one
      (hX_mem 1) zero_lt_one
    have hq_mem : ψ₀'.base q ∈ (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1)).carrier ↔
        spec_e01.base q ∈
          (TopologicalSpace.Opens.map away₀.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 1)) := Iff.rfl
    rw [hq_mem]
    dsimp only [away₀]
    rw [h_away]
    change e01.symm (HomogeneousLocalization.Away.isLocalizationElem (hX_mem 0) (hX_mem 1)) ∉
        (q : PrimeSpectrum (Polynomial k)).asIdeal ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [he01_X]

  have hPre_10 : ψ₁.base ⁻¹' (Set.range ψ₀.base) =
      (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) :
        Set (PrimeSpectrum (Polynomial k))) := by
    ext q
    change ψ₁'.base q ∈ Set.range ψ₀'.base ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [hRange_ψ₀']
    have h_away := AlgebraicGeometry.Proj.awayι_preimage_basicOpen 𝒜 (hX_mem 1) zero_lt_one
      (hX_mem 0) zero_lt_one
    have hq_mem : ψ₁'.base q ∈ (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)).carrier ↔
        spec_e10.base q ∈
          (TopologicalSpace.Opens.map away₁.base).obj
            (AlgebraicGeometry.Proj.basicOpen 𝒜 (MvPolynomial.X 0)) := Iff.rfl
    rw [hq_mem]
    dsimp only [away₁]
    rw [h_away]
    change e10.symm (HomogeneousLocalization.Away.isLocalizationElem (hX_mem 1) (hX_mem 0)) ∉
        (q : PrimeSpectrum (Polynomial k)).asIdeal ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [he10_X]

  
  have h_eval_ker_eq : ∀ (a : k) (q : PrimeSpectrum (Polynomial k)),
      Polynomial.X - Polynomial.C a ∈ q.asIdeal →
      RingHom.ker (Polynomial.evalRingHom a) = q.asIdeal := by
    intro a q hmem
    have hle : RingHom.ker (Polynomial.evalRingHom a) ≤ q.asIdeal := by
      intro f hf
      rw [RingHom.mem_ker] at hf
      have hroot : Polynomial.IsRoot f a := hf
      obtain ⟨g, rfl⟩ := (Polynomial.dvd_iff_isRoot (a := a)).mpr hroot
      exact Ideal.mul_mem_right g _ hmem
    apply le_antisymm hle
    intro f hf
    rw [RingHom.mem_ker]
    by_contra hne
    let v : k := Polynomial.evalRingHom a f
    have hv_ne : v ≠ 0 := hne
    have hsub_ker : f - Polynomial.C v ∈ RingHom.ker (Polynomial.evalRingHom a) := by
      rw [RingHom.mem_ker, map_sub]
      have hCv : (Polynomial.evalRingHom a) (Polynomial.C v) = v := by simp
      rw [hCv]
      exact sub_self v
    have hCv_mem : Polynomial.C v ∈ q.asIdeal := by
      have hsub_mem := hle hsub_ker
      have heq : Polynomial.C v = f - (f - Polynomial.C v) := by ring
      rw [heq]
      exact Ideal.sub_mem _ hf hsub_mem
    have h1_mem : (1 : Polynomial k) ∈ q.asIdeal := by
      have hmul := Ideal.mul_mem_left q.asIdeal (Polynomial.C v⁻¹) hCv_mem
      rwa [← Polynomial.C_mul, inv_mul_cancel₀ hv_ne, map_one] at hmul
    apply q.isPrime.ne_top
    exact top_unique fun g _ => by simpa using Ideal.mul_mem_left q.asIdeal g h1_mem

  have h_compl_sec : ∀ (ψ_a ψ_b : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P1.left),
      ψ_b ≫ p_k = AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) →
      Set.range ψ_a.base ∪ Set.range ψ_b.base = Set.univ →
      ψ_b.base ⁻¹' (Set.range ψ_a.base) =
        (PrimeSpectrum.basicOpen (Polynomial.X : Polynomial k) :
          Set (PrimeSpectrum (Polynomial k))) →
      ∃ s_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P1.left,
        s_a ≫ p_k = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
        Disjoint (Set.range ψ_a.base) (Set.range s_a.base) ∧
        Set.range ψ_a.base ∪ Set.range s_a.base = Set.univ := by
    intro ψ_a ψ_b hOver_b hCov_ab hPre_ba
    let ev₀ : Polynomial k →+* k := Polynomial.evalRingHom 0
    let s_a : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P1.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀) ≫ ψ_b
    refine ⟨s_a, ?_, ?_, ?_⟩
    · dsimp [s_a]
      rw [CategoryTheory.Category.assoc, hOver_b, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      have hid : ev₀.comp Polynomial.C = RingHom.id k := by
        apply RingHom.ext
        intro c
        simp [ev₀]
      rw [hid, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
    · rw [Set.disjoint_left]
      rintro y hy_a ⟨pt, rfl⟩
      have hmem : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt ∈
          ψ_b.base ⁻¹' (Set.range ψ_a.base) := hy_a
      rw [hPre_ba] at hmem
      have hnot : (Polynomial.X : Polynomial k) ∉
          Ideal.comap ev₀ (pt : PrimeSpectrum k).asIdeal := hmem
      apply hnot
      change ev₀ Polynomial.X ∈ (pt : PrimeSpectrum k).asIdeal
      simp [ev₀]
    · ext y
      simp only [Set.mem_union, Set.mem_univ, iff_true]
      by_cases hy_a : y ∈ Set.range ψ_a.base
      · exact Or.inl hy_a
      · right
        have hy_univ : y ∈ Set.range ψ_a.base ∪ Set.range ψ_b.base := by
          rw [hCov_ab]; trivial
        rcases hy_univ with h_in | ⟨q, rfl⟩
        · exact False.elim (hy_a h_in)
        have hq_not : q ∉ ψ_b.base ⁻¹' (Set.range ψ_a.base) := hy_a
        rw [hPre_ba] at hq_not
        have hX_in_q : (Polynomial.X - Polynomial.C (0 : k)) ∈
            (q : PrimeSpectrum (Polynomial k)).asIdeal := by
          rw [map_zero, sub_zero]
          by_contra hnot
          exact hq_not hnot
        have heq_id : RingHom.ker ev₀ = (q : PrimeSpectrum (Polynomial k)).asIdeal :=
          h_eval_ker_eq 0 q hX_in_q
        have hq_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt₀ = q := by
          apply PrimeSpectrum.ext
          change Ideal.comap ev₀ (⊥ : PrimeSpectrum k).asIdeal =
            (q : PrimeSpectrum (Polynomial k)).asIdeal
          rw [PrimeSpectrum.asIdeal_bot]
          exact heq_id
        refine ⟨pt₀, ?_⟩
        dsimp [s_a]
        change ψ_b.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀)).base pt₀) =
          ψ_b.base q
        rw [hq_eq]

  have hChart_sel : ∃ (ψ : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P1.left)
      (s_ψ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P1.left),
      AlgebraicGeometry.IsOpenImmersion ψ ∧
      ψ ≫ p_k = AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) ∧
      Set.range s_inf.base ⊆ Set.range ψ.base ∧
      s_ψ ≫ p_k = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) ∧
      Disjoint (Set.range ψ.base) (Set.range s_ψ.base) ∧
      Set.range ψ.base ∪ Set.range s_ψ.base = Set.univ := by
    by_cases hp : s_inf.base pt₀ ∈ Set.range ψ₁.base
    · obtain ⟨s₁, hs₁_over, hDisj₁, hUniv₁⟩ := h_compl_sec ψ₁ ψ₀ hOver_ψ₀ hCov_10 hPre_01
      refine ⟨ψ₁, s₁, hOpen_ψ₁, hOver_ψ₁, ?_, hs₁_over, hDisj₁, hUniv₁⟩
      rintro _ ⟨pt, rfl⟩
      rw [hSub_k.elim pt pt₀]
      exact hp
    · have hp₀ : s_inf.base pt₀ ∈ Set.range ψ₀.base := by
        have huniv : s_inf.base pt₀ ∈ Set.range ψ₁.base ∪ Set.range ψ₀.base := by
          rw [hCov_10]; trivial
        exact huniv.resolve_left hp
      have hCov_01 : Set.range ψ₀.base ∪ Set.range ψ₁.base = Set.univ := by
        rw [Set.union_comm]; exact hCov_10
      obtain ⟨s₀, hs₀_over, hDisj₀, hUniv₀⟩ := h_compl_sec ψ₀ ψ₁ hOver_ψ₁ hCov_01 hPre_10
      refine ⟨ψ₀, s₀, hOpen_ψ₀, hOver_ψ₀, ?_, hs₀_over, hDisj₀, hUniv₀⟩
      rintro _ ⟨pt, rfl⟩
      rw [hSub_k.elim pt pt₀]
      exact hp₀

  obtain ⟨ψ, s_ψ, hOpen_ψ, hOver_ψ, hs_inf_in_ψ, hs_ψ_over, hDisj_ψ, hUniv_ψ⟩ := hChart_sel
  have : AlgebraicGeometry.IsOpenImmersion ψ := hOpen_ψ

  
  
  
  have hCov_ψ : Set.range ι_P1.base ∪ Set.range ψ.base = Set.univ := by
    ext y
    simp only [Set.mem_union, Set.mem_univ, iff_true]
    have hy : y ∈ Set.range ι_P1.base ∪ Set.range s_inf.base := by
      rw [hUniv_inf]; trivial
    exact hy.imp_right fun h => hs_inf_in_ψ h

  have hs_ψ_in_P1 : Set.range s_ψ.base ⊆ Set.range ι_P1.base := by
    intro y hy
    have hnot_ψ : y ∉ Set.range ψ.base := Set.disjoint_right.mp hDisj_ψ hy
    have hnot_inf : y ∉ Set.range s_inf.base := fun h => hnot_ψ (hs_inf_in_ψ h)
    have huniv : y ∈ Set.range ι_P1.base ∪ Set.range s_inf.base := by
      rw [hUniv_inf]; trivial
    exact huniv.resolve_right hnot_inf

  have h_sec_preimage :
      ∀ (u v : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P1.left)
        (s : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶ P1.left)
        [AlgebraicGeometry.IsOpenImmersion u],
        u ≫ p_k = AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) →
        s ≫ p_k = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        Disjoint (Set.range v.base) (Set.range s.base) →
        Set.range v.base ∪ Set.range s.base = Set.univ →
        Set.range s.base ⊆ Set.range u.base →
        ∃ (a : k)
          (σ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
            AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))),
          σ ≫ u = s ∧
          u.base ⁻¹' (Set.range v.base) =
            (PrimeSpectrum.basicOpen (Polynomial.X - Polynomial.C a : Polynomial k) :
              Set (PrimeSpectrum (Polynomial k))) := by
    intro u v s _ hu_over hs_over hDisj_vs hUniv_vs hs_in_u
    let σ : AlgebraicGeometry.Spec (CommRingCat.of k) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      AlgebraicGeometry.IsOpenImmersion.lift u s hs_in_u
    have hσ_fac : σ ≫ u = s := AlgebraicGeometry.IsOpenImmersion.lift_fac u s hs_in_u
    let ev_cat := AlgebraicGeometry.Spec.preimage σ
    let ev : Polynomial k →+* k := ev_cat.hom
    have hmap_ev : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev) = σ :=
      AlgebraicGeometry.Spec.map_preimage σ
    have hev_C : ev.comp Polynomial.C = RingHom.id k := by
      have hcomp : σ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom Polynomial.C) =
          𝟙 (AlgebraicGeometry.Spec (CommRingCat.of k)) := by
        rw [← hu_over, ← CategoryTheory.Category.assoc, hσ_fac, hs_over]
      rw [← hmap_ev, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← AlgebraicGeometry.Spec.map_id, ← CommRingCat.ofHom_id] at hcomp
      exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hcomp)
    let a : k := ev Polynomial.X
    have hev_eq : ev = Polynomial.evalRingHom a := by
      apply Polynomial.ringHom_ext
      · intro c
        simpa using congrArg (fun g : k →+* k => g c) hev_C
      · simp [a]
    refine ⟨a, σ, hσ_fac, ?_⟩
    ext q
    have hcompl : u.base q ∈ Set.range v.base ↔ u.base q ∉ Set.range s.base := by
      constructor
      · exact fun hv hs => Set.disjoint_left.mp hDisj_vs hv hs
      · intro hns
        have huniv : u.base q ∈ Set.range v.base ∪ Set.range s.base := by
          rw [hUniv_vs]; trivial
        exact huniv.resolve_right hns
    have hs_sing : u.base q ∈ Set.range s.base ↔ q = σ.base pt₀ := by
      constructor
      · rintro ⟨pt, hpt⟩
        rw [hSub_k.elim pt pt₀, ← hσ_fac] at hpt
        have hpt' : ⇑u q = ⇑u (σ.base pt₀) := hpt.symm
        exact u.isOpenEmbedding.injective hpt'
      · rintro rfl
        refine ⟨pt₀, ?_⟩
        rw [← hσ_fac]
        rfl
    have hq_eq_iff : q = σ.base pt₀ ↔
        Polynomial.X - Polynomial.C a ∈ (q : PrimeSpectrum (Polynomial k)).asIdeal := by
      rw [← hmap_ev]
      constructor
      · rintro rfl
        change Polynomial.X - Polynomial.C a ∈ Ideal.comap ev (⊥ : PrimeSpectrum k).asIdeal
        rw [PrimeSpectrum.asIdeal_bot]
        change ev (Polynomial.X - Polynomial.C a) = 0
        rw [hev_eq]
        simp
      · intro hmem
        have heq_id : (q : PrimeSpectrum (Polynomial k)).asIdeal = RingHom.ker ev := by
          rw [hev_eq]
          exact (h_eval_ker_eq a q hmem).symm
        apply PrimeSpectrum.ext
        change (q : PrimeSpectrum (Polynomial k)).asIdeal =
          Ideal.comap ev (⊥ : PrimeSpectrum k).asIdeal
        rw [PrimeSpectrum.asIdeal_bot]
        exact heq_id
    change u.base q ∈ Set.range v.base ↔
      Polynomial.X - Polynomial.C a ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [hcompl, hs_sing, hq_eq_iff]

  obtain ⟨a₀, σ_a, hσ_a_fac, hPre₀_ψ⟩ :=
    h_sec_preimage ι_P1 ψ s_ψ hOver₀ hs_ψ_over hDisj_ψ hUniv_ψ hs_ψ_in_P1
  obtain ⟨b₀, _, _, hPre_ψ⟩ :=
    h_sec_preimage ψ ι_P1 s_inf hOver_ψ hs_inf_over hDisj_inf hUniv_inf hs_inf_in_ψ

  let t_a : Polynomial k := Polynomial.X - Polynomial.C a₀
  let t_b : Polynomial k := Polynomial.X - Polynomial.C b₀
  let A_a0 := Localization.Away t_a
  let A_b0 := Localization.Away t_b
  let ι_a0 : Polynomial k →+* A_a0 := algebraMap (Polynomial k) A_a0
  let ι_b0 : Polynomial k →+* A_b0 := algebraMap (Polynomial k) A_b0
  let j_a0 : AlgebraicGeometry.Spec (CommRingCat.of A_a0) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_a0)
  let j_b0 : AlgebraicGeometry.Spec (CommRingCat.of A_b0) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_b0)

  have : AlgebraicGeometry.IsOpenImmersion j_a0 := by
    dsimp [j_a0, ι_a0, A_a0]
    infer_instance
  have : AlgebraicGeometry.IsOpenImmersion j_b0 := by
    dsimp [j_b0, ι_b0, A_b0]
    infer_instance
  have : AlgebraicGeometry.IsOpenImmersion (j_a0 ≫ ι_P1) := inferInstance
  have : AlgebraicGeometry.IsOpenImmersion (j_b0 ≫ ψ) := inferInstance

  have hRange_ja0 : Set.range j_a0.base =
      (PrimeSpectrum.basicOpen t_a : Set (PrimeSpectrum (Polynomial k))) :=
    PrimeSpectrum.localization_away_comap_range A_a0 t_a
  have hRange_jb0 : Set.range j_b0.base =
      (PrimeSpectrum.basicOpen t_b : Set (PrimeSpectrum (Polynomial k))) :=
    PrimeSpectrum.localization_away_comap_range A_b0 t_b

  have hRange_ov_eq : Set.range (j_a0 ≫ ι_P1).base = Set.range (j_b0 ≫ ψ).base := by
    ext z
    constructor
    · rintro ⟨x, rfl⟩
      have hx : j_a0.base x ∈ Set.range j_a0.base := ⟨x, rfl⟩
      rw [hRange_ja0, ← hPre₀_ψ] at hx
      obtain ⟨y, hy⟩ := hx
      have hy_pre : y ∈ ψ.base ⁻¹' (Set.range ι_P1.base) := ⟨j_a0.base x, hy.symm⟩
      rw [hPre_ψ, ← hRange_jb0] at hy_pre
      obtain ⟨w, rfl⟩ := hy_pre
      exact ⟨w, hy⟩
    · rintro ⟨w, rfl⟩
      have hw : j_b0.base w ∈ Set.range j_b0.base := ⟨w, rfl⟩
      rw [hRange_jb0, ← hPre_ψ] at hw
      obtain ⟨x, hx⟩ := hw
      have hx_pre : x ∈ ι_P1.base ⁻¹' (Set.range ψ.base) := ⟨j_b0.base w, hx.symm⟩
      rw [hPre₀_ψ, ← hRange_ja0] at hx_pre
      obtain ⟨u, rfl⟩ := hx_pre
      exact ⟨u, hx⟩

  let g₁ : AlgebraicGeometry.Spec (CommRingCat.of A_a0) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A_b0) :=
    AlgebraicGeometry.IsOpenImmersion.lift (j_b0 ≫ ψ) (j_a0 ≫ ι_P1) (le_of_eq hRange_ov_eq)
  let g₂ : AlgebraicGeometry.Spec (CommRingCat.of A_b0) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of A_a0) :=
    AlgebraicGeometry.IsOpenImmersion.lift (j_a0 ≫ ι_P1) (j_b0 ≫ ψ) (le_of_eq hRange_ov_eq.symm)
  have hg₁_fac : g₁ ≫ (j_b0 ≫ ψ) = j_a0 ≫ ι_P1 :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac (j_b0 ≫ ψ) (j_a0 ≫ ι_P1) (le_of_eq hRange_ov_eq)
  have hg₂_fac : g₂ ≫ (j_a0 ≫ ι_P1) = j_b0 ≫ ψ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac (j_a0 ≫ ι_P1) (j_b0 ≫ ψ) (le_of_eq hRange_ov_eq.symm)

  have hg₁₂ : g₁ ≫ g₂ = 𝟙 _ := by
    rw [← CategoryTheory.cancel_mono (j_a0 ≫ ι_P1), CategoryTheory.Category.assoc, hg₂_fac,
      hg₁_fac, CategoryTheory.Category.id_comp]
  have hg₂₁ : g₂ ≫ g₁ = 𝟙 _ := by
    rw [← CategoryTheory.cancel_mono (j_b0 ≫ ψ), CategoryTheory.Category.assoc, hg₁_fac,
      hg₂_fac, CategoryTheory.Category.id_comp]

  let φ₁_cat := AlgebraicGeometry.Spec.preimage g₁
  let φ₂_cat := AlgebraicGeometry.Spec.preimage g₂
  have hφ₂₁_cat : φ₂_cat ≫ φ₁_cat = 𝟙 _ := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, hg₁₂, AlgebraicGeometry.Spec.map_id]
  have hφ₁₂_cat : φ₁_cat ≫ φ₂_cat = 𝟙 _ := by
    apply AlgebraicGeometry.Spec.map_injective
    rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
      AlgebraicGeometry.Spec.map_preimage, hg₂₁, AlgebraicGeometry.Spec.map_id]

  let τ₀ : A_b0 ≃+* A_a0 :=
    RingEquiv.ofRingHom φ₁_cat.hom φ₂_cat.hom
      (congrArg CommRingCat.Hom.hom hφ₂₁_cat)
      (congrArg CommRingCat.Hom.hom hφ₁₂_cat)

  have hSpec_τ₀ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) = g₁ :=
    AlgebraicGeometry.Spec.map_preimage g₁

  have hGlue₀ : j_a0 ≫ ι_P1 =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫ (j_b0 ≫ ψ) := by
    rw [hSpec_τ₀, hg₁_fac]

  have hτ₀_C : ∀ c : k, τ₀ (ι_b0 (Polynomial.C c)) = ι_a0 (Polynomial.C c) := by
    have hcomp_k : (j_a0 ≫ ι_P1) ≫ p_k =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫ (j_b0 ≫ ψ)) ≫ p_k :=
      congrArg (· ≫ p_k) hGlue₀
    rw [CategoryTheory.Category.assoc, hOver₀,
      CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hOver_ψ] at hcomp_k
    dsimp [j_a0, j_b0] at hcomp_k
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp] at hcomp_k
    have hring := congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hcomp_k)
    intro c
    exact (congrArg (fun g : k →+* A_a0 => g c) hring).symm

  have hNoAff : ∀ α : Polynomial k →+* Polynomial k,
      α.comp Polynomial.C = Polynomial.C →
      τ₀.toRingHom.comp ι_b0 ≠ ι_a0.comp α := by
    intro α hα_C hα_comm
    have hSpec_comm : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫ j_b0 =
        j_a0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) := by
      dsimp [j_a0, j_b0]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 2
    have hDom_eq : j_a0 ≫ ι_P1 =
        j_a0 ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ ψ) := by
      rw [hGlue₀, ← CategoryTheory.Category.assoc, hSpec_comm, CategoryTheory.Category.assoc]
    have hDense_ja0 : DenseRange ⇑j_a0 := by
      change Dense (Set.range j_a0.base)
      rw [hRange_ja0]
      have hOpen_bo : IsOpen (PrimeSpectrum.basicOpen t_a : Set (PrimeSpectrum (Polynomial k))) :=
        (PrimeSpectrum.basicOpen t_a).isOpen
      have hNe_bo : (PrimeSpectrum.basicOpen t_a : Set (PrimeSpectrum (Polynomial k))).Nonempty := by
        refine ⟨(⊥ : PrimeSpectrum (Polynomial k)), ?_⟩
        change t_a ∉ (⊥ : PrimeSpectrum (Polynomial k)).asIdeal
        rw [PrimeSpectrum.asIdeal_bot, Ideal.mem_bot]
        exact Polynomial.X_sub_C_ne_zero a₀
      exact hOpen_bo.dense hNe_bo
    have : AlgebraicGeometry.IsDominant j_a0 := AlgebraicGeometry.IsDominant.mk hDense_ja0
    have hOver_αψ : ι_P1 ≫ p_k =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ ψ) ≫ p_k := by
      rw [hOver₀, CategoryTheory.Category.assoc, hOver_ψ, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, hα_C]
    have hEq_mor : ι_P1 = AlgebraicGeometry.Spec.map (CommRingCat.ofHom α) ≫ ψ :=
      AlgebraicGeometry.ext_of_isDominant_of_isSeparated p_k hOver_αψ j_a0 hDom_eq
    have hs_eq : s_ψ = (σ_a ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)) ≫ ψ := by
      rw [← hσ_a_fac, hEq_mor, CategoryTheory.Category.assoc]
    have hmem_ψ : s_ψ.base pt₀ ∈ Set.range ψ.base := by
      rw [hs_eq]
      exact ⟨(σ_a ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom α)).base pt₀, rfl⟩
    exact Set.disjoint_left.mp hDisj_ψ hmem_ψ ⟨pt₀, rfl⟩

  
  
  
  have h_pow_div : ∀ (N : ℕ) (a : k) (P Q : Polynomial k),
      P * Q = (Polynomial.X - Polynomial.C a) ^ N →
      ∃ (c : kˣ) (d : ℕ), P = Polynomial.C (c : k) * (Polynomial.X - Polynomial.C a) ^ d := by
    intro N
    induction N with
    | zero =>
      intro a P Q hPQ
      rw [pow_zero] at hPQ
      have huP : IsUnit P := ⟨⟨P, Q, hPQ, mul_comm P Q ▸ hPQ⟩, rfl⟩
      obtain ⟨r, hr, hrP⟩ := Polynomial.isUnit_iff.mp huP
      exact ⟨hr.unit, 0, by rw [pow_zero, mul_one]; exact hrP.symm⟩
    | succ N ih =>
      intro a P Q hPQ
      rw [pow_succ'] at hPQ
      have heval : Polynomial.eval a P * Polynomial.eval a Q = 0 := by
        rw [← Polynomial.eval_mul, hPQ]
        simp
      rcases mul_eq_zero.mp heval with hP0 | hQ0
      · have hroot : Polynomial.IsRoot P a := hP0
        obtain ⟨P₁, rfl⟩ := (Polynomial.dvd_iff_isRoot (a := a)).mpr hroot
        have hPQ₁ : P₁ * Q = (Polynomial.X - Polynomial.C a) ^ N := by
          apply mul_left_cancel₀ (Polynomial.X_sub_C_ne_zero a)
          calc
            (Polynomial.X - Polynomial.C a) * (P₁ * Q) =
                (Polynomial.X - Polynomial.C a) * P₁ * Q := (mul_assoc _ _ _).symm
            _ = (Polynomial.X - Polynomial.C a) * (Polynomial.X - Polynomial.C a) ^ N := hPQ
        obtain ⟨c, d, rfl⟩ := ih a P₁ Q hPQ₁
        refine ⟨c, d + 1, ?_⟩
        rw [pow_succ']
        ring
      · have hroot : Polynomial.IsRoot Q a := hQ0
        obtain ⟨Q₁, rfl⟩ := (Polynomial.dvd_iff_isRoot (a := a)).mpr hroot
        have hPQ₁ : P * Q₁ = (Polynomial.X - Polynomial.C a) ^ N := by
          apply mul_left_cancel₀ (Polynomial.X_sub_C_ne_zero a)
          calc
            (Polynomial.X - Polynomial.C a) * (P * Q₁) =
                P * ((Polynomial.X - Polynomial.C a) * Q₁) := by ring
            _ = (Polynomial.X - Polynomial.C a) * (Polynomial.X - Polynomial.C a) ^ N := hPQ
        exact ih a P Q₁ hPQ₁

  have h_away_inj : ∀ a : k,
      Function.Injective
        (algebraMap (Polynomial k) (Localization.Away (Polynomial.X - Polynomial.C a : Polynomial k))) := by
    intro a
    refine IsLocalization.injective _
      (M := Submonoid.powers (Polynomial.X - Polynomial.C a : Polynomial k))
      (Submonoid.powers_le.mpr ?_)
    exact mem_nonZeroDivisors_of_ne_zero (Polynomial.X_sub_C_ne_zero a)

  let u_gen : ∀ a : k, (Localization.Away (Polynomial.X - Polynomial.C a : Polynomial k))ˣ :=
    fun a => (IsLocalization.Away.algebraMap_isUnit (Polynomial.X - Polynomial.C a : Polynomial k)).unit
  let C_unit : ∀ a : k, kˣ →* (Localization.Away (Polynomial.X - Polynomial.C a : Polynomial k))ˣ :=
    fun a => Units.map
      ((algebraMap (Polynomial k)
        (Localization.Away (Polynomial.X - Polynomial.C a : Polynomial k))).comp
        Polynomial.C).toMonoidHom

  have h_unit_class : ∀ (a : k)
      (v : (Localization.Away (Polynomial.X - Polynomial.C a : Polynomial k))ˣ),
      ∃ (c : kˣ) (n : ℤ), v = C_unit a c * (u_gen a) ^ n := by
    intro a v
    let t : Polynomial k := Polynomial.X - Polynomial.C a
    let A := Localization.Away t
    let ι : Polynomial k →+* A := algebraMap (Polynomial k) A
    obtain ⟨⟨P, s₁⟩, hs₁⟩ := IsLocalization.surj (Submonoid.powers t) (v : A)
    obtain ⟨m₁, hm₁⟩ := s₁.2
    have hv₁ : (v : A) * ι (t ^ m₁) = ι P := by
      change (v : A) * ι ↑s₁ = ι P at hs₁
      rwa [← hm₁] at hs₁
    obtain ⟨⟨Q, s₂⟩, hs₂⟩ := IsLocalization.surj (Submonoid.powers t) (↑v⁻¹ : A)
    obtain ⟨m₂, hm₂⟩ := s₂.2
    have hv₂ : (↑v⁻¹ : A) * ι (t ^ m₂) = ι Q := by
      change (↑v⁻¹ : A) * ι ↑s₂ = ι Q at hs₂
      rwa [← hm₂] at hs₂
    have hPQ_loc : ι (P * Q) = ι (t ^ (m₁ + m₂)) := by
      rw [map_mul, ← hv₁, ← hv₂, pow_add, map_mul]
      calc
        (v : A) * ι (t ^ m₁) * ((↑v⁻¹ : A) * ι (t ^ m₂)) =
            ((v : A) * (↑v⁻¹ : A)) * (ι (t ^ m₁) * ι (t ^ m₂)) := by ring
        _ = ι (t ^ m₁) * ι (t ^ m₂) := by rw [Units.mul_inv, one_mul]
    have hPQ : P * Q = t ^ (m₁ + m₂) := h_away_inj a hPQ_loc
    obtain ⟨c, d, rfl⟩ := h_pow_div (m₁ + m₂) a P Q hPQ
    have hv_pow : v * (u_gen a) ^ m₁ = C_unit a c * (u_gen a) ^ d := by
      ext
      change (v : A) * (ι t) ^ m₁ = ι (Polynomial.C (c : k)) * (ι t) ^ d
      rw [← map_pow, hv₁, map_mul, map_pow]
    refine ⟨c, (d : ℤ) - (m₁ : ℤ), ?_⟩
    rw [zpow_sub, zpow_natCast, zpow_natCast, ← mul_assoc, ← hv_pow, mul_assoc,
      mul_inv_cancel, mul_one]

  obtain ⟨c, n, hτ_ub⟩ :=
    h_unit_class a₀ (Units.map τ₀.toRingHom.toMonoidHom (u_gen b₀))
  obtain ⟨c', n', hτ_symm_ua⟩ :=
    h_unit_class b₀ (Units.map τ₀.symm.toRingHom.toMonoidHom (u_gen a₀))

  have hτ₀_C_unit : ∀ d : kˣ,
      Units.map τ₀.toRingHom.toMonoidHom (C_unit b₀ d) = C_unit a₀ d := by
    intro d
    ext
    exact hτ₀_C (d : k)

  have hua_round : u_gen a₀ = C_unit a₀ (c' * c ^ n') * (u_gen a₀) ^ (n * n') := by
    have h1 := congrArg (Units.map τ₀.toRingHom.toMonoidHom) hτ_symm_ua
    have hLHS : Units.map τ₀.toRingHom.toMonoidHom
        (Units.map τ₀.symm.toRingHom.toMonoidHom (u_gen a₀)) = u_gen a₀ := by
      ext
      exact τ₀.apply_symm_apply _
    rw [hLHS, map_mul, hτ₀_C_unit, map_zpow, hτ_ub, mul_zpow, ← map_zpow, ← zpow_mul,
      ← mul_assoc, ← map_mul] at h1
    exact h1

  have hnn' : n * n' = 1 := by
    let c'' : kˣ := c' * c ^ n'
    have hua_M : u_gen a₀ = C_unit a₀ c'' * (u_gen a₀) ^ (n * n') := hua_round
    generalize n * n' = M at hua_M ⊢
    by_cases hM : 0 ≤ M
    · obtain ⟨m, rfl⟩ : ∃ m : ℕ, M = (m : ℤ) := ⟨M.toNat, by omega⟩
      have h_val : ι_a0 t_a = ι_a0 (Polynomial.C (c'' : k) * t_a ^ m) := by
        have h2 := congrArg Units.val hua_M
        change ι_a0 t_a = ι_a0 (Polynomial.C (c'' : k)) * ((u_gen a₀ ^ (m : ℤ) : A_a0ˣ) : A_a0) at h2
        rw [zpow_natCast, Units.val_pow_eq_pow_val] at h2
        change ι_a0 t_a = ι_a0 (Polynomial.C (c'' : k)) * (ι_a0 t_a) ^ m at h2
        rw [h2, map_mul, map_pow]
      have h_poly : t_a = Polynomial.C (c'' : k) * t_a ^ m := h_away_inj a₀ h_val
      have hdeg := congrArg Polynomial.natDegree h_poly
      have hC_ne : (Polynomial.C (c'' : k) : Polynomial k) ≠ 0 :=
        Polynomial.C_ne_zero.mpr c''.ne_zero
      have hpow_ne : t_a ^ m ≠ 0 := pow_ne_zero m (Polynomial.X_sub_C_ne_zero a₀)
      rw [Polynomial.natDegree_mul hC_ne hpow_ne, Polynomial.natDegree_C, zero_add,
        Polynomial.natDegree_pow] at hdeg
      have ht_deg : t_a.natDegree = 1 := Polynomial.natDegree_X_sub_C a₀
      rw [ht_deg, mul_one] at hdeg
      exact congrArg Nat.cast hdeg.symm
    · rw [not_le] at hM
      obtain ⟨K, hK⟩ : ∃ K : ℕ, M = -(K : ℤ) ∧ 1 ≤ K := ⟨(-M).toNat, by omega, by omega⟩
      rcases hK with ⟨hm_eq, _⟩
      have h_mul : u_gen a₀ * (u_gen a₀) ^ K = C_unit a₀ c'' := by
        calc
          u_gen a₀ * (u_gen a₀) ^ K =
              C_unit a₀ c'' * (u_gen a₀) ^ M * (u_gen a₀) ^ (K : ℤ) := by
            rw [← hua_M, zpow_natCast]
          _ = C_unit a₀ c'' := by
            rw [hm_eq, mul_assoc, zpow_neg, inv_mul_cancel, mul_one]
      have h_val : ι_a0 (t_a ^ (K + 1)) = ι_a0 (Polynomial.C (c'' : k)) := by
        have h2 := congrArg Units.val h_mul
        change ι_a0 t_a * ((u_gen a₀ ^ K : A_a0ˣ) : A_a0) = ι_a0 (Polynomial.C (c'' : k)) at h2
        rw [Units.val_pow_eq_pow_val] at h2
        change ι_a0 t_a * (ι_a0 t_a) ^ K = ι_a0 (Polynomial.C (c'' : k)) at h2
        rw [pow_succ', map_mul, map_pow]
        exact h2
      have h_poly : t_a ^ (K + 1) = Polynomial.C (c'' : k) := h_away_inj a₀ h_val
      have hdeg := congrArg Polynomial.natDegree h_poly
      rw [Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C a₀, mul_one,
        Polynomial.natDegree_C] at hdeg
      omega

  have hn_unit : IsUnit n := ⟨⟨n, n', hnn', mul_comm n n' ▸ hnn'⟩, rfl⟩
  rcases Int.isUnit_iff.mp hn_unit with hn1 | hn_neg1
  · exfalso
    have hτ_tb : τ₀ (ι_b0 t_b) = ι_a0 (Polynomial.C (c : k) * t_a) := by
      have h2 := congrArg Units.val hτ_ub
      rw [hn1, zpow_one] at h2
      change τ₀ (ι_b0 t_b) = ι_a0 (Polynomial.C (c : k)) * ι_a0 t_a at h2
      rw [h2, map_mul]
    have hτ_X : τ₀ (ι_b0 Polynomial.X) =
        ι_a0 (Polynomial.C (c : k) * t_a + Polynomial.C b₀) := by
      have hX_split : (Polynomial.X : Polynomial k) = t_b + Polynomial.C b₀ := by
        dsimp [t_b]; ring
      conv_lhs => rw [hX_split]
      rw [map_add, map_add, hτ_tb, hτ₀_C b₀, map_add]
    let α : Polynomial k →+* Polynomial k :=
      (Polynomial.aeval (Polynomial.C (c : k) * t_a + Polynomial.C b₀)).toRingHom
    have hα_C : α.comp Polynomial.C = Polynomial.C := by
      apply RingHom.ext
      intro d
      change (Polynomial.aeval (Polynomial.C (c : k) * t_a + Polynomial.C b₀)) (Polynomial.C d) =
        Polynomial.C d
      rw [Polynomial.aeval_C, Polynomial.algebraMap_eq]
    have hα_comm : τ₀.toRingHom.comp ι_b0 = ι_a0.comp α := by
      apply Polynomial.ringHom_ext
      · intro d
        simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, hτ₀_C d]
        have hαd : α (Polynomial.C d) = Polynomial.C d :=
          congrArg (fun g : k →+* Polynomial k => g d) hα_C
        rw [hαd]
      · simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
          RingHom.coe_coe, hτ_X]
        dsimp [α]
        rw [Polynomial.aeval_X]
    exact hNoAff α hα_C hα_comm

  
  have hτ_prod_raw : τ₀ (ι_b0 t_b) * ι_a0 t_a = ι_a0 (Polynomial.C (c : k)) := by
    have h_mul : Units.map τ₀.toRingHom.toMonoidHom (u_gen b₀) * u_gen a₀ = C_unit a₀ c := by
      rw [hτ_ub, hn_neg1, zpow_neg_one, mul_assoc, inv_mul_cancel, mul_one]
    exact congrArg Units.val h_mul

  let c_inv : k := ((c⁻¹ : kˣ) : k)
  have hc_mul : (c : k) * c_inv = 1 := c.mul_inv
  have hcinv_mul : c_inv * (c : k) = 1 := c.inv_mul

  let β_fwd : Polynomial k →+* Polynomial k :=
    (Polynomial.aeval (Polynomial.C c_inv * (Polynomial.X - Polynomial.C b₀))).toRingHom
  let β_bwd : Polynomial k →+* Polynomial k :=
    (Polynomial.aeval (Polynomial.C (c : k) * Polynomial.X + Polynomial.C b₀)).toRingHom

  have hβ_fwd_C : ∀ d : k, β_fwd (Polynomial.C d) = Polynomial.C d := by
    intro d
    dsimp [β_fwd]
    rw [Polynomial.aeval_C, Polynomial.algebraMap_eq]
  have hβ_bwd_C : ∀ d : k, β_bwd (Polynomial.C d) = Polynomial.C d := by
    intro d
    dsimp [β_bwd]
    rw [Polynomial.aeval_C, Polynomial.algebraMap_eq]
  have hβ_fwd_X : β_fwd Polynomial.X = Polynomial.C c_inv * (Polynomial.X - Polynomial.C b₀) := by
    dsimp [β_fwd]
    exact Polynomial.aeval_X _
  have hβ_bwd_X : β_bwd Polynomial.X = Polynomial.C (c : k) * Polynomial.X + Polynomial.C b₀ := by
    dsimp [β_bwd]
    exact Polynomial.aeval_X _

  have hβ_bf : β_bwd.comp β_fwd = RingHom.id (Polynomial k) := by
    apply Polynomial.ringHom_ext
    · intro d
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hβ_fwd_C, hβ_bwd_C]
    · simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hβ_fwd_X,
        map_mul, map_sub, hβ_bwd_C, hβ_bwd_X]
      calc
        Polynomial.C c_inv *
            (Polynomial.C (c : k) * Polynomial.X + Polynomial.C b₀ - Polynomial.C b₀) =
          Polynomial.C (c_inv * (c : k)) * Polynomial.X := by
          rw [Polynomial.C_mul]; ring
        _ = Polynomial.X := by rw [hcinv_mul, map_one, one_mul]

  have hβ_fb : β_fwd.comp β_bwd = RingHom.id (Polynomial k) := by
    apply Polynomial.ringHom_ext
    · intro d
      simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hβ_bwd_C, hβ_fwd_C]
    · simp only [RingHom.coe_comp, Function.comp_apply, RingHom.id_apply, hβ_bwd_X,
        map_add, map_mul, hβ_fwd_C, hβ_fwd_X]
      calc
        Polynomial.C (c : k) * (Polynomial.C c_inv * (Polynomial.X - Polynomial.C b₀)) +
            Polynomial.C b₀ =
          Polynomial.C ((c : k) * c_inv) * (Polynomial.X - Polynomial.C b₀) + Polynomial.C b₀ := by
          rw [Polynomial.C_mul]; ring
        _ = Polynomial.X := by rw [hc_mul, map_one, one_mul, sub_add_cancel]

  let β : Polynomial k ≃+* Polynomial k :=
    RingEquiv.ofRingHom β_fwd β_bwd hβ_fb hβ_bf

  let A_0 := Localization.Away (Polynomial.X : Polynomial k)
  let ι_0 : Polynomial k →+* A_0 := algebraMap (Polynomial k) A_0

  have hUnit_fwd : IsUnit ((ι_b0.comp β_fwd) Polynomial.X) := by
    rw [RingHom.coe_comp, Function.comp_apply, hβ_fwd_X]
    change IsUnit (ι_b0 (Polynomial.C c_inv * t_b))
    rw [map_mul]
    exact (C_unit b₀ c⁻¹ * u_gen b₀).isUnit

  have hβ_bwd_tb : β_bwd t_b = Polynomial.C (c : k) * Polynomial.X := by
    dsimp [t_b]
    rw [map_sub, hβ_bwd_X, hβ_bwd_C, add_sub_cancel_right]

  have hUnit_bwd : IsUnit ((ι_0.comp β_bwd) t_b) := by
    rw [RingHom.coe_comp, Function.comp_apply, hβ_bwd_tb, map_mul]
    have huC : IsUnit (ι_0 (Polynomial.C (c : k))) :=
      (Units.map (ι_0.comp Polynomial.C).toMonoidHom c).isUnit
    exact huC.mul (IsLocalization.Away.algebraMap_isUnit (Polynomial.X : Polynomial k))

  let L_fwd : A_0 →+* A_b0 := IsLocalization.Away.lift (Polynomial.X : Polynomial k) hUnit_fwd
  let L_bwd : A_b0 →+* A_0 := IsLocalization.Away.lift t_b hUnit_bwd

  have hL_fwd_comp : L_fwd.comp ι_0 = ι_b0.comp β_fwd := by
    apply RingHom.ext
    intro f
    rw [RingHom.coe_comp, Function.comp_apply]
    dsimp only [L_fwd, ι_0]
    exact IsLocalization.Away.lift_eq (S := A_0) (Polynomial.X : Polynomial k) hUnit_fwd f
  have hL_bwd_comp : L_bwd.comp ι_b0 = ι_0.comp β_bwd := by
    apply RingHom.ext
    intro f
    rw [RingHom.coe_comp, Function.comp_apply]
    dsimp only [L_bwd, ι_b0]
    exact IsLocalization.Away.lift_eq (S := A_b0) t_b hUnit_bwd f

  have hL_bf : L_bwd.comp L_fwd = RingHom.id A_0 := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (Polynomial.X : Polynomial k))
    rw [RingHom.comp_assoc, hL_fwd_comp, ← RingHom.comp_assoc, hL_bwd_comp,
      RingHom.comp_assoc, hβ_bf, RingHom.comp_id, RingHom.id_comp]
  have hL_fb : L_fwd.comp L_bwd = RingHom.id A_b0 := by
    apply IsLocalization.ringHom_ext (Submonoid.powers t_b)
    rw [RingHom.comp_assoc, hL_bwd_comp, ← RingHom.comp_assoc, hL_fwd_comp,
      RingHom.comp_assoc, hβ_fb, RingHom.comp_id, RingHom.id_comp]

  let β_loc : A_0 ≃+* A_b0 :=
    RingEquiv.ofRingHom L_fwd L_bwd hL_fb hL_bf

  
  
  
  let spec_β : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom β.symm.toRingHom)
  let ι_inf : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) ⟶ P1.left :=
    spec_β ≫ ψ
  let τ_inv : A_0 ≃+* A_a0 := β_loc.trans τ₀

  have hRange_inf : Set.range ι_inf.base = Set.range ψ.base :=
    hRange_comp_iso β ψ

  refine ⟨a₀, ι_inf, τ_inv, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · 
    have : CategoryTheory.IsIso spec_β := hIso_ring β
    have : AlgebraicGeometry.IsOpenImmersion spec_β := inferInstance
    exact AlgebraicGeometry.IsOpenImmersion.comp spec_β ψ
  · 
    dsimp [ι_inf, spec_β]
    rw [CategoryTheory.Category.assoc, hOver_ψ, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp]
    congr 2
    apply RingHom.ext
    intro d
    exact hβ_bwd_C d
  · 
    rw [hRange_inf]
    exact hCov_ψ
  · 
    rw [hRange_inf]
    exact hPre₀_ψ
  · 
    ext q
    have hq_pre : q ∈ ι_inf.base ⁻¹' (Set.range ι_P1.base) ↔
        spec_β.base q ∈ ψ.base ⁻¹' (Set.range ι_P1.base) := Iff.rfl
    rw [hq_pre, hPre_ψ]
    change β_bwd t_b ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal ↔
      Polynomial.X ∉ (q : PrimeSpectrum (Polynomial k)).asIdeal
    rw [hβ_bwd_tb]
    constructor
    · intro hnot hX
      exact hnot (Ideal.mul_mem_left _ _ hX)
    · intro hnot hmul
      apply hnot
      have hmul_inv : Polynomial.C c_inv * (Polynomial.C (c : k) * Polynomial.X) ∈
          (q : PrimeSpectrum (Polynomial k)).asIdeal :=
        Ideal.mul_mem_left _ (Polynomial.C c_inv) hmul
      rwa [← mul_assoc, ← Polynomial.C_mul, hcinv_mul, map_one, one_mul] at hmul_inv
  · 
    intro d
    change τ₀ (L_fwd (ι_0 (Polynomial.C d))) = ι_a0 (Polynomial.C d)
    have hLfC : L_fwd (ι_0 (Polynomial.C d)) = ι_b0 (Polynomial.C d) := by
      change (L_fwd.comp ι_0) (Polynomial.C d) = ι_b0 (Polynomial.C d)
      rw [hL_fwd_comp, RingHom.coe_comp, Function.comp_apply, hβ_fwd_C]
    rw [hLfC, hτ₀_C d]
  · 
    change τ₀ (L_fwd (ι_0 Polynomial.X)) * ι_a0 t_a = 1
    have hLfX : L_fwd (ι_0 Polynomial.X) = ι_b0 (Polynomial.C c_inv * t_b) := by
      change (L_fwd.comp ι_0) Polynomial.X = ι_b0 (Polynomial.C c_inv * t_b)
      rw [hL_fwd_comp, RingHom.coe_comp, Function.comp_apply, hβ_fwd_X]
    rw [hLfX, map_mul, map_mul, mul_assoc, hτ_prod_raw, hτ₀_C c_inv, ← map_mul,
      ← Polynomial.C_mul, hcinv_mul, map_one, map_one]
  · 
    let j_0 : AlgebraicGeometry.Spec (CommRingCat.of A_0) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_0)
    change j_a0 ≫ ι_P1 =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ₀.toRingHom.comp L_fwd)) ≫
        (j_0 ≫ (spec_β ≫ ψ))
    have hSpec_trans :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ₀.toRingHom.comp L_fwd)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom L_fwd) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
    have hSpec_Lfwd :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom L_fwd) ≫ j_0 =
          j_b0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_fwd) := by
      dsimp [j_0, j_b0]
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hL_fwd_comp]
    have hSpec_β_cancel :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_fwd) ≫ spec_β = 𝟙 _ := by
      dsimp only [spec_β]
      rw [← AlgebraicGeometry.Spec.map_comp]
      have hid : CommRingCat.ofHom β.symm.toRingHom ≫ CommRingCat.ofHom β_fwd = 𝟙 _ :=
        CommRingCat.hom_ext hβ_fb
      rw [hid, AlgebraicGeometry.Spec.map_id]
    calc
      j_a0 ≫ ι_P1 =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫ (j_b0 ≫ ψ) := hGlue₀
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫
            (j_b0 ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_fwd) ≫ spec_β) ≫ ψ) := by
          rw [hSpec_β_cancel, CategoryTheory.Category.id_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫
            ((j_b0 ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom β_fwd)) ≫ (spec_β ≫ ψ)) := by
          simp only [CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀.toRingHom) ≫
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom L_fwd) ≫ j_0) ≫ (spec_β ≫ ψ)) := by
          rw [← hSpec_Lfwd]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (τ₀.toRingHom.comp L_fwd)) ≫
            (j_0 ≫ (spec_β ≫ ψ)) := by
          rw [hSpec_trans]
          simp only [CategoryTheory.Category.assoc]

theorem weil_polyP1_last_coord_etale_domain_integral_closure_pkg (k : Type u) [Field k] [IsAlgClosed k]
    (a₀ : k)
    (B : Type u) [CommRing B] [IsDomain B]
    (φ : Polynomial k →+* B) (hEt : φ.Etale) :
    let K := FractionRing B
    let κ_K : k →+* K := (algebraMap B K).comp (φ.comp Polynomial.C)
    let u₀ : K := algebraMap B K (φ (Polynomial.X - Polynomial.C a₀))
    IsIntegrallyClosed B ∧
    Function.Injective φ ∧
    u₀ ≠ 0 ∧
    ∃ d : ℕ,
      1 ≤ d ∧
      (∀ (S : Type u) [CommRing S] [IsDomain S] [IsIntegrallyClosed S]
          (ρ : Polynomial k →+* S) (ι_S : S →+* K),
        @IsFractionRing S _ K _ ι_S.toAlgebra →
        (ι_S.comp ρ = (algebraMap B K).comp φ ∨
          (ι_S.comp (ρ.comp Polynomial.C) = κ_K ∧ ι_S (ρ Polynomial.X) * u₀ = 1)) →
        letI : Algebra (Polynomial k) S := ρ.toAlgebra
        let A := ↥(integralClosure (Polynomial k) S)
        IsDomain A ∧
        IsIntegrallyClosed A ∧
        IsNoetherianRing A ∧
        ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) ∧
        ((algebraMap (Polynomial k) A).comp Polynomial.C).FiniteType ∧
        @IsFractionRing A _ K _
          (ι_S.comp (Subalgebra.val (integralClosure (Polynomial k) S)).toRingHom).toAlgebra ∧
        (algebraMap (Polynomial k) A).Finite ∧
        ∃ (M : Type u) (_ : AddCommGroup M) (_ : Module (Polynomial k) M) (e : M ≃+ A),
          (∀ (p : Polynomial k) (m : M), e (p • m) = algebraMap (Polynomial k) A p * e m) ∧
          Nonempty (Module.Basis (Fin d) (Polynomial k) M)) ∧
      (letI : Algebra (Polynomial k) B := φ.toAlgebra
       let A₀ := ↥(integralClosure (Polynomial k) B)
       let j_B : A₀ →+* B := (Subalgebra.val (integralClosure (Polynomial k) B)).toRingHom
       ∀ q : PrimeSpectrum B,
         ∃ (s : A₀) (j_loc : Localization.Away s →+* Localization.Away (j_B s)),
           j_B s ∉ q.asIdeal ∧
           Function.Bijective j_loc ∧
           j_loc.comp (algebraMap A₀ (Localization.Away s)) =
             (algebraMap B (Localization.Away (j_B s))).comp j_B) ∧
      (∀ (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A] [IsNoetherianRing A],
        ringKrullDim A = ((1 : ℕ) : WithBot ℕ∞) →
        ∀ (ι_A : A →+* K),
          @IsFractionRing A _ K _ ι_A.toAlgebra →
          (∀ c : k, ∃ a : A, ι_A a = κ_K c) →
          ∀ (p : PrimeSpectrum A)
            (S₀ S₁ : Type u) [CommRing S₀] [IsDomain S₀] [IsIntegrallyClosed S₀]
            [CommRing S₁] [IsDomain S₁] [IsIntegrallyClosed S₁]
            (ρ₀ : Polynomial k →+* S₀) (ι_S₀ : S₀ →+* K)
            (ρ₁ : Polynomial k →+* S₁) (ι_S₁ : S₁ →+* K),
            @IsFractionRing S₀ _ K _ ι_S₀.toAlgebra →
            ι_S₀.comp ρ₀ = (algebraMap B K).comp φ →
            @IsFractionRing S₁ _ K _ ι_S₁.toAlgebra →
            ι_S₁.comp (ρ₁.comp Polynomial.C) = κ_K →
            ι_S₁ (ρ₁ Polynomial.X) * u₀ = 1 →
            letI : Algebra (Polynomial k) S₀ := ρ₀.toAlgebra
            letI : Algebra (Polynomial k) S₁ := ρ₁.toAlgebra
            let D₀ := ↥(integralClosure (Polynomial k) S₀)
            let D₁ := ↥(integralClosure (Polynomial k) S₁)
            ∃ (s : A) (ι_As : Localization.Away s →+* K),
              s ∉ p.asIdeal ∧
              ι_As.comp (algebraMap A (Localization.Away s)) = ι_A ∧
              ((∃ γ₀ : D₀ →+* Localization.Away s,
                  ι_As.comp γ₀ =
                    ι_S₀.comp (Subalgebra.val (integralClosure (Polynomial k) S₀)).toRingHom) ∨
                (∃ γ₁ : D₁ →+* Localization.Away s,
                  ι_As.comp γ₁ =
                    ι_S₁.comp (Subalgebra.val (integralClosure (Polynomial k) S₁)).toRingHom))) :=
by
  have h_s1 : ∀ (F₀ : Type u) [Field F₀] [Algebra (Polynomial k) F₀]
      [IsFractionRing (Polynomial k) F₀]
      (K₀ : Type u) [Field K₀] [Algebra B K₀] [IsFractionRing B K₀],
      IsIntegrallyClosed B ∧
      Function.Injective φ ∧
      φ.FiniteType ∧
      ∃ (d : ℕ) (φ_K : F₀ →+* K₀),
        1 ≤ d ∧
        φ_K.comp (algebraMap (Polynomial k) F₀) = (algebraMap B K₀).comp φ ∧
        @FiniteDimensional F₀ K₀ _ _ φ_K.toAlgebra.toModule ∧
        @Algebra.IsSeparable F₀ K₀ _ _ φ_K.toAlgebra ∧
        @Module.finrank F₀ K₀ _ _ φ_K.toAlgebra.toModule = d := by
    intro F₀ _ _ _ K₀ _ _ _
    letI : Algebra (Polynomial k) B := φ.toAlgebra
    haveI : Algebra.Etale (Polynomial k) B := hEt
    have hFT_alg : Algebra.FiniteType (Polynomial k) B := inferInstance
    have hFT_φ : φ.FiniteType := hFT_alg
    haveI : Module.IsTorsionFree (Polynomial k) B := inferInstance
    have hInj_φ : Function.Injective φ :=
      (Module.isTorsionFree_iff_algebraMap_injective (R := Polynomial k) (A := B)).mp inferInstance
    have hIC_B : IsIntegrallyClosed B := by
      apply IsIntegrallyClosed.of_localization_maximal
      intro q hq_ne hq_max
      let p : Ideal (Polynomial k) := Ideal.comap φ q
      haveI : p.IsPrime := Ideal.comap_isPrime φ q
      let R₁ := Localization.AtPrime p
      let R₂ := Localization.AtPrime q
      haveI : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing (Polynomial k) B
      haveI : IsNoetherianRing R₂ :=
        IsLocalization.isNoetherianRing q.primeCompl R₂ inferInstance
      have hCompl_q : q.primeCompl ≤ nonZeroDivisors B := Ideal.primeCompl_le_nonZeroDivisors q
      haveI : IsDomain R₂ := IsLocalization.isDomain_localization hCompl_q
      have hInj_R₂ : Function.Injective (algebraMap B R₂) := IsLocalization.injective R₂ hCompl_q
      let ψ_loc : R₁ →+* R₂ := Localization.localRingHom p q φ rfl
      letI : Algebra R₁ R₂ := ψ_loc.toAlgebra
      haveI : IsScalarTower (Polynomial k) R₁ R₂ :=
        IsScalarTower.of_algebraMap_eq fun x =>
          (IsScalarTower.algebraMap_apply (Polynomial k) B R₂ x).trans
            (Localization.localRingHom_to_map p q φ rfl x).symm
      haveI : IsLocalHom (algebraMap R₁ R₂) := Localization.isLocalHom_localRingHom p q φ rfl
      haveI : Algebra.EssFiniteType (Polynomial k) R₂ :=
        Algebra.EssFiniteType.comp (Polynomial k) B R₂
      haveI : Algebra.EssFiniteType R₁ R₂ := Algebra.EssFiniteType.of_comp (Polynomial k) R₁ R₂
      haveI : Algebra.FormallyUnramified (Polynomial k) R₂ :=
        Algebra.FormallyUnramified.comp (Polynomial k) B R₂
      haveI : Algebra.FormallyUnramified R₁ R₂ :=
        Algebra.FormallyUnramified.localization_base p.primeCompl
      have hMaxMap : Ideal.map (algebraMap R₁ R₂) (IsLocalRing.maximalIdeal R₁) =
          IsLocalRing.maximalIdeal R₂ :=
        Algebra.FormallyUnramified.map_maximalIdeal
      let g₀ : Polynomial k := Submodule.IsPrincipal.generator p
      have hp_span : p = Ideal.span {g₀} := (Submodule.IsPrincipal.span_singleton_generator p).symm
      have hm₁ : IsLocalRing.maximalIdeal R₁ = Ideal.span {algebraMap (Polynomial k) R₁ g₀} := by
        rw [← IsLocalization.AtPrime.map_eq_maximalIdeal p R₁,
          congrArg (Ideal.map (algebraMap (Polynomial k) R₁)) hp_span,
          Ideal.map_span, Set.image_singleton]
      have hm₂ : IsLocalRing.maximalIdeal R₂ =
          Ideal.span {algebraMap R₁ R₂ (algebraMap (Polynomial k) R₁ g₀)} := by
        rw [← hMaxMap, hm₁, Ideal.map_span, Set.image_singleton]
      have hPrin : (IsLocalRing.maximalIdeal R₂).IsPrincipal := ⟨⟨_, hm₂⟩⟩
      have hNotField : ¬ IsField R₂ := by
        intro hF
        have hm_bot : IsLocalRing.maximalIdeal R₂ = ⊥ :=
          IsLocalRing.isField_iff_maximalIdeal_eq.mp hF
        have hex_q : ∃ x ∈ q, x ≠ (0 : B) := by
          by_contra! hall
          exact hq_ne (le_antisymm (fun x hx => by rw [hall x hx]; exact Submodule.zero_mem ⊥) bot_le)
        obtain ⟨x, hx_q, hx_ne⟩ := hex_q
        have hx_mem : algebraMap B R₂ x ∈ IsLocalRing.maximalIdeal R₂ := by
          rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q R₂]
          exact Ideal.mem_map_of_mem _ hx_q
        rw [hm_bot, Submodule.mem_bot] at hx_mem
        exact hx_ne (hInj_R₂ (hx_mem.trans (map_zero _).symm))
      have hTFAE : (IsLocalRing.maximalIdeal R₂).IsPrincipal → IsDiscreteValuationRing R₂ :=
        ((IsDiscreteValuationRing.TFAE R₂ hNotField).out 5 1).mp
      haveI : IsDiscreteValuationRing R₂ := hTFAE hPrin
      infer_instance
    have hInj_BK : Function.Injective (algebraMap B K₀) := IsFractionRing.injective B K₀
    let ψ₀ : Polynomial k →+* K₀ := (algebraMap B K₀).comp φ
    have hInj_ψ₀ : Function.Injective ψ₀ := hInj_BK.comp hInj_φ
    have hUnits_F₀ : ∀ y : nonZeroDivisors (Polynomial k), IsUnit (ψ₀ y.1) := by
      intro y
      have hy_ne : (y : Polynomial k) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
      exact Ne.isUnit (fun h0 => hy_ne (hInj_ψ₀ (h0.trans (map_zero ψ₀).symm)))
    let φ_K : F₀ →+* K₀ := IsLocalization.lift (M := nonZeroDivisors (Polynomial k)) hUnits_F₀
    have hφ_K : φ_K.comp (algebraMap (Polynomial k) F₀) = ψ₀ :=
      RingHom.ext (IsLocalization.lift_eq hUnits_F₀)
    letI : Algebra F₀ K₀ := φ_K.toAlgebra
    letI : Algebra (Polynomial k) K₀ := ψ₀.toAlgebra
    haveI : IsScalarTower (Polynomial k) B K₀ := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower (Polynomial k) F₀ K₀ := IsScalarTower.of_algebraMap_eq' hφ_K.symm
    let E := TensorProduct (Polynomial k) F₀ B
    haveI : Algebra.Etale F₀ E := inferInstance
    let ψ_E : E →ₐ[F₀] K₀ :=
      Algebra.TensorProduct.lift (Algebra.ofId F₀ K₀)
        (IsScalarTower.toAlgHom (Polynomial k) B K₀) (fun _ _ => Commute.all _ _)
    have hψ_E_one : ∀ b : B, ψ_E ((1 : F₀) ⊗ₜ[Polynomial k] b) = algebraMap B K₀ b := by
      intro b
      change (Algebra.ofId F₀ K₀ 1) * (IsScalarTower.toAlgHom (Polynomial k) B K₀ b) =
        algebraMap B K₀ b
      rw [map_one, one_mul]
      rfl
    have hClear_E : ∀ z : E, ∃ (s : nonZeroDivisors (Polynomial k)) (b : B),
        algebraMap F₀ E (algebraMap (Polynomial k) F₀ s.1) * z = (1 : F₀) ⊗ₜ[Polynomial k] b := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero =>
        exact ⟨1, 0, by rw [mul_zero, TensorProduct.tmul_zero]⟩
      | tmul f b =>
        obtain ⟨⟨p, s⟩, hfs⟩ := IsLocalization.surj (nonZeroDivisors (Polynomial k)) f
        dsimp only at hfs
        refine ⟨s, φ p * b, ?_⟩
