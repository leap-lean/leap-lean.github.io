    refine (hMemSmallEtale Z U _).mpr fun x => ?_
    obtain ⟨U_x, hAff, hx, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := x) (U := (⊤ : U.left.Opens)) trivial
    have hmem_range : x ∈ Set.range hAff.fromSpec.base := by
      rw [hAff.range_fromSpec]
      exact hx
    obtain ⟨p₀, hp₀⟩ := hmem_range
    let R_cat := U.left.presheaf.obj (Opposite.op U_x)
    have : AlgebraicGeometry.Etale U.hom := U.prop
