      (CategoryTheory.Functor.whiskeringLeft (P_m.left.Etale)ᵒᵖ
        (P.left.Etale)ᵒᵖ AddCommGrpCat.{u}).obj B_f.op
    let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
    let Φ_b : CategoryTheory.Sheaf J_X AddCommGrpCat.{u} ⥤
