          have ht_β : t_Z ≫ b_l β₁ = t_Z ≫ b_l β₂ := by
            have ht_eq' : t_u ≫ (U_star.ι ≫ b_l β₁) = t_u ≫ (U_star.ι ≫ b_l β₂) := ht_eq
            dsimp only [t_Z]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
            exact ht_eq'
