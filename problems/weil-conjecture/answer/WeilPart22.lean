                    (CategoryTheory.Category.id_comp p_P).symm))))))
    · exact (CategoryTheory.Category.assoc ψ_iso φ_iso q_P).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp ψ_iso)
            (CategoryTheory.Limits.pullback.lift_snd _ _ hφ_comm)).trans
          ((CategoryTheory.Category.assoc ψ_iso q_W π_leg_σ).symm.trans
            ((congrArg (fun m => m ≫ π_leg_σ)
                (CategoryTheory.Limits.pullback.lift_snd (p_P ≫ e_leg.inv) ψ_W _)).trans
              ((CategoryTheory.Category.assoc ψ_W g'_W (π_leg ≫ π_snd)).symm.trans
                ((congrArg (fun m => m ≫ (π_leg ≫ π_snd))
                    (CategoryTheory.Limits.pullback.lift_fst _ _ hψW_comm)).trans
                  ((CategoryTheory.Category.assoc (p_P ≫ e_leg.inv) (Fgt_W.obj U_W).hom (π_leg ≫ π_snd)).trans
                    ((congrArg (CategoryTheory.CategoryStruct.comp (p_P ≫ e_leg.inv))
                        ((CategoryTheory.Category.assoc (Fgt_W.obj U_W).hom π_leg π_snd).symm.trans
