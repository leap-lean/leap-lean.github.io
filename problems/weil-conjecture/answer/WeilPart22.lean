      congrArg (fun u => CategoryTheory.CategoryStruct.comp u
        ((C₁.obj A).obj.map (Opposite.op (hT₁'.from (B.obj T₂'))))) hUnit₁
    have heq3 : CategoryTheory.CategoryStruct.comp
