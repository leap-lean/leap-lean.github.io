              CategoryTheory.Limits.pullback.fst (B_g.obj Z).hom f' ≫
                CategoryTheory.Limits.pullback.fst Z.hom g :=
            (congrArg (· ≫ (p_fst1 ≫ p_fst2)) he_inv_left).trans
              ((CategoryTheory.Category.assoc (e3.inv.app Z).left _ (p_fst1 ≫ p_fst2)).trans
                ((congrArg ((e3.inv.app Z).left ≫ ·)
                  ((CategoryTheory.Category.assoc (e2.inv.app Z).left (e1.hom.app Z).left
                    (p_fst1 ≫ p_fst2)).trans
                    ((congrArg ((e2.inv.app Z).left ≫ ·) hc1).trans hc2))).trans hc3))
          have h_chain3 : p_eta ≫
              (CategoryTheory.Limits.pullback.fst (B_g.obj Z).hom f' ≫
