theorem weil_polyP1_const_to_higherDirectImage_eq_of_term {S₀ Y₀ : AlgebraicGeometry.Scheme.{u}} (f₀ : Quiver.Hom Y₀ S₀) (n : ℕ) :
    (∃ (T_S : S₀.Etale) (_ : CategoryTheory.Limits.IsTerminal T_S),
      Nonempty (CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f₀).obj T_S))) ∧
    (∀ (F₁ F₂ : CategoryTheory.Sheaf Y₀.smallEtaleTopology AddCommGrpCat.{u})
       (β : Quiver.Hom F₁ F₂)
       (e_hom : Quiver.Hom (weilEtaleHigherDirectImage f₀ 2 F₂) (weilEtaleHigherDirectImage f₀ 2 F₁))
       (γ : Quiver.Hom (weilEtaleTorsionSheaf S₀ n) (weilEtaleHigherDirectImage f₀ 2 F₁))
       (T_S : S₀.Etale) (hT_S : CategoryTheory.Limits.IsTerminal T_S)
       (hT_top : CategoryTheory.Limits.IsTerminal ((weilEtaleSitePullback f₀).obj T_S))
       (c : F₁.H 2),
      let Q₁ : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u} :=
        CategoryTheory.Sheaf.cohomologyPresheaf F₁ 2
      let Q₂ : CategoryTheory.Functor (Opposite Y₀.Etale) AddCommGrpCat.{u} :=
        CategoryTheory.Sheaf.cohomologyPresheaf F₂ 2
      let P₁ : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
        CategoryTheory.Functor.comp (weilEtaleSitePullback f₀).op Q₁
      let P₂ : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
        CategoryTheory.Functor.comp (weilEtaleSitePullback f₀).op Q₂
      let η₁ := (CategoryTheory.sheafificationAdjunction S₀.smallEtaleTopology AddCommGrpCat.{u}).unit.app P₁
      let η₂ := (CategoryTheory.sheafificationAdjunction S₀.smallEtaleTopology AddCommGrpCat.{u}).unit.app P₂
      let s₀ : ↑(Q₁.obj (Opposite.op ((weilEtaleSitePullback f₀).obj T_S))) :=
        weilPolyP1CohomologyTermToPresheaf Y₀ ((weilEtaleSitePullback f₀).obj T_S) hT_top F₁ 2 c
      let s₁ : ↑(Q₂.obj (Opposite.op ((weilEtaleSitePullback f₀).obj T_S))) :=
        (((CategoryTheory.Sheaf.cohomologyPresheafFunctor Y₀.smallEtaleTopology 2).map β).app
          (Opposite.op ((weilEtaleSitePullback f₀).obj T_S))) s₀
      ((CategoryTheory.constantSheafAdj S₀.smallEtaleTopology AddCommGrpCat.{u} hT_S).homEquiv
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n)))
        (weilEtaleHigherDirectImage f₀ 2 F₁) γ) (ULift.up 1) = (η₁.app (Opposite.op T_S)) s₀ →
      (e_hom.hom.app (Opposite.op T_S)) ((η₂.app (Opposite.op T_S)) s₁) = (η₁.app (Opposite.op T_S)) s₀ →
      CategoryTheory.CategoryStruct.comp γ
        (CategoryTheory.CategoryStruct.comp (weilPolyP1HigherDirectImageMap f₀ 2 β) e_hom) = γ) :=
by
  refine ⟨⟨weilEtaleIdTerminal.{u} S₀, weilEtaleIdTerminalIsTerminal.{u} S₀, ?_⟩, ?_⟩
  · refine ⟨CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun V =>
        let v_hom : Quiver.Hom V.left Y₀ := V.hom
        CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift (v_hom ≫ f₀) v_hom (CategoryTheory.Category.comp_id _))
          (CategoryTheory.Limits.pullback.lift_snd _ _ _)
          trivial)
      (fun V m => by
        let v_hom : Quiver.Hom V.left Y₀ := V.hom
        let m_left : Quiver.Hom V.left (CategoryTheory.Limits.pullback (𝟙 S₀) f₀) := m.left
        have hm_snd : m_left ≫ CategoryTheory.Limits.pullback.snd (𝟙 S₀) f₀ = v_hom :=
          CategoryTheory.MorphismProperty.Over.w m
        have h_eq : m_left = CategoryTheory.Limits.pullback.lift (v_hom ≫ f₀) v_hom
            (CategoryTheory.Category.comp_id _) := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Limits.pullback.lift_fst, ← CategoryTheory.Category.comp_id (m_left ≫ _),
              CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition (f := 𝟙 S₀) (g := f₀),
              ← CategoryTheory.Category.assoc, hm_snd]
          · rw [CategoryTheory.Limits.pullback.lift_snd, hm_snd]
        exact CategoryTheory.MorphismProperty.Comma.Hom.ext h_eq (Subsingleton.elim _ _))⟩
  · intro F₁ F₂ β e_hom γ T_S hT_S hT_top c
    dsimp only
    intro hγ1 he1
    let J_S := S₀.smallEtaleTopology
    let adj_S := CategoryTheory.constantSheafAdj J_S AddCommGrpCat.{u} hT_S
    let A_M := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let R₁ := weilEtaleHigherDirectImage f₀ 2 F₁
    let ψ := weilPolyP1HigherDirectImageMap f₀ 2 β
    let Q₁ := CategoryTheory.Sheaf.cohomologyPresheaf F₁ 2
    let Q₂ := CategoryTheory.Sheaf.cohomologyPresheaf F₂ 2
    let P₁ : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback f₀).op Q₁
    let P₂ : CategoryTheory.Functor (Opposite S₀.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp (weilEtaleSitePullback f₀).op Q₂
    let η₁ := (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app P₁
    let η₂ := (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.app P₂
    let s₀ : ↑(Q₁.obj (Opposite.op ((weilEtaleSitePullback f₀).obj T_S))) :=
      weilPolyP1CohomologyTermToPresheaf Y₀ ((weilEtaleSitePullback f₀).obj T_S) hT_top F₁ 2 c
    let θ_pre : P₁ ⟶ P₂ :=
      CategoryTheory.Functor.whiskerLeft (weilEtaleSitePullback f₀).op
        ((CategoryTheory.Sheaf.cohomologyPresheafFunctor Y₀.smallEtaleTopology 2).map β)
    have hψ_nat : (ψ.hom.app (Opposite.op T_S)) ((η₁.app (Opposite.op T_S)) s₀) =
        (η₂.app (Opposite.op T_S)) (θ_pre.app (Opposite.op T_S) s₀) := by
      have hnat := (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).unit.naturality θ_pre
      exact (CategoryTheory.ConcreteCategory.congr_hom (NatTrans.congr_app hnat (Opposite.op T_S)) s₀).symm
    have h1_eq : (adj_S.homEquiv A_M R₁ (γ ≫ (ψ ≫ e_hom))) (ULift.up (1 : ZMod n)) =
        (adj_S.homEquiv A_M R₁ γ) (ULift.up (1 : ZMod n)) := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      change (e_hom.hom.app (Opposite.op T_S))
          ((ψ.hom.app (Opposite.op T_S)) ((adj_S.homEquiv A_M R₁ γ) (ULift.up (1 : ZMod n)))) = _
      rw [hγ1, hψ_nat]
      exact he1
    apply (adj_S.homEquiv A_M R₁).injective
    ext a
    obtain ⟨z, hz⟩ := ZMod.intCast_surjective a.down
    let one_M : ↑A_M := ULift.up (1 : ZMod n)
    have ha : a = z • one_M := by
      apply ULift.ext
      change a.down = z • (1 : ZMod n)
      rw [zsmul_one, hz]
    let f_lhs : ↑A_M →+ ↑(R₁.obj.obj (Opposite.op T_S)) :=
      ((adj_S.homEquiv A_M R₁) (γ ≫ (ψ ≫ e_hom))).hom
    let f_rhs : ↑A_M →+ ↑(R₁.obj.obj (Opposite.op T_S)) :=
      ((adj_S.homEquiv A_M R₁) γ).hom
    change f_lhs a = f_rhs a
    rw [ha, map_zsmul, map_zsmul]
    exact congrArg (fun x => z • x) h1_eq

theorem weil_polyP1_last_fiber_aut_trace_invariance (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (ζ : ℕ → kˣ)
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (tr_Pd : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r))
    (hTrace : WeilIsPolyP1PinnedKummerLerayTrace k ℓ ζ ι_P1 tr_Pd)
    (hPullEx : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂) (m i : ℕ),
      ∃ p : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i,
        WeilIsTorsionEtalePullback h m i p)
    (hPullComp : ∀ {S₁ S₂ S₃ : AlgebraicGeometry.Scheme.{u}}
      (h₁ : Quiver.Hom S₁ S₂) (h₂ : Quiver.Hom S₂ S₃) (m i : ℕ)
      (p₁ : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i)
      (p₂ : weilEtaleTorsionH S₃ m i →+ weilEtaleTorsionH S₂ m i)
      (p₁₂ : weilEtaleTorsionH S₃ m i →+ weilEtaleTorsionH S₁ m i),
      WeilIsTorsionEtalePullback h₁ m i p₁ →
      WeilIsTorsionEtalePullback h₂ m i p₂ →
      WeilIsTorsionEtalePullback (CategoryTheory.CategoryStruct.comp h₁ h₂) m i p₁₂ →
      p₁₂ = p₁.comp p₂)
    (δ r : ℕ)
    (ν : CategoryTheory.Iso (weilProjectiveSpaceOver k 1).left (weilProjectiveSpaceOver k 1).left)
    (hν : CategoryTheory.CategoryStruct.comp ν.hom (weilProjectiveSpaceOver k 1).hom =
      (weilProjectiveSpaceOver k 1).hom)
    (δ_ν : CategoryTheory.Iso
      (weilPolyP1Over k (δ + 1)).left (weilPolyP1Over k (δ + 1)).left)
    (hδ_fst : CategoryTheory.CategoryStruct.comp δ_ν.hom
      (CategoryTheory.Limits.pullback.fst
        (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom) =
      CategoryTheory.Limits.pullback.fst
        (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom)
    (hδ_snd : CategoryTheory.CategoryStruct.comp δ_ν.hom
      (CategoryTheory.Limits.pullback.snd
        (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.Limits.pullback.snd
          (weilPolyP1Over k δ).hom (weilProjectiveSpaceOver k 1).hom)
        ν.hom)
    (p_δ : weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) (2 * (δ + 1)) →+
      weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) (2 * (δ + 1)))
    (hp_δ : WeilIsTorsionEtalePullback δ_ν.hom (ℓ ^ r) (2 * (δ + 1)) p_δ)
    (w : weilEtaleTorsionH (weilPolyP1Over k (δ + 1)).left (ℓ ^ r) (2 * (δ + 1))) :
    tr_Pd (δ + 1) r (p_δ w) = tr_Pd (δ + 1) r w :=
by
  let P1 := (weilProjectiveSpaceOver k 1).left
  let S := (weilPolyP1Over k δ).left
