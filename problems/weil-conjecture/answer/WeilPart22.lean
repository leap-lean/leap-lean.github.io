      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (F_π.map (a_mor ≫ G_push.map c_W)),
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ F_π (a_mor ≫ G_push.map c_W),
      CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ i_Z_π)
        (z_cl.mapExactFunctor F_π) _ (Nat.zero_add 2) (Nat.add_zero 2) (Nat.zero_add 2),
      ← CategoryTheory.Abelian.Ext.comp_assoc (z_cl.mapExactFunctor F_π) _ _
        (Nat.add_zero 2) (Nat.add_zero 0) (Nat.add_zero 2),
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp F_π z_cl
        (CategoryTheory.Abelian.Ext.mk₀ (a_mor ≫ G_push.map c_W)) (Nat.add_zero 2)]
    change _ = (CategoryTheory.Abelian.Ext.mk₀ i_Z_π).comp
      ((a₀_cl.mapExactFunctor F_π).comp
        (CategoryTheory.Abelian.Ext.mk₀ (e_u.hom.app (G_push.obj M₁) ≫ a_pull.counit.app M₁))
        (Nat.add_zero 2)) (Nat.zero_add 2)
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀
        (e_u.hom.app (G_push.obj M₁)) (a_pull.counit.app M₁),
      ← CategoryTheory.Abelian.Ext.comp_assoc (a₀_cl.mapExactFunctor F_π) _ _
        (Nat.add_zero 2) (Nat.add_zero 0) (Nat.add_zero 2),
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp a₀_cl e_u.hom,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ i_Z_π) _
        (CategoryTheory.Abelian.Ext.mk₀ (a_pull.counit.app M₁))
        (Nat.zero_add 2) (Nat.add_zero 2) (Nat.zero_add 2),
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ i_Z_π)
        (CategoryTheory.Abelian.Ext.mk₀ (e_u.hom.app X₂))
        (a₀_cl.mapExactFunctor F_pull) (Nat.add_zero 0) (Nat.zero_add 2) (Nat.zero_add 2),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hι_eq : i_Z_π ≫ e_u.hom.app X₂ = i_Z := by
      dsimp [i_Z_π]
      rw [Category.assoc, Iso.inv_hom_id_app, Category.comp_id]
    rw [hι_eq]

  let α₀ : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) 2 :=
    z.comp (CategoryTheory.Abelian.Ext.mk₀ (α_π ≫ P_push.map counit_W)) (Nat.add_zero 2)
  have hLeray :
      (CategoryTheory.Abelian.Ext.mk₀ (adj_pull.counit.app (C₁.obj AM))).postcomp
        (C₁.obj Aℤ) (Nat.add_zero 2)
        ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C₂.obj Aℤ) (P_push.obj (C₁.obj AM)) 2) α₀)
          (Nat.zero_add 2)) =
      weilEtaleLocalTorsionCounitH Y₁.left n U_j 2 y := by
    change _ = (CategoryTheory.Abelian.Ext.mk₀ counit_W).postcomp (C₁.obj Aℤ) (Nat.add_zero 2) y
    rw [hPin]
    exact hPartD_ext P_push pb_π P_pull adj_π adj_pull
      (C₁.obj Aℤ) (C₁.obj AM) L_W (C₂.obj Aℤ) L_Y ιℤ α_π counit_W
      (z : CategoryTheory.Abelian.Ext (C₂.obj Aℤ) L_Y 2)

  have hf_sh_eval := hf_sh_eq (weilEtaleLocalTorsionCounitH Y₁.left n U_j 2 y) α₀ hLeray
  rw [hf_sh_eval]
  change z.comp (CategoryTheory.Abelian.Ext.mk₀ counit_Y) (Nat.add_zero 2) =
    (z.comp (CategoryTheory.Abelian.Ext.mk₀ (α_π ≫ P_push.map counit_W)) (Nat.add_zero 2)).comp
      (CategoryTheory.Abelian.Ext.mk₀ τM) (Nat.add_zero 2)
  rw [CategoryTheory.Abelian.Ext.comp_assoc z
      (CategoryTheory.Abelian.Ext.mk₀ (α_π ≫ P_push.map counit_W))
      (CategoryTheory.Abelian.Ext.mk₀ τM) (Nat.add_zero 2) (Nat.add_zero 0) (Nat.add_zero 2),
    CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, Category.assoc, hDeg0]

theorem weil_polyP1_last_coord_dvr_isolator_norm_val_one (k : Type u) [Field k] [IsAlgClosed k]
    (B A : Type u) [CommRing B] [IsDomain B] [Algebra k B]
    [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
    [Algebra B A] [IsScalarTower k B A]
    (d : ℕ) (hd : 1 ≤ d)
    (bA : Module.Basis (Fin d) B A)
    (m_Q : Ideal B) [m_Q.IsMaximal]
    (P₀ : Ideal A) [P₀.IsMaximal]
    (hOver : Ideal.comap (algebraMap B A) P₀ = m_Q)
    (hDVR_B : IsDiscreteValuationRing (Localization.AtPrime m_Q))
    (hDVR_A : IsDiscreteValuationRing (Localization.AtPrime P₀))
    (hDim1_A : ∀ q : Ideal A, q.IsPrime → q ≠ ⊥ → q.IsMaximal) :
    ∃ (b₀ : B) (g₀ : A),
      b₀ ∉ m_Q ∧
      g₀ ≠ 0 ∧
      (∀ q : Ideal A, q.IsPrime → algebraMap B A b₀ ∉ q → (g₀ ∈ q ↔ q = P₀)) ∧
      Ideal.span ({algebraMap A (Localization.AtPrime P₀) g₀} :
          Set (Localization.AtPrime P₀)) =
        IsLocalRing.maximalIdeal (Localization.AtPrime P₀) ∧
      Ideal.span ({algebraMap B (Localization.AtPrime m_Q)
          (((LinearMap.toMatrix bA bA) (LinearMap.mulLeft B g₀)).det)} :
          Set (Localization.AtPrime m_Q)) =
        IsLocalRing.maximalIdeal (Localization.AtPrime m_Q) :=
by
  classical
  haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing k A
  haveI : Module.Finite B A := Module.Finite.of_basis bA
  haveI : Algebra.IsIntegral B A := Algebra.IsIntegral.of_finite B A
  have hInt_BA : (algebraMap B A).IsIntegral := algebraMap_isIntegral_iff.mpr inferInstance
  let R := Localization.AtPrime m_Q
  let R_P := Localization.AtPrime P₀
  haveI : IsDiscreteValuationRing R := hDVR_B
  haveI : IsDiscreteValuationRing R_P := hDVR_A

  
  have hInj_BA : Function.Injective (algebraMap B A) := by
    intro b₁ b₂ hb
    have h0 : algebraMap B A (b₁ - b₂) = 0 := by rw [map_sub, hb, sub_self]
    let idx0 : Fin d := ⟨0, hd⟩
    have hsmul : (b₁ - b₂) • bA idx0 = 0 := by
      rw [Algebra.smul_def, h0, zero_mul]
    have hrepr := congrArg (fun x => bA.repr x idx0) hsmul
    simp only [map_smul, Module.Basis.repr_self, Finsupp.smul_single, smul_eq_mul, mul_one,
      Finsupp.single_eq_same, map_zero, Finsupp.zero_apply] at hrepr
    exact sub_eq_zero.mp hrepr

  have hFinPrimes : ∀ a : A, a ≠ 0 → {q : Ideal A | q.IsPrime ∧ a ∈ q}.Finite := by
    intro a ha_ne
    refine (Ideal.finite_minimalPrimes_of_isNoetherianRing A (Ideal.span {a})).subset ?_
    rintro q ⟨hq_prime, ha_q⟩
    change Minimal (fun p : Ideal A => p.IsPrime ∧ Ideal.span {a} ≤ p) q
    rw [minimal_iff_forall_lt]
    refine ⟨⟨hq_prime, Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ha_q)⟩, ?_⟩
    rintro p hp_lt_q ⟨hp_prime, hspan_le_p⟩
    have ha_p : a ∈ p := hspan_le_p (Ideal.mem_span_singleton_self a)
    have hp_ne_bot : p ≠ ⊥ := by
      intro hp_bot
      rw [hp_bot, Submodule.mem_bot] at ha_p
      exact ha_ne ha_p
    have hp_max : p.IsMaximal := hDim1_A p hp_prime hp_ne_bot
    exact ne_of_lt hp_lt_q (hp_max.eq_of_le hq_prime.ne_top (le_of_lt hp_lt_q))

  
  have hmQ_ne_bot : m_Q ≠ ⊥ := by
    intro hmQ_bot
    have hmax_bot : IsLocalRing.maximalIdeal R = ⊥ := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal m_Q R]
      exact (congrArg (Ideal.map (algebraMap B R)) hmQ_bot).trans Ideal.map_bot
    exact IsDiscreteValuationRing.not_a_field R hmax_bot
  have hb_m_ex : ∃ b_m ∈ m_Q, b_m ≠ 0 := by
    by_contra hall
    push_neg at hall
    apply hmQ_ne_bot
    ext x
    simp only [Submodule.mem_bot]
    exact ⟨hall x, fun hx => hx.symm ▸ m_Q.zero_mem⟩
  obtain ⟨b_m, hb_m_mem, hb_m_ne⟩ := hb_m_ex
  let a₀ : A := algebraMap B A b_m
  have ha₀_ne : a₀ ≠ 0 := fun h0 => hb_m_ne (hInj_BA (h0.trans (map_zero _).symm))
  let S_other : Set (Ideal A) :=
    {P : Ideal A | P.IsMaximal ∧ Ideal.comap (algebraMap B A) P = m_Q ∧ P ≠ P₀}
  have hFin_other : S_other.Finite := by
    refine (hFinPrimes a₀ ha₀_ne).subset ?_
    rintro P ⟨hP_max, hP_over, _⟩
    refine ⟨hP_max.isPrime, ?_⟩
    have hbm_in : b_m ∈ Ideal.comap (algebraMap B A) P := by
      rw [hP_over]
      exact hb_m_mem
    exact hbm_in

  obtain ⟨ϖ, hϖ_irr⟩ := IsDiscreteValuationRing.exists_irreducible R_P
  have hϖ_max : IsLocalRing.maximalIdeal R_P = Ideal.span {ϖ} := hϖ_irr.maximalIdeal_eq
  obtain ⟨⟨π₀, s₀⟩, hπ₀_surj⟩ := IsLocalization.surj P₀.primeCompl ϖ
  have hu_s₀ : IsUnit (algebraMap A R_P s₀.1) := IsLocalization.map_units R_P s₀
  have hπ₀_span : Ideal.span ({algebraMap A R_P π₀} : Set R_P) = IsLocalRing.maximalIdeal R_P := by
    rw [← hπ₀_surj, Ideal.span_singleton_mul_right_unit hu_s₀ ϖ, hϖ_max]
  have hπ₀_mem : π₀ ∈ P₀ := by
    rw [← IsLocalization.AtPrime.to_map_mem_maximal_iff R_P P₀ π₀, ← hπ₀_span]
    exact Ideal.mem_span_singleton_self _

  have hCopMax : ∀ {M₁ M₂ : Ideal A}, M₁.IsMaximal → M₂.IsMaximal → M₁ ≠ M₂ → IsCoprime M₁ M₂ := by
    intro M₁ M₂ hM₁ hM₂ hne
    rw [Ideal.isCoprime_iff_sup_eq]
    by_contra hnot_top
    have heq : M₁ = M₁ ⊔ M₂ := hM₁.eq_of_le hnot_top le_sup_left
    have hle : M₂ ≤ M₁ := le_sup_right.trans heq.symm.le
    exact hne (hM₂.eq_of_le hM₁.ne_top hle).symm
  haveI : Finite ↥S_other := hFin_other.to_subtype
  let J : Option ↥S_other → Ideal A := fun i =>
    match i with
    | none => P₀ ^ 2
    | some P => P.1
  have hCop : Pairwise (Function.onFun IsCoprime J) := by
    intro i j hij
    cases i with
    | none =>
      cases j with
      | none => exact (hij rfl).elim
      | some P => exact (hCopMax inferInstance P.2.1 P.2.2.2.symm).pow_left
    | some P₁ =>
      cases j with
      | none => exact (hCopMax inferInstance P₁.2.1 P₁.2.2.2.symm).pow_left.symm
      | some P₂ =>
        have hP_ne : P₁.1 ≠ P₂.1 := fun h => hij (congrArg some (Subtype.ext h))
        exact hCopMax P₁.2.1 P₂.2.1 hP_ne
  let e_crt : (A ⧸ ⨅ i, J i) ≃+* ∀ i, A ⧸ J i := Ideal.quotientInfRingEquivPiQuotient J hCop
  let target : ∀ i, A ⧸ J i := fun i =>
    match i with
    | none => Ideal.Quotient.mk (P₀ ^ 2) π₀
    | some _ => 1
  obtain ⟨g₀, hg₀_quot⟩ := Ideal.Quotient.mk_surjective (e_crt.symm target)
  have hg₀_eval : ∀ i : Option ↥S_other, Ideal.Quotient.mk (J i) g₀ = target i := by
    intro i
    have h1 := congrArg (fun x => e_crt x i) hg₀_quot
    rw [e_crt.apply_symm_apply] at h1
    exact (Ideal.quotientInfToPiQuotient_mk' J g₀ i).symm.trans h1

  have hg₀_sub_π₀ : g₀ - π₀ ∈ P₀ ^ 2 := Ideal.Quotient.eq.mp (hg₀_eval none)
  have hg₀_mem : g₀ ∈ P₀ := by
    have hsub : g₀ - π₀ ∈ P₀ := Ideal.pow_le_self (by norm_num) hg₀_sub_π₀
    simpa only [sub_add_cancel] using P₀.add_mem hsub hπ₀_mem
  have hg₀_fiber : ∀ P : Ideal A, P.IsMaximal →
      Ideal.comap (algebraMap B A) P = m_Q → P ≠ P₀ → g₀ ∉ P := by
    intro P hP_max hP_over hP_ne hg₀_in_P
    let P_sub : ↥S_other := ⟨P, hP_max, hP_over, hP_ne⟩
    have h : Ideal.Quotient.mk P g₀ = Ideal.Quotient.mk P 1 := by
      simpa [J, target] using hg₀_eval (some P_sub)
    have hsub1 : g₀ - 1 ∈ P := Ideal.Quotient.eq.mp h
    have h1_in_P : (1 : A) ∈ P := by
      simpa only [sub_sub_cancel] using P.sub_mem hg₀_in_P hsub1
    exact hP_max.ne_top (P.eq_top_iff_one.mpr h1_in_P)

  have hg₀_span : Ideal.span ({algebraMap A R_P g₀} : Set R_P) = IsLocalRing.maximalIdeal R_P := by
    have hmap_mem : algebraMap A R_P g₀ - algebraMap A R_P π₀ ∈
        Ideal.map (algebraMap A R_P) (P₀ ^ 2) := by
      rw [← map_sub]
      exact Ideal.mem_map_of_mem (algebraMap A R_P) hg₀_sub_π₀
    have hmap_sq : Ideal.map (algebraMap A R_P) (P₀ ^ 2) =
        Ideal.span ({(algebraMap A R_P π₀) ^ 2} : Set R_P) := by
      rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal (I := P₀), ← hπ₀_span,
        Ideal.span_singleton_pow]
    rw [hmap_sq, Ideal.mem_span_singleton] at hmap_mem
    rcases hmap_mem with ⟨c, hc⟩
    have hfac : algebraMap A R_P g₀ = algebraMap A R_P π₀ * (1 + algebraMap A R_P π₀ * c) := by
      calc
        algebraMap A R_P g₀
          = (algebraMap A R_P g₀ - algebraMap A R_P π₀) + algebraMap A R_P π₀ := by ring
        _ = (algebraMap A R_P π₀) ^ 2 * c + algebraMap A R_P π₀ := by rw [hc]
        _ = algebraMap A R_P π₀ * (1 + algebraMap A R_P π₀ * c) := by ring
    have hπc_mem : algebraMap A R_P π₀ * c ∈ IsLocalRing.maximalIdeal R_P := by
      rw [← hπ₀_span]
      exact Ideal.mul_mem_right c _ (Ideal.mem_span_singleton_self _)
    have hu1 : IsUnit (1 + algebraMap A R_P π₀ * c) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hmem
      have h1_mem : (1 : R_P) ∈ IsLocalRing.maximalIdeal R_P := by
        simpa only [add_sub_cancel_right] using (IsLocalRing.maximalIdeal R_P).sub_mem hmem hπc_mem
      exact (IsLocalRing.maximalIdeal.isMaximal R_P).ne_top
        ((IsLocalRing.maximalIdeal R_P).eq_top_iff_one.mpr h1_mem)
    rw [hfac, Ideal.span_singleton_mul_right_unit hu1 (algebraMap A R_P π₀), hπ₀_span]
  have hg₀_ne : g₀ ≠ 0 := by
    intro hg₀_zero
    have hmax_bot : IsLocalRing.maximalIdeal R_P = ⊥ := by
      rw [← hg₀_span, hg₀_zero, map_zero, Ideal.span_singleton_eq_bot]
    exact IsDiscreteValuationRing.not_a_field R_P hmax_bot

  
  let Z_off : Set (Ideal A) := {Q : Ideal A | Q.IsPrime ∧ g₀ ∈ Q ∧ Q ≠ P₀}
  have hFin_off : Z_off.Finite :=
    (hFinPrimes g₀ hg₀_ne).subset (fun _ ⟨hq1, hq2, _⟩ => ⟨hq1, hq2⟩)
  have hb_exists : ∀ Q : ↥Z_off, ∃ b : B, algebraMap B A b ∈ Q.1 ∧ b ∉ m_Q := by
    intro Q
    have hQ_ne_bot : Q.1 ≠ ⊥ := by
      intro hbot
      have hz : g₀ ∈ Q.1 := Q.2.2.1
      rw [hbot, Submodule.mem_bot] at hz
      exact hg₀_ne hz
    haveI hQ_max : Q.1.IsMaximal := hDim1_A Q.1 Q.2.1 hQ_ne_bot
    have hcomap_max : (Ideal.comap (algebraMap B A) Q.1).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap B A) hInt_BA Q.1
    have hcomap_ne : Ideal.comap (algebraMap B A) Q.1 ≠ m_Q :=
      fun heq => hg₀_fiber Q.1 hQ_max heq Q.2.2.2 Q.2.2.1
    have hnot_le : ¬ Ideal.comap (algebraMap B A) Q.1 ≤ m_Q :=
      fun hle => hcomap_ne (hcomap_max.eq_of_le ‹m_Q.IsMaximal›.ne_top hle)
    obtain ⟨b, hb_in, hb_out⟩ := SetLike.not_le_iff_exists.mp hnot_le
    exact ⟨b, hb_in, hb_out⟩
  choose b_fn hb_in hb_not_mQ using hb_exists
  letI : Finite ↥Z_off := hFin_off.to_subtype
  letI : Fintype ↥Z_off := Fintype.ofFinite ↥Z_off
  let b₀ : B := ∏ Q : ↥Z_off, b_fn Q
  have hb₀_not_mQ : b₀ ∉ m_Q :=
    m_Q.primeCompl.prod_mem (fun Q _ => hb_not_mQ Q)
  have hb₀_iso : ∀ q : Ideal A, q.IsPrime → algebraMap B A b₀ ∉ q → (g₀ ∈ q ↔ q = P₀) := by
    intro q hq_prime hb₀_not_q
    constructor
    · intro hg₀_q
      by_contra hq_ne
      let Q₀ : ↥Z_off := ⟨q, hq_prime, hg₀_q, hq_ne⟩
      have hdvd : b_fn Q₀ ∣ b₀ := Finset.dvd_prod_of_mem b_fn (Finset.mem_univ Q₀)
      rcases map_dvd (algebraMap B A) hdvd with ⟨c_dvd, hc_dvd⟩
      exact hb₀_not_q (hc_dvd ▸ q.mul_mem_right c_dvd (hb_in Q₀))
    · rintro rfl
      exact hg₀_mem

  
  let M_Q : Submonoid A := Algebra.algebraMapSubmonoid A m_Q.primeCompl
  let A_Q := Localization M_Q
  let F := A ⧸ P₀
  letI : Field F := Ideal.Quotient.field P₀
  let q₀ : A →+* F := Ideal.Quotient.mk P₀
  have hm_not_P₀ : ∀ m : M_Q, (m : A) ∉ P₀ := by
    rintro ⟨_, s, hs_not_mQ, rfl⟩ hmem
    have hs_in : s ∈ Ideal.comap (algebraMap B A) P₀ := hmem
    rw [hOver] at hs_in
    exact hs_not_mQ hs_in
  have hDisj : Disjoint (M_Q : Set A) (P₀ : Set A) :=
    Set.disjoint_left.mpr (fun m hm hP => hm_not_P₀ ⟨m, hm⟩ hP)
  have hle_nzd : M_Q ≤ nonZeroDivisors A := by
    intro m hm
    apply mem_nonZeroDivisors_of_ne_zero
    intro hm0
    exact hm_not_P₀ ⟨m, hm⟩ (hm0 ▸ P₀.zero_mem)
  letI : IsDomain A_Q := IsLocalization.isDomain_localization hle_nzd
  let g_Q : A_Q := algebraMap A A_Q g₀
  have hg_Q_ne : g_Q ≠ 0 :=
    IsLocalization.to_map_ne_zero_of_mem_nonZeroDivisors A_Q hle_nzd
      (mem_nonZeroDivisors_of_ne_zero hg₀_ne)

  have hUnit_R : ∀ y : m_Q.primeCompl, IsUnit ((q₀.comp (algebraMap B A)) y.1) := by
    intro y
    have hy_not_P₀ : algebraMap B A y.1 ∉ P₀ :=
      hm_not_P₀ ⟨algebraMap B A y.1, y.1, y.2, rfl⟩
    have hne0 : (q₀.comp (algebraMap B A)) y.1 ≠ 0 := by
      change q₀ (algebraMap B A y.1) ≠ 0
      rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
    exact Ne.isUnit hne0
  have hUnit_A : ∀ y : M_Q, IsUnit (q₀ y.1) := by
    intro y
    have hne0 : q₀ y.1 ≠ 0 := by
      rw [Ne, Ideal.Quotient.eq_zero_iff_mem]
      exact hm_not_P₀ y
    exact Ne.isUnit hne0
  let ρ_R : R →+* F := IsLocalization.lift hUnit_R
  let ρ_A : A_Q →+* F := IsLocalization.lift hUnit_A
  have hρ_comm : ∀ r : R, ρ_A (algebraMap R A_Q r) = ρ_R r := by
    have h_ext : ρ_A.comp (algebraMap R A_Q) = ρ_R := by
      apply IsLocalization.ringHom_ext m_Q.primeCompl
      ext b
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply B R A_Q, IsScalarTower.algebraMap_apply B A A_Q,
        IsLocalization.lift_eq hUnit_A, IsLocalization.lift_eq hUnit_R]
      rfl
    exact fun r => congrArg (fun f : R →+* F => f r) h_ext

  have hρR_surj : Function.Surjective ρ_R := by
    obtain ⟨n_mv, f_mv, hf_surj⟩ :=
      Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType k A›
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap f_mv.toRingHom P₀
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective f_mv.toRingHom hf_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    intro w
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective w
    obtain ⟨p, rfl⟩ := hf_surj a
    let c : k := MvPolynomial.aeval a_pt p
    have haeval_C : MvPolynomial.aeval a_pt (MvPolynomial.C c) = c :=
      (MvPolynomial.aeval a_pt).commutes c
    have hp_mem : p - MvPolynomial.C c ∈ m_mv := by
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff, map_sub, haeval_C]
      exact sub_self c
    have hf_C : f_mv (MvPolynomial.C c) = algebraMap k A c := f_mv.commutes c
    have hf_sub : f_mv p - algebraMap k A c ∈ P₀ := by
      have h1 : f_mv.toRingHom (p - MvPolynomial.C c) ∈ P₀ := hp_mem
      rwa [RingHom.map_sub, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, hf_C] at h1
    have hq_eq : q₀ (algebraMap k A c) = q₀ (f_mv p) :=
      (Ideal.Quotient.eq.mpr hf_sub).symm
    refine ⟨algebraMap B R (algebraMap k B c), ?_⟩
    rw [IsLocalization.lift_eq hUnit_R]
    change q₀ (algebraMap B A (algebraMap k B c)) = q₀ (f_mv p)
    rwa [← IsScalarTower.algebraMap_apply k B A]

  let P_Q : Ideal A_Q := Ideal.map (algebraMap A A_Q) P₀
  have hPQ_under : Ideal.comap (algebraMap A A_Q) P_Q = P₀ :=
    IsLocalization.under_map_of_isPrime_disjoint M_Q A_Q inferInstance hDisj
  have hMax_AQ : ∀ M : Ideal A_Q, M.IsMaximal → g_Q ∈ M → M = P_Q := by
    intro M hM_max hg_in_M
    let q : Ideal A := Ideal.comap (algebraMap A A_Q) M
    obtain ⟨hq_prime, hq_disj⟩ :=
      (IsLocalization.isPrime_iff_isPrime_disjoint M_Q A_Q M).mp hM_max.isPrime
    have hg₀_in_q : g₀ ∈ q := hg_in_M
    have hq_ne_bot : q ≠ ⊥ := by
      intro hbot
      rw [hbot, Submodule.mem_bot] at hg₀_in_q
      exact hg₀_ne hg₀_in_q
    haveI hq_max : q.IsMaximal := hDim1_A q hq_prime hq_ne_bot
    have hcomap_max : (Ideal.comap (algebraMap B A) q).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap B A) hInt_BA q
    have hcomap_le : Ideal.comap (algebraMap B A) q ≤ m_Q := by
      intro b hb
      by_contra hb_not_mQ
      have hb_MQ : algebraMap B A b ∈ M_Q := ⟨b, hb_not_mQ, rfl⟩
      exact Set.disjoint_left.mp hq_disj hb_MQ hb
    have hcomap_eq : Ideal.comap (algebraMap B A) q = m_Q :=
      hcomap_max.eq_of_le ‹m_Q.IsMaximal›.ne_top hcomap_le
    have hq_eq_P₀ : q = P₀ := by
      by_contra hq_ne
      exact hg₀_fiber q hq_max hcomap_eq hq_ne hg₀_in_q
    calc
      M = Ideal.map (algebraMap A A_Q) q := (IsLocalization.map_under M_Q A_Q M).symm
      _ = P_Q := by rw [hq_eq_P₀]

  let L : A_Q →ₗ[R] A_Q := LinearMap.mulLeft R g_Q
  have hL_inj : Function.Injective L := fun _ _ hz => mul_right_injective₀ hg_Q_ne hz
  have hmul_range : ∀ y : A_Q, (∃ z : A_Q, L z = y) ↔ ρ_A y = 0 := by
    intro y
    constructor
    · rintro ⟨z, rfl⟩
      change ρ_A (g_Q * z) = 0
      rw [map_mul, show ρ_A g_Q = q₀ g₀ from IsLocalization.lift_eq hUnit_A g₀,
        Ideal.Quotient.eq_zero_iff_mem.mpr hg₀_mem, zero_mul]
    · intro hρy
      obtain ⟨⟨a, m⟩, hy_surj⟩ := IsLocalization.surj M_Q y
      have hq₀_a : q₀ a = 0 := by
        calc
          q₀ a = ρ_A (algebraMap A A_Q a) := (IsLocalization.lift_eq hUnit_A a).symm
          _ = ρ_A (y * algebraMap A A_Q m.1) := by rw [← hy_surj]
          _ = ρ_A y * ρ_A (algebraMap A A_Q m.1) := map_mul _ _ _
          _ = 0 := by rw [hρy, zero_mul]
      have ha_P₀ : a ∈ P₀ := Ideal.Quotient.eq_zero_iff_mem.mp hq₀_a
      have ha_RP : algebraMap A R_P a ∈ Ideal.span ({algebraMap A R_P g₀} : Set R_P) := by
        rw [hg₀_span]
        exact (IsLocalization.AtPrime.to_map_mem_maximal_iff R_P P₀ a).mpr ha_P₀
      rw [Ideal.mem_span_singleton] at ha_RP
      rcases ha_RP with ⟨c_loc, hc_loc⟩
      obtain ⟨⟨r_A, s_P⟩, hc_surj⟩ := IsLocalization.surj P₀.primeCompl c_loc
      have heq_RP : algebraMap A R_P (a * s_P.1) = algebraMap A R_P (g₀ * r_A) := by
        rw [map_mul, map_mul, hc_loc, mul_assoc, hc_surj]
      obtain ⟨u_P, hu_P⟩ := (IsLocalization.eq_iff_exists P₀.primeCompl R_P).mp heq_RP
      let t_A : A := u_P.1 * s_P.1
      have ht_not_P₀ : t_A ∉ P₀ := (u_P * s_P).2
      have hta_eq : t_A * a = g₀ * (u_P.1 * r_A) := by
        calc
          t_A * a = u_P.1 * (a * s_P.1) := by ring
          _ = u_P.1 * (g₀ * r_A) := hu_P
          _ = g₀ * (u_P.1 * r_A) := by ring
      let t_Q : A_Q := algebraMap A A_Q t_A
      have ht_not_PQ : t_Q ∉ P_Q := by
        intro hmem
        have ht_in : t_A ∈ Ideal.comap (algebraMap A A_Q) P_Q := hmem
        rw [hPQ_under] at ht_in
        exact ht_not_P₀ ht_in
      let u_m : A_Qˣ := (IsLocalization.map_units A_Q m).unit
      have hu_m_val : (u_m : A_Q) = algebraMap A A_Q m.1 := IsUnit.unit_spec _
      let w_Q : A_Q := algebraMap A A_Q (u_P.1 * r_A) * (↑u_m⁻¹ : A_Q)
      have hty_eq : t_Q * y = g_Q * w_Q := by
        apply mul_right_cancel₀ u_m.ne_zero
        calc
          t_Q * y * (u_m : A_Q)
            = t_Q * (y * algebraMap A A_Q m.1) := by rw [hu_m_val, mul_assoc]
          _ = algebraMap A A_Q (t_A * a) := by rw [hy_surj, ← map_mul]
          _ = algebraMap A A_Q (g₀ * (u_P.1 * r_A)) := by rw [hta_eq]
          _ = g_Q * algebraMap A A_Q (u_P.1 * r_A) := map_mul _ _ _
          _ = g_Q * w_Q * (u_m : A_Q) := by
                dsimp [w_Q]
                rw [mul_assoc, mul_assoc, Units.inv_mul, mul_one]
      have hspan_top : Ideal.span ({g_Q, t_Q} : Set A_Q) = ⊤ := by
        by_contra hne_top
        obtain ⟨M, hM_max, hle_M⟩ := Ideal.exists_le_maximal _ hne_top
        have hg_M : g_Q ∈ M := hle_M (Ideal.subset_span (by simp))
        have ht_M : t_Q ∈ M := hle_M (Ideal.subset_span (by simp))
        rw [hMax_AQ M hM_max hg_M] at ht_M
        exact ht_not_PQ ht_M
      have h1_mem : (1 : A_Q) ∈ Ideal.span ({g_Q, t_Q} : Set A_Q) := by
        rw [hspan_top]
        trivial
      obtain ⟨u_b, v_b, hbezout⟩ := Ideal.mem_span_pair.mp h1_mem
      refine ⟨u_b * y + v_b * w_Q, ?_⟩
      change g_Q * (u_b * y + v_b * w_Q) = y
      calc
        g_Q * (u_b * y + v_b * w_Q)
          = u_b * g_Q * y + v_b * (g_Q * w_Q) := by ring
        _ = u_b * g_Q * y + v_b * (t_Q * y) := by rw [← hty_eq]
        _ = (u_b * g_Q + v_b * t_Q) * y := by ring
        _ = 1 * y := by rw [hbezout]
        _ = y := one_mul y

  
  let e : Module.Basis (Fin d) R A_Q := bA.localizationLocalization R m_Q.primeCompl A_Q
  obtain ⟨π_R, hπ_irr⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hπ_ne : π_R ≠ 0 := hπ_irr.ne_zero
  have hπ_max : IsLocalRing.maximalIdeal R = Ideal.span {π_R} := hπ_irr.maximalIdeal_eq
  have hker_ρR : RingHom.ker ρ_R = Ideal.span {π_R} := by
    have hker_max : (RingHom.ker ρ_R).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective ρ_R hρR_surj
    rw [IsLocalRing.eq_maximalIdeal hker_max, hπ_max]
  have hρA_smul : ∀ (r : R) (y : A_Q), ρ_A (r • y) = ρ_R r * ρ_A y := by
    intro r y
    rw [Algebra.smul_def, map_mul, hρ_comm r]

  have hex_i₀ : ∃ i₀ : Fin d, ρ_A (e i₀) ≠ 0 := by
    by_contra hall
    push_neg at hall
    have h1_sum : (1 : F) = ∑ i : Fin d, ρ_R (e.repr 1 i) * ρ_A (e i) := by
      calc
        (1 : F) = ρ_A 1 := (map_one ρ_A).symm
        _ = ρ_A (∑ i : Fin d, (e.repr 1 i) • e i) := by rw [e.sum_repr 1]
        _ = ∑ i : Fin d, ρ_A ((e.repr 1 i) • e i) := map_sum ρ_A _ _
        _ = ∑ i : Fin d, ρ_R (e.repr 1 i) * ρ_A (e i) :=
              Finset.sum_congr rfl (fun i _ => hρA_smul _ _)
    have hsum0 : (∑ i : Fin d, ρ_R (e.repr 1 i) * ρ_A (e i)) = 0 :=
      Finset.sum_eq_zero (fun i _ => by rw [hall i, mul_zero])
    exact one_ne_zero (h1_sum.trans hsum0)
  obtain ⟨i₀, he₀⟩ := hex_i₀

  have hc_ex : ∀ i : Fin d, ∃ c_i : R, ρ_R c_i = ρ_A (e i) * (ρ_A (e i₀))⁻¹ :=
    fun i => hρR_surj (ρ_A (e i) * (ρ_A (e i₀))⁻¹)
  choose c hc using hc_ex
  have hc_mul : ∀ i : Fin d, ρ_R (c i) * ρ_A (e i₀) = ρ_A (e i) := by
    intro i
    rw [hc i, inv_mul_cancel_right₀ he₀]
  let Φ : A_Q →ₗ[R] A_Q :=
    e.constr R (fun i : Fin d => if i = i₀ then e i₀ else e i - c i • e i₀)
  let Φ_inv : A_Q →ₗ[R] A_Q :=
    e.constr R (fun i : Fin d => if i = i₀ then e i₀ else e i + c i • e i₀)
  have hΦ_comp1 : Φ.comp Φ_inv = LinearMap.id := by
    apply e.ext
    intro i
    simp only [LinearMap.comp_apply, LinearMap.id_apply, Φ_inv, e.constr_basis]
    split_ifs with hi
    · subst hi
      simp only [Φ, e.constr_basis, ↓reduceIte]
    · simp only [map_add, map_smul, Φ, e.constr_basis, if_neg hi, ↓reduceIte, sub_add_cancel]
  have hΦ_comp2 : Φ_inv.comp Φ = LinearMap.id := by
    apply e.ext
    intro i
    simp only [LinearMap.comp_apply, LinearMap.id_apply, Φ, e.constr_basis]
    split_ifs with hi
    · subst hi
      simp only [Φ_inv, e.constr_basis, ↓reduceIte]
    · simp only [map_sub, map_smul, Φ_inv, e.constr_basis, if_neg hi, ↓reduceIte,
        add_sub_cancel_right]
  let e_Phi : A_Q ≃ₗ[R] A_Q := LinearEquiv.ofLinearMap Φ Φ_inv hΦ_comp1 hΦ_comp2
  let b' : Module.Basis (Fin d) R A_Q := e.map e_Phi

  have hρ_b'_zero : ∀ i : Fin d, i ≠ i₀ → ρ_A (b' i) = 0 := by
    intro i hi
    have hb'_i : b' i = e i - c i • e i₀ := by
      change Φ (e i) = e i - c i • e i₀
      simp only [Φ, e.constr_basis, if_neg hi]
    rw [hb'_i, map_sub, hρA_smul, hc_mul i, sub_self]
  have hρ_b'_i₀ : ρ_A (b' i₀) = ρ_A (e i₀) := by
    have hb'_i₀ : b' i₀ = e i₀ := by
      change Φ (e i₀) = e i₀
      simp only [Φ, e.constr_basis, ↓reduceIte]
    rw [hb'_i₀]
  have hker_b' : ∀ y : A_Q, ρ_A y = 0 ↔ b'.repr y i₀ ∈ Ideal.span {π_R} := by
    intro y
    have hy_eval : ρ_A y = ρ_R (b'.repr y i₀) * ρ_A (e i₀) := by
      calc
        ρ_A y = ρ_A (∑ i : Fin d, (b'.repr y i) • b' i) := by rw [b'.sum_repr y]
        _ = ∑ i : Fin d, ρ_A ((b'.repr y i) • b' i) := map_sum ρ_A _ _
        _ = ∑ i : Fin d, ρ_R (b'.repr y i) * ρ_A (b' i) :=
              Finset.sum_congr rfl (fun i _ => hρA_smul _ _)
        _ = ρ_R (b'.repr y i₀) * ρ_A (b' i₀) :=
              Finset.sum_eq_single i₀
                (fun i _ hi => by rw [hρ_b'_zero i hi, mul_zero])
                (fun hnot => (hnot (Finset.mem_univ i₀)).elim)
        _ = ρ_R (b'.repr y i₀) * ρ_A (e i₀) := by rw [hρ_b'_i₀]
    rw [hy_eval, mul_eq_zero, or_iff_left he₀, ← RingHom.mem_ker, hker_ρR]

  let d_diag : Fin d → R := fun i => if i = i₀ then π_R else 1
  let D_mat : Matrix (Fin d) (Fin d) R := Matrix.diagonal d_diag
  let D_π : A_Q →ₗ[R] A_Q := Matrix.toLin b' b' D_mat
  have hD_repr : ∀ (z : A_Q) (i : Fin d), b'.repr (D_π z) i = d_diag i * b'.repr z i := by
    intro z i
    have heq : D_π z = b'.equivFun.symm (D_mat.mulVec (⇑(b'.repr z))) := by
      rw [b'.equivFun_symm_apply]
      exact Matrix.toLin_apply b' b' D_mat z
    rw [← congrFun (b'.equivFun_apply (D_π z)) i, heq, b'.equivFun.apply_symm_apply]
    exact Matrix.mulVec_diagonal d_diag (⇑(b'.repr z)) i
  have hD_inj : Function.Injective D_π := by
    intro z₁ z₂ hz
    have h0 : D_π (z₁ - z₂) = 0 := by rw [map_sub, hz, sub_self]
    apply sub_eq_zero.mp
    apply b'.equivFun.injective
    ext i
    rw [map_zero, Pi.zero_apply, b'.equivFun_apply]
    have hi0 := hD_repr (z₁ - z₂) i
    rw [h0, map_zero, Finsupp.zero_apply] at hi0
    have hd_ne : d_diag i ≠ 0 := by
      dsimp [d_diag]
      split_ifs
      · exact hπ_ne
      · exact one_ne_zero
    exact (mul_eq_zero.mp hi0.symm).resolve_left hd_ne
  have hRange : LinearMap.range L = LinearMap.range D_π := by
    ext y
    simp only [LinearMap.mem_range]
    constructor
    · rintro ⟨z, rfl⟩
      have hρ0 : ρ_A (L z) = 0 := (hmul_range (L z)).mp ⟨z, rfl⟩
      have hrepr_mem : b'.repr (L z) i₀ ∈ Ideal.span {π_R} := (hker_b' (L z)).mp hρ0
      rw [Ideal.mem_span_singleton] at hrepr_mem
      rcases hrepr_mem with ⟨r₀, hr₀⟩
      let w : A_Q := b'.equivFun.symm (fun i => if i = i₀ then r₀ else b'.repr (L z) i)
      refine ⟨w, ?_⟩
      apply b'.equivFun.injective
      ext i
      rw [b'.equivFun_apply, hD_repr w i, ← congrFun (b'.equivFun_apply w) i,
        b'.equivFun.apply_symm_apply, b'.equivFun_apply]
      dsimp [d_diag]
      split_ifs with hi
      · subst hi
        exact hr₀.symm
      · exact one_mul _
    · rintro ⟨w, rfl⟩
      have hrepr_mem : b'.repr (D_π w) i₀ ∈ Ideal.span {π_R} := by
        rw [hD_repr w i₀, Ideal.mem_span_singleton]
        dsimp [d_diag]
        rw [if_pos rfl]
        exact ⟨b'.repr w i₀, rfl⟩
      have hρ0 : ρ_A (D_π w) = 0 := (hker_b' (D_π w)).mpr hrepr_mem
      exact (hmul_range (D_π w)).mpr hρ0

  let eL : A_Q ≃ₗ[R] LinearMap.range L := LinearEquiv.ofInjective L hL_inj
  let eD : A_Q ≃ₗ[R] LinearMap.range D_π := LinearEquiv.ofInjective D_π hD_inj
  let eEq : LinearMap.range L ≃ₗ[R] LinearMap.range D_π := LinearEquiv.ofEq _ _ hRange
  let U_eq : A_Q ≃ₗ[R] A_Q := eL.trans (eEq.trans eD.symm)
  have hL_fac : L = D_π.comp U_eq.toLinearMap := by
    ext x
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, U_eq, LinearEquiv.trans_apply]
    rw [← LinearEquiv.ofInjective_apply D_π (h := hD_inj) (eD.symm (eEq (eL x))),
      eD.apply_symm_apply]
    exact (LinearEquiv.ofInjective_apply L (h := hL_inj) x).symm
  have hdet_D : LinearMap.det D_π = π_R := by
    have hD_mat_eq : (LinearMap.toMatrix b' b') D_π = D_mat :=
      LinearMap.toMatrix_toLin b' b' D_mat
    rw [← LinearMap.det_toMatrix b' D_π, hD_mat_eq, Matrix.det_diagonal]
    exact Fintype.prod_ite_eq' i₀ (fun _ => π_R)
  have hdet_L_eq : ((LinearMap.toMatrix e e) L).det = π_R * LinearMap.det U_eq.toLinearMap := by
    rw [LinearMap.det_toMatrix e L, hL_fac, LinearMap.det_comp, hdet_D]
  have hu_detU : IsUnit (LinearMap.det U_eq.toLinearMap) := LinearEquiv.isUnit_det' U_eq
  have hdet_L_span : Ideal.span ({((LinearMap.toMatrix e e) L).det} : Set R) =
      IsLocalRing.maximalIdeal R := by
    rw [hdet_L_eq, Ideal.span_singleton_mul_right_unit hu_detU π_R, hπ_max]

  let M₀ : Matrix (Fin d) (Fin d) B := (LinearMap.toMatrix bA bA) (LinearMap.mulLeft B g₀)
  have hMat_eq : (LinearMap.toMatrix e e) L = (algebraMap B R).mapMatrix M₀ := by
    ext i j
    rw [LinearMap.toMatrix_apply, RingHom.mapMatrix_apply, Matrix.map_apply]
    have he_j : e j = algebraMap A A_Q (bA j) :=
      bA.localizationLocalization_apply R m_Q.primeCompl A_Q j
    have hL_ej : L (e j) = e.equivFun.symm (fun k => algebraMap B R (M₀ k j)) := by
      rw [e.equivFun_symm_apply]
      change g_Q * e j = _
      rw [he_j, ← map_mul]
      have hbA_j : g₀ * bA j = ∑ k : Fin d, M₀ k j • bA k := by
        calc
          g₀ * bA j = (LinearMap.mulLeft B g₀) (bA j) := rfl
          _ = ∑ k : Fin d, (bA.repr ((LinearMap.mulLeft B g₀) (bA j)) k) • bA k :=
                (bA.sum_repr _).symm
          _ = ∑ k : Fin d, M₀ k j • bA k := by
                refine Finset.sum_congr rfl (fun k _ => ?_)
                rw [show M₀ k j = bA.repr ((LinearMap.mulLeft B g₀) (bA j)) k from
                  LinearMap.toMatrix_apply bA bA (LinearMap.mulLeft B g₀) k j]
      rw [hbA_j, map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply B A A_Q,
        IsScalarTower.algebraMap_apply B R A_Q, ← Algebra.smul_def,
        bA.localizationLocalization_apply R m_Q.primeCompl A_Q k]
    rw [← congrFun (e.equivFun_apply (L (e j))) i, hL_ej, e.equivFun.apply_symm_apply]
  have hdet_span : Ideal.span ({algebraMap B R M₀.det} : Set R) = IsLocalRing.maximalIdeal R := by
    have hmap_det : algebraMap B R M₀.det = ((LinearMap.toMatrix e e) L).det := by
      rw [RingHom.map_det (algebraMap B R) M₀, hMat_eq]
    rwa [hmap_det]
  exact ⟨b₀, g₀, hb₀_not_mQ, hg₀_ne, hb₀_iso, hg₀_span, hdet_span⟩

theorem weil_polyP1_last_coord_kummer_two_open_mv_functoriality (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z)) :
    ∃ (δ_sch : ∀ (X : AlgebraicGeometry.Scheme.{u}) (W₁ W₂ : X.Opens),
        W₁ ⊔ W₂ = ⊤ →
        Units ↑(X.presheaf.obj (Opposite.op (W₁ ⊓ W₂))) →
        (weilEtaleGmSheaf X).H 1),
      (∀ (X : AlgebraicGeometry.Scheme.{u})
          (W₁ W₂ W'₁ W'₂ : X.Opens)
          (hcov : W₁ ⊔ W₂ = ⊤) (hcov' : W'₁ ⊔ W'₂ = ⊤)
          (h₁ : W'₁ ≤ W₁) (h₂ : W'₂ ≤ W₂)
          (u : Units ↑(X.presheaf.obj (Opposite.op (W₁ ⊓ W₂)))),
        δ_sch X W'₁ W'₂ hcov'
            (Units.map (X.presheaf.map
              (CategoryTheory.homOfLE (inf_le_inf h₁ h₂)).op).hom.toMonoidHom u) =
          δ_sch X W₁ W₂ hcov u) ∧
      (∀ (X : AlgebraicGeometry.Scheme.{u})
          (W₁ W₂ : X.Opens) (hcov : W₁ ⊔ W₂ = ⊤)
          (u : Units ↑(X.presheaf.obj (Opposite.op (W₁ ⊓ W₂))))
          (ℱ 𝒬 : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
          (ι_sh : Quiver.Hom (weilEtaleGmSheaf X) ℱ)
          (π_sh : Quiver.Hom ℱ 𝒬)
          (h0_sh : CategoryTheory.CategoryStruct.comp ι_sh π_sh = 0)
          (hSE : (CategoryTheory.ShortComplex.mk ι_sh π_sh h0_sh).ShortExact),
