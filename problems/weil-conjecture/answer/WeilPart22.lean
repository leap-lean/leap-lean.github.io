        have hZ_ker_map : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel (F_W.map (pb_g.map u))) :=
          CategoryTheory.Limits.IsZero.of_iso (CategoryTheory.Limits.isZero_zero _)
            (CategoryTheory.Limits.kernel.ofMono (F_W.map (pb_g.map u)))
        have hZ_FW_K : CategoryTheory.Limits.IsZero (F_W.obj K_sh) :=
          hZ_ker_map.of_iso (CategoryTheory.Limits.PreservesKernel.iso F_W (pb_g.map u))
        let σ_v : Φ_W.fiber.obj V.unop := CategoryTheory.MorphismProperty.Over.homMk
          (CategoryTheory.Limits.pullback.lift α_v (𝟙 S_Ω) (CategoryTheory.Category.id_comp w_bar).symm)
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        have h_germ0 : (Φ_W.toPresheafFiber V.unop σ_v K_sh.obj).hom s =
            (Φ_W.toPresheafFiber V.unop σ_v K_sh.obj).hom 0 := by
          have hid0 : 𝟙 (Φ_W.presheafFiber.obj K_sh.obj) = 0 := hZ_FW_K.eq_of_src _ _
          have hzero : Φ_W.toPresheafFiber V.unop σ_v K_sh.obj = 0 :=
            (CategoryTheory.Category.comp_id (Φ_W.toPresheafFiber V.unop σ_v K_sh.obj)).symm.trans
              ((congrArg (Φ_W.toPresheafFiber V.unop σ_v K_sh.obj ≫ ·) hid0).trans
                CategoryTheory.Limits.comp_zero)
          exact (congrArg (fun φ : K_sh.obj.obj V ⟶ Φ_W.presheafFiber.obj K_sh.obj => φ.hom s)
            hzero).trans (map_zero _).symm
        rw [Φ_W.toPresheafFiber_eq_iff'] at h_germ0
        obtain ⟨U', f_U', τ', hτ', hf_s⟩ := h_germ0
        rw [map_zero] at hf_s
        let p₀ : ↥S_Ω := default
        have hα_pt : α_v.base p₀ = v := by
          dsimp [α_v]
          exact AlgebraicGeometry.Scheme.fromSpecResidueField_apply v _
        have hτ_eq : (τ'.left ≫ CategoryTheory.Limits.pullback.fst U'.hom w_bar) ≫ f_U'.left = α_v :=
          (CategoryTheory.Category.assoc τ'.left
              (CategoryTheory.Limits.pullback.fst U'.hom w_bar) f_U'.left).trans
            ((congrArg (τ'.left ≫ ·)
                (CategoryTheory.Limits.pullback.lift_fst
                  (CategoryTheory.Limits.pullback.fst U'.hom w_bar ≫ f_U'.left)
                  (CategoryTheory.Limits.pullback.snd U'.hom w_bar) _).symm).trans
              ((CategoryTheory.Category.assoc τ'.left
                  ((weilEtaleSitePullback w_bar).map f_U').left
                  (CategoryTheory.Limits.pullback.fst V.unop.hom w_bar)).symm.trans
                ((congrArg (fun m : T_spec Ω ⟶ (weilEtaleSitePullback w_bar).obj V.unop =>
                    m.left ≫ CategoryTheory.Limits.pullback.fst V.unop.hom w_bar) hτ').trans
                  (CategoryTheory.Limits.pullback.lift_fst α_v (𝟙 S_Ω) _))))
        refine ⟨U', f_U', (τ'.left ≫ CategoryTheory.Limits.pullback.fst U'.hom w_bar).base p₀, hf_s, ?_, ?_⟩
        · have hw_fU := CategoryTheory.MorphismProperty.Over.w f_U'
          exact CategoryTheory.MorphismProperty.of_postcomp
            (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})
            f_U'.left V.unop.hom V.unop.prop (hw_fU.symm ▸ U'.prop)
        · calc
            f_U'.left.base ((τ'.left ≫ CategoryTheory.Limits.pullback.fst U'.hom w_bar).base p₀)
              = ((τ'.left ≫ CategoryTheory.Limits.pullback.fst U'.hom w_bar) ≫ f_U'.left).base p₀ := rfl
            _ = α_v.base p₀ := congrArg (fun k => k.base p₀) hτ_eq
            _ = v := hα_pt
      exact hSep R_s hR_mem s 0 (fun U' f_U' hf => by
        change (K_sh.obj.map f_U'.op).hom s = (K_sh.obj.map f_U'.op).hom 0
        rw [map_zero]; exact hf)
    exact CategoryTheory.Preadditive.mono_of_isZero_kernel (pb_g.map u) hK_zero

  
  have hHDICalc : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      [hc : (weilEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology],
      let pf_h := (weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        X₂.smallEtaleTopology X₁.smallEtaleTopology
      (∀ (F : CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty (weilEtaleHigherDirectImage h 0 F ≅ pf_h.obj F)) ∧
      (∀ (SC : CategoryTheory.ShortComplex
            (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})),
        SC.ShortExact →
        (∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h p SC.X₂)) →
        ((∃ (δ₀ : pf_h.obj SC.X₃ ⟶ weilEtaleHigherDirectImage h 1 SC.X₁)
            (hcomp : pf_h.map SC.g ≫ δ₀ = 0),
            CategoryTheory.Epi δ₀ ∧
            (CategoryTheory.ShortComplex.mk (pf_h.map SC.g) δ₀ hcomp).Exact) ∧
         (∀ [_hr : pf_h.IsRightAdjoint],
            CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage h 1 SC.X₁) →
            (SC.map pf_h).ShortExact) ∧
         (∀ q : ℕ, 1 ≤ q →
            Nonempty (weilEtaleHigherDirectImage h (q + 1) SC.X₁ ≅
              weilEtaleHigherDirectImage h q SC.X₃)))) := by
    intro X₁ X₂ h hc
    let J_X := X₁.smallEtaleTopology
    let J_S := X₂.smallEtaleTopology
    let B_f : CategoryTheory.Functor X₂.Etale X₁.Etale := weilEtaleSitePullback h
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_X
    let W_B := (CategoryTheory.Functor.whiskeringLeft (Opposite X₂.Etale)
      (Opposite X₁.Etale) AddCommGrpCat.{u}).obj B_f.op
    let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
    let U_X := CategoryTheory.sheafToPresheaf J_X AddCommGrpCat.{u}
    let U_S := CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}
    let E_S := W_B ⋙ Sh_S
    let Φ : ∀ q : ℕ, CategoryTheory.Sheaf J_X AddCommGrpCat.{u} ⥤
        CategoryTheory.Sheaf J_S AddCommGrpCat.{u} :=
      fun q => CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X q ⋙ E_S
    have hDeg0Pre : Nonempty (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ U_X) := by
      let Free_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X₁.Etale)
        (Type u) AddCommGrpCat.{u}).obj AddCommGrpCat.free
      let Fgt_PSh := (CategoryTheory.Functor.whiskeringRight (Opposite X₁.Etale)
        AddCommGrpCat.{u} (Type u)).obj (CategoryTheory.forget AddCommGrpCat.{u})
      let adj_free := CategoryTheory.Adjunction.whiskerRight (Opposite X₁.Etale) AddCommGrpCat.adj
      let adj_sh := CategoryTheory.sheafificationAdjunction J_X AddCommGrpCat.{u}
      let adj_tot := adj_free.comp adj_sh
      let L_tot := Free_PSh ⋙ CategoryTheory.presheafToSheaf J_X AddCommGrpCat.{u}
      let Z_fun : X₁.Etale ⥤ CategoryTheory.Sheaf J_X AddCommGrpCat.{u} :=
        CategoryTheory.yoneda ⋙ L_tot
      let e_hom : ∀ (V : X₁.Etale) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          (Z_fun.obj V ⟶ F) ≃ ↥(F.obj.obj (Opposite.op V)) :=
        fun V F => (adj_tot.homEquiv (CategoryTheory.yoneda.obj V) F).trans
          CategoryTheory.yonedaEquiv
