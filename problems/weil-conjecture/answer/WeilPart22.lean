by
  
  have h_leftAdj_finColim :
      ∀ {𝒞 𝒟 : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
        [CategoryTheory.Category.{u + 1, u + 1} 𝒟]
