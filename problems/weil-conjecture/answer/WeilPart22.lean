        have h2_le_1 : ((2 : ℕ) : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) := h2_le.trans hDimSpec
        norm_num at h2_le_1

      
      obtain ⟨b₀, g₀, hb₀_not_mQ, _hg₀_ne, hg₀_iso, hg₀_span, hdet_span⟩ :=
        weil_polyP1_last_coord_dvr_isolator_norm_val_one k B A d hd bA m_Q P_id
          hOver hDVR_B hDVR_A hDim1_A
      let M₀_mat : Matrix (Fin d) (Fin d) B :=
        (LinearMap.toMatrix bA bA) (LinearMap.mulLeft B g₀)
      let Δ : B := M₀_mat.det
      have hdet_iso : ∀ p : Ideal B, p.IsPrime → b₀ ∉ p → (Δ ∈ p ↔ p = m_Q) := by
        intro p hp hb₀_p
        constructor
        · intro hΔ_p
          let M_sub : Submonoid A := Submonoid.map (algebraMap B A) p.primeCompl
          let A_M := Localization M_sub
          have hnot_unit : ¬ IsUnit (algebraMap A A_M g₀) := by
            rintro ⟨u, hu⟩
            have hu' : algebraMap A A_M g₀ * (u⁻¹ : A_Mˣ).val = 1 := by
              rw [← hu, Units.mul_inv]
            obtain ⟨⟨a', m'⟩, hm'⟩ := IsLocalization.surj M_sub (u⁻¹ : A_Mˣ).val
            have hm'_eq : algebraMap A A_M (g₀ * a') = algebraMap A A_M m'.1 := by
