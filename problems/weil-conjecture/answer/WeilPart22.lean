            apply CategoryTheory.Sheaf.hom_ext
            apply CategoryTheory.NatTrans.ext
            funext Y
            apply AddCommGrpCat.ext
            intro x
            exact congrArg (fun ψ : weilEtaleLocalTorsionSheaf Z (ℓ ^ (s + 1)) W ⟶
                weilEtaleLocalTorsionSheaf Z (ℓ ^ s) W =>
              (ψ.hom.app Y).hom x) hg_eq.symm)
      have _ : CategoryTheory.Mono ((SC_A.map P_W).map Sh_Z).f := hSE_Sh.mono_f
      have _ : CategoryTheory.Epi ((SC_A.map P_W).map Sh_Z).g := hSE_Sh.epi_g
      have hMono_l : CategoryTheory.Mono SC_l.f := by
        have hM : CategoryTheory.Mono (e_l.inv.τ₁ ≫ ((SC_A.map P_W).map Sh_Z).f) :=
          CategoryTheory.mono_comp _ _
