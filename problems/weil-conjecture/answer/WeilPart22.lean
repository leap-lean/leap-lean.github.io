  let F₁ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u} := P_push.obj (C₁.obj AM)
  let F₂ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u} := C₂.obj AM

  have h_ex_φ : ∀ (U : Y₂.left.Etale), Good U →
      ∀ σ : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))),
        ∃ t : ↑((C₂.obj AM).obj.obj (Opposite.op U)),
          ∀ (M : Type u) (hAdd : AddCommGroup M)
            (hMod : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (bM : Module.Basis (Fin δ) ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
            (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
              e (r₀ • m) =
                @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
                  (CommRingCat.Hom.hom
                    (AlgebraicGeometry.Scheme.Hom.appTop
                      (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
                  (e m)) →
            ∀ (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
              (∀ m : M, e (L m) = ι₁ (B.obj U) σ * e m) →
              ι₂ U t = ((LinearMap.toMatrix bM bM) L).det := by
    intro U hU σ
    let R_U := ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))
    let S_U := ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))
    let ρ_U : R_U →+* S_U := CommRingCat.Hom.hom
      (AlgebraicGeometry.Scheme.Hom.appTop
        (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f))
    rcases hU with ⟨_, M₀, hAdd₀, hMod₀, bM₀, e₀, he₀⟩
    letI : AddCommGroup M₀ := hAdd₀
    letI : Module R_U M₀ := hMod₀
    let u_σ : S_U := ι₁ (B.obj U) σ
    obtain ⟨L₀, hL₀⟩ := hA_ex ρ_U M₀ e₀ he₀ u_σ
    have hu_pow : u_σ ^ n = 1 := ((hMul₁ (B.obj U)).2 σ σ).2
    have hdet_pow : (((LinearMap.toMatrix bM₀ bM₀) L₀).det) ^ n = 1 :=
      hA_pow ρ_U M₀ bM₀ e₀ he₀ u_σ L₀ hu_pow hL₀
    obtain ⟨t, ht⟩ := hSurj₂ U (((LinearMap.toMatrix bM₀ bM₀) L₀).det) hdet_pow
    refine ⟨t, ?_⟩
    intro M hAdd hMod bM e he L hL
    letI : AddCommGroup M := hAdd
    letI : Module R_U M := hMod
    rw [ht]
    exact hA_indep ρ_U M₀ bM₀ e₀ he₀ M bM e he u_σ L₀ L hL₀ hL

  let φ_fun : ∀ (U : Y₂.left.Etale), Good U →
      ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))) →
        ↑((C₂.obj AM).obj.obj (Opposite.op U)) :=
    fun U hU σ => Classical.choose (h_ex_φ U hU σ)

  have hφ_spec : ∀ (U : Y₂.left.Etale) (hU : Good U)
      (σ : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))))
      (M : Type u) (hAdd : AddCommGroup M)
      (hMod : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
      (bM : Module.Basis (Fin δ) ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
      (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
