  have hB_etale_bc : ∀ {U' U : Y₂.left.Etale}
      (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj U').left)
      (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj U).left)
      (v : Quiver.Hom U' U),
      let R := ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))
      let R' := ↑(((Fgt₂.obj U').left).presheaf.obj (Opposite.op ⊤))
      let S := ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))
      let S' := ↑(((Fgt₁.obj (B.obj U')).left).presheaf.obj (Opposite.op ⊤))
      let ρ : R →+* S := CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop
          (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f))
      let ρ' : R' →+* S' := CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop
          (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U').hom f))
      let ψ_R : R →+* R' := CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₂.map v).left)
      let ψ_S : S →+* S' := CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₁.map (B.map v)).left)
      letI : Algebra R R' := RingHom.toAlgebra ψ_R
      letI : Algebra R S := RingHom.toAlgebra ρ
      ρ'.comp ψ_R = ψ_S.comp ρ ∧
      ∃ e_tensor : TensorProduct R R' S ≃+ S',
        ∀ (r' : R') (s : S), e_tensor (r' ⊗ₜ[R] s) = ρ' r' * ψ_S s := by
    intro U' U hAff_U' hAff_U v
    letI : AlgebraicGeometry.IsAffine (Fgt₂.obj U').left := hAff_U'
    letI : AlgebraicGeometry.IsAffine (Fgt₂.obj U).left := hAff_U
    letI : AlgebraicGeometry.IsAffine (Fgt₁.obj (B.obj U')).left := by
      change AlgebraicGeometry.IsAffine (CategoryTheory.Limits.pullback (Fgt₂.obj U').hom f)
      infer_instance
    letI : AlgebraicGeometry.IsAffine (Fgt₁.obj (B.obj U)).left := by
      change AlgebraicGeometry.IsAffine (CategoryTheory.Limits.pullback (Fgt₂.obj U).hom f)
      infer_instance
    let p_fst : (Fgt₁.obj (B.obj U)).left ⟶ (Fgt₂.obj U).left :=
      CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f
    let p_fst' : (Fgt₁.obj (B.obj U')).left ⟶ (Fgt₂.obj U').left :=
      CategoryTheory.Limits.pullback.fst (Fgt₂.obj U').hom f
    let p_snd : (Fgt₁.obj (B.obj U)).left ⟶ Y₁.left :=
      CategoryTheory.Limits.pullback.snd (Fgt₂.obj U).hom f
    let p_snd' : (Fgt₁.obj (B.obj U')).left ⟶ Y₁.left :=
      CategoryTheory.Limits.pullback.snd (Fgt₂.obj U').hom f
    have hv_w : (Fgt₂.map v).left ≫ (Fgt₂.obj U).hom = (Fgt₂.obj U').hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have h_lift_comm : (CategoryTheory.Limits.pullback.fst U'.hom f ≫ v.left) ≫ U.hom =
        CategoryTheory.Limits.pullback.snd U'.hom f ≫ f := by
      rw [Category.assoc, CategoryTheory.MorphismProperty.Over.w v,
        CategoryTheory.Limits.pullback.condition]
    have h_map : (Fgt₁.map (B.map v)).left =
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst U'.hom f ≫ v.left)
          (CategoryTheory.Limits.pullback.snd U'.hom f) h_lift_comm :=
      CategoryTheory.MorphismProperty.Over.pullback_map_left (@AlgebraicGeometry.Etale) ⊤ f v
    have hB_fst : (Fgt₁.map (B.map v)).left ≫ p_fst = p_fst' ≫ (Fgt₂.map v).left :=
      (congrArg (· ≫ p_fst) h_map).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    have hB_snd : (Fgt₁.map (B.map v)).left ≫ p_snd = p_snd' :=
      (congrArg (· ≫ p_snd) h_map).trans (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    have hPB_outer : CategoryTheory.IsPullback
        ((Fgt₁.map (B.map v)).left ≫ p_snd) p_fst' f
        ((Fgt₂.map v).left ≫ (Fgt₂.obj U).hom) := by
      rw [hB_snd, hv_w]
      exact (CategoryTheory.IsPullback.of_hasPullback (Fgt₂.obj U').hom f).flip
    have hPB_right : CategoryTheory.IsPullback p_snd p_fst f (Fgt₂.obj U).hom :=
      (CategoryTheory.IsPullback.of_hasPullback (Fgt₂.obj U).hom f).flip
    have hPB_left : CategoryTheory.IsPullback p_fst' ((Fgt₁.map (B.map v)).left)
        ((Fgt₂.map v).left) p_fst :=
      (CategoryTheory.IsPullback.of_right hPB_outer hB_fst hPB_right).flip
    exact hB_aff_pb hPB_left

