    let y₀ : ↥(G_Z.obj m).left := (S_spec.map (e_sm.unitIso.hom.app A)).left.base p₀
    refine ⟨G_Z.obj m, g_m, y₀, CategoryTheory.Presieve.in_coverByImage G_Z g_m, ?_, ?_⟩
    · have hw := CategoryTheory.MorphismProperty.Over.w g_m
