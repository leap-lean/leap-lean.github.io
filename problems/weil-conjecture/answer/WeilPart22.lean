      obtain ⟨hAdd_h₂, hLim_h₂, hColim_h₂, _⟩ := h_s2 h₂ hh₂
      have := hAdd_h₁; have := hLim_h₁; have := hColim_h₁
      have := hAdd_h₂; have := hLim_h₂; have := hColim_h₂
      have hAdd_comp₁ : (CategoryTheory.Functor.comp res_q res_h₁).Additive :=
        { map_add := fun {_ _ _ _} => by apply CategoryTheory.Sheaf.hom_ext; ext _ _; rfl }
      have hAdd_comp₂ : (CategoryTheory.Functor.comp res_q res_h₂).Additive :=
        { map_add := fun {_ _ _ _} => by apply CategoryTheory.Sheaf.hom_ext; ext _ _; rfl }

      let T₀ : X₀.Etale := weilEtaleIdTerminal X₀
      let σ₁_hom : M_h₁.obj T₀ ⟶ Q₁ :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 X₀ ≫ τ₁.inv.left)
          (by change (𝟙 X₀ ≫ τ₁.inv.left) ≫ Q₁.hom = 𝟙 X₀ ≫ (τ₁.inv.left ≫ Q₁.hom)
              exact CategoryTheory.Category.assoc _ _ _)
          trivial
      let σ₁_inv : Q₁ ⟶ M_h₁.obj T₀ :=
        CategoryTheory.MorphismProperty.Over.homMk τ₁.hom.left
          ((congrArg (τ₁.hom.left ≫ ·)
            (CategoryTheory.Category.id_comp (τ₁.inv.left ≫ Q₁.hom))).trans
            ((CategoryTheory.Category.assoc τ₁.hom.left τ₁.inv.left Q₁.hom).symm.trans
              ((congrArg (· ≫ Q₁.hom)
                (congrArg (fun (k : M_q.obj Q₁ ⟶ M_q.obj Q₁) => k.left) τ₁.hom_inv_id)).trans
                (CategoryTheory.Category.id_comp Q₁.hom))))
          trivial
      let σ₁ : M_h₁.obj T₀ ≅ Q₁ :=
        { hom := σ₁_hom
          inv := σ₁_inv
          hom_inv_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((congrArg (· ≫ τ₁.hom.left) (CategoryTheory.Category.id_comp τ₁.inv.left)).trans
              (congrArg (fun (k : Q₀ ⟶ Q₀) => k.left) τ₁.inv_hom_id))
            (Subsingleton.elim _ _)
          inv_hom_id := CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((congrArg (τ₁.hom.left ≫ ·) (CategoryTheory.Category.id_comp τ₁.inv.left)).trans
