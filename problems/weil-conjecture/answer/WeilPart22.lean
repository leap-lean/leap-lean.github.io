  have hNatComm : ∀ {W₁ W₂ : AlgebraicGeometry.Scheme.{u}}
      (F₀ F₁ : CategoryTheory.Functor
        (CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf W₂.smallEtaleTopology AddCommGrpCat.{u}))
      [F₀.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₀]
      [CategoryTheory.Limits.PreservesFiniteColimits F₀]
      [F₁.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F₁]
      [CategoryTheory.Limits.PreservesFiniteColimits F₁]
      (θ : Quiver.Hom F₀ F₁) (r : ℕ)
      (X Y : CategoryTheory.Sheaf W₁.smallEtaleTopology AddCommGrpCat.{u})
      (x : CategoryTheory.Abelian.Ext X Y r),
      ((F₀.mapExtAddHom X Y r) x).comp
        (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero r) =
      (CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp
        ((F₁.mapExtAddHom X Y r) x) (Nat.zero_add r) := by
    intro W₁ W₂ F₀ F₁ _ _ _ _ _ _ θ r
    induction r with
    | zero =>
      intro X Y x
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply]
      let fx : Quiver.Hom X Y := CategoryTheory.Abelian.Ext.homEquiv₀ x
      have hx : CategoryTheory.Abelian.Ext.mk₀ fx = x := by
        dsimp [fx]
        rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
      rw [← hx, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      exact congrArg CategoryTheory.Abelian.Ext.mk₀ (θ.naturality fx)
    | succ r ih =>
      intro X Y x
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply]
      let I := CategoryTheory.Injective.under Y
      let ι : Quiver.Hom Y I := CategoryTheory.Injective.ι Y
      let Q := CategoryTheory.Limits.cokernel ι
      let π : Quiver.Hom I Q := CategoryTheory.Limits.cokernel.π ι
      let S := CategoryTheory.ShortComplex.mk ι π (CategoryTheory.Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel ι) inferInstance inferInstance
      have hxI : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (r + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨y, hy⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hxI rfl
      have hS₀ : (S.map F₀).ShortExact := hS.map_of_exact F₀
      have hS₁ : (S.map F₁).ShortExact := hS.map_of_exact F₁
      have hNatExt : hS₀.extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (θ.app Q)).comp hS₁.extClass (Nat.zero_add 1) := by
        have hraw := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hS₀ hS₁ (S.mapNatTrans θ)
        rwa [CategoryTheory.ShortComplex.mapNatTrans_τ₁,
          CategoryTheory.ShortComplex.mapNatTrans_τ₃] at hraw
      have h_ih : (CategoryTheory.Abelian.Ext.mapExactFunctor F₀ y).comp
          (CategoryTheory.Abelian.Ext.mk₀ (θ.app Q)) (Nat.add_zero r) =
          (CategoryTheory.Abelian.Ext.mk₀ (θ.app X)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor F₁ y) (Nat.zero_add r) := by
        simpa only [CategoryTheory.Functor.mapExtAddHom_apply] using ih X Q y
      rw [← hy]
      calc
        (CategoryTheory.Abelian.Ext.mapExactFunctor F₀ (y.comp hS.extClass rfl)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero (r + 1))
          = ((CategoryTheory.Abelian.Ext.mapExactFunctor F₀ y).comp hS₀.extClass rfl).comp
              (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero (r + 1)) := by
            rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
        _ = (CategoryTheory.Abelian.Ext.mapExactFunctor F₀ y).comp
              (hS₀.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (θ.app Y)) (Nat.add_zero 1))
