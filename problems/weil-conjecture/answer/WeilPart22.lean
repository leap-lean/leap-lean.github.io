      (fun {Z₁ Z₂} u =>
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          (hθ_nat_gen f p Z₁.hom Z₂.hom u.left (B_f'.map u).left (B_f.map (M_p.map u)).left
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            (CategoryTheory.Limits.pullback.lift_fst _ _ _)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _))
          (Subsingleton.elim _ _))

  let δ_q : ∀ (W' : X'.Etale),
      weilPolyP1CohomologyRepSheaf X' W' ⟶
        res_q.obj (weilPolyP1CohomologyRepSheaf X (M_q.obj W')) :=
    fun W' =>
      (weilPolyP1CohomologyRepHomEquiv X' W'
        (res_q.obj (weilPolyP1CohomologyRepSheaf X (M_q.obj W')))).symm
        (weilPolyP1CohomologyRepHomEquiv X (M_q.obj W')
          (weilPolyP1CohomologyRepSheaf X (M_q.obj W'))
          (𝟙 (weilPolyP1CohomologyRepSheaf X (M_q.obj W'))))

  have hδ_q_nat : ∀ {W'₁ W'₂ : X'.Etale} (g : W'₁ ⟶ W'₂),
      (R_fun X').map g ≫ δ_q W'₂ = δ_q W'₁ ≫ res_q.map ((R_fun X).map (M_q.map g)) := by
    intro W'₁ W'₂ g
    apply (weilPolyP1CohomologyRepHomEquiv X' W'₁
      (res_q.obj (weilPolyP1CohomologyRepSheaf X (M_q.obj W'₂)))).injective
    rw [hYonedaPrecomp X' g (δ_q W'₂), hYonedaComp X' W'₁ (δ_q W'₁)]
    have hδ₂ : weilPolyP1CohomologyRepHomEquiv X' W'₂ _ (δ_q W'₂) =
        weilPolyP1CohomologyRepHomEquiv X (M_q.obj W'₂) _ (𝟙 _) :=
      (weilPolyP1CohomologyRepHomEquiv X' W'₂ _).apply_symm_apply _
    have hδ₁ : weilPolyP1CohomologyRepHomEquiv X' W'₁ _ (δ_q W'₁) =
        weilPolyP1CohomologyRepHomEquiv X (M_q.obj W'₁) _ (𝟙 _) :=
      (weilPolyP1CohomologyRepHomEquiv X' W'₁ _).apply_symm_apply _
    rw [hδ₂, hδ₁]
    have hL := (hYonedaPrecomp X (M_q.map g)
      (𝟙 (weilPolyP1CohomologyRepSheaf X (M_q.obj W'₂)))).symm
    have hR := (hYonedaComp X (M_q.obj W'₁)
      (𝟙 (weilPolyP1CohomologyRepSheaf X (M_q.obj W'₁)))
      ((R_fun X).map (M_q.map g))).symm
    have hMid : (R_fun X).map (M_q.map g) ≫ 𝟙 _ = 𝟙 _ ≫ (R_fun X).map (M_q.map g) :=
      (CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm
    exact hL.trans ((congrArg (weilPolyP1CohomologyRepHomEquiv X (M_q.obj W'₁) _) hMid).trans hR)

  let e_Ψ : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (W' : X'.Etale),
      CategoryTheory.Abelian.Ext (weilPolyP1CohomologyRepSheaf X (M_q.obj W')) F q ≃+
        CategoryTheory.Abelian.Ext (weilPolyP1CohomologyRepSheaf X' W') (res_q.obj F) q :=
    fun q F W' =>
      AddEquiv.ofBijective
        (((CategoryTheory.Abelian.Ext.mk₀ (δ_q W')).precomp (res_q.obj F) (Nat.zero_add q)).comp
          (res_q.mapExtAddHom (weilPolyP1CohomologyRepSheaf X (M_q.obj W')) F q))
        (hBij_q q F W')

  have he_Ψ_apply : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
      (W' : X'.Etale) (ξ : CategoryTheory.Abelian.Ext (weilPolyP1CohomologyRepSheaf X (M_q.obj W')) F q),
      e_Ψ q F W' ξ = (CategoryTheory.Abelian.Ext.mk₀ (δ_q W')).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ) (Nat.zero_add q) :=
    fun _ _ _ _ => rfl

  let eCohom : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      (res_q.obj F).cohomologyPresheaf q ≅ M_q.op ⋙ (F.cohomologyPresheaf q) :=
    fun q F =>
      CategoryTheory.NatIso.ofComponents
        (fun opW' =>
          { hom := AddCommGrpCat.ofHom (e_Ψ q F (Opposite.unop opW')).symm.toAddMonoidHom
            inv := AddCommGrpCat.ofHom (e_Ψ q F (Opposite.unop opW')).toAddMonoidHom
            hom_inv_id := AddCommGrpCat.hom_ext (AddMonoidHom.ext fun y =>
              (e_Ψ q F (Opposite.unop opW')).apply_symm_apply y)
            inv_hom_id := AddCommGrpCat.hom_ext (AddMonoidHom.ext fun x =>
              (e_Ψ q F (Opposite.unop opW')).symm_apply_apply x) })
        (fun {opW'₁ opW'₂} g => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          intro y
          apply (e_Ψ q F (Opposite.unop opW'₂)).injective
          let u : Opposite.unop opW'₂ ⟶ Opposite.unop opW'₁ := g.unop
          let ξ := (e_Ψ q F (Opposite.unop opW'₁)).symm y
          change e_Ψ q F (Opposite.unop opW'₂)
              ((e_Ψ q F (Opposite.unop opW'₂)).symm
                ((CategoryTheory.Abelian.Ext.mk₀ ((R_fun X').map u)).comp y (Nat.zero_add q))) =
            e_Ψ q F (Opposite.unop opW'₂)
              ((CategoryTheory.Abelian.Ext.mk₀ ((R_fun X).map (M_q.map u))).comp ξ (Nat.zero_add q))
          rw [(e_Ψ q F (Opposite.unop opW'₂)).apply_symm_apply, he_Ψ_apply]
          have hy : y = (CategoryTheory.Abelian.Ext.mk₀ (δ_q (Opposite.unop opW'₁))).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ) (Nat.zero_add q) :=
            ((e_Ψ q F (Opposite.unop opW'₁)).apply_symm_apply y).symm
          rw [hy,
            ← CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X').map u))
              (CategoryTheory.Abelian.Ext.mk₀ (δ_q (Opposite.unop opW'₁)))
              (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ)
              (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            hδ_q_nat u,
            ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_q
              (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X).map (M_q.map u))) ξ (Nat.zero_add q),
            CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc
              (CategoryTheory.Abelian.Ext.mk₀ (δ_q (Opposite.unop opW'₂)))
              (CategoryTheory.Abelian.Ext.mk₀ (res_q.map ((R_fun X).map (M_q.map u))))
              (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ)
              (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q)])

  have heCohom_nat : ∀ (q : ℕ)
      {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}} (φ : F₁ ⟶ F₂),
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map (res_q.map φ)) ≫
          (eCohom q F₂).hom =
        (eCohom q F₁).hom ≫
          CategoryTheory.Functor.whiskerLeft M_q.op
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X.smallEtaleTopology q).map φ) := by
    intro q F₁ F₂ φ
    refine CategoryTheory.NatTrans.ext (funext fun opW' =>
      AddCommGrpCat.hom_ext (AddMonoidHom.ext fun y => ?_))
    apply (e_Ψ q F₂ (Opposite.unop opW')).injective
    let ξ := (e_Ψ q F₁ (Opposite.unop opW')).symm y
    change e_Ψ q F₂ (Opposite.unop opW')
        ((e_Ψ q F₂ (Opposite.unop opW')).symm
          (y.comp (CategoryTheory.Abelian.Ext.mk₀ (res_q.map φ)) (Nat.add_zero q))) =
      e_Ψ q F₂ (Opposite.unop opW')
        (ξ.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q))
    rw [(e_Ψ q F₂ (Opposite.unop opW')).apply_symm_apply, he_Ψ_apply]
    have hy : y = (CategoryTheory.Abelian.Ext.mk₀ (δ_q (Opposite.unop opW'))).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ) (Nat.zero_add q) :=
      ((e_Ψ q F₁ (Opposite.unop opW')).apply_symm_apply y).symm
    rw [hy,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_q ξ
        (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc
        (CategoryTheory.Abelian.Ext.mk₀ (δ_q (Opposite.unop opW')))
        (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ)
        (CategoryTheory.Abelian.Ext.mk₀ (res_q.map φ))
        (Nat.zero_add q) (Nat.add_zero q) (by omega)]

  let eThetaPre : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      B_f'.op ⋙ (M_q.op ⋙ F.cohomologyPresheaf q) ≅ M_p.op ⋙ (B_f.op ⋙ F.cohomologyPresheaf q) :=
    fun q F =>
      CategoryTheory.NatIso.ofComponents
        (fun opZ =>
          { hom := (F.cohomologyPresheaf q).map (Opposite.op ((θ_pb.app (Opposite.unop opZ)).inv))
            inv := (F.cohomologyPresheaf q).map (Opposite.op ((θ_pb.app (Opposite.unop opZ)).hom))
            hom_inv_id :=
              (((F.cohomologyPresheaf q).map_comp _ _).symm.trans
                (congrArg (fun k => (F.cohomologyPresheaf q).map (Opposite.op k))
                  (θ_pb.app (Opposite.unop opZ)).hom_inv_id)).trans
                ((F.cohomologyPresheaf q).map_id _)
            inv_hom_id :=
              (((F.cohomologyPresheaf q).map_comp _ _).symm.trans
                (congrArg (fun k => (F.cohomologyPresheaf q).map (Opposite.op k))
                  (θ_pb.app (Opposite.unop opZ)).inv_hom_id)).trans
                ((F.cohomologyPresheaf q).map_id _) })
        (fun {opZ₁ opZ₂} g => by
          have hinv_nat : B_f.map (M_p.map g.unop) ≫ (θ_pb.app (Opposite.unop opZ₁)).inv =
              (θ_pb.app (Opposite.unop opZ₂)).inv ≫ M_q.map (B_f'.map g.unop) := by
            apply (CategoryTheory.Iso.comp_inv_eq (θ_pb.app (Opposite.unop opZ₁))).mpr
            exact ((CategoryTheory.Category.assoc _ _ _).trans
              ((congrArg ((θ_pb.app (Opposite.unop opZ₂)).inv ≫ ·)
                (θ_pb.hom.naturality g.unop)).trans
                ((CategoryTheory.Category.assoc _ _ _).symm.trans
                  ((congrArg (· ≫ (M_p ⋙ B_f).map g.unop)
                    (θ_pb.app (Opposite.unop opZ₂)).inv_hom_id).trans
                    (CategoryTheory.Category.id_comp _))))).symm
          exact (((F.cohomologyPresheaf q).map_comp _ _).symm.trans
            (congrArg (fun k => (F.cohomologyPresheaf q).map (Opposite.op k)) hinv_nat.symm)).trans
            ((F.cohomologyPresheaf q).map_comp _ _))

  let ePre : ∀ (q : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
      B_f'.op ⋙ (res_q.obj F).cohomologyPresheaf q ≅ M_p.op ⋙ (B_f.op ⋙ F.cohomologyPresheaf q) :=
    fun q F =>
      ((CategoryTheory.Functor.whiskeringLeft (Opposite S'.Etale) (Opposite X'.Etale)
        AddCommGrpCat.{u}).obj B_f'.op).mapIso (eCohom q F) ≪≫ eThetaPre q F

  let sh_S' := CategoryTheory.presheafToSheaf S'.smallEtaleTopology AddCommGrpCat.{u}
