          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S n U)) (Nat.add_zero q) =
        z'.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionCounit S n U'))
          (Nat.add_zero q)
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero z' _ _ (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hCounit_comp]
    · intro U s U_a w hOpen hDisj hCov z
      have hCover_mem : ∀ (V : S.Etale) (k_s : ℕ) (V_a : Fin k_s → S.Etale)
          (v_a : ∀ a : Fin k_s, V_a a ⟶ V),
          (∀ a : Fin k_s, AlgebraicGeometry.Etale (v_a a).left) →
          (⋃ a : Fin k_s, Set.range (v_a a).left.base) = Set.univ →
          CategoryTheory.Sieve.ofArrows V_a v_a ∈ S.smallEtaleTopology V := by
        intro V k_s V_a v_a hEt_v hCov_v
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
          @AlgebraicGeometry.Etale
        let V_ov : P_et.Over ⊤ S := V
        let R_ov : CategoryTheory.Sieve V_ov := CategoryTheory.Sieve.ofArrows V_a v_a
        let P_pre : CategoryTheory.PreZeroHypercover V.left :=
          CategoryTheory.PreZeroHypercover.mk (ULift.{u} (Fin k_s))
            (fun j => (V_a j.down).left) (fun j => (v_a j.down).left)
        have h_mem : P_pre.presieve₀ ∈
            (AlgebraicGeometry.Scheme.precoverage P_et).coverings V.left := by
          rw [AlgebraicGeometry.Scheme.precoverage]
          refine ⟨fun x => ?_, ?_⟩
          · have hx : x ∈ (Set.univ : Set ↥V.left) := Set.mem_univ x
            rw [← hCov_v, Set.mem_iUnion] at hx
            obtain ⟨a, y, hy⟩ := hx
            exact ⟨_, AlgebraicGeometry.Scheme.forget.map (v_a a).left,
              CategoryTheory.Presieve.map.of (CategoryTheory.Presieve.ofArrows.mk (ULift.up a)),
              y, hy⟩
          · rintro Y f ⟨j⟩
            exact hEt_v j.down
        let 𝒰 : AlgebraicGeometry.Scheme.Cover
            (AlgebraicGeometry.Scheme.precoverage P_et) V_ov.left :=
          ⟨P_pre, h_mem⟩
        let ov_V : AlgebraicGeometry.Scheme.Over V_ov.left S :=
          CategoryTheory.OverClass.fromOver V_ov.toComma
        let ov_j : ∀ j : 𝒰.I₀, AlgebraicGeometry.Scheme.Over (𝒰.X j) S :=
          fun j => CategoryTheory.OverClass.fromOver (V_a j.down).toComma
        let inst_over : @AlgebraicGeometry.Scheme.Cover.Over S P_et _ _ V_ov.left ov_V 𝒰 :=
          @AlgebraicGeometry.Scheme.Cover.Over.mk S P_et _ _ V_ov.left ov_V 𝒰 ov_j
            (fun j => by
              let _ : AlgebraicGeometry.Scheme.Over (𝒰.X j) S := ov_j j
              let _ : AlgebraicGeometry.Scheme.Over V_ov.left S := ov_V
              rw [AlgebraicGeometry.Scheme.Hom.isOver_iff]
              exact CategoryTheory.MorphismProperty.Over.w (v_a j.down))
        exact (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (P := P_et) (S := S)
          V_ov R_ov).mpr ⟨𝒰, inst_over, fun j => (V_a j.down).prop, by
          rintro W₀ g ⟨j⟩
          refine ⟨V_a j.down, 𝟙 (V_a j.down), v_a j.down,
            CategoryTheory.Presieve.ofArrows.mk j.down, ?_⟩
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext
          · exact CategoryTheory.Category.id_comp _
          · exact Subsingleton.elim _ _⟩

      have hTerm_empty : ∀ (F : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (V : S.Etale),
          IsEmpty ↥V.left → CategoryTheory.Limits.IsTerminal (F.obj.obj (Opposite.op V)) := by
        intro F V hEmp
        let V_emp : Fin 0 → S.Etale := Fin.elim0
        let v_emp : ∀ a : Fin 0, V_emp a ⟶ V := fun a => Fin.elim0 a
        have h0 := hCover_mem V 0 V_emp v_emp (fun a => Fin.elim0 a)
          (by ext x; exact IsEmpty.elim hEmp x)
        have h_bot : CategoryTheory.Sieve.ofArrows V_emp v_emp = (⊥ : CategoryTheory.Sieve V) := by
          ext W₀ f₀
          constructor
          · rintro ⟨Z, u, g, ⟨a⟩, _⟩
            exact Fin.elim0 a
          · rintro ⟨⟩
        rw [h_bot] at h0
        exact CategoryTheory.Sheaf.isTerminalOfBotCover F V h0

      have hEt_w : ∀ a : Fin s, AlgebraicGeometry.Etale (w a).left := by
        intro a
        have _ : AlgebraicGeometry.IsOpenImmersion (w a).left := hOpen a
        infer_instance
      let R_cov : CategoryTheory.Sieve U := CategoryTheory.Sieve.ofArrows U_a w
      have hR_cov : R_cov ∈ S.smallEtaleTopology U := hCover_mem U s U_a w hEt_w hCov

      have hUniq : ∀ {V : S.Etale} (hNe : Nonempty ↥V.left)
          {b₁ b₂ : Fin s} {h₁ : V ⟶ U_a b₁} {h₂ : V ⟶ U_a b₂},
          h₁ ≫ w b₁ = h₂ ≫ w b₂ →
          ∃ (hb : b₁ = b₂), h₁ ≫ eqToHom (congrArg U_a hb) = h₂ := by
        intro V hNe b₁ b₂ h₁ h₂ heq
        let v₀ : ↥V.left := Classical.choice hNe
        have h_pt : (w b₁).left.base (h₁.left.base v₀) = (w b₂).left.base (h₂.left.base v₀) :=
          congrArg (fun k : V ⟶ U => k.left.base v₀) heq
        have hb : b₁ = b₂ := by
          by_contra hne
          exact Set.disjoint_left.mp (hDisj b₁ b₂ hne)
            ⟨h₁.left.base v₀, rfl⟩ ⟨h₂.left.base v₀, h_pt.symm⟩
        subst hb
        refine ⟨rfl, ?_⟩
        rw [eqToHom_refl, CategoryTheory.Category.comp_id]
        have _ : AlgebraicGeometry.IsOpenImmersion (w b₁).left := hOpen b₁
        have h_left_eq : h₁.left ≫ (w b₁).left = h₂.left ≫ (w b₁).left :=
          congrArg (fun k : V ⟶ U => k.left) heq
        exact CategoryTheory.MorphismProperty.Comma.Hom.ext
          ((cancel_mono (w b₁).left).mp h_left_eq) (Subsingleton.elim _ _)

      have hR_ex : ∀ {V : S.Etale} {g : V ⟶ U}, R_cov.arrows g →
          ∃ (b : Fin s) (h_V : V ⟶ U_a b), h_V ≫ w b = g := by
        rintro V g ⟨W₀, u₀, f₀, ⟨b⟩, rfl⟩
        exact ⟨b, u₀, rfl⟩

      let L_U := weilEtaleLocalTorsionSheaf S n U
      let L_a : Fin s → CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
        fun a => weilEtaleLocalTorsionSheaf S n (U_a a)

      have hex_proj : ∀ a : Fin s,
          ∃ π_a : L_U ⟶ L_a a,
            (CategoryTheory.Sheaf.freeYonedaHomEquiv π_a ≫ (L_a a).obj.map (Opposite.op (w a)) =
              CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_a a))) ∧
            (∀ b : Fin s, b ≠ a →
              CategoryTheory.Sheaf.freeYonedaHomEquiv π_a ≫
                (L_a a).obj.map (Opposite.op (w b)) = 0) := by
        intro a
        let ι_a : AM ⟶ (L_a a).obj.obj (Opposite.op (U_a a)) :=
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L_a a))
        let κ : ∀ (V : S.Etale) (g : V ⟶ U), R_cov.arrows g →
            (AM ⟶ (L_a a).obj.obj (Opposite.op V)) :=
          fun V g hg =>
            if _ : IsEmpty ↥V.left then 0
            else
              let b := Classical.choose (hR_ex hg)
              let h_V : V ⟶ U_a b := Classical.choose (Classical.choose_spec (hR_ex hg))
              if hba : b = a then
                ι_a ≫ (L_a a).obj.map (Opposite.op (h_V ≫ eqToHom (congrArg U_a hba)))
              else 0
        have hκ_congr : ∀ {V : S.Etale} {g₁ g₂ : V ⟶ U} (_ : g₁ = g₂)
            (hg₁ : R_cov.arrows g₁) (hg₂ : R_cov.arrows g₂),
            κ V g₁ hg₁ = κ V g₂ hg₂ := by
          rintro V g₁ _ rfl _ _
          rfl
        have hκ_eval : ∀ (V : S.Etale) (b : Fin s) (h_V : V ⟶ U_a b)
            (hg : R_cov.arrows (h_V ≫ w b)),
            κ V (h_V ≫ w b) hg =
              if hba : b = a then
                ι_a ≫ (L_a a).obj.map (Opposite.op (h_V ≫ eqToHom (congrArg U_a hba)))
              else 0 := by
          intro V b h_V hg
          by_cases hEmp : IsEmpty ↥V.left
          · exact (hTerm_empty (L_a a) V hEmp).hom_ext _ _
          · have hNe : Nonempty ↥V.left := not_isEmpty_iff.mp hEmp
            dsimp only [κ]
            rw [dite_eq_right_iff.mpr (fun h => absurd h hEmp)]
            set b₀ := Classical.choose (hR_ex hg)
            set h₀ : V ⟶ U_a b₀ := Classical.choose (Classical.choose_spec (hR_ex hg))
            have hh₀ : h₀ ≫ w b₀ = h_V ≫ w b :=
              Classical.choose_spec (Classical.choose_spec (hR_ex hg))
            obtain ⟨hb_eq, hh_eq⟩ := hUniq hNe hh₀
            by_cases hba : b = a
            · have hb₀a : b₀ = a := hb_eq.trans hba
              rw [dif_pos hb₀a, dif_pos hba]
              have h_comp_eq : h₀ ≫ eqToHom (congrArg U_a hb₀a) =
                  h_V ≫ eqToHom (congrArg U_a hba) := by
                rw [← hh_eq, CategoryTheory.Category.assoc, eqToHom_trans]
              rw [h_comp_eq]
            · have hb₀a : b₀ ≠ a := fun h0 => hba (hb_eq.symm.trans h0)
              rw [dif_neg hb₀a, dif_neg hba]
        let c_cone : CategoryTheory.Limits.Cone (R_cov.arrows.diagram.op ⋙ (L_a a).obj) :=
          { pt := AM
            π :=
              { app := fun j => κ j.unop.obj.left j.unop.obj.hom j.unop.property
                naturality := fun {j₁ j₂} α => by
                  dsimp
                  rw [CategoryTheory.Category.id_comp]
                  let u : j₂.unop.obj.left ⟶ j₁.unop.obj.left := α.unop.hom.left
                  have hu_w : u ≫ j₁.unop.obj.hom = j₂.unop.obj.hom := α.unop.hom.w
                  obtain ⟨b, h_V, hh_V⟩ := hR_ex j₁.unop.property
                  have hg₁ : R_cov.arrows (h_V ≫ w b) := hh_V.symm ▸ j₁.unop.property
                  have h_eq₂ : j₂.unop.obj.hom = (u ≫ h_V) ≫ w b := by
                    rw [CategoryTheory.Category.assoc, hh_V, hu_w]
                  have hg₂ : R_cov.arrows ((u ≫ h_V) ≫ w b) := h_eq₂ ▸ j₂.unop.property
                  rw [hκ_congr hh_V.symm j₁.unop.property hg₁,
                    hκ_congr h_eq₂ j₂.unop.property hg₂,
                    hκ_eval _ b h_V hg₁, hκ_eval _ b (u ≫ h_V) hg₂]
                  split_ifs with hba
                  · have hop : ((u ≫ h_V) ≫ eqToHom (congrArg U_a hba)).op =
                        (h_V ≫ eqToHom (congrArg U_a hba)).op ≫ u.op := by
                      rw [CategoryTheory.Category.assoc]
                      rfl
                    change ι_a ≫ (L_a a).obj.map (((u ≫ h_V) ≫ eqToHom (congrArg U_a hba)).op) =
                      (ι_a ≫ (L_a a).obj.map ((h_V ≫ eqToHom (congrArg U_a hba)).op)) ≫
                        (L_a a).obj.map u.op
                    rw [hop, CategoryTheory.Functor.map_comp, ← CategoryTheory.Category.assoc]
                  · exact CategoryTheory.Limits.zero_comp.symm } }
        let hLim_a : CategoryTheory.Limits.IsLimit ((L_a a).obj.mapCone R_cov.arrows.cocone.op) :=
          Classical.choice ((CategoryTheory.Presheaf.isSheaf_iff_isLimit S.smallEtaleTopology
            (L_a a).obj).mp (L_a a).property R_cov hR_cov)
        let f_tilde : AM ⟶ (L_a a).obj.obj (Opposite.op U) := hLim_a.lift c_cone
        have hf_wb : ∀ b : Fin s,
            f_tilde ≫ (L_a a).obj.map (Opposite.op (w b)) =
              if hba : b = a then
                ι_a ≫ (L_a a).obj.map (Opposite.op (𝟙 (U_a b) ≫ eqToHom (congrArg U_a hba)))
              else 0 := by
          intro b
          have hwb_mem : R_cov.arrows (w b) :=
            ⟨U_a b, 𝟙 (U_a b), w b, CategoryTheory.Presieve.ofArrows.mk b,
              CategoryTheory.Category.id_comp _⟩
          let j_b : R_cov.arrows.category := ⟨CategoryTheory.Over.mk (w b), hwb_mem⟩
          have hfac := hLim_a.fac c_cone (Opposite.op j_b)
          change f_tilde ≫ (L_a a).obj.map (Opposite.op (w b)) = κ (U_a b) (w b) hwb_mem at hfac
          have hwb_id : R_cov.arrows (𝟙 (U_a b) ≫ w b) :=
            (CategoryTheory.Category.id_comp (w b)).symm ▸ hwb_mem
          rw [hfac, hκ_congr (CategoryTheory.Category.id_comp (w b)).symm hwb_mem hwb_id,
            hκ_eval (U_a b) b (𝟙 (U_a b)) hwb_id]
        refine ⟨CategoryTheory.Sheaf.freeYonedaHomEquiv.symm f_tilde, ?_, ?_⟩
        · rw [Equiv.apply_symm_apply, hf_wb a]
          split_ifs with h_aa
          · have hid_op : Opposite.op (𝟙 (U_a a) ≫ eqToHom (congrArg U_a h_aa)) =
                𝟙 (Opposite.op (U_a a)) := by
              rw [eqToHom_refl, CategoryTheory.Category.comp_id]
              rfl
            rw [hid_op, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
          · exact absurd rfl h_aa
        · intro b hba
          rw [Equiv.apply_symm_apply, hf_wb b]
          split_ifs with h_ba
          · exact absurd h_ba hba
          · rfl

      choose π_a hπ_diag hπ_off using hex_proj
      let ψ : Fin s → (L_U ⟶ L_U) := fun a => π_a a ≫ weilEtaleLocalTorsionMap S n (w a)
      have hSum_id : (∑ a : Fin s, ψ a) = 𝟙 L_U := by
        apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
        let hLim_U : CategoryTheory.Limits.IsLimit (L_U.obj.mapCone R_cov.arrows.cocone.op) :=
          Classical.choice ((CategoryTheory.Presheaf.isSheaf_iff_isLimit S.smallEtaleTopology
            L_U.obj).mp L_U.property R_cov hR_cov)
        have h_on_wb : ∀ b : Fin s,
            CategoryTheory.Sheaf.freeYonedaHomEquiv (∑ a : Fin s, ψ a) ≫
              L_U.obj.map (Opposite.op (w b)) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫
              L_U.obj.map (Opposite.op (w b)) := by
          intro b
          have h_sum_app : (∑ a : Fin s, ψ a).hom.app (Opposite.op U) =
              ∑ a : Fin s, (ψ a).hom.app (Opposite.op U) := by
            have h_eval : ∀ (S_fin : Finset (Fin s)),
                (∑ a ∈ S_fin, ψ a).hom.app (Opposite.op U) =
                  ∑ a ∈ S_fin, (ψ a).hom.app (Opposite.op U) := by
              intro S_fin
              refine Finset.induction_on S_fin ?_ ?_
              · rfl
              · intro a₀ S₀ ha₀ ih
                rw [Finset.sum_insert ha₀, Finset.sum_insert ha₀]
                change (ψ a₀).hom.app (Opposite.op U) + (∑ a ∈ S₀, ψ a).hom.app (Opposite.op U) = _
                rw [ih]
            exact h_eval Finset.univ
          have h_lhs_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv (∑ a : Fin s, ψ a) =
              ∑ a : Fin s, CategoryTheory.Sheaf.freeYonedaHomEquiv (ψ a) := by
            have h1 : ∀ f : L_U ⟶ L_U, CategoryTheory.Sheaf.freeYonedaHomEquiv f =
                CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫ f.hom.app (Opposite.op U) := by
              intro f
              rw [← hEquiv_comp (𝟙 L_U) f, CategoryTheory.Category.id_comp]
            rw [h1 (∑ a : Fin s, ψ a), h_sum_app, CategoryTheory.Preadditive.comp_sum]
            exact Finset.sum_congr rfl (fun a _ => (h1 (ψ a)).symm)
          rw [h_lhs_eq, CategoryTheory.Preadditive.sum_comp]
          rw [Finset.sum_eq_single b]
          · dsimp [ψ]
            rw [hEquiv_comp, CategoryTheory.Category.assoc,
              ← (weilEtaleLocalTorsionMap S n (w b)).hom.naturality (Opposite.op (w b)),
              ← CategoryTheory.Category.assoc, hπ_diag b,
              ← hEquiv_comp (𝟙 (L_a b)) (weilEtaleLocalTorsionMap S n (w b)),
              CategoryTheory.Category.id_comp]
            exact Equiv.apply_symm_apply _ _
          · intro a _ hab
            dsimp [ψ]
            rw [hEquiv_comp, CategoryTheory.Category.assoc,
              ← (weilEtaleLocalTorsionMap S n (w a)).hom.naturality (Opposite.op (w b)),
              ← CategoryTheory.Category.assoc, hπ_off a b (Ne.symm hab),
              CategoryTheory.Limits.zero_comp]
          · intro hb_not
            exact absurd (Finset.mem_univ b) hb_not
        apply hLim_U.hom_ext
        intro j
        obtain ⟨b, h_V, hh_V⟩ := hR_ex j.unop.property
        change CategoryTheory.Sheaf.freeYonedaHomEquiv (∑ a : Fin s, ψ a) ≫
            L_U.obj.map j.unop.obj.hom.op =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U) ≫
            L_U.obj.map j.unop.obj.hom.op
        have hop_eq : j.unop.obj.hom.op = (w b).op ≫ h_V.op := by
          rw [← hh_V]
          rfl
        rw [hop_eq, CategoryTheory.Functor.map_comp, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ L_U.obj.map h_V.op) (h_on_wb b)

      let z_a : ∀ a : Fin s, weilEtaleLocalTorsionH S n (U_a a) q :=
        fun a => (CategoryTheory.Abelian.Ext.mk₀ (π_a a)).postcomp Fℤ (Nat.add_zero q) z
      refine ⟨z_a, ?_⟩
      have hExt_sum : ∀ (S_fin : Finset (Fin s)),
          z.comp (CategoryTheory.Abelian.Ext.mk₀ (∑ a ∈ S_fin, ψ a)) (Nat.add_zero q) =
            ∑ a ∈ S_fin, weilEtaleLocalTorsionMapH S n (w a) q (z_a a) := by
        intro S_fin
        refine Finset.induction_on S_fin ?_ ?_
        · rw [Finset.sum_empty, Finset.sum_empty, CategoryTheory.Abelian.Ext.mk₀_zero,
            CategoryTheory.Abelian.Ext.comp_zero]
        · intro a₀ S₀ ha₀ ih
          rw [Finset.sum_insert ha₀, Finset.sum_insert ha₀, CategoryTheory.Abelian.Ext.mk₀_add,
            CategoryTheory.Abelian.Ext.comp_add, ih]
          congr 1
          dsimp [ψ, z_a, weilEtaleLocalTorsionMapH]
          change z.comp (CategoryTheory.Abelian.Ext.mk₀
              (π_a a₀ ≫ weilEtaleLocalTorsionMap S n (w a₀))) (Nat.add_zero q) =
            (z.comp (CategoryTheory.Abelian.Ext.mk₀ (π_a a₀)) (Nat.add_zero q)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap S n (w a₀)))
              (Nat.add_zero q)
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero z _ _ (Nat.add_zero q)]
      calc
        z = z.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 L_U)) (Nat.add_zero q) :=
            (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
        _ = z.comp (CategoryTheory.Abelian.Ext.mk₀ (∑ a : Fin s, ψ a)) (Nat.add_zero q) := by
            rw [hSum_id]
        _ = ∑ a : Fin s, weilEtaleLocalTorsionMapH S n (w a) q (z_a a) :=
            hExt_sum Finset.univ

  obtain ⟨hMap_id, hMap_comp, hCounit_map, hClopen_sum⟩ := hLocalTorsionPkg

  
  refine ⟨h_base, ?_⟩
  intro σ hσ ι_σ U₁_σ U₂_σ e_σ he_σ hRoof_σ z_σ

  let W_σ : AlgebraicGeometry.Scheme.{u} := (Fgt_P1.obj U₁_σ).left
  have hProp_P1 : AlgebraicGeometry.IsProper P1_over.hom := hRoof_σ.1
  have hAff_Wσ : AlgebraicGeometry.IsAffine W_σ := hRoof_σ.2.2.1
  let _ : AlgebraicGeometry.IsAffine W_σ := hAff_Wσ
  have he_σ_over :
      CategoryTheory.CategoryStruct.comp e_σ.hom
        (CategoryTheory.CategoryStruct.comp (Fgt_P1.obj U₂_σ).hom P1_over.hom) =
        CategoryTheory.CategoryStruct.comp (Fgt_P1.obj U₁_σ).hom P1_over.hom :=
    hRoof_σ.2.2.2

  let p₁_W : W_σ ⟶ W₁ := CategoryTheory.Limits.pullback.fst (Fgt_P.obj U₁).hom ι_σ
  let p₂_W : (Fgt_P1.obj U₂_σ).left ⟶ (Fgt_P.obj U₂).left :=
    CategoryTheory.Limits.pullback.fst (Fgt_P.obj U₂).hom ι_σ
  let v₁ : W_σ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    p₁_W ≫ u₁ ≫ pr_last
  let v₂ : W_σ ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    p₁_W ≫ e.hom ≫ u₂ ≫ pr_last

  have h_ισ_snd : ι_σ ≫ π_snd_P = 𝟙 P1_over.left :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hv₁_P1 : v₁ ≫ ι_P1 = (Fgt_P1.obj U₁_σ).hom := by
    calc
      (p₁_W ≫ u₁ ≫ pr_last) ≫ ι_P1
        = p₁_W ≫ u₁ ≫ (pr_last ≫ ι_P1) := by simp only [CategoryTheory.Category.assoc]
      _ = p₁_W ≫ (u₁ ≫ ι_aff (m + 1)) ≫ π_snd_P := by
            rw [← hιaff_snd, ← CategoryTheory.Category.assoc u₁]
      _ = (p₁_W ≫ (Fgt_P.obj U₁).hom) ≫ π_snd_P := by
            rw [hcomp₁, CategoryTheory.Category.assoc]
      _ = ((Fgt_P1.obj U₁_σ).hom ≫ ι_σ) ≫ π_snd_P := by
            change (CategoryTheory.Limits.pullback.fst (Fgt_P.obj U₁).hom ι_σ ≫
                (Fgt_P.obj U₁).hom) ≫ π_snd_P =
              (CategoryTheory.Limits.pullback.snd (Fgt_P.obj U₁).hom ι_σ ≫ ι_σ) ≫ π_snd_P
            rw [CategoryTheory.Limits.pullback.condition]
      _ = (Fgt_P1.obj U₁_σ).hom := by
            rw [CategoryTheory.Category.assoc, h_ισ_snd, CategoryTheory.Category.comp_id]
  have hv₂_P1 : v₂ ≫ ι_P1 = e_σ.hom ≫ (Fgt_P1.obj U₂_σ).hom := by
    have he_σ' : p₁_W ≫ e.hom = e_σ.hom ≫ p₂_W := he_σ.symm
    have hcomp₂' : u₂ ≫ ι_aff (m + 1) = (Fgt_P.obj U₂).hom := hcomp₂
    calc
      (p₁_W ≫ e.hom ≫ u₂ ≫ pr_last) ≫ ι_P1
        = (p₁_W ≫ e.hom) ≫ u₂ ≫ (pr_last ≫ ι_P1) := by simp only [CategoryTheory.Category.assoc]
      _ = (e_σ.hom ≫ p₂_W) ≫ (u₂ ≫ ι_aff (m + 1)) ≫ π_snd_P := by
            rw [he_σ', ← hιaff_snd, ← CategoryTheory.Category.assoc u₂]
      _ = e_σ.hom ≫ (p₂_W ≫ (Fgt_P.obj U₂).hom) ≫ π_snd_P := by
            rw [hcomp₂']
            simp only [CategoryTheory.Category.assoc]
      _ = e_σ.hom ≫ ((Fgt_P1.obj U₂_σ).hom ≫ ι_σ) ≫ π_snd_P := by
            congr 1
            change (CategoryTheory.Limits.pullback.fst (Fgt_P.obj U₂).hom ι_σ ≫
                (Fgt_P.obj U₂).hom) ≫ π_snd_P =
              (CategoryTheory.Limits.pullback.snd (Fgt_P.obj U₂).hom ι_σ ≫ ι_σ) ≫ π_snd_P
            rw [CategoryTheory.Limits.pullback.condition]
      _ = e_σ.hom ≫ (Fgt_P1.obj U₂_σ).hom := by
            rw [CategoryTheory.Category.assoc (Fgt_P1.obj U₂_σ).hom, h_ισ_snd,
              CategoryTheory.Category.comp_id]

  have hEt'₁ : AlgebraicGeometry.Etale (v₁ ≫ ι_P1) := by
    rw [hv₁_P1]
    exact U₁_σ.prop
  have hEt'₂ : AlgebraicGeometry.Etale (v₂ ≫ ι_P1) := by
    rw [hv₂_P1]
    have _ : AlgebraicGeometry.Etale (Fgt_P1.obj U₂_σ).hom := U₂_σ.prop
    infer_instance
  have hv₁_et : AlgebraicGeometry.Etale v₁ :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) v₁ ι_P1 hEt_ιP1 hEt'₁
  have hv₂_et : AlgebraicGeometry.Etale v₂ :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) v₂ ι_P1 hEt_ιP1 hEt'₂
  have hv_over :
      v₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) =
        v₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) := by
    rw [← hιP1_hom, ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
      hv₁_P1, hv₂_P1, CategoryTheory.Category.assoc, he_σ_over]

  let U'₁ : P1_over.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (v₁ ≫ ι_P1) hEt'₁
  let U'₂ : P1_over.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (v₂ ≫ ι_P1) hEt'₂
  let w'₁ : U'₁ ⟶ U₁_σ :=
    CategoryTheory.MorphismProperty.Over.homMk (𝟙 W_σ)
      ((CategoryTheory.Category.id_comp _).trans hv₁_P1.symm) trivial
  let w'₁_inv : U₁_σ ⟶ U'₁ :=
    CategoryTheory.MorphismProperty.Over.homMk (𝟙 W_σ)
      ((CategoryTheory.Category.id_comp _).trans hv₁_P1) trivial
  let w'₂ : U'₂ ⟶ U₂_σ :=
    CategoryTheory.MorphismProperty.Over.homMk e_σ.hom hv₂_P1.symm trivial
  have hw'₁_id : w'₁_inv ≫ w'₁ = 𝟙 U₁_σ :=
    CategoryTheory.MorphismProperty.Comma.Hom.ext
      (CategoryTheory.Category.id_comp _) (Subsingleton.elim _ _)

  let z' : weilEtaleLocalTorsionH P1_over.left (ℓ ^ r) U'₁ 2 :=
    weilEtaleLocalTorsionMapH P1_over.left (ℓ ^ r) w'₁_inv 2 z_σ
  have hz' : weilEtaleLocalTorsionMapH P1_over.left (ℓ ^ r) w'₁ 2 z' = z_σ := by
    dsimp [z']
    rw [← hMap_comp w'₁_inv w'₁ z_σ, hw'₁_id, hMap_id U₁_σ z_σ]

  have hRoof' : WeilIsAffineRoofIso k P1_over P1_over U'₁ U'₂ (CategoryTheory.Iso.refl W_σ) := by
    refine ⟨hProp_P1, hProp_P1, hAff_Wσ, ?_⟩
    calc
      𝟙 W_σ ≫ ((v₂ ≫ ι_P1) ≫ P1_over.hom)
        = v₂ ≫ (ι_P1 ≫ P1_over.hom) := by
            rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc v₂ ι_P1 P1_over.hom]
      _ = v₁ ≫ (ι_P1 ≫ P1_over.hom) := by rw [hιP1_hom, hv_over]
      _ = (v₁ ≫ ι_P1) ≫ P1_over.hom :=
            (CategoryTheory.Category.assoc v₁ ι_P1 P1_over.hom).symm

  have hΨ_outer :=
    hΨ.2.2.1 P1_over P1_over U'₁ U₁_σ U'₂ U₂_σ w'₁ w'₂ (CategoryTheory.Iso.refl W_σ) e_σ
      hRoof' hRoof_σ (by change 𝟙 W_σ ≫ e_σ.hom = 𝟙 W_σ ≫ e_σ.hom; rfl) r 2 z'
  rw [hz'] at hΨ_outer

  obtain ⟨s, C, ι, hAff_C, hInt_C, hOpen_ι, hDisj_ι, hCov_ι⟩ :=
    hClopenCurveCover W_σ v₁ hv₁_et

  let v₁_a : ∀ a : Fin s, C a ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    fun a => ι a ≫ v₁
  let v₂_a : ∀ a : Fin s, C a ⟶ AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)) :=
    fun a => ι a ≫ v₂
  have hv₁_a_et : ∀ a : Fin s, AlgebraicGeometry.Etale (v₁_a a) := by
    intro a
    have _ : AlgebraicGeometry.IsOpenImmersion (ι a) := hOpen_ι a
    have _ : AlgebraicGeometry.Etale v₁ := hv₁_et
    dsimp [v₁_a]
    infer_instance
  have hv₂_a_et : ∀ a : Fin s, AlgebraicGeometry.Etale (v₂_a a) := by
    intro a
    have _ : AlgebraicGeometry.IsOpenImmersion (ι a) := hOpen_ι a
    have _ : AlgebraicGeometry.Etale v₂ := hv₂_et
    dsimp [v₂_a]
    infer_instance
  have hEt₁_a : ∀ a : Fin s, AlgebraicGeometry.Etale (v₁_a a ≫ ι_P1) := by
    intro a
    have _ : AlgebraicGeometry.Etale (v₁_a a) := hv₁_a_et a
    infer_instance
  have hEt₂_a : ∀ a : Fin s, AlgebraicGeometry.Etale (v₂_a a ≫ ι_P1) := by
    intro a
    have _ : AlgebraicGeometry.Etale (v₂_a a) := hv₂_a_et a
    infer_instance
  have hv_over_a : ∀ a : Fin s,
      v₁_a a ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) =
        v₂_a a ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) := by
    intro a
    calc
      (ι a ≫ v₁) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))
        = ι a ≫ (v₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) :=
            CategoryTheory.Category.assoc (ι a) v₁ _
      _ = ι a ≫ (v₂ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) := by
            rw [hv_over]
      _ = (ι a ≫ v₂) ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)) :=
            (CategoryTheory.Category.assoc (ι a) v₂ _).symm

  let U₁_a : Fin s → P1_over.left.Etale :=
    fun a => CategoryTheory.MorphismProperty.Over.mk ⊤ (v₁_a a ≫ ι_P1) (hEt₁_a a)
  let U₂_a : Fin s → P1_over.left.Etale :=
    fun a => CategoryTheory.MorphismProperty.Over.mk ⊤ (v₂_a a ≫ ι_P1) (hEt₂_a a)
  let w₁_a : ∀ a : Fin s, U₁_a a ⟶ U'₁ :=
    fun a => CategoryTheory.MorphismProperty.Over.homMk (ι a)
      (CategoryTheory.Category.assoc (ι a) v₁ ι_P1).symm trivial
  let w₂_a : ∀ a : Fin s, U₂_a a ⟶ U'₂ :=
    fun a => CategoryTheory.MorphismProperty.Over.homMk (ι a)
      (CategoryTheory.Category.assoc (ι a) v₂ ι_P1).symm trivial

  obtain ⟨z_a, hz'_sum⟩ := hClopen_sum U'₁ s U₁_a w₁_a hOpen_ι hDisj_ι hCov_ι z'

  calc
    weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U₁_σ 2 z_σ
      = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U₁_σ 2
          (weilEtaleLocalTorsionMapH P1_over.left (ℓ ^ r) w'₁ 2 z') := by rw [hz']
    _ = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U'₁ 2 z' := hCounit_map w'₁ z'
    _ = ∑ a : Fin s, weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U'₁ 2
          (weilEtaleLocalTorsionMapH P1_over.left (ℓ ^ r) (w₁_a a) 2 (z_a a)) := by
          rw [hz'_sum, map_sum]
    _ = ∑ a : Fin s, weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U'₂ 2
          (Ψ P1_over P1_over U'₁ U'₂ (CategoryTheory.Iso.refl W_σ) hRoof' r 2
            (weilEtaleLocalTorsionMapH P1_over.left (ℓ ^ r) (w₁_a a) 2 (z_a a))) := by
          apply Finset.sum_congr rfl
          intro a _
          have hRoof_a :
              WeilIsAffineRoofIso k P1_over P1_over (U₁_a a) (U₂_a a)
                (CategoryTheory.Iso.refl (C a)) := by
            refine ⟨hProp_P1, hProp_P1, hAff_C a, ?_⟩
            calc
              𝟙 (C a) ≫ ((v₂_a a ≫ ι_P1) ≫ P1_over.hom)
                = v₂_a a ≫ (ι_P1 ≫ P1_over.hom) := by
                    rw [CategoryTheory.Category.id_comp,
                      CategoryTheory.Category.assoc (v₂_a a) ι_P1 P1_over.hom]
              _ = v₁_a a ≫ (ι_P1 ≫ P1_over.hom) := by rw [hιP1_hom, hv_over_a a]
              _ = (v₁_a a ≫ ι_P1) ≫ P1_over.hom :=
                    (CategoryTheory.Category.assoc (v₁_a a) ι_P1 P1_over.hom).symm
          have hΨ_a :=
            hΨ.2.2.1 P1_over P1_over (U₁_a a) U'₁ (U₂_a a) U'₂ (w₁_a a) (w₂_a a)
              (CategoryTheory.Iso.refl (C a)) (CategoryTheory.Iso.refl W_σ)
              hRoof_a hRoof'
              (by
                change 𝟙 (C a) ≫ ι a = ι a ≫ 𝟙 W_σ
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
              r 2 (z_a a)
          rw [hCounit_map (w₁_a a) (z_a a), hΨ_a, hCounit_map (w₂_a a) _]
          exact @hCurve1D (C a) (hAff_C a) (hInt_C a) (v₁_a a) (v₂_a a)
            (hv₁_a_et a) (hv₂_a_et a) (hv_over_a a) (hEt₁_a a) (hEt₂_a a) hRoof_a (z_a a)
    _ = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U'₂ 2
          (Ψ P1_over P1_over U'₁ U'₂ (CategoryTheory.Iso.refl W_σ) hRoof' r 2 z') := by
          rw [← map_sum, ← map_sum, ← hz'_sum]
    _ = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U₂_σ 2
          (weilEtaleLocalTorsionMapH P1_over.left (ℓ ^ r) w'₂ 2
            (Ψ P1_over P1_over U'₁ U'₂ (CategoryTheory.Iso.refl W_σ) hRoof' r 2 z')) :=
          (hCounit_map w'₂ _).symm
    _ = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ r) U₂_σ 2
          (Ψ P1_over P1_over U₁_σ U₂_σ e_σ hRoof_σ r 2 z_σ) := by rw [← hΨ_outer]

theorem weil_polyP1_rel_fst_localTorsion_deg_ge_three_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (r m : ℕ)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCD_Pd1 : ∀ (F : CategoryTheory.Sheaf (weilPolyP1Over k 1).left.smallEtaleTopology
        AddCommGrpCat.{u}) (b : ℕ),
      (ℓ ^ 1) • CategoryTheory.CategoryStruct.id F = 0 →
      2 * 1 < b →
      Subsingleton (F.H b))
    (hProp_Pm : AlgebraicGeometry.IsProper (weilPolyP1Over k m).hom)
    (hProp_P1 : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom)
    (U_P : (weilPolyP1Over k (m + 1)).left.Etale)
    (b : ℕ) (hb : 3 ≤ b) :
    CategoryTheory.Limits.IsZero
      (weilEtaleHigherDirectImage
        (CategoryTheory.Limits.pullback.fst (weilPolyP1Over k m).hom
          (weilProjectiveSpaceOver k 1).hom)
        b
        (weilEtaleLocalTorsionSheaf (weilPolyP1Over k (m + 1)).left (ℓ ^ r) U_P)) :=
by
  classical
  
  have hPart1 : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Y₁ ⟶ Y₂),
      CategoryTheory.Limits.PreservesFiniteLimits (weilEtaleSitePullback h) ∧
      CategoryTheory.CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        (weilEtaleSitePullback h) ∧
      ∃ (hc : (weilEtaleSitePullback h).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology),
        let pf_h := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology hc
        ∃ (hr : pf_h.IsRightAdjoint),
          (@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback h) AddCommGrpCat.{u} _
            Y₂.smallEtaleTopology Y₁.smallEtaleTopology hc hr).Additive := by
    intro Y₁ Y₂ h
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    haveI : P_et.IsMultiplicative := inferInstance
    haveI : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    haveI : P_et.IsStableUnderBaseChange := inferInstance
    haveI : P_et.HasOfPostcompProperty P_et := inferInstance
    haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong P_et h :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    haveI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits (weilEtaleSitePullback h) := by
      change CategoryTheory.Limits.PreservesFiniteLimits
        (CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ h)
      infer_instance
    let B_h : Y₂.Etale ⥤ Y₁.Etale := weilEtaleSitePullback h
    haveI : CategoryTheory.Limits.PreservesFiniteLimits B_h := hLim
    haveI : CategoryTheory.RepresentablyFlat B_h :=
      CategoryTheory.flat_of_preservesFiniteLimits B_h
    have hCov : CategoryTheory.CoverPreserving Y₂.smallEtaleTopology Y₁.smallEtaleTopology B_h := by
      refine CategoryTheory.CoverPreserving.mk ?_
      intro U S hS
      have hTop₂ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Y₂ le_rfl
      have hTop₁ := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) Y₁ le_rfl
      have hS' : S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U :=
        Eq.mp (congrArg (fun J : CategoryTheory.GrothendieckTopology Y₂.Etale => S ∈ J U) hTop₂) hS
      have hS'' := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U S).mp hS'
      suffices hPush : CategoryTheory.Sieve.functorPushforward B_h S ∈
          (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck (B_h.obj U) by
        exact Eq.mpr (congrArg (fun J : CategoryTheory.GrothendieckTopology Y₁.Etale =>
          CategoryTheory.Sieve.functorPushforward B_h S ∈ J (B_h.obj U)) hTop₁) hPush
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (B_h.obj U) _).mpr ?_
      intro x
      obtain ⟨V, g, v, hgS, _, hv⟩ := hS'' ((CategoryTheory.Limits.pullback.fst U.hom h).base x)
      obtain ⟨z₀, _, hz₀_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := g.left) (g := CategoryTheory.Limits.pullback.fst U.hom h) v x hv
      let p₁_aux := CategoryTheory.Limits.pullback.fst g.left
        (CategoryTheory.Limits.pullback.fst U.hom h)
      let s₀_aux := CategoryTheory.Limits.pullback.snd g.left
        (CategoryTheory.Limits.pullback.fst U.hom h)
      let p₂_aux := s₀_aux ≫ CategoryTheory.Limits.pullback.snd U.hom h
      have hcomm_aux : p₁_aux ≫ V.hom = p₂_aux ≫ h := by
        dsimp only [p₁_aux, p₂_aux, s₀_aux]
        rw [← CategoryTheory.MorphismProperty.Over.w g, ← CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.condition, ← CategoryTheory.Category.assoc]
      let q_aux : CategoryTheory.Limits.pullback g.left
          (CategoryTheory.Limits.pullback.fst U.hom h) ⟶ (B_h.obj V).left :=
        CategoryTheory.Limits.pullback.lift p₁_aux p₂_aux hcomm_aux
      have hq_comp : q_aux ≫ (B_h.map g).left = s₀_aux :=
        CategoryTheory.Limits.pullback.hom_ext
          ((CategoryTheory.Category.assoc q_aux (B_h.map g).left _).trans
            ((congrArg (q_aux ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              ((CategoryTheory.Category.assoc q_aux _ g.left).symm.trans
                ((congrArg (· ≫ g.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  CategoryTheory.Limits.pullback.condition))))
          ((CategoryTheory.Category.assoc q_aux (B_h.map g).left _).trans
            ((congrArg (q_aux ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)))
      refine ⟨B_h.obj V, B_h.map g, q_aux.base z₀,
        ⟨V, g, 𝟙 (B_h.obj V), hgS, (CategoryTheory.Category.id_comp (B_h.map g)).symm⟩, ?_, ?_⟩
      · exact CategoryTheory.MorphismProperty.of_postcomp (W := P_et) (W' := P_et)
          (B_h.map g).left (B_h.obj U).hom (B_h.obj U).prop
          (by rw [CategoryTheory.MorphismProperty.Over.w (B_h.map g)]; exact (B_h.obj V).prop)
      · exact (congrArg (fun φ : CategoryTheory.Limits.pullback g.left
            (CategoryTheory.Limits.pullback.fst U.hom h) ⟶ (B_h.obj U).left => φ.base z₀)
          hq_comp).trans hz₀_snd
    have hc : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology :=
      CategoryTheory.Functor.isContinuous_of_coverPreserving
        (CategoryTheory.compatiblePreservingOfFlat Y₁.smallEtaleTopology B_h) hCov
    haveI : B_h.IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology := hc
    let G₂ : CategoryTheory.SmallModel.{u} Y₂.AffineEtale ⥤ Y₂.Etale :=
      (CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale).inverse ⋙
        AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂
    haveI : G₂.Full :=
      CategoryTheory.Functor.Full.comp
        (CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale).inverse
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂)
    haveI : G₂.Faithful :=
      CategoryTheory.Functor.Faithful.comp
        (CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale).inverse
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂)
    have hCD_G₂ : G₂.IsCoverDense Y₂.smallEtaleTopology := by
      refine ⟨fun U => ?_⟩
      refine Y₂.smallEtaleTopology.superset_covering ?_
        (CategoryTheory.Functor.is_cover_of_isCoverDense
          (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂) Y₂.smallEtaleTopology U)
      intro V f hf
      rcases hf with ⟨⟨A₀, g₁, g₂, hfac⟩⟩
      let m₀ := (CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale).functor.obj A₀
      let iso₀ := (CategoryTheory.equivSmallModel.{u} Y₂.AffineEtale).unitIso.app A₀
      refine ⟨⟨m₀, g₁ ≫ (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).map iso₀.hom,
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).map iso₀.inv ≫ g₂, ?_⟩⟩
      rw [CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc ((AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).map iso₀.hom),
        ← (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).map_comp, iso₀.hom_inv_id,
        (AlgebraicGeometry.Scheme.AffineEtale.Spec Y₂).map_id,
        CategoryTheory.Category.id_comp, hfac]
    haveI : G₂.IsCoverDense Y₂.smallEtaleTopology := hCD_G₂
    haveI : G₂.LocallyCoverDense Y₂.smallEtaleTopology :=
      CategoryTheory.Functor.locallyCoverDense_of_isCoverDense G₂ Y₂.smallEtaleTopology
    let eqv₂ := G₂.sheafInducedTopologyEquivOfIsCoverDense Y₂.smallEtaleTopology AddCommGrpCat.{u}
