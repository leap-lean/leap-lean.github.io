        have hf_app : f.appLE V_chart U_chart (le_refl U_chart) = f.app V_chart := by
          have hhom_id : CategoryTheory.homOfLE (le_refl U_chart) = 𝟙 U_chart :=
            Subsingleton.elim _ _
          rw [AlgebraicGeometry.Scheme.Hom.appLE, hhom_id, op_id,
            CategoryTheory.Functor.map_id]
          exact CategoryTheory.Category.comp_id _
        rw [hf_app] at hSpec_comm
        have hpt := congrArg (fun g => g.base p_P) hSpec_comm
        change hAff_V.fromSpec.base ((AlgebraicGeometry.Spec.map (f.app V_chart)).base p_P) =
