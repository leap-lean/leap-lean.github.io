  let e_leg_σ : CategoryTheory.Iso (Fgt_Wσ.obj U_W_σ).left (Fgt_P1.obj U_P_σ).left :=
    { hom := φ_iso, inv := ψ_iso, hom_inv_id := hφψ, inv_hom_id := hψφ }
  have : CategoryTheory.IsIso e_leg_σ.inv := CategoryTheory.Iso.isIso_inv e_leg_σ
  have hAff_UPσ : AlgebraicGeometry.IsAffine (Fgt_P1.obj U_P_σ).left :=
    AlgebraicGeometry.IsAffine.of_isIso e_leg_σ.inv
  have hU_σ_comm : CategoryTheory.CategoryStruct.comp (Fgt_Wσ.obj U_W_σ).hom π_leg_σ =
      CategoryTheory.CategoryStruct.comp e_leg_σ.hom (Fgt_P1.obj U_P_σ).hom :=
    (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm
