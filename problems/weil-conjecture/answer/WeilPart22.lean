            ((CategoryTheory.Category.assoc p_eta _ _).symm).trans
              ((congrArg (· ≫ CategoryTheory.Limits.pullback.fst Z.hom g) hBf'_eta).trans
                ((CategoryTheory.Category.assoc _ η_W.left _).trans
