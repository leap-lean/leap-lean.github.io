            CategoryTheory.Abelian.extFunctorObj_map,
            CategoryTheory.Abelian.extFunctorObj_map]
          change x'.comp (CategoryTheory.Abelian.Ext.mk₀ (u₁ + u₂)) (Nat.add_zero b) =
            x'.comp (CategoryTheory.Abelian.Ext.mk₀ u₁) (Nat.add_zero b) +
