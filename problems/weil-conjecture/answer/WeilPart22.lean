  let p_W : Quiver.Hom (Fgt_Wσ.obj U_W_σ).left (Fgt_W.obj U_W).left :=
    CategoryTheory.Limits.pullback.fst (Fgt_W.obj U_W).hom g'_W
  let q_W : Quiver.Hom (Fgt_Wσ.obj U_W_σ).left W_bar_σ.left :=
    (Fgt_Wσ.obj U_W_σ).hom
  have hPb_top : CategoryTheory.IsPullback p_W q_W (Fgt_W.obj U_W).hom g'_W :=
    CategoryTheory.IsPullback.of_hasPullback (Fgt_W.obj U_W).hom g'_W
  have hPb_bot : CategoryTheory.IsPullback g'_W W_bar_σ.hom π_W σ :=
    CategoryTheory.IsPullback.of_hasPullback π_W σ
  have hPb_paste : CategoryTheory.IsPullback p_W (q_W ≫ W_bar_σ.hom)
      ((Fgt_W.obj U_W).hom ≫ π_W) σ :=
    hPb_top.paste_vert hPb_bot
  have hAff_σ : AlgebraicGeometry.IsAffineHom σ := by
    have : AlgebraicGeometry.IsAffineHom (σ ≫ P_m.hom) := by
      rw [hσ]; infer_instance
    exact AlgebraicGeometry.IsAffineHom.of_comp σ P_m.hom
  have hAff_pW : AlgebraicGeometry.IsAffineHom p_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_paste.flip hAff_σ
  have hAff_UWσ : AlgebraicGeometry.IsAffine (Fgt_Wσ.obj U_W_σ).left :=
    AlgebraicGeometry.isAffine_of_isAffineHom p_W
  let p_P : Quiver.Hom (Fgt_P1.obj U_P_σ).left (Fgt_P.obj U_P).left :=
    CategoryTheory.Limits.pullback.fst (Fgt_P.obj U_P).hom ι_σ
  let q_P : Quiver.Hom (Fgt_P1.obj U_P_σ).left P1_over.left :=
    (Fgt_P1.obj U_P_σ).hom
  have hφ_comm : (p_W ≫ e_leg.hom) ≫ (Fgt_P.obj U_P).hom = (q_W ≫ π_leg_σ) ≫ ι_σ :=
    (CategoryTheory.Category.assoc p_W e_leg.hom (Fgt_P.obj U_P).hom).trans
