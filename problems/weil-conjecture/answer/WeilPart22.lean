        rw [h2, h_ι, h3]
        exact (ConcreteCategory.congr_hom
          ((L_g'.map (repMap_X w_X)).hom.naturality (Opposite.op (e_F.inv.app W₁)))
          (((adj_L'.unit.app R₁).hom.app (Opposite.op (B_f.obj W₁))) ι₁)).symm
      refine ⟨fun b F =>
        { app := fun opW =>
            AddCommGrpCat.ofHom
              (((CategoryTheory.Abelian.Ext.mk₀ (ρ_gen opW.unop)).precomp
                  (L_g'.obj F) (Nat.zero_add b)).comp
                (L_g'.mapExtAddHom (repSh_X (B_f.obj opW.unop)) F b))
          naturality := fun {opW₂ opW₁} μ => by
            apply AddCommGrpCat.ext
            intro (s : CategoryTheory.Abelian.Ext.{u} (repSh_X (B_f.obj opW₂.unop)) F b)
            have h_map1 : (B_f.op.map μ).unop = B_f.map μ.unop := rfl
            have h_map2 : (B_f'.op.map (B_g.op.map μ)).unop = B_f'.map (B_g.map μ.unop) := rfl
            change (CategoryTheory.Abelian.Ext.mk₀ (ρ_gen opW₁.unop)).comp
                (CategoryTheory.Abelian.Ext.mapExactFunctor L_g'
                  ((F.cohomologyPresheaf b).map (B_f.op.map μ) s))
                (Nat.zero_add b) =
              ((L_g'.obj F).cohomologyPresheaf b).map (B_f'.op.map (B_g.op.map μ))
                ((CategoryTheory.Abelian.Ext.mk₀ (ρ_gen opW₂.unop)).comp
                  (CategoryTheory.Abelian.Ext.mapExactFunctor L_g' s) (Nat.zero_add b))
            rw [hRep_cohom_X F b (B_f.op.map μ) s,
              hRep_cohom_X' (L_g'.obj F) b (B_f'.op.map (B_g.op.map μ)) _,
              h_map1, h_map2,
              CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
              CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
              ← CategoryTheory.Abelian.Ext.comp_assoc
                (CategoryTheory.Abelian.Ext.mk₀ (ρ_gen opW₁.unop))
                (CategoryTheory.Abelian.Ext.mk₀ (L_g'.map (repMap_X (B_f.map μ.unop))))
                (CategoryTheory.Abelian.Ext.mapExactFunctor L_g' s)
                (Nat.zero_add 0) (Nat.zero_add b) (Nat.zero_add b),
              CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              ← hρ_nat μ.unop,
              ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
              CategoryTheory.Abelian.Ext.comp_assoc
                (CategoryTheory.Abelian.Ext.mk₀ (repMap_X' (B_f'.map (B_g.map μ.unop))))
                (CategoryTheory.Abelian.Ext.mk₀ (ρ_gen opW₂.unop))
                (CategoryTheory.Abelian.Ext.mapExactFunctor L_g' s)
                (Nat.zero_add 0) (Nat.zero_add b) (Nat.zero_add b)] },
        fun _ _ _ _ => rfl⟩

    obtain ⟨θ_of, hθ_app⟩ := h_θ_pkg

    let Sh_S := CategoryTheory.presheafToSheaf J_S AddCommGrpCat.{u}
    let Sh_S' := CategoryTheory.presheafToSheaf J_S' AddCommGrpCat.{u}
    let pf_g := B_g.sheafPushforwardContinuous AddCommGrpCat.{u} J_S J_S'
    let adj_sh_S := CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}
    let adj_sh_S' := CategoryTheory.sheafificationAdjunction J_S' AddCommGrpCat.{u}

    have h_mate_pkg :
        ∃ (liftMate : ∀ {P_pre : C_Sᵒᵖ ⥤ AddCommGrpCat.{u}}
            {Q_pre : C_S'ᵒᵖ ⥤ AddCommGrpCat.{u}}
            (_α : P_pre ⟶ CategoryTheory.Functor.comp B_g.op Q_pre),
            L_g.obj (Sh_S.obj P_pre) ⟶ Sh_S'.obj Q_pre),
          (∀ {P₁ P₂ : C_Sᵒᵖ ⥤ AddCommGrpCat.{u}}
              {Q₁ Q₂ : C_S'ᵒᵖ ⥤ AddCommGrpCat.{u}}
              (α₁ : P₁ ⟶ CategoryTheory.Functor.comp B_g.op Q₁)
              (α₂ : P₂ ⟶ CategoryTheory.Functor.comp B_g.op Q₂)
              (u : P₁ ⟶ P₂) (v : Q₁ ⟶ Q₂),
            u ≫ α₂ = α₁ ≫ CategoryTheory.Functor.whiskerLeft B_g.op v →
            L_g.map (Sh_S.map u) ≫ liftMate α₂ = liftMate α₁ ≫ Sh_S'.map v) ∧
          (∀ {P₀ : C_Sᵒᵖ ⥤ AddCommGrpCat.{u}}
              {Q₀ : C_S'ᵒᵖ ⥤ AddCommGrpCat.{u}}
              {H : CategoryTheory.Sheaf J_S AddCommGrpCat.{u}}
              {H' : CategoryTheory.Sheaf J_S' AddCommGrpCat.{u}}
              (α : P₀ ⟶ CategoryTheory.Functor.comp B_g.op Q₀)
              (ζ₁ : Sh_S.obj P₀ ⟶ H)
              (ζ₂ : Sh_S'.obj Q₀ ⟶ H')
              (β : H ⟶ pf_g.obj H'),
            α ≫ CategoryTheory.Functor.whiskerLeft B_g.op ((adj_sh_S'.homEquiv Q₀ H') ζ₂) =
              (adj_sh_S.homEquiv P₀ H) ζ₁ ≫
                (CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}).map β →
            liftMate α ≫ ζ₂ = L_g.map ζ₁ ≫ (adj_L.homEquiv H H').symm β) := by
      let liftMate : ∀ {P_pre : C_Sᵒᵖ ⥤ AddCommGrpCat.{u}}
          {Q_pre : C_S'ᵒᵖ ⥤ AddCommGrpCat.{u}}
          (_α : P_pre ⟶ CategoryTheory.Functor.comp B_g.op Q_pre),
          L_g.obj (Sh_S.obj P_pre) ⟶ Sh_S'.obj Q_pre :=
        fun {P_pre Q_pre} α =>
          (adj_L.homEquiv (Sh_S.obj P_pre) (Sh_S'.obj Q_pre)).symm
            ((adj_sh_S.homEquiv P_pre (pf_g.obj (Sh_S'.obj Q_pre))).symm
              (α ≫ CategoryTheory.Functor.whiskerLeft B_g.op (adj_sh_S'.unit.app Q_pre)))
      refine ⟨liftMate, ?_, ?_⟩
      · intro P₁ P₂ Q₁ Q₂ α₁ α₂ u v hcomm
        apply (adj_L.homEquiv (Sh_S.obj P₁) (Sh_S'.obj Q₂)).injective
        apply (adj_sh_S.homEquiv P₁ (pf_g.obj (Sh_S'.obj Q₂))).injective
        rw [adj_L.homEquiv_naturality_left, adj_L.homEquiv_naturality_right]
        dsimp only [liftMate]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply,
          adj_sh_S.homEquiv_naturality_left, adj_sh_S.homEquiv_naturality_right,
          Equiv.apply_symm_apply, Equiv.apply_symm_apply]
        have h_unit_v :
            adj_sh_S'.unit.app Q₁ ≫
              (CategoryTheory.sheafToPresheaf J_S' AddCommGrpCat.{u}).map (Sh_S'.map v) =
            v ≫ adj_sh_S'.unit.app Q₂ :=
          (adj_sh_S'.unit.naturality v).symm
        change u ≫ (α₂ ≫ CategoryTheory.Functor.whiskerLeft B_g.op (adj_sh_S'.unit.app Q₂)) =
          (α₁ ≫ CategoryTheory.Functor.whiskerLeft B_g.op (adj_sh_S'.unit.app Q₁)) ≫
            CategoryTheory.Functor.whiskerLeft B_g.op
              ((CategoryTheory.sheafToPresheaf J_S' AddCommGrpCat.{u}).map (Sh_S'.map v))
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.whiskerLeft_comp,
          h_unit_v, CategoryTheory.Functor.whiskerLeft_comp,
          ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc, hcomm]
      · intro P₀ Q₀ H H' α ζ₁ ζ₂ β h_pre
        apply (adj_L.homEquiv (Sh_S.obj P₀) H').injective
        apply (adj_sh_S.homEquiv P₀ (pf_g.obj H')).injective
        rw [adj_L.homEquiv_naturality_right, adj_L.homEquiv_naturality_left]
        dsimp only [liftMate]
        rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply,
          adj_sh_S.homEquiv_naturality_right, Equiv.apply_symm_apply,
          adj_sh_S.homEquiv_naturality_right]
        have h_lhs_unit :
            adj_sh_S'.unit.app Q₀ ≫
              (CategoryTheory.sheafToPresheaf J_S' AddCommGrpCat.{u}).map ζ₂ =
            (adj_sh_S'.homEquiv Q₀ H') ζ₂ :=
          (adj_sh_S'.homEquiv_unit Q₀ H' ζ₂).symm
        change (α ≫ CategoryTheory.Functor.whiskerLeft B_g.op (adj_sh_S'.unit.app Q₀)) ≫
            CategoryTheory.Functor.whiskerLeft B_g.op
              ((CategoryTheory.sheafToPresheaf J_S' AddCommGrpCat.{u}).map ζ₂) =
          (adj_sh_S.homEquiv P₀ H) ζ₁ ≫
            (CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}).map β
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Functor.whiskerLeft_comp,
          h_lhs_unit, h_pre]

    obtain ⟨liftMate, h_liftMate_nat, h_liftMate_deg0⟩ := h_mate_pkg

    let bc : ∀ (b : ℕ) (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
        L_g.obj (R_f b F) ⟶ R_f' b (L_g'.obj F) :=
      fun b F => liftMate (θ_of b F)

    have hbc_nat :
        ∀ (b : ℕ) {F₁ F₂ : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}} (φ : F₁ ⟶ F₂),
          L_g.map (R_f_map b φ) ≫ bc b F₂ = bc b F₁ ≫ R_f'_map b (L_g'.map φ) := by
      intro b F₁ F₂ φ
      refine h_liftMate_nat (θ_of b F₁) (θ_of b F₂)
        (CategoryTheory.Functor.whiskerLeft B_f.op
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X b).map φ))
        (CategoryTheory.Functor.whiskerLeft B_f'.op
          ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X' b).map (L_g'.map φ))) ?_
      ext ⟨W⟩ : 2
      apply AddCommGrpCat.ext
      intro (s : CategoryTheory.Abelian.Ext.{u} (repSh_X (B_f.obj W)) F₁ b)
      have hu_s :
          ((CategoryTheory.Functor.whiskerLeft B_f.op
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X b).map φ)).app
            (Opposite.op W)) s =
          s.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero b) := rfl
      have hv_s :
          ((CategoryTheory.Functor.whiskerLeft B_g.op
            (CategoryTheory.Functor.whiskerLeft B_f'.op
              ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X' b).map (L_g'.map φ)))).app
            (Opposite.op W))
            (((θ_of b F₁).app (Opposite.op W)) s) =
          (((θ_of b F₁).app (Opposite.op W)) s).comp
            (CategoryTheory.Abelian.Ext.mk₀ (L_g'.map φ)) (Nat.add_zero b) := rfl
      change ((θ_of b F₂).app (Opposite.op W))
          (((CategoryTheory.Functor.whiskerLeft B_f.op
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X b).map φ)).app
            (Opposite.op W)) s) =
        ((CategoryTheory.Functor.whiskerLeft B_g.op
          (CategoryTheory.Functor.whiskerLeft B_f'.op
            ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X' b).map (L_g'.map φ)))).app
          (Opposite.op W))
          (((θ_of b F₁).app (Opposite.op W)) s)
      rw [hu_s, hv_s, hθ_app b F₂ W _, hθ_app b F₁ W s,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (ρ_gen W))
          (CategoryTheory.Abelian.Ext.mapExactFunctor L_g' s)
          (CategoryTheory.Abelian.Ext.mk₀ (L_g'.map φ))
          (Nat.zero_add b) (Nat.add_zero b) (by omega)]

    have hbc_zero_iso :
        ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
          P_sh F → CategoryTheory.IsIso (bc 0 F) := by
      intro F hPF
      obtain ⟨ζ_f, hζ_f_iso, hζ_f_app⟩ := (h_single_mor J_X J_S B_f).1 F
      obtain ⟨ζ_f', hζ_f'_iso, hζ_f'_app⟩ := (h_single_mor J_X' J_S' B_f').1 (L_g'.obj F)
      let bc₀_F := (adj_L.homEquiv (pf_f0.obj F) (pf_f'0.obj (L_g'.obj F))).symm
        (pf_f0.map (adj_L'.unit.app F) ≫ e_pf_F.hom.app (L_g'.obj F))
      have h_comm : bc 0 F ≫ ζ_f' = L_g.map ζ_f ≫ bc₀_F := by
        refine @h_liftMate_deg0
          (CategoryTheory.Functor.comp B_f.op (F.cohomologyPresheaf 0))
          (CategoryTheory.Functor.comp B_f'.op ((L_g'.obj F).cohomologyPresheaf 0))
          (pf_f0.obj F) (pf_f'0.obj (L_g'.obj F))
          (θ_of 0 F) ζ_f ζ_f'
          (pf_f0.map (adj_L'.unit.app F) ≫ e_pf_F.hom.app (L_g'.obj F)) ?_
        ext ⟨W⟩ : 2
        apply AddCommGrpCat.ext
        intro (s : CategoryTheory.Abelian.Ext.{u} (repSh_X (B_f.obj W)) F 0)
        let γ := CategoryTheory.Abelian.Ext.addEquiv₀ s
        have hs : s = CategoryTheory.Abelian.Ext.mk₀ γ := by
          rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
          exact (CategoryTheory.Abelian.Ext.addEquiv₀.symm_apply_apply s).symm
        let R_W := repSh_X (B_f.obj W)
        let ι_W := repEqv_X (B_f.obj W) R_W (CategoryTheory.CategoryStruct.id R_W)
        have h_mid :
            repEqv_X' (B_f'.obj (B_g.obj W)) (L_g'.obj F)
              (CategoryTheory.Abelian.Ext.addEquiv₀ (((θ_of 0 F).app (Opposite.op W)) s)) =
            ((L_g'.obj F).obj.map (Opposite.op (e_F.inv.app W)))
              (((adj_L'.unit.app F).hom.app (Opposite.op (B_f.obj W)))
                (repEqv_X (B_f.obj W) F γ)) := by
          rw [hθ_app 0 F W s, hs, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
            CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
            AddEquiv.apply_symm_apply,
            hRep_right_X' (B_f'.obj (B_g.obj W)) (ρ_gen W) (L_g'.map γ),
            hρ_spec W]
          have h_nat1 :
              ((L_g'.map γ).hom.app (Opposite.op (B_f'.obj (B_g.obj W))))
                (((L_g'.obj R_W).obj.map (Opposite.op (e_F.inv.app W)))
                  (((adj_L'.unit.app R_W).hom.app (Opposite.op (B_f.obj W))) ι_W)) =
              ((L_g'.obj F).obj.map (Opposite.op (e_F.inv.app W)))
                (((L_g'.map γ).hom.app (Opposite.op (B_g'.obj (B_f.obj W))))
                  (((adj_L'.unit.app R_W).hom.app (Opposite.op (B_f.obj W))) ι_W)) :=
            ConcreteCategory.congr_hom
              ((L_g'.map γ).hom.naturality (Opposite.op (e_F.inv.app W)))
              (((adj_L'.unit.app R_W).hom.app (Opposite.op (B_f.obj W))) ι_W)
          have h_nat2 :
              ((L_g'.map γ).hom.app (Opposite.op (B_g'.obj (B_f.obj W))))
                (((adj_L'.unit.app R_W).hom.app (Opposite.op (B_f.obj W))) ι_W) =
              ((adj_L'.unit.app F).hom.app (Opposite.op (B_f.obj W)))
                ((γ.hom.app (Opposite.op (B_f.obj W))) ι_W) := by
            have hnat_γ :
                ((γ ≫ adj_L'.unit.app F).hom.app (Opposite.op (B_f.obj W)) :
                  R_W.obj.obj (Opposite.op (B_f.obj W)) ⟶
                    (L_g'.obj F).obj.obj (Opposite.op (B_g'.obj (B_f.obj W)))) =
                (adj_L'.unit.app R_W ≫
                  (B_g'.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_X').map
                    (L_g'.map γ)).hom.app (Opposite.op (B_f.obj W)) :=
              congrArg
                (fun (φ : R_W ⟶ (B_g'.sheafPushforwardContinuous AddCommGrpCat.{u} J_X J_X').obj
                    (L_g'.obj F)) =>
                  φ.hom.app (Opposite.op (B_f.obj W)))
                (adj_L'.unit.naturality γ)
            exact ConcreteCategory.congr_hom hnat_γ.symm ι_W
          rw [h_nat1, h_nat2, ← hRep_eval_X (B_f.obj W) F γ]
        exact (hζ_f'_app (B_g.obj W) (((θ_of 0 F).app (Opposite.op W)) s)).trans
          (h_mid.trans
            (congrArg ((L_g'.obj F).obj.map (Opposite.op (e_F.inv.app W)))
              (congrArg ((adj_L'.unit.app F).hom.app (Opposite.op (B_f.obj W)))
                (hζ_f_app W s).symm)))
      have := hζ_f_iso
      have := hζ_f'_iso
      have : CategoryTheory.IsIso bc₀_F := hBC0_L F hPF
      have h_eq : bc 0 F =
          (L_g.mapIso (@CategoryTheory.asIso _ _ _ _ ζ_f hζ_f_iso) ≪≫
            (@CategoryTheory.asIso _ _ _ _ bc₀_F (hBC0_L F hPF) ≪≫
              (@CategoryTheory.asIso _ _ _ _ ζ_f' hζ_f'_iso).symm)).hom := by
        change bc 0 F = L_g.map ζ_f ≫ bc₀_F ≫ CategoryTheory.inv ζ_f'
        rw [← CategoryTheory.Category.assoc, ← h_comm, CategoryTheory.Category.assoc,
          CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]
      rw [h_eq]
      exact CategoryTheory.Iso.isIso_hom _

    let δ_f : ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})},
        SC.ShortExact → ∀ (b : ℕ), R_f b SC.X₃ ⟶ R_f (b + 1) SC.X₁ :=
      fun hSE b => Sh_S.map (CategoryTheory.Functor.whiskerLeft B_f.op
        (Classical.choose ((h_single_mor J_X J_S B_f).2 hSE b)))

    let δ_f' : ∀ {SC' : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X' AddCommGrpCat.{u})},
        SC'.ShortExact → ∀ (b : ℕ), R_f' b SC'.X₃ ⟶ R_f' (b + 1) SC'.X₁ :=
      fun hSE' b => Sh_S'.map (CategoryTheory.Functor.whiskerLeft B_f'.op
        (Classical.choose ((h_single_mor J_X' J_S' B_f').2 hSE' b)))

    have hbc_δ :
        ∀ {SC : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})}
          (hSE : SC.ShortExact) (b : ℕ),
          L_g.map (δ_f hSE b) ≫ bc (b + 1) SC.X₁ =
            bc b SC.X₃ ≫ δ_f' (hSE.map_of_exact L_g') b := by
      intro SC hSE b
      let δ_pre := Classical.choose ((h_single_mor J_X J_S B_f).2 hSE b)
      have hδ_app := (Classical.choose_spec ((h_single_mor J_X J_S B_f).2 hSE b)).1
      let δ'_pre := Classical.choose ((h_single_mor J_X' J_S' B_f').2 (hSE.map_of_exact L_g') b)
      have hδ'_app := (Classical.choose_spec
        ((h_single_mor J_X' J_S' B_f').2 (hSE.map_of_exact L_g') b)).1
      refine h_liftMate_nat (θ_of b SC.X₃) (θ_of (b + 1) SC.X₁)
        (CategoryTheory.Functor.whiskerLeft B_f.op δ_pre)
        (CategoryTheory.Functor.whiskerLeft B_f'.op δ'_pre) ?_
      ext ⟨W⟩ : 2
      apply AddCommGrpCat.ext
      intro (s : CategoryTheory.Abelian.Ext.{u} (repSh_X (B_f.obj W)) SC.X₃ b)
      have h1_s :
          ((CategoryTheory.Functor.whiskerLeft B_f.op δ_pre).app (Opposite.op W)) s =
            s.comp hSE.extClass rfl :=
        ConcreteCategory.congr_hom (hδ_app (B_f.obj W)) s
      have h2_s :
          ((CategoryTheory.Functor.whiskerLeft B_g.op
              (CategoryTheory.Functor.whiskerLeft B_f'.op δ'_pre)).app (Opposite.op W))
            (((θ_of b SC.X₃).app (Opposite.op W)) s) =
          (((θ_of b SC.X₃).app (Opposite.op W)) s).comp (hSE.map_of_exact L_g').extClass rfl :=
        ConcreteCategory.congr_hom (hδ'_app (B_f'.obj (B_g.obj W)))
          (((θ_of b SC.X₃).app (Opposite.op W)) s)
      change ((θ_of (b + 1) SC.X₁).app (Opposite.op W))
          (((CategoryTheory.Functor.whiskerLeft B_f.op δ_pre).app (Opposite.op W)) s) =
        ((CategoryTheory.Functor.whiskerLeft B_g.op
            (CategoryTheory.Functor.whiskerLeft B_f'.op δ'_pre)).app (Opposite.op W))
          (((θ_of b SC.X₃).app (Opposite.op W)) s)
      rw [h1_s, h2_s, hθ_app (b + 1) SC.X₁ W (s.comp hSE.extClass rfl), hθ_app b SC.X₃ W s,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (ρ_gen W))
          (CategoryTheory.Abelian.Ext.mapExactFunctor L_g' s)
          (hSE.map_of_exact L_g').extClass
          (Nat.zero_add b) rfl (Nat.zero_add (b + 1))]

    exact ⟨bc, hbc_nat,
      h_abelian_delta
        (CategoryTheory.Sheaf J_X AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_X' AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_S AddCommGrpCat.{u})
        (CategoryTheory.Sheaf J_S' AddCommGrpCat.{u})
        L_g L_g'
        R_f R_f_map R_f' R_f'_map
        δ_f δ_f' bc P_sh
        (fun hSE b => (Classical.choose_spec ((h_single_mor J_X J_S B_f).2 hSE b)).2)
        (fun hSE' b => (Classical.choose_spec ((h_single_mor J_X' J_S' B_f').2 hSE' b)).2)
        hbc_nat hbc_δ hbc_zero_iso hRes_L⟩

  
  intro B_f B_g B_f' B_g' pf_f pf_f' pb_g pb_g' adj_g adj_g' e_fun e_pf hBC0 hRes
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_g := h_leftAdj_finColim adj_g
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_g' := h_leftAdj_finColim adj_g'
  exact h_abstract_sites
    X.Etale S.Etale S'.Etale X'.Etale
    X.smallEtaleTopology S.smallEtaleTopology S'.smallEtaleTopology X'.smallEtaleTopology
    B_f B_g B_f' B_g'
    pb_g adj_g pb_g' adj_g'
    e_fun P
    (fun W => weilPolyP1CohomologyRepPullHom g' (B_f.obj W) (B_f'.obj (B_g.obj W)) (e_fun.inv.app W))
    (fun W => Equiv.apply_symm_apply _ _)
    hBC0 hRes

theorem weil_pbc_rel_projLine_kpoint_stalk_cohomology_equiv (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (S X : AlgebraicGeometry.Scheme.{u})
    (f_S : Quiver.Hom S (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType f_S]
    (π : Quiver.Hom X S)
    (q_P1 : Quiver.Hom X (weilProjectiveSpaceOver k 1).left)
    (hpb_X : CategoryTheory.IsPullback π q_P1 f_S (weilProjectiveSpaceOver k 1).hom)
    (hPBC : ∀ (B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType B.hom]
      [AlgebraicGeometry.IsAffine B.left],
      WeilCanonicalModPrimePBC ℓ
        (CategoryTheory.Limits.pullback.fst B.hom (weilProjectiveSpaceOver k 1).hom))
    (σ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) S)
    (hσ : CategoryTheory.CategoryStruct.comp σ f_S =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_σ : Quiver.Hom (weilProjectiveSpaceOver k 1).left X)
    (hι_π : CategoryTheory.CategoryStruct.comp ι_σ π =
      CategoryTheory.CategoryStruct.comp (weilProjectiveSpaceOver k 1).hom σ)
    (hι_q : CategoryTheory.CategoryStruct.comp ι_σ q_P1 =
      CategoryTheory.CategoryStruct.id (weilProjectiveSpaceOver k 1).left)
    [_hc_σ : (weilEtaleSitePullback σ).IsContinuous
      S.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology]
    [_hr_σ : ((weilEtaleSitePullback σ).sheafPushforwardContinuous AddCommGrpCat.{u}
      S.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology).IsRightAdjoint]
    [_hc_ι : (weilEtaleSitePullback ι_σ).IsContinuous
      X.smallEtaleTopology
      (weilProjectiveSpaceOver k 1).left.smallEtaleTopology]
    [_hr_ι : ((weilEtaleSitePullback ι_σ).sheafPushforwardContinuous AddCommGrpCat.{u}
      X.smallEtaleTopology
      (weilProjectiveSpaceOver k 1).left.smallEtaleTopology).IsRightAdjoint] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let P1 := (weilProjectiveSpaceOver k 1).left
    let T_k := weilEtaleIdTerminal S_k
    let pb_σ := (weilEtaleSitePullback σ).sheafPullback AddCommGrpCat.{u}
      S.smallEtaleTopology S_k.smallEtaleTopology
    let pb_ι := (weilEtaleSitePullback ι_σ).sheafPullback AddCommGrpCat.{u}
      X.smallEtaleTopology P1.smallEtaleTopology
    let Fℤ_P1 := (CategoryTheory.constantSheaf P1.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    ∃ (E : ∀ (b : ℕ) (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        ↑((pb_σ.obj (weilEtaleHigherDirectImage π b F)).obj.obj (Opposite.op T_k)) ≃+
          (pb_ι.obj F).H b),
      ∀ (b : ℕ)
        (F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (φ : Quiver.Hom F₁ F₂)
        (h₁ : ℓ • CategoryTheory.CategoryStruct.id F₁ = 0)
        (h₂ : ℓ • CategoryTheory.CategoryStruct.id F₂ = 0)
        (x : ↑((pb_σ.obj (weilEtaleHigherDirectImage π b F₁)).obj.obj (Opposite.op T_k))),
        E b F₂ h₂
          (((pb_σ.map (weilPolyP1HigherDirectImageMap π b φ)).hom.app (Opposite.op T_k)) x) =
          (CategoryTheory.Abelian.Ext.mk₀ (pb_ι.map φ)).postcomp Fℤ_P1 (Nat.add_zero b)
            (E b F₁ h₁ x) :=
by
  intro S_k P1 T_k pb_σ pb_ι Fℤ_P1
  have : ∀ {Y₁ Y₂ : Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Y₁ Y₂ : Scheme.{u}} (h : Y₁ ⟶ Y₂),
      MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  
  have h_s2 : ∀ {Y₁ Y₂ Y₃ : Scheme.{u}}
      (h₁ : Y₁ ⟶ Y₂) (h₂ : Y₂ ⟶ Y₃) (h₁₃ : Y₁ ⟶ Y₃)
      (_ : h₁ ≫ h₂ = h₁₃)
      [hc₁ : (weilEtaleSitePullback h₁).IsContinuous Y₂.smallEtaleTopology Y₁.smallEtaleTopology]
      [hr₁ : ((weilEtaleSitePullback h₁).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint]
      [hc₂ : (weilEtaleSitePullback h₂).IsContinuous Y₃.smallEtaleTopology Y₂.smallEtaleTopology]
      [hr₂ : ((weilEtaleSitePullback h₂).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₃.smallEtaleTopology Y₂.smallEtaleTopology).IsRightAdjoint]
      [hc₁₃ : (weilEtaleSitePullback h₁₃).IsContinuous Y₃.smallEtaleTopology Y₁.smallEtaleTopology]
      [hr₁₃ : ((weilEtaleSitePullback h₁₃).sheafPushforwardContinuous AddCommGrpCat.{u}
        Y₃.smallEtaleTopology Y₁.smallEtaleTopology).IsRightAdjoint],
      Nonempty (
        ((weilEtaleSitePullback h₁₃).sheafPullback AddCommGrpCat.{u}
          Y₃.smallEtaleTopology Y₁.smallEtaleTopology) ≅
        ((weilEtaleSitePullback h₂).sheafPullback AddCommGrpCat.{u}
          Y₃.smallEtaleTopology Y₂.smallEtaleTopology) ⋙
        ((weilEtaleSitePullback h₁).sheafPullback AddCommGrpCat.{u}
          Y₂.smallEtaleTopology Y₁.smallEtaleTopology)) := by
    intro Y₁ Y₂ Y₃ h₁ h₂ h₁₃ h_eq hc₁ hr₁ hc₂ hr₂ hc₁₃ hr₁₃
    let B₁ := weilEtaleSitePullback h₁
    let B₂ := weilEtaleSitePullback h₂
    let B₁₃ := weilEtaleSitePullback h₁₃
    let adj₁ := B₁.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let adj₂ := B₂.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₂.smallEtaleTopology
    let adj₁₃ := B₁₃.sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₃.smallEtaleTopology Y₁.smallEtaleTopology
    let e_B : B₁₃ ≅ B₂ ⋙ B₁ :=
      (MorphismProperty.Over.pullbackCongr h_eq.symm).trans
        (MorphismProperty.Over.pullbackComp h₁ h₂)
    have : (B₂ ⋙ B₁).IsContinuous Y₃.smallEtaleTopology Y₁.smallEtaleTopology :=
      Functor.isContinuous_comp B₂ B₁
        Y₃.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology
    let e_pf :=
      (Functor.sheafPushforwardContinuousIso e_B AddCommGrpCat.{u}
        Y₃.smallEtaleTopology Y₁.smallEtaleTopology).trans
      (Functor.sheafPushforwardContinuousComp B₂ B₁ AddCommGrpCat.{u}
        Y₃.smallEtaleTopology Y₂.smallEtaleTopology Y₁.smallEtaleTopology).symm
    exact ⟨adj₁₃.leftAdjointUniq ((adj₂.comp adj₁).ofNatIsoRight e_pf.symm)⟩

  
  
  let P1_ov := weilProjectiveSpaceOver k 1
  let : Unique ↥S_k := PrimeSpectrum.instUnique
  let pt_k : ↥S_k := default
  obtain ⟨W₀, hAff_W0, hy_W0, -⟩ :=
    @AlgebraicGeometry.exists_isAffineOpen_mem_and_subset S (σ.base pt_k) ⊤ trivial
  let R₀ : CommRingCat.{u} := S.presheaf.obj (Opposite.op W₀)
  let B₀ : Scheme.{u} := AlgebraicGeometry.Spec R₀
  let j₀ : B₀ ⟶ S := hAff_W0.fromSpec
  have : IsOpenImmersion j₀ := inferInstance
  have h_range_σ : Set.range ⇑σ.base ⊆ Set.range ⇑j₀.base := by
    rintro _ ⟨pt', rfl⟩
    rw [Subsingleton.elim pt' pt_k, hAff_W0.range_fromSpec]
    exact hy_W0
  let σ₀ : S_k ⟶ B₀ := IsOpenImmersion.lift j₀ σ h_range_σ
  have hσ₀_j₀ : σ₀ ≫ j₀ = σ := IsOpenImmersion.lift_fac j₀ σ h_range_σ
  let B_ov : Over S_k := Over.mk (j₀ ≫ f_S)
  have : IsAffine B_ov.left := by
    dsimp [B_ov, B₀]
