          ((f_q.hom.app (Opposite.op T_X)).hom ((adj_c.unit.app Aℤ).hom (ULift.up 1))) =
        (f_q.hom.app (Opposite.op V)).hom (u₁_Fℤ X V) := by
      intro V
      have hnat := ConcreteCategory.congr_hom (f_q.hom.naturality (Opposite.op (hT_X.from V)))
        (u₁_Fℤ X T_X)
      change (f_q.hom.app (Opposite.op V)).hom
          (((Fℤ X).obj.map (Opposite.op (hT_X.from V))).hom (u₁_Fℤ X T_X)) =
        (𝒬.obj.map (Opposite.op (hT_X.from V))).hom ((f_q.hom.app (Opposite.op T_X)).hom (u₁_Fℤ X T_X))
        at hnat
      rw [hadj_c]
      exact hnat.symm.trans (congrArg (f_q.hom.app (Opposite.op V)).hom (u₁_map (hT_X.from V)))
    exact hSE_cmp X W₁ W₂ hcov (weilEtaleGmSheaf X) ℱ 𝒬 ι_sh π_sh h0_sh hSE (u_gm_sh u) s₁ f_q
      hs₁
      ((h_bridge (V_et W₁)).symm.trans hfq₁)
      ((h_bridge (V_et W₂)).symm.trans hfq₂)

  · 
    intro X₁ X₂ f hCont
    dsimp only
    let B := weilEtaleSitePullback f
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
      AddCommGrpCat.{u} _ J₂ J₁ hCont
    intro hAdd_push hLim_push hColim_push T₁ hT₁ T₂ hT₂ N_sh V₁ V₂ hcov_V hcov_U u_U u_V ψ₁₂ hN
    letI := hAdd_push
    letI := hLim_push
    letI := hColim_push
    letI : CategoryTheory.Abelian (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) := inferInstance
    letI : CategoryTheory.HasExt (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) := inferInstance
    letI : CategoryTheory.Abelian (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}) := inferInstance
    letI : CategoryTheory.HasExt (CategoryTheory.Sheaf J₂ AddCommGrpCat.{u}) := inferInstance
    let U₁ : X₁.Opens := (TopologicalSpace.Opens.map f.base).obj V₁
    let U₂ : X₁.Opens := (TopologicalSpace.Opens.map f.base).obj V₂

    
    let μ : ∀ {V : X₂.Etale} {U : X₁.Etale},
        (B.obj V ⟶ U) → (L X₂ V ⟶ P_push.obj (L X₁ U)) :=
      fun {V} {U} ψ =>
        (evalEquiv X₂ V (P_push.obj (L X₁ U))).symm
          (evalEquiv X₁ (B.obj V) (L X₁ U) (L_map ψ))

    have μ_eval : ∀ {V : X₂.Etale} {U : X₁.Etale} (ψ : B.obj V ⟶ U)
        {F : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}} (α : L X₁ U ⟶ F),
        evalEquiv X₂ V (P_push.obj F) (μ ψ ≫ P_push.map α) =
          (F.obj.map (Opposite.op ψ)).hom (evalEquiv X₁ U F α) := by
      intro V U ψ F α
      have hp₂ : evalEquiv X₂ V (P_push.obj F) (μ ψ ≫ P_push.map α) =
          (α.hom.app (Opposite.op (B.obj V))).hom
            (evalEquiv X₁ (B.obj V) (L X₁ U) (L_map ψ)) :=
        (eval_post X₂ V (μ ψ) (P_push.map α)).trans
          (congrArg ((P_push.map α).hom.app (Opposite.op V)).hom
            ((evalEquiv X₂ V (P_push.obj (L X₁ U))).apply_symm_apply _))
      exact hp₂.trans
        ((eval_post X₁ (B.obj V) (L_map ψ) α).symm.trans (eval_pre ψ α))

    have μ_sq : ∀ {V V' : X₂.Etale} {U U' : X₁.Etale}
        (g₂ : V ⟶ V') (g₁ : U ⟶ U')
        (ψ : B.obj V ⟶ U) (ψ' : B.obj V' ⟶ U'),
        B.map g₂ ≫ ψ' = ψ ≫ g₁ →
        μ ψ ≫ P_push.map (L_map g₁) = L_map g₂ ≫ μ ψ' := by
      intro V V' U U' g₂ g₁ ψ ψ' hsq
      apply (evalEquiv X₂ V (P_push.obj (L X₁ U'))).injective
      have hop₁ : Opposite.op (ψ ≫ g₁) =
          (Opposite.op g₁ ≫ Opposite.op ψ : Opposite.op U' ⟶ Opposite.op (B.obj V)) := rfl
      have hop₂ : Opposite.op (B.map g₂ ≫ ψ') =
          (Opposite.op ψ' ≫ Opposite.op (B.map g₂) : Opposite.op U' ⟶ Opposite.op (B.obj V)) := rfl
      have hL : evalEquiv X₂ V (P_push.obj (L X₁ U')) (μ ψ ≫ P_push.map (L_map g₁)) =
          ((L X₁ U').obj.map (Opposite.op (ψ ≫ g₁))).hom
            (evalEquiv X₁ U' (L X₁ U') (𝟙 (L X₁ U'))) := by
        refine (μ_eval ψ (L_map g₁)).trans ?_
        calc
          ((L X₁ U').obj.map (Opposite.op ψ)).hom
              (evalEquiv X₁ U (L X₁ U') (L_map g₁))
            = ((L X₁ U').obj.map (Opposite.op ψ)).hom
                (evalEquiv X₁ U (L X₁ U') (L_map g₁ ≫ 𝟙 (L X₁ U'))) := by
                rw [CategoryTheory.Category.comp_id]
          _ = ((L X₁ U').obj.map (Opposite.op (ψ ≫ g₁))).hom
                (evalEquiv X₁ U' (L X₁ U') (𝟙 (L X₁ U'))) := by
                rw [eval_pre g₁ (𝟙 _), hop₁, CategoryTheory.Functor.map_comp]
                rfl
      have hR : evalEquiv X₂ V (P_push.obj (L X₁ U')) (L_map g₂ ≫ μ ψ') =
          ((L X₁ U').obj.map (Opposite.op (B.map g₂ ≫ ψ'))).hom
            (evalEquiv X₁ U' (L X₁ U') (𝟙 (L X₁ U'))) := by
        have hp := (eval_pre g₂ (μ ψ')).trans
          (congrArg (((P_push.obj (L X₁ U')).obj.map (Opposite.op g₂)).hom)
            ((evalEquiv X₂ V' (P_push.obj (L X₁ U'))).apply_symm_apply _))
        refine hp.trans ?_
        change ((L X₁ U').obj.map (Opposite.op (B.map g₂))).hom
            (evalEquiv X₁ (B.obj V') (L X₁ U') (L_map ψ')) = _
        calc
          ((L X₁ U').obj.map (Opposite.op (B.map g₂))).hom
              (evalEquiv X₁ (B.obj V') (L X₁ U') (L_map ψ'))
            = ((L X₁ U').obj.map (Opposite.op (B.map g₂))).hom
                (evalEquiv X₁ (B.obj V') (L X₁ U') (L_map ψ' ≫ 𝟙 (L X₁ U'))) := by
                rw [CategoryTheory.Category.comp_id]
          _ = ((L X₁ U').obj.map (Opposite.op (B.map g₂ ≫ ψ'))).hom
                (evalEquiv X₁ U' (L X₁ U') (𝟙 (L X₁ U'))) := by
                rw [eval_pre ψ' (𝟙 _), hop₂, CategoryTheory.Functor.map_comp]
                rfl
      exact hL.trans ((congrArg (fun k =>
        ((L X₁ U').obj.map (Opposite.op k)).hom
          (evalEquiv X₁ U' (L X₁ U') (𝟙 (L X₁ U')))) hsq.symm).trans hR.symm)

    
    have lift_open : ∀ (V : X₂.Opens),
        Nonempty (B.obj (V_et V) ⟶ V_et ((TopologicalSpace.Opens.map f.base).obj V)) := by
      intro V
      let U : X₁.Opens := (TopologicalSpace.Opens.map f.base).obj V
      have hOpenU : AlgebraicGeometry.IsOpenImmersion (AlgebraicGeometry.Scheme.Opens.ι U) :=
        inferInstance
      let p_snd : (B.obj (V_et V)).left ⟶ X₁ := (B.obj (V_et V)).hom
      have hrange : Set.range p_snd.base ⊆ Set.range (AlgebraicGeometry.Scheme.Opens.ι U).base := by
        rintro _ ⟨z, rfl⟩
        have hcond : CategoryTheory.Limits.pullback.fst V.ι f ≫ V.ι = p_snd ≫ f :=
          CategoryTheory.Limits.pullback.condition
        have hz_mem : f.base (p_snd.base z) ∈ V := by
          have hpt := congrArg (fun φ => φ.base z) hcond.symm
          change f.base (p_snd.base z) =
            ((CategoryTheory.Limits.pullback.fst V.ι f).base z).1 at hpt
          rw [hpt]
          exact ((CategoryTheory.Limits.pullback.fst V.ι f).base z).2
        exact ⟨⟨p_snd.base z, hz_mem⟩, rfl⟩
      exact ⟨CategoryTheory.MorphismProperty.Over.homMk
        (@AlgebraicGeometry.IsOpenImmersion.lift _ _ X₁ (AlgebraicGeometry.Scheme.Opens.ι U)
          p_snd hOpenU hrange)
        (@AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ X₁ (AlgebraicGeometry.Scheme.Opens.ι U)
          p_snd hOpenU hrange)
        trivial⟩

    let ψ₁ : B.obj (V_et V₁) ⟶ V_et U₁ := Classical.choice (lift_open V₁)
    let ψ₂ : B.obj (V_et V₂) ⟶ V_et U₂ := Classical.choice (lift_open V₂)
    let j_V₁ : V_et (V₁ ⊓ V₂) ⟶ V_et V₁ := inc_et inf_le_left
    let j_V₂ : V_et (V₁ ⊓ V₂) ⟶ V_et V₂ := inc_et inf_le_right
    let j_U₁ : V_et (U₁ ⊓ U₂) ⟶ V_et U₁ := inc_et inf_le_left
    let j_U₂ : V_et (U₁ ⊓ U₂) ⟶ V_et U₂ := inc_et inf_le_right

    have hsq₁ : B.map j_V₁ ≫ ψ₁ = ψ₁₂ ≫ j_U₁ := etale_open_hom_eq _ _
    have hsq₂ : B.map j_V₂ ≫ ψ₂ = ψ₁₂ ≫ j_U₂ := etale_open_hom_eq _ _

    
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let ρℤ : Fℤ X₂ ⟶ P_push.obj (Fℤ X₁) :=
      (adj₂.homEquiv Aℤ (P_push.obj (Fℤ X₁))).symm
        (CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
          ((Fℤ X₁).obj.map (Opposite.op (hT₁.from (B.obj T₂)))))
    have hadj₁ : adj₁.unit.app Aℤ = ((shAdj X₁).unit.app (Pℤ X₁)).app (Opposite.op T₁) :=
      CategoryTheory.Category.id_comp _
    have hadj₂ : adj₂.unit.app Aℤ = ((shAdj X₂).unit.app (Pℤ X₂)).app (Opposite.op T₂) :=
      CategoryTheory.Category.id_comp _
    have hρ_T₂ : (ρℤ.hom.app (Opposite.op T₂)).hom (u₁_Fℤ X₂ T₂) = u₁_Fℤ X₁ (B.obj T₂) := by
      have h1 : adj₂.homEquiv Aℤ (P_push.obj (Fℤ X₁)) ρℤ =
          adj₁.unit.app Aℤ ≫ (Fℤ X₁).obj.map (Opposite.op (hT₁.from (B.obj T₂))) :=
        (adj₂.homEquiv Aℤ (P_push.obj (Fℤ X₁))).apply_symm_apply _
      have h2 : adj₂.homEquiv Aℤ (P_push.obj (Fℤ X₁)) ρℤ =
          adj₂.unit.app Aℤ ≫ ρℤ.hom.app (Opposite.op T₂) :=
        CategoryTheory.Adjunction.homEquiv_unit adj₂ Aℤ (P_push.obj (Fℤ X₁)) ρℤ
      have h3 := ConcreteCategory.congr_hom (h2.symm.trans h1) (ULift.up (1 : ℤ))
      rw [hadj₂, hadj₁] at h3
      exact h3.trans (u₁_map (hT₁.from (B.obj T₂)))
    have hρ_val : ∀ V : X₂.Etale,
        (ρℤ.hom.app (Opposite.op V)).hom (u₁_Fℤ X₂ V) = u₁_Fℤ X₁ (B.obj V) := by
      intro V
      have hnat := ConcreteCategory.congr_hom (ρℤ.hom.naturality (Opposite.op (hT₂.from V)))
        (u₁_Fℤ X₂ T₂)
      change (ρℤ.hom.app (Opposite.op V)).hom
          (((Fℤ X₂).obj.map (Opposite.op (hT₂.from V))).hom (u₁_Fℤ X₂ T₂)) =
        (((Fℤ X₁).obj.map (Opposite.op (B.map (hT₂.from V)))).hom
          ((ρℤ.hom.app (Opposite.op T₂)).hom (u₁_Fℤ X₂ T₂))) at hnat
      rw [u₁_map (hT₂.from V), hρ_T₂, u₁_map (B.map (hT₂.from V))] at hnat
      exact hnat

    
    let Φ₁ : L X₂ (V_et (V₁ ⊓ V₂)) ⟶ P_push.obj (L X₁ (V_et (U₁ ⊓ U₂))) := μ ψ₁₂
    let Φ₂ : CategoryTheory.Limits.biprod (L X₂ (V_et V₁)) (L X₂ (V_et V₂)) ⟶
        P_push.obj (CategoryTheory.Limits.biprod (L X₁ (V_et U₁)) (L X₁ (V_et U₂))) :=
      CategoryTheory.Limits.biprod.desc
        (μ ψ₁ ≫ P_push.map CategoryTheory.Limits.biprod.inl)
        (μ ψ₂ ≫ P_push.map CategoryTheory.Limits.biprod.inr)

    have hΦ_left : Φ₁ ≫ P_push.map (ι_MV U₁ U₂) = ι_MV V₁ V₂ ≫ Φ₂ := by
      dsimp only [Φ₁, Φ₂, ι_MV]
      have h_lift : CategoryTheory.Limits.biprod.lift (L_map j_U₁) (- L_map j_U₂) =
          L_map j_U₁ ≫ CategoryTheory.Limits.biprod.inl +
            (- L_map j_U₂) ≫ CategoryTheory.Limits.biprod.inr := by
        apply CategoryTheory.Limits.biprod.hom_ext
        · simp
        · simp
      change μ ψ₁₂ ≫ P_push.map (CategoryTheory.Limits.biprod.lift (L_map j_U₁) (- L_map j_U₂)) =
        CategoryTheory.Limits.biprod.lift (L_map j_V₁) (- L_map j_V₂) ≫
          CategoryTheory.Limits.biprod.desc
            (μ ψ₁ ≫ P_push.map CategoryTheory.Limits.biprod.inl)
            (μ ψ₂ ≫ P_push.map CategoryTheory.Limits.biprod.inr)
      rw [h_lift, P_push.map_add, P_push.map_comp, P_push.map_comp, P_push.map_neg,
        CategoryTheory.Preadditive.neg_comp, CategoryTheory.Preadditive.comp_add,
        CategoryTheory.Preadditive.comp_neg,
        ← CategoryTheory.Category.assoc (μ ψ₁₂), ← CategoryTheory.Category.assoc (μ ψ₁₂),
        μ_sq j_V₁ j_U₁ ψ₁₂ ψ₁ hsq₁, μ_sq j_V₂ j_U₂ ψ₁₂ ψ₂ hsq₂,
        CategoryTheory.Limits.biprod.lift_desc, CategoryTheory.Preadditive.neg_comp]
      simp only [CategoryTheory.Category.assoc]

    have hΦ_right : Φ₂ ≫ P_push.map (π_MV U₁ U₂) = π_MV V₁ V₂ ≫ ρℤ := by
      apply CategoryTheory.Limits.biprod.hom_ext'
      · dsimp only [Φ₂, π_MV]
        rw [CategoryTheory.Limits.biprod.inl_desc_assoc, CategoryTheory.Category.assoc,
          ← P_push.map_comp, CategoryTheory.Limits.biprod.inl_desc,
          CategoryTheory.Limits.biprod.inl_desc_assoc]
        apply (evalEquiv X₂ (V_et V₁) (P_push.obj (Fℤ X₁))).injective
        rw [μ_eval ψ₁, eval_post, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
          u₁_map ψ₁, hρ_val (V_et V₁)]
      · dsimp only [Φ₂, π_MV]
        rw [CategoryTheory.Limits.biprod.inr_desc_assoc, CategoryTheory.Category.assoc,
          ← P_push.map_comp, CategoryTheory.Limits.biprod.inr_desc,
          CategoryTheory.Limits.biprod.inr_desc_assoc]
        apply (evalEquiv X₂ (V_et V₂) (P_push.obj (Fℤ X₁))).injective
        rw [μ_eval ψ₂, eval_post, Equiv.apply_symm_apply, Equiv.apply_symm_apply,
          u₁_map ψ₂, hρ_val (V_et V₂)]

    let hMV₁ := hMV_fn X₁ U₁ U₂ hcov_U
    let hMV₂ := hMV_fn X₂ V₁ V₂ hcov_V
    have hMV₁_push :
        ((CategoryTheory.ShortComplex.mk (ι_MV U₁ U₂) (π_MV U₁ U₂)
          (h0_MV_fn X₁ U₁ U₂ hcov_U)).map P_push).ShortExact :=
      hMV₁.map_of_exact P_push
    have h_nat :
        hMV₂.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ Φ₁) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ ρℤ).comp hMV₁_push.extClass (Nat.zero_add 1) :=
      CategoryTheory.ShortComplex.ShortExact.extClass_naturality hMV₂ hMV₁_push
        (CategoryTheory.ShortComplex.homMk Φ₁ Φ₂ ρℤ hΦ_left hΦ_right)

    let u_U_hat := (evalEquiv X₁ (V_et (U₁ ⊓ U₂)) (weilEtaleGmSheaf X₁)).symm (u_gm_sh u_U)
    let u_V_hat := (evalEquiv X₂ (V_et (V₁ ⊓ V₂)) (weilEtaleGmSheaf X₂)).symm (u_gm_sh u_V)

    have hu_comp : Φ₁ ≫ P_push.map u_U_hat ≫ N_sh = u_V_hat := by
      apply (evalEquiv X₂ (V_et (V₁ ⊓ V₂)) (weilEtaleGmSheaf X₂)).injective
      rw [← CategoryTheory.Category.assoc Φ₁, eval_post, μ_eval ψ₁₂ u_U_hat,
        Equiv.apply_symm_apply, Equiv.apply_symm_apply]
      exact hN

    change CategoryTheory.Abelian.Ext.comp
        (CategoryTheory.Abelian.Ext.comp
          (CategoryTheory.Abelian.Ext.mk₀ ρℤ)
          ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ P_push
            hAdd_push hLim_push hColim_push _ _
            (Fℤ X₁) (weilEtaleGmSheaf X₁) 1)
            (hMV₁.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ u_U_hat) (Nat.add_zero 1)))
          (Nat.zero_add 1))
        (CategoryTheory.Abelian.Ext.mk₀ N_sh)
        (Nat.add_zero 1) =
      hMV₂.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ u_V_hat) (Nat.add_zero 1)
    rw [CategoryTheory.Functor.mapExtAddHom_apply,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_push hMV₁,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← h_nat,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hu_comp]

theorem weil_polyP1_last_coord_kummer_finite_free_gm_det_norm (d : ℕ) (hd : 1 ≤ d)
    {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
    (hf_free : WeilTopDegFiniteLocallyFreeOfRank d f)
    (hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z)) :
    let B := weilEtaleSitePullback f
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget X₁
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget X₂
    ∃ (ν_f : ∀ U : X₂.Etale,
        Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) →*
          Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))),
      (∀ {U' U : X₂.Etale} (u : Quiver.Hom U' U)
          (w : Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
        Units.map (((Fgt₂.map u).left).appTop).hom.toMonoidHom (ν_f U w) =
          ν_f U' (Units.map (((Fgt₁.map (B.map u)).left).appTop).hom.toMonoidHom w)) ∧
      (∀ (U : X₂.Etale)
          (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj U).left)
          (M : Type u) (_ : AddCommGroup M)
          (_ : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
          (bM : Module.Basis (Fin d)
            ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
          (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
        (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
          e (r₀ • m) =
            @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
              (CommRingCat.Hom.hom
                (AlgebraicGeometry.Scheme.Hom.appTop
                  (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
              (e m)) →
        ∀ (w : Units ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)))
          (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
          (∀ m : M, e (L m) = (w : ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))) * e m) →
          ((ν_f U w : Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) :
            ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) =
            ((LinearMap.toMatrix bM bM) L).det) ∧
      (∀ (U : X₂.Etale)
          (y₁ y₂ : Units ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))),
        (∀ (V : X₂.Etale) (g : Quiver.Hom V U)
            (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj V).left)
            (M : Type u) (_ : AddCommGroup M)
            (_ : Module ↑(((Fgt₂.obj V).left).presheaf.obj (Opposite.op ⊤)) M)
            (_bM : Module.Basis (Fin d)
              ↑(((Fgt₂.obj V).left).presheaf.obj (Opposite.op ⊤)) M)
            (e : M ≃+ ↑(((Fgt₁.obj (B.obj V)).left).presheaf.obj (Opposite.op ⊤))),
