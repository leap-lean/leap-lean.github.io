            (∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (R p M)) ∧
            (∀ p : ℕ, 1 ≤ p → CategoryTheory.Limits.IsZero (R' p (pb'.obj M)))) →
        ∀ (b : ℕ) (F : 𝒜), P_cls F → CategoryTheory.IsIso (bc_fam b F) := by
    intro 𝒜 𝒜' ℬ ℬ' _ _ _ _ _ _ _ _ pb _ _ pb' _ _ _
      R R_map R' R'_map δ δ' bc_fam P_cls hδ_ex hδ'_ex hnat hδ_comm h0 hRes_cls b
    induction b with
    | zero => exact h0
    | succ b ih =>
      intro F hPF
