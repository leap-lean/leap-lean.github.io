      rw [CategoryTheory.Category.id_comp]
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (CategoryTheory.Category.assoc φ_iso ψ_W g'_W).trans
          ((congrArg (CategoryTheory.CategoryStruct.comp φ_iso)
