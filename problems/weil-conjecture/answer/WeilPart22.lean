      have hu_zero' : R'_map (b + 1) ((CategoryTheory.ShortComplex.mk u v huv).map pb').f = 0 :=
        (hZero' (b + 1) (Nat.succ_pos b)).eq_of_tgt _ 0
      have : CategoryTheory.Epi (δ hSE b) := hex₁.epi_f hu_zero
      have : CategoryTheory.Epi (δ' hSE' b) := hex₁'.epi_f hu_zero'
      have : CategoryTheory.IsIso (bc_fam b Q) := ih Q hPQ
      have hcomm_δ : pb.map (δ hSE b) ≫ bc_fam (b + 1) F =
