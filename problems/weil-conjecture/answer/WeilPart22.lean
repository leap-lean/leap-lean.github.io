      rwa [one_zsmul] at hz1
    let FgtL_S₀ := AlgebraicGeometry.Scheme.Etale.forget S₀ ⋙ CategoryTheory.Over.forget S₀
    let L₀ := weilEtaleLocalTorsionSheaf S₀ m₀ V
    let L_m := weilEtaleLocalTorsionSheaf S₀ m V
    let P₀ := CategoryTheory.Presheaf.freeYoneda V (A m₀)
    let η₀ := CategoryTheory.toSheafify S₀.smallEtaleTopology P₀
    let η₀' : P₀ ⟶ L₀.obj := η₀
    let ξ₀ : A m₀ ⟶ L₀.obj.obj (Opposite.op V) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L₀)
    let ξ_m : A m ⟶ L_m.obj.obj (Opposite.op V) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_m)
    let Ψ := mapCoeff φ S₀ V ≫ Γ_m
    have hPresheafSectionZero :
        ∀ (Z : S₀.Etale) (p_Z : ↥(P₀.obj (Opposite.op Z))),
        Ψ.hom.app (Opposite.op Z) (η₀'.app (Opposite.op Z) p_Z) = 0 →
        η₀'.app (Opposite.op Z) p_Z = 0 := by
      intro Z p_Z hΨ_zero
      let s_Z : ↥(L₀.obj.obj (Opposite.op Z)) := η₀'.app (Opposite.op Z) p_Z
      let O_van : Set ↥Z.left :=
        { z : ↥Z.left | ∃ (W : S₀.Etale) (w : W ⟶ Z),
            z ∈ Set.range w.left.base ∧ L₀.obj.map w.op s_Z = 0 }
      by_cases hO_univ : O_van = Set.univ
      · let S_zero : CategoryTheory.Sieve Z :=
          { arrows := fun {W} w => L₀.obj.map w.op s_Z = 0
            downward_closed := fun {W₁ W₂} {w} hw u => by
              rw [CategoryTheory.op_comp, CategoryTheory.Functor.map_comp]
              change L₀.obj.map u.op (L₀.obj.map w.op s_Z) = 0
              rw [hw, map_zero] }
        have hS_zero_mem : S_zero ∈ S₀.smallEtaleTopology Z := by
          refine (hMemEtale S_zero).mpr (fun z => ?_)
          have hz_mem : z ∈ O_van := hO_univ.symm ▸ Set.mem_univ z
          obtain ⟨W, w, ⟨y, hy⟩, hw0⟩ := hz_mem
          have hw_eq : w.left ≫ Z.hom = W.hom := CategoryTheory.MorphismProperty.Over.w w
          have hEt_w : AlgebraicGeometry.Etale w.left :=
            CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) w.left Z.hom
              Z.prop (hw_eq.symm ▸ W.prop)
          exact ⟨W, w, y, hw0, hEt_w, hy⟩
        exact hSheafZeroOfSieve s_Z S_zero hS_zero_mem (fun _ hg => hg)
      · exfalso
        have hNotAll : ∃ z₀ : ↥Z.left, z₀ ∉ O_van := by
          by_contra h_all
          exact hO_univ (Set.eq_univ_of_forall fun z => by_contra fun hz => h_all ⟨z, hz⟩)
        obtain ⟨z₀, hz₀_not_O⟩ := hNotAll
        let ι_P : ∀ (W : S₀.Etale), (W ⟶ V) → (A m₀ ⟶ P₀.obj (Opposite.op W)) :=
          fun W f => CategoryTheory.Limits.Sigma.ι (fun (_ : W ⟶ V) => A m₀) f
        let p_Z_cop : ↥(∐ fun (_ : Z ⟶ V) => A m₀) := p_Z
        obtain ⟨F_Z, c_Z, hp_Z_sum⟩ := hCoprodFinSum (Z ⟶ V) (A m₀) p_Z_cop
        have h_ι_η₀ : ∀ (β : Z ⟶ V),
            ι_P Z β ≫ η₀'.app (Opposite.op Z) = ξ₀ ≫ L₀.obj.map (Opposite.op β) := by
          intro β
          have hη₀_unit : (CategoryTheory.sheafificationAdjunction S₀.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app P₀ = η₀ :=
            CategoryTheory.sheafificationAdjunction_unit_app S₀.smallEtaleTopology P₀
          have hξ₀_def : ξ₀ = ι_P V (CategoryTheory.CategoryStruct.id V) ≫ η₀'.app (Opposite.op V) :=
            (congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv hη₀_unit).trans
              ((congrArg CategoryTheory.Presheaf.freeYonedaHomEquiv
                (CategoryTheory.Category.id_comp η₀).symm).trans
                (CategoryTheory.Presheaf.freeYonedaHomEquiv_comp
                  (CategoryTheory.CategoryStruct.id P₀) η₀))
          have h_ι_map_β :
              ι_P V (CategoryTheory.CategoryStruct.id V) ≫ P₀.map (Opposite.op β) = ι_P Z β :=
            h_ι_free_map V Z (A m₀) β
          rw [hξ₀_def, CategoryTheory.Category.assoc, ← η₀'.naturality (Opposite.op β),
            ← CategoryTheory.Category.assoc, h_ι_map_β]
        have hs_Z_sum : s_Z = ∑ β ∈ F_Z, (ξ₀ ≫ L₀.obj.map (Opposite.op β)) (c_Z β) := by
          change η₀'.app (Opposite.op Z) p_Z = _
          have hp_eq : p_Z = ∑ i ∈ F_Z, (ι_P Z i) (c_Z i) := hp_Z_sum
          rw [hp_eq, map_sum]
          refine Finset.sum_congr rfl (fun β _ => ?_)
          change (ι_P Z β ≫ η₀'.app (Opposite.op Z)) (c_Z β) = _
          rw [h_ι_η₀ β]
        have hOpen_Z' : ∃ (Z' : S₀.Etale) (w_star : Z' ⟶ Z),
            Nonempty ↥Z'.left ∧
            L₀.obj.map (Opposite.op w_star) s_Z ≠ 0 ∧
            (∀ β₁ ∈ F_Z, ∀ β₂ ∈ F_Z, w_star ≫ β₁ ≠ w_star ≫ β₂ →
