  have hProp_Wσ : AlgebraicGeometry.IsProper W_bar_σ.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback π_W σ) hProp_πW
  have hπ_σ_over : CategoryTheory.CategoryStruct.comp π_leg_σ P1_over.hom = W_bar_σ.hom :=
    (CategoryTheory.Category.assoc g'_W (π_leg ≫ π_snd) P1_over.hom).trans
      ((congrArg (CategoryTheory.CategoryStruct.comp g'_W)
          ((CategoryTheory.Category.assoc π_leg π_snd P1_over.hom).trans
            ((congrArg (CategoryTheory.CategoryStruct.comp π_leg)
                (CategoryTheory.Limits.pullback.condition
                  (f := P_m.hom) (g := P1_over.hom)).symm).trans
              ((CategoryTheory.Category.assoc π_leg fst_P P_m.hom).symm.trans
                (congrArg (fun m => (π_leg ≫ m) ≫ P_m.hom) hπ_eq.symm))))).trans
        ((congrArg (fun m => g'_W ≫ (m ≫ P_m.hom)) hg).trans
          ((CategoryTheory.Category.assoc g'_W π_W P_m.hom).symm.trans
            ((congrArg (fun m => m ≫ P_m.hom)
                (CategoryTheory.Limits.pullback.condition (f := π_W) (g := σ))).trans
              ((CategoryTheory.Category.assoc W_bar_σ.hom σ P_m.hom).trans
                ((congrArg (CategoryTheory.CategoryStruct.comp W_bar_σ.hom) hσ).trans
