            intro S_outer
            induction S_outer using Finset.induction_on with
            | empty =>
              exact ⟨⊤, trivial, fun _ h_in => False.elim (Finset.notMem_empty _ h_in)⟩
            | @insert β₁ S_rest _ ih =>
              obtain ⟨U_s, hz_s, hle_s⟩ := ih
              obtain ⟨U_row, hz_row, hle_row⟩ := hU_row_ex β₁ F_Z
              refine ⟨U_row ⊓ U_s, ⟨hz_row, hz_s⟩, fun β' hβ' β₂ hβ₂ => ?_⟩
