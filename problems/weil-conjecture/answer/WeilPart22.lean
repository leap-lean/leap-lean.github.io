        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage π_fst b SC.X₂)) := by
    haveI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) π_fst :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    haveI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong
        (@AlgebraicGeometry.Etale) π_fst :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
