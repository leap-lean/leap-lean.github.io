                      (Matrix.det_mul _ _).symm
                _ = ((LinearMap.toMatrix bA bA)
                      (LinearMap.mulLeft B g₀ ∘ₗ LinearMap.mulLeft B (c.1 * a'))).det := by
                      rw [← LinearMap.toMatrix_comp]
                _ = ((LinearMap.toMatrix bA bA) (s • (LinearMap.id : A →ₗ[B] A))).det := by
                      rw [hlin]
                _ = (s • (1 : Matrix (Fin d) (Fin d) B)).det := by
                      rw [map_smul, LinearMap.toMatrix_id]
                _ = s ^ d := by
                      rw [Matrix.det_smul, Fintype.card_fin, Matrix.det_one, mul_one]
            have hsd_mem : s ^ d ∈ p := by
              rw [← hdet_mul]
              exact Ideal.mul_mem_right _ p hΔ_p
            exact hs_compl (hp.mem_of_pow_mem d hsd_mem)
          have hne_top : Ideal.span ({algebraMap A A_M g₀} : Set A_M) ≠ ⊤ :=
            fun htop => hnot_unit (Ideal.span_singleton_eq_top.mp htop)
          obtain ⟨m_AM, hm_AM_max, hg₀_in_mAM⟩ := Ideal.exists_le_maximal _ hne_top
          let q : Ideal A := Ideal.comap (algebraMap A A_M) m_AM
          have hq_prime : q.IsPrime := Ideal.comap_isPrime (algebraMap A A_M) m_AM
          have hg₀_in_q : g₀ ∈ q :=
            hg₀_in_mAM (Ideal.subset_span (Set.mem_singleton _))
          have hq_le_p : Ideal.comap (algebraMap B A) q ≤ p := by
            intro b hb
            by_contra hbp
            have hm_unit : IsUnit (algebraMap A A_M (algebraMap B A b)) :=
              IsLocalization.map_units (M := M_sub) A_M
                ⟨algebraMap B A b, Submonoid.mem_map_of_mem (algebraMap B A) (show b ∈ p.primeCompl from hbp)⟩
            exact hm_AM_max.ne_top (Ideal.eq_top_of_isUnit_mem m_AM hb hm_unit)
          have hφb₀_not_q : algebraMap B A b₀ ∉ q := fun hmem => hb₀_p (hq_le_p hmem)
          have hq_eq : q = P_id := (hg₀_iso q hq_prime hφb₀_not_q).mp hg₀_in_q
          have hmQ_le_p : m_Q ≤ p := by
            rw [← hOver, ← hq_eq]
            exact hq_le_p
          exact (‹m_Q.IsMaximal›.eq_of_le hp.ne_top hmQ_le_p).symm
        · intro hp_eq
          rw [hp_eq]
          by_contra hnot
          have hunit : IsUnit (algebraMap B (Localization.AtPrime m_Q) Δ) :=
            (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime m_Q) m_Q Δ).mpr hnot
          have htop : Ideal.span ({algebraMap B (Localization.AtPrime m_Q) Δ} :
              Set (Localization.AtPrime m_Q)) = ⊤ :=
            Ideal.span_singleton_eq_top.mpr hunit
          rw [hdet_span] at htop
          exact (IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime m_Q)).ne_top htop

      
      let V₁ : P1_over.left.Opens := P1_over.left.basicOpen b₀
      have hV₁_le : V₁ ≤ V_chart := P1_over.left.basicOpen_le b₀
      have hAff_V₁ : AlgebraicGeometry.IsAffineOpen V₁ := hAff_V.basicOpen b₀
      have hQ_in_V₁ : Q₀.1 ∈ V₁ := by
        have h1 : p_Q ∈ (TopologicalSpace.Opens.map hAff_V.fromSpec.base).obj V₁ := by
          rw [hAff_V.fromSpec_preimage_basicOpen b₀]
          exact hb₀_not_mQ
        change hAff_V.fromSpec.base p_Q ∈ V₁ at h1
        rwa [hAff_V.fromSpec_primeIdealOf ⟨Q₀.1, hQ_in_V⟩] at h1
      let V₂ : P1_over.left.Opens := ⟨({Q₀.1} : Set ↥P1_over.left)ᶜ, Q₀.2.isOpen_compl⟩
      have hcov_V : V₁ ⊔ V₂ = ⊤ := by
        ext y
        simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top,
          Set.mem_union, Set.mem_univ, iff_true]
        by_cases hy : y = Q₀.1
        · exact Or.inl (hy ▸ hQ_in_V₁)
        · exact Or.inr hy
      let U₁ : C_bar.left.Opens := (TopologicalSpace.Opens.map f.base).obj V₁
      have hU₁_eq : U₁ = C_bar.left.basicOpen (φ b₀) :=
        AlgebraicGeometry.Scheme.preimage_basicOpen f b₀
      have hU₁_le : U₁ ≤ U_chart := hU₁_eq ▸ C_bar.left.basicOpen_le (φ b₀)
      have hAff_U₁ : AlgebraicGeometry.IsAffineOpen U₁ := hU₁_eq ▸ hAff_U.basicOpen (φ b₀)
      have hP_in_U₁ : P₀.1 ∈ U₁ := hQ_in_V₁
      let U₂ : C_bar.left.Opens := (TopologicalSpace.Opens.map f.base).obj V₂
      have hcov_U : U₁ ⊔ U₂ = ⊤ := by
        ext x
        have hx : f.base x ∈ (V₁ ⊔ V₂ : P1_over.left.Opens) := by
          rw [hcov_V]
          trivial
        exact iff_of_true hx trivial
      let W₂ : C_bar.left.Opens := ⟨({P₀.1} : Set ↥C_bar.left)ᶜ, P₀.2.isOpen_compl⟩
      have hU₂_le_W₂ : U₂ ≤ W₂ := by
        intro x hx hxP
        apply hx
        change f.base x = Q₀.1
        rw [Set.mem_singleton_iff.mp hxP]
      have hcov_UW : U₁ ⊔ W₂ = ⊤ := eq_top_iff.mpr (hcov_U ▸ sup_le_sup_left hU₂_le_W₂ U₁)

      
      let B₁ : Type u := ↑(P1_over.left.presheaf.obj (Opposite.op V₁))
      let A₁ : Type u := ↑(C_bar.left.presheaf.obj (Opposite.op U₁))
      let res_V : B →+* B₁ := (P1_over.left.presheaf.map (CategoryTheory.homOfLE hV₁_le).op).hom
      let res_U : A →+* A₁ := (C_bar.left.presheaf.map (CategoryTheory.homOfLE hU₁_le).op).hom
      let φ₁ : B₁ →+* A₁ := (f.app V₁).hom
      have hcomm_res : ∀ b : B, φ₁ (res_V b) = res_U (φ b) := fun b =>
        congrArg (fun g => g.hom b) (f.naturality (CategoryTheory.homOfLE hV₁_le).op)
      letI : Algebra B B₁ := res_V.toAlgebra
      have : IsLocalization.Away b₀ B₁ := hAff_V.isLocalization_basicOpen b₀
      letI : Algebra A A₁ := res_U.toAlgebra
      have halg_AA₁ : algebraMap A A₁ = res_U := rfl
      have : IsLocalization.Away (φ b₀) A₁ := by
        let e_open : C_bar.left.basicOpen (φ b₀) ≅ U₁ := CategoryTheory.eqToIso hU₁_eq.symm
        let e_ring : ↑(C_bar.left.presheaf.obj (Opposite.op (C_bar.left.basicOpen (φ b₀)))) ≃+* A₁ :=
          (C_bar.left.presheaf.mapIso e_open.op).symm.commRingCatIsoToRingEquiv
        have hcomp_eq :
            e_ring.toRingHom.comp
              (C_bar.left.presheaf.map
                (CategoryTheory.homOfLE (C_bar.left.basicOpen_le (φ b₀))).op).hom = res_U := by
          ext a
          change (C_bar.left.presheaf.map (CategoryTheory.homOfLE (C_bar.left.basicOpen_le (φ b₀))).op ≫
              C_bar.left.presheaf.map e_open.inv.op).hom a =
            (C_bar.left.presheaf.map (CategoryTheory.homOfLE hU₁_le).op).hom a
          rw [← C_bar.left.presheaf.map_comp, ← op_comp]
          rfl
        haveI hLoc0 : IsLocalization.Away (φ b₀)
            ↑(C_bar.left.presheaf.obj (Opposite.op (C_bar.left.basicOpen (φ b₀)))) :=
          hAff_U.isLocalization_basicOpen (φ b₀)
        exact IsLocalization.isLocalization_of_algEquiv (Submonoid.powers (φ b₀))
          { e_ring with
            commutes' := fun a => congrFun (congrArg DFunLike.coe hcomp_eq) a }
      letI : Module B₁ A₁ := φ₁.toAlgebra.toModule
      have hsmul_A₁ : ∀ (b₁ : B₁) (a₁ : A₁), b₁ • a₁ = φ₁ b₁ * a₁ := fun _ _ => rfl
      let u_b₀ : B₁ˣ := (IsLocalization.Away.algebraMap_isUnit (S := B₁) b₀).unit
      have hu_b₀_val : (u_b₀ : B₁) = res_V b₀ := IsUnit.unit_spec _
      let F_bas : (Fin d → B₁) →ₗ[B₁] A₁ :=
        { toFun := fun c => ∑ i : Fin d, φ₁ (c i) * res_U (bA i)
          map_add' := fun c₁ c₂ => by
            simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          map_smul' := fun r c => by
            simp only [Pi.smul_apply, smul_eq_mul, map_mul, RingHom.id_apply, hsmul_A₁,
              Finset.mul_sum, mul_assoc] }
      have hF_bij : Function.Bijective F_bas := by
        refine ⟨?_, ?_⟩
        · intro c₁ c₂ hc_eq
          have h0 : F_bas (c₁ - c₂) = 0 := by
            rw [map_sub, hc_eq, sub_self]
          ext i₀
          change c₁ i₀ = c₂ i₀
          apply sub_eq_zero.mp
          let c := c₁ - c₂
          have hsurj_c : ∀ i : Fin d, ∃ (k_i : ℕ) (r_i : B), c i * res_V (b₀ ^ k_i) = res_V r_i := by
            intro i
            obtain ⟨⟨r_i, _, k_i, rfl⟩, hk_i⟩ := IsLocalization.surj (Submonoid.powers b₀) (c i)
            exact ⟨k_i, r_i, hk_i⟩
          choose k_fn r_fn hr_fn using hsurj_c
          let N : ℕ := Finset.univ.sup k_fn
          let r'_fn : Fin d → B := fun i => r_fn i * b₀ ^ (N - k_fn i)
          have hr'_eq : ∀ i : Fin d, c i * res_V (b₀ ^ N) = res_V (r'_fn i) := by
            intro i
            have hle : k_fn i ≤ N := Finset.le_sup (Finset.mem_univ i)
            calc
              c i * res_V (b₀ ^ N)
                = (c i * res_V (b₀ ^ k_fn i)) * res_V (b₀ ^ (N - k_fn i)) := by
                    rw [mul_assoc, ← map_mul, ← pow_add, Nat.add_sub_of_le hle]
              _ = res_V (r'_fn i) := by rw [hr_fn i, ← map_mul]
          have hsum_A : res_U (∑ i : Fin d, r'_fn i • bA i) = 0 := by
            calc
              res_U (∑ i : Fin d, r'_fn i • bA i)
                = ∑ i : Fin d, res_U (φ (r'_fn i)) * res_U (bA i) := by
                    simp only [map_sum, Algebra.smul_def, halg_BA, map_mul]
              _ = ∑ i : Fin d, φ₁ (c i * res_V (b₀ ^ N)) * res_U (bA i) := by
                    refine Finset.sum_congr rfl fun i _ => ?_
                    rw [← hcomm_res, ← hr'_eq i]
              _ = φ₁ (res_V (b₀ ^ N)) * F_bas c := by
                    simp only [F_bas, LinearMap.coe_mk, AddHom.coe_mk, map_mul, Finset.mul_sum]
                    refine Finset.sum_congr rfl fun i _ => by ring
              _ = 0 := by rw [h0, mul_zero]
          obtain ⟨⟨_, M_exp, rfl⟩, hM_eq⟩ :=
            (IsLocalization.eq_iff_exists (Submonoid.powers (φ b₀)) A₁).mp
              (hsum_A.trans (map_zero res_U).symm)
          simp only [mul_zero] at hM_eq
          have hlin0 : (∑ i : Fin d, (b₀ ^ M_exp * r'_fn i) • bA i) = 0 := by
            calc
              (∑ i : Fin d, (b₀ ^ M_exp * r'_fn i) • bA i)
                = (φ b₀) ^ M_exp * (∑ i : Fin d, r'_fn i • bA i) := by
                    simp only [Algebra.smul_def, halg_BA, map_mul, map_pow, Finset.mul_sum,
                      mul_assoc]
              _ = 0 := hM_eq
          have hi₀_0 : b₀ ^ M_exp * r'_fn i₀ = 0 :=
            Fintype.linearIndependent_iff.mp bA.linearIndependent
              (fun i => b₀ ^ M_exp * r'_fn i) hlin0 i₀
          have hr'_res0 : res_V (r'_fn i₀) = 0 := by
            have h1 : res_V (b₀ ^ M_exp) * res_V (r'_fn i₀) = 0 := by
              rw [← map_mul, hi₀_0, map_zero]
            have hu_M : IsUnit (res_V (b₀ ^ M_exp)) := by
              rw [map_pow, ← hu_b₀_val]
              exact (u_b₀ ^ M_exp).isUnit
            exact hu_M.mul_right_eq_zero.mp h1
          have hc_mul0 : c i₀ * res_V (b₀ ^ N) = 0 := (hr'_eq i₀).trans hr'_res0
          have hu_N : IsUnit (res_V (b₀ ^ N)) := by
            rw [map_pow, ← hu_b₀_val]
            exact (u_b₀ ^ N).isUnit
          exact hu_N.mul_left_eq_zero.mp hc_mul0
        · intro a₁
          obtain ⟨⟨a, _, k_exp, rfl⟩, hk_eq⟩ :=
            IsLocalization.surj (Submonoid.powers (φ b₀)) a₁
          let c : Fin d → B₁ := fun i => ((u_b₀ ^ k_exp)⁻¹ : B₁ˣ).val * res_V (bA.repr a i)
          refine ⟨c, ?_⟩
          have hu_A₁ : IsUnit (φ₁ (res_V (b₀ ^ k_exp))) := by
            have hb₀_u : IsUnit (res_V b₀) := hu_b₀_val ▸ u_b₀.isUnit
            rw [map_pow]
            exact (hb₀_u.pow k_exp).map φ₁
          apply hu_A₁.mul_right_cancel
          calc
            F_bas c * φ₁ (res_V (b₀ ^ k_exp))
              = ∑ i : Fin d,
                  φ₁ (((u_b₀ ^ k_exp)⁻¹ : B₁ˣ).val * res_V (b₀ ^ k_exp) * res_V (bA.repr a i)) *
                    res_U (bA i) := by
                  change (∑ i : Fin d, φ₁ (c i) * res_U (bA i)) * φ₁ (res_V (b₀ ^ k_exp)) = _
                  rw [Finset.sum_mul]
                  refine Finset.sum_congr rfl fun i _ => ?_
                  change (φ₁ (((u_b₀ ^ k_exp)⁻¹ : B₁ˣ).val * res_V (bA.repr a i)) *
                      res_U (bA i)) * φ₁ (res_V (b₀ ^ k_exp)) = _
                  simp only [map_mul]
                  ring
            _ = ∑ i : Fin d, res_U (φ (bA.repr a i) * bA i) := by
                  have hinv : ((u_b₀ ^ k_exp)⁻¹ : B₁ˣ).val * res_V (b₀ ^ k_exp) = 1 := by
                    rw [map_pow, ← hu_b₀_val]
                    exact Units.inv_mul (u_b₀ ^ k_exp)
                  refine Finset.sum_congr rfl fun i _ => ?_
                  rw [hinv, one_mul, hcomm_res, map_mul]
            _ = res_U (∑ i : Fin d, bA.repr a i • bA i) := by
                  simp only [map_sum, Algebra.smul_def, halg_BA]
            _ = res_U a := by rw [bA.sum_repr]
            _ = a₁ * φ₁ (res_V (b₀ ^ k_exp)) := by
                  dsimp only at hk_eq
                  rw [halg_AA₁] at hk_eq
                  rw [← hk_eq, map_pow, ← hcomm_res, ← map_pow, ← map_pow]
      let eF_lin : (Fin d → B₁) ≃ₗ[B₁] A₁ := LinearEquiv.ofBijective F_bas hF_bij
      let bA₁ : Module.Basis (Fin d) B₁ A₁ := (Pi.basisFun B₁ (Fin d)).map eF_lin
      have hbA₁_apply : ∀ i : Fin d, bA₁ i = res_U (bA i) := by
        intro i
        let v_i : Fin d → B₁ := Pi.single i 1
        change ((Pi.basisFun B₁ (Fin d)).map eF_lin) i = res_U (bA i)
        rw [Module.Basis.map_apply, Pi.basisFun_apply, LinearEquiv.ofBijective_apply]
        change (∑ x : Fin d, φ₁ (v_i x) * res_U (bA x)) = res_U (bA i)
        rw [Finset.sum_eq_single i]
        · simp only [v_i, Pi.single_eq_same, map_one, one_mul]
        · intro x _ hxi
          simp only [v_i, Pi.single_apply, hxi, hxi.symm, ↓reduceIte, map_zero, zero_mul]
        · intro hi_not
          exact absurd (Finset.mem_univ i) hi_not
      let g₁ : A₁ := res_U g₀
      let L_g : A₁ →ₗ[B₁] A₁ :=
        { toFun := fun x => g₁ * x
          map_add' := fun x y => mul_add g₁ x y
          map_smul' := fun b₁ x => by
            simp only [RingHom.id_apply, hsmul_A₁]
            ring }
      let det₁ : B₁ := res_V Δ
      have hdet₁_eq : ((LinearMap.toMatrix bA₁ bA₁) L_g).det = det₁ := by
        have hmat_eq : (LinearMap.toMatrix bA₁ bA₁) L_g = M₀_mat.map res_V := by
          ext i j
          rw [LinearMap.toMatrix_apply, Matrix.map_apply]
          have hcol : L_g (bA₁ j) = ∑ k : Fin d, (res_V (M₀_mat k j)) • bA₁ k := by
            calc
              L_g (bA₁ j) = res_U (g₀ * bA j) := by
                rw [hbA₁_apply]
                change res_U g₀ * res_U (bA j) = res_U (g₀ * bA j)
                rw [← map_mul]
              _ = res_U (∑ k : Fin d, (bA.repr (g₀ * bA j) k) • bA k) := by rw [bA.sum_repr]
              _ = ∑ k : Fin d, φ₁ (res_V (M₀_mat k j)) * bA₁ k := by
                    simp only [map_sum, Algebra.smul_def, halg_BA, map_mul, ← hcomm_res,
                      hbA₁_apply, M₀_mat, LinearMap.toMatrix_apply, LinearMap.mulLeft_apply]
              _ = ∑ k : Fin d, (res_V (M₀_mat k j)) • bA₁ k := rfl
          let coord_i : A₁ →ₗ[B₁] B₁ :=
            { toFun := fun x => bA₁.repr x i
              map_add' := fun x y => by rw [map_add, Finsupp.add_apply]
              map_smul' := fun r x => by
                rw [LinearEquiv.map_smul, Finsupp.smul_apply, RingHom.id_apply] }
          change coord_i (L_g (bA₁ j)) = res_V (M₀_mat i j)
          rw [hcol, map_sum, Finset.sum_eq_single i]
          · rw [LinearMap.map_smul, smul_eq_mul]
            change res_V (M₀_mat i j) * (bA₁.repr (bA₁ i)) i = res_V (M₀_mat i j)
            rw [Module.Basis.repr_self, Finsupp.single_eq_same, mul_one]
          · intro k _ hki
            rw [LinearMap.map_smul, smul_eq_mul]
            change res_V (M₀_mat k j) * (bA₁.repr (bA₁ k)) i = 0
            rw [Module.Basis.repr_self]
            simp only [Finsupp.single_apply, hki, hki.symm, ↓reduceIte, mul_zero]
          · intro hi_not
            exact absurd (Finset.mem_univ i) hi_not
        rw [hmat_eq]
        exact (RingHom.map_det res_V M₀_mat).symm

      
      have hbasic_g₁ : C_bar.left.basicOpen g₁ = U₁ ⊓ W₂ := by
        ext x
        constructor
        · intro hx_b
          have hx_U₁ : x ∈ U₁ := C_bar.left.basicOpen_le g₁ hx_b
          refine ⟨hx_U₁, ?_⟩
          intro hxP
          have hx_eq : x = P₀.1 := hxP
          let q₁ : PrimeSpectrum A₁ := hAff_U₁.primeIdealOf ⟨x, hx_U₁⟩
          have hq₁_not : g₁ ∉ q₁.asIdeal := by
            have hmem : q₁ ∈ (TopologicalSpace.Opens.map hAff_U₁.fromSpec.base).obj
                (C_bar.left.basicOpen g₁) := by
              change hAff_U₁.fromSpec.base q₁ ∈ C_bar.left.basicOpen g₁
              rwa [hAff_U₁.fromSpec_primeIdealOf ⟨x, hx_U₁⟩]
            rwa [hAff_U₁.fromSpec_preimage_basicOpen g₁] at hmem
          have hSpec_id :=
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
              (CategoryTheory.CategoryStruct.id C_bar.left) hAff_U hAff_U₁ hU₁_le
          have hid_app :
              (CategoryTheory.CategoryStruct.id C_bar.left).appLE U_chart U₁ hU₁_le =
                C_bar.left.presheaf.map (CategoryTheory.homOfLE hU₁_le).op := by
            simp only [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.id_app]
            exact CategoryTheory.Category.id_comp _
          rw [hid_app, CategoryTheory.Category.comp_id] at hSpec_id
          let q_U : PrimeSpectrum A :=
            (AlgebraicGeometry.Spec.map
              (C_bar.left.presheaf.map (CategoryTheory.homOfLE hU₁_le).op)).base q₁
          have hqU_pt : hAff_U.fromSpec.base q_U = P₀.1 :=
            ((congrArg (fun g => g.base q₁) hSpec_id).trans
              (hAff_U₁.fromSpec_primeIdealOf ⟨x, hx_U₁⟩)).trans hx_eq
          have hp_eq : q_U = p_P :=
            hAff_U.fromSpec.isOpenEmbedding.injective
              (hqU_pt.trans (hAff_U.fromSpec_primeIdealOf ⟨P₀.1, hP_in_U⟩).symm)
          have hg₀_in_P : g₀ ∈ P_id :=
            (hg₀_iso P_id inferInstance
              (by rw [← Ideal.mem_comap, hOver]; exact hb₀_not_mQ)).mpr rfl
          have hg₁_in_q₁ : g₁ ∈ q₁.asIdeal := by
            change g₀ ∈ Ideal.comap res_U q₁.asIdeal
            have h_id := congrArg PrimeSpectrum.asIdeal hp_eq
            change Ideal.comap res_U q₁.asIdeal = P_id at h_id
            rwa [h_id]
          exact hq₁_not hg₁_in_q₁
        · rintro ⟨hx_U₁, hx_ne_P⟩
          let q₁ : PrimeSpectrum A₁ := hAff_U₁.primeIdealOf ⟨x, hx_U₁⟩
          have hSpec_id :=
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
              (CategoryTheory.CategoryStruct.id C_bar.left) hAff_U hAff_U₁ hU₁_le
          have hid_app :
              (CategoryTheory.CategoryStruct.id C_bar.left).appLE U_chart U₁ hU₁_le =
                C_bar.left.presheaf.map (CategoryTheory.homOfLE hU₁_le).op := by
            simp only [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.id_app]
            exact CategoryTheory.Category.id_comp _
          rw [hid_app, CategoryTheory.Category.comp_id] at hSpec_id
          let q_U : PrimeSpectrum A :=
            (AlgebraicGeometry.Spec.map
              (C_bar.left.presheaf.map (CategoryTheory.homOfLE hU₁_le).op)).base q₁
          have hqU_pt : hAff_U.fromSpec.base q_U = x :=
            (congrArg (fun g => g.base q₁) hSpec_id).trans
              (hAff_U₁.fromSpec_primeIdealOf ⟨x, hx_U₁⟩)
          have hφb₀_not : φ b₀ ∉ q_U.asIdeal := by
            have hmem : q_U ∈ (TopologicalSpace.Opens.map hAff_U.fromSpec.base).obj
                (C_bar.left.basicOpen (φ b₀)) := by
              change hAff_U.fromSpec.base q_U ∈ C_bar.left.basicOpen (φ b₀)
              rw [hqU_pt, ← hU₁_eq]
              exact hx_U₁
            rwa [hAff_U.fromSpec_preimage_basicOpen (φ b₀)] at hmem
          have hg₁_not : g₁ ∉ q₁.asIdeal := by
            intro hg₁_in
            have hg₀_in : g₀ ∈ q_U.asIdeal := hg₁_in
            have hqU_eq_P : q_U.asIdeal = P_id := (hg₀_iso q_U.asIdeal q_U.isPrime hφb₀_not).mp hg₀_in
            have hqU_eq : q_U = p_P := PrimeSpectrum.ext hqU_eq_P
            apply hx_ne_P
            change x = P₀.1
            rw [← hqU_pt, hqU_eq, hAff_U.fromSpec_primeIdealOf ⟨P₀.1, hP_in_U⟩]
          have hmem_b : q₁ ∈ (TopologicalSpace.Opens.map hAff_U₁.fromSpec.base).obj
              (C_bar.left.basicOpen g₁) := by
            rw [hAff_U₁.fromSpec_preimage_basicOpen g₁]
            exact hg₁_not
          change hAff_U₁.fromSpec.base q₁ ∈ C_bar.left.basicOpen g₁ at hmem_b
          rwa [hAff_U₁.fromSpec_primeIdealOf ⟨x, hx_U₁⟩] at hmem_b

      have hUnit_g₁ :
          IsUnit ((C_bar.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ W₂ ≤ U₁)).op).hom g₁) := by
        let e_b : C_bar.left.basicOpen g₁ ≅ U₁ ⊓ W₂ := CategoryTheory.eqToIso hbasic_g₁
        have h1 : IsUnit ((C_bar.left.presheaf.map
            (CategoryTheory.homOfLE (C_bar.left.basicOpen_le g₁)).op).hom g₁) :=
          C_bar.left.toRingedSpace.isUnit_res_basicOpen g₁
        have hcomp :
            (C_bar.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ W₂ ≤ U₁)).op).hom g₁ =
              (C_bar.left.presheaf.map e_b.inv.op).hom
                ((C_bar.left.presheaf.map
                  (CategoryTheory.homOfLE (C_bar.left.basicOpen_le g₁)).op).hom g₁) := by
          change _ = (C_bar.left.presheaf.map
            (CategoryTheory.homOfLE (C_bar.left.basicOpen_le g₁)).op ≫
              C_bar.left.presheaf.map e_b.inv.op).hom g₁
          rw [← C_bar.left.presheaf.map_comp, ← op_comp]
          rfl
        rw [hcomp]
        exact h1.map (C_bar.left.presheaf.map e_b.inv.op).hom
      let u_W : Units ↑(C_bar.left.presheaf.obj (Opposite.op (U₁ ⊓ W₂))) := hUnit_g₁.unit
      let u_U : Units ↑(C_bar.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂))) :=
        Units.map (C_bar.left.presheaf.map
          (CategoryTheory.homOfLE (inf_le_inf (le_refl U₁) hU₂_le_W₂)).op).hom.toMonoidHom u_W
      have hu_U_val :
          (u_U : ↑(C_bar.left.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) =
            (C_bar.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g₁ := by
        change (C_bar.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_inf (le_refl U₁) hU₂_le_W₂)).op).hom
              (u_W : ↑(C_bar.left.presheaf.obj (Opposite.op (U₁ ⊓ W₂)))) = _
        rw [IsUnit.unit_spec hUnit_g₁]
        change (C_bar.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ W₂ ≤ U₁)).op ≫
          C_bar.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_inf (le_refl U₁) hU₂_le_W₂)).op).hom g₁ = _
        rw [← C_bar.left.presheaf.map_comp, ← op_comp]
        rfl

      have hbasic_det₁ : P1_over.left.basicOpen det₁ = V₁ ⊓ V₂ := by
        ext y
        constructor
        · intro hy_b
          have hy_V₁ : y ∈ V₁ := P1_over.left.basicOpen_le det₁ hy_b
          refine ⟨hy_V₁, ?_⟩
          intro hyQ
          have hy_eq : y = Q₀.1 := hyQ
          let q₁ : PrimeSpectrum B₁ := hAff_V₁.primeIdealOf ⟨y, hy_V₁⟩
          have hq₁_not : det₁ ∉ q₁.asIdeal := by
            have hmem : q₁ ∈ (TopologicalSpace.Opens.map hAff_V₁.fromSpec.base).obj
                (P1_over.left.basicOpen det₁) := by
              change hAff_V₁.fromSpec.base q₁ ∈ P1_over.left.basicOpen det₁
              rwa [hAff_V₁.fromSpec_primeIdealOf ⟨y, hy_V₁⟩]
            rwa [hAff_V₁.fromSpec_preimage_basicOpen det₁] at hmem
          have hSpec_id :=
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
              (CategoryTheory.CategoryStruct.id P1_over.left) hAff_V hAff_V₁ hV₁_le
          have hid_app :
              (CategoryTheory.CategoryStruct.id P1_over.left).appLE V_chart V₁ hV₁_le =
                P1_over.left.presheaf.map (CategoryTheory.homOfLE hV₁_le).op := by
            simp only [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.id_app]
            exact CategoryTheory.Category.id_comp _
          rw [hid_app, CategoryTheory.Category.comp_id] at hSpec_id
          let q_V : PrimeSpectrum B :=
            (AlgebraicGeometry.Spec.map
              (P1_over.left.presheaf.map (CategoryTheory.homOfLE hV₁_le).op)).base q₁
          have hqV_pt : hAff_V.fromSpec.base q_V = Q₀.1 :=
            ((congrArg (fun g => g.base q₁) hSpec_id).trans
              (hAff_V₁.fromSpec_primeIdealOf ⟨y, hy_V₁⟩)).trans hy_eq
          have hp_eq : q_V = p_Q :=
            hAff_V.fromSpec.isOpenEmbedding.injective
              (hqV_pt.trans (hAff_V.fromSpec_primeIdealOf ⟨Q₀.1, hQ_in_V⟩).symm)
          have hΔ_in_mQ : Δ ∈ m_Q := (hdet_iso m_Q inferInstance hb₀_not_mQ).mpr rfl
          have hdet₁_in_q₁ : det₁ ∈ q₁.asIdeal := by
            change Δ ∈ Ideal.comap res_V q₁.asIdeal
            have h_id := congrArg PrimeSpectrum.asIdeal hp_eq
            change Ideal.comap res_V q₁.asIdeal = m_Q at h_id
            rwa [h_id]
          exact hq₁_not hdet₁_in_q₁
        · rintro ⟨hy_V₁, hy_ne_Q⟩
          let q₁ : PrimeSpectrum B₁ := hAff_V₁.primeIdealOf ⟨y, hy_V₁⟩
          have hSpec_id :=
            AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
              (CategoryTheory.CategoryStruct.id P1_over.left) hAff_V hAff_V₁ hV₁_le
          have hid_app :
              (CategoryTheory.CategoryStruct.id P1_over.left).appLE V_chart V₁ hV₁_le =
                P1_over.left.presheaf.map (CategoryTheory.homOfLE hV₁_le).op := by
            simp only [AlgebraicGeometry.Scheme.Hom.appLE, AlgebraicGeometry.Scheme.Hom.id_app]
            exact CategoryTheory.Category.id_comp _
          rw [hid_app, CategoryTheory.Category.comp_id] at hSpec_id
          let q_V : PrimeSpectrum B :=
            (AlgebraicGeometry.Spec.map
              (P1_over.left.presheaf.map (CategoryTheory.homOfLE hV₁_le).op)).base q₁
          have hqV_pt : hAff_V.fromSpec.base q_V = y :=
            (congrArg (fun g => g.base q₁) hSpec_id).trans
              (hAff_V₁.fromSpec_primeIdealOf ⟨y, hy_V₁⟩)
          have hb₀_not : b₀ ∉ q_V.asIdeal := by
            have hmem : q_V ∈ (TopologicalSpace.Opens.map hAff_V.fromSpec.base).obj
                (P1_over.left.basicOpen b₀) := by
              change hAff_V.fromSpec.base q_V ∈ P1_over.left.basicOpen b₀
              rw [hqV_pt]
              exact hy_V₁
            rwa [hAff_V.fromSpec_preimage_basicOpen b₀] at hmem
          have hdet₁_not : det₁ ∉ q₁.asIdeal := by
            intro hdet₁_in
            have hΔ_in : Δ ∈ q_V.asIdeal := hdet₁_in
            have hqV_eq_mQ : q_V.asIdeal = m_Q :=
              (hdet_iso q_V.asIdeal q_V.isPrime hb₀_not).mp hΔ_in
            have hqV_eq : q_V = p_Q := PrimeSpectrum.ext hqV_eq_mQ
            apply hy_ne_Q
            change y = Q₀.1
            rw [← hqV_pt, hqV_eq, hAff_V.fromSpec_primeIdealOf ⟨Q₀.1, hQ_in_V⟩]
          have hmem_b : q₁ ∈ (TopologicalSpace.Opens.map hAff_V₁.fromSpec.base).obj
              (P1_over.left.basicOpen det₁) := by
            rw [hAff_V₁.fromSpec_preimage_basicOpen det₁]
            exact hdet₁_not
          change hAff_V₁.fromSpec.base q₁ ∈ P1_over.left.basicOpen det₁ at hmem_b
          rwa [hAff_V₁.fromSpec_primeIdealOf ⟨y, hy_V₁⟩] at hmem_b

      have hUnit_det₁ :
          IsUnit ((P1_over.left.presheaf.map
            (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom det₁) := by
        let e_b : P1_over.left.basicOpen det₁ ≅ V₁ ⊓ V₂ := CategoryTheory.eqToIso hbasic_det₁
        have h1 : IsUnit ((P1_over.left.presheaf.map
            (CategoryTheory.homOfLE (P1_over.left.basicOpen_le det₁)).op).hom det₁) :=
          P1_over.left.toRingedSpace.isUnit_res_basicOpen det₁
        have hcomp :
            (P1_over.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom det₁ =
              (P1_over.left.presheaf.map e_b.inv.op).hom
                ((P1_over.left.presheaf.map
                  (CategoryTheory.homOfLE (P1_over.left.basicOpen_le det₁)).op).hom det₁) := by
          change _ = (P1_over.left.presheaf.map
            (CategoryTheory.homOfLE (P1_over.left.basicOpen_le det₁)).op ≫
              P1_over.left.presheaf.map e_b.inv.op).hom det₁
          rw [← P1_over.left.presheaf.map_comp, ← op_comp]
          rfl
        rw [hcomp]
        exact h1.map (P1_over.left.presheaf.map e_b.inv.op).hom
      let u_V : Units ↑(P1_over.left.presheaf.obj (Opposite.op (V₁ ⊓ V₂))) := hUnit_det₁.unit
      have hu_V_val :
          (u_V : ↑(P1_over.left.presheaf.obj (Opposite.op (V₁ ⊓ V₂)))) =
            (P1_over.left.presheaf.map
              (CategoryTheory.homOfLE (inf_le_left : V₁ ⊓ V₂ ≤ V₁)).op).hom
              (((LinearMap.toMatrix bA₁ bA₁) L_g).det) := by
        rw [hdet₁_eq]
        exact IsUnit.unit_spec hUnit_det₁

      
      have hspan_stalkP :
          Ideal.span ({(C_bar.left.presheaf.germ U₁ P₀.1 hP_in_U₁).hom g₁} :
              Set ↑(C_bar.left.presheaf.stalk P₀.1)) =
            IsLocalRing.maximalIdeal ↑(C_bar.left.presheaf.stalk P₀.1) := by
        have hgerm_eq :
            (C_bar.left.presheaf.germ U₁ P₀.1 hP_in_U₁).hom g₁ =
              algebraMap A ↑(C_bar.left.presheaf.stalk (p_pt : ↥C_bar.left)) g₀ := by
          rw [TopCat.Presheaf.stalk_open_algebraMap C_bar.left.presheaf p_pt]
          exact C_bar.left.presheaf.germ_res_apply (CategoryTheory.homOfLE hU₁_le) P₀.1 hP_in_U₁ g₀
        rw [hgerm_eq]
        exact hSpan_to_loc P_id g₀ hg₀_span
      have hspan_stalkQ :
          Ideal.span ({(P1_over.left.presheaf.germ V₁ Q₀.1 hQ_in_V₁).hom det₁} :
              Set ↑(P1_over.left.presheaf.stalk Q₀.1)) =
            IsLocalRing.maximalIdeal ↑(P1_over.left.presheaf.stalk Q₀.1) := by
        have hgerm_eq :
            (P1_over.left.presheaf.germ V₁ Q₀.1 hQ_in_V₁).hom det₁ =
              algebraMap B ↑(P1_over.left.presheaf.stalk (q_pt : ↥P1_over.left)) Δ := by
          rw [TopCat.Presheaf.stalk_open_algebraMap P1_over.left.presheaf q_pt]
          exact P1_over.left.presheaf.germ_res_apply (CategoryTheory.homOfLE hV₁_le) Q₀.1 hQ_in_V₁ Δ
        rw [hgerm_eq]
        exact hSpan_to_loc m_Q Δ hdet_span

      obtain ⟨s₁_C, f_q_C, hs₁_C, hfq_C1, hfq_C2, hdiv_fq_C⟩ :=
        hUnif_C U₁ W₂ hcov_UW P₀ hP_in_U₁ rfl g₁ u_W (IsUnit.unit_spec hUnit_g₁) hspan_stalkP
      have hMV_C : δ_MV C_bar U₁ W₂ hcov_UW u_W = cl_C P₀ := by
        rw [hMV_se C_bar U₁ W₂ hcov_UW u_W (weilEtaleKSheaf C_bar.left) Q_C
          ι_div_C π_div_C h0_div_C hSE_C s₁_C f_q_C hs₁_C hfq_C1 hfq_C2]
        have hmk_eq : CategoryTheory.Abelian.Ext.mk₀ f_q_C = e_div_C.symm (Finsupp.single P₀ 1) :=
          e_div_C.injective (hdiv_fq_C.trans (e_div_C.apply_symm_apply _).symm)
        change (CategoryTheory.Abelian.Ext.mk₀ f_q_C).comp hSE_C.extClass (Nat.zero_add 1) =
          (e_div_C.symm (Finsupp.single P₀ 1)).comp hSE_C.extClass (Nat.zero_add 1)
        rw [hmk_eq]

      obtain ⟨s₁_P1, f_q_P1, hs₁_P1, hfq_P11, hfq_P12, hdiv_fq_P1⟩ :=
        hUnif_P1 V₁ V₂ hcov_V Q₀ hQ_in_V₁ rfl det₁ u_V (IsUnit.unit_spec hUnit_det₁) hspan_stalkQ
      have hMV_P1 : δ_MV P1_over V₁ V₂ hcov_V u_V = cl_P1 Q₀ := by
        rw [hMV_se P1_over V₁ V₂ hcov_V u_V (weilEtaleKSheaf P1_over.left) Q_P1
          ι_div_P1 π_div_P1 h0_div_P1 hSE_P1 s₁_P1 f_q_P1 hs₁_P1 hfq_P11 hfq_P12]
        have hmk_eq : CategoryTheory.Abelian.Ext.mk₀ f_q_P1 = e_div_P1.symm (Finsupp.single Q₀ 1) :=
          e_div_P1.injective (hdiv_fq_P1.trans (e_div_P1.apply_symm_apply _).symm)
        change (CategoryTheory.Abelian.Ext.mk₀ f_q_P1).comp hSE_P1.extClass (Nat.zero_add 1) =
          (e_div_P1.symm (Finsupp.single Q₀ 1)).comp hSE_P1.extClass (Nat.zero_add 1)
        rw [hmk_eq]

      have hMV_U : δ_MV C_bar U₁ U₂ hcov_U u_U = δ_MV C_bar U₁ W₂ hcov_UW u_W :=
        hMV_ref C_bar U₁ W₂ U₁ U₂ hcov_UW hcov_U (le_refl U₁) hU₂_le_W₂ u_W
      calc
        f_gm (cl_C P₀)
          = f_gm (δ_MV C_bar U₁ W₂ hcov_UW u_W) := by rw [hMV_C]
        _ = f_gm (δ_MV C_bar U₁ U₂ hcov_U u_U) := by rw [hMV_U]
        _ = δ_MV P1_over V₁ V₂ hcov_V u_V :=
              hf_gm_MV V₁ V₂ hcov_V hcov_U hAff_V₁ hAff_U₁ A₁ inferInstance inferInstance
                bA₁ (AddEquiv.refl A₁) (fun _ _ => rfl) g₁ L_g (fun _ => rfl) u_U u_V
                hu_U_val hu_V_val
        _ = cl_P1 Q₀ := hMV_P1

    
    intro w
    have hSubH2 : Subsingleton ((weilEtaleGmSheaf C_bar.left).H 2) :=
      (hGmCurve C_bar hProjC).2.2 2 (le_refl 2)
    obtain ⟨ξ, rfl⟩ := hκ_surj C_bar hSubH2 w
    rw [hf_gm₁_κ ξ, hf_gm₂_κ ξ]
    congr 1
    have hEqOnGen :
        Set.range cl_C ⊆ (AddMonoidHom.eqLocus f_gm₁ f_gm₂ : Set ((weilEtaleGmSheaf C_bar.left).H 1)) := by
      rintro _ ⟨P₀, rfl⟩
      obtain ⟨Q₁, hQ₁⟩ := hPushPt d₁ hd₁ u_bar₁ hu_over₁ hFree₁ f_gm₁ hf_gm₁_MV P₀
      obtain ⟨Q₂, hQ₂⟩ := hPushPt d₂ hd₂ u_bar₂ hu_over₂ hFree₂ f_gm₂ hf_gm₂_MV P₀
      change f_gm₁ (cl_C P₀) = f_gm₂ (cl_C P₀)
      rw [hQ₁, hQ₂, hcl_P1_eq Q₁ Q₂]
    exact ((AddSubgroup.closure_le (AddMonoidHom.eqLocus f_gm₁ f_gm₂)).mpr hEqOnGen)
      (hcl_C_span ξ)

theorem weil_polyP1_pinned_last_coord_norm_invariance (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar k)
    (ζ : ℕ → kˣ)
    (hPrim : ∀ r : ℕ, IsPrimitiveRoot ((ζ r : kˣ) : k) (ℓ ^ r))
    (hPow : ∀ r : ℕ, (ζ (r + 1)) ^ ℓ = ζ r)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff)
    (tr_Pd : ∀ (δ r : ℕ),
      weilEtaleTorsionH (weilPolyP1Over k δ).left (ℓ ^ r) (2 * δ) →+ ZMod (ℓ ^ r))
    (hBij : ∀ (δ r : ℕ), Function.Bijective (tr_Pd δ r))
    (hTrace : WeilIsPolyP1PinnedKummerLerayTrace k ℓ ζ ι_P1 tr_Pd)
    (m : ℕ)
    (U₁ U₂ : (weilPolyP1Over k (m + 1)).left.Etale)
    (u₁ : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₁).left
      (weilAffineSpaceOver k (m + 1)).left)
    (u₂ : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₂).left
      (weilAffineSpaceOver k (m + 1)).left)
    (e : CategoryTheory.Iso
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₁).left
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₂).left)
    (h : WeilIsAffineRoofIso k (weilPolyP1Over k (m + 1)) (weilPolyP1Over k (m + 1)) U₁ U₂ e) :
    AlgebraicGeometry.Etale u₁ →
    AlgebraicGeometry.Etale u₂ →
    CategoryTheory.CategoryStruct.comp u₁ (ι_aff (m + 1)) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₁).hom →
    CategoryTheory.CategoryStruct.comp u₂ (ι_aff (m + 1)) =
      ((AlgebraicGeometry.Scheme.Etale.forget (weilPolyP1Over k (m + 1)).left).obj U₂).hom →
    (∀ (i : Fin (m + 1)), i ≠ Fin.last m →
      let pr_i : Quiver.Hom (weilAffineSpaceOver k (m + 1)).left
          (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (Polynomial.aeval (MvPolynomial.X i : MvPolynomial (Fin (m + 1)) k)).toRingHom)
      CategoryTheory.CategoryStruct.comp u₁ pr_i =
        CategoryTheory.CategoryStruct.comp e.hom
          (CategoryTheory.CategoryStruct.comp u₂ pr_i)) →
    ∀ (r : ℕ) (z : weilEtaleLocalTorsionH (weilPolyP1Over k (m + 1)).left (ℓ ^ r) U₁ (2 * (m + 1))),
      tr_Pd (m + 1) r
        (weilEtaleLocalTorsionCounitH (weilPolyP1Over k (m + 1)).left (ℓ ^ r) U₁ (2 * (m + 1)) z) =
      tr_Pd (m + 1) r
        (weilEtaleLocalTorsionCounitH (weilPolyP1Over k (m + 1)).left (ℓ ^ r) U₂ (2 * (m + 1))
          (Ψ (weilPolyP1Over k (m + 1)) (weilPolyP1Over k (m + 1)) U₁ U₂ e h r (2 * (m + 1)) z)) :=
by
  classical
  intro hu₁ hu₂ hcomp₁ hcomp₂ hagree r z
  cases r with
  | zero =>
    have hSub : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
    exact @Subsingleton.elim _ hSub _ _
  | succ r₀ =>
    have hr : 1 ≤ r₀ + 1 := Nat.succ_le_succ (Nat.zero_le r₀)
    have hPrime : Nat.Prime ℓ := Fact.out
    have hℓ_ne : (ℓ : k) ≠ 0 := by
      intro h0
      have hdvd : ringChar k ∣ ℓ := (CharP.cast_eq_zero_iff k (ringChar k) ℓ).mp h0
      rcases CharP.char_is_prime_or_zero k (ringChar k) with hp | hz
      · rcases (Nat.dvd_prime hPrime).mp hdvd with h1 | heq
        · exact hp.ne_one h1
        · exact hℓ heq.symm
      · rw [hz, zero_dvd_iff] at hdvd
        exact hPrime.ne_zero hdvd
    have hn : 2 ≤ ℓ ^ (r₀ + 1) :=
      le_trans hPrime.two_le (le_self_pow hPrime.one_le (Nat.succ_ne_zero r₀))
    have hUnit : IsUnit ((ℓ ^ (r₀ + 1) : ℕ) : k) := by
      rw [Nat.cast_pow]
      exact Ne.isUnit (pow_ne_zero (r₀ + 1) hℓ_ne)
    have hPBC : WeilProperModPrimeBaseChangeHolds k ℓ :=
      weil_etale_proper_base_change_mod_prime k ℓ hℓ_ne
    have hDetPkg :=
      (weil_top_deg_affine_finite_free_det_pushforward k (ℓ ^ (r₀ + 1)) hn hUnit
        (ζ (r₀ + 1)) (hPrim (r₀ + 1))).1
    have hGmCurve :
        ∀ (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          [AlgebraicGeometry.IsIntegral C₀.left],
          IsProjectiveOverField k C₀ →
          ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom],
            (∀ x : (weilEtaleGmSheaf C₀.left).H 0,
              ∃ y : (weilEtaleGmSheaf C₀.left).H 0, ℓ • y = x) ∧
            Nonempty ((weilEtaleGmSheaf C₀.left).H 1 ≃+ weilCurveClGroup C₀.left) ∧
            (∀ q : ℕ, 2 ≤ q → Subsingleton ((weilEtaleGmSheaf C₀.left).H q)) :=
      fun C₀ _ hProjC _ =>
        weil_etale_smooth_proj_curve_gm_cohomology_and_divisor_iso k C₀ hProjC ℓ
    refine weil_polyP1_last_coord_fibered_reduction_to_curve k ℓ hℓ (r₀ + 1) hr ζ hPrim hPow
      Ψ hΨ ι_P1 ι_aff hCoord tr_Pd hBij hTrace hPBC ?_ m U₁ U₂ u₁ u₂ e h
      hu₁ hu₂ hcomp₁ hcomp₂ hagree z
    intro C hAffC hIntC v₁ v₂ hv₁ hv₂ hv_over hEt₁ hEt₂
    dsimp only
    intro hRoof_C z_C
    obtain ⟨C_bar, j, d₁, d₂, u_bar₁, u_bar₂,
      hIntCb, hProjCb, hPropCb, hSmCb, hDimCb, hOpen_j,
      hd₁, hd₂, hu_over₁, hu_over₂, hFree₁, hFree₂, hj_u₁, hj_u₂⟩ :=
      weil_polyP1_last_coord_curve_biprojective_completion k ι_P1 ι_aff hCoord
        C v₁ v₂ hv₁ hv₂ hv_over
    letI : AlgebraicGeometry.IsIntegral C_bar.left := hIntCb
    letI : AlgebraicGeometry.IsProper C_bar.hom := hPropCb
    letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom := hSmCb
    letI : AlgebraicGeometry.IsOpenImmersion j := hOpen_j
    have hEt_j : AlgebraicGeometry.Etale j := inferInstance
    let P1_over := weilProjectiveSpaceOver k 1
    obtain ⟨u_shriek₁, hu_sh₁⟩ :=
      (hDetPkg d₁ 2 hd₁ C_bar P1_over u_bar₁ hu_over₁ hFree₁).1
    obtain ⟨u_shriek₂, hu_sh₂⟩ :=
      (hDetPkg d₂ 2 hd₂ C_bar P1_over u_bar₂ hu_over₂ hFree₂).1
    let U_j : C_bar.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j hEt_j
    let U_C1 : P1_over.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.comp v₁ ι_P1) hEt₁
    let U_C2 : P1_over.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.comp v₂ ι_P1) hEt₂
    have hRoof₁ : WeilIsAffineRoofIso k C_bar P1_over U_j U_C1 (CategoryTheory.Iso.refl C) := by
      refine ⟨hPropCb, hCoord.1, hAffC, ?_⟩
      change 𝟙 C ≫ ((v₁ ≫ ι_P1) ≫ P1_over.hom) = j ≫ C_bar.hom
      rw [CategoryTheory.Category.id_comp, ← hj_u₁, CategoryTheory.Category.assoc, hu_over₁]
    have hRoof₂ : WeilIsAffineRoofIso k C_bar P1_over U_j U_C2 (CategoryTheory.Iso.refl C) := by
      refine ⟨hPropCb, hCoord.1, hAffC, ?_⟩
      change 𝟙 C ≫ ((v₂ ≫ ι_P1) ≫ P1_over.hom) = j ≫ C_bar.hom
      rw [CategoryTheory.Category.id_comp, ← hj_u₂, CategoryTheory.Category.assoc, hu_over₂]
    let e_refl : CategoryTheory.Iso C C := CategoryTheory.Iso.refl C
    have he_trans : CategoryTheory.Iso.trans e_refl e_refl = e_refl := by
      ext1
      exact CategoryTheory.Category.id_comp (𝟙 C)
    have hRoof₁₃ :
        WeilIsAffineRoofIso k C_bar P1_over U_j U_C2 (CategoryTheory.Iso.trans e_refl e_refl) :=
      he_trans.symm ▸ hRoof₂
    let y : weilEtaleLocalTorsionH C_bar.left (ℓ ^ (r₀ + 1)) U_j 2 :=
      (Ψ C_bar P1_over U_j U_C1 e_refl hRoof₁ (r₀ + 1) 2).symm z_C
    have hy₁ : Ψ C_bar P1_over U_j U_C1 e_refl hRoof₁ (r₀ + 1) 2 y = z_C :=
      (Ψ C_bar P1_over U_j U_C1 e_refl hRoof₁ (r₀ + 1) 2).apply_symm_apply z_C
    have hΨ_eq :
        ∀ (eA eB : CategoryTheory.Iso
            ((AlgebraicGeometry.Scheme.Etale.forget C_bar.left).obj U_j).left
            ((AlgebraicGeometry.Scheme.Etale.forget P1_over.left).obj U_C2).left)
          (hA : WeilIsAffineRoofIso k C_bar P1_over U_j U_C2 eA)
          (hB : WeilIsAffineRoofIso k C_bar P1_over U_j U_C2 eB),
          eA = eB →
          Ψ C_bar P1_over U_j U_C2 eA hA (r₀ + 1) 2 y =
            Ψ C_bar P1_over U_j U_C2 eB hB (r₀ + 1) 2 y := by
      intro eA eB hA hB hEq
      subst hEq
      rfl
    have hTrans :
        Ψ P1_over P1_over U_C1 U_C2 e_refl hRoof_C (r₀ + 1) 2 z_C =
          Ψ C_bar P1_over U_j U_C2 e_refl hRoof₂ (r₀ + 1) 2 y := by
      have hcomp_y :=
        DFunLike.congr_fun
          (hΨ.2.1 C_bar P1_over P1_over U_j U_C1 U_C2 e_refl e_refl
            hRoof₁ hRoof_C hRoof₁₃ (r₀ + 1) 2) y
      change Ψ P1_over P1_over U_C1 U_C2 e_refl hRoof_C (r₀ + 1) 2
          (Ψ C_bar P1_over U_j U_C1 e_refl hRoof₁ (r₀ + 1) 2 y) =
        Ψ C_bar P1_over U_j U_C2 (CategoryTheory.Iso.trans e_refl e_refl) hRoof₁₃ (r₀ + 1) 2 y
          at hcomp_y
      rw [hy₁] at hcomp_y
      exact hcomp_y.trans (hΨ_eq _ _ hRoof₁₃ hRoof₂ he_trans)
    obtain ⟨hCounit₁, hCounit₂, hShEq⟩ :=
      weil_polyP1_last_coord_curve_det_norm_degree_one k ℓ hℓ (r₀ + 1) hr
        (ζ (r₀ + 1)) (hPrim (r₀ + 1)) Ψ hΨ ι_P1 ι_aff hCoord hPBC hGmCurve
        C_bar hProjCb hDimCb C j hOpen_j hEt_j v₁ v₂ hv₁ hv₂ hEt₁ hEt₂
        d₁ d₂ hd₁ hd₂ u_bar₁ u_bar₂ hu_over₁ hu_over₂ hFree₁ hFree₂ hj_u₁ hj_u₂
        u_shriek₁ u_shriek₂ hu_sh₁ hu_sh₂
    calc
      weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ (r₀ + 1)) U_C1 2 z_C
        = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ (r₀ + 1)) U_C1 2
            (Ψ C_bar P1_over U_j U_C1 e_refl hRoof₁ (r₀ + 1) 2 y) := by rw [hy₁]
      _ = u_shriek₁ (weilEtaleLocalTorsionCounitH C_bar.left (ℓ ^ (r₀ + 1)) U_j 2 y) :=
            hCounit₁ hRoof₁ y
      _ = u_shriek₂ (weilEtaleLocalTorsionCounitH C_bar.left (ℓ ^ (r₀ + 1)) U_j 2 y) :=
            hShEq _
      _ = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ (r₀ + 1)) U_C2 2
            (Ψ C_bar P1_over U_j U_C2 e_refl hRoof₂ (r₀ + 1) 2 y) :=
            (hCounit₂ hRoof₂ y).symm
      _ = weilEtaleLocalTorsionCounitH P1_over.left (ℓ ^ (r₀ + 1)) U_C2 2
            (Ψ P1_over P1_over U_C1 U_C2 e_refl hRoof_C (r₀ + 1) 2 z_C) := by rw [hTrans]

theorem weil_polyP1_perm_coord_aut_and_affine_compat (k : Type u) [Field k] [IsAlgClosed k]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff)
    (m : ℕ) (j : Fin (m + 1)) :
    ∃ (α_j : CategoryTheory.Iso
        (weilAffineSpaceOver k (m + 1)).left (weilAffineSpaceOver k (m + 1)).left)
      (β_j : CategoryTheory.Iso
        (weilPolyP1Over k (m + 1)).left (weilPolyP1Over k (m + 1)).left),
      CategoryTheory.CategoryStruct.comp β_j.hom (weilPolyP1Over k (m + 1)).hom =
        (weilPolyP1Over k (m + 1)).hom ∧
      CategoryTheory.CategoryStruct.comp α_j.hom (ι_aff (m + 1)) =
        CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) β_j.hom ∧
      (∀ i : Fin (m + 1),
        let pr : Fin (m + 1) → Quiver.Hom (weilAffineSpaceOver k (m + 1)).left
            (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))) :=
          fun idx => AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (Polynomial.aeval (MvPolynomial.X idx : MvPolynomial (Fin (m + 1)) k)).toRingHom)
        CategoryTheory.CategoryStruct.comp α_j.hom (pr i) = pr (Equiv.swap j (Fin.last m) i)) ∧
      (j = Fin.last m →
        β_j = CategoryTheory.Iso.refl (weilPolyP1Over k (m + 1)).left) ∧
      (j ≠ Fin.last m →
        ∃ (ν_neg : CategoryTheory.Iso
            (weilProjectiveSpaceOver k 1).left (weilProjectiveSpaceOver k 1).left)
          (α_neg : CategoryTheory.Iso
            (weilAffineSpaceOver k (m + 1)).left (weilAffineSpaceOver k (m + 1)).left)
          (δ_neg : CategoryTheory.Iso
            (weilPolyP1Over k (m + 1)).left (weilPolyP1Over k (m + 1)).left)
          (α_E_lj α_E_jl α_X α_Y : CategoryTheory.Iso
            (weilAffineSpaceOver k (m + 1)).left (weilAffineSpaceOver k (m + 1)).left),
          CategoryTheory.CategoryStruct.comp ν_neg.hom (weilProjectiveSpaceOver k 1).hom =
            (weilProjectiveSpaceOver k 1).hom ∧
          CategoryTheory.CategoryStruct.comp α_neg.hom (weilAffineSpaceOver k (m + 1)).hom =
            (weilAffineSpaceOver k (m + 1)).hom ∧
          CategoryTheory.CategoryStruct.comp δ_neg.hom (weilPolyP1Over k (m + 1)).hom =
            (weilPolyP1Over k (m + 1)).hom ∧
          CategoryTheory.CategoryStruct.comp δ_neg.hom
            (CategoryTheory.Limits.pullback.fst
              (weilPolyP1Over k m).hom (weilProjectiveSpaceOver k 1).hom) =
            CategoryTheory.Limits.pullback.fst
              (weilPolyP1Over k m).hom (weilProjectiveSpaceOver k 1).hom ∧
          CategoryTheory.CategoryStruct.comp δ_neg.hom
            (CategoryTheory.Limits.pullback.snd
              (weilPolyP1Over k m).hom (weilProjectiveSpaceOver k 1).hom) =
            CategoryTheory.CategoryStruct.comp
              (CategoryTheory.Limits.pullback.snd
                (weilPolyP1Over k m).hom (weilProjectiveSpaceOver k 1).hom)
              ν_neg.hom ∧
          CategoryTheory.CategoryStruct.comp α_neg.hom (ι_aff (m + 1)) =
            CategoryTheory.CategoryStruct.comp (ι_aff (m + 1)) δ_neg.hom ∧
          CategoryTheory.CategoryStruct.comp α_E_lj.hom (weilAffineSpaceOver k (m + 1)).hom =
            (weilAffineSpaceOver k (m + 1)).hom ∧
          CategoryTheory.CategoryStruct.comp α_E_jl.hom (weilAffineSpaceOver k (m + 1)).hom =
            (weilAffineSpaceOver k (m + 1)).hom ∧
          CategoryTheory.CategoryStruct.comp α_X.hom (weilAffineSpaceOver k (m + 1)).hom =
            (weilAffineSpaceOver k (m + 1)).hom ∧
          CategoryTheory.CategoryStruct.comp α_Y.hom (weilAffineSpaceOver k (m + 1)).hom =
            (weilAffineSpaceOver k (m + 1)).hom ∧
          α_E_lj = CategoryTheory.Iso.trans α_X
            (CategoryTheory.Iso.trans α_Y
              (CategoryTheory.Iso.trans α_X.symm α_Y.symm)) ∧
          α_E_jl = CategoryTheory.Iso.trans α_j
            (CategoryTheory.Iso.trans α_E_lj α_j.symm) ∧
          α_j = CategoryTheory.Iso.trans α_E_jl
            (CategoryTheory.Iso.trans α_E_lj.symm
              (CategoryTheory.Iso.trans α_E_jl α_neg))) :=
by
  
  have hMat :
      ∃ (u_swap u_neg : (Matrix (Fin (m + 1)) (Fin (m + 1)) k)ˣ),
        (u_swap : Matrix (Fin (m + 1)) (Fin (m + 1)) k) =
          Matrix.of (fun i s => if s = Equiv.swap j (Fin.last m) i then 1 else 0) ∧
        (u_neg : Matrix (Fin (m + 1)) (Fin (m + 1)) k) =
          Matrix.diagonal (fun i => if i = Fin.last m then -1 else 1) ∧
        (j ≠ Fin.last m →
          ∃ (u_Elj u_Ejl u_X u_Y : (Matrix (Fin (m + 1)) (Fin (m + 1)) k)ˣ),
            u_Elj = u_Y⁻¹ * u_X⁻¹ * u_Y * u_X ∧
            u_Ejl = u_swap⁻¹ * u_Elj * u_swap ∧
            u_swap = u_neg * u_Ejl * u_Elj⁻¹ * u_Ejl) := by
    have h_ite_pos : ∀ {P : Prop} [Decidable P] {α : Type u} {a b : α},
        P → (if P then a else b) = a := by
      intro P _ α a b h
      split_ifs
      rfl
    have h_ite_neg : ∀ {P : Prop} [Decidable P] {α : Type u} {a b : α},
        ¬ P → (if P then a else b) = b := by
      intro P _ α a b h
      split_ifs
      rfl
    let ℓ_last : Fin (m + 1) := Fin.last m
    let σ : Equiv.Perm (Fin (m + 1)) := Equiv.swap j ℓ_last
    let P_swap : Matrix (Fin (m + 1)) (Fin (m + 1)) k :=
      Matrix.of (fun i s => if s = σ i then 1 else 0)
    have hP_swap_sq : P_swap * P_swap = 1 := by
      ext i t
      simp only [P_swap, Matrix.mul_apply, Matrix.of_apply, Matrix.one_apply]
      have hsum :
          (∑ s : Fin (m + 1), (if s = σ i then (1 : k) else 0) * (if t = σ s then 1 else 0)) =
          ∑ s : Fin (m + 1), (if s = σ i then (if t = σ s then (1 : k) else 0) else 0) := by
        refine Finset.sum_congr rfl fun s _ => ?_
        split_ifs <;> ring
      rw [hsum, Finset.sum_ite_eq', h_ite_pos (Finset.mem_univ (σ i))]
      have hσ_inv : σ (σ i) = i := Equiv.swap_apply_self j ℓ_last i
      rw [hσ_inv]
      by_cases hit : i = t
      · rw [h_ite_pos hit.symm, h_ite_pos hit]
      · have hti : t ≠ i := fun h => hit h.symm
        rw [h_ite_neg hti, h_ite_neg hit]
    let u_swap : (Matrix (Fin (m + 1)) (Fin (m + 1)) k)ˣ :=
      ⟨P_swap, P_swap, hP_swap_sq, hP_swap_sq⟩
    let D_last : k → Matrix (Fin (m + 1)) (Fin (m + 1)) k :=
      fun v => Matrix.diagonal (fun i => if i = ℓ_last then v else 1)
    have hD_mul_one : ∀ v₁ v₂ : k, v₁ * v₂ = 1 → D_last v₁ * D_last v₂ = 1 := by
      intro v₁ v₂ hv
      dsimp only [D_last]
      rw [Matrix.diagonal_mul_diagonal]
      have hfun : (fun i : Fin (m + 1) =>
          (if i = ℓ_last then v₁ else 1) * (if i = ℓ_last then v₂ else 1)) = fun _ => 1 := by
        funext i
        by_cases hi : i = ℓ_last
        · rw [h_ite_pos hi, h_ite_pos hi, hv]
        · rw [h_ite_neg hi, h_ite_neg hi, mul_one]
      rw [hfun, Matrix.diagonal_one]
    have hneg_sq : (-1 : k) * (-1 : k) = 1 := by ring
    let u_neg : (Matrix (Fin (m + 1)) (Fin (m + 1)) k)ˣ :=
      ⟨D_last (-1), D_last (-1), hD_mul_one (-1) (-1) hneg_sq, hD_mul_one (-1) (-1) hneg_sq⟩
    refine ⟨u_swap, u_neg, rfl, rfl, ?_⟩
    intro hj
    have hj_symm : ℓ_last ≠ j := fun h => hj h.symm
    let u_T : ∀ (r s : Fin (m + 1)), r ≠ s → k → (Matrix (Fin (m + 1)) (Fin (m + 1)) k)ˣ :=
      fun r s hrs lam =>
        { val := Matrix.transvection r s lam
          inv := Matrix.transvection r s (-lam)
          val_inv := by
            rw [Matrix.transvection_mul_transvection_same r s hrs, add_neg_cancel,
              Matrix.transvection_zero]
          inv_val := by
            rw [Matrix.transvection_mul_transvection_same r s hrs, neg_add_cancel,
              Matrix.transvection_zero] }
    have hex_a : ∃ a : k, a ≠ 0 ∧ a ≠ 1 := by
      classical
      have : Infinite k := IsAlgClosed.instInfinite
      obtain ⟨a, ha_notMem⟩ := Infinite.exists_notMem_finset ({0, 1} : Finset k)
      exact ⟨a, fun h0 => ha_notMem (by simp [h0]), fun h1 => ha_notMem (by simp [h1])⟩
    obtain ⟨a, ha0, ha1⟩ := hex_a
    have ha_sub : a - 1 ≠ 0 := sub_ne_zero.mpr ha1
    let c : k := (a - 1)⁻¹
    have hac : (a - 1) * c = 1 := mul_inv_cancel₀ ha_sub
    have ha_inv : a * a⁻¹ = 1 := mul_inv_cancel₀ ha0
    have hinv_a : a⁻¹ * a = 1 := inv_mul_cancel₀ ha0
    let u_Elj := u_T ℓ_last j hj_symm 1
    let u_Ejl := u_T j ℓ_last hj 1
    let u_X := u_T ℓ_last j hj_symm (-c)
    let u_Y : (Matrix (Fin (m + 1)) (Fin (m + 1)) k)ˣ :=
      ⟨D_last a⁻¹, D_last a, hD_mul_one a⁻¹ a hinv_a, hD_mul_one a a⁻¹ ha_inv⟩
    have hTorusConj :
        D_last a * Matrix.transvection ℓ_last j c * D_last a⁻¹ =
          Matrix.transvection ℓ_last j (a * c) := by
      ext i t
      simp only [D_last, Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.transvection,
        Matrix.add_apply, Matrix.one_apply, Matrix.single_apply]
      by_cases hit : i = t
      · rw [← hit, h_ite_pos rfl]
        have hnot : ¬(ℓ_last = i ∧ j = i) := by
          rintro ⟨h1, h2⟩
          exact hj_symm (h1.trans h2.symm)
        rw [h_ite_neg hnot, h_ite_neg hnot, add_zero]
        by_cases hi : i = ℓ_last
        · rw [h_ite_pos hi, h_ite_pos hi, mul_one, ha_inv]
        · rw [h_ite_neg hi, h_ite_neg hi, mul_one, mul_one]
      · rw [h_ite_neg hit, zero_add, zero_add]
        by_cases hlj : ℓ_last = i ∧ j = t
        · have htl : t ≠ ℓ_last := by
            rw [← hlj.2]
            exact hj
          rw [h_ite_pos hlj, h_ite_pos hlj, h_ite_pos hlj.1.symm, h_ite_neg htl, mul_one]
        · rw [h_ite_neg hlj, h_ite_neg hlj, mul_zero, zero_mul]
    have hComm_u : u_Elj = u_Y⁻¹ * u_X⁻¹ * u_Y * u_X := by
      apply Units.ext
      change Matrix.transvection ℓ_last j 1 =
        D_last a * Matrix.transvection ℓ_last j (- -c) * D_last a⁻¹ *
          Matrix.transvection ℓ_last j (-c)
      rw [neg_neg, hTorusConj, Matrix.transvection_mul_transvection_same ℓ_last j hj_symm]
      have hc_eq : a * c + -c = 1 := by
        calc
          a * c + -c = (a - 1) * c := by ring
          _ = 1 := hac
      rw [hc_eq]
    have hConj_u : u_Ejl = u_swap⁻¹ * u_Elj * u_swap := by
      apply Units.ext
      change Matrix.transvection j ℓ_last 1 =
        P_swap * Matrix.transvection ℓ_last j 1 * P_swap
      ext i t
      have hP_conj : ∀ M : Matrix (Fin (m + 1)) (Fin (m + 1)) k,
          (P_swap * M * P_swap) i t = M (σ i) (σ t) := by
        intro M
        simp only [P_swap, Matrix.mul_apply, Matrix.of_apply]
        have h1 : ∀ s : Fin (m + 1),
            (∑ r : Fin (m + 1), (if r = σ i then (1 : k) else 0) * M r s) = M (σ i) s := by
          intro s
          have hs :
              (∑ r : Fin (m + 1), (if r = σ i then (1 : k) else 0) * M r s) =
              ∑ r : Fin (m + 1), (if r = σ i then M r s else 0) := by
            refine Finset.sum_congr rfl fun r _ => ?_
            split_ifs <;> ring
          rw [hs, Finset.sum_ite_eq', h_ite_pos (Finset.mem_univ (σ i))]
        have h2 :
            (∑ s : Fin (m + 1),
              (∑ r : Fin (m + 1), (if r = σ i then (1 : k) else 0) * M r s) *
                (if t = σ s then 1 else 0)) =
            ∑ s : Fin (m + 1), (if s = σ t then M (σ i) s else 0) := by
          refine Finset.sum_congr rfl fun s _ => ?_
          rw [h1 s]
          by_cases hs : s = σ t
          · have hts : t = σ s := by
              rw [hs]
              exact (Equiv.swap_apply_self j ℓ_last t).symm
            rw [h_ite_pos hts, h_ite_pos hs, mul_one]
          · have hts : t ≠ σ s := by
              intro h_eq
              apply hs
              rw [h_eq]
              exact (Equiv.swap_apply_self j ℓ_last s).symm
            rw [h_ite_neg hts, h_ite_neg hs, mul_zero]
        rw [h2, Finset.sum_ite_eq', h_ite_pos (Finset.mem_univ (σ t))]
      rw [hP_conj]
      simp only [Matrix.transvection, Matrix.add_apply, Matrix.one_apply, Matrix.single_apply]
      have h_diag : (σ i = σ t) ↔ (i = t) := σ.injective.eq_iff
      have h_off : (ℓ_last = σ i ∧ j = σ t) ↔ (j = i ∧ ℓ_last = t) := by
        have hσ_j : σ j = ℓ_last := Equiv.swap_apply_left j ℓ_last
        have hσ_l : σ ℓ_last = j := Equiv.swap_apply_right j ℓ_last
        constructor
        · rintro ⟨h1, h2⟩
          exact ⟨σ.injective (hσ_j.trans h1), σ.injective (hσ_l.trans h2)⟩
        · rintro ⟨h1, h2⟩
          exact ⟨(congrArg σ h1.symm).trans hσ_j |>.symm,
            (congrArg σ h2.symm).trans hσ_l |>.symm⟩
      simp only [h_diag, h_off]
    have hFour_u : u_swap = u_neg * u_Ejl * u_Elj⁻¹ * u_Ejl := by
      apply Units.ext
      change P_swap =
        D_last (-1) * Matrix.transvection j ℓ_last 1 *
