                (fun u_lift => (φ₂.app (Opposite.op (L_obj (Opposite.unop opU) u_lift))).hom)
                (DFinsupp.single (β := β₂) u₀
                  ((φ₁.app (Opposite.op (L_obj (Opposite.unop opU) u₀))).hom x)) :=
            congrArg
              (DFinsupp.mapRange.addMonoidHom
                (fun u_lift => (φ₂.app (Opposite.op (L_obj (Opposite.unop opU) u_lift))).hom))
              (DFinsupp.mapRange_single (β₁ := β₁) (β₂ := β₂)
                (f := fun u_lift => ⇑(φ₁.app (Opposite.op (L_obj (Opposite.unop opU) u_lift))).hom)
                (hf := fun _ => map_zero _))
          have hR2 : DFinsupp.mapRange.addMonoidHom
                (fun u_lift => (φ₂.app (Opposite.op (L_obj (Opposite.unop opU) u_lift))).hom)
                (DFinsupp.single (β := β₂) u₀
                  ((φ₁.app (Opposite.op (L_obj (Opposite.unop opU) u₀))).hom x)) =
              DFinsupp.single (β := β₃) u₀
                (((φ₁ ≫ φ₂).app (Opposite.op (L_obj (Opposite.unop opU) u₀))).hom x) :=
            DFinsupp.mapRange_single (β₁ := β₂) (β₂ := β₃)
              (f := fun u_lift => ⇑(φ₂.app (Opposite.op (L_obj (Opposite.unop opU) u_lift))).hom)
              (hf := fun _ => map_zero _)
          exact hL.trans (hR1.trans hR2).symm }

    have hMono_jpre : j_pre.PreservesMonomorphisms :=
      { preserves := fun {P₁ P₂} φ hφ => by
          have hMonoApp : ∀ opU : Opposite Y₂.Etale, CategoryTheory.Mono ((j_pre.map φ).app opU) := by
            intro opU
            have : ∀ u_lift : Λ (Opposite.unop opU),
                CategoryTheory.Mono (φ.app (Opposite.op (L_obj (Opposite.unop opU) u_lift))) :=
              fun _ => inferInstance
            rw [AddCommGrpCat.mono_iff_injective]
            change Function.Injective
              (DFinsupp.mapRange
                (fun u_lift => (φ.app (Opposite.op (L_obj (Opposite.unop opU) u_lift))).hom)
                (fun u_lift => map_zero _))
            rw [DFinsupp.mapRange_injective]
            intro u_lift
            rw [← AddCommGrpCat.mono_iff_injective]
            infer_instance
          exact @CategoryTheory.NatTrans.mono_of_mono_app _ _ _ _ _ _ (j_pre.map φ) hMonoApp }

    let W_M := (CategoryTheory.Functor.whiskeringLeft (Opposite Y₁.Etale) (Opposite Y₂.Etale)
      AddCommGrpCat.{u}).obj M_h.op
    let adj_shriek_pre : j_pre ⊣ W_M :=
      CategoryTheory.Adjunction.mkOfUnitCounit
        { unit :=
            { app := fun P =>
                { app := fun opW =>
                    AddCommGrpCat.ofHom
                      (DFinsupp.singleAddHom
                        (fun u : Λ (M_h.obj (Opposite.unop opW)) =>
                          ↑(P.obj (Opposite.op (L_obj (M_h.obj (Opposite.unop opW)) u))))
                        (u_diag (Opposite.unop opW)))
                  naturality := fun {opW₁ opW₂} g => by
                    apply AddCommGrpCat.hom_ext
                    apply AddMonoidHom.ext
                    intro x
                    let β₂ : Λ (M_h.obj (Opposite.unop opW₂)) → Type u :=
                      fun u' => ↑(P.obj (Opposite.op (L_obj (M_h.obj (Opposite.unop opW₂)) u')))
                    let φ_Mg : ∀ u : Λ (M_h.obj (Opposite.unop opW₁)),
                        ↑(P.obj (Opposite.op (L_obj (M_h.obj (Opposite.unop opW₁)) u))) →+
                          Π₀ u' : Λ (M_h.obj (Opposite.unop opW₂)), β₂ u' :=
                      fun u_lift => (DFinsupp.singleAddHom β₂ (Λ_pull (M_h.map g.unop) u_lift)).comp
                        (P.map (L_map (M_h.map g.unop) u_lift).op).hom
                    have hR : DFinsupp.sumAddHom φ_Mg
                          (DFinsupp.single (u_diag (Opposite.unop opW₁)) x) =
                        DFinsupp.singleAddHom β₂
                          (Λ_pull (M_h.map g.unop) (u_diag (Opposite.unop opW₁)))
                          ((P.map (L_map (M_h.map g.unop) (u_diag (Opposite.unop opW₁))).op).hom x) :=
                      DFinsupp.sumAddHom_single φ_Mg (u_diag (Opposite.unop opW₁)) x
                    have hMid := hSingleCongr P
                      (Λ_pull (M_h.map g.unop) (u_diag (Opposite.unop opW₁)))
                      (u_diag (Opposite.unop opW₂))
                      (Subtype.ext (CategoryTheory.MorphismProperty.Over.w g.unop))
                      (L_map (M_h.map g.unop) (u_diag (Opposite.unop opW₁)))
                      g.unop rfl x
                    exact hMid.symm.trans hR.symm }
              naturality := fun {P₁ P₂} φ => by
                refine CategoryTheory.NatTrans.ext (funext fun opW => ?_)
                apply AddCommGrpCat.hom_ext
                apply AddMonoidHom.ext
                intro x
                let β₁ : Λ (M_h.obj (Opposite.unop opW)) → Type u :=
                  fun u => ↑(P₁.obj (Opposite.op (L_obj (M_h.obj (Opposite.unop opW)) u)))
                let β₂ : Λ (M_h.obj (Opposite.unop opW)) → Type u :=
                  fun u => ↑(P₂.obj (Opposite.op (L_obj (M_h.obj (Opposite.unop opW)) u)))
                have hMR : DFinsupp.mapRange.addMonoidHom
                      (fun u_lift =>
                        (φ.app (Opposite.op (L_obj (M_h.obj (Opposite.unop opW)) u_lift))).hom)
                      (DFinsupp.single (β := β₁) (u_diag (Opposite.unop opW)) x) =
                    DFinsupp.single (β := β₂) (u_diag (Opposite.unop opW)) ((φ.app opW).hom x) :=
                  DFinsupp.mapRange_single (β₁ := β₁) (β₂ := β₂)
                    (f := fun u_lift =>
                      ⇑(φ.app (Opposite.op (L_obj (M_h.obj (Opposite.unop opW)) u_lift))).hom)
                    (hf := fun _ => map_zero _)
                exact hMR.symm }
          counit :=
            { app := fun Q =>
                { app := fun opU =>
                    AddCommGrpCat.ofHom
                      (DFinsupp.sumAddHom (fun u_lift : Λ (Opposite.unop opU) =>
                        (Q.map (i_inv (Opposite.unop opU) u_lift).op).hom))
                  naturality := fun {opU₁ opU₂} f => by
                    apply AddCommGrpCat.hom_ext
                    apply DFinsupp.addHom_ext
                    intro u₀ x
                    let ψ₁ : ∀ u_lift : Λ (Opposite.unop opU₁),
                        ↑((W_M.obj Q).obj (Opposite.op (L_obj (Opposite.unop opU₁) u_lift))) →+
                          ↑(Q.obj opU₁) :=
                      fun u_lift => (Q.map (i_inv (Opposite.unop opU₁) u_lift).op).hom
                    let ψ₂ : ∀ u_lift : Λ (Opposite.unop opU₂),
                        ↑((W_M.obj Q).obj (Opposite.op (L_obj (Opposite.unop opU₂) u_lift))) →+
                          ↑(Q.obj opU₂) :=
                      fun u_lift => (Q.map (i_inv (Opposite.unop opU₂) u_lift).op).hom
                    let β₂ : Λ (Opposite.unop opU₂) → Type u :=
                      fun u' => ↑((W_M.obj Q).obj (Opposite.op (L_obj (Opposite.unop opU₂) u')))
                    let φ_Q : ∀ u_lift : Λ (Opposite.unop opU₁),
                        ↑((W_M.obj Q).obj (Opposite.op (L_obj (Opposite.unop opU₁) u_lift))) →+
                          Π₀ u' : Λ (Opposite.unop opU₂), β₂ u' :=
                      fun u_lift => (DFinsupp.singleAddHom β₂ (Λ_pull f.unop u_lift)).comp
                        ((W_M.obj Q).map (L_map f.unop u_lift).op).hom
                    have hL1 : DFinsupp.sumAddHom ψ₂ (DFinsupp.sumAddHom φ_Q (DFinsupp.single u₀ x)) =
                        DFinsupp.sumAddHom ψ₂
                          (DFinsupp.single (Λ_pull f.unop u₀)
                            (((W_M.obj Q).map (L_map f.unop u₀).op).hom x)) :=
                      congrArg (DFinsupp.sumAddHom ψ₂) (DFinsupp.sumAddHom_single φ_Q u₀ x)
                    have hL2 : DFinsupp.sumAddHom ψ₂
                          (DFinsupp.single (Λ_pull f.unop u₀)
                            (((W_M.obj Q).map (L_map f.unop u₀).op).hom x)) =
                        (Q.map (i_inv (Opposite.unop opU₂) (Λ_pull f.unop u₀)).op).hom
                          ((Q.map (M_h.map (L_map f.unop u₀)).op).hom x) :=
                      DFinsupp.sumAddHom_single ψ₂ (Λ_pull f.unop u₀)
                        (((W_M.obj Q).map (L_map f.unop u₀).op).hom x)
                    have hm1 : Q.map (M_h.map (L_map f.unop u₀)).op ≫
                        Q.map (i_inv (Opposite.unop opU₂) (Λ_pull f.unop u₀)).op =
                      Q.map (i_inv (Opposite.unop opU₂) (Λ_pull f.unop u₀) ≫
                        M_h.map (L_map f.unop u₀)).op :=
                      (Q.map_comp (M_h.map (L_map f.unop u₀)).op
                        (i_inv (Opposite.unop opU₂) (Λ_pull f.unop u₀)).op).symm
                    have hm2 : Q.map (i_inv (Opposite.unop opU₁) u₀).op ≫ Q.map f =
                      Q.map (f.unop ≫ i_inv (Opposite.unop opU₁) u₀).op :=
                      (Q.map_comp (i_inv (Opposite.unop opU₁) u₀).op f).symm
                    have hMorEq : i_inv (Opposite.unop opU₂) (Λ_pull f.unop u₀) ≫
                          M_h.map (L_map f.unop u₀) =
                        f.unop ≫ i_inv (Opposite.unop opU₁) u₀ :=
                      CategoryTheory.MorphismProperty.Comma.Hom.ext
                        ((CategoryTheory.Category.id_comp f.unop.left).trans
                          (CategoryTheory.Category.comp_id f.unop.left).symm)
                        (Subsingleton.elim _ _)
                    have hMid : (Q.map (i_inv (Opposite.unop opU₂) (Λ_pull f.unop u₀)).op).hom
                          ((Q.map (M_h.map (L_map f.unop u₀)).op).hom x) =
                        (Q.map f).hom ((Q.map (i_inv (Opposite.unop opU₁) u₀).op).hom x) :=
                      congrArg (fun m => m.hom x)
                        (hm1.trans ((congrArg (fun k => Q.map k.op) hMorEq).trans hm2.symm))
                    have hR : (Q.map f).hom (DFinsupp.sumAddHom ψ₁ (DFinsupp.single u₀ x)) =
                        (Q.map f).hom ((Q.map (i_inv (Opposite.unop opU₁) u₀).op).hom x) :=
                      congrArg (Q.map f).hom (DFinsupp.sumAddHom_single ψ₁ u₀ x)
                    exact (hL1.trans hL2).trans (hMid.trans hR.symm) }
              naturality := fun {Q₁ Q₂} β => by
                refine CategoryTheory.NatTrans.ext (funext fun opU => ?_)
                apply AddCommGrpCat.hom_ext
                apply DFinsupp.addHom_ext
                intro u₀ x
                let β₁ : Λ (Opposite.unop opU) → Type u :=
                  fun u => ↑((W_M.obj Q₁).obj (Opposite.op (L_obj (Opposite.unop opU) u)))
                let β₂ : Λ (Opposite.unop opU) → Type u :=
                  fun u => ↑((W_M.obj Q₂).obj (Opposite.op (L_obj (Opposite.unop opU) u)))
                let ψ₁ : ∀ u_lift : Λ (Opposite.unop opU), β₁ u_lift →+ ↑(Q₁.obj opU) :=
                  fun u_lift => (Q₁.map (i_inv (Opposite.unop opU) u_lift).op).hom
                let ψ₂ : ∀ u_lift : Λ (Opposite.unop opU), β₂ u_lift →+ ↑(Q₂.obj opU) :=
                  fun u_lift => (Q₂.map (i_inv (Opposite.unop opU) u_lift).op).hom
                let g_β : ∀ u_lift : Λ (Opposite.unop opU), β₁ u_lift →+ β₂ u_lift :=
                  fun u_lift =>
                    (β.app (Opposite.op (M_h.obj (L_obj (Opposite.unop opU) u_lift)))).hom
                have hL1 : DFinsupp.sumAddHom ψ₂
                      (DFinsupp.mapRange.addMonoidHom g_β (DFinsupp.single (β := β₁) u₀ x)) =
                    DFinsupp.sumAddHom ψ₂ (DFinsupp.single (β := β₂) u₀ (g_β u₀ x)) :=
                  congrArg (DFinsupp.sumAddHom ψ₂)
                    (DFinsupp.mapRange_single (β₁ := β₁) (β₂ := β₂)
                      (f := fun u => ⇑(g_β u)) (hf := fun _ => map_zero _))
                have hL2 : DFinsupp.sumAddHom ψ₂ (DFinsupp.single (β := β₂) u₀ (g_β u₀ x)) =
                    ψ₂ u₀ (g_β u₀ x) :=
                  DFinsupp.sumAddHom_single ψ₂ u₀ (g_β u₀ x)
                have hR : (β.app opU).hom (DFinsupp.sumAddHom ψ₁ (DFinsupp.single (β := β₁) u₀ x)) =
                    (β.app opU).hom (ψ₁ u₀ x) :=
                  congrArg (β.app opU).hom (DFinsupp.sumAddHom_single ψ₁ u₀ x)
                have hMid : ψ₂ u₀ (g_β u₀ x) = (β.app opU).hom (ψ₁ u₀ x) :=
                  congrArg (fun m => m.hom x)
                    (β.naturality (i_inv (Opposite.unop opU) u₀).op).symm
                exact (hL1.trans hL2).trans (hMid.trans hR.symm) }
          left_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun P =>
              CategoryTheory.NatTrans.ext (funext fun opU => ?_))
            apply AddCommGrpCat.hom_ext
            apply DFinsupp.addHom_ext
            intro u₀ x
            let U := Opposite.unop opU
            let β_U : Λ U → Type u :=
              fun u => ↑(P.obj (Opposite.op (L_obj U u)))
            let β_mid : ∀ u : Λ U, Type u :=
              fun u => Π₀ (v : Λ (M_h.obj (L_obj U u))),
                ↑(P.obj (Opposite.op (L_obj (M_h.obj (L_obj U u)) v)))
            let g_unit : ∀ u_lift : Λ U, β_U u_lift →+ β_mid u_lift :=
              fun u_lift =>
                DFinsupp.singleAddHom
                  (fun v : Λ (M_h.obj (L_obj U u_lift)) =>
                    ↑(P.obj (Opposite.op (L_obj (M_h.obj (L_obj U u_lift)) v))))
                  (u_diag (L_obj U u_lift))
            let φ_i : ∀ (u_lift : Λ U) (v : Λ (M_h.obj (L_obj U u_lift))),
                ↑(P.obj (Opposite.op (L_obj (M_h.obj (L_obj U u_lift)) v))) →+ Π₀ u' : Λ U, β_U u' :=
              fun u_lift v =>
                (DFinsupp.singleAddHom β_U (Λ_pull (i_inv U u_lift) v)).comp
                  (P.map (L_map (i_inv U u_lift) v).op).hom
            let ψ_counit : ∀ u_lift : Λ U, β_mid u_lift →+ Π₀ u' : Λ U, β_U u' :=
              fun u_lift => DFinsupp.sumAddHom (φ_i u_lift)
            have hStep1 : DFinsupp.sumAddHom ψ_counit
                  (DFinsupp.mapRange.addMonoidHom g_unit (DFinsupp.single (β := β_U) u₀ x)) =
                DFinsupp.sumAddHom ψ_counit
                  (DFinsupp.single (β := β_mid) u₀ (g_unit u₀ x)) :=
              congrArg (DFinsupp.sumAddHom ψ_counit)
                (DFinsupp.mapRange_single (β₁ := β_U) (β₂ := β_mid)
                  (f := fun u_lift => ⇑(g_unit u_lift)) (hf := fun _ => map_zero _))
            have hStep2 : DFinsupp.sumAddHom ψ_counit
                  (DFinsupp.single (β := β_mid) u₀ (g_unit u₀ x)) =
                ψ_counit u₀ (g_unit u₀ x) :=
              DFinsupp.sumAddHom_single ψ_counit u₀ (g_unit u₀ x)
            have hStep3 : ψ_counit u₀ (g_unit u₀ x) =
                φ_i u₀ (u_diag (L_obj U u₀)) x :=
              DFinsupp.sumAddHom_single (φ_i u₀) (u_diag (L_obj U u₀)) x
            have hStep4 : φ_i u₀ (u_diag (L_obj U u₀)) x =
                DFinsupp.single (β := β_U) u₀ x :=
              hSingleId P U
                (Λ_pull (i_inv U u₀) (u_diag (L_obj U u₀))) u₀
                (Subtype.ext (CategoryTheory.Category.id_comp u₀.1))
                (L_map (i_inv U u₀) (u_diag (L_obj U u₀))) rfl x
            exact hStep1.trans (hStep2.trans (hStep3.trans hStep4))
          right_triangle := by
            refine CategoryTheory.NatTrans.ext (funext fun Q =>
              CategoryTheory.NatTrans.ext (funext fun opW => ?_))
            apply AddCommGrpCat.hom_ext
            apply AddMonoidHom.ext
            intro x
            let W := Opposite.unop opW
            let ψ_Q : ∀ u_lift : Λ (M_h.obj W),
                ↑((W_M.obj Q).obj (Opposite.op (L_obj (M_h.obj W) u_lift))) →+
                  ↑(Q.obj (Opposite.op (M_h.obj W))) :=
              fun u_lift => (Q.map (i_inv (M_h.obj W) u_lift).op).hom
            have hStep1 : DFinsupp.sumAddHom ψ_Q (DFinsupp.single (u_diag W) x) =
                (Q.map (i_inv (M_h.obj W) (u_diag W)).op).hom x :=
              DFinsupp.sumAddHom_single ψ_Q (u_diag W) x
            have hId : i_inv (M_h.obj W) (u_diag W) = 𝟙 (M_h.obj W) :=
              CategoryTheory.MorphismProperty.Comma.Hom.ext rfl (Subsingleton.elim _ _)
            exact hStep1.trans (congrArg (fun m => m.hom x)
              ((congrArg (fun m => Q.map (Opposite.op m)) hId).trans (Q.map_id _))) }

    let j_sh : CategoryTheory.Functor
        (CategoryTheory.Sheaf Y₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.sheafToPresheaf Y₁.smallEtaleTopology AddCommGrpCat.{u} ⋙
        j_pre ⋙
        CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}
    have : j_pre.PreservesMonomorphisms := hMono_jpre
    have : (j_pre ⋙
        CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}).PreservesMonomorphisms :=
      CategoryTheory.Functor.preservesMonomorphisms_comp j_pre
        (CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
    have : j_sh.PreservesMonomorphisms :=
      CategoryTheory.Functor.preservesMonomorphisms_comp
        (CategoryTheory.sheafToPresheaf Y₁.smallEtaleTopology AddCommGrpCat.{u})
        (j_pre ⋙ CategoryTheory.presheafToSheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
    let adj_sh₂ := CategoryTheory.sheafificationAdjunction Y₂.smallEtaleTopology AddCommGrpCat.{u}
    let adj_mid := adj_shriek_pre.comp adj_sh₂
    let adj_shriek : j_sh ⊣ res_h :=
      CategoryTheory.Adjunction.mkOfHomEquiv
        { homEquiv := fun F G =>
            (adj_mid.homEquiv F.obj G).trans
              { toFun := fun α => { hom := α }
                invFun := fun β => β.hom
                left_inv := fun _ => rfl
                right_inv := fun _ => rfl }
          homEquiv_naturality_left_symm := fun {F₁ F₂ G} f g =>
            adj_mid.homEquiv_naturality_left_symm f.hom g.hom
          homEquiv_naturality_right := fun {F G₁ G₂} f g =>
            CategoryTheory.Sheaf.hom_ext
              (adj_mid.homEquiv_naturality_right f g) }
    have : res_h.IsRightAdjoint := adj_shriek.isRightAdjoint
    have hLim : CategoryTheory.Limits.PreservesFiniteLimits res_h := inferInstance

    refine ⟨hAdd, hLim, hColim, ?_⟩
    have := hAdd
    have := hLim
    have := hColim

    have hYonedaComp : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale)
        {A B : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilPolyP1CohomologyRepSheaf Z V ⟶ A) (g : A ⟶ B),
        weilPolyP1CohomologyRepHomEquiv Z V B (α ≫ g) =
          (g.hom.app (Opposite.op V)).hom (weilPolyP1CohomologyRepHomEquiv Z V A α) := by
      intro Z V A B α g
      let adj_sh := CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
      let adj_fr := AddCommGrpCat.adj.whiskerRight (Opposite Z.Etale)
      have h1 := adj_sh.homEquiv_naturality_right α g
      have h2 := adj_fr.homEquiv_naturality_right
        ((adj_sh.homEquiv (CategoryTheory.yoneda.obj V ⋙ AddCommGrpCat.free) A) α) g.hom
      exact congrArg CategoryTheory.yonedaEquiv
        ((congrArg (adj_fr.homEquiv (CategoryTheory.yoneda.obj V) B.obj) h1).trans h2)

    intro q
    induction q with
    | zero =>
      intro G W R₁ R₂ δ_W
      let e_hom₂ : CategoryTheory.Abelian.Ext R₂ G 0 ≃ (R₂ ⟶ G) :=
        CategoryTheory.Abelian.Ext.homEquiv₀
      let e_hom₁ : CategoryTheory.Abelian.Ext R₁ (res_h.obj G) 0 ≃ (R₁ ⟶ res_h.obj G) :=
        CategoryTheory.Abelian.Ext.homEquiv₀
      let e_yon₂ := weilPolyP1CohomologyRepHomEquiv Y₂ (M_h.obj W) G
      let e_yon₁ := weilPolyP1CohomologyRepHomEquiv Y₁ W (res_h.obj G)
      let Ψ₀ := fun (ξ : CategoryTheory.Abelian.Ext R₂ G 0) =>
        (CategoryTheory.Abelian.Ext.mk₀ δ_W).comp
          (CategoryTheory.Abelian.Ext.mapExactFunctor res_h ξ) (Nat.zero_add 0)
      have hCommEquiv : (e_hom₁.trans e_yon₁) ∘ Ψ₀ = e_hom₂.trans e_yon₂ := by
        funext ξ
        dsimp only [Function.comp_apply, Equiv.trans_apply, Ψ₀]
        have hξ : CategoryTheory.Abelian.Ext.mk₀ (e_hom₂ ξ) = ξ :=
          (CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply _).symm.trans
            (e_hom₂.symm_apply_apply ξ)
        rw [← hξ, CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        have hm : e_hom₁ (CategoryTheory.Abelian.Ext.mk₀ (δ_W ≫ res_h.map (e_hom₂ ξ))) =
            δ_W ≫ res_h.map (e_hom₂ ξ) := by
          rw [← CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply]
          exact e_hom₁.apply_symm_apply _
        have hm₂ : e_hom₂ (CategoryTheory.Abelian.Ext.mk₀ (e_hom₂ ξ)) = e_hom₂ ξ := by
          rw [hξ]
        rw [hm, hm₂]
        dsimp [e_yon₁, e_yon₂]
        rw [hYonedaComp Y₁ W δ_W (res_h.map (e_hom₂ ξ))]
        have hδ : weilPolyP1CohomologyRepHomEquiv Y₁ W (res_h.obj R₂) δ_W =
            weilPolyP1CohomologyRepHomEquiv Y₂ (M_h.obj W) R₂ (𝟙 R₂) :=
          (weilPolyP1CohomologyRepHomEquiv Y₁ W (res_h.obj R₂)).apply_symm_apply _
        rw [hδ]
        have hIdComp : e_hom₂ ξ = 𝟙 R₂ ≫ e_hom₂ ξ := (CategoryTheory.Category.id_comp _).symm
        conv_rhs => rw [hIdComp, hYonedaComp Y₂ (M_h.obj W) (𝟙 R₂) (e_hom₂ ξ)]
        rfl
      have hBijComp : Function.Bijective ((e_hom₁.trans e_yon₁) ∘ Ψ₀) := by
        rw [hCommEquiv]
        exact (e_hom₂.trans e_yon₂).bijective
      exact ((e_hom₁.trans e_yon₁).bijective.of_comp_iff' Ψ₀).mp hBijComp
    | succ q ih =>
      intro G W R₁ R₂ δ_W
      let Ψ : ∀ (k : ℕ) (K : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Abelian.Ext R₂ K k →+ CategoryTheory.Abelian.Ext R₁ (res_h.obj K) k :=
        fun k K =>
          ((CategoryTheory.Abelian.Ext.mk₀ δ_W).precomp (res_h.obj K) (Nat.zero_add k)).comp
            (res_h.mapExtAddHom R₂ K k)
      change Function.Bijective (Ψ (q + 1) G)
      have hΨ_apply : ∀ (k : ℕ) (K : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
          (ξ : CategoryTheory.Abelian.Ext R₂ K k),
          Ψ k K ξ = (CategoryTheory.Abelian.Ext.mk₀ δ_W).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor res_h ξ) (Nat.zero_add k) := by
        intro k K ξ
        rfl
      have hΨ_post : ∀ (k : ℕ) {K₁ K₂ : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : K₁ ⟶ K₂) (ξ : CategoryTheory.Abelian.Ext R₂ K₁ k),
          Ψ k K₂ (ξ.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero k)) =
            (Ψ k K₁ ξ).comp (CategoryTheory.Abelian.Ext.mk₀ (res_h.map φ)) (Nat.add_zero k) := by
        intro k K₁ K₂ φ ξ
        rw [hΨ_apply, hΨ_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_h ξ
            (CategoryTheory.Abelian.Ext.mk₀ φ) (Nat.add_zero k),
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ δ_W)
            (CategoryTheory.Abelian.Ext.mapExactFunctor res_h ξ)
            (CategoryTheory.Abelian.Ext.mk₀ (res_h.map φ))
            (Nat.zero_add k) (Nat.add_zero k) (by omega)]
      let I := CategoryTheory.Injective.under G
      let ι_G : G ⟶ I := CategoryTheory.Injective.ι G
      let Q := CategoryTheory.Limits.cokernel ι_G
      let π_G : I ⟶ Q := CategoryTheory.Limits.cokernel.π ι_G
      let S_G := CategoryTheory.ShortComplex.mk ι_G π_G (CategoryTheory.Limits.cokernel.condition ι_G)
      have hSE : S_G.ShortExact := { exact := CategoryTheory.ShortComplex.exact_cokernel ι_G }
      let S_G' := S_G.map res_h
      have hSE' : S_G'.ShortExact := hSE.map_of_exact res_h
      have : CategoryTheory.Injective (res_h.obj I) :=
        CategoryTheory.Injective.injective_of_adjoint adj_shriek I
      have hSub₂ : Subsingleton (CategoryTheory.Abelian.Ext R₂ I (q + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton I 1 (q + 1) (Nat.le_add_left 1 q) R₂
      have hSub₁ : Subsingleton (CategoryTheory.Abelian.Ext R₁ (res_h.obj I) (q + 1)) :=
        CategoryTheory.HasInjectiveDimensionLT.subsingleton (res_h.obj I) 1 (q + 1)
          (Nat.le_add_left 1 q) R₁
      have hΨ_conn : ∀ (η : CategoryTheory.Abelian.Ext R₂ Q q),
          Ψ (q + 1) G (η.comp hSE.extClass rfl) =
            (Ψ q Q η).comp hSE'.extClass rfl := by
        intro η
        rw [hΨ_apply, hΨ_apply,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_h η hSE.extClass rfl,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass res_h hSE,
          ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ δ_W)
            (CategoryTheory.Abelian.Ext.mapExactFunctor res_h η) hSE'.extClass
            (Nat.zero_add q) rfl (Nat.zero_add (q + 1))]
      have hBij_Q : Function.Bijective (Ψ q Q) := ih Q W
      have hBij_I : Function.Bijective (Ψ q I) := ih I W
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨η, rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ R₂ hSE x
            (@Subsingleton.elim _ hSub₂ _ 0) rfl
        rw [hΨ_conn η] at hx
        obtain ⟨ζ', hζ'⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ R₁ hSE' (Ψ q Q η) rfl hx
        obtain ⟨ζ, rfl⟩ := hBij_I.2 ζ'
        have hη_eq : Ψ q Q (ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π_G) (Nat.add_zero q)) =
            Ψ q Q η :=
          (hΨ_post q π_G ζ).trans hζ'
        have rfl_η : ζ.comp (CategoryTheory.Abelian.Ext.mk₀ π_G) (Nat.add_zero q) = η :=
          hBij_Q.1 hη_eq
        rw [← rfl_η,
          CategoryTheory.Abelian.Ext.comp_assoc ζ (CategoryTheory.Abelian.Ext.mk₀ S_G.g)
            hSE.extClass (Nat.add_zero q) (Nat.zero_add 1) rfl,
          hSE.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro y
        obtain ⟨η', rfl⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ R₁ hSE' y
            (@Subsingleton.elim _ hSub₁ _ 0) rfl
        obtain ⟨η, rfl⟩ := hBij_Q.2 η'
        exact ⟨η.comp hSE.extClass rfl, hΨ_conn η⟩

