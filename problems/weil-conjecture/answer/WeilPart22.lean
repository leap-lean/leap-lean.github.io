            intro β₁ S_fin
            induction S_fin using Finset.induction_on with
            | empty =>
              exact ⟨⊤, trivial, fun _ h_in => False.elim (Finset.notMem_empty _ h_in)⟩
            | @insert β₂ S_rest _ ih =>
              obtain ⟨U_r, hz_r, hle_r⟩ := ih
              refine ⟨U_pm β₁ β₂ ⊓ U_r, ⟨hz₀_Upm β₁ β₂, hz_r⟩, fun β' hβ' => ?_⟩
