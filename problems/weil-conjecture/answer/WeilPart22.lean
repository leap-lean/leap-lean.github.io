theorem weil_polyP1_single_leg_fiber_ext_restriction (k : Type u) [Field k]
    (ℓ r m : ℕ)
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h)).IsRightAdjoint)
    (hAdd_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)).Additive)
    (hLim_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteLimits
        (@CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
          AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
          (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)))
    (hColim_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.Limits.PreservesFiniteColimits
        (@CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
          AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
          (@hc_all Z₁ Z₂ h) (@hr_all Z₁ Z₂ h)))
    (π_fst : Quiver.Hom (weilPolyP1Over k (m + 1)).left (weilPolyP1Over k m).left)
    (W_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (π_leg : Quiver.Hom W_bar.left (weilPolyP1Over k (m + 1)).left)
    (π_W : Quiver.Hom W_bar.left (weilPolyP1Over k m).left)
    (hg : CategoryTheory.CategoryStruct.comp π_leg π_fst = π_W)
    [hCont_leg : (weilEtaleSitePullback π_leg).IsContinuous
      (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology]
    [hAdj_leg : ((weilEtaleSitePullback π_leg).sheafPushforwardContinuous AddCommGrpCat.{u}
      (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology).IsRightAdjoint]
    [hAdd_leg : ((weilEtaleSitePullback π_leg).sheafPullback AddCommGrpCat.{u}
      (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology).Additive]
    [hLim_leg : CategoryTheory.Limits.PreservesFiniteLimits
      ((weilEtaleSitePullback π_leg).sheafPullback AddCommGrpCat.{u}
        (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology)]
    [hColim_leg : CategoryTheory.Limits.PreservesFiniteColimits
      ((weilEtaleSitePullback π_leg).sheafPullback AddCommGrpCat.{u}
        (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology)]
    (U_W : W_bar.left.Etale)
    (U_P : (weilPolyP1Over k (m + 1)).left.Etale)
    (α_π : Quiver.Hom
      (weilEtaleLocalTorsionSheaf (weilPolyP1Over k (m + 1)).left (ℓ ^ r) U_P)
      (((weilEtaleSitePullback π_leg).sheafPushforwardContinuous AddCommGrpCat.{u}
        (weilPolyP1Over k (m + 1)).left.smallEtaleTopology W_bar.left.smallEtaleTopology).obj
        (weilEtaleLocalTorsionSheaf W_bar.left (ℓ ^ r) U_W)))
    (W_bar_σ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (g'_W : Quiver.Hom W_bar_σ.left W_bar.left)
    (ι_σ : Quiver.Hom (weilProjectiveSpaceOver k 1).left (weilPolyP1Over k (m + 1)).left)
    (π_leg_σ : Quiver.Hom W_bar_σ.left (weilProjectiveSpaceOver k 1).left)
    (hπ_σ_over : CategoryTheory.CategoryStruct.comp π_leg_σ (weilProjectiveSpaceOver k 1).hom = W_bar_σ.hom)
    (h_sq : CategoryTheory.CategoryStruct.comp g'_W π_leg =
      CategoryTheory.CategoryStruct.comp π_leg_σ ι_σ) :
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
        CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let P1_over := weilProjectiveSpaceOver k 1
    let P_m := weilPolyP1Over k m
    let P := weilPolyP1Over k (m + 1)
    let Fgt_Pm := AlgebraicGeometry.Scheme.Etale.forget P_m.left
    let Fgt_P := AlgebraicGeometry.Scheme.Etale.forget P.left
    let Fgt_P1 := AlgebraicGeometry.Scheme.Etale.forget P1_over.left
    let Fgt_W := AlgebraicGeometry.Scheme.Etale.forget W_bar.left
    let Fgt_Wσ := AlgebraicGeometry.Scheme.Etale.forget W_bar_σ.left
    let U_W_σ : W_bar_σ.left.Etale := (weilEtaleSitePullback g'_W).obj U_W
