    obtain ⟨h_comm_bc, e_tens_bc, he_tens_bc⟩ := hB_etale_bc hAff_U' hAff_U v
    have hU_full : Good U := ⟨hAff_U, M₀, hAdd₀, hMod₀, bM₀, e₀, he₀⟩
    have hU'_full : Good U' := ⟨hAff_U', M'₀, hAdd'₀, hMod'₀, bM'₀, e'₀, he'₀⟩
    rw [hφ_spec U' hU'_full σ_U' M'₀ hAdd'₀ hMod'₀ bM'₀ e'₀ he'₀ L'₀ hL'₀,
      hφ_spec U hU_full σ_U M₀ hAdd₀ hMod₀ bM₀ e₀ he₀ L₀ hL₀]
    exact hA_bc ρ_U ρ_U' ψ_R ψ_S h_comm_bc e_tens_bc he_tens_bc
      M₀ bM₀ e₀ he₀ M'₀ bM'₀ e'₀ he'₀ (ι₁ (B.obj U) σ_U) L₀ L'₀ hL₀ hL'₀_bc

  choose Idx_cov V_cov j_cov hSieve_cov hGood_cov using hB_cover

  let x_cov : ∀ (U : Y₂.left.Etale) (i : Idx_cov U),
      Quiver.Hom (F₁.obj.obj (Opposite.op U)) (F₂.obj.obj (Opposite.op (V_cov U i))) :=
    fun U i => F₁.obj.map (j_cov U i).op ≫ φ_good (V_cov U i) (hGood_cov U i)

  have hx_cov : ∀ (U : Y₂.left.Etale) ⦃W : Y₂.left.Etale⦄ ⦃i₁ i₂ : Idx_cov U⦄
      (g₁ : Quiver.Hom W (V_cov U i₁)) (g₂ : Quiver.Hom W (V_cov U i₂)),
      g₁ ≫ j_cov U i₁ = g₂ ≫ j_cov U i₂ →
      x_cov U i₁ ≫ F₂.obj.map g₁.op = x_cov U i₂ ≫ F₂.obj.map g₂.op := by
    intro U W i₁ i₂ g₁ g₂ hg
    apply F₂.cond.hom_ext_ofArrows (j_cov W) (hSieve_cov W)
    intro k
    dsimp [x_cov]
    rw [Category.assoc, Category.assoc, ← F₂.obj.map_comp, ← op_comp,
      ← hNat_good (hGood_cov W k) (hGood_cov U i₁) (j_cov W k ≫ g₁),
      ← Category.assoc, ← F₁.obj.map_comp, ← op_comp, Category.assoc, hg,
      ← Category.assoc (j_cov W k) g₂, op_comp, F₁.obj.map_comp, Category.assoc,
      hNat_good (hGood_cov W k) (hGood_cov U i₂) (j_cov W k ≫ g₂),
      op_comp, F₂.obj.map_comp]
    simp only [Category.assoc]

  let τ_app : ∀ U : Y₂.left.Etale,
      Quiver.Hom (F₁.obj.obj (Opposite.op U)) (F₂.obj.obj (Opposite.op U)) :=
    fun U => F₂.cond.amalgamateOfArrows (j_cov U) (hSieve_cov U) (x_cov U) (hx_cov U)

  have hτ_map : ∀ (U : Y₂.left.Etale) (i : Idx_cov U),
      τ_app U ≫ F₂.obj.map (j_cov U i).op = x_cov U i :=
    fun U i => F₂.cond.amalgamateOfArrows_map (j_cov U) (hSieve_cov U) (x_cov U) (hx_cov U) i

  have h_good_mor : ∀ {W U : Y₂.left.Etale} (hW : Good W) (w : Quiver.Hom W U),
      τ_app U ≫ F₂.obj.map w.op = F₁.obj.map w.op ≫ φ_good W hW := by
    intro W U hW w
    let S_pull : J₂.Cover W :=
      ⟨CategoryTheory.Sieve.pullback w (CategoryTheory.Sieve.ofArrows (V_cov U) (j_cov U)),
        J₂.pullback_stable w (hSieve_cov U)⟩
    apply F₂.cond.hom_ext S_pull
    intro I
    rcases I.hf with ⟨Z, q, r, ⟨i⟩, hq⟩
    apply F₂.cond.hom_ext_ofArrows (j_cov I.Y) (hSieve_cov I.Y)
    intro k
    let p := j_cov I.Y k
    calc
      ((τ_app U ≫ F₂.obj.map w.op) ≫ F₂.obj.map I.f.op) ≫ F₂.obj.map p.op
        = τ_app U ≫ F₂.obj.map (p ≫ I.f ≫ w).op := by
            simp only [Category.assoc, ← F₂.obj.map_comp, ← op_comp]
      _ = τ_app U ≫ F₂.obj.map ((p ≫ q) ≫ j_cov U i).op := by
            rw [← hq, Category.assoc]
      _ = (τ_app U ≫ F₂.obj.map (j_cov U i).op) ≫ F₂.obj.map (p ≫ q).op := by
            rw [op_comp, F₂.obj.map_comp, Category.assoc]
      _ = F₁.obj.map (j_cov U i).op ≫
            (φ_good (V_cov U i) (hGood_cov U i) ≫ F₂.obj.map (p ≫ q).op) := by
            rw [hτ_map U i]
            dsimp only [x_cov]
            rw [Category.assoc]
      _ = F₁.obj.map (j_cov U i).op ≫
            (F₁.obj.map (p ≫ q).op ≫ φ_good (V_cov I.Y k) (hGood_cov I.Y k)) := by
            rw [← hNat_good (hGood_cov I.Y k) (hGood_cov U i) (p ≫ q)]
      _ = F₁.obj.map (p ≫ I.f ≫ w).op ≫ φ_good (V_cov I.Y k) (hGood_cov I.Y k) := by
            rw [← Category.assoc, ← F₁.obj.map_comp, ← op_comp, Category.assoc, hq]
      _ = F₁.obj.map w.op ≫
            (F₁.obj.map (p ≫ I.f).op ≫ φ_good (V_cov I.Y k) (hGood_cov I.Y k)) := by
            rw [← Category.assoc p I.f w, op_comp, F₁.obj.map_comp, Category.assoc]
      _ = F₁.obj.map w.op ≫
            (φ_good W hW ≫ F₂.obj.map (p ≫ I.f).op) := by
            rw [hNat_good (hGood_cov I.Y k) hW (p ≫ I.f)]
      _ = ((F₁.obj.map w.op ≫ φ_good W hW) ≫ F₂.obj.map I.f.op) ≫ F₂.obj.map p.op := by
            simp only [Category.assoc, op_comp, F₂.obj.map_comp]

  have h_good_eq : ∀ (U : Y₂.left.Etale) (hU : Good U), τ_app U = φ_good U hU := by
    intro U hU
    have h1 := h_good_mor hU (𝟙 U)
    simpa only [op_id, CategoryTheory.Functor.map_id, Category.comp_id, Category.id_comp]
      using h1

  have h_nat_τ : ∀ {X Y : (Y₂.left.Etale)ᵒᵖ} (g : X ⟶ Y),
      F₁.obj.map g ≫ τ_app Y.unop = τ_app X.unop ≫ F₂.obj.map g := by
    intro X Y g
    let v : Y.unop ⟶ X.unop := g.unop
    change F₁.obj.map v.op ≫ τ_app Y.unop = τ_app X.unop ≫ F₂.obj.map v.op
    apply F₂.cond.hom_ext_ofArrows (j_cov Y.unop) (hSieve_cov Y.unop)
    intro k
    rw [Category.assoc, hτ_map Y.unop k]
    dsimp [x_cov]
    rw [← Category.assoc, ← F₁.obj.map_comp, ← op_comp,
      ← h_good_mor (hGood_cov Y.unop k) (j_cov Y.unop k ≫ v),
      op_comp, F₂.obj.map_comp, Category.assoc]

  let τM : Quiver.Hom F₁ F₂ :=
    { hom :=
        { app := fun X => τ_app X.unop
          naturality := fun _ _ g => h_nat_τ g } }

  
  
  
  refine ⟨τM, ?_, ?_, ?_⟩
  · 
    intro U hAff_U M hAdd hMod bM e he σ L hL
    have hU : Good U := ⟨hAff_U, M, hAdd, hMod, bM, e, he⟩
    have happ : τM.hom.app (Opposite.op U) = φ_good U hU := h_good_eq U hU
    change ι₂ U ((τM.hom.app (Opposite.op U)) σ) = _
    rw [happ]
    exact hφ_spec U hU σ M hAdd hMod bM e he L hL
  · 
    intro τM' hτM'
    have hτM'_good : ∀ (U : Y₂.left.Etale) (hU : Good U),
        τM'.hom.app (Opposite.op U) = φ_good U hU := by
      intro U hU
      apply AddCommGrpCat.hom_ext
      ext σ
      apply hInj₂ U
      let σ_U : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))) := σ
      rcases hU with ⟨hAff_U, M₀, hAdd₀, hMod₀, bM₀, e₀, he₀⟩
      let R_U := ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))
      let S_U := ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))
      let ρ_U : R_U →+* S_U := CommRingCat.Hom.hom
        (AlgebraicGeometry.Scheme.Hom.appTop
          (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f))
      letI : AddCommGroup M₀ := hAdd₀
      letI : Module R_U M₀ := hMod₀
      obtain ⟨L₀, hL₀⟩ := hA_ex ρ_U M₀ e₀ he₀ (ι₁ (B.obj U) σ_U)
      have hU_full : Good U := ⟨hAff_U, M₀, hAdd₀, hMod₀, bM₀, e₀, he₀⟩
      change ι₂ U ((τM'.hom.app (Opposite.op U)) σ_U) = ι₂ U (φ_fun U hU_full σ_U)
      rw [hτM' U hAff_U M₀ hAdd₀ hMod₀ bM₀ e₀ he₀ σ_U L₀ hL₀,
        hφ_spec U hU_full σ_U M₀ hAdd₀ hMod₀ bM₀ e₀ he₀ L₀ hL₀]
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext X
    let U := X.unop
    change τM'.hom.app (Opposite.op U) = τM.hom.app (Opposite.op U)
    apply F₂.cond.hom_ext_ofArrows (j_cov U) (hSieve_cov U)
    intro i
    rw [← τM'.hom.naturality (j_cov U i).op,
      ← τM.hom.naturality (j_cov U i).op,
      hτM'_good (V_cov U i) (hGood_cov U i),
      show τM.hom.app (Opposite.op (V_cov U i)) = φ_good (V_cov U i) (hGood_cov U i) from
        h_good_eq (V_cov U i) (hGood_cov U i)]
  · 
    let g_unit : Quiver.Hom AM (F₁.obj.obj (Opposite.op T₂)) :=
      CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
        ((C₁.obj AM).obj.map (Opposite.op (hT₁.from (B.obj T₂))))
    let ηM : Quiver.Hom F₂ F₁ := (adj₂.homEquiv AM F₁).symm g_unit
    change CategoryTheory.CategoryStruct.comp ηM τM = δ • CategoryTheory.CategoryStruct.id F₂
    apply (adj₂.homEquiv AM F₂).injective
    have h_lhs : adj₂.homEquiv AM F₂ (ηM ≫ τM) = g_unit ≫ τM.hom.app (Opposite.op T₂) := by
      dsimp [ηM]
      rw [← CategoryTheory.Adjunction.homEquiv_naturality_right_symm,
        Equiv.apply_symm_apply]
      rfl
    have h_nsmul_app : ∀ d : ℕ,
        (d • CategoryTheory.CategoryStruct.id F₂).hom.app (Opposite.op T₂) =
          d • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂)) := by
      intro d
      induction d with
      | zero =>
        simp only [zero_nsmul]
        rfl
      | succ d ih =>
        rw [succ_nsmul, succ_nsmul]
        change (d • CategoryTheory.CategoryStruct.id F₂).hom.app (Opposite.op T₂) +
            (CategoryTheory.CategoryStruct.id F₂).hom.app (Opposite.op T₂) =
          d • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂)) +
            CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂))
        rw [ih]
        rfl
    have h_rhs : adj₂.homEquiv AM F₂ (δ • CategoryTheory.CategoryStruct.id F₂) =
        adj₂.unit.app AM ≫ (δ • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂))) := by
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      change adj₂.unit.app AM ≫
          (δ • CategoryTheory.CategoryStruct.id F₂).hom.app (Opposite.op T₂) = _
      rw [h_nsmul_app δ]
    rw [h_lhs, h_rhs]
    have hkMap₁_nat : ∀ {W' W : Y₁.left.Etale} (w : Quiver.Hom W' W) (c : k),
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₁.map w).left))
          (kMap₁ W c) = kMap₁ W' c := by
      intro W' W w c
      have hw : (Fgt₁.map w).left ≫ (Fgt₁.obj W).hom = (Fgt₁.obj W').hom :=
        CategoryTheory.MorphismProperty.Over.w w
      have h1 : ((Fgt₁.map w).left ≫ ((Fgt₁.obj W).hom ≫ Y₁.hom)) = (Fgt₁.obj W').hom ≫ Y₁.hom := by
        rw [← Category.assoc, hw]
      have happ := congrArg AlgebraicGeometry.Scheme.Hom.appTop h1
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop] at happ
      exact congrArg
        (fun ψ => CommRingCat.Hom.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ψ) c) happ
    have hkMap₂_nat : ∀ {W' W : Y₂.left.Etale} (w : Quiver.Hom W' W) (c : k),
        (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₂.map w).left))
          (kMap₂ W c) = kMap₂ W' c := by
      intro W' W w c
      have hw : (Fgt₂.map w).left ≫ (Fgt₂.obj W).hom = (Fgt₂.obj W').hom :=
        CategoryTheory.MorphismProperty.Over.w w
      have h1 : ((Fgt₂.map w).left ≫ ((Fgt₂.obj W).hom ≫ Y₂.hom)) = (Fgt₂.obj W').hom ≫ Y₂.hom := by
        rw [← Category.assoc, hw]
      have happ := congrArg AlgebraicGeometry.Scheme.Hom.appTop h1
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop] at happ
      exact congrArg
        (fun ψ => CommRingCat.Hom.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ψ) c) happ
    have hkMap_pb : ∀ (U : Y₂.left.Etale) (c : k),
        (CommRingCat.Hom.hom
          (AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)))
          (kMap₂ U c) = kMap₁ (B.obj U) c := by
      intro U c
      have h_hom : (Fgt₁.obj (B.obj U)).hom = CategoryTheory.Limits.pullback.snd (Fgt₂.obj U).hom f := rfl
      have h1 : CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f ≫ ((Fgt₂.obj U).hom ≫ Y₂.hom) =
          (Fgt₁.obj (B.obj U)).hom ≫ Y₁.hom := by
        rw [← Category.assoc, CategoryTheory.Limits.pullback.condition, Category.assoc, hf_over]
        rfl
      have happ := congrArg AlgebraicGeometry.Scheme.Hom.appTop h1
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop] at happ
      exact congrArg
        (fun ψ => CommRingCat.Hom.hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ ψ) c) happ
    have h_ulift_nsmul : ∀ (d : ℕ) (a : ZMod n),
        (d • (ULift.up a : ↑AM)) = ULift.up (d • a) := by
      intro d a
      induction d with
      | zero => rfl
      | succ d ih =>
        rw [succ_nsmul, succ_nsmul, ih]
        rfl
    haveI : NeZero n := ⟨by omega⟩
    have hζ_pow_mod : ∀ (a : ZMod n),
        ((ζ : kˣ) : k) ^ (a.val * δ) = ((ζ : kˣ) : k) ^ (δ • a).val := by
      intro a
      have hval : (δ • a).val = (a.val * δ) % n := by
        rw [nsmul_eq_mul, ZMod.val_mul, ZMod.val_natCast, Nat.mod_mul_mod, Nat.mul_comm]
      rw [hval]
      conv_lhs => rw [← Nat.div_add_mod (a.val * δ) n]
      rw [pow_add, pow_mul, hζ.pow_eq_one, one_pow, one_mul]
    apply F₂.cond.hom_ext_ofArrows (j_cov T₂) (hSieve_cov T₂)
    intro i
    let U := V_cov T₂ i
    let hU := hGood_cov T₂ i
    let u := j_cov T₂ i
    rw [Category.assoc, ← τM.hom.naturality u.op,
      show τM.hom.app (Opposite.op U) = φ_good U hU from h_good_eq U hU]
    apply AddCommGrpCat.hom_ext
    ext a_u
    let a : ZMod n := ULift.down a_u
    have ha_u : a_u = ULift.up a := rfl
    rw [ha_u]
    apply hInj₂ U
    have h_rhs_eval :
        ((adj₂.unit.app AM ≫ (δ • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂)))) ≫
          F₂.obj.map u.op) (ULift.up a) =
        (F₂.obj.map u.op) ((adj₂.unit.app AM) (ULift.up (δ • a))) := by
      let y_a : ↑(F₂.obj.obj (Opposite.op T₂)) := (adj₂.unit.app AM).hom (ULift.up a)
      have h_id_nsmul : ∀ (d : ℕ) (x : ↑(F₂.obj.obj (Opposite.op T₂))),
          (d • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂))).hom x = d • x := by
        intro d x
        induction d with
        | zero => rfl
        | succ d ih =>
          rw [succ_nsmul, succ_nsmul]
          change (d • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂))).hom x + x =
            d • x + x
          rw [ih]
      have h_unit_nsmul :
          (adj₂.unit.app AM).hom (ULift.up (δ • a) : ↑AM) = δ • y_a := by
        dsimp [y_a]
        rw [← h_ulift_nsmul δ a]
        exact map_nsmul (adj₂.unit.app AM).hom δ (ULift.up a : ↑AM)
      change (F₂.obj.map u.op).hom
          ((δ • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op T₂))).hom y_a) =
        (F₂.obj.map u.op).hom ((adj₂.unit.app AM).hom (ULift.up (δ • a) : ↑AM))
      rw [h_id_nsmul δ y_a, h_unit_nsmul]
    rw [h_rhs_eval]
    let σ_a : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))) :=
      (F₁.obj.map u.op) (g_unit (ULift.up a))
    change ι₂ U (φ_fun U hU σ_a) =
      ι₂ U (((C₂.obj AM).obj.map (Opposite.op u)) ((adj₂.unit.app AM) (ULift.up (δ • a))))
    rw [hNat₂ u, hNorm₂ (δ • a), map_pow, hkMap₂_nat u]
    rcases hU with ⟨hAff_U, M₀, hAdd₀, hMod₀, bM₀, e₀, he₀⟩
    let R_U := ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))
    let S_U := ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))
    let ρ_U : R_U →+* S_U := CommRingCat.Hom.hom
      (AlgebraicGeometry.Scheme.Hom.appTop
        (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f))
    letI : AddCommGroup M₀ := hAdd₀
    letI : Module R_U M₀ := hMod₀
    obtain ⟨L₀, hL₀⟩ := hA_ex ρ_U M₀ e₀ he₀ (ι₁ (B.obj U) σ_a)
    let r₀ : R_U := (kMap₂ U ((ζ : kˣ) : k)) ^ a.val
    have hι₁_σ : ι₁ (B.obj U) σ_a = ρ_U r₀ := by
      let w₁ : Quiver.Hom (B.obj U) T₁ := B.map u ≫ hT₁.from (B.obj T₂)
      have h_map_w₁ :
          (C₁.obj AM).obj.map w₁.op =
            (C₁.obj AM).obj.map (hT₁.from (B.obj T₂)).op ≫ (C₁.obj AM).obj.map (B.map u).op := by
        dsimp [w₁]
        exact (C₁.obj AM).obj.map_comp _ _
      have hσ_eq : σ_a = ((C₁.obj AM).obj.map (Opposite.op w₁)) ((adj₁.unit.app AM) (ULift.up a)) :=
        congrArg (fun φ => φ.hom ((adj₁.unit.app AM).hom (ULift.up a : ↑AM))) h_map_w₁.symm
      calc
        ι₁ (B.obj U) σ_a
          = (kMap₁ (B.obj U) ((ζ : kˣ) : k)) ^ a.val := by
              rw [hσ_eq, hNat₁ w₁, hNorm₁ a, map_pow, hkMap₁_nat w₁]
        _ = (ρ_U (kMap₂ U ((ζ : kˣ) : k))) ^ a.val :=
              congrArg (· ^ a.val) (hkMap_pb U ((ζ : kˣ) : k)).symm
        _ = ρ_U r₀ := (map_pow ρ_U (kMap₂ U ((ζ : kˣ) : k)) a.val).symm
    have hL₀_smul : ∀ m : M₀, e₀ (L₀ m) = ρ_U r₀ * e₀ m := by
      intro m
      rw [hL₀ m, hι₁_σ]
    have hU_full : Good U := ⟨hAff_U, M₀, hAdd₀, hMod₀, bM₀, e₀, he₀⟩
    rw [hφ_spec U hU_full σ_a M₀ hAdd₀ hMod₀ bM₀ e₀ he₀ L₀ hL₀,
      hA_smul ρ_U M₀ bM₀ e₀ he₀ r₀ L₀ hL₀_smul]
    dsimp [r₀]
    rw [← pow_mul, ← map_pow, hζ_pow_mod a, map_pow]

theorem weil_top_deg_affine_finite_free_det_pushforward (k : Type u) [Field k] [IsAlgClosed k]
    (n : ℕ) (hn : 2 ≤ n) (hUnit : IsUnit (n : k))
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n) :
    (∀ (δ q : ℕ) (_ : 1 ≤ δ)
      (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (f : Quiver.Hom Y₁.left Y₂.left),
      CategoryTheory.CategoryStruct.comp f Y₂.hom = Y₁.hom →
      WeilTopDegFiniteLocallyFreeOfRank δ f →
      (∃ f_shriek : weilEtaleTorsionH Y₁.left n q →+ weilEtaleTorsionH Y₂.left n q,
        WeilTopDegAffineFiniteFreePushforward k n δ q ζ Y₁ Y₂ f f_shriek) ∧
      (∀ f₁ f₂ : weilEtaleTorsionH Y₁.left n q →+ weilEtaleTorsionH Y₂.left n q,
        WeilTopDegAffineFiniteFreePushforward k n δ q ζ Y₁ Y₂ f f₁ →
        WeilTopDegAffineFiniteFreePushforward k n δ q ζ Y₁ Y₂ f f₂ →
        f₁ = f₂)) ∧
