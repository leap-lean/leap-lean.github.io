    (P : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} → Prop) :
    letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
