    intro R R' S S' _ _ _ _ ρ ρ' ψ_R ψ_S
    letI : Algebra R R' := RingHom.toAlgebra ψ_R
    letI : Algebra R S := RingHom.toAlgebra ρ
    intro e_tensor he_tensor M _ _ bM e he M' _ _ bM' e' he' u L L' hL hL'
    let e_lin : M ≃ₗ[R] S :=
      { e with
        map_smul' := fun r₀ m => he r₀ m }
    let M'₀ : Type u := TensorProduct R R' M
    let bM'₀ : Module.Basis (Fin d) R' M'₀ := bM.baseChange R'
    let e'₀ : M'₀ ≃+ S' :=
      (LinearEquiv.baseChange R R' M S e_lin).toAddEquiv.trans e_tensor
    let L'₀ : M'₀ →ₗ[R'] M'₀ := LinearMap.baseChange R' L
    have he'₀ : ∀ (r₀' : R') (x : M'₀), e'₀ (r₀' • x) = ρ' r₀' * e'₀ x := by
      intro r₀' x
      refine TensorProduct.inductionOn x (fun r' m => ?_) (fun x y ihx ihy => ?_)
      · change e_tensor ((r₀' * r') ⊗ₜ[R] e m) = ρ' r₀' * e_tensor (r' ⊗ₜ[R] e m)
        rw [he_tensor, he_tensor, map_mul, mul_assoc]
      · rw [smul_add, map_add, map_add, mul_add, ihx, ihy]
    have hL'₀ : ∀ x : M'₀, e'₀ (L'₀ x) = ψ_S u * e'₀ x := by
      intro x
      refine TensorProduct.inductionOn x (fun r' m => ?_) (fun x y ihx ihy => ?_)
      · change e_tensor (r' ⊗ₜ[R] e (L m)) = ψ_S u * e_tensor (r' ⊗ₜ[R] e m)
        rw [he_tensor, he_tensor, hL, map_mul, mul_left_comm]
      · rw [map_add, map_add, map_add, mul_add, ihx, ihy]
