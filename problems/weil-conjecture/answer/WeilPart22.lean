          change CategoryTheory.CategoryStruct.comp
              (ℱ.obj.map (Opposite.op (e_B.inv.app (Opposite.unop U))))
              (ℱ.obj.map (Opposite.op (e_B.hom.app (Opposite.unop U)))) =
            CategoryTheory.CategoryStruct.id (ℱ.obj.obj U)
          rw [← ℱ.obj.map_comp]
          change ℱ.obj.map
              (Opposite.op
                (CategoryTheory.CategoryStruct.comp
                  (e_B.hom.app (Opposite.unop U))
                  (e_B.inv.app (Opposite.unop U)))) =
            CategoryTheory.CategoryStruct.id (ℱ.obj.obj U)
          rw [e_B.hom_inv_id_app]
          exact ℱ.obj.map_id U
        inv_hom_id := by
          apply CategoryTheory.NatTrans.ext
          funext ℱ
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext U
          change CategoryTheory.CategoryStruct.comp
              (ℱ.obj.map (Opposite.op (e_B.hom.app (Opposite.unop U))))
              (ℱ.obj.map (Opposite.op (e_B.inv.app (Opposite.unop U)))) =
            CategoryTheory.CategoryStruct.id (ℱ.obj.obj (Opposite.op (B.obj (Opposite.unop U))))
          rw [← ℱ.obj.map_comp]
          change ℱ.obj.map
              (Opposite.op
                (CategoryTheory.CategoryStruct.comp
                  (e_B.inv.app (Opposite.unop U))
                  (e_B.hom.app (Opposite.unop U)))) =
            CategoryTheory.CategoryStruct.id (ℱ.obj.obj (Opposite.op (B.obj (Opposite.unop U))))
          rw [e_B.inv_hom_id_app]
          exact ℱ.obj.map_id (Opposite.op (B.obj (Opposite.unop U))) }
    let adj_pull : CategoryTheory.Adjunction P_pull P_push :=
      CategoryTheory.Adjunction.id.ofNatIsoRight δ_push
    let T : X.Etale := weilEtaleIdTerminal.{u} X
    have hT : CategoryTheory.Limits.IsTerminal T := weilEtaleIdTerminalIsTerminal.{u} X
    refine ⟨P_pull, adj_pull, inferInstance, inferInstance, inferInstance, T, hT, T, hT, ?_⟩
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let τ : Quiver.Hom (B.obj T) T := hT.from (B.obj T)
    have hπ_id : ∀ (A : AddCommGrpCat.{u}),
        (adj_pull.homEquiv (C.obj A) (C.obj A)).symm
          ((adj.homEquiv A (P_push.obj (C.obj A))).symm
            (CategoryTheory.CategoryStruct.comp (adj.unit.app A)
              ((C.obj A).obj.map (Opposite.op τ)))) =
          CategoryTheory.CategoryStruct.id (C.obj A) := by
      intro A
      apply (adj_pull.homEquiv (C.obj A) (C.obj A)).injective
      rw [Equiv.apply_symm_apply]
      apply (adj.homEquiv A (P_push.obj (C.obj A))).injective
      rw [Equiv.apply_symm_apply]
      have h1 : adj_pull.homEquiv (C.obj A) (C.obj A) (CategoryTheory.CategoryStruct.id (C.obj A)) =
          δ_push.hom.app (C.obj A) := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        simp [adj_pull, P_pull]
      rw [h1, CategoryTheory.Adjunction.homEquiv_unit]
      have hτ : e_B.inv.app T = τ := hT.hom_ext _ _
      rw [← hτ]
      rfl
    refine ⟨CategoryTheory.CategoryStruct.id (C.obj Aℤ), ?_, ?_, ?_⟩
    · rw [hπ_id Aℤ, CategoryTheory.Category.id_comp]
    · rw [hπ_id Aℤ, CategoryTheory.Category.comp_id]
      rfl
    · intro x
      rw [hπ_id AM]
      change x =
        (((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (C.obj Aℤ))).comp
          ((P_pull.mapExtAddHom (C.obj Aℤ) (C.obj AM) q) x) (Nat.zero_add q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (C.obj AM)))
          (Nat.add_zero q))
      rw [CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Abelian.Ext.id_mapExactFunctor,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
      exact (CategoryTheory.Abelian.Ext.comp_mk₀_id x).symm

theorem weil_top_deg_affine_det_trace_sheaf_hom (k : Type u) [Field k]
    (n δ : ℕ) (hn : 2 ≤ n) (_ : 1 ≤ δ)
    (ζ : kˣ) (hζ : IsPrimitiveRoot ((ζ : kˣ) : k) n)
    (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (f : Quiver.Hom Y₁.left Y₂.left)
    (hf_over : CategoryTheory.CategoryStruct.comp f Y₂.hom = Y₁.hom)
    (hf_free : WeilTopDegFiniteLocallyFreeOfRank δ f) :
    letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B : CategoryTheory.Functor Y₂.left.Etale Y₁.left.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ f
    let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget Y₁.left
    let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget Y₂.left
    let J₁ := Y₁.left.smallEtaleTopology
    let J₂ := Y₂.left.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let kMap₁ : ∀ U : Y₁.left.Etale,
        k →+* ↑(((Fgt₁.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
      fun U => CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.CategoryStruct.comp (Fgt₁.obj U).hom Y₁.hom)))
    let kMap₂ : ∀ U : Y₂.left.Etale,
        k →+* ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) :=
      fun U => CommRingCat.Hom.hom
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)).inv
          (AlgebraicGeometry.Scheme.Hom.appTop
            (CategoryTheory.CategoryStruct.comp (Fgt₂.obj U).hom Y₂.hom)))
    ∀ (hCont : B.IsContinuous J₂ J₁)
      (T₁ : Y₁.left.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      (T₂ : Y₂.left.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (ι₁ : ∀ U : Y₁.left.Etale,
        ↑((C₁.obj AM).obj.obj (Opposite.op U)) →
          ↑(((Fgt₁.obj U).left).presheaf.obj (Opposite.op ⊤)))
      (ι₂ : ∀ U : Y₂.left.Etale,
        ↑((C₂.obj AM).obj.obj (Opposite.op U)) →
          ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))),
      let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B
        AddCommGrpCat.{u} _ J₂ J₁ hCont
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      (∀ U : Y₁.left.Etale, Function.Injective (ι₁ U)) →
      (∀ U : Y₂.left.Etale, Function.Injective (ι₂ U)) →
      (∀ (U : Y₂.left.Etale)
          (v : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))),
        v ^ n = 1 →
        ∃ s : ↑((C₂.obj AM).obj.obj (Opposite.op U)), ι₂ U s = v) →
      (∀ U : Y₁.left.Etale,
        ι₁ U 0 = 1 ∧
        ∀ s₁ s₂ : ↑((C₁.obj AM).obj.obj (Opposite.op U)),
          ι₁ U (s₁ + s₂) = ι₁ U s₁ * ι₁ U s₂ ∧ (ι₁ U s₁) ^ n = 1) →
      (∀ U : Y₂.left.Etale,
        ι₂ U 0 = 1 ∧
        ∀ s₁ s₂ : ↑((C₂.obj AM).obj.obj (Opposite.op U)),
          ι₂ U (s₁ + s₂) = ι₂ U s₁ * ι₂ U s₂ ∧ (ι₂ U s₁) ^ n = 1) →
      (∀ {U' U : Y₁.left.Etale} (u : Quiver.Hom U' U)
          (s : ↑((C₁.obj AM).obj.obj (Opposite.op U))),
        ι₁ U' (((C₁.obj AM).obj.map (Opposite.op u)) s) =
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₁.map u).left))
            (ι₁ U s)) →
      (∀ {U' U : Y₂.left.Etale} (u : Quiver.Hom U' U)
          (s : ↑((C₂.obj AM).obj.obj (Opposite.op U))),
        ι₂ U' (((C₂.obj AM).obj.map (Opposite.op u)) s) =
          (CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop (Fgt₂.map u).left))
            (ι₂ U s)) →
      (∀ a : ZMod n,
        ι₁ T₁ ((adj₁.unit.app AM) (ULift.up a)) = (kMap₁ T₁ ((ζ : kˣ) : k)) ^ a.val) →
      (∀ a : ZMod n,
        ι₂ T₂ ((adj₂.unit.app AM) (ULift.up a)) = (kMap₂ T₂ ((ζ : kˣ) : k)) ^ a.val) →
      ∃ τM : Quiver.Hom (P_push.obj (C₁.obj AM)) (C₂.obj AM),
        (∀ (U : Y₂.left.Etale)
            (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj U).left)
            (M : Type u) (_ : AddCommGroup M)
            (_ : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (bM : Module.Basis (Fin δ)
              ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
            (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
          (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
            e (r₀ • m) =
              @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
                (CommRingCat.Hom.hom
                  (AlgebraicGeometry.Scheme.Hom.appTop
                    (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
                (e m)) →
          ∀ (σ : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))))
            (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
            (∀ m : M, e (L m) = ι₁ (B.obj U) σ * e m) →
            ι₂ U ((τM.hom.app (Opposite.op U)) σ) =
              ((LinearMap.toMatrix bM bM) L).det) ∧
        (∀ τM' : Quiver.Hom (P_push.obj (C₁.obj AM)) (C₂.obj AM),
          (∀ (U : Y₂.left.Etale)
              (_ : AlgebraicGeometry.IsAffine (Fgt₂.obj U).left)
              (M : Type u) (_ : AddCommGroup M)
              (_ : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
              (bM : Module.Basis (Fin δ)
                ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
              (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
            (∀ (r₀ : ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))) (m : M),
              e (r₀ • m) =
                @Mul.mul ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤)) _
                  (CommRingCat.Hom.hom
                    (AlgebraicGeometry.Scheme.Hom.appTop
                      (CategoryTheory.Limits.pullback.fst (Fgt₂.obj U).hom f)) r₀)
                  (e m)) →
            ∀ (σ : ↑((C₁.obj AM).obj.obj (Opposite.op (B.obj U))))
              (L : M →ₗ[↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤))] M),
              (∀ m : M, e (L m) = ι₁ (B.obj U) σ * e m) →
              ι₂ U ((τM'.hom.app (Opposite.op U)) σ) =
                ((LinearMap.toMatrix bM bM) L).det) →
          τM' = τM) ∧
        let ηM : Quiver.Hom (C₂.obj AM) (P_push.obj (C₁.obj AM)) :=
          (adj₂.homEquiv AM (P_push.obj (C₁.obj AM))).symm
            (CategoryTheory.CategoryStruct.comp (adj₁.unit.app AM)
              ((C₁.obj AM).obj.map (Opposite.op (hT₁.from (B.obj T₂)))))
        CategoryTheory.CategoryStruct.comp ηM τM =
          δ • CategoryTheory.CategoryStruct.id (C₂.obj AM) :=
by
  classical
  letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) f :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  intro B Fgt₁ Fgt₂ J₁ J₂ AM C₁ C₂ kMap₁ kMap₂
    hCont T₁ hT₁ T₂ hT₂ ι₁ ι₂ P_push adj₁ adj₂
    hInj₁ hInj₂ hSurj₂ hMul₁ hMul₂ hNat₁ hNat₂ hNorm₁ hNorm₂

  
  
  
  have hA_ex : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M : Type u) [AddCommGroup M] [Module R M] (e : M ≃+ S),
      (∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m) →
      ∀ u : S, ∃ L : M →ₗ[R] M, ∀ m : M, e (L m) = u * e m := by
    intro R S _ _ ρ M _ _ e he u
    refine ⟨{
      toFun := fun m => e.symm (u * e m)
      map_add' := fun m₁ m₂ => by rw [map_add, mul_add, map_add]
      map_smul' := fun r₀ m => e.injective (by
        simp only [RingHom.id_apply, AddEquiv.apply_symm_apply, he]
        exact mul_left_comm u (ρ r₀) (e m)) },
      fun m => e.apply_symm_apply (u * e m)⟩

  have hA_indep : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M₁ : Type u) [AddCommGroup M₁] [Module R M₁]
      (bM₁ : Module.Basis (Fin δ) R M₁) (e₁ : M₁ ≃+ S)
      (_ : ∀ (r₀ : R) (m : M₁), e₁ (r₀ • m) = ρ r₀ * e₁ m)
      (M₂ : Type u) [AddCommGroup M₂] [Module R M₂]
      (bM₂ : Module.Basis (Fin δ) R M₂) (e₂ : M₂ ≃+ S)
      (_ : ∀ (r₀ : R) (m : M₂), e₂ (r₀ • m) = ρ r₀ * e₂ m)
      (u : S) (L₁ : M₁ →ₗ[R] M₁) (L₂ : M₂ →ₗ[R] M₂),
      (∀ m : M₁, e₁ (L₁ m) = u * e₁ m) →
      (∀ m : M₂, e₂ (L₂ m) = u * e₂ m) →
      ((LinearMap.toMatrix bM₁ bM₁) L₁).det = ((LinearMap.toMatrix bM₂ bM₂) L₂).det := by
    intro R S _ _ ρ M₁ _ _ bM₁ e₁ he₁ M₂ _ _ bM₂ e₂ he₂ u L₁ L₂ hL₁ hL₂
    let Φ : M₁ ≃ₗ[R] M₂ :=
      { e₁.trans e₂.symm with
        map_smul' := fun r₀ m₁ => e₂.injective (by
          change e₂ (e₂.symm (e₁ (r₀ • m₁))) = e₂ (r₀ • e₂.symm (e₁ m₁))
          rw [e₂.apply_symm_apply, he₁, he₂, e₂.apply_symm_apply]) }
    have hΦ_apply : ∀ m₁ : M₁, e₂ (Φ m₁) = e₁ m₁ :=
      fun m₁ => e₂.apply_symm_apply (e₁ m₁)
    have hΦ_conj : ∀ m₁ : M₁, Φ.symm (L₂ (Φ m₁)) = L₁ m₁ := by
      intro m₁
      apply Φ.injective
      rw [Φ.apply_symm_apply]
      apply e₂.injective
      rw [hL₂, hΦ_apply, ← hL₁, hΦ_apply]
    let b' : Module.Basis (Fin δ) R M₂ := bM₁.map Φ
    have hMat : (LinearMap.toMatrix b' b') L₂ = (LinearMap.toMatrix bM₁ bM₁) L₁ := by
      ext i j
      simp only [LinearMap.toMatrix_apply, b', Module.Basis.map_repr, Module.Basis.map_apply,
        LinearEquiv.trans_apply, hΦ_conj]
    rw [← hMat]
    exact LinearMap.det_toMatrix_eq_det_toMatrix b' bM₂ L₂

  have hA_mul : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M : Type u) [AddCommGroup M] [Module R M]
      (bM : Module.Basis (Fin δ) R M) (e : M ≃+ S)
      (_ : ∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m)
      (u₁ u₂ : S) (L₁ L₂ L₁₂ : M →ₗ[R] M),
      (∀ m : M, e (L₁ m) = u₁ * e m) →
      (∀ m : M, e (L₂ m) = u₂ * e m) →
      (∀ m : M, e (L₁₂ m) = (u₁ * u₂) * e m) →
      ((LinearMap.toMatrix bM bM) L₁₂).det =
        ((LinearMap.toMatrix bM bM) L₁).det * ((LinearMap.toMatrix bM bM) L₂).det := by
    intro R S _ _ _ M _ _ bM e _ u₁ u₂ L₁ L₂ L₁₂ hL₁ hL₂ hL₁₂
    have hcomp : L₁₂ = L₁.comp L₂ := by
      ext m
      apply e.injective
      rw [hL₁₂, LinearMap.comp_apply, hL₁, hL₂, mul_assoc]
    rw [hcomp, LinearMap.toMatrix_comp bM bM bM L₁ L₂, Matrix.det_mul]

  have hA_pow : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M : Type u) [AddCommGroup M] [Module R M]
      (bM : Module.Basis (Fin δ) R M) (e : M ≃+ S)
      (_ : ∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m)
      (u : S) (L : M →ₗ[R] M),
      u ^ n = 1 →
      (∀ m : M, e (L m) = u * e m) →
      (((LinearMap.toMatrix bM bM) L).det) ^ n = 1 := by
    intro R S _ _ _ M _ _ bM e _ u L hu hL
    let P : ℕ → (M →ₗ[R] M) := fun k => Nat.rec LinearMap.id (fun _ pk => L.comp pk) k
    have hP : ∀ k : ℕ, (∀ m : M, e (P k m) = u ^ k * e m) ∧
        ((LinearMap.toMatrix bM bM) (P k)).det = (((LinearMap.toMatrix bM bM) L).det) ^ k := by
      intro k
      induction k with
      | zero =>
        refine ⟨fun m => by simp [P], ?_⟩
        simp [P, LinearMap.toMatrix_id, Matrix.det_one]
      | succ k ih =>
        refine ⟨fun m => ?_, ?_⟩
        · change e (L (P k m)) = u ^ (k + 1) * e m
          rw [hL, ih.1, ← mul_assoc, ← pow_succ']
        · change ((LinearMap.toMatrix bM bM) (L.comp (P k))).det =
            (((LinearMap.toMatrix bM bM) L).det) ^ (k + 1)
          rw [LinearMap.toMatrix_comp bM bM bM L (P k), Matrix.det_mul, ih.2, pow_succ']
    have hPn_id : P n = LinearMap.id := by
      ext m
      apply e.injective
      rw [(hP n).1 m, hu, one_mul, LinearMap.id_apply]
    rw [← (hP n).2, hPn_id, LinearMap.toMatrix_id, Matrix.det_one]

  have hA_smul : ∀ {R S : Type u} [CommRing R] [CommRing S] (ρ : R →+* S)
      (M : Type u) [AddCommGroup M] [Module R M]
      (bM : Module.Basis (Fin δ) R M) (e : M ≃+ S)
      (_ : ∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m)
      (r₀ : R) (L : M →ₗ[R] M),
      (∀ m : M, e (L m) = ρ r₀ * e m) →
      ((LinearMap.toMatrix bM bM) L).det = r₀ ^ δ := by
    intro R S _ _ _ M _ _ bM e he r₀ L hL
    have hLid : L = r₀ • LinearMap.id := by
      ext m
      apply e.injective
      rw [hL, LinearMap.smul_apply, LinearMap.id_apply, he]
    rw [hLid, map_smul, LinearMap.toMatrix_id, Matrix.det_smul, Matrix.det_one,
      Fintype.card_fin, mul_one]

  have hA_bc : ∀ {R R' S S' : Type u} [CommRing R] [CommRing R'] [CommRing S] [CommRing S']
      (ρ : R →+* S) (ρ' : R' →+* S') (ψ_R : R →+* R') (ψ_S : S →+* S'),
      letI : Algebra R R' := RingHom.toAlgebra ψ_R
      letI : Algebra R S := RingHom.toAlgebra ρ
      ρ'.comp ψ_R = ψ_S.comp ρ →
      ∀ (e_tensor : TensorProduct R R' S ≃+ S'),
        (∀ (r' : R') (s : S), e_tensor (r' ⊗ₜ[R] s) = ρ' r' * ψ_S s) →
        ∀ (M : Type u) [AddCommGroup M] [Module R M]
          (bM : Module.Basis (Fin δ) R M) (e : M ≃+ S)
          (_ : ∀ (r₀ : R) (m : M), e (r₀ • m) = ρ r₀ * e m)
          (M' : Type u) [AddCommGroup M'] [Module R' M']
          (bM' : Module.Basis (Fin δ) R' M') (e' : M' ≃+ S')
          (_ : ∀ (r₀' : R') (m' : M'), e' (r₀' • m') = ρ' r₀' * e' m')
          (u : S) (L : M →ₗ[R] M) (L' : M' →ₗ[R'] M'),
          (∀ m : M, e (L m) = u * e m) →
          (∀ m' : M', e' (L' m') = ψ_S u * e' m') →
          ((LinearMap.toMatrix bM' bM') L').det = ψ_R (((LinearMap.toMatrix bM bM) L).det) := by
    intro R R' S S' _ _ _ _ ρ ρ' ψ_R ψ_S h_comm e_tensor he_tensor
      M _ _ bM e he M' _ _ bM' e' he' u L L' hL hL'
    letI : Algebra R R' := RingHom.toAlgebra ψ_R
    letI : Algebra R S := RingHom.toAlgebra ρ
    let e_lin : M ≃ₗ[R] S :=
      { e with
        map_smul' := fun r₀ m => by
          change e (r₀ • m) = ρ r₀ * e m
          exact he r₀ m }
    let M'₀ : Type u := TensorProduct R R' M
    let bM'₀ : Module.Basis (Fin δ) R' M'₀ := bM.baseChange R'
    let e'₀ : M'₀ ≃+ S' := (LinearEquiv.baseChange R R' M S e_lin).toAddEquiv.trans e_tensor
    let L'₀ : M'₀ →ₗ[R'] M'₀ := LinearMap.baseChange R' L
    have he'₀_tmul : ∀ (r' : R') (m : M), e'₀ (r' ⊗ₜ[R] m) = ρ' r' * ψ_S (e m) := by
      intro r' m
      change e_tensor ((LinearEquiv.baseChange R R' M S e_lin) (r' ⊗ₜ[R] m)) = ρ' r' * ψ_S (e m)
      rw [LinearEquiv.baseChange_tmul]
      exact he_tensor r' (e m)
    have he'₀_smul : ∀ (r₀' : R') (m'₀ : M'₀), e'₀ (r₀' • m'₀) = ρ' r₀' * e'₀ m'₀ := by
      intro r₀' m'₀
      refine TensorProduct.induction_on (motive := fun m'₀ => e'₀ (r₀' • m'₀) = ρ' r₀' * e'₀ m'₀) m'₀ ?_ ?_ ?_
      · simp only [smul_zero, map_zero, mul_zero]
      · intro r'₁ m
        rw [TensorProduct.smul_tmul', smul_eq_mul, he'₀_tmul, he'₀_tmul, map_mul, mul_assoc]
      · intro x y ihx ihy
        rw [smul_add, map_add, ihx, ihy, map_add, mul_add]
    have hL'₀ : ∀ m'₀ : M'₀, e'₀ (L'₀ m'₀) = ψ_S u * e'₀ m'₀ := by
      intro m'₀
      refine TensorProduct.induction_on (motive := fun m'₀ => e'₀ (L'₀ m'₀) = ψ_S u * e'₀ m'₀) m'₀ ?_ ?_ ?_
      · simp only [map_zero, mul_zero]
      · intro r'₁ m
        change e'₀ (LinearMap.baseChange R' L (r'₁ ⊗ₜ[R] m)) = ψ_S u * e'₀ (r'₁ ⊗ₜ[R] m)
        rw [LinearMap.baseChange_tmul, he'₀_tmul, hL, map_mul, he'₀_tmul]
        exact mul_left_comm (ρ' r'₁) (ψ_S u) (ψ_S (e m))
      · intro x y ihx ihy
        rw [map_add, map_add, ihx, ihy, map_add, mul_add]
    have h_eq1 : ((LinearMap.toMatrix bM' bM') L').det = ((LinearMap.toMatrix bM'₀ bM'₀) L'₀).det :=
      hA_indep ρ' M' bM' e' he' M'₀ bM'₀ e'₀ he'₀_smul (ψ_S u) L' L'₀ hL' hL'₀
    letI : Module.Free R M := Module.Free.of_basis bM
    letI : Module.Finite R M := Module.Finite.of_basis bM
    rw [h_eq1, LinearMap.det_toMatrix bM'₀ L'₀]
    change LinearMap.det (LinearMap.baseChange R' L) = ψ_R (((LinearMap.toMatrix bM bM) L).det)
    rw [LinearMap.det_baseChange L, ← LinearMap.det_toMatrix bM L]
    rfl

  
  
  
  have hB_aff_pb : ∀ {P Z₁ Z₂ Z₀ : AlgebraicGeometry.Scheme.{u}}
      [AlgebraicGeometry.IsAffine P] [AlgebraicGeometry.IsAffine Z₁]
      [AlgebraicGeometry.IsAffine Z₂] [AlgebraicGeometry.IsAffine Z₀]
      {p₁ : P ⟶ Z₁} {p₂ : P ⟶ Z₂} {f₁ : Z₁ ⟶ Z₀} {f₂ : Z₂ ⟶ Z₀}
      (hPB : CategoryTheory.IsPullback p₁ p₂ f₁ f₂),
      let R₀ := ↑(Z₀.presheaf.obj (Opposite.op ⊤))
      let R₁ := ↑(Z₁.presheaf.obj (Opposite.op ⊤))
      let R₂ := ↑(Z₂.presheaf.obj (Opposite.op ⊤))
      let R_P := ↑(P.presheaf.obj (Opposite.op ⊤))
      let φ₁ : R₀ →+* R₁ := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f₁)
      let φ₂ : R₀ →+* R₂ := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop f₂)
      let π₁ : R₁ →+* R_P := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop p₁)
      let π₂ : R₂ →+* R_P := CommRingCat.Hom.hom (AlgebraicGeometry.Scheme.Hom.appTop p₂)
      letI : Algebra R₀ R₁ := RingHom.toAlgebra φ₁
      letI : Algebra R₀ R₂ := RingHom.toAlgebra φ₂
      π₁.comp φ₁ = π₂.comp φ₂ ∧
      ∃ e_tensor : TensorProduct R₀ R₁ R₂ ≃+ R_P,
        ∀ (r₁ : R₁) (r₂ : R₂), e_tensor (r₁ ⊗ₜ[R₀] r₂) = π₁ r₁ * π₂ r₂ := by
    intro P Z₁ Z₂ Z₀ _ _ _ _ p₁ p₂ f₁ f₂ hPB
    let A₀ := Z₀.presheaf.obj (Opposite.op ⊤)
    let A₁ := Z₁.presheaf.obj (Opposite.op ⊤)
    let A₂ := Z₂.presheaf.obj (Opposite.op ⊤)
    let A_P := P.presheaf.obj (Opposite.op ⊤)
    let R₀ : Type u := ↑A₀
    let R₁ : Type u := ↑A₁
    let R₂ : Type u := ↑A₂
    let R_P : Type u := ↑A_P
    let φ₁ : R₀ →+* R₁ := CommRingCat.Hom.hom f₁.appTop
    let φ₂ : R₀ →+* R₂ := CommRingCat.Hom.hom f₂.appTop
    let π₁ : R₁ →+* R_P := CommRingCat.Hom.hom p₁.appTop
    let π₂ : R₂ →+* R_P := CommRingCat.Hom.hom p₂.appTop
    letI : Algebra R₀ R₁ := RingHom.toAlgebra φ₁
    letI : Algebra R₀ R₂ := RingHom.toAlgebra φ₂
    have h_comm_ring : π₁.comp φ₁ = π₂.comp φ₂ := by
      have hw := congrArg AlgebraicGeometry.Scheme.Hom.appTop hPB.w
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop] at hw
      exact congrArg CommRingCat.Hom.hom hw
    refine ⟨h_comm_ring, ?_⟩
    let g₁ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₁))
    let g₂ : AlgebraicGeometry.Spec (CommRingCat.of R₂) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₀ R₂))
    have hg₁ : g₁ = AlgebraicGeometry.Spec.map f₁.appTop := rfl
    have hg₂ : g₂ = AlgebraicGeometry.Spec.map f₂.appTop := rfl
    have hu_comm : (p₁ ≫ Z₁.isoSpec.hom) ≫ g₁ = (p₂ ≫ Z₂.isoSpec.hom) ≫ g₂ := by
      rw [Category.assoc, Category.assoc, hg₁, hg₂,
        AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₁,
        AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₂,
        ← Category.assoc, ← Category.assoc, hPB.w]
    let PB := CategoryTheory.Limits.pullback g₁ g₂
    let u_pb : P ⟶ PB := CategoryTheory.Limits.pullback.lift
      (p₁ ≫ Z₁.isoSpec.hom) (p₂ ≫ Z₂.isoSpec.hom) hu_comm
    have hv_comm : (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv) ≫ f₁ =
        (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv) ≫ f₂ := by
      rw [← cancel_mono Z₀.isoSpec.hom]
      calc
        ((CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv) ≫ f₁) ≫ Z₀.isoSpec.hom
          = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv ≫
              (Z₁.isoSpec.hom ≫ AlgebraicGeometry.Spec.map f₁.appTop) := by
            rw [Category.assoc, Category.assoc, AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₁]
        _ = CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ g₁ := by
            rw [← Category.assoc Z₁.isoSpec.inv, Z₁.isoSpec.inv_hom_id, Category.id_comp, hg₁]
        _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ g₂ := CategoryTheory.Limits.pullback.condition
        _ = CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv ≫
              (Z₂.isoSpec.hom ≫ AlgebraicGeometry.Spec.map f₂.appTop) := by
            rw [← Category.assoc Z₂.isoSpec.inv, Z₂.isoSpec.inv_hom_id, Category.id_comp, hg₂]
        _ = ((CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv) ≫ f₂) ≫ Z₀.isoSpec.hom := by
            rw [Category.assoc, Category.assoc, AlgebraicGeometry.Scheme.isoSpec_hom_naturality f₂]
    let v_pb : PB ⟶ P := hPB.lift
      (CategoryTheory.Limits.pullback.fst g₁ g₂ ≫ Z₁.isoSpec.inv)
      (CategoryTheory.Limits.pullback.snd g₁ g₂ ≫ Z₂.isoSpec.inv) hv_comm
    let e_pb : P ≅ PB :=
      { hom := u_pb
        inv := v_pb
        hom_inv_id := hPB.hom_ext
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, hPB.lift_fst, ← Category.assoc,
              CategoryTheory.Limits.pullback.lift_fst, Category.assoc,
              Iso.hom_inv_id, Category.comp_id, Category.id_comp])
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, hPB.lift_snd, ← Category.assoc,
              CategoryTheory.Limits.pullback.lift_snd, Category.assoc,
              Iso.hom_inv_id, Category.comp_id, Category.id_comp])
        inv_hom_id := CategoryTheory.Limits.pullback.hom_ext
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
              ← Category.assoc, hPB.lift_fst, Category.assoc,
              Iso.inv_hom_id, Category.comp_id, Category.id_comp])
          (by
            dsimp [u_pb, v_pb]
            rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
              ← Category.assoc, hPB.lift_snd, Category.assoc,
              Iso.inv_hom_id, Category.comp_id, Category.id_comp]) }
    let T_cat : CommRingCat.{u} := CommRingCat.of (TensorProduct R₀ R₁ R₂)
    let e_sch : P ≅ AlgebraicGeometry.Spec T_cat :=
      e_pb ≪≫ AlgebraicGeometry.pullbackSpecIso R₀ R₁ R₂
    have he_fst : e_sch.hom ≫
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
        p₁ ≫ Z₁.toSpecΓ := by
      dsimp [e_sch, e_pb, u_pb]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst R₀ R₁ R₂,
        CategoryTheory.Limits.pullback.lift_fst]
      rfl
    have he_snd : e_sch.hom ≫
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] TensorProduct R₀ R₁ R₂).toRingHom) =
        p₂ ≫ Z₂.toSpecΓ := by
      dsimp [e_sch, e_pb, u_pb]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_snd R₀ R₁ R₂,
        CategoryTheory.Limits.pullback.lift_snd]
      rfl
    let Φ_hom : T_cat ⟶ A_P :=
      (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).inv ≫ e_sch.hom.appTop
    let Φ_inv : A_P ⟶ T_cat :=
      e_sch.inv.appTop ≫ (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).hom
    let Φ_iso : T_cat ≅ A_P :=
      { hom := Φ_hom
        inv := Φ_inv
        hom_inv_id := by
          dsimp [Φ_hom, Φ_inv]
          rw [Category.assoc, ← Category.assoc e_sch.hom.appTop,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.inv_hom_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop, Category.id_comp, Iso.inv_hom_id]
        inv_hom_id := by
          dsimp [Φ_hom, Φ_inv]
          rw [Category.assoc, ← Category.assoc (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).hom,
            Iso.hom_inv_id, Category.id_comp,
            ← AlgebraicGeometry.Scheme.Hom.comp_appTop, e_sch.hom_inv_id,
            AlgebraicGeometry.Scheme.Hom.id_appTop] }
    have hΦ_left : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ Φ_hom = p₁.appTop := by
      let h_inc₁ : A₁ ⟶ T_cat := CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
      change h_inc₁ ≫ Φ_hom = p₁.appTop
      rw [← Iso.cancel_iso_hom_left (AlgebraicGeometry.Scheme.ΓSpecIso A₁)]
      have h1 := congrArg AlgebraicGeometry.Scheme.Hom.appTop he_fst
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.toSpecΓ_appTop] at h1
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality h_inc₁
      have hnat' : (AlgebraicGeometry.Spec.map h_inc₁).appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso A₁).hom ≫ h_inc₁ ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).inv := by
        rw [← Iso.cancel_iso_hom_right _ _ (AlgebraicGeometry.Scheme.ΓSpecIso T_cat), hnat]
        simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      change (AlgebraicGeometry.Spec.map h_inc₁).appTop ≫ e_sch.hom.appTop =
        (AlgebraicGeometry.Scheme.ΓSpecIso A₁).hom ≫ p₁.appTop at h1
      rw [hnat'] at h1
      simpa only [Φ_hom, h_inc₁, Category.assoc] using h1
    have hΦ_right : CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] TensorProduct R₀ R₁ R₂).toRingHom ≫ Φ_hom =
        p₂.appTop := by
      rw [← Iso.cancel_iso_hom_left (AlgebraicGeometry.Scheme.ΓSpecIso A₂)]
      have h2 := congrArg AlgebraicGeometry.Scheme.Hom.appTop he_snd
      rw [AlgebraicGeometry.Scheme.Hom.comp_appTop, AlgebraicGeometry.Scheme.Hom.comp_appTop,
        AlgebraicGeometry.Scheme.toSpecΓ_appTop] at h2
      let h_inc : A₂ ⟶ T_cat := CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : R₂ →ₐ[R₀] TensorProduct R₀ R₁ R₂).toRingHom
      have hnat := AlgebraicGeometry.Scheme.ΓSpecIso_naturality h_inc
      have hnat' : (AlgebraicGeometry.Spec.map h_inc).appTop =
          (AlgebraicGeometry.Scheme.ΓSpecIso A₂).hom ≫ h_inc ≫
            (AlgebraicGeometry.Scheme.ΓSpecIso T_cat).inv := by
        rw [← Iso.cancel_iso_hom_right _ _ (AlgebraicGeometry.Scheme.ΓSpecIso T_cat), hnat]
        simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [hnat'] at h2
      simpa only [Φ_hom, h_inc, Category.assoc] using h2
    refine ⟨Φ_iso.commRingCatIsoToRingEquiv.toAddEquiv, fun r₁ r₂ => ?_⟩
    change Φ_hom.hom (r₁ ⊗ₜ[R₀] r₂) = π₁ r₁ * π₂ r₂
    have h_mul : (r₁ ⊗ₜ[R₀] (1 : R₂)) * ((1 : R₁) ⊗ₜ[R₀] r₂) = r₁ ⊗ₜ[R₀] r₂ := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [← h_mul, map_mul]
    have hl : Φ_hom.hom (r₁ ⊗ₜ[R₀] (1 : R₂)) = π₁ r₁ :=
      congrArg (fun ψ => ψ.hom r₁) hΦ_left
    have hr : Φ_hom.hom ((1 : R₁) ⊗ₜ[R₀] r₂) = π₂ r₂ :=
      congrArg (fun ψ => ψ.hom r₂) hΦ_right
    rw [hl, hr]

  letI : AlgebraicGeometry.IsAffineHom f := hf_free.1.toIsAffineHom

  let Good : Y₂.left.Etale → Prop := fun U =>
    AlgebraicGeometry.IsAffine (Fgt₂.obj U).left ∧
    ∃ (M : Type u) (_ : AddCommGroup M)
      (_ : Module ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
      (_ : Module.Basis (Fin δ) ↑(((Fgt₂.obj U).left).presheaf.obj (Opposite.op ⊤)) M)
      (e : M ≃+ ↑(((Fgt₁.obj (B.obj U)).left).presheaf.obj (Opposite.op ⊤))),
