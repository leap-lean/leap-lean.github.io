      obtain ⟨hDom_stalkQ, hDVR_stalkQ⟩ :=
        hDVR_P1.2.1 (weilEtaleIdTerminal P1_over.left) ⟨Q₀.1, Q₀.2⟩
      obtain ⟨hDom_stalkP, hDVR_stalkP⟩ :=
        hDVR_C.2.1 (weilEtaleIdTerminal C_bar.left) ⟨P₀.1, P₀.2⟩
      change IsDomain ↑(P1_over.left.presheaf.stalk (q_pt : ↥P1_over.left)) at hDom_stalkQ
      change @IsDiscreteValuationRing ↑(P1_over.left.presheaf.stalk (q_pt : ↥P1_over.left)) _ hDom_stalkQ
