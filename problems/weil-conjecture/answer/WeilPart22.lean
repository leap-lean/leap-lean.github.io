              (((δ_q Q₂).hom.app (Opposite.op (M_h₂.obj T₀))).hom
                ((R_Q₂'.obj.map (Opposite.op σ₂_hom)).hom ι_Q₂')) =
            (R_Q₂.obj.map (Opposite.op (e_E_of T₀).hom)).hom
              ((R_Q₂.obj.map (Opposite.op (M_q.map σ₂_hom))).hom ι_Q₂) :=
          congrArg (R_Q₂.obj.map (Opposite.op (e_E_of T₀).hom)).hom
            ((hSheafHomYoneda X' σ₂_hom (δ_q Q₂)).trans
              (congrArg ((res_q.obj R_Q₂).obj.map (Opposite.op σ₂_hom)).hom hd_q₂))
        have stepR3 : (R_Q₂.obj.map (Opposite.op (e_E_of T₀).hom)).hom
              ((R_Q₂.obj.map (Opposite.op (M_q.map σ₂_hom))).hom ι_Q₂) =
            (R_Q₂.obj.map (Opposite.op ((e_E_of T₀).hom ≫ M_q.map σ₂_hom))).hom ι_Q₂ :=
          (congrArg (fun m => m.hom ι_Q₂)
            (R_Q₂.obj.map_comp (Opposite.op (M_q.map σ₂_hom))
              (Opposite.op (e_E_of T₀).hom))).symm
        have hMorEq : M_q.map σ₁.hom ≫ (τ₁.hom ≫ τ₂.inv) =
            (e_E_of T₀).hom ≫ M_q.map σ₂_hom :=
          CategoryTheory.MorphismProperty.Comma.Hom.ext
            ((congrArg (· ≫ (τ₁.hom.left ≫ τ₂.inv.left))
              (CategoryTheory.Category.id_comp τ₁.inv.left)).trans
              ((CategoryTheory.Category.assoc τ₁.inv.left τ₁.hom.left τ₂.inv.left).symm.trans
                ((congrArg (· ≫ τ₂.inv.left)
                  (congrArg (fun (k : Q₀ ⟶ Q₀) => k.left) τ₁.inv_hom_id)).trans
                  ((CategoryTheory.Category.id_comp τ₂.inv.left).trans
                    ((CategoryTheory.Category.id_comp τ₂.inv.left).symm.trans
                      (CategoryTheory.Category.id_comp (𝟙 X₀ ≫ τ₂.inv.left)).symm)))))
            (Subsingleton.elim _ _)
        exact (stepL0.trans (stepL1.trans (stepL2.trans (stepL3.trans stepL4)))).trans
          ((congrArg (fun k => (R_Q₂.obj.map (Opposite.op k)).hom ι_Q₂) hMorEq).trans
            (stepR0.trans (stepR1.trans (stepR2.trans stepR3))).symm)

      let Φ_off : res_h₂.obj F₁ ⟶ res_h₁.obj F₂ :=
        res_h₂.map ι ≫ Θ.app G ≫ res_h₁.map ρ
      have hΦ_zero : Φ_off = 0 := by
        apply CategoryTheory.Sheaf.hom_ext
        refine CategoryTheory.NatTrans.ext (funext fun opE => ?_)
        let E : X₀.Etale := Opposite.unop opE
        change ι.hom.app (Opposite.op (M_h₂.obj E)) ≫
          (G.obj.map (Opposite.op (e_E_of E).hom) ≫
            ρ.hom.app (Opposite.op (M_h₁.obj E))) = 0
        apply hAnn_E (M_h₁.obj E) (M_h₂.obj E) (e_E_of E)
        intro T t hT hEq
        let π₀ : X₀ ⟶ U'₁.left := CategoryTheory.Limits.pullback.fst (U'₁.hom ≫ p) f
        apply hDisj_U' (t ≫ E.hom ≫ π₀) hT
        have hPost_f' := congrArg (· ≫ f') hEq
        have hL_f' : (t ≫ (M_h₁.obj E).hom) ≫ f' = (t ≫ E.hom ≫ π₀) ≫ U'₁.hom := by
          have hQ₁_f' : Q₁.hom ≫ f' =
              CategoryTheory.Limits.pullback.fst U'₁.hom f' ≫ U'₁.hom :=
            CategoryTheory.Limits.pullback.condition.symm
          have hτ₁_fst : τ₁.inv.left ≫ CategoryTheory.Limits.pullback.fst U'₁.hom f' = π₀ :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hInner₁ : (τ₁.inv.left ≫ Q₁.hom) ≫ f' = π₀ ≫ U'₁.hom :=
            (CategoryTheory.Category.assoc τ₁.inv.left Q₁.hom f').trans
              ((congrArg (τ₁.inv.left ≫ ·) hQ₁_f').trans
                ((CategoryTheory.Category.assoc τ₁.inv.left
                  (CategoryTheory.Limits.pullback.fst U'₁.hom f') U'₁.hom).symm.trans
                  (congrArg (· ≫ U'₁.hom) hτ₁_fst)))
          exact (CategoryTheory.Category.assoc t (E.hom ≫ (τ₁.inv.left ≫ Q₁.hom)) f').trans
            ((congrArg (t ≫ ·)
              ((CategoryTheory.Category.assoc E.hom (τ₁.inv.left ≫ Q₁.hom) f').trans
                ((congrArg (E.hom ≫ ·) hInner₁).trans
                  (CategoryTheory.Category.assoc E.hom π₀ U'₁.hom).symm))).trans
              (CategoryTheory.Category.assoc t (E.hom ≫ π₀) U'₁.hom).symm)
        have hR_f' : (t ≫ ((e_E_of E).hom.left ≫ (M_h₂.obj E).hom)) ≫ f' =
            (t ≫ E.hom ≫ π₀) ≫ (e_U'.hom.left ≫ U'₂.hom) := by
          have hQ₂_f' : Q₂.hom ≫ f' =
              CategoryTheory.Limits.pullback.fst U'₂.hom f' ≫ U'₂.hom :=
            CategoryTheory.Limits.pullback.condition.symm
          have hθ₂_fst : (θ_pb.app U'₂).inv.left ≫ CategoryTheory.Limits.pullback.fst U'₂.hom f' =
              CategoryTheory.Limits.pullback.fst (U'₂.hom ≫ p) f :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hBf_fst : (B_f.map e_U'.hom).left ≫
              CategoryTheory.Limits.pullback.fst (U'₂.hom ≫ p) f = π₀ ≫ e_U'.hom.left :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          let c₁ := (B_f.map e_U'.hom).left
          let c₂ := (θ_pb.app U'₂).inv.left
          have hInner₂ : ((c₁ ≫ c₂) ≫ Q₂.hom) ≫ f' = π₀ ≫ (e_U'.hom.left ≫ U'₂.hom) :=
            (CategoryTheory.Category.assoc (c₁ ≫ c₂) Q₂.hom f').trans
              ((congrArg ((c₁ ≫ c₂) ≫ ·) hQ₂_f').trans
                ((CategoryTheory.Category.assoc (c₁ ≫ c₂)
                  (CategoryTheory.Limits.pullback.fst U'₂.hom f') U'₂.hom).symm.trans
                  ((congrArg (· ≫ U'₂.hom)
                    ((CategoryTheory.Category.assoc c₁ c₂ _).trans
                      ((congrArg (c₁ ≫ ·) hθ₂_fst).trans hBf_fst))).trans
                    (CategoryTheory.Category.assoc π₀ e_U'.hom.left U'₂.hom))))
          exact (congrArg (fun m => (t ≫ m) ≫ f')
              (CategoryTheory.Category.id_comp (E.hom ≫ ((c₁ ≫ c₂) ≫ Q₂.hom)))).trans
            ((CategoryTheory.Category.assoc t (E.hom ≫ ((c₁ ≫ c₂) ≫ Q₂.hom)) f').trans
              ((congrArg (t ≫ ·)
                ((CategoryTheory.Category.assoc E.hom ((c₁ ≫ c₂) ≫ Q₂.hom) f').trans
                  ((congrArg (E.hom ≫ ·) hInner₂).trans
                    (CategoryTheory.Category.assoc E.hom π₀
                      (e_U'.hom.left ≫ U'₂.hom)).symm))).trans
                (CategoryTheory.Category.assoc t (E.hom ≫ π₀)
                  (e_U'.hom.left ≫ U'₂.hom)).symm))
        exact hL_f'.symm.trans (hPost_f'.trans hR_f')

      rw [hz₁_unfold,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_h₁ _
          (CategoryTheory.Abelian.Ext.mk₀ ρ) (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_h₁
          (CategoryTheory.Abelian.Ext.mk₀ (δ_q Q₁)) _ (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_q
          (CategoryTheory.Abelian.Ext.mk₀ ((R_fun X).map (τ₁.hom ≫ τ₂.inv))) ξ₂ (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_h₁ _ _ (Nat.zero_add q),
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← h_s3.1 res_q res_h₁ q ξ₂,
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ δ'_h₁) _
          (CategoryTheory.Abelian.Ext.mk₀ (res_h₁.map ρ))
          (Nat.zero_add q) (Nat.add_zero q) (by omega),
        ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ δ'_h₁)
          (CategoryTheory.Abelian.Ext.mk₀ (res_h₁.map (δ_q Q₁))) _
          (Nat.zero_add 0) (Nat.zero_add q) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀
            (res_h₁.map (res_q.map ((R_fun X).map (τ₁.hom ≫ τ₂.inv))))) _
          (Nat.zero_add 0) (Nat.zero_add q) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Category.assoc δ'_h₁,
        hYonedaBridge,
        ← CategoryTheory.Category.assoc δ'_h₂ (res_h₂.map (δ_q Q₂))
          (Θ.app (weilPolyP1CohomologyRepSheaf X (M_q.obj Q₂))),
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (δ'_h₂ ≫ res_h₂.map (δ_q Q₂))
          (Θ.app (weilPolyP1CohomologyRepSheaf X (M_q.obj Q₂))),
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (δ'_h₂ ≫ res_h₂.map (δ_q Q₂)))
          (CategoryTheory.Abelian.Ext.mk₀ (Θ.app _))
          (CategoryTheory.Abelian.Ext.mapExactFunctor (CategoryTheory.Functor.comp res_q res_h₁) ξ₂)
          (Nat.zero_add 0) (Nat.zero_add q) (by omega),
        h_s3.2 (CategoryTheory.Functor.comp res_q res_h₂)
          (CategoryTheory.Functor.comp res_q res_h₁) Θ q ξ₂,
        h_s3.1 res_q res_h₂ q ξ₂,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (δ'_h₂ ≫ res_h₂.map (δ_q Q₂)))
          (CategoryTheory.Abelian.Ext.mapExactFunctor res_h₂
            (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ₂))
          (CategoryTheory.Abelian.Ext.mk₀ (Θ.app G))
          (Nat.zero_add q) (Nat.add_zero q) (by omega),
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ δ'_h₂ (res_h₂.map (δ_q Q₂)),
        CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ δ'_h₂)
          (CategoryTheory.Abelian.Ext.mk₀ (res_h₂.map (δ_q Q₂))) _
          (Nat.zero_add 0) (Nat.zero_add q) (by omega),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ res_h₂ (δ_q Q₂),
        ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_h₂
          (CategoryTheory.Abelian.Ext.mk₀ (δ_q Q₂))
          (CategoryTheory.Abelian.Ext.mapExactFunctor res_q ξ₂) (Nat.zero_add q),
        hξ₂_eq,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp res_h₂ y₂
          (CategoryTheory.Abelian.Ext.mk₀ ι) (Nat.add_zero q),
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ δ'_h₂)
          (CategoryTheory.Abelian.Ext.mapExactFunctor res_h₂ y₂)
          (CategoryTheory.Abelian.Ext.mk₀ (res_h₂.map ι))
          (Nat.zero_add q) (Nat.add_zero q) (by omega),
        CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ (res_h₂.map ι))
          (CategoryTheory.Abelian.Ext.mk₀ (Θ.app G))
          (Nat.add_zero q) (Nat.zero_add 0) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.comp_assoc _
          (CategoryTheory.Abelian.Ext.mk₀ (res_h₂.map ι ≫ Θ.app G))
          (CategoryTheory.Abelian.Ext.mk₀ (res_h₁.map ρ))
          (Nat.add_zero q) (Nat.zero_add 0) (by omega),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      have hAssocΦ : (res_h₂.map ι ≫ Θ.app G) ≫ res_h₁.map ρ = Φ_off :=
        CategoryTheory.Category.assoc _ _ _
      rw [hAssocΦ, hΦ_zero, CategoryTheory.Abelian.Ext.mk₀_zero,
        CategoryTheory.Abelian.Ext.comp_zero]

    have hConclusion := hS4 hRawAnn
    let w_ι := CategoryTheory.Functor.whiskerLeft B_f'.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map ι)
    let w_ρ := CategoryTheory.Functor.whiskerLeft B_f'.op
      ((CategoryTheory.Sheaf.cohomologyPresheafFunctor X'.smallEtaleTopology q).map ρ)
    have hMapα : (sh_S'.map α_pre).hom.app (Opposite.op Z₂) =
        (weilPolyP1HigherDirectImageMap f' q ι).hom.app (Opposite.op Z₂) ≫
          (sh_S'.map (ePre q G).hom).hom.app (Opposite.op Z₂) :=
      congrArg (fun (k : sh_S'.obj P₁ ⟶ sh_S'.obj (M_p.op ⋙ P₀)) => k.hom.app (Opposite.op Z₂))
        (sh_S'.map_comp w_ι (ePre q G).hom)
    have hMapβ : (sh_S'.map β_pre).hom.app (Opposite.op Z₁) =
        (sh_S'.map (ePre q G).inv).hom.app (Opposite.op Z₁) ≫
          (weilPolyP1HigherDirectImageMap f' q ρ).hom.app (Opposite.op Z₁) :=
      congrArg (fun (k : sh_S'.obj (M_p.op ⋙ P₀) ⟶ sh_S'.obj P₂) => k.hom.app (Opposite.op Z₁))
        (sh_S'.map_comp (ePre q G).inv w_ρ)
    let iZ := (weilPolyP1HigherDirectImageMap f' q ι).hom.app (Opposite.op Z₂)
    let pZ₂ := (sh_S'.map (ePre q G).hom).hom.app (Opposite.op Z₂)
    let sZ₂ := (eSheafify_p P₀).hom.hom.app (Opposite.op Z₂)
    let gZ := (weilEtaleHigherDirectImage f q G).obj.map (Opposite.op e_Z.hom)
    let sZ₁ := (eSheafify_p P₀).inv.hom.app (Opposite.op Z₁)
    let pZ₁ := (sh_S'.map (ePre q G).inv).hom.app (Opposite.op Z₁)
    let rZ := (weilPolyP1HigherDirectImageMap f' q ρ).hom.app (Opposite.op Z₁)
    have hRearr : iZ ≫ ((pZ₂ ≫ sZ₂) ≫ (gZ ≫ ((sZ₁ ≫ pZ₁) ≫ rZ))) =
        (iZ ≫ pZ₂) ≫ (sZ₂ ≫ (gZ ≫ (sZ₁ ≫ (pZ₁ ≫ rZ)))) :=
      (congrArg (iZ ≫ ·)
        ((CategoryTheory.Category.assoc pZ₂ sZ₂ _).trans
          (congrArg (fun m => pZ₂ ≫ (sZ₂ ≫ (gZ ≫ m)))
            (CategoryTheory.Category.assoc sZ₁ pZ₁ rZ)))).trans
        (CategoryTheory.Category.assoc iZ pZ₂ _).symm
    exact hRearr.trans
      ((congrArg (· ≫ (sZ₂ ≫ (gZ ≫ (sZ₁ ≫ (pZ₁ ≫ rZ))))) hMapα.symm).trans
        ((congrArg ((sh_S'.map α_pre).hom.app (Opposite.op Z₂) ≫ ·)
          (congrArg (sZ₂ ≫ ·) (congrArg (gZ ≫ ·) (congrArg (sZ₁ ≫ ·) hMapβ.symm)))).trans
          hConclusion))

theorem weil_etale_clopen_diagonal_retraction_and_mono (k : Type u) [Field k] [IsAlgClosed k]
    (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    [AlgebraicGeometry.IsSeparated S.hom]
    {X : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S.left)
    (V : S.left.Etale)
    [AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S.left).obj V).left]
    (U : X.Etale)
    (u_rel : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj U).left
      (((weilEtaleSitePullback f).obj V).left))
    (hEt_urel : AlgebraicGeometry.Etale u_rel)
    (_hu_rel_snd : CategoryTheory.CategoryStruct.comp u_rel
      (((weilEtaleSitePullback f).obj V).hom) =
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj U).hom) :
    let S' : AlgebraicGeometry.Scheme.{u} :=
      ((AlgebraicGeometry.Scheme.Etale.forget S.left).obj V).left
    let p : Quiver.Hom S' S.left :=
      ((AlgebraicGeometry.Scheme.Etale.forget S.left).obj V).hom
    let V_top : X.Etale := (weilEtaleSitePullback f).obj V
    let X' : AlgebraicGeometry.Scheme.{u} :=
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_top).left
    let q_X : Quiver.Hom X' X :=
      ((AlgebraicGeometry.Scheme.Etale.forget X).obj V_top).hom
    let f' : Quiver.Hom X' S' := CategoryTheory.Limits.pullback.fst p f
    let M_p : CategoryTheory.Functor S'.Etale S.left.Etale := weilEtalePostcomp p V.prop
    let M_q : CategoryTheory.Functor X'.Etale X.Etale := weilEtalePostcomp q_X V_top.prop
    let U_rel : X'.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ u_rel hEt_urel
    let A : ℕ → AddCommGrpCat.{u} :=
      fun m => AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let mapCoeff : ∀ {m₁ m₂ : ℕ}, Quiver.Hom (A m₁) (A m₂) →
        ∀ (Z : AlgebraicGeometry.Scheme.{u}) (W : Z.Etale),
          Quiver.Hom (weilEtaleLocalTorsionSheaf Z m₁ W) (weilEtaleLocalTorsionSheaf Z m₂ W) :=
      fun {_m₁ m₂} φ Z W =>
        CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
          (CategoryTheory.CategoryStruct.comp φ
            (CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf Z m₂ W))))
    ∀ (hc_p : M_p.IsContinuous S'.smallEtaleTopology S.left.smallEtaleTopology)
      (hc_q : M_q.IsContinuous X'.smallEtaleTopology X.smallEtaleTopology),
      letI := hc_p
      letI := hc_q
      let res_p := M_p.sheafPushforwardContinuous AddCommGrpCat.{u}
        S'.smallEtaleTopology S.left.smallEtaleTopology
      let res_q := M_q.sheafPushforwardContinuous AddCommGrpCat.{u}
        X'.smallEtaleTopology X.smallEtaleTopology
      ∀ (eSheafify_p : ∀ P : CategoryTheory.Functor (Opposite S.left.Etale) AddCommGrpCat.{u},
          CategoryTheory.Iso
            ((CategoryTheory.presheafToSheaf S'.smallEtaleTopology AddCommGrpCat.{u}).obj
              (CategoryTheory.Functor.comp M_p.op P))
            (res_p.obj
              ((CategoryTheory.presheafToSheaf S.left.smallEtaleTopology AddCommGrpCat.{u}).obj P)))
        (eSheafify_q : ∀ P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u},
          CategoryTheory.Iso
            ((CategoryTheory.presheafToSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).obj
              (CategoryTheory.Functor.comp M_q.op P))
            (res_q.obj
              ((CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).obj P)))
        (sliceRIso : ∀ (q : ℕ)
            (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}),
          CategoryTheory.Iso
            (weilEtaleHigherDirectImage f' q (res_q.obj F))
            (res_p.obj (weilEtaleHigherDirectImage f q F))),
        (∀ {P₁ P₂ : CategoryTheory.Functor (Opposite S.left.Etale) AddCommGrpCat.{u}}
            (α : Quiver.Hom P₁ P₂),
          CategoryTheory.CategoryStruct.comp
              ((CategoryTheory.presheafToSheaf S'.smallEtaleTopology AddCommGrpCat.{u}).map
                (CategoryTheory.Functor.whiskerLeft M_p.op α))
              (eSheafify_p P₂).hom =
            CategoryTheory.CategoryStruct.comp
              (eSheafify_p P₁).hom
              (res_p.map
                ((CategoryTheory.presheafToSheaf S.left.smallEtaleTopology AddCommGrpCat.{u}).map α))) →
        (∀ {P₁ P₂ : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}}
            (α : Quiver.Hom P₁ P₂),
          CategoryTheory.CategoryStruct.comp
              ((CategoryTheory.presheafToSheaf X'.smallEtaleTopology AddCommGrpCat.{u}).map
                (CategoryTheory.Functor.whiskerLeft M_q.op α))
              (eSheafify_q P₂).hom =
            CategoryTheory.CategoryStruct.comp
              (eSheafify_q P₁).hom
              (res_q.map
                ((CategoryTheory.presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{u}).map α))) →
        (∀ (P : CategoryTheory.Functor (Opposite S.left.Etale) AddCommGrpCat.{u}) (W₁ : S'.Etale),
          CategoryTheory.CategoryStruct.comp
              (((CategoryTheory.sheafificationAdjunction S'.smallEtaleTopology
                AddCommGrpCat.{u}).unit.app
                (CategoryTheory.Functor.comp M_p.op P)).app (Opposite.op W₁))
              ((eSheafify_p P).hom.hom.app (Opposite.op W₁)) =
            (((CategoryTheory.sheafificationAdjunction S.left.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app P).app (Opposite.op (M_p.obj W₁)))) →
        (∀ (P : CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u}) (W₂ : X'.Etale),
          CategoryTheory.CategoryStruct.comp
              (((CategoryTheory.sheafificationAdjunction X'.smallEtaleTopology
                AddCommGrpCat.{u}).unit.app
                (CategoryTheory.Functor.comp M_q.op P)).app (Opposite.op W₂))
              ((eSheafify_q P).hom.hom.app (Opposite.op W₂)) =
            (((CategoryTheory.sheafificationAdjunction X.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app P).app (Opposite.op (M_q.obj W₂)))) →
        (∀ (q : ℕ) {F₁ F₂ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
            (φ : Quiver.Hom F₁ F₂),
