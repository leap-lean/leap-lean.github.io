        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          h₂ q_X V_top.prop (by rw [hh₂_eq]; exact Q₀.prop)
      obtain ⟨hc_h₁, _, _, _⟩ := h_s1 h₁ hh₁
      obtain ⟨hc_h₂, _, _, _⟩ := h_s1 h₂ hh₂
      have := hc_h₁
      have := hc_h₂
      let M_h₁ := weilEtalePostcomp h₁ hh₁
      let M_h₂ := weilEtalePostcomp h₂ hh₂
      let res_h₁ := M_h₁.sheafPushforwardContinuous AddCommGrpCat.{u}
