          B S₁_1 _ _ hIC_B instS₁_1 hDom_S11 hIC_S11 φ₁ (algebraMap B K) ρ₁_1 ι_S₁_1
          hFrac_B rfl hFrac_S11 hρ11_k hρ11_prod
      let α_s := AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap D₂_1 (Localization.Away s))) ≫ c₂_1
      haveI : AlgebraicGeometry.IsOpenImmersion c₂_1 := hOpen_c21
      have hOpen_αs : AlgebraicGeometry.IsOpenImmersion α_s := inferInstance
      have hp_range : (p : PrimeSpectrum D₂_1) ∈
          Set.range (PrimeSpectrum.comap (algebraMap D₂_1 (Localization.Away s))) := by
        rw [PrimeSpectrum.localization_away_comap_range (Localization.Away s) s]
        exact hs_mem
      rcases hp_range with ⟨q_s, hqs⟩
      have hy_range : c₂_1.base p ∈ Set.range α_s.base :=
        ⟨q_s, (AlgebraicGeometry.Scheme.Hom.comp_apply
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap D₂_1 (Localization.Away s))))
          c₂_1 q_s).trans (congrArg c₂_1.base hqs)⟩
      have hαs_K : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_As) ≫ α_s = η_K ≫ j_B2 := by
        dsimp [α_s]
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp : CommRingCat.ofHom (algebraMap D₂_1 (Localization.Away s)) ≫
            CommRingCat.ofHom ι_As = CommRingCat.ofHom ι_D21 := CommRingCat.hom_ext hι_As
        rw [hcomp]
        exact hη_c21
      rcases hγ with ⟨γ₀, hγ₀⟩ | ⟨γ₁, hγ₁⟩
      · refine ⟨Localization.Away s, inferInstance, α_s, ι_As,
          AlgebraicGeometry.Spec.map (@CommRingCat.ofHom D₁_0 (Localization.Away s) instRingD10 _ γ₀) ≫ c₁_0,
          hOpen_αs, hy_range, hαs_K, ?_⟩
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp : @CommRingCat.ofHom D₁_0 (Localization.Away s) instRingD10 _ γ₀ ≫
            CommRingCat.ofHom ι_As =
            @CommRingCat.ofHom D₁_0 K instRingD10 _ ι_D10 := CommRingCat.hom_ext hγ₀
        rw [hcomp]
        exact hη_c10
      · refine ⟨Localization.Away s, inferInstance, α_s, ι_As,
          AlgebraicGeometry.Spec.map (@CommRingCat.ofHom D₁_1 (Localization.Away s) instRingD11 _ γ₁) ≫ c₁_1,
          hOpen_αs, hy_range, hαs_K, ?_⟩
        rw [← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp]
        have hcomp : @CommRingCat.ofHom D₁_1 (Localization.Away s) instRingD11 _ γ₁ ≫
            CommRingCat.ofHom ι_As =
            @CommRingCat.ofHom D₁_1 K instRingD11 _ ι_D11 := CommRingCat.hom_ext hγ₁
        rw [hcomp]
        exact hη_c11

  
  haveI : AlgebraicGeometry.IsIntegral N₁ := hInt_N₁
  haveI : N₁.IsSeparated := hSep_N₁
  haveI : AlgebraicGeometry.IsIntegral N₂ := hInt_N₂
  haveI : N₂.IsSeparated := hSep_N₂
  haveI : AlgebraicGeometry.IsDominant η_K := hDom_ηK
  haveI : AlgebraicGeometry.IsDominant j_B1 := hDom_jB1
  haveI : AlgebraicGeometry.IsDominant j_B2 := hDom_jB2
  obtain ⟨Φ, hΦ_j⟩ := h_s4 K C_B N₁ N₂ η_K j_B1 j_B2 hExt₁₂ hExt₂₁

  let C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
    CategoryTheory.Over.mk (u_bar'₁ ≫ P1.hom)
  let j : C ⟶ C_bar.left := e_CB.hom ≫ j_B1
  let u_bar₁ : C_bar.left ⟶ P1.left := u_bar'₁
  let u_bar₂ : C_bar.left ⟶ P1.left := Φ.hom ≫ u_bar'₂

  have hOpen_j : AlgebraicGeometry.IsOpenImmersion j := by
    haveI : AlgebraicGeometry.IsOpenImmersion j_B1 := hOpen_jB1
    dsimp [j]
    infer_instance
  have hu_over₂ : u_bar₂ ≫ P1.hom = C_bar.hom := by
    change (Φ.hom ≫ u_bar'₂) ≫ P1.hom = u_bar'₁ ≫ P1.hom
    haveI : (AlgebraicGeometry.Spec (CommRingCat.of k)).IsSeparated := inferInstance
    apply AlgebraicGeometry.ext_of_isDominant j_B1
    calc
      j_B1 ≫ ((Φ.hom ≫ u_bar'₂) ≫ P1.hom)
        = (j_B1 ≫ Φ.hom) ≫ u_bar'₂ ≫ P1.hom := by simp only [CategoryTheory.Category.assoc]
      _ = (j_B2 ≫ u_bar'₂) ≫ P1.hom := by rw [hΦ_j, CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₂) ≫ (ι_P1 ≫ P1.hom) := by
            rw [hjB2_u, CategoryTheory.Category.assoc]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₂.comp Polynomial.C)) := by
            rw [hOver₀, ← AlgebraicGeometry.Spec.map_comp]; rfl
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ₁.comp Polynomial.C)) := by
            rw [hφ_C_eq]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ₁) ≫ (ι_P1 ≫ P1.hom) := by
            rw [hOver₀, ← AlgebraicGeometry.Spec.map_comp]; rfl
      _ = (j_B1 ≫ u_bar'₁) ≫ P1.hom := by rw [hjB1_u, CategoryTheory.Category.assoc]
      _ = j_B1 ≫ (u_bar'₁ ≫ P1.hom) := CategoryTheory.Category.assoc _ _ _
  have hRank₂ : WeilTopDegFiniteLocallyFreeOfRank d₂ u_bar₂ :=
    hTrans₂ N₁ Φ
  have hj_u₁ : j ≫ u_bar₁ = v₁ ≫ ι_P1 := by
    change (e_CB.hom ≫ j_B1) ≫ u_bar'₁ = v₁ ≫ ι_P1
    rw [CategoryTheory.Category.assoc, hjB1_u, ← CategoryTheory.Category.assoc, hv₁_fac]
  have hj_u₂ : j ≫ u_bar₂ = v₂ ≫ ι_P1 := by
    change (e_CB.hom ≫ j_B1) ≫ (Φ.hom ≫ u_bar'₂) = v₂ ≫ ι_P1
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc j_B1 Φ.hom u_bar'₂,
      hΦ_j, hjB2_u, ← CategoryTheory.Category.assoc, hv₂_fac]

  exact ⟨C_bar, j, d₁, d₂, u_bar₁, u_bar₂,
    hInt_N₁, hSm₁, hOpen_j, hd₁, hd₂, rfl, hu_over₂, hRank₁, hRank₂, hj_u₁, hj_u₂⟩

theorem weil_polyP1_last_coord_curve_biprojective_completion (k : Type u) [Field k] [IsAlgClosed k]
    (ι_P1 : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k)))
      (weilProjectiveSpaceOver k 1).left)
    (ι_aff : ∀ δ : ℕ,
      Quiver.Hom (weilAffineSpaceOver k δ).left (weilPolyP1Over k δ).left)
    (hCoord : WeilIsPolyP1PinnedCoordCompactification k ι_P1 ι_aff)
    (C : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine C] [AlgebraicGeometry.IsIntegral C]
    (v₁ v₂ : Quiver.Hom C (AlgebraicGeometry.Spec (CommRingCat.of (Polynomial k))))
    (hv₁ : AlgebraicGeometry.Etale v₁)
    (hv₂ : AlgebraicGeometry.Etale v₂)
    (hv_over : CategoryTheory.CategoryStruct.comp v₁
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k))) =
      CategoryTheory.CategoryStruct.comp v₂
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : k →+* Polynomial k)))) :
    ∃ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      (j : Quiver.Hom C C_bar.left)
      (d₁ d₂ : ℕ)
      (u_bar₁ u_bar₂ : Quiver.Hom C_bar.left (weilProjectiveSpaceOver k 1).left),
      AlgebraicGeometry.IsIntegral C_bar.left ∧
      IsProjectiveOverField k C_bar ∧
      AlgebraicGeometry.IsProper C_bar.hom ∧
      AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom ∧
      topologicalKrullDim C_bar.left = ((1 : ℕ) : WithBot ℕ∞) ∧
      AlgebraicGeometry.IsOpenImmersion j ∧
      1 ≤ d₁ ∧
      1 ≤ d₂ ∧
      CategoryTheory.CategoryStruct.comp u_bar₁ (weilProjectiveSpaceOver k 1).hom = C_bar.hom ∧
      CategoryTheory.CategoryStruct.comp u_bar₂ (weilProjectiveSpaceOver k 1).hom = C_bar.hom ∧
      WeilTopDegFiniteLocallyFreeOfRank d₁ u_bar₁ ∧
      WeilTopDegFiniteLocallyFreeOfRank d₂ u_bar₂ ∧
      CategoryTheory.CategoryStruct.comp j u_bar₁ = CategoryTheory.CategoryStruct.comp v₁ ι_P1 ∧
      CategoryTheory.CategoryStruct.comp j u_bar₂ = CategoryTheory.CategoryStruct.comp v₂ ι_P1 :=
by
  obtain ⟨a₀, ι_inf, τ_inv, hOpen₁, hOver₁, hCovP1, hPre₀, -, hτ_k, hτ_prod, hGlueP1⟩ :=
    weil_polyP1_last_coord_pinned_reciprocal_chart_of_coordCompactification k ι_P1 ι_aff hCoord
  obtain ⟨hPropP1, hIntP1, hProjP1, hSmP1, hOpen₀, hOver₀, -⟩ := hCoord
  obtain ⟨C_bar, j, d₁, d₂, u_bar₁, u_bar₂,
    hIntCb, hSmCb, hOpen_j, hd₁, hd₂, hu_over₁, hu_over₂, hFree₁, hFree₂, hj_u₁, hj_u₂⟩ :=
    weil_polyP1_last_coord_two_chart_relative_normalization_completion k ι_P1 ι_inf a₀ τ_inv
      hPropP1 hOpen₀ hOpen₁ hOver₀ hOver₁ hCovP1 hPre₀ hτ_k hτ_prod hGlueP1
      (by
        intro A _ _ _ _ _ hDimA p _ hp
        exact weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one k 1 A hDimA p hp)
      (by
        intro B _ _ φ hEt
        exact weil_polyP1_last_coord_etale_domain_integral_closure_pkg k a₀ B φ hEt)
      C v₁ v₂ hv₁ hv₂ hv_over
  let P1 := weilProjectiveSpaceOver k 1
  haveI : AlgebraicGeometry.IsFinite u_bar₁ := hFree₁.1
  haveI : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k 1).hom := hPropP1
  have hPropCb : AlgebraicGeometry.IsProper C_bar.hom := by
    rw [← hu_over₁]
    infer_instance
  have hSurj₁ : AlgebraicGeometry.Surjective u_bar₁ := by
    haveI : AlgebraicGeometry.Etale v₁ := hv₁
    haveI : AlgebraicGeometry.IsOpenImmersion ι_P1 := hOpen₀
    haveI : AlgebraicGeometry.Etale (v₁ ≫ ι_P1) := inferInstance
    haveI : AlgebraicGeometry.UniversallyOpen (v₁ ≫ ι_P1) :=
      AlgebraicGeometry.UniversallyOpen.of_flat (v₁ ≫ ι_P1)
    haveI : IrreducibleSpace ↥C := AlgebraicGeometry.irreducibleSpace_of_isIntegral C
    haveI : AlgebraicGeometry.IsIntegral P1.left := hIntP1
    haveI : IrreducibleSpace ↥P1.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral P1.left
    have hOpen_v : IsOpen (Set.range ⇑(v₁ ≫ ι_P1).base) := (v₁ ≫ ι_P1).isOpenMap.isOpen_range
    have hNe_v : (Set.range ⇑(v₁ ≫ ι_P1).base).Nonempty := Set.range_nonempty _
    have hDense_v : Dense (Set.range ⇑(v₁ ≫ ι_P1).base) := hOpen_v.dense hNe_v
    have hSub : Set.range ⇑(v₁ ≫ ι_P1).base ⊆ Set.range ⇑u_bar₁.base := by
      rw [← hj_u₁]
      rintro _ ⟨c, rfl⟩
      exact ⟨j.base c, (AlgebraicGeometry.Scheme.Hom.comp_apply j u_bar₁ c).symm⟩
    have hDense_u : Dense (Set.range ⇑u_bar₁.base) := hDense_v.mono hSub
    have hClosed_u : IsClosed (Set.range ⇑u_bar₁.base) := u_bar₁.isClosedMap.isClosed_range
    have hUniv : Set.range ⇑u_bar₁.base = Set.univ :=
      hClosed_u.closure_eq.symm.trans hDense_u.closure_eq
    exact ⟨Set.range_eq_univ.mp hUniv⟩
  let g₁ : C_bar ⟶ P1 := CategoryTheory.Over.homMk u_bar₁ hu_over₁
  obtain ⟨hProjCb, hDimEq⟩ :=
    weil_isFinite_projective_and_krullDim_over_field k g₁ hIntCb hIntP1 hProjP1 hFree₁.1 hSurj₁
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 P1.hom := hSmP1
  have hDimP1 : topologicalKrullDim P1.left = ((1 : ℕ) : WithBot ℕ∞) :=
    weil_smooth_integral_krullDim_over_field k 1 P1 hIntP1
  have hDimCb : topologicalKrullDim C_bar.left = ((1 : ℕ) : WithBot ℕ∞) :=
    hDimEq.trans hDimP1
  exact ⟨C_bar, j, d₁, d₂, u_bar₁, u_bar₂,
    hIntCb, hProjCb, hPropCb, hSmCb, hDimCb, hOpen_j,
    hd₁, hd₂, hu_over₁, hu_over₂, hFree₁, hFree₂, hj_u₁, hj_u₂⟩

theorem weil_polyP1_last_coord_pinned_roof_clopen_det_counit (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (r : ℕ) (hr : 1 ≤ r)
    (ζ_r : kˣ) (hζ_r : IsPrimitiveRoot ((ζ_r : kˣ) : k) (ℓ ^ r))
    (Ψ : WeilRoofTransferSystem k ℓ)
    (hΨ : WeilIsPinnedRoofTransfer k ℓ Ψ)
    (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (C : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine C] [AlgebraicGeometry.IsIntegral C]
    (j : Quiver.Hom C Y₁.left) (hEt_j : AlgebraicGeometry.Etale j)
    (g : Quiver.Hom C Y₂.left) (hEt_g : AlgebraicGeometry.Etale g)
    (d : ℕ) (hd : 1 ≤ d)
    (f : Quiver.Hom Y₁.left Y₂.left)
    (hf_over : CategoryTheory.CategoryStruct.comp f Y₂.hom = Y₁.hom)
    (hf_free : WeilTopDegFiniteLocallyFreeOfRank d f)
    (hj_f : CategoryTheory.CategoryStruct.comp j f = g)
    (f_shriek : weilEtaleTorsionH Y₁.left (ℓ ^ r) 2 →+ weilEtaleTorsionH Y₂.left (ℓ ^ r) 2)
    (hf_sh : WeilTopDegAffineFiniteFreePushforward k (ℓ ^ r) d 2 ζ_r Y₁ Y₂ f f_shriek) :
    let U_j : Y₁.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j hEt_j
    let U_C : Y₂.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g hEt_g
    ∀ (hRoof : WeilIsAffineRoofIso k Y₁ Y₂ U_j U_C (CategoryTheory.Iso.refl C))
      (y : weilEtaleLocalTorsionH Y₁.left (ℓ ^ r) U_j 2),
      weilEtaleLocalTorsionCounitH Y₂.left (ℓ ^ r) U_C 2
          (Ψ Y₁ Y₂ U_j U_C (CategoryTheory.Iso.refl C) hRoof r 2 y) =
        f_shriek (weilEtaleLocalTorsionCounitH Y₁.left (ℓ ^ r) U_j 2 y) :=
by
  classical
  let _ := hd
  dsimp only
  intro hRoof y
  let n : ℕ := ℓ ^ r
  let U_j : Y₁.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ j hEt_j
  let U_C : Y₂.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ g hEt_g

  
  have hPartA_det :
      ∀ {R S S₂ : Type u} [CommRing R] [CommRing S] [CommRing S₂] [Algebra R S]
        (bS : Module.Basis (Fin d) R S)
        (π₁ : S →+* R) (π₂ : S →+* S₂),
        (∀ r₀ : R, π₁ (algebraMap R S r₀) = r₀) →
        (∀ s₁ s₂ : S, π₁ s₁ = π₁ s₂ → π₂ s₁ = π₂ s₂ → s₁ = s₂) →
        ∀ (e₁ : S), π₁ e₁ = 1 → π₂ e₁ = 0 →
        ∀ (s₀ : S) (z₀ : R), π₁ s₀ = z₀ → π₂ s₀ = 1 →
        ((LinearMap.toMatrix bS bS) (LinearMap.mulLeft R s₀)).det = z₀ := by
    intro R S S₂ _ _ _ _ bS π₁ π₂ hπ₁_alg hInj e₁ he₁_1 he₁_2 s₀ z₀ hs₁ hs₂
    have hs₀_eq : s₀ = (z₀ - 1) • e₁ + 1 := by
      apply hInj
      · rw [Algebra.smul_def, map_add, map_mul, map_one, hπ₁_alg, he₁_1, hs₁]; ring
      · rw [Algebra.smul_def, map_add, map_mul, map_one, he₁_2, hs₂]; ring
    have he₁_mul : ∀ s : S, e₁ * s = π₁ s • e₁ := by
      intro s
      apply hInj
      · rw [Algebra.smul_def, map_mul, map_mul, he₁_1, hπ₁_alg]; ring
      · rw [Algebra.smul_def, map_mul, map_mul, he₁_2]; ring
    let u_vec : Fin d → R := fun i => (z₀ - 1) * bS.repr e₁ i
    let v_vec : Fin d → R := fun i => π₁ (bS i)
    let A_mat : Matrix (Fin d) Unit R := Matrix.of fun i _ => u_vec i
    let B_mat : Matrix Unit (Fin d) R := Matrix.of fun _ i => v_vec i
    have hMat : (LinearMap.toMatrix bS bS) (LinearMap.mulLeft R s₀) = 1 + A_mat * B_mat := by
      ext i₁ i₂
      rw [LinearMap.toMatrix_apply, LinearMap.mulLeft_apply, hs₀_eq, add_mul, one_mul,
        smul_mul_assoc, he₁_mul, smul_smul, map_add, map_smul, Finsupp.add_apply,
        Finsupp.smul_apply, bS.repr_self, Finsupp.single_apply, smul_eq_mul,
        Matrix.add_apply, Matrix.one_apply, Matrix.mul_apply, Fintype.sum_unique]
      dsimp [A_mat, B_mat, u_vec, v_vec]
      by_cases hij : i₁ = i₂
      · subst hij; simp; ring
      · have hji : i₂ ≠ i₁ := Ne.symm hij
        simp [hij, hji]; ring
    have hSum : (∑ i : Fin d, bS.repr e₁ i * π₁ (bS i)) = 1 := by
      calc
        (∑ i : Fin d, bS.repr e₁ i * π₁ (bS i))
          = ∑ i : Fin d, π₁ (bS.repr e₁ i • bS i) := by
              refine Finset.sum_congr rfl fun i _ => ?_
              rw [Algebra.smul_def, map_mul, hπ₁_alg]
        _ = π₁ (∑ i : Fin d, bS.repr e₁ i • bS i) := (map_sum π₁ _ _).symm
        _ = π₁ e₁ := by rw [bS.sum_repr e₁]
        _ = 1 := he₁_1
    rw [hMat, Matrix.det_one_add_mul_comm A_mat B_mat, Matrix.det_unique]
    simp only [Matrix.add_apply, Matrix.one_apply, Matrix.mul_apply]
    dsimp [A_mat, B_mat, u_vec, v_vec]
    have hSum2 : (∑ x : Fin d, π₁ (bS x) * ((z₀ - 1) * (bS.repr e₁) x)) =
        (z₀ - 1) * (∑ x : Fin d, (bS.repr e₁) x * π₁ (bS x)) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun x _ => by ring
    rw [hSum2, hSum]
    ring

  
  have hClopen_graph :
      ∀ {C₀ : AlgebraicGeometry.Scheme.{u}}
        (j₀ : C₀ ⟶ Y₁.left) (_ : AlgebraicGeometry.Etale j₀)
        (g₀ : C₀ ⟶ Y₂.left) (_ : AlgebraicGeometry.Etale g₀)
        (hj₀_f : j₀ ≫ f = g₀),
        let f_σ₀ : C₀ ⟶ CategoryTheory.Limits.pullback g₀ f :=
          CategoryTheory.Limits.pullback.lift (𝟙 C₀) j₀
            ((CategoryTheory.Category.id_comp g₀).trans hj₀_f.symm)
        AlgebraicGeometry.IsOpenImmersion f_σ₀ ∧ IsClosed (Set.range f_σ₀.base) := by
    intro C₀ j₀ hEt_j₀ g₀ hEt_g₀ hj₀_f
    have : AlgebraicGeometry.Etale g₀ := hEt_g₀
    have : AlgebraicGeometry.Etale j₀ := hEt_j₀
    have : AlgebraicGeometry.IsFinite f := hf_free.1
    let P₀ := CategoryTheory.Limits.pullback g₀ f
    let p_fst₀ := CategoryTheory.Limits.pullback.fst g₀ f
    let p_snd₀ := CategoryTheory.Limits.pullback.snd g₀ f
    let f_σ₀ : C₀ ⟶ P₀ :=
      CategoryTheory.Limits.pullback.lift (𝟙 C₀) j₀
        ((CategoryTheory.Category.id_comp g₀).trans hj₀_f.symm)
    have hp_snd_et : AlgebraicGeometry.Etale p_snd₀ := inferInstance
    have hEt_comp : AlgebraicGeometry.Etale (f_σ₀ ≫ p_snd₀) := by
      rw [CategoryTheory.Limits.pullback.lift_snd]
      exact hEt_j₀
    have : AlgebraicGeometry.Etale f_σ₀ :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        f_σ₀ p_snd₀ hp_snd_et hEt_comp
    have hf_fst : f_σ₀ ≫ p_fst₀ = 𝟙 C₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have : CategoryTheory.Mono f_σ₀ :=
      ⟨fun a b hab => by
        have h1 : (a ≫ f_σ₀) ≫ p_fst₀ = (b ≫ f_σ₀) ≫ p_fst₀ := congrArg (· ≫ p_fst₀) hab
        rw [Category.assoc, Category.assoc, hf_fst, Category.comp_id, Category.comp_id] at h1
        exact h1⟩
    have : AlgebraicGeometry.IsOpenImmersion f_σ₀ :=
      AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono f_σ₀
    have : AlgebraicGeometry.IsSeparated f := inferInstance
    have : AlgebraicGeometry.IsSeparated p_fst₀ := inferInstance
    have : AlgebraicGeometry.IsClosedImmersion (f_σ₀ ≫ p_fst₀) := by
      rw [hf_fst]
      infer_instance
    have : AlgebraicGeometry.IsClosedImmersion f_σ₀ :=
      AlgebraicGeometry.IsClosedImmersion.of_comp f_σ₀ p_fst₀
    refine ⟨inferInstance, ?_⟩
    rw [← Set.image_univ]
    exact f_σ₀.isClosedMap Set.univ isClosed_univ

  
  have hConst_unit :
