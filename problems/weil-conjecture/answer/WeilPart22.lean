              CategoryTheory.Limits.pullback Δ_p (δ_pair β₁ β₂) ⟶ Z_s :=
            fun β₁ β₂ => CategoryTheory.Limits.pullback.snd Δ_p (δ_pair β₁ β₂)
          let U_pm : (Z ⟶ V) → (Z ⟶ V) → Z_s.Opens :=
            fun β₁ β₂ =>
              if z₀ ∈ Set.range (i_pair β₁ β₂).base then
                (i_pair β₁ β₂).opensRange
              else
                ⟨(Set.range (i_pair β₁ β₂).base)ᶜ,
                  (i_pair β₁ β₂).isClosedEmbedding.isClosed_range.isOpen_compl⟩
          have hz₀_Upm : ∀ (β₁ β₂ : Z ⟶ V), z₀ ∈ U_pm β₁ β₂ := by
            intro β₁ β₂
            dsimp only [U_pm]
            split_ifs with h_mem
            · exact h_mem
            · exact h_mem
          have hU_row_ex : ∀ (β₁ : Z ⟶ V) (S_fin : Finset (Z ⟶ V)),
