        (Limits.pullback.fst f_ZU'' s₀ ≫ p_ZU'')
        (Limits.pullback.snd f_ZU'' s₀)
        f_Z s_τ := by
    rw [← hs₀_g]
    exact (CategoryTheory.IsPullback.of_hasPullback f_ZU'' s₀).paste_horiz hPb_ZU''

  have hPb_c₀ :
      CategoryTheory.IsPullback
        (Limits.pullback.fst ν_Z ι₀_sp)
        (Limits.pullback.snd ν_Z ι₀_sp ≫ C₀.hom)
        f_Z s_τ :=
    (CategoryTheory.IsPullback.of_hasPullback ν_Z ι₀_sp).paste_vert hPb_c₀_sp

  let iso_c₀ :
      CategoryTheory.Limits.pullback f_ZU'' s₀ ≅
        CategoryTheory.Limits.pullback ν_Z ι₀_sp :=
    hPb_s₀.isoPullback ≪≫ hPb_c₀.isoPullback.symm
  exact hConnOfIso iso_c₀ hConn_s₀

theorem weil_cyclic_etale_torsor_pullback_and_sheet_partition (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (Y Z : AlgebraicGeometry.Scheme.{u})
       (ν : Quiver.Hom Z Y)
       [AlgebraicGeometry.Etale ν]
       [AlgebraicGeometry.Surjective ν]
       (ρ : ZMod ℓ → Quiver.Hom Z Z)
       (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ a) ν = ν),
       (ρ 0 = CategoryTheory.CategoryStruct.id Z ∧
         ∀ a b : ZMod ℓ, ρ (a + b) = CategoryTheory.CategoryStruct.comp (ρ a) (ρ b)) →
       (let δ : ZMod ℓ → Quiver.Hom Z (CategoryTheory.Limits.pullback ν ν) :=
          fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z) (ρ a)
            ((CategoryTheory.Category.id_comp ν).trans (hρ_over a).symm)
        (_root_.Pairwise fun a b : ZMod ℓ =>
          Disjoint (Set.range (δ a).base) (Set.range (δ b).base)) ∧
        (⋃ a : ZMod ℓ, Set.range (δ a).base) = Set.univ) →
       ∀ (X : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom X Y),
         let Z_X := CategoryTheory.Limits.pullback ν h
         let p_Z : Quiver.Hom Z_X Z := CategoryTheory.Limits.pullback.fst ν h
         let ν_X : Quiver.Hom Z_X X := CategoryTheory.Limits.pullback.snd ν h
         let ρ_X : ZMod ℓ → Quiver.Hom Z_X Z_X :=
           fun a => CategoryTheory.Limits.pullback.lift
             (CategoryTheory.CategoryStruct.comp p_Z (ρ a)) ν_X
             ((CategoryTheory.Category.assoc p_Z (ρ a) ν).trans
               ((congrArg (CategoryTheory.CategoryStruct.comp p_Z) (hρ_over a)).trans
                 CategoryTheory.Limits.pullback.condition))
         let hρ_X_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_X a) ν_X = ν_X :=
           fun a => CategoryTheory.Limits.pullback.lift_snd _ _ _
         let δ_X : ZMod ℓ → Quiver.Hom Z_X (CategoryTheory.Limits.pullback ν_X ν_X) :=
           fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z_X) (ρ_X a)
             ((CategoryTheory.Category.id_comp ν_X).trans (hρ_X_over a).symm)
         AlgebraicGeometry.Etale ν_X ∧
         AlgebraicGeometry.Surjective ν_X ∧
         (∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_X a) p_Z =
           CategoryTheory.CategoryStruct.comp p_Z (ρ a)) ∧
         (ρ_X 0 = CategoryTheory.CategoryStruct.id Z_X ∧
           ∀ a b : ZMod ℓ, ρ_X (a + b) = CategoryTheory.CategoryStruct.comp (ρ_X a) (ρ_X b)) ∧
         (_root_.Pairwise fun a b : ZMod ℓ =>
           Disjoint (Set.range (δ_X a).base) (Set.range (δ_X b).base)) ∧
         (⋃ a : ZMod ℓ, Set.range (δ_X a).base) = Set.univ) ∧
    (∀ (S Z_S : AlgebraicGeometry.Scheme.{u})
       (ν_S : Quiver.Hom Z_S S)
       [AlgebraicGeometry.Etale ν_S]
       (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
       (hρ_S_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S),
       (ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
         ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)) →
       (let δ_S : ZMod ℓ → Quiver.Hom Z_S (CategoryTheory.Limits.pullback ν_S ν_S) :=
          fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z_S) (ρ_S a)
            ((CategoryTheory.Category.id_comp ν_S).trans (hρ_S_over a).symm)
        (_root_.Pairwise fun a b : ZMod ℓ =>
          Disjoint (Set.range (δ_S a).base) (Set.range (δ_S b).base)) ∧
        (⋃ a : ZMod ℓ, Set.range (δ_S a).base) = Set.univ) →
       (∀ a : ZMod ℓ, CategoryTheory.IsIso (ρ_S a)) ∧
       ∀ (U₀ : AlgebraicGeometry.Scheme.{u})
         (p_U : Quiver.Hom U₀ S)
         (s : Quiver.Hom U₀ Z_S)
         (hs : CategoryTheory.CategoryStruct.comp s ν_S = p_U),
         let W := CategoryTheory.Limits.pullback p_U ν_S
         let ι : ZMod ℓ → Quiver.Hom U₀ W :=
           fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id U₀)
             (CategoryTheory.CategoryStruct.comp s (ρ_S a))
             ((CategoryTheory.Category.id_comp p_U).trans
               (hs.symm.trans
                 ((congrArg (CategoryTheory.CategoryStruct.comp s) (hρ_S_over a)).symm.trans
                   (CategoryTheory.Category.assoc s (ρ_S a) ν_S).symm)))
         let ρ_W : ZMod ℓ → Quiver.Hom W W :=
           fun b => CategoryTheory.Limits.pullback.lift
             (CategoryTheory.Limits.pullback.fst p_U ν_S)
             (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd p_U ν_S) (ρ_S b))
             (CategoryTheory.Limits.pullback.condition.trans
               ((congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd p_U ν_S))
                 (hρ_S_over b)).symm.trans
                 (CategoryTheory.Category.assoc _ (ρ_S b) ν_S).symm))
         (∀ a : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (ι a)) ∧
         (_root_.Pairwise fun a b : ZMod ℓ =>
           Disjoint (Set.range (ι a).base) (Set.range (ι b).base)) ∧
         (⋃ a : ZMod ℓ, Set.range (ι a).base) = Set.univ ∧
         (∀ a b : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ι a) (ρ_W b) = ι (a + b))) :=
by
  have hSecPullback :
      ∀ {B' E' B E : AlgebraicGeometry.Scheme.{u}}
        {p_E : E' ⟶ E} {f' : E' ⟶ B'} {f : E ⟶ B} {m : B' ⟶ B}
        {τ : B ⟶ E} {τ' : B' ⟶ E'},
        CategoryTheory.IsPullback p_E f' f m →
        τ ≫ f = 𝟙 B →
        τ' ≫ f' = 𝟙 B' →
        τ' ≫ p_E = m ≫ τ →
        CategoryTheory.IsPullback m τ' τ p_E ∧
          Set.range τ'.base = p_E.base ⁻¹' Set.range τ.base := by
    intro B' E' B E p_E f' f m τ τ' hPb hτ hτ' hcomm
    have hPb_outer : CategoryTheory.IsPullback m (τ' ≫ f') (τ ≫ f) m := by
      rw [hτ', hτ]
      exact CategoryTheory.IsPullback.id_vert m
    have hPb_sec : CategoryTheory.IsPullback m τ' τ p_E :=
      CategoryTheory.IsPullback.of_bot hPb_outer hcomm.symm hPb
    refine ⟨hPb_sec, ?_⟩
    simpa only [Set.preimage_univ, Set.image_univ] using
      AlgebraicGeometry.Scheme.image_preimage_eq_of_isPullback hPb_sec Set.univ
  refine ⟨?_, ?_⟩
  · intro Y Z ν hEt_ν hSurj_ν ρ hρ_over hρ_act hρ_part X h Z_X p_Z ν_X ρ_X hρ_X_over δ_X
    let δ : ZMod ℓ → Quiver.Hom Z (CategoryTheory.Limits.pullback ν ν) :=
      fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z) (ρ a)
        ((CategoryTheory.Category.id_comp ν).trans (hρ_over a).symm)
    rcases hρ_act with ⟨hρ_zero, hρ_add⟩
    rcases (hρ_part :
      (_root_.Pairwise fun a b : ZMod ℓ =>
        Disjoint (Set.range (δ a).base) (Set.range (δ b).base)) ∧
      (⋃ a : ZMod ℓ, Set.range (δ a).base) = Set.univ) with ⟨hδ_disj, hδ_univ⟩
    have hPb_ZX : CategoryTheory.IsPullback p_Z ν_X ν h :=
      CategoryTheory.IsPullback.of_hasPullback ν h
    have hEt_νX : AlgebraicGeometry.Etale ν_X :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZX hEt_ν
    have hSurj_νX : AlgebraicGeometry.Surjective ν_X :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZX hSurj_ν
    have hρ_X_fst : ∀ a : ZMod ℓ, ρ_X a ≫ p_Z = p_Z ≫ ρ a :=
      fun a => CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hρ_X_zero : ρ_X 0 = 𝟙 Z_X := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change ρ_X 0 ≫ p_Z = 𝟙 Z_X ≫ p_Z
        rw [hρ_X_fst 0, hρ_zero, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      · change ρ_X 0 ≫ ν_X = 𝟙 Z_X ≫ ν_X
        rw [hρ_X_over 0, CategoryTheory.Category.id_comp]
    have hρ_X_add : ∀ a b : ZMod ℓ, ρ_X (a + b) = ρ_X a ≫ ρ_X b := by
      intro a b
      apply CategoryTheory.Limits.pullback.hom_ext
      · change ρ_X (a + b) ≫ p_Z = (ρ_X a ≫ ρ_X b) ≫ p_Z
        calc
          ρ_X (a + b) ≫ p_Z = p_Z ≫ ρ (a + b) := hρ_X_fst (a + b)
          _ = p_Z ≫ (ρ a ≫ ρ b) := by rw [hρ_add a b]
          _ = (p_Z ≫ ρ a) ≫ ρ b := (CategoryTheory.Category.assoc p_Z (ρ a) (ρ b)).symm
          _ = (ρ_X a ≫ p_Z) ≫ ρ b := by rw [hρ_X_fst a]
          _ = ρ_X a ≫ (p_Z ≫ ρ b) := CategoryTheory.Category.assoc (ρ_X a) p_Z (ρ b)
          _ = ρ_X a ≫ (ρ_X b ≫ p_Z) := by rw [hρ_X_fst b]
          _ = (ρ_X a ≫ ρ_X b) ≫ p_Z := (CategoryTheory.Category.assoc (ρ_X a) (ρ_X b) p_Z).symm
      · change ρ_X (a + b) ≫ ν_X = (ρ_X a ≫ ρ_X b) ≫ ν_X
        rw [hρ_X_over (a + b), CategoryTheory.Category.assoc, hρ_X_over b, hρ_X_over a]
    have hpZ_cond : p_Z ≫ ν = ν_X ≫ h := CategoryTheory.Limits.pullback.condition
    have hq_comm :
        (CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ p_Z) ≫ ν =
          (CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ p_Z) ≫ ν := by
      calc
        (CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ p_Z) ≫ ν
          = CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ (p_Z ≫ ν) :=
            CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ (ν_X ≫ h) := by rw [hpZ_cond]
        _ = (CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ ν_X) ≫ h :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = (CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ ν_X) ≫ h := by
            rw [CategoryTheory.Limits.pullback.condition]
        _ = CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ (ν_X ≫ h) :=
            CategoryTheory.Category.assoc _ _ _
        _ = CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ (p_Z ≫ ν) := by rw [hpZ_cond]
        _ = (CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ p_Z) ≫ ν :=
            (CategoryTheory.Category.assoc _ _ _).symm
    let q_pb : CategoryTheory.Limits.pullback ν_X ν_X ⟶ CategoryTheory.Limits.pullback ν ν :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ p_Z)
        (CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ p_Z)
        hq_comm
    have hq_fst : q_pb ≫ CategoryTheory.Limits.pullback.fst ν ν =
        CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ p_Z :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hq_snd : q_pb ≫ CategoryTheory.Limits.pullback.snd ν ν =
        CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ p_Z :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_outer :
        CategoryTheory.IsPullback
          (q_pb ≫ CategoryTheory.Limits.pullback.snd ν ν)
          (CategoryTheory.Limits.pullback.fst ν_X ν_X)
          ν
          (p_Z ≫ ν) := by
      rw [hq_snd, hpZ_cond]
      exact ((CategoryTheory.IsPullback.of_hasPullback ν_X ν_X).flip).paste_horiz
