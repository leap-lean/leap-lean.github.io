    · rintro ⟨c₀, rfl⟩
      have hc₀_W₁ : p₁_Y.base (ι_Cfib_V₂.base c₀.1) ∈ E.W₁_open := by
        change (ι_Cfib_V₂ ≫ p₁_Y).base c₀.1 ∈ E.W₁_open
        rw [hι_p₁]
        exact Eq.mp
          (congrArg (fun O : E.C_fib.left.Opens => (c₀.1 : ↥E.C_fib.left) ∈ O) E.hU_fib_eq) c₀.2
      obtain ⟨u_pb, -, hu_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := W₁_V₂_open.ι) (g := ι_Cfib_V₂) ⟨ι_Cfib_V₂.base c₀.1, hc₀_W₁⟩ c₀.1 rfl
      exact ⟨u_pb, hu_snd⟩

  let hom_U : U_sch ⟶ E.U_fib.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift E.U_fib.ι u_hom (le_of_eq hRange_U)
  let inv_U : E.U_fib.toScheme ⟶ U_sch :=
    AlgebraicGeometry.IsOpenImmersion.lift u_hom E.U_fib.ι (le_of_eq hRange_U.symm)
