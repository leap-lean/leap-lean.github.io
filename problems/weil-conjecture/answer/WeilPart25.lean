      exact (weil_etale_mod_prime_injective_higherDirectImage_isZero ℓ f₁.left I₁ p hp).of_iso e_R
    have hSE₁ : (SC₂.map pf_ν).ShortExact :=
      ((weil_etale_higherDirectImage_shortExact_calculus ν).2.2 SC₂ hSE₂ hAcyc_ν).1.2 hZero_R1ν
    obtain ⟨δ₂, hcomp₂, hEpi₂, hEx₂⟩ :=
      ((weil_etale_higherDirectImage_shortExact_calculus f₂.left).2.2 SC₂ hSE₂ hAcyc_f₂).1.1
    obtain ⟨δ₁, hcomp₁, hEpi₁, hEx₁⟩ :=
      ((weil_etale_higherDirectImage_shortExact_calculus f₁.left).2.2
