        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp

  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}}
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = CategoryTheory.CategoryStruct.id S_k →
        s₂ ≫ p_V = CategoryTheory.CategoryStruct.id S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V p_V s₁ s₂ hs₁ hs₂ hpt
    rcases TopologicalSpace.Opens.isBasis_iff_nbhd.mp V.isBasis_affineOpens
        (show s₁.base pt_k ∈ (⊤ : V.Opens) from trivial) with ⟨U_V, hAff_UV, hv_U, _⟩
    change AlgebraicGeometry.IsAffineOpen U_V at hAff_UV
    have hr₁ : Set.range s₁.base ⊆ Set.range hAff_UV.fromSpec.base := by
      rw [hAff_UV.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      rw [hSub_k.elim q pt_k]
      exact hv_U
    have hr₂ : Set.range s₂.base ⊆ Set.range hAff_UV.fromSpec.base := by
      rw [hAff_UV.range_fromSpec]
      rintro _ ⟨q, rfl⟩
      rw [hSub_k.elim q pt_k, ← hpt]
      exact hv_U
    let s₁' := AlgebraicGeometry.IsOpenImmersion.lift hAff_UV.fromSpec s₁ hr₁
    let s₂' := AlgebraicGeometry.IsOpenImmersion.lift hAff_UV.fromSpec s₂ hr₂
    have hf₁ : s₁' ≫ hAff_UV.fromSpec = s₁ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_UV.fromSpec s₁ hr₁
    have hf₂ : s₂' ≫ hAff_UV.fromSpec = s₂ :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_UV.fromSpec s₂ hr₂
    have hpt' : s₁'.base pt_k = s₂'.base pt_k := by
      apply hAff_UV.fromSpec.isOpenEmbedding.injective
      change (s₁' ≫ hAff_UV.fromSpec).base pt_k = (s₂' ≫ hAff_UV.fromSpec).base pt_k
      rw [hf₁, hf₂, hpt]
    have heq' : s₁' = s₂' :=
      hSectionEq_aff (hAff_UV.fromSpec ≫ p_V) s₁' s₂'
        (by rw [← CategoryTheory.Category.assoc, hf₁, hs₁])
        (by rw [← CategoryTheory.Category.assoc, hf₂, hs₂]) hpt'
    rw [← hf₁, ← hf₂, heq']

  have hAlgEtaleSplit :
      ∀ (A : Type u) [CommRing A] [Algebra k A] [Algebra.Etale k A],
        ∃ d : ℕ, Nonempty (A ≃ₐ[k] (Fin d → k)) := by
    intro A _ _ _
    rcases (Algebra.Etale.iff_exists_algEquiv_prod k A).mp inferInstance with
      ⟨I, _, Ai, hField_i, hAlg_i, e_prod, hFinSep⟩
    letI : Fintype I := Fintype.ofFinite I
    letI : ∀ i : I, Field (Ai i) := hField_i
    letI : ∀ i : I, Algebra k (Ai i) := hAlg_i
    let e_i : ∀ i : I, Ai i ≃ₐ[k] k := fun i =>
      haveI : Module.Finite k (Ai i) := (hFinSep i).1
      haveI : Algebra.IsIntegral k (Ai i) := Algebra.IsIntegral.of_finite k (Ai i)
      (AlgEquiv.ofBijective (Algebra.ofId k (Ai i))
        IsAlgClosed.algebraMap_bijective_of_isIntegral).symm
    let d := Fintype.card I
    let e_fin : I ≃ Fin d := Fintype.equivFin I
    have hleft_pi : ∀ (f : ∀ i : I, Ai i) (i' i : I), i' = i →
        (e_i i).symm (e_i i' (f i')) = f i := by
      rintro f i' _ rfl
      exact (e_i i').symm_apply_apply (f i')
    let e_pi : (∀ i : I, Ai i) ≃ₐ[k] (Fin d → k) :=
      { toFun := fun f j => e_i (e_fin.symm j) (f (e_fin.symm j))
        invFun := fun g i => (e_i i).symm (g (e_fin i))
        left_inv := fun f => funext fun i => hleft_pi f (e_fin.symm (e_fin i)) i (e_fin.symm_apply_apply i)
        right_inv := fun g => funext fun j => by simp
        map_mul' := fun f₁ f₂ => funext fun j => map_mul (e_i (e_fin.symm j)) _ _
        map_add' := fun f₁ f₂ => funext fun j => map_add (e_i (e_fin.symm j)) _ _
        commutes' := fun c => funext fun j => (e_i (e_fin.symm j)).commutes c }
    exact ⟨d, ⟨e_prod.trans e_pi⟩⟩

  have hFinProdSpec :
      ∀ (d : ℕ) (p_sp : PrimeSpectrum (Fin d → k)),
        ∃ i : Fin d,
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (Pi.evalAlgHom k (fun _ : Fin d => k) i).toRingHom)).base pt_k =
          p_sp := by
    intro d p_sp
    let single_k : Fin d → k → (Fin d → k) := Pi.single (M := fun _ : Fin d => k)
    have h1_sum : (1 : Fin d → k) = ∑ i : Fin d, single_k i (1 : k) := by
      ext j; simp [single_k, Finset.sum_apply, Pi.single_apply]
    have h1_not : (1 : Fin d → k) ∉ p_sp.asIdeal :=
      fun h1 => p_sp.isPrime.ne_top ((Ideal.eq_top_iff_one p_sp.asIdeal).mpr h1)
    have hex : ∃ i : Fin d, single_k i (1 : k) ∉ p_sp.asIdeal := by
      by_contra hall
      have hall' : ∀ i : Fin d, single_k i (1 : k) ∈ p_sp.asIdeal :=
        fun i => Classical.not_not.mp (fun hi => hall ⟨i, hi⟩)
      exact h1_not (h1_sum ▸ Ideal.sum_mem p_sp.asIdeal (fun i _ => hall' i))
    obtain ⟨i, hi_not⟩ := hex
    let ev_i := (Pi.evalAlgHom k (fun _ : Fin d => k) i).toRingHom
    have hsurj : Function.Surjective ev_i := fun c => ⟨fun _ => c, rfl⟩
    haveI : (⊥ : Ideal k).IsMaximal := hBotMax
    have hmax : (Ideal.comap ev_i (⊥ : Ideal k)).IsMaximal :=
      Ideal.comap_isMaximal_of_surjective ev_i hsurj
    have hle : Ideal.comap ev_i (⊥ : Ideal k) ≤ p_sp.asIdeal := by
      intro f hf
      rw [Ideal.mem_comap, Ideal.mem_bot] at hf
      change f i = 0 at hf
      have hmul : f * single_k i (1 : k) = 0 := by
        ext j
        change f j * single_k i (1 : k) j = 0
        by_cases hj : j = i
        · subst hj; dsimp [single_k]; rw [Pi.single_eq_same, hf, zero_mul]
        · dsimp [single_k]; rw [Pi.single_eq_of_ne hj, mul_zero]
      have hmem : f * single_k i (1 : k) ∈ p_sp.asIdeal := hmul ▸ p_sp.asIdeal.zero_mem
      exact (p_sp.isPrime.mem_or_mem hmem).resolve_right hi_not
    have heq : Ideal.comap ev_i (⊥ : Ideal k) = p_sp.asIdeal :=
      hmax.eq_of_le p_sp.isPrime.ne_top hle
    exact ⟨i, PrimeSpectrum.ext heq⟩

  have hEtalePtSec :
      ∀ (V : AlgebraicGeometry.Scheme.{u}) (p_V : V ⟶ S_k) [AlgebraicGeometry.Etale p_V]
        (v : ↥V),
        ∃ s_v : S_k ⟶ V,
          s_v ≫ p_V = CategoryTheory.CategoryStruct.id S_k ∧ s_v.base pt_k = v := by
    intro V p_V _ v
    rcases TopologicalSpace.Opens.isBasis_iff_nbhd.mp V.isBasis_affineOpens
        (show v ∈ (⊤ : V.Opens) from trivial) with ⟨U_V, hAff_U, hv_U, _⟩
    change AlgebraicGeometry.IsAffineOpen U_V at hAff_U
    have hv_range : v ∈ Set.range hAff_U.fromSpec.base := by
      rw [hAff_U.range_fromSpec]; exact hv_U
    obtain ⟨q_U, hq_U⟩ := hv_range
    let R_U := V.presheaf.obj (Opposite.op U_V)
    let φ_U : CommRingCat.of k ⟶ R_U :=
      AlgebraicGeometry.Spec.preimage (hAff_U.fromSpec ≫ p_V)
    have hmap_U : AlgebraicGeometry.Spec.map φ_U = hAff_U.fromSpec ≫ p_V :=
      AlgebraicGeometry.Spec.map_preimage _
    have hEt_φ : RingHom.Etale φ_U.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (by rw [hmap_U]; infer_instance)
    letI : Algebra k ↑R_U := φ_U.hom.toAlgebra
    haveI : Algebra.Etale k ↑R_U := RingHom.etale_algebraMap.mp hEt_φ
    obtain ⟨d_U, ⟨ψ_U⟩⟩ := hAlgEtaleSplit ↑R_U
    let q_fin : PrimeSpectrum (Fin d_U → k) :=
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_U.symm.toRingHom)).base q_U
    obtain ⟨i₀, hi₀⟩ := hFinProdSpec d_U q_fin
    let ev₀ : ↑R_U →ₐ[k] k :=
      (Pi.evalAlgHom k (fun _ : Fin d_U => k) i₀).comp ψ_U.toAlgHom
    let s_spec : S_k ⟶ AlgebraicGeometry.Spec R_U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev₀.toRingHom)
    let s_v : S_k ⟶ V := s_spec ≫ hAff_U.fromSpec
    have hs_sec : s_v ≫ p_V = CategoryTheory.CategoryStruct.id S_k := by
      have hcomp_k : φ_U ≫ CommRingCat.ofHom ev₀.toRingHom =
          CategoryTheory.CategoryStruct.id (CommRingCat.of k) := by
        ext c
        exact ev₀.commutes c
      exact (CategoryTheory.Category.assoc s_spec hAff_U.fromSpec p_V).trans
        ((congrArg (s_spec ≫ ·) hmap_U.symm).trans
          ((AlgebraicGeometry.Spec.map_comp φ_U (CommRingCat.ofHom ev₀.toRingHom)).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map hcomp_k).trans
              (AlgebraicGeometry.Spec.map_id (CommRingCat.of k)))))
    have hs_pt : s_v.base pt_k = v := by
      have h_id_R : CommRingCat.ofHom ψ_U.toRingHom ≫ CommRingCat.ofHom ψ_U.symm.toRingHom =
          CategoryTheory.CategoryStruct.id R_U := by
        ext r; exact ψ_U.symm_apply_apply r
      have hev_fac : CommRingCat.ofHom ev₀.toRingHom =
          CommRingCat.ofHom ψ_U.toRingHom ≫
            CommRingCat.ofHom (Pi.evalAlgHom k (fun _ : Fin d_U => k) i₀).toRingHom := rfl
      have hspec_eq : s_spec.base pt_k = q_U := by
        have h1 : s_spec =
            AlgebraicGeometry.Spec.map
              (CommRingCat.ofHom (Pi.evalAlgHom k (fun _ : Fin d_U => k) i₀).toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_U.toRingHom) :=
          (congrArg AlgebraicGeometry.Spec.map hev_fac).trans
            (AlgebraicGeometry.Spec.map_comp _ _)
        have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_U.symm.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_U.toRingHom) =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec R_U) :=
          (AlgebraicGeometry.Spec.map_comp
            (CommRingCat.ofHom ψ_U.toRingHom) (CommRingCat.ofHom ψ_U.symm.toRingHom)).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map h_id_R).trans
              (AlgebraicGeometry.Spec.map_id R_U))
        exact (congrArg (fun f => f.base pt_k) h1).trans
          ((congrArg (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_U.toRingHom)).base hi₀).trans
            (congrArg (fun f => f.base q_U) h2))
      exact (congrArg hAff_U.fromSpec.base hspec_eq).trans hq_U
    exact ⟨s_v, hs_sec, hs_pt⟩

  have hSky_isSheaf :
      ∀ (X : AlgebraicGeometry.Scheme.{u}) {n : ℕ} (τ : Fin n → Quiver.Hom S_k X)
        (M : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology
          (weilPunctCurveSkyscraperPresheaf τ M) := by
    intro X n τ M
    let P := weilPunctCurveSkyscraperPresheaf τ M
    let PT := P ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp X.smallEtaleTopology P
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro W R hR x hx
    have hLiftEx :
        ∀ (a : Fin n) (γ : weilPunctCurveSectionLift τ a W),
          ∃ (V : X.Etale) (f : V ⟶ W) (_ : R.arrows f)
            (γ_V : weilPunctCurveSectionLift τ a V),
            γ_V.1 ≫ f.left = γ.1 := by
      intro a γ
      obtain ⟨V, f, v₀, hf, hEt_f, hv₀⟩ := (hEtaleMem W R).mp hR (γ.1.base pt_k)
      haveI : AlgebraicGeometry.Etale f.left := hEt_f
      let Q := CategoryTheory.Limits.pullback f.left γ.1
      obtain ⟨q₀, _, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v₀ pt_k hv₀
      have hEt_snd : AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.snd f.left γ.1) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback f.left γ.1) hEt_f
      haveI := hEt_snd
      obtain ⟨s_Q, hs_Q, _⟩ :=
        hEtalePtSec Q (CategoryTheory.Limits.pullback.snd f.left γ.1) q₀
      let γ_V : S_k ⟶ V.left := s_Q ≫ CategoryTheory.Limits.pullback.fst f.left γ.1
      have hγV_f : γ_V ≫ f.left = γ.1 :=
        (CategoryTheory.Category.assoc _ _ _).trans
          ((congrArg (s_Q ≫ ·) CategoryTheory.Limits.pullback.condition).trans
            ((CategoryTheory.Category.assoc _ _ _).symm.trans
              ((congrArg (· ≫ γ.1) hs_Q).trans (CategoryTheory.Category.id_comp _))))
      have hγV_hom : γ_V ≫ V.hom = τ a :=
        (congrArg (γ_V ≫ ·) (CategoryTheory.MorphismProperty.Over.w f)).symm.trans
          ((CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ W.hom) hγV_f).trans γ.2))
      exact ⟨V, f, hf, ⟨γ_V, hγV_hom⟩, hγV_f⟩
    have hLiftEq :
        ∀ (a : Fin n) (γ : weilPunctCurveSectionLift τ a W)
          (V₁ : X.Etale) (f₁ : V₁ ⟶ W) (hf₁ : R.arrows f₁) (γ₁ : weilPunctCurveSectionLift τ a V₁)
          (V₂ : X.Etale) (f₂ : V₂ ⟶ W) (hf₂ : R.arrows f₂) (γ₂ : weilPunctCurveSectionLift τ a V₂),
          γ₁.1 ≫ f₁.left = γ.1 →
          γ₂.1 ≫ f₂.left = γ.1 →
          x f₁ hf₁ a γ₁ = x f₂ hf₂ a γ₂ := by
      intro a γ V₁ f₁ hf₁ γ₁ V₂ f₂ hf₂ γ₂ h₁ h₂
      have hEt₁ : AlgebraicGeometry.Etale f₁.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (W' := @AlgebraicGeometry.Etale) f₁.left W.hom W.prop
          (by rw [CategoryTheory.MorphismProperty.Over.w f₁]; exact V₁.prop)
      have hEt₂ : AlgebraicGeometry.Etale f₂.left :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          (W' := @AlgebraicGeometry.Etale) f₂.left W.hom W.prop
          (by rw [CategoryTheory.MorphismProperty.Over.w f₂]; exact V₂.prop)
      haveI := hEt₁
      haveI := hEt₂
      haveI : AlgebraicGeometry.Etale V₁.hom := V₁.prop
      let Z_sch := CategoryTheory.Limits.pullback f₁.left f₂.left
      let fst₁₂ := CategoryTheory.Limits.pullback.fst f₁.left f₂.left
      let snd₁₂ := CategoryTheory.Limits.pullback.snd f₁.left f₂.left
      let Z_et : X.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (fst₁₂ ≫ V₁.hom) inferInstance
      let p₁ : Z_et ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk fst₁₂ rfl trivial
      let p₂ : Z_et ⟶ V₂ :=
        CategoryTheory.MorphismProperty.Over.homMk snd₁₂
          (by
            change snd₁₂ ≫ V₂.hom = fst₁₂ ≫ V₁.hom
            rw [← CategoryTheory.MorphismProperty.Over.w f₁,
              ← CategoryTheory.MorphismProperty.Over.w f₂,
              ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
              CategoryTheory.Limits.pullback.condition]) trivial
      have hp_comm : p₁ ≫ f₁ = p₂ ≫ f₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
      let γ₁₂_left : S_k ⟶ Z_sch :=
        CategoryTheory.Limits.pullback.lift γ₁.1 γ₂.1 (h₁.trans h₂.symm)
      let γ₁₂ : weilPunctCurveSectionLift τ a Z_et :=
        ⟨γ₁₂_left,
          (CategoryTheory.Category.assoc _ _ _).symm.trans
            ((congrArg (· ≫ V₁.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans γ₁.2)⟩
      have hcomp_x := hx p₁ p₂ hf₁ hf₂ hp_comm
      have hev := congrArg (fun s : ∀ a', weilPunctCurveSectionLift τ a' Z_et → ↑M => s a γ₁₂) hcomp_x
      have hl₁ : (⟨γ₁₂.1 ≫ p₁.left,
          (CategoryTheory.Category.assoc γ₁₂.1 p₁.left _).trans
            ((congrArg (γ₁₂.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w p₁)).trans γ₁₂.2)⟩ :
          weilPunctCurveSectionLift τ a V₁) = γ₁ :=
        Subtype.ext (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      have hl₂ : (⟨γ₁₂.1 ≫ p₂.left,
          (CategoryTheory.Category.assoc γ₁₂.1 p₂.left _).trans
            ((congrArg (γ₁₂.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w p₂)).trans γ₁₂.2)⟩ :
          weilPunctCurveSectionLift τ a V₂) = γ₂ :=
        Subtype.ext (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      exact (congrArg (x f₁ hf₁ a) hl₁.symm).trans (hev.trans (congrArg (x f₂ hf₂ a) hl₂))
    let s_amalg : PT.obj (Opposite.op W) := fun a γ =>
      let V := Classical.choose (hLiftEx a γ)
      let f := Classical.choose (Classical.choose_spec (hLiftEx a γ))
      let hf := Classical.choose (Classical.choose_spec (Classical.choose_spec (hLiftEx a γ)))
      let γ_V := Classical.choose
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftEx a γ))))
      x f hf a γ_V
    refine ⟨s_amalg, ?_, ?_⟩
    · intro V f hf
      funext a γ_V
      let γ : weilPunctCurveSectionLift τ a W :=
        ⟨γ_V.1 ≫ f.left,
          (CategoryTheory.Category.assoc γ_V.1 f.left _).trans
            ((congrArg (γ_V.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w f)).trans γ_V.2)⟩
      have hspec := Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftEx a γ))))
      exact hLiftEq a γ _ _ _ _ V f hf γ_V hspec rfl
    · intro s' hs'
      funext a γ
      let V := Classical.choose (hLiftEx a γ)
      let f := Classical.choose (Classical.choose_spec (hLiftEx a γ))
      let hf := Classical.choose (Classical.choose_spec (Classical.choose_spec (hLiftEx a γ)))
      let γ_V := Classical.choose
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftEx a γ))))
      have hspec : γ_V.1 ≫ f.left = γ.1 := Classical.choose_spec
        (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hLiftEx a γ))))
      have hs'_f := congrArg (fun u : ∀ a', weilPunctCurveSectionLift τ a' V → ↑M => u a γ_V)
        (hs' f hf)
      have hl : (⟨γ_V.1 ≫ f.left,
          (CategoryTheory.Category.assoc γ_V.1 f.left _).trans
            ((congrArg (γ_V.1 ≫ ·) (CategoryTheory.MorphismProperty.Over.w f)).trans γ_V.2)⟩ :
          weilPunctCurveSectionLift τ a W) = γ :=
        Subtype.ext hspec
      exact (congrArg (s' a) hl.symm).trans hs'_f

  let U₂_et : Y₂.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₂.ι inferInstance
  let P_et : Y₂.left.Etale := (weilEtaleSitePullback ν).obj W₂_et
  let hδ_comm : CategoryTheory.CategoryStruct.comp e₂.inv W₂_et.hom =
      CategoryTheory.CategoryStruct.comp U₂.ι ν :=
    (CategoryTheory.Iso.inv_comp_eq e₂).mpr he₂.symm
  let δ_sch : Quiver.Hom U₂.toScheme P_et.left :=
    CategoryTheory.Limits.pullback.lift e₂.inv U₂.ι hδ_comm
  let δ_hat : Quiver.Hom U₂_et P_et :=
    CategoryTheory.MorphismProperty.Over.homMk δ_sch
      (CategoryTheory.Limits.pullback.lift_snd e₂.inv U₂.ι hδ_comm) trivial
  let F₁ := weilEtaleLocalTorsionSheaf Y₁.left ℓ W₂_et
  let F₂ := weilEtaleLocalTorsionSheaf Y₂.left ℓ U₂_et
  let pf_ν := (weilEtaleSitePullback ν).sheafPushforwardContinuous AddCommGrpCat.{u}
    Y₁.left.smallEtaleTopology Y₂.left.smallEtaleTopology
  obtain ⟨hOpen_δ, hClosed_δ, θ_fin, hσ_diag, hσ_compl⟩ :=
    hS1 ℓ ν U₂ W₂_et e₂ he₂
  refine ⟨θ_fin, fun s_y hs_y _hc_y _hr_y _hc_ι _hr_ι _hc_p ⟨e_iso⟩ => ?_⟩
  let Y₂_y := CategoryTheory.Limits.pullback ν s_y
  let ι_y := CategoryTheory.Limits.pullback.fst ν s_y
  let p_y := CategoryTheory.Limits.pullback.snd ν s_y
  let pb_y := (weilEtaleSitePullback s_y).sheafPullback AddCommGrpCat.{u}
    Y₁.left.smallEtaleTopology S_k.smallEtaleTopology
  let pb_ι := (weilEtaleSitePullback ι_y).sheafPullback AddCommGrpCat.{u}
    Y₂.left.smallEtaleTopology Y₂_y.smallEtaleTopology
  let pf_p := (weilEtaleSitePullback p_y).sheafPushforwardContinuous AddCommGrpCat.{u}
    S_k.smallEtaleTopology Y₂_y.smallEtaleTopology
  let y : ↥Y₁.left := s_y.base pt_k
  let E_y : S_k.Etale := (weilEtaleSitePullback s_y).obj W₂_et
  let U'_y : Y₂_y.Etale := (weilEtaleSitePullback ι_y).obj U₂_et

  have hSubOfZero :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (H : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (V : S.Etale),
        CategoryTheory.Limits.IsZero H →
        Subsingleton ↥(H.obj.obj (Opposite.op V)) := by
    intro S H V hZ
    have hid0 : CategoryTheory.CategoryStruct.id H = 0 :=
      (CategoryTheory.Limits.IsZero.iff_id_eq_zero H).mp hZ
    let EV : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj (Opposite.op V)
    have hEV0 : (0 : H ⟶ H).hom.app (Opposite.op V) = 0 := EV.map_zero H H
    have hall0 : ∀ a : ↥(H.obj.obj (Opposite.op V)), a = 0 := fun a => by
      have rapp := congrArg (fun φ : H ⟶ H => (φ.hom.app (Opposite.op V)).hom a) hid0
      rw [hEV0] at rapp
      exact rapp
    exact ⟨fun a b => (hall0 a).trans (hall0 b).symm⟩

  by_cases hy : y ∈ U₁
  · have hRange_ιy : Set.range ι_y.base ⊆ Set.range U₂.ι.base := by
      rintro _ ⟨z, rfl⟩
      have hpz : p_y.base z = pt_k := hSub_k.elim _ _
      have hyz : ν.base (ι_y.base z) = y := by
        change (ι_y ≫ ν).base z = y
        rw [CategoryTheory.Limits.pullback.condition]
        change s_y.base (p_y.base z) = y
        rw [hpz]
      have hmemU₂ : ι_y.base z ∈ U₂ := by
        rw [hU₂]
        change ν.base (ι_y.base z) ∈ U₁
        rw [hyz]; exact hy
      exact ⟨⟨ι_y.base z, hmemU₂⟩, rfl⟩
    let ι_U₂ : Y₂_y ⟶ U₂.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U₂.ι ι_y hRange_ιy
    have hι_fac : ι_U₂ ≫ U₂.ι = ι_y :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U₂.ι ι_y hRange_ιy

    let fst_E : E_y.left ⟶ W₂_et.left := CategoryTheory.Limits.pullback.fst W₂_et.hom s_y
    let snd_E : E_y.left ⟶ S_k := CategoryTheory.Limits.pullback.snd W₂_et.hom s_y
    have heZ_hom_comm : (fst_E ≫ e₂.hom ≫ U₂.ι) ≫ ν = snd_E ≫ s_y := by
      have h1 : (fst_E ≫ e₂.hom ≫ U₂.ι) ≫ ν = fst_E ≫ (e₂.hom ≫ (U₂.ι ≫ ν)) := by
        simp only [CategoryTheory.Category.assoc]
      rw [h1, he₂]
      exact CategoryTheory.Limits.pullback.condition
    have heZ_inv_comm : (ι_U₂ ≫ e₂.inv) ≫ W₂_et.hom = p_y ≫ s_y := by
      rw [CategoryTheory.Category.assoc, hδ_comm, ← CategoryTheory.Category.assoc, hι_fac]
      exact CategoryTheory.Limits.pullback.condition
    let hom_Z : E_y.left ⟶ Y₂_y :=
      CategoryTheory.Limits.pullback.lift (fst_E ≫ e₂.hom ≫ U₂.ι) snd_E heZ_hom_comm
    let inv_Z : Y₂_y ⟶ E_y.left :=
      CategoryTheory.Limits.pullback.lift (ι_U₂ ≫ e₂.inv) p_y heZ_inv_comm
    let e_Z : E_y.left ≅ Y₂_y :=
      { hom := hom_Z
        inv := inv_Z
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hfac : hom_Z ≫ ι_U₂ = fst_E ≫ e₂.hom :=
              (CategoryTheory.cancel_mono U₂.ι).mp
                ((CategoryTheory.Category.assoc hom_Z ι_U₂ U₂.ι).trans
                  ((congrArg (hom_Z ≫ ·) hι_fac).trans
                    ((CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
                      (CategoryTheory.Category.assoc fst_E e₂.hom U₂.ι).symm)))
            exact (CategoryTheory.Category.assoc hom_Z inv_Z fst_E).trans
              ((congrArg (hom_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (((CategoryTheory.Category.assoc hom_Z ι_U₂ e₂.inv).symm).trans
                  ((congrArg (· ≫ e₂.inv) hfac).trans
                    ((CategoryTheory.Category.assoc fst_E e₂.hom e₂.inv).trans
                      ((congrArg (fst_E ≫ ·) e₂.hom_inv_id).trans
                        ((CategoryTheory.Category.comp_id fst_E).trans
                          (CategoryTheory.Category.id_comp fst_E).symm))))))
          · exact (CategoryTheory.Category.assoc hom_Z inv_Z snd_E).trans
              ((congrArg (hom_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                  (CategoryTheory.Category.id_comp snd_E).symm))
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · have he2_cancel : (ι_U₂ ≫ e₂.inv) ≫ (e₂.hom ≫ U₂.ι) = ι_y :=
              (CategoryTheory.Category.assoc ι_U₂ e₂.inv (e₂.hom ≫ U₂.ι)).trans
                ((congrArg (ι_U₂ ≫ ·)
                  ((CategoryTheory.Category.assoc e₂.inv e₂.hom U₂.ι).symm.trans
                    ((congrArg (· ≫ U₂.ι) e₂.inv_hom_id).trans
                      (CategoryTheory.Category.id_comp U₂.ι)))).trans hι_fac)
            exact (CategoryTheory.Category.assoc inv_Z hom_Z ι_y).trans
              ((congrArg (inv_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (((CategoryTheory.Category.assoc inv_Z fst_E (e₂.hom ≫ U₂.ι)).symm).trans
                  ((congrArg (· ≫ (e₂.hom ≫ U₂.ι))
                    (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                    (he2_cancel.trans (CategoryTheory.Category.id_comp ι_y).symm))))
          · exact (CategoryTheory.Category.assoc inv_Z hom_Z p_y).trans
              ((congrArg (inv_Z ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                  (CategoryTheory.Category.id_comp p_y).symm)) }
    have hIso_homZ : CategoryTheory.IsIso hom_Z := ⟨⟨inv_Z, e_Z.hom_inv_id, e_Z.inv_hom_id⟩⟩
    have hIso_invZ : CategoryTheory.IsIso inv_Z := ⟨⟨hom_Z, e_Z.inv_hom_id, e_Z.hom_inv_id⟩⟩
    have hEt_homZ : AlgebraicGeometry.Etale hom_Z := inferInstance
    have hEt_invZ : AlgebraicGeometry.Etale inv_Z := inferInstance
    let p_Ey : E_y.left ⟶ S_k := E_y.hom
    have heZ_p : e_Z.hom ≫ p_y = p_Ey :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hFin_py : AlgebraicGeometry.IsFinite p_y :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback ν s_y) inferInstance
    have : AlgebraicGeometry.IsFinite p_y := hFin_py
    have hFin_Ey : AlgebraicGeometry.IsFinite p_Ey :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_horiz_isIso
          (fst := hom_Z) (snd := p_Ey) (f := p_y) (g := CategoryTheory.CategoryStruct.id S_k)
          ⟨heZ_p.trans (CategoryTheory.Category.comp_id p_Ey).symm⟩)
        hFin_py
    have : AlgebraicGeometry.IsFinite p_Ey := hFin_Ey

    let T_Y2 := weilEtaleIdTerminal.{u} Y₂_y
    let hT_Y2 := weilEtaleIdTerminalIsTerminal.{u} Y₂_y
    let B_p := weilEtaleSitePullback p_y
    let lift_U' : Y₂_y ⟶ U'_y.left :=
      CategoryTheory.Limits.pullback.lift ι_U₂ (CategoryTheory.CategoryStruct.id Y₂_y)
        (hι_fac.trans (CategoryTheory.Category.id_comp _).symm)
    let e_U' : U'_y ≅ T_Y2 :=
      { hom := hT_Y2.from U'_y
        inv := CategoryTheory.MorphismProperty.Over.homMk lift_U'
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        hom_inv_id := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          let snd_U' := CategoryTheory.Limits.pullback.snd U₂.ι ι_y
          let fst_U' := CategoryTheory.Limits.pullback.fst U₂.ι ι_y
          change snd_U' ≫ lift_U' = CategoryTheory.CategoryStruct.id U'_y.left
          apply CategoryTheory.Limits.pullback.hom_ext
          · apply (CategoryTheory.cancel_mono U₂.ι).mp
            exact (congrArg (· ≫ U₂.ι)
                ((CategoryTheory.Category.assoc snd_U' lift_U' fst_U').trans
                  (congrArg (snd_U' ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)))).trans
              ((CategoryTheory.Category.assoc snd_U' ι_U₂ U₂.ι).trans
                ((congrArg (snd_U' ≫ ·) hι_fac).trans
                  ((CategoryTheory.Limits.pullback.condition (f := U₂.ι) (g := ι_y)).symm.trans
                    (congrArg (· ≫ U₂.ι) (CategoryTheory.Category.id_comp fst_U').symm))))
          · exact (CategoryTheory.Category.assoc snd_U' lift_U' snd_U').trans
              ((congrArg (snd_U' ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Category.comp_id snd_U').trans
                  (CategoryTheory.Category.id_comp snd_U').symm))
        inv_hom_id := hT_Y2.hom_ext _ _ }
    let lift_Tp : Y₂_y ⟶ (B_p.obj T_k).left :=
      CategoryTheory.Limits.pullback.lift p_y (CategoryTheory.CategoryStruct.id Y₂_y)
        ((CategoryTheory.Category.comp_id _).trans (CategoryTheory.Category.id_comp _).symm)
    let e_Tp : B_p.obj T_k ≅ T_Y2 :=
      { hom := hT_Y2.from (B_p.obj T_k)
        inv := CategoryTheory.MorphismProperty.Over.homMk lift_Tp
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        hom_inv_id := by
          apply CategoryTheory.MorphismProperty.Comma.Hom.ext _ (Subsingleton.elim _ _)
          let snd_Tp := CategoryTheory.Limits.pullback.snd T_k.hom p_y
          let fst_Tp := CategoryTheory.Limits.pullback.fst T_k.hom p_y
          change snd_Tp ≫ lift_Tp = CategoryTheory.CategoryStruct.id (B_p.obj T_k).left
          apply CategoryTheory.Limits.pullback.hom_ext
          · have hcond : fst_Tp ≫ CategoryTheory.CategoryStruct.id S_k = snd_Tp ≫ p_y :=
              CategoryTheory.Limits.pullback.condition (f := T_k.hom) (g := p_y)
            exact (CategoryTheory.Category.assoc snd_Tp lift_Tp fst_Tp).trans
              ((congrArg (snd_Tp ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                (hcond.symm.trans
                  ((CategoryTheory.Category.comp_id fst_Tp).trans
                    (CategoryTheory.Category.id_comp fst_Tp).symm)))
          · exact (CategoryTheory.Category.assoc snd_Tp lift_Tp snd_Tp).trans
              ((congrArg (snd_Tp ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                ((CategoryTheory.Category.comp_id snd_Tp).trans
                  (CategoryTheory.Category.id_comp snd_Tp).symm))
        inv_hom_id := hT_Y2.hom_ext _ _ }

    let L_U' := weilEtaleLocalTorsionSheaf Y₂_y ℓ U'_y
    let L_Y2 := weilEtaleLocalTorsionSheaf Y₂_y ℓ T_Y2
    let id_Y2 := CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_Y2)
    let id_U' := CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_U')
    let e_LU_hom : L_U' ⟶ L_Y2 :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (id_Y2 ≫ L_Y2.obj.map (Opposite.op e_U'.hom))
    let e_LU_inv : L_Y2 ⟶ L_U' :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (id_U' ≫ L_U'.obj.map (Opposite.op e_U'.inv))
    have he_LU_hom_inv : e_LU_hom ≫ e_LU_inv = CategoryTheory.CategoryStruct.id L_U' := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (e_LU_hom ≫ e_LU_inv) =
          (id_Y2 ≫ L_Y2.obj.map (Opposite.op e_U'.hom)) ≫ e_LU_inv.hom.app (Opposite.op U'_y) :=
        (hEquiv_comp e_LU_hom e_LU_inv).trans
          (congrArg (· ≫ e_LU_inv.hom.app (Opposite.op U'_y)) (Equiv.apply_symm_apply _ _))
      have h2 : (id_Y2 ≫ L_Y2.obj.map (Opposite.op e_U'.hom)) ≫
            e_LU_inv.hom.app (Opposite.op U'_y) =
          (id_Y2 ≫ e_LU_inv.hom.app (Opposite.op T_Y2)) ≫ L_U'.obj.map (Opposite.op e_U'.hom) :=
        (CategoryTheory.Category.assoc id_Y2 (L_Y2.obj.map (Opposite.op e_U'.hom))
          (e_LU_inv.hom.app (Opposite.op U'_y))).trans
          ((congrArg (id_Y2 ≫ ·) (e_LU_inv.hom.naturality (Opposite.op e_U'.hom))).trans
            (CategoryTheory.Category.assoc id_Y2 _ _).symm)
      have h3 : id_Y2 ≫ e_LU_inv.hom.app (Opposite.op T_Y2) =
          id_U' ≫ L_U'.obj.map (Opposite.op e_U'.inv) :=
        (hEquiv_comp (CategoryTheory.CategoryStruct.id L_Y2) e_LU_inv).symm.trans
          ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.Category.id_comp e_LU_inv)).trans
            (Equiv.apply_symm_apply _ _))
      have h4 : L_U'.obj.map (Opposite.op e_U'.inv) ≫ L_U'.obj.map (Opposite.op e_U'.hom) =
          CategoryTheory.CategoryStruct.id (L_U'.obj.obj (Opposite.op U'_y)) := by
        have hop : (Opposite.op e_U'.inv ≫ Opposite.op e_U'.hom :
            Opposite.op U'_y ⟶ Opposite.op U'_y) =
            Opposite.op (e_U'.hom ≫ e_U'.inv) := rfl
        exact (L_U'.obj.map_comp (Opposite.op e_U'.inv) (Opposite.op e_U'.hom)).symm.trans
          ((congrArg L_U'.obj.map (hop.trans (congrArg Opposite.op e_U'.hom_inv_id))).trans
            (L_U'.obj.map_id (Opposite.op U'_y)))
      exact h1.trans (h2.trans ((congrArg (· ≫ L_U'.obj.map (Opposite.op e_U'.hom)) h3).trans
        ((CategoryTheory.Category.assoc id_U' _ _).trans
          ((congrArg (id_U' ≫ ·) h4).trans (CategoryTheory.Category.comp_id id_U')))))
    have he_LU_inv_hom : e_LU_inv ≫ e_LU_hom = CategoryTheory.CategoryStruct.id L_Y2 := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv (e_LU_inv ≫ e_LU_hom) =
          (id_U' ≫ L_U'.obj.map (Opposite.op e_U'.inv)) ≫ e_LU_hom.hom.app (Opposite.op T_Y2) :=
        (hEquiv_comp e_LU_inv e_LU_hom).trans
          (congrArg (· ≫ e_LU_hom.hom.app (Opposite.op T_Y2)) (Equiv.apply_symm_apply _ _))
      have h2 : (id_U' ≫ L_U'.obj.map (Opposite.op e_U'.inv)) ≫
            e_LU_hom.hom.app (Opposite.op T_Y2) =
          (id_U' ≫ e_LU_hom.hom.app (Opposite.op U'_y)) ≫ L_Y2.obj.map (Opposite.op e_U'.inv) :=
        (CategoryTheory.Category.assoc id_U' (L_U'.obj.map (Opposite.op e_U'.inv))
          (e_LU_hom.hom.app (Opposite.op T_Y2))).trans
          ((congrArg (id_U' ≫ ·) (e_LU_hom.hom.naturality (Opposite.op e_U'.inv))).trans
            (CategoryTheory.Category.assoc id_U' _ _).symm)
      have h3 : id_U' ≫ e_LU_hom.hom.app (Opposite.op U'_y) =
          id_Y2 ≫ L_Y2.obj.map (Opposite.op e_U'.hom) :=
        (hEquiv_comp (CategoryTheory.CategoryStruct.id L_U') e_LU_hom).symm.trans
          ((congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.Category.id_comp e_LU_hom)).trans
            (Equiv.apply_symm_apply _ _))
      have h4 : L_Y2.obj.map (Opposite.op e_U'.hom) ≫ L_Y2.obj.map (Opposite.op e_U'.inv) =
          CategoryTheory.CategoryStruct.id (L_Y2.obj.obj (Opposite.op T_Y2)) := by
        have hop : (Opposite.op e_U'.hom ≫ Opposite.op e_U'.inv :
            Opposite.op T_Y2 ⟶ Opposite.op T_Y2) =
            Opposite.op (e_U'.inv ≫ e_U'.hom) := rfl
        exact (L_Y2.obj.map_comp (Opposite.op e_U'.hom) (Opposite.op e_U'.inv)).symm.trans
          ((congrArg L_Y2.obj.map (hop.trans (congrArg Opposite.op e_U'.inv_hom_id))).trans
            (L_Y2.obj.map_id (Opposite.op T_Y2)))
      exact h1.trans (h2.trans ((congrArg (· ≫ L_Y2.obj.map (Opposite.op e_U'.inv)) h3).trans
        ((CategoryTheory.Category.assoc id_Y2 _ _).trans
          ((congrArg (id_Y2 ≫ ·) h4).trans (CategoryTheory.Category.comp_id id_Y2)))))
    let e_LU : L_U' ≅ L_Y2 := ⟨e_LU_hom, e_LU_inv, he_LU_hom_inv, he_LU_inv_hom⟩

    haveI : AlgebraicGeometry.IsAffine S_k := inferInstance
    haveI : AlgebraicGeometry.IsAffine E_y.left :=
      AlgebraicGeometry.isAffine_of_isAffineHom p_Ey
    let e_Ey := E_y.left.isoSpec
    let B_cat := E_y.left.presheaf.obj (Opposite.op ⊤)
    let φ_B : CommRingCat.of k ⟶ B_cat :=
      AlgebraicGeometry.Spec.preimage (e_Ey.inv ≫ p_Ey)
    have hmap_B : AlgebraicGeometry.Spec.map φ_B = e_Ey.inv ≫ p_Ey :=
      AlgebraicGeometry.Spec.map_preimage _
    haveI : AlgebraicGeometry.Etale p_Ey := E_y.prop
    have hEt_B : RingHom.Etale φ_B.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
        (by rw [hmap_B]; infer_instance)
    letI : Algebra k ↑B_cat := φ_B.hom.toAlgebra
    haveI : Algebra.Etale k ↑B_cat := RingHom.etale_algebraMap.mp hEt_B
    obtain ⟨d, ⟨ψ_B⟩⟩ := hAlgEtaleSplit ↑B_cat
    let ev_B : ∀ i : Fin d, ↑B_cat →ₐ[k] k :=
      fun i => (Pi.evalAlgHom k (fun _ : Fin d => k) i).comp ψ_B.toAlgHom
    let s_E : Fin d → (S_k ⟶ E_y.left) :=
      fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_B i).toRingHom) ≫ e_Ey.inv
    have hs_E : ∀ i : Fin d, s_E i ≫ p_Ey = CategoryTheory.CategoryStruct.id S_k := by
      intro i
      have hcomp_k : φ_B ≫ CommRingCat.ofHom (ev_B i).toRingHom =
          CategoryTheory.CategoryStruct.id (CommRingCat.of k) := by
        ext c; exact (ev_B i).commutes c
      exact (CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_B i).toRingHom)) e_Ey.inv p_Ey).trans
        ((congrArg (_ ≫ ·) hmap_B.symm).trans
          ((AlgebraicGeometry.Spec.map_comp φ_B (CommRingCat.ofHom (ev_B i).toRingHom)).symm.trans
            ((congrArg AlgebraicGeometry.Spec.map hcomp_k).trans
              (AlgebraicGeometry.Spec.map_id (CommRingCat.of k)))))
    let σ : Fin d → (T_k ⟶ E_y) :=
      fun i => CategoryTheory.MorphismProperty.Over.homMk (s_E i) (hs_E i) trivial
    have hσ_pt_inj : ∀ i j : Fin d, (s_E i).base pt_k = (s_E j).base pt_k → i = j := by
      intro i j hpt
      have hsp : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_B i).toRingHom)).base pt_k =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_B j).toRingHom)).base pt_k := by
        have hL : ∀ idx : Fin d,
            (s_E idx ≫ e_Ey.hom).base pt_k =
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_B idx).toRingHom)).base pt_k :=
          fun idx => congrArg (fun f => f.base pt_k)
            ((CategoryTheory.Category.assoc _ e_Ey.inv e_Ey.hom).trans
              ((congrArg (_ ≫ ·) e_Ey.inv_hom_id).trans (CategoryTheory.Category.comp_id _)))
        exact (hL i).symm.trans ((congrArg e_Ey.hom.base hpt).trans (hL j))
      have hid_eq : Ideal.comap (ev_B i).toRingHom (⊥ : Ideal k) =
          Ideal.comap (ev_B j).toRingHom (⊥ : Ideal k) :=
        congrArg PrimeSpectrum.asIdeal hsp
      by_contra hij
      let ej : Fin d → k := Pi.single (M := fun _ : Fin d => k) j (1 : k)
      have hej_i : ej i = 0 := by simp [ej, hij]
      have hej_j : ej j = (1 : k) := by simp [ej]
      have hmem_i : ψ_B.symm ej ∈ Ideal.comap (ev_B i).toRingHom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot]
        have heval : (ev_B i) (ψ_B.symm ej) = ej i := by
