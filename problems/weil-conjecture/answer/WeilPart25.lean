        (Y_η.germToFunctionField (V_sp α)).hom ((ι_η_sp.app (W_sp α)).hom (u_sp α).1) := by
      change (Y_η.presheaf.map (CategoryTheory.homOfLE hle_V).op ≫
        Y_η.germToFunctionField (V α)).hom _ = _
