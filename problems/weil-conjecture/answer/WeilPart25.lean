    rw [hθ_U_uniq θ_U θ_U0 hθ_U hθ_U0]
    exact hc_ab Ω s_Ω Y_Ω ι_Ω f_Ω hPb_Ω p_Ω p_α hp_Ω hp_α

  refine ⟨V₁, hAff_V₁, hv₀_V₁, hInt_V₁, α₀, hα₀_tor, hα₀_nz, hCupConst_V₁, ?_⟩

  
  intro U_base _ _ g_base _ u_pt hu_pt
  let p_Ubase : Quiver.Hom U_base S_k := CategoryTheory.CategoryStruct.comp g_base p_V₁
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_Ubase := inferInstance
  let u_Ubase : Quiver.Hom U_base (weilAffineSpaceOver k δ).left :=
    CategoryTheory.CategoryStruct.comp g_base (CategoryTheory.CategoryStruct.comp V₁.ι u_V₀)
  haveI : AlgebraicGeometry.Etale u_Ubase := inferInstance

  obtain ⟨s_pt, hs_pt_sec, hs_pt_range⟩ := hSecPkg.1 U_base p_Ubase u_pt hu_pt

  let Y_base := CategoryTheory.Limits.pullback f₁ g_base
  let p_Ybase := CategoryTheory.Limits.pullback.fst f₁ g_base
  let f_base := CategoryTheory.Limits.pullback.snd f₁ g_base
  have hPb_Ybase : CategoryTheory.IsPullback p_Ybase f_base f₁ g_base :=
    CategoryTheory.IsPullback.of_hasPullback f₁ g_base
  have hPb_Ybase_Y₀ :
      CategoryTheory.IsPullback (p_Ybase ≫ p_Y₁_Y₀) f_base f₀ (g_base ≫ V₁.ι) :=
    hPb_Ybase.paste_horiz hPb_Y₁
  haveI : AlgebraicGeometry.IsProper f_base :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Ybase inferInstance
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_base :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Ybase ‹_›

  let C_pt : CategoryTheory.Over S_k :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_base s_pt)
  let ι_pt : Quiver.Hom C_pt.left Y_base :=
    CategoryTheory.Limits.pullback.fst f_base s_pt
  have hPb_Cpt : CategoryTheory.IsPullback ι_pt C_pt.hom f_base s_pt :=
    CategoryTheory.IsPullback.of_hasPullback f_base s_pt
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C_pt.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Cpt ‹_›
  obtain ⟨hInt_Cpt, hProj_Cpt⟩ := hGeomFib_of_isPullback hPb_Ybase_Y₀ k s_pt hPb_Cpt
  obtain ⟨hFin_Cpt, hNonDeg_Cpt⟩ := hProjCurveNonDeg C_pt hInt_Cpt hProj_Cpt

  
  have hBasis_Cpt :
      ∃ (b_pt : ℕ) (e_mod : Fin b_pt → weilCupPDModH C_pt.left ℓ 1),
        Nat.card (weilCupPDModH C_pt.left ℓ 1) = ℓ ^ b_pt ∧
        (∀ c : Fin b_pt → ZMod ℓ,
          (Finset.univ.sum fun i : Fin b_pt => (c i).val • e_mod i) = 0 → c = 0) ∧
        (∀ x : weilCupPDModH C_pt.left ℓ 1,
          ∃ c : Fin b_pt → ZMod ℓ,
            x = Finset.univ.sum fun i : Fin b_pt => (c i).val • e_mod i) := by
    let M_pt := weilCupPDModH C_pt.left ℓ 1
    have : Finite M_pt := hFin_Cpt
    have hMulSmul : ∀ (a : M_pt) (u v : ZMod ℓ),
        u.val • (v.val • a) = (u * v).val • a := by
      intro a u v
      rw [← mul_nsmul', hnsmul_mod (hModTor C_pt.left 1 a)]
      have hcast : (((u.val * v.val : ℕ) : ZMod ℓ)) = u * v := by
        push_cast
        rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      rw [hcast]
    have hNegSmul : ∀ (a : M_pt) (u : ZMod ℓ),
        (- (u.val • a)) = (-u).val • a := by
      intro a u
      have h0 := hSubValSmul (hModTor C_pt.left 1 a) 0 u
      simpa only [zero_sub, ZMod.val_zero, zero_smul] using h0.symm
    let HasInj (b : ℕ) : Prop :=
      ∃ e : Fin b → M_pt,
        Function.Injective
          (fun c : Fin b → ZMod ℓ => Finset.univ.sum fun i : Fin b => (c i).val • e i)
    have h0 : HasInj 0 := by
      refine ⟨Fin.elim0, fun c₁ c₂ _ => ?_⟩
      funext i
      exact Fin.elim0 i
    have hBound : ∀ b : ℕ, HasInj b → b ≤ Nat.card M_pt := by
      rintro b ⟨e, hinj⟩
      have hle : ℓ ^ b ≤ Nat.card M_pt := by
        have hdom : Nat.card (Fin b → ZMod ℓ) = ℓ ^ b := by
          rw [Nat.card_fun, Nat.card_zmod, Nat.card_fin]
        rw [← hdom]
        exact Nat.card_le_card_of_injective _ hinj
      exact le_trans (Nat.lt_pow_self hPrime.one_lt).le hle
    let b_pt : ℕ := Nat.findGreatest HasInj (Nat.card M_pt)
    have hb_pt_prop : HasInj b_pt := Nat.findGreatest_spec (Nat.zero_le (Nat.card M_pt)) h0
    obtain ⟨e_mod, hinj_mod⟩ := hb_pt_prop
    let ψ : (Fin b_pt → ZMod ℓ) → M_pt :=
      fun c => Finset.univ.sum fun i : Fin b_pt => (c i).val • e_mod i
    have hsurj_mod : Function.Surjective ψ := by
      intro x₀
      by_contra hx₀
      have hsucc : HasInj (b_pt + 1) := by
        let e' : Fin (b_pt + 1) → M_pt := Fin.snoc e_mod x₀
        refine ⟨e', fun c₁ c₂ heq => ?_⟩
        let d : Fin (b_pt + 1) → ZMod ℓ := c₁ - c₂
        have hd_sum : (Finset.univ.sum fun i : Fin (b_pt + 1) => (d i).val • e' i) = 0 := by
          have hterm : ∀ i : Fin (b_pt + 1),
              (d i).val • e' i = (c₁ i).val • e' i - (c₂ i).val • e' i :=
            fun i => hSubValSmul (hModTor C_pt.left 1 (e' i)) (c₁ i) (c₂ i)
          simp only [hterm, Finset.sum_sub_distrib, heq, sub_self]
        rw [Fin.sum_univ_castSucc] at hd_sum
        simp only [e', Fin.snoc_castSucc, Fin.snoc_last] at hd_sum
        let z : ZMod ℓ := d (Fin.last b_pt)
        by_cases hz : z = 0
        · have hd_init : ψ (fun i => d i.castSucc) = ψ 0 := by
            have hz0 : z.val • x₀ = 0 := by rw [hz, ZMod.val_zero, zero_smul]
            rw [hz0, add_zero] at hd_sum
            simpa [ψ] using hd_sum
          have hinit_eq := hinj_mod hd_init
          funext j
          refine Fin.lastCases ?_ (fun i => ?_) j
          · exact sub_eq_zero.mp hz
          · exact sub_eq_zero.mp (congrFun hinit_eq i)
        · exfalso
          have hz_eq : z.val • x₀ =
              Finset.univ.sum fun i : Fin b_pt => (- d i.castSucc).val • e_mod i := by
            have hneg := eq_neg_of_add_eq_zero_right hd_sum
            rw [hneg, ← Finset.sum_neg_distrib]
            exact Finset.sum_congr rfl fun i _ => hNegSmul (e_mod i) (d i.castSucc)
          have hx₀_eq : x₀ = ψ (fun i => z⁻¹ * (- d i.castSucc)) := by
            have hmul := congrArg (fun m : M_pt => (z⁻¹).val • m) hz_eq
            rw [hMulSmul x₀ z⁻¹ z, inv_mul_cancel₀ hz, ZMod.val_one, one_smul,
              Finset.smul_sum] at hmul
            refine hmul.trans ?_
            dsimp [ψ]
            exact Finset.sum_congr rfl fun i _ => hMulSmul (e_mod i) z⁻¹ (- d i.castSucc)
          exact hx₀ ⟨fun i => z⁻¹ * (- d i.castSucc), hx₀_eq.symm⟩
      have hle_N : b_pt + 1 ≤ Nat.card M_pt := hBound (b_pt + 1) hsucc
      have hle_b : b_pt + 1 ≤ b_pt := Nat.le_findGreatest hle_N hsucc
      omega
    let eqv_ψ : (Fin b_pt → ZMod ℓ) ≃ M_pt := Equiv.ofBijective ψ ⟨hinj_mod, hsurj_mod⟩
    refine ⟨b_pt, e_mod, ?_, ?_, ?_⟩
    · calc
        Nat.card M_pt = Nat.card (Fin b_pt → ZMod ℓ) := (Nat.card_congr eqv_ψ).symm
        _ = (Nat.card (ZMod ℓ)) ^ (Nat.card (Fin b_pt)) := Nat.card_fun
        _ = ℓ ^ b_pt := by rw [Nat.card_zmod, Nat.card_fin]
    · intro c hc
      have h0_ψ : ψ 0 = 0 := by simp [ψ]
      exact hinj_mod (hc.trans h0_ψ.symm)
    · intro x
      obtain ⟨c, hc⟩ := hsurj_mod x
      exact ⟨c, hc.symm⟩

  obtain ⟨b_pt, e_mod, hCard_Cpt, hLinInd_Cpt, hSpan_Cpt⟩ := hBasis_Cpt

  
  obtain ⟨⟨θ_Cpt_1, hθ_Cpt_1, hbij_Cpt_1⟩, _⟩ :=
