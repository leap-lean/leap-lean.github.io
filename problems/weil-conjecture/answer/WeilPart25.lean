    fun h m i => Classical.choose (hPullPkg.1 h m i)
  have hp_std : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂) (m i : ℕ),
      WeilIsTorsionEtalePullback h m i (p_std h m i) :=
    fun h m i => Classical.choose_spec (hPullPkg.1 h m i)

  have hp_uniq : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} {h : S₁ ⟶ S₂} {m i : ℕ}
      {p : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i},
