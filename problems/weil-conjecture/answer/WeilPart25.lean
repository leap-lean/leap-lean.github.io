  · intro C₁ C₂ _ _ ν _ hν_C U₁ U₂ hU₂ hNeUniv W_et e he
    obtain ⟨hc_ν, _, _, _, _⟩ := hSiteRes.1 ν
    letI := hc_ν
    let U₂_et : C₂.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ U₂.ι inferInstance
    let F₁ := weilEtaleLocalTorsionSheaf C₁.left ℓ W_et
    let F₂ := weilEtaleLocalTorsionSheaf C₂.left ℓ U₂_et
    let pf_ν := (weilEtaleSitePullback ν).sheafPushforwardContinuous AddCommGrpCat.{u}
      C₁.left.smallEtaleTopology C₂.left.smallEtaleTopology
    obtain ⟨e_fin⟩ := hFinPushIso C₁ C₂ ν hν_C U₁ U₂ hU₂ W_et e he
    have hSub₂ : Subsingleton (weilEtaleLocalTorsionH C₂.left ℓ U₂_et 0) :=
