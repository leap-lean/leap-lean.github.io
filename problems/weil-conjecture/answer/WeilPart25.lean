          have hdetT : IsUnit G₂.transpose.det := by
            rw [Matrix.det_transpose]
            exact hG₂_det
          calc
            μ = (1 : Matrix (Fin b₂) (Fin b₂) (ZMod ℓ)).mulVec μ := (Matrix.one_mulVec μ).symm
            _ = (G₂.transpose⁻¹ * G₂.transpose).mulVec μ := by
                  rw [Matrix.nonsing_inv_mul G₂.transpose hdetT]
            _ = G₂.transpose⁻¹.mulVec (G₂.transpose.mulVec μ) :=
                  (Matrix.mulVec_mulVec μ _ _).symm
            _ = G₂.transpose⁻¹.mulVec 0 := by rw [h0]
            _ = 0 := Matrix.mulVec_zero _
        have hex_b : ∃ b : Fin b₂, (G₂.transpose.mulVec μ) b ≠ 0 := by
          by_contra h_all
