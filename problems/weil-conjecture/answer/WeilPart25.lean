  intro g_V₂_sch Y₁_V₂ p₁_Y f₁_V₂ W₁_V₂_open W₁_V₂_et ι_Cfib_V₂ hι_p₁ hPb_Cfib_V₂
    W₂_Y₁ u_rel e_W₂ hu_p₁ hu_f₁
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let Fgt_C := AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let B_ι := weilEtaleSitePullback ι_Cfib_V₂
  let U_et : E.C_fib.left.Etale := B_ι.obj W₁_V₂_et
  let C'_et : E.C_fib.left.Etale := B_ι.obj W₂_Y₁
  let v_et : C'_et ⟶ U_et := B_ι.map u_rel
  let U_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_C.obj U_et).left
  let u_hom : U_sch ⟶ E.C_fib.left := (Fgt_C.obj U_et).hom
  let C'_sch : AlgebraicGeometry.Scheme.{u} := (Fgt_C.obj C'_et).left
  let fst_C' : C'_sch ⟶ W₂_Y₁.left := CategoryTheory.Limits.pullback.fst W₂_Y₁.hom ι_Cfib_V₂
  let c'_hom : C'_sch ⟶ E.C_fib.left := (Fgt_C.obj C'_et).hom

  haveI : AlgebraicGeometry.IsOpenImmersion u_hom := by
    change AlgebraicGeometry.IsOpenImmersion
      (CategoryTheory.Limits.pullback.snd W₁_V₂_open.ι ι_Cfib_V₂)
    infer_instance
  have hRange_U : Set.range u_hom.base = Set.range E.U_fib.ι.base := by
    ext c
    constructor
    · rintro ⟨u, rfl⟩
      have hc_mem : E.ι_Cfib.base (u_hom.base u) ∈ E.W₁_open := by
