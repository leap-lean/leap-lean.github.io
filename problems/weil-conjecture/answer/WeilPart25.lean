            ℓ 1 p₁ ∧
          ∀ β : weilEtaleTorsionH E.U_fib.toScheme ℓ 1, p₁ β = 0) →
        weilEtaleLocalTorsionMapH E.C_fib.left ℓ v_et 1 = 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (P : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
    (V₂ : E.V_bar.left.Etale)
    (h₂ : Quiver.Hom V₂ P.V)
    (v₂ : ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
    (W₂ : E.Y_bar.left.Etale)
    (h_W₂ : Quiver.Hom W₂ P.W)
    (f_W₂ : Quiver.Hom
      ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj W₂).left
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
    (r₁ r₂ : ℕ)
    (hSpecKill :
      ∀ (s_v : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left)
        (C'_sch : AlgebraicGeometry.Scheme.{u})
        (ι_C' : Quiver.Hom C'_sch
          ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj P.W).left)
        (q_C' : Quiver.Hom C'_sch (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (u_fib : Quiver.Hom C'_sch E.U_fib.toScheme),
        Set.range s_v.base = {P.v} →
        CategoryTheory.CategoryStruct.comp s_v
            (CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).hom
              E.V_bar.hom) =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        CategoryTheory.IsPullback ι_C' q_C'
          (CategoryTheory.CategoryStruct.comp P.e_W.hom
            (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
          s_v →
        CategoryTheory.CategoryStruct.comp u_fib
            (CategoryTheory.CategoryStruct.comp E.U_fib.ι E.ι_Cfib) =
          CategoryTheory.CategoryStruct.comp ι_C'
            (CategoryTheory.CategoryStruct.comp
              (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map P.u_W).left)
              (CategoryTheory.CategoryStruct.comp E.e_W₁.hom E.W₁_open.ι)) →
        ∃ p₁ : weilEtaleTorsionH E.U_fib.toScheme ℓ 1 →+ weilEtaleTorsionH C'_sch ℓ 1,
          WeilIsTorsionEtalePullback u_fib ℓ 1 p₁ ∧
          ∀ β : weilEtaleTorsionH E.U_fib.toScheme ℓ 1, p₁ β = 0)
    (hConn_V₂ : ConnectedSpace ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
    (hAff_V₂ : AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left)
    (hv₂_cl : IsClosed ({v₂} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left))
    (hv₂_map : ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h₂).left.base v₂ = P.v)
    (hPb_W₂ : CategoryTheory.IsPullback
      (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map h_W₂).left)
      f_W₂
      (CategoryTheory.CategoryStruct.comp P.e_W.hom
        (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
      (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h₂).left))
    (hIso₁ :
      let g_V₂_sch := ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map
        (CategoryTheory.CategoryStruct.comp h₂ P.g_V)).left
      let Y₁_V₂ := CategoryTheory.Limits.pullback E.f_bar₁ g_V₂_sch
      let p₁_Y := CategoryTheory.Limits.pullback.fst E.f_bar₁ g_V₂_sch
      let f₁_V₂ := CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V₂_sch
      let W₁_V₂_open : Y₁_V₂.Opens := (TopologicalSpace.Opens.map p₁_Y.base).obj E.W₁_open
      let W₁_V₂_et : Y₁_V₂.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ W₁_V₂_open.ι inferInstance
      Nonempty (CategoryTheory.Iso
        ((CategoryTheory.constantSheaf
          (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left).smallEtaleTopology
          AddCommGrpCat.{u}).obj
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin r₁ → ZMod ℓ))))
        (weilEtaleHigherDirectImage f₁_V₂ 1
          (weilEtaleLocalTorsionSheaf Y₁_V₂ ℓ W₁_V₂_et))))
    (hIso₂ :
      let h₂_sch := ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h₂).left
      let Y₂_V₂ := CategoryTheory.Limits.pullback P.f_bar h₂_sch
      let p₂_Y := CategoryTheory.Limits.pullback.fst P.f_bar h₂_sch
      let f₂_V₂ := CategoryTheory.Limits.pullback.snd P.f_bar h₂_sch
      let W₂_V₂_open : Y₂_V₂.Opens := (TopologicalSpace.Opens.map p₂_Y.base).obj P.W_open
      let W₂_V₂_et : Y₂_V₂.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ W₂_V₂_open.ι inferInstance
      Nonempty (CategoryTheory.Iso
        ((CategoryTheory.constantSheaf
          (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V₂).left).smallEtaleTopology
          AddCommGrpCat.{u}).obj
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin r₂ → ZMod ℓ))))
        (weilEtaleHigherDirectImage f₂_V₂ 1
          (weilEtaleLocalTorsionSheaf Y₂_V₂ ℓ W₂_V₂_et)))) :
    weilEtaleHigherDirectImageMap E.π_bar.left 1
      (weilEtaleLocalTorsionMap E.Y_bar.left ℓ
        (CategoryTheory.CategoryStruct.comp h_W₂ P.u_W)) = 0 :=
by
  classical
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance

  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S U₁ U₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).hom :=
      CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom) := by
      rw [hvw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom U₂.prop hEt_comp

  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W] (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_B : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_B (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_k := by
      dsimp [s]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_k : PrimeSpectrum k).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_hom_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k) = x
    rw [hs_pt_spec]
    change (e_W.hom ≫ e_W.inv).base x = x
    rw [e_W.hom_inv_id]
    rfl

  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine V]
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = 𝟙 S_k →
        s₂ ≫ p_V = 𝟙 S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V _ p_V s₁ s₂ hs₁ hs₂ hpt
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hpt
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp

  have hEquiv_comp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ} {W_et : S.Etale}
        {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S m W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro S m W_et F G α g
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hLocMap_comp :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ)
        {V₁ V₂ V₃ : S.Etale} (u₁ : V₁ ⟶ V₂) (u₂ : V₂ ⟶ V₃),
        weilEtaleLocalTorsionMap S m (u₁ ≫ u₂) =
          weilEtaleLocalTorsionMap S m u₁ ≫ weilEtaleLocalTorsionMap S m u₂ := by
    intro S m V₁ V₂ V₃ u₁ u₂
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap S m (u₁ ≫ u₂))
        = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op (u₁ ≫ u₂)) :=
            Equiv.apply_symm_apply _ _
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
            ((weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₂) ≫
              (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁)) := by
            have hop : Opposite.op (u₁ ≫ u₂) =
                (Opposite.op u₂ ≫ Opposite.op u₁ : Opposite.op V₃ ⟶ Opposite.op V₁) := rfl
            rw [hop, CategoryTheory.Functor.map_comp]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₂)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₂)) ≫
            (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁) := by
            have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
                (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₂) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf S m V₃)) ≫
                (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₂) := by
              rw [← hEquiv_comp (𝟙 (weilEtaleLocalTorsionSheaf S m V₂))
                (weilEtaleLocalTorsionMap S m u₂), CategoryTheory.Category.id_comp]
              exact Equiv.apply_symm_apply _ _
            rw [h2]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            ((weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₂) ≫
              (weilEtaleLocalTorsionSheaf S m V₃).obj.map (Opposite.op u₁)) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            ((weilEtaleLocalTorsionSheaf S m V₂).obj.map (Opposite.op u₁) ≫
              (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₁)) := by
            rw [← (weilEtaleLocalTorsionMap S m u₂).hom.naturality (Opposite.op u₁)]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
            (weilEtaleLocalTorsionSheaf S m V₂).obj.map (Opposite.op u₁)) ≫
            (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap S m u₁) ≫
            (weilEtaleLocalTorsionMap S m u₂).hom.app (Opposite.op V₁) := by
            have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (weilEtaleLocalTorsionMap S m u₁) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf S m V₂)) ≫
                (weilEtaleLocalTorsionSheaf S m V₂).obj.map (Opposite.op u₁) :=
              Equiv.apply_symm_apply _ _
            rw [h1]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap S m u₁ ≫ weilEtaleLocalTorsionMap S m u₂) :=
            (hEquiv_comp (weilEtaleLocalTorsionMap S m u₁)
              (weilEtaleLocalTorsionMap S m u₂)).symm

  have hHigherMap_comp :
      ∀ {X S : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X S) (q : ℕ)
        {F₁ F₂ F₃ : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (φ₁ : Quiver.Hom F₁ F₂) (φ₂ : Quiver.Hom F₂ F₃),
        weilEtaleHigherDirectImageMap f q (φ₁ ≫ φ₂) =
          weilEtaleHigherDirectImageMap f q φ₁ ≫ weilEtaleHigherDirectImageMap f q φ₂ := by
    intro X S f q F₁ F₂ F₃ φ₁ φ₂
    dsimp [weilEtaleHigherDirectImageMap]
    rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.whiskerLeft_comp,
      CategoryTheory.Functor.map_comp]
    rfl

  have hConn_of_iso :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (e : X ≅ Y),
        ConnectedSpace ↥Y → ConnectedSpace ↥X := by
    intro X Y e hY
    obtain ⟨y₀⟩ := hY.toNonempty
    refine @ConnectedSpace.mk _ _ ⟨fun U_set V_set hUo hVo hUV hUne hVne => ?_⟩ ⟨e.inv.base y₀⟩
    have hpre_eq : ∀ S : Set ↥X, e.inv.base ⁻¹' S = e.hom.base '' S := by
      intro S
      ext y
      simp only [Set.mem_preimage, Set.mem_image]
      constructor
      · intro hy
        refine ⟨e.inv.base y, hy, ?_⟩
        change (e.inv ≫ e.hom).base y = y
        rw [e.inv_hom_id]
        rfl
      · rintro ⟨x, hx, rfl⟩
        change (e.hom ≫ e.inv).base x ∈ S
        rwa [e.hom_inv_id]
    obtain ⟨u, -, hu⟩ := hUne
    obtain ⟨v, -, hv⟩ := hVne
    obtain ⟨y, -, hyU, hyV⟩ := hY.isPreconnected_univ
      (e.inv.base ⁻¹' U_set) (e.inv.base ⁻¹' V_set)
      (hUo.preimage e.inv.continuous) (hVo.preimage e.inv.continuous)
      (fun z _ => hUV trivial)
      ⟨e.hom.base u, trivial, by rw [hpre_eq]; exact ⟨u, hu, rfl⟩⟩
      ⟨e.hom.base v, trivial, by rw [hpre_eq]; exact ⟨v, hv, rfl⟩⟩
    exact ⟨e.inv.base y, trivial, hyU, hyV⟩

  have hOpenIso_of_range :
      ∀ {A B Z : AlgebraicGeometry.Scheme.{u}} (iA : A ⟶ Z) (iB : B ⟶ Z)
        [AlgebraicGeometry.IsOpenImmersion iA] [AlgebraicGeometry.IsOpenImmersion iB],
        Set.range iA.base = Set.range iB.base →
        ∃ e : A ≅ B, e.hom ≫ iB = iA := by
    intro A B Z iA iB _ _ hRange
    let hom_AB : A ⟶ B := AlgebraicGeometry.IsOpenImmersion.lift iB iA (le_of_eq hRange)
    let inv_BA : B ⟶ A := AlgebraicGeometry.IsOpenImmersion.lift iA iB (le_of_eq hRange.symm)
    have h1 : hom_AB ≫ iB = iA := AlgebraicGeometry.IsOpenImmersion.lift_fac iB iA _
    have h2 : inv_BA ≫ iA = iB := AlgebraicGeometry.IsOpenImmersion.lift_fac iA iB _
    refine ⟨{ hom := hom_AB
              inv := inv_BA
              hom_inv_id := (cancel_mono iA).mp (by
                rw [CategoryTheory.Category.assoc, h2, h1, CategoryTheory.Category.id_comp])
              inv_hom_id := (cancel_mono iB).mp (by
                rw [CategoryTheory.Category.assoc, h1, h2, CategoryTheory.Category.id_comp]) }, h1⟩

  
  let V₂_sch := (Fgt_V.obj V₂).left
  let V₁_sch := (Fgt_V.obj E.V₁).left
  let V_P := (Fgt_V.obj P.V).left
  let W₂_sch := (Fgt_Y.obj W₂).left
  let h₂_sch : V₂_sch ⟶ V_P := (Fgt_V.map h₂).left
  let g_VP : V_P ⟶ V₁_sch := (Fgt_V.map P.g_V).left
  let g_V₂_sch : V₂_sch ⟶ V₁_sch :=
    (Fgt_V.map (CategoryTheory.CategoryStruct.comp h₂ P.g_V)).left
  have hg_V₂_eq : g_V₂_sch = h₂_sch ≫ g_VP :=
    congrArg CategoryTheory.CommaMorphism.left (Fgt_V.map_comp h₂ P.g_V)

  haveI : AlgebraicGeometry.IsProper E.V_bar.hom := E.hProp_Vbar
  haveI : AlgebraicGeometry.IsProper E.Y_bar.hom := E.hProp_Ybar
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj V₂).hom := V₂.prop
  haveI : AlgebraicGeometry.Etale (Fgt_V.obj E.V₁).hom := E.V₁.prop
  haveI : AlgebraicGeometry.IsAffine V₂_sch := hAff_V₂
  haveI : AlgebraicGeometry.IsAffine V₁_sch := E.hAff_V₁
  haveI : AlgebraicGeometry.Etale h₂_sch := hEt_of_etale_hom h₂
  haveI : AlgebraicGeometry.Etale g_V₂_sch := hEt_of_etale_hom (h₂ ≫ P.g_V)

  let p_k_V₂ : V₂_sch ⟶ S_k := (Fgt_V.obj V₂).hom ≫ E.V_bar.hom
  let p_k_V₁ : V₁_sch ⟶ S_k := (Fgt_V.obj E.V₁).hom ≫ E.V_bar.hom
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_k_V₂ := inferInstance
  obtain ⟨s_v₂, hs_v₂_sec, hs_v₂_pt⟩ := hClosedPtSection p_k_V₂ v₂ hv₂_cl
  have hs_v₂_range : Set.range s_v₂.base = {v₂} := by
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨pt', rfl⟩
      rw [hSub_k.elim pt' pt_k]
      exact hs_v₂_pt
    · rintro rfl
      exact ⟨pt_k, hs_v₂_pt⟩
  have hgV₂_w : g_V₂_sch ≫ (Fgt_V.obj E.V₁).hom = (Fgt_V.obj V₂).hom :=
    CategoryTheory.Over.w (Fgt_V.map (CategoryTheory.CategoryStruct.comp h₂ P.g_V))
  have hsv₁_pt : E.s_v₁.base pt_k = E.v₁ := by
    have hmem : E.s_v₁.base pt_k ∈ Set.range E.s_v₁.base := ⟨pt_k, rfl⟩
    rwa [E.hs_v₁_range, Set.mem_singleton_iff] at hmem
  have hs_v₂_g : s_v₂ ≫ g_V₂_sch = E.s_v₁ :=
    hSectionEq p_k_V₁ (s_v₂ ≫ g_V₂_sch) E.s_v₁
      (by
        dsimp [p_k_V₁, p_k_V₂] at hs_v₂_sec ⊢
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc g_V₂_sch, hgV₂_w]
        exact hs_v₂_sec)
      E.hs_v₁_sec
      (by
        rw [hg_V₂_eq]
        change g_VP.base (h₂_sch.base (s_v₂.base pt_k)) = E.s_v₁.base pt_k
        rw [hs_v₂_pt, hv₂_map, P.hv_map, hsv₁_pt])

  
  let Q_open : P.Y.Opens := (TopologicalSpace.Opens.map P.π_Y₁.base).obj E.W₁_open
  have hW_le_Q : P.W_open ≤ Q_open := by
    intro y hy
    let w : ↥(Fgt_Y.obj P.W).left := P.e_W.inv.base ⟨y, hy⟩
    have hw_eq : P.W_open.ι.base (P.e_W.hom.base w) = y := by
      have hid : (P.e_W.inv ≫ P.e_W.hom).base ⟨y, hy⟩ = ⟨y, hy⟩ := by
        rw [P.e_W.inv_hom_id]; rfl
      exact congrArg Subtype.val hid
    have hcomp_w := congrArg (fun m => m.base w) P.hu_W_comp
    change E.W₁_open.ι.base (E.e_W₁.hom.base (((Fgt_Y.map P.u_W).left).base w)) =
      P.π_Y₁.base (P.W_open.ι.base (P.e_W.hom.base w)) at hcomp_w
    rw [hw_eq] at hcomp_w
    change P.π_Y₁.base y ∈ E.W₁_open
    rw [← hcomp_w]
    exact (E.e_W₁.hom.base (((Fgt_Y.map P.u_W).left).base w)).2
  let j_WQ : P.W_open.toScheme ⟶ Q_open.toScheme := P.Y.homOfLE hW_le_Q
  have hj_WQ_ι : j_WQ ≫ Q_open.ι = P.W_open.ι := P.Y.homOfLE_ι hW_le_Q

  let f_W₁ : (Fgt_Y.obj E.W₁).left ⟶ V₁_sch :=
    CategoryTheory.CategoryStruct.comp E.e_W₁.hom
      (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁)
  let T_W := CategoryTheory.Limits.pullback f_W₁ g_VP
  let ψ_W := CategoryTheory.Limits.pullback.lift
    ((Fgt_Y.map P.u_W).left)
    (CategoryTheory.CategoryStruct.comp P.e_W.hom
      (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
    P.hComm_W
  haveI : AlgebraicGeometry.IsFinite ψ_W := P.hFin_W_rel
  haveI : AlgebraicGeometry.IsProper ψ_W := inferInstance
  have hRange_Q_W₁ : Set.range (Q_open.ι ≫ P.π_Y₁).base ⊆ Set.range E.W₁_open.ι.base := by
    rintro _ ⟨z, rfl⟩
    exact ⟨⟨P.π_Y₁.base z.1, z.2⟩, rfl⟩
  let q₀_W₁ : Q_open.toScheme ⟶ E.W₁_open.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift E.W₁_open.ι (Q_open.ι ≫ P.π_Y₁) hRange_Q_W₁
  have hq₀_fac : q₀_W₁ ≫ E.W₁_open.ι = Q_open.ι ≫ P.π_Y₁ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac E.W₁_open.ι (Q_open.ι ≫ P.π_Y₁) hRange_Q_W₁
  let q₁_W₁ : Q_open.toScheme ⟶ (Fgt_Y.obj E.W₁).left := q₀_W₁ ≫ E.e_W₁.inv
  have hComm_Q : q₁_W₁ ≫ f_W₁ = (Q_open.ι ≫ P.f_bar) ≫ g_VP := by
    calc
      (q₀_W₁ ≫ E.e_W₁.inv) ≫ (E.e_W₁.hom ≫ E.W₁_open.ι ≫ E.f_bar₁)
        = q₀_W₁ ≫ (E.e_W₁.inv ≫ E.e_W₁.hom) ≫ (E.W₁_open.ι ≫ E.f_bar₁) := by
            simp only [CategoryTheory.Category.assoc]
      _ = (q₀_W₁ ≫ E.W₁_open.ι) ≫ E.f_bar₁ := by
            rw [E.e_W₁.inv_hom_id, CategoryTheory.Category.id_comp,
              CategoryTheory.Category.assoc]
      _ = Q_open.ι ≫ (P.π_Y₁ ≫ E.f_bar₁) := by
            rw [hq₀_fac, CategoryTheory.Category.assoc]
      _ = Q_open.ι ≫ (P.f_bar ≫ g_VP) := by
            congr 1
            exact P.hComm_Y₁
      _ = (Q_open.ι ≫ P.f_bar) ≫ g_VP :=
            (CategoryTheory.Category.assoc Q_open.ι P.f_bar g_VP).symm
  let ψ_Q : Q_open.toScheme ⟶ T_W :=
    CategoryTheory.Limits.pullback.lift q₁_W₁ (Q_open.ι ≫ P.f_bar) hComm_Q
  have hψ_WQ : (P.e_W.hom ≫ j_WQ) ≫ ψ_Q = ψ_W := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Limits.pullback.lift_fst]
      apply (cancel_mono (E.e_W₁.hom ≫ E.W₁_open.ι)).mp
      calc
        ((P.e_W.hom ≫ j_WQ) ≫ (q₀_W₁ ≫ E.e_W₁.inv)) ≫ (E.e_W₁.hom ≫ E.W₁_open.ι)
          = P.e_W.hom ≫ j_WQ ≫ q₀_W₁ ≫ (E.e_W₁.inv ≫ E.e_W₁.hom) ≫ E.W₁_open.ι := by
              simp only [CategoryTheory.Category.assoc]
        _ = P.e_W.hom ≫ j_WQ ≫ (q₀_W₁ ≫ E.W₁_open.ι) := by
              rw [E.e_W₁.inv_hom_id, CategoryTheory.Category.id_comp]
        _ = P.e_W.hom ≫ (j_WQ ≫ Q_open.ι) ≫ P.π_Y₁ := by
