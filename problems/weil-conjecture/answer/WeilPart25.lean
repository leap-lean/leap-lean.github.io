      obtain ⟨p₀, hp₀⟩ := hPullEx (specToUfib P₀) ℓ 1
      exact ⟨P₀, p₀, hp₀, fun _ hmem => False.elim (List.not_mem_nil hmem)⟩
    | cons β L' ih =>
      obtain ⟨P_cur, p₀, hp₀, hKill_L'⟩ := ih
      haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (specCurve P_cur).hom := hSpecSm P_cur
      obtain ⟨P_pts, hP_disj, hU_compl, hP_bdry⟩ :=
        @hExtractPts P_cur.Y (Fgt_V.obj P_cur.V).left (specCurve P_cur).left
          P_cur.f_bar P_cur.m_pts P_cur.τ_bdry P_cur.W_open
          (specFst P_cur) (specCurve P_cur).hom (specSec P_cur) P_cur.v
          (hSpecCl P_cur) (hSpecPb P_cur) (hSpecSec_pt P_cur)
          P_cur.hτ_sec P_cur.hτ_cl P_cur.hτ_disj P_cur.hW_compl
      let γ := p₀ β
      have hDich :=
        (weil_punctured_curve_mod_prime_h1_finite_and_residue_dichotomy k ℓ hℓ hCurveCoh
          (specCurve P_cur) (hSpecInt P_cur) (hSpecProj P_cur) P_cur.m_pts P_cur.hm_pts_pos
          P_pts hP_disj (specOpen P_cur) (hSpecAffU P_cur) hU_compl).2 γ
      rcases hDich with ⟨γ_bar, p_open, hp_open, hγ_eq⟩ |
          ⟨c, hc_lt, hc_pos, hDiv_ell, hRam_cont⟩
      · 
        obtain ⟨P_next, h_V, h_Y, h_W,
          ⟨hv_map, hComm_Y, hu_W, hW_open, hW_comp⟩, hKill_bar⟩ :=
          weil_rel_curve_cover_unramified_step_annihilation k ℓ hℓ δ W₀ p_W₀ x₀ E
            hPBC hCurveCoh P_cur (specSec P_cur) (specCurve P_cur) (specFst P_cur) γ_bar
            (hSpecSec_range P_cur) (hSpecSec_sec P_cur) (hSpecPb P_cur)
            (hSpecInt P_cur) (hSpecProj P_cur)
        obtain ⟨ν₀, ν_U, _, hν_fst, _, _, hνU_fac, hνU_ufib⟩ :=
          hStepTrans P_next P_cur h_V h_Y h_W hv_map hComm_Y hu_W hW_open hW_comp
        obtain ⟨p_ν₀, hp_ν₀, hν₀_zero⟩ :=
          hKill_bar (specSec P_next) (specCurve P_next) (specFst P_next) ν₀
            (hSpecSec_range P_next) (hSpecSec_sec P_next) (hSpecPb P_next) hν_fst
        obtain ⟨p_νU, hp_νU⟩ := hPullEx ν_U ℓ 1
        obtain ⟨p'_open, hp'_open⟩ := hPullEx (specOpen P_next).ι ℓ 1
        obtain ⟨p_diag, hp_diag⟩ := hPullEx (ν_U ≫ (specOpen P_cur).ι) ℓ 1
        have hp_diag' : WeilIsTorsionEtalePullback ((specOpen P_next).ι ≫ ν₀) ℓ 1 p_diag := by
          rwa [← hνU_fac]
        have hcomp_sq : p_νU.comp p_open = p'_open.comp p_ν₀ :=
          (hPullComp ν_U (specOpen P_cur).ι ℓ 1 p_νU p_open p_diag hp_νU hp_open hp_diag).symm.trans
            (hPullComp (specOpen P_next).ι ν₀ ℓ 1 p'_open p_ν₀ p_diag hp'_open hp_ν₀ hp_diag')
        obtain ⟨p'_0, hp'_0⟩ := hPullEx (specToUfib P_next) ℓ 1
        have hp'_0_comp : WeilIsTorsionEtalePullback (ν_U ≫ specToUfib P_cur) ℓ 1 p'_0 := by
          rwa [hνU_ufib]
        have hp'_eq : p'_0 = p_νU.comp p₀ :=
          hPullComp ν_U (specToUfib P_cur) ℓ 1 p_νU p₀ p'_0 hp_νU hp₀ hp'_0_comp
        refine ⟨P_next, p'_0, hp'_0, ?_⟩
        intro β' hβ'
        rw [hp'_eq, AddMonoidHom.comp_apply]
        rcases List.mem_cons.mp hβ' with rfl | hmem'
        · change p_νU γ = 0
          rw [← hγ_eq]
          change (p_νU.comp p_open) γ_bar = 0
          rw [hcomp_sq, AddMonoidHom.comp_apply, hν₀_zero, map_zero]
        · rw [hKill_L' β' hmem', map_zero]
      · 
        obtain ⟨P_mid, h_V₁, h_Y₁, h_W₁, hComm_mid,
          ⟨hv_mid, hu_W₁, hW_open₁, hW_comp₁, hFin_mid, hSurj_mid⟩, hRam_stalk⟩ :=
          weil_rel_curve_cover_ramified_step_residue_kill k ℓ hℓ δ W₀ p_W₀ x₀ E
            hPBC hCurveCoh P_cur (specSec P_cur) (specCurve P_cur) (specFst P_cur)
            (hSpecInt P_cur) (hSpecProj P_cur) P_pts c
            (hSpecSec_range P_cur) (hSpecSec_sec P_cur) (hSpecPb P_cur)
            hP_bdry hc_lt hc_pos hDiv_ell
        obtain ⟨ν₀, ν_U, hs_mid_eq, hν_fst, hν_snd, hOpen_mid_eq, hνU_fac, hνU_ufib⟩ :=
          hStepTrans P_mid P_cur h_V₁ h_Y₁ h_W₁ hv_mid hComm_mid hu_W₁ hW_open₁ hW_comp₁
        haveI : AlgebraicGeometry.IsFinite
            (CategoryTheory.Limits.pullback.lift h_Y₁ P_mid.f_bar hComm_mid) := hFin_mid
        haveI : AlgebraicGeometry.Surjective
            (CategoryTheory.Limits.pullback.lift h_Y₁ P_mid.f_bar hComm_mid) := hSurj_mid
        obtain ⟨hFin_ν₀, hSurj_ν₀⟩ :=
          hRelFiberPullback P_cur.f_bar P_mid.f_bar h_Y₁ (Fgt_V.map h_V₁).left hComm_mid
            (specFst P_cur) (specCurve P_cur).hom (specSec P_cur)
            (specFst P_mid) (specCurve P_mid).hom (specSec P_mid) ν₀
            (hSpecPb P_cur) (hSpecPb P_mid) hs_mid_eq hν_fst hν_snd
        haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (specCurve P_mid).hom :=
          hSpecSm P_mid
        obtain ⟨p_νU, hp_νU⟩ := hPullEx ν_U ℓ 1
        obtain ⟨γ'_bar, p'_open, hp'_open, hγ'_eq⟩ :=
          hRam_cont (specCurve P_mid) (hSpecInt P_mid) (hSpecProj P_mid)
            ν₀ (specOpen P_mid) ν_U hν_snd hFin_ν₀ hSurj_ν₀
            hOpen_mid_eq (hSpecAffU P_mid) hνU_fac
            (hRam_stalk (specSec P_mid) (specCurve P_mid) (specFst P_mid) ν₀
              (hSpecSec_range P_mid) (hSpecSec_sec P_mid) (hSpecPb P_mid) hν_fst)
            p_νU hp_νU
        obtain ⟨P_next, h_V₂, h_Y₂, h_W₂,
          ⟨hv_next, hComm_next, hu_W₂, hW_open₂, hW_comp₂⟩, hKill_bar'⟩ :=
          weil_rel_curve_cover_unramified_step_annihilation k ℓ hℓ δ W₀ p_W₀ x₀ E
            hPBC hCurveCoh P_mid (specSec P_mid) (specCurve P_mid) (specFst P_mid) γ'_bar
            (hSpecSec_range P_mid) (hSpecSec_sec P_mid) (hSpecPb P_mid)
            (hSpecInt P_mid) (hSpecProj P_mid)
        obtain ⟨ν'₀, ν'_U, _, hν'_fst, _, _, hν'U_fac, hν'U_ufib⟩ :=
          hStepTrans P_next P_mid h_V₂ h_Y₂ h_W₂ hv_next hComm_next hu_W₂ hW_open₂ hW_comp₂
        obtain ⟨p_ν'₀, hp_ν'₀, hν'₀_zero⟩ :=
          hKill_bar' (specSec P_next) (specCurve P_next) (specFst P_next) ν'₀
            (hSpecSec_range P_next) (hSpecSec_sec P_next) (hSpecPb P_next) hν'_fst
        obtain ⟨p_ν'U, hp_ν'U⟩ := hPullEx ν'_U ℓ 1
        obtain ⟨p''_open, hp''_open⟩ := hPullEx (specOpen P_next).ι ℓ 1
        obtain ⟨p'_diag, hp'_diag⟩ := hPullEx (ν'_U ≫ (specOpen P_mid).ι) ℓ 1
        have hp'_diag' : WeilIsTorsionEtalePullback ((specOpen P_next).ι ≫ ν'₀) ℓ 1 p'_diag := by
          rwa [← hν'U_fac]
        have hcomp_sq' : p_ν'U.comp p'_open = p''_open.comp p_ν'₀ :=
          (hPullComp ν'_U (specOpen P_mid).ι ℓ 1 p_ν'U p'_open p'_diag
            hp_ν'U hp'_open hp'_diag).symm.trans
            (hPullComp (specOpen P_next).ι ν'₀ ℓ 1 p''_open p_ν'₀ p'_diag
              hp''_open hp_ν'₀ hp'_diag')
        obtain ⟨p_mid0, hp_mid0⟩ := hPullEx (specToUfib P_mid) ℓ 1
        have hp_mid0_comp : WeilIsTorsionEtalePullback (ν_U ≫ specToUfib P_cur) ℓ 1 p_mid0 := by
          rwa [hνU_ufib]
        have hp_mid_eq : p_mid0 = p_νU.comp p₀ :=
          hPullComp ν_U (specToUfib P_cur) ℓ 1 p_νU p₀ p_mid0 hp_νU hp₀ hp_mid0_comp
        obtain ⟨p''_0, hp''_0⟩ := hPullEx (specToUfib P_next) ℓ 1
        have hp''_0_comp : WeilIsTorsionEtalePullback (ν'_U ≫ specToUfib P_mid) ℓ 1 p''_0 := by
          rwa [hν'U_ufib]
        have hp''_eq : p''_0 = p_ν'U.comp p_mid0 :=
          hPullComp ν'_U (specToUfib P_mid) ℓ 1 p_ν'U p_mid0 p''_0 hp_ν'U hp_mid0 hp''_0_comp
        refine ⟨P_next, p''_0, hp''_0, ?_⟩
        intro β' hβ'
        rw [hp''_eq, hp_mid_eq, AddMonoidHom.comp_apply, AddMonoidHom.comp_apply]
        rcases List.mem_cons.mp hβ' with rfl | hmem'
        · change p_ν'U (p_νU γ) = 0
          rw [← hγ'_eq]
          change (p_ν'U.comp p'_open) γ'_bar = 0
          rw [hcomp_sq', AddMonoidHom.comp_apply, hν'₀_zero, map_zero]
        · rw [hKill_L' β' hmem', map_zero, map_zero]

  obtain ⟨P_N, p₀_N, hp₀_N, hKill_N⟩ := hIndKill L_all
  have hKill_all : ∀ β : weilEtaleTorsionH E.U_fib.toScheme ℓ 1, p₀_N β = 0 := by
    intro β
    apply hKill_N β
    exact Finset.mem_toList.mpr (@Finset.mem_univ _ (Fintype.ofFinite _) β)

  
  obtain ⟨P, h_V_fin, h_W_fin, τ_int, U₁, U₂, g_sec, u₁₂,
    ⟨hv_fin, huW_fin, hPb_WN⟩, hSec₁, hSec₂⟩ :=
    weil_rel_curve_cover_interior_section_chart_pullback k δ W₀ p_W₀ x₀ E P_N

  refine ⟨P, τ_int, U₁, U₂, g_sec, u₁₂, hSec₁, hSec₂, ?_⟩
  intro s_v C'_sch ι_C' q_C' u_fib hs_range hs_sec hPb_C' hu_fib
  let s_vN : S_k ⟶ (Fgt_V.obj P_N.V).left := s_v ≫ (Fgt_V.map h_V_fin).left
  let ι_C'N : C'_sch ⟶ (Fgt_Y.obj P_N.W).left := ι_C' ≫ (Fgt_Y.map h_W_fin).left
  have hsvN_eq : s_vN = specSec P_N := by
    haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj P_N.V).left := P_N.hAff_V
    have hhV_w : (Fgt_V.map h_V_fin).left ≫ (Fgt_V.obj P_N.V).hom =
        (Fgt_V.obj P.V).hom :=
      CategoryTheory.MorphismProperty.Over.w h_V_fin
    refine hSectionEq ((Fgt_V.obj P_N.V).hom ≫ E.V_bar.hom) s_vN (specSec P_N)
      ?_ (hSpecSec_sec P_N) ?_
    · exact (CategoryTheory.Category.assoc s_v (Fgt_V.map h_V_fin).left
        ((Fgt_V.obj P_N.V).hom ≫ E.V_bar.hom)).trans
        ((congrArg (s_v ≫ ·)
          ((CategoryTheory.Category.assoc (Fgt_V.map h_V_fin).left
            (Fgt_V.obj P_N.V).hom E.V_bar.hom).symm.trans
            (congrArg (· ≫ E.V_bar.hom) hhV_w))).trans hs_sec)
    · have hsv_pt : s_v.base pt_k = P.v := by
        have hmem : s_v.base pt_k ∈ Set.range s_v.base := ⟨pt_k, rfl⟩
        rwa [hs_range, Set.mem_singleton_iff] at hmem
      change (Fgt_V.map h_V_fin).left.base (s_v.base pt_k) = (specSec P_N).base pt_k
      rw [hsv_pt, hv_fin, hSpecSec_pt P_N]
  have hPb_C'N : CategoryTheory.IsPullback ι_C'N q_C'
      (CategoryTheory.CategoryStruct.comp P_N.e_W.hom
        (CategoryTheory.CategoryStruct.comp P_N.W_open.ι P_N.f_bar))
      (specSec P_N) := by
    rw [← hsvN_eq]
    exact CategoryTheory.IsPullback.paste_horiz hPb_C' hPb_WN
  let φ_C' : C'_sch ⟶ (specOpen P_N).toScheme :=
    (hSpecToW_pb P_N).lift ι_C'N q_C' hPb_C'N.w
  have hφ_toW : φ_C' ≫ specToW P_N = ι_C'N := (hSpecToW_pb P_N).lift_fst _ _ _
  have hu_fib_eq : u_fib = φ_C' ≫ specToUfib P_N := by
    apply (cancel_mono (E.U_fib.ι ≫ E.ι_Cfib)).mp
    have huW_left : (Fgt_Y.map h_W_fin).left ≫ (Fgt_Y.map P_N.u_W).left =
        (Fgt_Y.map P.u_W).left := by
      rw [← huW_fin]
      rfl
    calc
      u_fib ≫ (E.U_fib.ι ≫ E.ι_Cfib)
        = ι_C' ≫ ((Fgt_Y.map P.u_W).left ≫ E.e_W₁.hom ≫ E.W₁_open.ι) := hu_fib
      _ = ι_C' ≫ (((Fgt_Y.map h_W_fin).left ≫ (Fgt_Y.map P_N.u_W).left) ≫
            (E.e_W₁.hom ≫ E.W₁_open.ι)) :=
            congrArg (fun m => ι_C' ≫ (m ≫ (E.e_W₁.hom ≫ E.W₁_open.ι))) huW_left.symm
      _ = ι_C'N ≫ ((Fgt_Y.map P_N.u_W).left ≫ E.e_W₁.hom ≫ E.W₁_open.ι) :=
            (congrArg (ι_C' ≫ ·)
              (CategoryTheory.Category.assoc (Fgt_Y.map h_W_fin).left
                (Fgt_Y.map P_N.u_W).left (E.e_W₁.hom ≫ E.W₁_open.ι))).trans
              (CategoryTheory.Category.assoc ι_C' (Fgt_Y.map h_W_fin).left
                ((Fgt_Y.map P_N.u_W).left ≫ E.e_W₁.hom ≫ E.W₁_open.ι)).symm
      _ = (φ_C' ≫ specToW P_N) ≫ ((Fgt_Y.map P_N.u_W).left ≫ E.e_W₁.hom ≫ E.W₁_open.ι) :=
            congrArg (· ≫ _) hφ_toW.symm
      _ = (φ_C' ≫ specToUfib P_N) ≫ (E.U_fib.ι ≫ E.ι_Cfib) :=
            (CategoryTheory.Category.assoc φ_C' (specToW P_N) _).trans
              ((congrArg (φ_C' ≫ ·) (hSpecToUfib_fac P_N).symm).trans
                (CategoryTheory.Category.assoc φ_C' (specToUfib P_N) _).symm)
  obtain ⟨p_φ, hp_φ⟩ := hPullEx φ_C' ℓ 1
  obtain ⟨p₁, hp₁⟩ := hPullEx u_fib ℓ 1
  have hp₁_comp : WeilIsTorsionEtalePullback (φ_C' ≫ specToUfib P_N) ℓ 1 p₁ := by
    rwa [← hu_fib_eq]
  have hp₁_eq : p₁ = p_φ.comp p₀_N :=
    hPullComp φ_C' (specToUfib P_N) ℓ 1 p_φ p₀_N p₁ hp_φ hp₀_N hp₁_comp
  refine ⟨p₁, hp₁, ?_⟩
  intro β
  rw [hp₁_eq, AddMonoidHom.comp_apply, hKill_all β, map_zero]

theorem weil_cupPD_mod_comparison_bijective_unique (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ) :
    (∃ θ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j,
      WeilCupPDIsModComparison S m j θ ∧ Function.Bijective θ) ∧
    (∀ θ₁ θ₂ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j,
      WeilCupPDIsModComparison S m j θ₁ →
      WeilCupPDIsModComparison S m j θ₂ →
      θ₁ = θ₂) :=
by
  
  
  
  
  let R := ULift.{u, 0} (ZMod m)
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let R_mod := ModuleCat.of R R
  let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let FM := weilEtaleTorsionSheaf S m
  let oneR := weilCupPDModUnit S m
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let ρ : ℤ →+* R := Int.castRingHom R
  have _hEquivℤ : (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).IsEquivalence :=
    ModuleCat.forget₂AddCommGroupIsEquivalence
  let eℤ := (CategoryTheory.forget₂ (ModuleCat.{u, 0} ℤ) AddCommGrpCat.{u}).asEquivalence
  let L_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
    eℤ.inverse.comp (ModuleCat.extendScalars ρ)
  let adjL_mod : L_mod ⊣ FgtMod :=
    eℤ.symm.toAdjunction.comp (ModuleCat.extendRestrictScalarsAdj ρ)
  let C_mod : AddCommGrpCat.{u} ⥤ ModuleCat.{u, u} R :=
    eℤ.inverse.comp (ModuleCat.coextendScalars ρ)
  let adjR_mod : FgtMod ⊣ C_mod :=
    (ModuleCat.restrictCoextendScalarsAdj ρ).comp eℤ.toAdjunction
  have hasSheafOfRightAdj :
      ∀ {A_cat B_cat : Type (u + 1)} [Category.{u} A_cat] [Category.{u} B_cat]
        {G : B_cat ⥤ A_cat} {F : A_cat ⥤ B_cat} (adj : G ⊣ F),
        S.smallEtaleTopology.HasSheafCompose F := by
    intro A_cat _ B_cat _ G F adj
    refine ⟨fun P_sh hP E => ?_⟩
    have hIso : (P_sh ⋙ coyoneda.obj (Opposite.op (G.obj E))) ≅
        ((P_sh ⋙ F) ⋙ coyoneda.obj (Opposite.op E)) :=
      NatIso.ofComponents (fun W => (adj.homEquiv E (P_sh.obj W)).toIso)
        (fun {W₁ W₂} f => by
          ext g
          exact adj.homEquiv_naturality_right g (P_sh.map f))
    exact Presieve.isSheaf_iso S.smallEtaleTopology hIso (hP (G.obj E))
  have _hHasFgt : S.smallEtaleTopology.HasSheafCompose FgtMod := hasSheafOfRightAdj adjL_mod
  have _hHasC : S.smallEtaleTopology.HasSheafCompose C_mod := hasSheafOfRightAdj adjR_mod
  let U : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) ⥤
      Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    CategoryTheory.sheafCompose S.smallEtaleTopology FgtMod
  let C_sh : Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤
      Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) :=
    CategoryTheory.sheafCompose S.smallEtaleTopology C_mod
  let adj_U : U ⊣ C_sh :=
    Adjunction.mkOfHomEquiv
      { homEquiv := fun F_sh G_sh =>
          { toFun := fun φ =>
              ⟨{ app := fun W => adjR_mod.homEquiv (F_sh.obj.obj W) (G_sh.obj.obj W) (φ.hom.app W)
                 naturality := fun W₁ W₂ f => by
                   let φ₁ : FgtMod.obj (F_sh.obj.obj W₁) ⟶ G_sh.obj.obj W₁ := φ.hom.app W₁
                   let φ₂ : FgtMod.obj (F_sh.obj.obj W₂) ⟶ G_sh.obj.obj W₂ := φ.hom.app W₂
                   have hnat : FgtMod.map (F_sh.obj.map f) ≫ φ₂ = φ₁ ≫ G_sh.obj.map f :=
                     φ.hom.naturality f
                   calc
                     F_sh.obj.map f ≫ adjR_mod.homEquiv (F_sh.obj.obj W₂) (G_sh.obj.obj W₂) φ₂
                       = adjR_mod.homEquiv (F_sh.obj.obj W₁) (G_sh.obj.obj W₂)
                           (FgtMod.map (F_sh.obj.map f) ≫ φ₂) :=
                         (adjR_mod.homEquiv_naturality_left (F_sh.obj.map f) φ₂).symm
                     _ = adjR_mod.homEquiv (F_sh.obj.obj W₁) (G_sh.obj.obj W₂)
                           (φ₁ ≫ G_sh.obj.map f) := by rw [hnat]
                     _ = adjR_mod.homEquiv (F_sh.obj.obj W₁) (G_sh.obj.obj W₁) φ₁ ≫
                           C_mod.map (G_sh.obj.map f) :=
                         adjR_mod.homEquiv_naturality_right φ₁ (G_sh.obj.map f) }⟩
            invFun := fun ψ =>
              ⟨{ app := fun W =>
                   (adjR_mod.homEquiv (F_sh.obj.obj W) (G_sh.obj.obj W)).symm (ψ.hom.app W)
                 naturality := fun W₁ W₂ f => by
                   let ψ₁ : F_sh.obj.obj W₁ ⟶ C_mod.obj (G_sh.obj.obj W₁) := ψ.hom.app W₁
                   let ψ₂ : F_sh.obj.obj W₂ ⟶ C_mod.obj (G_sh.obj.obj W₂) := ψ.hom.app W₂
                   have hnat : F_sh.obj.map f ≫ ψ₂ = ψ₁ ≫ C_mod.map (G_sh.obj.map f) :=
                     ψ.hom.naturality f
                   calc
                     FgtMod.map (F_sh.obj.map f) ≫
                         (adjR_mod.homEquiv (F_sh.obj.obj W₂) (G_sh.obj.obj W₂)).symm ψ₂
                       = (adjR_mod.homEquiv (F_sh.obj.obj W₁) (G_sh.obj.obj W₂)).symm
                           (F_sh.obj.map f ≫ ψ₂) :=
                         (adjR_mod.homEquiv_naturality_left_symm (F_sh.obj.map f) ψ₂).symm
                     _ = (adjR_mod.homEquiv (F_sh.obj.obj W₁) (G_sh.obj.obj W₂)).symm
