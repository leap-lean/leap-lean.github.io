              rcases E₂_op with ⟨E₂⟩
              rcases E₁_op with ⟨E₁⟩
              apply CategoryTheory.Limits.Pi.hom_ext
              intro t
              have hL : (P_y.map f ≫ ι_app E₁) ≫
                  CategoryTheory.Limits.Pi.π (fun _ : Φ₀.fiber.obj (B.obj E₁) => M) t =
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_y.fiber.obj E₂ => M)
                    ((Φ_y.fiber.map f.unop) (α_fib E₁ t)) :=
                (CategoryTheory.Category.assoc (P_y.map f) (ι_app E₁) _).trans
                  ((congrArg (P_y.map f ≫ ·) (hPiLift_π _ t)).trans
                    ((congrArg (· ≫ _)
                        (CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
                          Φ_y M f)).trans
                      (hPiMap_π _ (α_fib E₁ t))))
              have hR : (ι_app E₂ ≫ P_0.map (B.op.map f)) ≫
                  CategoryTheory.Limits.Pi.π (fun _ : Φ₀.fiber.obj (B.obj E₁) => M) t =
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_y.fiber.obj E₂ => M)
                    (α_fib E₂ ((Φ₀.fiber.map (B.map f.unop)) t)) :=
                (CategoryTheory.Category.assoc (ι_app E₂) (P_0.map (B.op.map f)) _).trans
                  ((congrArg (ι_app E₂ ≫ ·)
                      ((congrArg (· ≫ _)
                          (CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
                            Φ₀ M (B.op.map f))).trans
                        (hPiMap_π _ t))).trans
                    (hPiLift_π _ _))
              exact hL.trans
                ((congrArg (CategoryTheory.Limits.Pi.π (fun _ : Φ_y.fiber.obj E₂ => M))
                    (hα_nat f.unop t)).trans hR.symm) } }
    let ρ_sky : pf.obj S_0 ⟶ S_y :=
      { hom :=
          { app := fun E_op => ρ_app E_op.unop
            naturality := fun {E₂_op E₁_op} f => by
              rcases E₂_op with ⟨E₂⟩
              rcases E₁_op with ⟨E₁⟩
              apply CategoryTheory.Limits.Pi.hom_ext
              intro s
              have hL : (P_0.map (B.op.map f) ≫ ρ_app E₁) ≫
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_y.fiber.obj E₁ => M) s =
                  CategoryTheory.Limits.Pi.π (fun _ : Φ₀.fiber.obj (B.obj E₂) => M)
                    ((Φ₀.fiber.map (B.map f.unop)) (β_fib E₁ s)) :=
                (CategoryTheory.Category.assoc (P_0.map (B.op.map f)) (ρ_app E₁) _).trans
                  ((congrArg (P_0.map (B.op.map f) ≫ ·) (hPiLift_π _ s)).trans
                    ((congrArg (· ≫ _)
                        (CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
                          Φ₀ M (B.op.map f))).trans
                      (hPiMap_π _ (β_fib E₁ s))))
              have hR : (ρ_app E₂ ≫ P_y.map f) ≫
                  CategoryTheory.Limits.Pi.π (fun _ : Φ_y.fiber.obj E₁ => M) s =
                  CategoryTheory.Limits.Pi.π (fun _ : Φ₀.fiber.obj (B.obj E₂) => M)
                    (β_fib E₂ ((Φ_y.fiber.map f.unop) s)) :=
                (CategoryTheory.Category.assoc (ρ_app E₂) (P_y.map f) _).trans
                  ((congrArg (ρ_app E₂ ≫ ·)
                      ((congrArg (· ≫ _)
                          (CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_obj_map
                            Φ_y M f)).trans
                        (hPiMap_π _ s))).trans
                    (hPiLift_π _ _))
              exact hL.trans
                ((congrArg (CategoryTheory.Limits.Pi.π (fun _ : Φ₀.fiber.obj (B.obj E₂) => M))
                    (hβ_nat f.unop s)).trans hR.symm) } }
    have hιρ : ι_sky ≫ ρ_sky = 𝟙 S_y := by
      apply CategoryTheory.Sheaf.hom_ext
      ext E_op : 2
      rcases E_op with ⟨E⟩
      apply CategoryTheory.Limits.Pi.hom_ext
      intro s
      exact (CategoryTheory.Category.assoc (ι_app E) (ρ_app E) _).trans
        ((congrArg (ι_app E ≫ ·) (hPiLift_π _ s)).trans
          ((hPiLift_π _ (β_fib E s)).trans
            ((congrArg (CategoryTheory.Limits.Pi.π (fun _ : Φ_y.fiber.obj E => M)) (hαβ E s)).trans
              (CategoryTheory.Category.id_comp _).symm)))
    let adj_sky := Φ_y.skyscraperSheafAdjunction (A := AddCommGrpCat.{u})
    let η_G : G ⟶ S_y := adj_sky.unit.app G
    have hpf0 : pf.map (0 : pb.obj G ⟶ S_0) = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      rw [hSheafZeroHom_W]
      ext E_op x_s
      change (((0 : pb.obj G ⟶ S_0).hom).app (Opposite.op (B.obj E_op.unop))).hom x_s = 0
      rw [hSheafZeroHom]
      rfl
    have hηι : η_G ≫ ι_sky = 0 := by
      let u_zero : pb.obj G ⟶ S_0 := (adj.homEquiv G S_0).symm (η_G ≫ ι_sky)
      have hu0 : u_zero = 0 := hZero.eq_of_src u_zero 0
      exact (Equiv.apply_symm_apply (adj.homEquiv G S_0) (η_G ≫ ι_sky)).symm.trans
        ((congrArg (adj.homEquiv G S_0) hu0).trans
          ((CategoryTheory.Adjunction.homEquiv_unit adj G S_0 0).trans
            ((congrArg (adj.unit.app G ≫ ·) hpf0).trans CategoryTheory.Limits.comp_zero)))
    have hη0 : η_G = 0 :=
      (CategoryTheory.Category.comp_id η_G).symm.trans
        ((congrArg (η_G ≫ ·) hιρ.symm).trans
          (((CategoryTheory.Category.assoc η_G ι_sky ρ_sky).symm.trans
              (congrArg (· ≫ ρ_sky) hηι)).trans
            CategoryTheory.Limits.zero_comp))
    have hPiMap0_π : ∀ {A : Type u} (a : A),
        CategoryTheory.Limits.Pi.map (fun _ : A => (0 : M ⟶ M)) ≫
          CategoryTheory.Limits.Pi.π (fun _ : A => M) a =
        (0 : CategoryTheory.Limits.piObj (fun _ : A => M) ⟶
            CategoryTheory.Limits.piObj (fun _ : A => M)) ≫
          CategoryTheory.Limits.Pi.π (fun _ : A => M) a := by
      intro A a
      simp
    have hSky0 : (Φ_y.skyscraperSheafFunctor (A := AddCommGrpCat.{u})).map (0 : M ⟶ M) = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      rw [hSheafZeroHom_W]
      ext E_op : 2
      rcases E_op with ⟨E⟩
      apply CategoryTheory.Limits.Pi.hom_ext
      intro s
      exact (congrArg (· ≫ CategoryTheory.Limits.Pi.π (fun _ : Φ_y.fiber.obj E => M) s)
        (CategoryTheory.GrothendieckTopology.Point.skyscraperPresheafFunctor_map_app
          Φ_y (0 : M ⟶ M) (Opposite.op E))).trans (hPiMap0_π s)
    have hZeroM : CategoryTheory.Limits.IsZero M := by
      rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
      apply (adj_sky.homEquiv G M).injective
      have h1 : (adj_sky.homEquiv G M) (𝟙 M) = η_G :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_sky G M (𝟙 M)).trans
          ((congrArg (η_G ≫ ·)
              ((Φ_y.skyscraperSheafFunctor (A := AddCommGrpCat.{u})).map_id M)).trans
            (CategoryTheory.Category.comp_id η_G))
      have h2 : (adj_sky.homEquiv G M) 0 = 0 :=
        (CategoryTheory.Adjunction.homEquiv_unit adj_sky G M 0).trans
          ((congrArg (η_G ≫ ·) hSky0).trans CategoryTheory.Limits.comp_zero)
      exact h1.trans (hη0.trans h2.symm)
    let pt_V : Φ_y.fiber.obj V := ⟨z_V, hz_V⟩
    have hTo0 : Φ_y.toPresheafFiber V pt_V G.obj = 0 :=
      hZeroM.eq_of_tgt _ 0
    have hEq0 : (Φ_y.toPresheafFiber V pt_V G.obj).hom x =
        (Φ_y.toPresheafFiber V pt_V G.obj).hom 0 := by
      rw [hTo0]
      simp
    obtain ⟨U, g, pt_U, hpt_U, hx_eq⟩ :=
      (Φ_y.toPresheafFiber_eq_iff' V pt_V x 0).mp hEq0
    have hz_U : pt_U.1 ≫ g.left = z_V := congrArg Subtype.val hpt_U
    have hx0' : (G.obj.map (Opposite.op g)).hom x = (G.obj.map (Opposite.op g)).hom 0 := hx_eq
    exact ⟨U, g, pt_U.1, hz_U, hx0'.trans (map_zero _)⟩

  
  refine ⟨⟨hPart1a, hPart1b, hPart1c⟩, ?_⟩
  intro S _ G hClosed
  have hZeroHom_S : (0 : G ⟶ G).hom = 0 :=
    (CategoryTheory.sheafToPresheaf S.left.smallEtaleTopology AddCommGrpCat.{u}).map_zero G G
  rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
  apply CategoryTheory.Sheaf.hom_ext
  rw [hZeroHom_S]
  ext V_op x
  rcases V_op with ⟨V⟩
  change x = 0
  let O_zero : Set ↥V.left :=
    { v : ↥V.left | ∃ (U : S.left.Etale) (g : U ⟶ V) (u₀ : ↥U.left),
      g.left.base u₀ = v ∧ (G.obj.map (Opposite.op g)).hom x = 0 }
  have hOpen_O : IsOpen O_zero := by
    rw [isOpen_iff_forall_mem_open]
    rintro v ⟨U, g, u₀, hv, hx0⟩
    have hEt_V : P_et V.hom := V.prop
    have hEt_comp : P_et (g.left ≫ V.hom) := by
      rw [CategoryTheory.MorphismProperty.Over.w g]
      exact U.prop
    have : AlgebraicGeometry.Etale g.left :=
      CategoryTheory.MorphismProperty.of_postcomp P_et g.left V.hom hEt_V hEt_comp
    refine ⟨Set.range g.left.base, ?_, (AlgebraicGeometry.Scheme.Hom.isOpenMap g.left).isOpen_range,
      ⟨u₀, hv⟩⟩
    rintro v' ⟨u', rfl⟩
    exact ⟨U, g, u', rfl, hx0⟩
  have hUniv_O : ∀ v₀ : ↥V.left, v₀ ∈ O_zero := by
    intro v₀
    by_contra hv₀
    have hClosed_Z : IsClosed O_zeroᶜ := hOpen_O.isClosed_compl
    have : AlgebraicGeometry.Etale V.hom := V.prop
    obtain ⟨R_cat, ι_W, hOpen_ι, ⟨p₀, hp₀⟩, -⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : V.left.Opens)) (x := v₀) trivial
    have : AlgebraicGeometry.IsOpenImmersion ι_W := hOpen_ι
    obtain ⟨m₀, hm₀_max, hm₀_le⟩ := Ideal.exists_le_maximal p₀.asIdeal p₀.isPrime.ne_top
    let q_max : AlgebraicGeometry.Spec R_cat := ⟨m₀, hm₀_max.isPrime⟩
    have hq_cl : q_max ∈ closure ({p₀} : Set ↥(AlgebraicGeometry.Spec R_cat)) :=
      (PrimeSpectrum.le_iff_mem_closure (x := p₀) (y := q_max)).mp hm₀_le
    have hClosed_pre : IsClosed (ι_W.base ⁻¹' O_zeroᶜ) := hClosed_Z.preimage ι_W.continuous
    have hp₀_pre : p₀ ∈ ι_W.base ⁻¹' O_zeroᶜ := by
      change ι_W.base p₀ ∉ O_zero
      rwa [hp₀]
    have hq_pre : q_max ∈ ι_W.base ⁻¹' O_zeroᶜ :=
      closure_minimal (Set.singleton_subset_iff.mpr hp₀_pre) hClosed_pre hq_cl
    let p_W : AlgebraicGeometry.Spec R_cat ⟶ S_k := ι_W ≫ V.hom ≫ S.hom
    have : AlgebraicGeometry.LocallyOfFiniteType p_W := inferInstance
    obtain ⟨σ₀, hσ₀_comp, hσ₀_pt⟩ := hNull R_cat p_W m₀ hm₀_max
    let z_V : S_k ⟶ V.left := σ₀ ≫ ι_W
    let s_y : S_k ⟶ S.left := z_V ≫ V.hom
    have hs_y : CategoryTheory.CategoryStruct.comp s_y S.hom =
        CategoryTheory.CategoryStruct.id S_k := by
      change (σ₀ ≫ ι_W ≫ V.hom) ≫ S.hom = 𝟙 S_k
      simpa [p_W, CategoryTheory.Category.assoc] using hσ₀_comp
    obtain ⟨hc_y, hr_y, hZero_y⟩ := hClosed s_y hs_y
    obtain ⟨U, g, z_U, hz_U, hx0⟩ :=
      hLocalVanish S.left s_y hc_y hr_y G hZero_y V z_V rfl x
    have hq_in_O : ι_W.base q_max ∈ O_zero := by
      refine ⟨U, g, z_U.base pt_k, ?_, hx0⟩
      have hpt : (z_U ≫ g.left).base pt_k = z_V.base pt_k := by rw [hz_U]
      rw [AlgebraicGeometry.Scheme.Hom.comp_apply] at hpt
      rw [hpt]
      change ι_W.base (σ₀.base pt_k) = ι_W.base q_max
      rw [hσ₀_pt]
    exact hq_pre hq_in_O
  let S_zero : CategoryTheory.Sieve V :=
    { arrows := fun {U} g => (G.obj.map (Opposite.op g)).hom x = 0
      downward_closed := by
        intro U W g hg h
        change (G.obj.map (Opposite.op g ≫ Opposite.op h)).hom x = 0
        rw [G.obj.map_comp]
        change (G.obj.map (Opposite.op h)).hom ((G.obj.map (Opposite.op g)).hom x) = 0
        rw [hg, map_zero] }
  have hCov_V : S_zero ∈ S.left.smallEtaleTopology V := by
    have hTop_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S.left (le_refl P_et)
    have hMem_pre : S_zero ∈ (S.left.smallPretopology P_et P_et).toGrothendieck V := by
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S.left) V S_zero).mpr ?_
      intro v
      obtain ⟨U, g, u₀, hv, hx0⟩ := hUniv_O v
      have hEt_V : P_et V.hom := V.prop
      have hEt_comp : P_et (g.left ≫ V.hom) := by
        rw [CategoryTheory.MorphismProperty.Over.w g]
        exact U.prop
      have hEt_g : P_et g.left :=
        CategoryTheory.MorphismProperty.of_postcomp P_et g.left V.hom hEt_V hEt_comp
      exact ⟨U, g, u₀, hx0, hEt_g, hv⟩
    exact Eq.mpr
      (congrArg (fun (J : CategoryTheory.GrothendieckTopology S.left.Etale) => S_zero ∈ J V) hTop_eq)
      hMem_pre
  have hSep := CategoryTheory.Sheaf.isSeparated G V S_zero hCov_V
  refine hSep x 0 ?_
  intro U g hg
  rw [map_zero]
  exact hg

theorem weil_etale_finite_open_clopenDiag_closedPt_bijective (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Y₁ Y₂ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType Y₁.hom]
    (ν : Quiver.Hom Y₂.left Y₁.left)
    [AlgebraicGeometry.IsFinite ν]
    (hν : CategoryTheory.CategoryStruct.comp ν Y₁.hom = Y₂.hom)
    (U₁ : Y₁.left.Opens)
    (U₂ : Y₂.left.Opens)
    (hU₂ : U₂ = (TopologicalSpace.Opens.map ν.base).obj U₁)
    (W₂_et : Y₁.left.Etale)
    (e₂ : CategoryTheory.Iso W₂_et.left U₂.toScheme)
    (he₂ : CategoryTheory.CategoryStruct.comp e₂.hom
        (CategoryTheory.CategoryStruct.comp U₂.ι ν) = W₂_et.hom)
    [_hc_ν : (weilEtaleSitePullback ν).IsContinuous
      Y₁.left.smallEtaleTopology Y₂.left.smallEtaleTopology] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k := weilEtaleIdTerminal.{u} S_k
    let U₂_et : Y₂.left.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ U₂.ι inferInstance
    let F₁ := weilEtaleLocalTorsionSheaf Y₁.left ℓ W₂_et
    let F₂ := weilEtaleLocalTorsionSheaf Y₂.left ℓ U₂_et
    let pf_ν := (weilEtaleSitePullback ν).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₁.left.smallEtaleTopology Y₂.left.smallEtaleTopology
    ∃ θ_fin : Quiver.Hom F₁ (pf_ν.obj F₂),
      ∀ (s_y : Quiver.Hom S_k Y₁.left),
        CategoryTheory.CategoryStruct.comp s_y Y₁.hom =
          CategoryTheory.CategoryStruct.id S_k →
        let Y₂_y := CategoryTheory.Limits.pullback ν s_y
        let ι_y := CategoryTheory.Limits.pullback.fst ν s_y
        let p_y := CategoryTheory.Limits.pullback.snd ν s_y
        ∀ [_hc_y : (weilEtaleSitePullback s_y).IsContinuous
            Y₁.left.smallEtaleTopology S_k.smallEtaleTopology]
          [_hr_y : ((weilEtaleSitePullback s_y).sheafPushforwardContinuous AddCommGrpCat.{u}
            Y₁.left.smallEtaleTopology S_k.smallEtaleTopology).IsRightAdjoint]
          [_hc_ι : (weilEtaleSitePullback ι_y).IsContinuous
            Y₂.left.smallEtaleTopology Y₂_y.smallEtaleTopology]
          [_hr_ι : ((weilEtaleSitePullback ι_y).sheafPushforwardContinuous AddCommGrpCat.{u}
            Y₂.left.smallEtaleTopology Y₂_y.smallEtaleTopology).IsRightAdjoint]
          [_hc_p : (weilEtaleSitePullback p_y).IsContinuous
            S_k.smallEtaleTopology Y₂_y.smallEtaleTopology],
          let pb_y := (weilEtaleSitePullback s_y).sheafPullback AddCommGrpCat.{u}
            Y₁.left.smallEtaleTopology S_k.smallEtaleTopology
          let pb_ι := (weilEtaleSitePullback ι_y).sheafPullback AddCommGrpCat.{u}
            Y₂.left.smallEtaleTopology Y₂_y.smallEtaleTopology
          let pf_p := (weilEtaleSitePullback p_y).sheafPushforwardContinuous AddCommGrpCat.{u}
            S_k.smallEtaleTopology Y₂_y.smallEtaleTopology
          Nonempty (pb_y.obj (pf_ν.obj F₂) ≅ pf_p.obj (pb_ι.obj F₂)) →
          Function.Bijective
            (((pb_y.map θ_fin).hom.app (Opposite.op T_k)).hom) :=
by
  classical
  have hEtaleMem :
      ∀ {X : AlgebraicGeometry.Scheme.{u}} (W : X.Etale) (R : CategoryTheory.Sieve W),
        R ∈ X.smallEtaleTopology W ↔
          ∀ x : ↥W.left, ∃ (Y : X.Etale) (f : Y ⟶ W) (y : ↥Y.left),
            R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro X W R
    haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    change R ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) X) W ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology X
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R

  have hEmptySub :
      ∀ (S : AlgebraicGeometry.Scheme.{u})
        (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (E : S.Etale),
        IsEmpty ↥E.left → Subsingleton ↥(G.obj.obj (Opposite.op E)) := by
    intro S G E hEmpty
    let GT := G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hGT : CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology GT :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type _ _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf S.smallEtaleTopology G.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) G.property)
    have hBotMem : (⊥ : CategoryTheory.Sieve E) ∈ S.smallEtaleTopology E :=
      (hEtaleMem E ⊥).mpr (fun x => IsEmpty.elim hEmpty x)
    let x₀ : CategoryTheory.Presieve.FamilyOfElements GT (⊥ : CategoryTheory.Sieve E).arrows :=
      fun _ _ hf => False.elim hf
    have hx₀ : x₀.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ _ _
      exact False.elim hf₁
    obtain ⟨t₀, _, ht₀_uniq⟩ := hGT (⊥ : CategoryTheory.Sieve E) hBotMem x₀ hx₀
    refine ⟨fun a b => ?_⟩
    have ha : a = t₀ := ht₀_uniq a (fun _ _ hf => False.elim hf)
    have hb : b = t₀ := ht₀_uniq b (fun _ _ hf => False.elim hf)
    exact ha.trans hb.symm

  have hEmptyZero :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (E : S.Etale),
        IsEmpty ↥E.left → CategoryTheory.Limits.IsZero (weilEtaleLocalTorsionSheaf S m E) := by
    intro S m E hEmpty
    let LT := weilEtaleLocalTorsionSheaf S m E
    have hSub : Subsingleton ↥(LT.obj.obj (Opposite.op E)) := hEmptySub S LT E hEmpty
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    ext a
    exact @Subsingleton.elim _ hSub _ _

  have hDisjAmalg :
      ∀ (X : AlgebraicGeometry.Scheme.{u})
        (F : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})
        (W : X.Etale) (ι : Type u) (V : ι → X.Etale) (c : ∀ i : ι, Quiver.Hom (V i) W),
        (∀ w : ↥W.left, ∃ (i : ι) (v : ↥(V i).left), (c i).left.base v = w) →
        (∀ i : ι, CategoryTheory.Mono (c i)) →
        (∀ i₁ i₂ : ι, i₁ ≠ i₂ → Disjoint (Set.range (c i₁).left.base) (Set.range (c i₂).left.base)) →
        ∀ (s : ∀ i : ι, ↥(F.obj.obj (Opposite.op (V i)))),
          ∃! σ : ↥(F.obj.obj (Opposite.op W)),
            ∀ i : ι, ((F.obj.map (Opposite.op (c i))).hom) σ = s i := by
    intro X F W ι V c hSurj hMono hDisj s
    let FT := F.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hFT : CategoryTheory.Presieve.IsSheaf X.smallEtaleTopology FT :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type _ _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf X.smallEtaleTopology F.obj
          (CategoryTheory.forget AddCommGrpCat.{u}) F.property)
    let P₀ : CategoryTheory.Presieve W := CategoryTheory.Presieve.ofArrows V c
    let R : CategoryTheory.Sieve W := CategoryTheory.Sieve.generate P₀
    have hEt_c : ∀ i : ι, AlgebraicGeometry.Etale (c i).left := by
      intro i
      have hw : (c i).left ≫ W.hom = (V i).hom := CategoryTheory.MorphismProperty.Over.w (c i)
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale) (c i).left W.hom W.prop (by rw [hw]; exact (V i).prop)
    have hR_mem : R ∈ X.smallEtaleTopology W := by
      rw [hEtaleMem]
      intro w
      obtain ⟨i, v, hv⟩ := hSurj w
      exact ⟨V i, c i, v, ⟨V i, CategoryTheory.CategoryStruct.id (V i), c i,
        CategoryTheory.Presieve.ofArrows.mk i, CategoryTheory.Category.id_comp (c i)⟩,
        hEt_c i, hv⟩
    have hFac : ∀ {Y : X.Etale} {f : Y ⟶ W}, R.arrows f → ∃ (i : ι) (h : Y ⟶ V i), h ≫ c i = f := by
      rintro Y f ⟨Z, h, g, ⟨i⟩, hfac⟩
      exact ⟨i, h, hfac⟩
    let x : CategoryTheory.Presieve.FamilyOfElements FT R.arrows :=
      fun Y f hf =>
        let i := Classical.choose (hFac hf)
        let h := Classical.choose (Classical.choose_spec (hFac hf))
        FT.map h.op (s i)
    have hWellDef :
        ∀ {Y : X.Etale} (f : Y ⟶ W) (hf : R.arrows f) (i' : ι) (h' : Y ⟶ V i'),
          h' ≫ c i' = f → x f hf = FT.map h'.op (s i') := by
      intro Y f hf i' h' hh'
      let i := Classical.choose (hFac hf)
      let h := Classical.choose (Classical.choose_spec (hFac hf))
      have hh : h ≫ c i = f := Classical.choose_spec (Classical.choose_spec (hFac hf))
      change FT.map h.op (s i) = FT.map h'.op (s i')
      by_cases hij : i = i'
      · subst hij
        have := hMono i
        have heq : h = h' := (CategoryTheory.cancel_mono (c i)).mp (hh.trans hh'.symm)
        rw [heq]
      · have hEmp : IsEmpty ↥Y.left := by
          refine ⟨fun y => ?_⟩
          have hm1 : f.left.base y ∈ Set.range (c i).left.base := by
            have h1 : (h ≫ c i).left.base y = f.left.base y :=
              congrArg (fun k : Y ⟶ W => k.left.base y) hh
            exact ⟨h.left.base y, h1⟩
          have hm2 : f.left.base y ∈ Set.range (c i').left.base := by
            have h2 : (h' ≫ c i').left.base y = f.left.base y :=
              congrArg (fun k : Y ⟶ W => k.left.base y) hh'
            exact ⟨h'.left.base y, h2⟩
          exact Set.disjoint_left.mp (hDisj i i' hij) hm1 hm2
        have hSub : Subsingleton ↥(F.obj.obj (Opposite.op Y)) := hEmptySub X F Y hEmp
        exact @Subsingleton.elim _ hSub _ _
    have hx_compat : x.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      obtain ⟨i₁, h₁, rfl⟩ := hFac hf₁
      obtain ⟨i₂, h₂, rfl⟩ := hFac hf₂
      rw [hWellDef _ hf₁ i₁ h₁ rfl, hWellDef _ hf₂ i₂ h₂ rfl]
      have h1 : FT.map (g₁ ≫ h₁).op (s i₁) = FT.map g₁.op (FT.map h₁.op (s i₁)) := by
        change (FT.map (h₁.op ≫ g₁.op)) (s i₁) = _
        rw [FT.map_comp]; rfl
      have h2 : FT.map (g₂ ≫ h₂).op (s i₂) = FT.map g₂.op (FT.map h₂.op (s i₂)) := by
        change (FT.map (h₂.op ≫ g₂.op)) (s i₂) = _
        rw [FT.map_comp]; rfl
      rw [← h1, ← h2]
      have hg1_mem : R.arrows (g₁ ≫ (h₁ ≫ c i₁)) := R.downward_closed hf₁ g₁
      rw [← hWellDef (g₁ ≫ (h₁ ≫ c i₁)) hg1_mem i₁ (g₁ ≫ h₁) (CategoryTheory.Category.assoc _ _ _)]
      exact hWellDef (g₁ ≫ (h₁ ≫ c i₁)) hg1_mem i₂ (g₂ ≫ h₂)
        ((CategoryTheory.Category.assoc _ _ _).trans hcomm.symm)
    obtain ⟨σ, hσ_amalg, hσ_uniq⟩ := hFT R hR_mem x hx_compat
    refine ⟨σ, ?_, ?_⟩
    · intro i
      have hci_mem : R.arrows (c i) :=
        ⟨V i, CategoryTheory.CategoryStruct.id (V i), c i,
          CategoryTheory.Presieve.ofArrows.mk i, CategoryTheory.Category.id_comp (c i)⟩
      change FT.map (c i).op σ = s i
      rw [hσ_amalg (c i) hci_mem,
        hWellDef (c i) hci_mem i (CategoryTheory.CategoryStruct.id (V i))
          (CategoryTheory.Category.id_comp (c i))]
      change ((F.obj.map (CategoryTheory.CategoryStruct.id (Opposite.op (V i)))).hom) (s i) = s i
      rw [F.obj.map_id]
      rfl
    · intro σ' hσ'
      refine hσ_uniq σ' (fun Y f hf => ?_)
      obtain ⟨i, h, rfl⟩ := hFac hf
      rw [hWellDef (h ≫ c i) hf i h rfl]
      change (FT.map ((c i).op ≫ h.op)) σ' = FT.map h.op (s i)
      rw [FT.map_comp]
      change FT.map h.op (((F.obj.map (Opposite.op (c i))).hom) σ') = FT.map h.op (s i)
      rw [hσ' i]

  have hEquiv_comp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {m : ℕ} {W_et : S.Etale}
        {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S m W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro S m W_et F G α g
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hLocNsmulZero :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) (U : S.Etale),
        m • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U) = 0 := by
    intro S m U
    let LT := weilEtaleLocalTorsionSheaf S m U
    let J := S.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hL : CategoryTheory.Sheaf.freeYonedaHomEquiv (m • CategoryTheory.CategoryStruct.id LT) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT) ≫
          (m • CategoryTheory.CategoryStruct.id LT).hom.app (Opposite.op U) := by
      simpa using hEquiv_comp (CategoryTheory.CategoryStruct.id LT)
        (m • CategoryTheory.CategoryStruct.id LT)
    have hR : CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : LT ⟶ LT) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT) ≫
          (0 : LT ⟶ LT).hom.app (Opposite.op U) := by
      simpa using hEquiv_comp (CategoryTheory.CategoryStruct.id LT) (0 : LT ⟶ LT)
    rw [hL, hR]
    let EV : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj (Opposite.op U)
    have hEV_nsmul : (m • CategoryTheory.CategoryStruct.id LT).hom.app (Opposite.op U) =
        m • CategoryTheory.CategoryStruct.id (LT.obj.obj (Opposite.op U)) := by
      change EV.map (m • CategoryTheory.CategoryStruct.id LT) =
        m • CategoryTheory.CategoryStruct.id (EV.obj LT)
      rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have hEV_zero : (0 : LT ⟶ LT).hom.app (Opposite.op U) = 0 := by
      change EV.map (0 : LT ⟶ LT) = 0
      exact EV.map_zero LT LT
    have hmAM : (m • CategoryTheory.CategoryStruct.id AM : AM ⟶ AM) = 0 := by
      ext ⟨b⟩
      change ULift.up (m • b) = ULift.up 0
      simp
    rw [hEV_nsmul, hEV_zero, CategoryTheory.Preadditive.comp_nsmul,
      CategoryTheory.Limits.comp_zero, CategoryTheory.Category.comp_id,
      ← CategoryTheory.Category.id_comp
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT)),
      ← CategoryTheory.Preadditive.nsmul_comp, hmAM, CategoryTheory.Limits.zero_comp]

  have hS1 :
      ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        (m : ℕ) [NeZero m]
        (ν : Quiver.Hom Y₂ Y₁) [AlgebraicGeometry.IsFinite ν]
        (U₂ : Y₂.Opens)
        (W₂_et : Y₁.Etale)
        (e₂ : CategoryTheory.Iso W₂_et.left U₂.toScheme)
        (he₂ : CategoryTheory.CategoryStruct.comp e₂.hom
          (CategoryTheory.CategoryStruct.comp U₂.ι ν) = W₂_et.hom)
        [_hc_ν : (weilEtaleSitePullback ν).IsContinuous
          Y₁.smallEtaleTopology Y₂.smallEtaleTopology],
        let U₂_et : Y₂.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ U₂.ι inferInstance
        let P_et : Y₂.Etale := (weilEtaleSitePullback ν).obj W₂_et
        let hδ_comm : CategoryTheory.CategoryStruct.comp e₂.inv W₂_et.hom =
            CategoryTheory.CategoryStruct.comp U₂.ι ν :=
          (CategoryTheory.Iso.inv_comp_eq e₂).mpr he₂.symm
        let δ_sch : Quiver.Hom U₂.toScheme P_et.left :=
          CategoryTheory.Limits.pullback.lift e₂.inv U₂.ι hδ_comm
        let δ_hat : Quiver.Hom U₂_et P_et :=
          CategoryTheory.MorphismProperty.Over.homMk δ_sch
            (CategoryTheory.Limits.pullback.lift_snd e₂.inv U₂.ι hδ_comm) trivial
        let F₁ := weilEtaleLocalTorsionSheaf Y₁ m W₂_et
        let F₂ := weilEtaleLocalTorsionSheaf Y₂ m U₂_et
        let pf_ν := (weilEtaleSitePullback ν).sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₁.smallEtaleTopology Y₂.smallEtaleTopology
        AlgebraicGeometry.IsOpenImmersion δ_sch ∧
        IsClosed (Set.range δ_sch.base) ∧
        ∃ θ_fin : Quiver.Hom F₁ (pf_ν.obj F₂),
          let σ_Δ : ↥(F₂.obj.obj (Opposite.op P_et)) :=
            ((CategoryTheory.Sheaf.freeYonedaHomEquiv θ_fin).hom) (ULift.up (1 : ZMod m))
          ((F₂.obj.map (Opposite.op δ_hat)).hom) σ_Δ =
            ((CategoryTheory.Sheaf.freeYonedaHomEquiv
              (CategoryTheory.CategoryStruct.id F₂)).hom) (ULift.up (1 : ZMod m)) ∧
          ∀ (V : Y₂.Etale) (u : Quiver.Hom V P_et),
            Set.range u.left.base ⊆ (Set.range δ_sch.base)ᶜ →
            ((F₂.obj.map (Opposite.op u)).hom) σ_Δ = 0 := by
    intro Y₁ Y₂ m _ ν _ U₂ W₂_et e₂ he₂ _hc_ν
    let U₂_et : Y₂.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U₂.ι inferInstance
    let P_et : Y₂.Etale := (weilEtaleSitePullback ν).obj W₂_et
    let hδ_comm : CategoryTheory.CategoryStruct.comp e₂.inv W₂_et.hom =
        CategoryTheory.CategoryStruct.comp U₂.ι ν :=
      (CategoryTheory.Iso.inv_comp_eq e₂).mpr he₂.symm
    let δ_sch : Quiver.Hom U₂.toScheme P_et.left :=
      CategoryTheory.Limits.pullback.lift e₂.inv U₂.ι hδ_comm
    let δ_hat : Quiver.Hom U₂_et P_et :=
      CategoryTheory.MorphismProperty.Over.homMk δ_sch
        (CategoryTheory.Limits.pullback.lift_snd e₂.inv U₂.ι hδ_comm) trivial
    let F₁ := weilEtaleLocalTorsionSheaf Y₁ m W₂_et
    let F₂ := weilEtaleLocalTorsionSheaf Y₂ m U₂_et
    let pf_ν := (weilEtaleSitePullback ν).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₁.smallEtaleTopology Y₂.smallEtaleTopology
    have hδ_snd : δ_sch ≫ P_et.hom = U₂.ι :=
      CategoryTheory.Limits.pullback.lift_snd e₂.inv U₂.ι hδ_comm
    have hEt_δ : AlgebraicGeometry.Etale δ_sch :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (W' := @AlgebraicGeometry.Etale) δ_sch P_et.hom P_et.prop
        (by rw [hδ_snd]; infer_instance)
    haveI : AlgebraicGeometry.Etale δ_sch := hEt_δ
    let fst_P : P_et.left ⟶ W₂_et.left := CategoryTheory.Limits.pullback.fst W₂_et.hom ν
    let r_ret : P_et.left ⟶ U₂.toScheme := fst_P ≫ e₂.hom
    have hδ_ret : δ_sch ≫ r_ret = CategoryTheory.CategoryStruct.id U₂.toScheme :=
      (CategoryTheory.Category.assoc δ_sch fst_P e₂.hom).symm.trans
        ((congrArg (· ≫ e₂.hom) (CategoryTheory.Limits.pullback.lift_fst e₂.inv U₂.ι hδ_comm)).trans
          e₂.inv_hom_id)
    have hMono_δ : CategoryTheory.Mono δ_sch :=
      ⟨fun {Z} g₁ g₂ h => by
        have hr := congrArg (· ≫ r_ret) h
        simpa only [CategoryTheory.Category.assoc, hδ_ret, CategoryTheory.Category.comp_id] using hr⟩
    haveI : CategoryTheory.Mono δ_sch := hMono_δ
    have hOpen_δ : AlgebraicGeometry.IsOpenImmersion δ_sch :=
      AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono δ_sch
    have hProp_ν : AlgebraicGeometry.IsProper ν := inferInstance
    have hSep_ν : AlgebraicGeometry.IsSeparated ν := inferInstance
    have hSep_fstP : AlgebraicGeometry.IsSeparated fst_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback W₂_et.hom ν).flip hSep_ν
    haveI : AlgebraicGeometry.IsSeparated fst_P := hSep_fstP
    haveI : AlgebraicGeometry.IsSeparated r_ret := inferInstance
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion (δ_sch ≫ r_ret) := by
      rw [hδ_ret]; infer_instance
    haveI : AlgebraicGeometry.IsClosedImmersion (δ_sch ≫ r_ret) := hCl_comp
    have hClosedImm_δ : AlgebraicGeometry.IsClosedImmersion δ_sch :=
      AlgebraicGeometry.IsClosedImmersion.of_comp δ_sch r_ret
    haveI : AlgebraicGeometry.IsClosedImmersion δ_sch := hClosedImm_δ
    have hClosed_δ : IsClosed (Set.range δ_sch.base) := δ_sch.isClosedMap.isClosed_range
    let O₀ : P_et.left.Opens := ⟨(Set.range δ_sch.base)ᶜ, hClosed_δ.isOpen_compl⟩
    haveI : AlgebraicGeometry.Etale P_et.hom := P_et.prop
    let O₀_et : Y₂.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ (O₀.ι ≫ P_et.hom) inferInstance
    let i₀ : O₀_et ⟶ P_et :=
      CategoryTheory.MorphismProperty.Over.homMk O₀.ι rfl trivial
    let V_cov : ULift.{u} Bool → Y₂.Etale := fun b => if b.down then U₂_et else O₀_et
    let c_cov : ∀ b : ULift.{u} Bool, V_cov b ⟶ P_et :=
      fun b => by cases b with | up b => cases b; exact i₀; exact δ_hat
    have hSurj_cov : ∀ p : ↥P_et.left,
        ∃ (b : ULift.{u} Bool) (v : ↥(V_cov b).left), (c_cov b).left.base v = p := by
      intro p
      by_cases hp : p ∈ Set.range δ_sch.base
      · obtain ⟨u, hu⟩ := hp
        exact ⟨ULift.up true, u, hu⟩
      · exact ⟨ULift.up false, ⟨p, hp⟩, rfl⟩
    have hMono_cov : ∀ b : ULift.{u} Bool, CategoryTheory.Mono (c_cov b) := by
      rintro ⟨_ | _⟩
      · refine ⟨fun {Z} g₁ g₂ h => CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)⟩
        have hleft : g₁.left ≫ O₀.ι = g₂.left ≫ O₀.ι :=
          congrArg (fun k : Z ⟶ P_et => k.left) h
        exact (CategoryTheory.cancel_mono O₀.ι).mp hleft
      · refine ⟨fun {Z} g₁ g₂ h => CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)⟩
        have hleft : g₁.left ≫ δ_sch = g₂.left ≫ δ_sch :=
          congrArg (fun k : Z ⟶ P_et => k.left) h
        exact (CategoryTheory.cancel_mono δ_sch).mp hleft
    have hDisj_cov : ∀ b₁ b₂ : ULift.{u} Bool, b₁ ≠ b₂ →
        Disjoint (Set.range (c_cov b₁).left.base) (Set.range (c_cov b₂).left.base) := by
      rintro ⟨_ | _⟩ ⟨_ | _⟩ hne
      · exact (hne rfl).elim
      · rw [Set.disjoint_left]
        rintro _ ⟨z, rfl⟩ hp
        exact z.2 hp
      · rw [Set.disjoint_left]
        rintro _ hp ⟨z, rfl⟩
        exact z.2 hp
      · exact (hne rfl).elim
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let gen₁ : ↥(F₂.obj.obj (Opposite.op U₂_et)) :=
      ((CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id F₂)).hom)
        (ULift.up (1 : ZMod m))
    let s_cov : ∀ b : ULift.{u} Bool, ↥(F₂.obj.obj (Opposite.op (V_cov b))) :=
      fun b => by cases b with | up b => cases b; exact 0; exact gen₁
    obtain ⟨σ_Δ₀, hσ_res, _⟩ :=
      hDisjAmalg Y₂ F₂ P_et (ULift.{u} Bool) V_cov c_cov hSurj_cov hMono_cov hDisj_cov s_cov
    have hσ_true : ((F₂.obj.map (Opposite.op δ_hat)).hom) σ_Δ₀ = gen₁ :=
      hσ_res (ULift.up true)
    have hσ_false : ((F₂.obj.map (Opposite.op i₀)).hom) σ_Δ₀ = 0 :=
      hσ_res (ULift.up false)
    have hm_gen₁ : m • gen₁ = 0 := by
      have h0 := hLocNsmulZero Y₂ m U₂_et
      let EV : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
        CategoryTheory.sheafToPresheaf Y₂.smallEtaleTopology AddCommGrpCat.{u} ⋙
          (CategoryTheory.evaluation (Opposite Y₂.Etale) AddCommGrpCat.{u}).obj (Opposite.op U₂_et)
      have hEV : (m • CategoryTheory.CategoryStruct.id F₂).hom.app (Opposite.op U₂_et) =
          m • CategoryTheory.CategoryStruct.id (F₂.obj.obj (Opposite.op U₂_et)) := by
        change EV.map (m • CategoryTheory.CategoryStruct.id F₂) =
          m • CategoryTheory.CategoryStruct.id (EV.obj F₂)
        rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id]
      have hEV0 : (0 : F₂ ⟶ F₂).hom.app (Opposite.op U₂_et) = 0 := EV.map_zero F₂ F₂
      have rapp := congrArg (fun φ : F₂ ⟶ F₂ => (φ.hom.app (Opposite.op U₂_et)).hom gen₁) h0
      rw [hEV, hEV0] at rapp
      exact rapp
    have hm_σ : m • σ_Δ₀ = 0 := by
      have hzero_uniq : ∀ (z : ↥(F₂.obj.obj (Opposite.op P_et))),
          (∀ b : ULift.{u} Bool, ((F₂.obj.map (Opposite.op (c_cov b))).hom) z = 0) → z = 0 := by
        intro z hz
        obtain ⟨_, _, huniq0⟩ :=
          hDisjAmalg Y₂ F₂ P_et (ULift.{u} Bool) V_cov c_cov hSurj_cov hMono_cov hDisj_cov
            (fun _ => 0)
        exact (huniq0 z hz).trans (huniq0 0 (fun _ => map_zero _)).symm
      refine hzero_uniq (m • σ_Δ₀) ?_
      rintro ⟨_ | _⟩
      · exact (map_nsmul ((F₂.obj.map (Opposite.op i₀)).hom) m σ_Δ₀).trans
          ((congrArg (m • ·) hσ_false).trans (nsmul_zero m))
      · exact (map_nsmul ((F₂.obj.map (Opposite.op δ_hat)).hom) m σ_Δ₀).trans
          ((congrArg (m • ·) hσ_true).trans hm_gen₁)
    have hm_pos : 0 < m := NeZero.pos m
    let φ_Δ : AM ⟶ (pf_ν.obj F₂).obj.obj (Opposite.op W₂_et) :=
      AddCommGrpCat.ofHom
        { toFun := fun a => a.down.val • σ_Δ₀
          map_zero' := by change (0 : ZMod m).val • σ_Δ₀ = 0; simp
          map_add' := fun a b => by
            change (a.down + b.down).val • σ_Δ₀ = a.down.val • σ_Δ₀ + b.down.val • σ_Δ₀
            rw [ZMod.val_add]
            have hdiv := Nat.div_add_mod (a.down.val + b.down.val) m
            calc
              ((a.down.val + b.down.val) % m) • σ_Δ₀
