      exact Algebra.FiniteType.isNoetherianRing k A
    have h𝔪_nil : IsNilpotent 𝔪 := by
      rw [← hnil_eq]
      exact @IsNoetherianRing.isNilpotent_nilradical A _ hNoethA
    obtain ⟨y₀⟩ := hW
    obtain ⟨V, hAffV, hy₀, _⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := ⊤) (Set.mem_univ y₀)
    let B_cat := W.presheaf.obj (Opposite.op V)
    let B := ↑B_cat
    have hNonemptySpecB : Nonempty (PrimeSpectrum B) :=
      ⟨hAffV.isoSpec.hom.base ⟨y₀, hy₀⟩⟩
    haveI : Nontrivial B := (PrimeSpectrum.nonempty_iff_nontrivial (R := B)).mp hNonemptySpecB
    obtain ⟨𝔫, h𝔫_max⟩ := Ideal.exists_maximal B
    letI : 𝔫.IsMaximal := h𝔫_max
    haveI : 𝔫.IsPrime := h𝔫_max.isPrime
    let ψ_cat : A_cat ⟶ B_cat := f.appLE ⊤ V le_top
    let ψ : A →+* B := ψ_cat.hom
    have hψ_Et : ψ.Etale :=
      AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.Etale)
        f inferInstance ⟨⊤, AlgebraicGeometry.isAffineOpen_top X⟩ ⟨V, hAffV⟩ le_top
    have hψ_FT : ψ.FiniteType :=
      AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.LocallyOfFiniteType)
        f inferInstance ⟨⊤, AlgebraicGeometry.isAffineOpen_top X⟩ ⟨V, hAffV⟩ le_top
    have hcomap_𝔫 : Ideal.comap ψ 𝔫 = 𝔪 := by
      haveI : (Ideal.comap ψ 𝔫).IsPrime := Ideal.IsPrime.comap ψ
      exact h𝔪_uniq (Ideal.comap ψ 𝔫)
    letI : Field (A ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    letI : Field (B ⧸ 𝔫) := Ideal.Quotient.field 𝔫
    let θ_A : k →+* (A ⧸ 𝔪) := (Ideal.Quotient.mk 𝔪).comp φ
    have hθA_FT : θ_A.FiniteType :=
      RingHom.FiniteType.comp
        (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective) hφ_FT
    let e_A : k ≃+* (A ⧸ 𝔪) := RingEquiv.ofBijective θ_A (hNull (A ⧸ 𝔪) θ_A hθA_FT)
    let θ_B : k →+* (B ⧸ 𝔫) := (Ideal.Quotient.mk 𝔫).comp (ψ.comp φ)
    have hθB_FT : θ_B.FiniteType :=
      RingHom.FiniteType.comp
        (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
        (RingHom.FiniteType.comp hψ_FT hφ_FT)
    let e_B : k ≃+* (B ⧸ 𝔫) := RingEquiv.ofBijective θ_B (hNull (B ⧸ 𝔫) θ_B hθB_FT)
    let g₀_ring : B →+* (A ⧸ 𝔪) :=
      (e_A.toRingHom.comp e_B.symm.toRingHom).comp (Ideal.Quotient.mk 𝔫)
    letI : Algebra A B := ψ.toAlgebra
    haveI : Algebra.Etale A B := RingHom.etale_algebraMap.mp hψ_Et
    haveI : Algebra.FormallyEtale A B := Algebra.Etale.formallyEtale
    haveI : Algebra.FormallySmooth A B := inferInstance
    let g₀ : B →ₐ[A] (A ⧸ 𝔪) :=
      { toRingHom := g₀_ring
        commutes' := by
          intro a
          let c : k := e_A.symm (Ideal.Quotient.mk 𝔪 a)
          have hc_A : Ideal.Quotient.mk 𝔪 (φ c) = Ideal.Quotient.mk 𝔪 a :=
            e_A.apply_symm_apply (Ideal.Quotient.mk 𝔪 a)
          have hsub_𝔪 : φ c - a ∈ 𝔪 := Ideal.Quotient.eq.mp hc_A
          rw [← hcomap_𝔫, Ideal.mem_comap] at hsub_𝔪
          have hsub_𝔫 : ψ (φ c) - ψ a ∈ 𝔫 := by rwa [← map_sub]
          have hc_B : Ideal.Quotient.mk 𝔫 (ψ a) = e_B c :=
            (Ideal.Quotient.eq.mpr hsub_𝔫).symm
          change e_A (e_B.symm (Ideal.Quotient.mk 𝔫 (ψ a))) = Ideal.Quotient.mk 𝔪 a
          rw [hc_B, e_B.symm_apply_apply]
          exact e_A.apply_symm_apply (Ideal.Quotient.mk 𝔪 a) }
    obtain ⟨g_alg, _⟩ :=
      Algebra.FormallySmooth.exists_lift (R := A) (A := B) (B := A) 𝔪 h𝔪_nil g₀
    have h_retract : ψ_cat ≫ CommRingCat.ofHom g_alg.toRingHom = 𝟙 A_cat := by
      ext a
      exact g_alg.commutes a
    have hSpecMap :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_alg.toRingHom) ≫
          AlgebraicGeometry.Spec.map ψ_cat = 𝟙 (AlgebraicGeometry.Spec A_cat) := by
      rw [← AlgebraicGeometry.Spec.map_comp, h_retract, AlgebraicGeometry.Spec.map_id]
    have hFromSpec :
        AlgebraicGeometry.Spec.map ψ_cat ≫ X.isoSpec.inv = hAffV.fromSpec ≫ f := by
      rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_top (X := X)]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f
        (AlgebraicGeometry.isAffineOpen_top X) hAffV le_top
    refine ⟨X.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_alg.toRingHom) ≫
      hAffV.fromSpec, ?_⟩
    calc
      (X.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_alg.toRingHom) ≫
          hAffV.fromSpec) ≫ f
        = X.isoSpec.hom ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_alg.toRingHom) ≫
            (hAffV.fromSpec ≫ f) := by
            simp only [CategoryTheory.Category.assoc]
      _ = X.isoSpec.hom ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom g_alg.toRingHom) ≫
            AlgebraicGeometry.Spec.map ψ_cat) ≫ X.isoSpec.inv := by
            rw [← hFromSpec]
            simp only [CategoryTheory.Category.assoc]
      _ = 𝟙 X := by
            rw [hSpecMap, CategoryTheory.Category.id_comp, X.isoSpec.hom_inv_id]

  have hLift : ∀ (i : Fin n) (W : AlgebraicGeometry.Scheme.{u}), Nonempty ↥W →
      ∀ (f : W ⟶ (O i : AlgebraicGeometry.Scheme.{u})) [AlgebraicGeometry.Etale f],
        ∃ g : (O i : AlgebraicGeometry.Scheme.{u}) ⟶ W,
          g ≫ f = 𝟙 (O i : AlgebraicGeometry.Scheme.{u}) := by
    intro i W hW f _
    haveI : AlgebraicGeometry.IsAffine (O i : AlgebraicGeometry.Scheme.{u}) := hAffO i
    haveI : Nonempty ↥(O i : AlgebraicGeometry.Scheme.{u}) := hNEO i
    haveI : Subsingleton ↥(O i : AlgebraicGeometry.Scheme.{u}) := hSubO i
    exact hLift_gen (O i : AlgebraicGeometry.Scheme.{u}) W ((O i).ι ≫ p) hW f

  
  letI : CategoryTheory.Category.{u, u + 1}
      (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale.{u}) ⊤ Z) :=
    (inferInstance : CategoryTheory.Category Z.Etale)
  haveI : AlgebraicGeometry.Scheme.IsJointlySurjectivePreserving (@AlgebraicGeometry.Etale.{u}) :=
    ⟨fun _ x y hxy =>
      let ⟨a, ha, _⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback x y hxy
      ⟨a, ha⟩⟩
  haveI : AlgebraicGeometry.Scheme.JointlySurjective
      (AlgebraicGeometry.Scheme.precoverage (@AlgebraicGeometry.Etale.{u})) :=
    ⟨fun _ hS x => by
      obtain ⟨_, _, hmap, hx⟩ := hS.1 x
      cases hmap with
      | @of Y g hg => exact ⟨Y, g, hg, hx⟩⟩

  let J := Z.smallEtaleTopology
  let T_Z : Z.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 Z) inferInstance
  have hTerm : CategoryTheory.Limits.IsTerminal T_Z :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
        (CategoryTheory.Category.comp_id E.hom) trivial)
      (fun E m => CategoryTheory.MorphismProperty.Over.Hom.ext
        ((CategoryTheory.Category.comp_id m.left).symm.trans m.w))
  let E : Fin n → Z.Etale := fun i =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ (O i).ι inferInstance
  let π : ∀ i : Fin n, E i ⟶ T_Z := fun i =>
    CategoryTheory.MorphismProperty.Over.homMk (O i).ι
      (CategoryTheory.Category.comp_id (O i).ι) trivial

  have hEmptySub : ∀ (Z_et : Z.Etale), IsEmpty ↥Z_et.left →
      ∀ (ℰ : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        Subsingleton (((CategoryTheory.sheafForget J).obj ℰ).obj.obj (Opposite.op Z_et)) := by
    intro Z_et hEmp ℰ
    let bot_et : CategoryTheory.Sieve Z_et :=
      { arrows := fun _ _ => False
        downward_closed := fun hf _ => False.elim hf }
    let U_emp : PEmpty.{u + 1} → Z_et.left.Opens := fun j => PEmpty.elim j
    have hCov₀ : TopologicalSpace.IsOpenCover U_emp :=
      eq_top_iff.mpr (fun x _ => IsEmpty.elim hEmp x)
    let 𝒰₀ := (Z_et.left.openCoverOfIsOpenCover U_emp hCov₀).changeProp
      (Q := @AlgebraicGeometry.Etale.{u}) (fun j => PEmpty.elim j)
    letI : ∀ j : 𝒰₀.I₀, (𝒰₀.X j).Over Z := fun j => PEmpty.elim j
    letI hOver₀ : AlgebraicGeometry.Scheme.Cover.Over Z 𝒰₀ :=
      ⟨inferInstance, fun j => PEmpty.elim j⟩
    have hP₀ : ∀ j : 𝒰₀.I₀, AlgebraicGeometry.Etale (𝒰₀.X j ↘ Z) :=
      fun j => PEmpty.elim j
    have hBotMem : bot_et ∈ J Z_et := by
      refine (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology Z_et bot_et).mpr
        ⟨𝒰₀, hOver₀, hP₀, ?_⟩
      intro W g hg
      rcases hg with ⟨j⟩
      exact PEmpty.elim j
    have hSheafBot :=
      ((CategoryTheory.sheafForget J).obj ℰ).property.isSheafFor _ hBotMem
    refine ⟨fun t₁ t₂ => hSheafBot.isSeparatedFor.ext (fun _ _ hf => False.elim hf)⟩

  have hCovSieve : CategoryTheory.Sieve.ofArrows E π ∈ J T_Z := by
    let O_u : ULift.{u} (Fin n) → Z.Opens := fun k => O k.down
    have hCov_u : TopologicalSpace.IsOpenCover O_u := by
      rw [TopologicalSpace.IsOpenCover, eq_top_iff]
      intro x hx
      have hx' : x ∈ (⨆ i, O i) := by
        have htop : (⨆ i, O i) = ⊤ := hCov
        rwa [htop]
      rw [TopologicalSpace.Opens.mem_iSup] at hx' ⊢
      obtain ⟨i, hi⟩ := hx'
