      (CategoryTheory.IsPullback.of_hasPullback f_U gu₀).paste_horiz hPb_YU
    have hcomm₀ : (q_u₀ ≫ γ₀) ≫ V.hom = ι_u₀ ≫ f_U :=
      (CategoryTheory.Category.assoc q_u₀ γ₀ V.hom).trans
        ((congrArg (q_u₀ ≫ ·) hγ₀).trans CategoryTheory.Limits.pullback.condition.symm)
    let ℓ₀ : Y_u₀ ⟶ (B_fU.obj V).left :=
      CategoryTheory.Limits.pullback.lift (q_u₀ ≫ γ₀) ι_u₀ hcomm₀
    have hℓ₀_comp : ℓ₀ ≫ ((B_fU.obj V).hom ≫ p_YU) = ι_u₀ ≫ p_YU :=
      (CategoryTheory.Category.assoc ℓ₀ (B_fU.obj V).hom p_YU).symm.trans
        (congrArg (· ≫ p_YU) (CategoryTheory.Limits.pullback.lift_snd _ _ _))
    have hp_α₀ : p_std ℓ₀ ℓ 2 a_V = p_std (ι_u₀ ≫ p_YU) ℓ 2 α₀ :=
      (DFunLike.congr_fun (hp_comp ℓ₀ ((B_fU.obj V).hom ≫ p_YU) ℓ 2) α₀).symm.trans
        (congrArg (fun m => p_std m ℓ 2 α₀) hℓ₀_comp)
    have hp_eq : u₁.down.val • p_std (ι_u₀ ≫ p_YU) ℓ 2 α₀ =
        u₂.down.val • p_std (ι_u₀ ≫ p_YU) ℓ 2 α₀ :=
      (congrArg (u₁.down.val • ·) hp_α₀.symm).trans
        ((map_nsmul (p_std ℓ₀ ℓ 2) u₁.down.val a_V).symm.trans
          ((congrArg (p_std ℓ₀ ℓ 2) hθ_eq).trans
            ((map_nsmul (p_std ℓ₀ ℓ 2) u₂.down.val a_V).trans
              (congrArg (u₂.down.val • ·) hp_α₀))))
    have htor₀ : ℓ • p_std (ι_u₀ ≫ p_YU) ℓ 2 α₀ = 0 :=
      (map_nsmul (p_std (ι_u₀ ≫ p_YU) ℓ 2) ℓ α₀).symm.trans
        ((congrArg (p_std (ι_u₀ ≫ p_YU) ℓ 2) hα₀_tor).trans (map_zero _))
    have hnz₀ : p_std (ι_u₀ ≫ p_YU) ℓ 2 α₀ ≠ 0 :=
      hα₀_nz Ω₀ (gu₀ ≫ g_U) Y_u₀ (ι_u₀ ≫ p_YU) q_u₀ hPb_tot₀ _ (hp_std _ ℓ 2)
    have hsub₀ : (u₁.down - u₂.down).val • p_std (ι_u₀ ≫ p_YU) ℓ 2 α₀ = 0 :=
      (hSubValSmul htor₀ u₁.down u₂.down).trans (sub_eq_zero.mpr hp_eq)
    exact ULift.ext _ _ (sub_eq_zero.mp (hZModSmulZero htor₀ hnz₀ hsub₀))

  have _ : Finite ↥AM :=
    Finite.of_equiv (ZMod ℓ) Equiv.ulift.symm
  let T_U : U.Etale := weilEtaleIdTerminal.{u} U
  let x_β : ↥(P_U.obj (Opposite.op T_U)) :=
    (Θ_YU (B_fU.obj T_U)).symm (p_std (B_fU.obj T_U).hom ℓ 2 β)
  obtain ⟨R, hR_mem, hR_loc⟩ :=
    weil_etale_sheafify_finite_pigeonhole_local_constancy U AM P_U α_U hα_inj hIso_U T_U x_β

  have hR_beta : ∀ (V : U.Etale) (f : Quiver.Hom V T_U), R.arrows f →
      ∃ c : ZMod ℓ,
        p_std (B_fU.obj V).hom ℓ 2 β =
          c.val • p_std ((B_fU.obj V).hom ≫ p_YU) ℓ 2 α₀ := by
    intro V f hf
    obtain ⟨u_c, hu_c⟩ := hR_loc V f hf
    refine ⟨u_c.down, ?_⟩
    let f_map := ((AlgebraicGeometry.Scheme.Etale.forget Y_U).map (B_fU.map f)).left
    have hL1 : Θ_YU (B_fU.obj V)
        (((F_YU.cohomologyPresheaf 2).map (B_fU.map f).op).hom x_β) =
        p_std f_map ℓ 2 (Θ_YU (B_fU.obj T_U) x_β) :=
      hΘ_YU (B_fU.map f) (p_std f_map ℓ 2) (hp_std f_map ℓ 2) x_β
    have hL2 : p_std f_map ℓ 2 (Θ_YU (B_fU.obj T_U) x_β) =
        p_std f_map ℓ 2 (p_std (B_fU.obj T_U).hom ℓ 2 β) :=
      congrArg (p_std f_map ℓ 2) ((Θ_YU (B_fU.obj T_U)).apply_symm_apply _)
    have hw : f_map ≫ (B_fU.obj T_U).hom = (B_fU.obj V).hom :=
      CategoryTheory.MorphismProperty.Over.w (B_fU.map f)
    have hL3 : p_std f_map ℓ 2 (p_std (B_fU.obj T_U).hom ℓ 2 β) =
        p_std (B_fU.obj V).hom ℓ 2 β :=
      (DFunLike.congr_fun (hp_comp f_map (B_fU.obj T_U).hom ℓ 2) β).symm.trans
        (congrArg (fun m => p_std m ℓ 2 β) hw)
    have hR1 : Θ_YU (B_fU.obj V) ((α_U.app (Opposite.op V)).hom u_c) =
        u_c.down.val • p_std ((B_fU.obj V).hom ≫ p_YU) ℓ 2 α₀ :=
      (Θ_YU (B_fU.obj V)).apply_symm_apply _
    exact hL3.symm.trans (hL2.symm.trans (hL1.symm.trans
      ((congrArg (Θ_YU (B_fU.obj V)) hu_c).trans hR1)))

  
  let O : ZMod ℓ → Set ↥U := fun c =>
    { u : ↥U | ∃ (V : U.Etale) (f : Quiver.Hom V T_U),
      R.arrows f ∧ u ∈ Set.range V.hom.base ∧
      p_std (B_fU.obj V).hom ℓ 2 β =
        c.val • p_std ((B_fU.obj V).hom ≫ p_YU) ℓ 2 α₀ }

  have hO_open : ∀ c : ZMod ℓ, IsOpen (O c) := by
    intro c
    rw [isOpen_iff_forall_mem_open]
    rintro u ⟨V, f, hf, hu_mem, heq⟩
    have _ : AlgebraicGeometry.Etale V.hom := V.prop
    exact ⟨Set.range V.hom.base, fun u' hu' => ⟨V, f, hf, hu', heq⟩,
      V.hom.isOpenMap.isOpen_range, hu_mem⟩

  have hO_cov : ∀ u : ↥U, ∃ c : ZMod ℓ, u ∈ O c := by
    intro u
    have hJ_U :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U (le_refl P_et)
    have hR_pre : R ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck T_U :=
      Eq.mp
        (congrArg (fun K : CategoryTheory.GrothendieckTopology U.Etale => R ∈ K T_U) hJ_U)
        hR_mem
    obtain ⟨V, f, y, hf, _, hy⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) T_U R).mp hR_pre u
    have hf_hom : f.left = V.hom :=
      (CategoryTheory.Category.comp_id f.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w f)
    have hu_range : u ∈ Set.range V.hom.base := ⟨y, hf_hom ▸ hy⟩
    obtain ⟨c, hc⟩ := hR_beta V f hf
    exact ⟨c, V, f, hf, hu_range, hc⟩

  have hO_disj : ∀ {u : ↥U} {c₁ c₂ : ZMod ℓ}, u ∈ O c₁ → u ∈ O c₂ → c₁ = c₂ := by
    rintro u c₁ c₂ ⟨V₁_et, _, _, hu₁, heq₁⟩ ⟨V₂_et, _, _, hu₂, heq₂⟩
    let Ω_u := AlgebraicClosure ↥(U.residueField u)
    let gu : AlgebraicGeometry.Spec (CommRingCat.of Ω_u) ⟶ U :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥(U.residueField u) Ω_u)) ≫
        U.fromSpecResidueField u
    obtain ⟨γ₁, hγ₁⟩ := hLiftAt u V₁_et hu₁
    obtain ⟨γ₂, hγ₂⟩ := hLiftAt u V₂_et hu₂
    let Y_u := CategoryTheory.Limits.pullback f_U gu
    let ι_u := CategoryTheory.Limits.pullback.fst f_U gu
    let q_u := CategoryTheory.Limits.pullback.snd f_U gu
    have hPb_tot : CategoryTheory.IsPullback (ι_u ≫ p_YU) q_u f₁ (gu ≫ g_U) :=
      (CategoryTheory.IsPullback.of_hasPullback f_U gu).paste_horiz hPb_YU
    have hcomm₁ : (q_u ≫ γ₁) ≫ V₁_et.hom = ι_u ≫ f_U :=
      (CategoryTheory.Category.assoc q_u γ₁ V₁_et.hom).trans
        ((congrArg (q_u ≫ ·) hγ₁).trans CategoryTheory.Limits.pullback.condition.symm)
    have hcomm₂ : (q_u ≫ γ₂) ≫ V₂_et.hom = ι_u ≫ f_U :=
      (CategoryTheory.Category.assoc q_u γ₂ V₂_et.hom).trans
        ((congrArg (q_u ≫ ·) hγ₂).trans CategoryTheory.Limits.pullback.condition.symm)
    let ℓ₁ : Y_u ⟶ (B_fU.obj V₁_et).left :=
      CategoryTheory.Limits.pullback.lift (q_u ≫ γ₁) ι_u hcomm₁
    let ℓ₂ : Y_u ⟶ (B_fU.obj V₂_et).left :=
      CategoryTheory.Limits.pullback.lift (q_u ≫ γ₂) ι_u hcomm₂
    have hℓ₁_snd : ℓ₁ ≫ (B_fU.obj V₁_et).hom = ι_u :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hℓ₂_snd : ℓ₂ ≫ (B_fU.obj V₂_et).hom = ι_u :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hℓ₁_comp : ℓ₁ ≫ ((B_fU.obj V₁_et).hom ≫ p_YU) = ι_u ≫ p_YU :=
      (CategoryTheory.Category.assoc ℓ₁ (B_fU.obj V₁_et).hom p_YU).symm.trans
        (congrArg (· ≫ p_YU) hℓ₁_snd)
    have hℓ₂_comp : ℓ₂ ≫ ((B_fU.obj V₂_et).hom ≫ p_YU) = ι_u ≫ p_YU :=
      (CategoryTheory.Category.assoc ℓ₂ (B_fU.obj V₂_et).hom p_YU).symm.trans
        (congrArg (· ≫ p_YU) hℓ₂_snd)
    have hp₁ : p_std ι_u ℓ 2 β = c₁.val • p_std (ι_u ≫ p_YU) ℓ 2 α₀ :=
      (congrArg (fun m => p_std m ℓ 2 β) hℓ₁_snd.symm).trans
        ((DFunLike.congr_fun (hp_comp ℓ₁ (B_fU.obj V₁_et).hom ℓ 2) β).trans
          ((congrArg (p_std ℓ₁ ℓ 2) heq₁).trans
            ((map_nsmul (p_std ℓ₁ ℓ 2) c₁.val _).trans
              (congrArg (c₁.val • ·)
                ((DFunLike.congr_fun (hp_comp ℓ₁ ((B_fU.obj V₁_et).hom ≫ p_YU) ℓ 2) α₀).symm.trans
                  (congrArg (fun m => p_std m ℓ 2 α₀) hℓ₁_comp))))))
    have hp₂ : p_std ι_u ℓ 2 β = c₂.val • p_std (ι_u ≫ p_YU) ℓ 2 α₀ :=
      (congrArg (fun m => p_std m ℓ 2 β) hℓ₂_snd.symm).trans
        ((DFunLike.congr_fun (hp_comp ℓ₂ (B_fU.obj V₂_et).hom ℓ 2) β).trans
          ((congrArg (p_std ℓ₂ ℓ 2) heq₂).trans
            ((map_nsmul (p_std ℓ₂ ℓ 2) c₂.val _).trans
              (congrArg (c₂.val • ·)
                ((DFunLike.congr_fun (hp_comp ℓ₂ ((B_fU.obj V₂_et).hom ≫ p_YU) ℓ 2) α₀).symm.trans
                  (congrArg (fun m => p_std m ℓ 2 α₀) hℓ₂_comp))))))
    have htor_u : ℓ • p_std (ι_u ≫ p_YU) ℓ 2 α₀ = 0 :=
      (map_nsmul (p_std (ι_u ≫ p_YU) ℓ 2) ℓ α₀).symm.trans
        ((congrArg (p_std (ι_u ≫ p_YU) ℓ 2) hα₀_tor).trans (map_zero _))
    have hnz_u : p_std (ι_u ≫ p_YU) ℓ 2 α₀ ≠ 0 :=
      hα₀_nz Ω_u (gu ≫ g_U) Y_u (ι_u ≫ p_YU) q_u hPb_tot _ (hp_std _ ℓ 2)
    have hsub_u : (c₁ - c₂).val • p_std (ι_u ≫ p_YU) ℓ 2 α₀ = 0 :=
      (hSubValSmul htor_u c₁ c₂).trans (sub_eq_zero.mpr (hp₁.symm.trans hp₂))
    exact sub_eq_zero.mp (hZModSmulZero htor_u hnz_u hsub_u)

  obtain ⟨u₀⟩ := (inferInstance : Nonempty ↥U)
  obtain ⟨c, hu₀_c⟩ := hO_cov u₀
  have hO_closed : IsClosed (O c) := by
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro u hu_not
    obtain ⟨c', hu_c'⟩ := hO_cov u
    refine ⟨O c', ?_, hO_open c', hu_c'⟩
    intro z hz_c' hz_c
    have hcc : c' = c := hO_disj hz_c' hz_c
    exact hu_not (hcc ▸ hu_c')
  have hO_univ : O c = Set.univ :=
    IsClopen.eq_univ ⟨hO_closed, hO_open c⟩ ⟨u₀, hu₀_c⟩

  
  refine ⟨c, fun Ω _ _ s_Ω Y_Ω ι_Ω f_Ω hPb_Ω p_Ω p_α hp_Ω hp_α => ?_⟩
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  have _ : Unique ↥S_Ω := PrimeSpectrum.instUnique
  let pt_Ω : ↥S_Ω := default
  have hs_mem : s_Ω.base pt_Ω ∈ O c := by
    rw [hO_univ]
    trivial
  rcases hs_mem with ⟨V, _, _, ⟨y, hy⟩, heq_V⟩
  have _ : AlgebraicGeometry.Etale V.hom := V.prop
  let P_Ω := CategoryTheory.Limits.pullback V.hom s_Ω
  let pr_V := CategoryTheory.Limits.pullback.fst V.hom s_Ω
  let pr_Ω := CategoryTheory.Limits.pullback.snd V.hom s_Ω
  have hpr_Ω_surj : Function.Surjective pr_Ω.base := by
    intro z_Ω
    have hz_Ω : z_Ω = pt_Ω := Subsingleton.elim z_Ω pt_Ω
    have heq_pt : V.hom.base y = s_Ω.base z_Ω := hz_Ω ▸ hy
    obtain ⟨z₀, _, hz₀⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y z_Ω heq_pt
    exact ⟨z₀, hz₀⟩
  obtain ⟨σ_Ω, hσ_Ω⟩ := hSplit Ω P_Ω pr_Ω inferInstance hpr_Ω_surj
  let s_tilde : S_Ω ⟶ V.left := σ_Ω ≫ pr_V
  have hs_tilde_comp : s_tilde ≫ V.hom = s_Ω := by
    calc
      s_tilde ≫ V.hom
        = σ_Ω ≫ (pr_V ≫ V.hom) := CategoryTheory.Category.assoc _ _ _
      _ = σ_Ω ≫ (pr_Ω ≫ s_Ω) := congrArg (σ_Ω ≫ ·) CategoryTheory.Limits.pullback.condition
      _ = (σ_Ω ≫ pr_Ω) ≫ s_Ω := (CategoryTheory.Category.assoc _ _ _).symm
      _ = 𝟙 S_Ω ≫ s_Ω := congrArg (· ≫ s_Ω) hσ_Ω
      _ = s_Ω := CategoryTheory.Category.id_comp s_Ω
  have hcomm_Ω : (f_Ω ≫ s_tilde) ≫ V.hom = ι_Ω ≫ f_U :=
    (CategoryTheory.Category.assoc f_Ω s_tilde V.hom).trans
      ((congrArg (f_Ω ≫ ·) hs_tilde_comp).trans hPb_Ω.w.symm)
  let ℓ_Ω : Y_Ω ⟶ (B_fU.obj V).left :=
    CategoryTheory.Limits.pullback.lift (f_Ω ≫ s_tilde) ι_Ω hcomm_Ω
  have hℓ_Ω_snd : ℓ_Ω ≫ (B_fU.obj V).hom = ι_Ω :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hℓ_Ω_comp : ℓ_Ω ≫ ((B_fU.obj V).hom ≫ p_YU) = ι_Ω ≫ p_YU :=
    (CategoryTheory.Category.assoc ℓ_Ω (B_fU.obj V).hom p_YU).symm.trans
      (congrArg (· ≫ p_YU) hℓ_Ω_snd)
  rw [hp_uniq hp_Ω, hp_uniq hp_α]
  exact (congrArg (fun m => p_std m ℓ 2 β) hℓ_Ω_snd.symm).trans
    ((DFunLike.congr_fun (hp_comp ℓ_Ω (B_fU.obj V).hom ℓ 2) β).trans
      ((congrArg (p_std ℓ_Ω ℓ 2) heq_V).trans
        ((map_nsmul (p_std ℓ_Ω ℓ 2) c.val _).trans
          (congrArg (c.val • ·)
            ((DFunLike.congr_fun (hp_comp ℓ_Ω ((B_fU.obj V).hom ≫ p_YU) ℓ 2) α₀).symm.trans
              (congrArg (fun m => p_std m ℓ 2 α₀) hℓ_Ω_comp))))))

theorem weil_etale_proper_pointed_h1_tuple_etale_lift (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (U_base : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine U_base] [AlgebraicGeometry.IsIntegral U_base]
    (p_U : Quiver.Hom U_base (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType p_U]
    (u_U : Quiver.Hom U_base (weilAffineSpaceOver k δ).left)
    [AlgebraicGeometry.Etale u_U]
    (u_pt : ↥U_base) (hu_pt : IsClosed ({u_pt} : Set ↥U_base))
    (s_pt : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U_base)
    (hs_pt_sec : CategoryTheory.CategoryStruct.comp s_pt p_U =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_pt_range : Set.range s_pt.base = {u_pt})
    (Y_base : AlgebraicGeometry.Scheme.{u})
    (f_base : Quiver.Hom Y_base U_base)
    [AlgebraicGeometry.IsProper f_base]
    (C_pt : AlgebraicGeometry.Scheme.{u})
    (ι_pt : Quiver.Hom C_pt Y_base)
    (q_pt : Quiver.Hom C_pt (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hPb_pt : CategoryTheory.IsPullback ι_pt q_pt f_base s_pt)
    (b : ℕ)
    (e_0 : Fin b → weilEtaleTorsionH C_pt ℓ 1) :
    ∃ (U_pt : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsAffine U_pt)
      (_ : AlgebraicGeometry.IsIntegral U_pt)
      (h_pt : Quiver.Hom U_pt U_base)
      (u'_pt : ↥U_pt)
      (s'_pt : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U_pt)
      (Y_pt : AlgebraicGeometry.Scheme.{u})
      (p_Ypt : Quiver.Hom Y_pt Y_base)
      (f_pt : Quiver.Hom Y_pt U_pt)
      (ι'_pt : Quiver.Hom C_pt Y_pt)
      (s_tor : Fin b → weilEtaleTorsionH Y_pt ℓ 1),
      AlgebraicGeometry.Etale h_pt ∧
      IsClosed ({u'_pt} : Set ↥U_pt) ∧
      h_pt.base u'_pt = u_pt ∧
      CategoryTheory.CategoryStruct.comp s'_pt h_pt = s_pt ∧
      Set.range s'_pt.base = {u'_pt} ∧
      CategoryTheory.IsPullback p_Ypt f_pt f_base h_pt ∧
      CategoryTheory.CategoryStruct.comp ι'_pt p_Ypt = ι_pt ∧
      CategoryTheory.IsPullback ι'_pt q_pt f_pt s'_pt ∧
      (∀ (i : Fin b)
          (p'_pt : weilEtaleTorsionH Y_pt ℓ 1 →+ weilEtaleTorsionH C_pt ℓ 1),
        WeilIsTorsionEtalePullback ι'_pt ℓ 1 p'_pt →
        p'_pt (s_tor i) = e_0 i) :=
by
  
  have h_plain_map_id_fst :
      ∀ {W Z₁ Z₃ : AlgebraicGeometry.Scheme.{u}} (u_hom : W ⟶ Z₃) (fg : Z₁ ⟶ Z₃),
        CategoryTheory.Limits.pullback.map u_hom fg u_hom fg
          (𝟙 W) (𝟙 Z₁) (𝟙 Z₃)
          ((Category.id_comp u_hom).trans (Category.comp_id u_hom).symm)
          ((Category.id_comp fg).trans (Category.comp_id fg).symm) ≫
        CategoryTheory.Limits.pullback.fst u_hom fg =
        CategoryTheory.Limits.pullback.fst u_hom fg := by
    intro W Z₁ Z₃ u_hom fg
    simp

  have h_plain_leftPullback_inv_fst :
      ∀ {W Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u}}
        (u_hom : W ⟶ Z₃) (g : Z₂ ⟶ Z₃) (f : Z₁ ⟶ Z₂),
        ((CategoryTheory.Limits.pullbackLeftPullbackSndIso u_hom g f).inv ≫
          CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd u_hom g) f) ≫
          CategoryTheory.Limits.pullback.fst u_hom g =
        CategoryTheory.Limits.pullback.fst u_hom (f ≫ g) := by
    intro W Z₁ Z₂ Z₃ u_hom g f
    simp

  have h_plain_leftPullback_hom_fst :
      ∀ {W Z₁ Z₂ Z₃ : AlgebraicGeometry.Scheme.{u}}
        (u_hom : W ⟶ Z₃) (g : Z₂ ⟶ Z₃) (f : Z₁ ⟶ Z₂),
        (CategoryTheory.Limits.pullbackLeftPullbackSndIso u_hom g f).hom ≫
          CategoryTheory.Limits.pullback.fst u_hom (f ≫ g) =
        CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.snd u_hom g) f ≫
          CategoryTheory.Limits.pullback.fst u_hom g := by
    intro W Z₁ Z₂ Z₃ u_hom g f
    simp

