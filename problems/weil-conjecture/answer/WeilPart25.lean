          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    let z₀ : ↥Z_S := Classical.choice hConn.toNonempty
    let w₀₀ : ↥W_T₀ := e_hom.base z₀
    have hPre₀ : PreconnectedSpace ↥W_T₀ := by
      rw [preconnectedSpace_iff_univ]
      have huniv : (Set.univ : Set ↥W_T₀) = e_hom.base '' Set.univ := by
        ext w
        simp only [Set.mem_univ, Set.mem_image, true_and, true_iff]
        refine ⟨e_inv.base w, ?_⟩
        change (CategoryTheory.CategoryStruct.comp e_inv e_hom).base w = w
        rw [he_inv_hom]
        rfl
      rw [huniv]
      exact isPreconnected_univ.image e_hom.base e_hom.continuous.continuousOn
    have hPre : PreconnectedSpace ↥(W_obj ν_S T_S) := hPre₀
    haveI : PreconnectedSpace ↥(W_obj ν_S T_S) := hPre
    let w₀ : ↥(W_obj ν_S T_S) := w₀₀
    refine ⟨?_, ?_⟩
    · intro f₀ hf₀
      let f₀_lc : LocallyConstant ↥(W_obj ν_S T_S) (ULift.{u} (ZMod ℓ)) := f₀
      have hw₀_eq : f₀_lc ((ρ_lift ν_S ρ_S hρ_over T_S 1).base w₀) - f₀_lc w₀ =
          ULift.up (1 : ZMod ℓ) :=
        congrArg (fun q : ↥(Q_sub ν_S ρ_S hρ_over T_S) => q.1 w₀) hf₀
      rw [LocallyConstant.apply_eq_of_preconnectedSpace f₀_lc
        ((ρ_lift ν_S ρ_S hρ_over T_S 1).base w₀) w₀, sub_self] at hw₀_eq
      exact zero_ne_one (congrArg ULift.down hw₀_eq)
    · intro q₀
      let one_Q_sub : ↥(Q_sub ν_S ρ_S hρ_over T_S) := one_Q
      let q₀_sub : ↥(Q_sub ν_S ρ_S hρ_over T_S) := q₀
      have hnsmul_one : ∀ (n : ℕ) (w : ↥(W_obj ν_S T_S)),
          ((n • one_Q_sub).1) w = ULift.up (n • (1 : ZMod ℓ)) := by
        intro n
        induction n with
        | zero =>
          intro w
          rfl
        | succ n ih =>
          intro w
          rw [succ_nsmul, AddSubgroup.coe_add, LocallyConstant.add_apply, ih w]
          change ULift.up (n • (1 : ZMod ℓ)) + ULift.up (1 : ZMod ℓ) =
            ULift.up ((n + 1) • (1 : ZMod ℓ))
          rw [succ_nsmul]
          rfl
      let c : ZMod ℓ := (q₀_sub.1 w₀).down
      refine ⟨c, Subtype.ext (LocallyConstant.ext fun w => ?_)⟩
      change (q₀_sub.1) w = ((c.val • one_Q_sub).1) w
      rw [hnsmul_one c.val w, LocallyConstant.apply_eq_of_preconnectedSpace q₀_sub.1 w w₀]
      apply ULift.ext
      change c = c.val • (1 : ZMod ℓ)
      rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]

theorem weil_cyclic_etale_torsor_jordan_ext_and_connected_kernel (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Y Z : AlgebraicGeometry.Scheme.{u})
    (ν : Quiver.Hom Z Y)
    [AlgebraicGeometry.Etale ν]
    [AlgebraicGeometry.Surjective ν]
    (ρ : ZMod ℓ → Quiver.Hom Z Z)
    (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ a) ν = ν)
    (hρ_act : ρ 0 = CategoryTheory.CategoryStruct.id Z ∧
      ∀ a b : ZMod ℓ, ρ (a + b) = CategoryTheory.CategoryStruct.comp (ρ a) (ρ b))
    (hρ_part :
      let δ : ZMod ℓ → Quiver.Hom Z (CategoryTheory.Limits.pullback ν ν) :=
        fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z) (ρ a)
          ((CategoryTheory.Category.id_comp ν).trans (hρ_over a).symm)
      (_root_.Pairwise fun a b : ZMod ℓ =>
        Disjoint (Set.range (δ a).base) (Set.range (δ b).base)) ∧
      (⋃ a : ZMod ℓ, Set.range (δ a).base) = Set.univ) :
    ∃ γ : weilEtaleTorsionH Y ℓ 1,
      ∀ (X : AlgebraicGeometry.Scheme.{u}) (h : Quiver.Hom X Y),
        ConnectedSpace ↥(CategoryTheory.Limits.pullback ν h) →
        ∀ (p_h : weilEtaleTorsionH Y ℓ 1 →+ weilEtaleTorsionH X ℓ 1),
          WeilIsTorsionEtalePullback h ℓ 1 p_h →
          p_h γ ≠ 0 ∧
          ∀ (p_ν : weilEtaleTorsionH X ℓ 1 →+
              weilEtaleTorsionH (CategoryTheory.Limits.pullback ν h) ℓ 1),
            WeilIsTorsionEtalePullback (CategoryTheory.Limits.pullback.snd ν h) ℓ 1 p_ν →
            p_ν (p_h γ) = 0 ∧
            ∀ w : weilEtaleTorsionH X ℓ 1,
              p_ν w = 0 →
              ∃ c : ZMod ℓ, w = c.val • (p_h γ) :=
by
  classical
  obtain ⟨hc_all, hr_all, hExact_all⟩ :=
    weil_etale_site_pullback_rightAdjoint_and_exact_package.{u}
  obtain ⟨hTorsorBC, hTorsorSheets⟩ :=
    weil_cyclic_etale_torsor_pullback_and_sheet_partition.{u} ℓ
  obtain ⟨hSh, e_loc, hTerm_loc, hPull_loc⟩ :=
    weil_etale_locConst_sheaf_iso_and_pullback_compat.{u} ℓ (@hc_all) (@hr_all)
  obtain ⟨Q_of, τ_of, δ_L_of, h0_of, hSE_of, hBC_of, hSplit_of, hConn_of⟩ :=
    weil_cyclic_locConst_zero_trace_short_exact_and_rigidity.{u} ℓ (@hc_all) (@hr_all) hSh

  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let σ_mod : Quiver.Hom Aℤ AM :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod ℓ)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  let Fℤ_of : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun S => (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj Aℤ
  let one_of : ∀ S : AlgebraicGeometry.Scheme.{u},
      Quiver.Hom (Fℤ_of S) (weilEtaleTorsionSheaf S ℓ) :=
    fun S => (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map σ_mod
  let L_of : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun S => ⟨weilAltLocConstPresheaf S ℓ, hSh S⟩
  let P_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S),
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun {S Z_S} ν_S =>
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback ν_S)
        AddCommGrpCat.{u} _ S.smallEtaleTopology Z_S.smallEtaleTopology (hc_all ν_S)).obj
        (L_of Z_S)
  let Δ_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S),
      Quiver.Hom (L_of S) (P_of ν_S) :=
    fun ν_S => { hom := weilAltLocConstPullbackNat ν_S ℓ }

  let δ_const_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_S_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (hρ_S_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
        ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
      Quiver.Hom (Fℤ_of S) (Q_of ν_S ρ_S hρ_S_over hρ_S_act) :=
    fun {S _} ν_S ρ_S hρ_S_over hρ_S_act =>
      CategoryTheory.CategoryStruct.comp (one_of S)
        (CategoryTheory.CategoryStruct.comp (e_loc S).hom
          (δ_L_of ν_S ρ_S hρ_S_over hρ_S_act))

  let γ_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_S_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (hρ_S_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
        ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
      (CategoryTheory.ShortComplex.mk (Δ_of ν_S) (τ_of ν_S ρ_S hρ_S_over hρ_S_act)
        (h0_of ν_S ρ_S hρ_S_over hρ_S_act)).ShortExact →
      weilEtaleTorsionH S ℓ 1 :=
    fun {S _} ν_S ρ_S hρ_S_over hρ_S_act hSE =>
      ((CategoryTheory.Abelian.Ext.mk₀ (δ_const_of ν_S ρ_S hρ_S_over hρ_S_act)).comp
        hSE.extClass (Nat.zero_add 1)).comp
        (CategoryTheory.Abelian.Ext.mk₀ (e_loc S).inv) (Nat.add_zero 1)

  have hmk₀_nsmul :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        {A B : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (n : ℕ) (f : Quiver.Hom A B),
        CategoryTheory.Abelian.Ext.mk₀ (n • f) = n • CategoryTheory.Abelian.Ext.mk₀ f := by
    intro S A B n f
    rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, map_nsmul]

  have hnsmul_comp_ext :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        {A B D : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        {a b c : ℕ} (hab : a + b = c) (n : ℕ)
        (x : CategoryTheory.Abelian.Ext A B a) (y : CategoryTheory.Abelian.Ext B D b),
        (n • x).comp y hab = n • (x.comp y hab) := by
    intro S A B D a b c hab n x y
    let hom_left : CategoryTheory.Abelian.Ext A B a →+ CategoryTheory.Abelian.Ext A D c :=
      AddMonoidHom.mk' (fun u => u.comp y hab)
        (fun u₁ u₂ => CategoryTheory.Abelian.Ext.add_comp u₁ u₂ y hab)
    exact map_nsmul hom_left n x

  have hAℤ_ext :
      ∀ {M : AddCommGrpCat.{u}} (u₁ u₂ : Quiver.Hom Aℤ M),
        u₁.hom (ULift.up (1 : ℤ)) = u₂.hom (ULift.up (1 : ℤ)) → u₁ = u₂ := by
    intro M u₁ u₂ h1
    apply AddCommGrpCat.ext
    intro z
    have hz : z = z.down • ULift.up (1 : ℤ) := by
      cases z
      apply ULift.ext
      simp
    rw [hz, map_zsmul, map_zsmul, h1]

  have hFℤ_hom_eq :
      ∀ (S : AlgebraicGeometry.Scheme.{u})
        {G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (φ₁ φ₂ : Quiver.Hom (Fℤ_of S) G),
        let T_S := weilEtaleIdTerminal.{u} S
        let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u}
          (weilEtaleIdTerminalIsTerminal.{u} S)
        (CategoryTheory.CategoryStruct.comp (adj_S.unit.app Aℤ)
            (φ₁.hom.app (Opposite.op T_S))).hom (ULift.up (1 : ℤ)) =
          (CategoryTheory.CategoryStruct.comp (adj_S.unit.app Aℤ)
            (φ₂.hom.app (Opposite.op T_S))).hom (ULift.up (1 : ℤ)) →
        φ₁ = φ₂ := by
    intro S G φ₁ φ₂ T_S adj_S hev
    apply (adj_S.homEquiv Aℤ G).injective
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit]
    exact hAℤ_ext _ _ hev

  have hδ_const_eval :
      ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
        (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
        (hρ_S_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
        (hρ_S_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
          ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
        let T_S := weilEtaleIdTerminal.{u} S
        let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u}
          (weilEtaleIdTerminalIsTerminal.{u} S)
        (CategoryTheory.CategoryStruct.comp (adj_S.unit.app Aℤ)
          ((δ_const_of ν_S ρ_S hρ_S_over hρ_S_act).hom.app (Opposite.op T_S))).hom
          (ULift.up (1 : ℤ)) =
        ((δ_L_of ν_S ρ_S hρ_S_over hρ_S_act).hom.app (Opposite.op T_S)).hom
          ((weilAltLocConstConstHom S T_S ℓ).hom (ULift.up (1 : ZMod ℓ))) := by
    intro S Z_S ν_S ρ_S hρ_S_over hρ_S_act T_S adj_S
    have h_unit_nat :
        CategoryTheory.CategoryStruct.comp (adj_S.unit.app Aℤ)
          ((one_of S).hom.app (Opposite.op T_S)) =
        CategoryTheory.CategoryStruct.comp σ_mod (adj_S.unit.app AM) :=
      (adj_S.unit.naturality σ_mod).symm
    have h_mor :
        CategoryTheory.CategoryStruct.comp (adj_S.unit.app Aℤ)
          ((δ_const_of ν_S ρ_S hρ_S_over hρ_S_act).hom.app (Opposite.op T_S)) =
        CategoryTheory.CategoryStruct.comp σ_mod
          (CategoryTheory.CategoryStruct.comp (weilAltLocConstConstHom S T_S ℓ)
            ((δ_L_of ν_S ρ_S hρ_S_over hρ_S_act).hom.app (Opposite.op T_S))) := by
      dsimp [δ_const_of]
      change adj_S.unit.app Aℤ ≫
          ((one_of S).hom.app (Opposite.op T_S) ≫
            ((e_loc S).hom.hom.app (Opposite.op T_S) ≫
              (δ_L_of ν_S ρ_S hρ_S_over hρ_S_act).hom.app (Opposite.op T_S))) = _
      rw [← CategoryTheory.Category.assoc (adj_S.unit.app Aℤ), h_unit_nat,
        CategoryTheory.Category.assoc σ_mod, ← CategoryTheory.Category.assoc (adj_S.unit.app AM),
        hTerm_loc S]
    rw [h_mor]
    change ((δ_L_of ν_S ρ_S hρ_S_over hρ_S_act).hom.app (Opposite.op T_S)).hom
      ((weilAltLocConstConstHom S T_S ℓ).hom (σ_mod.hom (ULift.up (1 : ℤ)))) = _
    have hσ1 : σ_mod.hom (ULift.up (1 : ℤ)) = ULift.up (1 : ZMod ℓ) :=
      congrArg ULift.up Int.cast_one
    rw [hσ1]

  have hOnePull :
      ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom S₁ S₂)
        {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        letI : (weilEtaleSitePullback g).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
          hc_all g
        letI : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint := hr_all g
        let B := weilEtaleSitePullback g
        let pb_g := B.sheafPullback AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
        let πℤ := weilEtaleConstPullbackHom g hT₁ hT₂ Aℤ
        let πM := weilEtaleConstPullbackHom g hT₁ hT₂ AM
        CategoryTheory.CategoryStruct.comp (pb_g.map (one_of S₂)) πM =
          CategoryTheory.CategoryStruct.comp πℤ (one_of S₁) := by
    intro S₁ S₂ g T₁ hT₁ T₂ hT₂
    haveI : (weilEtaleSitePullback g).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
      hc_all g
    haveI : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint := hr_all g
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let B := weilEtaleSitePullback g
    let pf_g := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let pb_g := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_g := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let τ : Quiver.Hom (B.obj T₂) T₁ := hT₁.from (B.obj T₂)
    apply (adj_g.homEquiv (Fℤ_of S₂) (weilEtaleTorsionSheaf S₁ ℓ)).injective
    rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
      CategoryTheory.Adjunction.homEquiv_naturality_right]
    dsimp [weilEtaleConstPullbackHom]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    apply (adj₂.homEquiv Aℤ (pf_g.obj (weilEtaleTorsionSheaf S₁ ℓ))).injective
    rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
      CategoryTheory.Adjunction.homEquiv_naturality_right]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    change σ_mod ≫ (adj₁.unit.app AM ≫ (weilEtaleTorsionSheaf S₁ ℓ).obj.map τ.op) =
      (adj₁.unit.app Aℤ ≫ (Fℤ_of S₁).obj.map τ.op) ≫
        (one_of S₁).hom.app (Opposite.op (B.obj T₂))
    have h_nat_σ :
        CategoryTheory.CategoryStruct.comp (adj₁.unit.app Aℤ)
          ((one_of S₁).hom.app (Opposite.op T₁)) =
        CategoryTheory.CategoryStruct.comp σ_mod (adj₁.unit.app AM) :=
      (adj₁.unit.naturality σ_mod).symm
    rw [CategoryTheory.Category.assoc (adj₁.unit.app Aℤ),
      ((one_of S₁).hom.naturality τ.op),
      ← CategoryTheory.Category.assoc (adj₁.unit.app Aℤ),
      h_nat_σ, CategoryTheory.Category.assoc]

  have hγ_pull :
      ∀ {S₁ Z₁ S₂ Z₂ : AlgebraicGeometry.Scheme.{u}}
        (ν₁ : Quiver.Hom Z₁ S₁) (ρ₁ : ZMod ℓ → Quiver.Hom Z₁ Z₁)
        (hρ₁_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ₁ a) ν₁ = ν₁)
        (hρ₁_act : ρ₁ 0 = CategoryTheory.CategoryStruct.id Z₁ ∧
          ∀ a b : ZMod ℓ, ρ₁ (a + b) = CategoryTheory.CategoryStruct.comp (ρ₁ a) (ρ₁ b))
        (hSE₁ : (CategoryTheory.ShortComplex.mk (Δ_of ν₁) (τ_of ν₁ ρ₁ hρ₁_over hρ₁_act)
          (h0_of ν₁ ρ₁ hρ₁_over hρ₁_act)).ShortExact)
        (ν₂ : Quiver.Hom Z₂ S₂) (ρ₂ : ZMod ℓ → Quiver.Hom Z₂ Z₂)
        (hρ₂_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ₂ a) ν₂ = ν₂)
        (hρ₂_act : ρ₂ 0 = CategoryTheory.CategoryStruct.id Z₂ ∧
          ∀ a b : ZMod ℓ, ρ₂ (a + b) = CategoryTheory.CategoryStruct.comp (ρ₂ a) (ρ₂ b))
        (hSE₂ : (CategoryTheory.ShortComplex.mk (Δ_of ν₂) (τ_of ν₂ ρ₂ hρ₂_over hρ₂_act)
          (h0_of ν₂ ρ₂ hρ₂_over hρ₂_act)).ShortExact)
        (g : Quiver.Hom S₁ S₂) (p_Z : Quiver.Hom Z₁ Z₂),
        CategoryTheory.CategoryStruct.comp p_Z ν₂ = CategoryTheory.CategoryStruct.comp ν₁ g →
        (∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ₁ a) p_Z =
          CategoryTheory.CategoryStruct.comp p_Z (ρ₂ a)) →
        ∀ (p_g : weilEtaleTorsionH S₂ ℓ 1 →+ weilEtaleTorsionH S₁ ℓ 1),
          WeilIsTorsionEtalePullback g ℓ 1 p_g →
          p_g (γ_of ν₂ ρ₂ hρ₂_over hρ₂_act hSE₂) = γ_of ν₁ ρ₁ hρ₁_over hρ₁_act hSE₁ := by
    intro S₁ Z₁ S₂ Z₂ ν₁ ρ₁ hρ₁_over hρ₁_act hSE₁ ν₂ ρ₂ hρ₂_over hρ₂_act hSE₂
      g p_Z hg_comm hg_equiv p_g hp_g
    rcases hp_g with ⟨hCont_g, hAdj_g, hAdd_g, hLim_g, hColim_g,
      T₁, hT₁, T₂, hT₂, ιℤ, hιπℤ, _, hp_g_eq⟩
    cases Subsingleton.elim hCont_g (hc_all g)
    cases Subsingleton.elim hAdj_g (hr_all g)
    haveI : (weilEtaleSitePullback g).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
      hc_all g
    haveI : ((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint := hr_all g
    let B := weilEtaleSitePullback g
    let pb_g := B.sheafPullback AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
    let adj_g := B.sheafAdjunctionContinuous AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
    haveI : pb_g.Additive := hAdd_g
    haveI : CategoryTheory.Limits.PreservesFiniteLimits pb_g := hLim_g
    haveI : CategoryTheory.Limits.PreservesFiniteColimits pb_g := hColim_g
    let πℤ := weilEtaleConstPullbackHom g hT₁ hT₂ Aℤ
    let πM := weilEtaleConstPullbackHom g hT₁ hT₂ AM
    let β_L : Quiver.Hom (pb_g.obj (L_of S₂)) (L_of S₁) :=
      (adj_g.homEquiv (L_of S₂) (L_of S₁)).symm { hom := weilAltLocConstPullbackNat g ℓ }
    obtain ⟨β_P, β_Q, hcomm_Δ, hcomm_τ, hcomm_δ⟩ :=
      hBC_of ν₁ ρ₁ hρ₁_over hρ₁_act ν₂ ρ₂ hρ₂_over hρ₂_act g p_Z hg_comm hg_equiv
    have hPull_e_hom :
