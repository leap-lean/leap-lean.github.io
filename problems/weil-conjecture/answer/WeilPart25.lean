        let γ₂ : Cℤ_2.obj A ⟶ U_std_2.obj oneR_2 :=
          (adjℤ_std_2.homEquiv A (U_std_2.obj oneR_2)).symm (f₀ ≫ u_unit_std_2)
        π_A_std A ≫ γ₁ = P_pull_ℤ.map γ₂ ≫ u_πR := by
    intro A f₀ γ₁ γ₂
    apply (adj_pull_ℤ.homEquiv (Cℤ_2.obj A) (U_std_1.obj oneR_1)).injective
    apply (adjℤ_std_2.homEquiv A (P_push_ℤ.obj (U_std_1.obj oneR_1))).injective
    
    rw [adj_pull_ℤ.homEquiv_naturality_right]
    dsimp [π_A_std]
    rw [Equiv.apply_symm_apply, adjℤ_std_2.homEquiv_naturality_right, Equiv.apply_symm_apply]
    let u_A1 : A ⟶ (Cℤ_1.obj A).obj.obj (Opposite.op T_std_1) := adjℤ_std_1.unit.app A
    change (u_A1 ≫ (Cℤ_1.obj A).obj.map τ_std.op) ≫ γ₁.hom.app (Opposite.op (B.obj T_std_2)) =
      (adjℤ_std_2.homEquiv A (P_push_ℤ.obj (U_std_1.obj oneR_1)))
        ((adj_pull_ℤ.homEquiv (Cℤ_2.obj A) (U_std_1.obj oneR_1))
          (P_pull_ℤ.map γ₂ ≫ u_πR))
    have hnat_γ₁ : (Cℤ_1.obj A).obj.map τ_std.op ≫ γ₁.hom.app (Opposite.op (B.obj T_std_2)) =
        γ₁.hom.app (Opposite.op T_std_1) ≫ (U_std_1.obj oneR_1).obj.map τ_std.op :=
      γ₁.hom.naturality τ_std.op
    rw [CategoryTheory.Category.assoc, hnat_γ₁, ← CategoryTheory.Category.assoc]
    have hγ₁_eval : u_A1 ≫ γ₁.hom.app (Opposite.op T_std_1) =
        f₀ ≫ u_unit_std_1 := by
      have h1 := Equiv.apply_symm_apply (adjℤ_std_1.homEquiv A (U_std_1.obj oneR_1))
        (f₀ ≫ u_unit_std_1)
      rwa [CategoryTheory.Adjunction.homEquiv_unit] at h1
    rw [hγ₁_eval, CategoryTheory.Category.assoc]
    
    rw [adj_pull_ℤ.homEquiv_naturality_left]
    let q_R : oneR_2 ⟶ P_push_R.obj oneR_1 :=
      (adjR_std_2.homEquiv M_R (P_push_R.obj oneR_1)).symm
        (adjR_std_1.unit.app M_R ≫ oneR_1.obj.map τ_std.op)
    let u_qR : U_std_2.obj oneR_2 ⟶ P_push_ℤ.obj (U_std_1.obj oneR_1) := U_std_2.map q_R
    have hπR_mate : (adj_pull_ℤ.homEquiv (U_std_2.obj oneR_2) (U_std_1.obj oneR_1)) u_πR =
        u_qR := by
      have hq : (adj_pull_R.homEquiv oneR_2 oneR_1) π_R = q_R :=
        Equiv.apply_symm_apply (adj_pull_R.homEquiv oneR_2 oneR_1) q_R
      have hm := (uStdFF_2.map_preimage (X := oneR_2) (Y := P_push_R.obj oneR_1)
        ((adj_pull_ℤ.homEquiv (U_std_2.obj oneR_2) (U_std_1.obj oneR_1)) u_πR)).symm
      change (adj_pull_ℤ.homEquiv (U_std_2.obj oneR_2) (U_std_1.obj oneR_1)) u_πR =
        U_std_2.map ((adj_pull_R.homEquiv oneR_2 oneR_1) π_R) at hm
      rw [hq] at hm
      exact hm
    rw [hπR_mate, adjℤ_std_2.homEquiv_naturality_right]
    have hγ₂_eval : (adjℤ_std_2.homEquiv A (U_std_2.obj oneR_2)) γ₂ = f₀ ≫ u_unit_std_2 :=
      Equiv.apply_symm_apply (adjℤ_std_2.homEquiv A (U_std_2.obj oneR_2)) (f₀ ≫ u_unit_std_2)
    rw [hγ₂_eval, CategoryTheory.Category.assoc]
    congr 1
    dsimp [u_unit_std_1, u_unit_std_2]
    change FgtMod.map (adjR_std_1.unit.app M_R) ≫ FgtMod.map (oneR_1.obj.map τ_std.op) =
      FgtMod.map (adjR_std_2.unit.app M_R) ≫ FgtMod.map (q_R.hom.app (Opposite.op T_std_2))
    rw [← FgtMod.map_comp, ← FgtMod.map_comp]
    congr 1
    have hq_eval := Equiv.apply_symm_apply (adjR_std_2.homEquiv M_R (P_push_R.obj oneR_1))
      (adjR_std_1.unit.app M_R ≫ oneR_1.obj.map τ_std.op)
    rw [CategoryTheory.Adjunction.homEquiv_unit] at hq_eval
    exact hq_eval.symm

  have hSq_ηℤ : ιℤ_0 ≫ P_pull_ℤ.map ηℤ_2 = ηℤ_1 ≫ U_std_1.map ι_R := by
    change ιℤ_0 ≫ P_pull_ℤ.map ηℤ_2 = ηℤ_1 ≫ u_ιR
    have hmℤ : πℤ_std ≫ ηℤ_1 = P_pull_ℤ.map ηℤ_2 ≫ u_πR := hMateSquare Aℤ ιℤ_coeff
    calc
      ιℤ_0 ≫ P_pull_ℤ.map ηℤ_2
        = ιℤ_0 ≫ P_pull_ℤ.map ηℤ_2 ≫ 𝟙 (P_pull_ℤ.obj (U_std_2.obj oneR_2)) := by
            rw [CategoryTheory.Category.comp_id]
      _ = ιℤ_0 ≫ P_pull_ℤ.map ηℤ_2 ≫ (u_πR ≫ u_ιR) := by rw [hu_πι]
      _ = ιℤ_0 ≫ (P_pull_ℤ.map ηℤ_2 ≫ u_πR) ≫ u_ιR := by
            simp only [CategoryTheory.Category.assoc]
      _ = (ιℤ_0 ≫ πℤ_std) ≫ ηℤ_1 ≫ u_ιR := by
            rw [← hmℤ]; simp only [CategoryTheory.Category.assoc]
      _ = ηℤ_1 ≫ u_ιR := by
            rw [hιπ_std, CategoryTheory.Category.id_comp]

  have hSq_βM : P_pull_ℤ.map βM_2 ≫ πM_std = U_std_1.map π_R ≫ βM_1 := by
    change P_pull_ℤ.map βM_std_2 ≫ πM_std = u_πR ≫ βM_std_1
    have hmM : πM_std ≫ αM_1 = P_pull_ℤ.map αM_2 ≫ u_πR := hMateSquare AM ιM_coeff
    have hαβ_std_1 : αM_1 ≫ βM_std_1 = 𝟙 FM_1 := hαβ_1
    have hβα_std_2 : βM_std_2 ≫ αM_2 = 𝟙 (U_std_2.obj oneR_2) := hβα_2
    calc
      P_pull_ℤ.map βM_std_2 ≫ πM_std
        = P_pull_ℤ.map βM_std_2 ≫ πM_std ≫ 𝟙 FM_1 := by
            rw [CategoryTheory.Category.comp_id]
      _ = P_pull_ℤ.map βM_std_2 ≫ (πM_std ≫ αM_1) ≫ βM_std_1 := by
            rw [CategoryTheory.Category.assoc πM_std αM_1 βM_std_1, hαβ_std_1]
      _ = (P_pull_ℤ.map βM_std_2 ≫ P_pull_ℤ.map αM_2) ≫ u_πR ≫ βM_std_1 := by
            rw [hmM]; simp only [CategoryTheory.Category.assoc]
      _ = u_πR ≫ βM_std_1 := by
            rw [← P_pull_ℤ.map_comp, hβα_std_2, P_pull_ℤ.map_id, CategoryTheory.Category.id_comp]

  
  let p_R : ∀ k : ℕ, weilCupPDModH S₂ m k → weilCupPDModH S₁ m k := fun k x =>
    ((CategoryTheory.Abelian.Ext.mk₀ ι_R).comp
      (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_R x) (Nat.zero_add k)).comp
      (CategoryTheory.Abelian.Ext.mk₀ π_R) (Nat.add_zero k)

  have hPullModComm :
      ∀ (k : ℕ) (x : weilCupPDModH S₂ m k),
        p_std k (θ_std_2 k x) = θ_std_1 k (p_R k x) := by
    intro k x
    let x' : CategoryTheory.Abelian.Ext.{u} oneR_2 oneR_2 k := x
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_0).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_ℤ
          (((CategoryTheory.Abelian.Ext.mk₀ ηℤ_2).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_2 x') (Nat.zero_add k)).comp
            (CategoryTheory.Abelian.Ext.mk₀ βM_std_2) (Nat.add_zero k)))
        (Nat.zero_add k)).comp (CategoryTheory.Abelian.Ext.mk₀ πM_std) (Nat.add_zero k)) =
      (((CategoryTheory.Abelian.Ext.mk₀ ηℤ_1).comp
        (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_1
          (((CategoryTheory.Abelian.Ext.mk₀ ι_R).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_R x') (Nat.zero_add k)).comp
            (CategoryTheory.Abelian.Ext.mk₀ π_R) (Nat.add_zero k)))
        (Nat.zero_add k)).comp (CategoryTheory.Abelian.Ext.mk₀ βM_std_1) (Nat.add_zero k))
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
    have hMid :
        CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_ℤ
          (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_2 x') =
        CategoryTheory.Abelian.Ext.mapExactFunctor U_std_1
          (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_R x') := by
      have hLimUZ : CategoryTheory.Limits.PreservesFiniteLimits (U_std_2.comp P_pull_ℤ) :=
        CategoryTheory.Limits.comp_preservesFiniteLimits U_std_2 P_pull_ℤ
      have hColimUZ : CategoryTheory.Limits.PreservesFiniteColimits (U_std_2.comp P_pull_ℤ) :=
        CategoryTheory.Limits.comp_preservesFiniteColimits U_std_2 P_pull_ℤ
      have hLimRU : CategoryTheory.Limits.PreservesFiniteLimits (P_pull_R.comp U_std_1) :=
        CategoryTheory.Limits.comp_preservesFiniteLimits P_pull_R U_std_1
      have hColimRU : CategoryTheory.Limits.PreservesFiniteColimits (P_pull_R.comp U_std_1) :=
        CategoryTheory.Limits.comp_preservesFiniteColimits P_pull_R U_std_1
      have h1 := (hMapComp U_std_2 P_pull_ℤ k x').symm
      have h2 := hMapComp P_pull_R U_std_1 k x'
      have hEqF_gen :
          ∀ (H₁ H₂ : CategoryTheory.Functor
              (CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R))
              (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}))
            (hH : H₁ = H₂)
            [hA₁ : H₁.Additive] [hL₁ : CategoryTheory.Limits.PreservesFiniteLimits H₁]
            [hC₁ : CategoryTheory.Limits.PreservesFiniteColimits H₁]
            [hA₂ : H₂.Additive] [hL₂ : CategoryTheory.Limits.PreservesFiniteLimits H₂]
            [hC₂ : CategoryTheory.Limits.PreservesFiniteColimits H₂],
            HEq (@CategoryTheory.Abelian.Ext.mapExactFunctor _ _ _ _ _ _ H₁ hA₁ hL₁ hC₁ _ _ _ _ _ x')
              (@CategoryTheory.Abelian.Ext.mapExactFunctor _ _ _ _ _ _ H₂ hA₂ hL₂ hC₂ _ _ _ _ _ x') := by
        intro H₁ H₂ hH hA₁ hL₁ hC₁ hA₂ hL₂ hC₂
        subst hH
        have : hA₁ = hA₂ := Subsingleton.elim _ _
        subst this
        have : hL₁ = hL₂ := Subsingleton.elim _ _
        subst this
        have : hC₁ = hC₂ := Subsingleton.elim _ _
        subst this
        exact HEq.rfl
      have hEqF :
          @CategoryTheory.Abelian.Ext.mapExactFunctor _ _ _ _ _ _ (U_std_2.comp P_pull_ℤ)
            inferInstance hLimUZ hColimUZ _ _ _ _ _ x' =
          @CategoryTheory.Abelian.Ext.mapExactFunctor _ _ _ _ _ _ (P_pull_R.comp U_std_1)
            inferInstance hLimRU hColimRU _ _ _ _ _ x' :=
        eq_of_heq (@hEqF_gen (U_std_2.comp P_pull_ℤ) (P_pull_R.comp U_std_1) hPullComm_def.symm
          inferInstance hLimUZ hColimUZ inferInstance hLimRU hColimRU)
      exact h1.trans (hEqF.trans h2)
    rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ_0)
          ((CategoryTheory.Abelian.Ext.mk₀ (P_pull_ℤ.map ηℤ_2)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_ℤ
              (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_2 x')) (Nat.zero_add k))
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ℤ.map βM_std_2))
          (Nat.zero_add k) (Nat.add_zero k) (by omega)]
    rw [CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_0).comp
            ((CategoryTheory.Abelian.Ext.mk₀ (P_pull_ℤ.map ηℤ_2)).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_ℤ
                (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_2 x')) (Nat.zero_add k))
            (Nat.zero_add k))
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ℤ.map βM_std_2))
          (CategoryTheory.Abelian.Ext.mk₀ πM_std)
          (Nat.add_zero k) (Nat.zero_add 0) (by omega)]
    rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ_0)
          (CategoryTheory.Abelian.Ext.mk₀ (P_pull_ℤ.map ηℤ_2))
          (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_ℤ
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_2 x'))
          (Nat.zero_add 0) (Nat.zero_add k) (by omega)]
    rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηℤ_1)
          ((CategoryTheory.Abelian.Ext.mk₀ (U_std_1.map ι_R)).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_1
              (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_R x')) (Nat.zero_add k))
          (CategoryTheory.Abelian.Ext.mk₀ (U_std_1.map π_R))
          (Nat.zero_add k) (Nat.add_zero k) (by omega)]
    rw [CategoryTheory.Abelian.Ext.comp_assoc
          ((CategoryTheory.Abelian.Ext.mk₀ ηℤ_1).comp
            ((CategoryTheory.Abelian.Ext.mk₀ (U_std_1.map ι_R)).comp
              (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_1
                (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_R x')) (Nat.zero_add k))
            (Nat.zero_add k))
          (CategoryTheory.Abelian.Ext.mk₀ (U_std_1.map π_R))
          (CategoryTheory.Abelian.Ext.mk₀ βM_std_1)
          (Nat.add_zero k) (Nat.zero_add 0) (by omega)]
    rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ηℤ_1)
          (CategoryTheory.Abelian.Ext.mk₀ (U_std_1.map ι_R))
          (CategoryTheory.Abelian.Ext.mapExactFunctor U_std_1
            (CategoryTheory.Abelian.Ext.mapExactFunctor P_pull_R x'))
          (Nat.zero_add 0) (Nat.zero_add k) (by omega)]
    have hSq_βM' : P_pull_ℤ.map βM_std_2 ≫ πM_std = U_std_1.map π_R ≫ βM_std_1 := hSq_βM
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        hSq_ηℤ, hSq_βM', hMid]
    rfl

  
  have hp_i_std : p_i (θ₂_i a₂) = p_std i (θ_std_2 i a₂) := by
    rw [hθ2_i_std]
    exact hp_align p_i ⟨hCont, hRA, hAdd_PZ, hLim_PZ, hColim_PZ, T₁_i, hT₁_i, T₂_i, hT₂_i,
      ιℤ_std, hιπ_i, hπι_i, hp_i_apply⟩ (θ_std_2 i a₂)
  have ha_eq : p_R i a₂ = a₁ := by
    apply hModInj S₁ m i (θ_std_1 i) (hθ_std_1 i)
    rw [← hPullModComm i a₂, ← hp_i_std, ha, hθ1_i_std]

  have hp_j_std : p_j (θ₂_j b₂) = p_std j (θ_std_2 j b₂) := by
    rw [hθ2_j_std]
    exact hp_align p_j hp_j (θ_std_2 j b₂)
  have hb_eq : p_R j b₂ = b₁ := by
    apply hModInj S₁ m j (θ_std_1 j) (hθ_std_1 j)
    rw [← hPullModComm j b₂, ← hp_j_std, hb, hθ1_j_std]

  
  calc
    p_c (θ₂_c (CategoryTheory.Abelian.Ext.comp a₂ b₂ hc))
      = p_std c (θ_std_2 c (CategoryTheory.Abelian.Ext.comp a₂ b₂ hc)) := by
          rw [hθ2_c_std]
          exact hp_align p_c hp_c _
    _ = θ_std_1 c (p_R c (CategoryTheory.Abelian.Ext.comp a₂ b₂ hc)) :=
          hPullModComm c (CategoryTheory.Abelian.Ext.comp a₂ b₂ hc)
    _ = θ_std_1 c (CategoryTheory.Abelian.Ext.comp (p_R i a₂) (p_R j b₂) hc) := by
          congr 1
          exact (hConjComp P_pull_R (X₂ := oneR_2) (X₁ := oneR_1) ι_R π_R hπι_R
            (show CategoryTheory.Abelian.Ext.{u} oneR_2 oneR_2 i from a₂)
            (show CategoryTheory.Abelian.Ext.{u} oneR_2 oneR_2 j from b₂)).symm
    _ = θ₁_c (CategoryTheory.Abelian.Ext.comp a₁ b₁ hc) := by
          rw [ha_eq, hb_eq, hθ1_c_std]

theorem weil_algClosed_etale_affineSpace_pointed_curve_join (k : Type u) [Field k] [IsAlgClosed k]
    (hPtDom : ∀ (d : ℕ) (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine X]
      (u : Quiver.Hom X (weilAffineSpaceOver k d).left) [AlgebraicGeometry.Etale u]
      (x : ↥X),
      IsClosed ({x} : Set ↥X) →
      ∃ U : X.Opens,
        AlgebraicGeometry.IsAffineOpen U ∧ x ∈ U ∧ AlgebraicGeometry.IsIntegral U.toScheme)
    (δ : ℕ)
    (V₀ : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V₀] [AlgebraicGeometry.IsIntegral V₀]
    (u₀ : Quiver.Hom V₀ (weilAffineSpaceOver k δ).left) [AlgebraicGeometry.Etale u₀]
    (v₀ : ↥V₀) (hv₀ : IsClosed ({v₀} : Set ↥V₀))
    (O_good : Set ↥V₀) (hO_open : IsOpen O_good)
    (hO_ne : O_good.Nonempty) (hv₀_not : v₀ ∉ O_good) :
    ∃ (C_aff : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsAffine C_aff)
      (_ : AlgebraicGeometry.IsIntegral C_aff)
      (ι_C : Quiver.Hom C_aff V₀)
      (u_C : Quiver.Hom C_aff (weilAffineSpaceOver k 1).left)
      (c₀ : ↥C_aff),
      AlgebraicGeometry.Etale u_C ∧
      CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom =
        CategoryTheory.CategoryStruct.comp ι_C
          (CategoryTheory.CategoryStruct.comp u₀ (weilAffineSpaceOver k δ).hom) ∧
      IsClosed ({c₀} : Set ↥C_aff) ∧
      ι_C.base c₀ = v₀ ∧
      (ι_C.base ⁻¹' O_good).Nonempty :=
by
  classical
  
  have hEtaleInj :
      ∀ (A B : Type u) [CommRing A] [IsDomain A] [CommRing B] [Nontrivial B]
        (θ : A →+* B), RingHom.Etale θ → Function.Injective θ := by
    intro A B _ _ _ _ θ hθ
    let _ : Algebra A B := θ.toAlgebra
    have : Algebra.Etale A B := RingHom.etale_algebraMap.mp hθ
    have : Module.Flat A B := inferInstance
    have : Module.IsTorsionFree A B := Module.Flat.isTorsionFree
    have : FaithfulSMul A B := Module.IsTorsionFree.to_faithfulSMul
    exact FaithfulSMul.algebraMap_injective A B

  
  have hNoethPrimes :
      ∀ (S : Type u) [CommRing S] [IsDomain S] [IsNoetherianRing S]
        (I : Type u) [Infinite I]
        (p : I → S),
        (∀ i : I, Prime (p i)) →
        (∀ i j : I, i ≠ j → ¬ (p i ∣ p j)) →
        ∀ (f : S), f ≠ 0 → ∃ i : I, ¬ (p i ∣ f) := by
    intro S _ _ _ I _ p hp hndvd f hf
    by_contra! h_all
    let e : ℕ ↪ I := Infinite.natEmbedding I
    let P : ℕ → S := fun n => (Finset.range n).prod (fun j => p (e j))
    have hP_ne : ∀ n : ℕ, P n ≠ 0 := fun n =>
      Finset.prod_ne_zero_iff.mpr fun j _ => (hp (e j)).ne_zero
    have hdvd : ∀ n : ℕ, P n ∣ f := by
      intro n
      induction n with
      | zero =>
        change (1 : S) ∣ f
        exact one_dvd f
      | succ n ih =>
        obtain ⟨q, hq⟩ := ih
        have hpen : p (e n) ∣ P n * q := hq ▸ h_all (e n)
        rcases (hp (e n)).dvd_or_dvd hpen with h_in_P | ⟨q', hq'⟩
        · exfalso
          have hex : ∀ m : ℕ, p (e n) ∣ P m → ∃ j < m, p (e n) ∣ p (e j) := by
            intro m
            induction m with
            | zero =>
              intro h1
              exact False.elim ((hp (e n)).not_isUnit (isUnit_of_dvd_one h1))
            | succ m ihm =>
              intro hm1
              have hP_eq : P (m + 1) = P m * p (e m) := Finset.prod_range_succ _ m
              rw [hP_eq] at hm1
              rcases (hp (e n)).dvd_or_dvd hm1 with hm0 | hpm
              · obtain ⟨j, hj, hjd⟩ := ihm hm0
                exact ⟨j, Nat.lt_succ_of_lt hj, hjd⟩
              · exact ⟨m, Nat.lt_succ_self m, hpm⟩
          obtain ⟨j, hj_lt, hj_dvd⟩ := hex n h_in_P
          exact hndvd (e n) (e j) (e.injective.ne (Nat.ne_of_lt hj_lt).symm) hj_dvd
        · refine ⟨q', ?_⟩
          have hP_succ : P (n + 1) = P n * p (e n) := Finset.prod_range_succ _ n
          rw [hP_succ, hq, hq', mul_assoc]
    let q : ℕ → S := fun n => Classical.choose (hdvd n)
    have hq_spec : ∀ n : ℕ, f = P n * q n := fun n => Classical.choose_spec (hdvd n)
    have hq_rec : ∀ n : ℕ, q n = p (e n) * q (n + 1) := by
      intro n
      apply mul_left_cancel₀ (hP_ne n)
      calc
        P n * q n = f := (hq_spec n).symm
        _ = P (n + 1) * q (n + 1) := hq_spec (n + 1)
        _ = (P n * p (e n)) * q (n + 1) := by
          dsimp [P]
          rw [Finset.prod_range_succ]
        _ = P n * (p (e n) * q (n + 1)) := mul_assoc _ _ _
    have hchain_step : ∀ n : ℕ, Ideal.span ({q n} : Set S) ≤ Ideal.span ({q (n + 1)} : Set S) := by
      intro n
      rw [Ideal.span_le]
      rintro _ rfl
      exact Ideal.mem_span_singleton.mpr ⟨p (e n), (hq_rec n).trans (mul_comm _ _)⟩
    let chain : ℕ →o Ideal S := ⟨fun n => Ideal.span ({q n} : Set S), monotone_nat_of_le_succ hchain_step⟩
    obtain ⟨N, hN⟩ := monotone_stabilizes_iff_noetherian.mpr inferInstance chain
    have hle_N : Ideal.span ({q (N + 1)} : Set S) ≤ Ideal.span ({q N} : Set S) :=
      le_of_eq (hN (N + 1) (Nat.le_succ N)).symm
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton.mp (hle_N (Ideal.subset_span rfl))
    have hqN1_ne : q (N + 1) ≠ 0 := by
      intro h0
      apply hf
      rw [hq_spec (N + 1), h0, mul_zero]
    have hunit_eq : (1 : S) = p (e N) * u := by
      apply mul_left_cancel₀ hqN1_ne
      calc
        q (N + 1) * 1 = q (N + 1) := mul_one _
        _ = q N * u := hu
        _ = (p (e N) * q (N + 1)) * u := by rw [hq_rec N]
        _ = q (N + 1) * (p (e N) * u) := by ring
    exact (hp (e N)).not_isUnit (isUnit_iff_exists_inv.mpr ⟨u, hunit_eq.symm⟩)

  
  have hSpecShrink :
      ∀ (B : Type u) [CommRing B] (ε : B →+* k) (hε_surj : Function.Surjective ε),
        let x_ε : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) :=
          (⟨RingHom.ker ε, (RingHom.ker_isMaximal_of_surjective ε hε_surj).isPrime⟩ : PrimeSpectrum B)
        IsClosed ({x_ε} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B))) ∧
        ∀ (U : (AlgebraicGeometry.Spec (CommRingCat.of B)).Opens),
          x_ε ∈ U →
          AlgebraicGeometry.IsIntegral U.toScheme →
          ∃ (g : B),
            g ∉ RingHom.ker ε ∧
            IsDomain (Localization.Away g) ∧
            ∃ (w_g : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)))),
              IsClosed ({w_g} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)))) ∧
              (AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (algebraMap B (Localization.Away g)))).base w_g = x_ε := by
    intro B _ ε hε_surj
    have hmax_ker : (RingHom.ker ε).IsMaximal := RingHom.ker_isMaximal_of_surjective ε hε_surj
    let x_ε : ↥(AlgebraicGeometry.Spec (CommRingCat.of B)) :=
      (⟨RingHom.ker ε, hmax_ker.isPrime⟩ : PrimeSpectrum B)
    have hx_cl : IsClosed ({x_ε} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal
        (⟨RingHom.ker ε, hmax_ker.isPrime⟩ : PrimeSpectrum B)).mpr hmax_ker
    refine ⟨hx_cl, fun U hx_U hInt_U => ?_⟩
    have : AlgebraicGeometry.IsIntegral U.toScheme := hInt_U
    obtain ⟨_, ⟨g, rfl⟩, hx_Dg, hDg_sub⟩ :=
      TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
        PrimeSpectrum.isTopologicalBasis_basic_opens hx_U U.isOpen
    have hg_not_ker : g ∉ RingHom.ker ε := hx_Dg
    have hg_ne : ε g ≠ 0 := fun h0 => hg_not_ker (RingHom.mem_ker.mpr h0)
    let ε_g : Localization.Away g →+* k := IsLocalization.Away.lift g (Ne.isUnit hg_ne)
    have hεg_comp : ∀ b : B, ε_g (algebraMap B (Localization.Away g) b) = ε b :=
      IsLocalization.Away.lift_eq g (Ne.isUnit hg_ne)
    have hεg_surj : Function.Surjective ε_g := fun c => by
      obtain ⟨b, hb⟩ := hε_surj c
      exact ⟨algebraMap B (Localization.Away g) b, (hεg_comp b).trans hb⟩
    have hmax_g : (RingHom.ker ε_g).IsMaximal := RingHom.ker_isMaximal_of_surjective ε_g hεg_surj
    let w_g : ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))) :=
      (⟨RingHom.ker ε_g, hmax_g.isPrime⟩ : PrimeSpectrum (Localization.Away g))
    have hw_cl :
        IsClosed ({w_g} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)))) :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal
        (⟨RingHom.ker ε_g, hmax_g.isPrime⟩ : PrimeSpectrum (Localization.Away g))).mpr hmax_g
    let j_g : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away g)))
    have hw_map : j_g.base w_g = x_ε := by
      apply PrimeSpectrum.ext
      ext b
      change algebraMap B (Localization.Away g) b ∈ RingHom.ker ε_g ↔ b ∈ RingHom.ker ε
      rw [RingHom.mem_ker, RingHom.mem_ker, hεg_comp]
    have : AlgebraicGeometry.IsOpenImmersion j_g :=
      AlgebraicGeometry.IsOpenImmersion.of_isLocalization g
    have hrange_jg : Set.range j_g.base ⊆ Set.range U.ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨p, rfl⟩
      apply hDg_sub
      change g ∉ (j_g.base p : PrimeSpectrum B).asIdeal
      intro hg_mem
      have h_unit : IsUnit (algebraMap B (Localization.Away g) g) :=
        IsLocalization.Away.algebraMap_isUnit g
      exact p.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hg_mem h_unit)
    let j_lift : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g)) ⟶ U.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U.ι j_g hrange_jg
    have hj_fac : j_lift ≫ U.ι = j_g :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι j_g hrange_jg
    have : AlgebraicGeometry.IsOpenImmersion (j_lift ≫ U.ι) := by
      rw [hj_fac]
      infer_instance
    have : AlgebraicGeometry.IsOpenImmersion j_lift :=
      AlgebraicGeometry.IsOpenImmersion.of_comp j_lift U.ι
    have : Nonempty ↥(AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))) := ⟨w_g⟩
    have : AlgebraicGeometry.IsIntegral
        (AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away g))) :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion j_lift
    have : IsDomain ↑((AlgebraicGeometry.Spec
        (CommRingCat.of (Localization.Away g))).presheaf.obj (Opposite.op ⊤)) :=
      inferInstance
    let e_Γ := (AlgebraicGeometry.Scheme.ΓSpecIso
      (CommRingCat.of (Localization.Away g))).commRingCatIsoToRingEquiv
    have hDom_Away : IsDomain (Localization.Away g) :=
      Function.Injective.isDomain e_Γ.symm.toRingHom e_Γ.symm.injective
    exact ⟨g, hg_not_ker, hDom_Away, w_g, hw_cl, hw_map⟩

  
  have hSlice :
      ∀ (m : ℕ) (R : Type u) [CommRing R] [IsDomain R]
        (φ : MvPolynomial (Fin (m + 2)) k →+* R) (hφ : RingHom.Etale φ)
        (ε₀ : R →+* k) (hε₀ : ∀ b : k, ε₀ (φ (MvPolynomial.C b)) = b)
        (𝔪₀ : Ideal R) [𝔪₀.IsMaximal] (h𝔪₀ : 𝔪₀ = RingHom.ker ε₀),
        let a : Fin (m + 2) → k := fun i => ε₀ (φ (MvPolynomial.X i))
        let L : k → MvPolynomial (Fin (m + 2)) k := fun c =>
          MvPolynomial.X 0 -
            (MvPolynomial.C (a 0) + MvPolynomial.C c * (MvPolynomial.X 1 - MvPolynomial.C (a 1)))
        let q_slice : ∀ c : k, R →+* (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
          fun c => Ideal.Quotient.mk (Ideal.span ({φ (L c)} : Set R))
        let φ_slice : ∀ c : k,
            MvPolynomial (Fin (m + 1)) k →+* (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
          fun c => (q_slice c).comp (φ.comp (MvPolynomial.rename Fin.succ).toRingHom)
        (∀ c : k, φ (L c) ∈ 𝔪₀ ∧ RingHom.Etale (φ_slice c)) ∧
        (∀ (c : k) (g : R),
          g ∉ 𝔪₀ →
          IsDomain (Localization.Away (q_slice c g)) →
          Prime (algebraMap R (Localization.AtPrime 𝔪₀) (φ (L c))) ∧
          (∀ f : R,
            algebraMap (R ⧸ Ideal.span ({φ (L c)} : Set R))
              (Localization.Away (q_slice c g)) (q_slice c f) = 0 →
            algebraMap R (Localization.AtPrime 𝔪₀) (φ (L c)) ∣
              algebraMap R (Localization.AtPrime 𝔪₀) f) ∧
          algebraMap R (Localization.AtPrime 𝔪₀)
              (φ (MvPolynomial.X 1 - MvPolynomial.C (a 1))) ∉
            Ideal.span ({algebraMap R (Localization.AtPrime 𝔪₀) (φ (L c))} :
              Set (Localization.AtPrime 𝔪₀))) ∧
        (∀ (c₁ c₂ : k) (g₁ : R),
          c₁ ≠ c₂ →
          g₁ ∉ 𝔪₀ →
          IsDomain (Localization.Away (q_slice c₁ g₁)) →
          ¬ (algebraMap R (Localization.AtPrime 𝔪₀) (φ (L c₁)) ∣
              algebraMap R (Localization.AtPrime 𝔪₀) (φ (L c₂)))) := by
    intro m R _ _ φ hφ ε₀ hε₀ 𝔪₀ _ h𝔪₀
    let a : Fin (m + 2) → k := fun i => ε₀ (φ (MvPolynomial.X i))
    let L : k → MvPolynomial (Fin (m + 2)) k := fun c =>
      MvPolynomial.X 0 -
        (MvPolynomial.C (a 0) + MvPolynomial.C c * (MvPolynomial.X 1 - MvPolynomial.C (a 1)))
    let q_slice : ∀ c : k, R →+* (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
      fun c => Ideal.Quotient.mk (Ideal.span ({φ (L c)} : Set R))
    let ι_P : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin (m + 2)) k :=
      MvPolynomial.rename Fin.succ
    let φ_slice : ∀ c : k,
        MvPolynomial (Fin (m + 1)) k →+* (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
      fun c => (q_slice c).comp (φ.comp ι_P.toRingHom)
    have hsucc0 : Fin.succ (0 : Fin (m + 1)) = (1 : Fin (m + 2)) := Fin.ext (by simp)
    have hι_C : ∀ b : k, ι_P (MvPolynomial.C b) = MvPolynomial.C b := fun b => ι_P.commutes b
    have hι_X : ∀ j : Fin (m + 1), ι_P (MvPolynomial.X j) = MvPolynomial.X j.succ :=
      fun j => MvPolynomial.rename_X Fin.succ j
    have hPart1 : ∀ c : k, φ (L c) ∈ 𝔪₀ ∧ RingHom.Etale (φ_slice c) := by
      intro c
      have hmem_m0 : φ (L c) ∈ 𝔪₀ := by
        rw [h𝔪₀, RingHom.mem_ker]
        dsimp [L]
        simp only [map_sub, map_add, map_mul, hε₀]
        change a 0 - (a 0 + c * (a 1 - a 1)) = 0
        ring
      let ev_fn : Fin (m + 2) → MvPolynomial (Fin (m + 1)) k :=
        Fin.cases
          (MvPolynomial.C (a 0) + MvPolynomial.C c * (MvPolynomial.X 0 - MvPolynomial.C (a 1)))
          (fun j => MvPolynomial.X j)
      let π_c : MvPolynomial (Fin (m + 2)) k →ₐ[k] MvPolynomial (Fin (m + 1)) k :=
        MvPolynomial.aeval ev_fn
      have hπ_C : ∀ b : k, π_c (MvPolynomial.C b) = MvPolynomial.C b := fun b => π_c.commutes b
      have hπ_X0 :
          π_c (MvPolynomial.X 0) =
            MvPolynomial.C (a 0) + MvPolynomial.C c * (MvPolynomial.X 0 - MvPolynomial.C (a 1)) :=
        (MvPolynomial.aeval_X ev_fn 0).trans rfl
      have hπ_Xsucc : ∀ j : Fin (m + 1), π_c (MvPolynomial.X j.succ) = MvPolynomial.X j :=
        fun j => (MvPolynomial.aeval_X ev_fn j.succ).trans (Fin.cases_succ j)
      have hπ_ι : ∀ p₁ : MvPolynomial (Fin (m + 1)) k, π_c (ι_P p₁) = p₁ := by
        have hcomp_id : π_c.comp ι_P = AlgHom.id k (MvPolynomial (Fin (m + 1)) k) := by
          apply MvPolynomial.algHom_ext
          intro j
          change π_c (ι_P (MvPolynomial.X j)) = MvPolynomial.X j
          rw [hι_X, hπ_Xsucc]
        exact fun p₁ => AlgHom.congr_fun hcomp_id p₁
      have hι_π0 :
          ι_P (π_c (MvPolynomial.X 0)) =
            MvPolynomial.C (a 0) + MvPolynomial.C c * (MvPolynomial.X 1 - MvPolynomial.C (a 1)) := by
        rw [hπ_X0, map_add, map_mul, map_sub, hι_C, hι_C, hι_C, hι_X, hsucc0]
      have hL_eq : L c = MvPolynomial.X 0 - ι_P (π_c (MvPolynomial.X 0)) := by
        rw [hι_π0]
      have hπ_L : π_c (L c) = 0 := by
        rw [hL_eq, map_sub, hπ_ι, sub_self]
      let f_π : CommRingCat.of (MvPolynomial (Fin (m + 2)) k) ⟶
          CommRingCat.of (MvPolynomial (Fin (m + 1)) k) :=
        CommRingCat.ofHom π_c.toRingHom
      let f_φ : CommRingCat.of (MvPolynomial (Fin (m + 2)) k) ⟶ CommRingCat.of R :=
        CommRingCat.ofHom φ
      let inl_c : CommRingCat.of (MvPolynomial (Fin (m + 1)) k) ⟶
          CommRingCat.of (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
        CommRingCat.ofHom (φ_slice c)
      let inr_c : CommRingCat.of R ⟶ CommRingCat.of (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
        CommRingCat.ofHom (q_slice c)
      have hsq : f_π ≫ inl_c = f_φ ≫ inr_c := by
        apply CommRingCat.hom_ext
        apply MvPolynomial.ringHom_ext
        · intro b
          change q_slice c (φ (ι_P (π_c (MvPolynomial.C b)))) = q_slice c (φ (MvPolynomial.C b))
          rw [hπ_C, hι_C]
        · intro i
          refine Fin.cases ?_ ?_ i
          · change Ideal.Quotient.mk (Ideal.span ({φ (L c)} : Set R))
                (φ (ι_P (π_c (MvPolynomial.X 0)))) =
              Ideal.Quotient.mk (Ideal.span ({φ (L c)} : Set R)) (φ (MvPolynomial.X 0))
            rw [Ideal.Quotient.eq]
            have hdiff :
                φ (ι_P (π_c (MvPolynomial.X 0))) - φ (MvPolynomial.X 0) = - φ (L c) := by
              rw [← map_sub]
              have hp : ι_P (π_c (MvPolynomial.X 0)) - MvPolynomial.X 0 = - L c := by
                rw [hL_eq]; ring
              rw [hp, map_neg]
            rw [hdiff]
            exact Submodule.neg_mem _ (Ideal.subset_span rfl)
          · intro j
            change q_slice c (φ (ι_P (π_c (MvPolynomial.X j.succ)))) =
              q_slice c (φ (MvPolynomial.X j.succ))
            rw [hπ_Xsucc, hι_X]
      have hPush : CategoryTheory.IsPushout f_π f_φ inl_c inr_c := by
        refine CategoryTheory.IsPushout.mk ⟨hsq⟩ ⟨?_⟩
        refine CategoryTheory.Limits.PushoutCocone.isColimitAux' _ fun s => ?_
        have hker_le : Ideal.span ({φ (L c)} : Set R) ≤ RingHom.ker s.inr.hom := by
          rw [Ideal.span_le]
          rintro _ rfl
          change (f_φ ≫ s.inr).hom (L c) = 0
          rw [← s.condition]
          change s.inl.hom (π_c (L c)) = 0
          rw [hπ_L, map_zero]
        let l_hom : (R ⧸ Ideal.span ({φ (L c)} : Set R)) →+* ↑s.pt :=
          Ideal.Quotient.lift (Ideal.span ({φ (L c)} : Set R)) s.inr.hom hker_le
        let l : CommRingCat.of (R ⧸ Ideal.span ({φ (L c)} : Set R)) ⟶ s.pt :=
          CommRingCat.ofHom l_hom
        have hinr_l : inr_c ≫ l = s.inr := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro r
          exact rfl
        have hinl_l : inl_c ≫ l = s.inl := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro p₁
          change l_hom (q_slice c (φ (ι_P p₁))) = s.inl.hom p₁
          have hl1 : l_hom (q_slice c (φ (ι_P p₁))) = (f_φ ≫ s.inr).hom (ι_P p₁) := rfl
          rw [hl1, ← s.condition]
          change s.inl.hom (π_c (ι_P p₁)) = s.inl.hom p₁
          rw [hπ_ι]
        refine ⟨l, hinl_l, hinr_l, fun {m_mor} _ hm_inr => ?_⟩
        have hm_inr' : inr_c ≫ m_mor = s.inr := hm_inr
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro r
        change (inr_c ≫ m_mor).hom r = (inr_c ≫ l).hom r
        rw [hm_inr', hinr_l]
      have hPb : CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map inl_c)
          (AlgebraicGeometry.Spec.map inr_c)
          (AlgebraicGeometry.Spec.map f_π)
          (AlgebraicGeometry.Spec.map f_φ) :=
        AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush
      have hEt_fφ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map f_φ) :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hφ
      have hEt_inl : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map inl_c) :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hEt_fφ
      exact ⟨hmem_m0,
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_inl⟩

    let S := Localization.AtPrime 𝔪₀
    have : IsDomain S :=
      IsLocalization.isDomain_of_le_nonZeroDivisors S 𝔪₀.primeCompl_le_nonZeroDivisors
    let ψ : MvPolynomial (Fin (m + 2)) k →+* S := (algebraMap R S).comp φ
    have hφ_inj : Function.Injective φ := hEtaleInj (MvPolynomial (Fin (m + 2)) k) R φ hφ
    have halgS_inj : Function.Injective (algebraMap R S) :=
      IsLocalization.injective S 𝔪₀.primeCompl_le_nonZeroDivisors
    have hψ_inj : Function.Injective ψ := halgS_inj.comp hφ_inj

    have hPart2 :
        ∀ (c : k) (g : R),
          g ∉ 𝔪₀ →
          IsDomain (Localization.Away (q_slice c g)) →
          Prime (ψ (L c)) ∧
          (∀ f : R,
            algebraMap (R ⧸ Ideal.span ({φ (L c)} : Set R))
              (Localization.Away (q_slice c g)) (q_slice c f) = 0 →
            ψ (L c) ∣ algebraMap R S f) ∧
          ψ (MvPolynomial.X 1 - MvPolynomial.C (a 1)) ∉
            Ideal.span ({ψ (L c)} : Set S) := by
      intro c g hg_not hDom_Ac
      let R_c := R ⧸ Ideal.span ({φ (L c)} : Set R)
      let A_c := Localization.Away (q_slice c g)
      have : IsDomain A_c := hDom_Ac
      have hLc_ne : L c ≠ 0 := by
        intro h0
        let pt_test : Fin (m + 2) → k := Fin.cases (a 0 + 1) (fun _ => a 1)
        have hev := congrArg (MvPolynomial.eval pt_test) h0
        have hev1 : MvPolynomial.eval pt_test (MvPolynomial.X (1 : Fin (m + 2))) = a 1 := by
          rw [MvPolynomial.eval_X]
          change Fin.cases (a 0 + 1) (fun _ => a 1) (1 : Fin (m + 2)) = a 1
          rw [← hsucc0, Fin.cases_succ]
        have hev0 : MvPolynomial.eval pt_test (MvPolynomial.X (0 : Fin (m + 2))) = a 0 + 1 := by
          rw [MvPolynomial.eval_X]
          exact rfl
        dsimp [L] at hev
        simp only [map_sub, map_add, map_mul, map_zero, MvPolynomial.eval_C, hev0, hev1] at hev
        have h10 : (1 : k) = 0 := by linear_combination hev
        exact one_ne_zero h10
      have hψLc_ne : ψ (L c) ≠ 0 := fun h0 => hLc_ne (hψ_inj (h0.trans (map_zero ψ).symm))
      have hker_Lc : Ideal.span ({φ (L c)} : Set R) ≤ RingHom.ker ε₀ := by
        rw [Ideal.span_le]
        rintro _ rfl
        rw [← h𝔪₀]
        exact (hPart1 c).1
      let ε_c : R_c →+* k := Ideal.Quotient.lift (Ideal.span ({φ (L c)} : Set R)) ε₀ hker_Lc
      have hεc_mk : ∀ r : R, ε_c (q_slice c r) = ε₀ r := fun _ => Ideal.Quotient.lift_mk _ _ _
      have hεc_surj : Function.Surjective ε_c := fun b =>
        ⟨q_slice c (φ (MvPolynomial.C b)), (hεc_mk _).trans (hε₀ b)⟩
      let 𝔪_c : Ideal R_c := RingHom.ker ε_c
      have : 𝔪_c.IsMaximal := RingHom.ker_isMaximal_of_surjective ε_c hεc_surj
      have : 𝔪_c.IsPrime := ‹𝔪_c.IsMaximal›.isPrime
      have hqg_ne : ε_c (q_slice c g) ≠ 0 := by
        rw [hεc_mk]
        intro h0
        exact hg_not (h𝔪₀ ▸ RingHom.mem_ker.mpr h0)
      have hqg_compl : q_slice c g ∈ 𝔪_c.primeCompl := hqg_ne
      let ε'_c : A_c →+* k := IsLocalization.Away.lift (q_slice c g) (Ne.isUnit hqg_ne)
      have hε'c_alg : ∀ x : R_c, ε'_c (algebraMap R_c A_c x) = ε_c x :=
        IsLocalization.Away.lift_eq (q_slice c g) (Ne.isUnit hqg_ne)
      have hε'c_surj : Function.Surjective ε'_c := fun b => by
        obtain ⟨x, hx⟩ := hεc_surj b
        exact ⟨algebraMap R_c A_c x, (hε'c_alg x).trans hx⟩
      let 𝔫_c : Ideal A_c := RingHom.ker ε'_c
      have : 𝔫_c.IsMaximal := RingHom.ker_isMaximal_of_surjective ε'_c hε'c_surj
      have : 𝔫_c.IsPrime := ‹𝔫_c.IsMaximal›.isPrime
      let S_mc := Localization.AtPrime 𝔪_c
      let S_nc := Localization.AtPrime 𝔫_c
      have : IsDomain S_nc :=
        IsLocalization.isDomain_of_le_nonZeroDivisors S_nc 𝔫_c.primeCompl_le_nonZeroDivisors
      have halg_nc_inj : Function.Injective (algebraMap A_c S_nc) :=
        IsLocalization.injective S_nc 𝔫_c.primeCompl_le_nonZeroDivisors
      let lam_c : A_c →+* S_mc :=
        IsLocalization.Away.lift (q_slice c g)
          (IsLocalization.map_units S_mc ⟨q_slice c g, hqg_compl⟩)
      have hlam_alg : ∀ x : R_c, lam_c (algebraMap R_c A_c x) = algebraMap R_c S_mc x :=
        IsLocalization.Away.lift_eq (q_slice c g) _
      have hμ_units : ∀ y : 𝔪_c.primeCompl,
          IsUnit (((algebraMap A_c S_nc).comp (algebraMap R_c A_c)) y) := by
        intro y
        have hy_nc : algebraMap R_c A_c y.1 ∈ 𝔫_c.primeCompl := by
          change ε'_c (algebraMap R_c A_c y.1) ≠ 0
          rw [hε'c_alg]
          exact y.2
        exact IsLocalization.map_units S_nc ⟨algebraMap R_c A_c y.1, hy_nc⟩
      let μ_c : S_mc →+* S_nc := IsLocalization.lift hμ_units
      have hμ_alg : ∀ x : R_c, μ_c (algebraMap R_c S_mc x) = algebraMap A_c S_nc (algebraMap R_c A_c x) :=
        IsLocalization.lift_eq hμ_units
      have hμ_lam : μ_c.comp lam_c = algebraMap A_c S_nc := by
        apply IsLocalization.ringHom_ext (Submonoid.powers (q_slice c g))
        apply RingHom.ext
        intro x
        change μ_c (lam_c (algebraMap R_c A_c x)) = algebraMap A_c S_nc (algebraMap R_c A_c x)
        rw [hlam_alg, hμ_alg]
      have hlam_inj : Function.Injective lam_c := fun x₁ x₂ hx => by
        apply halg_nc_inj
        rw [← hμ_lam]
        exact congrArg μ_c hx
      have hν_units : ∀ z : 𝔫_c.primeCompl, IsUnit (lam_c z) := by
        intro z
        obtain ⟨n, x, hzx⟩ := IsLocalization.Away.surj (q_slice c g) z.1
        have hx_mc : x ∈ 𝔪_c.primeCompl := by
          change ε_c x ≠ 0
          have hev := congrArg ε'_c hzx
          rw [map_mul, map_pow, hε'c_alg, hε'c_alg] at hev
          rw [← hev]
          exact mul_ne_zero z.2 (pow_ne_zero n hqg_ne)
        have hprod_unit : IsUnit (lam_c z.1 * lam_c ((algebraMap R_c A_c (q_slice c g)) ^ n)) := by
          rw [← map_mul, hzx, hlam_alg]
          exact IsLocalization.map_units S_mc ⟨x, hx_mc⟩
        exact isUnit_of_mul_isUnit_left hprod_unit
      let ν_c : S_nc →+* S_mc := IsLocalization.lift hν_units
      have hν_alg : ∀ y : A_c, ν_c (algebraMap A_c S_nc y) = lam_c y :=
        IsLocalization.lift_eq hν_units
      have hν_μ : ν_c.comp μ_c = RingHom.id S_mc := by
        apply IsLocalization.ringHom_ext 𝔪_c.primeCompl
        apply RingHom.ext
        intro x
        change ν_c (μ_c (algebraMap R_c S_mc x)) = algebraMap R_c S_mc x
        rw [hμ_alg, hν_alg, hlam_alg]
      have hμ_inj : Function.Injective μ_c := fun x₁ x₂ hx => by
        have h1 := congrArg ν_c hx
        change (ν_c.comp μ_c) x₁ = (ν_c.comp μ_c) x₂ at h1
        rwa [hν_μ, RingHom.id_apply, RingHom.id_apply] at h1
      have : IsDomain S_mc := Function.Injective.isDomain μ_c hμ_inj

      
      let Q_S := S ⧸ Ideal.span ({ψ (L c)} : Set S)
      have hα_units : ∀ s : 𝔪₀.primeCompl,
          IsUnit (((algebraMap R_c S_mc).comp (q_slice c)) s) := by
        intro s
        have hs_mc : q_slice c s.1 ∈ 𝔪_c.primeCompl := by
          change ε_c (q_slice c s.1) ≠ 0
          rw [hεc_mk]
          have hs_not : s.1 ∉ RingHom.ker ε₀ := h𝔪₀ ▸ s.2
          exact hs_not
        exact IsLocalization.map_units S_mc ⟨q_slice c s.1, hs_mc⟩
      let α₀ : S →+* S_mc := IsLocalization.lift hα_units
      have hα₀_alg : ∀ r : R, α₀ (algebraMap R S r) = algebraMap R_c S_mc (q_slice c r) :=
        IsLocalization.lift_eq hα_units
      have hα₀_ker : Ideal.span ({ψ (L c)} : Set S) ≤ RingHom.ker α₀ := by
        rw [Ideal.span_le]
        rintro _ rfl
        change α₀ (algebraMap R S (φ (L c))) = 0
        rw [hα₀_alg]
        have hq0 : q_slice c (φ (L c)) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
        rw [hq0, map_zero]
      let α_fwd : Q_S →+* S_mc :=
        Ideal.Quotient.lift (Ideal.span ({ψ (L c)} : Set S)) α₀ hα₀_ker
      have hβ₀_ker : Ideal.span ({φ (L c)} : Set R) ≤
          RingHom.ker ((Ideal.Quotient.mk (Ideal.span ({ψ (L c)} : Set S))).comp (algebraMap R S)) := by
        rw [Ideal.span_le]
        rintro _ rfl
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      let β₀ : R_c →+* Q_S :=
        Ideal.Quotient.lift (Ideal.span ({φ (L c)} : Set R))
          ((Ideal.Quotient.mk (Ideal.span ({ψ (L c)} : Set S))).comp (algebraMap R S)) hβ₀_ker
      have hβ_units : ∀ y : 𝔪_c.primeCompl, IsUnit (β₀ y) := by
        intro y
        obtain ⟨s, hs⟩ := Ideal.Quotient.mk_surjective y.1
        have hs_m0 : s ∈ 𝔪₀.primeCompl := by
          intro hs_mem
          have h0 : ε₀ s = 0 := RingHom.mem_ker.mp (h𝔪₀ ▸ hs_mem)
          have h0' : ε_c y.1 = 0 := by
            rw [← hs]
            exact (hεc_mk s).trans h0
          exact y.2 h0'
        have huS : IsUnit (algebraMap R S s) := IsLocalization.map_units S ⟨s, hs_m0⟩
        have hβs : β₀ y.1 = Ideal.Quotient.mk (Ideal.span ({ψ (L c)} : Set S)) (algebraMap R S s) := by
          rw [← hs]
          rfl
        rw [hβs]
        exact huS.map (Ideal.Quotient.mk (Ideal.span ({ψ (L c)} : Set S)))
      let α_bwd : S_mc →+* Q_S := IsLocalization.lift hβ_units
      have hα_bwd_alg : ∀ x : R_c, α_bwd (algebraMap R_c S_mc x) = β₀ x :=
        IsLocalization.lift_eq hβ_units
      have hbwd_fwd : α_bwd.comp α_fwd = RingHom.id Q_S := by
        apply Ideal.Quotient.ringHom_ext
        apply IsLocalization.ringHom_ext 𝔪₀.primeCompl
        apply RingHom.ext
        intro r
        change α_bwd (α₀ (algebraMap R S r)) =
          Ideal.Quotient.mk (Ideal.span ({ψ (L c)} : Set S)) (algebraMap R S r)
        rw [hα₀_alg, hα_bwd_alg]
        rfl
      have hα_fwd_inj : Function.Injective α_fwd := fun z₁ z₂ hz => by
        have h1 := congrArg α_bwd hz
        change (α_bwd.comp α_fwd) z₁ = (α_bwd.comp α_fwd) z₂ at h1
        rwa [hbwd_fwd, RingHom.id_apply, RingHom.id_apply] at h1
      have hfwd_bwd : α_fwd.comp α_bwd = RingHom.id S_mc := by
        apply IsLocalization.ringHom_ext 𝔪_c.primeCompl
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro r
        change α_fwd (α_bwd (algebraMap R_c S_mc (q_slice c r))) = algebraMap R_c S_mc (q_slice c r)
        rw [hα_bwd_alg]
        exact hα₀_alg r
      have hα_bwd_inj : Function.Injective α_bwd := fun z₁ z₂ hz => by
        have h1 := congrArg α_fwd hz
        change (α_fwd.comp α_bwd) z₁ = (α_fwd.comp α_bwd) z₂ at h1
        rwa [hfwd_bwd, RingHom.id_apply, RingHom.id_apply] at h1
      have : IsDomain Q_S := Function.Injective.isDomain α_fwd hα_fwd_inj
      have hPrime_span : (Ideal.span ({ψ (L c)} : Set S)).IsPrime :=
        (Ideal.Quotient.isDomain_iff_prime (Ideal.span ({ψ (L c)} : Set S))).mp ‹IsDomain Q_S›
      have hPrime_Lc : Prime (ψ (L c)) :=
        (Ideal.span_singleton_prime hψLc_ne).mp hPrime_span
      have hDiv_crit :
          ∀ f : R, algebraMap R_c A_c (q_slice c f) = 0 → ψ (L c) ∣ algebraMap R S f := by
        intro f hf0
        rw [← Ideal.mem_span_singleton, ← Ideal.Quotient.eq_zero_iff_mem]
        apply hα_fwd_inj
        rw [map_zero]
        change α₀ (algebraMap R S f) = 0
        rw [hα₀_alg, ← hlam_alg, hf0, map_zero]
      
      have hEt_loc : RingHom.Etale (algebraMap R_c A_c) :=
        RingHom.etale_algebraMap.mpr inferInstance
      let θ_c : MvPolynomial (Fin (m + 1)) k →+* A_c := (algebraMap R_c A_c).comp (φ_slice c)
      have hEt_θ : RingHom.Etale θ_c :=
        RingHom.Etale.stableUnderComposition (φ_slice c) (algebraMap R_c A_c) (hPart1 c).2 hEt_loc
      have hθ_inj : Function.Injective θ_c :=
        hEtaleInj (MvPolynomial (Fin (m + 1)) k) A_c θ_c hEt_θ
      let Y₀_shift : MvPolynomial (Fin (m + 1)) k := MvPolynomial.X 0 - MvPolynomial.C (a 1)
      have hY₀_ne : Y₀_shift ≠ 0 := by
        intro h0
        have hev := congrArg (MvPolynomial.eval (fun _ : Fin (m + 1) => a 1 + 1)) h0
        dsimp [Y₀_shift] at hev
        simp only [map_sub, map_zero, MvPolynomial.eval_X, MvPolynomial.eval_C] at hev
        have h10 : (1 : k) = 0 := by linear_combination hev
        exact one_ne_zero h10
      have hΞ_ne : α_bwd (lam_c (θ_c Y₀_shift)) ≠ 0 :=
        fun h0 => hY₀_ne (hθ_inj (hlam_inj (hα_bwd_inj (h0.trans (by simp)))))
      have hΞ_eq :
          α_bwd (lam_c (θ_c Y₀_shift)) =
            Ideal.Quotient.mk (Ideal.span ({ψ (L c)} : Set S))
              (ψ (MvPolynomial.X 1 - MvPolynomial.C (a 1))) := by
        have hι_Y0 : ι_P Y₀_shift = MvPolynomial.X 1 - MvPolynomial.C (a 1) := by
          dsimp [Y₀_shift]
          rw [map_sub, hι_X, hι_C, hsucc0]
        change α_bwd (lam_c (algebraMap R_c A_c (q_slice c (φ (ι_P Y₀_shift))))) = _
        rw [hι_Y0, hlam_alg, hα_bwd_alg]
        rfl
      have hX1_not_mem :
          ψ (MvPolynomial.X 1 - MvPolynomial.C (a 1)) ∉ Ideal.span ({ψ (L c)} : Set S) := by
        rw [← Ideal.Quotient.eq_zero_iff_mem, ← hΞ_eq]
        exact hΞ_ne
      exact ⟨hPrime_Lc, hDiv_crit, hX1_not_mem⟩

    refine ⟨hPart1, hPart2, fun c₁ c₂ g₁ hc₁₂ hg₁ hDom₁ hdvd => ?_⟩
    have hnot_X1 := (hPart2 c₁ g₁ hg₁ hDom₁).2.2
    apply hnot_X1
    have hmem₂ : ψ (L c₂) ∈ Ideal.span ({ψ (L c₁)} : Set S) := Ideal.mem_span_singleton.mpr hdvd
    have hmem₁ : ψ (L c₁) ∈ Ideal.span ({ψ (L c₁)} : Set S) := Ideal.subset_span rfl
    have hdiff_poly :
        L c₁ - L c₂ =
          MvPolynomial.C (c₂ - c₁) * (MvPolynomial.X 1 - MvPolynomial.C (a 1)) := by
      dsimp [L]
      rw [map_sub]
      ring
    have hsub_eq :
        ψ (MvPolynomial.C (c₂ - c₁)) * ψ (MvPolynomial.X 1 - MvPolynomial.C (a 1)) =
          ψ (L c₁) - ψ (L c₂) := by
      rw [← map_mul, ← hdiff_poly, map_sub]
    have hdiff_mem :
        ψ (MvPolynomial.C (c₂ - c₁)) * ψ (MvPolynomial.X 1 - MvPolynomial.C (a 1)) ∈
          Ideal.span ({ψ (L c₁)} : Set S) := by
      rw [hsub_eq]
      exact Ideal.sub_mem _ hmem₁ hmem₂
    have hc_ne : c₂ - c₁ ≠ 0 := sub_ne_zero.mpr hc₁₂.symm
    have hmul_inv :
        ψ (MvPolynomial.C (c₂ - c₁)⁻¹) *
          (ψ (MvPolynomial.C (c₂ - c₁)) * ψ (MvPolynomial.X 1 - MvPolynomial.C (a 1))) =
          ψ (MvPolynomial.X 1 - MvPolynomial.C (a 1)) := by
      rw [← mul_assoc, ← map_mul, ← MvPolynomial.C_mul, inv_mul_cancel₀ hc_ne,
        MvPolynomial.C_1, map_one, one_mul]
    rw [← hmul_inv]
    exact Ideal.mul_mem_left _ _ hdiff_mem

  
  have hMain :
      ∀ (n : ℕ)
        (V₀ : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine V₀] [AlgebraicGeometry.IsIntegral V₀]
        (u₀ : Quiver.Hom V₀ (weilAffineSpaceOver k (n + 1)).left) [AlgebraicGeometry.Etale u₀]
        (v₀ : ↥V₀) (_ : IsClosed ({v₀} : Set ↥V₀))
        (O_good : Set ↥V₀) (_ : IsOpen O_good)
        (_ : O_good.Nonempty) (_ : v₀ ∉ O_good),
        ∃ (C_aff : AlgebraicGeometry.Scheme.{u})
          (_ : AlgebraicGeometry.IsAffine C_aff)
          (_ : AlgebraicGeometry.IsIntegral C_aff)
          (ι_C : Quiver.Hom C_aff V₀)
          (u_C : Quiver.Hom C_aff (weilAffineSpaceOver k 1).left)
          (c₀ : ↥C_aff),
          AlgebraicGeometry.Etale u_C ∧
          CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom =
            CategoryTheory.CategoryStruct.comp ι_C
              (CategoryTheory.CategoryStruct.comp u₀ (weilAffineSpaceOver k (n + 1)).hom) ∧
          IsClosed ({c₀} : Set ↥C_aff) ∧
          ι_C.base c₀ = v₀ ∧
          (ι_C.base ⁻¹' O_good).Nonempty := by
    intro n
    induction n with
    | zero =>
      intro V₀ _ _ u₀ _ v₀ hv₀ O_good _ hO_ne _
      exact ⟨V₀, inferInstance, inferInstance, CategoryTheory.CategoryStruct.id V₀, u₀, v₀,
        inferInstance, (CategoryTheory.Category.id_comp _).symm, hv₀, rfl, hO_ne⟩
    | succ m ih =>
      intro V₀ _ _ u₀ _ v₀ hv₀ O_good hO_open hO_ne hv₀_not
      let R_cat := V₀.presheaf.obj (Opposite.op ⊤)
      let R : Type u := ↑R_cat
      have : IsDomain R := (inferInstance : IsDomain ↑(V₀.presheaf.obj (Opposite.op ⊤)))
      let e_V : V₀ ≅ AlgebraicGeometry.Spec R_cat := V₀.isoSpec
      have : AlgebraicGeometry.Etale e_V.inv := inferInstance
      have hEt_eu : AlgebraicGeometry.Etale (e_V.inv ≫ u₀) := inferInstance
      let φ_cat : CommRingCat.of (MvPolynomial (Fin (m + 2)) k) ⟶ R_cat :=
        AlgebraicGeometry.Spec.preimage (e_V.inv ≫ u₀)
      let φ : MvPolynomial (Fin (m + 2)) k →+* R := φ_cat.hom
      have hφ_map : AlgebraicGeometry.Spec.map φ_cat = e_V.inv ≫ u₀ :=
        AlgebraicGeometry.Spec.map_preimage (e_V.inv ≫ u₀)
      have hφ_et : RingHom.Etale φ := by
        rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
          hφ_map]
        exact hEt_eu

      
      let x₀_pt : ↥(AlgebraicGeometry.Spec R_cat) := e_V.hom.base v₀
      let x₀_spec : PrimeSpectrum R := x₀_pt
      have hx₀_pre :
          ({x₀_pt} : Set ↥(AlgebraicGeometry.Spec R_cat)) = e_V.inv.base ⁻¹' ({v₀} : Set ↥V₀) := by
        ext z
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl
          change (e_V.hom ≫ e_V.inv).base v₀ = v₀
          rw [e_V.hom_inv_id]
          rfl
        · intro hz
          dsimp [x₀_pt]
          rw [← hz]
          change z = (e_V.inv ≫ e_V.hom).base z
          rw [e_V.inv_hom_id]
          rfl
      have hx₀_cl : IsClosed ({x₀_spec} : Set (PrimeSpectrum R)) := by
        change IsClosed ({x₀_pt} : Set ↥(AlgebraicGeometry.Spec R_cat))
        rw [hx₀_pre]
        exact hv₀.preimage e_V.inv.continuous
      let 𝔪₀ : Ideal R := x₀_spec.asIdeal
      have : 𝔪₀.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal x₀_spec).mp hx₀_cl

      
      have hFT_Noeth_Eval :
          IsNoetherianRing R ∧
          ∃ ε₀ : R →+* k,
            (∀ b : k, ε₀ (φ (MvPolynomial.C b)) = b) ∧
            𝔪₀ = RingHom.ker ε₀ := by
        let _ : Algebra (MvPolynomial (Fin (m + 2)) k) R := φ.toAlgebra
        have : Algebra.Etale (MvPolynomial (Fin (m + 2)) k) R := RingHom.etale_algebraMap.mp hφ_et
        let _ : Algebra k R := (φ.comp MvPolynomial.C).toAlgebra
        have : IsScalarTower k (MvPolynomial (Fin (m + 2)) k) R :=
          IsScalarTower.of_algebraMap_eq' rfl
        have : Algebra.FiniteType k (MvPolynomial (Fin (m + 2)) k) := inferInstance
        have : Algebra.FiniteType (MvPolynomial (Fin (m + 2)) k) R := inferInstance
        have hFT_kR : Algebra.FiniteType k R :=
          Algebra.FiniteType.trans
            ‹Algebra.FiniteType k (MvPolynomial (Fin (m + 2)) k)›
            ‹Algebra.FiniteType (MvPolynomial (Fin (m + 2)) k) R›
        have hNoethR : IsNoetherianRing R := Algebra.FiniteType.isNoetherianRing k R
        obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_kR
        let q_hom : MvPolynomial (Fin n_mv) k →+* R := q_mv.toRingHom
        let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom 𝔪₀
        have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_surj
        obtain ⟨a_pt, ha_pt⟩ :=
          (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
        let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
        have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
          intro f_p hf_p
          rw [RingHom.mem_ker] at hf_p
          have hmem : f_p ∈ m_mv := by
            change q_hom f_p ∈ 𝔪₀
            rw [hf_p]
            exact 𝔪₀.zero_mem
          rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
        let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_surj
        let ε₀ : R →+* k :=
          (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
        have hε₀_q : ∀ f_p : MvPolynomial (Fin n_mv) k, ε₀ (q_hom f_p) = ev_hom f_p := by
          intro f_p
          dsimp [ε₀]
          have heq_q : e_quot.symm (q_hom f_p) = Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
            apply e_quot.injective
            simp [e_quot]
          rw [heq_q, Ideal.Quotient.lift_mk]
        have hε₀_C : ∀ b : k, ε₀ (φ (MvPolynomial.C b)) = b := by
          intro b
          change ε₀ (algebraMap k R b) = b
          rw [← q_mv.commutes b]
          change ε₀ (q_hom (MvPolynomial.C b)) = b
          rw [hε₀_q]
          exact (MvPolynomial.aeval a_pt).commutes b
        have h𝔪₀_ker : 𝔪₀ = RingHom.ker ε₀ := by
          ext r
          obtain ⟨f_p, rfl⟩ := hq_surj r
          change q_hom f_p ∈ 𝔪₀ ↔ ε₀ (q_hom f_p) = 0
          rw [hε₀_q]
          change q_hom f_p ∈ 𝔪₀ ↔ MvPolynomial.aeval a_pt f_p = 0
          rw [← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← ha_pt]
          rfl
        exact ⟨hNoethR, ε₀, hε₀_C, h𝔪₀_ker⟩
      obtain ⟨hNoethR, ε₀, hε₀_C, h𝔪₀_ker⟩ := hFT_Noeth_Eval
      have : IsNoetherianRing R := hNoethR

      
      let O_R : Set (PrimeSpectrum R) := e_V.inv.base ⁻¹' O_good
      have hOR_open : IsOpen O_R := hO_open.preimage e_V.inv.continuous
      obtain ⟨y₀, hy₀⟩ := hO_ne
      have hy₀_OR : (e_V.hom.base y₀ : PrimeSpectrum R) ∈ O_R := by
        change (e_V.hom ≫ e_V.inv).base y₀ ∈ O_good
        rwa [e_V.hom_inv_id]
      obtain ⟨_, ⟨f_bad, rfl⟩, hy₀_fbad, hfbad_sub⟩ :=
        TopologicalSpace.IsTopologicalBasis.exists_subset_of_mem_open
          PrimeSpectrum.isTopologicalBasis_basic_opens hy₀_OR hOR_open
      have hfbad_ne : f_bad ≠ 0 := by
        intro h0
        apply hy₀_fbad
        rw [h0]
        exact (e_V.hom.base y₀ : PrimeSpectrum R).asIdeal.zero_mem

      
      let a : Fin (m + 2) → k := fun i => ε₀ (φ (MvPolynomial.X i))
      let L : k → MvPolynomial (Fin (m + 2)) k := fun c =>
        MvPolynomial.X 0 -
          (MvPolynomial.C (a 0) + MvPolynomial.C c * (MvPolynomial.X 1 - MvPolynomial.C (a 1)))
      let q_slice : ∀ c : k, R →+* (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
        fun c => Ideal.Quotient.mk (Ideal.span ({φ (L c)} : Set R))
      let φ_slice : ∀ c : k,
          MvPolynomial (Fin (m + 1)) k →+* (R ⧸ Ideal.span ({φ (L c)} : Set R)) :=
        fun c => (q_slice c).comp (φ.comp (MvPolynomial.rename Fin.succ).toRingHom)
      obtain ⟨hSlice1, hSlice2, hSlice3⟩ := hSlice m R φ hφ_et ε₀ hε₀_C 𝔪₀ h𝔪₀_ker

      
      have hChartPerSlope :
          ∀ c : k,
            ∃ (g : R) (w_g : ↥(AlgebraicGeometry.Spec
                (CommRingCat.of (Localization.Away (q_slice c g))))),
              g ∉ 𝔪₀ ∧
              IsDomain (Localization.Away (q_slice c g)) ∧
              IsClosed ({w_g} : Set ↥(AlgebraicGeometry.Spec
                (CommRingCat.of (Localization.Away (q_slice c g))))) ∧
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                ((algebraMap (R ⧸ Ideal.span ({φ (L c)} : Set R))
                  (Localization.Away (q_slice c g))).comp (q_slice c)))).base w_g = x₀_spec := by
        intro c
        have hker_Lc : Ideal.span ({φ (L c)} : Set R) ≤ RingHom.ker ε₀ := by
          rw [Ideal.span_le]
          rintro _ rfl
          rw [← h𝔪₀_ker]
          exact (hSlice1 c).1
        let R_c := R ⧸ Ideal.span ({φ (L c)} : Set R)
        let ε_c : R_c →+* k := Ideal.Quotient.lift (Ideal.span ({φ (L c)} : Set R)) ε₀ hker_Lc
        have hεc_mk : ∀ r : R, ε_c (q_slice c r) = ε₀ r := fun _ => Ideal.Quotient.lift_mk _ _ _
        have hεc_surj : Function.Surjective ε_c := fun b =>
          ⟨q_slice c (φ (MvPolynomial.C b)), (hεc_mk _).trans (hε₀_C b)⟩
        let W_c := AlgebraicGeometry.Spec (CommRingCat.of R_c)
        let u_Wc : W_c ⟶ (weilAffineSpaceOver k (m + 1)).left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_slice c))
        have : AlgebraicGeometry.Etale u_Wc :=
          (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
            (hSlice1 c).2
        obtain ⟨hx_c_cl, hShrink_Wc⟩ := hSpecShrink R_c ε_c hεc_surj
        let x_c : ↥W_c :=
          (⟨RingHom.ker ε_c, (RingHom.ker_isMaximal_of_surjective ε_c hεc_surj).isPrime⟩ :
            PrimeSpectrum R_c)
        obtain ⟨U_c, _, hx_Uc, hInt_Uc⟩ := hPtDom (m + 1) W_c u_Wc x_c hx_c_cl
        obtain ⟨g_bar, hgbar_not, hDom_gbar, w_gbar, hw_cl, hw_map⟩ :=
          hShrink_Wc U_c hx_Uc hInt_Uc
        obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective g_bar
        have hg_not_m0 : g ∉ 𝔪₀ := by
          intro hg_m0
          apply hgbar_not
          change ε_c (q_slice c g) = 0
          rw [hεc_mk]
          exact RingHom.mem_ker.mp (h𝔪₀_ker ▸ hg_m0)
        have hw_to_x0 :
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((algebraMap R_c (Localization.Away (q_slice c g))).comp (q_slice c)))).base w_gbar =
              x₀_spec := by
          have hcomp_map :
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                ((algebraMap R_c (Localization.Away (q_slice c g))).comp (q_slice c))) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (algebraMap R_c (Localization.Away (q_slice c g)))) ≫
                AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_slice c)) :=
            AlgebraicGeometry.Spec.map_comp
              (CommRingCat.ofHom (q_slice c))
              (CommRingCat.ofHom (algebraMap R_c (Localization.Away (q_slice c g))))
          rw [hcomp_map]
          change (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (q_slice c))).base
            ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              (algebraMap R_c (Localization.Away (q_slice c g))))).base w_gbar) = x₀_spec
          rw [hw_map]
          apply PrimeSpectrum.ext
          ext r
          change q_slice c r ∈ RingHom.ker ε_c ↔ r ∈ 𝔪₀
          rw [h𝔪₀_ker, RingHom.mem_ker, RingHom.mem_ker, hεc_mk]
        exact ⟨g, w_gbar, hg_not_m0, hDom_gbar, hw_cl, hw_to_x0⟩

      let g_fn : k → R := fun c => Classical.choose (hChartPerSlope c)
      have hg_spec := fun c : k => Classical.choose_spec (hChartPerSlope c)

      
      let S := Localization.AtPrime 𝔪₀
      have : IsDomain S :=
        IsLocalization.isDomain_of_le_nonZeroDivisors S 𝔪₀.primeCompl_le_nonZeroDivisors
      have : IsNoetherianRing S := IsLocalization.isNoetherianRing 𝔪₀.primeCompl S hNoethR
      have : Infinite k := IsAlgClosed.instInfinite
      have hfbad_S_ne : algebraMap R S f_bad ≠ 0 := by
        intro h0
        exact hfbad_ne
          (IsLocalization.injective S 𝔪₀.primeCompl_le_nonZeroDivisors
            (h0.trans (map_zero _).symm))
      let p_fam : k → S := fun c => algebraMap R S (φ (L c))
      have hp_prime : ∀ c : k, Prime (p_fam c) := fun c =>
        (hSlice2 c (g_fn c) (Classical.choose_spec (hg_spec c)).1
          (Classical.choose_spec (hg_spec c)).2.1).1
      have hp_ndvd : ∀ c₁ c₂ : k, c₁ ≠ c₂ → ¬ (p_fam c₁ ∣ p_fam c₂) := fun c₁ c₂ hc =>
        hSlice3 c₁ c₂ (g_fn c₁) hc (Classical.choose_spec (hg_spec c₁)).1
          (Classical.choose_spec (hg_spec c₁)).2.1
      obtain ⟨c_star, hc_star_ndvd⟩ :=
        hNoethPrimes S k p_fam hp_prime hp_ndvd (algebraMap R S f_bad) hfbad_S_ne

      let g_star : R := g_fn c_star
      let w_star := Classical.choose (hg_spec c_star)
      obtain ⟨hg_star_not, hDom_Astar, hw_star_cl, hw_star_x0⟩ :=
        Classical.choose_spec (hg_spec c_star)
      let R_star := R ⧸ Ideal.span ({φ (L c_star)} : Set R)
      let A_star := Localization.Away (q_slice c_star g_star)
      have : IsDomain A_star := hDom_Astar
      have hfbad_Astar_ne : algebraMap R_star A_star (q_slice c_star f_bad) ≠ 0 := by
        intro h0
        exact hc_star_ndvd
          ((hSlice2 c_star g_star hg_star_not hDom_Astar).2.1 f_bad h0)

      
      let V₁ : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of A_star)
      have : AlgebraicGeometry.IsAffine V₁ := inferInstance
      have : AlgebraicGeometry.IsIntegral V₁ := inferInstance
      let α_star : R_cat ⟶ CommRingCat.of A_star :=
        CommRingCat.ofHom ((algebraMap R_star A_star).comp (q_slice c_star))
      let ι₁ : V₁ ⟶ V₀ := AlgebraicGeometry.Spec.map α_star ≫ e_V.inv
      let u₁ : V₁ ⟶ (weilAffineSpaceOver k (m + 1)).left :=
        AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom ((algebraMap R_star A_star).comp (φ_slice c_star)))
      have hEt_Astar : RingHom.Etale ((algebraMap R_star A_star).comp (φ_slice c_star)) :=
        RingHom.Etale.stableUnderComposition (φ_slice c_star) (algebraMap R_star A_star)
          (hSlice1 c_star).2 (RingHom.etale_algebraMap.mpr inferInstance)
      have : AlgebraicGeometry.Etale u₁ :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr
          hEt_Astar
      let v₁ : ↥V₁ := w_star
      have hv₁_cl : IsClosed ({v₁} : Set ↥V₁) := hw_star_cl
      have hι₁_v₁ : ι₁.base v₁ = v₀ := by
        change e_V.inv.base ((AlgebraicGeometry.Spec.map α_star).base w_star) = v₀
        have hmap_x0 : (AlgebraicGeometry.Spec.map α_star).base w_star = x₀_pt := hw_star_x0
        rw [hmap_x0]
        change (e_V.hom ≫ e_V.inv).base v₀ = v₀
        rw [e_V.hom_inv_id]
        rfl
      have hu₁_comm :
          CategoryTheory.CategoryStruct.comp u₁ (weilAffineSpaceOver k (m + 1)).hom =
            CategoryTheory.CategoryStruct.comp ι₁
              (CategoryTheory.CategoryStruct.comp u₀ (weilAffineSpaceOver k (m + 2)).hom) := by
        have hring_comm :
            CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (m + 1)) k) ≫
              CommRingCat.ofHom ((algebraMap R_star A_star).comp (φ_slice c_star)) =
            (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (m + 2)) k) ≫ φ_cat) ≫
              α_star := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro b
          change algebraMap R_star A_star
              (q_slice c_star (φ (MvPolynomial.rename Fin.succ (MvPolynomial.C b)))) =
            algebraMap R_star A_star (q_slice c_star (φ (MvPolynomial.C b)))
          rw [MvPolynomial.rename_C]
        calc
          u₁ ≫ (weilAffineSpaceOver k (m + 1)).hom
            = AlgebraicGeometry.Spec.map
                (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (m + 1)) k) ≫
                  CommRingCat.ofHom ((algebraMap R_star A_star).comp (φ_slice c_star))) := by
                exact (AlgebraicGeometry.Spec.map_comp _ _).symm
          _ = AlgebraicGeometry.Spec.map
                ((CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial (Fin (m + 2)) k) ≫
                  φ_cat) ≫ α_star) := by
                rw [hring_comm]
          _ = AlgebraicGeometry.Spec.map α_star ≫
                (AlgebraicGeometry.Spec.map φ_cat ≫ (weilAffineSpaceOver k (m + 2)).hom) := by
                rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_comp]
                rfl
          _ = AlgebraicGeometry.Spec.map α_star ≫
                ((e_V.inv ≫ u₀) ≫ (weilAffineSpaceOver k (m + 2)).hom) :=
                congrArg (fun f : AlgebraicGeometry.Spec R_cat ⟶
                    (weilAffineSpaceOver k (m + 2)).left =>
                  AlgebraicGeometry.Spec.map α_star ≫
                    (f ≫ (weilAffineSpaceOver k (m + 2)).hom)) hφ_map
          _ = ι₁ ≫ (u₀ ≫ (weilAffineSpaceOver k (m + 2)).hom) := by
                dsimp [ι₁]
                simp only [CategoryTheory.Category.assoc]
      let O₁ : Set ↥V₁ := ι₁.base ⁻¹' O_good
      have hO₁_open : IsOpen O₁ := hO_open.preimage ι₁.continuous
      have hv₁_not : v₁ ∉ O₁ := by
        change ι₁.base v₁ ∉ O_good
        rw [hι₁_v₁]
        exact hv₀_not
      have hO₁_ne : O₁.Nonempty := by
        have hbot_prime : (⊥ : Ideal A_star).IsPrime :=
          ⟨bot_ne_top, fun hxy =>
            (mul_eq_zero.mp (Ideal.mem_bot.mp hxy)).imp Ideal.mem_bot.mpr Ideal.mem_bot.mpr⟩
        let η₁ : PrimeSpectrum A_star := ⟨⊥, hbot_prime⟩
        refine ⟨(η₁ : ↥V₁), ?_⟩
        change e_V.inv.base ((AlgebraicGeometry.Spec.map α_star).base η₁) ∈ O_good
        apply hfbad_sub
        change f_bad ∉ ((AlgebraicGeometry.Spec.map α_star).base η₁ : PrimeSpectrum R).asIdeal
        change algebraMap R_star A_star (q_slice c_star f_bad) ∉ (⊥ : Ideal A_star)
        rw [Ideal.mem_bot]
        exact hfbad_Astar_ne

      
      obtain ⟨C_aff, hAff_C, hInt_C, ι_C', u_C, c₀, hEt_uC, hcomm', hc₀_cl, hc₀_map', hHit'⟩ :=
        ih V₁ u₁ v₁ hv₁_cl O₁ hO₁_open hO₁_ne hv₁_not
      refine ⟨C_aff, hAff_C, hInt_C, CategoryTheory.CategoryStruct.comp ι_C' ι₁, u_C, c₀,
        hEt_uC, ?_, hc₀_cl, ?_, hHit'⟩
      · rw [hcomm', CategoryTheory.Category.assoc, hu₁_comm]
      · change ι₁.base (ι_C'.base c₀) = v₀
        rw [hc₀_map', hι₁_v₁]

  
  cases δ with
  | zero =>
    exfalso
    let R_cat := V₀.presheaf.obj (Opposite.op ⊤)
    let R : Type u := ↑R_cat
    have : IsDomain R := (inferInstance : IsDomain ↑(V₀.presheaf.obj (Opposite.op ⊤)))
    let e_V : V₀ ≅ AlgebraicGeometry.Spec R_cat := V₀.isoSpec
    have : AlgebraicGeometry.Etale e_V.inv := inferInstance
    have hEt_eu0 : AlgebraicGeometry.Etale (e_V.inv ≫ u₀) := inferInstance
    let φ₀_cat : CommRingCat.of (MvPolynomial (Fin 0) k) ⟶ R_cat :=
      AlgebraicGeometry.Spec.preimage (e_V.inv ≫ u₀)
    have hφ₀_et : RingHom.Etale φ₀_cat.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale),
        AlgebraicGeometry.Spec.map_preimage]
      exact hEt_eu0
    let e_empty : k ≃+* MvPolynomial (Fin 0) k := (MvPolynomial.isEmptyRingEquiv k (Fin 0)).symm
    let φ_k : k →+* R := φ₀_cat.hom.comp e_empty.toRingHom
    have hφk_et : RingHom.Etale φ_k :=
      RingHom.Etale.respectsIso.right φ₀_cat.hom e_empty hφ₀_et
    let _ : Algebra k R := φ_k.toAlgebra
    have : Algebra.Etale k R := RingHom.etale_algebraMap.mp hφk_et
    obtain ⟨I_idx, hFin_I, Ai, _, _, e_prod, hAi_props⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod k R).mp ‹Algebra.Etale k R›
    have : Finite I_idx := hFin_I
    have : ∀ i : I_idx, Module.Finite k (Ai i) := fun i => (hAi_props i).1
    have : Module.Finite k ((i : I_idx) → Ai i) := Module.Finite.pi
    have : Module.Finite k R := Module.Finite.equiv e_prod.symm.toLinearEquiv
    have : Algebra.IsIntegral k R := Algebra.IsIntegral.of_finite k R
    have hField_R : IsField R :=
      (Algebra.IsIntegral.isField_iff_isField (RingHom.injective (algebraMap k R))).mp
        (Field.toIsField k)
    have hSub_Spec : Subsingleton (PrimeSpectrum R) := by
      let _ : Field R := hField_R.toField
      infer_instance
    obtain ⟨y, hy⟩ := hO_ne
    have hy_eq : y = v₀ := by
      have h_im : (e_V.hom.base y : PrimeSpectrum R) = (e_V.hom.base v₀ : PrimeSpectrum R) :=
        @Subsingleton.elim (PrimeSpectrum R) hSub_Spec _ _
      have h_inv := congrArg e_V.inv.base h_im
      change (e_V.hom ≫ e_V.inv).base y = (e_V.hom ≫ e_V.inv).base v₀ at h_inv
      rwa [e_V.hom_inv_id] at h_inv
    exact hv₀_not (hy_eq ▸ hy)
  | succ n =>
    exact hMain n V₀ u₀ v₀ hv₀ O_good hO_open hO_ne hv₀_not

theorem weil_rel_smooth_curve_section_two_open_uniformizer_chart (V₀ : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V₀] [AlgebraicGeometry.IsIntegral V₀]
    (v₀ : ↥V₀)
    (Y₀ : AlgebraicGeometry.Scheme.{u})
    (f₀ : Quiver.Hom Y₀ V₀)
    [AlgebraicGeometry.IsSeparated f₀]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f₀]
    (τ₀ : Quiver.Hom V₀ Y₀)
    (hτ₀_sec : CategoryTheory.CategoryStruct.comp τ₀ f₀ = CategoryTheory.CategoryStruct.id V₀)
    (hτ₀_cl : AlgebraicGeometry.IsClosedImmersion τ₀) :
    ∃ (V₁ : V₀.Opens)
      (_ : AlgebraicGeometry.IsAffineOpen V₁)
      (_ : v₀ ∈ V₁)
      (_ : AlgebraicGeometry.IsIntegral V₁.toScheme),
      let Y₁ := CategoryTheory.Limits.pullback f₀ V₁.ι
      let f₁ := CategoryTheory.Limits.pullback.snd f₀ V₁.ι
      ∃ (U₁ U₂ : Y₁.Opens)
        (g_sec : ↑(Y₁.presheaf.obj (Opposite.op U₁)))
        (u₁₂ : Units ↑(Y₁.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))),
        U₁ ⊔ U₂ = ⊤ ∧
        (Y₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
          (u₁₂ : ↑(Y₁.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) ∧
        ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V₁.toScheme)
          (Y_Ω : AlgebraicGeometry.Scheme.{u})
          (ι_Ω : Quiver.Hom Y_Ω Y₁)
          (f_Ω : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
          CategoryTheory.IsPullback ι_Ω f_Ω f₁ s_Ω →
          ∃ (P_Ω : ↥Y_Ω)
            (_ : IsClosed ({P_Ω} : Set ↥Y_Ω))
            (hP_mem : P_Ω ∈ (TopologicalSpace.Opens.map ι_Ω.base).obj U₁),
            ((TopologicalSpace.Opens.map ι_Ω.base).obj U₂ : Set ↥Y_Ω) = ({P_Ω} : Set ↥Y_Ω)ᶜ ∧
            Ideal.span
              {(Y_Ω.presheaf.germ ((TopologicalSpace.Opens.map ι_Ω.base).obj U₁) P_Ω hP_mem).hom
                ((ι_Ω.app U₁).hom g_sec)} =
              IsLocalRing.maximalIdeal ↑(Y_Ω.presheaf.stalk P_Ω) :=
by
  classical
  let _ := hτ₀_cl

  
  have hAffPullbackTensor :
      ∀ {V Y V' Y' : AlgebraicGeometry.Scheme.{u}}
        [AlgebraicGeometry.IsAffine V] [AlgebraicGeometry.IsAffine V']
        (p : Y' ⟶ Y) (f' : Y' ⟶ V') (f : Y ⟶ V) (g : V' ⟶ V)
        (hPb : CategoryTheory.IsPullback p f' f g)
        (O_V : V.Opens) (hAff_OV : AlgebraicGeometry.IsAffineOpen O_V)
        (O_Y : Y.Opens) (hAff_OY : AlgebraicGeometry.IsAffineOpen O_Y)
        (he_Y : O_Y ≤ (TopologicalSpace.Opens.map f.base).obj O_V)
        (he_g : (⊤ : V'.Opens) ≤ (TopologicalSpace.Opens.map g.base).obj O_V)
        [Algebra ↑(V.presheaf.obj (Opposite.op O_V)) ↑(Y.presheaf.obj (Opposite.op O_Y))]
        [Algebra ↑(V.presheaf.obj (Opposite.op O_V)) ↑(V'.presheaf.obj (Opposite.op ⊤))],
        algebraMap ↑(V.presheaf.obj (Opposite.op O_V)) ↑(Y.presheaf.obj (Opposite.op O_Y)) =
          (f.appLE O_V O_Y he_Y).hom →
        algebraMap ↑(V.presheaf.obj (Opposite.op O_V)) ↑(V'.presheaf.obj (Opposite.op ⊤)) =
          (g.appLE O_V ⊤ he_g).hom →
        let O_Y' : Y'.Opens := (TopologicalSpace.Opens.map p.base).obj O_Y
        ∃ (hAff_OY' : AlgebraicGeometry.IsAffineOpen O_Y')
          (Θ : TensorProduct ↑(V.presheaf.obj (Opposite.op O_V))
            ↑(Y.presheaf.obj (Opposite.op O_Y))
            ↑(V'.presheaf.obj (Opposite.op ⊤)) ≃+*
            ↑(Y'.presheaf.obj (Opposite.op O_Y'))),
          (∀ r : ↑(Y.presheaf.obj (Opposite.op O_Y)),
            Θ (r ⊗ₜ 1) = (p.app O_Y).hom r) ∧
          (∀ a' : ↑(V'.presheaf.obj (Opposite.op ⊤)),
            Θ (1 ⊗ₜ a') = (f'.appLE ⊤ O_Y' (fun _ _ => trivial)).hom a') := by
    intro V Y V' Y' _ _ p f' f g hPb O_V hAff_OV O_Y hAff_OY he_Y he_g _ _ halgR halgA
    let O_Y' : Y'.Opens := (TopologicalSpace.Opens.map p.base).obj O_Y
    have : AlgebraicGeometry.IsAffineHom g := AlgebraicGeometry.isAffineHom_of_isAffine g
    have : AlgebraicGeometry.IsAffineHom p :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip inferInstance
    have hAff_OY' : AlgebraicGeometry.IsAffineOpen O_Y' := hAff_OY.preimage p
    have hAff_topV' : AlgebraicGeometry.IsAffineOpen (⊤ : V'.Opens) :=
      AlgebraicGeometry.isAffineOpen_top V'
    let A₀_cat := V.presheaf.obj (Opposite.op O_V)
    let R₀_cat := Y.presheaf.obj (Opposite.op O_Y)
    let A'_cat := V'.presheaf.obj (Opposite.op ⊤)
    let R'_cat := Y'.presheaf.obj (Opposite.op O_Y')
    let φ_f : A₀_cat ⟶ R₀_cat := CommRingCat.ofHom (algebraMap ↑A₀_cat ↑R₀_cat)
    let φ_g : A₀_cat ⟶ A'_cat := CommRingCat.ofHom (algebraMap ↑A₀_cat ↑A'_cat)
    let φ_p : R₀_cat ⟶ R'_cat := p.appLE O_Y O_Y' le_rfl
    let φ_f' : A'_cat ⟶ R'_cat := f'.appLE ⊤ O_Y' (fun _ _ => trivial)
    have hφ_f_eq : φ_f = f.appLE O_V O_Y he_Y := by
      ext x; exact DFunLike.congr_fun halgR x
    have hφ_g_eq : φ_g = g.appLE O_V ⊤ he_g := by
      ext x; exact DFunLike.congr_fun halgA x
    have hf_sq : AlgebraicGeometry.Spec.map φ_f ≫ hAff_OV.fromSpec = hAff_OY.fromSpec ≫ f := by
      rw [hφ_f_eq]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f hAff_OV hAff_OY he_Y
    have hg_sq : AlgebraicGeometry.Spec.map φ_g ≫ hAff_OV.fromSpec = hAff_topV'.fromSpec ≫ g := by
      rw [hφ_g_eq]
      exact AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec g hAff_OV hAff_topV' he_g
    have hp_sq : AlgebraicGeometry.Spec.map φ_p ≫ hAff_OY.fromSpec = hAff_OY'.fromSpec ≫ p :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec p hAff_OY hAff_OY' le_rfl
    have hf'_sq : AlgebraicGeometry.Spec.map φ_f' ≫ hAff_topV'.fromSpec = hAff_OY'.fromSpec ≫ f' :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec f' hAff_topV' hAff_OY'
        (fun _ _ => trivial)
    have hcomm_spec :
        AlgebraicGeometry.Spec.map φ_p ≫ AlgebraicGeometry.Spec.map φ_f =
          AlgebraicGeometry.Spec.map φ_f' ≫ AlgebraicGeometry.Spec.map φ_g := by
      apply (cancel_mono hAff_OV.fromSpec).mp
      rw [Category.assoc, hf_sq, ← Category.assoc, hp_sq, Category.assoc, hPb.w,
        Category.assoc, hg_sq, ← Category.assoc, ← hf'_sq, Category.assoc]
    have hcone_w :
        ∀ c : CategoryTheory.Limits.PullbackCone
            (AlgebraicGeometry.Spec.map φ_f) (AlgebraicGeometry.Spec.map φ_g),
          (c.fst ≫ hAff_OY.fromSpec) ≫ f = (c.snd ≫ hAff_topV'.fromSpec) ≫ g := by
      intro c
      rw [Category.assoc, ← hf_sq, ← Category.assoc, c.condition, Category.assoc, hg_sq,
        Category.assoc]
    have hcone_range :
        ∀ c : CategoryTheory.Limits.PullbackCone
            (AlgebraicGeometry.Spec.map φ_f) (AlgebraicGeometry.Spec.map φ_g),
          Set.range (hPb.lift (c.fst ≫ hAff_OY.fromSpec) (c.snd ≫ hAff_topV'.fromSpec)
            (hcone_w c)).base ⊆ Set.range hAff_OY'.fromSpec.base := by
      intro c
      rw [hAff_OY'.range_fromSpec]
      rintro _ ⟨t, rfl⟩
      change p.base ((hPb.lift (c.fst ≫ hAff_OY.fromSpec) (c.snd ≫ hAff_topV'.fromSpec)
        (hcone_w c)).base t) ∈ (O_Y : Set ↥Y)
      have hp_t : p.base ((hPb.lift (c.fst ≫ hAff_OY.fromSpec) (c.snd ≫ hAff_topV'.fromSpec)
          (hcone_w c)).base t) = hAff_OY.fromSpec.base (c.fst.base t) := by
        change ((hPb.lift (c.fst ≫ hAff_OY.fromSpec) (c.snd ≫ hAff_topV'.fromSpec)
          (hcone_w c)) ≫ p).base t = _
        rw [hPb.lift_fst]
        rfl
      rw [hp_t, ← hAff_OY.range_fromSpec]
      exact ⟨c.fst.base t, rfl⟩
    have hPb_spec : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map φ_p) (AlgebraicGeometry.Spec.map φ_f')
        (AlgebraicGeometry.Spec.map φ_f) (AlgebraicGeometry.Spec.map φ_g) := by
      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcomm_spec
          (fun c => AlgebraicGeometry.IsOpenImmersion.lift hAff_OY'.fromSpec
            (hPb.lift (c.fst ≫ hAff_OY.fromSpec) (c.snd ≫ hAff_topV'.fromSpec) (hcone_w c))
            (hcone_range c))
          (fun c => by
            apply (cancel_mono hAff_OY.fromSpec).mp
            rw [Category.assoc, hp_sq, ← Category.assoc,
              AlgebraicGeometry.IsOpenImmersion.lift_fac, hPb.lift_fst])
          (fun c => by
            apply (cancel_mono hAff_topV'.fromSpec).mp
            rw [Category.assoc, hf'_sq, ← Category.assoc,
              AlgebraicGeometry.IsOpenImmersion.lift_fac, hPb.lift_snd])
          (fun c m hm₁ hm₂ => by
            apply (cancel_mono hAff_OY'.fromSpec).mp
            rw [AlgebraicGeometry.IsOpenImmersion.lift_fac]
            apply hPb.hom_ext
            · rw [Category.assoc, ← hp_sq, ← Category.assoc, hm₁, hPb.lift_fst]
            · rw [Category.assoc, ← hf'_sq, ← Category.assoc, hm₂, hPb.lift_snd]))
    let e_spec : AlgebraicGeometry.Spec R'_cat ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct ↑A₀_cat ↑R₀_cat ↑A'_cat)) :=
      hPb_spec.isoPullback ≪≫ AlgebraicGeometry.pullbackSpecIso ↑A₀_cat ↑R₀_cat ↑A'_cat
    let ψ_fwd : CommRingCat.of (TensorProduct ↑A₀_cat ↑R₀_cat ↑A'_cat) ⟶ R'_cat :=
      AlgebraicGeometry.Spec.preimage e_spec.hom
    let ψ_bwd : R'_cat ⟶ CommRingCat.of (TensorProduct ↑A₀_cat ↑R₀_cat ↑A'_cat) :=
      AlgebraicGeometry.Spec.preimage e_spec.inv
    have hψ_fb : ψ_fwd ≫ ψ_bwd = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_spec.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    have hψ_bf : ψ_bwd ≫ ψ_fwd = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_spec.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    let Θ : TensorProduct ↑A₀_cat ↑R₀_cat ↑A'_cat ≃+* ↑R'_cat :=
      { toFun := ψ_fwd.hom
        invFun := ψ_bwd.hom
        left_inv := fun x => congrArg
          (fun g : CommRingCat.of (TensorProduct ↑A₀_cat ↑R₀_cat ↑A'_cat) ⟶
              CommRingCat.of (TensorProduct ↑A₀_cat ↑R₀_cat ↑A'_cat) => g.hom x) hψ_fb
        right_inv := fun y => congrArg (fun g : R'_cat ⟶ R'_cat => g.hom y) hψ_bf
        map_mul' := map_mul ψ_fwd.hom
        map_add' := map_add ψ_fwd.hom }
    have h_incL :
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
          (R := ↑A₀_cat) (A := ↑R₀_cat) (B := ↑A'_cat)) ≫ ψ_fwd = φ_p := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
      dsimp [e_spec, φ_f, φ_g]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_fst, hPb_spec.isoPullback_hom_fst]
    have h_incR :
        CommRingCat.ofHom (Algebra.TensorProduct.includeRight
          (R := ↑A₀_cat) (A := ↑R₀_cat) (B := ↑A'_cat)).toRingHom ≫ ψ_fwd = φ_f' := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage]
      dsimp [e_spec, φ_f, φ_g]
      rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_hom_snd, hPb_spec.isoPullback_hom_snd]
    have hφ_p_app : φ_p = p.app O_Y := by
      dsimp [φ_p, AlgebraicGeometry.Scheme.Hom.appLE]
      rw [Y'.presheaf.map_id, Category.comp_id]
    refine ⟨hAff_OY', Θ, ?_, ?_⟩
    · intro r
      change (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ ψ_fwd).hom r =
        (p.app O_Y).hom r
      rw [h_incL, hφ_p_app]
    · intro a'
      change (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ ψ_fwd).hom a' =
        φ_f'.hom a'
      rw [h_incR]

  
  have hNakayamaExcision :
      ∀ (A R : Type u) [CommRing A] [CommRing R]
        (φ : A →+* R) (μ : R →+* A)
        (hsec : μ.comp φ = RingHom.id A)
        (ψ : MvPolynomial (Fin 1) A →+* R)
        (hψ_comp : ψ.comp MvPolynomial.C = φ)
        (hψ_et : ψ.Etale),
        ∃ h : R,
          μ h = 1 ∧
          ∀ r : R, μ r = 0 →
            h * r ∈ Ideal.span {ψ (MvPolynomial.X 0) - φ (μ (ψ (MvPolynomial.X 0)))} := by
    intro A R _ _ φ μ hsec ψ hψ_comp hψ_et
    let B := MvPolynomial (Fin 1) A
    let c : A := μ (ψ (MvPolynomial.X 0))
    let g₀ : R := ψ (MvPolynomial.X 0) - φ c
    let Q := R ⧸ Ideal.span {g₀}
    let q₀ : R →+* Q := Ideal.Quotient.mk (Ideal.span {g₀})
    have hq₀_g₀ : q₀ g₀ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self g₀)
    have hq₀_X : q₀ (ψ (MvPolynomial.X 0)) = q₀ (φ c) := by
      have hsub : q₀ (ψ (MvPolynomial.X 0)) - q₀ (φ c) = 0 := by
        rw [← map_sub]
        exact hq₀_g₀
      exact sub_eq_zero.mp hsub
    have hEt_qφ : (q₀.comp φ).Etale := by
      let ε : B →+* A := MvPolynomial.eval₂Hom (RingHom.id A) (fun _ => c)
      let algBR : Algebra B R := ψ.toAlgebra
      let algBA : Algebra B A := ε.toAlgebra
      let algBQ : Algebra B Q := (q₀.comp ψ).toAlgebra
      have : Algebra.Etale B R := RingHom.etale_algebraMap.mp hψ_et
      have : Algebra.Etale A (TensorProduct B A R) := Algebra.Etale.baseChange B R A
      have hEt_incL : (Algebra.TensorProduct.includeLeftRingHom (R := B) (A := A) (B := R)).Etale :=
        RingHom.etale_algebraMap.mpr inferInstance
      have h_comm_AQ : (q₀.comp φ).comp ε = q₀.comp ψ := by
        apply MvPolynomial.ringHom_ext
        · intro a
          simp only [RingHom.comp_apply, ε, MvPolynomial.eval₂Hom_C, RingHom.id_apply]
          have hCa : ψ (MvPolynomial.C a) = φ a := DFunLike.congr_fun hψ_comp a
          rw [hCa]
        · intro i
          fin_cases i
          simp only [RingHom.comp_apply, ε, MvPolynomial.eval₂Hom_X']
          exact hq₀_X.symm
      let f_AQ : A →ₐ[B] Q :=
        { toRingHom := q₀.comp φ
          commutes' := fun p => DFunLike.congr_fun h_comm_AQ p }
      let f_RQ : R →ₐ[B] Q :=
        { toRingHom := q₀
          commutes' := fun _ => rfl }
      let Φ : TensorProduct B A R →+* Q := (Algebra.TensorProduct.productMap f_AQ f_RQ).toRingHom
      have h_kill_g₀ :
          ∀ r ∈ Ideal.span {g₀},
            (Algebra.TensorProduct.includeRight (R := B) (A := A) (B := R)).toRingHom r = 0 := by
        intro r hr
        rw [Ideal.mem_span_singleton] at hr
        rcases hr with ⟨b, rfl⟩
        rw [map_mul]
        have hg₀_zero :
            (Algebra.TensorProduct.includeRight (R := B) (A := A) (B := R)).toRingHom g₀ = 0 := by
          have hg₀_eq : g₀ = (MvPolynomial.X 0 - MvPolynomial.C c : B) • (1 : R) := by
            change g₀ = ψ (MvPolynomial.X 0 - MvPolynomial.C c) * 1
            rw [mul_one, map_sub]
            have hCc : ψ (MvPolynomial.C c) = φ c := DFunLike.congr_fun hψ_comp c
            rw [hCc]
          change (1 : A) ⊗ₜ[B] g₀ = 0
          rw [hg₀_eq, ← TensorProduct.smul_tmul]
          have hsmul_A : (MvPolynomial.X 0 - MvPolynomial.C c : B) • (1 : A) = 0 := by
            change ε (MvPolynomial.X 0 - MvPolynomial.C c) * 1 = 0
            dsimp [ε]
            rw [map_sub, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, RingHom.id_apply,
              sub_self, zero_mul]
          rw [hsmul_A, TensorProduct.zero_tmul]
        rw [hg₀_zero, zero_mul]
      let Ψ : Q →+* TensorProduct B A R :=
        Ideal.Quotient.lift (Ideal.span {g₀})
          (Algebra.TensorProduct.includeRight (R := B) (A := A) (B := R)).toRingHom h_kill_g₀
      have hΦΨ : ∀ q : Q, Φ (Ψ q) = q := by
        intro q
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
        change Φ (1 ⊗ₜ[B] r) = q₀ r
        simp [Φ, f_AQ, f_RQ]
      have hΨΦ : ∀ t : TensorProduct B A R, Ψ (Φ t) = t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => simp
        | tmul a r =>
          change 1 ⊗ₜ[B] (φ a * r) = a ⊗ₜ[B] r
          have ha_smul : a = (MvPolynomial.C a : B) • (1 : A) := by
            change a = ε (MvPolynomial.C a) * 1
            dsimp [ε]
            rw [MvPolynomial.eval₂Hom_C, RingHom.id_apply, mul_one]
          have hr_smul : φ a * r = (MvPolynomial.C a : B) • r := by
            change φ a * r = ψ (MvPolynomial.C a) * r
            have hCa : ψ (MvPolynomial.C a) = φ a := DFunLike.congr_fun hψ_comp a
            rw [hCa]
          rw [hr_smul, ← TensorProduct.smul_tmul, ← ha_smul]
        | add x y ihx ihy => simp [map_add, ihx, ihy]
      let e_TQ : TensorProduct B A R ≃+* Q :=
        { toFun := Φ
          invFun := Ψ
          left_inv := hΨΦ
          right_inv := hΦΨ
          map_mul' := map_mul Φ
          map_add' := map_add Φ }
      have hcomp_eq : e_TQ.toRingHom.comp
          (Algebra.TensorProduct.includeLeftRingHom (R := B) (A := A) (B := R)) = q₀.comp φ := by
        ext a
        change Φ (a ⊗ₜ[B] 1) = q₀ (φ a)
        simp [Φ, f_AQ, f_RQ]
      rw [← hcomp_eq]
      exact RingHom.Etale.respectsIso.1 _ e_TQ hEt_incL

    let algAQ : Algebra A Q := (q₀.comp φ).toAlgebra
    have : Algebra.Etale A Q := RingHom.etale_algebraMap.mp hEt_qφ
    have hμ_kill : ∀ r ∈ Ideal.span {g₀}, μ r = 0 := by
      intro r hr
      rw [Ideal.mem_span_singleton] at hr
      rcases hr with ⟨b, rfl⟩
      rw [map_mul]
      have hμ_g₀ : μ g₀ = 0 := by
        dsimp [g₀, c]
        rw [map_sub]
        have hμφc : μ (φ (μ (ψ (MvPolynomial.X 0)))) = μ (ψ (MvPolynomial.X 0)) :=
          DFunLike.congr_fun hsec _
        rw [hμφc, sub_self]
      rw [hμ_g₀, zero_mul]
    let μ_bar_ring : Q →+* A := Ideal.Quotient.lift (Ideal.span {g₀}) μ hμ_kill
    have hμ_bar_comm : ∀ a : A, μ_bar_ring (algebraMap A Q a) = a := by
      intro a
      change μ (φ a) = a
      exact DFunLike.congr_fun hsec a
    let μ_bar : Q →ₐ[A] A :=
      { toRingHom := μ_bar_ring
        commutes' := hμ_bar_comm }
    let I : Ideal Q := RingHom.ker μ_bar_ring

    
    have hI_le : (I : Submodule Q Q) ≤ I • (I : Submodule Q Q) := by
      let Q₂ := Q ⧸ (I ^ 2)
      let π₂ : Q →ₐ[A] Q₂ := Ideal.Quotient.mkₐ A (I ^ 2)
      let ρ₂ : Q →ₐ[A] Q₂ := (Algebra.ofId A Q₂).comp μ_bar
      let K : Ideal Q₂ := Ideal.map π₂.toRingHom I
      have hK_sq : K ^ 2 = ⊥ := by
        dsimp [K]
        rw [← Ideal.map_pow, eq_bot_iff, Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Ideal.mem_bot]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
      have h_mk_eq : (Ideal.Quotient.mkₐ A K).comp π₂ = (Ideal.Quotient.mkₐ A K).comp ρ₂ := by
        ext q
        change Ideal.Quotient.mk K (π₂ q) = Ideal.Quotient.mk K (ρ₂ q)
        rw [Ideal.Quotient.eq]
        have hq_sub : q - algebraMap A Q (μ_bar q) ∈ I := by
          change μ_bar_ring (q - algebraMap A Q (μ_bar q)) = 0
          rw [map_sub, hμ_bar_comm]
          exact sub_self (μ_bar_ring q)
        have hmap_sub : π₂.toRingHom (q - algebraMap A Q (μ_bar q)) ∈ K :=
          Ideal.mem_map_of_mem π₂.toRingHom hq_sub
        have heq_sub : π₂.toRingHom (q - algebraMap A Q (μ_bar q)) = π₂ q - ρ₂ q := by
          rw [map_sub]
          congr 1
        rwa [heq_sub] at hmap_sub
      have hπρ : π₂ = ρ₂ :=
        (Algebra.FormallyEtale.comp_bijective A Q K hK_sq).1 h_mk_eq
      have hsq_le : I ^ 2 ≤ I • (I : Submodule Q Q) := by
        rw [sq, Ideal.mul_le]
        intro a ha b hb
        exact Submodule.smul_mem_smul ha hb
      intro x hx
      apply hsq_le
      have hx0 : μ_bar x = 0 := hx
      have hπx : Ideal.Quotient.mk (I ^ 2) x = 0 := by
        change π₂ x = 0
        rw [hπρ]
        change algebraMap A Q₂ (μ_bar x) = 0
        rw [hx0, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp hπx

    
    have hI_fg : (I : Submodule Q Q).FG := by
      obtain ⟨n, F, hF_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
        (inferInstance : Algebra.FiniteType A Q)
      let z : Fin n → Q := fun i => F (MvPolynomial.X i) - algebraMap A Q (μ_bar (F (MvPolynomial.X i)))
      let S_fin : Finset Q := Finset.univ.image z
      let J : Ideal Q := Ideal.span (S_fin : Set Q)
      have hz_mem_I : ∀ i : Fin n, z i ∈ I := by
        intro i
        change μ_bar_ring (F (MvPolynomial.X i) - algebraMap A Q (μ_bar (F (MvPolynomial.X i)))) = 0
        rw [map_sub, hμ_bar_comm]
        exact sub_self (μ_bar_ring (F (MvPolynomial.X i)))
      have hJ_le_I : J ≤ I := by
        rw [Ideal.span_le]
        intro x hx
        rw [Finset.mem_coe, Finset.mem_image] at hx
        rcases hx with ⟨i, _, rfl⟩
        exact hz_mem_I i
      let α₁ : MvPolynomial (Fin n) A →ₐ[A] Q ⧸ J := (Ideal.Quotient.mkₐ A J).comp F
      let α₂ : MvPolynomial (Fin n) A →ₐ[A] Q ⧸ J :=
        ((Algebra.ofId A (Q ⧸ J)).comp μ_bar).comp F
      have hα_eq : α₁ = α₂ := by
        apply MvPolynomial.algHom_ext
        intro i
        change Ideal.Quotient.mk J (F (MvPolynomial.X i)) =
          Ideal.Quotient.mk J (algebraMap A Q (μ_bar (F (MvPolynomial.X i))))
        rw [Ideal.Quotient.eq]
        exact Ideal.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem z (Finset.mem_univ i)))
      have hI_le_J : I ≤ J := by
        intro x hx
        obtain ⟨P, rfl⟩ := hF_surj x
        have hx0 : μ_bar (F P) = 0 := hx
        have hmk0 : Ideal.Quotient.mk J (F P) = 0 := by
          change α₁ P = 0
          rw [hα_eq]
          change algebraMap A (Q ⧸ J) (μ_bar (F P)) = 0
          rw [hx0, map_zero]
        exact Ideal.Quotient.eq_zero_iff_mem.mp hmk0
      have hIJ : I = J := le_antisymm hI_le_J hJ_le_I
      exact ⟨S_fin, hIJ.symm⟩

    obtain ⟨e_bar, he_sub, he_ann⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I (I : Submodule Q Q) hI_fg hI_le
    obtain ⟨h, hh_eq⟩ := Ideal.Quotient.mk_surjective e_bar
    have hh_one : μ h = 1 := by
      have h0 : μ_bar_ring (e_bar - 1) = 0 := he_sub
      rw [← hh_eq, ← map_one q₀, ← map_sub] at h0
      change μ (h - 1) = 0 at h0
      rw [map_sub, map_one] at h0
      exact sub_eq_zero.mp h0
    refine ⟨h, hh_one, ?_⟩
    intro r hr0
    have hqr_mem : q₀ r ∈ I := hr0
    have hprod0 : q₀ (h * r) = 0 := by
      rw [map_mul, hh_eq]
      exact he_ann (q₀ r) hqr_mem
    exact Ideal.Quotient.eq_zero_iff_mem.mp hprod0

  
  have hSecPullback :
      ∀ {Y B Y' B' : AlgebraicGeometry.Scheme.{u}}
        {f : Y ⟶ B} {p_Y : Y' ⟶ Y} {f' : Y' ⟶ B'} {m : B' ⟶ B}
        (hPb : CategoryTheory.IsPullback p_Y f' f m)
        {τ : B ⟶ Y} (hτ_sec : τ ≫ f = 𝟙 B) (hτ_cl : AlgebraicGeometry.IsClosedImmersion τ)
        {τ' : B' ⟶ Y'} (hτ'_fst : τ' ≫ p_Y = m ≫ τ) (hτ'_sec : τ' ≫ f' = 𝟙 B'),
        AlgebraicGeometry.IsClosedImmersion τ' ∧
        Set.range τ'.base = p_Y.base ⁻¹' Set.range τ.base := by
    intro Y B Y' B' f p_Y f' m hPb τ hτ_sec hτ_cl τ' hτ'_fst hτ'_sec
    have hPb_id : CategoryTheory.IsPullback m (𝟙 B') (𝟙 B) m :=
      CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk
          (by rw [Category.comp_id, Category.id_comp])
          (fun s => s.snd)
          (fun s => s.condition.symm.trans (Category.comp_id s.fst))
          (fun s => Category.comp_id s.snd)
          (fun s g _ hg₂ => by simpa using hg₂))
    have hPb_outer : CategoryTheory.IsPullback m (τ' ≫ f') (τ ≫ f) m := by
      rwa [hτ'_sec, hτ_sec]
    have hPb_top : CategoryTheory.IsPullback m τ' τ p_Y :=
      CategoryTheory.IsPullback.of_bot hPb_outer hτ'_fst.symm hPb
    have hCl' : AlgebraicGeometry.IsClosedImmersion τ' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top hτ_cl
    refine ⟨hCl', ?_⟩
    ext y'
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨b', rfl⟩
      refine ⟨m.base b', ?_⟩
      change (m ≫ τ).base b' = (τ' ≫ p_Y).base b'
      rw [hτ'_fst]
    · rintro ⟨b, hb⟩
      let iso_top := hPb_top.isoPullback
      obtain ⟨z, _, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := τ) (g := p_Y) b y' hb
      refine ⟨iso_top.inv.base z, ?_⟩
      change (iso_top.inv ≫ τ').base z = y'
      rw [hPb_top.isoPullback_inv_snd]
      exact hz₂

  
  obtain ⟨V_sm, hAff_Vsm, U_sm, hAff_Usm, hy₀_Usm, he_sm, hStd⟩ :=
    (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f₀).mp inferInstance (τ₀.base v₀)
  have hv₀_Vsm : v₀ ∈ V_sm := by
    have hfv : f₀.base (τ₀.base v₀) = v₀ := by
      change (τ₀ ≫ f₀).base v₀ = v₀
      rw [hτ₀_sec]
      rfl
    rw [← hfv]
    exact he_sm hy₀_Usm
  obtain ⟨V₁, hAff_V₁, hv₀_V₁, hV₁_sub⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
      (x := v₀) (U := V_sm ⊓ (TopologicalSpace.Opens.map τ₀.base).obj U_sm)
      ⟨hv₀_Vsm, hy₀_Usm⟩
  have hV₁_le_Vsm : V₁ ≤ V_sm := fun z hz => (hV₁_sub hz).1
  have hV₁_le_τ : V₁ ≤ (TopologicalSpace.Opens.map τ₀.base).obj U_sm :=
    fun z hz => (hV₁_sub hz).2
  have : Nonempty ↥V₁.toScheme := ⟨⟨v₀, hv₀_V₁⟩⟩
  have hInt_V₁ : AlgebraicGeometry.IsIntegral V₁.toScheme :=
    AlgebraicGeometry.isIntegral_of_isOpenImmersion V₁.ι
  have : AlgebraicGeometry.IsAffine V₁.toScheme := hAff_V₁

  let Y₁ := CategoryTheory.Limits.pullback f₀ V₁.ι
  let p₁ := CategoryTheory.Limits.pullback.fst f₀ V₁.ι
  let f₁ := CategoryTheory.Limits.pullback.snd f₀ V₁.ι
  have hPb_Y₁ : CategoryTheory.IsPullback p₁ f₁ f₀ V₁.ι :=
    CategoryTheory.IsPullback.of_hasPullback f₀ V₁.ι
  let τ₁ : V₁.toScheme ⟶ Y₁ :=
    CategoryTheory.Limits.pullback.lift (V₁.ι ≫ τ₀) (𝟙 V₁.toScheme)
      (by rw [Category.assoc, hτ₀_sec, Category.comp_id, Category.id_comp])
  have hτ₁_fst : τ₁ ≫ p₁ = V₁.ι ≫ τ₀ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hτ₁_sec : τ₁ ≫ f₁ = 𝟙 V₁.toScheme := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have : AlgebraicGeometry.IsSeparated f₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Y₁ inferInstance
  have hτ₁_cl : AlgebraicGeometry.IsClosedImmersion τ₁ := by
    have : AlgebraicGeometry.IsClosedImmersion (τ₁ ≫ f₁) := by
      rw [hτ₁_sec]
      infer_instance
    exact AlgebraicGeometry.IsClosedImmersion.of_comp τ₁ f₁

  let W_box : Y₁.Opens := (TopologicalSpace.Opens.map p₁.base).obj U_sm
  have h_le_box : (⊤ : V₁.toScheme.Opens) ≤ (TopologicalSpace.Opens.map τ₁.base).obj W_box := by
    intro v _
    change p₁.base (τ₁.base v) ∈ U_sm
    have hpv : p₁.base (τ₁.base v) = τ₀.base v.1 := by
      change (τ₁ ≫ p₁).base v = τ₀.base v.1
      rw [hτ₁_fst]
      rfl
    rw [hpv]
    exact hV₁_le_τ v.2
  have he_V₁_Vsm : (⊤ : V₁.toScheme.Opens) ≤ (TopologicalSpace.Opens.map V₁.ι.base).obj V_sm :=
    fun v _ => hV₁_le_Vsm v.2

  let A_sm : Type u := ↑(V₀.presheaf.obj (Opposite.op V_sm))
  let R_sm : Type u := ↑(Y₀.presheaf.obj (Opposite.op U_sm))
  let A₁ : Type u := ↑(V₁.toScheme.presheaf.obj (Opposite.op ⊤))
  let R_box : Type u := ↑(Y₁.presheaf.obj (Opposite.op W_box))
  let φ_sm : A_sm →+* R_sm := (f₀.appLE V_sm U_sm he_sm).hom
  let φ_V₁ : A_sm →+* A₁ := (V₁.ι.appLE V_sm ⊤ he_V₁_Vsm).hom
  let φ_box : A₁ →+* R_box := (f₁.appLE ⊤ W_box (fun _ _ => trivial)).hom
  let μ_box : R_box →+* A₁ := (τ₁.appLE W_box ⊤ h_le_box).hom

  obtain ⟨hAff_Wbox, Θ_box, _, hΘ_box_right⟩ :
      ∃ (hAff_Wbox : AlgebraicGeometry.IsAffineOpen W_box)
        (Θ_box : @TensorProduct A_sm _ R_sm A₁ _ _
          φ_sm.toAlgebra.toModule φ_V₁.toAlgebra.toModule ≃+* R_box),
        (∀ r : R_sm,
          Θ_box (@TensorProduct.tmul A_sm _ R_sm A₁ _ _
            φ_sm.toAlgebra.toModule φ_V₁.toAlgebra.toModule r 1) = (p₁.app U_sm).hom r) ∧
        (∀ a₁ : A₁,
          Θ_box (@TensorProduct.tmul A_sm _ R_sm A₁ _ _
            φ_sm.toAlgebra.toModule φ_V₁.toAlgebra.toModule 1 a₁) = φ_box a₁) := by
    let _ : Algebra A_sm R_sm := φ_sm.toAlgebra
    let _ : Algebra A_sm A₁ := φ_V₁.toAlgebra
    exact hAffPullbackTensor p₁ f₁ f₀ V₁.ι hPb_Y₁ V_sm hAff_Vsm U_sm hAff_Usm he_sm he_V₁_Vsm
      rfl rfl

  obtain ⟨ψ_sm, hψ_sm_comp, hψ_sm_et⟩ := hStd.exists_etale_mvPolynomial
  obtain ⟨ψ_box, hψ_box_comp, hψ_box_et⟩ :
      ∃ ψ_box : MvPolynomial (Fin 1) A₁ →+* R_box,
        ψ_box.comp MvPolynomial.C = φ_box ∧ ψ_box.Etale := by
    let algAsmRsm : Algebra A_sm R_sm := φ_sm.toAlgebra
    let algAsmA₁ : Algebra A_sm A₁ := φ_V₁.toAlgebra
    let B₀ := MvPolynomial (Fin 1) A_sm
    let B₁ := MvPolynomial (Fin 1) A₁
    let algB₀Rsm : Algebra B₀ R_sm := ψ_sm.toAlgebra
    let algB₀B₁ : Algebra B₀ B₁ := (MvPolynomial.map φ_V₁).toAlgebra
    have : Algebra.Etale B₀ R_sm := RingHom.etale_algebraMap.mp hψ_sm_et
    have : Algebra.Etale B₁ (TensorProduct B₀ B₁ R_sm) := Algebra.Etale.baseChange B₀ R_sm B₁
    have hEt_incL :
        (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := B₁) (B := R_sm)).Etale :=
      RingHom.etale_algebraMap.mpr inferInstance
    let T_base := TensorProduct A_sm R_sm A₁
    let f_B₁_ring : B₁ →+* T_base :=
      MvPolynomial.eval₂Hom
        (Algebra.TensorProduct.includeRight (R := A_sm) (A := R_sm) (B := A₁)).toRingHom
        (fun i => (ψ_sm (MvPolynomial.X i)) ⊗ₜ[A_sm] 1)
    have hf_B₁_comm :
        f_B₁_ring.comp (MvPolynomial.map φ_V₁) =
          (Algebra.TensorProduct.includeLeftRingHom (R := A_sm) (A := R_sm) (B := A₁)).comp ψ_sm := by
      apply MvPolynomial.ringHom_ext
      · intro a₀
        simp only [RingHom.comp_apply]
        dsimp [f_B₁_ring]
        rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
        change (1 : R_sm) ⊗ₜ[A_sm] (φ_V₁ a₀) = (ψ_sm (MvPolynomial.C a₀)) ⊗ₜ[A_sm] (1 : A₁)
        have hCa₀ : ψ_sm (MvPolynomial.C a₀) = φ_sm a₀ := DFunLike.congr_fun hψ_sm_comp a₀
        have hsmulR : φ_sm a₀ = a₀ • (1 : R_sm) := by
          change φ_sm a₀ = φ_sm a₀ * 1; rw [mul_one]
        have hsmulA : φ_V₁ a₀ = a₀ • (1 : A₁) := by
          change φ_V₁ a₀ = φ_V₁ a₀ * 1; rw [mul_one]
        rw [hCa₀, hsmulR, hsmulA, TensorProduct.smul_tmul]
      · intro i
        simp only [RingHom.comp_apply]
        dsimp [f_B₁_ring]
        rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X']
        rfl
    let fwd : TensorProduct B₀ B₁ R_sm →+* T_base := by
      letI algB₀Tbase : Algebra B₀ T_base :=
        ((Algebra.TensorProduct.includeLeftRingHom (R := A_sm) (A := R_sm) (B := A₁)).comp ψ_sm).toAlgebra
      let f_B₁ : B₁ →ₐ[B₀] T_base :=
        { toRingHom := f_B₁_ring
          commutes' := fun p => DFunLike.congr_fun hf_B₁_comm p }
      let f_Rsm : R_sm →ₐ[B₀] T_base :=
        { toRingHom := Algebra.TensorProduct.includeLeftRingHom (R := A_sm) (A := R_sm) (B := A₁)
          commutes' := fun _ => rfl }
      exact (Algebra.TensorProduct.productMap f_B₁ f_Rsm).toRingHom
    have hfwd_tmul : ∀ (P : B₁) (r : R_sm), fwd (P ⊗ₜ[B₀] r) = f_B₁_ring P * (r ⊗ₜ[A_sm] 1) :=
      fun _ _ => rfl
    let bwd : T_base →+* TensorProduct B₀ B₁ R_sm := by
      letI algA₀Tpoly : Algebra A_sm (TensorProduct B₀ B₁ R_sm) :=
        ((Algebra.TensorProduct.includeRight (R := B₀) (A := B₁) (B := R_sm)).toRingHom.comp
          φ_sm).toAlgebra
      let g_Rsm : R_sm →ₐ[A_sm] TensorProduct B₀ B₁ R_sm :=
        { toRingHom := (Algebra.TensorProduct.includeRight (R := B₀) (A := B₁) (B := R_sm)).toRingHom
          commutes' := fun _ => rfl }
      let g_A₁ : A₁ →ₐ[A_sm] TensorProduct B₀ B₁ R_sm :=
        { toRingHom := (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := B₁) (B := R_sm)).comp
            MvPolynomial.C
          commutes' := fun a₀ => by
            change (MvPolynomial.C (φ_V₁ a₀) : B₁) ⊗ₜ[B₀] (1 : R_sm) =
              (1 : B₁) ⊗ₜ[B₀] (φ_sm a₀)
            have hmapC : (MvPolynomial.C (φ_V₁ a₀) : B₁) = (MvPolynomial.C a₀ : B₀) • (1 : B₁) := by
              change MvPolynomial.C (φ_V₁ a₀) = MvPolynomial.map φ_V₁ (MvPolynomial.C a₀) * 1
              rw [MvPolynomial.map_C, mul_one]
            have hCa₀ : φ_sm a₀ = (MvPolynomial.C a₀ : B₀) • (1 : R_sm) := by
              change φ_sm a₀ = ψ_sm (MvPolynomial.C a₀) * 1
              rw [mul_one]
              exact (DFunLike.congr_fun hψ_sm_comp a₀).symm
            rw [hmapC, hCa₀, TensorProduct.smul_tmul] }
      exact (Algebra.TensorProduct.productMap g_Rsm g_A₁).toRingHom
    have hbwd_tmul : ∀ (r : R_sm) (a₁ : A₁),
        bwd (r ⊗ₜ[A_sm] a₁) = ((1 : B₁) ⊗ₜ[B₀] r) * ((MvPolynomial.C a₁ : B₁) ⊗ₜ[B₀] (1 : R_sm)) :=
      fun _ _ => rfl
    have hfb : ∀ x : T_base, fwd (bwd x) = x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul r a₁ =>
        rw [hbwd_tmul, map_mul, hfwd_tmul, hfwd_tmul]
        dsimp [f_B₁_ring]
        rw [map_one, one_mul, MvPolynomial.eval₂Hom_C]
        change (r ⊗ₜ[A_sm] (1 : A₁)) * (((1 : R_sm) ⊗ₜ[A_sm] a₁) * ((1 : R_sm) ⊗ₜ[A_sm] (1 : A₁))) =
          r ⊗ₜ[A_sm] a₁
        rw [Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, mul_one, mul_one, one_mul]
      | add x y ihx ihy => simp [map_add, ihx, ihy]
    have hbf_P :
        (bwd.comp fwd).comp (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := B₁) (B := R_sm)) =
          Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := B₁) (B := R_sm) := by
      apply MvPolynomial.ringHom_ext
      · intro a₁
        simp only [RingHom.comp_apply]
        change bwd (fwd ((MvPolynomial.C a₁ : B₁) ⊗ₜ[B₀] (1 : R_sm))) =
          (MvPolynomial.C a₁ : B₁) ⊗ₜ[B₀] (1 : R_sm)
        rw [hfwd_tmul]
        dsimp [f_B₁_ring]
        rw [MvPolynomial.eval₂Hom_C]
        change bwd (((1 : R_sm) ⊗ₜ[A_sm] a₁) * ((1 : R_sm) ⊗ₜ[A_sm] (1 : A₁))) = _
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one, hbwd_tmul,
          Algebra.TensorProduct.tmul_mul_tmul, one_mul, one_mul]
      · intro i
        simp only [RingHom.comp_apply]
        change bwd (fwd ((MvPolynomial.X i : B₁) ⊗ₜ[B₀] (1 : R_sm))) =
          (MvPolynomial.X i : B₁) ⊗ₜ[B₀] (1 : R_sm)
        rw [hfwd_tmul]
        dsimp [f_B₁_ring]
        rw [MvPolynomial.eval₂Hom_X', Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one,
          hbwd_tmul, map_one, Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one]
        have hXi_R : ψ_sm (MvPolynomial.X i) = (MvPolynomial.X i : B₀) • (1 : R_sm) := by
          change ψ_sm (MvPolynomial.X i) = ψ_sm (MvPolynomial.X i) * 1; rw [mul_one]
        have hXi_B : (MvPolynomial.X i : B₁) = (MvPolynomial.X i : B₀) • (1 : B₁) := by
          change MvPolynomial.X i = MvPolynomial.map φ_V₁ (MvPolynomial.X i) * 1
          rw [MvPolynomial.map_X, mul_one]
        rw [hXi_R, ← TensorProduct.smul_tmul, ← hXi_B]
    have hbf : ∀ t : TensorProduct B₀ B₁ R_sm, bwd (fwd t) = t := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul P r =>
        have hsplit : P ⊗ₜ[B₀] r = (P ⊗ₜ[B₀] (1 : R_sm)) * ((1 : B₁) ⊗ₜ[B₀] r) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hsplit, map_mul, map_mul]
        have hP : bwd (fwd (P ⊗ₜ[B₀] (1 : R_sm))) = P ⊗ₜ[B₀] (1 : R_sm) :=
          DFunLike.congr_fun hbf_P P
        have hr : bwd (fwd ((1 : B₁) ⊗ₜ[B₀] r)) = (1 : B₁) ⊗ₜ[B₀] r := by
          rw [hfwd_tmul, map_one, one_mul, hbwd_tmul, map_one,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one]
        rw [hP, hr]
      | add x y ihx ihy => simp [map_add, ihx, ihy]
    let E_poly : TensorProduct B₀ B₁ R_sm ≃+* T_base :=
      { toFun := fwd
        invFun := bwd
        left_inv := hbf
        right_inv := hfb
        map_mul' := map_mul fwd
        map_add' := map_add fwd }
    let E_tot : TensorProduct B₀ B₁ R_sm ≃+* R_box := E_poly.trans Θ_box
    let ψ_box : B₁ →+* R_box :=
      E_tot.toRingHom.comp (Algebra.TensorProduct.includeLeftRingHom (R := B₀) (A := B₁) (B := R_sm))
    have hψ_box_et : ψ_box.Etale := RingHom.Etale.respectsIso.1 _ E_tot hEt_incL
    have hψ_box_comp : ψ_box.comp MvPolynomial.C = φ_box := by
      ext a₁
      change Θ_box (fwd ((MvPolynomial.C a₁ : B₁) ⊗ₜ[B₀] (1 : R_sm))) = φ_box a₁
      rw [hfwd_tmul]
      dsimp [f_B₁_ring]
      rw [MvPolynomial.eval₂Hom_C]
      change Θ_box (((1 : R_sm) ⊗ₜ[A_sm] a₁) * ((1 : R_sm) ⊗ₜ[A_sm] (1 : A₁))) = φ_box a₁
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, mul_one]
      exact hΘ_box_right a₁
    exact ⟨ψ_box, hψ_box_comp, hψ_box_et⟩

  
  have hsec_box : μ_box.comp φ_box = RingHom.id A₁ := by
    have hcomp_cat : f₁.appLE ⊤ W_box (fun _ _ => trivial) ≫ τ₁.appLE W_box ⊤ h_le_box =
        (τ₁ ≫ f₁).appLE ⊤ ⊤ le_rfl :=
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE τ₁ f₁ ⊤ W_box ⊤ (fun _ _ => trivial) h_le_box
    have hid_app : (𝟙 V₁.toScheme : V₁.toScheme ⟶ V₁.toScheme).appLE ⊤ ⊤ le_rfl = 𝟙 _ := by
      simp [AlgebraicGeometry.Scheme.Hom.appLE]
      ext x
      rfl
    rw [hτ₁_sec, hid_app] at hcomp_cat
    exact CommRingCat.hom_ext_iff.mp hcomp_cat

  obtain ⟨h_box, hh_one, hh_ann⟩ :=
    hNakayamaExcision A₁ R_box φ_box μ_box hsec_box ψ_box hψ_box_comp hψ_box_et
  let g_box : R_box := ψ_box (MvPolynomial.X 0) - φ_box (μ_box (ψ_box (MvPolynomial.X 0)))

  let U₁ : Y₁.Opens := Y₁.basicOpen h_box
  have hAff_U₁ : AlgebraicGeometry.IsAffineOpen U₁ := hAff_Wbox.basicOpen h_box
  let R₁ : Type u := ↑(Y₁.presheaf.obj (Opposite.op U₁))
  let res_U₁ : R_box →+* R₁ :=
    (Y₁.presheaf.map (CategoryTheory.homOfLE (Y₁.basicOpen_le h_box)).op).hom
  let g_sec : R₁ := res_U₁ g_box
  have hUnit_h : IsUnit (res_U₁ h_box) := Y₁.toRingedSpace.isUnit_res_basicOpen h_box

  have h_le₁ : (⊤ : V₁.toScheme.Opens) ≤ (TopologicalSpace.Opens.map τ₁.base).obj U₁ := by
    have hbo_eq := V₁.toScheme.basicOpen_appLE τ₁ ⊤ W_box h_le_box h_box
    have hbo_top : V₁.toScheme.basicOpen ((τ₁.appLE W_box ⊤ h_le_box).hom h_box) = ⊤ :=
      V₁.toScheme.basicOpen_of_isUnit (hh_one.symm ▸ isUnit_one)
    rw [hbo_top, top_inf_eq] at hbo_eq
    exact hbo_eq.le

  let φ₁ : A₁ →+* R₁ := (f₁.appLE ⊤ U₁ (fun _ _ => trivial)).hom
  let μ₁ : R₁ →+* A₁ := (τ₁.appLE U₁ ⊤ h_le₁).hom
  have hμ₁_res : μ₁.comp res_U₁ = μ_box := by
    have hmap := τ₁.map_appLE h_le₁ (CategoryTheory.homOfLE (Y₁.basicOpen_le h_box)).op
    exact CommRingCat.hom_ext_iff.mp hmap
  have hsec₁ : μ₁.comp φ₁ = RingHom.id A₁ := by
    have hcomp_cat : f₁.appLE ⊤ U₁ (fun _ _ => trivial) ≫ τ₁.appLE U₁ ⊤ h_le₁ =
        (τ₁ ≫ f₁).appLE ⊤ ⊤ le_rfl :=
      AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE τ₁ f₁ ⊤ U₁ ⊤ (fun _ _ => trivial) h_le₁
    have hid_app : (𝟙 V₁.toScheme : V₁.toScheme ⟶ V₁.toScheme).appLE ⊤ ⊤ le_rfl = 𝟙 _ := by
      simp [AlgebraicGeometry.Scheme.Hom.appLE]
      ext x
      rfl
    rw [hτ₁_sec, hid_app] at hcomp_cat
    exact CommRingCat.hom_ext_iff.mp hcomp_cat

  have h_ker₁ : RingHom.ker μ₁ = Ideal.span {g_sec} := by
    apply le_antisymm
    · intro z hz
      have hz0 : μ₁ z = 0 := hz
      let algBoxR₁ : Algebra R_box R₁ := res_U₁.toAlgebra
      have : IsLocalization.Away h_box R₁ := hAff_Wbox.isLocalization_basicOpen h_box
      obtain ⟨n, r, hzr⟩ := IsLocalization.Away.surj h_box z
      change z * (res_U₁ h_box) ^ n = res_U₁ r at hzr
      have hμr0 : μ_box r = 0 := by
        calc
          μ_box r = μ₁ (res_U₁ r) := (DFunLike.congr_fun hμ₁_res r).symm
          _ = μ₁ (z * (res_U₁ h_box) ^ n) := by rw [← hzr]
          _ = μ₁ z * (μ₁ (res_U₁ h_box)) ^ n := by rw [map_mul, map_pow]
          _ = 0 := by rw [hz0, zero_mul]
      have hhr : h_box * r ∈ Ideal.span {g_box} := hh_ann r hμr0
      rw [Ideal.mem_span_singleton] at hhr
      rcases hhr with ⟨b, hb⟩
      obtain ⟨u_h, hu_h⟩ := hUnit_h.pow (n + 1)
      have hz_pow : z * (u_h : R₁) = g_sec * res_U₁ b := by
        rw [hu_h, pow_succ, ← mul_assoc, hzr, ← map_mul, mul_comm r h_box, hb, map_mul]
      have hz_eq : z = g_sec * (res_U₁ b * ↑(u_h⁻¹)) := by
        calc
          z = z * (u_h : R₁) * ↑(u_h⁻¹) := by rw [mul_assoc, Units.mul_inv, mul_one]
          _ = g_sec * (res_U₁ b * ↑(u_h⁻¹)) := by rw [hz_pow, mul_assoc]
      exact Ideal.mem_span_singleton.mpr ⟨res_U₁ b * ↑(u_h⁻¹), hz_eq⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      change μ₁ (res_U₁ g_box) = 0
      have h1 : μ₁ (res_U₁ g_box) = μ_box g_box := DFunLike.congr_fun hμ₁_res g_box
      rw [h1]
      dsimp [g_box]
      rw [map_sub]
      have h2 : μ_box (φ_box (μ_box (ψ_box (MvPolynomial.X 0)))) =
          μ_box (ψ_box (MvPolynomial.X 0)) :=
        DFunLike.congr_fun hsec_box _
      rw [h2, sub_self]

  
  let U₂ : Y₁.Opens := ⟨(Set.range τ₁.base)ᶜ, τ₁.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  have hcov : U₁ ⊔ U₂ = ⊤ := by
    ext y
    simp only [TopologicalSpace.Opens.coe_sup, TopologicalSpace.Opens.coe_top, Set.mem_union,
      Set.mem_univ, iff_true]
    by_cases hy : y ∈ Set.range τ₁.base
    · left
      rcases hy with ⟨v, rfl⟩
      exact h_le₁ (trivial : v ∈ (⊤ : V₁.toScheme.Opens))
    · right
      exact hy

  have hμ₁_surj : Function.Surjective μ₁ := fun a => ⟨φ₁ a, DFunLike.congr_fun hsec₁ a⟩
  have hEq_bo : U₁ ⊓ U₂ = Y₁.basicOpen g_sec := by
    ext y
    constructor
    · rintro ⟨hy₁, hy₂⟩
      let x : ↥U₁ := ⟨y, hy₁⟩
      let 𝔭 : PrimeSpectrum R₁ := hAff_U₁.primeIdealOf x
      have h𝔭_y : hAff_U₁.fromSpec.base 𝔭 = y := hAff_U₁.fromSpec_primeIdealOf x
      have hτ_sq :
          AlgebraicGeometry.Spec.map (τ₁.appLE U₁ ⊤ h_le₁) ≫ hAff_U₁.fromSpec =
            (AlgebraicGeometry.isAffineOpen_top V₁.toScheme).fromSpec ≫ τ₁ :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec τ₁ hAff_U₁
          (AlgebraicGeometry.isAffineOpen_top V₁.toScheme) h_le₁
      have h𝔭_not_comap : 𝔭 ∉ Set.range (PrimeSpectrum.comap μ₁) := by
        rintro ⟨q, hq⟩
        apply hy₂
        refine ⟨(AlgebraicGeometry.isAffineOpen_top V₁.toScheme).fromSpec.base q, ?_⟩
        change ((AlgebraicGeometry.isAffineOpen_top V₁.toScheme).fromSpec ≫ τ₁).base q = y
        rw [← hτ_sq]
        change hAff_U₁.fromSpec.base (PrimeSpectrum.comap μ₁ q) = y
        rw [hq, h𝔭_y]
      rw [_root_.range_comap_of_surjective A₁ μ₁ hμ₁_surj, h_ker₁] at h𝔭_not_comap
      have hg_not_mem : g_sec ∉ 𝔭.asIdeal := by
        intro hg_in
        apply h𝔭_not_comap
        change (Ideal.span {g_sec} : Set R₁) ⊆ 𝔭.asIdeal
        exact SetLike.coe_subset_coe.mpr (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hg_in))
      have h𝔭_bo : 𝔭 ∈ (TopologicalSpace.Opens.map hAff_U₁.fromSpec.base).obj
          (Y₁.basicOpen g_sec) := by
        rw [hAff_U₁.fromSpec_preimage_basicOpen g_sec]
        exact hg_not_mem
      change hAff_U₁.fromSpec.base 𝔭 ∈ Y₁.basicOpen g_sec at h𝔭_bo
      rwa [h𝔭_y] at h𝔭_bo
    · intro hy_bo
      have hy₁ : y ∈ U₁ := Y₁.basicOpen_le g_sec hy_bo
      refine ⟨hy₁, ?_⟩
      rintro ⟨v, rfl⟩
      let x : ↥U₁ := ⟨τ₁.base v, hy₁⟩
      let 𝔭 : PrimeSpectrum R₁ := hAff_U₁.primeIdealOf x
      have h𝔭_y : hAff_U₁.fromSpec.base 𝔭 = τ₁.base v := hAff_U₁.fromSpec_primeIdealOf x
      have hfrom_top : (AlgebraicGeometry.isAffineOpen_top V₁.toScheme).fromSpec =
          V₁.toScheme.isoSpec.inv := AlgebraicGeometry.IsAffineOpen.fromSpec_top
      let q : PrimeSpectrum A₁ := V₁.toScheme.isoSpec.hom.base v
      have hq_v : (AlgebraicGeometry.isAffineOpen_top V₁.toScheme).fromSpec.base q = v := by
        rw [hfrom_top]
        change (V₁.toScheme.isoSpec.hom ≫ V₁.toScheme.isoSpec.inv).base v = v
        rw [V₁.toScheme.isoSpec.hom_inv_id]
        rfl
      have hτ_sq :
          AlgebraicGeometry.Spec.map (τ₁.appLE U₁ ⊤ h_le₁) ≫ hAff_U₁.fromSpec =
            (AlgebraicGeometry.isAffineOpen_top V₁.toScheme).fromSpec ≫ τ₁ :=
        AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec τ₁ hAff_U₁
          (AlgebraicGeometry.isAffineOpen_top V₁.toScheme) h_le₁
      have h𝔭_eq : PrimeSpectrum.comap μ₁ q = 𝔭 := by
        apply hAff_U₁.fromSpec.isOpenEmbedding.injective
        change (AlgebraicGeometry.Spec.map (τ₁.appLE U₁ ⊤ h_le₁) ≫ hAff_U₁.fromSpec).base q =
          hAff_U₁.fromSpec.base 𝔭
        rw [hτ_sq]
        change τ₁.base ((AlgebraicGeometry.isAffineOpen_top V₁.toScheme).fromSpec.base q) = _
        rw [hq_v, h𝔭_y]
      have h𝔭_mem_range : 𝔭 ∈ Set.range (PrimeSpectrum.comap μ₁) := ⟨q, h𝔭_eq⟩
      rw [_root_.range_comap_of_surjective A₁ μ₁ hμ₁_surj, h_ker₁] at h𝔭_mem_range
      have hg_in_𝔭 : g_sec ∈ 𝔭.asIdeal :=
        h𝔭_mem_range (Ideal.mem_span_singleton_self g_sec)
      have h𝔭_bo : 𝔭 ∈ (TopologicalSpace.Opens.map hAff_U₁.fromSpec.base).obj
          (Y₁.basicOpen g_sec) := by
        change hAff_U₁.fromSpec.base 𝔭 ∈ Y₁.basicOpen g_sec
        rwa [h𝔭_y]
      rw [hAff_U₁.fromSpec_preimage_basicOpen g_sec] at h𝔭_bo
      exact h𝔭_bo hg_in_𝔭

  have hUnit_overlap :
      IsUnit ((Y₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom
        g_sec) := by
    have hUnit_bo :
        IsUnit ((Y₁.presheaf.map
          (CategoryTheory.homOfLE (Y₁.basicOpen_le g_sec)).op).hom g_sec) :=
      Y₁.toRingedSpace.isUnit_res_basicOpen g_sec
    have hhom_eq :
        CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁) =
          CategoryTheory.eqToHom hEq_bo ≫ CategoryTheory.homOfLE (Y₁.basicOpen_le g_sec) :=
      Subsingleton.elim _ _
    have hmap_eq :
        Y₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op =
          Y₁.presheaf.map (CategoryTheory.homOfLE (Y₁.basicOpen_le g_sec)).op ≫
            Y₁.presheaf.map (CategoryTheory.eqToHom hEq_bo).op := by
      rw [hhom_eq]
      exact Y₁.presheaf.map_comp _ _
    have : CategoryTheory.IsIso (Y₁.presheaf.map (CategoryTheory.eqToHom hEq_bo).op) :=
      inferInstance
    let e_ov : Y₁.presheaf.obj (Opposite.op (Y₁.basicOpen g_sec)) ≅
        Y₁.presheaf.obj (Opposite.op (U₁ ⊓ U₂)) :=
      CategoryTheory.asIso (Y₁.presheaf.map (CategoryTheory.eqToHom hEq_bo).op)
    change IsUnit ((Y₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom
      g_sec)
    rw [hmap_eq]
    exact hUnit_bo.map e_ov.hom.hom
  let u₁₂ : Units ↑(Y₁.presheaf.obj (Opposite.op (U₁ ⊓ U₂))) := hUnit_overlap.unit

  refine ⟨V₁, hAff_V₁, hv₀_V₁, hInt_V₁, U₁, U₂, g_sec, u₁₂, hcov, IsUnit.unit_spec hUnit_overlap,
    ?_⟩

  
  intro Ω _ _ s_Ω Y_Ω ι_Ω f_Ω hPb_Ω
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
  have hNonempty_SΩ : Nonempty ↥S_Ω :=
    (PrimeSpectrum.nonempty_iff_nontrivial (R := Ω)).mpr inferInstance
  let pt_Ω : ↥S_Ω := Classical.choice hNonempty_SΩ
  have hSub_SΩ : Subsingleton ↥S_Ω := by
    change Subsingleton (PrimeSpectrum Ω)
    infer_instance
  let σ_Ω : S_Ω ⟶ Y_Ω :=
    hPb_Ω.lift (s_Ω ≫ τ₁) (𝟙 S_Ω)
      (by rw [Category.assoc, hτ₁_sec, Category.comp_id, Category.id_comp])
  have hσ_fst : σ_Ω ≫ ι_Ω = s_Ω ≫ τ₁ := hPb_Ω.lift_fst _ _ _
  have hσ_snd : σ_Ω ≫ f_Ω = 𝟙 S_Ω := hPb_Ω.lift_snd _ _ _
  obtain ⟨hσ_cl, hσ_range_pre⟩ := hSecPullback hPb_Ω hτ₁_sec hτ₁_cl hσ_fst hσ_snd
  have : AlgebraicGeometry.IsClosedImmersion σ_Ω := hσ_cl

  let P_Ω : ↥Y_Ω := σ_Ω.base pt_Ω
  have hσ_range_sing : Set.range σ_Ω.base = ({P_Ω} : Set ↥Y_Ω) := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨z, rfl⟩
      rw [hSub_SΩ.elim z pt_Ω]
    · rintro rfl
      exact ⟨pt_Ω, rfl⟩
  have hP_cl : IsClosed ({P_Ω} : Set ↥Y_Ω) := by
    rw [← hσ_range_sing]
    exact σ_Ω.isClosedEmbedding.isClosed_range
  have hιP_eq : ι_Ω.base P_Ω = τ₁.base (s_Ω.base pt_Ω) := by
    change (σ_Ω ≫ ι_Ω).base pt_Ω = (s_Ω ≫ τ₁).base pt_Ω
    rw [hσ_fst]
  let U₁_Ω : Y_Ω.Opens := (TopologicalSpace.Opens.map ι_Ω.base).obj U₁
  have hP_mem : P_Ω ∈ U₁_Ω := by
    change ι_Ω.base P_Ω ∈ U₁
    rw [hιP_eq]
    exact h_le₁ (trivial : s_Ω.base pt_Ω ∈ (⊤ : V₁.toScheme.Opens))
  have hU₂_Ω_compl :
      ((TopologicalSpace.Opens.map ι_Ω.base).obj U₂ : Set ↥Y_Ω) = ({P_Ω} : Set ↥Y_Ω)ᶜ := by
    change ι_Ω.base ⁻¹' (Set.range τ₁.base)ᶜ = ({P_Ω} : Set ↥Y_Ω)ᶜ
    rw [Set.preimage_compl, ← hσ_range_pre, hσ_range_sing]

  
  let A_Ω : Type u := ↑(S_Ω.presheaf.obj (Opposite.op ⊤))
  let B_Ω : Type u := ↑(Y_Ω.presheaf.obj (Opposite.op U₁_Ω))
  let φ_sΩ : A₁ →+* A_Ω := (s_Ω.appLE ⊤ ⊤ (fun _ _ => trivial)).hom
  obtain ⟨hAff_U1Ω, Θ_Ω, hΘ_Ω_left, _⟩ :
      ∃ (hAff_U1Ω : AlgebraicGeometry.IsAffineOpen U₁_Ω)
        (Θ_Ω : @TensorProduct A₁ _ R₁ A_Ω _ _
          φ₁.toAlgebra.toModule φ_sΩ.toAlgebra.toModule ≃+* B_Ω),
        (∀ r : R₁,
          Θ_Ω (@TensorProduct.tmul A₁ _ R₁ A_Ω _ _
            φ₁.toAlgebra.toModule φ_sΩ.toAlgebra.toModule r 1) = (ι_Ω.app U₁).hom r) ∧
        (∀ a' : A_Ω,
          Θ_Ω (@TensorProduct.tmul A₁ _ R₁ A_Ω _ _
            φ₁.toAlgebra.toModule φ_sΩ.toAlgebra.toModule 1 a') =
            (f_Ω.appLE ⊤ U₁_Ω (fun _ _ => trivial)).hom a') := by
    let _ : Algebra A₁ R₁ := φ₁.toAlgebra
    let _ : Algebra A₁ A_Ω := φ_sΩ.toAlgebra
    exact hAffPullbackTensor ι_Ω f_Ω f₁ s_Ω hPb_Ω ⊤
      (AlgebraicGeometry.isAffineOpen_top V₁.toScheme) U₁ hAff_U₁
      (fun _ _ => trivial) (fun _ _ => trivial) rfl rfl

  let g_Ω : B_Ω := (ι_Ω.app U₁).hom g_sec
  have hg_Ω_max : (Ideal.span {g_Ω}).IsMaximal := by
    let algA₁R₁ : Algebra A₁ R₁ := φ₁.toAlgebra
    let algA₁AΩ : Algebra A₁ A_Ω := φ_sΩ.toAlgebra
    let e_SΩ_spec : AlgebraicGeometry.Spec (S_Ω.presheaf.obj (Opposite.op ⊤)) ≅ S_Ω :=
      S_Ω.isoSpec.symm
    let i_fwd : CommRingCat.of Ω ⟶ S_Ω.presheaf.obj (Opposite.op ⊤) :=
      AlgebraicGeometry.Spec.preimage e_SΩ_spec.hom
    let i_bwd : S_Ω.presheaf.obj (Opposite.op ⊤) ⟶ CommRingCat.of Ω :=
      AlgebraicGeometry.Spec.preimage e_SΩ_spec.inv
    have hi_fb : i_fwd ≫ i_bwd = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_SΩ_spec.inv_hom_id, AlgebraicGeometry.Spec.map_id]
    have hi_bf : i_bwd ≫ i_fwd = 𝟙 _ := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, e_SΩ_spec.hom_inv_id, AlgebraicGeometry.Spec.map_id]
    let e_AΩ : A_Ω ≃+* Ω :=
      { toFun := i_bwd.hom
        invFun := i_fwd.hom
        left_inv := fun x => congrArg (fun g : S_Ω.presheaf.obj _ ⟶ S_Ω.presheaf.obj _ => g.hom x) hi_bf
        right_inv := fun y => congrArg (fun g : CommRingCat.of Ω ⟶ CommRingCat.of Ω => g.hom y) hi_fb
        map_mul' := map_mul i_bwd.hom
        map_add' := map_add i_bwd.hom }
    let μ₁_alg : R₁ →ₐ[A₁] A_Ω :=
      { toRingHom := φ_sΩ.comp μ₁
        commutes' := fun a => by
          change φ_sΩ (μ₁ (φ₁ a)) = φ_sΩ a
          have h1 : μ₁ (φ₁ a) = a := DFunLike.congr_fun hsec₁ a
          rw [h1] }
    let ν₀ : TensorProduct A₁ R₁ A_Ω →+* A_Ω :=
      (Algebra.TensorProduct.productMap μ₁_alg (AlgHom.id A₁ A_Ω)).toRingHom
    have hν₀_tmul : ∀ (r : R₁) (a' : A_Ω), ν₀ (r ⊗ₜ[A₁] a') = φ_sΩ (μ₁ r) * a' :=
      fun _ _ => rfl
    have hν₀_surj : Function.Surjective ν₀ := fun a' =>
      ⟨1 ⊗ₜ[A₁] a', by rw [hν₀_tmul, map_one, map_one, one_mul]⟩
    have hν₀_sub : ∀ w : TensorProduct A₁ R₁ A_Ω,
        w - 1 ⊗ₜ[A₁] (ν₀ w) ∈ Ideal.span {g_sec ⊗ₜ[A₁] (1 : A_Ω)} := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul r a' =>
        have hr_ker : r - φ₁ (μ₁ r) ∈ RingHom.ker μ₁ := by
          change μ₁ (r - φ₁ (μ₁ r)) = 0
          rw [map_sub]
          have h1 : μ₁ (φ₁ (μ₁ r)) = μ₁ r := DFunLike.congr_fun hsec₁ (μ₁ r)
          rw [h1, sub_self]
        rw [h_ker₁, Ideal.mem_span_singleton] at hr_ker
        rcases hr_ker with ⟨b, hb⟩
        have h1_tmul : (1 : R₁) ⊗ₜ[A₁] (ν₀ (r ⊗ₜ[A₁] a')) = (φ₁ (μ₁ r)) ⊗ₜ[A₁] a' := by
          rw [hν₀_tmul]
          have hsmul_AΩ : φ_sΩ (μ₁ r) * a' = (μ₁ r) • a' := rfl
          have hsmul_R₁ : φ₁ (μ₁ r) = (μ₁ r) • (1 : R₁) := by
            change φ₁ (μ₁ r) = φ₁ (μ₁ r) * 1; rw [mul_one]
          rw [hsmul_AΩ, hsmul_R₁, TensorProduct.smul_tmul]
        rw [h1_tmul, ← TensorProduct.sub_tmul, hb]
        have hmul_tmul : (g_sec * b) ⊗ₜ[A₁] a' = (g_sec ⊗ₜ[A₁] (1 : A_Ω)) * (b ⊗ₜ[A₁] a') := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
        rw [hmul_tmul]
        exact Ideal.mem_span_singleton.mpr ⟨b ⊗ₜ[A₁] a', rfl⟩
      | add x y ihx ihy =>
        have hsplit : (x + y) - 1 ⊗ₜ[A₁] ν₀ (x + y) =
            (x - 1 ⊗ₜ[A₁] ν₀ x) + (y - 1 ⊗ₜ[A₁] ν₀ y) := by
          rw [map_add, TensorProduct.tmul_add]
          abel
        rw [hsplit]
        exact Ideal.add_mem _ ihx ihy
    let μ_Ω : B_Ω →+* Ω := e_AΩ.toRingHom.comp (ν₀.comp Θ_Ω.symm.toRingHom)
    have hμ_Ω_surj : Function.Surjective μ_Ω :=
      e_AΩ.surjective.comp (hν₀_surj.comp Θ_Ω.symm.surjective)
    have hμ_Ω_ker : RingHom.ker μ_Ω = Ideal.span {g_Ω} := by
      apply le_antisymm
      · intro z hz
        have hν0 : ν₀ (Θ_Ω.symm z) = 0 := by
          apply e_AΩ.injective
          rw [map_zero]
          exact hz
        have hmem_T : Θ_Ω.symm z ∈ Ideal.span {g_sec ⊗ₜ[A₁] (1 : A_Ω)} := by
          have hsub := hν₀_sub (Θ_Ω.symm z)
          rwa [hν0, TensorProduct.tmul_zero, sub_zero] at hsub
        rw [Ideal.mem_span_singleton] at hmem_T
        rcases hmem_T with ⟨t, ht⟩
        have hz_eq : z = g_Ω * Θ_Ω t := by
          calc
            z = Θ_Ω (Θ_Ω.symm z) := (Θ_Ω.apply_symm_apply z).symm
            _ = Θ_Ω ((g_sec ⊗ₜ[A₁] (1 : A_Ω)) * t) := by rw [ht]
            _ = Θ_Ω (g_sec ⊗ₜ[A₁] (1 : A_Ω)) * Θ_Ω t := map_mul Θ_Ω _ _
            _ = g_Ω * Θ_Ω t := by rw [hΘ_Ω_left g_sec]
        exact Ideal.mem_span_singleton.mpr ⟨Θ_Ω t, hz_eq⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        change e_AΩ (ν₀ (Θ_Ω.symm g_Ω)) = 0
        have hsymm_g : Θ_Ω.symm g_Ω = g_sec ⊗ₜ[A₁] (1 : A_Ω) := by
          apply Θ_Ω.injective
          rw [Θ_Ω.apply_symm_apply, hΘ_Ω_left g_sec]
        rw [hsymm_g, hν₀_tmul]
        have hμg0 : μ₁ g_sec = 0 := by
          have hmem : g_sec ∈ RingHom.ker μ₁ := by
            rw [h_ker₁]
            exact Ideal.mem_span_singleton_self g_sec
          exact hmem
        rw [hμg0, map_zero, zero_mul, map_zero]
    rw [← hμ_Ω_ker]
    exact RingHom.ker_isMaximal_of_surjective μ_Ω hμ_Ω_surj

  
  let x_Ω : ↥U₁_Ω := ⟨P_Ω, hP_mem⟩
  let 𝔭_Ω := hAff_U1Ω.primeIdealOf x_Ω
  have h𝔭_Ω_pt : hAff_U1Ω.fromSpec.base 𝔭_Ω = P_Ω := hAff_U1Ω.fromSpec_primeIdealOf x_Ω
  have hP_not_bo : P_Ω ∉ Y_Ω.basicOpen g_Ω := by
    intro hmem_bo
    have hpre_bo : Y_Ω.basicOpen g_Ω =
        (TopologicalSpace.Opens.map ι_Ω.base).obj (Y₁.basicOpen g_sec) :=
      (ι_Ω.preimage_basicOpen g_sec).symm
    rw [hpre_bo, ← hEq_bo] at hmem_bo
    exact hmem_bo.2 ⟨s_Ω.base pt_Ω, hιP_eq.symm⟩
  have hg_mem_𝔭 : g_Ω ∈ 𝔭_Ω.asIdeal := by
    by_contra hg_not
    have h𝔭_in_bo : 𝔭_Ω ∈ (TopologicalSpace.Opens.map hAff_U1Ω.fromSpec.base).obj
        (Y_Ω.basicOpen g_Ω) := by
      rw [hAff_U1Ω.fromSpec_preimage_basicOpen g_Ω]
      exact hg_not
    change hAff_U1Ω.fromSpec.base 𝔭_Ω ∈ Y_Ω.basicOpen g_Ω at h𝔭_in_bo
    rw [h𝔭_Ω_pt] at h𝔭_in_bo
    exact hP_not_bo h𝔭_in_bo
  have hspan_eq_𝔭 : Ideal.span {g_Ω} = 𝔭_Ω.asIdeal :=
    hg_Ω_max.eq_of_le 𝔭_Ω.isPrime.ne_top
      (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hg_mem_𝔭))

  let _ : Algebra ↑(Y_Ω.presheaf.obj (Opposite.op U₁_Ω)) ↑(Y_Ω.presheaf.stalk ↑x_Ω) :=
    TopCat.Presheaf.algebra_section_stalk Y_Ω.presheaf x_Ω
  have : IsLocalization.AtPrime ↑(Y_Ω.presheaf.stalk ↑x_Ω) 𝔭_Ω.asIdeal :=
    hAff_U1Ω.isLocalization_stalk x_Ω
  have hstalk_max :
      Ideal.map (Y_Ω.presheaf.germ U₁_Ω P_Ω hP_mem).hom 𝔭_Ω.asIdeal =
        IsLocalRing.maximalIdeal ↑(Y_Ω.presheaf.stalk P_Ω) :=
    IsLocalization.AtPrime.map_eq_maximalIdeal 𝔭_Ω.asIdeal ↑(Y_Ω.presheaf.stalk ↑x_Ω)

  refine ⟨P_Ω, hP_cl, hP_mem, hU₂_Ω_compl, ?_⟩
  rw [← hstalk_max, ← hspan_eq_𝔭, Ideal.map_span, Set.image_singleton]

theorem weil_etale_algClosed_closedPt_conservativity_and_localPullback (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
    (∀ (S : CategoryTheory.Over S_k) [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        (G : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (s : Quiver.Hom S_k S.left),
        CategoryTheory.CategoryStruct.comp s S.hom = CategoryTheory.CategoryStruct.id S_k →
        ∃ G_s : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u},
          WeilIsEtaleSheafPullback s G G_s ∧ CategoryTheory.Limits.IsZero G_s) →
      CategoryTheory.Limits.IsZero G) ∧
    (∀ (S : CategoryTheory.Over S_k) [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        {G₁ G₂ : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}}
        (Φ : Quiver.Hom G₁ G₂),
      (∀ (s : Quiver.Hom S_k S.left),
        CategoryTheory.CategoryStruct.comp s S.hom = CategoryTheory.CategoryStruct.id S_k →
        ∃ (hCont : (weilEtaleSitePullback s).IsContinuous S.left.smallEtaleTopology S_k.smallEtaleTopology)
          (hAdj : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback s) AddCommGrpCat.{u} _
            S.left.smallEtaleTopology S_k.smallEtaleTopology hCont).IsRightAdjoint),
          let pb_s := @CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback s) AddCommGrpCat.{u} _
            S.left.smallEtaleTopology S_k.smallEtaleTopology hCont hAdj
          Function.Bijective (((pb_s.map Φ).hom.app (Opposite.op T_k)).hom)) →
      CategoryTheory.IsIso Φ) ∧
    (∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom X₁ X₂)
        (U₁ : X₁.Etale) (U₂ : X₂.Etale)
        (τ_U : Quiver.Hom ((weilEtaleSitePullback h).obj U₂) U₁) (q : ℕ),
      ∃! p : weilEtaleLocalTorsionH X₂ ℓ U₂ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁ q,
        WeilIsLocalTorsionPullback h U₁ U₂ τ_U ℓ q p) ∧
    (∀ {X₁ X₂ X₃ : AlgebraicGeometry.Scheme.{u}}
        (h₁ : Quiver.Hom X₁ X₂) (h₂ : Quiver.Hom X₂ X₃)
        (U₁ : X₁.Etale) (U₂ : X₂.Etale) (U₃ : X₃.Etale)
        (τ₁ : Quiver.Hom ((weilEtaleSitePullback h₁).obj U₂) U₁)
        (τ₂ : Quiver.Hom ((weilEtaleSitePullback h₂).obj U₃) U₂)
        (τ₁₂ : Quiver.Hom ((weilEtaleSitePullback (CategoryTheory.CategoryStruct.comp h₁ h₂)).obj U₃) U₁)
        (p₁ : weilEtaleLocalTorsionH X₂ ℓ U₂ 2 →+ weilEtaleLocalTorsionH X₁ ℓ U₁ 2)
        (p₂ : weilEtaleLocalTorsionH X₃ ℓ U₃ 2 →+ weilEtaleLocalTorsionH X₂ ℓ U₂ 2)
        (p₁₂ : weilEtaleLocalTorsionH X₃ ℓ U₃ 2 →+ weilEtaleLocalTorsionH X₁ ℓ U₁ 2),
      let Fgt₁ := AlgebraicGeometry.Scheme.Etale.forget X₁
      let Fgt₂ := AlgebraicGeometry.Scheme.Etale.forget X₂
      let Fgt₃ := AlgebraicGeometry.Scheme.Etale.forget X₃
      let B₁ := weilEtaleSitePullback h₁
