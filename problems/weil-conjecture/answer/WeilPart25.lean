    have hcard_tor_mod :
        Nat.card (weilEtaleTorsionH C_u.left ℓ 1) = Nat.card (weilCupPDModH C_u.left ℓ 1) :=
      Nat.card_congr eθ_Cu_1.symm.toEquiv
    obtain ⟨p_u0, hp_u0⟩ := hPullPkg.1 ι_u ℓ 1
    have hinj0 := hInj_fib s_u C_u ι_u hPb_u p_u0 hp_u0
    have hle_card : ℓ ^ b_pt ≤ Nat.card (weilCupPDModH C_u.left ℓ 1) := by
      rw [← hcard_dom, ← hcard_tor_mod]
      exact Nat.card_le_card_of_injective _ hinj0
    refine ⟨hle_card, fun hs_u_range => ?_⟩
    have hs_u_eq : s_u = s'_pt :=
      hSecPkg.2.2.1 U_pt p_Upt s_u s'_pt hs_u_sec hs'_pt_sec
        (hs_u_range.trans hs'_pt_range.symm)
    have hPb_u' : CategoryTheory.IsPullback ι_u C_u.hom f_pt s'_pt :=
      hs_u_eq ▸ hPb_u
    let e_fib : C_u.left ≅ C_pt.left :=
      CategoryTheory.IsPullback.isoIsPullback Y_pt S_k hPb_u' hPb_Cpt_Upt
    obtain ⟨p_hom, hp_hom⟩ := hPullPkg.1 e_fib.hom ℓ 1
    obtain ⟨p_inv, hp_inv⟩ := hPullPkg.1 e_fib.inv ℓ 1
    obtain ⟨p_id_u, hp_id_u⟩ := hPullPkg.1 (CategoryTheory.CategoryStruct.id C_u.left) ℓ 1
    obtain ⟨p_id_pt, hp_id_pt⟩ := hPullPkg.1 (CategoryTheory.CategoryStruct.id C_pt.left) ℓ 1
    have hp_id_u_eq : p_id_u = AddMonoidHom.id _ := hPullPkg.2.1 ℓ 1 p_id_u hp_id_u
    have hp_id_pt_eq : p_id_pt = AddMonoidHom.id _ := hPullPkg.2.1 ℓ 1 p_id_pt hp_id_pt
    have hp_hom_inv : WeilIsTorsionEtalePullback (e_fib.hom ≫ e_fib.inv) ℓ 1 p_id_u := by
      rwa [e_fib.hom_inv_id]
    have hp_inv_hom : WeilIsTorsionEtalePullback (e_fib.inv ≫ e_fib.hom) ℓ 1 p_id_pt := by
      rwa [e_fib.inv_hom_id]
    have hcomp_u : p_hom.comp p_inv = AddMonoidHom.id _ :=
      (hPullPkg.2.2.1 e_fib.hom e_fib.inv ℓ 1 p_hom p_inv p_id_u
        hp_hom hp_inv hp_hom_inv).symm.trans hp_id_u_eq
    have hcomp_pt : p_inv.comp p_hom = AddMonoidHom.id _ :=
      (hPullPkg.2.2.1 e_fib.inv e_fib.hom ℓ 1 p_inv p_hom p_id_pt
        hp_inv hp_hom hp_inv_hom).symm.trans hp_id_pt_eq
    let eqv_tor : weilEtaleTorsionH C_u.left ℓ 1 ≃ weilEtaleTorsionH C_pt.left ℓ 1 :=
      { toFun := p_inv
        invFun := p_hom
        left_inv := fun x => DFunLike.congr_fun hcomp_u x
        right_inv := fun y => DFunLike.congr_fun hcomp_pt y }
    let eθ_Cpt_1 := AddEquiv.ofBijective θ_Cpt_1 hbij_Cpt_1
    have hCard_Cu_eq : Nat.card (weilCupPDModH C_u.left ℓ 1) = ℓ ^ b_pt := by
      calc
        Nat.card (weilCupPDModH C_u.left ℓ 1)
          = Nat.card (weilEtaleTorsionH C_u.left ℓ 1) := hcard_tor_mod.symm
        _ = Nat.card (weilEtaleTorsionH C_pt.left ℓ 1) := Nat.card_congr eqv_tor
        _ = Nat.card (weilCupPDModH C_pt.left ℓ 1) :=
              Nat.card_congr eθ_Cpt_1.symm.toEquiv
        _ = ℓ ^ b_pt := hCard_Cpt
    refine ⟨hCard_Cu_eq, fun θ_pt θ_u p_u hθ_pt hθ_u hp_u x_u => ?_⟩
    have _ := hθ_u
    have hθ_pt_eq : θ_pt = θ_Ypt_1 := hθ_Ypt_1_uniq θ_pt θ_Ypt_1 hθ_pt hθ_Ypt_1
    let ψ_span : (Fin b_pt → ZMod ℓ) → weilEtaleTorsionH C_u.left ℓ 1 :=
      fun c => Finset.univ.sum fun i : Fin b_pt => (c i).val • p_u (s_tor i)
    have hψ_inj : Function.Injective ψ_span := hInj_fib s_u C_u ι_u hPb_u p_u hp_u
    letI : Fintype (weilEtaleTorsionH C_u.left ℓ 1) :=
      Fintype.ofFinite (weilEtaleTorsionH C_u.left ℓ 1)
    have hcard_fintype :
        Fintype.card (Fin b_pt → ZMod ℓ) = Fintype.card (weilEtaleTorsionH C_u.left ℓ 1) := by
      rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card, hcard_dom,
        hcard_tor_mod, hCard_Cu_eq]
    have hψ_bij : Function.Bijective ψ_span :=
      (Fintype.bijective_iff_injective_and_card ψ_span).mpr ⟨hψ_inj, hcard_fintype⟩
    obtain ⟨c, hc⟩ := hψ_bij.2 (θ_u x_u)
    refine ⟨c, hc.symm.trans ?_⟩
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hθ_pt_eq, hs_θ i]

  
  · intro hCard_all
    refine weil_etale_proper_r1_constSheaf_iso_of_fiber_inj_and_card
      k ℓ hPBC U_pt p_Upt Y_pt f_pt b_pt s_tor ?_
    intro s_u hs_u_sec
    obtain ⟨u, hu_range, _⟩ := hSecPkg.2.1 U_pt p_Upt s_u hs_u_sec
    have hcard_mod := hCard_all u s_u hs_u_sec hu_range
    let C_u_std : CategoryTheory.Over S_k :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_pt s_u)
    let ι_u_std := CategoryTheory.Limits.pullback.fst f_pt s_u
    have hPb_std : CategoryTheory.IsPullback ι_u_std C_u_std.hom f_pt s_u :=
      CategoryTheory.IsPullback.of_hasPullback f_pt s_u
    obtain ⟨⟨θ_std, _, hbij_std⟩, _⟩ :=
      weil_cupPD_mod_comparison_bijective_unique C_u_std.left ℓ 1
    let eθ_std := AddEquiv.ofBijective θ_std hbij_std
    have hcard_tor : Nat.card (weilEtaleTorsionH C_u_std.left ℓ 1) = ℓ ^ b_pt := by
      calc
        Nat.card (weilEtaleTorsionH C_u_std.left ℓ 1)
          = Nat.card (weilCupPDModH C_u_std.left ℓ 1) :=
              Nat.card_congr eθ_std.symm.toEquiv
        _ = ℓ ^ b_pt := hcard_mod
    exact ⟨hcard_tor, fun p_u hp_u => hInj_fib s_u C_u_std ι_u_std hPb_std p_u hp_u⟩

theorem weil_smooth_proj_curve_kummer_torsion_divisor_and_chart_units (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : Ω) ≠ 0)
    (C_Ω : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    [AlgebraicGeometry.IsIntegral C_Ω.left]
    (hProj : IsProjectiveOverField Ω C_Ω)
    [AlgebraicGeometry.IsProper C_Ω.hom]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_Ω.hom]
    (γ₀ : weilEtaleTorsionH C_Ω.left ℓ 1)
    (hγ₀ : γ₀ ≠ 0) :
    ∃ (M : ℕ)
      (Q : Fin M → {x : ↥C_Ω.left // IsClosed ({x} : Set ↥C_Ω.left)})
      (P₀ : {x : ↥C_Ω.left // IsClosed ({x} : Set ↥C_Ω.left)}),
      ∀ (N_cov : ℕ) (_ : 1 ≤ N_cov)
        (V : Fin N_cov → C_Ω.left.Opens),
        (⨆ α : Fin N_cov, V α) = ⊤ →
        (∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (V α)) →
        ∀ (h_Q : Fin M → ∀ α : Fin N_cov, ↑(C_Ω.left.presheaf.obj (Opposite.op (V α))))
          (h_P₀ : ∀ α : Fin N_cov, ↑(C_Ω.left.presheaf.obj (Opposite.op (V α))))
          (r_Q : Fin M → ∀ α β : Fin N_cov,
            Units ↑(C_Ω.left.presheaf.obj (Opposite.op (V α ⊓ V β))))
          (r_P₀ : ∀ α β : Fin N_cov,
            Units ↑(C_Ω.left.presheaf.obj (Opposite.op (V α ⊓ V β)))),
          (∀ (j : Fin M) (α β : Fin N_cov),
            (r_Q j α β).1 *
              (C_Ω.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h_Q j β) =
            (C_Ω.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h_Q j α)) →
          (∀ α β : Fin N_cov,
            (r_P₀ α β).1 *
              (C_Ω.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h_P₀ β) =
            (C_Ω.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h_P₀ α)) →
          (∀ (j : Fin M) (α : Fin N_cov)
              (x : {x : ↥C_Ω.left // IsClosed ({x} : Set ↥C_Ω.left)})
              (hx : x.1 ∈ V α),
            (x = Q j →
              Ideal.span {(C_Ω.left.presheaf.germ (V α) x.1 hx).hom (h_Q j α)} =
                IsLocalRing.maximalIdeal ↑(C_Ω.left.presheaf.stalk x.1)) ∧
            (x ≠ Q j →
              Ideal.span {(C_Ω.left.presheaf.germ (V α) x.1 hx).hom (h_Q j α)} = ⊤)) →
          (∀ (α : Fin N_cov)
              (x : {x : ↥C_Ω.left // IsClosed ({x} : Set ↥C_Ω.left)})
              (hx : x.1 ∈ V α),
            (x = P₀ →
              Ideal.span {(C_Ω.left.presheaf.germ (V α) x.1 hx).hom (h_P₀ α)} =
                IsLocalRing.maximalIdeal ↑(C_Ω.left.presheaf.stalk x.1)) ∧
            (x ≠ P₀ →
              Ideal.span {(C_Ω.left.presheaf.germ (V α) x.1 hx).hom (h_P₀ α)} = ⊤)) →
          ∃ (u_Ω : ∀ α : Fin N_cov, Units ↑(C_Ω.left.presheaf.obj (Opposite.op (V α)))),
            (letI : IrreducibleSpace ↥C_Ω.left :=
              AlgebraicGeometry.irreducibleSpace_of_isIntegral C_Ω.left
             ∀ (α : Fin N_cov) [Nonempty ↥(V α : AlgebraicGeometry.Scheme.{u})]
               (b : ↑C_Ω.left.functionField),
               b ^ ℓ ≠ (C_Ω.left.germToFunctionField (V α)).hom (u_Ω α).1) ∧
            (∀ α β : Fin N_cov,
              let g_Ω : Units ↑(C_Ω.left.presheaf.obj (Opposite.op (V α ⊓ V β))) :=
                (Finset.univ.prod fun j : Fin M => (r_Q j α β)⁻¹) * (r_P₀ α β) ^ M
              (g_Ω.1 ^ ℓ) *
                (C_Ω.left.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u_Ω β).1 =
              (C_Ω.left.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u_Ω α).1) ∧
            (∀ (Z_Ω : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
                [AlgebraicGeometry.IsIntegral Z_Ω.left],
              IsProjectiveOverField Ω Z_Ω →
              ∀ [AlgebraicGeometry.IsProper Z_Ω.hom]
                [AlgebraicGeometry.SmoothOfRelativeDimension 1 Z_Ω.hom]
                (ν : Quiver.Hom Z_Ω.left C_Ω.left),
                CategoryTheory.CategoryStruct.comp ν C_Ω.hom = Z_Ω.hom →
                ∀ [AlgebraicGeometry.IsFinite ν]
                  [AlgebraicGeometry.Surjective ν]
                  (α₀ : Fin N_cov) [Nonempty ↥(V α₀ : AlgebraicGeometry.Scheme.{u})]
                  (c_Ω : Units Ω)
                  (x₀ : ↑(Z_Ω.left.presheaf.obj
                    (Opposite.op ((TopologicalSpace.Opens.map ν.base).obj (V α₀))))),
                  x₀ ^ ℓ = (ν.app (V α₀)).hom
                    ((((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                        (C_Ω.hom).appLE ⊤ (V α₀) (fun _ _ => trivial)).hom c_Ω.1) *
                      (u_Ω α₀).1) →
                  ∀ (p_ν : weilEtaleTorsionH C_Ω.left ℓ 1 →+ weilEtaleTorsionH Z_Ω.left ℓ 1),
                    WeilIsTorsionEtalePullback ν ℓ 1 p_ν →
                    p_ν γ₀ = 0) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)

  
  obtain ⟨ζ, hζ⟩ : ∃ ζ : Units Ω, IsPrimitiveRoot ((ζ : Units Ω) : Ω) ℓ := by
    have : NeZero (ℓ : Ω) := ⟨hℓ⟩
    have hdeg : (Polynomial.cyclotomic ℓ Ω).degree ≠ 0 := by
      rw [Polynomial.degree_cyclotomic]
      have htot : 0 < Nat.totient ℓ := by
        rw [Nat.totient_prime hPrime]
        have := hPrime.one_lt
        omega
      exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt htot)
    obtain ⟨z, hz_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ Ω) hdeg
    have hz_prim : IsPrimitiveRoot z ℓ :=
      (Polynomial.isRoot_cyclotomic_iff (R := Ω) (n := ℓ)).mp hz_root
    have hz_ne : z ≠ 0 := by
      intro h0
      have h1 := hz_prim.pow_eq_one
      rw [h0, zero_pow hPrime.ne_zero] at h1
      exact zero_ne_one h1
    exact ⟨Units.mk0 z hz_ne, hz_prim⟩

  have hProperCompSep :
      ∀ (X : CategoryTheory.Over S_Ω) [AlgebraicGeometry.IsProper X.hom],
        CompactSpace ↥X.left ∧ X.left.IsSeparated := by
    intro X _
    have hComp : CompactSpace ↥X.left :=
      AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace X.hom
    have hSep_S : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from S_Ω) :=
      (AlgebraicGeometry.Scheme.isSeparated_iff S_Ω).mp inferInstance
    have hTerm_eq :
        CategoryTheory.Limits.terminal.from X.left =
          X.hom ≫ CategoryTheory.Limits.terminal.from S_Ω :=
      CategoryTheory.Limits.terminal.hom_ext _ _
    have hSep_X : AlgebraicGeometry.IsSeparated (CategoryTheory.Limits.terminal.from X.left) := by
      rw [hTerm_eq]
      infer_instance
    exact ⟨hComp, (AlgebraicGeometry.Scheme.isSeparated_iff X.left).mpr hSep_X⟩

  
  obtain ⟨hComp_C, hSep_C⟩ := hProperCompSep C_Ω
  let _ : CompactSpace ↥C_Ω.left := hComp_C
  let _ : C_Ω.left.IsSeparated := hSep_C
  have hGm : ∀ Z : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf Z.smallEtaleTopology (weilEtaleGmPresheaf Z) :=
    weil_etale_gm_isSheaf_and_proj_H0_divisible.1
  have hPinPkg := weil_etale_pinned_kummer_and_generic_gm_pullback_squares Ω ℓ hℓ ζ hζ hGm
  obtain ⟨ι_kum_C, h0_kum_C, ι_gm_C, k_hom_C, hSE_kum_C, hPin_kum_C, hPin_gm_C,
      ⟨hBij_k_C, hPin_k_C⟩⟩ := hPinPkg.1 C_Ω
  obtain ⟨hSub_K1_C, Div_sh_C, div_mor_C, h0_div_C, e_Div0_C, hSE_div_C, hMono_Div_C,
      hDiv_eval_C⟩ :=
    weil_smooth_qc_sep_curve_canonical_divisor_short_exact Ω hGm C_Ω ι_gm_C k_hom_C
      hPin_gm_C hPin_k_C
  let _ : Subsingleton ((weilEtaleKSheaf C_Ω.left).H 1) := hSub_K1_C
  let _ : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id Div_sh_C) :=
    hMono_Div_C ℓ hPrime.pos

  obtain ⟨delta_sys, hDelta_props, hDelta_pull⟩ :=
    weil_abelian_kummer_divisor_pullback_h1_bridge.{u} ℓ
  obtain ⟨hDelta_add_C, hDelta_surj_C, hDelta_ker_C⟩ :=
    hDelta_props C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
      ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C

  let Pt := {x : ↥C_Ω.left // IsClosed ({x} : Set ↥C_Ω.left)}
  let K_C := ↑C_Ω.left.functionField
  let Fℤ_C := (CategoryTheory.constantSheaf C_Ω.left.smallEtaleTopology AddCommGrpCat.{u}).obj
    (AddCommGrpCat.of (ULift.{u} ℤ))
  let post_div_C : (weilEtaleKSheaf C_Ω.left).H 0 →+ Div_sh_C.H 0 :=
    (CategoryTheory.Abelian.Ext.mk₀ div_mor_C).postcomp Fℤ_C (Nat.add_zero 0)
  let Φ_C : Additive (Units K_C) →+ (Pt →₀ ℤ) :=
    e_Div0_C.toAddMonoidHom.comp (post_div_C.comp k_hom_C)

  have hSub_le : weilCurvePrincipalSubgroup C_Ω.left ≤ Φ_C.range := by
    rw [weilCurvePrincipalSubgroup, AddSubgroup.closure_le]
    rintro D ⟨f, hf⟩
    refine ⟨Additive.ofMul f, ?_⟩
    ext x
    obtain ⟨a, b, na, nb, ha, hb, hab, ha_sp, hb_sp, hDx⟩ := hf x
    rw [hDx]
    exact ((hDiv_eval_C f).2 x).2 a b na nb ha hb hab ha_sp hb_sp

  obtain ⟨κ₀, hκ₀, hγ₀_eq⟩ := hDelta_surj_C γ₀
  obtain ⟨δ₀, hδ₀⟩ := hκ₀
  obtain ⟨f₀_add, hf₀_add⟩ := hBij_k_C.2 κ₀
  let f₀ : Units K_C := Additive.toMul f₀_add
  have hf₀_k : k_hom_C (Additive.ofMul f₀) = κ₀ := hf₀_add
  let D₀ : Pt →₀ ℤ := e_Div0_C δ₀
  have hf₀_div : Φ_C (Additive.ofMul f₀) = ℓ • D₀ := by
    change e_Div0_C ((k_hom_C (Additive.ofMul f₀)).comp
      (CategoryTheory.Abelian.Ext.mk₀ div_mor_C) (Nat.add_zero 0)) = ℓ • D₀
    rw [hf₀_k, hδ₀, map_nsmul]
  have hf₀_mem : Φ_C (Additive.ofMul f₀) ∈ weilCurvePrincipalSubgroup C_Ω.left :=
    (hDiv_eval_C f₀).1

  obtain ⟨deg_Cl, P₀, M, _, _, hSurj_Cl⟩ :=
    weil_smooth_proj_curve_principal_deg_zero_and_riemann_surj Ω C_Ω hProj

  let π_Cl := QuotientAddGroup.mk' (weilCurvePrincipalSubgroup C_Ω.left)
  let c₀ : weilCurveClGroup C_Ω.left := π_Cl D₀
  have hc₀_tor : ℓ • c₀ = 0 := by
    change π_Cl (ℓ • D₀) = 0
    rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff, ← hf₀_div]
    exact hf₀_mem
  have hdeg0 : deg_Cl c₀ = 0 := by
    have h0 : ℓ • deg_Cl c₀ = 0 := by
      rw [← map_nsmul, hc₀_tor, map_zero]
    rw [nsmul_eq_mul] at h0
    rcases mul_eq_zero.mp h0 with hℓ0 | hc0
    · exact absurd (Int.ofNat_inj.mp hℓ0) hPrime.ne_zero
    · exact hc0
  obtain ⟨Q, hQ⟩ := hSurj_Cl c₀ hdeg0
  let D_target : Pt →₀ ℤ :=
    (Finset.univ.sum fun j : Fin M => Finsupp.single (Q j) (1 : ℤ)) -
      Finsupp.single P₀ (M : ℤ)
  have hdiff_mem : D_target - D₀ ∈ weilCurvePrincipalSubgroup C_Ω.left := by
    rw [← QuotientAddGroup.eq_zero_iff, ← QuotientAddGroup.mk'_apply, map_sub, hQ, sub_self]
  obtain ⟨g_add, hg_add⟩ := hSub_le hdiff_mem
  let g_rat : Units K_C := Additive.toMul g_add
  let f_rat : Units K_C := f₀ * g_rat ^ ℓ
  have hf_rat_div : Φ_C (Additive.ofMul f_rat) = ℓ • D_target := by
    have hg_eq : Φ_C (Additive.ofMul g_rat) = D_target - D₀ := hg_add
    have hmul : Additive.ofMul (f₀ * g_rat ^ ℓ) = Additive.ofMul f₀ + ℓ • Additive.ofMul g_rat := by
      rw [ofMul_mul, ofMul_pow]
    change Φ_C (Additive.ofMul (f₀ * g_rat ^ ℓ)) = ℓ • D_target
    rw [hmul, map_add, map_nsmul, hf₀_div, hg_eq, ← nsmul_add, add_sub_cancel]

  let κ_g : (weilEtaleKSheaf C_Ω.left).H 0 := k_hom_C (Additive.ofMul g_rat)
  let κ_f : (weilEtaleKSheaf C_Ω.left).H 0 := k_hom_C (Additive.ofMul f_rat)
  have hκ_f_sum : κ_f = κ₀ + ℓ • κ_g := by
    dsimp [κ_f, κ_g, f_rat]
    rw [map_add, map_nsmul, hf₀_k]
  have hκ_gℓ : ∃ δ : Div_sh_C.H 0,
      (ℓ • κ_g).comp (CategoryTheory.Abelian.Ext.mk₀ div_mor_C) (Nat.add_zero 0) = ℓ • δ :=
    ⟨post_div_C κ_g, map_nsmul post_div_C ℓ κ_g⟩
  have hκ_sum : ∃ δ : Div_sh_C.H 0,
      (κ₀ + ℓ • κ_g).comp (CategoryTheory.Abelian.Ext.mk₀ div_mor_C) (Nat.add_zero 0) = ℓ • δ :=
    ⟨δ₀ + post_div_C κ_g, by
      change post_div_C (κ₀ + ℓ • κ_g) = ℓ • (δ₀ + post_div_C κ_g)
      rw [map_add, map_nsmul, nsmul_add]
      exact congrArg (· + ℓ • post_div_C κ_g) hδ₀⟩
  have hκ_f : ∃ δ : Div_sh_C.H 0,
      κ_f.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor_C) (Nat.add_zero 0) = ℓ • δ := by
    rw [hκ_f_sum]
    exact hκ_sum
  have hDelta_f_eq :
      delta_sys C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
        ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C κ_f hκ_f = γ₀ := by
    have hker_g :
        delta_sys C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
          ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C (ℓ • κ_g) hκ_gℓ = 0 :=
      (hDelta_ker_C (ℓ • κ_g) hκ_gℓ).mpr ⟨κ_g, rfl⟩
    have hsum_eq :
        delta_sys C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
          ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C (κ₀ + ℓ • κ_g) hκ_sum =
          γ₀ := by
      rw [hDelta_add_C κ₀ (ℓ • κ_g) ⟨δ₀, hδ₀⟩ hκ_gℓ hκ_sum, hγ₀_eq, hker_g, add_zero]
    have hcongr : ∀ (κ' : (weilEtaleKSheaf C_Ω.left).H 0) (_ : κ' = κ₀ + ℓ • κ_g)
        (hκ' : ∃ δ : Div_sh_C.H 0,
          κ'.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor_C) (Nat.add_zero 0) = ℓ • δ),
        delta_sys C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
          ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C κ' hκ' =
        delta_sys C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
          ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C (κ₀ + ℓ • κ_g) hκ_sum := by
      rintro _ rfl _
      rfl
    exact (hcongr κ_f hκ_f_sum hκ_f).trans hsum_eq

  have hf_no_root : ∀ b : K_C, b ^ ℓ ≠ (f_rat : K_C) := by
    intro b hb
    have hb_ne : b ≠ 0 := by
      intro h0
      rw [h0, zero_pow hPrime.ne_zero] at hb
      exact f_rat.ne_zero hb.symm
    let b_u : Units K_C := Units.mk0 b hb_ne
    have hbu_pow : b_u ^ ℓ = f_rat := Units.ext hb
    have hk_pow : ℓ • k_hom_C (Additive.ofMul b_u) = κ_f := by
      dsimp [κ_f]
      rw [← hbu_pow, ofMul_pow, map_nsmul]
    have h0 :
        delta_sys C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
          ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C κ_f hκ_f = 0 :=
      (hDelta_ker_C κ_f hκ_f).mpr ⟨k_hom_C (Additive.ofMul b_u), hk_pow⟩
    exact hγ₀ (hDelta_f_eq.symm.trans h0)

  have hf_stalk : ∀ x : Pt,
      let Rx := ↑(C_Ω.left.presheaf.stalk x.1)
      let mx := IsLocalRing.maximalIdeal Rx
      ∃ (a b : Rx) (na nb : ℕ),
        a ≠ 0 ∧ b ≠ 0 ∧
        algebraMap Rx K_C a = (f_rat : K_C) * algebraMap Rx K_C b ∧
        Ideal.span ({a} : Set Rx) = mx ^ na ∧
        Ideal.span ({b} : Set Rx) = mx ^ nb ∧
        (na : ℤ) - (nb : ℤ) = (ℓ : ℤ) * (D_target x) := by
    intro x
    obtain ⟨a, b, na, nb, ha, hb, hab, ha_sp, hb_sp, hd_x⟩ := ((hDiv_eval_C f_rat).2 x).1
    refine ⟨a, b, na, nb, ha, hb, hab, ha_sp, hb_sp, ?_⟩
    have hΦ_x : Φ_C (Additive.ofMul f_rat) x = (ℓ : ℤ) * (D_target x) := by
      rw [hf_rat_div, Finsupp.smul_apply, nsmul_eq_mul]
    exact hd_x.symm.trans hΦ_x

  
  refine ⟨M, Q, P₀, ?_⟩
  intro N_cov _ V _ hV_aff h_Q h_P₀ r_Q r_P₀ hr_Q hr_P₀ hStalk_Q hStalk_P₀
  let _ : IrreducibleSpace ↥C_Ω.left := AlgebraicGeometry.irreducibleSpace_of_isIntegral C_Ω.left
  have hSub_Ω : Subsingleton ↥S_Ω := by
    change Subsingleton (PrimeSpectrum Ω)
    infer_instance
  let pt_Ω : ↥S_Ω := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω)

  have hGerm_stalk : ∀ (U : C_Ω.left.Opens) [Nonempty ↥(U : AlgebraicGeometry.Scheme.{u})]
      (x : ↥C_Ω.left) (hx : x ∈ U) (s : ↑(C_Ω.left.presheaf.obj (Opposite.op U))),
      algebraMap (↑(C_Ω.left.presheaf.stalk x)) K_C
        ((C_Ω.left.presheaf.germ U x hx).hom s) =
      (C_Ω.left.germToFunctionField U).hom s := by
    intro U _ x hx s
    have hspec : genericPoint ↥C_Ω.left ⤳ x :=
      (genericPoint_spec ↥C_Ω.left).specializes trivial
    change (C_Ω.left.presheaf.germ U x hx ≫
      C_Ω.left.presheaf.stalkSpecializes hspec).hom s =
      (C_Ω.left.germToFunctionField U).hom s
    rw [TopCat.Presheaf.germ_stalkSpecializes]

  have hChart : ∀ (α : Fin N_cov) [Nonempty ↥(V α : AlgebraicGeometry.Scheme.{u})],
      let ι_α := (C_Ω.left.germToFunctionField (V α)).hom
      ∃ u_α : Units ↑(C_Ω.left.presheaf.obj (Opposite.op (V α))),
        (∀ j : Fin M, ι_α (h_Q j α) ≠ 0) ∧
        ι_α (h_P₀ α) ≠ 0 ∧
        ι_α u_α.1 * (Finset.univ.prod fun j : Fin M => (ι_α (h_Q j α)) ^ ℓ) =
          (f_rat : K_C) * (ι_α (h_P₀ α)) ^ (ℓ * M) := by
    intro α _
    let A_cat := C_Ω.left.presheaf.obj (Opposite.op (V α))
    let A_α := ↑A_cat
    let ι_α : A_α →+* K_C := (C_Ω.left.germToFunctionField (V α)).hom
    have hInj_α : Function.Injective ι_α :=
      AlgebraicGeometry.Scheme.germToFunctionField_injective C_Ω.left (V α)
    have : IsDomain A_α := Function.Injective.isDomain ι_α hInj_α
    have : IsFractionRing A_α K_C :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen C_Ω.left (V α) (hV_aff α)

    have hMaxPt : ∀ (m : Ideal A_α) (hm : m.IsMaximal),
        m ≠ ⊥ ∧
        ∃ (pt_m : Pt) (hx_m : pt_m.1 ∈ V α),
          (hV_aff α).primeIdealOf ⟨pt_m.1, hx_m⟩ = ⟨m, hm.isPrime⟩ := by
      intro m hm
      let p_α : AlgebraicGeometry.Spec A_cat ⟶ S_Ω := (hV_aff α).fromSpec ≫ C_Ω.hom
      let φ_cat : CommRingCat.of Ω ⟶ A_cat := AlgebraicGeometry.Spec.preimage p_α
      have hmap_φ : AlgebraicGeometry.Spec.map φ_cat = p_α :=
        AlgebraicGeometry.Spec.map_preimage p_α
      have hFT_hom : RingHom.FiniteType φ_cat.hom := by
        rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
        infer_instance
      let alg_A : Algebra Ω A_α := φ_cat.hom.toAlgebra
      have hFT_alg : Algebra.FiniteType Ω A_α := hFT_hom
      obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
      let q_hom : MvPolynomial (Fin n_mv) Ω →+* A_α := q_mv.toRingHom
      let m_mv : Ideal (MvPolynomial (Fin n_mv) Ω) := Ideal.comap q_hom m
      have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_surj
      obtain ⟨a_pt, ha_pt⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
      let ev_hom : MvPolynomial (Fin n_mv) Ω →+* Ω := (MvPolynomial.aeval a_pt).toRingHom
      have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
        intro f_p hf_p
        rw [RingHom.mem_ker] at hf_p
        have hmem : f_p ∈ m_mv := by
          change q_hom f_p ∈ m
          rw [hf_p]
          exact m.zero_mem
        rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
      let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_surj
      let σ_m : A_α →+* Ω :=
        (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
      have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) Ω, σ_m (q_hom f_p) = ev_hom f_p := by
        intro f_p
        dsimp [σ_m]
        have heq_q : e_quot.symm (q_hom f_p) = Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
          apply e_quot.injective
          simp [e_quot]
        rw [heq_q, Ideal.Quotient.lift_mk]
      have hσ_ret : ∀ c : Ω, σ_m (φ_cat.hom c) = c := by
        intro c
        change σ_m (algebraMap Ω A_α c) = c
        rw [← q_mv.commutes c]
        change σ_m (q_hom (MvPolynomial.C c)) = c
        rw [hσ_qhom]
        exact (MvPolynomial.aeval a_pt).commutes c
      have hker_σ : RingHom.ker σ_m = m := by
        ext b
        obtain ⟨f_p, rfl⟩ := hq_surj b
        change σ_m (q_hom f_p) = 0 ↔ q_hom f_p ∈ m
        rw [hσ_qhom]
        change (MvPolynomial.aeval a_pt) f_p = 0 ↔ q_hom f_p ∈ m
        rw [← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← ha_pt]
        rfl
      have hm_ne_bot : m ≠ ⊥ := by
        intro hm_bot
        have hσ_inj : Function.Injective σ_m := by
          intro b₁ b₂ hb
          apply sub_eq_zero.mp
          have hmem : b₁ - b₂ ∈ RingHom.ker σ_m := by
            rw [RingHom.mem_ker, map_sub, hb, sub_self]
          rwa [hker_σ, hm_bot, Ideal.mem_bot] at hmem
        have hφ_surj : Function.Surjective φ_cat.hom := fun b =>
          ⟨σ_m b, hσ_inj (hσ_ret (σ_m b))⟩
        obtain ⟨⟨num_f, den_f⟩, hsurj_f⟩ :=
          IsLocalization.surj (nonZeroDivisors A_α) (f_rat : K_C)
        have hden_ne : (den_f : A_α) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp den_f.2
        obtain ⟨c_num, hc_num⟩ := hφ_surj num_f
        obtain ⟨c_den, hc_den⟩ := hφ_surj den_f.1
        have hc_den_ne : c_den ≠ 0 := by
          intro hc0
          apply hden_ne
          rw [← hc_den, hc0, map_zero]
        have hmul_c : φ_cat.hom (c_num * c_den⁻¹) * den_f.1 = num_f := by
          rw [← hc_den, ← map_mul, inv_mul_cancel_right₀ hc_den_ne, hc_num]
        have hf_eq : (f_rat : K_C) = ι_α (φ_cat.hom (c_num * c_den⁻¹)) := by
          have hden_K : algebraMap A_α K_C den_f.1 ≠ 0 :=
            fun h0 => hden_ne (hInj_α (h0.trans (map_zero ι_α).symm))
          apply mul_right_cancel₀ hden_K
          rw [hsurj_f]
          change ι_α num_f = ι_α (φ_cat.hom (c_num * c_den⁻¹)) * ι_α den_f.1
          rw [← map_mul, hmul_c]
        obtain ⟨d_Ω, hd_Ω⟩ := IsAlgClosed.exists_pow_nat_eq (c_num * c_den⁻¹) hPrime.pos
        apply hf_no_root (ι_α (φ_cat.hom d_Ω))
        rw [← map_pow, ← map_pow, hd_Ω, hf_eq]
      let q_m : PrimeSpectrum A_α := ⟨m, hm.isPrime⟩
      let x_m : ↥C_Ω.left := (hV_aff α).fromSpec.base q_m
      have hx_m : x_m ∈ V α := by
        change x_m ∈ (V α : Set ↥C_Ω.left)
        rw [← (hV_aff α).range_fromSpec]
        exact ⟨q_m, rfl⟩
      let s_C : S_Ω ⟶ C_Ω.left :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_m) ≫ (hV_aff α).fromSpec
      have hφ_σ : φ_cat ≫ CommRingCat.ofHom σ_m = 𝟙 (CommRingCat.of Ω) := by
        ext c
        exact hσ_ret c
      have hs_sec : s_C ≫ C_Ω.hom = 𝟙 S_Ω := by
        dsimp [s_C]
        rw [CategoryTheory.Category.assoc]
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_m) ≫ p_α = 𝟙 S_Ω
        rw [← hmap_φ, ← AlgebraicGeometry.Spec.map_comp, hφ_σ, AlgebraicGeometry.Spec.map_id]
      have : AlgebraicGeometry.IsClosedImmersion (s_C ≫ C_Ω.hom) := by
        rw [hs_sec]
        infer_instance
      have : AlgebraicGeometry.IsClosedImmersion s_C :=
        AlgebraicGeometry.IsClosedImmersion.of_comp s_C C_Ω.hom
      have hs_pt : s_C.base pt_Ω = x_m := by
        have hspec_eq : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_m)).base pt_Ω = q_m := by
          apply PrimeSpectrum.ext
          change Ideal.comap σ_m ⊥ = m
          rwa [← RingHom.ker_eq_comap_bot]
        change (hV_aff α).fromSpec.base
          ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_m)).base pt_Ω) = x_m
        rw [hspec_eq]
      have hrange_s : Set.range s_C.base = ({x_m} : Set ↥C_Ω.left) := by
        ext y
        simp only [Set.mem_range, Set.mem_singleton_iff]
        constructor
        · rintro ⟨z, rfl⟩
          rw [hSub_Ω.elim z pt_Ω, hs_pt]
        · rintro rfl
          exact ⟨pt_Ω, hs_pt⟩
      have hx_cl : IsClosed ({x_m} : Set ↥C_Ω.left) := by
        rw [← hrange_s]
        exact s_C.isClosedEmbedding.isClosed_range
      have hprime_eq : (hV_aff α).primeIdealOf ⟨x_m, hx_m⟩ = q_m := by
        apply (hV_aff α).fromSpec.isOpenEmbedding.injective
        exact (hV_aff α).fromSpec_primeIdealOf ⟨x_m, hx_m⟩
      exact ⟨hm_ne_bot, ⟨x_m, hx_cl⟩, hx_m, hprime_eq⟩

    obtain ⟨m₀, hm₀⟩ := Ideal.exists_maximal A_α
    obtain ⟨hm₀_ne, pt₀, hx₀, hprime₀⟩ := hMaxPt m₀ hm₀
    let Rx₀ := ↑(C_Ω.left.presheaf.stalk pt₀.1)
    let mx₀ := IsLocalRing.maximalIdeal Rx₀
    have hInj_Rx₀ : Function.Injective (algebraMap Rx₀ K_C) :=
      IsFractionRing.injective Rx₀ K_C
    have hInj_germ₀ : Function.Injective (C_Ω.left.presheaf.germ (V α) pt₀.1 hx₀).hom := by
      intro a₁ a₂ ha
      apply hInj_α
      rw [← hGerm_stalk (V α) pt₀.1 hx₀ a₁, ← hGerm_stalk (V α) pt₀.1 hx₀ a₂, ha]
    have hmx₀_ne : mx₀ ≠ ⊥ := by
      intro hbot
      have hLoc₀ := (hV_aff α).isLocalization_stalk ⟨pt₀.1, hx₀⟩
      rw [hprime₀] at hLoc₀
      let _ : Algebra A_α Rx₀ := (C_Ω.left.presheaf.germ (V α) pt₀.1 hx₀).hom.toAlgebra
      have : IsLocalization.AtPrime Rx₀ m₀ := hLoc₀
      have hcomap : Ideal.under A_α mx₀ = m₀ :=
        IsLocalization.AtPrime.under_maximalIdeal Rx₀ m₀
      rw [hbot] at hcomap
      have hker : Ideal.under A_α (⊥ : Ideal Rx₀) = ⊥ := by
        ext a
        simp only [Ideal.mem_comap, Ideal.mem_bot]
        exact ⟨fun ha => hInj_germ₀ (ha.trans (map_zero _).symm), fun ha => by rw [ha, map_zero]⟩
      exact hm₀_ne (hcomap.symm.trans hker)
    have hq_ne : ∀ j : Fin M, ι_α (h_Q j α) ≠ 0 := by
      intro j h0
      have hg0 : (C_Ω.left.presheaf.germ (V α) pt₀.1 hx₀).hom (h_Q j α) = 0 := by
        apply hInj_Rx₀
        rw [hGerm_stalk (V α) pt₀.1 hx₀, h0, map_zero]
      have hsp0 : Ideal.span {(C_Ω.left.presheaf.germ (V α) pt₀.1 hx₀).hom (h_Q j α)} = ⊥ := by
        rw [hg0, Set.singleton_zero, Ideal.span_zero]
      by_cases hptQ : pt₀ = Q j
      · exact hmx₀_ne (((hStalk_Q j α pt₀ hx₀).1 hptQ).symm.trans hsp0)
      · exact top_ne_bot (((hStalk_Q j α pt₀ hx₀).2 hptQ).symm.trans hsp0)
    have hp_ne : ι_α (h_P₀ α) ≠ 0 := by
      intro h0
      have hg0 : (C_Ω.left.presheaf.germ (V α) pt₀.1 hx₀).hom (h_P₀ α) = 0 := by
        apply hInj_Rx₀
        rw [hGerm_stalk (V α) pt₀.1 hx₀, h0, map_zero]
      have hsp0 : Ideal.span {(C_Ω.left.presheaf.germ (V α) pt₀.1 hx₀).hom (h_P₀ α)} = ⊥ := by
        rw [hg0, Set.singleton_zero, Ideal.span_zero]
      by_cases hptP : pt₀ = P₀
      · exact hmx₀_ne (((hStalk_P₀ α pt₀ hx₀).1 hptP).symm.trans hsp0)
      · exact top_ne_bot (((hStalk_P₀ α pt₀ hx₀).2 hptP).symm.trans hsp0)

    let uQ_K : Fin M → Units K_C := fun j => Units.mk0 (ι_α (h_Q j α)) (hq_ne j)
    let uP_K : Units K_C := Units.mk0 (ι_α (h_P₀ α)) hp_ne
    let w_α : Units K_C :=
      f_rat * uP_K ^ (ℓ * M) * (Finset.univ.prod fun j : Fin M => (uQ_K j) ^ ℓ)⁻¹
    have hw_prod :
        (w_α : K_C) * (Finset.univ.prod fun j : Fin M => (ι_α (h_Q j α)) ^ ℓ) =
          (f_rat : K_C) * (ι_α (h_P₀ α)) ^ (ℓ * M) := by
      have hprod_val :
          ((Finset.univ.prod fun j : Fin M => (uQ_K j) ^ ℓ : Units K_C) : K_C) =
            Finset.univ.prod fun j : Fin M => (ι_α (h_Q j α)) ^ ℓ := by
        simp [uQ_K]
      rw [← hprod_val]
      change ((w_α * (Finset.univ.prod fun j : Fin M => (uQ_K j) ^ ℓ) : Units K_C) : K_C) = _
      rw [inv_mul_cancel_right]
      simp [uP_K]

    have hLocalMem : ∀ (m : Ideal A_α), m.IsMaximal →
        (∃ c d : A_α, d ∉ m ∧ (w_α : K_C) * ι_α d = ι_α c) ∧
        (∃ c d : A_α, d ∉ m ∧ ((w_α⁻¹ : Units K_C) : K_C) * ι_α d = ι_α c) := by
      intro m hm
      obtain ⟨_, pt_m, hx_m, hprime_m⟩ := hMaxPt m hm
      let Rx := ↑(C_Ω.left.presheaf.stalk pt_m.1)
      let mx := IsLocalRing.maximalIdeal Rx
      let germ_m := (C_Ω.left.presheaf.germ (V α) pt_m.1 hx_m).hom
      have hInj_Rx : Function.Injective (algebraMap Rx K_C) :=
        IsFractionRing.injective Rx K_C
      let _ : IsDomain Rx := Function.Injective.isDomain (algebraMap Rx K_C) hInj_Rx
      have hLoc_m := (hV_aff α).isLocalization_stalk ⟨pt_m.1, hx_m⟩
      rw [hprime_m] at hLoc_m
      let _ : Algebra A_α Rx := germ_m.toAlgebra
      have : IsLocalization.AtPrime Rx m := hLoc_m
      obtain ⟨a_f, b_f, na_f, nb_f, ha_f, hb_f, hab_f, ha_sp, hb_sp, hord_f⟩ := hf_stalk pt_m
      let q_m : Fin M → Rx := fun j => germ_m (h_Q j α)
      let p_m : Rx := germ_m (h_P₀ α)
      let e_Q : Fin M → ℕ := fun j => if pt_m = Q j then 1 else 0
      let e_P : ℕ := if pt_m = P₀ then 1 else 0
      have hq_sp : ∀ j : Fin M, Ideal.span ({q_m j} : Set Rx) = mx ^ (e_Q j) := by
        intro j
        dsimp [e_Q, q_m, germ_m]
        split_ifs with h
        · rw [pow_one]
          exact (hStalk_Q j α pt_m hx_m).1 h
        · rw [pow_zero, Ideal.one_eq_top]
          exact (hStalk_Q j α pt_m hx_m).2 h
      have hp_sp : Ideal.span ({p_m} : Set Rx) = mx ^ e_P := by
        dsimp [e_P, p_m, germ_m]
        split_ifs with h
        · rw [pow_one]
          exact (hStalk_P₀ α pt_m hx_m).1 h
        · rw [pow_zero, Ideal.one_eq_top]
          exact (hStalk_P₀ α pt_m hx_m).2 h
      have hprod_sp : ∀ s : Finset (Fin M),
          Ideal.span ({s.prod fun j => (q_m j) ^ ℓ} : Set Rx) =
            mx ^ (s.sum fun j => ℓ * e_Q j) := by
        intro s
        induction s using Finset.induction_on with
        | empty =>
          simp [Ideal.one_eq_top]
        | @insert j s hjs ih =>
          rw [Finset.prod_insert hjs, Finset.sum_insert hjs,
            ← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_pow,
            hq_sp j, ih, ← pow_mul, mul_comm (e_Q j) ℓ, ← pow_add]
      let num_x : Rx := a_f * p_m ^ (ℓ * M)
      let den_x : Rx := b_f * (Finset.univ.prod fun j : Fin M => (q_m j) ^ ℓ)
      have hnum_sp : Ideal.span ({num_x} : Set Rx) = mx ^ (na_f + (ℓ * M) * e_P) := by
        dsimp [num_x]
        rw [← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_pow,
          ha_sp, hp_sp, ← pow_mul, mul_comm e_P (ℓ * M), ← pow_add]
      have hden_sp :
          Ideal.span ({den_x} : Set Rx) = mx ^ (nb_f + Finset.univ.sum fun j : Fin M => ℓ * e_Q j) := by
        dsimp [den_x]
        rw [← Ideal.span_singleton_mul_span_singleton, hb_sp, hprod_sp Finset.univ, ← pow_add]
      have hexp_eq : na_f + (ℓ * M) * e_P = nb_f + Finset.univ.sum fun j : Fin M => ℓ * e_Q j := by
        have hD_eval :
            D_target pt_m =
              (Finset.univ.sum fun j : Fin M => (e_Q j : ℤ)) - (M : ℤ) * (e_P : ℤ) := by
          dsimp [D_target]
          rw [Finsupp.finsetSum_apply]
          congr 1
          · refine Finset.sum_congr rfl fun j _ => ?_
            dsimp [e_Q]
            rw [Finsupp.single_apply]
            by_cases h : pt_m = Q j
            · rw [h]; simp
            · have h' : Q j ≠ pt_m := Ne.symm h
              simp [h, h']
          · dsimp [e_P]
            rw [Finsupp.single_apply]
            by_cases h : pt_m = P₀
            · rw [h]; simp
            · have h' : P₀ ≠ pt_m := Ne.symm h
              simp [h, h']
        rw [hD_eval] at hord_f
        apply Int.ofNat_inj.mp
        push_cast
        have hsum_mul :
            (Finset.univ.sum fun j : Fin M => (ℓ : ℤ) * (e_Q j : ℤ)) =
              (ℓ : ℤ) * (Finset.univ.sum fun j : Fin M => (e_Q j : ℤ)) :=
          (Finset.mul_sum _ _ _).symm
        rw [hsum_mul]
        linarith
      have hsp_eq : Ideal.span ({den_x} : Set Rx) = Ideal.span ({num_x} : Set Rx) := by
        rw [hden_sp, hnum_sp, hexp_eq]
      obtain ⟨u_x, hu_x⟩ := Ideal.span_singleton_eq_span_singleton.mp hsp_eq
      have hden_K :
