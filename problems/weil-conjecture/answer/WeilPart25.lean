  have hPiIndep :
      ∀ (T₁ : S₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
        (T₂ : S₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
        (A : AddCommGrpCat.{u}),
        (adj_pull_ℤ.homEquiv (Cℤ_2.obj A) (Cℤ_1.obj A)).symm
          (((CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂).homEquiv A
              (P_push_ℤ.obj (Cℤ_1.obj A))).symm
            (((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁).unit.app A) ≫
              ((Cℤ_1.obj A).obj.map (Opposite.op (hT₁.from (B.obj T₂)))))) =
        π_A_std A := by
    intro T₁ hT₁ T₂ hT₂ A
    congr 1
    apply (adjℤ_std_2.homEquiv A (P_push_ℤ.obj (Cℤ_1.obj A))).injective
    rw [Equiv.apply_symm_apply]
    let ψ_A := ((CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂).homEquiv A
        (P_push_ℤ.obj (Cℤ_1.obj A))).symm
      (((CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁).unit.app A) ≫
        ((Cℤ_1.obj A).obj.map (Opposite.op (hT₁.from (B.obj T₂)))))
    rw [← hConstEquivTerm J₂ hT_std_2 hT₂ A (P_push_ℤ.obj (Cℤ_1.obj A)) ψ_A]
    have hψ_eval : (CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂).homEquiv A
        (P_push_ℤ.obj (Cℤ_1.obj A)) ψ_A =
        (CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁).unit.app A ≫
          (Cℤ_1.obj A).obj.map (Opposite.op (hT₁.from (B.obj T₂))) :=
      Equiv.apply_symm_apply _ _
    rw [hψ_eval]
    let u₀ : A ⟶ (Cℤ_1.obj A).obj.obj (Opposite.op T₁) :=
      (CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁).unit.app A
    change (u₀ ≫ (Cℤ_1.obj A).obj.map (Opposite.op (hT₁.from (B.obj T₂)))) ≫
        (Cℤ_1.obj A).obj.map (Opposite.op (B.map (hT₂.from T_std_2))) =
      (CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT_std_1).unit.app A ≫
        (Cℤ_1.obj A).obj.map τ_std.op
    rw [CategoryTheory.Category.assoc, ← (Cℤ_1.obj A).obj.map_comp]
    have hτ_op : Opposite.op (hT₁.from (B.obj T₂)) ≫ Opposite.op (B.map (hT₂.from T_std_2)) =
        Opposite.op (hT₁.from T_std_1) ≫ τ_std.op :=
