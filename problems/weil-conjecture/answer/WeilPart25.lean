  have hClosedPtSection : ∀ (R : CommRingCat.{u}) (p_R : AlgebraicGeometry.Spec R ⟶ S_k)
      [AlgebraicGeometry.LocallyOfFiniteType p_R]
      (𝔪 : Ideal ↑R) (h𝔪 : 𝔪.IsMaximal),
      ∃ σ : S_k ⟶ AlgebraicGeometry.Spec R,
        σ ≫ p_R = 𝟙 S_k ∧
        σ.base pt_k = (⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum ↑R) := by
    intro R p_R _ 𝔪 h𝔪
    have : 𝔪.IsMaximal := h𝔪
    let φ_k : CommRingCat.of k ⟶ R := AlgebraicGeometry.Spec.preimage p_R
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = p_R :=
      AlgebraicGeometry.Spec.map_preimage p_R
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    letI : Algebra k ↑R := φ_k.hom.toAlgebra
    have : Algebra.FiniteType k ↑R := hFT_hom
    letI : Field (↑R ⧸ 𝔪) := Ideal.Quotient.field 𝔪
    let q_𝔪 : ↑R →ₐ[k] (↑R ⧸ 𝔪) := Ideal.Quotient.mkₐ k 𝔪
    have : Algebra.FiniteType k (↑R ⧸ 𝔪) :=
      Algebra.FiniteType.of_surjective q_𝔪 (Ideal.Quotient.mkₐ_surjective k 𝔪)
    have : Module.Finite k (↑R ⧸ 𝔪) := finite_of_finite_type_of_isJacobsonRing k (↑R ⧸ 𝔪)
    have : Algebra.IsIntegral k (↑R ⧸ 𝔪) := Algebra.IsIntegral.of_finite k (↑R ⧸ 𝔪)
    have h_bij : Function.Bijective ⇑(algebraMap k (↑R ⧸ 𝔪)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral (k := k) (K := ↑R ⧸ 𝔪)
    let e_k : (↑R ⧸ 𝔪) ≃ₐ[k] k :=
      (AlgEquiv.ofBijective (Algebra.ofId k (↑R ⧸ 𝔪)) h_bij).symm
    let τ_R : ↑R →ₐ[k] k := e_k.toAlgHom.comp q_𝔪
    let σ : S_k ⟶ AlgebraicGeometry.Spec R :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R.toRingHom)
    have hφτ : φ_k ≫ CommRingCat.ofHom τ_R.toRingHom = 𝟙 (CommRingCat.of k) :=
      CommRingCat.hom_ext (RingHom.ext τ_R.commutes)
    refine ⟨σ, ?_, ?_⟩
    · calc
        σ ≫ p_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_R.toRingHom) ≫
            AlgebraicGeometry.Spec.map φ_k := by rw [← hmap_φ]
        _ = AlgebraicGeometry.Spec.map (φ_k ≫ CommRingCat.ofHom τ_R.toRingHom) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) :=
            congrArg AlgebraicGeometry.Spec.map hφτ
        _ = 𝟙 S_k := AlgebraicGeometry.Spec.map_id _
    · apply PrimeSpectrum.ext
      ext r
      change τ_R r ∈ (⊥ : Ideal k) ↔ r ∈ 𝔪
      rw [Ideal.mem_bot]
      change e_k (q_𝔪 r) = 0 ↔ r ∈ 𝔪
      rw [map_eq_zero_iff e_k e_k.injective]
      exact Ideal.Quotient.eq_zero_iff_mem

  
  have hEtSecPt : ∀ (P : AlgebraicGeometry.Scheme.{u}) (p : P ⟶ S_k),
      AlgebraicGeometry.Etale p →
      ∀ q : ↥P, ∃ s : S_k ⟶ P, s ≫ p = 𝟙 S_k ∧ s.base pt_k = q := by
    intro P p hp q
    have : AlgebraicGeometry.Etale p := hp
    obtain ⟨O, hAff_O, hq_O, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q)
        (U := (⊤ : P.Opens)) trivial
    let R_w : CommRingCat.{u} := P.presheaf.obj (Opposite.op O)
    let j_w : AlgebraicGeometry.Spec R_w ⟶ P := hAff_O.fromSpec
    have hq_mem : q ∈ Set.range j_w.base := by
      rw [hAff_O.range_fromSpec]
      exact hq_O
    obtain ⟨p_w, hp_w⟩ := hq_mem
    obtain ⟨𝔪_w, h𝔪_max, hp_le⟩ :=
      Ideal.exists_le_maximal p_w.asIdeal p_w.isPrime.ne_top
    let x₀ : ↥(AlgebraicGeometry.Spec R_w) := (⟨𝔪_w, h𝔪_max.isPrime⟩ : PrimeSpectrum ↑R_w)
    have hx₀_cl : x₀ ∈ closure ({p_w} : Set ↥(AlgebraicGeometry.Spec R_w)) :=
      (PrimeSpectrum.le_iff_mem_closure p_w x₀).mp hp_le
    let p_Rw : AlgebraicGeometry.Spec R_w ⟶ S_k := j_w ≫ p
    have hEt_pRw : AlgebraicGeometry.Etale p_Rw := inferInstance
    have : AlgebraicGeometry.LocallyOfFiniteType p_Rw := inferInstance
    obtain ⟨σ, hσ_sec, hσ_pt⟩ := hClosedPtSection R_w p_Rw 𝔪_w h𝔪_max
    have hEt_σcomp : AlgebraicGeometry.Etale (σ ≫ p_Rw) := by
      rw [hσ_sec]
      infer_instance
    have : AlgebraicGeometry.Etale σ :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        σ p_Rw hEt_pRw hEt_σcomp
    have : CategoryTheory.Mono σ :=
      ⟨fun {Z} g₁ g₂ hg =>
        (CategoryTheory.Category.comp_id g₁).symm.trans
          ((congrArg (g₁ ≫ ·) hσ_sec.symm).trans
            ((CategoryTheory.Category.assoc g₁ σ p_Rw).symm.trans
              ((congrArg (· ≫ p_Rw) hg).trans
                ((CategoryTheory.Category.assoc g₂ σ p_Rw).trans
                  ((congrArg (g₂ ≫ ·) hσ_sec).trans
                    (CategoryTheory.Category.comp_id g₂))))))⟩
    have : AlgebraicGeometry.IsOpenImmersion σ :=
      AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono σ
    have hOpen_σ : IsOpen (Set.range σ.base) := σ.isOpenMap.isOpen_range
    obtain ⟨_, ⟨q_k, rfl⟩, hmem_sing⟩ :=
      mem_closure_iff.mp hx₀_cl (Set.range σ.base) hOpen_σ ⟨pt_k, hσ_pt⟩
    have h_eq_pw : σ.base q_k = p_w := hmem_sing
    refine ⟨σ ≫ j_w, (CategoryTheory.Category.assoc σ j_w p).trans hσ_sec, ?_⟩
    change j_w.base (σ.base pt_k) = q
