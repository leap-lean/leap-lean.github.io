    let d_KZ : Units K_Z := Units.map (φ_ν.comp (ι_C.comp σ₀)).toMonoidHom d_u
    have hd_KZ_pow : (d_KZ : K_Z) ^ ℓ = φ_ν (ι_C (σ₀ c_Ω.1)) := by
      change (φ_ν (ι_C (σ₀ d_val))) ^ ℓ = φ_ν (ι_C (σ₀ c_Ω.1))
      rw [← map_pow, ← map_pow, ← map_pow, hd_pow]

    obtain ⟨hq_ne₀, hp_ne₀, hu₀_eq⟩ := hu_spec α₀
    let uQ_C : Fin M → Units K_C := fun j => Units.mk0 (ι_C (h_Q j α₀)) (hq_ne₀ j)
    let uP_C : Units K_C := Units.mk0 (ι_C (h_P₀ α₀)) hp_ne₀
    let u₀_K : Units K_C := Units.map ι_C.toMonoidHom (u_Ω α₀)
    have hu₀_units :
        u₀_K = f_rat * uP_C ^ (ℓ * M) * (Finset.univ.prod fun j : Fin M => (uQ_C j) ^ ℓ)⁻¹ := by
      apply Units.ext
      have hprod_ne : (Finset.univ.prod fun j : Fin M => (ι_C (h_Q j α₀)) ^ ℓ) ≠ 0 := by
        rw [Finset.prod_ne_zero_iff]
        exact fun j _ => pow_ne_zero ℓ (hq_ne₀ j)
      apply mul_right_cancel₀ hprod_ne
      have hprod_val :
          ((Finset.univ.prod fun j : Fin M => (uQ_C j) ^ ℓ : Units K_C) : K_C) =
            Finset.univ.prod fun j : Fin M => (ι_C (h_Q j α₀)) ^ ℓ := by
        simp [uQ_C]
      rw [← hprod_val]
      change (u₀_K : K_C) * ((Finset.univ.prod fun j : Fin M => (uQ_C j) ^ ℓ : Units K_C) : K_C) =
        ((f_rat * uP_C ^ (ℓ * M) * (Finset.univ.prod fun j : Fin M => (uQ_C j) ^ ℓ)⁻¹ *
          (Finset.univ.prod fun j : Fin M => (uQ_C j) ^ ℓ) : Units K_C) : K_C)
      rw [inv_mul_cancel_right, hprod_val]
      exact hu₀_eq
    let ψ_u : Units K_C →* Units K_Z := Units.map φ_ν.toMonoidHom
    have hx₀_K : (ι_Z x₀) ^ ℓ = ((d_KZ ^ ℓ * ψ_u u₀_K : Units K_Z) : K_Z) := by
      have h1 := congrArg ι_Z hx₀_pow
      rw [map_pow, hcomm_ν, map_mul, map_mul, ← hd_KZ_pow] at h1
      exact h1
    have hx₀_ne : ι_Z x₀ ≠ 0 := by
      intro h0
      rw [h0, zero_pow hPrime.ne_zero] at hx₀_K
      exact (d_KZ ^ ℓ * ψ_u u₀_K).ne_zero hx₀_K.symm
    let x_KZ : Units K_Z := Units.mk0 (ι_Z x₀) hx₀_ne
    have hx_units : x_KZ ^ ℓ = d_KZ ^ ℓ * ψ_u u₀_K := Units.ext hx₀_K
    let b_Z : Units K_Z :=
      x_KZ * d_KZ⁻¹ * (Finset.univ.prod fun j : Fin M => ψ_u (uQ_C j)) * (ψ_u uP_C ^ M)⁻¹
    have hb_Z : b_Z ^ ℓ = ψ_u f_rat := by
      calc
        b_Z ^ ℓ
          = x_KZ ^ ℓ * (d_KZ ^ ℓ)⁻¹ *
              (Finset.univ.prod fun j : Fin M => (ψ_u (uQ_C j)) ^ ℓ) *
              ((ψ_u uP_C ^ M) ^ ℓ)⁻¹ := by
              dsimp [b_Z]
              rw [mul_pow, mul_pow, mul_pow, inv_pow, inv_pow, Finset.prod_pow]
        _ = d_KZ ^ ℓ * ψ_u u₀_K * (d_KZ ^ ℓ)⁻¹ *
              (Finset.univ.prod fun j : Fin M => (ψ_u (uQ_C j)) ^ ℓ) *
              (ψ_u uP_C ^ (ℓ * M))⁻¹ := by
              rw [hx_units, ← pow_mul, mul_comm M ℓ]
        _ = ψ_u u₀_K * (Finset.univ.prod fun j : Fin M => (ψ_u (uQ_C j)) ^ ℓ) *
              (ψ_u uP_C ^ (ℓ * M))⁻¹ := by
              rw [mul_right_comm (d_KZ ^ ℓ) (ψ_u u₀_K) (d_KZ ^ ℓ)⁻¹, mul_inv_cancel, one_mul]
        _ = ψ_u f_rat := by
              rw [hu₀_units, map_mul, map_mul, map_inv, map_pow, map_prod]
              simp only [map_pow]
              rw [inv_mul_cancel_right, mul_inv_cancel_right]

    obtain ⟨hComp_Z, hSep_Z⟩ := hProperCompSep Z_Ω
    let _ : CompactSpace ↥Z_Ω.left := hComp_Z
    let _ : Z_Ω.left.IsSeparated := hSep_Z
    obtain ⟨ι_kum_Z, h0_kum_Z, ι_gm_Z, k_hom_Z, hSE_kum_Z, hPin_kum_Z, hPin_gm_Z,
        ⟨_, hPin_k_Z⟩⟩ := hPinPkg.1 Z_Ω
    obtain ⟨hSub_K1_Z, Div_sh_Z, div_mor_Z, h0_div_Z, _, hSE_div_Z, hMono_Div_Z, _⟩ :=
      weil_smooth_qc_sep_curve_canonical_divisor_short_exact Ω hGm Z_Ω ι_gm_Z k_hom_Z
        hPin_gm_Z hPin_k_Z
    let _ : Subsingleton ((weilEtaleKSheaf Z_Ω.left).H 1) := hSub_K1_Z
    let _ : CategoryTheory.Mono (ℓ • CategoryTheory.CategoryStruct.id Div_sh_Z) :=
      hMono_Div_Z ℓ hPrime.pos

    let κ_Z : (weilEtaleKSheaf Z_Ω.left).H 0 := k_hom_Z (Additive.ofMul (ψ_u f_rat))
    have hκ_Z_mul : ℓ • k_hom_Z (Additive.ofMul b_Z) = κ_Z := by
      dsimp [κ_Z]
      rw [← hb_Z, ofMul_pow, map_nsmul]
    let Fℤ_Z := (CategoryTheory.constantSheaf Z_Ω.left.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    let post_div_Z : (weilEtaleKSheaf Z_Ω.left).H 0 →+ Div_sh_Z.H 0 :=
      (CategoryTheory.Abelian.Ext.mk₀ div_mor_Z).postcomp Fℤ_Z (Nat.add_zero 0)
    have hκ_Z : ∃ δ_Z : Div_sh_Z.H 0,
        κ_Z.comp (CategoryTheory.Abelian.Ext.mk₀ div_mor_Z) (Nat.add_zero 0) = ℓ • δ_Z :=
      ⟨post_div_Z (k_hom_Z (Additive.ofMul b_Z)), by
        change post_div_Z κ_Z = _
        rw [← hκ_Z_mul, map_nsmul]⟩
    have hDelta_Z_zero :
        delta_sys Z_Ω.left (weilEtaleGmSheaf Z_Ω.left) (weilEtaleKSheaf Z_Ω.left) Div_sh_Z
          ι_kum_Z h0_kum_Z hSE_kum_Z ι_gm_Z div_mor_Z h0_div_Z hSE_div_Z κ_Z hκ_Z = 0 :=
      ((hDelta_props Z_Ω.left (weilEtaleGmSheaf Z_Ω.left) (weilEtaleKSheaf Z_Ω.left) Div_sh_Z
        ι_kum_Z h0_kum_Z hSE_kum_Z ι_gm_Z div_mor_Z h0_div_Z hSE_div_Z).2.2 κ_Z hκ_Z).mpr
        ⟨k_hom_Z (Additive.ofMul b_Z), hκ_Z_mul⟩

    have hp_eq :
        p_ν (delta_sys C_Ω.left (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
          ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C κ_f hκ_f) =
        delta_sys Z_Ω.left (weilEtaleGmSheaf Z_Ω.left) (weilEtaleKSheaf Z_Ω.left) Div_sh_Z
          ι_kum_Z h0_kum_Z hSE_kum_Z ι_gm_Z div_mor_Z h0_div_Z hSE_div_Z κ_Z hκ_Z := by
      apply hDelta_pull Z_Ω.left C_Ω.left
        (weilEtaleGmSheaf Z_Ω.left) (weilEtaleKSheaf Z_Ω.left) Div_sh_Z
        ι_kum_Z h0_kum_Z hSE_kum_Z ι_gm_Z div_mor_Z h0_div_Z hSE_div_Z
        (weilEtaleGmSheaf C_Ω.left) (weilEtaleKSheaf C_Ω.left) Div_sh_C
        ι_kum_C h0_kum_C hSE_kum_C ι_gm_C div_mor_C h0_div_C hSE_div_C
        ν p_ν hp_ν κ_f hκ_f κ_Z hκ_Z
      intro _ _ _ _ hCont hAdj _ hAdd hLim hColim T₁ hT₁ T₂ hT₂ ιℤ hι₁ hι₂
      obtain ⟨β_G, β_K, hβ_kum, hβ_gm, hβ_k⟩ :=
        hPinPkg.2 Z_Ω C_Ω ι_kum_Z ι_gm_Z k_hom_Z ι_kum_C ι_gm_C k_hom_C ν
          hPin_kum_Z hPin_gm_Z hPin_k_Z hPin_kum_C hPin_gm_C hPin_k_C
          hν_hom h_gen hCont hAdj hAdd hLim hColim T₁ hT₁ T₂ hT₂ ιℤ hι₁ hι₂
      exact ⟨β_G, β_K, hβ_kum, hβ_gm, (hβ_k f_rat).symm⟩

    rw [hDelta_f_eq] at hp_eq
    exact hp_eq.trans hDelta_Z_zero

theorem weil_rel_curve_generic_points_descent_and_dedekind_base (k : Type u) [Field k] [IsAlgClosed k]
    (C_aff : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine C_aff] [AlgebraicGeometry.IsIntegral C_aff]
    (u_C : Quiver.Hom C_aff (weilAffineSpaceOver k 1).left)
    [AlgebraicGeometry.Etale u_C]
    (c₀ : ↥C_aff) (hc₀ : IsClosed ({c₀} : Set ↥C_aff))
    (s_c₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) C_aff)
    (hs_c₀_sec :
      CategoryTheory.CategoryStruct.comp s_c₀
        (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_c₀_range : Set.range s_c₀.base = {c₀})
    (R_dom : Type u) [CommRing R_dom] [IsDomain R_dom]
    (g_dom : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R_dom)) C_aff)
    [AlgebraicGeometry.Etale g_dom]
    (Y_dom : AlgebraicGeometry.Scheme.{u})
    (f_dom : Quiver.Hom Y_dom (AlgebraicGeometry.Spec (CommRingCat.of R_dom)))
    [AlgebraicGeometry.LocallyOfFiniteType f_dom]
    (Y_η : AlgebraicGeometry.Scheme.{u})
    (ι_η : Quiver.Hom Y_η Y_dom)
    (f_η : Quiver.Hom Y_η
      (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure (FractionRing R_dom)))))
    (hPb_η : CategoryTheory.IsPullback ι_η f_η f_dom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (FractionRing R_dom) (AlgebraicClosure (FractionRing R_dom))).comp
          (algebraMap R_dom (FractionRing R_dom))))))
    (m_sec : ℕ)
    (x_η : Fin m_sec → {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)}) :
    let Ω := AlgebraicClosure (FractionRing R_dom)
    ∃ (B₀' : Type u)
      (_ : CommRing B₀')
      (_ : IsDomain B₀')
      (_ : Algebra k B₀')
      (_ : Algebra.FiniteType k B₀')
      (_ : IsDedekindDomain B₀')
      (_ : ¬ IsField B₀')
      (x_nz : B₀')
      (L₁ : Type u)
      (_ : Field L₁)
      (_ : Algebra B₀' L₁)
      (_ : IsFractionRing B₀' L₁)
      (g₀' : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₀')) C_aff)
      (τ₀' : B₀' →ₐ[k] k)
      (ι_L₁_Ω : L₁ →+* Ω)
      (q_L₁_dom : Fin m_sec → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of L₁)) Y_dom)
      (q_η : Fin m_sec → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y_η),
        let ι₀'_Ω : B₀' →+* Ω := ι_L₁_Ω.comp (algebraMap B₀' L₁)
        (x_nz ≠ 0 ∧ τ₀' x_nz = 0) ∧
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀'.toRingHom)) g₀' = s_c₀ ∧
        CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι₀'_Ω)) g₀' =
          CategoryTheory.CategoryStruct.comp
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
              ((algebraMap (FractionRing R_dom) Ω).comp
                (algebraMap R_dom (FractionRing R_dom)))))
            g_dom ∧
        CategoryTheory.CategoryStruct.comp g₀'
          (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₀')) ∧
        (∀ x : Ω, ∃ P : Polynomial B₀', P ≠ 0 ∧ Polynomial.eval₂ ι₀'_Ω x P = 0) ∧
        (∀ a : Fin m_sec,
          CategoryTheory.CategoryStruct.comp (q_L₁_dom a)
            (CategoryTheory.CategoryStruct.comp f_dom g_dom) =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' L₁))) g₀' ∧
          CategoryTheory.CategoryStruct.comp (q_η a) f_η =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
          Set.range (q_η a).base = {(x_η a).1} ∧
          CategoryTheory.CategoryStruct.comp (q_η a) ι_η =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L₁_Ω)) (q_L₁_dom a)) :=
by
  classical
  let _ := c₀; let _ := hc₀; let _ := hs_c₀_range

  
  
  have hEtDomProps :
      ∀ (R₀ B : Type u) [CommRing R₀] [IsDomain R₀] [CommRing B] [IsDomain B]
        [Algebra R₀ B] [Algebra.Etale R₀ B],
        Function.Injective (algebraMap R₀ B) ∧
        (∀ (K₀ K : Type u) [Field K₀] [Field K]
          [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
          [Algebra B K] [IsFractionRing B K]
          [Algebra K₀ K] [Algebra R₀ K]
          [IsScalarTower R₀ K₀ K] [IsScalarTower R₀ B K],
          FiniteDimensional K₀ K) ∧
        (Ring.DimensionLEOne R₀ → Ring.DimensionLEOne B) := by
    intro R₀ B _ _ _ _ _ _
    have hEtFieldFin : ∀ (F E : Type u) [Field F] [CommRing E] [Algebra F E] [Algebra.Etale F E],
        Module.Finite F E := by
      intro F E _ _ _ _
      obtain ⟨I, hFinI, Ai, instFieldAi, instAlgAi, e_prod, hAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod F E).mp inferInstance
      let _ : Fintype I := Fintype.ofFinite I
      let _ := instFieldAi
      let _ := instAlgAi
      have : ∀ i : I, Module.Finite F (Ai i) := fun i => (hAi i).1
      exact Module.Finite.equiv e_prod.symm.toLinearEquiv
    have hInj : Function.Injective (algebraMap R₀ B) := by
      have : Module.IsTorsionFree R₀ B := Module.Flat.isTorsionFree
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro r hr
      rw [RingHom.mem_ker] at hr
      have hsmul : r • (1 : B) = 0 := by
        rw [Algebra.smul_def, hr, zero_mul]
      exact (smul_eq_zero.mp hsmul).resolve_right one_ne_zero
    have hFracFin : ∀ (K₀ K : Type u) [Field K₀] [Field K]
        [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
        [Algebra B K] [IsFractionRing B K]
        [Algebra K₀ K] [Algebra R₀ K]
        [IsScalarTower R₀ K₀ K] [IsScalarTower R₀ B K],
        FiniteDimensional K₀ K := by
      intro K₀ K _ _ _ _ _ _ _ _ _ _
      let E := TensorProduct R₀ K₀ B
      have : Algebra.Etale K₀ E := Algebra.Etale.baseChange R₀ B K₀
      have : Module.Finite K₀ E := hEtFieldFin K₀ E
      let Φ : E →ₐ[K₀] K :=
        Algebra.TensorProduct.lift (Algebra.ofId K₀ K) (IsScalarTower.toAlgHom R₀ B K)
          (fun _ _ => Commute.all _ _)
      have hΦ_tmul : ∀ b : B, Φ (TensorProduct.tmul R₀ (1 : K₀) b) = algebraMap B K b := by
        intro b
        change (Algebra.TensorProduct.lift (Algebra.ofId K₀ K) (IsScalarTower.toAlgHom R₀ B K)
          (fun _ _ => Commute.all _ _)) (TensorProduct.tmul R₀ (1 : K₀) b) = algebraMap B K b
        rw [Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, map_one, one_mul,
          IsScalarTower.coe_toAlgHom']
      have hClear : ∀ z : E, ∃ (s : nonZeroDivisors R₀) (b : B),
          (algebraMap R₀ K₀ s) • z = TensorProduct.tmul R₀ (1 : K₀) b := by
        intro z
        refine TensorProduct.inductionOn z ?_ ?_
        · intro x b₀
          obtain ⟨⟨r, s⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors R₀) x
          refine ⟨s, r • b₀, ?_⟩
          calc
            (algebraMap R₀ K₀ s) • TensorProduct.tmul R₀ x b₀
              = TensorProduct.tmul R₀ (algebraMap R₀ K₀ s * x) b₀ := by
                rw [TensorProduct.smul_tmul', smul_eq_mul]
            _ = TensorProduct.tmul R₀ (algebraMap R₀ K₀ r) b₀ := by
                rw [mul_comm, hsurj]
            _ = TensorProduct.tmul R₀ (r • (1 : K₀)) b₀ := by
                rw [Algebra.smul_def, mul_one]
            _ = TensorProduct.tmul R₀ (1 : K₀) (r • b₀) :=
                TensorProduct.smul_tmul r (1 : K₀) b₀
        · intro z₁ z₂ ⟨s₁, b₁, hz₁⟩ ⟨s₂, b₂, hz₂⟩
          refine ⟨s₁ * s₂, (s₂ : R₀) • b₁ + (s₁ : R₀) • b₂, ?_⟩
          have h1 : (algebraMap R₀ K₀ (s₁ * s₂ : nonZeroDivisors R₀)) • z₁ =
              TensorProduct.tmul R₀ (1 : K₀) ((s₂ : R₀) • b₁) := by
            change (algebraMap R₀ K₀ ((s₁ : R₀) * (s₂ : R₀))) • z₁ = _
            rw [map_mul, mul_comm, mul_smul, hz₁, TensorProduct.smul_tmul', smul_eq_mul,
              ← Algebra.smul_def, TensorProduct.smul_tmul]
          have h2 : (algebraMap R₀ K₀ (s₁ * s₂ : nonZeroDivisors R₀)) • z₂ =
              TensorProduct.tmul R₀ (1 : K₀) ((s₁ : R₀) • b₂) := by
            change (algebraMap R₀ K₀ ((s₁ : R₀) * (s₂ : R₀))) • z₂ = _
            rw [map_mul, mul_smul, hz₂, TensorProduct.smul_tmul', smul_eq_mul,
              ← Algebra.smul_def, TensorProduct.smul_tmul]
          rw [smul_add, h1, h2, ← TensorProduct.tmul_add]
      have hInj_Φ : Function.Injective Φ := by
        rw [← RingHom.coe_coe, RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
        intro z hz
        rw [RingHom.mem_ker] at hz
        change Φ z = 0 at hz
        obtain ⟨s, b, hsb⟩ := hClear z
        have hb_map : algebraMap B K b = 0 := by
          have hΦ_sb := congrArg Φ hsb
          rw [map_smul, hz, smul_zero, hΦ_tmul] at hΦ_sb
          exact hΦ_sb.symm
        have hb0 : b = 0 := IsFractionRing.injective B K (hb_map.trans (map_zero _).symm)
        rw [hb0, TensorProduct.tmul_zero] at hsb
        have hs_ne : (s : R₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
        have hs_K0 : algebraMap R₀ K₀ s ≠ 0 := fun h0 =>
          hs_ne (IsFractionRing.injective R₀ K₀ (h0.trans (map_zero _).symm))
        exact (smul_eq_zero.mp hsb).resolve_left hs_K0
      have : IsDomain E := Function.Injective.isDomain Φ.toRingHom hInj_Φ
      have : Algebra.IsIntegral K₀ E := Algebra.IsIntegral.of_finite K₀ E
      have hFieldE : IsField E :=
        (Algebra.IsIntegral.isField_iff_isField (R := K₀) (S := E)
          (RingHom.injective (algebraMap K₀ E))).mp (Field.toIsField K₀)
      have hSurj_Φ : Function.Surjective Φ := by
        intro y
        obtain ⟨⟨b₁, b₂⟩, hy_surj⟩ := IsLocalization.surj (nonZeroDivisors B) y
        have hb₂_ne : (b₂ : B) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b₂.2
        have hb₂_K : algebraMap B K b₂ ≠ 0 := fun h0 =>
          hb₂_ne (IsFractionRing.injective B K (h0.trans (map_zero _).symm))
        let u₂ : E := TensorProduct.tmul R₀ (1 : K₀) (b₂ : B)
        have hu₂_ne : u₂ ≠ 0 := by
          intro h0
          have hΦ0 : Φ u₂ = 0 := by rw [h0, map_zero]
          exact hb₂_K ((hΦ_tmul (b₂ : B)).symm.trans hΦ0)
        obtain ⟨w, hw⟩ := hFieldE.mul_inv_cancel hu₂_ne
        refine ⟨TensorProduct.tmul R₀ (1 : K₀) b₁ * w, ?_⟩
        apply mul_right_cancel₀ hb₂_K
        calc
          Φ (TensorProduct.tmul R₀ (1 : K₀) b₁ * w) * algebraMap B K b₂
            = Φ (TensorProduct.tmul R₀ (1 : K₀) b₁) * (Φ w * Φ u₂) := by
              rw [map_mul, hΦ_tmul (b₂ : B), mul_assoc]
          _ = Φ (TensorProduct.tmul R₀ (1 : K₀) b₁) * Φ (u₂ * w) := by
              rw [map_mul, mul_comm (Φ w)]
          _ = algebraMap B K b₁ := by
              rw [hw, map_one, mul_one, hΦ_tmul b₁]
          _ = y * algebraMap B K b₂ := hy_surj.symm
      exact Module.Finite.equiv (AlgEquiv.ofBijective Φ ⟨hInj_Φ, hSurj_Φ⟩).toLinearEquiv
    refine ⟨hInj, hFracFin, ?_⟩
    intro hDimR₀
    refine Ring.DimensionLEOne.mk ?_
    intro q hq_ne hq_pr
    have : q.IsPrime := hq_pr
    let K₀ := FractionRing R₀
    let K := FractionRing B
    have hInj_R₀_K : Function.Injective (algebraMap R₀ K) := by
      rw [IsScalarTower.algebraMap_eq R₀ B K]
      exact (IsFractionRing.injective B K).comp hInj
    have : FaithfulSMul R₀ K := (faithfulSMul_iff_algebraMap_injective R₀ K).mpr hInj_R₀_K
    let _ : Algebra K₀ K := FractionRing.liftAlgebra R₀ K
    have : IsScalarTower R₀ K₀ K := FractionRing.isScalarTower_liftAlgebra R₀ K
    have : FiniteDimensional K₀ K := hFracFin K₀ K
    have : Algebra.IsIntegral K₀ K := Algebra.IsIntegral.of_finite K₀ K
    obtain ⟨x, hx_q, hx_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq_ne
    let x_K : K := algebraMap B K x
    have hx_K_ne : x_K ≠ 0 := fun h0 =>
      hx_ne (IsFractionRing.injective B K (h0.trans (map_zero _).symm))
    obtain ⟨m, hm_int⟩ :=
      IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors R₀) (x_K⁻¹)
        (Algebra.IsIntegral.isIntegral (R := K₀) (x_K⁻¹))
    obtain ⟨Q, hQ_monic, hQ_ev⟩ := hm_int
    let d : ℕ := Q.natDegree
    let z : K := m • x_K⁻¹
    have hz_mul : z * x_K = algebraMap B K (algebraMap R₀ B m) := by
      dsimp [z]
      rw [Submonoid.smul_def, Algebra.smul_def, mul_assoc, inv_mul_cancel₀ hx_K_ne, mul_one,
        IsScalarTower.algebraMap_apply R₀ B K]
    have h_sum_zero :
        algebraMap B K (algebraMap R₀ B ((m : R₀) ^ d) +
          (∑ i ∈ Finset.range d,
            algebraMap R₀ B (Q.coeff i * (m : R₀) ^ i) * x ^ (d - 1 - i)) * x) = 0 := by
      have h0 : Polynomial.eval₂ (algebraMap R₀ K) z Q * x_K ^ d = 0 := by
        dsimp [z]
        rw [hQ_ev, zero_mul]
      rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ, add_mul, Finset.sum_mul] at h0
      have h_top : algebraMap R₀ K (Q.coeff d) * z ^ d * x_K ^ d =
          algebraMap B K (algebraMap R₀ B ((m : R₀) ^ d)) := by
        rw [hQ_monic.coeff_natDegree, map_one, one_mul, ← mul_pow, hz_mul, ← map_pow, ← map_pow]
      have h_low : (∑ i ∈ Finset.range d, algebraMap R₀ K (Q.coeff i) * z ^ i * x_K ^ d) =
          algebraMap B K ((∑ i ∈ Finset.range d,
            algebraMap R₀ B (Q.coeff i * (m : R₀) ^ i) * x ^ (d - 1 - i)) * x) := by
        rw [Finset.sum_mul, map_sum]
        refine Finset.sum_congr rfl fun i hi => ?_
        have hi_lt : i < d := Finset.mem_range.mp hi
        have hd_split : d = i + ((d - 1 - i) + 1) := by omega
        calc
          algebraMap R₀ K (Q.coeff i) * z ^ i * x_K ^ d
            = algebraMap R₀ K (Q.coeff i) * z ^ i * (x_K ^ i * x_K ^ ((d - 1 - i) + 1)) := by
              rw [← pow_add, ← hd_split]
          _ = algebraMap R₀ K (Q.coeff i) * (z * x_K) ^ i * (x_K ^ (d - 1 - i) * x_K) := by
              rw [mul_pow, pow_succ]; ring
          _ = algebraMap B K (algebraMap R₀ B (Q.coeff i * (m : R₀) ^ i) * x ^ (d - 1 - i) * x) := by
              rw [hz_mul, IsScalarTower.algebraMap_apply R₀ B K (Q.coeff i)]
              simp only [map_mul, map_pow, x_K]
              ring
      rw [map_add, ← h_top, ← h_low, add_comm]
      exact h0
    have h_rel_B : algebraMap R₀ B ((m : R₀) ^ d) +
        (∑ i ∈ Finset.range d,
          algebraMap R₀ B (Q.coeff i * (m : R₀) ^ i) * x ^ (d - 1 - i)) * x = 0 :=
      IsFractionRing.injective B K (h_sum_zero.trans (map_zero _).symm)
    have hm_pow_q : algebraMap R₀ B ((m : R₀) ^ d) ∈ q := by
      have h_eq : algebraMap R₀ B ((m : R₀) ^ d) =
          - ((∑ i ∈ Finset.range d,
            algebraMap R₀ B (Q.coeff i * (m : R₀) ^ i) * x ^ (d - 1 - i)) * x) :=
        eq_neg_of_add_eq_zero_left h_rel_B
      rw [h_eq]
      exact q.neg_mem (q.mul_mem_left _ hx_q)
    rw [map_pow] at hm_pow_q
    let p : Ideal R₀ := Ideal.comap (algebraMap R₀ B) q
    have : p.IsPrime := hq_pr.comap (algebraMap R₀ B)
    have hm_p : (m : R₀) ∈ p := hq_pr.mem_of_pow_mem d hm_pow_q
    have hp_ne : p ≠ ⊥ := by
      intro hbot
      rw [hbot, Ideal.mem_bot] at hm_p
      exact mem_nonZeroDivisors_iff_ne_zero.mp m.2 hm_p
    have : p.IsMaximal := hDimR₀.maximalOfPrime hp_ne inferInstance
    let κ := R₀ ⧸ p
    let S_q := B ⧸ q
    let _ : Field κ := Ideal.Quotient.field p
    have : IsDomain S_q := Ideal.Quotient.isDomain q
    have hker_p : ∀ r ∈ p, ((Ideal.Quotient.mk q).comp (algebraMap R₀ B)) r = 0 := by
      intro r hr
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
    let φ_κ_Sq : κ →+* S_q := Ideal.Quotient.lift p ((Ideal.Quotient.mk q).comp (algebraMap R₀ B)) hker_p
    let _ : Algebra κ S_q := φ_κ_Sq.toAlgebra
    have : IsScalarTower R₀ κ S_q :=
      ⟨fun r c y => by
        obtain ⟨r', rfl⟩ := Ideal.Quotient.mk_surjective c
        obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
        have hr_smul : r • Ideal.Quotient.mk p r' = Ideal.Quotient.mk p (r * r') := by
          change Ideal.Quotient.mk p (r • r') = Ideal.Quotient.mk p (r * r')
          rw [smul_eq_mul]
        change φ_κ_Sq (r • Ideal.Quotient.mk p r') * Ideal.Quotient.mk q b =
          r • (φ_κ_Sq (Ideal.Quotient.mk p r') * Ideal.Quotient.mk q b)
        rw [hr_smul]
        dsimp [φ_κ_Sq]
        rw [Ideal.Quotient.lift_mk, Ideal.Quotient.lift_mk, Algebra.smul_def, map_mul, mul_assoc]⟩
    let E_p := TensorProduct R₀ κ B
    have : Algebra.Etale κ E_p := Algebra.Etale.baseChange R₀ B κ
    have : Module.Finite κ E_p := hEtFieldFin κ E_p
    let mk_alg : B →ₐ[R₀] S_q :=
      { Ideal.Quotient.mk q with commutes' := fun _ => rfl }
    let Ψ_p : E_p →ₐ[κ] S_q :=
      Algebra.TensorProduct.lift (Algebra.ofId κ S_q) mk_alg (fun _ _ => Commute.all _ _)
    have hSurj_Ψ : Function.Surjective Ψ_p.toLinearMap := by
      intro y
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨TensorProduct.tmul R₀ (1 : κ) b, ?_⟩
      change (Algebra.TensorProduct.lift (Algebra.ofId κ S_q) mk_alg
        (fun _ _ => Commute.all _ _)) (TensorProduct.tmul R₀ (1 : κ) b) = Ideal.Quotient.mk q b
      rw [Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, map_one, one_mul]
      rfl
    have : Module.Finite κ S_q := Module.Finite.of_surjective Ψ_p.toLinearMap hSurj_Ψ
    have : Algebra.IsIntegral κ S_q := Algebra.IsIntegral.of_finite κ S_q
    have hField_Sq : IsField S_q :=
      (Algebra.IsIntegral.isField_iff_isField (R := κ) (S := S_q)
        (RingHom.injective (algebraMap κ S_q))).mp (Field.toIsField κ)
    exact (Ideal.Quotient.maximal_ideal_iff_isField_quotient q).mpr hField_Sq

  
  have hIntClFin : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
      (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
      Module.Finite A ↥(integralClosure A K) := by
    intro A _ _ _ _ K _ _ _
    obtain ⟨s, g, hg_inj, hg_fin⟩ := exists_finite_inj_algHom_of_fg k A
    let P_mv := MvPolynomial (Fin s) k
    let _ : Algebra P_mv A := g.toRingHom.toAlgebra
    let _ : Algebra P_mv K := ((algebraMap A K).comp g.toRingHom).toAlgebra
    have : IsScalarTower P_mv A K := IsScalarTower.of_algebraMap_eq' rfl
    have : Module.Finite P_mv A := hg_fin
    have : Algebra.IsIntegral P_mv A := Algebra.IsIntegral.of_finite P_mv A
    have hPK_inj : Function.Injective (algebraMap P_mv K) :=
      (IsFractionRing.injective A K).comp hg_inj
    have : FaithfulSMul P_mv K := (faithfulSMul_iff_algebraMap_injective P_mv K).mpr hPK_inj
    let F_P := FractionRing P_mv
    let _ : Algebra F_P K := FractionRing.liftAlgebra P_mv K
    have : IsScalarTower P_mv F_P K := FractionRing.isScalarTower_liftAlgebra P_mv K
    have : Module.IsTorsionFree P_mv A :=
      Module.isTorsionFree_iff_algebraMap_injective.mpr hg_inj
    let _ : Algebra F_P (FractionRing A) := FractionRing.liftAlgebra P_mv (FractionRing A)
    have : IsScalarTower P_mv F_P (FractionRing A) :=
      FractionRing.isScalarTower_liftAlgebra P_mv (FractionRing A)
    have : FiniteDimensional F_P (FractionRing A) := instFiniteDimensionalFractionRingOfFinite
    let e_AK : FractionRing A ≃ₐ[A] K :=
      IsLocalization.algEquiv (nonZeroDivisors A) (FractionRing A) K
    have h_comp_KP :
        e_AK.toRingEquiv.toRingHom.comp (algebraMap F_P (FractionRing A)) =
          algebraMap F_P K := by
      apply @IsLocalization.ringHom_ext P_mv _ (nonZeroDivisors P_mv) F_P
      apply RingHom.ext
      intro p₀
      simp only [RingHom.comp_apply]
      have h1 : algebraMap F_P (FractionRing A) (algebraMap P_mv F_P p₀) =
          algebraMap A (FractionRing A) (algebraMap P_mv A p₀) := by
        rw [← IsScalarTower.algebraMap_apply P_mv F_P (FractionRing A) p₀,
          IsScalarTower.algebraMap_apply P_mv A (FractionRing A) p₀]
      rw [h1]
      change e_AK (algebraMap A (FractionRing A) (algebraMap P_mv A p₀)) =
        algebraMap F_P K (algebraMap P_mv F_P p₀)
      rw [e_AK.commutes, ← IsScalarTower.algebraMap_apply P_mv F_P K p₀,
        IsScalarTower.algebraMap_apply P_mv A K p₀]
    let e_lin : FractionRing A ≃ₗ[F_P] K :=
      { toFun := e_AK
        invFun := e_AK.symm
        left_inv := e_AK.left_inv
        right_inv := e_AK.right_inv
        map_add' := map_add e_AK
        map_smul' := fun c x => by
          simp only [RingHom.id_apply, Algebra.smul_def, map_mul]
          exact congrArg (· * e_AK x) (RingHom.congr_fun h_comp_KP c) }
    have : FiniteDimensional F_P K := e_lin.finiteDimensional
    obtain ⟨p, hp⟩ := ExpChar.exists k
    have : ExpChar k p := hp
    have : ExpChar P_mv p := expChar_of_injective_algebraMap (MvPolynomial.C_injective (Fin s) k) p
    have : PerfectField k := IsAlgClosed.perfectField k
    have : PerfectRing k p := PerfectField.toPerfectRing p
    let M : IntermediateField F_P K := separableClosure F_P K
    have hFinM : Module.Finite P_mv ↥(integralClosure P_mv ↥M) :=
      IsIntegralClosure.finite P_mv F_P ↥M ↥(integralClosure P_mv ↥M)
    obtain ⟨n_m, f_surj, hf_surj⟩ :=
      @Module.Finite.exists_fin' P_mv ↥(integralClosure P_mv ↥M) _ _ _ hFinM
    have hPM_inj : Function.Injective (algebraMap P_mv ↥M) := by
      rw [IsScalarTower.algebraMap_eq P_mv F_P ↥M]
      exact (RingHom.injective (algebraMap F_P ↥M)).comp (IsFractionRing.injective P_mv F_P)
    have : ExpChar ↥M p := expChar_of_injective_algebraMap hPM_inj p
    have : ExpChar K p := expChar_of_injective_algebraMap hPK_inj p
    have hTowerPMK : IsScalarTower P_mv ↥M K := by
      refine IsScalarTower.of_algebraMap_eq fun r => ?_
      rw [IsScalarTower.algebraMap_apply P_mv F_P K r,
        IsScalarTower.algebraMap_apply F_P ↥M K (algebraMap P_mv F_P r),
        ← IsScalarTower.algebraMap_apply P_mv F_P ↥M r]
    let e : ℕ := IsPurelyInseparable.exponent ↥M K
    let Q_exp : ℕ := p ^ e
    have hQ_pos : 0 < Q_exp := pow_pos (expChar_pos k p) e
    let φ_k : k ≃+* k := iterateFrobeniusEquiv k p e
    let u₀ : (Fin s → Fin Q_exp) → P_mv := fun r => ∏ i : Fin s, MvPolynomial.X i ^ (r i).1
    have h_frob_span : ∀ f : P_mv, ∃ q₀ : (Fin s → Fin Q_exp) → P_mv,
        f = ∑ r : Fin s → Fin Q_exp, (q₀ r) ^ Q_exp * u₀ r := by
      intro f
      refine MvPolynomial.induction_on' f ?_ ?_
      · intro d c
        let r_d : Fin s → Fin Q_exp := fun i => ⟨d i % Q_exp, Nat.mod_lt (d i) hQ_pos⟩
        let c₀ : k := φ_k.symm c
        have hc₀ : c₀ ^ Q_exp = c := by
          have h1 : φ_k c₀ = c := φ_k.apply_symm_apply c
          rwa [iterateFrobeniusEquiv_def] at h1
        let g_d : P_mv := MvPolynomial.C c₀ * ∏ i : Fin s, MvPolynomial.X i ^ (d i / Q_exp)
        refine ⟨fun r => if r = r_d then g_d else 0, ?_⟩
        rw [Finset.sum_eq_single r_d]
        · simp only [↓reduceIte]
          have h_mon : (MvPolynomial.monomial d c : P_mv) =
              MvPolynomial.C c * ∏ i : Fin s, (MvPolynomial.X i : P_mv) ^ d i := by
            rw [MvPolynomial.monomial_eq,
              Finsupp.prod_fintype d (fun i n => (MvPolynomial.X i : P_mv) ^ n)
                (fun _ => pow_zero _)]
          have hg_pow : g_d ^ Q_exp =
              MvPolynomial.C c * ∏ i : Fin s, (MvPolynomial.X i : P_mv) ^ (Q_exp * (d i / Q_exp)) := by
            dsimp [g_d]
            rw [mul_pow, ← map_pow MvPolynomial.C, hc₀, ← Finset.prod_pow]
            congr 1
            refine Finset.prod_congr rfl fun i _ => ?_
            rw [← pow_mul, mul_comm]
          rw [h_mon, hg_pow, mul_assoc]
          congr 1
          rw [← Finset.prod_mul_distrib]
          refine Finset.prod_congr rfl fun i _ => ?_
          dsimp [r_d]
          rw [← pow_add, Nat.div_add_mod (d i) Q_exp]
        · intro r _ hr
          simp [hr, zero_pow hQ_pos.ne']
        · intro h_abs
          exact absurd (Finset.mem_univ r_d) h_abs
      · intro f₁ f₂ ⟨q₁, hq₁⟩ ⟨q₂, hq₂⟩
        refine ⟨fun r => q₁ r + q₂ r, ?_⟩
        rw [hq₁, hq₂, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun r _ => ?_
        have h_add_pow : (q₁ r + q₂ r) ^ Q_exp = q₁ r ^ Q_exp + q₂ r ^ Q_exp := by
          simpa only [iterateFrobenius_def, Q_exp] using
            map_add (iterateFrobenius P_mv p e) (q₁ r) (q₂ r)
        rw [h_add_pow, right_distrib]
    let Φ_P : P_mv →+* P_mv := iterateFrobenius P_mv p e
    let Φ_KM : K →+* ↥M := IsPurelyInseparable.iterateFrobenius ↥M K p (le_refl e)
    have h_comm : (algebraMap P_mv ↥M).comp Φ_P = Φ_KM.comp (algebraMap P_mv K) := by
      apply RingHom.ext
      intro r
      simp only [RingHom.comp_apply]
      rw [@IsScalarTower.algebraMap_apply P_mv ↥M K _ _ _ _ _ _ hTowerPMK r,
        IsPurelyInseparable.iterateFrobenius_algebraMap K p (le_refl e) (algebraMap P_mv ↥M r),
        ← map_pow, iterateFrobenius_def]
    have h_f_smul : ∀ (s : P_mv) (c : Fin n_m → P_mv), f_surj (s • c) = s • f_surj c :=
      f_surj.map_smul
    let instTw : Module P_mv ↥(integralClosure P_mv ↥M) :=
      Module.compHom ↥(integralClosure P_mv ↥M) Φ_P
    let Idx := (Fin s → Fin Q_exp) × Fin n_m
    let F_span :=
      @LinearMap.mk P_mv P_mv _ _ (RingHom.id P_mv) (Idx → P_mv) ↥(integralClosure P_mv ↥M)
        _ _ _ instTw
        { toFun := fun α => f_surj (fun l => ∑ r : Fin s → Fin Q_exp, Φ_P (α (r, l)) * u₀ r)
          map_add' := fun α₁ α₂ => by
            have h_eq : (fun l => ∑ r, Φ_P ((α₁ + α₂) (r, l)) * u₀ r) =
                (fun l => ∑ r, Φ_P (α₁ (r, l)) * u₀ r) +
                (fun l => ∑ r, Φ_P (α₂ (r, l)) * u₀ r) := by
              funext l; simp only [Pi.add_apply, map_add, right_distrib, Finset.sum_add_distrib]
            rw [h_eq, map_add] }
        (fun r₀ α => by
          have h_eq : (fun l => ∑ r, Φ_P ((r₀ • α) (r, l)) * u₀ r) =
              Φ_P r₀ • (fun l => ∑ r, Φ_P (α (r, l)) * u₀ r) := by
            funext l; simp only [Pi.smul_apply, smul_eq_mul, map_mul, mul_assoc, Finset.mul_sum]
          exact (congrArg f_surj h_eq).trans (h_f_smul (Φ_P r₀) _))
    have hF_surj : Function.Surjective F_span := by
      intro w
      obtain ⟨c, rfl⟩ := hf_surj w
      choose q₀ hq₀ using fun l => h_frob_span (c l)
      refine ⟨fun idx => q₀ idx.2 idx.1, ?_⟩
      change f_surj (fun l => ∑ r, Φ_P (q₀ l r) * u₀ r) = f_surj c
      congr 1
      funext l
      simpa only [Φ_P, iterateFrobenius_def, Q_exp] using (hq₀ l).symm
    have hFinTw : @Module.Finite P_mv ↥(integralClosure P_mv ↥M) _ _ instTw :=
      @Module.Finite.of_surjective P_mv (Idx → P_mv) _ _ _ P_mv ↥(integralClosure P_mv ↥M)
        _ _ instTw (RingHom.id P_mv) inferInstance F_span hF_surj
    have hNoethTw : @IsNoetherian P_mv ↥(integralClosure P_mv ↥M) _ _ instTw :=
      @isNoetherian_of_isNoetherianRing_of_finite P_mv ↥(integralClosure P_mv ↥M)
        _ _ instTw inferInstance hFinTw
    let ψ_frob :=
      @LinearMap.mk P_mv P_mv _ _ (RingHom.id P_mv)
        ↥(integralClosure P_mv K) ↥(integralClosure P_mv ↥M) _ _ _ instTw
        { toFun := fun z => ⟨Φ_KM z.1, IsIntegral.map_of_comp_eq Φ_P Φ_KM h_comm z.2⟩
          map_add' := fun z₁ z₂ => Subtype.ext (map_add Φ_KM z₁.1 z₂.1) }
        (fun r₀ z => Subtype.ext (by
          change Φ_KM ((r₀ • z : ↥(integralClosure P_mv K)).1) =
            (Φ_P r₀ • (⟨Φ_KM z.1, _⟩ : ↥(integralClosure P_mv ↥M))).1
          have h1 : (r₀ • z : ↥(integralClosure P_mv K)).1 = algebraMap P_mv K r₀ * z.1 :=
            Algebra.smul_def r₀ z.1
          have h2 : ∀ w : ↥(integralClosure P_mv ↥M),
              (Φ_P r₀ • w).1 = algebraMap P_mv ↥M (Φ_P r₀) * w.1 :=
            fun w => Algebra.smul_def (Φ_P r₀) w.1
          rw [h1, map_mul, h2]
          exact congrArg (· * Φ_KM z.1) (RingHom.congr_fun h_comm r₀).symm))
    have hInj_ψ : Function.Injective ψ_frob := fun z₁ z₂ hz =>
      Subtype.ext (Φ_KM.injective (congrArg Subtype.val hz))
    have : Module.Finite P_mv ↥(integralClosure P_mv K) :=
      @Module.Finite.of_injective P_mv P_mv ↥(integralClosure P_mv K) ↥(integralClosure P_mv ↥M)
        _ _ _ _ _ instTw hNoethTw (RingHom.id P_mv) (RingHom.id P_mv)
        RingHomInvPair.ids RingHomInvPair.ids ψ_frob hInj_ψ
    let e_ic_PA : ↥(integralClosure P_mv K) ≃ₗ[P_mv] ↥(integralClosure A K) :=
      { toFun := fun z => ⟨z.1, IsIntegral.tower_top z.2⟩
        invFun := fun z => ⟨z.1, isIntegral_trans z.1 z.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl
        map_smul' := fun _ _ => Subtype.ext rfl }
    have : Module.Finite P_mv ↥(integralClosure A K) := Module.Finite.equiv e_ic_PA
    exact Module.Finite.of_restrictScalars_finite P_mv A ↥(integralClosure A K)

  
  have hNormLift :
      ∀ (B₀ : Type u) [CommRing B₀] [IsDomain B₀] [Algebra k B₀] [Algebra.FiniteType k B₀]
        (_hDim₀ : Ring.DimensionLEOne B₀)
        (x₀ : B₀) (_hx₀_ne : x₀ ≠ 0)
        (τ_B₀ : B₀ →ₐ[k] k) (_hτ_x₀ : τ_B₀ x₀ = 0)
        (K_base : Type u) [Field K_base] [Algebra B₀ K_base] [IsFractionRing B₀ K_base]
        (L₁ : Type u) [Field L₁] [Algebra K_base L₁] [FiniteDimensional K_base L₁]
        (Ω : Type u) [Field Ω]
        (ι_L₁_Ω : L₁ →+* Ω)
        (_hAlg_Ω : ∀ x : Ω, ∃ P : Polynomial K_base,
          P ≠ 0 ∧ Polynomial.eval₂ (ι_L₁_Ω.comp (algebraMap K_base L₁)) x P = 0),
        ∃ (B₀' : Type u)
          (_ : CommRing B₀')
          (_ : IsDomain B₀')
          (_ : Algebra k B₀')
          (_ : Algebra.FiniteType k B₀')
          (_ : IsDedekindDomain B₀')
          (_ : ¬ IsField B₀')
          (ψ₀ : B₀ →ₐ[k] B₀')
          (x_nz : B₀')
          (_ : Algebra B₀' L₁)
          (_ : IsFractionRing B₀' L₁)
          (τ₀' : B₀' →ₐ[k] k),
            (x_nz ≠ 0 ∧ τ₀' x_nz = 0) ∧
            τ₀'.comp ψ₀ = τ_B₀ ∧
            (algebraMap B₀' L₁).comp ψ₀.toRingHom =
              (algebraMap K_base L₁).comp (algebraMap B₀ K_base) ∧
            (∀ x : Ω, ∃ P : Polynomial B₀',
              P ≠ 0 ∧ Polynomial.eval₂ (ι_L₁_Ω.comp (algebraMap B₀' L₁)) x P = 0) := by
    intro B₀ _ _ _ _ hDim₀ x₀ hx₀_ne τ_B₀ hτ_x₀ K_base _ _ _ L₁ _ _ _ Ω _ ι_L₁_Ω hAlg_Ω
    let _ : Algebra B₀ L₁ := ((algebraMap K_base L₁).comp (algebraMap B₀ K_base)).toAlgebra
    have : IsScalarTower B₀ K_base L₁ := IsScalarTower.of_algebraMap_eq' rfl
    have hB₀_L₁_inj : Function.Injective (algebraMap B₀ L₁) :=
      (RingHom.injective (algebraMap K_base L₁)).comp (IsFractionRing.injective B₀ K_base)
    have : Algebra.IsIntegral K_base L₁ := Algebra.IsIntegral.of_finite K_base L₁
    obtain ⟨d_b, f_L, hf_L_surj⟩ := @Module.Finite.exists_fin' K_base L₁ _ _ _ inferInstance
    let v_b : Fin d_b → L₁ := fun j => f_L (Pi.single j 1)
    have hv_m : ∀ j : Fin d_b, ∃ m : nonZeroDivisors B₀, IsIntegral B₀ ((m : B₀) • v_b j) :=
      fun j => IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors B₀) (v_b j)
        (Algebra.IsIntegral.isIntegral (R := K_base) (v_b j))
    choose m_b hm_b_int using hv_m
    let y_b : Fin d_b → L₁ := fun j => (m_b j : B₀) • v_b j
    let A_alg : Subalgebra B₀ L₁ := Algebra.adjoin B₀ (Set.range y_b)
    let A_sub : Type u := ↥A_alg
    let _ : Algebra k A_sub := ((algebraMap B₀ A_sub).comp (algebraMap k B₀)).toAlgebra
    have : IsScalarTower k B₀ A_sub := IsScalarTower.of_algebraMap_eq' rfl
    have : Algebra.FiniteType B₀ A_sub := Algebra.FiniteType.adjoin_of_finite (Set.finite_range y_b)
    have : Algebra.FiniteType k A_sub :=
      Algebra.FiniteType.trans (R := k) (S := B₀) (A := A_sub) inferInstance inferInstance
    have hInt_B₀_A : Algebra.IsIntegral B₀ A_sub := by
      rw [Subalgebra.isIntegral_iff]
      intro z hz
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
      · rintro _ ⟨j, rfl⟩; exact hm_b_int j
      · intro r; exact isIntegral_algebraMap
      · intro x y _ _ hx hy; exact hx.add hy
      · intro x y _ _ hx hy; exact hx.mul hy
    have hB₀_A_inj : Function.Injective (algebraMap B₀ A_sub) := fun r₁ r₂ hr =>
      hB₀_L₁_inj (congrArg Subtype.val hr)
    have : IsFractionRing A_sub L₁ :=
      { map_units := fun ⟨s, hs⟩ => by
          have hs_ne : (s : A_sub) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
          have hs_L : (s : L₁) ≠ 0 := fun h0 => hs_ne (Subtype.ext h0)
          exact Ne.isUnit hs_L
        surj := fun z => by
          obtain ⟨c, rfl⟩ := hf_L_surj z
          have hc_eq : c = ∑ j : Fin d_b, c j • Pi.single j (1 : K_base) := by
            ext i
            simp [Finset.sum_apply, Pi.single_apply]
          have hf_c : f_L c = ∑ j : Fin d_b, c j • v_b j := by
            conv_lhs => rw [hc_eq]
            rw [map_sum]
            exact Finset.sum_congr rfl fun j _ => f_L.map_smul (c j) (Pi.single j 1)
          choose cs hcs using fun j => IsLocalization.surj (nonZeroDivisors B₀) (c j)
          let D₀ : nonZeroDivisors B₀ := ∏ j : Fin d_b, ((cs j).2 * m_b j)
          have hD₀_ne : (D₀ : B₀) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp D₀.2
          let D_A : A_sub := algebraMap B₀ A_sub (D₀ : B₀)
          have hDA_ne : D_A ≠ 0 := fun h0 => hD₀_ne (hB₀_A_inj (h0.trans (map_zero _).symm))
          let D_nzd : nonZeroDivisors A_sub := ⟨D_A, mem_nonZeroDivisors_of_ne_zero hDA_ne⟩
          have h_prod_mem : ∃ a : A_sub, f_L c * algebraMap A_sub L₁ D_A = algebraMap A_sub L₁ a := by
            have h_dvd : ∀ j : Fin d_b,
                ∃ q : B₀, (D₀ : B₀) = ((cs j).2 : B₀) * (m_b j : B₀) * q := by
              intro j
              obtain ⟨q, hq⟩ := Finset.dvd_prod_of_mem
                (fun i : Fin d_b => (((cs i).2 * m_b i : nonZeroDivisors B₀) : B₀))
                (Finset.mem_univ j)
              refine ⟨q, ?_⟩
              simpa [D₀, mul_assoc] using hq
            choose q_j hq_j using h_dvd
            let num_L : L₁ := ∑ j : Fin d_b, algebraMap B₀ L₁ ((cs j).1 * q_j j) * y_b j
            have hnum_mem : num_L ∈ A_alg :=
              A_alg.sum_mem fun j _ =>
                A_alg.mul_mem (A_alg.algebraMap_mem _) (Algebra.subset_adjoin ⟨j, rfl⟩)
            refine ⟨⟨num_L, hnum_mem⟩, ?_⟩
            change f_L c * algebraMap B₀ L₁ (D₀ : B₀) = num_L
            rw [hf_c, Finset.sum_mul]
            refine Finset.sum_congr rfl fun j _ => ?_
            have hcj_s : c j * algebraMap B₀ K_base ((cs j).2 : B₀) =
                algebraMap B₀ K_base (cs j).1 := hcs j
            calc
              (c j • v_b j) * algebraMap B₀ L₁ (D₀ : B₀)
                = algebraMap K_base L₁ (c j) * v_b j *
                    algebraMap K_base L₁ (algebraMap B₀ K_base
                      (((cs j).2 : B₀) * (m_b j : B₀) * q_j j)) := by
                  rw [Algebra.smul_def, hq_j j, ← IsScalarTower.algebraMap_apply B₀ K_base L₁]
              _ = algebraMap K_base L₁ (c j * algebraMap B₀ K_base ((cs j).2 : B₀)) *
                    algebraMap K_base L₁ (algebraMap B₀ K_base (q_j j)) *
                    (algebraMap B₀ L₁ (m_b j : B₀) * v_b j) := by
                  rw [IsScalarTower.algebraMap_apply B₀ K_base L₁ (m_b j : B₀)]
                  simp only [map_mul]
                  ring
              _ = algebraMap B₀ L₁ ((cs j).1 * q_j j) * y_b j := by
                  rw [hcj_s, ← map_mul, ← map_mul,
                    ← IsScalarTower.algebraMap_apply B₀ K_base L₁]
                  dsimp [y_b]
                  rw [Algebra.smul_def]
          obtain ⟨a, ha⟩ := h_prod_mem
          exact ⟨⟨a, D_nzd⟩, ha⟩
        exists_of_eq := fun h => ⟨1, by simpa using Subtype.ext h⟩ }

    have : Module.Finite A_sub ↥(integralClosure A_sub L₁) := hIntClFin A_sub L₁
    let B₀' : Type u := ↥(integralClosure B₀ L₁)
    let ψ₀_ring : B₀ →+* B₀' := algebraMap B₀ B₀'
    let instAlgkB₀' : Algebra k B₀' := (ψ₀_ring.comp (algebraMap k B₀)).toAlgebra
    let _ : Algebra k B₀' := instAlgkB₀'
    have : IsScalarTower k B₀ B₀' := IsScalarTower.of_algebraMap_eq' rfl
    let ψ₀ : B₀ →ₐ[k] B₀' := IsScalarTower.toAlgHom k B₀ B₀'
    have halg_ψ₀ : (algebraMap B₀' L₁).comp ψ₀.toRingHom =
        (algebraMap K_base L₁).comp (algebraMap B₀ K_base) := rfl
    have hψ₀_inj : Function.Injective ψ₀ := fun b₁ b₂ hb =>
      hB₀_L₁_inj (congrArg (algebraMap B₀' L₁) hb)
    have h_le : A_alg ≤ integralClosure B₀ L₁ := by
      intro z hz
      change IsIntegral B₀ z
      exact ((Subalgebra.isIntegral_iff A_alg).mp hInt_B₀_A) z hz
    let instAlgAB : Algebra A_sub B₀' := (Subalgebra.inclusion h_le).toAlgebra
    let _ : Algebra A_sub B₀' := instAlgAB
    have hTower_kAB : IsScalarTower k A_sub B₀' :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => Subtype.ext rfl)
    let e_ic_AB : ↥(integralClosure A_sub L₁) ≃ₗ[A_sub] B₀' :=
      { toFun := fun z => ⟨z.1, @isIntegral_trans B₀ A_sub L₁ _ _ _ _ _ _ _ hInt_B₀_A z.1 z.2⟩
        invFun := fun z => ⟨z.1, IsIntegral.tower_top z.2⟩
        left_inv := fun _ => Subtype.ext rfl
        right_inv := fun _ => Subtype.ext rfl
        map_add' := fun _ _ => Subtype.ext rfl
        map_smul' := fun _ _ => Subtype.ext rfl }
    have : Module.Finite A_sub B₀' := Module.Finite.equiv e_ic_AB
    have : Algebra.FiniteType A_sub B₀' := inferInstance
    have instFT_kB₀' : Algebra.FiniteType k B₀' :=
      Algebra.FiniteType.trans (R := k) (S := A_sub) (A := B₀') inferInstance inferInstance
    have : IsNoetherianRing B₀' := Algebra.FiniteType.isNoetherianRing k B₀'
    have : Ring.DimensionLEOne B₀' := Ring.DimensionLEOne.integralClosure B₀ L₁
    have : IsIntegrallyClosed B₀' := integralClosure.isIntegrallyClosedOfFiniteExtension K_base
    have instFracB₀' : IsFractionRing B₀' L₁ :=
      { map_units := fun ⟨s, hs⟩ => by
          have hs_ne : (s : B₀') ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hs
          have hs_L : (s : L₁) ≠ 0 := fun h0 => hs_ne (Subtype.ext h0)
          exact Ne.isUnit hs_L
        surj := fun z => by
          obtain ⟨⟨a, s⟩, hsurj⟩ := IsLocalization.surj (nonZeroDivisors A_sub) z
          have hs_ne : (s : A_sub) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
          let s' : B₀' := Subalgebra.inclusion h_le (s : A_sub)
          have hs'_ne : s' ≠ 0 := fun h0 =>
            hs_ne (Subtype.ext (show ((s : A_sub) : L₁) = 0 from congrArg Subtype.val h0))
          exact ⟨⟨Subalgebra.inclusion h_le a, ⟨s', mem_nonZeroDivisors_of_ne_zero hs'_ne⟩⟩, hsurj⟩
        exists_of_eq := fun h => ⟨1, by simpa using Subtype.ext h⟩ }
    have hDedB₀' : IsDedekindDomain B₀' :=
      (isDedekindDomain_iff B₀' L₁).mpr
        ⟨inferInstance, inferInstance, inferInstance,
          fun hx => (isIntegrallyClosed_iff L₁).mp inferInstance hx⟩

    let m₀ : Ideal B₀ := RingHom.ker τ_B₀.toRingHom
    have hτ_B₀_surj : Function.Surjective τ_B₀.toRingHom := fun c =>
      ⟨algebraMap k B₀ c, τ_B₀.commutes c⟩
    have hm₀_max : m₀.IsMaximal := by
      have : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      exact Ideal.comap_isMaximal_of_surjective τ_B₀.toRingHom hτ_B₀_surj (K := ⊥)
    have : Algebra.IsIntegral B₀ B₀' := ⟨integralClosure.isIntegral⟩
    have hker_le : RingHom.ker (algebraMap B₀ B₀') ≤ m₀ := by
      intro b hb
      rw [RingHom.mem_ker] at hb
      rw [hψ₀_inj (hb.trans (map_zero _).symm)]
      exact m₀.zero_mem
    obtain ⟨m₀', hm₀'_max, hm₀'_over⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := B₀') m₀ hker_le
    obtain ⟨n_mv, q_mv, hq_surj⟩ :=
      @Algebra.FiniteType.iff_quotient_mvPolynomial'' k B₀' _ _ instAlgkB₀' |>.mp instFT_kB₀'
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_mv.toRingHom m₀'
    have hm_mv_max : m_mv.IsMaximal :=
      Ideal.comap_isMaximal_of_surjective q_mv.toRingHom hq_surj (K := m₀')
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_q : ∀ f_p ∈ RingHom.ker q_mv.toRingHom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_mv.toRingHom f_p ∈ m₀'
        rw [hf_p]
        exact m₀'.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_mv.toRingHom) hq_surj
    let τ₀'_ring : B₀' →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_mv.toRingHom) ev_hom hker_q).comp e_quot.symm.toRingHom
    have hτ₀'_q : ∀ f_p : MvPolynomial (Fin n_mv) k, τ₀'_ring (q_mv f_p) = ev_hom f_p := by
      intro f_p
      dsimp [τ₀'_ring]
      have heq_q : e_quot.symm (q_mv.toRingHom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_mv.toRingHom) f_p := by
        apply e_quot.injective
        rw [e_quot.apply_symm_apply]
        rfl
      exact congrArg (Ideal.Quotient.lift (RingHom.ker q_mv.toRingHom) ev_hom hker_q) heq_q
    let τ₀' : B₀' →ₐ[k] k :=
      { τ₀'_ring with
        commutes' := fun c => by
          change τ₀'_ring (algebraMap k B₀' c) = algebraMap k k c
          rw [← q_mv.commutes c, hτ₀'_q]
          exact (MvPolynomial.aeval a_pt).commutes c }
    have hker_τ₀' : ∀ y ∈ m₀', τ₀' y = 0 := by
      intro y hy
      obtain ⟨f_p, rfl⟩ := hq_surj y
      have hf_mem : f_p ∈ m_mv := hy
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hf_mem
      exact (hτ₀'_q f_p).trans hf_mem
    have hτ₀'_ψ₀ : τ₀'.comp ψ₀ = τ_B₀ := by
      ext b
      have hdiff_m₀ : b - algebraMap k B₀ (τ_B₀ b) ∈ m₀ := by
        change τ_B₀ (b - algebraMap k B₀ (τ_B₀ b)) = 0
        rw [map_sub, τ_B₀.commutes, Algebra.algebraMap_self, RingHom.id_apply, sub_self]
      rw [← hm₀'_over] at hdiff_m₀
      have hdiff_m₀' : ψ₀ b - algebraMap k B₀' (τ_B₀ b) ∈ m₀' := by
        have hmap : ψ₀ (b - algebraMap k B₀ (τ_B₀ b)) = ψ₀ b - algebraMap k B₀' (τ_B₀ b) := by
          rw [map_sub, ψ₀.commutes]
        rw [← hmap]
        exact hdiff_m₀
      have h0 := hker_τ₀' _ hdiff_m₀'
      rw [map_sub, τ₀'.commutes, Algebra.algebraMap_self, RingHom.id_apply] at h0
      exact sub_eq_zero.mp h0
    let x_nz : B₀' := ψ₀ x₀
    have hx_nz_ne : x_nz ≠ 0 := fun h0 => hx₀_ne (hψ₀_inj (h0.trans (map_zero _).symm))
    have hτ_xnz : τ₀' x_nz = 0 := by
      change (τ₀'.comp ψ₀) x₀ = 0
      rw [hτ₀'_ψ₀]
      exact hτ_x₀
    have hNotField : ¬ IsField B₀' := by
      intro hF
      let _ : Field B₀' := hF.toField
      exact hx_nz_ne (τ₀'.toRingHom.injective (hτ_xnz.trans (map_zero _).symm))

    have hPoly_Ω : ∀ x : Ω, ∃ P : Polynomial B₀',
        P ≠ 0 ∧ Polynomial.eval₂ (ι_L₁_Ω.comp (algebraMap B₀' L₁)) x P = 0 := by
      intro x
      obtain ⟨P_K, hPK_ne, hPK_ev⟩ := hAlg_Ω x
      let P_B₀ : Polynomial B₀ := IsLocalization.integerNormalization (nonZeroDivisors B₀) P_K
      have hPB₀_ne : P_B₀ ≠ 0 :=
        (IsLocalization.integerNormalization_eq_zero_iff
          (le_refl (nonZeroDivisors B₀)) P_K).not.mpr hPK_ne
      refine ⟨P_B₀.map ψ₀.toRingHom, ?_, ?_⟩
      · intro h0
        exact hPB₀_ne (Polynomial.map_injective ψ₀.toRingHom hψ₀_inj
          (h0.trans (Polynomial.map_zero ψ₀.toRingHom).symm))
      · rw [Polynomial.eval₂_map, RingHom.comp_assoc, halg_ψ₀, ← RingHom.comp_assoc]
        exact IsLocalization.integerNormalization_eval₂_eq_zero (nonZeroDivisors B₀)
          (ι_L₁_Ω.comp (algebraMap K_base L₁)) P_K hPK_ev

    exact ⟨B₀', inferInstance, inferInstance, instAlgkB₀', instFT_kB₀', hDedB₀', hNotField,
      ψ₀, x_nz, inferInstance, instFracB₀', τ₀',
      ⟨hx_nz_ne, hτ_xnz⟩, hτ₀'_ψ₀, halg_ψ₀, hPoly_Ω⟩

  
  let B₀_cat : CommRingCat.{u} := C_aff.presheaf.obj (Opposite.op ⊤)
  let B₀ : Type u := ↑B₀_cat
  have hIrred_C : IrreducibleSpace ↥C_aff := AlgebraicGeometry.irreducibleSpace_of_isIntegral C_aff
  have : Nonempty ↥(⊤ : C_aff.Opens) := ⟨⟨Classical.choice hIrred_C.toNonempty, trivial⟩⟩
  have : IsDomain B₀ := inferInstance
  let e_C : C_aff ≅ AlgebraicGeometry.Spec (CommRingCat.of B₀) := C_aff.isoSpec
  let g_B₀ : AlgebraicGeometry.Spec (CommRingCat.of B₀) ⟶ C_aff := e_C.inv
  let u_C' : C_aff ⟶ AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) k)) := u_C
  have : AlgebraicGeometry.Etale u_C' := ‹_›
  let ψ_mv : CommRingCat.of (MvPolynomial (Fin 1) k) ⟶ CommRingCat.of B₀ :=
    AlgebraicGeometry.Spec.preimage (g_B₀ ≫ u_C')
  have hSpec_ψmv : AlgebraicGeometry.Spec.map ψ_mv = g_B₀ ≫ u_C' :=
    AlgebraicGeometry.Spec.map_preimage (g_B₀ ≫ u_C')
  let instAlgkB₀ : Algebra k B₀ := (ψ_mv.hom.comp MvPolynomial.C).toAlgebra
  let _ : Algebra k B₀ := instAlgkB₀
  have hgB₀_uC : CategoryTheory.CategoryStruct.comp g_B₀
      (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₀)) := by
    change (g_B₀ ≫ u_C') ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom MvPolynomial.C) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₀))
    rw [← hSpec_ψmv, ← AlgebraicGeometry.Spec.map_comp]
    rfl

  let e_poly : MvPolynomial (Fin 1) k ≃ₐ[k] Polynomial k := MvPolynomial.uniqueAlgEquiv k (Fin 1)
  let e_poly_cat : CommRingCat.of (MvPolynomial (Fin 1) k) ≅ CommRingCat.of (Polynomial k) :=
    e_poly.toRingEquiv.toCommRingCatIso
  let φ_poly_cat : CommRingCat.of (Polynomial k) ⟶ CommRingCat.of B₀ :=
    e_poly_cat.inv ≫ ψ_mv
  let φ_poly_B₀ : Polynomial k →+* B₀ := φ_poly_cat.hom
  have hSpec_poly : AlgebraicGeometry.Spec.map φ_poly_cat =
      (g_B₀ ≫ u_C') ≫ AlgebraicGeometry.Spec.map e_poly_cat.inv := by
    dsimp [φ_poly_cat]
    rw [AlgebraicGeometry.Spec.map_comp, hSpec_ψmv]
  have hEt_poly_B₀ : RingHom.Etale φ_poly_B₀ :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
      (φ := φ_poly_cat)).mp (by rw [hSpec_poly]; infer_instance)
  let instAlgPolyB₀ : Algebra (Polynomial k) B₀ := φ_poly_B₀.toAlgebra
  have hEtAlgPolyB₀ : @Algebra.Etale (Polynomial k) B₀ _ _ instAlgPolyB₀ := hEt_poly_B₀
  have hFT_PolyB₀ : @Algebra.FiniteType (Polynomial k) B₀ _ _ instAlgPolyB₀ := by
    let _ := instAlgPolyB₀
    have := hEtAlgPolyB₀
    infer_instance
  have hPoly_C : ∀ c : k, φ_poly_B₀ (Polynomial.C c) = algebraMap k B₀ c := by
    intro c
    change ψ_mv.hom (e_poly.symm (algebraMap k (Polynomial k) c)) = ψ_mv.hom (MvPolynomial.C c)
    rw [e_poly.symm.commutes c]
    rfl
  have hTower_kPolyB₀ : @IsScalarTower k (Polynomial k) B₀ _ instAlgPolyB₀.toSMul _ :=
    @IsScalarTower.of_algebraMap_eq' k (Polynomial k) B₀ _ _ _ _ instAlgPolyB₀ _
      (RingHom.ext fun c => (hPoly_C c).symm)
  have : Algebra.FiniteType k B₀ := by
    let _ := instAlgPolyB₀
    have := hTower_kPolyB₀
    exact Algebra.FiniteType.trans (R := k) (S := Polynomial k) (A := B₀) inferInstance hFT_PolyB₀
  obtain ⟨hInj_poly_B₀, _, hDim_poly_to_B₀⟩ :=
    @hEtDomProps (Polynomial k) B₀ _ inferInstance _ inferInstance instAlgPolyB₀ hEtAlgPolyB₀
  have hDim₀ : Ring.DimensionLEOne B₀ := hDim_poly_to_B₀ inferInstance

  let τ_cat : CommRingCat.of B₀ ⟶ CommRingCat.of k :=
    AlgebraicGeometry.Spec.preimage (s_c₀ ≫ e_C.hom)
  have hSpec_τ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_cat.hom) ≫ g_B₀ = s_c₀ := by
    change AlgebraicGeometry.Spec.map τ_cat ≫ e_C.inv = s_c₀
    rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
      e_C.hom_inv_id, CategoryTheory.Category.comp_id]
  have hτ_comm : ∀ c : k, τ_cat.hom (algebraMap k B₀ c) = c := by
    have hsec : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap k B₀) ≫ CommRingCat.ofHom τ_cat.hom) =
        AlgebraicGeometry.Spec.map (𝟙 (CommRingCat.of k)) := by
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_id, ← hgB₀_uC,
        ← CategoryTheory.Category.assoc, hSpec_τ]
      exact hs_c₀_sec
    have hhom := AlgebraicGeometry.Spec.map_injective hsec
    exact fun c => congrArg (fun f : CommRingCat.of k ⟶ CommRingCat.of k => f.hom c) hhom
  let τ_B₀ : B₀ →ₐ[k] k :=
    { τ_cat.hom with commutes' := hτ_comm }
  let c_val : k := τ_B₀ (φ_poly_B₀ Polynomial.X)
  let x₀ : B₀ := φ_poly_B₀ (Polynomial.X - Polynomial.C c_val)
  have hx₀_ne : x₀ ≠ 0 := fun h0 =>
    Polynomial.X_sub_C_ne_zero c_val (hInj_poly_B₀ (h0.trans (map_zero _).symm))
  have hτ_x₀ : τ_B₀ x₀ = 0 := by
    dsimp [x₀]
    rw [map_sub, map_sub, hPoly_C c_val, τ_B₀.commutes c_val]
    exact sub_self c_val

  let φ_cat : CommRingCat.of B₀ ⟶ CommRingCat.of R_dom :=
    AlgebraicGeometry.Spec.preimage (g_dom ≫ e_C.hom)
  let φ_B₀_Rdom : B₀ →+* R_dom := φ_cat.hom
  have hSpec_φR : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B₀_Rdom) ≫ g_B₀ = g_dom := by
    change AlgebraicGeometry.Spec.map φ_cat ≫ e_C.inv = g_dom
    rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
      e_C.hom_inv_id, CategoryTheory.Category.comp_id]
  have hEt_gdom_e : AlgebraicGeometry.Etale (g_dom ≫ e_C.hom) := inferInstance
  have hEt_φR : RingHom.Etale φ_B₀_Rdom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)
      (φ := φ_cat)).mp (by rw [AlgebraicGeometry.Spec.map_preimage]; exact hEt_gdom_e)
  let _ : Algebra B₀ R_dom := φ_B₀_Rdom.toAlgebra
  have : Algebra.Etale B₀ R_dom := hEt_φR
  obtain ⟨hInj_B₀_R, hFracFin_B₀_R, -⟩ := hEtDomProps B₀ R_dom
  let K_base := FractionRing B₀
  let K₀ := FractionRing R_dom
  have hInj_B₀_K₀ : Function.Injective (algebraMap B₀ K₀) := by
    rw [IsScalarTower.algebraMap_eq B₀ R_dom K₀]
    exact (IsFractionRing.injective R_dom K₀).comp hInj_B₀_R
  have : FaithfulSMul B₀ K₀ := (faithfulSMul_iff_algebraMap_injective B₀ K₀).mpr hInj_B₀_K₀
  let _ : Algebra K_base K₀ := FractionRing.liftAlgebra B₀ K₀
  have : IsScalarTower B₀ K_base K₀ := FractionRing.isScalarTower_liftAlgebra B₀ K₀
  have : FiniteDimensional K_base K₀ := hFracFin_B₀_R K_base K₀

  
  let Ω := AlgebraicClosure K₀
  let φ_R_Ω : R_dom →+* Ω := (algebraMap K₀ Ω).comp (algebraMap R_dom K₀)
  let s_η_dom : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_dom) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω)
  have : AlgebraicGeometry.LocallyOfFiniteType f_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η inferInstance
  have : AlgebraicGeometry.IsAffineHom s_η_dom :=
    AlgebraicGeometry.isAffineHom_of_isAffine _
  have : AlgebraicGeometry.IsAffineHom ι_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η.flip inferInstance

  have hChart_a : ∀ a : Fin m_sec,
      ∃ U : Y_dom.Opens, AlgebraicGeometry.IsAffineOpen U ∧ ι_η.base (x_η a).1 ∈ U := by
    intro a
    obtain ⟨U, hAffU, hmemU, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := ι_η.base (x_η a).1) (U := (⊤ : Y_dom.Opens)) trivial
    exact ⟨U, hAffU, hmemU⟩
  choose U_a hAff_Ua hx_Ua using hChart_a
  let V_a : Fin m_sec → Y_η.Opens := fun a => (TopologicalSpace.Opens.map ι_η.base).obj (U_a a)
  have hAff_Va : ∀ a : Fin m_sec, AlgebraicGeometry.IsAffineOpen (V_a a) :=
    fun a => (AlgebraicGeometry.isAffineHom_iff ι_η).mp inferInstance (U_a a) (hAff_Ua a)
  let x_Va : ∀ a : Fin m_sec, ↥(V_a a).toScheme := fun a => ⟨(x_η a).1, hx_Ua a⟩
  have hx_Va_cl : ∀ a : Fin m_sec, IsClosed ({x_Va a} : Set ↥(V_a a).toScheme) := by
    intro a
    have hpre : ({x_Va a} : Set ↥(V_a a).toScheme) = (V_a a).ι.base ⁻¹' {(x_η a).1} := by
      ext z
      rw [Set.mem_singleton_iff, Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => by rw [h]; rfl, fun h => (V_a a).ι.isOpenEmbedding.injective h⟩
    rw [hpre]
    exact (x_η a).2.preimage (V_a a).ι.continuous
  have hSec_Va : ∀ a : Fin m_sec,
      ∃ s : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ (V_a a).toScheme,
        s ≫ ((V_a a).ι ≫ f_η) = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) ∧
        Set.range s.base = {x_Va a} := by
    intro a
    let W := (V_a a).toScheme
    let p_W : W ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω) := (V_a a).ι ≫ f_η
    have : AlgebraicGeometry.IsAffine W := hAff_Va a
    let S_Ω := AlgebraicGeometry.Spec (CommRingCat.of Ω)
    have hNonempty_Ω : Nonempty ↥S_Ω :=
      (PrimeSpectrum.nonempty_iff_nontrivial (R := Ω)).mpr inferInstance
    let pt_Ω : ↥S_Ω := Classical.choice hNonempty_Ω
    have hSub_Ω : Subsingleton ↥S_Ω := by
      change Subsingleton (PrimeSpectrum Ω)
      infer_instance
    have hpt_bot : (pt_Ω : PrimeSpectrum Ω).asIdeal = ⊥ := by
      ext c
      simp only [Ideal.mem_bot]
      refine ⟨fun hc => ?_, fun hc => hc.symm ▸ (pt_Ω : PrimeSpectrum Ω).asIdeal.zero_mem⟩
      by_contra hne
      exact (pt_Ω : PrimeSpectrum Ω).isPrime.ne_top
        (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hne))
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base (x_Va a)
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x_Va a} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      refine ⟨fun hz => ?_, fun hz => ?_⟩
      · rw [hz]
        change (e_W.hom ≫ e_W.inv).base (x_Va a) = x_Va a
        rw [e_W.hom_inv_id]
        rfl
      · dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact (hx_Va_cl a).preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_Ω_W : CommRingCat.of Ω ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_Ω_W = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_Ω_W.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType) (φ := φ_Ω_W)).mp
        (by rw [hmap_φ]; infer_instance)
    let instAlgΩB : Algebra Ω ↑B_cat := φ_Ω_W.hom.toAlgebra
    have hFT_alg : @Algebra.FiniteType Ω ↑B_cat _ _ instAlgΩB := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ :=
      @Algebra.FiniteType.iff_quotient_mvPolynomial'' Ω ↑B_cat _ _ instAlgΩB |>.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) Ω →+* ↑B_cat := q_mv.toRingHom
    let m_mv : Ideal (MvPolynomial (Fin n_mv) Ω) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal :=
      Ideal.comap_isMaximal_of_surjective q_hom hq_surj (K := q_spec.asIdeal)
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) Ω →+* Ω := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_surj
    let σ_B : ↑B_cat →+* Ω :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) Ω, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) = Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        rw [e_quot.apply_symm_apply]
        rfl
      exact congrArg (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le) heq_q
    have hσ_comp : φ_Ω_W ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of Ω) := by
      ext c
      change σ_B (@algebraMap Ω ↑B_cat _ _ instAlgΩB c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_Ω ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_Ω :=
      calc
        s ≫ p_W = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ (e_W.inv ≫ p_W) :=
          CategoryTheory.Category.assoc _ _ _
        _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫
              AlgebraicGeometry.Spec.map φ_Ω_W := by
          rw [hmap_φ]
        _ = AlgebraicGeometry.Spec.map (φ_Ω_W ≫ CommRingCat.ofHom σ_B) :=
          (AlgebraicGeometry.Spec.map_comp _ _).symm
        _ = 𝟙 S_Ω :=
          (congrArg AlgebraicGeometry.Spec.map hσ_comp).trans (AlgebraicGeometry.Spec.map_id _)
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_Ω = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_Ω : PrimeSpectrum Ω).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal Ω) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    have hs_pt : s.base pt_Ω = x_Va a := by
      change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_Ω) = x_Va a
      rw [hs_pt_spec]
      change (e_W.hom ≫ e_W.inv).base (x_Va a) = x_Va a
      rw [e_W.hom_inv_id]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    refine ⟨?_, fun hy => ⟨pt_Ω, hy ▸ hs_pt⟩⟩
    rintro ⟨z, rfl⟩
    rw [hSub_Ω.elim z pt_Ω]
    exact hs_pt
  choose s_Va hs_Va_sec hs_Va_range using hSec_Va
  let q_η : Fin m_sec → (AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Y_η) :=
    fun a => s_Va a ≫ (V_a a).ι
  have hq_η_sec : ∀ a : Fin m_sec,
      q_η a ≫ f_η = 𝟙 (AlgebraicGeometry.Spec (CommRingCat.of Ω)) := by
    intro a
    dsimp [q_η]
    rw [CategoryTheory.Category.assoc]
    exact hs_Va_sec a
  have hq_η_range : ∀ a : Fin m_sec, Set.range (q_η a).base = {(x_η a).1} := by
    intro a
    change Set.range ((V_a a).ι.base ∘ (s_Va a).base) = {(x_η a).1}
    rw [Set.range_comp, hs_Va_range a, Set.image_singleton]
    rfl

  let D_a : Fin m_sec → CommRingCat.{u} := fun a => Y_dom.presheaf.obj (Opposite.op (U_a a))
  have hRange_qη : ∀ a : Fin m_sec,
      Set.range (q_η a ≫ ι_η).base ⊆ Set.range (hAff_Ua a).fromSpec.base := by
    intro a
    rw [(hAff_Ua a).range_fromSpec]
    change Set.range (ι_η.base ∘ (q_η a).base) ⊆ (U_a a : Set ↥Y_dom)
    rw [Set.range_comp, hq_η_range a, Set.image_singleton, Set.singleton_subset_iff]
    exact hx_Ua a
  let g_Ω_Da : ∀ a : Fin m_sec,
      AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ AlgebraicGeometry.Spec (D_a a) :=
    fun a => AlgebraicGeometry.IsOpenImmersion.lift (hAff_Ua a).fromSpec (q_η a ≫ ι_η) (hRange_qη a)
  have hg_Ω_fac : ∀ a : Fin m_sec, g_Ω_Da a ≫ (hAff_Ua a).fromSpec = q_η a ≫ ι_η :=
    fun a => AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _

  let φ_R_Da_cat : ∀ a : Fin m_sec, CommRingCat.of R_dom ⟶ D_a a :=
    fun a => AlgebraicGeometry.Spec.preimage ((hAff_Ua a).fromSpec ≫ f_dom)
  let φ_R_Da : ∀ a : Fin m_sec, R_dom →+* ↑(D_a a) :=
    fun a => (φ_R_Da_cat a).hom
  let ψ_Da_Ω : ∀ a : Fin m_sec, ↑(D_a a) →+* Ω :=
    fun a => (AlgebraicGeometry.Spec.preimage (g_Ω_Da a)).hom
  have hSpec_φRDa : ∀ a : Fin m_sec,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Da a)) = (hAff_Ua a).fromSpec ≫ f_dom :=
    fun a => AlgebraicGeometry.Spec.map_preimage _
  have hSpec_ψDaΩ : ∀ a : Fin m_sec,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Da_Ω a)) = g_Ω_Da a :=
    fun a => AlgebraicGeometry.Spec.map_preimage _
  have hψ_comp_φR : ∀ a : Fin m_sec, (ψ_Da_Ω a).comp (φ_R_Da a) = φ_R_Ω := by
    intro a
    have hSpec_eq : AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom ((ψ_Da_Ω a).comp (φ_R_Da a))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_R_Ω) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_ψDaΩ a, hSpec_φRDa a,
        ← CategoryTheory.Category.assoc, hg_Ω_fac a, CategoryTheory.Category.assoc, hPb_η.w,
        ← CategoryTheory.Category.assoc, hq_η_sec a, CategoryTheory.Category.id_comp]
    exact congrArg CommRingCat.Hom.hom (AlgebraicGeometry.Spec.map_injective hSpec_eq)

  have hPres_Da : ∀ a : Fin m_sec,
      ∃ (n : ℕ) (π : MvPolynomial (Fin n) R_dom →+* ↑(D_a a)),
        Function.Surjective π ∧ π.comp MvPolynomial.C = φ_R_Da a := by
    intro a
    have hFT_hom : RingHom.FiniteType (φ_R_Da a) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType) (φ := φ_R_Da_cat a)).mp
        (by dsimp [φ_R_Da_cat]; rw [AlgebraicGeometry.Spec.map_preimage]; infer_instance)
    let instAlgRDa : Algebra R_dom ↑(D_a a) := (φ_R_Da a).toAlgebra
    have hFT_alg : @Algebra.FiniteType R_dom ↑(D_a a) _ _ instAlgRDa := hFT_hom
    obtain ⟨n, q_alg, hq_surj⟩ :=
      @Algebra.FiniteType.iff_quotient_mvPolynomial'' R_dom ↑(D_a a) _ _ instAlgRDa |>.mp hFT_alg
    refine ⟨n, q_alg.toRingHom, hq_surj, ?_⟩
    ext r
    exact q_alg.commutes r
  choose n_a π_a hπ_surj hπ_C using hPres_Da

  let S_coords : Set Ω :=
    ⋃ a : Fin m_sec, Set.range (fun i : Fin (n_a a) => ψ_Da_Ω a (π_a a (MvPolynomial.X i)))
  have hS_fin : S_coords.Finite := Set.finite_iUnion fun _ => Set.finite_range _
  have : Finite ↥S_coords := hS_fin.to_subtype
  have hS_int : ∀ z ∈ S_coords, IsIntegral K₀ z := fun z _ =>
    isAlgebraic_iff_isIntegral.mp (Algebra.IsAlgebraic.isAlgebraic (R := K₀) z)
  let F_L₁ : IntermediateField K₀ Ω := IntermediateField.adjoin K₀ S_coords
  have hFin_K₀_L₁ : FiniteDimensional K₀ ↥F_L₁ := IntermediateField.finiteDimensional_adjoin hS_int
  let L₁ : Type u := ↥F_L₁
  let ι_L₁_Ω_alg : L₁ →ₐ[K₀] Ω := F_L₁.val
  let ι_L₁_Ω : L₁ →+* Ω := ι_L₁_Ω_alg.toRingHom

  have hLift_L₁ : ∀ a : Fin m_sec,
      ∃ ψ' : ↑(D_a a) →+* L₁,
        ι_L₁_Ω.comp ψ' = ψ_Da_Ω a ∧
        ψ'.comp (φ_R_Da a) = (algebraMap K₀ L₁).comp (algebraMap R_dom K₀) := by
    intro a
    have hmem_coord : ∀ i : Fin (n_a a), ψ_Da_Ω a (π_a a (MvPolynomial.X i)) ∈ F_L₁ := fun i =>
      IntermediateField.subset_adjoin K₀ S_coords (Set.mem_iUnion.mpr ⟨a, i, rfl⟩)
    let coord_L₁ : Fin (n_a a) → L₁ := fun i => ⟨ψ_Da_Ω a (π_a a (MvPolynomial.X i)), hmem_coord i⟩
    let Φ_a : MvPolynomial (Fin (n_a a)) R_dom →+* L₁ :=
      MvPolynomial.eval₂Hom ((algebraMap K₀ L₁).comp (algebraMap R_dom K₀)) coord_L₁
    have hΦ_Ω : ι_L₁_Ω.comp Φ_a = (ψ_Da_Ω a).comp (π_a a) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [Φ_a, RingHom.comp_apply, MvPolynomial.eval₂Hom_C]
        have hc1 : ι_L₁_Ω (algebraMap K₀ L₁ (algebraMap R_dom K₀ r)) = φ_R_Ω r :=
          ι_L₁_Ω_alg.commutes (algebraMap R_dom K₀ r)
        have hc2 := RingHom.congr_fun (hπ_C a) r
        have hc3 := RingHom.congr_fun (hψ_comp_φR a) r
        simp only [RingHom.comp_apply] at hc2 hc3
        rw [hc1, ← hc3, hc2]
      · intro i
        simp only [Φ_a, RingHom.comp_apply, MvPolynomial.eval₂Hom_X']
        rfl
    have hker_π : RingHom.ker (π_a a) ≤ RingHom.ker Φ_a := by
      intro p hp
      rw [RingHom.mem_ker] at hp ⊢
      apply ι_L₁_Ω.injective
      rw [map_zero]
      have hp' := RingHom.congr_fun hΦ_Ω p
      simp only [RingHom.comp_apply, hp, map_zero] at hp'
      exact hp'
    let e_quot_a := RingHom.quotientKerEquivOfSurjective (f := π_a a) (hπ_surj a)
    let ψ' : ↑(D_a a) →+* L₁ :=
      (Ideal.Quotient.lift (RingHom.ker (π_a a)) Φ_a hker_π).comp e_quot_a.symm.toRingHom
    have hψ'_π : ψ'.comp (π_a a) = Φ_a := by
      apply RingHom.ext
      intro p
      simp only [ψ', RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      have hsymm : e_quot_a.symm (π_a a p) = Ideal.Quotient.mk (RingHom.ker (π_a a)) p := by
        apply e_quot_a.injective
        simp [e_quot_a]
      rw [hsymm]
      rfl
    have h1 : ι_L₁_Ω.comp ψ' = ψ_Da_Ω a := by
      apply RingHom.ext
      intro d
      obtain ⟨p, rfl⟩ := hπ_surj a d
      have hp1 := RingHom.congr_fun hψ'_π p
      have hp2 := RingHom.congr_fun hΦ_Ω p
      simp only [RingHom.comp_apply] at hp1 hp2 ⊢
      rw [hp1, hp2]
    have h2 : ψ'.comp (φ_R_Da a) = (algebraMap K₀ L₁).comp (algebraMap R_dom K₀) := by
      apply RingHom.ext
      intro r
      apply ι_L₁_Ω.injective
      have hr1 := RingHom.congr_fun h1 (φ_R_Da a r)
      have hr2 := RingHom.congr_fun (hψ_comp_φR a) r
      simp only [RingHom.comp_apply] at hr1 hr2 ⊢
      rw [hr1, hr2]
      exact (ι_L₁_Ω_alg.commutes (algebraMap R_dom K₀ r)).symm
    exact ⟨ψ', h1, h2⟩
  choose ψ'_Da hψ'_Ω hψ'_R using hLift_L₁
  let q_L₁_dom : Fin m_sec → (AlgebraicGeometry.Spec (CommRingCat.of L₁) ⟶ Y_dom) :=
    fun a => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ'_Da a)) ≫ (hAff_Ua a).fromSpec

  
  let instAlgKbaseL₁ : Algebra K_base L₁ :=
    ((algebraMap K₀ L₁).comp (algebraMap K_base K₀)).toAlgebra
  have hFin_KbaseL₁ : @FiniteDimensional K_base L₁ _ _ instAlgKbaseL₁.toModule := by
    obtain ⟨d₁, f₁, hf₁⟩ := @Module.Finite.exists_fin' K_base K₀ _ _ _ inferInstance
    obtain ⟨d₂, f₂, hf₂⟩ := @Module.Finite.exists_fin' K₀ L₁ _ _ _ hFin_K₀_L₁
    have hf₂_smul : ∀ (c : K₀) (v : Fin d₂ → K₀), f₂ (c • v) = c • f₂ v := f₂.map_smul
    let Idx_L := Fin d₂ × Fin d₁
    let F_comb :=
      @LinearMap.mk K_base K_base _ _ (RingHom.id K_base) (Idx_L → K_base) L₁
        _ _ _ instAlgKbaseL₁.toModule
        { toFun := fun α => f₂ (fun i => f₁ (fun j => α (i, j)))
          map_add' := fun α₁ α₂ => by
            have h_in : (fun i => f₁ (fun j => (α₁ + α₂) (i, j))) =
                (fun i => f₁ (fun j => α₁ (i, j))) + (fun i => f₁ (fun j => α₂ (i, j))) := by
              funext i
              exact f₁.map_add (fun j => α₁ (i, j)) (fun j => α₂ (i, j))
            rw [h_in, map_add] }
        (fun r α => Subtype.ext (by
          let v₀ : Fin d₂ → K₀ := fun i => f₁ (fun j => α (i, j))
          have h_in : (fun i => f₁ (fun j => (r • α) (i, j))) = algebraMap K_base K₀ r • v₀ := by
            funext i
            change f₁ (r • fun j => α (i, j)) = algebraMap K_base K₀ r * v₀ i
            exact (f₁.map_smul r (fun j => α (i, j))).trans (Algebra.smul_def r (v₀ i))
          have hL1 : (f₂ (fun i => f₁ (fun j => (r • α) (i, j)))).1 =
              (algebraMap K_base K₀ r • f₂ v₀).1 :=
            congrArg Subtype.val ((congrArg f₂ h_in).trans (hf₂_smul (algebraMap K_base K₀ r) v₀))
          have hL2 : (algebraMap K_base K₀ r • f₂ v₀).1 =
              algebraMap K₀ Ω (algebraMap K_base K₀ r) * (f₂ v₀).1 :=
            Algebra.smul_def (algebraMap K_base K₀ r) (f₂ v₀).1
          change (f₂ (fun i => f₁ (fun j => (r • α) (i, j)))).1 =
            algebraMap K₀ Ω (algebraMap K_base K₀ r) * (f₂ v₀).1
          exact hL1.trans hL2))
    have hF_surj : Function.Surjective F_comb := by
      intro z
      obtain ⟨c₂, rfl⟩ := hf₂ z
      choose c₁ hc₁ using fun i => hf₁ (c₂ i)
      refine ⟨fun p => c₁ p.1 p.2, ?_⟩
      change f₂ (fun i => f₁ (c₁ i)) = f₂ c₂
      congr 1
      funext i
      exact hc₁ i
    exact @Module.Finite.of_surjective K_base (Idx_L → K_base) _ _ _ K_base L₁
      _ _ instAlgKbaseL₁.toModule (RingHom.id K_base) inferInstance F_comb hF_surj
  have : Algebra.IsAlgebraic K_base K₀ := Algebra.IsAlgebraic.of_finite K_base K₀
  have : Algebra.IsAlgebraic K_base Ω := Algebra.IsAlgebraic.trans K_base K₀ Ω
  have hAlg_Ω : ∀ x : Ω, ∃ P : Polynomial K_base,
      P ≠ 0 ∧ Polynomial.eval₂ (ι_L₁_Ω.comp (@algebraMap K_base L₁ _ _ instAlgKbaseL₁)) x P = 0 := by
    intro x
    obtain ⟨P, hP_ne, hP_ev⟩ := Algebra.IsAlgebraic.isAlgebraic (R := K_base) x
    refine ⟨P, hP_ne, ?_⟩
    have hcomp_Ω : ι_L₁_Ω.comp (@algebraMap K_base L₁ _ _ instAlgKbaseL₁) = algebraMap K_base Ω := by
      apply RingHom.ext
      intro c
      change ι_L₁_Ω_alg (algebraMap K₀ L₁ (algebraMap K_base K₀ c)) = algebraMap K_base Ω c
      rw [ι_L₁_Ω_alg.commutes (algebraMap K_base K₀ c),
        ← IsScalarTower.algebraMap_apply K_base K₀ Ω c]
    rw [hcomp_Ω]
    exact hP_ev

  obtain ⟨B₀', instCRB₀', instDomB₀', instAlgkB₀', instFT_kB₀', hDedB₀', hNotField,
      ψ₀, x_nz, instAlgB₀'L₁, instFracB₀', τ₀',
      ⟨hx_nz_ne, hτ_xnz⟩, hτ₀'_ψ₀, halg_ψ₀, hPoly_Ω⟩ :=
    @hNormLift B₀ _ _ _ _ hDim₀ x₀ hx₀_ne τ_B₀ hτ_x₀
      K_base _ _ _ L₁ _ instAlgKbaseL₁ hFin_KbaseL₁ Ω _ ι_L₁_Ω hAlg_Ω
  let _ : CommRing B₀' := instCRB₀'
  let _ : IsDomain B₀' := instDomB₀'
  let _ : Algebra k B₀' := instAlgkB₀'
  let _ : Algebra B₀' L₁ := instAlgB₀'L₁

  let g₀' : AlgebraicGeometry.Spec (CommRingCat.of B₀') ⟶ C_aff :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom) ≫ g_B₀

  have hGoal2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀'.toRingHom) ≫ g₀' = s_c₀ := by
    have h_cat_τ : CommRingCat.ofHom ψ₀.toRingHom ≫ CommRingCat.ofHom τ₀'.toRingHom =
        CommRingCat.ofHom τ_cat.hom := by
      ext b
      change τ₀' (ψ₀ b) = τ_cat.hom b
      exact congrArg (fun f : B₀ →ₐ[k] k => f b) hτ₀'_ψ₀
    calc
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀'.toRingHom) ≫ g₀'
        = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ₀'.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom)) ≫ g_B₀ :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ψ₀.toRingHom ≫ CommRingCat.ofHom τ₀'.toRingHom) ≫ g_B₀ := by
          rw [← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_cat.hom) ≫ g_B₀ := by rw [h_cat_τ]
      _ = s_c₀ := hSpec_τ

  have hB₀_L₁_eq : (algebraMap B₀' L₁).comp ψ₀.toRingHom =
      ((algebraMap K₀ L₁).comp (algebraMap R_dom K₀)).comp φ_B₀_Rdom := by
    rw [halg_ψ₀]
    apply RingHom.ext
    intro b
    change algebraMap K₀ L₁ (algebraMap K_base K₀ (algebraMap B₀ K_base b)) =
      algebraMap K₀ L₁ (algebraMap R_dom K₀ (φ_B₀_Rdom b))
    rw [← IsScalarTower.algebraMap_apply B₀ K_base K₀ b,
      IsScalarTower.algebraMap_apply B₀ R_dom K₀ b]
    rfl

  have hGoal3 :
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_L₁_Ω.comp (algebraMap B₀' L₁))) ≫ g₀' =
        s_η_dom ≫ g_dom := by
    have h_cat_Ω :
        CommRingCat.ofHom ψ₀.toRingHom ≫ CommRingCat.ofHom (ι_L₁_Ω.comp (algebraMap B₀' L₁)) =
          CommRingCat.ofHom φ_B₀_Rdom ≫ CommRingCat.ofHom φ_R_Ω := by
      ext b
      change ι_L₁_Ω (((algebraMap B₀' L₁).comp ψ₀.toRingHom) b) = φ_R_Ω (φ_B₀_Rdom b)
      rw [hB₀_L₁_eq]
      exact ι_L₁_Ω_alg.commutes (algebraMap R_dom K₀ (φ_B₀_Rdom b))
    calc
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_L₁_Ω.comp (algebraMap B₀' L₁))) ≫ g₀'
        = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ι_L₁_Ω.comp (algebraMap B₀' L₁))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom)) ≫ g_B₀ :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ψ₀.toRingHom ≫
              CommRingCat.ofHom (ι_L₁_Ω.comp (algebraMap B₀' L₁))) ≫ g_B₀ := by
          rw [← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom φ_B₀_Rdom ≫ CommRingCat.ofHom φ_R_Ω) ≫ g_B₀ := by
          rw [h_cat_Ω]
      _ = s_η_dom ≫ (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B₀_Rdom) ≫ g_B₀) := by
          dsimp [s_η_dom]
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
      _ = s_η_dom ≫ g_dom := by rw [hSpec_φR]

  have hGoal4 : g₀' ≫ (u_C ≫ (weilAffineSpaceOver k 1).hom) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₀')) := by
    have h_cat_k : CommRingCat.ofHom (algebraMap k B₀) ≫ CommRingCat.ofHom ψ₀.toRingHom =
        CommRingCat.ofHom (algebraMap k B₀') := by
      ext c
      exact ψ₀.commutes c
    calc
      g₀' ≫ (u_C ≫ (weilAffineSpaceOver k 1).hom)
        = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom) ≫
            (g_B₀ ≫ (u_C ≫ (weilAffineSpaceOver k 1).hom)) :=
            CategoryTheory.Category.assoc _ _ _
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ₀.toRingHom) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₀)) := by
          rw [hgB₀_uC]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap k B₀) ≫ CommRingCat.ofHom ψ₀.toRingHom) :=
            (AlgebraicGeometry.Spec.map_comp _ _).symm
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₀')) := by rw [h_cat_k]

  refine ⟨B₀', instCRB₀', instDomB₀', instAlgkB₀', instFT_kB₀', hDedB₀', hNotField,
    x_nz, L₁, inferInstance, instAlgB₀'L₁, instFracB₀', g₀', τ₀', ι_L₁_Ω, q_L₁_dom, q_η,
    ⟨hx_nz_ne, hτ_xnz⟩, hGoal2, hGoal3, hGoal4, hPoly_Ω, ?_⟩
  intro a
  refine ⟨?_, hq_η_sec a, hq_η_range a, ?_⟩
  · have h_cat_L₁ :
        CommRingCat.ofHom (φ_R_Da a) ≫ CommRingCat.ofHom (ψ'_Da a) =
          CommRingCat.ofHom ((algebraMap K₀ L₁).comp (algebraMap R_dom K₀)) := by
      ext r
      exact congrArg Subtype.val (RingHom.congr_fun (hψ'_R a) r)
    have h_cat_B₀L₁ :
        CommRingCat.ofHom φ_B₀_Rdom ≫
            CommRingCat.ofHom ((algebraMap K₀ L₁).comp (algebraMap R_dom K₀)) =
          CommRingCat.ofHom ψ₀.toRingHom ≫ CommRingCat.ofHom (algebraMap B₀' L₁) := by
      ext b
      exact congrArg Subtype.val (RingHom.congr_fun hB₀_L₁_eq b).symm
    calc
      q_L₁_dom a ≫ (f_dom ≫ g_dom)
        = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ'_Da a)) ≫
            ((hAff_Ua a).fromSpec ≫ f_dom)) ≫ g_dom := by
          dsimp [q_L₁_dom]
          simp only [CategoryTheory.Category.assoc]
      _ = (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ'_Da a)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_R_Da a))) ≫ g_dom := by
          rw [← hSpec_φRDa a]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (φ_R_Da a) ≫ CommRingCat.ofHom (ψ'_Da a)) ≫ g_dom := by
          rw [← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap K₀ L₁).comp (algebraMap R_dom K₀))) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B₀_Rdom) ≫ g_B₀) := by
          rw [h_cat_L₁, hSpec_φR]
      _ = (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ((algebraMap K₀ L₁).comp (algebraMap R_dom K₀))) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B₀_Rdom)) ≫ g_B₀ :=
            (CategoryTheory.Category.assoc _ _ _).symm
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom φ_B₀_Rdom ≫
              CommRingCat.ofHom ((algebraMap K₀ L₁).comp (algebraMap R_dom K₀))) ≫ g_B₀ := by
          rw [← AlgebraicGeometry.Spec.map_comp]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom ψ₀.toRingHom ≫ CommRingCat.ofHom (algebraMap B₀' L₁)) ≫ g_B₀ := by
          rw [h_cat_B₀L₁]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' L₁)) ≫ g₀' := by
          dsimp [g₀']
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]
  · have h_cat_DaΩ :
        CommRingCat.ofHom (ψ'_Da a) ≫ CommRingCat.ofHom ι_L₁_Ω =
          CommRingCat.ofHom (ψ_Da_Ω a) := by
      ext d
      exact RingHom.congr_fun (hψ'_Ω a) d
    calc
      q_η a ≫ ι_η
        = g_Ω_Da a ≫ (hAff_Ua a).fromSpec := (hg_Ω_fac a).symm
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Da_Ω a)) ≫ (hAff_Ua a).fromSpec := by
          rw [← hSpec_ψDaΩ a]
      _ = AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ'_Da a) ≫ CommRingCat.ofHom ι_L₁_Ω) ≫ (hAff_Ua a).fromSpec := by
          rw [h_cat_DaΩ]
      _ = AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L₁_Ω) ≫ q_L₁_dom a := by
          dsimp [q_L₁_dom]
          rw [AlgebraicGeometry.Spec.map_comp, CategoryTheory.Category.assoc]

theorem weil_rel_smooth_curve_section_uniformizer_cover_and_cocycle (k : Type u) [Field k]
    (B_mid : Type u) [CommRing B_mid] [IsDomain B_mid] [Algebra k B_mid]
    (τ_mid : B_mid →ₐ[k] k)
    (Ω : Type u) [Field Ω]
    (ι_mid_Ω : B_mid →+* Ω)
    (Y_mid : AlgebraicGeometry.Scheme.{u})
    (f_mid : Quiver.Hom Y_mid (AlgebraicGeometry.Spec (CommRingCat.of B_mid)))
    [AlgebraicGeometry.IsProper f_mid]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_mid]
    (m_sec : ℕ)
    (σ_mid : Fin m_sec → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_mid)) Y_mid)
    (hσ_mid : ∀ a : Fin m_sec,
      CategoryTheory.CategoryStruct.comp (σ_mid a) f_mid =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B_mid))) :
    ∃ (t₁ : B_mid) (ht₁ : τ_mid t₁ ≠ 0),
      let B₁ := Localization.Away t₁
      ∀ (ι_B₁_Ω : B₁ →+* Ω),
        ι_B₁_Ω.comp (algebraMap B_mid B₁) = ι_mid_Ω →
        ∀ (Y_B₁ : AlgebraicGeometry.Scheme.{u})
          (q₁ : Quiver.Hom Y_B₁ Y_mid)
          (f_B₁ : Quiver.Hom Y_B₁ (AlgebraicGeometry.Spec (CommRingCat.of B₁))),
          CategoryTheory.IsPullback q₁ f_B₁ f_mid
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁))) →
          ∀ (Y_η : AlgebraicGeometry.Scheme.{u})
            [AlgebraicGeometry.IsIntegral Y_η]
            (ι_η_B₁ : Quiver.Hom Y_η Y_B₁)
            (f_η : Quiver.Hom Y_η (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
            CategoryTheory.IsPullback ι_η_B₁ f_η f_B₁
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω)) →
            ∀ (x_η : Fin m_sec → {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)})
              (q_η : Fin m_sec → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) Y_η),
              (∀ a : Fin m_sec,
                CategoryTheory.CategoryStruct.comp (q_η a) f_η =
                  CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω))) →
              (∀ a : Fin m_sec, Set.range (q_η a).base = {(x_η a).1}) →
              (∀ a : Fin m_sec,
                CategoryTheory.CategoryStruct.comp
                  (CategoryTheory.CategoryStruct.comp (q_η a) ι_η_B₁) q₁ =
                  CategoryTheory.CategoryStruct.comp
                    (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_mid_Ω)) (σ_mid a)) →
              ∃ (N_cov : ℕ) (_ : 1 ≤ N_cov)
                (W₁ : Fin N_cov → Y_B₁.Opens)
                (h_sec : Fin m_sec → ∀ α : Fin N_cov,
                  ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α))))
                (r_sec : Fin m_sec → ∀ α β : Fin N_cov,
                  Units ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α ⊓ W₁ β)))),
                ((⨆ α : Fin N_cov, W₁ α) = ⊤ ∧
                  ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (W₁ α)) ∧
                ((∀ (a : Fin m_sec) (α : Fin N_cov), (r_sec a α α).1 = 1) ∧
                  (∀ (a : Fin m_sec) (α β γ : Fin N_cov),
                    (Y_B₁.presheaf.map
                      (CategoryTheory.homOfLE
                        (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
                          (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β)).op).hom (r_sec a α β).1 *
                    (Y_B₁.presheaf.map
                      (CategoryTheory.homOfLE
                        (fun _ hx => ⟨hx.1.2, hx.2⟩ :
                          (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ)).op).hom (r_sec a β γ).1 =
                    (Y_B₁.presheaf.map
                      (CategoryTheory.homOfLE
                        (fun _ hx => ⟨hx.1.1, hx.2⟩ :
                          (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ)).op).hom (r_sec a α γ).1) ∧
                  (∀ (a : Fin m_sec) (α β : Fin N_cov),
                    (r_sec a α β).1 *
                      (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
                        (h_sec a β) =
                    (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
                      (h_sec a α))) ∧
                (let V : Fin N_cov → Y_η.Opens :=
                  fun α => (TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α)
                 ∀ (a : Fin m_sec) (α : Fin N_cov)
                   (x : {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)})
                   (hx : x.1 ∈ V α),
                   (x = x_η a →
                     Ideal.span {(Y_η.presheaf.germ (V α) x.1 hx).hom
                       ((ι_η_B₁.app (W₁ α)).hom (h_sec a α))} =
                       IsLocalRing.maximalIdeal ↑(Y_η.presheaf.stalk x.1)) ∧
                   (x ≠ x_η a →
                     Ideal.span {(Y_η.presheaf.germ (V α) x.1 hx).hom
                       ((ι_η_B₁.app (W₁ α)).hom (h_sec a α))} = ⊤)) :=
by
  classical
  
  have hAppRes :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
        {U₁ U₂ : Y.Opens} (hle : U₁ ≤ U₂)
        (hle' : (TopologicalSpace.Opens.map f.base).obj U₁ ≤
          (TopologicalSpace.Opens.map f.base).obj U₂)
        (z : ↑(Y.presheaf.obj (Opposite.op U₂))),
        (X.presheaf.map (CategoryTheory.homOfLE hle').op).hom ((f.app U₂).hom z) =
          (f.app U₁).hom ((Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom z) := by
    intro X Y f U₁ U₂ hle hle' z
    have hmor : CategoryTheory.homOfLE hle' =
        (TopologicalSpace.Opens.map f.base).map (CategoryTheory.homOfLE hle) :=
      Subsingleton.elim _ _
    rw [hmor]
    change (f.app U₂ ≫ X.presheaf.map
      ((TopologicalSpace.Opens.map f.base).map (CategoryTheory.homOfLE hle)).op).hom z =
      (Y.presheaf.map (CategoryTheory.homOfLE hle).op ≫ f.app U₁).hom z
    rw [AlgebraicGeometry.Scheme.Hom.naturality]
    rfl

  
  have hOpenPb :
      ∀ {X' X : AlgebraicGeometry.Scheme.{u}} (q : X' ⟶ X)
        {V : X.Opens} (hV : AlgebraicGeometry.IsAffineOpen V)
        (hU : AlgebraicGeometry.IsAffineOpen ((TopologicalSpace.Opens.map q.base).obj V)),
        CategoryTheory.IsPullback
          hU.fromSpec
          (AlgebraicGeometry.Spec.map (q.appLE V ((TopologicalSpace.Opens.map q.base).obj V) le_rfl))
          q
          hV.fromSpec := by
    intro X' X q V hV hU
    let U : X'.Opens := (TopologicalSpace.Opens.map q.base).obj V
    let w := AlgebraicGeometry.Spec.map (q.appLE V U le_rfl)
    have hw : hU.fromSpec ≫ q = w ≫ hV.fromSpec :=
      (AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec q hV hU le_rfl).symm
    refine CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hw
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift hU.fromSpec s.fst ?_)
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift_fac hU.fromSpec s.fst _)
        (fun s => ?_)
        (fun s m hm _ => ?_))
    · rw [hU.range_fromSpec]
      rintro _ ⟨t, rfl⟩
      change q.base (s.fst.base t) ∈ (V : Set ↥X)
      rw [← hV.range_fromSpec]
      have hst : q.base (s.fst.base t) = hV.fromSpec.base (s.snd.base t) := by
        change (s.fst ≫ q).base t = (s.snd ≫ hV.fromSpec).base t
        rw [s.condition]
      exact ⟨s.snd.base t, hst.symm⟩
    · apply (cancel_mono hV.fromSpec).mp
      rw [CategoryTheory.Category.assoc, ← hw, ← CategoryTheory.Category.assoc,
        AlgebraicGeometry.IsOpenImmersion.lift_fac, s.condition]
    · apply (cancel_mono hU.fromSpec).mp
      rw [hm, AlgebraicGeometry.IsOpenImmersion.lift_fac]

  
  have hEtalePolyBC :
      ∀ {A B R D : Type u} [CommRing A] [CommRing B] [CommRing R] [CommRing D]
        (φ_AB : A →+* B) (φ_RD : R →+* D) (φ_BD : B →+* D) (ψ : Polynomial A →+* R),
        RingHom.Etale ψ →
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp Polynomial.C)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AB)) →
        ∃ ψ_B : Polynomial B →+* D,
          RingHom.Etale ψ_B ∧
          ψ_B.comp Polynomial.C = φ_BD ∧
          ∀ P : Polynomial A, ψ_B (P.map φ_AB) = φ_RD (ψ P) := by
    intro A B R D _ _ _ _ φ_AB φ_RD φ_BD ψ hψ_et hPb
    let _ : Algebra A B := φ_AB.toAlgebra
    let alg_B : B →ₐ[A] Polynomial B :=
      { Polynomial.C with
        commutes' := fun a => by
          change Polynomial.C (φ_AB a) = algebraMap A (Polynomial B) a
          exact (Polynomial.algebraMap_apply a).symm }
    let alg_PA : Polynomial A →ₐ[A] Polynomial B :=
      Polynomial.mapAlgHom (Algebra.ofId A B)
    have halg_PA_apply : ∀ P : Polynomial A, alg_PA P = Polynomial.map φ_AB P :=
      fun _ => rfl
    let fwd_TB : TensorProduct A B (Polynomial A) →+* Polynomial B :=
      (Algebra.TensorProduct.productMap alg_B alg_PA).toRingHom
    let bwd_TB : Polynomial B →+* TensorProduct A B (Polynomial A) :=
      Polynomial.eval₂RingHom Algebra.TensorProduct.includeLeftRingHom
        ((1 : B) ⊗ₜ[A] Polynomial.X)
    have hbwd_PA : ∀ P : Polynomial A, bwd_TB (alg_PA P) = (1 : B) ⊗ₜ[A] P := by
      have hcomp : bwd_TB.comp (Polynomial.mapRingHom φ_AB) =
          Algebra.TensorProduct.includeRight.toRingHom := by
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun a => ?_
          change bwd_TB (Polynomial.map φ_AB (Polynomial.C a)) = (1 : B) ⊗ₜ[A] Polynomial.C a
          rw [Polynomial.map_C]
          have hCa : Polynomial.C a = a • (1 : Polynomial A) :=
            Algebra.algebraMap_eq_smul_one a
          have hbC : bwd_TB (Polynomial.C (φ_AB a)) = (φ_AB a) ⊗ₜ[A] (1 : Polynomial A) :=
            Polynomial.eval₂_C _ _
          rw [hbC, hCa, ← TensorProduct.smul_tmul]
          change (φ_AB a) ⊗ₜ[A] (1 : Polynomial A) = (φ_AB a * 1) ⊗ₜ[A] (1 : Polynomial A)
          rw [mul_one]
        · change bwd_TB (Polynomial.map φ_AB Polynomial.X) = (1 : B) ⊗ₜ[A] Polynomial.X
          rw [Polynomial.map_X]
          exact Polynomial.eval₂_X _ _
      intro P
      exact RingHom.congr_fun hcomp P
    have hbwd_fwd : ∀ z : TensorProduct A B (Polynomial A), bwd_TB (fwd_TB z) = z := by
      intro z
      refine TensorProduct.inductionOn (motive := fun w => bwd_TB (fwd_TB w) = w) z ?_ ?_
      · intro b P
        change bwd_TB (Polynomial.C b * alg_PA P) = b ⊗ₜ[A] P
        rw [map_mul]
        have hb : bwd_TB (Polynomial.C b) = b ⊗ₜ[A] (1 : Polynomial A) :=
          Polynomial.eval₂_C _ _
        rw [hb, hbwd_PA P, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      · intro x y hx hy
        rw [map_add, map_add, hx, hy]
    have hfwd_bwd : ∀ P : Polynomial B, fwd_TB (bwd_TB P) = P := by
      have hcomp : fwd_TB.comp bwd_TB = RingHom.id (Polynomial B) := by
        apply Polynomial.ringHom_ext'
        · refine RingHom.ext fun b => ?_
          change fwd_TB (bwd_TB (Polynomial.C b)) = Polynomial.C b
          have hb : bwd_TB (Polynomial.C b) = b ⊗ₜ[A] (1 : Polynomial A) :=
            Polynomial.eval₂_C _ _
          rw [hb]
          change alg_B b * alg_PA 1 = Polynomial.C b
          rw [map_one, mul_one]
          rfl
        · change fwd_TB (bwd_TB Polynomial.X) = Polynomial.X
          have hX : bwd_TB Polynomial.X = (1 : B) ⊗ₜ[A] Polynomial.X :=
            Polynomial.eval₂_X _ _
          rw [hX]
          change alg_B 1 * alg_PA Polynomial.X = Polynomial.X
          rw [map_one, one_mul, halg_PA_apply]
          exact Polynomial.map_X φ_AB
      intro P
      exact RingHom.congr_fun hcomp P
    let e_TB : TensorProduct A B (Polynomial A) ≃+* Polynomial B :=
      { toFun := fwd_TB
        invFun := bwd_TB
        left_inv := hbwd_fwd
        right_inv := hfwd_bwd
        map_mul' := map_mul fwd_TB
        map_add' := map_add fwd_TB }
    let iso_Spec_TB : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A B (Polynomial A))) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_TB.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_TB.symm.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have he1 : e_TB.toRingHom.comp e_TB.symm.toRingHom = RingHom.id _ :=
            RingHom.ext e_TB.apply_symm_apply
          rw [he1, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have he2 : e_TB.symm.toRingHom.comp e_TB.toRingHom = RingHom.id _ :=
            RingHom.ext e_TB.symm_apply_apply
          rw [he2, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id] }
    let f_AB := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A B))
    let f_AC := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))
    let π_B := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.C : B →+* Polynomial B))
    let π_PA := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (Polynomial.mapRingHom φ_AB))
    let iso_pb : AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B)) ≅
        CategoryTheory.Limits.pullback f_AB f_AC :=
      iso_Spec_TB ≪≫ (AlgebraicGeometry.pullbackSpecIso A B (Polynomial A)).symm
    have hiso_fst : iso_pb.hom ≫ CategoryTheory.Limits.pullback.fst f_AB f_AC = π_B := by
      dsimp [iso_pb, iso_Spec_TB, π_B]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      refine RingHom.ext fun b => ?_
      change fwd_TB (b ⊗ₜ[A] 1) = Polynomial.C b
      change alg_B b * alg_PA 1 = Polynomial.C b
      rw [map_one, mul_one]
      rfl
    have hiso_snd : iso_pb.hom ≫ CategoryTheory.Limits.pullback.snd f_AB f_AC = π_PA := by
      dsimp [iso_pb, iso_Spec_TB, π_PA]
      rw [CategoryTheory.Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      refine RingHom.ext fun P => ?_
      change fwd_TB (1 ⊗ₜ[A] P) = Polynomial.mapRingHom φ_AB P
      change alg_B 1 * alg_PA P = Polynomial.mapRingHom φ_AB P
      rw [map_one, one_mul]
      rfl
    have hPb_poly : CategoryTheory.IsPullback π_B π_PA f_AB f_AC :=
      (CategoryTheory.IsPullback.of_hasPullback f_AB f_AC).of_iso
        iso_pb.symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
        (by simp [← hiso_fst]) (by simp [← hiso_snd]) (by simp) (by simp)
    have hPb_flip : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD))
        f_AB
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ f_AC) := by
      have hfac : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ.comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) ≫ f_AC := by
        dsimp [f_AC]
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      simpa [f_AB, hfac] using hPb.flip
    have hcomm_u : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD) ≫ f_AB =
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) ≫ f_AC := by
      rw [CategoryTheory.Category.assoc, hPb_flip.w]
    let u_et : AlgebraicGeometry.Spec (CommRingCat.of D) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of (Polynomial B)) :=
      hPb_poly.lift
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ))
        hcomm_u
    have hu_B : u_et ≫ π_B = AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD) :=
      hPb_poly.lift_fst _ _ _
    have hu_PA : u_et ≫ π_PA =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD) ≫
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ) :=
      hPb_poly.lift_snd _ _ _
    have hPb_et : CategoryTheory.IsPullback
        u_et
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD))
        π_PA
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) := by
      refine CategoryTheory.IsPullback.of_right ?_ hu_PA hPb_poly
      rw [hu_B]
      exact hPb_flip
    have hEt_ψ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_et
    have hEt_u : AlgebraicGeometry.Etale u_et :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_et.flip hEt_ψ
    let ψ_B : Polynomial B →+* D := (AlgebraicGeometry.Spec.preimage u_et).hom
    have hSpec_ψB : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_B) = u_et :=
      AlgebraicGeometry.Spec.map_preimage u_et
    have hψB_et : RingHom.Etale ψ_B := by
      refine (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale) (φ := CommRingCat.ofHom ψ_B)).mp ?_
      rwa [hSpec_ψB]
    have hψB_C : ψ_B.comp Polynomial.C = φ_BD := by
      have hEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_B.comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_ψB]
        exact hu_B
      exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hEq)
    have hψB_map : ∀ P : Polynomial A, ψ_B (P.map φ_AB) = φ_RD (ψ P) := by
      have hEq : AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ψ_B.comp (Polynomial.mapRingHom φ_AB))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_RD.comp ψ)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_ψB,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp]
        exact hu_PA
      have hhom := CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hEq)
      intro P
      exact RingHom.congr_fun hhom P
    exact ⟨ψ_B, hψB_et, hψB_C, hψB_map⟩

  
  let p_max : Ideal B_mid := RingHom.ker τ_mid.toRingHom
  have hp_max : p_max.IsPrime := RingHom.ker_isPrime τ_mid.toRingHom
  let pt_max : ↥(AlgebraicGeometry.Spec (CommRingCat.of B_mid)) :=
    (⟨p_max, hp_max⟩ : PrimeSpectrum B_mid)

  have hChart_mid : ∀ a : Fin m_sec,
      ∃ (U_base : (AlgebraicGeometry.Spec (CommRingCat.of B_mid)).Opens)
        (hAff_Ubase : AlgebraicGeometry.IsAffineOpen U_base)
        (V_sm : Y_mid.Opens)
        (hAff_Vsm : AlgebraicGeometry.IsAffineOpen V_sm)
        (hmem_V : (σ_mid a).base pt_max ∈ V_sm)
        (he_V : V_sm ≤ (TopologicalSpace.Opens.map f_mid.base).obj U_base)
        (ψ_poly₀ : Polynomial ↑((AlgebraicGeometry.Spec (CommRingCat.of B_mid)).presheaf.obj
            (Opposite.op U_base)) →+*
          ↑(Y_mid.presheaf.obj (Opposite.op V_sm)))
        (s_a : B_mid),
        ψ_poly₀.comp Polynomial.C = (f_mid.appLE U_base V_sm he_V).hom ∧
        RingHom.Etale ψ_poly₀ ∧
        τ_mid s_a ≠ 0 ∧
        (PrimeSpectrum.basicOpen s_a : Set (PrimeSpectrum B_mid)) ⊆
          (U_base : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B_mid))) ∩
            (σ_mid a).base ⁻¹' (V_sm : Set ↥Y_mid) := by
    intro a
    obtain ⟨U_base, hAff_Ubase, V_sm, hAff_Vsm, hmem_V, he_V, hStd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f_mid).mp inferInstance
        ((σ_mid a).base pt_max)
    obtain ⟨ψ_mv, hψ_mv_C, hψ_mv_et⟩ := hStd.exists_etale_mvPolynomial
    let A₀ : Type u := ↑((AlgebraicGeometry.Spec (CommRingCat.of B_mid)).presheaf.obj
      (Opposite.op U_base))
    let R₀ : Type u := ↑(Y_mid.presheaf.obj (Opposite.op V_sm))
    let to_mv : Polynomial A₀ →+* MvPolynomial (Fin 1) A₀ :=
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
    let from_mv : MvPolynomial (Fin 1) A₀ →+* Polynomial A₀ :=
      MvPolynomial.eval₂Hom Polynomial.C (fun _ => Polynomial.X)
    have h_from_to : from_mv.comp to_mv = RingHom.id (Polynomial A₀) := by
      apply Polynomial.ringHom_ext'
      · ext b
        simp [to_mv, from_mv]
      · simp [to_mv, from_mv]
    have h_to_from : to_mv.comp from_mv = RingHom.id (MvPolynomial (Fin 1) A₀) := by
      apply MvPolynomial.ringHom_ext
      · intro b
        simp [to_mv, from_mv]
      · intro i
        rw [Subsingleton.elim i 0]
        simp [to_mv, from_mv]
    let ψ_poly₀ : Polynomial A₀ →+* R₀ := ψ_mv.comp to_mv
    have hψ_poly₀_C : ψ_poly₀.comp Polynomial.C = (f_mid.appLE U_base V_sm he_V).hom := by
      ext b
      change ψ_mv (to_mv (Polynomial.C b)) = (f_mid.appLE U_base V_sm he_V).hom b
      have hC : to_mv (Polynomial.C b) = MvPolynomial.C b := Polynomial.eval₂_C _ _
      rw [hC, ← hψ_mv_C]
      rfl
    have hIso_to_mv : CategoryTheory.IsIso
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom to_mv)) :=
      ⟨⟨AlgebraicGeometry.Spec.map (CommRingCat.ofHom from_mv),
        by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_to_from,
             CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id],
        by rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_from_to,
             CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]⟩⟩
    have hEt_mv_spec : AlgebraicGeometry.Etale
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_mv)) :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_mv_et
    have hψ_poly₀_et : RingHom.Etale ψ_poly₀ := by
      refine (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.Etale) (φ := CommRingCat.ofHom ψ_poly₀)).mp ?_
      change AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom to_mv ≫ CommRingCat.ofHom ψ_mv))
      rw [AlgebraicGeometry.Spec.map_comp]
      exact inferInstance
    let O_a : Set (PrimeSpectrum B_mid) :=
      (U_base : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B_mid))) ∩
        (σ_mid a).base ⁻¹' (V_sm : Set ↥Y_mid)
    have hO_open : IsOpen O_a :=
      U_base.isOpen.inter (V_sm.isOpen.preimage (σ_mid a).base.hom.continuous)
    have hpt_U : pt_max ∈ U_base := by
      have hf_pt : f_mid.base ((σ_mid a).base pt_max) = pt_max := by
        change (σ_mid a ≫ f_mid).base pt_max = pt_max
        rw [hσ_mid a]
        rfl
      rw [← hf_pt]
      exact he_V hmem_V
    have hpt_O : (pt_max : PrimeSpectrum B_mid) ∈ O_a := ⟨hpt_U, hmem_V⟩
    obtain ⟨_, ⟨s_a, rfl⟩, hpt_basic, hsub_O⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hpt_O hO_open
    have hs_ne : τ_mid s_a ≠ 0 := hpt_basic
    exact ⟨U_base, hAff_Ubase, V_sm, hAff_Vsm, hmem_V, he_V, ψ_poly₀, s_a,
      hψ_poly₀_C, hψ_poly₀_et, hs_ne, hsub_O⟩

  choose U_base hAff_Ubase V_sm hAff_Vsm hmem_V he_V ψ_poly₀ s_mid
    hψ_poly₀_C hψ_poly₀_et hs_mid_ne hsub_mid using hChart_mid

  let t₁ : B_mid := Finset.univ.prod s_mid
  have ht₁ : τ_mid t₁ ≠ 0 := by
    dsimp [t₁]
    rw [map_prod]
    exact Finset.prod_ne_zero_iff.mpr fun a _ => hs_mid_ne a

  refine ⟨t₁, ht₁, ?_⟩
  intro B₁ ι_B₁_Ω hι_comp Y_B₁ q₁ f_B₁ hPb_q₁ Y_η _ ι_η_B₁ f_η hPb_η x_η q_η hq_sec hq_range hq_mid

  let g_B₁ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B_mid) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁))

  have hProp_fB₁ : AlgebraicGeometry.IsProper f_B₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_q₁ inferInstance
  let _ : AlgebraicGeometry.IsProper f_B₁ := hProp_fB₁

  have hAffHom_gB₁ : AlgebraicGeometry.IsAffineHom g_B₁ :=
    AlgebraicGeometry.isAffineHom_of_isAffine _
  have hAffHom_q₁ : AlgebraicGeometry.IsAffineHom q₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_q₁.flip hAffHom_gB₁
  let _ : AlgebraicGeometry.IsAffineHom q₁ := hAffHom_q₁

  
  have hChart_B₁ : ∀ a : Fin m_sec,
      ∃ (U_aff : Y_B₁.Opens)
        (hAff : AlgebraicGeometry.IsAffineOpen U_aff)
        (σ_a : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ Y_B₁)
        (σ_aff : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶
          AlgebraicGeometry.Spec (Y_B₁.presheaf.obj (Opposite.op U_aff)))
        (ψ_a : Polynomial B₁ →+* ↑(Y_B₁.presheaf.obj (Opposite.op U_aff)))
        (c_a : B₁),
        σ_a ≫ f_B₁ = CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B₁)) ∧
        σ_a ≫ q₁ = g_B₁ ≫ σ_mid a ∧
        σ_aff ≫ hAff.fromSpec = σ_a ∧
        RingHom.Etale ψ_a ∧
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_a.comp Polynomial.C)) =
          hAff.fromSpec ≫ f_B₁ ∧
        (AlgebraicGeometry.Spec.preimage σ_aff).hom
          (ψ_a (Polynomial.X - Polynomial.C c_a)) = 0 := by
    intro a
    let σ_a : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ Y_B₁ :=
      hPb_q₁.lift (g_B₁ ≫ σ_mid a)
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B₁)))
        (by rw [CategoryTheory.Category.assoc, hσ_mid a,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have hσ_a_sec : σ_a ≫ f_B₁ =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B₁)) :=
      hPb_q₁.lift_snd _ _ _
    have hσ_a_q₁ : σ_a ≫ q₁ = g_B₁ ≫ σ_mid a :=
      hPb_q₁.lift_fst _ _ _
    let U_aff : Y_B₁.Opens := (TopologicalSpace.Opens.map q₁.base).obj (V_sm a)
    have hAff : AlgebraicGeometry.IsAffineOpen U_aff := (hAff_Vsm a).preimage q₁
    have hg_in_O : ∀ p : ↥(AlgebraicGeometry.Spec (CommRingCat.of B₁)),
        g_B₁.base p ∈ U_base a ∧ (σ_mid a).base (g_B₁.base p) ∈ V_sm a := by
      intro p
      apply hsub_mid a
      let p_B₁ : PrimeSpectrum B₁ := p
      have hcomap_mem : PrimeSpectrum.comap (algebraMap B_mid B₁) p_B₁ ∈
          Set.range (PrimeSpectrum.comap (algebraMap B_mid B₁)) := ⟨p_B₁, rfl⟩
      rw [PrimeSpectrum.localization_away_comap_range B₁ t₁] at hcomap_mem
      have hg_eq : g_B₁.base p = PrimeSpectrum.comap (algebraMap B_mid B₁) p_B₁ :=
        AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom (algebraMap B_mid B₁)) p
      rw [hg_eq]
      let J_p : Ideal B_mid := (PrimeSpectrum.comap (algebraMap B_mid B₁) p_B₁).asIdeal
      change s_mid a ∉ J_p
      intro hs_mem
      have hdvd : s_mid a ∣ t₁ := Finset.dvd_prod_of_mem s_mid (Finset.mem_univ a)
      rcases hdvd with ⟨d_mul, hd_mul⟩
      have ht₁_mem : t₁ ∈ J_p := hd_mul ▸ J_p.mul_mem_right d_mul hs_mem
      exact hcomap_mem ht₁_mem
    have hσ_range : Set.range σ_a.base ⊆ Set.range hAff.fromSpec.base := by
      rw [hAff.range_fromSpec]
      rintro _ ⟨p, rfl⟩
      change q₁.base (σ_a.base p) ∈ V_sm a
      have hqp : q₁.base (σ_a.base p) = (σ_mid a).base (g_B₁.base p) := by
        change (σ_a ≫ q₁).base p = (g_B₁ ≫ σ_mid a).base p
        rw [hσ_a_q₁]
      rw [hqp]
      exact (hg_in_O p).2
    let σ_aff := AlgebraicGeometry.IsOpenImmersion.lift hAff.fromSpec σ_a hσ_range
    have hσ_aff_fac : σ_aff ≫ hAff.fromSpec = σ_a :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hAff.fromSpec σ_a hσ_range
    have hg_range : Set.range g_B₁.base ⊆ Set.range (hAff_Ubase a).fromSpec.base := by
      rw [(hAff_Ubase a).range_fromSpec]
      rintro _ ⟨p, rfl⟩
      exact (hg_in_O p).1
    obtain ⟨g_Ubase, hg_Ubase_fac⟩ :
        ∃ g : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶
          AlgebraicGeometry.Spec ((AlgebraicGeometry.Spec (CommRingCat.of B_mid)).presheaf.obj
            (Opposite.op (U_base a))),
          g ≫ (hAff_Ubase a).fromSpec = g_B₁ :=
      ⟨AlgebraicGeometry.IsOpenImmersion.lift (hAff_Ubase a).fromSpec g_B₁ hg_range,
       AlgebraicGeometry.IsOpenImmersion.lift_fac (hAff_Ubase a).fromSpec g_B₁ hg_range⟩
    let w_q₁ := AlgebraicGeometry.Spec.map (q₁.appLE (V_sm a) U_aff le_rfl)
    have hPb_open : CategoryTheory.IsPullback hAff.fromSpec w_q₁ q₁ (hAff_Vsm a).fromSpec :=
      hOpenPb q₁ (hAff_Vsm a) hAff
    have hPb_pasted : CategoryTheory.IsPullback
        w_q₁ (hAff.fromSpec ≫ f_B₁) ((hAff_Vsm a).fromSpec ≫ f_mid) g_B₁ :=
      hPb_open.flip.paste_vert hPb_q₁
    have hPb_mono : CategoryTheory.IsPullback
        g_Ubase
        (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B₁)))
        (hAff_Ubase a).fromSpec
        g_B₁ :=
      CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk
          (by rw [CategoryTheory.Category.id_comp, hg_Ubase_fac])
          (fun s => s.snd)
          (fun s => (cancel_mono (hAff_Ubase a).fromSpec).mp
            (by rw [CategoryTheory.Category.assoc, hg_Ubase_fac, ← s.condition]))
          (fun s => CategoryTheory.Category.comp_id s.snd)
          (fun s m _ hm => by simpa using hm))
    have hf_mid_app :
        AlgebraicGeometry.Spec.map (f_mid.appLE (U_base a) (V_sm a) (he_V a)) ≫
          (hAff_Ubase a).fromSpec = (hAff_Vsm a).fromSpec ≫ f_mid :=
      AlgebraicGeometry.IsAffineOpen.SpecMap_appLE_fromSpec
        f_mid (hAff_Ubase a) (hAff_Vsm a) (he_V a)
    have hPb_aff : CategoryTheory.IsPullback
        w_q₁
        (hAff.fromSpec ≫ f_B₁)
        (AlgebraicGeometry.Spec.map (f_mid.appLE (U_base a) (V_sm a) (he_V a)))
        g_Ubase := by
      refine CategoryTheory.IsPullback.of_bot ?_ ?_ hPb_mono
      · rw [CategoryTheory.Category.comp_id, hf_mid_app]
        exact hPb_pasted
      · apply (cancel_mono (hAff_Ubase a).fromSpec).mp
        rw [CategoryTheory.Category.assoc, hf_mid_app, hPb_pasted.w,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hg_Ubase_fac]
        exact (CategoryTheory.Category.assoc _ _ _).symm
    let A₀ : Type u := ↑((AlgebraicGeometry.Spec (CommRingCat.of B_mid)).presheaf.obj
      (Opposite.op (U_base a)))
    let R₀ : Type u := ↑(Y_mid.presheaf.obj (Opposite.op (V_sm a)))
    let R_a : Type u := ↑(Y_B₁.presheaf.obj (Opposite.op U_aff))
    let φ_AB : A₀ →+* B₁ := (AlgebraicGeometry.Spec.preimage g_Ubase).hom
    let φ_RD : R₀ →+* R_a := (q₁.appLE (V_sm a) U_aff le_rfl).hom
    let φ_BD : B₁ →+* R_a := (AlgebraicGeometry.Spec.preimage (hAff.fromSpec ≫ f_B₁)).hom
    have hPb_rings : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ_poly₀ a).comp Polynomial.C)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AB)) := by
      have h1 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD) = w_q₁ := rfl
      have h2 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_BD) = hAff.fromSpec ≫ f_B₁ :=
        AlgebraicGeometry.Spec.map_preimage _
      have h3 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ_poly₀ a).comp Polynomial.C)) =
          AlgebraicGeometry.Spec.map (f_mid.appLE (U_base a) (V_sm a) (he_V a)) := by
        rw [hψ_poly₀_C a]
        rfl
      have h4 : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_AB) = g_Ubase :=
        AlgebraicGeometry.Spec.map_preimage _
      rw [h1, h2, h3, h4]
      exact hPb_aff
    obtain ⟨ψ_a, hψ_a_et, hψ_a_C, _⟩ :=
      hEtalePolyBC φ_AB φ_RD φ_BD (ψ_poly₀ a) (hψ_poly₀_et a) hPb_rings
    have hSpec_ψC :
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_a.comp Polynomial.C)) =
          hAff.fromSpec ≫ f_B₁ := by
      rw [hψ_a_C]
      exact AlgebraicGeometry.Spec.map_preimage _
    let ev_a : R_a →+* B₁ := (AlgebraicGeometry.Spec.preimage σ_aff).hom
    have hSpec_eva : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_a) = σ_aff :=
      AlgebraicGeometry.Spec.map_preimage σ_aff
    let c_a : B₁ := ev_a (ψ_a Polynomial.X)
    have hev_C : ev_a.comp (ψ_a.comp Polynomial.C) = RingHom.id B₁ := by
      have hEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_a.comp (ψ_a.comp Polynomial.C))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id B₁)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_ψC,
          hSpec_eva, ← CategoryTheory.Category.assoc,
          hσ_aff_fac, hσ_a_sec, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hEq)
    have hev_zero : ev_a (ψ_a (Polynomial.X - Polynomial.C c_a)) = 0 := by
      rw [map_sub, map_sub]
      have hc_id : ev_a (ψ_a (Polynomial.C c_a)) = c_a :=
        RingHom.congr_fun hev_C c_a
      rw [hc_id]
      exact sub_self c_a
    exact ⟨U_aff, hAff, σ_a, σ_aff, ψ_a, c_a,
      hσ_a_sec, hσ_a_q₁, hσ_aff_fac, hψ_a_et, hSpec_ψC, hev_zero⟩

  choose U_aff hAff_U σ_a σ_aff ψ_a c_a
    hσ_a_sec hσ_a_q₁ hσ_aff_fac hψ_a_et hSpec_ψC hev_zero using hChart_B₁

  
  have hTwoChart : ∀ a : Fin m_sec,
      ∃ (U_in U_out : Y_B₁.Opens)
        (hle_in : U_in ≤ U_aff a)
        (u_ov : Units ↑(Y_B₁.presheaf.obj (Opposite.op (U_in ⊓ U_out)))),
        U_in ⊔ U_out = ⊤ ∧
        (U_out : Set ↥Y_B₁) = (Set.range (σ_a a).base)ᶜ ∧
        (Y_B₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_in ⊓ U_out ≤ U_in)).op).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE hle_in).op).hom
            (ψ_a a (Polynomial.X - Polynomial.C (c_a a)))) = u_ov.1 := by
    intro a
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion (σ_a a ≫ f_B₁) := by
      rw [hσ_a_sec a]
      infer_instance
    have hCl_σ : AlgebraicGeometry.IsClosedImmersion (σ_a a) :=
      AlgebraicGeometry.IsClosedImmersion.of_comp (σ_a a) f_B₁
    let _ : AlgebraicGeometry.IsClosedImmersion (σ_a a) := hCl_σ
    let U_out : Y_B₁.Opens :=
      ⟨(Set.range (σ_a a).base)ᶜ, (σ_a a).isClosedEmbedding.isClosed_range.isOpen_compl⟩
    let R_cat := Y_B₁.presheaf.obj (Opposite.op (U_aff a))
    let R : Type u := ↑R_cat
    let t : R := ψ_a a (Polynomial.X - Polynomial.C (c_a a))
    let I_t : Ideal R := Ideal.span {t}
    let Q : Type u := R ⧸ I_t
    let π_Q : R →+* Q := Ideal.Quotient.mk I_t
    let φ_B₁_R : B₁ →+* R := (ψ_a a).comp Polynomial.C
    let φ_B₁_Q : B₁ →+* Q := π_Q.comp φ_B₁_R
    have hπ_t : π_Q t = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self t)

    have hEt_Q : RingHom.Etale φ_B₁_Q := by
      let P_ring := Polynomial B₁
      let _ : Algebra P_ring R := (ψ_a a).toAlgebra
      have _ : Algebra.Etale P_ring R := RingHom.etale_algebraMap.mp (hψ_a_et a)
      let _ : Algebra P_ring B₁ := (Polynomial.evalRingHom (c_a a)).toAlgebra
      have _ : Algebra.Etale B₁ (TensorProduct P_ring B₁ R) :=
        Algebra.Etale.baseChange P_ring R B₁
      let _ : Algebra B₁ Q := φ_B₁_Q.toAlgebra
      let _ : Algebra P_ring Q := (π_Q.comp (ψ_a a)).toAlgebra
      have h_eval_eq : ∀ p : Polynomial B₁,
          φ_B₁_Q (Polynomial.eval (c_a a) p) = π_Q (ψ_a a p) := by
        intro p
        rcases @Polynomial.X_sub_C_dvd_sub_C_eval B₁ (c_a a) _ p with ⟨q_div, hq_div⟩
        have hsub : π_Q (ψ_a a (p - Polynomial.C (Polynomial.eval (c_a a) p))) = 0 := by
          rw [hq_div, map_mul, map_mul]
          change π_Q t * π_Q (ψ_a a q_div) = 0
          rw [hπ_t, zero_mul]
        rw [map_sub, map_sub, sub_eq_zero] at hsub
        exact hsub.symm
      let alg_left : B₁ →ₐ[P_ring] Q :=
        { φ_B₁_Q with commutes' := fun p => h_eval_eq p }
      let alg_right : R →ₐ[P_ring] Q :=
        { π_Q with commutes' := fun _ => rfl }
      let fwd_Q : TensorProduct P_ring B₁ R →+* Q :=
        (Algebra.TensorProduct.productMap alg_left alg_right).toRingHom
      let incR : R →+* TensorProduct P_ring B₁ R :=
        Algebra.TensorProduct.includeRight.toRingHom
      have hker_incR : I_t ≤ RingHom.ker incR := by
        rw [Ideal.span_le]
        intro x hx
        rw [Set.mem_singleton_iff.mp hx]
        have ht_smul : t = (Polynomial.X - Polynomial.C (c_a a) : P_ring) • (1 : R) := by
          change t = ψ_a a (Polynomial.X - Polynomial.C (c_a a)) * 1
          rw [mul_one]
        change (1 : B₁) ⊗ₜ[P_ring] t = 0
        rw [ht_smul]
        have htm : (1 : B₁) ⊗ₜ[P_ring]
            ((Polynomial.X - Polynomial.C (c_a a) : P_ring) • (1 : R)) =
            ((Polynomial.X - Polynomial.C (c_a a) : P_ring) • (1 : B₁)) ⊗ₜ[P_ring] (1 : R) :=
          (TensorProduct.smul_tmul (Polynomial.X - Polynomial.C (c_a a) : P_ring)
            (1 : B₁) (1 : R)).symm
        rw [htm]
        have hsmul_B₁ :
            ((Polynomial.X - Polynomial.C (c_a a) : P_ring) • (1 : B₁)) = 0 := by
          change Polynomial.eval (c_a a) (Polynomial.X - Polynomial.C (c_a a)) * 1 = 0
          simp
        rw [hsmul_B₁, TensorProduct.zero_tmul]
      let bwd_Q : Q →+* TensorProduct P_ring B₁ R :=
        Ideal.Quotient.lift I_t incR hker_incR
      have hbwd_alg : ∀ p : P_ring, ∀ r : R,
          (1 : B₁) ⊗ₜ[P_ring] (ψ_a a p * r) = (Polynomial.eval (c_a a) p) ⊗ₜ[P_ring] r := by
        intro p r
        have hp_smul : ψ_a a p * r = p • r := rfl
        rw [hp_smul]
        have htm : (1 : B₁) ⊗ₜ[P_ring] (p • r) = (p • (1 : B₁)) ⊗ₜ[P_ring] r :=
          (TensorProduct.smul_tmul p (1 : B₁) r).symm
        have hp_B₁ : (p • (1 : B₁)) = Polynomial.eval (c_a a) p := by
          change Polynomial.eval (c_a a) p * 1 = Polynomial.eval (c_a a) p
          exact mul_one _
        rw [htm, hp_B₁]
      have h_bwd_fwd : ∀ z : TensorProduct P_ring B₁ R, bwd_Q (fwd_Q z) = z := by
        intro z
        refine TensorProduct.inductionOn (motive := fun w => bwd_Q (fwd_Q w) = w) z ?_ ?_
        · intro b r
          change bwd_Q (π_Q (ψ_a a (Polynomial.C b)) * π_Q r) = b ⊗ₜ[P_ring] r
          rw [← map_mul]
          change (1 : B₁) ⊗ₜ[P_ring] (ψ_a a (Polynomial.C b) * r) = b ⊗ₜ[P_ring] r
          rw [hbwd_alg (Polynomial.C b) r, Polynomial.eval_C]
        · intro x y hx hy
          rw [map_add, map_add, hx, hy]
      have h_fwd_bwd : ∀ q : Q, fwd_Q (bwd_Q q) = q := by
        intro q
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective q
        change fwd_Q ((1 : B₁) ⊗ₜ[P_ring] r) = π_Q r
        change alg_left 1 * alg_right r = π_Q r
        rw [map_one, one_mul]
        rfl
      let e_TQ : TensorProduct P_ring B₁ R ≃ₐ[B₁] Q :=
        { toFun := fwd_Q
          invFun := bwd_Q
          left_inv := h_bwd_fwd
          right_inv := h_fwd_bwd
          map_mul' := map_mul fwd_Q
          map_add' := map_add fwd_Q
          commutes' := fun b => by
            change fwd_Q (b ⊗ₜ[P_ring] 1) = φ_B₁_Q b
            change alg_left b * alg_right 1 = φ_B₁_Q b
            rw [map_one, mul_one]
            rfl }
      have hEt_alg_Q : Algebra.Etale B₁ Q := Algebra.Etale.of_equiv e_TQ
      exact RingHom.etale_algebraMap.mpr hEt_alg_Q

    let Z_sch := AlgebraicGeometry.Spec (CommRingCat.of Q)
    let ι_Z : Z_sch ⟶ AlgebraicGeometry.Spec R_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom π_Q)
    let p_Z : Z_sch ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_B₁_Q)
    have hEt_pZ : AlgebraicGeometry.Etale p_Z :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hEt_Q
    let _ : AlgebraicGeometry.Etale p_Z := hEt_pZ

    let ev_aff : R →+* B₁ := (AlgebraicGeometry.Spec.preimage (σ_aff a)).hom
    have hker_ev : I_t ≤ RingHom.ker ev_aff := by
      rw [Ideal.span_le]
      intro x hx
      rw [Set.mem_singleton_iff.mp hx]
      exact hev_zero a
    let ev_Q : Q →+* B₁ := Ideal.Quotient.lift I_t ev_aff hker_ev
    have hev_Q_comp : ev_Q.comp π_Q = ev_aff := Ideal.Quotient.lift_comp_mk I_t ev_aff hker_ev
    let s_Z : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ Z_sch :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_Q)
    have hs_Z_ι : s_Z ≫ ι_Z = σ_aff a := by
      dsimp [s_Z, ι_Z]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hev_Q_comp]
      exact AlgebraicGeometry.Spec.map_preimage (σ_aff a)
    have hs_Z_p : s_Z ≫ p_Z =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B₁)) := by
      have hp_fac : p_Z = ι_Z ≫ (hAff_U a).fromSpec ≫ f_B₁ := by
        dsimp [p_Z, ι_Z, φ_B₁_Q, φ_B₁_R]
        rw [← hSpec_ψC a, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      rw [hp_fac, ← CategoryTheory.Category.assoc, hs_Z_ι,
        ← CategoryTheory.Category.assoc, hσ_aff_fac a, hσ_a_sec a]
    have hEt_sZpZ : AlgebraicGeometry.Etale (s_Z ≫ p_Z) := by
      rw [hs_Z_p]
      infer_instance
    have hEt_sZ : AlgebraicGeometry.Etale s_Z :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale) s_Z p_Z
        hEt_pZ hEt_sZpZ
    let _ : AlgebraicGeometry.Etale s_Z := hEt_sZ

    have hOpen_sZ : IsOpen (Set.range s_Z.base) := s_Z.isOpenMap.isOpen_range
    let C_Z : Set ↥Z_sch := (Set.range s_Z.base)ᶜ
    have hCl_CZ : IsClosed C_Z := hOpen_sZ.isClosed_compl

    have hClEmb_ιZ : Topology.IsClosedEmbedding ι_Z.base := by
      have hbase_eq : (ι_Z.base : ↥Z_sch → ↥(AlgebraicGeometry.Spec R_cat)) =
          PrimeSpectrum.comap π_Q := by
        ext q
        exact AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom π_Q) q
      rw [hbase_eq]
      exact PrimeSpectrum.isClosedEmbedding_comap_of_surjective Q π_Q Ideal.Quotient.mk_surjective

    let B_open : Set ↥(AlgebraicGeometry.Spec R_cat) :=
      (PrimeSpectrum.basicOpen t : Set (PrimeSpectrum R))

    have hRange_ιZ :
        Set.range (ι_Z.base : ↥Z_sch → ↥(AlgebraicGeometry.Spec R_cat)) = B_openᶜ := by
      ext p
      constructor
      · rintro ⟨q, rfl⟩ hbasic
        have hq_eq : ι_Z.base q = PrimeSpectrum.comap π_Q q :=
          AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom π_Q) q
        have ht_notin : t ∉ (PrimeSpectrum.comap π_Q q).asIdeal := hq_eq ▸ hbasic
        apply ht_notin
        change π_Q t ∈ q.asIdeal
        rw [hπ_t]
        exact q.asIdeal.zero_mem
      · intro hp_not
        have ht_mem : t ∈ (p : PrimeSpectrum R).asIdeal := by
          by_contra ht_notin
          exact hp_not ht_notin
        have hI_le : I_t ≤ (p : PrimeSpectrum R).asIdeal :=
          Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ht_mem)
        let J : Ideal Q := Ideal.map π_Q (p : PrimeSpectrum R).asIdeal
        have hcomap_J : Ideal.comap π_Q J = (p : PrimeSpectrum R).asIdeal := by
          apply le_antisymm
          · intro r hr
            obtain ⟨r', hr', hmk⟩ :=
              (Ideal.mem_map_iff_of_surjective π_Q Ideal.Quotient.mk_surjective).mp hr
            have hdiff : r - r' ∈ I_t := Ideal.Quotient.eq.mp hmk.symm
            have hsub_mem : r - r' ∈ (p : PrimeSpectrum R).asIdeal := hI_le hdiff
            have hsum := (p : PrimeSpectrum R).asIdeal.add_mem hsub_mem hr'
            rwa [sub_add_cancel] at hsum
          · exact Ideal.le_comap_map
        have hJ_prime : J.IsPrime := by
          refine ⟨?_, ?_⟩
          · intro htop
            have h1 : (1 : Q) ∈ J := by rw [htop]; trivial
            have h1_p : (1 : R) ∈ (p : PrimeSpectrum R).asIdeal := by
              rw [← hcomap_J]
              exact h1
            exact (p : PrimeSpectrum R).isPrime.ne_top
              (Ideal.eq_top_of_isUnit_mem _ h1_p isUnit_one)
          · intro x y hxy
            obtain ⟨rx, rfl⟩ := Ideal.Quotient.mk_surjective x
            obtain ⟨ry, rfl⟩ := Ideal.Quotient.mk_surjective y
            have hmul_p : rx * ry ∈ (p : PrimeSpectrum R).asIdeal := by
              rw [← hcomap_J]
              exact hxy
            rcases (p : PrimeSpectrum R).isPrime.mem_or_mem hmul_p with hrx | hry
            · exact Or.inl (Ideal.mem_map_of_mem π_Q hrx)
            · exact Or.inr (Ideal.mem_map_of_mem π_Q hry)
        let q_pt : ↥Z_sch := (⟨J, hJ_prime⟩ : PrimeSpectrum Q)
        refine ⟨q_pt, ?_⟩
        rw [AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom π_Q) q_pt]
        exact PrimeSpectrum.ext hcomap_J

    let O_spec : Set ↥(AlgebraicGeometry.Spec R_cat) := (ι_Z.base '' C_Z)ᶜ
    have hO_spec_open : IsOpen O_spec := (hClEmb_ιZ.isClosedMap C_Z hCl_CZ).isOpen_compl
    have hO_spec_eq : O_spec = B_open ∪ Set.range (σ_aff a).base := by
      ext p
      constructor
      · intro hp
        by_cases hbasic : p ∈ B_open
        · exact Or.inl hbasic
        · right
          have hp_range : p ∈ Set.range (ι_Z.base : ↥Z_sch → ↥(AlgebraicGeometry.Spec R_cat)) := by
            rw [hRange_ιZ]
            exact hbasic
          rcases hp_range with ⟨q, rfl⟩
          have hq_not_CZ : q ∉ C_Z := fun hq => hp ⟨q, hq, rfl⟩
          have hq_sZ : q ∈ Set.range s_Z.base := not_not.mp hq_not_CZ
          rcases hq_sZ with ⟨b, rfl⟩
          refine ⟨b, ?_⟩
          rw [← hs_Z_ι]
          rfl
      · rintro (hbasic | ⟨b, rfl⟩)
        · rintro ⟨q, _, rfl⟩
          have hmem_range : ι_Z.base q ∈ Set.range (ι_Z.base : ↥Z_sch → _) := ⟨q, rfl⟩
          rw [hRange_ιZ] at hmem_range
          exact hmem_range hbasic
        · rintro ⟨q, hq_CZ, hq_eq⟩
          have hb_eq : ι_Z.base (s_Z.base b) = (σ_aff a).base b := by
            rw [← hs_Z_ι]
            rfl
          have hq_sZb : q = s_Z.base b := hClEmb_ιZ.injective (hq_eq.trans hb_eq.symm)
          exact hq_CZ ⟨b, hq_sZb.symm⟩

    have hDisj_spec : Disjoint B_open (Set.range (σ_aff a).base) := by
      rw [Set.disjoint_left]
      rintro p hbasic ⟨b, rfl⟩
      have hmem_Z : (σ_aff a).base b ∈ Set.range (ι_Z.base : ↥Z_sch → _) := by
        refine ⟨s_Z.base b, ?_⟩
        rw [← hs_Z_ι]
        rfl
      rw [hRange_ιZ] at hmem_Z
      exact hmem_Z hbasic

    let U_in : Y_B₁.Opens :=
      ⟨(hAff_U a).fromSpec.base '' O_spec,
        (hAff_U a).fromSpec.isOpenEmbedding.isOpenMap O_spec hO_spec_open⟩
    have hle_in : U_in ≤ U_aff a := by
      rintro _ ⟨p, _, rfl⟩
      have hmem_range : (hAff_U a).fromSpec.base p ∈ Set.range (hAff_U a).fromSpec.base :=
        ⟨p, rfl⟩
      rw [(hAff_U a).range_fromSpec] at hmem_range
      exact hmem_range
    have hImage_basic :
        (hAff_U a).fromSpec.base '' B_open = (Y_B₁.basicOpen t : Set ↥Y_B₁) := by
      have hpre : (hAff_U a).fromSpec.base ⁻¹' (Y_B₁.basicOpen t : Set ↥Y_B₁) = B_open :=
        congrArg SetLike.coe ((hAff_U a).fromSpec_preimage_basicOpen t)
      rw [← hpre, Set.image_preimage_eq_inter_range, (hAff_U a).range_fromSpec]
      exact Set.inter_eq_self_of_subset_left (Y_B₁.basicOpen_le t)
    have hImage_σ :
        (hAff_U a).fromSpec.base '' Set.range (σ_aff a).base = Set.range (σ_a a).base := by
      rw [← Set.range_comp]
      have hcomp_base : (hAff_U a).fromSpec.base ∘ (σ_aff a).base = (σ_a a).base := by
        ext b
        rw [← hσ_aff_fac a]
        rfl
      rw [hcomp_base]
    have hU_in_carrier :
        (U_in : Set ↥Y_B₁) = (Y_B₁.basicOpen t : Set ↥Y_B₁) ∪ Set.range (σ_a a).base := by
      change (hAff_U a).fromSpec.base '' O_spec = _
      rw [hO_spec_eq, Set.image_union, hImage_basic, hImage_σ]
    have hcov_a : U_in ⊔ U_out = ⊤ := by
      ext y
      change y ∈ (U_in : Set ↥Y_B₁) ∪ (Set.range (σ_a a).base)ᶜ ↔ True
      rw [hU_in_carrier, Set.union_assoc, Set.union_compl_self, Set.union_univ]
      simp
    have hDisj_Y : Disjoint (Y_B₁.basicOpen t : Set ↥Y_B₁) (Set.range (σ_a a).base) := by
      rw [← hImage_basic, ← hImage_σ, Set.disjoint_left]
      rintro _ ⟨p₁, hp₁, rfl⟩ ⟨p₂, hp₂, heq⟩
      have hp_eq : p₁ = p₂ := (hAff_U a).fromSpec.isOpenEmbedding.injective heq.symm
      exact Set.disjoint_left.mp hDisj_spec hp₁ (hp_eq ▸ hp₂)
    have heq_ov : U_in ⊓ U_out = Y_B₁.basicOpen t := by
      ext y
      change y ∈ (U_in : Set ↥Y_B₁) ∩ (Set.range (σ_a a).base)ᶜ ↔ y ∈ (Y_B₁.basicOpen t : Set ↥Y_B₁)
      rw [hU_in_carrier, Set.union_inter_distrib_right, Set.inter_compl_self, Set.union_empty]
      exact ⟨fun hy => hy.1, fun hy => ⟨hy, Set.disjoint_left.mp hDisj_Y hy⟩⟩
    have hle_ov_basic : U_in ⊓ U_out ≤ Y_B₁.basicOpen t := le_of_eq heq_ov
    have hUnit_basic :
        IsUnit ((Y_B₁.presheaf.map
          (CategoryTheory.homOfLE (Y_B₁.basicOpen_le t)).op).hom t) :=
      Y_B₁.toRingedSpace.isUnit_res_basicOpen t
    have hRes_eq :
        (Y_B₁.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U_in ⊓ U_out ≤ U_in)).op).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE hle_in).op).hom t) =
        (Y_B₁.presheaf.map (CategoryTheory.homOfLE hle_ov_basic).op).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE (Y_B₁.basicOpen_le t)).op).hom t) := by
      change (Y_B₁.presheaf.map (CategoryTheory.homOfLE hle_in).op ≫
          Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom t =
        (Y_B₁.presheaf.map (CategoryTheory.homOfLE (Y_B₁.basicOpen_le t)).op ≫
          Y_B₁.presheaf.map (CategoryTheory.homOfLE hle_ov_basic).op).hom t
      rw [← Y_B₁.presheaf.map_comp, ← Y_B₁.presheaf.map_comp]
      congr 3
    have hUnit_ov :
        IsUnit ((Y_B₁.presheaf.map
          (CategoryTheory.homOfLE (inf_le_left : U_in ⊓ U_out ≤ U_in)).op).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE hle_in).op).hom t)) := by
      rw [hRes_eq]
      exact hUnit_basic.map _
    exact ⟨U_in, U_out, hle_in, hUnit_ov.unit, hcov_a, rfl, hUnit_ov.unit_spec.symm⟩

  choose U_in U_out hle_in u_ov hcov_two hU_out_eq hu_ov_eq using hTwoChart

  
  have hCompact_YB₁ : CompactSpace ↥Y_B₁ :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace f_B₁
  let _ : CompactSpace ↥Y_B₁ := hCompact_YB₁
  have hIrred_Yη : IrreducibleSpace ↥Y_η :=
    AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_η
  let y_base : ↥Y_B₁ := ι_η_B₁.base (Classical.choice hIrred_Yη.toNonempty)

  let O_cell : ↥Y_B₁ → Fin m_sec → Y_B₁.Opens :=
    fun y a => if y ∈ U_in a then U_in a else U_out a
  have hy_cell : ∀ (y : ↥Y_B₁) (a : Fin m_sec),
      y ∈ O_cell y a ∧ (O_cell y a = U_in a ∨ O_cell y a = U_out a) := by
    intro y a
    dsimp [O_cell]
    split_ifs with hy
    · exact ⟨hy, Or.inl rfl⟩
    · have hy_top : y ∈ (U_in a ⊔ U_out a : Y_B₁.Opens) := by
        rw [hcov_two a]
        trivial
      rcases hy_top with hy_in | hy_out
      · exact False.elim (hy hy_in)
      · exact ⟨hy_out, Or.inr rfl⟩
  let M_cell : ↥Y_B₁ → Y_B₁.Opens :=
    fun y => ⟨⋂ a : Fin m_sec, (O_cell y a : Set ↥Y_B₁),
      isOpen_iInter_of_finite fun a => (O_cell y a).isOpen⟩
  have hW_raw_ex : ∀ y : ↥Y_B₁,
      ∃ W : Y_B₁.Opens, AlgebraicGeometry.IsAffineOpen W ∧ y ∈ W ∧ W ≤ M_cell y := by
    intro y
    have hy_M : y ∈ M_cell y := Set.mem_iInter.mpr fun a => (hy_cell y a).1
    exact AlgebraicGeometry.exists_isAffineOpen_mem_and_subset hy_M
  choose W_raw hAff_raw hy_raw hle_raw using hW_raw_ex

  obtain ⟨S₀, hS₀_cov⟩ :=
    isCompact_univ.elim_finite_subcover (fun y : ↥Y_B₁ => (W_raw y : Set ↥Y_B₁))
      (fun y => (W_raw y).isOpen)
      (fun y _ => Set.mem_iUnion.mpr ⟨y, hy_raw y⟩)
  let S : Finset ↥Y_B₁ := insert y_base S₀
  let N_cov : ℕ := S.card
  have hN_cov : 1 ≤ N_cov := Finset.Nonempty.card_pos (Finset.insert_nonempty y_base S₀)
  let e_S : Fin N_cov ≃ ↥S := (Fintype.equivFinOfCardEq (Fintype.card_coe S)).symm
  let W₁ : Fin N_cov → Y_B₁.Opens := fun α => W_raw (e_S α).1

  have hW₁_top : (⨆ α : Fin N_cov, W₁ α) = ⊤ := by
    apply eq_top_iff.mpr
    intro y hy_univ
    have hy_cov := hS₀_cov hy_univ
    simp only [Set.mem_iUnion] at hy_cov
    rcases hy_cov with ⟨z, hz_S₀, hy_z⟩
    have hz_S : z ∈ S := Finset.mem_insert_of_mem hz_S₀
    let α : Fin N_cov := e_S.symm ⟨z, hz_S⟩
    have hα_eq : (e_S α).1 = z := by simp [α]
    refine TopologicalSpace.Opens.mem_iSup.mpr ⟨α, ?_⟩
    dsimp [W₁]
    rwa [hα_eq]

  have hW₁_aff : ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (W₁ α) :=
    fun α => hAff_raw (e_S α).1

  have hW₁_dich : ∀ (a : Fin m_sec) (α : Fin N_cov), W₁ α ≤ U_in a ∨ W₁ α ≤ U_out a := by
    intro a α
    have hle_cell : W₁ α ≤ O_cell (e_S α).1 a := by
      intro x hx
      have hx_M := hle_raw (e_S α).1 hx
      exact Set.mem_iInter.mp hx_M a
    rcases (hy_cell (e_S α).1 a).2 with heq_in | heq_out
    · exact Or.inl (heq_in ▸ hle_cell)
    · exact Or.inr (heq_out ▸ hle_cell)

  have hW₁_out_of_not : ∀ {a : Fin m_sec} {α : Fin N_cov}, ¬ W₁ α ≤ U_in a → W₁ α ≤ U_out a := by
    intro a α hn
    rcases hW₁_dich a α with h1 | h2
    · exact False.elim (hn h1)
    · exact h2

  let g_in : ∀ a : Fin m_sec, ↑(Y_B₁.presheaf.obj (Opposite.op (U_in a))) :=
    fun a => (Y_B₁.presheaf.map (CategoryTheory.homOfLE (hle_in a)).op).hom
      (ψ_a a (Polynomial.X - Polynomial.C (c_a a)))

  let resYB : ∀ {U V : Y_B₁.Opens}, (U ≤ V) →
      ↑(Y_B₁.presheaf.obj (Opposite.op V)) →+* ↑(Y_B₁.presheaf.obj (Opposite.op U)) :=
    fun hle => (Y_B₁.presheaf.map (CategoryTheory.homOfLE hle).op).hom

  have hresYB_comp : ∀ {U V W : Y_B₁.Opens} (hUV : U ≤ V) (hVW : V ≤ W)
      (z : ↑(Y_B₁.presheaf.obj (Opposite.op W))),
      resYB hUV (resYB hVW z) = resYB (le_trans hUV hVW) z := by
    intro U V W hUV hVW z
    change (Y_B₁.presheaf.map (CategoryTheory.homOfLE hVW).op ≫
      Y_B₁.presheaf.map (CategoryTheory.homOfLE hUV).op).hom z =
      (Y_B₁.presheaf.map (CategoryTheory.homOfLE (le_trans hUV hVW)).op).hom z
    rw [← Y_B₁.presheaf.map_comp]
    rfl

  let h_sec : Fin m_sec → ∀ α : Fin N_cov, ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α))) :=
    fun a α => if hα : W₁ α ≤ U_in a then resYB hα (g_in a) else 1

  let r_sec : Fin m_sec → ∀ α β : Fin N_cov,
      Units ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α ⊓ W₁ β))) :=
    fun a α β =>
      if hα : W₁ α ≤ U_in a then
        if hβ : W₁ β ≤ U_in a then 1
        else
          Units.map (resYB
            (le_inf (le_trans inf_le_left hα)
              (le_trans inf_le_right (hW₁_out_of_not hβ)))).toMonoidHom (u_ov a)
      else
        if hβ : W₁ β ≤ U_in a then
          (Units.map (resYB
            (le_inf (le_trans inf_le_right hβ)
              (le_trans inf_le_left (hW₁_out_of_not hα)))).toMonoidHom (u_ov a))⁻¹
        else 1

  have hr_diag : ∀ (a : Fin m_sec) (α : Fin N_cov), (r_sec a α α).1 = 1 := by
    intro a α
    dsimp only [r_sec]
    by_cases hα : W₁ α ≤ U_in a <;> simp [hα]

  have hr_cocycle : ∀ (a : Fin m_sec) (α β γ : Fin N_cov),
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β)).op).hom (r_sec a α β).1 *
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.2, hx.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ)).op).hom (r_sec a β γ).1 =
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ)).op).hom (r_sec a α γ).1 := by
    intro a α β γ
    have hle_12 : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β := fun _ hx => ⟨hx.1.1, hx.1.2⟩
    have hle_23 : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ := fun _ hx => ⟨hx.1.2, hx.2⟩
    have hle_13 : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ := fun _ hx => ⟨hx.1.1, hx.2⟩
    change resYB hle_12 (r_sec a α β).1 * resYB hle_23 (r_sec a β γ).1 =
      resYB hle_13 (r_sec a α γ).1
    have hinv_res : ∀ {U V : Y_B₁.Opens} (hle : U ≤ V)
        (u : Units ↑(Y_B₁.presheaf.obj (Opposite.op V))),
        resYB hle (u⁻¹).1 = ((Units.map (resYB hle).toMonoidHom u)⁻¹).1 :=
      fun _ _ => rfl
    dsimp only [r_sec]
    by_cases hα : W₁ α ≤ U_in a <;>
      by_cases hβ : W₁ β ≤ U_in a <;>
      by_cases hγ : W₁ γ ≤ U_in a
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one, mul_one]
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one, one_mul, Units.coe_map]
      exact (hresYB_comp _ _ (u_ov a).1).trans (hresYB_comp _ _ (u_ov a).1).symm
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one]
      rw [hinv_res]
      have hle_t : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ U_in a ⊓ U_out a :=
        le_inf (le_trans (le_trans inf_le_left inf_le_left) hα)
          (le_trans (le_trans inf_le_left inf_le_right) (hW₁_out_of_not hβ))
      let u_t : Units ↑(Y_B₁.presheaf.obj (Opposite.op ((W₁ α ⊓ W₁ β) ⊓ W₁ γ))) :=
        Units.map (resYB hle_t).toMonoidHom (u_ov a)
      have hL : resYB hle_12
          (Units.map (resYB
            (le_inf (le_trans inf_le_left hα)
              (le_trans inf_le_right (hW₁_out_of_not hβ)))).toMonoidHom (u_ov a)).1 = u_t.1 :=
        hresYB_comp _ _ (u_ov a).1
      have hR : ((Units.map (resYB hle_23).toMonoidHom
          (Units.map (resYB
            (le_inf (le_trans inf_le_right hγ)
              (le_trans inf_le_left (hW₁_out_of_not hβ)))).toMonoidHom (u_ov a)))⁻¹).1 =
          (u_t⁻¹).1 := by
        congr 2
        ext
        simp only [Units.coe_map]
        exact hresYB_comp _ _ (u_ov a).1
      rw [hL, hR, Units.mul_inv]
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one, mul_one, Units.coe_map]
      exact (hresYB_comp _ _ (u_ov a).1).trans (hresYB_comp _ _ (u_ov a).1).symm
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one, mul_one]
      rw [hinv_res, hinv_res]
      congr 2
      ext
      simp only [Units.coe_map]
      exact (hresYB_comp _ _ (u_ov a).1).trans (hresYB_comp _ _ (u_ov a).1).symm
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one]
      rw [hinv_res]
      have hle_t : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ U_in a ⊓ U_out a :=
        le_inf (le_trans (le_trans inf_le_left inf_le_right) hβ)
          (le_trans (le_trans inf_le_left inf_le_left) (hW₁_out_of_not hα))
      let u_t : Units ↑(Y_B₁.presheaf.obj (Opposite.op ((W₁ α ⊓ W₁ β) ⊓ W₁ γ))) :=
        Units.map (resYB hle_t).toMonoidHom (u_ov a)
      have hL : ((Units.map (resYB hle_12).toMonoidHom
          (Units.map (resYB
            (le_inf (le_trans inf_le_right hβ)
              (le_trans inf_le_left (hW₁_out_of_not hα)))).toMonoidHom (u_ov a)))⁻¹).1 =
          (u_t⁻¹).1 := by
        congr 2
        ext
        simp only [Units.coe_map]
        exact hresYB_comp _ _ (u_ov a).1
      have hR : resYB hle_23
          (Units.map (resYB
            (le_inf (le_trans inf_le_left hβ)
              (le_trans inf_le_right (hW₁_out_of_not hγ)))).toMonoidHom (u_ov a)).1 = u_t.1 :=
        hresYB_comp _ _ (u_ov a).1
      rw [hL, hR, Units.inv_mul]
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one, one_mul]
      rw [hinv_res, hinv_res]
      congr 2
      ext
      simp only [Units.coe_map]
      exact (hresYB_comp _ _ (u_ov a).1).trans (hresYB_comp _ _ (u_ov a).1).symm
    · simp only [hα, hβ, hγ, ↓reduceDIte, Units.val_one, map_one, mul_one]

  have hr_trans : ∀ (a : Fin m_sec) (α β : Fin N_cov),
      (r_sec a α β).1 *
        (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h_sec a β) =
      (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h_sec a α) := by
    intro a α β
    have hg_ov : resYB (inf_le_left : U_in a ⊓ U_out a ≤ U_in a) (g_in a) = (u_ov a).1 :=
      hu_ov_eq a
    change (r_sec a α β).1 * resYB inf_le_right (h_sec a β) = resYB inf_le_left (h_sec a α)
    dsimp only [r_sec, h_sec]
    by_cases hα : W₁ α ≤ U_in a <;> by_cases hβ : W₁ β ≤ U_in a
    · simp only [hα, hβ, ↓reduceDIte, Units.val_one, one_mul]
      exact (hresYB_comp _ _ (g_in a)).trans (hresYB_comp _ _ (g_in a)).symm
    · simp only [hα, hβ, ↓reduceDIte, map_one, mul_one, Units.coe_map]
      rw [← hg_ov]
      exact (hresYB_comp _ _ (g_in a)).trans (hresYB_comp _ _ (g_in a)).symm
    · simp only [hα, hβ, ↓reduceDIte, map_one]
      have hle₂ : W₁ α ⊓ W₁ β ≤ U_in a ⊓ U_out a :=
        le_inf (le_trans inf_le_right hβ) (le_trans inf_le_left (hW₁_out_of_not hα))
      let u_ab := Units.map (resYB hle₂).toMonoidHom (u_ov a)
      have hR : resYB inf_le_right (resYB hβ (g_in a)) = u_ab.1 := by
        rw [hresYB_comp]
        have hcomp_eq : resYB (le_trans inf_le_right hβ) (g_in a) =
            resYB hle₂ (resYB (inf_le_left : U_in a ⊓ U_out a ≤ U_in a) (g_in a)) :=
          (hresYB_comp hle₂ inf_le_left (g_in a)).symm
        rw [hcomp_eq, hg_ov]
        rfl
      rw [hR]
      exact Units.inv_mul u_ab
    · simp only [hα, hβ, ↓reduceDIte, Units.val_one, map_one, mul_one]

  
  let s_B₁_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω)

  have hq_B₁ : ∀ a : Fin m_sec, q_η a ≫ ι_η_B₁ = s_B₁_Ω ≫ σ_a a := by
    intro a
    apply hPb_q₁.hom_ext
    · rw [hq_mid a, CategoryTheory.Category.assoc, hσ_a_q₁ a,
        ← CategoryTheory.Category.assoc]
      congr 1
      dsimp [s_B₁_Ω, g_B₁]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι_comp]
    · rw [CategoryTheory.Category.assoc, hPb_η.w, ← CategoryTheory.Category.assoc,
        hq_sec a, CategoryTheory.Category.id_comp,
        CategoryTheory.Category.assoc, hσ_a_sec a, CategoryTheory.Category.comp_id]

  have hPre_eq : ∀ a : Fin m_sec,
      ι_η_B₁.base ⁻¹' Set.range (σ_a a).base = {(x_η a).1} := by
    intro a
    have hOuter : CategoryTheory.IsPullback s_B₁_Ω (q_η a ≫ f_η) (σ_a a ≫ f_B₁) s_B₁_Ω := by
      rw [hq_sec a, hσ_a_sec a]
      exact CategoryTheory.IsPullback.of_vert_isIso
        ⟨by rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]⟩
    have hSecPb : CategoryTheory.IsPullback s_B₁_Ω (q_η a) (σ_a a) ι_η_B₁ :=
      CategoryTheory.IsPullback.of_bot hOuter (hq_B₁ a).symm hPb_η
    ext y
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · rintro ⟨b, hb_eq⟩
      obtain ⟨z, _, hz_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback b y hb_eq
      have hy_range : y ∈ Set.range (q_η a).base := by
        refine ⟨hSecPb.isoPullback.inv.base z, ?_⟩
        change (hSecPb.isoPullback.inv ≫ q_η a).base z = y
        rw [hSecPb.isoPullback_inv_snd]
        exact hz_snd
      rwa [hq_range a, Set.mem_singleton_iff] at hy_range
    · rintro rfl
      have hx_range : (x_η a).1 ∈ Set.range (q_η a).base := by
        rw [hq_range a]
        exact Set.mem_singleton _
      rcases hx_range with ⟨pt_Ω, hpt_Ω⟩
      refine ⟨s_B₁_Ω.base pt_Ω, ?_⟩
      rw [← hpt_Ω]
      change (s_B₁_Ω ≫ σ_a a).base pt_Ω = (q_η a ≫ ι_η_B₁).base pt_Ω
      rw [hq_B₁ a]

  have hAffHom_sΩ : AlgebraicGeometry.IsAffineHom s_B₁_Ω :=
    AlgebraicGeometry.isAffineHom_of_isAffine _
  have hAffHom_ιη : AlgebraicGeometry.IsAffineHom ι_η_B₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η.flip hAffHom_sΩ
  let _ : AlgebraicGeometry.IsAffineHom ι_η_B₁ := hAffHom_ιη

  refine ⟨N_cov, hN_cov, W₁, h_sec, r_sec,
    ⟨hW₁_top, hW₁_aff⟩, ⟨hr_diag, hr_cocycle, hr_trans⟩, ?_⟩
  intro V a α x hx
  refine ⟨?_, ?_⟩
  · 
    rintro rfl
    have hx_in_σ : ι_η_B₁.base (x_η a).1 ∈ Set.range (σ_a a).base := by
      have hm : (x_η a).1 ∈ ι_η_B₁.base ⁻¹' Set.range (σ_a a).base := by
        rw [hPre_eq a]
        exact Set.mem_singleton _
      exact hm
    have hle_W_in : W₁ α ≤ U_in a := by
      by_contra hn_in
      have hle_out : W₁ α ≤ U_out a := hW₁_out_of_not hn_in
      have hx_out : ι_η_B₁.base (x_η a).1 ∈ U_out a := hle_out hx
      change ι_η_B₁.base (x_η a).1 ∈ (U_out a : Set ↥Y_B₁) at hx_out
      rw [hU_out_eq a] at hx_out
      exact hx_out hx_in_σ
    have hh_eq : h_sec a α = resYB (le_trans hle_W_in (hle_in a))
        (ψ_a a (Polynomial.X - Polynomial.C (c_a a))) := by
      dsimp [h_sec]
      simp only [hle_W_in, ↓reduceDIte]
      exact hresYB_comp hle_W_in (hle_in a) _

    let V_aff : Y_η.Opens := (TopologicalSpace.Opens.map ι_η_B₁.base).obj (U_aff a)
    have hle_V_aff : V α ≤ V_aff := fun _ hy => hle_in a (hle_W_in hy)
    have hx₀_Vaff : (x_η a).1 ∈ V_aff := hle_V_aff hx
    let t : ↑(Y_B₁.presheaf.obj (Opposite.op (U_aff a))) :=
      ψ_a a (Polynomial.X - Polynomial.C (c_a a))
    let t_Ω : ↑(Y_η.presheaf.obj (Opposite.op V_aff)) := (ι_η_B₁.app (U_aff a)).hom t

    have hGerm_eq :
        (Y_η.presheaf.germ (V α) (x_η a).1 hx).hom ((ι_η_B₁.app (W₁ α)).hom (h_sec a α)) =
          (Y_η.presheaf.germ V_aff (x_η a).1 hx₀_Vaff).hom t_Ω := by
      rw [hh_eq]
      have hApp := hAppRes ι_η_B₁ (le_trans hle_W_in (hle_in a)) hle_V_aff t
      change (Y_η.presheaf.germ (V α) (x_η a).1 hx).hom
        ((ι_η_B₁.app (W₁ α)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE (le_trans hle_W_in (hle_in a))).op).hom t)) =
        _
      rw [← hApp]
      exact TopCat.Presheaf.germ_res_apply Y_η.presheaf (CategoryTheory.homOfLE hle_V_aff)
        (x_η a).1 hx t_Ω
    rw [hGerm_eq]

    
    have hAff_V : AlgebraicGeometry.IsAffineOpen V_aff := (hAff_U a).preimage ι_η_B₁
    let R : Type u := ↑(Y_B₁.presheaf.obj (Opposite.op (U_aff a)))
    let D : Type u := ↑(Y_η.presheaf.obj (Opposite.op V_aff))
    let φ_RD : R →+* D := (ι_η_B₁.app (U_aff a)).hom
    let φ_ΩD : Ω →+* D := (AlgebraicGeometry.Spec.preimage (hAff_V.fromSpec ≫ f_η)).hom
    have hw_η_eq :
        AlgebraicGeometry.Spec.map (ι_η_B₁.appLE (U_aff a) V_aff le_rfl) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD) := by
      rw [AlgebraicGeometry.Scheme.Hom.appLE_eq_app]
      rfl
    have hPb_open_η : CategoryTheory.IsPullback
        hAff_V.fromSpec
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD))
        ι_η_B₁
        (hAff_U a).fromSpec := by
      rw [← hw_η_eq]
      exact hOpenPb ι_η_B₁ (hAff_U a) hAff_V
    have hPb_η_aff : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ΩD))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ_a a).comp Polynomial.C)))
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω)) := by
      have hSpec_ΩD : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_ΩD) = hAff_V.fromSpec ≫ f_η :=
        AlgebraicGeometry.Spec.map_preimage _
      rw [hSpec_ΩD, hSpec_ψC a]
      exact hPb_open_η.flip.paste_vert hPb_η
    obtain ⟨ψ_Ω, hψ_Ω_et, hψ_Ω_C, hψ_Ω_map⟩ :=
      hEtalePolyBC ι_B₁_Ω φ_RD φ_ΩD (ψ_a a) (hψ_a_et a) hPb_η_aff
    have ht_Ω_eq : ψ_Ω (Polynomial.X - Polynomial.C (ι_B₁_Ω (c_a a))) = t_Ω := by
      have hmap_pol : (Polynomial.X - Polynomial.C (c_a a)).map ι_B₁_Ω =
          Polynomial.X - Polynomial.C (ι_B₁_Ω (c_a a)) := by
        rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
      rw [← hmap_pol]
      exact hψ_Ω_map (Polynomial.X - Polynomial.C (c_a a))

    
    have hq_V_range : Set.range (q_η a).base ⊆ Set.range hAff_V.fromSpec.base := by
      rw [hq_range a, hAff_V.range_fromSpec, Set.singleton_subset_iff]
      exact hx₀_Vaff
    let s_Ω := AlgebraicGeometry.IsOpenImmersion.lift hAff_V.fromSpec (q_η a) hq_V_range
    have hs_Ω_fac : s_Ω ≫ hAff_V.fromSpec = q_η a :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac hAff_V.fromSpec (q_η a) hq_V_range
    let ev_Ω : D →+* Ω := (AlgebraicGeometry.Spec.preimage s_Ω).hom
    have hSpec_evΩ : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ev_Ω) = s_Ω :=
      AlgebraicGeometry.Spec.map_preimage s_Ω
    have hs_Ω_RD :
        s_Ω ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RD) = s_B₁_Ω ≫ σ_aff a := by
      apply (cancel_mono (hAff_U a).fromSpec).mp
      rw [CategoryTheory.Category.assoc, ← hPb_open_η.w, ← CategoryTheory.Category.assoc,
        hs_Ω_fac, hq_B₁ a, CategoryTheory.Category.assoc, hσ_aff_fac a]
    have hev_Ω_RD : ev_Ω.comp φ_RD = ι_B₁_Ω.comp (AlgebraicGeometry.Spec.preimage (σ_aff a)).hom := by
      have hSpec_evσ :
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (AlgebraicGeometry.Spec.preimage (σ_aff a)).hom) = σ_aff a :=
        AlgebraicGeometry.Spec.map_preimage (σ_aff a)
      have hEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_Ω.comp φ_RD)) =
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (ι_B₁_Ω.comp (AlgebraicGeometry.Spec.preimage (σ_aff a)).hom)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_evΩ, hs_Ω_RD,
          CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_evσ]
      exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hEq)
    have hev_Ω_t : ev_Ω t_Ω = 0 := by
      change (ev_Ω.comp φ_RD) t = 0
      rw [hev_Ω_RD]
      change ι_B₁_Ω ((AlgebraicGeometry.Spec.preimage (σ_aff a)).hom t) = 0
      rw [hev_zero a, map_zero]
    have hev_Ω_C : ev_Ω.comp (ψ_Ω.comp Polynomial.C) = RingHom.id Ω := by
      have hSpec_ψΩC :
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Ω.comp Polynomial.C)) =
            hAff_V.fromSpec ≫ f_η := by
        rw [hψ_Ω_C]
        exact AlgebraicGeometry.Spec.map_preimage _
      have hEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_Ω.comp (ψ_Ω.comp Polynomial.C))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (RingHom.id Ω)) := by
        rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_ψΩC,
          hSpec_evΩ, ← CategoryTheory.Category.assoc,
          hs_Ω_fac, hq_sec a, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hEq)
    have hev_Ω_eval : ev_Ω.comp ψ_Ω = Polynomial.evalRingHom (ι_B₁_Ω (c_a a)) := by
      apply Polynomial.ringHom_ext'
      · ext ω
        change (ev_Ω.comp (ψ_Ω.comp Polynomial.C)) ω = Polynomial.eval (ι_B₁_Ω (c_a a)) (Polynomial.C ω)
        rw [hev_Ω_C, Polynomial.eval_C]
        rfl
      · change ev_Ω (ψ_Ω Polynomial.X) = Polynomial.eval (ι_B₁_Ω (c_a a)) Polynomial.X
        rw [Polynomial.eval_X]
        have hsub0 : ev_Ω (ψ_Ω (Polynomial.X - Polynomial.C (ι_B₁_Ω (c_a a)))) = 0 := by
          rw [ht_Ω_eq]
          exact hev_Ω_t
        rw [map_sub, map_sub, sub_eq_zero] at hsub0
        have hc_val : ev_Ω (ψ_Ω (Polynomial.C (ι_B₁_Ω (c_a a)))) = ι_B₁_Ω (c_a a) :=
          RingHom.congr_fun hev_Ω_C (ι_B₁_Ω (c_a a))
        exact hsub0.trans hc_val

    let pt_x : ↥V_aff := ⟨(x_η a).1, hx₀_Vaff⟩
    let m_pt : PrimeSpectrum D := hAff_V.primeIdealOf pt_x
    let m_x : Ideal D := m_pt.asIdeal
    have _ : m_x.IsPrime := m_pt.isPrime
    have hm_x_ker : m_x = RingHom.ker ev_Ω := by
      let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
        (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω)
      have hfrom_pt : hAff_V.fromSpec.base (s_Ω.base pt_Ω) = (x_η a).1 := by
        have hmem_q : (s_Ω ≫ hAff_V.fromSpec).base pt_Ω ∈ Set.range (q_η a).base := by
          rw [hs_Ω_fac]
          exact ⟨pt_Ω, rfl⟩
        rw [hq_range a, Set.mem_singleton_iff] at hmem_q
        exact hmem_q
      have hfrom_m : hAff_V.fromSpec.base m_pt = (x_η a).1 :=
        hAff_V.fromSpec_primeIdealOf pt_x
      have hm_eq_s : m_pt = s_Ω.base pt_Ω :=
        hAff_V.fromSpec.isOpenEmbedding.injective (hfrom_m.trans hfrom_pt.symm)
      have hs_eq_comap : s_Ω.base pt_Ω = PrimeSpectrum.comap ev_Ω pt_Ω := by
        rw [← hSpec_evΩ]
        exact AlgebraicGeometry.Spec.map_apply (CommRingCat.ofHom ev_Ω) pt_Ω
      change m_pt.asIdeal = RingHom.ker ev_Ω
      rw [hm_eq_s, hs_eq_comap]
      ext d
      exact Iff.rfl

    let p₀ : Ideal (Polynomial Ω) :=
      Ideal.span {Polynomial.X - Polynomial.C (ι_B₁_Ω (c_a a))}
    have hp₀_eq : p₀ = Ideal.comap ψ_Ω m_x := by
      ext P
      rw [hm_x_ker]
      change P ∈ Ideal.span {Polynomial.X - Polynomial.C (ι_B₁_Ω (c_a a))} ↔
        (ev_Ω.comp ψ_Ω) P = 0
      rw [hev_Ω_eval, Ideal.mem_span_singleton]
      change Polynomial.X - Polynomial.C (ι_B₁_Ω (c_a a)) ∣ P ↔
        Polynomial.eval (ι_B₁_Ω (c_a a)) P = 0
      exact Polynomial.dvd_iff_isRoot
    have hp₀_prime : p₀.IsPrime := by
      rw [hp₀_eq]
      exact Ideal.IsPrime.comap ψ_Ω
    let _ : p₀.IsPrime := hp₀_prime

    
    have hMax_Dloc :
        Ideal.span {algebraMap D (Localization.AtPrime m_x) t_Ω} =
          IsLocalRing.maximalIdeal (Localization.AtPrime m_x) := by
      let R₀ := Polynomial Ω
      let P_loc := Localization.AtPrime p₀
      let D_loc := Localization.AtPrime m_x
      let _ : Algebra R₀ D := ψ_Ω.toAlgebra
      have _ : Algebra.Etale R₀ D := RingHom.etale_algebraMap.mp hψ_Ω_et
      let φ_loc : P_loc →+* D_loc := Localization.localRingHom p₀ m_x ψ_Ω hp₀_eq
      have hLoc_φ : IsLocalHom φ_loc := Localization.isLocalHom_localRingHom p₀ m_x ψ_Ω hp₀_eq
      let _ : Algebra P_loc D_loc := φ_loc.toAlgebra
      have _ : IsLocalHom (algebraMap P_loc D_loc) := hLoc_φ
      have _ : IsScalarTower R₀ P_loc D_loc :=
        IsScalarTower.of_algebraMap_eq fun r => by
          rw [IsScalarTower.algebraMap_apply R₀ D D_loc r]
          exact (Localization.localRingHom_to_map p₀ m_x ψ_Ω hp₀_eq r).symm
      have _ : Algebra.FormallyUnramified D D_loc :=
        Algebra.FormallyUnramified.of_isLocalization m_x.primeCompl
      have _ : Algebra.FormallyUnramified R₀ D_loc :=
        Algebra.FormallyUnramified.comp R₀ D D_loc
      have _ : Algebra.FormallyUnramified P_loc D_loc :=
        Algebra.FormallyUnramified.localization_base p₀.primeCompl
      have _ : Algebra.EssFiniteType D D_loc :=
        Algebra.EssFiniteType.of_isLocalization D_loc m_x.primeCompl
      have _ : Algebra.EssFiniteType R₀ D_loc :=
        Algebra.EssFiniteType.comp R₀ D D_loc
      have _ : Algebra.EssFiniteType P_loc D_loc :=
        Algebra.EssFiniteType.of_comp R₀ P_loc D_loc
      have hmax_P : Ideal.map (algebraMap R₀ P_loc) p₀ = IsLocalRing.maximalIdeal P_loc :=
        IsLocalization.AtPrime.map_eq_maximalIdeal p₀ P_loc
      have hmax_D : Ideal.map (algebraMap P_loc D_loc) (IsLocalRing.maximalIdeal P_loc) =
          IsLocalRing.maximalIdeal D_loc :=
        Algebra.FormallyUnramified.map_maximalIdeal
      rw [← hmax_P, Ideal.map_map] at hmax_D
      have hcomp_map : (algebraMap P_loc D_loc).comp (algebraMap R₀ P_loc) =
          (algebraMap D D_loc).comp ψ_Ω :=
        RingHom.ext fun r => Localization.localRingHom_to_map p₀ m_x ψ_Ω hp₀_eq r
      rw [hcomp_map] at hmax_D
      dsimp [p₀] at hmax_D
      rw [Ideal.map_span, Set.image_singleton, RingHom.comp_apply, ht_Ω_eq] at hmax_D
      exact hmax_D

    
    have _ : IsLocalization.AtPrime ↑(Y_η.presheaf.stalk ↑pt_x) m_x :=
      hAff_V.isLocalization_stalk pt_x
    let e_stalk :
        Localization.AtPrime m_x ≃ₐ[↑(Y_η.presheaf.obj (Opposite.op V_aff))]
          ↑(Y_η.presheaf.stalk ↑pt_x) :=
      IsLocalization.algEquiv m_x.primeCompl
        (Localization.AtPrime m_x) ↑(Y_η.presheaf.stalk ↑pt_x)
    have he_t :
        e_stalk.toRingEquiv (algebraMap D (Localization.AtPrime m_x) t_Ω) =
          (Y_η.presheaf.germ V_aff (x_η a).1 hx₀_Vaff).hom t_Ω := by
      have hc := e_stalk.commutes t_Ω
      rw [TopCat.Presheaf.stalk_open_algebraMap Y_η.presheaf pt_x] at hc
      exact hc
    have hmap_max :
        Ideal.map e_stalk.toRingEquiv.toRingHom
          (IsLocalRing.maximalIdeal (Localization.AtPrime m_x)) =
          IsLocalRing.maximalIdeal ↑(Y_η.presheaf.stalk ↑pt_x) := by
      ext y
      rw [Ideal.mem_map_iff_of_surjective
        e_stalk.toRingEquiv.toRingHom e_stalk.toRingEquiv.surjective]
      constructor
      · rintro ⟨z, hz, rfl⟩
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz ⊢
        intro hu
        exact hz (by simpa using hu.map e_stalk.symm.toRingHom)
      · intro hy
        refine ⟨e_stalk.symm y, ?_, e_stalk.apply_symm_apply y⟩
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hy ⊢
        intro hu
        exact hy (by simpa using hu.map e_stalk.toRingHom)
    change Ideal.span {(Y_η.presheaf.germ V_aff (x_η a).1 hx₀_Vaff).hom t_Ω} =
      IsLocalRing.maximalIdeal ↑(Y_η.presheaf.stalk ↑pt_x)
    rw [← hmap_max, ← hMax_Dloc, Ideal.map_span, Set.image_singleton]
    congr 2
    exact he_t.symm

  · 
    intro hne
    have hx_ne_val : x.1 ≠ (x_η a).1 := fun heq => hne (Subtype.ext heq)
    have hx_not_σ : ι_η_B₁.base x.1 ∉ Set.range (σ_a a).base := by
      intro hmem
      have hx_pre : x.1 ∈ ι_η_B₁.base ⁻¹' Set.range (σ_a a).base := hmem
      rw [hPre_eq a, Set.mem_singleton_iff] at hx_pre
      exact hx_ne_val hx_pre
    have hx_out : ι_η_B₁.base x.1 ∈ U_out a := by
      change ι_η_B₁.base x.1 ∈ (U_out a : Set ↥Y_B₁)
      rw [hU_out_eq a]
      exact hx_not_σ
    let W_out : Y_B₁.Opens := W₁ α ⊓ U_out a
    let V_out : Y_η.Opens := (TopologicalSpace.Opens.map ι_η_B₁.base).obj W_out
    have hx_Vout : x.1 ∈ V_out := ⟨hx, hx_out⟩
    have hle_Vout : V_out ≤ V α := fun _ hy => hy.1
    have hUnit_Wout : IsUnit (resYB (inf_le_left : W_out ≤ W₁ α) (h_sec a α)) := by
      have hg_ov : resYB (inf_le_left : U_in a ⊓ U_out a ≤ U_in a) (g_in a) = (u_ov a).1 :=
        hu_ov_eq a
      dsimp only [h_sec]
      by_cases hα : W₁ α ≤ U_in a
      · simp only [hα, ↓reduceDIte]
        have hle_u : W_out ≤ U_in a ⊓ U_out a := fun _ hy => ⟨hα hy.1, hy.2⟩
        have hcomp_u :
            resYB (inf_le_left : W_out ≤ W₁ α) (resYB hα (g_in a)) =
              resYB hle_u (resYB (inf_le_left : U_in a ⊓ U_out a ≤ U_in a) (g_in a)) :=
          (hresYB_comp _ _ (g_in a)).trans (hresYB_comp _ _ (g_in a)).symm
        rw [hcomp_u, hg_ov]
        exact (u_ov a).isUnit.map _
      · simp only [hα, ↓reduceDIte, map_one]
        exact isUnit_one
    have hGerm_out :
        (Y_η.presheaf.germ (V α) x.1 hx).hom ((ι_η_B₁.app (W₁ α)).hom (h_sec a α)) =
          (Y_η.presheaf.germ V_out x.1 hx_Vout).hom
            ((ι_η_B₁.app W_out).hom (resYB (inf_le_left : W_out ≤ W₁ α) (h_sec a α))) := by
      have hApp := hAppRes ι_η_B₁ (inf_le_left : W_out ≤ W₁ α) hle_Vout (h_sec a α)
      rw [← hApp]
      exact (TopCat.Presheaf.germ_res_apply Y_η.presheaf (CategoryTheory.homOfLE hle_Vout)
        x.1 hx_Vout ((ι_η_B₁.app (W₁ α)).hom (h_sec a α))).symm
    rw [Ideal.span_singleton_eq_top, hGerm_out]
    exact (hUnit_Wout.map (ι_η_B₁.app W_out).hom).map (Y_η.presheaf.germ V_out x.1 hx_Vout).hom

theorem weil_rel_curve_dvr_section_extension_and_smooth_uniformizer_cover (k : Type u) [Field k] [IsAlgClosed k]
    (C_aff : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine C_aff] [AlgebraicGeometry.IsIntegral C_aff]
    (u_C : Quiver.Hom C_aff (weilAffineSpaceOver k 1).left)
    [AlgebraicGeometry.Etale u_C]
    (c₀ : ↥C_aff) (hc₀ : IsClosed ({c₀} : Set ↥C_aff))
    (s_c₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) C_aff)
    (hs_c₀_sec :
      CategoryTheory.CategoryStruct.comp s_c₀
        (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_c₀_range : Set.range s_c₀.base = {c₀})
    (Y_C : AlgebraicGeometry.Scheme.{u})
    (f_C : Quiver.Hom Y_C C_aff)
    [AlgebraicGeometry.IsProper f_C]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_C]
    (hFinProj :
      ∃ (N : ℕ)
        (ι_proj : Quiver.Hom Y_C
          (CategoryTheory.Limits.pullback
            (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom)
            (weilProjectiveSpaceOver k N).hom)),
        AlgebraicGeometry.IsFinite ι_proj ∧
        CategoryTheory.CategoryStruct.comp ι_proj
          (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom)
            (weilProjectiveSpaceOver k N).hom) = f_C)
    (R_dom : Type u) [CommRing R_dom] [IsDomain R_dom]
    (g_dom : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R_dom)) C_aff)
    [AlgebraicGeometry.Etale g_dom]
    (Y_dom : AlgebraicGeometry.Scheme.{u})
    (p_dom : Quiver.Hom Y_dom Y_C)
    (f_dom : Quiver.Hom Y_dom (AlgebraicGeometry.Spec (CommRingCat.of R_dom)))
    (hPb_dom : CategoryTheory.IsPullback p_dom f_dom f_C g_dom)
    (Y_η : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral Y_η]
    (ι_η : Quiver.Hom Y_η Y_dom)
    (f_η : Quiver.Hom Y_η
      (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure (FractionRing R_dom)))))
    (hPb_η : CategoryTheory.IsPullback ι_η f_η f_dom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (FractionRing R_dom) (AlgebraicClosure (FractionRing R_dom))).comp
          (algebraMap R_dom (FractionRing R_dom))))))
    (m_sec : ℕ)
    (x_η : Fin m_sec → {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)}) :
    let Ω := AlgebraicClosure (FractionRing R_dom)
    ∃ (B₁ : Type u)
      (_ : CommRing B₁)
      (_ : IsDomain B₁)
      (_ : Algebra k B₁)
      (_ : Algebra.FiniteType k B₁)
      (_ : IsDedekindDomain B₁)
      (_ : ¬ IsField B₁)
      (g₁ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B₁)) C_aff)
      (τ_B₁ : B₁ →ₐ[k] k)
      (ι_B₁_Ω : B₁ →+* Ω)
      (_ : Function.Injective ι_B₁_Ω)
      (Y_B₁ : AlgebraicGeometry.Scheme.{u})
      (p_B₁ : Quiver.Hom Y_B₁ Y_C)
      (f_B₁ : Quiver.Hom Y_B₁ (AlgebraicGeometry.Spec (CommRingCat.of B₁)))
      (ι_η_B₁ : Quiver.Hom Y_η Y_B₁)
      (N_cov : ℕ) (_ : 1 ≤ N_cov)
      (W₁ : Fin N_cov → Y_B₁.Opens)
      (h_sec : Fin m_sec → ∀ α : Fin N_cov, ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α))))
      (r_sec : Fin m_sec → ∀ α β : Fin N_cov,
        Units ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α ⊓ W₁ β)))),
          (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₁.toRingHom)) g₁ = s_c₀ ∧
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω)) g₁ =
              CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                  ((algebraMap (FractionRing R_dom) Ω).comp
                    (algebraMap R_dom (FractionRing R_dom)))))
                g_dom ∧
            CategoryTheory.CategoryStruct.comp g₁
              (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom) =
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₁)) ∧
            ∀ x : Ω, ∃ P : Polynomial B₁, P ≠ 0 ∧ Polynomial.eval₂ ι_B₁_Ω x P = 0) ∧
          (CategoryTheory.IsPullback p_B₁ f_B₁ f_C g₁ ∧
            CategoryTheory.CategoryStruct.comp ι_η_B₁ p_B₁ =
              CategoryTheory.CategoryStruct.comp ι_η p_dom ∧
            CategoryTheory.IsPullback ι_η_B₁ f_η f_B₁
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω))) ∧
          ((⨆ α : Fin N_cov, W₁ α) = ⊤ ∧
            ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (W₁ α)) ∧
          ((∀ (a : Fin m_sec) (α : Fin N_cov), (r_sec a α α).1 = 1) ∧
            (∀ (a : Fin m_sec) (α β γ : Fin N_cov),
              (Y_B₁.presheaf.map
                (CategoryTheory.homOfLE
                  (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
                    (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β)).op).hom (r_sec a α β).1 *
              (Y_B₁.presheaf.map
                (CategoryTheory.homOfLE
                  (fun _ hx => ⟨hx.1.2, hx.2⟩ :
                    (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ)).op).hom (r_sec a β γ).1 =
              (Y_B₁.presheaf.map
                (CategoryTheory.homOfLE
                  (fun _ hx => ⟨hx.1.1, hx.2⟩ :
                    (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ)).op).hom (r_sec a α γ).1) ∧
            (∀ (a : Fin m_sec) (α β : Fin N_cov),
              (r_sec a α β).1 *
                (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h_sec a β) =
              (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h_sec a α))) ∧
          (let V : Fin N_cov → Y_η.Opens :=
            fun α => (TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α)
           ∀ (a : Fin m_sec) (α : Fin N_cov)
             (x : {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)})
             (hx : x.1 ∈ V α),
             (x = x_η a →
               Ideal.span {(Y_η.presheaf.germ (V α) x.1 hx).hom
                 ((ι_η_B₁.app (W₁ α)).hom (h_sec a α))} =
                 IsLocalRing.maximalIdeal ↑(Y_η.presheaf.stalk x.1)) ∧
             (x ≠ x_η a →
               Ideal.span {(Y_η.presheaf.germ (V α) x.1 hx).hom
                 ((ι_η_B₁.app (W₁ α)).hom (h_sec a α))} = ⊤)) :=
by
  classical
  let K₀ := FractionRing R_dom
  let Ω := AlgebraicClosure K₀
  let s_η_dom : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_dom) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      ((algebraMap K₀ Ω).comp (algebraMap R_dom K₀)))

  haveI : AlgebraicGeometry.LocallyOfFiniteType f_dom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_dom inferInstance
  obtain ⟨B₀', instCR₀, instDom₀, instAlg₀, instFT₀, hDed₀', _hNotField₀', x_nz,
      L₁, instFieldL₁, instAlgBL₁, instFracL₁, g₀', τ₀', ι_L₁_Ω, q_L₁_dom, q_η,
      ⟨hx_nz, hτ_xnz⟩, hτ₀'_g₀', hι₀'_g₀', hg₀'_uC, hAlg_Ω₀', hPts₀'⟩ :=
    weil_rel_curve_generic_points_descent_and_dedekind_base
      k C_aff u_C c₀ hc₀ s_c₀ hs_c₀_sec hs_c₀_range
      R_dom g_dom Y_dom f_dom Y_η ι_η f_η hPb_η m_sec x_η
  letI : CommRing B₀' := instCR₀
  letI : IsDomain B₀' := instDom₀
  letI : Algebra k B₀' := instAlg₀
  letI : Algebra.FiniteType k B₀' := instFT₀
  letI : Field L₁ := instFieldL₁
  letI : Algebra B₀' L₁ := instAlgBL₁
  letI : IsFractionRing B₀' L₁ := instFracL₁
  letI : IsDedekindDomain B₀' := hDed₀'

  let Y₀' : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f_C g₀'
  let p₀' : Y₀' ⟶ Y_C := CategoryTheory.Limits.pullback.fst f_C g₀'
  let f₀' : Y₀' ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₀') :=
    CategoryTheory.Limits.pullback.snd f_C g₀'
  have hPb_0' : CategoryTheory.IsPullback p₀' f₀' f_C g₀' :=
    CategoryTheory.IsPullback.of_hasPullback f_C g₀'
  haveI : AlgebraicGeometry.IsProper f₀' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_0' inferInstance

  let q_L₁_Y₀' : Fin m_sec → (AlgebraicGeometry.Spec (CommRingCat.of L₁) ⟶ Y₀') :=
    fun a => CategoryTheory.Limits.pullback.lift
      (q_L₁_dom a ≫ p_dom)
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' L₁)))
      (by rw [CategoryTheory.Category.assoc, hPb_dom.w, ← (hPts₀' a).1])
  have hq_L₁_Y₀' : ∀ a : Fin m_sec,
      q_L₁_Y₀' a ≫ f₀' =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' L₁)) :=
    fun a => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hq_L₁_p₀' : ∀ a : Fin m_sec, q_L₁_Y₀' a ≫ p₀' = q_L₁_dom a ≫ p_dom :=
    fun a => CategoryTheory.Limits.pullback.lift_fst _ _ _

  let m₀' : Ideal B₀' := RingHom.ker τ₀'.toRingHom
  haveI : m₀'.IsPrime := RingHom.ker_isPrime τ₀'.toRingHom
  have hm₀'_ne_bot : m₀' ≠ ⊥ := by
    intro hbot
    have hx_mem : x_nz ∈ m₀' := hτ_xnz
    rw [hbot, Ideal.mem_bot] at hx_mem
    exact hx_nz hx_mem
  let R₁ : Type u := Localization.AtPrime m₀'
  haveI : IsDiscreteValuationRing R₁ :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain B₀' hm₀'_ne_bot R₁
  have hB_inj : Function.Injective (algebraMap B₀' L₁) := IsFractionRing.injective B₀' L₁
  have hm₀'_unit : ∀ y : m₀'.primeCompl, IsUnit (algebraMap B₀' L₁ y) := by
    intro y
    refine Ne.isUnit ?_
    intro h0
    apply y.2
    have hy0 : (y : B₀') = 0 := hB_inj (h0.trans (map_zero _).symm)
    rw [hy0]
    exact Ideal.zero_mem m₀'
  let φ_R₁_L₁ : R₁ →+* L₁ := IsLocalization.lift (M := m₀'.primeCompl) hm₀'_unit
  letI : Algebra R₁ L₁ := φ_R₁_L₁.toAlgebra
  haveI : IsScalarTower B₀' R₁ L₁ :=
    IsScalarTower.of_algebraMap_eq fun b => (IsLocalization.lift_eq hm₀'_unit b).symm
  haveI : IsFractionRing R₁ L₁ :=
    IsFractionRing.isFractionRing_of_isDomain_of_isLocalization m₀'.primeCompl R₁ L₁

  have hValEx : AlgebraicGeometry.ValuativeCriterion.Existence f₀' := by
    apply AlgebraicGeometry.ValuativeCriterion.Existence.of_specializingMap
    have hUC : AlgebraicGeometry.UniversallyClosed f₀' := inferInstance
    rw [AlgebraicGeometry.universallyClosed_eq] at hUC
    refine CategoryTheory.MorphismProperty.universally_mono ?_ f₀' hUC
    intro X' Y' g hg
    exact hg.specializingMap

  have hSec_R₁ : ∀ a : Fin m_sec,
      ∃ σ : AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ Y₀',
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ L₁)) ≫ σ = q_L₁_Y₀' a ∧
        σ ≫ f₀' = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' R₁)) := by
    intro a
    have hcomm : CategoryTheory.CommSq (q_L₁_Y₀' a)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R₁ L₁)))
        f₀'
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' R₁))) := by
      refine ⟨?_⟩
      rw [hq_L₁_Y₀' a, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq B₀' R₁ L₁]
    let sq : AlgebraicGeometry.ValuativeCommSq f₀' :=
      AlgebraicGeometry.ValuativeCommSq.mk R₁ L₁ (q_L₁_Y₀' a)
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' R₁))) hcomm
    haveI : sq.commSq.HasLift := hValEx sq
    exact ⟨sq.commSq.lift, sq.commSq.fac_left, sq.commSq.fac_right⟩
  choose σ_R₁ hσ_R₁_top hσ_R₁_bot using hSec_R₁

  let pt_max_R₁ : PrimeSpectrum R₁ := ⟨IsLocalRing.maximalIdeal R₁, inferInstance⟩
  have hChart_R₁ : ∀ a : Fin m_sec,
      ∃ (U : Y₀'.Opens), AlgebraicGeometry.IsAffineOpen U ∧
        Set.range (σ_R₁ a).base ⊆ (U : Set ↥Y₀') := by
    intro a
    obtain ⟨U, hAffU, hmemU, -⟩ :=
      AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
        (x := (σ_R₁ a).base pt_max_R₁) (U := (⊤ : Y₀'.Opens)) trivial
    refine ⟨U, hAffU, ?_⟩
    rintro _ ⟨p, rfl⟩
    let O : Set (PrimeSpectrum R₁) := (σ_R₁ a).base ⁻¹' (U : Set ↥Y₀')
    have hO_open : IsOpen O := U.isOpen.preimage (σ_R₁ a).base.hom.continuous
    have hp_le : @LE.le (PrimeSpectrum R₁) _ p pt_max_R₁ :=
      IsLocalRing.le_maximalIdeal (PrimeSpectrum.isPrime p).ne_top
    have hpt_cl : pt_max_R₁ ∈ closure ({p} : Set (PrimeSpectrum R₁)) :=
      (PrimeSpectrum.le_iff_mem_closure p pt_max_R₁).mp hp_le
    by_contra hpO
    have hcl_sub : closure ({p} : Set (PrimeSpectrum R₁)) ⊆ Oᶜ :=
      closure_minimal (Set.singleton_subset_iff.mpr hpO) hO_open.isClosed_compl
    exact hcl_sub hpt_cl hmemU
  choose U_a hAff_a hSub_a using hChart_R₁

  let D_a : Fin m_sec → CommRingCat.{u} := fun a => Y₀'.presheaf.obj (Opposite.op (U_a a))
  let g_R₁ : ∀ a : Fin m_sec,
      AlgebraicGeometry.Spec (CommRingCat.of R₁) ⟶ AlgebraicGeometry.Spec (D_a a) :=
    fun a => AlgebraicGeometry.IsOpenImmersion.lift (hAff_a a).fromSpec (σ_R₁ a)
      (by rw [(hAff_a a).range_fromSpec]; exact hSub_a a)
  have hg_R₁_fac : ∀ a : Fin m_sec, g_R₁ a ≫ (hAff_a a).fromSpec = σ_R₁ a :=
    fun a => AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ _

  let φ_B_Da : ∀ a : Fin m_sec, B₀' →+* ↑(D_a a) :=
    fun a => (AlgebraicGeometry.Spec.preimage ((hAff_a a).fromSpec ≫ f₀')).hom
  let ψ_Da_R₁ : ∀ a : Fin m_sec, ↑(D_a a) →+* R₁ :=
    fun a => (AlgebraicGeometry.Spec.preimage (g_R₁ a)).hom
  have hSpec_φ : ∀ a : Fin m_sec,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (φ_B_Da a)) = (hAff_a a).fromSpec ≫ f₀' :=
    fun a => AlgebraicGeometry.Spec.map_preimage _
  have hSpec_ψ : ∀ a : Fin m_sec,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_Da_R₁ a)) = g_R₁ a :=
    fun a => AlgebraicGeometry.Spec.map_preimage _
  have hψ_comp_φ : ∀ a : Fin m_sec,
      (ψ_Da_R₁ a).comp (φ_B_Da a) = algebraMap B₀' R₁ := by
    intro a
    have hEq : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ((ψ_Da_R₁ a).comp (φ_B_Da a))) =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' R₁)) := by
      rw [CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, hSpec_ψ a, hSpec_φ a,
        ← CategoryTheory.Category.assoc, hg_R₁_fac a, hσ_R₁_bot a]
    exact CommRingCat.hom_ext_iff.mp (AlgebraicGeometry.Spec.map_injective hEq)

  have hPres : ∀ a : Fin m_sec,
      ∃ (n : ℕ) (π : MvPolynomial (Fin n) B₀' →+* ↑(D_a a)),
        Function.Surjective π ∧ π.comp MvPolynomial.C = φ_B_Da a := by
    intro a
    have hLFT : AlgebraicGeometry.LocallyOfFiniteType ((hAff_a a).fromSpec ≫ f₀') :=
      inferInstance
    rw [← hSpec_φ a] at hLFT
    have hFT_hom : (φ_B_Da a).FiniteType :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT
    letI : Algebra B₀' ↑(D_a a) := (φ_B_Da a).toAlgebra
    have hFT_alg : Algebra.FiniteType B₀' ↑(D_a a) := hFT_hom
    obtain ⟨n, π_alg, hSurj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := B₀') (S := ↑(D_a a))).mp hFT_alg
    refine ⟨n, π_alg.toRingHom, hSurj, ?_⟩
    ext b
    exact π_alg.commutes b
  choose n_a π_a hπ_surj hπ_C using hPres

  have hFrac : ∀ (a : Fin m_sec) (i : Fin (n_a a)),
      ∃ (num : B₀') (den : m₀'.primeCompl),
        ψ_Da_R₁ a (π_a a (MvPolynomial.X i)) * algebraMap B₀' R₁ den = algebraMap B₀' R₁ num := by
    intro a i
    obtain ⟨⟨num, den⟩, hnd⟩ :=
      IsLocalization.surj m₀'.primeCompl (ψ_Da_R₁ a (π_a a (MvPolynomial.X i)))
    exact ⟨num, den, hnd⟩
  choose num_a den_a h_num_den using hFrac

  let t₀ : B₀' := ∏ a : Fin m_sec, ∏ i : Fin (n_a a), (den_a a i : B₀')
  have ht₀ : τ₀' t₀ ≠ 0 := by
    dsimp [t₀]
    rw [map_prod]
    refine Finset.prod_ne_zero_iff.mpr fun a _ => ?_
    rw [map_prod]
    refine Finset.prod_ne_zero_iff.mpr fun i _ => ?_
    exact (den_a a i).2
  have ht₀_ne : t₀ ≠ 0 := fun h0 => ht₀ (by rw [h0, map_zero])
  let B_mid : Type u := Localization.Away t₀
  have ht₀_mem : t₀ ∈ m₀'.primeCompl := ht₀
  have ht₀_unit_R₁ : IsUnit (algebraMap B₀' R₁ t₀) :=
    IsLocalization.map_units R₁ ⟨t₀, ht₀_mem⟩
  let ι_t₀_R₁ : B_mid →+* R₁ :=
    IsLocalization.Away.lift t₀ ht₀_unit_R₁
  let ι_t₀_L₁ : B_mid →+* L₁ :=
    (algebraMap R₁ L₁).comp ι_t₀_R₁
  have hι_t₀_R₁_eq : ∀ b : B₀',
      ι_t₀_R₁ (algebraMap B₀' B_mid b) = algebraMap B₀' R₁ b :=
    fun b => IsLocalization.Away.lift_eq t₀ ht₀_unit_R₁ b
  have hι_t₀_L₁_comp : ι_t₀_L₁.comp (algebraMap B₀' B_mid) = algebraMap B₀' L₁ := by
    ext b
    change algebraMap R₁ L₁ (ι_t₀_R₁ (algebraMap B₀' B_mid b)) = algebraMap B₀' L₁ b
    rw [hι_t₀_R₁_eq b, ← IsScalarTower.algebraMap_apply B₀' R₁ L₁ b]
  have hι_t₀_L₁_inj : Function.Injective ι_t₀_L₁ := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers t₀) w
    have hb0 : algebraMap B₀' L₁ b = 0 := by
      calc
        algebraMap B₀' L₁ b = ι_t₀_L₁ (algebraMap B₀' B_mid b) := by
          rw [← RingHom.comp_apply, hι_t₀_L₁_comp]
        _ = ι_t₀_L₁ (w * algebraMap B₀' B_mid s) := by rw [hbs]
        _ = ι_t₀_L₁ w * ι_t₀_L₁ (algebraMap B₀' B_mid s) := map_mul _ _ _
        _ = 0 := by rw [hw, zero_mul]
    have hb_zero : b = 0 := hB_inj (hb0.trans (map_zero _).symm)
    have hs_unit : IsUnit (algebraMap B₀' B_mid s) :=
      IsLocalization.map_units B_mid s
    apply hs_unit.mul_right_cancel
    dsimp at hbs
    rw [hbs, hb_zero, map_zero, zero_mul]
  have hι_t₀_R₁_inj : Function.Injective ι_t₀_R₁ :=
    Function.Injective.of_comp (f := algebraMap R₁ L₁) hι_t₀_L₁_inj

  have hDenUnit : ∀ (a : Fin m_sec) (i : Fin (n_a a)),
      IsUnit (algebraMap B₀' B_mid (den_a a i : B₀')) := by
    intro a i
    have hdvd_i : (den_a a i : B₀') ∣ ∏ j : Fin (n_a a), (den_a a j : B₀') :=
      Finset.dvd_prod_of_mem _ (Finset.mem_univ i)
    have hdvd_t₀ : (den_a a i : B₀') ∣ t₀ :=
      dvd_trans hdvd_i (Finset.dvd_prod_of_mem _ (Finset.mem_univ a))
    exact isUnit_of_dvd_unit (map_dvd (algebraMap B₀' B_mid) hdvd_t₀)
      (IsLocalization.Away.algebraMap_isUnit t₀)

  have hLift_Da : ∀ a : Fin m_sec,
      ∃ ψ' : ↑(D_a a) →+* B_mid,
        ι_t₀_R₁.comp ψ' = ψ_Da_R₁ a ∧
        ψ'.comp (φ_B_Da a) = algebraMap B₀' B_mid := by
    intro a
    let eval_X : Fin (n_a a) → B_mid := fun i =>
      algebraMap B₀' B_mid (num_a a i) * ↑((hDenUnit a i).unit⁻¹)
    let Φ_a : MvPolynomial (Fin (n_a a)) B₀' →+* B_mid :=
      MvPolynomial.eval₂Hom (algebraMap B₀' B_mid) eval_X
    have hΦ_R₁ : ι_t₀_R₁.comp Φ_a = (ψ_Da_R₁ a).comp (π_a a) := by
      apply MvPolynomial.ringHom_ext
      · intro b
        simp only [Φ_a, RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hι_t₀_R₁_eq b]
        have hc := congrFun (congrArg DFunLike.coe (hπ_C a)) b
        simp only [RingHom.comp_apply] at hc
        rw [hc]
        exact (congrFun (congrArg DFunLike.coe (hψ_comp_φ a)) b).symm
      · intro i
        simp only [Φ_a, RingHom.comp_apply, MvPolynomial.eval₂Hom_X', eval_X, map_mul]
        have hu_inv : ι_t₀_R₁ ↑((hDenUnit a i).unit⁻¹) *
            algebraMap B₀' R₁ (den_a a i : B₀') = 1 := by
          rw [← hι_t₀_R₁_eq (den_a a i : B₀'), ← map_mul]
          change ι_t₀_R₁ (↑((hDenUnit a i).unit⁻¹) * ↑((hDenUnit a i).unit)) = 1
          rw [Units.inv_mul, map_one]
        have h_eq := h_num_den a i
        rw [hι_t₀_R₁_eq (num_a a i), ← h_eq,
          mul_assoc, mul_comm (algebraMap B₀' R₁ _) (ι_t₀_R₁ _), hu_inv, mul_one]
    have hker : RingHom.ker (π_a a) ≤ RingHom.ker Φ_a := by
      intro p hp
      rw [RingHom.mem_ker] at hp ⊢
      apply hι_t₀_R₁_inj
      rw [map_zero]
      have hp' := congrFun (congrArg DFunLike.coe hΦ_R₁) p
      simp only [RingHom.comp_apply, hp, map_zero] at hp'
      exact hp'
    let e_quot : (MvPolynomial (Fin (n_a a)) B₀' ⧸ RingHom.ker (π_a a)) ≃+* ↑(D_a a) :=
      RingHom.quotientKerEquivOfSurjective (hπ_surj a)
    let ψ' : ↑(D_a a) →+* B_mid :=
      (Ideal.Quotient.lift (RingHom.ker (π_a a)) Φ_a hker).comp e_quot.symm.toRingHom
    have hψ'_π : ψ'.comp (π_a a) = Φ_a := by
      refine RingHom.ext fun p => ?_
      simp only [ψ', RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe]
      have hsymm : e_quot.symm (π_a a p) = Ideal.Quotient.mk (RingHom.ker (π_a a)) p := by
        apply e_quot.injective
        rw [e_quot.apply_symm_apply]
        rfl
      rw [hsymm]
      rfl
    have h1 : ι_t₀_R₁.comp ψ' = ψ_Da_R₁ a := by
      refine RingHom.ext fun d => ?_
      obtain ⟨p, rfl⟩ := hπ_surj a d
      change ι_t₀_R₁ (ψ' (π_a a p)) = ψ_Da_R₁ a (π_a a p)
      have hp1 := congrFun (congrArg DFunLike.coe hψ'_π) p
      have hp2 := congrFun (congrArg DFunLike.coe hΦ_R₁) p
      simp only [RingHom.comp_apply] at hp1 hp2
      rw [hp1, hp2]
    have h2 : ψ'.comp (φ_B_Da a) = algebraMap B₀' B_mid := by
      refine RingHom.ext fun b => ?_
      apply hι_t₀_R₁_inj
      have hb1 := congrFun (congrArg DFunLike.coe h1) (φ_B_Da a b)
      have hb2 := congrFun (congrArg DFunLike.coe (hψ_comp_φ a)) b
      simp only [RingHom.comp_apply] at hb1 hb2 ⊢
      rw [hb1, hb2, hι_t₀_R₁_eq b]
    exact ⟨ψ', h1, h2⟩
  choose ψ'_Da hψ'_R₁ hψ'_B using hLift_Da

  let σ_t₀ : Fin m_sec → (AlgebraicGeometry.Spec (CommRingCat.of B_mid) ⟶ Y₀') :=
    fun a => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ'_Da a)) ≫ (hAff_a a).fromSpec
  have hσ_t₀_f₀' : ∀ a : Fin m_sec,
      σ_t₀ a ≫ f₀' = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' B_mid)) := by
    intro a
    dsimp [σ_t₀]
    rw [CategoryTheory.Category.assoc, ← hSpec_φ a, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, hψ'_B a]
  have hσ_t₀_L₁ : ∀ a : Fin m_sec,
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_t₀_L₁) ≫ σ_t₀ a = q_L₁_Y₀' a := by
    intro a
    have hι_hom : CommRingCat.ofHom ι_t₀_L₁ =
        CommRingCat.ofHom ι_t₀_R₁ ≫ CommRingCat.ofHom (algebraMap R₁ L₁) :=
      CommRingCat.ofHom_comp ι_t₀_R₁ (algebraMap R₁ L₁)
    dsimp [σ_t₀]
    rw [hι_hom, AlgebraicGeometry.Spec.map_comp,
      CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_t₀_R₁)),
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ'_R₁ a,
      hSpec_ψ a, hg_R₁_fac a, hσ_R₁_top a]

  have ht₀_nzd : Submonoid.powers t₀ ≤ nonZeroDivisors B₀' :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero ht₀_ne)
  haveI : IsDomain B_mid := IsLocalization.isDomain_of_le_nonZeroDivisors B_mid ht₀_nzd
  haveI : Algebra.FinitePresentation B₀' B_mid := IsLocalization.Away.finitePresentation t₀
  haveI : Algebra.FiniteType B₀' B_mid := inferInstance
  haveI : Algebra.FiniteType k B_mid :=
    Algebra.FiniteType.trans (R := k) (S := B₀') (A := B_mid) inferInstance inferInstance
  haveI : IsDedekindDomain B_mid := IsLocalization.isDedekindDomain B₀' ht₀_nzd B_mid
  have hB₀'_Bmid_inj : Function.Injective (algebraMap B₀' B_mid) :=
    IsLocalization.injective B_mid ht₀_nzd

  let τ_mid_ring : B_mid →+* k := IsLocalization.Away.lift t₀ (g := τ₀'.toRingHom) (Ne.isUnit ht₀)
  have hτ_mid_eq : ∀ b : B₀', τ_mid_ring (algebraMap B₀' B_mid b) = τ₀' b :=
    fun b => IsLocalization.Away.lift_eq t₀ (Ne.isUnit ht₀) b
  let τ_mid : B_mid →ₐ[k] k :=
    { τ_mid_ring with
      commutes' := fun c => by
        change τ_mid_ring (algebraMap k B_mid c) = algebraMap k k c
        rw [IsScalarTower.algebraMap_apply k B₀' B_mid c, hτ_mid_eq, τ₀'.commutes c] }

  let ι_mid_Ω : B_mid →+* Ω := ι_L₁_Ω.comp ι_t₀_L₁
  have hι_mid_Ω_inj : Function.Injective ι_mid_Ω := ι_L₁_Ω.injective.comp hι_t₀_L₁_inj
  have hι_mid_B₀' : ι_mid_Ω.comp (algebraMap B₀' B_mid) = ι_L₁_Ω.comp (algebraMap B₀' L₁) := by
    ext b
    change ι_L₁_Ω (ι_t₀_L₁ (algebraMap B₀' B_mid b)) = ι_L₁_Ω (algebraMap B₀' L₁ b)
    rw [← RingHom.comp_apply ι_t₀_L₁, hι_t₀_L₁_comp]

  let g_mid : AlgebraicGeometry.Spec (CommRingCat.of B_mid) ⟶ C_aff :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' B_mid)) ≫ g₀'
  let Y_mid : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f_C g_mid
  let p_mid : Y_mid ⟶ Y_C := CategoryTheory.Limits.pullback.fst f_C g_mid
  let f_mid : Y_mid ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_mid) :=
    CategoryTheory.Limits.pullback.snd f_C g_mid
  have hPb_mid : CategoryTheory.IsPullback p_mid f_mid f_C g_mid :=
    CategoryTheory.IsPullback.of_hasPullback f_C g_mid
  haveI : AlgebraicGeometry.IsProper f_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_mid inferInstance
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_mid :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_mid inferInstance

  let σ_mid : Fin m_sec → (AlgebraicGeometry.Spec (CommRingCat.of B_mid) ⟶ Y_mid) :=
    fun a => CategoryTheory.Limits.pullback.lift
      (σ_t₀ a ≫ p₀')
      (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B_mid)))
      (by
        dsimp [g_mid]
        rw [CategoryTheory.Category.assoc, hPb_0'.w, ← CategoryTheory.Category.assoc,
          hσ_t₀_f₀' a, CategoryTheory.Category.id_comp])
  have hσ_mid : ∀ a : Fin m_sec,
      σ_mid a ≫ f_mid =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B_mid)) :=
    fun a => CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hσ_mid_p : ∀ a : Fin m_sec, σ_mid a ≫ p_mid = σ_t₀ a ≫ p₀' :=
    fun a => CategoryTheory.Limits.pullback.lift_fst _ _ _

  obtain ⟨t₁, ht₁, hCoverBuild⟩ :=
    weil_rel_smooth_curve_section_uniformizer_cover_and_cocycle
      k B_mid τ_mid Ω ι_mid_Ω Y_mid f_mid m_sec σ_mid hσ_mid

  have ht₁_ne : t₁ ≠ 0 := fun h0 => ht₁ (by rw [h0, map_zero])
  let B₁ : Type u := Localization.Away t₁
  have ht₁_nzd : Submonoid.powers t₁ ≤ nonZeroDivisors B_mid :=
    Submonoid.powers_le.mpr (mem_nonZeroDivisors_of_ne_zero ht₁_ne)
  have instDom₁ : IsDomain B₁ := IsLocalization.isDomain_of_le_nonZeroDivisors B₁ ht₁_nzd
  letI : IsDomain B₁ := instDom₁
  haveI : Algebra.FinitePresentation B_mid B₁ := IsLocalization.Away.finitePresentation t₁
  haveI : Algebra.FiniteType B_mid B₁ := inferInstance
  have instFT₁ : Algebra.FiniteType k B₁ :=
    Algebra.FiniteType.trans (R := k) (S := B_mid) (A := B₁) inferInstance inferInstance
  have hDed₁ : IsDedekindDomain B₁ := IsLocalization.isDedekindDomain B_mid ht₁_nzd B₁
  have hBmid_B₁_inj : Function.Injective (algebraMap B_mid B₁) :=
