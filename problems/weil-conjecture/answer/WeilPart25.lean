          (ℓ * ((a.val + b.val) / ℓ)) • y i + ((a.val + b.val) % ℓ) • y i := by
        rw [hmul, zero_add]
      _ = (ℓ * ((a.val + b.val) / ℓ) + (a.val + b.val) % ℓ) • y i := (add_nsmul _ _ _).symm
      _ = (a.val + b.val) • y i := by rw [← hdiv]
      _ = a.val • y i + b.val • y i := add_nsmul (y i) a.val b.val
  let s_hom : A₁ ⟶ (pb₁.obj ℱ).obj.obj (Opposite.op T_V') :=
    AddCommGrpCat.ofHom
      { toFun := fun c => Finset.univ.sum fun i : Fin b₁ => (c.down i).val • y i
        map_zero' := by simp [ZMod.val_zero]
        map_add' := fun c₁ c₂ => by
          change (Finset.univ.sum fun i : Fin b₁ => ((c₁.down i + c₂.down i).val) • y i) = _
          simp only [hadd_smul, Finset.sum_add_distrib] }
  let σ' : C_V'.obj A₁ ⟶ pb₁.obj ℱ := (adj_V'.homEquiv A₁ (pb₁.obj ℱ)).symm s_hom
  have hσ' : σ' ≫ π'_V' = 𝟙 (C_V'.obj A₁) := by
    apply (adj_V'.homEquiv A₁ (C_V'.obj A₁)).injective
    have hLHS : (adj_V'.homEquiv A₁ (C_V'.obj A₁)) (σ' ≫ π'_V') =
        s_hom ≫ (π'_V').hom.app (Opposite.op T_V') :=
      (adj_V'.homEquiv_naturality_right σ' π'_V').trans
        (congrArg (· ≫ (π'_V').hom.app (Opposite.op T_V'))
          ((adj_V'.homEquiv A₁ (pb₁.obj ℱ)).apply_symm_apply s_hom))
    have hRHS : (adj_V'.homEquiv A₁ (C_V'.obj A₁)) (𝟙 (C_V'.obj A₁)) = adj_V'.unit.app A₁ :=
      (adj_V'.homEquiv_unit A₁ (C_V'.obj A₁) (𝟙 (C_V'.obj A₁))).trans
        (CategoryTheory.Category.comp_id _)
    refine hLHS.trans (Eq.trans ?_ hRHS.symm)
    apply AddCommGrpCat.ext
    intro c
    change ((π'_V').hom.app (Opposite.op T_V')).hom
        (Finset.univ.sum fun i : Fin b₁ => (c.down i).val • y i) =
      (adj_V'.unit.app A₁).hom c
    rw [map_sum]
    have hsum_eval :
        (Finset.univ.sum fun i : Fin b₁ =>
          ((π'_V').hom.app (Opposite.op T_V')).hom ((c.down i).val • y i)) =
        (adj_V'.unit.app A₁).hom (Finset.univ.sum fun i : Fin b₁ => (c.down i).val • e_std i) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_nsmul, map_nsmul, hy_eval i]
    rw [hsum_eval]
    congr 1
    apply ULift.ext
    funext j
    change (Finset.univ.sum fun i : Fin b₁ => (c.down i).val • e_std i).down j = c.down j
    have hdown_sum :
        (Finset.univ.sum fun i : Fin b₁ => (c.down i).val • e_std i).down j =
          Finset.univ.sum fun i : Fin b₁ =>
            (c.down i).val • ((Pi.single i (1 : ZMod ℓ) : Fin b₁ → ZMod ℓ) j) := by
      let ev_j : ↥A₁ →+ ZMod ℓ :=
        { toFun := fun x => x.down j
          map_zero' := rfl
          map_add' := fun _ _ => rfl }
      change ev_j (Finset.univ.sum fun i : Fin b₁ => (c.down i).val • e_std i) = _
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      exact map_nsmul ev_j (c.down i).val (e_std i)
    rw [hdown_sum, Finset.sum_eq_single j]
    · rw [Pi.single_eq_same, nsmul_one, ZMod.natCast_zmod_val]
    · intro i _ hij
      rw [Pi.single_eq_of_ne (Ne.symm hij), smul_zero]
    · intro hj
      exact absurd (Finset.mem_univ j) hj

  
  have : C_V'.IsLeftAdjoint := adj_V'.isLeftAdjoint
  have : C_V'.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products _
  have : AddCommGrpCat.uliftFunctor.{u, 0}.Additive :=
    { map_add := fun {_ _} {_ _} => AddCommGrpCat.ext fun _ => rfl }
  let C'_V' : AddCommGrpCat.{0} ⥤ CategoryTheory.Sheaf J_V' AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0} ⋙ C_V'
  have : C'_V'.Additive :=
    { map_add := fun {_ _} {f g} => by
        change C_V'.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (f + g)) =
          C_V'.map (AddCommGrpCat.uliftFunctor.{u, 0}.map f) +
            C_V'.map (AddCommGrpCat.uliftFunctor.{u, 0}.map g)
        rw [AddCommGrpCat.uliftFunctor.{u, 0}.map_add, C_V'.map_add] }
  let S_split := CategoryTheory.ShortComplex.Splitting.ofExactOfSection
    (CategoryTheory.ShortComplex.mk ι'_V' π'_V' hzero_V') hSE_V'.exact σ' hσ' hSE_V'.mono_f
  let r' := S_split.r
  have hι_r : ι'_V' ≫ r' = 𝟙 _ := S_split.f_r
  have hσ_r : σ' ≫ r' = 0 := S_split.s_r
  have hsplit_pb : r' ≫ ι'_V' + π'_V' ≫ σ' = 𝟙 (pb₁.obj ℱ) := S_split.id
  let G₀ : AddCommGrpCat.{0} := AddCommGrpCat.of (Fin m₀ → ZMod ℓ)
  let G₁ : AddCommGrpCat.{0} := AddCommGrpCat.of (Fin b₁ → ZMod ℓ)
  let G_tot : AddCommGrpCat.{0} := AddCommGrpCat.of (Fin (m₀ + b₁) → ZMod ℓ)
  let inl_tot : G₀ ⟶ G_tot :=
    AddCommGrpCat.ofHom
      { toFun := fun u k => if h : k.1 < m₀ then u ⟨k.1, h⟩ else 0
        map_zero' := funext fun _ => by split_ifs <;> rfl
        map_add' := fun u₁ u₂ => funext fun k => by
          change (if h : k.1 < m₀ then u₁ ⟨k.1, h⟩ + u₂ ⟨k.1, h⟩ else (0 : ZMod ℓ)) =
            (if h : k.1 < m₀ then u₁ ⟨k.1, h⟩ else 0) + (if h : k.1 < m₀ then u₂ ⟨k.1, h⟩ else 0)
          split_ifs
          · rfl
          · exact (add_zero 0).symm }
  let inr_tot : G₁ ⟶ G_tot :=
    AddCommGrpCat.ofHom
      { toFun := fun v k => if h : k.1 < m₀ then 0 else v ⟨k.1 - m₀, by omega⟩
        map_zero' := funext fun _ => by split_ifs <;> rfl
        map_add' := fun v₁ v₂ => funext fun k => by
          change (if h : k.1 < m₀ then (0 : ZMod ℓ) else v₁ ⟨k.1 - m₀, _⟩ + v₂ ⟨k.1 - m₀, _⟩) =
            (if h : k.1 < m₀ then 0 else v₁ ⟨k.1 - m₀, _⟩) +
              (if h : k.1 < m₀ then 0 else v₂ ⟨k.1 - m₀, _⟩)
          split_ifs
          · exact (add_zero 0).symm
          · rfl }
  let fst_tot : G_tot ⟶ G₀ :=
    AddCommGrpCat.ofHom
      { toFun := fun w i => w ⟨i.1, by omega⟩
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let snd_tot : G_tot ⟶ G₁ :=
    AddCommGrpCat.ofHom
      { toFun := fun w j => w ⟨m₀ + j.1, by omega⟩
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  have hinl_fst : inl_tot ≫ fst_tot = 𝟙 G₀ := by
    apply AddCommGrpCat.ext; intro u; funext i
    change (if h : i.1 < m₀ then u ⟨i.1, h⟩ else 0) = u i
    split_ifs with h
    · rfl
    · exact absurd i.2 h
  have hinr_snd : inr_tot ≫ snd_tot = 𝟙 G₁ := by
    apply AddCommGrpCat.ext; intro v; funext j
    change (if h : m₀ + j.1 < m₀ then (0 : ZMod ℓ) else v ⟨(m₀ + j.1) - m₀, by omega⟩) = v j
    split_ifs with h
    · omega
    · exact congrArg v (Fin.ext (Nat.add_sub_cancel_left m₀ j.1))
  have hinl_snd : inl_tot ≫ snd_tot = 0 := by
    apply AddCommGrpCat.ext; intro u; funext j
    change (if h : m₀ + j.1 < m₀ then u ⟨m₀ + j.1, h⟩ else (0 : ZMod ℓ)) = 0
    split_ifs with h
    · omega
    · rfl
  have hinr_fst : inr_tot ≫ fst_tot = 0 := by
    apply AddCommGrpCat.ext; intro v; funext i
    change (if h : i.1 < m₀ then (0 : ZMod ℓ) else v ⟨i.1 - m₀, by omega⟩) = 0
    split_ifs with h
    · rfl
    · exact absurd i.2 h
  have htot_id : fst_tot ≫ inl_tot + snd_tot ≫ inr_tot = 𝟙 G_tot := by
    apply AddCommGrpCat.ext; intro w; funext k
    change (if h : k.1 < m₀ then w ⟨k.1, by omega⟩ else (0 : ZMod ℓ)) +
      (if h : k.1 < m₀ then 0 else w ⟨m₀ + (k.1 - m₀), by omega⟩) = w k
    split_ifs with h
    · exact add_zero _
    · rw [zero_add]
      exact congrArg w (Fin.ext (Nat.add_sub_of_le (Nat.le_of_not_lt h)))
  let i₀ := C'_V'.map inl_tot
  let i₁ := C'_V'.map inr_tot
  let p₀ := C'_V'.map fst_tot
  let p₁ := C'_V'.map snd_tot
  have hi₀_p₀ : i₀ ≫ p₀ = 𝟙 _ := by rw [← C'_V'.map_comp, hinl_fst, C'_V'.map_id]
  have hi₁_p₁ : i₁ ≫ p₁ = 𝟙 _ := by rw [← C'_V'.map_comp, hinr_snd, C'_V'.map_id]
  have hi₀_p₁ : i₀ ≫ p₁ = 0 := by rw [← C'_V'.map_comp, hinl_snd, C'_V'.map_zero]
  have hi₁_p₀ : i₁ ≫ p₀ = 0 := by rw [← C'_V'.map_comp, hinr_fst, C'_V'.map_zero]
  have hp_sum : p₀ ≫ i₀ + p₁ ≫ i₁ = 𝟙 (C'_V'.obj G_tot) := by
    rw [← C'_V'.map_comp, ← C'_V'.map_comp, ← C'_V'.map_add, htot_id, C'_V'.map_id]
  let Φ_hom : C_V'.obj A_tot ⟶ pb₁.obj ℱ := p₀ ≫ ι'_V' + p₁ ≫ σ'
  let Φ_inv : pb₁.obj ℱ ⟶ C_V'.obj A_tot := r' ≫ i₀ + π'_V' ≫ i₁
  let e_V' : C_V'.obj A_tot ≅ pb₁.obj ℱ :=
    { hom := Φ_hom
      inv := Φ_inv
      hom_inv_id := by
        have t00 : (p₀ ≫ ι'_V') ≫ (r' ≫ i₀) = p₀ ≫ i₀ := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc ι'_V' r' i₀,
            hι_r, CategoryTheory.Category.id_comp]
        have t01 : (p₀ ≫ ι'_V') ≫ (π'_V' ≫ i₁) = 0 := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc ι'_V' π'_V' i₁,
            hzero_V', CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
        have t10 : (p₁ ≫ σ') ≫ (r' ≫ i₀) = 0 := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc σ' r' i₀,
            hσ_r, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
        have t11 : (p₁ ≫ σ') ≫ (π'_V' ≫ i₁) = p₁ ≫ i₁ := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc σ' π'_V' i₁,
            hσ', CategoryTheory.Category.id_comp]
        dsimp [Φ_hom, Φ_inv]
        rw [CategoryTheory.Preadditive.comp_add, CategoryTheory.Preadditive.add_comp,
          CategoryTheory.Preadditive.add_comp, t00, t01, t10, t11, add_zero, zero_add, hp_sum]
        rfl
      inv_hom_id := by
        have s00 : (r' ≫ i₀) ≫ (p₀ ≫ ι'_V') = r' ≫ ι'_V' := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc i₀ p₀ ι'_V',
            hi₀_p₀, CategoryTheory.Category.id_comp]
        have s01 : (r' ≫ i₀) ≫ (p₁ ≫ σ') = 0 := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc i₀ p₁ σ',
            hi₀_p₁, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
        have s10 : (π'_V' ≫ i₁) ≫ (p₀ ≫ ι'_V') = 0 := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc i₁ p₀ ι'_V',
            hi₁_p₀, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]
        have s11 : (π'_V' ≫ i₁) ≫ (p₁ ≫ σ') = π'_V' ≫ σ' := by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc i₁ p₁ σ',
            hi₁_p₁, CategoryTheory.Category.id_comp]
        dsimp [Φ_hom, Φ_inv]
        rw [CategoryTheory.Preadditive.comp_add, CategoryTheory.Preadditive.add_comp,
          CategoryTheory.Preadditive.add_comp, s00, s01, s10, s11, add_zero, zero_add, hsplit_pb] }

  
  refine ⟨V'_sch, hAff_V'_sch, hConn_V', h₁, v', hEt_h₁, hv'_cl, hv'_map, ?_⟩
  intro V''_sch q hc hr
  obtain ⟨hc_q, hr_q, -⟩ := hSitePkg q
  let B_qh₁ : U₁.Etale ⥤ V''_sch.Etale := weilEtaleSitePullback (CategoryTheory.CategoryStruct.comp q h₁)
  let B_q : V'_sch.Etale ⥤ V''_sch.Etale := weilEtaleSitePullback q
  have : B_qh₁.IsContinuous J_U V''_sch.smallEtaleTopology := hc
  have : (B_qh₁.sheafPushforwardContinuous AddCommGrpCat.{u} J_U V''_sch.smallEtaleTopology).IsRightAdjoint := hr
  have : B_q.IsContinuous J_V' V''_sch.smallEtaleTopology := hc_q
  have : (B_q.sheafPushforwardContinuous AddCommGrpCat.{u} J_V' V''_sch.smallEtaleTopology).IsRightAdjoint := hr_q
  let J_V'' := V''_sch.smallEtaleTopology
  let pb_q := B_q.sheafPullback AddCommGrpCat.{u} J_V' J_V''
  let adj_q := B_q.sheafAdjunctionContinuous AddCommGrpCat.{u} J_V' J_V''
  let adj_qh₁ := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
    B_qh₁ AddCommGrpCat.{u} _ J_U J_V'' hc hr
  let e_B : B_qh₁ ≅ B₁.comp B_q := CategoryTheory.MorphismProperty.Over.pullbackComp q h₁
  let e_pf := CategoryTheory.Functor.sheafPushforwardContinuousComp' e_B.symm AddCommGrpCat.{u}
    J_U J_V' J_V''
  let e_pb := CategoryTheory.Adjunction.leftAdjointUniq adj_qh₁ ((adj₁.comp adj_q).ofNatIsoRight e_pf)
  let c_q_tot := weilEtaleConstPullbackHom q (weilEtaleIdTerminalIsTerminal.{u} V''_sch) hT_V' A_tot
  have : CategoryTheory.IsIso c_q_tot := hProp_const q A_tot
  exact ⟨(CategoryTheory.asIso c_q_tot).symm ≪≫ pb_q.mapIso e_V' ≪≫ (e_pb.app ℱ).symm⟩

theorem weil_etale_rel_punctured_curve_r1_split_and_pullback_of_const_proper_r1 (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (U₁ : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine U₁] [ConnectedSpace ↥U₁]
    (p_U₁ : Quiver.Hom U₁ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType p_U₁]
    (u_U₁ : Quiver.Hom U₁ (weilAffineSpaceOver k δ).left)
    [AlgebraicGeometry.Etale u_U₁]
    (hu_U₁ : CategoryTheory.CategoryStruct.comp u_U₁ (weilAffineSpaceOver k δ).hom = p_U₁)
    (u₁ : ↥U₁) (hu₁ : IsClosed ({u₁} : Set ↥U₁))
    (Y₁ : AlgebraicGeometry.Scheme.{u})
    (f₁ : Quiver.Hom Y₁ U₁) [AlgebraicGeometry.IsProper f₁]
    (m_pts : ℕ) (hm_pts : 1 ≤ m_pts)
    (τ : Fin m_pts → Quiver.Hom U₁ Y₁)
    (hτ_sec : ∀ a : Fin m_pts,
      CategoryTheory.CategoryStruct.comp (τ a) f₁ = CategoryTheory.CategoryStruct.id U₁)
    (hτ_cl : ∀ a : Fin m_pts, AlgebraicGeometry.IsClosedImmersion (τ a))
    (hτ_disj : _root_.Pairwise fun a b : Fin m_pts =>
      Disjoint (Set.range (τ a).base) (Set.range (τ b).base))
    (W₁_open : Y₁.Opens)
    (hW₁_compl : (W₁_open : Set ↥Y₁) = (⋃ a : Fin m_pts, Set.range (τ a).base)ᶜ)
    (b₁ : ℕ)
    (hConn_fib :
      ∀ (s_u : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U₁),
        CategoryTheory.CategoryStruct.comp s_u p_U₁ =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        ConnectedSpace ↥(CategoryTheory.Limits.pullback f₁ s_u))
    (hConst_R1 :
      Nonempty (CategoryTheory.Iso
        ((CategoryTheory.constantSheaf U₁.smallEtaleTopology AddCommGrpCat.{u}).obj
          (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin b₁ → ZMod ℓ))))
        (weilEtaleHigherDirectImage f₁ 1 (weilEtaleTorsionSheaf Y₁ ℓ)))) :
    ∃ (V'_sch : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsAffine V'_sch)
      (_ : ConnectedSpace ↥V'_sch)
      (h₁ : Quiver.Hom V'_sch U₁)
      (v' : ↥V'_sch),
      AlgebraicGeometry.Etale h₁ ∧
      IsClosed ({v'} : Set ↥V'_sch) ∧
      h₁.base v' = u₁ ∧
      ∀ (V''_sch : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine V''_sch]
        (q : Quiver.Hom V''_sch V'_sch) [AlgebraicGeometry.Etale q]
        (Y'' : AlgebraicGeometry.Scheme.{u})
        (p_Y : Quiver.Hom Y'' Y₁)
        (f'' : Quiver.Hom Y'' V''_sch)
        (W''_open : Y''.Opens),
        CategoryTheory.IsPullback p_Y f'' f₁ (CategoryTheory.CategoryStruct.comp q h₁) →
        W''_open = (TopologicalSpace.Opens.map p_Y.base).obj W₁_open →
        let W''_et : Y''.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ W''_open.ι inferInstance
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.constantSheaf V''_sch.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.uliftFunctor.{u, 0}.obj
              (AddCommGrpCat.of (Fin ((m_pts - 1) + b₁) → ZMod ℓ))))
          (weilEtaleHigherDirectImage f'' 1
            (weilEtaleLocalTorsionSheaf Y'' ℓ W''_et))) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  obtain ⟨hSitePkg, -⟩ := weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  let hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    fun h => Classical.choose (hSitePkg h)
  let hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (hc_all h)).IsRightAdjoint :=
    fun h => Classical.choose (Classical.choose_spec (hSitePkg h))
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology := @hc_all
  letI : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint := @hr_all
  have hPfAdd : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).Additive :=
    fun h => (Classical.choose_spec (Classical.choose_spec (hSitePkg h))).2.2

  obtain ⟨-, hProp_tor, hProp_const, hProp_loc⟩ :=
    weil_etale_proper_h0_finite_and_localTorsion_pullback_iso k ℓ
  obtain ⟨-, hConserv_iso, -⟩ :=
    weil_etale_algClosed_closedPt_conservativity_and_localPullback k ℓ
  obtain ⟨hSpec_unit, -, hSpec_H, -⟩ :=
    weil_etale_algClosed_spec_unit_iso_and_stalk_colimit k
  obtain ⟨-, hCalc_R0, -⟩ :=
    weil_etale_higherDirectImage_shortExact_calculus f₁
  obtain ⟨hFib_card, -⟩ :=
    weil_smooth_proj_curve_fiber_integral_and_projective k ℓ

  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
