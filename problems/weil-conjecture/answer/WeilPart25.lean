         IsProjectiveOverField Ω
           (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd P.f_bar s_Ω))) := by
    obtain ⟨N_proj, ι_Ybar, hCl_ιYbar⟩ := E.hProj_Ybar
    let P_N := weilProjectiveSpaceOver k N_proj
    have hιYbar_w : ι_Ybar.left ≫ P_N.hom = E.Y_bar.hom := CategoryTheory.Over.w ι_Ybar
    let ψ_Y₁ : E.Y₁ ⟶ CategoryTheory.Limits.pullback E.π_bar.left (Fgt_V.obj E.V₁).hom :=
      CategoryTheory.Limits.pullback.lift E.g_Y₁ E.f_bar₁ E.hComm_Y₁
    have : AlgebraicGeometry.IsClosedImmersion ψ_Y₁ := E.hClosed_Y₁
    have hψ_snd : ψ_Y₁ ≫ CategoryTheory.Limits.pullback.snd E.π_bar.left (Fgt_V.obj E.V₁).hom =
        E.f_bar₁ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let P_mid₁ := CategoryTheory.Limits.pullback E.π_bar.left (Fgt_V.obj E.V₁).hom
    let q₁_Y := CategoryTheory.Limits.pullback.fst E.π_bar.left (Fgt_V.obj E.V₁).hom
    let q₁_V := CategoryTheory.Limits.pullback.snd E.π_bar.left (Fgt_V.obj E.V₁).hom
    let P_mid₂ := CategoryTheory.Limits.pullback p_EV₁ E.Y_bar.hom
    let δ_EV₁ : P_mid₁ ⟶ P_mid₂ :=
      CategoryTheory.Limits.pullback.lift q₁_V q₁_Y (by
        dsimp [p_EV₁]
        rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
          CategoryTheory.Category.assoc, CategoryTheory.Over.w E.π_bar])
    have hδ_fst : δ_EV₁ ≫ CategoryTheory.Limits.pullback.fst p_EV₁ E.Y_bar.hom = q₁_V :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hδ_snd : δ_EV₁ ≫ CategoryTheory.Limits.pullback.snd p_EV₁ E.Y_bar.hom = q₁_Y :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hCl_δEV₁ : AlgebraicGeometry.IsClosedImmersion δ_EV₁ := by
      let m_prod : P_mid₂ ⟶ CategoryTheory.Limits.pullback E.V_bar.hom E.V_bar.hom :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst p_EV₁ E.Y_bar.hom ≫ (Fgt_V.obj E.V₁).hom)
          (CategoryTheory.Limits.pullback.snd p_EV₁ E.Y_bar.hom ≫ E.π_bar.left)
          (by
            rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc,
              CategoryTheory.Over.w E.π_bar]
            exact CategoryTheory.Limits.pullback.condition)
      have hm_fst : m_prod ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom =
          CategoryTheory.Limits.pullback.fst p_EV₁ E.Y_bar.hom ≫ (Fgt_V.obj E.V₁).hom :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hm_snd : m_prod ≫ CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom =
          CategoryTheory.Limits.pullback.snd p_EV₁ E.Y_bar.hom ≫ E.π_bar.left :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hcomm_diag :
          (q₁_V ≫ (Fgt_V.obj E.V₁).hom) ≫ CategoryTheory.Limits.pullback.diagonal E.V_bar.hom =
            δ_EV₁ ≫ m_prod := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc
            ((q₁_V ≫ (Fgt_V.obj E.V₁).hom) ≫ CategoryTheory.Limits.pullback.diagonal E.V_bar.hom) ≫
                CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom
              = q₁_V ≫ (Fgt_V.obj E.V₁).hom := by
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
                    CategoryTheory.Category.comp_id]
            _ = (δ_EV₁ ≫ CategoryTheory.Limits.pullback.fst p_EV₁ E.Y_bar.hom) ≫
                  (Fgt_V.obj E.V₁).hom := by rw [hδ_fst]
            _ = (δ_EV₁ ≫ m_prod) ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom := by
                  rw [CategoryTheory.Category.assoc δ_EV₁ m_prod, hm_fst,
                    CategoryTheory.Category.assoc]
        · calc
            ((q₁_V ≫ (Fgt_V.obj E.V₁).hom) ≫ CategoryTheory.Limits.pullback.diagonal E.V_bar.hom) ≫
                CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom
              = q₁_V ≫ (Fgt_V.obj E.V₁).hom := by
                  rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
                    CategoryTheory.Category.comp_id]
            _ = q₁_Y ≫ E.π_bar.left := CategoryTheory.Limits.pullback.condition.symm
            _ = (δ_EV₁ ≫ CategoryTheory.Limits.pullback.snd p_EV₁ E.Y_bar.hom) ≫ E.π_bar.left := by
                  rw [hδ_snd]
            _ = (δ_EV₁ ≫ m_prod) ≫ CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom := by
                  rw [CategoryTheory.Category.assoc δ_EV₁ m_prod, hm_snd,
                    CategoryTheory.Category.assoc]
      have hc_cond :
          ∀ c : CategoryTheory.Limits.PullbackCone
              (CategoryTheory.Limits.pullback.diagonal E.V_bar.hom) m_prod,
            (c.snd ≫ CategoryTheory.Limits.pullback.snd p_EV₁ E.Y_bar.hom) ≫ E.π_bar.left =
              (c.snd ≫ CategoryTheory.Limits.pullback.fst p_EV₁ E.Y_bar.hom) ≫
                (Fgt_V.obj E.V₁).hom := by
        intro c
        have hc₁ : (c.fst ≫ CategoryTheory.Limits.pullback.diagonal E.V_bar.hom) ≫
            CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom =
            (c.snd ≫ m_prod) ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom :=
          congrArg (· ≫ CategoryTheory.Limits.pullback.fst E.V_bar.hom E.V_bar.hom) c.condition
        have hc₂ : (c.fst ≫ CategoryTheory.Limits.pullback.diagonal E.V_bar.hom) ≫
            CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom =
            (c.snd ≫ m_prod) ≫ CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom :=
          congrArg (· ≫ CategoryTheory.Limits.pullback.snd E.V_bar.hom E.V_bar.hom) c.condition
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc, hm_fst,
          ← CategoryTheory.Category.assoc c.snd] at hc₁
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc, hm_snd,
          ← CategoryTheory.Category.assoc c.snd] at hc₂
