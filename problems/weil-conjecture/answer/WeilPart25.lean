      ((((weilEtaleSitePullback ι_pt).sheafPullback AddCommGrpCat.{u}
        Y_base.smallEtaleTopology C_pt.smallEtaleTopology).obj (U_sh_Y.obj I_mod)).H 1) :=
    hZeroSub q_pt _ 1 hZero_I

  let pf_f_base := (weilEtaleSitePullback f_base).sheafPushforwardContinuous AddCommGrpCat.{u}
    U_base.smallEtaleTopology Y_base.smallEtaleTopology
  have hStalk := ((weil_etale_algClosed_spec_unit_iso_and_stalk_colimit k).2.2.2
    U_base s_pt (pf_f_base.obj Q)).1

  have hSingle : ∀ i : Fin b,
      ∃ (W_i : AlgebraicGeometry.Scheme.{u})
        (g_i : W_i ⟶ U_base) (_ : AlgebraicGeometry.Etale g_i)
        (σ_i : S_k ⟶ W_i)
        (Y_i : AlgebraicGeometry.Scheme.{u})
        (p_Yi : Y_i ⟶ Y_base) (f_i : Y_i ⟶ W_i) (ι_i : C_pt ⟶ Y_i)
        (γ_i : weilEtaleTorsionH Y_i ℓ 1),
        σ_i ≫ g_i = s_pt ∧
        CategoryTheory.IsPullback p_Yi f_i f_base g_i ∧
        ι_i ≫ p_Yi = ι_pt ∧
        CategoryTheory.IsPullback ι_i q_pt f_i σ_i ∧
        ∀ (p'_i : weilEtaleTorsionH Y_i ℓ 1 →+ weilEtaleTorsionH C_pt ℓ 1),
          WeilIsTorsionEtalePullback ι_i ℓ 1 p'_i → p'_i γ_i = e_0 i := by
    intro i
    obtain ⟨w₀, hw₀_lift⟩ := h_s12 Y_base C_pt ι_pt ℓ hSitePull_raw
      (fun {Z₁ Z₂} h _ _ M => hConstIso_raw h M)
      (U_sh_Y.obj I_mod) Q u_res v_res huv_res hSE_res hSub_I (e_0 i)
    obtain ⟨W, σ_W, ι_W, ψ_W, s_Q, hσ_W, hι_W, hPb_ιW, hψ_W, hs_Q⟩ :=
      h_s13 S_k U_base Y_base C_pt f_base s_pt ι_pt q_pt hPb_pt Q hIso_bc₀ hStalk w₀
    obtain ⟨γ_W, hγ_W⟩ :=
      hw₀_lift ((weilEtaleSitePullback f_base).obj W) ι_W hι_W ψ_W hψ_W s_Q hs_Q
    let Fgt_U := AlgebraicGeometry.Scheme.Etale.forget U_base
    let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget Y_base
    let B_f := weilEtaleSitePullback f_base
    let W_i := (Fgt_U.obj W).left
    let g_i : W_i ⟶ U_base := (Fgt_U.obj W).hom
    have hg_i_et : AlgebraicGeometry.Etale g_i :=
      CategoryTheory.MorphismProperty.Comma.prop W
    let Y_i := (Fgt_Y.obj (B_f.obj W)).left
    let p_Yi : Y_i ⟶ Y_base := (Fgt_Y.obj (B_f.obj W)).hom
    let f_i : Y_i ⟶ W_i := CategoryTheory.Limits.pullback.fst g_i f_base
    have hPb_Yi : CategoryTheory.IsPullback p_Yi f_i f_base g_i :=
      (CategoryTheory.IsPullback.of_hasPullback g_i f_base).flip
    exact ⟨W_i, g_i, hg_i_et, σ_W, Y_i, p_Yi, f_i, ι_W, γ_W,
      hσ_W, hPb_Yi, hι_W, hPb_ιW, hγ_W⟩

  
  have hTupleLift :
      ∀ (n : ℕ) (e : Fin n → weilEtaleTorsionH C_pt ℓ 1),
        (∀ i : Fin n,
          ∃ (W_i : AlgebraicGeometry.Scheme.{u})
            (g_i : W_i ⟶ U_base) (_ : AlgebraicGeometry.Etale g_i)
            (σ_i : S_k ⟶ W_i)
            (Y_i : AlgebraicGeometry.Scheme.{u})
            (p_Yi : Y_i ⟶ Y_base) (f_i : Y_i ⟶ W_i) (ι_i : C_pt ⟶ Y_i)
            (γ_i : weilEtaleTorsionH Y_i ℓ 1),
            σ_i ≫ g_i = s_pt ∧
            CategoryTheory.IsPullback p_Yi f_i f_base g_i ∧
            ι_i ≫ p_Yi = ι_pt ∧
            CategoryTheory.IsPullback ι_i q_pt f_i σ_i ∧
            ∀ (p'_i : weilEtaleTorsionH Y_i ℓ 1 →+ weilEtaleTorsionH C_pt ℓ 1),
              WeilIsTorsionEtalePullback ι_i ℓ 1 p'_i → p'_i γ_i = e i) →
        ∃ (W_tot : AlgebraicGeometry.Scheme.{u})
          (g_tot : W_tot ⟶ U_base) (_ : AlgebraicGeometry.Etale g_tot)
          (σ_tot : S_k ⟶ W_tot)
          (Y_tot : AlgebraicGeometry.Scheme.{u})
          (p_Ytot : Y_tot ⟶ Y_base) (f_tot : Y_tot ⟶ W_tot) (ι_tot : C_pt ⟶ Y_tot)
          (s_tot : Fin n → weilEtaleTorsionH Y_tot ℓ 1),
          σ_tot ≫ g_tot = s_pt ∧
          CategoryTheory.IsPullback p_Ytot f_tot f_base g_tot ∧
          ι_tot ≫ p_Ytot = ι_pt ∧
          CategoryTheory.IsPullback ι_tot q_pt f_tot σ_tot ∧
          ∀ (i : Fin n) (p'_tot : weilEtaleTorsionH Y_tot ℓ 1 →+ weilEtaleTorsionH C_pt ℓ 1),
            WeilIsTorsionEtalePullback ι_tot ℓ 1 p'_tot → p'_tot (s_tot i) = e i := by
    intro n
    induction n with
    | zero =>
      intro e _
      exact ⟨U_base, 𝟙 U_base, inferInstance, s_pt, Y_base, 𝟙 Y_base, f_base, ι_pt, Fin.elim0,
        Category.comp_id s_pt,
        CategoryTheory.IsPullback.of_horiz_isIso
          ⟨(Category.id_comp f_base).trans (Category.comp_id f_base).symm⟩,
        Category.comp_id ι_pt, hPb_pt, fun i => Fin.elim0 i⟩
    | succ m ih =>
      intro e hS
      obtain ⟨W_m, g_m, hg_m, σ_m, Y_m, p_Ym, f_m, ι_m, s_m,
        hσ_m, hPb_Ym, hι_m, hPb_Cm, hs_m⟩ :=
        ih (fun j => e j.castSucc) (fun j => hS j.castSucc)
      obtain ⟨W_L, g_L, hg_L, σ_L, Y_L, p_YL, f_L, ι_L, γ_L,
        hσ_L, hPb_YL, hι_L, hPb_CL, hγ_L⟩ :=
        hS (Fin.last m)
      have : AlgebraicGeometry.Etale g_m := hg_m
      have : AlgebraicGeometry.Etale g_L := hg_L
      let W_tot := CategoryTheory.Limits.pullback g_m g_L
      let pr₁ : W_tot ⟶ W_m := CategoryTheory.Limits.pullback.fst g_m g_L
      let pr₂ : W_tot ⟶ W_L := CategoryTheory.Limits.pullback.snd g_m g_L
      let g_tot : W_tot ⟶ U_base := pr₁ ≫ g_m
      have hg_tot_eq : g_tot = pr₂ ≫ g_L := CategoryTheory.Limits.pullback.condition
      have hg_tot_et : AlgebraicGeometry.Etale g_tot := inferInstance
      let σ_tot : S_k ⟶ W_tot :=
        CategoryTheory.Limits.pullback.lift σ_m σ_L (hσ_m.trans hσ_L.symm)
      have hσ_pr₁ : σ_tot ≫ pr₁ = σ_m :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hσ_pr₂ : σ_tot ≫ pr₂ = σ_L :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hσ_tot : σ_tot ≫ g_tot = s_pt := by
        dsimp [g_tot]
        rw [← Category.assoc, hσ_pr₁, hσ_m]
      let Y_tot := CategoryTheory.Limits.pullback f_base g_tot
      let p_Ytot : Y_tot ⟶ Y_base := CategoryTheory.Limits.pullback.fst f_base g_tot
      let f_tot : Y_tot ⟶ W_tot := CategoryTheory.Limits.pullback.snd f_base g_tot
      have hPb_tot : CategoryTheory.IsPullback p_Ytot f_tot f_base g_tot :=
        CategoryTheory.IsPullback.of_hasPullback f_base g_tot
      have hι_cond : ι_pt ≫ f_base = (q_pt ≫ σ_tot) ≫ g_tot := by
        rw [Category.assoc, hσ_tot]
        exact hPb_pt.w
      let ι_tot : C_pt ⟶ Y_tot :=
        CategoryTheory.Limits.pullback.lift ι_pt (q_pt ≫ σ_tot) hι_cond
      have hι_tot : ι_tot ≫ p_Ytot = ι_pt :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hι_ftot : ι_tot ≫ f_tot = q_pt ≫ σ_tot :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hPb_Ctot : CategoryTheory.IsPullback ι_tot q_pt f_tot σ_tot := by
        refine CategoryTheory.IsPullback.of_right ?_ hι_ftot hPb_tot
        rw [hι_tot, hσ_tot]
        exact hPb_pt
      have hq₁_cond : p_Ytot ≫ f_base = (f_tot ≫ pr₁) ≫ g_m := by
        rw [Category.assoc]
        exact hPb_tot.w
      let q₁ : Y_tot ⟶ Y_m := hPb_Ym.lift p_Ytot (f_tot ≫ pr₁) hq₁_cond
      have hq₁_fst : q₁ ≫ p_Ym = p_Ytot := hPb_Ym.lift_fst _ _ _
      have hq₁_snd : q₁ ≫ f_m = f_tot ≫ pr₁ := hPb_Ym.lift_snd _ _ _
      have hι_q₁ : ι_tot ≫ q₁ = ι_m := by
        apply hPb_Ym.hom_ext
        · rw [Category.assoc, hq₁_fst, hι_tot, hι_m]
        · rw [Category.assoc, hq₁_snd, ← Category.assoc, hι_ftot, Category.assoc, hσ_pr₁, hPb_Cm.w]
      have hq₂_cond : p_Ytot ≫ f_base = (f_tot ≫ pr₂) ≫ g_L := by
        rw [Category.assoc, ← hg_tot_eq]
        exact hPb_tot.w
      let q₂ : Y_tot ⟶ Y_L := hPb_YL.lift p_Ytot (f_tot ≫ pr₂) hq₂_cond
      have hq₂_fst : q₂ ≫ p_YL = p_Ytot := hPb_YL.lift_fst _ _ _
      have hq₂_snd : q₂ ≫ f_L = f_tot ≫ pr₂ := hPb_YL.lift_snd _ _ _
      have hι_q₂ : ι_tot ≫ q₂ = ι_L := by
        apply hPb_YL.hom_ext
        · rw [Category.assoc, hq₂_fst, hι_tot, hι_L]
        · rw [Category.assoc, hq₂_snd, ← Category.assoc, hι_ftot, Category.assoc, hσ_pr₂, hPb_CL.w]
      obtain ⟨p_q₁, hp_q₁⟩ := weil_etale_torsion_pullback_functoriality.1 q₁ ℓ 1
      obtain ⟨p_q₂, hp_q₂⟩ := weil_etale_torsion_pullback_functoriality.1 q₂ ℓ 1
      let s_tot : Fin (m + 1) → weilEtaleTorsionH Y_tot ℓ 1 :=
        Fin.lastCases (p_q₂ γ_L) (fun j => p_q₁ (s_m j))
      refine ⟨W_tot, g_tot, hg_tot_et, σ_tot, Y_tot, p_Ytot, f_tot, ι_tot, s_tot,
        hσ_tot, hPb_tot, hι_tot, hPb_Ctot, ?_⟩
      intro i p'_tot hp'_tot
      refine Fin.lastCases ?_ ?_ i
      · dsimp [s_tot]
        rw [Fin.lastCases_last]
        obtain ⟨p_ιL, hp_ιL⟩ := weil_etale_torsion_pullback_functoriality.1 ι_L ℓ 1
        have hp_ιL' : WeilIsTorsionEtalePullback (ι_tot ≫ q₂) ℓ 1 p_ιL := by
          rwa [hι_q₂]
        have hcomp := weil_etale_torsion_pullback_functoriality.2.2.1
          ι_tot q₂ ℓ 1 p'_tot p_q₂ p_ιL hp'_tot hp_q₂ hp_ιL'
        calc
          p'_tot (p_q₂ γ_L) = (p'_tot.comp p_q₂) γ_L := rfl
          _ = p_ιL γ_L := by rw [← hcomp]
          _ = e (Fin.last m) := hγ_L p_ιL hp_ιL
      · intro j
        dsimp [s_tot]
        rw [Fin.lastCases_castSucc]
        obtain ⟨p_ιm, hp_ιm⟩ := weil_etale_torsion_pullback_functoriality.1 ι_m ℓ 1
        have hp_ιm' : WeilIsTorsionEtalePullback (ι_tot ≫ q₁) ℓ 1 p_ιm := by
          rwa [hι_q₁]
        have hcomp := weil_etale_torsion_pullback_functoriality.2.2.1
          ι_tot q₁ ℓ 1 p'_tot p_q₁ p_ιm hp'_tot hp_q₁ hp_ιm'
        calc
          p'_tot (p_q₁ (s_m j)) = (p'_tot.comp p_q₁) (s_m j) := rfl
          _ = p_ιm (s_m j) := by rw [← hcomp]
          _ = e j.castSucc := hs_m j p_ιm hp_ιm

  obtain ⟨W_tot, g_tot, hg_tot_et, σ_tot, Y_tot, p_Ytot, f_tot, ι_tot, s_tot,
    hσ_tot, hPb_tot, hι_tot, hPb_Ctot, hs_tot⟩ := hTupleLift b e_0 hSingle
  have : AlgebraicGeometry.Etale g_tot := hg_tot_et

  
  let pt_k : ↥S_k := default
  have hSubSk : Subsingleton ↥S_k := inferInstance
  let x_tot : ↥W_tot := σ_tot.base pt_k
  obtain ⟨W_aff, hW_aff, hx_mem, _⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
      (show x_tot ∈ (⊤ : W_tot.Opens) from trivial)
  have : AlgebraicGeometry.IsAffine W_aff.toScheme := hW_aff
  have h_range_W : Set.range σ_tot.base ⊆ Set.range W_aff.ι.base := by
    rw [W_aff.range_ι]
    rintro _ ⟨z, rfl⟩
    rw [@Subsingleton.elim ↥S_k hSubSk z pt_k]
    exact hx_mem
  let σ_aff : S_k ⟶ W_aff.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift W_aff.ι σ_tot h_range_W
  have hσ_aff_fac : σ_aff ≫ W_aff.ι = σ_tot :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac W_aff.ι σ_tot h_range_W
  have hσ_aff_sec : σ_aff ≫ (W_aff.ι ≫ g_tot ≫ p_U) = 𝟙 S_k := by
    rw [← Category.assoc, hσ_aff_fac, ← Category.assoc, hσ_tot, hs_pt_sec]
  obtain ⟨w₀_aff, hrange_aff, hw₀_cl⟩ :=
    (weil_algClosed_affine_closed_point_section_and_pullback_lift k).2.1
      W_aff.toScheme (W_aff.ι ≫ g_tot ≫ p_U) σ_aff hσ_aff_sec
  have : AlgebraicGeometry.Etale (W_aff.ι ≫ g_tot ≫ u_U) := inferInstance
  obtain ⟨U_dom, hU_aff, hw₀_mem, hU_int⟩ :=
    (weil_algClosed_smooth_etale_local_domain_and_connected_integral k).1
      δ W_aff.toScheme (W_aff.ι ≫ g_tot ≫ u_U) w₀_aff hw₀_cl
  have h_range_U : Set.range σ_aff.base ⊆ Set.range U_dom.ι.base := by
    rw [U_dom.range_ι, hrange_aff]
    rintro _ rfl
    exact hw₀_mem
  let U_pt : AlgebraicGeometry.Scheme.{u} := U_dom.toScheme
  have : AlgebraicGeometry.IsAffine U_pt := hU_aff
  let s'_pt : S_k ⟶ U_pt :=
    AlgebraicGeometry.IsOpenImmersion.lift U_dom.ι σ_aff h_range_U
  have hs'_dom_fac : s'_pt ≫ U_dom.ι = σ_aff :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac U_dom.ι σ_aff h_range_U
  let j_pt : U_pt ⟶ W_tot := U_dom.ι ≫ W_aff.ι
  have : AlgebraicGeometry.Etale j_pt := inferInstance
  let h_pt : U_pt ⟶ U_base := j_pt ≫ g_tot
  have : AlgebraicGeometry.Etale h_pt := inferInstance
  have hs'_jpt : s'_pt ≫ j_pt = σ_tot := by
    dsimp [j_pt]
    rw [← Category.assoc, hs'_dom_fac, hσ_aff_fac]
  have hs'_hpt : s'_pt ≫ h_pt = s_pt := by
    dsimp [h_pt]
    rw [← Category.assoc, hs'_jpt, hσ_tot]
  have hs'_sec : s'_pt ≫ (h_pt ≫ p_U) = 𝟙 S_k := by
    rw [← Category.assoc, hs'_hpt, hs_pt_sec]
  obtain ⟨u'_pt, hs'_range, hu'_cl⟩ :=
    (weil_algClosed_affine_closed_point_section_and_pullback_lift k).2.1
      U_pt (h_pt ≫ p_U) s'_pt hs'_sec
  have hu'_img : h_pt.base u'_pt = u_pt := by
    have hu'_mem : u'_pt ∈ Set.range s'_pt.base := by
      rw [hs'_range]
      exact rfl
    rcases hu'_mem with ⟨z, rfl⟩
    have h_comp_z : h_pt.base (s'_pt.base z) = s_pt.base z := by
      rw [← AlgebraicGeometry.Scheme.Hom.comp_apply, hs'_hpt]
    have hz_mem : s_pt.base z ∈ ({u_pt} : Set ↥U_base) := by
      rw [← hs_pt_range]
      exact ⟨z, rfl⟩
    exact h_comp_z.trans hz_mem
  let Y_pt : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f_tot j_pt
  let q_Y : Y_pt ⟶ Y_tot := CategoryTheory.Limits.pullback.fst f_tot j_pt
  let f_pt : Y_pt ⟶ U_pt := CategoryTheory.Limits.pullback.snd f_tot j_pt
  let p_Ypt : Y_pt ⟶ Y_base := q_Y ≫ p_Ytot
  have hPb_Ypt : CategoryTheory.IsPullback p_Ypt f_pt f_base h_pt :=
    (CategoryTheory.IsPullback.of_hasPullback f_tot j_pt).paste_horiz hPb_tot
  have h_lift_cond : ι_tot ≫ f_tot = (q_pt ≫ s'_pt) ≫ j_pt := by
    rw [Category.assoc, hs'_jpt]
    exact hPb_Ctot.w
  let ι'_pt : C_pt ⟶ Y_pt :=
    CategoryTheory.Limits.pullback.lift ι_tot (q_pt ≫ s'_pt) h_lift_cond
  have hι'_qY : ι'_pt ≫ q_Y = ι_tot :=
    CategoryTheory.Limits.pullback.lift_fst ι_tot (q_pt ≫ s'_pt) h_lift_cond
  have hι'_fpt : ι'_pt ≫ f_pt = q_pt ≫ s'_pt :=
    CategoryTheory.Limits.pullback.lift_snd ι_tot (q_pt ≫ s'_pt) h_lift_cond
  have hι'_pYpt : ι'_pt ≫ p_Ypt = ι_pt := by
    dsimp [p_Ypt]
    rw [← Category.assoc, hι'_qY, hι_tot]
  have hPb_Cpt : CategoryTheory.IsPullback ι'_pt q_pt f_pt s'_pt := by
    refine CategoryTheory.IsPullback.of_right ?_ hι'_fpt
      (CategoryTheory.IsPullback.of_hasPullback f_tot j_pt)
    rw [hι'_qY, hs'_jpt]
    exact hPb_Ctot
  obtain ⟨p_qY, hp_qY⟩ := weil_etale_torsion_pullback_functoriality.1 q_Y ℓ 1
  let s_tor : Fin b → weilEtaleTorsionH Y_pt ℓ 1 := fun i => p_qY (s_tot i)
  refine ⟨U_pt, hU_aff, hU_int, h_pt, u'_pt, s'_pt, Y_pt, p_Ypt, f_pt, ι'_pt, s_tor,
    inferInstance, hu'_cl, hu'_img, hs'_hpt, hs'_range,
    hPb_Ypt, hι'_pYpt, hPb_Cpt, ?_⟩
  intro i p'_pt hp'_pt
  obtain ⟨p_ιtot, hp_ιtot⟩ := weil_etale_torsion_pullback_functoriality.1 ι_tot ℓ 1
  have hp_ιtot' : WeilIsTorsionEtalePullback (ι'_pt ≫ q_Y) ℓ 1 p_ιtot := by
    rwa [hι'_qY]
  have hcomp_eq := weil_etale_torsion_pullback_functoriality.2.2.1
    ι'_pt q_Y ℓ 1 p'_pt p_qY p_ιtot hp'_pt hp_qY hp_ιtot'
  calc
    p'_pt (s_tor i) = (p'_pt.comp p_qY) (s_tot i) := rfl
    _ = p_ιtot (s_tot i) := by rw [← hcomp_eq]
    _ = e_0 i := hs_tot i p_ιtot hp_ιtot

theorem weil_etale_proper_r1_constSheaf_iso_of_fiber_inj_and_card (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (U_pt : AlgebraicGeometry.Scheme.{u})
    (p_pt : Quiver.Hom U_pt (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType p_pt]
    (Y_pt : AlgebraicGeometry.Scheme.{u})
    (f_pt : Quiver.Hom Y_pt U_pt)
    [AlgebraicGeometry.IsProper f_pt]
    (b_pt : ℕ)
    (s_tor : Fin b_pt → weilEtaleTorsionH Y_pt ℓ 1)
    (hFib :
      ∀ (s_u : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U_pt),
        CategoryTheory.CategoryStruct.comp s_u p_pt =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        let C_u := CategoryTheory.Limits.pullback f_pt s_u
        let ι_u := CategoryTheory.Limits.pullback.fst f_pt s_u
        Nat.card (weilEtaleTorsionH C_u ℓ 1) = ℓ ^ b_pt ∧
        ∀ (p_u : weilEtaleTorsionH Y_pt ℓ 1 →+ weilEtaleTorsionH C_u ℓ 1),
          WeilIsTorsionEtalePullback ι_u ℓ 1 p_u →
          Function.Injective
            (fun c : Fin b_pt → ZMod ℓ =>
              Finset.univ.sum fun i : Fin b_pt => (c i).val • p_u (s_tor i))) :
    Nonempty (CategoryTheory.Iso
      ((CategoryTheory.constantSheaf U_pt.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj
          (AddCommGrpCat.of (Fin b_pt → ZMod ℓ))))
      (weilEtaleHigherDirectImage f_pt 1
        (weilEtaleTorsionSheaf Y_pt ℓ))) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  haveI : NeZero ℓ := ⟨hPrime.ne_zero⟩
  haveI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  haveI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
