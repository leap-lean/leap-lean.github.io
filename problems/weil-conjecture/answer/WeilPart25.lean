        have hval : (U'.obj F_sh).obj = (U.obj F_sh).obj := hU'_obj F_sh
        cases h1 : U'.obj F_sh
        cases h2 : U.obj F_sh
        rw [h1, h2] at hval
        dsimp at hval
        subst hval
        rfl
      have hMap_heq : ∀ {F₁ F₂ : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)} (u : F₁ ⟶ F₂)
          (W : Opposite S.Etale), HEq ((U'.map u).hom.app W) ((U.map u).hom.app W) :=
        fun u W => hU'_map u W
      generalize hU₀ : U = U₀ at hObj hMap_heq ⊢
      cases U' with
      | mk obj' map' id' comp' =>
        cases U₀ with
        | mk obj0 map0 id0 comp0 =>
          dsimp at hObj
          subst hObj
          congr
          funext F₁ F₂ u
          apply Sheaf.hom_ext
          apply NatTrans.ext
          funext W
          exact eq_of_heq (hMap_heq u W)
    subst hU_eq
    have hAdd_eq : instAdd' = instAdd := Subsingleton.elim _ _
    have hLim_eq : instLim' = instLim := Subsingleton.elim _ _
    have hColim_eq : instColim' = instColim := Subsingleton.elim _ _
    subst hAdd_eq; subst hLim_eq; subst hColim_eq
    let u₀' : FgtMod.obj R_mod ⟶ FgtMod.obj (oneR.obj.obj (Opposite.op T')) := u_unit'
    have hu_eq : u₀' = FgtMod.map
        ((CategoryTheory.constantSheafAdj S.smallEtaleTopology (ModuleCat.{u, u} R) hT').unit.app R_mod) :=
      eq_of_heq hu_unit'
    have hu_nat : u₀' ≫ FgtMod.map (oneR.obj.map (Opposite.op (hT'.from T))) =
        FgtMod.map (adjR.unit.app R_mod) := by
      rw [hu_eq, ← FgtMod.map_comp, hConstUnit hT' R_mod]
      rfl
    have h_inℤ : (ιℤ ≫ u_unit') ≫ (U.obj oneR).obj.map (Opposite.op (hT'.from T)) =
        ιℤ ≫ u_unit := by
      change (ιℤ ≫ u₀') ≫ FgtMod.map (oneR.obj.map (Opposite.op (hT'.from T))) =
        ιℤ ≫ FgtMod.map (adjR.unit.app R_mod)
      rw [Category.assoc, hu_nat]
      rfl
    have h_inM : (ιM ≫ u_unit') ≫ (U.obj oneR).obj.map (Opposite.op (hT'.from T)) =
        ιM ≫ u_unit := by
      change (ιM ≫ u₀') ≫ FgtMod.map (oneR.obj.map (Opposite.op (hT'.from T))) =
        ιM ≫ FgtMod.map (adjR.unit.app R_mod)
      rw [Category.assoc, hu_nat]
      rfl
    have hη_eq :
        ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT').homEquiv
          Aℤ (U.obj oneR)).symm (ιℤ ≫ u_unit') = ηℤ := by
      rw [hConstSymm hT' Aℤ (U.obj oneR) (ιℤ ≫ u_unit')]
      exact congrArg (adjℤ.homEquiv Aℤ (U.obj oneR)).symm h_inℤ
    have hα_eq :
        ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT').homEquiv
          AM (U.obj oneR)).symm (ιM ≫ u_unit') = αM := by
      rw [hConstSymm hT' AM (U.obj oneR) (ιM ≫ u_unit')]
      exact congrArg (adjℤ.homEquiv AM (U.obj oneR)).symm h_inM
    have hβ_eq : βM' = βM := by
      have hβα'' : βM' ≫ αM = 𝟙 (U.obj oneR) := by rwa [← hα_eq]
      calc
        βM' = βM' ≫ 𝟙 FM := (Category.comp_id _).symm
        _ = βM' ≫ (αM ≫ βM) := by rw [hαβ]
        _ = (βM' ≫ αM) ≫ βM := (Category.assoc _ _ _).symm
        _ = 𝟙 (U.obj oneR) ≫ βM := by rw [hβα'']
        _ = βM := Category.id_comp _
    ext x
    rw [hform' x]
    change (CategoryTheory.Abelian.Ext.mk₀ βM').postcomp Fℤ (Nat.add_zero j)
      ((CategoryTheory.Abelian.Ext.mk₀
        (((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT').homEquiv
          Aℤ (U.obj oneR)).symm (ιℤ ≫ u_unit'))).comp
        ((@CategoryTheory.Functor.mapExtAddHom _ _ _ _ _ _ U instAdd instLim instColim _ _
          oneR oneR j) x)
        (Nat.zero_add j)) = θ x
    rw [hη_eq, hβ_eq]
    rfl

  
  
  
  let IsTF : Sheaf S.smallEtaleTopology AddCommGrpCat.{u} → Prop :=
    fun K => ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • CategoryTheory.CategoryStruct.id K)
  have _hGrothℤ : IsGrothendieckAbelian.{u} (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    Scheme.isGrothendieckAbelian_sheaf_smallEtaleTopology S AddCommGrpCat.{u}
  have _hColimUUℤ : Limits.HasColimitsOfSize.{u, u} (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    IsGrothendieckAbelian.hasColimits _
  have _hColim0Uℤ : Limits.HasColimitsOfSize.{0, u} (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    Limits.hasColimitsOfSizeShrink.{0, u, u, u} _
  have _hCoprodℤ : Limits.HasCoproducts.{u} (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
    fun J_idx => Limits.HasColimitsOfSize.has_colimits_of_shape (Discrete J_idx)
  have hMonoAℤ : ∀ n : ℕ, n ≠ 0 → CategoryTheory.Mono (n • 𝟙 Aℤ) := by
    intro n hn
    rw [AddCommGrpCat.mono_iff_injective]
    intro x y hxy
    have h1 : (n • x).down = (n • y).down := congrArg ULift.down hxy
    change n • x.down = n • y.down at h1
    rw [nsmul_eq_mul, nsmul_eq_mul] at h1
    have hnℤ : (n : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hn
    exact ULift.ext _ _ (mul_left_cancel₀ hnℤ h1)
  have hMonoSigmaGrp :
      ∀ {I : Type u} (Y : I → AddCommGrpCat.{u}) (n : ℕ),
        (∀ i : I, CategoryTheory.Mono (n • 𝟙 (Y i))) →
        CategoryTheory.Mono (n • 𝟙 (∐ Y)) := by
    intro I Y n hY
    have _hExColim : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u} := AB4OfSize.ofShape I
    let φ : Discrete.functor Y ⟶ Discrete.functor Y :=
      Discrete.natTrans (fun j_idx => n • 𝟙 (Y j_idx.as))
    have _hMonoApp : ∀ j_idx : Discrete I, CategoryTheory.Mono (φ.app j_idx) :=
      fun j_idx => hY j_idx.as
    have _hMonoφ : CategoryTheory.Mono φ := NatTrans.mono_of_mono_app φ
    exact Limits.colim.map_mono' φ
      (Limits.colimit.isColimit (Discrete.functor Y))
      (Limits.colimit.isColimit (Discrete.functor Y))
      (n • 𝟙 (∐ Y))
      (fun j_idx => by
        change Limits.Sigma.ι Y j_idx.as ≫ (n • 𝟙 (∐ Y)) =
          (n • 𝟙 (Y j_idx.as)) ≫ Limits.Sigma.ι Y j_idx.as
        rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
  have hMonoSigmaSh :
      ∀ {I : Type u} (Y : I → Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (n : ℕ),
        (∀ i : I, CategoryTheory.Mono (n • 𝟙 (Y i))) →
        CategoryTheory.Mono (n • 𝟙 (∐ Y)) := by
    intro I Y n hY
    have _hExColim : HasExactColimitsOfShape (Discrete I)
        (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
      AB4OfSize.ofShape I
    let φ : Discrete.functor Y ⟶ Discrete.functor Y :=
      Discrete.natTrans (fun j_idx => n • 𝟙 (Y j_idx.as))
    have _hMonoApp : ∀ j_idx : Discrete I, CategoryTheory.Mono (φ.app j_idx) :=
      fun j_idx => hY j_idx.as
    have _hMonoφ : CategoryTheory.Mono φ := NatTrans.mono_of_mono_app φ
    exact Limits.colim.map_mono' φ
      (Limits.colimit.isColimit (Discrete.functor Y))
      (Limits.colimit.isColimit (Discrete.functor Y))
      (n • 𝟙 (∐ Y))
      (fun j_idx => by
        change Limits.Sigma.ι Y j_idx.as ≫ (n • 𝟙 (∐ Y)) =
          (n • 𝟙 (Y j_idx.as)) ≫ Limits.Sigma.ι Y j_idx.as
        rw [Preadditive.comp_nsmul, Category.comp_id, Preadditive.nsmul_comp, Category.id_comp])
  have hInitTF : IsTF Fℤ := by
    intro n hn
    let Cℤ_fun : AddCommGrpCat.{u} ⥤ Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      (Functor.const (Opposite S.Etale)).comp
        (presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u})
    have _hLimCℤ : Limits.PreservesFiniteLimits Cℤ_fun := Limits.comp_preservesFiniteLimits _ _
    have _hAddCℤ : Cℤ_fun.Additive := Cℤ_fun.additive_of_preserves_binary_products
    have _hMonoN : CategoryTheory.Mono (n • 𝟙 Aℤ) := hMonoAℤ n hn
    have hmap : Cℤ_fun.map (n • 𝟙 Aℤ) = n • 𝟙 Fℤ := by
      rw [Functor.map_nsmul, Cℤ_fun.map_id]
      rfl
    rw [← hmap]
    exact Cℤ_fun.map_mono (n • 𝟙 Aℤ)
  have hSubTF : ∀ {K' P : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
      (ι : K' ⟶ P) [CategoryTheory.Mono ι],
      IsTF P → IsTF K' := by
    intro K' P ι _ hP n hn
    have _hMonoNP : CategoryTheory.Mono (n • 𝟙 P) := hP n hn
    refine ⟨fun {W_obj} u₁ u₂ hu => ?_⟩
    rw [← cancel_mono ι, ← cancel_mono (n • 𝟙 P)]
    have hL : (u₁ ≫ ι) ≫ (n • 𝟙 P) = (u₁ ≫ (n • 𝟙 K')) ≫ ι := by
      rw [Category.assoc, Preadditive.comp_nsmul, Category.comp_id,
        Category.assoc, Preadditive.nsmul_comp, Category.id_comp]
    have hR : (u₂ ≫ ι) ≫ (n • 𝟙 P) = (u₂ ≫ (n • 𝟙 K')) ≫ ι := by
      rw [Category.assoc, Preadditive.comp_nsmul, Category.comp_id,
        Category.assoc, Preadditive.nsmul_comp, Category.id_comp]
    rw [hL, hu, ← hR]
  let C₀ : Type u := SmallModel.{u} S.AffineEtale
  let e_sm := equivSmallModel.{u} S.AffineEtale
  let W_aff : C₀ → S.AffineEtale := fun x => e_sm.inverse.obj x
  let Y_aff : C₀ → Sheaf (AlgebraicGeometry.Scheme.AffineEtale.topology S) AddCommGrpCat.{u} :=
    fun x => Sheaf.freeYoneda (AlgebraicGeometry.Scheme.AffineEtale.topology S) (W_aff x) Aℤ
  have hTF_Y : ∀ (x : C₀) (n : ℕ), n ≠ 0 → CategoryTheory.Mono (n • 𝟙 (Y_aff x)) := by
    intro x n hn
    let P_x : Opposite S.AffineEtale ⥤ AddCommGrpCat.{u} := Presheaf.freeYoneda (W_aff x) Aℤ
    have _hMonoV : ∀ V : Opposite S.AffineEtale, CategoryTheory.Mono ((n • 𝟙 P_x).app V) := by
      intro V
      change CategoryTheory.Mono (n • 𝟙 (∐ fun _ : Opposite.unop V ⟶ W_aff x => Aℤ))
      exact hMonoSigmaGrp (fun _ => Aℤ) n (fun _ => hMonoAℤ n hn)
    have _hMonoPx : CategoryTheory.Mono (n • 𝟙 P_x) := NatTrans.mono_of_mono_app (n • 𝟙 P_x)
    let sh := presheafToSheaf (AlgebraicGeometry.Scheme.AffineEtale.topology S) AddCommGrpCat.{u}
    have _hAddSh : sh.Additive := sh.additive_of_preserves_binary_products
    have hmap : sh.map (n • 𝟙 P_x) = n • 𝟙 (Y_aff x) := by
      rw [Functor.map_nsmul, sh.map_id]
      rfl
    rw [← hmap]
    exact sh.map_mono (n • 𝟙 P_x)
  have hFreeNat :
      ∀ {X : S.AffineEtale}
        {A_sh B_sh : Sheaf (AlgebraicGeometry.Scheme.AffineEtale.topology S) AddCommGrpCat.{u}}
        (h : Sheaf.freeYoneda (AlgebraicGeometry.Scheme.AffineEtale.topology S) X Aℤ ⟶ A_sh)
        (f : A_sh ⟶ B_sh),
        Sheaf.freeYonedaHomEquiv (h ≫ f) =
          Sheaf.freeYonedaHomEquiv h ≫ f.hom.app (Opposite.op X) := by
    intro X A_sh B_sh h f
    let h₀ : (presheafToSheaf (AlgebraicGeometry.Scheme.AffineEtale.topology S)
        AddCommGrpCat.{u}).obj (Presheaf.freeYoneda X Aℤ) ⟶ A_sh := h
    change Presheaf.freeYonedaHomEquiv
        ((sheafificationAdjunction _ _).homEquiv _ B_sh (h₀ ≫ f)) =
      Presheaf.freeYonedaHomEquiv ((sheafificationAdjunction _ _).homEquiv _ A_sh h₀) ≫
        f.hom.app (Opposite.op X)
    rw [Adjunction.homEquiv_naturality_right]
    dsimp [Presheaf.freeYonedaHomEquiv]
    exact (Category.assoc _ _ _).symm
  let E_ℤ := AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S AddCommGrpCat.{u}
  have _hAddEℤ : E_ℤ.functor.Additive := E_ℤ.functor.additive_of_preserves_binary_products
  let Y_et : C₀ → Sheaf S.smallEtaleTopology AddCommGrpCat.{u} := fun x => E_ℤ.functor.obj (Y_aff x)
  have hTF_Yet : ∀ (x : C₀) (n : ℕ), n ≠ 0 → CategoryTheory.Mono (n • 𝟙 (Y_et x)) := by
    intro x n hn
    have _hMonoY : CategoryTheory.Mono (n • 𝟙 (Y_aff x)) := hTF_Y x n hn
    have hmap : E_ℤ.functor.map (n • 𝟙 (Y_aff x)) = n • 𝟙 (Y_et x) := by
      rw [Functor.map_nsmul, E_ℤ.functor.map_id]
    rw [← hmap]
    exact E_ℤ.functor.map_mono (n • 𝟙 (Y_aff x))
  let G_tf : Sheaf S.smallEtaleTopology AddCommGrpCat.{u} := ∐ Y_et
  have hTF_G : IsTF G_tf :=
    fun n hn => hMonoSigmaSh Y_et n (fun x => hTF_Yet x n hn)
  have hSep_G :
      ∀ {E₁ E₂ : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}} (u₁ u₂ : E₁ ⟶ E₂),
        (∀ g : G_tf ⟶ E₁, g ≫ u₁ = g ≫ u₂) → u₁ = u₂ := by
    intro E₁ E₂ u₁ u₂ hg
    apply E_ℤ.inverse.map_injective
    let A_sh := E_ℤ.inverse.obj E₁
    let B_sh := E_ℤ.inverse.obj E₂
    let f₁ : A_sh ⟶ B_sh := E_ℤ.inverse.map u₁
    let f₂ : A_sh ⟶ B_sh := E_ℤ.inverse.map u₂
    change f₁ = f₂
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V with
    | op U_aff =>
      ext a
      let x : C₀ := e_sm.functor.obj U_aff
      let σ_U : U_aff ≅ W_aff x := e_sm.unitIso.app U_aff
      let a' : A_sh.obj.obj (Opposite.op (W_aff x)) := A_sh.obj.map σ_U.inv.op a
      let α_a' : Aℤ ⟶ A_sh.obj.obj (Opposite.op (W_aff x)) :=
        AddCommGrpCat.ofHom
          { toFun := fun z => z.down • a'
            map_zero' := zero_zsmul a'
            map_add' := fun z₁ z₂ => add_zsmul a' z₁.down z₂.down }
      let h_x : Y_aff x ⟶ A_sh := Sheaf.freeYonedaHomEquiv.symm α_a'
      let h_et : Y_et x ⟶ E₁ := (E_ℤ.toAdjunction.homEquiv (Y_aff x) E₁).symm h_x
      classical
      let g : G_tf ⟶ E₁ := Limits.Sigma.desc fun y =>
        if h : y = x then eqToHom (congrArg Y_et h) ≫ h_et else 0
      have hιg : Limits.Sigma.ι Y_et x ≫ g = h_et := by
        dsimp [g]
        rw [Limits.Sigma.ι_comp_desc]
        simp only [↓reduceDIte, eqToHom_refl, Category.id_comp]
      have het_eq : h_et ≫ u₁ = h_et ≫ u₂ := by
        calc
          h_et ≫ u₁ = (Limits.Sigma.ι Y_et x ≫ g) ≫ u₁ := by rw [hιg]
          _ = Limits.Sigma.ι Y_et x ≫ (g ≫ u₁) := Category.assoc _ _ _
          _ = Limits.Sigma.ι Y_et x ≫ (g ≫ u₂) := by rw [hg g]
          _ = (Limits.Sigma.ι Y_et x ≫ g) ≫ u₂ := (Category.assoc _ _ _).symm
          _ = h_et ≫ u₂ := by rw [hιg]
      have hx_eq : h_x ≫ f₁ = h_x ≫ f₂ := by
        have := congrArg (E_ℤ.toAdjunction.homEquiv (Y_aff x) E₂) het_eq
        rw [E_ℤ.toAdjunction.homEquiv_naturality_right,
          E_ℤ.toAdjunction.homEquiv_naturality_right,
          Equiv.apply_symm_apply] at this
        exact this
      have hAppW : α_a' ≫ f₁.hom.app (Opposite.op (W_aff x)) =
          α_a' ≫ f₂.hom.app (Opposite.op (W_aff x)) := by
        have := congrArg Sheaf.freeYonedaHomEquiv hx_eq
        rw [hFreeNat, hFreeNat, Equiv.apply_symm_apply] at this
        exact this
      have ha'_eq : (f₁.hom.app (Opposite.op (W_aff x))).hom a' =
          (f₂.hom.app (Opposite.op (W_aff x))).hom a' := by
        have h1 := ConcreteCategory.congr_hom hAppW (ULift.up (1 : ℤ))
        change (f₁.hom.app (Opposite.op (W_aff x))).hom ((1 : ℤ) • a') =
          (f₂.hom.app (Opposite.op (W_aff x))).hom ((1 : ℤ) • a') at h1
        rwa [one_zsmul] at h1
      have ha_back : (A_sh.obj.map σ_U.hom.op).hom a' = a := by
        change ((A_sh.obj.map σ_U.inv.op ≫ A_sh.obj.map σ_U.hom.op).hom) a = a
        rw [← A_sh.obj.map_comp, ← op_comp, σ_U.hom_inv_id, op_id, A_sh.obj.map_id]
        rfl
      have hnat₁ := ConcreteCategory.congr_hom (f₁.hom.naturality σ_U.hom.op) a'
      have hnat₂ := ConcreteCategory.congr_hom (f₂.hom.naturality σ_U.hom.op) a'
      change (f₁.hom.app (Opposite.op U_aff)).hom ((A_sh.obj.map σ_U.hom.op).hom a') =
        (B_sh.obj.map σ_U.hom.op).hom ((f₁.hom.app (Opposite.op (W_aff x))).hom a') at hnat₁
      change (f₂.hom.app (Opposite.op U_aff)).hom ((A_sh.obj.map σ_U.hom.op).hom a') =
        (B_sh.obj.map σ_U.hom.op).hom ((f₂.hom.app (Opposite.op (W_aff x))).hom a') at hnat₂
      rw [ha_back] at hnat₁ hnat₂
      rw [hnat₁, ha'_eq, ← hnat₂]
  have hCoverTF : ∀ E : Sheaf S.smallEtaleTopology AddCommGrpCat.{u},
      ∃ (P : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (π : P ⟶ E),
        CategoryTheory.Epi π ∧ IsTF P := by
    intro E
    let I : Type u := Shrink.{u} (G_tf ⟶ E)
    let P : Sheaf S.smallEtaleTopology AddCommGrpCat.{u} := ∐ fun _ : I => G_tf
    let π : P ⟶ E := Limits.Sigma.desc fun i : I => (equivShrink.{u} (G_tf ⟶ E)).symm i
    have hTF_P : IsTF P :=
      fun n hn => hMonoSigmaSh (fun _ : I => G_tf) n (fun _ => hTF_G n hn)
    have hEpi_π : CategoryTheory.Epi π := by
      refine ⟨fun {E'} u₁ u₂ hu => hSep_G u₁ u₂ fun g => ?_⟩
      let i : I := equivShrink.{u} (G_tf ⟶ E) g
      have hi : Limits.Sigma.ι (fun _ : I => G_tf) i ≫ π = g := by
        dsimp [π]
        rw [Limits.Sigma.ι_comp_desc, Equiv.symm_apply_apply]
      calc
        g ≫ u₁ = (Limits.Sigma.ι (fun _ : I => G_tf) i ≫ π) ≫ u₁ := by rw [hi]
        _ = Limits.Sigma.ι (fun _ : I => G_tf) i ≫ (π ≫ u₁) := Category.assoc _ _ _
        _ = Limits.Sigma.ι (fun _ : I => G_tf) i ≫ (π ≫ u₂) := by rw [hu]
        _ = (Limits.Sigma.ι (fun _ : I => G_tf) i ≫ π) ≫ u₂ := (Category.assoc _ _ _).symm
        _ = g ≫ u₂ := by rw [hi]
    exact ⟨P, π, hEpi_π, hTF_P⟩

  
  
  
  
  have hValCast : ∀ r : R, ((r.down.valMinAbs : ℤ) : R) = r := by
    intro r
    ext
    exact ZMod.coe_valMinAbs r.down
  have hModSmul : ∀ {E : ModuleCat.{u, u} R} (r : R) (x : E),
      r • x = (r.down.valMinAbs : ℤ) • x := by
    intro E r x
    conv_lhs => rw [← hValCast r]
    exact Int.cast_smul_eq_zsmul R r.down.valMinAbs x
  let ffFgt : FgtMod.FullyFaithful :=
    { preimage := fun {E₁ E₂} φ =>
        ModuleCat.ofHom
          { toAddHom := φ.hom.toAddHom
            map_smul' := fun r x => by
              let x₁ : E₁ := x
              let y₂ : E₂ := φ.hom x₁
              change φ.hom (r • x₁) = r • y₂
              rw [hModSmul r x₁, hModSmul r y₂]
              exact map_zsmul φ.hom r.down.valMinAbs x₁ }
      map_preimage := fun φ => by ext x; rfl
      preimage_map := fun ψ => by apply ModuleCat.hom_ext; ext x; rfl }
  let ffU : U.FullyFaithful :=
    { preimage := fun {F₁ F₂} φ =>
        ⟨{ app := fun W => ffFgt.preimage (φ.hom.app W)
           naturality := fun W₁ W₂ u => by
             apply ModuleCat.hom_ext
             ext x
             exact ConcreteCategory.congr_hom (φ.hom.naturality u) x }⟩
      map_preimage := fun φ => Sheaf.hom_ext <| NatTrans.ext <| funext fun W => by
        ext x; rfl
      preimage_map := fun ψ => Sheaf.hom_ext <| NatTrans.ext <| funext fun W => by
        apply ModuleCat.hom_ext; ext x; rfl }
  have _hFaithfulU : U.Faithful := ffU.faithful
  have hLiftSheaf :
      ∀ (B : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}), m • 𝟙 B = 0 →
        ∃ (B_tilde : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)),
          Nonempty (U.obj B_tilde ≅ B) := by
    intro B hAnnB
    have hAnnSec : ∀ (W : Opposite S.Etale) (x : B.obj.obj W), m • x = 0 := by
      intro W x
      exact ConcreteCategory.congr_hom (congrArg (fun f => f.hom.app W) hAnnB) x
    have hZsmulEq : ∀ (W : Opposite S.Etale) (z₁ z₂ : ℤ) (x : B.obj.obj W),
        (z₁ : ZMod m) = (z₂ : ZMod m) → z₁ • x = z₂ • x := by
      intro W z₁ z₂ x hz
      obtain ⟨q, hq⟩ := (ZMod.intCast_eq_intCast_iff_dvd_sub z₁ z₂ m).mp hz
      calc
        z₁ • x = z₁ • x + 0 := (add_zero _).symm
        _ = z₁ • x + (z₂ - z₁) • x := by
            rw [hq, mul_comm, mul_zsmul, natCast_zsmul, hAnnSec W x, smul_zero]
        _ = (z₁ + (z₂ - z₁)) • x := (add_zsmul x z₁ (z₂ - z₁)).symm
        _ = z₂ • x := by rw [add_sub_cancel]
    let instModB : ∀ W : Opposite S.Etale, Module R (B.obj.obj W) := fun W =>
      { smul := fun r x => (r.down.valMinAbs : ℤ) • x
        one_smul := fun x => by
          change (((1 : R).down.valMinAbs : ℤ) • x) = x
          rw [hZsmulEq W _ 1 x (by rw [ZMod.coe_valMinAbs, Int.cast_one]; rfl), one_zsmul]
        mul_smul := fun r s x => by
          change (((r * s).down.valMinAbs : ℤ) • x) =
            (r.down.valMinAbs : ℤ) • ((s.down.valMinAbs : ℤ) • x)
          rw [← mul_zsmul]
          exact hZsmulEq W _ _ x (by
            rw [ZMod.coe_valMinAbs, Int.cast_mul, ZMod.coe_valMinAbs, ZMod.coe_valMinAbs]; rfl)
        smul_zero := fun r => zsmul_zero _
        smul_add := fun r x y => smul_add (r.down.valMinAbs : ℤ) x y
        add_smul := fun r s x => by
          change (((r + s).down.valMinAbs : ℤ) • x) =
            (r.down.valMinAbs : ℤ) • x + (s.down.valMinAbs : ℤ) • x
          rw [← add_zsmul]
          exact hZsmulEq W _ _ x (by
            rw [ZMod.coe_valMinAbs, Int.cast_add, ZMod.coe_valMinAbs, ZMod.coe_valMinAbs]; rfl)
        zero_smul := fun x => by
          change (((0 : R).down.valMinAbs : ℤ) • x) = 0
          rw [hZsmulEq W _ 0 x (by rw [ZMod.coe_valMinAbs, Int.cast_zero]; rfl), zero_zsmul] }
    let modObj : ∀ W : Opposite S.Etale, ModuleCat.{u, u} R :=
      fun W => @ModuleCat.of R _ (B.obj.obj W) _ (instModB W)
    let P_tilde : Opposite S.Etale ⥤ ModuleCat.{u, u} R :=
      { obj := modObj
        map := fun {W₁ W₂} u =>
          ModuleCat.ofHom
            ({ toFun := fun x => (B.obj.map u).hom x
               map_add' := fun x y => map_add (B.obj.map u).hom x y
               map_smul' := fun r x => map_zsmul (B.obj.map u).hom r.down.valMinAbs x } :
              modObj W₁ →ₗ[R] modObj W₂)
        map_id := fun W => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          change (B.obj.map (𝟙 W)).hom x = x
          rw [B.obj.map_id]
          rfl
        map_comp := fun {W₁ W₂ W₃} u v => by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro x
          change (B.obj.map (u ≫ v)).hom x = (B.obj.map v).hom ((B.obj.map u).hom x)
          rw [B.obj.map_comp]
          rfl }
    have hIsSheaf : Presheaf.IsSheaf S.smallEtaleTopology P_tilde := by
      intro E
      have hIso : (B.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E))) ≅
          (P_tilde ⋙ coyoneda.obj (Opposite.op E)) :=
        NatIso.ofComponents
          (fun W =>
            Equiv.toIso
              { toFun := fun g => ffFgt.preimage (g ≫ AddCommGrpCat.ofHom (AddMonoidHom.id _))
                invFun := fun f => FgtMod.map f ≫ AddCommGrpCat.ofHom (AddMonoidHom.id _)
                left_inv := fun g => by dsimp; ext x; rfl
                right_inv := fun f => by
                  apply ModuleCat.hom_ext
                  apply LinearMap.ext
                  intro x
                  rfl })
          (fun {W₁ W₂} u => by
            ext g
            apply ModuleCat.hom_ext
            apply LinearMap.ext
            intro x
            rfl)
      exact Presieve.isSheaf_iso S.smallEtaleTopology hIso (B.property (FgtMod.obj E))
    let B_tilde : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) := ⟨P_tilde, hIsSheaf⟩
    let isoB : U.obj B_tilde ≅ B :=
      { hom := ⟨{ app := fun W => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                  naturality := fun _ _ _ => by ext x; rfl }⟩
        inv := ⟨{ app := fun W => AddCommGrpCat.ofHom (AddMonoidHom.id _)
                  naturality := fun _ _ _ => by ext x; rfl }⟩
        hom_inv_id := Sheaf.hom_ext <| NatTrans.ext <| funext fun W => by ext x; rfl
        inv_hom_id := Sheaf.hom_ext <| NatTrans.ext <| funext fun W => by ext x; rfl }
    exact ⟨B_tilde, ⟨isoB⟩⟩
  have hmR : ((m : ℕ) : R) = 0 := by
    ext
    exact ZMod.natCast_self m
  have hExtInj :
      ∀ (I_mod : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
        [CategoryTheory.Injective I_mod]
        (S_ex : ShortComplex (Sheaf S.smallEtaleTopology AddCommGrpCat.{u})),
        S_ex.ShortExact → IsTF S_ex.X₃ →
        ∀ g₀ : S_ex.X₁ ⟶ U.obj I_mod, ∃ h : S_ex.X₂ ⟶ U.obj I_mod, S_ex.f ≫ h = g₀ := by
    intro I_mod _ S_ex hEx hTF g₀
    let B₁ := Limits.cokernel (m • 𝟙 S_ex.X₁)
    let p₁ : S_ex.X₁ ⟶ B₁ := Limits.cokernel.π (m • 𝟙 S_ex.X₁)
    let B₂ := Limits.cokernel (m • 𝟙 S_ex.X₂)
    let p₂ : S_ex.X₂ ⟶ B₂ := Limits.cokernel.π (m • 𝟙 S_ex.X₂)
    have hcond_f : (m • 𝟙 S_ex.X₁) ≫ (S_ex.f ≫ p₂) = 0 := by
      have hcomm : (m • 𝟙 S_ex.X₁) ≫ S_ex.f = S_ex.f ≫ (m • 𝟙 S_ex.X₂) := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
      rw [← Category.assoc, hcomm, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let i_bar : B₁ ⟶ B₂ := Limits.cokernel.desc (m • 𝟙 S_ex.X₁) (S_ex.f ≫ p₂) hcond_f
    have hp_ibar : p₁ ≫ i_bar = S_ex.f ≫ p₂ := Limits.cokernel.π_desc _ _ _
    have _hMono_ibar : CategoryTheory.Mono i_bar := by
      apply CategoryTheory.Abelian.Pseudoelement.mono_of_zero_of_map_zero
      intro a_bar ha_bar
      obtain ⟨a, rfl⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_surjective_of_epi p₁ a_bar
      have hp₂_fa : CategoryTheory.Abelian.Pseudoelement.pseudoApply p₂
          (CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.f a) = 0 := by
        rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, ← hp_ibar,
          CategoryTheory.Abelian.Pseudoelement.comp_apply, ha_bar]
      obtain ⟨b, hb⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact
        (ShortComplex.exact_cokernel (m • 𝟙 S_ex.X₂)) _ hp₂_fa
      change CategoryTheory.Abelian.Pseudoelement.pseudoApply (m • 𝟙 S_ex.X₂) b =
        CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.f a at hb
      have _hMonoSf : CategoryTheory.Mono S_ex.f := hEx.mono_f
      by_cases hm : m = 0
      · subst hm
        rw [zero_smul, CategoryTheory.Abelian.Pseudoelement.zero_apply] at hb
        have ha0 : a = 0 :=
          CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero S_ex.f
            (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono S_ex.f) a hb.symm
        rw [ha0, CategoryTheory.Abelian.Pseudoelement.apply_zero]
      · have _hMonoX3 : CategoryTheory.Mono (m • 𝟙 S_ex.X₃) := hTF m hm
        have hcomm_g : (m • 𝟙 S_ex.X₂) ≫ S_ex.g = S_ex.g ≫ (m • 𝟙 S_ex.X₃) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        have hgb_m : CategoryTheory.Abelian.Pseudoelement.pseudoApply (m • 𝟙 S_ex.X₃)
            (CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.g b) = 0 := by
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, ← hcomm_g,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hb,
            ← CategoryTheory.Abelian.Pseudoelement.comp_apply, S_ex.zero,
            CategoryTheory.Abelian.Pseudoelement.zero_apply]
        have hgb : CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.g b = 0 :=
          CategoryTheory.Abelian.Pseudoelement.zero_of_map_zero (m • 𝟙 S_ex.X₃)
            (CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono _) _ hgb_m
        obtain ⟨c, hc⟩ := CategoryTheory.Abelian.Pseudoelement.pseudo_exact_of_exact hEx.exact b hgb
        have hcomm_f : (m • 𝟙 S_ex.X₁) ≫ S_ex.f = S_ex.f ≫ (m • 𝟙 S_ex.X₂) := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
        have hmc : CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.f
            (CategoryTheory.Abelian.Pseudoelement.pseudoApply (m • 𝟙 S_ex.X₁) c) =
            CategoryTheory.Abelian.Pseudoelement.pseudoApply S_ex.f a := by
          rw [← CategoryTheory.Abelian.Pseudoelement.comp_apply, hcomm_f,
            CategoryTheory.Abelian.Pseudoelement.comp_apply, hc, hb]
        have hca : CategoryTheory.Abelian.Pseudoelement.pseudoApply (m • 𝟙 S_ex.X₁) c = a :=
          CategoryTheory.Abelian.Pseudoelement.pseudo_injective_of_mono S_ex.f hmc
        rw [← hca, ← CategoryTheory.Abelian.Pseudoelement.comp_apply,
          Limits.cokernel.condition, CategoryTheory.Abelian.Pseudoelement.zero_apply]
    have hAnnB₁ : m • 𝟙 B₁ = 0 := by
      rw [← cancel_epi p₁, Preadditive.comp_nsmul, Category.comp_id,
        ← Category.id_comp p₁, ← Preadditive.nsmul_comp, Category.id_comp,
        Limits.cokernel.condition, Limits.comp_zero]
    have hAnnB₂ : m • 𝟙 B₂ = 0 := by
      rw [← cancel_epi p₂, Preadditive.comp_nsmul, Category.comp_id,
        ← Category.id_comp p₂, ← Preadditive.nsmul_comp, Category.id_comp,
        Limits.cokernel.condition, Limits.comp_zero]
    have hAnnUI : m • 𝟙 (U.obj I_mod) = 0 := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext W
      ext y
      let y' : I_mod.obj.obj W := y
      change m • y' = 0
      rw [← Nat.cast_smul_eq_nsmul R m y', hmR, zero_smul]
    have hcond_g₀ : (m • 𝟙 S_ex.X₁) ≫ g₀ = 0 := by
      have hcomm : (m • 𝟙 S_ex.X₁) ≫ g₀ = g₀ ≫ (m • 𝟙 (U.obj I_mod)) := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, Category.comp_id]
      rw [hcomm, hAnnUI, Limits.comp_zero]
    let g_bar₀ : B₁ ⟶ U.obj I_mod := Limits.cokernel.desc (m • 𝟙 S_ex.X₁) g₀ hcond_g₀
    have hp_gbar₀ : p₁ ≫ g_bar₀ = g₀ := Limits.cokernel.π_desc _ _ _
    obtain ⟨B₁_tilde, ⟨e₁⟩⟩ := hLiftSheaf B₁ hAnnB₁
    obtain ⟨B₂_tilde, ⟨e₂⟩⟩ := hLiftSheaf B₂ hAnnB₂
    let i_tilde : B₁_tilde ⟶ B₂_tilde := ffU.preimage (e₁.hom ≫ i_bar ≫ e₂.inv)
    have hU_itilde : U.map i_tilde = e₁.hom ≫ i_bar ≫ e₂.inv := ffU.map_preimage _
    have _hMonoU : CategoryTheory.Mono (U.map i_tilde) := by
      rw [hU_itilde]
      exact mono_comp _ _
    have _hMonoTilde : CategoryTheory.Mono i_tilde := Functor.mono_of_mono_map U inferInstance
    let g₀_tilde : B₁_tilde ⟶ I_mod := ffU.preimage (e₁.hom ≫ g_bar₀)
    have hU_g₀tilde : U.map g₀_tilde = e₁.hom ≫ g_bar₀ := ffU.map_preimage _
    let h_tilde : B₂_tilde ⟶ I_mod := CategoryTheory.Injective.factorThru g₀_tilde i_tilde
    have hfac : i_tilde ≫ h_tilde = g₀_tilde :=
      CategoryTheory.Injective.comp_factorThru g₀_tilde i_tilde
    refine ⟨p₂ ≫ e₂.inv ≫ U.map h_tilde, ?_⟩
    calc
      S_ex.f ≫ p₂ ≫ e₂.inv ≫ U.map h_tilde
        = (S_ex.f ≫ p₂) ≫ e₂.inv ≫ U.map h_tilde := (Category.assoc _ _ _).symm
      _ = (p₁ ≫ i_bar) ≫ e₂.inv ≫ U.map h_tilde := by rw [hp_ibar]
      _ = p₁ ≫ (e₁.inv ≫ e₁.hom) ≫ i_bar ≫ e₂.inv ≫ U.map h_tilde := by
          rw [e₁.inv_hom_id, Category.id_comp, Category.assoc]
      _ = p₁ ≫ e₁.inv ≫ (e₁.hom ≫ i_bar ≫ e₂.inv) ≫ U.map h_tilde := by
          simp only [Category.assoc]
      _ = p₁ ≫ e₁.inv ≫ U.map i_tilde ≫ U.map h_tilde := by rw [hU_itilde]
      _ = p₁ ≫ e₁.inv ≫ U.map (i_tilde ≫ h_tilde) := by rw [← U.map_comp]
      _ = p₁ ≫ e₁.inv ≫ e₁.hom ≫ g_bar₀ := by rw [hfac, hU_g₀tilde]
      _ = p₁ ≫ (e₁.inv ≫ e₁.hom) ≫ g_bar₀ := by simp only [Category.assoc]
      _ = p₁ ≫ g_bar₀ := by rw [e₁.inv_hom_id, Category.id_comp]
      _ = g₀ := hp_gbar₀

  
  
  
  have hAcyclic :
      ∀ (I_mod : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R))
        [CategoryTheory.Injective I_mod]
        (d : ℕ) (K : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}),
        IsTF K →
        ∀ e : CategoryTheory.Abelian.Ext.{u} K (U.obj I_mod) (d + 1), e = 0 := by
    intro I_mod _
    let R_I := CategoryTheory.InjectiveResolution.of (U.obj I_mod)
    have hEfface :
        ∀ (d : ℕ) (K : Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
          (e : CategoryTheory.Abelian.Ext.{u} K (U.obj I_mod) (d + 1)),
          ∃ (P : Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) (π : P ⟶ K),
            CategoryTheory.Epi π ∧ IsTF P ∧
            (CategoryTheory.Abelian.Ext.mk₀ π).comp e (Nat.zero_add (d + 1)) = 0 := by
      intro d K e
      obtain ⟨f, hf, rfl⟩ := R_I.extMk_surjective e (d + 2) rfl
      have hEx_d := R_I.exact_succ d
      set S_d : ShortComplex (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
        ShortComplex.mk (R_I.cocomplex.d d (d + 1)) (R_I.cocomplex.d (d + 1) (d + 2))
          (R_I.cocomplex.d_comp_d d (d + 1) (d + 2))
      have hExact_Sd : S_d.Exact := hEx_d
      have _hEpiCyc : CategoryTheory.Epi S_d.toCycles := hExact_Sd.epi_toCycles
      let f_cyc : K ⟶ S_d.cycles := S_d.liftCycles f hf
      let PB := Limits.pullback S_d.toCycles f_cyc
      let p_X : PB ⟶ R_I.cocomplex.X d := Limits.pullback.fst S_d.toCycles f_cyc
      let p_K : PB ⟶ K := Limits.pullback.snd S_d.toCycles f_cyc
      have _hEpiPK : CategoryTheory.Epi p_K := CategoryTheory.Abelian.epi_pullback_of_epi_f _ _
      obtain ⟨P, q_P, _hEpi_q, hTF_P⟩ := hCoverTF PB
      let π : P ⟶ K := q_P ≫ p_K
      have _hEpiPi : CategoryTheory.Epi π := epi_comp q_P p_K
      let g : P ⟶ R_I.cocomplex.X d := q_P ≫ p_X
      have hg_eq : g ≫ R_I.cocomplex.d d (d + 1) = π ≫ f := by
        calc
          (q_P ≫ p_X) ≫ R_I.cocomplex.d d (d + 1)
            = q_P ≫ p_X ≫ (S_d.toCycles ≫ S_d.iCycles) := by
              rw [S_d.toCycles_i, Category.assoc]
          _ = q_P ≫ (p_X ≫ S_d.toCycles) ≫ S_d.iCycles := by simp only [Category.assoc]
          _ = q_P ≫ (p_K ≫ f_cyc) ≫ S_d.iCycles := by rw [Limits.pullback.condition]
          _ = (q_P ≫ p_K) ≫ (f_cyc ≫ S_d.iCycles) := by simp only [Category.assoc]
          _ = π ≫ f := by rw [S_d.liftCycles_i]
      refine ⟨P, π, _hEpiPi, hTF_P, ?_⟩
      rw [R_I.mk₀_comp_extMk f (d + 2) rfl hf π]
      exact (R_I.extMk_eq_zero_iff (π ≫ f) (d + 2) rfl _ d rfl).mpr ⟨g, hg_eq⟩
    intro d
    induction d with
    | zero =>
      intro K hTF_K e
      obtain ⟨P, π, hEpi_π, _, hπ_e⟩ := hEfface 0 K e
      let S_π : ShortComplex (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
        ShortComplex.mk (Limits.kernel.ι π) π (Limits.kernel.condition π)
      have hS_π : S_π.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel π) inferInstance hEpi_π
      obtain ⟨x₀, hx₀⟩ :=
        CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hS_π (U.obj I_mod) e hπ_e
          (Nat.add_zero 1)
      obtain ⟨g₀, rfl⟩ := CategoryTheory.Abelian.Ext.mk₀_bijective S_π.X₁ (U.obj I_mod) |>.2 x₀
      obtain ⟨h, hh⟩ := hExtInj I_mod S_π hS_π hTF_K g₀
      rw [← hx₀, ← hh, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
          (Nat.add_zero 1) (Nat.zero_add 0) (Nat.add_zero 1),
        hS_π.extClass_comp, CategoryTheory.Abelian.Ext.zero_comp]
    | succ d ih =>
      intro K _ e
      obtain ⟨P, π, hEpi_π, hTF_P, hπ_e⟩ := hEfface (d + 1) K e
      let S_π : ShortComplex (Sheaf S.smallEtaleTopology AddCommGrpCat.{u}) :=
        ShortComplex.mk (Limits.kernel.ι π) π (Limits.kernel.condition π)
      have hS_π : S_π.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel π) inferInstance hEpi_π
      have hTF_ker : IsTF S_π.X₁ := @hSubTF _ _ S_π.f hS_π.mono_f hTF_P
      obtain ⟨x₁, hx₁⟩ :=
        CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hS_π (U.obj I_mod) e hπ_e
          (by omega : 1 + (d + 1) = d + 2)
      rw [← hx₁, ih S_π.X₁ hTF_ker x₁, CategoryTheory.Abelian.Ext.comp_zero]
  have hGenBij : ∀ (k : ℕ) (F_sh : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)),
      Function.Bijective (Θ F_sh k) := by
    intro k
    induction k with
    | zero =>
      intro F_sh
      exact hBase0 F_sh
    | succ k ih =>
      intro F_sh
      let I_mod : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) :=
        CategoryTheory.Injective.under F_sh
      have _hInjI : CategoryTheory.Injective I_mod := CategoryTheory.Injective.injective_under F_sh
      let i_F : F_sh ⟶ I_mod := CategoryTheory.Injective.ι F_sh
      have _hMonoIF : CategoryTheory.Mono i_F := CategoryTheory.Injective.ι_mono F_sh
      let Q_mod : Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R) := Limits.cokernel i_F
      let p_F : I_mod ⟶ Q_mod := Limits.cokernel.π i_F
      have _hEpiPF : CategoryTheory.Epi p_F := CategoryTheory.Limits.coequalizer.π_epi
      let S_F : ShortComplex (Sheaf S.smallEtaleTopology (ModuleCat.{u, u} R)) :=
        ShortComplex.mk i_F p_F (Limits.cokernel.condition i_F)
      have hS_F : S_F.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel i_F) _hMonoIF _hEpiPF
      have hUS_F : (S_F.map U).ShortExact := hS_F.map_of_exact U
      have hΘ_map :
          ∀ (x : CategoryTheory.Abelian.Ext.{u} oneR I_mod k),
            Θ Q_mod k (x.comp (CategoryTheory.Abelian.Ext.mk₀ S_F.g) (Nat.add_zero k)) =
              (Θ I_mod k x).comp (CategoryTheory.Abelian.Ext.mk₀ (S_F.map U).g) (Nat.add_zero k) := by
        intro x
        change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U
              (x.comp (CategoryTheory.Abelian.Ext.mk₀ S_F.g) (Nat.add_zero k)))
            (Nat.zero_add k) =
          ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U x) (Nat.zero_add k)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (U.map S_F.g)) (Nat.add_zero k)
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add k) (Nat.add_zero k) (Nat.zero_add k)]
      have hΘ_delta :
          ∀ (z : CategoryTheory.Abelian.Ext.{u} oneR Q_mod k),
            Θ F_sh (k + 1) (z.comp hS_F.extClass rfl) =
              (Θ Q_mod k z).comp hUS_F.extClass rfl := by
        intro z
        change (CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U (z.comp hS_F.extClass rfl))
            (Nat.zero_add (k + 1)) =
          ((CategoryTheory.Abelian.Ext.mk₀ ηℤ).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor U z) (Nat.zero_add k)).comp
            hUS_F.extClass rfl
        rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add k) rfl (Nat.zero_add (k + 1))]
      refine ⟨?_, ?_⟩
      · rw [injective_iff_map_eq_zero]
        intro x₁ hx₁
        have _hDimI : CategoryTheory.HasInjectiveDimensionLT I_mod 1 :=
          CategoryTheory.instHasInjectiveDimensionLTOfNatNatOfInjective I_mod
        have hx₁_i : x₁.comp (CategoryTheory.Abelian.Ext.mk₀ S_F.f) (Nat.add_zero (k + 1)) = 0 :=
          (CategoryTheory.hasInjectiveDimensionLT_iff I_mod 1).mp _hDimI (k + 1)
            (Nat.le_add_left 1 k) _
        obtain ⟨x₃, hx₃⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ oneR hS_F x₁ hx₁_i rfl
        have hΘx₃_delta : (Θ Q_mod k x₃).comp hUS_F.extClass rfl = 0 := by
          rw [← hΘ_delta x₃, hx₃, hx₁]
        obtain ⟨y₂, hy₂⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ hUS_F (Θ Q_mod k x₃) rfl hΘx₃_delta
        obtain ⟨x₂, hx₂⟩ := (ih I_mod).2 y₂
        have hx₂_p : x₂.comp (CategoryTheory.Abelian.Ext.mk₀ S_F.g) (Nat.add_zero k) = x₃ := by
          apply (ih Q_mod).1
          rw [hΘ_map x₂, hx₂, hy₂]
        rw [← hx₃, ← hx₂_p,
          CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero k) (Nat.zero_add 1) rfl,
          hS_F.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
      · intro y₁
        have hy₁_i : y₁.comp (CategoryTheory.Abelian.Ext.mk₀ (S_F.map U).f) (Nat.add_zero (k + 1)) = 0 :=
          hAcyclic I_mod k Fℤ hInitTF _
        obtain ⟨y₃, hy₃⟩ :=
          CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ hUS_F y₁ hy₁_i rfl
        obtain ⟨x₃, hx₃⟩ := (ih Q_mod).2 y₃
        refine ⟨x₃.comp hS_F.extClass rfl, ?_⟩
        rw [hΘ_delta x₃, hx₃, hy₃]

  
  
  
  have hPostBij : Function.Bijective
      ((CategoryTheory.Abelian.Ext.mk₀ βM).postcomp Fℤ (Nat.add_zero j)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨(CategoryTheory.Abelian.Ext.mk₀ αM).postcomp Fℤ (Nat.add_zero j), fun x => ?_, fun y => ?_⟩
    · change (x.comp (CategoryTheory.Abelian.Ext.mk₀ βM) (Nat.add_zero j)).comp
        (CategoryTheory.Abelian.Ext.mk₀ αM) (Nat.add_zero j) = x
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero j) (Nat.zero_add 0) (Nat.add_zero j),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hβα,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
    · change (y.comp (CategoryTheory.Abelian.Ext.mk₀ αM) (Nat.add_zero j)).comp
        (CategoryTheory.Abelian.Ext.mk₀ βM) (Nat.add_zero j) = y
      rw [CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero j) (Nat.zero_add 0) (Nat.add_zero j),
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hαβ,
        CategoryTheory.Abelian.Ext.comp_mk₀_id]
  exact ⟨⟨θ, hθ_comp, hPostBij.comp (hGenBij j oneR)⟩,
    fun θ₁ θ₂ h₁ h₂ => (hEqCanon θ₁ h₁).trans (hEqCanon θ₂ h₂).symm⟩

theorem weil_cupPD_pullback_ext_comp_compat (hModInj : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
      (θ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
      WeilCupPDIsModComparison S m j θ → Function.Injective θ)
    (hModUniq : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
      (θ₁ θ₂ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
      WeilCupPDIsModComparison S m j θ₁ →
      WeilCupPDIsModComparison S m j θ₂ →
      θ₁ = θ₂)
    {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
    (m i j c : ℕ) (hc : i + j = c)
    (p_i : weilEtaleTorsionH S₂ m i →+ weilEtaleTorsionH S₁ m i)
    (p_j : weilEtaleTorsionH S₂ m j →+ weilEtaleTorsionH S₁ m j)
    (p_c : weilEtaleTorsionH S₂ m c →+ weilEtaleTorsionH S₁ m c)
    (θ₂_i : weilCupPDModH S₂ m i →+ weilEtaleTorsionH S₂ m i)
    (θ₁_i : weilCupPDModH S₁ m i →+ weilEtaleTorsionH S₁ m i)
    (θ₂_j : weilCupPDModH S₂ m j →+ weilEtaleTorsionH S₂ m j)
    (θ₁_j : weilCupPDModH S₁ m j →+ weilEtaleTorsionH S₁ m j)
    (θ₂_c : weilCupPDModH S₂ m c →+ weilEtaleTorsionH S₂ m c)
    (θ₁_c : weilCupPDModH S₁ m c →+ weilEtaleTorsionH S₁ m c)
    (hp_i : WeilIsTorsionEtalePullback h m i p_i)
    (hp_j : WeilIsTorsionEtalePullback h m j p_j)
    (hp_c : WeilIsTorsionEtalePullback h m c p_c)
    (hθ₂_i : WeilCupPDIsModComparison S₂ m i θ₂_i)
    (hθ₁_i : WeilCupPDIsModComparison S₁ m i θ₁_i)
    (hθ₂_j : WeilCupPDIsModComparison S₂ m j θ₂_j)
    (hθ₁_j : WeilCupPDIsModComparison S₁ m j θ₁_j)
    (hθ₂_c : WeilCupPDIsModComparison S₂ m c θ₂_c)
    (hθ₁_c : WeilCupPDIsModComparison S₁ m c θ₁_c)
    (a₂ : weilCupPDModH S₂ m i) (b₂ : weilCupPDModH S₂ m j)
    (a₁ : weilCupPDModH S₁ m i) (b₁ : weilCupPDModH S₁ m j)
    (ha : p_i (θ₂_i a₂) = θ₁_i a₁)
    (hb : p_j (θ₂_j b₂) = θ₁_j b₁) :
    p_c (θ₂_c (CategoryTheory.Abelian.Ext.comp a₂ b₂ hc)) =
      θ₁_c (CategoryTheory.Abelian.Ext.comp a₁ b₁ hc) :=
by
  
  
  
  have hMapComp :
      ∀ {C₁ C₂ C₃ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1} C₁] [CategoryTheory.Abelian C₁]
        [CategoryTheory.EnoughInjectives C₁] [CategoryTheory.HasExt.{u} C₁]
        [CategoryTheory.Category.{u + 1} C₂] [CategoryTheory.Abelian C₂]
        [CategoryTheory.HasExt.{u} C₂]
        [CategoryTheory.Category.{u + 1} C₃] [CategoryTheory.Abelian C₃]
        [CategoryTheory.HasExt.{u} C₃]
        (F : CategoryTheory.Functor C₁ C₂) (G : CategoryTheory.Functor C₂ C₃)
        [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
        [CategoryTheory.Limits.PreservesFiniteColimits F]
        [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
        [CategoryTheory.Limits.PreservesFiniteColimits G]
        [hAddFG : (F.comp G).Additive]
        [hLimFG : CategoryTheory.Limits.PreservesFiniteLimits (F.comp G)]
        [hColimFG : CategoryTheory.Limits.PreservesFiniteColimits (F.comp G)]
        (k : ℕ) {X Y : C₁} (x : CategoryTheory.Abelian.Ext.{u} X Y k),
        @CategoryTheory.Abelian.Ext.mapExactFunctor _ _ _ _ _ _ (F.comp G)
            hAddFG hLimFG hColimFG _ _ _ _ _ x =
          CategoryTheory.Abelian.Ext.mapExactFunctor G
            (CategoryTheory.Abelian.Ext.mapExactFunctor F x) := by
    intro C₁ C₂ C₃ _ _ _ _ _ _ _ _ _ _ F G _ _ _ _ _ _ hAddFG hLimFG hColimFG k
    induction k with
    | zero =>
      intro X Y x
      obtain ⟨f, rfl⟩ := (CategoryTheory.Abelian.Ext.mk₀_bijective X Y).2 x
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
          CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      intro X Y x
      let S : CategoryTheory.ShortComplex C₁ :=
        CategoryTheory.ShortComplex.mk (CategoryTheory.Injective.ι Y)
          (CategoryTheory.Limits.cokernel.π (CategoryTheory.Injective.ι Y))
          (CategoryTheory.Limits.cokernel.condition _)
      have hS : S.ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk'
          (CategoryTheory.ShortComplex.exact_cokernel (CategoryTheory.Injective.ι Y))
          inferInstance inferInstance
      have hZero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨x₃, rfl⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hZero rfl
      rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
          ih x₃,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
          CategoryTheory.Abelian.Ext.mapExactFunctor_extClass]
  have hConjComp :
      ∀ {C₁ C₂ : Type (u + 1)}
        [CategoryTheory.Category.{u + 1} C₁] [CategoryTheory.Abelian C₁] [CategoryTheory.HasExt.{u} C₁]
        [CategoryTheory.Category.{u + 1} C₂] [CategoryTheory.Abelian C₂] [CategoryTheory.HasExt.{u} C₂]
        (P : CategoryTheory.Functor C₂ C₁)
        [P.Additive] [CategoryTheory.Limits.PreservesFiniteLimits P]
        [CategoryTheory.Limits.PreservesFiniteColimits P]
        {X₂ : C₂} {X₁ : C₁}
        (ι : X₁ ⟶ P.obj X₂) (π : P.obj X₂ ⟶ X₁)
        (hπι : π ≫ ι = 𝟙 (P.obj X₂))
        (α : CategoryTheory.Abelian.Ext.{u} X₂ X₂ i)
        (β : CategoryTheory.Abelian.Ext.{u} X₂ X₂ j),
        (((CategoryTheory.Abelian.Ext.mk₀ ι).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor P α) (Nat.zero_add i)).comp
            (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero i)).comp
          (((CategoryTheory.Abelian.Ext.mk₀ ι).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor P β) (Nat.zero_add j)).comp
            (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero j)) hc =
        ((CategoryTheory.Abelian.Ext.mk₀ ι).comp
            (CategoryTheory.Abelian.Ext.mapExactFunctor P (α.comp β hc)) (Nat.zero_add c)).comp
            (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero c) := by
    intro C₁ C₂ _ _ _ _ _ _ P _ _ _ X₂ X₁ ι π hπι α β
    let uα := (CategoryTheory.Abelian.Ext.mk₀ ι).comp
      (CategoryTheory.Abelian.Ext.mapExactFunctor P α) (Nat.zero_add i)
    let vβ := CategoryTheory.Abelian.Ext.mapExactFunctor P β
    change (uα.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero i)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ι).comp vβ (Nat.zero_add j)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero j)) hc = _
    rw [CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ι) vβ
          (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.zero_add j) (Nat.add_zero j) (by omega)]
    rw [CategoryTheory.Abelian.Ext.comp_assoc uα (CategoryTheory.Abelian.Ext.mk₀ π)
          ((CategoryTheory.Abelian.Ext.mk₀ ι).comp
            (vβ.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero j)) (Nat.zero_add j))
          (Nat.add_zero i) (Nat.zero_add j) (by omega)]
    rw [← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ π)
          (CategoryTheory.Abelian.Ext.mk₀ ι)
          (vβ.comp (CategoryTheory.Abelian.Ext.mk₀ π) (Nat.add_zero j))
          (Nat.zero_add 0) (Nat.zero_add j) (by omega)]
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, hπι,
        CategoryTheory.Abelian.Ext.mk₀_id_comp]
    rw [← CategoryTheory.Abelian.Ext.comp_assoc uα vβ (CategoryTheory.Abelian.Ext.mk₀ π)
          hc (Nat.add_zero j) (by omega)]
    dsimp [uα, vβ]
    rw [CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ι)
          (CategoryTheory.Abelian.Ext.mapExactFunctor P α)
          (CategoryTheory.Abelian.Ext.mapExactFunctor P β)
          (Nat.zero_add i) hc (by omega),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp]

  
  
  
  let R := ULift.{u, 0} (ZMod m)
  let M_R : ModuleCat.{u, u} R := ModuleCat.of R R
  let FgtMod := CategoryTheory.forget₂ (ModuleCat.{u, u} R) AddCommGrpCat.{u}
  let J₁ := S₁.smallEtaleTopology
  let J₂ := S₂.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let Cℤ_1 := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
  let Cℤ_2 := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
  let Fℤ_1 := Cℤ_1.obj Aℤ
  let Fℤ_2 := Cℤ_2.obj Aℤ
  let FM_1 : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} := Cℤ_1.obj AM
  let FM_2 : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u} := Cℤ_2.obj AM
  let oneR_1 : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R) :=
    (CategoryTheory.constantSheaf J₁ (ModuleCat.{u, u} R)).obj M_R
  let oneR_2 : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R) :=
    (CategoryTheory.constantSheaf J₂ (ModuleCat.{u, u} R)).obj M_R
  let ιM_coeff : Quiver.Hom AM (FgtMod.obj M_R) := AddCommGrpCat.ofHom (AddMonoidHom.id R)
  let ιℤ_coeff : Quiver.Hom Aℤ (FgtMod.obj M_R) :=
    CategoryTheory.CategoryStruct.comp
      (AddCommGrpCat.ofHom (AddMonoidHom.id (ULift.{u} ℤ)) :
        Quiver.Hom Aℤ (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of ℤ)))
      (CategoryTheory.CategoryStruct.comp
        (AddCommGrpCat.uliftFunctor.{u, 0}.map (AddCommGrpCat.ofHom (Int.castAddHom (ZMod m))))
        ιM_coeff)

  have hSheafHomHEq :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        {J : CategoryTheory.GrothendieckTopology C}
        {X₁ X₂ Y₁ Y₂ : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (h₁ : X₁ = Y₁) (h₂ : X₂ = Y₂) (f : X₁ ⟶ X₂) (g : Y₁ ⟶ Y₂),
        (∀ W : Cᵒᵖ, HEq (f.hom.app W) (g.hom.app W)) → HEq f g := by
    intro C _ J X₁ X₂ Y₁ Y₂ h₁ h₂ f g happ
    subst h₁; subst h₂
    apply heq_of_eq
    apply CategoryTheory.Sheaf.hom_ext
    exact CategoryTheory.NatTrans.ext (funext fun W => eq_of_heq (happ W))

  
  rcases hθ₁_i with ⟨U'_1, hU'_1_obj, hU'_1_map, hAdd_1, hLim_1, hColim_1,
    T_std_1, hT_std_1, hT1_left, hT1_hom, u'_1_unit, hu'_1_unit, βM_1, hαβ_1, hβα_1, hθ1_i_apply⟩
  have hSC_1 : J₁.HasSheafCompose FgtMod :=
    CategoryTheory.GrothendieckTopology.HasSheafCompose.mk (fun P hP => by
      have hsh := (U'_1.obj ⟨P, hP⟩).property
      rwa [hU'_1_obj ⟨P, hP⟩] at hsh)
  have hU1_eq : U'_1 = CategoryTheory.sheafCompose J₁ FgtMod :=
    CategoryTheory.Functor.hext
      (fun ℱ => CategoryTheory.ObjectProperty.FullSubcategory.ext (hU'_1_obj ℱ))
      (fun ℱ₁ ℱ₂ u => hSheafHomHEq
        (CategoryTheory.ObjectProperty.FullSubcategory.ext (hU'_1_obj ℱ₁))
        (CategoryTheory.ObjectProperty.FullSubcategory.ext (hU'_1_obj ℱ₂))
        (U'_1.map u) ((CategoryTheory.sheafCompose J₁ FgtMod).map u)
        (fun W => hU'_1_map u W))
  subst hU1_eq
  let U_std_1 := CategoryTheory.sheafCompose J₁ FgtMod
  have : U_std_1.Additive := hAdd_1
  have : CategoryTheory.Limits.PreservesFiniteLimits U_std_1 := hLim_1
  have : CategoryTheory.Limits.PreservesFiniteColimits U_std_1 := hColim_1
  let adjℤ_std_1 := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT_std_1
  let adjR_std_1 := CategoryTheory.constantSheafAdj J₁ (ModuleCat.{u, u} R) hT_std_1
  have hu1_eq : u'_1_unit = FgtMod.map (adjR_std_1.unit.app M_R) := eq_of_heq hu'_1_unit
  subst hu1_eq
  let u_unit_std_1 : Quiver.Hom (FgtMod.obj M_R) ((U_std_1.obj oneR_1).obj.obj (Opposite.op T_std_1)) :=
    FgtMod.map (adjR_std_1.unit.app M_R)
  let ηℤ_1 : Quiver.Hom Fℤ_1 (U_std_1.obj oneR_1) :=
    (adjℤ_std_1.homEquiv Aℤ (U_std_1.obj oneR_1)).symm (CategoryTheory.CategoryStruct.comp ιℤ_coeff u_unit_std_1)
  let αM_1 : Quiver.Hom FM_1 (U_std_1.obj oneR_1) :=
    (adjℤ_std_1.homEquiv AM (U_std_1.obj oneR_1)).symm (CategoryTheory.CategoryStruct.comp ιM_coeff u_unit_std_1)
  let θ_std_1 : ∀ k : ℕ, weilCupPDModH S₁ m k →+ weilEtaleTorsionH S₁ m k := fun k =>
    ((CategoryTheory.Abelian.Ext.mk₀ βM_1).postcomp Fℤ_1 (Nat.add_zero k)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ ηℤ_1).precomp (U_std_1.obj oneR_1) (Nat.zero_add k)).comp
        (U_std_1.mapExtAddHom oneR_1 oneR_1 k))
  have hθ_std_1 : ∀ k : ℕ, WeilCupPDIsModComparison S₁ m k (θ_std_1 k) := fun k =>
    ⟨U_std_1, fun _ => rfl, fun _ _ => HEq.rfl, hAdd_1, hLim_1, hColim_1,
      T_std_1, hT_std_1, hT1_left, hT1_hom, u_unit_std_1, HEq.rfl, βM_1, hαβ_1, hβα_1,
      fun _ => rfl⟩

  
  rcases hθ₂_i with ⟨U'_2, hU'_2_obj, hU'_2_map, hAdd_2, hLim_2, hColim_2,
    T_std_2, hT_std_2, hT2_left, hT2_hom, u'_2_unit, hu'_2_unit, βM_2, hαβ_2, hβα_2, hθ2_i_apply⟩
  have hSC_2 : J₂.HasSheafCompose FgtMod :=
    CategoryTheory.GrothendieckTopology.HasSheafCompose.mk (fun P hP => by
      have hsh := (U'_2.obj ⟨P, hP⟩).property
      rwa [hU'_2_obj ⟨P, hP⟩] at hsh)
  have hU2_eq : U'_2 = CategoryTheory.sheafCompose J₂ FgtMod :=
    CategoryTheory.Functor.hext
      (fun ℱ => CategoryTheory.ObjectProperty.FullSubcategory.ext (hU'_2_obj ℱ))
      (fun ℱ₁ ℱ₂ u => hSheafHomHEq
        (CategoryTheory.ObjectProperty.FullSubcategory.ext (hU'_2_obj ℱ₁))
        (CategoryTheory.ObjectProperty.FullSubcategory.ext (hU'_2_obj ℱ₂))
        (U'_2.map u) ((CategoryTheory.sheafCompose J₂ FgtMod).map u)
        (fun W => hU'_2_map u W))
  subst hU2_eq
  let U_std_2 := CategoryTheory.sheafCompose J₂ FgtMod
  have : U_std_2.Additive := hAdd_2
  have : CategoryTheory.Limits.PreservesFiniteLimits U_std_2 := hLim_2
  have : CategoryTheory.Limits.PreservesFiniteColimits U_std_2 := hColim_2
  let adjℤ_std_2 := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT_std_2
  let adjR_std_2 := CategoryTheory.constantSheafAdj J₂ (ModuleCat.{u, u} R) hT_std_2
  have hu2_eq : u'_2_unit = FgtMod.map (adjR_std_2.unit.app M_R) := eq_of_heq hu'_2_unit
  subst hu2_eq
  let u_unit_std_2 : Quiver.Hom (FgtMod.obj M_R) ((U_std_2.obj oneR_2).obj.obj (Opposite.op T_std_2)) :=
