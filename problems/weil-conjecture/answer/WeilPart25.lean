  let V₁_sch := (Fgt_V.obj E.V₁).left
  let f_W₁ : (Fgt_Y.obj E.W₁).left ⟶ V₁_sch := E.e_W₁.hom ≫ (E.W₁_open.ι ≫ E.f_bar₁)
  let g_VP : (Fgt_V.obj P.V).left ⟶ V₁_sch := (Fgt_V.map P.g_V).left
  let u_WP : (Fgt_Y.obj P.W).left ⟶ (Fgt_Y.obj E.W₁).left := (Fgt_Y.map P.u_W).left
  let T_W := CategoryTheory.Limits.pullback f_W₁ g_VP
  let ψ_W : (Fgt_Y.obj P.W).left ⟶ T_W :=
    CategoryTheory.Limits.pullback.lift u_WP f_WP P.hComm_W
  have hRange_UW₁ : Set.range (E.U_fib.ι ≫ E.ι_Cfib).base ⊆ Set.range E.W₁_open.ι.base := by
    rintro _ ⟨z, rfl⟩
    have hz : E.ι_Cfib.base z.1 ∈ E.W₁_open :=
      Eq.mp (congrArg (fun O : E.C_fib.left.Opens => (z.1 : ↥E.C_fib.left) ∈ O) E.hU_fib_eq) z.2
    exact ⟨⟨E.ι_Cfib.base z.1, hz⟩, rfl⟩
  let j_U_open : E.U_fib.toScheme ⟶ E.W₁_open.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift E.W₁_open.ι (E.U_fib.ι ≫ E.ι_Cfib) hRange_UW₁
  have hj_U_open : j_U_open ≫ E.W₁_open.ι = E.U_fib.ι ≫ E.ι_Cfib :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac E.W₁_open.ι (E.U_fib.ι ≫ E.ι_Cfib) hRange_UW₁
  have hRange_cone :
      ∀ s : CategoryTheory.Limits.PullbackCone E.W₁_open.ι E.ι_Cfib,
        Set.range s.snd.base ⊆ Set.range E.U_fib.ι.base := by
    rintro s _ ⟨z, rfl⟩
    have hz_eq : E.ι_Cfib.base (s.snd.base z) = E.W₁_open.ι.base (s.fst.base z) :=
      congrArg (fun m => m.base z) s.condition.symm
    have hz_W₁ : E.ι_Cfib.base (s.snd.base z) ∈ E.W₁_open := by
      rw [hz_eq]
      exact (s.fst.base z).2
    have hz_U : s.snd.base z ∈ E.U_fib := by
      rw [E.hU_fib_eq]
      exact hz_W₁
    exact ⟨⟨s.snd.base z, hz_U⟩, rfl⟩
  let lift_cone (s : CategoryTheory.Limits.PullbackCone E.W₁_open.ι E.ι_Cfib) :
      s.pt ⟶ E.U_fib.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift E.U_fib.ι s.snd (hRange_cone s)
  have hPb_U_open : CategoryTheory.IsPullback j_U_open E.U_fib.ι E.W₁_open.ι E.ι_Cfib :=
    CategoryTheory.IsPullback.of_isLimit
      (CategoryTheory.Limits.PullbackCone.IsLimit.mk hj_U_open
        lift_cone
        (fun s => (cancel_mono E.W₁_open.ι).mp
          ((CategoryTheory.Category.assoc (lift_cone s) j_U_open E.W₁_open.ι).trans
            ((congrArg (lift_cone s ≫ ·) hj_U_open).trans
              ((CategoryTheory.Category.assoc (lift_cone s) E.U_fib.ι E.ι_Cfib).symm.trans
                ((congrArg (· ≫ E.ι_Cfib)
                  (AlgebraicGeometry.IsOpenImmersion.lift_fac E.U_fib.ι s.snd (hRange_cone s))).trans
                  s.condition.symm)))))
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift_fac E.U_fib.ι s.snd (hRange_cone s))
        (fun s m _ hm₂ => (cancel_mono E.U_fib.ι).mp
          (hm₂.trans
            (AlgebraicGeometry.IsOpenImmersion.lift_fac E.U_fib.ι s.snd (hRange_cone s)).symm)))
  have hPb_eW₁ : CategoryTheory.IsPullback E.e_W₁.inv E.W₁_open.ι
      (E.e_W₁.hom ≫ E.W₁_open.ι) (𝟙 E.Y₁) :=
    CategoryTheory.IsPullback.of_horiz_isIso ⟨by
      rw [← CategoryTheory.Category.assoc, E.e_W₁.inv_hom_id,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]⟩
  let j_U_W₁ : E.U_fib.toScheme ⟶ (Fgt_Y.obj E.W₁).left := j_U_open ≫ E.e_W₁.inv
  have hPb_U_W₁_top : CategoryTheory.IsPullback j_U_W₁ E.U_fib.ι
      (E.e_W₁.hom ≫ E.W₁_open.ι) E.ι_Cfib := by
    have hp := hPb_U_open.paste_horiz hPb_eW₁
    rwa [CategoryTheory.Category.comp_id] at hp
  let q_U : E.U_fib.toScheme ⟶ S_k := E.U_fib.ι ≫ E.C_fib.hom
  have hPb_U_W₁ : CategoryTheory.IsPullback j_U_W₁ q_U f_W₁ E.s_v₁ := by
    have hp := hPb_U_W₁_top.paste_vert E.hPb_Cfib
    rwa [CategoryTheory.Category.assoc] at hp
  have hg_V₂_eq : g_V₂_sch = h₂_sch ≫ g_VP :=
    congrArg CategoryTheory.CommaMorphism.left (Fgt_V.map_comp h₂ P.g_V)
  have hs_v_gVP : s_v ≫ g_VP = E.s_v₁ :=
    (CategoryTheory.Category.assoc s_v₂ h₂_sch g_VP).trans
      ((congrArg (s_v₂ ≫ ·) hg_V₂_eq.symm).trans hs_v₂_g)
  let j_U : E.U_fib.toScheme ⟶ T_W :=
    CategoryTheory.Limits.pullback.lift j_U_W₁ (q_U ≫ s_v)
      (hPb_U_W₁.w.trans
        ((congrArg (q_U ≫ ·) hs_v_gVP.symm).trans
          (CategoryTheory.Category.assoc q_U s_v g_VP).symm))
  have hPb_jU : CategoryTheory.IsPullback j_U q_U
      (CategoryTheory.Limits.pullback.snd f_W₁ g_VP) s_v := by
    have hPb_outer : CategoryTheory.IsPullback
        (j_U ≫ CategoryTheory.Limits.pullback.fst f_W₁ g_VP) q_U f_W₁ (s_v ≫ g_VP) := by
      rw [CategoryTheory.Limits.pullback.lift_fst, hs_v_gVP]
      exact hPb_U_W₁
    exact CategoryTheory.IsPullback.of_right hPb_outer
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback f_W₁ g_VP)
  have hu_fib_q : u_fib ≫ q_U = q_C' := by
    dsimp [q_U, q_C']
    rw [← CategoryTheory.Category.assoc, hu_fib_U]
  have hj_cancel : j_U_W₁ ≫ (E.e_W₁.hom ≫ E.W₁_open.ι) = E.U_fib.ι ≫ E.ι_Cfib :=
    (CategoryTheory.Category.assoc j_U_open E.e_W₁.inv _).trans
      ((congrArg (j_U_open ≫ ·)
        ((CategoryTheory.Category.assoc E.e_W₁.inv E.e_W₁.hom E.W₁_open.ι).symm.trans
          ((congrArg (· ≫ E.W₁_open.ι) E.e_W₁.inv_hom_id).trans
            (CategoryTheory.Category.id_comp E.W₁_open.ι)))).trans hj_U_open)
  have hComm_ufib : u_fib ≫ j_U = ι_C' ≫ ψ_W := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact ((CategoryTheory.Category.assoc u_fib j_U _).trans
        (congrArg (u_fib ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).trans
        (((cancel_mono (E.e_W₁.hom ≫ E.W₁_open.ι)).mp
          ((CategoryTheory.Category.assoc u_fib j_U_W₁ _).trans
            ((congrArg (u_fib ≫ ·) hj_cancel).trans
              (hu_fib_comm.trans
                (CategoryTheory.Category.assoc ι_C' u_WP _).symm)))).trans
          ((CategoryTheory.Category.assoc ι_C' ψ_W _).trans
            (congrArg (ι_C' ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _))).symm)
    · exact ((CategoryTheory.Category.assoc u_fib j_U _).trans
        ((congrArg (u_fib ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
          ((CategoryTheory.Category.assoc u_fib q_U s_v).symm.trans
            (congrArg (· ≫ s_v) hu_fib_q)))).trans
        ((CategoryTheory.Category.assoc ι_C' ψ_W _).trans
          ((congrArg (ι_C' ≫ ·) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
            hPb_C'_PW.w)).symm
  have hPb_ufib_flip : CategoryTheory.IsPullback u_fib ι_C' j_U ψ_W := by
    have hPb_outer : CategoryTheory.IsPullback (u_fib ≫ q_U) ι_C' s_v
        (ψ_W ≫ CategoryTheory.Limits.pullback.snd f_W₁ g_VP) := by
      rw [hu_fib_q, CategoryTheory.Limits.pullback.lift_snd]
      exact hPb_C'_PW.flip
    exact CategoryTheory.IsPullback.of_right hPb_outer hComm_ufib hPb_jU.flip
  have hPb_ufib : CategoryTheory.IsPullback ι_C' u_fib ψ_W j_U :=
    hPb_ufib_flip.flip

  have hFin_ufib : AlgebraicGeometry.IsFinite u_fib :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ufib P.hFin_W_rel
  have hEt_ufib : AlgebraicGeometry.Etale u_fib :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ufib P.hEt_W_rel
  have hSurj_ufib : AlgebraicGeometry.Surjective u_fib :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ufib P.hSurj_W_rel
  haveI : AlgebraicGeometry.Surjective u_fib := hSurj_ufib

  let C₂_fib := CategoryTheory.Limits.pullback P.f_bar s_v
  let fst_C₂ := CategoryTheory.Limits.pullback.fst P.f_bar s_v
  let snd_C₂ := CategoryTheory.Limits.pullback.snd P.f_bar s_v
  let j_C' : C'_sch ⟶ C₂_fib :=
    CategoryTheory.Limits.pullback.lift (ι_C' ≫ (P.e_W.hom ≫ P.W_open.ι)) q_C'
      (by
        dsimp [f_WP] at hPb_C'_PW
        simpa only [CategoryTheory.Category.assoc] using hPb_C'_PW.w)
  have hPb_jC'_flip :
      CategoryTheory.IsPullback j_C' ι_C' fst_C₂ (P.e_W.hom ≫ P.W_open.ι) := by
    have hPb_outer : CategoryTheory.IsPullback (j_C' ≫ snd_C₂) ι_C' s_v
        ((P.e_W.hom ≫ P.W_open.ι) ≫ P.f_bar) := by
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
      exact hPb_C'_PW.flip
    exact CategoryTheory.IsPullback.of_right hPb_outer
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback P.f_bar s_v).flip
  have hPb_jC' : CategoryTheory.IsPullback ι_C' j_C' (P.e_W.hom ≫ P.W_open.ι) fst_C₂ :=
    hPb_jC'_flip.flip
  haveI : AlgebraicGeometry.IsOpenImmersion j_C' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_jC' inferInstance
  have hEmb : Topology.IsOpenEmbedding j_C'.base := j_C'.isOpenEmbedding

  have hNe_C' : Nonempty ↥C'_sch := by
    obtain ⟨u₀⟩ := E.hNe_Ufib
    obtain ⟨c'₀, -⟩ := u_fib.surjective u₀
    exact ⟨c'₀⟩
  have hPreIrred_C' : IsPreirreducible (Set.univ : Set ↥C'_sch) := by
    rintro U_set V_set hUo hVo ⟨u_el, -, hu_el⟩ ⟨v_el, -, hv_el⟩
    have hIrred_C₂ : IrreducibleSpace ↥C₂_fib := P.hIrred_fib k s_v
    obtain ⟨z, -, ⟨u', hu', hu'_eq⟩, ⟨v', hv', hv'_eq⟩⟩ :=
      hIrred_C₂.isIrreducible_univ.isPreirreducible
        (j_C'.base '' U_set) (j_C'.base '' V_set)
        (hEmb.isOpenMap U_set hUo) (hEmb.isOpenMap V_set hVo)
        ⟨j_C'.base u_el, trivial, ⟨u_el, hu_el, rfl⟩⟩
        ⟨j_C'.base v_el, trivial, ⟨v_el, hv_el, rfl⟩⟩
    have huv : u' = v' := hEmb.injective (hu'_eq.trans hv'_eq.symm)
    exact ⟨u', trivial, hu', by rwa [huv]⟩
  have hConn_C' : ConnectedSpace ↥C'_sch :=
    { isPreconnected_univ := hPreIrred_C'.isPreconnected
      toNonempty := hNe_C' }
  exact hDual_U U_et C'_et v_et e_U he_U hConn_C' hFin_ufib hEt_ufib hSurj_ufib
    ⟨p₁, hp₁_pb, hp₁_zero⟩

theorem weil_etale_algClosed_locallyOfFiniteType_closedPt_hom_zero (k : Type u) [Field k] [IsAlgClosed k]
    (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    {G₁ G₂ : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}}
    (Ψ : Quiver.Hom G₂ G₁) :
    (∀ (s_b : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) S.left),
      CategoryTheory.CategoryStruct.comp s_b S.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      ∀ (V : S.left.Etale)
        (z_V : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V.left),
        CategoryTheory.CategoryStruct.comp z_V V.hom = s_b →
        ∀ (x : ↥(G₂.obj.obj (Opposite.op V))),
          ∃ (U : S.left.Etale) (g : Quiver.Hom U V)
            (z_U : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U.left),
            CategoryTheory.CategoryStruct.comp z_U g.left = z_V ∧
            (G₁.obj.map (Opposite.op g)).hom ((Ψ.hom.app (Opposite.op V)).hom x) = 0) →
    Ψ = 0 :=
by
  intro hClosed
  apply CategoryTheory.Sheaf.hom_ext
  apply CategoryTheory.NatTrans.ext
  funext V_op
  induction V_op using Opposite.rec with
  | op V =>
    let EV : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf S.left.smallEtaleTopology AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite S.left.Etale) AddCommGrpCat.{u}).obj (Opposite.op V)
    have h0_app : (0 : G₂ ⟶ G₁).hom.app (Opposite.op V) = 0 := EV.map_zero G₂ G₁
    rw [h0_app]
    apply AddCommGrpCat.hom_ext
    ext x
    change (Ψ.hom.app (Opposite.op V)).hom x = 0
    set y : ↥(G₁.obj.obj (Opposite.op V)) := (Ψ.hom.app (Opposite.op V)).hom x

    let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
    let pt_k : ↥S_k := (⟨⊥, (@Ideal.bot_isMaximal k _).isPrime⟩ : PrimeSpectrum k)
    have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl

    have hEt_of_hom : ∀ {U₁ U₂ : S.left.Etale} (g : Quiver.Hom U₁ U₂),
        AlgebraicGeometry.Etale g.left := by
      intro U₁ U₂ g
      have hgw : g.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w g
      have hEt_comp : AlgebraicGeometry.Etale (g.left ≫ U₂.hom) := by
        rw [hgw]
        exact U₁.prop
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        g.left U₂.hom U₂.prop hEt_comp

    let O_zero : Set ↥V.left :=
      { v : ↥V.left | ∃ (U : S.left.Etale) (g : Quiver.Hom U V) (u₀ : ↥U.left),
          g.left u₀ = v ∧ (G₁.obj.map (Opposite.op g)).hom y = 0 }

    have hOpen_O : IsOpen O_zero := by
      refine isOpen_iff_forall_mem_open.mpr ?_
      rintro v ⟨U, g, u₀, hu₀, hy_g⟩
      have : AlgebraicGeometry.Etale g.left := hEt_of_hom g
      refine ⟨Set.range ⇑g.left, ?_, g.left.isOpenMap.isOpen_range, ⟨u₀, hu₀⟩⟩
      rintro _ ⟨u', rfl⟩
      exact ⟨U, g, u', rfl, hy_g⟩

    have hUniv_O : ∀ v₀ : ↥V.left, v₀ ∈ O_zero := by
      intro v₀
      by_contra hv₀_not
      let Z_bad : Set ↥V.left := O_zeroᶜ
      have hClosed_Z : IsClosed Z_bad := hOpen_O.isClosed_compl
      have hv₀_Z : v₀ ∈ Z_bad := hv₀_not
      obtain ⟨R_cat, ι_W, hOpen_ιW, ⟨p₀, hp₀⟩, -⟩ :=
        AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
          (X := V.left) (x := v₀) (U := ⊤) trivial
      let K_spec : Set ↥(AlgebraicGeometry.Spec R_cat) := ⇑ι_W ⁻¹' Z_bad
      have hClosed_K : IsClosed K_spec := hClosed_Z.preimage ι_W.continuous
      have hp₀_K : p₀ ∈ K_spec := by
        change ι_W p₀ ∈ Z_bad
        rw [hp₀]
        exact hv₀_Z
      let p₀_spec : PrimeSpectrum ↑R_cat := p₀
      obtain ⟨m₀, hm₀_max, hm₀_le⟩ :=
        Ideal.exists_le_maximal p₀_spec.asIdeal p₀_spec.isPrime.ne_top
      let q_max : ↥(AlgebraicGeometry.Spec R_cat) :=
        (⟨m₀, hm₀_max.isPrime⟩ : PrimeSpectrum ↑R_cat)
      have hq_cl : q_max ∈ closure ({p₀} : Set ↥(AlgebraicGeometry.Spec R_cat)) :=
        (PrimeSpectrum.le_iff_mem_closure p₀_spec ⟨m₀, hm₀_max.isPrime⟩).mp hm₀_le
      have hq_K : q_max ∈ K_spec :=
        closure_minimal (Set.singleton_subset_iff.mpr hp₀_K) hClosed_K hq_cl
      let v_max : ↥V.left := ι_W q_max
      have hv_max_not : v_max ∉ O_zero := hq_K

      have : AlgebraicGeometry.IsOpenImmersion ι_W := hOpen_ιW
      have : AlgebraicGeometry.Etale V.hom := V.prop
      let p_R : AlgebraicGeometry.Spec R_cat ⟶ S_k := ι_W ≫ V.hom ≫ S.hom
      have : AlgebraicGeometry.LocallyOfFiniteType p_R := inferInstance
      let φ_k : CommRingCat.of k ⟶ R_cat := AlgebraicGeometry.Spec.preimage p_R
      have hmap_φ : AlgebraicGeometry.Spec.map φ_k = p_R :=
        AlgebraicGeometry.Spec.map_preimage p_R
      have hFT_hom : RingHom.FiniteType φ_k.hom := by
        rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
        infer_instance
      let : Algebra k ↑R_cat := φ_k.hom.toAlgebra
      have hFT_alg : Algebra.FiniteType k ↑R_cat := hFT_hom
      obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
      let q_hom : MvPolynomial (Fin n_mv) k →+* ↑R_cat := q_mv.toRingHom
      have hq_hom_surj : Function.Surjective q_hom := hq_surj
      have : m₀.IsMaximal := hm₀_max
      let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom m₀
      have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
      obtain ⟨a_pt, ha_pt⟩ :=
        (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
      let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
      have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
        intro f_p hf_p
        rw [RingHom.mem_ker] at hf_p
        have hmem : f_p ∈ m_mv := by
          change q_hom f_p ∈ m₀
          rw [hf_p]
          exact m₀.zero_mem
        rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
      let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
      let σ_R : ↑R_cat →+* k :=
        (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
      have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_R (q_hom f_p) = ev_hom f_p := by
        intro f_p
        dsimp [σ_R]
        have heq_q : e_quot.symm (q_hom f_p) = Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
          apply e_quot.injective
          simp [e_quot]
        rw [heq_q, Ideal.Quotient.lift_mk]
      have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_R = 𝟙 (CommRingCat.of k) := by
        ext c
        change σ_R (algebraMap k (↑R_cat) c) = c
        rw [← q_mv.commutes c]
        change σ_R (q_hom (MvPolynomial.C c)) = c
        rw [hσ_qhom]
        exact (MvPolynomial.aeval a_pt).commutes c
      let σ_spec : S_k ⟶ AlgebraicGeometry.Spec R_cat :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_R)
      have hσ_sec : σ_spec ≫ p_R = 𝟙 S_k := by
        dsimp [σ_spec]
        rw [← hmap_φ, ← AlgebraicGeometry.Spec.map_comp, hσ_comp, AlgebraicGeometry.Spec.map_id]
      have hσ_pt : σ_spec pt_k = q_max := by
        apply PrimeSpectrum.ext
        change Ideal.comap σ_R (pt_k : PrimeSpectrum k).asIdeal = m₀
        rw [hpt_bot]
        ext b
        obtain ⟨f_p, rfl⟩ := hq_hom_surj b
        change σ_R (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ m₀
        rw [Ideal.mem_bot, hσ_qhom]
        change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
        rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
        rfl

      let z_V : Quiver.Hom S_k V.left := σ_spec ≫ ι_W
      let s_b : Quiver.Hom S_k S.left := z_V ≫ V.hom
      have hs_b : CategoryTheory.CategoryStruct.comp s_b S.hom =
          CategoryTheory.CategoryStruct.id S_k := by
        change ((σ_spec ≫ ι_W) ≫ V.hom) ≫ S.hom = 𝟙 S_k
        simpa [p_R, CategoryTheory.Category.assoc] using hσ_sec
      obtain ⟨U, g, z_U, hz_U, hy_g⟩ := hClosed s_b hs_b V z_V rfl x
      have hu_pt : g.left (z_U pt_k) = v_max := by
        calc
          g.left (z_U pt_k) = (z_U ≫ g.left) pt_k := rfl
          _ = z_V pt_k := by rw [hz_U]
          _ = ι_W (σ_spec pt_k) := rfl
          _ = v_max := by rw [hσ_pt]
      exact hv_max_not ⟨U, g, z_U pt_k, hu_pt, hy_g⟩

    let S_zero : CategoryTheory.Sieve V :=
      { arrows := fun _ g => (G₁.obj.map (Opposite.op g)).hom y = 0
        downward_closed := by
          intro U W g hg h
          have hop : Opposite.op (h ≫ g) = (Opposite.op g ≫ Opposite.op h : Opposite.op V ⟶ Opposite.op W) := rfl
          rw [hop, G₁.obj.map_comp]
          change (G₁.obj.map (Opposite.op h)).hom ((G₁.obj.map (Opposite.op g)).hom y) = 0
          rw [hg, map_zero] }

    let P : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have hMem_pre : S_zero ∈ (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck V :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P) (Q := P) (S := S.left) V S_zero).mpr fun v =>
        let ⟨U, g, u₀, hu₀, hy_g⟩ := hUniv_O v
        ⟨U, g, u₀, hy_g, hEt_of_hom g, hu₀⟩
    have hTop_eq : S.left.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P P).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P) (Q := P) S.left (le_refl P)
    have hCov : S_zero ∈ S.left.smallEtaleTopology V :=
      Eq.mpr (congrArg (fun (J : CategoryTheory.GrothendieckTopology S.left.Etale) => S_zero ∈ J V) hTop_eq) hMem_pre

    have hSep := CategoryTheory.Sheaf.isSeparated G₁ V S_zero hCov
    refine hSep y 0 (fun _ g hg => ?_)
    change (G₁.obj.map (Opposite.op g)).hom y = (G₁.obj.map (Opposite.op g)).hom 0
    rw [hg, map_zero]

theorem weil_etale_spec_epi_surj_and_fiber_r_eval_nat (k : Type u) [Field k]
    (hSkUnitIso :
      ∀ (P : CategoryTheory.Functor
          (Opposite (AlgebraicGeometry.Spec (CommRingCat.of k)).Etale) AddCommGrpCat.{u}),
        CategoryTheory.IsIso
          (((CategoryTheory.sheafificationAdjunction
            (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
            AddCommGrpCat.{u}).unit.app P).app
            (Opposite.op
              (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k)))))) :
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let T_k := weilEtaleIdTerminal.{u} S_k
