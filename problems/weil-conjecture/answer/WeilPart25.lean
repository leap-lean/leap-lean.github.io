  classical
  intro S_k T_k
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  let σ_k : Fin 1 → Quiver.Hom S_k S_k := fun _ => CategoryTheory.CategoryStruct.id S_k

  have hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    fun f => (hS1 f).choose
  have hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ f)).IsRightAdjoint :=
    fun f => (hS1 f).choose_spec.choose
  have hSiteExact : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      let pb_h := @CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Y₂.smallEtaleTopology Y₁.smallEtaleTopology
        (@hc_all Y₁ Y₂ h) (@hr_all Y₁ Y₂ h)
