          (weilEtaleIdTerminalIsTerminal.{u} S)
        CategoryTheory.CategoryStruct.comp (adj_S.unit.app AM)
          ((e_loc S).hom.hom.app (Opposite.op T_S)) =
          weilAltLocConstConstHom S T_S m) ∧
      (∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom S₁ S₂)
         {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
         {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂),
        letI : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
          hc_all h
        letI : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint := hr_all h
        let B := weilEtaleSitePullback h
        let pb_h := B.sheafPullback AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
        let adj_h := B.sheafAdjunctionContinuous AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
        let L₁ : CategoryTheory.Sheaf S₁.smallEtaleTopology AddCommGrpCat.{u} :=
          ⟨weilAltLocConstPresheaf S₁ m, hSh S₁⟩
        let L₂ : CategoryTheory.Sheaf S₂.smallEtaleTopology AddCommGrpCat.{u} :=
          ⟨weilAltLocConstPresheaf S₂ m, hSh S₂⟩
        let β_L : Quiver.Hom (pb_h.obj L₂) L₁ :=
          (adj_h.homEquiv L₂ L₁).symm { hom := weilAltLocConstPullbackNat h m }
        let πM := weilEtaleConstPullbackHom h hT₁ hT₂ AM
        CategoryTheory.CategoryStruct.comp (pb_h.map (e_loc S₂).hom) β_L =
          CategoryTheory.CategoryStruct.comp πM (e_loc S₁).hom) :=
by
  classical
  let AM_type := ULift.{u} (ZMod m)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale.{u}
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale.{u} : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsStableUnderComposition.mk (fun f g hf hg => by
      have : AlgebraicGeometry.Etale f := hf
      have : AlgebraicGeometry.Etale g := hg
      infer_instance)
  have : P_et.IsStableUnderComposition := ‹_›
  have heq_J : ∀ S : AlgebraicGeometry.Scheme.{u},
      S.smallEtaleTopology = (S.smallPretopology P_et P_et).toGrothendieck :=
    fun S => AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl P_et)

  have hEt_map : ∀ {S : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : S.Etale} (f : V₁ ⟶ V₂),
      AlgebraicGeometry.Etale f.left := by
    intro S V₁ V₂ f
    have hcomp : AlgebraicGeometry.Etale (f.left ≫ V₂.hom) := by
      rw [CategoryTheory.MorphismProperty.Over.w f]
      exact V₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      f.left V₂.hom V₂.prop hcomp

  have hSh : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltLocConstPresheaf S m) := by
    intro S
    let J := S.smallEtaleTopology
    let P_loc := weilAltLocConstPresheaf S m
    let P_type : S.Etaleᵒᵖ ⥤ Type u := P_loc ⋙ CategoryTheory.forget AddCommGrpCat.{u}
    have hTypeSheaf : CategoryTheory.Presieve.IsSheaf J P_type := by
      intro U R hR sf hsf
      have hR' : R ∈ (S.smallPretopology P_et P_et).toGrothendieck U :=
        (heq_J S) ▸ hR
      have hCover :=
