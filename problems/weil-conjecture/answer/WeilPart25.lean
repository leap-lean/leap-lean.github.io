      _ = (c'_hom ≫ ι_Cfib_V₂) ≫ p₁_Y :=
            (CategoryTheory.Category.assoc c'_hom ι_Cfib_V₂ p₁_Y).symm
      _ = (fst_C' ≫ W₂_Y₁.hom) ≫ p₁_Y := by
            rw [hcond_C']
      _ = fst_C' ≫ ((u_rel.left ≫ W₁_V₂_open.ι) ≫ p₁_Y) := by
            rw [← hu_rel_w, CategoryTheory.Category.assoc fst_C']
      _ = (fst_C' ≫ e_W₂.inv) ≫ (e_W₂.hom ≫ (u_rel.left ≫ (W₁_V₂_open.ι ≫ p₁_Y))) :=
