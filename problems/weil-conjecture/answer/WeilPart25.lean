                exact h₁'.trans (CategoryTheory.Limits.pullback.lift_snd _ _ (hc_cond c)).symm))
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_δ
        (inferInstance : AlgebraicGeometry.IsClosedImmersion
