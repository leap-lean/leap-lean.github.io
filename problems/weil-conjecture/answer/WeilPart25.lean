        exact (hEmptySub Z_et hEmpZ ℰ₁).elim _ _
    have hSheaf₁ : CategoryTheory.Presieve.IsSheafFor P₁ (CategoryTheory.Presieve.ofArrows E π) :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate
        (CategoryTheory.Presieve.ofArrows E π)).mpr
        (((CategoryTheory.sheafForget J).obj ℰ₁).property.isSheafFor _ hCovSieve)
    obtain ⟨t_glob₀, ht_glob⟩ :=
      ((CategoryTheory.Presieve.isSheafFor_arrows_iff P₁ π).mp hSheaf₁ t hCompat).exists
    let t_glob : ↥(ℰ₁.obj.obj (Opposite.op T_Z)) := t_glob₀
    have hSheaf₂ : CategoryTheory.Presieve.IsSheafFor P₂ (CategoryTheory.Presieve.ofArrows E π) :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate
        (CategoryTheory.Presieve.ofArrows E π)).mpr
        (((CategoryTheory.sheafForget J).obj ℰ₂).property.isSheafFor _ hCovSieve)
    have hCompat₂ : CategoryTheory.Presieve.Arrows.Compatible P₂ π
        (fun i => (ℰ₂.obj.map (π i).op).hom s) := by
      intro i j Z_et gi gj hcomm
      change (ℰ₂.obj.map gi.op).hom ((ℰ₂.obj.map (π i).op).hom s) =
        (ℰ₂.obj.map gj.op).hom ((ℰ₂.obj.map (π j).op).hom s)
      have h1 : ℰ₂.obj.map (π i).op ≫ ℰ₂.obj.map gi.op = ℰ₂.obj.map (gi ≫ π i).op :=
        (ℰ₂.obj.map_comp (π i).op gi.op).symm
      have h2 : ℰ₂.obj.map (π j).op ≫ ℰ₂.obj.map gj.op = ℰ₂.obj.map (gj ≫ π j).op :=
        (ℰ₂.obj.map_comp (π j).op gj.op).symm
      calc
        (ℰ₂.obj.map gi.op).hom ((ℰ₂.obj.map (π i).op).hom s)
          = ((ℰ₂.obj.map (π i).op ≫ ℰ₂.obj.map gi.op).hom) s := rfl
        _ = (ℰ₂.obj.map (gi ≫ π i).op).hom s := by rw [h1]
        _ = (ℰ₂.obj.map (gj ≫ π j).op).hom s := by rw [hcomm]
        _ = ((ℰ₂.obj.map (π j).op ≫ ℰ₂.obj.map gj.op).hom) s := by rw [← h2]
        _ = (ℰ₂.obj.map gj.op).hom ((ℰ₂.obj.map (π j).op).hom s) := rfl
    have hψ_tglob : (ψ.hom.app (Opposite.op T_Z)).hom t_glob = s := by
      refine ((CategoryTheory.Presieve.isSheafFor_arrows_iff P₂ π).mp hSheaf₂
        (fun i => (ℰ₂.obj.map (π i).op).hom s) hCompat₂).unique (fun i => ?_) (fun i => rfl)
      have hnat := congrArg (fun m => m.hom t_glob) (ψ.hom.naturality (π i).op)
      change (ℰ₂.obj.map (π i).op).hom ((ψ.hom.app (Opposite.op T_Z)).hom t_glob) =
        (ℰ₂.obj.map (π i).op).hom s
      calc
        (ℰ₂.obj.map (π i).op).hom ((ψ.hom.app (Opposite.op T_Z)).hom t_glob)
          = (ψ.hom.app (Opposite.op (E i))).hom ((ℰ₁.obj.map (π i).op).hom t_glob) :=
            hnat.symm
        _ = (ψ.hom.app (Opposite.op (E i))).hom (t i) :=
            congrArg (fun x => (ψ.hom.app (Opposite.op (E i))).hom x) (ht_glob i)
        _ = (ℰ₂.obj.map (π i).op).hom s := ht_spec i
    let g_grp : Aℤ ⟶ ℰ₁.obj.obj (Opposite.op T_Z) :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • t_glob
          map_zero' := zero_zsmul t_glob
          map_add' := fun a b => add_zsmul t_glob a.down b.down }
    have hg_ψ : g_grp ≫ ψ.hom.app (Opposite.op T_Z) = f_grp := by
      ext ⟨z⟩
      change (ψ.hom.app (Opposite.op T_Z)).hom (z • t_glob) = f_grp.hom (ULift.up z)
      have hz_eq : (ULift.up z : ULift.{u} ℤ) = z • (ULift.up 1 : ULift.{u} ℤ) := by
        ext
        simp
      rw [map_zsmul, hψ_tglob, hz_eq, map_zsmul]
    refine ⟨(adj.homEquiv Aℤ ℰ₁).symm g_grp, ?_⟩
    calc
      (adj.homEquiv Aℤ ℰ₁).symm g_grp ≫ ψ
        = (adj.homEquiv Aℤ ℰ₂).symm (g_grp ≫ ψ.hom.app (Opposite.op T_Z)) :=
          (adj.homEquiv_naturality_right_symm g_grp ψ).symm
      _ = (adj.homEquiv Aℤ ℰ₂).symm f_grp := by rw [hg_ψ]
      _ = f_hom := (adj.homEquiv Aℤ ℰ₂).symm_apply_apply f_hom

  haveI : CategoryTheory.HasProjectiveDimensionLT Fℤ 1 :=
    CategoryTheory.projective_iff_hasProjectiveDimensionLT_one.mp hProj
  exact CategoryTheory.HasProjectiveDimensionLT.subsingleton Fℤ 1 1 le_rfl G

theorem weil_etale_connected_proper_open_localTorsionH_zero_subsingleton (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S]
    (m : ℕ) (U : S.Opens) (hU : (U : Set ↥S) ≠ Set.univ) :
    Subsingleton
      (weilEtaleLocalTorsionH S m
        (CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι inferInstance) 0) :=
by
  classical
  have _ : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let J := S.smallEtaleTopology
  let U_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι inferInstance
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let LT := weilEtaleLocalTorsionSheaf S m U_et
  let P_U := weilAltZeroBdrySubpresheaf S U m
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let v_hom : ∀ V : S.Etale, (Fgt.obj V).left ⟶ S := fun V => (Fgt.obj V).hom

  have hJ_eq :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S (le_refl _)

  have hMemJ_mp : ∀ {V : S.Etale} {R : CategoryTheory.Sieve V},
      R ∈ J V → ∀ x : ↥(Fgt.obj V).left,
        ∃ (W : S.Etale) (g : W ⟶ V) (w : ↥(Fgt.obj W).left),
          R.arrows g ∧ (Fgt.map g).left w = x := by
    intro V R hR x
    have hR' := Eq.mp (congrArg (fun K => R ∈ K V) hJ_eq) hR
    obtain ⟨W, g, w, hg, _, hw⟩ :=
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) V R).mp hR' x
    exact ⟨W, g, w, hg, hw⟩

  have hMemJ_mpr : ∀ {V : S.Etale} {R : CategoryTheory.Sieve V},
      (∀ x : ↥(Fgt.obj V).left,
        ∃ (W : S.Etale) (g : W ⟶ V) (w : ↥(Fgt.obj W).left),
          R.arrows g ∧ AlgebraicGeometry.Etale (Fgt.map g).left ∧ (Fgt.map g).left w = x) →
      R ∈ J V := by
    intro V R hCov
    have hR' := (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) V R).mpr hCov
    exact Eq.mpr (congrArg (fun K => R ∈ K V) hJ_eq) hR'

  have hEt_arrow : ∀ {W V : S.Etale} (g : W ⟶ V), AlgebraicGeometry.Etale (Fgt.map g).left := by
    intro W V g
    have hcomp : AlgebraicGeometry.Etale ((Fgt.map g).left ≫ (Fgt.obj V).hom) := by
      rw [CategoryTheory.Over.w (Fgt.map g)]
      exact W.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      (Fgt.map g).left (Fgt.obj V).hom V.prop hcomp

  have hSheaf : CategoryTheory.Presheaf.IsSheaf J P_U := by
    intro E V R hR x hx
    let x_hom : ∀ {W : S.Etale} (g : W ⟶ V), R.arrows g → (E ⟶ P_U.obj (Opposite.op W)) :=
      fun g hg => x g hg
    have hCov : ∀ v : ↥(Fgt.obj V).left,
        ∃ (W : S.Etale) (g : W ⟶ V) (_ : R.arrows g) (w : ↥(Fgt.obj W).left),
          (Fgt.map g).left w = v := by
      intro v
      obtain ⟨W, g, w, hg, hw⟩ := hMemJ_mp hR v
      exact ⟨W, g, hg, w, hw⟩
    have hOverlap : ∀ (e : ↥E) {W₁ W₂ : S.Etale}
        (g₁ : W₁ ⟶ V) (hg₁ : R.arrows g₁) (w₁ : ↥(Fgt.obj W₁).left)
        (g₂ : W₂ ⟶ V) (hg₂ : R.arrows g₂) (w₂ : ↥(Fgt.obj W₂).left),
        (Fgt.map g₁).left w₁ = (Fgt.map g₂).left w₂ →
          ((x_hom g₁ hg₁) e).1 w₁ = ((x_hom g₂ hg₂) e).1 w₂ := by
      intro e W₁ W₂ g₁ hg₁ w₁ g₂ hg₂ w₂ heq
      let Z_pb := CategoryTheory.Limits.pullback (Fgt.map g₁).left (Fgt.map g₂).left
      let p₁ : Z_pb ⟶ (Fgt.obj W₁).left :=
        CategoryTheory.Limits.pullback.fst (Fgt.map g₁).left (Fgt.map g₂).left
      let p₂ : Z_pb ⟶ (Fgt.obj W₂).left :=
        CategoryTheory.Limits.pullback.snd (Fgt.map g₁).left (Fgt.map g₂).left
      have _ : AlgebraicGeometry.Etale (Fgt.map g₂).left := hEt_arrow g₂
      have _ : AlgebraicGeometry.Etale p₁ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback (Fgt.map g₁).left (Fgt.map g₂).left).flip
          inferInstance
      have _ : AlgebraicGeometry.Etale (v_hom W₁) := W₁.prop
      let W_pb : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ v_hom W₁) inferInstance
      let π₁ : W_pb ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
      have hπ₂_w : p₂ ≫ v_hom W₂ = p₁ ≫ v_hom W₁ := by
        change p₂ ≫ (Fgt.obj W₂).hom = p₁ ≫ (Fgt.obj W₁).hom
        rw [← CategoryTheory.Over.w (Fgt.map g₂), ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          CategoryTheory.Over.w (Fgt.map g₁)]
      let π₂ : W_pb ⟶ W₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ hπ₂_w trivial
      have hcomm : π₁ ≫ g₁ = π₂ ≫ g₂ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact CategoryTheory.Limits.pullback.condition
      have hcomp_eq : x_hom g₁ hg₁ ≫ P_U.map π₁.op = x_hom g₂ hg₂ ≫ P_U.map π₂.op :=
        hx π₁ π₂ hg₁ hg₂ hcomm
      obtain ⟨z, hz₁, hz₂⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₁ w₂ heq
      have heval := congrArg (fun (k : E ⟶ P_U.obj (Opposite.op W_pb)) => (k e).1 z) hcomp_eq
      change ((x_hom g₁ hg₁) e).1 (p₁ z) = ((x_hom g₂ hg₂) e).1 (p₂ z) at heval
      rwa [hz₁, hz₂] at heval
    let W_v : ↥(Fgt.obj V).left → S.Etale := fun v => Classical.choose (hCov v)
    let g_v : ∀ v : ↥(Fgt.obj V).left, W_v v ⟶ V :=
      fun v => Classical.choose (Classical.choose_spec (hCov v))
    let hg_v : ∀ v : ↥(Fgt.obj V).left, R.arrows (g_v v) :=
      fun v => Classical.choose (Classical.choose_spec (Classical.choose_spec (hCov v)))
    let w_v : ∀ v : ↥(Fgt.obj V).left, ↥(Fgt.obj (W_v v)).left :=
      fun v => Classical.choose (Classical.choose_spec (Classical.choose_spec
        (Classical.choose_spec (hCov v))))
    have hw_v : ∀ v : ↥(Fgt.obj V).left, (Fgt.map (g_v v)).left (w_v v) = v :=
      fun v => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
        (Classical.choose_spec (hCov v))))
    let f_val : ↥E → ↥(Fgt.obj V).left → ULift.{u} (ZMod m) :=
      fun e v => ((x_hom (g_v v) (hg_v v)) e).1 (w_v v)
    have hf_eq : ∀ (e : ↥E) {W : S.Etale} (g : W ⟶ V) (hg : R.arrows g) (w : ↥(Fgt.obj W).left),
        f_val e ((Fgt.map g).left w) = ((x_hom g hg) e).1 w :=
      fun e _ g hg w => hOverlap e (g_v ((Fgt.map g).left w)) (hg_v ((Fgt.map g).left w))
        (w_v ((Fgt.map g).left w)) g hg w (hw_v ((Fgt.map g).left w))
    have hf_loc : ∀ e : ↥E, IsLocallyConstant (f_val e) := by
      intro e T
      have hset : f_val e ⁻¹' T =
          ⋃ (W : S.Etale) (g : W ⟶ V) (hg : R.arrows g),
            ⇑(Fgt.map g).left '' (((x_hom g hg) e).1 ⁻¹' T) := by
        ext v
        simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
        constructor
        · intro hv
          exact ⟨W_v v, g_v v, hg_v v, w_v v, hv, hw_v v⟩
        · rintro ⟨W, g, hg, w, hwT, rfl⟩
          rwa [hf_eq e g hg w]
      rw [hset]
      refine isOpen_iUnion fun W => isOpen_iUnion fun g => isOpen_iUnion fun hg => ?_
      have _ : AlgebraicGeometry.Etale (Fgt.map g).left := hEt_arrow g
      exact (Fgt.map g).left.isOpenMap _ (((x_hom g hg) e).1.isLocallyConstant T)
    let s_sec : ↥E → ↥(P_U.obj (Opposite.op V)) := fun e =>
      ⟨⟨f_val e, hf_loc e⟩, fun v hv => by
        have hw_not : (Fgt.obj (W_v v)).hom (w_v v) ∉ (U : Set ↥S) := by
          intro hmem
          apply hv
          have heq_hom : (Fgt.obj (W_v v)).hom (w_v v) =
              (Fgt.obj V).hom ((Fgt.map (g_v v)).left (w_v v)) := by
            rw [← CategoryTheory.Over.w (Fgt.map (g_v v)),
              AlgebraicGeometry.Scheme.Hom.comp_apply]
          rwa [heq_hom, hw_v v] at hmem
        exact ((x_hom (g_v v) (hg_v v)) e).2 (w_v v) hw_not⟩
    let φ : E ⟶ P_U.obj (Opposite.op V) := AddCommGrpCat.ofHom
      { toFun := s_sec
        map_zero' := Subtype.ext (LocallyConstant.ext fun v => by
          change ((x_hom (g_v v) (hg_v v)) 0).1 (w_v v) = 0
          rw [map_zero]
          rfl)
        map_add' := fun e₁ e₂ => Subtype.ext (LocallyConstant.ext fun v => by
          change ((x_hom (g_v v) (hg_v v)) (e₁ + e₂)).1 (w_v v) =
            ((x_hom (g_v v) (hg_v v)) e₁).1 (w_v v) + ((x_hom (g_v v) (hg_v v)) e₂).1 (w_v v)
          rw [map_add]
          rfl) }
    refine ⟨φ, ?_, ?_⟩
    · intro W g hg
      change φ ≫ P_U.map g.op = x_hom g hg
      apply AddCommGrpCat.ext
      intro e
      apply Subtype.ext
      apply LocallyConstant.ext
      intro w
      exact hf_eq e g hg w
    · intro φ' hφ'
      let φ'_hom : E ⟶ P_U.obj (Opposite.op V) := φ'
      change φ'_hom = φ
      apply AddCommGrpCat.ext
      intro e
      apply Subtype.ext
      apply LocallyConstant.ext
      intro v
      have hspec_hom : φ'_hom ≫ P_U.map (g_v v).op = x_hom (g_v v) (hg_v v) :=
        hφ' (g_v v) (hg_v v)
      have hspec := congrArg (fun (k : E ⟶ P_U.obj (Opposite.op (W_v v))) => (k e).1 (w_v v))
        hspec_hom
      change (φ'_hom e).1 ((Fgt.map (g_v v)).left (w_v v)) =
        ((x_hom (g_v v) (hg_v v)) e).1 (w_v v) at hspec
      rw [hw_v v] at hspec
      exact hspec

  let η : AM ⟶ LT.obj.obj (Opposite.op U_et) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT)
  let LT_set : S.Etaleᵒᵖ ⥤ Type u := LT.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
  have hSh_LT : CategoryTheory.Presieve.IsSheaf J LT_set :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type J LT_set).mp
      (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J LT.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) LT.property)

  have hEmpty_sub : ∀ (W : S.Etale), IsEmpty ↥(Fgt.obj W).left →
      Subsingleton ↥(LT.obj.obj (Opposite.op W)) := by
    intro W hEmp
    have hBot : (⊥ : CategoryTheory.Sieve W) ∈ J W :=
      hMemJ_mpr fun x => IsEmpty.elim hEmp x
    exact ⟨fun s₁ s₂ => (hSh_LT ⊥ hBot).isSeparatedFor.ext fun _ _ hf => False.elim hf⟩

  let E_open : ∀ (V : S.Etale), (Fgt.obj V).left.Opens → S.Etale :=
    fun V O => CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ v_hom V)
      (by have _ : AlgebraicGeometry.Etale (v_hom V) := V.prop; infer_instance)
  let ι_open : ∀ (V : S.Etale) (O : (Fgt.obj V).left.Opens), E_open V O ⟶ V :=
    fun V O => CategoryTheory.MorphismProperty.Over.homMk O.ι rfl trivial

  have hOpenCover_mem : ∀ (V : S.Etale) {I : Type u} (O : I → (Fgt.obj V).left.Opens),
      (∀ x : ↥(Fgt.obj V).left, ∃ i : I, x ∈ O i) →
      CategoryTheory.Sieve.generate
        (CategoryTheory.Presieve.ofArrows (fun i => E_open V (O i)) (fun i => ι_open V (O i))) ∈
        J V := by
    intro V I O hCov
    refine hMemJ_mpr fun x => ?_
    obtain ⟨i, hxi⟩ := hCov x
    have hEt_i : AlgebraicGeometry.Etale (Fgt.map (ι_open V (O i))).left := by
      change AlgebraicGeometry.Etale (O i).ι
      infer_instance
    refine ⟨E_open V (O i), ι_open V (O i), ⟨x, hxi⟩,
      ⟨E_open V (O i), 𝟙 _, ι_open V (O i),
        CategoryTheory.Presieve.ofArrows.mk i, CategoryTheory.Category.id_comp _⟩,
      hEt_i, AlgebraicGeometry.Scheme.Opens.ι_apply (O i) ⟨x, hxi⟩⟩

  have hOpenExt : ∀ (V : S.Etale) {I : Type u} (O : I → (Fgt.obj V).left.Opens),
      (∀ x : ↥(Fgt.obj V).left, ∃ i : I, x ∈ O i) →
      ∀ (s₁ s₂ : ↥(LT.obj.obj (Opposite.op V))),
      (∀ i : I,
        (LT.obj.map (ι_open V (O i)).op) s₁ = (LT.obj.map (ι_open V (O i)).op) s₂) →
      s₁ = s₂ := by
    intro V I O hCov s₁ s₂ hEq_i
    let R_O := CategoryTheory.Presieve.ofArrows (fun i => E_open V (O i)) (fun i => ι_open V (O i))
    have hSh_O : CategoryTheory.Presieve.IsSheafFor LT_set R_O :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate R_O).mpr
        (hSh_LT _ (hOpenCover_mem V O hCov))
    refine hSh_O.isSeparatedFor.ext fun W g hg => ?_
    cases hg with
    | mk i => exact hEq_i i

  let O_c : ∀ (V : S.Etale), ↥(P_U.obj (Opposite.op V)) → ↥AM → (Fgt.obj V).left.Opens :=
    fun V f c => ⟨f.1 ⁻¹' {c}, f.1.isLocallyConstant {c}⟩
  let E_c : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))) (c : ↥AM), S.Etale :=
    fun V f c => E_open V (O_c V f c)
  let ι_c : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))) (c : ↥AM), E_c V f c ⟶ V :=
    fun V f c => ι_open V (O_c V f c)

  let u_c : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))) (c : ↥AM),
      c ≠ 0 → (E_c V f c ⟶ U_et) := fun V f c hc =>
    let g_Vc : (O_c V f c).toScheme ⟶ S := (O_c V f c).ι ≫ v_hom V
    let hRange : Set.range ⇑g_Vc ⊆ Set.range ⇑U.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have hx_ι : (O_c V f c).ι x = x.1 := AlgebraicGeometry.Scheme.Opens.ι_apply (O_c V f c) x
      change v_hom V ((O_c V f c).ι x) ∈ (U : Set ↥S)
      rw [hx_ι]
      by_contra hnot
      exact hc ((x.2 : f.1 x.1 = c).symm.trans (f.2 x.1 hnot))
    let lift_Vc : (O_c V f c).toScheme ⟶ U.toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift U.ι g_Vc hRange
    CategoryTheory.MorphismProperty.Over.homMk
      lift_Vc
      (AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι g_Vc hRange)
      trivial

  let loc_c : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))) (c : ↥AM),
      ↥(LT.obj.obj (Opposite.op (E_c V f c))) :=
    fun V f c => if hc : c = 0 then 0 else (LT.obj.map (u_c V f c hc).op) (η c)

  have hPairCompat : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))) (c₁ c₂ : ↥AM)
      {W : S.Etale} (g₁ : W ⟶ E_c V f c₁) (g₂ : W ⟶ E_c V f c₂),
      g₁ ≫ ι_c V f c₁ = g₂ ≫ ι_c V f c₂ →
      (LT.obj.map g₁.op) (loc_c V f c₁) = (LT.obj.map g₂.op) (loc_c V f c₂) := by
    intro V f c₁ c₂ W g₁ g₂ heq
    by_cases hc : c₁ = c₂
    · subst hc
      have hleft : (Fgt.map g₁).left ≫ (O_c V f c₁).ι = (Fgt.map g₂).left ≫ (O_c V f c₁).ι :=
        congrArg (fun k => (Fgt.map k).left) heq
      have hg_eq : g₁ = g₂ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (CategoryTheory.cancel_mono (O_c V f c₁).ι).mp hleft
      rw [hg_eq]
    · have hEmp : IsEmpty ↥(Fgt.obj W).left := ⟨fun w => hc <| by
        let y₁ : ↥(O_c V f c₁) := (Fgt.map g₁).left w
        let y₂ : ↥(O_c V f c₂) := (Fgt.map g₂).left w
        have hw_eq : (Fgt.map (g₁ ≫ ι_c V f c₁)).left w = (Fgt.map (g₂ ≫ ι_c V f c₂)).left w :=
          congrArg (fun (k : W ⟶ V) => (Fgt.map k).left w) heq
        change (O_c V f c₁).ι y₁ = (O_c V f c₂).ι y₂ at hw_eq
        have hy_eq : y₁.1 = y₂.1 :=
          (AlgebraicGeometry.Scheme.Opens.ι_apply (O_c V f c₁) y₁).symm.trans
            (hw_eq.trans (AlgebraicGeometry.Scheme.Opens.ι_apply (O_c V f c₂) y₂))
        exact y₁.2.symm.trans ((congrArg f.1 hy_eq).trans y₂.2)⟩
      exact (hEmpty_sub W hEmp).elim _ _

  let ψ_pkg : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))),
      { s : ↥(LT.obj.obj (Opposite.op V)) //
        ∀ c : ↥AM, (LT.obj.map (ι_c V f c).op) s = loc_c V f c } := fun V f =>
    let R_Vf := CategoryTheory.Presieve.ofArrows (E_c V f) (ι_c V f)
    let hSh_Vf : CategoryTheory.Presieve.IsSheafFor LT_set R_Vf :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate R_Vf).mpr
        (hSh_LT _ (hOpenCover_mem V (O_c V f) fun x => ⟨f.1 x, rfl⟩))
    let hFac : ∀ {Z : S.Etale} (g : Z ⟶ V), R_Vf g →
        ∃ (c : ↥AM) (u : Z ⟶ E_c V f c), u ≫ ι_c V f c = g := by
      intro Z g hg
      cases hg with
      | mk c => exact ⟨c, 𝟙 _, CategoryTheory.Category.id_comp _⟩
    let fam : CategoryTheory.Presieve.FamilyOfElements LT_set R_Vf := fun Z g hg =>
      let c₀ := Classical.choose (hFac g hg)
      let u₀ := Classical.choose (Classical.choose_spec (hFac g hg))
      (LT.obj.map u₀.op) (loc_c V f c₀)
    let hfam_compat : fam.Compatible := by
      intro Y₁ Y₂ Z f₁ f₂ g₁ g₂ hg₁ hg₂ heq
      let c₁ := Classical.choose (hFac g₁ hg₁)
      let u₁ := Classical.choose (Classical.choose_spec (hFac g₁ hg₁))
      have hu₁ : u₁ ≫ ι_c V f c₁ = g₁ :=
        Classical.choose_spec (Classical.choose_spec (hFac g₁ hg₁))
      let c₂ := Classical.choose (hFac g₂ hg₂)
      let u₂ := Classical.choose (Classical.choose_spec (hFac g₂ hg₂))
      have hu₂ : u₂ ≫ ι_c V f c₂ = g₂ :=
        Classical.choose_spec (Classical.choose_spec (hFac g₂ hg₂))
      change (LT.obj.map f₁.op) ((LT.obj.map u₁.op) (loc_c V f c₁)) =
        (LT.obj.map f₂.op) ((LT.obj.map u₂.op) (loc_c V f c₂))
      have h1 : (LT.obj.map f₁.op) ((LT.obj.map u₁.op) (loc_c V f c₁)) =
          (LT.obj.map (f₁ ≫ u₁).op) (loc_c V f c₁) := by
        have hop : (f₁ ≫ u₁).op = (u₁.op ≫ f₁.op : Opposite.op (E_c V f c₁) ⟶ Opposite.op Z) := rfl
        rw [hop, LT.obj.map_comp]; rfl
      have h2 : (LT.obj.map f₂.op) ((LT.obj.map u₂.op) (loc_c V f c₂)) =
          (LT.obj.map (f₂ ≫ u₂).op) (loc_c V f c₂) := by
        have hop : (f₂ ≫ u₂).op = (u₂.op ≫ f₂.op : Opposite.op (E_c V f c₂) ⟶ Opposite.op Z) := rfl
        rw [hop, LT.obj.map_comp]; rfl
      rw [h1, h2]
      exact hPairCompat V f c₁ c₂ (f₁ ≫ u₁) (f₂ ≫ u₂) (by
        rw [CategoryTheory.Category.assoc, hu₁, heq, CategoryTheory.Category.assoc, hu₂])
    ⟨hSh_Vf.amalgamate fam hfam_compat, fun c => by
      let hg_c : R_Vf (ι_c V f c) := CategoryTheory.Presieve.ofArrows.mk c
      have hg_glue := hSh_Vf.valid_glue hfam_compat (ι_c V f c) hg_c
      change (LT.obj.map (ι_c V f c).op) (hSh_Vf.amalgamate fam hfam_compat) =
        fam (ι_c V f c) hg_c at hg_glue
      rw [hg_glue]
      let c₀ := Classical.choose (hFac (ι_c V f c) hg_c)
      let u₀ := Classical.choose (Classical.choose_spec (hFac (ι_c V f c) hg_c))
      have hu₀ : u₀ ≫ ι_c V f c₀ = ι_c V f c :=
        Classical.choose_spec (Classical.choose_spec (hFac (ι_c V f c) hg_c))
      have hid := hPairCompat V f c₀ c u₀ (𝟙 (E_c V f c))
        (hu₀.trans (CategoryTheory.Category.id_comp _).symm)
      have hop_id : (𝟙 (E_c V f c)).op = 𝟙 (Opposite.op (E_c V f c)) := rfl
      rw [hop_id, LT.obj.map_id] at hid
      exact hid⟩

  let ψ_val : ∀ (V : S.Etale), ↥(P_U.obj (Opposite.op V)) → ↥(LT.obj.obj (Opposite.op V)) :=
    fun V f => (ψ_pkg V f).1
  have hGlue : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))) (c : ↥AM),
      (LT.obj.map (ι_c V f c).op) (ψ_val V f) = loc_c V f c :=
    fun V f c => (ψ_pkg V f).2 c

  have hRestrict_zero : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))) (O : (Fgt.obj V).left.Opens),
      (∀ x : ↥O, f.1 x.1 = 0) →
      (LT.obj.map (ι_open V O).op) (ψ_val V f) = 0 := by
    intro V f O hO
    have hLE : O ≤ O_c V f 0 := fun y hy => hO ⟨y, hy⟩
    let inc_sch : O.toScheme ⟶ (O_c V f 0).toScheme := (Fgt.obj V).left.homOfLE hLE
    have hinc_w : inc_sch ≫ (Fgt.obj (E_c V f 0)).hom = (Fgt.obj (E_open V O)).hom := by
      change inc_sch ≫ (O_c V f 0).ι ≫ v_hom V = O.ι ≫ v_hom V
      rw [← CategoryTheory.Category.assoc, (Fgt.obj V).left.homOfLE_ι]
    let inc : E_open V O ⟶ E_c V f 0 :=
      CategoryTheory.MorphismProperty.Over.homMk inc_sch hinc_w trivial
    have hinc_ι : inc ≫ ι_c V f 0 = ι_open V O := by
      apply CategoryTheory.MorphismProperty.Over.Hom.ext
      exact (Fgt.obj V).left.homOfLE_ι hLE
    have hop : (inc ≫ ι_c V f 0).op = (ι_c V f 0).op ≫ inc.op := rfl
    rw [← hinc_ι, hop, LT.obj.map_comp]
    change (LT.obj.map inc.op) ((LT.obj.map (ι_c V f 0).op) (ψ_val V f)) = 0
    rw [hGlue V f 0]
    have hloc0 : loc_c V f 0 = 0 := by simp only [loc_c, ↓reduceDIte]
    rw [hloc0, map_zero]

  have hRestrict_const : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (O : (Fgt.obj V).left.Opens) (c : ↥AM), (∀ x : ↥O, f.1 x.1 = c) →
      ∀ (u : E_open V O ⟶ U_et),
        (LT.obj.map (ι_open V O).op) (ψ_val V f) = (LT.obj.map u.op) (η c) := by
    intro V f O c hO u
    by_cases hc : c = 0
    · subst hc
      rw [hRestrict_zero V f O hO, map_zero, map_zero]
    · have hLE : O ≤ O_c V f c := fun y hy => hO ⟨y, hy⟩
      let inc_sch : O.toScheme ⟶ (O_c V f c).toScheme := (Fgt.obj V).left.homOfLE hLE
      have hinc_w : inc_sch ≫ (Fgt.obj (E_c V f c)).hom = (Fgt.obj (E_open V O)).hom := by
        change inc_sch ≫ (O_c V f c).ι ≫ v_hom V = O.ι ≫ v_hom V
        rw [← CategoryTheory.Category.assoc, (Fgt.obj V).left.homOfLE_ι]
      let inc : E_open V O ⟶ E_c V f c :=
        CategoryTheory.MorphismProperty.Over.homMk inc_sch hinc_w trivial
      have hinc_ι : inc ≫ ι_c V f c = ι_open V O := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (Fgt.obj V).left.homOfLE_ι hLE
      have hinc_u : inc ≫ u_c V f c hc = u := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        apply (CategoryTheory.cancel_mono U.ι).mp
        exact (CategoryTheory.Over.w (Fgt.map (inc ≫ u_c V f c hc))).trans
          (CategoryTheory.Over.w (Fgt.map u)).symm
      have hop : (inc ≫ ι_c V f c).op = (ι_c V f c).op ≫ inc.op := rfl
      rw [← hinc_ι, hop, LT.obj.map_comp]
      change (LT.obj.map inc.op) ((LT.obj.map (ι_c V f c).op) (ψ_val V f)) = _
      rw [hGlue V f c]
      have hloc : loc_c V f c = (LT.obj.map (u_c V f c hc).op) (η c) := by
        simp only [loc_c, hc, ↓reduceDIte]
      have hop_u : (inc ≫ u_c V f c hc).op = (u_c V f c hc).op ≫ inc.op := rfl
      rw [hloc, ← hinc_u, hop_u, LT.obj.map_comp]
      rfl

  have hψ_zero : ∀ V : S.Etale, ψ_val V 0 = 0 := by
    intro V
    refine hOpenExt V (fun _ : PUnit.{u + 1} => (⊤ : (Fgt.obj V).left.Opens))
      (fun x => ⟨PUnit.unit, TopologicalSpace.Opens.mem_top x⟩) _ _ fun _ => ?_
    rw [hRestrict_zero V 0 ⊤ (fun _ => rfl), map_zero]

  have hψ_add : ∀ (V : S.Etale) (f g : ↥(P_U.obj (Opposite.op V))),
      ψ_val V (f + g) = ψ_val V f + ψ_val V g := by
    intro V f g
    let O_fg : (↥AM × ↥AM) → (Fgt.obj V).left.Opens := fun p => O_c V f p.1 ⊓ O_c V g p.2
    refine hOpenExt V O_fg (fun x => ⟨(f.1 x, g.1 x), rfl, rfl⟩) _ _ fun p => ?_
    rw [map_add]
    have hf_p : ∀ x : ↥(O_fg p), f.1 x.1 = p.1 := fun x => x.2.1
    have hg_p : ∀ x : ↥(O_fg p), g.1 x.1 = p.2 := fun x => x.2.2
    have hfg_p : ∀ x : ↥(O_fg p), (f + g).1 x.1 = p.1 + p.2 :=
      fun x => (LocallyConstant.add_apply f.1 g.1 x.1).trans (congrArg₂ (· + ·) x.2.1 x.2.2)
    by_cases hp : p.1 = 0 ∧ p.2 = 0
    · rcases hp with ⟨hp1, hp2⟩
      have hp12 : p.1 + p.2 = 0 := by rw [hp1, hp2, add_zero]
      rw [hRestrict_zero V (f + g) (O_fg p) (fun x => (hfg_p x).trans hp12),
        hRestrict_zero V f (O_fg p) (fun x => (hf_p x).trans hp1),
        hRestrict_zero V g (O_fg p) (fun x => (hg_p x).trans hp2), add_zero]
    · let g_Vp : (O_fg p).toScheme ⟶ S := (O_fg p).ι ≫ v_hom V
      have hRange : Set.range ⇑g_Vp ⊆ Set.range ⇑U.ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨x, rfl⟩
        have hx_ι : (O_fg p).ι x = x.1 := AlgebraicGeometry.Scheme.Opens.ι_apply (O_fg p) x
        change v_hom V ((O_fg p).ι x) ∈ (U : Set ↥S)
        rw [hx_ι]
        by_contra hnot
        exact hp ⟨(hf_p x).symm.trans (f.2 x.1 hnot), (hg_p x).symm.trans (g.2 x.1 hnot)⟩
      let lift_Vp : (O_fg p).toScheme ⟶ U.toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift U.ι g_Vp hRange
      let u_p : E_open V (O_fg p) ⟶ U_et := CategoryTheory.MorphismProperty.Over.homMk
        lift_Vp
        (AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι g_Vp hRange)
        trivial
      rw [hRestrict_const V (f + g) (O_fg p) (p.1 + p.2) hfg_p u_p,
        hRestrict_const V f (O_fg p) p.1 hf_p u_p,
        hRestrict_const V g (O_fg p) p.2 hg_p u_p, map_add, map_add]

  let Ψ_pre : P_U ⟶ LT.obj :=
    { app := fun V => AddCommGrpCat.ofHom
        { toFun := ψ_val V.unop
          map_zero' := hψ_zero V.unop
          map_add' := hψ_add V.unop }
      naturality := fun {V₁ V₂} h_op => by
        let h : V₂.unop ⟶ V₁.unop := h_op.unop
        ext f
        let f' : ↥(P_U.obj (Opposite.op V₂.unop)) := (P_U.map h.op) f
        change ψ_val V₂.unop f' = (LT.obj.map h.op) (ψ_val V₁.unop f)
        refine hOpenExt V₂.unop (O_c V₂.unop f') (fun w => ⟨f'.1 w, rfl⟩) _ _ fun c => ?_
        change (LT.obj.map (ι_c V₂.unop f' c).op) (ψ_val V₂.unop f') =
          (LT.obj.map (ι_c V₂.unop f' c).op) ((LT.obj.map h.op) (ψ_val V₁.unop f))
        rw [hGlue V₂.unop f' c]
        have hRange_c : Set.range ⇑((O_c V₂.unop f' c).ι ≫ (Fgt.map h).left) ⊆
            Set.range ⇑(O_c V₁.unop f c).ι := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨x, rfl⟩
          have hx_ι : (O_c V₂.unop f' c).ι x = x.1 :=
            AlgebraicGeometry.Scheme.Opens.ι_apply (O_c V₂.unop f' c) x
          change (Fgt.map h).left ((O_c V₂.unop f' c).ι x) ∈ O_c V₁.unop f c
          rw [hx_ι]
          exact x.2
        let lift_hc := AlgebraicGeometry.IsOpenImmersion.lift (O_c V₁.unop f c).ι
          ((O_c V₂.unop f' c).ι ≫ (Fgt.map h).left) hRange_c
        have hfac_hc : lift_hc ≫ (O_c V₁.unop f c).ι = (O_c V₂.unop f' c).ι ≫ (Fgt.map h).left :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac (O_c V₁.unop f c).ι
            ((O_c V₂.unop f' c).ι ≫ (Fgt.map h).left) hRange_c
        have hw_hc : lift_hc ≫ (Fgt.obj (E_c V₁.unop f c)).hom =
            (Fgt.obj (E_c V₂.unop f' c)).hom := by
          change lift_hc ≫ (O_c V₁.unop f c).ι ≫ (Fgt.obj V₁.unop).hom =
            (O_c V₂.unop f' c).ι ≫ (Fgt.obj V₂.unop).hom
          rw [← CategoryTheory.Category.assoc, hfac_hc, CategoryTheory.Category.assoc,
            CategoryTheory.Over.w (Fgt.map h)]
        let h_c : E_c V₂.unop f' c ⟶ E_c V₁.unop f c :=
          CategoryTheory.MorphismProperty.Over.homMk lift_hc hw_hc trivial
        have hcomm_hc : ι_c V₂.unop f' c ≫ h = h_c ≫ ι_c V₁.unop f c := by
          apply CategoryTheory.MorphismProperty.Over.Hom.ext
          exact hfac_hc.symm
        have hop₁ : (ι_c V₂.unop f' c ≫ h).op = h.op ≫ (ι_c V₂.unop f' c).op := rfl
        have hop₂ : (h_c ≫ ι_c V₁.unop f c).op = (ι_c V₁.unop f c).op ≫ h_c.op := rfl
        have hRHS : (LT.obj.map (ι_c V₂.unop f' c).op) ((LT.obj.map h.op) (ψ_val V₁.unop f)) =
            (LT.obj.map h_c.op) (loc_c V₁.unop f c) := by
          calc
            (LT.obj.map (ι_c V₂.unop f' c).op) ((LT.obj.map h.op) (ψ_val V₁.unop f))
              = (LT.obj.map (ι_c V₂.unop f' c ≫ h).op) (ψ_val V₁.unop f) := by
                  rw [hop₁, LT.obj.map_comp]; rfl
            _ = (LT.obj.map (h_c ≫ ι_c V₁.unop f c).op) (ψ_val V₁.unop f) := by rw [hcomm_hc]
            _ = (LT.obj.map h_c.op) ((LT.obj.map (ι_c V₁.unop f c).op) (ψ_val V₁.unop f)) := by
                  rw [hop₂, LT.obj.map_comp]; rfl
            _ = (LT.obj.map h_c.op) (loc_c V₁.unop f c) := by rw [hGlue V₁.unop f c]
        rw [hRHS]
        by_cases hc : c = 0
        · subst hc
          have h1 : loc_c V₂.unop f' 0 = 0 := by simp only [loc_c, ↓reduceDIte]
          have h2 : loc_c V₁.unop f 0 = 0 := by simp only [loc_c, ↓reduceDIte]
          rw [h1, h2, map_zero]
        · have h1 : loc_c V₂.unop f' c = (LT.obj.map (u_c V₂.unop f' c hc).op) (η c) := by
            simp only [loc_c, hc, ↓reduceDIte]
          have h2 : loc_c V₁.unop f c = (LT.obj.map (u_c V₁.unop f c hc).op) (η c) := by
            simp only [loc_c, hc, ↓reduceDIte]
          rw [h1, h2]
          have hu_eq : h_c ≫ u_c V₁.unop f c hc = u_c V₂.unop f' c hc := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            apply (CategoryTheory.cancel_mono U.ι).mp
            exact (CategoryTheory.Over.w (Fgt.map (h_c ≫ u_c V₁.unop f c hc))).trans
              (CategoryTheory.Over.w (Fgt.map (u_c V₂.unop f' c hc))).symm
          have hop_u : (h_c ≫ u_c V₁.unop f c hc).op = (u_c V₁.unop f c hc).op ≫ h_c.op := rfl
          rw [← hu_eq, hop_u, LT.obj.map_comp]
          rfl }

  let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P_U, hSheaf⟩
  let φ₀ : AM ⟶ L_sh.obj.obj (Opposite.op U_et) := AddCommGrpCat.ofHom
    { toFun := fun c =>
        ⟨LocallyConstant.const ↥(Fgt.obj U_et).left c, fun x hx =>
          False.elim (hx ((AlgebraicGeometry.Scheme.Opens.ι_apply U x).symm ▸ x.2))⟩
      map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
      map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
  let Φ : LT ⟶ L_sh := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm φ₀
  let Ψ : L_sh ⟶ LT := CategoryTheory.ObjectProperty.homMk Ψ_pre

  have hΨ_gen : ∀ c : ↥AM, (Ψ_pre.app (Opposite.op U_et)) (φ₀ c) = η c := by
    intro c
    change ψ_val U_et (φ₀ c) = η c
    refine hOpenExt U_et (fun _ : PUnit.{u + 1} => (⊤ : (Fgt.obj U_et).left.Opens))
      (fun x => ⟨PUnit.unit, TopologicalSpace.Opens.mem_top x⟩) _ _ fun _ => ?_
    exact hRestrict_const U_et (φ₀ c) ⊤ c (fun _ => rfl) (ι_open U_et ⊤)

  have hEquiv_comp : ∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (α : LT ⟶ F) (g : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U_et) := by
    intro F G α g
    let α' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda U_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hΦΨ : Φ ≫ Ψ = CategoryTheory.CategoryStruct.id LT := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hEquiv_comp Φ Ψ, Equiv.apply_symm_apply]
    ext c
    exact hΨ_gen c

  let T_S := weilEtaleIdTerminal.{u} S
  let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
  obtain ⟨x₀, hx₀⟩ := (Set.ne_univ_iff_exists_notMem (U : Set ↥S)).mp hU

  have hSub_L : Subsingleton ↥(L_sh.obj.obj (Opposite.op T_S)) := by
    have hZero : ∀ f : ↥(L_sh.obj.obj (Opposite.op T_S)), f = 0 := by
      intro f
      have _ : Nonempty (ULift.{u} (ZMod m)) := ⟨0⟩
      obtain ⟨c₀, hc₀⟩ := @IsLocallyConstant.exists_eq_const ↥S (ULift.{u} (ZMod m)) _
        inferInstance inferInstance f.1 f.1.isLocallyConstant
      have hc₀_zero : c₀ = 0 := by
        have hx₀_zero : f.1 x₀ = 0 := f.2 x₀ hx₀
        exact (congrFun hc₀ x₀).symm.trans hx₀_zero
      apply Subtype.ext
      apply LocallyConstant.ext
      intro x
      exact (congrFun hc₀ x).trans hc₀_zero
    exact ⟨fun f₁ f₂ => (hZero f₁).trans (hZero f₂).symm⟩

  have hSub_LT : Subsingleton ↥(LT.obj.obj (Opposite.op T_S)) := ⟨fun s₁ s₂ => by
    have hEq_L : (Φ.hom.app (Opposite.op T_S)) s₁ = (Φ.hom.app (Opposite.op T_S)) s₂ :=
      hSub_L.elim _ _
    have hEq_Ψ := congrArg (Ψ.hom.app (Opposite.op T_S)) hEq_L
    have hid₁ := congrArg (fun (k : LT ⟶ LT) => (k.hom.app (Opposite.op T_S)) s₁) hΦΨ
    have hid₂ := congrArg (fun (k : LT ⟶ LT) => (k.hom.app (Opposite.op T_S)) s₂) hΦΨ
    exact hid₁.symm.trans (hEq_Ψ.trans hid₂)⟩

  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let adj_S := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
  let e_H : weilEtaleLocalTorsionH S m U_et 0 ≃ (Aℤ ⟶ LT.obj.obj (Opposite.op T_S)) :=
    CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans (adj_S.homEquiv Aℤ LT)
  have hSubHom : Subsingleton (Aℤ ⟶ LT.obj.obj (Opposite.op T_S)) :=
    ⟨fun α β => AddCommGrpCat.ext fun z => hSub_LT.elim (α z) (β z)⟩
  exact (Equiv.subsingleton_congr e_H).mpr hSubHom

theorem weil_etale_finite_rel_open_localTorsion_r1_iso (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ) :
