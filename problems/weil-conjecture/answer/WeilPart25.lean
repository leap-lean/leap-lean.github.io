    intro E U R hR Φ hΦ
    have hFor : CategoryTheory.Presieve.IsSheafFor P_type R.arrows := hTypeSheaf R hR
    let sf_e : ∀ e : ↑E, CategoryTheory.Presieve.FamilyOfElements P_type R.arrows :=
      fun e Y f hf => (Φ f hf).hom e
    have hsf_e : ∀ e : ↑E, (sf_e e).Compatible := by
      intro e Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hg
