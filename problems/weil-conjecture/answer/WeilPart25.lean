  have hzsmul_zmod :
      ∀ {A : Type u} [AddCommGroup A] (hA : ∀ x : A, (m : ℤ) • x = 0)
        {k₁ k₂ : ℤ}, (k₁ : ZMod m) = (k₂ : ZMod m) → ∀ x : A, k₁ • x = k₂ • x := by
    intro A _ hA k₁ k₂ hk x
    obtain ⟨q, hq⟩ := (ZMod.intCast_eq_intCast_iff_dvd_sub k₂ k₁ m).mp hk.symm
    have hsub : k₁ • x - k₂ • x = 0 := by
      rw [sub_eq_add_neg, ← sub_zsmul, hq, mul_comm, mul_zsmul, hA x, zsmul_zero]
    exact sub_eq_zero.mp hsub

  let valMinAbsModule : ∀ (A : Type u) [AddCommGroup A],
      (∀ x : A, (m : ℤ) • x = 0) → Module R A := fun A _ hA =>
    { smul := fun r x => r.down.valMinAbs • x
      one_smul := fun x => by
        change (1 : R).down.valMinAbs • x = x
        have hk : (((1 : R).down.valMinAbs : ℤ) : ZMod m) = ((1 : ℤ) : ZMod m) := by simp
        rw [hzsmul_zmod hA hk x, one_zsmul]
      mul_smul := fun r s x => by
        change (r * s).down.valMinAbs • x = r.down.valMinAbs • (s.down.valMinAbs • x)
        have hk : (((r * s).down.valMinAbs : ℤ) : ZMod m) =
            ((r.down.valMinAbs * s.down.valMinAbs : ℤ) : ZMod m) := by push_cast; rfl
        rw [hzsmul_zmod hA hk x, mul_zsmul]
      smul_zero := fun _ => zsmul_zero _
      smul_add := fun _ _ _ => zsmul_add _ _ _
      add_smul := fun r s x => by
        change (r + s).down.valMinAbs • x = r.down.valMinAbs • x + s.down.valMinAbs • x
        have hk : (((r + s).down.valMinAbs : ℤ) : ZMod m) =
            ((r.down.valMinAbs + s.down.valMinAbs : ℤ) : ZMod m) := by push_cast; rfl
        rw [hzsmul_zmod hA hk x, add_zsmul]
      zero_smul := fun x => by
        change (0 : R).down.valMinAbs • x = 0
        have hk : (((0 : R).down.valMinAbs : ℤ) : ZMod m) = ((0 : ℤ) : ZMod m) := by simp
        rw [hzsmul_zmod hA hk x, zero_zsmul] }

  have hulift_smul :
      ∀ {E : Type u} [AddCommGroup E] [Module R E] (r : R) (e : E),
        r • e = r.down.valMinAbs • e := by
    intro E _ _ r e
    have hr : ((r.down.valMinAbs : ℤ) : R) = r := ULift.ext _ _ (ZMod.coe_valMinAbs r.down)
    rw [← Int.cast_smul_eq_zsmul R r.down.valMinAbs e, hr]

  let fgtModFF : FgtMod.FullyFaithful :=
    { preimage := fun {X Y} f =>
        ModuleCat.ofHom
          { toFun := fun x : ↥X => (f.hom x : ↥Y)
            map_add' := fun x y => f.hom.map_add x y
            map_smul' := fun (r : R) (x : ↥X) => by
              dsimp
              let y : ↥Y := f.hom x
              change f.hom (r • x) = r • y
              rw [hulift_smul r x, hulift_smul r y]
              exact map_zsmul f.hom r.down.valMinAbs x }
      map_preimage := fun _ => rfl
      preimage_map := fun _ => rfl }

  let mkSheafComposeFF :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        (J : CategoryTheory.GrothendieckTopology C) [J.HasSheafCompose FgtMod],
        (CategoryTheory.sheafCompose J FgtMod).FullyFaithful := fun J _ =>
    { preimage := fun {X Y} f =>
        CategoryTheory.ObjectProperty.homMk
          { app := fun W => fgtModFF.preimage (f.hom.app W)
            naturality := fun {W₁ W₂} u => by
              apply fgtModFF.map_injective
              rw [FgtMod.map_comp, FgtMod.map_comp]
              exact f.hom.naturality u }
      map_preimage := fun f => by
        apply CategoryTheory.Sheaf.hom_ext
        exact CategoryTheory.NatTrans.ext (funext fun W => fgtModFF.map_preimage (f.hom.app W))
      preimage_map := fun f => by
        apply CategoryTheory.Sheaf.hom_ext
        exact CategoryTheory.NatTrans.ext (funext fun W => fgtModFF.preimage_map (f.hom.app W)) }

  let uStdFF_1 : U_std_1.FullyFaithful := mkSheafComposeFF J₁
  let uStdFF_2 : U_std_2.FullyFaithful := mkSheafComposeFF J₂
  have : U_std_1.Full := uStdFF_1.full
  have : U_std_1.Faithful := uStdFF_1.faithful
  have : CategoryTheory.Limits.ReflectsLimitsOfSize.{0, 0} U_std_1 :=
