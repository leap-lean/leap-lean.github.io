        _ = P.e_W.hom ≫ P.W_open.ι ≫ P.π_Y₁ := by rw [hj_WQ_ι]
        _ = (Fgt_Y.map P.u_W).left ≫ (E.e_W₁.hom ≫ E.W₁_open.ι) := P.hu_W_comp.symm
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.lift_snd]
      calc
        (P.e_W.hom ≫ j_WQ) ≫ (Q_open.ι ≫ P.f_bar)
          = P.e_W.hom ≫ (j_WQ ≫ Q_open.ι) ≫ P.f_bar := by
              simp only [CategoryTheory.Category.assoc]
        _ = P.e_W.hom ≫ P.W_open.ι ≫ P.f_bar := by rw [hj_WQ_ι]
  haveI : AlgebraicGeometry.IsProper P.f_bar := P.hProp_f
  have hSep_Qf : AlgebraicGeometry.IsSeparated
      (ψ_Q ≫ CategoryTheory.Limits.pullback.snd f_W₁ g_VP) := by
    rw [CategoryTheory.Limits.pullback.lift_snd]
