by
  intro P_et pb_g adj_g pb_ι adj_ι B_f₀ B_g B_f₁ B_ι e_fun shAdj_of Z_fun ι_gen
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
