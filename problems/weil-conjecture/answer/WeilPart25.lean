        exact ((congrArg (ev_Y j)
          ((congrArg ((τ_sh.hom.app (Opposite.op (S_j j))).hom) h0_inner).trans
            (map_zero _))).trans (map_zero _)).trans
          (ite_eq_right_iff.mpr (fun h => (hij h).elim)).symm

    have hComp_id :
        ∀ c : Fin d → ZMod ℓ,
          Ξ_Y (τ_cod (bc_Tk (θ_Tk (ι_dom (Φ_dom c))))) = c := by
      intro c
      let Ψ_lin : ↥(L_Ey.obj.obj (Opposite.op T_k)) →+ (Fin d → ZMod ℓ) :=
        Ξ_Y.comp (τ_cod.comp (bc_Tk.comp (θ_Tk.comp ι_dom)))
      have hsum : Ψ_lin (Φ_dom c) =
          ∑ i : Fin d, (c i).val • Ψ_lin (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey) :=
        (map_sum Ψ_lin
          (fun i : Fin d => (c i).val • (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey))
          Finset.univ).trans
          (Finset.sum_congr rfl fun i _ =>
            map_nsmul Ψ_lin (c i).val (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey))
      funext j
      have happ := (congrFun hsum j).trans
        (Finset.sum_apply j Finset.univ
          (fun i : Fin d => (c i).val • Ψ_lin (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey)))
      refine happ.trans ((Finset.sum_eq_single j ?_ ?_).trans ?_)
      · intro i _ hij
        change (c i).val •
            Ξ_Y (τ_cod (bc_Tk (θ_Tk (ι_dom (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey))))) j = 0
        exact (congrArg ((c i).val • ·)
          ((hMatrix_ij i j).trans (ite_eq_right_iff.mpr (fun h => (hij h).elim)))).trans
          (nsmul_zero _)
      · intro hj_abs; exact (hj_abs (Finset.mem_univ j)).elim
      · change (c j).val •
            Ξ_Y (τ_cod (bc_Tk (θ_Tk (ι_dom (((L_Ey.obj.map (Opposite.op (σ j))).hom) gen_Ey))))) j = c j
        have h1 : (c j).val • (1 : ZMod ℓ) = c j := by
          rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
        exact (congrArg ((c j).val • ·)
          ((hMatrix_ij j j).trans (ite_eq_left_iff.mpr (fun h => (h rfl).elim)))).trans h1

    have hΦ_inj : Function.Injective Φ_dom :=
      fun c₁ c₂ h => (hComp_id c₁).symm.trans
        ((congrArg (fun x => Ξ_Y (τ_cod (bc_Tk (θ_Tk (ι_dom x))))) h).trans (hComp_id c₂))
    have hΦ_bij : Function.Bijective Φ_dom := ⟨hΦ_inj, hΦ_surj⟩
    have hΞ_surj : Function.Surjective Ξ_Y :=
      fun c => ⟨τ_cod (bc_Tk (θ_Tk (ι_dom (Φ_dom c)))), hComp_id c⟩
    have hΞ_bij : Function.Bijective Ξ_Y := ⟨hΞ_inj, hΞ_surj⟩

    let e_ι_dom : ↥(L_Ey.obj.obj (Opposite.op T_k)) ≃ ↥((pb_y.obj F₁).obj.obj (Opposite.op T_k)) :=
      { toFun := ι_dom
        invFun := (e_F₁_iso.inv.hom.app (Opposite.op T_k)).hom
        left_inv := fun x =>
          congrArg (fun φ => (φ.hom.app (Opposite.op T_k)).hom x) e_F₁_iso.hom_inv_id
        right_inv := fun x =>
          congrArg (fun φ => (φ.hom.app (Opposite.op T_k)).hom x) e_F₁_iso.inv_hom_id }
    have hθ_inj : Function.Injective θ_Tk := by
      intro x₁ x₂ hx
      obtain ⟨c₁, hc₁⟩ := (e_ι_dom.bijective.comp hΦ_bij).2 x₁
      obtain ⟨c₂, hc₂⟩ := (e_ι_dom.bijective.comp hΦ_bij).2 x₂
      change ι_dom (Φ_dom c₁) = x₁ at hc₁
      change ι_dom (Φ_dom c₂) = x₂ at hc₂
      have hc_eq : c₁ = c₂ :=
        (hComp_id c₁).symm.trans
          ((congrArg (fun y => Ξ_Y (τ_cod (bc_Tk y)))
            ((congrArg θ_Tk hc₁).trans (hx.trans (congrArg θ_Tk hc₂.symm)))).trans
            (hComp_id c₂))
      exact hc₁.symm.trans ((congrArg (fun c => ι_dom (Φ_dom c)) hc_eq).trans hc₂)

    let e_BC : ↥((pb_y.obj (pf_ν.obj F₂)).obj.obj (Opposite.op T_k)) ≃
        ↥((pf_p.obj (pb_ι.obj F₂)).obj.obj (Opposite.op T_k)) :=
      { toFun := (e_iso.hom.hom.app (Opposite.op T_k)).hom
        invFun := (e_iso.inv.hom.app (Opposite.op T_k)).hom
        left_inv := fun x =>
          congrArg (fun φ => (φ.hom.app (Opposite.op T_k)).hom x) e_iso.hom_inv_id
        right_inv := fun x =>
          congrArg (fun φ => (φ.hom.app (Opposite.op T_k)).hom x) e_iso.inv_hom_id }
    let τ_sh_iso : pb_ι.obj F₂ ≅ L_Y2 := e_F'_iso.symm ≪≫ e_LU
    let e_τ_cod : ↥((pf_p.obj (pb_ι.obj F₂)).obj.obj (Opposite.op T_k)) ≃
        ↥(L_Y2.obj.obj (Opposite.op T_Y2)) :=
      { toFun := fun x =>
          ((L_Y2.obj.map (Opposite.op e_Tp.inv)).hom)
            (((τ_sh_iso.hom.hom.app (Opposite.op (B_p.obj T_k))).hom) x)
        invFun := fun z =>
          ((τ_sh_iso.inv.hom.app (Opposite.op (B_p.obj T_k))).hom)
            (((L_Y2.obj.map (Opposite.op e_Tp.hom)).hom) z)
        left_inv := fun x => by
          have hop : (Opposite.op e_Tp.inv ≫ Opposite.op e_Tp.hom :
              Opposite.op (B_p.obj T_k) ⟶ Opposite.op (B_p.obj T_k)) =
              Opposite.op (e_Tp.hom ≫ e_Tp.inv) := rfl
          have hmap_id : L_Y2.obj.map (Opposite.op e_Tp.inv) ≫
              L_Y2.obj.map (Opposite.op e_Tp.hom) =
              CategoryTheory.CategoryStruct.id (L_Y2.obj.obj (Opposite.op (B_p.obj T_k))) :=
            (L_Y2.obj.map_comp (Opposite.op e_Tp.inv) (Opposite.op e_Tp.hom)).symm.trans
              ((congrArg L_Y2.obj.map (hop.trans (congrArg Opposite.op e_Tp.hom_inv_id))).trans
                (L_Y2.obj.map_id (Opposite.op (B_p.obj T_k))))
          have h1 : ((L_Y2.obj.map (Opposite.op e_Tp.hom)).hom)
              (((L_Y2.obj.map (Opposite.op e_Tp.inv)).hom)
                (((τ_sh_iso.hom.hom.app (Opposite.op (B_p.obj T_k))).hom) x)) =
              ((τ_sh_iso.hom.hom.app (Opposite.op (B_p.obj T_k))).hom) x :=
            congrArg (fun g => g.hom (((τ_sh_iso.hom.hom.app (Opposite.op (B_p.obj T_k))).hom) x))
              hmap_id
          have h2 : ((τ_sh_iso.inv.hom.app (Opposite.op (B_p.obj T_k))).hom)
              (((τ_sh_iso.hom.hom.app (Opposite.op (B_p.obj T_k))).hom) x) = x :=
            congrArg (fun φ => (φ.hom.app (Opposite.op (B_p.obj T_k))).hom x) τ_sh_iso.hom_inv_id
          exact (congrArg ((τ_sh_iso.inv.hom.app (Opposite.op (B_p.obj T_k))).hom) h1).trans h2
        right_inv := fun z => by
          have hop : (Opposite.op e_Tp.hom ≫ Opposite.op e_Tp.inv :
              Opposite.op T_Y2 ⟶ Opposite.op T_Y2) =
              Opposite.op (e_Tp.inv ≫ e_Tp.hom) := rfl
          have hmap_id : L_Y2.obj.map (Opposite.op e_Tp.hom) ≫
              L_Y2.obj.map (Opposite.op e_Tp.inv) =
              CategoryTheory.CategoryStruct.id (L_Y2.obj.obj (Opposite.op T_Y2)) :=
            (L_Y2.obj.map_comp (Opposite.op e_Tp.hom) (Opposite.op e_Tp.inv)).symm.trans
              ((congrArg L_Y2.obj.map (hop.trans (congrArg Opposite.op e_Tp.inv_hom_id))).trans
                (L_Y2.obj.map_id (Opposite.op T_Y2)))
          have h1 : ((τ_sh_iso.hom.hom.app (Opposite.op (B_p.obj T_k))).hom)
              (((τ_sh_iso.inv.hom.app (Opposite.op (B_p.obj T_k))).hom)
                (((L_Y2.obj.map (Opposite.op e_Tp.hom)).hom) z)) =
              ((L_Y2.obj.map (Opposite.op e_Tp.hom)).hom) z :=
            congrArg (fun φ => (φ.hom.app (Opposite.op (B_p.obj T_k))).hom
              (((L_Y2.obj.map (Opposite.op e_Tp.hom)).hom) z)) τ_sh_iso.inv_hom_id
          have h2 : ((L_Y2.obj.map (Opposite.op e_Tp.inv)).hom)
              (((L_Y2.obj.map (Opposite.op e_Tp.hom)).hom) z) = z :=
            congrArg (fun g => g.hom z) hmap_id
          exact (congrArg ((L_Y2.obj.map (Opposite.op e_Tp.inv)).hom) h1).trans h2 }
    let e_BA : ↥((pb_y.obj (pf_ν.obj F₂)).obj.obj (Opposite.op T_k)) ≃
        ↥((pb_y.obj F₁).obj.obj (Opposite.op T_k)) :=
      e_BC.trans (e_τ_cod.trans ((Equiv.ofBijective Ξ_Y hΞ_bij).trans
        ((Equiv.ofBijective Φ_dom hΦ_bij).trans e_ι_dom)))
    have : Finite ↥((pb_y.obj F₁).obj.obj (Opposite.op T_k)) :=
      Finite.of_equiv (Fin d → ZMod ℓ) ((Equiv.ofBijective Φ_dom hΦ_bij).trans e_ι_dom)
    have hcomp_bij : Function.Bijective (e_BA ∘ θ_Tk) :=
      Finite.injective_iff_bijective.mp (e_BA.injective.comp hθ_inj)
    have heq_θ : (θ_Tk : _ → _) = e_BA.symm ∘ (e_BA ∘ θ_Tk) :=
      funext fun x => (e_BA.symm_apply_apply (θ_Tk x)).symm
    exact heq_θ ▸ e_BA.symm.bijective.comp hcomp_bij

  · have hEmp_Ey : IsEmpty ↥E_y.left := by
      refine ⟨fun z => hy ?_⟩
      let x_W : ↥W₂_et.left := (CategoryTheory.Limits.pullback.fst W₂_et.hom s_y).base z
      have hsnd : (CategoryTheory.Limits.pullback.snd W₂_et.hom s_y).base z = pt_k :=
        hSub_k.elim _ _
      have hy_eq : W₂_et.hom.base x_W = y :=
        (congrArg (fun f => f.base z)
          (CategoryTheory.Limits.pullback.condition (f := W₂_et.hom) (g := s_y))).trans
          (congrArg s_y.base hsnd)
      have hy_eq' : ν.base (U₂.ι.base (e₂.hom.base x_W)) = y :=
        (congrArg (fun f => f.base x_W) he₂).trans hy_eq
      have hmU₂ : U₂.ι.base (e₂.hom.base x_W) ∈ U₂ := (e₂.hom.base x_W).2
      have hmU₁ : ν.base (U₂.ι.base (e₂.hom.base x_W)) ∈ U₁ :=
        Eq.mp (congrArg (fun O : Y₂.left.Opens => U₂.ι.base (e₂.hom.base x_W) ∈ O) hU₂) hmU₂
      exact Eq.mp (congrArg (· ∈ U₁) hy_eq') hmU₁
    have hEmp_U'y : IsEmpty ↥U'_y.left := by
      refine ⟨fun z => hy ?_⟩
      let x_U : ↥U₂.toScheme := (CategoryTheory.Limits.pullback.fst U₂.ι ι_y).base z
      let x_Y : ↥Y₂_y := (CategoryTheory.Limits.pullback.snd U₂.ι ι_y).base z
      have hpz : p_y.base x_Y = pt_k := hSub_k.elim _ _
      have h1 : U₂.ι.base x_U = ι_y.base x_Y :=
        congrArg (fun f => f.base z)
          (CategoryTheory.Limits.pullback.condition (f := U₂.ι) (g := ι_y))
      have hy_eq : ν.base (U₂.ι.base x_U) = y :=
        (congrArg ν.base h1).trans
          ((congrArg (fun f => f.base x_Y)
            (CategoryTheory.Limits.pullback.condition (f := ν) (g := s_y))).trans
            (congrArg s_y.base hpz))
      have hmU₂ : U₂.ι.base x_U ∈ U₂ := x_U.2
      have hmU₁ : ν.base (U₂.ι.base x_U) ∈ U₁ :=
        Eq.mp (congrArg (fun O : Y₂.left.Opens => U₂.ι.base x_U ∈ O) hU₂) hmU₂
      exact Eq.mp (congrArg (· ∈ U₁) hy_eq) hmU₁

    obtain ⟨hIso_eF₁, _⟩ := hPb_nat s_y ℓ W₂_et
    obtain ⟨hIso_eF', _⟩ := hPb_nat ι_y ℓ U₂_et
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
    let adj_y := (weilEtaleSitePullback s_y).sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₁.left.smallEtaleTopology S_k.smallEtaleTopology
    let pf_y := (weilEtaleSitePullback s_y).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₁.left.smallEtaleTopology S_k.smallEtaleTopology
    let u_sW : F₁ ⟶ pf_y.obj (pb_y.obj F₁) := adj_y.unit.app F₁
    let η_sW₀ : AM ⟶ (pf_y.obj (pb_y.obj F₁)).obj.obj (Opposite.op W₂_et) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv u_sW
    let η_sW : AM ⟶ (pb_y.obj F₁).obj.obj (Opposite.op E_y) := η_sW₀
    let e_sW : weilEtaleLocalTorsionSheaf S_k ℓ E_y ⟶ pb_y.obj F₁ :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm η_sW
    have : CategoryTheory.IsIso e_sW := hIso_eF₁

    let adj_ι := (weilEtaleSitePullback ι_y).sheafAdjunctionContinuous AddCommGrpCat.{u}
      Y₂.left.smallEtaleTopology Y₂_y.smallEtaleTopology
    let pf_ι := (weilEtaleSitePullback ι_y).sheafPushforwardContinuous AddCommGrpCat.{u}
      Y₂.left.smallEtaleTopology Y₂_y.smallEtaleTopology
    let u_ιU : F₂ ⟶ pf_ι.obj (pb_ι.obj F₂) := adj_ι.unit.app F₂
    let η_ιU₀ : AM ⟶ (pf_ι.obj (pb_ι.obj F₂)).obj.obj (Opposite.op U₂_et) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv u_ιU
    let η_ιU : AM ⟶ (pb_ι.obj F₂).obj.obj (Opposite.op U'_y) := η_ιU₀
    let e_ιU : weilEtaleLocalTorsionSheaf Y₂_y ℓ U'_y ⟶ pb_ι.obj F₂ :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm η_ιU
    have : CategoryTheory.IsIso e_ιU := hIso_eF'

    have hZ_F₁ : CategoryTheory.Limits.IsZero (pb_y.obj F₁) :=
      (hEmptyZero S_k ℓ E_y hEmp_Ey).of_iso (CategoryTheory.asIso e_sW).symm
    have hZ_F' : CategoryTheory.Limits.IsZero (pb_ι.obj F₂) :=
      (hEmptyZero Y₂_y ℓ U'_y hEmp_U'y).of_iso (CategoryTheory.asIso e_ιU).symm
    have hSub_dom : Subsingleton ↥((pb_y.obj F₁).obj.obj (Opposite.op T_k)) :=
      hSubOfZero (pb_y.obj F₁) T_k hZ_F₁
    have hSub_pfp : Subsingleton ↥((pf_p.obj (pb_ι.obj F₂)).obj.obj (Opposite.op T_k)) :=
      hSubOfZero (pb_ι.obj F₂) ((weilEtaleSitePullback p_y).obj T_k) hZ_F'
    have hSub_cod : Subsingleton ↥((pb_y.obj (pf_ν.obj F₂)).obj.obj (Opposite.op T_k)) := by
      refine ⟨fun a b => ?_⟩
      have heq : ((e_iso.hom.hom.app (Opposite.op T_k)).hom) a =
          ((e_iso.hom.hom.app (Opposite.op T_k)).hom) b :=
        @Subsingleton.elim _ hSub_pfp _ _
      have ha : ((e_iso.inv.hom.app (Opposite.op T_k)).hom)
          (((e_iso.hom.hom.app (Opposite.op T_k)).hom) a) = a :=
        congrArg (fun φ => (φ.hom.app (Opposite.op T_k)).hom a) e_iso.hom_inv_id
      have hb : ((e_iso.inv.hom.app (Opposite.op T_k)).hom)
          (((e_iso.hom.hom.app (Opposite.op T_k)).hom) b) = b :=
        congrArg (fun φ => (φ.hom.app (Opposite.op T_k)).hom b) e_iso.hom_inv_id
      exact ha.symm.trans ((congrArg ((e_iso.inv.hom.app (Opposite.op T_k)).hom) heq).trans hb)
    exact ⟨fun _ _ _ => @Subsingleton.elim _ hSub_dom _ _,
      fun b => ⟨0, @Subsingleton.elim _ hSub_cod _ _⟩⟩

theorem weil_etale_algClosed_isFinite_spec_H1_subsingleton (k : Type u) [Field k] [IsAlgClosed k]
    (Z : AlgebraicGeometry.Scheme.{u})
    (p : Quiver.Hom Z (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsFinite p]
    (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) :
    Subsingleton (G.H 1) :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let e_k : S_k.presheaf.obj (Opposite.op ⊤) ≅ CommRingCat.of k :=
    AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of k)
  have he_k_surj : Function.Surjective e_k.inv.hom := by
    intro a
    refine ⟨e_k.hom.hom a, ?_⟩
    exact congrArg (fun m => m.hom a) e_k.hom_inv_id

  
  haveI : AlgebraicGeometry.IsAffine Z := AlgebraicGeometry.isAffine_of_isAffineHom p
  have hTopZ : AlgebraicGeometry.IsAffineOpen (⊤ : Z.Opens) :=
    AlgebraicGeometry.isAffineOpen_top Z
  have hTopSk : AlgebraicGeometry.IsAffineOpen (⊤ : S_k.Opens) :=
    AlgebraicGeometry.isAffineOpen_top S_k
  let R_cat := Z.presheaf.obj (Opposite.op ⊤)
  let R := ↑R_cat
  let φ_Z : k →+* R := (p.app ⊤).hom.comp e_k.inv.hom
  have hInt₀ : (p.app ⊤).hom.IsIntegral :=
    AlgebraicGeometry.IsIntegralHom.isIntegral_app p ⊤ hTopSk
  have hInt_φ : φ_Z.IsIntegral := by
    intro r
    obtain ⟨P, hP_monic, hP_eval⟩ := hInt₀ r
    refine ⟨P.map e_k.hom.hom, hP_monic.map e_k.hom.hom, ?_⟩
    rw [Polynomial.eval₂_map]
    have hcomp : φ_Z.comp e_k.hom.hom = (p.app ⊤).hom := by
      ext x
      have hid : e_k.inv.hom (e_k.hom.hom x) = x := congrArg (fun m => m.hom x) e_k.hom_inv_id
      change (p.app ⊤).hom (e_k.inv.hom (e_k.hom.hom x)) = (p.app ⊤).hom x
      rw [hid]
    rwa [hcomp]
  have hFT₀ : (p.app ⊤).hom.FiniteType := by
    rw [p.app_eq_appLE]
    exact AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.LocallyOfFiniteType)
      p inferInstance ⟨⊤, hTopSk⟩ ⟨⊤, hTopZ⟩ le_top
  have hFT_φ : φ_Z.FiniteType :=
    RingHom.FiniteType.comp hFT₀ (RingHom.FiniteType.of_surjective e_k.inv.hom he_k_surj)
  have hFin_φ : φ_Z.Finite := RingHom.Finite.of_isIntegral_of_finiteType hInt_φ hFT_φ
  haveI : IsArtinianRing R := by
    letI : Algebra k R := φ_Z.toAlgebra
    haveI : Module.Finite k R := hFin_φ
    exact IsArtinianRing.of_finite k R
  haveI : Finite (PrimeSpectrum R) := IsArtinianRing.instFinitePrimeSpectrum R
  letI : Fintype (PrimeSpectrum R) := Fintype.ofFinite (PrimeSpectrum R)
  let q_of : ↥Z → PrimeSpectrum R := fun z => Z.isoSpec.hom.base z
  have hq_inv : ∀ y : ↥Z, Z.isoSpec.inv.base (q_of y) = y := by
    intro y
    change (Z.isoSpec.hom ≫ Z.isoSpec.inv).base y = y
    rw [Z.isoSpec.hom_inv_id]
    rfl
  have hq_inj : Function.Injective q_of := by
    intro y₁ y₂ h
    rw [← hq_inv y₁, ← hq_inv y₂, h]
  haveI : Finite ↥Z := Finite.of_injective q_of hq_inj
  letI : Fintype ↥Z := Fintype.ofFinite ↥Z
  have hSep : ∀ (q₁ q₂ : PrimeSpectrum R), q₁ ≠ q₂ →
      ∃ g : R, g ∈ q₁.asIdeal ∧ g ∉ q₂.asIdeal := by
    intro q₁ q₂ hne
    have hMax₁ : q₁.asIdeal.IsMaximal := IsArtinianRing.isMaximal_of_isPrime q₁.asIdeal
    have hNotLe : ¬ (q₁.asIdeal ≤ q₂.asIdeal) := by
      intro hle
      apply hne
      ext1
      exact hMax₁.eq_of_le q₂.isPrime.ne_top hle
    exact Set.not_subset.mp hNotLe
  let g_sep : ↥Z → PrimeSpectrum R → R := fun z q =>
    if h : q ≠ q_of z then Classical.choose (hSep q (q_of z) h) else 1
  let f_sep : ↥Z → R := fun z =>
    ∏ q ∈ (Finset.univ : Finset (PrimeSpectrum R)).erase (q_of z), g_sep z q
  let U_of : ↥Z → Z.Opens := fun z => Z.basicOpen (f_sep z)
  have hMemSpec : ∀ (z : ↥Z) (q : PrimeSpectrum R),
      q ∈ PrimeSpectrum.basicOpen (f_sep z) ↔ q = q_of z := by
    intro z q
    rw [PrimeSpectrum.mem_basicOpen]
    constructor
    · intro hnotmem
      by_contra hne
      apply hnotmem
      have hmem_erase : q ∈ (Finset.univ : Finset (PrimeSpectrum R)).erase (q_of z) :=
        Finset.mem_erase.mpr ⟨hne, Finset.mem_univ q⟩
      have hdvd : g_sep z q ∣ f_sep z := Finset.dvd_prod_of_mem (g_sep z) hmem_erase
      have hg_in : g_sep z q ∈ q.asIdeal := by
        dsimp [g_sep]
        rw [dite_eq_left_of_eq_true (eq_true hne)]
        exact (Classical.choose_spec (hSep q (q_of z) hne)).1
      exact Ideal.mem_of_dvd q.asIdeal hdvd hg_in
    · rintro rfl hmem
      have hprime := (q_of z).isPrime
      obtain ⟨q', hq'_mem, hq'_in⟩ := (Ideal.IsPrime.prod_mem_iff (hp := hprime)).mp hmem
      have hne' : q' ≠ q_of z := Finset.ne_of_mem_erase hq'_mem
      dsimp [g_sep] at hq'_in
      rw [dite_eq_left_of_eq_true (eq_true hne')] at hq'_in
      exact (Classical.choose_spec (hSep q' (q_of z) hne')).2 hq'_in
  have hMemU : ∀ (z y : ↥Z), y ∈ U_of z ↔ y = z := by
    intro z y
    have hpre : (TopologicalSpace.Opens.map Z.isoSpec.inv.base).obj (U_of z) =
        PrimeSpectrum.basicOpen (f_sep z) := by
      rw [← AlgebraicGeometry.IsAffineOpen.fromSpec_top (X := Z)]
      exact hTopZ.fromSpec_preimage_basicOpen (f_sep z)
    calc
      y ∈ U_of z ↔ Z.isoSpec.inv.base (q_of y) ∈ U_of z := by rw [hq_inv]
      _ ↔ q_of y ∈ (TopologicalSpace.Opens.map Z.isoSpec.inv.base).obj (U_of z) := Iff.rfl
      _ ↔ q_of y ∈ PrimeSpectrum.basicOpen (f_sep z) := by
            rw [hpre]
            exact Iff.rfl
      _ ↔ q_of y = q_of z := hMemSpec z (q_of y)
      _ ↔ y = z := hq_inj.eq_iff
  let n : ℕ := Fintype.card ↥Z
  let e_Z : Fin n ≃ ↥Z := (Fintype.equivFin ↥Z).symm
  let O : Fin n → Z.Opens := fun i => U_of (e_Z i)
  have hCov : TopologicalSpace.IsOpenCover O := by
    rw [TopologicalSpace.IsOpenCover, eq_top_iff]
    intro y _
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨e_Z.symm y, ?_⟩
    exact (hMemU (e_Z (e_Z.symm y)) y).mpr (e_Z.apply_symm_apply y).symm
  have hDisj : ∀ (i j : Fin n), i ≠ j → Disjoint (O i) (O j) := by
    intro i j hij
    rw [disjoint_iff_inf_le]
    intro y hy
    exfalso
    have hyi : y = e_Z i := (hMemU (e_Z i) y).mp hy.1
    have hyj : y = e_Z j := (hMemU (e_Z j) y).mp hy.2
    exact hij (e_Z.injective (hyi.symm.trans hyj))
  have hAffO : ∀ i : Fin n, AlgebraicGeometry.IsAffineOpen (O i) :=
    fun i => hTopZ.basicOpen (f_sep (e_Z i))
  have hNEO : ∀ i : Fin n, Nonempty ↥(O i) :=
    fun i => ⟨⟨e_Z i, (hMemU (e_Z i) (e_Z i)).mpr rfl⟩⟩
  have hSubO : ∀ i : Fin n, Subsingleton ↥(O i) := by
    intro i
    refine ⟨fun u₁ u₂ => Subtype.ext ?_⟩
    exact ((hMemU (e_Z i) u₁.1).mp u₁.2).trans ((hMemU (e_Z i) u₂.1).mp u₂.2).symm

  
  have hNull : ∀ (C : Type u) [Field C] (θ : k →+* C), θ.FiniteType → Function.Bijective θ := by
    intro C _ θ hθ_FT
    refine ⟨θ.injective, ?_⟩
    letI : Algebra k C := θ.toAlgebra
    have hAlgFT : Algebra.FiniteType k C := hθ_FT
    obtain ⟨m, q_mv, hq_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := C)).mp hAlgFT
    let I_ker : Ideal (MvPolynomial (Fin m) k) := RingHom.ker q_mv.toRingHom
    have hMax_ker : I_ker.IsMaximal := by
      rw [Ideal.isMaximal_iff]
      refine ⟨?_, ?_⟩
      · intro h1
        have hq1 : q_mv 1 = 0 := h1
        rw [map_one] at hq1
        exact one_ne_zero hq1
      · intro J x hIJ hxI hxJ
        have hqx : q_mv x ≠ 0 := hxI
        obtain ⟨P, hP⟩ := hq_surj (q_mv x)⁻¹
        have hmem_ker : 1 - P * x ∈ I_ker := by
          change q_mv (1 - P * x) = 0
          rw [map_sub, map_one, map_mul, hP, inv_mul_cancel₀ hqx, sub_self]
        have hsubJ : 1 - P * x ∈ J := hIJ hmem_ker
        have hmulJ : P * x ∈ J := J.mul_mem_left P hxJ
        simpa using J.add_mem hsubJ hmulJ
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (K := k) (I := I_ker)).mp hMax_ker
    intro y
    obtain ⟨P, rfl⟩ := hq_surj y
    let c : k := MvPolynomial.aeval a_pt P
    have hdiff : P - MvPolynomial.C c ∈ I_ker := by
      rw [ha_pt]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      rw [map_sub, MvPolynomial.aeval_C]
      exact sub_self c
    have hq_diff : q_mv (P - MvPolynomial.C c) = 0 := hdiff
    rw [map_sub, sub_eq_zero] at hq_diff
    refine ⟨c, ?_⟩
    rw [hq_diff]
    exact (q_mv.commutes c).symm

  have hLift_gen : ∀ (X W : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine X] [Nonempty ↥X] [Subsingleton ↥X]
      (p_X : X ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_X],
      Nonempty ↥W →
      ∀ (f : W ⟶ X) [AlgebraicGeometry.Etale f],
        ∃ g : X ⟶ W, g ≫ f = 𝟙 X := by
    intro X W _ _ _ p_X _ hW f _
    let A_cat := X.presheaf.obj (Opposite.op ⊤)
    let A := ↑A_cat
    have hSpec_inv : ∀ q : PrimeSpectrum A,
        X.isoSpec.hom.base (X.isoSpec.inv.base q) = q := by
      intro q
      change (X.isoSpec.inv ≫ X.isoSpec.hom).base q = q
      rw [X.isoSpec.inv_hom_id]
      rfl
    have hSubSpec : Subsingleton (PrimeSpectrum A) := by
      refine ⟨fun q₁ q₂ => ?_⟩
      rw [← hSpec_inv q₁, ← hSpec_inv q₂,
        Subsingleton.elim (X.isoSpec.inv.base q₁) (X.isoSpec.inv.base q₂)]
    obtain ⟨x₀⟩ := (inferInstance : Nonempty ↥X)
    let q₀ : PrimeSpectrum A := X.isoSpec.hom.base x₀
    let 𝔪 : Ideal A := q₀.asIdeal
    haveI : 𝔪.IsPrime := q₀.isPrime
    have h𝔪_uniq : ∀ (P : Ideal A) [P.IsPrime], P = 𝔪 := by
      intro P hP
      have heq : (⟨P, hP⟩ : PrimeSpectrum A) = q₀ := hSubSpec.elim _ _
      exact congrArg PrimeSpectrum.asIdeal heq
    haveI : 𝔪.IsMaximal := by
      obtain ⟨M, hM_max, _⟩ := Ideal.exists_le_maximal 𝔪 q₀.isPrime.ne_top
      haveI : M.IsPrime := hM_max.isPrime
      rwa [← h𝔪_uniq M]
    have hnil_eq : nilradical A = 𝔪 := by
      change (⊥ : Ideal A).radical = 𝔪
      rw [Ideal.radical_eq_sInf]
      have hset : {J : Ideal A | ⊥ ≤ J ∧ J.IsPrime} = {𝔪} := by
        ext J
        simp only [Set.mem_setOf, bot_le, true_and, Set.mem_singleton_iff]
        exact ⟨fun hJ => @h𝔪_uniq J hJ, fun h => h ▸ q₀.isPrime⟩
      rw [hset, sInf_singleton]
    let φ : k →+* A := (p_X.appLE ⊤ ⊤ le_top).hom.comp e_k.inv.hom
    have hφ_FT : φ.FiniteType := by
      have hp_FT : (p_X.appLE ⊤ ⊤ le_top).hom.FiniteType :=
        AlgebraicGeometry.HasRingHomProperty.appLE (@AlgebraicGeometry.LocallyOfFiniteType)
          p_X inferInstance ⟨⊤, hTopSk⟩ ⟨⊤, AlgebraicGeometry.isAffineOpen_top X⟩ le_top
      exact RingHom.FiniteType.comp hp_FT (RingHom.FiniteType.of_surjective e_k.inv.hom he_k_surj)
    have hNoethA : IsNoetherianRing A := by
      letI : Algebra k A := φ.toAlgebra
