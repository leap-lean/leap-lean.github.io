        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.snd ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S)
          (ρ_S a) :=
    fun _ _ _ _ _ => CategoryTheory.Limits.pullback.lift_snd _ _ _

  have hρ_lift_add :
      ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
        (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
        (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
        (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
          ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b))
        (U : S.Etale) (a b : ZMod ℓ),
        ρ_lift ν_S ρ_S hρ_over U (a + b) =
          CategoryTheory.CategoryStruct.comp (ρ_lift ν_S ρ_S hρ_over U a) (ρ_lift ν_S ρ_S hρ_over U b) := by
    intro S Z_S ν_S ρ_S hρ_over hρ_act U a b
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [hρ_lift_fst ν_S ρ_S hρ_over U (a + b), CategoryTheory.Category.assoc,
        hρ_lift_fst ν_S ρ_S hρ_over U b, hρ_lift_fst ν_S ρ_S hρ_over U a]
    · rw [hρ_lift_snd ν_S ρ_S hρ_over U (a + b), hρ_act.2 a b,
        CategoryTheory.Category.assoc (ρ_lift ν_S ρ_S hρ_over U a),
        hρ_lift_snd ν_S ρ_S hρ_over U b,
        ← CategoryTheory.Category.assoc (ρ_lift ν_S ρ_S hρ_over U a),
        hρ_lift_snd ν_S ρ_S hρ_over U a, CategoryTheory.Category.assoc]

  have hρ_lift_nat :
      ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
        (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
        (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
