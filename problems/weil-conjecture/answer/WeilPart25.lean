    let T₂ := weilEtaleIdTerminal.{u} C₂.left
    let hT₂ := weilEtaleIdTerminalIsTerminal.{u} C₂.left
    let adj₁ := CategoryTheory.constantSheafAdj C₁.left.smallEtaleTopology AddCommGrpCat.{u} hT₁
