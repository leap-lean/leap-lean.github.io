          A_b).obj.obj (Opposite.op T_k) :=
      EV_Tk.mapIso e_dom_sh
    let P_const_Ab := (CategoryTheory.Functor.const (Opposite S_k.Etale)).obj A_b
    have hIso_unit_Ab := hSpecUnitIso P_const_Ab
    let e_dom2 : A_b ≅
        ((CategoryTheory.constantSheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).obj
          A_b).obj.obj (Opposite.op T_k) :=
      @CategoryTheory.asIso _ _ _ _
        (((CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P_const_Ab).app (Opposite.op T_k))
        hIso_unit_Ab
    let eqv_dom : ↥Dom_u ≃+ ↥A_b :=
      (e_dom1.trans e_dom2.symm).addCommGroupIsoToAddEquiv
    have hCard_Dom : Nat.card ↥Dom_u = ℓ ^ b_pt :=
      (Nat.card_congr eqv_dom.toEquiv).trans hCard_Ab

    
    have hIso_cM_ι := @hConstIso _ _ ι_u hCont_ι hAdj_ι AM
    let e_ι_sh := @CategoryTheory.asIso _ _ _ _ _ hIso_cM_ι
    have hPull_FY : WeilIsEtaleSheafPullback ι_u F_Y (weilEtaleTorsionSheaf C_u ℓ) :=
      ⟨hCont_ι, hAdj_ι, ⟨e_ι_sh⟩⟩
    let X_ov := CategoryTheory.Over.mk (f_pt ≫ p_pt)
    let S'_ov := CategoryTheory.Over.mk (𝟙 S_k)
    let X'_ov := CategoryTheory.Over.mk q_u
    let f_ov : X_ov ⟶ S_ov := CategoryTheory.Over.homMk f_pt rfl
    let g_ov : S'_ov ⟶ S_ov := CategoryTheory.Over.homMk s_u hs_u_sec
    let f'_ov : X'_ov ⟶ S'_ov :=
      CategoryTheory.Over.homMk q_u (CategoryTheory.Category.comp_id q_u)
    let g'_ov : X'_ov ⟶ X_ov :=
      CategoryTheory.Over.homMk ι_u
        ((CategoryTheory.Category.assoc ι_u f_pt p_pt).symm.trans
          ((congrArg (· ≫ p_pt)
            (CategoryTheory.Limits.pullback.condition (f := f_pt) (g := s_u))).trans
            ((CategoryTheory.Category.assoc q_u s_u p_pt).trans
              ((congrArg (q_u ≫ ·) hs_u_sec).trans
                (CategoryTheory.Category.comp_id q_u)))))
    have hPb_ov : CategoryTheory.IsPullback g'_ov.left f'_ov.left f_ov.left g_ov.left :=
      CategoryTheory.IsPullback.of_hasPullback f_pt s_u
    have hProp_fov : AlgebraicGeometry.IsProper f_ov.left :=
      ‹AlgebraicGeometry.IsProper f_pt›
    obtain ⟨hCont_s', hAdj_s', ⟨e_pbc⟩⟩ :=
      hPBC X_ov S_ov S'_ov X'_ov f_ov g_ov f'_ov g'_ov hProp_fov hPb_ov
        F_Y (weilEtaleTorsionSheaf C_u ℓ) hFY_tor hPull_FY 1
    obtain rfl : hCont_s = hCont_s' := Subsingleton.elim _ _
    obtain rfl : hAdj_s = hAdj_s' := Subsingleton.elim _ _
    let e_cod1 : Cod_u ≅
        (weilEtaleHigherDirectImage q_u 1 (weilEtaleTorsionSheaf C_u ℓ)).obj.obj
          (Opposite.op T_k) :=
      EV_Tk.mapIso e_pbc
    obtain ⟨e_H_qu, _⟩ := hSpecHDI X'_ov 1
    let eqv_cod : ↥Cod_u ≃+ weilEtaleTorsionH C_u ℓ 1 :=
      e_cod1.addCommGroupIsoToAddEquiv.trans (e_H_qu (weilEtaleTorsionSheaf C_u ℓ))
    have hCard_Cod : Nat.card ↥Cod_u = ℓ ^ b_pt :=
      (Nat.card_congr eqv_cod.toEquiv).trans hCard_Cu

    
    let σ_of : ∀ (U : U_pt.Etale), Quiver.Hom T_k (B_s.obj U) → (S_k ⟶ U.left) :=
      fun U τ => τ.left ≫ CategoryTheory.Limits.pullback.fst U.hom s_u
    have hσ_of : ∀ (U : U_pt.Etale) (τ : Quiver.Hom T_k (B_s.obj U)),
        σ_of U τ ≫ U.hom = s_u :=
      fun U τ =>
        (CategoryTheory.Category.assoc τ.left
          (CategoryTheory.Limits.pullback.fst U.hom s_u) U.hom).trans
          ((congrArg (τ.left ≫ ·)
            (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := s_u))).trans
            ((CategoryTheory.Category.assoc τ.left
              (CategoryTheory.Limits.pullback.snd U.hom s_u) s_u).symm.trans
              ((congrArg (· ≫ s_u) (CategoryTheory.MorphismProperty.Over.w τ)).trans
                (CategoryTheory.Category.id_comp s_u))))
    let j_fib : ∀ (U : U_pt.Etale), Quiver.Hom T_k (B_s.obj U) →
        (C_u ⟶ (B_f.obj U).left) :=
      fun U τ =>
        CategoryTheory.Limits.pullback.lift (q_u ≫ σ_of U τ) ι_u
          ((CategoryTheory.Category.assoc q_u (σ_of U τ) U.hom).trans
            ((congrArg (q_u ≫ ·) (hσ_of U τ)).trans
              (CategoryTheory.Limits.pullback.condition (f := f_pt) (g := s_u)).symm))
    let p_fib : ∀ (U : U_pt.Etale) (τ : Quiver.Hom T_k (B_s.obj U)),
        weilEtaleTorsionH (B_f.obj U).left ℓ 1 →+ weilEtaleTorsionH C_u ℓ 1 :=
      fun U τ => Classical.choose (hPullEx (j_fib U τ) ℓ 1)
    have hp_fib : ∀ (U : U_pt.Etale) (τ : Quiver.Hom T_k (B_s.obj U)),
        WeilIsTorsionEtalePullback (j_fib U τ) ℓ 1 (p_fib U τ) :=
      fun U τ => Classical.choose_spec (hPullEx (j_fib U τ) ℓ 1)
    let ev_pre : ∀ (U : U_pt.Etale), Quiver.Hom T_k (B_s.obj U) →
        (↥(P.obj (Opposite.op U)) →+ weilEtaleTorsionH C_u ℓ 1) :=
      fun U τ => (p_fib U τ).comp (Θ (B_f.obj U)).toAddMonoidHom

    have hev_nat :
        ∀ {U₁ U₂ : U_pt.Etale} (g : Quiver.Hom U₁ U₂)
          (τ₁ : Quiver.Hom T_k (B_s.obj U₁)) (z : ↥(P.obj (Opposite.op U₂))),
          ev_pre U₁ τ₁ ((P.map (Opposite.op g)).hom z) =
            ev_pre U₂ (CategoryTheory.CategoryStruct.comp τ₁ (B_s.map g)) z := by
      intro U₁ U₂ g τ₁ z
      let τ₂ := CategoryTheory.CategoryStruct.comp τ₁ (B_s.map g)
      have hbs_fst :
          (B_s.map g).left ≫ CategoryTheory.Limits.pullback.fst U₂.hom s_u =
            CategoryTheory.Limits.pullback.fst U₁.hom s_u ≫ g.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hσ_map : σ_of U₂ τ₂ = σ_of U₁ τ₁ ≫ g.left :=
        (CategoryTheory.Category.assoc τ₁.left (B_s.map g).left _).trans
          ((congrArg (τ₁.left ≫ ·) hbs_fst).trans
            (CategoryTheory.Category.assoc τ₁.left _ g.left).symm)
      have hbf_fst :
          (B_f.map g).left ≫ CategoryTheory.Limits.pullback.fst U₂.hom f_pt =
            CategoryTheory.Limits.pullback.fst U₁.hom f_pt ≫ g.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hbf_snd :
          (B_f.map g).left ≫ CategoryTheory.Limits.pullback.snd U₂.hom f_pt =
            CategoryTheory.Limits.pullback.snd U₁.hom f_pt :=
        CategoryTheory.MorphismProperty.Over.w (B_f.map g)
      have hj_fac : j_fib U₁ τ₁ ≫ (B_f.map g).left = j_fib U₂ τ₂ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Category.assoc (j_fib U₁ τ₁) (B_f.map g).left _).trans
            ((congrArg (j_fib U₁ τ₁ ≫ ·) hbf_fst).trans
              ((CategoryTheory.Category.assoc (j_fib U₁ τ₁) _ g.left).symm.trans
                ((congrArg (· ≫ g.left) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
                  ((CategoryTheory.Category.assoc q_u (σ_of U₁ τ₁) g.left).trans
                    ((congrArg (q_u ≫ ·) hσ_map.symm).trans
                      (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)))))
        · exact (CategoryTheory.Category.assoc (j_fib U₁ τ₁) (B_f.map g).left _).trans
            ((congrArg (j_fib U₁ τ₁ ≫ ·) hbf_snd).trans
              ((CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
                (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm))
      obtain ⟨p_Bg, hp_Bg⟩ :=
        hPullEx (((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map (B_f.map g)).left) ℓ 1
      have hp_τ₂' :
          WeilIsTorsionEtalePullback
            (j_fib U₁ τ₁ ≫ ((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map (B_f.map g)).left)
            ℓ 1 (p_fib U₂ τ₂) :=
        Eq.ndrec (motive := fun m => WeilIsTorsionEtalePullback m ℓ 1 (p_fib U₂ τ₂))
          (hp_fib U₂ τ₂) hj_fac.symm
      have hp_comp : p_fib U₂ τ₂ = (p_fib U₁ τ₁).comp p_Bg :=
        hPullComp (j_fib U₁ τ₁)
          (((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map (B_f.map g)).left)
          ℓ 1 (p_fib U₁ τ₁) p_Bg (p_fib U₂ τ₂) (hp_fib U₁ τ₁) hp_Bg hp_τ₂'
      have hΘ_step := hΘ_nat (B_f.map g) p_Bg hp_Bg z
      change p_fib U₁ τ₁ (Θ (B_f.obj U₁)
          (((CategoryTheory.Sheaf.cohomologyPresheaf F_Y 1).map (B_f.map g).op).hom z)) =
        p_fib U₂ τ₂ (Θ (B_f.obj U₂) z)
      exact (congrArg (p_fib U₁ τ₁) hΘ_step).trans
        (congrArg (fun f : weilEtaleTorsionH (B_f.obj U₂).left ℓ 1 →+ weilEtaleTorsionH C_u ℓ 1 =>
          f (Θ (B_f.obj U₂) z)) hp_comp.symm)

    let τ₀ : Quiver.Hom T_k (B_s.obj T_U) :=
      CategoryTheory.MorphismProperty.Over.homMk
        (CategoryTheory.Limits.pullback.lift s_u (𝟙 S_k)
          ((CategoryTheory.Category.comp_id s_u).trans
            (CategoryTheory.Category.id_comp s_u).symm))
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial

    have hτ_top_left :
        ((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map τ_top).left =
          CategoryTheory.Limits.pullback.snd T_U.hom f_pt :=
      (CategoryTheory.Category.comp_id τ_top.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w τ_top)

    have hj_top :
        j_fib T_U τ₀ ≫ ((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map τ_top).left = ι_u :=
      (congrArg (j_fib T_U τ₀ ≫ ·) hτ_top_left).trans
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)

    obtain ⟨p_top, hp_top⟩ :=
      hPullEx (((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map τ_top).left) ℓ 1
    have hp_u_fac :
        WeilIsTorsionEtalePullback
          (j_fib T_U τ₀ ≫ ((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map τ_top).left)
          ℓ 1 p_u :=
      Eq.ndrec (motive := fun m => WeilIsTorsionEtalePullback m ℓ 1 p_u) hp_u hj_top.symm
    have hp_u_eq : p_u = (p_fib T_U τ₀).comp p_top :=
      hPullComp (j_fib T_U τ₀)
        (((AlgebraicGeometry.Scheme.Etale.forget Y_pt).map τ_top).left)
        ℓ 1 (p_fib T_U τ₀) p_top p_u (hp_fib T_U τ₀) hp_top hp_u_fac

    have hev_top : ∀ x : weilEtaleTorsionH Y_pt ℓ 1, ev_pre T_U τ₀ (ψ_top x) = p_u x := by
      intro x
      have hΘ_top := hΘ_nat τ_top p_top hp_top ((Θ T_Y).symm x)
      have hsymm := (Θ T_Y).apply_symm_apply x
      change p_fib T_U τ₀ (Θ (B_f.obj T_U)
          (((CategoryTheory.Sheaf.cohomologyPresheaf F_Y 1).map (Opposite.op τ_top)).hom
            ((Θ T_Y).symm x))) = p_u x
      exact (congrArg (p_fib T_U τ₀) (hΘ_top.trans (congrArg p_top hsymm))).trans
        (congrArg (fun f : weilEtaleTorsionH Y_pt ℓ 1 →+ weilEtaleTorsionH C_u ℓ 1 => f x)
          hp_u_eq.symm)

    
    obtain ⟨α_in, ev_out, hev_sky⟩ :=
      hSkyEval S_k.smallEtaleTopology U_pt.smallEtaleTopology B_s T_k hT_U τ₀ P
        A_b (AddCommGrpCat.of (weilEtaleTorsionH C_u ℓ 1)) φ₀ ev_pre
        (fun g τ₁ z => hev_nat g τ₁ z) hSpecUnitIso

    have hComp_eval :
        ∀ a : ↥A_b,
          ev_out.hom (φ_u (α_in.hom a)) =
            Finset.univ.sum fun i : Fin b_pt => (a.down i).val • p_u (s_tor i) := by
      intro a
      calc
        ev_out.hom (φ_u (α_in.hom a))
          = ev_pre T_U τ₀ (φ₀.hom a) := hev_sky a
        _ = ev_pre T_U τ₀
              (Finset.univ.sum fun i : Fin b_pt => (a.down i).val • ψ_top (s_tor i)) := rfl
        _ = Finset.univ.sum fun i : Fin b_pt =>
              ev_pre T_U τ₀ ((a.down i).val • ψ_top (s_tor i)) := map_sum _ _ _
        _ = Finset.univ.sum fun i : Fin b_pt =>
              (a.down i).val • p_u (s_tor i) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            rw [map_nsmul, hev_top (s_tor i)]

    have hinj_c := hInj_Cu p_u hp_u
    have hInj_comp : Function.Injective (fun a : ↥A_b => ev_out.hom (φ_u (α_in.hom a))) :=
      fun a₁ a₂ h_eq =>
        ULift.ext a₁ a₂
          (@hinj_c a₁.down a₂.down
            ((hComp_eval a₁).symm.trans (h_eq.trans (hComp_eval a₂))))

    have hInj_α : Function.Injective α_in.hom :=
      fun a₁ a₂ h_eq => hInj_comp (congrArg (fun d => ev_out.hom (φ_u d)) h_eq)

    haveI : Finite ↥A_b := Nat.finite_of_card_ne_zero (hCard_Ab ▸ hPow_pos.ne')
    haveI : Finite ↥Dom_u := Nat.finite_of_card_ne_zero (hCard_Dom ▸ hPow_pos.ne')
    haveI : Finite ↥Cod_u := Nat.finite_of_card_ne_zero (hCard_Cod ▸ hPow_pos.ne')
    letI : Fintype ↥A_b := Fintype.ofFinite ↥A_b
    letI : Fintype ↥Dom_u := Fintype.ofFinite ↥Dom_u
    letI : Fintype ↥Cod_u := Fintype.ofFinite ↥Cod_u

    have hFintype_Ab_Dom : Fintype.card ↥A_b = Fintype.card ↥Dom_u := by
      rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card, hCard_Ab, hCard_Dom]
    have hBij_α : Function.Bijective α_in.hom :=
      (Fintype.bijective_iff_injective_and_card α_in.hom).mpr ⟨hInj_α, hFintype_Ab_Dom⟩

    have hInj_φ : Function.Injective φ_u := by
      intro d₁ d₂ h_eq
      obtain ⟨a₁, rfl⟩ := hBij_α.2 d₁
      obtain ⟨a₂, rfl⟩ := hBij_α.2 d₂
      exact congrArg α_in.hom (hInj_comp (congrArg ev_out.hom h_eq))

    have hFintype_Dom_Cod : Fintype.card ↥Dom_u = Fintype.card ↥Cod_u := by
      rw [Fintype.card_eq_nat_card, Fintype.card_eq_nat_card, hCard_Dom, hCard_Cod]
    exact (Fintype.bijective_iff_injective_and_card φ_u).mpr ⟨hInj_φ, hFintype_Dom_Cod⟩

  exact ⟨CategoryTheory.asIso Ψ⟩

theorem weil_etale_rel_smooth_proj_curve_r2_iso_and_h1_basis_lift (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (hProjCurveNonDeg :
      ∀ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral C_bar.left →
        IsProjectiveOverField k C_bar →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom],
          Finite (weilCupPDModH C_bar.left ℓ 1) ∧
          ∀ a : weilCupPDModH C_bar.left ℓ 1,
            (∀ b : weilCupPDModH C_bar.left ℓ 1,
              CategoryTheory.Abelian.Ext.comp a b (rfl : 1 + 1 = 2) = 0) →
            a = 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (V₀ : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine V₀] [AlgebraicGeometry.IsIntegral V₀]
    (p_V₀ : Quiver.Hom V₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType p_V₀]
    (u_V₀ : Quiver.Hom V₀ (weilAffineSpaceOver k δ).left)
    [AlgebraicGeometry.Etale u_V₀]
    (hu_V₀ : CategoryTheory.CategoryStruct.comp u_V₀ (weilAffineSpaceOver k δ).hom = p_V₀)
    (v₀ : ↥V₀) (hv₀ : IsClosed ({v₀} : Set ↥V₀))
    (Y₀ : AlgebraicGeometry.Scheme.{u})
    (f₀ : Quiver.Hom Y₀ V₀)
    [AlgebraicGeometry.IsProper f₀]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f₀]
    (τ₀ : Quiver.Hom V₀ Y₀)
    (hτ₀_sec : CategoryTheory.CategoryStruct.comp τ₀ f₀ = CategoryTheory.CategoryStruct.id V₀)
    (hτ₀_cl : AlgebraicGeometry.IsClosedImmersion τ₀)
    (hGeomFib :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V₀),
        AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f₀ s_Ω) ∧
        IsProjectiveOverField Ω
          (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀ s_Ω))) :
    ∃ (V₁ : V₀.Opens)
      (_ : AlgebraicGeometry.IsAffineOpen V₁)
      (_ : v₀ ∈ V₁)
      (_ : AlgebraicGeometry.IsIntegral V₁.toScheme)
      (α₀ : weilEtaleTorsionH (CategoryTheory.Limits.pullback f₀ V₁.ι) ℓ 2),
      let Y₁ := CategoryTheory.Limits.pullback f₀ V₁.ι
      let f₁ := CategoryTheory.Limits.pullback.snd f₀ V₁.ι
      let p_V₁ := CategoryTheory.CategoryStruct.comp V₁.ι p_V₀
      ℓ • α₀ = 0 ∧
      (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
          (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V₁.toScheme)
          (Y_Ω : AlgebraicGeometry.Scheme.{u})
          (ι_Ω : Quiver.Hom Y_Ω Y₁)
          (f_Ω : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        CategoryTheory.IsPullback ι_Ω f_Ω f₁ s_Ω →
        ∀ (φ_Ω : weilEtaleTorsionH Y₁ ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2),
          WeilIsTorsionEtalePullback ι_Ω ℓ 2 φ_Ω →
          φ_Ω α₀ ≠ 0) ∧
      (∀ (U : AlgebraicGeometry.Scheme.{u})
          [AlgebraicGeometry.IsAffine U] [ConnectedSpace ↥U]
          (g_U : Quiver.Hom U V₁.toScheme)
          (Y_U : AlgebraicGeometry.Scheme.{u})
          (p_YU : Quiver.Hom Y_U Y₁) (f_U : Quiver.Hom Y_U U),
        CategoryTheory.IsPullback p_YU f_U f₁ g_U →
        ∀ (a b : weilCupPDModH Y_U ℓ 1),
          ∃ c_ab : ZMod ℓ,
            ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
              (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) U)
              (Y_Ω : AlgebraicGeometry.Scheme.{u})
              (ι_Ω : Quiver.Hom Y_Ω Y_U)
              (f_Ω : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
              CategoryTheory.IsPullback ι_Ω f_Ω f_U s_Ω →
              ∀ (θ_U : weilCupPDModH Y_U ℓ 2 →+ weilEtaleTorsionH Y_U ℓ 2)
                (p_Ω : weilEtaleTorsionH Y_U ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2)
                (p_α : weilEtaleTorsionH Y₁ ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2),
                WeilCupPDIsModComparison Y_U ℓ 2 θ_U →
                WeilIsTorsionEtalePullback ι_Ω ℓ 2 p_Ω →
                WeilIsTorsionEtalePullback
                  (CategoryTheory.CategoryStruct.comp ι_Ω p_YU) ℓ 2 p_α →
                p_Ω (θ_U (CategoryTheory.Abelian.Ext.comp a b (rfl : 1 + 1 = 2))) =
                  c_ab.val • p_α α₀) ∧
      (∀ (U_base : AlgebraicGeometry.Scheme.{u})
          [AlgebraicGeometry.IsAffine U_base] [AlgebraicGeometry.IsIntegral U_base]
          (g_base : Quiver.Hom U_base V₁.toScheme) [AlgebraicGeometry.Etale g_base]
          (u_pt : ↥U_base),
        IsClosed ({u_pt} : Set ↥U_base) →
        ∃ (U_pt : AlgebraicGeometry.Scheme.{u})
          (_ : AlgebraicGeometry.IsAffine U_pt)
          (_ : AlgebraicGeometry.IsIntegral U_pt)
          (h_pt : Quiver.Hom U_pt U_base)
          (u'_pt : ↥U_pt)
          (b_pt : ℕ)
          (Y_pt : AlgebraicGeometry.Scheme.{u})
          (p_Ypt : Quiver.Hom Y_pt Y₁)
          (f_pt : Quiver.Hom Y_pt U_pt)
          (s : Fin b_pt → weilCupPDModH Y_pt ℓ 1)
          (G : Matrix (Fin b_pt) (Fin b_pt) (ZMod ℓ)),
          AlgebraicGeometry.Etale h_pt ∧
          IsClosed ({u'_pt} : Set ↥U_pt) ∧
          h_pt.base u'_pt = u_pt ∧
          CategoryTheory.IsPullback p_Ypt f_pt f₁
            (CategoryTheory.CategoryStruct.comp h_pt g_base) ∧
          IsUnit G.det ∧
          (∀ (i j : Fin b_pt)
              (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
              (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) U_pt)
              (Y_Ω : AlgebraicGeometry.Scheme.{u})
              (ι_Ω : Quiver.Hom Y_Ω Y_pt)
              (f_Ω : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
            CategoryTheory.IsPullback ι_Ω f_Ω f_pt s_Ω →
            ∀ (θ_pt : weilCupPDModH Y_pt ℓ 2 →+ weilEtaleTorsionH Y_pt ℓ 2)
              (p_Ω : weilEtaleTorsionH Y_pt ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2)
              (p_α : weilEtaleTorsionH Y₁ ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2),
              WeilCupPDIsModComparison Y_pt ℓ 2 θ_pt →
              WeilIsTorsionEtalePullback ι_Ω ℓ 2 p_Ω →
              WeilIsTorsionEtalePullback
                (CategoryTheory.CategoryStruct.comp ι_Ω p_Ypt) ℓ 2 p_α →
              p_Ω (θ_pt (CategoryTheory.Abelian.Ext.comp (s i) (s j) (rfl : 1 + 1 = 2))) =
                (G i j).val • p_α α₀) ∧
          (∀ (s_u : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U_pt)
              (C_u : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
              (ι_u : Quiver.Hom C_u.left Y_pt),
            CategoryTheory.CategoryStruct.comp s_u
              (CategoryTheory.CategoryStruct.comp h_pt
                (CategoryTheory.CategoryStruct.comp g_base p_V₁)) =
              CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
            CategoryTheory.IsPullback ι_u C_u.hom f_pt s_u →
            ℓ ^ b_pt ≤ Nat.card (weilCupPDModH C_u.left ℓ 1) ∧
            (Set.range s_u.base = {u'_pt} →
              Nat.card (weilCupPDModH C_u.left ℓ 1) = ℓ ^ b_pt ∧
              ∀ (θ_pt : weilCupPDModH Y_pt ℓ 1 →+ weilEtaleTorsionH Y_pt ℓ 1)
                (θ_u : weilCupPDModH C_u.left ℓ 1 →+ weilEtaleTorsionH C_u.left ℓ 1)
                (p_u : weilEtaleTorsionH Y_pt ℓ 1 →+ weilEtaleTorsionH C_u.left ℓ 1),
                WeilCupPDIsModComparison Y_pt ℓ 1 θ_pt →
                WeilCupPDIsModComparison C_u.left ℓ 1 θ_u →
                WeilIsTorsionEtalePullback ι_u ℓ 1 p_u →
                ∀ x_u : weilCupPDModH C_u.left ℓ 1,
                  ∃ c : Fin b_pt → ZMod ℓ,
                    θ_u x_u =
                      Finset.univ.sum fun i : Fin b_pt => (c i).val • p_u (θ_pt (s i)))) ∧
          ((∀ (u : ↥U_pt)
              (s_u : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) U_pt),
            CategoryTheory.CategoryStruct.comp s_u
              (CategoryTheory.CategoryStruct.comp h_pt
                (CategoryTheory.CategoryStruct.comp g_base p_V₁)) =
              CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
            Set.range s_u.base = {u} →
            Nat.card (weilCupPDModH (CategoryTheory.Limits.pullback f_pt s_u) ℓ 1) =
              ℓ ^ b_pt) →
          Nonempty (CategoryTheory.Iso
            ((CategoryTheory.constantSheaf U_pt.smallEtaleTopology AddCommGrpCat.{u}).obj
              (AddCommGrpCat.uliftFunctor.{u, 0}.obj
                (AddCommGrpCat.of (Fin b_pt → ZMod ℓ))))
            (weilEtaleHigherDirectImage f_pt 1
              (weilEtaleTorsionSheaf Y_pt ℓ))))) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  have hFact1 : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let _ := hv₀
  let _ := hu_V₀

  
  have hGeomFib_of_isPullback :
      ∀ {B Y_B : AlgebraicGeometry.Scheme.{u}}
        {p_YB : Y_B ⟶ Y₀} {f_B : Y_B ⟶ B} {m_B : B ⟶ V₀}
        (hPb_B : CategoryTheory.IsPullback p_YB f_B f₀ m_B)
        (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ B)
        {Y_Ω : AlgebraicGeometry.Scheme.{u}}
        {ι_Ω : Y_Ω ⟶ Y_B}
        {f_Ω : Y_Ω ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω)}
        (hPb_Ω : CategoryTheory.IsPullback ι_Ω f_Ω f_B s_Ω),
        AlgebraicGeometry.IsIntegral Y_Ω ∧
        IsProjectiveOverField Ω (CategoryTheory.Over.mk f_Ω) := by
    intro B Y_B p_YB f_B m_B hPb_B Ω _ _ s_Ω Y_Ω ι_Ω f_Ω hPb_Ω
    have hPb_tot : CategoryTheory.IsPullback (ι_Ω ≫ p_YB) f_Ω f₀ (s_Ω ≫ m_B) :=
      hPb_Ω.paste_horiz hPb_B
    obtain ⟨hInt_std, hProj_std⟩ := hGeomFib Ω (s_Ω ≫ m_B)
    haveI : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f₀ (s_Ω ≫ m_B)) :=
      hInt_std
    let e_Ω := hPb_tot.isoPullback
    have he_snd :
        e_Ω.hom ≫ CategoryTheory.Limits.pullback.snd f₀ (s_Ω ≫ m_B) = f_Ω :=
      hPb_tot.isoPullback_hom_snd
    obtain ⟨pt_std⟩ :=
      (inferInstance : Nonempty ↥(CategoryTheory.Limits.pullback f₀ (s_Ω ≫ m_B)))
    haveI : Nonempty ↥Y_Ω := ⟨e_Ω.inv.base pt_std⟩
    have hInt_Ω : AlgebraicGeometry.IsIntegral Y_Ω :=
      AlgebraicGeometry.isIntegral_of_isOpenImmersion e_Ω.hom
    rcases hProj_std with ⟨N₀, ι₀, hCl₀⟩
    haveI : AlgebraicGeometry.IsClosedImmersion ι₀.left := hCl₀
    let e_ov :
        CategoryTheory.Over.mk f_Ω ⟶
          CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₀ (s_Ω ≫ m_B)) :=
      CategoryTheory.Over.homMk e_Ω.hom he_snd
    have hCl_comp : AlgebraicGeometry.IsClosedImmersion (e_ov ≫ ι₀).left := by
      change AlgebraicGeometry.IsClosedImmersion (e_Ω.hom ≫ ι₀.left)
      infer_instance
    exact ⟨hInt_Ω, ⟨N₀, e_ov ≫ ι₀, hCl_comp⟩⟩

  
  have hModTor : ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ)
      (x : weilCupPDModH S ℓ j), ℓ • x = 0 := by
    intro S j x
    let oneR := weilCupPDModUnit S ℓ
    have hid0 : ℓ • (CategoryTheory.CategoryStruct.id oneR) = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      ext W m
      have hcast : ((ℓ : ℕ) : ULift.{u, 0} (ZMod ℓ)) = 0 := by
        ext
        exact CharP.cast_eq_zero (ZMod ℓ) ℓ
      have hsmul : ℓ • m = ((ℓ : ℕ) : ULift.{u, 0} (ZMod ℓ)) • m :=
        (Nat.cast_smul_eq_nsmul (ULift.{u, 0} (ZMod ℓ)) ℓ m).symm
      change ℓ • m = 0
      rw [hsmul, hcast, zero_smul]
    have hcomp_nsmul : ∀ (n : ℕ),
        n • x = x.comp
          (CategoryTheory.Abelian.Ext.mk₀ (n • CategoryTheory.CategoryStruct.id oneR))
          (Nat.add_zero j) := by
      intro n
      induction n with
      | zero =>
        rw [zero_nsmul, zero_nsmul, CategoryTheory.Abelian.Ext.mk₀_zero,
          CategoryTheory.Abelian.Ext.comp_zero]
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, CategoryTheory.Abelian.Ext.mk₀_add,
          CategoryTheory.Abelian.Ext.comp_add, ← ih,
          CategoryTheory.Abelian.Ext.comp_mk₀_id]
    rw [hcomp_nsmul ℓ, hid0, CategoryTheory.Abelian.Ext.mk₀_zero,
      CategoryTheory.Abelian.Ext.comp_zero]

  have hnsmul_mod : ∀ {A : Type u} [AddCommGroup A] {a : A} (_ : ℓ • a = 0) (n : ℕ),
      n • a = (n : ZMod ℓ).val • a := by
    intro A _ a ha n
    have hdiv : n = ℓ * (n / ℓ) + n % ℓ := (Nat.div_add_mod n ℓ).symm
    calc
      n • a = (ℓ * (n / ℓ) + n % ℓ) • a := by rw [← hdiv]
      _ = (n / ℓ) • (ℓ • a) + (n % ℓ) • a := by rw [add_nsmul, mul_nsmul]
      _ = (n % ℓ) • a := by rw [ha, smul_zero, zero_add]
      _ = (n : ZMod ℓ).val • a := by rw [ZMod.val_natCast]

  have hSumNsmul : ∀ {A : Type u} [AddCommGroup A] (a : A) (n : ℕ)
      (s_fin : Finset (Fin n)) (c_fn : Fin n → ℕ),
      (Finset.sum s_fin (fun i => c_fn i)) • a =
        Finset.sum s_fin (fun i => c_fn i • a) := by
    intro A _ a n s_fin c_fn
    induction s_fin using Finset.induction_on with
    | empty => simp
    | insert _ _ hi ih => simp [Finset.sum_insert hi, add_nsmul, ih]

  have hSubValSmul : ∀ {A : Type u} [AddCommGroup A] {a : A} (ha : ℓ • a = 0)
      (c₁ c₂ : ZMod ℓ),
      (c₁ - c₂).val • a = c₁.val • a - c₂.val • a := by
    intro A _ a ha c₁ c₂
    apply eq_sub_of_add_eq
    rw [← add_nsmul, hnsmul_mod ha]
    have hcast : (((c₁ - c₂).val + c₂.val : ℕ) : ZMod ℓ) = c₁ := by
      push_cast
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, sub_add_cancel]
    rw [hcast]

  have hZModSmulZero : ∀ {A : Type u} [AddCommGroup A] {a : A}
      (ha_tor : ℓ • a = 0) (ha_nz : a ≠ 0) {z : ZMod ℓ},
      z.val • a = 0 → z = 0 := by
    intro A _ a ha_tor ha_nz z hz0
    by_contra hz_ne
    have hinv_smul : (z⁻¹.val * z.val) • a = 0 := by
      rw [mul_nsmul', hz0, smul_zero]
    rw [hnsmul_mod ha_tor] at hinv_smul
    have hinv_mul : (((z⁻¹.val * z.val : ℕ) : ZMod ℓ)) = 1 := by
      push_cast
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      exact inv_mul_cancel₀ hz_ne
    rw [hinv_mul, ZMod.val_one, one_smul] at hinv_smul
    exact ha_nz hinv_smul

  
  have hSecPkg := weil_algClosed_affine_closed_point_section_and_pullback_lift k
  have hPullPkg := weil_etale_torsion_pullback_functoriality.{u}
  have hModInj : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
      (θ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
      WeilCupPDIsModComparison S m j θ → Function.Injective θ := by
    intro S m j θ hθ
    obtain ⟨⟨θ₀, hθ₀, hbij₀⟩, huniq⟩ := weil_cupPD_mod_comparison_bijective_unique S m j
    rw [huniq θ θ₀ hθ hθ₀]
    exact hbij₀.1
  have hModUniq : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
      (θ₁ θ₂ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
      WeilCupPDIsModComparison S m j θ₁ →
      WeilCupPDIsModComparison S m j θ₂ →
      θ₁ = θ₂ :=
    fun S m j => (weil_cupPD_mod_comparison_bijective_unique S m j).2

  
  obtain ⟨V₁, hAff_V₁, hv₀_V₁, hInt_V₁, U₁, U₂, g_sec, u₁₂, hcov, hg_u, hUnif⟩ :=
    weil_rel_smooth_curve_section_two_open_uniformizer_chart V₀ v₀ Y₀ f₀ τ₀ hτ₀_sec hτ₀_cl

  let Y₁ := CategoryTheory.Limits.pullback f₀ V₁.ι
  let p_Y₁_Y₀ := CategoryTheory.Limits.pullback.fst f₀ V₁.ι
  let f₁ := CategoryTheory.Limits.pullback.snd f₀ V₁.ι
  let p_V₁ := CategoryTheory.CategoryStruct.comp V₁.ι p_V₀
  haveI : AlgebraicGeometry.IsAffine V₁.toScheme := hAff_V₁
  haveI : AlgebraicGeometry.IsIntegral V₁.toScheme := hInt_V₁
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_V₁ := inferInstance
  have hPb_Y₁ : CategoryTheory.IsPullback p_Y₁_Y₀ f₁ f₀ V₁.ι :=
    CategoryTheory.IsPullback.of_hasPullback f₀ V₁.ι
  haveI : AlgebraicGeometry.IsProper f₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Y₁ inferInstance
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Y₁ ‹_›

  have hGeomFib₁ :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) V₁.toScheme),
        AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f₁ s_Ω) ∧
        IsProjectiveOverField Ω
          (CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f₁ s_Ω)) :=
    fun Ω _ _ s_Ω =>
      hGeomFib_of_isPullback hPb_Y₁ Ω s_Ω (CategoryTheory.IsPullback.of_hasPullback f₁ s_Ω)

  
  obtain ⟨α₀, hα₀_tor, hα₀_nz, hR2Const⟩ :=
    weil_etale_two_open_rel_curve_r2_orientation_and_constancy k ℓ hℓ hPBC hCurveCoh
      V₁.toScheme p_V₁ Y₁ f₁ hGeomFib₁ U₁ U₂ hcov g_sec u₁₂ hg_u hUnif

  
  have hCupConst_V₁ :
      ∀ (U : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine U] [ConnectedSpace ↥U]
        (g_U : Quiver.Hom U V₁.toScheme)
        (Y_U : AlgebraicGeometry.Scheme.{u})
        (p_YU : Quiver.Hom Y_U Y₁) (f_U : Quiver.Hom Y_U U),
        CategoryTheory.IsPullback p_YU f_U f₁ g_U →
        ∀ (a b : weilCupPDModH Y_U ℓ 1),
          ∃ c_ab : ZMod ℓ,
            ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
              (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) U)
              (Y_Ω : AlgebraicGeometry.Scheme.{u})
              (ι_Ω : Quiver.Hom Y_Ω Y_U)
              (f_Ω : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
              CategoryTheory.IsPullback ι_Ω f_Ω f_U s_Ω →
              ∀ (θ_U : weilCupPDModH Y_U ℓ 2 →+ weilEtaleTorsionH Y_U ℓ 2)
                (p_Ω : weilEtaleTorsionH Y_U ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2)
                (p_α : weilEtaleTorsionH Y₁ ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2),
                WeilCupPDIsModComparison Y_U ℓ 2 θ_U →
                WeilIsTorsionEtalePullback ι_Ω ℓ 2 p_Ω →
                WeilIsTorsionEtalePullback
                  (CategoryTheory.CategoryStruct.comp ι_Ω p_YU) ℓ 2 p_α →
