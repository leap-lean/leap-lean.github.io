        trLC ν_S ρ_S hρ_over U q w = ∑ a : ZMod ℓ, q ((ρ_lift ν_S ρ_S hρ_over U a).base w) :=
    fun ν_S ρ_S hρ_over U q w =>
      map_sum (LocallyConstant.evalAddMonoidHom w)
        (fun a : ZMod ℓ => shiftLC ν_S ρ_S hρ_over U a q) Finset.univ

  have htrLC_nat :
      ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
        (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
        (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
        {U₁ U₂ : S.Etale} (u : Quiver.Hom U₂ U₁)
        (q : LocallyConstant ↥(W_obj ν_S U₁) (ULift.{u} (ZMod ℓ))),
        resLC ν_S u (trLC ν_S ρ_S hρ_over U₁ q) =
          trLC ν_S ρ_S hρ_over U₂ (resLC ν_S u q) := by
    intro S Z_S ν_S ρ_S hρ_over U₁ U₂ u q
    apply LocallyConstant.ext
    intro w
    change trLC ν_S ρ_S hρ_over U₁ q ((map_W ν_S u).base w) =
      trLC ν_S ρ_S hρ_over U₂ (resLC ν_S u q) w
    rw [htrLC_apply ν_S ρ_S hρ_over U₁ q ((map_W ν_S u).base w),
      htrLC_apply ν_S ρ_S hρ_over U₂ (resLC ν_S u q) w]
    refine Finset.sum_congr rfl fun a _ => ?_
    have hnat_a := congrArg (fun m : Quiver.Hom (W_obj ν_S U₂) (W_obj ν_S U₁) => m.base w)
      (hρ_lift_nat ν_S ρ_S hρ_over u a)
    exact congrArg q hnat_a

  let Q_sub : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (U : S.Etale),
      AddSubgroup (LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ))) :=
    fun ν_S ρ_S hρ_over U =>
      { carrier := { q | ∀ w : ↥(W_obj ν_S U), ∑ a : ZMod ℓ, q ((ρ_lift ν_S ρ_S hρ_over U a).base w) = 0 }
        zero_mem' := fun _ => Finset.sum_const_zero
        add_mem' := fun {q₁ q₂} h₁ h₂ w => by
          simp only [LocallyConstant.add_apply, Finset.sum_add_distrib, h₁ w, h₂ w, add_zero]
        neg_mem' := fun {q} hq w => by
          simp only [LocallyConstant.neg_apply, Finset.sum_neg_distrib, hq w, neg_zero] }

  let Q_pre : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S),
      CategoryTheory.Functor S.Etaleᵒᵖ AddCommGrpCat.{u} :=
    fun {S Z_S} ν_S ρ_S hρ_over =>
      { obj := fun opU => AddCommGrpCat.of ↥(Q_sub ν_S ρ_S hρ_over (Opposite.unop opU))
        map := fun {opU₁ opU₂} f =>
          AddCommGrpCat.ofHom
            { toFun := fun q =>
                ⟨resLC ν_S f.unop q.1, fun w => by
                  have h_eq := htrLC_nat ν_S ρ_S hρ_over f.unop q.1
                  have hq0 : trLC ν_S ρ_S hρ_over (Opposite.unop opU₁) q.1 = 0 :=
                    LocallyConstant.ext fun y => (htrLC_apply ν_S ρ_S hρ_over _ q.1 y).trans (q.2 y)
                  rw [hq0] at h_eq
                  have h_res0 : resLC ν_S f.unop 0 = 0 := LocallyConstant.ext fun _ => rfl
                  rw [h_res0] at h_eq
                  exact (htrLC_apply ν_S ρ_S hρ_over (Opposite.unop opU₂)
                    (resLC ν_S f.unop q.1) w).symm.trans
                    (congrArg (fun g : LocallyConstant ↥(W_obj ν_S (Opposite.unop opU₂))
                      (ULift.{u} (ZMod ℓ)) => g w) h_eq.symm)⟩
              map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
              map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
        map_id := by
          intro opU
          apply AddCommGrpCat.ext
          intro x
          apply Subtype.ext
          apply LocallyConstant.ext
          intro w
          exact congrArg x.1
            (congrArg (fun m : Quiver.Hom (W_obj ν_S (Opposite.unop opU))
              (W_obj ν_S (Opposite.unop opU)) => m.base w)
              (hmap_W_id ν_S (Opposite.unop opU)))
        map_comp := by
          intro opU₁ opU₂ opU₃ f g
          apply AddCommGrpCat.ext
          intro x
          apply Subtype.ext
          apply LocallyConstant.ext
          intro w
          exact congrArg x.1
            (congrArg (fun m : Quiver.Hom (W_obj ν_S (Opposite.unop opU₃))
              (W_obj ν_S (Opposite.unop opU₁)) => m.base w)
              (hmap_W_comp ν_S g.unop f.unop)) }

  have hSh_Q : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S),
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (Q_pre ν_S ρ_S hρ_over) := by
    intro S Z_S ν_S ρ_S hρ_over
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp S.smallEtaleTopology
      (Q_pre ν_S ρ_S hρ_over) (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    have hP_sh : CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology
        ((P_of ν_S).obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type _ _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf S.smallEtaleTopology
          (P_of ν_S).obj (CategoryTheory.forget AddCommGrpCat.{u}) (P_of ν_S).property)
    intro U R hR x hx
    let y : CategoryTheory.Presieve.FamilyOfElements
        ((P_of ν_S).obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R.arrows :=
      fun _ f hf => (x f hf).1
    have hy : y.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      exact congrArg Subtype.val (hx g₁ g₂ hf₁ hf₂ hcomm)
    have hSheafR : CategoryTheory.Presieve.IsSheafFor
        ((P_of ν_S).obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R.arrows :=
      hP_sh R hR
    obtain ⟨q, hq_amalg, hq_uniq⟩ := hSheafR y hy
    let q_lc : LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)) := q
    have htr_zero : trLC ν_S ρ_S hρ_over U q_lc = 0 := by
      let z₀ : ↑((P_of ν_S).obj.obj (Opposite.op U)) :=
        (0 : LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)))
      let z_tr : ↑((P_of ν_S).obj.obj (Opposite.op U)) := trLC ν_S ρ_S hρ_over U q_lc
      change z_tr = z₀
      apply hSheafR.isSeparatedFor.ext
      intro Y f hf
      change resLC ν_S f (trLC ν_S ρ_S hρ_over U q_lc) = resLC ν_S f 0
      have hres0 : resLC ν_S f 0 = 0 := LocallyConstant.ext fun _ => rfl
      rw [hres0, htrLC_nat ν_S ρ_S hρ_over f q_lc]
      have hres : resLC ν_S f q_lc = (x f hf).1 := hq_amalg f hf
      rw [hres]
      exact LocallyConstant.ext fun w =>
        (htrLC_apply ν_S ρ_S hρ_over Y (x f hf).1 w).trans ((x f hf).2 w)
    have hq_mem : q_lc ∈ Q_sub ν_S ρ_S hρ_over U := fun w =>
      (htrLC_apply ν_S ρ_S hρ_over U q_lc w).symm.trans
        (congrArg (fun g : LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)) => g w) htr_zero)
    refine ⟨⟨q_lc, hq_mem⟩, fun Y f hf => Subtype.ext (hq_amalg f hf), fun q' hq' => Subtype.ext ?_⟩
    exact hq_uniq q'.1 (fun Y f hf => congrArg Subtype.val (hq' f hf))

  let Q_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S),
      (∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S) →
      (ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
        ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)) →
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    fun ν_S ρ_S hρ_over _ => ⟨Q_pre ν_S ρ_S hρ_over, hSh_Q ν_S ρ_S hρ_over⟩

  let τ_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
        ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
      Quiver.Hom (P_of ν_S) (Q_of ν_S ρ_S hρ_over hρ_act) :=
    fun {_ _} ν_S ρ_S hρ_over hρ_act =>
      { hom :=
          { app := fun opU =>
              let U := Opposite.unop opU
              AddCommGrpCat.ofHom
                { toFun := fun (f : LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ))) =>
                    ⟨shiftLC ν_S ρ_S hρ_over U 1 f - f, fun w => by
                      simp only [LocallyConstant.sub_apply, Finset.sum_sub_distrib]
                      change (∑ a : ZMod ℓ,
                          f ((ρ_lift ν_S ρ_S hρ_over U 1).base ((ρ_lift ν_S ρ_S hρ_over U a).base w))) -
                        (∑ a : ZMod ℓ, f ((ρ_lift ν_S ρ_S hρ_over U a).base w)) = 0
                      have hshift_eq :
                          (∑ a : ZMod ℓ,
                            f ((ρ_lift ν_S ρ_S hρ_over U 1).base ((ρ_lift ν_S ρ_S hρ_over U a).base w))) =
                          ∑ a : ZMod ℓ, f ((ρ_lift ν_S ρ_S hρ_over U a).base w) := by
                        have hcomp :
                            (∑ a : ZMod ℓ,
                              f ((ρ_lift ν_S ρ_S hρ_over U 1).base ((ρ_lift ν_S ρ_S hρ_over U a).base w))) =
                            ∑ a : ZMod ℓ,
                              f ((ρ_lift ν_S ρ_S hρ_over U (Equiv.addRight (1 : ZMod ℓ) a)).base w) := by
                          refine Finset.sum_congr rfl fun a _ => ?_
                          have hadd := congrArg
                            (fun m : Quiver.Hom (W_obj ν_S U) (W_obj ν_S U) => m.base w)
                            (hρ_lift_add ν_S ρ_S hρ_over hρ_act U a 1)
                          exact congrArg f hadd.symm
                        rw [hcomp]
                        exact Equiv.sum_comp (Equiv.addRight (1 : ZMod ℓ))
                          (fun b : ZMod ℓ => f ((ρ_lift ν_S ρ_S hρ_over U b).base w))
                      rw [hshift_eq, sub_self]⟩
                  map_zero' := Subtype.ext (LocallyConstant.ext fun _ => sub_zero 0)
                  map_add' := fun f₁ f₂ => Subtype.ext (LocallyConstant.ext fun w =>
                    add_sub_add_comm _ _ (f₁ w) (f₂ w)) }
            naturality := fun {opU₁ opU₂} u => by
              apply AddCommGrpCat.ext
              intro f
              let f_lc : LocallyConstant ↥(W_obj ν_S (Opposite.unop opU₁)) (ULift.{u} (ZMod ℓ)) := f
              apply Subtype.ext
              apply LocallyConstant.ext
              intro w
              have hnat1 := congrArg
                (fun m : Quiver.Hom (W_obj ν_S (Opposite.unop opU₂))
                  (W_obj ν_S (Opposite.unop opU₁)) => m.base w)
                (hρ_lift_nat ν_S ρ_S hρ_over u.unop 1)
              exact congrArg (fun v => v - f_lc ((map_W ν_S u.unop).base w))
                (congrArg f_lc hnat1.symm) } }

  let δ_L_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
        ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
      Quiver.Hom (L_of S) (Q_of ν_S ρ_S hρ_over hρ_act) :=
    fun {S _} ν_S ρ_S hρ_over _ =>
      { hom :=
          { app := fun opU =>
              let U := Opposite.unop opU
              AddCommGrpCat.ofHom
                { toFun := fun (g : LocallyConstant
                      ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left
                      (ULift.{u} (ZMod ℓ))) =>
                    ⟨((weilAltLocConstPullbackNat ν_S ℓ).app opU).hom g, fun w => by
                      change (∑ a : ZMod ℓ,
                        g ((CategoryTheory.Limits.pullback.fst
                          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S).base
                          ((ρ_lift ν_S ρ_S hρ_over U a).base w))) = 0
                      have hconst :
                          (∑ a : ZMod ℓ,
                            g ((CategoryTheory.Limits.pullback.fst
                              ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S).base
                              ((ρ_lift ν_S ρ_S hρ_over U a).base w))) =
                          ∑ _a : ZMod ℓ,
                            g ((CategoryTheory.Limits.pullback.fst
                              ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S).base w) := by
                        refine Finset.sum_congr rfl fun a _ => ?_
                        have hfst_a := congrArg
                          (fun m : Quiver.Hom (W_obj ν_S U)
                            ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left => m.base w)
                          (hρ_lift_fst ν_S ρ_S hρ_over U a)
                        exact congrArg g hfst_a
                      rw [hconst, Finset.sum_const, Finset.card_univ, ZMod.card ℓ]
                      apply ULift.ext
                      change (ℓ • (g _).down) = 0
                      rw [nsmul_eq_mul, CharP.cast_eq_zero (ZMod ℓ) ℓ, zero_mul]⟩
                  map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
                  map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
            naturality := fun {opU₁ opU₂} u => by
              apply AddCommGrpCat.ext
              intro g
              apply Subtype.ext
              exact congrArg (fun φ => φ.hom g) ((weilAltLocConstPullbackNat ν_S ℓ).naturality u) } }

  have h0_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
        ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
      CategoryTheory.CategoryStruct.comp (Δ_of ν_S) (τ_of ν_S ρ_S hρ_over hρ_act) = 0 := by
    intro S Z_S ν_S ρ_S hρ_over hρ_act
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext opU
    let U := Opposite.unop opU
    apply AddCommGrpCat.ext
    intro g
    let g_lc : LocallyConstant
        ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left
        (ULift.{u} (ZMod ℓ)) := g
    apply Subtype.ext
    apply LocallyConstant.ext
    intro w
    have hfst1 := congrArg
      (fun m : Quiver.Hom (W_obj ν_S U) ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).left => m.base w)
      (hρ_lift_fst ν_S ρ_S hρ_over U 1)
    change g_lc ((CategoryTheory.Limits.pullback.fst
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S).base
        ((ρ_lift ν_S ρ_S hρ_over U 1).base w)) -
      g_lc ((CategoryTheory.Limits.pullback.fst
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S).base w) = 0
    exact sub_eq_zero.mpr (congrArg g_lc hfst1)

  have hDesc :
      ∀ {S Z_S U₀ : AlgebraicGeometry.Scheme.{u}}
        (ν_S : Quiver.Hom Z_S S)
        [AlgebraicGeometry.Etale ν_S] [AlgebraicGeometry.Surjective ν_S]
        (p_U : Quiver.Hom U₀ S)
        (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
        (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
        (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
          ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
        (∀ (V₀ : AlgebraicGeometry.Scheme.{u}) (p_V : Quiver.Hom V₀ S)
            (s : Quiver.Hom V₀ Z_S) (hs : CategoryTheory.CategoryStruct.comp s ν_S = p_V),
            let W_V := CategoryTheory.Limits.pullback p_V ν_S
            let ι_V : ZMod ℓ → Quiver.Hom V₀ W_V :=
              fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id V₀)
                (CategoryTheory.CategoryStruct.comp s (ρ_S a))
                ((CategoryTheory.Category.id_comp p_V).trans
                  (hs.symm.trans
                    ((congrArg (CategoryTheory.CategoryStruct.comp s) (hρ_over a)).symm.trans
                      (CategoryTheory.Category.assoc s (ρ_S a) ν_S).symm)))
            (⋃ a : ZMod ℓ, Set.range (ι_V a).base) = Set.univ) →
        let W_U := CategoryTheory.Limits.pullback p_U ν_S
        let pr₁ : Quiver.Hom W_U U₀ := CategoryTheory.Limits.pullback.fst p_U ν_S
        let ρ_U : ZMod ℓ → Quiver.Hom W_U W_U :=
          fun b => CategoryTheory.Limits.pullback.lift pr₁
            (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd p_U ν_S) (ρ_S b))
            (CategoryTheory.Limits.pullback.condition.trans
              ((congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd p_U ν_S))
                (hρ_over b)).symm.trans
                (CategoryTheory.Category.assoc _ (ρ_S b) ν_S).symm))
        (∀ g₁ g₂ : LocallyConstant ↥U₀ (ULift.{u} (ZMod ℓ)),
          (∀ w : ↥W_U, g₁ (pr₁.base w) = g₂ (pr₁.base w)) → g₁ = g₂) ∧
        (∀ f : LocallyConstant ↥W_U (ULift.{u} (ZMod ℓ)),
          (∀ w : ↥W_U, f ((ρ_U 1).base w) = f w) →
          ∃ g : LocallyConstant ↥U₀ (ULift.{u} (ZMod ℓ)),
            ∀ w : ↥W_U, g (pr₁.base w) = f w) := by
    intro S Z_S U₀ ν_S _ _ p_U ρ_S hρ_over hρ_act hSheetUniv W_U pr₁ ρ_U
    let snd_U : Quiver.Hom W_U Z_S := CategoryTheory.Limits.pullback.snd p_U ν_S
    have hPb_U : CategoryTheory.IsPullback snd_U pr₁ ν_S p_U :=
      (CategoryTheory.IsPullback.of_hasPullback p_U ν_S).flip
    haveI : AlgebraicGeometry.Etale pr₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_U inferInstance
    haveI : AlgebraicGeometry.Surjective pr₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_U inferInstance
    refine ⟨?_, ?_⟩
    · intro g₁ g₂ h_eq
      apply LocallyConstant.ext
      intro x
      obtain ⟨w, rfl⟩ := pr₁.surjective x
      exact h_eq w
    · intro f hf1
      have hρ_U_zero : ρ_U 0 = CategoryTheory.CategoryStruct.id W_U := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [ρ_U]
          rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
        · dsimp [ρ_U]
          rw [CategoryTheory.Limits.pullback.lift_snd, hρ_act.1,
            CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      have hρ_U_add : ∀ a b : ZMod ℓ,
          ρ_U (a + b) = CategoryTheory.CategoryStruct.comp (ρ_U a) (ρ_U b) := by
        intro a b
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [ρ_U]
          rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
        · dsimp [ρ_U]
          rw [CategoryTheory.Limits.pullback.lift_snd, hρ_act.2 a b,
            CategoryTheory.Category.assoc (ρ_U a), CategoryTheory.Limits.pullback.lift_snd,
            ← CategoryTheory.Category.assoc (ρ_U a), CategoryTheory.Limits.pullback.lift_snd,
            CategoryTheory.Category.assoc]
      have hf_nat : ∀ (n : ℕ) (w : ↥W_U), f ((ρ_U (n : ZMod ℓ)).base w) = f w := by
        intro n
        induction n with
        | zero =>
          intro w
          rw [Nat.cast_zero, hρ_U_zero]
          rfl
        | succ n ih =>
          intro w
          rw [Nat.cast_succ, hρ_U_add]
          change f ((ρ_U 1).base ((ρ_U (n : ZMod ℓ)).base w)) = f w
          rw [hf1, ih]
      have hf_all : ∀ (a : ZMod ℓ) (w : ↥W_U), f ((ρ_U a).base w) = f w := by
        intro a w
        rw [← ZMod.natCast_zmod_val a]
        exact hf_nat a.val w
      let p_V : Quiver.Hom W_U S := CategoryTheory.CategoryStruct.comp pr₁ p_U
      let W_V := CategoryTheory.Limits.pullback p_V ν_S
      let fst₁ : Quiver.Hom W_V W_U := CategoryTheory.Limits.pullback.fst p_V ν_S
      let snd₁ : Quiver.Hom W_V Z_S := CategoryTheory.Limits.pullback.snd p_V ν_S
      let m₁ : Quiver.Hom W_V W_U :=
        CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.comp fst₁ pr₁) snd₁
          ((CategoryTheory.Category.assoc fst₁ pr₁ p_U).trans CategoryTheory.Limits.pullback.condition)
      have hm₁_fst : CategoryTheory.CategoryStruct.comp m₁ pr₁ =
          CategoryTheory.CategoryStruct.comp fst₁ pr₁ :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hm₁_snd : CategoryTheory.CategoryStruct.comp m₁ snd_U = snd₁ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hPb_outer : CategoryTheory.IsPullback
          (CategoryTheory.CategoryStruct.comp m₁ snd_U) fst₁ ν_S
          (CategoryTheory.CategoryStruct.comp pr₁ p_U) := by
        rw [hm₁_snd]
        exact (CategoryTheory.IsPullback.of_hasPullback p_V ν_S).flip
      have hPb_W : CategoryTheory.IsPullback m₁ fst₁ pr₁ pr₁ :=
