  have : CategoryTheory.Limits.PreservesFiniteLimits B :=
    CategoryTheory.Limits.preservesFiniteLimits_of_reflects_of_preserves B FgtEt₁

  have hBT₂_term : CategoryTheory.Limits.IsTerminal (B.obj T_std_2) :=
    CategoryTheory.Limits.IsTerminal.isTerminalObj B T_std_2 hT_std_2
  let e_τ : B.obj T_std_2 ≅ T_std_1 := hBT₂_term.uniqueUpToIso hT_std_1
  have he_τ_hom : e_τ.hom = τ_std := hT_std_1.hom_ext _ _
  let τ_inv : Quiver.Hom T_std_1 (B.obj T_std_2) := e_τ.inv
  have hτ_hom_inv : τ_std ≫ τ_inv = 𝟙 (B.obj T_std_2) := by
    rw [← he_τ_hom]; exact e_τ.hom_inv_id
  have hτ_inv_hom : τ_inv ≫ τ_std = 𝟙 T_std_1 := by
    rw [← he_τ_hom]; exact e_τ.inv_hom_id

  let E_fwd : ∀ (𝒢 : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R)),
      (P_pull_R.obj oneR_2 ⟶ 𝒢) → (oneR_1 ⟶ 𝒢) := fun 𝒢 φ =>
    (adjR_std_1.homEquiv M_R 𝒢).symm
      (((adjR_std_2.homEquiv M_R (P_push_R.obj 𝒢)) ((adj_pull_R.homEquiv oneR_2 𝒢) φ)) ≫
        𝒢.obj.map τ_inv.op)

  have hE_nat : ∀ {𝒢 𝒢' : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R)}
      (φ : P_pull_R.obj oneR_2 ⟶ 𝒢) (g : 𝒢 ⟶ 𝒢'),
      E_fwd 𝒢' (φ ≫ g) = E_fwd 𝒢 φ ≫ g := by
    intro 𝒢 𝒢' φ g
    dsimp [E_fwd]
    rw [adj_pull_R.homEquiv_naturality_right, adjR_std_2.homEquiv_naturality_right]
    let x₀ : M_R ⟶ 𝒢.obj.obj (Opposite.op (B.obj T_std_2)) :=
      (adjR_std_2.homEquiv M_R (P_push_R.obj 𝒢)) ((adj_pull_R.homEquiv oneR_2 𝒢) φ)
    let g_B : 𝒢.obj.obj (Opposite.op (B.obj T_std_2)) ⟶ 𝒢'.obj.obj (Opposite.op (B.obj T_std_2)) :=
      g.hom.app (Opposite.op (B.obj T_std_2))
    let g_T1 : 𝒢.obj.obj (Opposite.op T_std_1) ⟶ 𝒢'.obj.obj (Opposite.op T_std_1) :=
      g.hom.app (Opposite.op T_std_1)
    change (adjR_std_1.homEquiv M_R 𝒢').symm ((x₀ ≫ g_B) ≫ 𝒢'.obj.map τ_inv.op) =
      (adjR_std_1.homEquiv M_R 𝒢).symm (x₀ ≫ 𝒢.obj.map τ_inv.op) ≫ g
    have hcomm : g_B ≫ 𝒢'.obj.map τ_inv.op = 𝒢.obj.map τ_inv.op ≫ g_T1 :=
      (g.hom.naturality τ_inv.op).symm
    rw [CategoryTheory.Category.assoc, hcomm, ← CategoryTheory.Category.assoc]
    exact adjR_std_1.homEquiv_naturality_right_symm (x₀ ≫ 𝒢.obj.map τ_inv.op) g

  have hE_inj : ∀ {𝒢 : CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R)}
      {φ₁ φ₂ : P_pull_R.obj oneR_2 ⟶ 𝒢}, E_fwd 𝒢 φ₁ = E_fwd 𝒢 φ₂ → φ₁ = φ₂ := by
    intro 𝒢 φ₁ φ₂ hEq
    have h1 := (adjR_std_1.homEquiv M_R 𝒢).symm.injective hEq
    let u₁ : M_R ⟶ 𝒢.obj.obj (Opposite.op (B.obj T_std_2)) :=
      (adjR_std_2.homEquiv M_R (P_push_R.obj 𝒢)) ((adj_pull_R.homEquiv oneR_2 𝒢) φ₁)
    let u₂ : M_R ⟶ 𝒢.obj.obj (Opposite.op (B.obj T_std_2)) :=
      (adjR_std_2.homEquiv M_R (P_push_R.obj 𝒢)) ((adj_pull_R.homEquiv oneR_2 𝒢) φ₂)
    have h2 : u₁ = u₂ := by
      change u₁ ≫ 𝒢.obj.map τ_inv.op = u₂ ≫ 𝒢.obj.map τ_inv.op at h1
      have h1' := congrArg (fun f => f ≫ 𝒢.obj.map τ_std.op) h1
      have hmap_id : 𝒢.obj.map τ_inv.op ≫ 𝒢.obj.map τ_std.op = 𝟙 _ := by
        rw [← 𝒢.obj.map_comp]
        exact (congrArg (fun u => 𝒢.obj.map (Opposite.op u)) hτ_hom_inv).trans (𝒢.obj.map_id _)
      rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hmap_id,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.comp_id] at h1'
      exact h1'
    exact (adj_pull_R.homEquiv oneR_2 𝒢).injective
      ((adjR_std_2.homEquiv M_R (P_push_R.obj 𝒢)).injective h2)

  let π_R : Quiver.Hom (P_pull_R.obj oneR_2) oneR_1 :=
    (adj_pull_R.homEquiv oneR_2 oneR_1).symm
      ((adjR_std_2.homEquiv M_R (P_push_R.obj oneR_1)).symm
        (adjR_std_1.unit.app M_R ≫ oneR_1.obj.map τ_std.op))
  let ι_R : Quiver.Hom oneR_1 (P_pull_R.obj oneR_2) :=
    E_fwd (P_pull_R.obj oneR_2) (𝟙 (P_pull_R.obj oneR_2))

  have hE_πR : E_fwd oneR_1 π_R = 𝟙 oneR_1 := by
    dsimp [E_fwd, π_R]
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    let u_R1 : M_R ⟶ oneR_1.obj.obj (Opposite.op T_std_1) := adjR_std_1.unit.app M_R
    change (adjR_std_1.homEquiv M_R oneR_1).symm
        ((u_R1 ≫ oneR_1.obj.map τ_std.op) ≫ oneR_1.obj.map τ_inv.op) = 𝟙 oneR_1
    have hmap_id : oneR_1.obj.map τ_std.op ≫ oneR_1.obj.map τ_inv.op = 𝟙 _ := by
      rw [← oneR_1.obj.map_comp]
      exact (congrArg (fun u => oneR_1.obj.map (Opposite.op u)) hτ_inv_hom).trans
        (oneR_1.obj.map_id _)
    rw [CategoryTheory.Category.assoc, hmap_id, CategoryTheory.Category.comp_id]
    apply (adjR_std_1.homEquiv M_R oneR_1).injective
    rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Functor.map_id]
    exact (CategoryTheory.Category.comp_id _).symm

  have hιπ_R : ι_R ≫ π_R = 𝟙 oneR_1 := by
    dsimp [ι_R]
    rw [← hE_nat (𝟙 (P_pull_R.obj oneR_2)) π_R, CategoryTheory.Category.id_comp, hE_πR]

  have hπι_R : π_R ≫ ι_R = 𝟙 (P_pull_R.obj oneR_2) := by
    apply hE_inj
    rw [hE_nat π_R ι_R, hE_πR, CategoryTheory.Category.id_comp]

  
  let u_πR : P_pull_ℤ.obj (U_std_2.obj oneR_2) ⟶ U_std_1.obj oneR_1 := U_std_1.map π_R
  let u_ιR : U_std_1.obj oneR_1 ⟶ P_pull_ℤ.obj (U_std_2.obj oneR_2) := U_std_1.map ι_R
  let βM_std_1 : U_std_1.obj oneR_1 ⟶ FM_1 := βM_1
