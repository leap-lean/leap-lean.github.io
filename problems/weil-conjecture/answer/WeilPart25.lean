          have hcup0 :
              θ_η_2 (CategoryTheory.Abelian.Ext.comp γ_η (t_η_cls b_idx) (rfl : 1 + 1 = 2)) =
                0 := by
            rw [hγ0, CategoryTheory.Abelian.Ext.zero_comp, map_zero]
          have hcup_val :
              θ_η_2 (CategoryTheory.Abelian.Ext.comp γ_η (t_η_cls b_idx) (rfl : 1 + 1 = 2)) =
