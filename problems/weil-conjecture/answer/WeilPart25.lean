            trivial
          inv := CategoryTheory.MorphismProperty.Over.homMk l_inv
            (CategoryTheory.Limits.pullback.lift_snd _ _ _)
            trivial
          hom_inv_id := by
            apply CategoryTheory.MorphismProperty.Comma.Hom.ext
            · apply CategoryTheory.Limits.pullback.hom_ext
              · change (CategoryTheory.Limits.pullback.fst w_hom (CategoryTheory.CategoryStruct.id U₁) ≫
                    l_inv) ≫
                  CategoryTheory.Limits.pullback.fst w_hom (CategoryTheory.CategoryStruct.id U₁) =
                  CategoryTheory.CategoryStruct.id _ ≫
                    CategoryTheory.Limits.pullback.fst w_hom (CategoryTheory.CategoryStruct.id U₁)
                dsimp [l_inv]
                rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
