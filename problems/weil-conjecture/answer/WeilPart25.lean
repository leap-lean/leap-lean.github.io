  have hConstUnitTerm :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        (J : CategoryTheory.GrothendieckTopology C)
        [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
        {T T' : C} (hT : CategoryTheory.Limits.IsTerminal T)
        (hT' : CategoryTheory.Limits.IsTerminal T')
        (A : AddCommGrpCat.{u}),
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A ≫
          (((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A).obj.map
            (Opposite.op (hT'.from T))) =
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A := by
    intro C _ J _ T T' hT hT' A
    change ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT').comp
        (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u})).unit.app A ≫
      (((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A).obj.map
        (Opposite.op (hT'.from T))) =
      ((CategoryTheory.constantPresheafAdj AddCommGrpCat.{u} hT).comp
        (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u})).unit.app A
    rw [CategoryTheory.Adjunction.comp_unit_app, CategoryTheory.Adjunction.comp_unit_app,
        CategoryTheory.constantPresheafAdj_unit_app, CategoryTheory.constantPresheafAdj_unit_app,
        CategoryTheory.Category.id_comp, CategoryTheory.Category.id_comp]
    let η_sh := (CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).unit.app
      ((CategoryTheory.Functor.const Cᵒᵖ).obj A)
    have hnat := η_sh.naturality (Opposite.op (hT'.from T))
    dsimp at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm

  have hConstEquivTerm :
      ∀ {C : Type (u + 1)} [CategoryTheory.Category.{u} C]
        (J : CategoryTheory.GrothendieckTopology C)
        [CategoryTheory.HasWeakSheafify J AddCommGrpCat.{u}]
        {T T' : C} (hT : CategoryTheory.Limits.IsTerminal T)
        (hT' : CategoryTheory.Limits.IsTerminal T')
        (A : AddCommGrpCat.{u}) (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
        (ψ : (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A ⟶ 𝒢),
        ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').homEquiv A 𝒢 ψ) ≫
          𝒢.obj.map (Opposite.op (hT'.from T)) =
        (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).homEquiv A 𝒢 ψ := by
    intro C _ J _ T T' hT hT' A 𝒢 ψ
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Category.assoc]
    change (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT').unit.app A ≫
        (ψ.hom.app (Opposite.op T') ≫ 𝒢.obj.map (Opposite.op (hT'.from T))) =
      (CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT).unit.app A ≫
        ψ.hom.app (Opposite.op T)
    rw [← ψ.hom.naturality (Opposite.op (hT'.from T)), ← CategoryTheory.Category.assoc,
        hConstUnitTerm J hT hT' A]

  let τ_std : Quiver.Hom (B.obj T_std_2) T_std_1 := hT_std_1.from (B.obj T_std_2)
  let π_A_std : ∀ A : AddCommGrpCat.{u}, Quiver.Hom (P_pull_ℤ.obj (Cℤ_2.obj A)) (Cℤ_1.obj A) :=
    fun A =>
