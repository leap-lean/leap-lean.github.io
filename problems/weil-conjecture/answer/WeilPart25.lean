        (CategoryTheory.Limits.PullbackCone.IsLimit.mk
          (by
            dsimp [specToW]
            rw [CategoryTheory.Category.assoc, P_cur.e_W.inv_hom_id,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
          (fun s => s.snd)
          (fun s => by
