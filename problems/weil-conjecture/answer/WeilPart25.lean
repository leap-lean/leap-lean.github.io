        have hτ₁₂_app : ι_B₁₂U₃ ≫ (weilEtaleLocalTorsionMap X₁ ℓ τ₁₂).hom.app (Opposite.op (B₁₂.obj U₃)) =
            ι₁ ≫ L₁.obj.map (Opposite.op τ₁₂) := by
          rw [← hEquiv_comp (𝟙 L_B₁₂U₃) (weilEtaleLocalTorsionMap X₁ ℓ τ₁₂),
            CategoryTheory.Category.id_comp]
          exact Equiv.apply_symm_apply _ _
        change ((ι_BU₃ ≫ (weilEtaleLocalTorsionMap X₂ ℓ τ₂).hom.app (Opposite.op (B₂.obj U₃))) ≫
            (u_BU₂.hom.app (Opposite.op (B₂.obj U₃)) ≫
              (weilEtaleLocalTorsionMap X₁ ℓ τ₁).hom.app (Opposite.op (B₁.obj (B₂.obj U₃))))) ≫
            L₁.obj.map (Opposite.op (e_B.hom.app U₃)) =
          ι_B₁₂U₃ ≫ (weilEtaleLocalTorsionMap X₁ ℓ τ₁₂).hom.app (Opposite.op (B₁₂.obj U₃))
        rw [hτ₂_app, hτ₁₂_app]
        have h_mid : (CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L₂) ≫
            L₂.obj.map (Opposite.op τ₂)) ≫ u_BU₂.hom.app (Opposite.op (B₂.obj U₃)) =
            ι_BU₂ ≫ L_BU₂.obj.map (Opposite.op (B₁.map τ₂)) := by
          rw [CategoryTheory.Category.assoc, u_BU₂.hom.naturality (Opposite.op τ₂),
            ← CategoryTheory.Category.assoc,
            ← hEquiv_comp (𝟙 L₂) u_BU₂, CategoryTheory.Category.id_comp, hu_BU₂]
          rfl
        let m_τ₁ := weilEtaleLocalTorsionMap X₁ ℓ τ₁
        have h_step1 :
            ((CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L₂) ≫
                L₂.obj.map (Opposite.op τ₂)) ≫
              (u_BU₂.hom.app (Opposite.op (B₂.obj U₃)) ≫
                m_τ₁.hom.app (Opposite.op (B₁.obj (B₂.obj U₃))))) =
            ι₁ ≫ (L₁.obj.map (Opposite.op τ₁) ≫ L₁.obj.map (Opposite.op (B₁.map τ₂))) :=
          (CategoryTheory.Category.assoc _
            (u_BU₂.hom.app (Opposite.op (B₂.obj U₃)))
            (m_τ₁.hom.app (Opposite.op (B₁.obj (B₂.obj U₃))))).symm.trans
            ((congrArg (· ≫ m_τ₁.hom.app (Opposite.op (B₁.obj (B₂.obj U₃)))) h_mid).trans
              ((CategoryTheory.Category.assoc ι_BU₂
                (L_BU₂.obj.map (Opposite.op (B₁.map τ₂))) _).trans
                ((congrArg (ι_BU₂ ≫ ·)
                  (m_τ₁.hom.naturality (Opposite.op (B₁.map τ₂)))).trans
                  ((CategoryTheory.Category.assoc ι_BU₂ _
                    (L₁.obj.map (Opposite.op (B₁.map τ₂)))).symm.trans
                    ((congrArg (· ≫ L₁.obj.map (Opposite.op (B₁.map τ₂))) hτ₁_app).trans
                      (CategoryTheory.Category.assoc ι₁ _ _))))))
        refine (congrArg (· ≫ L₁.obj.map (Opposite.op (e_B.hom.app U₃))) h_step1).trans ?_
        rw [hτ₁₂_eq]
        change (ι₁ ≫ (L₁.obj.map (Opposite.op τ₁) ≫ L₁.obj.map (Opposite.op (B₁.map τ₂)))) ≫
            L₁.obj.map (Opposite.op (e_B.hom.app U₃)) =
          ι₁ ≫ L₁.obj.map ((Opposite.op τ₁ ≫ Opposite.op (B₁.map τ₂)) ≫ Opposite.op (e_B.hom.app U₃))
        rw [L₁.obj.map_comp, L₁.obj.map_comp,
          CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
      have h_symm_eq : (adj_rhs.homEquiv L₃ L₁).symm (adj₁₂.homEquiv L₃ L₁ π_loc₁₂) =
          pb₁.map π_loc₂ ≫ π_loc₁ := by
        rw [← h_mate, Equiv.symm_apply_apply]
      have h_left := hLeftAdjSymm adj₁₂ adj_rhs (adj₁₂.homEquiv L₃ L₁ π_loc₁₂)
      rw [Equiv.symm_apply_apply, h_symm_eq] at h_left
      exact h_left

    ext x
    rw [AddMonoidHom.comp_apply,
      hLocEvalCan (h₁ ≫ h₂) U₁ U₃ τ₁₂ 2 p₁₂ hCont₁₂ hAdj₁₂ ιℤ₁₂ hι₁₂_2 hp₁₂ x,
      hLocEvalCan h₁ U₁ U₂ τ₁ 2 p₁ hCont₁ hAdj₁ ιℤ₁ hι₁_2 hp₁ (p₂ x),
      hLocEvalCan h₂ U₂ U₃ τ₂ 2 p₂ hCont₂ hAdj₂ ιℤ₂ hι₂_2 hp₂ x]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₁₂).comp
          ((pb₁₂.mapExtAddHom (C₃.obj Aℤ) L₃ 2) x) (Nat.zero_add 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_loc₁₂) (Nat.add_zero 2) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ₁).comp
          ((pb₁.mapExtAddHom (C₂.obj Aℤ) L₂ 2)
            (((CategoryTheory.Abelian.Ext.mk₀ ιℤ₂).comp
              ((pb₂.mapExtAddHom (C₃.obj Aℤ) L₃ 2) x) (Nat.zero_add 2)).comp
              (CategoryTheory.Abelian.Ext.mk₀ π_loc₂) (Nat.add_zero 2)))
          (Nat.zero_add 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_loc₁) (Nat.add_zero 2)
    rw [hιℤ₁₂_eq, hπ_loc_comp]
    let y := (pb₁.mapExtAddHom (pb₂.obj (C₃.obj Aℤ)) (pb₂.obj L₃) 2)
      ((pb₂.mapExtAddHom (C₃.obj Aℤ) L₃ 2) x)
    have hnat : ((pb₁₂.mapExtAddHom (C₃.obj Aℤ) L₃ 2) x).comp
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app L₃)) (Nat.add_zero 2) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app (C₃.obj Aℤ))).comp y (Nat.zero_add 2) := by
      have h1 := hMapExtNat η.hom 2 (C₃.obj Aℤ) L₃ x
      rwa [hMapExtComp pb₂ pb₁ 2 (C₃.obj Aℤ) L₃ x] at h1
    have h_id_cancel :
        ((ιℤ₁ ≫ pb₁.map ιℤ₂) ≫ η.inv.app (C₃.obj Aℤ)) ≫ η.hom.app (C₃.obj Aℤ) =
          ιℤ₁ ≫ pb₁.map ιℤ₂ :=
      (CategoryTheory.Category.assoc (ιℤ₁ ≫ pb₁.map ιℤ₂)
        (η.inv.app (C₃.obj Aℤ)) (η.hom.app (C₃.obj Aℤ))).trans
        ((congrArg ((ιℤ₁ ≫ pb₁.map ιℤ₂) ≫ ·) (η.inv_hom_id_app (C₃.obj Aℤ))).trans
          (CategoryTheory.Category.comp_id (ιℤ₁ ≫ pb₁.map ιℤ₂)))
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (η.hom.app L₃) (pb₁.map π_loc₂ ≫ π_loc₁),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app L₃)) _ (Nat.add_zero 2),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ((ιℤ₁ ≫ pb₁.map ιℤ₂) ≫ η.inv.app (C₃.obj Aℤ))) _
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app L₃)) (Nat.zero_add 2),
      hnat,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc,
      h_id_cancel,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc ιℤ₁ (pb₁.map ιℤ₂) y,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (pb₁.map π_loc₂) π_loc₁,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (pb₁.map π_loc₂))
        (CategoryTheory.Abelian.Ext.mk₀ π_loc₁) (Nat.add_zero 2),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ₁) _
        (CategoryTheory.Abelian.Ext.mk₀ (pb₁.map π_loc₂)) (Nat.zero_add 2)]
    congr 2
    dsimp [y]
    rw [← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb₁ ιℤ₂,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb₁ π_loc₂,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb₁,
      ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb₁]

  · 
    intro X₁ X₂ h U₁ U₂ τ_U p_loc p_tor hp_loc hp_tor
    obtain ⟨hCont, hAdj, hAdd, hLim, hColim, -, -, -, -, ιℤ_can, _hι₁, hι₂⟩ :=
      hCanWitness h
    have : (weilEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology := hCont
    let B := weilEtaleSitePullback h
    let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _ B AddCommGrpCat.{u} _
      X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
    let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u}
      X₂.smallEtaleTopology X₁.smallEtaleTopology
    let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B AddCommGrpCat.{u} _
      X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
    have : pb.Additive := hAdd
    have : CategoryTheory.Limits.PreservesFiniteLimits pb := hLim
    have : CategoryTheory.Limits.PreservesFiniteColimits pb := hColim
    let C₁ := CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}
    let L₁ := weilEtaleLocalTorsionSheaf X₁ ℓ U₁
    let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
    let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ (B.obj U₂)
    let ι_BU := CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_BU)
    let π_BU_can := (adj.homEquiv L₂ L_BU).symm (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU)
    let π_loc_can := π_BU_can ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U
    let πM_can := (adj.homEquiv (C₂.obj AM) (C₁.obj AM)).symm (@uConst X₁ X₂ h hCont AM)

    have hp_tor_can : ∀ y : weilEtaleTorsionH X₂ ℓ 2,
        p_tor y = ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_can).comp
          ((pb.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 2) y) (Nat.zero_add 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM_can) (Nat.add_zero 2) := by
      intro y
      rcases hp_tor with ⟨hCont', P_pull, adj_pull, hAdd', hLim', hColim', T₁, hT₁, T₂, hT₂, ιℤ, hι₁', _hι₂', hptor_eq⟩
      cases Subsingleton.elim hCont' hCont
      have : P_pull.Additive := hAdd'
      have : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim'
      have : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim'
      rw [hptor_eq y]
      let η : P_pull ≅ pb := adj_pull.leftAdjointUniq adj
      let πℤ_can := (adj.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm (@uConst X₁ X₂ h hCont Aℤ)
      have hπℤ_eq :
          (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
            (((CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).homEquiv
              Aℤ _).symm
              ((CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app Aℤ ≫
                (C₁.obj Aℤ).obj.map (Opposite.op (hT₁.from (B.obj T₂))))) =
          η.hom.app (C₂.obj Aℤ) ≫ πℤ_can :=
        (congrArg (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          (@hConstUnitEq X₁ X₂ h hCont T₁ hT₁ T₂ hT₂ Aℤ)).trans
          (hLeftAdjSymm adj_pull adj (@uConst X₁ X₂ h hCont Aℤ))
      have hι_rel : ιℤ ≫ η.hom.app (C₂.obj Aℤ) = ιℤ_can :=
        inv_uniq (p := πℤ_can)
          ((CategoryTheory.Category.assoc ιℤ (η.hom.app (C₂.obj Aℤ)) πℤ_can).trans
            ((congrArg (ιℤ ≫ ·) hπℤ_eq.symm).trans hι₁'))
          hι₂
      have hπM_eq :
          (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
            (((CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).homEquiv
              AM _).symm
              ((CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app AM ≫
                (C₁.obj AM).obj.map (Opposite.op (hT₁.from (B.obj T₂))))) =
          η.hom.app (C₂.obj AM) ≫ πM_can :=
        (congrArg (adj_pull.homEquiv (C₂.obj AM) (C₁.obj AM)).symm
          (@hConstUnitEq X₁ X₂ h hCont T₁ hT₁ T₂ hT₂ AM)).trans
          (hLeftAdjSymm adj_pull adj (@uConst X₁ X₂ h hCont AM))
      change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
          ((P_pull.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 2) y) (Nat.zero_add 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ _) (Nat.add_zero 2) = _
      rw [hπM_eq, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (η.hom.app (C₂.obj AM)) πM_can,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app (C₂.obj AM)))
          (CategoryTheory.Abelian.Ext.mk₀ πM_can) (Nat.add_zero 2),
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
          (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
          (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app (C₂.obj AM))) (Nat.zero_add 2),
        hMapExtNat η.hom 2 (C₂.obj Aℤ) (C₂.obj AM) y,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hι_rel]

    let c₁ := weilEtaleLocalTorsionCounit X₁ ℓ U₁
    let c₂ := weilEtaleLocalTorsionCounit X₂ ℓ U₂
    have hSheafSq : π_loc_can ≫ c₁ = pb.map c₂ ≫ πM_can := by
      apply (adj.homEquiv L₂ (C₁.obj AM)).injective
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      let u_BU : L₂ ⟶ pf.obj L_BU := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU
      have hL : adj.homEquiv L₂ (C₁.obj AM) (π_loc_can ≫ c₁) =
          u_BU ≫ pf.map (weilEtaleLocalTorsionMap X₁ ℓ τ_U ≫ c₁) := by
        dsimp [π_loc_can, π_BU_can, u_BU]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Adjunction.homEquiv_naturality_right,
          Equiv.apply_symm_apply]
      have hR : adj.homEquiv L₂ (C₁.obj AM) (pb.map c₂ ≫ πM_can) =
          c₂ ≫ @uConst X₁ X₂ h hCont AM := by
        dsimp [πM_can]
        rw [CategoryTheory.Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply]
      let eqv_BU : (L₂ ⟶ pf.obj L_BU) ≃ (AM ⟶ (pf.obj L_BU).obj.obj (Opposite.op U₂)) :=
        CategoryTheory.Sheaf.freeYonedaHomEquiv
      have hu_BU : CategoryTheory.Sheaf.freeYonedaHomEquiv u_BU = ι_BU :=
        eqv_BU.apply_symm_apply ι_BU
      rw [hL, hR, hEquiv_comp, hEquiv_comp, hu_BU]
      let sh₁ := CategoryTheory.sheafificationAdjunction X₁.smallEtaleTopology AddCommGrpCat.{u}
      let sh₂ := CategoryTheory.sheafificationAdjunction X₂.smallEtaleTopology AddCommGrpCat.{u}
      let P_AM₁ := (CategoryTheory.Functor.const (Opposite X₁.Etale)).obj AM
      let P_AM₂ := (CategoryTheory.Functor.const (Opposite X₂.Etale)).obj AM
      have hLHS_app : ι_BU ≫ (pf.map (weilEtaleLocalTorsionMap X₁ ℓ τ_U ≫ c₁)).hom.app (Opposite.op U₂) =
          (sh₁.unit.app P_AM₁).app (Opposite.op (B.obj U₂)) := by
        change ι_BU ≫ ((weilEtaleLocalTorsionMap X₁ ℓ τ_U).hom.app (Opposite.op (B.obj U₂)) ≫
            c₁.hom.app (Opposite.op (B.obj U₂))) = _
        rw [← CategoryTheory.Category.assoc]
        have hτ_eq : ι_BU ≫ (weilEtaleLocalTorsionMap X₁ ℓ τ_U).hom.app (Opposite.op (B.obj U₂)) =
            CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L₁) ≫
              L₁.obj.map (Opposite.op τ_U) := by
          rw [← hEquiv_comp (𝟙 L_BU) (weilEtaleLocalTorsionMap X₁ ℓ τ_U),
            CategoryTheory.Category.id_comp]
          exact Equiv.apply_symm_apply _ _
        rw [hτ_eq, CategoryTheory.Category.assoc, c₁.hom.naturality (Opposite.op τ_U),
          ← CategoryTheory.Category.assoc, ← hEquiv_comp (𝟙 L₁) c₁,
          CategoryTheory.Category.id_comp]
        have hc₁_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv c₁ =
            (sh₁.unit.app P_AM₁).app (Opposite.op U₁) :=
          Equiv.apply_symm_apply _ _
        rw [hc₁_eq]
        have hnat₁ := ((sh₁.unit.app P_AM₁).naturality (Opposite.op τ_U)).symm
        change (sh₁.unit.app P_AM₁).app (Opposite.op U₁) ≫ (C₁.obj AM).obj.map (Opposite.op τ_U) =
          𝟙 AM ≫ (sh₁.unit.app P_AM₁).app (Opposite.op (B.obj U₂)) at hnat₁
        rwa [CategoryTheory.Category.id_comp] at hnat₁
      have hRHS_app : CategoryTheory.Sheaf.freeYonedaHomEquiv c₂ ≫
          (@uConst X₁ X₂ h hCont AM).hom.app (Opposite.op U₂) =
          (sh₁.unit.app P_AM₁).app (Opposite.op (B.obj U₂)) := by
        have hc₂_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv c₂ =
            (sh₂.unit.app P_AM₂).app (Opposite.op U₂) :=
          Equiv.apply_symm_apply _ _
        rw [hc₂_eq]
        exact congrArg (fun nt => nt.app (Opposite.op U₂))
          (Equiv.apply_symm_apply (sh₂.homEquiv P_AM₂ (pf.obj (C₁.obj AM)))
            (CategoryTheory.Functor.whiskerLeft B.op (sh₁.unit.app P_AM₁)))
      exact hLHS_app.trans hRHS_app.symm

    ext x
    rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply,
      hLocEvalCan h U₁ U₂ τ_U 2 p_loc hCont hAdj ιℤ_can hι₂ hp_loc x,
      hp_tor_can (weilEtaleLocalTorsionCounitH X₂ ℓ U₂ 2 x)]
    change (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_can).comp
          ((pb.mapExtAddHom (C₂.obj Aℤ) L₂ 2) x) (Nat.zero_add 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ π_loc_can) (Nat.add_zero 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ c₁) (Nat.add_zero 2) =
      ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_can).comp
          ((pb.mapExtAddHom (C₂.obj Aℤ) (C₂.obj AM) 2)
            (x.comp (CategoryTheory.Abelian.Ext.mk₀ c₂) (Nat.add_zero 2)))
          (Nat.zero_add 2)).comp
          (CategoryTheory.Abelian.Ext.mk₀ πM_can) (Nat.add_zero 2)
    rw [CategoryTheory.Functor.mapExtAddHom_apply pb (C₂.obj Aℤ) (C₂.obj AM) 2,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp pb,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pb c₂,
      ← CategoryTheory.Functor.mapExtAddHom_apply pb (C₂.obj Aℤ) L₂ 2,
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ π_loc_can) (CategoryTheory.Abelian.Ext.mk₀ c₁) (Nat.add_zero 2),
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hSheafSq,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (pb.map c₂) πM_can,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (pb.map c₂)) (CategoryTheory.Abelian.Ext.mk₀ πM_can) (Nat.add_zero 2),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ_can) _
        (CategoryTheory.Abelian.Ext.mk₀ (pb.map c₂)) (Nat.zero_add 2)]

theorem weil_etale_sheafify_finite_pigeonhole_local_constancy (S : AlgebraicGeometry.Scheme.{u}) (A₀ : AddCommGrpCat.{u}) [Finite ↥A₀]
    (P : CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u})
    (α : CategoryTheory.NatTrans ((CategoryTheory.Functor.const (Opposite S.Etale)).obj A₀) P) :
    let J := S.smallEtaleTopology
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    (∀ U : S.Etale, Nonempty ↥(Fgt.obj U).left →
      Function.Injective (α.app (Opposite.op U)).hom) →
    Nonempty (CategoryTheory.Iso
      ((CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj A₀)
      ((CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P)) →
    ∀ (U : S.Etale) (x : ↥(P.obj (Opposite.op U))),
      ∃ R ∈ J U,
        ∀ (V : S.Etale) (f : Quiver.Hom V U), R.arrows f →
