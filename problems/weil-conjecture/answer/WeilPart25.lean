    let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
    ((∀ (G : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
        Subsingleton ↥(G.obj.obj (Opposite.op T_k)) →
        CategoryTheory.Limits.IsZero G) ∧
      (∀ {G₁ G₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom G₁ G₂),
        Function.Bijective ((φ.hom.app (Opposite.op T_k)).hom) →
        CategoryTheory.IsIso φ) ∧
      (∀ (Z : AlgebraicGeometry.Scheme.{u}) (p : Quiver.Hom Z S_k)
          (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        Subsingleton (G.H q) →
        CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage p q G))) ∧
    (∀ (S : CategoryTheory.Over S_k) [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        (G : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (s_y : Quiver.Hom S_k S.left),
        CategoryTheory.CategoryStruct.comp s_y S.hom = CategoryTheory.CategoryStruct.id S_k →
        ∃ (_hc : (weilEtaleSitePullback s_y).IsContinuous
            S.left.smallEtaleTopology S_k.smallEtaleTopology)
          (_hr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback s_y) AddCommGrpCat.{u} _
            S.left.smallEtaleTopology S_k.smallEtaleTopology _hc).IsRightAdjoint),
          CategoryTheory.Limits.IsZero
            ((@CategoryTheory.Functor.sheafPullback _ _ _ _
              (weilEtaleSitePullback s_y) AddCommGrpCat.{u} _
              S.left.smallEtaleTopology S_k.smallEtaleTopology _hc _hr).obj G)) →
      CategoryTheory.Limits.IsZero G) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme := @AlgebraicGeometry.Etale
  let pt_k : ↥S_k := ⟨⊥, Ideal.bot_isMaximal.isPrime⟩
  have hSub_Sk : Subsingleton ↥S_k :=
    ⟨fun p₁ p₂ => PrimeSpectrum.ext (by
      have h₁ : p₁.asIdeal = ⊥ := (Ideal.eq_bot_or_top p₁.asIdeal).resolve_right p₁.isPrime.ne_top
      have h₂ : p₂.asIdeal = ⊥ := (Ideal.eq_bot_or_top p₂.asIdeal).resolve_right p₂.isPrime.ne_top
      exact h₁.trans h₂.symm)⟩

  
  have hNull : ∀ (R_cat : CommRingCat.{u})
      (p_W : AlgebraicGeometry.Spec R_cat ⟶ S_k)
      [AlgebraicGeometry.LocallyOfFiniteType p_W]
      (m₀ : Ideal ↑R_cat) (hm₀ : m₀.IsMaximal),
      ∃ (σ₀ : S_k ⟶ AlgebraicGeometry.Spec R_cat),
        σ₀ ≫ p_W = 𝟙 S_k ∧
        σ₀.base pt_k = ⟨m₀, hm₀.isPrime⟩ := by
    intro R_cat p_W _ m₀ hm₀
    have : m₀.IsMaximal := hm₀
    let φ_k : CommRingCat.of k ⟶ R_cat := AlgebraicGeometry.Spec.preimage p_W
    have hφ_k : AlgebraicGeometry.Spec.map φ_k = p_W := AlgebraicGeometry.Spec.map_preimage p_W
    have hp_ft : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_k) := by
      rw [hφ_k]; infer_instance
    have hring_ft : RingHom.FiniteType φ_k.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hp_ft
    letI : Algebra k ↑R_cat := φ_k.hom.toAlgebra
    have halg_ft : Algebra.FiniteType k ↑R_cat := hring_ft
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp halg_ft
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑R_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom m₀
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, hm_mv_eq⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f : MvPolynomial (Fin n_mv) k, f ∈ RingHom.ker q_hom → ev_hom f = 0 := by
      intro f hf
      have hf_m : f ∈ m_mv := by
        change q_hom f ∈ m₀
        rw [RingHom.mem_ker.mp hf]
        exact m₀.zero_mem
      rw [hm_mv_eq, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hf_m
      exact hf_m
    let σ_R : ↑R_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp
        (RingHom.quotientKerEquivOfSurjective hq_hom_surj).symm.toRingHom
    have hσ_q : ∀ f : MvPolynomial (Fin n_mv) k, σ_R (q_hom f) = ev_hom f := by
      intro f
      have hsymm : (RingHom.quotientKerEquivOfSurjective hq_hom_surj).symm (q_hom f) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f := by
        apply (RingHom.quotientKerEquivOfSurjective hq_hom_surj).injective
        rw [RingEquiv.apply_symm_apply]
        rfl
      change Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le
        ((RingHom.quotientKerEquivOfSurjective hq_hom_surj).symm (q_hom f)) = ev_hom f
      rw [hsymm]
      rfl
    have hφ_σ : φ_k ≫ CommRingCat.ofHom σ_R = 𝟙 (CommRingCat.of k) := by
      apply CommRingCat.hom_ext
      ext c
      have hcomm : q_hom (MvPolynomial.C c) = φ_k.hom c := by
        change q_mv (MvPolynomial.C c) = algebraMap k (↑R_cat) c
        rw [← MvPolynomial.algebraMap_eq]
        exact q_mv.commutes c
      change σ_R (φ_k.hom c) = c
      rw [← hcomm, hσ_q]
      exact MvPolynomial.aeval_C a_pt c
    let σ₀ : S_k ⟶ AlgebraicGeometry.Spec R_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_R)
    refine ⟨σ₀, ?_, ?_⟩
    · rw [← hφ_k, ← AlgebraicGeometry.Spec.map_comp, hφ_σ, AlgebraicGeometry.Spec.map_id]
    · apply PrimeSpectrum.ext
      ext r
      obtain ⟨f, rfl⟩ := hq_hom_surj r
      change σ_R (q_hom f) ∈ (⊥ : Ideal k) ↔ q_hom f ∈ m₀
      rw [Ideal.mem_bot, hσ_q]
      change MvPolynomial.aeval a_pt f = 0 ↔ q_hom f ∈ m₀
      rw [← MvPolynomial.mem_vanishingIdeal_singleton_iff, ← hm_mv_eq]
      rfl

  
  have hPointLift : ∀ (V : S_k.Etale) (v : ↥V.left),
      ∃ (α_v : T_k ⟶ V), P_et α_v.left ∧ α_v.left.base pt_k = v := by
    intro V v
    have : AlgebraicGeometry.Etale V.hom := V.prop
    obtain ⟨R_cat, ι_W, hOpen_ι, ⟨p₀, hp₀⟩, -⟩ :=
      AlgebraicGeometry.Scheme.exists_affine_mem_range_and_range_subset
        (U := (⊤ : V.left.Opens)) (x := v) trivial
    have : AlgebraicGeometry.IsOpenImmersion ι_W := hOpen_ι
    let p_W : AlgebraicGeometry.Spec R_cat ⟶ S_k := ι_W ≫ V.hom
    have : AlgebraicGeometry.Etale p_W := inferInstance
    obtain ⟨m₀, hm₀_max, hm₀_le⟩ := Ideal.exists_le_maximal p₀.asIdeal p₀.isPrime.ne_top
    let q_max : AlgebraicGeometry.Spec R_cat := ⟨m₀, hm₀_max.isPrime⟩
    have hq_cl : q_max ∈ closure ({p₀} : Set ↥(AlgebraicGeometry.Spec R_cat)) :=
      (PrimeSpectrum.le_iff_mem_closure (x := p₀) (y := q_max)).mp hm₀_le
    obtain ⟨σ₀, hσ₀_comp, hσ₀_pt⟩ := hNull R_cat p_W m₀ hm₀_max
    have hEt_comp : P_et (σ₀ ≫ p_W) := by
      rw [hσ₀_comp]
      exact (inferInstance : AlgebraicGeometry.Etale (𝟙 S_k))
    have hEt_pW : P_et p_W := inferInstance
    have : AlgebraicGeometry.Etale σ₀ :=
      CategoryTheory.MorphismProperty.of_postcomp P_et σ₀ p_W hEt_pW hEt_comp
    have hOpen_range : IsOpen (Set.range σ₀.base) :=
      (AlgebraicGeometry.Scheme.Hom.isOpenMap σ₀).isOpen_range
    have hq_range : q_max ∈ Set.range σ₀.base := ⟨pt_k, hσ₀_pt⟩
    obtain ⟨z_hit, ⟨y_k, rfl⟩, hz_sing⟩ :=
      mem_closure_iff.mp hq_cl (Set.range σ₀.base) hOpen_range hq_range
    have hp₀_eq : σ₀.base pt_k = p₀ := by
      rw [@Subsingleton.elim _ hSub_Sk pt_k y_k]
      exact Set.mem_singleton_iff.mp hz_sing
    let s_v : S_k ⟶ V.left := σ₀ ≫ ι_W
    have hs_v_et : P_et s_v := inferInstance
    have hs_v_w : s_v ≫ V.hom = T_k.hom := by
      change (σ₀ ≫ ι_W) ≫ V.hom = 𝟙 S_k
      rw [CategoryTheory.Category.assoc]
      exact hσ₀_comp
    let α_v : T_k ⟶ V := CategoryTheory.MorphismProperty.Over.homMk s_v hs_v_w trivial
    refine ⟨α_v, hs_v_et, ?_⟩
    change ι_W.base (σ₀.base pt_k) = v
    rw [hp₀_eq]
    exact hp₀

  let R_sieve : ∀ (V : S_k.Etale), CategoryTheory.Sieve V := fun V =>
    { arrows := fun {W} g => ∃ (α : T_k ⟶ V) (β : W ⟶ T_k), β ≫ α = g
      downward_closed := by
        rintro W₁ W₂ g ⟨α, β, rfl⟩ γ
        exact ⟨α, γ ≫ β, CategoryTheory.Category.assoc γ β α⟩ }

  have hCov_Sk : ∀ (V : S_k.Etale), R_sieve V ∈ S_k.smallEtaleTopology V := by
    intro V
    have hTop_eq :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) S_k (le_refl P_et)
    have hMem_pre : R_sieve V ∈ (S_k.smallPretopology P_et P_et).toGrothendieck V := by
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S_k) V (R_sieve V)).mpr ?_
      intro v
      obtain ⟨α_v, hEt_α, hv_eq⟩ := hPointLift V v
      exact ⟨T_k, α_v, pt_k, ⟨α_v, 𝟙 T_k, CategoryTheory.Category.id_comp α_v⟩, hEt_α, hv_eq⟩
    exact Eq.mpr
      (congrArg (fun (J : CategoryTheory.GrothendieckTopology S_k.Etale) => R_sieve V ∈ J V) hTop_eq)
      hMem_pre

  have hFaithful : ∀ (P : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u})
      (H : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u})
      (ψ : P ⟶ H.obj),
      ψ.app (Opposite.op T_k) = 0 → ψ = 0 := by
    intro P H ψ h0
    ext V_op x
    rcases V_op with ⟨V⟩
    have hSep := CategoryTheory.Sheaf.isSeparated H V (R_sieve V) (hCov_Sk V)
    refine hSep ((ψ.app (Opposite.op V)).hom x) 0 ?_
    rintro W g ⟨α, β, rfl⟩
    have hnat : (H.obj.map α.op).hom ((ψ.app (Opposite.op V)).hom x) =
        (ψ.app (Opposite.op T_k)).hom ((P.map α.op).hom x) :=
      (congrArg (fun (f : P.obj (Opposite.op V) ⟶ H.obj.obj (Opposite.op T_k)) => f.hom x)
        (ψ.naturality α.op)).symm
    change (H.obj.map (α.op ≫ β.op)).hom ((ψ.app (Opposite.op V)).hom x) =
      (H.obj.map (α.op ≫ β.op)).hom 0
    rw [map_zero, H.obj.map_comp]
    change (H.obj.map β.op).hom ((H.obj.map α.op).hom ((ψ.app (Opposite.op V)).hom x)) = 0
    rw [hnat, h0]
    exact map_zero _

  have hSheafZeroHom : ∀ {H₁ H₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}},
      (0 : H₁ ⟶ H₂).hom = 0 := by
    intro H₁ H₂
    exact (CategoryTheory.sheafToPresheaf S_k.smallEtaleTopology AddCommGrpCat.{u}).map_zero H₁ H₂

  
  have hPart1a : ∀ (G : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}),
      Subsingleton ↥(G.obj.obj (Opposite.op T_k)) →
      CategoryTheory.Limits.IsZero G := by
    intro G hSub
    rw [CategoryTheory.Limits.IsZero.iff_id_eq_zero]
    apply CategoryTheory.Sheaf.hom_ext
    rw [hSheafZeroHom]
    refine hFaithful G.obj G (CategoryTheory.CategoryStruct.id G).hom ?_
    ext x
    exact @Subsingleton.elim _ hSub _ _

  
  have hPart1b : ∀ {G₁ G₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
      (φ : Quiver.Hom G₁ G₂),
      Function.Bijective ((φ.hom.app (Opposite.op T_k)).hom) →
      CategoryTheory.IsIso φ := by
    intro G₁ G₂ φ hBij
    have : CategoryTheory.Mono φ := by
      rw [CategoryTheory.Preadditive.mono_iff_cancel_zero]
      intro K g hg
      apply CategoryTheory.Sheaf.hom_ext
      rw [hSheafZeroHom]
      refine hFaithful K.obj G₁ g.hom ?_
      ext x
      apply hBij.1
      have hgx : ((g ≫ φ).hom.app (Opposite.op T_k)).hom x = 0 := by
        rw [hg, hSheafZeroHom]; rfl
      simpa using hgx
    have : CategoryTheory.Epi φ := by
      rw [CategoryTheory.Preadditive.epi_iff_cancel_zero]
      intro K g hg
      apply CategoryTheory.Sheaf.hom_ext
      rw [hSheafZeroHom]
      refine hFaithful G₂.obj K g.hom ?_
      ext y
      obtain ⟨x, rfl⟩ := hBij.2 y
      have hgx : ((φ ≫ g).hom.app (Opposite.op T_k)).hom x = 0 := by
        rw [hg, hSheafZeroHom]; rfl
      simpa using hgx
    exact CategoryTheory.isIso_of_mono_of_epi φ

  
  have hPart1c : ∀ (Z : AlgebraicGeometry.Scheme.{u}) (p : Quiver.Hom Z S_k)
      (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
      Subsingleton (G.H q) →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage p q G) := by
    intro Z p G q hSub
    have : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) p :=
      CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
    have : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) p :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    let B_p : CategoryTheory.Functor S_k.Etale Z.Etale :=
      CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ p
    let T_bp : Z.Etale := B_p.obj T_k
    have hTerm : CategoryTheory.Limits.IsTerminal T_bp :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun W =>
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift (W.hom ≫ p) W.hom
              (CategoryTheory.Category.comp_id (W.hom ≫ p)))
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial)
        (fun W m => by
          refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
          apply CategoryTheory.Limits.pullback.hom_ext
          · exact (CategoryTheory.Category.comp_id
                (m.left ≫ CategoryTheory.Limits.pullback.fst T_k.hom p)).symm.trans
              ((CategoryTheory.Category.assoc m.left
                  (CategoryTheory.Limits.pullback.fst T_k.hom p) T_k.hom).trans
                ((congrArg (m.left ≫ ·)
                    (CategoryTheory.Limits.pullback.condition (f := T_k.hom) (g := p))).trans
                  (((CategoryTheory.Category.assoc m.left
                        (CategoryTheory.Limits.pullback.snd T_k.hom p) p).symm.trans
                      (congrArg (· ≫ p) (CategoryTheory.MorphismProperty.Over.w m))).trans
                    (CategoryTheory.Limits.pullback.lift_fst (W.hom ≫ p) W.hom
                      (CategoryTheory.Category.comp_id (W.hom ≫ p))).symm)))
          · exact (CategoryTheory.MorphismProperty.Over.w m).trans
              (CategoryTheory.Limits.pullback.lift_snd _ _ _).symm)
    let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u, 0} ℤ)
    let FPU : AddCommGrpCat.{u} := AddCommGrpCat.free.obj PUnit.{u + 1}
    let gen₀ : ↥FPU := (AddCommGrpCat.adj.unit.app PUnit.{u + 1}) PUnit.unit
    let to_ℤ : FPU ⟶ Aℤ :=
      (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Aℤ).symm
        (TypeCat.ofHom (fun _ => ULift.up (1 : ℤ)))
    let from_ℤ : Aℤ ⟶ FPU :=
      AddCommGrpCat.ofHom
        { toFun := fun z => z.down • gen₀
          map_zero' := zero_zsmul gen₀
          map_add' := fun a b => add_zsmul gen₀ a.down b.down }
    have hto_gen₀ : to_ℤ.hom gen₀ = ULift.up (1 : ℤ) := by
      have hu := CategoryTheory.Adjunction.homEquiv_unit AddCommGrpCat.adj PUnit.{u + 1} Aℤ to_ℤ
      have hu' : AddCommGrpCat.adj.unit.app PUnit.{u + 1} ≫
          (CategoryTheory.forget AddCommGrpCat.{u}).map to_ℤ =
          TypeCat.ofHom (fun _ => ULift.up (1 : ℤ)) := by
        rw [← hu]
        exact Equiv.apply_symm_apply _ _
      exact congrArg (fun (f : PUnit.{u + 1} ⟶ (CategoryTheory.forget AddCommGrpCat.{u}).obj Aℤ) =>
        f PUnit.unit) hu'
    let e_ℤ : FPU ≅ Aℤ :=
      { hom := to_ℤ
        inv := from_ℤ
        hom_inv_id := by
          apply (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} FPU).injective
          ext ⟨⟩
          have h1 := CategoryTheory.Adjunction.homEquiv_naturality_right AddCommGrpCat.adj
            to_ℤ from_ℤ
          rw [h1]
          have h2 : (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} Aℤ) to_ℤ =
              TypeCat.ofHom (fun _ => ULift.up (1 : ℤ)) :=
            Equiv.apply_symm_apply _ _
          have h3 : (AddCommGrpCat.adj.homEquiv PUnit.{u + 1} FPU) (𝟙 FPU) =
              AddCommGrpCat.adj.unit.app PUnit.{u + 1} := by
            rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id,
              CategoryTheory.Category.comp_id]
          rw [h2, h3]
          change (1 : ℤ) • gen₀ = gen₀
          exact one_zsmul gen₀
        inv_hom_id := by
          apply AddCommGrpCat.hom_ext
          refine AddMonoidHom.ext (fun z => ?_)
          rcases z with ⟨n⟩
          change to_ℤ.hom (n • gen₀) = ULift.up n
          rw [map_zsmul, hto_gen₀]
          apply ULift.ext
          exact mul_one n }
    let e_yon : CategoryTheory.yoneda.obj T_bp ≅
        (CategoryTheory.Functor.const (Opposite Z.Etale)).obj PUnit.{u + 1} :=
      CategoryTheory.NatIso.ofComponents
        (fun W =>
          { hom := TypeCat.ofHom (fun _ => PUnit.unit)
            inv := TypeCat.ofHom (fun _ => hTerm.from W.unop)
            hom_inv_id := by
              ext f
              exact hTerm.hom_ext _ _
            inv_hom_id := by
              ext ⟨⟩
              rfl })
        (fun _ => by ext; rfl)
    let φ_pre : (CategoryTheory.yoneda.obj T_bp).comp AddCommGrpCat.free ≅
        (CategoryTheory.Functor.const (Opposite Z.Etale)).obj Aℤ :=
      CategoryTheory.NatIso.ofComponents
        (fun W => AddCommGrpCat.free.mapIso (e_yon.app W) ≪≫ e_ℤ)
        (fun {W₁ W₂} f => by
          dsimp
          rw [← CategoryTheory.Category.assoc, ← AddCommGrpCat.free.map_comp,
            CategoryTheory.Category.comp_id]
          apply congrArg (· ≫ to_ℤ)
          apply congrArg AddCommGrpCat.free.map
          ext)
    let S_rep := (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).obj
      ((CategoryTheory.yoneda.obj T_bp).comp AddCommGrpCat.free)
    let φ_ℤ := (CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u}).mapIso φ_pre
    let to_H := (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv).precomp G (Nat.zero_add q)
    let inv_H := (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom).precomp G (Nat.zero_add q)
    have hSub_P : Subsingleton ↥((G.cohomologyPresheaf q).obj (Opposite.op T_bp)) := by
      refine ⟨fun a b => ?_⟩
      have hret : ∀ x' : CategoryTheory.Abelian.Ext S_rep G q, inv_H (to_H x') = x' := by
        intro x'
        change (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom).comp
          ((CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv).comp x' (Nat.zero_add q)) (Nat.zero_add q) = x'
        rw [← CategoryTheory.Abelian.Ext.comp_assoc
            (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.hom)
            (CategoryTheory.Abelian.Ext.mk₀ φ_ℤ.inv) x'
            (Nat.zero_add 0) (Nat.zero_add q) (Nat.zero_add q),
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, φ_ℤ.hom_inv_id,
          CategoryTheory.Abelian.Ext.mk₀_id_comp]
      have ha : inv_H (to_H a) = a := hret a
      have hb : inv_H (to_H b) = b := hret b
      have heq : to_H a = to_H b := @Subsingleton.elim _ hSub (to_H a) (to_H b)
      exact ha.symm.trans ((congrArg inv_H heq).trans hb)
    let P : CategoryTheory.Functor (Opposite S_k.Etale) AddCommGrpCat.{u} :=
      CategoryTheory.Functor.comp B_p.op (G.cohomologyPresheaf q)
