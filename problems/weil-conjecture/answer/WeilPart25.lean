  let h_W₂_sch : W₂_sch ⟶ (Fgt_Y.obj P.W).left := (Fgt_Y.map h_W₂).left
  let w_Y₂ : W₂_sch ⟶ Y₂_V₂ :=
    CategoryTheory.Limits.pullback.lift
      (h_W₂_sch ≫ P.e_W.hom ≫ P.W_open.ι) f_W₂
      (by
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc]
        exact hPb_W₂.w)
  have hw_Y₂_p₂ : w_Y₂ ≫ p₂_Y = h_W₂_sch ≫ P.e_W.hom ≫ P.W_open.ι :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hw_Y₂_f₂ : w_Y₂ ≫ f₂_V₂ = f_W₂ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_eW_sq : CategoryTheory.IsPullback P.e_W.hom
      (P.e_W.hom ≫ P.W_open.ι ≫ P.f_bar) (P.W_open.ι ≫ P.f_bar) (𝟙 V_P) :=
    CategoryTheory.IsPullback.of_isLimit
