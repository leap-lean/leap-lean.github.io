    let e_comp : pf_f₂ ≅ pf_ν ⋙ pf_f₁ := e_pf_raw ≪≫ e_pf_assoc
    let eA : pf_f₂.obj ((U_sh Y₂.left).obj I₂) ≅ pf_f₁.obj (pf_ν.obj ((U_sh Y₂.left).obj I₂)) :=
