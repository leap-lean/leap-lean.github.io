                exact h₂'.trans (CategoryTheory.Limits.pullback.lift_fst _ _ (hc_cond c)).symm
              · have h₁' : m ≫ q₁_V =
                    c.snd ≫ CategoryTheory.Limits.pullback.fst p_EV₁ E.Y_bar.hom :=
