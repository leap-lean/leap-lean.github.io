      refine Finset.sum_eq_single b (fun a _ hab => ?_) (fun hb => absurd (Finset.mem_univ b) hb)
      rw [CategoryTheory.Category.assoc, hιQ_π a b, dif_neg hab, CategoryTheory.Limits.comp_zero]
    rw [hsum, CategoryTheory.Category.assoc, hιQ_π b b, dif_pos rfl]
