        let fst := CategoryTheory.Limits.pullback.fst f₁.left f₂.left
        let snd := CategoryTheory.Limits.pullback.snd f₁.left f₂.left
        have hz₁ : fst z = y₁ := hz₁_raw
        have hz₂ : snd z = y₂ := hz₂_raw
        let W : S.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (fst ≫ Y₁.hom) inferInstance
        let g₁ : W ⟶ Y₁ :=
          CategoryTheory.MorphismProperty.Over.homMk fst rfl trivial
        have hw₂ : snd ≫ Y₂.hom = fst ≫ Y₁.hom := by
          rw [← CategoryTheory.MorphismProperty.Over.w f₂,
            ← CategoryTheory.Category.assoc,
            ← CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc,
            CategoryTheory.MorphismProperty.Over.w f₁]
        let g₂ : W ⟶ Y₂ :=
          CategoryTheory.MorphismProperty.Over.homMk snd hw₂ trivial
        have hg : g₁ ≫ f₁ = g₂ ≫ f₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        have hcomp_sf := hsf g₁ g₂ hf₁ hf₂ hg
        have heval := congrArg (fun (k : LocallyConstant ↥W.left AM_type) => k.toFun z) hcomp_sf
        change LocallyConstant.toFun (X := ↥Y₁.left) (Y := AM_type) (sf f₁ hf₁) (fst z) =
          LocallyConstant.toFun (X := ↥Y₂.left) (Y := AM_type) (sf f₂ hf₂) (snd z) at heval
        rwa [hz₁, hz₂] at heval
      let Y_of : ↥U.left → S.Etale := fun x => Classical.choose (hCover x)
      let f_of : ∀ x : ↥U.left, Y_of x ⟶ U :=
        fun x => Classical.choose (Classical.choose_spec (hCover x))
      let y_of : ∀ x : ↥U.left, ↥(Y_of x).left :=
        fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (hCover x)))
      have hf_of : ∀ x : ↥U.left, R.arrows (f_of x) :=
        fun x => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCover x)))).1
      have hEt_f_of : ∀ x : ↥U.left, AlgebraicGeometry.Etale (f_of x).left :=
        fun x => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCover x)))).2.1
      have hy_of : ∀ x : ↥U.left, (f_of x).left (y_of x) = x :=
        fun x => (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCover x)))).2.2
      let t_fun : ↥U.left → AM_type :=
        fun x => LocallyConstant.toFun (X := ↥(Y_of x).left) (Y := AM_type)
          (sf (f_of x) (hf_of x)) (y_of x)
      have ht_pull : ∀ {Y : S.Etale} (f : Y ⟶ U) (hf : R.arrows f) (y : ↥Y.left),
          t_fun (f.left y) = LocallyConstant.toFun (X := ↥Y.left) (Y := AM_type) (sf f hf) y :=
        fun f hf y => h_agree (hf_of (f.left y)) hf (y_of (f.left y)) y (hy_of (f.left y))
      have ht_lc : IsLocallyConstant t_fun := by
        intro s_set
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        have : AlgebraicGeometry.Etale (f_of x).left := hEt_f_of x
        let sf_x : LocallyConstant ↥(Y_of x).left AM_type := sf (f_of x) (hf_of x)
        refine ⟨⇑(f_of x).left '' (sf_x ⁻¹' s_set), ?_, ?_, ?_⟩
        · rintro _ ⟨y', hy', rfl⟩
          change t_fun ((f_of x).left y') ∈ s_set
          rw [ht_pull (f_of x) (hf_of x) y']
          exact hy'
        · exact (f_of x).left.isOpenMap _ (sf_x.isLocallyConstant s_set)
        · exact ⟨y_of x, hx, hy_of x⟩
      let t : LocallyConstant ↥U.left AM_type := ⟨t_fun, ht_lc⟩
