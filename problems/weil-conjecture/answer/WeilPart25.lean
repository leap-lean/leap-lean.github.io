                ((w_α : K_C) * (Finset.univ.prod fun j : Fin M => (ι_α (h_Q j α)) ^ ℓ)) := by
                rw [hden_K]; ring
          _ = algebraMap Rx K_C b_f * ((f_rat : K_C) * (ι_α (h_P₀ α)) ^ (ℓ * M)) := by
                rw [hw_prod]
          _ = algebraMap Rx K_C num_x := by rw [hnum_K]; ring
          _ = algebraMap Rx K_C (den_x * (u_x : Rx)) := by rw [hu_x]
          _ = algebraMap Rx K_C den_x * algebraMap Rx K_C (u_x : Rx) := map_mul _ _ _
      have hwinv_eq_ux :
          ((w_α⁻¹ : Units K_C) : K_C) = algebraMap Rx K_C ((u_x⁻¹ : Units Rx) : Rx) := by
        have hmul1 :
