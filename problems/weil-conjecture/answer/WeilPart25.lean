by
  classical
  intro L_of P_of Δ_of
  have hPrime_ℓ : Nat.Prime ℓ := Fact.out
  haveI : NeZero ℓ := ⟨hPrime_ℓ.ne_zero⟩
  haveI : Fact (1 < ℓ) := ⟨hPrime_ℓ.one_lt⟩

  let W_obj : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S) (U : S.Etale),
      AlgebraicGeometry.Scheme.{u} :=
    fun {S _} ν_S U =>
      CategoryTheory.Limits.pullback ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S

  let map_W : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
      {V₁ V₂ : X₂.Etale} (v : Quiver.Hom V₁ V₂),
      Quiver.Hom (W_obj f V₁) (W_obj f V₂) :=
    fun {X₁ _} f {_ _} v =>
      ((AlgebraicGeometry.Scheme.Etale.forget X₁).map ((weilEtaleSitePullback f).map v)).left

  have hSiteMap_fst :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
        {V₁ V₂ : X₂.Etale} (v : Quiver.Hom V₁ V₂),
        CategoryTheory.CategoryStruct.comp (map_W f v)
          (CategoryTheory.Limits.pullback.fst ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj V₂).hom f) =
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Limits.pullback.fst ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj V₁).hom f)
          (((AlgebraicGeometry.Scheme.Etale.forget X₂).map v).left) := by
    intro X₁ X₂ f V₁ V₂ v
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hSiteMap_snd :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
        {V₁ V₂ : X₂.Etale} (v : Quiver.Hom V₁ V₂),
        CategoryTheory.CategoryStruct.comp (map_W f v)
          (CategoryTheory.Limits.pullback.snd ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj V₂).hom f) =
        CategoryTheory.Limits.pullback.snd ((AlgebraicGeometry.Scheme.Etale.forget X₂).obj V₁).hom f := by
    intro X₁ X₂ f V₁ V₂ v
    exact CategoryTheory.MorphismProperty.Over.w ((weilEtaleSitePullback f).map v)

  have hmap_W_id :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂) (V : X₂.Etale),
        map_W f (CategoryTheory.CategoryStruct.id V) =
          CategoryTheory.CategoryStruct.id (W_obj f V) := by
    intro X₁ X₂ f V
    apply CategoryTheory.Limits.pullback.hom_ext
    · have hid_l :
          (((AlgebraicGeometry.Scheme.Etale.forget X₂).map
            (CategoryTheory.CategoryStruct.id V)).left) =
          CategoryTheory.CategoryStruct.id _ := rfl
      rw [hSiteMap_fst, hid_l, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    · rw [hSiteMap_snd, CategoryTheory.Category.id_comp]

  have hmap_W_comp :
      ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom X₁ X₂)
        {V₁ V₂ V₃ : X₂.Etale} (u : Quiver.Hom V₁ V₂) (v : Quiver.Hom V₂ V₃),
        map_W f (CategoryTheory.CategoryStruct.comp u v) =
          CategoryTheory.CategoryStruct.comp (map_W f u) (map_W f v) := by
    intro X₁ X₂ f V₁ V₂ V₃ u v
    apply CategoryTheory.Limits.pullback.hom_ext
    · have hcomp_l :
          (((AlgebraicGeometry.Scheme.Etale.forget X₂).map
            (CategoryTheory.CategoryStruct.comp u v)).left) =
          CategoryTheory.CategoryStruct.comp
            (((AlgebraicGeometry.Scheme.Etale.forget X₂).map u).left)
            (((AlgebraicGeometry.Scheme.Etale.forget X₂).map v).left) := rfl
      rw [hSiteMap_fst f (CategoryTheory.CategoryStruct.comp u v), hcomp_l,
        CategoryTheory.Category.assoc (map_W f u), hSiteMap_fst f v,
        ← CategoryTheory.Category.assoc (map_W f u), hSiteMap_fst f u,
        CategoryTheory.Category.assoc]
    · rw [hSiteMap_snd, CategoryTheory.Category.assoc, hSiteMap_snd, hSiteMap_snd]

  let ρ_lift : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
