    letI : IrreducibleSpace ↥Y_η := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_η
    intro α hNe_sp b hb
    haveI : Nonempty ↥(V α : AlgebraicGeometry.Scheme.{u}) := hV_eq α ▸ hNe_sp
    have hle_V : V α ≤ V_sp α := le_of_eq (hV_eq α).symm
