        CategoryTheory.ShortComplex.mk δ₀ ((Φ 1).map SC.f) hcomp₂ :=
      CategoryTheory.ShortComplex.isoMk
        (ε₀.app SC.X₃) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
