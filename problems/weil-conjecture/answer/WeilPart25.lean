  have hFin_ν₂ : AlgebraicGeometry.IsFinite ν₂ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_ν₂_flip.flip P.hFin_rel
  haveI : AlgebraicGeometry.IsFinite ν₂ := hFin_ν₂

  have hW₂_eq_ν₂ : W₂_V₂_open = (TopologicalSpace.Opens.map ν₂.base).obj W₁_V₂_open := by
    ext z
