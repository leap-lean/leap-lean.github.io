          congrArg (fun k => AddCommGrpCat.Hom.hom k s_tilde) hnat.symm
        exact hstep1.trans ((congrArg (α.hom.app (Opposite.op (V'_of U' q a))).hom
          (hs_tilde_res a)).trans (hs₁_spec a))
      change S_im.arrows (q ≫ p₁)
      dsimp [S_im]
      rw [CategoryTheory.Presheaf.imageSieve_apply]
      exact ⟨s_tilde, hs_tilde_map⟩
    refine X.smallEtaleTopology.transitive hp₁_cov S_im ?_
    intro Y f hf
    rcases hf with ⟨W, g, q_s, ⟨⟩, rfl⟩
    rw [CategoryTheory.Sieve.pullback_comp]
    exact X.smallEtaleTopology.pullback_stable g hPull_p₁_mem

  refine ⟨hEpi, ?_⟩
  intro p_ν hp_ν
  have : (weilEtaleSitePullback ν₀).IsContinuous X.smallEtaleTopology Z₀.smallEtaleTopology :=
    hc_all ν₀
  have : ((weilEtaleSitePullback ν₀).sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology Z₀.smallEtaleTopology).IsRightAdjoint := hr_all ν₀
  let B := weilEtaleSitePullback ν₀
  let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology Z₀.smallEtaleTopology
  let pb := B.sheafPullback AddCommGrpCat.{u}
    X.smallEtaleTopology Z₀.smallEtaleTopology
  let adj_ν := B.sheafAdjunctionContinuous AddCommGrpCat.{u}
    X.smallEtaleTopology Z₀.smallEtaleTopology
  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let J₁ := Z₀.smallEtaleTopology
  let J₂ := X.smallEtaleTopology
  let Fℤ_Z := (CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_X := (CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}).obj Aℤ
  let FM₁ := weilEtaleTorsionSheaf Z₀ m
  let FM₂ := weilEtaleTorsionSheaf X m
  let πM₀ := weilEtaleConstPullbackHom ν₀
    (weilEtaleIdTerminalIsTerminal.{u} Z₀) (weilEtaleIdTerminalIsTerminal.{u} X) AM
  let η_M : FM₂ ⟶ pf.obj FM₁ := (adj_ν.homEquiv FM₂ FM₁) πM₀
  dsimp only
  intro w hw_zero
  change w.comp (CategoryTheory.Abelian.Ext.mk₀ η_M) (Nat.add_zero 1) = 0

  rcases hp_ν with ⟨hCont', hAdj', hAdd_pb, hLim_pb, hColim_pb,
    T₁, hT₁, T₂, hT₂, ιℤ, hιπℤ, hπℤι, hp_ν_eq⟩
  cases Subsingleton.elim hCont' (hc_all ν₀)
  cases Subsingleton.elim hAdj' (hr_all ν₀)
  rcases hEpi with ⟨hCont_epi, hMapEpi⟩
  cases Subsingleton.elim hCont_epi (hc_all ν₀)

  have : pb.Additive := hAdd_pb
  have : CategoryTheory.Limits.PreservesFiniteLimits pb := hLim_pb
  have : CategoryTheory.Limits.PreservesFiniteColimits pb := hColim_pb
  have : pf.PreservesZeroMorphisms :=
    CategoryTheory.Functor.preservesZeroMorphisms_of_isRightAdjoint pf

  let P_AM₁ := (CategoryTheory.Functor.const (Opposite Z₀.Etale)).obj AM
  let P_AM₂ := (CategoryTheory.Functor.const (Opposite X.Etale)).obj AM
  let u₁ := (CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}).unit.app P_AM₁
  let η_canon : FM₂ ⟶ pf.obj FM₁ :=
    ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
      P_AM₂ (pf.obj FM₁)).symm (CategoryTheory.Functor.whiskerLeft B.op u₁)

  have hConstMate_eq :
      ∀ {T'₁ : Z₀.Etale} (hT'₁ : CategoryTheory.Limits.IsTerminal T'₁)
        {T'₂ : X.Etale} (hT'₂ : CategoryTheory.Limits.IsTerminal T'₂),
        let adj'₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT'₁
        let adj'₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT'₂
        let τ' : B.obj T'₂ ⟶ T'₁ := hT'₁.from (B.obj T'₂)
        (adj'₂.homEquiv AM (pf.obj FM₁)).symm
          (adj'₁.unit.app AM ≫ FM₁.obj.map τ'.op) = η_canon := by
    intro T'₁ hT'₁ T'₂ hT'₂ adj'₁ adj'₂ τ'
    apply (adj'₂.homEquiv AM (pf.obj FM₁)).injective
    rw [Equiv.apply_symm_apply]
    have hu_T₁ : adj'₁.unit.app AM = u₁.app (Opposite.op T'₁) := by
      dsimp [adj'₁, u₁, P_AM₁, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp]
      ext ⟨b⟩
      simp
    have hu_T₂ : (adj'₂.homEquiv AM (pf.obj FM₁)) η_canon = u₁.app (Opposite.op (B.obj T'₂)) := by
      have h_sh :
          ((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv
            P_AM₂ (pf.obj FM₁)) η_canon = CategoryTheory.Functor.whiskerLeft B.op u₁ :=
        Equiv.apply_symm_apply _ _
      rw [adj'₂.homEquiv_unit]
      have h_sh_unit :
          (CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).unit.app P_AM₂ ≫
            (CategoryTheory.sheafToPresheaf J₂ AddCommGrpCat.{u}).map η_canon =
            CategoryTheory.Functor.whiskerLeft B.op u₁ :=
        (((CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}).homEquiv_unit
          P_AM₂ (pf.obj FM₁) η_canon).symm).trans h_sh
      have happ := congrArg (fun k : P_AM₂ ⟶ (pf.obj FM₁).obj => k.app (Opposite.op T'₂)) h_sh_unit
      dsimp [adj'₂, P_AM₂, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp] at *
      ext ⟨b⟩
      have hb := congrArg (fun φ : AM ⟶ FM₁.obj.obj (Opposite.op (B.obj T'₂)) => φ.hom (ULift.up b)) happ
      exact hb
    rw [hu_T₁, hu_T₂]
    have hnat := u₁.naturality τ'.op
    dsimp [P_AM₁] at hnat
    rw [CategoryTheory.Category.id_comp] at hnat
    exact hnat.symm

  let πM := weilEtaleConstPullbackHom ν₀ hT₁ hT₂ AM
  have hπM_eq : πM = πM₀ := by
    dsimp [πM, πM₀, weilEtaleConstPullbackHom]
    rw [hConstMate_eq hT₁ hT₂,
      hConstMate_eq (weilEtaleIdTerminalIsTerminal.{u} Z₀) (weilEtaleIdTerminalIsTerminal.{u} X)]
  have hη_counit : pb.map η_M ≫ adj_ν.counit.app FM₁ = πM := by
    calc
      pb.map η_M ≫ adj_ν.counit.app FM₁
        = (adj_ν.homEquiv FM₂ FM₁).symm η_M := (adj_ν.homEquiv_counit FM₂ FM₁ η_M).symm
      _ = πM₀ := Equiv.symm_apply_apply _ _
      _ = πM := hπM_eq.symm

  let I := CategoryTheory.Injective.under FM₁
  let ι_I : FM₁ ⟶ I := CategoryTheory.Injective.ι FM₁
  let C_I := CategoryTheory.Limits.cokernel ι_I
  let π_I : I ⟶ C_I := CategoryTheory.Limits.cokernel.π ι_I
  let S_I := CategoryTheory.ShortComplex.mk ι_I π_I (CategoryTheory.Limits.cokernel.condition ι_I)
  have hSE_I : S_I.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' (CategoryTheory.ShortComplex.exact_cokernel ι_I)
      inferInstance inferInstance

  have : CategoryTheory.Injective (pf.obj I) :=
    CategoryTheory.Injective.injective_of_adjoint adj_ν I
  have hMono_pf : CategoryTheory.Mono (pf.map ι_I) := by
    have := CategoryTheory.Functor.preservesMonomorphisms_of_adjunction adj_ν
    infer_instance
  have hEpi_pf : CategoryTheory.Epi (pf.map π_I) := hMapEpi I C_I π_I

  let S_pf := S_I.map pf
  have hLift_pf :
      ∀ {W : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}}
        (k : W ⟶ pf.obj I),
        k ≫ S_pf.g = 0 → ∃ u : W ⟶ pf.obj FM₁, u ≫ pf.map ι_I = k := by
    intro W k hk
    let k_tilde : pb.obj W ⟶ I := (adj_ν.homEquiv W I).symm k
    have hk_tilde_zero : k_tilde ≫ π_I = 0 := by
      apply (adj_ν.homEquiv W C_I).injective
      have h1 : (adj_ν.homEquiv W C_I) (k_tilde ≫ π_I) = k ≫ pf.map π_I := by
        rw [adj_ν.homEquiv_naturality_right]
        dsimp [k_tilde]
        rw [Equiv.apply_symm_apply]
      have h2 : (adj_ν.homEquiv W C_I) 0 = 0 := by
        rw [adj_ν.homEquiv_unit, CategoryTheory.Functor.map_zero,
          CategoryTheory.Limits.comp_zero]
      exact h1.trans (hk.trans h2.symm)
    let fork_Z := CategoryTheory.Limits.KernelFork.ofι k_tilde hk_tilde_zero
    let u_Z : pb.obj W ⟶ FM₁ := hSE_I.fIsKernel.lift fork_Z
    have hu_Z : u_Z ≫ ι_I = k_tilde :=
      hSE_I.fIsKernel.fac fork_Z CategoryTheory.Limits.WalkingParallelPair.zero
    refine ⟨(adj_ν.homEquiv W FM₁) u_Z, ?_⟩
    rw [← adj_ν.homEquiv_naturality_right, hu_Z, Equiv.apply_symm_apply]

  have hKer_pf : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι (pf.map ι_I) S_pf.zero) :=
    CategoryTheory.Limits.KernelFork.IsLimit.ofι _ _
      (fun {W} k hk => Classical.choose (hLift_pf k hk))
      (fun {W} k hk => Classical.choose_spec (hLift_pf k hk))
      (fun {W} k hk m hm =>
        (cancel_mono (pf.map ι_I)).mp (hm.trans (Classical.choose_spec (hLift_pf k hk)).symm))

  have hSE_pf : S_pf.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk'
      (CategoryTheory.ShortComplex.exact_of_f_is_kernel S_pf hKer_pf)
      hMono_pf hEpi_pf

  let w' := w.comp (CategoryTheory.Abelian.Ext.mk₀ η_M) (Nat.add_zero 1)
  have hw'_ι_zero' :
      w'.comp (CategoryTheory.Abelian.Ext.mk₀ (pf.map ι_I)) (Nat.add_zero 1) = 0 :=
    CategoryTheory.Abelian.Ext.eq_zero_of_injective _
  have hw'_ι_zero :
      w'.comp (CategoryTheory.Abelian.Ext.mk₀ S_pf.f) (Nat.add_zero 1) = 0 :=
    hw'_ι_zero'
  obtain ⟨x₀, hx₀⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Fℤ_X hSE_pf w' hw'_ι_zero (Nat.zero_add 1)
  let φ_C : Fℤ_X ⟶ pf.obj C_I := CategoryTheory.Abelian.Ext.addEquiv₀ x₀
  have hφ_C_ext :
      (CategoryTheory.Abelian.Ext.mk₀ φ_C).comp hSE_pf.extClass (Nat.zero_add 1) = w' := by
    have hmk : CategoryTheory.Abelian.Ext.mk₀ φ_C = x₀ :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x₀
    rw [hmk]
    exact hx₀

  let E_pull :=
    ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
      (CategoryTheory.Abelian.Ext.mapExactFunctor pb w') (Nat.zero_add 1)).comp
      (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app FM₁)) (Nat.add_zero 1)

  have hE_pull_zero : E_pull = 0 := by
    dsimp [E_pull, w']
    rw [CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
        (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app FM₁))
        (Nat.zero_add 1) (Nat.add_zero 1) rfl,
      CategoryTheory.Abelian.Ext.comp_assoc _
        (CategoryTheory.Abelian.Ext.mk₀ (pb.map η_M))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app FM₁))
        (Nat.add_zero 1) (Nat.add_zero 0) rfl,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      hη_counit,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
        (CategoryTheory.Abelian.Ext.mk₀ πM) (Nat.zero_add 1) (Nat.add_zero 1) rfl,
      ← CategoryTheory.Functor.mapExtAddHom_apply]
    have hp_val := hp_ν_eq w
    rw [hw_zero] at hp_val
    exact hp_val.symm

  let hSE_pb : (S_pf.map pb).ShortExact := hSE_pf.map_of_exact pb
  let ε_SC : S_pf.map pb ⟶ S_I :=
    CategoryTheory.ShortComplex.homMk
      (adj_ν.counit.app FM₁) (adj_ν.counit.app I) (adj_ν.counit.app C_I)
      (adj_ν.counit.naturality ι_I).symm (adj_ν.counit.naturality π_I).symm
  have hext_nat :
      hSE_pb.extClass.comp (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app FM₁)) (Nat.add_zero 1) =
        (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app C_I)).comp hSE_I.extClass (Nat.zero_add 1) :=
    CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE_pb hSE_I ε_SC

  have hLift_target_zero :
      (CategoryTheory.Abelian.Ext.mk₀
        (ιℤ ≫ pb.map φ_C ≫ adj_ν.counit.app C_I)).comp hSE_I.extClass (Nat.zero_add 1) = 0 := by
    rw [← hE_pull_zero]
    dsimp [E_pull]
    rw [← hφ_C_ext,
      CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
      CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
      CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
      CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
        (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app FM₁))
        (Nat.zero_add 1) (Nat.add_zero 1) rfl,
      CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (pb.map φ_C))
        hSE_pb.extClass (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app FM₁))
        (Nat.zero_add 1) (Nat.add_zero 1) rfl,
      hext_nat,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ (pb.map φ_C))
        (CategoryTheory.Abelian.Ext.mk₀ (adj_ν.counit.app C_I)) hSE_I.extClass
        (Nat.add_zero 0) (Nat.zero_add 1) rfl,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
      ← CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
        hSE_I.extClass (Nat.add_zero 0) (Nat.zero_add 1) rfl,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]

  obtain ⟨y₀, hy₀⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fℤ_Z hSE_I
      (CategoryTheory.Abelian.Ext.mk₀ (ιℤ ≫ pb.map φ_C ≫ adj_ν.counit.app C_I))
      (Nat.zero_add 1) hLift_target_zero
  let ψ_I : Fℤ_Z ⟶ I := CategoryTheory.Abelian.Ext.addEquiv₀ y₀
  have hψ_I_comp : ψ_I ≫ π_I = ιℤ ≫ pb.map φ_C ≫ adj_ν.counit.app C_I := by
    apply (CategoryTheory.Abelian.Ext.mk₀_bijective _ _).1
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
    have hmk : CategoryTheory.Abelian.Ext.mk₀ ψ_I = y₀ :=
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply y₀
    rw [hmk]
    exact hy₀

  let πℤ := weilEtaleConstPullbackHom ν₀ hT₁ hT₂ Aℤ
  have hπℤ_ι : πℤ ≫ ιℤ = 𝟙 (pb.obj Fℤ_X) := hπℤι
  have hπℤ_ψ : (πℤ ≫ ψ_I) ≫ π_I = (adj_ν.homEquiv Fℤ_X C_I).symm φ_C := by
    calc
      (πℤ ≫ ψ_I) ≫ π_I
        = πℤ ≫ (ψ_I ≫ π_I) := CategoryTheory.Category.assoc _ _ _
      _ = πℤ ≫ (ιℤ ≫ pb.map φ_C ≫ adj_ν.counit.app C_I) := by rw [hψ_I_comp]
      _ = (πℤ ≫ ιℤ) ≫ (pb.map φ_C ≫ adj_ν.counit.app C_I) := by
            simp only [CategoryTheory.Category.assoc]
      _ = pb.map φ_C ≫ adj_ν.counit.app C_I := by
            rw [hπℤ_ι, CategoryTheory.Category.id_comp]
      _ = (adj_ν.homEquiv Fℤ_X C_I).symm φ_C := (adj_ν.homEquiv_counit Fℤ_X C_I φ_C).symm

  have hφ_C_fac : φ_C = ((adj_ν.homEquiv Fℤ_X I) (πℤ ≫ ψ_I)) ≫ pf.map π_I := by
    apply (adj_ν.homEquiv Fℤ_X C_I).symm.injective
    rw [← hπℤ_ψ]
    apply (adj_ν.homEquiv Fℤ_X C_I).injective
    rw [Equiv.apply_symm_apply, adj_ν.homEquiv_naturality_right]

  change w' = 0
  rw [← hφ_C_ext, hφ_C_fac,
    ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
    CategoryTheory.Abelian.Ext.comp_assoc
      (CategoryTheory.Abelian.Ext.mk₀ ((adj_ν.homEquiv Fℤ_X I) (πℤ ≫ ψ_I)))
      (CategoryTheory.Abelian.Ext.mk₀ (pf.map π_I))
      hSE_pf.extClass (Nat.add_zero 0) (Nat.zero_add 1) rfl]
  change (CategoryTheory.Abelian.Ext.mk₀ ((adj_ν.homEquiv Fℤ_X I) (πℤ ≫ ψ_I))).comp
    ((CategoryTheory.Abelian.Ext.mk₀ S_pf.g).comp hSE_pf.extClass (Nat.zero_add 1))
    (Nat.zero_add 1) = 0
  rw [hSE_pf.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]

theorem weil_cyclic_locConst_zero_trace_short_exact_and_rigidity (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hSh : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltLocConstPresheaf S ℓ)) :
    let L_of : ∀ S : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      fun S => ⟨weilAltLocConstPresheaf S ℓ, hSh S⟩
    let P_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S),
        CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
      fun {S Z_S} ν_S =>
        (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback ν_S)
          AddCommGrpCat.{u} _ S.smallEtaleTopology Z_S.smallEtaleTopology (hc_all ν_S)).obj
          (L_of Z_S)
    let Δ_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S),
        Quiver.Hom (L_of S) (P_of ν_S) :=
      fun ν_S => { hom := weilAltLocConstPullbackNat ν_S ℓ }
    ∃ (Q_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
          (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S),
          (∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S) →
          (ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
            ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)) →
          CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (τ_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
          (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
          (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
          (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
            ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
          Quiver.Hom (P_of ν_S) (Q_of ν_S ρ_S hρ_over hρ_act))
      (δ_L_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
          (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
          (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
          (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
            ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
          Quiver.Hom (L_of S) (Q_of ν_S ρ_S hρ_over hρ_act))
      (h0_of : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
          (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
          (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
          (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
            ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
          CategoryTheory.CategoryStruct.comp (Δ_of ν_S) (τ_of ν_S ρ_S hρ_over hρ_act) = 0),
      (∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
         [AlgebraicGeometry.Etale ν_S] [AlgebraicGeometry.Surjective ν_S]
         (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
         (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
         (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
           ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
         (let δ_S : ZMod ℓ → Quiver.Hom Z_S (CategoryTheory.Limits.pullback ν_S ν_S) :=
            fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z_S) (ρ_S a)
              ((CategoryTheory.Category.id_comp ν_S).trans (hρ_over a).symm)
          (⋃ a : ZMod ℓ, Set.range (δ_S a).base) = Set.univ) →
         (∀ (U₀ : AlgebraicGeometry.Scheme.{u}) (p_U : Quiver.Hom U₀ S)
            (s : Quiver.Hom U₀ Z_S) (hs : CategoryTheory.CategoryStruct.comp s ν_S = p_U),
            let W := CategoryTheory.Limits.pullback p_U ν_S
