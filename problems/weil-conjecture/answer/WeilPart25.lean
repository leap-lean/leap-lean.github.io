    have hAdd : pb_h.Additive := pb_h.additive_of_preserves_binary_products
    exact ⟨hAdd, hLim, hColim⟩

  
  
  

  
  have hEt_of_hom : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : X.Etale} (v : U₁ ⟶ U₂),
      AlgebraicGeometry.Etale v.left := by
    intro X U₁ U₂ v
    have hvw : v.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale (v.left ≫ U₂.hom) := by
      rw [hvw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      v.left U₂.hom U₂.prop hEt_comp

  
  have hSieveMem : ∀ {X : AlgebraicGeometry.Scheme.{u}} {U : X.Etale} {I : Type u}
      (V_fam : I → X.Etale) (u_fam : ∀ i : I, V_fam i ⟶ U),
      (∀ z : ↥U.left, ∃ (i : I) (y : ↥(V_fam i).left), (u_fam i).left.base y = z) →
      CategoryTheory.Sieve.ofArrows V_fam u_fam ∈ X.smallEtaleTopology U := by
    intro X U I V_fam u_fam h_cov
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.Etale)).toIsStableUnderComposition
    let R_cov : CategoryTheory.Sieve U := CategoryTheory.Sieve.ofArrows V_fam u_fam
    change R_cov ∈
      AlgebraicGeometry.Scheme.smallGrothendieckTopology (P := @AlgebraicGeometry.Etale) (S := X) U
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) X le_rfl]
    refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := X) U R_cov).mpr
      fun z => ?_
    obtain ⟨i, y, hy⟩ := h_cov z
    exact ⟨V_fam i, u_fam i, y, CategoryTheory.Sieve.ofArrows_mk V_fam u_fam i,
      hEt_of_hom (u_fam i), hy⟩

  
  let Z_obj : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let elemHom : ∀ (M : AddCommGrpCat.{u}), ↥M → (Z_obj ⟶ M) := fun M m =>
    AddCommGrpCat.ofHom ((zmultiplesHom ↥M m).comp AddEquiv.ulift.toAddMonoidHom)
  have elemHom_one : ∀ (M : AddCommGrpCat.{u}) (m : ↥M), elemHom M m (ULift.up 1) = m := by
    intro M m
    change (1 : ℤ) • m = m
    exact one_zsmul m
  have elemHom_comp : ∀ {M N : AddCommGrpCat.{u}} (m : ↥M) (α : M ⟶ N),
      elemHom M m ≫ α = elemHom N (α m) := by
    intro M N m α
    ext ⟨n⟩
    change α (n • m) = n • α m
    exact map_zsmul (ConcreteCategory.hom α) n m
  have elemHom_zero : ∀ (M : AddCommGrpCat.{u}), elemHom M 0 = 0 := by
    intro M
    ext ⟨n⟩
