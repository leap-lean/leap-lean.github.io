      ext c
      simp only [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply k B₀' B_mid c,
        ← IsScalarTower.algebraMap_apply k B_mid B₁ c]
    dsimp [g₁, g_mid]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hg₀'_uC,
      ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← AlgebraicGeometry.Spec.map_comp,
      ← CommRingCat.ofHom_comp, halg_comp]

  have h1d : ∀ x : Ω, ∃ P : Polynomial B₁, P ≠ 0 ∧ Polynomial.eval₂ ι_B₁_Ω x P = 0 := by
    intro x
    obtain ⟨P₀, hP₀_ne, hP₀_ev⟩ := hAlg_Ω₀' x
    let φ₀₁ : B₀' →+* B₁ := (algebraMap B_mid B₁).comp (algebraMap B₀' B_mid)
    have hφ₀₁_inj : Function.Injective φ₀₁ := hBmid_B₁_inj.comp hB₀'_Bmid_inj
    refine ⟨P₀.map φ₀₁, ?_, ?_⟩
    · intro h0
      exact hP₀_ne (Polynomial.map_injective φ₀₁ hφ₀₁_inj (h0.trans (Polynomial.map_zero φ₀₁).symm))
    · rw [Polynomial.eval₂_map]
      have hcomp_eq : ι_B₁_Ω.comp φ₀₁ = ι_L₁_Ω.comp (algebraMap B₀' L₁) := by
        dsimp [φ₀₁]
        rw [← RingHom.comp_assoc, hι_B₁_B₀']
      rw [hcomp_eq]
      exact hP₀_ev

  let Y_B₁ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback f_C g₁
  let p_B₁ : Y_B₁ ⟶ Y_C := CategoryTheory.Limits.pullback.fst f_C g₁
  let f_B₁ : Y_B₁ ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
    CategoryTheory.Limits.pullback.snd f_C g₁
  have hPb_B₁ : CategoryTheory.IsPullback p_B₁ f_B₁ f_C g₁ :=
    CategoryTheory.IsPullback.of_hasPullback f_C g₁

  let q₁ : Y_B₁ ⟶ Y_mid :=
    CategoryTheory.Limits.pullback.lift p_B₁
      (f_B₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁)))
      (by
        dsimp [g₁] at hPb_B₁
        rw [CategoryTheory.Category.assoc, hPb_B₁.w])
  have hq₁_p : q₁ ≫ p_mid = p_B₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hq₁_f : q₁ ≫ f_mid =
      f_B₁ ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁)) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_q₁ : CategoryTheory.IsPullback q₁ f_B₁ f_mid
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁))) := by
    refine CategoryTheory.IsPullback.of_right ?_ hq₁_f hPb_mid
    rw [hq₁_p]
    exact hPb_B₁

  have hPb_η_C : CategoryTheory.IsPullback (ι_η ≫ p_dom) f_η f_C
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω) ≫ g₁) := by
    rw [h1b]
    exact hPb_η.paste_horiz hPb_dom

  let ι_η_B₁ : Y_η ⟶ Y_B₁ :=
    CategoryTheory.Limits.pullback.lift (ι_η ≫ p_dom)
      (f_η ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω))
      (by rw [hPb_η_C.w, CategoryTheory.Category.assoc])
  have hι_η_B₁_p : ι_η_B₁ ≫ p_B₁ = ι_η ≫ p_dom :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hι_η_B₁_f : ι_η_B₁ ≫ f_B₁ =
      f_η ≫ AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω) :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hPb_η_B₁ : CategoryTheory.IsPullback ι_η_B₁ f_η f_B₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω)) := by
    refine CategoryTheory.IsPullback.of_right ?_ hι_η_B₁_f hPb_B₁
    rw [hι_η_B₁_p]
    exact hPb_η_C

  have hq_η_sec : ∀ a : Fin m_sec,
      q_η a ≫ f_η =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
    fun a => (hPts₀' a).2.1
  have hq_η_range : ∀ a : Fin m_sec, Set.range (q_η a).base = {(x_η a).1} :=
    fun a => (hPts₀' a).2.2.1
  have hq_η_q₁ : ∀ a : Fin m_sec,
      (q_η a ≫ ι_η_B₁) ≫ q₁ =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_mid_Ω) ≫ σ_mid a := by
    intro a
    apply hPb_mid.hom_ext
    · rw [CategoryTheory.Category.assoc, hq₁_p, CategoryTheory.Category.assoc, hι_η_B₁_p,
        ← CategoryTheory.Category.assoc, (hPts₀' a).2.2.2,
        CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_mid_Ω)),
        hσ_mid_p a]
      have hι_mid_hom : CommRingCat.ofHom ι_mid_Ω =
          CommRingCat.ofHom ι_t₀_L₁ ≫ CommRingCat.ofHom ι_L₁_Ω :=
        CommRingCat.ofHom_comp ι_t₀_L₁ ι_L₁_Ω
      rw [hι_mid_hom, AlgebraicGeometry.Spec.map_comp,
        CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_L₁_Ω))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_t₀_L₁)),
        ← CategoryTheory.Category.assoc
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_t₀_L₁)) (σ_t₀ a) p₀',
        hσ_t₀_L₁ a, hq_L₁_p₀' a, CategoryTheory.Category.assoc]
    · rw [CategoryTheory.Category.assoc, hq₁_f, CategoryTheory.Category.assoc (q_η a),
        ← CategoryTheory.Category.assoc ι_η_B₁, hι_η_B₁_f,
        CategoryTheory.Category.assoc f_η, ← CategoryTheory.Category.assoc (q_η a),
        hq_η_sec a, CategoryTheory.Category.id_comp,
        ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hι_B₁_comp_mid,
        CategoryTheory.Category.assoc, hσ_mid a, CategoryTheory.Category.comp_id]

  obtain ⟨N_cov, hN_cov, W₁, h_sec, r_sec, hGrp3, hGrp4, hGrp5⟩ :=
    hCoverBuild ι_B₁_Ω hι_B₁_comp_mid Y_B₁ q₁ f_B₁ hPb_q₁
      Y_η ι_η_B₁ f_η hPb_η_B₁ x_η q_η hq_η_sec hq_η_range hq_η_q₁

  exact ⟨B₁, inferInstance, instDom₁, inferInstance, instFT₁, hDed₁, hNotField₁,
    g₁, τ_B₁, ι_B₁_Ω, hι_B₁_Ω_inj, Y_B₁, p_B₁, f_B₁, ι_η_B₁,
    N_cov, hN_cov, W₁, h_sec, r_sec,
    ⟨h1a, h1b, h1c, h1d⟩, ⟨hPb_B₁, hι_η_B₁_p, hPb_η_B₁⟩, hGrp3, hGrp4, hGrp5⟩

theorem weil_rel_curve_dvr_prime_cancellation_and_kummer_unit_spread (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (B₁ : Type u) [CommRing B₁] [IsDomain B₁] [Algebra k B₁] [Algebra.FiniteType k B₁]
    (hDed₁ : IsDedekindDomain B₁)
    (hNotField₁ : ¬ IsField B₁)
    (τ_B₁ : B₁ →ₐ[k] k)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ι_B₁_Ω : B₁ →+* Ω)
    (hInj_B₁_Ω : Function.Injective ι_B₁_Ω)
    (hAlg_Ω : ∀ x : Ω, ∃ P : Polynomial B₁, P ≠ 0 ∧ Polynomial.eval₂ ι_B₁_Ω x P = 0)
    (Y_B₁ : AlgebraicGeometry.Scheme.{u})
    (f_B₁ : Quiver.Hom Y_B₁ (AlgebraicGeometry.Spec (CommRingCat.of B₁)))
    [AlgebraicGeometry.IsProper f_B₁]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_B₁]
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt_C₀ : AlgebraicGeometry.IsIntegral C₀.left)
    (ι₀_B₁ : Quiver.Hom C₀.left Y_B₁)
    (hPb_c₀_B₁ : CategoryTheory.IsPullback ι₀_B₁ C₀.hom f_B₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₁.toRingHom)))
    (Y_η : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral Y_η]
    (ι_η_B₁ : Quiver.Hom Y_η Y_B₁)
    (f_η : Quiver.Hom Y_η (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hPb_η_B₁ : CategoryTheory.IsPullback ι_η_B₁ f_η f_B₁
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω)))
    (N_cov : ℕ) (hN_cov : 1 ≤ N_cov)
    (W₁ : Fin N_cov → Y_B₁.Opens)
    (hW₁_top : (⨆ α : Fin N_cov, W₁ α) = ⊤)
    (hW₁_aff : ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (W₁ α))
    (g₁ : ∀ α β : Fin N_cov, Units ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α ⊓ W₁ β))))
    (hg₁_diag : ∀ α : Fin N_cov, (g₁ α α).1 = 1)
    (hg₁_cocycle : ∀ α β γ : Fin N_cov,
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β)).op).hom (g₁ α β).1 *
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.2, hx.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ)).op).hom (g₁ β γ).1 =
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ)).op).hom (g₁ α γ).1)
    (u_Ω : ∀ α : Fin N_cov,
      Units ↑(Y_η.presheaf.obj
        (Opposite.op ((TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α)))))
    (hu_Ω_trans :
      let V : Fin N_cov → Y_η.Opens :=
        fun α => (TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α)
      let g_Ω : ∀ α β : Fin N_cov, Units ↑(Y_η.presheaf.obj (Opposite.op (V α ⊓ V β))) :=
        fun α β => Units.map (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom.toMonoidHom (g₁ α β)
      ∀ α β : Fin N_cov,
        ((g_Ω α β).1 ^ ℓ) *
          (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u_Ω β).1 =
        (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u_Ω α).1) :
    ∃ (B_sp : Type u)
      (_ : CommRing B_sp)
      (_ : IsDomain B_sp)
      (_ : Algebra k B_sp)
      (_ : Algebra.FiniteType k B_sp)
      (_ : IsDedekindDomain B_sp)
      (ψ_sp : B₁ →ₐ[k] B_sp)
      (τ_sp : B_sp →ₐ[k] k)
      (ι_sp_Ω : B_sp →+* Ω)
      (_ : Function.Injective ι_sp_Ω)
      (Y_sp : AlgebraicGeometry.Scheme.{u})
      (q_Y_sp : Quiver.Hom Y_sp Y_B₁)
      (f_sp : Quiver.Hom Y_sp (AlgebraicGeometry.Spec (CommRingCat.of B_sp)))
      (ι_η_sp : Quiver.Hom Y_η Y_sp)
      (u_sp : ∀ α : Fin N_cov,
        Units ↑(Y_sp.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α)))))
      (c_scale : Units Ω),
          (τ_sp.comp ψ_sp = τ_B₁ ∧ ι_sp_Ω.comp ψ_sp.toRingHom = ι_B₁_Ω) ∧
          (CategoryTheory.IsPullback q_Y_sp f_sp f_B₁
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sp.toRingHom)) ∧
            CategoryTheory.CategoryStruct.comp ι_η_sp q_Y_sp = ι_η_B₁ ∧
            CategoryTheory.IsPullback ι_η_sp f_η f_sp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_sp_Ω))) ∧
          (let W_sp : Fin N_cov → Y_sp.Opens :=
            fun α => (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α)
           let g_sp : ∀ α β : Fin N_cov,
              Units ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α ⊓ W_sp β))) :=
            fun α β => Units.map (q_Y_sp.app (W₁ α ⊓ W₁ β)).hom.toMonoidHom (g₁ α β)
           ∀ α β : Fin N_cov,
             ((g_sp α β).1 ^ ℓ) *
               (Y_sp.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u_sp β).1 =
             (Y_sp.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u_sp α).1) ∧
          (let W_sp : Fin N_cov → Y_sp.Opens :=
            fun α => (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α)
           let V : Fin N_cov → Y_η.Opens :=
            fun α => (TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α)
           ∀ (α : Fin N_cov)
             (h_le : V α ≤ (TopologicalSpace.Opens.map ι_η_sp.base).obj (W_sp α)),
             (Y_η.presheaf.map (CategoryTheory.homOfLE h_le).op).hom
               ((ι_η_sp.app (W_sp α)).hom (u_sp α).1) =
             (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
                 f_η.appLE ⊤ (V α) (fun _ _ => trivial)).hom c_scale.1) *
               (u_Ω α).1) :=
by
  classical
  have probe_s2 : ∀ (B B' : Type u) [CommRing B] [CommRing B'] [Algebra B B']
      (Y Y' : AlgebraicGeometry.Scheme.{u})
      (f : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of B)))
      (f' : Quiver.Hom Y' (AlgebraicGeometry.Spec (CommRingCat.of B')))
      (q : Quiver.Hom Y' Y)
      (hPb : CategoryTheory.IsPullback q f' f
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B B'))))
      (U : Y.Opens) (hU : AlgebraicGeometry.IsAffineOpen U),
      let U' : Y'.Opens := (TopologicalSpace.Opens.map q.base).obj U
      letI : Algebra B ↑(Y.presheaf.obj (Opposite.op U)) :=
        (CategoryTheory.CategoryStruct.comp
          (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv
          (f.appLE ⊤ U (fun _ _ => trivial))).hom.toAlgebra
      AlgebraicGeometry.IsAffineOpen U' ∧
      ∃ (e : TensorProduct B ↑(Y.presheaf.obj (Opposite.op U)) B' ≃+*
          ↑(Y'.presheaf.obj (Opposite.op U'))),
        ∀ (a : ↑(Y.presheaf.obj (Opposite.op U))) (b' : B'),
          e (TensorProduct.tmul B a b') =
            (q.app U).hom a *
              (CategoryTheory.CategoryStruct.comp
                (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B')).inv
                (f'.appLE ⊤ U' (fun _ _ => trivial))).hom b' := by
    clear! k ℓ B₁ Ω Y_B₁ C₀ Y_η N_cov
    intro B B' _ _ _ Y Y' f f' q hPb U hU U'
    let φ_B : CommRingCat.of B ⟶ Y.presheaf.obj (Opposite.op U) :=
      (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ f.appLE ⊤ U (fun _ _ => trivial)
    letI : Algebra B ↑(Y.presheaf.obj (Opposite.op U)) := φ_B.hom.toAlgebra
    have hAff_map : IsAffineHom (Spec.map (CommRingCat.ofHom (algebraMap B B'))) :=
      isAffineHom_of_isAffine _
    have hAff_q : IsAffineHom q :=
      MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb.flip hAff_map
    have hU' : IsAffineOpen U' := (isAffineHom_iff q).mp hAff_q U hU
    refine ⟨hU', ?_⟩
    let A_U := Y.presheaf.obj (Opposite.op U)
    let A_U' := Y'.presheaf.obj (Opposite.op U')
    let φ_B' : CommRingCat.of B' ⟶ A_U' :=
      (Scheme.ΓSpecIso (CommRingCat.of B')).inv ≫ f'.appLE ⊤ U' (fun _ _ => trivial)
    have hPb_res : IsPullback (q ∣_ U) U'.ι U.ι q :=
      isPullback_morphismRestrict q U
    have hq_fromSpec : Spec.map (q.app U) ≫ hU.fromSpec = hU'.fromSpec ≫ q := by
      rw [Scheme.Hom.app_eq_appLE]
      exact hU.SpecMap_appLE_fromSpec q hU' le_rfl
    have hf_fromSpec : hU.fromSpec ≫ f = Spec.map (CommRingCat.ofHom (algebraMap B ↑A_U)) := by
      have h1 := (isAffineOpen_top (Spec (CommRingCat.of B))).SpecMap_appLE_fromSpec
        f hU (fun _ _ => trivial)
      rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at h1
      exact h1.symm
    have hf'_fromSpec : hU'.fromSpec ≫ f' = Spec.map φ_B' := by
      have h1 := (isAffineOpen_top (Spec (CommRingCat.of B'))).SpecMap_appLE_fromSpec
        f' hU' (fun _ _ => trivial)
      rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp] at h1
      exact h1.symm
    have hq_res_eq : Spec.map (q.app U) ≫ hU.isoSpec.inv = hU'.isoSpec.inv ≫ (q ∣_ U) := by
      rw [← cancel_mono U.ι]
      calc
        (Spec.map (q.app U) ≫ hU.isoSpec.inv) ≫ U.ι
          = Spec.map (q.app U) ≫ hU.fromSpec := by
              rw [Category.assoc]; rfl
        _ = hU'.fromSpec ≫ q := hq_fromSpec
        _ = hU'.isoSpec.inv ≫ (U'.ι ≫ q) := by
              change (hU'.isoSpec.inv ≫ U'.ι) ≫ q = _
              rw [Category.assoc]
        _ = hU'.isoSpec.inv ≫ ((q ∣_ U) ≫ U.ι) := by rw [hPb_res.w]
        _ = (hU'.isoSpec.inv ≫ (q ∣_ U)) ≫ U.ι := by rw [Category.assoc]
    have hPb_spec_q : IsPullback (Spec.map (q.app U)) hU'.fromSpec hU.fromSpec q := by
      refine IsPullback.of_isLimit (Limits.PullbackCone.IsLimit.mk hq_fromSpec
        (fun s => hPb_res.lift (s.fst ≫ hU.isoSpec.inv) s.snd (by
          calc
            (s.fst ≫ hU.isoSpec.inv) ≫ U.ι
              = s.fst ≫ hU.fromSpec := by rw [Category.assoc]; rfl
            _ = s.snd ≫ q := s.condition) ≫ hU'.isoSpec.hom)
        (fun s => by
          have h_eq : hU'.isoSpec.hom ≫ Spec.map (q.app U) = (q ∣_ U) ≫ hU.isoSpec.hom := by
            rw [← cancel_epi hU'.isoSpec.inv, ← Category.assoc, Iso.inv_hom_id, Category.id_comp,
              ← Category.assoc, ← hq_res_eq, Category.assoc, Iso.inv_hom_id, Category.comp_id]
          rw [Category.assoc, h_eq, ← Category.assoc, hPb_res.lift_fst, Category.assoc,
            Iso.inv_hom_id, Category.comp_id])
        (fun s => by
          change (hPb_res.lift _ _ _ ≫ hU'.isoSpec.hom) ≫ (hU'.isoSpec.inv ≫ U'.ι) = s.snd
          rw [Category.assoc, ← Category.assoc hU'.isoSpec.hom, Iso.hom_inv_id, Category.id_comp,
            hPb_res.lift_snd])
        (fun s m hm₁ hm₂ => by
          rw [← cancel_mono hU'.isoSpec.inv, Category.assoc, Iso.hom_inv_id, Category.comp_id]
          apply hPb_res.hom_ext
          · rw [hPb_res.lift_fst, Category.assoc, ← hq_res_eq, ← Category.assoc, hm₁]
          · rw [hPb_res.lift_snd, Category.assoc]
            exact hm₂))
    have hPb_aff : IsPullback (Spec.map (q.app U)) (Spec.map φ_B')
        (Spec.map (CommRingCat.ofHom (algebraMap B ↑A_U)))
        (Spec.map (CommRingCat.ofHom (algebraMap B B'))) := by
      have h_paste := hPb_spec_q.paste_vert hPb
      rwa [hf_fromSpec, hf'_fromSpec] at h_paste
    let T_ring := TensorProduct B ↑A_U B'
    let iso_S : Spec A_U' ≅ Spec (CommRingCat.of T_ring) :=
      hPb_aff.isoPullback ≪≫ pullbackSpecIso B ↑A_U B'
    have hiso_fst : iso_S.inv ≫ Spec.map (q.app U) =
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) := by
      dsimp [iso_S]
      rw [Category.assoc, IsPullback.isoPullback_inv_fst, pullbackSpecIso_inv_fst]
    have hiso_snd : iso_S.inv ≫ Spec.map φ_B' =
        Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) := by
      dsimp [iso_S]
      rw [Category.assoc, IsPullback.isoPullback_inv_snd, pullbackSpecIso_inv_snd]
    let fwd : CommRingCat.of T_ring ⟶ A_U' := Spec.preimage iso_S.hom
    let bwd : A_U' ⟶ CommRingCat.of T_ring := Spec.preimage iso_S.inv
    have h_fb : fwd ≫ bwd = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Iso.inv_hom_id, Spec.map_id]
    have h_bf : bwd ≫ fwd = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage, Iso.hom_inv_id, Spec.map_id]
    have h_left : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫ fwd = q.app U := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, ← hiso_fst, ← Category.assoc, Iso.hom_inv_id,
        Category.id_comp]
    have h_right : CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom ≫ fwd = φ_B' := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, ← hiso_snd, ← Category.assoc, Iso.hom_inv_id,
        Category.id_comp]
    let e : T_ring ≃+* ↑A_U' :=
      { fwd.hom with
        invFun := bwd.hom
        left_inv := fun x => ConcreteCategory.congr_hom h_fb x
        right_inv := fun x => ConcreteCategory.congr_hom h_bf x }
    refine ⟨e, fun a b' => ?_⟩
    have h_tmul : (TensorProduct.tmul B a b' : T_ring) =
        Algebra.TensorProduct.includeLeftRingHom a *
          Algebra.TensorProduct.includeRight.toRingHom b' := by
      simp [Algebra.TensorProduct.includeLeftRingHom, Algebra.TensorProduct.tmul_mul_tmul]
    change fwd.hom (TensorProduct.tmul B a b') = (q.app U).hom a * φ_B'.hom b'
    rw [h_tmul, map_mul]
    congr 1
    · exact ConcreteCategory.congr_hom h_left a
    · exact ConcreteCategory.congr_hom h_right b'

  have probe_s3 : ∀ (k : Type u) [Field k] [IsAlgClosed k]
      (hIntClFin : ∀ (A : Type u) [CommRing A] [IsDomain A] [Algebra k A] [Algebra.FiniteType k A]
        (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K],
        Module.Finite A ↥(integralClosure A K) ∧ IsIntegrallyClosed ↥(integralClosure A K))
      (B₁ : Type u) [CommRing B₁] [IsDomain B₁] [Algebra k B₁] [Algebra.FiniteType k B₁]
      (hDed₁ : IsDedekindDomain B₁)
      (hNotField₁ : ¬ IsField B₁)
      (τ_B₁ : B₁ →ₐ[k] k)
      (Ω : Type u) [Field Ω]
      (ι_B₁_Ω : B₁ →+* Ω)
      (hInj_B₁_Ω : Function.Injective ι_B₁_Ω)
      (hAlg_Ω : ∀ x : Ω, ∃ P : Polynomial B₁, P ≠ 0 ∧ Polynomial.eval₂ ι_B₁_Ω x P = 0)
      (n_gen : ℕ) (ω_gen : Fin n_gen → Ω),
      ∃ (B₂ : Type u) (_ : CommRing B₂) (_ : IsDomain B₂) (_ : Algebra k B₂)
        (_ : Algebra.FiniteType k B₂) (_ : IsDedekindDomain B₂) (_ : ¬ IsField B₂)
        (ψ₁₂ : B₁ →ₐ[k] B₂) (τ₂ : B₂ →ₐ[k] k)
        (m₂ : Ideal B₂) (_ : m₂.IsMaximal)
        (π₂ : Localization.AtPrime m₂)
        (L₂ : Type u) (_ : Field L₂)
        (ι_B₂_L₂ : B₂ →+* L₂)
        (ι_R₂_L₂ : Localization.AtPrime m₂ →+* L₂)
        (ι_L₂_Ω : L₂ →+* Ω),
        (Function.Injective ψ₁₂ ∧ τ₂.comp ψ₁₂ = τ_B₁ ∧ m₂ = RingHom.ker τ₂.toRingHom ∧ m₂ ≠ ⊥) ∧
        (IsDiscreteValuationRing (Localization.AtPrime m₂) ∧
          IsLocalRing.maximalIdeal (Localization.AtPrime m₂) = Ideal.span {π₂} ∧ π₂ ≠ 0) ∧
        (Function.Injective ι_B₂_L₂ ∧
          ι_R₂_L₂.comp (algebraMap B₂ (Localization.AtPrime m₂)) = ι_B₂_L₂ ∧
          Function.Injective ι_R₂_L₂ ∧
          (ι_L₂_Ω.comp ι_B₂_L₂).comp ψ₁₂.toRingHom = ι_B₁_Ω) ∧
        (∀ i : Fin n_gen, ∃ y : L₂, ι_L₂_Ω y = ω_gen i) ∧
        (∀ y : L₂, ∃ (r : Localization.AtPrime m₂) (n : ℕ),
          y * (ι_R₂_L₂ π₂) ^ n = ι_R₂_L₂ r) := by
    clear! k ℓ B₁ Ω Y_B₁ C₀ Y_η N_cov
    intro k _ _ hIntClFin B₁ _ _ _ _ hDed₁ hNotField₁ τ_B₁ Ω _ ι_B₁_Ω hInj_B₁_Ω hAlg_Ω n_gen ω_gen
    let K₁ : Type u := FractionRing B₁
    have hUnits_B₁_Ω : ∀ s : nonZeroDivisors B₁, IsUnit (ι_B₁_Ω s.1) := by
      intro s
      have hs0 : (s : B₁) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp s.2
      exact Ne.isUnit (fun h => hs0 (hInj_B₁_Ω (h.trans (map_zero ι_B₁_Ω).symm)))
    let ι_K₁_Ω : K₁ →+* Ω := IsLocalization.lift (M := nonZeroDivisors B₁) hUnits_B₁_Ω
    have hK₁_Ω_comp : ι_K₁_Ω.comp (algebraMap B₁ K₁) = ι_B₁_Ω :=
      IsLocalization.lift_comp hUnits_B₁_Ω
    letI : Algebra K₁ Ω := ι_K₁_Ω.toAlgebra
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    haveI : IsScalarTower B₁ K₁ Ω := IsScalarTower.of_algebraMap_eq' hK₁_Ω_comp.symm

    let S_set : Set Ω := Set.range ω_gen
    haveI : Finite ↥S_set := Set.finite_range ω_gen
    have hS_int : ∀ x ∈ S_set, _root_.IsIntegral K₁ x := by
      intro x _
      obtain ⟨P, hP_ne, hP_ev⟩ := hAlg_Ω x
      have hInj_K₁ : Function.Injective (algebraMap B₁ K₁) := IsFractionRing.injective B₁ K₁
      have hPK_ne : P.map (algebraMap B₁ K₁) ≠ 0 :=
        (Polynomial.map_eq_zero_iff hInj_K₁).not.mpr hP_ne
      have hPK_ev : Polynomial.aeval x (P.map (algebraMap B₁ K₁)) = 0 := by
        rw [Polynomial.aeval_def, Polynomial.eval₂_map]
        change Polynomial.eval₂ (ι_K₁_Ω.comp (algebraMap B₁ K₁)) x P = 0
        rwa [hK₁_Ω_comp]
      exact isAlgebraic_iff_isIntegral.mp ⟨P.map (algebraMap B₁ K₁), hPK_ne, hPK_ev⟩

    let L₂_sub : IntermediateField K₁ Ω := IntermediateField.adjoin K₁ S_set
    let L₂ : Type u := ↥L₂_sub
    haveI : FiniteDimensional K₁ L₂ := IntermediateField.finiteDimensional_adjoin hS_int
    haveI : Algebra.IsIntegral K₁ L₂ := Algebra.IsIntegral.of_finite K₁ L₂
    let ι_L₂_Ω : L₂ →+* Ω := L₂_sub.val.toRingHom
    letI : Algebra B₁ L₂ := ((algebraMap K₁ L₂).comp (algebraMap B₁ K₁)).toAlgebra
    haveI : IsScalarTower B₁ K₁ L₂ := IsScalarTower.of_algebraMap_eq' rfl
    have hInj_B₁_L₂ : Function.Injective (algebraMap B₁ L₂) :=
      (algebraMap K₁ L₂).injective.comp (IsFractionRing.injective B₁ K₁)

    let b_L := Module.Basis.ofVectorSpace K₁ L₂
    let ι_b := ↥(Module.Basis.ofVectorSpaceIndex K₁ L₂)
    have hm_ex : ∀ j : ι_b, ∃ m : nonZeroDivisors B₁, _root_.IsIntegral B₁ ((m : B₁) • b_L j) :=
      fun j => _root_.IsIntegral.exists_multiple_integral_of_isLocalization
        (nonZeroDivisors B₁) (b_L j) (Algebra.IsIntegral.isIntegral (R := K₁) (b_L j))
    let m_b : ι_b → nonZeroDivisors B₁ := fun j => Classical.choose (hm_ex j)
    have hm_int : ∀ j : ι_b, _root_.IsIntegral B₁ ((m_b j : B₁) • b_L j) :=
      fun j => Classical.choose_spec (hm_ex j)

    let gen_set : Set L₂ := Set.range (fun j : ι_b => (m_b j : B₁) • b_L j)
    let A_sub_alg : Subalgebra B₁ L₂ := Algebra.adjoin B₁ gen_set
    letI : Algebra k ↥A_sub_alg := ((algebraMap B₁ ↥A_sub_alg).comp (algebraMap k B₁)).toAlgebra
    haveI : IsScalarTower k B₁ ↥A_sub_alg :=
      IsScalarTower.of_algebraMap_eq' (R := k) (S := B₁) (A := ↥A_sub_alg) rfl
    have hFT_B₁_Asub : Algebra.FiniteType B₁ ↥A_sub_alg :=
      Algebra.FiniteType.adjoin_of_finite (Set.finite_range _)
    haveI : Algebra.FiniteType B₁ ↥A_sub_alg := hFT_B₁_Asub
    haveI : Algebra.FiniteType k ↥A_sub_alg :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k B₁) hFT_B₁_Asub
    have hA_int_elem : ∀ x : ↥A_sub_alg, _root_.IsIntegral B₁ x := by
      rintro ⟨x, hx⟩
      have hx' : _root_.IsIntegral B₁ x := by
        refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
        · rintro _ ⟨j, rfl⟩
          exact hm_int j
        · intro r
          exact _root_.isIntegral_algebraMap
        · intro x y _ _ hx_i hy_i
          exact hx_i.add hy_i
        · intro x y _ _ hx_i hy_i
          exact hx_i.mul hy_i
      exact (_root_.isIntegral_algHom_iff A_sub_alg.val Subtype.val_injective).mp hx'
    haveI : Algebra.IsIntegral B₁ ↥A_sub_alg := ⟨hA_int_elem⟩
    haveI : Module.Finite B₁ ↥A_sub_alg := Algebra.IsIntegral.finite

    have hInj_B₁_Asub : Function.Injective (algebraMap B₁ ↥A_sub_alg) := by
      intro x y hxy
      exact hInj_B₁_L₂ (congrArg Subtype.val hxy)
    haveI : IsFractionRing ↥A_sub_alg L₂ :=
      { map_units := fun y => by
          have hy0 : (y : ↥A_sub_alg) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
          exact Ne.isUnit (fun h => hy0 (Subtype.ext h))
        surj := fun z => by
          let repr_z := b_L.repr z
          have h_den : ∀ j : ι_b, ∃ (r : B₁) (d : nonZeroDivisors B₁),
              repr_z j * algebraMap B₁ K₁ d.1 = algebraMap B₁ K₁ r :=
            fun j => by
              obtain ⟨⟨r, d⟩, hrd⟩ := IsLocalization.surj (nonZeroDivisors B₁) (repr_z j)
              exact ⟨r, d, hrd⟩
          let r_fn : ι_b → B₁ := fun j => Classical.choose (h_den j)
          let d_fn : ι_b → nonZeroDivisors B₁ :=
            fun j => Classical.choose (Classical.choose_spec (h_den j))
          have hrd_fn : ∀ j : ι_b,
              repr_z j * algebraMap B₁ K₁ (d_fn j).1 = algebraMap B₁ K₁ (r_fn j) :=
            fun j => Classical.choose_spec (Classical.choose_spec (h_den j))
          let D_B₁ : nonZeroDivisors B₁ := Finset.univ.prod (fun j : ι_b => d_fn j * m_b j)
          have hDB₁_ne : (D_B₁ : B₁) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp D_B₁.2
          let D_A : nonZeroDivisors ↥A_sub_alg := ⟨algebraMap B₁ ↥A_sub_alg D_B₁.1,
            mem_nonZeroDivisors_of_ne_zero (fun h =>
              hDB₁_ne (hInj_B₁_Asub (h.trans (map_zero _).symm)))⟩
          have hz_mem : z * (D_A.1 : L₂) ∈ A_sub_alg := by
            have hz_sum : z = Finset.univ.sum (fun j : ι_b => (repr_z j) • b_L j) :=
              (b_L.sum_repr z).symm
            rw [hz_sum, Finset.sum_mul]
            refine Subalgebra.sum_mem A_sub_alg (fun j _ => ?_)
            have hD_split : (D_B₁ : B₁) =
                ((d_fn j : B₁) * (m_b j : B₁)) *
                  Finset.prod (Finset.univ.erase j) (fun i => (d_fn i : B₁) * (m_b i : B₁)) := by
              change (Finset.univ.prod fun i : ι_b => (d_fn i * m_b i : nonZeroDivisors B₁)).1 = _
              rw [Submonoid.coe_finset_prod]
              exact (Finset.mul_prod_erase Finset.univ
                (fun i : ι_b => (d_fn i : B₁) * (m_b i : B₁)) (Finset.mem_univ j)).symm
            let rest_j : B₁ :=
              Finset.prod (Finset.univ.erase j) (fun i => (d_fn i : B₁) * (m_b i : B₁))
            have h_term : ((repr_z j) • b_L j) * (D_A.1 : L₂) =
                algebraMap B₁ L₂ (r_fn j * rest_j) * ((m_b j : B₁) • b_L j) := by
              have hDA_val : (D_A.1 : L₂) = algebraMap B₁ L₂ D_B₁.1 := rfl
              rw [hDA_val, hD_split]
              have h_rj : algebraMap K₁ L₂ (repr_z j) * algebraMap B₁ L₂ (d_fn j).1 =
                  algebraMap B₁ L₂ (r_fn j) := by
                change algebraMap K₁ L₂ (repr_z j) * algebraMap K₁ L₂ (algebraMap B₁ K₁ (d_fn j).1) =
                  algebraMap K₁ L₂ (algebraMap B₁ K₁ (r_fn j))
                rw [← map_mul, hrd_fn j]
              have h_smul1 : (repr_z j) • b_L j = algebraMap K₁ L₂ (repr_z j) * b_L j :=
                Algebra.smul_def (repr_z j) (b_L j)
              have h_smul2 : (m_b j : B₁) • b_L j = algebraMap B₁ L₂ (m_b j).1 * b_L j :=
                Algebra.smul_def (m_b j : B₁) (b_L j)
              rw [h_smul1, h_smul2, map_mul, map_mul, map_mul]
              calc
                (algebraMap K₁ L₂ (repr_z j) * b_L j) *
                    ((algebraMap B₁ L₂ (d_fn j).1 * algebraMap B₁ L₂ (m_b j).1) *
                      algebraMap B₁ L₂ rest_j)
                  = (algebraMap K₁ L₂ (repr_z j) * algebraMap B₁ L₂ (d_fn j).1) *
                      algebraMap B₁ L₂ rest_j * (algebraMap B₁ L₂ (m_b j).1 * b_L j) := by ring
                _ = (algebraMap B₁ L₂ (r_fn j) * algebraMap B₁ L₂ rest_j) *
                      (algebraMap B₁ L₂ (m_b j).1 * b_L j) := by rw [h_rj]
            rw [h_term]
            exact A_sub_alg.mul_mem (A_sub_alg.algebraMap_mem _)
              (Algebra.subset_adjoin ⟨j, rfl⟩)
          exact ⟨⟨⟨z * (D_A.1 : L₂), hz_mem⟩, D_A⟩, rfl⟩
        exists_of_eq := fun hxy => ⟨1, by simpa using Subtype.ext hxy⟩ }

    have hFinTrans : ∀ (R₁ R₂ L₀ : Type u) [CommRing R₁] [CommRing R₂] [Field L₀]
        [Algebra R₁ R₂] [Algebra R₂ L₀] [Algebra R₁ L₀] [IsScalarTower R₁ R₂ L₀]
        [Algebra.IsIntegral R₁ R₂] [Module.Finite R₁ R₂],
        Module.Finite R₂ ↥(integralClosure R₂ L₀) →
        Module.Finite R₁ ↥(integralClosure R₁ L₀) := by
      intro R₁ R₂ L₀ _ _ _ _ _ _ _ _ _ hFin₂
      have h_iff : ∀ z : L₀, z ∈ integralClosure R₂ L₀ ↔ z ∈ integralClosure R₁ L₀ :=
        fun z => ⟨fun hz => _root_.isIntegral_trans _ hz, fun hz => _root_.IsIntegral.tower_top hz⟩
      have h_le : ∀ x : R₂, algebraMap R₂ L₀ x ∈ integralClosure R₁ L₀ :=
        fun x => _root_.IsIntegral.map (IsScalarTower.toAlgHom R₁ R₂ L₀)
          (Algebra.IsIntegral.isIntegral (R := R₁) x)
      let hom_R₂ : R₂ →+* ↥(integralClosure R₁ L₀) :=
        { toFun := fun x => ⟨algebraMap R₂ L₀ x, h_le x⟩
          map_one' := Subtype.ext (map_one _)
          map_mul' := fun x y => Subtype.ext (map_mul _ x y)
          map_zero' := Subtype.ext (map_zero _)
          map_add' := fun x y => Subtype.ext (map_add _ x y) }
      letI : Algebra R₂ ↥(integralClosure R₁ L₀) := hom_R₂.toAlgebra
      haveI : IsScalarTower R₁ R₂ ↥(integralClosure R₁ L₀) :=
        IsScalarTower.of_algebraMap_eq (fun b =>
          Subtype.ext (IsScalarTower.algebraMap_apply R₁ R₂ L₀ b))
      let e : ↥(integralClosure R₂ L₀) ≃ₗ[R₂] ↥(integralClosure R₁ L₀) :=
        { toFun := fun z => ⟨z.1, (h_iff z.1).mp z.2⟩
          invFun := fun z => ⟨z.1, (h_iff z.1).mpr z.2⟩
          map_add' := fun _ _ => rfl
          map_smul' := fun r z => Subtype.ext (Algebra.smul_def r z.1)
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl }
      haveI : Module.Finite R₂ ↥(integralClosure R₁ L₀) := Module.Finite.equiv e
      exact Module.Finite.trans R₂ ↥(integralClosure R₁ L₀)

    obtain ⟨hFin_ic_A, _⟩ := hIntClFin ↥A_sub_alg L₂
    let B₂_ic := integralClosure B₁ L₂
    have hA_le_B₂ : A_sub_alg ≤ B₂_ic := by
      intro x hx
      exact (_root_.isIntegral_algHom_iff A_sub_alg.val Subtype.val_injective).mpr
        (hA_int_elem ⟨x, hx⟩)
    let ι_A_B₂ : ↥A_sub_alg →+* ↥B₂_ic := (Subalgebra.inclusion hA_le_B₂).toRingHom
    have hInj_A_B₂ : Function.Injective ι_A_B₂ := Subalgebra.inclusion_injective hA_le_B₂
    haveI : Module.Finite B₁ ↥B₂_ic := hFinTrans B₁ ↥A_sub_alg L₂ hFin_ic_A

    letI : Algebra k ↥B₂_ic := ((algebraMap B₁ ↥B₂_ic).comp (algebraMap k B₁)).toAlgebra
    haveI : IsScalarTower k B₁ ↥B₂_ic :=
      IsScalarTower.of_algebraMap_eq' (R := k) (S := B₁) (A := ↥B₂_ic) rfl
    let ψ₁₂ : B₁ →ₐ[k] ↥B₂_ic := IsScalarTower.toAlgHom k B₁ ↥B₂_ic
    let ι_B₂_L₂ : ↥B₂_ic →+* L₂ := B₂_ic.val.toRingHom
    have hInj_B₂_L₂ : Function.Injective ι_B₂_L₂ := Subtype.val_injective
    have hInj_ψ₁₂ : Function.Injective ψ₁₂ := by
      intro x y hxy
      exact hInj_B₁_L₂ (congrArg Subtype.val hxy)

    have hFT_B₁_B₂ : Algebra.FiniteType B₁ ↥B₂_ic :=
      @Module.Finite.finiteType B₁ ↥B₂_ic _ _ _ inferInstance
    haveI : Algebra.FiniteType B₁ ↥B₂_ic := hFT_B₁_B₂
    haveI : Algebra.FiniteType k ↥B₂_ic :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k B₁) hFT_B₁_B₂
    haveI : IsNoetherianRing ↥B₂_ic := Algebra.FiniteType.isNoetherianRing k ↥B₂_ic
    haveI : Algebra.IsIntegral B₁ ↥B₂_ic := Algebra.IsIntegral.of_finite B₁ ↥B₂_ic
    haveI : Ring.DimensionLEOne ↥B₂_ic := Ring.DimensionLEOne.integralClosure B₁ L₂
    haveI : IsIntegrallyClosed ↥B₂_ic := integralClosure.isIntegrallyClosedOfFiniteExtension K₁
    haveI : IsFractionRing ↥B₂_ic L₂ :=
      { map_units := fun y => by
          have hy0 : (y : ↥B₂_ic) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp y.2
          exact Ne.isUnit (fun h => hy0 (Subtype.ext h))
        surj := fun z => by
          obtain ⟨⟨a, d⟩, had⟩ := IsLocalization.surj (nonZeroDivisors ↥A_sub_alg) z
          have hd_ne : (d : ↥A_sub_alg) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp d.2
          let d_B₂ : nonZeroDivisors ↥B₂_ic := ⟨ι_A_B₂ d.1,
            mem_nonZeroDivisors_of_ne_zero (fun h =>
              hd_ne (hInj_A_B₂ (h.trans (map_zero _).symm)))⟩
          exact ⟨⟨ι_A_B₂ a, d_B₂⟩, had⟩
        exists_of_eq := fun hxy => ⟨1, by simpa using Subtype.ext hxy⟩ }
    have hDed₂ : IsDedekindDomain ↥B₂_ic :=
      (isDedekindDomain_iff ↥B₂_ic L₂).mpr
        ⟨inferInstance, inferInstance, inferInstance,
          fun hx => IsIntegrallyClosed.isIntegral_iff.mp hx⟩
    haveI : IsDedekindDomain ↥B₂_ic := hDed₂
    have hNotField₂ : ¬ IsField ↥B₂_ic := by
      intro hF₂
      exact hNotField₁ ((Algebra.IsIntegral.isField_iff_isField hInj_ψ₁₂).mpr hF₂)

    have hτ₁_surj : Function.Surjective τ_B₁.toRingHom :=
      fun c => ⟨algebraMap k B₁ c, τ_B₁.commutes c⟩
    let m₁ : Ideal B₁ := RingHom.ker τ_B₁.toRingHom
    haveI : m₁.IsMaximal := RingHom.ker_isMaximal_of_surjective τ_B₁.toRingHom hτ₁_surj
    have hker_le : RingHom.ker (algebraMap B₁ ↥B₂_ic) ≤ m₁ := by
      intro x hx
      have hx0 : x = 0 := hInj_ψ₁₂ (hx.trans (map_zero _).symm)
      rw [hx0]
      exact m₁.zero_mem
    obtain ⟨m₂, hm₂_max, hm₂_over⟩ := Ideal.exists_ideal_over_maximal_of_isIntegral m₁ hker_le
    haveI : m₂.IsMaximal := hm₂_max

    obtain ⟨n_mv, q_mv, hq_surj⟩ :=
      (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := k) (S := ↥B₂_ic)).mp inferInstance
    let M_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_mv.toRingHom m₂
    haveI : M_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_mv.toRingHom hq_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := M_mv)).mp inferInstance
    let ev_a : MvPolynomial (Fin n_mv) k →ₐ[k] k := MvPolynomial.aeval a_pt
    have hker_ev : RingHom.ker ev_a.toRingHom = M_mv := by
      rw [ha_pt]
      ext p
      simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ev_a]
      exact (MvPolynomial.mem_vanishingIdeal_singleton_iff a_pt p).symm
    letI : Field (↥B₂_ic ⧸ m₂) := Ideal.Quotient.field m₂
    have h_alg_κ₂ : ∀ z : ↥B₂_ic ⧸ m₂, ∃ c : k, algebraMap k (↥B₂_ic ⧸ m₂) c = z := by
      intro z
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨p, rfl⟩ := hq_surj b
      refine ⟨ev_a p, ?_⟩
      have hp_mem : p - algebraMap k (MvPolynomial (Fin n_mv) k) (ev_a p) ∈ M_mv := by
        rw [← hker_ev, RingHom.mem_ker, map_sub, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          ev_a.commutes]
        exact sub_self (ev_a p)
      have hq_mem : q_mv p - algebraMap k ↥B₂_ic (ev_a p) ∈ m₂ := by
        have h1 : q_mv (p - algebraMap k (MvPolynomial (Fin n_mv) k) (ev_a p)) ∈ m₂ := hp_mem
        rwa [map_sub, q_mv.commutes] at h1
      exact (Ideal.Quotient.eq.mpr hq_mem).symm
    have h_bij_κ₂ : Function.Bijective (algebraMap k (↥B₂_ic ⧸ m₂)) :=
      ⟨(algebraMap k (↥B₂_ic ⧸ m₂)).injective, h_alg_κ₂⟩
    let e_κ₂ : k ≃ₐ[k] (↥B₂_ic ⧸ m₂) := AlgEquiv.ofBijective (Algebra.ofId k (↥B₂_ic ⧸ m₂)) h_bij_κ₂
    let τ₂ : ↥B₂_ic →ₐ[k] k := e_κ₂.symm.toAlgHom.comp (Ideal.Quotient.mkₐ k m₂)
    have hm₂_ker : m₂ = RingHom.ker τ₂.toRingHom := by
      ext b
      simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, τ₂, AlgHom.comp_apply,
        Ideal.Quotient.mkₐ_eq_mk]
      constructor
      · intro hb
        rw [(Ideal.Quotient.eq_zero_iff_mem.mpr hb), map_zero]
      · intro hb
        have hb0 : Ideal.Quotient.mk m₂ b = 0 := e_κ₂.symm.injective (hb.trans (map_zero _).symm)
        exact Ideal.Quotient.eq_zero_iff_mem.mp hb0
    have hτ₂_comp : τ₂.comp ψ₁₂ = τ_B₁ := by
      ext b
      have hb_m₁ : b - algebraMap k B₁ (τ_B₁ b) ∈ m₁ := by
        rw [RingHom.mem_ker, map_sub, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          τ_B₁.commutes]
        exact sub_self (τ_B₁ b)
      have hb_m₂ : ψ₁₂ b - algebraMap k ↥B₂_ic (τ_B₁ b) ∈ m₂ := by
        rw [← hm₂_over] at hb_m₁
        change ψ₁₂ (b - algebraMap k B₁ (τ_B₁ b)) ∈ m₂ at hb_m₁
        rwa [map_sub, ψ₁₂.commutes] at hb_m₁
      rw [hm₂_ker, RingHom.mem_ker, map_sub, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        τ₂.commutes, sub_eq_zero] at hb_m₂
      exact hb_m₂
    have hm₂_ne : m₂ ≠ ⊥ := by
      intro hm0
      have h_inj : Function.Injective τ₂.toRingHom := by
        rw [RingHom.injective_iff_ker_eq_bot, ← hm₂_ker, hm0]
      have h_surj : Function.Surjective τ₂.toRingHom :=
        fun c => ⟨algebraMap k ↥B₂_ic c, τ₂.commutes c⟩
      let e_B₂_k : ↥B₂_ic ≃+* k := RingEquiv.ofBijective τ₂.toRingHom ⟨h_inj, h_surj⟩
      exact hNotField₂ (e_B₂_k.toMulEquiv.isField (Field.toIsField k))

    have hm₂_le_nzd : m₂.primeCompl ≤ nonZeroDivisors ↥B₂_ic :=
      fun x hx => mem_nonZeroDivisors_of_ne_zero (fun h0 => hx (by rw [h0]; exact m₂.zero_mem))
    haveI : IsDomain (Localization.AtPrime m₂) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.AtPrime m₂) hm₂_le_nzd
    haveI : IsDiscreteValuationRing (Localization.AtPrime m₂) :=
      IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain
        ↥B₂_ic hm₂_ne (Localization.AtPrime m₂)
    obtain ⟨π₂, hπ₂_irr⟩ := IsDiscreteValuationRing.exists_irreducible (Localization.AtPrime m₂)
    have hπ₂_ne : π₂ ≠ 0 := hπ₂_irr.ne_zero
    have hπ₂_max : IsLocalRing.maximalIdeal (Localization.AtPrime m₂) = Ideal.span {π₂} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer π₂).mp hπ₂_irr

    have hUnits_m₂_L₂ : ∀ s : m₂.primeCompl, IsUnit (ι_B₂_L₂ s.1) := by
      intro s
      have hs0 : (s : ↥B₂_ic) ≠ 0 := fun h0 => s.2 (by rw [h0]; exact m₂.zero_mem)
      exact Ne.isUnit (fun h => hs0 (hInj_B₂_L₂ (h.trans (map_zero _).symm)))
    let ι_R₂_L₂ : Localization.AtPrime m₂ →+* L₂ :=
      IsLocalization.lift (M := m₂.primeCompl) hUnits_m₂_L₂
    have hR₂_L₂_comp : ι_R₂_L₂.comp (algebraMap ↥B₂_ic (Localization.AtPrime m₂)) = ι_B₂_L₂ :=
      IsLocalization.lift_comp hUnits_m₂_L₂
    have hInj_R₂_L₂ : Function.Injective ι_R₂_L₂ := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨⟨a, s⟩, has⟩ := IsLocalization.surj m₂.primeCompl z
      have ha0 : ι_B₂_L₂ a = 0 := by
        have h1 := congrArg ι_R₂_L₂ has
        rw [map_mul, hz, zero_mul] at h1
        exact (RingHom.congr_fun hR₂_L₂_comp a).symm.trans h1.symm
      have ha_eq0 : a = 0 := hInj_B₂_L₂ (ha0.trans (map_zero _).symm)
      rw [ha_eq0, map_zero] at has
      exact (IsLocalization.map_units (Localization.AtPrime m₂) s).mul_left_eq_zero.mp has

    have hB₁_Ω_eq : (ι_L₂_Ω.comp ι_B₂_L₂).comp ψ₁₂.toRingHom = ι_B₁_Ω := by
      ext b
      exact RingHom.congr_fun hK₁_Ω_comp b
    have hω_mem : ∀ i : Fin n_gen, ∃ y : L₂, ι_L₂_Ω y = ω_gen i :=
      fun i => ⟨⟨ω_gen i, IntermediateField.subset_adjoin K₁ S_set ⟨i, rfl⟩⟩, rfl⟩
    have hL₂_away : ∀ y : L₂, ∃ (r : Localization.AtPrime m₂) (n : ℕ),
        y * (ι_R₂_L₂ π₂) ^ n = ι_R₂_L₂ r := by
      intro y
      obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors ↥B₂_ic) y
      have hb_ne : (b : ↥B₂_ic) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
      let b_R : Localization.AtPrime m₂ := algebraMap ↥B₂_ic (Localization.AtPrime m₂) b.1
      have hbR_ne : b_R ≠ 0 := by
        intro h0
        have : ι_B₂_L₂ b.1 = 0 := by
          rw [← RingHom.congr_fun hR₂_L₂_comp b.1]
          change ι_R₂_L₂ b_R = 0
          rw [h0, map_zero]
        exact hb_ne (hInj_B₂_L₂ (this.trans (map_zero _).symm))
      obtain ⟨n, u_r, hbR_eq⟩ := IsDiscreteValuationRing.associated_pow_irreducible hbR_ne hπ₂_irr
      let r : Localization.AtPrime m₂ := algebraMap ↥B₂_ic (Localization.AtPrime m₂) a * u_r.1
      refine ⟨r, n, ?_⟩
      calc
        y * (ι_R₂_L₂ π₂) ^ n
          = y * ι_R₂_L₂ (π₂ ^ n) := by rw [← map_pow]
        _ = y * ι_R₂_L₂ (b_R * u_r.1) := by rw [← hbR_eq]
        _ = (y * ι_R₂_L₂ b_R) * ι_R₂_L₂ u_r.1 := by rw [map_mul, mul_assoc]
        _ = (y * ι_B₂_L₂ b.1) * ι_R₂_L₂ u_r.1 := by
              congr 2
              exact RingHom.congr_fun hR₂_L₂_comp b.1
        _ = ι_B₂_L₂ a * ι_R₂_L₂ u_r.1 := by
              have hab' : y * ι_B₂_L₂ b.1 = ι_B₂_L₂ a := hab
              rw [hab']
        _ = ι_R₂_L₂ (algebraMap ↥B₂_ic (Localization.AtPrime m₂) a) * ι_R₂_L₂ u_r.1 := by
              rw [← RingHom.congr_fun hR₂_L₂_comp a]
              rfl
        _ = ι_R₂_L₂ r := by rw [← map_mul]

    exact ⟨↥B₂_ic, inferInstance, inferInstance, inferInstance, inferInstance, hDed₂, hNotField₂,
      ψ₁₂, τ₂, m₂, hm₂_max, π₂, L₂, inferInstance, ι_B₂_L₂, ι_R₂_L₂, ι_L₂_Ω,
      ⟨hInj_ψ₁₂, hτ₂_comp, hm₂_ker, hm₂_ne⟩,
      ⟨inferInstance, hπ₂_max, hπ₂_ne⟩,
      ⟨hInj_B₂_L₂, hR₂_L₂_comp, hInj_R₂_L₂, hB₁_Ω_eq⟩,
      hω_mem, hL₂_away⟩

  have probe_s4 : ∀ (k : Type u) [Field k]
      (ℓ : ℕ)
      (B₁ : Type u) [CommRing B₁] [Algebra k B₁]
      (τ_B₁ : B₁ →ₐ[k] k)
      (Ω : Type u) [Field Ω]
      (ι_B₁_Ω : B₁ →+* Ω)
      (B₂ : Type u) [CommRing B₂] [IsDomain B₂] [Algebra k B₂] [Algebra.FiniteType k B₂]
      (hDed₂ : IsDedekindDomain B₂)
      (ψ₁₂ : B₁ →ₐ[k] B₂)
      (τ₂ : B₂ →ₐ[k] k) (hτ₂ : τ₂.comp ψ₁₂ = τ_B₁)
      (m₂ : Ideal B₂) [m₂.IsMaximal]
      (hm₂_ker : m₂ = RingHom.ker τ₂.toRingHom)
      (π₂ : Localization.AtPrime m₂)
      (hπ₂_max : IsLocalRing.maximalIdeal (Localization.AtPrime m₂) = Ideal.span {π₂})
      (hπ₂_ne : π₂ ≠ 0)
      (L₂ : Type u) [Field L₂]
      (ι_B₂_L₂ : B₂ →+* L₂) (hInj_B₂_L₂ : Function.Injective ι_B₂_L₂)
      (ι_R₂_L₂ : Localization.AtPrime m₂ →+* L₂)
      (hR₂_L₂_comp : ι_R₂_L₂.comp (algebraMap B₂ (Localization.AtPrime m₂)) = ι_B₂_L₂)
      (hInj_R₂_L₂ : Function.Injective ι_R₂_L₂)
      (hL₂_away : ∀ y : L₂, ∃ (r : Localization.AtPrime m₂) (n : ℕ),
        y * (ι_R₂_L₂ π₂) ^ n = ι_R₂_L₂ r)
      (ι_L₂_Ω : L₂ →+* Ω)
      (hB₁_Ω_eq : (ι_L₂_Ω.comp ι_B₂_L₂).comp ψ₁₂.toRingHom = ι_B₁_Ω)
      (N_cov : ℕ)
      (A : Fin N_cov → Type u) [∀ α, CommRing (A α)] [∀ α, Algebra B₁ (A α)]
      [∀ α, Module.Flat B₁ (A α)]
      (A₂ : Fin N_cov → Fin N_cov → Type u) [∀ α β, CommRing (A₂ α β)]
      [∀ α β, Algebra B₁ (A₂ α β)] [∀ α β, Module.Flat B₁ (A₂ α β)]
      (ρL : ∀ α β : Fin N_cov, A α →ₐ[B₁] A₂ α β)
      (ρR : ∀ α β : Fin N_cov, A β →ₐ[B₁] A₂ α β)
      (g₁ : ∀ α β : Fin N_cov, Units (A₂ α β))
      (active : Fin N_cov → Prop)
      (hAct_ex : ∃ α₀ : Fin N_cov, active α₀)
      (hNZD_Ω :
        letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
        (∀ α : Fin N_cov, NoZeroDivisors (TensorProduct B₁ (A α) Ω)) ∧
        (∀ α β : Fin N_cov, NoZeroDivisors (TensorProduct B₁ (A₂ α β) Ω)))
      (hSpecFib :
        letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
        (∀ α : Fin N_cov, active α → IsDomain (TensorProduct B₁ (A α) k)) ∧
        (∀ α : Fin N_cov, ¬ active α → Subsingleton (TensorProduct B₁ (A α) k)) ∧
        (∀ α β : Fin N_cov, active α → active β → IsDomain (TensorProduct B₁ (A₂ α β) k))),
      letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
      letI : Algebra B₁ L₂ := (ι_B₂_L₂.comp ψ₁₂.toRingHom).toAlgebra
      ∀ (u_L₂ : ∀ α : Fin N_cov, Units (TensorProduct B₁ (A α) L₂)),
        (∀ α β : Fin N_cov,
          (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂)) *
            (Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ L₂)) (u_L₂ β).1 =
          (Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ L₂)) (u_L₂ α).1) →
        ∃ (B_sp : Type u) (_ : CommRing B_sp) (_ : IsDomain B_sp) (_ : Algebra k B_sp)
          (_ : Algebra.FiniteType k B_sp) (_ : IsDedekindDomain B_sp)
          (instAlgB₁_sp : Algebra B₁ B_sp)
          (ψ_sp : B₁ →ₐ[k] B_sp) (τ_sp : B_sp →ₐ[k] k)
          (ι_sp_Ω : B_sp →+* Ω) (_ : Function.Injective ι_sp_Ω)
          (c_scale : Units Ω),
          (@algebraMap B₁ B_sp _ _ instAlgB₁_sp = ψ_sp.toRingHom) ∧
          τ_sp.comp ψ_sp = τ_B₁ ∧
          ∃ (hι_sp_eq : ι_sp_Ω.comp (@algebraMap B₁ B_sp _ _ instAlgB₁_sp) = ι_B₁_Ω),
            letI : Algebra B₁ B_sp := instAlgB₁_sp
            ∃ (u_sp : ∀ α : Fin N_cov, Units (TensorProduct B₁ (A α) B_sp)),
              (∀ α β : Fin N_cov,
                (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : B_sp)) *
                  (Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ B_sp)) (u_sp β).1 =
                (Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ B_sp)) (u_sp α).1) ∧
              (∀ α : Fin N_cov,
                (Algebra.TensorProduct.map (AlgHom.id B₁ (A α))
                  ({ toRingHom := ι_sp_Ω
                     commutes' := fun b => RingHom.congr_fun hι_sp_eq b } : B_sp →ₐ[B₁] Ω))
                  (u_sp α).1 =
                (TensorProduct.tmul B₁ (1 : A α) c_scale.1) *
                  (Algebra.TensorProduct.map (AlgHom.id B₁ (A α))
                    ({ toRingHom := ι_L₂_Ω
                       commutes' := fun b => RingHom.congr_fun hB₁_Ω_eq b } : L₂ →ₐ[B₁] Ω))
                    (u_L₂ α).1) := by
    clear! k ℓ B₁ Ω Y_B₁ C₀ Y_η N_cov
    intro k _ ℓ B₁ _ _ τ_B₁ Ω _ ι_B₁_Ω B₂ _ _ _ _ hDed₂ ψ₁₂ τ₂ hτ₂ m₂ _ hm₂_ker π₂ hπ₂_max hπ₂_ne L₂ _ ι_B₂_L₂ hInj_B₂_L₂ ι_R₂_L₂ hR₂_L₂_comp hInj_R₂_L₂ hL₂_away ι_L₂_Ω hB₁_Ω_eq N_cov A _ _ _ A₂ _ _ _ ρL ρR g₁ active hAct_ex hNZD_Ω hSpecFib
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    letI : Algebra B₁ L₂ := (ι_B₂_L₂.comp ψ₁₂.toRingHom).toAlgebra
    letI : Algebra B₁ B₂ := ψ₁₂.toRingHom.toAlgebra
    haveI : IsScalarTower k B₁ B₂ :=
      IsScalarTower.of_algebraMap_eq' (R := k) (S := B₁) (A := B₂) ψ₁₂.comp_algebraMap.symm
    intro u_L₂ hu_L₂_trans

    have hInj_L₂_Ω : Function.Injective ι_L₂_Ω := ι_L₂_Ω.injective
    let ι_L₂_Ω_alg : L₂ →ₐ[B₁] Ω :=
      { toRingHom := ι_L₂_Ω
        commutes' := fun b => RingHom.congr_fun hB₁_Ω_eq b }
    let ι_R₂_L₂_alg : Localization.AtPrime m₂ →ₐ[B₁] L₂ :=
      { toRingHom := ι_R₂_L₂
        commutes' := fun b => by
          rw [IsScalarTower.algebraMap_apply B₁ B₂ (Localization.AtPrime m₂)]
          exact RingHom.congr_fun hR₂_L₂_comp (ψ₁₂ b) }
    let ι_B₂_R₂_alg : B₂ →ₐ[B₁] Localization.AtPrime m₂ :=
      IsScalarTower.toAlgHom B₁ B₂ (Localization.AtPrime m₂)
    let ι_R₂_Ω_alg : Localization.AtPrime m₂ →ₐ[B₁] Ω := ι_L₂_Ω_alg.comp ι_R₂_L₂_alg
    have hInj_R₂_Ω : Function.Injective ι_R₂_Ω_alg := hInj_L₂_Ω.comp hInj_R₂_L₂

    have hFlatInj : ∀ (M : Type u) [CommRing M] [Algebra B₁ M] [Module.Flat B₁ M]
        (R' S' : Type u) [CommRing R'] [Algebra B₁ R'] [CommRing S'] [Algebra B₁ S']
        (φ : R' →ₐ[B₁] S'),
        Function.Injective φ →
        Function.Injective (Algebra.TensorProduct.map (AlgHom.id B₁ M) φ) := by
      intro M _ _ _ R' S' _ _ _ _ φ hφ
      have hl_inj : Function.Injective (LinearMap.lTensor M φ.toLinearMap) :=
        Module.Flat.lTensor_preserves_injective_linearMap φ.toLinearMap hφ
      have h_eq : ∀ z : TensorProduct B₁ M R',
          Algebra.TensorProduct.map (AlgHom.id B₁ M) φ z = LinearMap.lTensor M φ.toLinearMap z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul m r => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      intro x y hxy
      apply hl_inj
      rw [← h_eq x, ← h_eq y, hxy]

    have hNZD_R₂_A : ∀ α : Fin N_cov,
        NoZeroDivisors (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) := by
      intro α
      haveI : NoZeroDivisors (TensorProduct B₁ (A α) Ω) := hNZD_Ω.1 α
      let f := (Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_R₂_Ω_alg).toRingHom
      exact Function.Injective.noZeroDivisors f
        (hFlatInj (A α) (Localization.AtPrime m₂) Ω ι_R₂_Ω_alg hInj_R₂_Ω)
        (map_zero f) (map_mul f)

    have hUnits_m₂_k : ∀ s : m₂.primeCompl, IsUnit (τ₂.toRingHom s.1) := by
      intro s
      have hs_not : s.1 ∉ RingHom.ker τ₂.toRingHom := by
        rw [← hm₂_ker]
        exact s.2
      exact Ne.isUnit hs_not
    let τ_R₂ : Localization.AtPrime m₂ →+* k := IsLocalization.lift (M := m₂.primeCompl) hUnits_m₂_k
    have hτ_R₂_comp : τ_R₂.comp (algebraMap B₂ (Localization.AtPrime m₂)) = τ₂.toRingHom :=
      IsLocalization.lift_comp hUnits_m₂_k
    have hτ_R₂_k : ∀ c : k, τ_R₂ (algebraMap k (Localization.AtPrime m₂) c) = c := by
      intro c
      rw [IsScalarTower.algebraMap_apply k B₂ (Localization.AtPrime m₂)]
      change (τ_R₂.comp (algebraMap B₂ (Localization.AtPrime m₂))) (algebraMap k B₂ c) = c
      rw [hτ_R₂_comp]
      exact τ₂.commutes c
    have hτ_R₂_B₁ : ∀ b : B₁, τ_R₂ (algebraMap B₁ (Localization.AtPrime m₂) b) = τ_B₁ b := by
      intro b
      rw [IsScalarTower.algebraMap_apply B₁ B₂ (Localization.AtPrime m₂)]
      change (τ_R₂.comp (algebraMap B₂ (Localization.AtPrime m₂))) (ψ₁₂ b) = τ_B₁ b
      rw [hτ_R₂_comp]
      exact AlgHom.congr_fun hτ₂ b
    have hτ_R₂_surj : Function.Surjective τ_R₂ :=
      fun c => ⟨algebraMap k (Localization.AtPrime m₂) c, hτ_R₂_k c⟩
    have hker_τ_R₂ : RingHom.ker τ_R₂ = Ideal.span {π₂} := by
      have hmax : (RingHom.ker τ_R₂).IsMaximal :=
        RingHom.ker_isMaximal_of_surjective τ_R₂ hτ_R₂_surj
      exact (IsLocalRing.eq_maximalIdeal hmax).trans hπ₂_max

    have hQuotIso :
        letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
        ∀ (M : Type u) [CommRing M] [Algebra B₁ M],
          Nonempty (((TensorProduct B₁ M (Localization.AtPrime m₂)) ⧸
            Ideal.span {TensorProduct.tmul B₁ (1 : M) π₂}) ≃+* TensorProduct B₁ M k) := by
      letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
      intro M _ _
      let p_M : TensorProduct B₁ M (Localization.AtPrime m₂) := TensorProduct.tmul B₁ (1 : M) π₂
      let τ_R₂_alg : Localization.AtPrime m₂ →ₐ[B₁] k :=
        { toRingHom := τ_R₂
          commutes' := hτ_R₂_B₁ }
      let ψ_fwd : TensorProduct B₁ M (Localization.AtPrime m₂) →+* TensorProduct B₁ M k :=
        (Algebra.TensorProduct.map (AlgHom.id B₁ M) τ_R₂_alg).toRingHom
      have hI_le_ker : Ideal.span {p_M} ≤ RingHom.ker ψ_fwd := by
        rw [Ideal.span_le]
        rintro _ rfl
        rw [SetLike.mem_coe, RingHom.mem_ker]
        have hπ0 : τ_R₂ π₂ = 0 := by
          rw [← RingHom.mem_ker, hker_τ_R₂]
          exact Ideal.subset_span rfl
        change TensorProduct.tmul B₁ (1 : M) (τ_R₂ π₂) = 0
        rw [hπ0, TensorProduct.tmul_zero]
      let I_M : Ideal (TensorProduct B₁ M (Localization.AtPrime m₂)) := Ideal.span {p_M}
      let fwd_M : (TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M) →+*
          TensorProduct B₁ M k :=
        Ideal.Quotient.lift I_M ψ_fwd (fun x hx => hI_le_ker hx)
      let f_left : M →ₐ[B₁] (TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M) :=
        (Ideal.Quotient.mkₐ B₁ I_M).comp Algebra.TensorProduct.includeLeft
      let f_right_ring : k →+* (TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M) :=
        (Ideal.Quotient.mk I_M).comp
          (Algebra.TensorProduct.includeRight.toRingHom.comp
            (algebraMap k (Localization.AtPrime m₂)))
      let f_right_alg : k →ₐ[B₁] (TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M) :=
        { toRingHom := f_right_ring
          commutes' := fun b => by
            change Ideal.Quotient.mk I_M
                (TensorProduct.tmul B₁ (1 : M) (algebraMap k (Localization.AtPrime m₂) (τ_B₁ b))) =
              Ideal.Quotient.mk I_M
                (algebraMap B₁ (TensorProduct B₁ M (Localization.AtPrime m₂)) b)
            have hdiff : algebraMap B₁ (Localization.AtPrime m₂) b -
                algebraMap k (Localization.AtPrime m₂) (τ_B₁ b) ∈ Ideal.span {π₂} := by
              rw [← hker_τ_R₂, RingHom.mem_ker, map_sub, hτ_R₂_B₁, hτ_R₂_k, sub_self]
            obtain ⟨u_r, hu_r⟩ := Ideal.mem_span_singleton.mp hdiff
            have hsub_I : TensorProduct.tmul B₁ (1 : M) (algebraMap B₁ (Localization.AtPrime m₂) b) -
                TensorProduct.tmul B₁ (1 : M) (algebraMap k (Localization.AtPrime m₂) (τ_B₁ b)) ∈
                  I_M := by
              rw [← TensorProduct.tmul_sub, hu_r]
              have h_mul : TensorProduct.tmul B₁ (1 : M) (π₂ * u_r) =
                  p_M * TensorProduct.tmul B₁ (1 : M) u_r := by
                simp [p_M, Algebra.TensorProduct.tmul_mul_tmul]
              rw [h_mul]
              exact Ideal.mem_span_singleton.mpr ⟨TensorProduct.tmul B₁ (1 : M) u_r, rfl⟩
            have hmk_eq : Ideal.Quotient.mk I_M
                  (TensorProduct.tmul B₁ (1 : M) (algebraMap k (Localization.AtPrime m₂) (τ_B₁ b))) =
                Ideal.Quotient.mk I_M
                  (TensorProduct.tmul B₁ (1 : M) (algebraMap B₁ (Localization.AtPrime m₂) b)) :=
              (Ideal.Quotient.eq.mpr hsub_I).symm
            have halg_eq :
                (algebraMap B₁ (TensorProduct B₁ M (Localization.AtPrime m₂)) b) =
                  TensorProduct.tmul B₁ (1 : M) (algebraMap B₁ (Localization.AtPrime m₂) b) := by
              rw [Algebra.TensorProduct.algebraMap_apply, ← mul_one (algebraMap B₁ M b),
                ← Algebra.smul_def, TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
            rw [halg_eq]
            exact hmk_eq }
      let bwd_M : TensorProduct B₁ M k →ₐ[B₁]
          (TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M) :=
        Algebra.TensorProduct.lift f_left f_right_alg (by
          intro m c
          change (f_left m : TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M) * f_right_alg c =
            f_right_alg c * f_left m
          exact @mul_comm (TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M) _
            (f_left m) (f_right_alg c))
      have h_fb : ∀ z : TensorProduct B₁ M k, fwd_M (bwd_M z) = z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul m c =>
            have hbwd : bwd_M (TensorProduct.tmul B₁ m c) =
                Ideal.Quotient.mk I_M
                  (TensorProduct.tmul B₁ m (algebraMap k (Localization.AtPrime m₂) c)) := by
              change f_left m * f_right_alg c = _
              change Ideal.Quotient.mk I_M (TensorProduct.tmul B₁ m 1) *
                Ideal.Quotient.mk I_M
                  (TensorProduct.tmul B₁ 1 (algebraMap k (Localization.AtPrime m₂) c)) = _
              rw [← map_mul]
              congr 1
              simp [Algebra.TensorProduct.tmul_mul_tmul]
            rw [hbwd]
            change TensorProduct.tmul B₁ m (τ_R₂ (algebraMap k (Localization.AtPrime m₂) c)) = _
            rw [hτ_R₂_k]
        | add x y hx hy => simp [map_add, hx, hy]
      have h_bf : ∀ q : TensorProduct B₁ M (Localization.AtPrime m₂) ⧸ I_M,
          bwd_M (fwd_M q) = q := by
        intro q
        refine Quotient.inductionOn' q (fun z => ?_)
        change bwd_M (ψ_fwd z) = Ideal.Quotient.mk I_M z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul m r =>
            change bwd_M (TensorProduct.tmul B₁ m (τ_R₂ r)) =
              Ideal.Quotient.mk I_M (TensorProduct.tmul B₁ m r)
            have hbwd : bwd_M (TensorProduct.tmul B₁ m (τ_R₂ r)) =
                Ideal.Quotient.mk I_M
                  (TensorProduct.tmul B₁ m (algebraMap k (Localization.AtPrime m₂) (τ_R₂ r))) := by
              change f_left m * f_right_alg (τ_R₂ r) = _
              change Ideal.Quotient.mk I_M (TensorProduct.tmul B₁ m 1) *
                Ideal.Quotient.mk I_M
                  (TensorProduct.tmul B₁ 1 (algebraMap k (Localization.AtPrime m₂) (τ_R₂ r))) = _
              rw [← map_mul]
              congr 1
              simp [Algebra.TensorProduct.tmul_mul_tmul]
            rw [hbwd]
            have hdiff : r - algebraMap k (Localization.AtPrime m₂) (τ_R₂ r) ∈ Ideal.span {π₂} := by
              rw [← hker_τ_R₂, RingHom.mem_ker, map_sub, hτ_R₂_k, sub_self]
            obtain ⟨u_r, hu_r⟩ := Ideal.mem_span_singleton.mp hdiff
            apply (Ideal.Quotient.eq.mpr ?_).symm
            rw [← TensorProduct.tmul_sub, hu_r]
            have h_mul : TensorProduct.tmul B₁ m (π₂ * u_r) =
                p_M * TensorProduct.tmul B₁ m u_r := by
              simp [p_M, Algebra.TensorProduct.tmul_mul_tmul]
            rw [h_mul]
            exact Ideal.mem_span_singleton.mpr ⟨TensorProduct.tmul B₁ m u_r, rfl⟩
        | add x y hx hy => simp [map_add, hx, hy]
      exact ⟨{ fwd_M with
        invFun := bwd_M.toRingHom
        left_inv := h_bf
        right_inv := h_fb }⟩

    let π_L : L₂ := ι_R₂_L₂ π₂
    have hπ_L_ne : π_L ≠ 0 :=
      fun h0 => hπ₂_ne (hInj_R₂_L₂ (h0.trans (map_zero _).symm))
    let π_Ω : Ω := ι_L₂_Ω π_L
    have hπ_Ω_ne : π_Ω ≠ 0 :=
      fun h0 => hπ_L_ne (hInj_L₂_Ω (h0.trans (map_zero _).symm))

    have hClearPi : ∀ (M : Type u) [CommRing M] [Algebra B₁ M]
        (z : TensorProduct B₁ M L₂),
        ∃ (n : ℕ) (a : TensorProduct B₁ M (Localization.AtPrime m₂)),
          Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_R₂_L₂_alg a =
            z * (TensorProduct.tmul B₁ (1 : M) π_L) ^ n := by
      intro M _ _ z
      have hpow_tmul : ∀ n : ℕ, (TensorProduct.tmul B₁ (1 : M) π_L) ^ n =
          TensorProduct.tmul B₁ (1 : M) (π_L ^ n) := by
        intro n
        induction n with
        | zero =>
            rw [pow_zero, pow_zero]
            exact Algebra.TensorProduct.one_def.symm
        | succ n ih =>
            rw [pow_succ, ih, Algebra.TensorProduct.tmul_mul_tmul, one_mul, pow_succ]
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, 0, by simp⟩
      | tmul m y =>
          obtain ⟨r, n, hrn⟩ := hL₂_away y
          refine ⟨n, TensorProduct.tmul B₁ m r, ?_⟩
          rw [hpow_tmul n, Algebra.TensorProduct.tmul_mul_tmul, mul_one, hrn]
          rfl
      | add x y hx hy =>
          obtain ⟨nx, ax, hax⟩ := hx
          obtain ⟨ny, ay, hay⟩ := hy
          refine ⟨nx + ny,
            ax * (TensorProduct.tmul B₁ (1 : M) π₂) ^ ny +
              ay * (TensorProduct.tmul B₁ (1 : M) π₂) ^ nx, ?_⟩
          simp only [map_add, map_mul, map_pow, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
          change (Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_R₂_L₂_alg ax) *
              (TensorProduct.tmul B₁ (1 : M) π_L) ^ ny +
            (Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_R₂_L₂_alg ay) *
              (TensorProduct.tmul B₁ (1 : M) π_L) ^ nx = _
          rw [hax, hay, add_mul, mul_assoc, ← pow_add, mul_assoc, ← pow_add, add_comm ny nx]

    have hPrimeCancel : ∀ (S : Type u) [CommRing S] [IsDomain S] (p : S),
        p ≠ 0 → (Ideal.span {p}).IsPrime →
        ∀ (N : ℕ) (a b : S), a * b = p ^ N →
          ∃ (v w : ℕ) (u' : Units S),
            v + w = N ∧ a = p ^ v * u'.1 ∧ b = p ^ w * (u'⁻¹).1 := by
      intro S _ _ p hp0 hp_prime N
      induction N with
      | zero =>
          intro a b hab
          rw [pow_zero] at hab
          refine ⟨0, 0, ⟨a, b, hab, mul_comm b a ▸ hab⟩, rfl, ?_, ?_⟩ <;> simp
      | succ N ih =>
          intro a b hab
          have hmem : a * b ∈ Ideal.span {p} := by
            rw [hab, pow_succ']
            exact Ideal.mem_span_singleton.mpr ⟨p ^ N, rfl⟩
          rcases hp_prime.mem_or_mem hmem with ha | hb
          · obtain ⟨a₁, rfl⟩ := Ideal.mem_span_singleton.mp ha
            have hab₁ : a₁ * b = p ^ N := by
              apply mul_left_cancel₀ hp0
              calc
                p * (a₁ * b) = (p * a₁) * b := (mul_assoc _ _ _).symm
                _ = p ^ (N + 1) := hab
                _ = p * p ^ N := pow_succ' p N
            obtain ⟨v₁, w, u', hvw, ha₁, hb₁⟩ := ih a₁ b hab₁
            refine ⟨v₁ + 1, w, u', by omega, ?_, hb₁⟩
            rw [ha₁, pow_succ', mul_assoc]
          · obtain ⟨b₁, rfl⟩ := Ideal.mem_span_singleton.mp hb
            have hab₁ : a * b₁ = p ^ N := by
              apply mul_left_cancel₀ hp0
              calc
                p * (a * b₁) = a * (p * b₁) := mul_left_comm p a b₁
                _ = p ^ (N + 1) := hab
                _ = p * p ^ N := pow_succ' p N
            obtain ⟨v, w₁, u', hvw, ha₁, hb₁⟩ := ih a b₁ hab₁
            refine ⟨v, w₁ + 1, u', by omega, ha₁, ?_⟩
            rw [hb₁, pow_succ', mul_assoc]

    let p_R : ∀ α : Fin N_cov, TensorProduct B₁ (A α) (Localization.AtPrime m₂) :=
      fun α => TensorProduct.tmul B₁ (1 : A α) π₂
    let ϖ_L : ∀ (M : Type u) [CommRing M] [Algebra B₁ M], Units (TensorProduct B₁ M L₂) :=
      fun M _ _ =>
        { val := TensorProduct.tmul B₁ (1 : M) π_L
          inv := TensorProduct.tmul B₁ (1 : M) π_L⁻¹
          val_inv := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_inv_cancel₀ hπ_L_ne,
              Algebra.TensorProduct.one_def]
          inv_val := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, inv_mul_cancel₀ hπ_L_ne,
              Algebra.TensorProduct.one_def] }
    let Φ_RL : ∀ α : Fin N_cov,
        TensorProduct B₁ (A α) (Localization.AtPrime m₂) →ₐ[B₁] TensorProduct B₁ (A α) L₂ :=
      fun α => Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_R₂_L₂_alg
    have hInj_Φ_RL : ∀ α : Fin N_cov, Function.Injective (Φ_RL α) :=
      fun α => hFlatInj (A α) (Localization.AtPrime m₂) L₂ ι_R₂_L₂_alg hInj_R₂_L₂

    let k_pos : Fin N_cov → ℕ := fun α => Classical.choose (hClearPi (A α) (u_L₂ α).1)
    let a_pos : ∀ α : Fin N_cov, TensorProduct B₁ (A α) (Localization.AtPrime m₂) :=
      fun α => Classical.choose (Classical.choose_spec (hClearPi (A α) (u_L₂ α).1))
    have ha_pos : ∀ α : Fin N_cov,
        Φ_RL α (a_pos α) = (u_L₂ α).1 * (ϖ_L (A α)).1 ^ (k_pos α) :=
      fun α => Classical.choose_spec (Classical.choose_spec (hClearPi (A α) (u_L₂ α).1))

    let l_neg : Fin N_cov → ℕ := fun α => Classical.choose (hClearPi (A α) (u_L₂ α)⁻¹.1)
    let b_neg : ∀ α : Fin N_cov, TensorProduct B₁ (A α) (Localization.AtPrime m₂) :=
      fun α => Classical.choose (Classical.choose_spec (hClearPi (A α) (u_L₂ α)⁻¹.1))
    have hb_neg : ∀ α : Fin N_cov,
        Φ_RL α (b_neg α) = (u_L₂ α)⁻¹.1 * (ϖ_L (A α)).1 ^ (l_neg α) :=
      fun α => Classical.choose_spec (Classical.choose_spec (hClearPi (A α) (u_L₂ α)⁻¹.1))

    have hab_pow : ∀ α : Fin N_cov, a_pos α * b_neg α = (p_R α) ^ (k_pos α + l_neg α) := by
      intro α
      apply hInj_Φ_RL α
      rw [map_mul, ha_pos α, hb_neg α, map_pow]
      have hp_map : Φ_RL α (p_R α) = (ϖ_L (A α)).1 := rfl
      rw [hp_map]
      calc
        ((u_L₂ α).1 * (ϖ_L (A α)).1 ^ k_pos α) * ((u_L₂ α)⁻¹.1 * (ϖ_L (A α)).1 ^ l_neg α)
          = ((u_L₂ α).1 * (u_L₂ α)⁻¹.1) * ((ϖ_L (A α)).1 ^ k_pos α * (ϖ_L (A α)).1 ^ l_neg α) := by
              ring
        _ = 1 * (ϖ_L (A α)).1 ^ (k_pos α + l_neg α) := by rw [Units.mul_inv, ← pow_add]
        _ = (ϖ_L (A α)).1 ^ (k_pos α + l_neg α) := one_mul _

    have hActFact : ∀ α : Fin N_cov, active α →
        ∃ (v : ℕ) (u' : Units (TensorProduct B₁ (A α) (Localization.AtPrime m₂))),
          a_pos α = (p_R α) ^ v * u'.1 := by
      intro α hact
      letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
      obtain ⟨e_q⟩ := hQuotIso (A α)
      haveI : IsDomain (TensorProduct B₁ (A α) k) := hSpecFib.1 α hact
      haveI : IsDomain (TensorProduct B₁ (A α) (Localization.AtPrime m₂) ⧸ Ideal.span {p_R α}) :=
        e_q.toMulEquiv.isDomain (TensorProduct B₁ (A α) k)
      have hp_prime : (Ideal.span {p_R α}).IsPrime :=
        (Ideal.Quotient.isDomain_iff_prime (Ideal.span {p_R α})).mp inferInstance
      haveI : NoZeroDivisors (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) := hNZD_R₂_A α
      haveI : Nontrivial (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) := by
        refine ⟨⟨0, 1, fun h01 => hp_prime.ne_top ?_⟩⟩
        rw [Ideal.eq_top_iff_one, ← h01]
        exact (Ideal.span {p_R α}).zero_mem
      haveI : IsDomain (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) :=
        NoZeroDivisors.to_isDomain _
      have hp0 : p_R α ≠ 0 := by
        intro hp_z
        have h1 : (1 : TensorProduct B₁ (A α) L₂) = 0 := by
          have h_map0 : (ϖ_L (A α)).1 = 0 := by
            change Φ_RL α (p_R α) = 0
            rw [hp_z, map_zero]
          have := (ϖ_L (A α)).val_inv
          rw [h_map0, zero_mul] at this
          exact this.symm
        exact one_ne_zero (hInj_Φ_RL α ((map_one (Φ_RL α)).trans (h1.trans (map_zero _).symm)))
      obtain ⟨v, _, u', _, ha_eq, _⟩ :=
        hPrimeCancel (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) (p_R α) hp0 hp_prime
          (k_pos α + l_neg α) (a_pos α) (b_neg α) (hab_pow α)
      exact ⟨v, u', ha_eq⟩

    let v_act : ∀ α : Fin N_cov, active α → ℕ :=
      fun α hact => Classical.choose (hActFact α hact)
    let u_act : ∀ α : Fin N_cov, active α →
        Units (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) :=
      fun α hact => Classical.choose (Classical.choose_spec (hActFact α hact))
    have hu_act_eq : ∀ (α : Fin N_cov) (hact : active α),
        a_pos α = (p_R α) ^ (v_act α hact) * (u_act α hact).1 :=
      fun α hact => Classical.choose_spec (Classical.choose_spec (hActFact α hact))
    let m_act : ∀ α : Fin N_cov, active α → ℤ :=
      fun α hact => (v_act α hact : ℤ) - (k_pos α : ℤ)

    have hu_L₂_act : ∀ (α : Fin N_cov) (hact : active α),
        (u_L₂ α).1 = ((ϖ_L (A α)) ^ (m_act α hact)).1 * Φ_RL α (u_act α hact).1 := by
      intro α hact
      have h1 := ha_pos α
      rw [hu_act_eq α hact, map_mul, map_pow] at h1
      have hp_map : Φ_RL α (p_R α) = (ϖ_L (A α)).1 := rfl
      rw [hp_map] at h1
      apply ((ϖ_L (A α)) ^ (k_pos α)).isUnit.mul_left_inj.mp
      rw [Units.val_pow_eq_pow_val, ← h1]
      have hzpow : ((ϖ_L (A α)) ^ (m_act α hact)).1 * ((ϖ_L (A α)).1 ^ k_pos α) =
          (ϖ_L (A α)).1 ^ (v_act α hact) := by
        rw [← Units.val_pow_eq_pow_val, ← Units.val_pow_eq_pow_val, ← zpow_natCast, ← zpow_natCast,
          ← Units.val_mul, ← zpow_add, sub_add_cancel]
      calc
        (ϖ_L (A α)).1 ^ v_act α hact * (Φ_RL α) (u_act α hact).1
          = (((ϖ_L (A α)) ^ m_act α hact).1 * (ϖ_L (A α)).1 ^ k_pos α) *
              (Φ_RL α) (u_act α hact).1 := by rw [hzpow]
        _ = (((ϖ_L (A α)) ^ m_act α hact).1 * (Φ_RL α) (u_act α hact).1) *
              (ϖ_L (A α)).1 ^ k_pos α := by ring

    have hm_const : ∀ (α β : Fin N_cov) (hα : active α) (hβ : active β),
        m_act α hα = m_act β hβ := by
      intro α β hα hβ
      let p_ov : TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂) :=
        TensorProduct.tmul B₁ (1 : A₂ α β) π₂
      let Φ_ov : TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂) →ₐ[B₁]
          TensorProduct B₁ (A₂ α β) L₂ :=
        Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_R₂_L₂_alg
      have hInj_ov : Function.Injective Φ_ov :=
        hFlatInj (A₂ α β) (Localization.AtPrime m₂) L₂ ι_R₂_L₂_alg hInj_R₂_L₂
      have hp_ov_not_unit : ¬ IsUnit p_ov := by
        letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
        obtain ⟨e_ov⟩ := hQuotIso (A₂ α β)
        haveI : IsDomain (TensorProduct B₁ (A₂ α β) k) := hSpecFib.2.2 α β hα hβ
        haveI : IsDomain
            (TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂) ⧸ Ideal.span {p_ov}) :=
          e_ov.toMulEquiv.isDomain (TensorProduct B₁ (A₂ α β) k)
        have hp_pr : (Ideal.span {p_ov}).IsPrime :=
          (Ideal.Quotient.isDomain_iff_prime (Ideal.span {p_ov})).mp inferInstance
        intro hu
        exact hp_pr.ne_top (Ideal.span_singleton_eq_top.mpr hu)
      let ρL_R : TensorProduct B₁ (A α) (Localization.AtPrime m₂) →ₐ[B₁]
          TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂) :=
        Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ (Localization.AtPrime m₂))
      let ρR_R : TensorProduct B₁ (A β) (Localization.AtPrime m₂) →ₐ[B₁]
          TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂) :=
        Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ (Localization.AtPrime m₂))
      let ρL_L : TensorProduct B₁ (A α) L₂ →ₐ[B₁] TensorProduct B₁ (A₂ α β) L₂ :=
        Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ L₂)
      let ρR_L : TensorProduct B₁ (A β) L₂ →ₐ[B₁] TensorProduct B₁ (A₂ α β) L₂ :=
        Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ L₂)
      have hcomm_L : ∀ x : TensorProduct B₁ (A α) (Localization.AtPrime m₂),
          ρL_L (Φ_RL α x) = Φ_ov (ρL_R x) := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a r => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      have hcomm_R : ∀ x : TensorProduct B₁ (A β) (Localization.AtPrime m₂),
          ρR_L (Φ_RL β x) = Φ_ov (ρR_R x) := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a r => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      have hϖ_L : ∀ m : ℤ, ρL_L ((ϖ_L (A α)) ^ m).1 = ((ϖ_L (A₂ α β)) ^ m).1 := by
        intro m
        change (Units.map ρL_L.toRingHom.toMonoidHom (ϖ_L (A α) ^ m)).1 = _
        rw [map_zpow]
        have h_base : Units.map ρL_L.toRingHom.toMonoidHom (ϖ_L (A α)) = ϖ_L (A₂ α β) := by
          ext
          change TensorProduct.tmul B₁ ((ρL α β) 1) π_L = TensorProduct.tmul B₁ 1 π_L
          rw [map_one]
        rw [h_base]
      have hϖ_R : ∀ m : ℤ, ρR_L ((ϖ_L (A β)) ^ m).1 = ((ϖ_L (A₂ α β)) ^ m).1 := by
        intro m
        change (Units.map ρR_L.toRingHom.toMonoidHom (ϖ_L (A β) ^ m)).1 = _
        rw [map_zpow]
        have h_base : Units.map ρR_L.toRingHom.toMonoidHom (ϖ_L (A β)) = ϖ_L (A₂ α β) := by
          ext
          change TensorProduct.tmul B₁ ((ρR α β) 1) π_L = TensorProduct.tmul B₁ 1 π_L
          rw [map_one]
        rw [h_base]
      have hov_eq := hu_L₂_trans α β
      change (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂)) * ρR_L (u_L₂ β).1 =
        ρL_L (u_L₂ α).1 at hov_eq
      rw [hu_L₂_act α hα, hu_L₂_act β hβ, map_mul, map_mul, hϖ_L, hϖ_R, hcomm_L, hcomm_R] at hov_eq
      let g_ov_R : Units (TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂)) :=
        { val := TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : Localization.AtPrime m₂)
          inv := TensorProduct.tmul B₁ (((g₁ α β)⁻¹).1 ^ ℓ) (1 : Localization.AtPrime m₂)
          val_inv := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← mul_pow, Units.mul_inv, one_pow,
              Algebra.TensorProduct.one_def]
          inv_val := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← mul_pow, Units.inv_mul, one_pow,
              Algebra.TensorProduct.one_def] }
      let uL_ov : Units (TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂)) :=
        Units.map ρL_R.toRingHom.toMonoidHom (u_act α hα)
      let uR_ov : Units (TensorProduct B₁ (A₂ α β) (Localization.AtPrime m₂)) :=
        Units.map ρR_R.toRingHom.toMonoidHom (u_act β hβ)
      have hg_map : Φ_ov g_ov_R.1 = TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) := by
        change TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (ι_R₂_L₂ 1) = _
        rw [map_one]
      by_contra hne
      rcases lt_or_gt_of_ne hne with hlt | hgt
      · let d : ℕ := (m_act β hβ - m_act α hα).toNat
        have hd_pos : 1 ≤ d := by omega
        have hm_diff : m_act β hβ = m_act α hα + (d : ℤ) := by omega
        have h_canc : Φ_ov (g_ov_R.1 * uR_ov.1 * p_ov ^ d) = Φ_ov uL_ov.1 := by
          rw [map_mul, map_mul, map_pow]
          have hp_map : Φ_ov p_ov = (ϖ_L (A₂ α β)).1 := rfl
          rw [hp_map, hg_map]
          apply ((ϖ_L (A₂ α β)) ^ (m_act α hα)).isUnit.mul_right_inj.mp
          dsimp [uL_ov, uR_ov]
          rw [← hov_eq]
          have hzpow : ((ϖ_L (A₂ α β)) ^ (m_act α hα)).1 * ((ϖ_L (A₂ α β)).1 ^ d) =
              ((ϖ_L (A₂ α β)) ^ (m_act β hβ)).1 := by
            rw [← Units.val_pow_eq_pow_val, ← zpow_natCast, ← Units.val_mul, ← zpow_add, hm_diff]
          calc
            ((ϖ_L (A₂ α β)) ^ m_act α hα).1 *
                ((TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) *
                    Φ_ov (ρR_R (u_act β hβ).1)) *
                  (ϖ_L (A₂ α β)).1 ^ d)
              = TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) *
                  ((((ϖ_L (A₂ α β)) ^ m_act α hα).1 * (ϖ_L (A₂ α β)).1 ^ d) *
                    Φ_ov (ρR_R (u_act β hβ).1)) := by ring
            _ = TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) *
                  (((ϖ_L (A₂ α β)) ^ m_act β hβ).1 * Φ_ov (ρR_R (u_act β hβ).1)) := by
                  rw [hzpow]
        have h_eq_R : g_ov_R.1 * uR_ov.1 * p_ov ^ d = uL_ov.1 := hInj_ov h_canc
        have h_split : p_ov ^ d = p_ov * p_ov ^ (d - 1) := by
          have hd_eq : d = (d - 1) + 1 := (Nat.sub_add_cancel hd_pos).symm
          conv_lhs => rw [hd_eq, pow_succ']
        have hdvd_unit : p_ov ∣ uL_ov.1 :=
          ⟨p_ov ^ (d - 1) * (g_ov_R.1 * uR_ov.1), by rw [← h_eq_R, h_split]; ring⟩
        exact hp_ov_not_unit (isUnit_of_dvd_unit hdvd_unit uL_ov.isUnit)
      · let d : ℕ := (m_act α hα - m_act β hβ).toNat
        have hd_pos : 1 ≤ d := by omega
        have hm_diff : m_act α hα = m_act β hβ + (d : ℤ) := by omega
        have h_canc : Φ_ov (g_ov_R.1 * uR_ov.1) = Φ_ov (uL_ov.1 * p_ov ^ d) := by
          rw [map_mul, map_mul, map_pow]
          have hp_map : Φ_ov p_ov = (ϖ_L (A₂ α β)).1 := rfl
          rw [hp_map, hg_map]
          apply ((ϖ_L (A₂ α β)) ^ (m_act β hβ)).isUnit.mul_right_inj.mp
          have hzpow : ((ϖ_L (A₂ α β)) ^ (m_act β hβ)).1 * ((ϖ_L (A₂ α β)).1 ^ d) =
              ((ϖ_L (A₂ α β)) ^ (m_act α hα)).1 := by
            rw [← Units.val_pow_eq_pow_val, ← zpow_natCast, ← Units.val_mul, ← zpow_add, hm_diff]
          calc
            ((ϖ_L (A₂ α β)) ^ m_act β hβ).1 *
                (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) * Φ_ov uR_ov.1)
              = TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) *
                  (((ϖ_L (A₂ α β)) ^ m_act β hβ).1 * Φ_ov uR_ov.1) := by ring
            _ = ((ϖ_L (A₂ α β)) ^ m_act α hα).1 * Φ_ov uL_ov.1 := hov_eq
            _ = (((ϖ_L (A₂ α β)) ^ m_act β hβ).1 * (ϖ_L (A₂ α β)).1 ^ d) * Φ_ov uL_ov.1 := by
                  rw [hzpow]
            _ = ((ϖ_L (A₂ α β)) ^ m_act β hβ).1 * (Φ_ov uL_ov.1 * (ϖ_L (A₂ α β)).1 ^ d) := by ring
        have h_eq_R : g_ov_R.1 * uR_ov.1 = uL_ov.1 * p_ov ^ d := hInj_ov h_canc
        have h_split : p_ov ^ d = p_ov * p_ov ^ (d - 1) := by
          have hd_eq : d = (d - 1) + 1 := (Nat.sub_add_cancel hd_pos).symm
          conv_lhs => rw [hd_eq, pow_succ']
        have hdvd_unit : p_ov ∣ (g_ov_R * uR_ov).1 :=
          ⟨p_ov ^ (d - 1) * uL_ov.1, by rw [Units.val_mul, h_eq_R, h_split]; ring⟩
        exact hp_ov_not_unit (isUnit_of_dvd_unit hdvd_unit (g_ov_R * uR_ov).isUnit)

    obtain ⟨α₀, hα₀⟩ := hAct_ex
    let m₀ : ℤ := m_act α₀ hα₀
    let c_scale : Units Ω := (Units.mk0 π_Ω hπ_Ω_ne) ^ (-m₀)

    have hu_R₂_ex : ∀ α : Fin N_cov,
        ∃ u_r : Units (TensorProduct B₁ (A α) (Localization.AtPrime m₂)),
          Φ_RL α u_r.1 = ((ϖ_L (A α)) ^ (-m₀)).1 * (u_L₂ α).1 := by
      intro α
      by_cases hact : active α
      · refine ⟨u_act α hact, ?_⟩
        have hm_eq : m_act α hact = m₀ := hm_const α α₀ hact hα₀
        have h1 := hu_L₂_act α hact
        rw [hm_eq] at h1
        rw [h1, ← mul_assoc, ← Units.val_mul, ← zpow_add, neg_add_cancel, zpow_zero,
          Units.val_one, one_mul]
      · letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
        obtain ⟨e_q⟩ := hQuotIso (A α)
        haveI : Subsingleton (TensorProduct B₁ (A α) k) := hSpecFib.2.1 α hact
        haveI : Subsingleton
            (TensorProduct B₁ (A α) (Localization.AtPrime m₂) ⧸ Ideal.span {p_R α}) :=
          e_q.toEquiv.subsingleton
        have h1_mem : (1 : TensorProduct B₁ (A α) (Localization.AtPrime m₂)) ∈
            Ideal.span {p_R α} := by
          rw [← Ideal.Quotient.eq_zero_iff_mem]
          exact Subsingleton.elim _ _
        obtain ⟨q_inv, hq_inv⟩ := Ideal.mem_span_singleton.mp h1_mem
        let ϖ_R : Units (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) :=
          { val := p_R α
            inv := q_inv
            val_inv := hq_inv.symm
            inv_val := mul_comm (p_R α) q_inv ▸ hq_inv.symm }
        have hϖ_map : Units.map (Φ_RL α).toRingHom.toMonoidHom ϖ_R = ϖ_L (A α) := by
          ext
          rfl
        let u_p : TensorProduct B₁ (A α) (Localization.AtPrime m₂) :=
          (ϖ_R ^ (-m₀ - (k_pos α : ℤ))).1 * a_pos α
        let u_n : TensorProduct B₁ (A α) (Localization.AtPrime m₂) :=
          (ϖ_R ^ (m₀ - (l_neg α : ℤ))).1 * b_neg α
        have hmap_p : Φ_RL α u_p = ((ϖ_L (A α)) ^ (-m₀)).1 * (u_L₂ α).1 := by
          dsimp [u_p]
          rw [map_mul, ha_pos α]
          have h_pow : Φ_RL α (ϖ_R ^ (-m₀ - (k_pos α : ℤ))).1 =
              ((ϖ_L (A α)) ^ (-m₀ - (k_pos α : ℤ))).1 := by
            rw [← hϖ_map, ← map_zpow]
            rfl
          rw [h_pow, ← Units.val_pow_eq_pow_val, ← zpow_natCast]
          calc
            ((ϖ_L (A α)) ^ (-m₀ - (k_pos α : ℤ))).1 *
                ((u_L₂ α).1 * ((ϖ_L (A α)) ^ (k_pos α : ℤ)).1)
              = (((ϖ_L (A α)) ^ (-m₀ - (k_pos α : ℤ))).1 *
                  ((ϖ_L (A α)) ^ (k_pos α : ℤ)).1) * (u_L₂ α).1 := by ring
            _ = ((ϖ_L (A α)) ^ (-m₀)).1 * (u_L₂ α).1 := by
                  rw [← Units.val_mul, ← zpow_add, sub_add_cancel]
        have hmap_n : Φ_RL α u_n = ((ϖ_L (A α)) ^ m₀).1 * (u_L₂ α)⁻¹.1 := by
          dsimp [u_n]
          rw [map_mul, hb_neg α]
          have h_pow : Φ_RL α (ϖ_R ^ (m₀ - (l_neg α : ℤ))).1 =
              ((ϖ_L (A α)) ^ (m₀ - (l_neg α : ℤ))).1 := by
            rw [← hϖ_map, ← map_zpow]
            rfl
          rw [h_pow, ← Units.val_pow_eq_pow_val, ← zpow_natCast]
          calc
            ((ϖ_L (A α)) ^ (m₀ - (l_neg α : ℤ))).1 *
                ((u_L₂ α)⁻¹.1 * ((ϖ_L (A α)) ^ (l_neg α : ℤ)).1)
              = (((ϖ_L (A α)) ^ (m₀ - (l_neg α : ℤ))).1 *
                  ((ϖ_L (A α)) ^ (l_neg α : ℤ)).1) * (u_L₂ α)⁻¹.1 := by ring
            _ = ((ϖ_L (A α)) ^ m₀).1 * (u_L₂ α)⁻¹.1 := by
                  rw [← Units.val_mul, ← zpow_add, sub_add_cancel]
        have hmul_1 : u_p * u_n = 1 := by
          apply hInj_Φ_RL α
          rw [map_mul, map_one, hmap_p, hmap_n]
          calc
            (((ϖ_L (A α)) ^ (-m₀)).1 * (u_L₂ α).1) * (((ϖ_L (A α)) ^ m₀).1 * (u_L₂ α)⁻¹.1)
              = (((ϖ_L (A α)) ^ (-m₀)).1 * ((ϖ_L (A α)) ^ m₀).1) * ((u_L₂ α).1 * (u_L₂ α)⁻¹.1) := by
                  ring
            _ = 1 * 1 := by
                  rw [← Units.val_mul, ← zpow_add, neg_add_cancel, zpow_zero, Units.val_one,
                    Units.mul_inv]
            _ = 1 := one_mul 1
        exact ⟨⟨u_p, u_n, hmul_1, mul_comm u_n u_p ▸ hmul_1⟩, hmap_p⟩

    let u_R₂ : ∀ α : Fin N_cov, Units (TensorProduct B₁ (A α) (Localization.AtPrime m₂)) :=
      fun α => Classical.choose (hu_R₂_ex α)
    have hu_R₂_map : ∀ α : Fin N_cov,
        Φ_RL α (u_R₂ α).1 = ((ϖ_L (A α)) ^ (-m₀)).1 * (u_L₂ α).1 :=
      fun α => Classical.choose_spec (hu_R₂_ex α)

    have hClearM₂ : ∀ (M : Type u) [CommRing M] [Algebra B₁ M]
        (z : TensorProduct B₁ M (Localization.AtPrime m₂)),
        ∃ (d : m₂.primeCompl) (y : TensorProduct B₁ M B₂),
          Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_B₂_R₂_alg y =
            z * TensorProduct.tmul B₁ (1 : M) (algebraMap B₂ (Localization.AtPrime m₂) d.1) := by
      intro M _ _ z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨1, 0, by simp⟩
      | tmul m r =>
          obtain ⟨⟨x, d⟩, hxd⟩ := IsLocalization.surj m₂.primeCompl r
          refine ⟨d, TensorProduct.tmul B₁ m x, ?_⟩
          change TensorProduct.tmul B₁ m (algebraMap B₂ (Localization.AtPrime m₂) x) = _
          rw [← hxd, Algebra.TensorProduct.tmul_mul_tmul, mul_one]
      | add x y hx hy =>
          obtain ⟨dx, yx, hyx⟩ := hx
          obtain ⟨dy, yy, hyy⟩ := hy
          refine ⟨dx * dy,
            yx * TensorProduct.tmul B₁ (1 : M) dy.1 + yy * TensorProduct.tmul B₁ (1 : M) dx.1, ?_⟩
          simp only [map_add, map_mul, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
          change (Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_B₂_R₂_alg yx) *
              TensorProduct.tmul B₁ (1 : M) (algebraMap B₂ (Localization.AtPrime m₂) dy.1) +
            (Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_B₂_R₂_alg yy) *
              TensorProduct.tmul B₁ (1 : M) (algebraMap B₂ (Localization.AtPrime m₂) dx.1) = _
          rw [hyx, hyy, add_mul, mul_assoc, mul_assoc]
          congr 1
          · simp [Algebra.TensorProduct.tmul_mul_tmul, map_mul]
          · rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, Submonoid.coe_mul, map_mul,
              mul_comm (algebraMap B₂ (Localization.AtPrime m₂) dx.1)]

    let d_pos : Fin N_cov → m₂.primeCompl := fun α => Classical.choose (hClearM₂ (A α) (u_R₂ α).1)
    let y_pos : ∀ α : Fin N_cov, TensorProduct B₁ (A α) B₂ :=
      fun α => Classical.choose (Classical.choose_spec (hClearM₂ (A α) (u_R₂ α).1))
    have hy_pos : ∀ α : Fin N_cov,
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_B₂_R₂_alg (y_pos α) =
          (u_R₂ α).1 *
            TensorProduct.tmul B₁ (1 : A α) (algebraMap B₂ (Localization.AtPrime m₂) (d_pos α).1) :=
      fun α => Classical.choose_spec (Classical.choose_spec (hClearM₂ (A α) (u_R₂ α).1))

    let d_neg : Fin N_cov → m₂.primeCompl := fun α => Classical.choose (hClearM₂ (A α) (u_R₂ α)⁻¹.1)
    let y_neg : ∀ α : Fin N_cov, TensorProduct B₁ (A α) B₂ :=
      fun α => Classical.choose (Classical.choose_spec (hClearM₂ (A α) (u_R₂ α)⁻¹.1))
    have hy_neg : ∀ α : Fin N_cov,
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_B₂_R₂_alg (y_neg α) =
          (u_R₂ α)⁻¹.1 *
            TensorProduct.tmul B₁ (1 : A α) (algebraMap B₂ (Localization.AtPrime m₂) (d_neg α).1) :=
      fun α => Classical.choose_spec (Classical.choose_spec (hClearM₂ (A α) (u_R₂ α)⁻¹.1))

    let s'_sub : m₂.primeCompl := Finset.univ.prod (fun α : Fin N_cov => d_pos α * d_neg α)
    let s' : B₂ := s'_sub.1
    have hs'_ne : s' ≠ 0 := fun h0 => s'_sub.2 (by change s' ∈ m₂; rw [h0]; exact m₂.zero_mem)
    have hs'_powers_nzd : Submonoid.powers s' ≤ nonZeroDivisors B₂ := by
      rintro _ ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hs'_ne)

    haveI : IsDomain (Localization.Away s') :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away s') hs'_powers_nzd
    haveI : Algebra.FiniteType k (Localization.Away s') :=
      Algebra.FiniteType.trans (inferInstance : Algebra.FiniteType k B₂)
        (inferInstance : Algebra.FiniteType B₂ (Localization.Away s'))
    haveI : IsDedekindDomain (Localization.Away s') :=
      IsLocalization.isDedekindDomain B₂ hs'_powers_nzd (Localization.Away s')
    let ψ_sp : B₁ →ₐ[k] Localization.Away s' :=
      (IsScalarTower.toAlgHom k B₂ (Localization.Away s')).comp ψ₁₂
    have halg_sp : algebraMap B₁ (Localization.Away s') = ψ_sp.toRingHom :=
      IsScalarTower.algebraMap_eq B₁ B₂ (Localization.Away s')

    have hs'_unit_k : IsUnit (τ₂.toRingHom s') := hUnits_m₂_k s'_sub
    let τ_sp_ring : Localization.Away s' →+* k := IsLocalization.Away.lift s' hs'_unit_k
    have hτ_sp_B₂ : τ_sp_ring.comp (algebraMap B₂ (Localization.Away s')) = τ₂.toRingHom :=
      IsLocalization.lift_comp _
    let τ_sp : Localization.Away s' →ₐ[k] k :=
      { toRingHom := τ_sp_ring
        commutes' := fun c => by
          rw [IsScalarTower.algebraMap_apply k B₂ (Localization.Away s')]
          change (τ_sp_ring.comp (algebraMap B₂ (Localization.Away s'))) (algebraMap k B₂ c) = c
          rw [hτ_sp_B₂]
          exact τ₂.commutes c }
    have hτ_sp_comp : τ_sp.comp ψ_sp = τ_B₁ := by
      ext b
      change (τ_sp_ring.comp (algebraMap B₂ (Localization.Away s'))) (ψ₁₂ b) = τ_B₁ b
      rw [hτ_sp_B₂]
      exact AlgHom.congr_fun hτ₂ b

    have hs'_unit_R₂ : IsUnit (algebraMap B₂ (Localization.AtPrime m₂) s') :=
      IsLocalization.map_units (Localization.AtPrime m₂) s'_sub
    let ϕ_sp_R₂ : Localization.Away s' →+* Localization.AtPrime m₂ :=
      IsLocalization.Away.lift s' hs'_unit_R₂
    have hϕ_sp_B₂ :
        ϕ_sp_R₂.comp (algebraMap B₂ (Localization.Away s')) =
          algebraMap B₂ (Localization.AtPrime m₂) :=
      IsLocalization.lift_comp _
    have hInj_B₂_R₂ : Function.Injective (algebraMap B₂ (Localization.AtPrime m₂)) := by
      intro x y hxy
      apply hInj_B₂_L₂
      rw [← RingHom.congr_fun hR₂_L₂_comp x, ← RingHom.congr_fun hR₂_L₂_comp y]
      exact congrArg ι_R₂_L₂ hxy
    have hInj_ϕ_sp_R₂ : Function.Injective ϕ_sp_R₂ := by
      rw [RingHom.injective_iff_ker_eq_bot, Submodule.eq_bot_iff]
      intro z hz
      rw [RingHom.mem_ker] at hz
      obtain ⟨⟨a, ⟨_, ⟨n, rfl⟩⟩⟩, han⟩ := IsLocalization.surj (Submonoid.powers s') z
      have ha0 : algebraMap B₂ (Localization.AtPrime m₂) a = 0 := by
        have h1 := congrArg ϕ_sp_R₂ han
        rw [map_mul, hz, zero_mul] at h1
        exact (RingHom.congr_fun hϕ_sp_B₂ a).symm.trans h1.symm
      have ha_eq0 : a = 0 := hInj_B₂_R₂ (ha0.trans (map_zero _).symm)
      rw [ha_eq0, map_zero] at han
      have hpow_unit : IsUnit ((algebraMap B₂ (Localization.Away s') s') ^ n) :=
        (IsLocalization.Away.algebraMap_isUnit s').pow n
      change z * algebraMap B₂ (Localization.Away s') (s' ^ n) = 0 at han
      rw [map_pow] at han
      exact hpow_unit.mul_left_eq_zero.mp han

    let ι_sp_Ω : Localization.Away s' →+* Ω := (ι_L₂_Ω.comp ι_R₂_L₂).comp ϕ_sp_R₂
    have hInj_sp_Ω : Function.Injective ι_sp_Ω :=
      (hInj_L₂_Ω.comp hInj_R₂_L₂).comp hInj_ϕ_sp_R₂
    have hι_sp_eq : ι_sp_Ω.comp (algebraMap B₁ (Localization.Away s')) = ι_B₁_Ω := by
      rw [halg_sp]
      ext b
      change ι_L₂_Ω (ι_R₂_L₂ ((ϕ_sp_R₂.comp (algebraMap B₂ (Localization.Away s'))) (ψ₁₂ b))) =
        ι_B₁_Ω b
      rw [hϕ_sp_B₂]
      change ι_L₂_Ω ((ι_R₂_L₂.comp (algebraMap B₂ (Localization.AtPrime m₂))) (ψ₁₂ b)) = ι_B₁_Ω b
      rw [hR₂_L₂_comp]
      exact RingHom.congr_fun hB₁_Ω_eq b

    let ϕ_sp_R₂_alg : Localization.Away s' →ₐ[B₁] Localization.AtPrime m₂ :=
      { toRingHom := ϕ_sp_R₂
        commutes' := fun b => by
          rw [IsScalarTower.algebraMap_apply B₁ B₂ (Localization.Away s'),
            IsScalarTower.algebraMap_apply B₁ B₂ (Localization.AtPrime m₂)]
          exact RingHom.congr_fun hϕ_sp_B₂ (ψ₁₂ b) }
    let ι_B₂_sp_alg : B₂ →ₐ[B₁] Localization.Away s' :=
      IsScalarTower.toAlgHom B₁ B₂ (Localization.Away s')
    let ι_sp_Ω_alg : Localization.Away s' →ₐ[B₁] Ω :=
      { toRingHom := ι_sp_Ω
        commutes' := fun b => RingHom.congr_fun hι_sp_eq b }

    have hu_sp_ex : ∀ α : Fin N_cov,
        ∃ u_s : Units (TensorProduct B₁ (A α) (Localization.Away s')),
          Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ϕ_sp_R₂_alg u_s.1 = (u_R₂ α).1 := by
      intro α
      have hd_pos_dvd : (d_pos α).1 ∣ s' := by
        have hmem : α ∈ (Finset.univ : Finset (Fin N_cov)) := Finset.mem_univ α
        have hprod : (d_pos α * d_neg α).1 ∣ s' := by
          change (d_pos α * d_neg α).1 ∣ (Finset.univ.prod fun β => d_pos β * d_neg β).1
          rw [Submonoid.coe_finset_prod]
          exact Finset.dvd_prod_of_mem (fun β => (d_pos β * d_neg β).1) hmem
        exact dvd_trans (dvd_mul_right _ _) hprod
      have hd_neg_dvd : (d_neg α).1 ∣ s' := by
        have hmem : α ∈ (Finset.univ : Finset (Fin N_cov)) := Finset.mem_univ α
        have hprod : (d_pos α * d_neg α).1 ∣ s' := by
          change (d_pos α * d_neg α).1 ∣ (Finset.univ.prod fun β => d_pos β * d_neg β).1
          rw [Submonoid.coe_finset_prod]
          exact Finset.dvd_prod_of_mem (fun β => (d_pos β * d_neg β).1) hmem
        exact dvd_trans (dvd_mul_left _ _) hprod
      have hu_d_pos : IsUnit (algebraMap B₂ (Localization.Away s') (d_pos α).1) :=
        isUnit_of_dvd_unit (map_dvd (algebraMap B₂ (Localization.Away s')) hd_pos_dvd)
          (IsLocalization.Away.algebraMap_isUnit s')
      have hu_d_neg : IsUnit (algebraMap B₂ (Localization.Away s') (d_neg α).1) :=
        isUnit_of_dvd_unit (map_dvd (algebraMap B₂ (Localization.Away s')) hd_neg_dvd)
          (IsLocalization.Away.algebraMap_isUnit s')
      let ud_pos : Units (Localization.Away s') := hu_d_pos.unit
      let ud_neg : Units (Localization.Away s') := hu_d_neg.unit
      let u_sp_p : TensorProduct B₁ (A α) (Localization.Away s') :=
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_B₂_sp_alg (y_pos α) *
          TensorProduct.tmul B₁ (1 : A α) (ud_pos⁻¹).1
      let u_sp_n : TensorProduct B₁ (A α) (Localization.Away s') :=
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_B₂_sp_alg (y_neg α) *
          TensorProduct.tmul B₁ (1 : A α) (ud_neg⁻¹).1
      let Φ_sp_R : TensorProduct B₁ (A α) (Localization.Away s') →ₐ[B₁]
          TensorProduct B₁ (A α) (Localization.AtPrime m₂) :=
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ϕ_sp_R₂_alg
      have hInj_sp_R : Function.Injective Φ_sp_R :=
        hFlatInj (A α) (Localization.Away s') (Localization.AtPrime m₂) ϕ_sp_R₂_alg hInj_ϕ_sp_R₂
      have hcomp_B₂_R : ∀ z : TensorProduct B₁ (A α) B₂,
          Φ_sp_R (Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_B₂_sp_alg z) =
            Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_B₂_R₂_alg z := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a b₂ =>
            change TensorProduct.tmul B₁ a (ϕ_sp_R₂ (algebraMap B₂ (Localization.Away s') b₂)) =
              TensorProduct.tmul B₁ a (algebraMap B₂ (Localization.AtPrime m₂) b₂)
            congr 1
            exact RingHom.congr_fun hϕ_sp_B₂ b₂
        | add x y hx hy => simp [map_add, hx, hy]
      have hmap_p : Φ_sp_R u_sp_p = (u_R₂ α).1 := by
        dsimp [u_sp_p]
        rw [map_mul, hcomp_B₂_R, hy_pos α, mul_assoc]
        have h_inv :
            TensorProduct.tmul B₁ (1 : A α) (algebraMap B₂ (Localization.AtPrime m₂) (d_pos α).1) *
              Φ_sp_R (TensorProduct.tmul B₁ (1 : A α) (ud_pos⁻¹).1) = 1 := by
          change
            TensorProduct.tmul B₁ (1 : A α) (algebraMap B₂ (Localization.AtPrime m₂) (d_pos α).1) *
              TensorProduct.tmul B₁ (1 : A α) (ϕ_sp_R₂ (ud_pos⁻¹).1) = 1
          have hd_eq : algebraMap B₂ (Localization.AtPrime m₂) (d_pos α).1 = ϕ_sp_R₂ ud_pos.1 :=
            (RingHom.congr_fun hϕ_sp_B₂ (d_pos α).1).symm
          rw [hd_eq, Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul,
            Units.mul_inv, map_one, Algebra.TensorProduct.one_def]
        rw [h_inv, mul_one]
      have hmap_n : Φ_sp_R u_sp_n = (u_R₂ α)⁻¹.1 := by
        dsimp [u_sp_n]
        rw [map_mul, hcomp_B₂_R, hy_neg α, mul_assoc]
        have h_inv :
            TensorProduct.tmul B₁ (1 : A α) (algebraMap B₂ (Localization.AtPrime m₂) (d_neg α).1) *
              Φ_sp_R (TensorProduct.tmul B₁ (1 : A α) (ud_neg⁻¹).1) = 1 := by
          change
            TensorProduct.tmul B₁ (1 : A α) (algebraMap B₂ (Localization.AtPrime m₂) (d_neg α).1) *
              TensorProduct.tmul B₁ (1 : A α) (ϕ_sp_R₂ (ud_neg⁻¹).1) = 1
          have hd_eq : algebraMap B₂ (Localization.AtPrime m₂) (d_neg α).1 = ϕ_sp_R₂ ud_neg.1 :=
            (RingHom.congr_fun hϕ_sp_B₂ (d_neg α).1).symm
          rw [hd_eq, Algebra.TensorProduct.tmul_mul_tmul, mul_one, ← map_mul,
            Units.mul_inv, map_one, Algebra.TensorProduct.one_def]
        rw [h_inv, mul_one]
      have hmul_1 : u_sp_p * u_sp_n = 1 := by
        apply hInj_sp_R
        rw [map_mul, map_one, hmap_p, hmap_n, Units.mul_inv]
      exact ⟨⟨u_sp_p, u_sp_n, hmul_1, mul_comm u_sp_n u_sp_p ▸ hmul_1⟩, hmap_p⟩

    let u_sp : ∀ α : Fin N_cov, Units (TensorProduct B₁ (A α) (Localization.Away s')) :=
      fun α => Classical.choose (hu_sp_ex α)
    have hu_sp_R₂ : ∀ α : Fin N_cov,
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ϕ_sp_R₂_alg (u_sp α).1 = (u_R₂ α).1 :=
      fun α => Classical.choose_spec (hu_sp_ex α)

    have hu_sp_Ω : ∀ α : Fin N_cov,
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_sp_Ω_alg (u_sp α).1 =
          TensorProduct.tmul B₁ (1 : A α) c_scale.1 *
            Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_L₂_Ω_alg (u_L₂ α).1 := by
      intro α
      have h_fac : ∀ z : TensorProduct B₁ (A α) (Localization.Away s'),
          Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_sp_Ω_alg z =
            Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_L₂_Ω_alg
              (Φ_RL α (Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ϕ_sp_R₂_alg z)) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      rw [h_fac, hu_sp_R₂ α, hu_R₂_map α, map_mul]
      congr 1
      let c_L : Units L₂ := Units.mk0 π_L hπ_L_ne
      have hϖ_zpow : ((ϖ_L (A α)) ^ (-m₀)).1 = TensorProduct.tmul B₁ (1 : A α) ((c_L ^ (-m₀)).1) := by
        have h_hom : (ϖ_L (A α)) =
            Units.map (Algebra.TensorProduct.includeRight (R := B₁) (A := A α) (B := L₂)).toRingHom.toMonoidHom c_L := by
          ext; rfl
        rw [h_hom, ← map_zpow]
        rfl
      rw [hϖ_zpow]
      change TensorProduct.tmul B₁ (1 : A α) (ι_L₂_Ω (c_L ^ (-m₀)).1) =
        TensorProduct.tmul B₁ (1 : A α) c_scale.1
      congr 1
      have hc_map : Units.map ι_L₂_Ω.toMonoidHom c_L = Units.mk0 π_Ω hπ_Ω_ne := by
        ext; rfl
      change (Units.map ι_L₂_Ω.toMonoidHom (c_L ^ (-m₀))).1 = _
      rw [map_zpow, hc_map]

    have hu_sp_trans : ∀ α β : Fin N_cov,
        TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : Localization.Away s') *
          Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ (Localization.Away s')) (u_sp β).1 =
        Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ (Localization.Away s')) (u_sp α).1 := by
      intro α β
      let Φ_ov_Ω : TensorProduct B₁ (A₂ α β) (Localization.Away s') →ₐ[B₁]
          TensorProduct B₁ (A₂ α β) Ω :=
        Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_sp_Ω_alg
      apply hFlatInj (A₂ α β) (Localization.Away s') Ω ι_sp_Ω_alg hInj_sp_Ω
      change Φ_ov_Ω _ = Φ_ov_Ω _
      have hcomm_sp_L : ∀ z : TensorProduct B₁ (A α) (Localization.Away s'),
          Φ_ov_Ω (Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ (Localization.Away s')) z) =
            Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ Ω)
              (Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_sp_Ω_alg z) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      have hcomm_sp_R : ∀ z : TensorProduct B₁ (A β) (Localization.Away s'),
          Φ_ov_Ω (Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ (Localization.Away s')) z) =
            Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ Ω)
              (Algebra.TensorProduct.map (AlgHom.id B₁ (A β)) ι_sp_Ω_alg z) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      have hcomm_L₂_L : ∀ z : TensorProduct B₁ (A α) L₂,
          Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ Ω)
            (Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_L₂_Ω_alg z) =
          Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
            (Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ L₂) z) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      have hcomm_L₂_R : ∀ z : TensorProduct B₁ (A β) L₂,
          Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ Ω)
            (Algebra.TensorProduct.map (AlgHom.id B₁ (A β)) ι_L₂_Ω_alg z) =
          Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
            (Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ L₂) z) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => rfl
        | add x y hx hy => simp [map_add, hx, hy]
      rw [map_mul, hcomm_sp_R, hcomm_sp_L, hu_sp_Ω α, hu_sp_Ω β, map_mul, map_mul,
        hcomm_L₂_L, hcomm_L₂_R]
      have hg_tmul : Φ_ov_Ω (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : Localization.Away s')) =
          Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
            (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂)) := by
        change TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (ι_sp_Ω 1) =
          TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (ι_L₂_Ω 1)
        rw [map_one, map_one]
      have hc_L : Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ Ω)
          (TensorProduct.tmul B₁ (1 : A α) c_scale.1) =
          TensorProduct.tmul B₁ (1 : A₂ α β) c_scale.1 := by
        change TensorProduct.tmul B₁ ((ρL α β) 1) c_scale.1 = _
        rw [map_one]
      have hc_R : Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ Ω)
          (TensorProduct.tmul B₁ (1 : A β) c_scale.1) =
          TensorProduct.tmul B₁ (1 : A₂ α β) c_scale.1 := by
        change TensorProduct.tmul B₁ ((ρR α β) 1) c_scale.1 = _
        rw [map_one]
      rw [hg_tmul, hc_L, hc_R]
      calc
        (Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
            (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂))) *
            (TensorProduct.tmul B₁ (1 : A₂ α β) c_scale.1 *
              Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
                (Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ L₂) (u_L₂ β).1))
          = TensorProduct.tmul B₁ (1 : A₂ α β) c_scale.1 *
              Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
                (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) *
                  Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ L₂) (u_L₂ β).1) := by
              rw [map_mul]
              ring
        _ = TensorProduct.tmul B₁ (1 : A₂ α β) c_scale.1 *
              Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
                (Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ L₂) (u_L₂ α).1) := by
              rw [hu_L₂_trans α β]

    exact ⟨Localization.Away s', inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, ψ_sp, τ_sp, ι_sp_Ω, hInj_sp_Ω, c_scale, halg_sp, hτ_sp_comp,
      hι_sp_eq, u_sp, hu_sp_trans, hu_sp_Ω⟩

  have hSep_Spec : IsSeparated (Limits.terminal.from (Spec (CommRingCat.of B₁))) :=
    (Scheme.isSeparated_iff (Spec (CommRingCat.of B₁))).mp inferInstance
  have hSep_YB₁ : Y_B₁.IsSeparated := by
    rw [Scheme.isSeparated_iff]
    have h_term : Limits.terminal.from Y_B₁ =
        f_B₁ ≫ Limits.terminal.from (Spec (CommRingCat.of B₁)) :=
      Limits.terminal.hom_ext _ _
    rw [h_term]
    infer_instance
  letI : Y_B₁.IsSeparated := hSep_YB₁
  have hW₁_inf_aff : ∀ α β : Fin N_cov, IsAffineOpen (W₁ α ⊓ W₁ β) :=
    fun α β => (hW₁_aff α).inf (hW₁_aff β)

  have hFlat_fB₁ : Flat f_B₁ := by
    have hHoldsAway : RingHom.HoldsForLocalizationAway
        (fun {R S} [CommRing R] [CommRing S] => RingHom.Flat) := by
      intro R S _ _ _ r _
      exact (RingHom.flat_algebraMap_iff).mpr (IsLocalization.flat S (Submonoid.powers r))
    have hLocAway : RingHom.StableUnderCompositionWithLocalizationAwaySource
        (fun {R S} [CommRing R] [CommRing S] => RingHom.Flat) :=
      (RingHom.Flat.stableUnderComposition.stableUnderCompositionWithLocalizationAway hHoldsAway).1
    rw [HasRingHomProperty.iff_exists_appLE (P := @Flat) hLocAway]
    intro x
    obtain ⟨U, hAff_U, V, hAff_V, hx, e, hstd⟩ :=
      (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 f_B₁).mp inferInstance x
    refine ⟨⟨U, hAff_U⟩, ⟨V, hAff_V⟩, hx, e, ?_⟩
    obtain ⟨g_et, hg_comp, hg_et⟩ := hstd.exists_etale_mvPolynomial
    have hC_flat : (MvPolynomial.C :
        ↑((Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op U)) →+*
        MvPolynomial (Fin 1) ↑((Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op U))).Flat :=
      (RingHom.flat_algebraMap_iff).mpr inferInstance
    have hget_flat : g_et.Flat := by
      letI : Algebra (MvPolynomial (Fin 1) ↑((Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op U)))
          ↑(Y_B₁.presheaf.obj (Opposite.op V)) := g_et.toAlgebra
      haveI : Algebra.Etale
          (MvPolynomial (Fin 1) ↑((Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op U)))
          ↑(Y_B₁.presheaf.obj (Opposite.op V)) := hg_et.toAlgebra
      exact (RingHom.flat_algebraMap_iff).mpr inferInstance
    have hcomp := RingHom.Flat.stableUnderComposition _ _ hC_flat hget_flat
    rwa [hg_comp] at hcomp
  haveI : Flat f_B₁ := hFlat_fB₁

  let algOpen : ∀ U : Y_B₁.Opens, Algebra B₁ ↑(Y_B₁.presheaf.obj (Opposite.op U)) :=
    fun U => ((Scheme.ΓSpecIso (CommRingCat.of B₁)).inv ≫
      f_B₁.appLE ⊤ U (fun _ _ => trivial)).hom.toAlgebra
  have hFlatOpen : ∀ (U : Y_B₁.Opens) (hU : IsAffineOpen U),
      @Module.Flat B₁ ↑(Y_B₁.presheaf.obj (Opposite.op U)) _ _ (algOpen U).toModule := by
    intro U hU
    letI : Algebra B₁ ↑(Y_B₁.presheaf.obj (Opposite.op U)) := algOpen U
    have hf_flat : (f_B₁.appLE ⊤ U (fun _ _ => trivial)).hom.Flat :=
      f_B₁.flat_appLE (isAffineOpen_top _) hU (fun _ _ => trivial)
    let R_top := (Spec (CommRingCat.of B₁)).presheaf.obj (Opposite.op ⊤)
    let e_top : B₁ ≃+* ↑R_top :=
      { (Scheme.ΓSpecIso (CommRingCat.of B₁)).inv.hom with
        invFun := (Scheme.ΓSpecIso (CommRingCat.of B₁)).hom.hom
        left_inv := fun x =>
          ConcreteCategory.congr_hom (Scheme.ΓSpecIso (CommRingCat.of B₁)).inv_hom_id x
        right_inv := fun x =>
          ConcreteCategory.congr_hom (Scheme.ΓSpecIso (CommRingCat.of B₁)).hom_inv_id x }
    have he_flat : e_top.toRingHom.Flat := RingHom.Flat.of_bijective e_top.bijective
    have hcomp_flat : ((f_B₁.appLE ⊤ U (fun _ _ => trivial)).hom.comp e_top.toRingHom).Flat :=
      RingHom.Flat.comp he_flat hf_flat
    exact (RingHom.flat_algebraMap_iff).mp hcomp_flat

  let A : Fin N_cov → Type u := fun α => ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α)))
  let A₂ : Fin N_cov → Fin N_cov → Type u :=
    fun α β => ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α ⊓ W₁ β)))
  letI : ∀ α : Fin N_cov, Algebra B₁ (A α) := fun α => algOpen (W₁ α)
  letI : ∀ α β : Fin N_cov, Algebra B₁ (A₂ α β) := fun α β => algOpen (W₁ α ⊓ W₁ β)
  haveI : ∀ α : Fin N_cov, Module.Flat B₁ (A α) := fun α => hFlatOpen (W₁ α) (hW₁_aff α)
  haveI : ∀ α β : Fin N_cov, Module.Flat B₁ (A₂ α β) :=
    fun α β => hFlatOpen (W₁ α ⊓ W₁ β) (hW₁_inf_aff α β)

  let ρL : ∀ α β : Fin N_cov, A α →ₐ[B₁] A₂ α β := fun α β =>
    { toRingHom := (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
      commutes' := fun b =>
        ConcreteCategory.congr_hom
          ((Category.assoc _ _ _).trans
            (congrArg ((Scheme.ΓSpecIso (CommRingCat.of B₁)).inv ≫ ·)
              (f_B₁.appLE_map (U := ⊤) (fun _ _ => trivial)
                (CategoryTheory.homOfLE inf_le_left).op))) b }
  let ρR : ∀ α β : Fin N_cov, A β →ₐ[B₁] A₂ α β := fun α β =>
    { toRingHom := (Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
      commutes' := fun b =>
        ConcreteCategory.congr_hom
          ((Category.assoc _ _ _).trans
            (congrArg ((Scheme.ΓSpecIso (CommRingCat.of B₁)).inv ≫ ·)
              (f_B₁.appLE_map (U := ⊤) (fun _ _ => trivial)
                (CategoryTheory.homOfLE inf_le_right).op))) b }

  have hResCompat : ∀ (B' : Type u) [CommRing B'] [Algebra B₁ B']
      (Y' : Scheme.{u}) (f' : Y' ⟶ Spec (CommRingCat.of B')) (q : Y' ⟶ Y_B₁)
      {U₁ U₂ : Y_B₁.Opens} (hle : U₂ ≤ U₁)
      (e₁ : TensorProduct B₁ ↑(Y_B₁.presheaf.obj (Opposite.op U₁)) B' ≃+*
        ↑(Y'.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map q.base).obj U₁))))
      (he₁ : ∀ a b', e₁ (TensorProduct.tmul B₁ a b') =
        (q.app U₁).hom a *
          ((Scheme.ΓSpecIso (CommRingCat.of B')).inv ≫
            f'.appLE ⊤ ((TopologicalSpace.Opens.map q.base).obj U₁) (fun _ _ => trivial)).hom b')
      (e₂ : TensorProduct B₁ ↑(Y_B₁.presheaf.obj (Opposite.op U₂)) B' ≃+*
        ↑(Y'.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map q.base).obj U₂))))
      (he₂ : ∀ a b', e₂ (TensorProduct.tmul B₁ a b') =
        (q.app U₂).hom a *
          ((Scheme.ΓSpecIso (CommRingCat.of B')).inv ≫
            f'.appLE ⊤ ((TopologicalSpace.Opens.map q.base).obj U₂) (fun _ _ => trivial)).hom b')
      (ρ_alg : (letI := algOpen U₁; letI := algOpen U₂;
        ↑(Y_B₁.presheaf.obj (Opposite.op U₁)) →ₐ[B₁] ↑(Y_B₁.presheaf.obj (Opposite.op U₂))))
      (hρ : ∀ a, ρ_alg a = (Y_B₁.presheaf.map (CategoryTheory.homOfLE hle).op).hom a)
      (z : @TensorProduct B₁ _ ↑(Y_B₁.presheaf.obj (Opposite.op U₁)) B' _ _
        (algOpen U₁).toModule _),
      (Y'.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => hle hx :
          (TopologicalSpace.Opens.map q.base).obj U₂ ≤
            (TopologicalSpace.Opens.map q.base).obj U₁)).op).hom (e₁ z) =
      e₂ (letI := algOpen U₁; letI := algOpen U₂;
        Algebra.TensorProduct.map ρ_alg (AlgHom.id B₁ B') z) := by
    intro B' _ _ Y' f' q U₁ U₂ hle e₁ he₁ e₂ he₂ ρ_alg hρ z
    letI : Algebra B₁ ↑(Y_B₁.presheaf.obj (Opposite.op U₁)) := algOpen U₁
    letI : Algebra B₁ ↑(Y_B₁.presheaf.obj (Opposite.op U₂)) := algOpen U₂
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a b' =>
        rw [he₁ a b', map_mul]
        change (q.app U₁ ≫ Y'.presheaf.map _).hom a *
          (((Scheme.ΓSpecIso (CommRingCat.of B')).inv ≫ f'.appLE ⊤ _ _) ≫
            Y'.presheaf.map _).hom b' =
          e₂ (TensorProduct.tmul B₁ (ρ_alg a) b')
        rw [he₂ (ρ_alg a) b', hρ a]
        congr 1
        · exact ConcreteCategory.congr_hom (q.naturality (CategoryTheory.homOfLE hle).op).symm a
        · exact ConcreteCategory.congr_hom
            ((Category.assoc _ _ _).trans
              (congrArg ((Scheme.ΓSpecIso (CommRingCat.of B')).inv ≫ ·)
                (f'.appLE_map (U := ⊤) (fun _ _ => trivial) _))) b'
    | add x y hx hy => simp [map_add, hx, hy]

  let V : Fin N_cov → Y_η.Opens := fun α => (TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α)
  let W₀ : Fin N_cov → C₀.left.Opens :=
