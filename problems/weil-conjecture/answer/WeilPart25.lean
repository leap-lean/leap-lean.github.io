        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L₁ (B_h.obj U₁))) :=
      (E_left U₁ (L₁ (B_h.obj U₁))).apply_symm_apply _
    have hLHS : E_left U₂ (L₁ (B_h.obj U₁))
        (pb_h.map (weilEtaleLocalTorsionMap Z₂ ℓ u) ≫ (e_loc U₁).hom) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L₁ (B_h.obj U₁))) ≫
          (L₁ (B_h.obj U₁)).obj.map (Opposite.op (B_h.map u)) := by
      change CategoryTheory.Sheaf.freeYonedaHomEquiv
          ((adj_h.homEquiv (L₂ U₂) (L₁ (B_h.obj U₁)))
            (pb_h.map (weilEtaleLocalTorsionMap Z₂ ℓ u) ≫ (e_loc U₁).hom)) = _
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left adj_h
        (weilEtaleLocalTorsionMap Z₂ ℓ u) (e_loc U₁).hom]
      change CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap Z₂ ℓ u ≫ θ) = _
      rw [hEquiv_comp (weilEtaleLocalTorsionMap Z₂ ℓ u) θ]
      have hmap₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionMap Z₂ ℓ u) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L₂ U₁)) ≫
            (L₂ U₁).obj.map (Opposite.op u) :=
        Equiv.apply_symm_apply _ _
      rw [hmap₂, CategoryTheory.Category.assoc, θ.hom.naturality (Opposite.op u),
        ← CategoryTheory.Category.assoc, ← hEquiv_comp (𝟙 (L₂ U₁)) θ,
        CategoryTheory.Category.id_comp, hθ]
      rfl
    have hRHS : E_left U₂ (L₁ (B_h.obj U₁))
        ((e_loc U₂).hom ≫ weilEtaleLocalTorsionMap Z₁ ℓ (B_h.map u)) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L₁ (B_h.obj U₁))) ≫
          (L₁ (B_h.obj U₁)).obj.map (Opposite.op (B_h.map u)) := by
      rw [hE_left_comp (e_loc U₂).hom (weilEtaleLocalTorsionMap Z₁ ℓ (B_h.map u)),
        (E_left U₂ (L₁ (B_h.obj U₂))).apply_symm_apply]
      change CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L₁ (B_h.obj U₂))) ≫
          (weilEtaleLocalTorsionMap Z₁ ℓ (B_h.map u)).hom.app (Opposite.op (B_h.obj U₂)) = _
      rw [← hEquiv_comp (𝟙 (L₁ (B_h.obj U₂))) (weilEtaleLocalTorsionMap Z₁ ℓ (B_h.map u)),
        CategoryTheory.Category.id_comp]
      exact Equiv.apply_symm_apply _ _
    exact hLHS.trans hRHS.symm

theorem weil_etale_disjoint_closedImmersion_openCompl_shortExact {Y₀ B₀ : AlgebraicGeometry.Scheme.{u}}
    (n m : ℕ)
    (τ : Fin m → Quiver.Hom B₀ Y₀)
    (hτ_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ a))
    (hτ_disj : _root_.Pairwise fun a b : Fin m =>
      Disjoint (Set.range (τ a).base) (Set.range (τ b).base))
    (W_open : Y₀.Opens)
    (hW_compl : (W_open : Set ↥Y₀) = (⋃ a : Fin m, Set.range (τ a).base)ᶜ)
    (hc_τ : ∀ a : Fin m,
      (weilEtaleSitePullback (τ a)).IsContinuous Y₀.smallEtaleTopology B₀.smallEtaleTopology) :
    letI : ∀ a : Fin m,
      (weilEtaleSitePullback (τ a)).IsContinuous Y₀.smallEtaleTopology B₀.smallEtaleTopology := hc_τ
    let J_Y := Y₀.smallEtaleTopology
    let J_B := B₀.smallEtaleTopology
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let T_Y := weilEtaleIdTerminal.{u} Y₀
    let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y₀
    let T_B := weilEtaleIdTerminal.{u} B₀
    let hT_B := weilEtaleIdTerminalIsTerminal.{u} B₀
    let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
    let adj_B := CategoryTheory.constantSheafAdj J_B AddCommGrpCat.{u} hT_B
    let F_Y := weilEtaleTorsionSheaf Y₀ n
    let F_B := weilEtaleTorsionSheaf B₀ n
    let W_et : Y₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W_open.ι inferInstance
    let pf_a : Fin m → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
      fun a => ((weilEtaleSitePullback (τ a)).sheafPushforwardContinuous
        AddCommGrpCat.{u} J_Y J_B).obj F_B
    let ρ_a : ∀ a : Fin m, Quiver.Hom F_Y (pf_a a) :=
      fun a => (adj_Y.homEquiv AM (pf_a a)).symm
        (CategoryTheory.CategoryStruct.comp (adj_B.unit.app AM)
          (F_B.obj.map (Opposite.op (hT_B.from ((weilEtaleSitePullback (τ a)).obj T_Y)))))
    let Q : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := CategoryTheory.Limits.piObj pf_a
    let ρ : Quiver.Hom F_Y Q := CategoryTheory.Limits.Pi.lift ρ_a
    ∃ hzero : CategoryTheory.CategoryStruct.comp (weilEtaleLocalTorsionCounit Y₀ n W_et) ρ = 0,
      (CategoryTheory.ShortComplex.mk (weilEtaleLocalTorsionCounit Y₀ n W_et) ρ hzero).ShortExact :=
by
  classical
  have : ∀ a : Fin m,
      (weilEtaleSitePullback (τ a)).IsContinuous Y₀.smallEtaleTopology B₀.smallEtaleTopology := hc_τ
  have : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (τ a) := hτ_cl
  let J_Y := Y₀.smallEtaleTopology
  let J_B := B₀.smallEtaleTopology
  let A_type := ULift.{u} (ZMod n)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let T_Y := weilEtaleIdTerminal.{u} Y₀
  let hT_Y := weilEtaleIdTerminalIsTerminal.{u} Y₀
  let T_B := weilEtaleIdTerminal.{u} B₀
  let hT_B := weilEtaleIdTerminalIsTerminal.{u} B₀
  let adj_Y := CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y
  let adj_B := CategoryTheory.constantSheafAdj J_B AddCommGrpCat.{u} hT_B
  let F_Y := weilEtaleTorsionSheaf Y₀ n
  let F_B := weilEtaleTorsionSheaf B₀ n
  let W_et : Y₀.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ W_open.ι inferInstance
  let pf_a : Fin m → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun a => ((weilEtaleSitePullback (τ a)).sheafPushforwardContinuous
      AddCommGrpCat.{u} J_Y J_B).obj F_B
  let ρ_a : ∀ a : Fin m, Quiver.Hom F_Y (pf_a a) :=
    fun a => (adj_Y.homEquiv AM (pf_a a)).symm
      (CategoryTheory.CategoryStruct.comp (adj_B.unit.app AM)
        (F_B.obj.map (Opposite.op (hT_B.from ((weilEtaleSitePullback (τ a)).obj T_Y)))))
  let Q : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := CategoryTheory.Limits.piObj pf_a
  let ρ : Quiver.Hom F_Y Q := CategoryTheory.Limits.Pi.lift ρ_a
  let counit_W := weilEtaleLocalTorsionCounit Y₀ n W_et

  
  have hMemTop : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ S.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
    intro S W R
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) S W ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S (le_refl _)]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R

  let wSub : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale),
      (((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left).Opens → S.Etale :=
    fun S W O =>
      letI : AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom := W.prop
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (O.ι ≫ ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).hom) inferInstance

  let uSub : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale)
      (O : (((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left).Opens),
      wSub S W O ⟶ W :=
    fun _ _ O => CategoryTheory.MorphismProperty.Over.homMk O.ι rfl trivial

  have hOpenCover : ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) {ι : Type u}
      (O : ι → (((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left).Opens),
      (∀ w : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left, ∃ i : ι, w ∈ O i) →
      CategoryTheory.Sieve.generate
        (CategoryTheory.Presieve.ofArrows (fun i => wSub S W (O i)) (fun i => uSub S W (O i))) ∈
        S.smallEtaleTopology W := by
    intro S W ι O hcov
    rw [hMemTop]
    intro w
    obtain ⟨i, hw⟩ := hcov w
    exact ⟨wSub S W (O i), uSub S W (O i), ⟨w, hw⟩,
      ⟨wSub S W (O i), 𝟙 _, uSub S W (O i),
        CategoryTheory.Presieve.ofArrows.mk i, CategoryTheory.Category.id_comp _⟩,
      inferInstance, rfl⟩

  have hOpenIsSheafFor : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (W : S.Etale) {ι : Type u}
      (O : ι → (((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left).Opens),
      (∀ w : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left, ∃ i : ι, w ∈ O i) →
      CategoryTheory.Presieve.IsSheafFor (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
        (CategoryTheory.Presieve.ofArrows (fun i => wSub S W (O i)) (fun i => uSub S W (O i))) := by
    intro S G W ι O hcov
    have hSh : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology
        (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf S.smallEtaleTopology G.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) G.property
    exact ((CategoryTheory.isSheaf_iff_isSheaf_of_type S.smallEtaleTopology
      (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})).mp hSh).isSheafFor _
      (hOpenCover S W O hcov)

  have hOpenSep : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (W : S.Etale) {ι : Type u}
      (O : ι → (((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left).Opens),
      (∀ w : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left, ∃ i : ι, w ∈ O i) →
      ∀ {t₁ t₂ : ↥(G.obj.obj (Opposite.op W))},
        (∀ i : ι, (G.obj.map (uSub S W (O i)).op).hom t₁ =
          (G.obj.map (uSub S W (O i)).op).hom t₂) →
        t₁ = t₂ := by
    intro S G W ι O hcov t₁ t₂ heq
    have hSF := (CategoryTheory.Presieve.isSheafFor_arrows_iff
      (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
      (fun i => uSub S W (O i))).mp (hOpenIsSheafFor S G W O hcov)
    let x : ∀ i : ι, ↥(G.obj.obj (Opposite.op (wSub S W (O i)))) :=
      fun i => (G.obj.map (uSub S W (O i)).op).hom t₁
    have hx : CategoryTheory.Presieve.Arrows.Compatible
        (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) (fun i => uSub S W (O i)) x := by
      intro i₁ i₂ Z g₁ g₂ hcomm
      change (G.obj.map g₁.op).hom ((G.obj.map (uSub S W (O i₁)).op).hom t₁) =
        (G.obj.map g₂.op).hom ((G.obj.map (uSub S W (O i₂)).op).hom t₁)
      have h1 : (G.obj.map (g₁ ≫ uSub S W (O i₁)).op).hom t₁ =
          (G.obj.map (g₂ ≫ uSub S W (O i₂)).op).hom t₁ := by rw [hcomm]
      simpa [op_comp, CategoryTheory.Functor.map_comp] using h1
    obtain ⟨t, -, ht_uniq⟩ := hSF x hx
    exact (ht_uniq t₁ (fun _ => rfl)).trans (ht_uniq t₂ (fun i => (heq i).symm)).symm

  have hEmptySub : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (Z : S.Etale),
      IsEmpty ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Z).left →
      ∀ (s₁ s₂ : ↥(G.obj.obj (Opposite.op Z))), s₁ = s₂ := by
    intro S G Z hEmp s₁ s₂
    exact hOpenSep S G Z
      (fun _ : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Z).left => ⊤)
      (fun w => ⟨w, trivial⟩)
      (fun z => IsEmpty.elim hEmp z)

  have hOpenGlue : ∀ (S : AlgebraicGeometry.Scheme.{u})
      (G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
      (W : S.Etale) {ι : Type u}
      (O : ι → (((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left).Opens)
      (hcov : ∀ w : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left, ∃ i : ι, w ∈ O i)
      (sec : ∀ i : ι, ↥(G.obj.obj (Opposite.op (wSub S W (O i))))),
      (∀ (i₁ i₂ : ι) (Z : S.Etale)
        (_z₀ : ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Z).left)
        (g₁ : Z ⟶ wSub S W (O i₁)) (g₂ : Z ⟶ wSub S W (O i₂)),
        g₁ ≫ uSub S W (O i₁) = g₂ ≫ uSub S W (O i₂) →
        (G.obj.map g₁.op).hom (sec i₁) = (G.obj.map g₂.op).hom (sec i₂)) →
      ∃! t : ↥(G.obj.obj (Opposite.op W)),
        ∀ i : ι, (G.obj.map (uSub S W (O i)).op).hom t = sec i := by
    intro S G W ι O hcov sec hcompat
    have hSF := (CategoryTheory.Presieve.isSheafFor_arrows_iff
      (G.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
      (fun i => uSub S W (O i))).mp (hOpenIsSheafFor S G W O hcov)
    apply hSF sec
    intro i₁ i₂ Z g₁ g₂ hcomm
    by_cases hne : Nonempty ↥((AlgebraicGeometry.Scheme.Etale.forget S).obj Z).left
    · obtain ⟨z₀⟩ := hne
      exact hcompat i₁ i₂ Z z₀ g₁ g₂ hcomm
    · exact hEmptySub S G Z (not_nonempty_iff.mp hne) _ _

  
  have hSh_loc : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltLocConstPresheaf S n) := by
    intro S
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp S.smallEtaleTopology
      (weilAltLocConstPresheaf S n) (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro W R hR
    have hsurj := (hMemTop S W R).mp hR
    intro x hx
    let x_lc : ∀ {Z : S.Etale} (u : Z ⟶ W), R.arrows u →
        LocallyConstant ↥(Fgt.obj Z).left A_type :=
      fun u hu => x u hu
    have hwd : ∀ {Z₁ Z₂ : S.Etale} {u₁ : Z₁ ⟶ W} {u₂ : Z₂ ⟶ W}
        (hu₁ : R.arrows u₁) (hu₂ : R.arrows u₂)
        (z₁ : ↥(Fgt.obj Z₁).left) (z₂ : ↥(Fgt.obj Z₂).left),
        (Fgt.map u₁).left.base z₁ = (Fgt.map u₂).left.base z₂ →
        (x_lc u₁ hu₁) z₁ = (x_lc u₂ hu₂) z₂ := by
      intro Z₁ Z₂ u₁ u₂ hu₁ hu₂ z₁ z₂ heq
      let f₁ : (Fgt.obj Z₁).left ⟶ (Fgt.obj W).left := (Fgt.map u₁).left
      let f₂ : (Fgt.obj Z₂).left ⟶ (Fgt.obj W).left := (Fgt.map u₂).left
      have hEt_W : AlgebraicGeometry.Etale (Fgt.obj W).hom := W.prop
      have hEt_Z₁ : AlgebraicGeometry.Etale (Fgt.obj Z₁).hom := Z₁.prop
      have hEt_Z₂ : AlgebraicGeometry.Etale (Fgt.obj Z₂).hom := Z₂.prop
      have hEt_f₁ : AlgebraicGeometry.Etale f₁ := by
        have hw₁ : f₁ ≫ (Fgt.obj W).hom = (Fgt.obj Z₁).hom := (Fgt.map u₁).w
        have hc₁ : AlgebraicGeometry.Etale (f₁ ≫ (Fgt.obj W).hom) := hw₁.symm ▸ hEt_Z₁
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          f₁ (Fgt.obj W).hom hEt_W hc₁
      have hEt_f₂ : AlgebraicGeometry.Etale f₂ := by
        have hw₂ : f₂ ≫ (Fgt.obj W).hom = (Fgt.obj Z₂).hom := (Fgt.map u₂).w
        have hc₂ : AlgebraicGeometry.Etale (f₂ ≫ (Fgt.obj W).hom) := hw₂.symm ▸ hEt_Z₂
        exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          f₂ (Fgt.obj W).hom hEt_W hc₂
      let P := CategoryTheory.Limits.pullback f₁ f₂
      let p₁ : P ⟶ (Fgt.obj Z₁).left := CategoryTheory.Limits.pullback.fst f₁ f₂
      let p₂ : P ⟶ (Fgt.obj Z₂).left := CategoryTheory.Limits.pullback.snd f₁ f₂
      have hp₂_w : p₂ ≫ (Fgt.obj Z₂).hom = p₁ ≫ (Fgt.obj Z₁).hom := by
        rw [← (Fgt.map u₂).w, ← (Fgt.map u₁).w, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition]
      let P_et : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (Fgt.obj Z₁).hom) inferInstance
      let g₁ : P_et ⟶ Z₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
      let g₂ : P_et ⟶ Z₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ hp₂_w trivial
      have hg_comm : g₁ ≫ u₁ = g₂ ≫ u₂ :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          CategoryTheory.Limits.pullback.condition (Subsingleton.elim _ _)
      obtain ⟨q, hq₁, hq₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := f₁) (g := f₂) z₁ z₂ heq
      have hcomp_q : ((weilAltLocConstPresheaf S n).map g₁.op).hom (x_lc u₁ hu₁) =
          ((weilAltLocConstPresheaf S n).map g₂.op).hom (x_lc u₂ hu₂) :=
        hx g₁ g₂ hu₁ hu₂ hg_comm
      have hval : (x_lc u₁ hu₁) (p₁.base q) = (x_lc u₂ hu₂) (p₂.base q) :=
        congrArg (fun k : LocallyConstant ↥(Fgt.obj P_et).left A_type => k q) hcomp_q
      rwa [hq₁, hq₂] at hval
    let g_fn : ↥(Fgt.obj W).left → A_type := fun w =>
      let u_w := Classical.choose (Classical.choose_spec (hsurj w))
      let y_w := Classical.choose (Classical.choose_spec (Classical.choose_spec (hsurj w)))
      let hy_w := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hsurj w)))
      (x_lc u_w hy_w.1) y_w
    have hg_eq : ∀ {Z : S.Etale} (u : Z ⟶ W) (hu : R.arrows u) (z : ↥(Fgt.obj Z).left),
        g_fn ((Fgt.map u).left.base z) = (x_lc u hu) z := by
      intro Z u hu z
      let w := (Fgt.map u).left.base z
      let hy_w := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hsurj w)))
      exact hwd hy_w.1 hu _ z hy_w.2.2
    have hg_lc : IsLocallyConstant g_fn := by
      intro t
      rw [isOpen_iff_forall_mem_open]
      intro w hw
      obtain ⟨Z, u, z, hu, hEt_u, hfz⟩ := hsurj w
      let f_u : (Fgt.obj Z).left ⟶ (Fgt.obj W).left := u.left
      have : AlgebraicGeometry.Etale f_u := hEt_u
      refine ⟨f_u.base '' ((x_lc u hu) ⁻¹' t), ?_,
        f_u.isOpenMap _ ((x_lc u hu).isLocallyConstant t), ?_⟩
      · intro w' ⟨z', hz', hw'⟩
        change g_fn w' ∈ t
        rw [← hw']
        change g_fn ((Fgt.map u).left.base z') ∈ t
        rw [hg_eq u hu z']
        exact hz'
      · refine ⟨z, ?_, hfz⟩
        change (x_lc u hu) z ∈ t
        rw [← hg_eq u hu z]
        change g_fn (u.left.base z) ∈ t
        rwa [hfz]
    let g_sec : LocallyConstant ↥(Fgt.obj W).left A_type := ⟨g_fn, hg_lc⟩
    refine ⟨g_sec, ?_, ?_⟩
    · intro Z u hu
      exact LocallyConstant.ext (fun z => hg_eq u hu z)
    · intro (g' : LocallyConstant ↥(Fgt.obj W).left A_type) hg'
      apply LocallyConstant.ext
      intro w
      obtain ⟨Z, u, z, hu, -, hfz⟩ := hsurj w
      have h1 := congrArg (fun k : LocallyConstant ↥(Fgt.obj Z).left A_type => k z) (hg' u hu)
      change g' ((Fgt.map u).left.base z) = (x_lc u hu) z at h1
      change g' w = g_fn w
      rw [← hfz]
      exact h1.trans (hg_eq u hu z).symm

  have hIso_loc : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      ∃ e_loc : CategoryTheory.Iso (weilEtaleTorsionSheaf S n)
          ⟨weilAltLocConstPresheaf S n, hSh_loc S⟩,
        ∀ (W : S.Etale),
          CategoryTheory.CategoryStruct.comp
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).unit.app
              ((CategoryTheory.Functor.const (Opposite S.Etale)).obj AM)).app (Opposite.op W))
            (e_loc.hom.hom.app (Opposite.op W)) =
            weilAltLocConstConstHom S W n := by
    intro S
    let J := S.smallEtaleTopology
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    let F_tor : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleTorsionSheaf S n
    let L_loc : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf S n, hSh_loc S⟩
    let P_const := (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let η_const := adj_sh.unit.app P_const
    let γ_const : P_const ⟶ weilAltLocConstPresheaf S n :=
      { app := fun W => weilAltLocConstConstHom S (Opposite.unop W) n
        naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }
    let Φ_loc : F_tor ⟶ L_loc := (adj_sh.homEquiv P_const L_loc).symm γ_const
    have hΦ_unit_nat : η_const ≫ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map Φ_loc =
        γ_const := by
      rw [← adj_sh.homEquiv_unit P_const L_loc Φ_loc]
      exact Equiv.apply_symm_apply _ _
    have hPin : ∀ (W : S.Etale),
        η_const.app (Opposite.op W) ≫ Φ_loc.hom.app (Opposite.op W) =
          weilAltLocConstConstHom S W n := by
      intro W
      exact congrArg (fun k : P_const ⟶ weilAltLocConstPresheaf S n => k.app (Opposite.op W))
        hΦ_unit_nat
    have hη_nat : ∀ {V₁ V₂ : S.Etale} (u : V₁ ⟶ V₂) (c : A_type),
        (F_tor.obj.map u.op).hom ((η_const.app (Opposite.op V₂)).hom c) =
          (η_const.app (Opposite.op V₁)).hom c := by
      intro V₁ V₂ u c
      exact (congrArg (fun k : AM ⟶ F_tor.obj.obj (Opposite.op V₁) => k.hom c)
        (η_const.naturality u.op)).symm
    let O_loc : ∀ (W : S.Etale),
        LocallyConstant ↥(Fgt.obj W).left A_type →
        ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
      fun _ g x => ⟨g ⁻¹' {g x}, g.isLocallyConstant {g x}⟩
    have hGlue_loc : ∀ (W : S.Etale) (g : LocallyConstant ↥(Fgt.obj W).left A_type),
        ∃! t : ↥(F_tor.obj.obj (Opposite.op W)),
          ∀ x : ↥(Fgt.obj W).left,
            (F_tor.obj.map (uSub S W (O_loc W g x)).op).hom t =
              (η_const.app (Opposite.op (wSub S W (O_loc W g x)))).hom (g x) := by
      intro W g
      apply hOpenGlue S F_tor W (O_loc W g) (fun w => ⟨w, rfl⟩)
      intro x₁ x₂ Z z₀ g₁ g₂ hcomm
      let w₀ : ↥(Fgt.obj W).left := ((Fgt.map (g₁ ≫ uSub S W (O_loc W g x₁))).left).base z₀
      have hw₁ : g w₀ = g x₁ := (((Fgt.map g₁).left).base z₀).2
      have hw₂ : g w₀ = g x₂ := by
        have heq_w : w₀ = ((Fgt.map (g₂ ≫ uSub S W (O_loc W g x₂))).left).base z₀ :=
          congrArg (fun k : Z ⟶ W => ((Fgt.map k).left).base z₀) hcomm
        rw [heq_w]
        exact (((Fgt.map g₂).left).base z₀).2
      have hx_eq : g x₁ = g x₂ := hw₁.symm.trans hw₂
      rw [hη_nat g₁ (g x₁), hη_nat g₂ (g x₂), hx_eq]
    let ψ_fn : ∀ (W : S.Etale),
        LocallyConstant ↥(Fgt.obj W).left A_type → ↥(F_tor.obj.obj (Opposite.op W)) :=
      fun W g => Classical.choose (hGlue_loc W g)
    have hψ_spec : ∀ (W : S.Etale) (g : LocallyConstant ↥(Fgt.obj W).left A_type)
        (x : ↥(Fgt.obj W).left),
        (F_tor.obj.map (uSub S W (O_loc W g x)).op).hom (ψ_fn W g) =
          (η_const.app (Opposite.op (wSub S W (O_loc W g x)))).hom (g x) :=
      fun W g x => (Classical.choose_spec (hGlue_loc W g)).1 x
    have hψ_zero : ∀ (W : S.Etale), ψ_fn W 0 = 0 := by
      intro W
      apply hOpenSep S F_tor W (O_loc W 0) (fun w => ⟨w, rfl⟩)
      intro x
      rw [hψ_spec W 0 x, map_zero]
      exact map_zero (η_const.app (Opposite.op (wSub S W (O_loc W 0 x)))).hom
    have hψ_add : ∀ (W : S.Etale) (g₁ g₂ : LocallyConstant ↥(Fgt.obj W).left A_type),
        ψ_fn W (g₁ + g₂) = ψ_fn W g₁ + ψ_fn W g₂ := by
      intro W g₁ g₂
      let O₁₂ : ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
        fun x => O_loc W g₁ x ⊓ O_loc W g₂ x
      apply hOpenSep S F_tor W O₁₂ (fun w => ⟨w, ⟨rfl, rfl⟩⟩)
      intro x
      have hle₁ : O₁₂ x ≤ O_loc W g₁ x := inf_le_left
      have hle₂ : O₁₂ x ≤ O_loc W g₂ x := inf_le_right
      have hle₁₂ : O₁₂ x ≤ O_loc W (g₁ + g₂) x := by
        intro y hy
        change g₁ y + g₂ y = g₁ x + g₂ x
        rw [hy.1, hy.2]
      let m_le : ∀ {U₁ U₂ : ((Fgt.obj W).left).Opens}, U₁ ≤ U₂ → (wSub S W U₁ ⟶ wSub S W U₂) :=
        fun hle => CategoryTheory.MorphismProperty.Over.homMk
          (((Fgt.obj W).left).homOfLE hle)
          (AlgebraicGeometry.Scheme.homOfLE_ι_assoc _ hle _) trivial
      have hm_u : ∀ {U₁ U₂ : ((Fgt.obj W).left).Opens} (hle : U₁ ≤ U₂),
          m_le hle ≫ uSub S W U₂ = uSub S W U₁ :=
        fun hle => CategoryTheory.MorphismProperty.Comma.Hom.ext
          (((Fgt.obj W).left).homOfLE_ι hle) (Subsingleton.elim _ _)
      have h_res : ∀ (g : LocallyConstant ↥(Fgt.obj W).left A_type) (hle : O₁₂ x ≤ O_loc W g x),
          (F_tor.obj.map (uSub S W (O₁₂ x)).op).hom (ψ_fn W g) =
            (η_const.app (Opposite.op (wSub S W (O₁₂ x)))).hom (g x) := by
        intro g hle
        rw [← hm_u hle, op_comp, CategoryTheory.Functor.map_comp]
        change (F_tor.obj.map (m_le hle).op).hom
            ((F_tor.obj.map (uSub S W (O_loc W g x)).op).hom (ψ_fn W g)) = _
        rw [hψ_spec W g x]
        exact hη_nat (m_le hle) (g x)
      rw [map_add, h_res (g₁ + g₂) hle₁₂, h_res g₁ hle₁, h_res g₂ hle₂]
      exact map_add (η_const.app (Opposite.op (wSub S W (O₁₂ x)))).hom (g₁ x) (g₂ x)
    let Ψ_loc : L_loc ⟶ F_tor := CategoryTheory.ObjectProperty.homMk
      { app := fun W => AddCommGrpCat.ofHom
          { toFun := ψ_fn (Opposite.unop W)
            map_zero' := hψ_zero (Opposite.unop W)
            map_add' := hψ_add (Opposite.unop W) }
        naturality := fun {W₁ W₂} f => by
          apply AddCommGrpCat.ext
          intro (g : LocallyConstant ↥(Fgt.obj (Opposite.unop W₁)).left A_type)
          let U₁ := Opposite.unop W₁
          let U₂ := Opposite.unop W₂
          let g' : LocallyConstant ↥(Fgt.obj U₂).left A_type :=
            ((weilAltLocConstPresheaf S n).map f).hom g
          change ψ_fn U₂ g' = (F_tor.obj.map f).hom (ψ_fn U₁ g)
          apply hOpenSep S F_tor U₂ (O_loc U₂ g') (fun y => ⟨y, rfl⟩)
          intro y
          rw [hψ_spec U₂ g' y]
          let x : ↥(Fgt.obj U₁).left := ((Fgt.map f.unop).left).base y
          have hrange : Set.range ⇑((O_loc U₂ g' y).ι ≫ (Fgt.map f.unop).left) ⊆
              Set.range ⇑(O_loc U₁ g x).ι := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨z, rfl⟩
            exact z.2
          let lift_sch : (O_loc U₂ g' y).toScheme ⟶ (O_loc U₁ g x).toScheme :=
            AlgebraicGeometry.IsOpenImmersion.lift (O_loc U₁ g x).ι
              ((O_loc U₂ g' y).ι ≫ (Fgt.map f.unop).left) hrange
          have hlift_fac : lift_sch ≫ (O_loc U₁ g x).ι =
              (O_loc U₂ g' y).ι ≫ (Fgt.map f.unop).left :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac (O_loc U₁ g x).ι _ hrange
          let lift_et : wSub S U₂ (O_loc U₂ g' y) ⟶ wSub S U₁ (O_loc U₁ g x) :=
            CategoryTheory.MorphismProperty.Over.homMk lift_sch
              (by
                change lift_sch ≫ (O_loc U₁ g x).ι ≫ (Fgt.obj U₁).hom =
                  (O_loc U₂ g' y).ι ≫ (Fgt.obj U₂).hom
                rw [← CategoryTheory.Category.assoc, hlift_fac, CategoryTheory.Category.assoc,
                  (Fgt.map f.unop).w])
              trivial
          have hcomm_et : lift_et ≫ uSub S U₁ (O_loc U₁ g x) =
              uSub S U₂ (O_loc U₂ g' y) ≫ f.unop :=
            CategoryTheory.MorphismProperty.Comma.Hom.ext hlift_fac (Subsingleton.elim _ _)
          have hmap_eq : (F_tor.obj.map (uSub S U₂ (O_loc U₂ g' y)).op).hom
              ((F_tor.obj.map f).hom (ψ_fn U₁ g)) =
              (F_tor.obj.map lift_et.op).hom
                ((F_tor.obj.map (uSub S U₁ (O_loc U₁ g x)).op).hom (ψ_fn U₁ g)) := by
            have hc : f ≫ (uSub S U₂ (O_loc U₂ g' y)).op =
                (uSub S U₁ (O_loc U₁ g x)).op ≫ lift_et.op := by
              change (uSub S U₂ (O_loc U₂ g' y) ≫ f.unop).op =
                (lift_et ≫ uSub S U₁ (O_loc U₁ g x)).op
              rw [hcomm_et]
            have hfun := congrArg (fun k => k.hom (ψ_fn U₁ g))
              (F_tor.obj.map_comp f (uSub S U₂ (O_loc U₂ g' y)).op).symm
            rw [hc, F_tor.obj.map_comp] at hfun
            exact hfun
          rw [hmap_eq, hψ_spec U₁ g x]
          exact (hη_nat lift_et (g x)).symm }
    have hΦΨ : Φ_loc ≫ Ψ_loc = 𝟙 F_tor := by
      let comp_sh : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P_const ⟶ F_tor :=
        Φ_loc ≫ Ψ_loc
      let id_sh : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P_const ⟶ F_tor :=
        𝟙 F_tor
      change comp_sh = id_sh
      apply (adj_sh.homEquiv P_const F_tor).injective
      rw [adj_sh.homEquiv_unit P_const F_tor comp_sh, adj_sh.homEquiv_unit P_const F_tor id_sh]
      ext opW a
      let W := Opposite.unop opW
      change ψ_fn W (((η_const.app (Opposite.op W) ≫ Φ_loc.hom.app (Opposite.op W)).hom) a) =
        (η_const.app (Opposite.op W)).hom a
      rw [hPin W]
      let c_loc : LocallyConstant ↥(Fgt.obj W).left A_type :=
        (weilAltLocConstConstHom S W n).hom a
      change ψ_fn W c_loc = (η_const.app (Opposite.op W)).hom a
      apply hOpenSep S F_tor W (O_loc W c_loc) (fun w => ⟨w, rfl⟩)
      intro x
      rw [hψ_spec W c_loc x]
      exact (hη_nat (uSub S W (O_loc W c_loc x)) a).symm
    have hΨΦ : Ψ_loc ≫ Φ_loc = 𝟙 L_loc := by
      let toLC : ∀ V : S.Etale,
          ↥(L_loc.obj.obj (Opposite.op V)) → LocallyConstant ↥(Fgt.obj V).left A_type :=
        fun _ s => s
      apply CategoryTheory.Sheaf.hom_ext
      ext opW g
      let W := Opposite.unop opW
      let g_lc : LocallyConstant ↥(Fgt.obj W).left A_type := g
      let h_out : LocallyConstant ↥(Fgt.obj W).left A_type :=
        toLC W ((Φ_loc.hom.app (Opposite.op W)).hom (ψ_fn W g_lc))
      change h_out = g_lc
      apply LocallyConstant.ext
      intro x
      let W_x := wSub S W (O_loc W g_lc x)
      let x_sub : ↥(Fgt.obj W_x).left := (⟨x, rfl⟩ : ↥(O_loc W g_lc x).toScheme)
      have hnat := congrArg
        (fun k : F_tor.obj.obj (Opposite.op W) ⟶ L_loc.obj.obj (Opposite.op W_x) =>
          toLC W_x (k.hom (ψ_fn W g_lc)) x_sub)
        (Φ_loc.hom.naturality (uSub S W (O_loc W g_lc x)).op)
      have h_eval : h_out x =
          toLC W_x ((Φ_loc.hom.app (Opposite.op W_x)).hom
            ((F_tor.obj.map (uSub S W (O_loc W g_lc x)).op).hom (ψ_fn W g_lc))) x_sub :=
        hnat.symm
      rw [h_eval, hψ_spec W g_lc x]
      exact congrArg
        (fun k : AM ⟶ L_loc.obj.obj (Opposite.op W_x) =>
          toLC W_x (k.hom (g_lc x)) x_sub)
        (hPin W_x)
    exact ⟨{ hom := Φ_loc, inv := Ψ_loc, hom_inv_id := hΦΨ, inv_hom_id := hΨΦ }, hPin⟩

  
  have hSh_zero_Y : CategoryTheory.Presheaf.IsSheaf J_Y
      (weilAltZeroBdrySubpresheaf Y₀ W_open n) := by
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Y₀
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J_Y
      (weilAltZeroBdrySubpresheaf Y₀ W_open n) (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    intro W R hR
    have hsurj := (hMemTop Y₀ W R).mp hR
    have hSh_L : CategoryTheory.Presieve.IsSheaf J_Y
        (weilAltLocConstPresheaf Y₀ n ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type J_Y _).mp
        (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J_Y (weilAltLocConstPresheaf Y₀ n)
          (CategoryTheory.forget AddCommGrpCat.{u}) (hSh_loc Y₀))
    have hSF_L := hSh_L R hR
    intro x hx
    let x_sub : ∀ {Z : Y₀.Etale} (u : Z ⟶ W), R.arrows u →
        ↥(weilAltZeroBdrySubgroup Y₀ W_open n Z) :=
      fun u hu => x u hu
    let x_loc : CategoryTheory.Presieve.FamilyOfElements
        (weilAltLocConstPresheaf Y₀ n ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R.arrows :=
      fun _ u hu => (x_sub u hu).1
    have hx_loc : x_loc.Compatible := by
      intro Z₁ Z₂ P g₁ g₂ u₁ u₂ hu₁ hu₂ hcomm
      exact congrArg Subtype.val (hx g₁ g₂ hu₁ hu₂ hcomm)
    let g : LocallyConstant ↥(Fgt.obj W).left A_type := hSF_L.amalgamate x_loc hx_loc
    have hg_glue : ∀ {Z : Y₀.Etale} (u : Z ⟶ W) (hu : R.arrows u),
        ((weilAltLocConstPresheaf Y₀ n).map u.op).hom g = (x_sub u hu).1 :=
      fun u hu => hSF_L.valid_glue hx_loc u hu
    have hg_bdry : g ∈ weilAltZeroBdrySubgroup Y₀ W_open n W := by
      intro w hw
      obtain ⟨Z, u, z, hu, -, hfz⟩ := hsurj w
      have hz_not : (Fgt.obj Z).hom.base z ∉ (W_open : Set ↥Y₀) := by
        rw [← (Fgt.map u).w]
        change (Fgt.obj W).hom.base (u.left.base z) ∉ (W_open : Set ↥Y₀)
        rwa [hfz]
      have h1 := congrArg (fun k : LocallyConstant ↥(Fgt.obj Z).left A_type => k z) (hg_glue u hu)
      change g (u.left.base z) = (x_sub u hu).1 z at h1
      rw [← hfz, h1]
      exact (x_sub u hu).2 z hz_not
    refine ⟨(⟨g, hg_bdry⟩ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W)), ?_, ?_⟩
    · intro Z u hu
      exact Subtype.ext (hg_glue u hu)
    · intro (g' : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W)) hg'
      apply Subtype.ext
      apply hSF_L.isSeparatedFor.ext
      intro Z u hu
      exact (congrArg Subtype.val (hg' u hu)).trans (hg_glue u hu).symm

  have hFreeYoneda_comp :
      ∀ {V₀ : Y₀.Etale} {M₀ : AddCommGrpCat.{u}}
        {G₁ G₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
        (α : CategoryTheory.Sheaf.freeYoneda J_Y V₀ M₀ ⟶ G₁) (g : G₁ ⟶ G₂),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op V₀) := by
    intro V₀ M₀ G₁ G₂ α g
    let adj_S := CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}
    let P₀ := CategoryTheory.Presheaf.freeYoneda V₀ M₀
    let α' : (CategoryTheory.presheafToSheaf J_Y AddCommGrpCat.{u}).obj P₀ ⟶ G₁ := α
    change CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj_S.homEquiv P₀ G₂) (α' ≫ g)) =
      CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj_S.homEquiv P₀ G₁) α') ≫
        g.hom.app (Opposite.op V₀)
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
      (CategoryTheory.sheafToPresheaf J_Y AddCommGrpCat.{u}).map_comp,
      CategoryTheory.Presheaf.freeYonedaHomEquiv_comp]
    rfl

  let K_zero_Y : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    ⟨weilAltZeroBdrySubpresheaf Y₀ W_open n, hSh_zero_Y⟩
  let L_Wet : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    weilEtaleLocalTorsionSheaf Y₀ n W_et

  have hSub_Wet : ∀ {Z : Y₀.Etale} (h₁ h₂ : Z ⟶ W_et), h₁ = h₂ := by
    intro Z h₁ h₂
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Y₀
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · apply (cancel_mono W_open.ι).mp
      have hw₁ : (Fgt.map h₁).left ≫ W_open.ι = (Fgt.obj Z).hom := (Fgt.map h₁).w
      have hw₂ : (Fgt.map h₂).left ≫ W_open.ι = (Fgt.obj Z).hom := (Fgt.map h₂).w
      exact hw₁.trans hw₂.symm
    · exact Subsingleton.elim _ _

  have hIso_zero_Y :
      ∃ e_zero : CategoryTheory.Iso L_Wet K_zero_Y,
        CategoryTheory.CategoryStruct.comp
          (CategoryTheory.Sheaf.freeYonedaHomEquiv e_zero.hom)
          ((weilAltZeroBdrySubpresheafι Y₀ W_open n).app (Opposite.op W_et)) =
          weilAltLocConstConstHom Y₀ W_et n := by
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget Y₀
    let pHom : ∀ W : Y₀.Etale, (Fgt.obj W).left ⟶ Y₀ := fun W => (Fgt.obj W).hom
    have hWet_mem : ∀ z : ↥(Fgt.obj W_et).left, (pHom W_et).base z ∈ (W_open : Set ↥Y₀) :=
      fun z => z.2
    let α₀ : AM ⟶ K_zero_Y.obj.obj (Opposite.op W_et) := AddCommGrpCat.ofHom
      { toFun := fun a =>
          ⟨LocallyConstant.const ↥(Fgt.obj W_et).left a,
           fun z hz => absurd (hWet_mem z) hz⟩
        map_zero' := Subtype.ext (LocallyConstant.ext (fun _ => rfl))
        map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)) }
    let Φ_zero : L_Wet ⟶ K_zero_Y := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm α₀
    have hΦ_equiv : CategoryTheory.Sheaf.freeYonedaHomEquiv Φ_zero = α₀ :=
      Equiv.apply_symm_apply _ _
    have hPin_zero : CategoryTheory.Sheaf.freeYonedaHomEquiv Φ_zero ≫
        (weilAltZeroBdrySubpresheafι Y₀ W_open n).app (Opposite.op W_et) =
        weilAltLocConstConstHom Y₀ W_et n := by
      rw [hΦ_equiv]
      exact AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
    let η_W : AM ⟶ L_Wet.obj.obj (Opposite.op W_et) :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_Wet)
    let O_zero : ∀ (W : Y₀.Etale),
        ↥(weilAltZeroBdrySubgroup Y₀ W_open n W) →
        ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
      fun W g₀ x =>
        if (pHom W).base x ∈ (W_open : Set ↥Y₀) then
          (TopologicalSpace.Opens.map (pHom W).base).obj W_open ⊓
            ⟨g₀.1 ⁻¹' {g₀.1 x}, g₀.1.isLocallyConstant {g₀.1 x}⟩
        else
          ⟨g₀.1 ⁻¹' {g₀.1 x}, g₀.1.isLocallyConstant {g₀.1 x}⟩
    have hx_mem_Ozero : ∀ (W : Y₀.Etale) (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W))
        (x : ↥(Fgt.obj W).left), x ∈ O_zero W g₀ x := by
      intro W g₀ x
      dsimp [O_zero]
      split_ifs with hx
      · exact ⟨hx, rfl⟩
      · rfl
    have hOzero_val : ∀ (W : Y₀.Etale) (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W))
        (x y : ↥(Fgt.obj W).left), y ∈ O_zero W g₀ x → g₀.1 y = g₀.1 x := by
      intro W g₀ x y hy
      dsimp [O_zero] at hy
      split_ifs at hy with hx
      · exact hy.2
      · exact hy
    have hOzero_inW : ∀ (W : Y₀.Etale) (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W))
        (x : ↥(Fgt.obj W).left),
        (pHom W).base x ∈ (W_open : Set ↥Y₀) →
        O_zero W g₀ x ≤ (TopologicalSpace.Opens.map (pHom W).base).obj W_open := by
      intro W g₀ x hx y hy
      dsimp [O_zero] at hy
      split_ifs at hy with hx'
      · exact hy.1
      · exact absurd hx hx'
    let liftToWet : ∀ (W : Y₀.Etale) (O : ((Fgt.obj W).left).Opens),
        O ≤ (TopologicalSpace.Opens.map (pHom W).base).obj W_open →
        (wSub Y₀ W O ⟶ W_et) :=
      fun W O hle =>
        have hrange : Set.range ⇑(O.ι ≫ pHom W) ⊆ Set.range ⇑W_open.ι := by
          rw [AlgebraicGeometry.Scheme.Opens.range_ι]
          rintro _ ⟨z, rfl⟩
          exact hle z.2
        let lift_sch : O.toScheme ⟶ W_open.toScheme :=
          AlgebraicGeometry.IsOpenImmersion.lift W_open.ι (O.ι ≫ pHom W) hrange
        have hlift_fac : lift_sch ≫ W_open.ι = O.ι ≫ pHom W :=
          AlgebraicGeometry.IsOpenImmersion.lift_fac W_open.ι (O.ι ≫ pHom W) hrange
        CategoryTheory.MorphismProperty.Over.homMk lift_sch hlift_fac trivial
    let sec_zero : ∀ (W : Y₀.Etale) (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W))
        (x : ↥(Fgt.obj W).left), ↥(L_Wet.obj.obj (Opposite.op (wSub Y₀ W (O_zero W g₀ x)))) :=
      fun W g₀ x =>
        if hx : (pHom W).base x ∈ (W_open : Set ↥Y₀) then
          (L_Wet.obj.map (liftToWet W (O_zero W g₀ x) (hOzero_inW W g₀ x hx)).op).hom
            (η_W.hom (g₀.1 x))
        else
          0
    have hGlue_zero : ∀ (W : Y₀.Etale) (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W)),
        ∃! t : ↥(L_Wet.obj.obj (Opposite.op W)),
          ∀ x : ↥(Fgt.obj W).left,
            (L_Wet.obj.map (uSub Y₀ W (O_zero W g₀ x)).op).hom t = sec_zero W g₀ x := by
      intro W g₀
      apply hOpenGlue Y₀ L_Wet W (O_zero W g₀) (fun w => ⟨w, hx_mem_Ozero W g₀ w⟩) (sec_zero W g₀)
      intro x₁ x₂ Z z₀ g₁ g₂ hcomm
      let w₀ : ↥(Fgt.obj W).left := ((Fgt.map (g₁ ≫ uSub Y₀ W (O_zero W g₀ x₁))).left).base z₀
      have hw₁_mem : w₀ ∈ O_zero W g₀ x₁ := (((Fgt.map g₁).left).base z₀).2
      have hw₂_mem : w₀ ∈ O_zero W g₀ x₂ := by
        have heq_w : w₀ = ((Fgt.map (g₂ ≫ uSub Y₀ W (O_zero W g₀ x₂))).left).base z₀ :=
          congrArg (fun k : Z ⟶ W => ((Fgt.map k).left).base z₀) hcomm
        rw [heq_w]
        exact (((Fgt.map g₂).left).base z₀).2
      have hx_val : g₀.1 x₁ = g₀.1 x₂ :=
        (hOzero_val W g₀ x₁ w₀ hw₁_mem).symm.trans (hOzero_val W g₀ x₂ w₀ hw₂_mem)
      by_cases hx₁ : (pHom W).base x₁ ∈ (W_open : Set ↥Y₀)
      · by_cases hx₂ : (pHom W).base x₂ ∈ (W_open : Set ↥Y₀)
        · simp only [sec_zero, dif_pos hx₁, dif_pos hx₂]
          let ℓ₁ := liftToWet W (O_zero W g₀ x₁) (hOzero_inW W g₀ x₁ hx₁)
          let ℓ₂ := liftToWet W (O_zero W g₀ x₂) (hOzero_inW W g₀ x₂ hx₂)
          have hhom_eq : g₁ ≫ ℓ₁ = g₂ ≫ ℓ₂ := hSub_Wet _ _
          have h1 : (L_Wet.obj.map g₁.op).hom ((L_Wet.obj.map ℓ₁.op).hom (η_W.hom (g₀.1 x₁))) =
              (L_Wet.obj.map (g₁ ≫ ℓ₁).op).hom (η_W.hom (g₀.1 x₁)) := by
            simp [op_comp, CategoryTheory.Functor.map_comp]
          have h2 : (L_Wet.obj.map g₂.op).hom ((L_Wet.obj.map ℓ₂.op).hom (η_W.hom (g₀.1 x₂))) =
              (L_Wet.obj.map (g₂ ≫ ℓ₂).op).hom (η_W.hom (g₀.1 x₂)) := by
            simp [op_comp, CategoryTheory.Functor.map_comp]
          rw [h1, h2, hhom_eq, hx_val]
        · simp only [sec_zero, dif_pos hx₁, dif_neg hx₂]
          have hx₂_zero : g₀.1 x₂ = 0 := g₀.2 x₂ hx₂
          have hη0 : η_W.hom (g₀.1 x₁) = 0 :=
            (congrArg η_W.hom (hx_val.trans hx₂_zero)).trans η_W.hom.map_zero
          rw [hη0, map_zero, map_zero, map_zero]
      · by_cases hx₂ : (pHom W).base x₂ ∈ (W_open : Set ↥Y₀)
        · simp only [sec_zero, dif_neg hx₁, dif_pos hx₂]
          have hx₁_zero : g₀.1 x₁ = 0 := g₀.2 x₁ hx₁
          have hη0 : η_W.hom (g₀.1 x₂) = 0 :=
            (congrArg η_W.hom (hx_val.symm.trans hx₁_zero)).trans η_W.hom.map_zero
          rw [hη0, map_zero, map_zero, map_zero]
        · simp only [sec_zero, dif_neg hx₁, dif_neg hx₂, map_zero]
    let ψ_z : ∀ (W : Y₀.Etale),
        ↥(weilAltZeroBdrySubgroup Y₀ W_open n W) → ↥(L_Wet.obj.obj (Opposite.op W)) :=
      fun W g₀ => Classical.choose (hGlue_zero W g₀)
    have hψz_spec : ∀ (W : Y₀.Etale) (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W))
        (x : ↥(Fgt.obj W).left),
        (L_Wet.obj.map (uSub Y₀ W (O_zero W g₀ x)).op).hom (ψ_z W g₀) = sec_zero W g₀ x :=
      fun W g₀ x => (Classical.choose_spec (hGlue_zero W g₀)).1 x
    have hψz_zero : ∀ (W : Y₀.Etale), ψ_z W 0 = 0 := by
      intro W
      apply hOpenSep Y₀ L_Wet W (O_zero W 0) (fun w => ⟨w, hx_mem_Ozero W 0 w⟩)
      intro x
      rw [hψz_spec W 0 x, map_zero]
      by_cases hx : (pHom W).base x ∈ (W_open : Set ↥Y₀)
      · simp only [sec_zero, dif_pos hx]
        have hη0 : η_W.hom ((0 : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W)).1 x) = 0 :=
          map_zero η_W.hom
        rw [hη0, map_zero]
      · simp only [sec_zero, dif_neg hx]
    have hψz_add : ∀ (W : Y₀.Etale) (a b : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W)),
        ψ_z W (a + b) = ψ_z W a + ψ_z W b := by
      intro W a b
      let O_ab : ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
        fun x => (O_zero W a x ⊓ O_zero W b x) ⊓ O_zero W (a + b) x
      apply hOpenSep Y₀ L_Wet W O_ab
        (fun w => ⟨w, ⟨⟨hx_mem_Ozero W a w, hx_mem_Ozero W b w⟩, hx_mem_Ozero W (a + b) w⟩⟩)
      intro x
      let m_le : ∀ {U₁ U₂ : ((Fgt.obj W).left).Opens}, U₁ ≤ U₂ → (wSub Y₀ W U₁ ⟶ wSub Y₀ W U₂) :=
        fun hle => CategoryTheory.MorphismProperty.Over.homMk
          (((Fgt.obj W).left).homOfLE hle)
          (AlgebraicGeometry.Scheme.homOfLE_ι_assoc _ hle _) trivial
      have hm_u : ∀ {U₁ U₂ : ((Fgt.obj W).left).Opens} (hle : U₁ ≤ U₂),
          m_le hle ≫ uSub Y₀ W U₂ = uSub Y₀ W U₁ :=
        fun hle => CategoryTheory.MorphismProperty.Comma.Hom.ext
          (((Fgt.obj W).left).homOfLE_ι hle) (Subsingleton.elim _ _)
      have hle_a : O_ab x ≤ O_zero W a x := le_trans inf_le_left inf_le_left
      have hle_b : O_ab x ≤ O_zero W b x := le_trans inf_le_left inf_le_right
      have hle_ab : O_ab x ≤ O_zero W (a + b) x := inf_le_right
      have h_res : ∀ (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W)) (hle : O_ab x ≤ O_zero W g₀ x),
          (L_Wet.obj.map (uSub Y₀ W (O_ab x)).op).hom (ψ_z W g₀) =
            (L_Wet.obj.map (m_le hle).op).hom (sec_zero W g₀ x) := by
        intro g₀ hle
        rw [← hm_u hle, op_comp, CategoryTheory.Functor.map_comp]
        change (L_Wet.obj.map (m_le hle).op).hom
            ((L_Wet.obj.map (uSub Y₀ W (O_zero W g₀ x)).op).hom (ψ_z W g₀)) = _
        rw [hψz_spec W g₀ x]
      rw [map_add, h_res (a + b) hle_ab, h_res a hle_a, h_res b hle_b]
      by_cases hx : (pHom W).base x ∈ (W_open : Set ↥Y₀)
      · simp only [sec_zero, dif_pos hx]
        have hle_W : O_ab x ≤ (TopologicalSpace.Opens.map (pHom W).base).obj W_open :=
          le_trans hle_a (hOzero_inW W a x hx)
        let ℓ_ab := liftToWet W (O_ab x) hle_W
        have h_eq_lift : ∀ (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W))
            (hle : O_ab x ≤ O_zero W g₀ x),
            (L_Wet.obj.map (m_le hle).op).hom
              ((L_Wet.obj.map (liftToWet W (O_zero W g₀ x) (hOzero_inW W g₀ x hx)).op).hom
                (η_W.hom (g₀.1 x))) =
              (L_Wet.obj.map ℓ_ab.op).hom (η_W.hom (g₀.1 x)) := by
          intro g₀ hle
          let ℓ_g := liftToWet W (O_zero W g₀ x) (hOzero_inW W g₀ x hx)
          have hsub : m_le hle ≫ ℓ_g = ℓ_ab := hSub_Wet _ _
          have hc : ℓ_g.op ≫ (m_le hle).op = ℓ_ab.op := by rw [← op_comp, hsub]
          have hf := congrArg (fun k => k.hom (η_W.hom (g₀.1 x)))
            (L_Wet.obj.map_comp ℓ_g.op (m_le hle).op).symm
          rwa [hc] at hf
        rw [h_eq_lift (a + b) hle_ab, h_eq_lift a hle_a, h_eq_lift b hle_b]
        have h_add_η : η_W.hom ((a + b).1 x) = η_W.hom (a.1 x) + η_W.hom (b.1 x) :=
          η_W.hom.map_add (a.1 x) (b.1 x)
        rw [h_add_η, map_add]
      · simp only [sec_zero, dif_neg hx, map_zero, add_zero]
    let Ψ_zero : K_zero_Y ⟶ L_Wet := CategoryTheory.ObjectProperty.homMk
      { app := fun W => AddCommGrpCat.ofHom
          { toFun := ψ_z (Opposite.unop W)
            map_zero' := hψz_zero (Opposite.unop W)
            map_add' := hψz_add (Opposite.unop W) }
        naturality := fun {W₁ W₂} f => by
          apply AddCommGrpCat.ext
          intro (g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n (Opposite.unop W₁)))
          let U₁ := Opposite.unop W₁
          let U₂ := Opposite.unop W₂
          let g₀' : ↥(weilAltZeroBdrySubgroup Y₀ W_open n U₂) :=
            ((weilAltZeroBdrySubpresheaf Y₀ W_open n).map f).hom g₀
          change ψ_z U₂ g₀' = (L_Wet.obj.map f).hom (ψ_z U₁ g₀)
          apply hOpenSep Y₀ L_Wet U₂ (O_zero U₂ g₀') (fun y => ⟨y, hx_mem_Ozero U₂ g₀' y⟩)
          intro y
          rw [hψz_spec U₂ g₀' y]
          let x : ↥(Fgt.obj U₁).left := ((Fgt.map f.unop).left).base y
          have hx_iff : (pHom U₂).base y ∈ (W_open : Set ↥Y₀) ↔
              (pHom U₁).base x ∈ (W_open : Set ↥Y₀) := by
            have hw : ((Fgt.map f.unop).left ≫ pHom U₁).base y = (pHom U₂).base y := by
              rw [(Fgt.map f.unop).w]
            exact Eq.to_iff (congrArg (· ∈ (W_open : Set ↥Y₀)) hw.symm)
          have hrange : Set.range ⇑((O_zero U₂ g₀' y).ι ≫ (Fgt.map f.unop).left) ⊆
              Set.range ⇑(O_zero U₁ g₀ x).ι := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨z, rfl⟩
            have hz_val : g₀'.1 z.1 = g₀'.1 y := hOzero_val U₂ g₀' y z.1 z.2
            change ((Fgt.map f.unop).left).base z.1 ∈ O_zero U₁ g₀ x
            dsimp [O_zero]
            by_cases hy_in : (pHom U₂).base y ∈ (W_open : Set ↥Y₀)
            · have hx_in : (pHom U₁).base x ∈ (W_open : Set ↥Y₀) := hx_iff.mp hy_in
              rw [if_pos hx_in]
              refine ⟨?_, hz_val⟩
              have hwz : (pHom U₁).base (((Fgt.map f.unop).left).base z.1) =
                  (pHom U₂).base z.1 := by
                change ((Fgt.map f.unop).left ≫ pHom U₁).base z.1 = _
                rw [(Fgt.map f.unop).w]
              change (pHom U₁).base (((Fgt.map f.unop).left).base z.1) ∈ (W_open : Set ↥Y₀)
              rw [hwz]
              exact hOzero_inW U₂ g₀' y hy_in z.2
            · have hx_not : (pHom U₁).base x ∉ (W_open : Set ↥Y₀) :=
                fun hx_in => hy_in (hx_iff.mpr hx_in)
              rw [if_neg hx_not]
              exact hz_val
          let lift_sch := AlgebraicGeometry.IsOpenImmersion.lift (O_zero U₁ g₀ x).ι
            ((O_zero U₂ g₀' y).ι ≫ (Fgt.map f.unop).left) hrange
          have hlift_fac := AlgebraicGeometry.IsOpenImmersion.lift_fac (O_zero U₁ g₀ x).ι
            ((O_zero U₂ g₀' y).ι ≫ (Fgt.map f.unop).left) hrange
          let lift_et : wSub Y₀ U₂ (O_zero U₂ g₀' y) ⟶ wSub Y₀ U₁ (O_zero U₁ g₀ x) :=
            CategoryTheory.MorphismProperty.Over.homMk lift_sch
              (by
                change lift_sch ≫ (O_zero U₁ g₀ x).ι ≫ (Fgt.obj U₁).hom =
                  (O_zero U₂ g₀' y).ι ≫ (Fgt.obj U₂).hom
                rw [← CategoryTheory.Category.assoc, hlift_fac, CategoryTheory.Category.assoc,
                  (Fgt.map f.unop).w])
              trivial
          have hcomm_et : lift_et ≫ uSub Y₀ U₁ (O_zero U₁ g₀ x) =
              uSub Y₀ U₂ (O_zero U₂ g₀' y) ≫ f.unop :=
            CategoryTheory.MorphismProperty.Comma.Hom.ext hlift_fac (Subsingleton.elim _ _)
          have hmap_eq : (L_Wet.obj.map (uSub Y₀ U₂ (O_zero U₂ g₀' y)).op).hom
              ((L_Wet.obj.map f).hom (ψ_z U₁ g₀)) =
              (L_Wet.obj.map lift_et.op).hom
                ((L_Wet.obj.map (uSub Y₀ U₁ (O_zero U₁ g₀ x)).op).hom (ψ_z U₁ g₀)) := by
            have hc : f ≫ (uSub Y₀ U₂ (O_zero U₂ g₀' y)).op =
                (uSub Y₀ U₁ (O_zero U₁ g₀ x)).op ≫ lift_et.op := by
              change (uSub Y₀ U₂ (O_zero U₂ g₀' y) ≫ f.unop).op =
                (lift_et ≫ uSub Y₀ U₁ (O_zero U₁ g₀ x)).op
              rw [hcomm_et]
            have hfun := congrArg (fun k => k.hom (ψ_z U₁ g₀))
              (L_Wet.obj.map_comp f (uSub Y₀ U₂ (O_zero U₂ g₀' y)).op).symm
            rw [hc, L_Wet.obj.map_comp] at hfun
            exact hfun
          rw [hmap_eq, hψz_spec U₁ g₀ x]
          by_cases hy_in : (pHom U₂).base y ∈ (W_open : Set ↥Y₀)
          · have hx_in : (pHom U₁).base x ∈ (W_open : Set ↥Y₀) := hx_iff.mp hy_in
            simp only [sec_zero, dif_pos hy_in, dif_pos hx_in]
            let ℓ₁ := liftToWet U₁ (O_zero U₁ g₀ x) (hOzero_inW U₁ g₀ x hx_in)
            let ℓ₂ := liftToWet U₂ (O_zero U₂ g₀' y) (hOzero_inW U₂ g₀' y hy_in)
            have hsub : lift_et ≫ ℓ₁ = ℓ₂ := hSub_Wet _ _
            have hc : ℓ₁.op ≫ lift_et.op = ℓ₂.op := by rw [← op_comp, hsub]
            have hf := congrArg (fun k => k.hom (η_W.hom (g₀.1 x)))
              (L_Wet.obj.map_comp ℓ₁.op lift_et.op)
            rw [hc] at hf
            have hg_xy : g₀'.1 y = g₀.1 x := rfl
            rw [hg_xy]
            exact hf
          · have hx_not : (pHom U₁).base x ∉ (W_open : Set ↥Y₀) :=
              fun hx_in => hy_in (hx_iff.mpr hx_in)
            simp only [sec_zero, dif_neg hy_in, dif_neg hx_not, map_zero] }
    have hΦΨ_z : Φ_zero ≫ Ψ_zero = 𝟙 L_Wet := by
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeYoneda_comp Φ_zero Ψ_zero, hΦ_equiv]
      ext a
      change ψ_z W_et (α₀.hom a) = η_W.hom a
      apply hOpenSep Y₀ L_Wet W_et (O_zero W_et (α₀.hom a))
        (fun w => ⟨w, hx_mem_Ozero W_et (α₀.hom a) w⟩)
      intro x
      rw [hψz_spec W_et (α₀.hom a) x]
      simp only [sec_zero, dif_pos (hWet_mem x)]
      have hsub : liftToWet W_et (O_zero W_et (α₀.hom a) x)
          (hOzero_inW W_et (α₀.hom a) x (hWet_mem x)) =
          uSub Y₀ W_et (O_zero W_et (α₀.hom a) x) := hSub_Wet _ _
      rw [hsub]
      rfl
    have hΨΦ_z : Ψ_zero ≫ Φ_zero = 𝟙 K_zero_Y := by
      apply CategoryTheory.Sheaf.hom_ext
      ext opW g₀_raw
      let W := Opposite.unop opW
      let g₀ : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W) := g₀_raw
      let h_out_z : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W) :=
        (Φ_zero.hom.app (Opposite.op W)).hom (ψ_z W g₀)
      change h_out_z = g₀
      apply Subtype.ext
      apply LocallyConstant.ext
      intro x
      let W_zx := wSub Y₀ W (O_zero W g₀ x)
      let x_sub : ↥(Fgt.obj W_zx).left := (⟨x, hx_mem_Ozero W g₀ x⟩ : ↥(O_zero W g₀ x).toScheme)
      have hnat := congrArg
        (fun k : L_Wet.obj.obj (Opposite.op W) ⟶ K_zero_Y.obj.obj (Opposite.op W_zx) =>
          (k.hom (ψ_z W g₀) : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W_zx)).1 x_sub)
        (Φ_zero.hom.naturality (uSub Y₀ W (O_zero W g₀ x)).op)
      have h_eval : h_out_z.1 x =
          ((Φ_zero.hom.app (Opposite.op W_zx)).hom
            ((L_Wet.obj.map (uSub Y₀ W (O_zero W g₀ x)).op).hom (ψ_z W g₀)) :
            ↥(weilAltZeroBdrySubgroup Y₀ W_open n W_zx)).1 x_sub :=
        hnat.symm
      rw [h_eval, hψz_spec W g₀ x]
      by_cases hx : (pHom W).base x ∈ (W_open : Set ↥Y₀)
      · simp only [sec_zero, dif_pos hx]
        let ℓ_x := liftToWet W (O_zero W g₀ x) (hOzero_inW W g₀ x hx)
        have hnat_ℓ := congrArg
          (fun k : L_Wet.obj.obj (Opposite.op W_et) ⟶ K_zero_Y.obj.obj (Opposite.op W_zx) =>
            (k.hom (η_W.hom (g₀.1 x)) : ↥(weilAltZeroBdrySubgroup Y₀ W_open n W_zx)).1 x_sub)
          (Φ_zero.hom.naturality ℓ_x.op)
        have hnat_ℓ' :
            ((Φ_zero.hom.app (Opposite.op W_zx)).hom
              ((L_Wet.obj.map ℓ_x.op).hom (η_W.hom (g₀.1 x))) :
              ↥(weilAltZeroBdrySubgroup Y₀ W_open n W_zx)).1 x_sub =
            ((K_zero_Y.obj.map ℓ_x.op).hom
              ((Φ_zero.hom.app (Opposite.op W_et)).hom (η_W.hom (g₀.1 x))) :
              ↥(weilAltZeroBdrySubgroup Y₀ W_open n W_zx)).1 x_sub :=
          hnat_ℓ
        rw [hnat_ℓ']
        have hηΦ : η_W ≫ Φ_zero.hom.app (Opposite.op W_et) = α₀ := by
          rw [← hFreeYoneda_comp (𝟙 L_Wet) Φ_zero, CategoryTheory.Category.id_comp, hΦ_equiv]
        have h_app := congrArg (fun k : AM ⟶ _ => k.hom (g₀.1 x)) hηΦ
        change (Φ_zero.hom.app (Opposite.op W_et)).hom (η_W.hom (g₀.1 x)) = α₀.hom (g₀.1 x) at h_app
        rw [h_app]
        rfl
      · simp only [sec_zero, dif_neg hx, map_zero]
        exact (g₀.2 x hx).symm
    exact ⟨{ hom := Φ_zero, inv := Ψ_zero, hom_inv_id := hΦΨ_z, inv_hom_id := hΨΦ_z }, hPin_zero⟩

  
  have hDichotomy : ∀ {W_sch : AlgebraicGeometry.Scheme.{u}} (w_hom : W_sch ⟶ Y₀),
      (∀ x : ↥W_sch,
        w_hom.base x ∉ (W_open : Set ↥Y₀) ↔
          ∃ (a : Fin m) (p : ↥(CategoryTheory.Limits.pullback w_hom (τ a))),
            (CategoryTheory.Limits.pullback.fst w_hom (τ a)).base p = x) ∧
      (∀ (s : ∀ a : Fin m,
          LocallyConstant ↥(CategoryTheory.Limits.pullback w_hom (τ a)) A_type)
        (w : ↥W_sch),
        ∃ (O_w : W_sch.Opens) (_ : w ∈ O_w) (c_w : A_type),
          ∀ (b : Fin m) (p : ↥(CategoryTheory.Limits.pullback w_hom (τ b))),
            (CategoryTheory.Limits.pullback.fst w_hom (τ b)).base p ∈ (O_w : Set ↥W_sch) →
            s b p = c_w) := by
    intro W_sch w_hom
    let pr₁ : ∀ a : Fin m, CategoryTheory.Limits.pullback w_hom (τ a) ⟶ W_sch :=
      fun a => CategoryTheory.Limits.pullback.fst w_hom (τ a)
    let pr₂ : ∀ a : Fin m, CategoryTheory.Limits.pullback w_hom (τ a) ⟶ B₀ :=
      fun a => CategoryTheory.Limits.pullback.snd w_hom (τ a)
    constructor
    · intro x
      rw [hW_compl, Set.mem_compl_iff, not_not, Set.mem_iUnion]
      constructor
      · rintro ⟨a, b, hb⟩
        obtain ⟨p, hp₁, -⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := w_hom) (g := τ a) x b hb.symm
        exact ⟨a, p, hp₁⟩
      · rintro ⟨a, p, rfl⟩
        refine ⟨a, (pr₂ a).base p, ?_⟩
        change (pr₂ a ≫ τ a).base p = (pr₁ a ≫ w_hom).base p
        rw [CategoryTheory.Limits.pullback.condition]
    · intro s w
      have hEmb : ∀ a : Fin m, Topology.IsClosedEmbedding (pr₁ a).base :=
        fun a => AlgebraicGeometry.IsClosedImmersion.isClosedEmbedding (pr₁ a)
      have hDisj_F : ∀ {a b : Fin m}, a ≠ b →
          Disjoint (Set.range (pr₁ a).base) (Set.range (pr₁ b).base) := by
        intro a b hab
        rw [Set.disjoint_left]
        rintro _ ⟨p₁, rfl⟩ ⟨p₂, hp₂⟩
        have hmem_a : w_hom.base ((pr₁ a).base p₁) ∈ Set.range (τ a).base := by
          refine ⟨(pr₂ a).base p₁, ?_⟩
          change (pr₂ a ≫ τ a).base p₁ = (pr₁ a ≫ w_hom).base p₁
          rw [CategoryTheory.Limits.pullback.condition]
        have hmem_b : w_hom.base ((pr₁ a).base p₁) ∈ Set.range (τ b).base := by
          rw [← hp₂]
          refine ⟨(pr₂ b).base p₂, ?_⟩
          change (pr₂ b ≫ τ b).base p₂ = (pr₁ b ≫ w_hom).base p₂
          rw [CategoryTheory.Limits.pullback.condition]
        exact Set.disjoint_left.mp (hτ_disj hab) hmem_a hmem_b
      by_cases hw : ∃ (a₀ : Fin m) (p₀ : ↥(CategoryTheory.Limits.pullback w_hom (τ a₀))),
          (pr₁ a₀).base p₀ = w
      · obtain ⟨a₀, p₀, hp₀⟩ := hw
        let c_w : A_type := s a₀ p₀
        have hOpen_L₀ : IsOpen ((s a₀) ⁻¹' {c_w}) := (s a₀).isLocallyConstant {c_w}
        obtain ⟨U₀, hU₀_open, hU₀_pre⟩ := (hEmb a₀).isInducing.isOpen_iff.mp hOpen_L₀
        let C_other : Set ↥W_sch :=
          ⋃ b : { b : Fin m // b ≠ a₀ }, Set.range (pr₁ b.1).base
        have hClosed_other : IsClosed C_other :=
          isClosed_iUnion_of_finite (fun b => (hEmb b.1).isClosed_range)
        let O_w : W_sch.Opens := ⟨U₀ ∩ C_otherᶜ, hU₀_open.inter hClosed_other.isOpen_compl⟩
        have hw_U₀ : w ∈ U₀ := by
          rw [← hp₀]
          change p₀ ∈ (pr₁ a₀).base ⁻¹' U₀
          rw [hU₀_pre]
          rfl
        have hw_not_other : w ∉ C_other := by
          rw [Set.mem_iUnion]
          rintro ⟨⟨b, hba⟩, pb, hpb⟩
          exact Set.disjoint_left.mp (hDisj_F hba.symm) ⟨p₀, hp₀⟩ ⟨pb, hpb⟩
        refine ⟨O_w, ⟨hw_U₀, hw_not_other⟩, c_w, ?_⟩
        intro b p hp_mem
        by_cases hba : b = a₀
        · subst hba
          have hp_U₀ : p ∈ (pr₁ b).base ⁻¹' U₀ := hp_mem.1
          rw [hU₀_pre] at hp_U₀
          exact hp_U₀
        · exfalso
          exact hp_mem.2 (Set.mem_iUnion.mpr ⟨⟨b, hba⟩, p, rfl⟩)
      · let C_all : Set ↥W_sch := ⋃ a : Fin m, Set.range (pr₁ a).base
        have hClosed_all : IsClosed C_all :=
          isClosed_iUnion_of_finite (fun a => (hEmb a).isClosed_range)
        let O_w : W_sch.Opens := ⟨C_allᶜ, hClosed_all.isOpen_compl⟩
        have hw_not_all : w ∉ C_all := by
          rw [Set.mem_iUnion]
          rintro ⟨a, p, hp⟩
          exact hw ⟨a, p, hp⟩
        refine ⟨O_w, hw_not_all, 0, ?_⟩
        intro b p hp_mem
        exfalso
        exact hp_mem (Set.mem_iUnion.mpr ⟨b, p, rfl⟩)

  
  obtain ⟨e_loc_Y, hPin_Y⟩ := hIso_loc Y₀
  obtain ⟨e_loc_B, hPin_B⟩ := hIso_loc B₀
  obtain ⟨e_zero_Y, hPin_zero_Y⟩ := hIso_zero_Y

  let L_loc_Y : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    ⟨weilAltLocConstPresheaf Y₀ n, hSh_loc Y₀⟩
  let L_loc_B : CategoryTheory.Sheaf J_B AddCommGrpCat.{u} :=
    ⟨weilAltLocConstPresheaf B₀ n, hSh_loc B₀⟩
  let ι_zero_Y : K_zero_Y ⟶ L_loc_Y :=
    CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι Y₀ W_open n)

  
  have hCounitSq : counit_W ≫ e_loc_Y.hom = e_zero_Y.hom ≫ ι_zero_Y := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hFreeYoneda_comp counit_W e_loc_Y.hom, hFreeYoneda_comp e_zero_Y.hom ι_zero_Y]
    have hcounit_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv counit_W =
        (((CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj AM)).app (Opposite.op W_et)) :=
      Equiv.apply_symm_apply _ _
    rw [hcounit_eq]
    exact (hPin_Y W_et).trans hPin_zero_Y.symm

  
  let pf_fun : ∀ a : Fin m,
      CategoryTheory.Sheaf J_B AddCommGrpCat.{u} ⥤ CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun a => (weilEtaleSitePullback (τ a)).sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_B
  let pf_loc_a : Fin m → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun a => (pf_fun a).obj L_loc_B
  let ρ_loc_a : ∀ a : Fin m, L_loc_Y ⟶ pf_loc_a a :=
    fun a => CategoryTheory.ObjectProperty.homMk (weilAltLocConstPullbackNat (τ a) n)

  have hUnitPin_Y : adj_Y.unit.app AM ≫ e_loc_Y.hom.hom.app (Opposite.op T_Y) =
      weilAltLocConstConstHom Y₀ T_Y n := by
    have hUnit_Y : adj_Y.unit.app AM =
        (((CategoryTheory.sheafificationAdjunction J_Y AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite Y₀.Etale)).obj AM)).app (Opposite.op T_Y)) := by
      ext c
      simp [adj_Y, T_Y, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp]
    rw [hUnit_Y]
    exact hPin_Y T_Y

  have hUnitPin_B : adj_B.unit.app AM ≫ e_loc_B.hom.hom.app (Opposite.op T_B) =
      weilAltLocConstConstHom B₀ T_B n := by
    have hUnit_B : adj_B.unit.app AM =
        (((CategoryTheory.sheafificationAdjunction J_B AddCommGrpCat.{u}).unit.app
          ((CategoryTheory.Functor.const (Opposite B₀.Etale)).obj AM)).app (Opposite.op T_B)) := by
      ext c
      simp [adj_B, T_B, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp]
    rw [hUnit_B]
    exact hPin_B T_B

  have hSq_a : ∀ a : Fin m,
      ρ_a a ≫ (pf_fun a).map e_loc_B.hom = e_loc_Y.hom ≫ ρ_loc_a a := by
    intro a
    apply (adj_Y.homEquiv AM (pf_loc_a a)).injective
    let u_t : (weilEtaleSitePullback (τ a)).obj T_Y ⟶ T_B :=
      hT_B.from ((weilEtaleSitePullback (τ a)).obj T_Y)
    have hL : adj_Y.homEquiv AM (pf_loc_a a) (ρ_a a ≫ (pf_fun a).map e_loc_B.hom) =
        (adj_B.unit.app AM ≫ e_loc_B.hom.hom.app (Opposite.op T_B)) ≫
          L_loc_B.obj.map (Opposite.op u_t) := by
      rw [adj_Y.homEquiv_naturality_right (ρ_a a) ((pf_fun a).map e_loc_B.hom)]
      have hρa : adj_Y.homEquiv AM (pf_a a) (ρ_a a) =
          adj_B.unit.app AM ≫ F_B.obj.map (Opposite.op u_t) :=
        Equiv.apply_symm_apply _ _
      rw [hρa]
      have hnat_B : F_B.obj.map (Opposite.op u_t) ≫
          e_loc_B.hom.hom.app (Opposite.op ((weilEtaleSitePullback (τ a)).obj T_Y)) =
          e_loc_B.hom.hom.app (Opposite.op T_B) ≫ L_loc_B.obj.map (Opposite.op u_t) :=
        e_loc_B.hom.hom.naturality (Opposite.op u_t)
      exact (CategoryTheory.Category.assoc (adj_B.unit.app AM) _ _).trans
        ((congrArg (adj_B.unit.app AM ≫ ·) hnat_B).trans
          (CategoryTheory.Category.assoc _ _ _).symm)
    have hR : adj_Y.homEquiv AM (pf_loc_a a) (e_loc_Y.hom ≫ ρ_loc_a a) =
        (adj_Y.unit.app AM ≫ e_loc_Y.hom.hom.app (Opposite.op T_Y)) ≫
          (ρ_loc_a a).hom.app (Opposite.op T_Y) := by
      rw [adj_Y.homEquiv_unit]
      exact (CategoryTheory.Category.assoc _ _ _).symm
    rw [hL, hR, hUnitPin_B, hUnitPin_Y]
    exact AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))

  let Q_loc : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} := CategoryTheory.Limits.piObj pf_loc_a
  let ρ_loc : L_loc_Y ⟶ Q_loc := CategoryTheory.Limits.Pi.lift ρ_loc_a
  have hρ_loc_π : ∀ a : Fin m, ρ_loc ≫ CategoryTheory.Limits.Pi.π pf_loc_a a = ρ_loc_a a := by
    intro a
    simp only [ρ_loc, CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
      CategoryTheory.Limits.Fan.mk_π_app]
  let e_Q : Q ≅ Q_loc :=
    { hom := CategoryTheory.Limits.Pi.lift
        (fun a => CategoryTheory.Limits.Pi.π pf_a a ≫ (pf_fun a).map e_loc_B.hom)
      inv := CategoryTheory.Limits.Pi.lift
        (fun a => CategoryTheory.Limits.Pi.π pf_loc_a a ≫ (pf_fun a).map e_loc_B.inv)
      hom_inv_id := by
        apply CategoryTheory.Limits.Pi.hom_ext
        intro a
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
          CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app,
          CategoryTheory.Category.id_comp]
        rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.Pi.lift _),
          CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_π_app,
          CategoryTheory.Category.assoc, ← (pf_fun a).map_comp, e_loc_B.hom_inv_id,
          (pf_fun a).map_id, CategoryTheory.Category.comp_id]
      inv_hom_id := by
        apply CategoryTheory.Limits.Pi.hom_ext
        intro a
        simp only [CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
          CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app,
          CategoryTheory.Category.id_comp]
        rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.Pi.lift _),
          CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_π_app,
          CategoryTheory.Category.assoc, ← (pf_fun a).map_comp, e_loc_B.inv_hom_id,
          (pf_fun a).map_id, CategoryTheory.Category.comp_id] }

  have hρ_sq : e_loc_Y.hom ≫ ρ_loc = ρ ≫ e_Q.hom := by
    apply CategoryTheory.Limits.Pi.hom_ext
    intro a
    simp only [ρ_loc, ρ, e_Q, CategoryTheory.Category.assoc, CategoryTheory.Limits.limit.lift_π,
      CategoryTheory.Limits.Fan.mk_pt, CategoryTheory.Limits.Fan.mk_π_app]
    rw [← CategoryTheory.Category.assoc ρ, CategoryTheory.Limits.limit.lift_π,
      CategoryTheory.Limits.Fan.mk_π_app]
    exact (hSq_a a).symm

  
  have hMono_ι : CategoryTheory.Mono ι_zero_Y := by
    constructor
    intro E g₁ g₂ heq
    ext opW s
    exact Subtype.ext (congrArg
      (fun k : E ⟶ L_loc_Y => (k.hom.app opW).hom s) heq)

  have h0_loc : ι_zero_Y ≫ ρ_loc = 0 := by
    apply CategoryTheory.Limits.Pi.hom_ext
    intro a
    rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Category.assoc, hρ_loc_π a]
    ext opW g₀
    let W := Opposite.unop opW
    let FgtY := AlgebraicGeometry.Scheme.Etale.forget Y₀
    let w_hom : (FgtY.obj W).left ⟶ Y₀ := (FgtY.obj W).hom
    apply LocallyConstant.ext
    intro p
    have hnot : w_hom.base ((CategoryTheory.Limits.pullback.fst w_hom (τ a)).base p) ∉
        (W_open : Set ↥Y₀) :=
      (hDichotomy w_hom).1 _ |>.mpr ⟨a, p, rfl⟩
    exact g₀.2 _ hnot

  have hKer_loc : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι ι_zero_Y h0_loc) := by
    refine CategoryTheory.Limits.KernelFork.IsLimit.ofι ι_zero_Y h0_loc
      (fun {E} w hw =>
        CategoryTheory.ObjectProperty.homMk
          { app := fun opW =>
              let W := Opposite.unop opW
              let FgtY := AlgebraicGeometry.Scheme.Etale.forget Y₀
              let w_hom : (FgtY.obj W).left ⟶ Y₀ := (FgtY.obj W).hom
              AddCommGrpCat.ofHom
                { toFun := fun e =>
                    ⟨(w.hom.app opW).hom e, by
                      intro x hx
                      obtain ⟨a, p, rfl⟩ := (hDichotomy w_hom).1 x |>.mp hx
                      have hwa : w ≫ ρ_loc_a a = 0 := by
                        have h1 : (w ≫ ρ_loc) ≫ CategoryTheory.Limits.Pi.π pf_loc_a a = 0 := by
                          rw [hw, CategoryTheory.Limits.zero_comp]
                        rwa [CategoryTheory.Category.assoc, hρ_loc_π a] at h1
                      let toLC_a : ↥((pf_loc_a a).obj.obj opW) →
                          LocallyConstant
                            ↥(CategoryTheory.Limits.pullback w_hom (τ a)) A_type :=
                        fun s => s
                      have hf0 : ((w ≫ ρ_loc_a a).hom.app opW).hom e = 0 :=
                        congrArg (fun k : E ⟶ pf_loc_a a => (k.hom.app opW).hom e) hwa
                      exact congrArg (fun s => toLC_a s p) hf0⟩
                  map_zero' := Subtype.ext (map_zero (w.hom.app opW).hom)
                  map_add' := fun e₁ e₂ => Subtype.ext (map_add (w.hom.app opW).hom e₁ e₂) }
            naturality := fun {W₁ W₂} f => by
              apply AddCommGrpCat.ext
              intro e
              apply Subtype.ext
              exact congrArg (fun k : E.obj.obj W₁ ⟶ _ => k.hom e) (w.hom.naturality f) })
      (fun {E} w hw => by
        ext opW e
        rfl)
      (fun {E} w hw m hm => by
        apply (cancel_mono ι_zero_Y).mp
        exact hm)

  
  have hPi_sec_ext : ∀ (V : Y₀.Etale) {q₁ q₂ : ↥(Q_loc.obj.obj (Opposite.op V))},
      (∀ a : Fin m,
        ((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app (Opposite.op V)).hom q₁ =
          ((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app (Opposite.op V)).hom q₂) →
      q₁ = q₂ := by
    intro V q₁ q₂ hproj
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let zHom : ∀ {G : AddCommGrpCat.{u}}, ↥G → (Aℤ ⟶ G) :=
      fun x => AddCommGrpCat.ofHom
        { toFun := fun k => k.down • x
          map_zero' := zero_smul ℤ x
          map_add' := fun k₁ k₂ => add_smul k₁.down k₂.down x }
    let α₁ : CategoryTheory.Sheaf.freeYoneda J_Y V Aℤ ⟶ Q_loc :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (zHom q₁)
    let α₂ : CategoryTheory.Sheaf.freeYoneda J_Y V Aℤ ⟶ Q_loc :=
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (zHom q₂)
    have hα_eq : α₁ = α₂ := by
      apply CategoryTheory.Limits.Pi.hom_ext
      intro a
      apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [hFreeYoneda_comp α₁, hFreeYoneda_comp α₂]
      have he₁ : CategoryTheory.Sheaf.freeYonedaHomEquiv α₁ = zHom q₁ :=
        Equiv.apply_symm_apply _ _
      have he₂ : CategoryTheory.Sheaf.freeYonedaHomEquiv α₂ = zHom q₂ :=
        Equiv.apply_symm_apply _ _
      rw [he₁, he₂]
      ext k
      change ((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app (Opposite.op V)).hom
          (k.down • q₁) =
        ((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app (Opposite.op V)).hom
          (k.down • q₂)
      rw [map_zsmul, map_zsmul, hproj a]
    have hz_eq : zHom q₁ = zHom q₂ := by
      calc
        zHom q₁ = CategoryTheory.Sheaf.freeYonedaHomEquiv α₁ :=
          (Equiv.apply_symm_apply _ _).symm
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α₂ := by rw [hα_eq]
        _ = zHom q₂ := Equiv.apply_symm_apply _ _
    have h1 := congrArg (fun f : Aℤ ⟶ _ => f.hom (ULift.up (1 : ℤ))) hz_eq
    change (1 : ℤ) • q₁ = (1 : ℤ) • q₂ at h1
    rwa [one_smul, one_smul] at h1

  have hLocSurj : CategoryTheory.Sheaf.IsLocallySurjective ρ_loc := by
    refine ⟨?_⟩
    intro W q
    rw [hMemTop]
    intro w
    let FgtY := AlgebraicGeometry.Scheme.Etale.forget Y₀
    let FgtB := AlgebraicGeometry.Scheme.Etale.forget B₀
    let w_hom : (FgtY.obj W).left ⟶ Y₀ := (FgtY.obj W).hom
    let s : ∀ a : Fin m,
        LocallyConstant ↥(CategoryTheory.Limits.pullback w_hom (τ a)) A_type :=
      fun a => ((CategoryTheory.Limits.Pi.π pf_loc_a a).hom.app (Opposite.op W)).hom q
    obtain ⟨O_w, hw_O, c_w, hval⟩ := (hDichotomy w_hom).2 s w
    let W' := wSub Y₀ W O_w
    let u_w : W' ⟶ W := uSub Y₀ W O_w
    refine ⟨W', u_w, ⟨w, hw_O⟩, ?_, inferInstance, rfl⟩
    refine ⟨LocallyConstant.const ↥(FgtY.obj W').left c_w, ?_⟩
    apply hPi_sec_ext W'
    intro b
    have hLHS : ((CategoryTheory.Limits.Pi.π pf_loc_a b).hom.app (Opposite.op W')).hom
        ((ρ_loc.hom.app (Opposite.op W')).hom (LocallyConstant.const _ c_w)) =
        ((ρ_loc_a b).hom.app (Opposite.op W')).hom (LocallyConstant.const _ c_w) :=
      congrArg
        (fun k : L_loc_Y ⟶ pf_loc_a b =>
          (k.hom.app (Opposite.op W')).hom (LocallyConstant.const _ c_w))
        (hρ_loc_π b)
    have hRHS : ((CategoryTheory.Limits.Pi.π pf_loc_a b).hom.app (Opposite.op W')).hom
        ((Q_loc.obj.map u_w.op).hom q) =
        ((pf_loc_a b).obj.map u_w.op).hom (s b) :=
      congrArg (fun k : Q_loc.obj.obj (Opposite.op W) ⟶ _ => k.hom q)
        ((CategoryTheory.Limits.Pi.π pf_loc_a b).hom.naturality u_w.op)
    rw [hLHS, hRHS]
    apply LocallyConstant.ext
    intro z
    let map_pb : (FgtB.obj ((weilEtaleSitePullback (τ b)).obj W')).left ⟶
        (FgtB.obj ((weilEtaleSitePullback (τ b)).obj W)).left :=
      (FgtB.map ((weilEtaleSitePullback (τ b)).map u_w)).left
    let p : ↥(CategoryTheory.Limits.pullback w_hom (τ b)) := map_pb.base z
    have h_lift_fst : map_pb ≫ CategoryTheory.Limits.pullback.fst ((FgtY.obj W).hom) (τ b) =
        CategoryTheory.Limits.pullback.fst ((FgtY.obj W').hom) (τ b) ≫
          (FgtY.map u_w).left :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hp_fst : (CategoryTheory.Limits.pullback.fst w_hom (τ b)).base p =
        O_w.ι.base
          ((CategoryTheory.Limits.pullback.fst ((FgtY.obj W').hom) (τ b)).base z) :=
      congrArg (fun k : (FgtB.obj ((weilEtaleSitePullback (τ b)).obj W')).left ⟶
          (FgtY.obj W).left => k.base z) h_lift_fst
    have hp_mem : (CategoryTheory.Limits.pullback.fst w_hom (τ b)).base p ∈
        (O_w : Set ↥(FgtY.obj W).left) := by
      rw [hp_fst]
      exact ((CategoryTheory.Limits.pullback.fst ((FgtY.obj W').hom) (τ b)).base z).2
    exact (hval b p hp_mem).symm

  have hEpi_ρ : CategoryTheory.Epi ρ_loc := by
    have : CategoryTheory.Sheaf.IsLocallySurjective ρ_loc := hLocSurj
    exact CategoryTheory.Sheaf.epi_of_isLocallySurjective ρ_loc

  
  let S_loc := CategoryTheory.ShortComplex.mk ι_zero_Y ρ_loc h0_loc
  have hEx_loc : S_loc.Exact :=
    CategoryTheory.ShortComplex.exact_of_f_is_kernel S_loc hKer_loc
  have hSE_loc : S_loc.ShortExact :=
    CategoryTheory.ShortComplex.ShortExact.mk' hEx_loc hMono_ι hEpi_ρ

  have hzero : counit_W ≫ ρ = 0 := by
    have h_eq : (counit_W ≫ ρ) ≫ e_Q.hom = 0 := by
      rw [CategoryTheory.Category.assoc, ← hρ_sq, ← CategoryTheory.Category.assoc,
        hCounitSq, CategoryTheory.Category.assoc, h0_loc, CategoryTheory.Limits.comp_zero]
    calc
      counit_W ≫ ρ = (counit_W ≫ ρ) ≫ (e_Q.hom ≫ e_Q.inv) := by
        rw [e_Q.hom_inv_id, CategoryTheory.Category.comp_id]
      _ = ((counit_W ≫ ρ) ≫ e_Q.hom) ≫ e_Q.inv :=
        (CategoryTheory.Category.assoc _ _ _).symm
      _ = 0 := by rw [h_eq, CategoryTheory.Limits.zero_comp]

  refine ⟨hzero, ?_⟩
  let iso_S : S_loc ≅ CategoryTheory.ShortComplex.mk counit_W ρ hzero :=
    CategoryTheory.ShortComplex.isoMk e_zero_Y.symm e_loc_Y.symm e_Q.symm
      (by
        dsimp [S_loc]
        calc
          e_zero_Y.inv ≫ counit_W
            = e_zero_Y.inv ≫ counit_W ≫ (e_loc_Y.hom ≫ e_loc_Y.inv) := by
                rw [e_loc_Y.hom_inv_id, CategoryTheory.Category.comp_id]
          _ = e_zero_Y.inv ≫ (counit_W ≫ e_loc_Y.hom) ≫ e_loc_Y.inv := by
                simp only [CategoryTheory.Category.assoc]
          _ = (e_zero_Y.inv ≫ e_zero_Y.hom) ≫ ι_zero_Y ≫ e_loc_Y.inv := by
                rw [hCounitSq]
                simp only [CategoryTheory.Category.assoc]
          _ = ι_zero_Y ≫ e_loc_Y.inv := by
                rw [e_zero_Y.inv_hom_id, CategoryTheory.Category.id_comp])
      (by
        dsimp [S_loc]
        calc
          e_loc_Y.inv ≫ ρ
            = e_loc_Y.inv ≫ ρ ≫ (e_Q.hom ≫ e_Q.inv) := by
                rw [e_Q.hom_inv_id, CategoryTheory.Category.comp_id]
          _ = e_loc_Y.inv ≫ (ρ ≫ e_Q.hom) ≫ e_Q.inv := by
                simp only [CategoryTheory.Category.assoc]
          _ = (e_loc_Y.inv ≫ e_loc_Y.hom) ≫ ρ_loc ≫ e_Q.inv := by
                rw [← hρ_sq]
                simp only [CategoryTheory.Category.assoc]
          _ = ρ_loc ≫ e_Q.inv := by
                rw [e_loc_Y.inv_hom_id, CategoryTheory.Category.id_comp])
  exact CategoryTheory.ShortComplex.shortExact_of_iso iso_S hSE_loc

theorem weil_etale_closedImmersion_section_pushforward_exact_and_r1_isZero (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Y₁ U₁ : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine U₁]
    (f₁ : Quiver.Hom Y₁ U₁)
    (τ : Quiver.Hom U₁ Y₁)
    (hτ_sec : CategoryTheory.CategoryStruct.comp τ f₁ = CategoryTheory.CategoryStruct.id U₁)
    [AlgebraicGeometry.IsClosedImmersion τ]
    (hc_τ : (weilEtaleSitePullback τ).IsContinuous Y₁.smallEtaleTopology U₁.smallEtaleTopology)
    (hr_τ : ((weilEtaleSitePullback τ).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y₁.smallEtaleTopology U₁.smallEtaleTopology).IsRightAdjoint)
    (hc_f₁ : (weilEtaleSitePullback f₁).IsContinuous U₁.smallEtaleTopology Y₁.smallEtaleTopology) :
    letI : (weilEtaleSitePullback τ).IsContinuous Y₁.smallEtaleTopology U₁.smallEtaleTopology := hc_τ
    letI : ((weilEtaleSitePullback τ).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y₁.smallEtaleTopology U₁.smallEtaleTopology).IsRightAdjoint := hr_τ
    letI : (weilEtaleSitePullback f₁).IsContinuous U₁.smallEtaleTopology Y₁.smallEtaleTopology := hc_f₁
    let pf_τ := (weilEtaleSitePullback τ).sheafPushforwardContinuous
      AddCommGrpCat.{u} Y₁.smallEtaleTopology U₁.smallEtaleTopology
    (∀ {G₁ G₂ : CategoryTheory.Sheaf U₁.smallEtaleTopology AddCommGrpCat.{u}}
      (α : Quiver.Hom G₁ G₂) [CategoryTheory.Epi α],
      CategoryTheory.Epi (pf_τ.map α)) ∧
    (∀ (F : CategoryTheory.Sheaf U₁.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₁ 1 (pf_τ.obj F))) :=
by
  have : (weilEtaleSitePullback τ).IsContinuous Y₁.smallEtaleTopology U₁.smallEtaleTopology := hc_τ
  let _ : ((weilEtaleSitePullback τ).sheafPushforwardContinuous
    AddCommGrpCat.{u} Y₁.smallEtaleTopology U₁.smallEtaleTopology).IsRightAdjoint := hr_τ
  have : (weilEtaleSitePullback f₁).IsContinuous U₁.smallEtaleTopology Y₁.smallEtaleTopology := hc_f₁
  intro pf_τ
  
  have hPointLift : ∀ (W : Y₁.Etale) (w : ↥W.left)
      (p₀ : ↥((weilEtaleSitePullback τ).obj W).left),
      (CategoryTheory.Limits.pullback.fst W.hom τ).base p₀ = w →
      ∀ (V_U : U₁.Etale) (g_U : Quiver.Hom V_U ((weilEtaleSitePullback τ).obj W))
        (v₀ : ↥V_U.left),
        g_U.left.base v₀ = p₀ →
        ∃ (W' : Y₁.Etale) (u' : Quiver.Hom W' W) (w' : ↥W'.left)
          (h' : Quiver.Hom ((weilEtaleSitePullback τ).obj W') V_U),
          AlgebraicGeometry.Etale u'.left ∧
          u'.left.base w' = w ∧
          CategoryTheory.CategoryStruct.comp h' g_U = (weilEtaleSitePullback τ).map u' := by
    intro W w p₀ hp₀ V_U g_U v₀ hv₀
    let B_τ := weilEtaleSitePullback τ
    let W_sch : AlgebraicGeometry.Scheme.{u} := W.left
    let w_hom : W_sch ⟶ Y₁ := W.hom
    let VU_sch : AlgebraicGeometry.Scheme.{u} := V_U.left
    let vu_hom : VU_sch ⟶ U₁ := V_U.hom
    let gu_hom : VU_sch ⟶ CategoryTheory.Limits.pullback w_hom τ := g_U.left
    let Z₀ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback w_hom τ
    let pr₁ : Z₀ ⟶ W_sch := CategoryTheory.Limits.pullback.fst w_hom τ
    let pr₂ : Z₀ ⟶ U₁ := CategoryTheory.Limits.pullback.snd w_hom τ
    have hEt_W : AlgebraicGeometry.Etale w_hom := W.prop
    have hEt_VU : AlgebraicGeometry.Etale vu_hom := V_U.prop
    have hEt_pr₂ : AlgebraicGeometry.Etale pr₂ := (B_τ.obj W).prop
    have hg_U_w : gu_hom ≫ pr₂ = vu_hom := g_U.w
    let P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback (w_hom ≫ f₁) vu_hom
    let q_W : P ⟶ W_sch := CategoryTheory.Limits.pullback.fst (w_hom ≫ f₁) vu_hom
    let q_V : P ⟶ VU_sch := CategoryTheory.Limits.pullback.snd (w_hom ≫ f₁) vu_hom
    have hEt_qW : AlgebraicGeometry.Etale q_W :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (w_hom ≫ f₁) vu_hom).flip hEt_VU
    have hEt_WP : AlgebraicGeometry.Etale (q_W ≫ w_hom) := inferInstance
    let W_P : Y₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (q_W ≫ w_hom) hEt_WP
    let u_P : W_P ⟶ W := CategoryTheory.MorphismProperty.Over.homMk q_W rfl
    have hcomm₁ : (gu_hom ≫ pr₁) ≫ (w_hom ≫ f₁) = 𝟙 VU_sch ≫ vu_hom := by
      calc (gu_hom ≫ pr₁) ≫ (w_hom ≫ f₁)
          = gu_hom ≫ (pr₁ ≫ w_hom) ≫ f₁ := by simp only [CategoryTheory.Category.assoc]
        _ = gu_hom ≫ (pr₂ ≫ τ) ≫ f₁ := by
            dsimp [pr₁, pr₂]
            rw [CategoryTheory.Limits.pullback.condition]
        _ = (gu_hom ≫ pr₂) ≫ (τ ≫ f₁) := by simp only [CategoryTheory.Category.assoc]
        _ = vu_hom ≫ 𝟙 U₁ := by rw [hg_U_w, hτ_sec]
        _ = 𝟙 VU_sch ≫ vu_hom := by
            rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    let σ_V : VU_sch ⟶ P :=
      CategoryTheory.Limits.pullback.lift (gu_hom ≫ pr₁) (𝟙 VU_sch) hcomm₁
    let z₀ : ↥P := σ_V.base v₀
    have hz₀_W : q_W.base z₀ = w := by
      have h1 := congrArg (fun m : VU_sch ⟶ W_sch => m.base v₀)
        (CategoryTheory.Limits.pullback.lift_fst (gu_hom ≫ pr₁) (𝟙 VU_sch) hcomm₁)
      change q_W.base z₀ = pr₁.base (g_U.left.base v₀) at h1
      rw [hv₀] at h1
      exact h1.trans hp₀
    let Z_P : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback (q_W ≫ w_hom) τ
    let π_P : Z_P ⟶ P := CategoryTheory.Limits.pullback.fst (q_W ≫ w_hom) τ
    let π_U : Z_P ⟶ U₁ := CategoryTheory.Limits.pullback.snd (q_W ≫ w_hom) τ
    have hCl_πP : AlgebraicGeometry.IsClosedImmersion π_P :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback (q_W ≫ w_hom) τ).flip inferInstance
    have hcomm₂ : σ_V ≫ (q_W ≫ w_hom) = vu_hom ≫ τ := by
      calc σ_V ≫ (q_W ≫ w_hom)
          = (σ_V ≫ q_W) ≫ w_hom := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (gu_hom ≫ pr₁) ≫ w_hom := by
            dsimp [σ_V, q_W]
            rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = gu_hom ≫ (pr₁ ≫ w_hom) := CategoryTheory.Category.assoc _ _ _
        _ = gu_hom ≫ (pr₂ ≫ τ) := by
            dsimp [pr₁, pr₂]
            rw [CategoryTheory.Limits.pullback.condition]
        _ = (gu_hom ≫ pr₂) ≫ τ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = vu_hom ≫ τ := by rw [hg_U_w]
    let σ_tilde : VU_sch ⟶ Z_P :=
      CategoryTheory.Limits.pullback.lift σ_V vu_hom hcomm₂
    let p_tilde₀ : ↥Z_P := σ_tilde.base v₀
    have hp_tilde_π : π_P.base p_tilde₀ = z₀ :=
      congrArg (fun m : VU_sch ⟶ P => m.base v₀)
        (CategoryTheory.Limits.pullback.lift_fst σ_V vu_hom hcomm₂)
    have h_PV_w : (π_P ≫ q_V) ≫ V_U.hom = (B_τ.obj W_P).hom := by
      change (π_P ≫ q_V) ≫ vu_hom = π_U
      calc (π_P ≫ q_V) ≫ vu_hom
          = π_P ≫ (q_V ≫ vu_hom) := CategoryTheory.Category.assoc _ _ _
        _ = π_P ≫ (q_W ≫ (w_hom ≫ f₁)) := by
            dsimp [q_V, q_W]
            rw [← CategoryTheory.Limits.pullback.condition]
        _ = (π_P ≫ (q_W ≫ w_hom)) ≫ f₁ := by simp only [CategoryTheory.Category.assoc]
        _ = (π_U ≫ τ) ≫ f₁ := by
            dsimp [π_P, π_U]
            rw [CategoryTheory.Limits.pullback.condition]
        _ = π_U ≫ (τ ≫ f₁) := CategoryTheory.Category.assoc _ _ _
        _ = π_U := by rw [hτ_sec, CategoryTheory.Category.comp_id]
    let h_PV : B_τ.obj W_P ⟶ V_U :=
      CategoryTheory.MorphismProperty.Over.homMk (π_P ≫ q_V) h_PV_w
    let m₁ : Z_P ⟶ Z₀ := (h_PV ≫ g_U).left
    let m₂ : Z_P ⟶ Z₀ := (B_τ.map u_P).left
    have hm₁_w : m₁ ≫ pr₂ = π_U := (h_PV ≫ g_U).w
    have hm₂_w : m₂ ≫ pr₂ = π_U := (B_τ.map u_P).w
    have hσ_m₁ : σ_tilde ≫ m₁ = gu_hom := by
      change σ_tilde ≫ ((π_P ≫ q_V) ≫ gu_hom) = gu_hom
      calc σ_tilde ≫ ((π_P ≫ q_V) ≫ gu_hom)
          = ((σ_tilde ≫ π_P) ≫ q_V) ≫ gu_hom := by simp only [CategoryTheory.Category.assoc]
        _ = (σ_V ≫ q_V) ≫ gu_hom := by
            dsimp [σ_tilde, π_P]
            rw [CategoryTheory.Limits.pullback.lift_fst]
        _ = 𝟙 VU_sch ≫ gu_hom := by
            dsimp [σ_V, q_V]
            rw [CategoryTheory.Limits.pullback.lift_snd]
        _ = gu_hom := CategoryTheory.Category.id_comp _
    have hσ_m₂ : σ_tilde ≫ m₂ = gu_hom := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (σ_tilde ≫ m₂) ≫ pr₁ = gu_hom ≫ pr₁
        calc (σ_tilde ≫ m₂) ≫ pr₁
            = σ_tilde ≫ (m₂ ≫ pr₁) := CategoryTheory.Category.assoc _ _ _
          _ = σ_tilde ≫ (π_P ≫ q_W) :=
              congrArg (σ_tilde ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          _ = (σ_tilde ≫ π_P) ≫ q_W := (CategoryTheory.Category.assoc _ _ _).symm
          _ = σ_V ≫ q_W :=
              congrArg (· ≫ q_W) (CategoryTheory.Limits.pullback.lift_fst σ_V vu_hom hcomm₂)
          _ = gu_hom ≫ pr₁ :=
              CategoryTheory.Limits.pullback.lift_fst (gu_hom ≫ pr₁) (𝟙 VU_sch) hcomm₁
      · change (σ_tilde ≫ m₂) ≫ pr₂ = gu_hom ≫ pr₂
        calc (σ_tilde ≫ m₂) ≫ pr₂
            = σ_tilde ≫ (m₂ ≫ pr₂) := CategoryTheory.Category.assoc _ _ _
          _ = σ_tilde ≫ π_U := congrArg (σ_tilde ≫ ·) hm₂_w
          _ = vu_hom := CategoryTheory.Limits.pullback.lift_snd σ_V vu_hom hcomm₂
          _ = gu_hom ≫ pr₂ := hg_U_w.symm
    let Δ_Z₀ : Z₀ ⟶ CategoryTheory.Limits.pullback pr₂ pr₂ :=
      CategoryTheory.Limits.pullback.diagonal pr₂
    have hOpen_Δ : AlgebraicGeometry.IsOpenImmersion Δ_Z₀ := inferInstance
    let d : Z_P ⟶ CategoryTheory.Limits.pullback pr₂ pr₂ :=
      CategoryTheory.Limits.pullback.lift m₁ m₂ (hm₁_w.trans hm₂_w.symm)
    let E_eq : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback Δ_Z₀ d
    let j_eq : E_eq ⟶ Z_P := CategoryTheory.Limits.pullback.snd Δ_Z₀ d
    have hOpen_jeq : AlgebraicGeometry.IsOpenImmersion j_eq := inferInstance
    have hjeq_eq : j_eq ≫ m₁ = j_eq ≫ m₂ := by
      have hcond := CategoryTheory.Limits.pullback.condition (f := Δ_Z₀) (g := d)
      have h1 : CategoryTheory.Limits.pullback.fst Δ_Z₀ d = j_eq ≫ m₁ := by
        have raw := congrArg (· ≫ CategoryTheory.Limits.pullback.fst pr₂ pr₂) hcond
        dsimp [Δ_Z₀, d, j_eq] at raw
        simpa only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.comp_id, CategoryTheory.Limits.pullback.lift_fst] using raw
      have h2 : CategoryTheory.Limits.pullback.fst Δ_Z₀ d = j_eq ≫ m₂ := by
        have raw := congrArg (· ≫ CategoryTheory.Limits.pullback.snd pr₂ pr₂) hcond
        dsimp [Δ_Z₀, d, j_eq] at raw
        simpa only [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Limits.pullback.lift_snd] using raw
      exact h1.symm.trans h2
    have h_diag : gu_hom ≫ Δ_Z₀ = σ_tilde ≫ d := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [Δ_Z₀, d]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_fst,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, hσ_m₁]
      · dsimp [Δ_Z₀, d]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.diagonal_snd,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, hσ_m₂]
    let l_V : VU_sch ⟶ E_eq :=
      CategoryTheory.Limits.pullback.lift gu_hom σ_tilde h_diag
    have hp_tilde_mem : p_tilde₀ ∈ Set.range j_eq.base := by
      refine ⟨l_V.base v₀, ?_⟩
      exact congrArg (fun m : VU_sch ⟶ Z_P => m.base v₀)
        (CategoryTheory.Limits.pullback.lift_snd gu_hom σ_tilde h_diag)
    let K_bad : Set ↥Z_P := (Set.range j_eq.base)ᶜ
    have hClosed_Kbad : IsClosed K_bad := j_eq.isOpenEmbedding.isOpen_range.isClosed_compl
    have hClosed_im : IsClosed (π_P.base '' K_bad) :=
      π_P.isClosedEmbedding.isClosedMap K_bad hClosed_Kbad
    have hz₀_not : z₀ ∉ π_P.base '' K_bad := by
      rintro ⟨q, hq_bad, hq_eq⟩
      have hqp : q = p_tilde₀ :=
        π_P.isClosedEmbedding.injective (hq_eq.trans hp_tilde_π.symm)
      exact hq_bad (hqp ▸ hp_tilde_mem)
    let O_P : P.Opens := ⟨(π_P.base '' K_bad)ᶜ, hClosed_im.isOpen_compl⟩
    have hEt_OP : AlgebraicGeometry.Etale (O_P.ι ≫ (q_W ≫ w_hom)) := inferInstance
    let W' : Y₁.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (O_P.ι ≫ (q_W ≫ w_hom)) hEt_OP
    let u_WP : W' ⟶ W_P := CategoryTheory.MorphismProperty.Over.homMk O_P.ι rfl
    let u' : W' ⟶ W := u_WP ≫ u_P
    let w' : ↥W'.left := ⟨z₀, hz₀_not⟩
    let h' : B_τ.obj W' ⟶ V_U := B_τ.map u_WP ≫ h_PV
    have hEt_u' : AlgebraicGeometry.Etale u'.left := by
      change AlgebraicGeometry.Etale (O_P.ι ≫ q_W)
      infer_instance
    have hw'_eq : u'.left.base w' = w := by
      change q_W.base (O_P.ι.base w') = w
      have hι : O_P.ι.base w' = z₀ := rfl
      rw [hι, hz₀_W]
    let Z'_sch : AlgebraicGeometry.Scheme.{u} := (B_τ.obj W').left
    let ι_Z' : Z'_sch ⟶ Z_P := (B_τ.map u_WP).left
    have hRange : Set.range ι_Z'.base ⊆ Set.range j_eq.base := by
      rintro _ ⟨z', rfl⟩
      by_contra hz_not
      have hz_bad : ι_Z'.base z' ∈ K_bad := hz_not
      let fst_W' := CategoryTheory.Limits.pullback.fst (O_P.ι ≫ (q_W ≫ w_hom)) τ
      have h_ιπ : ι_Z' ≫ π_P = fst_W' ≫ O_P.ι :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_pt : π_P.base (ι_Z'.base z') = O_P.ι.base (fst_W'.base z') :=
        congrArg (fun m : Z'_sch ⟶ P => m.base z') h_ιπ
      have h_in_OP : O_P.ι.base (fst_W'.base z') ∈ (O_P : Set ↥P) := (fst_W'.base z').2
      rw [← h_pt] at h_in_OP
      exact h_in_OP ⟨ι_Z'.base z', hz_bad, rfl⟩
    let k_Z' : Z'_sch ⟶ E_eq :=
      AlgebraicGeometry.IsOpenImmersion.lift j_eq ι_Z' hRange
    have hk_fac : k_Z' ≫ j_eq = ι_Z' :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac j_eq ι_Z' hRange
    have hcomm_final : h' ≫ g_U = B_τ.map u' := by
      apply CategoryTheory.MorphismProperty.Comma.Hom.ext
      · change ι_Z' ≫ m₁ = (B_τ.map u').left
        have hmap_comp : (B_τ.map u').left = ι_Z' ≫ m₂ := by
          dsimp [u']
          rw [B_τ.map_comp]
          rfl
        rw [hmap_comp, ← hk_fac, CategoryTheory.Category.assoc, hjeq_eq,
          ← CategoryTheory.Category.assoc]
      · exact Subsingleton.elim _ _
    exact ⟨W', u', w', h', hEt_u', hw'_eq, hcomm_final⟩
  
  have hPushEpi : ∀ {G₁ G₂ : CategoryTheory.Sheaf U₁.smallEtaleTopology AddCommGrpCat.{u}}
      (α : Quiver.Hom G₁ G₂) [CategoryTheory.Epi α],
      CategoryTheory.Epi (pf_τ.map α) := by
    intro G₁ G₂ α _
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : P_et.IsStableUnderComposition :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hMemEt : ∀ {S : AlgebraicGeometry.Scheme.{u}} (X : S.Etale) (R : CategoryTheory.Sieve X),
        R ∈ S.smallEtaleTopology X ↔
          ∀ (x : ↥X.left), ∃ (Y : S.Etale) (f : Y ⟶ X) (y : ↥Y.left),
            R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left.base y = x := by
      intro S X R
      exact (iff_of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale =>
        R ∈ J X) (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          S (le_refl P_et)))).trans
        (@AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          P_et P_et S inferInstance
