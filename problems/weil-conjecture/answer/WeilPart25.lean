          have hg_eq : g_u = s_E j ≫ fst_E ≫ e₂.hom :=
            (CategoryTheory.cancel_mono U₂.ι).mp (hg_snd.trans hσ'_ι)
          have hfst_eq : s_E i ≫ fst_E = s_E j ≫ fst_E :=
