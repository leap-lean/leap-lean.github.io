    let B_ν := weilEtaleSitePullback ν
    let α_T : B_ν.obj T₁ ⟶ T₂ := hT₂.from (B_ν.obj T₁)
    let s_T : C₂.left ⟶ (B_ν.obj T₁).left :=
      CategoryTheory.Limits.pullback.lift ν (CategoryTheory.CategoryStruct.id C₂.left)
        ((CategoryTheory.Category.comp_id ν).trans (CategoryTheory.Category.id_comp ν).symm)
    let β_T : T₂ ⟶ B_ν.obj T₁ :=
      CategoryTheory.MorphismProperty.Over.homMk s_T
        (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
    have hα_left : α_T.left = (B_ν.obj T₁).hom :=
      (CategoryTheory.Category.comp_id α_T.left).symm.trans
        (CategoryTheory.MorphismProperty.Over.w α_T)
    have hαβ_left : α_T.left ≫ s_T = CategoryTheory.CategoryStruct.id (B_ν.obj T₁).left := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · exact (congrArg (fun k => (k ≫ s_T) ≫ _) hα_left).trans
          ((CategoryTheory.Category.assoc (B_ν.obj T₁).hom s_T _).trans
            ((congrArg ((B_ν.obj T₁).hom ≫ ·)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
