      Ω s_Ω Y_Ω ι_Ω f_Ω hPb_Ω θ_pt p_Ω p_α hθ_pt hp_Ω hp_α

  
  have hGT_ker : ∀ c : Fin b_pt → ZMod ℓ, G.transpose.mulVec c = 0 → c = 0 := by
    intro c hc0
    obtain ⟨⟨θ_Cpt_2, hθ_Cpt_2, hbij_Cpt_2⟩, _⟩ :=
