      obtain ⟨_, _, huniq⟩ :=
        hDisjAmalg Y₂_y L_Y2 V (Σ j' : Fin d, (S_j j' ⟶ V))
          (fun idx => S_j idx.1) (fun idx => idx.2)
          (hCov_Y V).1 (hCov_Y V).2.1 (hCov_Y V).2.2
          (fun idx => ((L_Y2.obj.map (Opposite.op idx.2)).hom) z₂)
      exact (huniq z₁ (fun idx => hz idx.1 idx.2)).trans (huniq z₂ (fun _ => rfl)).symm
    let ω_Y : Sky_Y ⟶ L_Y2 :=
      { hom :=
          { app := fun opV => AddCommGrpCat.ofHom
              { toFun := ω_Y_fun opV.unop
                map_zero' := hω_Y_uniq opV.unop _ _ (fun j α =>
                  (hω_Y_spec opV.unop 0 j α).trans
                    ((by
                        have hv0 : (0 : ZMod ℓ).val = 0 := ZMod.val_zero
                        exact (congrArg (· • (((L_Y2.obj.map (Opposite.op (u'_j j))).hom) gen_Y2))
                          hv0).trans (zero_nsmul _) :
                        (0 : ZMod ℓ).val • (((L_Y2.obj.map (Opposite.op (u'_j j))).hom) gen_Y2) = 0).trans
                      (map_zero _).symm))
                map_add' := fun f₁ f₂ => hω_Y_uniq opV.unop _ _ (fun j α =>
                  (hω_Y_spec opV.unop (f₁ + f₂) j α).trans
                    ((hZMod_smul_add (((L_Y2.obj.map (Opposite.op (u'_j j))).hom) gen_Y2)
                        ((map_nsmul ((L_Y2.obj.map (Opposite.op (u'_j j))).hom) ℓ gen_Y2).symm.trans
                          ((congrArg ((L_Y2.obj.map (Opposite.op (u'_j j))).hom) hℓ_genY2).trans
                            (map_zero _)))
                        (f₁ j ⟨α.left, _⟩).down (f₂ j ⟨α.left, _⟩).down).trans
                      ((congrArg₂ (· + ·) (hω_Y_spec opV.unop f₁ j α).symm
                        (hω_Y_spec opV.unop f₂ j α).symm).trans
                        (map_add _ _ _).symm))) }
            naturality := fun {opV₁ opV₂} m => AddCommGrpCat.ext fun f =>
              hω_Y_uniq opV₂.unop _ _ (fun j α => by
                change ((L_Y2.obj.map (Opposite.op α)).hom)
                    (ω_Y_fun opV₂.unop (((Sky_Y.obj.map m).hom) f)) =
                  ((L_Y2.obj.map (Opposite.op α)).hom)
                    (((L_Y2.obj.map m).hom) (ω_Y_fun opV₁.unop f))
                have hL := hω_Y_spec opV₂.unop (((Sky_Y.obj.map m).hom) f) j α
                have hR1 : ((L_Y2.obj.map (Opposite.op α)).hom)
                    (((L_Y2.obj.map m).hom) (ω_Y_fun opV₁.unop f)) =
                    ((L_Y2.obj.map (Opposite.op (α ≫ m.unop))).hom) (ω_Y_fun opV₁.unop f) := by
                  have hm : (m : opV₁ ⟶ opV₂) = Opposite.op m.unop := rfl
                  have hcomp_m : L_Y2.obj.map m ≫ L_Y2.obj.map (Opposite.op α) =
                      L_Y2.obj.map (Opposite.op (α ≫ m.unop)) :=
                    (congrArg (· ≫ L_Y2.obj.map (Opposite.op α))
                      (congrArg L_Y2.obj.map hm)).trans
                      (L_Y2.obj.map_comp (Opposite.op m.unop) (Opposite.op α)).symm
                  exact congrArg (fun g => g.hom (ω_Y_fun opV₁.unop f)) hcomp_m
