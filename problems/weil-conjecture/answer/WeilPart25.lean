  let ρ_nat : ZMod ℓ → (d.functor ⟶ d.functor) :=
    fun a =>
      { app := fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_i i a))
        naturality := fun {i j} hij => by
          let hle_ij : val_U i ≤ val_U j := leOfHom hij
          change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji hle_ij)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_i j a)) =
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_i i a)) ≫
              AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji hle_ij))
