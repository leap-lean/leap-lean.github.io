        ∀ (V : Y₂_y.Etale) (z₁ z₂ : ↥(L_Y2.obj.obj (Opposite.op V))),
          (∀ (j : Fin d) (α : S_j j ⟶ V),
            ((L_Y2.obj.map (Opposite.op α)).hom) z₁ = ((L_Y2.obj.map (Opposite.op α)).hom) z₂) →
          z₁ = z₂ := by
