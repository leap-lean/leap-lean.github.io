    have hz₁ : (pf_f₁.map (SC₂.map pf_ν).g) ≫ (eB.inv ≫ δ₂) = 0 := by
      change pf_f₁.map (pf_ν.map v) ≫ (eB.inv ≫ δ₂) = 0
