          let ι_Y := Σ j : Fin d, (S_j j ⟶ V)
          (∀ w : ↥V.left, ∃ (idx : ι_Y) (v : ↥(S_j idx.1).left), idx.2.left.base v = w) ∧
          (∀ idx : ι_Y, CategoryTheory.Mono idx.2) ∧
          (∀ idx₁ idx₂ : ι_Y, idx₁ ≠ idx₂ →
            Disjoint (Set.range idx₁.2.left.base) (Set.range idx₂.2.left.base)) := by
      intro V
      haveI : AlgebraicGeometry.Etale V.hom := V.prop
      refine ⟨?_, ?_, ?_⟩
      · intro w
        obtain ⟨s_V, hs_V, hpt_V⟩ := hEtalePtSec V.left (V.hom ≫ p_y) w
        have hp_eq : e_Z.inv ≫ p_Ey = p_y :=
          (congrArg (e_Z.inv ≫ ·) heZ_p.symm).trans
            ((CategoryTheory.Category.assoc e_Z.inv e_Z.hom p_y).symm.trans
              ((congrArg (· ≫ p_y) e_Z.inv_hom_id).trans
                (CategoryTheory.Category.id_comp p_y)))
        have hs_Ey : (s_V ≫ V.hom ≫ e_Z.inv) ≫ p_Ey = CategoryTheory.CategoryStruct.id S_k :=
          (CategoryTheory.Category.assoc s_V (V.hom ≫ e_Z.inv) p_Ey).trans
            ((congrArg (s_V ≫ ·)
              ((CategoryTheory.Category.assoc V.hom e_Z.inv p_Ey).trans
                (congrArg (V.hom ≫ ·) hp_eq))).trans
              ((CategoryTheory.Category.assoc s_V V.hom p_y).symm.trans hs_V))
        obtain ⟨j, hj_pt⟩ := hσ_surj ((s_V ≫ V.hom ≫ e_Z.inv).base pt_k)
        have hs_eq : s_V ≫ V.hom ≫ e_Z.inv = s_E j :=
          hSectionEq p_Ey (s_V ≫ V.hom ≫ e_Z.inv) (s_E j) hs_Ey (hs_E j) hj_pt.symm
        have hs_V_hom : s_V ≫ V.hom = σ' j :=
          (CategoryTheory.Category.comp_id (s_V ≫ V.hom)).symm.trans
            ((congrArg ((s_V ≫ V.hom) ≫ ·) e_Z.inv_hom_id.symm).trans
              (((CategoryTheory.Category.assoc (s_V ≫ V.hom) e_Z.inv e_Z.hom).symm).trans
                (congrArg (· ≫ e_Z.hom)
                  ((CategoryTheory.Category.assoc s_V V.hom e_Z.inv).trans hs_eq))))
        exact ⟨⟨j, CategoryTheory.MorphismProperty.Over.homMk s_V hs_V_hom trivial⟩, pt_k, hpt_V⟩
      · rintro ⟨j, α⟩
        refine ⟨fun {Z} g₁ g₂ _ =>
          CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)⟩
        have hg₁ : g₁.left = Z.hom ≫ p_y :=
          (CategoryTheory.Category.comp_id g₁.left).symm.trans
            ((congrArg (g₁.left ≫ ·) (hσ'_p j).symm).trans
              (((CategoryTheory.Category.assoc g₁.left (S_j j).hom p_y).symm).trans
                (congrArg (· ≫ p_y) (CategoryTheory.MorphismProperty.Over.w g₁))))
        have hg₂ : g₂.left = Z.hom ≫ p_y :=
          (CategoryTheory.Category.comp_id g₂.left).symm.trans
            ((congrArg (g₂.left ≫ ·) (hσ'_p j).symm).trans
              (((CategoryTheory.Category.assoc g₂.left (S_j j).hom p_y).symm).trans
                (congrArg (· ≫ p_y) (CategoryTheory.MorphismProperty.Over.w g₂))))
        exact hg₁.trans hg₂.symm
      · rintro ⟨j₁, α₁⟩ ⟨j₂, α₂⟩ hne
        rw [Set.disjoint_left]
        rintro _ ⟨q₁, rfl⟩ ⟨q₂, hq₂⟩
        have hq1_pt : q₁ = pt_k := hSub_k.elim q₁ pt_k
        have hq2_pt : q₂ = pt_k := hSub_k.elim q₂ pt_k
        rw [hq1_pt, hq2_pt] at hq₂
        have h_im : (s_E j₁).base pt_k = (s_E j₂).base pt_k := by
          have hL1 : (s_E j₁).base pt_k = (α₁.left ≫ V.hom ≫ e_Z.inv).base pt_k :=
            congrArg (fun f => f.base pt_k)
              ((CategoryTheory.Category.comp_id (s_E j₁)).symm.trans
                ((congrArg (s_E j₁ ≫ ·) e_Z.hom_inv_id.symm).trans
                  (((CategoryTheory.Category.assoc (s_E j₁) e_Z.hom e_Z.inv).symm).trans
                    ((congrArg (· ≫ e_Z.inv) (CategoryTheory.MorphismProperty.Over.w α₁).symm).trans
                      (CategoryTheory.Category.assoc α₁.left V.hom e_Z.inv)))))
          have hL2 : (s_E j₂).base pt_k = (α₂.left ≫ V.hom ≫ e_Z.inv).base pt_k :=
            congrArg (fun f => f.base pt_k)
              ((CategoryTheory.Category.comp_id (s_E j₂)).symm.trans
                ((congrArg (s_E j₂ ≫ ·) e_Z.hom_inv_id.symm).trans
                  (((CategoryTheory.Category.assoc (s_E j₂) e_Z.hom e_Z.inv).symm).trans
                    ((congrArg (· ≫ e_Z.inv) (CategoryTheory.MorphismProperty.Over.w α₂).symm).trans
                      (CategoryTheory.Category.assoc α₂.left V.hom e_Z.inv)))))
          exact hL1.trans ((congrArg (V.hom ≫ e_Z.inv).base hq₂.symm).trans hL2.symm)
        have hj_eq : j₁ = j₂ := hσ_pt_inj j₁ j₂ h_im
        subst hj_eq
        have hl_eq : α₁.left = α₂.left :=
          hSectionEq (V.hom ≫ p_y) α₁.left α₂.left
            ((CategoryTheory.Category.assoc α₁.left V.hom p_y).symm.trans
              ((congrArg (· ≫ p_y) (CategoryTheory.MorphismProperty.Over.w α₁)).trans (hσ'_p j₁)))
            ((CategoryTheory.Category.assoc α₂.left V.hom p_y).symm.trans
              ((congrArg (· ≫ p_y) (CategoryTheory.MorphismProperty.Over.w α₂)).trans (hσ'_p j₁)))
            hq₂.symm
        exact hne (congrArg (Sigma.mk j₁)
          (CategoryTheory.MorphismProperty.Comma.Hom.ext hl_eq (Subsingleton.elim _ _)))

    let ω_Y_fun : ∀ (V : Y₂_y.Etale),
        ↥(Sky_Y.obj.obj (Opposite.op V)) → ↥(L_Y2.obj.obj (Opposite.op V)) :=
      fun V f =>
        Classical.choose
          (hDisjAmalg Y₂_y L_Y2 V (Σ j : Fin d, (S_j j ⟶ V))
            (fun idx => S_j idx.1) (fun idx => idx.2)
            (hCov_Y V).1 (hCov_Y V).2.1 (hCov_Y V).2.2
            (fun idx =>
