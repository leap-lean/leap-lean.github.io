                    (CategoryTheory.Category.comp_id fst_E)))))
        have hw₂_diag : w_diag ≫ U₂_et.hom = σ' i ≫ ι_y :=
          (CategoryTheory.Category.assoc (s_E i) (fst_E ≫ e₂.hom) U₂.ι).trans
            ((congrArg (s_E i ≫ ·)
              ((CategoryTheory.Category.assoc fst_E e₂.hom U₂.ι).trans
                (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm)).trans
              (CategoryTheory.Category.assoc (s_E i) hom_Z ι_y).symm)
        have hbc_ii := hbc_eval (σ i) (σ' i) (hσ'_p i) (hEt_σ i) U₂_et δ_hat w_diag hw₁_diag hw₂_diag
        let lam_diag : S_j i ⟶ U'_y :=
          CategoryTheory.MorphismProperty.Over.homMk
            (CategoryTheory.Limits.pullback.lift w_diag (σ' i) hw₂_diag)
            (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
        have hbc_ii' :
            (((pb_ι.obj F₂).obj.map (Opposite.op u_Sj)).hom)
              ((((e_sW ≫ (pb_y.map θ_fin ≫ bc₀)).hom.app (Opposite.op T_k)).hom)
                (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey)) =
            (((pb_ι.obj F₂).obj.map (Opposite.op lam_diag)).hom)
              ((((adj_ι.unit.app F₂).hom.app (Opposite.op U₂_et)).hom)
                (((F₂.obj.map (Opposite.op δ_hat)).hom)
