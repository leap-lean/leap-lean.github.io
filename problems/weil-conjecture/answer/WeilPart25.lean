    have hτ_z₁ : τ_B₁.toRingHom z₁ = 0 := by
      change τ_B₁_ring (algebraMap B_mid B₁ (algebraMap B₀' B_mid x_nz)) = 0
      rw [hτ_B₁_eq]
      change τ_mid_ring (algebraMap B₀' B_mid x_nz) = 0
      rw [hτ_mid_eq, hτ_xnz]
