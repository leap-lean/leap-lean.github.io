            (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₃).obj.map (Opposite.op u₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂)) ≫
            (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂).hom.app (Opposite.op V₂)) ≫
            (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₃).obj.map (Opposite.op u₁) := by
            have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂)) ≫
                (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂).hom.app (Opposite.op V₂) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₃)) ≫
                (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₃).obj.map (Opposite.op u₂) := by
              rw [← hEquiv_comp (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂))
                (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂), CategoryTheory.Category.id_comp]
              exact Equiv.apply_symm_apply _ _
            rw [h2]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂)) ≫
            ((weilEtaleLocalTorsionMap Y_bar_b ℓ u₂).hom.app (Opposite.op V₂) ≫
              (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₃).obj.map (Opposite.op u₁)) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂)) ≫
            ((weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂).obj.map (Opposite.op u₁) ≫
              (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂).hom.app (Opposite.op V₁)) := by
            rw [← (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂).hom.naturality (Opposite.op u₁)]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv
            (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂)) ≫
            (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂).obj.map (Opposite.op u₁)) ≫
            (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂).hom.app (Opposite.op V₁) := by
            rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap Y_bar_b ℓ u₁) ≫
            (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂).hom.app (Opposite.op V₁) := by
            have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv
                (weilEtaleLocalTorsionMap Y_bar_b ℓ u₁) =
                CategoryTheory.Sheaf.freeYonedaHomEquiv
                  (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂)) ≫
                (weilEtaleLocalTorsionSheaf Y_bar_b ℓ V₂).obj.map (Opposite.op u₁) :=
              Equiv.apply_symm_apply _ _
            rw [h1]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv
            (weilEtaleLocalTorsionMap Y_bar_b ℓ u₁ ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ u₂) :=
            (hEquiv_comp (weilEtaleLocalTorsionMap Y_bar_b ℓ u₁)
              (weilEtaleLocalTorsionMap Y_bar_b ℓ u₂)).symm

  let mk₀_hom : ∀ {A B : CategoryTheory.Sheaf Y_bar_b.smallEtaleTopology AddCommGrpCat.{u}},
      (A ⟶ B) →+ CategoryTheory.Abelian.Ext A B 0 :=
    fun {A B} => AddMonoidHom.mk' CategoryTheory.Abelian.Ext.mk₀
      (fun f g => CategoryTheory.Abelian.Ext.mk₀_add f g)

  refine ⟨?_, ?_⟩
  · obtain ⟨π₁, hSum₁⟩ :=
      weil_etale_disjoint_open_cover_localTorsion_partition_of_id
        Y_bar_b ℓ n_b Z₁ U₁_tilde α₁ hOpen_α₁ hDisj_α₁ hCov_α₁
    have hz_zero : ∀ z : weilEtaleLocalTorsionH Y_bar_b ℓ Z₁ 0, z = 0 := by
      intro z
      have hSum₁' :
          (∑ i : Fin n_b, π₁ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (α₁ i)) =
            𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ Z₁) := hSum₁
      calc
        z = z.comp (mk₀_hom (𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ Z₁))) (Nat.add_zero 0) :=
          (CategoryTheory.Abelian.Ext.comp_mk₀_id z).symm
        _ = z.comp (mk₀_hom (∑ i : Fin n_b, π₁ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (α₁ i)))
              (Nat.add_zero 0) := by
          rw [hSum₁']
        _ = z.comp (∑ i : Fin n_b, mk₀_hom (π₁ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (α₁ i)))
              (Nat.add_zero 0) := by
          rw [map_sum]
        _ = ∑ i : Fin n_b,
              z.comp (CategoryTheory.Abelian.Ext.mk₀
                (π₁ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (α₁ i))) (Nat.add_zero 0) := by
          rw [CategoryTheory.Abelian.Ext.comp_sum]
          rfl
        _ = 0 := by
          apply Finset.sum_eq_zero
          intro i _
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
            ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
          have h0_i : z.comp (CategoryTheory.Abelian.Ext.mk₀ (π₁ i)) (Nat.add_zero 0) = 0 :=
            (hSub_sheet i).elim _ 0
          rw [h0_i, CategoryTheory.Abelian.Ext.zero_comp]
    exact ⟨fun a b => (hz_zero a).trans (hz_zero b).symm⟩
  · obtain ⟨π₂, hSum₂⟩ :=
      weil_etale_disjoint_open_cover_localTorsion_partition_of_id
        Y_bar_b ℓ n_b Z₂ U₂_tilde α₂ hOpen_α₂ hDisj_α₂ hCov_α₂
    have hMap_decomp :
        weilEtaleLocalTorsionMap Y_bar_b ℓ u_b =
          ∑ i : Fin n_b,
            π₂ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (u_tilde i) ≫
              weilEtaleLocalTorsionMap Y_bar_b ℓ (α₁ i) := by
      have hSum₂' :
          (∑ i : Fin n_b, π₂ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (α₂ i)) =
            𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ Z₂) := hSum₂
      calc
        weilEtaleLocalTorsionMap Y_bar_b ℓ u_b
          = 𝟙 (weilEtaleLocalTorsionSheaf Y_bar_b ℓ Z₂) ≫
              weilEtaleLocalTorsionMap Y_bar_b ℓ u_b :=
            (CategoryTheory.Category.id_comp _).symm
        _ = (∑ i : Fin n_b, π₂ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (α₂ i)) ≫
              weilEtaleLocalTorsionMap Y_bar_b ℓ u_b := by
            rw [hSum₂']
        _ = ∑ i : Fin n_b,
              (π₂ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (α₂ i)) ≫
                weilEtaleLocalTorsionMap Y_bar_b ℓ u_b := by
            rw [CategoryTheory.Preadditive.sum_comp]
        _ = ∑ i : Fin n_b,
              π₂ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (u_tilde i) ≫
                weilEtaleLocalTorsionMap Y_bar_b ℓ (α₁ i) := by
            apply Finset.sum_congr rfl
            intro i _
            rw [CategoryTheory.Category.assoc, ← hLocMap_comp (α₂ i) u_b,
              ← hu_α i, hLocMap_comp (u_tilde i) (α₁ i)]
    ext z
    change z.comp (mk₀_hom (weilEtaleLocalTorsionMap Y_bar_b ℓ u_b)) (Nat.add_zero 1) = 0
    rw [hMap_decomp, map_sum, CategoryTheory.Abelian.Ext.comp_sum]
    apply Finset.sum_eq_zero
    intro i _
    change z.comp (CategoryTheory.Abelian.Ext.mk₀
      (π₂ i ≫ weilEtaleLocalTorsionMap Y_bar_b ℓ (u_tilde i) ≫
        weilEtaleLocalTorsionMap Y_bar_b ℓ (α₁ i))) (Nat.add_zero 1) = 0
    rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (π₂ i),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀
        (weilEtaleLocalTorsionMap Y_bar_b ℓ (u_tilde i)),
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero]
    have hmid_zero :
        (z.comp (CategoryTheory.Abelian.Ext.mk₀ (π₂ i)) (Nat.add_zero 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap Y_bar_b ℓ (u_tilde i)))
          (Nat.add_zero 1) = 0 := by
      change weilEtaleLocalTorsionMapH Y_bar_b ℓ (u_tilde i) 1
        (z.comp (CategoryTheory.Abelian.Ext.mk₀ (π₂ i)) (Nat.add_zero 1)) = 0
      rw [hZero_sheet i]
      rfl
    rw [hmid_zero, CategoryTheory.Abelian.Ext.zero_comp]

theorem weil_etale_rel_curve_cover_global_r1_zero_of_const_and_special_fiber (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hDual_U :
      ∀ (U_et C'_et : E.C_fib.left.Etale)
        (v_et : Quiver.Hom C'_et U_et)
        (e_U : CategoryTheory.Iso
          ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj U_et).left
          E.U_fib.toScheme),
        CategoryTheory.CategoryStruct.comp e_U.hom E.U_fib.ι =
          ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj U_et).hom →
        ConnectedSpace ↥((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj C'_et).left →
        AlgebraicGeometry.IsFinite
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).map v_et).left e_U.hom) →
        AlgebraicGeometry.Etale
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).map v_et).left e_U.hom) →
        AlgebraicGeometry.Surjective
          (CategoryTheory.CategoryStruct.comp
            ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).map v_et).left e_U.hom) →
        (∃ p₁ : weilEtaleTorsionH E.U_fib.toScheme ℓ 1 →+
            weilEtaleTorsionH ((AlgebraicGeometry.Scheme.Etale.forget E.C_fib.left).obj C'_et).left ℓ 1,
          WeilIsTorsionEtalePullback
            (CategoryTheory.CategoryStruct.comp
