      exact pr₁.isOpenMap _ (f.isLocallyConstant t)

  have hSheetsCRUX :
      ∀ {X₀ W₀ : AlgebraicGeometry.Scheme.{u}}
        (fst₀ : Quiver.Hom W₀ X₀)
        (ι : ZMod ℓ → Quiver.Hom X₀ W₀)
        (ρ_W : ZMod ℓ → Quiver.Hom W₀ W₀),
        (∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ι a) fst₀ =
