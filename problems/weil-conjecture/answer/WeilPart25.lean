            (f_rat : K_C) * algebraMap Rx K_C b_f * (ι_α (h_P₀ α)) ^ (ℓ * M) := by
        dsimp [num_x, p_m, germ_m]
        rw [map_mul, map_pow, hab_f, hGerm_stalk (V α) pt_m.1 hx_m]
