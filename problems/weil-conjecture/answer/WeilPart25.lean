      have hmem_univ₂ : sec_C₂v.base pt_k ∈ (U₂_v : Set ↥C₂_v) := by
        rw [hUniv₂]; trivial
      change (sec_C₂v ≫ ι₂_v ≫ p₂_Y).base pt_k ∈ (P.W_open : Set ↥P.Y) at hmem_univ₂
      rw [← CategoryTheory.Category.assoc, hsec_C₂_fst, hsec_Y₂_fst, P.hW_compl] at hmem_univ₂
      exact hmem_univ₂ (Set.mem_iUnion.mpr ⟨a₂, ⟨(s_v' ≫ h₂_sch).base pt_k, rfl⟩⟩)

    let ν_v : C₂_v ⟶ C₁_v :=
      CategoryTheory.Limits.pullback.lift (ι₂_v ≫ ν₂) q₂_v
        ((CategoryTheory.Category.assoc ι₂_v ν₂ f₁_V₂).trans
          ((congrArg (fun m => ι₂_v ≫ m) hν₂_f).trans
            (CategoryTheory.Limits.pullback.condition (f := f₂_V₂) (g := s_v'))))
    have hνv_fst : ν_v ≫ ι₁_v = ι₂_v ≫ ν₂ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hνv_snd : ν_v ≫ q₁_v = q₂_v :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let M_νv (a : C₂_v ⟶ S_k) (b : Y₂_V₂ ⟶ V₂_sch) : Prop :=
      CategoryTheory.IsPullback a ι₂_v s_v' b
    have hPb_outer_v : CategoryTheory.IsPullback (ν_v ≫ q₁_v) ι₂_v s_v' (ν₂ ≫ f₁_V₂) :=
      Eq.mp
        ((congrArg (fun a => M_νv a f₂_V₂) hνv_snd.symm).trans
          (congrArg (fun b => M_νv (ν_v ≫ q₁_v) b) hν₂_f.symm))
        (CategoryTheory.IsPullback.of_hasPullback f₂_V₂ s_v').flip
    have hPb_νv_flip : CategoryTheory.IsPullback ν_v ι₂_v ι₁_v ν₂ :=
      CategoryTheory.IsPullback.of_right hPb_outer_v hνv_fst
        (CategoryTheory.IsPullback.of_hasPullback f₁_V₂ s_v').flip
    have hPb_νv : CategoryTheory.IsPullback ι₂_v ν_v ν₂ ι₁_v := hPb_νv_flip.flip
    haveI : AlgebraicGeometry.IsFinite ν_v :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_νv hFin_ν₂

    have hU₂v_eq : U₂_v = (TopologicalSpace.Opens.map ν_v.base).obj U₁_v := by
      ext z
      change ι₂_v.base z ∈ W₂_V₂_open ↔ ι₁_v.base (ν_v.base z) ∈ W₁_V₂_open
      rw [hW₂_eq_ν₂]
      change ν₂.base (ι₂_v.base z) ∈ W₁_V₂_open ↔ (ν_v ≫ ι₁_v).base z ∈ W₁_V₂_open
      rw [hνv_fst]
      rfl

    let P_U₂v := CategoryTheory.Limits.pullback W₂_V₂_open.ι ι₂_v
    have hRange_PU₂v :
        Set.range (CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v).base =
          Set.range U₂_v.ι.base := by
      ext z
      constructor
      · rintro ⟨u, rfl⟩
        have hz_mem : W₂_V₂_open.ι.base
            ((CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v).base u) =
            ι₂_v.base ((CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v).base u) := by
          change (CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v ≫ W₂_V₂_open.ι).base u =
            (CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v ≫ ι₂_v).base u
          rw [CategoryTheory.Limits.pullback.condition]
        have hz_U₂ : (CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v).base u ∈ U₂_v := by
          change ι₂_v.base ((CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v).base u) ∈
            W₂_V₂_open
          rw [← hz_mem]
          exact ((CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v).base u).2
        exact ⟨⟨_, hz_U₂⟩, rfl⟩
      · rintro ⟨z₀, rfl⟩
        obtain ⟨u_pb, -, hu_snd⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
            (f := W₂_V₂_open.ι) (g := ι₂_v) ⟨ι₂_v.base z₀.1, z₀.2⟩ z₀.1 rfl
        exact ⟨u_pb, hu_snd⟩
    obtain ⟨e_PU₂, he_PU₂⟩ :=
      hOpenIso_of_range (CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v) U₂_v.ι hRange_PU₂v

    let P_Wv := CategoryTheory.Limits.pullback (w_Y₂ ≫ ν₂) ι₁_v
    let fst_Wv := CategoryTheory.Limits.pullback.fst (w_Y₂ ≫ ν₂) ι₁_v
    let snd_Wv := CategoryTheory.Limits.pullback.snd (w_Y₂ ≫ ν₂) ι₁_v
    have hw_lC₂ : (fst_Wv ≫ w_Y₂) ≫ ν₂ = snd_Wv ≫ ι₁_v :=
      (CategoryTheory.Category.assoc fst_Wv w_Y₂ ν₂).symm.trans
        (CategoryTheory.Limits.pullback.condition (f := w_Y₂ ≫ ν₂) (g := ι₁_v))
    let l_C₂ : P_Wv ⟶ C₂_v := hPb_νv.lift (fst_Wv ≫ w_Y₂) snd_Wv hw_lC₂
    have hl_fst : l_C₂ ≫ ι₂_v = fst_Wv ≫ w_Y₂ := by
      change hPb_νv.lift (fst_Wv ≫ w_Y₂) snd_Wv hw_lC₂ ≫ ι₂_v = fst_Wv ≫ w_Y₂
      apply CategoryTheory.IsPullback.lift_fst
    have hl_snd : l_C₂ ≫ ν_v = snd_Wv := by
      change hPb_νv.lift (fst_Wv ≫ w_Y₂) snd_Wv hw_lC₂ ≫ ν_v = snd_Wv
      apply CategoryTheory.IsPullback.lift_snd
    let n_v : P_Wv ⟶ P_U₂v :=
      CategoryTheory.Limits.pullback.lift (fst_Wv ≫ e₂_W₂.hom) l_C₂
        (by rw [CategoryTheory.Category.assoc, he₂_W₂, hl_fst])
    have hn_fst : n_v ≫ CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v =
        fst_Wv ≫ e₂_W₂.hom :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hn_snd : n_v ≫ CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v = l_C₂ :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let m_v : P_U₂v ⟶ P_Wv :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v ≫ e₂_W₂.inv)
        (CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v ≫ ν_v)
        (by
          have he₂_inv : e₂_W₂.inv ≫ w_Y₂ = W₂_V₂_open.ι := by
            rw [← he₂_W₂, ← CategoryTheory.Category.assoc, e₂_W₂.inv_hom_id,
              CategoryTheory.Category.id_comp]
          calc
            (CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v ≫ e₂_W₂.inv) ≫ (w_Y₂ ≫ ν₂)
              = CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v ≫
                  (e₂_W₂.inv ≫ w_Y₂) ≫ ν₂ := by
                  simp only [CategoryTheory.Category.assoc]
            _ = (CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v ≫ W₂_V₂_open.ι) ≫ ν₂ := by
                  rw [he₂_inv, ← CategoryTheory.Category.assoc]
            _ = CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v ≫ (ι₂_v ≫ ν₂) := by
                  rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
            _ = CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v ≫ (ν_v ≫ ι₁_v) := by
                  rw [hνv_fst]
            _ = (CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v ≫ ν_v) ≫ ι₁_v :=
                  (CategoryTheory.Category.assoc _ _ _).symm)
    have hm_fst : m_v ≫ fst_Wv =
        CategoryTheory.Limits.pullback.fst W₂_V₂_open.ι ι₂_v ≫ e₂_W₂.inv :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hm_snd : m_v ≫ snd_Wv =
        CategoryTheory.Limits.pullback.snd W₂_V₂_open.ι ι₂_v ≫ ν_v :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    let e_PWv_PU₂ : P_Wv ≅ P_U₂v :=
      { hom := n_v
        inv := m_v
        hom_inv_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hm_fst,
              ← CategoryTheory.Category.assoc, hn_fst, CategoryTheory.Category.assoc,
              e₂_W₂.hom_inv_id, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hm_snd,
              ← CategoryTheory.Category.assoc, hn_snd, hl_snd]
        inv_hom_id := by
          apply CategoryTheory.Limits.pullback.hom_ext
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hn_fst,
              ← CategoryTheory.Category.assoc, hm_fst, CategoryTheory.Category.assoc,
              e₂_W₂.inv_hom_id, CategoryTheory.Category.comp_id]
          · rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc, hn_snd]
            apply hPb_νv.hom_ext
            · rw [CategoryTheory.Category.assoc, hl_fst,
                ← CategoryTheory.Category.assoc m_v, hm_fst,
                CategoryTheory.Category.assoc, ← he₂_W₂, ← CategoryTheory.Category.assoc e₂_W₂.inv,
                e₂_W₂.inv_hom_id, CategoryTheory.Category.id_comp,
                CategoryTheory.Limits.pullback.condition]
            · rw [CategoryTheory.Category.assoc, hl_snd, hm_snd] }
    have he_PWv : (n_v ≫ e_PU₂.hom) ≫ (U₂_v.ι ≫ ν_v) = snd_Wv := by
      rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_PU₂.hom, he_PU₂,
        ← CategoryTheory.Category.assoc n_v, hn_snd, hl_snd]

    let W_et_v : C₁_v.Etale := (weilEtaleSitePullback ι₁_v).obj W₂_Y₁
    let e_Wet_U₂v : W_et_v.left ≅ U₂_v.toScheme := e_PWv_PU₂ ≪≫ e_PU₂

    let C₁_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk q₁_v
    let C₂_ov : CategoryTheory.Over S_k := CategoryTheory.Over.mk q₂_v
    haveI : AlgebraicGeometry.IsProper q₁_v :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (CategoryTheory.IsPullback.of_hasPullback f₁_V₂ s_v')
        (inferInstance : AlgebraicGeometry.IsProper f₁_V₂)
    haveI : AlgebraicGeometry.IsProper C₁_ov.hom := by
      change AlgebraicGeometry.IsProper q₁_v
      infer_instance
    haveI : ConnectedSpace ↥C₂_ov.left := hConn_C₂_v
    have hSub_W₂v : Subsingleton (weilEtaleLocalTorsionH C₁_v ℓ W_et_v 0) :=
      (weil_etale_finite_rel_open_localTorsion_r1_iso k ℓ hPBC).2
        C₁_ov C₂_ov ν_v hνv_snd
        U₁_v U₂_v hU₂v_eq hNeUniv_C₂ W_et_v e_Wet_U₂v he_PWv

    have hMapH_v_zero :
        weilEtaleLocalTorsionMapH C₁_v ℓ ((weilEtaleSitePullback ι₁_v).map u_rel) 1 = 0 :=
      hEngine_V₂.2.1 s_v' C₁_ov ι₁_v hs_v'
        (CategoryTheory.IsPullback.of_hasPullback f₁_V₂ s_v')
        hSub_W₂v ⟨A₂_grp, hFin_A₂, ⟨e_src⟩⟩ hΨ_rel_zero

    exact ⟨hConn_C₁_v, hNeUniv_C₁, hMapH_v_zero⟩

  
  have hComm_Y₁_V₂_sch : g_Y₁_V₂ ≫ E.π_bar.left = f₁_V₂ ≫ (Fgt_V.obj V₂).hom := by
    change (p₁_Y ≫ E.g_Y₁) ≫ E.π_bar.left = f₁_V₂ ≫ (Fgt_V.obj V₂).hom
    rw [CategoryTheory.Category.assoc, E.hComm_Y₁, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hgV₂_w]
  have hComm_Y₁_V₂ : CategoryTheory.CategoryStruct.comp g_Y₁_V₂ E.π_bar.left =
      CategoryTheory.CategoryStruct.comp f₁_V₂ V₂.hom := hComm_Y₁_V₂_sch

  let v₂_hom : V₂_sch ⟶ E.V_bar.left := (Fgt_V.obj V₂).hom
  let v₁_hom : V₁_sch ⟶ E.V_bar.left := (Fgt_V.obj E.V₁).hom
  let P_V₂ := CategoryTheory.Limits.pullback E.π_bar.left v₂_hom
  let P_V₁ := CategoryTheory.Limits.pullback E.π_bar.left v₁_hom
  let fst_PV₂ := CategoryTheory.Limits.pullback.fst E.π_bar.left v₂_hom
  let snd_PV₂ := CategoryTheory.Limits.pullback.snd E.π_bar.left v₂_hom
  let fst_PV₁ := CategoryTheory.Limits.pullback.fst E.π_bar.left v₁_hom
  let snd_PV₁ := CategoryTheory.Limits.pullback.snd E.π_bar.left v₁_hom
  let φ_V₁ : E.Y₁ ⟶ P_V₁ :=
    CategoryTheory.Limits.pullback.lift E.g_Y₁ E.f_bar₁ E.hComm_Y₁
  let φ_V₂_sch : Y₁_V₂ ⟶ P_V₂ :=
    CategoryTheory.Limits.pullback.lift g_Y₁_V₂ f₁_V₂ hComm_Y₁_V₂_sch
  let ψ_PV : P_V₂ ⟶ P_V₁ :=
    CategoryTheory.Limits.pullback.lift fst_PV₂ (snd_PV₂ ≫ g_V₂_sch)
      ((CategoryTheory.Limits.pullback.condition (f := E.π_bar.left) (g := v₂_hom)).trans
        ((congrArg (fun m => snd_PV₂ ≫ m) hgV₂_w.symm).trans
          (CategoryTheory.Category.assoc snd_PV₂ g_V₂_sch v₁_hom).symm))
  have hφV₁_fst : φ_V₁ ≫ fst_PV₁ = E.g_Y₁ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hφV₁_snd : φ_V₁ ≫ snd_PV₁ = E.f_bar₁ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hφV₂_fst : φ_V₂_sch ≫ fst_PV₂ = g_Y₁_V₂ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hφV₂_snd : φ_V₂_sch ≫ snd_PV₂ = f₁_V₂ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hψPV_fst : ψ_PV ≫ fst_PV₁ = fst_PV₂ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hψPV_snd : ψ_PV ≫ snd_PV₁ = snd_PV₂ ≫ g_V₂_sch :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  let M_PV (a : P_V₂ ⟶ E.Y_bar.left) (b : V₂_sch ⟶ E.V_bar.left) : Prop :=
    CategoryTheory.IsPullback a snd_PV₂ E.π_bar.left b
  have hPb_outerP : CategoryTheory.IsPullback (ψ_PV ≫ fst_PV₁) snd_PV₂
      E.π_bar.left (g_V₂_sch ≫ v₁_hom) :=
    Eq.mp
      ((congrArg (fun a => M_PV a v₂_hom) hψPV_fst.symm).trans
        (congrArg (fun b => M_PV (ψ_PV ≫ fst_PV₁) b) hgV₂_w.symm))
      (CategoryTheory.IsPullback.of_hasPullback E.π_bar.left v₂_hom)
  have hPb_ψPV : CategoryTheory.IsPullback ψ_PV snd_PV₂ snd_PV₁ g_V₂_sch :=
    CategoryTheory.IsPullback.of_right hPb_outerP hψPV_snd
      (CategoryTheory.IsPullback.of_hasPullback E.π_bar.left v₁_hom)

  let M_φV (a : Y₁_V₂ ⟶ V₂_sch) (b : E.Y₁ ⟶ V₁_sch) : Prop :=
    CategoryTheory.IsPullback a p₁_Y g_V₂_sch b
  have hPb_outer_φ : CategoryTheory.IsPullback (φ_V₂_sch ≫ snd_PV₂) p₁_Y
      g_V₂_sch (φ_V₁ ≫ snd_PV₁) :=
    Eq.mp
      ((congrArg (fun a => M_φV a E.f_bar₁) hφV₂_snd.symm).trans
        (congrArg (fun b => M_φV (φ_V₂_sch ≫ snd_PV₂) b) hφV₁_snd.symm))
      (CategoryTheory.IsPullback.of_hasPullback E.f_bar₁ g_V₂_sch).flip
  have hmid_φ : φ_V₂_sch ≫ ψ_PV = p₁_Y ≫ φ_V₁ := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (((CategoryTheory.Category.assoc φ_V₂_sch ψ_PV fst_PV₁).trans
        ((congrArg (fun m => φ_V₂_sch ≫ m) hψPV_fst).trans hφV₂_fst)).trans
        ((CategoryTheory.Category.assoc p₁_Y φ_V₁ fst_PV₁).trans
          (congrArg (fun m => p₁_Y ≫ m) hφV₁_fst)).symm)
    · exact (((CategoryTheory.Category.assoc φ_V₂_sch ψ_PV snd_PV₁).trans
        ((congrArg (fun m => φ_V₂_sch ≫ m) hψPV_snd).trans
          ((CategoryTheory.Category.assoc φ_V₂_sch snd_PV₂ g_V₂_sch).symm.trans
            ((congrArg (fun m => m ≫ g_V₂_sch) hφV₂_snd).trans
              (CategoryTheory.Limits.pullback.condition (f := E.f_bar₁) (g := g_V₂_sch)).symm)))).trans
        ((CategoryTheory.Category.assoc p₁_Y φ_V₁ snd_PV₁).trans
          (congrArg (fun m => p₁_Y ≫ m) hφV₁_snd)).symm)
  have hPb_φV₂_flip : CategoryTheory.IsPullback φ_V₂_sch p₁_Y ψ_PV φ_V₁ :=
    CategoryTheory.IsPullback.of_right hPb_outer_φ hmid_φ hPb_ψPV.flip
  have hOpen_φV₂_sch : AlgebraicGeometry.IsOpenImmersion φ_V₂_sch :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_φV₂_flip.flip E.hOpen_Y₁
  have hClosed_φV₂_sch : AlgebraicGeometry.IsClosedImmersion φ_V₂_sch :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      hPb_φV₂_flip.flip E.hClosed_Y₁
  have hOpen_φV₂ : AlgebraicGeometry.IsOpenImmersion
      (CategoryTheory.Limits.pullback.lift g_Y₁_V₂ f₁_V₂ hComm_Y₁_V₂) :=
    hOpen_φV₂_sch
  have hClosed_φV₂ : AlgebraicGeometry.IsClosedImmersion
      (CategoryTheory.Limits.pullback.lift g_Y₁_V₂ f₁_V₂ hComm_Y₁_V₂) :=
    hClosed_φV₂_sch

  haveI : AlgebraicGeometry.IsAffine V₂.left := hAff_V₂
  have hFib_Vbar :=
    weil_etale_clopen_fibration_closedFiber_coproduct_vanishing
      k ℓ E.Y_bar E.V_bar E.π_bar V₂ Y₁_V₂ f₁_V₂ g_Y₁_V₂ hComm_Y₁_V₂
      hOpen_φV₂ hClosed_φV₂ W₁_V₂_open W₂_Y₁ u_rel W₂ W₁_V₂_Ybar u_rel_Ybar
      (CategoryTheory.Iso.refl W₁_V₂_open.toScheme) (CategoryTheory.Iso.refl W₂_sch)
      (CategoryTheory.Category.id_comp _)
      ((CategoryTheory.Category.id_comp ((w_Y₂ ≫ ν₂) ≫ g_Y₁_V₂)).trans hw_ν₂_gY₁)
      ((CategoryTheory.Category.id_comp u_rel_sch).trans
        (CategoryTheory.Category.comp_id u_rel_sch).symm)
      hFib_V₂

  have hR1_urel_zero :
      weilEtaleHigherDirectImageMap E.π_bar.left 1
        (weilEtaleLocalTorsionMap E.Y_bar.left ℓ u_rel_Ybar) = 0 :=
    (weil_etale_proper_closedPt_conservativity_and_r1_localTorsion_fiber_iff
      k ℓ hPBC E.Y_bar E.V_bar E.π_bar E.hProp_πbar W₂ W₁_V₂_Ybar u_rel_Ybar).2.2
      hFib_Vbar

  rw [hFac_uW, hLocMap_comp E.Y_bar.left ℓ u_rel_Ybar q_W₁,
    hHigherMap_comp E.π_bar.left 1
      (weilEtaleLocalTorsionMap E.Y_bar.left ℓ u_rel_Ybar)
      (weilEtaleLocalTorsionMap E.Y_bar.left ℓ q_W₁),
    hR1_urel_zero, CategoryTheory.Limits.zero_comp]

theorem weil_etale_open_zeroBdry_locConst_counit_iso (S : AlgebraicGeometry.Scheme.{u}) (U : S.Opens) (n : ℕ) :
    let U_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι inferInstance
    CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltLocConstPresheaf S n) ∧
    CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltZeroBdrySubpresheaf S U n) ∧
    ∀ (hSh_loc : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltLocConstPresheaf S n))
      (hSh_zero : CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltZeroBdrySubpresheaf S U n)),
      ∃ (e_loc : CategoryTheory.Iso (weilEtaleTorsionSheaf S n)
          ⟨weilAltLocConstPresheaf S n, hSh_loc⟩)
        (e_zero : CategoryTheory.Iso (weilEtaleLocalTorsionSheaf S n U_et)
          ⟨weilAltZeroBdrySubpresheaf S U n, hSh_zero⟩),
        CategoryTheory.CategoryStruct.comp
            (weilEtaleLocalTorsionCounit S n U_et) e_loc.hom =
          CategoryTheory.CategoryStruct.comp e_zero.hom
            (CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι S U n)) :=
by
  classical
  let U_et : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ U.ι inferInstance
  let J := S.smallEtaleTopology
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  let A := ULift.{u} (ZMod n)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
  let P_et_prop : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  haveI : ∀ V : S.Etale, AlgebraicGeometry.Etale (Fgt.obj V).hom := fun V => V.prop
  haveI : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et_prop :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  letI : CategoryTheory.Category (CategoryTheory.MorphismProperty.Over P_et_prop ⊤ S) :=
    (inferInstance : CategoryTheory.Category S.Etale)
  haveI : CategoryTheory.Limits.HasPullbacks
      (CategoryTheory.MorphismProperty.Over P_et_prop ⊤ S) :=
    (inferInstance : CategoryTheory.Limits.HasPullbacks S.Etale)

  have h_mem_iota : ∀ {X_s : AlgebraicGeometry.Scheme.{u}} (V_o : X_s.Opens)
      (q : ↥(V_o : AlgebraicGeometry.Scheme.{u})), V_o.ι q ∈ V_o := by
    intro X_s V_o q
    change V_o.ι q ∈ (V_o : Set ↥X_s)
    rw [← AlgebraicGeometry.Scheme.Opens.range_ι V_o]
    exact ⟨q, rfl⟩

  have h_exists_iota : ∀ {X_s : AlgebraicGeometry.Scheme.{u}} {V_o : X_s.Opens} {w : ↥X_s},
      w ∈ V_o → ∃ q : ↥(V_o : AlgebraicGeometry.Scheme.{u}), V_o.ι q = w := by
    intro X_s V_o w hw
    have hw_range : w ∈ Set.range ⇑V_o.ι := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι V_o]
      exact hw
    exact hw_range

  have hEt_map : ∀ {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂),
      AlgebraicGeometry.Etale (Fgt.map v).left := by
    intro V₁ V₂ v
    have hvw : (Fgt.map v).left ≫ (Fgt.obj V₂).hom = (Fgt.obj V₁).hom := (Fgt.map v).w
    have hEt_comp : AlgebraicGeometry.Etale ((Fgt.map v).left ≫ (Fgt.obj V₂).hom) := by
      rw [hvw]
      exact V₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp P_et_prop
      (Fgt.map v).left (Fgt.obj V₂).hom V₂.prop hEt_comp

  let K_et : CategoryTheory.Pretopology S.Etale :=
    AlgebraicGeometry.Scheme.smallPretopology P_et_prop P_et_prop (S := S)

  have hJ_eq : S.smallEtaleTopology = K_et.toGrothendieck :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
      (le_refl P_et_prop)

  have hR_surj : ∀ {W : S.Etale} {R : CategoryTheory.Presieve W},
      R ∈ K_et.coverings W →
      ∀ w : ↥(Fgt.obj W).left,
        ∃ (Z : S.Etale) (u : Z ⟶ W) (_ : R u) (z : ↥(Fgt.obj Z).left),
          (Fgt.map u).left z = w := by
    intro W R hR w
    rcases hR.1 w with ⟨_, _, h1, z, hz⟩
    cases h1 with
    | of h2 =>
      cases h2 with
      | of h3 =>
        cases h3 with
        | @of Z u hu =>
          exact ⟨Z, u, hu, z, hz⟩

  let P_loc_set : S.Etaleᵒᵖ ⥤ Type u :=
    weilAltLocConstPresheaf S n ⋙ CategoryTheory.forget AddCommGrpCat.{u}
  let P_zero_set : S.Etaleᵒᵖ ⥤ Type u :=
    weilAltZeroBdrySubpresheaf S U n ⋙ CategoryTheory.forget AddCommGrpCat.{u}
  let val_loc : ∀ {Z : S.Etale},
      P_loc_set.obj (Opposite.op Z) → LocallyConstant ↥(Fgt.obj Z).left A :=
    fun g => g
  let val_zero : ∀ {Z : S.Etale},
      P_zero_set.obj (Opposite.op Z) → ↥(weilAltZeroBdrySubgroup S U n Z) :=
    fun g => g

  have hSheafFor_loc : ∀ {W : S.Etale} (R : CategoryTheory.Presieve W),
      (∀ w : ↥(Fgt.obj W).left,
        ∃ (Z : S.Etale) (u : Z ⟶ W) (_ : R u) (z : ↥(Fgt.obj Z).left),
          (Fgt.map u).left z = w) →
      CategoryTheory.Presieve.IsSheafFor P_loc_set R := by
    intro W R hSurj x hx
    have hAgree : ∀ {Z₁ Z₂ : S.Etale} {u₁ : Z₁ ⟶ W} {u₂ : Z₂ ⟶ W}
        (hu₁ : R u₁) (hu₂ : R u₂)
        (z₁ : ↥(Fgt.obj Z₁).left) (z₂ : ↥(Fgt.obj Z₂).left),
        (Fgt.map u₁).left z₁ = (Fgt.map u₂).left z₂ →
        val_loc (x u₁ hu₁) z₁ = val_loc (x u₂ hu₂) z₂ := by
      intro Z₁ Z₂ u₁ u₂ hu₁ hu₂ z₁ z₂ heq
      let f₁_sch := (Fgt.map u₁).left
      let f₂_sch := (Fgt.map u₂).left
      haveI : AlgebraicGeometry.Etale f₁_sch := hEt_map u₁
      haveI : AlgebraicGeometry.Etale f₂_sch := hEt_map u₂
      let p₁ := CategoryTheory.Limits.pullback.fst f₁_sch f₂_sch
      let p₂ := CategoryTheory.Limits.pullback.snd f₁_sch f₂_sch
      let P_et : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (Fgt.obj Z₁).hom) inferInstance
      let g₁ : P_et ⟶ Z₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
      have hp₂_hom : p₂ ≫ (Fgt.obj Z₂).hom = p₁ ≫ (Fgt.obj Z₁).hom := by
        rw [← (Fgt.map u₂).w, ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc,
          (Fgt.map u₁).w]
      let g₂ : P_et ⟶ Z₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ hp₂_hom trivial
      have hg_comm : g₁ ≫ u₁ = g₂ ≫ u₂ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact CategoryTheory.Limits.pullback.condition
      obtain ⟨q, hq₁, hq₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₁ z₂ heq
      have hcompat := hx g₁ g₂ hu₁ hu₂ hg_comm
      have hq_eq : @val_loc P_et ((P_loc_set.map g₁.op) (x u₁ hu₁)) q =
          @val_loc P_et ((P_loc_set.map g₂.op) (x u₂ hu₂)) q :=
        congrArg (fun f => @val_loc P_et f q) hcompat
      change val_loc (x u₁ hu₁) (p₁ q) = val_loc (x u₂ hu₂) (p₂ q) at hq_eq
      rwa [hq₁, hq₂] at hq_eq
    let g₀ : ↥(Fgt.obj W).left → A := fun w =>
      let h := hSurj w
      let u := Classical.choose (Classical.choose_spec h)
      let hu := Classical.choose (Classical.choose_spec (Classical.choose_spec h))
      let z := Classical.choose (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec h)))
      val_loc (x u hu) z
    have hg₀_eq : ∀ {Z : S.Etale} (u : Z ⟶ W) (hu : R u) (z : ↥(Fgt.obj Z).left),
        g₀ ((Fgt.map u).left z) = val_loc (x u hu) z := by
      intro Z u hu z
      let w := (Fgt.map u).left z
      let h := hSurj w
      let u' := Classical.choose (Classical.choose_spec h)
      let hu' := Classical.choose (Classical.choose_spec (Classical.choose_spec h))
      let z' := Classical.choose (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec h)))
      have hz' : (Fgt.map u').left z' = w :=
        Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec h)))
      exact hAgree hu' hu z' z hz'
    have hg₀_lc : IsLocallyConstant g₀ := by
      intro t
      rw [isOpen_iff_forall_mem_open]
      intro w hw
      obtain ⟨Z, u, hu, z, hzw⟩ := hSurj w
      haveI : AlgebraicGeometry.Etale (Fgt.map u).left := hEt_map u
      refine ⟨⇑((Fgt.map u).left) '' (⇑(val_loc (x u hu)) ⁻¹' t), ?_, ?_, ?_⟩
      · rintro _ ⟨z', hz', rfl⟩
        change g₀ ((Fgt.map u).left z') ∈ t
        rw [hg₀_eq u hu z']
        exact hz'
      · exact ((Fgt.map u).left).isOpenMap _ ((val_loc (x u hu)).isLocallyConstant t)
      · refine ⟨z, ?_, hzw⟩
        change val_loc (x u hu) z ∈ t
        rw [← hg₀_eq u hu z, hzw]
        exact hw
    let g_amalg : P_loc_set.obj (Opposite.op W) :=
      (⟨g₀, hg₀_lc⟩ : LocallyConstant ↥(Fgt.obj W).left A)
    refine ⟨g_amalg, ?_, ?_⟩
    · intro Z u hu
      exact LocallyConstant.ext (fun z => hg₀_eq u hu z)
    · intro g' hg'
      apply LocallyConstant.ext
      intro w
      obtain ⟨Z, u, hu, z, rfl⟩ := hSurj w
      calc
        val_loc g' ((Fgt.map u).left z)
          = val_loc ((P_loc_set.map u.op) g') z := rfl
        _ = val_loc (x u hu) z := by rw [hg' u hu]
        _ = g₀ ((Fgt.map u).left z) := (hg₀_eq u hu z).symm

  have hSh_loc₀ : CategoryTheory.Presheaf.IsSheaf J (weilAltLocConstPresheaf S n) := by
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J (weilAltLocConstPresheaf S n)
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    change CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology P_loc_set
    rw [hJ_eq, CategoryTheory.Presieve.isSheaf_pretopology]
    intro W R hR
    exact hSheafFor_loc R (hR_surj hR)

  have hSh_zero₀ : CategoryTheory.Presheaf.IsSheaf J (weilAltZeroBdrySubpresheaf S U n) := by
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J (weilAltZeroBdrySubpresheaf S U n)
      (CategoryTheory.forget AddCommGrpCat.{u})
    rw [CategoryTheory.isSheaf_iff_isSheaf_of_type]
    change CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology P_zero_set
    rw [hJ_eq, CategoryTheory.Presieve.isSheaf_pretopology]
    intro W R hR x hx
    have hSurj := hR_surj hR
    let x_loc : CategoryTheory.Presieve.FamilyOfElements P_loc_set R :=
      fun _ u hu => (val_zero (x u hu)).1
    have hx_loc : x_loc.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ hf₁ hf₂ hcomm
      exact congrArg Subtype.val (hx g₁ g₂ hf₁ hf₂ hcomm)
    obtain ⟨g_loc, hg_amalg, hg_uniq⟩ := hSheafFor_loc R hSurj x_loc hx_loc
    have hg_bdry : val_loc g_loc ∈ weilAltZeroBdrySubgroup S U n W := by
      intro w hw
      obtain ⟨Z, u, hu, z, rfl⟩ := hSurj w
      have hz_not_U : (Fgt.obj Z).hom z ∉ (U : Set ↥S) := by
        rw [← (Fgt.map u).w]
        exact hw
      have hz0 : (val_zero (x u hu)).1 z = 0 :=
        (val_zero (x u hu)).2 z hz_not_U
      calc
        val_loc g_loc ((Fgt.map u).left z)
          = val_loc ((P_loc_set.map u.op) g_loc) z := rfl
        _ = (val_zero (x u hu)).1 z :=
            congrArg (fun f => val_loc f z) (hg_amalg u hu)
        _ = 0 := hz0
    let g_zero_amalg : P_zero_set.obj (Opposite.op W) :=
      (⟨val_loc g_loc, hg_bdry⟩ : ↥(weilAltZeroBdrySubgroup S U n W))
    refine ⟨g_zero_amalg, ?_, ?_⟩
    · intro Z u hu
      exact Subtype.ext (hg_amalg u hu)
    · intro g' hg'
      apply Subtype.ext
      apply hg_uniq (val_zero g').1
      intro Z u hu
      exact congrArg Subtype.val (hg' u hu)

  refine ⟨hSh_loc₀, hSh_zero₀, fun hSh_loc hSh_zero => ?_⟩

  
  let W_sub : ∀ (W : S.Etale), ((Fgt.obj W).left).Opens → S.Etale :=
    fun W V_open =>
      CategoryTheory.MorphismProperty.Over.mk ⊤ (V_open.ι ≫ (Fgt.obj W).hom) inferInstance
  let u_sub : ∀ (W : S.Etale) (V_open : ((Fgt.obj W).left).Opens), W_sub W V_open ⟶ W :=
    fun _ V_open =>
      CategoryTheory.MorphismProperty.Over.homMk V_open.ι rfl trivial
  let hom_sub_le : ∀ (W : S.Etale) {V₁ V₂ : ((Fgt.obj W).left).Opens},
      V₁ ≤ V₂ → (W_sub W V₁ ⟶ W_sub W V₂) :=
    fun W {_ _} hle =>
      CategoryTheory.MorphismProperty.Over.homMk (((Fgt.obj W).left).homOfLE hle)
        (AlgebraicGeometry.Scheme.homOfLE_ι_assoc ((Fgt.obj W).left) hle (Fgt.obj W).hom)
        trivial
  have h_sub_le_comp : ∀ (W : S.Etale) {V₁ V₂ : ((Fgt.obj W).left).Opens} (hle : V₁ ≤ V₂),
      hom_sub_le W hle ≫ u_sub W V₂ = u_sub W V₁ := by
    intro W V₁ V₂ hle
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact AlgebraicGeometry.Scheme.homOfLE_ι ((Fgt.obj W).left) hle

  have hMap_comp_apply : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u})
      {V₁ V₂ V₃ : S.Etale} (f₁ : V₁ ⟶ V₂) (f₂ : V₂ ⟶ V₃)
      (s : ↥(𝒢.obj.obj (Opposite.op V₃))),
      (𝒢.obj.map (f₁ ≫ f₂).op).hom s =
        (𝒢.obj.map f₁.op).hom ((𝒢.obj.map f₂.op).hom s) := by
    intro 𝒢 V₁ V₂ V₃ f₁ f₂ s
    have hop : (f₁ ≫ f₂).op = (f₂.op ≫ f₁.op) := rfl
    rw [hop, 𝒢.obj.map_comp]
    rfl

  have hOpenArrows : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale)
      {ι : Type u} (O : ι → ((Fgt.obj W).left).Opens),
      (∀ w : ↥(Fgt.obj W).left, ∃ i : ι, w ∈ O i) →
      ∀ (s : ∀ i : ι, ↥(𝒢.obj.obj (Opposite.op (W_sub W (O i))))),
        CategoryTheory.Presieve.Arrows.Compatible
          (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
          (fun i => u_sub W (O i)) s →
        ∃! t : ↥(𝒢.obj.obj (Opposite.op W)),
          ∀ i : ι, (𝒢.obj.map (u_sub W (O i)).op).hom t = s i := by
    intro 𝒢 W ι O hcov
    let X_cov : ι → S.Etale := fun i => W_sub W (O i)
    let π_cov : ∀ i : ι, X_cov i ⟶ W := fun i => u_sub W (O i)
    have hMemPre : CategoryTheory.Presieve.ofArrows X_cov π_cov ∈ K_et.coverings W := by
      change CategoryTheory.Presieve.map (CategoryTheory.Over.forget S)
          (CategoryTheory.Presieve.map Fgt (CategoryTheory.Presieve.ofArrows X_cov π_cov)) ∈
        (AlgebraicGeometry.Scheme.precoverage P_et_prop).coverings ((Over.forget S).obj (Fgt.obj W))
      rw [CategoryTheory.Presieve.map_ofArrows, CategoryTheory.Presieve.map_ofArrows]
      exact (AlgebraicGeometry.Scheme.ofArrows_mem_precoverage_iff P_et_prop).mpr
        ⟨fun w => let ⟨i, hi⟩ := hcov w; ⟨i, h_exists_iota hi⟩,
         fun i => (inferInstance : AlgebraicGeometry.Etale (O i).ι)⟩
    have hMemJ : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows X_cov π_cov) ∈
        J W := by
      change _ ∈ S.smallEtaleTopology W
      rw [hJ_eq, CategoryTheory.Pretopology.mem_toGrothendieck]
      exact ⟨CategoryTheory.Presieve.ofArrows X_cov π_cov, hMemPre,
        CategoryTheory.Sieve.le_generate _⟩
    have hPresieve𝒢 : CategoryTheory.Presieve.IsSheaf J
        (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) :=
      (CategoryTheory.isSheaf_iff_isSheaf_of_type _ _).mp
        ((CategoryTheory.sheafCompose J (CategoryTheory.forget AddCommGrpCat.{u})).obj 𝒢).property
    have hShFor : CategoryTheory.Presieve.IsSheafFor
        (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
        (CategoryTheory.Presieve.ofArrows X_cov π_cov) :=
      (CategoryTheory.Presieve.isSheafFor_iff_generate _).mpr (hPresieve𝒢 _ hMemJ)
    exact (CategoryTheory.Presieve.isSheafFor_arrows_iff
      (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) π_cov).mp hShFor

  have hOpenSep : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale)
      {ι : Type u} (O : ι → ((Fgt.obj W).left).Opens),
      (∀ w : ↥(Fgt.obj W).left, ∃ i : ι, w ∈ O i) →
      ∀ (t₁ t₂ : ↥(𝒢.obj.obj (Opposite.op W))),
        (∀ i : ι, (𝒢.obj.map (u_sub W (O i)).op).hom t₁ =
          (𝒢.obj.map (u_sub W (O i)).op).hom t₂) →
        t₁ = t₂ := by
    intro 𝒢 W ι O hcov t₁ t₂ heq
    have hCompat : CategoryTheory.Presieve.Arrows.Compatible
        (𝒢.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u})
        (fun i => u_sub W (O i))
        (fun i => (𝒢.obj.map (u_sub W (O i)).op).hom t₁) := by
      intro i j Z gi gj hg
      change (𝒢.obj.map gi.op).hom ((𝒢.obj.map (u_sub W (O i)).op).hom t₁) =
        (𝒢.obj.map gj.op).hom ((𝒢.obj.map (u_sub W (O j)).op).hom t₁)
      rw [← hMap_comp_apply 𝒢 gi (u_sub W (O i)) t₁,
        ← hMap_comp_apply 𝒢 gj (u_sub W (O j)) t₁, hg]
    exact (hOpenArrows 𝒢 W O hcov _ hCompat).unique (fun _ => rfl) (fun i => (heq i).symm)

  have hEmptySub : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (Y : S.Etale),
      IsEmpty ↥(Fgt.obj Y).left →
      ∀ (a b : ↥(𝒢.obj.obj (Opposite.op Y))), a = b := by
    intro 𝒢 Y hEmpty a b
    exact hOpenSep 𝒢 Y (ι := PEmpty.{u + 1}) PEmpty.elim
      (fun y => hEmpty.elim y) a b (fun i => PEmpty.elim i)

  have hOpenGlue : ∀ (𝒢 : CategoryTheory.Sheaf J AddCommGrpCat.{u}) (W : S.Etale)
      {ι : Type u} (O : ι → ((Fgt.obj W).left).Opens),
      (∀ w : ↥(Fgt.obj W).left, ∃ i : ι, w ∈ O i) →
      ∀ (s : ∀ i : ι, ↥(𝒢.obj.obj (Opposite.op (W_sub W (O i))))),
        (∀ (i₁ i₂ : ι) (Y : S.Etale) (f₁ : Y ⟶ W_sub W (O i₁)) (f₂ : Y ⟶ W_sub W (O i₂)),
          f₁ ≫ u_sub W (O i₁) = f₂ ≫ u_sub W (O i₂) →
          ∀ (w₀ : ↥(Fgt.obj W).left), w₀ ∈ O i₁ → w₀ ∈ O i₂ →
            (𝒢.obj.map f₁.op).hom (s i₁) = (𝒢.obj.map f₂.op).hom (s i₂)) →
        ∃ t : ↥(𝒢.obj.obj (Opposite.op W)),
          ∀ i : ι, (𝒢.obj.map (u_sub W (O i)).op).hom t = s i := by
    intro 𝒢 W ι O hcov s hs
    obtain ⟨t, ht, -⟩ := hOpenArrows 𝒢 W O hcov s (by
      intro i₁ i₂ Y f₁ f₂ hcomm
      by_cases hne : Nonempty ↥(Fgt.obj Y).left
      · obtain ⟨z₀⟩ := hne
        let f₁' : Y ⟶ W_sub W (O i₁) := f₁
        let f₂' : Y ⟶ W_sub W (O i₂) := f₂
        have hcomm' : f₁' ≫ u_sub W (O i₁) = f₂' ≫ u_sub W (O i₂) := hcomm
        let w₀ : ↥(Fgt.obj W).left := (O i₁).ι ((Fgt.map f₁').left z₀)
        have hw₁ : w₀ ∈ O i₁ := h_mem_iota (O i₁) ((Fgt.map f₁').left z₀)
        have hw₂ : w₀ ∈ O i₂ := by
          have heq_w : w₀ = (O i₂).ι ((Fgt.map f₂').left z₀) :=
            congrArg (fun k : Y ⟶ W => (Fgt.map k).left z₀) hcomm'
          rw [heq_w]
          exact h_mem_iota (O i₂) ((Fgt.map f₂').left z₀)
        exact hs i₁ i₂ Y f₁' f₂' hcomm' w₀ hw₁ hw₂
      · exact hEmptySub 𝒢 Y (not_nonempty_iff.mp hne) _ _)
    exact ⟨t, ht⟩

  
  
  
  let P_const := (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM
  let F_tor : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleTorsionSheaf S n
  let L_loc : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf S n, hSh_loc⟩
  let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
  let η_const : P_const ⟶ F_tor.obj := adj_sh.unit.app P_const
  let η_hom : ∀ (V : S.Etale), A →+ ↥(F_tor.obj.obj (Opposite.op V)) :=
    fun V => (η_const.app (Opposite.op V)).hom

  have hη_nat : ∀ {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂) (a : A),
      (F_tor.obj.map v.op).hom (η_hom V₂ a) = η_hom V₁ a := by
    intro V₁ V₂ v a
    have hnat := η_const.naturality v.op
    exact (congrArg (fun k : AM ⟶ F_tor.obj.obj (Opposite.op V₁) => k.hom a) hnat).symm

  let γ_const : P_const ⟶ weilAltLocConstPresheaf S n :=
    { app := fun W => weilAltLocConstConstHom S (Opposite.unop W) n
      naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }
  let Φ_loc : F_tor ⟶ L_loc := (adj_sh.homEquiv P_const L_loc).symm γ_const

  have hΦ_loc_pin : ∀ W : S.Etale,
      η_const.app (Opposite.op W) ≫ Φ_loc.hom.app (Opposite.op W) =
        weilAltLocConstConstHom S W n := by
    intro W
    have h1 : adj_sh.unit.app P_const ≫
        (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map Φ_loc = γ_const := by
      have h2 := adj_sh.homEquiv_unit P_const L_loc Φ_loc
      exact h2.symm.trans (Equiv.apply_symm_apply _ _)
    exact congrArg (fun α : P_const ⟶ weilAltLocConstPresheaf S n => α.app (Opposite.op W)) h1

  let O_loc : ∀ (W : S.Etale),
      LocallyConstant ↥(Fgt.obj W).left A → ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
    fun _ g x => ⟨g ⁻¹' {g x}, g.isLocallyConstant {g x}⟩

  have hψ_loc_ex : ∀ (W : S.Etale) (g : LocallyConstant ↥(Fgt.obj W).left A),
      ∃ t : ↥(F_tor.obj.obj (Opposite.op W)),
        ∀ x : ↥(Fgt.obj W).left,
          (F_tor.obj.map (u_sub W (O_loc W g x)).op).hom t =
            η_hom (W_sub W (O_loc W g x)) (g x) := by
    intro W g
    refine hOpenGlue F_tor W (O_loc W g) (fun x => ⟨x, rfl⟩)
      (fun x => η_hom (W_sub W (O_loc W g x)) (g x)) ?_
    intro x₁ x₂ Y f₁ f₂ _ w₀ hw₁ hw₂
    have hg₁ : g w₀ = g x₁ := hw₁
    have hg₂ : g w₀ = g x₂ := hw₂
    rw [hη_nat f₁ (g x₁), hη_nat f₂ (g x₂), ← hg₁, ← hg₂]

  let ψ_loc_fun : ∀ (W : S.Etale),
      LocallyConstant ↥(Fgt.obj W).left A → ↥(F_tor.obj.obj (Opposite.op W)) :=
    fun W g => Classical.choose (hψ_loc_ex W g)
  have hψ_loc_spec : ∀ (W : S.Etale) (g : LocallyConstant ↥(Fgt.obj W).left A)
      (x : ↥(Fgt.obj W).left),
      (F_tor.obj.map (u_sub W (O_loc W g x)).op).hom (ψ_loc_fun W g) =
        η_hom (W_sub W (O_loc W g x)) (g x) :=
    fun W g => Classical.choose_spec (hψ_loc_ex W g)

  let Ψ_loc : L_loc ⟶ F_tor :=
    CategoryTheory.ObjectProperty.homMk
      { app := fun opW =>
          let W := Opposite.unop opW
          AddCommGrpCat.ofHom
            { toFun := ψ_loc_fun W
              map_zero' := by
                apply hOpenSep F_tor W (O_loc W 0) (fun x => ⟨x, rfl⟩)
                intro x
                rw [hψ_loc_spec W 0 x, LocallyConstant.zero_apply, map_zero, map_zero]
              map_add' := fun g₁ g₂ => by
                let O₁₂ : ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
                  fun x => O_loc W g₁ x ⊓ O_loc W g₂ x
                apply hOpenSep F_tor W O₁₂ (fun x => ⟨x, ⟨rfl, rfl⟩⟩)
                intro x
                have hle₁ : O₁₂ x ≤ O_loc W g₁ x := inf_le_left
                have hle₂ : O₁₂ x ≤ O_loc W g₂ x := inf_le_right
                have hle₁₂ : O₁₂ x ≤ O_loc W (g₁ + g₂) x := by
                  intro z hz
                  have hz₁ : g₁ z = g₁ x := hz.1
                  have hz₂ : g₂ z = g₂ x := hz.2
                  change g₁ z + g₂ z = g₁ x + g₂ x
                  rw [hz₁, hz₂]
                have hr₁ : (F_tor.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_loc_fun W g₁) =
                    η_hom (W_sub W (O₁₂ x)) (g₁ x) := by
                  rw [← h_sub_le_comp W hle₁, hMap_comp_apply F_tor, hψ_loc_spec W g₁ x, hη_nat]
                have hr₂ : (F_tor.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_loc_fun W g₂) =
                    η_hom (W_sub W (O₁₂ x)) (g₂ x) := by
                  rw [← h_sub_le_comp W hle₂, hMap_comp_apply F_tor, hψ_loc_spec W g₂ x, hη_nat]
                have hr₁₂ : (F_tor.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_loc_fun W (g₁ + g₂)) =
                    η_hom (W_sub W (O₁₂ x)) (g₁ x + g₂ x) := by
                  rw [← h_sub_le_comp W hle₁₂, hMap_comp_apply F_tor,
                    hψ_loc_spec W (g₁ + g₂) x, hη_nat]
                  rfl
                rw [map_add, hr₁, hr₂, hr₁₂, map_add] }
        naturality := fun {opW₁ opW₂} f_op => by
          let W := Opposite.unop opW₁
          let W' := Opposite.unop opW₂
          let f : W' ⟶ W := f_op.unop
          apply AddCommGrpCat.ext
          intro (g : LocallyConstant ↥(Fgt.obj W).left A)
          let g' : LocallyConstant ↥(Fgt.obj W').left A :=
            ((weilAltLocConstPresheaf S n).map f_op).hom g
          change ψ_loc_fun W' g' = (F_tor.obj.map f.op).hom (ψ_loc_fun W g)
          apply hOpenSep F_tor W' (O_loc W' g') (fun y => ⟨y, rfl⟩)
          intro y
          rw [hψ_loc_spec W' g' y]
          let x : ↥(Fgt.obj W).left := (Fgt.map f).left y
          have hrange : Set.range ⇑((O_loc W' g' y).ι ≫ (Fgt.map f).left) ⊆
              Set.range ⇑(O_loc W g x).ι := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨q, rfl⟩
            exact h_mem_iota (O_loc W' g' y) q
          let ℓ_y := AlgebraicGeometry.IsOpenImmersion.lift (O_loc W g x).ι
            ((O_loc W' g' y).ι ≫ (Fgt.map f).left) hrange
          have hℓ_fac : ℓ_y ≫ (O_loc W g x).ι = (O_loc W' g' y).ι ≫ (Fgt.map f).left :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hrange
          have hℓ_over : ℓ_y ≫ (Fgt.obj (W_sub W (O_loc W g x))).hom =
              (Fgt.obj (W_sub W' (O_loc W' g' y))).hom := by
            change ℓ_y ≫ (O_loc W g x).ι ≫ (Fgt.obj W).hom =
              (O_loc W' g' y).ι ≫ (Fgt.obj W').hom
            rw [← CategoryTheory.Category.assoc, hℓ_fac, CategoryTheory.Category.assoc,
              (Fgt.map f).w]
          let k_y : W_sub W' (O_loc W' g' y) ⟶ W_sub W (O_loc W g x) :=
            CategoryTheory.MorphismProperty.Over.homMk ℓ_y hℓ_over trivial
          have hk_comm : k_y ≫ u_sub W (O_loc W g x) = u_sub W' (O_loc W' g' y) ≫ f := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact hℓ_fac
          have hmap_eq : (F_tor.obj.map (u_sub W' (O_loc W' g' y)).op).hom
              ((F_tor.obj.map f.op).hom (ψ_loc_fun W g)) =
              (F_tor.obj.map k_y.op).hom
                ((F_tor.obj.map (u_sub W (O_loc W g x)).op).hom (ψ_loc_fun W g)) := by
            rw [← hMap_comp_apply F_tor (u_sub W' (O_loc W' g' y)) f,
              ← hMap_comp_apply F_tor k_y (u_sub W (O_loc W g x)), hk_comm]
          rw [hmap_eq, hψ_loc_spec W g x, hη_nat k_y (g x)]
          rfl }

  have hΦΨ_loc : Φ_loc ≫ Ψ_loc = 𝟙 F_tor := by
    let F_tor' := (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj P_const
    apply (adj_sh.homEquiv P_const F_tor).injective
    have h1 : (adj_sh.homEquiv P_const F_tor) (Φ_loc ≫ Ψ_loc) =
        η_const ≫ (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map (Φ_loc ≫ Ψ_loc) :=
      adj_sh.homEquiv_unit P_const F_tor (Φ_loc ≫ Ψ_loc)
    have h2 : (adj_sh.homEquiv P_const F_tor') (𝟙 F_tor') = adj_sh.unit.app P_const :=
      (adj_sh.homEquiv_unit P_const F_tor' (𝟙 F_tor')).trans
        (CategoryTheory.NatTrans.ext (funext fun _ => AddCommGrpCat.ext fun _ => rfl))
    refine h1.trans (Eq.trans ?_ h2.symm)
    apply CategoryTheory.NatTrans.ext
    funext opW
    let W := Opposite.unop opW
    apply AddCommGrpCat.ext
    intro (a : A)
    have hconst : ((Φ_loc.hom.app (Opposite.op W)).hom (η_hom W a)) =
        LocallyConstant.const ↥(Fgt.obj W).left a := by
      have hp := hΦ_loc_pin W
      exact congrArg (fun k : AM ⟶ (weilAltLocConstPresheaf S n).obj (Opposite.op W) => k.hom a) hp
    change ψ_loc_fun W ((Φ_loc.hom.app (Opposite.op W)).hom (η_hom W a)) = η_hom W a
    rw [hconst]
    apply hOpenSep F_tor W (O_loc W (LocallyConstant.const _ a)) (fun x => ⟨x, rfl⟩)
    intro x
    rw [hψ_loc_spec, hη_nat]
    rfl

  have hΨΦ_loc : Ψ_loc ≫ Φ_loc = 𝟙 L_loc := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext opW
    let W := Opposite.unop opW
    apply AddCommGrpCat.ext
    intro (g : LocallyConstant ↥(Fgt.obj W).left A)
    apply LocallyConstant.ext
    intro x
    have hx_in : x ∈ O_loc W g x := rfl
    obtain ⟨y₀, hy₀⟩ := h_exists_iota hx_in
    have hnat_u := Φ_loc.hom.naturality (u_sub W (O_loc W g x)).op
    have hev := congrArg
      (fun k : F_tor.obj.obj (Opposite.op W) ⟶
          (weilAltLocConstPresheaf S n).obj (Opposite.op (W_sub W (O_loc W g x))) =>
        (@val_loc (W_sub W (O_loc W g x)) (k.hom (ψ_loc_fun W g))) y₀)
      hnat_u
    change (@val_loc (W_sub W (O_loc W g x))
        ((Φ_loc.hom.app (Opposite.op (W_sub W (O_loc W g x)))).hom
          ((F_tor.obj.map (u_sub W (O_loc W g x)).op).hom (ψ_loc_fun W g)))) y₀ =
      (@val_loc W ((Φ_loc.hom.app (Opposite.op W)).hom (ψ_loc_fun W g)))
        ((O_loc W g x).ι y₀) at hev
    rw [hy₀, hψ_loc_spec W g x] at hev
    have hpin := congrArg
      (fun k : AM ⟶ (weilAltLocConstPresheaf S n).obj (Opposite.op (W_sub W (O_loc W g x))) =>
        (@val_loc (W_sub W (O_loc W g x)) (k.hom (g x))) y₀)
      (hΦ_loc_pin (W_sub W (O_loc W g x)))
    change (@val_loc W ((Φ_loc.hom.app (Opposite.op W)).hom (ψ_loc_fun W g))) x = g x
    exact hev.symm.trans hpin

  let e_loc : CategoryTheory.Iso F_tor L_loc :=
    { hom := Φ_loc, inv := Ψ_loc, hom_inv_id := hΦΨ_loc, inv_hom_id := hΨΦ_loc }

  
  
  
  let L_U : CategoryTheory.Sheaf J AddCommGrpCat.{u} := weilEtaleLocalTorsionSheaf S n U_et
  let K_U : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨weilAltZeroBdrySubpresheaf S U n, hSh_zero⟩
  let η_U : AM ⟶ L_U.obj.obj (Opposite.op U_et) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 L_U)
  let η_U_hom : A →+ ↥(L_U.obj.obj (Opposite.op U_et)) := η_U.hom

  have hEquiv_comp : ∀ {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
      (α : L_U ⟶ F) (m : F ⟶ G),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ m) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ m.hom.app (Opposite.op U_et) := by
    intro F G α m
    let α' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda U_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((adj_sh.homEquiv _ G) (α' ≫ m)))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            ((adj_sh.homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map m) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ m.hom.app (Opposite.op U_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hSub_Uet : ∀ {Y : S.Etale} (h₁ h₂ : Y ⟶ U_et), h₁ = h₂ := by
    intro Y h₁ h₂
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    have hw₁ : (Fgt.map h₁).left ≫ U.ι = (Fgt.obj Y).hom := (Fgt.map h₁).w
    have hw₂ : (Fgt.map h₂).left ≫ U.ι = (Fgt.obj Y).hom := (Fgt.map h₂).w
    exact (cancel_mono U.ι).mp (hw₁.trans hw₂.symm)

  let α₀ : AM ⟶ K_U.obj.obj (Opposite.op U_et) :=
    AddCommGrpCat.ofHom
      { toFun := fun a =>
          ⟨LocallyConstant.const ↥(Fgt.obj U_et).left a, fun z hz =>
            False.elim (hz (h_mem_iota U z))⟩
        map_zero' := Subtype.ext (LocallyConstant.ext (fun _ => rfl))
        map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext (fun _ => rfl)) }
  let α₀_hom : A →+ ↥(weilAltZeroBdrySubgroup S U n U_et) := α₀.hom
  let Φ_zero : L_U ⟶ K_U := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm α₀

  have hΦ_zero_equiv : CategoryTheory.Sheaf.freeYonedaHomEquiv Φ_zero = α₀ :=
    Equiv.apply_symm_apply _ _

  have hΦ_zero_η : η_U ≫ Φ_zero.hom.app (Opposite.op U_et) = α₀ := by
    have h1 := hEquiv_comp (𝟙 L_U) Φ_zero
    rw [CategoryTheory.Category.id_comp, hΦ_zero_equiv] at h1
    exact h1.symm

  let O_zero : ∀ (W : S.Etale),
      ↥(weilAltZeroBdrySubgroup S U n W) → ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
    fun W g0 x =>
      if (Fgt.obj W).hom x ∈ (U : Set ↥S) then
        (TopologicalSpace.Opens.map ((Fgt.obj W).hom).base).obj U ⊓
          ⟨g0.1 ⁻¹' {g0.1 x}, g0.1.isLocallyConstant {g0.1 x}⟩
      else
        ⟨g0.1 ⁻¹' {g0.1 x}, g0.1.isLocallyConstant {g0.1 x}⟩

  have hO_zero_mem : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
      (x : ↥(Fgt.obj W).left), x ∈ O_zero W g0 x := by
    intro W g0 x
    dsimp only [O_zero]
    split_ifs with hx
    · exact ⟨hx, rfl⟩
    · exact rfl

  have hO_zero_val : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
      (x w : ↥(Fgt.obj W).left), w ∈ O_zero W g0 x → g0.1 w = g0.1 x := by
    intro W g0 x w hw
    dsimp only [O_zero] at hw
    split_ifs at hw with hx
    · exact hw.2
    · exact hw

  have hO_zero_sub_U : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
      (x w : ↥(Fgt.obj W).left),
      (Fgt.obj W).hom x ∈ (U : Set ↥S) → w ∈ O_zero W g0 x →
      (Fgt.obj W).hom w ∈ (U : Set ↥S) := by
    intro W g0 x w hx hw
    dsimp only [O_zero] at hw
    split_ifs at hw with hx'
    · exact hw.1
    · exact False.elim (hx' hx)

  let p_sch : ∀ (W : S.Etale), (Fgt.obj W).left ⟶ S := fun W => (Fgt.obj W).hom

  have hO_zero_in_U : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
      (x : ↥(Fgt.obj W).left),
      (Fgt.obj W).hom x ∈ (U : Set ↥S) →
      Set.range ⇑((O_zero W g0 x).ι ≫ p_sch W) ⊆ Set.range ⇑U.ι := by
    intro W g0 x hx
    rw [AlgebraicGeometry.Scheme.Opens.range_ι U]
    rintro _ ⟨q, rfl⟩
    exact hO_zero_sub_U W g0 x ((O_zero W g0 x).ι q) hx (h_mem_iota (O_zero W g0 x) q)

  let lift_Uet : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
      (x : ↥(Fgt.obj W).left),
      (Fgt.obj W).hom x ∈ (U : Set ↥S) → (W_sub W (O_zero W g0 x) ⟶ U_et) :=
    fun W g0 x hx =>
      let ℓ := AlgebraicGeometry.IsOpenImmersion.lift U.ι ((O_zero W g0 x).ι ≫ p_sch W)
        (hO_zero_in_U W g0 x hx)
      have hℓ : ℓ ≫ U.ι = (O_zero W g0 x).ι ≫ p_sch W :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac U.ι ((O_zero W g0 x).ι ≫ p_sch W)
          (hO_zero_in_U W g0 x hx)
      CategoryTheory.MorphismProperty.Over.homMk ℓ hℓ trivial

  let τ_zero : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
      (x : ↥(Fgt.obj W).left), ↥(L_U.obj.obj (Opposite.op (W_sub W (O_zero W g0 x)))) :=
    fun W g0 x =>
      if hx : (Fgt.obj W).hom x ∈ (U : Set ↥S) then
        (L_U.obj.map (lift_Uet W g0 x hx).op).hom (η_U_hom (g0.1 x))
      else
        0

  have hψ_zero_ex : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W)),
      ∃ t : ↥(L_U.obj.obj (Opposite.op W)),
        ∀ x : ↥(Fgt.obj W).left,
          (L_U.obj.map (u_sub W (O_zero W g0 x)).op).hom t = τ_zero W g0 x := by
    intro W g0
    refine hOpenGlue L_U W (O_zero W g0) (fun x => ⟨x, hO_zero_mem W g0 x⟩) (τ_zero W g0) ?_
    intro x₁ x₂ Y f₁ f₂ _ w₀ hw₁ hw₂
    have hg₁ : g0.1 w₀ = g0.1 x₁ := hO_zero_val W g0 x₁ w₀ hw₁
    have hg₂ : g0.1 w₀ = g0.1 x₂ := hO_zero_val W g0 x₂ w₀ hw₂
    have hg₁₂ : g0.1 x₁ = g0.1 x₂ := hg₁.symm.trans hg₂
    dsimp only [τ_zero]
    split_ifs with hx₁ hx₂
    · have h_hom_eq : f₁ ≫ lift_Uet W g0 x₁ hx₁ = f₂ ≫ lift_Uet W g0 x₂ hx₂ :=
        hSub_Uet _ _
      rw [← hMap_comp_apply L_U f₁ (lift_Uet W g0 x₁ hx₁),
        ← hMap_comp_apply L_U f₂ (lift_Uet W g0 x₂ hx₂), h_hom_eq, hg₁₂]
    · have hx₂_zero : g0.1 x₂ = 0 := g0.2 x₂ hx₂
      rw [hg₁₂, hx₂_zero, map_zero, map_zero, map_zero, map_zero]
    · have hx₁_zero : g0.1 x₁ = 0 := g0.2 x₁ hx₁
      rw [← hg₁₂, hx₁_zero, map_zero, map_zero, map_zero, map_zero]
    · rw [map_zero, map_zero]

  let ψ_zero_fun : ∀ (W : S.Etale),
      ↥(weilAltZeroBdrySubgroup S U n W) → ↥(L_U.obj.obj (Opposite.op W)) :=
    fun W g0 => Classical.choose (hψ_zero_ex W g0)
  have hψ_zero_spec : ∀ (W : S.Etale) (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
      (x : ↥(Fgt.obj W).left),
      (L_U.obj.map (u_sub W (O_zero W g0 x)).op).hom (ψ_zero_fun W g0) = τ_zero W g0 x :=
    fun W g0 => Classical.choose_spec (hψ_zero_ex W g0)

  let Ψ_zero : K_U ⟶ L_U :=
    CategoryTheory.ObjectProperty.homMk
      { app := fun opW =>
          let W := Opposite.unop opW
          AddCommGrpCat.ofHom
            { toFun := ψ_zero_fun W
              map_zero' := by
                apply hOpenSep L_U W (O_zero W 0) (fun x => ⟨x, hO_zero_mem W 0 x⟩)
                intro x
                rw [hψ_zero_spec W 0 x, map_zero]
                dsimp only [τ_zero]
                split_ifs
                · change (L_U.obj.map _).hom (η_U_hom 0) = 0
                  rw [map_zero, map_zero]
                · rfl
              map_add' := fun g0₁ g0₂ => by
                let O₁₂ : ↥(Fgt.obj W).left → ((Fgt.obj W).left).Opens :=
                  fun x => O_zero W g0₁ x ⊓ O_zero W g0₂ x
                apply hOpenSep L_U W O₁₂
                  (fun x => ⟨x, ⟨hO_zero_mem W g0₁ x, hO_zero_mem W g0₂ x⟩⟩)
                intro x
                have hle₁ : O₁₂ x ≤ O_zero W g0₁ x := inf_le_left
                have hle₂ : O₁₂ x ≤ O_zero W g0₂ x := inf_le_right
                have hle₁₂ : O₁₂ x ≤ O_zero W (g0₁ + g0₂) x := by
                  intro z hz
                  have hz₁ : g0₁.1 z = g0₁.1 x := hO_zero_val W g0₁ x z hz.1
                  have hz₂ : g0₂.1 z = g0₂.1 x := hO_zero_val W g0₂ x z hz.2
                  have hz_add : (g0₁ + g0₂).1 z = (g0₁ + g0₂).1 x := by
                    change g0₁.1 z + g0₂.1 z = g0₁.1 x + g0₂.1 x
                    rw [hz₁, hz₂]
                  dsimp only [O_zero]
                  split_ifs with hx
                  · exact ⟨hO_zero_sub_U W g0₁ x z hx hz.1, hz_add⟩
                  · exact hz_add
                have hr₁ : (L_U.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_zero_fun W g0₁) =
                    (L_U.obj.map (hom_sub_le W hle₁).op).hom (τ_zero W g0₁ x) := by
                  rw [← h_sub_le_comp W hle₁, hMap_comp_apply L_U, hψ_zero_spec W g0₁ x]
                have hr₂ : (L_U.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_zero_fun W g0₂) =
                    (L_U.obj.map (hom_sub_le W hle₂).op).hom (τ_zero W g0₂ x) := by
                  rw [← h_sub_le_comp W hle₂, hMap_comp_apply L_U, hψ_zero_spec W g0₂ x]
                have hr₁₂ : (L_U.obj.map (u_sub W (O₁₂ x)).op).hom (ψ_zero_fun W (g0₁ + g0₂)) =
                    (L_U.obj.map (hom_sub_le W hle₁₂).op).hom (τ_zero W (g0₁ + g0₂) x) := by
                  rw [← h_sub_le_comp W hle₁₂, hMap_comp_apply L_U,
                    hψ_zero_spec W (g0₁ + g0₂) x]
                rw [map_add, hr₁, hr₂, hr₁₂]
                dsimp only [τ_zero]
                split_ifs with hx
                · let h_com : W_sub W (O₁₂ x) ⟶ U_et :=
                    hom_sub_le W hle₁₂ ≫ lift_Uet W (g0₁ + g0₂) x hx
                  have he₁ : hom_sub_le W hle₁ ≫ lift_Uet W g0₁ x hx = h_com := hSub_Uet _ _
                  have he₂ : hom_sub_le W hle₂ ≫ lift_Uet W g0₂ x hx = h_com := hSub_Uet _ _
                  rw [← hMap_comp_apply L_U (hom_sub_le W hle₁) (lift_Uet W g0₁ x hx),
                    ← hMap_comp_apply L_U (hom_sub_le W hle₂) (lift_Uet W g0₂ x hx),
                    ← hMap_comp_apply L_U (hom_sub_le W hle₁₂) (lift_Uet W (g0₁ + g0₂) x hx),
                    he₁, he₂]
                  change (L_U.obj.map h_com.op).hom (η_U_hom (g0₁.1 x + g0₂.1 x)) = _
                  rw [map_add, map_add]
                · rw [map_zero, map_zero, map_zero, add_zero] }
        naturality := fun {opW₁ opW₂} f_op => by
          let W := Opposite.unop opW₁
          let W' := Opposite.unop opW₂
          let f : W' ⟶ W := f_op.unop
          apply AddCommGrpCat.ext
          intro (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
          let g0' : ↥(weilAltZeroBdrySubgroup S U n W') :=
            ((weilAltZeroBdrySubpresheaf S U n).map f_op).hom g0
          change ψ_zero_fun W' g0' = (L_U.obj.map f.op).hom (ψ_zero_fun W g0)
          apply hOpenSep L_U W' (O_zero W' g0') (fun y => ⟨y, hO_zero_mem W' g0' y⟩)
          intro y
          rw [hψ_zero_spec W' g0' y]
          let x : ↥(Fgt.obj W).left := (Fgt.map f).left y
          have hhom_yx : (Fgt.obj W').hom y = (Fgt.obj W).hom x := by
            rw [← (Fgt.map f).w]
            rfl
          have hrange : Set.range ⇑((O_zero W' g0' y).ι ≫ (Fgt.map f).left) ⊆
              Set.range ⇑(O_zero W g0 x).ι := by
            rw [AlgebraicGeometry.Scheme.Opens.range_ι]
            rintro _ ⟨q, rfl⟩
            have hq : (O_zero W' g0' y).ι q ∈ O_zero W' g0' y := h_mem_iota (O_zero W' g0' y) q
            let w_q : ↥(Fgt.obj W).left := (Fgt.map f).left ((O_zero W' g0' y).ι q)
            have hq_val : g0.1 w_q = g0.1 x :=
              hO_zero_val W' g0' y ((O_zero W' g0' y).ι q) hq
            change w_q ∈ O_zero W g0 x
            dsimp only [O_zero]
            split_ifs with hx
            · have hy_in : (Fgt.obj W').hom y ∈ (U : Set ↥S) := hhom_yx.symm ▸ hx
              have hq_in' : (Fgt.obj W').hom ((O_zero W' g0' y).ι q) ∈ (U : Set ↥S) :=
                hO_zero_sub_U W' g0' y ((O_zero W' g0' y).ι q) hy_in hq
              have hq_in : (Fgt.obj W).hom w_q ∈ (U : Set ↥S) := by
                have hpt : (Fgt.obj W).hom w_q =
                    (Fgt.obj W').hom ((O_zero W' g0' y).ι q) := by
                  rw [← (Fgt.map f).w]
                  rfl
                rw [hpt]
                exact hq_in'
              exact ⟨hq_in, hq_val⟩
            · exact hq_val
          let ℓ_y := AlgebraicGeometry.IsOpenImmersion.lift (O_zero W g0 x).ι
            ((O_zero W' g0' y).ι ≫ (Fgt.map f).left) hrange
          have hℓ_fac : ℓ_y ≫ (O_zero W g0 x).ι = (O_zero W' g0' y).ι ≫ (Fgt.map f).left :=
            AlgebraicGeometry.IsOpenImmersion.lift_fac _ _ hrange
          have hℓ_over : ℓ_y ≫ (Fgt.obj (W_sub W (O_zero W g0 x))).hom =
              (Fgt.obj (W_sub W' (O_zero W' g0' y))).hom := by
            change ℓ_y ≫ (O_zero W g0 x).ι ≫ (Fgt.obj W).hom =
              (O_zero W' g0' y).ι ≫ (Fgt.obj W').hom
            rw [← CategoryTheory.Category.assoc, hℓ_fac, CategoryTheory.Category.assoc,
              (Fgt.map f).w]
          let k_y : W_sub W' (O_zero W' g0' y) ⟶ W_sub W (O_zero W g0 x) :=
            CategoryTheory.MorphismProperty.Over.homMk ℓ_y hℓ_over trivial
          have hk_comm : k_y ≫ u_sub W (O_zero W g0 x) = u_sub W' (O_zero W' g0' y) ≫ f := by
            apply CategoryTheory.MorphismProperty.Over.Hom.ext
            exact hℓ_fac
          have hmap_eq : (L_U.obj.map (u_sub W' (O_zero W' g0' y)).op).hom
              ((L_U.obj.map f.op).hom (ψ_zero_fun W g0)) =
              (L_U.obj.map k_y.op).hom
                ((L_U.obj.map (u_sub W (O_zero W g0 x)).op).hom (ψ_zero_fun W g0)) := by
            rw [← hMap_comp_apply L_U (u_sub W' (O_zero W' g0' y)) f,
              ← hMap_comp_apply L_U k_y (u_sub W (O_zero W g0 x)), hk_comm]
          rw [hmap_eq, hψ_zero_spec W g0 x]
          dsimp only [τ_zero]
          split_ifs with hy hx₁ hx₂
          · have h_lift_eq : k_y ≫ lift_Uet W g0 x hx₁ = lift_Uet W' g0' y hy := hSub_Uet _ _
            rw [← hMap_comp_apply L_U k_y (lift_Uet W g0 x hx₁), h_lift_eq]
            rfl
          · exact False.elim (hx₁ (hhom_yx ▸ hy))
          · exact False.elim (hy (hhom_yx.symm ▸ hx₂))
          · rw [map_zero] }

  have hΦΨ_zero : Φ_zero ≫ Ψ_zero = 𝟙 L_U := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hEquiv_comp Φ_zero Ψ_zero, hΦ_zero_equiv]
    apply AddCommGrpCat.ext
    intro (a : A)
    change ψ_zero_fun U_et (α₀_hom a) = η_U_hom a
    apply hOpenSep L_U U_et (O_zero U_et (α₀_hom a))
      (fun x => ⟨x, hO_zero_mem U_et (α₀_hom a) x⟩)
    intro x
    rw [hψ_zero_spec U_et (α₀_hom a) x]
    have hx : (Fgt.obj U_et).hom x ∈ (U : Set ↥S) := h_mem_iota U x
    dsimp only [τ_zero]
    split_ifs with hx'
    · have h_eq_u : lift_Uet U_et (α₀_hom a) x hx' = u_sub U_et (O_zero U_et (α₀_hom a) x) :=
        hSub_Uet _ _
      rw [h_eq_u]
      rfl
    · exact False.elim (hx' hx)

  have hΨΦ_zero : Ψ_zero ≫ Φ_zero = 𝟙 K_U := by
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext opW
    let W := Opposite.unop opW
    apply AddCommGrpCat.ext
    intro (g0 : ↥(weilAltZeroBdrySubgroup S U n W))
    apply Subtype.ext
    apply LocallyConstant.ext
    intro x
    obtain ⟨y₀, hy₀⟩ := h_exists_iota (hO_zero_mem W g0 x)
    have hnat_u := Φ_zero.hom.naturality (u_sub W (O_zero W g0 x)).op
    have hev := congrArg
      (fun k : L_U.obj.obj (Opposite.op W) ⟶
          (weilAltZeroBdrySubpresheaf S U n).obj (Opposite.op (W_sub W (O_zero W g0 x))) =>
        (k.hom (ψ_zero_fun W g0) : ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀)
      hnat_u
    change ((Φ_zero.hom.app (Opposite.op (W_sub W (O_zero W g0 x)))).hom
        ((L_U.obj.map (u_sub W (O_zero W g0 x)).op).hom (ψ_zero_fun W g0)) :
        ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀ =
      ((Φ_zero.hom.app (Opposite.op W)).hom (ψ_zero_fun W g0) :
        ↥(weilAltZeroBdrySubgroup S U n W)).1 ((O_zero W g0 x).ι y₀) at hev
    rw [hy₀, hψ_zero_spec W g0 x] at hev
    change ((Φ_zero.hom.app (Opposite.op W)).hom (ψ_zero_fun W g0) :
        ↥(weilAltZeroBdrySubgroup S U n W)).1 x = g0.1 x
    rw [← hev]
    dsimp only [τ_zero]
    split_ifs with hx
    · have hnat_h := Φ_zero.hom.naturality (lift_Uet W g0 x hx).op
      have hev_h := congrArg
        (fun k : L_U.obj.obj (Opposite.op U_et) ⟶
            (weilAltZeroBdrySubpresheaf S U n).obj (Opposite.op (W_sub W (O_zero W g0 x))) =>
          (k.hom (η_U_hom (g0.1 x)) : ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀)
        hnat_h
      change ((Φ_zero.hom.app (Opposite.op (W_sub W (O_zero W g0 x)))).hom
          ((L_U.obj.map (lift_Uet W g0 x hx).op).hom (η_U_hom (g0.1 x))) :
          ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀ =
        (((weilAltZeroBdrySubpresheaf S U n).map (lift_Uet W g0 x hx).op).hom
          ((Φ_zero.hom.app (Opposite.op U_et)).hom (η_U_hom (g0.1 x))) :
          ↥(weilAltZeroBdrySubgroup S U n _)).1 y₀ at hev_h
      rw [hev_h]
      have hα_eq : (Φ_zero.hom.app (Opposite.op U_et)).hom (η_U_hom (g0.1 x)) =
          α₀_hom (g0.1 x) :=
        congrArg (fun k : AM ⟶ K_U.obj.obj (Opposite.op U_et) => k.hom (g0.1 x)) hΦ_zero_η
      rw [hα_eq]
      rfl
    · rw [map_zero]
      exact (g0.2 x hx).symm

  let e_zero : CategoryTheory.Iso L_U K_U :=
    { hom := Φ_zero, inv := Ψ_zero, hom_inv_id := hΦΨ_zero, inv_hom_id := hΨΦ_zero }

  
  
  
  refine ⟨e_loc, e_zero, ?_⟩
  apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
  let ι_sh : K_U ⟶ L_loc :=
    CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι S U n)
  have hL := hEquiv_comp (weilEtaleLocalTorsionCounit S n U_et) e_loc.hom
  have hR := hEquiv_comp e_zero.hom ι_sh
  refine hL.trans (Eq.trans ?_ hR.symm)
  have hcounit : CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S n U_et) =
      η_const.app (Opposite.op U_et) :=
    Equiv.apply_symm_apply _ _
  change CategoryTheory.Sheaf.freeYonedaHomEquiv (weilEtaleLocalTorsionCounit S n U_et) ≫
      Φ_loc.hom.app (Opposite.op U_et) =
    CategoryTheory.Sheaf.freeYonedaHomEquiv Φ_zero ≫
      (weilAltZeroBdrySubpresheafι S U n).app (Opposite.op U_et)
  rw [hcounit, hΦ_loc_pin U_et, hΦ_zero_equiv]
  exact AddCommGrpCat.ext (fun _ => rfl)

theorem weil_etale_disjoint_closed_sections_locConst_shortExact (k : Type u) [Field k] [IsAlgClosed k]
    (X : AlgebraicGeometry.Scheme.{u})
    (m n : ℕ)
    (σ : Fin m → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) X)
    (hσ_cl : ∀ a : Fin m, AlgebraicGeometry.IsClosedImmersion (σ a))
    (hσ_disj : _root_.Pairwise fun a b : Fin m =>
      Disjoint (Set.range (σ a).base) (Set.range (σ b).base))
    (U : X.Opens)
    (hU : (U : Set ↥X) = (⋃ a : Fin m, Set.range (σ a).base)ᶜ)
    (hSh_loc : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilAltLocConstPresheaf X n))
    (hSh_zero : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilAltZeroBdrySubpresheaf X U n)) :
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod n))
    let K_U : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltZeroBdrySubpresheaf X U n, hSh_zero⟩
    let L_X : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilAltLocConstPresheaf X n, hSh_loc⟩
    let ι_U : Quiver.Hom K_U L_X :=
      CategoryTheory.ObjectProperty.homMk (weilAltZeroBdrySubpresheafι X U n)
    (∀ M : AddCommGrpCat.{u},
      CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology (weilPunctCurveSkyscraperPresheaf σ M)) ∧
    ∀ (hSh_sky : CategoryTheory.Presheaf.IsSheaf X.smallEtaleTopology
        (weilPunctCurveSkyscraperPresheaf σ AM)),
      let Q_AM : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
        ⟨weilPunctCurveSkyscraperPresheaf σ AM, hSh_sky⟩
      ∃ (ρ : Quiver.Hom L_X Q_AM)
        (h0 : CategoryTheory.CategoryStruct.comp ι_U ρ = 0),
        (CategoryTheory.ShortComplex.mk ι_U ρ h0).ShortExact :=
by
  classical
  intro AM K_U L_X ι_U
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hSub_k : Subsingleton ↥S_k := inferInstance
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget X
  let _instCompEt : CategoryTheory.MorphismProperty.IsStableUnderComposition
      (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hMemTop : ∀ (W : X.Etale) (R : CategoryTheory.Sieve W),
      R ∈ X.smallEtaleTopology W ↔
        ∀ (x : ↥W.left), ∃ (Y : X.Etale) (f : Y ⟶ W) (y : ↥Y.left),
          R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro W R
    change R ∈ (AlgebraicGeometry.Scheme.smallGrothendieckTopology (@AlgebraicGeometry.Etale) X) W ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) (S := X) le_rfl]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology W R
  have hOpenSec : ∀ (P : AlgebraicGeometry.Scheme.{u}) (p : Quiver.Hom P S_k),
      AlgebraicGeometry.Etale p →
      (∀ q : ↥P,
        IsOpen ({q} : Set ↥P) ∧
        ∃ s : Quiver.Hom S_k P,
          CategoryTheory.CategoryStruct.comp s p = CategoryTheory.CategoryStruct.id S_k ∧
          s.base pt_k = q) ∧
      (∀ s₁ s₂ : Quiver.Hom S_k P,
        CategoryTheory.CategoryStruct.comp s₁ p = CategoryTheory.CategoryStruct.id S_k →
        CategoryTheory.CategoryStruct.comp s₂ p = CategoryTheory.CategoryStruct.id S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂) := by
    intro P p hp
    have : AlgebraicGeometry.Etale p := hp
    refine ⟨?_, ?_⟩
    · intro q
      obtain ⟨V, hV, hqV, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := q) (U := (⊤ : P.Opens)) trivial
      let R : CommRingCat.{u} := P.presheaf.obj (Opposite.op V)
      let ι₀ : AlgebraicGeometry.Spec R ⟶ P := hV.fromSpec
      have hq_range : q ∈ Set.range ι₀.base := by
        rw [hV.range_fromSpec]
        exact hqV
      obtain ⟨q₀, hq₀⟩ := hq_range
      obtain ⟨𝔪₀, hmax₀, hle₀⟩ :=
        Ideal.exists_le_maximal (q₀ : PrimeSpectrum ↑R).asIdeal (q₀ : PrimeSpectrum ↑R).isPrime.ne_top
      let x₀ : ↥(AlgebraicGeometry.Spec R) := (⟨𝔪₀, hmax₀.isPrime⟩ : PrimeSpectrum ↑R)
      have hx₀_cl : x₀ ∈ closure ({q₀} : Set ↥(AlgebraicGeometry.Spec R)) :=
        (@PrimeSpectrum.le_iff_mem_closure ↑R _ (q₀ : PrimeSpectrum ↑R) (x₀ : PrimeSpectrum ↑R)).mp hle₀
      let p₀ : AlgebraicGeometry.Spec R ⟶ S_k := ι₀ ≫ p
      let φ_k : CommRingCat.of k ⟶ R := AlgebraicGeometry.Spec.preimage p₀
      have hmap_φ : AlgebraicGeometry.Spec.map φ_k = p₀ :=
        AlgebraicGeometry.Spec.map_preimage p₀
      have hp₀_ft : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_k) := by
        rw [hmap_φ]
        infer_instance
      have hφ_ft : RingHom.FiniteType φ_k.hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff
          (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hp₀_ft
      let _algR : Algebra k ↑R := φ_k.hom.toAlgebra
      have : Algebra.FiniteType k ↑R := hφ_ft
      obtain ⟨n_mv, q_mv, hq_surj⟩ :=
        Algebra.FiniteType.iff_quotient_mvPolynomial''.mp (inferInstance : Algebra.FiniteType k ↑R)
      let 𝔪_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_mv.toRingHom 𝔪₀
      have hmax_mv : 𝔪_mv.IsMaximal :=
        Ideal.comap_isMaximal_of_surjective q_mv.toRingHom hq_surj
      obtain ⟨a_pt, ha_pt⟩ := MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton.mp hmax_mv
      have hmem_mv : ∀ f : MvPolynomial (Fin n_mv) k,
          q_mv f ∈ 𝔪₀ ↔ MvPolynomial.aeval a_pt f = 0 := by
        intro f
        change f ∈ 𝔪_mv ↔ _
        rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      let σ_fn : ↑R → k := fun r => MvPolynomial.aeval a_pt (Function.surjInv hq_surj r)
      have hσ_q : ∀ f : MvPolynomial (Fin n_mv) k, σ_fn (q_mv f) = MvPolynomial.aeval a_pt f := by
        intro f
        dsimp [σ_fn]
        have hdiff : q_mv (Function.surjInv hq_surj (q_mv f) - f) ∈ 𝔪₀ := by
          rw [map_sub, Function.surjInv_eq hq_surj (q_mv f), sub_self]
          exact 𝔪₀.zero_mem
        have hev0 : MvPolynomial.aeval a_pt (Function.surjInv hq_surj (q_mv f) - f) = 0 :=
          (hmem_mv _).mp hdiff
        rwa [map_sub, sub_eq_zero] at hev0
      let σ_R : ↑R →+* k :=
        { toFun := σ_fn
          map_one' := by
            rw [← map_one q_mv, hσ_q, map_one]
          map_mul' := fun r₁ r₂ => by
            let f₁ := Function.surjInv hq_surj r₁
            let f₂ := Function.surjInv hq_surj r₂
            have hr₁ : q_mv f₁ = r₁ := Function.surjInv_eq hq_surj r₁
            have hr₂ : q_mv f₂ = r₂ := Function.surjInv_eq hq_surj r₂
            rw [← hr₁, ← hr₂, ← map_mul, hσ_q, hσ_q, hσ_q, map_mul]
          map_zero' := by
            rw [← map_zero q_mv, hσ_q, map_zero]
          map_add' := fun r₁ r₂ => by
            let f₁ := Function.surjInv hq_surj r₁
            let f₂ := Function.surjInv hq_surj r₂
            have hr₁ : q_mv f₁ = r₁ := Function.surjInv_eq hq_surj r₁
            have hr₂ : q_mv f₂ = r₂ := Function.surjInv_eq hq_surj r₂
            rw [← hr₁, ← hr₂, ← map_add, hσ_q, hσ_q, hσ_q, map_add] }
      have hσ_sec_ring : φ_k ≫ CommRingCat.ofHom σ_R = 𝟙 (CommRingCat.of k) := by
        apply CommRingCat.hom_ext
        ext c
        change σ_fn (algebraMap k ↑R c) = c
        have halg : algebraMap k ↑R c = q_mv (MvPolynomial.C c) := (q_mv.commutes c).symm
        rw [halg, hσ_q]
        exact (MvPolynomial.aeval a_pt).commutes c
      let s₀ : S_k ⟶ AlgebraicGeometry.Spec R :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_R)
      have hs₀_p₀ : s₀ ≫ p₀ = 𝟙 S_k := by
        dsimp [s₀]
        rw [← hmap_φ, ← AlgebraicGeometry.Spec.map_comp, hσ_sec_ring, AlgebraicGeometry.Spec.map_id]
