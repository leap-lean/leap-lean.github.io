    obtain ⟨e_α, he_α⟩ := he α
    let A : Type u := ↑(Y.presheaf.obj (Opposite.op (W α)))
    let P : Polynomial A := Polynomial.X ^ ℓ - Polynomial.C (u α).1
    let R : Type u := AdjoinRoot P
    let t : R := AdjoinRoot.root P
    let π_α : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R))
    have hMonic : P.Monic := Polynomial.monic_X_pow_sub_C (u α).1 hPrime.ne_zero
    let pb := AdjoinRoot.powerBasis' hMonic
    have hModFin : Module.Finite A R := Module.Finite.of_basis pb.basis
    have hRingFin : RingHom.Finite (algebraMap A R) :=
      RingHom.finite_algebraMap.mpr hModFin
    have hFin_πα : AlgebraicGeometry.IsFinite π_α :=
      (AlgebraicGeometry.IsFinite.SpecMap_iff (CommRingCat.ofHom (algebraMap A R))).mpr hRingFin
    let φ_B_A : B →+* A :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        f.appLE ⊤ (W α) (fun _ _ => trivial)).hom
    let φ_k_A : k →+* A := φ_B_A.comp (algebraMap k B)
    let ℓ_inv : A := φ_k_A ((ℓ : k)⁻¹)
    have hℓ_inv : (ℓ : A) * ℓ_inv = 1 := by
      have hcast : (ℓ : A) = φ_k_A (ℓ : k) := (map_natCast φ_k_A ℓ).symm
      rw [hcast, ← map_mul, mul_inv_cancel₀ hℓ, map_one]
    let p₁ : Polynomial A := Polynomial.C (ℓ_inv * ((u α)⁻¹).1) * Polynomial.X
    let p₂ : Polynomial A := Polynomial.C (-(((u α)⁻¹).1))
    have h_bezout : Polynomial.derivative P * p₁ + P * p₂ = (1 : Polynomial A) ^ 1 := by
      dsimp [P, p₁, p₂]
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero]
      have hexp : Polynomial.X ^ (ℓ - 1) * (Polynomial.X : Polynomial A) = Polynomial.X ^ ℓ := by
        rw [← pow_succ, Nat.sub_add_cancel hPrime.pos]
      have h1 : (ℓ : A) * (ℓ_inv * ((u α)⁻¹).1) = ((u α)⁻¹).1 := by
        rw [← mul_assoc, hℓ_inv, one_mul]
      have h2 : (u α).1 * (-(((u α)⁻¹).1)) = -1 := by
        rw [mul_neg, Units.mul_inv]
      calc
        (Polynomial.C (ℓ : A) * Polynomial.X ^ (ℓ - 1)) *
            (Polynomial.C (ℓ_inv * ((u α)⁻¹).1) * Polynomial.X) +
          (Polynomial.X ^ ℓ - Polynomial.C (u α).1) * Polynomial.C (-(((u α)⁻¹).1))
          = (Polynomial.C (ℓ : A) * Polynomial.C (ℓ_inv * ((u α)⁻¹).1)) *
              (Polynomial.X ^ (ℓ - 1) * Polynomial.X) +
            (Polynomial.X ^ ℓ * Polynomial.C (-(((u α)⁻¹).1)) -
              Polynomial.C (u α).1 * Polynomial.C (-(((u α)⁻¹).1))) := by ring
        _ = Polynomial.C ((ℓ : A) * (ℓ_inv * ((u α)⁻¹).1)) * Polynomial.X ^ ℓ +
            (Polynomial.X ^ ℓ * Polynomial.C (-(((u α)⁻¹).1)) -
              Polynomial.C ((u α).1 * (-(((u α)⁻¹).1)))) := by
            rw [← Polynomial.C_mul, ← Polynomial.C_mul, hexp]
        _ = (1 : Polynomial A) ^ 1 := by
            simp only [h1, h2, map_neg, map_one]
            ring
    let SP : StandardEtalePair A := StandardEtalePair.mk P hMonic 1 ⟨p₁, p₂, 1, h_bezout⟩
    have ht_eval : Polynomial.eval₂ (algebraMap A R) t P = 0 := AdjoinRoot.eval₂_root P
    have ht : SP.HasMap t := by
      refine ⟨?_, ?_⟩
      · change Polynomial.aeval t P = 0
        rw [Polynomial.aeval_def]
        exact ht_eval
      · change IsUnit (Polynomial.aeval t (1 : Polynomial A))
        rw [map_one]
        exact isUnit_one
    have hX_eval : Polynomial.eval₂ (algebraMap A SP.Ring) SP.X P = 0 := by
      have hX := SP.hasMap_X.1
      change Polynomial.aeval SP.X P = 0 at hX
      rwa [Polynomial.aeval_def] at hX
    let φ_bwd : R →ₐ[A] SP.Ring := AdjoinRoot.liftAlgHom P (Algebra.ofId A SP.Ring) SP.X hX_eval
    have h_fwd_bwd : (SP.lift t ht).comp φ_bwd = AlgHom.id A R := by
      apply AdjoinRoot.algHom_ext
      change (SP.lift t ht) (φ_bwd t) = t
      have hφt : φ_bwd t = SP.X := AdjoinRoot.liftAlgHom_root P (Algebra.ofId A SP.Ring) SP.X hX_eval
      rw [hφt, SP.lift_X]
    have h_bwd_fwd : φ_bwd.comp (SP.lift t ht) = AlgHom.id A SP.Ring := by
      apply SP.hom_ext_iff.mpr
      change φ_bwd ((SP.lift t ht) SP.X) = SP.X
      rw [SP.lift_X]
      exact AdjoinRoot.liftAlgHom_root P (Algebra.ofId A SP.Ring) SP.X hX_eval
    have hBij_lift : Function.Bijective (SP.lift t ht) :=
      ⟨Function.LeftInverse.injective (fun x => AlgHom.congr_fun h_bwd_fwd x),
       Function.RightInverse.surjective (fun x => AlgHom.congr_fun h_fwd_bwd x)⟩
    have : Algebra.IsStandardEtale A R :=
      Algebra.IsStandardEtale.mk ⟨StandardEtalePresentation.mk SP t ht hBij_lift⟩
    have hAlgEt : Algebra.Etale A R := inferInstance
    have hRingEt : RingHom.Etale (algebraMap A R) := RingHom.etale_algebraMap.mpr hAlgEt
    have hEt_πα : AlgebraicGeometry.Etale π_α :=
      (@AlgebraicGeometry.HasRingHomProperty.Spec_iff (@AlgebraicGeometry.Etale) _
        inferInstance _ _ (CommRingCat.ofHom (algebraMap A R))).mpr hRingEt
    have hInj_alg : Function.Injective (algebraMap A R) := by
      by_cases hNontriv : Nontrivial A
      · have : Nontrivial A := hNontriv
        have hdeg : P.natDegree = ℓ := Polynomial.natDegree_X_pow_sub_C (n := ℓ) (r := (u α).1)
        have hpos : 0 < pb.dim := by
          rw [AdjoinRoot.powerBasis'_dim, hdeg]
          exact hPrime.pos
        let i₀ : Fin pb.dim := ⟨0, hpos⟩
        have hb0 : pb.basis i₀ = 1 := by
          rw [PowerBasis.coe_basis]
          exact pow_zero _
        intro a₁ a₂ ha
        have hsub : (a₁ - a₂) • pb.basis i₀ = 0 := by
          rw [hb0, Algebra.smul_def, mul_one, map_sub, ha, sub_self]
        have h0 : a₁ - a₂ = 0 := by
          have hrepr := congrArg (fun x => pb.basis.repr x i₀) hsub
          rw [map_zero, Finsupp.zero_apply, map_smul, Finsupp.smul_apply,
            Module.Basis.repr_self, Finsupp.single_eq_same, smul_eq_mul, mul_one] at hrepr
          exact hrepr
        exact sub_eq_zero.mp h0
      · have : Subsingleton A := not_nontrivial_iff_subsingleton.mp hNontriv
        intro a₁ a₂ _
        exact Subsingleton.elim a₁ a₂
    have hSurj_comap : Function.Surjective (PrimeSpectrum.comap (algebraMap A R)) :=
      RingHom.IsIntegral.comap_surjective hRingFin.to_isIntegral hInj_alg
    have hSurj_πα : AlgebraicGeometry.Surjective π_α := by
      refine ⟨?_⟩
      intro p
      obtain ⟨q, hq⟩ := hSurj_comap p
      refine ⟨q, ?_⟩
      dsimp [π_α]
      rw [AlgebraicGeometry.Spec.map_base]
      exact hq
    have h_res_eq : (ν ∣_ W α) = e_α.hom ≫ π_α ≫ (hW_aff α).isoSpec.inv := by
      apply (cancel_mono (W α).ι).mp
      calc
        (ν ∣_ W α) ≫ (W α).ι
          = AlgebraicGeometry.Scheme.Opens.ι
              ((TopologicalSpace.Opens.map ν.base).obj (W α)) ≫ ν :=
              (AlgebraicGeometry.isPullback_morphismRestrict ν (W α)).w
        _ = e_α.hom ≫ π_α ≫ (hW_aff α).fromSpec := he_α.symm
        _ = e_α.hom ≫ π_α ≫ ((hW_aff α).isoSpec.inv ≫ (W α).ι) := by
              rw [(hW_aff α).isoSpec_inv_ι]
        _ = (e_α.hom ≫ π_α ≫ (hW_aff α).isoSpec.inv) ≫ (W α).ι := by
              simp only [Category.assoc]
    rw [h_res_eq]
    exact ⟨inferInstance, inferInstance, inferInstance⟩

  have hFin_ν : AlgebraicGeometry.IsFinite ν :=
    (@AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top (@AlgebraicGeometry.IsFinite)
      (@AlgebraicGeometry.HasAffineProperty.instIsZariskiLocalAtTarget (@AlgebraicGeometry.IsFinite) _
        AlgebraicGeometry.IsFinite.instHasAffinePropertyAndIsAffineFiniteCarrierObjOppositeOpensCarrierCarrierCommRingCatPresheafOpOpensTopHomAppTop)
      Z Y ν _ W hW_top).mpr (fun α => (hLocal α).1)
  have hEt_ν : AlgebraicGeometry.Etale ν :=
    (@AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top (@AlgebraicGeometry.Etale)
      (@AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtTarget (@AlgebraicGeometry.Etale) _
        inferInstance)
      Z Y ν _ W hW_top).mpr (fun α => (hLocal α).2.1)
  have hSurj_ν : AlgebraicGeometry.Surjective ν :=
    (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
      (P := @AlgebraicGeometry.Surjective) W hW_top (f := ν)).mpr (fun α => (hLocal α).2.2)

  have hx_roots : ∀ α : Fin N_cov,
      ∃ x_α : ↑(Z.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map ν.base).obj (W α)))),
        x_α ^ ℓ = (ν.app (W α)).hom (u α).1 := by
    intro α
    obtain ⟨e_α, he_α⟩ := he α
    let Z_α : Z.Opens := (TopologicalSpace.Opens.map ν.base).obj (W α)
    let A : Type u := ↑(Y.presheaf.obj (Opposite.op (W α)))
    let P : Polynomial A := Polynomial.X ^ ℓ - Polynomial.C (u α).1
    let R : Type u := AdjoinRoot P
    let t : R := AdjoinRoot.root P
    let π_α : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R))
    let x_α : ↑(Z.presheaf.obj (Opposite.op Z_α)) :=
      (AlgebraicGeometry.Scheme.Opens.topIso Z_α).hom.hom (e_α.hom.appTop.hom
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom t))
    refine ⟨x_α, ?_⟩
    have ht_pow : t ^ ℓ = algebraMap A R (u α).1 := by
      have hev := AdjoinRoot.eval₂_root P
      simp only [P, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, sub_eq_zero] at hev
      exact hev
    dsimp [x_α]
    rw [← map_pow, ← map_pow, ← map_pow, ht_pow]
    have h_nat1 :
        (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom (algebraMap A R (u α).1) =
        (π_α.appTop).hom
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (u α).1) := by
      have hn := AlgebraicGeometry.Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap A R))
      exact congrArg (fun φ => φ.hom (u α).1) hn
    rw [h_nat1]
    have htop_fromSpec :
        (TopologicalSpace.Opens.map (hW_aff α).fromSpec.base).obj (W α) = ⊤ := by
      ext pt
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      have hr : (hW_aff α).fromSpec.base pt ∈ Set.range (hW_aff α).fromSpec.base := ⟨pt, rfl⟩
      rwa [(hW_aff α).range_fromSpec] at hr
    have hle_π_from :
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) ≤
          (TopologicalSpace.Opens.map (π_α ≫ (hW_aff α).fromSpec).base).obj (W α) := by
      intro pt _
      have hr : (hW_aff α).fromSpec.base (π_α.base pt) ∈
          Set.range (hW_aff α).fromSpec.base := ⟨π_α.base pt, rfl⟩
      rwa [(hW_aff α).range_fromSpec] at hr
    have hle_π_pre :
        (⊤ : (AlgebraicGeometry.Spec (CommRingCat.of R)).Opens) ≤
          (TopologicalSpace.Opens.map π_α.base).obj
            ((TopologicalSpace.Opens.map (hW_aff α).fromSpec.base).obj (W α)) :=
      hle_π_from
    have h_fromSpec :
        (π_α.appTop).hom ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (u α).1) =
        ((π_α ≫ (hW_aff α).fromSpec).appLE (W α) ⊤ hle_π_from).hom (u α).1 := by
      have hcomp := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE π_α (hW_aff α).fromSpec
        (W α) ((TopologicalSpace.Opens.map (hW_aff α).fromSpec.base).obj (W α)) ⊤
        le_rfl hle_π_pre
      rw [← hcomp, ← AlgebraicGeometry.Scheme.Hom.app_eq_appLE (hW_aff α).fromSpec,
        (hW_aff α).fromSpec_app_self, Category.assoc]
      have hmap_app :
          (AlgebraicGeometry.Spec (Y.presheaf.obj (Opposite.op (W α)))).presheaf.map
            (CategoryTheory.eqToHom htop_fromSpec).op ≫
            π_α.appLE ((TopologicalSpace.Opens.map (hW_aff α).fromSpec.base).obj (W α)) ⊤
              hle_π_pre =
          π_α.appTop := by
        rw [AlgebraicGeometry.Scheme.Hom.map_appLE]
        rfl
      exact congrArg
        (fun φ => φ.hom ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (u α).1))
        hmap_app.symm
    rw [h_fromSpec]
    have hle_eα_lhs :
        (⊤ : (AlgebraicGeometry.Scheme.Opens.toScheme Z_α).Opens) ≤
          (TopologicalSpace.Opens.map
            (e_α.hom ≫ π_α ≫ (hW_aff α).fromSpec).base).obj (W α) :=
      fun pt _ => hle_π_from (by trivial : e_α.hom.base pt ∈ ⊤)
    have hle_Zα_rhs :
        (⊤ : (AlgebraicGeometry.Scheme.Opens.toScheme Z_α).Opens) ≤
          (TopologicalSpace.Opens.map
            (AlgebraicGeometry.Scheme.Opens.ι Z_α ≫ ν).base).obj (W α) :=
      fun pt _ => pt.2
    have h_eα_comp :
        e_α.hom.appTop.hom
          (((π_α ≫ (hW_aff α).fromSpec).appLE (W α) ⊤ hle_π_from).hom (u α).1) =
        ((e_α.hom ≫ π_α ≫ (hW_aff α).fromSpec).appLE (W α) ⊤ hle_eα_lhs).hom (u α).1 := by
      have happTop : e_α.hom.appTop =
          e_α.hom.appLE ⊤ ((TopologicalSpace.Opens.map e_α.hom.base).obj ⊤) le_rfl :=
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE e_α.hom
      have hc := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE e_α.hom (π_α ≫ (hW_aff α).fromSpec)
        (W α) ⊤ ((TopologicalSpace.Opens.map e_α.hom.base).obj ⊤) hle_π_from le_rfl
      rw [happTop]
      exact congrArg (fun φ => φ.hom (u α).1) hc
    rw [h_eα_comp]
    have happLE_congr :
        ∀ (f₁ f₂ : AlgebraicGeometry.Scheme.Opens.toScheme Z_α ⟶ Y) (_ : f₁ = f₂)
          (h₁ : (⊤ : (AlgebraicGeometry.Scheme.Opens.toScheme Z_α).Opens) ≤
            (TopologicalSpace.Opens.map f₁.base).obj (W α))
          (h₂ : (⊤ : (AlgebraicGeometry.Scheme.Opens.toScheme Z_α).Opens) ≤
            (TopologicalSpace.Opens.map f₂.base).obj (W α)),
          f₁.appLE (W α) ⊤ h₁ = f₂.appLE (W α) ⊤ h₂ := by
      intro _ _ hf _ _
      subst hf
      rfl
    rw [happLE_congr _ _ he_α hle_eα_lhs hle_Zα_rhs]
    have hle_ι_Zα :
        (⊤ : (AlgebraicGeometry.Scheme.Opens.toScheme Z_α).Opens) ≤
          (TopologicalSpace.Opens.map (AlgebraicGeometry.Scheme.Opens.ι Z_α).base).obj Z_α :=
      fun pt _ => pt.2
    have hc2 := AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE
      (AlgebraicGeometry.Scheme.Opens.ι Z_α) ν (W α) Z_α ⊤ le_rfl hle_ι_Zα
    rw [← hc2]
    change (AlgebraicGeometry.Scheme.Opens.topIso Z_α).hom.hom
      (((AlgebraicGeometry.Scheme.Opens.ι Z_α).appLE Z_α ⊤ hle_ι_Zα).hom
        ((ν.appLE (W α) Z_α le_rfl).hom (u α).1)) =
      (ν.app (W α)).hom (u α).1
    rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν]
    have h_top :
        (AlgebraicGeometry.Scheme.Opens.ι Z_α).appLE Z_α ⊤ hle_ι_Zα ≫
          (AlgebraicGeometry.Scheme.Opens.topIso Z_α).hom = 𝟙 _ := by
      have h1 := AlgebraicGeometry.Scheme.Opens.ι_appLE Z_α Z_α ⊤ hle_ι_Zα
      have h2 := AlgebraicGeometry.Scheme.Opens.topIso_hom Z_α
      refine (congrArg₂ CategoryTheory.CategoryStruct.comp h1 h2).trans ?_
      refine (Z.presheaf.map_comp _ _).symm.trans ?_
      refine (congrArg Z.presheaf.map (Subsingleton.elim _ (𝟙 (Opposite.op Z_α)))).trans ?_
      exact Z.presheaf.map_id (Opposite.op Z_α)
    exact congrArg (fun φ => φ.hom ((ν.app (W α)).hom (u α).1)) h_top

  
  
  
  let δ : ZMod ℓ → Quiver.Hom Z (CategoryTheory.Limits.pullback ν ν) :=
    fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z) (ρ a)
      ((CategoryTheory.Category.id_comp ν).trans (hρ_over a).symm)
  have h_geom_root : ∀ (ξ : k), ξ ^ ℓ = 1 →
      (ℓ : k)⁻¹ * (Finset.range ℓ).sum (fun r => ξ ^ r) = if ξ = 1 then 1 else 0 := by
    intro ξ hξ
    by_cases h1 : ξ = 1
    · subst h1
      simp only [↓reduceIte, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
        mul_one]
      exact inv_mul_cancel₀ hℓ
    · simp only [h1, ↓reduceIte]
      have hmul : ((Finset.range ℓ).sum (fun r => ξ ^ r)) * (ξ - 1) = 0 := by
        rw [geom_sum_mul, hξ, sub_self]
      have hsub : ξ - 1 ≠ 0 := sub_ne_zero.mpr h1
      have hsum0 : (Finset.range ℓ).sum (fun r => ξ ^ r) = 0 :=
        (mul_eq_zero.mp hmul).resolve_right hsub
      rw [hsum0, mul_zero]
  have h_orth1 : ∀ (a b : ZMod ℓ),
      (ℓ : k)⁻¹ * (Finset.range ℓ).sum (fun j => (ζ ^ b.val * (ζ ^ a.val)⁻¹) ^ j) =
      if a = b then 1 else 0 := by
    intro a b
    let ξ : k := ζ ^ b.val * (ζ ^ a.val)⁻¹
    have hξ_pow : ξ ^ ℓ = 1 := by
      dsimp [ξ]
      have h1 : (ζ ^ b.val) ^ ℓ = 1 := by rw [← pow_mul, mul_comm, pow_mul, hζ_pow, one_pow]
      have h2 : (ζ ^ a.val) ^ ℓ = 1 := by rw [← pow_mul, mul_comm, pow_mul, hζ_pow, one_pow]
      rw [mul_pow, inv_pow, h1, h2, inv_one, mul_one]
    rw [h_geom_root ξ hξ_pow]
    have hiff : (ξ = 1) ↔ (a = b) := by
      constructor
      · intro hξ1
        have hpow_eq : ζ ^ b.val = ζ ^ a.val := eq_of_mul_inv_eq_one hξ1
        have hb_mem : b.val ∈ (↑(Finset.range ℓ) : Set ℕ) :=
          Finset.mem_coe.mpr (Finset.mem_range.mpr (ZMod.val_lt b))
        have ha_mem : a.val ∈ (↑(Finset.range ℓ) : Set ℕ) :=
          Finset.mem_coe.mpr (Finset.mem_range.mpr (ZMod.val_lt a))
        have hinj := hζ.injOn_pow hb_mem ha_mem hpow_eq
        exact (ZMod.val_injective ℓ hinj).symm
      · rintro rfl
        exact mul_inv_cancel₀ (pow_ne_zero a.val hζ_ne)
    split_ifs with h1 hab hab
    · rfl
    · exact absurd (hiff.mp h1) hab
    · exact absurd (hiff.mpr hab) h1
    · rfl
  have h_sum_zmod : ∀ (g_fn : ℕ → k),
      (Finset.univ : Finset (ZMod ℓ)).sum (fun a => g_fn a.val) =
      (Finset.range ℓ).sum g_fn := by
    intro g_fn
    refine Finset.sum_bij (fun (a : ZMod ℓ) _ => a.val) ?_ ?_ ?_ ?_
    · intro a _
      exact Finset.mem_range.mpr (ZMod.val_lt a)
    · intro a₁ _ a₂ _ hval
      exact ZMod.val_injective ℓ hval
    · intro r hr
      refine ⟨(r : ZMod ℓ), Finset.mem_univ _, ?_⟩
      rw [ZMod.val_natCast, Nat.mod_eq_of_lt (Finset.mem_range.mp hr)]
    · intro a _
      rfl
  have h_orth2 : ∀ {j m : ℕ}, j < ℓ → m < ℓ →
      (ℓ : k)⁻¹ * (Finset.univ : Finset (ZMod ℓ)).sum
        (fun a => (ζ ^ m * (ζ ^ j)⁻¹) ^ a.val) =
      if j = m then 1 else 0 := by
    intro j m hj hm
    rw [h_sum_zmod]
    let ξ : k := ζ ^ m * (ζ ^ j)⁻¹
    have hξ_pow : ξ ^ ℓ = 1 := by
      dsimp [ξ]
      have h1 : (ζ ^ m) ^ ℓ = 1 := by rw [← pow_mul, mul_comm, pow_mul, hζ_pow, one_pow]
      have h2 : (ζ ^ j) ^ ℓ = 1 := by rw [← pow_mul, mul_comm, pow_mul, hζ_pow, one_pow]
      rw [mul_pow, inv_pow, h1, h2, inv_one, mul_one]
    rw [h_geom_root ξ hξ_pow]
    have hiff : (ξ = 1) ↔ (j = m) := by
      constructor
      · intro hξ1
        have hpow_eq : ζ ^ m = ζ ^ j := eq_of_mul_inv_eq_one hξ1
        have hm_mem : m ∈ (↑(Finset.range ℓ) : Set ℕ) :=
          Finset.mem_coe.mpr (Finset.mem_range.mpr hm)
        have hj_mem : j ∈ (↑(Finset.range ℓ) : Set ℕ) :=
          Finset.mem_coe.mpr (Finset.mem_range.mpr hj)
        exact (hζ.injOn_pow hm_mem hj_mem hpow_eq).symm
      · rintro rfl
        exact mul_inv_cancel₀ (pow_ne_zero j hζ_ne)
    split_ifs with h1 hjm hjm
    · rfl
    · exact absurd (hiff.mp h1) hjm
    · exact absurd (hiff.mpr hjm) h1
    · rfl

  have hChart : ∀ α : Fin N_cov,
      ∃ (Q_α : AlgebraicGeometry.Scheme.{u})
        (ι_pb : Q_α ⟶ CategoryTheory.Limits.pullback ν ν),
        Function.Injective ι_pb.base ∧
        (∀ z : ↥(CategoryTheory.Limits.pullback ν ν),
          ν.base ((CategoryTheory.Limits.pullback.fst ν ν).base z) ∈ W α →
          z ∈ Set.range ι_pb.base) ∧
        ∃ δ_loc : ZMod ℓ → (Q_α → Prop),
          (_root_.Pairwise fun a b : ZMod ℓ =>
            ∀ q : ↥Q_α, ¬ (δ_loc a q ∧ δ_loc b q)) ∧
          (∀ q : ↥Q_α, ∃ a : ZMod ℓ, δ_loc a q) ∧
          (∀ (a : ZMod ℓ) (q : ↥Q_α),
            ι_pb.base q ∈ Set.range (δ a).base ↔ δ_loc a q) := by
    intro α
    obtain ⟨e_α, he_over, he_ρ⟩ := he_equiv α
    let Z_α : Z.Opens := (TopologicalSpace.Opens.map ν.base).obj (W α)
    let A : Type u := ↑(Y.presheaf.obj (Opposite.op (W α)))
    let P : Polynomial A := Polynomial.X ^ ℓ - Polynomial.C (u α).1
    let R : Type u := AdjoinRoot P
    let t : R := AdjoinRoot.root P
    have ht_pow : t ^ ℓ = algebraMap A R (u α).1 := by
      have hev := AdjoinRoot.eval₂_root P
      simp only [P, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, sub_eq_zero] at hev
      exact hev
    let t_inv : R := algebraMap A R (((u α)⁻¹).1) * t ^ (ℓ - 1)
    have ht_mul_inv : t * t_inv = 1 := by
      dsimp [t_inv]
      calc
        t * (algebraMap A R (((u α)⁻¹).1) * t ^ (ℓ - 1))
          = algebraMap A R (((u α)⁻¹).1) * (t ^ (ℓ - 1) * t) := by ring
        _ = algebraMap A R (((u α)⁻¹).1) * t ^ ℓ := by
            rw [← pow_succ, Nat.sub_add_cancel hPrime.pos]
        _ = algebraMap A R ((((u α)⁻¹).1) * (u α).1) := by rw [ht_pow, map_mul]
        _ = 1 := by rw [Units.inv_mul, map_one]
    have ht_inv_mul : t_inv * t = 1 := by rw [mul_comm, ht_mul_inv]
    let φ_B_A : B →+* A :=
      ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
        f.appLE ⊤ (W α) (fun _ _ => trivial)).hom
    let φ_k_A : k →+* A := φ_B_A.comp (algebraMap k B)
    let φ_k_R : k →+* R := (algebraMap A R).comp φ_k_A
    have hσ_eval : ∀ a : ZMod ℓ,
        Polynomial.eval₂ (algebraMap A R) (φ_k_R (ζ ^ a.val) * t) P = 0 := by
      intro a
      have hpow1 : (φ_k_R (ζ ^ a.val)) ^ ℓ = 1 := by
        rw [← map_pow, ← pow_mul, mul_comm a.val ℓ, pow_mul, hζ_pow, one_pow, map_one]
      simp only [P, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, mul_pow, hpow1, one_mul, ht_pow, sub_self]
    let σ_α : ZMod ℓ → (R →ₐ[A] R) :=
      fun a => AdjoinRoot.liftAlgHom P (Algebra.ofId A R) (φ_k_R (ζ ^ a.val) * t) (hσ_eval a)
    have hσ_root : ∀ a : ZMod ℓ, σ_α a t = φ_k_R (ζ ^ a.val) * t :=
      fun a => AdjoinRoot.liftAlgHom_root P (Algebra.ofId A R) _ (hσ_eval a)
    let Θ_a : ZMod ℓ → (TensorProduct A R R →ₐ[A] R) :=
      fun a => Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α a)
    let Θ_α : TensorProduct A R R →+* (ZMod ℓ → R) :=
      RingHom.pi (fun a => (Θ_a a).toRingHom)
    let φ_k_T : k →+* TensorProduct A R R :=
      Algebra.TensorProduct.includeLeftRingHom.comp φ_k_R
    let T₁ : TensorProduct A R R := TensorProduct.tmul A t (1 : R)
    let T₁_inv : TensorProduct A R R := TensorProduct.tmul A t_inv (1 : R)
    let T₂ : TensorProduct A R R := TensorProduct.tmul A (1 : R) t
    have hT₁_mul : T₁ * T₁_inv = 1 := by
      dsimp [T₁, T₁_inv]
      rw [ht_mul_inv, mul_one]
      rfl
    let E_a : ZMod ℓ → TensorProduct A R R :=
      fun a => φ_k_T ((ℓ : k)⁻¹) *
        (Finset.range ℓ).sum (fun j => (φ_k_T ((ζ ^ a.val)⁻¹) * (T₁_inv * T₂)) ^ j)
    let Θ_inv : (ZMod ℓ → R) → TensorProduct A R R :=
      fun h => (Finset.univ : Finset (ZMod ℓ)).sum
        (fun a => TensorProduct.tmul A (h a) (1 : R) * E_a a)
    have hΘ_T_rat : ∀ b : ZMod ℓ, Θ_a b (T₁_inv * T₂) = φ_k_R (ζ ^ b.val) := by
      intro b
      rw [map_mul]
      have h1 : Θ_a b T₁_inv = t_inv := by
        change Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α b)
          (TensorProduct.tmul A t_inv 1) = t_inv
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        rfl
      have h2 : Θ_a b T₂ = φ_k_R (ζ ^ b.val) * t := by
        change Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α b)
          (TensorProduct.tmul A 1 t) = _
        rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, one_mul, hσ_root]
      rw [h1, h2]
      calc
        t_inv * (φ_k_R (ζ ^ b.val) * t) = φ_k_R (ζ ^ b.val) * (t_inv * t) := by ring
        _ = φ_k_R (ζ ^ b.val) := by rw [ht_inv_mul, mul_one]
    have hΘ_k : ∀ (b : ZMod ℓ) (c : k), Θ_a b (φ_k_T c) = φ_k_R c := by
      intro b c
      change Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α b)
        (TensorProduct.tmul A (φ_k_R c) 1) = φ_k_R c
      rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
      rfl
    have hΘ_Ea : ∀ a b : ZMod ℓ, Θ_a b (E_a a) = if a = b then 1 else 0 := by
      intro a b
      dsimp [E_a]
      rw [map_mul, map_sum, hΘ_k]
      have hsum_eq :
          (Finset.range ℓ).sum
            (fun j => Θ_a b ((φ_k_T ((ζ ^ a.val)⁻¹) * (T₁_inv * T₂)) ^ j)) =
          φ_k_R ((Finset.range ℓ).sum (fun j => (ζ ^ b.val * (ζ ^ a.val)⁻¹) ^ j)) := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [map_pow, map_mul, hΘ_k, hΘ_T_rat, ← map_mul, ← map_pow, mul_comm]
      rw [hsum_eq, ← map_mul, h_orth1 a b]
      split_ifs <;> simp
    have h_right_inv : Function.RightInverse Θ_inv Θ_α := by
      intro h
      funext b
      change Θ_a b (Θ_inv h) = h b
      dsimp [Θ_inv]
      rw [map_sum]
      have hterm : ∀ a : ZMod ℓ,
          Θ_a b (TensorProduct.tmul A (h a) (1 : R) * E_a a) =
          if a = b then h b else 0 := by
        intro a
        rw [map_mul, hΘ_Ea a b]
        have hl : Θ_a b (TensorProduct.tmul A (h a) (1 : R)) = h a := by
          change Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α b)
            (TensorProduct.tmul A (h a) 1) = h a
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
          rfl
        rw [hl]
        split_ifs with hab
        · subst hab; exact mul_one _
        · exact mul_zero _
      simp_rw [hterm]
      simp
    have h_monom : ∀ (n : ℕ) (r₁ : R),
        Θ_inv (Θ_α (TensorProduct.tmul A r₁ (t ^ n))) = TensorProduct.tmul A r₁ (t ^ n) := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro r₁
        by_cases hlt : n < ℓ
        · have hΘ_val : ∀ a : ZMod ℓ,
              TensorProduct.tmul A (Θ_α (TensorProduct.tmul A r₁ (t ^ n)) a) (1 : R) =
              (TensorProduct.tmul A r₁ (1 : R) * T₁ ^ n) * φ_k_T ((ζ ^ n) ^ a.val) := by
            intro a
            have ha_ev : Θ_α (TensorProduct.tmul A r₁ (t ^ n)) a =
                (r₁ * t ^ n) * φ_k_R ((ζ ^ n) ^ a.val) := by
              change Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α a)
                (TensorProduct.tmul A r₁ (t ^ n)) = _
              rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, map_pow,
                hσ_root, mul_pow, ← map_pow, ← pow_mul, mul_comm a.val n, pow_mul]
              ring
            rw [ha_ev]
            have hT₁_pow : T₁ ^ n = TensorProduct.tmul A (t ^ n) (1 : R) := by
              dsimp [T₁]
              rw [Algebra.TensorProduct.tmul_pow, one_pow]
            rw [hT₁_pow]
            change TensorProduct.tmul A ((r₁ * t ^ n) * φ_k_R ((ζ ^ n) ^ a.val)) (1 : R) =
              (TensorProduct.tmul A r₁ (1 : R) * TensorProduct.tmul A (t ^ n) (1 : R)) *
                TensorProduct.tmul A (φ_k_R ((ζ ^ n) ^ a.val)) (1 : R)
            simp only [Algebra.TensorProduct.tmul_mul_tmul, mul_one]
          dsimp [Θ_inv]
          have hsum1 :
              (Finset.univ : Finset (ZMod ℓ)).sum
                (fun a => TensorProduct.tmul A (Θ_α (TensorProduct.tmul A r₁ (t ^ n)) a) (1 : R) *
                  E_a a) =
              (TensorProduct.tmul A r₁ (1 : R) * T₁ ^ n) *
                (Finset.univ : Finset (ZMod ℓ)).sum
                  (fun a => φ_k_T ((ζ ^ n) ^ a.val) * E_a a) := by
            rw [Finset.mul_sum]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [hΘ_val a, mul_assoc]
          rw [hsum1]
          have hsum_E :
              (Finset.univ : Finset (ZMod ℓ)).sum
                (fun a => φ_k_T ((ζ ^ n) ^ a.val) * E_a a) =
              (T₁_inv * T₂) ^ n := by
            have hexp_a :
                (Finset.univ : Finset (ZMod ℓ)).sum
                  (fun a => φ_k_T ((ζ ^ n) ^ a.val) * E_a a) =
                (Finset.range ℓ).sum (fun j =>
                  (φ_k_T ((ℓ : k)⁻¹ * (Finset.univ : Finset (ZMod ℓ)).sum
                    (fun a => (ζ ^ n * (ζ ^ j)⁻¹) ^ a.val))) *
                    (T₁_inv * T₂) ^ j) := by
              have hlhs :
                  (Finset.univ : Finset (ZMod ℓ)).sum
                    (fun a => φ_k_T ((ζ ^ n) ^ a.val) * E_a a) =
                  (Finset.univ : Finset (ZMod ℓ)).sum (fun a =>
                    (Finset.range ℓ).sum (fun j =>
                      (φ_k_T ((ℓ : k)⁻¹) *
                        (φ_k_T ((ζ ^ n) ^ a.val) * (φ_k_T ((ζ ^ a.val)⁻¹)) ^ j)) *
                        (T₁_inv * T₂) ^ j)) := by
                refine Finset.sum_congr rfl fun a _ => ?_
                dsimp [E_a]
                rw [← mul_assoc, mul_comm (φ_k_T ((ζ ^ n) ^ a.val)) (φ_k_T ((ℓ : k)⁻¹)),
                  mul_assoc, Finset.mul_sum, Finset.mul_sum]
                refine Finset.sum_congr rfl fun j _ => ?_
                rw [mul_pow]
                ring
              rw [hlhs, Finset.sum_comm]
              refine Finset.sum_congr rfl fun j _ => ?_
              rw [← Finset.sum_mul, map_mul, map_sum, Finset.mul_sum]
              congr 1
              refine Finset.sum_congr rfl fun a _ => ?_
              congr 1
              rw [← map_pow, ← map_mul, mul_pow, inv_pow]
              congr 2
              rw [← pow_mul, mul_comm a.val j, pow_mul, inv_pow]
            rw [hexp_a]
            have hcollapse :
                (Finset.range ℓ).sum (fun j =>
                  (φ_k_T ((ℓ : k)⁻¹ * (Finset.univ : Finset (ZMod ℓ)).sum
                    (fun a => (ζ ^ n * (ζ ^ j)⁻¹) ^ a.val))) *
                    (T₁_inv * T₂) ^ j) =
                (Finset.range ℓ).sum (fun j =>
                  if j = n then (T₁_inv * T₂) ^ j else 0) := by
              refine Finset.sum_congr rfl fun j hj => ?_
              rw [h_orth2 (Finset.mem_range.mp hj) hlt]
              split_ifs <;> simp
            rw [hcollapse, Finset.sum_ite_eq' (Finset.range ℓ) n]
            simp [Finset.mem_range.mpr hlt]
          rw [hsum_E]
          have hT_cancel : T₁ ^ n * (T₁_inv * T₂) ^ n = T₂ ^ n := by
            rw [mul_pow, ← mul_assoc, ← mul_pow, hT₁_mul, one_pow, one_mul]
          rw [mul_assoc, hT_cancel]
          have hT₂_pow : T₂ ^ n = TensorProduct.tmul A (1 : R) (t ^ n) := by
            dsimp [T₂]
            rw [Algebra.TensorProduct.tmul_pow, one_pow]
          rw [hT₂_pow, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        · have hle : ℓ ≤ n := le_of_not_gt hlt
          have hsub_lt : n - ℓ < n := Nat.sub_lt (lt_of_lt_of_le hPrime.pos hle) hPrime.pos
          have htn : t ^ n = (u α).1 • t ^ (n - ℓ) := by
            have hn_eq : n = (n - ℓ) + ℓ := (Nat.sub_add_cancel hle).symm
            conv_lhs => rw [hn_eq, pow_add, ht_pow, mul_comm, ← Algebra.smul_def]
          have htmul : TensorProduct.tmul A r₁ (t ^ n) =
              TensorProduct.tmul A ((u α).1 • r₁) (t ^ (n - ℓ)) := by
            rw [htn, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
          rw [htmul]
          exact ih (n - ℓ) hsub_lt ((u α).1 • r₁)
    have hΘ_inv_zero : Θ_inv 0 = 0 := by
      dsimp [Θ_inv]
      refine Finset.sum_eq_zero fun a _ => ?_
      change TensorProduct.tmul A (0 : R) (1 : R) * E_a a = 0
      rw [TensorProduct.zero_tmul, zero_mul]
    have hΘ_inv_add : ∀ h₁ h₂ : ZMod ℓ → R, Θ_inv (h₁ + h₂) = Θ_inv h₁ + Θ_inv h₂ := by
      intro h₁ h₂
      dsimp [Θ_inv]
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [TensorProduct.add_tmul, add_mul]
    have h_left_inv : Function.LeftInverse Θ_inv Θ_α := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => rw [map_zero, hΘ_inv_zero]
      | add x y ihx ihy => rw [map_add, hΘ_inv_add, ihx, ihy]
      | tmul r₁ r₂ =>
        induction r₂ using AdjoinRoot.induction_on with
        | ih p =>
          induction p using Polynomial.induction_on' with
          | add p₁ p₂ ih₁ ih₂ =>
            rw [map_add, TensorProduct.tmul_add, map_add, hΘ_inv_add, ih₁, ih₂]
          | monomial n c =>
            have hmk : AdjoinRoot.mk P (Polynomial.monomial n c) = c • t ^ n := by
              rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, AdjoinRoot.mk_C, map_pow,
                AdjoinRoot.mk_X, Algebra.smul_def]
              rfl
            have htm : TensorProduct.tmul A r₁ (AdjoinRoot.mk P (Polynomial.monomial n c)) =
                TensorProduct.tmul A (c • r₁) (t ^ n) := by
              rw [hmk, TensorProduct.tmul_smul, TensorProduct.smul_tmul']
            rw [htm]
            exact h_monom n (c • r₁)
    let e_CRT : TensorProduct A R R ≃+* (ZMod ℓ → R) :=
      RingEquiv.ofBijective Θ_α ⟨h_left_inv.injective, h_right_inv.surjective⟩
    let ev_a : ZMod ℓ → ((ZMod ℓ → R) →+* R) := fun a => Pi.evalRingHom (fun _ => R) a
    let ind_a : ZMod ℓ → (ZMod ℓ → R) := fun a b => if b = a then 1 else 0
    have h_spec_disj : _root_.Pairwise fun a b : ZMod ℓ =>
        ∀ p₁ p₂ : PrimeSpectrum R,
          PrimeSpectrum.comap (ev_a a) p₁ ≠ PrimeSpectrum.comap (ev_a b) p₂ := by
      intro a b hab p₁ p₂ heq
      have hmem : ind_a a ∈ (PrimeSpectrum.comap (ev_a a) p₁).asIdeal ↔
          ind_a a ∈ (PrimeSpectrum.comap (ev_a b) p₂).asIdeal := by
        rw [heq]
      change ev_a a (ind_a a) ∈ p₁.asIdeal ↔ ev_a b (ind_a a) ∈ p₂.asIdeal at hmem
      have ha1 : ev_a a (ind_a a) = 1 := if_pos rfl
      have hb0 : ev_a b (ind_a a) = 0 := if_neg hab.symm
      rw [ha1, hb0] at hmem
      exact p₁.isPrime.ne_top
        ((Ideal.eq_top_iff_one p₁.asIdeal).mpr (hmem.mpr p₂.asIdeal.zero_mem))
    have h_spec_cov : ∀ q : PrimeSpectrum (ZMod ℓ → R),
        ∃ (a : ZMod ℓ) (p : PrimeSpectrum R), PrimeSpectrum.comap (ev_a a) p = q := by
      intro q
      have hsum_one : (Finset.univ : Finset (ZMod ℓ)).sum ind_a = 1 := by
        funext b
        rw [Finset.sum_apply]
        dsimp [ind_a]
        simp
      have hex_a : ∃ a : ZMod ℓ, ind_a a ∉ q.asIdeal := by
        by_contra hall
        have hall' : ∀ a : ZMod ℓ, ind_a a ∈ q.asIdeal := fun a => by
          by_contra hna; exact hall ⟨a, hna⟩
        have hone : (1 : ZMod ℓ → R) ∈ q.asIdeal := by
          rw [← hsum_one]
          exact Ideal.sum_mem q.asIdeal (fun a _ => hall' a)
        exact q.isPrime.ne_top ((Ideal.eq_top_iff_one q.asIdeal).mpr hone)
      obtain ⟨a, ha_not⟩ := hex_a
      let diag : R →+* (ZMod ℓ → R) := RingHom.pi (fun _ => RingHom.id R)
      let p : PrimeSpectrum R := PrimeSpectrum.comap diag q
      refine ⟨a, p, ?_⟩
      ext h
      change diag (h a) ∈ q.asIdeal ↔ h ∈ q.asIdeal
      have hprod0 : (h - diag (h a)) * ind_a a = 0 := by
        funext c
        change (h c - h a) * (if c = a then 1 else 0) = 0
        split_ifs with hca
        · rw [hca, sub_self, mul_one]
        · rw [mul_zero]
      have hzero_mem : (h - diag (h a)) * ind_a a ∈ q.asIdeal := by
        rw [hprod0]
        exact q.asIdeal.zero_mem
      have hdiff_mem : h - diag (h a) ∈ q.asIdeal :=
        (q.isPrime.mem_or_mem hzero_mem).resolve_right ha_not
      constructor
      · intro hdiag
        have hsum := q.asIdeal.add_mem hdiff_mem hdiag
        rwa [sub_add_cancel] at hsum
      · intro hh
        have hsub := q.asIdeal.sub_mem hh hdiff_mem
        rwa [sub_sub_cancel] at hsub
    let π_α : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of A) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A R))
    let j_α : AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Z :=
      e_α.inv ≫ AlgebraicGeometry.Scheme.Opens.ι Z_α
    have : AlgebraicGeometry.IsOpenImmersion j_α := inferInstance
    have hj_ν : j_α ≫ ν = π_α ≫ (hW_aff α).fromSpec := by
      dsimp [j_α, Z_α]
      rw [Category.assoc, ← he_over, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
    have hj_ρ : ∀ a : ZMod ℓ,
        j_α ≫ ρ a =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_α a).toRingHom) ≫ j_α := by
      intro a
      have hcomm_A : ∀ r : A, (σ_α a).toRingHom (algebraMap A R r) = algebraMap A R r :=
        fun r => (σ_α a).commutes r
      have hroot_A : (σ_α a).toRingHom t =
          algebraMap A R (φ_B_A (ζ_B ^ a.val)) * t := by
        change σ_α a t = _
        rw [hσ_root a]
        congr 1
        dsimp [φ_k_R, φ_k_A, ζ_B]
        rw [map_pow]
      have heq := he_ρ a (σ_α a).toRingHom hcomm_A hroot_A
      dsimp [j_α, Z_α]
      rw [Category.assoc, heq]
      simp only [← Category.assoc, Iso.inv_hom_id, Category.id_comp]
      rfl
    let Q_α := CategoryTheory.Limits.pullback π_α π_α
    let ι_pb : Q_α ⟶ CategoryTheory.Limits.pullback ν ν :=
      CategoryTheory.Limits.pullback.map π_α π_α ν ν j_α j_α (hW_aff α).fromSpec
        hj_ν.symm hj_ν.symm
    have hPb_ι : CategoryTheory.IsPullback ι_pb
        (CategoryTheory.Limits.pullback.fst π_α π_α)
        (CategoryTheory.Limits.pullback.fst ν ν) j_α := by
      refine CategoryTheory.IsPullback.mk ⟨CategoryTheory.Limits.pullback.lift_fst _ _ _⟩ ⟨?_⟩
      have hs_range : ∀ s : CategoryTheory.Limits.PullbackCone
          (CategoryTheory.Limits.pullback.fst ν ν) j_α,
          Set.range (s.fst ≫ CategoryTheory.Limits.pullback.snd ν ν).base ⊆
            Set.range j_α.base := by
        intro s
        rintro _ ⟨pt, rfl⟩
        have hZα_range : Set.range j_α.base = (Z_α : Set ↥Z) := by
          have hsurj_inv : Function.Surjective e_α.inv.base :=
            (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e_α.symm)).surjective
          have hcomp_fn : ⇑j_α.base =
              ⇑(AlgebraicGeometry.Scheme.Opens.ι Z_α).base ∘ ⇑e_α.inv.base := rfl
          rw [hcomp_fn, Set.range_comp, hsurj_inv.range_eq, Set.image_univ,
            AlgebraicGeometry.Scheme.Opens.range_ι]
        rw [hZα_range]
        change ν.base ((s.fst ≫ CategoryTheory.Limits.pullback.snd ν ν).base pt) ∈ W α
        have hcond : (s.fst ≫ CategoryTheory.Limits.pullback.snd ν ν) ≫ ν =
            (s.snd ≫ π_α) ≫ (hW_aff α).fromSpec := by
          rw [Category.assoc, ← CategoryTheory.Limits.pullback.condition, ← Category.assoc,
            s.condition, Category.assoc, hj_ν, Category.assoc]
        change ((s.fst ≫ CategoryTheory.Limits.pullback.snd ν ν) ≫ ν).base pt ∈ W α
        rw [hcond]
        have hr : ((s.snd ≫ π_α) ≫ (hW_aff α).fromSpec).base pt ∈
            Set.range (hW_aff α).fromSpec.base :=
          ⟨(s.snd ≫ π_α).base pt, rfl⟩
        rwa [(hW_aff α).range_fromSpec] at hr
      have hb₁₂ : ∀ s : CategoryTheory.Limits.PullbackCone
          (CategoryTheory.Limits.pullback.fst ν ν) j_α,
          s.snd ≫ π_α =
            AlgebraicGeometry.IsOpenImmersion.lift j_α
              (s.fst ≫ CategoryTheory.Limits.pullback.snd ν ν) (hs_range s) ≫ π_α := by
        intro s
        apply (cancel_mono (hW_aff α).fromSpec).mp
        rw [Category.assoc, Category.assoc, ← hj_ν, ← Category.assoc, ← s.condition,
          ← Category.assoc, AlgebraicGeometry.IsOpenImmersion.lift_fac,
          Category.assoc, Category.assoc, CategoryTheory.Limits.pullback.condition]
      refine CategoryTheory.Limits.PullbackCone.IsLimit.mk _
        (fun s => CategoryTheory.Limits.pullback.lift s.snd
          (AlgebraicGeometry.IsOpenImmersion.lift j_α
            (s.fst ≫ CategoryTheory.Limits.pullback.snd ν ν) (hs_range s)) (hb₁₂ s))
        (fun s => ?_) (fun s => ?_) (fun s m hm₁ hm₂ => ?_)
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst, ← Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, s.condition]
        · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd, ← Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd]
          exact AlgebraicGeometry.IsOpenImmersion.lift_fac j_α _ (hs_range s)
      · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      · apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Limits.pullback.lift_fst]
          exact hm₂
        · rw [CategoryTheory.Limits.pullback.lift_snd]
          apply (cancel_mono j_α).mp
          rw [AlgebraicGeometry.IsOpenImmersion.lift_fac j_α _ (hs_range s)]
          calc
            (m ≫ CategoryTheory.Limits.pullback.snd π_α π_α) ≫ j_α
              = m ≫ (ι_pb ≫ CategoryTheory.Limits.pullback.snd ν ν) := by
                  rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd]
            _ = s.fst ≫ CategoryTheory.Limits.pullback.snd ν ν := by
                  rw [← Category.assoc, hm₁]
    have hOpen_ι : AlgebraicGeometry.IsOpenImmersion ι_pb :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ι.flip
        inferInstance
    have hInj_ι : Function.Injective ι_pb.base := hOpen_ι.base_open.injective
    have hRange_ι : ∀ z : ↥(CategoryTheory.Limits.pullback ν ν),
        ν.base ((CategoryTheory.Limits.pullback.fst ν ν).base z) ∈ W α →
        z ∈ Set.range ι_pb.base := by
      intro z hz
      have hz_Zα : (CategoryTheory.Limits.pullback.fst ν ν).base z ∈ Set.range j_α.base := by
        have hsurj_inv : Function.Surjective e_α.inv.base :=
          (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e_α.symm)).surjective
        obtain ⟨pt_spec, hpt⟩ := hsurj_inv ⟨(CategoryTheory.Limits.pullback.fst ν ν).base z, hz⟩
        refine ⟨pt_spec, ?_⟩
        change (AlgebraicGeometry.Scheme.Opens.ι Z_α).base (e_α.inv.base pt_spec) = _
        rw [hpt]
        rfl
      obtain ⟨w, hw⟩ := hz_Zα
      obtain ⟨p_pb, hp₁, _⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := CategoryTheory.Limits.pullback.fst ν ν) (g := j_α) z w hw.symm
      let e_pb_open := hPb_ι.isoPullback
      refine ⟨e_pb_open.inv.base p_pb, ?_⟩
      have h_fst_eq : e_pb_open.inv ≫ ι_pb =
          CategoryTheory.Limits.pullback.fst (CategoryTheory.Limits.pullback.fst ν ν) j_α := by
        rw [← hPb_ι.isoPullback_hom_fst, ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
      change (e_pb_open.inv ≫ ι_pb).base p_pb = z
      rw [h_fst_eq]
      exact hp₁
    have hδ_α_cond : ∀ a : ZMod ℓ,
        𝟙 (AlgebraicGeometry.Spec (CommRingCat.of R)) ≫ π_α =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_α a).toRingHom) ≫ π_α := by
      intro a
      rw [Category.id_comp]
      dsimp [π_α]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      exact ((σ_α a).commutes r).symm
    let δ_α : ZMod ℓ → (AlgebraicGeometry.Spec (CommRingCat.of R) ⟶ Q_α) :=
      fun a => CategoryTheory.Limits.pullback.lift
        (𝟙 _) (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (σ_α a).toRingHom)) (hδ_α_cond a)
    have hδ_compat : ∀ a : ZMod ℓ, δ_α a ≫ ι_pb = j_α ≫ δ a := by
      intro a
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          ← Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.id_comp,
          Category.assoc, CategoryTheory.Limits.pullback.lift_fst, Category.comp_id]
      · rw [Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          Category.assoc, CategoryTheory.Limits.pullback.lift_snd, hj_ρ a]
    have hδ_iff : ∀ (a : ZMod ℓ) (q : ↥Q_α),
        ι_pb.base q ∈ Set.range (δ a).base ↔ q ∈ Set.range (δ_α a).base := by
      intro a q
      constructor
      · rintro ⟨z₀, hz₀⟩
        have hz₀_eq : z₀ = j_α.base ((CategoryTheory.Limits.pullback.fst π_α π_α).base q) := by
          have h1 : (CategoryTheory.Limits.pullback.fst ν ν).base (ι_pb.base q) =
              (CategoryTheory.Limits.pullback.fst ν ν).base ((δ a).base z₀) :=
            congrArg (CategoryTheory.Limits.pullback.fst ν ν).base hz₀.symm
          have hl : (CategoryTheory.Limits.pullback.fst ν ν).base (ι_pb.base q) =
              j_α.base ((CategoryTheory.Limits.pullback.fst π_α π_α).base q) := by
            change (ι_pb ≫ CategoryTheory.Limits.pullback.fst ν ν).base q = _
            rw [CategoryTheory.Limits.pullback.lift_fst]
            rfl
          have hr : (CategoryTheory.Limits.pullback.fst ν ν).base ((δ a).base z₀) = z₀ := by
            change (δ a ≫ CategoryTheory.Limits.pullback.fst ν ν).base z₀ = z₀
            rw [CategoryTheory.Limits.pullback.lift_fst]
            rfl
          rw [hl, hr] at h1
          exact h1.symm
        refine ⟨(CategoryTheory.Limits.pullback.fst π_α π_α).base q, ?_⟩
        apply hInj_ι
        change (δ_α a ≫ ι_pb).base _ = ι_pb.base q
        rw [hδ_compat a]
        change (δ a).base (j_α.base _) = ι_pb.base q
        rw [← hz₀_eq, hz₀]
      · rintro ⟨w, rfl⟩
        refine ⟨j_α.base w, ?_⟩
        change (j_α ≫ δ a).base w = (δ_α a ≫ ι_pb).base w
        rw [hδ_compat a]
    let e_spec_pb := AlgebraicGeometry.pullbackSpecIso A R R
    let e_CRT_iso : AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A R R)) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (ZMod ℓ → R)) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_CRT.symm.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom e_CRT.toRingHom)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid' : CommRingCat.ofHom (e_CRT.symm.toRingHom.comp e_CRT.toRingHom) = 𝟙 _ := by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro w
            exact e_CRT.symm_apply_apply w
          rw [hid', AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid' : CommRingCat.ofHom (e_CRT.toRingHom.comp e_CRT.symm.toRingHom) = 𝟙 _ := by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro h
            exact e_CRT.apply_symm_apply h
          rw [hid', AlgebraicGeometry.Spec.map_id] }
    let Φ_iso : Q_α ≅ AlgebraicGeometry.Spec (CommRingCat.of (ZMod ℓ → R)) :=
      e_spec_pb ≪≫ e_CRT_iso
    have hδ_Φ : ∀ a : ZMod ℓ,
        δ_α a ≫ Φ_iso.hom = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev_a a)) := by
      intro a
      rw [← Iso.eq_comp_inv]
      have hΦ_inv : Φ_iso.inv = e_CRT_iso.inv ≫ e_spec_pb.inv := rfl
      rw [hΦ_inv]
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp only [δ_α, e_CRT_iso]
        rw [CategoryTheory.Limits.pullback.lift_fst, Category.assoc, Category.assoc,
          AlgebraicGeometry.pullbackSpecIso_inv_fst, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        have hid_R : CommRingCat.ofHom
            (((ev_a a).comp e_CRT.toRingHom).comp Algebra.TensorProduct.includeLeftRingHom) =
            𝟙 (CommRingCat.of R) := by
          apply CommRingCat.hom_ext
          apply RingHom.ext
          intro r
          change Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α a)
            (TensorProduct.tmul A r 1) = r
          rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
          rfl
        rw [hid_R, AlgebraicGeometry.Spec.map_id]
      · dsimp only [δ_α, e_CRT_iso]
        rw [CategoryTheory.Limits.pullback.lift_snd, Category.assoc, Category.assoc,
          AlgebraicGeometry.pullbackSpecIso_inv_snd, ← AlgebraicGeometry.Spec.map_comp,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        change (σ_α a) r = Algebra.TensorProduct.productMap (AlgHom.id A R) (σ_α a)
          (TensorProduct.tmul A 1 r)
        rw [Algebra.TensorProduct.productMap_apply_tmul, AlgHom.id_apply, one_mul]
    refine ⟨Q_α, ι_pb, hInj_ι, hRange_ι, fun a q => q ∈ Set.range (δ_α a).base, ?_, ?_, hδ_iff⟩
    · intro a b hab q ⟨⟨p₁, hp₁⟩, ⟨p₂, hp₂⟩⟩
      have h1 : (δ_α a ≫ Φ_iso.hom).base p₁ = Φ_iso.hom.base q := by
        change Φ_iso.hom.base ((δ_α a).base p₁) = Φ_iso.hom.base q
        rw [hp₁]
      have h2 : (δ_α b ≫ Φ_iso.hom).base p₂ = Φ_iso.hom.base q := by
        change Φ_iso.hom.base ((δ_α b).base p₂) = Φ_iso.hom.base q
        rw [hp₂]
      rw [hδ_Φ a, AlgebraicGeometry.Spec.map_base] at h1
      rw [hδ_Φ b, AlgebraicGeometry.Spec.map_base] at h2
      exact h_spec_disj hab p₁ p₂ (h1.trans h2.symm)
    · intro q
      obtain ⟨a, p, hp⟩ := h_spec_cov (Φ_iso.hom.base q)
      refine ⟨a, p, ?_⟩
      have hbij_Φ : Function.Injective Φ_iso.hom.base :=
        (TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso Φ_iso)).injective
      apply hbij_Φ
      change (δ_α a ≫ Φ_iso.hom).base p = Φ_iso.hom.base q
      rw [hδ_Φ a, AlgebraicGeometry.Spec.map_base]
      exact hp

  have hSheetPart :
      (_root_.Pairwise fun a b : ZMod ℓ =>
        Disjoint (Set.range (δ a).base) (Set.range (δ b).base)) ∧
      (⋃ a : ZMod ℓ, Set.range (δ a).base) = Set.univ := by
    refine ⟨?_, ?_⟩
    · intro a b hab
      rw [Set.disjoint_left]
      intro z hza hzb
      have hy_top : ν.base ((CategoryTheory.Limits.pullback.fst ν ν).base z) ∈
          (⨆ α : Fin N_cov, W α) := by
        rw [hW_top]
        trivial
      obtain ⟨α, hα⟩ := TopologicalSpace.Opens.mem_iSup.mp hy_top
      obtain ⟨Q_α, ι_pb, _, hRange_ι, δ_loc, hDisj_loc, _, hIff_loc⟩ := hChart α
      obtain ⟨q, rfl⟩ := hRange_ι z hα
      exact hDisj_loc hab q ⟨(hIff_loc a q).mp hza, (hIff_loc b q).mp hzb⟩
    · ext z
      simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
      have hy_top : ν.base ((CategoryTheory.Limits.pullback.fst ν ν).base z) ∈
          (⨆ α : Fin N_cov, W α) := by
        rw [hW_top]
        trivial
      obtain ⟨α, hα⟩ := TopologicalSpace.Opens.mem_iSup.mp hy_top
      obtain ⟨Q_α, ι_pb, _, hRange_ι, δ_loc, _, hCov_loc, hIff_loc⟩ := hChart α
      obtain ⟨q, rfl⟩ := hRange_ι z hα
      obtain ⟨a, ha⟩ := hCov_loc q
      exact ⟨a, (hIff_loc a q).mpr ha⟩

  exact ⟨Z, ν, hFin_ν, hEt_ν, hSurj_ν, ρ, hρ_over, ⟨hρ_zero, hρ_add⟩, hSheetPart, hx_roots, he⟩

theorem weil_finite_etale_cover_dvr_generic_irred_and_special_connected (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (B_sp : Type u) [CommRing B_sp] [IsDomain B_sp] [Algebra k B_sp] [Algebra.FiniteType k B_sp]
    (hDed_sp : IsDedekindDomain B_sp)
    (τ_sp : B_sp →ₐ[k] k)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ι_sp_Ω : B_sp →+* Ω)
    (hInj_sp_Ω : Function.Injective ι_sp_Ω)
    (Y_sp : AlgebraicGeometry.Scheme.{u})
    (f_sp : Quiver.Hom Y_sp (AlgebraicGeometry.Spec (CommRingCat.of B_sp)))
    [AlgebraicGeometry.IsProper f_sp]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_sp]
    (τ_sec : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_sp)) Y_sp)
    (hτ_sec : CategoryTheory.CategoryStruct.comp τ_sec f_sp =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B_sp)))
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₀_sp : Quiver.Hom C₀.left Y_sp)
    (hPb_c₀_sp : CategoryTheory.IsPullback ι₀_sp C₀.hom f_sp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_sp.toRingHom)))
    (Y_η : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral Y_η]
    (ι_η_sp : Quiver.Hom Y_η Y_sp)
    (f_η : Quiver.Hom Y_η (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hPb_η_sp : CategoryTheory.IsPullback ι_η_sp f_η f_sp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_sp_Ω)))
    (Z_sp : AlgebraicGeometry.Scheme.{u})
    (ν_Z : Quiver.Hom Z_sp Y_sp)
    [AlgebraicGeometry.IsFinite ν_Z]
    [AlgebraicGeometry.Etale ν_Z]
    [AlgebraicGeometry.Surjective ν_Z]
    (W₀ : Y_sp.Opens)
    (hW₀_aff : AlgebraicGeometry.IsAffineOpen W₀)
    (u₀ : Units ↑(Y_sp.presheaf.obj (Opposite.op W₀)))
    (e₀ : CategoryTheory.Iso
      (AlgebraicGeometry.Scheme.Opens.toScheme
        ((TopologicalSpace.Opens.map ν_Z.base).obj W₀))
      (AlgebraicGeometry.Spec (CommRingCat.of
        (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C u₀.1)))))
    (he₀ : CategoryTheory.CategoryStruct.comp e₀.hom
      (CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
          (algebraMap (↑(Y_sp.presheaf.obj (Opposite.op W₀)))
            (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C u₀.1)))))
        hW₀_aff.fromSpec) =
      CategoryTheory.CategoryStruct.comp
        (AlgebraicGeometry.Scheme.Opens.ι
          ((TopologicalSpace.Opens.map ν_Z.base).obj W₀)) ν_Z)
    [hV₀_ne : Nonempty ↥(((TopologicalSpace.Opens.map ι_η_sp.base).obj W₀) :
      AlgebraicGeometry.Scheme.{u})]
    (hu₀_no_root :
      letI : IrreducibleSpace ↥Y_η :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_η
      let V₀ := (TopologicalSpace.Opens.map ι_η_sp.base).obj W₀
      ∀ (b : ↑Y_η.functionField),
        b ^ ℓ ≠ (Y_η.germToFunctionField V₀).hom ((ι_η_sp.app W₀).hom u₀.1)) :
    ConnectedSpace ↥(CategoryTheory.Limits.pullback ν_Z ι_η_sp) ∧
    ConnectedSpace ↥(CategoryTheory.Limits.pullback ν_Z ι₀_sp) :=
by
  have hConnOfIso : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (e : X₁ ≅ X₂),
      ConnectedSpace ↥X₁ → ConnectedSpace ↥X₂ := by
    intro X₁ X₂ e h₁
    let h := TopCat.homeoOfIso (AlgebraicGeometry.Scheme.forgetToTop.mapIso e)
    exact
      { isPreconnected_univ := by
          rw [← h.surjective.range_eq, ← Set.image_univ]
          exact h₁.isPreconnected_univ.image h h.continuous.continuousOn
        toNonempty := ⟨h (Classical.choice h₁.toNonempty)⟩ }

  
  
  
  have hAff_sp_Ω : AlgebraicGeometry.IsAffineHom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_sp_Ω)) :=
    AlgebraicGeometry.isAffineHom_of_isAffine _
  have hAff_ιη : AlgebraicGeometry.IsAffineHom ι_η_sp :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η_sp.flip hAff_sp_Ω

  have hConn_Zη : ConnectedSpace ↥(CategoryTheory.Limits.pullback ν_Z ι_η_sp) := by
    have hPrime : Nat.Prime ℓ := Fact.out
    let Z_η : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback ν_Z ι_η_sp
    let p_Z : Z_η ⟶ Z_sp := CategoryTheory.Limits.pullback.fst ν_Z ι_η_sp
    let ν_η : Z_η ⟶ Y_η := CategoryTheory.Limits.pullback.snd ν_Z ι_η_sp
    have hPb_Zη : CategoryTheory.IsPullback p_Z ν_η ν_Z ι_η_sp :=
      CategoryTheory.IsPullback.of_hasPullback ν_Z ι_η_sp
    haveI : AlgebraicGeometry.Etale ν_η :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Zη inferInstance
    let V₀ : Y_η.Opens := (TopologicalSpace.Opens.map ι_η_sp.base).obj W₀
    have hV₀_aff : AlgebraicGeometry.IsAffineOpen V₀ :=
      (AlgebraicGeometry.isAffineHom_iff ι_η_sp).mp hAff_ιη W₀ hW₀_aff

    let A₀_cat := Y_sp.presheaf.obj (Opposite.op W₀)
    let A₀ : Type u := ↑A₀_cat
    let B₀_cat := Y_η.presheaf.obj (Opposite.op V₀)
    let B₀ : Type u := ↑B₀_cat
    let φ₀ : A₀ →+* B₀ := (ι_η_sp.app W₀).hom
    let u_η₀ : B₀ := φ₀ u₀.1
    let P₀ : Polynomial A₀ := Polynomial.X ^ ℓ - Polynomial.C u₀.1
    let R₀ : Type u := AdjoinRoot P₀
    let P_η₀ : Polynomial B₀ := Polynomial.X ^ ℓ - Polynomial.C u_η₀
    let R_η₀ : Type u := AdjoinRoot P_η₀

    letI : Algebra A₀ B₀ := φ₀.toAlgebra

    have hroot_η_pow : (AdjoinRoot.root P_η₀) ^ ℓ = algebraMap B₀ R_η₀ u_η₀ := by
      have hev := AdjoinRoot.eval₂_root P_η₀
      simp only [P_η₀, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hev
      exact sub_eq_zero.mp hev
    have hroot_0_pow : (AdjoinRoot.root P₀) ^ ℓ = algebraMap A₀ R₀ u₀.1 := by
      have hev := AdjoinRoot.eval₂_root P₀
      simp only [P₀, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hev
      exact sub_eq_zero.mp hev

    have heval_L : Polynomial.eval₂ (↑(Algebra.ofId A₀ R_η₀)) (AdjoinRoot.root P_η₀) P₀ = 0 := by
      simp only [P₀, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, hroot_η_pow]
      change (algebraMap B₀ R_η₀) u_η₀ - (algebraMap A₀ R_η₀) u₀.1 = 0
      rw [IsScalarTower.algebraMap_apply A₀ B₀ R_η₀ u₀.1]
      exact sub_self _
    let α_L : R₀ →ₐ[A₀] R_η₀ :=
      AdjoinRoot.liftAlgHom P₀ (Algebra.ofId A₀ R_η₀) (AdjoinRoot.root P_η₀) heval_L
    let α_fwd : TensorProduct A₀ R₀ B₀ →ₐ[A₀] R_η₀ :=
      Algebra.TensorProduct.productMap α_L (IsScalarTower.toAlgHom A₀ B₀ R_η₀)

    have heval_bwd :
        Polynomial.eval₂
          (Algebra.TensorProduct.includeRight : B₀ →ₐ[A₀] TensorProduct A₀ R₀ B₀).toRingHom
          ((AdjoinRoot.root P₀) ⊗ₜ[A₀] (1 : B₀)) P_η₀ = 0 := by
      simp only [P_η₀, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C]
      rw [Algebra.TensorProduct.tmul_pow, one_pow, hroot_0_pow]
      have hsmul : (algebraMap A₀ R₀ u₀.1) ⊗ₜ[A₀] (1 : B₀) = (1 : R₀) ⊗ₜ[A₀] u_η₀ := by
        calc
          (algebraMap A₀ R₀ u₀.1) ⊗ₜ[A₀] (1 : B₀)
              = (u₀.1 • (1 : R₀)) ⊗ₜ[A₀] (1 : B₀) := by rw [Algebra.smul_def, mul_one]
          _ = (1 : R₀) ⊗ₜ[A₀] (u₀.1 • (1 : B₀)) := TensorProduct.smul_tmul u₀.1 (1 : R₀) (1 : B₀)
          _ = (1 : R₀) ⊗ₜ[A₀] u_η₀ := by
            congr 1
            rw [Algebra.smul_def, mul_one]
            rfl
      rw [hsmul]
      exact sub_self _
    let α_bwd_ring : R_η₀ →+* TensorProduct A₀ R₀ B₀ :=
      AdjoinRoot.lift
        (Algebra.TensorProduct.includeRight : B₀ →ₐ[A₀] TensorProduct A₀ R₀ B₀).toRingHom
        ((AdjoinRoot.root P₀) ⊗ₜ[A₀] (1 : B₀)) heval_bwd
    let α_bwd : R_η₀ →ₐ[A₀] TensorProduct A₀ R₀ B₀ :=
      { α_bwd_ring with
        commutes' := fun a => by
          rw [IsScalarTower.algebraMap_apply A₀ B₀ R_η₀ a]
          change α_bwd_ring (AdjoinRoot.of P_η₀ (algebraMap A₀ B₀ a)) =
            algebraMap A₀ (TensorProduct A₀ R₀ B₀) a
          rw [AdjoinRoot.lift_of]
          exact (Algebra.TensorProduct.includeRight : B₀ →ₐ[A₀] TensorProduct A₀ R₀ B₀).commutes a }

    have h_bwd_fwd : α_bwd.comp α_fwd = AlgHom.id A₀ (TensorProduct A₀ R₀ B₀) := by
      apply Algebra.TensorProduct.ext
      · apply AdjoinRoot.algHom_ext
        simp only [AlgHom.comp_apply, AlgHom.id_apply, Algebra.TensorProduct.includeLeft_apply,
          α_fwd, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        change α_bwd_ring (AdjoinRoot.lift (↑(Algebra.ofId A₀ R_η₀)) (AdjoinRoot.root P_η₀) heval_L
          (AdjoinRoot.root P₀)) = (AdjoinRoot.root P₀) ⊗ₜ[A₀] (1 : B₀)
        rw [AdjoinRoot.lift_root, AdjoinRoot.lift_root]
      · ext b
        simp only [AlgHom.comp_apply, AlgHom.restrictScalars_apply, AlgHom.id_apply,
          Algebra.TensorProduct.includeRight_apply, α_fwd,
          Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        exact AdjoinRoot.lift_of heval_bwd

    have h_fwd_bwd : α_fwd.toRingHom.comp α_bwd_ring = RingHom.id R_η₀ := by
      rw [AdjoinRoot.ringHom_ext_iff]
      refine ⟨?_, ?_⟩
      · ext b
        simp only [RingHom.comp_apply, RingHom.id_apply, α_bwd_ring, AdjoinRoot.lift_of]
        change α_fwd ((1 : R₀) ⊗ₜ[A₀] b) = AdjoinRoot.of P_η₀ b
        simp only [α_fwd, Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
      · simp only [RingHom.comp_apply, RingHom.id_apply, α_bwd_ring, AdjoinRoot.lift_root]
        change α_fwd ((AdjoinRoot.root P₀) ⊗ₜ[A₀] (1 : B₀)) = AdjoinRoot.root P_η₀
        simp only [α_fwd, Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        exact AdjoinRoot.lift_root heval_L

    let e_ten_cat : CommRingCat.of (TensorProduct A₀ R₀ B₀) ≅ CommRingCat.of R_η₀ :=
      { hom := CommRingCat.ofHom α_fwd.toRingHom
        inv := CommRingCat.ofHom α_bwd_ring
        hom_inv_id := by
          rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_id]
          exact congrArg CommRingCat.ofHom (RingHom.ext fun x => AlgHom.congr_fun h_bwd_fwd x)
        inv_hom_id := by
          rw [← CommRingCat.ofHom_comp, h_fwd_bwd, CommRingCat.ofHom_id] }
    let e_Spec_ten : AlgebraicGeometry.Spec (CommRingCat.of R_η₀) ≅
        AlgebraicGeometry.Spec (CommRingCat.of (TensorProduct A₀ R₀ B₀)) :=
      { hom := AlgebraicGeometry.Spec.map e_ten_cat.hom
        inv := AlgebraicGeometry.Spec.map e_ten_cat.inv
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, e_ten_cat.inv_hom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, e_ten_cat.hom_inv_id, AlgebraicGeometry.Spec.map_id] }

    let π₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ AlgebraicGeometry.Spec A₀_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ R₀))
    let ψ₀ : AlgebraicGeometry.Spec B₀_cat ⟶ AlgebraicGeometry.Spec A₀_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₀ B₀))
    let e_Rη : AlgebraicGeometry.Spec (CommRingCat.of R_η₀) ≅ CategoryTheory.Limits.pullback π₀ ψ₀ :=
      e_Spec_ten ≪≫ (AlgebraicGeometry.pullbackSpecIso A₀ R₀ B₀).symm
    let q_R₀ : AlgebraicGeometry.Spec (CommRingCat.of R_η₀) ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      e_Rη.hom ≫ CategoryTheory.Limits.pullback.fst π₀ ψ₀
    let π_η₀ : AlgebraicGeometry.Spec (CommRingCat.of R_η₀) ⟶ AlgebraicGeometry.Spec B₀_cat :=
      e_Rη.hom ≫ CategoryTheory.Limits.pullback.snd π₀ ψ₀
    have hPb₀ : CategoryTheory.IsPullback q_R₀ π_η₀ π₀ ψ₀ :=
      CategoryTheory.IsPullback.of_iso_pullback
        ⟨by simp only [q_R₀, π_η₀, Category.assoc, Limits.pullback.condition]⟩
        e_Rη rfl rfl

    let Z_W₀ : Z_sp.Opens := (TopologicalSpace.Opens.map ν_Z.base).obj W₀
    let j_Z : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ Z_sp :=
      e₀.inv ≫ AlgebraicGeometry.Scheme.Opens.ι Z_W₀
    haveI : AlgebraicGeometry.IsOpenImmersion j_Z := inferInstance
    have hj_Z_comm : j_Z ≫ ν_Z = π₀ ≫ hW₀_aff.fromSpec := by
      dsimp [j_Z, π₀]
      rw [Category.assoc, ← he₀, ← Category.assoc, e₀.inv_hom_id, Category.id_comp]
    have hj_Z_range : Set.range j_Z.base = ν_Z.base ⁻¹' Set.range hW₀_aff.fromSpec.base := by
      rw [hW₀_aff.range_fromSpec]
      ext z
      constructor
      · rintro ⟨x, rfl⟩
        exact (e₀.inv.base x).2
      · intro hz
        refine ⟨e₀.hom.base ⟨z, hz⟩, ?_⟩
        change (e₀.hom ≫ e₀.inv ≫ AlgebraicGeometry.Scheme.Opens.ι Z_W₀).base ⟨z, hz⟩ = z
        rw [Iso.hom_inv_id_assoc]
        rfl
    have hPb₁ : CategoryTheory.IsPullback j_Z π₀ ν_Z hW₀_aff.fromSpec := by
      refine ⟨⟨hj_Z_comm⟩, ⟨Limits.PullbackCone.IsLimit.mk _
        (fun s => AlgebraicGeometry.IsOpenImmersion.lift j_Z s.fst ?_) ?_ ?_ ?_⟩⟩
      · rw [hj_Z_range]
        rintro _ ⟨w, rfl⟩
        change (s.fst ≫ ν_Z).base w ∈ Set.range hW₀_aff.fromSpec.base
        rw [s.condition]
        exact ⟨s.snd.base w, rfl⟩
      · intro s
        exact AlgebraicGeometry.IsOpenImmersion.lift_fac j_Z s.fst _
      · intro s
        rw [← cancel_mono hW₀_aff.fromSpec, Category.assoc, ← hj_Z_comm, ← Category.assoc,
          AlgebraicGeometry.IsOpenImmersion.lift_fac, s.condition]
      · intro s m hm₁ _
        rw [← cancel_mono j_Z, hm₁]
        exact (AlgebraicGeometry.IsOpenImmersion.lift_fac j_Z s.fst _).symm

    let j_V : AlgebraicGeometry.Spec B₀_cat ⟶ Y_η := hV₀_aff.fromSpec
    have hψ₀_eq : ψ₀ = AlgebraicGeometry.Spec.map (ι_η_sp.appLE W₀ V₀ (le_refl V₀)) := by
      rw [← AlgebraicGeometry.Scheme.Hom.app_eq_appLE ι_η_sp]
      rfl
    have hj_V_comm : ψ₀ ≫ hW₀_aff.fromSpec = j_V ≫ ι_η_sp := by
      rw [hψ₀_eq]
      exact hW₀_aff.SpecMap_appLE_fromSpec ι_η_sp hV₀_aff (le_refl V₀)

    have hPb₀₁ : CategoryTheory.IsPullback (q_R₀ ≫ j_Z) π_η₀ ν_Z (j_V ≫ ι_η_sp) := by
      rw [← hj_V_comm]
      exact hPb₀.paste_horiz hPb₁

    have hcomm_Zη : (q_R₀ ≫ j_Z) ≫ ν_Z = (π_η₀ ≫ j_V) ≫ ι_η_sp := by
      rw [Category.assoc π_η₀ j_V ι_η_sp]
      exact hPb₀₁.w
    let j_Zη : AlgebraicGeometry.Spec (CommRingCat.of R_η₀) ⟶ Z_η :=
      Limits.pullback.lift (q_R₀ ≫ j_Z) (π_η₀ ≫ j_V) hcomm_Zη
    have hPb_Zη₀ : CategoryTheory.IsPullback j_Zη π_η₀ ν_η j_V := by
      refine CategoryTheory.IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _) hPb_Zη
      rw [Limits.pullback.lift_fst]
      exact hPb₀₁
    haveI : AlgebraicGeometry.IsOpenImmersion j_Zη :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Zη₀.flip inferInstance
    have hj_Zη_range : Set.range j_Zη.base = ν_η.base ⁻¹' (V₀ : Set ↥Y_η) := by
      let hIso := hPb_Zη₀.isoPullback
      have h_fst : hIso.hom ≫ Limits.pullback.fst ν_η j_V = j_Zη := hPb_Zη₀.isoPullback_hom_fst
      rw [← h_fst, ← hV₀_aff.range_fromSpec,
        ← AlgebraicGeometry.Scheme.Pullback.range_fst ν_η j_V]
      ext z
      constructor
      · rintro ⟨x, rfl⟩
        exact ⟨hIso.hom.base x, rfl⟩
      · rintro ⟨w, rfl⟩
        refine ⟨hIso.inv.base w, ?_⟩
        change ((hIso.inv ≫ hIso.hom) ≫ Limits.pullback.fst ν_η j_V).base w = _
        rw [hIso.inv_hom_id, Category.id_comp]

    letI : IrreducibleSpace ↥Y_η := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_η
    let K_η : Type u := ↑Y_η.functionField
    let ι_K : B₀ →+* K_η := (Y_η.germToFunctionField V₀).hom
    have hInj_K : Function.Injective ι_K := Y_η.germToFunctionField_injective V₀
    haveI : Nontrivial B₀ :=
      ⟨⟨0, 1, fun h01 =>
        zero_ne_one ((map_zero ι_K).symm.trans ((congrArg ι_K h01).trans (map_one ι_K)))⟩⟩

    let P_K : Polynomial K_η := Polynomial.X ^ ℓ - Polynomial.C (ι_K u_η₀)
    have hIrred_PK : Irreducible P_K :=
      X_pow_sub_C_irreducible_of_prime hPrime hu₀_no_root
    letI : Fact (Irreducible P_K) := ⟨hIrred_PK⟩
    let L_η : Type u := AdjoinRoot P_K

    have heval_PK :
        Polynomial.eval₂ ((algebraMap K_η L_η).comp ι_K) (AdjoinRoot.root P_K) P_η₀ = 0 := by
      have hev := AdjoinRoot.eval₂_root P_K
      simp only [P_K, P_η₀, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C, RingHom.comp_apply] at hev ⊢
      exact hev
    let ψ_K : R_η₀ →+* L_η :=
      AdjoinRoot.lift ((algebraMap K_η L_η).comp ι_K) (AdjoinRoot.root P_K) heval_PK

    have hMonic₀ : P_η₀.Monic := Polynomial.monic_X_pow_sub_C u_η₀ hPrime.ne_zero
    have hMonic_K : P_K.Monic := Polynomial.monic_X_pow_sub_C (ι_K u_η₀) hPrime.ne_zero
    let pb₀ := AdjoinRoot.powerBasis' hMonic₀
    let pb_K := AdjoinRoot.powerBasis' hMonic_K
    have hdim₀ : pb₀.dim = ℓ := by
      rw [AdjoinRoot.powerBasis'_dim]
      exact Polynomial.natDegree_X_pow_sub_C
    have hdim_K : pb_K.dim = ℓ := by
      rw [AdjoinRoot.powerBasis'_dim]
      exact Polynomial.natDegree_X_pow_sub_C

    have hInj_ψK : Function.Injective ψ_K := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      have hz_sum : z = ∑ i : Fin pb₀.dim, (pb₀.basis.repr z i) • pb₀.basis i :=
        (pb₀.basis.sum_repr z).symm
      have hψ_basis : ∀ i : Fin pb₀.dim,
          ψ_K ((pb₀.basis.repr z i) • pb₀.basis i) =
            (ι_K (pb₀.basis.repr z i)) • (pb_K.gen ^ (i : ℕ)) := by
        intro i
        rw [PowerBasis.coe_basis, Algebra.smul_def, map_mul, map_pow]
        change ψ_K (AdjoinRoot.of P_η₀ (pb₀.basis.repr z i)) * (ψ_K pb₀.gen) ^ (i : ℕ) = _
        rw [AdjoinRoot.lift_of, RingHom.comp_apply, ← Algebra.smul_def]
        congr 2
        change ψ_K (AdjoinRoot.root P_η₀) = AdjoinRoot.root P_K
        exact AdjoinRoot.lift_root heval_PK
      have hsum_zero :
          ∑ i : Fin pb₀.dim, (ι_K (pb₀.basis.repr z i)) • (pb_K.gen ^ (i : ℕ)) = 0 := by
        calc
          ∑ i : Fin pb₀.dim, (ι_K (pb₀.basis.repr z i)) • (pb_K.gen ^ (i : ℕ))
              = ∑ i : Fin pb₀.dim, ψ_K ((pb₀.basis.repr z i) • pb₀.basis i) :=
                Finset.sum_congr rfl fun i _ => (hψ_basis i).symm
          _ = ψ_K (∑ i : Fin pb₀.dim, (pb₀.basis.repr z i) • pb₀.basis i) := (map_sum ψ_K _ _).symm
          _ = ψ_K z := by rw [← hz_sum]
          _ = 0 := hz
      let e_fin : Fin pb_K.dim ≃ Fin pb₀.dim := finCongr (hdim_K.trans hdim₀.symm)
      have hsum_K :
          ∑ j : Fin pb_K.dim, (ι_K (pb₀.basis.repr z (e_fin j))) • pb_K.basis j = 0 := by
        refine (Fintype.sum_equiv e_fin _
          (fun i => (ι_K (pb₀.basis.repr z i)) • (pb_K.gen ^ (i : ℕ))) ?_).trans hsum_zero
        intro j
        rw [PowerBasis.coe_basis]
        rfl
      have hlin := Fintype.linearIndependent_iff.mp pb_K.basis.linearIndependent
        (fun j => ι_K (pb₀.basis.repr z (e_fin j))) hsum_K
      have hrepr_zero : ∀ i : Fin pb₀.dim, pb₀.basis.repr z i = 0 := by
        intro i
        apply hInj_K
        rw [map_zero]
        simpa [e_fin] using hlin (e_fin.symm i)
      rw [hz_sum]
      exact Finset.sum_eq_zero fun i _ => by rw [hrepr_zero i, zero_smul]

    haveI : IsDomain R_η₀ := Function.Injective.isDomain ψ_K hInj_ψK
    have hIrred_R : IrreducibleSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of R_η₀)) := by
      change IrreducibleSpace (PrimeSpectrum R_η₀)
      infer_instance

    haveI : AlgebraicGeometry.UniversallyOpen ν_η := AlgebraicGeometry.UniversallyOpen.of_flat ν_η
    have hOpen_νη : IsOpenMap ν_η.base := ν_η.isOpenMap
    have hIrred_Zη : IrreducibleSpace ↥Z_η :=
      { isPreirreducible_univ := by
          intro O₁ O₂ hO₁ hO₂ hne₁ hne₂
          have hV₀_nonempty : (V₀ : Set ↥Y_η).Nonempty := by
            obtain ⟨y₀⟩ := hV₀_ne
            exact ⟨y₀.1, y₀.2⟩
          have hmeet₁ : (ν_η.base '' O₁ ∩ (V₀ : Set ↥Y_η)).Nonempty := by
            have hne₁' : (Set.univ ∩ (ν_η.base '' O₁)).Nonempty := by
              rw [Set.univ_inter]
              exact (Set.univ_inter O₁ ▸ hne₁).image _
            have hne_V : (Set.univ ∩ (V₀ : Set ↥Y_η)).Nonempty := by
              rwa [Set.univ_inter]
            obtain ⟨y, _, hy⟩ := (IrreducibleSpace.isIrreducible_univ (X := ↥Y_η)).isPreirreducible
              (ν_η.base '' O₁) (V₀ : Set ↥Y_η) (hOpen_νη O₁ hO₁) V₀.2 hne₁' hne_V
            exact ⟨y, hy⟩
          have hmeet₂ : (ν_η.base '' O₂ ∩ (V₀ : Set ↥Y_η)).Nonempty := by
            have hne₂' : (Set.univ ∩ (ν_η.base '' O₂)).Nonempty := by
              rw [Set.univ_inter]
              exact (Set.univ_inter O₂ ▸ hne₂).image _
            have hne_V : (Set.univ ∩ (V₀ : Set ↥Y_η)).Nonempty := by
              rwa [Set.univ_inter]
            obtain ⟨y, _, hy⟩ := (IrreducibleSpace.isIrreducible_univ (X := ↥Y_η)).isPreirreducible
              (ν_η.base '' O₂) (V₀ : Set ↥Y_η) (hOpen_νη O₂ hO₂) V₀.2 hne₂' hne_V
            exact ⟨y, hy⟩
          obtain ⟨_, ⟨z₁, hz₁_O₁, rfl⟩, hz₁_V⟩ := hmeet₁
          obtain ⟨_, ⟨z₂, hz₂_O₂, rfl⟩, hz₂_V⟩ := hmeet₂
          have hz₁_r : z₁ ∈ Set.range j_Zη.base := by rw [hj_Zη_range]; exact hz₁_V
          have hz₂_r : z₂ ∈ Set.range j_Zη.base := by rw [hj_Zη_range]; exact hz₂_V
          obtain ⟨x₁, rfl⟩ := hz₁_r
          obtain ⟨x₂, rfl⟩ := hz₂_r
          obtain ⟨x, _, hx₁, hx₂⟩ := hIrred_R.isPreirreducible_univ
            (j_Zη.base ⁻¹' O₁) (j_Zη.base ⁻¹' O₂)
            (hO₁.preimage j_Zη.continuous) (hO₂.preimage j_Zη.continuous)
            ⟨x₁, trivial, hz₁_O₁⟩ ⟨x₂, trivial, hz₂_O₂⟩
          exact ⟨j_Zη.base x, trivial, hx₁, hx₂⟩
        toNonempty := ⟨j_Zη.base (Classical.choice hIrred_R.toNonempty)⟩ }
    exact @IrreducibleSpace.connectedSpace ↥Z_η _ hIrred_Zη

  
  
  
  have hClopenLoc :
      ∀ (W : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine W]
        (p_W : Quiver.Hom W (AlgebraicGeometry.Spec (CommRingCat.of k)))
        [AlgebraicGeometry.LocallyOfFiniteType p_W]
        (s_W : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) W),
      ∃ (R₀ : Type u) (instCR : CommRing R₀),
        letI : CommRing R₀ := instCR
        ConnectedSpace (PrimeSpectrum R₀) ∧
        ∃ (j₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R₀)) W)
          (_ : AlgebraicGeometry.IsOpenImmersion j₀)
          (s₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
            (AlgebraicGeometry.Spec (CommRingCat.of R₀))),
          CategoryTheory.CategoryStruct.comp s₀ j₀ = s_W := by
    intro W _ p_W _ s_W
    let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
    let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
    haveI : Subsingleton ↥S_k := by
      change Subsingleton (PrimeSpectrum k)
      infer_instance
    let R_W_cat := W.presheaf.obj (Opposite.op ⊤)
    let R_W : Type u := ↑R_W_cat
    let e_W : W ≅ AlgebraicGeometry.Spec R_W_cat := W.isoSpec
    let x_W : PrimeSpectrum R_W := e_W.hom.base (s_W.base pt_k)

    let φ_k_cat : CommRingCat.of k ⟶ R_W_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hSpec_φk : AlgebraicGeometry.Spec.map φ_k_cat = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage _
    have hLFT_inv : AlgebraicGeometry.LocallyOfFiniteType (AlgebraicGeometry.Spec.map φ_k_cat) := by
      rw [hSpec_φk]
      infer_instance
    have hFT_φk : RingHom.FiniteType φ_k_cat.hom :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType)).mp hLFT_inv
    letI : Algebra k R_W := φ_k_cat.hom.toAlgebra
    haveI : Algebra.FiniteType k R_W := hFT_φk
    haveI : IsNoetherianRing R_W := Algebra.FiniteType.isNoetherianRing k R_W
    haveI : TopologicalSpace.NoetherianSpace (PrimeSpectrum R_W) := inferInstance

    let K : Set (PrimeSpectrum R_W) := connectedComponent x_W
    let ℱ : Set (Set (PrimeSpectrum R_W)) :=
      {C ∈ irreducibleComponents (PrimeSpectrum R_W) | Disjoint C K}
    have hFin_ℱ : ℱ.Finite :=
      (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents).sep _
    have hCompl_eq : Kᶜ = ⋃ C ∈ ℱ, C := by
      ext y
      simp only [Set.mem_compl_iff, Set.mem_iUnion, exists_prop, ℱ, Set.mem_sep_iff]
      constructor
      · intro hy
        refine ⟨irreducibleComponent y, ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩,
          mem_irreducibleComponent⟩
        rw [Set.disjoint_left]
        intro z hz_C hz_K
        apply hy
        have hPre : _root_.IsPreconnected (irreducibleComponent y) :=
          isIrreducible_irreducibleComponent.isConnected.isPreconnected
        have hSub : irreducibleComponent y ⊆ connectedComponent z :=
          hPre.subset_connectedComponent hz_C
        have heq : connectedComponent z = K := (connectedComponent_eq hz_K).symm
        exact heq ▸ hSub mem_irreducibleComponent
      · rintro ⟨C, ⟨_, hDisj⟩, hy_C⟩ hy_K
        exact Set.disjoint_left.mp hDisj hy_C hy_K
    have hClosed_compl : IsClosed Kᶜ := by
      rw [hCompl_eq]
      exact hFin_ℱ.isClosed_biUnion fun C hC => isClosed_of_mem_irreducibleComponents C hC.1
    have hClopen_K : IsClopen K := ⟨isClosed_connectedComponent, isClosed_compl_iff.mp hClosed_compl⟩
    obtain ⟨e_idem, _, hK_basic⟩ := PrimeSpectrum.isClopen_iff.mp hClopen_K

    let R₀ : Type u := Localization.Away e_idem
    let j_loc : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ AlgebraicGeometry.Spec R_W_cat :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R_W R₀))
    haveI : AlgebraicGeometry.IsOpenImmersion j_loc := inferInstance
    have hj_loc_range : Set.range j_loc.base = K := by
      rw [hK_basic]
      exact PrimeSpectrum.localization_away_comap_range R₀ e_idem

    have hx_mem : x_W ∈ Set.range j_loc.base := by
      rw [hj_loc_range]
      exact mem_connectedComponent
    obtain ⟨z₀, hz₀⟩ := hx_mem

    have hConn_R₀ : ConnectedSpace (PrimeSpectrum R₀) :=
      { isPreconnected_univ := by
          intro U₁ U₂ hU₁ hU₂ hcov hne₁ hne₂
          have hOpen_j : IsOpenMap j_loc.base := j_loc.isOpenEmbedding.isOpenMap
          have hInj_j : Function.Injective j_loc.base := j_loc.isOpenEmbedding.injective
          have hK_cov : K ⊆ j_loc.base '' U₁ ∪ j_loc.base '' U₂ := by
            rw [← hj_loc_range]
            rintro _ ⟨z, rfl⟩
            rcases hcov (trivial : z ∈ Set.univ) with hz₁ | hz₂
            · exact Or.inl ⟨z, hz₁, rfl⟩
            · exact Or.inr ⟨z, hz₂, rfl⟩
          obtain ⟨z₁, _, hz₁⟩ := hne₁
          obtain ⟨z₂, _, hz₂⟩ := hne₂
          have hK_ne₁ : (K ∩ j_loc.base '' U₁).Nonempty := by
            refine ⟨j_loc.base z₁, ?_, ⟨z₁, hz₁, rfl⟩⟩
            rw [← hj_loc_range]
            exact ⟨z₁, rfl⟩
          have hK_ne₂ : (K ∩ j_loc.base '' U₂).Nonempty := by
            refine ⟨j_loc.base z₂, ?_, ⟨z₂, hz₂, rfl⟩⟩
            rw [← hj_loc_range]
            exact ⟨z₂, rfl⟩
          obtain ⟨_, _, ⟨a₁, ha₁, heq₁⟩, ⟨a₂, ha₂, heq₂⟩⟩ :=
            isConnected_connectedComponent.isPreconnected
              (j_loc.base '' U₁) (j_loc.base '' U₂)
              (hOpen_j U₁ hU₁) (hOpen_j U₂ hU₂) hK_cov hK_ne₁ hK_ne₂
          have ha_eq : a₁ = a₂ := hInj_j (heq₁.trans heq₂.symm)
          exact ⟨a₁, trivial, ha₁, ha_eq ▸ ha₂⟩
        toNonempty := ⟨z₀⟩ }

    let j₀ : AlgebraicGeometry.Spec (CommRingCat.of R₀) ⟶ W := j_loc ≫ e_W.inv
    haveI : AlgebraicGeometry.IsOpenImmersion j₀ := inferInstance
    have hs_W_range : Set.range s_W.base ⊆ Set.range j₀.base := by
      rintro _ ⟨y, rfl⟩
      rw [Subsingleton.elim y pt_k]
      refine ⟨z₀, ?_⟩
      change e_W.inv.base (j_loc.base z₀) = s_W.base pt_k
      rw [hz₀]
      change (e_W.hom ≫ e_W.inv).base (s_W.base pt_k) = s_W.base pt_k
      rw [e_W.hom_inv_id]
      rfl
    let s₀ : S_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of R₀) :=
      AlgebraicGeometry.IsOpenImmersion.lift j₀ s_W hs_W_range
    exact ⟨R₀, inferInstance, hConn_R₀, j₀, inferInstance, s₀,
      AlgebraicGeometry.IsOpenImmersion.lift_fac j₀ s_W hs_W_range⟩

  
  
  
  have hFracTransfer :
      ∀ (B_U : Type u) [CommRing B_U] [IsDomain B_U]
        (φ_BU : B_sp →+* B_U),
        Function.Injective φ_BU →
        (letI : Algebra B_sp B_U := φ_BU.toAlgebra
         ∀ (K₀ K_U : Type u) [Field K₀] [Field K_U]
           [Algebra B_sp K₀] [IsFractionRing B_sp K₀]
           [Algebra B_U K_U] [IsFractionRing B_U K_U]
           [Algebra K₀ K_U] [Algebra B_sp K_U]
           [IsScalarTower B_sp K₀ K_U] [IsScalarTower B_sp B_U K_U],
           FiniteDimensional K₀ K_U) →
        ∃ ι_U_Ω : B_U →+* Ω,
          Function.Injective ι_U_Ω ∧
          ι_U_Ω.comp φ_BU = ι_sp_Ω ∧
          ∀ (Z_U : AlgebraicGeometry.Scheme.{u})
            (f_U : Quiver.Hom Z_U (AlgebraicGeometry.Spec (CommRingCat.of B_U)))
            [AlgebraicGeometry.Flat f_U]
            [AlgebraicGeometry.LocallyOfFinitePresentation f_U],
            ConnectedSpace ↥(CategoryTheory.Limits.pullback f_U
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_U_Ω))) →
            ConnectedSpace ↥Z_U := by
    intro B_U _ _ φ_BU hInj_BU hFin_frac
    letI : Algebra B_sp B_U := φ_BU.toAlgebra
    let K₀ : Type u := FractionRing B_sp
    let K_U : Type u := FractionRing B_U
    let ψ_KU : B_sp →+* K_U := algebraMap B_sp K_U
    have hψ_eq : ψ_KU = (algebraMap B_U K_U).comp φ_BU :=
      RingHom.ext fun b => IsScalarTower.algebraMap_apply B_sp B_U K_U b
    have hInj_ψKU : Function.Injective ψ_KU := by
      rw [hψ_eq]
      exact (IsFractionRing.injective B_U K_U).comp hInj_BU
    have hUnit_KU : ∀ y : nonZeroDivisors B_sp, IsUnit (ψ_KU y) := by
      intro y
      refine Ne.isUnit ?_
      intro h0
      exact mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hInj_ψKU (h0.trans (map_zero ψ_KU).symm))
    let ι_K₀_KU : K₀ →+* K_U := IsLocalization.lift (M := nonZeroDivisors B_sp) (S := K₀) hUnit_KU
    letI : Algebra K₀ K_U := ι_K₀_KU.toAlgebra
    haveI : IsScalarTower B_sp K₀ K_U :=
      ⟨fun b x y => by
        rw [Algebra.smul_def (b • x) y, Algebra.smul_def b x, Algebra.smul_def b (x • y),
          Algebra.smul_def x y, map_mul, ← mul_assoc]
        congr 2
        change ι_K₀_KU (algebraMap B_sp K₀ b) = ψ_KU b
        exact IsLocalization.lift_eq (S := K₀) hUnit_KU b⟩
    haveI : FiniteDimensional K₀ K_U := hFin_frac K₀ K_U
    haveI : Algebra.IsAlgebraic K₀ K_U := Algebra.IsAlgebraic.of_finite K₀ K_U

    have hUnit_Ω : ∀ y : nonZeroDivisors B_sp, IsUnit (ι_sp_Ω y) := by
      intro y
      refine Ne.isUnit ?_
      intro h0
      exact mem_nonZeroDivisors_iff_ne_zero.mp y.2 (hInj_sp_Ω (h0.trans (map_zero ι_sp_Ω).symm))
    let ι_K₀_Ω : K₀ →+* Ω := IsLocalization.lift (M := nonZeroDivisors B_sp) (S := K₀) hUnit_Ω
    letI : Algebra K₀ Ω := ι_K₀_Ω.toAlgebra
    let σ_U : K_U →ₐ[K₀] Ω := IsAlgClosed.lift

    let ι_U_Ω : B_U →+* Ω := σ_U.toRingHom.comp (algebraMap B_U K_U)
    have hInj_UΩ : Function.Injective ι_U_Ω :=
      σ_U.toRingHom.injective.comp (IsFractionRing.injective B_U K_U)
    have hComp_UΩ : ι_U_Ω.comp φ_BU = ι_sp_Ω := by
      ext b
      change σ_U ((algebraMap B_U K_U) ((algebraMap B_sp B_U) b)) = ι_sp_Ω b
      have h₁ : (algebraMap B_U K_U) ((algebraMap B_sp B_U) b) =
          algebraMap K₀ K_U (algebraMap B_sp K₀ b) := by
        rw [← IsScalarTower.algebraMap_apply B_sp B_U K_U b]
        exact (IsLocalization.lift_eq hUnit_KU b).symm
      rw [h₁, σ_U.commutes]
      exact IsLocalization.lift_eq hUnit_Ω b

    refine ⟨ι_U_Ω, hInj_UΩ, hComp_UΩ, ?_⟩
    intro Z_U f_U _ _ hConn_fib
    let s_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_U) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_U_Ω)
    let pr₁ : CategoryTheory.Limits.pullback f_U s_Ω ⟶ Z_U :=
      CategoryTheory.Limits.pullback.fst f_U s_Ω
    let pt_Ω : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
      (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum Ω)
    let η_BU : ↥(AlgebraicGeometry.Spec (CommRingCat.of B_U)) := s_Ω.base pt_Ω
    let η_spec : PrimeSpectrum B_U := η_BU

    have hη_bot : η_spec.asIdeal = ⊥ := by
      change Ideal.comap ι_U_Ω ⊥ = ⊥
      exact (RingHom.injective_iff_ker_eq_bot ι_U_Ω).mp hInj_UΩ

    have hη_dense : ∀ (V : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of B_U))),
        IsOpen V → V.Nonempty → η_BU ∈ V := by
      intro V hV_open ⟨q, hq⟩
      let q_spec : PrimeSpectrum B_U := q
      have hle : η_spec ≤ q_spec := by
        show η_spec.asIdeal ≤ q_spec.asIdeal
        rw [hη_bot]
        exact bot_le
      have hcl : q_spec ∈ closure ({η_spec} : Set (PrimeSpectrum B_U)) :=
        (PrimeSpectrum.le_iff_mem_closure η_spec q_spec).mp hle
      obtain ⟨y, hy_V, hy_eq⟩ := mem_closure_iff.mp hcl V hV_open hq
      rw [Set.mem_singleton_iff] at hy_eq
      change η_spec ∈ V
      rwa [← hy_eq]

    haveI : AlgebraicGeometry.UniversallyOpen f_U := AlgebraicGeometry.UniversallyOpen.of_flat f_U
    have hOpen_fU : IsOpenMap f_U.base := f_U.isOpenMap

    exact
      { isPreconnected_univ := by
          intro O₁ O₂ hO₁ hO₂ hcov hne₁ hne₂
          have hη_O₁ : η_BU ∈ f_U.base '' O₁ :=
            hη_dense (f_U.base '' O₁) (hOpen_fU O₁ hO₁) ((Set.univ_inter O₁ ▸ hne₁).image _)
          have hη_O₂ : η_BU ∈ f_U.base '' O₂ :=
            hη_dense (f_U.base '' O₂) (hOpen_fU O₂ hO₂) ((Set.univ_inter O₂ ▸ hne₂).image _)
          obtain ⟨z₁, hz₁_O₁, hz₁_eq⟩ := hη_O₁
          obtain ⟨z₂, hz₂_O₂, hz₂_eq⟩ := hη_O₂
          obtain ⟨w₁, hw₁_fst, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₁ pt_Ω hz₁_eq
          obtain ⟨w₂, hw₂_fst, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback z₂ pt_Ω hz₂_eq
          have hw_cov :
              (Set.univ : Set ↥(CategoryTheory.Limits.pullback f_U s_Ω)) ⊆
                pr₁.base ⁻¹' O₁ ∪ pr₁.base ⁻¹' O₂ := by
            intro w _
            exact hcov (trivial : pr₁.base w ∈ Set.univ)
          obtain ⟨w, _, hw₁, hw₂⟩ := hConn_fib.isPreconnected_univ
            (pr₁.base ⁻¹' O₁) (pr₁.base ⁻¹' O₂)
            (hO₁.preimage pr₁.continuous) (hO₂.preimage pr₁.continuous)
            hw_cov
            ⟨w₁, trivial, by rw [Set.mem_preimage, hw₁_fst]; exact hz₁_O₁⟩
            ⟨w₂, trivial, by rw [Set.mem_preimage, hw₂_fst]; exact hz₂_O₂⟩
          exact ⟨pr₁.base w, trivial, hw₁, hw₂⟩
        toNonempty := ⟨pr₁.base (Classical.choice hConn_fib.toNonempty)⟩ }

  
  
  
  refine ⟨hConn_Zη, ?_⟩

  let S_B := AlgebraicGeometry.Spec (CommRingCat.of B_sp)
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let p_SB : S_B ⟶ S_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B_sp))
  haveI : AlgebraicGeometry.LocallyOfFiniteType p_SB :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.LocallyOfFiniteType)).mpr
      ((RingHom.finiteType_algebraMap).mpr inferInstance)
  let s_τ : S_k ⟶ S_B := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_sp.toRingHom)
  let f_Z : Z_sp ⟶ S_B := ν_Z ≫ f_sp
  haveI : AlgebraicGeometry.IsProper f_Z := inferInstance
  have hSm_fZ : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_Z := by
    change AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (ν_Z ≫ f_sp)
    infer_instance
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_Z := hSm_fZ

  let W_base := CategoryTheory.Limits.pullback ν_Z τ_sec
  let q_W_Z : W_base ⟶ Z_sp := CategoryTheory.Limits.pullback.fst ν_Z τ_sec
  let π_W : W_base ⟶ S_B := CategoryTheory.Limits.pullback.snd ν_Z τ_sec
  have hPb_W : CategoryTheory.IsPullback q_W_Z π_W ν_Z τ_sec :=
    CategoryTheory.IsPullback.of_hasPullback ν_Z τ_sec
  haveI : AlgebraicGeometry.IsFinite π_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_W inferInstance
  haveI : AlgebraicGeometry.Etale π_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_W inferInstance
  haveI : AlgebraicGeometry.Surjective π_W :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_W inferInstance
  haveI : AlgebraicGeometry.IsAffine W_base := AlgebraicGeometry.isAffine_of_isAffineHom π_W

  let F_W := CategoryTheory.Limits.pullback π_W s_τ
  let pr_FW_W : F_W ⟶ W_base := CategoryTheory.Limits.pullback.fst π_W s_τ
  let pr_FW_k : F_W ⟶ S_k := CategoryTheory.Limits.pullback.snd π_W s_τ
  have hPb_FW : CategoryTheory.IsPullback pr_FW_W pr_FW_k π_W s_τ :=
    CategoryTheory.IsPullback.of_hasPullback π_W s_τ
  haveI : AlgebraicGeometry.Etale pr_FW_k :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_FW inferInstance
  haveI : AlgebraicGeometry.Surjective pr_FW_k :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_FW inferInstance
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hNe_FW : Nonempty ↥F_W := by
    obtain ⟨w, _⟩ := pr_FW_k.surjective pt_k
    exact ⟨w⟩
  obtain ⟨σ_FW, hσ_FW⟩ :=
    (weil_algClosed_nullstellensatz_section_and_spec_constant_sheaf k).1
      F_W pr_FW_k inferInstance hNe_FW
  let s_W : S_k ⟶ W_base := σ_FW ≫ pr_FW_W
  have hs_W : s_W ≫ π_W = s_τ := by
    dsimp [s_W]
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hσ_FW, Category.id_comp]

  obtain ⟨R₀_base, instCR₀, hConn_R₀, j₀, hOpen_j₀, s₀, hs₀_j₀⟩ :=
    hClopenLoc W_base (π_W ≫ p_SB) s_W
  letI : CommRing R₀_base := instCR₀
  letI : ConnectedSpace (PrimeSpectrum R₀_base) := hConn_R₀
  letI : AlgebraicGeometry.IsOpenImmersion j₀ := hOpen_j₀
  let U'' := AlgebraicGeometry.Spec (CommRingCat.of R₀_base)
  let g_U'' : U'' ⟶ S_B := j₀ ≫ π_W
  haveI : AlgebraicGeometry.Etale g_U'' := inferInstance
  have hs₀_g : s₀ ≫ g_U'' = s_τ := by
    dsimp [g_U'']
    rw [← Category.assoc, hs₀_j₀, hs_W]

  let φ_R₀_cat : CommRingCat.of B_sp ⟶ CommRingCat.of R₀_base :=
    AlgebraicGeometry.Spec.preimage g_U''
  have hEt_map_R₀ : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_R₀_cat) := by
    rw [AlgebraicGeometry.Spec.map_preimage]
    infer_instance
  have hEt_φR₀ : RingHom.Etale φ_R₀_cat.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_map_R₀
  letI : Algebra B_sp R₀_base := φ_R₀_cat.hom.toAlgebra
  haveI : Algebra.Etale B_sp R₀_base := RingHom.Etale.toAlgebra hEt_φR₀
  haveI : IsDomain R₀_base :=
    (weil_connected_etale_dedekind_domain_and_separable_frac B_sp R₀_base).1
  haveI : AlgebraicGeometry.IsIntegral U'' := inferInstance
  haveI : AlgebraicGeometry.IsReduced U'' := inferInstance

  let Z_U'' := CategoryTheory.Limits.pullback f_Z g_U''
  let p_ZU'' : Z_U'' ⟶ Z_sp := CategoryTheory.Limits.pullback.fst f_Z g_U''
  let f_ZU'' : Z_U'' ⟶ U'' := CategoryTheory.Limits.pullback.snd f_Z g_U''
  have hPb_ZU'' : CategoryTheory.IsPullback p_ZU'' f_ZU'' f_Z g_U'' :=
    CategoryTheory.IsPullback.of_hasPullback f_Z g_U''
  haveI : AlgebraicGeometry.IsProper f_ZU'' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZU'' inferInstance
  haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_ZU'' :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZU'' inferInstance

  have hτ_comm : (j₀ ≫ q_W_Z) ≫ f_Z = 𝟙 U'' ≫ g_U'' := by
    dsimp [f_Z, g_U'']
    rw [Category.id_comp, Category.assoc, ← Category.assoc q_W_Z ν_Z f_sp,
      Limits.pullback.condition, Category.assoc π_W τ_sec f_sp, hτ_sec, Category.comp_id]
  let τ_ZU'' : U'' ⟶ Z_U'' := Limits.pullback.lift (j₀ ≫ q_W_Z) (𝟙 U'') hτ_comm
  have hτ_ZU'' : τ_ZU'' ≫ f_ZU'' = 𝟙 U'' := Limits.pullback.lift_snd _ _ _

  have hConn_et : ∀ (U : AlgebraicGeometry.Scheme.{u})
      [AlgebraicGeometry.IsAffine U] [ConnectedSpace ↥U]
      (g_U : Quiver.Hom U U'') [AlgebraicGeometry.Etale g_U],
      ConnectedSpace ↥(CategoryTheory.Limits.pullback f_ZU'' g_U) := by
    intro U _ _ g_U _
    let B_U_cat := U.presheaf.obj (Opposite.op ⊤)
    let B_U : Type u := ↑B_U_cat
    let e_U : U ≅ AlgebraicGeometry.Spec (CommRingCat.of B_U) := U.isoSpec
    have hConn_SpecBU : ConnectedSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of B_U)) :=
      hConnOfIso e_U inferInstance
    letI : ConnectedSpace (PrimeSpectrum B_U) := hConn_SpecBU

    let g_U_SB : AlgebraicGeometry.Spec (CommRingCat.of B_U) ⟶ S_B := e_U.inv ≫ g_U ≫ g_U''
    haveI : AlgebraicGeometry.Etale g_U_SB := inferInstance
    let φ_BU_cat : CommRingCat.of B_sp ⟶ CommRingCat.of B_U :=
      AlgebraicGeometry.Spec.preimage g_U_SB
    have hSpec_φBU : AlgebraicGeometry.Spec.map φ_BU_cat = g_U_SB :=
      AlgebraicGeometry.Spec.map_preimage _
    have hEt_map_BU : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ_BU_cat) := by
      rw [hSpec_φBU]
      infer_instance
    let φ_BU : B_sp →+* B_U := φ_BU_cat.hom
    have hEt_φBU : RingHom.Etale φ_BU :=
      (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_map_BU

    obtain ⟨hDom_BU, _, _, hInj_BU, hSep_BU⟩ :
        IsDomain B_U ∧ IsIntegrallyClosed B_U ∧ IsDedekindDomain B_U ∧
        Function.Injective φ_BU ∧
        (letI : Algebra B_sp B_U := φ_BU.toAlgebra
         ∀ (K₀ K : Type u) [Field K₀] [Field K]
           [Algebra B_sp K₀] [IsFractionRing B_sp K₀]
           [Algebra B_U K] [IsFractionRing B_U K]
           [Algebra K₀ K] [Algebra B_sp K]
           [IsScalarTower B_sp K₀ K] [IsScalarTower B_sp B_U K],
           FiniteDimensional K₀ K ∧ Algebra.IsSeparable K₀ K ∧ 1 ≤ Module.finrank K₀ K) := by
      letI : Algebra B_sp B_U := φ_BU.toAlgebra
      haveI : Algebra.Etale B_sp B_U := RingHom.Etale.toAlgebra hEt_φBU
      exact weil_connected_etale_dedekind_domain_and_separable_frac B_sp B_U
    letI : IsDomain B_U := hDom_BU

    have hFin_BU :
        letI : Algebra B_sp B_U := φ_BU.toAlgebra
        ∀ (K₀ K_U : Type u) [Field K₀] [Field K_U]
          [Algebra B_sp K₀] [IsFractionRing B_sp K₀]
          [Algebra B_U K_U] [IsFractionRing B_U K_U]
          [Algebra K₀ K_U] [Algebra B_sp K_U]
          [IsScalarTower B_sp K₀ K_U] [IsScalarTower B_sp B_U K_U],
          FiniteDimensional K₀ K_U := by
      letI : Algebra B_sp B_U := φ_BU.toAlgebra
      intro K₀ K_U _ _ _ _ _ _ _ _ _ _
      exact (hSep_BU K₀ K_U).1

    obtain ⟨ι_U_Ω, _, hι_comp, hTransfer⟩ :=
      hFracTransfer B_U φ_BU hInj_BU hFin_BU

    let Z_U := CategoryTheory.Limits.pullback f_ZU'' g_U
    let p_ZU : Z_U ⟶ Z_U'' := CategoryTheory.Limits.pullback.fst f_ZU'' g_U
    let f_ZU : Z_U ⟶ U := CategoryTheory.Limits.pullback.snd f_ZU'' g_U
