  have hIso_Ω_αβ : ∀ α β : Fin N_cov,
      letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
      ∃ e : TensorProduct B₁ (A₂ α β) Ω ≃+*
          ↑(Y_η.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α ⊓ W₁ β)))),
        ∀ (a : A₂ α β) (ω : Ω),
