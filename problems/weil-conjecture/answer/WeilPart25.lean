                (CategoryTheory.CategoryStruct.comp s (ρ_S a))
                ((CategoryTheory.Category.id_comp p_U).trans
                  (hs.symm.trans
                    ((congrArg (CategoryTheory.CategoryStruct.comp s) (hρ_over a)).symm.trans
                      (CategoryTheory.Category.assoc s (ρ_S a) ν_S).symm)))
            let ρ_W : ZMod ℓ → Quiver.Hom W W :=
              fun b => CategoryTheory.Limits.pullback.lift
                (CategoryTheory.Limits.pullback.fst p_U ν_S)
                (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd p_U ν_S) (ρ_S b))
                (CategoryTheory.Limits.pullback.condition.trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp (CategoryTheory.Limits.pullback.snd p_U ν_S))
                    (hρ_over b)).symm.trans
                    (CategoryTheory.Category.assoc _ (ρ_S b) ν_S).symm))
            (∀ a : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (ι a)) ∧
            (_root_.Pairwise fun a b : ZMod ℓ =>
              Disjoint (Set.range (ι a).base) (Set.range (ι b).base)) ∧
            (⋃ a : ZMod ℓ, Set.range (ι a).base) = Set.univ ∧
            (∀ a b : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ι a) (ρ_W b) = ι (a + b))) →
         (CategoryTheory.ShortComplex.mk (Δ_of ν_S) (τ_of ν_S ρ_S hρ_over hρ_act)
           (h0_of ν_S ρ_S hρ_over hρ_act)).ShortExact) ∧
      (∀ {S₁ Z₁ S₂ Z₂ : AlgebraicGeometry.Scheme.{u}}
         (ν₁ : Quiver.Hom Z₁ S₁) (ρ₁ : ZMod ℓ → Quiver.Hom Z₁ Z₁)
         (hρ₁_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ₁ a) ν₁ = ν₁)
         (hρ₁_act : ρ₁ 0 = CategoryTheory.CategoryStruct.id Z₁ ∧
           ∀ a b : ZMod ℓ, ρ₁ (a + b) = CategoryTheory.CategoryStruct.comp (ρ₁ a) (ρ₁ b))
         (ν₂ : Quiver.Hom Z₂ S₂) (ρ₂ : ZMod ℓ → Quiver.Hom Z₂ Z₂)
         (hρ₂_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ₂ a) ν₂ = ν₂)
         (hρ₂_act : ρ₂ 0 = CategoryTheory.CategoryStruct.id Z₂ ∧
           ∀ a b : ZMod ℓ, ρ₂ (a + b) = CategoryTheory.CategoryStruct.comp (ρ₂ a) (ρ₂ b))
         (h : Quiver.Hom S₁ S₂) (p_Z : Quiver.Hom Z₁ Z₂),
         CategoryTheory.CategoryStruct.comp p_Z ν₂ = CategoryTheory.CategoryStruct.comp ν₁ h →
         (∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ₁ a) p_Z =
           CategoryTheory.CategoryStruct.comp p_Z (ρ₂ a)) →
         letI : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
           hc_all h
         letI : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
           S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint := hr_all h
         let B_h := weilEtaleSitePullback h
         let pb_h := B_h.sheafPullback AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
         let adj_h := B_h.sheafAdjunctionContinuous AddCommGrpCat.{u} S₂.smallEtaleTopology S₁.smallEtaleTopology
         let β_L : Quiver.Hom (pb_h.obj (L_of S₂)) (L_of S₁) :=
           (adj_h.homEquiv (L_of S₂) (L_of S₁)).symm { hom := weilAltLocConstPullbackNat h ℓ }
         ∃ (β_P : Quiver.Hom (pb_h.obj (P_of ν₂)) (P_of ν₁))
           (β_Q : Quiver.Hom (pb_h.obj (Q_of ν₂ ρ₂ hρ₂_over hρ₂_act))
             (Q_of ν₁ ρ₁ hρ₁_over hρ₁_act)),
           CategoryTheory.CategoryStruct.comp (pb_h.map (Δ_of ν₂)) β_P =
             CategoryTheory.CategoryStruct.comp β_L (Δ_of ν₁) ∧
           CategoryTheory.CategoryStruct.comp (pb_h.map (τ_of ν₂ ρ₂ hρ₂_over hρ₂_act)) β_Q =
