      rw [← h1]
      exact p.2
    have hNe_Udiff : (Set.univ ∩ U_diff).Nonempty :=
      ⟨y, trivial, ⟨⟨y, hyQ⟩, hq_not_range, rfl⟩⟩
    let y_x := P.e_W.hom.base P.x
    have hNe_Wopen : (Set.univ ∩ (P.W_open : Set ↥P.Y)).Nonempty :=
      ⟨y_x.1, trivial, y_x.2⟩
    obtain ⟨z, -, hz_W, ⟨q, hq_compl, hq_eq⟩⟩ :=
      hIrred_PY.isIrreducible_univ.isPreirreducible
        (P.W_open : Set ↥P.Y) U_diff P.W_open.isOpen hOpen_Udiff hNe_Wopen hNe_Udiff
    apply hq_compl
    refine ⟨(⟨z, hz_W⟩ : ↥P.W_open.toScheme), Q_open.ι.isOpenEmbedding.injective ?_⟩
    change (j_WQ ≫ Q_open.ι).base ⟨z, hz_W⟩ = Q_open.ι.base q
    rw [hj_WQ_ι]
    exact hq_eq.symm

  
  let Y₁_V₂ := CategoryTheory.Limits.pullback E.f_bar₁ g_V₂_sch
  let p₁_Y := CategoryTheory.Limits.pullback.fst E.f_bar₁ g_V₂_sch
  let f₁_V₂ := CategoryTheory.Limits.pullback.snd E.f_bar₁ g_V₂_sch
  let W₁_V₂_open : Y₁_V₂.Opens := (TopologicalSpace.Opens.map p₁_Y.base).obj E.W₁_open
  let W₁_V₂_et : Y₁_V₂.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ W₁_V₂_open.ι inferInstance

  let Y₂_V₂ := CategoryTheory.Limits.pullback P.f_bar h₂_sch
  let p₂_Y := CategoryTheory.Limits.pullback.fst P.f_bar h₂_sch
  let f₂_V₂ := CategoryTheory.Limits.pullback.snd P.f_bar h₂_sch
  let W₂_V₂_open : Y₂_V₂.Opens := (TopologicalSpace.Opens.map p₂_Y.base).obj P.W_open
  let W₂_V₂_et : Y₂_V₂.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ W₂_V₂_open.ι inferInstance

  have hComm_ν₂ : (p₂_Y ≫ P.π_Y₁) ≫ E.f_bar₁ = f₂_V₂ ≫ g_V₂_sch := by
    rw [CategoryTheory.Category.assoc, P.hComm_Y₁, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hg_V₂_eq]
  let ν₂ : Y₂_V₂ ⟶ Y₁_V₂ :=
    CategoryTheory.Limits.pullback.lift (p₂_Y ≫ P.π_Y₁) f₂_V₂ hComm_ν₂
  have hν₂_p₁ : ν₂ ≫ p₁_Y = p₂_Y ≫ P.π_Y₁ :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hν₂_f : ν₂ ≫ f₁_V₂ = f₂_V₂ :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _

  let P_rel := CategoryTheory.Limits.pullback E.f_bar₁ g_VP
  let φ_rel : P.Y ⟶ P_rel :=
    CategoryTheory.Limits.pullback.lift P.π_Y₁ P.f_bar P.hComm_Y₁
  haveI : AlgebraicGeometry.IsFinite φ_rel := P.hFin_rel
  let ψ_base : Y₁_V₂ ⟶ P_rel :=
    CategoryTheory.Limits.pullback.lift p₁_Y (f₁_V₂ ≫ h₂_sch)
      ((CategoryTheory.Limits.pullback.condition (f := E.f_bar₁) (g := g_V₂_sch)).trans
        ((congrArg (fun m => f₁_V₂ ≫ m) hg_V₂_eq).trans
          (CategoryTheory.Category.assoc f₁_V₂ h₂_sch g_VP).symm))
  have hPb_ψ : CategoryTheory.IsPullback ψ_base f₁_V₂
      (CategoryTheory.Limits.pullback.snd E.f_bar₁ g_VP) h₂_sch := by
    have hPb_outer : CategoryTheory.IsPullback
