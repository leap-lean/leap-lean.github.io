      have h_agree : ∀ {Y₁ Y₂ : S.Etale} {f₁ : Y₁ ⟶ U} {f₂ : Y₂ ⟶ U}
          (hf₁ : R.arrows f₁) (hf₂ : R.arrows f₂)
          (y₁ : ↥Y₁.left) (y₂ : ↥Y₂.left),
          f₁.left y₁ = f₂.left y₂ →
          LocallyConstant.toFun (X := ↥Y₁.left) (Y := AM_type) (sf f₁ hf₁) y₁ =
            LocallyConstant.toFun (X := ↥Y₂.left) (Y := AM_type) (sf f₂ hf₂) y₂ := by
        intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
        have : AlgebraicGeometry.Etale f₁.left := hEt_map f₁
        have : AlgebraicGeometry.Etale f₂.left := hEt_map f₂
        have : AlgebraicGeometry.Etale Y₁.hom := Y₁.prop
        obtain ⟨z, hz₁_raw, hz₂_raw⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
