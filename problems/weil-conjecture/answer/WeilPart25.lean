    have h_counit_Δ : j_pW.map Δ_W ≫
        (CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ p_W V₀.prop
          trivial).counit.app V₀ = u_id := by
      have hcounit_left :
          ((CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ p_W V₀.prop
            trivial).counit.app V₀).left =
          CategoryTheory.Limits.pullback.fst V₀.hom p_W :=
        congrArg (fun m : j_pW.obj (B_pW.obj V₀) ⟶ V₀ => m.left)
          (CategoryTheory.MorphismProperty.Over.mapPullbackAdj_counit_app
            P_et ⊤ p_W V₀.prop trivial V₀)
      have hleft : (j_pW.map Δ_W ≫
          (CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ p_W V₀.prop
            trivial).counit.app V₀).left = u_id.left :=
        (congrArg (Δ_W.left ≫ ·) hcounit_left).trans
          (CategoryTheory.Limits.pullback.lift_fst (𝟙 X_W) (𝟙 X_W) rfl)
      exact CategoryTheory.MorphismProperty.Comma.Hom.ext hleft (Subsingleton.elim _ _)
    have hnat := ConcreteCategory.congr_hom
      ((e_res_pW.hom.app Q).hom.naturality (Opposite.op Δ_W))
      (((adj_pW.unit.app Q).hom.app (Opposite.op V₀)).hom q₀)
    have hu_V₀ := ConcreteCategory.congr_hom (he_res_unit Q V₀) q₀
    have hmap_counit : Q.obj.map
        (Opposite.op ((CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ p_W V₀.prop
          trivial).counit.app V₀)) ≫
        Q.obj.map (Opposite.op (j_pW.map Δ_W)) =
        Q.obj.map (Opposite.op u_id) :=
      (Q.obj.map_comp _ _).symm.trans
        (congrArg (fun m => Q.obj.map (Opposite.op m)) h_counit_Δ)
    exact hnat.trans
      ((congrArg (Q.obj.map (Opposite.op (j_pW.map Δ_W))).hom hu_V₀).trans
        (ConcreteCategory.congr_hom hmap_counit q₀))

  let j_U₂ : ↥(J_ab.obj.obj (Opposite.op (j_pW.obj (B_fW.obj U₂)))) :=
    ((e_res_pW.hom.app J_ab).hom.app (Opposite.op (B_fW.obj U₂))).hom
      ((pr₁.hom.app (Opposite.op (B_fW.obj U₂))).hom e₂)
  have hv_jU₂ : (v_F.hom.app (Opposite.op (j_pW.obj (B_fW.obj U₂)))).hom j_U₂ =
      (Q.obj.map (Opposite.op (j_pW.map u_U₂ ≫ u_id))).hom q₀ := by
    have hnat_v := ConcreteCategory.congr_hom
      (CategoryTheory.NatTrans.congr_app
        (congrArg (fun m => m.hom) (e_res_pW.hom.naturality v_F))
        (Opposite.op (B_fW.obj U₂)))
      ((pr₁.hom.app (Opposite.op (B_fW.obj U₂))).hom e₂)
    have hnat_u := ConcreteCategory.congr_hom
      ((e_res_pW.hom.app Q).hom.naturality (Opposite.op u_U₂)) q_W_elem
    have hmap_u : Q.obj.map (Opposite.op u_id) ≫ Q.obj.map (Opposite.op (j_pW.map u_U₂)) =
        Q.obj.map (Opposite.op (j_pW.map u_U₂ ≫ u_id)) :=
      (Q.obj.map_comp _ _).symm
    exact hnat_v.symm.trans
      ((congrArg ((e_res_pW.hom.app Q).hom.app (Opposite.op (B_fW.obj U₂))).hom hv_e₂).trans
        (hnat_u.trans
          ((congrArg (Q.obj.map (Opposite.op (j_pW.map u_U₂))).hom hqW_res).trans
            (ConcreteCategory.congr_hom hmap_u q₀))))

  have hEt_W' : AlgebraicGeometry.Etale (U₂.hom ≫ W.hom) :=
    CategoryTheory.MorphismProperty.comp_mem P_et U₂.hom W.hom U₂.prop W.prop
  let W' : S.left.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (U₂.hom ≫ W.hom) hEt_W'
  let g_W : W' ⟶ W := CategoryTheory.MorphismProperty.Over.homMk U₂.hom rfl trivial
  have h_lift_φW' :
      CategoryTheory.Limits.pullback.fst W'.hom f.left ≫ U₂.hom =
        (B_f.map g_W).left ≫ f_W :=
    ((congrArg (· ≫ f_W)
      (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ f.left g_W)).trans
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)).symm
  let φ_W' : B_f.obj W' ⟶ j_pW.obj (B_fW.obj U₂) :=
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst W'.hom f.left)
        (B_f.map g_W).left h_lift_φW')
      ((CategoryTheory.Category.assoc _
        (CategoryTheory.Limits.pullback.snd U₂.hom f_W) p_W).symm.trans
        ((congrArg (· ≫ p_W) (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
          (CategoryTheory.MorphismProperty.Over.w (B_f.map g_W))))
      trivial
  have hφ_W'_comp : φ_W' ≫ j_pW.map u_U₂ ≫ u_id = B_f.map g_W :=
    CategoryTheory.MorphismProperty.Comma.Hom.ext
      ((congrArg (φ_W'.left ≫ ·) (CategoryTheory.MorphismProperty.Over.w u_U₂)).trans
        (CategoryTheory.Limits.pullback.lift_snd _ _ _))
      (Subsingleton.elim _ _)

  let j_W' : ↥((pf_f.obj J_ab).obj.obj (Opposite.op W')) :=
    (J_ab.obj.map (Opposite.op φ_W')).hom j_U₂
  have hv_jW' : ((pf_f.map v_F).hom.app (Opposite.op W')).hom j_W' =
      ((pf_f.obj Q).obj.map (Opposite.op g_W)).hom q₀ := by
    have hnat : ((pf_f.map v_F).hom.app (Opposite.op W')).hom j_W' =
        (Q.obj.map (Opposite.op φ_W')).hom
          ((v_F.hom.app (Opposite.op (j_pW.obj (B_fW.obj U₂)))).hom j_U₂) :=
      ConcreteCategory.congr_hom (v_F.hom.naturality (Opposite.op φ_W')) j_U₂
    have hmap_φ : Q.obj.map (Opposite.op (j_pW.map u_U₂ ≫ u_id)) ≫
        Q.obj.map (Opposite.op φ_W') =
        Q.obj.map (Opposite.op (B_f.map g_W)) :=
      (Q.obj.map_comp _ _).symm.trans
        (congrArg (fun m => Q.obj.map (Opposite.op m)) hφ_W'_comp)
    have hmap_φ_app : (Q.obj.map (Opposite.op φ_W')).hom
        ((Q.obj.map (Opposite.op (j_pW.map u_U₂ ≫ u_id))).hom q₀) =
        ((pf_f.obj Q).obj.map (Opposite.op g_W)).hom q₀ :=
      ConcreteCategory.congr_hom hmap_φ q₀
    exact hnat.trans
      ((congrArg (Q.obj.map (Opposite.op φ_W')).hom hv_jU₂).trans hmap_φ_app)

  have hδ₀_gW_zero : (R1F.obj.map (Opposite.op g_W)).hom ((δ₀.hom.app (Opposite.op W)).hom q₀) = 0 := by
    have hnat := ConcreteCategory.congr_hom (δ₀.hom.naturality (Opposite.op g_W)) q₀
    have hv0 := ConcreteCategory.congr_hom
      (CategoryTheory.NatTrans.congr_app (congrArg (fun m => m.hom) hv_δ₀)
        (Opposite.op W')) j_W'
    exact hnat.symm.trans
      ((congrArg (δ₀.hom.app (Opposite.op W')).hom hv_jW'.symm).trans hv0)

  have hτ₂_w : τ₂.left ≫ CategoryTheory.Limits.pullback.snd U₂.hom z_W = 𝟙 S_k :=
    CategoryTheory.MorphismProperty.Over.w τ₂
  have h_zW : (τ₂.left ≫ CategoryTheory.Limits.pullback.fst U₂.hom z_W) ≫ U₂.hom = z_W :=
    (CategoryTheory.Category.assoc τ₂.left _ U₂.hom).trans
      ((congrArg (CategoryTheory.CategoryStruct.comp τ₂.left)
        (CategoryTheory.Limits.pullback.condition (f := U₂.hom) (g := z_W))).trans
        ((CategoryTheory.Category.assoc τ₂.left _ z_W).symm.trans
          ((congrArg (fun m => m ≫ z_W) hτ₂_w).trans
            (CategoryTheory.Category.id_comp z_W))))
  have h_τW'_cond :
      (τ₂.left ≫ CategoryTheory.Limits.pullback.fst U₂.hom z_W) ≫ W'.hom =
        𝟙 S_k ≫ s_b :=
    (CategoryTheory.Category.assoc _ U₂.hom W.hom).symm.trans
      ((congrArg (· ≫ W.hom) h_zW).trans
        (hz_W.trans (CategoryTheory.Category.id_comp s_b).symm))
  let τ_W' : T_k ⟶ B_s.obj W' :=
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift
        (τ₂.left ≫ CategoryTheory.Limits.pullback.fst U₂.hom z_W) (𝟙 S_k) h_τW'_cond)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
  have hτ_W'_comp : τ_W' ≫ B_s.map g_W = τ_W := by
    have hw_τW' : (τ_W' ≫ B_s.map g_W).left ≫ (B_s.obj W).hom = 𝟙 S_k :=
      CategoryTheory.MorphismProperty.Over.w (P := P_et) (τ_W' ≫ B_s.map g_W)
    have hmap_fst : (B_s.map g_W).left ≫ CategoryTheory.Limits.pullback.fst W.hom s_b =
        CategoryTheory.Limits.pullback.fst W'.hom s_b ≫ U₂.hom :=
      (congrArg (fun m => m ≫ CategoryTheory.Limits.pullback.fst W.hom s_b)
        (CategoryTheory.MorphismProperty.Over.pullback_map_left P_et ⊤ s_b g_W)).trans
        (CategoryTheory.Limits.pullback.lift_fst _ _ _)
    refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Category.assoc τ_W'.left _ _).trans
        ((congrArg (CategoryTheory.CategoryStruct.comp τ_W'.left) hmap_fst).trans
          ((CategoryTheory.Category.assoc τ_W'.left _ U₂.hom).symm.trans
            ((congrArg (fun m => m ≫ U₂.hom)
              (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans h_zW)))
    · exact hw_τW'.trans hτ_w.symm

  have hmap_τW : (pb_s.obj R1F).obj.map (Opposite.op τ_W) =
      (pb_s.obj R1F).obj.map (Opposite.op (B_s.map g_W)) ≫
        (pb_s.obj R1F).obj.map (Opposite.op τ_W') :=
    (congrArg (fun m => (pb_s.obj R1F).obj.map (Opposite.op m)) hτ_W'_comp.symm).trans
      ((pb_s.obj R1F).obj.map_comp _ _)
  have hnat_u := ConcreteCategory.congr_hom
    ((adj_s.unit.app R1F).hom.naturality (Opposite.op g_W))
    ((δ₀.hom.app (Opposite.op W)).hom q₀)
  refine hξ_rep.trans ?_
  refine (ConcreteCategory.congr_hom hmap_τW
    (((adj_s.unit.app R1F).hom.app (Opposite.op W)).hom
      ((δ₀.hom.app (Opposite.op W)).hom q₀))).trans ?_
  change ((pb_s.obj R1F).obj.map (Opposite.op τ_W')).hom
    (((pb_s.obj R1F).obj.map (Opposite.op (B_s.map g_W))).hom
      (((adj_s.unit.app R1F).hom.app (Opposite.op W)).hom
        ((δ₀.hom.app (Opposite.op W)).hom q₀))) = 0
  refine (congrArg ((pb_s.obj R1F).obj.map (Opposite.op τ_W')).hom hnat_u.symm).trans ?_
  let f_kill := (((adj_s.unit.app R1F).hom.app (Opposite.op W')) ≫
    (pb_s.obj R1F).obj.map (Opposite.op τ_W')).hom
  exact (congrArg f_kill hδ₀_gW_zero).trans (map_zero f_kill)

theorem weil_etale_proper_closedPt_conservativity_and_r1_localTorsion_fiber_iff (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    (f : Quiver.Hom X S)
    (hf : AlgebraicGeometry.IsProper f.left)
    (U₂ U₁ : X.left.Etale)
    (u : Quiver.Hom U₂ U₁) :
    (∀ (s_b : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) S.left)
        (X_b : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_b : Quiver.Hom X_b.left X.left),
      CategoryTheory.CategoryStruct.comp s_b S.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      CategoryTheory.IsPullback ι_b X_b.hom f.left s_b →
      Subsingleton (weilEtaleLocalTorsionH X_b.left ℓ ((weilEtaleSitePullback ι_b).obj U₁) 0) →
      weilEtaleLocalTorsionMapH X_b.left ℓ ((weilEtaleSitePullback ι_b).map u) 1 = 0 →
      ∃ (_hc : (weilEtaleSitePullback s_b).IsContinuous
          S.left.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology)
        (_hr : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback s_b) AddCommGrpCat.{u} _
          S.left.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology _hc).IsRightAdjoint),
        (@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback s_b) AddCommGrpCat.{u} _
          S.left.smallEtaleTopology
          (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology _hc _hr).map
          (weilEtaleHigherDirectImageMap f.left 1 (weilEtaleLocalTorsionMap X.left ℓ u)) = 0) ∧
    (∀ (s_b : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) S.left)
        (X_b : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
        (ι_b : Quiver.Hom X_b.left X.left),
      CategoryTheory.CategoryStruct.comp s_b S.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      CategoryTheory.IsPullback ι_b X_b.hom f.left s_b →
      Subsingleton (weilEtaleLocalTorsionH X_b.left ℓ ((weilEtaleSitePullback ι_b).obj U₂) 0) →
      (∃ A₂ : AddCommGrpCat.{u},
        Finite A₂ ∧
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.constantSheaf S.left.smallEtaleTopology AddCommGrpCat.{u}).obj A₂)
          (weilEtaleHigherDirectImage f.left 1 (weilEtaleLocalTorsionSheaf X.left ℓ U₂)))) →
      weilEtaleHigherDirectImageMap f.left 1 (weilEtaleLocalTorsionMap X.left ℓ u) = 0 →
      weilEtaleLocalTorsionMapH X_b.left ℓ ((weilEtaleSitePullback ι_b).map u) 1 = 0) ∧
    ((∀ (s_b : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) S.left),
        CategoryTheory.CategoryStruct.comp s_b S.hom =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        let X_b : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f.left s_b)
        let ι_b : Quiver.Hom X_b.left X.left :=
          CategoryTheory.Limits.pullback.fst f.left s_b
        Subsingleton (weilEtaleLocalTorsionH X_b.left ℓ ((weilEtaleSitePullback ι_b).obj U₁) 0) ∧
        weilEtaleLocalTorsionMapH X_b.left ℓ ((weilEtaleSitePullback ι_b).map u) 1 = 0) →
      weilEtaleHigherDirectImageMap f.left 1 (weilEtaleLocalTorsionMap X.left ℓ u) = 0) :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k : S_k.Etale := weilEtaleIdTerminal.{u} S_k

  
  obtain ⟨hSite, _, hTorU, hRes, _, _⟩ :=
    weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  let hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    fun h => Classical.choose (hSite h)
  let hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h)).IsRightAdjoint :=
    fun h => Classical.choose (Classical.choose_spec (hSite h))
  have hPbExact : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      letI := @hc_all Z₁ Z₂ h
      letI := @hr_all Z₁ Z₂ h
      let pb := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      CategoryTheory.Limits.PreservesFiniteLimits pb ∧ pb.Additive := by
    intro Z₁ Z₂ h
    have hs := Classical.choose_spec (Classical.choose_spec (hSite h))
    exact ⟨hs.1, hs.2.1⟩
  have hPfAdd : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h)).Additive := by
    intro Z₁ Z₂ h
    exact (Classical.choose_spec (Classical.choose_spec (hSite h))).2.2

  have hInjRes : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ∃ (J_ab Q : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        (u_F : Quiver.Hom F J_ab) (v_F : Quiver.Hom J_ab Q)
        (huv : CategoryTheory.CategoryStruct.comp u_F v_F = 0),
        ℓ • CategoryTheory.CategoryStruct.id J_ab = 0 ∧
        ℓ • CategoryTheory.CategoryStruct.id Q = 0 ∧
        (CategoryTheory.ShortComplex.mk u_F v_F huv).ShortExact ∧
        ∀ {B : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom Z B),
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g 1 J_ab) := by
    intro Z F hF_tor
    obtain ⟨I, hInjI, Q, u_F, v_F, huv, hQ_tor, hSE⟩ := hRes Z F hF_tor
    letI : CategoryTheory.Injective I := hInjI
    let U_sh_Z := CategoryTheory.Sheaf.composeAndSheafify Z.smallEtaleTopology
      (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ))) AddCommGrpCat.{u})
    refine ⟨U_sh_Z.obj I, Q, u_F, v_F, huv, hTorU Z I, hQ_tor, hSE, ?_⟩
    intro B g
    exact weil_etale_mod_prime_injective_higherDirectImage_isZero.{u} ℓ g I 1 (le_refl 1)

  have hR0Iso : ∀ {Z B : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom Z B),
      letI := @hc_all Z B g
      ∀ (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty (CategoryTheory.Iso
          (weilEtaleHigherDirectImage g 0 G)
          (((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
            B.smallEtaleTopology Z.smallEtaleTopology).obj G)) := by
    intro Z B g G
    letI := @hc_all Z B g
    exact (weil_etale_higherDirectImage_shortExact_calculus.{u} g).2.1 G

  
  obtain ⟨hSkUnitIso, hSkFaith, hFibEval, hStalkColim₀⟩ :=
    weil_etale_algClosed_spec_unit_iso_and_stalk_colimit k
  have hStalkColim :
      ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (z : Quiver.Hom S_k Z)
        (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        letI := @hc_all S_k Z z
        letI := @hr_all S_k Z z
        let pb_z := (weilEtaleSitePullback z).sheafPullback AddCommGrpCat.{u}
          Z.smallEtaleTopology S_k.smallEtaleTopology
        let adj_z := (weilEtaleSitePullback z).sheafAdjunctionContinuous AddCommGrpCat.{u}
          Z.smallEtaleTopology S_k.smallEtaleTopology
        (∀ (x : ↥((pb_z.obj G).obj.obj (Opposite.op T_k))),
          ∃ (W : Z.Etale)
            (τ_W : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W))
            (s : ↥(G.obj.obj (Opposite.op W))),
            ((pb_z.obj G).obj.map (Opposite.op τ_W)).hom
              (((adj_z.unit.app G).hom.app (Opposite.op W)).hom s) = x) ∧
        (∀ (W : Z.Etale)
            (τ_W : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W))
            (s : ↥(G.obj.obj (Opposite.op W))),
          ((pb_z.obj G).obj.map (Opposite.op τ_W)).hom
            (((adj_z.unit.app G).hom.app (Opposite.op W)).hom s) = 0 →
          ∃ (W' : Z.Etale) (g : Quiver.Hom W' W)
            (τ_W' : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W')),
            CategoryTheory.CategoryStruct.comp τ_W' ((weilEtaleSitePullback z).map g) = τ_W ∧
            (G.obj.map (Opposite.op g)).hom s = 0) :=
    fun Z z G => @hStalkColim₀ Z z (@hc_all S_k Z z) (@hr_all S_k Z z) G

  obtain ⟨hH0Fin, hTorBoth, hConstPullIso₀, hLocPull₀⟩ :=
    weil_etale_proper_h0_finite_and_localTorsion_pullback_iso k ℓ
  have hConstPullIso : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
      (A : AddCommGrpCat.{u}),
      letI := @hc_all Z₁ Z₂ h
      letI := @hr_all Z₁ Z₂ h
      CategoryTheory.IsIso
        (weilEtaleConstPullbackHom h
          (weilEtaleIdTerminalIsTerminal.{u} Z₁)
