    have hcomm_inv : pf_f₁.map (pf_ν.map v) ≫ eB.inv = eA.inv ≫ pf_f₂.map v := by
      rw [← CategoryTheory.Category.id_comp (pf_f₁.map (pf_ν.map v) ≫ eB.inv),
