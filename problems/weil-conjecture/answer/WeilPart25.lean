  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))

  
  have hMapExtComp : ∀ {𝒞₁ 𝒞₂ 𝒞₃ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1} 𝒞₁] [CategoryTheory.Abelian 𝒞₁]
      [CategoryTheory.EnoughInjectives 𝒞₁] [CategoryTheory.HasExt.{u} 𝒞₁]
      [CategoryTheory.Category.{u + 1} 𝒞₂] [CategoryTheory.Abelian 𝒞₂]
      [CategoryTheory.HasExt.{u} 𝒞₂]
      [CategoryTheory.Category.{u + 1} 𝒞₃] [CategoryTheory.Abelian 𝒞₃]
      [CategoryTheory.HasExt.{u} 𝒞₃]
      (F : CategoryTheory.Functor 𝒞₁ 𝒞₂) (G : CategoryTheory.Functor 𝒞₂ 𝒞₃)
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (q : ℕ) (X Y : 𝒞₁) (x : CategoryTheory.Abelian.Ext X Y q),
      ((CategoryTheory.Functor.comp F G).mapExtAddHom X Y q) x =
        (G.mapExtAddHom (F.obj X) (F.obj Y) q) ((F.mapExtAddHom X Y q) x) := by
    intro 𝒞₁ 𝒞₂ 𝒞₃ _ _ _ _ _ _ _ _ _ _ F G _ _ _ _ _ _ q X
    induction q with
    | zero =>
      intro Y x
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        CategoryTheory.Functor.mapExtAddHom_apply,
        ← CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀]
      rfl
    | succ k ih =>
      intro Y x
      let ι : Y ⟶ CategoryTheory.Injective.under Y := CategoryTheory.Injective.ι Y
      have hS : (CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)).ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' (CategoryTheory.ShortComplex.exact_cokernel ι)
          (CategoryTheory.Injective.ι_mono Y) inferInstance
      let S := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hzero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      rw [← hz,
        CategoryTheory.Functor.mapExtAddHom_apply (CategoryTheory.Functor.comp F G) X Y (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ← CategoryTheory.Functor.mapExtAddHom_apply (CategoryTheory.Functor.comp F G) X S.X₃ k,
        ih S.X₃ z,
        CategoryTheory.Functor.mapExtAddHom_apply F X Y (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ← CategoryTheory.Functor.mapExtAddHom_apply F X S.X₃ k,
        CategoryTheory.Functor.mapExtAddHom_apply G (F.obj X) (F.obj Y) (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ← CategoryTheory.Functor.mapExtAddHom_apply G (F.obj X) (F.obj S.X₃) k]

  have hMapExtNat : ∀ {𝒞₁ 𝒞₂ : Type (u + 1)}
      [CategoryTheory.Category.{u + 1} 𝒞₁] [CategoryTheory.Abelian 𝒞₁]
      [CategoryTheory.EnoughInjectives 𝒞₁] [CategoryTheory.HasExt.{u} 𝒞₁]
      [CategoryTheory.Category.{u + 1} 𝒞₂] [CategoryTheory.Abelian 𝒞₂]
      [CategoryTheory.HasExt.{u} 𝒞₂]
      {F G : CategoryTheory.Functor 𝒞₁ 𝒞₂}
      [F.Additive] [CategoryTheory.Limits.PreservesFiniteLimits F]
      [CategoryTheory.Limits.PreservesFiniteColimits F]
      [G.Additive] [CategoryTheory.Limits.PreservesFiniteLimits G]
      [CategoryTheory.Limits.PreservesFiniteColimits G]
      (η : F ⟶ G) (q : ℕ) (X Y : 𝒞₁) (x : CategoryTheory.Abelian.Ext X Y q),
      ((F.mapExtAddHom X Y q) x).comp (CategoryTheory.Abelian.Ext.mk₀ (η.app Y)) (Nat.add_zero q) =
        (CategoryTheory.Abelian.Ext.mk₀ (η.app X)).comp
          ((G.mapExtAddHom X Y q) x) (Nat.zero_add q) := by
    intro 𝒞₁ 𝒞₂ _ _ _ _ _ _ _ F G _ _ _ _ _ _ η q X
    induction q with
    | zero =>
      intro Y x
      rw [CategoryTheory.Functor.mapExtAddHom_apply, CategoryTheory.Functor.mapExtAddHom_apply,
        ← CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        η.naturality]
    | succ k ih =>
      intro Y x
      let ι : Y ⟶ CategoryTheory.Injective.under Y := CategoryTheory.Injective.ι Y
      have hS : (CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
          (CategoryTheory.Limits.cokernel.condition ι)).ShortExact :=
        CategoryTheory.ShortComplex.ShortExact.mk' (CategoryTheory.ShortComplex.exact_cokernel ι)
          (CategoryTheory.Injective.ι_mono Y) inferInstance
      let S := CategoryTheory.ShortComplex.mk ι (CategoryTheory.Limits.cokernel.π ι)
        (CategoryTheory.Limits.cokernel.condition ι)
      have hzero : x.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (Nat.add_zero (k + 1)) = 0 :=
        CategoryTheory.Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS x hzero rfl
      let φ_η : S.map F ⟶ S.map G :=
        { τ₁ := η.app S.X₁
          τ₂ := η.app S.X₂
          τ₃ := η.app S.X₃
          comm₁₂ := (η.naturality S.f).symm
          comm₂₃ := (η.naturality S.g).symm }
      have h_ext_nat : (hS.map_of_exact F).extClass.comp
          (CategoryTheory.Abelian.Ext.mk₀ (η.app Y)) (Nat.add_zero 1) =
          (CategoryTheory.Abelian.Ext.mk₀ (η.app S.X₃)).comp
            (hS.map_of_exact G).extClass (Nat.zero_add 1) :=
        CategoryTheory.ShortComplex.ShortExact.extClass_naturality
          (hS.map_of_exact F) (hS.map_of_exact G) φ_η
      rw [← hz, CategoryTheory.Functor.mapExtAddHom_apply F X Y (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ← CategoryTheory.Functor.mapExtAddHom_apply F X S.X₃ k,
        CategoryTheory.Functor.mapExtAddHom_apply G X Y (k + 1),
        CategoryTheory.Abelian.Ext.mapExactFunctor_comp,
        CategoryTheory.Abelian.Ext.mapExactFunctor_extClass,
        ← CategoryTheory.Functor.mapExtAddHom_apply G X S.X₃ k,
        CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        h_ext_nat,
        ← CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.add_zero k) (Nat.zero_add 1) (by omega),
        ih S.X₃ z,
        CategoryTheory.Abelian.Ext.comp_assoc _ _ _ (Nat.zero_add k) rfl (Nat.zero_add (k + 1))]

  
  have hEquiv_comp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {W_et : S.Etale}
        {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S ℓ W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro S W_et F G α g
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  
  have hLeftAdjSymm : ∀ {𝒞 𝒟 : Type (u + 1)}
      [CategoryTheory.Category.{u + 1} 𝒞] [CategoryTheory.Category.{u + 1} 𝒟]
      {F₁ F₂ : CategoryTheory.Functor 𝒞 𝒟} {G : CategoryTheory.Functor 𝒟 𝒞}
      (adj₁ : F₁ ⊣ G) (adj₂ : F₂ ⊣ G) {X : 𝒞} {Y : 𝒟} (g : X ⟶ G.obj Y),
      (adj₁.homEquiv X Y).symm g =
        (adj₁.leftAdjointUniq adj₂).hom.app X ≫ (adj₂.homEquiv X Y).symm g := by
    intro 𝒞 𝒟 _ _ F₁ F₂ G adj₁ adj₂ X Y g
    apply (adj₁.homEquiv X Y).injective
    rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit, G.map_comp,
      ← CategoryTheory.Category.assoc,
      CategoryTheory.Adjunction.unit_leftAdjointUniq_hom_app,
      ← CategoryTheory.Adjunction.homEquiv_unit, Equiv.apply_symm_apply]

  let uConst : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
      [hCont : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
      (A : AddCommGrpCat.{u}),
      ((CategoryTheory.constantSheaf S₂.smallEtaleTopology AddCommGrpCat.{u}).obj A) ⟶
        ((@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          S₂.smallEtaleTopology S₁.smallEtaleTopology hCont).obj
          ((CategoryTheory.constantSheaf S₁.smallEtaleTopology AddCommGrpCat.{u}).obj A)) :=
    fun {S₁ S₂} h hCont A =>
      let B := weilEtaleSitePullback h
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ J₂ J₁ hCont
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let P_A₁ := (CategoryTheory.Functor.const (Opposite S₁.Etale)).obj A
      let P_A₂ := (CategoryTheory.Functor.const (Opposite S₂.Etale)).obj A
      let sh₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
      let sh₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
      (sh₂.homEquiv P_A₂ (P_push.obj (C₁.obj A))).symm
        (CategoryTheory.Functor.whiskerLeft B.op (sh₁.unit.app P_A₁))

  have hConstUnitEq : ∀ {S₁ S₂ : AlgebraicGeometry.Scheme.{u}} (h : S₁ ⟶ S₂)
      [hCont : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology]
      {T₁ : S₁.Etale} (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
      {T₂ : S₂.Etale} (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
      (A : AddCommGrpCat.{u}),
      let B := weilEtaleSitePullback h
      let J₁ := S₁.smallEtaleTopology
      let J₂ := S₂.smallEtaleTopology
      let P_push := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        B AddCommGrpCat.{u} _ J₂ J₁ hCont
      let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
      let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
      let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
      (adj₂.homEquiv A (P_push.obj (C₁.obj A))).symm
        (adj₁.unit.app A ≫ (C₁.obj A).obj.map (hT₁.from (B.obj T₂)).op) =
      @uConst S₁ S₂ h hCont A := by
    intro S₁ S₂ h hCont T₁ hT₁ T₂ hT₂ A B J₁ J₂ P_push C₁ adj₁ adj₂
    let P_A₁ := (CategoryTheory.Functor.const (Opposite S₁.Etale)).obj A
    let P_A₂ := (CategoryTheory.Functor.const (Opposite S₂.Etale)).obj A
    let sh₁ := CategoryTheory.sheafificationAdjunction J₁ AddCommGrpCat.{u}
    let sh₂ := CategoryTheory.sheafificationAdjunction J₂ AddCommGrpCat.{u}
    apply (adj₂.homEquiv A (P_push.obj (C₁.obj A))).injective
    rw [Equiv.apply_symm_apply, CategoryTheory.Adjunction.homEquiv_unit]
    have hL : adj₁.unit.app A ≫ (C₁.obj A).obj.map (hT₁.from (B.obj T₂)).op =
        (sh₁.unit.app P_A₁).app (Opposite.op (B.obj T₂)) := by
      have hnat := ((sh₁.unit.app P_A₁).naturality (hT₁.from (B.obj T₂)).op).symm
      change (sh₁.unit.app P_A₁).app (Opposite.op T₁) ≫
          (C₁.obj A).obj.map (hT₁.from (B.obj T₂)).op =
        𝟙 A ≫ (sh₁.unit.app P_A₁).app (Opposite.op (B.obj T₂)) at hnat
      rw [CategoryTheory.Category.id_comp] at hnat
      change (𝟙 A ≫ (sh₁.unit.app P_A₁).app (Opposite.op T₁)) ≫
          (C₁.obj A).obj.map (hT₁.from (B.obj T₂)).op = _
      rwa [CategoryTheory.Category.id_comp]
    have hR : adj₂.unit.app A ≫ (@uConst S₁ S₂ h hCont A).hom.app (Opposite.op T₂) =
        (sh₁.unit.app P_A₁).app (Opposite.op (B.obj T₂)) := by
      have hu := Equiv.apply_symm_apply (sh₂.homEquiv P_A₂ (P_push.obj (C₁.obj A)))
        (CategoryTheory.Functor.whiskerLeft B.op (sh₁.unit.app P_A₁))
      have hu_app := congrArg (fun nt => nt.app (Opposite.op T₂)) hu
      change (sh₂.unit.app P_A₂).app (Opposite.op T₂) ≫
          (@uConst S₁ S₂ h hCont A).hom.app (Opposite.op T₂) =
        (sh₁.unit.app P_A₁).app (Opposite.op (B.obj T₂)) at hu_app
      change (𝟙 A ≫ (sh₂.unit.app P_A₂).app (Opposite.op T₂)) ≫
          (@uConst S₁ S₂ h hCont A).hom.app (Opposite.op T₂) = _
      rwa [CategoryTheory.Category.id_comp]
    exact hL.trans hR.symm

  have inv_uniq : ∀ {𝒞 : Type (u + 1)} [CategoryTheory.Category.{u + 1} 𝒞] {X Y : 𝒞}
      {p : X ⟶ Y} {q₁ q₂ : Y ⟶ X}, q₁ ≫ p = 𝟙 Y → p ≫ q₂ = 𝟙 X → q₁ = q₂ := by
    intro 𝒞 _ X Y p q₁ q₂ h₁ h₂
    calc
      q₁ = q₁ ≫ (p ≫ q₂) := by rw [h₂, CategoryTheory.Category.comp_id]
      _ = (q₁ ≫ p) ≫ q₂ := (CategoryTheory.Category.assoc q₁ p q₂).symm
      _ = q₂ := by rw [h₁, CategoryTheory.Category.id_comp]

  
  have hCanWitness : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      ∃ (hCont : (weilEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
        (hAdj : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          X₂.smallEtaleTopology X₁.smallEtaleTopology hCont).IsRightAdjoint),
        let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
        let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
        let C₁ := CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}
        let C₂ := CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}
        let πℤ_can := (adj.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm (@uConst X₁ X₂ h hCont Aℤ)
        ∃ (hAdd : pb.Additive)
          (hLim : CategoryTheory.Limits.PreservesFiniteLimits pb)
          (hColim : CategoryTheory.Limits.PreservesFiniteColimits pb)
          (T₁ : X₁.Etale) (hT₁ : CategoryTheory.Limits.IsTerminal T₁)
          (T₂ : X₂.Etale) (hT₂ : CategoryTheory.Limits.IsTerminal T₂)
          (ιℤ_can : C₁.obj Aℤ ⟶ pb.obj (C₂.obj Aℤ)),
          ιℤ_can ≫ πℤ_can = 𝟙 (C₁.obj Aℤ) ∧
          πℤ_can ≫ ιℤ_can = 𝟙 (pb.obj (C₂.obj Aℤ)) := by
    intro X₁ X₂ h
    obtain ⟨hCont, hAdj, hLim, ⟨T₁, ⟨hT₁⟩⟩, ⟨T₂, ⟨hT₂⟩⟩, hTermPres⟩ := hS1 h
    obtain ⟨hBT₂⟩ := hTermPres T₂ hT₂
    letI : (weilEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology := hCont
    letI : ((weilEtaleSitePullback h).sheafPushforwardContinuous
      AddCommGrpCat.{u} X₂.smallEtaleTopology X₁.smallEtaleTopology).IsRightAdjoint := hAdj
    let B := weilEtaleSitePullback h
    let J₁ := X₁.smallEtaleTopology
    let J₂ := X₂.smallEtaleTopology
    let C₁ := CategoryTheory.constantSheaf J₁ AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf J₂ AddCommGrpCat.{u}
    let P_push := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let pb := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    have := adj.leftAdjoint_preservesColimits
    have hColim : CategoryTheory.Limits.PreservesFiniteColimits pb := inferInstance
    have : CategoryTheory.Limits.PreservesFiniteLimits pb := hLim
    have hAdd : pb.Additive := pb.additive_of_preserves_binary_products
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let adj_comp := adj₂.comp adj
    let τ_iso : B.obj T₂ ≅ T₁ :=
      { hom := hT₁.from (B.obj T₂)
        inv := hBT₂.from T₁
        hom_inv_id := hBT₂.hom_ext _ _
        inv_hom_id := hT₁.hom_ext _ _ }
    let θ_τ : (CategoryTheory.sheafSections J₁ AddCommGrpCat.{u}).obj (Opposite.op T₁) ≅
        P_push ⋙ (CategoryTheory.sheafSections J₂ AddCommGrpCat.{u}).obj (Opposite.op T₂) :=
      CategoryTheory.NatIso.ofComponents
        (fun ℱ =>
          { hom := ℱ.obj.map τ_iso.hom.op
            inv := ℱ.obj.map τ_iso.inv.op
            hom_inv_id := by
              change ℱ.obj.map τ_iso.hom.op ≫ ℱ.obj.map τ_iso.inv.op = 𝟙 (ℱ.obj.obj (Opposite.op T₁))
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.inv_hom_id, op_id,
                CategoryTheory.Functor.map_id]
            inv_hom_id := by
              change ℱ.obj.map τ_iso.inv.op ≫ ℱ.obj.map τ_iso.hom.op =
                𝟙 (ℱ.obj.obj (Opposite.op (B.obj T₂)))
              rw [← CategoryTheory.Functor.map_comp, ← op_comp, τ_iso.hom_inv_id, op_id,
                CategoryTheory.Functor.map_id] })
        (fun u => (u.hom.naturality τ_iso.hom.op).symm)
    let α_iso : C₂ ⋙ pb ≅ C₁ :=
      adj_comp.leftAdjointUniq (adj₁.ofNatIsoRight θ_τ)
    have hπ_eq_α : (adj.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm (@uConst X₁ X₂ h hCont Aℤ) =
        α_iso.hom.app Aℤ := by
      apply (adj_comp.homEquiv Aℤ (C₁.obj Aℤ)).injective
      have h1 : (adj_comp.homEquiv Aℤ (C₁.obj Aℤ))
          ((adj.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm (@uConst X₁ X₂ h hCont Aℤ)) =
          (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))) (@uConst X₁ X₂ h hCont Aℤ) := by
        dsimp only [adj_comp]
        rw [CategoryTheory.Adjunction.comp_homEquiv, Equiv.trans_apply, Equiv.apply_symm_apply]
      have h2 : (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))) (@uConst X₁ X₂ h hCont Aℤ) =
          adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ_iso.hom.op :=
        (congrArg (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ)))
          (@hConstUnitEq X₁ X₂ h hCont T₁ hT₁ T₂ hT₂ Aℤ).symm).trans
          (Equiv.apply_symm_apply (adj₂.homEquiv Aℤ (P_push.obj (C₁.obj Aℤ))) _)
      have h3 : (adj_comp.homEquiv Aℤ (C₁.obj Aℤ)) (α_iso.hom.app Aℤ) =
          adj₁.unit.app Aℤ ≫ (C₁.obj Aℤ).obj.map τ_iso.hom.op := by
        rw [CategoryTheory.Adjunction.homEquiv_leftAdjointUniq_hom_app]
        rfl
      exact h1.trans (h2.trans h3.symm)
    refine ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, α_iso.inv.app Aℤ, ?_, ?_⟩
    · exact (congrArg (α_iso.inv.app Aℤ ≫ ·) hπ_eq_α).trans (α_iso.inv_hom_id_app Aℤ)
    · exact (congrArg (· ≫ α_iso.inv.app Aℤ) hπ_eq_α).trans (α_iso.hom_inv_id_app Aℤ)

  
  have hLocEvalCan : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂)
      (U₁ : X₁.Etale) (U₂ : X₂.Etale)
      (τ_U : Quiver.Hom ((weilEtaleSitePullback h).obj U₂) U₁) (q : ℕ)
      (p : weilEtaleLocalTorsionH X₂ ℓ U₂ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁ q)
      (hCont : (weilEtaleSitePullback h).IsContinuous X₂.smallEtaleTopology X₁.smallEtaleTopology)
      (hAdj : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology hCont).IsRightAdjoint),
      let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
      let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
      let C₁ := CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}
      let C₂ := CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}
      ∀ [pb.Additive] [CategoryTheory.Limits.PreservesFiniteLimits pb]
        [CategoryTheory.Limits.PreservesFiniteColimits pb]
        (ιℤ_can : C₁.obj Aℤ ⟶ pb.obj (C₂.obj Aℤ)),
        (adj.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm (@uConst X₁ X₂ h hCont Aℤ) ≫ ιℤ_can = 𝟙 _ →
        WeilIsLocalTorsionPullback h U₁ U₂ τ_U ℓ q p →
        ∀ x : weilEtaleLocalTorsionH X₂ ℓ U₂ q,
          let B := weilEtaleSitePullback h
          let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
          let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ (B.obj U₂)
          let ι_BU := CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_BU)
          let π_BU_can := (adj.homEquiv L₂ L_BU).symm (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU)
          let π_loc_can := π_BU_can ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U
          p x = ((CategoryTheory.Abelian.Ext.mk₀ ιℤ_can).comp
            ((pb.mapExtAddHom (C₂.obj Aℤ) L₂ q) x) (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ π_loc_can) (Nat.add_zero q) := by
    intro X₁ X₂ h U₁ U₂ τ_U q p hCont hAdj pb adj C₁ C₂ _ _ _ ιℤ_can hπι_can hp x
      B L₂ L_BU ι_BU π_BU_can π_loc_can
    rcases hp with ⟨hCont', P_pull, adj_pull, hAdd', hLim', hColim', T₁, hT₁, T₂, hT₂, ιℤ, hι₁, _hι₂, hp_eq⟩
    cases Subsingleton.elim hCont' hCont
    have : P_pull.Additive := hAdd'
    have : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim'
    have : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim'
    rw [hp_eq x]
    let η : P_pull ≅ pb := adj_pull.leftAdjointUniq adj
    let πℤ_can := (adj.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm (@uConst X₁ X₂ h hCont Aℤ)
    have hπℤ_eq :
        (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
          (((CategoryTheory.constantSheafAdj X₂.smallEtaleTopology AddCommGrpCat.{u} hT₂).homEquiv
            Aℤ _).symm
            ((CategoryTheory.constantSheafAdj X₁.smallEtaleTopology AddCommGrpCat.{u} hT₁).unit.app Aℤ ≫
              (C₁.obj Aℤ).obj.map (Opposite.op (hT₁.from (B.obj T₂))))) =
        η.hom.app (C₂.obj Aℤ) ≫ πℤ_can :=
      (congrArg (adj_pull.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
        (@hConstUnitEq X₁ X₂ h hCont T₁ hT₁ T₂ hT₂ Aℤ)).trans
        (hLeftAdjSymm adj_pull adj (@uConst X₁ X₂ h hCont Aℤ))
    have hι_rel : ιℤ ≫ η.hom.app (C₂.obj Aℤ) = ιℤ_can :=
      inv_uniq (p := πℤ_can)
        ((CategoryTheory.Category.assoc ιℤ (η.hom.app (C₂.obj Aℤ)) πℤ_can).trans
          ((congrArg (ιℤ ≫ ·) hπℤ_eq.symm).trans hι₁))
        hπι_can
    have hπ_BU_eq :
        (adj_pull.homEquiv L₂ L_BU).symm (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU) =
          η.hom.app L₂ ≫ π_BU_can :=
      hLeftAdjSymm adj_pull adj (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU)
    let π_loc := (adj_pull.homEquiv L₂ L_BU).symm
      (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU) ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U
    have hπ_loc_eq : π_loc = η.hom.app L₂ ≫ π_loc_can := by
      dsimp [π_loc, π_loc_can]
      rw [hπ_BU_eq, CategoryTheory.Category.assoc]
    change ((CategoryTheory.Abelian.Ext.mk₀ ιℤ).comp
        ((P_pull.mapExtAddHom (C₂.obj Aℤ) L₂ q) x) (Nat.zero_add q)).comp
        (CategoryTheory.Abelian.Ext.mk₀ π_loc) (Nat.add_zero q) = _
    rw [hπ_loc_eq, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (η.hom.app L₂) π_loc_can,
      ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app L₂))
        (CategoryTheory.Abelian.Ext.mk₀ π_loc_can) (Nat.add_zero q),
      CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero
        (CategoryTheory.Abelian.Ext.mk₀ ιℤ) _
        (CategoryTheory.Abelian.Ext.mk₀ (η.hom.app L₂)) (Nat.zero_add q),
      hMapExtNat η.hom q (C₂.obj Aℤ) L₂ x,
      CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc, hι_rel]

  refine ⟨?_, ?_, ?_⟩
  · 
    intro X₁ X₂ h U₁ U₂ τ_U q
    obtain ⟨hCont, hAdj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ_can, hι₁, hι₂⟩ :=
      hCanWitness h
    have : (@CategoryTheory.Functor.sheafPullback _ _ _ _
        (weilEtaleSitePullback h) AddCommGrpCat.{u} _
        X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj).Additive := hAdd
    have : CategoryTheory.Limits.PreservesFiniteLimits
        (@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj) := hLim
    have : CategoryTheory.Limits.PreservesFiniteColimits
        (@CategoryTheory.Functor.sheafPullback _ _ _ _
          (weilEtaleSitePullback h) AddCommGrpCat.{u} _
          X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj) := hColim
    let B := weilEtaleSitePullback h
    let pb := @CategoryTheory.Functor.sheafPullback _ _ _ _
      B AddCommGrpCat.{u} _ X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
    let adj := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _
      B AddCommGrpCat.{u} _ X₂.smallEtaleTopology X₁.smallEtaleTopology hCont hAdj
    let C₁ := CategoryTheory.constantSheaf X₁.smallEtaleTopology AddCommGrpCat.{u}
    let C₂ := CategoryTheory.constantSheaf X₂.smallEtaleTopology AddCommGrpCat.{u}
    let L₂ := weilEtaleLocalTorsionSheaf X₂ ℓ U₂
    let L_BU := weilEtaleLocalTorsionSheaf X₁ ℓ (B.obj U₂)
    let ι_BU := CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_BU)
    let π_BU_can := (adj.homEquiv L₂ L_BU).symm (CategoryTheory.Sheaf.freeYonedaHomEquiv.symm ι_BU)
    let π_loc_can := π_BU_can ≫ weilEtaleLocalTorsionMap X₁ ℓ τ_U
    let p_can : weilEtaleLocalTorsionH X₂ ℓ U₂ q →+ weilEtaleLocalTorsionH X₁ ℓ U₁ q :=
      ((CategoryTheory.Abelian.Ext.mk₀ π_loc_can).postcomp (C₁.obj Aℤ) (Nat.add_zero q)).comp
        (((CategoryTheory.Abelian.Ext.mk₀ ιℤ_can).precomp (pb.obj L₂) (Nat.zero_add q)).comp
          (pb.mapExtAddHom (C₂.obj Aℤ) L₂ q))
    have hp_can : WeilIsLocalTorsionPullback h U₁ U₂ τ_U ℓ q p_can := by
      have hπ_eq := congrArg (adj.homEquiv (C₂.obj Aℤ) (C₁.obj Aℤ)).symm
        (@hConstUnitEq X₁ X₂ h hCont T₁ hT₁ T₂ hT₂ Aℤ)
      exact ⟨hCont, pb, adj, hAdd, hLim, hColim, T₁, hT₁, T₂, hT₂, ιℤ_can,
        (congrArg (ιℤ_can ≫ ·) hπ_eq).trans hι₁,
        (congrArg (· ≫ ιℤ_can) hπ_eq).trans hι₂,
        fun _ => rfl⟩
    refine ⟨p_can, hp_can, fun p' hp' => ?_⟩
    ext x
    exact hLocEvalCan h U₁ U₂ τ_U q p' hCont hAdj ιℤ_can hι₂ hp' x

  · 
    intro X₁ X₂ X₃ h₁ h₂ U₁ U₂ U₃ τ₁ τ₂ τ₁₂ p₁ p₂ p₁₂ Fgt₁ Fgt₂ Fgt₃ B₁ B₂
      c₁₂ hc_fst hc_snd hc_τ hp₁ hp₂ hp₁₂
    obtain ⟨hCont₁, hAdj₁, hAdd₁, hLim₁, hColim₁, -, -, -, -, ιℤ₁, _hι₁_1, hι₁_2⟩ :=
      hCanWitness h₁
    obtain ⟨hCont₂, hAdj₂, hAdd₂, hLim₂, hColim₂, -, -, -, -, ιℤ₂, _hι₂_1, hι₂_2⟩ :=
      hCanWitness h₂
    obtain ⟨hCont₁₂, hAdj₁₂, hAdd₁₂, hLim₁₂, hColim₁₂, -, -, -, -, ιℤ₁₂, hι₁₂_1, hι₁₂_2⟩ :=
