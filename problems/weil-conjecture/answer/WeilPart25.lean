      Functor.isoWhiskerLeft P_push eE₂.unitIso.symm ≪≫
      Functor.rightUnitor P_push
    let adj_tot : (E₂ ⋙ F₀.sheafPullback AddCommGrpCat.{u} K₂ J₁) ⊣ P_push :=
      (eE₂.toAdjunction.comp adj_F₀).ofNatIsoRight iso_push
    have hAdj_push : P_push.IsRightAdjoint := ⟨_, ⟨adj_tot⟩⟩
    let adj_pull := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let Φ : B.sheafPullback AddCommGrpCat.{u} J₂ J₁ ≅
        E₂ ⋙ F₀.sheafPullback AddCommGrpCat.{u} K₂ J₁ :=
      adj_pull.leftAdjointUniq adj_tot
    have hLim_comp : Limits.PreservesFiniteLimits
        (E₂ ⋙ F₀.sheafPullback AddCommGrpCat.{u} K₂ J₁) :=
      Limits.comp_preservesFiniteLimits _ _
    have hLim_pull : Limits.PreservesFiniteLimits
        (B.sheafPullback AddCommGrpCat.{u} J₂ J₁) :=
      Limits.preservesFiniteLimits_of_natIso Φ.symm
    refine ⟨hContB, hAdj_push, hLim_pull,
      ⟨⊤_ S₁.Etale, ⟨Limits.terminalIsTerminal⟩⟩,
