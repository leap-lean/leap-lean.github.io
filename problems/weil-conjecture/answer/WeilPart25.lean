      have h1 : (e_inv_TU ≫ m₁_pb) ≫ m₂ = CategoryTheory.CategoryStruct.id T_U :=
        hT_U.hom_ext _ _
      rw [← op_comp, ← op_comp, h1, op_id]
    rw [hLHS, hRHS]
    calc
      (u₁ ≫ u₂) ≫ u₃
        = ((adj_Y.unit.app AM ≫ F_Y.obj.map m₁.op) ≫ u₂) ≫ u₃ := by rw [hu₁]
      _ = (adj_Y.unit.app AM ≫ (F_Y.obj.map m₁.op ≫ u₂)) ≫ u₃ := by
          rw [CategoryTheory.Category.assoc (adj_Y.unit.app AM)]
      _ = (adj_Y.unit.app AM ≫ (v_ρ ≫ F_U.obj.map m₁_pb.op)) ≫ u₃ := by
          rw [hnat_ρ]
      _ = ((adj_Y.unit.app AM ≫ v_ρ) ≫ F_U.obj.map m₁_pb.op) ≫ u₃ := by
          rw [CategoryTheory.Category.assoc (adj_Y.unit.app AM) v_ρ]
      _ = ((adj_U.unit.app AM ≫ F_U.obj.map m₂.op) ≫ F_U.obj.map m₁_pb.op) ≫ u₃ := by
          rw [hρ_app]
      _ = adj_U.unit.app AM ≫ (F_U.obj.map m₂.op ≫ F_U.obj.map m₁_pb.op ≫ u₃) := by
          simp only [CategoryTheory.Category.assoc]
      _ = adj_U.unit.app AM ≫ F_U.obj.map (m₂.op ≫ m₁_pb.op ≫ e_inv_TU.op) := by
          dsimp [u₃]
          rw [← F_U.obj.map_comp, ← F_U.obj.map_comp]
      _ = adj_U.unit.app AM := by
          rw [hterm_id, F_U.obj.map_id]
          exact CategoryTheory.Category.comp_id _

  let a_zero : Fin m_pts := ⟨0, Nat.lt_of_lt_of_le Nat.zero_lt_one hm_pts⟩
  let r_global : pf_f₁.obj F_Y ⟶ F_U := pf_f₁.map (ρ_a a_zero) ≫ (ψ_a a_zero).hom
  have hη_rglobal : η_f₁ ≫ r_global = CategoryTheory.CategoryStruct.id F_U := hη_retract a_zero

  have hIso_η : CategoryTheory.IsIso η_f₁ := by
    haveI : AlgebraicGeometry.LocallyOfFiniteType (CategoryTheory.Over.mk p_U₁).hom :=
      ‹AlgebraicGeometry.LocallyOfFiniteType p_U₁›
    apply hConserv_iso (CategoryTheory.Over.mk p_U₁) η_f₁
    intro s_u hs_u
    have hs_u' : s_u ≫ p_U₁ = CategoryTheory.CategoryStruct.id S_k := hs_u
    let C_u := CategoryTheory.Limits.pullback f₁ s_u
    let ι_u := CategoryTheory.Limits.pullback.fst f₁ s_u
    let f_u := CategoryTheory.Limits.pullback.snd f₁ s_u
    let F_Cu := weilEtaleTorsionSheaf C_u ℓ
    have hPull_ιu : WeilIsEtaleSheafPullback ι_u F_Y F_Cu := by
      haveI : CategoryTheory.IsIso
          (weilEtaleConstPullbackHom ι_u (weilEtaleIdTerminalIsTerminal.{u} C_u) hT_Y AM) :=
        hProp_const ι_u AM
      exact ⟨hc_all ι_u, hr_all ι_u,
        ⟨CategoryTheory.asIso
          (weilEtaleConstPullbackHom ι_u (weilEtaleIdTerminalIsTerminal.{u} C_u) hT_Y AM)⟩⟩
    have hPBC_0 : WeilIsEtaleSheafPullback s_u
        (weilEtaleHigherDirectImage f₁ 0 F_Y)
        (weilEtaleHigherDirectImage f_u 0 F_Cu) :=
      hPBC (CategoryTheory.Over.mk (f₁ ≫ p_U₁)) (CategoryTheory.Over.mk p_U₁)
        (CategoryTheory.Over.mk (CategoryTheory.CategoryStruct.id S_k))
        (CategoryTheory.Over.mk f_u)
        (CategoryTheory.Over.homMk f₁ rfl)
        (CategoryTheory.Over.homMk s_u hs_u')
        (CategoryTheory.Over.homMk f_u (CategoryTheory.Category.comp_id f_u))
        (CategoryTheory.Over.homMk ι_u (by
          dsimp
          rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
            CategoryTheory.Category.assoc, hs_u', CategoryTheory.Category.comp_id]))
        ‹AlgebraicGeometry.IsProper f₁›
        (CategoryTheory.IsPullback.of_hasPullback f₁ s_u)
        F_Y F_Cu hTor_FY hPull_ιu 0
    obtain ⟨hc_su, hr_su, ⟨e_pbc₀⟩⟩ := hPBC_0
    refine ⟨hc_su, hr_su, ?_⟩
    let pb_su := @CategoryTheory.Functor.sheafPullback _ _ _ _
      (weilEtaleSitePullback s_u) AddCommGrpCat.{u} _ J_U S_k.smallEtaleTopology hc_su hr_su
    have hInj : Function.Injective (((pb_su.map η_f₁).hom.app (Opposite.op T_k)).hom) := by
      have hleft : Function.LeftInverse
          (((pb_su.map r_global).hom.app (Opposite.op T_k)).hom)
          (((pb_su.map η_f₁).hom.app (Opposite.op T_k)).hom) := by
        intro x
        have hcomp_id : pb_su.map η_f₁ ≫ pb_su.map r_global = CategoryTheory.CategoryStruct.id _ := by
          rw [← pb_su.map_comp, hη_rglobal, pb_su.map_id]
        have happ := congrArg (fun m => (m.hom.app (Opposite.op T_k)).hom x) hcomp_id
        exact happ
      exact hleft.injective
    haveI : CategoryTheory.IsIso
        (@weilEtaleConstPullbackHom _ _ s_u hc_su hr_su _ hT_k _ hT_U AM) :=
      @hProp_const _ _ s_u hc_su hr_su AM
    let e_dom_sh : pb_su.obj F_U ≅ weilEtaleTorsionSheaf S_k ℓ :=
      CategoryTheory.asIso (@weilEtaleConstPullbackHom _ _ s_u hc_su hr_su _ hT_k _ hT_U AM)
    let P_const_k := (CategoryTheory.Functor.const (Opposite S_k.Etale)).obj AM
    haveI : CategoryTheory.IsIso
        (((CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P_const_k).app (Opposite.op T_k)) :=
      hSpec_unit P_const_k
    let e_dom_grp : (pb_su.obj F_U).obj.obj (Opposite.op T_k) ≅ AM :=
      ((CategoryTheory.evaluation _ _).obj (Opposite.op T_k)).mapIso
        ((CategoryTheory.sheafToPresheaf _ _).mapIso e_dom_sh) ≪≫
      (CategoryTheory.asIso
        (((CategoryTheory.sheafificationAdjunction S_k.smallEtaleTopology
          AddCommGrpCat.{u}).unit.app P_const_k).app (Opposite.op T_k))).symm
    have hCard_dom : Nat.card ↥((pb_su.obj F_U).obj.obj (Opposite.op T_k)) = ℓ := by
      have h1 : Nat.card ↥((pb_su.obj F_U).obj.obj (Opposite.op T_k)) = Nat.card ↥AM :=
        Nat.card_congr e_dom_grp.addCommGroupIsoToAddEquiv.toEquiv
      have h2 : Nat.card ↥AM = Nat.card (ZMod ℓ) := Nat.card_congr Equiv.ulift
      rw [h1, h2, Nat.card_zmod]
    obtain ⟨e_R0_pf⟩ := hCalc_R0 F_Y
    let e_cod_sh : pb_su.obj (pf_f₁.obj F_Y) ≅ weilEtaleHigherDirectImage f_u 0 F_Cu :=
      pb_su.mapIso e_R0_pf.symm ≪≫ e_pbc₀
    let e_cod_grp1 :
        (pb_su.obj (pf_f₁.obj F_Y)).obj.obj (Opposite.op T_k) ≅
          (weilEtaleHigherDirectImage f_u 0 F_Cu).obj.obj (Opposite.op T_k) :=
      ((CategoryTheory.evaluation _ _).obj (Opposite.op T_k)).mapIso
        ((CategoryTheory.sheafToPresheaf _ _).mapIso e_cod_sh)
    obtain ⟨e_H0_Cu, -⟩ := hSpec_H (CategoryTheory.Over.mk f_u) 0
    have hConn_Cu : ConnectedSpace ↥C_u := hConn_fib s_u hs_u
    have hCard_H0 : Nat.card (weilEtaleTorsionH C_u ℓ 0) = ℓ :=
      (hFib_card C_u).mp hConn_Cu
    have hCard_cod : Nat.card ↥((pb_su.obj (pf_f₁.obj F_Y)).obj.obj (Opposite.op T_k)) = ℓ := by
      have h1 := Nat.card_congr
        (e_cod_grp1.addCommGroupIsoToAddEquiv.toEquiv.trans (e_H0_Cu F_Cu).toEquiv)
      exact h1.trans hCard_H0
    have hFin_cod : Finite ↥((pb_su.obj (pf_f₁.obj F_Y)).obj.obj (Opposite.op T_k)) :=
      Nat.finite_of_card_ne_zero (by rw [hCard_cod]; exact hPrime.ne_zero)
    exact (@Nat.bijective_iff_injective_and_card _ _ hFin_cod
      (((pb_su.map η_f₁).hom.app (Opposite.op T_k)).hom)).mpr ⟨hInj, hCard_dom.trans hCard_cod.symm⟩

  haveI : CategoryTheory.IsIso η_f₁ := hIso_η
  let e_η : F_U ≅ pf_f₁.obj F_Y := CategoryTheory.asIso η_f₁

  
  let m₀ : ℕ := m_pts - 1
  have : C_U.IsLeftAdjoint := adj_U.isLeftAdjoint
  haveI hAdd_CU : C_U.Additive :=
    CategoryTheory.Functor.additive_of_preserves_binary_products _
  haveI : AddCommGrpCat.uliftFunctor.{u, 0}.Additive :=
    { map_add := fun {_ _} {_ _} => AddCommGrpCat.ext fun _ => rfl }
  let C'_U : CategoryTheory.Functor AddCommGrpCat.{0} (CategoryTheory.Sheaf J_U AddCommGrpCat.{u}) :=
    CategoryTheory.Functor.comp AddCommGrpCat.uliftFunctor.{u, 0} C_U
  haveI : C'_U.Additive :=
    { map_add := fun {_ _} {f g} => by
        change C_U.map (AddCommGrpCat.uliftFunctor.{u, 0}.map (f + g)) =
          C_U.map (AddCommGrpCat.uliftFunctor.{u, 0}.map f) +
            C_U.map (AddCommGrpCat.uliftFunctor.{u, 0}.map g)
        rw [AddCommGrpCat.uliftFunctor.{u, 0}.map_add, C_U.map_add] }

  let G_1 : AddCommGrpCat.{0} := AddCommGrpCat.of (ZMod ℓ)
  let G_m : AddCommGrpCat.{0} := AddCommGrpCat.of (Fin m_pts → ZMod ℓ)
  let G_0 : AddCommGrpCat.{0} := AddCommGrpCat.of (Fin m₀ → ZMod ℓ)

  let Δ₀ : G_1 ⟶ G_m :=
    AddCommGrpCat.ofHom
      { toFun := fun c _ => c
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let r₀_grp : G_m ⟶ G_1 :=
    AddCommGrpCat.ofHom
      { toFun := fun x => x a_zero
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let q₀_grp : G_m ⟶ G_0 :=
    AddCommGrpCat.ofHom
      { toFun := fun x j => x ⟨j.1 + 1, by omega⟩ - x a_zero
        map_zero' := funext fun _ => sub_zero 0
        map_add' := fun x y => funext fun j => by
          change (x ⟨j.1 + 1, _⟩ + y ⟨j.1 + 1, _⟩) - (x a_zero + y a_zero) =
            (x ⟨j.1 + 1, _⟩ - x a_zero) + (y ⟨j.1 + 1, _⟩ - y a_zero)
          abel }
  let s₀_grp : G_0 ⟶ G_m :=
    AddCommGrpCat.ofHom
      { toFun := fun d a => if h : a.1 = 0 then 0 else d ⟨a.1 - 1, by omega⟩
        map_zero' := funext fun a => by split_ifs <;> rfl
        map_add' := fun d₁ d₂ => funext fun a => by
          change (if h : a.1 = 0 then (0 : ZMod ℓ) else d₁ ⟨a.1 - 1, _⟩ + d₂ ⟨a.1 - 1, _⟩) =
            (if h : a.1 = 0 then 0 else d₁ ⟨a.1 - 1, _⟩) +
              (if h : a.1 = 0 then 0 else d₂ ⟨a.1 - 1, _⟩)
          split_ifs
          · exact (add_zero 0).symm
          · rfl }
  let ev_a : ∀ a : Fin m_pts, G_m ⟶ G_1 :=
    fun a => AddCommGrpCat.ofHom
      { toFun := fun x => x a
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
  let single_a : ∀ a : Fin m_pts, G_1 ⟶ G_m :=
    fun a => AddCommGrpCat.ofHom
      { toFun := fun c => Pi.single a c
        map_zero' := Pi.single_zero a
        map_add' := fun c₁ c₂ => @Pi.single_add _ (fun _ : Fin m_pts => ZMod ℓ) _ _ a c₁ c₂ }

  have hs₀_q₀ : s₀_grp ≫ q₀_grp = CategoryTheory.CategoryStruct.id G_0 := by
    apply AddCommGrpCat.ext
    intro d
    funext j
    change (if h : j.1 + 1 = 0 then (0 : ZMod ℓ) else d ⟨(j.1 + 1) - 1, by omega⟩) -
      (if h : (0 : ℕ) = 0 then 0 else d ⟨0 - 1, by omega⟩) = d j
    rw [dif_neg (Nat.succ_ne_zero j.1), dif_pos rfl, sub_zero]
    congr 1
  have hΔ₀_q₀ : Δ₀ ≫ q₀_grp = 0 := by
    apply AddCommGrpCat.ext
    intro c
    funext _
    exact sub_self c
  have hsplit_Gm : r₀_grp ≫ Δ₀ + q₀_grp ≫ s₀_grp = CategoryTheory.CategoryStruct.id G_m := by
    apply AddCommGrpCat.ext
    intro x
    funext a
    change x a_zero +
      (if h : a.1 = 0 then (0 : ZMod ℓ) else x ⟨(a.1 - 1) + 1, _⟩ - x a_zero) = x a
    split_ifs with h
    · rw [add_zero]
      exact congrArg x (Fin.ext h.symm)
    · have ha_eq : (⟨(a.1 - 1) + 1, by omega⟩ : Fin m_pts) = a :=
        Fin.ext (Nat.sub_add_cancel (Nat.pos_of_ne_zero h))
      rw [ha_eq, add_sub_cancel]
  have hsingle_ev : ∀ a b : Fin m_pts,
      single_a a ≫ ev_a b = if a = b then CategoryTheory.CategoryStruct.id G_1 else 0 := by
    intro a b
    split_ifs with hab
    · subst hab
      apply AddCommGrpCat.ext
      intro (c : ZMod ℓ)
      exact @Pi.single_eq_same (Fin m_pts) (fun _ => ZMod ℓ) _ _ a c
    · apply AddCommGrpCat.ext
      intro (c : ZMod ℓ)
      exact @Pi.single_eq_of_ne (Fin m_pts) (fun _ => ZMod ℓ) _ _ a b (fun h => hab h.symm) c
  have hsum_ev_single :
      (Finset.univ.sum fun a : Fin m_pts => ev_a a ≫ single_a a) =
        CategoryTheory.CategoryStruct.id G_m := by
    apply AddCommGrpCat.ext
    intro (x : Fin m_pts → ZMod ℓ)
    funext b
    let eval_xb : (G_m ⟶ G_m) →+ ZMod ℓ :=
      { toFun := fun f => f.hom x b
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    change eval_xb (Finset.univ.sum fun a : Fin m_pts => ev_a a ≫ single_a a) = x b
    rw [map_sum eval_xb]
    change (Finset.univ.sum fun a : Fin m_pts => Pi.single a (x a) b) = x b
    rw [Finset.sum_eq_single b]
    · exact @Pi.single_eq_same (Fin m_pts) (fun _ => ZMod ℓ) _ _ b (x b)
    · intro a _ hab
      exact @Pi.single_eq_of_ne (Fin m_pts) (fun _ => ZMod ℓ) _ _ a b (fun h => hab h.symm) (x a)
    · intro hb
      exact absurd (Finset.mem_univ b) hb
  have hsum_single :
      (Finset.univ.sum fun a : Fin m_pts => single_a a) = Δ₀ := by
    apply AddCommGrpCat.ext
    intro (c : ZMod ℓ)
    funext b
    let eval_cb : (G_1 ⟶ G_m) →+ ZMod ℓ :=
      { toFun := fun f => f.hom c b
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    change eval_cb (Finset.univ.sum fun a : Fin m_pts => single_a a) = c
    rw [map_sum eval_cb]
    change (Finset.univ.sum fun a : Fin m_pts => Pi.single a c b) = c
    rw [Finset.sum_eq_single b]
    · exact @Pi.single_eq_same (Fin m_pts) (fun _ => ZMod ℓ) _ _ b c
    · intro a _ hab
      exact @Pi.single_eq_of_ne (Fin m_pts) (fun _ => ZMod ℓ) _ _ a b (fun h => hab h.symm) c
    · intro hb
      exact absurd (Finset.mem_univ b) hb

  let Φ_fwd : pf_f₁.obj Q ⟶ C'_U.obj G_m :=
    Finset.univ.sum fun a : Fin m_pts =>
      pf_f₁.map (CategoryTheory.Limits.Pi.π pf_a a) ≫ (ψ_a a).hom ≫ C'_U.map (single_a a)
  let Φ_bwd : C'_U.obj G_m ⟶ pf_f₁.obj Q :=
    Finset.univ.sum fun b : Fin m_pts =>
      C'_U.map (ev_a b) ≫ (ψ_a b).inv ≫ pf_f₁.map (ι_Q b)
  let e_pfQ : pf_f₁.obj Q ≅ C'_U.obj G_m :=
    { hom := Φ_fwd
      inv := Φ_bwd
      hom_inv_id := by
        dsimp [Φ_fwd, Φ_bwd]
        rw [CategoryTheory.Preadditive.sum_comp]
        have hstep :
            (Finset.univ.sum fun a : Fin m_pts =>
              (pf_f₁.map (CategoryTheory.Limits.Pi.π pf_a a) ≫ (ψ_a a).hom ≫ C'_U.map (single_a a)) ≫
                Finset.univ.sum fun b : Fin m_pts =>
                  C'_U.map (ev_a b) ≫ (ψ_a b).inv ≫ pf_f₁.map (ι_Q b)) =
            Finset.univ.sum fun a : Fin m_pts =>
              pf_f₁.map (CategoryTheory.Limits.Pi.π pf_a a ≫ ι_Q a) := by
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [CategoryTheory.Preadditive.comp_sum, Finset.sum_eq_single a]
          · simp only [CategoryTheory.Category.assoc]
            rw [← CategoryTheory.Category.assoc (C'_U.map (single_a a)) (C'_U.map (ev_a a)),
              ← C'_U.map_comp, hsingle_ev a a, if_pos rfl, C'_U.map_id,
              CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc (ψ_a a).hom,
              (ψ_a a).hom_inv_id, CategoryTheory.Category.id_comp, ← pf_f₁.map_comp]
          · intro b _ hba
            simp only [CategoryTheory.Category.assoc]
            rw [← CategoryTheory.Category.assoc (C'_U.map (single_a a)) (C'_U.map (ev_a b)),
              ← C'_U.map_comp, hsingle_ev a b, if_neg (Ne.symm hba), C'_U.map_zero,
              CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero,
              CategoryTheory.Limits.comp_zero]
          · intro ha
            exact absurd (Finset.mem_univ a) ha
        rw [hstep, ← pf_f₁.map_sum, ← hid_Q, pf_f₁.map_id]
      inv_hom_id := by
        dsimp [Φ_fwd, Φ_bwd]
        rw [CategoryTheory.Preadditive.sum_comp]
        have hstep :
            (Finset.univ.sum fun b : Fin m_pts =>
              (C'_U.map (ev_a b) ≫ (ψ_a b).inv ≫ pf_f₁.map (ι_Q b)) ≫
                Finset.univ.sum fun a : Fin m_pts =>
                  pf_f₁.map (CategoryTheory.Limits.Pi.π pf_a a) ≫ (ψ_a a).hom ≫ C'_U.map (single_a a)) =
            Finset.univ.sum fun b : Fin m_pts =>
              C'_U.map (ev_a b ≫ single_a b) := by
          refine Finset.sum_congr rfl fun b _ => ?_
          rw [CategoryTheory.Preadditive.comp_sum, Finset.sum_eq_single b]
          · simp only [CategoryTheory.Category.assoc]
            rw [← CategoryTheory.Category.assoc (pf_f₁.map (ι_Q b)), ← pf_f₁.map_comp,
              hιQ_π b b, dif_pos rfl]
            change C'_U.map (ev_a b) ≫ (ψ_a b).inv ≫ pf_f₁.map (𝟙 (pf_a b)) ≫
              (ψ_a b).hom ≫ C'_U.map (single_a b) = _
            rw [pf_f₁.map_id, CategoryTheory.Category.id_comp,
              ← CategoryTheory.Category.assoc (ψ_a b).inv, (ψ_a b).inv_hom_id,
              CategoryTheory.Category.id_comp, ← C'_U.map_comp]
          · intro a _ hab
            simp only [CategoryTheory.Category.assoc]
            rw [← CategoryTheory.Category.assoc (pf_f₁.map (ι_Q b)), ← pf_f₁.map_comp,
              hιQ_π b a, dif_neg (Ne.symm hab), pf_f₁.map_zero,
              CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero,
              CategoryTheory.Limits.comp_zero]
          · intro hb
            exact absurd (Finset.mem_univ b) hb
        rw [hstep, ← C'_U.map_sum, hsum_ev_single, C'_U.map_id] }

  let Δ_sh : F_U ⟶ C'_U.obj G_m := C'_U.map Δ₀
  let r_sh : C'_U.obj G_m ⟶ F_U := C'_U.map r₀_grp
  let q_sh : C'_U.obj G_m ⟶ C'_U.obj G_0 := C'_U.map q₀_grp
  let s_sh : C'_U.obj G_0 ⟶ C'_U.obj G_m := C'_U.map s₀_grp

  have hs_q_sh : s_sh ≫ q_sh = CategoryTheory.CategoryStruct.id _ := by
    rw [← C'_U.map_comp, hs₀_q₀, C'_U.map_id]
  have hΔ_q_sh : Δ_sh ≫ q_sh = 0 := by
    rw [← C'_U.map_comp, hΔ₀_q₀, C'_U.map_zero]
  have hsplit_sh : r_sh ≫ Δ_sh + q_sh ≫ s_sh = CategoryTheory.CategoryStruct.id _ := by
    rw [← C'_U.map_comp, ← C'_U.map_comp, ← C'_U.map_add, hsplit_Gm, C'_U.map_id]

  have hρ_comm : η_f₁ ≫ pf_f₁.map ρ ≫ e_pfQ.hom = Δ_sh := by
    change η_f₁ ≫ pf_f₁.map ρ ≫ Φ_fwd = C'_U.map Δ₀
    dsimp [Φ_fwd]
    rw [CategoryTheory.Preadditive.comp_sum, CategoryTheory.Preadditive.comp_sum]
    have hterms :
        (Finset.univ.sum fun a : Fin m_pts =>
          η_f₁ ≫ pf_f₁.map ρ ≫
            pf_f₁.map (CategoryTheory.Limits.Pi.π pf_a a) ≫ (ψ_a a).hom ≫ C'_U.map (single_a a)) =
        Finset.univ.sum fun a : Fin m_pts => C'_U.map (single_a a) := by
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [← CategoryTheory.Category.assoc (pf_f₁.map ρ), ← pf_f₁.map_comp]
      have hρ_π : ρ ≫ CategoryTheory.Limits.Pi.π pf_a a = ρ_a a := by
        simp only [ρ, CategoryTheory.Limits.limit.lift_π, CategoryTheory.Limits.Fan.mk_pt,
          CategoryTheory.Limits.Fan.mk_π_app]
      rw [hρ_π, ← CategoryTheory.Category.assoc (pf_f₁.map (ρ_a a)),
        ← CategoryTheory.Category.assoc η_f₁, hη_retract a, CategoryTheory.Category.id_comp]
    rw [hterms, ← C'_U.map_sum, hsum_single]

  obtain ⟨e_R1⟩ := hConst_R1
  let δ_m : C'_U.obj G_m ⟶ ℱ := e_pfQ.inv ≫ δ₀
  let π' : ℱ ⟶ C_U.obj (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin b₁ → ZMod ℓ))) :=
    π₁ ≫ e_R1.inv

  have hcomp_Δ : Δ_sh ≫ δ_m = 0 := by
    rw [← hρ_comm]
    dsimp [δ_m]
    simp only [CategoryTheory.Category.assoc]
    rw [← CategoryTheory.Category.assoc e_pfQ.hom e_pfQ.inv, e_pfQ.hom_inv_id,
      CategoryTheory.Category.id_comp, hcomp₁, CategoryTheory.Limits.comp_zero]
  have hcomp_δm : δ_m ≫ π' = 0 := by
    dsimp [δ_m, π']
    rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc δ₀, hcomp₂,
      CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

  have hEx_Δ : (CategoryTheory.ShortComplex.mk Δ_sh δ_m hcomp_Δ).Exact := by
    let iso_SC₁ :
        CategoryTheory.ShortComplex.mk (pf_f₁.map ρ) δ₀ hcomp₁ ≅
          CategoryTheory.ShortComplex.mk Δ_sh δ_m hcomp_Δ :=
      CategoryTheory.ShortComplex.isoMk e_η.symm e_pfQ (CategoryTheory.Iso.refl ℱ)
        (by
          dsimp
          rw [← hρ_comm, ← CategoryTheory.Category.assoc e_η.inv]
          change (e_η.inv ≫ e_η.hom) ≫ pf_f₁.map ρ ≫ e_pfQ.hom = pf_f₁.map ρ ≫ e_pfQ.hom
          rw [e_η.inv_hom_id, CategoryTheory.Category.id_comp])
        (by
          dsimp [δ_m]
          rw [← CategoryTheory.Category.assoc e_pfQ.hom, e_pfQ.hom_inv_id,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
    exact (CategoryTheory.ShortComplex.exact_iff_of_iso iso_SC₁).mp hEx₁

  have hEx_δm : (CategoryTheory.ShortComplex.mk δ_m π' hcomp_δm).Exact := by
    let iso_SC₂ :
        CategoryTheory.ShortComplex.mk δ₀ π₁ hcomp₂ ≅
          CategoryTheory.ShortComplex.mk δ_m π' hcomp_δm :=
      CategoryTheory.ShortComplex.isoMk e_pfQ (CategoryTheory.Iso.refl ℱ) e_R1.symm
        (by
          dsimp [δ_m]
          rw [← CategoryTheory.Category.assoc e_pfQ.hom, e_pfQ.hom_inv_id,
            CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id])
        (by dsimp [π']; rw [CategoryTheory.Category.id_comp])
    exact (CategoryTheory.ShortComplex.exact_iff_of_iso iso_SC₂).mp hEx₂

  let ι₀ : C'_U.obj G_0 ⟶ ℱ := s_sh ≫ δ_m
  have hzero_ιπ : ι₀ ≫ π' = 0 := by
    dsimp [ι₀]
    rw [CategoryTheory.Category.assoc, hcomp_δm, CategoryTheory.Limits.comp_zero]

  have hδm_fac : δ_m = q_sh ≫ ι₀ := by
    calc
      δ_m = CategoryTheory.CategoryStruct.id _ ≫ δ_m := (CategoryTheory.Category.id_comp δ_m).symm
      _ = (r_sh ≫ Δ_sh + q_sh ≫ s_sh) ≫ δ_m := by rw [hsplit_sh]
      _ = r_sh ≫ (Δ_sh ≫ δ_m) + q_sh ≫ (s_sh ≫ δ_m) := by
          rw [CategoryTheory.Preadditive.add_comp, CategoryTheory.Category.assoc,
            CategoryTheory.Category.assoc]
      _ = q_sh ≫ ι₀ := by
          rw [hcomp_Δ, CategoryTheory.Limits.comp_zero, zero_add]

  have hMono_ι₀ : CategoryTheory.Mono ι₀ := by
    rw [CategoryTheory.Preadditive.mono_iff_cancel_zero]
    intro Z g hg
    have hg_δm : (g ≫ s_sh) ≫ δ_m = 0 := by
      rw [CategoryTheory.Category.assoc]
      exact hg
    let l := CategoryTheory.Limits.kernel.lift δ_m (g ≫ s_sh) hg_δm
    have hl : l ≫ CategoryTheory.Limits.kernel.ι δ_m = g ≫ s_sh :=
      CategoryTheory.Limits.kernel.lift_ι δ_m (g ≫ s_sh) hg_δm
    haveI : CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift δ_m Δ_sh hcomp_Δ) :=
      (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift
        (CategoryTheory.ShortComplex.mk Δ_sh δ_m hcomp_Δ)).mp hEx_Δ
    have hker_q : CategoryTheory.Limits.kernel.ι δ_m ≫ q_sh = 0 := by
      apply (cancel_epi (CategoryTheory.Limits.kernel.lift δ_m Δ_sh hcomp_Δ)).mp
      rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι, hΔ_q_sh,
        CategoryTheory.Limits.comp_zero]
    calc
      g = g ≫ CategoryTheory.CategoryStruct.id _ := (CategoryTheory.Category.comp_id g).symm
      _ = g ≫ (s_sh ≫ q_sh) := by rw [hs_q_sh]
      _ = (g ≫ s_sh) ≫ q_sh := (CategoryTheory.Category.assoc g s_sh q_sh).symm
      _ = (l ≫ CategoryTheory.Limits.kernel.ι δ_m) ≫ q_sh := by rw [hl]
      _ = l ≫ (CategoryTheory.Limits.kernel.ι δ_m ≫ q_sh) := CategoryTheory.Category.assoc _ _ _
      _ = 0 := by rw [hker_q, CategoryTheory.Limits.comp_zero]

  have hEpi_π' : CategoryTheory.Epi π' := CategoryTheory.epi_comp π₁ e_R1.inv

  have hEx_ιπ : (CategoryTheory.ShortComplex.mk ι₀ π' hzero_ιπ).Exact := by
    rw [CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift]
    haveI : CategoryTheory.Epi (CategoryTheory.Limits.kernel.lift π' δ_m hcomp_δm) :=
      (CategoryTheory.ShortComplex.exact_iff_epi_kernel_lift
        (CategoryTheory.ShortComplex.mk δ_m π' hcomp_δm)).mp hEx_δm
    have hfac_lift :
        q_sh ≫ CategoryTheory.Limits.kernel.lift π' ι₀ hzero_ιπ =
          CategoryTheory.Limits.kernel.lift π' δ_m hcomp_δm := by
      apply CategoryTheory.Limits.equalizer.hom_ext
      rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.lift_ι,
        CategoryTheory.Limits.kernel.lift_ι, hδm_fac]
    haveI : CategoryTheory.Epi (q_sh ≫ CategoryTheory.Limits.kernel.lift π' ι₀ hzero_ιπ) := by
      rwa [hfac_lift]
    exact CategoryTheory.epi_of_epi q_sh (CategoryTheory.Limits.kernel.lift π' ι₀ hzero_ιπ)

  have hSE_U₁ : (CategoryTheory.ShortComplex.mk ι₀ π' hzero_ιπ).ShortExact :=
    { exact := hEx_ιπ
      mono_f := hMono_ι₀
      epi_g := hEpi_π' }

  
  have hTor_ℱ : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0 := by
    change ℓ • CategoryTheory.CategoryStruct.id (R1_F.obj L₁) = 0
    rw [← R1_F.map_id, ← R1_F.map_nsmul, hTor_L₁, R1_F.map_zero]

  obtain ⟨V'_sch, hAff_V', hConn_V', h₁, v', hEt_h₁, hv'_cl, hv'_map, hUniv_pull⟩ :=
    weil_etale_pointed_epi_basis_lift_and_split_pullback k ℓ δ m₀ b₁ U₁ p_U₁ u_U₁ u₁ hu₁
      ℱ hTor_ℱ ι₀ π' hzero_ιπ hSE_U₁

  refine ⟨V'_sch, hAff_V', hConn_V', h₁, v', hEt_h₁, hv'_cl, hv'_map, ?_⟩
  intro V''_sch _ q _ Y'' p_Y f'' W''_open hPb hW''_eq
  dsimp only
  let W''_et : Y''.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ W''_open.ι inferInstance

  have hFreeYoneda_comp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₀ : S.Etale}
        {F₁ F₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S ℓ U₀ ⟶ F₁) (g : F₁ ⟶ F₂),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op U₀) := by
    intro S U₀ F₁ F₂ α g
    let adj_S := CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
    let P₀ := CategoryTheory.Presheaf.freeYoneda U₀ AM
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj P₀ ⟶ F₁ := α
    change CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj_S.homEquiv P₀ F₂) (α' ≫ g)) =
      CategoryTheory.Presheaf.freeYonedaHomEquiv ((adj_S.homEquiv P₀ F₁) α') ≫
        g.hom.app (Opposite.op U₀)
    rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Adjunction.homEquiv_unit,
      (CategoryTheory.sheafToPresheaf _ _).map_comp,
      CategoryTheory.Presheaf.freeYonedaHomEquiv_comp]
    rfl

  have hLocalTorsionMap_comp_id :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁_e U₂_e : S.Etale}
        (u_f : U₁_e ⟶ U₂_e) (u_b : U₂_e ⟶ U₁_e),
        u_f ≫ u_b = CategoryTheory.CategoryStruct.id U₁_e →
        weilEtaleLocalTorsionMap S ℓ u_f ≫ weilEtaleLocalTorsionMap S ℓ u_b =
          CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S ℓ U₁_e) := by
    intro S U₁_e U₂_e u_f u_b hub
    let L_a := weilEtaleLocalTorsionSheaf S ℓ U₁_e
    let L_b := weilEtaleLocalTorsionSheaf S ℓ U₂_e
    let φ_f := weilEtaleLocalTorsionMap S ℓ u_f
    let φ_b := weilEtaleLocalTorsionMap S ℓ u_b
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    have hφf : CategoryTheory.Sheaf.freeYonedaHomEquiv φ_f =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_b) ≫
          L_b.obj.map u_f.op := by
      dsimp [φ_f, weilEtaleLocalTorsionMap]
      exact Equiv.apply_symm_apply _ _
    have hφb : CategoryTheory.Sheaf.freeYonedaHomEquiv φ_b =
        CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_a) ≫
          L_a.obj.map u_b.op := by
      dsimp [φ_b, weilEtaleLocalTorsionMap]
      exact Equiv.apply_symm_apply _ _
    rw [hFreeYoneda_comp φ_f φ_b, hφf, CategoryTheory.Category.assoc,
      φ_b.hom.naturality u_f.op, ← CategoryTheory.Category.assoc,
      ← hFreeYoneda_comp (CategoryTheory.CategoryStruct.id L_b) φ_b,
      CategoryTheory.Category.id_comp, hφb, CategoryTheory.Category.assoc,
      ← L_a.obj.map_comp, ← op_comp, hub, op_id, L_a.obj.map_id,
      CategoryTheory.Category.comp_id]

  let BW₁ : Y''.Etale := (weilEtaleSitePullback p_Y).obj W₁_et
  let bw_hom : BW₁.left ⟶ Y'' := BW₁.hom
  have hOpen_bw : AlgebraicGeometry.IsOpenImmersion bw_hom := by
    change AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.snd W₁_open.ι p_Y)
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (CategoryTheory.IsPullback.of_hasPullback W₁_open.ι p_Y) inferInstance
  haveI : AlgebraicGeometry.IsOpenImmersion bw_hom := hOpen_bw
  have hRange_bw : Set.range ⇑bw_hom = Set.range ⇑W''_open.ι := by
    have hRange_W'' : Set.range ⇑W''_open.ι = p_Y.base ⁻¹' (W₁_open : Set ↥Y₁) := by
      have h1 : Set.range ⇑W''_open.ι = (W''_open : Set ↥Y'') := by
        ext y
        exact ⟨fun ⟨x, hx⟩ => hx ▸ x.2, fun hy => ⟨⟨y, hy⟩, rfl⟩⟩
      rw [h1, hW''_eq]
      rfl
    rw [hRange_W'']
    ext y
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨z, rfl⟩
      have hcomm_z : p_Y.base (bw_hom.base z) =
          W₁_open.ι.base ((CategoryTheory.Limits.pullback.fst W₁_open.ι p_Y).base z) := by
        change (CategoryTheory.Limits.pullback.snd W₁_open.ι p_Y ≫ p_Y).base z =
          (CategoryTheory.Limits.pullback.fst W₁_open.ι p_Y ≫ W₁_open.ι).base z
        rw [CategoryTheory.Limits.pullback.condition]
      change p_Y.base (bw_hom.base z) ∈ (W₁_open : Set ↥Y₁)
      rw [hcomm_z]
      exact ((CategoryTheory.Limits.pullback.fst W₁_open.ι p_Y).base z).2
    · intro hy
      obtain ⟨z, -, hz_snd⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := W₁_open.ι) (g := p_Y) ⟨p_Y.base y, hy⟩ y rfl
      exact ⟨z, hz_snd⟩

  let u_fwd_sch : BW₁.left ⟶ W''_open.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift W''_open.ι bw_hom (le_of_eq hRange_bw)
  let u_bwd_sch : W''_open.toScheme ⟶ BW₁.left :=
    AlgebraicGeometry.IsOpenImmersion.lift bw_hom W''_open.ι (le_of_eq hRange_bw.symm)
  have hu_fwd_fac : u_fwd_sch ≫ W''_open.ι = bw_hom :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac W''_open.ι bw_hom (le_of_eq hRange_bw)
  have hu_bwd_fac : u_bwd_sch ≫ bw_hom = W''_open.ι :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac bw_hom W''_open.ι (le_of_eq hRange_bw.symm)

  let u_fwd_et : BW₁ ⟶ W''_et :=
    CategoryTheory.MorphismProperty.Over.homMk u_fwd_sch hu_fwd_fac trivial
  let u_bwd_et : W''_et ⟶ BW₁ :=
    CategoryTheory.MorphismProperty.Over.homMk u_bwd_sch hu_bwd_fac trivial
  have hu_fb : u_fwd_et ≫ u_bwd_et = CategoryTheory.CategoryStruct.id BW₁ := by
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · apply (cancel_mono bw_hom).mp
      change (u_fwd_sch ≫ u_bwd_sch) ≫ bw_hom = 𝟙 BW₁.left ≫ bw_hom
      rw [CategoryTheory.Category.assoc, hu_bwd_fac, hu_fwd_fac, CategoryTheory.Category.id_comp]
    · exact Subsingleton.elim _ _
  have hu_bf : u_bwd_et ≫ u_fwd_et = CategoryTheory.CategoryStruct.id W''_et := by
    apply CategoryTheory.MorphismProperty.Comma.Hom.ext
    · apply (cancel_mono W''_open.ι).mp
      change (u_bwd_sch ≫ u_fwd_sch) ≫ W''_open.ι = 𝟙 W''_open.toScheme ≫ W''_open.ι
      rw [CategoryTheory.Category.assoc, hu_fwd_fac, hu_bwd_fac, CategoryTheory.Category.id_comp]
    · exact Subsingleton.elim _ _

  let L'' := weilEtaleLocalTorsionSheaf Y'' ℓ W''_et
  let e_Wet_L : weilEtaleLocalTorsionSheaf Y'' ℓ BW₁ ≅ L'' :=
    { hom := weilEtaleLocalTorsionMap Y'' ℓ u_fwd_et
      inv := weilEtaleLocalTorsionMap Y'' ℓ u_bwd_et
      hom_inv_id := hLocalTorsionMap_comp_id u_fwd_et u_bwd_et hu_fb
      inv_hom_id := hLocalTorsionMap_comp_id u_bwd_et u_fwd_et hu_bf }

  obtain ⟨e_loc_pY, -⟩ := hProp_loc p_Y
  have hPull_pY : WeilIsEtaleSheafPullback p_Y L₁ L'' :=
    ⟨hc_all p_Y, hr_all p_Y, ⟨(e_loc_pY W₁_et).trans e_Wet_L⟩⟩

  haveI : AlgebraicGeometry.LocallyOfFiniteType (CategoryTheory.Over.mk p_U₁).hom :=
    ‹AlgebraicGeometry.LocallyOfFiniteType p_U₁›
  have hPBC_1 : WeilIsEtaleSheafPullback (q ≫ h₁) ℱ (weilEtaleHigherDirectImage f'' 1 L'') :=
    hPBC (CategoryTheory.Over.mk (f₁ ≫ p_U₁)) (CategoryTheory.Over.mk p_U₁)
      (CategoryTheory.Over.mk ((q ≫ h₁) ≫ p_U₁))
      (CategoryTheory.Over.mk (f'' ≫ ((q ≫ h₁) ≫ p_U₁)))
      (CategoryTheory.Over.homMk f₁ rfl)
      (CategoryTheory.Over.homMk (q ≫ h₁) rfl)
      (CategoryTheory.Over.homMk f'' rfl)
      (CategoryTheory.Over.homMk p_Y (by
        dsimp
        rw [← CategoryTheory.Category.assoc, hPb.w, CategoryTheory.Category.assoc]))
      ‹AlgebraicGeometry.IsProper f₁› hPb L₁ L'' hTor_L₁ hPull_pY 1

  obtain ⟨hc', hr', ⟨e_pbc₁⟩⟩ := hPBC_1
  obtain ⟨e_split⟩ := hUniv_pull V''_sch q hc' hr'
  exact ⟨e_split.trans e_pbc₁⟩

theorem weil_etale_rel_curve_cover_r1_constancy (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hProjCurveNonDeg :
      ∀ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral C_bar.left →
        IsProjectiveOverField k C_bar →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom],
          Finite (weilCupPDModH C_bar.left ℓ 1) ∧
          ∀ a : weilCupPDModH C_bar.left ℓ 1,
            (∀ b : weilCupPDModH C_bar.left ℓ 1,
              CategoryTheory.Abelian.Ext.comp a b (rfl : 1 + 1 = 2) = 0) →
            a = 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (P : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
    (V_base : E.V_bar.left.Etale)
    (g_base : Quiver.Hom V_base P.V)
    (v_base : ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V_base).left)
    (hAff_base : AlgebraicGeometry.IsAffine
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V_base).left)
    (hv_base_cl : IsClosed
      ({v_base} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V_base).left))
    (hv_base_map :
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map g_base).left.base v_base = P.v) :
    ∃ (V' : E.V_bar.left.Etale)
      (h_V : Quiver.Hom V' V_base)
      (v' : ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left)
      (r_rk : ℕ),
      ConnectedSpace ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left ∧
      AlgebraicGeometry.IsAffine
        ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left ∧
      IsClosed ({v'} : Set ↥((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V').left) ∧
      ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map h_V).left.base v' = v_base ∧
      ∀ (V'' : E.V_bar.left.Etale)
        (q_V : Quiver.Hom V'' V')
        (m_V : Quiver.Hom
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V'').left
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left),
        AlgebraicGeometry.IsAffine
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V'').left →
        m_V = ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).map
          (CategoryTheory.CategoryStruct.comp q_V
            (CategoryTheory.CategoryStruct.comp h_V g_base))).left →
        let Y'' := CategoryTheory.Limits.pullback P.f_bar m_V
        let p_Y := CategoryTheory.Limits.pullback.fst P.f_bar m_V
        let f'' := CategoryTheory.Limits.pullback.snd P.f_bar m_V
        let W''_open : Y''.Opens := (TopologicalSpace.Opens.map p_Y.base).obj P.W_open
        let W''_et : Y''.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ W''_open.ι inferInstance
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.constantSheaf
            (((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj V'').left).smallEtaleTopology
            AddCommGrpCat.{u}).obj
            (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin r_rk → ZMod ℓ))))
          (weilEtaleHigherDirectImage f'' 1
            (weilEtaleLocalTorsionSheaf Y'' ℓ W''_et))) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let V_base_sch := (Fgt_V.obj V_base).left
  let P_V_sch := (Fgt_V.obj P.V).left
  let E_V₁_sch := (Fgt_V.obj E.V₁).left

  
  have hEt_of_etale_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (v : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left := by
    intro S U₁ U₂ v
    have hvw : ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom =
        ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₁).hom :=
      CategoryTheory.Over.w ((AlgebraicGeometry.Scheme.Etale.forget S).map v)
    have hEt_comp : AlgebraicGeometry.Etale
        (((AlgebraicGeometry.Scheme.Etale.forget S).map v).left ≫
          ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom) := by
      rw [hvw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      ((AlgebraicGeometry.Scheme.Etale.forget S).map v).left
      ((AlgebraicGeometry.Scheme.Etale.forget S).obj U₂).hom U₂.prop hEt_comp

  have hConnOfIso :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (e : X ≅ Y),
        ConnectedSpace ↥X → ConnectedSpace ↥Y := by
    intro X Y e hX
    have hne : Nonempty ↥Y := let ⟨x⟩ := hX.toNonempty; ⟨e.hom.base x⟩
    have hsurj : Set.range e.hom.base = Set.univ := by
      ext y
      simp only [Set.mem_range, Set.mem_univ, iff_true]
      refine ⟨e.inv.base y, ?_⟩
      change (e.inv ≫ e.hom).base y = y
      rw [e.inv_hom_id]
      rfl
    have hpre : PreconnectedSpace ↥Y := by
      rw [preconnectedSpace_iff_univ, ← hsurj, ← Set.image_univ]
      exact isPreconnected_univ.image e.hom.base e.hom.continuous.continuousOn
    exact { toPreconnectedSpace := hpre, toNonempty := hne }

  have hSecPullback :
      ∀ {Y B Y' B' : AlgebraicGeometry.Scheme.{u}}
        {f : Y ⟶ B} {p_Y : Y' ⟶ Y} {f' : Y' ⟶ B'} {m : B' ⟶ B}
        (hPb : CategoryTheory.IsPullback p_Y f' f m)
        {τ : B ⟶ Y} (hτ_sec : τ ≫ f = 𝟙 B) (hτ_cl : AlgebraicGeometry.IsClosedImmersion τ)
        {τ' : B' ⟶ Y'} (hτ'_fst : τ' ≫ p_Y = m ≫ τ) (hτ'_sec : τ' ≫ f' = 𝟙 B'),
        CategoryTheory.IsPullback m τ' τ p_Y ∧
        AlgebraicGeometry.IsClosedImmersion τ' ∧
        Set.range τ'.base = p_Y.base ⁻¹' Set.range τ.base := by
    intro Y B Y' B' f p_Y f' m hPb τ hτ_sec hτ_cl τ' hτ'_fst hτ'_sec
    have hcond_id : m ≫ 𝟙 B = 𝟙 B' ≫ m := by
      rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    have hPb_id : CategoryTheory.IsPullback m (𝟙 B') (𝟙 B) m :=
      CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hcond_id
          (fun s => s.snd)
          (fun s => s.condition.symm.trans (CategoryTheory.Category.comp_id s.fst))
          (fun s => CategoryTheory.Category.comp_id s.snd)
          (fun s g _ hg₂ => by simpa using hg₂))
    have hPb_outer : CategoryTheory.IsPullback m (τ' ≫ f') (τ ≫ f) m := by
      rwa [hτ'_sec, hτ_sec]
    have hPb_top : CategoryTheory.IsPullback m τ' τ p_Y :=
      CategoryTheory.IsPullback.of_bot hPb_outer hτ'_fst.symm hPb
    have hCl' : AlgebraicGeometry.IsClosedImmersion τ' :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top hτ_cl
    refine ⟨hPb_top, hCl', ?_⟩
    ext y'
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨b', rfl⟩
      refine ⟨m.base b', ?_⟩
      change (m ≫ τ).base b' = (τ' ≫ p_Y).base b'
      rw [hτ'_fst]
    · rintro ⟨b, hb⟩
      let iso_top := hPb_top.isoPullback
      obtain ⟨z, _, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := τ) (g := p_Y) b y' hb
      refine ⟨iso_top.inv.base z, ?_⟩
      have h_snd : iso_top.inv ≫ τ' = CategoryTheory.Limits.pullback.snd τ p_Y :=
        hPb_top.isoPullback_inv_snd
      change (iso_top.inv ≫ τ').base z = y'
      rw [h_snd]
      exact hz₂

  let g_base_sch : V_base_sch ⟶ P_V_sch := (Fgt_V.map g_base).left
