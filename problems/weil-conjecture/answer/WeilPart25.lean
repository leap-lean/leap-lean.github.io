    let f'_ZU : Z_U ⟶ AlgebraicGeometry.Spec (CommRingCat.of B_U) := f_ZU ≫ e_U.hom
    haveI : AlgebraicGeometry.Flat f'_ZU := inferInstance
    haveI : AlgebraicGeometry.LocallyOfFinitePresentation f'_ZU := inferInstance

    let s_U_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of B_U) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_U_Ω)
    let s_sp_Ω : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ S_B :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_sp_Ω)

