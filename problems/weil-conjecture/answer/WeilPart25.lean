  haveI : AlgebraicGeometry.IsProper (P.e_W.hom ≫ j_WQ) :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.IsProper)
      (W' := @AlgebraicGeometry.IsSeparated) (P.e_W.hom ≫ j_WQ) ψ_Q inferInstance inferInstance
  have hProp_jWQ : AlgebraicGeometry.IsProper j_WQ := by
    have h1 : AlgebraicGeometry.IsProper (P.e_W.inv ≫ (P.e_W.hom ≫ j_WQ)) := inferInstance
    rwa [← CategoryTheory.Category.assoc, P.e_W.inv_hom_id, CategoryTheory.Category.id_comp] at h1
  haveI : AlgebraicGeometry.IsProper j_WQ := hProp_jWQ
