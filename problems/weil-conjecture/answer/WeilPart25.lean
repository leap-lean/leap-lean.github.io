    obtain ⟨p'_1, hp'_1⟩ := hPullPkg.1 ι'_pt ℓ 1
    obtain ⟨p'_2, hp'_2⟩ := hPullPkg.1 ι'_pt ℓ 2
    obtain ⟨p'_α, hp'_α⟩ := hPullPkg.1 (CategoryTheory.CategoryStruct.comp ι'_pt p_Ypt) ℓ 2
