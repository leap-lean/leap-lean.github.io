    have hPull_e_inv :
        CategoryTheory.CategoryStruct.comp (pb_g.map (e_loc S₂).inv) πM =
          CategoryTheory.CategoryStruct.comp β_L (e_loc S₁).inv := by
      calc
        pb_g.map (e_loc S₂).inv ≫ πM
          = pb_g.map (e_loc S₂).inv ≫ (πM ≫ (e_loc S₁).hom) ≫ (e_loc S₁).inv := by
              rw [CategoryTheory.Category.assoc πM, (e_loc S₁).hom_inv_id,
                CategoryTheory.Category.comp_id]
        _ = pb_g.map (e_loc S₂).inv ≫ (pb_g.map (e_loc S₂).hom ≫ β_L) ≫ (e_loc S₁).inv := by
              rw [hPull_e_hom]
