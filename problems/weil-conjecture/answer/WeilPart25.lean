    let eθ_Cu_1 := AddEquiv.ofBijective θ_Cu_1 hbij_Cu_1
    haveI : Finite (weilEtaleTorsionH C_u.left ℓ 1) := Finite.of_equiv _ eθ_Cu_1.toEquiv
    have hcard_dom : Nat.card (Fin b_pt → ZMod ℓ) = ℓ ^ b_pt := by
