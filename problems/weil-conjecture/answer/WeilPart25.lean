        CategoryTheory.Limits.pullback.fst ((AlgebraicGeometry.Scheme.Etale.forget S).obj U).hom ν_S :=
    fun _ _ _ _ _ => CategoryTheory.Limits.pullback.lift_fst _ _ _

  have hρ_lift_snd :
      ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
        (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
        (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
        (U : S.Etale) (a : ZMod ℓ),
        CategoryTheory.CategoryStruct.comp (ρ_lift ν_S ρ_S hρ_over U a)
