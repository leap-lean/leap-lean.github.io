    intro S Z_S ν_S ρ_S hρ_over U₁ U₂ u a
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, hρ_lift_fst ν_S ρ_S hρ_over U₁ a, hSiteMap_fst ν_S u,
        CategoryTheory.Category.assoc, hSiteMap_fst ν_S u,
        ← CategoryTheory.Category.assoc, hρ_lift_fst ν_S ρ_S hρ_over U₂ a]
    · rw [CategoryTheory.Category.assoc, hρ_lift_snd ν_S ρ_S hρ_over U₁ a,
        ← CategoryTheory.Category.assoc (map_W ν_S u), hSiteMap_snd ν_S u,
        CategoryTheory.Category.assoc, hSiteMap_snd ν_S u, hρ_lift_snd ν_S ρ_S hρ_over U₂ a]

  let resLC : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      {U₁ U₂ : S.Etale} (u : Quiver.Hom U₂ U₁),
      LocallyConstant ↥(W_obj ν_S U₁) (ULift.{u} (ZMod ℓ)) →
        LocallyConstant ↥(W_obj ν_S U₂) (ULift.{u} (ZMod ℓ)) :=
    fun {_ _} ν_S {_ _} u q =>
      { toFun := fun w => q ((map_W ν_S u).base w)
        isLocallyConstant := fun t =>
          (map_W ν_S u).continuous.isOpen_preimage _ (q.isLocallyConstant t) }

  let shiftLC : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (U : S.Etale) (a : ZMod ℓ),
      LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)) →
        LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)) :=
    fun ν_S ρ_S hρ_over U a q =>
      { toFun := fun w => q ((ρ_lift ν_S ρ_S hρ_over U a).base w)
        isLocallyConstant := fun t =>
          (ρ_lift ν_S ρ_S hρ_over U a).continuous.isOpen_preimage _ (q.isLocallyConstant t) }

  let trLC : ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
      (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
      (U : S.Etale),
      LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)) →
        LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)) :=
    fun ν_S ρ_S hρ_over U q => ∑ a : ZMod ℓ, shiftLC ν_S ρ_S hρ_over U a q

  have htrLC_apply :
      ∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
        (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
        (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
        (U : S.Etale) (q : LocallyConstant ↥(W_obj ν_S U) (ULift.{u} (ZMod ℓ)))
