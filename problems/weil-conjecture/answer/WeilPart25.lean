          CategoryTheory.CategoryStruct.comp (ι_V a) fst₁ = CategoryTheory.CategoryStruct.id W_U :=
        fun _ => CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hι_m₁ : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ι_V a) m₁ = ρ_U a := by
