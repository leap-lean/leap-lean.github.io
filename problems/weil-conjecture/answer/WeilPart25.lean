      obtain ⟨⟨c₁, d₁⟩, hd₁⟩ := IsLocalization.surj m.primeCompl (u_x : Rx)
      obtain ⟨⟨c₂, d₂⟩, hd₂⟩ := IsLocalization.surj m.primeCompl ((u_x⁻¹ : Units Rx) : Rx)
