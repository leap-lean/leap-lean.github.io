      have hm_assoc := AlgebraicGeometry.Scheme.Hom.appLE_map_assoc f
        (hle_f_top (val_U j)) (CategoryTheory.homOfLE h_ij).op (𝟙 _)
      simpa only [Category.comp_id] using hm_assoc
