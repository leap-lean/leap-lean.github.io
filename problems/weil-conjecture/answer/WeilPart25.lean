        inv_hom_id := by
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext opW
          change F_U.obj.map ((e_site_a a).hom.app (Opposite.unop opW)).op ≫
            F_U.obj.map ((e_site_a a).inv.app (Opposite.unop opW)).op = 𝟙 _
          rw [← F_U.obj.map_comp, ← op_comp, (e_site_a a).inv_hom_id_app, op_id, F_U.obj.map_id] }

  have hη_retract : ∀ a : Fin m_pts,
      η_f₁ ≫ pf_f₁.map (ρ_a a) ≫ (ψ_a a).hom = CategoryTheory.CategoryStruct.id F_U := by
