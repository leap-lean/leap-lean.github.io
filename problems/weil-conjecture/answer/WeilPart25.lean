          have hσ'_ι : σ' j ≫ ι_y = (s_E j ≫ fst_E ≫ e₂.hom) ≫ U₂.ι :=
            (CategoryTheory.Category.assoc (s_E j) hom_Z ι_y).trans
              ((congrArg (s_E j ≫ ·) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
