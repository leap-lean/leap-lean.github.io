            (bc_Tk (θ_Tk (ι_dom (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey))))) hn).symm
      refine (hΞ_eval _ j).trans ((congrArg (ev_Y j) hτ_nat_Sj).trans ?_)
      by_cases hij : i = j
      · subst hij
        let w_diag : S_k ⟶ U₂.toScheme := s_E i ≫ fst_E ≫ e₂.hom
        have hw₁_diag :
            w_diag ≫ (δ_hat.left ≫ CategoryTheory.Limits.pullback.fst W₂_et.hom ν) =
              (σ i).left ≫ fst_E :=
          (congrArg (w_diag ≫ ·)
            (CategoryTheory.Limits.pullback.lift_fst e₂.inv U₂.ι hδ_comm)).trans
            ((CategoryTheory.Category.assoc (s_E i) (fst_E ≫ e₂.hom) e₂.inv).trans
              (congrArg (s_E i ≫ ·)
                ((CategoryTheory.Category.assoc fst_E e₂.hom e₂.inv).trans
