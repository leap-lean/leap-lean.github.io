  let u_rel_sch : W₂_sch ⟶ W₁_V₂_open.toScheme :=
    AlgebraicGeometry.IsOpenImmersion.lift W₁_V₂_open.ι (w_Y₂ ≫ ν₂) hRange_wν₂
  have hu_rel_fac : u_rel_sch ≫ W₁_V₂_open.ι = w_Y₂ ≫ ν₂ :=
    AlgebraicGeometry.IsOpenImmersion.lift_fac W₁_V₂_open.ι (w_Y₂ ≫ ν₂) hRange_wν₂
  haveI : AlgebraicGeometry.Etale u_rel_sch :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      (W' := @AlgebraicGeometry.Etale)
      u_rel_sch W₁_V₂_open.ι inferInstance (by rw [hu_rel_fac]; infer_instance)

  let W₂_Y₁ : Y₁_V₂.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (w_Y₂ ≫ ν₂) inferInstance
  let u_rel : W₂_Y₁ ⟶ W₁_V₂_et :=
    CategoryTheory.MorphismProperty.Over.homMk u_rel_sch hu_rel_fac trivial

  let W₁_V₂_Ybar : E.Y_bar.left.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (W₁_V₂_open.ι ≫ g_Y₁_V₂) inferInstance
  let u_rel_Ybar : W₂ ⟶ W₁_V₂_Ybar :=
    CategoryTheory.MorphismProperty.Over.homMk u_rel_sch
      (((CategoryTheory.Category.assoc u_rel_sch W₁_V₂_open.ι g_Y₁_V₂).symm.trans
