  have h_ann_pull :
      ∀ (ℱ : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R))
        (W : (S₁.Etale)ᵒᵖ) (x : (P_pull_ℤ.obj (U_std_2.obj ℱ)).obj.obj W),
        (m : ℤ) • x = 0 := by
    intro ℱ W x
    have hm_zero_R : ((m : ℤ) : R) = 0 := by
      apply ULift.ext
      change ((m : ℤ) : ZMod m) = 0
      simp
    have hm_id_mod : (m : ℤ) • CategoryTheory.CategoryStruct.id ℱ = 0 := by
      apply CategoryTheory.Sheaf.hom_ext
      ext V y
      change (m : ℤ) • y = 0
      rw [← Int.cast_smul_eq_zsmul R (m : ℤ) y, hm_zero_R, zero_smul]
    have hm_id_pull :
        (m : ℤ) • CategoryTheory.CategoryStruct.id (P_pull_ℤ.obj (U_std_2.obj ℱ)) = 0 := by
      calc
        (m : ℤ) • CategoryTheory.CategoryStruct.id (P_pull_ℤ.obj (U_std_2.obj ℱ))
          = P_pull_ℤ.map (U_std_2.map ((m : ℤ) • CategoryTheory.CategoryStruct.id ℱ)) := by
              rw [CategoryTheory.Functor.map_zsmul, CategoryTheory.Functor.map_zsmul,
                  CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
        _ = P_pull_ℤ.map (U_std_2.map 0) := by rw [hm_id_mod]
        _ = 0 := by rw [CategoryTheory.Functor.map_zero, CategoryTheory.Functor.map_zero]
    exact congrArg (fun φ : P_pull_ℤ.obj (U_std_2.obj ℱ) ⟶ P_pull_ℤ.obj (U_std_2.obj ℱ) =>
      (φ.hom.app W).hom x) hm_id_pull

  let liftPullObj : CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R) →
      CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R) := fun ℱ =>
    let 𝒜 := P_pull_ℤ.obj (U_std_2.obj ℱ)
    let mkObj : ∀ W : (S₁.Etale)ᵒᵖ, ModuleCat.{u, u} R := fun W =>
      letI : Module R ↥(𝒜.obj.obj W) := valMinAbsModule ↥(𝒜.obj.obj W) (h_ann_pull ℱ W)
      ModuleCat.of R ↥(𝒜.obj.obj W)
    let P_mod : (S₁.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
      { obj := mkObj
        map := fun {W₁ W₂} u =>
          fgtModFF.preimage (X := mkObj W₁) (Y := mkObj W₂) (𝒜.obj.map u)
        map_id := fun W => by
          apply fgtModFF.map_injective
          rw [fgtModFF.map_preimage, 𝒜.obj.map_id]
          rfl
        map_comp := fun u v => by
          apply fgtModFF.map_injective
          rw [fgtModFF.map_preimage, 𝒜.obj.map_comp, FgtMod.map_comp,
              fgtModFF.map_preimage, fgtModFF.map_preimage] }
    ⟨P_mod, fun E => by
      let isoE : (P_mod ⋙ coyoneda.obj (Opposite.op E)) ≅
          (𝒜.obj ⋙ coyoneda.obj (Opposite.op (FgtMod.obj E))) :=
        NatIso.ofComponents
          (fun W => (fgtModFF.homEquiv (X := E) (Y := mkObj W)).toIso)
          (fun {W₁ W₂} u => by
            ext g
            change FgtMod.map (g ≫ P_mod.map u) = FgtMod.map g ≫ 𝒜.obj.map u
            rw [FgtMod.map_comp, fgtModFF.map_preimage])
      exact Presieve.isSheaf_iso J₁ isoE.symm (𝒜.property (FgtMod.obj E))⟩

  let P_pull_R : CategoryTheory.Functor
      (CategoryTheory.Sheaf J₂ (ModuleCat.{u, u} R))
      (CategoryTheory.Sheaf J₁ (ModuleCat.{u, u} R)) :=
    { obj := liftPullObj
      map := fun {ℱ₁ ℱ₂} u =>
        uStdFF_1.preimage (X := liftPullObj ℱ₁) (Y := liftPullObj ℱ₂)
          (P_pull_ℤ.map (U_std_2.map u))
      map_id := fun ℱ => by
        apply uStdFF_1.map_injective
        refine (uStdFF_1.map_preimage _).trans ?_
        change P_pull_ℤ.map (U_std_2.map (𝟙 ℱ)) = U_std_1.map (𝟙 (liftPullObj ℱ))
        rw [U_std_2.map_id, P_pull_ℤ.map_id, U_std_1.map_id]
        rfl
      map_comp := fun u v => by
        apply uStdFF_1.map_injective
        refine (uStdFF_1.map_preimage _).trans ?_
        rw [U_std_1.map_comp]
        refine Eq.trans ?_ (congrArg₂ CategoryTheory.CategoryStruct.comp
          (uStdFF_1.map_preimage _).symm (uStdFF_1.map_preimage _).symm)
        change P_pull_ℤ.map (U_std_2.map (u ≫ v)) =
          P_pull_ℤ.map (U_std_2.map u) ≫ P_pull_ℤ.map (U_std_2.map v)
        rw [U_std_2.map_comp, P_pull_ℤ.map_comp] }

  
  have hPullComm_def : P_pull_R.comp U_std_1 = U_std_2.comp P_pull_ℤ :=
    CategoryTheory.Functor.ext (fun _ => rfl) (fun ℱ₁ ℱ₂ u => by
      change U_std_1.map (P_pull_R.map u) = P_pull_ℤ.map (U_std_2.map u)
      exact uStdFF_1.map_preimage _)

  let P_push_R := B.sheafPushforwardContinuous (ModuleCat.{u, u} R) J₂ J₁
  let adj_pull_R : P_pull_R ⊣ P_push_R :=
    CategoryTheory.Adjunction.mkOfHomEquiv
      { homEquiv := fun ℱ 𝒢 =>
          { toFun := fun φ =>
              let φ' : P_pull_ℤ.obj (U_std_2.obj ℱ) ⟶ U_std_1.obj 𝒢 := U_std_1.map φ
              let ψ' : U_std_2.obj ℱ ⟶ U_std_2.obj (P_push_R.obj 𝒢) :=
                (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)) φ'
              uStdFF_2.preimage ψ'
            invFun := fun ψ =>
              let ψ' : U_std_2.obj ℱ ⟶ P_push_ℤ.obj (U_std_1.obj 𝒢) := U_std_2.map ψ
              let φ' : U_std_1.obj (P_pull_R.obj ℱ) ⟶ U_std_1.obj 𝒢 :=
                (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)).symm ψ'
              uStdFF_1.preimage φ'
            left_inv := fun φ => by
              apply uStdFF_1.map_injective
              refine (uStdFF_1.map_preimage _).trans ?_
              have h2 : U_std_2.map
                  (uStdFF_2.preimage (X := ℱ) (Y := P_push_R.obj 𝒢)
                    ((adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)) (U_std_1.map φ))) =
                  (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)) (U_std_1.map φ) :=
                uStdFF_2.map_preimage _
              change (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)).symm
                  (U_std_2.map
                    (uStdFF_2.preimage (X := ℱ) (Y := P_push_R.obj 𝒢)
                      ((adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)) (U_std_1.map φ)))) =
                U_std_1.map φ
              rw [h2]
              exact Equiv.symm_apply_apply _ _
            right_inv := fun ψ => by
              apply uStdFF_2.map_injective
              refine (uStdFF_2.map_preimage _).trans ?_
              have h1 : U_std_1.map
                  (uStdFF_1.preimage (X := P_pull_R.obj ℱ) (Y := 𝒢)
                    ((adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)).symm (U_std_2.map ψ))) =
                  (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)).symm (U_std_2.map ψ) :=
                uStdFF_1.map_preimage _
              change (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢))
                  (U_std_1.map
                    (uStdFF_1.preimage (X := P_pull_R.obj ℱ) (Y := 𝒢)
                      ((adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)).symm (U_std_2.map ψ)))) =
                U_std_2.map ψ
              rw [h1]
              exact Equiv.apply_symm_apply _ _ }
        homEquiv_naturality_left_symm := fun {ℱ' ℱ 𝒢} f g => by
          apply uStdFF_1.map_injective
          refine (uStdFF_1.map_preimage _).trans ?_
          rw [U_std_1.map_comp]
          refine Eq.trans ?_ (congrArg₂ CategoryTheory.CategoryStruct.comp
            (uStdFF_1.map_preimage _).symm (uStdFF_1.map_preimage _).symm)
          change (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ') (U_std_1.obj 𝒢)).symm
              (U_std_2.map (f ≫ g)) =
            P_pull_ℤ.map (U_std_2.map f) ≫
              (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)).symm (U_std_2.map g)
          rw [U_std_2.map_comp]
          exact adj_pull_ℤ.homEquiv_naturality_left_symm (U_std_2.map f)
            (show U_std_2.obj ℱ ⟶ P_push_ℤ.obj (U_std_1.obj 𝒢) from U_std_2.map g)
        homEquiv_naturality_right := fun {ℱ 𝒢 𝒢'} f g => by
          apply uStdFF_2.map_injective
          refine (uStdFF_2.map_preimage _).trans ?_
          rw [U_std_2.map_comp]
          refine Eq.trans ?_ (congrArg (fun x => x ≫ U_std_2.map (P_push_R.map g))
            (uStdFF_2.map_preimage _).symm)
          change (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢'))
              (U_std_1.map (f ≫ g)) =
            (adj_pull_ℤ.homEquiv (U_std_2.obj ℱ) (U_std_1.obj 𝒢)) (U_std_1.map f) ≫
              P_push_ℤ.map (U_std_1.map g)
          rw [U_std_1.map_comp]
          exact adj_pull_ℤ.homEquiv_naturality_right (U_std_1.map f) (U_std_1.map g) }

  have : CategoryTheory.Limits.PreservesColimitsOfSize.{0, 0} P_pull_R :=
