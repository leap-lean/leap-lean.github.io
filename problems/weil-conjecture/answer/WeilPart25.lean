        (CategoryTheory.Adjunction.homEquiv_unit adj_Y AM
          ((pf_ιV.comp pf_pV).obj (FM C_0)) _).trans
          (congrArg (fun η => adj_Y.unit.app AM ≫ η.hom.app (Opposite.op T_Y)) hRHS_mor)
      refine hL_ev.trans (Eq.trans ?_ hR_ev.symm)
      have h_mid : adj_Y.unit.app AM ≫ (η_pV ≫ pf_pV.map η_ιV).hom.app (Opposite.op T_Y) =
          adj_C.unit.app AM ≫ (FM C_0).obj.map (Opposite.op (B_ιV.map τ_pV ≫ τ_ιV)) := by
        have hs1 := (Category.assoc (adj_Y.unit.app AM)
          (η_pV.hom.app (Opposite.op T_Y)) (η_ιV.hom.app (Opposite.op (B_pV.obj T_Y)))).symm
        have hs2 := (congrArg (fun k => k ≫ η_ιV.hom.app (Opposite.op (B_pV.obj T_Y))) h_pV').trans
          (Category.assoc _ _ _)
        have hs3 := (congrArg (CategoryStruct.comp (adj_YV.unit.app AM))
          (η_ιV.hom.naturality (Opposite.op τ_pV))).trans (Category.assoc _ _ _).symm
        have hs4 := (congrArg (fun k => k ≫ (FM C_0).obj.map (Opposite.op (B_ιV.map τ_pV)))
          h_ιV').trans (Category.assoc _ _ _)
        have hs5 := congrArg (CategoryStruct.comp (adj_C.unit.app AM))
          ((FM C_0).obj.map_comp (Opposite.op τ_ιV) (Opposite.op (B_ιV.map τ_pV))).symm
        exact hs1.trans (hs2.trans (hs3.trans (hs4.trans hs5)))
      have h_rhs_ev : adj_Y.unit.app AM ≫ (η_pt ≫ e_pf.inv.app (FM C_0)).hom.app (Opposite.op T_Y) =
          adj_C.unit.app AM ≫ (FM C_0).obj.map (Opposite.op (e_B.hom.app T_Y ≫ τ_pt)) := by
        have he_pf_inv : (e_pf.inv.app (FM C_0)).hom.app (Opposite.op T_Y) =
            (FM C_0).obj.map (Opposite.op (e_B.hom.app T_Y)) := Category.comp_id _
        have hr1 := (congrArg (fun k => adj_Y.unit.app AM ≫ (η_pt.hom.app (Opposite.op T_Y) ≫ k))
          he_pf_inv).trans (Category.assoc _ _ _).symm
        have hr2 := (congrArg (fun k => k ≫ (FM C_0).obj.map (Opposite.op (e_B.hom.app T_Y)))
          h_pt').trans (Category.assoc _ _ _)
        have hr3 := congrArg (CategoryStruct.comp (adj_C.unit.app AM))
          ((FM C_0).obj.map_comp (Opposite.op τ_pt) (Opposite.op (e_B.hom.app T_Y))).symm
        exact hr1.trans (hr2.trans hr3)
      exact h_mid.trans ((congrArg (fun k => adj_C.unit.app AM ≫ (FM C_0).obj.map (Opposite.op k))
        (hT_C.hom_ext _ _)).trans h_rhs_ev.symm)

    let cℤ_ιV := cM_can ι_V Aℤ
    have : CategoryTheory.IsIso cℤ_ιV := hConstIso ι_V Aℤ
    have h_φ_compat : pb_ιV.map φ_V ≫ e_pb.hom.app Q = cℤ_ιV ≫ φ₀ := by
      let Fgt_C := AlgebraicGeometry.Scheme.Etale.forget C_0
      let Fgt_YV := AlgebraicGeometry.Scheme.Etale.forget Y_V
      let τ_ιV : B_ιV.obj T_YV ⟶ T_C := hT_C.from (B_ιV.obj T_YV)
      let σ_ιV_left : C_0 ⟶ (B_ιV.obj T_YV).left :=
        CategoryTheory.Limits.pullback.lift ι_V (𝟙 C_0)
          ((Category.comp_id ι_V).trans (Category.id_comp ι_V).symm)
      let σ_ιV : T_C ⟶ B_ιV.obj T_YV :=
        CategoryTheory.MorphismProperty.Over.homMk σ_ιV_left
          (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
      have h_τσ_ιV : τ_ιV ≫ σ_ιV = 𝟙 (B_ιV.obj T_YV) := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · have h1 : ((Fgt_C.map τ_ιV).left ≫ σ_ιV_left) ≫
              CategoryTheory.Limits.pullback.fst (Fgt_YV.obj T_YV).hom ι_V =
            (Fgt_C.map τ_ιV).left ≫ ι_V :=
            (Category.assoc _ _ _).trans
              (congrArg (CategoryStruct.comp (Fgt_C.map τ_ιV).left)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _))
          have hw : (Fgt_C.map τ_ιV).left = (Fgt_C.obj (B_ιV.obj T_YV)).hom :=
            (Category.comp_id _).symm.trans (CategoryTheory.MorphismProperty.Over.w τ_ιV)
          have hcond : (Fgt_C.obj (B_ιV.obj T_YV)).hom ≫ ι_V =
              CategoryTheory.Limits.pullback.fst (Fgt_YV.obj T_YV).hom ι_V :=
            (CategoryTheory.Limits.pullback.condition
              (f := (Fgt_YV.obj T_YV).hom) (g := ι_V)).symm.trans (Category.comp_id _)
          exact h1.trans ((congrArg (fun k => k ≫ ι_V) hw).trans
            (hcond.trans (Category.id_comp _).symm))
        · have h1 : ((Fgt_C.map τ_ιV).left ≫ σ_ιV_left) ≫
              CategoryTheory.Limits.pullback.snd (Fgt_YV.obj T_YV).hom ι_V =
            (Fgt_C.map τ_ιV).left :=
            (Category.assoc _ _ _).trans
              ((congrArg (CategoryStruct.comp (Fgt_C.map τ_ιV).left)
                (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans (Category.comp_id _))
          have hw : (Fgt_C.map τ_ιV).left = (Fgt_C.obj (B_ιV.obj T_YV)).hom :=
            (Category.comp_id _).symm.trans (CategoryTheory.MorphismProperty.Over.w τ_ιV)
          exact h1.trans (hw.trans (Category.id_comp _).symm)

      apply (adj_ιV.homEquiv (Fℤ Y_V) (pb_pt.obj Q)).injective
      apply (adj_YV.homEquiv Aℤ (pf_ιV.obj (pb_pt.obj Q))).injective
      apply hAℤ_ext

      have hLHS_mor : adj_ιV.homEquiv (Fℤ Y_V) (pb_pt.obj Q) (pb_ιV.map φ_V ≫ e_pb.hom.app Q) =
          φ_V ≫ (adj_ιV.unit.app (pb_pV.obj Q) ≫ pf_ιV.map (e_pb.hom.app Q)) := by
        have h1 := CategoryTheory.Adjunction.homEquiv_unit adj_ιV (Fℤ Y_V) (pb_pt.obj Q)
          (pb_ιV.map φ_V ≫ e_pb.hom.app Q)
        rw [pf_ιV.map_comp, ← Category.assoc] at h1
        exact h1.trans ((congrArg (fun k => k ≫ pf_ιV.map (e_pb.hom.app Q))
          (adj_ιV.unit.naturality φ_V).symm).trans (Category.assoc _ _ _))

      have hRHS_mor : adj_ιV.homEquiv (Fℤ Y_V) (pb_pt.obj Q) (cℤ_ιV ≫ φ₀) =
          (adj_ιV.homEquiv (Fℤ Y_V) (Fℤ C_0) cℤ_ιV) ≫ pf_ιV.map φ₀ :=
        CategoryTheory.Adjunction.homEquiv_naturality_right adj_ιV cℤ_ιV φ₀

      have hφV_eval : ((adj_YV.unit.app Aℤ ≫ φ_V.hom.app (Opposite.op T_YV)).hom)
          (ULift.up (1 : ℤ)) = w_V := by
        have h1 : adj_YV.unit.app Aℤ ≫ φ_V.hom.app (Opposite.op T_YV) = w_V_hom :=
          (CategoryTheory.Adjunction.homEquiv_unit adj_YV Aℤ (pb_pV.obj Q) φ_V).symm.trans
            ((adj_YV.homEquiv Aℤ (pb_pV.obj Q)).apply_symm_apply w_V_hom)
        rw [h1]
        exact one_zsmul w_V

      have hcℤ_eval : adj_YV.unit.app Aℤ ≫
          ((adj_ιV.homEquiv (Fℤ Y_V) (Fℤ C_0)) cℤ_ιV).hom.app (Opposite.op T_YV) =
        adj_C.unit.app Aℤ ≫ (Fℤ C_0).obj.map (Opposite.op τ_ιV) := by
        have h1 := (adj_ιV.homEquiv (Fℤ Y_V) (Fℤ C_0)).congr_arg (h_cM_eq ι_V hT_C hT_YV Aℤ).symm
        rw [Equiv.apply_symm_apply] at h1
        have h2 := (adj_YV.homEquiv Aℤ (pf_ιV.obj (Fℤ C_0))).congr_arg h1
        exact (CategoryTheory.Adjunction.homEquiv_unit adj_YV Aℤ (pf_ιV.obj (Fℤ C_0)) _).symm.trans
          (h2.trans ((adj_YV.homEquiv Aℤ (pf_ιV.obj (Fℤ C_0))).apply_symm_apply _))

      let η_R := (adj_ιV.homEquiv (Fℤ Y_V) (Fℤ C_0)) cℤ_ιV ≫ pf_ιV.map φ₀
      have hRHS_val :
          ((adj_YV.unit.app Aℤ ≫ η_R.hom.app (Opposite.op T_YV)).hom) (ULift.up (1 : ℤ)) =
          ((pb_pt.obj Q).obj.map (Opposite.op τ_ιV)).hom w₀ := by
        have hφ₀_unit : adj_C.unit.app Aℤ ≫ φ₀.hom.app (Opposite.op T_C) =
            (adj_C.homEquiv Aℤ (pb_pt.obj Q)) φ₀ :=
          (CategoryTheory.Adjunction.homEquiv_unit adj_C Aℤ (pb_pt.obj Q) φ₀).symm
        have hs1 := (Category.assoc (adj_YV.unit.app Aℤ)
          (((adj_ιV.homEquiv (Fℤ Y_V) (Fℤ C_0)) cℤ_ιV).hom.app (Opposite.op T_YV))
          (φ₀.hom.app (Opposite.op (B_ιV.obj T_YV)))).symm
        have hs2 := (congrArg (fun k => k ≫ φ₀.hom.app (Opposite.op (B_ιV.obj T_YV)))
          hcℤ_eval).trans (Category.assoc _ _ _)
        have hs3 := (congrArg (CategoryStruct.comp (adj_C.unit.app Aℤ))
          (φ₀.hom.naturality (Opposite.op τ_ιV))).trans (Category.assoc _ _ _).symm
        have hs4 := congrArg (fun k => k ≫ (pb_pt.obj Q).obj.map (Opposite.op τ_ιV)) hφ₀_unit
        exact ConcreteCategory.congr_hom (hs1.trans (hs2.trans (hs3.trans hs4))) (ULift.up (1 : ℤ))

      let ψ'_V : T_C ⟶ B_pt.obj V := σ_ιV ≫ B_ιV.map Δ_V ≫ e_B.hom.app V
      have hψ_eq : ψ'_V = ψ_V := by
        refine CategoryTheory.MorphismProperty.Comma.Hom.ext ?_ (Subsingleton.elim _ _)
        apply CategoryTheory.Limits.pullback.hom_ext
        · have he_cg_fst : (Fgt_C.map (e_B_cg.hom.app V)).left ≫
              CategoryTheory.Limits.pullback.fst p_V ι_0 =
              CategoryTheory.Limits.pullback.fst p_V (ι_V ≫ p_V) :=
            h_congr_hom_left_fst hι_V V
          have he_c_fst : (Fgt_C.map (e_B_c.inv.app V)).left ≫
              CategoryTheory.Limits.pullback.fst p_V (ι_V ≫ p_V) =
              CategoryTheory.Limits.pullback.fst (Fgt_YV.obj (B_pV.obj V)).hom ι_V ≫
                CategoryTheory.Limits.pullback.fst p_V p_V :=
            h_comp_inv_left_fst ι_V p_V V
          have hΔ_map : (Fgt_C.map (B_ιV.map Δ_V)).left ≫
              CategoryTheory.Limits.pullback.fst (Fgt_YV.obj (B_pV.obj V)).hom ι_V =
              CategoryTheory.Limits.pullback.fst (Fgt_YV.obj T_YV).hom ι_V ≫ diag_left := by
            have h1 : (Fgt_C.map (B_ιV.map Δ_V)).left =
                CategoryTheory.Limits.pullback.lift
                  (CategoryTheory.Limits.pullback.fst T_YV.hom ι_V ≫ diag_left)
                  (CategoryTheory.Limits.pullback.snd T_YV.hom ι_V)
                  ((Category.assoc _ _ _).trans
                    ((congrArg _ (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
                      CategoryTheory.Limits.pullback.condition)) :=
              CategoryTheory.MorphismProperty.Over.pullback_map_left _ _ ι_V Δ_V
            exact (congrArg (fun k => k ≫ _) h1).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          let m₁ := (Fgt_C.map (B_ιV.map Δ_V)).left
          let m₂ := (Fgt_C.map (e_B_c.inv.app V)).left
          let m₃ := (Fgt_C.map (e_B_cg.hom.app V)).left
          let f_fst₀ := CategoryTheory.Limits.pullback.fst p_V ι_0
          let f_pV := CategoryTheory.Limits.pullback.fst (Fgt_YV.obj (B_pV.obj V)).hom ι_V
          let f_diag := CategoryTheory.Limits.pullback.fst p_V p_V
          let f_TY := CategoryTheory.Limits.pullback.fst (Fgt_YV.obj T_YV).hom ι_V
          have hs1 : (σ_ιV_left ≫ (m₁ ≫ (m₂ ≫ m₃))) ≫ f_fst₀ =
              σ_ιV_left ≫ (m₁ ≫ (m₂ ≫ (m₃ ≫ f_fst₀))) :=
            (Category.assoc σ_ιV_left (m₁ ≫ (m₂ ≫ m₃)) f_fst₀).trans
              (congrArg (CategoryStruct.comp σ_ιV_left)
                ((Category.assoc m₁ (m₂ ≫ m₃) f_fst₀).trans
                  (congrArg (CategoryStruct.comp m₁) (Category.assoc m₂ m₃ f_fst₀))))
          have hs2 : σ_ιV_left ≫ (m₁ ≫ (f_pV ≫ f_diag)) =
              σ_ιV_left ≫ ((m₁ ≫ f_pV) ≫ f_diag) :=
            congrArg (CategoryStruct.comp σ_ιV_left) (Category.assoc m₁ f_pV f_diag).symm
          have hs3 : σ_ιV_left ≫ ((f_TY ≫ diag_left) ≫ f_diag) =
              (σ_ιV_left ≫ f_TY) ≫ (diag_left ≫ f_diag) :=
            (congrArg (CategoryStruct.comp σ_ιV_left) (Category.assoc f_TY diag_left f_diag)).trans
              (Category.assoc σ_ιV_left f_TY (diag_left ≫ f_diag)).symm
          have hs4a : σ_ιV_left ≫ f_TY = ι_V :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hs4b : diag_left ≫ f_diag = 𝟙 Y_V :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hs4 : (σ_ιV_left ≫ f_TY) ≫ (diag_left ≫ f_diag) = ι_V :=
            (congrArg₂ CategoryStruct.comp hs4a hs4b).trans (Category.comp_id ι_V)
          exact hs1.trans ((congrArg (fun k => σ_ιV_left ≫ (m₁ ≫ (m₂ ≫ k))) he_cg_fst).trans
            ((congrArg (fun k => σ_ιV_left ≫ (m₁ ≫ k)) he_c_fst).trans
              (hs2.trans ((congrArg (fun k => σ_ιV_left ≫ (k ≫ f_diag)) hΔ_map).trans
                (hs3.trans (hs4.trans hψ_V.symm))))))
        · have hw1 : (Fgt_C.map ψ'_V).left ≫
              CategoryTheory.Limits.pullback.snd p_V ι_0 = 𝟙 C_0 :=
            CategoryTheory.MorphismProperty.Over.w ψ'_V
          have hw2 : (Fgt_C.map ψ_V).left ≫
              CategoryTheory.Limits.pullback.snd p_V ι_0 = 𝟙 C_0 :=
            CategoryTheory.MorphismProperty.Over.w ψ_V
          exact hw1.trans hw2.symm

      let η_mid := adj_ιV.unit.app (pb_pV.obj Q) ≫ pf_ιV.map (e_pb.hom.app Q)
      let η_L := φ_V ≫ η_mid
      have hLHS_val :
          ((pb_pt.obj Q).obj.map (Opposite.op σ_ιV)).hom
            (((adj_YV.unit.app Aℤ ≫ η_L.hom.app (Opposite.op T_YV)).hom) (ULift.up (1 : ℤ))) =
          w₀ := by
        have h_step1 :
            ((adj_YV.unit.app Aℤ ≫ η_L.hom.app (Opposite.op T_YV)).hom) (ULift.up (1 : ℤ)) =
            (η_mid.hom.app (Opposite.op T_YV)).hom w_V :=
          congrArg (η_mid.hom.app (Opposite.op T_YV)).hom hφV_eval
        have h_nat_Δ :
            (η_mid.hom.app (Opposite.op T_YV)).hom w_V =
            ((pb_pt.obj Q).obj.map (Opposite.op (B_ιV.map Δ_V))).hom
              ((η_mid.hom.app (Opposite.op (B_pV.obj V))).hom
                (((adj_pV.unit.app Q).hom.app (Opposite.op V)).hom s_Q)) :=
          ConcreteCategory.congr_hom (η_mid.hom.naturality (Opposite.op Δ_V))
            (((adj_pV.unit.app Q).hom.app (Opposite.op V)).hom s_Q)
        have h_comp_V :
            (η_mid.hom.app (Opposite.op (B_pV.obj V))).hom
              (((adj_pV.unit.app Q).hom.app (Opposite.op V)).hom s_Q) =
            ((pb_pt.obj Q).obj.map (Opposite.op (e_B.hom.app V))).hom
              (((adj_pt.unit.app Q).hom.app (Opposite.op V)).hom s_Q) := by
          have h_u := ConcreteCategory.congr_hom
            (congrArg (fun η => η.hom.app (Opposite.op V)) (h_unit_epb Q)) s_Q
          have he_pf_inv : (e_pf.inv.app (pb_pt.obj Q)).hom.app (Opposite.op V) =
              (pb_pt.obj Q).obj.map (Opposite.op (e_B.hom.app V)) := Category.comp_id _
          exact h_u.trans (ConcreteCategory.congr_hom he_pf_inv
            (((adj_pt.unit.app Q).hom.app (Opposite.op V)).hom s_Q))
        have h_chain := (congrArg ((pb_pt.obj Q).obj.map (Opposite.op σ_ιV)).hom
          (h_step1.trans (h_nat_Δ.trans (congrArg
            ((pb_pt.obj Q).obj.map (Opposite.op (B_ιV.map Δ_V))).hom h_comp_V))))
        let m_tail : B_ιV.obj T_YV ⟶ B_pt.obj V := B_ιV.map Δ_V ≫ e_B.hom.app V
        have h_map1 : (pb_pt.obj Q).obj.map (Opposite.op ψ'_V) =
            (pb_pt.obj Q).obj.map (Opposite.op m_tail) ≫
              (pb_pt.obj Q).obj.map (Opposite.op σ_ιV) :=
          (pb_pt.obj Q).obj.map_comp (Opposite.op m_tail) (Opposite.op σ_ιV)
        have h_map2 : (pb_pt.obj Q).obj.map (Opposite.op m_tail) =
            (pb_pt.obj Q).obj.map (Opposite.op (e_B.hom.app V)) ≫
              (pb_pt.obj Q).obj.map (Opposite.op (B_ιV.map Δ_V)) :=
          (pb_pt.obj Q).obj.map_comp (Opposite.op (e_B.hom.app V)) (Opposite.op (B_ιV.map Δ_V))
        have h_map_eq :
            ((pb_pt.obj Q).obj.map (Opposite.op (e_B.hom.app V)) ≫
              (pb_pt.obj Q).obj.map (Opposite.op (B_ιV.map Δ_V))) ≫
              (pb_pt.obj Q).obj.map (Opposite.op σ_ιV) =
            (pb_pt.obj Q).obj.map (Opposite.op ψ_V) :=
          (congrArg (fun k => k ≫ (pb_pt.obj Q).obj.map (Opposite.op σ_ιV)) h_map2.symm).trans
            (h_map1.symm.trans (congrArg (fun k => (pb_pt.obj Q).obj.map (Opposite.op k)) hψ_eq))
        have h_end := (ConcreteCategory.congr_hom h_map_eq
          (((adj_pt.unit.app Q).hom.app (Opposite.op V)).hom s_Q)).trans hs_Q
        exact h_chain.trans h_end

      have hL_ev : ((adj_YV.homEquiv Aℤ (pf_ιV.obj (pb_pt.obj Q)))
          ((adj_ιV.homEquiv (Fℤ Y_V) (pb_pt.obj Q)) (pb_ιV.map φ_V ≫ e_pb.hom.app Q))).hom
          (ULift.up (1 : ℤ)) =
          ((adj_YV.unit.app Aℤ ≫ η_L.hom.app (Opposite.op T_YV)).hom) (ULift.up (1 : ℤ)) :=
        ConcreteCategory.congr_hom
          ((CategoryTheory.Adjunction.homEquiv_unit adj_YV Aℤ (pf_ιV.obj (pb_pt.obj Q)) _).trans
            (congrArg (fun η => adj_YV.unit.app Aℤ ≫ η.hom.app (Opposite.op T_YV)) hLHS_mor))
          (ULift.up (1 : ℤ))
      have hR_ev : ((adj_YV.homEquiv Aℤ (pf_ιV.obj (pb_pt.obj Q)))
          ((adj_ιV.homEquiv (Fℤ Y_V) (pb_pt.obj Q)) (cℤ_ιV ≫ φ₀))).hom
          (ULift.up (1 : ℤ)) =
          ((adj_YV.unit.app Aℤ ≫ η_R.hom.app (Opposite.op T_YV)).hom) (ULift.up (1 : ℤ)) :=
        ConcreteCategory.congr_hom
          ((CategoryTheory.Adjunction.homEquiv_unit adj_YV Aℤ (pf_ιV.obj (pb_pt.obj Q)) _).trans
            (congrArg (fun η => adj_YV.unit.app Aℤ ≫ η.hom.app (Opposite.op T_YV)) hRHS_mor))
          (ULift.up (1 : ℤ))
      rw [hL_ev, hR_ev, hRHS_val, ← hLHS_val]
      set val_L := ((adj_YV.unit.app Aℤ ≫ η_L.hom.app (Opposite.op T_YV)).hom) (ULift.up (1 : ℤ))
      have h_inv_map :
          (pb_pt.obj Q).obj.map (Opposite.op σ_ιV) ≫ (pb_pt.obj Q).obj.map (Opposite.op τ_ιV) =
            𝟙 _ :=
        ((pb_pt.obj Q).obj.map_comp (Opposite.op σ_ιV) (Opposite.op τ_ιV)).symm.trans
          ((congrArg (fun k => (pb_pt.obj Q).obj.map (Opposite.op k)) h_τσ_ιV).trans
            ((pb_pt.obj Q).obj.map_id _))
      exact (ConcreteCategory.congr_hom h_inv_map val_L).symm

    have h_inv_φ : CategoryTheory.inv cℤ_ιV ≫ pb_ιV.map φ_V ≫ e_pb.hom.app Q = φ₀ := by
      rw [h_φ_compat, ← Category.assoc, CategoryTheory.IsIso.inv_hom_id, Category.id_comp]

    refine ⟨γ_V, ?_⟩
    intro p'_V hp'_V
    rcases hp'_V with ⟨hc_w, hr_w, hAdd_w, hLim_w, hColim_w, T₁_w, hT₁_w, T₂_w, hT₂_w,
      ιℤ_w, hιπ_w, hπι_w, hp_apply⟩
    have hc_eq : hc_w = hc_of ι_V := Subsingleton.elim _ _
    subst hc_eq
    have hr_eq : hr_w = hr_of ι_V := Subsingleton.elim _ _
    subst hr_eq
    have hAdd_eq : hAdd_w = hAdd_ιV := Subsingleton.elim _ _
    subst hAdd_eq
    have hLim_eq : hLim_w = hLim_ιV := Subsingleton.elim _ _
    subst hLim_eq
    have hColim_eq : hColim_w = hColim_ιV := Subsingleton.elim _ _
    subst hColim_eq

    let adj₁_w := CategoryTheory.constantSheafAdj C_0.smallEtaleTopology AddCommGrpCat.{u} hT₁_w
