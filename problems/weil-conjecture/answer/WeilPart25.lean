  letI : AlgebraicGeometry.IsIntegral Z_η.left := hInt_Zη
  letI : AlgebraicGeometry.IsProper Z_η.hom := hProp_Zη
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 Z_η.hom := hSm_Zη
  letI : AlgebraicGeometry.IsFinite ν_η := hFin_νη
  letI : AlgebraicGeometry.Surjective ν_η := hSurj_νη

  
  have hIrred_Yη : IrreducibleSpace ↥Y_η := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_η
  obtain ⟨y₀_η⟩ := hIrred_Yη.toNonempty
  have hy₀_top : y₀_η ∈ (⨆ α : Fin N_cov, V α) := by
    rw [hV_top]
    trivial
  obtain ⟨α₀, hy₀_α₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hy₀_top
  haveI : Nonempty ↥(V α₀ : AlgebraicGeometry.Scheme.{u}) := ⟨⟨y₀_η, hy₀_α₀⟩⟩

  obtain ⟨p_ν, hp_ν⟩ := hPullPkg.1 ν_η ℓ 1
  obtain ⟨p_η_sp, hp_η_sp⟩ := hPullPkg.1 ι_η_sp ℓ 1
  obtain ⟨x_sp₀, hx_sp₀⟩ := hx_Zη α₀
  have hle_V₀ : V α₀ ≤ V_sp α₀ := le_of_eq (hV_eq α₀).symm
  have hle_Z₀ : (TopologicalSpace.Opens.map ν_η.base).obj (V α₀) ≤
      (TopologicalSpace.Opens.map ν_η.base).obj (V_sp α₀) :=
    fun _ hz => hle_V₀ hz
  let x₀_Z : ↑(Z_η.left.presheaf.obj
      (Opposite.op ((TopologicalSpace.Opens.map ν_η.base).obj (V α₀)))) :=
    (Z_η.left.presheaf.map (CategoryTheory.homOfLE hle_Z₀).op).hom x_sp₀
  have hx₀_Z_pow :
      x₀_Z ^ ℓ = (ν_η.app (V α₀)).hom
        ((((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
            f_η.appLE ⊤ (V α₀) (fun _ _ => trivial)).hom c_scale.1) *
          (u_Ω α₀).1) :=
    (map_pow (Z_η.left.presheaf.map (CategoryTheory.homOfLE hle_Z₀).op).hom x_sp₀ ℓ).symm.trans
      ((congrArg (Z_η.left.presheaf.map (CategoryTheory.homOfLE hle_Z₀).op).hom hx_sp₀).trans
        ((hAppRes ν_η hle_V₀ hle_Z₀ ((ι_η_sp.app (W_sp α₀)).hom (u_sp α₀).1)).trans
          (congrArg (ν_η.app (V α₀)).hom (hu_sp_η_eq α₀ hle_V₀))))
  have hp_ν_γ : p_ν (θ_η_1 γ_η) = 0 :=
    hu_Ω_kill Z_η hProj_Zη ν_η hν_η_hom α₀ c_scale x₀_Z hx₀_Z_pow p_ν hp_ν

  obtain ⟨_, hKer_gen⟩ := hγ_sp_ker p_η_sp p_ν hp_η_sp hp_ν
  obtain ⟨c₀_mod, hc₀_mod⟩ := hKer_gen (θ_η_1 γ_η) hp_ν_γ
  have hc₀_ne : c₀_mod ≠ 0 := by
    intro hc0
    rw [hc0, ZMod.val_zero, zero_smul] at hc₀_mod
    exact hθγ_ne hc₀_mod
  let d_mod : ZMod ℓ := c₀_mod⁻¹
  have hp_η_sp_γ : p_η_sp γ_sp = θ_η_1 (d_mod.val • γ_η) := by
    have hmul : (d_mod.val * c₀_mod.val) • (p_η_sp γ_sp) = d_mod.val • (θ_η_1 γ_η) := by
      rw [mul_nsmul', hc₀_mod]
    rw [hNsmulMod Y_η 1 (p_η_sp γ_sp)] at hmul
    have hinv_one : (((d_mod.val * c₀_mod.val : ℕ) : ZMod ℓ)) = 1 := by
      push_cast
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      exact inv_mul_cancel₀ hc₀_ne
    rw [hinv_one, ZMod.val_one, one_smul, ← map_nsmul] at hmul
    exact hmul

  
  have hConn_Usp : ConnectedSpace ↥U_sp := by
    change ConnectedSpace (PrimeSpectrum B_sp)
    infer_instance
  letI : ConnectedSpace ↥U_sp := hConn_Usp

  obtain ⟨⟨θ_sp_1, hθ_sp_1, hbij_sp_1⟩, _⟩ := weil_cupPD_mod_comparison_bijective_unique Y_sp ℓ 1
  obtain ⟨⟨θ_sp_2, hθ_sp_2, _⟩, _⟩ := weil_cupPD_mod_comparison_bijective_unique Y_sp ℓ 2
  obtain ⟨⟨θ_η_2, hθ_η_2, _⟩, _⟩ := weil_cupPD_mod_comparison_bijective_unique Y_η ℓ 2
  obtain ⟨⟨θ₀_1, hθ₀_1, hbij₀_1⟩, _⟩ := weil_cupPD_mod_comparison_bijective_unique C₀.left ℓ 1
  obtain ⟨⟨θ₀_2, hθ₀_2, hbij₀_2⟩, _⟩ := weil_cupPD_mod_comparison_bijective_unique C₀.left ℓ 2
  let eθ_sp_1 := AddEquiv.ofBijective θ_sp_1 hbij_sp_1
  let eθ₀_1 := AddEquiv.ofBijective θ₀_1 hbij₀_1
  have heθ_sp_1 : ∀ u : weilEtaleTorsionH Y_sp ℓ 1, θ_sp_1 (eθ_sp_1.symm u) = u :=
    fun u => eθ_sp_1.apply_symm_apply u
  have heθ₀_1 : ∀ u : weilEtaleTorsionH C₀.left ℓ 1, θ₀_1 (eθ₀_1.symm u) = u :=
    fun u => eθ₀_1.apply_symm_apply u

  obtain ⟨p_sp_C, hp_sp_C⟩ := hPullPkg.1 q_sp_C ℓ 1
  obtain ⟨p_η_sp_2, hp_η_sp_2⟩ := hPullPkg.1 ι_η_sp ℓ 2
  obtain ⟨p_η_C_2, hp_η_C_2⟩ := hPullPkg.1 (ι_η_sp ≫ q_sp_C) ℓ 2
  obtain ⟨p₀_sp_1, hp₀_sp_1⟩ := hPullPkg.1 ι₀_sp ℓ 1
  obtain ⟨p₀_sp_2, hp₀_sp_2⟩ := hPullPkg.1 ι₀_sp ℓ 2
  obtain ⟨p₀_C_1, hp₀_C_1⟩ := hPullPkg.1 ι₀ ℓ 1
  obtain ⟨p₀_C_2, hp₀_C_2⟩ := hPullPkg.1 (ι₀_sp ≫ q_sp_C) ℓ 2

  let γ_tilde : weilCupPDModH Y_sp ℓ 1 := eθ_sp_1.symm γ_sp
  let s_sp : Fin b₁ → weilCupPDModH Y_sp ℓ 1 :=
    fun i => eθ_sp_1.symm (p_sp_C (θ_C_1 (s i)))
  let γ₀ : weilCupPDModH C₀.left ℓ 1 := eθ₀_1.symm (p₀_sp_1 γ_sp)
  let s₀ : Fin b₁ → weilCupPDModH C₀.left ℓ 1 :=
    fun i => eθ₀_1.symm (p₀_C_1 (θ_C_1 (s i)))

  have hγ_tilde_η : p_η_sp (θ_sp_1 γ_tilde) = θ_η_1 (d_mod.val • γ_η) := by
    dsimp [γ_tilde]
    rw [heθ_sp_1]
    exact hp_η_sp_γ
  have hι_η_sp_C : ι_η_sp ≫ q_sp_C = ι_η ≫ p_dom := by
    dsimp [q_sp_C]
    rw [← CategoryTheory.Category.assoc, hι_η_sp_q, hι_η_B₁_p]
  have hs_sp_η : ∀ i : Fin b₁, p_η_sp (θ_sp_1 (s_sp i)) = θ_η_1 (s_η i) := by
    intro i
    dsimp [s_sp]
    rw [heθ_sp_1]
    have hp_η_C' : WeilIsTorsionEtalePullback (ι_η_sp ≫ q_sp_C) ℓ 1 p_η_C := by
      rwa [hι_η_sp_C]
    have hcomp := hPullPkg.2.2.1 ι_η_sp q_sp_C ℓ 1 p_η_sp p_sp_C p_η_C
      hp_η_sp hp_sp_C hp_η_C'
    exact (DFunLike.congr_fun hcomp (θ_C_1 (s i))).symm.trans (hs_pull i)

  have hγ_tilde_c₀ : p₀_sp_1 (θ_sp_1 γ_tilde) = θ₀_1 γ₀ := by
    dsimp [γ_tilde, γ₀]
    rw [heθ_sp_1, heθ₀_1]
  have hs_sp_c₀ : ∀ i : Fin b₁, p₀_sp_1 (θ_sp_1 (s_sp i)) = θ₀_1 (s₀ i) := by
    intro i
    dsimp [s_sp, s₀]
    rw [heθ_sp_1, heθ₀_1]
    have hp₀_C_1' : WeilIsTorsionEtalePullback (ι₀_sp ≫ q_sp_C) ℓ 1 p₀_C_1 := by
      rwa [hι₀_sp_C]
    have hcomp := hPullPkg.2.2.1 ι₀_sp q_sp_C ℓ 1 p₀_sp_1 p_sp_C p₀_C_1
      hp₀_sp_1 hp_sp_C hp₀_C_1'
    exact (DFunLike.congr_fun hcomp (θ_C_1 (s i))).symm

  have hp_η_C_2' : WeilIsTorsionEtalePullback (ι_η ≫ p_dom) ℓ 2 p_η_C_2 := by
    rwa [← hι_η_sp_C]
  have hα_η_C_nz : p_η_C_2 α_C ≠ 0 := hα_η_nz p_η_C_2 hp_η_C_2'

  have hOrth_c₀ : ∀ i : Fin b₁,
      CategoryTheory.Abelian.Ext.comp γ₀ (s₀ i) (rfl : 1 + 1 = 2) = 0 := by
    intro i
    obtain ⟨c_cup, hc_cup⟩ :=
      hCupConst_C U_sp g_sp_C Y_sp q_sp_C f_sp hPb_sp_C γ_tilde (s_sp i)
    
    have h_at_η := hc_cup Ω (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_sp_Ω))
      Y_η ι_η_sp f_η hPb_η_sp θ_sp_2 p_η_sp_2 p_η_C_2 hθ_sp_2 hp_η_sp_2 hp_η_C_2
    have hcompat_η := weil_cupPD_pullback_ext_comp_compat hModInj hModUniq
      ι_η_sp ℓ 1 1 2 rfl p_η_sp p_η_sp p_η_sp_2
      θ_sp_1 θ_η_1 θ_sp_1 θ_η_1 θ_sp_2 θ_η_2
      hp_η_sp hp_η_sp hp_η_sp_2
      hθ_sp_1 hθ_η_1 hθ_sp_1 hθ_η_1 hθ_sp_2 hθ_η_2
      γ_tilde (s_sp i) (d_mod.val • γ_η) (s_η i)
      hγ_tilde_η (hs_sp_η i)
    let cupLeft_η : weilCupPDModH Y_η ℓ 1 →+ weilCupPDModH Y_η ℓ 2 :=
      AddMonoidHom.mk'
        (fun x => CategoryTheory.Abelian.Ext.comp x (s_η i) (rfl : 1 + 1 = 2))
        (fun x₁ x₂ => CategoryTheory.Abelian.Ext.add_comp x₁ x₂ (s_η i) (rfl : 1 + 1 = 2))
    have hcup_d_zero :
        CategoryTheory.Abelian.Ext.comp (d_mod.val • γ_η) (s_η i) (rfl : 1 + 1 = 2) = 0 := by
      change cupLeft_η (d_mod.val • γ_η) = 0
      rw [map_nsmul]
      change d_mod.val • CategoryTheory.Abelian.Ext.comp γ_η (s_η i) (rfl : 1 + 1 = 2) = 0
      rw [hOrth i, smul_zero]
    rw [hcompat_η, hcup_d_zero, map_zero] at h_at_η
    have hc_cup_zero : c_cup = 0 := by
      by_contra hc_ne
      have hinv_smul : ((c_cup⁻¹).val * c_cup.val) • (p_η_C_2 α_C) = 0 := by
        rw [mul_nsmul', ← h_at_η, smul_zero]
      rw [hNsmulMod Y_η 2 (p_η_C_2 α_C)] at hinv_smul
      have hinv_one : ((((c_cup⁻¹).val * c_cup.val : ℕ) : ZMod ℓ)) = 1 := by
        push_cast
        rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
        exact inv_mul_cancel₀ hc_ne
      rw [hinv_one, ZMod.val_one, one_smul] at hinv_smul
      exact hα_η_C_nz hinv_smul
    
    have h_at_c₀ := hc_cup k s_τ_sp C₀.left ι₀_sp C₀.hom hPb_c₀_sp
      θ_sp_2 p₀_sp_2 p₀_C_2 hθ_sp_2 hp₀_sp_2 hp₀_C_2
    have hcompat_c₀ := weil_cupPD_pullback_ext_comp_compat hModInj hModUniq
      ι₀_sp ℓ 1 1 2 rfl p₀_sp_1 p₀_sp_1 p₀_sp_2
      θ_sp_1 θ₀_1 θ_sp_1 θ₀_1 θ_sp_2 θ₀_2
      hp₀_sp_1 hp₀_sp_1 hp₀_sp_2
      hθ_sp_1 hθ₀_1 hθ_sp_1 hθ₀_1 hθ_sp_2 hθ₀_2
      γ_tilde (s_sp i) γ₀ (s₀ i)
      hγ_tilde_c₀ (hs_sp_c₀ i)
    rw [hcompat_c₀, hc_cup_zero, ZMod.val_zero, zero_smul] at h_at_c₀
    exact hbij₀_2.1 (h_at_c₀.trans (map_zero θ₀_2).symm)

  
  let cupRight_c₀ : weilCupPDModH C₀.left ℓ 1 →+ weilCupPDModH C₀.left ℓ 2 :=
    AddMonoidHom.mk'
      (fun y => CategoryTheory.Abelian.Ext.comp γ₀ y (rfl : 1 + 1 = 2))
      (fun y₁ y₂ => CategoryTheory.Abelian.Ext.comp_add γ₀ y₁ y₂ (rfl : 1 + 1 = 2))
  have hγ₀_zero : γ₀ = 0 := by
    apply (hProjCurveNonDeg C₀ hInt_C₀ hProj_C₀).2 γ₀
    intro b
    obtain ⟨c, hc⟩ := hSpan_c₀ θ_C_1 θ₀_1 p₀_C_1 hθ_C_1 hθ₀_1 hp₀_C_1 b
    have hb_eq : b = Finset.univ.sum fun i : Fin b₁ => (c i).val • s₀ i := by
      apply hbij₀_1.1
      rw [hc, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_nsmul]
      exact congrArg ((c i).val • ·) (eθ₀_1.apply_symm_apply _).symm
    change cupRight_c₀ b = 0
    rw [hb_eq, map_sum]
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [map_nsmul]
    change (c i).val • CategoryTheory.Abelian.Ext.comp γ₀ (s₀ i) (rfl : 1 + 1 = 2) = 0
    rw [hOrth_c₀ i, smul_zero]

  have hp₀_γ_sp_zero : p₀_sp_1 γ_sp = 0 := by
    calc
      p₀_sp_1 γ_sp = θ₀_1 γ₀ := (eθ₀_1.apply_symm_apply _).symm
      _ = θ₀_1 0 := by rw [hγ₀_zero]
      _ = 0 := map_zero θ₀_1
  exact hγ_sp_c₀_ne p₀_sp_1 hp₀_sp_1 hp₀_γ_sp_zero

theorem weil_etale_proper_h0_finite_and_localTorsion_pullback_iso (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      AlgebraicGeometry.IsProper Y.hom →
      Finite (weilEtaleTorsionH Y.left ℓ 0)) ∧
    (∀ (Z : AlgebraicGeometry.Scheme.{u}),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z ℓ) = 0 ∧
      ∀ (U : Z.Etale),
        ℓ • CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf Z ℓ U) = 0) ∧
    (∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
        [_hc : (weilEtaleSitePullback h).IsContinuous
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology]
        [_hr : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint]
        (A : AddCommGrpCat.{u}),
      CategoryTheory.IsIso
        (weilEtaleConstPullbackHom h
          (weilEtaleIdTerminalIsTerminal.{u} Z₁)
          (weilEtaleIdTerminalIsTerminal.{u} Z₂) A)) ∧
    (∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
        [_hc : (weilEtaleSitePullback h).IsContinuous
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology]
        [_hr : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
          Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint],
      let pb_h := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      ∃ e_loc : ∀ U : Z₂.Etale,
          CategoryTheory.Iso
            (pb_h.obj (weilEtaleLocalTorsionSheaf Z₂ ℓ U))
            (weilEtaleLocalTorsionSheaf Z₁ ℓ ((weilEtaleSitePullback h).obj U)),
        ∀ {U₂ U₁ : Z₂.Etale} (u : Quiver.Hom U₂ U₁),
          CategoryTheory.CategoryStruct.comp
            (pb_h.map (weilEtaleLocalTorsionMap Z₂ ℓ u)) (e_loc U₁).hom =
          CategoryTheory.CategoryStruct.comp
            (e_loc U₂).hom
            (weilEtaleLocalTorsionMap Z₁ ℓ ((weilEtaleSitePullback h).map u))) :=
by
  classical
  have instPB : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have instSBC : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  have hmAM : (ℓ • CategoryTheory.CategoryStruct.id AM : AM ⟶ AM) = 0 := by
    ext ⟨b⟩
    change ULift.up (ℓ • b) = ULift.up 0
    simp
  have hEquiv_comp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {W_et : S.Etale}
        {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S ℓ W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro S W_et F G α g
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  
  have hH0Inj : ∀ (S : AlgebraicGeometry.Scheme.{u}),
      ∃ ev : weilEtaleTorsionH S ℓ 0 → LocallyConstant ↥S (ULift.{u} (ZMod ℓ)),
        Function.Injective ev := by
    intro S
    let J := S.smallEtaleTopology
    let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
    let T_S := weilEtaleIdTerminal.{u} S
    let hT_S := weilEtaleIdTerminalIsTerminal.{u} S
    let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
    let PM := (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM
    let FM := weilEtaleTorsionSheaf S ℓ
    let shAdj := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let adj_c := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S
    let P_lc := weilAltLocConstPresheaf S ℓ
    let unitPM : ∀ (W : S.Etale), AM ⟶ FM.obj.obj (Opposite.op W) :=
      fun W => (shAdj.unit.app PM).app (Opposite.op W)
    have hunitPM_nat : ∀ {W₁ W₂ : S.Etale} (u : W₂ ⟶ W₁) (c : ULift.{u} (ZMod ℓ)),
        (FM.obj.map u.op).hom ((unitPM W₁).hom c) = (unitPM W₂).hom c := by
      intro W₁ W₂ u c
      have hnat := congrArg
        (fun φ : AM ⟶ FM.obj.obj (Opposite.op W₂) => φ.hom c)
        ((shAdj.unit.app PM).naturality u.op)
      dsimp [PM] at hnat
      rw [CategoryTheory.Category.id_comp] at hnat
      exact hnat.symm
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have instComp : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have hEt_hom : ∀ {U₁ U₂ : S.Etale} (g : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale (Fgt.map g).left := by
      intro U₁ U₂ g
      have hvw : (Fgt.map g).left ≫ (Fgt.obj U₂).hom = (Fgt.obj U₁).hom :=
        CategoryTheory.MorphismProperty.Over.w g
      have hEt_comp : AlgebraicGeometry.Etale ((Fgt.map g).left ≫ (Fgt.obj U₂).hom) := by
        rw [hvw]
        exact U₁.prop
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        (Fgt.map g).left (Fgt.obj U₂).hom U₂.prop hEt_comp
    have hMemJ : ∀ (U : S.Etale) (R : CategoryTheory.Sieve U),
        R ∈ J U ↔ ∀ (x : ↥(Fgt.obj U).left),
          ∃ (V : S.Etale) (g : V ⟶ U) (y : ↥(Fgt.obj V).left),
            R.arrows g ∧ P_et (Fgt.map g).left ∧ (Fgt.map g).left y = x := by
      intro U R
      have heq : J = (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
        AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          S (le_refl P_et)
      have hiff := AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S) U R
      exact (iff_of_eq (congrArg
        (fun J' : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J' U) heq)).trans hiff

    have hSh_lc : CategoryTheory.Presheaf.IsSheaf J P_lc := by
      rw [CategoryTheory.Presheaf.isSheaf_iff_isLimit]
      intro U R hR
      have hR_cov := (hMemJ U R).mp hR
      let V_x : ↥(Fgt.obj U).left → S.Etale := fun x => Classical.choose (hR_cov x)
      let g_x : ∀ x, V_x x ⟶ U := fun x => Classical.choose (Classical.choose_spec (hR_cov x))
      let y_x : ∀ x, ↥(Fgt.obj (V_x x)).left :=
        fun x => Classical.choose (Classical.choose_spec (Classical.choose_spec (hR_cov x)))
      have hg_x : ∀ x, R.arrows (g_x x) ∧ P_et (Fgt.map (g_x x)).left ∧
          (Fgt.map (g_x x)).left (y_x x) = x :=
        fun x => Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hR_cov x)))
      let j_x : ↥(Fgt.obj U).left → R.arrows.category :=
        fun x => ⟨CategoryTheory.Over.mk (g_x x), (hg_x x).1⟩
      let toLC : ∀ {W : S.Etale},
          ↑(P_lc.obj (Opposite.op W)) →
            LocallyConstant ↥(Fgt.obj W).left (ULift.{u} (ZMod ℓ)) :=
        fun x => x
      let evalCone : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_lc))
          (j : R.arrows.category),
          s.pt → LocallyConstant ↥(Fgt.obj j.obj.left).left (ULift.{u} (ZMod ℓ)) :=
        fun s j a => (s.π.app (Opposite.op j)).hom a
      have hCompat : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_lc))
          (a : s.pt) (j₁ j₂ : R.arrows.category)
          (y₁ : ↥(Fgt.obj j₁.obj.left).left) (y₂ : ↥(Fgt.obj j₂.obj.left).left),
          (Fgt.map j₁.obj.hom).left y₁ = (Fgt.map j₂.obj.hom).left y₂ →
          evalCone s j₁ a y₁ = evalCone s j₂ a y₂ := by
        intro s a j₁ j₂ y₁ y₂ hy₁₂
        let f₁ := (Fgt.map j₁.obj.hom).left
        let f₂ := (Fgt.map j₂.obj.hom).left
        have : AlgebraicGeometry.Etale f₁ := hEt_hom j₁.obj.hom
        have : AlgebraicGeometry.Etale f₂ := hEt_hom j₂.obj.hom
        have : AlgebraicGeometry.Etale (Fgt.obj j₁.obj.left).hom := j₁.obj.left.prop
        let W_sch := CategoryTheory.Limits.pullback f₁ f₂
        let p₁ : W_sch ⟶ (Fgt.obj j₁.obj.left).left := CategoryTheory.Limits.pullback.fst f₁ f₂
        let p₂ : W_sch ⟶ (Fgt.obj j₂.obj.left).left := CategoryTheory.Limits.pullback.snd f₁ f₂
        have : AlgebraicGeometry.Etale p₁ := inferInstance
        let W_et : S.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ (Fgt.obj j₁.obj.left).hom) inferInstance
        let w₁ : W_et ⟶ j₁.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
        have hw₂_comm : p₂ ≫ j₂.obj.left.hom = W_et.hom := by
          change p₂ ≫ (Fgt.obj j₂.obj.left).hom = p₁ ≫ (Fgt.obj j₁.obj.left).hom
          rw [← (Fgt.map j₂.obj.hom).w, ← (Fgt.map j₁.obj.hom).w,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc]
          exact congrArg (· ≫ (Fgt.obj U).hom) CategoryTheory.Limits.pullback.condition.symm
        let w₂ : W_et ⟶ j₂.obj.left :=
          CategoryTheory.MorphismProperty.Over.homMk p₂ hw₂_comm trivial
        have hw_eq : w₁ ≫ j₁.obj.hom = w₂ ≫ j₂.obj.hom := by
          apply Fgt.map_injective
          apply CategoryTheory.Over.OverMorphism.ext
          exact CategoryTheory.Limits.pullback.condition
        let j_W : R.arrows.category :=
          ⟨CategoryTheory.Over.mk (w₁ ≫ j₁.obj.hom), R.downward_closed j₁.property w₁⟩
        let m₁ : j_W ⟶ j₁ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk w₁ rfl)
        let m₂ : j_W ⟶ j₂ :=
          CategoryTheory.ObjectProperty.homMk (CategoryTheory.Over.homMk w₂ hw_eq.symm)
        obtain ⟨z, hz₁, hz₂⟩ :=
          AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy₁₂
        have hs₁ := congrArg
          (fun φ => toLC (W := j_W.obj.left) (φ.hom a) z) (s.w m₁.op)
        have hs₂ := congrArg
          (fun φ => toLC (W := j_W.obj.left) (φ.hom a) z) (s.w m₂.op)
        change evalCone s j₁ a (p₁ z) = evalCone s j_W a z at hs₁
        change evalCone s j₂ a (p₂ z) = evalCone s j_W a z at hs₂
        rw [hz₁] at hs₁
        rw [hz₂] at hs₂
        exact hs₁.trans hs₂.symm
      let g_fn : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_lc)),
          s.pt → ↥(Fgt.obj U).left → ULift.{u} (ZMod ℓ) :=
        fun s a x => evalCone s (j_x x) a (y_x x)
      have hg_res : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_lc))
          (a : s.pt) (j : R.arrows.category) (y : ↥(Fgt.obj j.obj.left).left),
          g_fn s a ((Fgt.map j.obj.hom).left y) = evalCone s j a y :=
        fun s a j y =>
          hCompat s a (j_x ((Fgt.map j.obj.hom).left y)) j
            (y_x ((Fgt.map j.obj.hom).left y)) y
            (hg_x ((Fgt.map j.obj.hom).left y)).2.2
      have hg_loc : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_lc)) (a : s.pt),
          IsLocallyConstant (g_fn s a) := by
        intro s a t
        have hpre : g_fn s a ⁻¹' t =
            ⋃ x : ↥(Fgt.obj U).left,
              ⇑((Fgt.map (g_x x)).left) '' ((evalCone s (j_x x) a) ⁻¹' t) := by
          ext z
          simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
          constructor
          · intro hz
            exact ⟨z, y_x z, hz, (hg_x z).2.2⟩
          · rintro ⟨x, y, hy, rfl⟩
            change g_fn s a ((Fgt.map (j_x x).obj.hom).left y) ∈ t
            rw [hg_res s a (j_x x) y]
            exact hy
        rw [hpre]
        apply isOpen_iUnion
        intro x
        have : AlgebraicGeometry.Etale (Fgt.map (g_x x)).left := hEt_hom (g_x x)
        exact (Fgt.map (g_x x)).left.isOpenMap _
          ((evalCone s (j_x x) a).isLocallyConstant t)
      let liftCone : ∀ (s : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ P_lc)),
          s.pt ⟶ P_lc.obj (Opposite.op U) :=
        fun s => AddCommGrpCat.ofHom
          { toFun := fun a => ⟨g_fn s a, hg_loc s a⟩
            map_zero' := LocallyConstant.ext fun x => by
              change evalCone s (j_x x) 0 (y_x x) = 0
              dsimp [evalCone]
              rw [map_zero]
              rfl
            map_add' := fun a₁ a₂ => LocallyConstant.ext fun x => by
              change evalCone s (j_x x) (a₁ + a₂) (y_x x) =
                evalCone s (j_x x) a₁ (y_x x) + evalCone s (j_x x) a₂ (y_x x)
              dsimp [evalCone]
              rw [map_add]
              rfl }
      refine ⟨{
        lift := liftCone
        fac := fun s j => AddCommGrpCat.ext fun a => LocallyConstant.ext fun y =>
          hg_res s a j.unop y
        uniq := fun s m' hm' => by
          let m₀ : s.pt ⟶ P_lc.obj (Opposite.op U) := m'
          change m₀ = liftCone s
          apply AddCommGrpCat.ext
          intro a
          apply LocallyConstant.ext
          intro x
          have hm_x := congrArg
            (fun φ => toLC (W := (j_x x).obj.left) (φ.hom a) (y_x x))
            (hm' (Opposite.op (j_x x)))
          change (toLC (W := U) (m₀.hom a)) ((Fgt.map (g_x x)).left (y_x x)) = g_fn s a x at hm_x
          rwa [(hg_x x).2.2] at hm_x }⟩

    let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P_lc, hSh_lc⟩
    let α_lc : PM ⟶ P_lc :=
      { app := fun U => weilAltLocConstConstHom S (Opposite.unop U) ℓ
        naturality := fun {_ _} _ =>
          AddCommGrpCat.ext fun _ => LocallyConstant.ext fun _ => rfl }
    let Φ_lc : FM ⟶ L_sh := (shAdj.homEquiv PM L_sh).symm α_lc
    have hΦ_unit : shAdj.unit.app PM ≫ Φ_lc.hom = α_lc :=
      (CategoryTheory.Adjunction.homEquiv_unit shAdj PM L_sh Φ_lc).symm.trans
        ((shAdj.homEquiv PM L_sh).apply_symm_apply α_lc)

    have hEmptySub : ∀ (W : S.Etale), IsEmpty ↥(Fgt.obj W).left →
        Subsingleton ↥(FM.obj.obj (Opposite.op W)) := by
      intro W _
      have hBotMem : (⊥ : CategoryTheory.Sieve W) ∈ J W :=
        (hMemJ W ⊥).mpr (fun x => isEmptyElim x)
      obtain ⟨hLimBot⟩ :=
        (CategoryTheory.Presheaf.isSheaf_iff_isLimit J FM.obj).mp FM.property
          (⊥ : CategoryTheory.Sieve W) hBotMem
      let M_W := FM.obj.obj (Opposite.op W)
      let cone_bot : CategoryTheory.Limits.Cone
          ((⊥ : CategoryTheory.Sieve W).arrows.diagram.op ⋙ FM.obj) :=
        { pt := M_W
          π :=
            { app := fun j => False.elim j.unop.property
              naturality := fun j _ _ => False.elim j.unop.property } }
      have hid_eq_zero : (𝟙 M_W : M_W ⟶ M_W) = 0 :=
        (hLimBot.uniq cone_bot (𝟙 M_W) (fun j => False.elim j.unop.property)).trans
          (hLimBot.uniq cone_bot 0 (fun j => False.elim j.unop.property)).symm
      refine ⟨fun x y => ?_⟩
      have hx : x = (𝟙 M_W : M_W ⟶ M_W).hom x := rfl
      have hy : y = (𝟙 M_W : M_W ⟶ M_W).hom y := rfl
      rw [hx, hy, hid_eq_zero]
      rfl

    have hSheafUnique : ∀ (U : S.Etale) (R : CategoryTheory.Sieve U), R ∈ J U →
        ∀ (s₁ s₂ : ↥(FM.obj.obj (Opposite.op U))),
          (∀ {W : S.Etale} (g : W ⟶ U), R.arrows g →
            (FM.obj.map g.op).hom s₁ = (FM.obj.map g.op).hom s₂) →
          s₁ = s₂ := by
      intro U R hR s₁ s₂ hEq
      obtain ⟨hLimR⟩ :=
        (CategoryTheory.Presheaf.isSheaf_iff_isLimit J FM.obj).mp FM.property R hR
      let mkHom : ↥(FM.obj.obj (Opposite.op U)) → (Aℤ ⟶ FM.obj.obj (Opposite.op U)) :=
        fun s => AddCommGrpCat.ofHom
          { toFun := fun n => n.down • s
            map_zero' := zero_zsmul s
            map_add' := fun a b => add_zsmul s a.down b.down }
      let s_cone : CategoryTheory.Limits.Cone (R.arrows.diagram.op ⋙ FM.obj) :=
        { pt := Aℤ
          π :=
            { app := fun j => mkHom s₁ ≫ FM.obj.map j.unop.obj.hom.op
              naturality := fun {j₁ j₂} m => by
                dsimp
                rw [CategoryTheory.Category.id_comp, CategoryTheory.Category.assoc]
                congr 1
                have hm_w : R.arrows.diagram.map m.unop ≫ j₁.unop.obj.hom = j₂.unop.obj.hom :=
                  CategoryTheory.Over.w m.unop.hom
                have hop : (R.arrows.diagram.map m.unop ≫ j₁.unop.obj.hom).op =
                    j₁.unop.obj.hom.op ≫ (R.arrows.diagram.map m.unop).op := rfl
                rw [← hm_w, hop, FM.obj.map_comp]
                rfl } }
      have hfac₂ : ∀ j : (R.arrows.category)ᵒᵖ,
          mkHom s₂ ≫ FM.obj.map j.unop.obj.hom.op = s_cone.π.app j := by
        intro j
        apply AddCommGrpCat.ext
        intro n
        change (FM.obj.map j.unop.obj.hom.op).hom (n.down • s₂) =
          (FM.obj.map j.unop.obj.hom.op).hom (n.down • s₁)
        rw [map_zsmul, map_zsmul, hEq j.unop.obj.hom j.unop.property]
      have hm_eq : mkHom s₁ = mkHom s₂ :=
        (hLimR.uniq s_cone (mkHom s₁) (fun _ => rfl)).trans
          (hLimR.uniq s_cone (mkHom s₂) hfac₂).symm
      have heval := congrArg (fun φ : Aℤ ⟶ FM.obj.obj (Opposite.op U) => φ.hom (ULift.up 1)) hm_eq
      simpa [mkHom] using heval

    let R_f : ∀ (U : S.Etale),
        LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ)) → CategoryTheory.Sieve U :=
      fun U f =>
        { arrows := fun {W} g =>
            ∃ c : ULift.{u} (ZMod ℓ), ∀ w : ↥(Fgt.obj W).left, f ((Fgt.map g).left w) = c
          downward_closed := fun {W Y g} ⟨c, hc⟩ h =>
            ⟨c, fun y => by
              have hcomp : (Fgt.map (h ≫ g)).left y = (Fgt.map g).left ((Fgt.map h).left y) := by
                rw [Fgt.map_comp]
                exact AlgebraicGeometry.Scheme.Hom.comp_apply
                  (Fgt.map h).left (Fgt.map g).left y
              rw [hcomp]
              exact hc ((Fgt.map h).left y)⟩ }
    have hRf_mem : ∀ (U : S.Etale) (f : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ))),
        R_f U f ∈ J U := by
      intro U f
      rw [hMemJ U (R_f U f)]
      intro x
      let c := f x
      let O_c : (Fgt.obj U).left.Opens := ⟨f ⁻¹' {c}, f.isLocallyConstant {c}⟩
      have : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
      let V_c : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (O_c.ι ≫ (Fgt.obj U).hom) inferInstance
      let i_c : V_c ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O_c.ι rfl trivial
      refine ⟨V_c, i_c, ⟨x, rfl⟩, ⟨c, fun w => w.2⟩, inferInstance, rfl⟩

    let cone_Rf : ∀ (U : S.Etale) (f : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ))),
        CategoryTheory.Limits.Cone ((R_f U f).arrows.diagram.op ⋙ FM.obj) :=
      fun U f =>
        { pt := Aℤ
          π :=
            { app := fun j =>
                let c_j := Classical.choose j.unop.property
                AddCommGrpCat.ofHom
                  { toFun := fun n => n.down • ((unitPM j.unop.obj.left).hom c_j)
                    map_zero' := zero_zsmul _
                    map_add' := fun a b => add_zsmul _ a.down b.down }
              naturality := fun {j₁ j₂} m => by
                apply AddCommGrpCat.ext
                intro n
                let W₁ := j₁.unop.obj.left
                let W₂ := j₂.unop.obj.left
                let u_m : W₂ ⟶ W₁ := (R_f U f).arrows.diagram.map m.unop
                let c₁ := Classical.choose j₁.unop.property
                let c₂ := Classical.choose j₂.unop.property
                change n.down • ((unitPM W₂).hom c₂) =
                  (FM.obj.map u_m.op).hom (n.down • ((unitPM W₁).hom c₁))
                rw [map_zsmul, hunitPM_nat u_m c₁]
                by_cases hne : Nonempty ↥(Fgt.obj W₂).left
                · obtain ⟨w₂⟩ := hne
                  have hm_w : u_m ≫ j₁.unop.obj.hom = j₂.unop.obj.hom :=
                    CategoryTheory.Over.w m.unop.hom
                  have hcomp : (Fgt.map j₂.unop.obj.hom).left w₂ =
                      (Fgt.map j₁.unop.obj.hom).left ((Fgt.map u_m).left w₂) := by
                    rw [← hm_w, Fgt.map_comp]
                    exact AlgebraicGeometry.Scheme.Hom.comp_apply
                      (Fgt.map u_m).left (Fgt.map j₁.unop.obj.hom).left w₂
                  have hc₂ : f ((Fgt.map j₂.unop.obj.hom).left w₂) = c₂ :=
                    Classical.choose_spec j₂.unop.property w₂
                  have hc₁ : f ((Fgt.map j₁.unop.obj.hom).left ((Fgt.map u_m).left w₂)) = c₁ :=
                    Classical.choose_spec j₁.unop.property ((Fgt.map u_m).left w₂)
                  have heq_c : c₂ = c₁ := hc₂.symm.trans ((congrArg f hcomp).trans hc₁)
                  rw [heq_c]
                · have : IsEmpty ↥(Fgt.obj W₂).left := not_nonempty_iff.mp hne
                  have := hEmptySub W₂ inferInstance
                  exact Subsingleton.elim _ _ } }

    let hLim_Rf : ∀ (U : S.Etale) (f : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ))),
        CategoryTheory.Limits.IsLimit (FM.obj.mapCone (R_f U f).arrows.cocone.op) :=
      fun U f =>
        Classical.choice
          ((CategoryTheory.Presheaf.isSheaf_iff_isLimit J FM.obj).mp FM.property
            (R_f U f) (hRf_mem U f))
    let ψ_raw : ∀ (U : S.Etale),
        LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ)) →
          ↥(FM.obj.obj (Opposite.op U)) :=
      fun U f => ((hLim_Rf U f).lift (cone_Rf U f)).hom (ULift.up 1)

    have hψ_spec : ∀ (U : S.Etale) (f : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ)))
        {W : S.Etale} (g : W ⟶ U) (c : ULift.{u} (ZMod ℓ)),
        (∀ w : ↥(Fgt.obj W).left, f ((Fgt.map g).left w) = c) →
        (FM.obj.map g.op).hom (ψ_raw U f) = (unitPM W).hom c := by
      intro U f W g c hc
      let j_g : (R_f U f).arrows.category := ⟨CategoryTheory.Over.mk g, ⟨c, hc⟩⟩
      have hfac := congrArg
        (fun φ : Aℤ ⟶ FM.obj.obj (Opposite.op W) => φ.hom (ULift.up 1))
        ((hLim_Rf U f).fac (cone_Rf U f) (Opposite.op j_g))
      let c_jg := Classical.choose j_g.property
      change (FM.obj.map g.op).hom (ψ_raw U f) =
        (1 : ℤ) • ((unitPM W).hom c_jg) at hfac
      rw [one_zsmul] at hfac
      rw [hfac]
      by_cases hne : Nonempty ↥(Fgt.obj W).left
      · obtain ⟨w⟩ := hne
        have heq_c : c_jg = c :=
          (Classical.choose_spec j_g.property w).symm.trans (hc w)
        rw [heq_c]
      · have : IsEmpty ↥(Fgt.obj W).left := not_nonempty_iff.mp hne
        have := hEmptySub W inferInstance
        exact Subsingleton.elim _ _

    have hψ_const : ∀ (U : S.Etale) (c₀ : ULift.{u} (ZMod ℓ)),
        ψ_raw U (LocallyConstant.const _ c₀) = (unitPM U).hom c₀ := by
      intro U c₀
      have h1 := hψ_spec U (LocallyConstant.const _ c₀) (𝟙 U) c₀ (fun _ => rfl)
      have hid : FM.obj.map (𝟙 U).op = 𝟙 (FM.obj.obj (Opposite.op U)) :=
        FM.obj.map_id (Opposite.op U)
      rwa [hid] at h1

    have hψ_zero : ∀ (U : S.Etale), ψ_raw U 0 = 0 := by
      intro U
      have h0 : (0 : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ))) =
          LocallyConstant.const _ 0 :=
        LocallyConstant.ext fun _ => rfl
      rw [h0, hψ_const U 0]
      exact (unitPM U).hom.map_zero

    have hψ_add : ∀ (U : S.Etale)
        (f₁ f₂ : LocallyConstant ↥(Fgt.obj U).left (ULift.{u} (ZMod ℓ))),
        ψ_raw U (f₁ + f₂) = ψ_raw U f₁ + ψ_raw U f₂ := by
      intro U f₁ f₂
      let R₁₂ : CategoryTheory.Sieve U :=
        { arrows := fun {W} g => (R_f U f₁).arrows g ∧ (R_f U f₂).arrows g
          downward_closed := fun {W Y g} ⟨h₁, h₂⟩ h =>
            ⟨(R_f U f₁).downward_closed h₁ h, (R_f U f₂).downward_closed h₂ h⟩ }
      have hR₁₂_mem : R₁₂ ∈ J U := by
        rw [hMemJ U R₁₂]
        intro x
        let O_x : (Fgt.obj U).left.Opens :=
          ⟨f₁ ⁻¹' {f₁ x} ∩ f₂ ⁻¹' {f₂ x},
            (f₁.isLocallyConstant {f₁ x}).inter (f₂.isLocallyConstant {f₂ x})⟩
        have : AlgebraicGeometry.Etale (Fgt.obj U).hom := U.prop
        let V_x : S.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ (Fgt.obj U).hom) inferInstance
        let i_x : V_x ⟶ U := CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl trivial
        exact ⟨V_x, i_x, ⟨x, rfl, rfl⟩, ⟨⟨f₁ x, fun w => w.2.1⟩, ⟨f₂ x, fun w => w.2.2⟩⟩,
          inferInstance, rfl⟩
      apply hSheafUnique U R₁₂ hR₁₂_mem
      intro W g ⟨⟨c₁, hc₁⟩, ⟨c₂, hc₂⟩⟩
      have hc₁₂ : ∀ w : ↥(Fgt.obj W).left, (f₁ + f₂) ((Fgt.map g).left w) = c₁ + c₂ :=
        fun w => (LocallyConstant.add_apply f₁ f₂ _).trans (congrArg₂ (· + ·) (hc₁ w) (hc₂ w))
      rw [hψ_spec U (f₁ + f₂) g (c₁ + c₂) hc₁₂, map_add,
        hψ_spec U f₁ g c₁ hc₁, hψ_spec U f₂ g c₂ hc₂]
      exact (unitPM W).hom.map_add c₁ c₂

