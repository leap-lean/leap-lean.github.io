    fun F W =>
      { hom := AddCommGrpCat.ofHom (e_add W F).toAddMonoidHom
        inv := AddCommGrpCat.ofHom (e_add W F).symm.toAddMonoidHom
        hom_inv_id := by ext x; exact (e_add W F).symm_apply_apply x
        inv_hom_id := by ext y; exact (e_add W F).apply_symm_apply y }
  let θ_obj : ∀ (F : CategoryTheory.Sheaf J_X AddCommGrpCat.{u}),
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F ≅ U_X.obj F :=
    fun F => CategoryTheory.NatIso.ofComponents (fun W => θ_comp F W) (by
      intro W₁ W₂ ω
      have hmap_ω_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).obj F).map ω =
          ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app F := rfl
      rw [hmap_ω_mor, CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) F]
      ext α
      let u : Z_obj W₁ ⟶ F := CategoryTheory.Abelian.Ext.addEquiv₀ α
      have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
      change e_raw W₂ F
          ((CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop).comp α (Nat.zero_add 0)) =
        ((U_X.obj F).map ω) (e_raw W₁ F α)
      rw [hα]
      have hZw : (Z_fun.op.map ω).unop = L_tot.map (CategoryTheory.yoneda.map ω.unop) := rfl
      rw [hZw, CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
      dsimp [e_raw]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_left,
        ← CategoryTheory.yonedaEquiv_naturality',
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      rfl)
  let θ : CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0 ≅ U_X :=
    CategoryTheory.NatIso.ofComponents θ_obj (by
      intro F₁ F₂ φ
      ext W α
      have hmap_φ_mor : ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W =
          (CategoryTheory.Abelian.extFunctorObj (Z_obj W) 0).map φ := rfl
      let u : Z_obj W ⟶ F₁ := CategoryTheory.Abelian.Ext.addEquiv₀ α
      have hα : α = CategoryTheory.Abelian.Ext.mk₀ u :=
        (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply α).symm
      change e_raw W F₂ ((((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map φ).app W) α) =
        ((U_X.map φ).app W) (e_raw W F₁ α)
      rw [hmap_φ_mor, CategoryTheory.Abelian.extFunctorObj_map, hα]
      have hpost : ((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
          (CategoryTheory.Abelian.Ext.mk₀ u) =
          CategoryTheory.Abelian.Ext.mk₀ (u ≫ φ) :=
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ u φ
      change e_raw W F₂ (((CategoryTheory.Abelian.Ext.mk₀ φ).postcomp (Z_obj W) (Nat.add_zero 0))
          (CategoryTheory.Abelian.Ext.mk₀ u)) = _
      rw [hpost]
      dsimp [e_raw]
      rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply,
        CategoryTheory.Adjunction.homEquiv_naturality_right,
        CategoryTheory.yonedaEquiv_apply, CategoryTheory.yonedaEquiv_apply,
        ← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      rfl)
  let U_S := CategoryTheory.sheafToPresheaf J_S AddCommGrpCat.{u}
  let e_pre : U_X.comp W_B ≅ pf_f.comp U_S :=
    CategoryTheory.NatIso.ofComponents (fun _ => CategoryTheory.Iso.refl _) (by
      intro _ _ _
      ext W x
      rfl)
  let e_counit : U_S.comp Sh_S ≅
      CategoryTheory.Functor.id (CategoryTheory.Sheaf J_S AddCommGrpCat.{u}) :=
    CategoryTheory.asIso (CategoryTheory.sheafificationAdjunction J_S AddCommGrpCat.{u}).counit
  let ε₀ : Φ 0 ≅ pf_f :=
    CategoryTheory.Functor.isoWhiskerRight θ E_S ≪≫
      (CategoryTheory.Functor.associator U_X W_B Sh_S).symm ≪≫
      CategoryTheory.Functor.isoWhiskerRight e_pre Sh_S ≪≫
      CategoryTheory.Functor.associator pf_f U_S Sh_S ≪≫
      CategoryTheory.Functor.isoWhiskerLeft pf_f e_counit ≪≫
      CategoryTheory.Functor.rightUnitor pf_f
  have hPresheafExact : ∀ (K : CategoryTheory.ShortComplex
      (CategoryTheory.Functor (Opposite X.Etale) AddCommGrpCat.{u})),
      (∀ (W : Opposite X.Etale),
        (K.map ((CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W)).Exact) →
      K.Exact := by
    intro K hW
    rw [CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology,
      CategoryTheory.Functor.isZero_iff]
    intro W
    let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
    have hZW : CategoryTheory.Limits.IsZero (K.map evW).leftHomology :=
      (CategoryTheory.ShortComplex.exact_iff_isZero_leftHomology (K.map evW)).mp (hW W)
    exact hZW.of_iso (K.mapLeftHomologyIso evW).symm
  let δ_pre : SC.X₃.cohomologyPresheaf 0 ⟶ SC.X₁.cohomologyPresheaf 1 :=
    { app := fun W => AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)
      naturality := by
        intro W₁ W₂ ω
        have hL : (SC.X₃.cohomologyPresheaf 0).map ω =
            ((CategoryTheory.Abelian.extFunctor 0).map (Z_fun.op.map ω)).app SC.X₃ := rfl
        have hR : (SC.X₁.cohomologyPresheaf 1).map ω =
            ((CategoryTheory.Abelian.extFunctor 1).map (Z_fun.op.map ω)).app SC.X₁ := rfl
        rw [hL, hR,
          CategoryTheory.Abelian.extFunctor_map_app 0 (Z_fun.op.map ω) SC.X₃,
          CategoryTheory.Abelian.extFunctor_map_app 1 (Z_fun.op.map ω) SC.X₁]
        ext α
        exact CategoryTheory.Abelian.Ext.comp_assoc
          (CategoryTheory.Abelian.Ext.mk₀ (Z_fun.op.map ω).unop) α hSE.extClass
          (Nat.zero_add 0) rfl (by omega) }
  have hg₀_app : ∀ (W : Opposite X.Etale),
      (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.g).app W) =
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 0)) := by
    intro W
    exact CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) 0 SC.g
  have hf₁_app : ∀ (W : Opposite X.Etale),
      (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f).app W) =
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 1)) := by
    intro W
    exact CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) 1 SC.f
  have hg₁_app : ∀ (W : Opposite X.Etale),
      (((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.g).app W) =
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 1)) := by
    intro W
    exact CategoryTheory.Abelian.extFunctorObj_map (Z_obj W) 1 SC.g
  have hcomp₁_pre :
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.g ≫ δ_pre = 0 := by
    ext W x
    have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE 0 1 rfl
    have hz : AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 0)) ≫
        AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) = 0 :=
      (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
    have hzx : (AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 0)) ≫
        AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl)) x = 0 :=
      congrArg (fun φ => φ x) hz
    rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hg₀_app W]
    exact hzx
  have hcomp₂_pre :
      δ_pre ≫ (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f = 0 := by
    ext W x
    have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE 0 1 rfl
    have hz : AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 1)) = 0 :=
      (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
    have hzx : (AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_obj W) rfl) ≫
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 1))) x = 0 :=
      congrArg (fun φ => φ x) hz
    rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf₁_app W]
    exact hzx
  have hcomp₃_pre :
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f ≫
        (CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.g = 0 := by
    ext W x
    have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE 1
    have hz : AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 1)) ≫
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 1)) = 0 :=
      (fun {K : CategoryTheory.ShortComplex AddCommGrpCat.{u}} (_ : K.Exact) => K.zero) hex
    have hzx : (AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.f).postcomp (Z_obj W) (Nat.add_zero 1)) ≫
        AddCommGrpCat.ofHom
          ((CategoryTheory.Abelian.Ext.mk₀ SC.g).postcomp (Z_obj W) (Nat.add_zero 1))) x = 0 :=
      congrArg (fun φ => φ x) hz
    rw [CategoryTheory.NatTrans.comp_app, CategoryTheory.NatTrans.app_zero, hf₁_app W, hg₁_app W]
    exact hzx
  let A_pre := CategoryTheory.ShortComplex.mk
    ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.g) δ_pre hcomp₁_pre
  let B_pre := CategoryTheory.ShortComplex.mk
    δ_pre ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f) hcomp₂_pre
  let C_pre := CategoryTheory.ShortComplex.mk
    ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f)
    ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.g) hcomp₃_pre
  have hA_pre_ex : A_pre.Exact := by
    apply hPresheafExact A_pre
    intro W
    let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
    have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₃' (Z_obj W) hSE 0 1 rfl
    let eW : A_pre.map evW ≅ _ :=
      CategoryTheory.ShortComplex.isoMk
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by dsimp [A_pre, evW]; rw [hg₀_app W]; ext x; rfl)
        (by dsimp [A_pre, evW, δ_pre]; ext x; rfl)
    exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
  have hB_pre_ex : B_pre.Exact := by
    apply hPresheafExact B_pre
    intro W
    let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
    have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁' (Z_obj W) hSE 0 1 rfl
    let eW : B_pre.map evW ≅ _ :=
      CategoryTheory.ShortComplex.isoMk
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by dsimp [B_pre, evW, δ_pre]; ext x; rfl)
        (by dsimp [B_pre, evW]; rw [hf₁_app W]; ext x; rfl)
    exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
  have hC_pre_ex : C_pre.Exact := by
    apply hPresheafExact C_pre
    intro W
    let evW := (CategoryTheory.evaluation (Opposite X.Etale) AddCommGrpCat.{u}).obj W
    have hex := CategoryTheory.Abelian.Ext.covariant_sequence_exact₂' (Z_obj W) hSE 1
    let eW : C_pre.map evW ≅ _ :=
      CategoryTheory.ShortComplex.isoMk
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _)
        (by dsimp [C_pre, evW]; rw [hf₁_app W]; ext x; rfl)
        (by dsimp [C_pre, evW]; rw [hg₁_app W]; ext x; rfl)
    exact (CategoryTheory.ShortComplex.exact_iff_of_iso eW).mpr hex
  let Δ₀ : (Φ 0).obj SC.X₃ ⟶ (Φ 1).obj SC.X₁ := E_S.map δ_pre
  have hcomp₁_A : (Φ 0).map SC.g ≫ Δ₀ = 0 := by
    change E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 0).map SC.g) ≫
      E_S.map δ_pre = 0
    rw [← E_S.map_comp, hcomp₁_pre, E_S.map_zero]
  have hcomp₂_A : Δ₀ ≫ (Φ 1).map SC.f = 0 := by
    change E_S.map δ_pre ≫
      E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f) = 0
    rw [← E_S.map_comp, hcomp₂_pre, E_S.map_zero]
  have hcomp₃_B : (Φ 1).map SC.f ≫ (Φ 1).map SC.g = 0 := by
    change E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.f) ≫
      E_S.map ((CategoryTheory.Sheaf.cohomologyPresheafFunctor J_X 1).map SC.g) = 0
    rw [← E_S.map_comp, hcomp₃_pre, E_S.map_zero]
  have hEx₁_A : (CategoryTheory.ShortComplex.mk ((Φ 0).map SC.g) Δ₀ hcomp₁_A).Exact :=
    (hA_pre_ex.map W_B).map Sh_S
  have hEx₂_A : (CategoryTheory.ShortComplex.mk Δ₀ ((Φ 1).map SC.f) hcomp₂_A).Exact :=
    (hB_pre_ex.map W_B).map Sh_S
  have hEx₃_B : (CategoryTheory.ShortComplex.mk ((Φ 1).map SC.f) ((Φ 1).map SC.g) hcomp₃_B).Exact :=
    (hC_pre_ex.map W_B).map Sh_S
  have hZ_R1_X₃ : CategoryTheory.Limits.IsZero ((Φ 1).obj SC.X₃) := hZero_R1_X₃
  have hg₁_zero : (Φ 1).map SC.g = 0 := hZ_R1_X₃.eq_of_tgt ((Φ 1).map SC.g) 0
  have hEpi_π₁ : CategoryTheory.Epi π₁ := hEx₃_B.epi_f hg₁_zero
  let δ₀ : pf_f.obj SC.X₃ ⟶ (Φ 1).obj SC.X₁ :=
    ε₀.inv.app SC.X₃ ≫ Δ₀
  have hcomp₁ : pf_f.map SC.g ≫ δ₀ = 0 := by
    dsimp [δ₀]
    rw [← CategoryTheory.Category.assoc, ε₀.inv.naturality SC.g,
      CategoryTheory.Category.assoc, hcomp₁_A, CategoryTheory.Limits.comp_zero]
  have hcomp₂ : δ₀ ≫ (Φ 1).map SC.f = 0 := by
    dsimp [δ₀]
    rw [CategoryTheory.Category.assoc, hcomp₂_A, CategoryTheory.Limits.comp_zero]
  have hEx₁ : (CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp₁).Exact := by
    let e_SC₁ : CategoryTheory.ShortComplex.mk ((Φ 0).map SC.g) Δ₀ hcomp₁_A ≅
        CategoryTheory.ShortComplex.mk (pf_f.map SC.g) δ₀ hcomp₁ :=
      CategoryTheory.ShortComplex.isoMk
        (ε₀.app SC.X₂) (ε₀.app SC.X₃) (CategoryTheory.Iso.refl _)
        (ε₀.hom.naturality SC.g).symm
