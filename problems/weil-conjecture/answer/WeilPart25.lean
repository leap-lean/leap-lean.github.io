            (fun c => by
              apply CategoryTheory.Limits.pullback.hom_ext
              · exact (CategoryTheory.Category.assoc _ δ_EV₁ _).trans
                  ((congrArg (_ ≫ ·) hδ_fst).trans
                    (CategoryTheory.Limits.pullback.lift_snd _ _ (hc_cond c)))
              · exact (CategoryTheory.Category.assoc _ δ_EV₁ _).trans
                  ((congrArg (_ ≫ ·) hδ_snd).trans
                    (CategoryTheory.Limits.pullback.lift_fst _ _ (hc_cond c))))
            (fun c m _ hm₂ => by
              apply CategoryTheory.Limits.pullback.hom_ext
              · have h₂' : m ≫ q₁_Y =
                    c.snd ≫ CategoryTheory.Limits.pullback.snd p_EV₁ E.Y_bar.hom :=
