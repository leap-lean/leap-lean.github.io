  let τ_B₁_ring : B₁ →+* k := IsLocalization.Away.lift t₁ (g := τ_mid.toRingHom) (Ne.isUnit ht₁)
  have hτ_B₁_eq : ∀ b : B_mid, τ_B₁_ring (algebraMap B_mid B₁ b) = τ_mid b :=
    fun b => IsLocalization.Away.lift_eq t₁ (Ne.isUnit ht₁) b
  let τ_B₁ : B₁ →ₐ[k] k :=
    { τ_B₁_ring with
      commutes' := fun c => by
        change τ_B₁_ring (algebraMap k B₁ c) = algebraMap k k c
        rw [IsScalarTower.algebraMap_apply k B_mid B₁ c, hτ_B₁_eq, τ_mid.commutes c] }

  have hNotField₁ : ¬ IsField B₁ := by
    intro hField₁
    let z₁ : B₁ := algebraMap B_mid B₁ (algebraMap B₀' B_mid x_nz)
    have hz₁_ne : z₁ ≠ 0 := by
