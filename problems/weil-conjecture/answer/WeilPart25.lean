        (adj_U.homEquiv AM (pf_f₁.obj F_Y)).symm
          (adj_Y.unit.app AM ≫ F_Y.obj.map (hT_Y.from (B_f₁.obj T_U)).op) := by
      dsimp [η_f₁, weilEtaleConstPullbackHom]
