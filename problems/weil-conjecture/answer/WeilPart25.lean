          Ξ_Y (τ_cod (bc_Tk (θ_Tk (ι_dom (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey))))) j =
            if i = j then (1 : ZMod ℓ) else 0 := by
      intro i j
