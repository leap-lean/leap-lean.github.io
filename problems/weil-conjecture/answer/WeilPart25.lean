          refine ⟨fun z => ?_⟩
          have hz_eq : ((gi ≫ π i).left).base z = ((gj ≫ π j).left).base z :=
            congrArg (fun m => m.left.base z) hcomm
          have hzi : ((gi ≫ π i).left).base z ∈ O i := (gi.left.base z).2
          have hzj : ((gj ≫ π j).left).base z ∈ O j := (gj.left.base z).2
          rw [hz_eq] at hzi
