      (x ≠ P₀ →
        Ideal.span {(Y_η.presheaf.germ (V α) x.1 hx).hom (h_P₀ α)} = ⊤) := by
    intro α x hx
    simpa [h_P₀, x_η, Fin.lastCases_last] using hStalk_sec (Fin.last M) α x hx

  obtain ⟨(u_Ω : ∀ α : Fin N_cov, Units ↑(Y_η.presheaf.obj (Opposite.op (V α)))),
      hu_Ω_no_root, hu_Ω_gl, hu_Ω_kill⟩ :=
    hKummerCharts N_cov hN_cov V hV_top hV_aff h_Q h_P₀ r_Q r_P₀
      hr_Q_trans hr_P₀_trans hStalk_Q hStalk_P₀

  
  let g₁ : ∀ α β : Fin N_cov, Units ↑(Y_B₁.presheaf.obj (Opposite.op (W₁ α ⊓ W₁ β))) :=
    fun α β =>
      (Finset.univ.prod fun j : Fin M => (r_sec j.castSucc α β)⁻¹) *
        (r_sec (Fin.last M) α β) ^ M
  have hr_sec_diag_u : ∀ (a : Fin (M + 1)) (α : Fin N_cov), r_sec a α α = 1 :=
    fun a α => Units.ext (hr_sec_diag a α)
  have hg₁_diag : ∀ α : Fin N_cov, (g₁ α α).1 = 1 := by
    intro α
    dsimp [g₁]
    simp [hr_sec_diag_u]
  have hg₁_cocycle : ∀ α β γ : Fin N_cov,
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β)).op).hom (g₁ α β).1 *
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.2, hx.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ)).op).hom (g₁ β γ).1 =
      (Y_B₁.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.2⟩ :
            (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ)).op).hom (g₁ α γ).1 := by
    intro α β γ
    let hle₁₂ : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β := fun _ hx => ⟨hx.1.1, hx.1.2⟩
    let hle₂₃ : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ := fun _ hx => ⟨hx.1.2, hx.2⟩
    let hle₁₃ : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ := fun _ hx => ⟨hx.1.1, hx.2⟩
    let φ₁₂ := Units.map (Y_B₁.presheaf.map (CategoryTheory.homOfLE hle₁₂).op).hom.toMonoidHom
    let φ₂₃ := Units.map (Y_B₁.presheaf.map (CategoryTheory.homOfLE hle₂₃).op).hom.toMonoidHom
    let φ₁₃ := Units.map (Y_B₁.presheaf.map (CategoryTheory.homOfLE hle₁₃).op).hom.toMonoidHom
    have hrc : ∀ a : Fin (M + 1), φ₁₂ (r_sec a α β) * φ₂₃ (r_sec a β γ) = φ₁₃ (r_sec a α γ) :=
      fun a => Units.ext (hr_sec_cocycle a α β γ)
    change (φ₁₂ (g₁ α β) * φ₂₃ (g₁ β γ)).1 = (φ₁₃ (g₁ α γ)).1
    congr 1
    dsimp [g₁]
    simp only [map_mul, map_prod, map_inv, map_pow]
    rw [mul_mul_mul_comm, ← Finset.prod_mul_distrib, ← mul_pow, hrc (Fin.last M)]
    congr 1
    refine Finset.prod_congr rfl fun j _ => ?_
    rw [← mul_inv, hrc j.castSucc]
  have hu_Ω_trans :
      let g_Ω : ∀ α β : Fin N_cov, Units ↑(Y_η.presheaf.obj (Opposite.op (V α ⊓ V β))) :=
        fun α β => Units.map (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom.toMonoidHom (g₁ α β)
      ∀ α β : Fin N_cov,
        ((g_Ω α β).1 ^ ℓ) *
          (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u_Ω β).1 =
        (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u_Ω α).1 := by
    intro g_Ω α β
    have hg_eq : g_Ω α β =
        (Finset.univ.prod fun j : Fin M => (r_Q j α β)⁻¹) * (r_P₀ α β) ^ M := by
      dsimp [g_Ω, g₁, r_Q, r_P₀]
      simp only [map_mul, map_prod, map_inv, map_pow]
      rfl
    rw [hg_eq]
    exact hu_Ω_gl α β

  
  obtain ⟨B_sp, instCR_sp, instDom_sp, instAlg_sp, instFT_sp, hDed_sp,
      ψ_sp, τ_sp, ι_sp_Ω, hInj_sp_Ω, Y_sp, q_Y_sp, f_sp, ι_η_sp, u_sp, c_scale,
      ⟨hτ_sp_ψ, _⟩, ⟨hPb_sp, hι_η_sp_q, hPb_η_sp⟩, hu_sp_trans, hu_sp_η_eq⟩ :=
    weil_rel_curve_dvr_prime_cancellation_and_kummer_unit_spread
      k ℓ B₁ hDed₁ hNotField₁ τ_B₁ Ω ι_B₁_Ω hInj_B₁_Ω hAlg_Ω
      Y_B₁ f_B₁ C₀ hInt_C₀ ι₀_B₁ hPb_c₀_B₁ Y_η ι_η_B₁ f_η hPb_η_B₁
      N_cov hN_cov W₁ hW₁_top hW₁_aff g₁ hg₁_diag hg₁_cocycle u_Ω hu_Ω_trans
  letI : CommRing B_sp := instCR_sp
  letI : IsDomain B_sp := instDom_sp
  letI : Algebra k B_sp := instAlg_sp
  letI : Algebra.FiniteType k B_sp := instFT_sp
  have hProp_fsp : AlgebraicGeometry.IsProper f_sp :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_sp inferInstance
  have hSm_fsp : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_sp :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_sp inferInstance
  letI : AlgebraicGeometry.IsProper f_sp := hProp_fsp
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_sp := hSm_fsp

  
  let U_sp := AlgebraicGeometry.Spec (CommRingCat.of B_sp)
  let g_sp_B₁ : U_sp ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ_sp.toRingHom)
  let g_sp_C : U_sp ⟶ C_aff := g_sp_B₁ ≫ g₁_mor
  let q_sp_C : Y_sp ⟶ Y_C := q_Y_sp ≫ p_B₁
  have hPb_sp_C : CategoryTheory.IsPullback q_sp_C f_sp f_C g_sp_C :=
    hPb_sp.paste_horiz hPb_B₁
  let τ_sec_sp : U_sp ⟶ Y_sp :=
    hPb_sp_C.lift (g_sp_C ≫ τ_C) (𝟙 U_sp)
      (by
        rw [CategoryTheory.Category.assoc, hτ_C_sec,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
  have hτ_sec_sp : τ_sec_sp ≫ f_sp = 𝟙 U_sp := hPb_sp_C.lift_snd _ _ _

  let s_τ_sp : S_k ⟶ U_sp := AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_sp.toRingHom)
  have hs_τ_sp_B₁ : s_τ_sp ≫ g_sp_B₁ = s_τ₁ := by
    dsimp [s_τ_sp, g_sp_B₁, s_τ₁]
    rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
    exact congrArg (fun φ : B₁ →ₐ[k] k => AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ.toRingHom))
      hτ_sp_ψ
  have hcomm_c₀_sp : ι₀_B₁ ≫ f_B₁ = (C₀.hom ≫ s_τ_sp) ≫ g_sp_B₁ := by
    rw [CategoryTheory.Category.assoc, hs_τ_sp_B₁, hPb_c₀_B₁.w]
  let ι₀_sp : C₀.left ⟶ Y_sp := hPb_sp.lift ι₀_B₁ (C₀.hom ≫ s_τ_sp) hcomm_c₀_sp
  have hPb_c₀_sp : CategoryTheory.IsPullback ι₀_sp C₀.hom f_sp s_τ_sp := by
    refine CategoryTheory.IsPullback.of_right ?_ (hPb_sp.lift_snd _ _ _) hPb_sp
    rw [hPb_sp.lift_fst, hs_τ_sp_B₁]
    exact hPb_c₀_B₁
  have hι₀_sp_C : ι₀_sp ≫ q_sp_C = ι₀ := by
    dsimp [q_sp_C]
    rw [← CategoryTheory.Category.assoc, hPb_sp.lift_fst]
    exact hPb_B₁.lift_fst _ _ _

  
  let W_sp : Fin N_cov → Y_sp.Opens := fun α => (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α)
  have hW_sp_top : (⨆ α : Fin N_cov, W_sp α) = ⊤ := by
    apply eq_top_iff.mpr
    intro y _
    have hy : q_Y_sp.base y ∈ (⨆ α : Fin N_cov, W₁ α) := by
      rw [hW₁_top]
      trivial
    obtain ⟨α, hα⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨α, hα⟩
  have hW_sp_aff : ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (W_sp α) := by
    have _ : AlgebraicGeometry.IsAffineHom g_sp_B₁ :=
      AlgebraicGeometry.isAffineHom_of_isAffine _
    have _ : AlgebraicGeometry.IsAffineHom q_Y_sp :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_sp.flip ‹_›
    exact fun α => (AlgebraicGeometry.isAffineHom_iff q_Y_sp).mp ‹_› (W₁ α) (hW₁_aff α)

  let g_sp : ∀ α β : Fin N_cov, Units ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α ⊓ W_sp β))) :=
    fun α β => Units.map (q_Y_sp.app (W₁ α ⊓ W₁ β)).hom.toMonoidHom (g₁ α β)
  have hg_sp_diag : ∀ α : Fin N_cov, (g_sp α α).1 = 1 := by
    intro α
    change (q_Y_sp.app (W₁ α ⊓ W₁ α)).hom (g₁ α α).1 = 1
    rw [hg₁_diag α, map_one]
  have hg_sp_cocycle : ∀ α β γ : Fin N_cov,
      (Y_sp.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
            (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp α ⊓ W_sp β)).op).hom (g_sp α β).1 *
      (Y_sp.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.2, hx.2⟩ :
            (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp β ⊓ W_sp γ)).op).hom (g_sp β γ).1 =
      (Y_sp.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.2⟩ :
            (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp α ⊓ W_sp γ)).op).hom (g_sp α γ).1 := by
    intro α β γ
    let hle₁₂ : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ β := fun _ hx => ⟨hx.1.1, hx.1.2⟩
    let hle₂₃ : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ β ⊓ W₁ γ := fun _ hx => ⟨hx.1.2, hx.2⟩
    let hle₁₃ : (W₁ α ⊓ W₁ β) ⊓ W₁ γ ≤ W₁ α ⊓ W₁ γ := fun _ hx => ⟨hx.1.1, hx.2⟩
    let hle_sp₁₂ : (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp α ⊓ W_sp β := fun _ hx => ⟨hx.1.1, hx.1.2⟩
    let hle_sp₂₃ : (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp β ⊓ W_sp γ := fun _ hx => ⟨hx.1.2, hx.2⟩
    let hle_sp₁₃ : (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp α ⊓ W_sp γ := fun _ hx => ⟨hx.1.1, hx.2⟩
    have h12 :
        (Y_sp.presheaf.map (CategoryTheory.homOfLE hle_sp₁₂).op).hom (g_sp α β).1 =
        (q_Y_sp.app ((W₁ α ⊓ W₁ β) ⊓ W₁ γ)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE hle₁₂).op).hom (g₁ α β).1) :=
      hAppRes q_Y_sp hle₁₂ hle_sp₁₂ (g₁ α β).1
    have h23 :
        (Y_sp.presheaf.map (CategoryTheory.homOfLE hle_sp₂₃).op).hom (g_sp β γ).1 =
        (q_Y_sp.app ((W₁ α ⊓ W₁ β) ⊓ W₁ γ)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE hle₂₃).op).hom (g₁ β γ).1) :=
      hAppRes q_Y_sp hle₂₃ hle_sp₂₃ (g₁ β γ).1
    have h13 :
        (Y_sp.presheaf.map (CategoryTheory.homOfLE hle_sp₁₃).op).hom (g_sp α γ).1 =
        (q_Y_sp.app ((W₁ α ⊓ W₁ β) ⊓ W₁ γ)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE hle₁₃).op).hom (g₁ α γ).1) :=
      hAppRes q_Y_sp hle₁₃ hle_sp₁₃ (g₁ α γ).1
    exact (congrArg₂ (· * ·) h12 h23).trans
      (((map_mul (q_Y_sp.app ((W₁ α ⊓ W₁ β) ⊓ W₁ γ)).hom _ _).symm.trans
        (congrArg (q_Y_sp.app ((W₁ α ⊓ W₁ β) ⊓ W₁ γ)).hom (hg₁_cocycle α β γ))).trans h13.symm)

  
  let Q_poly : Polynomial Ω := Polynomial.X ^ ℓ - Polynomial.C c_scale.1
  have hdegQ : Q_poly.degree ≠ 0 := by
    dsimp [Q_poly]
    rw [Polynomial.degree_X_pow_sub_C hPrime.pos c_scale.1]
    exact Nat.cast_ne_zero.mpr hPrime.ne_zero
  obtain ⟨d_val, hd_root⟩ := IsAlgClosed.exists_root Q_poly hdegQ
  have hd_pow : d_val ^ ℓ = c_scale.1 := by
    have hev : Polynomial.eval d_val Q_poly = 0 := hd_root
    simp only [Q_poly, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C, sub_eq_zero] at hev
    exact hev
  have hd_ne : d_val ≠ 0 := by
    intro hd0
    rw [hd0, zero_pow hPrime.ne_zero] at hd_pow
    exact c_scale.ne_zero hd_pow.symm
  let d_Ω : Units Ω := Units.mk0 d_val hd_ne

  let V_sp : Fin N_cov → Y_η.Opens :=
