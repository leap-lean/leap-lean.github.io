    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_ZU :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_ZU inferInstance
    haveI : AlgebraicGeometry.Flat f_ZU := by
      rw [AlgebraicGeometry.HasRingHomProperty.iff_appLE (P := @AlgebraicGeometry.Flat)]
      intro U_aff V_aff e_le
      let φ_app := (f_ZU.appLE U_aff.1 V_aff.1 e_le).hom
      have hLoc₁ :
          RingHom.Locally
            (fun {R S} [CommRing R] [CommRing S] => RingHom.IsStandardSmoothOfRelativeDimension 1)
            φ_app :=
        (AlgebraicGeometry.HasRingHomProperty.iff_appLE
          (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)).mp inferInstance U_aff V_aff e_le
      obtain ⟨s_fin, hs_top, hs_std⟩ := (RingHom.locally_iff_finite _ φ_app).mp hLoc₁
      have hLoc :
          RingHom.Locally
            (fun {R S} [CommRing R] [CommRing S] => RingHom.IsStandardSmooth)
            φ_app :=
        (RingHom.locally_iff_finite _ φ_app).mpr
          ⟨s_fin, hs_top, fun t ht =>
            RingHom.IsStandardSmoothOfRelativeDimension.isStandardSmooth 1 _ (hs_std t ht)⟩
