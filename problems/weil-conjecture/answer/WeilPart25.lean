    let 𝒰_O := (Z.openCoverOfIsOpenCover O_u hCov_u).changeProp
      (Q := @AlgebraicGeometry.Etale.{u})
      (fun k => (inferInstance : AlgebraicGeometry.Etale (O k.down).ι))
    letI : ∀ k : 𝒰_O.I₀, (𝒰_O.X k).Over Z :=
      fun k => CategoryTheory.OverClass.ofHom (O k.down).ι
    haveI : ∀ k : 𝒰_O.I₀, AlgebraicGeometry.Scheme.Hom.IsOver (𝒰_O.f k) Z :=
      fun k => CategoryTheory.HomIsOver.mk (CategoryTheory.Category.comp_id (O k.down).ι)
    letI hOver_O : AlgebraicGeometry.Scheme.Cover.Over Z 𝒰_O := ⟨inferInstance, inferInstance⟩
    have hP_O : ∀ k : 𝒰_O.I₀, AlgebraicGeometry.Etale (𝒰_O.X k ↘ Z) :=
      fun k => (inferInstance : AlgebraicGeometry.Etale (O k.down).ι)
    refine (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology T_Z
      (CategoryTheory.Sieve.ofArrows E π)).mpr ⟨𝒰_O, hOver_O, hP_O, ?_⟩
    intro W g hg
    rcases hg with ⟨k⟩
    let u_k : (𝒰_O.X k).asOverProp Z (hP_O k) ⟶ E k.down :=
      CategoryTheory.MorphismProperty.Over.homMk (𝟙 _) (CategoryTheory.Category.id_comp _) trivial
    have hu_comp : u_k ≫ π k.down = AlgebraicGeometry.Scheme.Hom.asOverProp (𝒰_O.f k) Z :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (CategoryTheory.Category.id_comp _)
