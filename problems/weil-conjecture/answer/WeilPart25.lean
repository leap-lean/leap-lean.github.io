          exact (congrArg ((e_LU_hom.hom.app (Opposite.op U'_y)).hom) hinv_gen).trans heLU_gen
        have hτ_lam := τ_sh.hom.naturality (Opposite.op lam_diag)
        have hlam_u : lam_diag ≫ e_U'.hom = u'_j i := hT_Y2.hom_ext _ _
        have hchain :
            ((τ_sh.hom.app (Opposite.op (S_j i))).hom)
              ((((pb_ι.obj F₂).obj.map (Opposite.op u_Sj)).hom)
                ((((e_sW ≫ (pb_y.map θ_fin ≫ bc₀)).hom.app (Opposite.op T_k)).hom)
                  (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey))) =
            ((L_Y2.obj.map (Opposite.op (u'_j i))).hom) gen_Y2 := by
          have s1 := congrArg ((τ_sh.hom.app (Opposite.op (S_j i))).hom)
            (hbc_ii'.trans
              (congrArg (((pb_ι.obj F₂).obj.map (Opposite.op lam_diag)).hom)
                (congrArg (((adj_ι.unit.app F₂).hom.app (Opposite.op U₂_et)).hom) hσ_diag)))
          have s2 := congrArg
            (fun f => f.hom ((((adj_ι.unit.app F₂).hom.app (Opposite.op U₂_et)).hom) gen_U2))
