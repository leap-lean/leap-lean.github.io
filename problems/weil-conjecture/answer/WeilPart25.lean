theorem weil_etale_connected_constantSheaf_hom_zero_of_closedPt_pullback_zero (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ r₁ r₂ : ℕ) [Fact (Nat.Prime ℓ)]
    (V : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥V]
    (s_v : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V)
    (Φ : Quiver.Hom
      ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin r₂ → ZMod ℓ))))
      ((CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin r₁ → ZMod ℓ)))))
    [_hc : (weilEtaleSitePullback s_v).IsContinuous
      V.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology]
    [_hr : ((weilEtaleSitePullback s_v).sheafPushforwardContinuous AddCommGrpCat.{u}
      V.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology).IsRightAdjoint]
    (hΦ_zero : ((weilEtaleSitePullback s_v).sheafPullback AddCommGrpCat.{u}
      V.smallEtaleTopology
      (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology).map Φ = 0) :
    Φ = 0 :=
by
  classical
  
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hEtale_left :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U₁ U₂ : S.Etale} (f : U₁ ⟶ U₂),
        AlgebraicGeometry.Etale f.left := by
    intro S U₁ U₂ f
    have hw : f.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w f
    have hcomp : AlgebraicGeometry.Etale (f.left ≫ U₂.hom) := by
      rw [hw]
      exact U₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      f.left U₂.hom U₂.prop hcomp

  have hMem_etale :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} (U : S.Etale) (R : CategoryTheory.Sieve U),
        R ∈ S.smallEtaleTopology U ↔
          ∀ x : ↥U.left, ∃ (Y : S.Etale) (f : Y ⟶ U) (y : ↥Y.left),
            R.arrows f ∧ AlgebraicGeometry.Etale f.left ∧ f.left y = x := by
    intro S U R
    have htop : S.smallEtaleTopology = S.smallEtalePretopology.toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S le_rfl
    rw [htop]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology U R

  have hArrows_mem :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {U : S.Etale} {ι : Type u}
        (Y : ι → S.Etale) (π : ∀ i : ι, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (π i).left y = x) →
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y π) ∈
          S.smallEtaleTopology U := by
    intro S U ι Y π hcov
    rw [hMem_etale]
    intro x
    obtain ⟨i, y, hy⟩ := hcov x
    exact ⟨Y i, π i, y,
      CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.ofArrows Y π) (Y i) (π i)
        (CategoryTheory.Presieve.ofArrows.mk i),
      hEtale_left (π i), hy⟩

  
  let L_pre (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}) :
      CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
    { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥(Opposite.unop U).left ↑A)
      map := fun {_ _} u =>
        AddCommGrpCat.ofHom
          { toFun := fun g =>
              { toFun := fun x => g (u.unop.left x)
                isLocallyConstant := fun t =>
                  u.unop.left.continuous.isOpen_preimage _ (g.isLocallyConstant t) }
            map_zero' := LocallyConstant.ext (fun _ => rfl)
            map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
      map_id := fun _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl))
      map_comp := fun _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }

  have hL_type_sheaf :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
        CategoryTheory.Presieve.IsSheaf S.smallEtaleTopology
          (L_pre S A ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
    intro S A U R hR fam hcompat
    let fam_lc {W : S.Etale} (g : W ⟶ U) (hg : R.arrows g) : LocallyConstant ↥W.left ↑A :=
      fam g hg
    have hSurj := (hMem_etale U R).mp hR
    have hFib_eq :
        ∀ {W₁ W₂ : S.Etale} (g₁ : W₁ ⟶ U) (g₂ : W₂ ⟶ U)
          (hg₁ : R.arrows g₁) (hg₂ : R.arrows g₂)
          (y₁ : ↥W₁.left) (y₂ : ↥W₂.left),
          g₁.left y₁ = g₂.left y₂ →
          fam_lc g₁ hg₁ y₁ = fam_lc g₂ hg₂ y₂ := by
      intro W₁ W₂ g₁ g₂ hg₁ hg₂ y₁ y₂ hy
      let Z₀ := CategoryTheory.Limits.pullback g₁.left g₂.left
      let p₁ : Z₀ ⟶ W₁.left := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
      let p₂ : Z₀ ⟶ W₂.left := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
      have hp₂_et : AlgebraicGeometry.Etale p₂ :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
          (CategoryTheory.IsPullback.of_hasPullback g₁.left g₂.left) (hEtale_left g₁)
      have hZ_et : AlgebraicGeometry.Etale (p₂ ≫ W₂.hom) :=
        CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          p₂ W₂.hom hp₂_et W₂.prop
      let Z : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₂ ≫ W₂.hom) hZ_et
      have hπ₁_w : p₁ ≫ W₁.hom = Z.hom := by
        change p₁ ≫ W₁.hom = p₂ ≫ W₂.hom
        calc
          p₁ ≫ W₁.hom = p₁ ≫ (g₁.left ≫ U.hom) := by
            rw [CategoryTheory.MorphismProperty.Over.w g₁]
          _ = (p₁ ≫ g₁.left) ≫ U.hom := (CategoryTheory.Category.assoc p₁ g₁.left U.hom).symm
          _ = (p₂ ≫ g₂.left) ≫ U.hom := by
            rw [CategoryTheory.Limits.pullback.condition]
          _ = p₂ ≫ (g₂.left ≫ U.hom) := CategoryTheory.Category.assoc p₂ g₂.left U.hom
          _ = p₂ ≫ W₂.hom := by
            rw [CategoryTheory.MorphismProperty.Over.w g₂]
      let π₁ : Z ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ hπ₁_w trivial
      let π₂ : Z ⟶ W₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ rfl trivial
      have hπ_comm : π₁ ≫ g₁ = π₂ ≫ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ hy
      have hc := hcompat π₁ π₂ hg₁ hg₂ hπ_comm
      have hc_z := congrArg (fun f : LocallyConstant ↥Z₀ ↑A => f z) hc
      change fam_lc g₁ hg₁ (p₁ z) = fam_lc g₂ hg₂ (p₂ z) at hc_z
      rwa [hz₁, hz₂] at hc_z
    let s_fn : ↥U.left → ↑A := fun x =>
      let W := Classical.choose (hSurj x)
      let hW := Classical.choose_spec (hSurj x)
      let g := Classical.choose hW
      let hg_all := Classical.choose_spec hW
      let y := Classical.choose hg_all
      let hy_spec := Classical.choose_spec hg_all
      fam_lc g hy_spec.1 y
    have hs_fn_eq :
        ∀ {W : S.Etale} (g : W ⟶ U) (hg : R.arrows g) (y : ↥W.left),
          s_fn (g.left y) = fam_lc g hg y := by
      intro W g hg y
      dsimp only [s_fn]
      set x := g.left y
      let hW := Classical.choose_spec (hSurj x)
      let g₀ := Classical.choose hW
      let hg_all := Classical.choose_spec hW
      let y₀ := Classical.choose hg_all
      let hy_spec := Classical.choose_spec hg_all
      exact hFib_eq g₀ g hy_spec.1 hg y₀ y hy_spec.2.2
    have hs_lc : IsLocallyConstant s_fn := by
      intro E
      rw [isOpen_iff_forall_mem_open]
      intro x hx
      obtain ⟨W, g, y, hg, hEt_g, hyx⟩ := hSurj x
      have : AlgebraicGeometry.Etale g.left := hEt_g
      let O_W : Set ↥W.left := fam_lc g hg ⁻¹' E
      have hOW_open : IsOpen O_W := (fam_lc g hg).isLocallyConstant E
      refine ⟨⇑g.left '' O_W, ?_, g.left.isOpenMap O_W hOW_open, ?_⟩
      · rintro _ ⟨y', hy', rfl⟩
        change s_fn (g.left y') ∈ E
        rw [hs_fn_eq g hg y']
        exact hy'
      · refine ⟨y, ?_, hyx⟩
        change fam_lc g hg y ∈ E
        rw [← hs_fn_eq g hg y, hyx]
        exact hx
    let s₀ : LocallyConstant ↥U.left ↑A := ⟨s_fn, hs_lc⟩
    refine ⟨s₀, ?_, ?_⟩
    · intro W g hg
      exact LocallyConstant.ext (fun y => hs_fn_eq g hg y)
    · intro s' hs'
      apply LocallyConstant.ext
      intro x
      obtain ⟨W, g, y, hg, -, hyx⟩ := hSurj x
      have h1 := congrArg (fun f : LocallyConstant ↥W.left ↑A => f y) (hs' g hg)
      let s'_lc : LocallyConstant ↥U.left ↑A := s'
      change s'_lc (g.left y) = fam_lc g hg y at h1
      change s'_lc x = s₀ x
      rw [← hyx, h1]
      exact (hs_fn_eq g hg y).symm

  have hL_sheaf :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (L_pre S A) := by
    intro S A E U R hR x hx
    have h_each : ∀ e : ↑E,
        ∃! t : LocallyConstant ↥U.left ↑A,
          ∀ ⦃W : S.Etale⦄ (g : W ⟶ U) (hg : R.arrows g),
            ((L_pre S A).map g.op).hom t = (x g hg).hom e := by
      intro e
      let fam_e : CategoryTheory.Presieve.FamilyOfElements
          (L_pre S A ⋙ CategoryTheory.forget AddCommGrpCat.{u}) R.arrows :=
        fun _ g hg => (x g hg).hom e
      have hcompat_e : CategoryTheory.Presieve.FamilyOfElements.Compatible fam_e := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
        have hc := hx g₁ g₂ h₁ h₂ hcomm
        exact congrArg (fun φ : E ⟶ (L_pre S A).obj (Opposite.op Z) => φ.hom e) hc
      exact hL_type_sheaf S A R hR fam_e hcompat_e
    let t_fn : ↑E → LocallyConstant ↥U.left ↑A := fun e => Classical.choose (h_each e)
    have ht_spec : ∀ (e : ↑E) ⦃W : S.Etale⦄ (g : W ⟶ U) (hg : R.arrows g),
        ((L_pre S A).map g.op).hom (t_fn e) = (x g hg).hom e :=
      fun e => (Classical.choose_spec (h_each e)).1
    have ht_uniq : ∀ (e : ↑E) (s : LocallyConstant ↥U.left ↑A),
        (∀ ⦃W : S.Etale⦄ (g : W ⟶ U) (hg : R.arrows g),
          ((L_pre S A).map g.op).hom s = (x g hg).hom e) → s = t_fn e :=
      fun e s hs => (Classical.choose_spec (h_each e)).2 s hs
    have ht_add : ∀ e₁ e₂ : ↑E, t_fn (e₁ + e₂) = t_fn e₁ + t_fn e₂ := by
      intro e₁ e₂
      symm
      apply ht_uniq (e₁ + e₂)
      intro W g hg
      rw [map_add, ht_spec e₁ g hg, ht_spec e₂ g hg, ← map_add]
    let t₀ : E ⟶ (L_pre S A).obj (Opposite.op U) :=
      AddCommGrpCat.ofHom (AddMonoidHom.mk' t_fn ht_add)
    refine ⟨t₀, ?_, ?_⟩
    · intro W g hg
      apply AddCommGrpCat.ext
      intro e
      exact ht_spec e g hg
    · intro t' ht'
      apply AddCommGrpCat.ext
      intro e
      apply ht_uniq e (t'.hom e)
      intro W g hg
      exact congrArg (fun φ : E ⟶ (L_pre S A).obj (Opposite.op W) => φ.hom e) (ht' g hg)

  let L_sh (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}) :
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} :=
    ⟨L_pre S A, hL_sheaf S A⟩
  let P_const (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}) :
      CategoryTheory.Functor (Opposite S.Etale) AddCommGrpCat.{u} :=
    (CategoryTheory.Functor.const (Opposite S.Etale)).obj A
  let adj_sh (S : AlgebraicGeometry.Scheme.{u}) :=
    CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}
  let η_sh (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}) :
      P_const S A ⟶
        ((CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj A).obj :=
    (adj_sh S).unit.app (P_const S A)
  let ι_lc (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}) :
      P_const S A ⟶ L_pre S A :=
    { app := fun U =>
        AddCommGrpCat.ofHom
          { toFun := fun a => LocallyConstant.const ↥(Opposite.unop U).left a
            map_zero' := LocallyConstant.ext (fun _ => rfl)
            map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
      naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }
  let α_lc (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}) :
      (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj A ⟶ L_sh S A :=
    ((adj_sh S).homEquiv (P_const S A) (L_sh S A)).symm (ι_lc S A)
  have hα_unit :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (A : AddCommGrpCat.{u}),
        η_sh S A ≫ (α_lc S A).hom = ι_lc S A := by
    intro S A
    have heq := ((adj_sh S).homEquiv (P_const S A) (L_sh S A)).apply_symm_apply (ι_lc S A)
    exact ((adj_sh S).homEquiv_unit (P_const S A) (L_sh S A) (α_lc S A)).symm.trans heq

  
  let A₂ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin r₂ → ZMod ℓ))
  let A₁ : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin r₁ → ZMod ℓ))
  let J_V := V.smallEtaleTopology
  let F₂ := (CategoryTheory.constantSheaf J_V AddCommGrpCat.{u}).obj A₂
  let F₁ := (CategoryTheory.constantSheaf J_V AddCommGrpCat.{u}).obj A₁

  have hF₁_type_sheaf :
      CategoryTheory.Presieve.IsSheaf J_V (F₁.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
    rw [← CategoryTheory.isSheaf_iff_isSheaf_of_type]
    exact CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J_V F₁.obj
      (CategoryTheory.forget AddCommGrpCat.{u}) F₁.property

  have hArrows_sheaf :
      ∀ {U : V.Etale} {ι : Type u} (Y : ι → V.Etale) (π : ∀ i : ι, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ (i : ι) (y : ↥(Y i).left), (π i).left y = x) →
        ∀ (sec : ∀ i : ι, ↑(F₁.obj.obj (Opposite.op (Y i)))),
          (∀ (i j : ι) (Z : V.Etale) (gi : Z ⟶ Y i) (gj : Z ⟶ Y j),
            gi ≫ π i = gj ≫ π j →
            (F₁.obj.map gi.op).hom (sec i) = (F₁.obj.map gj.op).hom (sec j)) →
          ∃! t : ↑(F₁.obj.obj (Opposite.op U)),
            ∀ i : ι, (F₁.obj.map (π i).op).hom t = sec i := by
    intro U ι Y π hcov sec hcomp
    have hmem := hArrows_mem Y π hcov
    have hgen := hF₁_type_sheaf _ hmem
    have h_arr :=
      (CategoryTheory.Presieve.isSheafFor_arrows_iff
        (F₁.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}) π).mp
        ((CategoryTheory.Presieve.isSheafFor_iff_generate
          (CategoryTheory.Presieve.ofArrows Y π)).mpr hgen)
    exact h_arr sec hcomp

  have hEmpty_sub :
      ∀ (Z : V.Etale), IsEmpty ↥Z.left → Subsingleton ↑(F₁.obj.obj (Opposite.op Z)) := by
    intro Z hZ
    have hex := hArrows_sheaf (U := Z) (ι := PEmpty.{u + 1})
      (fun e => PEmpty.elim e) (fun e => PEmpty.elim e)
      (fun x => False.elim (IsEmpty.false x))
      (fun e => PEmpty.elim e) (fun i => PEmpty.elim i)
    obtain ⟨t₀, -, ht₀_uniq⟩ := hex
    refine ⟨fun s₁ s₂ => ?_⟩
    have hs₁ : s₁ = t₀ := ht₀_uniq s₁ (fun i => PEmpty.elim i)
    have hs₂ : s₂ = t₀ := ht₀_uniq s₂ (fun i => PEmpty.elim i)
    exact hs₁.trans hs₂.symm

  let W_open (U : V.Etale) (f : LocallyConstant ↥U.left ↑A₁) (x : ↥U.left) : U.left.Opens :=
    ⟨(f : ↥U.left → ↑A₁) ⁻¹' {f x}, f.isLocallyConstant {f x}⟩
  let Y_lvl (U : V.Etale) (f : LocallyConstant ↥U.left ↑A₁) (x : ↥U.left) : V.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ ((W_open U f x).ι ≫ U.hom)
      (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
        (W_open U f x).ι U.hom inferInstance U.prop)
  let π_lvl (U : V.Etale) (f : LocallyConstant ↥U.left ↑A₁) (x : ↥U.left) :
      Y_lvl U f x ⟶ U :=
    CategoryTheory.MorphismProperty.Over.homMk (W_open U f x).ι rfl trivial

  have hη_nat :
      ∀ {W₁ W₂ : V.Etale} (g : W₁ ⟶ W₂) (a : ↑A₁),
        (F₁.obj.map g.op).hom (((η_sh V A₁).app (Opposite.op W₂)).hom a) =
          ((η_sh V A₁).app (Opposite.op W₁)).hom a := by
    intro W₁ W₂ g a
    have hnat := (η_sh V A₁).naturality g.op
    have h_ev := congrArg (fun φ : A₁ ⟶ F₁.obj.obj (Opposite.op W₁) => φ.hom a) hnat
    exact h_ev.symm

  have h_lvl_ex :
      ∀ (U : V.Etale) (f : LocallyConstant ↥U.left ↑A₁),
        ∃! t : ↑(F₁.obj.obj (Opposite.op U)),
          ∀ x : ↥U.left,
            (F₁.obj.map (π_lvl U f x).op).hom t =
              ((η_sh V A₁).app (Opposite.op (Y_lvl U f x))).hom (f x) := by
    intro U f
    apply hArrows_sheaf (Y_lvl U f) (π_lvl U f)
    · intro x
      exact ⟨x, ⟨x, rfl⟩, rfl⟩
    · intro x₁ x₂ Z g₁ g₂ hcomm
      by_cases hZ : IsEmpty ↥Z.left
      · have : Subsingleton ↑(F₁.obj.obj (Opposite.op Z)) := hEmpty_sub Z hZ
        exact Subsingleton.elim _ _
      · obtain ⟨z₀⟩ := not_isEmpty_iff.mp hZ
        have hp₁ : f ((g₁.left z₀).1) = f x₁ := (g₁.left z₀).2
        have hp₂ : f ((g₂.left z₀).1) = f x₂ := (g₂.left z₀).2
        have h_eq_pt : (g₁.left z₀).1 = (g₂.left z₀).1 := by
          have h_left : g₁.left ≫ (W_open U f x₁).ι = g₂.left ≫ (W_open U f x₂).ι :=
            congrArg (fun k : Z ⟶ U => k.left) hcomm
          exact congrArg (fun h : Z.left ⟶ U.left => h z₀) h_left
        have hfx : f x₁ = f x₂ := hp₁.symm.trans ((congrArg f h_eq_pt).trans hp₂)
        exact (hη_nat g₁ (f x₁)).trans
          ((congrArg (((η_sh V A₁).app (Opposite.op Z)).hom) hfx).trans
            (hη_nat g₂ (f x₂)).symm)

  let ψ_fun (U : V.Etale) (f : LocallyConstant ↥U.left ↑A₁) : ↑(F₁.obj.obj (Opposite.op U)) :=
    Classical.choose (h_lvl_ex U f)
  have hψ_spec :
      ∀ (U : V.Etale) (f : LocallyConstant ↥U.left ↑A₁) (x : ↥U.left),
        (F₁.obj.map (π_lvl U f x).op).hom (ψ_fun U f) =
          ((η_sh V A₁).app (Opposite.op (Y_lvl U f x))).hom (f x) :=
    fun U f => (Classical.choose_spec (h_lvl_ex U f)).1
  have hψ_uniq :
      ∀ (U : V.Etale) (f : LocallyConstant ↥U.left ↑A₁) (t : ↑(F₁.obj.obj (Opposite.op U))),
        (∀ x : ↥U.left,
          (F₁.obj.map (π_lvl U f x).op).hom t =
            ((η_sh V A₁).app (Opposite.op (Y_lvl U f x))).hom (f x)) →
        t = ψ_fun U f :=
    fun U f t ht => (Classical.choose_spec (h_lvl_ex U f)).2 t ht

  have hψ_const :
      ∀ {W U : V.Etale} (g : W ⟶ U) (f : LocallyConstant ↥U.left ↑A₁) (a : ↑A₁),
        (∀ y : ↥W.left, f (g.left y) = a) →
        (F₁.obj.map g.op).hom (ψ_fun U f) = ((η_sh V A₁).app (Opposite.op W)).hom a := by
    intro W U g f a hconst
    by_cases hW : IsEmpty ↥W.left
    · have : Subsingleton ↑(F₁.obj.obj (Opposite.op W)) := hEmpty_sub W hW
      exact Subsingleton.elim _ _
    · obtain ⟨y₀⟩ := not_isEmpty_iff.mp hW
      let x₀ : ↥U.left := g.left y₀
      have hfx₀ : f x₀ = a := hconst y₀
      have hrange : Set.range ⇑g.left ⊆ Set.range ⇑(W_open U f x₀).ι := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        rintro _ ⟨y, rfl⟩
        change f (g.left y) = f x₀
        rw [hconst y, hfx₀]
      let l₀ : W.left ⟶ (W_open U f x₀).toScheme :=
        AlgebraicGeometry.IsOpenImmersion.lift (W_open U f x₀).ι g.left hrange
      have hl₀_fac : l₀ ≫ (W_open U f x₀).ι = g.left :=
        AlgebraicGeometry.IsOpenImmersion.lift_fac (W_open U f x₀).ι g.left hrange
      have hl_w : l₀ ≫ (Y_lvl U f x₀).hom = W.hom := by
        change l₀ ≫ ((W_open U f x₀).ι ≫ U.hom) = W.hom
        rw [← CategoryTheory.Category.assoc, hl₀_fac]
        exact CategoryTheory.MorphismProperty.Over.w g
      let l : W ⟶ Y_lvl U f x₀ :=
        CategoryTheory.MorphismProperty.Over.homMk l₀ hl_w trivial
      have hl_comp : l ≫ π_lvl U f x₀ = g :=
        CategoryTheory.MorphismProperty.Over.Hom.ext hl₀_fac
      have hmap_g :
          (F₁.obj.map g.op).hom (ψ_fun U f) =
            (F₁.obj.map l.op).hom ((F₁.obj.map (π_lvl U f x₀).op).hom (ψ_fun U f)) := by
        have hop : g.op = (π_lvl U f x₀).op ≫ l.op := congrArg Quiver.Hom.op hl_comp.symm
        exact (congrArg (fun m => (F₁.obj.map m).hom (ψ_fun U f)) hop).trans
          (congrArg (fun φ : F₁.obj.obj (Opposite.op U) ⟶ F₁.obj.obj (Opposite.op W) =>
            φ.hom (ψ_fun U f)) (F₁.obj.map_comp (π_lvl U f x₀).op l.op))
      exact hmap_g.trans
        ((congrArg ((F₁.obj.map l.op).hom) (hψ_spec U f x₀)).trans
          ((hη_nat l (f x₀)).trans
            (congrArg (((η_sh V A₁).app (Opposite.op W)).hom) hfx₀)))

  have hψ_add :
      ∀ (U : V.Etale) (f₁ f₂ : LocallyConstant ↥U.left ↑A₁),
        ψ_fun U (f₁ + f₂) = ψ_fun U f₁ + ψ_fun U f₂ := by
    intro U f₁ f₂
    let W₁₂ (x : ↥U.left) : U.left.Opens :=
      ⟨(f₁ : ↥U.left → ↑A₁) ⁻¹' {f₁ x} ∩ (f₂ : ↥U.left → ↑A₁) ⁻¹' {f₂ x},
        (f₁.isLocallyConstant {f₁ x}).inter (f₂.isLocallyConstant {f₂ x})⟩
    let Y₁₂ (x : ↥U.left) : V.Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤ ((W₁₂ x).ι ≫ U.hom)
        (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
          (W₁₂ x).ι U.hom inferInstance U.prop)
    let π₁₂ (x : ↥U.left) : Y₁₂ x ⟶ U :=
      CategoryTheory.MorphismProperty.Over.homMk (W₁₂ x).ι rfl trivial
    have hcov₁₂ : ∀ x : ↥U.left, ∃ (i : ↥U.left) (y : ↥(Y₁₂ i).left), (π₁₂ i).left y = x :=
      fun x => ⟨x, ⟨x, ⟨rfl, rfl⟩⟩, rfl⟩
    have hsec_eq :
        ∀ x : ↥U.left,
          (F₁.obj.map (π₁₂ x).op).hom (ψ_fun U (f₁ + f₂)) =
            (F₁.obj.map (π₁₂ x).op).hom (ψ_fun U f₁ + ψ_fun U f₂) := by
      intro x
      have hc_sum : (F₁.obj.map (π₁₂ x).op).hom (ψ_fun U (f₁ + f₂)) =
          ((η_sh V A₁).app (Opposite.op (Y₁₂ x))).hom (f₁ x + f₂ x) := by
        apply hψ_const (π₁₂ x) (f₁ + f₂) (f₁ x + f₂ x)
        intro y
        change f₁ y.1 + f₂ y.1 = f₁ x + f₂ x
        rw [y.2.1, y.2.2]
      have hc₁ : (F₁.obj.map (π₁₂ x).op).hom (ψ_fun U f₁) =
          ((η_sh V A₁).app (Opposite.op (Y₁₂ x))).hom (f₁ x) :=
        hψ_const (π₁₂ x) f₁ (f₁ x) (fun y => y.2.1)
      have hc₂ : (F₁.obj.map (π₁₂ x).op).hom (ψ_fun U f₂) =
          ((η_sh V A₁).app (Opposite.op (Y₁₂ x))).hom (f₂ x) :=
        hψ_const (π₁₂ x) f₂ (f₂ x) (fun y => y.2.2)
      exact hc_sum.trans
        ((((η_sh V A₁).app (Opposite.op (Y₁₂ x))).hom.map_add (f₁ x) (f₂ x)).trans
          ((congrArg₂ (· + ·) hc₁.symm hc₂.symm).trans
            ((F₁.obj.map (π₁₂ x).op).hom.map_add (ψ_fun U f₁) (ψ_fun U f₂)).symm))
    obtain ⟨t₀, -, ht₀_uniq⟩ := hArrows_sheaf Y₁₂ π₁₂ hcov₁₂
      (fun x => (F₁.obj.map (π₁₂ x).op).hom (ψ_fun U (f₁ + f₂)))
      (fun x₁ x₂ Z g₁ g₂ hcomm => by
        have h1 : ((π₁₂ x₁).op ≫ g₁.op) = (g₁ ≫ π₁₂ x₁).op := rfl
        have h2 : ((π₁₂ x₂).op ≫ g₂.op) = (g₂ ≫ π₁₂ x₂).op := rfl
        calc
          (F₁.obj.map g₁.op).hom ((F₁.obj.map (π₁₂ x₁).op).hom (ψ_fun U (f₁ + f₂)))
            = (F₁.obj.map ((π₁₂ x₁).op ≫ g₁.op)).hom (ψ_fun U (f₁ + f₂)) := by
                rw [F₁.obj.map_comp]; rfl
          _ = (F₁.obj.map (g₁ ≫ π₁₂ x₁).op).hom (ψ_fun U (f₁ + f₂)) := rfl
          _ = (F₁.obj.map (g₂ ≫ π₁₂ x₂).op).hom (ψ_fun U (f₁ + f₂)) := by rw [hcomm]
          _ = (F₁.obj.map g₂.op).hom ((F₁.obj.map (π₁₂ x₂).op).hom (ψ_fun U (f₁ + f₂))) := by
                rw [← h2, F₁.obj.map_comp]; rfl)
    have hL : ψ_fun U (f₁ + f₂) = t₀ := ht₀_uniq (ψ_fun U (f₁ + f₂)) (fun _ => rfl)
    have hR : ψ_fun U f₁ + ψ_fun U f₂ = t₀ :=
      ht₀_uniq (ψ_fun U f₁ + ψ_fun U f₂) (fun x => (hsec_eq x).symm)
    exact hL.trans hR.symm

  have hψ_nat :
      ∀ {U₁ U₂ : V.Etale} (u : U₁ ⟶ U₂) (f : LocallyConstant ↥U₂.left ↑A₁),
        (F₁.obj.map u.op).hom (ψ_fun U₂ f) =
          ψ_fun U₁ (((L_pre V A₁).map u.op).hom f) := by
    intro U₁ U₂ u f
    let f' : LocallyConstant ↥U₁.left ↑A₁ := ((L_pre V A₁).map u.op).hom f
    apply hψ_uniq U₁ f' ((F₁.obj.map u.op).hom (ψ_fun U₂ f))
    intro x₁
    calc
      (F₁.obj.map (π_lvl U₁ f' x₁).op).hom ((F₁.obj.map u.op).hom (ψ_fun U₂ f))
        = (F₁.obj.map (π_lvl U₁ f' x₁ ≫ u).op).hom (ψ_fun U₂ f) := by
            have hop : (π_lvl U₁ f' x₁ ≫ u).op = u.op ≫ (π_lvl U₁ f' x₁).op := rfl
            rw [hop, F₁.obj.map_comp]; rfl
      _ = ((η_sh V A₁).app (Opposite.op (Y_lvl U₁ f' x₁))).hom (f' x₁) := by
            apply hψ_const (π_lvl U₁ f' x₁ ≫ u) f (f' x₁)
            intro y
            exact y.2

  let β_nat : L_pre V A₁ ⟶ F₁.obj :=
    { app := fun U =>
        AddCommGrpCat.ofHom (AddMonoidHom.mk' (ψ_fun U.unop) (hψ_add U.unop))
      naturality := fun {U₂ U₁} u => by
        apply AddCommGrpCat.ext
        intro f
        exact (hψ_nat u.unop f).symm }
  let β_lc : L_sh V A₁ ⟶ F₁ := { hom := β_nat }

  have hαβ_id : α_lc V A₁ ≫ β_lc = 𝟙 F₁ := by
    apply ((adj_sh V).homEquiv (P_const V A₁) F₁).injective
    have hL_eq : ((adj_sh V).homEquiv (P_const V A₁) F₁) (α_lc V A₁ ≫ β_lc) =
        η_sh V A₁ ≫ ((α_lc V A₁).hom ≫ β_nat) :=
      (adj_sh V).homEquiv_unit (P_const V A₁) F₁ (α_lc V A₁ ≫ β_lc)
    have hR_eq : ((adj_sh V).homEquiv (P_const V A₁) F₁) (𝟙 F₁) =
        η_sh V A₁ ≫ 𝟙 F₁.obj :=
      (adj_sh V).homEquiv_unit (P_const V A₁) F₁ (𝟙 F₁)
    have hmid : η_sh V A₁ ≫ ((α_lc V A₁).hom ≫ β_nat) = η_sh V A₁ ≫ 𝟙 F₁.obj := by
      rw [← CategoryTheory.Category.assoc, hα_unit V A₁, CategoryTheory.Category.comp_id]
      ext U_op : 2
      apply AddCommGrpCat.ext
      intro a
      have hid_map :
          (F₁.obj.map (𝟙 U_op.unop).op).hom
              (ψ_fun U_op.unop (LocallyConstant.const ↥U_op.unop.left a)) =
            ψ_fun U_op.unop (LocallyConstant.const ↥U_op.unop.left a) :=
        congrArg (fun φ : F₁.obj.obj U_op ⟶ F₁.obj.obj U_op =>
          φ.hom (ψ_fun U_op.unop (LocallyConstant.const ↥U_op.unop.left a)))
          (F₁.obj.map_id U_op)
      exact hid_map.symm.trans
        (hψ_const (𝟙 U_op.unop) (LocallyConstant.const ↥U_op.unop.left a) a (fun _ => rfl))
    exact hL_eq.trans (hmid.trans hR_eq.symm)

  have hα_inj :
      ∀ (U : V.Etale),
        Function.Injective (((α_lc V A₁).hom.app (Opposite.op U)).hom) := by
    intro U s₁ s₂ hs
    have h1 := congrArg (fun φ : F₁ ⟶ F₁ => (φ.hom.app (Opposite.op U)).hom s₁) hαβ_id
    have h2 := congrArg (fun φ : F₁ ⟶ F₁ => (φ.hom.app (Opposite.op U)).hom s₂) hαβ_id
    change (β_nat.app (Opposite.op U)).hom (((α_lc V A₁).hom.app (Opposite.op U)).hom s₁) = s₁ at h1
    change (β_nat.app (Opposite.op U)).hom (((α_lc V A₁).hom.app (Opposite.op U)).hom s₂) = s₂ at h2
    rw [← h1, ← h2, hs]

  
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let J_k := S_k.smallEtaleTopology
  let B := weilEtaleSitePullback s_v
  let pf := (weilEtaleSitePullback s_v).sheafPushforwardContinuous AddCommGrpCat.{u}
    V.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
  let pb := (weilEtaleSitePullback s_v).sheafPullback AddCommGrpCat.{u}
    V.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
  let adj := (weilEtaleSitePullback s_v).sheafAdjunctionContinuous AddCommGrpCat.{u}
    V.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology

  let ρ_nat : L_pre V A₁ ⟶ B.op ⋙ L_pre S_k A₁ :=
    { app := fun U =>
        let p₁ : (B.obj U.unop).left ⟶ U.unop.left :=
          CategoryTheory.Limits.pullback.fst U.unop.hom s_v
        AddCommGrpCat.ofHom
          { toFun := fun g =>
              { toFun := fun z => g (p₁ z)
                isLocallyConstant := fun t =>
                  p₁.continuous.isOpen_preimage _ (g.isLocallyConstant t) }
            map_zero' := LocallyConstant.ext (fun _ => rfl)
            map_add' := fun _ _ => LocallyConstant.ext (fun _ => rfl) }
      naturality := fun {U₂ U₁} u =>
        AddCommGrpCat.ext (fun (g : LocallyConstant ↥U₂.unop.left ↑A₁) =>
          LocallyConstant.ext (fun z =>
            congrArg g
              ((AlgebraicGeometry.Scheme.Hom.comp_apply
                (B.map u.unop).left
                (CategoryTheory.Limits.pullback.fst U₂.unop.hom s_v) z).symm.trans
              ((congrArg (fun k : (B.obj U₁.unop).left ⟶ U₂.unop.left => k z)
                (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
              (AlgebraicGeometry.Scheme.Hom.comp_apply
                (CategoryTheory.Limits.pullback.fst U₁.unop.hom s_v)
                u.unop.left z))).symm)) }
  let ρ_sh : L_sh V A₁ ⟶ pf.obj (L_sh S_k A₁) := { hom := ρ_nat }

  
  let EV_sh {S : AlgebraicGeometry.Scheme.{u}} (W_op : Opposite S.Etale) :
      CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
    CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj W_op

  have hSheaf_zero_app :
      ∀ {S : AlgebraicGeometry.Scheme.{u}}
        (G₁ G₂ : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        (W_op : Opposite S.Etale),
        ((0 : G₁ ⟶ G₂).hom).app W_op = 0 :=
    fun G₁ G₂ W_op => (EV_sh W_op).map_zero G₁ G₂

  let θ : F₁ ⟶ pf.obj (L_sh S_k A₁) := α_lc V A₁ ≫ ρ_sh
  let θ_tilde : pb.obj F₁ ⟶ L_sh S_k A₁ := (adj.homEquiv F₁ (L_sh S_k A₁)).symm θ
  have hpb_comp_zero : pb.map Φ ≫ θ_tilde = 0 := by
    rw [hΦ_zero, CategoryTheory.Limits.zero_comp]

  have hpf_zero : pf.map (0 : pb.obj F₂ ⟶ L_sh S_k A₁) = 0 := by
    apply CategoryTheory.Sheaf.hom_ext
    ext U_op : 2
    exact (hSheaf_zero_app (pb.obj F₂) (L_sh S_k A₁) (Opposite.op (B.obj U_op.unop))).trans
      (hSheaf_zero_app (pf.obj (pb.obj F₂)) (pf.obj (L_sh S_k A₁)) U_op).symm

  have hΦθ_zero : Φ ≫ θ = 0 := by
    have hmate := congrArg (adj.homEquiv F₂ (L_sh S_k A₁)) hpb_comp_zero
    rw [adj.homEquiv_naturality_left, (adj.homEquiv F₁ (L_sh S_k A₁)).apply_symm_apply θ,
      adj.homEquiv_unit, hpf_zero, CategoryTheory.Limits.comp_zero] at hmate
    exact hmate

  
  let T_V : V.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ (CategoryTheory.CategoryStruct.id V)
      (inferInstance : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id V))
  let pt_k : ↥S_k := IsLocalRing.closedPoint k
  let v₀ : ↥V := s_v pt_k
  have hv₀_eq : T_V.hom v₀ = s_v pt_k := rfl
  obtain ⟨z₀, hz₀_fst, -⟩ :=
    AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback v₀ pt_k hv₀_eq

  have hTV_zero : (η_sh V A₂ ≫ Φ.hom).app (Opposite.op T_V) = 0 := by
    apply AddCommGrpCat.ext
    intro a₂
    change (Φ.hom.app (Opposite.op T_V)).hom (((η_sh V A₂).app (Opposite.op T_V)).hom a₂) = 0
    set s₁ := (Φ.hom.app (Opposite.op T_V)).hom (((η_sh V A₂).app (Opposite.op T_V)).hom a₂)
    set g : LocallyConstant ↥V ↑A₁ := ((α_lc V A₁).hom.app (Opposite.op T_V)).hom s₁
    have hΦθ_app : ((Φ ≫ θ).hom).app (Opposite.op T_V) = 0 := by
      rw [hΦθ_zero]
      exact hSheaf_zero_app F₂ (pf.obj (L_sh S_k A₁)) (Opposite.op T_V)
    have h_ev_s :=
      congrArg (fun φ : F₂.obj.obj (Opposite.op T_V) ⟶
          (pf.obj (L_sh S_k A₁)).obj.obj (Opposite.op T_V) =>
        φ.hom (((η_sh V A₂).app (Opposite.op T_V)).hom a₂)) hΦθ_app
    have h_ev_z : g ((CategoryTheory.Limits.pullback.fst T_V.hom s_v) z₀) = 0 :=
      congrArg (fun f : LocallyConstant ↥(B.obj T_V).left ↑A₁ => f z₀) h_ev_s
    have hgv₀ : g v₀ = 0 := (congrArg g hz₀_fst.symm).trans h_ev_z
    have hg_zero : g = 0 := by
      ext x
      have hx_eq : g x = g v₀ :=
        IsLocallyConstant.apply_eq_of_preconnectedSpace g.isLocallyConstant x v₀
      exact hx_eq.trans hgv₀
    apply hα_inj T_V
    exact hg_zero.trans (((α_lc V A₁).hom.app (Opposite.op T_V)).hom.map_zero).symm

  apply ((adj_sh V).homEquiv (P_const V A₂) F₁).injective
  have hL_Φ : ((adj_sh V).homEquiv (P_const V A₂) F₁) Φ = η_sh V A₂ ≫ Φ.hom :=
    (adj_sh V).homEquiv_unit (P_const V A₂) F₁ Φ
  have hR_0 : ((adj_sh V).homEquiv (P_const V A₂) F₁) (0 : F₂ ⟶ F₁) =
      η_sh V A₂ ≫ (0 : F₂ ⟶ F₁).hom :=
    (adj_sh V).homEquiv_unit (P_const V A₂) F₁ (0 : F₂ ⟶ F₁)
  have hηΦ_eq : η_sh V A₂ ≫ Φ.hom = η_sh V A₂ ≫ (0 : F₂ ⟶ F₁).hom := by
    ext U_op : 2
    let U := U_op.unop
    let τ_U : U ⟶ T_V :=
      CategoryTheory.MorphismProperty.Over.homMk U.hom
        (CategoryTheory.Category.comp_id U.hom) trivial
    have hnat_U :
        𝟙 A₂ ≫ (η_sh V A₂ ≫ Φ.hom).app U_op =
          (η_sh V A₂ ≫ Φ.hom).app (Opposite.op T_V) ≫ F₁.obj.map τ_U.op :=
      (η_sh V A₂ ≫ Φ.hom).naturality τ_U.op
    have hLHS_U : (η_sh V A₂ ≫ Φ.hom).app U_op = 0 :=
      (CategoryTheory.Category.id_comp _).symm.trans
        (hnat_U.trans
          ((congrArg (· ≫ F₁.obj.map τ_U.op) hTV_zero).trans
            CategoryTheory.Limits.zero_comp))
    have hRHS_U : (η_sh V A₂ ≫ (0 : F₂ ⟶ F₁).hom).app U_op = 0 :=
      (congrArg ((η_sh V A₂).app U_op ≫ ·) (hSheaf_zero_app F₂ F₁ U_op)).trans
        CategoryTheory.Limits.comp_zero
    exact hLHS_U.trans hRHS_U.symm
  exact hL_Φ.trans (hηΦ_eq.trans hR_0.symm)

theorem weil_algClosed_affine_etale_spec_finite_open_split (k : Type u) [Field k] [IsAlgClosed k]
    (X : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine X]
    (p : Quiver.Hom X (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.Etale p] :
    ∃ (n : ℕ) (σ : Fin n → Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) X),
      (∀ i : Fin n,
        CategoryTheory.CategoryStruct.comp (σ i) p =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k))) ∧
      (∀ i : Fin n, AlgebraicGeometry.IsOpenImmersion (σ i)) ∧
      _root_.Pairwise (fun i j : Fin n =>
        Disjoint (Set.range (σ i).base) (Set.range (σ j).base)) ∧
      (⋃ i : Fin n, Set.range (σ i).base) = Set.univ :=
by
  classical
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let B : CommRingCat.{u} := X.presheaf.obj (Opposite.op ⊤)
  let e_X : X ≅ AlgebraicGeometry.Spec B := X.isoSpec
  let φ : CommRingCat.of k ⟶ B := AlgebraicGeometry.Spec.preimage (e_X.inv ≫ p)
  have hmap_φ : AlgebraicGeometry.Spec.map φ = e_X.inv ≫ p :=
    AlgebraicGeometry.Spec.map_preimage (e_X.inv ≫ p)
  have hEt_Spec : AlgebraicGeometry.Etale (AlgebraicGeometry.Spec.map φ) := by
    rw [hmap_φ]
    infer_instance
  have hEt_hom : RingHom.Etale φ.hom :=
    (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp hEt_Spec
  letI : Algebra k ↑B := φ.hom.toAlgebra
  have : Algebra.Etale k ↑B := @RingHom.Etale.toAlgebra k (↑B) _ _ φ.hom hEt_hom
  obtain ⟨I, hFin_I, F, hField_F, hAlg_F, e_prod, hFinSep⟩ :=
    (Algebra.Etale.iff_exists_algEquiv_prod k ↑B).mp inferInstance
  letI : Finite I := hFin_I
  letI : ∀ i : I, Field (F i) := hField_F
  letI : ∀ i : I, Algebra k (F i) := hAlg_F
  have e_F : ∀ i : I, F i ≃ₐ[k] k := fun i => by
    have : Module.Finite k (F i) := (hFinSep i).1
    have : Algebra.IsIntegral k (F i) := Algebra.IsIntegral.of_finite k (F i)
    have h_bij : Function.Bijective (algebraMap k (F i)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    exact (AlgEquiv.ofBijective (Algebra.ofId k (F i)) h_bij).symm
  let e_pi₁ : (∀ i : I, F i) ≃ₐ[k] (I → k) := AlgEquiv.piCongrRight e_F
  obtain ⟨n, ⟨e_I⟩⟩ := Finite.exists_equiv_fin I
  let e_pi₂ : (I → k) ≃ₐ[k] (Fin n → k) := AlgEquiv.piCongrLeft' k (fun _ : I => k) e_I
  let ψ_alg : ↑B ≃ₐ[k] (Fin n → k) := (e_prod.trans e_pi₁).trans e_pi₂
  let ψ : ↑B ≃+* (Fin n → k) := ψ_alg.toRingEquiv
  have hψ_φ : ∀ (c : k) (i : Fin n), ψ (φ.hom c) i = c :=
    fun c i => congrFun (ψ_alg.commutes c) i
  let ev : Fin n → (↑B →+* k) :=
    fun i => (Pi.evalRingHom (fun _ : Fin n => k) i).comp ψ.toRingHom
  let u : Fin n → ↑B := fun i => ψ.symm (Pi.single i (1 : k))
  let σ_B : Fin n → (S_k ⟶ AlgebraicGeometry.Spec B) :=
    fun i => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ev i))
  have hev_apply : ∀ (i : Fin n) (b : ↑B), ev i b = ψ b i := fun _ _ => rfl
  have hev_u_same : ∀ i : Fin n, ev i (u i) = 1 := by
    intro i
    change ψ (ψ.symm (Pi.single i (1 : k))) i = 1
    rw [ψ.apply_symm_apply, Pi.single_eq_same]
  have hev_u_ne : ∀ {i j : Fin n}, i ≠ j → ev j (u i) = 0 := by
    intro i j hij
    change ψ (ψ.symm (Pi.single i (1 : k))) j = 0
    rw [ψ.apply_symm_apply, Pi.single_eq_of_ne hij.symm]
  have hσB_sec : ∀ i : Fin n, σ_B i ≫ AlgebraicGeometry.Spec.map φ = 𝟙 S_k := by
    intro i
    have hφ_ev : φ ≫ CommRingCat.ofHom (ev i) = 𝟙 (CommRingCat.of k) :=
      CommRingCat.hom_ext (RingHom.ext fun c => hψ_φ c i)
    dsimp [σ_B, S_k]
    rw [← AlgebraicGeometry.Spec.map_comp, hφ_ev, AlgebraicGeometry.Spec.map_id]
  have hσB_open : ∀ i : Fin n, AlgebraicGeometry.IsOpenImmersion (σ_B i) := by
    intro i
    letI : Algebra (↑B) k := (ev i).toAlgebra
    have : IsLocalization.Away (u i) k :=
      { map_units := by
          rintro ⟨_, ⟨m, rfl⟩⟩
          change IsUnit (ev i (u i ^ m))
          rw [map_pow, hev_u_same i, one_pow]
          exact isUnit_one
        surj := fun z =>
          ⟨(φ.hom z, ⟨1, ⟨0, pow_zero (u i)⟩⟩), by
            change z * ev i 1 = ev i (φ.hom z)
            rw [map_one, mul_one, hev_apply, hψ_φ z i]⟩
        exists_of_eq := fun {b₁ b₂} h_eq =>
          ⟨⟨u i, ⟨1, pow_one (u i)⟩⟩, by
            change u i * b₁ = u i * b₂
            apply ψ.injective
            rw [map_mul, map_mul, ψ.apply_symm_apply]
            funext j
            simp only [Pi.mul_apply]
            by_cases hji : j = i
            · subst hji
              have h_eq' : ψ b₁ j = ψ b₂ j := h_eq
              rw [h_eq']
            · rw [Pi.single_eq_of_ne hji, zero_mul, zero_mul]⟩ }
    exact @AlgebraicGeometry.IsOpenImmersion.of_isLocalization (↑B) k _ _ _ (u i) _
  have hpt_bot : ∀ pt : PrimeSpectrum k, pt.asIdeal = ⊥ := by
    intro pt
    ext c
    simp only [Ideal.mem_bot]
    constructor
    · intro hc
      by_contra hne
      exact pt.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ hc (IsUnit.mk0 c hne))
    · rintro rfl
      exact pt.asIdeal.zero_mem
  have hσB_disj : _root_.Pairwise (fun i j : Fin n =>
      Disjoint (Set.range (σ_B i).base) (Set.range (σ_B j).base)) := by
    intro i j hij
    rw [Set.disjoint_left]
    rintro q ⟨pt₁, rfl⟩ ⟨pt₂, hq₂⟩
    have hcomap : Ideal.comap (ev i) (pt₁ : PrimeSpectrum k).asIdeal =
        Ideal.comap (ev j) (pt₂ : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hq₂.symm
    rw [hpt_bot pt₁, hpt_bot pt₂] at hcomap
    have mem_j : u i ∈ Ideal.comap (ev j) (⊥ : Ideal k) := by
      rw [Ideal.mem_comap, Ideal.mem_bot]
      exact hev_u_ne hij
    rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, hev_u_same i] at mem_j
    exact one_ne_zero mem_j
  have h_sum : (∑ i : Fin n, u i) = (1 : ↑B) := by
    apply ψ.injective
    rw [map_sum, map_one]
    have h_simp : (∑ i : Fin n, ψ (u i)) = ∑ i : Fin n, Pi.single i (1 : k) :=
      Finset.sum_congr rfl fun i _ => ψ.apply_symm_apply (Pi.single i (1 : k))
    rw [h_simp]
    exact @Finset.univ_sum_single (Fin n) _ (fun _ => k) _ _ (fun _ => (1 : k))
  let pt₀ : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hσB_cov : (⋃ i : Fin n, Set.range (σ_B i).base) = Set.univ := by
    apply Set.eq_univ_iff_forall.mpr
    intro q
    let q_spec : PrimeSpectrum ↑B := q
    have h_ex : ∃ i : Fin n, u i ∉ q_spec.asIdeal := by
      by_contra! h_all
      have h1_mem : (1 : ↑B) ∈ q_spec.asIdeal := by
        rw [← h_sum]
        exact q_spec.asIdeal.sum_mem fun i _ => h_all i
      exact q_spec.isPrime.ne_top (q_spec.asIdeal.eq_top_iff_one.mpr h1_mem)
    obtain ⟨i, hui⟩ := h_ex
    have h_diff : ∀ b : ↑B, b - φ.hom (ev i b) ∈ q_spec.asIdeal := by
      intro b
      have h_ann : u i * (b - φ.hom (ev i b)) = 0 := by
        apply ψ.injective
        rw [map_mul, map_sub, map_zero, ψ.apply_symm_apply]
        funext j
        simp only [Pi.mul_apply, Pi.sub_apply, Pi.zero_apply]
        rw [hψ_φ (ev i b) j]
        by_cases hji : j = i
        · subst hji
          rw [Pi.single_eq_same, hev_apply, sub_self, mul_zero]
        · rw [Pi.single_eq_of_ne hji, zero_mul]
      have h_prod_mem : u i * (b - φ.hom (ev i b)) ∈ q_spec.asIdeal := by
        rw [h_ann]
        exact q_spec.asIdeal.zero_mem
      exact (q_spec.isPrime.mem_or_mem h_prod_mem).resolve_left hui
    have hq_eq : (σ_B i).base pt₀ = q := by
      apply PrimeSpectrum.ext
      change Ideal.comap (ev i) (⊥ : Ideal k) = q_spec.asIdeal
      ext b
      rw [Ideal.mem_comap, Ideal.mem_bot]
      constructor
      · intro hev0
        have h_sub := h_diff b
        rwa [hev0, map_zero, sub_zero] at h_sub
      · intro hb
        have hφ_mem : φ.hom (ev i b) ∈ q_spec.asIdeal := by
          have h_eq : φ.hom (ev i b) = b - (b - φ.hom (ev i b)) := by ring
          rw [h_eq]
          exact q_spec.asIdeal.sub_mem hb (h_diff b)
        by_contra hc
        have h1_mem : (1 : ↑B) ∈ q_spec.asIdeal := by
          have h1_eq : φ.hom (ev i b) * φ.hom (ev i b)⁻¹ = 1 := by
            rw [← map_mul, mul_inv_cancel₀ hc, map_one]
          rw [← h1_eq]
          exact q_spec.asIdeal.mul_mem_right _ hφ_mem
        exact q_spec.isPrime.ne_top (q_spec.asIdeal.eq_top_iff_one.mpr h1_mem)
    exact Set.mem_iUnion.mpr ⟨i, pt₀, hq_eq⟩
  let σ : Fin n → (S_k ⟶ X) := fun i => σ_B i ≫ e_X.inv
  refine ⟨n, σ, ?_, ?_, ?_, ?_⟩
  · intro i
    change (σ_B i ≫ e_X.inv) ≫ p = 𝟙 S_k
    rw [CategoryTheory.Category.assoc, ← hmap_φ]
    exact hσB_sec i
  · intro i
    have : AlgebraicGeometry.IsOpenImmersion (σ_B i) := hσB_open i
    have : AlgebraicGeometry.IsOpenImmersion e_X.inv :=
      AlgebraicGeometry.IsOpenImmersion.of_isIso e_X.inv
    exact AlgebraicGeometry.IsOpenImmersion.comp (σ_B i) e_X.inv
  · intro i j hij
    rw [Set.disjoint_left]
    rintro x ⟨pt₁, rfl⟩ ⟨pt₂, hx₂⟩
    have h₁ : e_X.hom.base ((σ i).base pt₁) ∈ Set.range (σ_B i).base := by
      refine ⟨pt₁, ?_⟩
      change (σ_B i).base pt₁ = (σ_B i ≫ e_X.inv ≫ e_X.hom).base pt₁
      rw [e_X.inv_hom_id, CategoryTheory.Category.comp_id]
    have h₂ : e_X.hom.base ((σ i).base pt₁) ∈ Set.range (σ_B j).base := by
      rw [← hx₂]
      refine ⟨pt₂, ?_⟩
      change (σ_B j).base pt₂ = (σ_B j ≫ e_X.inv ≫ e_X.hom).base pt₂
      rw [e_X.inv_hom_id, CategoryTheory.Category.comp_id]
    exact Set.disjoint_left.mp (hσB_disj hij) h₁ h₂
  · apply Set.eq_univ_iff_forall.mpr
    intro x
    have hx_univ : e_X.hom.base x ∈ (⋃ i : Fin n, Set.range (σ_B i).base) := by
      rw [hσB_cov]
      trivial
    obtain ⟨i, pt, hpt⟩ := Set.mem_iUnion.mp hx_univ
    refine Set.mem_iUnion.mpr ⟨i, pt, ?_⟩
    change e_X.inv.base ((σ_B i).base pt) = x
    rw [hpt]
    change (e_X.hom ≫ e_X.inv).base x = x
    rw [e_X.hom_inv_id]
    rfl

theorem weil_etale_disjoint_open_cover_localTorsion_partition_of_id (S : AlgebraicGeometry.Scheme.{u}) (m n : ℕ)
    (U : S.Etale) (U_part : Fin n → S.Etale)
    (α : ∀ i : Fin n, Quiver.Hom (U_part i) U)
    (hOpen : ∀ i : Fin n, AlgebraicGeometry.IsOpenImmersion (α i).left)
    (hDisj : _root_.Pairwise (fun i j : Fin n =>
      Disjoint (Set.range (α i).left.base) (Set.range (α j).left.base)))
    (hCov : (⋃ i : Fin n, Set.range (α i).left.base) = Set.univ) :
    ∃ π : ∀ i : Fin n,
        Quiver.Hom (weilEtaleLocalTorsionSheaf S m U)
          (weilEtaleLocalTorsionSheaf S m (U_part i)),
      (∑ i : Fin n,
        CategoryTheory.CategoryStruct.comp (π i) (weilEtaleLocalTorsionMap S m (α i))) =
        CategoryTheory.CategoryStruct.id (weilEtaleLocalTorsionSheaf S m U) :=
by
  classical
  let J := S.smallEtaleTopology
  let AM : AddCommGrpCat.{u} := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let P_hom : CategoryTheory.Sheaf J AddCommGrpCat.{u} → ((S.Etale)ᵒᵖ ⥤ Type u) :=
    fun G => G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op AM)
  have hEquiv_comp :
      ∀ {W_et : S.Etale}
        {F G : CategoryTheory.Sheaf J AddCommGrpCat.{u}}
        (β : weilEtaleLocalTorsionSheaf S m W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (β ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv β ≫ g.hom.app (Opposite.op W_et) := by
    intro W_et F G β g
    let β' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := β
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ G) (β' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ F) β' ≫
              (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv β ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  letI : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have hJ_eq : J = (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
    AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      S (le_refl P_et)
  have hMem_J : ∀ (W : S.Etale) (R : CategoryTheory.Sieve W),
      R ∈ J W ↔ ∀ (x : ↥W.left), ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
        R.arrows f ∧ P_et f.left ∧ f.left.base y = x := by
    intro W R
    exact (congrArg (fun T : CategoryTheory.GrothendieckTopology S.Etale => R ∈ T W) hJ_eq).to_iff.trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) (S := S) W R)
  have hSub_empty : ∀ (W : S.Etale), IsEmpty ↥W.left →
      ∀ (G : CategoryTheory.Sheaf J AddCommGrpCat.{u}),
        Subsingleton (AM ⟶ G.obj.obj (Opposite.op W)) := by
    intro W hEmpty G
    have hBot_mem : (⊥ : CategoryTheory.Sieve W) ∈ J W :=
      (hMem_J W ⊥).mpr (fun x => IsEmpty.elim hEmpty x)
    have hGen_bot : CategoryTheory.Sieve.generate (⊥ : CategoryTheory.Sieve W).arrows ∈ J W := by
      rwa [CategoryTheory.Sieve.generate_sieve (⊥ : CategoryTheory.Sieve W)]
    have hSep : CategoryTheory.Presieve.IsSeparatedFor (P_hom G)
        (⊥ : CategoryTheory.Sieve W).arrows :=
      ((G.property AM).isSheafFor (⊥ : CategoryTheory.Sieve W).arrows hGen_bot).isSeparatedFor
    refine ⟨fun φ₁ φ₂ => hSep.ext (fun Y f hf => ?_)⟩
    exact False.elim ((CategoryTheory.Sieve.bot_apply f).mp hf)
  let P_cov : CategoryTheory.Presieve U := CategoryTheory.Presieve.ofArrows U_part α
  let R_cov : CategoryTheory.Sieve U := CategoryTheory.Sieve.generate P_cov
  have hR_cov : R_cov ∈ J U := by
    rw [hMem_J U R_cov]
    intro x
    have hx_univ : x ∈ (Set.univ : Set ↥U.left) := Set.mem_univ x
    rw [← hCov] at hx_univ
    obtain ⟨i, y, hy⟩ := Set.mem_iUnion.mp hx_univ
    haveI : AlgebraicGeometry.IsOpenImmersion (α i).left := hOpen i
    exact ⟨U_part i, α i, y,
      CategoryTheory.Sieve.le_generate P_cov (U_part i) (α i) (CategoryTheory.Presieve.ofArrows.mk i),
      inferInstance, hy⟩
  have hInj_α : ∀ (i : Fin n) {Z : S.Etale} {g₁ g₂ : Z ⟶ U_part i},
      g₁ ≫ α i = g₂ ≫ α i → g₁ = g₂ := by
    intro i Z g₁ g₂ hcomm
    haveI : AlgebraicGeometry.IsOpenImmersion (α i).left := hOpen i
    have hleft : g₁.left ≫ (α i).left = g₂.left ≫ (α i).left :=
      congrArg (fun k : Z ⟶ U => k.left) hcomm
    exact CategoryTheory.MorphismProperty.Over.Hom.ext ((cancel_mono (α i).left).mp hleft)
  have hEmpty_ne : ∀ {j₁ j₂ : Fin n}, j₁ ≠ j₂ →
      ∀ {Z : S.Etale} (g₁ : Z ⟶ U_part j₁) (g₂ : Z ⟶ U_part j₂),
        g₁ ≫ α j₁ = g₂ ≫ α j₂ → IsEmpty ↥Z.left := by
    intro j₁ j₂ hj Z g₁ g₂ hcomm
    refine ⟨fun z => ?_⟩
    have hmem₁ : (α j₁).left.base (g₁.left.base z) ∈ Set.range (α j₁).left.base :=
      ⟨g₁.left.base z, rfl⟩
    have hpt : (g₁ ≫ α j₁).left.base z = (g₂ ≫ α j₂).left.base z :=
      congrArg (fun k : Z ⟶ U => k.left.base z) hcomm
    have hmem₂ : (α j₁).left.base (g₁.left.base z) ∈ Set.range (α j₂).left.base := by
      have heq : (α j₁).left.base (g₁.left.base z) = (α j₂).left.base (g₂.left.base z) := hpt
      rw [heq]
      exact ⟨g₂.left.base z, rfl⟩
    exact Set.disjoint_left.mp (hDisj hj) hmem₁ hmem₂
  let LT := weilEtaleLocalTorsionSheaf S m U
  let LT_i : Fin n → CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    fun i => weilEtaleLocalTorsionSheaf S m (U_part i)
  let gen_i : ∀ i : Fin n, AM ⟶ (LT_i i).obj.obj (Opposite.op (U_part i)) :=
    fun i => CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (LT_i i))
  let x_fam : ∀ (i j : Fin n), AM ⟶ (LT_i i).obj.obj (Opposite.op (U_part j)) :=
    fun i j =>
      if h : j = i then
        gen_i i ≫ (LT_i i).obj.map
          (CategoryTheory.eqToHom (congrArg (fun k => Opposite.op (U_part k)) h.symm))
      else
        0
  have hx_compat : ∀ i : Fin n,
      CategoryTheory.Presieve.Arrows.Compatible (P_hom (LT_i i)) α (x_fam i) := by
    intro i j₁ j₂ Z g₁ g₂ hcomm
    by_cases hj : j₁ = j₂
    · subst hj
      have hg : g₁ = g₂ := hInj_α j₁ hcomm
      subst hg
      rfl
    · have hEmp : IsEmpty ↥Z.left := hEmpty_ne hj g₁ g₂ hcomm
      exact (hSub_empty Z hEmp (LT_i i)).elim _ _
  have hAmalg : ∀ i : Fin n,
      ∃ t : AM ⟶ (LT_i i).obj.obj (Opposite.op U),
        ∀ j : Fin n, t ≫ (LT_i i).obj.map (Opposite.op (α j)) = x_fam i j := by
    intro i
    have hShFor : CategoryTheory.Presieve.IsSheafFor (P_hom (LT_i i)) P_cov :=
      ((LT_i i).property AM).isSheafFor P_cov hR_cov
    obtain ⟨t, ht, -⟩ :=
      (CategoryTheory.Presieve.isSheafFor_arrows_iff (P_hom (LT_i i)) α).mp hShFor
        (x_fam i) (hx_compat i)
    exact ⟨t, ht⟩
  let π_hat : ∀ i : Fin n, AM ⟶ (LT_i i).obj.obj (Opposite.op U) :=
    fun i => Classical.choose (hAmalg i)
  have hπ_hat : ∀ (i j : Fin n),
      π_hat i ≫ (LT_i i).obj.map (Opposite.op (α j)) = x_fam i j :=
    fun i => Classical.choose_spec (hAmalg i)
  let π : ∀ i : Fin n, Quiver.Hom LT (LT_i i) :=
    fun i => CategoryTheory.Sheaf.freeYonedaHomEquiv.symm (π_hat i)
  let M_α : ∀ i : Fin n, LT_i i ⟶ LT :=
    fun i => weilEtaleLocalTorsionMap S m (α i)
  refine ⟨π, ?_⟩
  apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
  have hSep_LT : CategoryTheory.Presieve.IsSeparatedFor (P_hom LT) P_cov :=
    ((LT.property AM).isSheafFor P_cov hR_cov).isSeparatedFor
  apply hSep_LT.ext
  intro W f hf
  rcases hf with ⟨j⟩
  change CategoryTheory.Sheaf.freeYonedaHomEquiv (∑ i : Fin n, (π i ≫ M_α i)) ≫
      LT.obj.map (Opposite.op (α j)) =
    CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 LT) ≫ LT.obj.map (Opposite.op (α j))
  let EV_U : CategoryTheory.Sheaf J AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
    CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (Opposite S.Etale) AddCommGrpCat.{u}).obj (Opposite.op U)
  have hSum_equiv :
      CategoryTheory.Sheaf.freeYonedaHomEquiv (∑ i : Fin n, (π i ≫ M_α i)) =
        ∑ i : Fin n, CategoryTheory.Sheaf.freeYonedaHomEquiv (π i ≫ M_α i) := by
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv (∑ i : Fin n, (π i ≫ M_α i))
        = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 LT ≫ ∑ i : Fin n, (π i ≫ M_α i)) := by
            rw [CategoryTheory.Category.id_comp]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 LT) ≫
            EV_U.map (∑ i : Fin n, (π i ≫ M_α i)) :=
            hEquiv_comp (𝟙 LT) (∑ i : Fin n, (π i ≫ M_α i))
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 LT) ≫
            ∑ i : Fin n, EV_U.map (π i ≫ M_α i) := by
            rw [CategoryTheory.Functor.map_sum]
      _ = ∑ i : Fin n,
            (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 LT) ≫
              EV_U.map (π i ≫ M_α i)) := by
            rw [CategoryTheory.Preadditive.comp_sum]
      _ = ∑ i : Fin n, CategoryTheory.Sheaf.freeYonedaHomEquiv (π i ≫ M_α i) := by
            apply Finset.sum_congr rfl
            intro i _
            exact (hEquiv_comp (𝟙 LT) (π i ≫ M_α i)).symm.trans
              (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.Category.id_comp _))
  rw [hSum_equiv, CategoryTheory.Preadditive.sum_comp]
  have hTerm : ∀ i : Fin n,
      CategoryTheory.Sheaf.freeYonedaHomEquiv (π i ≫ M_α i) ≫
        LT.obj.map (Opposite.op (α j)) =
      x_fam i j ≫ (M_α i).hom.app (Opposite.op (U_part j)) := by
    intro i
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv (π i ≫ M_α i) ≫
          LT.obj.map (Opposite.op (α j))
        = (CategoryTheory.Sheaf.freeYonedaHomEquiv (π i) ≫
            (M_α i).hom.app (Opposite.op U)) ≫
            LT.obj.map (Opposite.op (α j)) := by
            rw [hEquiv_comp (π i) (M_α i)]
      _ = (π_hat i ≫ (M_α i).hom.app (Opposite.op U)) ≫
            LT.obj.map (Opposite.op (α j)) := by
            dsimp [π]
            rw [Equiv.apply_symm_apply]
      _ = π_hat i ≫ ((M_α i).hom.app (Opposite.op U) ≫
            LT.obj.map (Opposite.op (α j))) := by
            rw [CategoryTheory.Category.assoc]
      _ = π_hat i ≫ ((LT_i i).obj.map (Opposite.op (α j)) ≫
            (M_α i).hom.app (Opposite.op (U_part j))) := by
            rw [← (M_α i).hom.naturality (Opposite.op (α j))]
      _ = (π_hat i ≫ (LT_i i).obj.map (Opposite.op (α j))) ≫
            (M_α i).hom.app (Opposite.op (U_part j)) := by
            rw [CategoryTheory.Category.assoc]
      _ = x_fam i j ≫ (M_α i).hom.app (Opposite.op (U_part j)) := by
            rw [hπ_hat i j]
  have hSum_terms :
      (∑ i : Fin n,
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (π i ≫ M_α i) ≫
          LT.obj.map (Opposite.op (α j)))) =
      ∑ i : Fin n, (x_fam i j ≫ (M_α i).hom.app (Opposite.op (U_part j))) :=
    Finset.sum_congr rfl (fun i _ => hTerm i)
  rw [hSum_terms, Finset.sum_eq_single j]
  · have hx_jj : x_fam j j = gen_i j := by
      dsimp [x_fam]
      rw [if_pos rfl, CategoryTheory.Functor.map_id, CategoryTheory.Category.comp_id]
    calc
      x_fam j j ≫ (M_α j).hom.app (Opposite.op (U_part j))
        = gen_i j ≫ (M_α j).hom.app (Opposite.op (U_part j)) := by
            rw [hx_jj]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (LT_i j) ≫ M_α j) :=
            (hEquiv_comp (𝟙 (LT_i j)) (M_α j)).symm
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (M_α j) := by
            rw [CategoryTheory.Category.id_comp]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 LT) ≫
            LT.obj.map (Opposite.op (α j)) :=
            Equiv.apply_symm_apply _ _
  · intro i _ hij
    have hji : j ≠ i := hij.symm
    have hx_ij : x_fam i j = 0 := by
      dsimp [x_fam]
      exact dif_neg hji
    rw [hx_ij, CategoryTheory.Limits.zero_comp]
  · intro hj_not
    exact (hj_not (Finset.mem_univ j)).elim

theorem weil_etale_clopen_immersion_localTorsionH_iso (C Y : AlgebraicGeometry.Scheme.{u})
    (κ : Quiver.Hom C Y)
    [AlgebraicGeometry.IsOpenImmersion κ]
    [AlgebraicGeometry.IsClosedImmersion κ]
    (m : ℕ) :
    (∀ (U : C.Etale)
        (hEt : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp U.hom κ))
        (q : ℕ),
      Nonempty
        (weilEtaleLocalTorsionH Y m
          (CategoryTheory.MorphismProperty.Over.mk ⊤
            (CategoryTheory.CategoryStruct.comp U.hom κ) hEt) q ≃+
         weilEtaleLocalTorsionH C m U q)) ∧
    (∀ {U₂ U₁ : C.Etale} (u : Quiver.Hom U₂ U₁)
        (hEt₂ : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp U₂.hom κ))
        (hEt₁ : AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.comp U₁.hom κ)),
      let U₂_Y : Y.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp U₂.hom κ) hEt₂
      let U₁_Y : Y.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤
          (CategoryTheory.CategoryStruct.comp U₁.hom κ) hEt₁
      ∀ (u_Y : U₂_Y ⟶ U₁_Y),
        u_Y.left = u.left →
        ∀ (q : ℕ),
          weilEtaleLocalTorsionMapH C m u q = 0 →
          weilEtaleLocalTorsionMapH Y m u_Y q = 0) :=
by
  classical
  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have : P_et.HasPullbacksAlong κ :=
    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : P_et.IsStableUnderBaseChangeAlong κ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : (⊤ : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}).HasOfPostcompProperty ⊤ :=
    ⟨fun _ _ _ _ => trivial⟩
  have hκ : P_et κ := inferInstance
  have hMono_κ : CategoryTheory.Mono κ := AlgebraicGeometry.IsOpenImmersion.mono κ

  let K_κ : CategoryTheory.Functor C.Etale Y.Etale :=
    CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hκ
  let B_κ : CategoryTheory.Functor Y.Etale C.Etale :=
    CategoryTheory.MorphismProperty.Over.pullback P_et ⊤ κ
  let J_C := C.smallEtaleTopology
  let J_Y := Y.smallEtaleTopology

  have : K_κ.Faithful :=
    { map_injective := fun {U₁ U₂} {u₁ u₂} h =>
        CategoryTheory.MorphismProperty.Over.Hom.ext
          (congrArg (fun g : K_κ.obj U₁ ⟶ K_κ.obj U₂ => g.left) h) }
  have : K_κ.Full :=
    { map_surjective := fun {U₁ U₂} g => by
        have hgw : (g.left ≫ U₂.hom) ≫ κ = U₁.hom ≫ κ :=
          (CategoryTheory.Category.assoc g.left U₂.hom κ).trans
            (CategoryTheory.MorphismProperty.Over.w g)
        exact ⟨CategoryTheory.MorphismProperty.Over.homMk g.left ((cancel_mono κ).mp hgw) trivial,
          CategoryTheory.MorphismProperty.Over.Hom.ext rfl⟩ }

  have hDown : ∀ {U : C.Etale} {W : Y.Etale},
      (W ⟶ K_κ.obj U) → (U' : C.Etale) × (K_κ.obj U' ≅ W) := by
    intro U W f
    have hf : f.left ≫ (U.hom ≫ κ) = W.hom := CategoryTheory.MorphismProperty.Over.w f
    have hf_comp_et : P_et (f.left ≫ (U.hom ≫ κ)) := hf.symm ▸ W.prop
    have hf_et : P_et f.left :=
      CategoryTheory.MorphismProperty.of_postcomp P_et f.left (U.hom ≫ κ)
        (K_κ.obj U).prop hf_comp_et
    have hU'_et : P_et (f.left ≫ U.hom) :=
      CategoryTheory.MorphismProperty.comp_mem P_et f.left U.hom hf_et U.prop
    let U' : C.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (f.left ≫ U.hom) hU'_et
    have hhom : 𝟙 W.left ≫ W.hom = (K_κ.obj U').hom :=
      (CategoryTheory.Category.id_comp W.hom).trans
        (hf.symm.trans (CategoryTheory.Category.assoc f.left U.hom κ).symm)
    have hinv : 𝟙 W.left ≫ (K_κ.obj U').hom = W.hom :=
      (CategoryTheory.Category.id_comp ((K_κ.obj U').hom)).trans
        ((CategoryTheory.Category.assoc f.left U.hom κ).trans hf)
    exact ⟨U',
      { hom := CategoryTheory.MorphismProperty.Over.homMk (𝟙 W.left) hhom trivial
        inv := CategoryTheory.MorphismProperty.Over.homMk (𝟙 W.left) hinv trivial
        hom_inv_id := CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Category.id_comp _)
        inv_hom_id := CategoryTheory.MorphismProperty.Over.Hom.ext
          (CategoryTheory.Category.id_comp _) }⟩

  have hMemEtale :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} (X : S.Etale) (R : CategoryTheory.Sieve X),
        R ∈ S.smallEtaleTopology X ↔
          ∀ (x : ↥X.left), ∃ (Y_et : S.Etale) (f : Y_et ⟶ X) (y : ↥Y_et.left),
            R.arrows f ∧ P_et f.left ∧ f.left.base y = x := by
    intro S X R
    have hEq : S.smallEtaleTopology =
        (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S le_rfl
    exact (Iff.of_eq (congrArg (fun J : CategoryTheory.GrothendieckTopology S.Etale => R ∈ J X) hEq)).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) X R)

  have hCov_K : CategoryTheory.CoverPreserving J_C J_Y K_κ := by
    refine CategoryTheory.CoverPreserving.mk ?_
    intro U S hS
    refine (hMemEtale (K_κ.obj U) (CategoryTheory.Sieve.functorPushforward K_κ S)).mpr ?_
    intro x
    obtain ⟨V, g, y, hg_mem, hg_et, hy⟩ := (hMemEtale U S).mp hS x
    exact ⟨K_κ.obj V, K_κ.map g, y,
      CategoryTheory.Sieve.image_mem_functorPushforward K_κ S hg_mem, hg_et, hy⟩

  have : K_κ.IsContinuous J_C J_Y :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.compatiblePreservingOfDownwardsClosed J_Y K_κ hDown) hCov_K

  let adj_site : K_κ ⊣ B_κ :=
    CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ κ hκ trivial
  have : B_κ.IsRightAdjoint := adj_site.isRightAdjoint

  have hCov_B : CategoryTheory.CoverPreserving J_Y J_C B_κ := by
    refine CategoryTheory.CoverPreserving.mk ?_
    intro W S hS
    refine (hMemEtale (B_κ.obj W) (CategoryTheory.Sieve.functorPushforward B_κ S)).mpr ?_
    intro x
    let fst_W := CategoryTheory.Limits.pullback.fst W.hom κ
    let snd_W := CategoryTheory.Limits.pullback.snd W.hom κ
    let w : ↥W.left := fst_W.base x
    let c : ↥C := snd_W.base x
    obtain ⟨V, g, v, hg_mem, _, hv⟩ := (hMemEtale W S).mp hS w
    have hvc : V.hom.base v = κ.base c := by
      have hgw : (g.left ≫ W.hom).base v = V.hom.base v :=
        congrArg (fun m => m.base v) (CategoryTheory.MorphismProperty.Over.w g)
      have hcond : (fst_W ≫ W.hom).base x = (snd_W ≫ κ).base x :=
        congrArg (fun m => m.base x)
          (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := κ))
      exact hgw.symm.trans ((congrArg W.hom.base hv).trans hcond)
    obtain ⟨y, hy_fst, -⟩ :=
      AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback (f := V.hom) (g := κ) v c hvc
    have hBg_et : P_et (B_κ.map g).left := by
      have hbw : (B_κ.map g).left ≫ (B_κ.obj W).hom = (B_κ.obj V).hom :=
        CategoryTheory.MorphismProperty.Over.w (B_κ.map g)
      exact CategoryTheory.MorphismProperty.of_postcomp P_et (B_κ.map g).left (B_κ.obj W).hom
        (B_κ.obj W).prop (hbw.symm ▸ (B_κ.obj V).prop)
    have hy_map : (B_κ.map g).left.base y = x := by
      apply fst_W.isOpenEmbedding.injective
      have hl_hom : (B_κ.map g).left ≫ fst_W =
          CategoryTheory.Limits.pullback.fst V.hom κ ≫ g.left :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hl : ((B_κ.map g).left ≫ fst_W).base y =
          (CategoryTheory.Limits.pullback.fst V.hom κ ≫ g.left).base y :=
        congrArg (fun m : (B_κ.obj V).left ⟶ W.left => m.base y) hl_hom
      exact hl.trans ((congrArg g.left.base hy_fst).trans hv)
    exact ⟨B_κ.obj V, B_κ.map g, y,
      CategoryTheory.Sieve.image_mem_functorPushforward B_κ S hg_mem, hBg_et, hy_map⟩

  have : B_κ.IsContinuous J_Y J_C :=
    CategoryTheory.Functor.isContinuous_of_coverPreserving
      (CategoryTheory.compatiblePreservingOfFlat J_C B_κ) hCov_B

  let res_κ : CategoryTheory.Functor
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_C AddCommGrpCat.{u}) :=
    K_κ.sheafPushforwardContinuous AddCommGrpCat.{u} J_C J_Y
  let pf_κ : CategoryTheory.Functor
      (CategoryTheory.Sheaf J_C AddCommGrpCat.{u})
      (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) :=
    B_κ.sheafPushforwardContinuous AddCommGrpCat.{u} J_Y J_C

  let adj_R : res_κ ⊣ pf_κ :=
    adj_site.sheafPushforwardContinuous J_C J_Y

  
  have hEmptyHomEq :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} (Z : S.Etale) [IsEmpty ↥Z.left]
        (H : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u})
        {M : AddCommGrpCat.{u}} (f₁ f₂ : M ⟶ H.obj.obj (Opposite.op Z)),
        f₁ = f₂ := by
    intro S Z hEmp H M f₁ f₂
    have hBot : (⊥ : CategoryTheory.Sieve Z) ∈ S.smallEtaleTopology Z :=
      (hMemEtale Z ⊥).mpr (fun z => IsEmpty.elim hEmp z)
    let N := H.obj.obj (Opposite.op Z)
    let P_N := H.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op N)
    have hShBot : CategoryTheory.Presieve.IsSheafFor P_N (⊥ : CategoryTheory.Sieve Z).arrows :=
      (H.property N).isSheafFor (⊥ : CategoryTheory.Sieve Z).arrows (by simpa using hBot)
    have hid0 : (𝟙 N : P_N.obj (Opposite.op Z)) = (0 : N ⟶ N) := by
      apply hShBot.isSeparatedFor.ext
      intro W g hg
      exact False.elim hg
    calc
      f₁ = f₁ ≫ 𝟙 N := (CategoryTheory.Category.comp_id f₁).symm
      _ = f₁ ≫ (0 : N ⟶ N) := by rw [hid0]
      _ = 0 := CategoryTheory.Limits.comp_zero
      _ = f₂ ≫ (0 : N ⟶ N) := CategoryTheory.Limits.comp_zero.symm
      _ = f₂ ≫ 𝟙 N := by rw [← hid0]
      _ = f₂ := CategoryTheory.Category.comp_id f₂

  let R_open : Y.Opens := ⟨(Set.range κ.base)ᶜ, κ.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let ι_R : R_open.toScheme ⟶ Y := R_open.ι
  have hιR_compl : ∀ r : ↥R_open.toScheme, ι_R.base r ∈ (Set.range κ.base)ᶜ := by
    intro r
    have hmem : ι_R.base r ∈ Set.range ι_R.base := ⟨r, rfl⟩
    rwa [AlgebraicGeometry.Scheme.Opens.range_ι] at hmem

  let W_C : Y.Etale → Y.Etale := fun W => K_κ.obj (B_κ.obj W)
  let i_C : ∀ W : Y.Etale, W_C W ⟶ W := fun W =>
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.fst W.hom κ)
      CategoryTheory.Limits.pullback.condition trivial

  let fst_WR : ∀ W : Y.Etale, CategoryTheory.Limits.pullback W.hom ι_R ⟶ W.left :=
    fun W => CategoryTheory.Limits.pullback.fst W.hom ι_R
  let W_R : Y.Etale → Y.Etale := fun W =>
    CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_WR W ≫ W.hom)
      (by
        have : AlgebraicGeometry.Etale W.hom := W.prop
        infer_instance)
  let i_R : ∀ W : Y.Etale, W_R W ⟶ W := fun W =>
    CategoryTheory.MorphismProperty.Over.homMk (fst_WR W) rfl trivial

  have hMono_iC : ∀ W : Y.Etale, CategoryTheory.Mono (i_C W) := by
    intro W
    refine ⟨fun {Z} g₁ g₂ h => CategoryTheory.MorphismProperty.Over.Hom.ext ?_⟩
    have h_left : g₁.left ≫ CategoryTheory.Limits.pullback.fst W.hom κ =
        g₂.left ≫ CategoryTheory.Limits.pullback.fst W.hom κ :=
      congrArg (fun m : Z ⟶ W => m.left) h
    exact (cancel_mono (CategoryTheory.Limits.pullback.fst W.hom κ)).mp h_left

  let c_W : Y.Etale → Bool → Y.Etale := fun W b => Bool.rec (W_R W) (W_C W) b
  let ι_W : ∀ (W : Y.Etale) (b : Bool), c_W W b ⟶ W := fun W => Bool.rec (i_R W) (i_C W)

  have hDisj_CR : ∀ {W Z : Y.Etale} (g_C : Z ⟶ W_C W) (g_R : Z ⟶ W_R W),
      g_C ≫ i_C W = g_R ≫ i_R W → IsEmpty ↥Z.left := by
    intro W Z g_C g_R hEq
    refine ⟨fun z => ?_⟩
    let zC : ↥(CategoryTheory.Limits.pullback W.hom κ) := g_C.left.base z
    let zR : ↥(CategoryTheory.Limits.pullback W.hom ι_R) := g_R.left.base z
    have hw : (CategoryTheory.Limits.pullback.fst W.hom κ).base zC =
        (CategoryTheory.Limits.pullback.fst W.hom ι_R).base zR :=
      congrArg (fun m : Z ⟶ W => m.left.base z) hEq
    have hcondC : W.hom.base ((CategoryTheory.Limits.pullback.fst W.hom κ).base zC) =
        κ.base ((CategoryTheory.Limits.pullback.snd W.hom κ).base zC) :=
      congrArg (fun m => m.base zC)
        (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := κ))
    have hcondR : W.hom.base ((CategoryTheory.Limits.pullback.fst W.hom ι_R).base zR) =
        ι_R.base ((CategoryTheory.Limits.pullback.snd W.hom ι_R).base zR) :=
      congrArg (fun m => m.base zR)
        (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := ι_R))
    have h_in_C : W.hom.base ((CategoryTheory.Limits.pullback.fst W.hom ι_R).base zR) ∈
        Set.range κ.base :=
      ⟨(CategoryTheory.Limits.pullback.snd W.hom κ).base zC,
        hcondC.symm.trans (congrArg W.hom.base hw)⟩
    have h_in_R : W.hom.base ((CategoryTheory.Limits.pullback.fst W.hom ι_R).base zR) ∈
        (Set.range κ.base)ᶜ :=
      hcondR.symm ▸ hιR_compl ((CategoryTheory.Limits.pullback.snd W.hom ι_R).base zR)
    exact h_in_R h_in_C

  have hCov_W : ∀ W : Y.Etale,
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows (c_W W) (ι_W W)) ∈ J_Y W := by
    intro W
    refine (hMemEtale W
      (CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows (c_W W) (ι_W W)))).mpr ?_
    intro w
    by_cases hw : W.hom.base w ∈ Set.range κ.base
    · obtain ⟨c, hc⟩ := hw
      obtain ⟨z, hz, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := W.hom) (g := κ) w c hc.symm
      refine ⟨c_W W true, ι_W W true, z, ?_, ?_, hz⟩
      · exact CategoryTheory.Sieve.le_generate _ _ _ (CategoryTheory.Presieve.ofArrows.mk true)
      · change AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst W.hom κ)
        infer_instance
    · have hr_mem : W.hom.base w ∈ Set.range ι_R.base := by
        rw [AlgebraicGeometry.Scheme.Opens.range_ι]
        exact hw
      obtain ⟨r, hr⟩ := hr_mem
      obtain ⟨z, hz, -⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
          (f := W.hom) (g := ι_R) w r hr.symm
      refine ⟨c_W W false, ι_W W false, z, ?_, ?_, hz⟩
      · exact CategoryTheory.Sieve.le_generate _ _ _ (CategoryTheory.Presieve.ofArrows.mk false)
      · change AlgebraicGeometry.Etale (CategoryTheory.Limits.pullback.fst W.hom ι_R)
        infer_instance

  have hIsSheafFor_W : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      (M : AddCommGrpCat.{u}) (W : Y.Etale),
      CategoryTheory.Presieve.IsSheafFor
        (G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op M))
        (CategoryTheory.Presieve.ofArrows (c_W W) (ι_W W)) := by
    intro G M W
    exact (G.property M).isSheafFor _ (hCov_W W)

  have hSep_W : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u})
      {M : AddCommGrpCat.{u}} (W : Y.Etale)
      (f₁ f₂ : M ⟶ G.obj.obj (Opposite.op W)),
      f₁ ≫ G.obj.map (Opposite.op (i_C W)) = f₂ ≫ G.obj.map (Opposite.op (i_C W)) →
      f₁ ≫ G.obj.map (Opposite.op (i_R W)) = f₂ ≫ G.obj.map (Opposite.op (i_R W)) →
      f₁ = f₂ := by
    intro G M W f₁ f₂ hC hR
    apply (hIsSheafFor_W G M W).isSeparatedFor.ext
    intro Z g hg
    rcases hg with ⟨b⟩
    cases b
    · exact hR
    · exact hC

  
  let π_U : ∀ U : C.Etale, B_κ.obj (K_κ.obj U) ⟶ U := fun U =>
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.fst (U.hom ≫ κ) κ)
      ((cancel_mono κ).mp
        ((CategoryTheory.Category.assoc
          (CategoryTheory.Limits.pullback.fst (U.hom ≫ κ) κ) U.hom κ).trans
          CategoryTheory.Limits.pullback.condition))
      trivial

  have hπ_nat : ∀ {U₁ U₂ : C.Etale} (u : U₁ ⟶ U₂),
      B_κ.map (K_κ.map u) ≫ π_U U₂ = π_U U₁ ≫ u := by
    intro U₁ U₂ u
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  let η_L : 𝟭 (CategoryTheory.Sheaf J_C AddCommGrpCat.{u}) ⟶ pf_κ ⋙ res_κ :=
    { app := fun F =>
        CategoryTheory.ObjectProperty.homMk
          { app := fun U => F.obj.map (Opposite.op (π_U (Opposite.unop U)))
            naturality := fun {U₁ U₂} f => by
              change F.obj.map f ≫ F.obj.map (Opposite.op (π_U (Opposite.unop U₂))) =
                F.obj.map (Opposite.op (π_U (Opposite.unop U₁))) ≫
                  F.obj.map (Opposite.op (B_κ.map (K_κ.map f.unop)))
              rw [← F.obj.map_comp, ← F.obj.map_comp]
              exact congrArg F.obj.map (congrArg Opposite.op (hπ_nat f.unop).symm) }
      naturality := fun {F₁ F₂} φ => by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext U
        exact (φ.hom.naturality (Opposite.op (π_U (Opposite.unop U)))).symm }

  have hExtZeroEx : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (W : Y.Etale),
      ∃ t : G.obj.obj (Opposite.op (W_C W)) ⟶ G.obj.obj (Opposite.op W),
        t ≫ G.obj.map (Opposite.op (i_C W)) = 𝟙 (G.obj.obj (Opposite.op (W_C W))) ∧
        t ≫ G.obj.map (Opposite.op (i_R W)) = 0 := by
    intro G W
    let M := G.obj.obj (Opposite.op (W_C W))
    let P_M := G.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op M)
    let x : ∀ b : Bool, P_M.obj (Opposite.op (c_W W b)) :=
      Bool.rec (0 : M ⟶ G.obj.obj (Opposite.op (W_R W))) (𝟙 M)
    have hCompat : CategoryTheory.Presieve.Arrows.Compatible P_M (ι_W W) x := by
      intro b₁ b₂ Z g₁ g₂ hg
      cases b₁ <;> cases b₂
      · change (0 : M ⟶ G.obj.obj (Opposite.op (W_R W))) ≫ G.obj.map g₁.op =
          (0 : M ⟶ G.obj.obj (Opposite.op (W_R W))) ≫ G.obj.map g₂.op
        rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.zero_comp]
      · have : IsEmpty ↥Z.left := hDisj_CR g₂ g₁ hg.symm
        exact hEmptyHomEq Z G _ _
      · have : IsEmpty ↥Z.left := hDisj_CR g₁ g₂ hg
        exact hEmptyHomEq Z G _ _
      · have hg_eq : g₁ = g₂ := by
          have : CategoryTheory.Mono (i_C W) := hMono_iC W
          exact (cancel_mono (i_C W)).mp hg
        subst hg_eq
        rfl
    obtain ⟨t, ht, -⟩ :=
      (CategoryTheory.Presieve.isSheafFor_arrows_iff P_M (ι_W W)).mp (hIsSheafFor_W G M W) x hCompat
    exact ⟨t, ht true, ht false⟩

  let extZero : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (W : Y.Etale),
      G.obj.obj (Opposite.op (W_C W)) ⟶ G.obj.obj (Opposite.op W) :=
    fun G W => Classical.choose (hExtZeroEx G W)
  have hextZero_C : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (W : Y.Etale),
      extZero G W ≫ G.obj.map (Opposite.op (i_C W)) = 𝟙 _ :=
    fun G W => (Classical.choose_spec (hExtZeroEx G W)).1
  have hextZero_R : ∀ (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) (W : Y.Etale),
      extZero G W ≫ G.obj.map (Opposite.op (i_R W)) = 0 :=
    fun G W => (Classical.choose_spec (hExtZeroEx G W)).2

  have hiC_nat : ∀ {W₁ W₂ : Y.Etale} (w : W₁ ⟶ W₂),
      K_κ.map (B_κ.map w) ≫ i_C W₂ = i_C W₁ ≫ w := by
    intro W₁ W₂ w
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  let map_WR : ∀ {W₁ W₂ : Y.Etale}, (W₁ ⟶ W₂) → (W_R W₁ ⟶ W_R W₂) :=
    fun {W₁ W₂} w =>
      let hw_w : w.left ≫ W₂.hom = W₁.hom := CategoryTheory.MorphismProperty.Over.w w
      let l_WR : CategoryTheory.Limits.pullback W₁.hom ι_R ⟶
          CategoryTheory.Limits.pullback W₂.hom ι_R :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst W₁.hom ι_R ≫ w.left)
          (CategoryTheory.Limits.pullback.snd W₁.hom ι_R)
          ((CategoryTheory.Category.assoc _ w.left W₂.hom).trans
            ((congrArg (_ ≫ ·) hw_w).trans CategoryTheory.Limits.pullback.condition))
      CategoryTheory.MorphismProperty.Over.homMk l_WR
        ((CategoryTheory.Category.assoc l_WR (fst_WR W₂) W₂.hom).symm.trans
          ((congrArg (· ≫ W₂.hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            ((CategoryTheory.Category.assoc (fst_WR W₁) w.left W₂.hom).trans
              (congrArg (fst_WR W₁ ≫ ·) hw_w))))
        trivial

  have hiR_nat : ∀ {W₁ W₂ : Y.Etale} (w : W₁ ⟶ W₂),
      map_WR w ≫ i_R W₂ = i_R W₁ ≫ w := by
    intro W₁ W₂ w
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    exact CategoryTheory.Limits.pullback.lift_fst _ _ _

  let ε_L : res_κ ⋙ pf_κ ⟶ 𝟭 (CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}) :=
    { app := fun G =>
        CategoryTheory.ObjectProperty.homMk
          { app := fun W => extZero G (Opposite.unop W)
            naturality := fun {W₁ W₂} f => by
              let w : Opposite.unop W₂ ⟶ Opposite.unop W₁ := f.unop
              change G.obj.map (Opposite.op (K_κ.map (B_κ.map w))) ≫ extZero G (Opposite.unop W₂) =
                extZero G (Opposite.unop W₁) ≫ G.obj.map (Opposite.op w)
              apply hSep_W G (Opposite.unop W₂)
              · have hmap_iC :
                    G.obj.map (Opposite.op w) ≫ G.obj.map (Opposite.op (i_C (Opposite.unop W₂))) =
                      G.obj.map (Opposite.op (i_C (Opposite.unop W₁))) ≫
                        G.obj.map (Opposite.op (K_κ.map (B_κ.map w))) := by
                  rw [← G.obj.map_comp, ← G.obj.map_comp]
                  exact congrArg (fun m => G.obj.map (Opposite.op m)) (hiC_nat w).symm
                rw [CategoryTheory.Category.assoc, hextZero_C, CategoryTheory.Category.comp_id,
                  CategoryTheory.Category.assoc, hmap_iC, ← CategoryTheory.Category.assoc,
                  hextZero_C, CategoryTheory.Category.id_comp]
              · have hmap_iR :
                    G.obj.map (Opposite.op w) ≫ G.obj.map (Opposite.op (i_R (Opposite.unop W₂))) =
                      G.obj.map (Opposite.op (i_R (Opposite.unop W₁))) ≫
                        G.obj.map (Opposite.op (map_WR w)) := by
                  rw [← G.obj.map_comp, ← G.obj.map_comp]
                  exact congrArg (fun m => G.obj.map (Opposite.op m)) (hiR_nat w).symm
                rw [CategoryTheory.Category.assoc, hextZero_R, CategoryTheory.Limits.comp_zero,
                  CategoryTheory.Category.assoc, hmap_iR, ← CategoryTheory.Category.assoc,
                  hextZero_R, CategoryTheory.Limits.zero_comp] }
      naturality := fun {G₁ G₂} φ => by
        apply CategoryTheory.Sheaf.hom_ext
        apply CategoryTheory.NatTrans.ext
        funext W
        let W₀ := Opposite.unop W
        change φ.hom.app (Opposite.op (W_C W₀)) ≫ extZero G₂ W₀ =
          extZero G₁ W₀ ≫ φ.hom.app (Opposite.op W₀)
        apply hSep_W G₂ W₀
        · rw [CategoryTheory.Category.assoc, hextZero_C, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.assoc, ← φ.hom.naturality (Opposite.op (i_C W₀)),
            ← CategoryTheory.Category.assoc, hextZero_C, CategoryTheory.Category.id_comp]
        · rw [CategoryTheory.Category.assoc, hextZero_R, CategoryTheory.Limits.comp_zero,
            CategoryTheory.Category.assoc, ← φ.hom.naturality (Opposite.op (i_R W₀)),
            ← CategoryTheory.Category.assoc, hextZero_R, CategoryTheory.Limits.zero_comp] }

  have hπ_eq_Bmap_iC : ∀ W : Y.Etale, π_U (B_κ.obj W) = B_κ.map (i_C W) := by
    intro W
    apply CategoryTheory.MorphismProperty.Over.Hom.ext
    apply CategoryTheory.Limits.pullback.hom_ext
    · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
    · have hw1 : (π_U (B_κ.obj W)).left ≫ CategoryTheory.Limits.pullback.snd W.hom κ =
          (B_κ.obj (W_C W)).hom :=
        CategoryTheory.MorphismProperty.Over.w (π_U (B_κ.obj W))
      have hw2 : (B_κ.map (i_C W)).left ≫ CategoryTheory.Limits.pullback.snd W.hom κ =
          (B_κ.obj (W_C W)).hom :=
        CategoryTheory.MorphismProperty.Over.w (B_κ.map (i_C W))
      exact hw1.trans hw2.symm

  have hEmpty_BWR : ∀ W : Y.Etale, IsEmpty ↥(B_κ.obj (W_R W)).left := by
    intro W
    refine ⟨fun z => ?_⟩
    let p₁ : ↥(W_R W).left :=
      (CategoryTheory.Limits.pullback.fst (W_R W).hom κ).base z
    let p₂ : ↥C :=
      (CategoryTheory.Limits.pullback.snd (W_R W).hom κ).base z
    have h_in_C : (W_R W).hom.base p₁ ∈ Set.range κ.base := by
      have hcond : ((CategoryTheory.Limits.pullback.fst (W_R W).hom κ) ≫ (W_R W).hom).base z =
          ((CategoryTheory.Limits.pullback.snd (W_R W).hom κ) ≫ κ).base z :=
        congrArg (fun m => m.base z)
          (CategoryTheory.Limits.pullback.condition (f := (W_R W).hom) (g := κ))
      exact ⟨p₂, hcond.symm⟩
    have hcondR : (W_R W).hom.base p₁ =
        ι_R.base ((CategoryTheory.Limits.pullback.snd W.hom ι_R).base p₁) :=
      congrArg (fun m => m.base p₁)
        (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := ι_R))
    have h_in_R : (W_R W).hom.base p₁ ∈ (Set.range κ.base)ᶜ :=
      hcondR.symm ▸ hιR_compl ((CategoryTheory.Limits.pullback.snd W.hom ι_R).base p₁)
    exact h_in_R h_in_C

  have hEmpty_WRK : ∀ U : C.Etale, IsEmpty ↥(W_R (K_κ.obj U)).left := by
    intro U
    refine ⟨fun z => ?_⟩
    let u₀ : ↥U.left :=
      (CategoryTheory.Limits.pullback.fst (U.hom ≫ κ) ι_R).base z
    let r₀ : ↥R_open.toScheme :=
      (CategoryTheory.Limits.pullback.snd (U.hom ≫ κ) ι_R).base z
    have hcond : (U.hom ≫ κ).base u₀ = ι_R.base r₀ :=
      congrArg (fun m => m.base z)
        (CategoryTheory.Limits.pullback.condition (f := U.hom ≫ κ) (g := ι_R))
    have h_in_C : ι_R.base r₀ ∈ Set.range κ.base := ⟨U.hom.base u₀, hcond⟩
    have h_in_R : ι_R.base r₀ ∈ (Set.range κ.base)ᶜ := hιR_compl r₀
    exact h_in_R h_in_C

  let adj_L : pf_κ ⊣ res_κ :=
    CategoryTheory.Adjunction.mkOfUnitCounit
      { unit := η_L
        counit := ε_L
        left_triangle := by
          apply CategoryTheory.NatTrans.ext
          funext F
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext W
          let W₀ := Opposite.unop W
          let η_W : (pf_κ.obj F).obj.obj (Opposite.op W₀) ⟶
              (pf_κ.obj F).obj.obj (Opposite.op (W_C W₀)) :=
            F.obj.map (Opposite.op (π_U (B_κ.obj W₀)))
          change η_W ≫ extZero (pf_κ.obj F) W₀ =
            𝟙 ((pf_κ.obj F).obj.obj (Opposite.op W₀))
          apply hSep_W (pf_κ.obj F) W₀
          · rw [CategoryTheory.Category.assoc, hextZero_C (pf_κ.obj F) W₀,
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
            exact congrArg (fun m => F.obj.map (Opposite.op m)) (hπ_eq_Bmap_iC W₀)
          · have : IsEmpty ↥(B_κ.obj (W_R W₀)).left := hEmpty_BWR W₀
            exact hEmptyHomEq (B_κ.obj (W_R W₀)) F _ _
        right_triangle := by
          apply CategoryTheory.NatTrans.ext
          funext G
          apply CategoryTheory.Sheaf.hom_ext
          apply CategoryTheory.NatTrans.ext
          funext U
          let U₀ := Opposite.unop U
          have hKπ : K_κ.map (π_U U₀) = i_C (K_κ.obj U₀) :=
            CategoryTheory.MorphismProperty.Over.Hom.ext rfl
          change G.obj.map (Opposite.op (K_κ.map (π_U U₀))) ≫ extZero G (K_κ.obj U₀) =
            𝟙 (G.obj.obj (Opposite.op (K_κ.obj U₀)))
          rw [hKπ]
          apply hSep_W G (K_κ.obj U₀)
          · rw [CategoryTheory.Category.assoc, hextZero_C G (K_κ.obj U₀),
              CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
          · have : IsEmpty ↥(W_R (K_κ.obj U₀)).left := hEmpty_WRK U₀
            exact hEmptyHomEq (W_R (K_κ.obj U₀)) G _ _ }

  
  have hEquiv_comp :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {W_et : S.Etale}
        {F G : CategoryTheory.Sheaf S.smallEtaleTopology AddCommGrpCat.{u}}
        (α : weilEtaleLocalTorsionSheaf S m W_et ⟶ F) (g : F ⟶ G),
        CategoryTheory.Sheaf.freeYonedaHomEquiv (α ≫ g) =
          CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) := by
    intro S W_et F G α g
    let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
    let α' : (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda W_et AM) ⟶ F := α
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
            AddCommGrpCat.{u}).homEquiv _ G) (α' ≫ g))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology
              AddCommGrpCat.{u}).homEquiv _ F) α' ≫
              (CategoryTheory.sheafToPresheaf S.smallEtaleTopology
                AddCommGrpCat.{u}).map g) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv α ≫ g.hom.app (Opposite.op W_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let L_C : C.Etale → CategoryTheory.Sheaf J_C AddCommGrpCat.{u} :=
    fun U => weilEtaleLocalTorsionSheaf C m U
  let L_Y : Y.Etale → CategoryTheory.Sheaf J_Y AddCommGrpCat.{u} :=
    fun V => weilEtaleLocalTorsionSheaf Y m V

  let equiv_C : ∀ (U : C.Etale) (F : CategoryTheory.Sheaf J_C AddCommGrpCat.{u}),
      (L_C U ⟶ F) ≃ (AM ⟶ F.obj.obj (Opposite.op U)) :=
    fun _ _ => CategoryTheory.Sheaf.freeYonedaHomEquiv
  let equiv_Y : ∀ (V : Y.Etale) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      (L_Y V ⟶ G) ≃ (AM ⟶ G.obj.obj (Opposite.op V)) :=
    fun _ _ => CategoryTheory.Sheaf.freeYonedaHomEquiv
  let bridge : ∀ (U : C.Etale) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      (AM ⟶ G.obj.obj (Opposite.op (K_κ.obj U))) ≃
        (AM ⟶ (res_κ.obj G).obj.obj (Opposite.op U)) :=
    fun _ _ =>
      { toFun := fun ξ => ξ
        invFun := fun ξ => ξ
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }

  let ψ_hom : ∀ (U : C.Etale) (G : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}),
      (L_Y (K_κ.obj U) ⟶ G) ≃ (pf_κ.obj (L_C U) ⟶ G) :=
    fun U G =>
      (((equiv_Y (K_κ.obj U) G).trans (bridge U G)).trans
        (equiv_C U (res_κ.obj G)).symm).trans
        (adj_L.homEquiv (L_C U) G).symm

  have hψ_comp : ∀ (U : C.Etale) {G₁ G₂ : CategoryTheory.Sheaf J_Y AddCommGrpCat.{u}}
      (α : L_Y (K_κ.obj U) ⟶ G₁) (g : G₁ ⟶ G₂),
      ψ_hom U G₂ (α ≫ g) = ψ_hom U G₁ α ≫ g := by
    intro U G₁ G₂ α g
    dsimp [ψ_hom]
    rw [← adj_L.homEquiv_naturality_right_symm]
    congr 1
    apply (equiv_C U (res_κ.obj G₂)).injective
    rw [Equiv.apply_symm_apply]
    have hcomp_C :
        equiv_C U (res_κ.obj G₂)
            ((equiv_C U (res_κ.obj G₁)).symm (bridge U G₁ (equiv_Y (K_κ.obj U) G₁ α)) ≫
              res_κ.map g) =
          equiv_C U (res_κ.obj G₁)
            ((equiv_C U (res_κ.obj G₁)).symm (bridge U G₁ (equiv_Y (K_κ.obj U) G₁ α))) ≫
            (res_κ.map g).hom.app (Opposite.op U) :=
      hEquiv_comp _ (res_κ.map g)
    rw [hcomp_C, Equiv.apply_symm_apply]
    exact congrArg (bridge U G₂) (hEquiv_comp α g)

  let e_loc : ∀ U : C.Etale, L_Y (K_κ.obj U) ≅ pf_κ.obj (L_C U) := fun U =>
    { hom := (ψ_hom U (pf_κ.obj (L_C U))).symm (𝟙 (pf_κ.obj (L_C U)))
      inv := ψ_hom U (L_Y (K_κ.obj U)) (𝟙 (L_Y (K_κ.obj U)))
      hom_inv_id := by
        apply (ψ_hom U (L_Y (K_κ.obj U))).injective
        rw [hψ_comp, Equiv.apply_symm_apply, CategoryTheory.Category.id_comp]
      inv_hom_id := by
        rw [← hψ_comp, CategoryTheory.Category.id_comp, Equiv.apply_symm_apply] }

  have he_loc_hom_equiv : ∀ U : C.Etale,
      bridge U (pf_κ.obj (L_C U))
          (equiv_Y (K_κ.obj U) (pf_κ.obj (L_C U)) (e_loc U).hom) =
        equiv_C U (res_κ.obj (pf_κ.obj (L_C U))) (adj_L.unit.app (L_C U)) := by
    intro U
    have h_unit : (adj_L.homEquiv (L_C U) (pf_κ.obj (L_C U))) (𝟙 (pf_κ.obj (L_C U))) =
        adj_L.unit.app (L_C U) := by
      rw [adj_L.homEquiv_unit, CategoryTheory.Functor.map_id]
      exact CategoryTheory.Category.comp_id (adj_L.unit.app (L_C U))
    change bridge U (pf_κ.obj (L_C U))
      (equiv_Y (K_κ.obj U) (pf_κ.obj (L_C U))
        ((equiv_Y (K_κ.obj U) (pf_κ.obj (L_C U))).symm
          ((bridge U (pf_κ.obj (L_C U))).symm
            (equiv_C U (res_κ.obj (pf_κ.obj (L_C U)))
              ((adj_L.homEquiv (L_C U) (pf_κ.obj (L_C U))) (𝟙 (pf_κ.obj (L_C U)))))))) = _
    rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, h_unit]

  have he_loc_nat : ∀ {U₂ U₁ : C.Etale} (u : U₂ ⟶ U₁),
      (e_loc U₂).hom ≫ pf_κ.map (weilEtaleLocalTorsionMap C m u) =
        weilEtaleLocalTorsionMap Y m (K_κ.map u) ≫ (e_loc U₁).hom := by
    intro U₂ U₁ u
    apply (equiv_Y (K_κ.obj U₂) (pf_κ.obj (L_C U₁))).injective
    apply (bridge U₂ (pf_κ.obj (L_C U₁))).injective
    have hLHS :
        bridge U₂ (pf_κ.obj (L_C U₁))
          (equiv_Y (K_κ.obj U₂) (pf_κ.obj (L_C U₁))
            ((e_loc U₂).hom ≫ pf_κ.map (weilEtaleLocalTorsionMap C m u))) =
        equiv_C U₁ (res_κ.obj (pf_κ.obj (L_C U₁))) (adj_L.unit.app (L_C U₁)) ≫
          (res_κ.obj (pf_κ.obj (L_C U₁))).obj.map (Opposite.op u) := by
      have h1 :
          bridge U₂ (pf_κ.obj (L_C U₁))
            (equiv_Y (K_κ.obj U₂) (pf_κ.obj (L_C U₁))
              ((e_loc U₂).hom ≫ pf_κ.map (weilEtaleLocalTorsionMap C m u))) =
          bridge U₂ (pf_κ.obj (L_C U₂))
            (equiv_Y (K_κ.obj U₂) (pf_κ.obj (L_C U₂)) (e_loc U₂).hom) ≫
            (res_κ.map (pf_κ.map (weilEtaleLocalTorsionMap C m u))).hom.app (Opposite.op U₂) :=
        congrArg (bridge U₂ (pf_κ.obj (L_C U₁)))
          (hEquiv_comp (e_loc U₂).hom (pf_κ.map (weilEtaleLocalTorsionMap C m u)))
      rw [h1, he_loc_hom_equiv U₂]
      have h2 :
          equiv_C U₂ (res_κ.obj (pf_κ.obj (L_C U₂))) (adj_L.unit.app (L_C U₂)) ≫
              (res_κ.map (pf_κ.map (weilEtaleLocalTorsionMap C m u))).hom.app (Opposite.op U₂) =
            equiv_C U₂ (res_κ.obj (pf_κ.obj (L_C U₁)))
              (adj_L.unit.app (L_C U₂) ≫
                (pf_κ ⋙ res_κ).map (weilEtaleLocalTorsionMap C m u)) :=
        (hEquiv_comp (adj_L.unit.app (L_C U₂))
          (res_κ.map (pf_κ.map (weilEtaleLocalTorsionMap C m u)))).symm
      have hnat_u : adj_L.unit.app (L_C U₂) ≫
          (pf_κ ⋙ res_κ).map (weilEtaleLocalTorsionMap C m u) =
          weilEtaleLocalTorsionMap C m u ≫ adj_L.unit.app (L_C U₁) :=
        (adj_L.unit.naturality (weilEtaleLocalTorsionMap C m u)).symm
      rw [h2, hnat_u]
      have h3 :
          equiv_C U₂ (res_κ.obj (pf_κ.obj (L_C U₁)))
              (weilEtaleLocalTorsionMap C m u ≫ adj_L.unit.app (L_C U₁)) =
            equiv_C U₂ (L_C U₁) (weilEtaleLocalTorsionMap C m u) ≫
              (adj_L.unit.app (L_C U₁)).hom.app (Opposite.op U₂) :=
        hEquiv_comp (weilEtaleLocalTorsionMap C m u) (adj_L.unit.app (L_C U₁))
      have hmap_C : equiv_C U₂ (L_C U₁) (weilEtaleLocalTorsionMap C m u) =
          equiv_C U₁ (L_C U₁) (𝟙 (L_C U₁)) ≫ (L_C U₁).obj.map (Opposite.op u) :=
        Equiv.apply_symm_apply _ _
      have h_unit_nat :
          (L_C U₁).obj.map (Opposite.op u) ≫
              (adj_L.unit.app (L_C U₁)).hom.app (Opposite.op U₂) =
            (adj_L.unit.app (L_C U₁)).hom.app (Opposite.op U₁) ≫
              (res_κ.obj (pf_κ.obj (L_C U₁))).obj.map (Opposite.op u) :=
        (adj_L.unit.app (L_C U₁)).hom.naturality (Opposite.op u)
      have h4 :
          equiv_C U₁ (L_C U₁) (𝟙 (L_C U₁)) ≫
              (adj_L.unit.app (L_C U₁)).hom.app (Opposite.op U₁) =
            equiv_C U₁ (res_κ.obj (pf_κ.obj (L_C U₁))) (adj_L.unit.app (L_C U₁)) :=
        (hEquiv_comp (𝟙 (L_C U₁)) (adj_L.unit.app (L_C U₁))).symm.trans
          (congrArg (equiv_C U₁ (res_κ.obj (pf_κ.obj (L_C U₁))))
            (CategoryTheory.Category.id_comp (adj_L.unit.app (L_C U₁))))
      rw [h3, hmap_C, CategoryTheory.Category.assoc, h_unit_nat,
        ← CategoryTheory.Category.assoc, h4]
    have hRHS :
        bridge U₂ (pf_κ.obj (L_C U₁))
          (equiv_Y (K_κ.obj U₂) (pf_κ.obj (L_C U₁))
            (weilEtaleLocalTorsionMap Y m (K_κ.map u) ≫ (e_loc U₁).hom)) =
        equiv_C U₁ (res_κ.obj (pf_κ.obj (L_C U₁))) (adj_L.unit.app (L_C U₁)) ≫
          (res_κ.obj (pf_κ.obj (L_C U₁))).obj.map (Opposite.op u) := by
      have h1 :
          equiv_Y (K_κ.obj U₂) (pf_κ.obj (L_C U₁))
              (weilEtaleLocalTorsionMap Y m (K_κ.map u) ≫ (e_loc U₁).hom) =
            equiv_Y (K_κ.obj U₁) (pf_κ.obj (L_C U₁)) (e_loc U₁).hom ≫
              (pf_κ.obj (L_C U₁)).obj.map (Opposite.op (K_κ.map u)) := by
        have hmap_Y : equiv_Y (K_κ.obj U₂) (L_Y (K_κ.obj U₁))
            (weilEtaleLocalTorsionMap Y m (K_κ.map u)) =
            equiv_Y (K_κ.obj U₁) (L_Y (K_κ.obj U₁)) (𝟙 (L_Y (K_κ.obj U₁))) ≫
              (L_Y (K_κ.obj U₁)).obj.map (Opposite.op (K_κ.map u)) :=
          Equiv.apply_symm_apply _ _
        calc
          equiv_Y (K_κ.obj U₂) (pf_κ.obj (L_C U₁))
              (weilEtaleLocalTorsionMap Y m (K_κ.map u) ≫ (e_loc U₁).hom)
            = equiv_Y (K_κ.obj U₂) (L_Y (K_κ.obj U₁))
                (weilEtaleLocalTorsionMap Y m (K_κ.map u)) ≫
                (e_loc U₁).hom.hom.app (Opposite.op (K_κ.obj U₂)) :=
              hEquiv_comp (weilEtaleLocalTorsionMap Y m (K_κ.map u)) (e_loc U₁).hom
          _ = (equiv_Y (K_κ.obj U₁) (L_Y (K_κ.obj U₁)) (𝟙 (L_Y (K_κ.obj U₁))) ≫
                (e_loc U₁).hom.hom.app (Opposite.op (K_κ.obj U₁))) ≫
                (pf_κ.obj (L_C U₁)).obj.map (Opposite.op (K_κ.map u)) := by
              rw [hmap_Y, CategoryTheory.Category.assoc,
                (e_loc U₁).hom.hom.naturality (Opposite.op (K_κ.map u)),
                ← CategoryTheory.Category.assoc]
          _ = equiv_Y (K_κ.obj U₁) (pf_κ.obj (L_C U₁)) (e_loc U₁).hom ≫
                (pf_κ.obj (L_C U₁)).obj.map (Opposite.op (K_κ.map u)) := by
              rw [← hEquiv_comp (𝟙 (L_Y (K_κ.obj U₁))) (e_loc U₁).hom,
                CategoryTheory.Category.id_comp]
      have h2 :
          bridge U₂ (pf_κ.obj (L_C U₁))
              (equiv_Y (K_κ.obj U₁) (pf_κ.obj (L_C U₁)) (e_loc U₁).hom ≫
                (pf_κ.obj (L_C U₁)).obj.map (Opposite.op (K_κ.map u))) =
            bridge U₁ (pf_κ.obj (L_C U₁))
              (equiv_Y (K_κ.obj U₁) (pf_κ.obj (L_C U₁)) (e_loc U₁).hom) ≫
              (res_κ.obj (pf_κ.obj (L_C U₁))).obj.map (Opposite.op u) := rfl
      rw [h1, h2, he_loc_hom_equiv U₁]
    exact hLHS.trans hRHS.symm

  have he_loc_inv_nat : ∀ {U₂ U₁ : C.Etale} (u : U₂ ⟶ U₁),
      (e_loc U₂).inv ≫ weilEtaleLocalTorsionMap Y m (K_κ.map u) =
        pf_κ.map (weilEtaleLocalTorsionMap C m u) ≫ (e_loc U₁).inv := by
    intro U₂ U₁ u
    calc
      (e_loc U₂).inv ≫ weilEtaleLocalTorsionMap Y m (K_κ.map u)
        = (e_loc U₂).inv ≫ weilEtaleLocalTorsionMap Y m (K_κ.map u) ≫
            ((e_loc U₁).hom ≫ (e_loc U₁).inv) := by
          rw [(e_loc U₁).hom_inv_id, CategoryTheory.Category.comp_id]
      _ = (e_loc U₂).inv ≫ (weilEtaleLocalTorsionMap Y m (K_κ.map u) ≫ (e_loc U₁).hom) ≫
            (e_loc U₁).inv := by
          simp only [CategoryTheory.Category.assoc]
      _ = ((e_loc U₂).inv ≫ (e_loc U₂).hom) ≫
            pf_κ.map (weilEtaleLocalTorsionMap C m u) ≫ (e_loc U₁).inv := by
          rw [← he_loc_nat u]
          simp only [CategoryTheory.Category.assoc]
      _ = pf_κ.map (weilEtaleLocalTorsionMap C m u) ≫ (e_loc U₁).inv := by
          rw [(e_loc U₂).inv_hom_id, CategoryTheory.Category.id_comp]

  
  have := adj_R.leftAdjoint_preservesColimits
  have := adj_L.rightAdjoint_preservesLimits
  have := adj_L.leftAdjoint_preservesColimits
  have := adj_R.rightAdjoint_preservesLimits
  have : res_κ.Additive := res_κ.additive_of_preserves_binary_products
  have : pf_κ.Additive := pf_κ.additive_of_preserves_binary_products

  let Aℤ := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ_Y := (CategoryTheory.constantSheaf J_Y AddCommGrpCat.{u}).obj Aℤ
  let Fℤ_C := (CategoryTheory.constantSheaf J_C AddCommGrpCat.{u}).obj Aℤ
  let T_Y : Y.Etale := weilEtaleIdTerminal.{u} Y
  let hT_Y : CategoryTheory.Limits.IsTerminal T_Y := weilEtaleIdTerminalIsTerminal.{u} Y
  let hT'_C : CategoryTheory.Limits.IsTerminal (B_κ.obj T_Y) :=
    CategoryTheory.Limits.IsTerminal.ofUniqueHom
      (fun V => (adj_site.homEquiv V T_Y) (hT_Y.from (K_κ.obj V)))
      (fun V g => (adj_site.homEquiv V T_Y).symm.injective
        (by
          rw [Equiv.symm_apply_apply]
          exact hT_Y.hom_ext _ _))

  let adj1 := (CategoryTheory.constantSheafAdj J_Y AddCommGrpCat.{u} hT_Y).comp adj_R
  let adj2 := CategoryTheory.constantSheafAdj J_C AddCommGrpCat.{u} hT'_C
  let e_ℤ : res_κ.obj Fℤ_Y ≅ Fℤ_C :=
    (CategoryTheory.Adjunction.leftAdjointUniq adj1 adj2).app Aℤ

  let e_pre : ∀ (N : CategoryTheory.Sheaf J_C AddCommGrpCat.{u}) (q : ℕ),
      CategoryTheory.Abelian.Ext Fℤ_C N q ≃+ CategoryTheory.Abelian.Ext (res_κ.obj Fℤ_Y) N q :=
    fun N q =>
      AddEquiv.ofBijective
        ((CategoryTheory.Abelian.Ext.mk₀ e_ℤ.hom).precomp N (Nat.zero_add q))
        (Function.bijective_iff_has_inverse.mpr
          ⟨(CategoryTheory.Abelian.Ext.mk₀ e_ℤ.inv).precomp N (Nat.zero_add q),
            fun x => by
              change (CategoryTheory.Abelian.Ext.mk₀ e_ℤ.inv).comp
                ((CategoryTheory.Abelian.Ext.mk₀ e_ℤ.hom).comp x (Nat.zero_add q))
                (Nat.zero_add q) = x
              rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
                  (Nat.add_zero 0) (Nat.zero_add q) (by omega),
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_ℤ.inv_hom_id,
                CategoryTheory.Abelian.Ext.mk₀_id_comp],
            fun y => by
              change (CategoryTheory.Abelian.Ext.mk₀ e_ℤ.hom).comp
                ((CategoryTheory.Abelian.Ext.mk₀ e_ℤ.inv).comp y (Nat.zero_add q))
                (Nat.zero_add q) = y
              rw [← CategoryTheory.Abelian.Ext.comp_assoc _ _ _
                  (Nat.add_zero 0) (Nat.zero_add q) (by omega),
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, e_ℤ.hom_inv_id,
                CategoryTheory.Abelian.Ext.mk₀_id_comp]⟩)

  let e_post : ∀ (U : C.Etale) (q : ℕ),
      CategoryTheory.Abelian.Ext Fℤ_Y (pf_κ.obj (L_C U)) q ≃+
        CategoryTheory.Abelian.Ext Fℤ_Y (L_Y (K_κ.obj U)) q :=
    fun U q =>
      AddEquiv.ofBijective
        ((CategoryTheory.Abelian.Ext.mk₀ (e_loc U).inv).postcomp Fℤ_Y (Nat.add_zero q))
        (Function.bijective_iff_has_inverse.mpr
          ⟨(CategoryTheory.Abelian.Ext.mk₀ (e_loc U).hom).postcomp Fℤ_Y (Nat.add_zero q),
            fun x => by
              change (x.comp (CategoryTheory.Abelian.Ext.mk₀ (e_loc U).inv) (Nat.add_zero q)).comp
                (CategoryTheory.Abelian.Ext.mk₀ (e_loc U).hom) (Nat.add_zero q) = x
              rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (e_loc U).inv_hom_id,
                CategoryTheory.Abelian.Ext.comp_mk₀_id],
            fun y => by
              change (y.comp (CategoryTheory.Abelian.Ext.mk₀ (e_loc U).hom) (Nat.add_zero q)).comp
                (CategoryTheory.Abelian.Ext.mk₀ (e_loc U).inv) (Nat.add_zero q) = y
              rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀, (e_loc U).hom_inv_id,
                CategoryTheory.Abelian.Ext.comp_mk₀_id]⟩)

  let Φ : ∀ (U : C.Etale) (q : ℕ),
      weilEtaleLocalTorsionH C m U q ≃+ weilEtaleLocalTorsionH Y m (K_κ.obj U) q :=
    fun U q => ((e_pre (L_C U) q).trans adj_R.extEquiv).trans (e_post U q)

  refine ⟨?_, ?_⟩
  · intro U hEt q
    exact ⟨(Φ U q).symm⟩
  · intro U₂ U₁ u hEt₂ hEt₁ U₂_Y U₁_Y u_Y hu_eq q h0
    have hΦ_nat : ∀ x : weilEtaleLocalTorsionH C m U₂ q,
        weilEtaleLocalTorsionMapH Y m (K_κ.map u) q (Φ U₂ q x) =
          Φ U₁ q (weilEtaleLocalTorsionMapH C m u q x) := by
      intro x
      let y : CategoryTheory.Abelian.Ext (res_κ.obj Fℤ_Y) (L_C U₂) q := e_pre (L_C U₂) q x
      have hy_comp :
          e_pre (L_C U₁) q (weilEtaleLocalTorsionMapH C m u q x) =
            y.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap C m u))
              (Nat.add_zero q) := by
        change (CategoryTheory.Abelian.Ext.mk₀ e_ℤ.hom).comp
            (x.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap C m u))
              (Nat.add_zero q)) (Nat.zero_add q) =
          ((CategoryTheory.Abelian.Ext.mk₀ e_ℤ.hom).comp x (Nat.zero_add q)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap C m u)) (Nat.add_zero q)
        exact (CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ (Nat.zero_add q)).symm
      have hext_nat :
          (adj_R.extEquiv y).comp
              (CategoryTheory.Abelian.Ext.mk₀ (pf_κ.map (weilEtaleLocalTorsionMap C m u)))
              (Nat.add_zero q) =
            adj_R.extEquiv
              (y.comp (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap C m u))
                (Nat.add_zero q)) := by
        rw [CategoryTheory.Adjunction.extEquiv_apply, CategoryTheory.Adjunction.extEquiv_apply,
          CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
          ← CategoryTheory.Abelian.Ext.mapExactFunctor_mk₀ pf_κ (weilEtaleLocalTorsionMap C m u),
          ← CategoryTheory.Abelian.Ext.mapExactFunctor_comp pf_κ y
            (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap C m u)) (Nat.add_zero q)]
      change ((adj_R.extEquiv y).comp
          (CategoryTheory.Abelian.Ext.mk₀ (e_loc U₂).inv) (Nat.add_zero q)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (weilEtaleLocalTorsionMap Y m (K_κ.map u)))
          (Nat.add_zero q) =
        (adj_R.extEquiv (e_pre (L_C U₁) q (weilEtaleLocalTorsionMapH C m u q x))).comp
          (CategoryTheory.Abelian.Ext.mk₀ (e_loc U₁).inv) (Nat.add_zero q)
      rw [CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        he_loc_inv_nat u,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        ← CategoryTheory.Abelian.Ext.comp_assoc_of_third_deg_zero,
        hext_nat,
        hy_comp]
    let u_Y' : K_κ.obj U₂ ⟶ K_κ.obj U₁ := u_Y
    have hu_Y' : u_Y' = K_κ.map u :=
      CategoryTheory.MorphismProperty.Over.Hom.ext hu_eq
    change weilEtaleLocalTorsionMapH Y m u_Y' q = 0
    rw [hu_Y']
    refine AddMonoidHom.ext fun z => ?_
    let x : weilEtaleLocalTorsionH C m U₂ q := (Φ U₂ q).symm z
    have hz : z = Φ U₂ q x := ((Φ U₂ q).apply_symm_apply z).symm
    exact (congrArg (weilEtaleLocalTorsionMapH Y m (K_κ.map u) q) hz).trans
      ((hΦ_nat x).trans
        ((congrArg (Φ U₁ q) (DFunLike.congr_fun h0 x)).trans (map_zero (Φ U₁ q))))

theorem weil_etale_connected_openImmersion_ne_univ_localTorsionH_zero_subsingleton (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S]
    (m : ℕ) (U_et : S.Etale) [AlgebraicGeometry.IsOpenImmersion U_et.hom]
    (hNeUniv : Set.range U_et.hom.base ≠ Set.univ) :
    Subsingleton (weilEtaleLocalTorsionH S m U_et 0) :=
by
  classical
  
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let J := S.smallEtaleTopology
  let Fgt := AlgebraicGeometry.Scheme.Etale.forget S
  have hw_et : ∀ {W V : S.Etale} (g : W ⟶ V),
      g.left ≫ (Fgt.obj V).hom = (Fgt.obj W).hom :=
    fun g => (Fgt.map g).w
  have hEt_arrow : ∀ {W V : S.Etale} (g : W ⟶ V),
      AlgebraicGeometry.Etale g.left ∧ IsOpenMap ⇑g.left := by
    intro W V g
    have hw : g.left ≫ V.hom = W.hom := (Fgt.map g).w
    have hV : AlgebraicGeometry.Etale V.hom := V.prop
    have hW : AlgebraicGeometry.Etale W.hom := W.prop
    have hEt_g : AlgebraicGeometry.Etale g.left :=
      CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        g.left V.hom hV (by rw [hw]; exact hW)
    have : AlgebraicGeometry.UniversallyOpen g.left :=
      AlgebraicGeometry.UniversallyOpen.of_flat g.left
    exact ⟨hEt_g, g.left.isOpenMap⟩
  have hMem_J : ∀ (V : S.Etale) (R : CategoryTheory.Sieve V),
      R ∈ J V ↔
        ∀ x : ↥V.left, ∃ (W : S.Etale) (g : W ⟶ V) (w : ↥W.left),
          R.arrows g ∧ P_et g.left ∧ g.left.base w = x := by
    intro V R
    change R ∈ AlgebraicGeometry.Scheme.smallGrothendieckTopology (P := P_et) S V ↔ _
    rw [AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology S
      (le_refl P_et)]
    exact AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) (S := S) V R

  
  let u_hom : U_et.left ⟶ S := U_et.hom
  have : AlgebraicGeometry.IsOpenImmersion u_hom := ‹AlgebraicGeometry.IsOpenImmersion U_et.hom›
  let V_open : S.Opens := ⟨Set.range U_et.hom.base, u_hom.isOpenEmbedding.isOpen_range⟩
  let P_U := weilAltZeroBdrySubpresheaf S V_open m

  have hSheaf : CategoryTheory.Presheaf.IsSheaf J P_U := by
    intro E V R hR x hx
    let ev_x : ∀ {W : S.Etale} (g : W ⟶ V), R.arrows g → (E ⟶ P_U.obj (Opposite.op W)) :=
      fun g hg => x g hg
    have hCov_V := (hMem_J V R).mp hR
    have hOverlap : ∀ (e : ↥E) {W₁ W₂ : S.Etale} (g₁ : W₁ ⟶ V) (g₂ : W₂ ⟶ V)
        (hg₁ : R.arrows g₁) (hg₂ : R.arrows g₂) (w₁ : ↥W₁.left) (w₂ : ↥W₂.left),
        g₁.left.base w₁ = g₂.left.base w₂ →
        (ev_x g₁ hg₁ e).1 w₁ = (ev_x g₂ hg₂ e).1 w₂ := by
      intro e W₁ W₂ g₁ g₂ hg₁ hg₂ w₁ w₂ heq
      have : AlgebraicGeometry.Etale g₂.left := (hEt_arrow g₂).1
      let w₁_hom : W₁.left ⟶ S := W₁.hom
      have : AlgebraicGeometry.Etale w₁_hom := W₁.prop
      let p₁ := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
      let p₂ := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
      have : AlgebraicGeometry.Etale p₁ := inferInstance
      have hEt_pb : AlgebraicGeometry.Etale (p₁ ≫ w₁_hom) := inferInstance
      let W_pb : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₁ ≫ w₁_hom) hEt_pb
      let π₁ : W_pb ⟶ W₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ rfl trivial
      have hπ₂_w : p₂ ≫ W₂.hom = p₁ ≫ w₁_hom :=
        (congrArg (p₂ ≫ ·) (hw_et g₂).symm).trans
          ((CategoryTheory.Category.assoc p₂ g₂.left _).symm.trans
            ((congrArg (· ≫ (Fgt.obj V).hom)
                CategoryTheory.Limits.pullback.condition.symm).trans
              ((CategoryTheory.Category.assoc p₁ g₁.left _).trans
                (congrArg (p₁ ≫ ·) (hw_et g₁)))))
      let π₂ : W_pb ⟶ W₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ hπ₂_w trivial
      have hπ_comm : π₁ ≫ g₁ = π₂ ≫ g₂ :=
        CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
      obtain ⟨z, hz₁, hz₂⟩ :=
        AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback w₁ w₂ heq
      have hcompat_hom : ev_x g₁ hg₁ ≫ P_U.map π₁.op = ev_x g₂ hg₂ ≫ P_U.map π₂.op :=
        hx π₁ π₂ hg₁ hg₂ hπ_comm
      have hcompat_z :
          (ev_x g₁ hg₁ e).1 (p₁.base z) = (ev_x g₂ hg₂ e).1 (p₂.base z) :=
        congrArg (fun (k : E ⟶ P_U.obj (Opposite.op W_pb)) => (k e).1 z) hcompat_hom
      rwa [hz₁, hz₂] at hcompat_z
    let W_v : ↥V.left → S.Etale := fun v => Classical.choose (hCov_V v)
    let g_v : ∀ v : ↥V.left, W_v v ⟶ V := fun v =>
      Classical.choose (Classical.choose_spec (hCov_V v))
    let w_v : ∀ v : ↥V.left, ↥(W_v v).left := fun v =>
      Classical.choose (Classical.choose_spec (Classical.choose_spec (hCov_V v)))
    have hg_v : ∀ v : ↥V.left, R.arrows (g_v v) := fun v =>
      (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov_V v)))).1
    have hw_v : ∀ v : ↥V.left, (g_v v).left.base (w_v v) = v := fun v =>
      (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hCov_V v)))).2.2
    let f_tilde : ↥E → ↥V.left → ULift.{u} (ZMod m) :=
      fun e v => (ev_x (g_v v) (hg_v v) e).1 (w_v v)
    have hf_eq : ∀ (e : ↥E) {W : S.Etale} (g : W ⟶ V) (hg : R.arrows g) (w : ↥W.left),
        f_tilde e (g.left.base w) = (ev_x g hg e).1 w := by
      intro e W g hg w
      exact hOverlap e (g_v (g.left.base w)) g (hg_v (g.left.base w)) hg
        (w_v (g.left.base w)) w (hw_v (g.left.base w))
    have hf_lc : ∀ e : ↥E, IsLocallyConstant (f_tilde e) := by
      intro e T
      have hset : f_tilde e ⁻¹' T =
          ⋃ (W : S.Etale) (g : W ⟶ V) (hg : R.arrows g),
            ⇑g.left '' ((ev_x g hg e).1 ⁻¹' T) := by
        ext v
        simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
        constructor
        · intro hv
          exact ⟨W_v v, g_v v, hg_v v, w_v v, hv, hw_v v⟩
        · rintro ⟨W, g, hg, w, hwT, rfl⟩
          change f_tilde e (g.left.base w) ∈ T
          rw [hf_eq e g hg w]
          exact hwT
      rw [hset]
      refine isOpen_iUnion fun W => isOpen_iUnion fun g => isOpen_iUnion fun hg => ?_
      exact (hEt_arrow g).2 _ ((ev_x g hg e).1.isLocallyConstant T)
    have hf_bdry : ∀ (e : ↥E) (v : ↥(Fgt.obj V).left),
        (Fgt.obj V).hom v ∉ (V_open : Set ↥S) → f_tilde e v = 0 := by
      intro e v hv
      apply (ev_x (g_v v) (hg_v v) e).2 (w_v v)
      intro hmem
      apply hv
      have hcomp_v : (Fgt.obj (W_v v)).hom (w_v v) = (Fgt.obj V).hom v := by
        calc
          (Fgt.obj (W_v v)).hom (w_v v)
            = ((Fgt.map (g_v v)).left ≫ (Fgt.obj V).hom) (w_v v) := by
                rw [(Fgt.map (g_v v)).w]
          _ = (Fgt.obj V).hom ((g_v v).left.base (w_v v)) :=
                AlgebraicGeometry.Scheme.Hom.comp_apply
                  (Fgt.map (g_v v)).left (Fgt.obj V).hom (w_v v)
          _ = (Fgt.obj V).hom v := by rw [hw_v v]
      rwa [← hcomp_v]
    let sec_V : ↥E → ↥(P_U.obj (Opposite.op V)) :=
      fun e => ⟨⟨f_tilde e, hf_lc e⟩, hf_bdry e⟩
    let φ : E ⟶ P_U.obj (Opposite.op V) :=
      AddCommGrpCat.ofHom
        { toFun := sec_V
          map_zero' := Subtype.ext (LocallyConstant.ext fun v => by
            change (ev_x (g_v v) (hg_v v) 0).1 (w_v v) = 0
            rw [map_zero]
            rfl)
          map_add' := fun e₁ e₂ => Subtype.ext (LocallyConstant.ext fun v => by
            change (ev_x (g_v v) (hg_v v) (e₁ + e₂)).1 (w_v v) =
              (ev_x (g_v v) (hg_v v) e₁).1 (w_v v) + (ev_x (g_v v) (hg_v v) e₂).1 (w_v v)
            rw [map_add]
            rfl) }
    refine ⟨φ, ?_, ?_⟩
    · intro W g hg
      exact AddCommGrpCat.ext fun e => Subtype.ext (LocallyConstant.ext fun w =>
        hf_eq e g hg w)
    · intro φ' hφ'
      let φ'' : E ⟶ P_U.obj (Opposite.op V) := φ'
      change φ'' = φ
      refine AddCommGrpCat.ext fun e => Subtype.ext (LocallyConstant.ext fun v => ?_)
      have hres : φ'' ≫ P_U.map (g_v v).op = ev_x (g_v v) (hg_v v) :=
        hφ' (g_v v) (hg_v v)
      have heval : (φ'' e).1 ((g_v v).left.base (w_v v)) =
          (ev_x (g_v v) (hg_v v) e).1 (w_v v) :=
        congrArg (fun (k : E ⟶ P_U.obj (Opposite.op (W_v v))) => (k e).1 (w_v v)) hres
      exact (congrArg (φ'' e).1 (hw_v v).symm).trans heval

  
  let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
  let LT := weilEtaleLocalTorsionSheaf S m U_et
  let η : AM ⟶ LT.obj.obj (Opposite.op U_et) :=
    CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id LT)
  let η_fn : ULift.{u} (ZMod m) →+ ↥(LT.obj.obj (Opposite.op U_et)) :=
    { toFun := fun c => η.hom c
      map_zero' := η.hom.map_zero
      map_add' := fun a b => η.hom.map_add a b }
  let LT_set : S.Etaleᵒᵖ ⥤ Type u := LT.obj ⋙ CategoryTheory.forget AddCommGrpCat.{u}
  have hSh_LT : CategoryTheory.Presieve.IsSheaf J LT_set :=
    (CategoryTheory.isSheaf_iff_isSheaf_of_type J LT_set).mp
      (CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J LT.obj
        (CategoryTheory.forget AddCommGrpCat.{u}) LT.property)
  have hEmpty_sub : ∀ (W : S.Etale), IsEmpty ↥W.left →
      Subsingleton ↥(LT.obj.obj (Opposite.op W)) := by
    intro W hEmp
    have hBot : (⊥ : CategoryTheory.Sieve W) ∈ J W :=
      (hMem_J W ⊥).mpr (fun z => IsEmpty.elim hEmp z)
    rw [← CategoryTheory.Sieve.generate_sieve (⊥ : CategoryTheory.Sieve W)] at hBot
    exact ⟨fun s₁ s₂ =>
      (hSh_LT.isSheafFor (⊥ : CategoryTheory.Sieve W).arrows hBot).isSeparatedFor.ext
        (fun _ f hf => False.elim ((CategoryTheory.Sieve.bot_apply f).mp hf))⟩
  have hSep_arrows : ∀ {V : S.Etale} {ι : Type u} {Y : ι → S.Etale} (π : ∀ i : ι, Y i ⟶ V),
      CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y π) ∈ J V →
      ∀ {s₁ s₂ : ↥(LT.obj.obj (Opposite.op V))},
        (∀ i : ι, (LT.obj.map (π i).op) s₁ = (LT.obj.map (π i).op) s₂) →
        s₁ = s₂ := by
    intro V ι Y π hCov s₁ s₂ heq
    exact (hSh_LT.isSheafFor (CategoryTheory.Presieve.ofArrows Y π) hCov).isSeparatedFor.ext
      (fun _ _ hf => by
        rcases hf with ⟨i⟩
        exact heq i)

  
  let mkOpenEtale : ∀ (V : S.Etale), V.left.Opens → S.Etale :=
    fun V O =>
      let v_hom : V.left ⟶ S := V.hom
      have : AlgebraicGeometry.Etale v_hom := V.prop
      CategoryTheory.MorphismProperty.Over.mk ⊤ (O.ι ≫ v_hom)
        (inferInstance : AlgebraicGeometry.Etale (O.ι ≫ v_hom))
  let mkOpenEtaleι : ∀ (V : S.Etale) (O : V.left.Opens), mkOpenEtale V O ⟶ V :=
    fun V O => CategoryTheory.MorphismProperty.Over.homMk O.ι rfl trivial
  let mkOpenEtaleLE : ∀ (V : S.Etale) {O₁ O₂ : V.left.Opens},
      O₁ ≤ O₂ → (mkOpenEtale V O₁ ⟶ mkOpenEtale V O₂) :=
    fun V {_ _} h_le =>
      let v_hom : V.left ⟶ S := V.hom
      CategoryTheory.MorphismProperty.Over.homMk (V.left.homOfLE h_le)
        (AlgebraicGeometry.Scheme.homOfLE_ι_assoc V.left h_le v_hom) trivial

  let O_lvl : ∀ (V : S.Etale), ↥(P_U.obj (Opposite.op V)) →
      ULift.{u} (ZMod m) → V.left.Opens :=
    fun _ f c => ⟨f.1 ⁻¹' {c}, f.1.isLocallyConstant {c}⟩
  let E_lvl : ∀ (V : S.Etale), ↥(P_U.obj (Opposite.op V)) →
      ULift.{u} (ZMod m) → S.Etale :=
    fun V f c => mkOpenEtale V (O_lvl V f c)
  let ι_lvl : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (c : ULift.{u} (ZMod m)), E_lvl V f c ⟶ V :=
    fun V f c => mkOpenEtaleι V (O_lvl V f c)

  have hCov_lvl : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))),
      CategoryTheory.Sieve.generate
        (CategoryTheory.Presieve.ofArrows (E_lvl V f) (ι_lvl V f)) ∈ J V := by
    intro V f
    rw [hMem_J]
    intro x
    let c : ULift.{u} (ZMod m) := f.1 x
    refine ⟨E_lvl V f c, ι_lvl V f c, ⟨x, rfl⟩, ?_, ?_, ?_⟩
    · exact ⟨E_lvl V f c, 𝟙 _, ι_lvl V f c, CategoryTheory.Presieve.ofArrows.mk c,
        CategoryTheory.Category.id_comp _⟩
    · change AlgebraicGeometry.Etale (O_lvl V f c).ι
      infer_instance
    · exact AlgebraicGeometry.Scheme.Opens.ι_apply (O_lvl V f c) ⟨x, rfl⟩

  have hRange_lvl : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (c : ULift.{u} (ZMod m)), c ≠ 0 →
      Set.range ((O_lvl V f c).ι ≫ V.hom).base ⊆ Set.range u_hom.base := by
    rintro V f c hc _ ⟨x, rfl⟩
    have hcomp_x : ((O_lvl V f c).ι ≫ V.hom).base x = (Fgt.obj V).hom x.1 := by
      have h1 := AlgebraicGeometry.Scheme.Hom.comp_apply (O_lvl V f c).ι V.hom x
      have h2 : (O_lvl V f c).ι.base x = x.1 :=
        AlgebraicGeometry.Scheme.Opens.ι_apply (O_lvl V f c) x
      exact h1.trans (congrArg V.hom.base h2)
    rw [hcomp_x]
    change (Fgt.obj V).hom x.1 ∈ (V_open : Set ↥S)
    by_contra hx_not
    exact hc ((x.2 : f.1 x.1 = c).symm.trans (f.2 x.1 hx_not))

  let u_lvl : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (c : ULift.{u} (ZMod m)) (_ : c ≠ 0), E_lvl V f c ⟶ U_et :=
    fun V f c hc =>
      let f_c : (O_lvl V f c).toScheme ⟶ S := (O_lvl V f c).ι ≫ V.hom
      let lift_c : (O_lvl V f c).toScheme ⟶ U_et.left :=
        AlgebraicGeometry.IsOpenImmersion.lift u_hom f_c (hRange_lvl V f c hc)
      CategoryTheory.MorphismProperty.Over.homMk lift_c
        (AlgebraicGeometry.IsOpenImmersion.lift_fac u_hom f_c (hRange_lvl V f c hc)) trivial

  let loc_sec : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (c : ULift.{u} (ZMod m)), ↥(LT.obj.obj (Opposite.op (E_lvl V f c))) :=
    fun V f c =>
      if hc : c = 0 then 0
      else (LT.obj.map (u_lvl V f c hc).op) (η_fn c)

  have hCompat_lvl : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))),
      CategoryTheory.Presieve.Arrows.Compatible LT_set (ι_lvl V f) (loc_sec V f) := by
    intro V f c₁ c₂ Z g₁ g₂ hcomm
    by_cases hc_eq : c₁ = c₂
    · subst hc_eq
      have hg_left : g₁.left = g₂.left :=
        (cancel_mono (O_lvl V f c₁).ι).mp (congrArg (fun k => k.left) hcomm)
      have hg_eq : g₁ = g₂ := CategoryTheory.MorphismProperty.Over.Hom.ext hg_left
      subst hg_eq
      rfl
    · have hEmpZ : IsEmpty ↥Z.left := ⟨fun z => by
        have hz_eq : (g₁.left.base z).1 = (g₂.left.base z).1 := by
          calc
            (g₁.left.base z).1 = (O_lvl V f c₁).ι.base (g₁.left.base z) :=
              (AlgebraicGeometry.Scheme.Opens.ι_apply (O_lvl V f c₁) (g₁.left.base z)).symm
            _ = (g₁.left ≫ (O_lvl V f c₁).ι).base z :=
              (AlgebraicGeometry.Scheme.Hom.comp_apply g₁.left (O_lvl V f c₁).ι z).symm
            _ = (g₂.left ≫ (O_lvl V f c₂).ι).base z :=
              congrArg (fun k : Z ⟶ V => k.left.base z) hcomm
            _ = (O_lvl V f c₂).ι.base (g₂.left.base z) :=
              AlgebraicGeometry.Scheme.Hom.comp_apply g₂.left (O_lvl V f c₂).ι z
            _ = (g₂.left.base z).1 :=
              AlgebraicGeometry.Scheme.Opens.ι_apply (O_lvl V f c₂) (g₂.left.base z)
        have hc₁ : f.1 (g₁.left.base z).1 = c₁ := (g₁.left.base z).2
        have hc₂ : f.1 (g₂.left.base z).1 = c₂ := (g₂.left.base z).2
        rw [hz_eq] at hc₁
        exact hc_eq (hc₁.symm.trans hc₂)⟩
      exact (hEmpty_sub Z hEmpZ).elim _ _

  have hGlue_lvl : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V))),
      ∃! t : ↥(LT.obj.obj (Opposite.op V)),
        ∀ c : ULift.{u} (ZMod m),
          (LT.obj.map (ι_lvl V f c).op) t = loc_sec V f c :=
    fun V f =>
      (CategoryTheory.Presieve.isSheafFor_arrows_iff LT_set (ι_lvl V f)).mp
        (hSh_LT.isSheafFor _ (hCov_lvl V f)) (loc_sec V f) (hCompat_lvl V f)

  let ψ_val : ∀ (V : S.Etale), ↥(P_U.obj (Opposite.op V)) → ↥(LT.obj.obj (Opposite.op V)) :=
    fun V f => Classical.choose (hGlue_lvl V f)
  have hψ_glue : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (c : ULift.{u} (ZMod m)),
      (LT.obj.map (ι_lvl V f c).op) (ψ_val V f) = loc_sec V f c :=
    fun V f => (Classical.choose_spec (hGlue_lvl V f)).1

  have hRestrict_zero : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (O : V.left.Opens),
      (∀ x : ↥O, f.1 x.1 = 0) →
      (LT.obj.map (mkOpenEtaleι V O).op) (ψ_val V f) = 0 := by
    intro V f O hf0
    have h_le : O ≤ O_lvl V f 0 := fun y hy => hf0 ⟨y, hy⟩
    let inc : mkOpenEtale V O ⟶ E_lvl V f 0 := mkOpenEtaleLE V h_le
    have hinc_ι : inc ≫ ι_lvl V f 0 = mkOpenEtaleι V O :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (V.left.homOfLE_ι h_le)
    have hstep : (LT.obj.map (mkOpenEtaleι V O).op) (ψ_val V f) =
        (LT.obj.map inc.op) (loc_sec V f 0) := by
      rw [← hinc_ι, op_comp, CategoryTheory.Functor.map_comp]
      exact congrArg (LT.obj.map inc.op) (hψ_glue V f 0)
    rw [hstep]
    simp only [loc_sec, ↓reduceDIte, map_zero]

  have hRestrict_hom : ∀ (V : S.Etale) (f : ↥(P_U.obj (Opposite.op V)))
      (O : V.left.Opens) (c : ULift.{u} (ZMod m))
      (u : mkOpenEtale V O ⟶ U_et),
      (∀ x : ↥O, f.1 x.1 = c) →
      (LT.obj.map (mkOpenEtaleι V O).op) (ψ_val V f) = (LT.obj.map u.op) (η_fn c) := by
    intro V f O c u hfc
    have h_le : O ≤ O_lvl V f c := fun y hy => hfc ⟨y, hy⟩
    let inc : mkOpenEtale V O ⟶ E_lvl V f c := mkOpenEtaleLE V h_le
    have hinc_ι : inc ≫ ι_lvl V f c = mkOpenEtaleι V O :=
      CategoryTheory.MorphismProperty.Over.Hom.ext (V.left.homOfLE_ι h_le)
    have hstep : (LT.obj.map (mkOpenEtaleι V O).op) (ψ_val V f) =
        (LT.obj.map inc.op) (loc_sec V f c) := by
      rw [← hinc_ι, op_comp, CategoryTheory.Functor.map_comp]
      exact congrArg (LT.obj.map inc.op) (hψ_glue V f c)
    rw [hstep]
    by_cases hc : c = 0
    · subst hc
      simp only [loc_sec, ↓reduceDIte, map_zero]
    · simp only [loc_sec, hc, ↓reduceDIte]
      have hu_eq : inc ≫ u_lvl V f c hc = u := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        apply (cancel_mono u_hom).mp
        have hw1 : (inc ≫ u_lvl V f c hc).left ≫ u_hom = (Fgt.obj (mkOpenEtale V O)).hom :=
          (Fgt.map (inc ≫ u_lvl V f c hc)).w
        have hw2 : u.left ≫ u_hom = (Fgt.obj (mkOpenEtale V O)).hom :=
          (Fgt.map u).w
        exact hw1.trans hw2.symm
      rw [← hu_eq, op_comp, CategoryTheory.Functor.map_comp]
      rfl

  
  have hψ_zero : ∀ V : S.Etale, ψ_val V 0 = 0 := by
    intro V
    refine hSep_arrows (ι_lvl V 0) (hCov_lvl V 0) (fun c => ?_)
    by_cases hc : c = 0
    · subst hc
      rw [hψ_glue V 0 0, map_zero]
      simp only [loc_sec, ↓reduceDIte]
    · have hEmp : IsEmpty ↥(E_lvl V 0 c).left :=
        ⟨fun x => hc (x.2 : (0 : ULift.{u} (ZMod m)) = c).symm⟩
      exact (hEmpty_sub (E_lvl V 0 c) hEmp).elim _ _

  have hψ_add : ∀ (V : S.Etale) (f g : ↥(P_U.obj (Opposite.op V))),
      ψ_val V (f + g) = ψ_val V f + ψ_val V g := by
    intro V f g
    let O_pair : ULift.{u} (ZMod m) × ULift.{u} (ZMod m) → V.left.Opens :=
      fun p => O_lvl V f p.1 ⊓ O_lvl V g p.2
    let E_pair : ULift.{u} (ZMod m) × ULift.{u} (ZMod m) → S.Etale :=
      fun p => mkOpenEtale V (O_pair p)
    let ι_pair : ∀ p : ULift.{u} (ZMod m) × ULift.{u} (ZMod m), E_pair p ⟶ V :=
      fun p => mkOpenEtaleι V (O_pair p)
    have hCov_pair : CategoryTheory.Sieve.generate
        (CategoryTheory.Presieve.ofArrows E_pair ι_pair) ∈ J V := by
      rw [hMem_J]
      intro x
      let p : ULift.{u} (ZMod m) × ULift.{u} (ZMod m) := (f.1 x, g.1 x)
      refine ⟨E_pair p, ι_pair p, ⟨x, ⟨rfl, rfl⟩⟩, ?_, ?_, ?_⟩
      · exact ⟨E_pair p, 𝟙 _, ι_pair p, CategoryTheory.Presieve.ofArrows.mk p,
          CategoryTheory.Category.id_comp _⟩
      · change AlgebraicGeometry.Etale (O_pair p).ι
        infer_instance
      · exact AlgebraicGeometry.Scheme.Opens.ι_apply (O_pair p) ⟨x, ⟨rfl, rfl⟩⟩
    refine hSep_arrows ι_pair hCov_pair (fun ⟨c₁, c₂⟩ => ?_)
    rw [map_add]
    have hf_on : ∀ x : ↥(O_pair (c₁, c₂)), f.1 x.1 = c₁ := fun x => x.2.1
    have hg_on : ∀ x : ↥(O_pair (c₁, c₂)), g.1 x.1 = c₂ := fun x => x.2.2
    have hfg_on : ∀ x : ↥(O_pair (c₁, c₂)), (f + g).1 x.1 = c₁ + c₂ := by
      intro x
      change f.1 x.1 + g.1 x.1 = c₁ + c₂
      rw [hf_on x, hg_on x]
    by_cases h00 : c₁ = 0 ∧ c₂ = 0
    · rcases h00 with ⟨rfl, rfl⟩
      have hfg_0 : ∀ x : ↥(O_pair (0, 0)), (f + g).1 x.1 = 0 := by
        intro x
        simpa using hfg_on x
      change (LT.obj.map (mkOpenEtaleι V (O_pair (0, 0))).op) (ψ_val V (f + g)) =
        (LT.obj.map (mkOpenEtaleι V (O_pair (0, 0))).op) (ψ_val V f) +
        (LT.obj.map (mkOpenEtaleι V (O_pair (0, 0))).op) (ψ_val V g)
      rw [hRestrict_zero V (f + g) (O_pair (0, 0)) hfg_0,
        hRestrict_zero V f (O_pair (0, 0)) hf_on,
        hRestrict_zero V g (O_pair (0, 0)) hg_on,
        add_zero]
    · have hRange_p : Set.range ((O_pair (c₁, c₂)).ι ≫ V.hom).base ⊆ Set.range u_hom.base := by
        rintro _ ⟨x, rfl⟩
        have hcomp_x : ((O_pair (c₁, c₂)).ι ≫ V.hom).base x = (Fgt.obj V).hom x.1 := by
          have h1 := AlgebraicGeometry.Scheme.Hom.comp_apply (O_pair (c₁, c₂)).ι V.hom x
          have h2 : (O_pair (c₁, c₂)).ι.base x = x.1 :=
            AlgebraicGeometry.Scheme.Opens.ι_apply (O_pair (c₁, c₂)) x
          exact h1.trans (congrArg V.hom.base h2)
        rw [hcomp_x]
        change (Fgt.obj V).hom x.1 ∈ (V_open : Set ↥S)
        by_contra hx_not
        apply h00
        exact ⟨(hf_on x).symm.trans (f.2 x.1 hx_not),
          (hg_on x).symm.trans (g.2 x.1 hx_not)⟩
      let f_p : (O_pair (c₁, c₂)).toScheme ⟶ S := (O_pair (c₁, c₂)).ι ≫ V.hom
      let lift_p : (O_pair (c₁, c₂)).toScheme ⟶ U_et.left :=
        AlgebraicGeometry.IsOpenImmersion.lift u_hom f_p hRange_p
      let u_p : E_pair (c₁, c₂) ⟶ U_et :=
        CategoryTheory.MorphismProperty.Over.homMk lift_p
          (AlgebraicGeometry.IsOpenImmersion.lift_fac u_hom f_p hRange_p) trivial
      change (LT.obj.map (mkOpenEtaleι V (O_pair (c₁, c₂))).op) (ψ_val V (f + g)) =
        (LT.obj.map (mkOpenEtaleι V (O_pair (c₁, c₂))).op) (ψ_val V f) +
        (LT.obj.map (mkOpenEtaleι V (O_pair (c₁, c₂))).op) (ψ_val V g)
      rw [hRestrict_hom V (f + g) (O_pair (c₁, c₂)) (c₁ + c₂) u_p hfg_on,
        hRestrict_hom V f (O_pair (c₁, c₂)) c₁ u_p hf_on,
        hRestrict_hom V g (O_pair (c₁, c₂)) c₂ u_p hg_on,
        map_add η_fn c₁ c₂, map_add]

  have hψ_nat : ∀ {W V : S.Etale} (h : W ⟶ V) (f : ↥(P_U.obj (Opposite.op V))),
      (LT.obj.map h.op) (ψ_val V f) = ψ_val W ((P_U.map h.op) f) := by
    intro W V h f
    let f' := (P_U.map h.op) f
    refine hSep_arrows (ι_lvl W f') (hCov_lvl W f') (fun c => ?_)
    have hRange_hc : Set.range ((O_lvl W f' c).ι ≫ h.left).base ⊆
        Set.range (O_lvl V f c).ι.base := by
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have hcomp_x : ((O_lvl W f' c).ι ≫ h.left).base x = h.left.base x.1 := by
        have h1 := AlgebraicGeometry.Scheme.Hom.comp_apply (O_lvl W f' c).ι h.left x
        have h2 : (O_lvl W f' c).ι.base x = x.1 :=
          AlgebraicGeometry.Scheme.Opens.ι_apply (O_lvl W f' c) x
        exact h1.trans (congrArg h.left.base h2)
      rw [hcomp_x]
      exact (x.2 : f.1 (h.left.base x.1) = c)
    let lift_hc : (O_lvl W f' c).toScheme ⟶ (O_lvl V f c).toScheme :=
      AlgebraicGeometry.IsOpenImmersion.lift (O_lvl V f c).ι
        ((O_lvl W f' c).ι ≫ h.left) hRange_hc
    have hfac_hc : lift_hc ≫ (O_lvl V f c).ι = (O_lvl W f' c).ι ≫ h.left :=
      AlgebraicGeometry.IsOpenImmersion.lift_fac (O_lvl V f c).ι
        ((O_lvl W f' c).ι ≫ h.left) hRange_hc
    have hw_hc : lift_hc ≫ (E_lvl V f c).hom = (E_lvl W f' c).hom :=
      (CategoryTheory.Category.assoc lift_hc (O_lvl V f c).ι _).symm.trans
        ((congrArg (· ≫ (Fgt.obj V).hom) hfac_hc).trans
          ((CategoryTheory.Category.assoc (O_lvl W f' c).ι h.left _).trans
            (congrArg ((O_lvl W f' c).ι ≫ ·) (hw_et h))))
    let h_c : E_lvl W f' c ⟶ E_lvl V f c :=
      CategoryTheory.MorphismProperty.Over.homMk lift_hc hw_hc trivial
    have hcomm_hc : h_c ≫ ι_lvl V f c = ι_lvl W f' c ≫ h :=
      CategoryTheory.MorphismProperty.Over.Hom.ext hfac_hc
    have hLHS : (LT.obj.map (ι_lvl W f' c).op) ((LT.obj.map h.op) (ψ_val V f)) =
        (LT.obj.map h_c.op) (loc_sec V f c) := by
      calc
        (LT.obj.map (ι_lvl W f' c).op) ((LT.obj.map h.op) (ψ_val V f))
          = (LT.obj.map (ι_lvl W f' c ≫ h).op) (ψ_val V f) := by
              rw [op_comp, CategoryTheory.Functor.map_comp]
              rfl
        _ = (LT.obj.map (h_c ≫ ι_lvl V f c).op) (ψ_val V f) := by
              rw [hcomm_hc]
        _ = (LT.obj.map h_c.op) ((LT.obj.map (ι_lvl V f c).op) (ψ_val V f)) := by
              rw [op_comp, CategoryTheory.Functor.map_comp]
              rfl
        _ = (LT.obj.map h_c.op) (loc_sec V f c) := by rw [hψ_glue V f c]
    rw [hLHS, hψ_glue W f' c]
    by_cases hc : c = 0
    · subst hc
      simp only [loc_sec, ↓reduceDIte, map_zero]
    · simp only [loc_sec, hc, ↓reduceDIte]
      have hu_eq : h_c ≫ u_lvl V f c hc = u_lvl W f' c hc := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        apply (cancel_mono u_hom).mp
        have hw1 : (h_c ≫ u_lvl V f c hc).left ≫ u_hom = (Fgt.obj (E_lvl W f' c)).hom :=
          (Fgt.map (h_c ≫ u_lvl V f c hc)).w
        have hw2 : (u_lvl W f' c hc).left ≫ u_hom = (Fgt.obj (E_lvl W f' c)).hom :=
          (Fgt.map (u_lvl W f' c hc)).w
        exact hw1.trans hw2.symm
      rw [← hu_eq, op_comp, CategoryTheory.Functor.map_comp]
      rfl

  let Ψ_pre : P_U ⟶ LT.obj :=
    { app := fun V =>
        AddCommGrpCat.ofHom
          { toFun := ψ_val V.unop
            map_zero' := hψ_zero V.unop
            map_add' := hψ_add V.unop }
      naturality := fun _ _ h => AddCommGrpCat.ext fun f => (hψ_nat h.unop f).symm }

  let const_sec : ↥AM → ↥(P_U.obj (Opposite.op U_et)) :=
    fun c =>
      ⟨LocallyConstant.const ↥(Fgt.obj U_et).left c,
       fun x hx => False.elim (hx ⟨x, rfl⟩)⟩

  have hΨ_gen : ∀ c : ↥AM, ψ_val U_et (const_sec c) = η c := by
    intro c
    refine hSep_arrows (ι_lvl U_et (const_sec c)) (hCov_lvl U_et (const_sec c)) (fun c' => ?_)
    by_cases hc' : c' = c
    · subst hc'
      exact hRestrict_hom U_et (const_sec c') (O_lvl U_et (const_sec c') c') c'
        (ι_lvl U_et (const_sec c') c') (fun _ => rfl)
    · have hEmp : IsEmpty ↥(E_lvl U_et (const_sec c) c').left :=
        ⟨fun x => hc' (x.2 : (c : ULift.{u} (ZMod m)) = c').symm⟩
      exact (hEmpty_sub (E_lvl U_et (const_sec c) c') hEmp).elim _ _

  
  let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P_U, hSheaf⟩
  let φ₀ : AM ⟶ L_sh.obj.obj (Opposite.op U_et) :=
    AddCommGrpCat.ofHom
      { toFun := const_sec
        map_zero' := Subtype.ext (LocallyConstant.ext fun _ => rfl)
        map_add' := fun _ _ => Subtype.ext (LocallyConstant.ext fun _ => rfl) }
  let Φ : LT ⟶ L_sh := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm φ₀
  let Ψ : L_sh ⟶ LT := CategoryTheory.ObjectProperty.homMk Ψ_pre

  have hEquiv_comp :
      CategoryTheory.Sheaf.freeYonedaHomEquiv (Φ ≫ Ψ) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv Φ ≫ Ψ.hom.app (Opposite.op U_et) := by
    let Φ' : (CategoryTheory.presheafToSheaf J AddCommGrpCat.{u}).obj
        (CategoryTheory.Presheaf.freeYoneda U_et AM) ⟶ L_sh := Φ
    calc
      CategoryTheory.Presheaf.freeYonedaHomEquiv
          (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ LT)
            (Φ' ≫ Ψ))
        = CategoryTheory.Presheaf.freeYonedaHomEquiv
            (((CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}).homEquiv _ L_sh) Φ' ≫
              (CategoryTheory.sheafToPresheaf J AddCommGrpCat.{u}).map Ψ) := by
            rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv Φ ≫ Ψ.hom.app (Opposite.op U_et) :=
            CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ _

  have hΦΨ : Φ ≫ Ψ = CategoryTheory.CategoryStruct.id LT := by
    apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
    rw [hEquiv_comp]
    have hΦ_eq : CategoryTheory.Sheaf.freeYonedaHomEquiv Φ = φ₀ :=
      Equiv.apply_symm_apply _ _
    rw [hΦ_eq]
    exact AddCommGrpCat.ext fun c => hΨ_gen c

  
  let T_S : S.Etale := weilEtaleIdTerminal.{u} S
  let hT_S : CategoryTheory.Limits.IsTerminal T_S := weilEtaleIdTerminalIsTerminal.{u} S
  have hx₀_ex : ∃ x₀ : ↥S, x₀ ∉ Set.range U_et.hom.base := by
    by_contra! hall
    exact hNeUniv (Set.eq_univ_of_forall hall)
  obtain ⟨x₀, hx₀⟩ := hx₀_ex

  have hL_zero : ∀ f : ↥(L_sh.obj.obj (Opposite.op T_S)), f = 0 := by
    intro f
    have hf₀ : f.1 x₀ = 0 := f.2 x₀ hx₀
    have : PreconnectedSpace ↥(Fgt.obj T_S).left := (inferInstance : PreconnectedSpace ↥S)
    refine Subtype.ext (LocallyConstant.ext fun x => ?_)
    exact (f.1.isLocallyConstant.apply_eq_of_preconnectedSpace x x₀).trans hf₀

  have hSub_LT : Subsingleton ↥(LT.obj.obj (Opposite.op T_S)) := by
    refine ⟨fun s₁ s₂ => ?_⟩
    have hΦ_eq : (Φ.hom.app (Opposite.op T_S)) s₁ = (Φ.hom.app (Opposite.op T_S)) s₂ :=
      (hL_zero _).trans (hL_zero _).symm
    have h1 : (Ψ.hom.app (Opposite.op T_S)) ((Φ.hom.app (Opposite.op T_S)) s₁) = s₁ :=
      congrArg (fun (k : LT ⟶ LT) => (k.hom.app (Opposite.op T_S)) s₁) hΦΨ
    have h2 : (Ψ.hom.app (Opposite.op T_S)) ((Φ.hom.app (Opposite.op T_S)) s₂) = s₂ :=
      congrArg (fun (k : LT ⟶ LT) => (k.hom.app (Opposite.op T_S)) s₂) hΦΨ
    exact h1.symm.trans ((congrArg (Ψ.hom.app (Opposite.op T_S)) hΦ_eq).trans h2)

  let e_H : LT.H 0 ≃ (AddCommGrpCat.of (ULift.{u} ℤ) ⟶ LT.obj.obj (Opposite.op T_S)) :=
    CategoryTheory.Abelian.Ext.addEquiv₀.toEquiv.trans
      ((CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT_S).homEquiv
        (AddCommGrpCat.of (ULift.{u} ℤ)) LT)

  have hSub_Hom :
      Subsingleton (AddCommGrpCat.of (ULift.{u} ℤ) ⟶ LT.obj.obj (Opposite.op T_S)) :=
    ⟨fun α β => AddCommGrpCat.ext fun z => hSub_LT.elim (α z) (β z)⟩

  exact (Equiv.subsingleton_congr e_H).mpr hSub_Hom

theorem weil_etale_clopen_fibration_closedFiber_coproduct_vanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Y_bar V_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.IsProper V_bar.hom]
    (π_bar : Quiver.Hom Y_bar V_bar)
    (V : V_bar.left.Etale)
    [AlgebraicGeometry.IsAffine V.left]
    (Y_V : AlgebraicGeometry.Scheme.{u})
    (f_V : Quiver.Hom Y_V V.left)
    (g_Y : Quiver.Hom Y_V Y_bar.left)
    (hComm : CategoryTheory.CategoryStruct.comp g_Y π_bar.left =
      CategoryTheory.CategoryStruct.comp f_V V.hom)
    (hOpen_Y : AlgebraicGeometry.IsOpenImmersion (CategoryTheory.Limits.pullback.lift g_Y f_V hComm))
    (hClosed_Y : AlgebraicGeometry.IsClosedImmersion (CategoryTheory.Limits.pullback.lift g_Y f_V hComm))
    (W₁_open : Y_V.Opens)
    (W₂_et : Y_V.Etale)
    (u_rel : Quiver.Hom W₂_et (CategoryTheory.MorphismProperty.Over.mk ⊤ W₁_open.ι inferInstance))
    (W₂_Ybar W₁_Ybar : Y_bar.left.Etale)
    (u_Ybar : Quiver.Hom W₂_Ybar W₁_Ybar)
    (e₁ : CategoryTheory.Iso W₁_Ybar.left W₁_open.toScheme)
    (e₂ : CategoryTheory.Iso W₂_Ybar.left W₂_et.left)
    (he₁ : CategoryTheory.CategoryStruct.comp e₁.hom
      (CategoryTheory.CategoryStruct.comp W₁_open.ι g_Y) = W₁_Ybar.hom)
    (he₂ : CategoryTheory.CategoryStruct.comp e₂.hom
      (CategoryTheory.CategoryStruct.comp W₂_et.hom g_Y) = W₂_Ybar.hom)
    (hu_comm : CategoryTheory.CategoryStruct.comp e₂.hom u_rel.left =
      CategoryTheory.CategoryStruct.comp u_Ybar.left e₁.hom)
    (hFib_V :
      ∀ (s_v : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V.left),
        CategoryTheory.CategoryStruct.comp s_v
            (CategoryTheory.CategoryStruct.comp V.hom V_bar.hom) =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        let C_v := CategoryTheory.Limits.pullback f_V s_v
        let ι_v := CategoryTheory.Limits.pullback.fst f_V s_v
        ConnectedSpace ↥C_v ∧
        ((TopologicalSpace.Opens.map ι_v.base).obj W₁_open : Set ↥C_v) ≠ Set.univ ∧
        weilEtaleLocalTorsionMapH C_v ℓ ((weilEtaleSitePullback ι_v).map u_rel) 1 = 0) :
    ∀ (s_b : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) V_bar.left),
      CategoryTheory.CategoryStruct.comp s_b V_bar.hom =
        CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
      let Y_bar_b := CategoryTheory.Limits.pullback π_bar.left s_b
      let ι_b := CategoryTheory.Limits.pullback.fst π_bar.left s_b
      Subsingleton (weilEtaleLocalTorsionH Y_bar_b ℓ ((weilEtaleSitePullback ι_b).obj W₁_Ybar) 0) ∧
      weilEtaleLocalTorsionMapH Y_bar_b ℓ ((weilEtaleSitePullback ι_b).map u_Ybar) 1 = 0 :=
by
  classical
  intro s_b hs_b
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let Y_bar_b : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback π_bar.left s_b
  let ι_b : Y_bar_b ⟶ Y_bar.left := CategoryTheory.Limits.pullback.fst π_bar.left s_b
  let p_b : Y_bar_b ⟶ S_k := CategoryTheory.Limits.pullback.snd π_bar.left s_b
  change Subsingleton (weilEtaleLocalTorsionH Y_bar_b ℓ ((weilEtaleSitePullback ι_b).obj W₁_Ybar) 0) ∧
    weilEtaleLocalTorsionMapH Y_bar_b ℓ ((weilEtaleSitePullback ι_b).map u_Ybar) 1 = 0

  
  suffices hGen :
      ∀ (V_sch : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine V_sch]
        (v_hom : V_sch ⟶ V_bar.left)
        [AlgebraicGeometry.Etale v_hom]
        (f_V' : Y_V ⟶ V_sch)
        (hComm' : g_Y ≫ π_bar.left = f_V' ≫ v_hom),
        AlgebraicGeometry.IsOpenImmersion
          (CategoryTheory.Limits.pullback.lift g_Y f_V' hComm') →
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.Limits.pullback.lift g_Y f_V' hComm') →
        (∀ (s_v : S_k ⟶ V_sch),
          s_v ≫ (v_hom ≫ V_bar.hom) = 𝟙 S_k →
          let C_v := CategoryTheory.Limits.pullback f_V' s_v
          let ι_v := CategoryTheory.Limits.pullback.fst f_V' s_v
          ConnectedSpace ↥C_v ∧
          ((TopologicalSpace.Opens.map ι_v.base).obj W₁_open : Set ↥C_v) ≠ Set.univ ∧
          weilEtaleLocalTorsionMapH C_v ℓ ((weilEtaleSitePullback ι_v).map u_rel) 1 = 0) →
        Subsingleton
          (weilEtaleLocalTorsionH Y_bar_b ℓ ((weilEtaleSitePullback ι_b).obj W₁_Ybar) 0) ∧
        weilEtaleLocalTorsionMapH Y_bar_b ℓ ((weilEtaleSitePullback ι_b).map u_Ybar) 1 = 0 by
    have : AlgebraicGeometry.Etale (V.hom : V.left ⟶ V_bar.left) := V.prop
    exact hGen V.left V.hom f_V hComm hOpen_Y hClosed_Y hFib_V

  intro V_sch _ v_hom _ f_V hComm hOpen_Y hClosed_Y hFib_V

  
  have hClosed_comp : AlgebraicGeometry.IsClosedImmersion (s_b ≫ V_bar.hom) := by
    change AlgebraicGeometry.IsClosedImmersion (CategoryTheory.CategoryStruct.comp s_b V_bar.hom)
    rw [hs_b]
    infer_instance
  have : AlgebraicGeometry.IsClosedImmersion s_b :=
    @AlgebraicGeometry.IsClosedImmersion.of_comp _ _ _ s_b V_bar.hom hClosed_comp inferInstance
  let V_b : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback v_hom s_b
  let fst_Vb : V_b ⟶ V_sch := CategoryTheory.Limits.pullback.fst v_hom s_b
  let p_Vb : V_b ⟶ S_k := CategoryTheory.Limits.pullback.snd v_hom s_b
  have : AlgebraicGeometry.IsAffine V_b :=
    AlgebraicGeometry.isAffine_of_isAffineHom fst_Vb
  have : AlgebraicGeometry.Etale p_Vb := inferInstance
  obtain ⟨n_b, σ, hσ_sec, hσ_open, hσ_disj, hσ_cov⟩ :=
    weil_algClosed_affine_etale_spec_finite_open_split k V_b p_Vb

  
  let s_v : Fin n_b → (S_k ⟶ V_sch) := fun i => σ i ≫ fst_Vb
  have hs_vb : ∀ i : Fin n_b, s_v i ≫ v_hom = s_b := by
    intro i
    dsimp [s_v, fst_Vb]
    rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
      ← CategoryTheory.Category.assoc]
    have hsec_i : σ i ≫ p_Vb = 𝟙 S_k := hσ_sec i
    rw [hsec_i, CategoryTheory.Category.id_comp]
  have hs_v_sec : ∀ i : Fin n_b, s_v i ≫ (v_hom ≫ V_bar.hom) = 𝟙 S_k := by
    intro i
    rw [← CategoryTheory.Category.assoc, hs_vb i]
    exact hs_b

  let C_v : Fin n_b → AlgebraicGeometry.Scheme.{u} :=
    fun i => CategoryTheory.Limits.pullback f_V (s_v i)
  let ι_v : ∀ i : Fin n_b, C_v i ⟶ Y_V :=
    fun i => CategoryTheory.Limits.pullback.fst f_V (s_v i)
  let q_v : ∀ i : Fin n_b, C_v i ⟶ S_k :=
    fun i => CategoryTheory.Limits.pullback.snd f_V (s_v i)

  have hConn_Cv : ∀ i : Fin n_b, ConnectedSpace ↥(C_v i) :=
    fun i => (hFib_V (s_v i) (hs_v_sec i)).1
  have hNeUniv_Cv : ∀ i : Fin n_b,
      ((TopologicalSpace.Opens.map (ι_v i).base).obj W₁_open : Set ↥(C_v i)) ≠ Set.univ :=
    fun i => (hFib_V (s_v i) (hs_v_sec i)).2.1
  have hMapH_Cv : ∀ i : Fin n_b,
      weilEtaleLocalTorsionMapH (C_v i) ℓ ((weilEtaleSitePullback (ι_v i)).map u_rel) 1 = 0 :=
    fun i => (hFib_V (s_v i) (hs_v_sec i)).2.2

  have hκ_comm : ∀ i : Fin n_b, (ι_v i ≫ g_Y) ≫ π_bar.left = q_v i ≫ s_b := by
    intro i
    rw [CategoryTheory.Category.assoc, hComm, ← CategoryTheory.Category.assoc,
      CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc, hs_vb i]
  let κ : ∀ i : Fin n_b, C_v i ⟶ Y_bar_b :=
    fun i => CategoryTheory.Limits.pullback.lift (ι_v i ≫ g_Y) (q_v i) (hκ_comm i)

  let P_V : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback π_bar.left v_hom
  let fst_PV : P_V ⟶ Y_bar.left := CategoryTheory.Limits.pullback.fst π_bar.left v_hom
  let snd_PV : P_V ⟶ V_sch := CategoryTheory.Limits.pullback.snd π_bar.left v_hom
  let φ_clopen : Y_V ⟶ P_V := CategoryTheory.Limits.pullback.lift g_Y f_V hComm

  have hψ_comm : ∀ i : Fin n_b, ι_b ≫ π_bar.left = (p_b ≫ s_v i) ≫ v_hom := by
    intro i
    rw [CategoryTheory.Category.assoc, hs_vb i]
    exact CategoryTheory.Limits.pullback.condition
  let ψ_V : ∀ i : Fin n_b, Y_bar_b ⟶ P_V :=
    fun i => CategoryTheory.Limits.pullback.lift ι_b (p_b ≫ s_v i) (hψ_comm i)

  have hPb_ψ : ∀ i : Fin n_b, CategoryTheory.IsPullback (ψ_V i) p_b snd_PV (s_v i) := by
    intro i
    have hOuter : CategoryTheory.IsPullback (ψ_V i ≫ fst_PV) p_b π_bar.left (s_v i ≫ v_hom) := by
      rw [CategoryTheory.Limits.pullback.lift_fst, hs_vb i]
      exact CategoryTheory.IsPullback.of_hasPullback π_bar.left s_b
    exact CategoryTheory.IsPullback.of_right hOuter
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback π_bar.left v_hom)

  have hPb_κ : ∀ i : Fin n_b, CategoryTheory.IsPullback (ι_v i) (κ i) φ_clopen (ψ_V i) := by
    intro i
    have hOuter : CategoryTheory.IsPullback (κ i ≫ p_b) (ι_v i) (s_v i) (φ_clopen ≫ snd_PV) := by
      rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Limits.pullback.lift_snd]
      exact (CategoryTheory.IsPullback.of_hasPullback f_V (s_v i)).flip
    have hMid : κ i ≫ ψ_V i = ι_v i ≫ φ_clopen := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.condition]
    exact (CategoryTheory.IsPullback.of_right hOuter hMid (hPb_ψ i).flip).flip

  have hOpen_κ : ∀ i : Fin n_b, AlgebraicGeometry.IsOpenImmersion (κ i) :=
    fun i => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb_κ i) hOpen_Y
  have hClosed_κ : ∀ i : Fin n_b, AlgebraicGeometry.IsClosedImmersion (κ i) :=
    fun i => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hPb_κ i) hClosed_Y

  
  have hα_comm_sch :
      ∀ {W_Yb_sch W_YV_sch : AlgebraicGeometry.Scheme.{u}}
        (w_ybar : W_Yb_sch ⟶ Y_bar.left)
        (w_yv : W_YV_sch ⟶ Y_V)
        (e_W : W_Yb_sch ≅ W_YV_sch),
        e_W.hom ≫ (w_yv ≫ g_Y) = w_ybar →
        ∀ (i : Fin n_b),
          (CategoryTheory.Limits.pullback.fst w_yv (ι_v i) ≫ e_W.inv) ≫ w_ybar =
            (CategoryTheory.Limits.pullback.snd w_yv (ι_v i) ≫ κ i) ≫ ι_b := by
    intro W_Yb_sch W_YV_sch w_ybar w_yv e_W he_W i
    have he_inv : e_W.inv ≫ w_ybar = w_yv ≫ g_Y := by
      rw [← he_W, ← CategoryTheory.Category.assoc, e_W.inv_hom_id,
        CategoryTheory.Category.id_comp]
    calc
      (CategoryTheory.Limits.pullback.fst w_yv (ι_v i) ≫ e_W.inv) ≫ w_ybar
        = CategoryTheory.Limits.pullback.fst w_yv (ι_v i) ≫ (e_W.inv ≫ w_ybar) :=
          CategoryTheory.Category.assoc _ _ _
      _ = (CategoryTheory.Limits.pullback.fst w_yv (ι_v i) ≫ w_yv) ≫ g_Y := by
          rw [he_inv, CategoryTheory.Category.assoc]
      _ = CategoryTheory.Limits.pullback.snd w_yv (ι_v i) ≫ (ι_v i ≫ g_Y) := by
          rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
      _ = CategoryTheory.Limits.pullback.snd w_yv (ι_v i) ≫ (κ i ≫ ι_b) := by
          rw [CategoryTheory.Limits.pullback.lift_fst]
      _ = (CategoryTheory.Limits.pullback.snd w_yv (ι_v i) ≫ κ i) ≫ ι_b :=
          (CategoryTheory.Category.assoc _ _ _).symm

  let mk_α_sch :
      ∀ {W_Yb_sch W_YV_sch : AlgebraicGeometry.Scheme.{u}}
        (w_ybar : W_Yb_sch ⟶ Y_bar.left)
        (w_yv : W_YV_sch ⟶ Y_V)
        (e_W : W_Yb_sch ≅ W_YV_sch),
        e_W.hom ≫ (w_yv ≫ g_Y) = w_ybar →
        ∀ (i : Fin n_b),
          CategoryTheory.Limits.pullback w_yv (ι_v i) ⟶
            CategoryTheory.Limits.pullback w_ybar ι_b :=
    fun w_ybar w_yv e_W he_W i =>
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst w_yv (ι_v i) ≫ e_W.inv)
        (CategoryTheory.Limits.pullback.snd w_yv (ι_v i) ≫ κ i)
        (hα_comm_sch w_ybar w_yv e_W he_W i)

  have hPb_sheet_sch :
      ∀ {W_Yb_sch W_YV_sch : AlgebraicGeometry.Scheme.{u}}
        (w_ybar : W_Yb_sch ⟶ Y_bar.left)
        (w_yv : W_YV_sch ⟶ Y_V)
        (e_W : W_Yb_sch ≅ W_YV_sch)
        (he_W : e_W.hom ≫ (w_yv ≫ g_Y) = w_ybar),
        let α_s := mk_α_sch w_ybar w_yv e_W he_W
        (∀ i : Fin n_b, AlgebraicGeometry.IsOpenImmersion (α_s i)) ∧
        _root_.Pairwise (fun i j : Fin n_b =>
          Disjoint (Set.range (α_s i).base) (Set.range (α_s j).base)) ∧
        (⋃ i : Fin n_b, Set.range (α_s i).base) = Set.univ := by
    intro W_Yb_sch W_YV_sch w_ybar w_yv e_W he_W α_s
    let Z_sch : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback w_ybar ι_b
    let fst_Z : Z_sch ⟶ W_Yb_sch := CategoryTheory.Limits.pullback.fst w_ybar ι_b
    let snd_Z : Z_sch ⟶ Y_bar_b := CategoryTheory.Limits.pullback.snd w_ybar ι_b
    have hπZ_comm : (fst_Z ≫ e_W.hom ≫ w_yv ≫ f_V) ≫ v_hom = (snd_Z ≫ p_b) ≫ s_b := by
      calc
        (fst_Z ≫ e_W.hom ≫ w_yv ≫ f_V) ≫ v_hom
          = fst_Z ≫ e_W.hom ≫ w_yv ≫ (f_V ≫ v_hom) := by
              simp only [CategoryTheory.Category.assoc]
        _ = fst_Z ≫ (e_W.hom ≫ (w_yv ≫ g_Y)) ≫ π_bar.left := by
              rw [← hComm]
              simp only [CategoryTheory.Category.assoc]
        _ = (fst_Z ≫ w_ybar) ≫ π_bar.left := by
              rw [he_W, CategoryTheory.Category.assoc]
        _ = snd_Z ≫ (ι_b ≫ π_bar.left) := by
              rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
        _ = snd_Z ≫ (p_b ≫ s_b) := by
              rw [CategoryTheory.Limits.pullback.condition]
        _ = (snd_Z ≫ p_b) ≫ s_b := (CategoryTheory.Category.assoc _ _ _).symm
    let π_Z : Z_sch ⟶ V_b :=
      CategoryTheory.Limits.pullback.lift
        (fst_Z ≫ e_W.hom ≫ w_yv ≫ f_V) (snd_Z ≫ p_b) hπZ_comm

    let U_sch : Fin n_b → AlgebraicGeometry.Scheme.{u} :=
      fun i => CategoryTheory.Limits.pullback w_yv (ι_v i)
    let fst_U : ∀ i : Fin n_b, U_sch i ⟶ W_YV_sch :=
      fun i => CategoryTheory.Limits.pullback.fst w_yv (ι_v i)
    let snd_U : ∀ i : Fin n_b, U_sch i ⟶ C_v i :=
      fun i => CategoryTheory.Limits.pullback.snd w_yv (ι_v i)

    have hPb_α : ∀ i : Fin n_b,
        CategoryTheory.IsPullback (α_s i) (snd_U i ≫ q_v i) π_Z (σ i) := by
      intro i
      have hα_fst : α_s i ≫ fst_Z = fst_U i ≫ e_W.inv :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hα_snd : α_s i ≫ snd_Z = snd_U i ≫ κ i :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hsec_i : σ i ≫ p_Vb = 𝟙 S_k := hσ_sec i
      have hSq : α_s i ≫ π_Z = (snd_U i ≫ q_v i) ≫ σ i := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · calc
            (α_s i ≫ π_Z) ≫ fst_Vb
              = α_s i ≫ (π_Z ≫ fst_Vb) := CategoryTheory.Category.assoc _ _ _
            _ = (α_s i ≫ fst_Z) ≫ e_W.hom ≫ w_yv ≫ f_V := by
                  rw [CategoryTheory.Limits.pullback.lift_fst]
                  simp only [CategoryTheory.Category.assoc]
            _ = (fst_U i ≫ e_W.inv) ≫ e_W.hom ≫ w_yv ≫ f_V := by rw [hα_fst]
            _ = (fst_U i ≫ w_yv) ≫ f_V := by
                  simp only [CategoryTheory.Category.assoc]
                  rw [← CategoryTheory.Category.assoc e_W.inv, e_W.inv_hom_id,
                    CategoryTheory.Category.id_comp]
            _ = snd_U i ≫ (ι_v i ≫ f_V) := by
                  rw [CategoryTheory.Limits.pullback.condition, CategoryTheory.Category.assoc]
            _ = snd_U i ≫ (q_v i ≫ s_v i) := by
                  rw [CategoryTheory.Limits.pullback.condition]
            _ = ((snd_U i ≫ q_v i) ≫ σ i) ≫ fst_Vb := by
                  simp only [s_v, CategoryTheory.Category.assoc]
        · calc
            (α_s i ≫ π_Z) ≫ p_Vb
              = α_s i ≫ (π_Z ≫ p_Vb) := CategoryTheory.Category.assoc _ _ _
            _ = (α_s i ≫ snd_Z) ≫ p_b := by
                  rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc]
            _ = snd_U i ≫ (κ i ≫ p_b) := by
                  rw [hα_snd, CategoryTheory.Category.assoc]
            _ = (snd_U i ≫ q_v i) ≫ 𝟙 S_k := by
                  rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.comp_id]
            _ = (snd_U i ≫ q_v i) ≫ (σ i ≫ p_Vb) := by rw [hsec_i]
            _ = ((snd_U i ≫ q_v i) ≫ σ i) ≫ p_Vb :=
                  (CategoryTheory.Category.assoc _ _ _).symm

      have hC_comm : ∀ s : CategoryTheory.Limits.PullbackCone π_Z (σ i),
          (s.fst ≫ fst_Z ≫ e_W.hom ≫ w_yv) ≫ f_V = s.snd ≫ s_v i := by
        intro s
        calc
          (s.fst ≫ fst_Z ≫ e_W.hom ≫ w_yv) ≫ f_V
            = s.fst ≫ (π_Z ≫ fst_Vb) := by
                rw [CategoryTheory.Limits.pullback.lift_fst]
                simp only [CategoryTheory.Category.assoc]
          _ = (s.fst ≫ π_Z) ≫ fst_Vb := (CategoryTheory.Category.assoc _ _ _).symm
          _ = (s.snd ≫ σ i) ≫ fst_Vb := by rw [s.condition]
          _ = s.snd ≫ s_v i := CategoryTheory.Category.assoc _ _ _

      let lift_C : ∀ s : CategoryTheory.Limits.PullbackCone π_Z (σ i), s.pt ⟶ C_v i :=
        fun s => CategoryTheory.Limits.pullback.lift
          (s.fst ≫ fst_Z ≫ e_W.hom ≫ w_yv) s.snd (hC_comm s)

      have hlift_U_comm : ∀ s : CategoryTheory.Limits.PullbackCone π_Z (σ i),
          (s.fst ≫ fst_Z ≫ e_W.hom) ≫ w_yv = lift_C s ≫ ι_v i := by
        intro s
        rw [CategoryTheory.Limits.pullback.lift_fst]
        simp only [CategoryTheory.Category.assoc]

      let lift_U : ∀ s : CategoryTheory.Limits.PullbackCone π_Z (σ i), s.pt ⟶ U_sch i :=
        fun s => CategoryTheory.Limits.pullback.lift
          (s.fst ≫ fst_Z ≫ e_W.hom) (lift_C s) (hlift_U_comm s)

      have hlift_fst_U : ∀ s : CategoryTheory.Limits.PullbackCone π_Z (σ i),
          lift_U s ≫ fst_U i = s.fst ≫ fst_Z ≫ e_W.hom :=
        fun s => CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hlift_snd_U : ∀ s : CategoryTheory.Limits.PullbackCone π_Z (σ i),
          lift_U s ≫ snd_U i = lift_C s :=
        fun s => CategoryTheory.Limits.pullback.lift_snd _ _ _

      refine CategoryTheory.IsPullback.of_isLimit
        (CategoryTheory.Limits.PullbackCone.IsLimit.mk hSq lift_U
          (fun s => by
            apply CategoryTheory.Limits.pullback.hom_ext
            · calc
                (lift_U s ≫ α_s i) ≫ fst_Z
                  = lift_U s ≫ (α_s i ≫ fst_Z) := CategoryTheory.Category.assoc _ _ _
                _ = (lift_U s ≫ fst_U i) ≫ e_W.inv := by
                      rw [hα_fst, CategoryTheory.Category.assoc]
                _ = (s.fst ≫ fst_Z ≫ e_W.hom) ≫ e_W.inv := by rw [hlift_fst_U s]
                _ = s.fst ≫ fst_Z := by
                      simp only [CategoryTheory.Category.assoc, e_W.hom_inv_id,
                        CategoryTheory.Category.comp_id]
            · have hh_C_κ : lift_C s ≫ κ i = s.fst ≫ snd_Z := by
                apply CategoryTheory.Limits.pullback.hom_ext
                · calc
