                    ((CategoryTheory.Category.assoc eB.hom eB.inv δ₂).symm.trans
                      ((congrArg (· ≫ δ₂) eB.hom_inv_id).trans
                        ((CategoryTheory.Category.id_comp δ₂).trans
                          (CategoryTheory.Category.comp_id δ₂).symm)))))))
        inv_hom_id :=
          (CategoryTheory.cancel_epi δ₁).mp
            ((CategoryTheory.Category.assoc δ₁ φ₁₂ φ₂₁).symm.trans
              ((congrArg (· ≫ φ₂₁) (hEx₁.g_desc (eB.inv ≫ δ₂) hz₁)).trans
                ((CategoryTheory.Category.assoc eB.inv δ₂ φ₂₁).trans
                  ((congrArg (eB.inv ≫ ·) (hEx₂.g_desc (eB.hom ≫ δ₁) hz₂)).trans
                    ((CategoryTheory.Category.assoc eB.inv eB.hom δ₁).symm.trans
                      ((congrArg (· ≫ δ₁) eB.inv_hom_id).trans
                        ((CategoryTheory.Category.id_comp δ₁).trans
                          (CategoryTheory.Category.comp_id δ₁).symm))))))) }
    obtain ⟨e_R1_fin⟩ :=
      ((weil_etale_higherDirectImage_shortExact_calculus f₁.left).1 (pf_ν.obj F₂) F₁ 1).1
        ⟨e_fin.symm⟩
