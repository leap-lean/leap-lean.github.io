           CategoryTheory.CategoryStruct.comp (pb_h.map (δ_L_of ν₂ ρ₂ hρ₂_over hρ₂_act)) β_Q =
             CategoryTheory.CategoryStruct.comp β_L (δ_L_of ν₁ ρ₁ hρ₁_over hρ₁_act)) ∧
      (∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
         (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
         (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
         (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
           ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b))
         (s : Quiver.Hom S Z_S)
         (hs : CategoryTheory.CategoryStruct.comp s ν_S = CategoryTheory.CategoryStruct.id S),
         (let W := CategoryTheory.Limits.pullback (CategoryTheory.CategoryStruct.id S) ν_S
          let ι : ZMod ℓ → Quiver.Hom S W :=
            fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id S)
              (CategoryTheory.CategoryStruct.comp s (ρ_S a))
              ((CategoryTheory.Category.id_comp _).trans
                (hs.symm.trans
                  ((congrArg (CategoryTheory.CategoryStruct.comp s) (hρ_over a)).symm.trans
                    (CategoryTheory.Category.assoc s (ρ_S a) ν_S).symm)))
          let ρ_W : ZMod ℓ → Quiver.Hom W W :=
            fun b => CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst (CategoryTheory.CategoryStruct.id S) ν_S)
              (CategoryTheory.CategoryStruct.comp
                (CategoryTheory.Limits.pullback.snd (CategoryTheory.CategoryStruct.id S) ν_S) (ρ_S b))
              (CategoryTheory.Limits.pullback.condition.trans
                ((congrArg (CategoryTheory.CategoryStruct.comp _) (hρ_over b)).symm.trans
                  (CategoryTheory.Category.assoc _ (ρ_S b) ν_S).symm))
          (∀ a : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (ι a)) ∧
          (_root_.Pairwise fun a b : ZMod ℓ =>
            Disjoint (Set.range (ι a).base) (Set.range (ι b).base)) ∧
          (⋃ a : ZMod ℓ, Set.range (ι a).base) = Set.univ ∧
          (∀ a b : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ι a) (ρ_W b) = ι (a + b))) →
         let T_S := weilEtaleIdTerminal.{u} S
         ∃ f_split : ↑((P_of ν_S).obj.obj (Opposite.op T_S)),
           ((τ_of ν_S ρ_S hρ_over hρ_act).hom.app (Opposite.op T_S)).hom f_split =
             ((δ_L_of ν_S ρ_S hρ_over hρ_act).hom.app (Opposite.op T_S)).hom
               ((weilAltLocConstConstHom S T_S ℓ).hom (ULift.up (1 : ZMod ℓ)))) ∧
      (∀ {S Z_S : AlgebraicGeometry.Scheme.{u}} (ν_S : Quiver.Hom Z_S S)
         (ρ_S : ZMod ℓ → Quiver.Hom Z_S Z_S)
         (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ_S a) ν_S = ν_S)
         (hρ_act : ρ_S 0 = CategoryTheory.CategoryStruct.id Z_S ∧
           ∀ a b : ZMod ℓ, ρ_S (a + b) = CategoryTheory.CategoryStruct.comp (ρ_S a) (ρ_S b)),
         ConnectedSpace ↥Z_S →
         let T_S := weilEtaleIdTerminal.{u} S
         let one_Q := ((δ_L_of ν_S ρ_S hρ_over hρ_act).hom.app (Opposite.op T_S)).hom
           ((weilAltLocConstConstHom S T_S ℓ).hom (ULift.up (1 : ZMod ℓ)))
         (∀ f₀ : ↑((P_of ν_S).obj.obj (Opposite.op T_S)),
           ((τ_of ν_S ρ_S hρ_over hρ_act).hom.app (Opposite.op T_S)).hom f₀ ≠ one_Q) ∧
         (∀ q₀ : ↑((Q_of ν_S ρ_S hρ_over hρ_act).obj.obj (Opposite.op T_S)),
