  haveI : AlgebraicGeometry.IsSeparated ψ_Q :=
    CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.IsSeparated) (W' := ⊤)
      ψ_Q (CategoryTheory.Limits.pullback.snd f_W₁ g_VP) trivial hSep_Qf
  haveI : AlgebraicGeometry.IsProper ((P.e_W.hom ≫ j_WQ) ≫ ψ_Q) := by
