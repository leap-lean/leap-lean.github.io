  have hSieveId : ∀ (i : Fin n) (R_s : CategoryTheory.Sieve (E i)),
      R_s ∈ J (E i) → R_s.arrows (𝟙 (E i)) := by
    intro i R_s hR_s
    obtain ⟨𝒰, hOver, hP, hle⟩ :=
      (AlgebraicGeometry.Scheme.mem_smallGrothendieckTopology (E i) R_s).mp hR_s
    letI := hOver
    letI : ∀ j : 𝒰.I₀, (𝒰.X j).Over Z := hOver.over
    haveI : ∀ j : 𝒰.I₀, AlgebraicGeometry.Scheme.Hom.IsOver (𝒰.f j) Z := hOver.isOver_map
    obtain ⟨x₀⟩ := hNEO i
    let j := 𝒰.idx x₀
    obtain ⟨y₀, _⟩ := 𝒰.covers x₀
    obtain ⟨g_sec, hg_sec⟩ := @hLift i (𝒰.X j) ⟨y₀⟩ (𝒰.f j) (𝒰.map_prop j)
    let W_j : Z.Etale := (𝒰.X j).asOverProp Z (hP j)
    let w_j : W_j ⟶ E i := AlgebraicGeometry.Scheme.Hom.asOverProp (𝒰.f j) Z
    have hw_mem : R_s.arrows w_j := hle W_j w_j ⟨j⟩
    have hover_j : 𝒰.f j ≫ (E i).hom = W_j.hom := (hOver.isOver_map j).comp_over
    have hg_over : g_sec ≫ W_j.hom = (E i).hom :=
      (congrArg (fun m => g_sec ≫ m) hover_j.symm).trans
        ((CategoryTheory.Category.assoc g_sec (𝒰.f j) (E i).hom).symm.trans
