            rw [hsum_eq, hnsmul_mod]
            congr 2
            push_cast
            simp only [ZMod.natCast_zmod_val]
            dsimp [g₂_pair, Matrix.mulVec, dotProduct]
            exact Finset.sum_congr rfl fun a _ => mul_comm _ _
          rw [hcup_val] at hcup0
          let c_b : ZMod ℓ := (G₂.transpose.mulVec μ) b_idx
          have hinv_smul : (c_b⁻¹.val * c_b.val) • α_η = 0 := by
            rw [mul_nsmul', hcup0, smul_zero]
