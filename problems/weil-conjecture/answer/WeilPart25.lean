      exact CategoryTheory.IsPullback.of_hasPullback E.f_bar₁ g_V₂_sch
    exact CategoryTheory.IsPullback.of_right hPb_outer
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback E.f_bar₁ g_VP)
  have hPb_ν₂_flip : CategoryTheory.IsPullback ν₂ p₂_Y ψ_base φ_rel := by
    have hPb_outer2 : CategoryTheory.IsPullback (ν₂ ≫ f₁_V₂) p₂_Y
        h₂_sch (φ_rel ≫ CategoryTheory.Limits.pullback.snd E.f_bar₁ g_VP) := by
      rw [hν₂_f, CategoryTheory.Limits.pullback.lift_snd]
