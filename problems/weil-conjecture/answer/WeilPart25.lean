theorem weil_etale_pointed_epi_basis_lift_and_split_pullback (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (δ m₀ b₁ : ℕ)
    (U₁ : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsAffine U₁]
    (p_U₁ : Quiver.Hom U₁ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType p_U₁]
    (u_U₁ : Quiver.Hom U₁ (weilAffineSpaceOver k δ).left)
    [AlgebraicGeometry.Etale u_U₁]
    (u₁ : ↥U₁) (hu₁ : IsClosed ({u₁} : Set ↥U₁))
    (ℱ : CategoryTheory.Sheaf U₁.smallEtaleTopology AddCommGrpCat.{u})
    (hℱ_tor : ℓ • CategoryTheory.CategoryStruct.id ℱ = 0)
    (ι₀ : Quiver.Hom
      ((CategoryTheory.constantSheaf U₁.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin m₀ → ZMod ℓ))))
      ℱ)
    (π' : Quiver.Hom ℱ
      ((CategoryTheory.constantSheaf U₁.smallEtaleTopology AddCommGrpCat.{u}).obj
        (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin b₁ → ZMod ℓ)))))
    (hzero : CategoryTheory.CategoryStruct.comp ι₀ π' = 0)
    (hSE : (CategoryTheory.ShortComplex.mk ι₀ π' hzero).ShortExact) :
    ∃ (V'_sch : AlgebraicGeometry.Scheme.{u})
      (_ : AlgebraicGeometry.IsAffine V'_sch)
      (_ : ConnectedSpace ↥V'_sch)
      (h₁ : Quiver.Hom V'_sch U₁)
      (v' : ↥V'_sch),
      AlgebraicGeometry.Etale h₁ ∧
      IsClosed ({v'} : Set ↥V'_sch) ∧
      h₁.base v' = u₁ ∧
      ∀ (V''_sch : AlgebraicGeometry.Scheme.{u})
        (q : Quiver.Hom V''_sch V'_sch)
        (hc : (weilEtaleSitePullback (CategoryTheory.CategoryStruct.comp q h₁)).IsContinuous
          U₁.smallEtaleTopology V''_sch.smallEtaleTopology)
        (hr : ((weilEtaleSitePullback (CategoryTheory.CategoryStruct.comp q h₁)).sheafPushforwardContinuous
          AddCommGrpCat.{u} U₁.smallEtaleTopology V''_sch.smallEtaleTopology).IsRightAdjoint),
        Nonempty (CategoryTheory.Iso
          ((CategoryTheory.constantSheaf V''_sch.smallEtaleTopology AddCommGrpCat.{u}).obj
            (AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin (m₀ + b₁) → ZMod ℓ))))
          ((@CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback (CategoryTheory.CategoryStruct.comp q h₁)) AddCommGrpCat.{u} _
            U₁.smallEtaleTopology V''_sch.smallEtaleTopology hc hr).obj ℱ)) :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  let _ : NeZero ℓ := ⟨hPrime.ne_zero⟩
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  let _ : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)

  obtain ⟨hSitePkg, -⟩ := weil_etale_site_pullback_exact_and_mod_prime_resolution.{u} ℓ
  obtain ⟨-, -, hProp_const, -⟩ :=
    weil_etale_proper_h0_finite_and_localTorsion_pullback_iso k ℓ
  have hPtPull := (weil_algClosed_affine_closed_point_section_and_pullback_lift k).2.2.2
  have hDom := (weil_algClosed_smooth_etale_local_domain_and_connected_integral k).1

  let J_U := U₁.smallEtaleTopology
  let C_U := CategoryTheory.constantSheaf J_U AddCommGrpCat.{u}
  let T_U : U₁.Etale := weilEtaleIdTerminal.{u} U₁
  let hT_U := weilEtaleIdTerminalIsTerminal.{u} U₁
  let adj_U := CategoryTheory.constantSheafAdj J_U AddCommGrpCat.{u} hT_U
  let A₀ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin m₀ → ZMod ℓ))
  let A₁ := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin b₁ → ZMod ℓ))
  let A_tot := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (Fin (m₀ + b₁) → ZMod ℓ))
  let G_sheaf := C_U.obj A₁
  let e_std : Fin b₁ → ↥A₁ := fun i => ULift.up (Pi.single i (1 : ZMod ℓ))

  
  have : CategoryTheory.Epi π' := hSE.epi_g
