      haveI : (weilEtaleSitePullback ν_X).IsContinuous X.smallEtaleTopology Z_X.smallEtaleTopology :=
        hc_all ν_X
      haveI : ((weilEtaleSitePullback ν_X).sheafPushforwardContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology Z_X.smallEtaleTopology).IsRightAdjoint := hr_all ν_X
      let B_ν := weilEtaleSitePullback ν_X
      let pf_ν := B_ν.sheafPushforwardContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology Z_X.smallEtaleTopology
      let pb_ν := B_ν.sheafPullback AddCommGrpCat.{u}
        X.smallEtaleTopology Z_X.smallEtaleTopology
      let adj_ν := B_ν.sheafAdjunctionContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology Z_X.smallEtaleTopology
      let πM₀ := weilEtaleConstPullbackHom ν_X
        (weilEtaleIdTerminalIsTerminal.{u} Z_X) (weilEtaleIdTerminalIsTerminal.{u} X) AM
      let η_M : Quiver.Hom (weilEtaleTorsionSheaf X ℓ) (pf_ν.obj (weilEtaleTorsionSheaf Z_X ℓ)) :=
        (adj_ν.homEquiv (weilEtaleTorsionSheaf X ℓ) (weilEtaleTorsionSheaf Z_X ℓ)) πM₀
      have hη_Δ :
          CategoryTheory.CategoryStruct.comp η_M (pf_ν.map (e_loc Z_X).hom) =
            CategoryTheory.CategoryStruct.comp (e_loc X).hom (Δ_of ν_X) := by
        have hpull_ν := hPull_loc ν_X
          (weilEtaleIdTerminalIsTerminal.{u} Z_X) (weilEtaleIdTerminalIsTerminal.{u} X)
        let β_L_ν : Quiver.Hom (pb_ν.obj (L_of X)) (L_of Z_X) :=
          (adj_ν.homEquiv (L_of X) (L_of Z_X)).symm { hom := weilAltLocConstPullbackNat ν_X ℓ }
        have h1 := congrArg (adj_ν.homEquiv (weilEtaleTorsionSheaf X ℓ) (L_of Z_X)) hpull_ν
        change (adj_ν.homEquiv (weilEtaleTorsionSheaf X ℓ) (L_of Z_X))
            (CategoryTheory.CategoryStruct.comp (pb_ν.map (e_loc X).hom) β_L_ν) =
          (adj_ν.homEquiv (weilEtaleTorsionSheaf X ℓ) (L_of Z_X))
            (CategoryTheory.CategoryStruct.comp πM₀ (e_loc Z_X).hom) at h1
        rw [CategoryTheory.Adjunction.homEquiv_naturality_left,
          CategoryTheory.Adjunction.homEquiv_naturality_right] at h1
        dsimp [β_L_ν] at h1
        rw [(adj_ν.homEquiv (L_of X) (L_of Z_X)).apply_symm_apply] at h1
        exact h1.symm
      have hw_Δ_zero :
          (w.comp (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).hom) (Nat.add_zero 1)).comp
            (CategoryTheory.Abelian.Ext.mk₀ (Δ_of ν_X)) (Nat.add_zero 1) = 0 := by
        rw [CategoryTheory.Abelian.Ext.comp_assoc w
          (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).hom)
          (CategoryTheory.Abelian.Ext.mk₀ (Δ_of ν_X))
          (Nat.add_zero 1) (Nat.add_zero 0) rfl,
          CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← hη_Δ,
          ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
          ← CategoryTheory.Abelian.Ext.comp_assoc w
            (CategoryTheory.Abelian.Ext.mk₀ η_M)
            (CategoryTheory.Abelian.Ext.mk₀ (pf_ν.map (e_loc Z_X).hom))
            (Nat.add_zero 1) (Nat.add_zero 0) rfl]
        change (w.comp (CategoryTheory.Abelian.Ext.mk₀ η_M) (Nat.add_zero 1)).comp
          (CategoryTheory.Abelian.Ext.mk₀ (pf_ν.map (e_loc Z_X).hom)) (Nat.add_zero 1) = 0
        rw [hw_ker, CategoryTheory.Abelian.Ext.zero_comp]
      obtain ⟨x₀, hx₀⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ (Fℤ_of X) hSE_X
          (w.comp (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).hom) (Nat.add_zero 1))
          hw_Δ_zero (Nat.zero_add 1)
      let ψ : Quiver.Hom (Fℤ_of X) (Q_of ν_X ρ_X hρ_X_over hρ_X_act) :=
        CategoryTheory.Abelian.Ext.addEquiv₀ x₀
      have hψ_ext :
          (CategoryTheory.Abelian.Ext.mk₀ ψ).comp hSE_X.extClass (Nat.zero_add 1) =
            w.comp (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).hom) (Nat.add_zero 1) := by
        have hmk : CategoryTheory.Abelian.Ext.mk₀ ψ = x₀ :=
          CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x₀
        rw [hmk]
        exact hx₀
      let T_X := weilEtaleIdTerminal.{u} X
      let adj_X := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u}
        (weilEtaleIdTerminalIsTerminal.{u} X)
      let q₀ : ↑((Q_of ν_X ρ_X hρ_X_over hρ_X_act).obj.obj (Opposite.op T_X)) :=
        (CategoryTheory.CategoryStruct.comp (adj_X.unit.app Aℤ)
          (ψ.hom.app (Opposite.op T_X))).hom (ULift.up (1 : ℤ))
      obtain ⟨c, hc⟩ := hOneDim_X q₀
      have hψ_eq : ψ = c.val • δ_const_of ν_X ρ_X hρ_X_over hρ_X_act := by
        apply hFℤ_hom_eq X
        change q₀ = (CategoryTheory.CategoryStruct.comp (adj_X.unit.app Aℤ)
          ((c.val • δ_const_of ν_X ρ_X hρ_X_over hρ_X_act).hom.app (Opposite.op T_X))).hom
          (ULift.up (1 : ℤ))
        have h_smul_app :
            (c.val • δ_const_of ν_X ρ_X hρ_X_over hρ_X_act).hom.app (Opposite.op T_X) =
              c.val • (δ_const_of ν_X ρ_X hρ_X_over hρ_X_act).hom.app (Opposite.op T_X) := rfl
        rw [h_smul_app, CategoryTheory.Preadditive.comp_nsmul]
        change q₀ = c.val •
          (CategoryTheory.CategoryStruct.comp (adj_X.unit.app Aℤ)
            ((δ_const_of ν_X ρ_X hρ_X_over hρ_X_act).hom.app (Opposite.op T_X))).hom
            (ULift.up (1 : ℤ))
        rw [hδ_const_eval ν_X ρ_X hρ_X_over hρ_X_act]
        exact hc
      refine ⟨c, ?_⟩
      calc
        w = (w.comp (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).hom) (Nat.add_zero 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).inv) (Nat.add_zero 1) := by
              rw [CategoryTheory.Abelian.Ext.comp_assoc w
                (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).hom)
                (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).inv)
                (Nat.add_zero 1) (Nat.add_zero 0) rfl,
                CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
                (e_loc X).hom_inv_id,
                CategoryTheory.Abelian.Ext.comp_mk₀_id]
        _ = ((CategoryTheory.Abelian.Ext.mk₀ ψ).comp hSE_X.extClass (Nat.zero_add 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).inv) (Nat.add_zero 1) := by
              rw [hψ_ext]
        _ = ((c.val • CategoryTheory.Abelian.Ext.mk₀ (δ_const_of ν_X ρ_X hρ_X_over hρ_X_act)).comp
              hSE_X.extClass (Nat.zero_add 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (e_loc X).inv) (Nat.add_zero 1) := by
              rw [hψ_eq, hmk₀_nsmul]
        _ = c.val • γ_X := by
              dsimp [γ_X, γ_of]
              rw [hnsmul_comp_ext, hnsmul_comp_ext]

theorem weil_rel_curve_zariski_kummer_cover_extension_and_nonvanishing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (B_sp : Type u) [CommRing B_sp] [IsDomain B_sp] [Algebra k B_sp] [Algebra.FiniteType k B_sp]
    (hDed_sp : IsDedekindDomain B_sp)
    (τ_sp : B_sp →ₐ[k] k)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (ι_sp_Ω : B_sp →+* Ω)
    (hInj_sp_Ω : Function.Injective ι_sp_Ω)
    (Y_sp : AlgebraicGeometry.Scheme.{u})
    (f_sp : Quiver.Hom Y_sp (AlgebraicGeometry.Spec (CommRingCat.of B_sp)))
    [AlgebraicGeometry.IsProper f_sp]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_sp]
    (τ_sec : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of B_sp)) Y_sp)
    (hτ_sec : CategoryTheory.CategoryStruct.comp τ_sec f_sp =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of B_sp)))
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hInt_C₀ : AlgebraicGeometry.IsIntegral C₀.left)
    (hProj_C₀ : IsProjectiveOverField k C₀)
    (ι₀_sp : Quiver.Hom C₀.left Y_sp)
    (hPb_c₀_sp : CategoryTheory.IsPullback ι₀_sp C₀.hom f_sp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_sp.toRingHom)))
    (Y_η : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsIntegral Y_η]
    (ι_η_sp : Quiver.Hom Y_η Y_sp)
    (f_η : Quiver.Hom Y_η (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
    (hProj_Yη : IsProjectiveOverField Ω (CategoryTheory.Over.mk f_η))
    (hPb_η_sp : CategoryTheory.IsPullback ι_η_sp f_η f_sp
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_sp_Ω)))
    (N_cov : ℕ) (hN_cov : 1 ≤ N_cov)
    (W_sp : Fin N_cov → Y_sp.Opens)
    (hW_sp_top : (⨆ α : Fin N_cov, W_sp α) = ⊤)
    (hW_sp_aff : ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (W_sp α))
    (u_sp : ∀ α : Fin N_cov, Units ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α))))
    (g_sp : ∀ α β : Fin N_cov, Units ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α ⊓ W_sp β))))
    (hg_sp_diag : ∀ α : Fin N_cov, (g_sp α α).1 = 1)
    (hg_sp_cocycle : ∀ α β γ : Fin N_cov,
      (Y_sp.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
            (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp α ⊓ W_sp β)).op).hom (g_sp α β).1 *
      (Y_sp.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.2, hx.2⟩ :
            (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp β ⊓ W_sp γ)).op).hom (g_sp β γ).1 =
      (Y_sp.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.2⟩ :
            (W_sp α ⊓ W_sp β) ⊓ W_sp γ ≤ W_sp α ⊓ W_sp γ)).op).hom (g_sp α γ).1)
    (hu_sp_trans : ∀ α β : Fin N_cov,
      ((g_sp α β).1 ^ ℓ) *
        (Y_sp.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u_sp β).1 =
      (Y_sp.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u_sp α).1)
    (hu_sp_no_root :
      letI : IrreducibleSpace ↥Y_η :=
        AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_η
      ∀ (α : Fin N_cov),
        let V_α := (TopologicalSpace.Opens.map ι_η_sp.base).obj (W_sp α)
        ∀ [Nonempty ↥(V_α : AlgebraicGeometry.Scheme.{u})] (b : ↑Y_η.functionField),
          b ^ ℓ ≠ (Y_η.germToFunctionField V_α).hom ((ι_η_sp.app (W_sp α)).hom (u_sp α).1)) :
    ∃ (Z_η : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)))
      (_ : AlgebraicGeometry.IsIntegral Z_η.left)
      (_ : IsProjectiveOverField Ω Z_η)
      (_ : AlgebraicGeometry.IsProper Z_η.hom)
      (_ : AlgebraicGeometry.SmoothOfRelativeDimension 1 Z_η.hom)
      (ν_η : Quiver.Hom Z_η.left Y_η)
      (_ : CategoryTheory.CategoryStruct.comp ν_η f_η = Z_η.hom)
      (_ : AlgebraicGeometry.IsFinite ν_η)
      (_ : AlgebraicGeometry.Surjective ν_η)
      (γ_sp : weilEtaleTorsionH Y_sp ℓ 1),
      (∀ α : Fin N_cov,
        let V_α := (TopologicalSpace.Opens.map ι_η_sp.base).obj (W_sp α)
        ∃ x_α : ↑(Z_η.left.presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map ν_η.base).obj V_α))),
          x_α ^ ℓ = (ν_η.app V_α).hom ((ι_η_sp.app (W_sp α)).hom (u_sp α).1)) ∧
      (∀ (p₀_sp : weilEtaleTorsionH Y_sp ℓ 1 →+ weilEtaleTorsionH C₀.left ℓ 1),
        WeilIsTorsionEtalePullback ι₀_sp ℓ 1 p₀_sp →
        p₀_sp γ_sp ≠ 0) ∧
      (∀ (p_η_sp : weilEtaleTorsionH Y_sp ℓ 1 →+ weilEtaleTorsionH Y_η ℓ 1)
         (p_ν : weilEtaleTorsionH Y_η ℓ 1 →+ weilEtaleTorsionH Z_η.left ℓ 1),
        WeilIsTorsionEtalePullback ι_η_sp ℓ 1 p_η_sp →
        WeilIsTorsionEtalePullback ν_η ℓ 1 p_ν →
        p_ν (p_η_sp γ_sp) = 0 ∧
        ∀ w : weilEtaleTorsionH Y_η ℓ 1,
          p_ν w = 0 →
          ∃ c : ZMod ℓ, w = c.val • (p_η_sp γ_sp)) :=
by
  obtain ⟨Z_sp, ν_Z, hFin_νZ, hEt_νZ, hSurj_νZ, ρ, hρ_over, hρ_act, hρ_part, hx_sp, he_sp⟩ :=
    weil_zariski_kummer_cocycle_torsor_gluing k ℓ hℓ B_sp Y_sp f_sp
      N_cov hN_cov W_sp hW_sp_top hW_sp_aff u_sp g_sp hg_sp_diag hg_sp_cocycle hu_sp_trans
  letI : AlgebraicGeometry.IsFinite ν_Z := hFin_νZ
  letI : AlgebraicGeometry.Etale ν_Z := hEt_νZ
  letI : AlgebraicGeometry.Surjective ν_Z := hSurj_νZ

  let Z_η_sch : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback ν_Z ι_η_sp
  let ι_Z_η : Z_η_sch ⟶ Z_sp := CategoryTheory.Limits.pullback.fst ν_Z ι_η_sp
  let ν_η : Z_η_sch ⟶ Y_η := CategoryTheory.Limits.pullback.snd ν_Z ι_η_sp
  let Z_η : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω)) :=
    CategoryTheory.Over.mk (ν_η ≫ f_η)

  have hPb_Zη : CategoryTheory.IsPullback ι_Z_η ν_η ν_Z ι_η_sp :=
    CategoryTheory.IsPullback.of_hasPullback ν_Z ι_η_sp
  have hFin_νη : AlgebraicGeometry.IsFinite ν_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Zη inferInstance
  have hEt_νη : AlgebraicGeometry.Etale ν_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Zη inferInstance
  have hSurj_νη : AlgebraicGeometry.Surjective ν_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_Zη inferInstance
  letI : AlgebraicGeometry.IsFinite ν_η := hFin_νη
  letI : AlgebraicGeometry.Etale ν_η := hEt_νη
  letI : AlgebraicGeometry.Surjective ν_η := hSurj_νη

  have hProp_fη : AlgebraicGeometry.IsProper f_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η_sp inferInstance
  have hSm_fη : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η_sp inferInstance
  letI : AlgebraicGeometry.IsProper f_η := hProp_fη
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_η := hSm_fη

  have hProp_Zη : AlgebraicGeometry.IsProper Z_η.hom := by
    change AlgebraicGeometry.IsProper (ν_η ≫ f_η)
    infer_instance
  have hSm_Zη : AlgebraicGeometry.SmoothOfRelativeDimension 1 Z_η.hom := by
    change AlgebraicGeometry.SmoothOfRelativeDimension (0 + 1) (ν_η ≫ f_η)
    infer_instance
  letI : AlgebraicGeometry.IsProper Z_η.hom := hProp_Zη
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 Z_η.hom := hSm_Zη

  letI : IrreducibleSpace ↥Y_η := AlgebraicGeometry.irreducibleSpace_of_isIntegral Y_η
  obtain ⟨y₀⟩ := (inferInstance : Nonempty ↥Y_η)
  have hy₀_top : ι_η_sp.base y₀ ∈ (⨆ α : Fin N_cov, W_sp α) := by
    rw [hW_sp_top]
    trivial
  obtain ⟨α₀, hy₀_α₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hy₀_top
  haveI hV₀_ne :
      Nonempty ↥(((TopologicalSpace.Opens.map ι_η_sp.base).obj (W_sp α₀)) :
        AlgebraicGeometry.Scheme.{u}) :=
    ⟨⟨y₀, hy₀_α₀⟩⟩

  obtain ⟨e₀, he₀⟩ := he_sp α₀
  obtain ⟨hConn_Zη, hConn_Z₀⟩ :=
    weil_finite_etale_cover_dvr_generic_irred_and_special_connected
      k ℓ hPBC B_sp hDed_sp τ_sp Ω ι_sp_Ω hInj_sp_Ω Y_sp f_sp τ_sec hτ_sec
      C₀ ι₀_sp hPb_c₀_sp Y_η ι_η_sp f_η hPb_η_sp Z_sp ν_Z
      (W_sp α₀) (hW_sp_aff α₀) (u_sp α₀) e₀ he₀ (hu_sp_no_root α₀)

  have hInt_Zη : AlgebraicGeometry.IsIntegral Z_η.left :=
    (weil_smooth_proj_curve_fiber_integral_and_projective k ℓ).2.1 Ω Z_η hConn_Zη
  have hProj_Zη : IsProjectiveOverField Ω Z_η :=
    (weil_isFinite_projective_and_krullDim_over_field Ω
      (CategoryTheory.Over.homMk ν_η rfl : Z_η ⟶ CategoryTheory.Over.mk f_η)
      hInt_Zη (inferInstance : AlgebraicGeometry.IsIntegral Y_η) hProj_Yη hFin_νη hSurj_νη).1

  obtain ⟨γ_sp, hγ_univ⟩ :=
    weil_cyclic_etale_torsor_jordan_ext_and_connected_kernel
      ℓ Y_sp Z_sp ν_Z ρ hρ_over hρ_act hρ_part

  have happLE_congr :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f₁ f₂ : X ⟶ Y) (_ : f₁ = f₂)
        (U₁ : Y.Opens) (V₁ : X.Opens)
        (h₁ : V₁ ≤ (TopologicalSpace.Opens.map f₁.base).obj U₁)
        (h₂ : V₁ ≤ (TopologicalSpace.Opens.map f₂.base).obj U₁),
        f₁.appLE U₁ V₁ h₁ = f₂.appLE U₁ V₁ h₂ := by
    intro _ _ _ _ hf _ _ _ _
    subst hf
    rfl

  refine ⟨Z_η, hInt_Zη, hProj_Zη, hProp_Zη, hSm_Zη, ν_η, rfl, hFin_νη, hSurj_νη, γ_sp,
    ?_, ?_, ?_⟩
  · intro α V_α
    obtain ⟨x_sp_α, hx_sp_α⟩ := hx_sp α
    let Z_sp_α : Z_sp.Opens := (TopologicalSpace.Opens.map ν_Z.base).obj (W_sp α)
    let U_Z_α : Z_η.left.Opens := (TopologicalSpace.Opens.map ν_η.base).obj V_α
    have hcomm_Zη : ι_Z_η ≫ ν_Z = ν_η ≫ ι_η_sp := CategoryTheory.Limits.pullback.condition
    have hle_α : U_Z_α ≤ (TopologicalSpace.Opens.map ι_Z_η.base).obj Z_sp_α := by
      intro z hz
      have hz' : (ν_η ≫ ι_η_sp).base z ∈ W_sp α := hz
      rwa [← hcomm_Zη] at hz'
    refine ⟨(ι_Z_η.appLE Z_sp_α U_Z_α hle_α).hom x_sp_α, ?_⟩
    rw [← map_pow, hx_sp_α]
    have hcomp_eq :
        ν_Z.app (W_sp α) ≫ ι_Z_η.appLE Z_sp_α U_Z_α hle_α =
        ι_η_sp.app (W_sp α) ≫ ν_η.app V_α := by
      rw [AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν_Z,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE ι_η_sp,
        AlgebraicGeometry.Scheme.Hom.app_eq_appLE ν_η,
        AlgebraicGeometry.Scheme.Hom.appLE_comp_appLE]
      exact happLE_congr (ι_Z_η ≫ ν_Z) (ν_η ≫ ι_η_sp) hcomm_Zη (W_sp α) U_Z_α _ _
    exact congrArg
      (fun φ : Y_sp.presheaf.obj (Opposite.op (W_sp α)) ⟶ Z_η.left.presheaf.obj (Opposite.op U_Z_α) =>
        φ.hom (u_sp α).1)
      hcomp_eq
  · intro p₀_sp hp₀_sp
    exact (hγ_univ C₀.left ι₀_sp hConn_Z₀ p₀_sp hp₀_sp).1
  · intro p_η_sp p_ν hp_η_sp hp_ν
    exact (hγ_univ Y_η ι_η_sp hConn_Zη p_η_sp hp_η_sp).2 p_ν hp_ν

theorem weil_etale_curve_base_dvr_torsion_specialization_no_jump (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (hProjCurveNonDeg :
      ∀ (C_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
        AlgebraicGeometry.IsIntegral C_bar.left →
        IsProjectiveOverField k C_bar →
        ∀ [AlgebraicGeometry.SmoothOfRelativeDimension 1 C_bar.hom],
          Finite (weilCupPDModH C_bar.left ℓ 1) ∧
          ∀ a : weilCupPDModH C_bar.left ℓ 1,
            (∀ b : weilCupPDModH C_bar.left ℓ 1,
              CategoryTheory.Abelian.Ext.comp a b (rfl : 1 + 1 = 2) = 0) →
            a = 0)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ)
    (C_aff : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine C_aff] [AlgebraicGeometry.IsIntegral C_aff]
    (u_C : Quiver.Hom C_aff (weilAffineSpaceOver k 1).left)
    [AlgebraicGeometry.Etale u_C]
    (c₀ : ↥C_aff) (hc₀ : IsClosed ({c₀} : Set ↥C_aff))
    (s_c₀ : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) C_aff)
    (hs_c₀_sec :
      CategoryTheory.CategoryStruct.comp s_c₀
        (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom) =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hs_c₀_range : Set.range s_c₀.base = {c₀})
    (Y_C : AlgebraicGeometry.Scheme.{u})
    (f_C : Quiver.Hom Y_C C_aff)
    [AlgebraicGeometry.IsProper f_C]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_C]
    (τ_C : Quiver.Hom C_aff Y_C)
    (hτ_C_sec : CategoryTheory.CategoryStruct.comp τ_C f_C = CategoryTheory.CategoryStruct.id C_aff)
    (hτ_C_cl : AlgebraicGeometry.IsClosedImmersion τ_C)
    (α_C : weilEtaleTorsionH Y_C ℓ 2)
    (b₁ : ℕ)
    (s : Fin b₁ → weilCupPDModH Y_C ℓ 1)
    (C₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι₀ : Quiver.Hom C₀.left Y_C)
    (hPb_c₀ : CategoryTheory.IsPullback ι₀ C₀.hom f_C s_c₀)
    (hFinProj :
      ∃ (N : ℕ)
        (ι_proj : Quiver.Hom Y_C
          (CategoryTheory.Limits.pullback
            (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom)
            (weilProjectiveSpaceOver k N).hom)),
        AlgebraicGeometry.IsFinite ι_proj ∧
        CategoryTheory.CategoryStruct.comp ι_proj
          (CategoryTheory.Limits.pullback.fst
            (CategoryTheory.CategoryStruct.comp u_C (weilAffineSpaceOver k 1).hom)
            (weilProjectiveSpaceOver k N).hom) = f_C)
    (hGeomFib_C :
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
        (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) C_aff)
        (Y_Ω : AlgebraicGeometry.Scheme.{u})
        (ι_Ω : Quiver.Hom Y_Ω Y_C)
        (f_Ω : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
        CategoryTheory.IsPullback ι_Ω f_Ω f_C s_Ω →
        AlgebraicGeometry.IsIntegral Y_Ω ∧
        IsProjectiveOverField Ω (CategoryTheory.Over.mk f_Ω) ∧
        ∀ (φ_Ω : weilEtaleTorsionH Y_C ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2),
          WeilIsTorsionEtalePullback ι_Ω ℓ 2 φ_Ω →
          φ_Ω α_C ≠ 0)
    (hSpan_c₀ :
      ∀ (θ_C : weilCupPDModH Y_C ℓ 1 →+ weilEtaleTorsionH Y_C ℓ 1)
        (θ₀ : weilCupPDModH C₀.left ℓ 1 →+ weilEtaleTorsionH C₀.left ℓ 1)
        (p₀ : weilEtaleTorsionH Y_C ℓ 1 →+ weilEtaleTorsionH C₀.left ℓ 1),
        WeilCupPDIsModComparison Y_C ℓ 1 θ_C →
        WeilCupPDIsModComparison C₀.left ℓ 1 θ₀ →
        WeilIsTorsionEtalePullback ι₀ ℓ 1 p₀ →
        ∀ x₀ : weilCupPDModH C₀.left ℓ 1,
          ∃ c : Fin b₁ → ZMod ℓ,
            θ₀ x₀ = Finset.univ.sum fun i : Fin b₁ => (c i).val • p₀ (θ_C (s i)))
    (hCupConst_C :
      ∀ (U : AlgebraicGeometry.Scheme.{u})
        [AlgebraicGeometry.IsAffine U] [ConnectedSpace ↥U]
        (g_U : Quiver.Hom U C_aff)
        (Y_U : AlgebraicGeometry.Scheme.{u})
        (p_YU : Quiver.Hom Y_U Y_C) (f_U : Quiver.Hom Y_U U),
        CategoryTheory.IsPullback p_YU f_U f_C g_U →
        ∀ (a b : weilCupPDModH Y_U ℓ 1),
          ∃ c_ab : ZMod ℓ,
            ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
              (s_Ω : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of Ω)) U)
              (Y_Ω : AlgebraicGeometry.Scheme.{u})
              (ι_Ω : Quiver.Hom Y_Ω Y_U)
              (f_Ω : Quiver.Hom Y_Ω (AlgebraicGeometry.Spec (CommRingCat.of Ω))),
              CategoryTheory.IsPullback ι_Ω f_Ω f_U s_Ω →
              ∀ (θ_U : weilCupPDModH Y_U ℓ 2 →+ weilEtaleTorsionH Y_U ℓ 2)
                (p_Ω : weilEtaleTorsionH Y_U ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2)
                (p_α : weilEtaleTorsionH Y_C ℓ 2 →+ weilEtaleTorsionH Y_Ω ℓ 2),
                WeilCupPDIsModComparison Y_U ℓ 2 θ_U →
                WeilIsTorsionEtalePullback ι_Ω ℓ 2 p_Ω →
                WeilIsTorsionEtalePullback
                  (CategoryTheory.CategoryStruct.comp ι_Ω p_YU) ℓ 2 p_α →
                p_Ω (θ_U (CategoryTheory.Abelian.Ext.comp a b (rfl : 1 + 1 = 2))) =
                  c_ab.val • p_α α_C)
    (R_dom : Type u) [CommRing R_dom] [IsDomain R_dom]
    (g_dom : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of R_dom)) C_aff)
    [AlgebraicGeometry.Etale g_dom]
    (Y_dom : AlgebraicGeometry.Scheme.{u})
    (p_dom : Quiver.Hom Y_dom Y_C)
    (f_dom : Quiver.Hom Y_dom (AlgebraicGeometry.Spec (CommRingCat.of R_dom)))
    (hPb_dom : CategoryTheory.IsPullback p_dom f_dom f_C g_dom)
    (Y_η : AlgebraicGeometry.Scheme.{u})
    (ι_η : Quiver.Hom Y_η Y_dom)
    (f_η : Quiver.Hom Y_η
      (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure (FractionRing R_dom)))))
    (hPb_η : CategoryTheory.IsPullback ι_η f_η f_dom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
        ((algebraMap (FractionRing R_dom) (AlgebraicClosure (FractionRing R_dom))).comp
          (algebraMap R_dom (FractionRing R_dom))))))
    (γ_dom : weilCupPDModH Y_dom ℓ 1)
    (γ_η : weilCupPDModH Y_η ℓ 1)
    (s_η : Fin b₁ → weilCupPDModH Y_η ℓ 1)
    (θ_C_1 : weilCupPDModH Y_C ℓ 1 →+ weilEtaleTorsionH Y_C ℓ 1)
    (θ_dom_1 : weilCupPDModH Y_dom ℓ 1 →+ weilEtaleTorsionH Y_dom ℓ 1)
    (θ_η_1 : weilCupPDModH Y_η ℓ 1 →+ weilEtaleTorsionH Y_η ℓ 1)
    (p_η_dom : weilEtaleTorsionH Y_dom ℓ 1 →+ weilEtaleTorsionH Y_η ℓ 1)
    (p_η_C : weilEtaleTorsionH Y_C ℓ 1 →+ weilEtaleTorsionH Y_η ℓ 1)
    (hθ_C_1 : WeilCupPDIsModComparison Y_C ℓ 1 θ_C_1)
    (hθ_dom_1 : WeilCupPDIsModComparison Y_dom ℓ 1 θ_dom_1)
    (hθ_η_1 : WeilCupPDIsModComparison Y_η ℓ 1 θ_η_1)
    (hp_η_dom : WeilIsTorsionEtalePullback ι_η ℓ 1 p_η_dom)
    (hp_η_C : WeilIsTorsionEtalePullback
      (CategoryTheory.CategoryStruct.comp ι_η p_dom) ℓ 1 p_η_C)
    (hγ_pull : p_η_dom (θ_dom_1 γ_dom) = θ_η_1 γ_η)
    (hs_pull : ∀ i : Fin b₁, p_η_C (θ_C_1 (s i)) = θ_η_1 (s_η i))
    (hOrth : ∀ i : Fin b₁,
      CategoryTheory.Abelian.Ext.comp γ_η (s_η i) (rfl : 1 + 1 = 2) = 0) :
    γ_η = 0 :=
by
  classical
  have hPrime : Nat.Prime ℓ := Fact.out
  haveI : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩

  
  have hTorsionZero :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ) (x : weilEtaleTorsionH S ℓ j),
        ℓ • x = 0 := by
    intro S j x
    let FM := weilEtaleTorsionSheaf S ℓ
    let Fℤ := (CategoryTheory.constantSheaf S.smallEtaleTopology AddCommGrpCat.{u}).obj
      (AddCommGrpCat.of (ULift.{u} ℤ))
    have hZ0 : ℓ • CategoryTheory.CategoryStruct.id (AddCommGrpCat.of (ZMod ℓ)) = 0 := by
      ext a
      change ℓ • a = 0
      simp [nsmul_eq_mul]
    have hid0 : ℓ • CategoryTheory.CategoryStruct.id FM = 0 := by
      dsimp [FM, weilEtaleTorsionSheaf]
      rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_id,
        ← CategoryTheory.Functor.map_nsmul, ← CategoryTheory.Functor.map_nsmul,
        hZ0, CategoryTheory.Functor.map_zero, CategoryTheory.Functor.map_zero]
    have hmk0 : ℓ • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM) = 0 := by
      apply CategoryTheory.Abelian.Ext.addEquiv₀.injective
      rw [map_nsmul, map_zero]
      have h1 : CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM)) =
          CategoryTheory.CategoryStruct.id FM :=
        (CategoryTheory.Abelian.Ext.mk₀_bijective FM FM).1
          (CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply _)
      rw [h1, hid0]
    calc
      ℓ • x = ℓ • (x.comp (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM))
          (Nat.add_zero j)) := by
        rw [CategoryTheory.Abelian.Ext.comp_mk₀_id]
      _ = ((CategoryTheory.Abelian.Ext.bilinearComp Fℤ FM FM j 0 j (Nat.add_zero j)) x)
          (ℓ • CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id FM)) := by
        rw [map_nsmul]
        rfl
      _ = x.comp 0 (Nat.add_zero j) := by
        rw [hmk0]
        rfl
      _ = 0 := CategoryTheory.Abelian.Ext.comp_zero x FM 0 j (Nat.add_zero j)

  have hNsmulMod :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (j : ℕ) (x : weilEtaleTorsionH S ℓ j) (n : ℕ),
        n • x = (n : ZMod ℓ).val • x := by
    intro S j x n
    have hdiv : n = ℓ * (n / ℓ) + n % ℓ := (Nat.div_add_mod n ℓ).symm
    calc
      n • x = (ℓ * (n / ℓ) + n % ℓ) • x := by rw [← hdiv]
      _ = (n / ℓ) • (ℓ • x) + (n % ℓ) • x := by rw [add_nsmul, mul_nsmul]
      _ = (n % ℓ) • x := by rw [hTorsionZero S j x, smul_zero, zero_add]
      _ = (n : ZMod ℓ).val • x := by rw [ZMod.val_natCast]

  
  have hAppRes :
      ∀ {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
        {U₁ U₂ : Y.Opens} (hle : U₁ ≤ U₂)
        (hle' : (TopologicalSpace.Opens.map f.base).obj U₁ ≤
          (TopologicalSpace.Opens.map f.base).obj U₂)
        (z : ↑(Y.presheaf.obj (Opposite.op U₂))),
        (X.presheaf.map (CategoryTheory.homOfLE hle').op).hom ((f.app U₂).hom z) =
          (f.app U₁).hom ((Y.presheaf.map (CategoryTheory.homOfLE hle).op).hom z) := by
    intro X Y f U₁ U₂ hle hle' z
    have hmor : CategoryTheory.homOfLE hle' =
        (TopologicalSpace.Opens.map f.base).map (CategoryTheory.homOfLE hle) :=
      Subsingleton.elim _ _
    rw [hmor]
    change (f.app U₂ ≫ X.presheaf.map
      ((TopologicalSpace.Opens.map f.base).map (CategoryTheory.homOfLE hle)).op).hom z =
      (Y.presheaf.map (CategoryTheory.homOfLE hle).op ≫ f.app U₁).hom z
    rw [AlgebraicGeometry.Scheme.Hom.naturality]
    rfl

  
  by_contra hγ_ne
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let p_C : C_aff ⟶ S_k := u_C ≫ (weilAffineSpaceOver k 1).hom
  let K₀ := FractionRing R_dom
  let Ω := AlgebraicClosure K₀
  let s_η_dom : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R_dom) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom
      ((algebraMap K₀ Ω).comp (algebraMap R_dom K₀)))

  let σ_kΩ : k →+* Ω := (AlgebraicGeometry.Spec.preimage (s_η_dom ≫ g_dom ≫ p_C)).hom
  have hℓ_Ω : (ℓ : Ω) ≠ 0 := by
    intro h0
    exact hℓ (σ_kΩ.injective (by rw [map_natCast, h0, map_zero]))

  have hPb_η_C : CategoryTheory.IsPullback (ι_η ≫ p_dom) f_η f_C (s_η_dom ≫ g_dom) :=
    hPb_η.paste_horiz hPb_dom
  obtain ⟨hInt_Yη, hProj_Yη, hα_η_nz⟩ :=
    hGeomFib_C Ω (s_η_dom ≫ g_dom) Y_η (ι_η ≫ p_dom) f_η hPb_η_C
  have hProp_fη : AlgebraicGeometry.IsProper f_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η_C inferInstance
  have hSm_fη : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_η :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η_C inferInstance
  letI : AlgebraicGeometry.IsIntegral Y_η := hInt_Yη
  letI : AlgebraicGeometry.IsProper f_η := hProp_fη
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_η := hSm_fη

  obtain ⟨hInt_C₀, hProj_C₀_mk, _⟩ := hGeomFib_C k s_c₀ C₀.left ι₀ C₀.hom hPb_c₀
  have hProj_C₀ : IsProjectiveOverField k C₀ := by
    rcases hProj_C₀_mk with ⟨N₀, ιP, hClP⟩
    have _ : AlgebraicGeometry.IsClosedImmersion ιP.left := hClP
    let e_ov : C₀ ⟶ CategoryTheory.Over.mk C₀.hom :=
      CategoryTheory.Over.homMk (𝟙 C₀.left) (CategoryTheory.Category.id_comp C₀.hom)
    refine ⟨N₀, e_ov ≫ ιP, ?_⟩
    change AlgebraicGeometry.IsClosedImmersion (𝟙 C₀.left ≫ ιP.left)
    rw [CategoryTheory.Category.id_comp]
    exact hClP
  have hSm_C₀ : AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_c₀ inferInstance
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 C₀.hom := hSm_C₀

  
  have hPullPkg := weil_etale_torsion_pullback_functoriality.{u}
  have hModUniq : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
      (θ₁ θ₂ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
      WeilCupPDIsModComparison S m j θ₁ →
      WeilCupPDIsModComparison S m j θ₂ →
      θ₁ = θ₂ :=
    fun S m j => (weil_cupPD_mod_comparison_bijective_unique S m j).2
  have hModInj : ∀ (S : AlgebraicGeometry.Scheme.{u}) (m j : ℕ)
      (θ : weilCupPDModH S m j →+ weilEtaleTorsionH S m j),
      WeilCupPDIsModComparison S m j θ → Function.Injective θ := by
    intro S m j θ hθ
    obtain ⟨⟨θ_std, hθ_std, hbij_std⟩, hUniq⟩ := weil_cupPD_mod_comparison_bijective_unique S m j
    rw [hUniq θ θ_std hθ hθ_std]
    exact hbij_std.1

  have hθγ_ne : θ_η_1 γ_η ≠ 0 := by
    intro h0
    exact hγ_ne (hModInj Y_η ℓ 1 θ_η_1 hθ_η_1 (h0.trans (map_zero θ_η_1).symm))

  
  letI : AlgebraicGeometry.IsIntegral (CategoryTheory.Over.mk f_η).left := hInt_Yη
  letI : AlgebraicGeometry.IsProper (CategoryTheory.Over.mk f_η).hom := hProp_fη
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (CategoryTheory.Over.mk f_η).hom := hSm_fη
  obtain ⟨M, Q, P₀, hKummerCharts⟩ :=
    weil_smooth_proj_curve_kummer_torsion_divisor_and_chart_units
      Ω ℓ hℓ_Ω (CategoryTheory.Over.mk f_η) hProj_Yη (θ_η_1 γ_η) hθγ_ne
  let x_η : Fin (M + 1) → {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)} := Fin.lastCases P₀ Q

  
  obtain ⟨B₁, instCR_B₁, instDom_B₁, instAlg_B₁, instFT_B₁, hDed₁, hNotField₁,
      g₁_mor, τ_B₁, ι_B₁_Ω, hInj_B₁_Ω, Y_B₁, p_B₁, f_B₁, ι_η_B₁,
      N_cov, hN_cov, W₁, h_sec, r_sec,
      ⟨hτ_g₁, _, _, hAlg_Ω⟩, ⟨hPb_B₁, hι_η_B₁_p, hPb_η_B₁⟩,
      ⟨hW₁_top, hW₁_aff⟩, ⟨hr_sec_diag, hr_sec_cocycle, hr_sec_trans⟩, hStalk_sec⟩ :=
    weil_rel_curve_dvr_section_extension_and_smooth_uniformizer_cover
      k C_aff u_C c₀ hc₀ s_c₀ hs_c₀_sec hs_c₀_range Y_C f_C hFinProj
      R_dom g_dom Y_dom p_dom f_dom hPb_dom Y_η ι_η f_η hPb_η (M + 1) x_η
  letI : CommRing B₁ := instCR_B₁
  letI : IsDomain B₁ := instDom_B₁
  letI : Algebra k B₁ := instAlg_B₁
  letI : Algebra.FiniteType k B₁ := instFT_B₁
  have hProp_fB₁ : AlgebraicGeometry.IsProper f_B₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_B₁ inferInstance
  have hSm_fB₁ : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_B₁ :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_B₁ inferInstance
  letI : AlgebraicGeometry.IsProper f_B₁ := hProp_fB₁
  letI : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_B₁ := hSm_fB₁

  
  let s_τ₁ : S_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of B₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₁.toRingHom)
  have hcomm_c₀_B₁ : ι₀ ≫ f_C = (C₀.hom ≫ s_τ₁) ≫ g₁_mor := by
    rw [CategoryTheory.Category.assoc, hτ_g₁, hPb_c₀.w]
  let ι₀_B₁ : C₀.left ⟶ Y_B₁ := hPb_B₁.lift ι₀ (C₀.hom ≫ s_τ₁) hcomm_c₀_B₁
  have hPb_c₀_B₁ : CategoryTheory.IsPullback ι₀_B₁ C₀.hom f_B₁ s_τ₁ := by
    refine CategoryTheory.IsPullback.of_right ?_ (hPb_B₁.lift_snd _ _ _) hPb_B₁
    rw [hPb_B₁.lift_fst, hτ_g₁]
    exact hPb_c₀

  
  let V : Fin N_cov → Y_η.Opens := fun α => (TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α)
  have hV_top : (⨆ α : Fin N_cov, V α) = ⊤ := by
    apply eq_top_iff.mpr
    intro y _
    have hy : ι_η_B₁.base y ∈ (⨆ α : Fin N_cov, W₁ α) := by
      rw [hW₁_top]
      trivial
    obtain ⟨α, hα⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨α, hα⟩
  have hV_aff : ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (V α) := by
    have _ : AlgebraicGeometry.IsAffineHom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω)) :=
      AlgebraicGeometry.isAffineHom_of_isAffine _
    have _ : AlgebraicGeometry.IsAffineHom ι_η_B₁ :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_η_B₁.flip ‹_›
    exact fun α => (AlgebraicGeometry.isAffineHom_iff ι_η_B₁).mp ‹_› (W₁ α) (hW₁_aff α)

  let h_Q : Fin M → ∀ α : Fin N_cov, ↑(Y_η.presheaf.obj (Opposite.op (V α))) :=
    fun j α => (ι_η_B₁.app (W₁ α)).hom (h_sec j.castSucc α)
  let h_P₀ : ∀ α : Fin N_cov, ↑(Y_η.presheaf.obj (Opposite.op (V α))) :=
    fun α => (ι_η_B₁.app (W₁ α)).hom (h_sec (Fin.last M) α)
  let r_Q : Fin M → ∀ α β : Fin N_cov, Units ↑(Y_η.presheaf.obj (Opposite.op (V α ⊓ V β))) :=
    fun j α β => Units.map (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom.toMonoidHom (r_sec j.castSucc α β)
  let r_P₀ : ∀ α β : Fin N_cov, Units ↑(Y_η.presheaf.obj (Opposite.op (V α ⊓ V β))) :=
    fun α β => Units.map (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom.toMonoidHom (r_sec (Fin.last M) α β)

  have hr_Q_trans : ∀ (j : Fin M) (α β : Fin N_cov),
      (r_Q j α β).1 *
        (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h_Q j β) =
      (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h_Q j α) := by
    intro j α β
    have hR :
        (Y_η.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V α ⊓ V β ≤ V β)).op).hom
          (h_Q j β) =
        (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
            (h_sec j.castSucc β)) :=
      hAppRes ι_η_B₁ (inf_le_right : W₁ α ⊓ W₁ β ≤ W₁ β)
        (fun _ hx => hx.2) (h_sec j.castSucc β)
    have hL :
        (Y_η.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V α ⊓ V β ≤ V α)).op).hom
          (h_Q j α) =
        (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
            (h_sec j.castSucc α)) :=
      hAppRes ι_η_B₁ (inf_le_left : W₁ α ⊓ W₁ β ≤ W₁ α)
        (fun _ hx => hx.1) (h_sec j.castSucc α)
    exact (congrArg ((r_Q j α β).1 * ·) hR).trans
      (((map_mul (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom (r_sec j.castSucc α β).1 _).symm.trans
        (congrArg (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom (hr_sec_trans j.castSucc α β))).trans hL.symm)
  have hr_P₀_trans : ∀ α β : Fin N_cov,
      (r_P₀ α β).1 *
        (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (h_P₀ β) =
      (Y_η.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (h_P₀ α) := by
    intro α β
    have hR :
        (Y_η.presheaf.map (CategoryTheory.homOfLE (inf_le_right : V α ⊓ V β ≤ V β)).op).hom
          (h_P₀ β) =
        (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom
            (h_sec (Fin.last M) β)) :=
      hAppRes ι_η_B₁ (inf_le_right : W₁ α ⊓ W₁ β ≤ W₁ β)
        (fun _ hx => hx.2) (h_sec (Fin.last M) β)
    have hL :
        (Y_η.presheaf.map (CategoryTheory.homOfLE (inf_le_left : V α ⊓ V β ≤ V α)).op).hom
          (h_P₀ α) =
        (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom
          ((Y_B₁.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom
            (h_sec (Fin.last M) α)) :=
      hAppRes ι_η_B₁ (inf_le_left : W₁ α ⊓ W₁ β ≤ W₁ α)
        (fun _ hx => hx.1) (h_sec (Fin.last M) α)
    exact (congrArg ((r_P₀ α β).1 * ·) hR).trans
      (((map_mul (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom (r_sec (Fin.last M) α β).1 _).symm.trans
        (congrArg (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom (hr_sec_trans (Fin.last M) α β))).trans hL.symm)
  have hStalk_Q : ∀ (j : Fin M) (α : Fin N_cov)
      (x : {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)}) (hx : x.1 ∈ V α),
      (x = Q j →
        Ideal.span {(Y_η.presheaf.germ (V α) x.1 hx).hom (h_Q j α)} =
          IsLocalRing.maximalIdeal ↑(Y_η.presheaf.stalk x.1)) ∧
      (x ≠ Q j →
        Ideal.span {(Y_η.presheaf.germ (V α) x.1 hx).hom (h_Q j α)} = ⊤) := by
    intro j α x hx
    simpa [h_Q, x_η, Fin.lastCases_castSucc] using hStalk_sec j.castSucc α x hx
  have hStalk_P₀ : ∀ (α : Fin N_cov)
      (x : {x : ↥Y_η // IsClosed ({x} : Set ↥Y_η)}) (hx : x.1 ∈ V α),
