          ((L_Y2.obj.map (Opposite.op α)).hom) (ω_Y_fun V f) =
            (f j ⟨α.left, CategoryTheory.MorphismProperty.Over.w α⟩).down.val •
              (((L_Y2.obj.map (Opposite.op (u'_j j))).hom) gen_Y2) :=
      fun V f j α => (Classical.choose_spec
        (hDisjAmalg Y₂_y L_Y2 V (Σ j' : Fin d, (S_j j' ⟶ V))
          (fun idx => S_j idx.1) (fun idx => idx.2)
          (hCov_Y V).1 (hCov_Y V).2.1 (hCov_Y V).2.2 _)).1 ⟨j, α⟩
