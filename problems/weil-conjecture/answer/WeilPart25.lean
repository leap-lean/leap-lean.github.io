            (CategoryTheory.Category.id_comp (E i).hom)))
    let σ_j : E i ⟶ W_j :=
      CategoryTheory.MorphismProperty.Over.homMk g_sec hg_over trivial
    have hσw : σ_j ≫ w_j = 𝟙 (E i) :=
      CategoryTheory.MorphismProperty.Over.Hom.ext hg_sec
    exact hσw ▸ R_s.downward_closed hw_mem σ_j

  let Aℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let Fℤ : CategoryTheory.Sheaf J AddCommGrpCat.{u} :=
    (CategoryTheory.constantSheaf J AddCommGrpCat.{u}).obj Aℤ
  let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hTerm

  have hProj : CategoryTheory.Projective Fℤ := by
    refine ⟨fun {ℰ₁ ℰ₂} f_hom ψ [CategoryTheory.Epi ψ] => ?_⟩
    haveI : CategoryTheory.Sheaf.IsLocallySurjective ψ :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} ψ).mpr inferInstance
    let f_grp : Aℤ ⟶ ℰ₂.obj.obj (Opposite.op T_Z) := adj.homEquiv Aℤ ℰ₂ f_hom
    let s : ↥(ℰ₂.obj.obj (Opposite.op T_Z)) := f_grp.hom (ULift.up 1)
    have hSurjE : ∀ i : Fin n, ∃ t_i : ↥(ℰ₁.obj.obj (Opposite.op (E i))),
        (ψ.hom.app (Opposite.op (E i))).hom t_i = (ℰ₂.obj.map (π i).op).hom s := by
      intro i
      let s_i : ↥(ℰ₂.obj.obj (Opposite.op (E i))) := (ℰ₂.obj.map (π i).op).hom s
      have hImgMem : CategoryTheory.Presheaf.imageSieve ψ.hom s_i ∈ J (E i) :=
        CategoryTheory.Presheaf.IsLocallySurjective.imageSieve_mem s_i
      have hIdImg : (CategoryTheory.Presheaf.imageSieve ψ.hom s_i).arrows (𝟙 (E i)) :=
        hSieveId i _ hImgMem
      rw [CategoryTheory.Presheaf.imageSieve_apply] at hIdImg
      obtain ⟨t_i, ht_i⟩ := hIdImg
      refine ⟨t_i, ?_⟩
      simpa using ht_i
    let t : ∀ i : Fin n, ↥(ℰ₁.obj.obj (Opposite.op (E i))) :=
      fun i => Classical.choose (hSurjE i)
    have ht_spec : ∀ i : Fin n,
        (ψ.hom.app (Opposite.op (E i))).hom (t i) = (ℰ₂.obj.map (π i).op).hom s :=
      fun i => Classical.choose_spec (hSurjE i)
    let P₁ := ((CategoryTheory.sheafForget J).obj ℰ₁).obj
    let P₂ := ((CategoryTheory.sheafForget J).obj ℰ₂).obj
    have hCompat : CategoryTheory.Presieve.Arrows.Compatible P₁ π t := by
      intro i j Z_et gi gj hcomm
      by_cases hij : i = j
      · subst hij
        have hleft : gi.left ≫ (O i).ι = gj.left ≫ (O i).ι :=
          congrArg (fun m => m.left) hcomm
        have hgi_gj : gi = gj :=
