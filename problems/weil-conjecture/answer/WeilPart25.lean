import WeilPart24
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem weil_etale_rel_curve_cover_kummer_annihilation (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (δ : ℕ)
    (W₀ : AlgebraicGeometry.Scheme.{u})
    (p_W₀ : Quiver.Hom W₀ (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (x₀ : ↥W₀)
    (E : WeilElementaryFibrationPkg k δ W₀ p_W₀ x₀)
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hCurveCoh : WeilSmoothProjCurveModPrimeCohHolds k ℓ) :
    ∃ (P : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E)
      (τ_int : Quiver.Hom ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left
        P.W_open.toScheme)
      (U₁ U₂ : P.Y.Opens)
      (g_sec : ↑(P.Y.presheaf.obj (Opposite.op U₁)))
      (u₁₂ : Units ↑(P.Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))),
      (CategoryTheory.CategoryStruct.comp τ_int
          (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar) =
        CategoryTheory.CategoryStruct.id
          ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left ∧
        AlgebraicGeometry.IsClosedImmersion
          (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι) ∧
        τ_int.base P.v = P.e_W.hom.base P.x) ∧
      (U₁ ≤ P.W_open ∧
        (U₂ : Set ↥P.Y) =
          (Set.range (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι).base)ᶜ ∧
        U₁ ⊔ U₂ = ⊤ ∧
        (P.Y.presheaf.map (CategoryTheory.homOfLE (inf_le_left : U₁ ⊓ U₂ ≤ U₁)).op).hom g_sec =
          (u₁₂ : ↑(P.Y.presheaf.obj (Opposite.op (U₁ ⊓ U₂)))) ∧
        ∀ (s_v : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
            ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left)
          (pt_k : ↥(AlgebraicGeometry.Spec (CommRingCat.of k)))
          (C_v : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (ι_Cv : Quiver.Hom C_v.left P.Y)
          (P_pt : ↥C_v.left)
          (hP_mem : P_pt ∈ (TopologicalSpace.Opens.map ι_Cv.base).obj U₁),
          CategoryTheory.CategoryStruct.comp s_v
              (CategoryTheory.CategoryStruct.comp
                ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).hom
                E.V_bar.hom) =
            CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
          CategoryTheory.IsPullback ι_Cv C_v.hom P.f_bar s_v →
          ι_Cv.base P_pt =
            (CategoryTheory.CategoryStruct.comp τ_int P.W_open.ι).base (s_v.base pt_k) →
          Ideal.span {(C_v.left.presheaf.germ
              ((TopologicalSpace.Opens.map ι_Cv.base).obj U₁) P_pt hP_mem).hom
            ((ι_Cv.app U₁).hom g_sec)} =
            IsLocalRing.maximalIdeal ↑(C_v.left.presheaf.stalk P_pt)) ∧
      (∀ (s_v : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k))
            ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).left)
          (C'_sch : AlgebraicGeometry.Scheme.{u})
          (ι_C' : Quiver.Hom C'_sch
            ((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).obj P.W).left)
          (q_C' : Quiver.Hom C'_sch (AlgebraicGeometry.Spec (CommRingCat.of k)))
          (u_fib : Quiver.Hom C'_sch E.U_fib.toScheme),
        Set.range s_v.base = {P.v} →
        CategoryTheory.CategoryStruct.comp s_v
            (CategoryTheory.CategoryStruct.comp
              ((AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left).obj P.V).hom
              E.V_bar.hom) =
          CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)) →
        CategoryTheory.IsPullback ι_C' q_C'
          (CategoryTheory.CategoryStruct.comp P.e_W.hom
            (CategoryTheory.CategoryStruct.comp P.W_open.ι P.f_bar))
          s_v →
        CategoryTheory.CategoryStruct.comp u_fib
            (CategoryTheory.CategoryStruct.comp E.U_fib.ι E.ι_Cfib) =
          CategoryTheory.CategoryStruct.comp ι_C'
            (CategoryTheory.CategoryStruct.comp
              (((AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left).map P.u_W).left)
              (CategoryTheory.CategoryStruct.comp E.e_W₁.hom E.W₁_open.ι)) →
        ∃ p₁ : weilEtaleTorsionH E.U_fib.toScheme ℓ 1 →+ weilEtaleTorsionH C'_sch ℓ 1,
          WeilIsTorsionEtalePullback u_fib ℓ 1 p₁ ∧
          ∀ β : weilEtaleTorsionH E.U_fib.toScheme ℓ 1, p₁ β = 0) :=
by
  classical
  let Fgt_V := AlgebraicGeometry.Scheme.Etale.forget E.V_bar.left
  let Fgt_Y := AlgebraicGeometry.Scheme.Etale.forget E.Y_bar.left
  let S_k : AlgebraicGeometry.Scheme.{u} := AlgebraicGeometry.Spec (CommRingCat.of k)
  let pt_k : ↥S_k := (⟨⊥, Ideal.bot_isMaximal.isPrime⟩ : PrimeSpectrum k)
  have hpt_bot : (pt_k : PrimeSpectrum k).asIdeal = ⊥ := rfl
  have hSub_k : Subsingleton ↥S_k := by
    change Subsingleton (PrimeSpectrum k)
    infer_instance
  haveI : AlgebraicGeometry.IsProper E.V_bar.hom := E.hProp_Vbar
  haveI : AlgebraicGeometry.IsProper E.Y_bar.hom := E.hProp_Ybar

  obtain ⟨hPullEx, _, hPullComp, _, _⟩ := weil_etale_torsion_pullback_functoriality.{u}

  
  have hClosedPtSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) [AlgebraicGeometry.LocallyOfFiniteType p_W] (x : ↥W),
        IsClosed ({x} : Set ↥W) →
        ∃ s : S_k ⟶ W, s ≫ p_W = 𝟙 S_k ∧ s.base pt_k = x := by
    intro W _ p_W _ x hx
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let q_pt : ↥(AlgebraicGeometry.Spec B_cat) := e_W.hom.base x
    let q_spec : PrimeSpectrum ↑B_cat := q_pt
    have hq_pre : ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat)) =
        e_W.inv.base ⁻¹' ({x} : Set ↥W) := by
      ext z
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl
        change (e_W.hom ≫ e_W.inv).base x = x
        rw [e_W.hom_inv_id]
        rfl
      · intro hz
        dsimp [q_pt]
        rw [← hz]
        change z = (e_W.inv ≫ e_W.hom).base z
        rw [e_W.inv_hom_id]
        rfl
    have hq_cl : IsClosed ({q_spec} : Set (PrimeSpectrum ↑B_cat)) := by
      change IsClosed ({q_pt} : Set ↥(AlgebraicGeometry.Spec B_cat))
      rw [hq_pre]
      exact hx.preimage e_W.inv.continuous
    have hq_max : q_spec.asIdeal.IsMaximal :=
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_spec).mp hq_cl
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    have hmap_φ : AlgebraicGeometry.Spec.map φ_k = e_W.inv ≫ p_W :=
      AlgebraicGeometry.Spec.map_preimage (e_W.inv ≫ p_W)
    have hFT_hom : RingHom.FiniteType φ_k.hom := by
      rw [← AlgebraicGeometry.HasRingHomProperty.Spec_iff
        (P := @AlgebraicGeometry.LocallyOfFiniteType), hmap_φ]
      infer_instance
    let alg_B : Algebra k ↑B_cat := φ_k.hom.toAlgebra
    letI : Algebra k ↑B_cat := alg_B
    have hFT_alg : Algebra.FiniteType k ↑B_cat := hFT_hom
    obtain ⟨n_mv, q_mv, hq_surj⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hFT_alg
    let q_hom : MvPolynomial (Fin n_mv) k →+* ↑B_cat := q_mv.toRingHom
    have hq_hom_surj : Function.Surjective q_hom := hq_surj
    let m_mv : Ideal (MvPolynomial (Fin n_mv) k) := Ideal.comap q_hom q_spec.asIdeal
    have hm_mv_max : m_mv.IsMaximal := Ideal.comap_isMaximal_of_surjective q_hom hq_hom_surj
    obtain ⟨a_pt, ha_pt⟩ :=
      (MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton (I := m_mv)).mp hm_mv_max
    let ev_hom : MvPolynomial (Fin n_mv) k →+* k := (MvPolynomial.aeval a_pt).toRingHom
    have hker_le : ∀ f_p ∈ RingHom.ker q_hom, ev_hom f_p = 0 := by
      intro f_p hf_p
      rw [RingHom.mem_ker] at hf_p
      have hmem : f_p ∈ m_mv := by
        change q_hom f_p ∈ q_spec.asIdeal
        rw [hf_p]
        exact q_spec.asIdeal.zero_mem
      rwa [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hmem
    let e_quot := RingHom.quotientKerEquivOfSurjective (f := q_hom) hq_hom_surj
    let σ_B : ↑B_cat →+* k :=
      (Ideal.Quotient.lift (RingHom.ker q_hom) ev_hom hker_le).comp e_quot.symm.toRingHom
    have hσ_qhom : ∀ f_p : MvPolynomial (Fin n_mv) k, σ_B (q_hom f_p) = ev_hom f_p := by
      intro f_p
      dsimp [σ_B]
      have heq_q : e_quot.symm (q_hom f_p) =
          Ideal.Quotient.mk (RingHom.ker q_hom) f_p := by
        apply e_quot.injective
        simp [e_quot]
      rw [heq_q, Ideal.Quotient.lift_mk]
    have hσ_comp : φ_k ≫ CommRingCat.ofHom σ_B = 𝟙 (CommRingCat.of k) := by
      ext c
      change σ_B (algebraMap k (↑B_cat) c) = c
      rw [← q_mv.commutes c]
      change σ_B (q_hom (MvPolynomial.C c)) = c
      rw [hσ_qhom]
      exact (MvPolynomial.aeval a_pt).commutes c
    let s : S_k ⟶ W := AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B) ≫ e_W.inv
    have hs_sec : s ≫ p_W = 𝟙 S_k := by
      dsimp [s]
      rw [CategoryTheory.Category.assoc, ← hmap_φ, ← AlgebraicGeometry.Spec.map_comp,
        hσ_comp, AlgebraicGeometry.Spec.map_id]
    have hs_pt_spec : (AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k = q_pt := by
      apply PrimeSpectrum.ext
      change Ideal.comap σ_B (pt_k : PrimeSpectrum k).asIdeal = q_spec.asIdeal
      rw [hpt_bot]
      ext b
      obtain ⟨f_p, rfl⟩ := hq_hom_surj b
      change σ_B (q_hom f_p) ∈ (⊥ : Ideal k) ↔ q_hom f_p ∈ q_spec.asIdeal
      rw [Ideal.mem_bot, hσ_qhom]
      change MvPolynomial.eval a_pt f_p = 0 ↔ f_p ∈ m_mv
      rw [ha_pt, MvPolynomial.mem_vanishingIdeal_singleton_iff]
      rfl
    refine ⟨s, hs_sec, ?_⟩
    change e_W.inv.base ((AlgebraicGeometry.Spec.map (CommRingCat.ofHom σ_B)).base pt_k) = x
    rw [hs_pt_spec]
    change (e_W.hom ≫ e_W.inv).base x = x
    rw [e_W.hom_inv_id]
    rfl

  have hClosedImmOfSection :
      ∀ {W : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine W]
        (p_W : W ⟶ S_k) (s : S_k ⟶ W),
        s ≫ p_W = 𝟙 S_k →
        AlgebraicGeometry.IsClosedImmersion s := by
    intro W _ p_W s hs
    let e_W := W.isoSpec
    let B_cat := W.presheaf.obj (Opposite.op ⊤)
    let φ_k : CommRingCat.of k ⟶ B_cat := AlgebraicGeometry.Spec.preimage (e_W.inv ≫ p_W)
    let ψ : B_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s ≫ e_W.hom)
    have hφψ : φ_k ≫ ψ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_W.hom, e_W.hom_inv_id,
        CategoryTheory.Category.id_comp, hs, AlgebraicGeometry.Spec.map_id]
    have hψ_surj : Function.Surjective ψ.hom := fun c =>
      ⟨φ_k.hom c, congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφψ⟩
    haveI : AlgebraicGeometry.IsClosedImmersion (AlgebraicGeometry.Spec.map ψ) :=
      AlgebraicGeometry.IsClosedImmersion.spec_of_surjective ψ hψ_surj
    have hs_eq : s = AlgebraicGeometry.Spec.map ψ ≫ e_W.inv := by
      dsimp [ψ]
      rw [AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        e_W.hom_inv_id, CategoryTheory.Category.comp_id]
    rw [hs_eq]
    infer_instance

  have hSectionEq :
      ∀ {V : AlgebraicGeometry.Scheme.{u}} [AlgebraicGeometry.IsAffine V]
        (p_V : V ⟶ S_k) (s₁ s₂ : S_k ⟶ V),
        s₁ ≫ p_V = 𝟙 S_k →
        s₂ ≫ p_V = 𝟙 S_k →
        s₁.base pt_k = s₂.base pt_k →
        s₁ = s₂ := by
    intro V _ p_V s₁ s₂ hs₁ hs₂ hpt
    let e_V := V.isoSpec
    let A_cat := V.presheaf.obj (Opposite.op ⊤)
    let φ_V : CommRingCat.of k ⟶ A_cat := AlgebraicGeometry.Spec.preimage (e_V.inv ≫ p_V)
    let ψ₁ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₁ ≫ e_V.hom)
    let ψ₂ : A_cat ⟶ CommRingCat.of k := AlgebraicGeometry.Spec.preimage (s₂ ≫ e_V.hom)
    have hφ₁ : φ_V ≫ ψ₁ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₁, AlgebraicGeometry.Spec.map_id]
    have hφ₂ : φ_V ≫ ψ₂ = 𝟙 (CommRingCat.of k) := by
      apply AlgebraicGeometry.Spec.map_injective
      rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
        AlgebraicGeometry.Spec.map_preimage, CategoryTheory.Category.assoc,
        ← CategoryTheory.Category.assoc e_V.hom, e_V.hom_inv_id,
        CategoryTheory.Category.id_comp, hs₂, AlgebraicGeometry.Spec.map_id]
    have hspec_pt : (AlgebraicGeometry.Spec.map ψ₁).base pt_k =
        (AlgebraicGeometry.Spec.map ψ₂).base pt_k := by
      dsimp [ψ₁, ψ₂]
      rw [AlgebraicGeometry.Spec.map_preimage, AlgebraicGeometry.Spec.map_preimage]
      exact congrArg e_V.hom.base hpt
    have hcomap : Ideal.comap ψ₁.hom (pt_k : PrimeSpectrum k).asIdeal =
        Ideal.comap ψ₂.hom (pt_k : PrimeSpectrum k).asIdeal :=
      congrArg PrimeSpectrum.asIdeal hspec_pt
    rw [hpt_bot] at hcomap
    have hψ_eq : ψ₁ = ψ₂ := by
      ext a
      have h0_2 : a - φ_V.hom (ψ₂.hom a) ∈ Ideal.comap ψ₂.hom (⊥ : Ideal k) := by
        rw [Ideal.mem_comap, Ideal.mem_bot, map_sub]
        have hc : ψ₂.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
          congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₂
        rw [hc, sub_self]
      rw [← hcomap, Ideal.mem_comap, Ideal.mem_bot, map_sub] at h0_2
      have hc1 : ψ₁.hom (φ_V.hom (ψ₂.hom a)) = ψ₂.hom a :=
        congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom (ψ₂.hom a)) hφ₁
      rw [hc1] at h0_2
      exact sub_eq_zero.mp h0_2
    have hse : s₁ ≫ e_V.hom = s₂ ≫ e_V.hom := by
      rw [← AlgebraicGeometry.Spec.map_preimage (s₁ ≫ e_V.hom),
        ← AlgebraicGeometry.Spec.map_preimage (s₂ ≫ e_V.hom)]
      exact congrArg AlgebraicGeometry.Spec.map hψ_eq
    calc
      s₁ = (s₁ ≫ e_V.hom) ≫ e_V.inv := by simp
      _ = (s₂ ≫ e_V.hom) ≫ e_V.inv := by rw [hse]
      _ = s₂ := by simp

  
  have hmap_id_V : (Fgt_V.map (𝟙 E.V₁)).left = 𝟙 (Fgt_V.obj E.V₁).left := by simp
  have hmap_id_W : (Fgt_Y.map (𝟙 E.W₁)).left = 𝟙 (Fgt_Y.obj E.W₁).left := by simp
  have hComm_Y₁_0 :
      CategoryTheory.CategoryStruct.comp (𝟙 E.Y₁) E.f_bar₁ =
        CategoryTheory.CategoryStruct.comp E.f_bar₁ (Fgt_V.map (𝟙 E.V₁)).left := by
    change 𝟙 E.Y₁ ≫ E.f_bar₁ = E.f_bar₁ ≫ (Fgt_V.map (𝟙 E.V₁)).left
    rw [hmap_id_V, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
  let φ_rel₀ := CategoryTheory.Limits.pullback.lift (𝟙 E.Y₁) E.f_bar₁ hComm_Y₁_0
  have hIso_rel₀ : CategoryTheory.IsIso φ_rel₀ := by
    refine ⟨⟨CategoryTheory.Limits.pullback.fst E.f_bar₁ (Fgt_V.map (𝟙 E.V₁)).left,
      CategoryTheory.Limits.pullback.lift_fst _ _ _, ?_⟩⟩
    apply CategoryTheory.Limits.pullback.hom_ext
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
    · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
        CategoryTheory.Limits.pullback.condition, hmap_id_V,
        CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  haveI : CategoryTheory.IsIso φ_rel₀ := hIso_rel₀
  have hComm_W_0 :
      CategoryTheory.CategoryStruct.comp (Fgt_Y.map (𝟙 E.W₁)).left
        (CategoryTheory.CategoryStruct.comp E.e_W₁.hom
          (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁)) =
      CategoryTheory.CategoryStruct.comp
        (CategoryTheory.CategoryStruct.comp E.e_W₁.hom
          (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁))
        (Fgt_V.map (𝟙 E.V₁)).left := by
    change (Fgt_Y.map (𝟙 E.W₁)).left ≫ (E.e_W₁.hom ≫ E.W₁_open.ι ≫ E.f_bar₁) =
      (E.e_W₁.hom ≫ E.W₁_open.ι ≫ E.f_bar₁) ≫ (Fgt_V.map (𝟙 E.V₁)).left
    rw [hmap_id_W, hmap_id_V, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
  let φ_W₀ := CategoryTheory.Limits.pullback.lift (Fgt_Y.map (𝟙 E.W₁)).left
    (CategoryTheory.CategoryStruct.comp E.e_W₁.hom
      (CategoryTheory.CategoryStruct.comp E.W₁_open.ι E.f_bar₁))
    hComm_W_0
  have hIso_W₀ : CategoryTheory.IsIso φ_W₀ := by
    refine ⟨⟨CategoryTheory.Limits.pullback.fst _ _, ?_, ?_⟩⟩
    · rw [CategoryTheory.Limits.pullback.lift_fst]
      exact hmap_id_W
    · apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          hmap_id_W, CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.condition, hmap_id_V,
          CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp]
  haveI : CategoryTheory.IsIso φ_W₀ := hIso_W₀
  let P₀ : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E :=
    { V := E.V₁
      g_V := 𝟙 E.V₁
      v := E.v₁
      Y := E.Y₁
      f_bar := E.f_bar₁
      π_Y₁ := 𝟙 E.Y₁
      m_pts := E.s_pts
      τ_bdry := E.σ
      W_open := E.W₁_open
      W := E.W₁
      e_W := E.e_W₁
      u_W := 𝟙 E.W₁
      x := E.x₁
      hAff_V := E.hAff_V₁
      hInt_V := E.hInt_V₁
      hv_cl := E.hv₁_cl
      hv_map := by rw [hmap_id_V]; rfl
      hInt_Y := E.hInt_Y₁
      hProp_f := E.hProp_f₁
      hSm_f := E.hSm_f₁
      hComm_Y₁ := hComm_Y₁_0
      hFin_rel := inferInstance
      hSurj_rel := inferInstance
      hIrred_fib := E.hIrred_fib
      hm_pts_pos := E.hs_pts_pos
      hτ_sec := E.hσ_sec
      hτ_cl := E.hσ_cl
      hτ_disj := E.hσ_disj
      hW_compl := E.hW₁_compl
      hAff_Wopen := E.hAff_W₁open
      he_W_hom := by
        change E.e_W₁.hom ≫ E.W₁_open.ι ≫ 𝟙 E.Y₁ ≫ E.g_Y₁ = (Fgt_Y.obj E.W₁).hom
        rw [CategoryTheory.Category.id_comp]
        exact E.he_W₁_hom
      hu_W_comp := by
        change (Fgt_Y.map (𝟙 E.W₁)).left ≫ (E.e_W₁.hom ≫ E.W₁_open.ι) =
          E.e_W₁.hom ≫ (E.W₁_open.ι ≫ 𝟙 E.Y₁)
        rw [hmap_id_W, CategoryTheory.Category.id_comp, CategoryTheory.Category.comp_id]
      hComm_W := hComm_W_0
      hFin_W_rel := inferInstance
      hEt_W_rel := inferInstance
      hSurj_W_rel := inferInstance
      hx_cl := E.hx₁_cl
      hx_map := by rw [hmap_id_W]; rfl
      hx_fib := E.hx₁_fib }

  have hsv₁_pt : E.s_v₁.base pt_k = E.v₁ := by
    have hmem : E.s_v₁.base pt_k ∈ Set.range E.s_v₁.base := ⟨pt_k, rfl⟩
    rwa [E.hs_v₁_range, Set.mem_singleton_iff] at hmem
  have hCl_ιCfib : AlgebraicGeometry.IsClosedImmersion E.ι_Cfib := by
    haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj E.V₁).left := E.hAff_V₁
    have hCl_sv₁ : AlgebraicGeometry.IsClosedImmersion E.s_v₁ :=
      hClosedImmOfSection ((Fgt_V.obj E.V₁).hom ≫ E.V_bar.hom) E.s_v₁ E.hs_v₁_sec
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      E.hPb_Cfib.flip hCl_sv₁
  haveI : AlgebraicGeometry.IsClosedImmersion E.ι_Cfib := hCl_ιCfib
  have hMono_Ufib : CategoryTheory.Mono (E.U_fib.ι ≫ E.ι_Cfib) := inferInstance

  
  have hSmoothOverFieldIsReduced :
      ∀ (C_sch : AlgebraicGeometry.Scheme.{u}) (q_C : C_sch ⟶ S_k)
        [AlgebraicGeometry.SmoothOfRelativeDimension 1 q_C],
        AlgebraicGeometry.IsReduced C_sch := by
    intro C_sch q_C hSm_q
    haveI : ∀ x : ↥C_sch, IsReduced ↑(C_sch.presheaf.stalk x) := by
      intro x
      obtain ⟨U_k, hAff_Uk, V, hAff_V, hx_V, he, hStd⟩ :=
        (AlgebraicGeometry.smoothOfRelativeDimension_iff 1 q_C).mp hSm_q x
      have hUk_top : U_k = ⊤ := by
        ext y
        exact iff_of_true (by rw [hSub_k.elim y (q_C.base x)]; exact he hx_V) trivial
      subst hUk_top
      obtain ⟨ψ, _, hψ_et⟩ := hStd.exists_etale_mvPolynomial
      let A_k := S_k.presheaf.obj (Opposite.op ⊤)
      let R_V := C_sch.presheaf.obj (Opposite.op V)
      have hfrom_eq : hAff_Uk.fromSpec = S_k.isoSpec.inv :=
        AlgebraicGeometry.IsAffineOpen.fromSpec_top
      haveI : CategoryTheory.IsIso hAff_Uk.fromSpec := by
        rw [hfrom_eq]
        infer_instance
      let φ_k : CommRingCat.of k ⟶ A_k := AlgebraicGeometry.Spec.preimage hAff_Uk.fromSpec
      let φ_k_inv : A_k ⟶ CommRingCat.of k :=
        AlgebraicGeometry.Spec.preimage (CategoryTheory.inv hAff_Uk.fromSpec)
      have hφ1 : φ_k ≫ φ_k_inv = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.inv_hom_id,
          AlgebraicGeometry.Spec.map_id]
      have hφ2 : φ_k_inv ≫ φ_k = 𝟙 _ := by
        apply AlgebraicGeometry.Spec.map_injective
        rw [AlgebraicGeometry.Spec.map_comp, AlgebraicGeometry.Spec.map_preimage,
          AlgebraicGeometry.Spec.map_preimage, CategoryTheory.IsIso.hom_inv_id,
          AlgebraicGeometry.Spec.map_id]
      let e_mv : CommRingCat.of (MvPolynomial (Fin 1) k) ⟶
          CommRingCat.of (MvPolynomial (Fin 1) ↑A_k) :=
        CommRingCat.ofHom (MvPolynomial.map φ_k.hom)
      let e_mv_inv : CommRingCat.of (MvPolynomial (Fin 1) ↑A_k) ⟶
          CommRingCat.of (MvPolynomial (Fin 1) k) :=
        CommRingCat.ofHom (MvPolynomial.map φ_k_inv.hom)
      have he_mv1 : e_mv ≫ e_mv_inv = 𝟙 _ := by
        ext1
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [e_mv, e_mv_inv, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
            Function.comp_apply, MvPolynomial.map_C, CommRingCat.hom_id, RingHom.id_apply]
          exact congrArg MvPolynomial.C
            (congrArg (fun g : CommRingCat.of k ⟶ CommRingCat.of k => g.hom c) hφ1)
        · intro i
          simp [e_mv, e_mv_inv]
      have he_mv2 : e_mv_inv ≫ e_mv = 𝟙 _ := by
        ext1
        apply MvPolynomial.ringHom_ext
        · intro c
          simp only [e_mv, e_mv_inv, CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
            Function.comp_apply, MvPolynomial.map_C, CommRingCat.hom_id, RingHom.id_apply]
          exact congrArg MvPolynomial.C (congrArg (fun g : A_k ⟶ A_k => g.hom c) hφ2)
        · intro i
          simp [e_mv, e_mv_inv]
      let R_poly := MvPolynomial (Fin 1) k
      haveI : CategoryTheory.IsIso e_mv := ⟨⟨e_mv_inv, he_mv1, he_mv2⟩⟩
      let u_mid : AlgebraicGeometry.Spec R_V ⟶
          AlgebraicGeometry.Spec (CommRingCat.of (MvPolynomial (Fin 1) ↑A_k)) :=
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom ψ)
      haveI : AlgebraicGeometry.Etale u_mid :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mpr hψ_et
      let u₀ : AlgebraicGeometry.Spec R_V ⟶ AlgebraicGeometry.Spec (CommRingCat.of R_poly) :=
        u_mid ≫ AlgebraicGeometry.Spec.map e_mv
      have hEt_u₀ : AlgebraicGeometry.Etale u₀ := inferInstance
      let φ_poly : CommRingCat.of R_poly ⟶ R_V := AlgebraicGeometry.Spec.preimage u₀
      have hmap_φpoly : AlgebraicGeometry.Spec.map φ_poly = u₀ :=
        AlgebraicGeometry.Spec.map_preimage u₀
      have hEt_hom : RingHom.Etale φ_poly.hom :=
        (AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Etale)).mp
          (hmap_φpoly.symm ▸ hEt_u₀)
      let alg_RV : Algebra R_poly ↑R_V := φ_poly.hom.toAlgebra
      letI : Algebra R_poly ↑R_V := alg_RV
      haveI : Algebra.Etale R_poly ↑R_V := RingHom.etale_algebraMap.mp hEt_hom
      let K_poly := FractionRing R_poly
      let T_K := TensorProduct R_poly K_poly ↑R_V
      haveI : Algebra.Etale K_poly T_K := Algebra.Etale.baseChange R_poly (↑R_V) K_poly
      have hRed_TK : IsReduced T_K := Algebra.FormallyUnramified.isReduced_of_field K_poly T_K
      let ι_lin : R_poly →ₗ[R_poly] K_poly := Algebra.linearMap R_poly K_poly
      have hinj_rT : Function.Injective (LinearMap.rTensor (↑R_V) ι_lin) :=
        Module.Flat.rTensor_preserves_injective_linearMap ι_lin
          (IsFractionRing.injective R_poly K_poly)
      have hRed_RV : IsReduced ↑(C_sch.presheaf.obj (Opposite.op V)) := by
        refine ⟨fun r ⟨n, hn⟩ => ?_⟩
        have hTK_zero : Algebra.TensorProduct.includeRight (R := R_poly) (A := K_poly)
            (B := ↑R_V) r = 0 :=
          hRed_TK.eq_zero _ ⟨n, by rw [← map_pow, hn, map_zero]⟩
        have htmul0 : (LinearMap.rTensor (↑R_V) ι_lin) ((1 : R_poly) ⊗ₜ[R_poly] r) =
            (LinearMap.rTensor (↑R_V) ι_lin) 0 := by
          rw [map_zero]
          change (algebraMap R_poly K_poly 1) ⊗ₜ[R_poly] r = 0
          rw [map_one]
          exact hTK_zero
        have h1r0 : (1 : R_poly) ⊗ₜ[R_poly] r = 0 := hinj_rT htmul0
        simpa using congrArg (TensorProduct.lid R_poly ↑R_V) h1r0
      let x_V : ↥V := ⟨x, hx_V⟩
      let Stk := ↑(C_sch.presheaf.stalk ↑x_V)
      letI : Algebra ↑(C_sch.presheaf.obj (Opposite.op V)) Stk :=
        TopCat.Presheaf.algebra_section_stalk C_sch.presheaf x_V
      haveI := hAff_V.isLocalization_stalk x_V
      let M_x := (hAff_V.primeIdealOf x_V).asIdeal.primeCompl
      change IsReduced Stk
      refine ⟨fun s ⟨n, hn⟩ => ?_⟩
      obtain ⟨⟨r, m⟩, hsec⟩ := IsLocalization.surj M_x s
      have hrn : algebraMap ↑(C_sch.presheaf.obj (Opposite.op V)) Stk (r ^ n) = 0 := by
        rw [map_pow, ← hsec, mul_pow, hn, zero_mul]
      obtain ⟨m', hm'⟩ := (IsLocalization.map_eq_zero_iff M_x Stk (r ^ n)).mp hrn
      have hpow0 : ((m' : ↑(C_sch.presheaf.obj (Opposite.op V))) * r) ^ (n + 1) = 0 := by
        calc
          ((m' : ↑(C_sch.presheaf.obj (Opposite.op V))) * r) ^ (n + 1)
            = (m' : ↑(C_sch.presheaf.obj (Opposite.op V))) ^ n * r *
                ((m' : ↑(C_sch.presheaf.obj (Opposite.op V))) * r ^ n) := by ring
          _ = (m' : ↑(C_sch.presheaf.obj (Opposite.op V))) ^ n * r * 0 := by rw [hm']
          _ = 0 := mul_zero _
      have hmr0 : (m' : ↑(C_sch.presheaf.obj (Opposite.op V))) * r = 0 :=
        hRed_RV.eq_zero _ ⟨n + 1, hpow0⟩
      have hs_mul :
          (s * algebraMap ↑(C_sch.presheaf.obj (Opposite.op V)) Stk m) *
            algebraMap ↑(C_sch.presheaf.obj (Opposite.op V)) Stk m' = 0 := by
        rw [hsec, ← map_mul, mul_comm r (m' : ↑(C_sch.presheaf.obj (Opposite.op V))),
          hmr0, map_zero]
      let u1 := (IsLocalization.map_units Stk m).unit
      let u2 := (IsLocalization.map_units Stk m').unit
      have hu1_val : (u1 : Stk) = algebraMap ↑(C_sch.presheaf.obj (Opposite.op V)) Stk m :=
        IsUnit.unit_spec _
      have hu2_val : (u2 : Stk) = algebraMap ↑(C_sch.presheaf.obj (Opposite.op V)) Stk m' :=
        IsUnit.unit_spec _
      calc
        s = ((s * (u1 : Stk)) * (u2 : Stk)) * (↑u2⁻¹ * ↑u1⁻¹) := by
          rw [mul_assoc (s * (u1 : Stk)), ← mul_assoc (u2 : Stk), Units.mul_inv, one_mul,
            mul_assoc, Units.mul_inv, mul_one]
        _ = 0 * (↑u2⁻¹ * ↑u1⁻¹) := by
          rw [hu1_val, hu2_val, hs_mul]
        _ = 0 := zero_mul _
    exact AlgebraicGeometry.isReduced_of_isReduced_stalk C_sch

  
  have hRelFiberPullback :
      ∀ {Y₁ Y₂ V₁ V₂ C₁ C₂ : AlgebraicGeometry.Scheme.{u}}
        (f₁ : Y₁ ⟶ V₁) (f₂ : Y₂ ⟶ V₂) (h_Y : Y₂ ⟶ Y₁) (h_V : V₂ ⟶ V₁)
        (hComm : CategoryTheory.CategoryStruct.comp h_Y f₁ =
          CategoryTheory.CategoryStruct.comp f₂ h_V)
        [AlgebraicGeometry.IsFinite (CategoryTheory.Limits.pullback.lift h_Y f₂ hComm)]
        [AlgebraicGeometry.Surjective (CategoryTheory.Limits.pullback.lift h_Y f₂ hComm)]
        (ι₁ : C₁ ⟶ Y₁) (q₁ : C₁ ⟶ S_k) (s₁ : S_k ⟶ V₁)
        (ι₂ : C₂ ⟶ Y₂) (q₂ : C₂ ⟶ S_k) (s₂ : S_k ⟶ V₂)
        (ν : C₂ ⟶ C₁),
        CategoryTheory.IsPullback ι₁ q₁ f₁ s₁ →
        CategoryTheory.IsPullback ι₂ q₂ f₂ s₂ →
        s₂ ≫ h_V = s₁ →
        ι₂ ≫ h_Y = ν ≫ ι₁ →
        ν ≫ q₁ = q₂ →
        AlgebraicGeometry.IsFinite ν ∧ AlgebraicGeometry.Surjective ν := by
    intro Y₁ Y₂ V₁ V₂ C₁ C₂ f₁ f₂ h_Y h_V hComm hFin_rel hSurj_rel
      ι₁ q₁ s₁ ι₂ q₂ s₂ ν hPb₁ hPb₂ hs hν_ι hν_q
    let P_rel := CategoryTheory.Limits.pullback f₁ h_V
    let p₁ : P_rel ⟶ Y₁ := CategoryTheory.Limits.pullback.fst f₁ h_V
    let p₂ : P_rel ⟶ V₂ := CategoryTheory.Limits.pullback.snd f₁ h_V
    let φ_rel : Y₂ ⟶ P_rel := CategoryTheory.Limits.pullback.lift h_Y f₂ hComm
    let j_rel : C₁ ⟶ P_rel :=
      CategoryTheory.Limits.pullback.lift ι₁ (q₁ ≫ s₂) (by
        rw [CategoryTheory.Category.assoc, hs]
        exact hPb₁.w)
    have hj_p₁ : j_rel ≫ p₁ = ι₁ := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hj_p₂ : j_rel ≫ p₂ = q₁ ≫ s₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_j : CategoryTheory.IsPullback j_rel q₁ p₂ s₂ :=
      CategoryTheory.IsPullback.of_right
        (by rw [hj_p₁, hs]; exact hPb₁)
        hj_p₂
        (CategoryTheory.IsPullback.of_hasPullback f₁ h_V)
    have hφ_p₁ : φ_rel ≫ p₁ = h_Y := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hφ_p₂ : φ_rel ≫ p₂ = f₂ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hcomm_top : ι₂ ≫ φ_rel = ν ≫ j_rel := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hφ_p₁, CategoryTheory.Category.assoc, hj_p₁, hν_ι]
      · rw [CategoryTheory.Category.assoc, hφ_p₂, hPb₂.w, CategoryTheory.Category.assoc,
          hj_p₂, ← CategoryTheory.Category.assoc, hν_q]
    have hPb_top : CategoryTheory.IsPullback ι₂ ν φ_rel j_rel :=
      CategoryTheory.IsPullback.of_bot
        (by rw [hν_q, hφ_p₂]; exact hPb₂)
        hcomm_top
        hPb_j
    exact ⟨CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top hFin_rel,
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_top hSurj_rel⟩

  
  let specSecEx := fun (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E) =>
    haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj P_cur.V).left := P_cur.hAff_V
    haveI : AlgebraicGeometry.Etale (Fgt_V.obj P_cur.V).hom := P_cur.V.prop
    hClosedPtSection ((Fgt_V.obj P_cur.V).hom ≫ E.V_bar.hom) P_cur.v P_cur.hv_cl
  let specSec (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E) :
      S_k ⟶ (Fgt_V.obj P_cur.V).left :=
    Classical.choose (specSecEx P_cur)
  have hSpecSec_sec : ∀ P_cur,
      specSec P_cur ≫ ((Fgt_V.obj P_cur.V).hom ≫ E.V_bar.hom) = 𝟙 S_k :=
    fun P_cur => (Classical.choose_spec (specSecEx P_cur)).1
  have hSpecSec_pt : ∀ P_cur, (specSec P_cur).base pt_k = P_cur.v :=
    fun P_cur => (Classical.choose_spec (specSecEx P_cur)).2
  have hSpecSec_range : ∀ P_cur, Set.range (specSec P_cur).base = {P_cur.v} := by
    intro P_cur
    ext z
    simp only [Set.mem_range, Set.mem_singleton_iff]
    constructor
    · rintro ⟨w, rfl⟩
      rw [hSub_k.elim w pt_k]
      exact hSpecSec_pt P_cur
    · rintro rfl
      exact ⟨pt_k, hSpecSec_pt P_cur⟩

  let specCurve (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E) :
      CategoryTheory.Over S_k :=
    CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd P_cur.f_bar (specSec P_cur))
  let specFst (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E) :
      (specCurve P_cur).left ⟶ P_cur.Y :=
    CategoryTheory.Limits.pullback.fst P_cur.f_bar (specSec P_cur)
  let specOpen (P_cur : WeilPointedRelCurveCoverPkg k δ W₀ p_W₀ x₀ E) :
      (specCurve P_cur).left.Opens :=
    (TopologicalSpace.Opens.map (specFst P_cur).base).obj P_cur.W_open

  have hSpecPb : ∀ P_cur,
      CategoryTheory.IsPullback (specFst P_cur) (specCurve P_cur).hom
        P_cur.f_bar (specSec P_cur) :=
    fun P_cur => CategoryTheory.IsPullback.of_hasPullback P_cur.f_bar (specSec P_cur)

  have hSpecCl : ∀ P_cur, AlgebraicGeometry.IsClosedImmersion (specFst P_cur) := by
    intro P_cur
    haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj P_cur.V).left := P_cur.hAff_V
    have hCl_s : AlgebraicGeometry.IsClosedImmersion (specSec P_cur) :=
      hClosedImmOfSection ((Fgt_V.obj P_cur.V).hom ≫ E.V_bar.hom)
        (specSec P_cur) (hSpecSec_sec P_cur)
    exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hSpecPb P_cur).flip hCl_s

  have hSpecSm : ∀ P_cur,
      AlgebraicGeometry.SmoothOfRelativeDimension 1 (specCurve P_cur).hom :=
    fun P_cur => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (hSpecPb P_cur) P_cur.hSm_f

  have hSpecInt : ∀ P_cur, AlgebraicGeometry.IsIntegral (specCurve P_cur).left := by
    intro P_cur
    haveI : IrreducibleSpace ↥(specCurve P_cur).left := P_cur.hIrred_fib k (specSec P_cur)
    haveI : AlgebraicGeometry.SmoothOfRelativeDimension 1 (specCurve P_cur).hom := hSpecSm P_cur
    haveI : AlgebraicGeometry.IsReduced (specCurve P_cur).left :=
      hSmoothOverFieldIsReduced (specCurve P_cur).left (specCurve P_cur).hom
    exact AlgebraicGeometry.isIntegral_of_irreducibleSpace_of_isReduced (specCurve P_cur).left

  have hSpecG_eq : ∀ P_cur,
      specSec P_cur ≫ (Fgt_V.map P_cur.g_V).left = E.s_v₁ := by
    intro P_cur
    haveI : AlgebraicGeometry.IsAffine (Fgt_V.obj E.V₁).left := E.hAff_V₁
    have hgV_w : (Fgt_V.map P_cur.g_V).left ≫ (Fgt_V.obj E.V₁).hom =
        (Fgt_V.obj P_cur.V).hom :=
      CategoryTheory.MorphismProperty.Over.w P_cur.g_V
    refine hSectionEq ((Fgt_V.obj E.V₁).hom ≫ E.V_bar.hom)
      (specSec P_cur ≫ (Fgt_V.map P_cur.g_V).left) E.s_v₁ ?_ E.hs_v₁_sec ?_
    · rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc (Fgt_V.map P_cur.g_V).left,
        hgV_w]
      exact hSpecSec_sec P_cur
    · change (Fgt_V.map P_cur.g_V).left.base ((specSec P_cur).base pt_k) = E.s_v₁.base pt_k
      rw [hSpecSec_pt P_cur, P_cur.hv_map, hsv₁_pt]

  have hSpecProj : ∀ P_cur, IsProjectiveOverField k (specCurve P_cur) := by
    intro P_cur
    have hcomm_C : (specFst P_cur ≫ P_cur.π_Y₁) ≫ E.f_bar₁ =
        (specCurve P_cur).hom ≫ E.s_v₁ := by
      rw [CategoryTheory.Category.assoc, P_cur.hComm_Y₁,
        ← CategoryTheory.Category.assoc (specFst P_cur), (hSpecPb P_cur).w,
        CategoryTheory.Category.assoc, hSpecG_eq P_cur]
    let π_C_left : (specCurve P_cur).left ⟶ E.C_fib.left :=
      E.hPb_Cfib.lift (specFst P_cur ≫ P_cur.π_Y₁) (specCurve P_cur).hom hcomm_C
    have hπ_ι : π_C_left ≫ E.ι_Cfib = specFst P_cur ≫ P_cur.π_Y₁ :=
      E.hPb_Cfib.lift_fst _ _ _
    have hπ_q : π_C_left ≫ E.C_fib.hom = (specCurve P_cur).hom :=
      E.hPb_Cfib.lift_snd _ _ _
    haveI : AlgebraicGeometry.IsFinite
        (CategoryTheory.Limits.pullback.lift P_cur.π_Y₁ P_cur.f_bar P_cur.hComm_Y₁) :=
      P_cur.hFin_rel
    haveI : AlgebraicGeometry.Surjective
        (CategoryTheory.Limits.pullback.lift P_cur.π_Y₁ P_cur.f_bar P_cur.hComm_Y₁) :=
      P_cur.hSurj_rel
    obtain ⟨hFin_π, hSurj_π⟩ :=
      hRelFiberPullback E.f_bar₁ P_cur.f_bar P_cur.π_Y₁ (Fgt_V.map P_cur.g_V).left P_cur.hComm_Y₁
        E.ι_Cfib E.C_fib.hom E.s_v₁ (specFst P_cur) (specCurve P_cur).hom (specSec P_cur)
        π_C_left E.hPb_Cfib (hSpecPb P_cur) (hSpecG_eq P_cur) hπ_ι.symm hπ_q
    let π_C : specCurve P_cur ⟶ E.C_fib := CategoryTheory.Over.homMk π_C_left hπ_q
    exact (weil_isFinite_projective_and_krullDim_over_field k π_C
      (hSpecInt P_cur) E.hInt_Cfib E.hProj_Cfib hFin_π hSurj_π).1

  have hSpecAffU : ∀ P_cur, AlgebraicGeometry.IsAffineOpen (specOpen P_cur) := by
    intro P_cur
    haveI : AlgebraicGeometry.IsClosedImmersion (specFst P_cur) := hSpecCl P_cur
    exact P_cur.hAff_Wopen.preimage (specFst P_cur)

  
  have hExtractPts :
      ∀ {Y_s V_s C_s : AlgebraicGeometry.Scheme.{u}}
        (f_s : Y_s ⟶ V_s) (m_s : ℕ) (τ_s : Fin m_s → (V_s ⟶ Y_s))
        (W_s : Y_s.Opens) (ι_s : C_s ⟶ Y_s) (q_s : C_s ⟶ S_k) (s_s : S_k ⟶ V_s) (v_s : ↥V_s)
        [AlgebraicGeometry.IsClosedImmersion ι_s],
        CategoryTheory.IsPullback ι_s q_s f_s s_s →
        s_s.base pt_k = v_s →
        (∀ a : Fin m_s, τ_s a ≫ f_s = 𝟙 V_s) →
        (∀ a : Fin m_s, AlgebraicGeometry.IsClosedImmersion (τ_s a)) →
        (_root_.Pairwise fun a b : Fin m_s =>
          Disjoint (Set.range (τ_s a).base) (Set.range (τ_s b).base)) →
        (W_s : Set ↥Y_s) = (⋃ a : Fin m_s, Set.range (τ_s a).base)ᶜ →
        ∃ P_pts : Fin m_s → { x : ↥C_s // IsClosed ({x} : Set ↥C_s) },
          (_root_.Pairwise fun a b : Fin m_s => P_pts a ≠ P_pts b) ∧
          (((TopologicalSpace.Opens.map ι_s.base).obj W_s : Set ↥C_s) =
            (⋃ a : Fin m_s, {(P_pts a).1})ᶜ) ∧
          (∀ a : Fin m_s, ι_s.base (P_pts a).1 = (τ_s a).base v_s) := by
    intro Y_s V_s C_s f_s m_s τ_s W_s ι_s q_s s_s v_s hCl_ι hPb_s hs_pt hτ_sec hτ_cl hτ_disj hW_c
