    have hPb_fib_U :
        CategoryTheory.IsPullback
          ((Limits.pullback.fst f'_ZU s_U_Ω ≫ 𝟙 Z_U) ≫ (p_ZU ≫ p_ZU''))
          (Limits.pullback.snd f'_ZU s_U_Ω)
          f_Z s_sp_Ω := by
