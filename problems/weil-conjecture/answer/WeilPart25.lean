      have hτ_nat_Sj :
          ((L_Y2.obj.map (Opposite.op (u'_j j))).hom)
            (τ_cod (bc_Tk (θ_Tk (ι_dom (((L_Ey.obj.map (Opposite.op (σ i))).hom) gen_Ey))))) =
          ((τ_sh.hom.app (Opposite.op (S_j j))).hom)
            ((((pb_ι.obj F₂).obj.map (Opposite.op u_Sj)).hom)
              ((((e_sW ≫ (pb_y.map θ_fin ≫ bc₀)).hom.app (Opposite.op T_k)).hom)
