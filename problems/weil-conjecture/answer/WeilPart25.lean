            B_U.hom P_1.hom :=
          (AlgebraicGeometry.isPullback_morphismRestrict p_1Bm U).paste_vert
            (CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom)
        refine hArrowIso (p_1Bm ∣_ U)
          (CategoryTheory.Limits.pullback.fst B_U.hom P_1.hom)
          hpb_res.isoPullback (CategoryTheory.Iso.refl _) ?_ hBU
        rw [hpb_res.isoPullback_hom_fst, CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      have hPBC_mB : WeilCanonicalModPrimePBC ℓ p_mB := ih B
      have hPBC_tower : WeilCanonicalModPrimePBC ℓ (p_1Bm ≫ p_mB) :=
        hComp p_1Bm p_mB hPBC_1Bm hPBC_mB
      obtain ⟨μ, hFin_μ, hSurj_μ, hw_μ⟩ := hVieta m
      let P_m1_hom := CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom ≫ P_m.hom
      let μ_B : CategoryTheory.Limits.pullback B.hom P_m1_hom ⟶
          CategoryTheory.Limits.pullback B.hom P_succ.hom :=
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ)
          (by rw [CategoryTheory.Category.assoc, hw_μ, CategoryTheory.Limits.pullback.condition])
      have hμ_fst : μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.fst B.hom P_m1_hom :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have hμ_snd : μ_B ≫ CategoryTheory.Limits.pullback.snd B.hom P_succ.hom =
          CategoryTheory.Limits.pullback.snd B.hom P_m1_hom ≫ μ :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have hpb_μB : CategoryTheory.IsPullback
          μ_B
          (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
          (CategoryTheory.Limits.pullback.snd B.hom P_succ.hom)
          μ := by
        refine CategoryTheory.IsPullback.of_right ?_ hμ_snd
          (CategoryTheory.IsPullback.of_hasPullback B.hom P_succ.hom)
        rw [hμ_fst]
        have h_outer : CategoryTheory.IsPullback
            (CategoryTheory.Limits.pullback.fst B.hom P_m1_hom)
            (CategoryTheory.Limits.pullback.snd B.hom P_m1_hom)
            B.hom (μ ≫ P_succ.hom) := by
          rw [hw_μ]
          exact CategoryTheory.IsPullback.of_hasPullback B.hom P_m1_hom
        exact h_outer
      have : AlgebraicGeometry.IsFinite μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hFin_μ
      have hSurj_μB : AlgebraicGeometry.Surjective μ_B :=
        CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpb_μB.flip hSurj_μ
      have hPBC_μB : WeilCanonicalModPrimePBC ℓ μ_B :=
        weil_pbc_finite_morphism ℓ μ_B
      let α : CategoryTheory.Limits.pullback B_m.hom P_1.hom ⟶
          CategoryTheory.Limits.pullback P_m.hom P_1.hom :=
        CategoryTheory.Limits.pullback.lift
          (p_1Bm ≫ CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.snd B_m.hom P_1.hom)
          (by
            rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition]
            exact CategoryTheory.Limits.pullback.condition)
      have hpb_left : CategoryTheory.IsPullback
          p_1Bm α
          (CategoryTheory.Limits.pullback.snd B.hom P_m.hom)
          (CategoryTheory.Limits.pullback.fst P_m.hom P_1.hom) := by
        refine CategoryTheory.IsPullback.of_bot ?_
          (CategoryTheory.Limits.pullback.lift_fst _ _ _).symm
          (CategoryTheory.IsPullback.of_hasPullback P_m.hom P_1.hom)
        rw [CategoryTheory.Limits.pullback.lift_snd]
        have h_eq : CategoryTheory.Limits.pullback.snd B.hom P_m.hom ≫ P_m.hom = B_m.hom :=
          (CategoryTheory.Limits.pullback.condition (f := B.hom) (g := P_m.hom)).symm
        rw [h_eq]
        exact CategoryTheory.IsPullback.of_hasPullback B_m.hom P_1.hom
      have hpb_assoc : CategoryTheory.IsPullback
          (p_1Bm ≫ p_mB) α B.hom P_m1_hom :=
        hpb_left.paste_horiz (CategoryTheory.IsPullback.of_hasPullback B.hom P_m.hom)
      have hPBC_comp_μB : WeilCanonicalModPrimePBC ℓ
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom) := by
        refine hArrowIso
          (μ_B ≫ CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
          (p_1Bm ≫ p_mB)
          hpb_assoc.isoPullback.symm (CategoryTheory.Iso.refl B.left) ?_ hPBC_tower
        rw [CategoryTheory.Iso.symm_hom, hpb_assoc.isoPullback_inv_fst, hμ_fst,
          CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id]
      exact hCancel μ_B (CategoryTheory.Limits.pullback.fst B.hom P_succ.hom)
        hSurj_μB hPBC_μB hPBC_comp_μB

