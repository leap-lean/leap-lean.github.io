              ((congrArg (w₃.left ≫ ·) hp_fg).trans
                (CategoryTheory.Category.assoc w₃.left p₂ g.1.left).symm) }
    have : CategoryTheory.IsFiltered I_s := CategoryTheory.IsFiltered.mk

    let F_s : CategoryTheory.Functor I_s AddCommGrpCat.{u} :=
      { obj := fun i => G.obj.obj (Opposite.op (V i.1))
        map := fun f => G.obj.map (Opposite.op f.1)
        map_id := fun i => G.obj.map_id (Opposite.op (V i.1))
        map_comp := fun f g => G.obj.map_comp (Opposite.op f.1) (Opposite.op g.1) }
    let M_s : AddCommGrpCat.{u} := CategoryTheory.Limits.colimit F_s

    let germ : ∀ (U : X.Etale) (γ : S_k ⟶ U.left),
        γ ≫ U.hom = s → (G.obj.obj (Opposite.op U) ⟶ M_s) := fun U γ hγ =>
      let d := (exists_smallAff U γ hγ).choose
      let γ_d := (exists_smallAff U γ hγ).choose_spec.choose
      let w := (exists_smallAff U γ hγ).choose_spec.choose_spec.choose
      let h_spec := (exists_smallAff U γ hγ).choose_spec.choose_spec.choose_spec
      G.obj.map (Opposite.op w) ≫ CategoryTheory.Limits.colimit.ι F_s ⟨d, γ_d, h_spec.1⟩

    have germ_eq : ∀ (U : X.Etale) (γ : S_k ⟶ U.left) (hγ : γ ≫ U.hom = s)
        (i : I_s) (w : V i.1 ⟶ U),
        i.2.1 ≫ w.left = γ →
        germ U γ hγ = G.obj.map (Opposite.op w) ≫ CategoryTheory.Limits.colimit.ι F_s i := by
      intro U γ hγ i w hw
      let d₀ := (exists_smallAff U γ hγ).choose
      let γ₀_d := (exists_smallAff U γ hγ).choose_spec.choose
      let w₀ := (exists_smallAff U γ hγ).choose_spec.choose_spec.choose
      let h_spec := (exists_smallAff U γ hγ).choose_spec.choose_spec.choose_spec
      let i₀ : I_s := ⟨d₀, γ₀_d, h_spec.1⟩
      change G.obj.map (Opposite.op w₀) ≫ CategoryTheory.Limits.colimit.ι F_s i₀ =
        G.obj.map (Opposite.op w) ≫ CategoryTheory.Limits.colimit.ι F_s i
      have : AlgebraicGeometry.Etale w₀.left := hEt_of_hom w₀
      have : AlgebraicGeometry.Etale w.left := hEt_of_hom w
      have : AlgebraicGeometry.Etale (V i₀.1).hom := (V i₀.1).prop
      let P := CategoryTheory.Limits.pullback w₀.left w.left
      let pr₁ := CategoryTheory.Limits.pullback.fst w₀.left w.left
      let pr₂ := CategoryTheory.Limits.pullback.snd w₀.left w.left
      have : AlgebraicGeometry.Etale pr₁ := inferInstance
      let W : X.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (pr₁ ≫ (V i₀.1).hom) inferInstance
      let γ_P : S_k ⟶ P :=
        CategoryTheory.Limits.pullback.lift i₀.2.1 i.2.1 (h_spec.2.trans hw.symm)
      have hγ_P : γ_P ≫ W.hom = s :=
        (CategoryTheory.Category.assoc γ_P pr₁ (V i₀.1).hom).symm.trans
          ((congrArg (· ≫ (V i₀.1).hom) (CategoryTheory.Limits.pullback.lift_fst _ _ _)).trans
            i₀.2.2)
      obtain ⟨d₂, γ₂, k, hγ₂_s, hγ₂_k⟩ := exists_smallAff W γ_P hγ_P
      let i₂ : I_s := ⟨d₂, γ₂, hγ₂_s⟩
      let pr₁_et : W ⟶ V i₀.1 := CategoryTheory.MorphismProperty.Over.homMk pr₁ rfl trivial
      have hpr₂_w : pr₂ ≫ (V i.1).hom = W.hom :=
        (congrArg (pr₂ ≫ ·) (CategoryTheory.MorphismProperty.Over.w w).symm).trans
          ((CategoryTheory.Category.assoc pr₂ w.left U.hom).symm.trans
            ((congrArg (· ≫ U.hom) CategoryTheory.Limits.pullback.condition.symm).trans
              ((CategoryTheory.Category.assoc pr₁ w₀.left U.hom).trans
                (congrArg (pr₁ ≫ ·) (CategoryTheory.MorphismProperty.Over.w w₀)))))
      let pr₂_et : W ⟶ V i.1 := CategoryTheory.MorphismProperty.Over.homMk pr₂ hpr₂_w trivial
      let θ₀ : i₀ ⟶ i₂ := ⟨k ≫ pr₁_et,
        (CategoryTheory.Category.assoc γ₂ k.left pr₁).symm.trans
          ((congrArg (· ≫ pr₁) hγ₂_k).trans (CategoryTheory.Limits.pullback.lift_fst _ _ _))⟩
      let θ₁ : i ⟶ i₂ := ⟨k ≫ pr₂_et,
        (CategoryTheory.Category.assoc γ₂ k.left pr₂).symm.trans
          ((congrArg (· ≫ pr₂) hγ₂_k).trans (CategoryTheory.Limits.pullback.lift_snd _ _ _))⟩
      have h_comm_et : θ₀.1 ≫ w₀ = θ₁.1 ≫ w :=
        CategoryTheory.MorphismProperty.Comma.Hom.ext
          ((CategoryTheory.Category.assoc k.left pr₁ w₀.left).trans
            ((congrArg (k.left ≫ ·) CategoryTheory.Limits.pullback.condition).trans
              (CategoryTheory.Category.assoc k.left pr₂ w.left).symm))
          (Subsingleton.elim _ _)
      have h1 : G.obj.map (Opposite.op w₀) ≫ CategoryTheory.Limits.colimit.ι F_s i₀ =
          G.obj.map (Opposite.op (θ₀.1 ≫ w₀)) ≫ CategoryTheory.Limits.colimit.ι F_s i₂ := by
        rw [← CategoryTheory.Limits.colimit.w F_s θ₀, ← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ _) (G.obj.map_comp (Opposite.op w₀) (Opposite.op θ₀.1)).symm
      have h2 : G.obj.map (Opposite.op w) ≫ CategoryTheory.Limits.colimit.ι F_s i =
          G.obj.map (Opposite.op (θ₁.1 ≫ w)) ≫ CategoryTheory.Limits.colimit.ι F_s i₂ := by
        rw [← CategoryTheory.Limits.colimit.w F_s θ₁, ← CategoryTheory.Category.assoc]
        exact congrArg (· ≫ _) (G.obj.map_comp (Opposite.op w) (Opposite.op θ₁.1)).symm
      exact h1.trans ((congrArg (fun u => G.obj.map (Opposite.op u) ≫ _) h_comm_et).trans h2.symm)

    let B_s := weilEtaleSitePullback s
    let pf_s := @CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ B_s AddCommGrpCat.{u} _
      X.smallEtaleTopology S_k.smallEtaleTopology hCont
    let pb_s := @CategoryTheory.Functor.sheafPullback _ _ _ _ B_s AddCommGrpCat.{u} _
      X.smallEtaleTopology S_k.smallEtaleTopology hCont hAdj
    let adj_s := @CategoryTheory.Functor.sheafAdjunctionContinuous _ _ _ _ B_s AddCommGrpCat.{u} _
      X.smallEtaleTopology S_k.smallEtaleTopology hCont hAdj
    let Sky_s : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u} :=
      ⟨weilPunctCurveSkyscraperPresheaf σ_k M_s, hSkySheaf M_s⟩

    have hα_proj : ∀ (U : X.Etale) (a : Fin 1) (α : weilPunctCurveSectionLift σ_k a (B_s.obj U)),
        (α.1 ≫ CategoryTheory.Limits.pullback.fst U.hom s) ≫ U.hom = s := fun U a α =>
      (CategoryTheory.Category.assoc α.1 (CategoryTheory.Limits.pullback.fst U.hom s) U.hom).trans
        ((congrArg (α.1 ≫ ·) CategoryTheory.Limits.pullback.condition).trans
          ((CategoryTheory.Category.assoc α.1 (CategoryTheory.Limits.pullback.snd U.hom s) s).symm.trans
            ((congrArg (· ≫ s) α.2).trans (CategoryTheory.Category.id_comp s))))

    let Ψ_app : ∀ U : X.Etale,
        G.obj.obj (Opposite.op U) ⟶ Sky_s.obj.obj (Opposite.op (B_s.obj U)) := fun U =>
      AddCommGrpCat.ofHom
        { toFun := fun u a α =>
            germ U (α.1 ≫ CategoryTheory.Limits.pullback.fst U.hom s) (hα_proj U a α) u
          map_zero' := by
            funext a α
            exact map_zero _
          map_add' := fun u₁ u₂ => by
            funext a α
            exact map_add _ u₁ u₂ }

    let Ψ_s : G ⟶ pf_s.obj Sky_s :=
      { hom :=
          { app := fun opU => Ψ_app opU.unop
            naturality := fun {opU₁ opU₂} f => by
              apply AddCommGrpCat.ext
              intro u
              funext a α
              let U₁ := opU₁.unop
              let U₂ := opU₂.unop
              let g : U₂ ⟶ U₁ := f.unop
              let γ₂ : S_k ⟶ U₂.left := α.1 ≫ CategoryTheory.Limits.pullback.fst U₂.hom s
              have hγ₂ : γ₂ ≫ U₂.hom = s := hα_proj U₂ a α
              let d₂ := (exists_smallAff U₂ γ₂ hγ₂).choose
              let γ_d₂ := (exists_smallAff U₂ γ₂ hγ₂).choose_spec.choose
              let w₂ := (exists_smallAff U₂ γ₂ hγ₂).choose_spec.choose_spec.choose
              let h_spec₂ := (exists_smallAff U₂ γ₂ hγ₂).choose_spec.choose_spec.choose_spec
              let i₂ : I_s := ⟨d₂, γ_d₂, h_spec₂.1⟩
              have h_map_fst : (B_s.map g).left ≫ CategoryTheory.Limits.pullback.fst U₁.hom s =
                  CategoryTheory.Limits.pullback.fst U₂.hom s ≫ g.left :=
                (congrArg (· ≫ CategoryTheory.Limits.pullback.fst U₁.hom s)
                  (letI : CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) s :=
                    CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
                   letI : CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) s :=
                    CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
                      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
                   CategoryTheory.MorphismProperty.Over.pullback_map_left (@AlgebraicGeometry.Etale) ⊤ s g)).trans
                  (CategoryTheory.Limits.pullback.lift_fst _ _ _)
              let α' : weilPunctCurveSectionLift σ_k a (B_s.obj U₁) :=
                ⟨CategoryTheory.CategoryStruct.comp α.1
                  ((AlgebraicGeometry.Scheme.Etale.forget S_k).map (B_s.op.map f).unop).left,
                  (CategoryTheory.Category.assoc α.1
                    ((AlgebraicGeometry.Scheme.Etale.forget S_k).map (B_s.op.map f).unop).left _).trans
                    ((congrArg (CategoryTheory.CategoryStruct.comp α.1)
                      ((AlgebraicGeometry.Scheme.Etale.forget S_k).map (B_s.op.map f).unop).w).trans α.2)⟩
              have h_fst_nat :
                  α'.1 ≫ CategoryTheory.Limits.pullback.fst U₁.hom s = γ₂ ≫ g.left :=
                (CategoryTheory.Category.assoc α.1 (B_s.map g).left _).trans
                  ((congrArg (α.1 ≫ ·) h_map_fst).trans
                    (CategoryTheory.Category.assoc α.1 _ g.left).symm)
              have hw_comp : i₂.2.1 ≫ (w₂ ≫ g).left =
                  α'.1 ≫ CategoryTheory.Limits.pullback.fst U₁.hom s :=
                (CategoryTheory.Category.assoc γ_d₂ w₂.left g.left).symm.trans
                  ((congrArg (· ≫ g.left) h_spec₂.2).trans h_fst_nat.symm)
              have hLHS : (G.obj.map f ≫ Ψ_app U₂) u a α =
                  (G.obj.map (Opposite.op w₂) ≫ CategoryTheory.Limits.colimit.ι F_s i₂)
                    (G.obj.map f u) :=
                congrArg (fun m : G.obj.obj (Opposite.op U₂) ⟶ M_s => m (G.obj.map f u))
                  (germ_eq U₂ γ₂ hγ₂ i₂ w₂ h_spec₂.2)
              have hRHS : (Ψ_app U₁ ≫ (pf_s.obj Sky_s).obj.map f) u a α =
                  (G.obj.map (Opposite.op (w₂ ≫ g)) ≫ CategoryTheory.Limits.colimit.ι F_s i₂) u :=
                congrArg (fun m : G.obj.obj (Opposite.op U₁) ⟶ M_s => m u)
                  (germ_eq U₁ (α'.1 ≫ CategoryTheory.Limits.pullback.fst U₁.hom s)
                    (hα_proj U₁ a α') i₂ (w₂ ≫ g) hw_comp)
              have hMid : (G.obj.map (Opposite.op (w₂ ≫ g)) ≫
                  CategoryTheory.Limits.colimit.ι F_s i₂) u =
                  (G.obj.map (Opposite.op w₂) ≫ CategoryTheory.Limits.colimit.ι F_s i₂)
                    (G.obj.map f u) :=
                congrArg (fun m : G.obj.obj (Opposite.op U₁) ⟶ M_s => m u)
                  ((congrArg (· ≫ CategoryTheory.Limits.colimit.ι F_s i₂)
                    (G.obj.map_comp f (Opposite.op w₂))).trans
                    (CategoryTheory.Category.assoc (G.obj.map f)
                      (G.obj.map (Opposite.op w₂))
                      (CategoryTheory.Limits.colimit.ι F_s i₂)))
              exact hLHS.trans (hMid.symm.trans hRHS.symm) } }

    let ZeroMor : G ⟶ pf_s.obj Sky_s :=
      { hom :=
          { app := fun _ => 0
            naturality := fun _ => by simp } }

    have hZero_pb : CategoryTheory.Limits.IsZero (pb_s.obj G) :=
      hZero_Gs.of_iso e_zero
    have hΨ_eq : Ψ_s = ZeroMor := by
      apply (adj_s.homEquiv G Sky_s).symm.injective
      exact hZero_pb.eq_of_src _ _

    let α₀ : weilPunctCurveSectionLift σ_k 0 (B_s.obj U₀) :=
      ⟨CategoryTheory.Limits.pullback.lift γ₀ (𝟙 S_k)
        (hγ₀.trans (CategoryTheory.Category.id_comp s).symm),
       CategoryTheory.Limits.pullback.lift_snd _ _ _⟩
    have hα₀_fst : α₀.1 ≫ CategoryTheory.Limits.pullback.fst U₀.hom s = γ₀ :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hΨ_eval : Ψ_s.hom.app (Opposite.op U₀) y₀ 0 α₀ = 0 := by
      rw [hΨ_eq]
      rfl

    obtain ⟨d₀, γ_d₀, w₀, hγ_d₀_s, hγ_d₀_w⟩ := exists_smallAff U₀ γ₀ hγ₀
    let i₀ : I_s := ⟨d₀, γ_d₀, hγ_d₀_s⟩
    have h_germ_zero :
        CategoryTheory.Limits.colimit.ι F_s i₀ (G.obj.map (Opposite.op w₀) y₀) = 0 := by
      have hg0 : germ U₀ (α₀.1 ≫ CategoryTheory.Limits.pullback.fst U₀.hom s)
          (hα_proj U₀ 0 α₀) y₀ = 0 := hΨ_eval
      rw [germ_eq U₀ _ (hα_proj U₀ 0 α₀) i₀ w₀ (hγ_d₀_w.trans hα₀_fst.symm)] at hg0
      exact hg0

    let U_fgt := CategoryTheory.forget AddCommGrpCat.{u}
    let hc_fgt : CategoryTheory.Limits.IsColimit
        (U_fgt.mapCocone (CategoryTheory.Limits.colimit.cocone F_s)) :=
      CategoryTheory.Limits.isColimitOfPreserves U_fgt
        (CategoryTheory.Limits.colimit.isColimit F_s)
    have h_colim_types :
        (U_fgt.mapCocone (CategoryTheory.Limits.colimit.cocone F_s)).ι.app i₀
          (G.obj.map (Opposite.op w₀) y₀) =
        (U_fgt.mapCocone (CategoryTheory.Limits.colimit.cocone F_s)).ι.app i₀
          (0 : ↥(F_s.obj i₀)) :=
      h_germ_zero.trans (map_zero (CategoryTheory.Limits.colimit.ι F_s i₀).hom).symm
    obtain ⟨j, θ, hθ_eq⟩ :=
      (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff' hc_fgt
        (G.obj.map (Opposite.op w₀) y₀) (0 : ↥(F_s.obj i₀))).mp h_colim_types
    have hθ_zero : (F_s ⋙ U_fgt).map θ (0 : ↥(F_s.obj i₀)) = 0 :=
      map_zero (F_s.map θ).hom
    have hθ_res : G.obj.map (Opposite.op θ.1) (G.obj.map (Opposite.op w₀) y₀) = 0 :=
      hθ_eq.trans hθ_zero
    refine ⟨V j.1, θ.1 ≫ w₀, j.2.1, ?_, ?_⟩
    · exact (CategoryTheory.Category.assoc j.2.1 θ.1.left w₀.left).symm.trans
        ((congrArg (· ≫ w₀.left) θ.2).trans hγ_d₀_w)
    · change (G.obj.map (Opposite.op w₀ ≫ Opposite.op θ.1)) y₀ = 0
      rw [G.obj.map_comp]
      exact hθ_res

  
  have hZeroCons :
      ∀ (S : CategoryTheory.Over S_k) [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        (G : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}),
      (∀ (s : Quiver.Hom S_k S.left),
        CategoryTheory.CategoryStruct.comp s S.hom = CategoryTheory.CategoryStruct.id S_k →
        ∃ G_s : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u},
          WeilIsEtaleSheafPullback s G G_s ∧ CategoryTheory.Limits.IsZero G_s) →
      CategoryTheory.Limits.IsZero G := by
    intro S _ G hSecZero
    have hSecAllZero : ∀ (U : S.left.Etale) (y : ↥(G.obj.obj (Opposite.op U))), y = 0 := by
      intro U y
      have h_pt_cov : ∀ z : ↥U.left,
          ∃ (V_z : S.left.Etale) (w_z : V_z ⟶ U) (q : ↥V_z.left),
            w_z.left.base q = z ∧ G.obj.map (Opposite.op w_z) y = 0 := by
        intro z
        obtain ⟨O, hAff_O, hz_O, -⟩ :=
          AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := z)
            (U := (⊤ : U.left.Opens)) trivial
        let R_z : CommRingCat.{u} := U.left.presheaf.obj (Opposite.op O)
        let j_z : AlgebraicGeometry.Spec R_z ⟶ U.left := hAff_O.fromSpec
        have hz_mem : z ∈ Set.range j_z.base := by
          rw [hAff_O.range_fromSpec]
          exact hz_O
        obtain ⟨p_z, hp_z⟩ := hz_mem
        obtain ⟨𝔪_z, h𝔪_max, hp_le⟩ :=
          Ideal.exists_le_maximal p_z.asIdeal p_z.isPrime.ne_top
        let x₀ : ↥(AlgebraicGeometry.Spec R_z) := (⟨𝔪_z, h𝔪_max.isPrime⟩ : PrimeSpectrum ↑R_z)
        have hx₀_cl : x₀ ∈ closure ({p_z} : Set ↥(AlgebraicGeometry.Spec R_z)) :=
          (PrimeSpectrum.le_iff_mem_closure p_z x₀).mp hp_le
        have : AlgebraicGeometry.Etale U.hom := U.prop
        let p_Rz : AlgebraicGeometry.Spec R_z ⟶ S_k := (j_z ≫ U.hom) ≫ S.hom
        have : AlgebraicGeometry.LocallyOfFiniteType p_Rz := inferInstance
        obtain ⟨σ₀, hσ₀_sec, hσ₀_pt⟩ := hClosedPtSection R_z p_Rz 𝔪_z h𝔪_max
        let U_R : S.left.Etale :=
          CategoryTheory.MorphismProperty.Over.mk ⊤ (j_z ≫ U.hom) inferInstance
        let ι_R : U_R ⟶ U := CategoryTheory.MorphismProperty.Over.homMk j_z rfl trivial
        let s_z : S_k ⟶ S.left := σ₀ ≫ U_R.hom
        have hs_z : s_z ≫ S.hom = 𝟙 S_k :=
          (CategoryTheory.Category.assoc σ₀ (j_z ≫ U.hom) S.hom).trans hσ₀_sec
        obtain ⟨V_z, v_z, γ'_z, hγ'_v, hv_zero⟩ :=
          hPointedVanish S.left G s_z (hSecZero s_z hs_z)
            U_R (G.obj.map (Opposite.op ι_R) y) σ₀ rfl
        have : AlgebraicGeometry.Etale v_z.left := hEt_of_hom v_z
        have hOpen_v : IsOpen (Set.range v_z.left.base) := v_z.left.isOpenMap.isOpen_range
        have hx₀_in : x₀ ∈ Set.range v_z.left.base :=
          ⟨γ'_z.base pt_k,
            (congrArg (fun m : S_k ⟶ AlgebraicGeometry.Spec R_z => m.base pt_k) hγ'_v).trans
              hσ₀_pt⟩
        obtain ⟨_, hmem_range, hmem_sing⟩ :=
          mem_closure_iff.mp hx₀_cl (Set.range v_z.left.base) hOpen_v hx₀_in
        rcases hmem_sing with rfl
        obtain ⟨q_z, hq_z⟩ := hmem_range
        refine ⟨V_z, v_z ≫ ι_R, q_z, ?_, ?_⟩
        · change j_z.base (v_z.left.base q_z) = z
          rw [hq_z, hp_z]
        · change G.obj.map (Opposite.op ι_R ≫ Opposite.op v_z) y = 0
          rw [G.obj.map_comp]
          exact hv_zero
      choose V_fam w_fam q_fam hq_fam hw_van using h_pt_cov
      have hw_cov : ∀ z : ↥U.left, ∃ (i : ↥U.left) (q : ↥(V_fam i).left),
          (w_fam i).left.base q = z :=
        fun z => ⟨z, q_fam z, hq_fam z⟩
      have hf_cov : CategoryTheory.Sieve.ofArrows V_fam w_fam ∈ S.left.smallEtaleTopology U :=
        hSieveMem V_fam w_fam hw_cov
      have h_eq_hom : elemHom (G.obj.obj (Opposite.op U)) y = 0 :=
        G.property.hom_ext_ofArrows w_fam hf_cov fun z =>
          ((elemHom_comp y (G.obj.map (w_fam z).op)).trans
            (congrArg (elemHom (G.obj.obj (Opposite.op (V_fam z)))) (hw_van z))).trans
            ((elemHom_zero (G.obj.obj (Opposite.op (V_fam z)))).trans
              (CategoryTheory.Limits.zero_comp :
                (0 : Z_obj ⟶ G.obj.obj (Opposite.op U)) ≫ G.obj.map (w_fam z).op = 0).symm)
      have h_ev := congrArg (fun f : Z_obj ⟶ G.obj.obj (Opposite.op U) => f (ULift.up 1)) h_eq_hom
      exact (elemHom_one (G.obj.obj (Opposite.op U)) y).symm.trans h_ev
    refine CategoryTheory.Limits.IsZero.mk (fun Y => ⟨⟨0⟩, fun f => ?_⟩) (fun Y => ⟨⟨0⟩, fun f => ?_⟩)
    · apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opU
      apply AddCommGrpCat.ext
      intro x
      rw [hSecAllZero opU.unop x, map_zero]
      rfl
    · apply CategoryTheory.Sheaf.hom_ext
      apply CategoryTheory.NatTrans.ext
      funext opU
      apply AddCommGrpCat.ext
      intro y
      exact hSecAllZero opU.unop _

  
  have hSpecTermHomExt : ∀ {H₁ H₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
      (α β : H₁ ⟶ H₂),
      α.hom.app (Opposite.op T_k) = β.hom.app (Opposite.op T_k) → α = β := by
    intro H₁ H₂ α β hTk
    have hCoverTk : ∀ W : S_k.Etale,
        CategoryTheory.Sieve.ofArrows (fun _ : (T_k ⟶ W) => T_k) (fun γ => γ) ∈
          S_k.smallEtaleTopology W := by
      intro W
      refine hSieveMem (fun _ : (T_k ⟶ W) => T_k) (fun γ => γ) fun w => ?_
      obtain ⟨O, hAff_O, hw_O, -⟩ :=
        AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (x := w)
          (U := (⊤ : W.left.Opens)) trivial
      let R_w : CommRingCat.{u} := W.left.presheaf.obj (Opposite.op O)
      let j_w : AlgebraicGeometry.Spec R_w ⟶ W.left := hAff_O.fromSpec
      have hw_mem : w ∈ Set.range j_w.base := by
        rw [hAff_O.range_fromSpec]
        exact hw_O
      obtain ⟨p_w, hp_w⟩ := hw_mem
      obtain ⟨𝔪_w, h𝔪_max, hp_le⟩ :=
        Ideal.exists_le_maximal p_w.asIdeal p_w.isPrime.ne_top
      let x₀ : ↥(AlgebraicGeometry.Spec R_w) := (⟨𝔪_w, h𝔪_max.isPrime⟩ : PrimeSpectrum ↑R_w)
      have hx₀_cl : x₀ ∈ closure ({p_w} : Set ↥(AlgebraicGeometry.Spec R_w)) :=
        (PrimeSpectrum.le_iff_mem_closure p_w x₀).mp hp_le
      have : AlgebraicGeometry.Etale W.hom := W.prop
      let p_Rw : AlgebraicGeometry.Spec R_w ⟶ S_k := j_w ≫ W.hom
      have hEt_pRw : AlgebraicGeometry.Etale p_Rw := inferInstance
      have : AlgebraicGeometry.LocallyOfFiniteType p_Rw := inferInstance
      obtain ⟨σ, hσ_sec, hσ_pt⟩ := hClosedPtSection R_w p_Rw 𝔪_w h𝔪_max
      have hEt_σcomp : AlgebraicGeometry.Etale (σ ≫ p_Rw) := by
        rw [hσ_sec]
        infer_instance
      have : AlgebraicGeometry.Etale σ :=
        CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
          σ p_Rw hEt_pRw hEt_σcomp
      have : CategoryTheory.Mono σ :=
        ⟨fun {Z} g₁ g₂ hg =>
          (CategoryTheory.Category.comp_id g₁).symm.trans
            ((congrArg (g₁ ≫ ·) hσ_sec.symm).trans
              ((CategoryTheory.Category.assoc g₁ σ p_Rw).symm.trans
                ((congrArg (· ≫ p_Rw) hg).trans
                  ((CategoryTheory.Category.assoc g₂ σ p_Rw).trans
                    ((congrArg (g₂ ≫ ·) hσ_sec).trans
                      (CategoryTheory.Category.comp_id g₂))))))⟩
      have : AlgebraicGeometry.IsOpenImmersion σ :=
        AlgebraicGeometry.IsOpenImmersion.of_flat_of_mono σ
      have hOpen_σ : IsOpen (Set.range σ.base) := σ.isOpenMap.isOpen_range
      obtain ⟨_, ⟨q_k, rfl⟩, hmem_sing⟩ :=
        mem_closure_iff.mp hx₀_cl (Set.range σ.base) hOpen_σ ⟨pt_k, hσ_pt⟩
      have h_eq_pw : σ.base q_k = p_w := hmem_sing
      let γ_w : T_k ⟶ W :=
        CategoryTheory.MorphismProperty.Over.homMk (σ ≫ j_w)
          ((CategoryTheory.Category.assoc σ j_w W.hom).trans hσ_sec) trivial
      refine ⟨γ_w, pt_k, ?_⟩
      change j_w.base (σ.base pt_k) = w
      rw [← hSub_k.elim q_k pt_k, h_eq_pw, hp_w]
    apply CategoryTheory.Sheaf.hom_ext
    apply CategoryTheory.NatTrans.ext
    funext opW
    let W := opW.unop
    apply AddCommGrpCat.ext
    intro x
    have h_eq_hom : elemHom (H₂.obj.obj (Opposite.op W)) (α.hom.app (Opposite.op W) x) =
        elemHom (H₂.obj.obj (Opposite.op W)) (β.hom.app (Opposite.op W) x) := by
      refine H₂.property.hom_ext_ofArrows (fun γ : (T_k ⟶ W) => γ) (hCoverTk W) fun γ => ?_
      rw [elemHom_comp, elemHom_comp]
      congr 1
      have hnat_α := congrArg (fun f : H₁.obj.obj (Opposite.op W) ⟶ H₂.obj.obj (Opposite.op T_k) => f x)
        (α.hom.naturality (Opposite.op γ))
      have hnat_β := congrArg (fun f : H₁.obj.obj (Opposite.op W) ⟶ H₂.obj.obj (Opposite.op T_k) => f x)
        (β.hom.naturality (Opposite.op γ))
      change H₂.obj.map (Opposite.op γ) (α.hom.app (Opposite.op W) x) =
        H₂.obj.map (Opposite.op γ) (β.hom.app (Opposite.op W) x)
      exact hnat_α.symm.trans ((congrArg (fun g : H₁.obj.obj (Opposite.op T_k) ⟶ H₂.obj.obj (Opposite.op T_k) =>
        g (H₁.obj.map (Opposite.op γ) x)) hTk).trans hnat_β)
    have h_ev := congrArg (fun f : Z_obj ⟶ H₂.obj.obj (Opposite.op W) => f (ULift.up 1)) h_eq_hom
    rwa [elemHom_one, elemHom_one] at h_ev

  have hSpecTermIso : ∀ {H₁ H₂ : CategoryTheory.Sheaf S_k.smallEtaleTopology AddCommGrpCat.{u}}
      (ψ : H₁ ⟶ H₂),
      Function.Bijective ((ψ.hom.app (Opposite.op T_k)).hom) →
      CategoryTheory.IsIso ψ := by
    intro H₁ H₂ ψ hBij
    have : CategoryTheory.Mono ψ :=
      ⟨fun {Z} g₁ g₂ hg => hSpecTermHomExt g₁ g₂ (AddCommGrpCat.ext fun x => hBij.1 (by
        have h1 := congrArg (fun m : Z ⟶ H₂ => m.hom.app (Opposite.op T_k) x) hg
        exact h1))⟩
    have : CategoryTheory.Epi ψ :=
      ⟨fun {Z} g₁ g₂ hg => hSpecTermHomExt g₁ g₂ (AddCommGrpCat.ext fun y => by
        obtain ⟨x, rfl⟩ := hBij.2 y
        exact congrArg (fun m : H₁ ⟶ Z => m.hom.app (Opposite.op T_k) x) hg)⟩
    exact CategoryTheory.isIso_of_mono_of_epi ψ

  
  have hIsoCons :
      ∀ (S : CategoryTheory.Over S_k) [AlgebraicGeometry.LocallyOfFiniteType S.hom]
        {G₁ G₂ : CategoryTheory.Sheaf S.left.smallEtaleTopology AddCommGrpCat.{u}}
        (Φ : Quiver.Hom G₁ G₂),
      (∀ (s : Quiver.Hom S_k S.left),
        CategoryTheory.CategoryStruct.comp s S.hom = CategoryTheory.CategoryStruct.id S_k →
        ∃ (hCont : (weilEtaleSitePullback s).IsContinuous S.left.smallEtaleTopology S_k.smallEtaleTopology)
          (hAdj : (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _
            (weilEtaleSitePullback s) AddCommGrpCat.{u} _
            S.left.smallEtaleTopology S_k.smallEtaleTopology hCont).IsRightAdjoint),
          let pb_s := @CategoryTheory.Functor.sheafPullback _ _ _ _
            (weilEtaleSitePullback s) AddCommGrpCat.{u} _
            S.left.smallEtaleTopology S_k.smallEtaleTopology hCont hAdj
          Function.Bijective (((pb_s.map Φ).hom.app (Opposite.op T_k)).hom)) →
      CategoryTheory.IsIso Φ := by
    intro S _ G₁ G₂ Φ hBijAll
    have hKerZero : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.kernel Φ) := by
      apply hZeroCons S (CategoryTheory.Limits.kernel Φ)
      intro s hs
      obtain ⟨hCont, hAdj, hBij⟩ := hBijAll s hs
      cases Subsingleton.elim hCont (@hc_all S_k S.left s)
      cases Subsingleton.elim hAdj (@hr_all S_k S.left s)
      let pb_s := @CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback s)
        AddCommGrpCat.{u} _ S.left.smallEtaleTopology S_k.smallEtaleTopology
        (@hc_all S_k S.left s) (@hr_all S_k S.left s)
      have : pb_s.Additive := (hSiteExact s).1
      have : CategoryTheory.Limits.PreservesFiniteLimits pb_s := (hSiteExact s).2.1
      have : CategoryTheory.IsIso (pb_s.map Φ) := hSpecTermIso (pb_s.map Φ) hBij
      refine ⟨CategoryTheory.Limits.kernel (pb_s.map Φ),
        ⟨@hc_all S_k S.left s, @hr_all S_k S.left s, ⟨CategoryTheory.Limits.PreservesKernel.iso pb_s Φ⟩⟩,
        (CategoryTheory.Preadditive.mono_iff_isZero_kernel (pb_s.map Φ)).mp inferInstance⟩
    have hCokerZero : CategoryTheory.Limits.IsZero (CategoryTheory.Limits.cokernel Φ) := by
      apply hZeroCons S (CategoryTheory.Limits.cokernel Φ)
      intro s hs
      obtain ⟨hCont, hAdj, hBij⟩ := hBijAll s hs
      cases Subsingleton.elim hCont (@hc_all S_k S.left s)
      cases Subsingleton.elim hAdj (@hr_all S_k S.left s)
      let pb_s := @CategoryTheory.Functor.sheafPullback _ _ _ _ (weilEtaleSitePullback s)
        AddCommGrpCat.{u} _ S.left.smallEtaleTopology S_k.smallEtaleTopology
        (@hc_all S_k S.left s) (@hr_all S_k S.left s)
      have : pb_s.Additive := (hSiteExact s).1
      have : CategoryTheory.Limits.PreservesFiniteColimits pb_s := (hSiteExact s).2.2
      have : CategoryTheory.IsIso (pb_s.map Φ) := hSpecTermIso (pb_s.map Φ) hBij
      refine ⟨CategoryTheory.Limits.cokernel (pb_s.map Φ),
        ⟨@hc_all S_k S.left s, @hr_all S_k S.left s, ⟨CategoryTheory.Limits.PreservesCokernel.iso pb_s Φ⟩⟩,
        (CategoryTheory.Preadditive.epi_iff_isZero_cokernel (pb_s.map Φ)).mp inferInstance⟩
    have : CategoryTheory.Mono Φ := (CategoryTheory.Preadditive.mono_iff_isZero_kernel Φ).mpr hKerZero
    have : CategoryTheory.Epi Φ := (CategoryTheory.Preadditive.epi_iff_isZero_cokernel Φ).mpr hCokerZero
    exact CategoryTheory.isIso_of_mono_of_epi Φ

  
  
  
  refine ⟨hZeroCons, hIsoCons, ?_⟩

  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) f :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
