        change CategoryTheory.CategoryStruct.comp ιℤ (CategoryTheory.CategoryStruct.comp πℤ (one_of S₁)) = _
        rw [← CategoryTheory.Category.assoc, hι_πℤ, CategoryTheory.Category.id_comp]
      dsimp [δ_const_of]
      rw [pb_g.map_comp, pb_g.map_comp]
