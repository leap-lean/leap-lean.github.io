  have : CategoryTheory.IsIso cFl := hConstIso A_Fl
  let Fl_W := weilEtaleTorsionSheaf X_W ℓ
  let Fl_b := weilEtaleTorsionSheaf X_b ℓ
  let C_W := CategoryTheory.constantSheaf X_W.smallEtaleTopology AddCommGrpCat.{u}
  let C_b := CategoryTheory.constantSheaf X_b.smallEtaleTopology AddCommGrpCat.{u}
  let Fℤ_b := C_b.obj Z_ulift
  let adj_cW := CategoryTheory.constantSheafAdj X_W.smallEtaleTopology AddCommGrpCat.{u} hT_XW
  let adj_cXb := CategoryTheory.constantSheafAdj X_b.smallEtaleTopology AddCommGrpCat.{u} hT_Xb
  dsimp only []
  intro hVan

  
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have : Fact (1 < ℓ) := ⟨hPrime.one_lt⟩
  have hℓ_int_ne : (ℓ : ℤ) ≠ 0 := Nat.cast_ne_zero.mpr hPrime.ne_zero

  let m_ℓ : Z_ulift ⟶ Z_ulift :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((ℓ : ℤ) * z.down)
        map_zero' := congrArg ULift.up (mul_zero (ℓ : ℤ))
        map_add' := fun x y => congrArg ULift.up (mul_add (ℓ : ℤ) x.down y.down) }
  let p_ℓ : Z_ulift ⟶ A_Fl :=
    AddCommGrpCat.ofHom
      { toFun := fun z => ULift.up ((z.down : ℤ) : ZMod ℓ)
        map_zero' := congrArg ULift.up Int.cast_zero
        map_add' := fun x y => congrArg ULift.up (Int.cast_add x.down y.down) }
  have hm_p : m_ℓ ≫ p_ℓ = 0 := by
    refine AddCommGrpCat.ext fun ⟨z⟩ => ?_
    change ULift.up ((((ℓ : ℤ) * z : ℤ) : ZMod ℓ)) = ULift.up 0
    congr 1
    rw [Int.cast_mul, Int.cast_natCast, CharP.cast_eq_zero (ZMod ℓ) ℓ, zero_mul]
  have : CategoryTheory.Mono m_ℓ := by
    rw [AddCommGrpCat.mono_iff_injective]
    rintro ⟨z₁⟩ ⟨z₂⟩ h
    have hz : (ℓ : ℤ) * z₁ = (ℓ : ℤ) * z₂ := congrArg ULift.down h
    exact congrArg ULift.up (mul_left_cancel₀ hℓ_int_ne hz)
  have : CategoryTheory.Epi p_ℓ := by
    rw [AddCommGrpCat.epi_iff_surjective]
    rintro ⟨a⟩
    refine ⟨ULift.up (a.val : ℤ), ?_⟩
    change ULift.up (((a.val : ℤ) : ZMod ℓ)) = ULift.up a
    congr 1
    rw [Int.cast_natCast, ZMod.natCast_zmod_val]
  have h_dvd_of_pℓ_zero :
      ∀ {W_ab : AddCommGrpCat.{u}} (g' : W_ab ⟶ Z_ulift),
        g' ≫ p_ℓ = 0 → ∀ w : ↥W_ab, (ℓ : ℤ) ∣ (g'.hom w).down := by
    intro W_ab g' hg' w
    have hw0 : ((g' ≫ p_ℓ).hom w).down = 0 :=
      congrArg ULift.down (ConcreteCategory.congr_hom hg' w)
    have hcast0 : (((g'.hom w).down : ℤ) : ZMod ℓ) = 0 := hw0
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hcast0
  let lift_mℓ : ∀ {W_ab : AddCommGrpCat.{u}} (g' : W_ab ⟶ Z_ulift),
      g' ≫ p_ℓ = 0 → (W_ab ⟶ Z_ulift) :=
    fun {_} g' hg' =>
      AddCommGrpCat.ofHom
        { toFun := fun w => ULift.up ((g'.hom w).down / (ℓ : ℤ))
          map_zero' := by
            change ULift.up ((g'.hom 0).down / (ℓ : ℤ)) = ULift.up 0
            rw [map_zero]
            exact congrArg ULift.up (Int.zero_ediv (ℓ : ℤ))
          map_add' := fun w₁ w₂ => by
            change ULift.up ((g'.hom (w₁ + w₂)).down / (ℓ : ℤ)) =
              ULift.up ((g'.hom w₁).down / (ℓ : ℤ) + (g'.hom w₂).down / (ℓ : ℤ))
            rw [map_add]
            exact congrArg ULift.up
              (Int.add_ediv_of_dvd_left (h_dvd_of_pℓ_zero g' hg' w₁)) }
  have hKer_mℓ : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι m_ℓ hm_p) :=
    CategoryTheory.Limits.KernelFork.IsLimit.ofι m_ℓ hm_p
      (fun g' hg' => lift_mℓ g' hg')
      (fun g' hg' => by
        refine AddCommGrpCat.ext fun w => ?_
        change ULift.up ((ℓ : ℤ) * ((g'.hom w).down / (ℓ : ℤ))) = g'.hom w
        have heq := Int.mul_ediv_cancel' (h_dvd_of_pℓ_zero g' hg' w)
        cases hgw : g'.hom w
        exact congrArg ULift.up (by simpa [hgw] using heq))
      (fun g' hg' m' hm' => by
        apply (cancel_mono m_ℓ).mp
        rw [hm']
        symm
        refine AddCommGrpCat.ext fun w => ?_
        change ULift.up ((ℓ : ℤ) * ((g'.hom w).down / (ℓ : ℤ))) = g'.hom w
        have heq := Int.mul_ediv_cancel' (h_dvd_of_pℓ_zero g' hg' w)
        cases hgw : g'.hom w
        exact congrArg ULift.up (by simpa [hgw] using heq))
  have hSE_ab : (CategoryTheory.ShortComplex.mk m_ℓ p_ℓ hm_p).ShortExact :=
    { exact := CategoryTheory.ShortComplex.exact_of_f_is_kernel _ hKer_mℓ
      mono_f := inferInstance
      epi_g := inferInstance }

  have : CategoryTheory.Functor.IsLeftAdjoint C_b := adj_cXb.isLeftAdjoint
  have : CategoryTheory.Limits.PreservesFiniteColimits C_b := inferInstance
  have : CategoryTheory.Limits.PreservesFiniteLimits C_b :=
    CategoryTheory.Limits.comp_preservesFiniteLimits
      (CategoryTheory.Functor.const (Opposite X_b.Etale))
      (CategoryTheory.presheafToSheaf X_b.smallEtaleTopology AddCommGrpCat.{u})
  have : C_b.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products C_b
  have hSE_Zb : ((CategoryTheory.ShortComplex.mk m_ℓ p_ℓ hm_p).map C_b).ShortExact :=
    hSE_ab.map_of_exact C_b

  
  let x_1 : ↥(Q_W.obj.obj (Opposite.op T_XW)) :=
    (q_Z.hom.app (Opposite.op T_XW)).hom ((adj_cW.unit.app Z_ulift).hom (ULift.up (1 : ℤ)))
  have hx_1_tor : ℓ • x_1 = 0 := by
    let Ev_XW : CategoryTheory.Sheaf X_W.smallEtaleTopology AddCommGrpCat.{u} ⥤ AddCommGrpCat.{u} :=
      CategoryTheory.sheafToPresheaf X_W.smallEtaleTopology AddCommGrpCat.{u} ⋙
        (CategoryTheory.evaluation (Opposite X_W.Etale) AddCommGrpCat.{u}).obj (Opposite.op T_XW)
    have : CategoryTheory.Limits.PreservesFiniteLimits Ev_XW :=
      CategoryTheory.Limits.comp_preservesFiniteLimits _ _
    have : Ev_XW.Additive := CategoryTheory.Functor.additive_of_preserves_binary_products Ev_XW
    have hEv0 : ℓ • CategoryTheory.CategoryStruct.id (Ev_XW.obj Q_W) = 0 := by
      rw [← Ev_XW.map_id, ← Ev_XW.map_nsmul, hQ_tor, Ev_XW.map_zero]
    simpa using ConcreteCategory.congr_hom hEv0 x_1
  have hmod_nsmul : ∀ m : ℕ, (m % ℓ) • x_1 = m • x_1 := by
    intro m
    conv_rhs => rw [← Nat.mod_add_div m ℓ]
    rw [add_nsmul, mul_comm ℓ (m / ℓ), mul_nsmul', hx_1_tor, nsmul_zero, add_zero]
  let g_Fl : A_Fl ⟶ Q_W.obj.obj (Opposite.op T_XW) :=
    AddCommGrpCat.ofHom
      { toFun := fun a => a.down.val • x_1
        map_zero' := by
          change (0 : ZMod ℓ).val • x_1 = 0
          rw [ZMod.val_zero, zero_nsmul]
        map_add' := fun a b => by
          change (a.down + b.down).val • x_1 = a.down.val • x_1 + b.down.val • x_1
          rw [ZMod.val_add, hmod_nsmul, add_nsmul] }
  let q_hat : Fl_W ⟶ Q_W := (adj_cW.homEquiv A_Fl Q_W).symm g_Fl
  have hq_hat_unit :
      adj_cW.unit.app A_Fl ≫ q_hat.hom.app (Opposite.op T_XW) = g_Fl := by
    change adj_cW.homEquiv A_Fl Q_W q_hat = g_Fl
    exact (adj_cW.homEquiv A_Fl Q_W).apply_symm_apply g_Fl
  have hq_hat_1 :
      (q_hat.hom.app (Opposite.op T_XW)).hom
        ((adj_cW.unit.app A_Fl).hom (ULift.up (1 : ZMod ℓ))) = x_1 := by
    have h1 := ConcreteCategory.congr_hom hq_hat_unit (ULift.up (1 : ZMod ℓ))
    change (q_hat.hom.app (Opposite.op T_XW)).hom
        ((adj_cW.unit.app A_Fl).hom (ULift.up (1 : ZMod ℓ))) =
      (1 : ZMod ℓ).val • x_1 at h1
    rwa [ZMod.val_one, one_nsmul] at h1
  have hq_Z_fac : C_W.map p_ℓ ≫ q_hat = q_Z := by
    apply (adj_cW.homEquiv Z_ulift Q_W).injective
    refine AddCommGrpCat.ext fun ⟨n⟩ => ?_
    have hn_up : (ULift.up n : ↥Z_ulift) = n • ULift.up (1 : ℤ) :=
      congrArg ULift.up (zsmul_one n).symm
    rw [hn_up, map_zsmul, map_zsmul]
    congr 1
    have hnat := ConcreteCategory.congr_hom (adj_cW.unit.naturality p_ℓ).symm (ULift.up (1 : ℤ))
    change ((C_W.map p_ℓ).hom.app (Opposite.op T_XW)).hom
        ((adj_cW.unit.app Z_ulift).hom (ULift.up (1 : ℤ))) =
      (adj_cW.unit.app A_Fl).hom (ULift.up (((1 : ℤ) : ZMod ℓ))) at hnat
    rw [Int.cast_one] at hnat
    change (q_hat.hom.app (Opposite.op T_XW)).hom
        (((C_W.map p_ℓ).hom.app (Opposite.op T_XW)).hom
          ((adj_cW.unit.app Z_ulift).hom (ULift.up (1 : ℤ)))) = x_1
    rw [hnat]
    exact hq_hat_1

  have hc_nat : pb.map (C_W.map p_ℓ) ≫ cFl = cℤ ≫ C_b.map p_ℓ := by
    dsimp [cFl, cℤ, weilEtaleConstPullbackHom]
    let τ : (weilEtaleSitePullback ι).obj T_XW ⟶ T_Xb :=
      hT_Xb.from ((weilEtaleSitePullback ι).obj T_XW)
    refine (adj_ι_W.homEquiv_naturality_right_square_iff _ _ _ _).mpr ?_
    refine (adj_cW.homEquiv_naturality_right_square_iff _ _ _ _).mpr ?_
    have h_unit_b :
        adj_cXb.unit.app Z_ulift ≫ (C_b.map p_ℓ).hom.app (Opposite.op T_Xb) =
          p_ℓ ≫ adj_cXb.unit.app A_Fl :=
      (adj_cXb.unit.naturality p_ℓ).symm
    change p_ℓ ≫ (adj_cXb.unit.app A_Fl ≫ Fl_b.obj.map τ.op) =
      (adj_cXb.unit.app Z_ulift ≫ Fℤ_b.obj.map τ.op) ≫
        (C_b.map p_ℓ).hom.app (Opposite.op ((weilEtaleSitePullback ι).obj T_XW))
    rw [CategoryTheory.Category.assoc,
      (C_b.map p_ℓ).hom.naturality τ.op,
      ← CategoryTheory.Category.assoc (adj_cXb.unit.app Z_ulift),
      h_unit_b,
      CategoryTheory.Category.assoc]
  have hc_inv_nat : cℤ_inv ≫ pb.map (C_W.map p_ℓ) = C_b.map p_ℓ ≫ CategoryTheory.inv cFl := by
    have hcℤ_inv_eq : cℤ_inv = CategoryTheory.inv cℤ := rfl
    rw [hcℤ_inv_eq]
    calc
      CategoryTheory.inv cℤ ≫ pb.map (C_W.map p_ℓ)
        = CategoryTheory.inv cℤ ≫ (pb.map (C_W.map p_ℓ) ≫ cFl) ≫ CategoryTheory.inv cFl := by
            simp
      _ = CategoryTheory.inv cℤ ≫ (cℤ ≫ C_b.map p_ℓ) ≫ CategoryTheory.inv cFl := by
            rw [hc_nat]
      _ = C_b.map p_ℓ ≫ CategoryTheory.inv cFl := by
            simp
  have h_fac_b :
      cℤ_inv ≫ pb.map q_Z =
        C_b.map p_ℓ ≫ (CategoryTheory.inv cFl ≫ pb.map q_hat) := by
    rw [← hq_Z_fac, pb.map_comp, ← CategoryTheory.Category.assoc cℤ_inv, hc_inv_nat,
      CategoryTheory.Category.assoc]

  
  let E_W := CategoryTheory.Limits.pullback v_W q_hat
  let pr₁ : E_W ⟶ J_W := CategoryTheory.Limits.pullback.fst v_W q_hat
  let pr₂ : E_W ⟶ Fl_W := CategoryTheory.Limits.pullback.snd v_W q_hat
  let i_W : F_W ⟶ E_W :=
    CategoryTheory.Limits.pullback.lift u_W (0 : F_W ⟶ Fl_W)
      (huv_W.trans CategoryTheory.Limits.zero_comp.symm)
  have hi_pr₁ : i_W ≫ pr₁ = u_W := CategoryTheory.Limits.pullback.lift_fst _ _ _
  have h_zero : i_W ≫ pr₂ = 0 := CategoryTheory.Limits.pullback.lift_snd _ _ _
  have h_comm_EW : pr₁ ≫ v_W = pr₂ ≫ q_hat := CategoryTheory.Limits.pullback.condition

  have hE_tor : ℓ • CategoryTheory.CategoryStruct.id E_W = 0 := by
    apply CategoryTheory.Limits.pullback.hom_ext
    · calc
        (ℓ • CategoryTheory.CategoryStruct.id E_W) ≫ pr₁
          = ℓ • (CategoryTheory.CategoryStruct.id E_W ≫ pr₁) :=
              CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = ℓ • (pr₁ ≫ CategoryTheory.CategoryStruct.id J_W) := by simp
        _ = pr₁ ≫ (ℓ • CategoryTheory.CategoryStruct.id J_W) :=
              (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = 0 ≫ pr₁ := by rw [hJ_tor]; simp
    · calc
        (ℓ • CategoryTheory.CategoryStruct.id E_W) ≫ pr₂
          = ℓ • (CategoryTheory.CategoryStruct.id E_W ≫ pr₂) :=
              CategoryTheory.Preadditive.nsmul_comp _ _ _
        _ = ℓ • (pr₂ ≫ CategoryTheory.CategoryStruct.id Fl_W) := by simp
        _ = pr₂ ≫ (ℓ • CategoryTheory.CategoryStruct.id Fl_W) :=
              (CategoryTheory.Preadditive.comp_nsmul _ _ _).symm
        _ = 0 ≫ pr₂ := by rw [hTorFl X_W]; simp

  have : CategoryTheory.Mono u_W := hSE_W.mono_f
  have hKer_uW := hSE_W.fIsKernel
  have h_kill_vW :
      ∀ {W_sh : CategoryTheory.Sheaf X_W.smallEtaleTopology AddCommGrpCat.{u}}
        (g' : W_sh ⟶ E_W),
        g' ≫ pr₂ = 0 → (g' ≫ pr₁) ≫ v_W = 0 := by
    intro W_sh g' hg'
    rw [CategoryTheory.Category.assoc, h_comm_EW, ← CategoryTheory.Category.assoc, hg',
      CategoryTheory.Limits.zero_comp]
  have hKer_EW : CategoryTheory.Limits.IsLimit
      (CategoryTheory.Limits.KernelFork.ofι i_W h_zero) :=
    CategoryTheory.Limits.KernelFork.IsLimit.ofι i_W h_zero
      (fun g' hg' =>
        (CategoryTheory.Limits.KernelFork.IsLimit.lift' hKer_uW (g' ≫ pr₁)
          (h_kill_vW g' hg')).1)
      (fun g' hg' => by
        apply CategoryTheory.Limits.pullback.hom_ext
        · rw [CategoryTheory.Category.assoc, hi_pr₁]
          exact (CategoryTheory.Limits.KernelFork.IsLimit.lift' hKer_uW (g' ≫ pr₁)
            (h_kill_vW g' hg')).2
        · rw [CategoryTheory.Category.assoc, h_zero, CategoryTheory.Limits.comp_zero, hg'])
      (fun g' hg' m' hm' => by
        apply (cancel_mono u_W).mp
        calc
          m' ≫ u_W = m' ≫ (i_W ≫ pr₁) := by rw [hi_pr₁]
          _ = (m' ≫ i_W) ≫ pr₁ := (CategoryTheory.Category.assoc _ _ _).symm
          _ = g' ≫ pr₁ := by rw [hm']
          _ = _ := ((CategoryTheory.Limits.KernelFork.IsLimit.lift' hKer_uW (g' ≫ pr₁)
            (h_kill_vW g' hg')).2).symm)

  
  let hSE_b := hSE_W.map_of_exact pb
  let q_hat_b : Fl_b ⟶ pb.obj Q_W := CategoryTheory.inv cFl ≫ pb.map q_hat
  have hVan_Zb :
      (CategoryTheory.Abelian.Ext.mk₀ ((CategoryTheory.ShortComplex.mk m_ℓ p_ℓ hm_p).map C_b).g).comp
        ((CategoryTheory.Abelian.Ext.mk₀ q_hat_b).comp hSE_b.extClass (Nat.zero_add 1))
        (Nat.zero_add 1) = 0 := by
    change (CategoryTheory.Abelian.Ext.mk₀ (C_b.map p_ℓ)).comp
        ((CategoryTheory.Abelian.Ext.mk₀ q_hat_b).comp hSE_b.extClass (Nat.zero_add 1))
        (Nat.zero_add 1) = 0
    rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
    change (CategoryTheory.Abelian.Ext.mk₀
        (C_b.map p_ℓ ≫ (CategoryTheory.inv cFl ≫ pb.map q_hat))).comp
        hSE_b.extClass (Nat.zero_add 1) = 0
    rwa [← h_fac_b]

  obtain ⟨x₀, hx₀⟩ :=
    CategoryTheory.Abelian.Ext.contravariant_sequence_exact₃ hSE_Zb (pb.obj F_W)
      ((CategoryTheory.Abelian.Ext.mk₀ q_hat_b).comp hSE_b.extClass (Nat.zero_add 1))
      hVan_Zb (Nat.add_zero 1)
  have hx₀_zero : x₀ = 0 := @Subsingleton.elim ((pb.obj F_W).H 0) hSub₀ x₀ 0
  have hVan_Flb :
      (CategoryTheory.Abelian.Ext.mk₀ q_hat_b).comp hSE_b.extClass (Nat.zero_add 1) = 0 := by
    rw [← hx₀, hx₀_zero, CategoryTheory.Abelian.Ext.comp_zero]

  obtain ⟨y₀, hy₀⟩ :=
    CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ Fl_b hSE_b
      (CategoryTheory.Abelian.Ext.mk₀ q_hat_b) (Nat.zero_add 1) hVan_Flb
  let σ_tilde : Fl_b ⟶ pb.obj J_W := CategoryTheory.Abelian.Ext.addEquiv₀ y₀
  have hσ_tilde : σ_tilde ≫ pb.map v_W = CategoryTheory.inv cFl ≫ pb.map q_hat := by
    apply (CategoryTheory.Abelian.Ext.addEquiv₀ (X := Fl_b) (Y := pb.obj Q_W)).symm.injective
    rw [CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply,
      ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ σ_tilde (pb.map v_W),
      CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply]
    exact hy₀

  have hp_EW : CategoryTheory.IsPullback pr₁ pr₂ v_W q_hat :=
    CategoryTheory.IsPullback.of_hasPullback v_W q_hat
  have hp_Eb : CategoryTheory.IsPullback (pb.map pr₁) (pb.map pr₂) (pb.map v_W) (pb.map q_hat) :=
    hp_EW.map pb
  let s_split : Fl_b ⟶ pb.obj E_W := hp_Eb.lift σ_tilde (CategoryTheory.inv cFl) hσ_tilde
  let π₂_b : pb.obj E_W ⟶ Fl_b := pb.map pr₂ ≫ cFl
  have hs_split : s_split ≫ π₂_b = CategoryTheory.CategoryStruct.id Fl_b := by
    dsimp [s_split, π₂_b]
    rw [← CategoryTheory.Category.assoc, hp_Eb.lift_snd, CategoryTheory.IsIso.inv_hom_id]

  let post_π₂ : (Fℤ_b ⟶ pb.obj E_W) → (Fℤ_b ⟶ Fl_b) := fun η => η ≫ π₂_b
  have hSurj_post : Function.Surjective post_π₂ := by
    intro γ
    refine ⟨γ ≫ s_split, ?_⟩
    dsimp [post_π₂]
    rw [CategoryTheory.Category.assoc, hs_split, CategoryTheory.Category.comp_id]
  have hInj_post : Function.Injective post_π₂ := by
    intro η₁ η₂ hη
    have hpr₂_eq : η₁ ≫ pb.map pr₂ = η₂ ≫ pb.map pr₂ := by
      apply (cancel_mono cFl).mp
      simpa [post_π₂, π₂_b, CategoryTheory.Category.assoc] using hη
    let δ : Fℤ_b ⟶ pb.obj E_W := η₁ - η₂
    have hδ₂ : δ ≫ pb.map pr₂ = 0 := by
      dsimp [δ]
      rw [CategoryTheory.Preadditive.sub_comp, hpr₂_eq, sub_self]
    have hδ_v : (δ ≫ pb.map pr₁) ≫ pb.map v_W = 0 := by
      rw [CategoryTheory.Category.assoc, hp_Eb.w, ← CategoryTheory.Category.assoc, hδ₂,
        CategoryTheory.Limits.zero_comp]
    obtain ⟨l₀, hl₀⟩ :=
      CategoryTheory.Limits.KernelFork.IsLimit.lift' hSE_b.fIsKernel (δ ≫ pb.map pr₁) hδ_v
    have hl₀_zero : l₀ = 0 := by
      apply (CategoryTheory.Abelian.Ext.addEquiv₀ (X := Fℤ_b) (Y := pb.obj F_W)).symm.injective
      exact @Subsingleton.elim ((pb.obj F_W).H 0) hSub₀ _ _
    have hδ₁ : δ ≫ pb.map pr₁ = 0 := by
      have hl₀' : l₀ ≫ pb.map u_W = δ ≫ pb.map pr₁ := hl₀
      rw [← hl₀', hl₀_zero, CategoryTheory.Limits.zero_comp]
    have hδ_zero : δ = 0 := by
      apply hp_Eb.hom_ext
      · rw [hδ₁, CategoryTheory.Limits.zero_comp]
      · rw [hδ₂, CategoryTheory.Limits.zero_comp]
    exact sub_eq_zero.mp hδ_zero

  let e_H0 : ((pb.obj E_W).H 0) ≃ weilEtaleTorsionH X_b ℓ 0 :=
    ((CategoryTheory.Abelian.Ext.addEquiv₀ (X := Fℤ_b) (Y := pb.obj E_W)).toEquiv.trans
      (Equiv.ofBijective post_π₂ ⟨hInj_post, hSurj_post⟩)).trans
      (CategoryTheory.Abelian.Ext.addEquiv₀ (X := Fℤ_b) (Y := Fl_b)).symm.toEquiv

  exact ⟨E_W, i_W, pr₁, pr₂, q_hat, h_zero, hE_tor, h_comm_EW, hq_hat_1, ⟨hKer_EW⟩, ⟨e_H0⟩⟩

theorem weil_etale_proper_r1_fiber_eval_nat_and_injective_of_h0_subsingleton (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hPBC : WeilProperModPrimeBaseChangeHolds k ℓ)
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h)).IsRightAdjoint)
    (hPbExact : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      letI := @hc_all Z₁ Z₂ h
      letI := @hr_all Z₁ Z₂ h
      let pb := (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology
      CategoryTheory.Limits.PreservesFiniteLimits pb ∧ pb.Additive)
    (hInjRes : ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (F : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
      ℓ • CategoryTheory.CategoryStruct.id F = 0 →
      ∃ (J_ab Q : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u})
        (u_F : Quiver.Hom F J_ab) (v_F : Quiver.Hom J_ab Q)
        (huv : CategoryTheory.CategoryStruct.comp u_F v_F = 0),
        ℓ • CategoryTheory.CategoryStruct.id J_ab = 0 ∧
        ℓ • CategoryTheory.CategoryStruct.id Q = 0 ∧
        (CategoryTheory.ShortComplex.mk u_F v_F huv).ShortExact ∧
        ∀ {B : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom Z B),
          CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage g 1 J_ab))
    (hR0Iso : ∀ {Z B : AlgebraicGeometry.Scheme.{u}} (g : Quiver.Hom Z B),
      letI := @hc_all Z B g
      ∀ (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        Nonempty (CategoryTheory.Iso
          (weilEtaleHigherDirectImage g 0 G)
          (((weilEtaleSitePullback g).sheafPushforwardContinuous AddCommGrpCat.{u}
            B.smallEtaleTopology Z.smallEtaleTopology).obj G)))
    (hSkUnitIso :
      ∀ (P : CategoryTheory.Functor
          (Opposite (AlgebraicGeometry.Spec (CommRingCat.of k)).Etale) AddCommGrpCat.{u}),
        CategoryTheory.IsIso
          (((CategoryTheory.sheafificationAdjunction
            (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
            AddCommGrpCat.{u}).unit.app P).app
            (Opposite.op
              (weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k))))))
    (hStalkColim :
      ∀ (Z : AlgebraicGeometry.Scheme.{u})
        (z : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) Z)
        (G : CategoryTheory.Sheaf Z.smallEtaleTopology AddCommGrpCat.{u}),
        letI := @hc_all (AlgebraicGeometry.Spec (CommRingCat.of k)) Z z
        letI := @hr_all (AlgebraicGeometry.Spec (CommRingCat.of k)) Z z
        let T_k := weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k))
        let pb_z := (weilEtaleSitePullback z).sheafPullback AddCommGrpCat.{u}
          Z.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
        let adj_z := (weilEtaleSitePullback z).sheafAdjunctionContinuous AddCommGrpCat.{u}
          Z.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
        (∀ (x : ↥((pb_z.obj G).obj.obj (Opposite.op T_k))),
          ∃ (W : Z.Etale)
            (τ_W : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W))
            (s : ↥(G.obj.obj (Opposite.op W))),
            ((pb_z.obj G).obj.map (Opposite.op τ_W)).hom
              (((adj_z.unit.app G).hom.app (Opposite.op W)).hom s) = x) ∧
        (∀ (W : Z.Etale)
            (τ_W : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W))
            (s : ↥(G.obj.obj (Opposite.op W))),
          ((pb_z.obj G).obj.map (Opposite.op τ_W)).hom
            (((adj_z.unit.app G).hom.app (Opposite.op W)).hom s) = 0 →
          ∃ (W' : Z.Etale) (g : Quiver.Hom W' W)
            (τ_W' : Quiver.Hom T_k ((weilEtaleSitePullback z).obj W')),
            CategoryTheory.CategoryStruct.comp τ_W' ((weilEtaleSitePullback z).map g) = τ_W ∧
            (G.obj.map (Opposite.op g)).hom s = 0))
    (hH0Fin : ∀ (Y : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k))),
      AlgebraicGeometry.IsProper Y.hom →
      Finite (weilEtaleTorsionH Y.left ℓ 0))
    (hTorFl : ∀ (Z : AlgebraicGeometry.Scheme.{u}),
      ℓ • CategoryTheory.CategoryStruct.id (weilEtaleTorsionSheaf Z ℓ) = 0)
    (hConstPullIso : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂)
        (A : AddCommGrpCat.{u}),
      letI := @hc_all Z₁ Z₂ h
      letI := @hr_all Z₁ Z₂ h
      CategoryTheory.IsIso
        (weilEtaleConstPullbackHom h
          (weilEtaleIdTerminalIsTerminal.{u} Z₁)
          (weilEtaleIdTerminalIsTerminal.{u} Z₂) A))
    (X S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType S.hom]
    (f : Quiver.Hom X S)
    (hf : AlgebraicGeometry.IsProper f.left)
    (s_b : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of k)) S.left)
    (X_b : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (ι_b : Quiver.Hom X_b.left X.left)
    (hs_b : CategoryTheory.CategoryStruct.comp s_b S.hom =
      CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of k)))
    (hpb : CategoryTheory.IsPullback ι_b X_b.hom f.left s_b) :
    letI := @hc_all (AlgebraicGeometry.Spec (CommRingCat.of k)) S.left s_b
    letI := @hr_all (AlgebraicGeometry.Spec (CommRingCat.of k)) S.left s_b
    letI := @hc_all X_b.left X.left ι_b
    letI := @hr_all X_b.left X.left ι_b
    let T_k := weilEtaleIdTerminal.{u} (AlgebraicGeometry.Spec (CommRingCat.of k))
    let pb_s := (weilEtaleSitePullback s_b).sheafPullback AddCommGrpCat.{u}
      S.left.smallEtaleTopology (AlgebraicGeometry.Spec (CommRingCat.of k)).smallEtaleTopology
    let pb_ι := (weilEtaleSitePullback ι_b).sheafPullback AddCommGrpCat.{u}
      X.left.smallEtaleTopology X_b.left.smallEtaleTopology
    let Fℤ_Xb := (CategoryTheory.constantSheaf X_b.left.smallEtaleTopology
      AddCommGrpCat.{u}).obj (AddCommGrpCat.of (ULift.{u} ℤ))
    ∃ β : ∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
        ↥((pb_s.obj (weilEtaleHigherDirectImage f.left 1 F)).obj.obj (Opposite.op T_k)) →+
          (pb_ι.obj F).H 1,
      (∀ {F₁ F₂ : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}}
          (φ : Quiver.Hom F₁ F₂)
          (x : ↥((pb_s.obj (weilEtaleHigherDirectImage f.left 1 F₁)).obj.obj
            (Opposite.op T_k))),
        β F₂ (((pb_s.map (weilEtaleHigherDirectImageMap f.left 1 φ)).hom.app
            (Opposite.op T_k)).hom x) =
          (CategoryTheory.Abelian.Ext.mk₀ (pb_ι.map φ)).postcomp Fℤ_Xb
            (Nat.add_zero 1) (β F₁ x)) ∧
      (∀ (F : CategoryTheory.Sheaf X.left.smallEtaleTopology AddCommGrpCat.{u}),
        ℓ • CategoryTheory.CategoryStruct.id F = 0 →
        Subsingleton ((pb_ι.obj F).H 0) →
        Function.Injective (β F)) :=
by
  classical
  let S_k := AlgebraicGeometry.Spec (CommRingCat.of k)
  let T_k := weilEtaleIdTerminal.{u} S_k
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong P_et h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong P_et h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have : P_et.IsStableUnderComposition :=
    CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology :=
    @hc_all
  have : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
        Z₂.smallEtaleTopology Z₁.smallEtaleTopology).IsRightAdjoint :=
    @hr_all
  let Z_ulift : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let A_Fl : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let shAdj_of := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
    CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
  let pb_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
    (weilEtaleSitePullback h).sheafPullback AddCommGrpCat.{u}
      Z₂.smallEtaleTopology Z₁.smallEtaleTopology
  let pf_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
    (weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
      Z₂.smallEtaleTopology Z₁.smallEtaleTopology
  let adj_of := fun {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂) =>
    (weilEtaleSitePullback h).sheafAdjunctionContinuous AddCommGrpCat.{u}
      Z₂.smallEtaleTopology Z₁.smallEtaleTopology
  let Z_fun := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
    CategoryTheory.yoneda ⋙
      ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u) AddCommGrpCat.{u}).obj
        AddCommGrpCat.free ⋙
        CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u})
  let ι_gen := fun (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale) =>
    ((((shAdj_of Z).unit.app ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)).app
      (Opposite.op V)).hom ((AddCommGrpCat.adj.unit.app (V ⟶ V)) (𝟙 V)))
  let pb_s := pb_of s_b
  let pf_s := pf_of s_b
  let adj_s := adj_of s_b
  let pb_ι := pb_of ι_b
  let adj_ι := adj_of ι_b
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_ι := (hPbExact ι_b).1
  have : pb_ι.Additive := (hPbExact ι_b).2
  have : CategoryTheory.Functor.IsLeftAdjoint pb_ι := adj_ι.isLeftAdjoint
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_ι := inferInstance
  let B_f := weilEtaleSitePullback f.left
  let B_s := weilEtaleSitePullback s_b
  let B_ι := weilEtaleSitePullback ι_b
  let Fℤ_Xb := (CategoryTheory.constantSheaf X_b.left.smallEtaleTopology AddCommGrpCat.{u}).obj Z_ulift
  let T_Xb := weilEtaleIdTerminal.{u} X_b.left
  let adj_cXb := CategoryTheory.constantSheafAdj X_b.left.smallEtaleTopology AddCommGrpCat.{u}
    (weilEtaleIdTerminalIsTerminal.{u} X_b.left)

  obtain ⟨he_fib, hSkEpiSurj, hCommSq⟩ :=
    weil_etale_comm_square_r_fiber_eval_and_epi_surj k (@hc_all) (@hr_all) (@hPbExact) hSkUnitIso
  obtain ⟨β, hβ_nat, hβ_eval⟩ := hCommSq f.left s_b X_b ι_b hpb.w 1
  obtain ⟨hConnDelta, hSliceRes⟩ :=
    weil_etale_connecting_epi_and_slice_res_iso (@hc_all) (@hr_all)
  refine ⟨β, fun φ x => hβ_nat φ x, ?_⟩
  intro F hF_tor hSub₀
  rw [injective_iff_map_eq_zero]
  intro ξ hβξ

  obtain ⟨J_ab, Q, u_F, v_F, huv, hJ_tor, hQ_tor, hSE, hJ_acyc⟩ :=
    hInjRes X.left F hF_tor
  obtain ⟨δ₀, hEpi_δ₀, hv_δ₀, hδ₀_eval⟩ :=
    hConnDelta f.left u_F v_F huv hSE (hJ_acyc f.left)
  let pf_f := pf_of f.left
  let R1F := weilEtaleHigherDirectImage f.left 1 F
  have : CategoryTheory.Functor.IsLeftAdjoint pb_s := adj_s.isLeftAdjoint
  have : CategoryTheory.Epi (pb_s.map δ₀) := pb_s.map_epi δ₀
  obtain ⟨q_tilde, hq_tilde⟩ := hSkEpiSurj (pb_s.map δ₀) ξ
  obtain ⟨W, τ_W, q₀, hq₀_rep⟩ := (hStalkColim S.left s_b (pf_f.obj Q)).1 q_tilde
  have hξ_rep : ξ =
      ((pb_s.obj R1F).obj.map (Opposite.op τ_W)).hom
        (((adj_s.unit.app R1F).hom.app (Opposite.op W)).hom
          ((δ₀.hom.app (Opposite.op W)).hom q₀)) := by
    rw [← hq_tilde, ← hq₀_rep]
    have hnat1 := ConcreteCategory.congr_hom
      ((pb_s.map δ₀).hom.naturality (Opposite.op τ_W))
      (((adj_s.unit.app (pf_f.obj Q)).hom.app (Opposite.op W)).hom q₀)
    have hnat2 := ConcreteCategory.congr_hom
      (CategoryTheory.NatTrans.congr_app
        (congrArg (fun m => m.hom) (adj_s.unit.naturality δ₀))
        (Opposite.op W)) q₀
    refine hnat1.trans ?_
    change ((pb_s.obj R1F).obj.map (Opposite.op τ_W)).hom
      (((adj_s.unit.app (pf_f.obj Q) ≫ pf_s.map (pb_s.map δ₀)).hom.app (Opposite.op W)).hom q₀) = _
    exact congrArg ((pb_s.obj R1F).obj.map (Opposite.op τ_W)).hom hnat2.symm

  let V₀ : X.left.Etale := B_f.obj W
  let X_W : AlgebraicGeometry.Scheme.{u} := V₀.left
  let p_W : X_W ⟶ X.left := V₀.hom
  let f_W : X_W ⟶ W.left := CategoryTheory.Limits.pullback.fst W.hom f.left
  have hpb_XW : CategoryTheory.IsPullback p_W f_W f.left W.hom :=
    (CategoryTheory.IsPullback.of_hasPullback W.hom f.left).flip
  let z_W : S_k ⟶ W.left := τ_W.left ≫ CategoryTheory.Limits.pullback.fst W.hom s_b
  have hτ_w : τ_W.left ≫ CategoryTheory.Limits.pullback.snd W.hom s_b = 𝟙 S_k :=
    CategoryTheory.MorphismProperty.Over.w τ_W
  have hz_W : z_W ≫ W.hom = s_b :=
    (CategoryTheory.Category.assoc τ_W.left
      (CategoryTheory.Limits.pullback.fst W.hom s_b) W.hom).trans
      ((congrArg (CategoryTheory.CategoryStruct.comp τ_W.left)
        (CategoryTheory.Limits.pullback.condition (f := W.hom) (g := s_b))).trans
        ((CategoryTheory.Category.assoc τ_W.left
          (CategoryTheory.Limits.pullback.snd W.hom s_b) s_b).symm.trans
          ((congrArg (fun m => m ≫ s_b) hτ_w).trans
            (CategoryTheory.Category.id_comp s_b))))
  have h_lift_bW : (X_b.hom ≫ z_W) ≫ W.hom = ι_b ≫ f.left :=
    (CategoryTheory.Category.assoc X_b.hom z_W W.hom).trans
      ((congrArg (CategoryTheory.CategoryStruct.comp X_b.hom) hz_W).trans hpb.w.symm)
  let ι_bW : X_b.left ⟶ X_W :=
    CategoryTheory.Limits.pullback.lift (X_b.hom ≫ z_W) ι_b h_lift_bW
  have hu_W : ι_bW ≫ f_W = X_b.hom ≫ z_W :=
    CategoryTheory.Limits.pullback.lift_fst _ _ _
  have hu_X : ι_bW ≫ p_W = ι_b :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hpb_bW : CategoryTheory.IsPullback ι_bW X_b.hom f_W z_W :=
    CategoryTheory.IsPullback.of_right
      (by rwa [hu_X, hz_W]) hu_W hpb_XW

  obtain ⟨α₀, hα₀_gen, hδ₀_q₀⟩ := hδ₀_eval W q₀
  let pb_pW := pb_of p_W
  let adj_pW := adj_of p_W
  let pb_bW := pb_of ι_bW
  let adj_bW := adj_of ι_bW
  let B_pW := weilEtaleSitePullback p_W
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_pW := (hPbExact p_W).1
  have : pb_pW.Additive := (hPbExact p_W).2
  have : CategoryTheory.Functor.IsLeftAdjoint pb_pW := adj_pW.isLeftAdjoint
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_pW := inferInstance
  have : CategoryTheory.Limits.PreservesFiniteLimits pb_bW := (hPbExact ι_bW).1
  have : pb_bW.Additive := (hPbExact ι_bW).2
  have : CategoryTheory.Functor.IsLeftAdjoint pb_bW := adj_bW.isLeftAdjoint
  have : CategoryTheory.Limits.PreservesFiniteColimits pb_bW := inferInstance

  let T_XW := weilEtaleIdTerminal.{u} X_W
  let hT_XW := weilEtaleIdTerminalIsTerminal.{u} X_W
  let adj_cW := CategoryTheory.constantSheafAdj X_W.smallEtaleTopology AddCommGrpCat.{u} hT_XW
  let Fℤ_XW := (CategoryTheory.constantSheaf X_W.smallEtaleTopology AddCommGrpCat.{u}).obj Z_ulift
  let Δ_W : T_XW ⟶ B_pW.obj V₀ :=
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift (𝟙 X_W) (𝟙 X_W) rfl)
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
  let q_W_elem : ↥((pb_pW.obj Q).obj.obj (Opposite.op T_XW)) :=
    ((pb_pW.obj Q).obj.map (Opposite.op Δ_W)).hom
      (((adj_pW.unit.app Q).hom.app (Opposite.op V₀)).hom q₀)
  let q_Z : Fℤ_XW ⟶ pb_pW.obj Q :=
    (adj_cW.homEquiv Z_ulift (pb_pW.obj Q)).symm
      (AddCommGrpCat.ofHom
        { toFun := fun n => n.down • q_W_elem
          map_zero' := zero_zsmul q_W_elem
          map_add' := fun a b => add_zsmul q_W_elem a.down b.down })
  have hq_Z_1 : (q_Z.hom.app (Opposite.op T_XW)).hom
      ((adj_cW.unit.app Z_ulift).hom (ULift.up (1 : ℤ))) = q_W_elem := by
    have h1 := ConcreteCategory.congr_hom
      ((adj_cW.homEquiv Z_ulift (pb_pW.obj Q)).apply_symm_apply
        (AddCommGrpCat.ofHom
          { toFun := fun n : ↥Z_ulift => n.down • q_W_elem
            map_zero' := zero_zsmul q_W_elem
            map_add' := fun a b => add_zsmul q_W_elem a.down b.down }))
      (ULift.up (1 : ℤ))
    change (q_Z.hom.app (Opposite.op T_XW)).hom
        ((adj_cW.unit.app Z_ulift).hom (ULift.up 1)) = (1 : ℤ) • q_W_elem at h1
    exact h1.trans (one_zsmul q_W_elem)

  let Z_V₀ := (Z_fun X.left).obj V₀
  let σ_u : T_Xb ⟶ B_ι.obj V₀ :=
    CategoryTheory.MorphismProperty.Over.homMk
      (CategoryTheory.Limits.pullback.lift ι_bW (𝟙 X_b.left)
        (hu_X.trans (CategoryTheory.Category.id_comp ι_b).symm))
      (CategoryTheory.Limits.pullback.lift_snd _ _ _) trivial
  let gen_u := ((pb_ι.obj Z_V₀).obj.map (Opposite.op σ_u)).hom
    (((adj_ι.unit.app Z_V₀).hom.app (Opposite.op V₀)).hom (ι_gen X.left V₀))
  let γ_u : Fℤ_Xb ⟶ pb_ι.obj Z_V₀ :=
    (adj_cXb.homEquiv Z_ulift (pb_ι.obj Z_V₀)).symm
      (AddCommGrpCat.ofHom
        { toFun := fun n => n.down • gen_u
          map_zero' := zero_zsmul gen_u
          map_add' := fun a b => add_zsmul gen_u a.down b.down })
  have h_γ1 : (γ_u.hom.app (Opposite.op T_Xb)).hom
      ((adj_cXb.unit.app Z_ulift).hom (ULift.up (1 : ℤ))) = gen_u := by
    have h_γ := ConcreteCategory.congr_hom
      ((adj_cXb.homEquiv Z_ulift (pb_ι.obj Z_V₀)).apply_symm_apply
        (AddCommGrpCat.ofHom
          { toFun := fun n : ↥Z_ulift => n.down • gen_u
            map_zero' := zero_zsmul gen_u
            map_add' := fun a b => add_zsmul gen_u a.down b.down }))
      (ULift.up (1 : ℤ))
    change (γ_u.hom.app (Opposite.op T_Xb)).hom
        ((adj_cXb.unit.app Z_ulift).hom (ULift.up 1)) = (1 : ℤ) • gen_u at h_γ
    exact h_γ.trans (one_zsmul gen_u)
  have hExt_ι_zero :
      (CategoryTheory.Abelian.Ext.mk₀ (γ_u ≫ pb_ι.map α₀)).comp
        ((hSE.map_of_exact pb_ι).extClass) (Nat.zero_add 1) = 0 := by
    have hβ_eval_ξ := hβ_eval F W τ_W ι_bW hu_X hu_W σ_u rfl γ_u h_γ1
      ((CategoryTheory.Abelian.Ext.mk₀ α₀).comp hSE.extClass (Nat.zero_add 1))
    have hβ_zero_lhs : β F (((pb_s.obj R1F).obj.map (Opposite.op τ_W)).hom
