                  (fun _ _ => trivial)).hom ω := by
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    exact fun α β =>
      (probe_s2 B₁ Ω Y_B₁ Y_η f_B₁ f_η ι_η_B₁ hPb_η_B₁ (W₁ α ⊓ W₁ β) (hW₁_inf_aff α β)).2
  let e_Ω_αβ : ∀ α β : Fin N_cov,
      @TensorProduct B₁ _ (A₂ α β) Ω _ _ _ ι_B₁_Ω.toAlgebra.toModule ≃+*
        ↑(Y_η.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α ⊓ W₁ β)))) :=
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    fun α β => Classical.choose (hIso_Ω_αβ α β)
  have he_Ω_αβ :
      letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
      ∀ (α β : Fin N_cov) (a : A₂ α β) (ω : Ω),
        e_Ω_αβ α β (TensorProduct.tmul B₁ a ω) =
          (ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom a *
            ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv ≫
              f_η.appLE ⊤ ((TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α ⊓ W₁ β))
                (fun _ _ => trivial)).hom ω :=
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    fun α β => Classical.choose_spec (hIso_Ω_αβ α β)

  have hNZD_open_η : ∀ O : Y_η.Opens, NoZeroDivisors ↑(Y_η.presheaf.obj (Opposite.op O)) := by
    intro O
    by_cases hne : Nonempty ↥(O : Scheme.{u})
    · haveI : Nonempty ↥(O : Scheme.{u}) := hne
      haveI : IsDomain ↑(Y_η.presheaf.obj (Opposite.op O)) :=
        IsIntegral.component_integral O
      infer_instance
    · have hO_empty : O = ⊥ := by
        ext x
        exact ⟨fun hx => False.elim (hne ⟨⟨x, hx⟩⟩), False.elim⟩
      rw [hO_empty]
      exact ⟨fun _ => Or.inl (Subsingleton.elim _ _)⟩

  have hNZD_Ω :
      letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
      (∀ α : Fin N_cov, NoZeroDivisors (TensorProduct B₁ (A α) Ω)) ∧
      (∀ α β : Fin N_cov, NoZeroDivisors (TensorProduct B₁ (A₂ α β) Ω)) := by
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    refine ⟨fun α => ?_, fun α β => ?_⟩
    · haveI := hNZD_open_η (V α)
      exact Function.Injective.noZeroDivisors (e_Ω_α α) (e_Ω_α α).injective
        (map_zero _) (map_mul _)
    · haveI := hNZD_open_η ((TopologicalSpace.Opens.map ι_η_B₁.base).obj (W₁ α ⊓ W₁ β))
      exact Function.Injective.noZeroDivisors (e_Ω_αβ α β) (e_Ω_αβ α β).injective
        (map_zero _) (map_mul _)

  let active : Fin N_cov → Prop := fun α => Nonempty ↥(W₀ α : Scheme.{u})
  have hAct_ex : ∃ α₀ : Fin N_cov, active α₀ := by
    haveI : AlgebraicGeometry.IsIntegral C₀.left := hInt_C₀
    obtain ⟨x₀⟩ := hInt_C₀.nonempty
    have hx₀_top : ι₀_B₁.base x₀ ∈ (⨆ α : Fin N_cov, W₁ α) := by
      rw [hW₁_top]; trivial
    obtain ⟨α₀, hα₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hx₀_top
    exact ⟨α₀, ⟨⟨x₀, hα₀⟩⟩⟩

  have hSpecFib :
      letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
      (∀ α : Fin N_cov, active α → IsDomain (TensorProduct B₁ (A α) k)) ∧
      (∀ α : Fin N_cov, ¬ active α → Subsingleton (TensorProduct B₁ (A α) k)) ∧
      (∀ α β : Fin N_cov, active α → active β → IsDomain (TensorProduct B₁ (A₂ α β) k)) := by
    letI : Algebra B₁ k := τ_B₁.toRingHom.toAlgebra
    haveI : AlgebraicGeometry.IsIntegral C₀.left := hInt_C₀
    haveI : IrreducibleSpace ↥C₀.left := irreducibleSpace_of_isIntegral C₀.left
    refine ⟨fun α hact => ?_, fun α hnact => ?_, fun α β hα hβ => ?_⟩
    · obtain ⟨_, e_k, _⟩ :=
        probe_s2 B₁ k Y_B₁ C₀.left f_B₁ C₀.hom ι₀_B₁ hPb_c₀_B₁ (W₁ α) (hW₁_aff α)
      haveI : Nonempty ↥(W₀ α : Scheme.{u}) := hact
      haveI : IsDomain ↑(C₀.left.presheaf.obj (Opposite.op (W₀ α))) :=
        IsIntegral.component_integral (W₀ α)
      exact e_k.toMulEquiv.isDomain ↑(C₀.left.presheaf.obj (Opposite.op (W₀ α)))
    · obtain ⟨_, e_k, _⟩ :=
        probe_s2 B₁ k Y_B₁ C₀.left f_B₁ C₀.hom ι₀_B₁ hPb_c₀_B₁ (W₁ α) (hW₁_aff α)
      have hW₀_bot : (TopologicalSpace.Opens.map ι₀_B₁.base).obj (W₁ α) = ⊥ := by
        ext x
        exact ⟨fun hx => False.elim (hnact ⟨⟨x, hx⟩⟩), False.elim⟩
      haveI : Subsingleton ↑(C₀.left.presheaf.obj
          (Opposite.op ((TopologicalSpace.Opens.map ι₀_B₁.base).obj (W₁ α)))) := by
        rw [hW₀_bot]
        infer_instance
      exact e_k.toEquiv.subsingleton
    · obtain ⟨_, e_k, _⟩ :=
        probe_s2 B₁ k Y_B₁ C₀.left f_B₁ C₀.hom ι₀_B₁ hPb_c₀_B₁ (W₁ α ⊓ W₁ β) (hW₁_inf_aff α β)
      obtain ⟨⟨x_α, hx_α⟩⟩ := hα
      obtain ⟨⟨x_β, hx_β⟩⟩ := hβ
      have h_inter := (IrreducibleSpace.isIrreducible_univ (X := ↥C₀.left)).isPreirreducible
        (W₀ α : Set ↥C₀.left) (W₀ β : Set ↥C₀.left)
        (W₀ α).isOpen (W₀ β).isOpen
        ⟨x_α, trivial, hx_α⟩ ⟨x_β, trivial, hx_β⟩
      obtain ⟨x_ab, _, hx_ab⟩ := h_inter
      let U_ov := (TopologicalSpace.Opens.map ι₀_B₁.base).obj (W₁ α ⊓ W₁ β)
      haveI : Nonempty ↥(U_ov : Scheme.{u}) := ⟨⟨x_ab, hx_ab⟩⟩
      haveI : IsDomain ↑(C₀.left.presheaf.obj (Opposite.op U_ov)) :=
        IsIntegral.component_integral U_ov
      exact e_k.toMulEquiv.isDomain ↑(C₀.left.presheaf.obj (Opposite.op U_ov))

  let u_tens_Ω : ∀ α : Fin N_cov,
      Units (@TensorProduct B₁ _ (A α) Ω _ _ _ ι_B₁_Ω.toAlgebra.toModule) :=
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    fun α => Units.map (e_Ω_α α).symm.toRingHom.toMonoidHom (u_Ω α)

  have hListDecomp :
      letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
      ∀ (M : Type u) [CommRing M] [Algebra B₁ M] (z : TensorProduct B₁ M Ω),
        ∃ L : List (M × Ω),
          z = (L.map (fun p => TensorProduct.tmul B₁ p.1 p.2)).sum := by
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    intro M _ _ z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨[], by simp⟩
    | tmul m ω => exact ⟨[(m, ω)], by simp⟩
    | add x y hx hy =>
        obtain ⟨Lx, rfl⟩ := hx
        obtain ⟨Ly, rfl⟩ := hy
        exact ⟨Lx ++ Ly, by simp [List.map_append, List.sum_append]⟩

  let L_pos : ∀ α : Fin N_cov, List (A α × Ω) :=
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    fun α => Classical.choose (hListDecomp (A α) (u_tens_Ω α).1)
  have hL_pos :
      letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
      ∀ α : Fin N_cov,
        (u_tens_Ω α).1 = ((L_pos α).map (fun p => TensorProduct.tmul B₁ p.1 p.2)).sum :=
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    fun α => Classical.choose_spec (hListDecomp (A α) (u_tens_Ω α).1)

  let L_neg : ∀ α : Fin N_cov, List (A α × Ω) :=
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    fun α => Classical.choose (hListDecomp (A α) (u_tens_Ω α)⁻¹.1)
  have hL_neg :
      letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
      ∀ α : Fin N_cov,
        (u_tens_Ω α)⁻¹.1 = ((L_neg α).map (fun p => TensorProduct.tmul B₁ p.1 p.2)).sum :=
    letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
    fun α => Classical.choose_spec (hListDecomp (A α) (u_tens_Ω α)⁻¹.1)

  let ω_list : List Ω :=
    (List.finRange N_cov).flatMap (fun α => (L_pos α).map Prod.snd ++ (L_neg α).map Prod.snd)
  let n_gen : ℕ := ω_list.length
  let ω_gen : Fin n_gen → Ω := ω_list.get

  obtain ⟨B₂, instCR_B₂, instDom_B₂, instAlg_B₂, instFT_B₂, hDed₂, _,
      ψ₁₂, τ₂, m₂, hm₂_max, π₂, L₂, instField_L₂, ι_B₂_L₂, ι_R₂_L₂, ι_L₂_Ω,
      ⟨_, hτ₂, hm₂_ker, _⟩, ⟨_, hπ₂_max, hπ₂_ne⟩,
      ⟨hInj_B₂_L₂, hR₂_L₂_comp, hInj_R₂_L₂, hB₁_Ω_eq⟩,
      hω_mem, hL₂_away⟩ :=
    probe_s3 k (weil_algClosed_finiteType_domain_integralClosure_finite k)
      B₁ hDed₁ hNotField₁ τ_B₁ Ω ι_B₁_Ω hInj_B₁_Ω hAlg_Ω n_gen ω_gen
  letI : CommRing B₂ := instCR_B₂
  haveI : IsDomain B₂ := instDom_B₂
  letI : Algebra k B₂ := instAlg_B₂
  haveI : Algebra.FiniteType k B₂ := instFT_B₂
  haveI : m₂.IsMaximal := hm₂_max
  letI : Field L₂ := instField_L₂

  letI : Algebra B₁ Ω := ι_B₁_Ω.toAlgebra
  letI : Algebra B₁ L₂ := (ι_B₂_L₂.comp ψ₁₂.toRingHom).toAlgebra
  let ι_L₂_Ω_alg : L₂ →ₐ[B₁] Ω :=
    { toRingHom := ι_L₂_Ω
      commutes' := fun b => RingHom.congr_fun hB₁_Ω_eq b }

  have hFlatInj_L₂_Ω : ∀ (M : Type u) [CommRing M] [Algebra B₁ M] [Module.Flat B₁ M],
      Function.Injective (Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_L₂_Ω_alg) := by
    intro M _ _ _
    have hl_inj : Function.Injective (LinearMap.lTensor M ι_L₂_Ω_alg.toLinearMap) :=
      Module.Flat.lTensor_preserves_injective_linearMap ι_L₂_Ω_alg.toLinearMap ι_L₂_Ω.injective
    have h_eq : ∀ z : TensorProduct B₁ M L₂,
        Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_L₂_Ω_alg z =
          LinearMap.lTensor M ι_L₂_Ω_alg.toLinearMap z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul m y => rfl
      | add x y hx hy => simp [map_add, hx, hy]
    intro x y hxy
    apply hl_inj
    rw [← h_eq x, ← h_eq y, hxy]

  have hLiftList : ∀ (M : Type u) [CommRing M] [Algebra B₁ M] (L : List (M × Ω)),
      (∀ p ∈ L, ∃ y : L₂, ι_L₂_Ω y = p.2) →
      ∃ z : TensorProduct B₁ M L₂,
        Algebra.TensorProduct.map (AlgHom.id B₁ M) ι_L₂_Ω_alg z =
          (L.map (fun p => TensorProduct.tmul B₁ p.1 p.2)).sum := by
    intro M _ _ L
    induction L with
    | nil => intro _; exact ⟨0, by simp⟩
    | cons hd tl ih =>
        intro hmem
        obtain ⟨y_hd, hy_hd⟩ := hmem hd List.mem_cons_self
        obtain ⟨z_tl, hz_tl⟩ := ih (fun p hp => hmem p (List.mem_cons_of_mem _ hp))
        refine ⟨TensorProduct.tmul B₁ hd.1 y_hd + z_tl, ?_⟩
        simp only [map_add, List.map_cons, List.sum_cons, hz_tl]
        congr 1
        change TensorProduct.tmul B₁ hd.1 (ι_L₂_Ω y_hd) = _
        rw [hy_hd]

  have hu_L₂_ex : ∀ α : Fin N_cov,
      ∃ u_l : Units (TensorProduct B₁ (A α) L₂),
        Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_L₂_Ω_alg u_l.1 = (u_tens_Ω α).1 := by
    intro α
    have h_in_pos : ∀ p ∈ L_pos α, ∃ y : L₂, ι_L₂_Ω y = p.2 := by
      intro p hp
      have hp_ω : p.2 ∈ ω_list :=
        List.mem_flatMap.mpr ⟨α, List.mem_finRange α,
          List.mem_append_left _ (List.mem_map_of_mem hp)⟩
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hp_ω
      obtain ⟨y, hy⟩ := hω_mem i
      exact ⟨y, hy.trans hi⟩
    have h_in_neg : ∀ p ∈ L_neg α, ∃ y : L₂, ι_L₂_Ω y = p.2 := by
      intro p hp
      have hp_ω : p.2 ∈ ω_list :=
        List.mem_flatMap.mpr ⟨α, List.mem_finRange α,
          List.mem_append_right _ (List.mem_map_of_mem hp)⟩
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hp_ω
      obtain ⟨y, hy⟩ := hω_mem i
      exact ⟨y, hy.trans hi⟩
    obtain ⟨z_p, hzp⟩ := hLiftList (A α) (L_pos α) h_in_pos
    obtain ⟨z_n, hzn⟩ := hLiftList (A α) (L_neg α) h_in_neg
    rw [← hL_pos α] at hzp
    rw [← hL_neg α] at hzn
    have hmul_1 : z_p * z_n = 1 := by
      apply hFlatInj_L₂_Ω (A α)
      rw [map_mul, map_one, hzp, hzn, Units.mul_inv]
    exact ⟨⟨z_p, z_n, hmul_1, mul_comm z_n z_p ▸ hmul_1⟩, hzp⟩

  let u_L₂ : ∀ α : Fin N_cov, Units (TensorProduct B₁ (A α) L₂) :=
    fun α => Classical.choose (hu_L₂_ex α)
  have hu_L₂_map : ∀ α : Fin N_cov,
      Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_L₂_Ω_alg (u_L₂ α).1 = (u_tens_Ω α).1 :=
    fun α => Classical.choose_spec (hu_L₂_ex α)

  have hu_L₂_trans : ∀ α β : Fin N_cov,
      TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂) *
        Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ L₂) (u_L₂ β).1 =
      Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ L₂) (u_L₂ α).1 := by
    intro α β
    apply hFlatInj_L₂_Ω (A₂ α β)
    apply (e_Ω_αβ α β).injective
    have hcomm_L : ∀ z : TensorProduct B₁ (A α) L₂,
        Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
          (Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ L₂) z) =
        Algebra.TensorProduct.map (ρL α β) (AlgHom.id B₁ Ω)
          (Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_L₂_Ω_alg z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a y => rfl
      | add x y hx hy => simp [map_add, hx, hy]
    have hcomm_R : ∀ z : TensorProduct B₁ (A β) L₂,
        Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
          (Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ L₂) z) =
        Algebra.TensorProduct.map (ρR α β) (AlgHom.id B₁ Ω)
          (Algebra.TensorProduct.map (AlgHom.id B₁ (A β)) ι_L₂_Ω_alg z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a y => rfl
      | add x y hx hy => simp [map_add, hx, hy]
    rw [map_mul, map_mul, hcomm_L, hcomm_R, hu_L₂_map α, hu_L₂_map β]
    have hres_L := hResCompat Ω Y_η f_η ι_η_B₁ (inf_le_left : W₁ α ⊓ W₁ β ≤ W₁ α)
      (e_Ω_α α) (he_Ω_α α) (e_Ω_αβ α β) (he_Ω_αβ α β) (ρL α β) (fun _ => rfl) (u_tens_Ω α).1
    have hres_R := hResCompat Ω Y_η f_η ι_η_B₁ (inf_le_right : W₁ α ⊓ W₁ β ≤ W₁ β)
      (e_Ω_α β) (he_Ω_α β) (e_Ω_αβ α β) (he_Ω_αβ α β) (ρR α β) (fun _ => rfl) (u_tens_Ω β).1
    have hu_symm_α : e_Ω_α α (u_tens_Ω α).1 = (u_Ω α).1 := (e_Ω_α α).apply_symm_apply _
    have hu_symm_β : e_Ω_α β (u_tens_Ω β).1 = (u_Ω β).1 := (e_Ω_α β).apply_symm_apply _
    rw [hu_symm_α] at hres_L
    rw [hu_symm_β] at hres_R
    rw [← hres_L, ← hres_R]
    have hg_eq : e_Ω_αβ α β
        (Algebra.TensorProduct.map (AlgHom.id B₁ (A₂ α β)) ι_L₂_Ω_alg
          (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (1 : L₂))) =
        ((ι_η_B₁.app (W₁ α ⊓ W₁ β)).hom (g₁ α β).1) ^ ℓ := by
      change e_Ω_αβ α β (TensorProduct.tmul B₁ ((g₁ α β).1 ^ ℓ) (ι_L₂_Ω 1)) = _
      rw [map_one, he_Ω_αβ α β, map_one, mul_one, map_pow]
    rw [hg_eq]
    exact hu_Ω_trans α β

  obtain ⟨B_sp, instCR_sp, instDom_sp, instAlg_sp, instFT_sp, hDed_sp, instAlgB₁_sp,
      ψ_sp, τ_sp, ι_sp_Ω, hInj_sp_Ω, c_scale, halg_sp, hτ_sp_eq, hι_sp_alg_eq,
      u_sp_tens, hu_sp_tens_trans, hu_sp_tens_Ω⟩ :=
    probe_s4 k ℓ B₁ τ_B₁ Ω ι_B₁_Ω B₂ hDed₂ ψ₁₂ τ₂ hτ₂ m₂ hm₂_ker π₂ hπ₂_max hπ₂_ne
      L₂ ι_B₂_L₂ hInj_B₂_L₂ ι_R₂_L₂ hR₂_L₂_comp hInj_R₂_L₂ hL₂_away ι_L₂_Ω hB₁_Ω_eq
      N_cov A A₂ ρL ρR g₁ active hAct_ex hNZD_Ω hSpecFib u_L₂ hu_L₂_trans
  letI : CommRing B_sp := instCR_sp
  haveI : IsDomain B_sp := instDom_sp
  letI : Algebra k B_sp := instAlg_sp
  haveI : Algebra.FiniteType k B_sp := instFT_sp
  haveI : IsDedekindDomain B_sp := hDed_sp
  letI : Algebra B₁ B_sp := instAlgB₁_sp
  have hι_sp_eq : ι_sp_Ω.comp ψ_sp.toRingHom = ι_B₁_Ω := by
    rw [← halg_sp]
    exact hι_sp_alg_eq

  let g_sp_mor : Spec (CommRingCat.of B_sp) ⟶ Spec (CommRingCat.of B₁) :=
    Spec.map (CommRingCat.ofHom ψ_sp.toRingHom)
  let Y_sp : Scheme.{u} := Limits.pullback f_B₁ g_sp_mor
  let q_Y_sp : Y_sp ⟶ Y_B₁ := Limits.pullback.fst f_B₁ g_sp_mor
  let f_sp : Y_sp ⟶ Spec (CommRingCat.of B_sp) := Limits.pullback.snd f_B₁ g_sp_mor
  have hPb_sp : IsPullback q_Y_sp f_sp f_B₁ g_sp_mor :=
    IsPullback.of_hasPullback f_B₁ g_sp_mor
  have hPb_sp_alg : IsPullback q_Y_sp f_sp f_B₁
      (Spec.map (CommRingCat.ofHom (algebraMap B₁ B_sp))) := by
    rwa [halg_sp]

  have h_η_sp_comm :
      ι_η_B₁ ≫ f_B₁ = (f_η ≫ Spec.map (CommRingCat.ofHom ι_sp_Ω)) ≫ g_sp_mor := by
    rw [Category.assoc]
    change _ = f_η ≫ (Spec.map (CommRingCat.ofHom ι_sp_Ω) ≫
      Spec.map (CommRingCat.ofHom ψ_sp.toRingHom))
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hι_sp_eq]
    exact hPb_η_B₁.w
  let ι_η_sp : Y_η ⟶ Y_sp :=
    Limits.pullback.lift ι_η_B₁ (f_η ≫ Spec.map (CommRingCat.ofHom ι_sp_Ω)) h_η_sp_comm
  have h_comp_η : ι_η_sp ≫ q_Y_sp = ι_η_B₁ := Limits.pullback.lift_fst _ _ _
  have h_snd_η : ι_η_sp ≫ f_sp = f_η ≫ Spec.map (CommRingCat.ofHom ι_sp_Ω) :=
    Limits.pullback.lift_snd _ _ _
  have hPb_η_sp : IsPullback ι_η_sp f_η f_sp (Spec.map (CommRingCat.ofHom ι_sp_Ω)) := by
    refine IsPullback.of_right ?_ h_snd_η hPb_sp
    rw [h_comp_η, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hι_sp_eq]
    exact hPb_η_B₁

  let W_sp : Fin N_cov → Y_sp.Opens := fun α => (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α)
  have hIso_sp_α : ∀ α : Fin N_cov,
      ∃ e : TensorProduct B₁ (A α) B_sp ≃+* ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α))),
        ∀ (a : A α) (b_sp : B_sp),
          e (TensorProduct.tmul B₁ a b_sp) =
            (q_Y_sp.app (W₁ α)).hom a *
              ((Scheme.ΓSpecIso (CommRingCat.of B_sp)).inv ≫
                f_sp.appLE ⊤ (W_sp α) (fun _ _ => trivial)).hom b_sp :=
    fun α => (probe_s2 B₁ B_sp Y_B₁ Y_sp f_B₁ f_sp q_Y_sp hPb_sp_alg (W₁ α) (hW₁_aff α)).2
  let e_sp_α : ∀ α : Fin N_cov,
      TensorProduct B₁ (A α) B_sp ≃+* ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α))) :=
    fun α => Classical.choose (hIso_sp_α α)
  have he_sp_α : ∀ (α : Fin N_cov) (a : A α) (b_sp : B_sp),
      e_sp_α α (TensorProduct.tmul B₁ a b_sp) =
        (q_Y_sp.app (W₁ α)).hom a *
          ((Scheme.ΓSpecIso (CommRingCat.of B_sp)).inv ≫
            f_sp.appLE ⊤ (W_sp α) (fun _ _ => trivial)).hom b_sp :=
    fun α => Classical.choose_spec (hIso_sp_α α)

  have hIso_sp_αβ : ∀ α β : Fin N_cov,
      ∃ e : TensorProduct B₁ (A₂ α β) B_sp ≃+*
          ↑(Y_sp.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α ⊓ W₁ β)))),
        ∀ (a : A₂ α β) (b_sp : B_sp),
          e (TensorProduct.tmul B₁ a b_sp) =
            (q_Y_sp.app (W₁ α ⊓ W₁ β)).hom a *
              ((Scheme.ΓSpecIso (CommRingCat.of B_sp)).inv ≫
                f_sp.appLE ⊤ ((TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α ⊓ W₁ β))
                  (fun _ _ => trivial)).hom b_sp :=
    fun α β =>
      (probe_s2 B₁ B_sp Y_B₁ Y_sp f_B₁ f_sp q_Y_sp hPb_sp_alg (W₁ α ⊓ W₁ β) (hW₁_inf_aff α β)).2
  let e_sp_αβ : ∀ α β : Fin N_cov,
      TensorProduct B₁ (A₂ α β) B_sp ≃+*
        ↑(Y_sp.presheaf.obj (Opposite.op ((TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α ⊓ W₁ β)))) :=
    fun α β => Classical.choose (hIso_sp_αβ α β)
  have he_sp_αβ : ∀ (α β : Fin N_cov) (a : A₂ α β) (b_sp : B_sp),
      e_sp_αβ α β (TensorProduct.tmul B₁ a b_sp) =
        (q_Y_sp.app (W₁ α ⊓ W₁ β)).hom a *
          ((Scheme.ΓSpecIso (CommRingCat.of B_sp)).inv ≫
            f_sp.appLE ⊤ ((TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α ⊓ W₁ β))
              (fun _ _ => trivial)).hom b_sp :=
    fun α β => Classical.choose_spec (hIso_sp_αβ α β)

  let u_sp : ∀ α : Fin N_cov, Units ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α))) :=
    fun α => Units.map (e_sp_α α).toRingHom.toMonoidHom (u_sp_tens α)

  refine ⟨B_sp, instCR_sp, instDom_sp, instAlg_sp, instFT_sp, hDed_sp,
    ψ_sp, τ_sp, ι_sp_Ω, hInj_sp_Ω, Y_sp, q_Y_sp, f_sp, ι_η_sp, u_sp, c_scale,
    ⟨hτ_sp_eq, hι_sp_eq⟩, ⟨hPb_sp, h_comp_η, hPb_η_sp⟩, ?_, ?_⟩
  · intro W_sp_let g_sp_let α β
    have hres_L := hResCompat B_sp Y_sp f_sp q_Y_sp (inf_le_left : W₁ α ⊓ W₁ β ≤ W₁ α)
      (e_sp_α α) (he_sp_α α) (e_sp_αβ α β) (he_sp_αβ α β) (ρL α β) (fun _ => rfl)
      (u_sp_tens α).1
    have hres_R := hResCompat B_sp Y_sp f_sp q_Y_sp (inf_le_right : W₁ α ⊓ W₁ β ≤ W₁ β)
      (e_sp_α β) (he_sp_α β) (e_sp_αβ α β) (he_sp_αβ α β) (ρR α β) (fun _ => rfl)
      (u_sp_tens β).1
    change (((q_Y_sp.app (W₁ α ⊓ W₁ β)).hom (g₁ α β).1) ^ ℓ) *
        (Y_sp.presheaf.map (CategoryTheory.homOfLE
          (fun _ hx => hx.2 :
            (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α ⊓ W₁ β) ≤
              (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ β))).op).hom
          (e_sp_α β (u_sp_tens β).1) =
      (Y_sp.presheaf.map (CategoryTheory.homOfLE
        (fun _ hx => hx.1 :
          (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α ⊓ W₁ β) ≤
            (TopologicalSpace.Opens.map q_Y_sp.base).obj (W₁ α))).op).hom
        (e_sp_α α (u_sp_tens α).1)
    rw [hres_L, hres_R, ← hu_sp_tens_trans α β, map_mul]
    congr 1
    rw [he_sp_αβ α β, map_one, mul_one, map_pow]
  · intro W_sp_let V_let α h_le
    let ι_sp_Ω_alg : B_sp →ₐ[B₁] Ω :=
      { toRingHom := ι_sp_Ω
        commutes' := fun b => RingHom.congr_fun hι_sp_alg_eq b }
    let Ψ_α : Y_sp.presheaf.obj (Opposite.op (W_sp α)) ⟶
        Y_η.presheaf.obj (Opposite.op (V α)) :=
      ι_η_sp.appLE (W_sp α) (V α) h_le
    have hΨ_def : ∀ x : ↑(Y_sp.presheaf.obj (Opposite.op (W_sp α))),
        (Y_η.presheaf.map (CategoryTheory.homOfLE h_le).op).hom
          ((ι_η_sp.app (W_sp α)).hom x) = Ψ_α.hom x := by
      intro x
      exact ConcreteCategory.congr_hom
        ((congrArg (· ≫ Y_η.presheaf.map (CategoryTheory.homOfLE h_le).op)
            (Scheme.Hom.app_eq_appLE ι_η_sp)).trans
          (ι_η_sp.appLE_map le_rfl (CategoryTheory.homOfLE h_le).op)) x
    have h_mor_a : q_Y_sp.app (W₁ α) ≫ ι_η_sp.appLE (W_sp α) (V α) h_le =
        ι_η_B₁.app (W₁ α) :=
      (congrArg (· ≫ ι_η_sp.appLE (W_sp α) (V α) h_le)
        (Scheme.Hom.app_eq_appLE q_Y_sp)).trans
      ((Scheme.Hom.appLE_comp_appLE ι_η_sp q_Y_sp (W₁ α) (W_sp α) (V α) le_rfl h_le).trans
        ((Scheme.Hom.appLE.congr_simp (ι_η_sp ≫ q_Y_sp) ι_η_B₁ h_comp_η (W₁ α) (V α) _).trans
          (Scheme.Hom.app_eq_appLE ι_η_B₁).symm))
    have h_nat : (Scheme.ΓSpecIso (CommRingCat.of B_sp)).inv ≫
        (Spec.map (CommRingCat.ofHom ι_sp_Ω)).appTop =
        CommRingCat.ofHom ι_sp_Ω ≫ (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv := by
      have h1 := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ι_sp_Ω)
      rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of B_sp)).hom,
        ← Category.assoc, Iso.hom_inv_id, Category.id_comp, ← Category.assoc,
        ← h1, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have h_mor_b : f_sp.appLE ⊤ (W_sp α) (fun _ _ => trivial) ≫
          ι_η_sp.appLE (W_sp α) (V α) h_le =
        (Spec.map (CommRingCat.ofHom ι_sp_Ω)).appTop ≫
          f_η.appLE ⊤ (V α) (fun _ _ => trivial) :=
      (Scheme.Hom.appLE_comp_appLE ι_η_sp f_sp ⊤ (W_sp α) (V α)
        (fun _ _ => trivial) h_le).trans
      ((Scheme.Hom.appLE.congr_simp (ι_η_sp ≫ f_sp)
          (f_η ≫ Spec.map (CommRingCat.ofHom ι_sp_Ω)) h_snd_η ⊤ (V α) _).trans
        ((Scheme.Hom.appLE_comp_appLE f_η (Spec.map (CommRingCat.ofHom ι_sp_Ω))
          ⊤ ⊤ (V α) (fun _ _ => trivial) (fun _ _ => trivial)).symm.trans
          (congrArg (· ≫ f_η.appLE ⊤ (V α) (fun _ _ => trivial))
            (Scheme.Hom.app_eq_appLE (Spec.map (CommRingCat.ofHom ι_sp_Ω))).symm)))
    have hΨ_eq : ∀ z : TensorProduct B₁ (A α) B_sp,
        Ψ_α.hom (e_sp_α α z) =
          e_Ω_α α (Algebra.TensorProduct.map (AlgHom.id B₁ (A α)) ι_sp_Ω_alg z) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a b_sp =>
          rw [he_sp_α α a b_sp, map_mul]
          change (q_Y_sp.app (W₁ α) ≫ ι_η_sp.appLE (W_sp α) (V α) h_le).hom a *
              (((Scheme.ΓSpecIso (CommRingCat.of B_sp)).inv ≫
                f_sp.appLE ⊤ (W_sp α) (fun _ _ => trivial)) ≫
                ι_η_sp.appLE (W_sp α) (V α) h_le).hom b_sp =
            e_Ω_α α (TensorProduct.tmul B₁ a (ι_sp_Ω b_sp))
          rw [he_Ω_α α a (ι_sp_Ω b_sp)]
          congr 1
          · exact ConcreteCategory.congr_hom h_mor_a a
          · exact ConcreteCategory.congr_hom
              ((Category.assoc _ _ _).trans
                ((congrArg ((Scheme.ΓSpecIso (CommRingCat.of B_sp)).inv ≫ ·) h_mor_b).trans
                  ((Category.assoc _ _ _).symm.trans
                    ((congrArg (· ≫ f_η.appLE ⊤ (V α) (fun _ _ => trivial)) h_nat).trans
                      (Category.assoc _ _ _))))) b_sp
      | add x y hx hy => simp [map_add, hx, hy]
    change (Y_η.presheaf.map (CategoryTheory.homOfLE h_le).op).hom
      ((ι_η_sp.app (W_sp α)).hom (e_sp_α α (u_sp_tens α).1)) = _
    rw [hΨ_def, hΨ_eq, hu_sp_tens_Ω α, map_mul]
    congr 1
    · rw [he_Ω_α α 1 c_scale.1, map_one, one_mul]
    · rw [hu_L₂_map α]
      exact (e_Ω_α α).apply_symm_apply _

theorem weil_zariski_kummer_cocycle_torsor_gluing (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (B : Type u) [CommRing B] [Algebra k B]
    (Y : AlgebraicGeometry.Scheme.{u})
    (f : Quiver.Hom Y (AlgebraicGeometry.Spec (CommRingCat.of B)))
    (N_cov : ℕ) (hN_cov : 1 ≤ N_cov)
    (W : Fin N_cov → Y.Opens)
    (hW_top : (⨆ α : Fin N_cov, W α) = ⊤)
    (hW_aff : ∀ α : Fin N_cov, AlgebraicGeometry.IsAffineOpen (W α))
    (u : ∀ α : Fin N_cov, Units ↑(Y.presheaf.obj (Opposite.op (W α))))
    (g : ∀ α β : Fin N_cov, Units ↑(Y.presheaf.obj (Opposite.op (W α ⊓ W β))))
    (hg_diag : ∀ α : Fin N_cov, (g α α).1 = 1)
    (hg_cocycle : ∀ α β γ : Fin N_cov,
      (Y.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.1.2⟩ :
            (W α ⊓ W β) ⊓ W γ ≤ W α ⊓ W β)).op).hom (g α β).1 *
      (Y.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.2, hx.2⟩ :
            (W α ⊓ W β) ⊓ W γ ≤ W β ⊓ W γ)).op).hom (g β γ).1 =
      (Y.presheaf.map
        (CategoryTheory.homOfLE
          (fun _ hx => ⟨hx.1.1, hx.2⟩ :
            (W α ⊓ W β) ⊓ W γ ≤ W α ⊓ W γ)).op).hom (g α γ).1)
    (hu_trans : ∀ α β : Fin N_cov,
      ((g α β).1 ^ ℓ) *
        (Y.presheaf.map (CategoryTheory.homOfLE inf_le_right).op).hom (u β).1 =
      (Y.presheaf.map (CategoryTheory.homOfLE inf_le_left).op).hom (u α).1) :
    ∃ (Z : AlgebraicGeometry.Scheme.{u})
      (ν : Quiver.Hom Z Y)
      (_ : AlgebraicGeometry.IsFinite ν)
      (_ : AlgebraicGeometry.Etale ν)
      (_ : AlgebraicGeometry.Surjective ν)
      (ρ : ZMod ℓ → Quiver.Hom Z Z)
      (hρ_over : ∀ a : ZMod ℓ, CategoryTheory.CategoryStruct.comp (ρ a) ν = ν),
      (ρ 0 = CategoryTheory.CategoryStruct.id Z ∧
        ∀ a b : ZMod ℓ, ρ (a + b) = CategoryTheory.CategoryStruct.comp (ρ a) (ρ b)) ∧
      (let δ : ZMod ℓ → Quiver.Hom Z (CategoryTheory.Limits.pullback ν ν) :=
        fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z) (ρ a)
          ((CategoryTheory.Category.id_comp ν).trans (hρ_over a).symm)
       (_root_.Pairwise fun a b : ZMod ℓ =>
         Disjoint (Set.range (δ a).base) (Set.range (δ b).base)) ∧
       (⋃ a : ZMod ℓ, Set.range (δ a).base) = Set.univ) ∧
      (∀ α : Fin N_cov,
        ∃ x_α : ↑(Z.presheaf.obj
            (Opposite.op ((TopologicalSpace.Opens.map ν.base).obj (W α)))),
          x_α ^ ℓ = (ν.app (W α)).hom (u α).1) ∧
      (∀ α : Fin N_cov,
        ∃ e_α : CategoryTheory.Iso
            (AlgebraicGeometry.Scheme.Opens.toScheme
              ((TopologicalSpace.Opens.map ν.base).obj (W α)))
            (AlgebraicGeometry.Spec (CommRingCat.of
              (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u α).1)))),
          CategoryTheory.CategoryStruct.comp e_α.hom
            (CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
                (algebraMap (↑(Y.presheaf.obj (Opposite.op (W α))))
                  (AdjoinRoot (Polynomial.X ^ ℓ - Polynomial.C (u α).1)))))
              (hW_aff α).fromSpec) =
            CategoryTheory.CategoryStruct.comp
              (AlgebraicGeometry.Scheme.Opens.ι
                ((TopologicalSpace.Opens.map ν.base).obj (W α))) ν) :=
by
  classical
  let _ := hN_cov
  
  
  
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  have : NeZero (ℓ : k) := ⟨hℓ⟩
  have hdeg_cyc : (Polynomial.cyclotomic ℓ k).degree ≠ 0 := by
    rw [Polynomial.degree_cyclotomic]
    have htot : Nat.totient ℓ = ℓ - 1 := Nat.totient_prime hPrime
    have h2 : 2 ≤ ℓ := hPrime.two_le
    have hpos : 0 < Nat.totient ℓ := by omega
    exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt hpos)
  obtain ⟨ζ, hζ_root⟩ := IsAlgClosed.exists_root (Polynomial.cyclotomic ℓ k) hdeg_cyc
  have hζ : IsPrimitiveRoot ζ ℓ :=
    (Polynomial.isRoot_cyclotomic_iff (R := k) (n := ℓ)).mp hζ_root
  have hζ_pow : ζ ^ ℓ = 1 := hζ.pow_eq_one
  have hζ_ne : ζ ≠ 0 := by
    intro h0
    rw [h0, zero_pow hPrime.ne_zero] at hζ_pow
    exact zero_ne_one hζ_pow
  let ζ_B : B := algebraMap k B ζ
  have hζ_B_pow : ζ_B ^ ℓ = 1 := by
    dsimp [ζ_B]
    rw [← map_pow, hζ_pow, map_one]

  
  
  
  have hAdjoinRoot_ext :
      ∀ {R₀ S₀ : Type u} [CommRing R₀] [CommRing S₀] {P₀ : Polynomial R₀}
        (φ₁ φ₂ : AdjoinRoot P₀ →+* S₀),
        (∀ r : R₀, φ₁ (algebraMap R₀ (AdjoinRoot P₀) r) = φ₂ (algebraMap R₀ (AdjoinRoot P₀) r)) →
        φ₁ (AdjoinRoot.root P₀) = φ₂ (AdjoinRoot.root P₀) →
        φ₁ = φ₂ := by
    intro R₀ S₀ _ _ P₀ φ₁ φ₂ h_base h_root
    have h_poly : φ₁.comp (AdjoinRoot.mk P₀) = φ₂.comp (AdjoinRoot.mk P₀) := by
      apply Polynomial.ringHom_ext'
      · ext r
        change φ₁ (AdjoinRoot.mk P₀ (Polynomial.C r)) = φ₂ (AdjoinRoot.mk P₀ (Polynomial.C r))
        rw [AdjoinRoot.mk_C]
        exact h_base r
      · change φ₁ (AdjoinRoot.mk P₀ Polynomial.X) = φ₂ (AdjoinRoot.mk P₀ Polynomial.X)
        rw [AdjoinRoot.mk_X]
        exact h_root
    apply RingHom.ext
    intro x
    induction x using AdjoinRoot.induction_on with
    | ih p => exact RingHom.congr_fun h_poly p

  let res_Y : ∀ {U V : Y.Opens}, U ≤ V →
      (↑(Y.presheaf.obj (Opposite.op V)) →+* ↑(Y.presheaf.obj (Opposite.op U))) :=
    fun h => (Y.presheaf.map (CategoryTheory.homOfLE h).op).hom
  have hres_id : ∀ (U : Y.Opens) (x : ↑(Y.presheaf.obj (Opposite.op U))),
      res_Y (le_refl U) x = x := by
    intro U x
    dsimp [res_Y]
    rw [Y.presheaf.map_id]
    rfl
  have hres_comp : ∀ {U₁ U₂ U₃ : Y.Opens} (h₁₂ : U₁ ≤ U₂) (h₂₃ : U₂ ≤ U₃)
      (x : ↑(Y.presheaf.obj (Opposite.op U₃))),
      res_Y h₁₂ (res_Y h₂₃ x) = res_Y (h₁₂.trans h₂₃) x := by
    intro U₁ U₂ U₃ h₁₂ h₂₃ x
    dsimp [res_Y]
    have hop : (CategoryTheory.homOfLE (h₁₂.trans h₂₃)).op =
        (CategoryTheory.homOfLE h₂₃).op ≫ (CategoryTheory.homOfLE h₁₂).op := by
      rw [← op_comp, CategoryTheory.homOfLE_comp]
    rw [hop, Y.presheaf.map_comp]
    rfl

  let I₀ : Type u :=
    { U : Y.Opens // AlgebraicGeometry.IsAffineOpen U ∧ ∃ α : Fin N_cov, U ≤ W α }
  have hBasis_U : TopologicalSpace.Opens.IsBasis (Set.range (fun i : I₀ => i.1)) := by
    rw [TopologicalSpace.Opens.isBasis_iff_nbhd]
    intro U y hyU
    have hy_top : y ∈ (⨆ α : Fin N_cov, W α) := by
      rw [hW_top]
      trivial
    obtain ⟨α, hyα⟩ := TopologicalSpace.Opens.mem_iSup.mp hy_top
    have hy_inf : y ∈ U ⊓ W α := ⟨hyU, hyα⟩
    have hAffBasis := AlgebraicGeometry.Scheme.isBasis_affineOpens Y
    rw [TopologicalSpace.Opens.isBasis_iff_nbhd] at hAffBasis
    obtain ⟨V, hV_aff, hyV, hV_le⟩ := hAffBasis hy_inf
    refine ⟨V, ⟨⟨V, hV_aff, ⟨α, hV_le.trans inf_le_right⟩⟩, rfl⟩, hyV, hV_le.trans inf_le_left⟩
  have hTop_I₀ : (⨆ i : I₀, i.1) = ⊤ := by
    rw [eq_top_iff]
    intro y hy
    rw [TopologicalSpace.Opens.isBasis_iff_nbhd] at hBasis_U
    obtain ⟨V, ⟨i, rfl⟩, hyi, _⟩ := hBasis_U (U := ⊤) hy
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hyi⟩
  have hOpenCov : TopologicalSpace.IsOpenCover (fun i : I₀ => i.1) := hTop_I₀
  let 𝒰 : Y.OpenCover := Y.openCoverOfIsOpenCover (fun i : I₀ => i.1) hOpenCov
  letI : Preorder 𝒰.I₀ := inferInstanceAs (Preorder I₀)
  letI : CategoryTheory.Category 𝒰.I₀ := inferInstanceAs (CategoryTheory.Category I₀)
  have : Quiver.IsThin 𝒰.I₀ := inferInstanceAs (Quiver.IsThin I₀)
  have : Small.{u} 𝒰.I₀ := inferInstanceAs (Small.{u} I₀)
  let val_U : 𝒰.I₀ → Y.Opens := fun i => (i : I₀).1
  have hAff_U : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsAffineOpen (val_U i) := fun i => (i : I₀).2.1
  have hle_opensRange : ∀ {i j : 𝒰.I₀},
      i ≤ j ↔ (𝒰.f i).opensRange ≤ (𝒰.f j).opensRange := by
    intro i j
    change val_U i ≤ val_U j ↔
      (AlgebraicGeometry.Scheme.Opens.ι (val_U i)).opensRange ≤
        (AlgebraicGeometry.Scheme.Opens.ι (val_U j)).opensRange
    rw [AlgebraicGeometry.Scheme.Opens.opensRange_ι,
      AlgebraicGeometry.Scheme.Opens.opensRange_ι]
  have hBasis_range :
      TopologicalSpace.Opens.IsBasis (Set.range fun i : 𝒰.I₀ => (𝒰.f i).opensRange) := by
    have hset : (Set.range fun i : 𝒰.I₀ => (𝒰.f i).opensRange) =
        Set.range (fun i : I₀ => i.1) := by
      ext U
      simp only [Set.mem_range]
      refine ⟨fun ⟨i, hi⟩ => ⟨i, ?_⟩, fun ⟨i, hi⟩ => ⟨i, ?_⟩⟩
      · change (AlgebraicGeometry.Scheme.Opens.ι (val_U i)).opensRange = U at hi
        rwa [AlgebraicGeometry.Scheme.Opens.opensRange_ι] at hi
      · change (AlgebraicGeometry.Scheme.Opens.ι (val_U i)).opensRange = U
        rwa [AlgebraicGeometry.Scheme.Opens.opensRange_ι]
    rw [hset]
    exact hBasis_U
  letI : AlgebraicGeometry.Scheme.Cover.LocallyDirected 𝒰 :=
    AlgebraicGeometry.Scheme.Cover.LocallyDirected.ofIsBasisOpensRange hle_opensRange hBasis_range
  let G_base := AlgebraicGeometry.Scheme.Cover.functorOfLocallyDirected 𝒰
  let f_cov : ∀ i : 𝒰.I₀, G_base.obj i ⟶ Y := fun i => 𝒰.f i
  haveI : ∀ i : 𝒰.I₀, AlgebraicGeometry.IsOpenImmersion (f_cov i) :=
    fun i => inferInstanceAs (AlgebraicGeometry.IsOpenImmersion (val_U i).ι)
  have hG_map_ι : ∀ {i j : 𝒰.I₀} (hij : i ⟶ j),
      G_base.map hij ≫ f_cov j = f_cov i := by
    intro i j hij
    have heq_hom : hij = CategoryTheory.homOfLE (leOfHom hij) := Subsingleton.elim _ _
    rw [heq_hom]
    dsimp [G_base, f_cov]
    rw [AlgebraicGeometry.Scheme.Cover.functorOfLocallyDirected_map,
      AlgebraicGeometry.Scheme.Cover.LocallyDirected.ofIsBasisOpensRange_trans]
    exact AlgebraicGeometry.IsOpenImmersion.lift_fac (𝒰.f j) (𝒰.f i) _

  
  let α_ch : 𝒰.I₀ → Fin N_cov := fun i => (i : I₀).2.2.choose
  have hle_ch : ∀ i : 𝒰.I₀, val_U i ≤ W (α_ch i) := fun i => (i : I₀).2.2.choose_spec
  let A_i : 𝒰.I₀ → Type u := fun i => ↑(Y.presheaf.obj (Opposite.op (val_U i)))
  letI : ∀ i : 𝒰.I₀, CommRing (A_i i) := fun i => inferInstance
  let u_i : ∀ i : 𝒰.I₀, Units (A_i i) :=
    fun i => Units.map (res_Y (hle_ch i)).toMonoidHom (u (α_ch i))
  let P_i : ∀ i : 𝒰.I₀, Polynomial (A_i i) :=
    fun i => Polynomial.X ^ ℓ - Polynomial.C (u_i i).1
  let R_i : 𝒰.I₀ → Type u := fun i => AdjoinRoot (P_i i)
  letI : ∀ i : 𝒰.I₀, CommRing (R_i i) := fun i => inferInstance
  letI : ∀ i : 𝒰.I₀, Algebra (A_i i) (R_i i) := fun i => inferInstance
  let t_i : ∀ i : 𝒰.I₀, R_i i := fun i => AdjoinRoot.root (P_i i)
  have ht_i_pow : ∀ i : 𝒰.I₀, (t_i i) ^ ℓ = algebraMap (A_i i) (R_i i) (u_i i).1 := by
    intro i
    have hev := AdjoinRoot.eval₂_root (P_i i)
    simp only [P_i, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, sub_eq_zero] at hev
    exact hev
  let g_ji : ∀ {i j : 𝒰.I₀}, val_U i ≤ val_U j → Units (A_i i) :=
    fun {i j} h_ij =>
      Units.map (res_Y (le_inf (h_ij.trans (hle_ch j)) (hle_ch i))).toMonoidHom
        (g (α_ch j) (α_ch i))
  have hg_ji_pow : ∀ {i j : 𝒰.I₀} (h_ij : val_U i ≤ val_U j),
      (g_ji h_ij).1 ^ ℓ * (u_i i).1 = res_Y h_ij (u_i j).1 := by
    intro i j h_ij
    let h_inf : val_U i ≤ W (α_ch j) ⊓ W (α_ch i) := le_inf (h_ij.trans (hle_ch j)) (hle_ch i)
    have htr := congrArg (res_Y h_inf) (hu_trans (α_ch j) (α_ch i))
    rw [map_mul, map_pow] at htr
    change (g_ji h_ij).1 ^ ℓ * res_Y h_inf (res_Y inf_le_right (u (α_ch i)).1) =
      res_Y h_inf (res_Y inf_le_left (u (α_ch j)).1) at htr
    rw [hres_comp h_inf inf_le_right, hres_comp h_inf inf_le_left,
      ← hres_comp h_ij (hle_ch j)] at htr
    exact htr
  have hψ_eval : ∀ {i j : 𝒰.I₀} (h_ij : val_U i ≤ val_U j),
      Polynomial.eval₂ ((algebraMap (A_i i) (R_i i)).comp (res_Y h_ij))
        (algebraMap (A_i i) (R_i i) (g_ji h_ij).1 * t_i i) (P_i j) = 0 := by
    intro i j h_ij
    simp only [P_i, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
      Polynomial.eval₂_C, RingHom.comp_apply, mul_pow, ht_i_pow i, ← map_pow, ← map_mul,
      hg_ji_pow h_ij, sub_self]
  let ψ_ji : ∀ {i j : 𝒰.I₀}, val_U i ≤ val_U j → (R_i j →+* R_i i) :=
    fun {i j} h_ij => AdjoinRoot.lift ((algebraMap (A_i i) (R_i i)).comp (res_Y h_ij))
      (algebraMap (A_i i) (R_i i) (g_ji h_ij).1 * t_i i) (hψ_eval h_ij)
  have hψ_of : ∀ {i j : 𝒰.I₀} (h_ij : val_U i ≤ val_U j) (r : A_i j),
      ψ_ji h_ij (algebraMap (A_i j) (R_i j) r) =
        algebraMap (A_i i) (R_i i) (res_Y h_ij r) :=
    fun h_ij _ => AdjoinRoot.lift_of (hψ_eval h_ij)
  have hψ_root : ∀ {i j : 𝒰.I₀} (h_ij : val_U i ≤ val_U j),
      ψ_ji h_ij (t_i j) = algebraMap (A_i i) (R_i i) (g_ji h_ij).1 * t_i i :=
    fun h_ij => AdjoinRoot.lift_root (hψ_eval h_ij)
  have hψ_id : ∀ i : 𝒰.I₀, ψ_ji (le_refl (val_U i)) = RingHom.id (R_i i) := by
    intro i
    apply hAdjoinRoot_ext
    · intro r
      rw [hψ_of, hres_id, RingHom.id_apply]
    · rw [hψ_root, RingHom.id_apply]
      have hg1 : (g_ji (le_refl (val_U i))).1 = 1 := by
        change res_Y _ (g (α_ch i) (α_ch i)).1 = 1
        rw [hg_diag (α_ch i), map_one]
      rw [hg1, map_one, one_mul]
  have hψ_comp : ∀ {i j m : 𝒰.I₀} (h_ij : val_U i ≤ val_U j) (h_jm : val_U j ≤ val_U m),
      (ψ_ji h_ij).comp (ψ_ji h_jm) = ψ_ji (h_ij.trans h_jm) := by
    intro i j m h_ij h_jm
    apply hAdjoinRoot_ext
    · intro r
      rw [RingHom.comp_apply, hψ_of, hψ_of, hres_comp, hψ_of]
    · rw [RingHom.comp_apply, hψ_root, map_mul, hψ_of, hψ_root, ← mul_assoc, ← map_mul,
        hψ_root]
      congr 2
      let h_tri : val_U i ≤ (W (α_ch m) ⊓ W (α_ch j)) ⊓ W (α_ch i) :=
        le_inf (le_inf ((h_ij.trans h_jm).trans (hle_ch m)) (h_ij.trans (hle_ch j))) (hle_ch i)
      let p₁₂ : (W (α_ch m) ⊓ W (α_ch j)) ⊓ W (α_ch i) ≤ W (α_ch m) ⊓ W (α_ch j) :=
        fun _ hx => ⟨hx.1.1, hx.1.2⟩
      let p₂₃ : (W (α_ch m) ⊓ W (α_ch j)) ⊓ W (α_ch i) ≤ W (α_ch j) ⊓ W (α_ch i) :=
        fun _ hx => ⟨hx.1.2, hx.2⟩
      let p₁₃ : (W (α_ch m) ⊓ W (α_ch j)) ⊓ W (α_ch i) ≤ W (α_ch m) ⊓ W (α_ch i) :=
        fun _ hx => ⟨hx.1.1, hx.2⟩
      have hcoc : res_Y h_tri (res_Y p₁₂ (g (α_ch m) (α_ch j)).1 *
            res_Y p₂₃ (g (α_ch j) (α_ch i)).1) =
          res_Y h_tri (res_Y p₁₃ (g (α_ch m) (α_ch i)).1) :=
        congrArg (res_Y h_tri) (hg_cocycle (α_ch m) (α_ch j) (α_ch i))
      rw [map_mul, hres_comp h_tri p₁₂, hres_comp h_tri p₂₃, hres_comp h_tri p₁₃] at hcoc
      have h1 : res_Y h_ij (g_ji h_jm).1 =
          res_Y (h_tri.trans p₁₂) (g (α_ch m) (α_ch j)).1 :=
        hres_comp h_ij (le_inf (h_jm.trans (hle_ch m)) (hle_ch j)) _
      rw [h1]
      exact hcoc
  let F : 𝒰.I₀ ⥤ AlgebraicGeometry.Scheme.{u} :=
    { obj := fun i => AlgebraicGeometry.Spec (CommRingCat.of (R_i i))
      map := fun {i j} hij => AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji (leOfHom hij)))
      map_id := fun i => by
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji (le_refl (val_U i)))) = 𝟙 _
        rw [hψ_id i, CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
      map_comp := fun {i j m} hij hjm => by
        have hle1 : val_U i ≤ val_U j := leOfHom hij
        have hle2 : val_U j ≤ val_U m := leOfHom hjm
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji (hle1.trans hle2))) =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji hle1)) ≫
            AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji hle2))
        rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, hψ_comp hle1 hle2] }
  let ι_inv : ∀ i : 𝒰.I₀, AlgebraicGeometry.Spec (CommRingCat.of (A_i i)) ⟶ G_base.obj i :=
    fun i => (hAff_U i).isoSpec.inv
  haveI : ∀ i : 𝒰.I₀, CategoryTheory.IsIso (ι_inv i) :=
    fun i => inferInstanceAs (CategoryTheory.IsIso (hAff_U i).isoSpec.inv)
  have hι_inv_f : ∀ i : 𝒰.I₀, ι_inv i ≫ f_cov i = (hAff_U i).fromSpec :=
    fun i => (hAff_U i).isoSpec_inv_ι
  have hiso_nat : ∀ {i j : 𝒰.I₀} (hij : i ⟶ j),
      ι_inv i ≫ G_base.map hij =
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (res_Y (leOfHom hij))) ≫ ι_inv j := by
    intro i j hij
    apply (cancel_mono (f_cov j)).mp
    rw [Category.assoc, hG_map_ι hij, hι_inv_f i, Category.assoc, hι_inv_f j]
    have hmap_eq : CommRingCat.ofHom (res_Y (leOfHom hij)) =
        Y.presheaf.map (CategoryTheory.homOfLE (leOfHom hij)).op := rfl
    rw [hmap_eq]
    exact (AlgebraicGeometry.IsAffineOpen.map_fromSpec (hAff_U j) (hAff_U i)
      (CategoryTheory.homOfLE (leOfHom hij)).op).symm
  let τ : F ⟶ G_base :=
    { app := fun i =>
        AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i i) (R_i i))) ≫ ι_inv i
      naturality := fun {i j} hij => by
        let hle_ij : val_U i ≤ val_U j := leOfHom hij
        change AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji hle_ij)) ≫
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i j) (R_i j))) ≫
              ι_inv j) =
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i i) (R_i i))) ≫
            ι_inv i) ≫ G_base.map hij
        rw [← Category.assoc, ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        have hcomm : (ψ_ji hle_ij).comp (algebraMap (A_i j) (R_i j)) =
            (algebraMap (A_i i) (R_i i)).comp (res_Y hle_ij) := by
          apply RingHom.ext
          intro r
          exact hψ_of hle_ij r
        rw [hcomm, CommRingCat.ofHom_comp, AlgebraicGeometry.Spec.map_comp, Category.assoc,
          ← hiso_nat hij, ← Category.assoc] }
  have hEquifib : CategoryTheory.NatTrans.Equifibered τ := by
    intro i j hij
    let h_ij : val_U i ≤ val_U j := leOfHom hij
    letI : Algebra (A_i j) (A_i i) := (res_Y h_ij).toAlgebra
    letI : Algebra (A_i j) (R_i i) := inferInstanceAs (Algebra (A_i j) (AdjoinRoot (P_i i)))
    haveI : IsScalarTower (A_i j) (A_i i) (R_i i) :=
      inferInstanceAs (IsScalarTower (A_i j) (A_i i) (AdjoinRoot (P_i i)))
    let ψ_alg : R_i j →ₐ[A_i j] R_i i :=
      { ψ_ji h_ij with
        commutes' := fun r =>
          (hψ_of h_ij r).trans (IsScalarTower.algebraMap_apply (A_i j) (A_i i) (R_i i) r).symm }
    let Φ_fwd : TensorProduct (A_i j) (R_i j) (A_i i) →ₐ[A_i j] R_i i :=
      Algebra.TensorProduct.productMap ψ_alg (IsScalarTower.toAlgHom (A_i j) (A_i i) (R_i i))
    have hΦ_bwd_eval :
        Polynomial.eval₂
          (Algebra.TensorProduct.includeRight (R := A_i j) (A := R_i j) (B := A_i i)).toRingHom
          (TensorProduct.tmul (A_i j) (t_i j) ((g_ji h_ij)⁻¹).1) (P_i i) = 0 := by
      simp only [P_i, Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
        Polynomial.eval₂_C]
      rw [Algebra.TensorProduct.tmul_pow, ht_i_pow j]
      have hsmul : TensorProduct.tmul (A_i j) (algebraMap (A_i j) (R_i j) (u_i j).1)
          (((g_ji h_ij)⁻¹).1 ^ ℓ) =
          TensorProduct.tmul (A_i j) (1 : R_i j)
            (res_Y h_ij (u_i j).1 * (((g_ji h_ij)⁻¹).1 ^ ℓ)) := by
        have h1 : algebraMap (A_i j) (R_i j) (u_i j).1 = (u_i j).1 • (1 : R_i j) := by
          rw [Algebra.smul_def, mul_one]
        rw [h1, TensorProduct.smul_tmul]
        rfl
      rw [hsmul]
      have hunit_cancel : res_Y h_ij (u_i j).1 * (((g_ji h_ij)⁻¹).1 ^ ℓ) = (u_i i).1 := by
        rw [← hg_ji_pow h_ij]
        calc
          ((g_ji h_ij).1 ^ ℓ * (u_i i).1) * (((g_ji h_ij)⁻¹).1 ^ ℓ)
            = (u_i i).1 * ((g_ji h_ij).1 * ((g_ji h_ij)⁻¹).1) ^ ℓ := by
                rw [mul_pow]; ring
          _ = (u_i i).1 := by rw [Units.mul_inv, one_pow, mul_one]
      rw [hunit_cancel]
      exact sub_self _
    let Φ_bwd : R_i i →+* TensorProduct (A_i j) (R_i j) (A_i i) :=
      AdjoinRoot.lift
        (Algebra.TensorProduct.includeRight (R := A_i j) (A := R_i j) (B := A_i i)).toRingHom
        (TensorProduct.tmul (A_i j) (t_i j) ((g_ji h_ij)⁻¹).1) hΦ_bwd_eval
    have h_fb : Φ_fwd.toRingHom.comp Φ_bwd = RingHom.id (R_i i) := by
      apply hAdjoinRoot_ext
      · intro a
        change Φ_fwd (Φ_bwd (algebraMap (A_i i) (R_i i) a)) = algebraMap (A_i i) (R_i i) a
        have hb : Φ_bwd (algebraMap (A_i i) (R_i i) a) = TensorProduct.tmul (A_i j) 1 a :=
          AdjoinRoot.lift_of hΦ_bwd_eval
        rw [hb]
        change Algebra.TensorProduct.productMap ψ_alg
          (IsScalarTower.toAlgHom (A_i j) (A_i i) (R_i i)) (TensorProduct.tmul (A_i j) 1 a) = _
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
      · change Φ_fwd (Φ_bwd (t_i i)) = t_i i
        have hb : Φ_bwd (t_i i) = TensorProduct.tmul (A_i j) (t_i j) ((g_ji h_ij)⁻¹).1 :=
          AdjoinRoot.lift_root hΦ_bwd_eval
        rw [hb]
        change Algebra.TensorProduct.productMap ψ_alg
          (IsScalarTower.toAlgHom (A_i j) (A_i i) (R_i i))
          (TensorProduct.tmul (A_i j) (t_i j) ((g_ji h_ij)⁻¹).1) = t_i i
        rw [Algebra.TensorProduct.productMap_apply_tmul]
        change ψ_ji h_ij (t_i j) * algebraMap (A_i i) (R_i i) ((g_ji h_ij)⁻¹).1 = t_i i
        rw [hψ_root]
        calc
          (algebraMap (A_i i) (R_i i) (g_ji h_ij).1 * t_i i) *
              algebraMap (A_i i) (R_i i) ((g_ji h_ij)⁻¹).1
            = algebraMap (A_i i) (R_i i) ((g_ji h_ij).1 * ((g_ji h_ij)⁻¹).1) * t_i i := by
                rw [map_mul]; ring
          _ = t_i i := by rw [Units.mul_inv, map_one, one_mul]
    have h_bf_left : Φ_bwd.comp (ψ_ji h_ij) =
        Algebra.TensorProduct.includeLeftRingHom := by
      apply hAdjoinRoot_ext
      · intro b
        rw [RingHom.comp_apply, hψ_of]
        have hb : Φ_bwd (algebraMap (A_i i) (R_i i) (res_Y h_ij b)) =
            TensorProduct.tmul (A_i j) 1 (res_Y h_ij b) :=
          AdjoinRoot.lift_of hΦ_bwd_eval
        rw [hb]
        have hsm : res_Y h_ij b = b • (1 : A_i i) := by
          change algebraMap (A_i j) (A_i i) b = b • (1 : A_i i)
          rw [Algebra.smul_def, mul_one]
        rw [hsm, TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
        rfl
      · rw [RingHom.comp_apply, hψ_root, map_mul]
        have hb1 : Φ_bwd (algebraMap (A_i i) (R_i i) (g_ji h_ij).1) =
            TensorProduct.tmul (A_i j) 1 (g_ji h_ij).1 :=
          AdjoinRoot.lift_of hΦ_bwd_eval
        have hb2 : Φ_bwd (t_i i) = TensorProduct.tmul (A_i j) (t_i j) ((g_ji h_ij)⁻¹).1 :=
          AdjoinRoot.lift_root hΦ_bwd_eval
        rw [hb1, hb2, Algebra.TensorProduct.tmul_mul_tmul, one_mul, Units.mul_inv]
        rfl
    have h_bf : ∀ w : TensorProduct (A_i j) (R_i j) (A_i i), Φ_bwd (Φ_fwd w) = w := by
      intro w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | add x y ihx ihy => rw [map_add, map_add, ihx, ihy]
      | tmul r a =>
        change Φ_bwd (Algebra.TensorProduct.productMap ψ_alg
          (IsScalarTower.toAlgHom (A_i j) (A_i i) (R_i i)) (TensorProduct.tmul (A_i j) r a)) = _
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_mul]
        have hl : Φ_bwd (ψ_alg r) = TensorProduct.tmul (A_i j) r 1 :=
          RingHom.congr_fun h_bf_left r
        have hr : Φ_bwd ((IsScalarTower.toAlgHom (A_i j) (A_i i) (R_i i)) a) =
            TensorProduct.tmul (A_i j) 1 a :=
          AdjoinRoot.lift_of hΦ_bwd_eval
        rw [hl, hr, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    let e_spec_iso :
        AlgebraicGeometry.Spec (CommRingCat.of (R_i i)) ≅
          CategoryTheory.Limits.pullback
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i j) (R_i j))))
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i j) (A_i i)))) :=
      { hom := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_fwd.toRingHom)
        inv := AlgebraicGeometry.Spec.map (CommRingCat.ofHom Φ_bwd)
        hom_inv_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp, h_fb,
            CommRingCat.ofHom_id, AlgebraicGeometry.Spec.map_id]
        inv_hom_id := by
          rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
          have hid : CommRingCat.ofHom (Φ_bwd.comp Φ_fwd.toRingHom) = 𝟙 _ := by
            apply CommRingCat.hom_ext
            apply RingHom.ext
            intro w
            exact h_bf w
          rw [hid, AlgebraicGeometry.Spec.map_id] } ≪≫
        (AlgebraicGeometry.pullbackSpecIso (A_i j) (R_i j) (A_i i)).symm
    have hcomm_aff :
        CategoryTheory.CommSq
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji h_ij)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i i) (R_i i))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i j) (R_i j))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i j) (A_i i)))) := by
      refine ⟨?_⟩
      rw [← AlgebraicGeometry.Spec.map_comp, ← AlgebraicGeometry.Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
      congr 1
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro r
      exact hψ_of h_ij r
    have hPb_aff :
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (ψ_ji h_ij)))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i i) (R_i i))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i j) (R_i j))))
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap (A_i j) (A_i i)))) := by
      refine CategoryTheory.IsPullback.of_iso_pullback hcomm_aff e_spec_iso ?_ ?_
      · dsimp [e_spec_iso]
        rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_fst,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        change Algebra.TensorProduct.productMap ψ_alg
          (IsScalarTower.toAlgHom (A_i j) (A_i i) (R_i i)) (TensorProduct.tmul (A_i j) r 1) =
          ψ_ji h_ij r
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one]
        rfl
      · dsimp [e_spec_iso]
        rw [Category.assoc, AlgebraicGeometry.pullbackSpecIso_inv_snd,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp]
        congr 1
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        change Algebra.TensorProduct.productMap ψ_alg
          (IsScalarTower.toAlgHom (A_i j) (A_i i) (R_i i)) (TensorProduct.tmul (A_i j) 1 a) =
          algebraMap (A_i i) (R_i i) a
        rw [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul]
        rfl
    have hPb_iso :
        CategoryTheory.IsPullback
