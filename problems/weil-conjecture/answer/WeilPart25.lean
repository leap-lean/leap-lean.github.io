        let gen_U2 : ↥(F₂.obj.obj (Opposite.op U₂_et)) :=
          ((CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id F₂)).hom) (ULift.up (1 : ZMod ℓ))
        let gen_U'y : ↥(L_U'.obj.obj (Opposite.op U'_y)) :=
          ((CategoryTheory.Sheaf.freeYonedaHomEquiv
            (CategoryTheory.CategoryStruct.id L_U')).hom) (ULift.up (1 : ZMod ℓ))
        have hτ_unit :
            ((τ_sh.hom.app (Opposite.op U'_y)).hom)
              ((((adj_ι.unit.app F₂).hom.app (Opposite.op U₂_et)).hom) gen_U2) =
            ((L_Y2.obj.map (Opposite.op e_U'.hom)).hom) gen_Y2 := by
          have he_ιU_gen : ((e_ιU.hom.app (Opposite.op U'_y)).hom) gen_U'y =
              (((adj_ι.unit.app F₂).hom.app (Opposite.op U₂_et)).hom) gen_U2 := by
            have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv e_ιU =
                CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_U') ≫
                  e_ιU.hom.app (Opposite.op U'_y) :=
              (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
                (CategoryTheory.Category.id_comp e_ιU)).symm.trans
                (hEquiv_comp (CategoryTheory.CategoryStruct.id L_U') e_ιU)
            have h2 : CategoryTheory.Sheaf.freeYonedaHomEquiv u_ιU =
                CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id F₂) ≫
                  u_ιU.hom.app (Opposite.op U₂_et) :=
              (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
                (CategoryTheory.Category.id_comp u_ιU)).symm.trans
                (hEquiv_comp (CategoryTheory.CategoryStruct.id F₂) u_ιU)
            have h3 : CategoryTheory.Sheaf.freeYonedaHomEquiv e_ιU = η_ιU :=
              Equiv.apply_symm_apply _ _
            exact congrArg (fun f => f.hom (ULift.up (1 : ZMod ℓ)))
              (h1.symm.trans (h3.trans h2))
          have hinv_gen : ((e_F'_iso.inv.hom.app (Opposite.op U'_y)).hom)
              ((((adj_ι.unit.app F₂).hom.app (Opposite.op U₂_et)).hom) gen_U2) = gen_U'y :=
            (congrArg ((e_F'_iso.inv.hom.app (Opposite.op U'_y)).hom) he_ιU_gen.symm).trans
              (congrArg (fun φ => (φ.hom.app (Opposite.op U'_y)).hom gen_U'y) e_F'_iso.hom_inv_id)
          have heLU_gen : ((e_LU_hom.hom.app (Opposite.op U'_y)).hom) gen_U'y =
              ((L_Y2.obj.map (Opposite.op e_U'.hom)).hom) gen_Y2 := by
            have h1 : CategoryTheory.Sheaf.freeYonedaHomEquiv e_LU_hom =
                CategoryTheory.Sheaf.freeYonedaHomEquiv (CategoryTheory.CategoryStruct.id L_U') ≫
                  e_LU_hom.hom.app (Opposite.op U'_y) :=
              (congrArg CategoryTheory.Sheaf.freeYonedaHomEquiv
                (CategoryTheory.Category.id_comp e_LU_hom)).symm.trans
                (hEquiv_comp (CategoryTheory.CategoryStruct.id L_U') e_LU_hom)
            exact congrArg (fun f => f.hom (ULift.up (1 : ZMod ℓ)))
