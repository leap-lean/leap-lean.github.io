  haveI : CategoryTheory.Limits.HasColimit d.functor := hHasColim d
  haveI : CategoryTheory.Limits.HasColimit F := hHasColim d
  let Z : AlgebraicGeometry.Scheme.{u} := d.glued
  let ν : Z ⟶ Y := d.toBase
  have hle_f_top : ∀ U : Y.Opens, U ≤ (TopologicalSpace.Opens.map f.base).obj ⊤ :=
