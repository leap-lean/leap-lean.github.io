  have hPW_eq_Q : P.W_open = Q_open := by
    apply le_antisymm hW_le_Q
    intro y hyQ
    by_contra hy_not_W
    haveI : AlgebraicGeometry.IsIntegral P.Y := P.hInt_Y
    have hIrred_PY : IrreducibleSpace ↥P.Y := AlgebraicGeometry.irreducibleSpace_of_isIntegral P.Y
    let U_diff : Set ↥P.Y := Q_open.ι.base '' (Set.range j_WQ.base)ᶜ
    have hOpen_Udiff : IsOpen U_diff :=
      Q_open.ι.isOpenEmbedding.isOpenMap _ hCl_range_j.isOpen_compl
    have hq_not_range : (⟨y, hyQ⟩ : ↥Q_open.toScheme) ∉ Set.range j_WQ.base := by
      rintro ⟨p, hp⟩
