                  (CategoryTheory.Limits.pullback.fst T₁.hom ν))).trans
                (CategoryTheory.Category.id_comp _).symm)))
      · exact (congrArg (fun k => (k ≫ s_T) ≫ _) hα_left).trans
          ((CategoryTheory.Category.assoc (B_ν.obj T₁).hom s_T _).trans
            ((congrArg ((B_ν.obj T₁).hom ≫ ·)
              (CategoryTheory.Limits.pullback.lift_snd _ _ _)).trans
              ((CategoryTheory.Category.comp_id (B_ν.obj T₁).hom).trans
                (CategoryTheory.Category.id_comp _).symm)))
    have hαβ : α_T ≫ β_T = CategoryTheory.CategoryStruct.id (B_ν.obj T₁) :=
      CategoryTheory.MorphismProperty.Comma.Hom.ext hαβ_left (Subsingleton.elim _ _)
