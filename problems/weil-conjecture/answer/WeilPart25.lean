  obtain ⟨hc_all, hr_all, hSite⟩ :=
    weil_etale_site_pullback_rightAdjoint_and_exact_package.{u}

  have hConn_s₀ : ConnectedSpace ↥(CategoryTheory.Limits.pullback f_ZU'' s₀) :=
    weil_etale_proper_r0_pbc_geom_fibers_connected k ℓ hPBC (@hc_all) (@hr_all) hSite
