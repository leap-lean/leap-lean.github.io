    exact hz₁_ne (τ_B₁.toRingHom.injective (hτ_z₁.trans (map_zero _).symm))

  have hι_mid_t₁_ne : ι_mid_Ω t₁ ≠ 0 :=
    fun h0 => ht₁_ne (hι_mid_Ω_inj (h0.trans (map_zero _).symm))
  let ι_B₁_Ω : B₁ →+* Ω := IsLocalization.Away.lift t₁ (Ne.isUnit hι_mid_t₁_ne)
  have hι_B₁_eq : ∀ b : B_mid, ι_B₁_Ω (algebraMap B_mid B₁ b) = ι_mid_Ω b :=
    fun b => IsLocalization.Away.lift_eq t₁ (Ne.isUnit hι_mid_t₁_ne) b
  have hι_B₁_comp_mid : ι_B₁_Ω.comp (algebraMap B_mid B₁) = ι_mid_Ω :=
    RingHom.ext hι_B₁_eq
  have hι_B₁_Ω_inj : Function.Injective ι_B₁_Ω := by
    rw [injective_iff_map_eq_zero]
    intro w hw
    obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj (Submonoid.powers t₁) w
    have hb0 : ι_mid_Ω b = 0 := by
      calc
        ι_mid_Ω b = ι_B₁_Ω (algebraMap B_mid B₁ b) := (hι_B₁_eq b).symm
        _ = ι_B₁_Ω (w * algebraMap B_mid B₁ s) := by rw [hbs]
        _ = ι_B₁_Ω w * ι_B₁_Ω (algebraMap B_mid B₁ s) := map_mul _ _ _
        _ = 0 := by rw [hw, zero_mul]
    have hb_zero : b = 0 := hι_mid_Ω_inj (hb0.trans (map_zero _).symm)
    have hs_unit : IsUnit (algebraMap B_mid B₁ s) := IsLocalization.map_units B₁ s
    apply hs_unit.mul_right_cancel
    dsimp at hbs
    rw [hbs, hb_zero, map_zero, zero_mul]

  let g₁ : AlgebraicGeometry.Spec (CommRingCat.of B₁) ⟶ C_aff :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁)) ≫ g_mid

  have h1a : AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₁.toRingHom) ≫ g₁ = s_c₀ := by
    have hτ_comp : (τ_B₁_ring.comp (algebraMap B_mid B₁)).comp
        (algebraMap B₀' B_mid) = τ₀'.toRingHom := by
      ext b
      simp only [RingHom.comp_apply, hτ_B₁_eq]
      exact hτ_mid_eq b
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ_B₁_ring) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁)) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' B_mid)) ≫ g₀')) =
      s_c₀
    rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      hτ_comp, hτ₀'_g₀']

  have hι_B₁_B₀' : (ι_B₁_Ω.comp (algebraMap B_mid B₁)).comp (algebraMap B₀' B_mid) =
      ι_L₁_Ω.comp (algebraMap B₀' L₁) := by
    ext b
    simp only [RingHom.comp_apply, hι_B₁_eq]
    exact congrFun (congrArg DFunLike.coe hι_mid_B₀') b

  have h1b : AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω) ≫ g₁ =
      s_η_dom ≫ g_dom := by
    change AlgebraicGeometry.Spec.map (CommRingCat.ofHom ι_B₁_Ω) ≫
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B_mid B₁)) ≫
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap B₀' B_mid)) ≫ g₀')) =
      s_η_dom ≫ g_dom
    rw [← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
      hι_B₁_B₀', hι₀'_g₀']

  have h1c : g₁ ≫ (u_C ≫ (weilAffineSpaceOver k 1).hom) =
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k B₁)) := by
    have halg_comp : ((algebraMap B_mid B₁).comp (algebraMap B₀' B_mid)).comp
