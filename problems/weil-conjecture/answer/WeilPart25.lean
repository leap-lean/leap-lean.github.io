        F_U.obj.obj (Opposite.op ((weilEtaleSitePullback (τ a)).obj (B_f₁.obj T_U))) :=
      (ρ_a a).hom.app (Opposite.op (B_f₁.obj T_U))
    let u₃ : F_U.obj.obj (Opposite.op ((weilEtaleSitePullback (τ a)).obj (B_f₁.obj T_U))) ⟶
