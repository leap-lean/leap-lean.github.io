        (hΦ g₁ g₂ hf₁ hf₂ hg)
    let ψ_fun : ↑E → LocallyConstant ↥U.left AM_type :=
      fun e => hFor.amalgamate (sf_e e) (hsf_e e)
    have hψ_glue : ∀ (e : ↑E) {Y : S.Etale} (f : Y ⟶ U) (hf : R.arrows f),
        (P_loc.map f.op).hom (ψ_fun e) = (Φ f hf).hom e :=
      fun e {_} f hf => hFor.valid_glue (hsf_e e) f hf
    have hψ_zero : ψ_fun 0 = 0 := by
      apply hFor.isSeparatedFor.ext
      intro Y f hf
      change (P_loc.map f.op).hom (ψ_fun 0) = (P_loc.map f.op).hom 0
      rw [hψ_glue 0 f hf, map_zero, map_zero]
    have hψ_add : ∀ e₁ e₂ : ↑E, ψ_fun (e₁ + e₂) = ψ_fun e₁ + ψ_fun e₂ := by
      intro e₁ e₂
      apply hFor.isSeparatedFor.ext
      intro Y f hf
      have h1 : (P_loc.map f.op).hom (ψ_fun (e₁ + e₂)) = (Φ f hf).hom e₁ + (Φ f hf).hom e₂ :=
        (hψ_glue (e₁ + e₂) f hf).trans (map_add (Φ f hf).hom e₁ e₂)
      have h2 : (P_loc.map f.op).hom (ψ_fun e₁ + ψ_fun e₂) = (Φ f hf).hom e₁ + (Φ f hf).hom e₂ :=
        (map_add (P_loc.map f.op).hom (ψ_fun e₁) (ψ_fun e₂)).trans
          (congrArg₂ (· + ·) (hψ_glue e₁ f hf) (hψ_glue e₂ f hf))
      exact h1.trans h2.symm
    let ψ : E ⟶ P_loc.obj (Opposite.op U) :=
      AddCommGrpCat.ofHom
        { toFun := ψ_fun
          map_zero' := hψ_zero
          map_add' := hψ_add }
    refine ⟨ψ, ?_, ?_⟩
    · intro Y f hf
      exact AddCommGrpCat.ext (fun e => hψ_glue e f hf)
    · intro ψ' hψ'
      apply AddCommGrpCat.ext
      intro e
      apply hFor.isSeparatedFor.ext
      intro Y f hf
      change (P_loc.map f.op).hom (ψ'.hom e) = (P_loc.map f.op).hom (ψ_fun e)
      rw [hψ_glue e f hf]
      exact congrArg (fun (k : E ⟶ P_loc.obj (Opposite.op Y)) => k.hom e) (hψ' f hf)

  have hIsoPkg : ∀ S : AlgebraicGeometry.Scheme.{u},
      ∃ e_S : CategoryTheory.Iso (weilEtaleTorsionSheaf S m) ⟨weilAltLocConstPresheaf S m, hSh S⟩,
        ∀ {T_S : S.Etale} (hT_S : CategoryTheory.Limits.IsTerminal T_S),
          let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
          CategoryTheory.CategoryStruct.comp (adj_S.unit.app AM)
            (e_S.hom.hom.app (Opposite.op T_S)) =
            weilAltLocConstConstHom S T_S m := by
    intro S
    let J := S.smallEtaleTopology
    let P_const : S.Etaleᵒᵖ ⥤ AddCommGrpCat.{u} :=
      (CategoryTheory.Functor.const (Opposite S.Etale)).obj AM
    let P_loc := weilAltLocConstPresheaf S m
    let L_S : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨P_loc, hSh S⟩
    let adj_sh := CategoryTheory.sheafificationAdjunction J AddCommGrpCat.{u}
    let η_const : P_const ⟶ P_loc :=
      { app := fun U => weilAltLocConstConstHom S (Opposite.unop U) m
        naturality := fun _ _ _ => AddCommGrpCat.ext (fun _ => LocallyConstant.ext (fun _ => rfl)) }
    have hLocInj : CategoryTheory.Presheaf.IsLocallyInjective S.smallEtaleTopology η_const := by
      apply CategoryTheory.Presheaf.IsLocallyInjective.mk
      intro U_op a₁ a₂ ha
      let U : S.Etale := Opposite.unop U_op
      refine Eq.mp (congrArg
        (fun K : CategoryTheory.GrothendieckTopology S.Etale => _ ∈ K U) (heq_J S).symm) ?_
      apply (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U _).mpr
      intro x
      have ha_eq : a₁ = a₂ :=
        congrArg (fun (g : LocallyConstant ↥U.left AM_type) => g.toFun x) ha
      cases ha_eq
      refine ⟨U, CategoryTheory.CategoryStruct.id U, x, rfl, ?_, rfl⟩
      change AlgebraicGeometry.Etale (CategoryTheory.CategoryStruct.id U.left)
      infer_instance
    have hLocSurj : CategoryTheory.Presheaf.IsLocallySurjective S.smallEtaleTopology η_const := by
      apply CategoryTheory.Presheaf.IsLocallySurjective.mk
      intro U g
      refine Eq.mp (congrArg
        (fun K : CategoryTheory.GrothendieckTopology S.Etale => _ ∈ K U) (heq_J S).symm) ?_
      apply (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := P_et) (Q := P_et) U _).mpr
      intro x
      let g_lc : LocallyConstant ↥U.left AM_type := g
      let a : AM_type := g_lc x
      let O_x : U.left.Opens := ⟨g_lc ⁻¹' {a}, g_lc.isLocallyConstant {a}⟩
      have hx : x ∈ O_x := rfl
      have : AlgebraicGeometry.Etale U.hom := U.prop
      let Y : S.Etale :=
        CategoryTheory.MorphismProperty.Over.mk ⊤ (O_x.ι ≫ U.hom) inferInstance
      let f : Y ⟶ U :=
        CategoryTheory.MorphismProperty.Over.homMk O_x.ι rfl trivial
      let y : ↥Y.left := (⟨x, hx⟩ : ↥O_x)
      refine ⟨Y, f, y, ?_, ?_, ?_⟩
      · rw [CategoryTheory.Presheaf.imageSieve_apply]
        refine ⟨a, ?_⟩
        apply LocallyConstant.ext
        intro z
        change a = g_lc (O_x.ι z)
        have hz_ι : O_x.ι z = (z : ↥O_x).1 := AlgebraicGeometry.Scheme.Opens.ι_apply O_x z
        rw [hz_ι]
        exact (Set.mem_singleton_iff.mp (z : ↥O_x).2).symm
      · change AlgebraicGeometry.Etale O_x.ι
        infer_instance
      · exact AlgebraicGeometry.Scheme.Opens.ι_apply O_x ⟨x, hx⟩
    have : CategoryTheory.Presheaf.IsLocallyInjective S.smallEtaleTopology η_const := hLocInj
    have : CategoryTheory.Presheaf.IsLocallySurjective S.smallEtaleTopology η_const := hLocSurj
    have hW : S.smallEtaleTopology.W η_const :=
      CategoryTheory.GrothendieckTopology.W_of_isLocallyBijective S.smallEtaleTopology η_const
    have hIso_map : CategoryTheory.IsIso
        ((CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map η_const) :=
      (CategoryTheory.GrothendieckTopology.W_iff S.smallEtaleTopology η_const).mp hW
    have hIso_counit : CategoryTheory.IsIso
        ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).counit.app L_S) :=
      inferInstance
    let φ_S : weilEtaleTorsionSheaf S m ⟶ L_S :=
      ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        P_const L_S).symm η_const
    have hφ_eq : φ_S =
        (CategoryTheory.presheafToSheaf S.smallEtaleTopology AddCommGrpCat.{u}).map η_const ≫
          (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).counit.app L_S :=
      (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).homEquiv_counit
        P_const L_S η_const
    have : CategoryTheory.IsIso φ_S := by
      rw [hφ_eq]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_map hIso_counit
    let e_S : CategoryTheory.Iso (weilEtaleTorsionSheaf S m) L_S := CategoryTheory.asIso φ_S
    refine ⟨e_S, ?_⟩
    intro T_S hT_S adj_S
    have h_unit_sh :
        (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app P_const ≫
          (CategoryTheory.sheafToPresheaf S.smallEtaleTopology AddCommGrpCat.{u}).map φ_S = η_const := by
      rw [← (CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).homEquiv_unit
        P_const L_S φ_S]
      exact ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).homEquiv
        P_const L_S).apply_symm_apply η_const
    have h_app := congrArg (fun (α : P_const ⟶ P_loc) => α.app (Opposite.op T_S)) h_unit_sh
    change ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
        P_const).app (Opposite.op T_S) ≫ e_S.hom.hom.app (Opposite.op T_S) =
      weilAltLocConstConstHom S T_S m at h_app
    have h_unit_eq : adj_S.unit.app AM =
        ((CategoryTheory.sheafificationAdjunction S.smallEtaleTopology AddCommGrpCat.{u}).unit.app
          P_const).app (Opposite.op T_S) := by
      dsimp [adj_S, P_const, CategoryTheory.constantSheafAdj, CategoryTheory.Adjunction.comp,
        CategoryTheory.constantPresheafAdj, CategoryTheory.sheafificationAdjunction]
      ext ⟨b⟩
      simp
    rwa [← h_unit_eq] at h_app

  let e_loc : ∀ S : AlgebraicGeometry.Scheme.{u},
      CategoryTheory.Iso (weilEtaleTorsionSheaf S m) ⟨weilAltLocConstPresheaf S m, hSh S⟩ :=
    fun S => Classical.choose (hIsoPkg S)
  have he_loc : ∀ (S : AlgebraicGeometry.Scheme.{u})
      {T_S : S.Etale} (hT_S : CategoryTheory.Limits.IsTerminal T_S),
      let adj_S := CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT_S
      CategoryTheory.CategoryStruct.comp (adj_S.unit.app AM)
        ((e_loc S).hom.hom.app (Opposite.op T_S)) =
        weilAltLocConstConstHom S T_S m :=
    fun S {_} hT_S => Classical.choose_spec (hIsoPkg S) hT_S

  refine ⟨hSh, e_loc, ?_, ?_⟩
  · intro S
    exact he_loc S (weilEtaleIdTerminalIsTerminal.{u} S)
  · intro S₁ S₂ h T₁ hT₁ T₂ hT₂
    dsimp only []
    have : (weilEtaleSitePullback h).IsContinuous S₂.smallEtaleTopology S₁.smallEtaleTopology :=
      hc_all h
    have : ((weilEtaleSitePullback h).sheafPushforwardContinuous AddCommGrpCat.{u}
      S₂.smallEtaleTopology S₁.smallEtaleTopology).IsRightAdjoint := hr_all h
    let J₁ := S₁.smallEtaleTopology
    let J₂ := S₂.smallEtaleTopology
    let FM₁ := weilEtaleTorsionSheaf S₁ m
    let FM₂ := weilEtaleTorsionSheaf S₂ m
    let L₁ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf S₁ m, hSh S₁⟩
    let L₂ : CategoryTheory.Sheaf J₂ AddCommGrpCat.{u} := ⟨weilAltLocConstPresheaf S₂ m, hSh S₂⟩
    let B := weilEtaleSitePullback h
    let pf_h := B.sheafPushforwardContinuous AddCommGrpCat.{u} J₂ J₁
    let pb_h := B.sheafPullback AddCommGrpCat.{u} J₂ J₁
    let adj_h := B.sheafAdjunctionContinuous AddCommGrpCat.{u} J₂ J₁
    let adj₁ := CategoryTheory.constantSheafAdj J₁ AddCommGrpCat.{u} hT₁
    let adj₂ := CategoryTheory.constantSheafAdj J₂ AddCommGrpCat.{u} hT₂
    let τ : B.obj T₂ ⟶ T₁ := hT₁.from (B.obj T₂)
    let β_L : pb_h.obj L₂ ⟶ L₁ :=
      (adj_h.homEquiv L₂ L₁).symm { hom := weilAltLocConstPullbackNat h m }
    let πM : pb_h.obj FM₂ ⟶ FM₁ := weilEtaleConstPullbackHom h hT₁ hT₂ AM
    change pb_h.map (e_loc S₂).hom ≫ β_L = πM ≫ (e_loc S₁).hom
    apply (adj_h.homEquiv FM₂ L₁).injective
    have hLHS₁ : (adj_h.homEquiv FM₂ L₁) (pb_h.map (e_loc S₂).hom ≫ β_L) =
        (e_loc S₂).hom ≫ ({ hom := weilAltLocConstPullbackNat h m } : L₂ ⟶ pf_h.obj L₁) := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_left]
      exact congrArg _ ((adj_h.homEquiv L₂ L₁).apply_symm_apply _)
    have hRHS₁ : (adj_h.homEquiv FM₂ L₁) (πM ≫ (e_loc S₁).hom) =
        (adj₂.homEquiv AM (pf_h.obj FM₁)).symm (adj₁.unit.app AM ≫ FM₁.obj.map τ.op) ≫
          pf_h.map (e_loc S₁).hom := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
      exact congrArg (· ≫ pf_h.map (e_loc S₁).hom) ((adj_h.homEquiv FM₂ FM₁).apply_symm_apply _)
    rw [hLHS₁, hRHS₁]
    apply (adj₂.homEquiv AM (pf_h.obj L₁)).injective
    have hLHS₂ : (adj₂.homEquiv AM (pf_h.obj L₁))
        ((e_loc S₂).hom ≫ ({ hom := weilAltLocConstPullbackNat h m } : L₂ ⟶ pf_h.obj L₁)) =
        weilAltLocConstConstHom S₂ T₂ m ≫
          (weilAltLocConstPullbackNat h m).app (Opposite.op T₂) := by
      rw [adj₂.homEquiv_unit]
      change adj₂.unit.app AM ≫
          ((e_loc S₂).hom.hom.app (Opposite.op T₂) ≫
            (weilAltLocConstPullbackNat h m).app (Opposite.op T₂)) = _
      rw [← CategoryTheory.Category.assoc, he_loc S₂ hT₂]
    have hRHS₂ : (adj₂.homEquiv AM (pf_h.obj L₁))
        ((adj₂.homEquiv AM (pf_h.obj FM₁)).symm (adj₁.unit.app AM ≫ FM₁.obj.map τ.op) ≫
          pf_h.map (e_loc S₁).hom) =
        weilAltLocConstConstHom S₁ T₁ m ≫
          (weilAltLocConstPresheaf S₁ m).map τ.op := by
      rw [CategoryTheory.Adjunction.homEquiv_naturality_right,
        (adj₂.homEquiv AM (pf_h.obj FM₁)).apply_symm_apply]
      change (adj₁.unit.app AM ≫ FM₁.obj.map τ.op) ≫
          (e_loc S₁).hom.hom.app (Opposite.op (B.obj T₂)) = _
      rw [CategoryTheory.Category.assoc,
        (e_loc S₁).hom.hom.naturality τ.op,
        ← CategoryTheory.Category.assoc,
        he_loc S₁ hT₁]
    rw [hLHS₂, hRHS₂]
    apply AddCommGrpCat.ext
    intro a
    apply LocallyConstant.ext
    intro y
    rfl

theorem weil_clopen_section_sheeted_etale_pushforward_epi_and_leray_h1_ker (ℓ m : ℕ) [Fact (Nat.Prime ℓ)]
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint)
    (hExact_all : WeilEtaleSiteExactAndSliceInjHolds.{u} (@hc_all) (@hr_all))
    (X Z₀ : AlgebraicGeometry.Scheme.{u})
    (ν₀ : Quiver.Hom Z₀ X)
    [AlgebraicGeometry.Etale ν₀]
    [AlgebraicGeometry.Surjective ν₀]
    (hSheets : ∀ (U₀ : AlgebraicGeometry.Scheme.{u})
        (p_U : Quiver.Hom U₀ X) [AlgebraicGeometry.Etale p_U]
        (s : Quiver.Hom U₀ Z₀),
        CategoryTheory.CategoryStruct.comp s ν₀ = p_U →
        ∃ ι : ZMod ℓ → Quiver.Hom U₀ (CategoryTheory.Limits.pullback p_U ν₀),
          (∀ a : ZMod ℓ,
            CategoryTheory.CategoryStruct.comp (ι a) (CategoryTheory.Limits.pullback.fst p_U ν₀) =
              CategoryTheory.CategoryStruct.id U₀) ∧
          (∀ a : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (ι a)) ∧
          (∀ a : ZMod ℓ, AlgebraicGeometry.Etale
            (CategoryTheory.CategoryStruct.comp (ι a) (CategoryTheory.Limits.pullback.snd p_U ν₀))) ∧
          (_root_.Pairwise fun a b : ZMod ℓ =>
            Disjoint (Set.range (ι a).base) (Set.range (ι b).base)) ∧
          (⋃ a : ZMod ℓ, Set.range (ι a).base) = Set.univ) :
    WeilEtalePushforwardPreservesEpi ν₀ ∧
    ∀ (p_ν : weilEtaleTorsionH X m 1 →+ weilEtaleTorsionH Z₀ m 1),
      WeilIsTorsionEtalePullback ν₀ m 1 p_ν →
      letI : (weilEtaleSitePullback ν₀).IsContinuous X.smallEtaleTopology Z₀.smallEtaleTopology :=
        hc_all ν₀
      letI : ((weilEtaleSitePullback ν₀).sheafPushforwardContinuous AddCommGrpCat.{u}
        X.smallEtaleTopology Z₀.smallEtaleTopology).IsRightAdjoint := hr_all ν₀
      let B := weilEtaleSitePullback ν₀
      let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} X.smallEtaleTopology Z₀.smallEtaleTopology
      let adj_ν := B.sheafAdjunctionContinuous AddCommGrpCat.{u} X.smallEtaleTopology Z₀.smallEtaleTopology
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
      let πM₀ := weilEtaleConstPullbackHom ν₀
        (weilEtaleIdTerminalIsTerminal.{u} Z₀) (weilEtaleIdTerminalIsTerminal.{u} X) AM
      let η_M : Quiver.Hom (weilEtaleTorsionSheaf X m) (pf.obj (weilEtaleTorsionSheaf Z₀ m)) :=
        (adj_ν.homEquiv (weilEtaleTorsionSheaf X m) (weilEtaleTorsionSheaf Z₀ m)) πM₀
      ∀ w : weilEtaleTorsionH X m 1,
        p_ν w = 0 →
        w.comp (CategoryTheory.Abelian.Ext.mk₀ η_M) (Nat.add_zero 1) = 0 :=
by
  classical
  let _ := hExact_all
  have hPrime : Nat.Prime ℓ := Fact.out
  have : NeZero ℓ := ⟨hPrime.ne_zero⟩
  let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
    @AlgebraicGeometry.Etale
  have hSmallEt_iff :
      ∀ (S : AlgebraicGeometry.Scheme.{u}) (W : S.Etale) (R₀ : CategoryTheory.Sieve W),
        R₀ ∈ S.smallEtaleTopology W ↔
          ∀ x : ↥W.left, ∃ (Y : S.Etale) (f : Y ⟶ W) (y : ↥Y.left),
            R₀.arrows f ∧ P_et f.left ∧ f.left.base y = x := by
    intro S W R₀
    have hEq := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) S (le_refl P_et)
    have h1 : R₀ ∈ S.smallEtaleTopology W ↔
        R₀ ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck W :=
      Iff.of_eq (congrArg (fun T => R₀ ∈ T W) hEq)
    exact h1.trans (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
      (P := P_et) (Q := P_et) (S := S) W R₀)
  have hEt_of_hom :
      ∀ {S : AlgebraicGeometry.Scheme.{u}} {V₁ V₂ : S.Etale} (v : V₁ ⟶ V₂),
        AlgebraicGeometry.Etale v.left := by
    intro S V₁ V₂ v
    have hvw : v.left ≫ V₂.hom = V₁.hom := CategoryTheory.MorphismProperty.Over.w v
    have hEt_comp : AlgebraicGeometry.Etale (v.left ≫ V₂.hom) := by
      rw [hvw]
      exact V₁.prop
    exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
      v.left V₂.hom V₂.prop hEt_comp

  have hEpi : WeilEtalePushforwardPreservesEpi ν₀ := by
    have : (weilEtaleSitePullback ν₀).IsContinuous X.smallEtaleTopology Z₀.smallEtaleTopology :=
      hc_all ν₀
    let B := weilEtaleSitePullback ν₀
    let pf := B.sheafPushforwardContinuous AddCommGrpCat.{u} X.smallEtaleTopology Z₀.smallEtaleTopology
    refine ⟨hc_all ν₀, ?_⟩
    dsimp only
    intro G₁ G₂ α hEpi_α
    change CategoryTheory.Epi (pf.map α)
    have hLocSurj_α : CategoryTheory.Sheaf.IsLocallySurjective α :=
      (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} α).mpr hEpi_α
    apply (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u} (pf.map α)).mp
    refine CategoryTheory.Presheaf.IsLocallySurjective.mk fun {U} t => ?_
    let S_im := CategoryTheory.Presheaf.imageSieve (pf.map α).hom t
    change S_im ∈ X.smallEtaleTopology U
    let fst_U : CategoryTheory.Limits.pullback U.hom ν₀ ⟶ U.left :=
      CategoryTheory.Limits.pullback.fst U.hom ν₀
    let snd_U : CategoryTheory.Limits.pullback U.hom ν₀ ⟶ Z₀ :=
      CategoryTheory.Limits.pullback.snd U.hom ν₀
    have hPb_U : CategoryTheory.IsPullback fst_U snd_U U.hom ν₀ :=
      CategoryTheory.IsPullback.of_hasPullback U.hom ν₀
    have : AlgebraicGeometry.Etale fst_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_U.flip inferInstance
    have : AlgebraicGeometry.Surjective fst_U :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hPb_U.flip inferInstance
    have : AlgebraicGeometry.Etale U.hom := U.prop
    have hEt_U₁ : AlgebraicGeometry.Etale (fst_U ≫ U.hom) := inferInstance
    let U₁ : X.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (fst_U ≫ U.hom) hEt_U₁
    let p₁ : U₁ ⟶ U := CategoryTheory.MorphismProperty.Over.homMk fst_U rfl trivial
    have hp₁_cov :
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.singleton p₁) ∈
          X.smallEtaleTopology U := by
      rw [hSmallEt_iff]
      intro x
      obtain ⟨y, hy⟩ := (inferInstance : AlgebraicGeometry.Surjective fst_U).surj x
      refine ⟨U₁, p₁, y,
        CategoryTheory.Sieve.le_generate (CategoryTheory.Presieve.singleton p₁) U₁ p₁
          CategoryTheory.Presieve.singleton.mk,
        inferInstance, hy⟩
    have hPull_p₁_mem : CategoryTheory.Sieve.pullback p₁ S_im ∈ X.smallEtaleTopology U₁ := by
      have : AlgebraicGeometry.Etale U₁.hom := U₁.prop
      have hs₁_comm : snd_U ≫ ν₀ = U₁.hom :=
        (CategoryTheory.Limits.pullback.condition (f := U.hom) (g := ν₀)).symm
      obtain ⟨ι, hι_fst, hι_open, hι_et, hι_disj, hι_univ⟩ :=
        hSheets U₁.left U₁.hom snd_U hs₁_comm
      let V : ZMod ℓ → Z₀.Etale :=
        fun a => CategoryTheory.MorphismProperty.Over.mk ⊤
          (ι a ≫ CategoryTheory.Limits.pullback.snd U₁.hom ν₀) (hι_et a)
      let ι_hat : ∀ a : ZMod ℓ, V a ⟶ B.obj U₁ :=
        fun a => CategoryTheory.MorphismProperty.Over.homMk (ι a) rfl trivial
      let t₁ : ↑(G₂.obj.obj (Opposite.op (B.obj U₁))) :=
        (G₂.obj.map (Opposite.op (B.map p₁))).hom t
      let t_a : ∀ a : ZMod ℓ, ↑(G₂.obj.obj (Opposite.op (V a))) :=
        fun a => (G₂.obj.map (Opposite.op (ι_hat a))).hom t₁
