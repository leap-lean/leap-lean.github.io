    have hPb_qpb :
        CategoryTheory.IsPullback
          q_pb
          (CategoryTheory.Limits.pullback.fst ν_X ν_X)
          (CategoryTheory.Limits.pullback.fst ν ν)
          p_Z :=
      CategoryTheory.IsPullback.of_right hPb_outer hq_fst
        (CategoryTheory.IsPullback.of_hasPullback ν ν).flip
    have hδX_comm : ∀ a : ZMod ℓ, δ_X a ≫ q_pb = p_Z ≫ δ a := by
      intro a
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (δ_X a ≫ q_pb) ≫ CategoryTheory.Limits.pullback.fst ν ν
            = δ_X a ≫ (q_pb ≫ CategoryTheory.Limits.pullback.fst ν ν) :=
              CategoryTheory.Category.assoc _ _ _
          _ = δ_X a ≫ (CategoryTheory.Limits.pullback.fst ν_X ν_X ≫ p_Z) := by rw [hq_fst]
          _ = (δ_X a ≫ CategoryTheory.Limits.pullback.fst ν_X ν_X) ≫ p_Z :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = 𝟙 Z_X ≫ p_Z := by dsimp [δ_X]; rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = p_Z := CategoryTheory.Category.id_comp p_Z
          _ = p_Z ≫ 𝟙 Z := (CategoryTheory.Category.comp_id p_Z).symm
          _ = p_Z ≫ (δ a ≫ CategoryTheory.Limits.pullback.fst ν ν) := by
              dsimp [δ]; rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = (p_Z ≫ δ a) ≫ CategoryTheory.Limits.pullback.fst ν ν :=
              (CategoryTheory.Category.assoc _ _ _).symm
      · calc
          (δ_X a ≫ q_pb) ≫ CategoryTheory.Limits.pullback.snd ν ν
            = δ_X a ≫ (q_pb ≫ CategoryTheory.Limits.pullback.snd ν ν) :=
              CategoryTheory.Category.assoc _ _ _
          _ = δ_X a ≫ (CategoryTheory.Limits.pullback.snd ν_X ν_X ≫ p_Z) := by rw [hq_snd]
          _ = (δ_X a ≫ CategoryTheory.Limits.pullback.snd ν_X ν_X) ≫ p_Z :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = ρ_X a ≫ p_Z := by dsimp [δ_X]; rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = p_Z ≫ ρ a := hρ_X_fst a
          _ = p_Z ≫ (δ a ≫ CategoryTheory.Limits.pullback.snd ν ν) := by
              dsimp [δ]; rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = (p_Z ≫ δ a) ≫ CategoryTheory.Limits.pullback.snd ν ν :=
              (CategoryTheory.Category.assoc _ _ _).symm
    have h_range_δX : ∀ a : ZMod ℓ,
        Set.range (δ_X a).base = q_pb.base ⁻¹' Set.range (δ a).base :=
      fun a =>
        (hSecPullback hPb_qpb
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (hδX_comm a)).2
    refine ⟨hEt_νX, hSurj_νX, hρ_X_fst, ⟨hρ_X_zero, hρ_X_add⟩, ?_, ?_⟩
    · intro a b hab
      rw [h_range_δX a, h_range_δX b]
      exact (hδ_disj hab).preimage _
    · simp_rw [h_range_δX]
      rw [← Set.preimage_iUnion, hδ_univ, Set.preimage_univ]
  · intro S Z_S ν_S hEt_νS ρ_S hρ_S_over hρ_S_act hρ_S_part
    have : AlgebraicGeometry.Etale ν_S := hEt_νS
    let δ_S : ZMod ℓ → Quiver.Hom Z_S (CategoryTheory.Limits.pullback ν_S ν_S) :=
      fun a => CategoryTheory.Limits.pullback.lift (CategoryTheory.CategoryStruct.id Z_S) (ρ_S a)
        ((CategoryTheory.Category.id_comp ν_S).trans (hρ_S_over a).symm)
    rcases hρ_S_act with ⟨hρS_zero, hρS_add⟩
    rcases (hρ_S_part :
      (_root_.Pairwise fun a b : ZMod ℓ =>
        Disjoint (Set.range (δ_S a).base) (Set.range (δ_S b).base)) ∧
      (⋃ a : ZMod ℓ, Set.range (δ_S a).base) = Set.univ) with ⟨hδS_disj, hδS_univ⟩
    have hIso_ρS : ∀ a : ZMod ℓ, CategoryTheory.IsIso (ρ_S a) := by
      intro a
      refine ⟨⟨ρ_S (-a), ?_, ?_⟩⟩
      · rw [← hρS_add a (-a), add_neg_cancel, hρS_zero]
      · rw [← hρS_add (-a) a, neg_add_cancel, hρS_zero]
    let α_S : ZMod ℓ →
        (CategoryTheory.Limits.pullback ν_S ν_S ⟶ CategoryTheory.Limits.pullback ν_S ν_S) :=
      fun b => CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst ν_S ν_S)
        (CategoryTheory.Limits.pullback.snd ν_S ν_S ≫ ρ_S b)
        (CategoryTheory.Limits.pullback.condition.trans
          ((congrArg (CategoryTheory.Limits.pullback.snd ν_S ν_S ≫ ·) (hρ_S_over b)).symm.trans
            (CategoryTheory.Category.assoc _ (ρ_S b) ν_S).symm))
    have hαS_zero : α_S 0 = 𝟙 (CategoryTheory.Limits.pullback ν_S ν_S) := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [α_S]
        rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
      · dsimp [α_S]
        rw [CategoryTheory.Limits.pullback.lift_snd, hρS_zero, CategoryTheory.Category.comp_id,
          CategoryTheory.Category.id_comp]
    have hαS_add : ∀ b c : ZMod ℓ, α_S (b + c) = α_S b ≫ α_S c := by
      intro b c
      apply CategoryTheory.Limits.pullback.hom_ext
      · dsimp [α_S]
        rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
      · dsimp [α_S]
        rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
          CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc (α_S b),
          CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc, hρS_add b c]
    have hOpen_δS : ∀ a : ZMod ℓ, AlgebraicGeometry.IsOpenImmersion (δ_S a) := by
      intro a
      have hIso_αa : CategoryTheory.IsIso (α_S a) := by
        refine ⟨⟨α_S (-a), ?_, ?_⟩⟩
        · rw [← hαS_add a (-a), add_neg_cancel, hαS_zero]
        · rw [← hαS_add (-a) a, neg_add_cancel, hαS_zero]
      have hOpen_αa : AlgebraicGeometry.IsOpenImmersion (α_S a) :=
        @AlgebraicGeometry.IsOpenImmersion.of_isIso _ _ (α_S a) hIso_αa
      have hOpen_diag : AlgebraicGeometry.IsOpenImmersion
          (CategoryTheory.Limits.pullback.diagonal ν_S) :=
        AlgebraicGeometry.FormallyUnramified.isOpenImmersion_diagonal ν_S
      have hδS_eq : δ_S a = CategoryTheory.Limits.pullback.diagonal ν_S ≫ α_S a := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · dsimp [δ_S, α_S]
          rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.diagonal_fst]
        · dsimp [δ_S, α_S]
          rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.lift_snd, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.diagonal_snd, CategoryTheory.Category.id_comp]
      rw [hδS_eq]
      exact @AlgebraicGeometry.IsOpenImmersion.comp _ _ _
        (CategoryTheory.Limits.pullback.diagonal ν_S) (α_S a) hOpen_diag hOpen_αa
    refine ⟨hIso_ρS, ?_⟩
    intro U₀ p_U s hs W ι ρ_W
    have hψ_comm :
        (CategoryTheory.Limits.pullback.fst p_U ν_S ≫ s) ≫ ν_S =
          CategoryTheory.Limits.pullback.snd p_U ν_S ≫ ν_S := by
      rw [CategoryTheory.Category.assoc, hs, CategoryTheory.Limits.pullback.condition]
    let ψ : W ⟶ CategoryTheory.Limits.pullback ν_S ν_S :=
      CategoryTheory.Limits.pullback.lift
        (CategoryTheory.Limits.pullback.fst p_U ν_S ≫ s)
        (CategoryTheory.Limits.pullback.snd p_U ν_S)
        hψ_comm
    have hψ_fst : ψ ≫ CategoryTheory.Limits.pullback.fst ν_S ν_S =
        CategoryTheory.Limits.pullback.fst p_U ν_S ≫ s :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hψ_snd : ψ ≫ CategoryTheory.Limits.pullback.snd ν_S ν_S =
        CategoryTheory.Limits.pullback.snd p_U ν_S :=
      CategoryTheory.Limits.pullback.lift_snd _ _ _
    have hPb_ψ_outer :
        CategoryTheory.IsPullback
          (ψ ≫ CategoryTheory.Limits.pullback.snd ν_S ν_S)
          (CategoryTheory.Limits.pullback.fst p_U ν_S)
          ν_S
          (s ≫ ν_S) := by
      rw [hψ_snd, hs]
      exact (CategoryTheory.IsPullback.of_hasPullback p_U ν_S).flip
    have hPb_ψ :
        CategoryTheory.IsPullback
          ψ
          (CategoryTheory.Limits.pullback.fst p_U ν_S)
          (CategoryTheory.Limits.pullback.fst ν_S ν_S)
          s :=
      CategoryTheory.IsPullback.of_right hPb_ψ_outer hψ_fst
        (CategoryTheory.IsPullback.of_hasPullback ν_S ν_S).flip
    have hι_comm : ∀ a : ZMod ℓ, ι a ≫ ψ = s ≫ δ_S a := by
      intro a
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (ι a ≫ ψ) ≫ CategoryTheory.Limits.pullback.fst ν_S ν_S
            = ι a ≫ (ψ ≫ CategoryTheory.Limits.pullback.fst ν_S ν_S) :=
              CategoryTheory.Category.assoc _ _ _
          _ = ι a ≫ (CategoryTheory.Limits.pullback.fst p_U ν_S ≫ s) := by rw [hψ_fst]
          _ = (ι a ≫ CategoryTheory.Limits.pullback.fst p_U ν_S) ≫ s :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = 𝟙 U₀ ≫ s := by dsimp [ι]; rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = s := CategoryTheory.Category.id_comp s
          _ = s ≫ 𝟙 Z_S := (CategoryTheory.Category.comp_id s).symm
          _ = s ≫ (δ_S a ≫ CategoryTheory.Limits.pullback.fst ν_S ν_S) := by
              dsimp [δ_S]; rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = (s ≫ δ_S a) ≫ CategoryTheory.Limits.pullback.fst ν_S ν_S :=
              (CategoryTheory.Category.assoc _ _ _).symm
      · calc
          (ι a ≫ ψ) ≫ CategoryTheory.Limits.pullback.snd ν_S ν_S
            = ι a ≫ (ψ ≫ CategoryTheory.Limits.pullback.snd ν_S ν_S) :=
              CategoryTheory.Category.assoc _ _ _
          _ = ι a ≫ CategoryTheory.Limits.pullback.snd p_U ν_S := by rw [hψ_snd]
          _ = s ≫ ρ_S a := by dsimp [ι]; rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = s ≫ (δ_S a ≫ CategoryTheory.Limits.pullback.snd ν_S ν_S) := by
              dsimp [δ_S]; rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = (s ≫ δ_S a) ≫ CategoryTheory.Limits.pullback.snd ν_S ν_S :=
              (CategoryTheory.Category.assoc _ _ _).symm
    have hSec_ι : ∀ a : ZMod ℓ,
        CategoryTheory.IsPullback s (ι a) (δ_S a) ψ ∧
          Set.range (ι a).base = ψ.base ⁻¹' Set.range (δ_S a).base :=
      fun a =>
        hSecPullback hPb_ψ
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (CategoryTheory.Limits.pullback.lift_fst _ _ _)
          (hι_comm a)
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro a
      exact CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
        (hSec_ι a).1 (hOpen_δS a)
    · intro a b hab
      rw [(hSec_ι a).2, (hSec_ι b).2]
      exact (hδS_disj hab).preimage _
    · simp_rw [(hSec_ι _).2]
      rw [← Set.preimage_iUnion, hδS_univ, Set.preimage_univ]
    · intro a b
      apply CategoryTheory.Limits.pullback.hom_ext
      · calc
          (ι a ≫ ρ_W b) ≫ CategoryTheory.Limits.pullback.fst p_U ν_S
            = ι a ≫ (ρ_W b ≫ CategoryTheory.Limits.pullback.fst p_U ν_S) :=
              CategoryTheory.Category.assoc _ _ _
          _ = ι a ≫ CategoryTheory.Limits.pullback.fst p_U ν_S := by
              dsimp [ρ_W]; rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = 𝟙 U₀ := by dsimp [ι]; rw [CategoryTheory.Limits.pullback.lift_fst]
          _ = ι (a + b) ≫ CategoryTheory.Limits.pullback.fst p_U ν_S := by
              dsimp [ι]; rw [CategoryTheory.Limits.pullback.lift_fst]
      · calc
          (ι a ≫ ρ_W b) ≫ CategoryTheory.Limits.pullback.snd p_U ν_S
            = ι a ≫ (ρ_W b ≫ CategoryTheory.Limits.pullback.snd p_U ν_S) :=
              CategoryTheory.Category.assoc _ _ _
          _ = ι a ≫ (CategoryTheory.Limits.pullback.snd p_U ν_S ≫ ρ_S b) := by
              dsimp [ρ_W]; rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = (ι a ≫ CategoryTheory.Limits.pullback.snd p_U ν_S) ≫ ρ_S b :=
              (CategoryTheory.Category.assoc _ _ _).symm
          _ = (s ≫ ρ_S a) ≫ ρ_S b := by
              dsimp [ι]; rw [CategoryTheory.Limits.pullback.lift_snd]
          _ = s ≫ (ρ_S a ≫ ρ_S b) := CategoryTheory.Category.assoc _ _ _
          _ = s ≫ ρ_S (a + b) := by rw [← hρS_add a b]
          _ = ι (a + b) ≫ CategoryTheory.Limits.pullback.snd p_U ν_S := by
              dsimp [ι]; rw [CategoryTheory.Limits.pullback.lift_snd]

theorem weil_etale_locConst_sheaf_iso_and_pullback_compat (m : ℕ)
    (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback f).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (f : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback f)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology (@hc_all Z₁ Z₂ f)).IsRightAdjoint) :
    ∃ (hSh : ∀ S : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Presheaf.IsSheaf S.smallEtaleTopology (weilAltLocConstPresheaf S m))
      (e_loc : ∀ S : AlgebraicGeometry.Scheme.{u},
        CategoryTheory.Iso (weilEtaleTorsionSheaf S m) ⟨weilAltLocConstPresheaf S m, hSh S⟩),
      let AM := AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod m))
