      S₀.smallEtaleTopology S_k.smallEtaleTopology
    let pb_ι := B_ι.sheafPullback AddCommGrpCat.{u}
      X₀.smallEtaleTopology X_b.left.smallEtaleTopology
    let adj_ι := B_ι.sheafAdjunctionContinuous AddCommGrpCat.{u}
      X₀.smallEtaleTopology X_b.left.smallEtaleTopology
    letI : CategoryTheory.Limits.PreservesFiniteLimits pb_ι := (hPbExact ι_b).1
    letI : pb_ι.Additive := (hPbExact ι_b).2
    letI : CategoryTheory.Functor.IsLeftAdjoint pb_ι := adj_ι.isLeftAdjoint
    letI : CategoryTheory.Limits.PreservesFiniteColimits pb_ι := inferInstance
    let Fℤ_Xb := (CategoryTheory.constantSheaf X_b.left.smallEtaleTopology
      AddCommGrpCat.{u}).obj Z_ulift
    let T_Xb := weilEtaleIdTerminal.{u} X_b.left
    let adj_cXb := CategoryTheory.constantSheafAdj X_b.left.smallEtaleTopology AddCommGrpCat.{u}
      (weilEtaleIdTerminalIsTerminal.{u} X_b.left)
    obtain ⟨e_TY_inv, c_Xb, e_fib, he_TY_inv, hc_Xb_1, he_fib_nat, he_fib_unit⟩ :=
      hFibAll X_b q
    obtain ⟨bc_q, κ_pull, hbc_nat, hbc_eval, hκ_gen⟩ :=
      weil_etale_comm_square_higherDirectImage_baseChange_nat
        (@hc_all) (@hr_all) (@hPbExact) f₀ s_b X_b.hom ι_b hcomm q
    let β : ∀ (F : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
        ↥((pb_s.obj (weilEtaleHigherDirectImage f₀ q F)).obj.obj (Opposite.op T_k)) →+
          (pb_ι.obj F).H q :=
      fun F => (e_fib (pb_ι.obj F)).toAddMonoidHom.comp ((bc_q F).hom.app (Opposite.op T_k)).hom
    refine ⟨β, ?_, ?_⟩
    · intro F₁ F₂ φ x
      have hbc_x :
          ((bc_q F₂).hom.app (Opposite.op T_k)).hom
            (((pb_s.map (weilEtaleHigherDirectImageMap f₀ q φ)).hom.app
              (Opposite.op T_k)).hom x) =
          (((weilEtaleHigherDirectImageMap X_b.hom q (pb_ι.map φ)).hom.app
            (Opposite.op T_k)).hom (((bc_q F₁).hom.app (Opposite.op T_k)).hom x)) :=
        ConcreteCategory.congr_hom
          (CategoryTheory.NatTrans.congr_app (congrArg (fun k => k.hom) (hbc_nat φ))
            (Opposite.op T_k)) x
      exact (congrArg (e_fib (pb_ι.obj F₂)) hbc_x).trans
        (he_fib_nat (pb_ι.map φ) (((bc_q F₁).hom.app (Opposite.op T_k)).hom x))
    · intro F W τ_W u_X hu_X hu_W σ_u hσ_u γ_u hγ_u x₀
      let V₀ : X₀.Etale := B_f.obj W
      have hm_tot_eq :=
        weil_etale_comm_square_pointed_pullback_hom_eq
          f₀ s_b X_b ι_b hcomm W τ_W u_X hu_X hu_W e_TY_inv he_TY_inv σ_u hσ_u
      have hγ_eq : CategoryTheory.CategoryStruct.comp c_Xb (κ_pull W T_k τ_W) = γ_u := by
        apply (adj_cXb.homEquiv Z_ulift (pb_ι.obj ((Z_fun X₀).obj V₀))).injective
        refine AddCommGrpCat.ext fun ⟨n⟩ => ?_
        have hn : (⟨n⟩ : ULift.{u} ℤ) = n • ULift.up (1 : ℤ) :=
          ULift.ext _ _ (zsmul_one n).symm
        let g₁ := (adj_cXb.unit.app Z_ulift ≫
          (CategoryTheory.CategoryStruct.comp c_Xb (κ_pull W T_k τ_W)).hom.app
            (Opposite.op T_Xb)).hom
        let g₂ := (adj_cXb.unit.app Z_ulift ≫ γ_u.hom.app (Opposite.op T_Xb)).hom
        have h1 : g₁ (ULift.up (1 : ℤ)) = g₂ (ULift.up (1 : ℤ)) :=
          (congrArg ((κ_pull W T_k τ_W).hom.app (Opposite.op T_Xb)).hom hc_Xb_1).trans
            ((hκ_gen W T_k τ_W T_Xb e_TY_inv).trans
              ((congrArg (fun m =>
                ((pb_ι.obj ((Z_fun X₀).obj V₀)).obj.map (Opposite.op m)).hom
                  (((adj_ι.unit.app ((Z_fun X₀).obj V₀)).hom.app (Opposite.op V₀)).hom
                    (ι_gen X₀ V₀))) hm_tot_eq).trans hγ_u.symm))
        change g₁ ⟨n⟩ = g₂ ⟨n⟩
        exact (congrArg g₁ hn).trans
          ((map_zsmul g₁ n (ULift.up (1 : ℤ))).trans
            ((congrArg (n • ·) h1).trans
              ((map_zsmul g₂ n (ULift.up (1 : ℤ))).symm.trans (congrArg g₂ hn).symm)))
      refine (congrArg (e_fib (pb_ι.obj F)) (hbc_eval F W T_k τ_W x₀)).trans ?_
      refine (he_fib_unit (pb_ι.obj F) _).trans ?_
      refine (CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc c_Xb (κ_pull W T_k τ_W)
        ((pb_ι.mapExtAddHom ((Z_fun X₀).obj V₀) F q) x₀)).trans ?_
      exact congrArg (fun m =>
        (CategoryTheory.Abelian.Ext.mk₀ m).comp
          ((pb_ι.mapExtAddHom ((Z_fun X₀).obj V₀) F q) x₀) (Nat.zero_add q)) hγ_eq

theorem weil_etale_connecting_epi_and_slice_res_iso (hc_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (weilEtaleSitePullback h).IsContinuous Z₂.smallEtaleTopology Z₁.smallEtaleTopology)
    (hr_all : ∀ {Z₁ Z₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Z₁ Z₂),
      (@CategoryTheory.Functor.sheafPushforwardContinuous _ _ _ _ (weilEtaleSitePullback h)
        AddCommGrpCat.{u} _ Z₂.smallEtaleTopology Z₁.smallEtaleTopology
        (@hc_all Z₁ Z₂ h)).IsRightAdjoint) :
    (∀ {X₀ S₀ : AlgebraicGeometry.Scheme.{u}} (f₀ : Quiver.Hom X₀ S₀)
        {F J_ab Q : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}}
        (u_F : Quiver.Hom F J_ab) (v_F : Quiver.Hom J_ab Q)
        (huv : CategoryTheory.CategoryStruct.comp u_F v_F = 0),
      (hSE : (CategoryTheory.ShortComplex.mk u_F v_F huv).ShortExact) →
      CategoryTheory.Limits.IsZero (weilEtaleHigherDirectImage f₀ 1 J_ab) →
      letI := @hc_all X₀ S₀ f₀
      let pf_f := (weilEtaleSitePullback f₀).sheafPushforwardContinuous AddCommGrpCat.{u}
        S₀.smallEtaleTopology X₀.smallEtaleTopology
      let B_f := weilEtaleSitePullback f₀
      let shAdj_of := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
        CategoryTheory.sheafificationAdjunction Z.smallEtaleTopology AddCommGrpCat.{u}
      let Z_fun := fun (Z : AlgebraicGeometry.Scheme.{u}) =>
        CategoryTheory.yoneda ⋙
          ((CategoryTheory.Functor.whiskeringRight (Opposite Z.Etale) (Type u) AddCommGrpCat.{u}).obj
            AddCommGrpCat.free ⋙
            CategoryTheory.presheafToSheaf Z.smallEtaleTopology AddCommGrpCat.{u})
      let ι_gen := fun (Z : AlgebraicGeometry.Scheme.{u}) (V : Z.Etale) =>
        ((((shAdj_of Z).unit.app ((CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free)).app
          (Opposite.op V)).hom ((AddCommGrpCat.adj.unit.app (Quiver.Hom V V))
            (CategoryTheory.CategoryStruct.id V)))
      ∃ (δ₀ : Quiver.Hom (pf_f.obj Q) (weilEtaleHigherDirectImage f₀ 1 F)),
        CategoryTheory.Epi δ₀ ∧
        CategoryTheory.CategoryStruct.comp (pf_f.map v_F) δ₀ = 0 ∧
        (∀ (W : S₀.Etale) (q₀ : ↥(Q.obj.obj (Opposite.op (B_f.obj W)))),
          let V₀ := B_f.obj W
          ∃ (α₀ : Quiver.Hom ((Z_fun X₀).obj V₀) Q),
            (α₀.hom.app (Opposite.op V₀)).hom (ι_gen X₀ V₀) = q₀ ∧
            (δ₀.hom.app (Opposite.op W)).hom q₀ =
              (((shAdj_of S₀).unit.app (B_f.op ⋙ F.cohomologyPresheaf 1)).app
                (Opposite.op W)).hom
                ((CategoryTheory.Abelian.Ext.mk₀ α₀).comp hSE.extClass
                  (Nat.zero_add 1)))) ∧
    (∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}}
        (v : Quiver.Hom Y₁ Y₂) (hv : AlgebraicGeometry.Etale v),
      let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
        @AlgebraicGeometry.Etale
      letI : P_et.IsStableUnderComposition :=
        CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition
      letI := @hc_all Y₁ Y₂ v
      letI := @hr_all Y₁ Y₂ v
      let j_v : CategoryTheory.Functor Y₁.Etale Y₂.Etale :=
        CategoryTheory.MorphismProperty.Over.map (P := P_et) ⊤ hv
      let pb_v := (weilEtaleSitePullback v).sheafPullback AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      let adj_v := (weilEtaleSitePullback v).sheafAdjunctionContinuous AddCommGrpCat.{u}
        Y₂.smallEtaleTopology Y₁.smallEtaleTopology
      ∃ (hc_j : j_v.IsContinuous Y₁.smallEtaleTopology Y₂.smallEtaleTopology),
        letI := hc_j
        let res_v := j_v.sheafPushforwardContinuous AddCommGrpCat.{u}
          Y₁.smallEtaleTopology Y₂.smallEtaleTopology
        ∃ (e_res : CategoryTheory.Iso pb_v res_v),
          ∀ (G : CategoryTheory.Sheaf Y₂.smallEtaleTopology AddCommGrpCat.{u})
            (V : Y₂.Etale),
            CategoryTheory.CategoryStruct.comp
              ((adj_v.unit.app G).hom.app (Opposite.op V))
              ((e_res.hom.app G).hom.app (Opposite.op ((weilEtaleSitePullback v).obj V))) =
              G.obj.map
                (Opposite.op
                  ((CategoryTheory.MorphismProperty.Over.mapPullbackAdj P_et ⊤ v hv
                    trivial).counit.app V))) :=
by
  refine ⟨?_, ?_⟩
  · 
    intro X₀ S₀ f₀ F J_ab Q u_F v_F huv hSE hAcyc
    have : (weilEtaleSitePullback f₀).IsContinuous S₀.smallEtaleTopology X₀.smallEtaleTopology :=
      @hc_all X₀ S₀ f₀
    let B_f := weilEtaleSitePullback f₀
    let pf_f := B_f.sheafPushforwardContinuous AddCommGrpCat.{u}
      S₀.smallEtaleTopology X₀.smallEtaleTopology
    let shAdj_X := CategoryTheory.sheafificationAdjunction X₀.smallEtaleTopology AddCommGrpCat.{u}
    let shAdj_S := CategoryTheory.sheafificationAdjunction S₀.smallEtaleTopology AddCommGrpCat.{u}
    let Sh_X := CategoryTheory.presheafToSheaf X₀.smallEtaleTopology AddCommGrpCat.{u}
    let Sh_S := CategoryTheory.presheafToSheaf S₀.smallEtaleTopology AddCommGrpCat.{u}
    let Z_X := CategoryTheory.yoneda ⋙
      ((CategoryTheory.Functor.whiskeringRight (Opposite X₀.Etale) (Type u) AddCommGrpCat.{u}).obj
        AddCommGrpCat.free ⋙ Sh_X)
    let P_free := fun (V : X₀.Etale) =>
      (CategoryTheory.yoneda.obj V).comp AddCommGrpCat.free
    let ι_X := fun (V : X₀.Etale) =>
      (((shAdj_X.unit.app (P_free V)).app (Opposite.op V)).hom
        ((AddCommGrpCat.adj.unit.app (Quiver.Hom V V)) (CategoryTheory.CategoryStruct.id V)))
    let freeAdj_X := CategoryTheory.Adjunction.whiskerRight (Opposite X₀.Etale) AddCommGrpCat.adj

    
    let homEquiv_Z : ∀ (V : X₀.Etale)
        (G : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
        (Z_X.obj V ⟶ G) ≃ ↥(G.obj.obj (Opposite.op V)) :=
      fun V G =>
        (shAdj_X.homEquiv (P_free V) G).trans
          ((freeAdj_X.homEquiv (CategoryTheory.yoneda.obj V) G.obj).trans
            CategoryTheory.yonedaEquiv)
    have h_homEquiv_Z : ∀ (V : X₀.Etale)
        (G : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u})
        (α : Z_X.obj V ⟶ G),
        homEquiv_Z V G α = (α.hom.app (Opposite.op V)).hom (ι_X V) := by
      intro V G α
      dsimp only [homEquiv_Z, Equiv.trans_apply]
      rw [CategoryTheory.yonedaEquiv_apply,
        CategoryTheory.Adjunction.homEquiv_unit,
        CategoryTheory.Adjunction.homEquiv_unit]
      rfl

    
    have hGen_map : ∀ {V' V : X₀.Etale} (m : V' ⟶ V),
        (((Z_X.map m).hom.app (Opposite.op V')).hom (ι_X V')) =
          (((Z_X.obj V).obj.map (Opposite.op m)).hom (ι_X V)) := by
      intro V' V m
      let y_m : P_free V' ⟶ P_free V :=
        CategoryTheory.Functor.whiskerRight (CategoryTheory.yoneda.map m) AddCommGrpCat.free
      have h1 := CategoryTheory.ConcreteCategory.congr_hom
        (CategoryTheory.NatTrans.congr_app (shAdj_X.unit.naturality y_m).symm (Opposite.op V'))
        ((AddCommGrpCat.adj.unit.app (Quiver.Hom V' V')) (CategoryTheory.CategoryStruct.id V'))
      let f₁ : (V' ⟶ V') ⟶ (V' ⟶ V) := (CategoryTheory.yoneda.map m).app (Opposite.op V')
      let f₂ : (V ⟶ V) ⟶ (V' ⟶ V) := (CategoryTheory.yoneda.obj V).map (Opposite.op m)
      have h_u1 := CategoryTheory.ConcreteCategory.congr_hom
        (AddCommGrpCat.adj.unit.naturality f₁).symm (CategoryTheory.CategoryStruct.id V')
      have h_u2 := CategoryTheory.ConcreteCategory.congr_hom
        (AddCommGrpCat.adj.unit.naturality f₂).symm (CategoryTheory.CategoryStruct.id V)
      have hf_eq : (CategoryTheory.ConcreteCategory.hom f₁) (CategoryTheory.CategoryStruct.id V') =
          (CategoryTheory.ConcreteCategory.hom f₂) (CategoryTheory.CategoryStruct.id V) :=
        (CategoryTheory.Category.id_comp m).trans (CategoryTheory.Category.comp_id m).symm
      have h2 : (y_m.app (Opposite.op V')).hom
          ((AddCommGrpCat.adj.unit.app (Quiver.Hom V' V')) (CategoryTheory.CategoryStruct.id V')) =
          ((P_free V).map (Opposite.op m)).hom
            ((AddCommGrpCat.adj.unit.app (Quiver.Hom V V)) (CategoryTheory.CategoryStruct.id V)) :=
        h_u1.trans ((congrArg (CategoryTheory.ConcreteCategory.hom
          (AddCommGrpCat.adj.unit.app (V' ⟶ V))) hf_eq).trans h_u2.symm)
      have h3 := CategoryTheory.ConcreteCategory.congr_hom
        ((shAdj_X.unit.app (P_free V)).naturality (Opposite.op m))
        ((AddCommGrpCat.adj.unit.app (Quiver.Hom V V)) (CategoryTheory.CategoryStruct.id V))
      exact h1.trans
        ((congrArg ((shAdj_X.unit.app (P_free V)).app (Opposite.op V')).hom h2).trans h3)

    
    let evAddEquiv : ∀ (V : X₀.Etale)
        (G : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
        (Z_X.obj V ⟶ G) ≃+ ↥(G.obj.obj (Opposite.op V)) :=
      fun V G =>
        AddEquiv.ofBijective
          (AddMonoidHom.mk'
            (fun α : Z_X.obj V ⟶ G => (α.hom.app (Opposite.op V)).hom (ι_X V))
            (fun _ _ => rfl))
          (let h_eq : (fun α : Z_X.obj V ⟶ G => (α.hom.app (Opposite.op V)).hom (ι_X V)) =
              homEquiv_Z V G := funext (fun α => (h_homEquiv_Z V G α).symm)
           Eq.mpr (congrArg Function.Bijective h_eq) (homEquiv_Z V G).bijective)
    let θ₀ : ∀ (G : CategoryTheory.Sheaf X₀.smallEtaleTopology AddCommGrpCat.{u}),
        CategoryTheory.Iso (G.cohomologyPresheaf 0) G.obj :=
      fun G =>
        CategoryTheory.NatIso.ofComponents
          (fun opV =>
            (CategoryTheory.Abelian.Ext.addEquiv₀.trans (evAddEquiv opV.unop G)).toAddCommGrpIso)
          (fun {opV₁ opV₂} op_m => by
            let V₁ : X₀.Etale := opV₁.unop
            let V₂ : X₀.Etale := opV₂.unop
            let m : V₂ ⟶ V₁ := op_m.unop
            refine AddCommGrpCat.ext fun (x : CategoryTheory.Abelian.Ext (Z_X.obj V₁) G 0) => ?_
            let α : Z_X.obj V₁ ⟶ G := CategoryTheory.Abelian.Ext.addEquiv₀ x
            have hx : CategoryTheory.Abelian.Ext.mk₀ α = x :=
              CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
            have h_map : ((G.cohomologyPresheaf 0).map op_m).hom x =
                CategoryTheory.Abelian.Ext.mk₀ (Z_X.map m ≫ α) := by
              have h_app := CategoryTheory.ConcreteCategory.congr_hom
                (CategoryTheory.Abelian.extFunctor_map_app 0 (Z_X.map m).op G) x
              refine h_app.trans ?_
              change (CategoryTheory.Abelian.Ext.mk₀ (Z_X.map m)).comp x (Nat.zero_add 0) = _
              rw [← hx]
              exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ (Z_X.map m) α
            have h_add_mk₀ : CategoryTheory.Abelian.Ext.addEquiv₀
                (CategoryTheory.Abelian.Ext.mk₀ (Z_X.map m ≫ α)) = Z_X.map m ≫ α := by
              rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
              exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply _
            change (((evAddEquiv V₂ G) (CategoryTheory.Abelian.Ext.addEquiv₀
                (((G.cohomologyPresheaf 0).map op_m).hom x))) : ↥(G.obj.obj opV₂)) =
              (G.obj.map op_m).hom ((α.hom.app (Opposite.op V₁)).hom (ι_X V₁))
            rw [h_map, h_add_mk₀]
            change (α.hom.app (Opposite.op V₂)).hom
                (((Z_X.map m).hom.app (Opposite.op V₂)).hom (ι_X V₂)) =
              (G.obj.map (Opposite.op m)).hom ((α.hom.app (Opposite.op V₁)).hom (ι_X V₁))
            rw [hGen_map m]
            exact CategoryTheory.ConcreteCategory.congr_hom
              (α.hom.naturality (Opposite.op m)) (ι_X V₁))
    let e₀ : CategoryTheory.Iso Q.obj (Q.cohomologyPresheaf 0) := (θ₀ Q).symm

    
    let v₀_pre := (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₀.smallEtaleTopology 0).map v_F
    have h_v₀_θ : v₀_pre ≫ (θ₀ Q).hom = (θ₀ J_ab).hom ≫ v_F.hom := by
      refine CategoryTheory.NatTrans.ext (funext fun opV => AddCommGrpCat.ext fun x => ?_)
      let V : X₀.Etale := opV.unop
      let α : Z_X.obj V ⟶ J_ab := CategoryTheory.Abelian.Ext.addEquiv₀ x
      have hx : CategoryTheory.Abelian.Ext.mk₀ α = x :=
        CategoryTheory.Abelian.Ext.mk₀_addEquiv₀_apply x
      have h_map : (v₀_pre.app opV).hom x = CategoryTheory.Abelian.Ext.mk₀ (α ≫ v_F) := by
        have h_app := CategoryTheory.ConcreteCategory.congr_hom
          (CategoryTheory.Abelian.extFunctorObj_map (Z_X.obj V) 0 v_F) x
        refine h_app.trans ?_
        change x.comp (CategoryTheory.Abelian.Ext.mk₀ v_F) (Nat.add_zero 0) = _
        rw [← hx]
        exact CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ α v_F
      have h_add_mk₀ : CategoryTheory.Abelian.Ext.addEquiv₀
          (CategoryTheory.Abelian.Ext.mk₀ (α ≫ v_F)) = α ≫ v_F := by
        rw [← CategoryTheory.Abelian.Ext.addEquiv₀_symm_apply]
        exact CategoryTheory.Abelian.Ext.addEquiv₀.apply_symm_apply _
      change (evAddEquiv V Q) (CategoryTheory.Abelian.Ext.addEquiv₀ ((v₀_pre.app opV).hom x)) =
        (v_F.hom.app opV).hom ((α.hom.app (Opposite.op V)).hom (ι_X V))
      rw [h_map, h_add_mk₀]
      rfl
    have hv_e₀ : v_F.hom ≫ e₀.hom = (θ₀ J_ab).inv ≫ v₀_pre := by
      change v_F.hom ≫ (θ₀ Q).inv = (θ₀ J_ab).inv ≫ v₀_pre
      calc
        v_F.hom ≫ (θ₀ Q).inv
          = ((θ₀ J_ab).inv ≫ (θ₀ J_ab).hom) ≫ v_F.hom ≫ (θ₀ Q).inv := by
              rw [(θ₀ J_ab).inv_hom_id, CategoryTheory.Category.id_comp]
        _ = (θ₀ J_ab).inv ≫ ((θ₀ J_ab).hom ≫ v_F.hom) ≫ (θ₀ Q).inv := by
              simp only [CategoryTheory.Category.assoc]
        _ = (θ₀ J_ab).inv ≫ (v₀_pre ≫ (θ₀ Q).hom) ≫ (θ₀ Q).inv := by rw [← h_v₀_θ]
        _ = (θ₀ J_ab).inv ≫ v₀_pre := by
              rw [CategoryTheory.Category.assoc, (θ₀ Q).hom_inv_id,
                CategoryTheory.Category.comp_id]

    let δ_pre : Q.cohomologyPresheaf 0 ⟶ F.cohomologyPresheaf 1 :=
      { app := fun opV =>
          AddCommGrpCat.ofHom (hSE.extClass.postcomp (Z_X.obj opV.unop) (Nat.zero_add 1))
        naturality := fun {opV₁ opV₂} op_m => by
          let m : opV₂.unop ⟶ opV₁.unop := op_m.unop
          refine AddCommGrpCat.ext fun (x : CategoryTheory.Abelian.Ext (Z_X.obj opV₁.unop) Q 0) => ?_
          have hL := CategoryTheory.ConcreteCategory.congr_hom
            (CategoryTheory.Abelian.extFunctor_map_app 0 (Z_X.map m).op Q) x
          have hR := CategoryTheory.ConcreteCategory.congr_hom
            (CategoryTheory.Abelian.extFunctor_map_app 1 (Z_X.map m).op F)
            (x.comp hSE.extClass (Nat.zero_add 1))
          exact (congrArg
              (fun y : CategoryTheory.Abelian.Ext (Z_X.obj opV₂.unop) Q 0 =>
                y.comp hSE.extClass (Nat.zero_add 1)) hL).trans
            ((CategoryTheory.Abelian.Ext.comp_assoc
                (CategoryTheory.Abelian.Ext.mk₀ (Z_X.map m)) x hSE.extClass
                (Nat.zero_add 0) (Nat.zero_add 1) (Nat.zero_add 1)).trans
              hR.symm) }

    have hv₀_δ_zero : v₀_pre ≫ δ_pre = 0 := by
      refine CategoryTheory.NatTrans.ext (funext fun opV =>
        AddCommGrpCat.ext fun (x : CategoryTheory.Abelian.Ext (Z_X.obj opV.unop) J_ab 0) => ?_)
      have h_app := CategoryTheory.ConcreteCategory.congr_hom
        (CategoryTheory.Abelian.extFunctorObj_map (Z_X.obj opV.unop) 0 v_F) x
      exact (congrArg
