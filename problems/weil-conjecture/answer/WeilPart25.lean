  have hCard_const_U₁ :
      ∀ (u : ↥U₁) (s_u : S_k ⟶ U₁),
        s_u ≫ (h_U₁ ≫ 𝟙 V₁.toScheme ≫ p_V₁) = 𝟙 S_k →
        Set.range s_u.base = {u} →
        Nat.card (weilCupPDModH (CategoryTheory.Limits.pullback f_U₁ s_u) ℓ 1) = ℓ ^ b₁ := by
    intro u_test s_test hs_test_sec_raw hs_test_range
    have hs_test_sec : s_test ≫ p_U₁ = 𝟙 S_k := by
      simpa only [p_U₁, CategoryTheory.Category.id_comp] using hs_test_sec_raw
    obtain ⟨x_tmp, hx_tmp_range, hx_tmp_cl⟩ := hSecPkg.2.1 U₁ p_U₁ s_test hs_test_sec
    have hu_test_eq : u_test = x_tmp :=
      Set.singleton_eq_singleton_iff.mp (hs_test_range.symm.trans hx_tmp_range)
    have hu_test_cl : IsClosed ({u_test} : Set ↥U₁) := hu_test_eq.symm ▸ hx_tmp_cl

    let C_test : CategoryTheory.Over S_k :=
      CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_U₁ s_test)
    let ι_test_U₁ := CategoryTheory.Limits.pullback.fst f_U₁ s_test
    have hPb_Ctest_U₁ : CategoryTheory.IsPullback ι_test_U₁ C_test.hom f_U₁ s_test :=
      CategoryTheory.IsPullback.of_hasPullback f_U₁ s_test
    have hb₁_le_card : ℓ ^ b₁ ≤ Nat.card (weilCupPDModH C_test.left ℓ 1) :=
      (hCard_U₁ s_test C_test ι_test_U₁ hs_test_sec_raw hPb_Ctest_U₁).1

    obtain ⟨U_test, hAff_Utest, hInt_Utest, g_test, u_tilde, b₂, Y_test, p_Ytest, f_test,
        t_test, G₂, hEt_gtest, hu_tilde_cl, hu_tilde_map, hPb_Ytest, hG₂_det, hG₂_cup,
        hCard_test, _⟩ :=
      hBasisLift U₁ h_U₁ u_test hu_test_cl
    have : AlgebraicGeometry.IsAffine U_test := hAff_Utest
    have : AlgebraicGeometry.IsIntegral U_test := hInt_Utest
    have : AlgebraicGeometry.Etale g_test := hEt_gtest
    let p_Utest : U_test ⟶ S_k := g_test ≫ p_U₁
    have : AlgebraicGeometry.LocallyOfFiniteType p_Utest := inferInstance

    obtain ⟨s_tilde, hs_tilde_sec, hs_tilde_range⟩ :=
      hSecPkg.1 U_test p_Utest u_tilde hu_tilde_cl
    have hs_tilde_gtest : s_tilde ≫ g_test = s_test := by
      apply hSecPkg.2.2.1 U₁ p_U₁ (s_tilde ≫ g_test) s_test
      · rw [CategoryTheory.Category.assoc]; exact hs_tilde_sec
      · exact hs_test_sec
      · rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
          hs_tilde_range, Set.image_singleton, hu_tilde_map, hs_test_range]
    have hcomm_Ctest_Ytest :
        (ι_test_U₁ ≫ p_YU₁_Y₁) ≫ f₁ = (C_test.hom ≫ s_tilde) ≫ (g_test ≫ h_U₁) := by
      calc
        (ι_test_U₁ ≫ p_YU₁_Y₁) ≫ f₁
          = ι_test_U₁ ≫ (p_YU₁_Y₁ ≫ f₁) := CategoryTheory.Category.assoc _ _ _
        _ = ι_test_U₁ ≫ (f_U₁ ≫ h_U₁) := by rw [hPb_YU₁.w]
        _ = (ι_test_U₁ ≫ f_U₁) ≫ h_U₁ := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (C_test.hom ≫ s_test) ≫ h_U₁ := by rw [hPb_Ctest_U₁.w]
        _ = C_test.hom ≫ ((s_tilde ≫ g_test) ≫ h_U₁) := by
              rw [← hs_tilde_gtest, CategoryTheory.Category.assoc]
        _ = (C_test.hom ≫ s_tilde) ≫ (g_test ≫ h_U₁) := by
              simp only [CategoryTheory.Category.assoc]
    let ι_test_Ytest : C_test.left ⟶ Y_test :=
      hPb_Ytest.lift (ι_test_U₁ ≫ p_YU₁_Y₁) (C_test.hom ≫ s_tilde) hcomm_Ctest_Ytest
    have hPb_Ctest_Ytest : CategoryTheory.IsPullback ι_test_Ytest C_test.hom f_test s_tilde := by
      refine CategoryTheory.IsPullback.of_right ?_ (hPb_Ytest.lift_snd _ _ _) hPb_Ytest
      rw [hPb_Ytest.lift_fst, ← CategoryTheory.Category.assoc s_tilde, hs_tilde_gtest]
      exact hPb_Ctest_U₁.paste_horiz hPb_YU₁
    have hcard_eq_b₂ : Nat.card (weilCupPDModH C_test.left ℓ 1) = ℓ ^ b₂ :=
      ((hCard_test s_tilde C_test ι_test_Ytest
        (by simpa only [p_Utest, p_U₁, CategoryTheory.Category.assoc] using hs_tilde_sec)
        hPb_Ctest_Ytest).2 hs_tilde_range).1

    have hb₁_le_b₂ : b₁ ≤ b₂ :=
      (Nat.pow_le_pow_iff_right hPrime.one_lt).mp (hcard_eq_b₂ ▸ hb₁_le_card)
    rcases lt_or_eq_of_le hb₁_le_b₂ with hb_lt | rfl
    · exfalso
      obtain ⟨s_u₁, hs_u₁_sec, hs_u₁_range⟩ := hSecPkg.1 U₁ p_U₁ u₁ hu₁_cl
      have hs_u₁_sec_raw : s_u₁ ≫ (h_U₁ ≫ 𝟙 V₁.toScheme ≫ p_V₁) = 𝟙 S_k := by
        simpa only [p_U₁, CategoryTheory.Category.id_comp] using hs_u₁_sec
      let C_u₁ : CategoryTheory.Over S_k :=
        CategoryTheory.Over.mk (CategoryTheory.Limits.pullback.snd f_U₁ s_u₁)
      let ι_u₁_U₁ := CategoryTheory.Limits.pullback.fst f_U₁ s_u₁
      have hPb_Cu₁_U₁ : CategoryTheory.IsPullback ι_u₁_U₁ C_u₁.hom f_U₁ s_u₁ :=
        CategoryTheory.IsPullback.of_hasPullback f_U₁ s_u₁
      obtain ⟨hcard_u₁, hSpan_u₁⟩ :=
        (hCard_U₁ s_u₁ C_u₁ ι_u₁_U₁ hs_u₁_sec_raw hPb_Cu₁_U₁).2 hs_u₁_range

      let O_good : Set ↥U₁ := Set.range g_test.base
      have hO_open : IsOpen O_good := by
        have : AlgebraicGeometry.Flat g_test := inferInstance
        have : AlgebraicGeometry.LocallyOfFinitePresentation g_test := inferInstance
        have : AlgebraicGeometry.UniversallyOpen g_test :=
          AlgebraicGeometry.UniversallyOpen.of_flat g_test
        exact g_test.isOpenMap.isOpen_range
      have hO_ne : O_good.Nonempty := ⟨u_test, u_tilde, hu_tilde_map⟩

      by_cases hu₁_in : u₁ ∈ O_good
      · obtain ⟨W_aff, w₀, hAff_W, hw₀_cl, hw₀_map⟩ :=
          hSecPkg.2.2.2 U_test U₁ p_U₁ g_test u₁ hu₁_cl hu₁_in
        have : AlgebraicGeometry.IsAffine W_aff.toScheme := hAff_W
        let p_Waff : W_aff.toScheme ⟶ S_k := W_aff.ι ≫ p_Utest
        have : AlgebraicGeometry.LocallyOfFiniteType p_Waff := inferInstance
        obtain ⟨s_w₀, hs_w₀_sec, hs_w₀_range⟩ := hSecPkg.1 W_aff.toScheme p_Waff w₀ hw₀_cl
        let s'_u₁ : S_k ⟶ U_test := s_w₀ ≫ W_aff.ι
        have hs'_u₁_sec : s'_u₁ ≫ p_Utest = 𝟙 S_k := by
          dsimp [s'_u₁, p_Waff] at hs_w₀_sec ⊢
          rwa [CategoryTheory.Category.assoc]
        have hs'_u₁_gtest : s'_u₁ ≫ g_test = s_u₁ := by
          apply hSecPkg.2.2.1 U₁ p_U₁ (s'_u₁ ≫ g_test) s_u₁
          · rw [CategoryTheory.Category.assoc]; exact hs'_u₁_sec
          · exact hs_u₁_sec
          · change Set.range ((s_w₀ ≫ (W_aff.ι ≫ g_test)).base) = Set.range s_u₁.base
            rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
              hs_w₀_range, Set.image_singleton]
            change {g_test.base (W_aff.ι.base w₀)} = Set.range s_u₁.base
            rw [hw₀_map, hs_u₁_range]
        have hcomm_Cu₁_Ytest :
            (ι_u₁_U₁ ≫ p_YU₁_Y₁) ≫ f₁ = (C_u₁.hom ≫ s'_u₁) ≫ (g_test ≫ h_U₁) := by
          calc
            (ι_u₁_U₁ ≫ p_YU₁_Y₁) ≫ f₁
              = ι_u₁_U₁ ≫ (p_YU₁_Y₁ ≫ f₁) := CategoryTheory.Category.assoc _ _ _
            _ = ι_u₁_U₁ ≫ (f_U₁ ≫ h_U₁) := by rw [hPb_YU₁.w]
            _ = (ι_u₁_U₁ ≫ f_U₁) ≫ h_U₁ := (CategoryTheory.Category.assoc _ _ _).symm
            _ = (C_u₁.hom ≫ s_u₁) ≫ h_U₁ := by rw [hPb_Cu₁_U₁.w]
            _ = C_u₁.hom ≫ ((s'_u₁ ≫ g_test) ≫ h_U₁) := by
                  rw [← hs'_u₁_gtest, CategoryTheory.Category.assoc]
            _ = (C_u₁.hom ≫ s'_u₁) ≫ (g_test ≫ h_U₁) := by
                  simp only [CategoryTheory.Category.assoc]
        let ι_u₁_Ytest : C_u₁.left ⟶ Y_test :=
          hPb_Ytest.lift (ι_u₁_U₁ ≫ p_YU₁_Y₁) (C_u₁.hom ≫ s'_u₁) hcomm_Cu₁_Ytest
        have hPb_Cu₁_Ytest : CategoryTheory.IsPullback ι_u₁_Ytest C_u₁.hom f_test s'_u₁ := by
          refine CategoryTheory.IsPullback.of_right ?_ (hPb_Ytest.lift_snd _ _ _) hPb_Ytest
          rw [hPb_Ytest.lift_fst, ← CategoryTheory.Category.assoc s'_u₁, hs'_u₁_gtest]
          exact hPb_Cu₁_U₁.paste_horiz hPb_YU₁
        have hb₂_le_card : ℓ ^ b₂ ≤ Nat.card (weilCupPDModH C_u₁.left ℓ 1) :=
          (hCard_test s'_u₁ C_u₁ ι_u₁_Ytest
            (by simpa only [p_Utest, p_U₁, CategoryTheory.Category.assoc] using hs'_u₁_sec)
            hPb_Cu₁_Ytest).1
        have hb₂_le_b₁ : b₂ ≤ b₁ :=
          (Nat.pow_le_pow_iff_right hPrime.one_lt).mp (hcard_u₁ ▸ hb₂_le_card)
        omega

      · 
        obtain ⟨C_aff, hAff_C, hInt_C, ι_C, u_C, c₀, hEt_uC, hu_C_comm, hc₀_cl, hc₀_map,
            hHit_ne⟩ :=
          weil_algClosed_etale_affineSpace_pointed_curve_join k hDomPkg.1 δ U₁ u_U₁ u₁ hu₁_cl
            O_good hO_open hO_ne hu₁_in
        have : AlgebraicGeometry.IsAffine C_aff := hAff_C
        have : AlgebraicGeometry.IsIntegral C_aff := hInt_C
        have : AlgebraicGeometry.Etale u_C := hEt_uC
        let p_C : C_aff ⟶ S_k := u_C ≫ (weilAffineSpaceOver k 1).hom
        have hp_C_eq : ι_C ≫ p_U₁ = p_C := by
          calc
            ι_C ≫ p_U₁ = ι_C ≫ (u_U₁ ≫ (weilAffineSpaceOver k δ).hom) := by rw [hu_U₁]
            _ = p_C := hu_C_comm.symm
        have : AlgebraicGeometry.LocallyOfFiniteType p_C := inferInstance

        obtain ⟨s_c₀, hs_c₀_sec, hs_c₀_range⟩ := hSecPkg.1 C_aff p_C c₀ hc₀_cl
        have hs_c₀_ιC : s_c₀ ≫ ι_C = s_u₁ := by
          apply hSecPkg.2.2.1 U₁ p_U₁ (s_c₀ ≫ ι_C) s_u₁
          · rw [CategoryTheory.Category.assoc, hp_C_eq]; exact hs_c₀_sec
          · exact hs_u₁_sec
          · rw [AlgebraicGeometry.Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
              hs_c₀_range, Set.image_singleton, hc₀_map, hs_u₁_range]

        obtain ⟨Y_C, p_YC_U₁, f_C, hProp_fC, hSm_fC, hPb_YC_U₁⟩ :
            ∃ (Y_C : AlgebraicGeometry.Scheme.{u})
              (p_YC_U₁ : Y_C ⟶ Y_U₁) (f_C : Y_C ⟶ C_aff),
              AlgebraicGeometry.IsProper f_C ∧
              AlgebraicGeometry.SmoothOfRelativeDimension 1 f_C ∧
              CategoryTheory.IsPullback p_YC_U₁ f_C f_U₁ ι_C :=
          ⟨_, _, _, inferInstance,
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
              (CategoryTheory.IsPullback.of_hasPullback f_U₁ ι_C) ‹_›,
            CategoryTheory.IsPullback.of_hasPullback f_U₁ ι_C⟩
        have : AlgebraicGeometry.IsProper f_C := hProp_fC
        have : AlgebraicGeometry.SmoothOfRelativeDimension 1 f_C := hSm_fC
        have hPb_YC_Y₁ : CategoryTheory.IsPullback (p_YC_U₁ ≫ p_YU₁_Y₁) f_C f₁ (ι_C ≫ h_U₁) :=
          hPb_YC_U₁.paste_horiz hPb_YU₁
        have hPb_YC_PY : CategoryTheory.IsPullback (p_YC_U₁ ≫ p_YU₁_PY) f_C P.f_bar (ι_C ≫ m_U₁) :=
          hPb_YC_U₁.paste_horiz hPb_YU₁_PY

        let τ_C' : C_aff ⟶ Y_C :=
          hPb_YC_PY.lift ((ι_C ≫ m_U₁) ≫ P.τ_bdry τ₀_idx) (𝟙 C_aff)
            (by
              rw [CategoryTheory.Category.assoc, P.hτ_sec τ₀_idx,
                CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
        have hτ_C'_sec : τ_C' ≫ f_C = 𝟙 C_aff := hPb_YC_PY.lift_snd _ _ _
        have hτ_C'_cl : AlgebraicGeometry.IsClosedImmersion τ_C' :=
          (hSecPullback hPb_YC_PY (P.hτ_sec τ₀_idx) (P.hτ_cl τ₀_idx)
            (hPb_YC_PY.lift_fst _ _ _) hτ_C'_sec).2.1

        let ι_Cu₁_YC : C_u₁.left ⟶ Y_C :=
          hPb_YC_U₁.lift ι_u₁_U₁ (C_u₁.hom ≫ s_c₀)
            (by rw [CategoryTheory.Category.assoc, hs_c₀_ιC]; exact hPb_Cu₁_U₁.w)
        have hPb_Cu₁_YC : CategoryTheory.IsPullback ι_Cu₁_YC C_u₁.hom f_C s_c₀ := by
          refine CategoryTheory.IsPullback.of_right ?_
            (hPb_YC_U₁.lift_snd _ _ _) hPb_YC_U₁
          rw [hPb_YC_U₁.lift_fst, hs_c₀_ιC]
          exact hPb_Cu₁_U₁

        
        have hFinProj_C :
            ∃ (N : ℕ)
              (ι_proj : Y_C ⟶ CategoryTheory.Limits.pullback p_C
                (weilProjectiveSpaceOver k N).hom),
              AlgebraicGeometry.IsFinite ι_proj ∧
              ι_proj ≫ CategoryTheory.Limits.pullback.fst p_C
                (weilProjectiveSpaceOver k N).hom = f_C := by
          have hm_C_k : (ι_C ≫ m_U₁) ≫ p_PV = p_C := by
            have hm_U₁_k : m_U₁ ≫ p_PV = p_U₁ := by
              dsimp [m_U₁, m_V₀, p_U₁, p_V₁, p_V₀]
              simp only [CategoryTheory.Category.assoc, hg_base_k]
            rw [CategoryTheory.Category.assoc, hm_U₁_k, hp_C_eq]
          let q_C_PV : CategoryTheory.Limits.pullback p_C (weilProjectiveSpaceOver k N_proj).hom ⟶
              CategoryTheory.Limits.pullback p_PV (weilProjectiveSpaceOver k N_proj).hom :=
            CategoryTheory.Limits.pullback.lift
              (CategoryTheory.Limits.pullback.fst p_C (weilProjectiveSpaceOver k N_proj).hom ≫
                (ι_C ≫ m_U₁))
              (CategoryTheory.Limits.pullback.snd p_C (weilProjectiveSpaceOver k N_proj).hom)
              (by
                rw [CategoryTheory.Category.assoc, hm_C_k]
                exact CategoryTheory.Limits.pullback.condition)
          have hqCPV_fst :
              q_C_PV ≫ CategoryTheory.Limits.pullback.fst p_PV
                (weilProjectiveSpaceOver k N_proj).hom =
              CategoryTheory.Limits.pullback.fst p_C (weilProjectiveSpaceOver k N_proj).hom ≫
                (ι_C ≫ m_U₁) :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hqCPV_snd :
              q_C_PV ≫ CategoryTheory.Limits.pullback.snd p_PV
                (weilProjectiveSpaceOver k N_proj).hom =
              CategoryTheory.Limits.pullback.snd p_C (weilProjectiveSpaceOver k N_proj).hom :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hPb_qCPV : CategoryTheory.IsPullback
              q_C_PV (CategoryTheory.Limits.pullback.fst p_C (weilProjectiveSpaceOver k N_proj).hom)
              (CategoryTheory.Limits.pullback.fst p_PV (weilProjectiveSpaceOver k N_proj).hom)
              (ι_C ≫ m_U₁) := by
            refine CategoryTheory.IsPullback.of_right ?_ hqCPV_fst
              (CategoryTheory.IsPullback.of_hasPullback p_PV
                (weilProjectiveSpaceOver k N_proj).hom).flip
            rw [hqCPV_snd, hm_C_k]
            exact (CategoryTheory.IsPullback.of_hasPullback p_C
              (weilProjectiveSpaceOver k N_proj).hom).flip
          let ι_proj_C : Y_C ⟶
              CategoryTheory.Limits.pullback p_C (weilProjectiveSpaceOver k N_proj).hom :=
            CategoryTheory.Limits.pullback.lift f_C
              ((p_YC_U₁ ≫ p_YU₁_PY) ≫ ι_PV_proj ≫
                CategoryTheory.Limits.pullback.snd p_PV (weilProjectiveSpaceOver k N_proj).hom)
              (by
                calc
                  f_C ≫ p_C = f_C ≫ ((ι_C ≫ m_U₁) ≫ p_PV) := by rw [hm_C_k]
                  _ = (f_C ≫ (ι_C ≫ m_U₁)) ≫ p_PV := (CategoryTheory.Category.assoc _ _ _).symm
                  _ = ((p_YC_U₁ ≫ p_YU₁_PY) ≫ P.f_bar) ≫ p_PV := by rw [← hPb_YC_PY.w]
                  _ = (p_YC_U₁ ≫ p_YU₁_PY) ≫ (ι_PV_proj ≫
                        CategoryTheory.Limits.pullback.fst p_PV
                          (weilProjectiveSpaceOver k N_proj).hom) ≫ p_PV := by
                        rw [hιPV_fst, CategoryTheory.Category.assoc]
                  _ = (p_YC_U₁ ≫ p_YU₁_PY) ≫ ι_PV_proj ≫
                        (CategoryTheory.Limits.pullback.fst p_PV
                          (weilProjectiveSpaceOver k N_proj).hom ≫ p_PV) := by
                        simp only [CategoryTheory.Category.assoc]
                  _ = ((p_YC_U₁ ≫ p_YU₁_PY) ≫ ι_PV_proj ≫
                        CategoryTheory.Limits.pullback.snd p_PV
                          (weilProjectiveSpaceOver k N_proj).hom) ≫
                        (weilProjectiveSpaceOver k N_proj).hom := by
                        rw [CategoryTheory.Limits.pullback.condition]
                        simp only [CategoryTheory.Category.assoc])
          have hιprojC_fst :
              ι_proj_C ≫ CategoryTheory.Limits.pullback.fst p_C
                (weilProjectiveSpaceOver k N_proj).hom = f_C :=
            CategoryTheory.Limits.pullback.lift_fst _ _ _
          have hιprojC_snd :
              ι_proj_C ≫ CategoryTheory.Limits.pullback.snd p_C
                (weilProjectiveSpaceOver k N_proj).hom =
              (p_YC_U₁ ≫ p_YU₁_PY) ≫ ι_PV_proj ≫
                CategoryTheory.Limits.pullback.snd p_PV (weilProjectiveSpaceOver k N_proj).hom :=
            CategoryTheory.Limits.pullback.lift_snd _ _ _
          have hPb_ιprojC : CategoryTheory.IsPullback
              (p_YC_U₁ ≫ p_YU₁_PY) ι_proj_C ι_PV_proj q_C_PV := by
            have hPb_outer : CategoryTheory.IsPullback
                (p_YC_U₁ ≫ p_YU₁_PY)
                (ι_proj_C ≫ CategoryTheory.Limits.pullback.fst p_C
                  (weilProjectiveSpaceOver k N_proj).hom)
                (ι_PV_proj ≫ CategoryTheory.Limits.pullback.fst p_PV
                  (weilProjectiveSpaceOver k N_proj).hom)
                (ι_C ≫ m_U₁) := by
              rw [hιprojC_fst, hιPV_fst]
              exact hPb_YC_PY
            refine CategoryTheory.IsPullback.of_bot hPb_outer ?_ hPb_qCPV
            apply CategoryTheory.Limits.pullback.hom_ext
            · calc
                ((p_YC_U₁ ≫ p_YU₁_PY) ≫ ι_PV_proj) ≫
                    CategoryTheory.Limits.pullback.fst p_PV
                      (weilProjectiveSpaceOver k N_proj).hom
                  = (p_YC_U₁ ≫ p_YU₁_PY) ≫
                      (ι_PV_proj ≫ CategoryTheory.Limits.pullback.fst p_PV
                        (weilProjectiveSpaceOver k N_proj).hom) :=
                      CategoryTheory.Category.assoc _ _ _
                _ = (p_YC_U₁ ≫ p_YU₁_PY) ≫ P.f_bar := by rw [hιPV_fst]
                _ = f_C ≫ (ι_C ≫ m_U₁) := hPb_YC_PY.w
                _ = (ι_proj_C ≫ CategoryTheory.Limits.pullback.fst p_C
                      (weilProjectiveSpaceOver k N_proj).hom) ≫ (ι_C ≫ m_U₁) := by
                      rw [hιprojC_fst]
                _ = ι_proj_C ≫ (q_C_PV ≫ CategoryTheory.Limits.pullback.fst p_PV
                      (weilProjectiveSpaceOver k N_proj).hom) := by
                      rw [CategoryTheory.Category.assoc, hqCPV_fst]
                _ = (ι_proj_C ≫ q_C_PV) ≫ CategoryTheory.Limits.pullback.fst p_PV
                      (weilProjectiveSpaceOver k N_proj).hom :=
                      (CategoryTheory.Category.assoc _ _ _).symm
            · calc
                ((p_YC_U₁ ≫ p_YU₁_PY) ≫ ι_PV_proj) ≫
                    CategoryTheory.Limits.pullback.snd p_PV
                      (weilProjectiveSpaceOver k N_proj).hom
                  = (p_YC_U₁ ≫ p_YU₁_PY) ≫ ι_PV_proj ≫
                      CategoryTheory.Limits.pullback.snd p_PV
                        (weilProjectiveSpaceOver k N_proj).hom :=
                      CategoryTheory.Category.assoc _ _ _
                _ = ι_proj_C ≫ CategoryTheory.Limits.pullback.snd p_C
                      (weilProjectiveSpaceOver k N_proj).hom := hιprojC_snd.symm
                _ = ι_proj_C ≫ (q_C_PV ≫ CategoryTheory.Limits.pullback.snd p_PV
                      (weilProjectiveSpaceOver k N_proj).hom) := by rw [hqCPV_snd]
                _ = (ι_proj_C ≫ q_C_PV) ≫ CategoryTheory.Limits.pullback.snd p_PV
                      (weilProjectiveSpaceOver k N_proj).hom :=
                      (CategoryTheory.Category.assoc _ _ _).symm
          exact ⟨N_proj, ι_proj_C,
            CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
              hPb_ιprojC hFin_ιPV_proj,
            hιprojC_fst⟩

        
        obtain ⟨p_YC_2, hp_YC_2⟩ := hPullPkg.1 (p_YC_U₁ ≫ p_YU₁_Y₁) ℓ 2
        let α_C : weilEtaleTorsionH Y_C ℓ 2 := p_YC_2 α₀
        obtain ⟨⟨θ_YU₁_1, hθ_YU₁_1, _⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_U₁ ℓ 1
        obtain ⟨⟨θ_YC_1, hθ_YC_1, hbij_YC_1⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_C ℓ 1
        let eθ_YC_1 := AddEquiv.ofBijective θ_YC_1 hbij_YC_1
        obtain ⟨p_YC_U₁_1, hp_YC_U₁_1⟩ := hPullPkg.1 p_YC_U₁ ℓ 1
        let s_C : Fin b₁ → weilCupPDModH Y_C ℓ 1 :=
          fun i => eθ_YC_1.symm (p_YC_U₁_1 (θ_YU₁_1 (s_U₁ i)))
        have hs_C_eq : ∀ i : Fin b₁, θ_YC_1 (s_C i) = p_YC_U₁_1 (θ_YU₁_1 (s_U₁ i)) :=
          fun i => eθ_YC_1.apply_symm_apply _

        
        have hDomChart :
            ∃ (R_dom : Type u) (instCR : CommRing R_dom),
              letI : CommRing R_dom := instCR
              IsDomain R_dom ∧
              ∃ (g_dom : AlgebraicGeometry.Spec (CommRingCat.of R_dom) ⟶ C_aff)
                (g_dom_test : AlgebraicGeometry.Spec (CommRingCat.of R_dom) ⟶ U_test),
                AlgebraicGeometry.Etale g_dom ∧
                ConnectedSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of R_dom)) ∧
                g_dom_test ≫ g_test = g_dom ≫ ι_C := by
          obtain ⟨x_hit, y_hit, hy_hit⟩ := hHit_ne
          obtain ⟨z_hit, _, _⟩ :=
            AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback
              (f := g_test) (g := ι_C) y_hit x_hit hy_hit
          let P_curve := CategoryTheory.Limits.pullback g_test ι_C
          let p_Pcurve_test := CategoryTheory.Limits.pullback.fst g_test ι_C
          let p_Pcurve_C := CategoryTheory.Limits.pullback.snd g_test ι_C
          let e_Pc := P_curve.isoSpec
          let R_Pc := P_curve.presheaf.obj (Opposite.op ⊤)
          let q_zhit : PrimeSpectrum ↑R_Pc := e_Pc.hom.base z_hit
          obtain ⟨m_Pc, hm_Pc_max, _⟩ :=
            Ideal.exists_le_maximal q_zhit.asIdeal q_zhit.isPrime.ne_top
          let q_max : PrimeSpectrum ↑R_Pc := ⟨m_Pc, hm_Pc_max.isPrime⟩
          let p₀_Pc : ↥P_curve := e_Pc.inv.base q_max
          have hp₀_Pc_cl : IsClosed ({p₀_Pc} : Set ↥P_curve) := by
            have hq_cl : IsClosed ({q_max} : Set (PrimeSpectrum ↑R_Pc)) :=
              (PrimeSpectrum.isClosed_singleton_iff_isMaximal q_max).mpr hm_Pc_max
            have hpre : ({p₀_Pc} : Set ↥P_curve) =
                e_Pc.hom.base ⁻¹' ({q_max} : Set ↥(AlgebraicGeometry.Spec R_Pc)) := by
              ext z
              simp only [p₀_Pc, Set.mem_singleton_iff, Set.mem_preimage]
              constructor
              · rintro rfl
                change (e_Pc.inv ≫ e_Pc.hom).base q_max = q_max
                rw [e_Pc.inv_hom_id]; rfl
              · intro hz
                have hz' := congrArg e_Pc.inv.base hz
                change (e_Pc.hom ≫ e_Pc.inv).base z = e_Pc.inv.base q_max at hz'
                rwa [e_Pc.hom_inv_id] at hz'
            rw [hpre]
            exact hq_cl.preimage e_Pc.hom.continuous
          let u_Pc : P_curve ⟶ (weilAffineSpaceOver k 1).left := p_Pcurve_C ≫ u_C
          have : AlgebraicGeometry.Etale u_Pc := inferInstance
          obtain ⟨U_Pc, hAff_UPc, _, hInt_UPc⟩ :=
            hDomPkg.1 1 P_curve u_Pc p₀_Pc hp₀_Pc_cl
          let C_dom := U_Pc.toScheme
          have : AlgebraicGeometry.IsAffine C_dom := hAff_UPc
          have : AlgebraicGeometry.IsIntegral C_dom := hInt_UPc
          let R_dom₀ : Type u := ↑(C_dom.presheaf.obj (Opposite.op ⊤))
          have hDom₀ : IsDomain R_dom₀ :=
            (inferInstance : IsDomain ↑(C_dom.presheaf.obj (Opposite.op ⊤)))
          let e_dom : C_dom ≅ AlgebraicGeometry.Spec (CommRingCat.of R_dom₀) := C_dom.isoSpec
          let g_dom₀ : AlgebraicGeometry.Spec (CommRingCat.of R_dom₀) ⟶ C_aff :=
            e_dom.inv ≫ U_Pc.ι ≫ p_Pcurve_C
          have hEt_gdom₀ : AlgebraicGeometry.Etale g_dom₀ := inferInstance
          have : ConnectedSpace ↥C_dom := IrreducibleSpace.connectedSpace ↥C_dom
          have hConn_Sdom₀ : ConnectedSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of R_dom₀)) :=
            hConnOfIso e_dom ‹_›
          let g_dom_test₀ : AlgebraicGeometry.Spec (CommRingCat.of R_dom₀) ⟶ U_test :=
            e_dom.inv ≫ U_Pc.ι ≫ p_Pcurve_test
          have hg_dom_comm₀ : g_dom_test₀ ≫ g_test = g_dom₀ ≫ ι_C := by
            dsimp [g_dom_test₀, g_dom₀, p_Pcurve_test, p_Pcurve_C]
            simp only [CategoryTheory.Category.assoc]
            rw [CategoryTheory.Limits.pullback.condition]
          exact ⟨R_dom₀, inferInstance, hDom₀, g_dom₀, g_dom_test₀,
            hEt_gdom₀, hConn_Sdom₀, hg_dom_comm₀⟩
        obtain ⟨R_dom, instCR_Rdom, hDom_Rdom, g_dom, g_dom_test,
            hEt_gdom, hConn_Sdom, hg_dom_comm⟩ := hDomChart
        letI : CommRing R_dom := instCR_Rdom
        have : IsDomain R_dom := hDom_Rdom
        have : AlgebraicGeometry.Etale g_dom := hEt_gdom
        let S_dom := AlgebraicGeometry.Spec (CommRingCat.of R_dom)
        have : ConnectedSpace ↥S_dom := hConn_Sdom

        
        obtain ⟨Y_dom, p_dom, f_dom, hPb_dom⟩ :
            ∃ (Y_dom : AlgebraicGeometry.Scheme.{u})
              (p_dom : Y_dom ⟶ Y_C) (f_dom : Y_dom ⟶ S_dom),
              CategoryTheory.IsPullback p_dom f_dom f_C g_dom :=
          ⟨_, _, _, CategoryTheory.IsPullback.of_hasPullback f_C g_dom⟩
        have hPb_dom_Y₁ : CategoryTheory.IsPullback
            (p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) f_dom f₁ (g_dom ≫ ι_C ≫ h_U₁) :=
          hPb_dom.paste_horiz hPb_YC_Y₁
        have hcomm_dom_Ytest :
            (p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) ≫ f₁ =
              (f_dom ≫ g_dom_test) ≫ (g_test ≫ h_U₁) := by
          calc
            (p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) ≫ f₁
              = f_dom ≫ (g_dom ≫ ι_C) ≫ h_U₁ := by
                  rw [hPb_dom_Y₁.w]
                  simp only [CategoryTheory.Category.assoc]
            _ = (f_dom ≫ g_dom_test) ≫ (g_test ≫ h_U₁) := by
                  rw [← hg_dom_comm]
                  simp only [CategoryTheory.Category.assoc]
        let p_dom_Ytest : Y_dom ⟶ Y_test :=
          hPb_Ytest.lift (p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) (f_dom ≫ g_dom_test) hcomm_dom_Ytest
        have hPb_dom_Ytest : CategoryTheory.IsPullback p_dom_Ytest f_dom f_test g_dom_test := by
          refine CategoryTheory.IsPullback.of_right ?_ (hPb_Ytest.lift_snd _ _ _) hPb_Ytest
          rw [hPb_Ytest.lift_fst, ← CategoryTheory.Category.assoc g_dom_test, hg_dom_comm]
          exact hPb_dom_Y₁

        let Ω_dom := AlgebraicClosure (FractionRing R_dom)
        let s_η : AlgebraicGeometry.Spec (CommRingCat.of Ω_dom) ⟶ S_dom :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            ((algebraMap (FractionRing R_dom) Ω_dom).comp
              (algebraMap R_dom (FractionRing R_dom))))
        obtain ⟨Y_η, ι_η, f_η, hPb_η⟩ :
            ∃ (Y_η : AlgebraicGeometry.Scheme.{u})
              (ι_η : Y_η ⟶ Y_dom)
              (f_η : Y_η ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω_dom)),
              CategoryTheory.IsPullback ι_η f_η f_dom s_η :=
          ⟨_, _, _, CategoryTheory.IsPullback.of_hasPullback f_dom s_η⟩
        have hPb_η_Y₁ : CategoryTheory.IsPullback
            (ι_η ≫ p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) f_η f₁ (s_η ≫ g_dom ≫ ι_C ≫ h_U₁) :=
          hPb_η.paste_horiz hPb_dom_Y₁
        have hPb_η_Ytest : CategoryTheory.IsPullback
            (ι_η ≫ p_dom_Ytest) f_η f_test (s_η ≫ g_dom_test) :=
          hPb_η.paste_horiz hPb_dom_Ytest

        obtain ⟨⟨θ_test_1, hθ_test_1, _⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_test ℓ 1
        obtain ⟨⟨θ_test_2, hθ_test_2, _⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_test ℓ 2
        obtain ⟨⟨θ_dom_1, hθ_dom_1, hbij_dom_1⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_dom ℓ 1
        obtain ⟨⟨θ_dom_2, hθ_dom_2, _⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_dom ℓ 2
        obtain ⟨⟨θ_η_1, hθ_η_1, hbij_η_1⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_η ℓ 1
        obtain ⟨⟨θ_η_2, hθ_η_2, hbij_η_2⟩, _⟩ :=
          weil_cupPD_mod_comparison_bijective_unique Y_η ℓ 2
        let eθ_dom_1 := AddEquiv.ofBijective θ_dom_1 hbij_dom_1
        let eθ_η_1 := AddEquiv.ofBijective θ_η_1 hbij_η_1
        have heθ_dom_1 : ∀ u : weilEtaleTorsionH Y_dom ℓ 1, θ_dom_1 (eθ_dom_1.symm u) = u :=
          fun u => eθ_dom_1.apply_symm_apply u
        have heθ_η_1 : ∀ u : weilEtaleTorsionH Y_η ℓ 1, θ_η_1 (eθ_η_1.symm u) = u :=
          fun u => eθ_η_1.apply_symm_apply u

        obtain ⟨p_dom_C_1, hp_dom_C_1⟩ := hPullPkg.1 p_dom ℓ 1
        obtain ⟨p_dom_test_1, hp_dom_test_1⟩ := hPullPkg.1 p_dom_Ytest ℓ 1
        obtain ⟨p_η_dom_1, hp_η_dom_1⟩ := hPullPkg.1 ι_η ℓ 1
        obtain ⟨p_η_dom_2, hp_η_dom_2⟩ := hPullPkg.1 ι_η ℓ 2
        obtain ⟨p_η_C_1, hp_η_C_1⟩ := hPullPkg.1 (ι_η ≫ p_dom) ℓ 1
        obtain ⟨p_η_test_1, hp_η_test_1⟩ := hPullPkg.1 (ι_η ≫ p_dom_Ytest) ℓ 1
        obtain ⟨p_η_test_2, hp_η_test_2⟩ := hPullPkg.1 (ι_η ≫ p_dom_Ytest) ℓ 2
        obtain ⟨p_η_Y₁_2, hp_η_Y₁_2⟩ :=
          hPullPkg.1 (ι_η ≫ p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) ℓ 2

        let s_dom : Fin b₁ → weilCupPDModH Y_dom ℓ 1 :=
          fun i => eθ_dom_1.symm (p_dom_C_1 (θ_YC_1 (s_C i)))
        let t_dom : Fin b₂ → weilCupPDModH Y_dom ℓ 1 :=
          fun a => eθ_dom_1.symm (p_dom_test_1 (θ_test_1 (t_test a)))
        let s_η_cls : Fin b₁ → weilCupPDModH Y_η ℓ 1 :=
          fun i => eθ_η_1.symm (p_η_C_1 (θ_YC_1 (s_C i)))
        let t_η_cls : Fin b₂ → weilCupPDModH Y_η ℓ 1 :=
          fun a => eθ_η_1.symm (p_η_test_1 (θ_test_1 (t_test a)))

        have hs_dom_η : ∀ i : Fin b₁, p_η_dom_1 (θ_dom_1 (s_dom i)) = θ_η_1 (s_η_cls i) := by
          intro i
          dsimp [s_dom, s_η_cls]
          rw [heθ_dom_1, heθ_η_1]
          have hcomp := hPullPkg.2.2.1 ι_η p_dom ℓ 1 p_η_dom_1 p_dom_C_1 p_η_C_1
            hp_η_dom_1 hp_dom_C_1 hp_η_C_1
          exact (DFunLike.congr_fun hcomp (θ_YC_1 (s_C i))).symm
        have ht_dom_η : ∀ a : Fin b₂, p_η_dom_1 (θ_dom_1 (t_dom a)) = θ_η_1 (t_η_cls a) := by
          intro a
          dsimp [t_dom, t_η_cls]
          rw [heθ_dom_1, heθ_η_1]
          have hcomp := hPullPkg.2.2.1 ι_η p_dom_Ytest ℓ 1 p_η_dom_1 p_dom_test_1 p_η_test_1
            hp_η_dom_1 hp_dom_test_1 hp_η_test_1
          exact (DFunLike.congr_fun hcomp (θ_test_1 (t_test a))).symm

        let α_η : weilEtaleTorsionH Y_η ℓ 2 := p_η_Y₁_2 α₀
        have hα_η_nz : α_η ≠ 0 :=
          hα₀_nz Ω_dom (s_η ≫ g_dom ≫ ι_C ≫ h_U₁) Y_η
            (ι_η ≫ p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) f_η hPb_η_Y₁ p_η_Y₁_2 hp_η_Y₁_2
        have hα_η_tor : ℓ • α_η = 0 := by
          dsimp [α_η]
          rw [← map_nsmul, hα₀_tor, map_zero]
        have hnsmul_mod : ∀ n : ℕ, n • α_η = (n : ZMod ℓ).val • α_η := by
          intro n
          have hdiv : n = ℓ * (n / ℓ) + n % ℓ := (Nat.div_add_mod n ℓ).symm
          calc
            n • α_η = (ℓ * (n / ℓ) + n % ℓ) • α_η := by rw [← hdiv]
            _ = (n / ℓ) • (ℓ • α_η) + (n % ℓ) • α_η := by rw [add_nsmul, mul_nsmul]
            _ = (n % ℓ) • α_η := by rw [hα_η_tor, smul_zero, zero_add]
            _ = (n : ZMod ℓ).val • α_η := by rw [ZMod.val_natCast]
        have hSumNsmul :
            ∀ (n : ℕ) (s_fin : Finset (Fin n)) (c_fn : Fin n → ℕ),
              (Finset.sum s_fin (fun a => c_fn a)) • α_η =
                Finset.sum s_fin (fun a => c_fn a • α_η) := by
          intro n s_fin c_fn
          induction s_fin using Finset.induction_on with
          | empty => simp
          | insert _ _ ha ih => simp [Finset.sum_insert ha, add_nsmul, ih]

        
        let c_pair : Fin b₂ → Fin b₁ → ZMod ℓ :=
          fun a i => Classical.choose
            (hCupConst_V₁ S_dom (g_dom ≫ ι_C ≫ h_U₁) Y_dom
              (p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) f_dom hPb_dom_Y₁ (t_dom a) (s_dom i))
        let C_mat : Matrix (Fin b₂) (Fin b₁) (ZMod ℓ) := Matrix.of c_pair
        let g₂_pair : Fin b₂ → Fin b₂ → ZMod ℓ := fun a b => G₂ a b
        have hC_mat_η :
            ∀ (a : Fin b₂) (i : Fin b₁),
              θ_η_2 (CategoryTheory.Abelian.Ext.comp (t_η_cls a) (s_η_cls i) (rfl : 1 + 1 = 2)) =
                (c_pair a i).val • α_η := by
          intro a i
          have hspec := Classical.choose_spec
            (hCupConst_V₁ S_dom (g_dom ≫ ι_C ≫ h_U₁) Y_dom
              (p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁) f_dom hPb_dom_Y₁ (t_dom a) (s_dom i))
            Ω_dom s_η Y_η ι_η f_η hPb_η θ_dom_2 p_η_dom_2 p_η_Y₁_2
            hθ_dom_2 hp_η_dom_2 hp_η_Y₁_2
          have hcompat := weil_cupPD_pullback_ext_comp_compat hModInj hModUniq
            ι_η ℓ 1 1 2 rfl p_η_dom_1 p_η_dom_1 p_η_dom_2
            θ_dom_1 θ_η_1 θ_dom_1 θ_η_1 θ_dom_2 θ_η_2
            hp_η_dom_1 hp_η_dom_1 hp_η_dom_2
            hθ_dom_1 hθ_η_1 hθ_dom_1 hθ_η_1 hθ_dom_2 hθ_η_2
            (t_dom a) (s_dom i) (t_η_cls a) (s_η_cls i)
            (ht_dom_η a) (hs_dom_η i)
          exact hcompat.symm.trans hspec

        have hG₂_η :
            ∀ (a b : Fin b₂),
              θ_η_2 (CategoryTheory.Abelian.Ext.comp (t_η_cls a) (t_η_cls b) (rfl : 1 + 1 = 2)) =
                (g₂_pair a b).val • α_η := by
          intro a b
          have hp_path :
              (ι_η ≫ p_dom_Ytest) ≫ p_Ytest = ι_η ≫ p_dom ≫ p_YC_U₁ ≫ p_YU₁_Y₁ := by
            rw [CategoryTheory.Category.assoc, hPb_Ytest.lift_fst]
          have hp_Ytest_α : WeilIsTorsionEtalePullback
              ((ι_η ≫ p_dom_Ytest) ≫ p_Ytest) ℓ 2 p_η_Y₁_2 := by
            rwa [hp_path]
          have hspec := hG₂_cup a b Ω_dom (s_η ≫ g_dom_test) Y_η (ι_η ≫ p_dom_Ytest) f_η
            hPb_η_Ytest θ_test_2 p_η_test_2 p_η_Y₁_2 hθ_test_2 hp_η_test_2 hp_Ytest_α
          have ht_test_η : ∀ c : Fin b₂,
              p_η_test_1 (θ_test_1 (t_test c)) = θ_η_1 (t_η_cls c) :=
            fun c => (heθ_η_1 _).symm
          have hcompat := weil_cupPD_pullback_ext_comp_compat hModInj hModUniq
            (ι_η ≫ p_dom_Ytest) ℓ 1 1 2 rfl p_η_test_1 p_η_test_1 p_η_test_2
            θ_test_1 θ_η_1 θ_test_1 θ_η_1 θ_test_2 θ_η_2
            hp_η_test_1 hp_η_test_1 hp_η_test_2
            hθ_test_1 hθ_η_1 hθ_test_1 hθ_η_1 hθ_test_2 hθ_η_2
            (t_test a) (t_test b) (t_η_cls a) (t_η_cls b)
            (ht_test_η a) (ht_test_η b)
          exact hcompat.symm.trans hspec

        let L_mat : (Fin b₂ → ZMod ℓ) →ₗ[ZMod ℓ] (Fin b₁ → ZMod ℓ) :=
          Matrix.mulVecLin C_mat.transpose
        have hfin_lt :
            Module.finrank (ZMod ℓ) (Fin b₁ → ZMod ℓ) <
              Module.finrank (ZMod ℓ) (Fin b₂ → ZMod ℓ) := by
          rw [Module.finrank_fin_fun, Module.finrank_fin_fun]
          exact hb_lt
        have hker_ne : LinearMap.ker L_mat ≠ ⊥ :=
          LinearMap.ker_ne_bot_of_finrank_lt hfin_lt
        obtain ⟨μ, hμ_ker_mem, hμ_ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker_ne
        have hμ_ker : C_mat.transpose.mulVec μ = 0 := LinearMap.mem_ker.mp hμ_ker_mem

        let γ_dom : weilCupPDModH Y_dom ℓ 1 :=
          Finset.univ.sum fun a : Fin b₂ => (μ a).val • t_dom a
        let γ_η : weilCupPDModH Y_η ℓ 1 :=
          Finset.univ.sum fun a : Fin b₂ => (μ a).val • t_η_cls a
        have hγ_pull : p_η_dom_1 (θ_dom_1 γ_dom) = θ_η_1 γ_η := by
          dsimp [γ_dom, γ_η]
          simp only [map_sum, map_nsmul, ht_dom_η]
        have hs_C_η : ∀ i : Fin b₁, p_η_C_1 (θ_YC_1 (s_C i)) = θ_η_1 (s_η_cls i) :=
          fun i => (heθ_η_1 _).symm

        let cupLeft_η : weilCupPDModH Y_η ℓ 1 → weilCupPDModH Y_η ℓ 1 →+ weilCupPDModH Y_η ℓ 2 :=
          fun y => AddMonoidHom.mk'
            (fun x => CategoryTheory.Abelian.Ext.comp x y (rfl : 1 + 1 = 2))
            (fun x₁ x₂ => CategoryTheory.Abelian.Ext.add_comp x₁ x₂ y (rfl : 1 + 1 = 2))

        have hOrth :
            ∀ i : Fin b₁,
              CategoryTheory.Abelian.Ext.comp γ_η (s_η_cls i) (rfl : 1 + 1 = 2) = 0 := by
          intro i
          apply hbij_η_2.1
          rw [map_zero]
          change θ_η_2 (cupLeft_η (s_η_cls i) γ_η) = 0
          dsimp [γ_η]
          rw [map_sum, map_sum]
          have hsum_eq :
              (Finset.univ.sum fun a : Fin b₂ =>
                θ_η_2 (cupLeft_η (s_η_cls i) ((μ a).val • t_η_cls a))) =
              (Finset.univ.sum fun a : Fin b₂ => (μ a).val * (c_pair a i).val) • α_η := by
            refine Eq.trans ?_
              (hSumNsmul b₂ Finset.univ (fun a => (μ a).val * (c_pair a i).val)).symm
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [map_nsmul, map_nsmul]
            change (μ a).val • θ_η_2
              (CategoryTheory.Abelian.Ext.comp (t_η_cls a) (s_η_cls i) (rfl : 1 + 1 = 2)) = _
            rw [hC_mat_η a i, mul_nsmul']
          rw [hsum_eq, hnsmul_mod]
          have hcast_zero :
              ((Finset.univ.sum fun a : Fin b₂ => (μ a).val * (c_pair a i).val : ℕ) : ZMod ℓ) =
                0 := by
            push_cast
            simp only [ZMod.natCast_zmod_val]
            have hmul_eq :
                (Finset.univ.sum fun a : Fin b₂ => μ a * c_pair a i) =
                  (C_mat.transpose.mulVec μ) i := by
