        p_c ≫ μ_c.left =
          (μ_tilde_bar j).left ≫ weilBaseChangeMap K₀ ↥L_c (AlgebraicClosure K₀) Y_K₀ := by
    intro j
    obtain ⟨L_W, hFD_W, Y_W, p_W, hProj_W, hp_W⟩ :=
      weil_spread_out_projective_scheme_over_algClosure K₀ (C_bar j) (hProj_bar j)
    have : FiniteDimensional K₀ ↥L_W := hFD_W
    obtain ⟨L_0, hLE_W0, hFD_0, hMor_0⟩ :=
      weil_spread_out_morphism_of_baseChange_model K₀ Y_K₀ (C_bar j) (μ_tilde_bar j)
        L_W Y_W hProj_W p_W hp_W
    let : Algebra ↥L_W ↥L_0 := (IntermediateField.inclusion hLE_W0).toRingHom.toAlgebra
    obtain ⟨φ_0, p_W0, hpW0, hComm0⟩ := hMor_0
    let Y_0 : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L_0)) :=
      weilBaseChangeOver ↥L_W ↥L_0 Y_W
    have hProj_0 : IsProjectiveOverField ↥L_0 Y_0 :=
      weil_isProjectiveOverField_baseChange ↥L_W ↥L_0 Y_W hProj_W
    have hProp_0 : AlgebraicGeometry.IsProper Y_0.hom :=
      hPropOfProj ↥L_0 Y_0 hProj_0
    have : FiniteDimensional K₀ ↥L_0 := hFD_0
    have : AlgebraicGeometry.SmoothOfRelativeDimension 1 (C_bar j).hom := hSm_bar j
    let bot_bar : (weilBaseChangeOver K₀ (AlgebraicClosure K₀) Y_K₀).left.Opens := ⊥
    let bot_0 : (weilBaseChangeOver K₀ ↥L_0 Y_K₀).left.Opens := ⊥
    have : CategoryTheory.IsIso ((μ_tilde_bar j).left ∣_ bot_bar) :=
      @AlgebraicGeometry.isIso_of_isEmpty _ _ ((μ_tilde_bar j).left ∣_ bot_bar) ⟨fun x => x.2⟩
    have hEt_bot : AlgebraicGeometry.Etale ((μ_tilde_bar j).left ∣_ bot_bar) := inferInstance
    have : CategoryTheory.IsIso (φ_0.left ∣_ bot_0) :=
      @AlgebraicGeometry.isIso_of_isEmpty _ _ (φ_0.left ∣_ bot_0) ⟨fun x => x.2⟩
    have hFin_bot : AlgebraicGeometry.IsFinite (φ_0.left ∣_ bot_0) := inferInstance
    have hMod_0 : IsBaseChangeAlterationModel K₀ Y_K₀ (C_bar j) (μ_tilde_bar j) bot_bar
        L_0 Y_0 φ_0 bot_0 :=
      ⟨p_W0, weilBaseChangeMap K₀ ↥L_0 (AlgebraicClosure K₀) Y_K₀,
        hpW0, hpBaseMap_k L_0, hComm0, rfl⟩
    obtain ⟨L_sm, hLE_0sm, hFD_sm, hSmPack⟩ :=
      weil_enlarge_field_smooth_and_etale_of_model K₀ Y_K₀ 1 (C_bar j) (μ_tilde_bar j)
        bot_bar hEt_bot L_0 Y_0 φ_0 bot_0 hProp_0 hFin_bot hMod_0
    let : Algebra ↥L_0 ↥L_sm := (IntermediateField.inclusion hLE_0sm).toRingHom.toAlgebra
    obtain ⟨_, _, _, hSm_sm, _⟩ := hSmPack
    obtain ⟨μ_sm, p_sm, hProj_sm, hp_sm, hComm_sm⟩ :=
      hLiftCurveMor (μ_tilde_bar j) L_0 L_sm hLE_0sm Y_0 φ_0 p_W0 hProj_0 hpW0 hComm0
    exact ⟨L_sm, hFD_sm, weilBaseChangeOver ↥L_0 ↥L_sm Y_0, μ_sm, p_sm,
      hProj_sm, hSm_sm, hp_sm, hComm_sm⟩
  choose L_c hFD_c C_c μ_c p_c hProj_c hSm_c hp_c hComm_c using hPerCurve
  choose L_u hFD_u U_u hU_u using
    fun j : Fin s => weil_spread_out_open_of_baseChange K₀ Y_K₀ (U_bar j)
  have : ∀ j : Fin s, FiniteDimensional K₀ ↥(L_c j ⊔ L_u j) := fun j => by
    have : FiniteDimensional K₀ ↥(L_c j) := hFD_c j
    have : FiniteDimensional K₀ ↥(L_u j) := hFD_u j
    exact IntermediateField.finiteDimensional_sup (L_c j) (L_u j)
  let L₁ : IntermediateField K₀ (AlgebraicClosure K₀) :=
    ⨆ j : Fin s, (L_c j ⊔ L_u j)
  have hFD_L₁ : FiniteDimensional K₀ ↥L₁ :=
    IntermediateField.finiteDimensional_iSup_of_finite
  have hCurve_L₁ : ∀ j : Fin s,
      ∃ (C_j : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₁)))
        (μ_j : C_j ⟶ weilBaseChangeOver K₀ ↥L₁ Y_K₀)
        (p_j : (C_bar j).left ⟶ C_j.left),
        IsProjectiveOverField ↥L₁ C_j ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 C_j.hom ∧
        CategoryTheory.IsPullback p_j (C_bar j).hom C_j.hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥L₁ (AlgebraicClosure K₀)))) ∧
        p_j ≫ μ_j.left =
          (μ_tilde_bar j).left ≫ weilBaseChangeMap K₀ ↥L₁ (AlgebraicClosure K₀) Y_K₀ :=
    fun j => hTransportCurve (μ_tilde_bar j) (L_c j) L₁
      (le_sup_left.trans (le_iSup (fun i : Fin s => L_c i ⊔ L_u i) j))
      (C_c j) (μ_c j) (p_c j) (hProj_c j) (hSm_c j) (hp_c j) (hComm_c j)
  have hOpen_L₁ : ∀ j : Fin s,
      ∃ (U_j : (weilBaseChangeOver K₀ ↥L₁ Y_K₀).left.Opens),
        (TopologicalSpace.Opens.map
          (weilBaseChangeMap K₀ ↥L₁ (AlgebraicClosure K₀) Y_K₀).base).obj U_j = U_bar j :=
    fun j => hTransportOpen (U_bar j) (L_u j) L₁
      (le_sup_right.trans (le_iSup (fun i : Fin s => L_c i ⊔ L_u i) j))
      (U_u j) (hU_u j)
  choose C_L₁ μ_tilde_L₁ p_C hProj_L₁ hSm_L₁ hp_C hComm_L₁ using hCurve_L₁
  choose U_tilde_L₁ hU_L₁ using hOpen_L₁
  exact ⟨L₁, hFD_L₁, C_L₁, μ_tilde_L₁, p_C, U_tilde_L₁,
    hProj_L₁, hSm_L₁, hp_C, hComm_L₁, hU_L₁⟩

theorem weil_field_ext_nilradical_curve_cover_fpqc_descent (K₁ Ω₀ : Type u) [Field K₁] [Field Ω₀] [Algebra K₁ Ω₀]
    (Y₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₁)))
    [AlgebraicGeometry.IsProper Y₁.hom]
    (Y_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)))
    (p_Y : Y_bar.left ⟶ Y₁.left)
    (hpY : CategoryTheory.IsPullback p_Y Y_bar.hom Y₁.hom
      (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ Ω₀))))
    (s : ℕ)
    (C₁ : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₁)))
    (C_bar : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)))
    (p_C : ∀ j : Fin s, (C_bar j).left ⟶ (C₁ j).left)
    (hpC : ∀ j : Fin s,
      CategoryTheory.IsPullback (p_C j) (C_bar j).hom (C₁ j).hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ Ω₀))))
    (hProj₁ : ∀ j : Fin s, IsProjectiveOverField K₁ (C₁ j))
    (hInt_bar : ∀ j : Fin s, AlgebraicGeometry.IsIntegral (C_bar j).left)
    (μ_tilde₁ : ∀ j : Fin s, C₁ j ⟶ Y₁)
    (μ_tilde_bar : ∀ j : Fin s, C_bar j ⟶ Y_bar)
    (hComm_μ : ∀ j : Fin s, p_C j ≫ (μ_tilde₁ j).left = (μ_tilde_bar j).left ≫ p_Y)
    (hFin_bar : ∀ j : Fin s, AlgebraicGeometry.IsFinite (μ_tilde_bar j).left)
    (hUniv_bar : (⋃ j : Fin s, Set.range (μ_tilde_bar j).left.base) = Set.univ)
    (μ_bar : ∀ j : Fin s, (C_bar j).left ⟶ Y_bar.left.nilradical.subscheme)
    (hLift_bar : ∀ j : Fin s,
      μ_bar j ≫ Y_bar.left.nilradical.subschemeι = (μ_tilde_bar j).left)
    (U_tilde₁ : Fin s → Y₁.left.Opens)
    (hIso_bar : ∀ j : Fin s,
      CategoryTheory.IsIso
        ((μ_bar j) ∣_
          ((TopologicalSpace.Opens.map Y_bar.left.nilradical.subschemeι.base).obj
            ((TopologicalSpace.Opens.map p_Y.base).obj (U_tilde₁ j))))) :
    ∃ (μ₁ : ∀ j : Fin s, (C₁ j).left ⟶ Y₁.left.nilradical.subscheme),
      (∀ j : Fin s, AlgebraicGeometry.IsIntegral (C₁ j).left) ∧
      (∀ j : Fin s, μ₁ j ≫ Y₁.left.nilradical.subschemeι = (μ_tilde₁ j).left) ∧
      (∀ j : Fin s, AlgebraicGeometry.IsFinite (μ₁ j)) ∧
      (⋃ j : Fin s, Set.range (μ₁ j).base) = Set.univ ∧
      (∀ j : Fin s,
        CategoryTheory.IsIso
          ((μ₁ j) ∣_
            ((TopologicalSpace.Opens.map Y₁.left.nilradical.subschemeι.base).obj
              (U_tilde₁ j)))) :=
by
  classical
  
  let β : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶ AlgebraicGeometry.Spec (CommRingCat.of K₁) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₁ Ω₀))
  have hSurj_β : AlgebraicGeometry.Surjective β := inferInstance
  have hFlat_β : AlgebraicGeometry.Flat β := inferInstance
  have hAff_β : AlgebraicGeometry.IsAffineHom β := inferInstance
  have hQC_β : AlgebraicGeometry.QuasiCompact β := inferInstance
  have hSurj_pY : AlgebraicGeometry.Surjective p_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpY.flip hSurj_β
  have hAff_pY : AlgebraicGeometry.IsAffineHom p_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpY.flip hAff_β
