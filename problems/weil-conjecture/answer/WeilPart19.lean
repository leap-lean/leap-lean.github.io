    have _ : CategoryTheory.IsIso ψ_αS :=
      h_α_spread S φ_RS hUnit_α (O_αS : AlgebraicGeometry.Scheme.{u}) P_αS
        (q_CS ∣_ O_α) (O_αS.ι ≫ f_CS) qP_S fP_S ψ_αS
        hpO_S hpP_S (CategoryTheory.Limits.pullback.lift_fst _ _ _)
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
    exact @AlgebraicGeometry.IsAffine.of_isIso (O_αS : AlgebraicGeometry.Scheme.{u}) P_αS ψ_αS _ _
  choose h_α hh_α_ne h_α_transfer using h_aff_piece
  refine ⟨∏ α : Fin m, h_α α, Finset.prod_ne_zero_iff.mpr (fun α _ => hh_α_ne α), ?_⟩
  intro S _ φ_RS hUnitS C_S Y_S q_CS f_CS q_YS f_YS μ_S hpCS hpYS hcommS hcompS
  have _ : AlgebraicGeometry.IsProper f_CS :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpCS inferInstance
  have _ : AlgebraicGeometry.IsProper f_YS :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpYS inferInstance
  have hProp_μS : AlgebraicGeometry.IsProper μ_S := by
    have _ : AlgebraicGeometry.IsProper (μ_S ≫ f_YS) := by rwa [hcompS]
