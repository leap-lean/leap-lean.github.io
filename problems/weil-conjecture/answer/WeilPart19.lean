        let iso_ker_cyc : CategoryTheory.Limits.kernel (GK.d 0 1) ≅ GK.cycles 0 :=
          (CategoryTheory.Limits.kernelIsKernel (GK.d 0 1)).conePointUniqueUpToIso
            (GK.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0))
        exact ⟨(e₀.app M).trans (iso_G_ker.trans (iso_ker_cyc.trans (CochainComplex.isoHomologyπ₀ GK)))⟩
      · 
        let Z₁ : CategoryTheory.Sheaf J₁ AddCommGrpCat.{u} := CategoryTheory.Limits.cokernel ε
        let π₀ : K.X 0 ⟶ Z₁ := CategoryTheory.Limits.cokernel.π ε
        let SC_M : CategoryTheory.ShortComplex (CategoryTheory.Sheaf J₁ AddCommGrpCat.{u}) :=
          CategoryTheory.ShortComplex.mk ε π₀ (CategoryTheory.Limits.cokernel.condition ε)
        have hSC_M_ex : SC_M.Exact := by
          rw [CategoryTheory.ShortComplex.exact_iff_mono_cokernel_desc]
          have hdesc_id : CategoryTheory.Limits.cokernel.desc ε π₀
              (CategoryTheory.Limits.cokernel.condition ε) = 𝟙 Z₁ := by
            rw [← cancel_epi (CategoryTheory.Limits.cokernel.π ε),
              CategoryTheory.Limits.cokernel.π_desc, CategoryTheory.Category.comp_id]
          dsimp [SC_M]
          rw [hdesc_id]
          infer_instance
        have hSE_M : SC_M.ShortExact :=
          { exact := hSC_M_ex
            mono_f := hε_mono
            epi_g := inferInstance }
        let ε₁ : Z₁ ⟶ K.X 1 := CategoryTheory.Limits.cokernel.desc ε (K.d 0 1) hε
        have hπ_ε₁ : π₀ ≫ ε₁ = K.d 0 1 := CategoryTheory.Limits.cokernel.π_desc ε (K.d 0 1) hε
        have hε₁_mono : CategoryTheory.Mono ε₁ := hEx₀.mono_cokernelDesc
        have hε₁ : ε₁ ≫ K.d 1 2 = 0 := by
          rw [← cancel_epi π₀, ← CategoryTheory.Category.assoc, hπ_ε₁, K.d_comp_d 0 1 2,
