        (hArrows_sheaf (W_et U s) (j_et U s) (hj_cov U s) (σ_loc U s) (hσ_compat U s))).2 t ht
    have hψ_const : ∀ {V U : S.Etale} (g : V ⟶ U) (s : LocallyConstant ↥U.left ↥A) (a : ↥A),
