        fun E =>
          let e0 : CategoryTheory.Abelian.Ext (F_free.obj E) G 0 ≃+ (F_free.obj E ⟶ G) :=
            CategoryTheory.Abelian.Ext.addEquiv₀
          let e1 : (F_free.obj E ⟶ G) ≃ ↥(G.obj.obj (Opposite.op E)) :=
            (adj_sh.homEquiv (CategoryTheory.yoneda.obj E) G).trans CategoryTheory.yonedaEquiv
          have he1_apply : ∀ (f : F_free.obj E ⟶ G),
              e1 f = (CategoryTheory.ConcreteCategory.hom (f.hom.app (Opposite.op E)))
                (CategoryTheory.yonedaEquiv (adj_sh.unit.app (CategoryTheory.yoneda.obj E))) := by
            intro f
            dsimp [e1]
            rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.yonedaEquiv_apply,
              CategoryTheory.yonedaEquiv_apply]
            rfl
          { toEquiv := e0.toEquiv.trans e1
            map_add' := fun (x y : CategoryTheory.Abelian.Ext (F_free.obj E) G 0) =>
              (congrArg e1 (e0.map_add x y)).trans
                ((he1_apply (e0 x + e0 y)).trans
                  ((congrArg₂ (· + ·) (he1_apply (e0 x)).symm (he1_apply (e0 y)).symm).symm)) }
