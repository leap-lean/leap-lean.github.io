    have : Module.Finite P ↥C_B := this
    exact Module.Finite.of_restrictScalars_finite P B ↥C_B
  have hStage2 : ∀ (R₁ : Type u) [CommRing R₁] [IsDomain R₁] [Algebra k R₁] [Algebra.FiniteType k R₁]
