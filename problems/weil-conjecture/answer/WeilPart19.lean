          rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
          rfl
      have h_ab : α_R.toRingHom.comp β_hom = RingHom.id Loc := by
        refine IsLocalization.ringHom_ext (Submonoid.powers ((1 : B) ⊗ₜ[R'] g)) ?_
        have h_alg : (α_R.comp β_R).comp (IsScalarTower.toAlgHom R' BD Loc) =
            IsScalarTower.toAlgHom R' BD Loc := by
          apply Algebra.TensorProduct.ext
          · apply AlgHom.ext; intro b
            change α_R (β_hom (algebraMap BD Loc (b ⊗ₜ[R'] (1 : D)))) =
              algebraMap BD Loc (b ⊗ₜ[R'] (1 : D))
            rw [IsLocalization.Away.lift_eq]
            change α_R ((Algebra.TensorProduct.map (AlgHom.id R' B) (IsScalarTower.toAlgHom R' D E))
