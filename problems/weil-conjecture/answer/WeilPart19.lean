theorem weil_etale_higherDirectImage_idVanish_isoPush_and_shortExact (k : Type u) [Field k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hSerre : WeilConstructibleModPrimeSerreHolds k ℓ) :
    (∀ (W : AlgebraicGeometry.Scheme.{u})
      (H : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}) (b : ℕ),
      CategoryTheory.Limits.IsZero
        (weilEtaleHigherDirectImage (CategoryTheory.CategoryStruct.id W) (b + 1) H)) ∧
    (∀ (X₀ B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType B.hom]
      [AlgebraicGeometry.QuasiCompact B.hom]
      [AlgebraicGeometry.IsSeparated B.hom]
      (h : X₀ ⟶ B),
      CategoryTheory.IsIso h.left →
      ∀ (F : CategoryTheory.Sheaf X₀.left.smallEtaleTopology AddCommGrpCat.{u}) (q : ℕ),
        WeilIsConstructibleModPrimeSheaf ℓ X₀.left F →
        WeilIsConstructibleModPrimeSheaf ℓ B.left (weilEtaleHigherDirectImage h.left q F)) ∧
    (∀ {X : AlgebraicGeometry.Scheme.{u}}
      (S : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
      [AlgebraicGeometry.LocallyOfFiniteType S.hom]
      [AlgebraicGeometry.QuasiCompact S.hom]
      [AlgebraicGeometry.IsSeparated S.hom]
      (f_left : X ⟶ S.left)
      (SC : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u})),
      SC.ShortExact →
      ℓ • CategoryTheory.CategoryStruct.id SC.X₂ = 0 →
      (∀ q : ℕ, WeilIsConstructibleModPrimeSheaf ℓ S.left
        (weilEtaleHigherDirectImage f_left q SC.X₁)) →
      (∀ q : ℕ, WeilIsConstructibleModPrimeSheaf ℓ S.left
        (weilEtaleHigherDirectImage f_left q SC.X₃)) →
      ∀ q : ℕ, WeilIsConstructibleModPrimeSheaf ℓ S.left
        (weilEtaleHigherDirectImage f_left q SC.X₂)) :=
by
  have instPB : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  have instSBC : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  let sitePull : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂),
      CategoryTheory.Functor X₂.Etale X₁.Etale :=
    fun h => CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ h
  let T_pre : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (q : ℕ),
      CategoryTheory.Functor
        (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Functor (Opposite X₂.Etale) AddCommGrpCat.{u}) :=
    fun {X₁ X₂} h q =>
      (CategoryTheory.Sheaf.cohomologyPresheafFunctor X₁.smallEtaleTopology q).comp
        ((CategoryTheory.Functor.whiskeringLeft (Opposite X₂.Etale) (Opposite X₁.Etale)
          AddCommGrpCat.{u}).obj (sitePull h).op)
  let T_sh : ∀ {X₁ X₂ : AlgebraicGeometry.Scheme.{u}} (h : X₁ ⟶ X₂) (q : ℕ),
      CategoryTheory.Functor
        (CategoryTheory.Sheaf X₁.smallEtaleTopology AddCommGrpCat.{u})
        (CategoryTheory.Sheaf X₂.smallEtaleTopology AddCommGrpCat.{u}) :=
