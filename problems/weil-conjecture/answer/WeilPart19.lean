    let f'_W : W_over ⟶ W_over :=
      CategoryTheory.Over.homMk (CategoryTheory.CategoryStruct.id W)
        (CategoryTheory.Category.id_comp _)
    have hu_Y_w : u_Y ≫ Y.hom = u ≫ X.hom := by
      rw [← CategoryTheory.Over.w i, ← CategoryTheory.Category.assoc, hpb.w,
