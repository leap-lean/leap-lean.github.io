        rw [CategoryTheory.Adjunction.comp_unit_app]
        rfl
      have hcalc : (σ₀ ≫ X₂.obj.map e_M.hom.op) ≫ g.hom.app (Opposite.op (M_v.obj (B_v.obj T₀))) =
          adj₀.unit.app A₃ ≫ (C₀.obj A₃).obj.map (adj_site.counit.app T₀).op := by
        rw [CategoryTheory.Category.assoc, hnat, ← CategoryTheory.Category.assoc, hσ₀,
          CategoryTheory.Category.assoc, ← (C₀.obj A₃).obj.map_comp, hmap_eq]
      exact hcalc.trans hcomp_unit.symm
    let s_sec : R_v.obj (C₀.obj A₃) ⟶ R_v.obj X₂ :=
      (adj_comp.homEquiv A₃ (R_v.obj X₂)).symm σ''_0
    have hs_sec : s_sec ≫ R_v.map g = 𝟙 (R_v.obj (C₀.obj A₃)) := by
      apply (adj_comp.homEquiv A₃ (R_v.obj (C₀.obj A₃))).injective
      have hLHS : adj_comp.homEquiv A₃ (R_v.obj (C₀.obj A₃)) (s_sec ≫ R_v.map g) =
          adj_comp.unit.app A₃ := by
        rw [CategoryTheory.Adjunction.homEquiv_unit, CategoryTheory.Functor.map_comp,
          ← CategoryTheory.Category.assoc,
          ← CategoryTheory.Adjunction.homEquiv_unit adj_comp A₃ (R_v.obj X₂) s_sec,
          (adj_comp.homEquiv A₃ (R_v.obj X₂)).apply_symm_apply σ''_0]
        exact hσ''_unit
      have hRHS : adj_comp.homEquiv A₃ (R_v.obj (C₀.obj A₃)) (𝟙 (R_v.obj (C₀.obj A₃))) =
          adj_comp.unit.app A₃ := by
        rw [CategoryTheory.Adjunction.homEquiv_unit]
        have hid : (P_push ⋙ Γ₀).map (𝟙 ((C₀ ⋙ R_v).obj A₃)) =
            𝟙 ((P_push ⋙ Γ₀).obj ((C₀ ⋙ R_v).obj A₃)) :=
          CategoryTheory.Functor.map_id (P_push ⋙ Γ₀) ((C₀ ⋙ R_v).obj A₃)
        exact (congrArg (adj_comp.unit.app A₃ ≫ ·) hid).trans
          (CategoryTheory.Category.comp_id _)
      exact hLHS.trans hRHS.symm
    let SC₀ : CategoryTheory.ShortComplex
        (CategoryTheory.Sheaf V₀.smallEtaleTopology AddCommGrpCat.{u}) :=
      CategoryTheory.ShortComplex.mk f g zero
    have hSE_Rv : (SC₀.map R_v).ShortExact := hSE.map_of_exact R_v
    let split_Rv : (SC₀.map R_v).Splitting :=
      CategoryTheory.ShortComplex.Splitting.ofExactOfSection
        (SC₀.map R_v) hSE_Rv.exact s_sec hs_sec hSE_Rv.mono_f
    have : C_W.Additive := by
      dsimp [C_W, CategoryTheory.constantSheaf]
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits C_W := by
      dsimp [C_W, CategoryTheory.constantSheaf]
      infer_instance
    have : CategoryTheory.Limits.PreservesBinaryBiproduct A₁ A₃ C_W :=
      CategoryTheory.Limits.preservesBinaryBiproduct_of_preservesBinaryProduct C_W
    let e_biprod : R_v.obj X₂ ≅ C_W.obj (CategoryTheory.Limits.biprod A₁ A₃) :=
      split_Rv.isoBinaryBiproduct ≪≫
        CategoryTheory.Limits.biprod.mapIso (e_const.app A₁).symm (e_const.app A₃).symm ≪≫
        (CategoryTheory.Functor.mapBiprod C_W A₁ A₃).symm
    exact ⟨hCont_B, hRA, ⟨(e_pull.app X₂) ≪≫ e_biprod⟩⟩

  
  have h_nsmul_apply : ∀ {G : AddCommGrpCat.{u}} (k : ℕ) (x : ↥G),
      (k • CategoryTheory.CategoryStruct.id G).hom x = k • x := by
    intro G k x
    induction k with
    | zero => simp
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul]
      change (k • CategoryTheory.CategoryStruct.id G).hom x +
        (CategoryTheory.CategoryStruct.id G).hom x = k • x + x
      rw [ih]
      rfl

  have h_vec : ∀ (V₃ : Type u) [AddCommGroup V₃] [Finite V₃] [Module (ZMod ℓ) V₃],
      ∃ (L : List V₃),
        ∀ (V_M V_N : Type u) [AddCommGroup V_M] [AddCommGroup V_N]
          [Module (ZMod ℓ) V_M] [Module (ZMod ℓ) V_N]
          (π : V_M →+ V_N) (τ : V₃ →+ V_N),
          (∀ a ∈ L, ∃ m : V_M, π m = τ a) →
          ∃ (σ : V₃ →+ V_M), π.comp σ = τ := by
    intro V₃ _ _ _
    have : Module.Finite (ZMod ℓ) V₃ := Module.Finite.of_finite
    have : Module.Free (ZMod ℓ) V₃ := Module.Free.of_divisionRing (ZMod ℓ) V₃
    let ι := Module.Free.ChooseBasisIndex (ZMod ℓ) V₃
    let b₀ : Module.Basis ι (ZMod ℓ) V₃ := Module.Free.chooseBasis (ZMod ℓ) V₃
    let L : List V₃ := (Finset.univ : Finset ι).toList.map b₀
    refine ⟨L, ?_⟩
    intro V_M V_N _ _ _ _ π τ hSurjL
    have hb_mem : ∀ i : ι, b₀ i ∈ L := fun i =>
      List.mem_map_of_mem (Finset.mem_toList.mpr (Finset.mem_univ i))
    let m_fn : ι → V_M := fun i => (hSurjL (b₀ i) (hb_mem i)).choose
    have hm_fn : ∀ i : ι, π (m_fn i) = τ (b₀ i) := fun i =>
      (hSurjL (b₀ i) (hb_mem i)).choose_spec
    let σ_lin : V₃ →ₗ[ZMod ℓ] V_M := b₀.constr (ZMod ℓ) m_fn
    let f₁_lin : V₃ →ₗ[ZMod ℓ] V_N := (π.comp σ_lin.toAddMonoidHom).toZModLinearMap ℓ
    let f₂_lin : V₃ →ₗ[ZMod ℓ] V_N := τ.toZModLinearMap ℓ
    have hlin_eq : f₁_lin = f₂_lin := by
      apply b₀.ext
      intro i
      change π (σ_lin (b₀ i)) = τ (b₀ i)
      rw [b₀.constr_basis (ZMod ℓ) m_fn i, hm_fn i]
    refine ⟨σ_lin.toAddMonoidHom, ?_⟩
    ext a
    exact LinearMap.congr_fun hlin_eq a

  have h_s4 : ∀ (A₁ A₃ : AddCommGrpCat.{u}),
      Finite A₁ →
      ℓ • CategoryTheory.CategoryStruct.id A₁ = 0 →
      Finite A₃ →
      ℓ • CategoryTheory.CategoryStruct.id A₃ = 0 →
      (Finite ↥(CategoryTheory.Limits.biprod A₁ A₃ : AddCommGrpCat.{u}) ∧
        ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.biprod A₁ A₃) = 0) ∧
      ∃ (L : List ↥A₃),
        ∀ {M N : AddCommGrpCat.{u}} (π : M ⟶ N) (τ : A₃ ⟶ N),
          ℓ • CategoryTheory.CategoryStruct.id M = 0 →
          ℓ • CategoryTheory.CategoryStruct.id N = 0 →
          (∀ a ∈ L, ∃ m : ↥M, π.hom m = τ.hom a) →
          ∃ (σ₀ : A₃ ⟶ M), σ₀ ≫ π = τ := by
    intro A₁ A₃ hFin₁ hTors₁ hFin₃ hTors₃
    have : Finite A₁ := hFin₁
    have : Finite A₃ := hFin₃
    have hFinBiprod : Finite ↥(CategoryTheory.Limits.biprod A₁ A₃ : AddCommGrpCat.{u}) := by
      let e_prod := AddCommGrpCat.biprodIsoProd A₁ A₃
      have hbij : Function.Bijective ⇑e_prod.hom.hom :=
        (CategoryTheory.ConcreteCategory.isIso_iff_bijective e_prod.hom).mp inferInstance
      exact Finite.of_injective _ hbij.injective
    have hTorsBiprod :
        ℓ • CategoryTheory.CategoryStruct.id (CategoryTheory.Limits.biprod A₁ A₃) = 0 := by
      apply CategoryTheory.Limits.biprod.hom_ext
      · rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.comp_id CategoryTheory.Limits.biprod.fst,
          ← CategoryTheory.Preadditive.comp_nsmul, hTors₁,
          CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
      · rw [CategoryTheory.Preadditive.nsmul_comp, CategoryTheory.Category.id_comp,
          ← CategoryTheory.Category.comp_id CategoryTheory.Limits.biprod.snd,
          ← CategoryTheory.Preadditive.comp_nsmul, hTors₃,
          CategoryTheory.Limits.comp_zero, CategoryTheory.Limits.zero_comp]
    have h_kill₃ : ∀ x : ↥A₃, ℓ • x = 0 := fun x => by
      rw [← h_nsmul_apply ℓ x, hTors₃]
      rfl
    obtain ⟨L, hL_lift⟩ := @h_vec ↥A₃ inferInstance hFin₃ (AddCommGroup.zmodModule h_kill₃)
    refine ⟨⟨hFinBiprod, hTorsBiprod⟩, L, ?_⟩
    intro M N π τ hTorsM hTorsN hSurjL
    have h_killM : ∀ x : ↥M, ℓ • x = 0 := fun x => by
      rw [← h_nsmul_apply ℓ x, hTorsM]
      rfl
    have h_killN : ∀ x : ↥N, ℓ • x = 0 := fun x => by
      rw [← h_nsmul_apply ℓ x, hTorsN]
      rfl
    obtain ⟨σ_hom, hσ_hom⟩ := @hL_lift ↥M ↥N inferInstance inferInstance
      (AddCommGroup.zmodModule h_killM) (AddCommGroup.zmodModule h_killN) π.hom τ.hom hSurjL
    refine ⟨AddCommGrpCat.ofHom σ_hom, ?_⟩
    apply AddCommGrpCat.ext
    intro a
    exact DFunLike.congr_fun hσ_hom a

  
  refine ⟨?_, ?_⟩
  · 
    intro V _ _ A₁ A₂ ψ
    let C_V := CategoryTheory.constantSheaf V.smallEtaleTopology AddCommGrpCat.{u}
    have hT_V : CategoryTheory.Limits.IsTerminal
        (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V)) :=
      h_etale_term V
    let adj_V := CategoryTheory.constantSheafAdj V.smallEtaleTopology AddCommGrpCat.{u} hT_V
    have : CategoryTheory.IsIso (adj_V.unit.app A₂) := h_s1 V A₂ hT_V
    let α : A₁ ⟶ A₂ :=
      (adj_V.homEquiv A₁ (C_V.obj A₂) ψ) ≫ CategoryTheory.inv (adj_V.unit.app A₂)
    have hψ : C_V.map α = ψ := by
      apply (adj_V.homEquiv A₁ (C_V.obj A₂)).injective
      rw [CategoryTheory.Adjunction.homEquiv_unit]
      have hnat : adj_V.unit.app A₁ ≫
          ((CategoryTheory.sheafSections V.smallEtaleTopology AddCommGrpCat.{u}).obj
            (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V)))).map
            (C_V.map α) = α ≫ adj_V.unit.app A₂ :=
        (adj_V.unit.naturality α).symm
      rw [hnat]
      dsimp [α]
      rw [CategoryTheory.Category.assoc, CategoryTheory.IsIso.inv_hom_id,
        CategoryTheory.Category.comp_id]
    have : C_V.Additive := by
      dsimp [C_V, CategoryTheory.constantSheaf]
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteLimits C_V := by
      dsimp [C_V, CategoryTheory.constantSheaf]
      infer_instance
    have : CategoryTheory.Limits.PreservesFiniteColimits C_V := by
      dsimp [C_V, CategoryTheory.constantSheaf]
      infer_instance
    refine ⟨α,
      ⟨CategoryTheory.Limits.kernelIsoOfEq hψ.symm ≪≫
        (CategoryTheory.Limits.PreservesKernel.iso C_V α).symm⟩,
      ⟨CategoryTheory.Limits.cokernelIsoOfEq hψ.symm ≪≫
        (CategoryTheory.Limits.PreservesCokernel.iso C_V α).symm⟩⟩
  · 
    intro V₀ _ A₁ A₃ SC
    rcases SC with @⟨X₁, X₂, X₃, f, g, zero⟩
    intro hSE hX₁ hX₃ hFin₁ hTors₁ hFin₃ hTors₃ hTorsX₂
    dsimp at hX₁ hX₃ hTorsX₂
    subst hX₁; subst hX₃
    have : CategoryTheory.Epi g := hSE.epi_g
    let T₀ : V₀.Etale := AlgebraicGeometry.Scheme.Etale.mk (CategoryTheory.CategoryStruct.id V₀)
    have hT₀ : CategoryTheory.Limits.IsTerminal T₀ := h_etale_term V₀
    have hT₀_ne : Nonempty ↥T₀.left := ‹Nonempty ↥V₀›
    let C₀ := CategoryTheory.constantSheaf V₀.smallEtaleTopology AddCommGrpCat.{u}
    let adj₀ := CategoryTheory.constantSheafAdj V₀.smallEtaleTopology AddCommGrpCat.{u} hT₀
    let η₃ : A₃ ⟶ (C₀.obj A₃).obj.obj (Opposite.op T₀) := adj₀.unit.app A₃
    obtain ⟨⟨hFinA₂, hTorsA₂⟩, L, hBasisLift⟩ := h_s4 A₁ A₃ hFin₁ hTors₁ hFin₃ hTors₃
    obtain ⟨E, u, hE_ne, hLiftL⟩ := h_s2 V₀ g T₀ hT₀_ne (L.map η₃.hom)
    have hu_eq : u = hT₀.from E := hT₀.hom_ext u (hT₀.from E)
    have h_sheaf_nsmul : ∀ (ℱ : CategoryTheory.Sheaf V₀.smallEtaleTopology AddCommGrpCat.{u})
        (k : ℕ),
        (k • CategoryTheory.CategoryStruct.id ℱ).hom.app (Opposite.op E) =
          k • CategoryTheory.CategoryStruct.id (ℱ.obj.obj (Opposite.op E)) := by
      intro ℱ k
      induction k with
      | zero =>
        rw [zero_smul, zero_smul]
        rfl
      | succ k ih =>
        rw [succ_nsmul, succ_nsmul]
        change (k • CategoryTheory.CategoryStruct.id ℱ).hom.app (Opposite.op E) +
          (CategoryTheory.CategoryStruct.id ℱ).hom.app (Opposite.op E) = _
        rw [ih]
        rfl
    have hTorsM : ℓ • CategoryTheory.CategoryStruct.id (X₂.obj.obj (Opposite.op E)) = 0 := by
      rw [← h_sheaf_nsmul X₂ ℓ, hTorsX₂]
      rfl
    have : C₀.Additive := by
      dsimp [C₀, CategoryTheory.constantSheaf]
      infer_instance
    have hTorsC₀A₃ : ℓ • CategoryTheory.CategoryStruct.id (C₀.obj A₃) = 0 := by
      rw [← C₀.map_id, ← C₀.map_nsmul, hTors₃, C₀.map_zero]
    have hTorsN :
        ℓ • CategoryTheory.CategoryStruct.id ((C₀.obj A₃).obj.obj (Opposite.op E)) = 0 := by
      rw [← h_sheaf_nsmul (C₀.obj A₃) ℓ, hTorsC₀A₃]
      rfl
    let τ_E : A₃ ⟶ (C₀.obj A₃).obj.obj (Opposite.op E) :=
      η₃ ≫ (C₀.obj A₃).obj.map (hT₀.from E).op
    have hSurjL_E : ∀ a ∈ L, ∃ m : ↥(X₂.obj.obj (Opposite.op E)),
        (g.hom.app (Opposite.op E)).hom m = τ_E.hom a := by
      intro a ha
      obtain ⟨m, hm⟩ := hLiftL (η₃.hom a) (List.mem_map_of_mem ha)
      refine ⟨m, ?_⟩
      rw [hm, hu_eq]
      rfl
    obtain ⟨σ₀, hσ₀⟩ := hBasisLift (g.hom.app (Opposite.op E)) τ_E hTorsM hTorsN hSurjL_E
    have hPull := h_s3 V₀ E A₁ A₃ X₂ f g zero hT₀ hSE ⟨σ₀, hσ₀⟩
    exact ⟨E.left, E.hom, CategoryTheory.Limits.biprod A₁ A₃,
      E.prop, hE_ne, hFinA₂, hTorsA₂, hPull⟩

theorem weil_etale_integral_affine_shrinking_to_finite_etale (U₀ W : AlgebraicGeometry.Scheme.{u})
    [AlgebraicGeometry.IsAffine U₀] [AlgebraicGeometry.IsIntegral U₀]
    (w : W ⟶ U₀) [AlgebraicGeometry.Etale w] (hW : Nonempty ↥W) :
    ∃ (U' : U₀.Opens) (_ : Nonempty U')
      (V' : AlgebraicGeometry.Scheme.{u}) (j : V' ⟶ W)
      (p' : V' ⟶ (U' : AlgebraicGeometry.Scheme.{u})),
      AlgebraicGeometry.IsAffine (U' : AlgebraicGeometry.Scheme.{u}) ∧
      AlgebraicGeometry.IsIntegral V' ∧
      AlgebraicGeometry.IsOpenImmersion j ∧
      AlgebraicGeometry.IsFinite p' ∧
      AlgebraicGeometry.Etale p' ∧
      AlgebraicGeometry.Surjective p' ∧
      p' ≫ U'.ι = j ≫ w :=
by
  classical
  have hGenFin : ∀ (R B : Type u) [CommRing R] [IsDomain R]
      [CommRing B] [Nontrivial B] (φ_B : R →+* B),
      φ_B.Etale →
      ∃ r₁ : R,
        r₁ ≠ 0 ∧
        Nontrivial (Localization.Away (φ_B r₁)) ∧
        ∀ (R₀ : Type u) [CommRing R₀] [Algebra R R₀] [IsLocalization.Away r₁ R₀],
          ∃ φ₀ : R₀ →+* Localization.Away (φ_B r₁),
            φ₀.Finite ∧
            φ₀.comp (algebraMap R R₀) =
              (algebraMap B (Localization.Away (φ_B r₁))).comp φ_B := by
    intro R B _ _ _ _ φ_B hφB_et
    letI : Algebra R B := φ_B.toAlgebra
    haveI : Algebra.Etale R B := RingHom.Etale.toAlgebra hφB_et
    haveI : Algebra.FinitePresentation R B := Algebra.Etale.finitePresentation
    haveI : Algebra.Smooth R B :=
      ((RingHom.etale_iff_formallyUnramified_and_smooth φ_B).mp hφB_et).2.toAlgebra
    haveI : Module.Flat R B := Algebra.Smooth.flat R B
    haveI : Module.IsTorsionFree R B := Module.Flat.isTorsionFree
    let K : Type u := FractionRing R
    let M_R : Submonoid R := nonZeroDivisors R
    let M_B : Submonoid B := Algebra.algebraMapSubmonoid B M_R
    haveI : IsLocalization M_B (TensorProduct R B K) := IsLocalization.tensor K M_R
    let commKB : TensorProduct R K B ≃ₐ[R] TensorProduct R B K :=
      Algebra.TensorProduct.comm R K B
    let ι_KB : B →ₐ[R] TensorProduct R K B := Algebra.TensorProduct.includeRight
    have h_comm_ιKB : ∀ b : B, commKB (ι_KB b) = algebraMap B (TensorProduct R B K) b :=
      fun _ => rfl
    have h_inj_ιKB : Function.Injective ι_KB := by
      rw [injective_iff_map_eq_zero]
      intro b hb
      have hb' : algebraMap B (TensorProduct R B K) b =
          algebraMap B (TensorProduct R B K) 0 := by
        rw [← h_comm_ιKB b, hb, map_zero, map_zero]
      obtain ⟨⟨_, c, hc_mem, rfl⟩, hc_eq⟩ :=
        (IsLocalization.eq_iff_exists M_B (TensorProduct R B K)).mp hb'
      simp only [mul_zero] at hc_eq
      have hc_ne : c ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hc_mem
      have hsmul : c • b = 0 := hc_eq
      exact (smul_eq_zero.mp hsmul).resolve_left hc_ne
    haveI : Algebra.Etale K (TensorProduct R K B) := Algebra.Etale.baseChange R B K
    obtain ⟨I, hFinI, L, hFieldL, hAlgL, Φ_B, hFinSep⟩ :=
      (Algebra.Etale.iff_exists_algEquiv_prod K (TensorProduct R K B)).mp inferInstance
    letI : Finite I := hFinI
    letI : ∀ i : I, Field (L i) := hFieldL
    letI : ∀ i : I, Algebra K (L i) := hAlgL
    haveI : ∀ i : I, Module.Finite K (L i) := fun i => (hFinSep i).1
    haveI : Module.Finite K (TensorProduct R K B) :=
      Module.Finite.equiv Φ_B.symm.toLinearEquiv
    haveI : Algebra.IsIntegral K (TensorProduct R K B) :=
      Algebra.IsIntegral.of_finite K (TensorProduct R K B)
    obtain ⟨G, hG_adjoin⟩ := Algebra.FiniteType.out (R := R) (A := B)
    have hMult : ∀ g : B, ∃ m : R, m ≠ 0 ∧ _root_.IsIntegral R (φ_B m * g) := by
      intro g
      have hIntK : _root_.IsIntegral K (ι_KB g) := Algebra.IsIntegral.isIntegral (ι_KB g)
      obtain ⟨⟨m, hm_mem⟩, hm_int⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization M_R (ι_KB g) hIntK
      refine ⟨m, mem_nonZeroDivisors_iff_ne_zero.mp hm_mem, ?_⟩
      change _root_.IsIntegral R (m • ι_KB g) at hm_int
      have hm_eq : (m • ι_KB g : TensorProduct R K B) = ι_KB (φ_B m * g) := by
        change m • ι_KB g = ι_KB (m • g)
        exact (map_smul ι_KB m g).symm
      rw [hm_eq] at hm_int
      exact (isIntegral_algHom_iff ι_KB h_inj_ιKB).mp hm_int
    choose m_fn hm_ne hm_int using hMult
    let r₁ : R := ∏ g ∈ G, m_fn g
    have hr₁_ne : r₁ ≠ 0 := Finset.prod_ne_zero_iff.mpr fun g _ => hm_ne g
    let S₀ : Type u := Localization.Away (φ_B r₁)
    have hNontriv_S₀ : Nontrivial S₀ := by
      rw [← not_subsingleton_iff_nontrivial,
        IsLocalization.subsingleton_iff (M := Submonoid.powers (φ_B r₁)) (S := S₀)]
      rintro ⟨n, hn⟩
      change (φ_B r₁) ^ n = 0 at hn
      rw [← map_pow] at hn
      have hsmul : (r₁ ^ n) • (1 : B) = 0 := by
        change φ_B (r₁ ^ n) * 1 = 0
        rw [hn, zero_mul]
      rcases smul_eq_zero.mp hsmul with hr0 | h10
      · exact pow_ne_zero n hr₁_ne hr0
      · exact one_ne_zero h10
    refine ⟨r₁, hr₁_ne, hNontriv_S₀, ?_⟩
    intro R₀ _ _ _
    let g_RS₀ : R →+* S₀ := (algebraMap B S₀).comp φ_B
    have hg_r₁_unit : IsUnit (g_RS₀ r₁) :=
      IsLocalization.Away.algebraMap_isUnit (φ_B r₁)
    let φ₀ : R₀ →+* S₀ := IsLocalization.Away.lift (S := R₀) r₁ hg_r₁_unit
    have hφ₀_comp : φ₀.comp (algebraMap R R₀) = g_RS₀ := by
      ext x
      exact IsLocalization.Away.lift_eq (S := R₀) r₁ hg_r₁_unit x
    have hφ₀_fin : φ₀.Finite := by
      letI : Algebra R₀ S₀ := φ₀.toAlgebra
      change Module.Finite R₀ S₀
      let α_B : B →+* S₀ := algebraMap B S₀
      obtain ⟨u₁, hu₁⟩ := IsLocalization.Away.algebraMap_isUnit (S := R₀) r₁
      have hinv_eq : IsLocalization.Away.invSelf (φ_B r₁) = φ₀ (↑u₁⁻¹ : R₀) := by
        have hu_S₀ : IsUnit (α_B (φ_B r₁)) := hg_r₁_unit
