      exact ⟨u_Y z, (hs_range (u_Y z) z).mpr rfl⟩
    have hs_disj : _root_.Pairwise (Function.onFun Disjoint fun δ => (s δ).opensRange) := by
      intro δ₁ δ₂ hne
      change Disjoint (s δ₁).opensRange (s δ₂).opensRange
      rw [disjoint_iff]
      ext z
      constructor
      · rintro ⟨h1, h2⟩
        exact hne (((hs_range δ₁ z).mp h1).symm.trans ((hs_range δ₂ z).mp h2))
      · exact False.elim
    obtain ⟨hc⟩ := AlgebraicGeometry.nonempty_isColimit_cofanMk_of s hs_cov hs_disj
    
    let f_triv : ↑(T_Y.presheaf.obj (Opposite.op ⊤)) →+*
        (ZMod ℓ → ↑(Y.presheaf.obj (Opposite.op ⊤))) :=
      RingHom.pi (fun δ => (s δ).appTop.hom)
    let G : (AlgebraicGeometry.Scheme.{u})ᵒᵖ ⥤ Type u :=
      AlgebraicGeometry.Scheme.Γ ⋙ CategoryTheory.forget CommRingCat.{u}
    let hLim := CategoryTheory.Limits.isLimitOfPreserves G hc.op
    let e_sec := CategoryTheory.Limits.Types.isLimitEquivSections hLim
    have hf_triv_bij : Function.Bijective f_triv := by
      constructor
      · intro x₁ x₂ hx
        apply e_sec.injective
        ext ⟨⟨δ⟩⟩
        rw [CategoryTheory.Limits.Types.isLimitEquivSections_apply hLim
            (Opposite.op (Discrete.mk δ)) x₁,
          CategoryTheory.Limits.Types.isLimitEquivSections_apply hLim
            (Opposite.op (Discrete.mk δ)) x₂]
        exact congrFun hx δ
      · intro v
        let u_sec : ↑((Discrete.functor fun _ : ZMod ℓ => Y).op ⋙ G).sections :=
          ⟨fun j => v j.unop.as, by
            rintro ⟨⟨δ₁⟩⟩ ⟨⟨δ₂⟩⟩ f
            obtain rfl : δ₂ = δ₁ := Discrete.eq_of_hom f.unop
            obtain rfl : f = 𝟙 _ := Subsingleton.elim _ _
            simp; rfl⟩
        refine ⟨e_sec.symm u_sec, ?_⟩
        ext δ
        change (s δ).appTop.hom (e_sec.symm u_sec) = v δ
        have happ := CategoryTheory.Limits.Types.isLimitEquivSections_apply hLim
          (Opposite.op (Discrete.mk δ)) (e_sec.symm u_sec)
        rw [e_sec.apply_symm_apply] at happ
        exact happ.symm
    let e_triv : ↑(T_Y.presheaf.obj (Opposite.op ⊤)) ≃+*
        (ZMod ℓ → ↑(Y.presheaf.obj (Opposite.op ⊤))) :=
      RingEquiv.ofBijective f_triv hf_triv_bij
    refine ⟨e_triv, ?_, ?_⟩
    · intro a δ
      have hs_sec : s δ ≫ τ_Y = 𝟙 Y := by
        dsimp [s, σ_Y, g_Y0]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hρY_over δ,
          CategoryTheory.IsIso.inv_hom_id]
      change (s δ).appTop.hom (τ_Y.appTop.hom a) = a
      change (τ_Y.appTop ≫ (s δ).appTop).hom a = a
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hs_sec,
        AlgebraicGeometry.Scheme.Hom.id_appTop]
      rfl
    · intro γ x δ
      have hs_act : s δ ≫ ρ_Y γ = s (δ + γ) := by
        dsimp [s]
        rw [CategoryTheory.Category.assoc, ← hρY_add δ γ]
      change (s δ).appTop.hom ((ρ_Y γ).appTop.hom x) = (s (δ + γ)).appTop.hom x
      change ((ρ_Y γ).appTop ≫ (s δ).appTop).hom x = (s (δ + γ)).appTop.hom x
      rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hs_act]

theorem weil_etale_h1_pullback_kernel_torsor_cover (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (X Y : AlgebraicGeometry.Scheme.{u})
    (h : Y ⟶ X) :
    ∃ (ψ_pull : weilEtaleTorsionH X ℓ 1 →+ weilEtaleTorsionH Y ℓ 1),
      ∀ (c : weilEtaleTorsionH X ℓ 1),
        ψ_pull c = 0 → c ≠ 0 →
        ∃ (T : AlgebraicGeometry.Scheme.{u})
          (τ : T ⟶ X)
          (ρ : ZMod ℓ → (T ⟶ T))
          (hρ_over : ∀ γ : ZMod ℓ, ρ γ ≫ τ = τ),
          AlgebraicGeometry.IsFinite τ ∧
          AlgebraicGeometry.Etale τ ∧
          ρ 0 = 𝟙 T ∧
          (∀ γ₁ γ₂ : ZMod ℓ, ρ (γ₁ + γ₂) = ρ γ₁ ≫ ρ γ₂) ∧
          (¬ ∃ e₀ : ↑(T.presheaf.obj (Opposite.op ⊤)),
            e₀ * e₀ = e₀ ∧
            (∑ γ : ZMod ℓ, (ρ γ).appTop.hom e₀) = 1 ∧
            (∀ γ : ZMod ℓ, γ ≠ 0 → e₀ * (ρ γ).appTop.hom e₀ = 0)) ∧
          ∃ (e_triv : ↑((CategoryTheory.Limits.pullback τ h).presheaf.obj (Opposite.op ⊤)) ≃+*
              (ZMod ℓ → ↑(Y.presheaf.obj (Opposite.op ⊤)))),
            (∀ (a : ↑(Y.presheaf.obj (Opposite.op ⊤))) (δ : ZMod ℓ),
              e_triv ((CategoryTheory.Limits.pullback.snd τ h).appTop.hom a) δ = a) ∧
            (∀ (γ : ZMod ℓ)
               (x : ↑((CategoryTheory.Limits.pullback τ h).presheaf.obj (Opposite.op ⊤)))
               (δ : ZMod ℓ),
              e_triv ((CategoryTheory.Limits.pullback.lift
                (CategoryTheory.Limits.pullback.fst τ h ≫ ρ γ)
                (CategoryTheory.Limits.pullback.snd τ h)
                ((CategoryTheory.Category.assoc _ _ _).trans
                  ((congrArg (CategoryTheory.Limits.pullback.fst τ h ≫ ·) (hρ_over γ)).trans
                    CategoryTheory.Limits.pullback.condition))).appTop.hom x) δ =
              e_triv x (δ + γ)) :=
by
  obtain ⟨hLocConst, hSite⟩ := weil_etale_sitePullback_exact_and_locallyConstant X Y h
  obtain ⟨ψ_pull, hKer⟩ := weil_etale_h1_pullback_kernel_torsor_sheaf ℓ X Y h hLocConst hSite
  refine ⟨ψ_pull, fun c hψc hc_ne => ?_⟩
  obtain ⟨P, actP, hact0, hact_add, hEmpty, hLocTriv, hTwist, hTrans, hSplitY⟩ :=
    hKer c hψc hc_ne
  obtain ⟨T, τ, hFin_τ, hEt_τ, hSurj_τ, ρ, hρ_over, hρ0, hρ_add, ⟨s_taut, hs_taut⟩,
    hLift, hShearDisj, hShearCov⟩ :=
    weil_etale_torsor_sheaf_representable_by_scheme ℓ X
      (fun A D _ _ _ hFF hEt e₁₂ =>
        weil_commRing_faithfullyFlat_etale_zmod_cocycle_descent ℓ A D hFF hEt e₁₂)
      P actP hact0 hact_add hLocTriv hTwist hTrans
  haveI : AlgebraicGeometry.Etale τ := hEt_τ
  obtain ⟨hSecOfIdemp, hTrivOfLocConst⟩ :=
    weil_scheme_zmod_torsor_clopen_splitting_and_no_frame_idempotent
      ℓ X Y h T τ ρ hρ_over hFin_τ hEt_τ hSurj_τ hρ0 hρ_add hShearDisj hShearCov
  refine ⟨T, τ, ρ, hρ_over, hFin_τ, hEt_τ, hρ0, hρ_add, ?_, ?_⟩
  · intro he₀
    obtain ⟨σ, hστ⟩ := hSecOfIdemp he₀
    let T_X : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (𝟙 X)
    have hTerm_TX : CategoryTheory.Limits.IsTerminal T_X :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun E => CategoryTheory.MorphismProperty.Over.homMk E.hom
          (CategoryTheory.Category.comp_id E.hom))
        (fun E m => CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.Category.comp_id m.left).symm.trans
            (m.w.trans (CategoryTheory.Category.comp_id E.hom))))
    obtain ⟨s₀⟩ := hLift T_X σ hστ
    exact (hEmpty T_X hTerm_TX).false s₀
  · let U_T : X.Etale := AlgebraicGeometry.Scheme.Etale.mk τ
    let ρ_et : ZMod ℓ → (U_T ⟶ U_T) :=
      fun γ => CategoryTheory.MorphismProperty.Over.homMk (ρ γ) (hρ_over γ)
    obtain ⟨u_Y, hu_Y⟩ := hSplitY U_T s_taut ρ_et hs_taut
    apply hTrivOfLocConst u_Y
    intro γ z
    have hmap_eq : (((weilEtaleSitePullback h).map (ρ_et γ)).left) =
        CategoryTheory.Limits.pullback.lift
          (CategoryTheory.Limits.pullback.fst τ h ≫ ρ γ)
          (CategoryTheory.Limits.pullback.snd τ h)
          ((CategoryTheory.Category.assoc _ _ _).trans
            ((congrArg (CategoryTheory.Limits.pullback.fst τ h ≫ ·) (hρ_over γ)).trans
              CategoryTheory.Limits.pullback.condition)) := rfl
    rw [← hmap_eq]
    exact hu_Y γ z

theorem weil_flat_proper_dvr_global_sections_generic_and_special_bridge (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (T : AlgebraicGeometry.Scheme.{u})
    (g_T : T ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    [AlgebraicGeometry.Flat g_T] [AlgebraicGeometry.IsProper g_T]
    (B : Type u) [CommRing B] [Algebra R B]
    (eB : B ≃+* ↑(T.presheaf.obj (Opposite.op ⊤)))
    (heB : ∀ r : R,
      eB (algebraMap R B r) =
        ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ g_T.appTop).hom r)
    (Ω_R : Type u) [Field Ω_R] [Algebra R Ω_R]
    (hInjΩ : Function.Injective (algebraMap R Ω_R))
    (η_R : AlgebraicGeometry.Spec (CommRingCat.of Ω_R) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R))
    (hη : η_R = AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R Ω_R))) :
    (∃ (e_gen : TensorProduct R Ω_R B ≃+*
          ↑((CategoryTheory.Limits.pullback g_T η_R).presheaf.obj (Opposite.op ⊤))),
      ∀ (ω : Ω_R) (b : B),
        e_gen (TensorProduct.tmul R ω b) =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω_R)).inv ≫
            (CategoryTheory.Limits.pullback.snd g_T η_R).appTop).hom ω *
          (CategoryTheory.Limits.pullback.fst g_T η_R).appTop.hom (eB b)) ∧
    (AlgebraicGeometry.IsReduced
        (CategoryTheory.Limits.pullback g_T
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom
            (algebraMap R (AlgebraicClosure (IsLocalRing.ResidueField R)))))) →
      IsReduced (TensorProduct R (AlgebraicClosure (IsLocalRing.ResidueField R)) B)) :=
by
  classical
  subst hη
  
  have h_aff_pull : ∀ (S : Type u) [CommRing S] [Algebra R S]
      (W : T.Opens) (hW : AlgebraicGeometry.IsAffineOpen W)
      (A : Type u) [CommRing A] [Algebra R A]
      (eU : A ≃+* ↑(T.presheaf.obj (Opposite.op W)))
      (heU : ∀ r : R,
        eU (algebraMap R A r) =
          ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            g_T.appLE ⊤ W le_top).hom r),
      let η_S := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R S))
      let T_S := CategoryTheory.Limits.pullback g_T η_S
      let fst_S := CategoryTheory.Limits.pullback.fst g_T η_S
      let snd_S := CategoryTheory.Limits.pullback.snd g_T η_S
      let V : T_S.Opens := (TopologicalSpace.Opens.map fst_S.base).obj W
      ∃ (e_WS : TensorProduct R S A ≃+* ↑(T_S.presheaf.obj (Opposite.op V))),
        ∀ (s : S) (a : A),
          e_WS (TensorProduct.tmul R s a) =
            ((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫
              snd_S.appLE ⊤ V le_top).hom s *
            (fst_S.appLE W V (le_refl _)).hom (eU a) := by
    intro S _ _ W hW A _ _ eU heU η_S T_S fst_S snd_S V
    have hΓ_nat : ∀ {R₀ S₀ : CommRingCat.{u}} (ψ : R₀ ⟶ S₀),
        (Scheme.ΓSpecIso R₀).inv ≫ (Spec.map ψ).appTop ≫ (Scheme.ΓSpecIso S₀).hom = ψ := by
      intro R₀ S₀ ψ
      rw [Scheme.ΓSpecIso_naturality ψ, Iso.inv_hom_id_assoc]
    have hι_top : ∀ {X : Scheme.{u}} (U₀ : X.Opens) (he : (⊤ : (U₀ : Scheme.{u}).Opens) ≤ U₀.ι ⁻¹ᵁ U₀),
        U₀.ι.appLE U₀ ⊤ he = U₀.topIso.inv := by
      intro X U₀ he
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_inv]
      congr 1
    have happTop_eq : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (he : (⊤ : X.Opens) ≤ f ⁻¹ᵁ ⊤),
        f.appTop = f.appLE ⊤ ⊤ he := by
      intro X Y f he
      simp only [Scheme.Hom.appTop, Scheme.Hom.appLE]
      have hid : homOfLE he = 𝟙 (⊤ : X.Opens) := Subsingleton.elim _ _
      rw [hid]
      erw [X.presheaf.map_id, Category.comp_id]
    have happLE_congr : ∀ {X Y : Scheme.{u}} {f₁ f₂ : X ⟶ Y} (h : f₁ = f₂)
        (U₀ : Y.Opens) (V₀ : X.Opens) (e₁ : V₀ ≤ f₁ ⁻¹ᵁ U₀) (e₂ : V₀ ≤ f₂ ⁻¹ᵁ U₀),
        f₁.appLE U₀ V₀ e₁ = f₂.appLE U₀ V₀ e₂ := by
      rintro _ _ _ _ rfl _ _ _ _; rfl
    let eA_iso : CommRingCat.of A ≅ T.presheaf.obj (Opposite.op W) := eU.toCommRingCatIso
    let eSpecA : Spec (CommRingCat.of A) ≅ Spec (T.presheaf.obj (Opposite.op W)) :=
      { hom := Spec.map eA_iso.inv
        inv := Spec.map eA_iso.hom
        hom_inv_id := by rw [← Spec.map_comp, eA_iso.hom_inv_id, Spec.map_id]
        inv_hom_id := by rw [← Spec.map_comp, eA_iso.inv_hom_id, Spec.map_id] }
    let eW_iso : Spec (CommRingCat.of A) ≅ (W : Scheme.{u}) :=
      eSpecA ≪≫ hW.isoSpec.symm
    let j_A : Spec (CommRingCat.of A) ⟶ T := eW_iso.hom ≫ W.ι
    have heW_appTop : W.topIso.inv ≫ eW_iso.hom.appTop =
        eA_iso.inv ≫ (Scheme.ΓSpecIso (CommRingCat.of A)).inv := by
      dsimp only [eW_iso, eSpecA, Iso.trans_hom, Iso.symm_hom]
      rw [Scheme.Hom.comp_appTop, hW.isoSpec_inv_appTop, Category.assoc, Iso.inv_hom_id_assoc]
      rw [← cancel_mono (Scheme.ΓSpecIso (CommRingCat.of A)).hom, Category.assoc, Category.assoc,
        Iso.inv_hom_id, Category.comp_id, hΓ_nat]
    have hW_top_le : (⊤ : (W : Scheme.{u}).Opens) ≤ W.ι ⁻¹ᵁ W := by simp
    have hV_top_le : (⊤ : (V : Scheme.{u}).Opens) ≤ V.ι ⁻¹ᵁ V := by simp
    have hj_base : j_A ≫ g_T = Spec.map (CommRingCat.ofHom (algebraMap R A)) := by
      rw [← Spec.map_preimage (j_A ≫ g_T)]
      congr 1
      rw [← hΓ_nat (Spec.preimage (j_A ≫ g_T)), Spec.map_preimage]
      have h1 : (j_A ≫ g_T).appTop = (W.ι ≫ g_T).appTop ≫ eW_iso.hom.appTop := by
        dsimp only [j_A]
        rw [Category.assoc, Scheme.Hom.comp_appTop]
      have h2 : (W.ι ≫ g_T).appTop = g_T.appLE ⊤ W le_top ≫ W.topIso.inv := by
        rw [happTop_eq (W.ι ≫ g_T) le_top,
          ← Scheme.Hom.appLE_comp_appLE W.ι g_T ⊤ W ⊤ le_top hW_top_le, hι_top W hW_top_le]
      rw [h1, h2]
      simp only [Category.assoc]
      rw [reassoc_of% heW_appTop, Iso.inv_hom_id, Category.comp_id]
      ext r
      apply eU.injective
      change eU (eU.symm (((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ g_T.appLE ⊤ W le_top).hom r)) =
        eU (algebraMap R A r)
      rw [eU.apply_symm_apply, heU r]
    let fst_W : (V : Scheme.{u}) ⟶ (W : Scheme.{u}) :=
      (pullbackRestrictIsoRestrict fst_S W).inv ≫ Limits.pullback.snd fst_S W.ι
    have hfst_W_ι : fst_W ≫ W.ι = V.ι ≫ fst_S := by
      dsimp [fst_W]
      rw [Category.assoc, ← Limits.pullback.condition,
        ← pullbackRestrictIsoRestrict_hom_ι fst_S W, Category.assoc, Iso.inv_hom_id_assoc]
    have hfst_W_appTop : fst_S.appLE W V (le_refl _) ≫ V.topIso.inv =
        W.topIso.inv ≫ fst_W.appTop := by
      rw [← hι_top V hV_top_le, Scheme.Hom.appLE_comp_appLE V.ι fst_S W V ⊤ (le_refl _) hV_top_le,
        ← hι_top W hW_top_le, happTop_eq fst_W le_top]
      have h_fw_le : (⊤ : (V : Scheme.{u}).Opens) ≤ (fst_W ≫ W.ι) ⁻¹ᵁ W := by
        rw [hfst_W_ι]
        exact hV_top_le
      rw [Scheme.Hom.appLE_comp_appLE fst_W W.ι W ⊤ ⊤ hW_top_le le_top]
      exact happLE_congr hfst_W_ι.symm W ⊤ hV_top_le h_fw_le
    let SA := CommRingCat.of (TensorProduct R S A)
    obtain ⟨Φ_V, h_snd, h_fst_W⟩ :
        ∃ (Φ_V : Spec SA ≅ (V : Scheme.{u})),
          Φ_V.hom ≫ V.ι ≫ snd_S =
            Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ∧
          Φ_V.hom ≫ fst_W =
            Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom) ≫
              eW_iso.hom := by
      let i₁ : Spec SA ≅
          Limits.pullback η_S (Spec.map (CommRingCat.ofHom (algebraMap R A))) :=
        (pullbackSpecIso R S A).symm
      let i₂ : Limits.pullback η_S (Spec.map (CommRingCat.ofHom (algebraMap R A))) ≅
          Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R A))) η_S :=
        Limits.pullbackSymmetry η_S (Spec.map (CommRingCat.ofHom (algebraMap R A)))
      let i₃ : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R A))) η_S ≅
          Limits.pullback (j_A ≫ g_T) η_S :=
        Limits.pullback.congrHom hj_base.symm rfl
      let i₄ : Limits.pullback (j_A ≫ g_T) η_S ≅
          Limits.pullback j_A fst_S :=
        (Limits.pullbackRightPullbackFstIso g_T η_S j_A).symm
      let i₅ : Limits.pullback j_A fst_S ≅
          Limits.pullback fst_S j_A :=
        Limits.pullbackSymmetry j_A fst_S
      let i₆ : Limits.pullback fst_S j_A ≅
          Limits.pullback fst_S W.ι :=
        { hom := Limits.pullback.lift (Limits.pullback.fst _ _)
            (Limits.pullback.snd _ _ ≫ eW_iso.hom)
            (by rw [Category.assoc]; exact Limits.pullback.condition)
          inv := Limits.pullback.lift (Limits.pullback.fst _ _)
            (Limits.pullback.snd _ _ ≫ eW_iso.inv)
            (by rw [Limits.pullback.condition]; dsimp [j_A]; rw [Category.assoc, Iso.inv_hom_id_assoc])
          hom_inv_id := by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
                Category.id_comp]
            · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
                Category.assoc, Iso.hom_inv_id, Category.comp_id, Category.id_comp]
          inv_hom_id := by
            apply Limits.pullback.hom_ext
            · rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst,
                Category.id_comp]
            · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
                Category.assoc, Iso.inv_hom_id, Category.comp_id, Category.id_comp] }
      let i₇ : Limits.pullback fst_S W.ι ≅ (V : Scheme.{u}) :=
        pullbackRestrictIsoRestrict fst_S W
      let Φ_V : Spec SA ≅ (V : Scheme.{u}) :=
        i₁ ≪≫ i₂ ≪≫ i₃ ≪≫ i₄ ≪≫ i₅ ≪≫ i₆ ≪≫ i₇
      have hi₃_fst : i₃.hom ≫ Limits.pullback.fst (j_A ≫ g_T) η_S =
          Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap R A))) η_S := by
        dsimp [i₃]
        rw [Limits.pullback.congrHom_hom, Limits.pullback.lift_fst, Category.comp_id]
      have hi₃_snd : i₃.hom ≫ Limits.pullback.snd (j_A ≫ g_T) η_S =
          Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap R A))) η_S := by
        dsimp [i₃]
        rw [Limits.pullback.congrHom_hom, Limits.pullback.lift_snd, Category.comp_id]
      refine ⟨Φ_V, ?_, ?_⟩
      · have hΦ_ι : Φ_V.hom ≫ V.ι =
            i₁.hom ≫ i₂.hom ≫ i₃.hom ≫ i₄.hom ≫ Limits.pullback.snd j_A fst_S := by
          dsimp [Φ_V, i₇, i₆, i₅]
          simp only [Category.assoc]
          rw [pullbackRestrictIsoRestrict_hom_ι, Limits.pullback.lift_fst,
            Limits.pullbackSymmetry_hom_comp_fst]
        rw [← Category.assoc, hΦ_ι]
        dsimp only [i₄, i₂, i₁, Iso.symm_hom]
        simp only [Category.assoc]
        rw [Limits.pullbackRightPullbackFstIso_inv_snd_snd, hi₃_snd,
          Limits.pullbackSymmetry_hom_comp_snd, pullbackSpecIso_inv_fst]
      · dsimp only [Φ_V, fst_W, i₇, i₆, i₅, i₄, i₂, i₁, Iso.trans_hom, Iso.symm_hom]
        simp only [Category.assoc]
        rw [Iso.hom_inv_id_assoc, Limits.pullback.lift_snd,
          Limits.pullbackSymmetry_hom_comp_snd_assoc,
          Limits.pullbackRightPullbackFstIso_inv_fst_assoc,
          reassoc_of% hi₃_fst, Limits.pullbackSymmetry_hom_comp_fst_assoc,
          pullbackSpecIso_inv_snd_assoc]
        rfl
    let E_W : SA ≅ T_S.presheaf.obj (Opposite.op V) :=
      { hom := (Scheme.ΓSpecIso SA).inv ≫ Φ_V.inv.appTop ≫ V.topIso.hom
        inv := V.topIso.inv ≫ Φ_V.hom.appTop ≫ (Scheme.ΓSpecIso SA).hom
        hom_inv_id := by
          simp only [Category.assoc]
          rw [Iso.hom_inv_id_assoc]
          have h1 : Φ_V.inv.appTop ≫ Φ_V.hom.appTop = 𝟙 _ := by
            rw [← Scheme.Hom.comp_appTop, Φ_V.hom_inv_id, Scheme.Hom.id_appTop]
          rw [reassoc_of% h1, Iso.inv_hom_id]
        inv_hom_id := by
          simp only [Category.assoc]
          have h1 : (Scheme.ΓSpecIso SA).hom ≫ (Scheme.ΓSpecIso SA).inv = 𝟙 _ :=
            (Scheme.ΓSpecIso SA).hom_inv_id
          rw [reassoc_of% h1]
          have h2 : Φ_V.hom.appTop ≫ Φ_V.inv.appTop = 𝟙 _ := by
            rw [← Scheme.Hom.comp_appTop, Φ_V.inv_hom_id, Scheme.Hom.id_appTop]
          rw [reassoc_of% h2, V.topIso.inv_hom_id] }
    let e_WS : TensorProduct R S A ≃+* ↑(T_S.presheaf.obj (Opposite.op V)) :=
      E_W.commRingCatIsoToRingEquiv
    refine ⟨e_WS, fun s a => ?_⟩
    apply e_WS.symm.injective
    rw [e_WS.symm_apply_apply, map_mul]
    have hy₁ : e_WS.symm
        (((Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫ snd_S.appLE ⊤ V le_top).hom s) =
        Algebra.TensorProduct.includeLeftRingHom s := by
      change (((Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫ snd_S.appLE ⊤ V le_top) ≫ E_W.inv).hom s = _
      have hmor : ((Scheme.ΓSpecIso (CommRingCat.of S)).inv ≫ snd_S.appLE ⊤ V le_top) ≫ E_W.inv =
          CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom := by
        dsimp only [E_W]
        rw [← hι_top V hV_top_le]
        simp only [Category.assoc]
        have hc1 : snd_S.appLE ⊤ V le_top ≫ V.ι.appLE V ⊤ hV_top_le =
            (V.ι ≫ snd_S).appLE ⊤ ⊤ le_top :=
          Scheme.Hom.appLE_comp_appLE V.ι snd_S ⊤ V ⊤ le_top hV_top_le
        rw [reassoc_of% hc1, happTop_eq Φ_V.hom le_top]
        have hc2 : (V.ι ≫ snd_S).appLE ⊤ ⊤ le_top ≫ Φ_V.hom.appLE ⊤ ⊤ le_top =
            (Φ_V.hom ≫ V.ι ≫ snd_S).appTop :=
          (Scheme.Hom.appLE_comp_appLE Φ_V.hom (V.ι ≫ snd_S) ⊤ ⊤ ⊤ le_top le_top).trans
            (happTop_eq (Φ_V.hom ≫ V.ι ≫ snd_S) le_top).symm
        rw [reassoc_of% hc2, h_snd, hΓ_nat]
      rw [hmor]
      rfl
    have hy₂ : e_WS.symm ((fst_S.appLE W V (le_refl _)).hom (eU a)) =
        Algebra.TensorProduct.includeRight a := by
      change (fst_S.appLE W V (le_refl _) ≫ E_W.inv).hom (eU a) = _
      have hmor : fst_S.appLE W V (le_refl _) ≫ E_W.inv =
          eA_iso.inv ≫ CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom := by
        dsimp only [E_W]
        rw [← Category.assoc, hfst_W_appTop, Category.assoc,
          ← Scheme.Hom.comp_appTop_assoc, h_fst_W, Scheme.Hom.comp_appTop_assoc,
          ← Category.assoc, heW_appTop, Category.assoc, hΓ_nat]
      rw [hmor]
      exact congrArg Algebra.TensorProduct.includeRight (eU.symm_apply_apply a)
    rw [hy₁, hy₂]
    simp [Algebra.TensorProduct.includeLeftRingHom, Algebra.TensorProduct.includeRight]

  
  have h_flat_eq : ∀ (S : Type u) [CommRing S] [Algebra R S] [Module.Flat R S]
      (ι : Type u) [Fintype ι]
      (C : ι → Type u) [∀ i, CommRing (C i)] [∀ i, Algebra R (C i)]
      (D : ι × ι → Type u) [∀ p, CommRing (D p)] [∀ p, Algebra R (D p)]
      (resB : B →ₐ[R] ((i : ι) → C i))
      (d₁ : ∀ p : ι × ι, C p.1 →ₐ[R] D p)
      (d₂ : ∀ p : ι × ι, C p.2 →ₐ[R] D p)
      (hInjB : Function.Injective resB)
      (hEqB : ∀ f : (i : ι) → C i,
        (∀ p : ι × ι, d₁ p (f p.1) = d₂ p (f p.2)) ↔ ∃ b : B, resB b = f)
      (B' : Type u) [CommRing B']
      (C' : ι → Type u) [∀ i, CommRing (C' i)]
      (D' : ι × ι → Type u) [∀ p, CommRing (D' p)]
      (resB' : B' →+* ((i : ι) → C' i))
      (r₁ : ∀ p : ι × ι, C' p.1 →+* D' p)
      (r₂ : ∀ p : ι × ι, C' p.2 →+* D' p)
      (hInjB' : Function.Injective resB')
      (hEqB' : ∀ g : (i : ι) → C' i,
        (∀ p : ι × ι, r₁ p (g p.1) = r₂ p (g p.2)) ↔ ∃ y : B', resB' y = g)
      (eC : ∀ i : ι, TensorProduct R S (C i) ≃+* C' i)
      (eD : ∀ p : ι × ι, TensorProduct R S (D p) ≃+* D' p)
      (hComp₁ : ∀ (p : ι × ι) (x : TensorProduct R S (C p.1)),
        r₁ p (eC p.1 x) = eD p (Algebra.TensorProduct.map (AlgHom.id R S) (d₁ p) x))
      (hComp₂ : ∀ (p : ι × ι) (x : TensorProduct R S (C p.2)),
        r₂ p (eC p.2 x) = eD p (Algebra.TensorProduct.map (AlgHom.id R S) (d₂ p) x)),
      ∃ (e_glob : TensorProduct R S B ≃+* B'),
        ∀ (s : S) (b : B) (i : ι),
          resB' (e_glob (TensorProduct.tmul R s b)) i =
            eC i (TensorProduct.tmul R s (resB b i)) := by
    intro S _ _ _ ι _ C _ _ D _ _ resB d₁ d₂ hInjB hEqB B' _ C' _ D' _ resB' r₁ r₂
      hInjB' hEqB' eC eD hComp₁ hComp₂
    let D₁ : ((i : ι) → C i) →ₐ[R] ((p : ι × ι) → D p) :=
      AlgHom.pi (fun p => (d₁ p).comp (Pi.evalAlgHom R C p.1))
    let D₂ : ((i : ι) → C i) →ₐ[R] ((p : ι × ι) → D p) :=
      AlgHom.pi (fun p => (d₂ p).comp (Pi.evalAlgHom R C p.2))
    let resB_sub : B →ₐ[R] ↥(D₁.equalizer D₂) :=
      { toFun := fun b => ⟨resB b, by
          rw [AlgHom.mem_equalizer]
          funext p
          exact (hEqB (resB b)).mpr ⟨b, rfl⟩ p⟩
        map_one' := Subtype.ext (map_one resB)
        map_mul' := fun x y => Subtype.ext (map_mul resB x y)
        map_zero' := Subtype.ext (map_zero resB)
        map_add' := fun x y => Subtype.ext (map_add resB x y)
        commutes' := fun r => Subtype.ext (resB.commutes r) }
    have hBijB : Function.Bijective resB_sub := by
      refine ⟨fun x y hxy => hInjB (congrArg Subtype.val hxy), fun ⟨f, hf⟩ => ?_⟩
      rw [AlgHom.mem_equalizer] at hf
      obtain ⟨b, hb⟩ := (hEqB f).mp (fun p => congrFun hf p)
      exact ⟨b, Subtype.ext hb⟩
    let ε_B : B ≃ₐ[R] ↥(D₁.equalizer D₂) := AlgEquiv.ofBijective resB_sub hBijB
    let E₀ : TensorProduct R S B ≃ₐ[R] TensorProduct R S ↥(D₁.equalizer D₂) :=
      Algebra.TensorProduct.congr (AlgEquiv.refl : S ≃ₐ[R] S) ε_B
    let M₁ := Algebra.TensorProduct.map (AlgHom.id R S) D₁
    let M₂ := Algebra.TensorProduct.map (AlgHom.id R S) D₂
    let E_eq : TensorProduct R S ↥(D₁.equalizer D₂) ≃ₐ[R] ↥(M₁.equalizer M₂) :=
      AlgHom.tensorEqualizerEquiv R S D₁ D₂
    let EC : TensorProduct R S ((i : ι) → C i) ≃+* ((i : ι) → C' i) :=
      (Algebra.TensorProduct.piRight R R S C).toRingEquiv.trans (RingEquiv.piCongrRight eC)
    let ED : TensorProduct R S ((p : ι × ι) → D p) ≃+* ((p : ι × ι) → D' p) :=
      (Algebra.TensorProduct.piRight R R S D).toRingEquiv.trans (RingEquiv.piCongrRight eD)
    have hED₁ : ∀ z : TensorProduct R S ((i : ι) → C i),
        ED (M₁ z) = fun p => r₁ p (EC z p.1) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => funext p; simp
      | tmul s f =>
        funext p
        dsimp [M₁, EC, ED, D₁]
        simp only [RingEquiv.piCongrRight_apply, AlgHom.pi_apply, AlgHom.comp_apply,
          Pi.evalAlgHom_apply]
        rw [hComp₁ p (TensorProduct.tmul R s (f p.1))]
        simp
      | add x y ihx ihy =>
        funext p
        simp only [map_add, Pi.add_apply, ihx, ihy]
    have hED₂ : ∀ z : TensorProduct R S ((i : ι) → C i),
        ED (M₂ z) = fun p => r₂ p (EC z p.2) := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => funext p; simp
      | tmul s f =>
        funext p
        dsimp [M₂, EC, ED, D₂]
        simp only [RingEquiv.piCongrRight_apply, AlgHom.pi_apply, AlgHom.comp_apply,
          Pi.evalAlgHom_apply]
        rw [hComp₂ p (TensorProduct.tmul R s (f p.2))]
        simp
      | add x y ihx ihy =>
        funext p
        simp only [map_add, Pi.add_apply, ihx, ihy]
    let S_B' : Subring ((i : ι) → C' i) :=
      { carrier := { g | ∀ p : ι × ι, r₁ p (g p.1) = r₂ p (g p.2) }
        one_mem' := fun p => by simp
        mul_mem' := fun {a b} ha hb p => by simp [ha p, hb p]
        zero_mem' := fun p => by simp
        add_mem' := fun {a b} ha hb p => by simp [ha p, hb p]
        neg_mem' := fun {a} ha p => by simp [ha p] }
    have hMemEquiv : ∀ z : TensorProduct R S ((i : ι) → C i),
        z ∈ M₁.equalizer M₂ ↔ EC z ∈ S_B' := by
      intro z
      rw [AlgHom.mem_equalizer, ← ED.injective.eq_iff, hED₁, hED₂, funext_iff]
      rfl
    let EC_sub : ↥(M₁.equalizer M₂) ≃+* ↥S_B' :=
      { toFun := fun z => ⟨EC z.1, (hMemEquiv z.1).mp z.2⟩
        invFun := fun g => ⟨EC.symm g.1, (hMemEquiv (EC.symm g.1)).mpr (by simp [g.2])⟩
        left_inv := fun z => Subtype.ext (EC.symm_apply_apply z.1)
        right_inv := fun g => Subtype.ext (EC.apply_symm_apply g.1)
        map_mul' := fun x y => Subtype.ext (map_mul EC x.1 y.1)
        map_add' := fun x y => Subtype.ext (map_add EC x.1 y.1) }
    let resB'_sub : B' →+* ↥S_B' :=
      { toFun := fun y => ⟨resB' y, (hEqB' (resB' y)).mpr ⟨y, rfl⟩⟩
        map_one' := Subtype.ext (map_one resB')
        map_mul' := fun x y => Subtype.ext (map_mul resB' x y)
        map_zero' := Subtype.ext (map_zero resB')
        map_add' := fun x y => Subtype.ext (map_add resB' x y) }
    have hBijB' : Function.Bijective resB'_sub := by
      refine ⟨fun x y hxy => hInjB' (congrArg Subtype.val hxy), fun ⟨g, hg⟩ => ?_⟩
      obtain ⟨y, hy⟩ := (hEqB' g).mp hg
      exact ⟨y, Subtype.ext hy⟩
    let ε_B' : B' ≃+* ↥S_B' := RingEquiv.ofBijective resB'_sub hBijB'
    let e_glob : TensorProduct R S B ≃+* B' :=
      E₀.toRingEquiv.trans (E_eq.toRingEquiv.trans (EC_sub.trans ε_B'.symm))
    refine ⟨e_glob, fun s b i => ?_⟩
    have hco : resB' (e_glob (TensorProduct.tmul R s b)) =
        (EC_sub (E_eq (E₀ (TensorProduct.tmul R s b)))).1 :=
      congrArg Subtype.val
        (ε_B'.apply_symm_apply (EC_sub (E_eq (E₀ (TensorProduct.tmul R s b)))))
    rw [hco]
    have hE₀_val : E₀ (TensorProduct.tmul R s b) = TensorProduct.tmul R s (ε_B b) := rfl
    have hEeq_val : (E_eq (TensorProduct.tmul R s (ε_B b))).1 =
        TensorProduct.tmul R s (resB b) := by
      change ((AlgHom.tensorEqualizer R S D₁ D₂) (TensorProduct.tmul R s (ε_B b))).1 = _
      rw [AlgHom.coe_tensorEqualizer]
      rfl
    change EC (E_eq (E₀ (TensorProduct.tmul R s b))).1 i = _
    rw [hE₀_val, hEeq_val]
    dsimp [EC]
    simp

  
  have h_dvr_red : ∀ (ι : Type u) [Fintype ι]
      (C : ι → Type u) [∀ i, CommRing (C i)] [∀ i, Algebra R (C i)]
      (ρ : ∀ i : ι, B →ₐ[R] C i)
      (hDiv : ∀ (ϖ : R), Irreducible ϖ → ∀ (b : B),
        (∀ i : ι, ∃ c : C i, ρ i b = ϖ • c) → ∃ c : B, b = ϖ • c)
      (hRedC : ∀ i : ι,
        IsReduced (TensorProduct R (AlgebraicClosure (IsLocalRing.ResidueField R)) (C i))),
      IsReduced (TensorProduct R (AlgebraicClosure (IsLocalRing.ResidueField R)) B) := by
    intro ι _ C _ _ ρ hDiv hRedC
    obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
    have hmax : IsLocalRing.maximalIdeal R = Ideal.span {ϖ} :=
      (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
    let κ := IsLocalRing.ResidueField R
    let kbar := AlgebraicClosure κ
    have h_ker_tmul : ∀ {M : Type u} [AddCommGroup M] [Module R M] (m : M),
        TensorProduct.tmul R (1 : κ) m = 0 → ∃ m' : M, m = ϖ • m' := by
      intro M _ _ m hm0
      let P_M : Submodule R M := LinearMap.range (LinearMap.lsmul R M ϖ)
      let f₀ : R →ₗ[R] (M →ₗ[R] (M ⧸ P_M)) :=
        { toFun := fun r => (Submodule.mkQ P_M).comp (LinearMap.lsmul R M r)
          map_add' := fun r₁ r₂ => by ext x; simp
          map_smul' := fun r₁ r₂ => by ext x; simp [mul_smul] }
      have hf₀_ker : (IsLocalRing.maximalIdeal R : Submodule R R) ≤ LinearMap.ker f₀ := by
        intro r hr
        change r ∈ IsLocalRing.maximalIdeal R at hr
        rw [hmax, Ideal.mem_span_singleton] at hr
        obtain ⟨u, rfl⟩ := hr
        rw [LinearMap.mem_ker]
        ext x
        change Submodule.Quotient.mk ((ϖ * u) • x) = (0 : M ⧸ P_M)
        rw [Submodule.Quotient.mk_eq_zero]
        exact ⟨u • x, by rw [LinearMap.lsmul_apply, mul_smul, smul_comm]⟩
      let f_κ : κ →ₗ[R] (M →ₗ[R] (M ⧸ P_M)) :=
        Submodule.liftQ (IsLocalRing.maximalIdeal R) f₀ hf₀_ker
      let Λ_M : TensorProduct R κ M →ₗ[R] (M ⧸ P_M) := TensorProduct.lift f_κ
      have hΛ := congrArg Λ_M hm0
      rw [map_zero] at hΛ
      have h1 : Λ_M (TensorProduct.tmul R (1 : κ) m) = Submodule.Quotient.mk m := by
        dsimp only [Λ_M, f_κ, κ]
        erw [TensorProduct.lift.tmul, Submodule.liftQ_apply]
        change Submodule.Quotient.mk ((1 : R) • m) = Submodule.Quotient.mk m
        rw [one_smul]
      rw [h1, Submodule.Quotient.mk_eq_zero] at hΛ
      obtain ⟨m', hm'⟩ := hΛ
      exact ⟨m', hm'.symm⟩
    have h_surj_one : ∀ z : TensorProduct R κ B, ∃ b : B, z = TensorProduct.tmul R (1 : κ) b := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨0, (TensorProduct.tmul_zero B (1 : κ)).symm⟩
      | tmul x b =>
        obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective (R := R) x
        refine ⟨r • b, ?_⟩
        rw [TensorProduct.tmul_smul]
        congr 1
        change IsLocalRing.residue R r = r • (1 : κ)
        rw [Algebra.smul_def, mul_one]
        rfl
      | add z₁ z₂ ih₁ ih₂ =>
        obtain ⟨b₁, rfl⟩ := ih₁
        obtain ⟨b₂, rfl⟩ := ih₂
        exact ⟨b₁ + b₂, (TensorProduct.tmul_add (1 : κ) b₁ b₂).symm⟩
    let φ_i : ∀ i : ι, TensorProduct R κ B →ₗ[κ] TensorProduct R κ (C i) := fun i =>
      { toFun := Algebra.TensorProduct.map (AlgHom.id R κ) (ρ i)
        map_add' := map_add _
        map_smul' := fun x z => by
          dsimp
          induction z using TensorProduct.induction_on with
          | zero => simp
          | tmul y b => simp [TensorProduct.smul_tmul']
          | add u v ihu ihv => simp [smul_add, map_add, ihu, ihv] }
    let Φ₀ : TensorProduct R κ B →ₗ[κ] ((i : ι) → TensorProduct R κ (C i)) :=
      LinearMap.pi φ_i
    have hInjΦ₀ : Function.Injective Φ₀ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨b, rfl⟩ := h_surj_one z
      have hloc : ∀ i : ι, ∃ c : C i, ρ i b = ϖ • c := by
        intro i
        have hi : TensorProduct.tmul R (1 : κ) (ρ i b) = 0 := congrFun hz i
        exact h_ker_tmul (ρ i b) hi
      obtain ⟨c, rfl⟩ := hDiv ϖ hϖ b hloc
      have hϖ_res : algebraMap R κ ϖ = 0 := by
        change IsLocalRing.residue R ϖ = 0
        rw [← RingHom.mem_ker, IsLocalRing.ker_residue, hmax]
        exact Ideal.mem_span_singleton_self ϖ
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, mul_one, hϖ_res, TensorProduct.zero_tmul]
    have hInj_lT : Function.Injective (LinearMap.lTensor kbar Φ₀) :=
      Module.Flat.lTensor_preserves_injective_linearMap Φ₀ hInjΦ₀
    let Ψ : TensorProduct R kbar B →+* ((i : ι) → TensorProduct R kbar (C i)) :=
      RingHom.pi (fun i => (Algebra.TensorProduct.map (AlgHom.id R kbar) (ρ i)).toRingHom)
    let cB : TensorProduct κ kbar (TensorProduct R κ B) ≃ₐ[κ] TensorProduct R kbar B :=
      Algebra.TensorProduct.cancelBaseChange R κ κ kbar B
    let pC : TensorProduct κ kbar ((i : ι) → TensorProduct R κ (C i)) ≃ₐ[κ]
        ((i : ι) → TensorProduct κ kbar (TensorProduct R κ (C i))) :=
      Algebra.TensorProduct.piRight κ κ kbar (fun i => TensorProduct R κ (C i))
    let cC : ∀ i : ι,
        TensorProduct κ kbar (TensorProduct R κ (C i)) ≃ₐ[κ] TensorProduct R kbar (C i) :=
      fun i => Algebra.TensorProduct.cancelBaseChange R κ κ kbar (C i)
    have hComm : ∀ (u : TensorProduct κ kbar (TensorProduct R κ B)) (i : ι),
        Ψ (cB u) i = cC i (pC (LinearMap.lTensor kbar Φ₀ u) i) := by
      intro u i
      let lhs : TensorProduct κ kbar (TensorProduct R κ B) →+ TensorProduct R kbar (C i) :=
        ((Pi.evalRingHom (fun j => TensorProduct R kbar (C j)) i).comp
          (Ψ.comp cB.toRingEquiv.toRingHom)).toAddMonoidHom
      let rhs : TensorProduct κ kbar (TensorProduct R κ B) →+ TensorProduct R kbar (C i) :=
        (cC i).toLinearMap.toAddMonoidHom.comp
          (((LinearMap.proj i).comp (pC.toLinearMap.comp (LinearMap.lTensor kbar Φ₀))).toAddMonoidHom)
      change lhs u = rhs u
      induction u using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul w z =>
        induction z using TensorProduct.induction_on with
        | zero => simp only [TensorProduct.tmul_zero, map_zero]
        | tmul x b =>
          change Ψ (cB (TensorProduct.tmul κ w (TensorProduct.tmul R x b))) i =
            cC i (pC (LinearMap.lTensor kbar Φ₀
              (TensorProduct.tmul κ w (TensorProduct.tmul R x b))) i)
          dsimp only [cB]
          rw [Algebra.TensorProduct.cancelBaseChange_tmul, LinearMap.lTensor_tmul]
          dsimp only [Ψ, pC, cC, Φ₀, φ_i]
          rw [RingHom.pi_apply, Algebra.TensorProduct.piRight_tmul]
          change (Algebra.TensorProduct.map (AlgHom.id R kbar) (ρ i))
              (TensorProduct.tmul R (x • w) b) =
            (Algebra.TensorProduct.cancelBaseChange R κ κ kbar (C i))
              (TensorProduct.tmul κ w
                ((Algebra.TensorProduct.map (AlgHom.id R κ) (ρ i)) (TensorProduct.tmul R x b)))
          rw [Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.map_tmul,
            AlgHom.id_apply, AlgHom.id_apply, Algebra.TensorProduct.cancelBaseChange_tmul]
        | add z₁ z₂ ih₁ ih₂ =>
          rw [TensorProduct.tmul_add, map_add, map_add, ih₁, ih₂]
      | add u₁ u₂ ih₁ ih₂ =>
        rw [map_add, map_add, ih₁, ih₂]
    have hInjΨ : Function.Injective Ψ := by
      intro x₁ x₂ hx
      apply cB.symm.injective
      apply hInj_lT
      apply pC.injective
      funext i
      apply (cC i).injective
      rw [← hComm (cB.symm x₁) i, ← hComm (cB.symm x₂) i,
        cB.apply_symm_apply, cB.apply_symm_apply, hx]
    refine ⟨fun x ⟨n, hn⟩ => hInjΨ ?_⟩
    rw [map_zero]
    funext i
    have hpow : (Ψ x i) ^ n = 0 := by
      rw [← Pi.pow_apply, ← map_pow, hn, map_zero, Pi.zero_apply]
    exact IsNilpotent.eq_zero ⟨n, hpow⟩

  
  have : CompactSpace ↥(AlgebraicGeometry.Spec (CommRingCat.of R)) :=
    AlgebraicGeometry.Scheme.compactSpace_of_isAffine _
  have : CompactSpace ↥T :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace g_T
  have : T.IsSeparated :=
    (@AlgebraicGeometry.HasAffineProperty.iff_of_isAffine
      @AlgebraicGeometry.IsSeparated _ AlgebraicGeometry.IsSeparated.hasAffineProperty
      _ _ g_T inferInstance).mp inferInstance
  have hBasis : ∀ x : ↥T, ∃ U₀ : T.Opens, AlgebraicGeometry.IsAffineOpen U₀ ∧ x ∈ U₀ := by
    intro x
    obtain ⟨U₀, hU₀_aff, hxU₀, _⟩ :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (AlgebraicGeometry.Scheme.isBasis_affineOpens T)
        (show x ∈ (⊤ : T.Opens) by trivial)
    exact ⟨U₀, hU₀_aff, hxU₀⟩
  choose U₀ hU₀_aff hxU₀ using hBasis
  obtain ⟨t, ht_cov⟩ := CompactSpace.elim_nhds_subcover (fun x : ↥T => (U₀ x : Set ↥T))
    (fun x => (U₀ x).isOpen.mem_nhds (hxU₀ x))
  let ι : Type u := ↥t
  let U : ι → T.Opens := fun i => U₀ i.1
  have hU_aff : ∀ i : ι, AlgebraicGeometry.IsAffineOpen (U i) := fun i => hU₀_aff i.1
  have hU_inf : ∀ i j : ι, AlgebraicGeometry.IsAffineOpen (U i ⊓ U j) :=
    fun i j => (hU_aff i).inf (hU_aff j)
  have hU_cov : (⨆ i : ι, U i) = ⊤ := by
    apply eq_top_iff.mpr
    intro x _
    have hx_univ : x ∈ (⋃ y ∈ t, (U₀ y : Set ↥T)) := by
      rw [ht_cov]
      trivial
    rw [Set.mem_iUnion₂] at hx_univ
    obtain ⟨y, hyt, hxy⟩ := hx_univ
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hyt⟩, hxy⟩

  let _ : ∀ W : T.Opens, Algebra R ↑(T.presheaf.obj (Opposite.op W)) := fun W =>
    (((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ g_T.appLE ⊤ W le_top).hom).toAlgebra
  let C : ι → Type u := fun i => ↑(T.presheaf.obj (Opposite.op (U i)))
  let D : ι × ι → Type u := fun p => ↑(T.presheaf.obj (Opposite.op (U p.1 ⊓ U p.2)))

  have happTop_map : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (W : X.Opens),
      f.appTop ≫ X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op = f.appLE ⊤ W le_top := by
    intro X Y f W
    simp only [Scheme.Hom.appTop, Scheme.Hom.appLE]
    rfl

  let resB_i : ∀ i : ι, B →ₐ[R] C i := fun i =>
    { toRingHom := (T.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp eB.toRingHom
      commutes' := fun r => by
        change (T.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom (eB (algebraMap R B r)) =
          ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ g_T.appLE ⊤ (U i) le_top).hom r
        rw [heB r]
        have hmor : ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ g_T.appTop) ≫
            T.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op =
            (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ g_T.appLE ⊤ (U i) le_top := by
          rw [Category.assoc, happTop_map g_T (U i)]
        exact congrArg (fun φ => φ.hom r) hmor }
  let resB : B →ₐ[R] ((i : ι) → C i) := AlgHom.pi resB_i
  let d₁ : ∀ p : ι × ι, C p.1 →ₐ[R] D p := fun p =>
    { toRingHom :=
        (T.presheaf.map (TopologicalSpace.Opens.infLELeft (U p.1) (U p.2)).op).hom
      commutes' := fun r => by
        have hmor := Scheme.Hom.appLE_map g_T (U := ⊤) (V := U p.1) le_top
          (TopologicalSpace.Opens.infLELeft (U p.1) (U p.2)).op
        exact congrArg (fun φ => ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ φ).hom r) hmor }
  let d₂ : ∀ p : ι × ι, C p.2 →ₐ[R] D p := fun p =>
    { toRingHom :=
        (T.presheaf.map (TopologicalSpace.Opens.infLERight (U p.1) (U p.2)).op).hom
      commutes' := fun r => by
        have hmor := Scheme.Hom.appLE_map g_T (U := ⊤) (V := U p.2) le_top
          (TopologicalSpace.Opens.infLERight (U p.1) (U p.2)).op
        exact congrArg (fun φ => ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ φ).hom r) hmor }

  have hRes_compat : ∀ {X : Scheme.{u}} {I₀ : Type u} (W : I₀ → X.Opens)
      (s : ↑(X.presheaf.obj (Opposite.op ⊤))) (i j : I₀),
      (X.presheaf.map (TopologicalSpace.Opens.infLELeft (W i) (W j)).op).hom
        ((X.presheaf.map (homOfLE (le_top : W i ≤ ⊤)).op).hom s) =
      (X.presheaf.map (TopologicalSpace.Opens.infLERight (W i) (W j)).op).hom
        ((X.presheaf.map (homOfLE (le_top : W j ≤ ⊤)).op).hom s) := by
    intro X I₀ W s i j
    change ((X.presheaf.map (homOfLE (le_top : W i ≤ ⊤)).op ≫
        X.presheaf.map (TopologicalSpace.Opens.infLELeft (W i) (W j)).op).hom) s =
      ((X.presheaf.map (homOfLE (le_top : W j ≤ ⊤)).op ≫
        X.presheaf.map (TopologicalSpace.Opens.infLERight (W i) (W j)).op).hom) s
    rw [← X.presheaf.map_comp, ← X.presheaf.map_comp]
    congr 3

  have hEqB : ∀ f : (i : ι) → C i,
      (∀ p : ι × ι, d₁ p (f p.1) = d₂ p (f p.2)) ↔ ∃ b : B, resB b = f := by
    intro f
    constructor
    · intro hf
      have hc : TopCat.Presheaf.IsCompatible T.presheaf U f := fun i j => hf (i, j)
      obtain ⟨s, hs, _⟩ := T.sheaf.existsUnique_gluing' U ⊤
        (fun i => homOfLE le_top) (le_of_eq hU_cov.symm) f hc
      let s₀ : ↑(T.presheaf.obj (Opposite.op ⊤)) := s
      refine ⟨eB.symm s₀, funext fun i => ?_⟩
      change (T.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom (eB (eB.symm s₀)) = f i
      rw [eB.apply_symm_apply]
      exact hs i
    · rintro ⟨b, rfl⟩ ⟨i, j⟩
      exact hRes_compat U (eB b) i j

  have hInjB : Function.Injective resB := by
    intro b₁ b₂ hb
    let sf : (i : ι) → C i := resB b₁
    have hc : TopCat.Presheaf.IsCompatible T.presheaf U sf :=
      fun i j => hRes_compat U (eB b₁) i j
    obtain ⟨s, _, hs_uniq⟩ := T.sheaf.existsUnique_gluing' U ⊤
      (fun i => homOfLE le_top) (le_of_eq hU_cov.symm) sf hc
    have h₁ : eB b₁ = s := hs_uniq (eB b₁) (fun _ => rfl)
    have h₂ : eB b₂ = s := hs_uniq (eB b₂) (fun i => (congrFun hb i).symm)
    exact eB.injective (h₁.trans h₂.symm)

  constructor
  · 
    have : Module.Flat R Ω_R := by
      let K_R := FractionRing R
      let ψ_K : K_R →+* Ω_R := IsFractionRing.lift hInjΩ
      let _ : Algebra K_R Ω_R := ψ_K.toAlgebra
      have : IsScalarTower R K_R Ω_R :=
        IsScalarTower.of_algebraMap_eq (fun r => (IsFractionRing.lift_algebraMap hInjΩ r).symm)
      have : Module.Flat R K_R := IsLocalization.flat (S := K_R) (nonZeroDivisors R)
      exact Module.Flat.trans R K_R Ω_R

    let η_Ω := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R Ω_R))
    let T_Ω := CategoryTheory.Limits.pullback g_T η_Ω
    let fst := CategoryTheory.Limits.pullback.fst g_T η_Ω
    let snd := CategoryTheory.Limits.pullback.snd g_T η_Ω
    let V : ι → T_Ω.Opens := fun i => (TopologicalSpace.Opens.map fst.base).obj (U i)
    have hV_cov : (⨆ i : ι, V i) = ⊤ := by
      apply eq_top_iff.mpr
      intro z _
      have hz : fst.base z ∈ (⨆ i : ι, U i) := by
        rw [hU_cov]
        trivial
      obtain ⟨i, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hi⟩

    let B' : Type u := ↑(T_Ω.presheaf.obj (Opposite.op ⊤))
    let C' : ι → Type u := fun i => ↑(T_Ω.presheaf.obj (Opposite.op (V i)))
    let D' : ι × ι → Type u := fun p => ↑(T_Ω.presheaf.obj (Opposite.op (V p.1 ⊓ V p.2)))
    let resB' : B' →+* ((i : ι) → C' i) :=
      RingHom.pi (fun i => (T_Ω.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom)
    let r₁ : ∀ p : ι × ι, C' p.1 →+* D' p := fun p =>
      (T_Ω.presheaf.map (TopologicalSpace.Opens.infLELeft (V p.1) (V p.2)).op).hom
    let r₂ : ∀ p : ι × ι, C' p.2 →+* D' p := fun p =>
      (T_Ω.presheaf.map (TopologicalSpace.Opens.infLERight (V p.1) (V p.2)).op).hom

    have hEqB' : ∀ g : (i : ι) → C' i,
        (∀ p : ι × ι, r₁ p (g p.1) = r₂ p (g p.2)) ↔ ∃ y : B', resB' y = g := by
      intro g
      constructor
      · intro hg
        have hc : TopCat.Presheaf.IsCompatible T_Ω.presheaf V g := fun i j => hg (i, j)
        obtain ⟨y, hy, _⟩ := T_Ω.sheaf.existsUnique_gluing' V ⊤
          (fun i => homOfLE le_top) (le_of_eq hV_cov.symm) g hc
        exact ⟨y, funext hy⟩
      · rintro ⟨y, rfl⟩ ⟨i, j⟩
        exact hRes_compat V y i j

    have hInjB' : Function.Injective resB' := by
      intro y₁ y₂ hy
      let sg : (i : ι) → C' i := resB' y₁
      have hc : TopCat.Presheaf.IsCompatible T_Ω.presheaf V sg :=
        fun i j => hRes_compat V y₁ i j
      obtain ⟨y, _, hy_uniq⟩ := T_Ω.sheaf.existsUnique_gluing' V ⊤
        (fun i => homOfLE le_top) (le_of_eq hV_cov.symm) sg hc
      exact (hy_uniq y₁ (fun _ => rfl)).trans
        (hy_uniq y₂ (fun i => (congrFun hy i).symm)).symm

    have hex_eC : ∀ i : ι, ∃ (e : TensorProduct R Ω_R (C i) ≃+* C' i),
        ∀ (ω : Ω_R) (c : C i),
          e (TensorProduct.tmul R ω c) =
            ((Scheme.ΓSpecIso (CommRingCat.of Ω_R)).inv ≫ snd.appLE ⊤ (V i) le_top).hom ω *
            (fst.appLE (U i) (V i) (le_refl _)).hom c := by
      intro i
      obtain ⟨e, he⟩ := h_aff_pull Ω_R (U i) (hU_aff i) (C i) (RingEquiv.refl (C i)) (fun _ => rfl)
      exact ⟨e, fun ω c => by simpa only [RingEquiv.refl_apply] using he ω c⟩
    choose eC heC using hex_eC

    have hex_eD : ∀ p : ι × ι, ∃ (e : TensorProduct R Ω_R (D p) ≃+* D' p),
        ∀ (ω : Ω_R) (d : D p),
          e (TensorProduct.tmul R ω d) =
            ((Scheme.ΓSpecIso (CommRingCat.of Ω_R)).inv ≫
              snd.appLE ⊤ (V p.1 ⊓ V p.2) le_top).hom ω *
            (fst.appLE (U p.1 ⊓ U p.2) (V p.1 ⊓ V p.2) (fun _ hz => hz)).hom d := by
      intro p
      have haux : ∀ (O : T_Ω.Opens) (he : O ≤ fst ⁻¹ᵁ (U p.1 ⊓ U p.2)),
          O = (TopologicalSpace.Opens.map fst.base).obj (U p.1 ⊓ U p.2) →
          ∃ (e : TensorProduct R Ω_R (D p) ≃+* ↑(T_Ω.presheaf.obj (Opposite.op O))),
            ∀ (ω : Ω_R) (d : D p),
              e (TensorProduct.tmul R ω d) =
                ((Scheme.ΓSpecIso (CommRingCat.of Ω_R)).inv ≫ snd.appLE ⊤ O le_top).hom ω *
                (fst.appLE (U p.1 ⊓ U p.2) O he).hom d := by
        rintro O he rfl
        obtain ⟨e, h⟩ :=
          h_aff_pull Ω_R (U p.1 ⊓ U p.2) (hU_inf p.1 p.2) (D p) (RingEquiv.refl (D p)) (fun _ => rfl)
        exact ⟨e, fun ω d => by simpa only [RingEquiv.refl_apply] using h ω d⟩
      exact haux (V p.1 ⊓ V p.2) (fun _ hz => hz) (TopologicalSpace.Opens.ext rfl)
    choose eD heD using hex_eD

    have hComp₁ : ∀ (p : ι × ι) (x : TensorProduct R Ω_R (C p.1)),
        r₁ p (eC p.1 x) = eD p (Algebra.TensorProduct.map (AlgHom.id R Ω_R) (d₁ p) x) := by
      intro p x
      let lhs : TensorProduct R Ω_R (C p.1) →+* D' p :=
        (r₁ p).comp (eC p.1).toRingHom
      let rhs : TensorProduct R Ω_R (C p.1) →+* D' p :=
        (eD p).toRingHom.comp (Algebra.TensorProduct.map (AlgHom.id R Ω_R) (d₁ p)).toRingHom
      change lhs x = rhs x
      induction x using TensorProduct.induction_on with
      | zero => rw [RingHom.map_zero, RingHom.map_zero]
      | tmul ω c =>
        change r₁ p (eC p.1 (TensorProduct.tmul R ω c)) =
          eD p ((Algebra.TensorProduct.map (AlgHom.id R Ω_R) (d₁ p)) (TensorProduct.tmul R ω c))
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, heC p.1 ω c, heD p ω (d₁ p c),
          RingHom.map_mul]
        congr 1
        · have hmor := Scheme.Hom.appLE_map snd (U := ⊤) (V := V p.1) le_top
            (TopologicalSpace.Opens.infLELeft (V p.1) (V p.2)).op
          exact congrArg (fun φ => ((Scheme.ΓSpecIso (CommRingCat.of Ω_R)).inv ≫ φ).hom ω) hmor
        · have hmor₁ := Scheme.Hom.appLE_map fst (U := U p.1) (V := V p.1) (le_refl _)
            (TopologicalSpace.Opens.infLELeft (V p.1) (V p.2)).op
          have hmor₂ := Scheme.Hom.map_appLE fst (U := U p.1 ⊓ U p.2) (U' := U p.1)
            (V := V p.1 ⊓ V p.2) (fun _ hz => hz)
            (TopologicalSpace.Opens.infLELeft (U p.1) (U p.2)).op
          exact congrArg (fun φ => φ.hom c) (hmor₁.trans hmor₂.symm)
      | add x₁ x₂ ih₁ ih₂ =>
        rw [RingHom.map_add, RingHom.map_add, ih₁, ih₂]

    have hComp₂ : ∀ (p : ι × ι) (x : TensorProduct R Ω_R (C p.2)),
        r₂ p (eC p.2 x) = eD p (Algebra.TensorProduct.map (AlgHom.id R Ω_R) (d₂ p) x) := by
      intro p x
      let lhs : TensorProduct R Ω_R (C p.2) →+* D' p :=
        (r₂ p).comp (eC p.2).toRingHom
      let rhs : TensorProduct R Ω_R (C p.2) →+* D' p :=
        (eD p).toRingHom.comp (Algebra.TensorProduct.map (AlgHom.id R Ω_R) (d₂ p)).toRingHom
      change lhs x = rhs x
      induction x using TensorProduct.induction_on with
      | zero => rw [RingHom.map_zero, RingHom.map_zero]
      | tmul ω c =>
        change r₂ p (eC p.2 (TensorProduct.tmul R ω c)) =
          eD p ((Algebra.TensorProduct.map (AlgHom.id R Ω_R) (d₂ p)) (TensorProduct.tmul R ω c))
        rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, heC p.2 ω c, heD p ω (d₂ p c),
          RingHom.map_mul]
        congr 1
        · have hmor := Scheme.Hom.appLE_map snd (U := ⊤) (V := V p.2) le_top
            (TopologicalSpace.Opens.infLERight (V p.1) (V p.2)).op
          exact congrArg (fun φ => ((Scheme.ΓSpecIso (CommRingCat.of Ω_R)).inv ≫ φ).hom ω) hmor
        · have hmor₁ := Scheme.Hom.appLE_map fst (U := U p.2) (V := V p.2) (le_refl _)
            (TopologicalSpace.Opens.infLERight (V p.1) (V p.2)).op
          have hmor₂ := Scheme.Hom.map_appLE fst (U := U p.1 ⊓ U p.2) (U' := U p.2)
            (V := V p.1 ⊓ V p.2) (fun _ hz => hz)
            (TopologicalSpace.Opens.infLERight (U p.1) (U p.2)).op
          exact congrArg (fun φ => φ.hom c) (hmor₁.trans hmor₂.symm)
      | add x₁ x₂ ih₁ ih₂ =>
        rw [RingHom.map_add, RingHom.map_add, ih₁, ih₂]

    obtain ⟨e_gen, he_gen_loc⟩ := h_flat_eq Ω_R ι C D resB d₁ d₂ hInjB hEqB
      B' C' D' resB' r₁ r₂ hInjB' hEqB' eC eD hComp₁ hComp₂
    refine ⟨e_gen, fun ω b => hInjB' (funext fun i => ?_)⟩
    rw [he_gen_loc ω b i, heC i ω (resB b i)]
    change _ = (T_Ω.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom
      (((Scheme.ΓSpecIso (CommRingCat.of Ω_R)).inv ≫ snd.appTop).hom ω *
        fst.appTop.hom (eB b))
    rw [map_mul]
    congr 1
    have hmor₁ := Scheme.Hom.map_appLE fst (U := U i) (U' := ⊤) (V := V i) (le_refl _)
      (homOfLE (le_top : U i ≤ ⊤)).op
    have hmor₂ := happTop_map fst (V i)
    exact congrArg (fun φ => φ.hom (eB b)) (hmor₁.trans hmor₂.symm)

  · 
    let κ := IsLocalRing.ResidueField R
    let kbar := AlgebraicClosure κ
    intro hRed_Tkbar
    have hRedC : ∀ i : ι, IsReduced (TensorProduct R kbar (C i)) := by
      intro i
      obtain ⟨e_ki, _⟩ :=
        h_aff_pull kbar (U i) (hU_aff i) (C i) (RingEquiv.refl (C i)) (fun _ => rfl)
      refine ⟨fun x ⟨n, hn⟩ => e_ki.injective ?_⟩
      rw [map_zero]
      have hpow : (e_ki x) ^ n = 0 := by rw [← map_pow, hn, map_zero]
      exact IsNilpotent.eq_zero ⟨n, hpow⟩

    have hBij_invR : Function.Bijective
        ((Scheme.ΓSpecIso (CommRingCat.of R)).inv).hom :=
      (ConcreteCategory.isIso_iff_bijective
        (Scheme.ΓSpecIso (CommRingCat.of R)).inv).mp inferInstance

    have hDiv : ∀ (ϖ : R), Irreducible ϖ → ∀ (b : B),
        (∀ i : ι, ∃ c : C i, resB_i i b = ϖ • c) → ∃ c : B, b = ϖ • c := by
      intro ϖ hϖ b hc
      have hϖ_ne : ϖ ≠ 0 := hϖ.ne_zero
      choose c_loc hc_loc using hc
      have hcomp_c : ∀ p : ι × ι, d₁ p (c_loc p.1) = d₂ p (c_loc p.2) := by
        intro p
        have hFlat_hom : (g_T.appLE ⊤ (U p.1 ⊓ U p.2) le_top).hom.Flat :=
          g_T.flat_appLE (isAffineOpen_top _) (hU_inf p.1 p.2) le_top
        have hFlat_alg : (algebraMap R (D p)).Flat :=
          RingHom.Flat.comp (RingHom.Flat.of_bijective hBij_invR) hFlat_hom
        have : Module.Flat R (D p) := RingHom.flat_algebraMap_iff.mp hFlat_alg
        have hTF : Module.IsTorsionFree R (D p) := Module.Flat.isTorsionFree
        have hsmul0 : ϖ • (d₁ p (c_loc p.1) - d₂ p (c_loc p.2)) = 0 := by
          rw [smul_sub, ← map_smul, ← map_smul, ← hc_loc p.1, ← hc_loc p.2]
          exact sub_eq_zero.mpr ((hEqB (resB b)).mpr ⟨b, rfl⟩ p)
        rcases (Module.isTorsionFree_iff_smul_eq_zero.mp hTF) ϖ _ hsmul0 with h0 | hsub0
        · exact absurd h0 hϖ_ne
        · exact sub_eq_zero.mp hsub0
      obtain ⟨c, hc_eq⟩ := (hEqB c_loc).mp hcomp_c
      refine ⟨c, hInjB (funext fun i => ?_)⟩
      rw [map_smul, Pi.smul_apply, hc_eq]
      exact hc_loc i

    exact h_dvr_red ι C resB_i hDiv hRedC

theorem weil_henselian_dvr_cyclic_etale_algebra_contradiction (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (R : Type u) [CommRing R] [IsDomain R] [Algebra k R]
    [IsDiscreteValuationRing R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)]
    (Ω_R : Type u) [Field Ω_R] [Algebra R Ω_R]
    (hInjΩ : Function.Injective (algebraMap R Ω_R))
    (B : Type u) [CommRing B] [Algebra R B]
    (hIntB : Algebra.IsIntegral R B)
    (hTF : Module.IsTorsionFree R B)
    (hRedGeom : IsReduced (TensorProduct R (AlgebraicClosure (IsLocalRing.ResidueField R)) B))
    (act : ZMod ℓ → (B →ₐ[R] B))
    (hact0 : act 0 = AlgHom.id R B)
    (hact_add : ∀ γ₁ γ₂ : ZMod ℓ, act (γ₁ + γ₂) = (act γ₁).comp (act γ₂))
    (hNoIdemp : ¬ ∃ e₀ : B,
      e₀ * e₀ = e₀ ∧
      (∑ γ : ZMod ℓ, act γ e₀) = 1 ∧
      (∀ γ : ZMod ℓ, γ ≠ 0 → e₀ * act γ e₀ = 0))
    (e_Ω : TensorProduct R Ω_R B ≃ₐ[Ω_R] (ZMod ℓ → Ω_R))
    (he_Ω : ∀ (γ : ZMod ℓ) (b : B) (δ : ZMod ℓ),
      e_Ω (TensorProduct.tmul R (1 : Ω_R) (act γ b)) δ =
        e_Ω (TensorProduct.tmul R (1 : Ω_R) b) (δ + γ)) :
    False :=
by
  
  have hprime : Nat.Prime ℓ := Fact.out
  have hℓ_pos : 0 < ℓ := hprime.pos
  have hℓ_two : 2 ≤ ℓ := hprime.two_le
  have hℓ_ne_zero : ℓ ≠ 0 := hprime.ne_zero
  have : Fact (1 < ℓ) := ⟨hprime.one_lt⟩
  let κ := IsLocalRing.ResidueField R
  let kbar := AlgebraicClosure κ
  have hℓR : (ℓ : R) ≠ 0 := by
    intro h0
    apply hℓ
    apply (RingHom.injective (algebraMap k R))
    rw [map_natCast, map_zero]
    exact h0
  have hℓ_res : (ℓ : κ) ≠ 0 := by
    intro h0
    apply hℓ
    apply (RingHom.injective ((IsLocalRing.residue R).comp (algebraMap k R)))
    rw [map_natCast, map_zero]
    exact h0
  have hℓΩ : (ℓ : Ω_R) ≠ 0 := by
    intro h0
    apply hℓR
    apply hInjΩ
    rw [map_natCast, map_zero]
    exact h0
  have hB_nontriv : Nontrivial B := by
    refine ⟨⟨0, 1, fun h01 => ?_⟩⟩
    have hT01 : (0 : TensorProduct R Ω_R B) = 1 := by
      calc
        (0 : TensorProduct R Ω_R B) = TensorProduct.tmul R (1 : Ω_R) (0 : B) :=
          (TensorProduct.tmul_zero B (1 : Ω_R)).symm
        _ = TensorProduct.tmul R (1 : Ω_R) (1 : B) := by rw [h01]
        _ = 1 := rfl
    have hcongr := congrArg (fun u => e_Ω u 0) hT01
    simp at hcongr
  have : Nontrivial B := hB_nontriv
  have h_cancel_R : ∀ {r : R}, r ≠ 0 → ∀ {b₁ b₂ : B}, r • b₁ = r • b₂ → b₁ = b₂ := by
    intro r hr b₁ b₂ heq
    have hsub : r • (b₁ - b₂) = 0 := by rw [smul_sub, heq, sub_self]
    rcases (Module.isTorsionFree_iff_smul_eq_zero.mp hTF) r (b₁ - b₂) hsub with rfl | h0
    · exact absurd rfl hr
    · exact sub_eq_zero.mp h0

  
  let P_cyc : Polynomial k := ∑ j ∈ Finset.range ℓ, (Polynomial.X : Polynomial k) ^ j
  have hP_coeff1 : P_cyc.coeff 1 = 1 := by
    dsimp [P_cyc]
    rw [Polynomial.finsetSum_coeff]
    simp [Polynomial.coeff_X_pow, Finset.mem_range, hprime.one_lt]
  have hP_deg : P_cyc.degree ≠ 0 := by
    intro h0
    have hC := Polynomial.eq_C_of_degree_eq_zero h0
    have hc1 : P_cyc.coeff 1 = 0 := by
      rw [hC, Polynomial.coeff_C]
      simp
    rw [hP_coeff1] at hc1
    exact one_ne_zero hc1
  obtain ⟨ζ, hζ_root⟩ := IsAlgClosed.exists_root P_cyc hP_deg
  have hζ_sum : ∑ j ∈ Finset.range ℓ, ζ ^ j = 0 := by
    simpa [P_cyc, Polynomial.IsRoot.def, Polynomial.eval_finsetSum] using hζ_root
  have hζ_pow : ζ ^ ℓ = 1 := by
    have hgeom := geom_sum_mul ζ ℓ
    rw [hζ_sum, zero_mul] at hgeom
    exact sub_eq_zero.mp hgeom.symm
  have hζ_ne1 : ζ ≠ 1 := by
    intro h1
    subst h1
    simp only [one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one] at hζ_sum
    exact hℓ hζ_sum
  have hζ_mod : ∀ m : ℕ, ζ ^ m = ζ ^ (m % ℓ) := by
    intro m
    conv_lhs => rw [← Nat.div_add_mod m ℓ]
    rw [pow_add, pow_mul, hζ_pow, one_pow, one_mul]
  let χ_k : ZMod ℓ → k := fun γ => ζ ^ γ.val
  let χ : ZMod ℓ → R := fun γ => algebraMap k R (χ_k γ)
  have hχ_k0 : χ_k 0 = 1 := by simp [χ_k]
  have hχ_k1 : χ_k 1 = ζ := by simp [χ_k, ZMod.val_one ℓ]
  have hχ_k_add : ∀ γ₁ γ₂ : ZMod ℓ, χ_k (γ₁ + γ₂) = χ_k γ₁ * χ_k γ₂ := by
    intro γ₁ γ₂
    dsimp [χ_k]
    rw [← pow_add, hζ_mod (γ₁.val + γ₂.val), ← ZMod.val_add]
  have hχ_k_pow : ∀ (m : ℕ) (γ : ZMod ℓ), (χ_k γ) ^ m = χ_k ((m : ZMod ℓ) * γ) := by
    intro m γ
    induction m with
    | zero => simp [hχ_k0]
    | succ m ih =>
      rw [pow_succ, ih, ← hχ_k_add]
      congr 1
      push_cast
      ring
  have hχ_k_sum : ∑ γ : ZMod ℓ, χ_k γ = 0 := by
    have hshift : ∑ γ : ZMod ℓ, χ_k (1 + γ) = ∑ γ : ZMod ℓ, χ_k γ :=
      Equiv.sum_comp (Equiv.addLeft (1 : ZMod ℓ)) χ_k
    have hmul : ∑ γ : ZMod ℓ, χ_k (1 + γ) = ζ * ∑ γ : ZMod ℓ, χ_k γ := by
      simp_rw [hχ_k_add, hχ_k1, ← Finset.mul_sum]
    have hsub : (ζ - 1) * ∑ γ : ZMod ℓ, χ_k γ = 0 := by
      rw [sub_mul, one_mul, ← hmul, hshift, sub_self]
    exact (mul_eq_zero.mp hsub).resolve_left (sub_ne_zero.mpr hζ_ne1)
  have hχ_k_orth : ∀ c : ZMod ℓ, ∑ γ : ZMod ℓ, χ_k (c * γ) = if c = 0 then (ℓ : k) else 0 := by
    intro c
    split_ifs with hc
    · subst hc
      simp [hχ_k0, ZMod.card ℓ]
    · exact (Equiv.sum_comp (Equiv.mulLeft₀ c hc) χ_k).trans hχ_k_sum
  have hχ0 : χ 0 = 1 := by simp [χ, hχ_k0]
  have hχ_add : ∀ γ₁ γ₂ : ZMod ℓ, χ (γ₁ + γ₂) = χ γ₁ * χ γ₂ :=
    fun γ₁ γ₂ => by simp [χ, hχ_k_add]
  have hχ_pow_val : ∀ (j γ : ZMod ℓ), (χ γ) ^ j.val = χ (j * γ) := by
    intro j γ
    simp only [χ, ← map_pow, hχ_k_pow, ZMod.natCast_zmod_val]
  have hχ_pow_ℓ : ∀ γ : ZMod ℓ, (χ γ) ^ ℓ = 1 := by
    intro γ
    simp only [χ, ← map_pow, hχ_k_pow, CharP.cast_eq_zero, zero_mul, hχ_k0, map_one]
  have hχ_neg_mul : ∀ γ : ZMod ℓ, χ (-γ) * χ γ = 1 := by
    intro γ
    rw [← hχ_add, neg_add_cancel, hχ0]

  
  let proj1 : B → B := fun b => ∑ γ : ZMod ℓ, χ (-γ) • act γ b
  have hproj1_eig : ∀ (b : B) (δ : ZMod ℓ), act δ (proj1 b) = χ δ • proj1 b := by
    intro b δ
    dsimp [proj1]
    rw [map_sum, Finset.smul_sum]
    have hreindex : (∑ γ' : ZMod ℓ, χ δ • (χ (-γ') • act γ' b)) =
        ∑ γ : ZMod ℓ, χ δ • (χ (-(δ + γ)) • act (δ + γ) b) :=
      (Equiv.sum_comp (Equiv.addLeft δ) (fun γ' => χ δ • (χ (-γ') • act γ' b))).symm
    rw [hreindex]
    apply Finset.sum_congr rfl
    intro γ _
    rw [map_smul, ← AlgHom.comp_apply, ← hact_add δ γ, smul_smul, ← hχ_add]
    have heq : δ + -(δ + γ) = -γ := by abel
    rw [heq]
  have hex_x : ∃ x : B, (∀ δ : ZMod ℓ, act δ x = χ δ • x) ∧
      e_Ω (TensorProduct.tmul R (1 : Ω_R) x) 0 ≠ 0 := by
    by_contra hall_not
    have hall : ∀ x : B, (∀ δ : ZMod ℓ, act δ x = χ δ • x) →
        e_Ω (TensorProduct.tmul R (1 : Ω_R) x) 0 = 0 := by
      intro x hx
      by_contra hx0
      exact hall_not ⟨x, hx, hx0⟩
    let Λ : (ZMod ℓ → Ω_R) →ₗ[Ω_R] Ω_R :=
      { toFun := fun f => ∑ γ : ZMod ℓ, algebraMap R Ω_R (χ (-γ)) * f γ
        map_add' := fun f g => by simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
        map_smul' := fun ω f => by
          simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum]
          congr 1; ext γ; ring }
    let Λ_T : TensorProduct R Ω_R B →ₗ[Ω_R] Ω_R := Λ.comp e_Ω.toLinearMap
    have hΛ_tmul1 : ∀ b : B, Λ_T (TensorProduct.tmul R (1 : Ω_R) b) = 0 := by
      intro b
      have h0 : e_Ω (Algebra.TensorProduct.includeRight (R := R) (A := Ω_R) (B := B) (proj1 b)) 0 = 0 :=
        hall (proj1 b) (hproj1_eig b)
      dsimp only [proj1] at h0
      rw [map_sum, map_sum] at h0
      simp only [Finset.sum_apply, Algebra.TensorProduct.includeRight_apply] at h0
      have hsum_eq : (∑ γ : ZMod ℓ,
          (e_Ω (TensorProduct.tmul R (1 : Ω_R) (χ (-γ) • act γ b))) 0) =
          Λ_T (TensorProduct.tmul R (1 : Ω_R) b) := by
        dsimp [Λ_T, Λ]
        apply Finset.sum_congr rfl
        intro γ _
        have hsmul : TensorProduct.tmul R (1 : Ω_R) (χ (-γ) • act γ b) =
            algebraMap R Ω_R (χ (-γ)) • TensorProduct.tmul R (1 : Ω_R) (act γ b) := by
          calc
            TensorProduct.tmul R (1 : Ω_R) (χ (-γ) • act γ b)
              = TensorProduct.tmul R (χ (-γ) • (1 : Ω_R)) (act γ b) := by
                rw [TensorProduct.smul_tmul]
            _ = TensorProduct.tmul R (algebraMap R Ω_R (χ (-γ))) (act γ b) := by
                rw [Algebra.smul_def, mul_one]
            _ = algebraMap R Ω_R (χ (-γ)) • TensorProduct.tmul R (1 : Ω_R) (act γ b) := by
                rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [hsmul, map_smul, Pi.smul_apply, smul_eq_mul, he_Ω γ b 0, zero_add]
      rw [← hsum_eq]
      exact h0
    have hΛ_zero : Λ_T.restrictScalars R = 0 := by
      apply TensorProduct.ext'
      intro ω b
      change Λ_T (TensorProduct.tmul R ω b) = 0
      have hω : TensorProduct.tmul R ω b = ω • TensorProduct.tmul R (1 : Ω_R) b := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [hω, map_smul, hΛ_tmul1 b, smul_zero]
    let f_χ : ZMod ℓ → Ω_R := fun γ => algebraMap R Ω_R (χ γ)
    have hu : Λ_T (e_Ω.symm f_χ) = 0 := LinearMap.congr_fun hΛ_zero (e_Ω.symm f_χ)
    dsimp [Λ_T, Λ, f_χ] at hu
    rw [e_Ω.apply_symm_apply] at hu
    have hu_eval : (∑ γ : ZMod ℓ, algebraMap R Ω_R (χ (-γ)) * algebraMap R Ω_R (χ γ)) =
        (ℓ : Ω_R) := by
      have h1 : ∀ γ : ZMod ℓ, algebraMap R Ω_R (χ (-γ)) * algebraMap R Ω_R (χ γ) = 1 := by
        intro γ
        rw [← map_mul, hχ_neg_mul, map_one]
      simp [h1, ZMod.card ℓ]
    rw [hu_eval] at hu
    exact hℓΩ hu
  obtain ⟨x, hx_eig, hx_ne⟩ := hex_x
  let b : B := x ^ ℓ
  let ω₀ : Ω_R := e_Ω (TensorProduct.tmul R (1 : Ω_R) b) 0
  have hω₀_eq : ω₀ = (e_Ω (TensorProduct.tmul R (1 : Ω_R) x) 0) ^ ℓ := by
    dsimp [ω₀, b]
    change (e_Ω ((Algebra.TensorProduct.includeRight (R := R) (A := Ω_R) (B := B)) (x ^ ℓ))) 0 = _
    rw [map_pow, map_pow, Pi.pow_apply]
    rfl
  have hω₀_ne : ω₀ ≠ 0 := hω₀_eq ▸ pow_ne_zero ℓ hx_ne
  have hb_inv : ∀ γ : ZMod ℓ, act γ b = b := by
    intro γ
    dsimp [b]
    rw [map_pow, hx_eig γ, smul_pow, hχ_pow_ℓ γ, one_smul]
  have hb_Ω : TensorProduct.tmul R (1 : Ω_R) b = TensorProduct.tmul R ω₀ (1 : B) := by
    apply e_Ω.injective
    ext δ
    have hδ : e_Ω (TensorProduct.tmul R (1 : Ω_R) b) δ = ω₀ := by
      calc
        e_Ω (TensorProduct.tmul R (1 : Ω_R) b) δ
          = e_Ω (TensorProduct.tmul R (1 : Ω_R) b) (0 + δ) := by rw [zero_add]
        _ = e_Ω (TensorProduct.tmul R (1 : Ω_R) (act δ b)) 0 := (he_Ω δ b 0).symm
        _ = ω₀ := by rw [hb_inv δ]
    rw [hδ]
    change ω₀ = (e_Ω (algebraMap Ω_R (TensorProduct R Ω_R B) ω₀)) δ
    rw [e_Ω.commutes ω₀]
    rfl
  let K := FractionRing R
  let L := TensorProduct R K B
  have : Module.Flat R B :=
    (Module.Flat.flat_iff_torsion_eq_bot_of_isBezout (R := R) (M := B)).mpr
      ((Submodule.isTorsionFree_iff_torsion_eq_bot (R := R) (M := B)).mp hTF)
  have hinj_RK : Function.Injective (Algebra.linearMap R K) := IsFractionRing.injective R K
  have hinj_rT : Function.Injective (LinearMap.rTensor B (Algebra.linearMap R K)) :=
    Module.Flat.rTensor_preserves_injective_linearMap (Algebra.linearMap R K) hinj_RK
  have hinjBL : Function.Injective (Algebra.TensorProduct.includeRight (R := R) (A := K) (B := B)) := by
    intro y₁ y₂ hy
    apply (TensorProduct.lid R B).symm.injective
    apply hinj_rT
    simpa using hy
  have : Nontrivial L := by
    refine ⟨⟨0, 1, fun h01 => zero_ne_one (α := B) (hinjBL ?_)⟩⟩
    rw [map_zero, map_one]
    exact h01
  have hinjKL : Function.Injective (algebraMap K L) := RingHom.injective (algebraMap K L)
  let _ : Algebra K Ω_R := (IsFractionRing.lift hInjΩ).toAlgebra
  have : IsScalarTower R K Ω_R :=
    IsScalarTower.of_algebraMap_eq (fun r => (IsFractionRing.lift_algebraMap hInjΩ r).symm)
  have hker_KΩ : LinearMap.ker (Algebra.linearMap K Ω_R) = ⊥ :=
    LinearMap.ker_eq_bot.mpr (RingHom.injective (algebraMap K Ω_R))
  obtain ⟨g_K, hg_K⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap K Ω_R) hker_KΩ
  have hg_K1 : g_K (1 : Ω_R) = 1 := by
    have h1 := LinearMap.congr_fun hg_K (1 : K)
    simpa using h1
  let g_R : Ω_R →ₗ[R] K := g_K.restrictScalars R
  let κ₀ : K := g_K ω₀
  have hb_K : TensorProduct.tmul R (1 : K) b = TensorProduct.tmul R κ₀ (1 : B) := by
    have hcongr := congrArg (LinearMap.rTensor B g_R) hb_Ω
    simpa [g_R, κ₀, hg_K1] using hcongr
  obtain ⟨P_b, hPb_monic, hPb_eval⟩ := hIntB.isIntegral b
  have hκ₀_int : IsIntegral R κ₀ := by
    let ι_BL : B →+* L :=
      (Algebra.TensorProduct.includeRight (R := R) (A := K) (B := B)).toRingHom
    refine ⟨P_b, hPb_monic, ?_⟩
    apply hinjKL
    rw [map_zero, Polynomial.hom_eval₂]
    have hcomp : (algebraMap K L).comp (algebraMap R K) = ι_BL.comp (algebraMap R B) := by
      ext r
      change algebraMap K L (algebraMap R K r) = TensorProduct.tmul R (1 : K) (algebraMap R B r)
      rw [Algebra.TensorProduct.algebraMap_apply]
      calc
        TensorProduct.tmul R (algebraMap R K r) (1 : B)
          = TensorProduct.tmul R (r • (1 : K)) (1 : B) := by rw [Algebra.smul_def, mul_one]
        _ = TensorProduct.tmul R (1 : K) (r • (1 : B)) := by rw [TensorProduct.smul_tmul]
        _ = TensorProduct.tmul R (1 : K) (algebraMap R B r) := by rw [Algebra.smul_def, mul_one]
    have hval : algebraMap K L κ₀ = ι_BL b := by
      change algebraMap K (TensorProduct R K B) κ₀ = TensorProduct.tmul R (1 : K) b
      rw [Algebra.TensorProduct.algebraMap_apply, hb_K]
      rfl
    rw [hcomp, hval, ← Polynomial.hom_eval₂ P_b (algebraMap R B) ι_BL b, hPb_eval, map_zero]
  obtain ⟨a, ha_eq⟩ := (IsIntegrallyClosed.isIntegral_iff (R := R) (K := K) (x := κ₀)).mp hκ₀_int
  have hx_pow : x ^ ℓ = algebraMap R B a := by
    change b = algebraMap R B a
    apply hinjBL
    rw [Algebra.TensorProduct.includeRight_apply, hb_K, ← ha_eq]
    calc
      TensorProduct.tmul R (algebraMap R K a) (1 : B)
        = TensorProduct.tmul R (a • (1 : K)) (1 : B) := by rw [Algebra.smul_def, mul_one]
      _ = TensorProduct.tmul R (1 : K) (a • (1 : B)) := by rw [TensorProduct.smul_tmul]
      _ = TensorProduct.tmul R (1 : K) (algebraMap R B a) := by rw [Algebra.smul_def, mul_one]
  have ha_ne : a ≠ 0 := by
    intro ha0
    apply hω₀_ne
    dsimp [ω₀, b]
    rw [hx_pow, ha0, map_zero, TensorProduct.tmul_zero, map_zero, Pi.zero_apply]

  
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hπ_ne : π ≠ 0 := hπ.ne_zero
  have hmax : IsLocalRing.maximalIdeal R = Ideal.span {π} := hπ.maximalIdeal_eq
  have h_not_one : ∀ w : B, π • w ≠ 1 := by
    have hker_le : RingHom.ker (algebraMap R B) ≤ IsLocalRing.maximalIdeal R := by
      intro r hr
      by_contra hr_not
      have hunit : IsUnit r := IsLocalRing.notMem_maximalIdeal.mp hr_not
      have hunitB : IsUnit (algebraMap R B r) := hunit.map (algebraMap R B)
      rw [RingHom.mem_ker.mp hr] at hunitB
      exact not_isUnit_zero hunitB
    obtain ⟨Q, hQ_max, hQ_under⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := B) (IsLocalRing.maximalIdeal R) hker_le
    have hπ_memQ : algebraMap R B π ∈ Q := by
      change π ∈ Ideal.under R Q
      rw [hQ_under, hmax]
      exact Ideal.mem_span_singleton_self π
    intro w hw
    apply hQ_max.ne_top
    rw [Ideal.eq_top_iff_one, ← hw, Algebra.smul_def]
    exact Q.mul_mem_right w hπ_memQ
  have h_rad : ∀ w c : B, w ^ ℓ = π • c → ∃ w₁ : B, w = π • w₁ := by
    intro w c hwc
    have hw_nilp : (TensorProduct.tmul R (1 : kbar) w) ^ ℓ = 0 := by
      change ((Algebra.TensorProduct.includeRight (R := R) (A := kbar) (B := B)) w) ^ ℓ = 0
      rw [← map_pow, hwc, Algebra.TensorProduct.includeRight_apply,
        ← TensorProduct.smul_tmul, Algebra.smul_def, mul_one]
      have hπ_kbar : algebraMap R kbar π = 0 := by
        rw [IsScalarTower.algebraMap_apply R κ kbar π]
        have hπ_res : algebraMap R κ π = 0 := by
          change IsLocalRing.residue R π = 0
          rw [← RingHom.mem_ker, IsLocalRing.ker_residue, hmax]
          exact Ideal.mem_span_singleton_self π
        rw [hπ_res, map_zero]
      rw [hπ_kbar, TensorProduct.zero_tmul]
    have hw_kbar : TensorProduct.tmul R (1 : kbar) w = 0 :=
      IsNilpotent.eq_zero ⟨ℓ, hw_nilp⟩
    have hker_kkbar : LinearMap.ker (Algebra.linearMap κ kbar) = ⊥ :=
      LinearMap.ker_eq_bot.mpr (RingHom.injective (algebraMap κ kbar))
    obtain ⟨g_κ, hg_κ⟩ := LinearMap.exists_leftInverse_of_injective (Algebra.linearMap κ kbar) hker_kkbar
    have hg_κ1 : g_κ (1 : kbar) = 1 := by
      have h1 := LinearMap.congr_fun hg_κ (1 : κ)
      simpa using h1
    have hw_κ : TensorProduct.tmul R (1 : κ) w = 0 := by
      have hcongr := congrArg (LinearMap.rTensor B (g_κ.restrictScalars R)) hw_kbar
      simpa [hg_κ1] using hcongr
    let I_π : Ideal B := Ideal.span {algebraMap R B π}
    let q_π : B →ₐ[R] (B ⧸ I_π) := Ideal.Quotient.mkₐ R I_π
    have hvanish : ∀ r ∈ IsLocalRing.maximalIdeal R,
        (q_π.toRingHom.comp (algebraMap R B)) r = 0 := by
      intro r hr
      rw [hmax, Ideal.mem_span_singleton] at hr
      obtain ⟨r₀, rfl⟩ := hr
      simp only [RingHom.comp_apply, map_mul]
      have hmem : algebraMap R B π ∈ I_π := Ideal.mem_span_singleton_self _
      have hq0 : q_π (algebraMap R B π) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hmem
      change q_π (algebraMap R B π) * q_π (algebraMap R B r₀) = 0
      rw [hq0, zero_mul]
    let ψ_κ_hom : κ →+* (B ⧸ I_π) :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) (q_π.toRingHom.comp (algebraMap R B)) hvanish
    let ψ_κ : κ →ₐ[R] (B ⧸ I_π) :=
      { ψ_κ_hom with commutes' := fun r => rfl }
    let Φ_π : TensorProduct R κ B →ₐ[R] (B ⧸ I_π) :=
      Algebra.TensorProduct.lift ψ_κ q_π (fun _ _ => Commute.all _ _)
    have hqw : Ideal.Quotient.mk I_π w = 0 := by
      have hcongr := congrArg Φ_π hw_κ
      dsimp only [Φ_π] at hcongr
      rw [map_zero, Algebra.TensorProduct.lift_tmul, map_one, one_mul] at hcongr
      exact hcongr
    have hw_mem : w ∈ I_π := Ideal.Quotient.eq_zero_iff_mem.mp hqw
    obtain ⟨w₁, hw₁⟩ := Ideal.mem_span_singleton.mp hw_mem
    exact ⟨w₁, by rw [hw₁, ← Algebra.smul_def]⟩
  obtain ⟨n, hn_assoc⟩ := IsDiscreteValuationRing.associated_pow_irreducible ha_ne hπ
  obtain ⟨u₀, hu₀⟩ := hn_assoc.symm
  let u : R := (u₀ : R)
  let u_inv : R := (↑u₀⁻¹ : R)
  have hu_mul : u * u_inv = 1 := Units.mul_inv u₀
  have hu_inv_mul : u_inv * u = 1 := Units.inv_mul u₀
  have hx_pow_u : x ^ ℓ = algebraMap R B (π ^ n * u) := by
    rw [hu₀, hx_pow]
  have hdiv_ind : ∀ (m : ℕ) (x' : B),
      (∀ γ : ZMod ℓ, act γ x' = χ γ • x') →
      x' ^ ℓ = algebraMap R B (π ^ m * u) →
      ∃ z : B, (∀ γ : ZMod ℓ, act γ z = χ γ • z) ∧ z ^ ℓ = algebraMap R B u := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
      intro x' hx'_eig hx'_pow
      by_cases hm0 : m = 0
      · subst hm0
        refine ⟨x', hx'_eig, ?_⟩
        simpa using hx'_pow
      · have hm_pos : 1 ≤ m := Nat.one_le_iff_ne_zero.mpr hm0
        have hπm_eq : π ^ m * u = π * (π ^ (m - 1) * u) := by
          conv_lhs => rw [← Nat.sub_add_cancel hm_pos]
          rw [pow_succ', mul_assoc]
        have hx'_div : x' ^ ℓ = π • algebraMap R B (π ^ (m - 1) * u) := by
          rw [hx'_pow, hπm_eq, map_mul, ← Algebra.smul_def]
        obtain ⟨x₁, rfl⟩ := h_rad x' (algebraMap R B (π ^ (m - 1) * u)) hx'_div
        by_cases hm_lt : m < ℓ
        · exfalso
          have hpow_split : π ^ ℓ = π ^ m * π ^ (ℓ - m) := by
            rw [← pow_add, Nat.add_sub_of_le (le_of_lt hm_lt)]
          have hrhs_m : algebraMap R B (π ^ m * u) = (π ^ m) • (u • (1 : B)) := by
            rw [map_mul, Algebra.smul_def, Algebra.smul_def, mul_one]
          have heq1 : (π ^ m) • ((π ^ (ℓ - m)) • (x₁ ^ ℓ)) = (π ^ m) • (u • (1 : B)) := by
            rw [← mul_smul, ← hpow_split, ← smul_pow, hx'_pow, hrhs_m]
          have heq2 : (π ^ (ℓ - m)) • (x₁ ^ ℓ) = u • (1 : B) :=
            h_cancel_R (pow_ne_zero m hπ_ne) heq1
          have hrem_pos : 1 ≤ ℓ - m := by omega
          have hrem_split : π ^ (ℓ - m) = π * π ^ (ℓ - m - 1) := by
            conv_lhs => rw [← Nat.sub_add_cancel hrem_pos]
            rw [pow_succ']
          have h_one : π • ((u_inv * π ^ (ℓ - m - 1)) • (x₁ ^ ℓ)) = 1 := by
            calc
              π • ((u_inv * π ^ (ℓ - m - 1)) • (x₁ ^ ℓ))
                = (u_inv * (π * π ^ (ℓ - m - 1))) • (x₁ ^ ℓ) := by
                  rw [← mul_smul]
                  congr 1; ring
              _ = u_inv • ((π ^ (ℓ - m)) • (x₁ ^ ℓ)) := by rw [hrem_split, mul_smul]
              _ = u_inv • (u • (1 : B)) := by rw [heq2]
              _ = 1 := by rw [← mul_smul, hu_inv_mul, one_smul]
          exact h_not_one _ h_one
        · have hm_ge : ℓ ≤ m := le_of_not_gt hm_lt
          have hx₁_eig : ∀ γ : ZMod ℓ, act γ x₁ = χ γ • x₁ := by
            intro γ
            apply h_cancel_R hπ_ne
            calc
              π • act γ x₁ = act γ (π • x₁) := (map_smul (act γ) π x₁).symm
              _ = χ γ • (π • x₁) := hx'_eig γ
              _ = π • (χ γ • x₁) := smul_comm (χ γ) π x₁
          have hx₁_pow : x₁ ^ ℓ = algebraMap R B (π ^ (m - ℓ) * u) := by
            apply h_cancel_R (pow_ne_zero ℓ hπ_ne)
            have hm_split : π ^ m * u = π ^ ℓ * (π ^ (m - ℓ) * u) := by
              rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le hm_ge]
            rw [← smul_pow, hx'_pow, hm_split, map_mul, ← Algebra.smul_def]
          exact ih (m - ℓ) (by omega) x₁ hx₁_eig hx₁_pow
  obtain ⟨z, hz_eig, hz_pow⟩ := hdiv_ind n x hx_eig hx_pow_u
  let F : Polynomial R := Polynomial.X ^ ℓ - Polynomial.C u
  have hF_monic : F.Monic := Polynomial.monic_X_pow_sub_C u hℓ_ne_zero
  let ubar : κ := IsLocalRing.residue R u
  have hubar_ne : ubar ≠ 0 := by
    have hmul1 : ubar * IsLocalRing.residue R u_inv = 1 := by
      dsimp [ubar]
      rw [← map_mul, hu_mul, map_one]
    exact left_ne_zero_of_mul_eq_one hmul1
  let Fbar : Polynomial κ := F.map (IsLocalRing.residue R)
  have hFbar_eq : Fbar = Polynomial.X ^ ℓ - Polynomial.C ubar := by
    dsimp [Fbar, F, ubar]
    rw [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
  have hFbar_deg : Fbar.degree ≠ 0 := by
    rw [hFbar_eq, Polynomial.degree_X_pow_sub_C hℓ_pos ubar]
    exact Nat.cast_ne_zero.mpr hℓ_ne_zero
  have hFbar_deriv : Polynomial.derivative Fbar = Polynomial.C (ℓ : κ) * Polynomial.X ^ (ℓ - 1) := by
    rw [hFbar_eq, Polynomial.derivative_sub, Polynomial.derivative_X_pow,
      Polynomial.derivative_C, sub_zero]
  have hFbar_sep : Fbar.Separable := by
    change IsCoprime Fbar (Polynomial.derivative Fbar)
    refine ⟨Polynomial.C (-ubar⁻¹), Polynomial.X * Polynomial.C (ubar⁻¹ * (ℓ : κ)⁻¹), ?_⟩
    rw [hFbar_deriv, hFbar_eq]
    have hX_pow : (Polynomial.X : Polynomial κ) * Polynomial.X ^ (ℓ - 1) = Polynomial.X ^ ℓ := by
      conv_rhs => rw [← Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hℓ_ne_zero)]
      rw [pow_succ']
    have hc1 : Polynomial.C (-ubar⁻¹) * Polynomial.C ubar = Polynomial.C (-1 : κ) := by
      rw [← Polynomial.C_mul, neg_mul, inv_mul_cancel₀ hubar_ne]
    have hc2 : Polynomial.C (ubar⁻¹ * (ℓ : κ)⁻¹) * Polynomial.C (ℓ : κ) = Polynomial.C ubar⁻¹ := by
      rw [← Polynomial.C_mul, mul_assoc, inv_mul_cancel₀ hℓ_res, mul_one]
    calc
      Polynomial.C (-ubar⁻¹) * (Polynomial.X ^ ℓ - Polynomial.C ubar) +
          (Polynomial.X * Polynomial.C (ubar⁻¹ * (ℓ : κ)⁻¹)) *
            (Polynomial.C (ℓ : κ) * Polynomial.X ^ (ℓ - 1))
        = Polynomial.C (-ubar⁻¹) * Polynomial.X ^ ℓ -
            (Polynomial.C (-ubar⁻¹) * Polynomial.C ubar) +
            (Polynomial.C (ubar⁻¹ * (ℓ : κ)⁻¹) * Polynomial.C (ℓ : κ)) *
              ((Polynomial.X : Polynomial κ) * Polynomial.X ^ (ℓ - 1)) := by ring
      _ = Polynomial.C (-ubar⁻¹) * Polynomial.X ^ ℓ - Polynomial.C (-1 : κ) +
            Polynomial.C ubar⁻¹ * Polynomial.X ^ ℓ := by rw [hc1, hc2, hX_pow]
      _ = 1 := by
          rw [map_neg, map_neg, map_one]
          ring
  obtain ⟨vbar, hvbar_root⟩ := IsSepClosed.exists_root Fbar hFbar_deg hFbar_sep
  have hvbar_pow : vbar ^ ℓ = ubar := by
    have h0 : vbar ^ ℓ - ubar = 0 := by
      simpa [hFbar_eq, Polynomial.IsRoot.def] using hvbar_root
    exact sub_eq_zero.mp h0
  have hvbar_ne : vbar ≠ 0 := by
    intro hv0
    subst hv0
    rw [zero_pow hℓ_ne_zero] at hvbar_pow
    exact hubar_ne hvbar_pow.symm
  obtain ⟨v₀, hv₀_res⟩ := IsLocalRing.residue_surjective vbar
  have hv₀_mem : Polynomial.eval v₀ F ∈ IsLocalRing.maximalIdeal R := by
    rw [← IsLocalRing.ker_residue, RingHom.mem_ker]
    dsimp [F]
    rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
      map_sub, map_pow, hv₀_res, hvbar_pow]
    exact sub_self ubar
  have hv₀_deriv_unit : IsUnit (Polynomial.eval v₀ (Polynomial.derivative F)) := by
    rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.ker_residue, RingHom.mem_ker]
    have hderivF : Polynomial.derivative F = Polynomial.C (ℓ : R) * Polynomial.X ^ (ℓ - 1) := by
      dsimp [F]
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C, sub_zero]
    rw [hderivF, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
      map_mul, map_natCast, map_pow, hv₀_res]
    exact mul_ne_zero hℓ_res (pow_ne_zero (ℓ - 1) hvbar_ne)
  obtain ⟨v, hv_root, _⟩ := HenselianLocalRing.is_henselian F hF_monic v₀ hv₀_mem hv₀_deriv_unit
  have hv_pow : v ^ ℓ = u := by
    have h0 : v ^ ℓ - u = 0 := by
      simpa [F, Polynomial.IsRoot.def] using hv_root
    exact sub_eq_zero.mp h0
  let v_inv : R := v ^ (ℓ - 1) * u_inv
  have hv_inv_mul : v_inv * v = 1 := by
    dsimp [v_inv]
    have hv_split : v ^ (ℓ - 1) * v = v ^ ℓ := by
      conv_rhs => rw [← Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hℓ_ne_zero)]
      rw [pow_succ]
    calc
      v ^ (ℓ - 1) * u_inv * v = (v ^ (ℓ - 1) * v) * u_inv := by ring
      _ = v ^ ℓ * u_inv := by rw [hv_split]
      _ = u * u_inv := by rw [hv_pow]
      _ = 1 := hu_mul
  let y : B := v_inv • z
  have hy_pow : y ^ ℓ = 1 := by
    dsimp [y]
    have hu1 : algebraMap R B u = u • (1 : B) := by rw [Algebra.smul_def, mul_one]
    rw [smul_pow, hz_pow, hu1, ← mul_smul, ← hv_pow, ← mul_pow, hv_inv_mul, one_pow, one_smul]
  have hy_eig : ∀ γ : ZMod ℓ, act γ y = χ γ • y := by
    intro γ
    dsimp [y]
    rw [map_smul, hz_eig γ, smul_comm]

  
  let ℓ_inv_R : R := algebraMap k R (ℓ : k)⁻¹
  have hℓ_inv_mul : ℓ_inv_R * (ℓ : R) = 1 := by
    dsimp [ℓ_inv_R]
    rw [← map_natCast (algebraMap k R) ℓ, ← map_mul, inv_mul_cancel₀ hℓ, map_one]
  have hy_mod : ∀ m : ℕ, y ^ m = y ^ (m % ℓ) := by
    intro m
    conv_lhs => rw [← Nat.div_add_mod m ℓ]
    rw [pow_add, pow_mul, hy_pow, one_pow, one_mul]
  have hy_mul_val : ∀ i j : ZMod ℓ, y ^ i.val * y ^ j.val = y ^ (i + j).val := by
    intro i j
    rw [← pow_add, hy_mod (i.val + j.val), ← ZMod.val_add]
  let e₀ : B := ℓ_inv_R • ∑ j : ZMod ℓ, y ^ j.val
  have hact_e₀ : ∀ γ : ZMod ℓ, act γ e₀ = ℓ_inv_R • ∑ j : ZMod ℓ, χ (j * γ) • y ^ j.val := by
    intro γ
    dsimp [e₀]
    rw [map_smul, map_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    rw [map_pow, hy_eig γ, smul_pow, hχ_pow_val j γ]
  have he₀_sum : (∑ γ : ZMod ℓ, act γ e₀) = 1 := by
    simp_rw [hact_e₀, ← Finset.smul_sum]
    rw [Finset.sum_comm]
    have hinner : (∑ j : ZMod ℓ, ∑ γ : ZMod ℓ, χ (j * γ) • y ^ j.val) = (ℓ : R) • (1 : B) := by
      have h1 : (∑ j : ZMod ℓ, ∑ γ : ZMod ℓ, χ (j * γ) • y ^ j.val) =
          ∑ j : ZMod ℓ, (∑ γ : ZMod ℓ, χ (j * γ)) • y ^ j.val := by
        apply Finset.sum_congr rfl
        intro j _
        rw [Finset.sum_smul]
      rw [h1]
      have h2 : ∀ j : ZMod ℓ, (∑ γ : ZMod ℓ, χ (j * γ)) = if j = 0 then (ℓ : R) else 0 := by
        intro j
        dsimp [χ]
        rw [← map_sum, hχ_k_orth j]
        split_ifs <;> simp
      simp [h2]
    rw [hinner, ← mul_smul, hℓ_inv_mul, one_smul]
  have hy_mul_e₀ : ∀ (i γ : ZMod ℓ), y ^ i.val * act γ e₀ = χ ((-i) * γ) • act γ e₀ := by
    intro i γ
    rw [hact_e₀, mul_smul_comm, Finset.mul_sum]
    have h_lhs : (∑ j : ZMod ℓ, y ^ i.val * (χ (j * γ) • y ^ j.val)) =
        ∑ j : ZMod ℓ, χ (j * γ) • y ^ (i + j).val := by
      apply Finset.sum_congr rfl
      intro j _
      rw [mul_smul_comm, hy_mul_val i j]
    have h_rhs : χ ((-i) * γ) • (ℓ_inv_R • ∑ j' : ZMod ℓ, χ (j' * γ) • y ^ j'.val) =
        ℓ_inv_R • ∑ j : ZMod ℓ, χ (j * γ) • y ^ (i + j).val := by
      rw [smul_comm, Finset.smul_sum]
      congr 1
      have hreindex : (∑ j' : ZMod ℓ, χ ((-i) * γ) • (χ (j' * γ) • y ^ j'.val)) =
          ∑ j : ZMod ℓ, χ ((-i) * γ) • (χ ((i + j) * γ) • y ^ (i + j).val) :=
        (Equiv.sum_comp (Equiv.addLeft i)
          (fun j' => χ ((-i) * γ) • (χ (j' * γ) • y ^ j'.val))).symm
      rw [hreindex]
      apply Finset.sum_congr rfl
      intro j _
      rw [smul_smul, ← hχ_add]
      have hring : (-i) * γ + (i + j) * γ = j * γ := by ring
      rw [hring]
    rw [h_lhs, h_rhs]
  have he₀_prod : ∀ γ : ZMod ℓ,
      e₀ * act γ e₀ = algebraMap k R ((ℓ : k)⁻¹ * ∑ i : ZMod ℓ, χ_k ((-γ) * i)) • act γ e₀ := by
    intro γ
    change (ℓ_inv_R • ∑ i : ZMod ℓ, y ^ i.val) * act γ e₀ = _
    rw [smul_mul_assoc, Finset.sum_mul]
    simp_rw [hy_mul_e₀]
    rw [← Finset.sum_smul, smul_smul]
    congr 1
    dsimp [ℓ_inv_R, χ]
    rw [← map_sum, ← map_mul]
    congr 2
    apply Finset.sum_congr rfl
    intro i _
    congr 1
    ring
  have he₀_idem : e₀ * e₀ = e₀ := by
    have h0 := he₀_prod 0
    have hact0_e₀ : act 0 e₀ = e₀ := by rw [hact0]; rfl
    rw [hact0_e₀, neg_zero, hχ_k_orth 0] at h0
    simp only [ ↓reduceIte, inv_mul_cancel₀ hℓ, map_one, one_smul] at h0
    exact h0
  have he₀_orth : ∀ γ : ZMod ℓ, γ ≠ 0 → e₀ * act γ e₀ = 0 := by
    intro γ hγ
    have hneg : -γ ≠ 0 := neg_ne_zero.mpr hγ
    rw [he₀_prod γ, hχ_k_orth (-γ)]
    simp [hneg]
  exact hNoIdemp ⟨e₀, he₀_idem, he₀_sum, he₀_orth⟩

theorem weil_smooth_proper_curve_dvr_h1_cospecialization_card_le (k : Type u) [Field k] [IsAlgClosed k]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : (ℓ : k) ≠ 0)
    (R : Type u) [CommRing R] [IsDomain R] [Algebra k R]
    [IsDiscreteValuationRing R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)]
    (C_R : AlgebraicGeometry.Scheme.{u})
    (f_R : C_R ⟶ AlgebraicGeometry.Spec (CommRingCat.of R))
    [AlgebraicGeometry.IsProper f_R]
    [AlgebraicGeometry.SmoothOfRelativeDimension 1 f_R]
    (Ω_R : Type u) [Field Ω_R] [IsAlgClosed Ω_R]
    (η_R : AlgebraicGeometry.Spec (CommRingCat.of Ω_R) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of R))
    (hDense : DenseRange η_R.base)
    (hIntGen : AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f_R η_R))
    (hFinGen : Finite (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_R η_R) ℓ 1)) :
    Nat.card (weilEtaleTorsionH C_R ℓ 1) ≤
      Nat.card (weilEtaleTorsionH (CategoryTheory.Limits.pullback f_R η_R) ℓ 1) :=
by
  have : AlgebraicGeometry.Smooth f_R :=
    AlgebraicGeometry.SmoothOfRelativeDimension.smooth 1 f_R
  let φ_η : R →+* Ω_R := (AlgebraicGeometry.Spec.preimage η_R).hom
  have hη_map : AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_η) = η_R :=
    AlgebraicGeometry.Spec.map_preimage η_R
  let pt₀ : ↥(AlgebraicGeometry.Spec (CommRingCat.of Ω_R)) := (⊥ : PrimeSpectrum Ω_R)
  have hRange_pt : Set.range ⇑η_R.base = {η_R.base pt₀} := by
    ext y
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨z, hz⟩ => hz ▸ congrArg η_R.base (Subsingleton.elim z pt₀),
      fun hy => ⟨pt₀, hy.symm⟩⟩
  have hBotMem : (⊥ : PrimeSpectrum R) ∈
      closure ({η_R.base pt₀} : Set (PrimeSpectrum R)) := by
    change (⊥ : PrimeSpectrum R) ∈
      closure ({η_R.base pt₀} : Set ↥(AlgebraicGeometry.Spec (CommRingCat.of R)))
    rw [← hRange_pt, hDense.closure_eq]
    trivial
  erw [PrimeSpectrum.closure_singleton] at hBotMem
  have hIdealBot : (η_R.base pt₀).asIdeal = ⊥ := le_bot_iff.mp hBotMem
  have hKer : RingHom.ker φ_η = ⊥ := by
    have hcomap : PrimeSpectrum.comap φ_η pt₀ = η_R.base pt₀ := by
      rw [← hη_map]
      rfl
    have hker_eq : (PrimeSpectrum.comap φ_η pt₀).asIdeal = RingHom.ker φ_η := rfl
    rw [← hker_eq, hcomap, hIdealBot]
  have hInjΩ : Function.Injective φ_η := by
    intro a b hab
    have hmem : a - b ∈ RingHom.ker φ_η := by
      rw [RingHom.mem_ker, map_sub, hab, sub_self]
    rw [hKer, Ideal.mem_bot] at hmem
    exact sub_eq_zero.mp hmem
  let _ : Algebra R Ω_R := φ_η.toAlgebra
  let C_Ω := CategoryTheory.Limits.pullback f_R η_R
  let h := CategoryTheory.Limits.pullback.fst f_R η_R
  obtain ⟨ψ_pull, hKernel⟩ := weil_etale_h1_pullback_kernel_torsor_cover ℓ C_R C_Ω h
  have : Finite (weilEtaleTorsionH C_Ω ℓ 1) := hFinGen
  apply Nat.card_le_card_of_injective ψ_pull
  rw [injective_iff_map_eq_zero]
  intro c hψc
  by_contra hc_ne
  obtain ⟨T, τ, ρ, hρ_over, hFin_τ, hEt_τ, hρ0, hρ_add, hNoIdemp_T,
    e_triv, he_triv_const, he_triv_act⟩ := hKernel c hψc hc_ne
  let g_T : T ⟶ AlgebraicGeometry.Spec (CommRingCat.of R) := τ ≫ f_R
  have : AlgebraicGeometry.Flat g_T := by
    dsimp [g_T]
    infer_instance
  have : AlgebraicGeometry.IsProper g_T := by
    dsimp [g_T]
    infer_instance
  have : AlgebraicGeometry.Smooth g_T := by
    dsimp [g_T]
    infer_instance
  let kbar_R := AlgebraicClosure (IsLocalRing.ResidueField R)
  let s_kbar := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap R kbar_R))
  let T_kbar := CategoryTheory.Limits.pullback g_T s_kbar
  let p_kbar := CategoryTheory.Limits.pullback.snd g_T s_kbar
  have : AlgebraicGeometry.Smooth p_kbar := by
    dsimp [p_kbar]
    infer_instance
  have hEtDomRed : ∀ (P₀ S₀ : Type u) [CommRing P₀] [IsDomain P₀]
      [CommRing S₀] [Algebra P₀ S₀] [Algebra.Etale P₀ S₀], IsReduced S₀ := by
    intro P₀ S₀ _ _ _ _ _
    let K₀ := FractionRing P₀
    have hinj₀ : Function.Injective (Algebra.linearMap P₀ K₀) := IsFractionRing.injective P₀ K₀
    have hinjT₀ : Function.Injective (LinearMap.rTensor S₀ (Algebra.linearMap P₀ K₀)) :=
      Module.Flat.rTensor_preserves_injective_linearMap (Algebra.linearMap P₀ K₀) hinj₀
    have hinjAlg₀ : Function.Injective
        (Algebra.TensorProduct.includeRight (R := P₀) (A := K₀) (B := S₀)) := by
      intro x y hxy
      apply (TensorProduct.lid P₀ S₀).symm.injective
      apply hinjT₀
      simpa using hxy
    have : Algebra.Etale K₀ (TensorProduct P₀ K₀ S₀) := Algebra.Etale.baseChange P₀ S₀ K₀
    have : IsReduced (TensorProduct P₀ K₀ S₀) :=
      Algebra.FormallyUnramified.isReduced_of_field K₀ (TensorProduct P₀ K₀ S₀)
    exact ⟨fun x ⟨n, hn⟩ => hinjAlg₀ (by
      have hpow : (Algebra.TensorProduct.includeRight (R := P₀) (A := K₀) (B := S₀) x) ^ n = 0 := by
        rw [← map_pow, hn, map_zero]
      rw [IsNilpotent.eq_zero ⟨n, hpow⟩, map_zero])⟩
  have hRed_Tkbar : AlgebraicGeometry.IsReduced T_kbar := by
    let R₀ := ↑((AlgebraicGeometry.Spec (CommRingCat.of kbar_R)).presheaf.obj (Opposite.op ⊤))
