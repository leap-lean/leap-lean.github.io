      (g : X ⟶ AlgebraicGeometry.Spec (CommRingCat.of K₁))
      (g_bar : X_bar ⟶ AlgebraicGeometry.Spec (CommRingCat.of Ω₀))
      (p : X_bar ⟶ X)
      (hp : CategoryTheory.IsPullback p g_bar g β)
      (W : X.Opens) (hW : AlgebraicGeometry.IsAffineOpen W),
      let W_bar : X_bar.Opens := (TopologicalSpace.Opens.map p.base).obj W
      AlgebraicGeometry.IsAffineOpen W_bar ∧
      (let R_W : Type u := ↑(X.presheaf.obj (Opposite.op W))
       let R_W_bar : Type u := ↑(X_bar.presheaf.obj (Opposite.op W_bar))
       letI : Algebra K₁ R_W :=
         (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₁)).inv ≫ g.appTop ≫
           X.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op).hom).toAlgebra
       letI : Algebra Ω₀ R_W_bar :=
         (((AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω₀)).inv ≫ g_bar.appTop ≫
           X_bar.presheaf.map (CategoryTheory.homOfLE (le_top : W_bar ≤ ⊤)).op).hom).toAlgebra
       letI : Algebra K₁ R_W_bar := ((algebraMap Ω₀ R_W_bar).comp (algebraMap K₁ Ω₀)).toAlgebra
       letI : IsScalarTower K₁ Ω₀ R_W_bar := IsScalarTower.of_algebraMap_eq' rfl
       ∃ (ψ_W : R_W →ₐ[K₁] R_W_bar),
         (∀ r : R_W, ψ_W r = (p.app W).hom r) ∧
         Function.Bijective
           (Algebra.TensorProduct.lift (Algebra.ofId Ω₀ R_W_bar) ψ_W (fun _ _ => Commute.all _ _))) := by
    intro X X_bar g g_bar p hp W hW
    let W_bar : X_bar.Opens := (TopologicalSpace.Opens.map p.base).obj W
    have hAff_p : AlgebraicGeometry.IsAffineHom p :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp.flip hAff_β
    have hW_bar : AlgebraicGeometry.IsAffineOpen W_bar :=
      hAff_p.isAffine_preimage W hW
    refine ⟨hW_bar, ?_⟩
    let R_W : Type u := ↑(X.presheaf.obj (Opposite.op W))
    let R_W_bar : Type u := ↑(X_bar.presheaf.obj (Opposite.op W_bar))
    let α₁_top : CommRingCat.of K₁ ⟶ X.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₁)).inv ≫ g.appTop
    let α₂_top : CommRingCat.of Ω₀ ⟶ X_bar.presheaf.obj (Opposite.op ⊤) :=
      (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of Ω₀)).inv ≫ g_bar.appTop
    let α₁_W : CommRingCat.of K₁ ⟶ X.presheaf.obj (Opposite.op W) :=
      α₁_top ≫ X.presheaf.map (CategoryTheory.homOfLE (le_top : W ≤ ⊤)).op
    let α₂_W : CommRingCat.of Ω₀ ⟶ X_bar.presheaf.obj (Opposite.op W_bar) :=
      α₂_top ≫ X_bar.presheaf.map (CategoryTheory.homOfLE (le_top : W_bar ≤ ⊤)).op
    letI : Algebra K₁ R_W := α₁_W.hom.toAlgebra
    letI : Algebra Ω₀ R_W_bar := α₂_W.hom.toAlgebra
    letI : Algebra K₁ R_W_bar := ((algebraMap Ω₀ R_W_bar).comp (algebraMap K₁ Ω₀)).toAlgebra
    letI : IsScalarTower K₁ Ω₀ R_W_bar := IsScalarTower.of_algebraMap_eq' rfl
    have hAlgTop_comm : α₁_top ≫ p.appTop =
        CommRingCat.ofHom (algebraMap K₁ Ω₀) ≫ α₂_top := by
      dsimp [α₁_top, α₂_top]
      have hw_app : g.appTop ≫ p.appTop = β.appTop ≫ g_bar.appTop := by
        rw [← AlgebraicGeometry.Scheme.Hom.comp_appTop, hp.w,
          AlgebraicGeometry.Scheme.Hom.comp_appTop]
      rw [CategoryTheory.Category.assoc, hw_app, ← CategoryTheory.Category.assoc]
      have hβ_nat : (AlgebraicGeometry.Scheme.ΓSpecIso (CommRingCat.of K₁)).inv ≫ β.appTop =
