    change Φ (1 ⊗ₜ[ℤ] x) = 1 ⊗ₜ[PadicInt ℓ] x
    rw [hΦ_tmul, Rat.cast_one]
  obtain ⟨equiv, hequiv⟩ := hPillar4
  
  have hmemL_sys : ∀ (f : ∀ r : ℕ, weilEtaleTorsionH S (ℓ ^ r) i),
      f ∈ weilEtaleIntegralSystem S ℓ i ↔
      ∀ r : ℕ, weilEtaleTorsionTransition S ℓ r i (f (r + 1)) = f r := by
    intro f
    rw [weilEtaleIntegralSystem, AddMonoidHom.mem_ker, funext_iff]
    exact ⟨fun h r => sub_eq_zero.mp (h r), fun h r => sub_eq_zero.mpr (h r)⟩
  have hSmulH : ∀ (z : PadicInt ℓ) (x : L) (r : ℕ),
      (z • x).1 r = (PadicInt.toZModPow r z).val • x.1 r := hSmulSpec
  let frob_L : L →ₗ[PadicInt ℓ] L :=
    { toFun := fun x => ⟨fun r => frobTorsion r (x.1 r), (hmemL_sys _).mpr fun r => by
        rw [hfrobComm r (x.1 (r + 1)), (hmemL_sys x.1).mp x.2 r]⟩
      map_add' := fun x y => Subtype.ext (funext fun r => (frobTorsion r).map_add (x.1 r) (y.1 r))
      map_smul' := fun z x => Subtype.ext (funext fun r => by
        let fx : L := ⟨fun k => frobTorsion k (x.1 k), (hmemL_sys _).mpr fun k => by
          rw [hfrobComm k (x.1 (k + 1)), (hmemL_sys x.1).mp x.2 k]⟩
        change frobTorsion r ((z • x).1 r) = (z • fx).1 r
        rw [hSmulH z x r, hSmulH z fx r]
        exact map_nsmul (frobTorsion r) (PadicInt.toZModPow r z).val (x.1 r)) }
  let V := TensorProduct (PadicInt ℓ) (Padic ℓ) L
  haveI : Module.Finite (Padic ℓ) V := Module.Finite.base_change (PadicInt ℓ) (Padic ℓ) L
  let frob : V →ₗ[Padic ℓ] V := LinearMap.baseChange (Padic ℓ) frob_L
  have hsmul : ∀ (z : PadicInt ℓ) (x y : L),
      (∀ r : ℕ, y.1 r = (PadicInt.toZModPow r z).val • x.1 r) →
        equiv (TensorProduct.tmul ℤ (1 : ℚ) y) =
          (z : Padic ℓ) • equiv (TensorProduct.tmul ℤ (1 : ℚ) x) := by
    intro z x y hy
    have hy_eq : y = z • x := Subtype.ext (funext fun r => (hy r).trans (hSmulSpec z x r).symm)
    rw [hy_eq, hequiv, hequiv, ← TensorProduct.smul_tmul, Algebra.smul_def,
        show algebraMap (PadicInt ℓ) (Padic ℓ) z = (z : Padic ℓ) by rfl,
        ← smul_eq_mul, TensorProduct.smul_tmul']
  have hfrob : ∀ (x y : L),
      (∀ r : ℕ, y.1 r = frobTorsion r (x.1 r)) →
        frob (equiv (TensorProduct.tmul ℤ (1 : ℚ) x)) =
          equiv (TensorProduct.tmul ℤ (1 : ℚ) y) := by
    intro x y hy
    have hy_eq : y = frob_L x := Subtype.ext (funext hy)
    rw [hy_eq, hequiv, hequiv]
    exact LinearMap.baseChange_tmul frob_L (1 : Padic ℓ) x
  exact ⟨⟨V, frob, frobTorsion, hfrobTorsion, equiv, hsmul, hfrob⟩⟩

theorem weil_etale_degree_zero_frob_roots (K : Type u) [Finite K] [Field K]
    (Z : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K)))
    [AlgebraicGeometry.GeometricallyIrreducible Z.hom]
    [AlgebraicGeometry.IsProper Z.hom]
    (d : ℕ) [AlgebraicGeometry.SmoothOfRelativeDimension d Z.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ℓ ≠ ringChar K)
    (M0 : WeilEllAdicCohomologyModel K Z ℓ 0) :
    ((M0.frob).charpoly).aroots (AlgebraicClosure (Padic ℓ)) = {1} :=
by
  
  
  have hPart2 : ∀ (S : AlgebraicGeometry.Scheme.{u}) [ConnectedSpace ↥S]
      (T : S.Etale) (hT : CategoryTheory.Limits.IsTerminal T) (A : AddCommGrpCat.{u}),
      CategoryTheory.IsIso
        ((CategoryTheory.constantSheafAdj S.smallEtaleTopology AddCommGrpCat.{u} hT).unit.app A) := by
    clear * -
    intro S _ T hT A
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})).toIsStableUnderComposition
    have : CategoryTheory.MorphismProperty.ContainsIdentities
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u}) :=
      (inferInstance : CategoryTheory.MorphismProperty.IsMultiplicative
        (@AlgebraicGeometry.Etale : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u})).toContainsIdentities
    let J : CategoryTheory.GrothendieckTopology S.Etale := S.smallEtaleTopology
    let K_pre : CategoryTheory.Pretopology S.Etale := S.smallEtalePretopology
    let Fgt : S.Etale ⥤ CategoryTheory.Over S := AlgebraicGeometry.Scheme.Etale.forget S
    have hJ_eq : J = K_pre.toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale) (Q := @AlgebraicGeometry.Etale) S le_rfl
    have hEt_map : ∀ {U₁ U₂ : S.Etale} (f : U₁ ⟶ U₂), AlgebraicGeometry.Etale f.left := by
      intro U₁ U₂ f
      have hw : f.left ≫ U₂.hom = U₁.hom := CategoryTheory.MorphismProperty.Over.w f
      exact CategoryTheory.MorphismProperty.of_postcomp (@AlgebraicGeometry.Etale)
        f.left U₂.hom U₂.prop (hw.symm ▸ U₁.prop)
    have hOpen_map : ∀ {U₁ U₂ : S.Etale} (f : U₁ ⟶ U₂), IsOpenMap ⇑f.left.base := by
      intro U₁ U₂ f
      have : AlgebraicGeometry.Etale f.left := hEt_map f
      have : AlgebraicGeometry.UniversallyOpen f.left := inferInstance
      exact f.left.isOpenMap
    have hArrows_mem : ∀ {U : S.Etale} {ι : Type u} (Y : ι → S.Etale) (π : ∀ i : ι, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ i : ι, x ∈ Set.range ⇑(π i).left.base) →
        CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y π) ∈ J U := by
      intro U ι Y π hcov
      rw [hJ_eq, CategoryTheory.Pretopology.mem_toGrothendieck]
      refine ⟨CategoryTheory.Presieve.ofArrows Y π, ?_, CategoryTheory.Sieve.le_generate _⟩
      refine ⟨?_, ?_⟩
      · change ∀ x : ↥U.left, ∃ Z g,
          CategoryTheory.Presieve.map AlgebraicGeometry.Scheme.forget
            (CategoryTheory.Presieve.map (CategoryTheory.Over.forget S)
              (CategoryTheory.Presieve.map Fgt (CategoryTheory.Presieve.ofArrows Y π))) g ∧
          x ∈ Set.range ⇑(CategoryTheory.ConcreteCategory.hom g)
        rw [CategoryTheory.Presieve.map_ofArrows, CategoryTheory.Presieve.map_ofArrows,
          CategoryTheory.Presieve.map_ofArrows]
        intro x
        obtain ⟨i, hx⟩ := hcov x
        exact ⟨_, _, CategoryTheory.Presieve.ofArrows.mk i, hx⟩
      · change ∀ ⦃Z : AlgebraicGeometry.Scheme.{u}⦄ ⦃g : Z ⟶ U.left⦄,
          CategoryTheory.Presieve.map (CategoryTheory.Over.forget S)
            (CategoryTheory.Presieve.map Fgt (CategoryTheory.Presieve.ofArrows Y π)) g →
          AlgebraicGeometry.Etale g
        rw [CategoryTheory.Presieve.map_ofArrows, CategoryTheory.Presieve.map_ofArrows]
        rintro _ _ ⟨i⟩
        exact hEt_map (π i)
    let L_pre : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} :=
      { obj := fun U => AddCommGrpCat.of (LocallyConstant ↥(Opposite.unop U).left ↥A)
        map := fun {U₁ U₂} u =>
          AddCommGrpCat.ofHom (LocallyConstant.comapAddMonoidHom
            ⟨⇑u.unop.left.base, u.unop.left.base.hom.continuous⟩)
        map_id := by
          intro U
          ext s x
          rfl
        map_comp := by
          intro U₁ U₂ U₃ u v
          ext s x
          rfl }
    have hL_sheaf : CategoryTheory.Presheaf.IsSheaf J L_pre := by
      apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp J L_pre (CategoryTheory.forget AddCommGrpCat.{u})
      rw [CategoryTheory.isSheaf_iff_isSheaf_of_type, hJ_eq, CategoryTheory.Presieve.isSheaf_pretopology]
      intro U R hR
      rcases hR with ⟨hJoint, _⟩
      have hSurjR : ∀ x : ↥U.left, ∃ (V : S.Etale) (g : V ⟶ U), R g ∧ ∃ y : ↥V.left, g.left.base y = x := by
        intro x
        rcases hJoint x with ⟨_, _, ⟨⟨⟨hgR⟩⟩⟩, y, hy⟩
        exact ⟨_, _, hgR, y, hy⟩
      intro fam hcompat
      let famLC : ∀ {V : S.Etale} (g : V ⟶ U), R g → LocallyConstant ↥V.left ↥A :=
        fun g hg => fam g hg
      have hFiber : ∀ {V₁ V₂ : S.Etale} {g₁ : V₁ ⟶ U} {g₂ : V₂ ⟶ U}
          (hg₁ : R g₁) (hg₂ : R g₂) (y₁ : ↥V₁.left) (y₂ : ↥V₂.left),
          g₁.left.base y₁ = g₂.left.base y₂ → famLC g₁ hg₁ y₁ = famLC g₂ hg₂ y₂ := by
        intro V₁ V₂ g₁ g₂ hg₁ hg₂ y₁ y₂ heq
        have : AlgebraicGeometry.Etale g₁.left := hEt_map g₁
        let W₀ : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback g₁.left g₂.left
        let p₁ : W₀ ⟶ V₁.left := CategoryTheory.Limits.pullback.fst g₁.left g₂.left
        let p₂ : W₀ ⟶ V₂.left := CategoryTheory.Limits.pullback.snd g₁.left g₂.left
        have hp_pb : CategoryTheory.IsPullback p₁ p₂ g₁.left g₂.left :=
          CategoryTheory.IsPullback.of_hasPullback g₁.left g₂.left
        have : AlgebraicGeometry.Etale p₂ :=
          CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
            (P := @AlgebraicGeometry.Etale) hp_pb inferInstance
        have hW_et : AlgebraicGeometry.Etale (p₂ ≫ V₂.hom) :=
          CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale) p₂ V₂.hom
            inferInstance V₂.prop
        let W : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (p₂ ≫ V₂.hom) hW_et
        have hw₁ : p₁ ≫ V₁.hom = W.hom := by
          change p₁ ≫ V₁.hom = p₂ ≫ V₂.hom
          rw [← CategoryTheory.MorphismProperty.Over.w g₁, ← CategoryTheory.MorphismProperty.Over.w g₂,
            ← CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc,
            CategoryTheory.Limits.pullback.condition]
        let π₁ : W ⟶ V₁ := CategoryTheory.MorphismProperty.Over.homMk p₁ hw₁
        let π₂ : W ⟶ V₂ := CategoryTheory.MorphismProperty.Over.homMk p₂ rfl
        have hπ_eq : π₁ ≫ g₁ = π₂ ≫ g₂ :=
          CategoryTheory.MorphismProperty.Over.Hom.ext CategoryTheory.Limits.pullback.condition
        obtain ⟨z, hz₁, hz₂⟩ := AlgebraicGeometry.Scheme.Pullback.exists_preimage_pullback y₁ y₂ heq
        have hc : LocallyConstant.comap ⟨⇑p₁.base, p₁.base.hom.continuous⟩ (famLC g₁ hg₁) =
            LocallyConstant.comap ⟨⇑p₂.base, p₂.base.hom.continuous⟩ (famLC g₂ hg₂) :=
          hcompat π₁ π₂ hg₁ hg₂ hπ_eq
        have hcz := congrArg (fun f : LocallyConstant ↥W₀ ↥A => f z) hc
        dsimp at hcz
        rw [hz₁, hz₂] at hcz
        exact hcz
      let s₀ : ↥U.left → ↥A := fun x =>
        let g := Classical.choose (Classical.choose_spec (hSurjR x))
        let hg := (Classical.choose_spec (Classical.choose_spec (hSurjR x))).1
        let y := Classical.choose (Classical.choose_spec (Classical.choose_spec (hSurjR x))).2
        famLC g hg y
      have hs₀_eq : ∀ {V : S.Etale} (g : V ⟶ U) (hg : R g) (y : ↥V.left),
          s₀ (g.left.base y) = famLC g hg y := by
        intro V g hg y
        dsimp only [s₀]
        set x := g.left.base y
        have hy_spec := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (hSurjR x))).2
        exact hFiber _ hg _ y hy_spec
      have hs₀_lc : IsLocallyConstant s₀ := by
        intro E
        rw [isOpen_iff_forall_mem_open]
        intro x hx
        obtain ⟨V, g, hg, y, rfl⟩ := hSurjR x
        refine ⟨⇑g.left.base '' ((famLC g hg) ⁻¹' E), ?_, ?_, ?_⟩
        · rintro _ ⟨y', hy', rfl⟩
          change s₀ (g.left.base y') ∈ E
          rw [hs₀_eq g hg y']
          exact hy'
        · exact (hOpen_map g) _ ((famLC g hg).isLocallyConstant E)
        · refine ⟨y, ?_, rfl⟩
          change famLC g hg y ∈ E
          rw [← hs₀_eq g hg y]
          exact hx
      let s : LocallyConstant ↥U.left ↥A := ⟨s₀, hs₀_lc⟩
      refine ⟨s, ?_, ?_⟩
      · intro V g hg
        exact LocallyConstant.ext fun y => hs₀_eq g hg y
      · intro s' hs'
        let s'LC : LocallyConstant ↥U.left ↥A := s'
        exact LocallyConstant.ext fun x => by
          obtain ⟨V, g, hg, y, rfl⟩ := hSurjR x
          have h1 : s'LC (g.left.base y) = famLC g hg y := by
            have h : LocallyConstant.comap ⟨⇑g.left.base, g.left.base.hom.continuous⟩ s'LC = famLC g hg :=
              hs' g hg
            exact congrArg (fun f : LocallyConstant ↥V.left ↥A => f y) h
          exact h1.trans (hs₀_eq g hg y).symm
    let L_sh : CategoryTheory.Sheaf J AddCommGrpCat.{u} := ⟨L_pre, hL_sheaf⟩
    let T_std : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ (𝟙 S)
      (CategoryTheory.MorphismProperty.id_mem (@AlgebraicGeometry.Etale) S)
    have hT_std : CategoryTheory.Limits.IsTerminal T_std :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom
        (fun U => CategoryTheory.MorphismProperty.Over.homMk U.hom (CategoryTheory.Category.comp_id U.hom))
        (fun U m => CategoryTheory.MorphismProperty.Over.Hom.ext
          ((CategoryTheory.Category.comp_id m.left).symm.trans (CategoryTheory.MorphismProperty.Over.w m)))
    let isoT : T ≅ T_std := hT.uniqueUpToIso hT_std
    let isoT_sch : T.left ≅ S := (Fgt ⋙ CategoryTheory.Over.forget S).mapIso isoT
    let homeoT : ↥T.left ≃ₜ ↥S := AlgebraicGeometry.Scheme.homeoOfIso isoT_sch
    have : ConnectedSpace ↥T.left := (Homeomorph.connectedSpace_iff homeoT).mpr inferInstance
    let t₀ : ↥T.left := Classical.arbitrary ↥T.left
    let ι_A : A ⟶ L_pre.obj (Opposite.op T) := AddCommGrpCat.ofHom LocallyConstant.constAddMonoidHom
    let ρ_A : L_pre.obj (Opposite.op T) ⟶ A := AddCommGrpCat.ofHom (LocallyConstant.evalAddMonoidHom t₀)
    have hιρ : ι_A ≫ ρ_A = 𝟙 A := by
      ext a
      rfl
    have hρι : ρ_A ≫ ι_A = 𝟙 (L_pre.obj (Opposite.op T)) := by
      ext s t
      exact (congrFun (IsLocallyConstant.eq_const s.isLocallyConstant t₀) t).symm
    let C := CategoryTheory.constantSheaf J AddCommGrpCat.{u}
    let adj := CategoryTheory.constantSheafAdj J AddCommGrpCat.{u} hT
    let η_A : A ⟶ (C.obj A).obj.obj (Opposite.op T) := adj.unit.app A
    let Φ_A : C.obj A ⟶ L_sh := (adj.homEquiv A L_sh).symm ι_A
    let F_pre : (S.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u} := (C.obj A).obj
    have hF_map_comp : ∀ {X₁ X₂ X₃ : S.Etale} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃)
        (z : F_pre.obj (Opposite.op X₃)),
        F_pre.map (f ≫ g).op z = F_pre.map f.op (F_pre.map g.op z) := by
      intro X₁ X₂ X₃ f g z
      rw [CategoryTheory.op_comp, F_pre.map_comp]
      rfl
    have hF_type : CategoryTheory.Presieve.IsSheaf J (F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) := by
      rw [← CategoryTheory.isSheaf_iff_isSheaf_of_type]
      exact CategoryTheory.Presheaf.isSheaf_comp_of_isSheaf J F_pre
        (CategoryTheory.forget AddCommGrpCat.{u}) (C.obj A).property
    have hArrows_sheaf : ∀ {U : S.Etale} {ι : Type u} (Y : ι → S.Etale) (π : ∀ i : ι, Y i ⟶ U),
        (∀ x : ↥U.left, ∃ i : ι, x ∈ Set.range ⇑(π i).left.base) →
        ∀ (sec : ∀ i : ι, F_pre.obj (Opposite.op (Y i))),
        CategoryTheory.Presieve.Arrows.Compatible
          (F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) π sec →
        ∃! t : F_pre.obj (Opposite.op U), ∀ i : ι, F_pre.map (π i).op t = sec i := by
      intro U ι Y π hcov sec hcomp
      have hmem := hArrows_mem Y π hcov
      have hsf := hF_type.isSheafFor _ hmem
      rw [CategoryTheory.Presieve.isSheafFor_arrows_iff] at hsf
      exact hsf sec hcomp
    have hEmpty_sub : ∀ (Z : S.Etale), IsEmpty ↥Z.left → Subsingleton (F_pre.obj (Opposite.op Z)) := by
      intro Z hEmp
      refine ⟨fun a b => ?_⟩
      have hcov : ∀ x : ↥Z.left, ∃ i : PEmpty.{u + 1},
          x ∈ Set.range ⇑(PEmpty.elim i : (PEmpty.elim i : S.Etale) ⟶ Z).left.base :=
        fun x => IsEmpty.elim hEmp x
      obtain ⟨t, _, ht_uniq⟩ := hArrows_sheaf PEmpty.elim (fun i => PEmpty.elim i) hcov
        (fun i => PEmpty.elim i) (fun i => PEmpty.elim i)
      exact (ht_uniq a (fun i => PEmpty.elim i)).trans (ht_uniq b (fun i => PEmpty.elim i)).symm
    let openEtale : ∀ (U : S.Etale) (W : U.left.Opens), S.Etale :=
      fun U W =>
        CategoryTheory.MorphismProperty.Over.mk ⊤ (W.ι ≫ U.hom)
          (CategoryTheory.MorphismProperty.comp_mem (@AlgebraicGeometry.Etale)
            W.ι U.hom inferInstance U.prop)
    let openEtaleHom : ∀ (U : S.Etale) (W : U.left.Opens), openEtale U W ⟶ U :=
      fun U W => CategoryTheory.MorphismProperty.Over.homMk W.ι rfl
    let W_open : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A) (x : ↥U.left), U.left.Opens :=
      fun U s x => ⟨s ⁻¹' {s x}, s.isLocallyConstant {s x}⟩
    let W_et : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A) (x : ↥U.left), S.Etale :=
      fun U s x => openEtale U (W_open U s x)
    let j_et : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A) (x : ↥U.left), W_et U s x ⟶ U :=
      fun U s x => openEtaleHom U (W_open U s x)
    have hj_cov : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A) (x : ↥U.left),
        ∃ i : ↥U.left, x ∈ Set.range ⇑(j_et U s i).left.base := by
      intro U s x
      refine ⟨x, ?_⟩
      change x ∈ Set.range ⇑(W_open U s x).ι.base
      rw [AlgebraicGeometry.Scheme.Opens.range_ι]
      exact rfl
    let σ_loc : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A) (x : ↥U.left),
        F_pre.obj (Opposite.op (W_et U s x)) :=
      fun U s x => F_pre.map (hT.from (W_et U s x)).op (η_A (s x))
    have hσ_compat : ∀ (U : S.Etale) (s : LocallyConstant ↥U.left ↥A),
        CategoryTheory.Presieve.Arrows.Compatible
          (F_pre ⋙ CategoryTheory.forget AddCommGrpCat.{u}) (j_et U s) (σ_loc U s) := by
      intro U s x₁ x₂ Z f₁ f₂ hf_eq
      by_cases hZ : Nonempty ↥Z.left
      · obtain ⟨z₀⟩ := hZ
        have hz₁ : (f₁ ≫ j_et U s x₁).left.base z₀ ∈ (W_open U s x₁ : Set ↥U.left) := by
          change (W_open U s x₁).ι.base (f₁.left.base z₀) ∈ (W_open U s x₁ : Set ↥U.left)
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨f₁.left.base z₀, rfl⟩
        have hz₂ : (f₂ ≫ j_et U s x₂).left.base z₀ ∈ (W_open U s x₂ : Set ↥U.left) := by
          change (W_open U s x₂).ι.base (f₂.left.base z₀) ∈ (W_open U s x₂ : Set ↥U.left)
          rw [← AlgebraicGeometry.Scheme.Opens.range_ι]
          exact ⟨f₂.left.base z₀, rfl⟩
        have hs_eq : s x₁ = s x₂ := by
          have h1 : s ((f₁ ≫ j_et U s x₁).left.base z₀) = s x₁ := hz₁
          have h2 : s ((f₂ ≫ j_et U s x₂).left.base z₀) = s x₂ := hz₂
          rw [hf_eq] at h1
          exact h1.symm.trans h2
        have hterm : f₁ ≫ hT.from (W_et U s x₁) = f₂ ≫ hT.from (W_et U s x₂) := hT.hom_ext _ _
        change F_pre.map f₁.op (F_pre.map (hT.from (W_et U s x₁)).op (η_A (s x₁))) =
          F_pre.map f₂.op (F_pre.map (hT.from (W_et U s x₂)).op (η_A (s x₂)))
        rw [← hF_map_comp, ← hF_map_comp, hterm, hs_eq]
      · have : IsEmpty ↥Z.left := not_nonempty_iff.mp hZ
        have : Subsingleton (F_pre.obj (Opposite.op Z)) := hEmpty_sub Z inferInstance
        exact Subsingleton.elim _ _
