        rwa [hTop₁]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P) (Q := P) (S := W₁)
        (B_h.obj U : P.Over ⊤ W₁) _).mpr ?_
