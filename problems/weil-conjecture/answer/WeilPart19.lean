        CategoryTheory.Limits.pullback.lift_fst _ _ _
      have h_map_snd : (B_h.map u).left ≫ CategoryTheory.Limits.pullback.snd U.hom h =
          CategoryTheory.Limits.pullback.snd V.hom h :=
        CategoryTheory.Limits.pullback.lift_snd _ _ _
      have h_pb_right : CategoryTheory.IsPullback
          (CategoryTheory.Limits.pullback.snd U.hom h)
          (CategoryTheory.Limits.pullback.fst U.hom h) h U.hom :=
