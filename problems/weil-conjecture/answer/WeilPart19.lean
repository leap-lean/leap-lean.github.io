        (q_C ∣_ O_α) (O_αK.ι ≫ f_CK) qP_α fPK_α ψK_α
        hpO_K hpP_α hcommK_α hcompK_α hIsoK_α
    refine ⟨h_α, hh_α_ne, ?_⟩
    intro S _ φ_RS hUnit_α C_S q_CS f_CS hpCS
    let g_S := AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)
    let O_αS : C_S.Opens := (TopologicalSpace.Opens.map q_CS.base).obj O_α
    have hpO_S : CategoryTheory.IsPullback (q_CS ∣_ O_α) (O_αS.ι ≫ f_CS) (O_α.ι ≫ fC) g_S :=
      (AlgebraicGeometry.isPullback_morphismRestrict q_CS O_α).paste_vert hpCS
    let P_αS : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.pullback fP_α g_S
    let qP_S : P_αS ⟶ P_α := CategoryTheory.Limits.pullback.fst fP_α g_S
    let fP_S : P_αS ⟶ AlgebraicGeometry.Spec (CommRingCat.of S) :=
      CategoryTheory.Limits.pullback.snd fP_α g_S
    have hpP_S : CategoryTheory.IsPullback qP_S fP_S fP_α g_S :=
      CategoryTheory.IsPullback.of_hasPullback fP_α g_S
    have _ : AlgebraicGeometry.IsAffineHom g_S := isAffineHom_specMap φ_RS
    have _ : AlgebraicGeometry.IsAffineHom qP_S :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpP_S.flip inferInstance
    have _ : AlgebraicGeometry.IsAffine P_α := hAffP_α
    have _ : AlgebraicGeometry.IsAffine P_αS := AlgebraicGeometry.isAffine_of_isAffineHom qP_S
    let ψ_αS : (O_αS : AlgebraicGeometry.Scheme.{u}) ⟶ P_αS :=
      CategoryTheory.Limits.pullback.lift ((q_CS ∣_ O_α) ≫ ψ_α) (O_αS.ι ≫ f_CS)
