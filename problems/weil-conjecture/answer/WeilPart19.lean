      apply hs_uniq_local U (B_U U) (τ_U U) (hEt_U U) (lift_UV ≫ inv_UV) (𝟙 _) hw₁ hw₂
      let m_lhs : E_U U ⟶ E_U U :=
        CategoryTheory.MorphismProperty.Over.homMk (lift_UV ≫ inv_UV)
          ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.1.ι) hw₁))
      let m_rhs : E_U U ⟶ E_U U :=
        CategoryTheory.MorphismProperty.Over.homMk (𝟙 (G.obj U))
          ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.1.ι) hw₂))
      let m_q₀ : E_wP ⟶ E_U U :=
        CategoryTheory.MorphismProperty.Over.homMk q₀
          ((CategoryTheory.Category.assoc _ _ _).symm.trans (congrArg (· ≫ U.1.ι) hq₀_over))
      have hcomm_l : (lift_UV ≫ e_P.hom) ≫ w_P ≫ U.1.ι = τ_U U ≫ U.1.ι := by
        dsimp [w_P]
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_P.hom,
          ← CategoryTheory.Category.assoc e_P.hom, e_P.hom_inv_id,
          CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc lift_UV,
          CategoryTheory.Limits.pullback.lift_snd]
      let m_le : E_U U ⟶ E_wP :=
        CategoryTheory.MorphismProperty.Over.homMk (lift_UV ≫ e_P.hom) hcomm_l
      have hm_lhs_eq : m_lhs = m_le ≫ m_q₀ := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        exact (CategoryTheory.Category.assoc lift_UV e_P.hom q₀).symm
      have hm_rhs_eq : m_rhs = 𝟙 (E_U U) := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        rfl
      have hcomm_gf : G.map f ≫ τ_U V ≫ V.1.ι = τ_U U ≫ U.1.ι := by
        dsimp [G]
        rw [← CategoryTheory.Category.assoc, hg_over f, CategoryTheory.Category.assoc, hF_X_w f]
      let m_gf : E_U U ⟶ E_U V :=
        CategoryTheory.MorphismProperty.Over.homMk (G.map f) hcomm_gf
      have hm_gf_eq : m_le ≫ m_p₁ = m_gf := by
        apply CategoryTheory.MorphismProperty.Over.Hom.ext
        change (lift_UV ≫ e_P.hom) ≫ e_P.inv ≫ p₁ = G.map f
        rw [CategoryTheory.Category.assoc, ← CategoryTheory.Category.assoc e_P.hom,
          e_P.hom_inv_id, CategoryTheory.Category.id_comp,
          CategoryTheory.Limits.pullback.lift_fst]
      calc
        P.obj.map m_lhs.op (s_U U)
          = P.obj.map (m_le ≫ m_q₀).op (s_U U) := by rw [hm_lhs_eq]
        _ = P.obj.map m_le.op (P.obj.map m_q₀.op (s_U U)) := by
          rw [op_comp, P.obj.map_comp]; rfl
        _ = P.obj.map m_le.op (P.obj.map m_p₁.op (s_U V)) := by rw [hq₀_sec]
        _ = P.obj.map (m_le ≫ m_p₁).op (s_U V) := by rw [op_comp, P.obj.map_comp]; rfl
        _ = P.obj.map m_gf.op (s_U V) := by rw [hm_gf_eq]
        _ = s_U U := hg_sec f hcomm_gf
        _ = P.obj.map m_rhs.op (s_U U) := by rw [hm_rhs_eq, op_id, P.obj.map_id]; rfl
    have h_right_inv : inv_UV ≫ lift_UV = 𝟙 P_UV := by
      apply CategoryTheory.Limits.pullback.hom_ext
      · change (e_P.hom ≫ q₀) ≫ lift_UV ≫ p₁ = 𝟙 P_UV ≫ p₁
        rw [CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Category.id_comp]
        have hq₀_gf : q₀ ≫ G.map f = e_P.inv ≫ p₁ := by
          let w_V : AlgebraicGeometry.Spec R_UV ⟶ V.1.toScheme := w_P ≫ j_map f
          have hEt_wV : AlgebraicGeometry.Etale w_V := hEt_comp w_P (j_map f) hEt_wP (hEt_j f)
          have hw_lhs : (q₀ ≫ G.map f) ≫ τ_U V = w_V := by
            dsimp [w_V, G]
            rw [CategoryTheory.Category.assoc, hg_over f, ← CategoryTheory.Category.assoc, hq₀_over]
          have hw_rhs : (e_P.inv ≫ p₁) ≫ τ_U V = w_V := by
            dsimp [w_V, w_P]
            rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.condition,
