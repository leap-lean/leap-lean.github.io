      fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
        (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
    ∀ (Q : ℕ →o CategoryTheory.Subobject
        ((CategoryTheory.constantSheaf V₁.smallEtaleTopology (ModuleCat.{u, u} R)).obj M)),
      ∃ (O : V₁.Opens) (_ : Nonempty O)
        (M₀ : ModuleCat.{u, u} R) (_ : Finite M₀) (ι₀ : Quiver.Hom M₀ M) (N₀ : ℕ),
        let B_O : CategoryTheory.Functor V₁.Etale (O : AlgebraicGeometry.Scheme.{u}).Etale :=
          CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ O.ι
        ∀ [_hc : B_O.IsContinuous V₁.smallEtaleTopology (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology]
          [_hr : (B_O.sheafPushforwardContinuous (ModuleCat.{u, u} R)
            V₁.smallEtaleTopology (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology).IsRightAdjoint],
          let pb_O := B_O.sheafPullback (ModuleCat.{u, u} R)
            V₁.smallEtaleTopology (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology
          (∀ (n : ℕ) (hn : N₀ ≤ n),
            CategoryTheory.IsIso
              (pb_O.map (CategoryTheory.Subobject.ofLE (Q N₀) (Q n) (Q.monotone hn)))) ∧
          Nonempty (CategoryTheory.Iso
            (pb_O.obj (CategoryTheory.Limits.cokernel (Q N₀).arrow))
            ((CategoryTheory.constantSheaf (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology
              (ModuleCat.{u, u} R)).obj (CategoryTheory.Limits.cokernel ι₀))) :=
by
  have mem_smallEtaleTopology_iff_aux : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      (U : Z.Etale) (S : CategoryTheory.Sieve U),
      S ∈ Z.smallEtaleTopology U ↔
        ∀ (x : ↥(((AlgebraicGeometry.Scheme.Etale.forget Z).obj U).left)),
          ∃ (Y : Z.Etale) (f : Y ⟶ U)
            (y : ↥(((AlgebraicGeometry.Scheme.Etale.forget Z).obj Y).left)),
            S.arrows f ∧
            AlgebraicGeometry.Etale (((AlgebraicGeometry.Scheme.Etale.forget Z).map f).left) ∧
            (((AlgebraicGeometry.Scheme.Etale.forget Z).map f).left).base y = x := by
    intro Z U S
    let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} :=
      @AlgebraicGeometry.Etale
    have : CategoryTheory.MorphismProperty.IsStableUnderComposition P_et :=
      { comp_mem := fun {_ _ _} f g hf hg =>
          let _ : AlgebraicGeometry.Etale f := hf
          let _ : AlgebraicGeometry.Etale g := hg
          inferInstance }
    have : CategoryTheory.MorphismProperty.IsMultiplicative P_et :=
      { id_mem := fun X => (inferInstance : AlgebraicGeometry.Etale (𝟙 X)) }
