  have pbc_of_disjoint : ∀ {W : AlgebraicGeometry.Scheme.{u}}
      (u : W ⟶ X.left),
      Disjoint (Set.range u.base) (Set.range i.left.base) →
      ∀ (q : ℕ),
        ∃ (G_W : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}),
          WeilIsEtaleSheafPullback u (weilEtaleHigherDirectImage i.left q F_Y) G_W ∧
