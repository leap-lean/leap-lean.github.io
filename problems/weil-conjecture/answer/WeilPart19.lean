        have : CategoryTheory.Mono δ_bar := (hEx_βδ 0).mono_cokernelDesc
        have hπ_δbar : CategoryTheory.Limits.cokernel.π ((T_fun 0).map π₀) ≫ δ_bar = δ 0 :=
