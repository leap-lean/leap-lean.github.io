        (map_ne_zero_iff (algebraMap R₀ K₀) (IsFractionRing.injective R₀ K₀)).mpr hc_ne
      have h_rel_kill : ∀ α : Fin r_rel,
          ∃ (N_α : ℕ) (q_α : A₂_dst) (m_α : R₀),
            m_α ≠ 0 ∧ m_α • q_α = 0 ∧
            ∀ {T : Type u} [CommRing T] [Algebra R₀ T] (ι : A₂_dst →ₐ[R₀] T) (u : T),
              algebraMap R₀ T c * u = 1 →
              (algebraMap R₀ T c) ^ N_α *
                MvPolynomial.aeval (fun v => u * ι (y v)) (p_rel α) = ι q_α := by
        intro α
        obtain ⟨N_α, q_α, hq_α⟩ := hHomogEval c y (p_rel α)
        let TK := TensorProduct R₀ K₀ A₂_dst
        let ιK : A₂_dst →ₐ[R₀] TK := Algebra.TensorProduct.includeRight
        let uK : TK := (algebraMap R₀ K₀ c)⁻¹ ⊗ₜ[R₀] 1
        have hcuK : algebraMap R₀ TK c * uK = 1 := by
          change (algebraMap R₀ K₀ c ⊗ₜ[R₀] (1 : A₂_dst)) * ((algebraMap R₀ K₀ c)⁻¹ ⊗ₜ[R₀] 1) = 1
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_inv_cancel₀ hc_K_ne, mul_one]
          rfl
        have h_aeval_K : MvPolynomial.aeval (fun v => uK * ιK (y v)) =
            (f_K.restrictScalars R₀).comp (Algebra.TensorProduct.includeRight.comp π_src) := by
          apply MvPolynomial.algHom_ext
          intro v
          rw [MvPolynomial.aeval_X]
          change ((algebraMap R₀ K₀ c)⁻¹ ⊗ₜ[R₀] (1 : A₂_dst)) * ((1 : K₀) ⊗ₜ[R₀] y v) =
            f_K ((1 : K₀) ⊗ₜ[R₀] π_src (MvPolynomial.X v))
          rw [← hy_spec v, Algebra.smul_def]
          change ((algebraMap R₀ K₀ c)⁻¹ ⊗ₜ[R₀] (1 : A₂_dst)) *
            ((algebraMap R₀ K₀ c ⊗ₜ[R₀] (1 : A₂_dst)) *
              f_K ((1 : K₀) ⊗ₜ[R₀] π_src (MvPolynomial.X v))) = _
          rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, inv_mul_cancel₀ hc_K_ne,
