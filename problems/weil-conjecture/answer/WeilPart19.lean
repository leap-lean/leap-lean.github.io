      have hφ_base_pi : ∀ P : MvPolynomial (Fin m_src) R₀, φ_base_hom (π_src P) = φ_poly P := by
        intro P
        have hq : q_equiv.symm (π_src P) = Ideal.Quotient.mk (RingHom.ker π_src.toRingHom) P := by
          apply q_equiv.injective
          rw [q_equiv.apply_symm_apply]
          rfl
        change φ_quot (q_equiv.symm (π_src P)) = φ_poly P
        rw [hq]
        rfl
      let φ_base : A₁_src →ₐ[R₀] TS :=
        { φ_base_hom with
          commutes' := fun r => by
            have hr_C : algebraMap R₀ A₁_src r = π_src (MvPolynomial.C r) :=
              (π_src.commutes r).symm
            change φ_base_hom (algebraMap R₀ A₁_src r) = algebraMap R₀ TS r
            rw [hr_C, hφ_base_pi, MvPolynomial.aeval_C] }
      let F_S : TensorProduct R₀ S A₁_src →ₐ[S] TS :=
        Algebra.TensorProduct.lift (Algebra.ofId S TS) φ_base (fun _ _ => mul_comm _ _)
      refine ⟨F_S, fun P => ?_⟩
      change (Algebra.ofId S TS 1) * φ_base (π_src P) = φ_poly P
      rw [map_one, one_mul]
      exact hφ_base_pi P
    have hAlgCompSpread :
        ∀ {R₀ K₀ A₁ A₂ : Type u}
          [CommRing R₀] [IsDomain R₀]
          [Field K₀] [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
          [CommRing A₁] [Algebra R₀ A₁]
          [CommRing A₂] [Algebra R₀ A₂]
          {m₁ m₂ : ℕ}
          (π₁ : MvPolynomial (Fin m₁) R₀ →ₐ[R₀] A₁) (_ : Function.Surjective π₁)
          (π₂ : MvPolynomial (Fin m₂) R₀ →ₐ[R₀] A₂) (_ : Function.Surjective π₂)
          (f_K : TensorProduct R₀ K₀ A₁ →ₐ[K₀] TensorProduct R₀ K₀ A₂)
          (g_K : TensorProduct R₀ K₀ A₂ →ₐ[K₀] TensorProduct R₀ K₀ A₁)
          (_ : ∀ z, g_K (f_K z) = z)
          (c₁ : R₀) (_ : c₁ ≠ 0) (y : Fin m₁ → A₂)
          (_ : ∀ v : Fin m₁,
            (algebraMap R₀ K₀ c₁) • f_K ((1 : K₀) ⊗ₜ[R₀] π₁ (MvPolynomial.X v)) =
              (1 : K₀) ⊗ₜ[R₀] y v)
          (c₂ : R₀) (_ : c₂ ≠ 0) (x : Fin m₂ → A₁)
          (_ : ∀ w : Fin m₂,
            (algebraMap R₀ K₀ c₂) • g_K ((1 : K₀) ⊗ₜ[R₀] π₂ (MvPolynomial.X w)) =
              (1 : K₀) ⊗ₜ[R₀] x w),
          ∃ (h_inv : R₀), h_inv ≠ 0 ∧
            ∀ (S : Type u) [CommRing S] [Algebra R₀ S]
              (hc₁_S : IsUnit (algebraMap R₀ S c₁))
              (hc₂_S : IsUnit (algebraMap R₀ S c₂)),
              IsUnit (algebraMap R₀ S h_inv) →
              ∀ (F_S : TensorProduct R₀ S A₁ →ₐ[S] TensorProduct R₀ S A₂)
                (G_S : TensorProduct R₀ S A₂ →ₐ[S] TensorProduct R₀ S A₁),
                (∀ P, F_S ((1 : S) ⊗ₜ[R₀] π₁ P) =
                  MvPolynomial.aeval (fun v => (↑(hc₁_S.unit⁻¹) : S) ⊗ₜ[R₀] y v) P) →
                (∀ Q, G_S ((1 : S) ⊗ₜ[R₀] π₂ Q) =
                  MvPolynomial.aeval (fun w => (↑(hc₂_S.unit⁻¹) : S) ⊗ₜ[R₀] x w) Q) →
                G_S.comp F_S = AlgHom.id S (TensorProduct R₀ S A₁) := by
      intro R₀ K₀ A₁ A₂ _ _ _ _ _ _ _ _ _ m₁ m₂ π₁ hSurj₁ π₂ hSurj₂ f_K g_K hgf
        c₁ hc₁_ne y hy_spec c₂ hc₂_ne x hx_spec
      choose F_v hF_v using fun v : Fin m₁ => hSurj₂ (y v)
      have hc₂_K_ne : algebraMap R₀ K₀ c₂ ≠ 0 :=
        (map_ne_zero_iff (algebraMap R₀ K₀) (IsFractionRing.injective R₀ K₀)).mpr hc₂_ne
      have h_kill_v : ∀ v : Fin m₁,
          ∃ (L_v : ℕ) (z_v : A₁) (w_v : R₀),
            w_v ≠ 0 ∧ w_v • (z_v - (c₂ ^ L_v * c₁) • π₁ (MvPolynomial.X v)) = 0 ∧
            ∀ {T : Type u} [CommRing T] [Algebra R₀ T] (ι : A₁ →ₐ[R₀] T) (u : T),
              algebraMap R₀ T c₂ * u = 1 →
              (algebraMap R₀ T c₂) ^ L_v *
                MvPolynomial.aeval (fun w => u * ι (x w)) (F_v v) = ι z_v := by
        intro v
        obtain ⟨L_v, z_v, hz_v⟩ := hHomogEval c₂ x (F_v v)
        let TK := TensorProduct R₀ K₀ A₁
        let ιK : A₁ →ₐ[R₀] TK := Algebra.TensorProduct.includeRight
        let uK : TK := (algebraMap R₀ K₀ c₂)⁻¹ ⊗ₜ[R₀] 1
        have hcuK : algebraMap R₀ TK c₂ * uK = 1 := by
          change (algebraMap R₀ K₀ c₂ ⊗ₜ[R₀] (1 : A₁)) * ((algebraMap R₀ K₀ c₂)⁻¹ ⊗ₜ[R₀] 1) = 1
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_inv_cancel₀ hc₂_K_ne, mul_one]
          rfl
        have h_aeval_K : MvPolynomial.aeval (fun w => uK * ιK (x w)) =
            (g_K.restrictScalars R₀).comp (Algebra.TensorProduct.includeRight.comp π₂) := by
          apply MvPolynomial.algHom_ext
          intro w
          rw [MvPolynomial.aeval_X]
          change ((algebraMap R₀ K₀ c₂)⁻¹ ⊗ₜ[R₀] (1 : A₁)) * ((1 : K₀) ⊗ₜ[R₀] x w) =
            g_K ((1 : K₀) ⊗ₜ[R₀] π₂ (MvPolynomial.X w))
          rw [← hx_spec w, Algebra.smul_def]
          change ((algebraMap R₀ K₀ c₂)⁻¹ ⊗ₜ[R₀] (1 : A₁)) *
            ((algebraMap R₀ K₀ c₂ ⊗ₜ[R₀] (1 : A₁)) *
              g_K ((1 : K₀) ⊗ₜ[R₀] π₂ (MvPolynomial.X w))) = _
          rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, inv_mul_cancel₀ hc₂_K_ne,
            mul_one, ← Algebra.TensorProduct.one_def, one_mul]
        have hz_diff_K :
            (1 : K₀) ⊗ₜ[R₀] (z_v - (c₂ ^ L_v * c₁) • π₁ (MvPolynomial.X v)) = (0 : TK) := by
          have h1 := hz_v ιK uK hcuK
          rw [h_aeval_K] at h1
          change (algebraMap R₀ TK c₂) ^ L_v * g_K ((1 : K₀) ⊗ₜ[R₀] π₂ (F_v v)) =
            (1 : K₀) ⊗ₜ[R₀] z_v at h1
          rw [hF_v v, ← hy_spec v, map_smul, hgf] at h1
          have hlhs : (algebraMap R₀ TK c₂) ^ L_v *
              ((algebraMap R₀ K₀ c₁) • ((1 : K₀) ⊗ₜ[R₀] π₁ (MvPolynomial.X v))) =
              (1 : K₀) ⊗ₜ[R₀] ((c₂ ^ L_v * c₁) • π₁ (MvPolynomial.X v)) := by
            rw [Algebra.smul_def]
            change ((algebraMap R₀ K₀ c₂) ⊗ₜ[R₀] (1 : A₁)) ^ L_v *
                ((algebraMap R₀ K₀ c₁ ⊗ₜ[R₀] (1 : A₁)) *
                  ((1 : K₀) ⊗ₜ[R₀] π₁ (MvPolynomial.X v))) = _
            rw [Algebra.TensorProduct.tmul_pow, one_pow, ← mul_assoc,
              Algebra.TensorProduct.tmul_mul_tmul, mul_one, Algebra.TensorProduct.tmul_mul_tmul,
              mul_one, one_mul,
              show algebraMap R₀ K₀ c₂ ^ L_v * algebraMap R₀ K₀ c₁ =
                (c₂ ^ L_v * c₁) • (1 : K₀) by rw [Algebra.smul_def, map_mul, map_pow, mul_one],
              TensorProduct.smul_tmul]
          rw [hlhs] at h1
          rw [TensorProduct.tmul_sub, ← h1, sub_self]
        obtain ⟨w_v, hw_v_ne, hw_v_0⟩ := hKillTorsion _ hz_diff_K
        exact ⟨L_v, z_v, w_v, hw_v_ne, hw_v_0, hz_v⟩
      choose L_v z_v w_v hw_v_ne hw_v_0 hz_v_eval using h_kill_v
      let h_inv : R₀ := ∏ v : Fin m₁, w_v v
      have hh_inv_ne : h_inv ≠ 0 := Finset.prod_ne_zero_iff.mpr fun v _ => hw_v_ne v
      refine ⟨h_inv, hh_inv_ne, ?_⟩
      intro S _ _ hc₁_S hc₂_S hinv_S F_S G_S hFS hGS
      let TS₁ := TensorProduct R₀ S A₁
      let ιS₁ : A₁ →ₐ[R₀] TS₁ := Algebra.TensorProduct.includeRight
      let u₁ : S := ↑(hc₁_S.unit⁻¹)
      let u₂ : S := ↑(hc₂_S.unit⁻¹)
      let uS₂ : TS₁ := u₂ ⊗ₜ[R₀] 1
      have hcuS₂ : algebraMap R₀ TS₁ c₂ * uS₂ = 1 := by
        change (algebraMap R₀ S c₂ ⊗ₜ[R₀] (1 : A₁)) * (u₂ ⊗ₜ[R₀] 1) = 1
        rw [Algebra.TensorProduct.tmul_mul_tmul, hc₂_S.mul_val_inv, mul_one]
        rfl
      have h_on_X : ∀ v : Fin m₁,
          G_S (F_S ((1 : S) ⊗ₜ[R₀] π₁ (MvPolynomial.X v))) =
            (1 : S) ⊗ₜ[R₀] π₁ (MvPolynomial.X v) := by
        intro v
        have hf_X : F_S ((1 : S) ⊗ₜ[R₀] π₁ (MvPolynomial.X v)) = u₁ • ((1 : S) ⊗ₜ[R₀] y v) := by
          rw [hFS (MvPolynomial.X v), MvPolynomial.aeval_X, Algebra.smul_def]
          change u₁ ⊗ₜ[R₀] y v = (u₁ ⊗ₜ[R₀] (1 : A₂)) * ((1 : S) ⊗ₜ[R₀] y v)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hf_X, map_smul, ← hF_v v, hGS (F_v v)]
        have hev : MvPolynomial.aeval (fun w => u₂ ⊗ₜ[R₀] x w) (F_v v) =
            MvPolynomial.aeval (fun w => uS₂ * ιS₁ (x w)) (F_v v) := by
          congr 1
          apply MvPolynomial.algHom_ext
          intro w
          simp only [MvPolynomial.aeval_X]
          change u₂ ⊗ₜ[R₀] x w = (u₂ ⊗ₜ[R₀] 1) * ((1 : S) ⊗ₜ[R₀] x w)
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [hev]
        have h1 := hz_v_eval v ιS₁ uS₂ hcuS₂
        have hw_unit : IsUnit (algebraMap R₀ TS₁ (w_v v)) :=
          (isUnit_of_dvd_unit
            (map_dvd (algebraMap R₀ S) (Finset.dvd_prod_of_mem _ (Finset.mem_univ v))) hinv_S).map
            (algebraMap S TS₁)
        have hz_eq : (1 : S) ⊗ₜ[R₀] z_v v =
            (1 : S) ⊗ₜ[R₀] ((c₂ ^ L_v v * c₁) • π₁ (MvPolynomial.X v)) := by
          apply sub_eq_zero.mp
          rw [← TensorProduct.tmul_sub]
          apply hw_unit.mul_left_cancel
          rw [mul_zero]
          change (algebraMap R₀ S (w_v v) ⊗ₜ[R₀] (1 : A₁)) *
            ((1 : S) ⊗ₜ[R₀] (z_v v - (c₂ ^ L_v v * c₁) • π₁ (MvPolynomial.X v))) = 0
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
            show algebraMap R₀ S (w_v v) = w_v v • (1 : S) by rw [Algebra.smul_def, mul_one],
            TensorProduct.smul_tmul, hw_v_0 v, TensorProduct.tmul_zero]
        have hc_prod_unit : IsUnit (algebraMap R₀ TS₁ (c₂ ^ L_v v * c₁)) := by
          rw [map_mul, map_pow]
          exact ((hc₂_S.map (algebraMap S TS₁)).pow (L_v v)).mul (hc₁_S.map (algebraMap S TS₁))
        apply hc_prod_unit.mul_left_cancel
        have hlhs : algebraMap R₀ TS₁ (c₂ ^ L_v v * c₁) *
            (u₁ • MvPolynomial.aeval (fun w => uS₂ * ιS₁ (x w)) (F_v v)) =
            (algebraMap R₀ TS₁ c₂) ^ L_v v *
              MvPolynomial.aeval (fun w => uS₂ * ιS₁ (x w)) (F_v v) := by
          rw [map_mul, map_pow, Algebra.smul_def]
          have h_cu₁ : algebraMap R₀ TS₁ c₁ * algebraMap S TS₁ u₁ = 1 := by
            change algebraMap S TS₁ (algebraMap R₀ S c₁) * algebraMap S TS₁ u₁ = 1
            rw [← map_mul, hc₁_S.mul_val_inv, map_one]
          calc
            ((algebraMap R₀ TS₁ c₂) ^ L_v v * algebraMap R₀ TS₁ c₁) *
                (algebraMap S TS₁ u₁ * MvPolynomial.aeval (fun w => uS₂ * ιS₁ (x w)) (F_v v)) =
              (algebraMap R₀ TS₁ c₂) ^ L_v v *
                ((algebraMap R₀ TS₁ c₁ * algebraMap S TS₁ u₁) *
                  MvPolynomial.aeval (fun w => uS₂ * ιS₁ (x w)) (F_v v)) := by ring
            _ = _ := by rw [h_cu₁, one_mul]
        rw [hlhs, h1]
        change (1 : S) ⊗ₜ[R₀] z_v v =
          (algebraMap R₀ S (c₂ ^ L_v v * c₁) ⊗ₜ[R₀] (1 : A₁)) *
            ((1 : S) ⊗ₜ[R₀] π₁ (MvPolynomial.X v))
        rw [hz_eq, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one,
          show algebraMap R₀ S (c₂ ^ L_v v * c₁) = (c₂ ^ L_v v * c₁) • (1 : S) by
            rw [Algebra.smul_def, mul_one],
          TensorProduct.smul_tmul]
      apply Algebra.TensorProduct.ext
      · ext
      · have h_poly : ((G_S.comp F_S).restrictScalars R₀).comp
            (Algebra.TensorProduct.includeRight.comp π₁) =
            ((AlgHom.id S TS₁).restrictScalars R₀).comp
              (Algebra.TensorProduct.includeRight.comp π₁) := by
          apply MvPolynomial.algHom_ext
          intro v
          exact h_on_X v
        ext a₁
        obtain ⟨P, rfl⟩ := hSurj₁ a₁
        exact congrArg (fun g : MvPolynomial (Fin m₁) R₀ →ₐ[R₀] TS₁ => g P) h_poly
    have hAlgEquivSpread :
        ∀ {R₀ K₀ B₁ E₁ : Type u}
          [CommRing R₀] [IsDomain R₀] [IsNoetherianRing R₀]
          [Field K₀] [Algebra R₀ K₀] [IsFractionRing R₀ K₀]
          [CommRing B₁] [Algebra R₀ B₁] [Algebra.FiniteType R₀ B₁]
          [CommRing E₁] [Algebra R₀ E₁] [Algebra.FiniteType R₀ E₁]
          (e_K : TensorProduct R₀ K₀ B₁ ≃ₐ[K₀] TensorProduct R₀ K₀ E₁),
          ∃ (h₀ : R₀), h₀ ≠ 0 ∧
            ∀ (S : Type u) [CommRing S] [Algebra R₀ S],
              IsUnit (algebraMap R₀ S h₀) →
              Nonempty (TensorProduct R₀ S B₁ ≃ₐ[S] TensorProduct R₀ S E₁) := by
      intro R₀ K₀ B₁ E₁ _ _ _ _ _ _ _ _ _ _ _ _ e_K
      obtain ⟨m_B, π_B, hSurj_B⟩ :=
        (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R₀) (S := B₁)).mp inferInstance
      obtain ⟨m_E, π_E, hSurj_E⟩ :=
        (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R₀) (S := E₁)).mp inferInstance
      obtain ⟨c_B, hc_B_ne, y, h_relB, hh_relB_ne, hy_spec, buildΦ⟩ :=
        hAlgHomSpread π_B hSurj_B e_K.toAlgHom
      obtain ⟨c_E, hc_E_ne, x, h_relE, hh_relE_ne, hx_spec, buildΨ⟩ :=
        hAlgHomSpread π_E hSurj_E e_K.symm.toAlgHom
      obtain ⟨h_invB, hh_invB_ne, hComp_BF⟩ :=
        hAlgCompSpread π_B hSurj_B π_E hSurj_E e_K.toAlgHom e_K.symm.toAlgHom
          e_K.symm_apply_apply c_B hc_B_ne y hy_spec c_E hc_E_ne x hx_spec
      obtain ⟨h_invE, hh_invE_ne, hComp_EB⟩ :=
        hAlgCompSpread π_E hSurj_E π_B hSurj_B e_K.symm.toAlgHom e_K.toAlgHom
          e_K.apply_symm_apply c_E hc_E_ne x hx_spec c_B hc_B_ne y hy_spec
      let h₀ : R₀ := c_B * h_relB * c_E * h_relE * h_invB * h_invE
      have hh₀_ne : h₀ ≠ 0 :=
        mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero
          (mul_ne_zero hc_B_ne hh_relB_ne) hc_E_ne) hh_relE_ne) hh_invB_ne) hh_invE_ne
      refine ⟨h₀, hh₀_ne, ?_⟩
      intro S _ _ hUnit
      simp only [h₀, map_mul, IsUnit.mul_iff] at hUnit
      rcases hUnit with ⟨⟨⟨⟨⟨hu_cB, hu_relB⟩, hu_cE⟩, hu_relE⟩, hu_invB⟩, hu_invE⟩
      obtain ⟨Φ_S, hΦ_S⟩ := buildΦ S hu_cB hu_relB
      obtain ⟨Ψ_S, hΨ_S⟩ := buildΨ S hu_cE hu_relE
      have hΨΦ := hComp_BF S hu_cB hu_cE hu_invB Φ_S Ψ_S hΦ_S hΨ_S
      have hΦΨ := hComp_EB S hu_cE hu_cB hu_invE Ψ_S Φ_S hΨ_S hΦ_S
      exact ⟨AlgEquiv.ofAlgHom Φ_S Ψ_S hΦΨ hΨΦ⟩
    have hChartSpread :
        ∀ (D : Type u) [CommRing D] [Algebra R D] [Algebra.FiniteType R D],
          RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
            (algebraMap K (TensorProduct R K D)) →
          ∃ (h_D : R), h_D ≠ 0 ∧
            ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
              IsUnit (φ_RS h_D) →
              letI : Algebra R S := φ_RS.toAlgebra
              RingHom.Locally (RingHom.IsStandardSmoothOfRelativeDimension d)
                (algebraMap S (TensorProduct R S D)) := by
      intro D _ _ _ hLocK
      let KD := TensorProduct R K D
      obtain ⟨s₀, hs₀_span, hs₀_sm⟩ :=
        (RingHom.locally_iff_finite (RingHom.IsStandardSmoothOfRelativeDimension d)
          (algebraMap K KD)).mp hLocK
      let r := Fintype.card ↥s₀
      let e_fin : Fin r ≃ ↥s₀ := (Fintype.equivFin ↥s₀).symm
      let t : Fin r → KD := fun β => (e_fin β).1
      have ht_mem : ∀ β : Fin r, t β ∈ s₀ := fun β => (e_fin β).2
      have h_t_clear := fun β : Fin r => hClearDenom (t β)
      choose m_β hm_β_ne g_β hg_β_eq using h_t_clear
      have hm_β_K_ne : ∀ β : Fin r, algebraMap R K (m_β β) ≠ 0 :=
        fun β => (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).mpr (hm_β_ne β)
      have h_span_gK : Ideal.span (Set.range fun β : Fin r => (1 : K) ⊗ₜ[R] g_β β) = ⊤ := by
        rw [eq_top_iff, ← hs₀_span, Ideal.span_le]
        intro x hx
        let β : Fin r := e_fin.symm ⟨x, hx⟩
        have hx_eq : x = t β := congrArg Subtype.val (e_fin.apply_symm_apply ⟨x, hx⟩).symm
        have ht_mul : t β = ((algebraMap R K (m_β β))⁻¹ ⊗ₜ[R] (1 : D)) * ((1 : K) ⊗ₜ[R] g_β β) := by
          rw [← hg_β_eq β, Algebra.smul_def]
          change t β = ((algebraMap R K (m_β β))⁻¹ ⊗ₜ[R] (1 : D)) *
            ((algebraMap R K (m_β β) ⊗ₜ[R] (1 : D)) * t β)
          rw [← mul_assoc, Algebra.TensorProduct.tmul_mul_tmul, inv_mul_cancel₀ (hm_β_K_ne β),
            mul_one, ← Algebra.TensorProduct.one_def, one_mul]
        rw [hx_eq, ht_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨β, rfl⟩)
      have h_one_mem : (1 : KD) ∈ Submodule.span KD (Set.range fun β : Fin r => (1 : K) ⊗ₜ[R] g_β β) := by
        change (1 : KD) ∈ Ideal.span (Set.range fun β : Fin r => (1 : K) ⊗ₜ[R] g_β β)
        rw [h_span_gK]
        trivial
      obtain ⟨z_cov, hz_cov⟩ :=
        (Submodule.mem_span_range_iff_exists_fun KD).mp h_one_mem
      have h_zcov_clear := fun β : Fin r => hClearDenom (z_cov β)
      choose d_β hd_β_ne c_tilde hc_tilde using h_zcov_clear
      let D_prod : R := ∏ γ : Fin r, d_β γ
      have hD_prod_ne : D_prod ≠ 0 := Finset.prod_ne_zero_iff.mpr fun γ _ => hd_β_ne γ
      let a_β : Fin r → D := fun β => (∏ γ ∈ Finset.univ.erase β, d_β γ) • c_tilde β
      have h_cov_K0 : (1 : K) ⊗ₜ[R] ((∑ β : Fin r, a_β β * g_β β) - D_prod • (1 : D)) = (0 : KD) := by
        have h_sum : ∀ β : Fin r,
            (algebraMap R K D_prod) • (z_cov β • ((1 : K) ⊗ₜ[R] g_β β)) =
              (1 : K) ⊗ₜ[R] (a_β β * g_β β) := by
          intro β
          have hd_split : D_prod = (∏ γ ∈ Finset.univ.erase β, d_β γ) * d_β β :=
            (Finset.prod_erase_mul Finset.univ d_β (Finset.mem_univ β)).symm
          rw [smul_eq_mul, ← smul_mul_assoc, hd_split, map_mul, mul_smul, hc_tilde β,
            Algebra.smul_def]
          change (((algebraMap R K (∏ γ ∈ Finset.univ.erase β, d_β γ)) ⊗ₜ[R] (1 : D)) *
            ((1 : K) ⊗ₜ[R] c_tilde β)) * ((1 : K) ⊗ₜ[R] g_β β) = _
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul,
            Algebra.TensorProduct.tmul_mul_tmul, mul_one,
            show algebraMap R K (∏ γ ∈ Finset.univ.erase β, d_β γ) =
              (∏ γ ∈ Finset.univ.erase β, d_β γ) • (1 : K) by rw [Algebra.smul_def, mul_one],
            TensorProduct.smul_tmul, ← smul_mul_assoc]
        have h_tot := congrArg ((algebraMap R K D_prod) • ·) hz_cov
        rw [Finset.smul_sum, Finset.sum_congr rfl fun β _ => h_sum β,
          ← TensorProduct.tmul_sum] at h_tot
        have hrhs : (algebraMap R K D_prod) • (1 : KD) = (1 : K) ⊗ₜ[R] (D_prod • (1 : D)) := by
          rw [Algebra.smul_def, mul_one]
          change (algebraMap R K D_prod) ⊗ₜ[R] (1 : D) = _
          rw [show algebraMap R K D_prod = D_prod • (1 : K) by rw [Algebra.smul_def, mul_one],
            TensorProduct.smul_tmul]
        rw [hrhs] at h_tot
        rw [TensorProduct.tmul_sub, h_tot, sub_self]
      obtain ⟨m_ann, hm_ann_ne, hm_ann_0⟩ := hKillTorsion _ h_cov_K0
