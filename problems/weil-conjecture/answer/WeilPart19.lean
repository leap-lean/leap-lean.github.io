      refine Submodule.sum_mem _ fun g hg => ?_
      rw [← mul_assoc, ← map_mul]
      change (((↑u₂⁻¹ : R₁) ^ m * α₀₁ (c g)) • ψ g) ∈ Submodule.span R₁ (↑(F.image ψ) : Set S₁)
      exact Submodule.smul_mem _ _
        (Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem ψ hg)))
    exact ⟨φ₁, hφ₁_fin, hφ₁_comp⟩
