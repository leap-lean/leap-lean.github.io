        AlgebraicGeometry.Scheme.Hom.resLE_eq_morphismRestrict] at h_le
    have hpSpecW_bar : CategoryTheory.IsPullback
        (AlgebraicGeometry.Spec.map (p.app W))
        (AlgebraicGeometry.Spec.map α₂_W)
        (AlgebraicGeometry.Spec.map α₁_W) β := by
      refine CategoryTheory.IsPullback.of_iso hpW
        hW_bar.isoSpec hW.isoSpec
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ ?_ ?_
      · exact hRes_spec.symm
      · simp [hWbar_g]
      · simp [hW_g]
      · simp
    let incL : CommRingCat.of Ω₀ ⟶ CommRingCat.of (TensorProduct K₁ Ω₀ R_W) :=
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := K₁) (A := Ω₀) (B := R_W))
    let incR : X.presheaf.obj (Opposite.op W) ⟶ CommRingCat.of (TensorProduct K₁ Ω₀ R_W) :=
      CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
