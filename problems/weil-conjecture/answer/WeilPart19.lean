    have : CategoryTheory.Mono g₀ := by
      refine ⟨fun {Z} f₁ f₂ hfeq => ?_⟩
      have hcomm : (f₁ ≫ U₀.ι) ≫ π = (f₂ ≫ U₀.ι) ≫ π := by
        simpa only [g₀, CategoryTheory.Category.assoc] using hfeq
      let ψ : Z ⟶ CategoryTheory.Limits.pullback π π :=
        CategoryTheory.Limits.pullback.lift (f₁ ≫ U₀.ι) (f₂ ≫ U₀.ι) hcomm
      let Δ : W ⟶ CategoryTheory.Limits.pullback π π := CategoryTheory.Limits.pullback.diagonal π
      have hθ0_eq_Δ : CategoryTheory.Limits.pullback.lift (𝟙 W) (α 0) (hα_over 0).symm = Δ := by
        apply CategoryTheory.Limits.pullback.hom_ext
        · exact (CategoryTheory.Limits.pullback.lift_fst _ _ _).trans
            (CategoryTheory.Limits.pullback.diagonal_fst π).symm
        · exact (CategoryTheory.Limits.pullback.lift_snd _ _ _).trans
            (hα0.trans (CategoryTheory.Limits.pullback.diagonal_snd π).symm)
      have hrange : Set.range ⇑ψ ⊆ Set.range ⇑Δ := by
        rintro _ ⟨z, rfl⟩
        have hmem : ψ.base z ∈ ⋃ γ : ZMod ℓ,
            Set.range (CategoryTheory.Limits.pullback.lift (𝟙 W) (α γ) (hα_over γ).symm).base := by
          rw [hCov]; trivial
        rw [Set.mem_iUnion] at hmem
