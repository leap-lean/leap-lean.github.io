        have hT1_ε : (T_fun 1).map SC_M.f = 0 := hZero_T1_K0.eq_of_tgt _ _
        have : CategoryTheory.Epi (δ 0) :=
          ((hEx_δα 0).epi_f_iff).mpr hT1_ε
        let δ_bar : CategoryTheory.Limits.cokernel ((T_fun 0).map π₀) ⟶ (T_fun 1).obj M :=
