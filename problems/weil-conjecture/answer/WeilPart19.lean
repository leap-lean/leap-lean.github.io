      have hθ_surj : Function.Surjective θ_i₀ := by
        intro q
        obtain ⟨v, rfl⟩ := hΨ_pi_surj q
        exact ⟨v i₀, (hdecomp_pi v).symm⟩
      have : Module.Finite (IsLocalRing.ResidueField R₀) (L_i i₀) := (hFinSepL i₀).1
      have : Algebra.IsSeparable (IsLocalRing.ResidueField R₀) (L_i i₀) := (hFinSepL i₀).2
      exact hUpgrade B hFT_B (L_i i₀) θ_i₀ hθ_comm hθ_surj
    let ι := { A : Subalgebra R₀ V // inD A }
    let i_bot : ι := ⟨⊥, hBot_inD⟩
    have : Nonempty ι := ⟨i_bot⟩
    let sup_ι : ι → ι → ι := fun i₁ i₂ => ⟨i₁.1 ⊔ i₂.1, hSup_inD i₁.2 i₂.2⟩
    have hDir : Directed (· ≤ ·) (fun i : ι => S_of i.1) := fun i₁ i₂ =>
      ⟨sup_ι i₁ i₂, hS_mono le_sup_left, hS_mono le_sup_right⟩
    have hex_R : ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsLocalRing R)
        (_ : IsDiscreteValuationRing R)
        (j : R₀ →+* R) (val_R : R →+* V) (incl_R : ∀ i : ι, ↥(S_of i.1) →+* R),
        Function.Injective j ∧
        Function.Injective val_R ∧
        Ideal.comap j (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R₀ ∧
        (∀ (i : ι) (z : ↥(S_of i.1)), val_R (incl_R i z) = z.1) ∧
        (∀ x : R, x ∈ IsLocalRing.maximalIdeal R ↔ val_R x ∈ IsLocalRing.maximalIdeal V) ∧
        (∀ x : R, ∃ (i : ι) (x_i : ↥(S_of i.1)), incl_R i x_i = x) := by
      let R_sub : Subalgebra R₀ V := ⨆ i : ι, S_of i.1
      have hR_union : (R_sub : Set V) = ⋃ i : ι, (S_of i.1 : Set V) :=
        Subalgebra.coe_iSup_of_directed hDir
      let incl_R : ∀ i : ι, ↥(S_of i.1) →+* ↥R_sub := fun i =>
        (Subalgebra.inclusion (le_iSup (fun m : ι => S_of m.1) i)).toRingHom
      have hR_mem : ∀ x : ↥R_sub, ∃ (i : ι) (x_i : ↥(S_of i.1)), incl_R i x_i = x := by
        intro x
        have hx : x.1 ∈ ⋃ i : ι, (S_of i.1 : Set V) := by rw [← hR_union]; exact x.2
        obtain ⟨i, hxi⟩ := Set.mem_iUnion.mp hx
        exact ⟨i, ⟨x.1, hxi⟩, Subtype.ext rfl⟩
      have hR_unit_iff : ∀ x : ↥R_sub, IsUnit x ↔ x.1 ∉ IsLocalRing.maximalIdeal V := by
        intro x
        constructor
        · rintro ⟨u, rfl⟩ hm
          exact hmV_ne_top
            (Ideal.eq_top_of_isUnit_mem _ hm ((u.map R_sub.val.toMonoidHom).isUnit))
        · intro hxm
          obtain ⟨i, x_i, rfl⟩ := hR_mem x
          exact ((hS_unit_iff i.1 x_i).mpr hxm).map (incl_R i)
      have instLocalR : IsLocalRing ↥R_sub := IsLocalRing.of_nonunits_add fun x y hx hy => by
        rw [mem_nonunits_iff, hR_unit_iff, not_not] at hx hy ⊢
        exact (IsLocalRing.maximalIdeal V).add_mem hx hy
      have hmR_mem : ∀ x : ↥R_sub,
          x ∈ IsLocalRing.maximalIdeal ↥R_sub ↔ x.1 ∈ IsLocalRing.maximalIdeal V := fun x => by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hR_unit_iff, not_not]
      let j : R₀ →+* ↥R_sub := algebraMap R₀ ↥R_sub
      have hj_inj : Function.Injective j := fun a b hab =>
        hι_V_inj (congrArg Subtype.val hab)
      have hj_comap : Ideal.comap j (IsLocalRing.maximalIdeal ↥R_sub) = IsLocalRing.maximalIdeal R₀ := by
        ext r
        simp only [Ideal.mem_comap, hmR_mem]
        exact Ideal.ext_iff.mp hcomap_mV r
      let π_R : ↥R_sub := j π₀
      have hπ_R_mem : π_R ∈ IsLocalRing.maximalIdeal ↥R_sub := (hmR_mem π_R).mpr hπ_V_mem
      have hπ_R_ne : π_R ≠ 0 := fun h0 => hπ_V_ne (congrArg Subtype.val h0)
      have hR_pow_decomp : ∀ x : ↥R_sub, x ≠ 0 → ∃ (n : ℕ) (u : (↥R_sub)ˣ), x = u.1 * π_R ^ n := by
        intro x hx
        obtain ⟨i, x_i, rfl⟩ := hR_mem x
        have hxi_ne : x_i ≠ 0 := fun h0 => hx (by rw [h0, map_zero])
        obtain ⟨hDVR_i, hIrr_i⟩ := hDVR_of_inD i.2
        let _ := hDVR_i
        obtain ⟨n, u_i, hx_eq⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hxi_ne hIrr_i
        refine ⟨n, Units.map (incl_R i).toMonoidHom u_i, ?_⟩
        have hπ_eq : incl_R i (algebraMap R₀ ↥(S_of i.1) π₀) = π_R := Subtype.ext rfl
        calc
          incl_R i x_i = incl_R i (u_i.1 * (algebraMap R₀ ↥(S_of i.1) π₀) ^ n) :=
            congrArg (incl_R i) hx_eq
          _ = (Units.map (incl_R i).toMonoidHom u_i).1 * π_R ^ n := by
            rw [map_mul, map_pow, hπ_eq]; rfl
      have instPIR_R : IsPrincipalIdealRing ↥R_sub :=
        { principal := fun I => by
            by_cases hI : I = ⊥
            · refine ⟨0, ?_⟩
              rw [hI, Ideal.submodule_span_eq, Ideal.span_singleton_eq_bot.mpr rfl]
            · have hex_nz : ∃ x ∈ I, x ≠ 0 := by
                by_contra! hall
                exact hI (eq_bot_iff.mpr fun x hx => Ideal.mem_bot.mpr (hall x hx))
              obtain ⟨x₀, hx₀_I, hx₀_ne⟩ := hex_nz
              obtain ⟨m₀, u₀, rfl⟩ := hR_pow_decomp x₀ hx₀_ne
              have hex_pow : ∃ n : ℕ, π_R ^ n ∈ I := ⟨m₀, by
                have := I.mul_mem_left (↑(u₀⁻¹) : ↥R_sub) hx₀_I
                rwa [← mul_assoc, Units.inv_mul, one_mul] at this⟩
              let n₀ := Nat.find hex_pow
              have hn₀_mem : π_R ^ n₀ ∈ I := Nat.find_spec hex_pow
              refine ⟨π_R ^ n₀, ?_⟩
              rw [Ideal.submodule_span_eq]
              apply le_antisymm
              · intro y hy
                by_cases hy0 : y = 0
                · rw [hy0]; exact Ideal.zero_mem _
                · obtain ⟨n, u, rfl⟩ := hR_pow_decomp y hy0
                  have hpow_I : π_R ^ n ∈ I := by
                    have := I.mul_mem_left (↑(u⁻¹) : ↥R_sub) hy
                    rwa [← mul_assoc, Units.inv_mul, one_mul] at this
                  have hle : n₀ ≤ n := Nat.find_min' hex_pow hpow_I
                  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hle
                  rw [Ideal.mem_span_singleton]
                  exact ⟨u.1 * π_R ^ d, by ring⟩
              · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hn₀_mem) }
      have hmR_ne_bot : IsLocalRing.maximalIdeal ↥R_sub ≠ ⊥ := fun hbot =>
        hπ_R_ne (Ideal.mem_bot.mp (hbot ▸ hπ_R_mem))
      have hDVR_R : IsDiscreteValuationRing ↥R_sub := IsDiscreteValuationRing.mk hmR_ne_bot
      exact ⟨↥R_sub, inferInstance, inferInstance, instLocalR, hDVR_R,
        j, R_sub.val.toRingHom, incl_R, hj_inj, Subtype.val_injective, hj_comap,
        fun _ _ => rfl, hmR_mem, hR_mem⟩
    obtain ⟨R, hCR_R, hDom_R, hLoc_R, hDVR_R, j, val_R, incl_R,
      hj_inj, hval_R_inj, hj_comap, hincl_val, hmR_mem, hR_mem⟩ := hex_R
    let _ := hCR_R
    let _ := hDom_R
    let _ := hLoc_R
    let _ := hDVR_R
    have hincl_R_inj : ∀ i : ι, Function.Injective (incl_R i) := fun i x y hxy => by
      apply Subtype.ext
      have h1 := congrArg val_R hxy
      rwa [hincl_val, hincl_val] at h1
    have hLocalHom_inclR : ∀ i : ι, IsLocalHom (incl_R i) := fun i =>
      ⟨fun z hz => by
        rw [← IsLocalRing.notMem_maximalIdeal] at hz ⊢
        rw [hmR_mem, hincl_val, ← hmS_mem] at hz
        exact hz⟩
    have hFinset_in_i : ∀ (F : Finset R), ∃ i : ι, ∀ c ∈ F, val_R c ∈ S_of i.1 := by
      intro F
      induction F using Finset.induction_on with
      | empty => exact ⟨i_bot, by simp⟩
      | @insert c s_fin _ ih =>
        obtain ⟨i_s, hi_s⟩ := ih
        obtain ⟨i_c, x_c, hxc⟩ := hR_mem c
        refine ⟨sup_ι i_c i_s, fun y hy => ?_⟩
        rcases Finset.mem_insert.mp hy with hyc | hys
        · have hc_eq : val_R c = x_c.1 := by rw [← hxc, hincl_val]
          rw [hyc, hc_eq]
          exact hS_mono le_sup_left x_c.2
        · exact hS_mono le_sup_right (hi_s y hys)
    have hLiftPoly : ∀ (f : Polynomial R) (a₀ : R), f.Monic →
        ∃ (i : ι) (f_i : Polynomial ↥(S_of i.1)) (a_i : ↥(S_of i.1)),
          f_i.Monic ∧ f_i.map (incl_R i) = f ∧ incl_R i a_i = a₀ := by
      intro f a₀ hf_monic
      obtain ⟨i, hi⟩ := hFinset_in_i (insert a₀ (f.support.image f.coeff))
      have ha₀_mem : val_R a₀ ∈ S_of i.1 := hi a₀ (Finset.mem_insert_self _ _)
      have hcoeff_mem : ∀ n : ℕ, val_R (f.coeff n) ∈ S_of i.1 := by
        intro n
        by_cases hn : n ∈ f.support
        · exact hi (f.coeff n) (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hn))
        · rw [Polynomial.notMem_support_iff.mp hn, map_zero]
          exact (S_of i.1).zero_mem
      let a_i : ↥(S_of i.1) := ⟨val_R a₀, ha₀_mem⟩
      have ha_eq : incl_R i a_i = a₀ := hval_R_inj (hincl_val i a_i)
      let f_i : Polynomial ↥(S_of i.1) :=
        ∑ n ∈ f.support, Polynomial.monomial n ⟨val_R (f.coeff n), hcoeff_mem n⟩
      have hf_map : f_i.map (incl_R i) = f := by
        dsimp [f_i]
        rw [Polynomial.map_sum]
        refine (Finset.sum_congr rfl fun n _ => ?_).trans f.as_sum_support.symm
        rw [Polynomial.map_monomial]
        congr 1
        exact hval_R_inj (hincl_val i _)
      have hcoeff_fi : ∀ n : ℕ, incl_R i (f_i.coeff n) = f.coeff n := by
        intro n
        rw [← hf_map, Polynomial.coeff_map]
      have hdeg_eq : f_i.natDegree = f.natDegree := by
        apply le_antisymm
        · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
          intro m hm
          apply hincl_R_inj i
          rw [hcoeff_fi, map_zero, Polynomial.coeff_eq_zero_of_natDegree_lt hm]
        · refine Polynomial.le_natDegree_of_ne_zero fun h0 => ?_
          have h1 : f.coeff f.natDegree = 0 := by rw [← hcoeff_fi, h0, map_zero]
          exact one_ne_zero (hf_monic.leadingCoeff.symm.trans h1)
      have hfi_monic : f_i.Monic := by
        rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg_eq]
        apply hincl_R_inj i
        rw [hcoeff_fi, map_one]
        exact hf_monic.leadingCoeff
      exact ⟨i, f_i, a_i, hfi_monic, hf_map, ha_eq⟩
    have hHens_R : HenselianLocalRing R := by
      refine HenselianLocalRing.mk fun f hf_monic a₀ hfa₀ hf'a₀ => ?_
      obtain ⟨i, f_A, a_A, hfA_monic, hfA_map, haA_eq⟩ := hLiftPoly f a₀ hf_monic
      let A := i.1
      have hA_inD : inD A := i.2
      have hfaA_m : f_A.eval a_A ∈ IsLocalRing.maximalIdeal ↥(S_of A) := by
        rw [hmS_mem]
        have h1 : incl_R i (f_A.eval a_A) = f.eval a₀ := by
          rw [← hfA_map, ← haA_eq, Polynomial.eval_map_apply]
        have h2 : val_R (incl_R i (f_A.eval a_A)) ∈ IsLocalRing.maximalIdeal V :=
          (hmR_mem _).mp (h1.symm ▸ hfa₀)
        rwa [hincl_val] at h2
      have hf'aA_unit : IsUnit (f_A.derivative.eval a_A) := by
        have h1 : incl_R i (f_A.derivative.eval a_A) = f.derivative.eval a₀ := by
          rw [← hfA_map, ← haA_eq, Polynomial.derivative_map, Polynomial.eval_map_apply]
        have := hLocalHom_inclR i
        exact (isUnit_map_iff (incl_R i) _).mp (h1.symm ▸ hf'a₀)
      have hex_deg : ∃ d : ℕ, ∃ g : Polynomial ↥(S_of A),
          g.Monic ∧ g ∣ f_A ∧ g.eval a_A ∈ IsLocalRing.maximalIdeal ↥(S_of A) ∧ g.natDegree = d :=
        ⟨f_A.natDegree, f_A, hfA_monic, dvd_rfl, hfaA_m, rfl⟩
      let d_min := Nat.find hex_deg
      obtain ⟨g, hg_monic, hg_dvd, hga_m, hg_deg⟩ := Nat.find_spec hex_deg
      have hg_irr : Irreducible g := by
        rw [Polynomial.Monic.irreducible_iff_natDegree hg_monic]
        refine ⟨fun hg1 => ?_, fun g₁ g₂ hg₁ hg₂ hmul => ?_⟩
        · rw [hg1, Polynomial.eval_one] at hga_m
          exact (IsLocalRing.maximalIdeal.isMaximal ↥(S_of A)).ne_top
            (Ideal.eq_top_of_isUnit_mem _ hga_m isUnit_one)
        · have hprod_m : g₁.eval a_A * g₂.eval a_A ∈ IsLocalRing.maximalIdeal ↥(S_of A) := by
            rwa [← Polynomial.eval_mul, hmul]
          have hdeg_sum : d_min = g₁.natDegree + g₂.natDegree := by
            change Nat.find hex_deg = _
            rw [← hg_deg, ← hmul, hg₁.natDegree_mul hg₂]
          rcases (IsLocalRing.maximalIdeal.isMaximal ↥(S_of A)).isPrime.mem_or_mem hprod_m with hm₁ | hm₂
          · have hle : d_min ≤ g₁.natDegree :=
              Nat.find_min' hex_deg ⟨g₁, hg₁, dvd_trans ⟨g₂, hmul.symm⟩ hg_dvd, hm₁, rfl⟩
            right; omega
          · have hle : d_min ≤ g₂.natDegree :=
              Nat.find_min' hex_deg ⟨g₂, hg₂, dvd_trans ⟨g₁, by rw [← hmul, mul_comm]⟩ hg_dvd, hm₂, rfl⟩
            left; omega
      obtain ⟨q_A, hfq⟩ := hg_dvd
      have hg'a_unit : IsUnit (g.derivative.eval a_A) := by
        rw [← IsLocalRing.notMem_maximalIdeal]
        intro hg'_m
        have hf'_m : f_A.derivative.eval a_A ∈ IsLocalRing.maximalIdeal ↥(S_of A) := by
          rw [hfq, Polynomial.derivative_mul, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul]
          exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hg'_m) (Ideal.mul_mem_right _ _ hga_m)
        exact (IsLocalRing.notMem_maximalIdeal.mpr hf'aA_unit) hf'_m
      obtain ⟨hDVR_A, _⟩ := hDVR_of_inD hA_inD
      let _ := hDVR_A
      let val_K : ↥(S_of A) →+* K_sep := val_V.comp (S_of A).val.toRingHom
      have hval_K_inj : Function.Injective val_K := hval_V_inj.comp Subtype.val_injective
      let _ : Algebra ↥(S_of A) K_sep := val_K.toAlgebra
      let σ_FA : FractionRing ↥(S_of A) →+* K_sep := IsFractionRing.lift hval_K_inj
      have hσ_FA_comp : σ_FA.comp (algebraMap ↥(S_of A) (FractionRing ↥(S_of A))) = val_K :=
        RingHom.ext fun z => IsFractionRing.lift_algebraMap hval_K_inj z
      let g_F : Polynomial (FractionRing ↥(S_of A)) :=
        g.map (algebraMap ↥(S_of A) (FractionRing ↥(S_of A)))
      have hg_F_irr : Irreducible g_F :=
        (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map
          (K := FractionRing ↥(S_of A)) hg_monic).mp hg_irr
      have hg_F_sep : g_F.Separable := by
        rw [Polynomial.separable_iff_derivative_ne_zero hg_F_irr]
        intro hderiv0
        have hev0 : g_F.derivative.eval (algebraMap ↥(S_of A) _ a_A) = 0 := by
          rw [hderiv0, Polynomial.eval_zero]
        dsimp [g_F] at hev0
        rw [Polynomial.derivative_map, Polynomial.eval_map_apply] at hev0
        have ha0 : g.derivative.eval a_A = 0 :=
          IsFractionRing.injective ↥(S_of A) (FractionRing ↥(S_of A)) (hev0.trans (map_zero _).symm)
        exact hg'a_unit.ne_zero ha0
      let g_K : Polynomial K_sep := g_F.map σ_FA
      have hg_K_eq : g_K = g.map val_K := by
        dsimp [g_K, g_F]
        rw [Polynomial.map_map, hσ_FA_comp]
      have hg_K_splits : g_K.Splits := IsSepClosed.splits_codomain g_F hg_F_sep
      have hg_K_monic : g_K.Monic := by rw [hg_K_eq]; exact hg_monic.map val_K
      have hg_K_coeff_V : ∀ n : ℕ, g_K.coeff n ∈ Set.range val_V := by
        intro n
        rw [hg_K_eq, Polynomial.coeff_map]
        exact ⟨(g.coeff n).1, rfl⟩
      have hroots_in_V : ∀ r ∈ g_K.roots, ∃ v : V, val_V v = r := fun r hr =>
        hMonicRoot_in_V g_K hg_K_monic hg_K_coeff_V r
          ((Polynomial.mem_roots hg_K_monic.ne_zero).mp hr)
      have hex_root_mV : ∃ y_V : V, g_K.eval (val_V y_V) = 0 ∧
          y_V - a_A.1 ∈ IsLocalRing.maximalIdeal V := by
        have hprod_eval : (g_K.roots.map (fun r => val_K a_A - r)).prod = val_K (g.eval a_A) := by
          rw [← hg_K_splits.eval_eq_prod_roots_of_monic hg_K_monic,
            hg_K_eq, Polynomial.eval_map_apply]
        have hmult_lift : ∀ (M : Multiset K_sep),
            (∀ r ∈ M, ∃ v : V, val_V v = r) →
            ∃ M_V : Multiset V,
              (∀ w ∈ M_V, ∃ r ∈ M, val_V w = val_K a_A - r) ∧
              val_V M_V.prod = (M.map (fun r => val_K a_A - r)).prod := by
          intro M
          refine Multiset.induction_on M (fun _ => ⟨0, by simp, by simp⟩) ?_
          intro r s_mult ih hs
          obtain ⟨v_r, hvr⟩ := hs r (Multiset.mem_cons_self r s_mult)
          obtain ⟨M_s, hMs_mem, hMs_prod⟩ := ih (fun x hx => hs x (Multiset.mem_cons_of_mem hx))
          refine ⟨(a_A.1 - v_r) ::ₘ M_s, ?_, ?_⟩
          · intro w hw
            rcases Multiset.mem_cons.mp hw with rfl | hws
            · exact ⟨r, Multiset.mem_cons_self r s_mult, by rw [map_sub, ← hvr]; rfl⟩
            · obtain ⟨r', hr's, hwr'⟩ := hMs_mem w hws
              exact ⟨r', Multiset.mem_cons_of_mem hr's, hwr'⟩
          · rw [Multiset.prod_cons, map_mul, hMs_prod, Multiset.map_cons, Multiset.prod_cons,
              map_sub, hvr]
            rfl
        obtain ⟨M_V, hMV_mem, hMV_prod⟩ := hmult_lift g_K.roots hroots_in_V
        have hMV_eq : M_V.prod = (g.eval a_A).1 :=
          hval_V_inj (hMV_prod.trans hprod_eval)
        have hMV_in_mV : M_V.prod ∈ IsLocalRing.maximalIdeal V := by
          rw [hMV_eq]
          exact (hmS_mem A _).mp hga_m
        obtain ⟨w₀, hw₀_MV, hw₀_mV⟩ :=
          (hmV_prime.multiset_prod_mem_iff_exists_mem M_V).mp hMV_in_mV
        obtain ⟨r₀, hr₀_roots, hw₀_val⟩ := hMV_mem w₀ hw₀_MV
        obtain ⟨y_V, hy_V_val⟩ := hroots_in_V r₀ hr₀_roots
        have hw₀_eq : w₀ = a_A.1 - y_V := by
          apply hval_V_inj
          rw [hw₀_val, map_sub, hy_V_val]
          rfl
        refine ⟨y_V, ?_, ?_⟩
        · rw [hy_V_val]
          exact (Polynomial.mem_roots hg_K_monic.ne_zero).mp hr₀_roots
        · have : -(a_A.1 - y_V) ∈ IsLocalRing.maximalIdeal V :=
            (IsLocalRing.maximalIdeal V).neg_mem (hw₀_eq ▸ hw₀_mV)
          simpa using this
      obtain ⟨y_V, hy_V_eval, hy_sub_mV⟩ := hex_root_mV
      let A' : Subalgebra R₀ V := Algebra.adjoin R₀ ((A : Set V) ∪ {y_V})
      have hA_le_A' : A ≤ A' := fun x hx => Algebra.subset_adjoin (Or.inl hx)
      have hy_in_A' : y_V ∈ A' := Algebra.subset_adjoin (Or.inr rfl)
      have hFT_A' : Algebra.FiniteType R₀ ↥A' := hFT_adjoin_singleton y_V hA_inD.1
      let incl_AA' : ↥(S_of A) →+* ↥(S_of A') :=
