        (S ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck U) :=
      congrArg (fun (J : CategoryTheory.GrothendieckTopology Z.Etale) => S ∈ J U)
        (AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) (S := Z) le_rfl)
    exact (iff_of_eq h1).trans
      (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology (P := P_et) (Q := P_et) U S)
  have etale_of_postcomp_aux : ∀ {X Y Z : AlgebraicGeometry.Scheme.{u}}
      (f : X ⟶ Y) (g : Y ⟶ Z),
      AlgebraicGeometry.Etale g → AlgebraicGeometry.Etale (f ≫ g) →
      AlgebraicGeometry.Etale f :=
    fun f g hg hfg =>
      CategoryTheory.MorphismProperty.of_postcomp
        (W := @AlgebraicGeometry.Etale) (W' := @AlgebraicGeometry.Etale) f g hg hfg
  have sheaf_mono_app_injective_aux : ∀ (Z : AlgebraicGeometry.Scheme.{u})
      {𝒢 ℱ : CategoryTheory.Sheaf Z.smallEtaleTopology
        (ModuleCat.{u, u} (ULift.{u, 0} (ZMod m)))}
      (ι : 𝒢 ⟶ ℱ) [CategoryTheory.Mono ι] (W : Z.Etale),
      Function.Injective ((ι.hom.app (Opposite.op W)).hom) := by
    intro Z 𝒢 ℱ ι _ W
    let R := ULift.{u, 0} (ZMod m)
    let K_pre : (Z.Etale)ᵒᵖ ⥤ ModuleCat.{u, u} R :=
      { obj := fun U_op =>
          ModuleCat.of R ↥(LinearMap.ker (ι.hom.app U_op).hom)
        map := fun {U₂_op U₁_op} f_op =>
          ModuleCat.ofHom
            { toFun := fun x =>
                ⟨(𝒢.obj.map f_op).hom x.1, by
                  rw [LinearMap.mem_ker]
                  have h_nat := congrArg
                    (fun (k : 𝒢.obj.obj U₂_op ⟶ ℱ.obj.obj U₁_op) => k.hom x.1)
                    (ι.hom.naturality f_op)
                  change (ι.hom.app U₁_op).hom ((𝒢.obj.map f_op).hom x.1) =
                    (ℱ.obj.map f_op).hom ((ι.hom.app U₂_op).hom x.1) at h_nat
                  rw [h_nat, LinearMap.mem_ker.mp x.2, map_zero]⟩
              map_add' := fun x₁ x₂ => Subtype.ext (map_add _ x₁.1 x₂.1)
              map_smul' := fun r x => Subtype.ext (map_smul _ r x.1) }
        map_id := fun U_op => by
          apply ModuleCat.hom_ext
          ext x
          change (𝒢.obj.map (𝟙 U_op)).hom x.1 = x.1
          rw [𝒢.obj.map_id]
          rfl
