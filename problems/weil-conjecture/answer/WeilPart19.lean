      have _ : P_R.Additive := { map_add := by intros; ext W x; rfl }
      let R_mod := ModuleCat.of R R
      let oneR := weilEtaleModuleUnit S m
      let adjR := CategoryTheory.constantSheafAdj J (ModuleCat.{u, u} R) (hT_of S)
      let αR : oneR ⟶ P_R.obj oneR :=
        (adjR.homEquiv R_mod (P_R.obj oneR)).symm (adjR.unit.app R_mod ≫ oneR.obj.map μ₀.op)
      let βR : P_R.obj oneR ⟶ oneR :=
