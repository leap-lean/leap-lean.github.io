    · 
      intro m i j c hc f_i f_j f_c θ_i θ_j θ_c hf_i hf_j hf_c hθ_i hθ_j hθ_c a b a' b' ha' hb'
      rw [hf_of_uniq m i f_i hf_i, hθ_of_uniq S m i θ_i hθ_i] at ha'
