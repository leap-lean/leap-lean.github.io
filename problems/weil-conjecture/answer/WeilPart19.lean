        let S_w := (pt W Ω w).sheafFiber (A := AddCommGrpCat.{u})
        have : CategoryTheory.Mono (S_w.map φ) := (AddCommGrpCat.mono_iff_injective _).mpr hinj
        let hc := CategoryTheory.Limits.isLimitOfPreserves S_w (CategoryTheory.Limits.kernelIsKernel φ)
