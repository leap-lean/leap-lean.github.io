        (fun u v _ _ hu hv => by rw [map_mul]; exact B₁.mul_mem hu hv) hr_mem
      exact Algebra.subset_adjoin (Finset.mem_coe.mpr (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hy)))
    let j₁ : R₁ →ₐ[k] ↥B₁ :=
      { toFun := fun r => ⟨φ_K r, hR₁_in_B₁ r⟩
        map_one' := by ext; exact map_one φ_K
        map_mul' := fun a b => by ext; exact map_mul φ_K a b
        map_zero' := by ext; exact map_zero φ_K
        map_add' := fun a b => by ext; exact map_add φ_K a b
        commutes' := fun c => by ext; exact AlgHom.commutes φ_K c }
    have hj₁_inj : Function.Injective j₁ := by
      intro a b hab
      exact IsFractionRing.injective R₁ K₁ (congrArg Subtype.val hab)
    have hB₁_in_W : ∀ z ∈ B₁, z ∈ W_v.toSubring := by
      intro z hz
      refine Algebra.adjoin_induction (fun y hy => ?_)
        (fun c => by
          change algebraMap R₁ K₁ (algebraMap k R₁ c) ∈ W_v.toSubring
