              rw [(eqv_U' U'₁).apply_symm_apply]
              exact h_nat.symm } }
    exact ⟨{
      hom := β_hom
      inv := β_inv
      hom_inv_id := by
        apply CategoryTheory.Sheaf.hom_ext
        ext U'_op s
        exact (eqv_U' U'_op.unop).symm_apply_apply s
      inv_hom_id := by
        apply CategoryTheory.Sheaf.hom_ext
        ext U'_op t
        exact (eqv_U' U'_op.unop).apply_symm_apply t }, hβ_comm⟩
  have hMono_N₀ : CategoryTheory.Mono ((Q N₀).arrow ≫ e_M₁.hom) := hMono_Q' N₀
  let u_N₀ := @CategoryTheory.Subobject.underlyingIso _ _ _ _ ((Q N₀).arrow ≫ e_M₁.hom) hMono_N₀
  have hu_N₀_arr : (Q N₀).arrow ≫ e_M₁.hom = u_N₀.inv ≫ (Q' N₀).arrow := by
    have h1 : u_N₀.hom ≫ ((Q N₀).arrow ≫ e_M₁.hom) = (Q' N₀).arrow :=
      @CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk _ _ _ _
        ((Q N₀).arrow ≫ e_M₁.hom) hMono_N₀
    rw [← h1, ← CategoryTheory.Category.assoc, u_N₀.inv_hom_id, CategoryTheory.Category.id_comp]
  obtain ⟨β_N₀, hβ_N₀_comm⟩ := h_beta_ex N₀ le_rfl
  refine ⟨?_, ?_⟩
  · intro n hn
    have hMono_n : CategoryTheory.Mono ((Q n).arrow ≫ e_M₁.hom) := hMono_Q' n
    let u_n := @CategoryTheory.Subobject.underlyingIso _ _ _ _ ((Q n).arrow ≫ e_M₁.hom) hMono_n
    obtain ⟨β_n, hβ_n_comm⟩ := h_beta_ex n hn
    let v_n := CategoryTheory.Subobject.ofLE (Q N₀) (Q n) (Q.monotone hn)
    let v'_n := CategoryTheory.Subobject.ofLE (Q' N₀) (Q' n) (Q'.monotone hn)
    have hv'_beta : J_push.map v'_n ≫ β_n.hom = β_N₀.hom := by
      apply (CategoryTheory.cancel_mono (L_O.map ι₀)).mp
      calc
        (J_push.map v'_n ≫ β_n.hom) ≫ L_O.map ι₀
          = J_push.map v'_n ≫ (β_n.hom ≫ L_O.map ι₀) := CategoryTheory.Category.assoc _ _ _
        _ = J_push.map v'_n ≫ (J_push.map (Q' n).arrow ≫ e_loc.hom) := by rw [hβ_n_comm]
        _ = (J_push.map v'_n ≫ J_push.map (Q' n).arrow) ≫ e_loc.hom :=
            (CategoryTheory.Category.assoc _ _ _).symm
        _ = J_push.map (v'_n ≫ (Q' n).arrow) ≫ e_loc.hom := by rw [← J_push.map_comp]
        _ = J_push.map (Q' N₀).arrow ≫ e_loc.hom := by
            rw [CategoryTheory.Subobject.ofLE_arrow]
        _ = β_N₀.hom ≫ L_O.map ι₀ := hβ_N₀_comm.symm
    have hv'_eq : J_push.map v'_n = β_N₀.hom ≫ β_n.inv := by
      have h := congrArg (· ≫ β_n.inv) hv'_beta
      simpa only [CategoryTheory.Category.assoc, β_n.hom_inv_id,
        CategoryTheory.Category.comp_id] using h
    have : CategoryTheory.IsIso (J_push.map v'_n) := by
      rw [hv'_eq]
      infer_instance
    have hv_rel : v_n = u_N₀.inv ≫ v'_n ≫ u_n.hom := by
      apply (CategoryTheory.cancel_mono ((Q n).arrow ≫ e_M₁.hom)).mp
      have hu_n_arr : u_n.hom ≫ ((Q n).arrow ≫ e_M₁.hom) = (Q' n).arrow :=
        @CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk _ _ _ _
          ((Q n).arrow ≫ e_M₁.hom) hMono_n
      calc
        v_n ≫ ((Q n).arrow ≫ e_M₁.hom)
          = (v_n ≫ (Q n).arrow) ≫ e_M₁.hom := (CategoryTheory.Category.assoc _ _ _).symm
        _ = (Q N₀).arrow ≫ e_M₁.hom := by rw [CategoryTheory.Subobject.ofLE_arrow]
        _ = u_N₀.inv ≫ (Q' N₀).arrow := hu_N₀_arr
        _ = u_N₀.inv ≫ (v'_n ≫ (Q' n).arrow) := by
            rw [CategoryTheory.Subobject.ofLE_arrow]
        _ = u_N₀.inv ≫ (v'_n ≫ (u_n.hom ≫ ((Q n).arrow ≫ e_M₁.hom))) := by
            rw [hu_n_arr]
        _ = (u_N₀.inv ≫ v'_n ≫ u_n.hom) ≫ ((Q n).arrow ≫ e_M₁.hom) := by
            simp only [CategoryTheory.Category.assoc]
    have : CategoryTheory.IsIso (J_push.map v_n) := by
      rw [hv_rel, J_push.map_comp, J_push.map_comp]
      infer_instance
    have hpb_fac : pb_O.map v_n =
        e_pb.hom.app _ ≫ J_push.map v_n ≫ e_pb.inv.app _ := by
      have h_nat := congrArg (· ≫ e_pb.inv.app _) (e_pb.hom.naturality v_n)
      simpa only [CategoryTheory.Category.assoc, CategoryTheory.Iso.hom_inv_id_app,
        CategoryTheory.Category.comp_id] using h_nat
    rw [hpb_fac]
    infer_instance
  · let adj_B := B_O.sheafAdjunctionContinuous (ModuleCat.{u, u} R)
      V₁.smallEtaleTopology (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology
    have : pb_O.IsLeftAdjoint := adj_B.isLeftAdjoint
    let e_cok₁ : pb_O.obj (CategoryTheory.Limits.cokernel (Q N₀).arrow) ≅
        CategoryTheory.Limits.cokernel (pb_O.map (Q N₀).arrow) :=
      CategoryTheory.Limits.PreservesCokernel.iso pb_O (Q N₀).arrow
    let p_iso : pb_O.obj (Q N₀ : CategoryTheory.Sheaf V₁.smallEtaleTopology (ModuleCat.{u, u} R)) ≅
        C_O.obj M₀ :=
      (e_pb.app _) ≪≫ J_push.mapIso u_N₀.symm ≪≫ β_N₀ ≪≫ (Θ_O.symm.app M₀)
    let q_iso : pb_O.obj (C₁.obj M) ≅ C_O.obj M :=
      (e_pb.app _) ≪≫ J_push.mapIso e_M₁ ≪≫ e_loc ≪≫ (Θ_O.symm.app M)
    have h_sq : pb_O.map (Q N₀).arrow ≫ q_iso.hom = p_iso.hom ≫ C_O.map ι₀ := by
      dsimp only [p_iso, q_iso, CategoryTheory.Iso.trans_hom, CategoryTheory.Functor.mapIso_hom,
        CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.app_hom]
      calc
        pb_O.map (Q N₀).arrow ≫
            (e_pb.hom.app (C₁.obj M) ≫ J_push.map e_M₁.hom ≫ e_loc.hom ≫ Θ_O.inv.app M)
          = (pb_O.map (Q N₀).arrow ≫ e_pb.hom.app (C₁.obj M)) ≫
              J_push.map e_M₁.hom ≫ e_loc.hom ≫ Θ_O.inv.app M := by
            simp only [CategoryTheory.Category.assoc]
        _ = (e_pb.hom.app _ ≫ J_push.map (Q N₀).arrow) ≫
              J_push.map e_M₁.hom ≫ e_loc.hom ≫ Θ_O.inv.app M := by
            rw [e_pb.hom.naturality (Q N₀).arrow]
        _ = e_pb.hom.app _ ≫ (J_push.map (Q N₀).arrow ≫ J_push.map e_M₁.hom) ≫
              e_loc.hom ≫ Θ_O.inv.app M := by
            simp only [CategoryTheory.Category.assoc]
        _ = e_pb.hom.app _ ≫ J_push.map ((Q N₀).arrow ≫ e_M₁.hom) ≫
              e_loc.hom ≫ Θ_O.inv.app M := by
            rw [← J_push.map_comp]
        _ = e_pb.hom.app _ ≫ J_push.map (u_N₀.inv ≫ (Q' N₀).arrow) ≫
              e_loc.hom ≫ Θ_O.inv.app M :=
            congrArg (fun k => e_pb.hom.app _ ≫ J_push.map k ≫ e_loc.hom ≫ Θ_O.inv.app M)
              hu_N₀_arr
        _ = e_pb.hom.app _ ≫ J_push.map u_N₀.inv ≫
              (J_push.map (Q' N₀).arrow ≫ e_loc.hom) ≫ Θ_O.inv.app M := by
            rw [J_push.map_comp]
            simp only [CategoryTheory.Category.assoc]
        _ = e_pb.hom.app _ ≫ J_push.map u_N₀.inv ≫
              (β_N₀.hom ≫ L_O.map ι₀) ≫ Θ_O.inv.app M := by
            rw [hβ_N₀_comm]
        _ = e_pb.hom.app _ ≫ J_push.map u_N₀.inv ≫ β_N₀.hom ≫
              (L_O.map ι₀ ≫ Θ_O.inv.app M) := by
            simp only [CategoryTheory.Category.assoc]
        _ = e_pb.hom.app _ ≫ J_push.map u_N₀.inv ≫ β_N₀.hom ≫
              (Θ_O.inv.app M₀ ≫ C_O.map ι₀) := by
            rw [Θ_O.inv.naturality ι₀]
        _ = (e_pb.hom.app _ ≫ J_push.map u_N₀.inv ≫ β_N₀.hom ≫ Θ_O.inv.app M₀) ≫
              C_O.map ι₀ := by
            simp only [CategoryTheory.Category.assoc]
    let e_cok₂ : CategoryTheory.Limits.cokernel (pb_O.map (Q N₀).arrow) ≅
        CategoryTheory.Limits.cokernel (C_O.map ι₀) :=
      CategoryTheory.Limits.cokernel.mapIso (pb_O.map (Q N₀).arrow) (C_O.map ι₀) p_iso q_iso h_sq
    let FF_O := AlgebraicGeometry.Scheme.Etale.forgetFullyFaithful
      (O : AlgebraicGeometry.Scheme.{u})
    let T_O : (O : AlgebraicGeometry.Scheme.{u}).Etale :=
      CategoryTheory.MorphismProperty.Over.mk ⊤
        (𝟙 (O : AlgebraicGeometry.Scheme.{u}))
        (inferInstance : AlgebraicGeometry.Etale (𝟙 (O : AlgebraicGeometry.Scheme.{u})))
    let from_TO : ∀ W : (O : AlgebraicGeometry.Scheme.{u}).Etale, W ⟶ T_O :=
      fun W => FF_O.preimage (CategoryTheory.Over.homMk (F_O.obj W).hom
        (CategoryTheory.Category.comp_id (F_O.obj W).hom))
    have hT_O : CategoryTheory.Limits.IsTerminal T_O :=
      CategoryTheory.Limits.IsTerminal.ofUniqueHom from_TO (fun W m_hom => by
        apply F_O.map_injective
        ext1
        have hm_w : (F_O.map m_hom).left ≫ 𝟙 (O : AlgebraicGeometry.Scheme.{u}) =
            (F_O.obj W).hom := (F_O.map m_hom).w
        have hfrom : (F_O.map (from_TO W)).left = (F_O.obj W).hom :=
          congrArg CategoryTheory.Over.Hom.left (FF_O.map_preimage _)
        erw [hfrom, ← hm_w, CategoryTheory.Category.comp_id])
    let adj_C := CategoryTheory.constantSheafAdj
      (O : AlgebraicGeometry.Scheme.{u}).smallEtaleTopology (ModuleCat.{u, u} R) hT_O
    have : C_O.IsLeftAdjoint := adj_C.isLeftAdjoint
    let e_cok₃ : C_O.obj (CategoryTheory.Limits.cokernel ι₀) ≅
        CategoryTheory.Limits.cokernel (C_O.map ι₀) :=
      CategoryTheory.Limits.PreservesCokernel.iso C_O ι₀
    exact ⟨e_cok₁ ≪≫ e_cok₂ ≪≫ e_cok₃.symm⟩

theorem weil_etale_noetherian_two_term_affine_presentation (S : AlgebraicGeometry.Scheme.{u}) (m : ℕ) :
    let R := ULift.{u, 0} (ZMod m)
    let R_mod : ModuleCat.{u, u} R := ModuleCat.of R R
    let J := S.smallEtaleTopology
    let 𝒞 := CategoryTheory.Sheaf J (ModuleCat.{u, u} R)
    (∀ (W : S.Etale),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left →
      CategoryTheory.IsNoetherianObject
        (CategoryTheory.Sheaf.freeYoneda J W R_mod)) →
    ∀ (P : 𝒞), CategoryTheory.IsNoetherianObject P →
      ∃ (W₀ W₁ : S.Etale)
        (_ : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₀).left)
        (_ : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj W₁).left)
        (ψ : Quiver.Hom
          (CategoryTheory.Sheaf.freeYoneda J W₁ R_mod)
          (CategoryTheory.Sheaf.freeYoneda J W₀ R_mod)),
        Nonempty (CategoryTheory.Iso P (CategoryTheory.Limits.cokernel ψ)) :=
by
  classical
  intro R R_mod J 𝒞 hNoethGen P hNoethP
  let L : S.Etale → 𝒞 := fun W => CategoryTheory.Sheaf.freeYoneda J W R_mod
  let ℐ : Type (u + 1) :=
    { W : S.Etale // AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left }
  
  have h_eyon_comp : ∀ (W : S.Etale) {𝒢₁ 𝒢₂ : 𝒞}
      (β : L W ⟶ 𝒢₁) (g : 𝒢₁ ⟶ 𝒢₂),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (β ≫ g) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv β ≫ g.hom.app (Opposite.op W) := by
    intro W 𝒢₁ 𝒢₂ β g
    let β' : (CategoryTheory.presheafToSheaf J (ModuleCat.{u, u} R)).obj
        (CategoryTheory.Presheaf.freeYoneda W R_mod) ⟶ 𝒢₁ := β
    change CategoryTheory.Presheaf.freeYonedaHomEquiv
        (((CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).homEquiv
          (CategoryTheory.Presheaf.freeYoneda W R_mod) 𝒢₂) (β' ≫ g)) =
      CategoryTheory.Presheaf.freeYonedaHomEquiv
        (((CategoryTheory.sheafificationAdjunction J (ModuleCat.{u, u} R)).homEquiv
          (CategoryTheory.Presheaf.freeYoneda W R_mod) 𝒢₁) β') ≫
        g.hom.app (Opposite.op W)
    rw [CategoryTheory.Adjunction.homEquiv_naturality_right]
    exact CategoryTheory.Presheaf.freeYonedaHomEquiv_comp _ g.hom
  have h_eyon_zero : ∀ (W : S.Etale) (𝒢 : 𝒞),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L W ⟶ 𝒢) = 0 := by
    intro W 𝒢
    have h00 : (0 : L W ⟶ 𝒢) = (0 : L W ⟶ 𝒢) ≫ (0 : 𝒢 ⟶ 𝒢) :=
      (CategoryTheory.Limits.comp_zero).symm
    rw [h00, h_eyon_comp]
    have happ0 : (0 : 𝒢 ⟶ 𝒢).hom.app (Opposite.op W) = 0 := rfl
    rw [happ0, CategoryTheory.Limits.comp_zero]
  let L_map : ∀ {W₁ W₂ : S.Etale}, (W₁ ⟶ W₂) → (L W₁ ⟶ L W₂) :=
    fun {W₁ W₂} g =>
      CategoryTheory.Sheaf.freeYonedaHomEquiv.symm
        (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L W₂)) ≫ (L W₂).obj.map g.op)
  have h_L_map_comp : ∀ {W₁ W₂ : S.Etale} (g : W₁ ⟶ W₂) {Q : 𝒞} (u : L W₂ ⟶ Q),
      CategoryTheory.Sheaf.freeYonedaHomEquiv (L_map g ≫ u) =
        CategoryTheory.Sheaf.freeYonedaHomEquiv u ≫ Q.obj.map g.op := by
    intro W₁ W₂ g Q u
    calc
      CategoryTheory.Sheaf.freeYonedaHomEquiv (L_map g ≫ u)
        = CategoryTheory.Sheaf.freeYonedaHomEquiv (L_map g) ≫ u.hom.app (Opposite.op W₁) :=
          h_eyon_comp W₁ (L_map g) u
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L W₂)) ≫ (L W₂).obj.map g.op) ≫
            u.hom.app (Opposite.op W₁) := by
          dsimp [L_map]
          rw [Equiv.apply_symm_apply]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L W₂)) ≫
            ((L W₂).obj.map g.op ≫ u.hom.app (Opposite.op W₁)) := by
          rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L W₂)) ≫
            (u.hom.app (Opposite.op W₂) ≫ Q.obj.map g.op) := by
          rw [u.hom.naturality g.op]
      _ = (CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L W₂)) ≫ u.hom.app (Opposite.op W₂)) ≫
            Q.obj.map g.op := by
          rw [CategoryTheory.Category.assoc]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (𝟙 (L W₂) ≫ u) ≫ Q.obj.map g.op := by
          rw [← h_eyon_comp W₂ (𝟙 (L W₂)) u]
      _ = CategoryTheory.Sheaf.freeYonedaHomEquiv u ≫ Q.obj.map g.op := by
          rw [CategoryTheory.Category.id_comp]
  
  let X_empty : AlgebraicGeometry.Scheme.{u} := ⊥_ AlgebraicGeometry.Scheme.{u}
  let f_empty : X_empty ⟶ S := CategoryTheory.Limits.initial.to S
  have : AlgebraicGeometry.IsOpenImmersion f_empty :=
    AlgebraicGeometry.isOpenImmersion_of_isEmpty f_empty
  let W_init : S.Etale :=
    CategoryTheory.MorphismProperty.Over.mk ⊤ f_empty
      (inferInstance : AlgebraicGeometry.Etale f_empty)
  let w_init : ℐ := ⟨W_init, (inferInstance : AlgebraicGeometry.IsAffine X_empty)⟩
  have hSep : ∀ {ℱ₁ ℱ₂ : 𝒞} (α : ℱ₁ ⟶ ℱ₂), α ≠ 0 →
      ∃ (w : ℐ) (u : L w.1 ⟶ ℱ₁), u ≫ α ≠ 0 := by
    intro ℱ₁ ℱ₂ α hα
    let E_aff :=
      (AlgebraicGeometry.Scheme.AffineEtale.sheafEquiv S (ModuleCat.{u, u} R)).inverse
    have hExU₀ : ∃ U₀ : S.AffineEtale,
        α.hom.app (Opposite.op ((AlgebraicGeometry.Scheme.AffineEtale.Spec S).obj U₀)) ≠ 0 := by
      by_contra hNoU₀
      apply hα
      apply E_aff.map_injective
      apply CategoryTheory.Sheaf.hom_ext
      ext ⟨U₀⟩ : 2
      exact Classical.not_not.mp (fun hne => hNoU₀ ⟨U₀, hne⟩)
    obtain ⟨U₀, hαU₀⟩ := hExU₀
    let W : S.Etale := (AlgebraicGeometry.Scheme.AffineEtale.Spec S).obj U₀
    have hAffW : AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left :=
      AlgebraicGeometry.isAffine_Spec U₀.left.unop
    let α_W : ℱ₁.obj.obj (Opposite.op W) ⟶ ℱ₂.obj.obj (Opposite.op W) :=
      α.hom.app (Opposite.op W)
    have hEx_x : ∃ x : ↑(ℱ₁.obj.obj (Opposite.op W)), α_W.hom x ≠ 0 := by
      by_contra hNox
      apply hαU₀
      change α_W = 0
      ext x
      exact Classical.not_not.mp (fun hne => hNox ⟨x, hne⟩)
    obtain ⟨x, hx⟩ := hEx_x
    let φ_x : R_mod ⟶ ℱ₁.obj.obj (Opposite.op W) :=
      ModuleCat.ofHom (LinearMap.toSpanSingleton R (↑(ℱ₁.obj.obj (Opposite.op W))) x)
    let u : L W ⟶ ℱ₁ := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm φ_x
    refine ⟨⟨W, hAffW⟩, u, ?_⟩
    intro hu0
    have hcomp0 : φ_x ≫ α_W = 0 := by
      calc
        φ_x ≫ α_W
          = CategoryTheory.Sheaf.freeYonedaHomEquiv u ≫ α_W := by
            dsimp [u]; rw [Equiv.apply_symm_apply]
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (u ≫ α) :=
            (h_eyon_comp W u α).symm
        _ = CategoryTheory.Sheaf.freeYonedaHomEquiv (0 : L W ⟶ ℱ₂) := by rw [hu0]
        _ = 0 := h_eyon_zero W ℱ₂
    have heval := congrArg (fun k : R_mod ⟶ ℱ₂.obj.obj (Opposite.op W) => k.hom (1 : R)) hcomp0
    change α_W.hom ((1 : R) • x) = 0 at heval
    rw [one_smul] at heval
    exact hx heval
  
  letI : CategoryTheory.Category.{u, u + 1}
      (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale.{u}) ⊤ S) :=
    AlgebraicGeometry.Scheme.instCategoryEtale.{u} S
  letI : CategoryTheory.Limits.HasPullbacks
      (CategoryTheory.MorphismProperty.Over (@AlgebraicGeometry.Etale.{u}) ⊤ S) :=
    AlgebraicGeometry.Scheme.instHasPullbacksEtale.{u} S
  have : AlgebraicGeometry.IsZariskiLocalAtSource (@AlgebraicGeometry.Etale.{u}) :=
    AlgebraicGeometry.HasRingHomProperty.instIsZariskiLocalAtSource (Q := @RingHom.Etale.{u, u})
  have : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale.{u}) :=
    @CategoryTheory.MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _
      (@AlgebraicGeometry.Etale.{u}) AlgebraicGeometry.Etale.instIsMultiplicativeScheme.{u}
  have hCoprod : ∀ (w_a w_b : ℐ),
      ∃ (w_ab : ℐ) (ι_a : L w_a.1 ⟶ L w_ab.1) (ι_b : L w_b.1 ⟶ L w_ab.1),
        ∀ {Q : 𝒞} (u_a : L w_a.1 ⟶ Q) (u_b : L w_b.1 ⟶ Q),
          ∃ (u_ab : L w_ab.1 ⟶ Q), ι_a ≫ u_ab = u_a ∧ ι_b ≫ u_ab = u_b := by
    intro ⟨W_a, hAff_a⟩ ⟨W_b, hAff_b⟩
    let X_a : AlgebraicGeometry.Scheme.{u} := W_a.left
    let X_b : AlgebraicGeometry.Scheme.{u} := W_b.left
    let f_a : X_a ⟶ S := W_a.hom
    let f_b : X_b ⟶ S := W_b.hom
    have : AlgebraicGeometry.IsAffine X_a := hAff_a
    have : AlgebraicGeometry.IsAffine X_b := hAff_b
    have : AlgebraicGeometry.Etale f_a := W_a.prop
    have : AlgebraicGeometry.Etale f_b := W_b.prop
    let X_ab : AlgebraicGeometry.Scheme.{u} := CategoryTheory.Limits.coprod X_a X_b
    let j_a : X_a ⟶ X_ab := CategoryTheory.Limits.coprod.inl
    let j_b : X_b ⟶ X_ab := CategoryTheory.Limits.coprod.inr
    let f_ab : X_ab ⟶ S := CategoryTheory.Limits.coprod.desc f_a f_b
    have hAff_ab : AlgebraicGeometry.IsAffine X_ab := inferInstance
    let U_cov : Bool → X_ab.Opens := fun c => Bool.rec j_a.opensRange j_b.opensRange c
    have hSup_top : iSup U_cov = ⊤ := by
      rw [iSup_bool_eq, sup_comm]
      exact (AlgebraicGeometry.isCompl_opensRange_inl_inr X_a X_b).sup_eq_top
    have hf_ab : AlgebraicGeometry.Etale f_ab := by
      rw [AlgebraicGeometry.IsZariskiLocalAtSource.iff_of_iSup_eq_top
        (P := @AlgebraicGeometry.Etale.{u}) U_cov hSup_top]
      intro c
      cases c with
      | false =>
        have h_fac : (U_cov false).ι ≫ f_ab = (j_a.isoOpensRange).inv ≫ f_a := by
          calc
            (U_cov false).ι ≫ f_ab
              = ((j_a.isoOpensRange).inv ≫ (j_a.isoOpensRange).hom) ≫ j_a.opensRange.ι ≫ f_ab := by
                rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
            _ = (j_a.isoOpensRange).inv ≫ ((j_a.isoOpensRange).hom ≫ j_a.opensRange.ι) ≫ f_ab := by
                simp only [CategoryTheory.Category.assoc]
            _ = (j_a.isoOpensRange).inv ≫ j_a ≫ f_ab := by
                rw [AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι j_a]
            _ = (j_a.isoOpensRange).inv ≫ f_a := by
                rw [CategoryTheory.Limits.coprod.inl_desc]
        rw [h_fac]
        infer_instance
      | true =>
        have h_fac : (U_cov true).ι ≫ f_ab = (j_b.isoOpensRange).inv ≫ f_b := by
          calc
            (U_cov true).ι ≫ f_ab
              = ((j_b.isoOpensRange).inv ≫ (j_b.isoOpensRange).hom) ≫ j_b.opensRange.ι ≫ f_ab := by
                rw [CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp]
            _ = (j_b.isoOpensRange).inv ≫ ((j_b.isoOpensRange).hom ≫ j_b.opensRange.ι) ≫ f_ab := by
                simp only [CategoryTheory.Category.assoc]
            _ = (j_b.isoOpensRange).inv ≫ j_b ≫ f_ab := by
                rw [AlgebraicGeometry.Scheme.Hom.isoOpensRange_hom_ι j_b]
            _ = (j_b.isoOpensRange).inv ≫ f_b := by
                rw [CategoryTheory.Limits.coprod.inr_desc]
        rw [h_fac]
        infer_instance
    let W_ab : S.Etale := CategoryTheory.MorphismProperty.Over.mk ⊤ f_ab hf_ab
    let i_a : W_a ⟶ W_ab :=
      CategoryTheory.MorphismProperty.Over.homMk j_a
        (CategoryTheory.Limits.coprod.inl_desc f_a f_b) trivial
    let i_b : W_b ⟶ W_ab :=
      CategoryTheory.MorphismProperty.Over.homMk j_b
        (CategoryTheory.Limits.coprod.inr_desc f_a f_b) trivial
    refine ⟨⟨W_ab, hAff_ab⟩, L_map i_a, L_map i_b, ?_⟩
    intro Q u_a u_b
    let P_Q : (S.Etale)ᵒᵖ ⥤ Type u := Q.obj ⋙ CategoryTheory.coyoneda.obj (Opposite.op R_mod)
    have hSheafPQ : CategoryTheory.Presieve.IsSheaf J P_Q := Q.property R_mod
    have hJ_eq : J = S.smallEtalePretopology.toGrothendieck :=
      AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale.{u}) (Q := @AlgebraicGeometry.Etale.{u}) S le_rfl
    have hEmptySub : ∀ (E : S.Etale), IsEmpty ↥E.left → Subsingleton (P_Q.obj (Opposite.op E)) := by
      intro E hEmp
      have h_bot_J : (⊥ : CategoryTheory.Sieve E) ∈ J E := by
        rw [hJ_eq]
        exact (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
          (P := @AlgebraicGeometry.Etale.{u}) (Q := @AlgebraicGeometry.Etale.{u}) E _).mpr
          (fun x => IsEmpty.elim hEmp x)
      have h_gen_bot : CategoryTheory.Sieve.generate (⊥ : CategoryTheory.Presieve E) = ⊥ := by
        ext Y g
        simp
      have hSheafBot : CategoryTheory.Presieve.IsSheafFor P_Q (⊥ : CategoryTheory.Presieve E) :=
        hSheafPQ.isSheafFor (⊥ : CategoryTheory.Presieve E) (h_gen_bot.symm ▸ h_bot_J)
      refine ⟨fun s₁ s₂ => hSheafBot.isSeparatedFor.ext (fun Y g hg => False.elim hg)⟩
    let Y_cov : Bool → S.Etale := fun c => Bool.rec W_a W_b c
    let π_cov : ∀ c : Bool, Y_cov c ⟶ W_ab := fun c => Bool.rec i_a i_b c
    have h_cov_J : CategoryTheory.Sieve.generate (CategoryTheory.Presieve.ofArrows Y_cov π_cov) ∈ J W_ab := by
      rw [hJ_eq]
      refine (AlgebraicGeometry.Scheme.mem_toGrothendieck_smallPretopology
        (P := @AlgebraicGeometry.Etale.{u}) (Q := @AlgebraicGeometry.Etale.{u}) W_ab _).mpr ?_
      intro x
      have h_univ : Set.range j_a.base ∪ Set.range j_b.base = Set.univ :=
        (AlgebraicGeometry.isCompl_range_inl_inr X_a X_b).codisjoint.eq_top
      have hx_mem : x ∈ Set.range j_a.base ∪ Set.range j_b.base := by
        rw [h_univ]; trivial
      rcases hx_mem with ⟨y_a, hy_a⟩ | ⟨y_b, hy_b⟩
      · refine ⟨W_a, i_a, y_a, ?_, (inferInstance : AlgebraicGeometry.Etale j_a), hy_a⟩
        exact CategoryTheory.Sieve.le_generate _ _ _ (CategoryTheory.Presieve.ofArrows.mk false)
      · refine ⟨W_b, i_b, y_b, ?_, (inferInstance : AlgebraicGeometry.Etale j_b), hy_b⟩
        exact CategoryTheory.Sieve.le_generate _ _ _ (CategoryTheory.Presieve.ofArrows.mk true)
    have hSheafArrows : CategoryTheory.Presieve.IsSheafFor P_Q
        (CategoryTheory.Presieve.ofArrows Y_cov π_cov) :=
      hSheafPQ.isSheafFor _ h_cov_J
    let φ_sec : ∀ c : Bool, P_Q.obj (Opposite.op (Y_cov c)) :=
      fun c => Bool.rec (CategoryTheory.Sheaf.freeYonedaHomEquiv u_a)
        (CategoryTheory.Sheaf.freeYonedaHomEquiv u_b) c
    have hCompat : CategoryTheory.Presieve.Arrows.Compatible P_Q π_cov φ_sec := by
      intro c₁ c₂ Z g₁ g₂ h_comm
      have h_left : g₁.left ≫ (π_cov c₁).left = g₂.left ≫ (π_cov c₂).left :=
        congrArg (fun k : Z ⟶ W_ab => k.left) h_comm
      cases c₁ <;> cases c₂
      · have hg_l : g₁.left = g₂.left := (CategoryTheory.cancel_mono j_a).mp h_left
        have hg : g₁ = g₂ := CategoryTheory.MorphismProperty.Over.Hom.ext hg_l
        rw [hg]
      · have hZ_emp : IsEmpty ↥Z.left := ⟨fun z => by
          have hz := congrArg (fun k : Z.left ⟶ X_ab => k.base z) h_left
          exact Set.disjoint_iff.mp (AlgebraicGeometry.isCompl_range_inl_inr X_a X_b).disjoint
            ⟨⟨g₁.left.base z, rfl⟩, ⟨g₂.left.base z, hz.symm⟩⟩⟩
        have := hEmptySub Z hZ_emp
        exact Subsingleton.elim _ _
      · have hZ_emp : IsEmpty ↥Z.left := ⟨fun z => by
          have hz := congrArg (fun k : Z.left ⟶ X_ab => k.base z) h_left
          exact Set.disjoint_iff.mp (AlgebraicGeometry.isCompl_range_inl_inr X_a X_b).disjoint
            ⟨⟨g₂.left.base z, rfl⟩, ⟨g₁.left.base z, hz⟩⟩⟩
        have := hEmptySub Z hZ_emp
        exact Subsingleton.elim _ _
      · have hg_l : g₁.left = g₂.left := (CategoryTheory.cancel_mono j_b).mp h_left
        have hg : g₁ = g₂ := CategoryTheory.MorphismProperty.Over.Hom.ext hg_l
        rw [hg]
    obtain ⟨φ_ab, hφ_ab, _⟩ :=
      (CategoryTheory.Presieve.isSheafFor_arrows_iff P_Q π_cov).mp hSheafArrows φ_sec hCompat
    let u_ab : L W_ab ⟶ Q := CategoryTheory.Sheaf.freeYonedaHomEquiv.symm φ_ab
    refine ⟨u_ab, ?_, ?_⟩
    · apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [h_L_map_comp i_a u_ab]
      have h_res_a := hφ_ab false
      dsimp [P_Q, Y_cov, π_cov, φ_sec, u_ab] at h_res_a ⊢
      rw [Equiv.apply_symm_apply]
      exact h_res_a
    · apply CategoryTheory.Sheaf.freeYonedaHomEquiv.injective
      rw [h_L_map_comp i_b u_ab]
      have h_res_b := hφ_ab true
      dsimp [P_Q, Y_cov, π_cov, φ_sec, u_ab] at h_res_b ⊢
      rw [Equiv.apply_symm_apply]
      exact h_res_b
  
  have hEpiCover : ∀ (Q : 𝒞), CategoryTheory.IsNoetherianObject Q →
      ∃ (w₀ : ℐ) (e₀ : L w₀.1 ⟶ Q), CategoryTheory.Epi e₀ := by
    intro Q hNoethQ
    have : CategoryTheory.IsNoetherianObject Q := hNoethQ
    let ImSub : ∀ (w : ℐ), (L w.1 ⟶ Q) → CategoryTheory.Subobject Q :=
      fun w u => CategoryTheory.Subobject.mk
        (CategoryTheory.Limits.kernel.ι (CategoryTheory.Limits.cokernel.π u))
    let S_sub : Set (CategoryTheory.Subobject Q) :=
      { X | ∃ (w : ℐ) (u : L w.1 ⟶ Q), X = ImSub w u }
    have hS_ne : S_sub.Nonempty := ⟨ImSub w_init 0, w_init, 0, rfl⟩
    obtain ⟨X₀, ⟨w₀, u₀, rfl⟩, hMax⟩ :=
      (wellFounded_gt (α := CategoryTheory.Subobject Q)).has_min S_sub hS_ne
    refine ⟨w₀, u₀, ?_⟩
    let π₀ := CategoryTheory.Limits.cokernel.π u₀
    have hπ₀_zero : π₀ = 0 := by
      by_contra hπ₀_ne
      obtain ⟨w₁, v, hv_ne⟩ := hSep π₀ hπ₀_ne
      obtain ⟨w₀₁, ι_a, ι_b, hAmalg⟩ := hCoprod w₀ w₁
      obtain ⟨u₀₁, hu_a, hu_b⟩ := hAmalg u₀ v
      let π₀₁ := CategoryTheory.Limits.cokernel.π u₀₁
      have hu₀_π₀₁ : u₀ ≫ π₀₁ = 0 := by
        rw [← hu_a, CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.condition,
          CategoryTheory.Limits.comp_zero]
      let q₀₁ := CategoryTheory.Limits.cokernel.desc u₀ π₀₁ hu₀_π₀₁
      have h_ker_π₀₁ : CategoryTheory.Limits.kernel.ι π₀ ≫ π₀₁ = 0 := by
        calc
          CategoryTheory.Limits.kernel.ι π₀ ≫ π₀₁
            = CategoryTheory.Limits.kernel.ι π₀ ≫ (π₀ ≫ q₀₁) := by
              rw [CategoryTheory.Limits.cokernel.π_desc]
          _ = (CategoryTheory.Limits.kernel.ι π₀ ≫ π₀) ≫ q₀₁ := by
              rw [CategoryTheory.Category.assoc]
          _ = 0 := by
              rw [CategoryTheory.Limits.kernel.condition, CategoryTheory.Limits.zero_comp]
      have h_le : ImSub w₀ u₀ ≤ ImSub w₀₁ u₀₁ := by
        refine CategoryTheory.Subobject.mk_le_mk_of_comm
          (CategoryTheory.Limits.kernel.lift π₀₁ (CategoryTheory.Limits.kernel.ι π₀) h_ker_π₀₁) ?_
        exact CategoryTheory.Limits.kernel.lift_ι π₀₁ (CategoryTheory.Limits.kernel.ι π₀) h_ker_π₀₁
      have h_not_lt : ¬ (ImSub w₀ u₀ < ImSub w₀₁ u₀₁) :=
        hMax (ImSub w₀₁ u₀₁) ⟨w₀₁, u₀₁, rfl⟩
      have h_eq : ImSub w₀ u₀ = ImSub w₀₁ u₀₁ := eq_of_le_of_not_lt h_le h_not_lt
      have h_ge : ImSub w₀₁ u₀₁ ≤ ImSub w₀ u₀ := h_eq ▸ le_rfl
      let e_sub0 := CategoryTheory.Subobject.underlyingIso (CategoryTheory.Limits.kernel.ι π₀)
      let e_sub01 := CategoryTheory.Subobject.underlyingIso (CategoryTheory.Limits.kernel.ι π₀₁)
      have h_arr0_zero : (ImSub w₀ u₀).arrow ≫ π₀ = 0 := by
        have harr0 : (ImSub w₀ u₀).arrow = e_sub0.hom ≫ CategoryTheory.Limits.kernel.ι π₀ :=
          (CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk _).symm
        rw [harr0, CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.condition,
          CategoryTheory.Limits.comp_zero]
      have h_arr01_zero : (ImSub w₀₁ u₀₁).arrow ≫ π₀ = 0 := by
        rw [← CategoryTheory.Subobject.ofLE_arrow h_ge, CategoryTheory.Category.assoc,
          h_arr0_zero, CategoryTheory.Limits.comp_zero]
      have h_ker01_π₀ : CategoryTheory.Limits.kernel.ι π₀₁ ≫ π₀ = 0 := by
        have h_iota : CategoryTheory.Limits.kernel.ι π₀₁ = e_sub01.inv ≫ (ImSub w₀₁ u₀₁).arrow := by
          rw [← CategoryTheory.Subobject.underlyingIso_hom_comp_eq_mk (CategoryTheory.Limits.kernel.ι π₀₁),
            ← CategoryTheory.Category.assoc, e_sub01.inv_hom_id, CategoryTheory.Category.id_comp]
        rw [h_iota, CategoryTheory.Category.assoc, h_arr01_zero, CategoryTheory.Limits.comp_zero]
      let l₀₁ := CategoryTheory.Limits.kernel.lift π₀₁ u₀₁ (CategoryTheory.Limits.cokernel.condition u₀₁)
      have hu₀₁_π₀ : u₀₁ ≫ π₀ = 0 := by
        calc
          u₀₁ ≫ π₀ = (l₀₁ ≫ CategoryTheory.Limits.kernel.ι π₀₁) ≫ π₀ := by
            rw [CategoryTheory.Limits.kernel.lift_ι]
          _ = l₀₁ ≫ (CategoryTheory.Limits.kernel.ι π₀₁ ≫ π₀) := by
            rw [CategoryTheory.Category.assoc]
          _ = 0 := by
            rw [h_ker01_π₀, CategoryTheory.Limits.comp_zero]
      apply hv_ne
      rw [← hu_b, CategoryTheory.Category.assoc, hu₀₁_π₀, CategoryTheory.Limits.comp_zero]
    exact CategoryTheory.Preadditive.epi_of_cokernel_zero hπ₀_zero
  
  obtain ⟨⟨W₀, hAff₀⟩, e₀, hEpi₀⟩ := hEpiCover P hNoethP
  have : CategoryTheory.Epi e₀ := hEpi₀
  have : CategoryTheory.IsNoetherianObject (L W₀) := hNoethGen W₀ hAff₀
  let K := CategoryTheory.Limits.kernel e₀
  let k₀ : K ⟶ L W₀ := CategoryTheory.Limits.kernel.ι e₀
  have hNoethK : CategoryTheory.IsNoetherianObject K :=
    CategoryTheory.isNoetherianObject_of_mono k₀
  obtain ⟨⟨W₁, hAff₁⟩, e₁, hEpi₁⟩ := hEpiCover K hNoethK
  have : CategoryTheory.Epi e₁ := hEpi₁
  obtain ⟨ψ, hψ⟩ : ∃ ψ : L W₁ ⟶ L W₀, ψ = e₁ ≫ k₀ := ⟨_, rfl⟩
  have hψ_e₀ : ψ ≫ e₀ = 0 := by
    rw [hψ, CategoryTheory.Category.assoc, CategoryTheory.Limits.kernel.condition,
      CategoryTheory.Limits.comp_zero]
  let inv_map : CategoryTheory.Limits.cokernel ψ ⟶ P :=
    CategoryTheory.Limits.cokernel.desc ψ e₀ hψ_e₀
  have hk₀_πψ : k₀ ≫ CategoryTheory.Limits.cokernel.π ψ = 0 := by
    apply (CategoryTheory.cancel_epi e₁).mp
    rw [CategoryTheory.Limits.comp_zero, ← CategoryTheory.Category.assoc, ← hψ,
      CategoryTheory.Limits.cokernel.condition]
  let hIsCok := CategoryTheory.Abelian.epiIsCokernelOfKernel _
    (CategoryTheory.Limits.kernelIsKernel e₀)
  let cf_ψ := CategoryTheory.Limits.CokernelCofork.ofπ
    (CategoryTheory.Limits.cokernel.π ψ) hk₀_πψ
  let hom_map : P ⟶ CategoryTheory.Limits.cokernel ψ := hIsCok.desc cf_ψ
  have h_fac_hom : e₀ ≫ hom_map = CategoryTheory.Limits.cokernel.π ψ :=
    hIsCok.fac cf_ψ CategoryTheory.Limits.WalkingParallelPair.one
  refine ⟨W₀, W₁, hAff₀, hAff₁, ψ, ⟨{
    hom := hom_map
    inv := inv_map
    hom_inv_id := by
      apply (CategoryTheory.cancel_epi e₀).mp
      rw [← CategoryTheory.Category.assoc, h_fac_hom,
        CategoryTheory.Limits.cokernel.π_desc, CategoryTheory.Category.comp_id]
    inv_hom_id := by
      refine (CategoryTheory.Limits.cokernelIsCokernel ψ).hom_ext (fun j => ?_)
      cases j with
      | zero =>
        change ψ ≫ (CategoryTheory.Limits.cokernel.π ψ ≫ (inv_map ≫ hom_map)) =
          ψ ≫ (CategoryTheory.Limits.cokernel.π ψ ≫ 𝟙 _)
        rw [← CategoryTheory.Category.assoc (CategoryTheory.Limits.cokernel.π ψ),
          CategoryTheory.Limits.cokernel.π_desc, h_fac_hom, CategoryTheory.Category.comp_id]
      | one =>
        change CategoryTheory.Limits.cokernel.π ψ ≫ (inv_map ≫ hom_map) =
          CategoryTheory.Limits.cokernel.π ψ ≫ 𝟙 _
        rw [← CategoryTheory.Category.assoc, CategoryTheory.Limits.cokernel.π_desc,
          h_fac_hom, CategoryTheory.Category.comp_id] }⟩⟩

theorem weil_etale_noetherian_localFree_and_constructible_mod_prime (k : Type u) [Field k]
    (X : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)))
    [AlgebraicGeometry.LocallyOfFiniteType X.hom]
    [AlgebraicGeometry.QuasiCompact X.hom]
    [AlgebraicGeometry.IsSeparated X.hom] :
    let S := X.left
    (∀ (m : ℕ), 1 ≤ m → ∀ (W : S.Etale),
      AlgebraicGeometry.IsAffine ((AlgebraicGeometry.Scheme.Etale.forget S).obj W).left →
      CategoryTheory.IsNoetherianObject (weilEtaleLocalFreeSheaf S m W)) ∧
    (∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
        (P : CategoryTheory.Sheaf S.smallEtaleTopology
          (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))),
      CategoryTheory.IsNoetherianObject P →
      WeilIsConstructibleModPrimeSheaf ℓ S
        ((CategoryTheory.Sheaf.composeAndSheafify S.smallEtaleTopology
          (CategoryTheory.forget₂ (ModuleCat.{u, u} (ULift.{u, 0} (ZMod ℓ)))
            AddCommGrpCat.{u})).obj P)) :=
by
  classical
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
  letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
      CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
    fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
      (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
  have hIsIsoMapOfNatIso : ∀ {C D : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C]
      [CategoryTheory.Category.{u + 1, u + 1} D] {F₁ F₂ : C ⥤ D} (e : F₁ ≅ F₂)
      {A₁ A₂ : C} (f : A₁ ⟶ A₂),
      CategoryTheory.IsIso (F₁.map f) → CategoryTheory.IsIso (F₂.map f) := by
    intro C D _ _ F₁ F₂ e A₁ A₂ f _
    have hfac : F₂.map f = (e.inv.app A₁ ≫ F₁.map f) ≫ e.hom.app A₂ := by
      rw [CategoryTheory.Category.assoc, e.hom.naturality f, ← CategoryTheory.Category.assoc,
        CategoryTheory.Iso.inv_hom_id_app, CategoryTheory.Category.id_comp]
    rw [hfac]
    infer_instance
  have hSubobjTransport : ∀ {C₁ C₂ : Type (u + 1)} [CategoryTheory.Category.{u + 1, u + 1} C₁]
      [CategoryTheory.Category.{u + 1, u + 1} C₂] (F : C₂ ⥤ C₁)
      [CategoryTheory.Limits.PreservesFiniteLimits F]
      {E₂ : C₂} {E₁ : C₁} (e : F.obj E₂ ≅ E₁) (P : ℕ →o CategoryTheory.Subobject E₂),
      ∃ Q : ℕ →o CategoryTheory.Subobject E₁,
        ∀ (a b : ℕ) (hab : a ≤ b),
          (CategoryTheory.IsIso
              (F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab))) ↔
            Q a = Q b) ∧
          (∃ (u_a : (Q a : C₁) ≅ F.obj (P a : C₂)) (u_b : (Q b : C₁) ≅ F.obj (P b : C₂)),
            F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) =
              u_a.inv ≫ CategoryTheory.Subobject.ofLE (Q a) (Q b) (Q.monotone hab) ≫ u_b.hom ∧
            CategoryTheory.Subobject.ofLE (Q a) (Q b) (Q.monotone hab) =
              u_a.hom ≫ F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) ≫
                u_b.inv) := by
    intro C₁ C₂ _ _ F _ E₂ E₁ e P
    have hMono : ∀ n : ℕ, CategoryTheory.Mono (F.map (P n).arrow ≫ e.hom) :=
      fun n => CategoryTheory.mono_comp (F.map (P n).arrow) e.hom
    let Q_fun : ℕ → CategoryTheory.Subobject E₁ := fun n =>
      @CategoryTheory.Subobject.mk _ _ _ _ (F.map (P n).arrow ≫ e.hom) (hMono n)
    have hQ_mono : Monotone Q_fun := by
      intro a b hab
      haveI := hMono a
      haveI := hMono b
      refine CategoryTheory.Subobject.mk_le_mk_of_comm
        (F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab))) ?_
      rw [← CategoryTheory.Category.assoc, ← F.map_comp, CategoryTheory.Subobject.ofLE_arrow]
    let Q : ℕ →o CategoryTheory.Subobject E₁ := ⟨Q_fun, hQ_mono⟩
    refine ⟨Q, fun a b hab => ?_⟩
    haveI := hMono a
    haveI := hMono b
    have hQab : Q a ≤ Q b := hQ_mono hab
    let u_a := CategoryTheory.Subobject.underlyingIso (F.map (P a).arrow ≫ e.hom)
    let u_b := CategoryTheory.Subobject.underlyingIso (F.map (P b).arrow ≫ e.hom)
    have hsq : CategoryTheory.Subobject.ofLE (Q a) (Q b) hQab ≫ u_b.hom =
        u_a.hom ≫ F.map (CategoryTheory.Subobject.ofLE (P a) (P b) (P.monotone hab)) := by
      apply (CategoryTheory.cancel_mono (F.map (P b).arrow ≫ e.hom)).mp
