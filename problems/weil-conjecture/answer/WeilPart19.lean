    have he_eq : (e_L.app A).hom = weilEtaleConstPullbackHom h hT_Y hT_X A := by
      change e_L.hom.app A = _
      rw [CategoryTheory.conjugateIsoEquiv_symm_apply_hom,
        CategoryTheory.conjugateEquiv_symm_apply_app,
        ← CategoryTheory.Category.assoc, ← (C_X.comp P_pull).map_comp,
        ← CategoryTheory.Adjunction.homEquiv_counit]
      change ((adj_X.comp adj_pull).homEquiv A (C_Y.obj A)).symm _ = _
      rw [CategoryTheory.Adjunction.comp_homEquiv]
      rfl
    rw [← he_eq]
    exact (e_L.app A).isIso_hom

theorem weil_etale_h1_pullback_kernel_torsor_sheaf (ℓ : ℕ) (X Y : AlgebraicGeometry.Scheme.{u}) (h : Y ⟶ X)
    (hLocConst : ∀ (W : AlgebraicGeometry.Scheme.{u}) {T_W : W.Etale}
        (hT_W : CategoryTheory.Limits.IsTerminal T_W) (A : AddCommGrpCat.{u}),
      let C_W := CategoryTheory.constantSheaf W.smallEtaleTopology AddCommGrpCat.{u}
      let adj_W := CategoryTheory.constantSheafAdj W.smallEtaleTopology AddCommGrpCat.{u} hT_W
      ∃ (θ_W : ∀ E : W.Etale,
          ↥((C_W.obj A).obj.obj (Opposite.op E)) ≃+ LocallyConstant ↥E.left ↥A),
        (∀ {E' E : W.Etale} (u : E' ⟶ E) (s : ↥((C_W.obj A).obj.obj (Opposite.op E)))
            (z : ↥E'.left),
          θ_W E' (((C_W.obj A).obj.map u.op).hom s) z = θ_W E s (u.left.base z)) ∧
        (∀ (a : ↥A) (z : ↥T_W.left),
          θ_W T_W ((adj_W.unit.app A).hom a) z = a))
    (hSite : ∃ (hCont : (weilEtaleSitePullback h).IsContinuous X.smallEtaleTopology Y.smallEtaleTopology),
      letI := hCont
      let P_push := (weilEtaleSitePullback h).sheafPushforwardContinuous
        AddCommGrpCat.{u} X.smallEtaleTopology Y.smallEtaleTopology
      ∃ (hAdj : P_push.IsRightAdjoint),
        letI := hAdj
        let P_pull := (weilEtaleSitePullback h).sheafPullback
          AddCommGrpCat.{u} X.smallEtaleTopology Y.smallEtaleTopology
        P_pull.Additive ∧
        CategoryTheory.Limits.PreservesFiniteLimits P_pull ∧
        CategoryTheory.Limits.PreservesFiniteColimits P_pull ∧
        ∀ {T_Y : Y.Etale} (hT_Y : CategoryTheory.Limits.IsTerminal T_Y)
          {T_X : X.Etale} (hT_X : CategoryTheory.Limits.IsTerminal T_X)
          (A : AddCommGrpCat.{u}),
          CategoryTheory.IsIso (weilEtaleConstPullbackHom h hT_Y hT_X A)) :
    ∃ (ψ_pull : weilEtaleTorsionH X ℓ 1 →+ weilEtaleTorsionH Y ℓ 1),
      ∀ (c : weilEtaleTorsionH X ℓ 1),
        ψ_pull c = 0 → c ≠ 0 →
        ∃ (P : CategoryTheory.Sheaf X.smallEtaleTopology (Type u))
          (actP : ZMod ℓ → (P ⟶ P)),
          actP 0 = 𝟙 P ∧
          (∀ γ₁ γ₂ : ZMod ℓ, actP (γ₁ + γ₂) = actP γ₁ ≫ actP γ₂) ∧
          (∀ (T_X : X.Etale), CategoryTheory.Limits.IsTerminal T_X →
            IsEmpty (P.obj.obj (Opposite.op T_X))) ∧
          (∀ (U : X.affineOpens),
            ∃ (D : CommRingCat.{u}) (p_V : AlgebraicGeometry.Spec D ⟶ U.1.toScheme)
              (hEt_V : AlgebraicGeometry.Etale p_V),
              letI := hEt_V
              AlgebraicGeometry.Surjective p_V ∧
              Nonempty (P.obj.obj (Opposite.op (AlgebraicGeometry.Scheme.Etale.mk (p_V ≫ U.1.ι))))) ∧
          (∀ (E : X.Etale) (s : P.obj.obj (Opposite.op E)) (f : LocallyConstant ↥E.left (ZMod ℓ)),
            letI : AlgebraicGeometry.Etale E.hom := E.prop
            ∃ (s' : P.obj.obj (Opposite.op E)),
              ∀ (γ : ZMod ℓ),
                let O_γ : E.left.Opens := ⟨{x | f x = γ}, f.isLocallyConstant.isOpen_fiber γ⟩
                let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
                let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
                P.obj.map j_γ.op s' = P.obj.map j_γ.op ((actP γ).hom.app (Opposite.op E) s)) ∧
          (∀ (E : X.Etale) (s s' : P.obj.obj (Opposite.op E)),
            letI : AlgebraicGeometry.Etale E.hom := E.prop
            ∃! (f : LocallyConstant ↥E.left (ZMod ℓ)),
              ∀ (γ : ZMod ℓ),
                let O_γ : E.left.Opens := ⟨{x | f x = γ}, f.isLocallyConstant.isOpen_fiber γ⟩
                let U_γ : X.Etale := AlgebraicGeometry.Scheme.Etale.mk (O_γ.ι ≫ E.hom)
                let j_γ : U_γ ⟶ E := CategoryTheory.MorphismProperty.Over.homMk O_γ.ι rfl
                P.obj.map j_γ.op s' = P.obj.map j_γ.op ((actP γ).hom.app (Opposite.op E) s)) ∧
          (∀ (U_T : X.Etale) (s_taut : P.obj.obj (Opposite.op U_T))
              (ρ_et : ZMod ℓ → (U_T ⟶ U_T)),
            (∀ γ : ZMod ℓ, P.obj.map (ρ_et γ).op s_taut =
              (actP γ).hom.app (Opposite.op U_T) s_taut) →
            ∃ (u_Y : LocallyConstant ↥(((weilEtaleSitePullback h).obj U_T).left) (ZMod ℓ)),
              ∀ (γ : ZMod ℓ) (z : ↥(((weilEtaleSitePullback h).obj U_T).left)),
                u_Y ((((weilEtaleSitePullback h).map (ρ_et γ)).left).base z) = u_Y z + γ) :=
by
  classical
  
  have hSplitIff : ∀ (𝒞 : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      {X₁ X₂ X₃ : 𝒞} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (hzero : f ≫ g = 0)
      (hSE : (CategoryTheory.ShortComplex.mk f g hzero).ShortExact),
      hSE.extClass = 0 ↔ ∃ σ : X₃ ⟶ X₂, σ ≫ g = 𝟙 X₃ := by
    intro 𝒞 _ _ _ X₁ X₂ X₃ f g hzero hSE
    let S := CategoryTheory.ShortComplex.mk f g hzero
    constructor
    · intro h0
      have hcomp0 :
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 S.X₃)).comp hSE.extClass (Nat.zero_add 1) = 0 := by
        rw [h0, CategoryTheory.Abelian.Ext.comp_zero]
      obtain ⟨x₂, hx₂⟩ :=
        CategoryTheory.Abelian.Ext.covariant_sequence_exact₃ S.X₃ hSE
          (CategoryTheory.Abelian.Ext.mk₀ (𝟙 S.X₃)) (Nat.zero_add 1) hcomp0
      let σ : X₃ ⟶ X₂ := CategoryTheory.Abelian.Ext.homEquiv₀ x₂
      refine ⟨σ, ?_⟩
      apply CategoryTheory.Abelian.Ext.homEquiv₀.symm.injective
      rw [CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
        CategoryTheory.Abelian.Ext.homEquiv₀_symm_apply,
        ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀,
        CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₂
    · rintro ⟨σ, hσ⟩
      calc
        hSE.extClass
          = (CategoryTheory.Abelian.Ext.mk₀ (𝟙 S.X₃)).comp hSE.extClass (Nat.zero_add 1) :=
            (CategoryTheory.Abelian.Ext.mk₀_id_comp hSE.extClass).symm
        _ = (CategoryTheory.Abelian.Ext.mk₀ (σ ≫ S.g)).comp hSE.extClass (Nat.zero_add 1) := by
            dsimp [S]; rw [hσ]
        _ = (CategoryTheory.Abelian.Ext.mk₀ σ).comp
              ((CategoryTheory.Abelian.Ext.mk₀ S.g).comp hSE.extClass (Nat.zero_add 1))
              (Nat.zero_add 1) := by
            rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
        _ = 0 := by
            rw [CategoryTheory.ShortComplex.ShortExact.comp_extClass,
              CategoryTheory.Abelian.Ext.comp_zero]
  have hYoneda : ∀ (𝒞 : Type (u + 1)) [CategoryTheory.Category.{u + 1, u + 1} 𝒞]
      [CategoryTheory.Abelian 𝒞] [CategoryTheory.HasExt.{u} 𝒞]
      [CategoryTheory.EnoughInjectives 𝒞] (Z F : 𝒞) (c : CategoryTheory.Abelian.Ext.{u} Z F 1),
      ∃ (E : 𝒞) (ι : F ⟶ E) (g : E ⟶ Z) (hzero : ι ≫ g = 0)
        (hSE : (CategoryTheory.ShortComplex.mk ι g hzero).ShortExact),
        hSE.extClass = c := by
    intro 𝒞 _ _ _ _ Z F c
    let ℐ : 𝒞 := CategoryTheory.Injective.under F
    let i₀ : F ⟶ ℐ := CategoryTheory.Injective.ι F
    let 𝒬 : 𝒞 := CategoryTheory.Limits.cokernel i₀
    let q₀ : ℐ ⟶ 𝒬 := CategoryTheory.Limits.cokernel.π i₀
    let S₀ : CategoryTheory.ShortComplex 𝒞 :=
      CategoryTheory.ShortComplex.mk i₀ q₀ (CategoryTheory.Limits.cokernel.condition i₀)
    have hS₀_exact : S₀.Exact :=
      CategoryTheory.ShortComplex.exact_of_g_is_cokernel S₀
        (CategoryTheory.Limits.cokernelIsCokernel i₀)
    have hS₀ : S₀.ShortExact := { exact := hS₀_exact }
    have hSub_all := CategoryTheory.injective_iff_subsingleton_ext_one.mp
      (inferInstance : CategoryTheory.Injective ℐ)
    have hSub_ℐ : Subsingleton (CategoryTheory.Abelian.Ext.{u} Z ℐ 1) := @hSub_all Z
    have hc_i₀ : c.comp (CategoryTheory.Abelian.Ext.mk₀ S₀.f) (Nat.add_zero 1) = 0 :=
      Subsingleton.elim _ _
    obtain ⟨x₃, hx₃⟩ :=
      CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ Z hS₀ c hc_i₀ (Nat.zero_add 1)
    let α : Z ⟶ 𝒬 := CategoryTheory.Abelian.Ext.homEquiv₀ x₃
    have hα_ext : (CategoryTheory.Abelian.Ext.mk₀ α).comp hS₀.extClass (Nat.zero_add 1) = c := by
      dsimp [α]
      rw [CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₃
    let E : 𝒞 := CategoryTheory.Limits.pullback α q₀
    let g : E ⟶ Z := CategoryTheory.Limits.pullback.fst α q₀
    let p_ℐ : E ⟶ ℐ := CategoryTheory.Limits.pullback.snd α q₀
    have : CategoryTheory.Epi g := CategoryTheory.Abelian.epi_pullback_of_epi_g α q₀
    have h_zero_cond : (0 : F ⟶ Z) ≫ α = i₀ ≫ q₀ := by
      rw [CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.cokernel.condition]
    let ι : F ⟶ E := CategoryTheory.Limits.pullback.lift (0 : F ⟶ Z) i₀ h_zero_cond
    have hzero : ι ≫ g = 0 := CategoryTheory.Limits.pullback.lift_fst _ _ _
    have hι_snd : ι ≫ p_ℐ = i₀ := CategoryTheory.Limits.pullback.lift_snd _ _ _
    have : CategoryTheory.Mono ι := by
      have : CategoryTheory.Mono (ι ≫ p_ℐ) := by rw [hι_snd]; infer_instance
      exact CategoryTheory.mono_of_mono ι p_ℐ
    let S_c : CategoryTheory.ShortComplex 𝒞 := CategoryTheory.ShortComplex.mk ι g hzero
    have hKer_i₀ := hS₀.fIsKernel
    let lift_ι : ∀ {W : 𝒞} (k : W ⟶ E), k ≫ S_c.g = 0 → (W ⟶ F) :=
      fun {W} k hk =>
        hKer_i₀.lift (CategoryTheory.Limits.KernelFork.ofι (k ≫ p_ℐ) (by
          rw [CategoryTheory.Category.assoc, ← CategoryTheory.Limits.pullback.condition,
            ← CategoryTheory.Category.assoc]
          change (k ≫ S_c.g) ≫ α = 0
          rw [hk, CategoryTheory.Limits.zero_comp]))
    have hLift_eq : ∀ {W : 𝒞} (k : W ⟶ E) (hk : k ≫ S_c.g = 0),
        lift_ι k hk ≫ S_c.f = k := by
      intro W k hk
      let u : W ⟶ F := lift_ι k hk
      have hu : u ≫ i₀ = k ≫ p_ℐ :=
        hKer_i₀.fac _ CategoryTheory.Limits.WalkingParallelPair.zero
      change u ≫ ι = k
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, hzero, CategoryTheory.Limits.comp_zero]
        exact hk.symm
      · rw [CategoryTheory.Category.assoc, hι_snd, hu]
    have hKer_ι : CategoryTheory.Limits.IsLimit
        (CategoryTheory.Limits.KernelFork.ofι S_c.f S_c.zero) :=
      CategoryTheory.Limits.KernelFork.IsLimit.ofι S_c.f S_c.zero
        (fun {W} k hk => lift_ι k hk)
        (fun {W} k hk => hLift_eq k hk)
        (fun {W} k hk m hm => by
          rw [← cancel_mono S_c.f, hm, hLift_eq k hk])
    have hSE_exact : S_c.Exact :=
      CategoryTheory.ShortComplex.exact_of_f_is_kernel S_c hKer_ι
    have hSE : S_c.ShortExact := { exact := hSE_exact }
    let φ : S_c ⟶ S₀ :=
      { τ₁ := 𝟙 F
        τ₂ := p_ℐ
        τ₃ := α
        comm₁₂ := (CategoryTheory.Category.id_comp i₀).trans hι_snd.symm
        comm₂₃ := CategoryTheory.Limits.pullback.condition.symm }
    have hnat := CategoryTheory.ShortComplex.ShortExact.extClass_naturality hSE hS₀ φ
    dsimp [φ] at hnat
    rw [CategoryTheory.Abelian.Ext.comp_mk₀_id] at hnat
    exact ⟨E, ι, g, hzero, hSE, hnat.trans hα_ext⟩

  
  have hSecExact : ∀ (W : AlgebraicGeometry.Scheme.{u})
      {X₁ X₂ X₃ : CategoryTheory.Sheaf W.smallEtaleTopology AddCommGrpCat.{u}}
      (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (hz : f ≫ g = 0)
      (_ : (CategoryTheory.ShortComplex.mk f g hz).ShortExact) (E : W.Etale),
      Function.Injective (f.hom.app (Opposite.op E)).hom ∧
      ∀ x₂ : ↥(X₂.obj.obj (Opposite.op E)),
        (g.hom.app (Opposite.op E)).hom x₂ = 0 →
        ∃ x₁ : ↥(X₁.obj.obj (Opposite.op E)), (f.hom.app (Opposite.op E)).hom x₁ = x₂ := by
    intro W X₁ X₂ X₃ f g hz hSE_W E
    let ev_E := CategoryTheory.sheafToPresheaf W.smallEtaleTopology AddCommGrpCat.{u} ⋙
      (CategoryTheory.evaluation (W.Etale)ᵒᵖ AddCommGrpCat.{u}).obj (Opposite.op E)
    have : ev_E.Additive := { map_add := fun {_ _} {_ _} => rfl }
    have hMap :=
      (CategoryTheory.Functor.preservesFiniteLimits_iff_forall_exact_map_and_mono ev_E).mp
        inferInstance (CategoryTheory.ShortComplex.mk f g hz) hSE_W
    have hInj : Function.Injective (f.hom.app (Opposite.op E)).hom :=
      (AddCommGrpCat.mono_iff_injective (ev_E.map f)).mp hMap.2
    have hRangeKer := CategoryTheory.ShortComplex.ab_exact_iff_range_eq_ker.mp hMap.1
    dsimp at hRangeKer
    refine ⟨hInj, fun x₂ hx₂ => ?_⟩
    have hmem : x₂ ∈ AddMonoidHom.ker ((ev_E.map g).hom) := hx₂
    rw [← hRangeKer] at hmem
    exact hmem

  
  let T_X0 : X.Etale := weilEtaleIdTerminal.{u} X
  let hT_X0 : CategoryTheory.Limits.IsTerminal T_X0 := weilEtaleIdTerminalIsTerminal.{u} X
  let T_Y0 : Y.Etale := weilEtaleIdTerminal.{u} Y
  let hT_Y0 : CategoryTheory.Limits.IsTerminal T_Y0 := weilEtaleIdTerminalIsTerminal.{u} Y
  rcases hSite with ⟨hCont, hAdj, hAdd, hLim, hColim, hConstIso⟩
  let _ : (weilEtaleSitePullback h).IsContinuous X.smallEtaleTopology Y.smallEtaleTopology := hCont
  let B_h := weilEtaleSitePullback h
  let P_push := B_h.sheafPushforwardContinuous
    AddCommGrpCat.{u} X.smallEtaleTopology Y.smallEtaleTopology
  let _ : P_push.IsRightAdjoint := hAdj
  let P_pull := B_h.sheafPullback
    AddCommGrpCat.{u} X.smallEtaleTopology Y.smallEtaleTopology
  let _ : P_pull.Additive := hAdd
  let _ : CategoryTheory.Limits.PreservesFiniteLimits P_pull := hLim
  let _ : CategoryTheory.Limits.PreservesFiniteColimits P_pull := hColim
  let C_X := CategoryTheory.constantSheaf X.smallEtaleTopology AddCommGrpCat.{u}
  let C_Y := CategoryTheory.constantSheaf Y.smallEtaleTopology AddCommGrpCat.{u}
  let adj_X0 := CategoryTheory.constantSheafAdj X.smallEtaleTopology AddCommGrpCat.{u} hT_X0
  let adj_Y0 := CategoryTheory.constantSheafAdj Y.smallEtaleTopology AddCommGrpCat.{u} hT_Y0
  let A_ℤ : AddCommGrpCat.{u} := AddCommGrpCat.of (ULift.{u} ℤ)
  let A_M : AddCommGrpCat.{u} :=
    AddCommGrpCat.uliftFunctor.{u, 0}.obj (AddCommGrpCat.of (ZMod ℓ))
  let ℤ_X : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} := C_X.obj A_ℤ
  let ℤ_Y : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} := C_Y.obj A_ℤ
  let ℱ_X : CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u} :=
    weilEtaleTorsionSheaf X ℓ
  let ℱ_Y : CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u} :=
    weilEtaleTorsionSheaf Y ℓ
  let π_ℤ : P_pull.obj ℤ_X ⟶ ℤ_Y := weilEtaleConstPullbackHom h hT_Y0 hT_X0 A_ℤ
  let π_M : P_pull.obj ℱ_X ⟶ ℱ_Y := weilEtaleConstPullbackHom h hT_Y0 hT_X0 A_M
  have : CategoryTheory.IsIso π_ℤ := hConstIso hT_Y0 hT_X0 A_ℤ
  have : CategoryTheory.IsIso π_M := hConstIso hT_Y0 hT_X0 A_M
  let ψ_pull : weilEtaleTorsionH X ℓ 1 →+ weilEtaleTorsionH Y ℓ 1 :=
    ((CategoryTheory.Abelian.Ext.mk₀ π_M).postcomp ℤ_Y (Nat.add_zero 1)).comp
      (((CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv π_ℤ)).precomp
          (P_pull.obj ℱ_X) (Nat.zero_add 1)).comp
        (P_pull.mapExtAddHom ℤ_X ℱ_X 1))
  refine ⟨ψ_pull, fun c hψc hc_ne => ?_⟩

  
  obtain ⟨ℰ, ι, g_sh, hzero, hSE, hExt_eq⟩ :=
    hYoneda (CategoryTheory.Sheaf X.smallEtaleTopology AddCommGrpCat.{u}) ℤ_X ℱ_X c
  have hNoSplit : ∀ σ : ℤ_X ⟶ ℰ, σ ≫ g_sh ≠ 𝟙 ℤ_X := by
    intro σ hσ
    apply hc_ne
    rw [← hExt_eq]
    exact (hSplitIff _ ι g_sh hzero hSE).mpr ⟨σ, hσ⟩
  have hMapC_zero : (P_pull.mapExtAddHom ℤ_X ℱ_X 1) c = 0 := by
    let d := (P_pull.mapExtAddHom ℤ_X ℱ_X 1) c
    let d₁ := (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv π_ℤ)).comp d (Nat.zero_add 1)
    have hd0 : d₁.comp (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero 1) = 0 := hψc
    have hd₁ : d₁ = 0 := by
      calc
        d₁ = d₁.comp (CategoryTheory.Abelian.Ext.mk₀ (𝟙 (P_pull.obj ℱ_X))) (Nat.add_zero 1) :=
            (CategoryTheory.Abelian.Ext.comp_mk₀_id d₁).symm
        _ = d₁.comp (CategoryTheory.Abelian.Ext.mk₀ (π_M ≫ CategoryTheory.inv π_M))
              (Nat.add_zero 1) := by
            rw [CategoryTheory.IsIso.hom_inv_id]
        _ = d₁.comp ((CategoryTheory.Abelian.Ext.mk₀ π_M).comp
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv π_M)) (Nat.add_zero 0))
              (Nat.add_zero 1) := by
            rw [CategoryTheory.Abelian.Ext.mk₀_comp_mk₀]
        _ = (d₁.comp (CategoryTheory.Abelian.Ext.mk₀ π_M) (Nat.add_zero 1)).comp
              (CategoryTheory.Abelian.Ext.mk₀ (CategoryTheory.inv π_M)) (Nat.add_zero 1) :=
            (CategoryTheory.Abelian.Ext.comp_assoc d₁ _ _ (Nat.add_zero 1) (Nat.add_zero 0)
              (by omega)).symm
        _ = 0 := by
            rw [hd0, CategoryTheory.Abelian.Ext.zero_comp]
    calc
      d = (CategoryTheory.Abelian.Ext.mk₀ (𝟙 (P_pull.obj ℤ_X))).comp d (Nat.zero_add 1) :=
          (CategoryTheory.Abelian.Ext.mk₀_id_comp d).symm
      _ = (CategoryTheory.Abelian.Ext.mk₀ (π_ℤ ≫ CategoryTheory.inv π_ℤ)).comp d
            (Nat.zero_add 1) := by
          rw [CategoryTheory.IsIso.hom_inv_id]
      _ = (CategoryTheory.Abelian.Ext.mk₀ π_ℤ).comp d₁ (Nat.zero_add 1) := by
          dsimp [d₁]
          rw [← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀_assoc]
      _ = 0 := by
          rw [hd₁, CategoryTheory.Abelian.Ext.comp_zero]
  have hSE_Y_zero : (hSE.map_of_exact P_pull).extClass = 0 := by
    rw [← CategoryTheory.Abelian.Ext.mapExactFunctor_extClass P_pull hSE,
      ← CategoryTheory.Functor.mapExtAddHom_apply P_pull, hExt_eq, hMapC_zero]
  obtain ⟨σ_Y, hσ_Y⟩ :=
    (hSplitIff (CategoryTheory.Sheaf Y.smallEtaleTopology AddCommGrpCat.{u})
      (P_pull.map ι) (P_pull.map g_sh)
      ((CategoryTheory.ShortComplex.mk ι g_sh hzero).map P_pull).zero
      (hSE.map_of_exact P_pull)).mp hSE_Y_zero

  
  obtain ⟨θ_X, hθ_X_nat, hθ_X_unit⟩ := hLocConst X hT_X0 A_M
  obtain ⟨θ_Y, hθ_Y_nat, hθ_Y_unit⟩ := hLocConst Y hT_Y0 A_M
  let upM : ZMod ℓ →+ ↥A_M :=
    { toFun := ULift.up
