  have weil_etale_open_immersion_pullback_iso_pushforward :
      ∀ (Y : AlgebraicGeometry.Scheme.{u}) (O : Y.Opens),
        let R := ULift.{u, 0} (ZMod m)
        letI : CategoryTheory.MorphismProperty.IsStableUnderComposition (@AlgebraicGeometry.Etale) :=
          { comp_mem := fun {_ _ _} f g hf hg =>
              let _ : AlgebraicGeometry.Etale f := hf
              let _ : AlgebraicGeometry.Etale g := hg
              inferInstance }
        letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
            CategoryTheory.MorphismProperty.HasPullbacksAlong (@AlgebraicGeometry.Etale) h :=
          fun _ => CategoryTheory.MorphismProperty.HasPullbacksAlong.mk (fun _ _ => inferInstance)
        letI : ∀ {Y₁ Y₂ : AlgebraicGeometry.Scheme.{u}} (h : Quiver.Hom Y₁ Y₂),
            CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong (@AlgebraicGeometry.Etale) h :=
          fun _ => CategoryTheory.MorphismProperty.IsStableUnderBaseChangeAlong.mk
            (fun hp hg => CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp hg)
        let J_O : CategoryTheory.Functor (O : AlgebraicGeometry.Scheme.{u}).Etale Y.Etale :=
          CategoryTheory.MorphismProperty.Over.map ⊤ (inferInstance : AlgebraicGeometry.Etale O.ι)
        let B_O : CategoryTheory.Functor Y.Etale (O : AlgebraicGeometry.Scheme.{u}).Etale :=
          CategoryTheory.MorphismProperty.Over.pullback (@AlgebraicGeometry.Etale) ⊤ O.ι
