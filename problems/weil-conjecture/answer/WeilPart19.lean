          rw [hcyc, CategoryTheory.Limits.PreservesKernel.iso_hom,
            CategoryTheory.Limits.kernelComparison_comp_ι, ← h_push.map_comp, hu₁_comp]
        have hsq : h_push.map π₀ ≫ φ_Z.hom =
            (CategoryTheory.Iso.refl (h_push.obj (K.X 0))).hom ≫ S₁.toCycles := by
          rw [← cancel_mono S₁.iCycles, CategoryTheory.Category.assoc, hφZ_i, ← h_push.map_comp,
