    isAffineHom_specMap φ_RS
  have _ : AlgebraicGeometry.IsAffineHom q_YS :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpYS.flip inferInstance
  have hAff_μS : AlgebraicGeometry.IsAffineHom μ_S := by
    apply AlgebraicGeometry.isAffineHom_of_forall_exists_isAffineOpen
    intro y
    have hy_top : q_YS.base y ∈ (⊤ : Y_R.Opens) := trivial
    rw [← hCovV, TopologicalSpace.Opens.mem_iSup] at hy_top
    rcases hy_top with ⟨α, hyα⟩
    let U_S : Y_S.Opens := (TopologicalSpace.Opens.map q_YS.base).obj (V α)
    refine ⟨U_S, hyα, (hAffV α).preimage q_YS, ?_⟩
    have hEq_pre : (TopologicalSpace.Opens.map μ_S.base).obj U_S =
        (TopologicalSpace.Opens.map q_CS.base).obj
          ((TopologicalSpace.Opens.map μ_R.base).obj (V α)) := by
      ext x
      have hb : (μ_S ≫ q_YS).base x = (q_CS ≫ μ_R).base x := by rw [hcommS]
      change (μ_S ≫ q_YS).base x ∈ V α ↔ (q_CS ≫ μ_R).base x ∈ V α
      rw [hb]
    rw [hEq_pre]
    have hUnit_α : IsUnit (φ_RS (h_α α)) :=
      isUnit_of_dvd_unit (map_dvd φ_RS (Finset.dvd_prod_of_mem h_α (Finset.mem_univ α))) hUnitS
    exact h_α_transfer α S φ_RS hUnit_α C_S q_CS f_CS hpCS
  exact AlgebraicGeometry.IsFinite.iff_isProper_and_isAffineHom.mpr ⟨hProp_μS, hAff_μS⟩

theorem weil_spread_out_proj_closedImmersion_and_smooth_of_fractionRing (k : Type u) [Field k]
    (A₁ : Type u) [CommRing A₁] [IsDomain A₁] [Algebra k A₁] [Algebra.FiniteType k A₁]
    (K₁ : Type u) [Field K₁] [Algebra A₁ K₁] [IsFractionRing A₁ K₁]
    (Ω₀ : Type u) [Field Ω₀] [IsAlgClosed Ω₀] (τ : K₁ →+* Ω₀)
    (d : ℕ)
    (V_K₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₁)))
    (hProj : IsProjectiveOverField K₁ V_K₁)
    (hSm : AlgebraicGeometry.SmoothOfRelativeDimension d V_K₁.hom)
    (hGeomInt : AlgebraicGeometry.IsIntegral
      (CategoryTheory.Limits.pullback V_K₁.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom τ)))) :
    let S_init : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
      CategoryTheory.Over.mk
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap k A₁)))
    let ξ₁ : AlgebraicGeometry.Spec (CommRingCat.of K₁) ⟶ S_init.left :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ K₁))
    ∃ (N : ℕ) (V_init : AlgebraicGeometry.Scheme.{u})
      (ι_init : V_init ⟶
        CategoryTheory.Limits.pullback S_init.hom (weilProjectiveSpaceOver k N).hom)
      (q_V : V_K₁.left ⟶ V_init)
      (h_sm : A₁) (_ : h_sm ≠ 0),
      let f_V_init : V_init ⟶ S_init.left :=
        ι_init ≫ CategoryTheory.Limits.pullback.fst S_init.hom
          (weilProjectiveSpaceOver k N).hom
      AlgebraicGeometry.IsClosedImmersion ι_init ∧
      CategoryTheory.IsPullback q_V V_K₁.hom f_V_init ξ₁ ∧
      ∀ (h : A₁), h ≠ 0 → h_sm ∣ h →
        let j_h : AlgebraicGeometry.Spec (CommRingCat.of (Localization.Away h)) ⟶
            S_init.left :=
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap A₁ (Localization.Away h)))
        let Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of k)) :=
          CategoryTheory.Over.mk (j_h ≫ S_init.hom)
        ∀ (V_h : AlgebraicGeometry.Scheme.{u})
          (q_Vh : V_h ⟶ V_init)
          (f_Vh : V_h ⟶ Z₁.left),
          CategoryTheory.IsPullback q_Vh f_Vh f_V_init j_h →
          AlgebraicGeometry.SmoothOfRelativeDimension d f_Vh ∧
          (∃ (ι_h : V_h ⟶
              CategoryTheory.Limits.pullback Z₁.hom (weilProjectiveSpaceOver k N).hom),
            AlgebraicGeometry.IsClosedImmersion ι_h ∧
            ι_h ≫ CategoryTheory.Limits.pullback.fst Z₁.hom
              (weilProjectiveSpaceOver k N).hom = f_Vh) ∧
          (∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω)
              (η : AlgebraicGeometry.Spec (CommRingCat.of Ω) ⟶ Z₁.left),
            DenseRange η.base ∧
            AlgebraicGeometry.IsIntegral (CategoryTheory.Limits.pullback f_Vh η)) :=
by
  have hPillar1 : ∀ (k : Type u) [Field k] (N : ℕ),
      AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom ∧
      ∀ (K : Type u) [Field K] (φ : k →+* K),
        ∃ (π : (weilProjectiveSpaceOver K N).left ⟶ (weilProjectiveSpaceOver k N).left),
          CategoryTheory.IsPullback π
            (weilProjectiveSpaceOver K N).hom
            (weilProjectiveSpaceOver k N).hom
            (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)) := by
    clear * -
    intro k _ N
    classical
    have hProper : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver k N).hom := by
      let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
      letI : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
      letI : IsScalarTower k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        IsScalarTower.of_algebraMap_eq (R := k) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (N + 1)) k)
          (fun _ => rfl)
      letI : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k) :=
        Algebra.FiniteType.of_restrictScalars_finiteType k ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) k)
      let ψ₀ : k →+* ↥(𝒜 0) := algebraMap k ↥(𝒜 0)
      have hψ₀_bij : Function.Bijective ψ₀ := by
        constructor
        · intro a b hab
          exact MvPolynomial.C_injective (Fin (N + 1)) k (congrArg Subtype.val hab)
        · intro x
          have hx : x.1 ∈ (1 : Submodule k (MvPolynomial (Fin (N + 1)) k)) := by
            rw [← MvPolynomial.homogeneousSubmodule_zero]
            exact x.2
          rw [Submodule.mem_one] at hx
          obtain ⟨r, hr⟩ := hx
          exact ⟨r, Subtype.ext hr⟩
      haveI : CategoryTheory.IsIso (CommRingCat.ofHom ψ₀) :=
        (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom ψ₀)).mpr hψ₀_bij
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    refine ⟨hProper, ?_⟩
    intro K _ φ
    let 𝒜_k := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k
    let 𝒜_K := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K
    letI : GradedAlgebra 𝒜_k := MvPolynomial.gradedAlgebra
    letI : GradedAlgebra 𝒜_K := MvPolynomial.gradedAlgebra
    have hIrrel : ∀ (F : Type u) [Field F],
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) :=
          MvPolynomial.gradedAlgebra
        (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F)).toIdeal ≤
          Ideal.span (Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) F)) := by
      intro F _
      let 𝒜_F := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F
      letI : GradedAlgebra 𝒜_F := MvPolynomial.gradedAlgebra
      intro p hp
      have hp0 : GradedRing.proj 𝒜_F 0 p = 0 :=
        (HomogeneousIdeal.mem_irrelevant_iff 𝒜_F p).mp hp
      rw [← DirectSum.sum_support_decompose 𝒜_F p]
      refine Ideal.sum_mem _ fun m _ => ?_
      by_cases hm : m = 0
      · subst hm
        change GradedRing.proj 𝒜_F 0 p ∈ _
        rw [hp0]
        exact Ideal.zero_mem _
      · let q := DirectSum.decompose 𝒜_F p m
        have hq : q.1.IsHomogeneous m := q.2
        rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
        intro d hd
        by_contra h_all0
        push_neg at h_all0
        have hd0 : d = 0 := by
          ext i
          exact h_all0 i (Set.mem_univ i)
        have hdeg := hq (MvPolynomial.mem_support_iff.mp hd)
        rw [hd0, map_zero] at hdeg
        exact hm hdeg.symm
    let f_grad : 𝒜_k →+*ᵍ 𝒜_K :=
      { toRingHom := MvPolynomial.map φ
        map_mem := fun {n p} hp => by
          rw [MvPolynomial.mem_homogeneousSubmodule] at hp ⊢
          intro d hd
          rw [MvPolynomial.coeff_map] at hd
          have hp_ne : p.coeff d ≠ 0 := fun h0 => hd (by rw [h0, map_zero])
          exact hp hp_ne }
    have hf_irrel : HomogeneousIdeal.irrelevant 𝒜_K ≤
        HomogeneousIdeal.map f_grad (HomogeneousIdeal.irrelevant 𝒜_k) := by
      change (HomogeneousIdeal.irrelevant 𝒜_K).toIdeal ≤
        Ideal.map f_grad.toRingHom (HomogeneousIdeal.irrelevant 𝒜_k).toIdeal
      refine le_trans (hIrrel K) ?_
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      have hXi_irrel : (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ∈
          HomogeneousIdeal.irrelevant 𝒜_k := by
        rw [HomogeneousIdeal.mem_irrelevant_iff]
        have hXi1 : (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) k) ∈ 𝒜_k 1 :=
          MvPolynomial.isHomogeneous_X k i
        change (DirectSum.decompose 𝒜_k (MvPolynomial.X i) 0 : MvPolynomial (Fin (N + 1)) k) = 0
        rw [DirectSum.decompose_of_mem_ne 𝒜_k hXi1 (by decide : (1 : ℕ) ≠ 0)]
      have hmapX : f_grad.toRingHom (MvPolynomial.X i) = MvPolynomial.X i :=
        MvPolynomial.map_X φ i
      rw [← hmapX]
      exact Ideal.mem_map_of_mem f_grad.toRingHom hXi_irrel
    have hEquiv : ∀ (F : Type u) [Field F] (a : Fin (N + 1)),
        letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) :=
          MvPolynomial.gradedAlgebra
        ∀ (x : MvPolynomial (Fin (N + 1)) F) (_ : x = MvPolynomial.X a),
          ∃ (e : MvPolynomial {b : Fin (N + 1) // b ≠ a} F ≃+*
              HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) x),
            (∀ c : F,
              e (MvPolynomial.C c) =
                HomogeneousLocalization.fromZeroRingHom
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) (Submonoid.powers x)
                  (algebraMap F ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 0) c)) ∧
            (∀ (b : {b : Fin (N + 1) // b ≠ a})
               (hx1 : x ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F 1),
              e (MvPolynomial.X b) =
                HomogeneousLocalization.Away.mk
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F) hx1 1
                  (MvPolynomial.X b.1)
                  (by rw [one_smul, MvPolynomial.mem_homogeneousSubmodule]; exact MvPolynomial.isHomogeneous_X F b.1)) := by
      intro F _ a x hx
      cases hx
      let 𝒜_F := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F
      letI : GradedAlgebra 𝒜_F := MvPolynomial.gradedAlgebra
      let τ_a := {b : Fin (N + 1) // b ≠ a}
      let x_a : MvPolynomial (Fin (N + 1)) F := MvPolynomial.X a
      have hXa : x_a ∈ 𝒜_F 1 :=
        (MvPolynomial.mem_homogeneousSubmodule 1 x_a).mpr (MvPolynomial.isHomogeneous_X F a)
      let M_a : Submonoid (MvPolynomial (Fin (N + 1)) F) := Submonoid.powers x_a
      let c_hom : F →+* HomogeneousLocalization.Away 𝒜_F x_a :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_F M_a).comp (algebraMap F ↥(𝒜_F 0))
      let u_var : τ_a → HomogeneousLocalization.Away 𝒜_F x_a := fun b =>
        HomogeneousLocalization.Away.mk 𝒜_F hXa 1 (MvPolynomial.X b.1)
          (by rw [one_smul]; exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X F b.1))
      let α_hom : MvPolynomial τ_a F →+* HomogeneousLocalization.Away 𝒜_F x_a :=
        MvPolynomial.eval₂Hom c_hom u_var
      let val_hom : HomogeneousLocalization.Away 𝒜_F x_a →+* Localization M_a :=
        { toFun := HomogeneousLocalization.val
          map_one' := HomogeneousLocalization.val_one
          map_mul' := HomogeneousLocalization.val_mul
          map_zero' := HomogeneousLocalization.val_zero
          map_add' := HomogeneousLocalization.val_add }
      let dehom : MvPolynomial (Fin (N + 1)) F →+* MvPolynomial τ_a F :=
        MvPolynomial.eval₂Hom MvPolynomial.C
          (fun j : Fin (N + 1) => if hj : j = a then 1 else MvPolynomial.X ⟨j, hj⟩)
      have h_units : ∀ y : M_a, IsUnit (dehom y.1) := by
        rintro ⟨_, r, rfl⟩
        simp [dehom, x_a]
      let lift_dehom : Localization M_a →+* MvPolynomial τ_a F :=
        IsLocalization.lift (M := M_a) h_units
      let β_hom : HomogeneousLocalization.Away 𝒜_F x_a →+* MvPolynomial τ_a F :=
        lift_dehom.comp val_hom
      have hval_c : ∀ c : F,
          val_hom (c_hom c) =
            algebraMap (MvPolynomial (Fin (N + 1)) F) (Localization M_a) (MvPolynomial.C c) := by
        intro c
        rfl
      have hval_c_mk : ∀ c : F,
          val_hom (c_hom c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        rfl
      have h_alg_mk : ∀ q : MvPolynomial (Fin (N + 1)) F,
          algebraMap (MvPolynomial (Fin (N + 1)) F) (Localization M_a) q = Localization.mk q 1 := by
        intro q
        exact (Localization.mk_one_eq_algebraMap (M := M_a) (x := q)).symm
      have h_left : β_hom.comp α_hom = RingHom.id _ := by
        apply MvPolynomial.ringHom_ext'
        · apply RingHom.ext; intro c
          change lift_dehom (val_hom (α_hom (MvPolynomial.C c))) = MvPolynomial.C c
          rw [MvPolynomial.eval₂Hom_C, hval_c, IsLocalization.lift_eq]
          simp [dehom]
        · intro b
          change lift_dehom (val_hom (α_hom (MvPolynomial.X b))) = MvPolynomial.X b
          rw [MvPolynomial.eval₂Hom_X']
          change lift_dehom (HomogeneousLocalization.Away.mk 𝒜_F hXa 1 (MvPolynomial.X b.1) _).val =
            MvPolynomial.X b
          rw [HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk'_apply]
          refine (IsLocalization.lift_mk'_spec h_units _ (MvPolynomial.X b) _).mpr ?_
          simp [dehom, x_a, b.2]
      let ψ : MvPolynomial (Fin (N + 1)) F →+* Localization M_a :=
        (val_hom.comp α_hom).comp dehom
      have hψ_C : ∀ c : F, ψ (MvPolynomial.C c) = Localization.mk (MvPolynomial.C c) 1 := by
        intro c
        change val_hom (α_hom (MvPolynomial.eval₂Hom MvPolynomial.C _ (MvPolynomial.C c))) = _
        rw [MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_C]
        exact hval_c_mk c
      have hψ_X : ∀ j : Fin (N + 1),
          ψ (MvPolynomial.X j) = Localization.mk (MvPolynomial.X j) ⟨x_a, Submonoid.mem_powers x_a⟩ := by
        intro j
        change val_hom (α_hom (MvPolynomial.eval₂Hom MvPolynomial.C _ (MvPolynomial.X j))) = _
        rw [MvPolynomial.eval₂Hom_X']
        split_ifs with hj
        · subst hj
          rw [map_one, map_one]
          exact (Localization.mk_self (⟨x_a, Submonoid.mem_powers x_a⟩ : M_a)).symm
        · rw [MvPolynomial.eval₂Hom_X']
          change (HomogeneousLocalization.Away.mk 𝒜_F hXa 1 (MvPolynomial.X j) _).val = _
          rw [HomogeneousLocalization.Away.val_mk]
          congr 1
          apply Subtype.ext
          exact pow_one x_a
      have hψ_prod : ∀ (s : Finset (Fin (N + 1))) (d : Fin (N + 1) →₀ ℕ),
          (∏ j ∈ s, ψ (MvPolynomial.X j) ^ d j) =
            Localization.mk (∏ j ∈ s, MvPolynomial.X j ^ d j)
              ⟨x_a ^ (∑ j ∈ s, d j), M_a.pow_mem (Submonoid.mem_powers x_a) _⟩ := by
        intro s d
        induction s using Finset.cons_induction with
        | empty =>
          simp only [Finset.prod_empty, Finset.sum_empty, pow_zero]
          exact (Localization.mk_self (1 : M_a)).symm
        | cons j s hjs ih =>
          rw [Finset.prod_cons, Finset.prod_cons, Finset.sum_cons, hψ_X j,
            Localization.mk_pow, ih, Localization.mk_mul]
          congr 1
          apply Subtype.ext
          exact (pow_add x_a (d j) (∑ i ∈ s, d i)).symm
      have hψ_homog : ∀ (m : ℕ) (P : MvPolynomial (Fin (N + 1)) F),
          P.IsHomogeneous m →
          ψ P = Localization.mk P ⟨x_a ^ m, M_a.pow_mem (Submonoid.mem_powers x_a) m⟩ := by
        intro m P hP
        let den_m : M_a := ⟨x_a ^ m, M_a.pow_mem (Submonoid.mem_powers x_a) m⟩
        have h_mon : ∀ d ∈ P.support,
            ψ (MvPolynomial.monomial d (P.coeff d)) =
              algebraMap (MvPolynomial (Fin (N + 1)) F) (Localization M_a)
                (MvPolynomial.monomial d (P.coeff d)) * Localization.mk 1 den_m := by
          intro d hd
          have hd_deg : (∑ j ∈ d.support, d j) = m := by
            have hw := hP (MvPolynomial.mem_support_iff.mp hd)
            simpa [Finsupp.weight_apply, Finsupp.sum] using hw
          rw [MvPolynomial.monomial_eq, map_mul, hψ_C]
          dsimp [Finsupp.prod]
          rw [map_prod]
          have hp : (∏ j ∈ d.support, ψ (MvPolynomial.X j ^ d j)) =
              (∏ j ∈ d.support, ψ (MvPolynomial.X j) ^ d j) := by
            refine Finset.prod_congr rfl fun j _ => map_pow ψ _ _
          rw [hp, hψ_prod d.support d, Localization.mk_mul, h_alg_mk, Localization.mk_mul]
          congr 1
          · exact (mul_one _).symm
          · apply Subtype.ext; simp [den_m, hd_deg]
        conv_lhs => rw [MvPolynomial.as_sum P]
        rw [map_sum, Finset.sum_congr rfl h_mon, ← Finset.sum_mul, ← map_sum,
          ← MvPolynomial.as_sum P, h_alg_mk, Localization.mk_mul, mul_one]
        congr 1
        apply Subtype.ext
        exact one_mul _
      have h_right : ∀ z : HomogeneousLocalization.Away 𝒜_F x_a, α_hom (β_hom z) = z := by
        intro z
        apply HomogeneousLocalization.val_injective
        refine Quotient.inductionOn' z fun nd => ?_
        rcases nd with ⟨m, ⟨P, hP⟩, ⟨Q, hQ⟩, hQ_mem⟩
        rcases hQ_mem with ⟨r, hr⟩
        dsimp at hr
        have hQr : Q.IsHomogeneous r := by
          rw [← hr]
          simpa using hXa.pow r
        have hQ_ne : Q ≠ 0 := by
          rw [← hr]
          exact pow_ne_zero r (MvPolynomial.X_ne_zero a)
        obtain ⟨d₀, hd₀⟩ : ∃ d₀, Q.coeff d₀ ≠ 0 := by
          by_contra h_zero
          push_neg at h_zero
          apply hQ_ne
          ext d
          simpa using h_zero d
        have hrm : r = m := (hQr hd₀).symm.trans (hQ hd₀)
        subst hrm
        have hQ_eq : Q = x_a ^ r := hr.symm
        subst hQ_eq
        change val_hom (α_hom (lift_dehom (HomogeneousLocalization.mk ⟨r, ⟨P, hP⟩, ⟨x_a ^ r, hQ⟩, _⟩).val)) =
          (HomogeneousLocalization.mk ⟨r, ⟨P, hP⟩, ⟨x_a ^ r, hQ⟩, _⟩).val
        rw [HomogeneousLocalization.val_mk]
        have h_liftP : lift_dehom (Localization.mk P ⟨x_a ^ r, M_a.pow_mem (Submonoid.mem_powers x_a) r⟩) =
            dehom P := by
          rw [Localization.mk_eq_mk'_apply]
          refine (IsLocalization.lift_mk'_spec h_units P (dehom P) _).mpr ?_
          simp [dehom, x_a]
        rw [h_liftP]
        exact hψ_homog r P hP
      refine ⟨{ toFun := α_hom
                invFun := β_hom
                left_inv := fun p => congrArg (fun g : _ →+* _ => g p) h_left
                right_inv := h_right
                map_mul' := α_hom.map_mul
                map_add' := α_hom.map_add }, ?_, ?_⟩
      · intro c
        exact MvPolynomial.eval₂Hom_C _ _ c
      · intro b _
        exact MvPolynomial.eval₂Hom_X' _ _ b
    let π : AlgebraicGeometry.Proj 𝒜_K ⟶ AlgebraicGeometry.Proj 𝒜_k :=
      AlgebraicGeometry.Proj.map f_grad hf_irrel
    let p_k : AlgebraicGeometry.Proj 𝒜_k ⟶ AlgebraicGeometry.Spec (CommRingCat.of k) :=
      (weilProjectiveSpaceOver k N).hom
    let p_K : AlgebraicGeometry.Proj 𝒜_K ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      (weilProjectiveSpaceOver K N).hom
    let s_φ : AlgebraicGeometry.Spec (CommRingCat.of K) ⟶
        AlgebraicGeometry.Spec (CommRingCat.of k) :=
      AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ)
    have hXa_k : ∀ a : Fin (N + 1), MvPolynomial.X a ∈ 𝒜_k 1 :=
      fun a => (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k a)
    have hSpecPB : ∀ a : Fin (N + 1),
        CategoryTheory.IsPullback
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_grad (MvPolynomial.X a))))
          (AlgebraicGeometry.Proj.awayι 𝒜_K (f_grad (MvPolynomial.X a))
            (f_grad.map_mem (hXa_k a)) Nat.one_pos ≫ p_K)
          (AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X a)
            (hXa_k a) Nat.one_pos ≫ p_k)
          s_φ := by
      intro a
      let τ_a := {b : Fin (N + 1) // b ≠ a}
      obtain ⟨e_k, he_k_C, he_k_X⟩ := hEquiv k a (MvPolynomial.X a) rfl
      obtain ⟨e_K, he_K_C, he_K_X⟩ := hEquiv K a (f_grad (MvPolynomial.X a)) (MvPolynomial.map_X φ a)
      have hPush_poly : CategoryTheory.IsPushout
          (CommRingCat.ofHom (MvPolynomial.C : k →+* MvPolynomial τ_a k))
          (CommRingCat.ofHom φ)
          (CommRingCat.ofHom (MvPolynomial.map φ : MvPolynomial τ_a k →+* MvPolynomial τ_a K))
          (CommRingCat.ofHom (MvPolynomial.C : K →+* MvPolynomial τ_a K)) := by
        refine CategoryTheory.IsPushout.mk
          (CategoryTheory.CommSq.mk (by
            apply CommRingCat.hom_ext; apply RingHom.ext; intro c
            exact MvPolynomial.map_C φ c))
          ⟨CategoryTheory.Limits.PushoutCocone.IsColimit.mk _
            (fun s => CommRingCat.ofHom (MvPolynomial.eval₂Hom s.inr.hom (fun b => s.inl.hom (MvPolynomial.X b))))
            (fun s => by
              apply CommRingCat.hom_ext
              apply MvPolynomial.ringHom_ext'
              · ext c
                change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map φ (MvPolynomial.C c)) =
                  s.inl.hom (MvPolynomial.C c)
                rw [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C]
                exact (congrArg (fun g : CommRingCat.of k ⟶ s.pt => g.hom c) s.condition).symm
              · intro b
                change MvPolynomial.eval₂Hom s.inr.hom _ (MvPolynomial.map φ (MvPolynomial.X b)) =
                  s.inl.hom (MvPolynomial.X b)
                rw [MvPolynomial.map_X, MvPolynomial.eval₂Hom_X'])
            (fun s => by
              apply CommRingCat.hom_ext; apply RingHom.ext; intro c
              exact MvPolynomial.eval₂Hom_C _ _ c)
            (fun s m hm_inl hm_inr => by
              apply CommRingCat.hom_ext
              apply MvPolynomial.ringHom_ext'
              · ext c
                have hc := congrArg (fun g : CommRingCat.of K ⟶ s.pt => g.hom c) hm_inr
                simpa using hc
              · intro b
                have hb := congrArg
                  (fun g : CommRingCat.of (MvPolynomial τ_a k) ⟶ s.pt => g.hom (MvPolynomial.X b))
                  hm_inl
                simpa using hb)⟩
      let j_k : k →+* HomogeneousLocalization.Away 𝒜_k (MvPolynomial.X a) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_k (Submonoid.powers (MvPolynomial.X a))).comp
          (algebraMap k ↥(𝒜_k 0))
      let j_K : K →+* HomogeneousLocalization.Away 𝒜_K (f_grad (MvPolynomial.X a)) :=
        (HomogeneousLocalization.fromZeroRingHom 𝒜_K
          (Submonoid.powers (f_grad (MvPolynomial.X a)))).comp (algebraMap K ↥(𝒜_K 0))
      have hPush_hloc : CategoryTheory.IsPushout
          (CommRingCat.ofHom j_k) (CommRingCat.ofHom φ)
          (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_grad (MvPolynomial.X a)))
          (CommRingCat.ofHom j_K) := by
        refine CategoryTheory.IsPushout.of_iso hPush_poly
          (CategoryTheory.Iso.refl _) e_k.toCommRingCatIso (CategoryTheory.Iso.refl _)
          e_K.toCommRingCatIso ?_ ?_ ?_ ?_
        · apply CommRingCat.hom_ext; apply RingHom.ext; intro c
          exact he_k_C c
        · simp
        · apply CommRingCat.hom_ext
          change e_K.toRingHom.comp (MvPolynomial.map φ) =
            (HomogeneousLocalization.Away.map f_grad (MvPolynomial.X a)).comp e_k.toRingHom
          apply MvPolynomial.ringHom_ext'
          · apply RingHom.ext; intro c
            simp only [RingHom.comp_apply, MvPolynomial.map_C, RingEquiv.toRingHom_eq_coe,
              RingHom.coe_coe, he_K_C, he_k_C]
            apply HomogeneousLocalization.val_injective
            have hz_eq : HomogeneousLocalization.fromZeroRingHom 𝒜_k
                (Submonoid.powers (MvPolynomial.X a)) (algebraMap k ↥(𝒜_k 0) c) =
                HomogeneousLocalization.Away.mk 𝒜_k (hXa_k a) 0 (MvPolynomial.C c)
                  (by rw [zero_smul]; exact (MvPolynomial.mem_homogeneousSubmodule 0 _).mpr (MvPolynomial.isHomogeneous_C _ c)) := by
              apply HomogeneousLocalization.val_injective
              rw [HomogeneousLocalization.Away.val_mk]
              rfl
            change Localization.mk (MvPolynomial.C (φ c)) 1 =
              (HomogeneousLocalization.Away.map f_grad (MvPolynomial.X a)
                (HomogeneousLocalization.fromZeroRingHom 𝒜_k
                  (Submonoid.powers (MvPolynomial.X a)) (algebraMap k ↥(𝒜_k 0) c))).val
            rw [hz_eq, HomogeneousLocalization.Away.map_mk, HomogeneousLocalization.Away.val_mk]
            congr 1
            exact (MvPolynomial.map_C φ c).symm
          · intro b
            simp only [RingHom.comp_apply, MvPolynomial.map_X, RingEquiv.toRingHom_eq_coe,
              RingHom.coe_coe]
            rw [he_k_X b (hXa_k a), he_K_X b (f_grad.map_mem (hXa_k a)),
              HomogeneousLocalization.Away.map_mk]
            congr 1
            exact (MvPolynomial.map_X φ b.1).symm
        · apply CommRingCat.hom_ext; apply RingHom.ext; intro c
          exact he_K_C c
      have hp_raw := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPush_hloc
      have h_pk_eq : AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X a)
          (hXa_k a) Nat.one_pos ≫ p_k =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_k) := by
        dsimp [p_k, weilProjectiveSpaceOver, j_k, 𝒜_k]
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      have h_pK_eq : AlgebraicGeometry.Proj.awayι 𝒜_K (f_grad (MvPolynomial.X a))
          (f_grad.map_mem (hXa_k a)) Nat.one_pos ≫ p_K =
          AlgebraicGeometry.Spec.map (CommRingCat.ofHom j_K) := by
        dsimp [p_K, weilProjectiveSpaceOver, j_K, 𝒜_K]
        rw [AlgebraicGeometry.Proj.awayι_toSpecZero_assoc, ← AlgebraicGeometry.Spec.map_comp,
          ← CommRingCat.ofHom_comp]
      rwa [h_pk_eq, h_pK_eq]
    have hCov_k : (⨆ a : Fin (N + 1), AlgebraicGeometry.Proj.basicOpen 𝒜_k (MvPolynomial.X a)) = ⊤ :=
      AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_k MvPolynomial.X (hIrrel k)
    have hCov_K : (⨆ a : Fin (N + 1),
        AlgebraicGeometry.Proj.basicOpen 𝒜_K (f_grad (MvPolynomial.X a))) = ⊤ := by
      refine AlgebraicGeometry.Proj.iSup_basicOpen_eq_top 𝒜_K (fun a => f_grad (MvPolynomial.X a)) ?_
      have h_rng : Set.range (fun a : Fin (N + 1) => f_grad (MvPolynomial.X a)) =
          Set.range (MvPolynomial.X : Fin (N + 1) → MvPolynomial (Fin (N + 1)) K) := by
        ext p; constructor
        · rintro ⟨a, rfl⟩; exact ⟨a, (MvPolynomial.map_X φ a).symm⟩
        · rintro ⟨a, rfl⟩; exact ⟨a, MvPolynomial.map_X φ a⟩
      rw [h_rng]
      exact hIrrel K
    have hComm : π ≫ p_k = p_K ≫ s_φ := by
      apply AlgebraicGeometry.Scheme.hom_ext_of_forall
      intro x
      have hx : x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜_K).Opens) := trivial
      rw [← hCov_K, TopologicalSpace.Opens.mem_iSup] at hx
      rcases hx with ⟨a, ha⟩
      refine ⟨AlgebraicGeometry.Proj.basicOpen 𝒜_K (f_grad (MvPolynomial.X a)), ha, ?_⟩
      let isoK := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_K (f_grad (MvPolynomial.X a))
        (f_grad.map_mem (hXa_k a)) Nat.one_pos
      rw [← CategoryTheory.Iso.cancel_iso_hom_left isoK.symm]
      change (isoK.inv ≫ (AlgebraicGeometry.Proj.basicOpen 𝒜_K (f_grad (MvPolynomial.X a))).ι) ≫
          (π ≫ p_k) =
        (isoK.inv ≫ (AlgebraicGeometry.Proj.basicOpen 𝒜_K (f_grad (MvPolynomial.X a))).ι) ≫
          (p_K ≫ s_φ)
      rw [AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι]
      rw [← CategoryTheory.Category.assoc _ π p_k,
        AlgebraicGeometry.Proj.awayι_comp_map f_grad hf_irrel Nat.one_pos (MvPolynomial.X a)
          (hXa_k a),
        CategoryTheory.Category.assoc, (hSpecPB a).w, CategoryTheory.Category.assoc]
    let PB := CategoryTheory.Limits.pullback p_k s_φ
    let fst_PB : PB ⟶ AlgebraicGeometry.Proj 𝒜_k := CategoryTheory.Limits.pullback.fst p_k s_φ
    let snd_PB : PB ⟶ AlgebraicGeometry.Spec (CommRingCat.of K) :=
      CategoryTheory.Limits.pullback.snd p_k s_φ
    let Φ : AlgebraicGeometry.Proj 𝒜_K ⟶ PB :=
      CategoryTheory.Limits.pullback.lift π p_K hComm
    let W : Fin (N + 1) → PB.Opens := fun a =>
      (TopologicalSpace.Opens.map fst_PB.base).obj
        (AlgebraicGeometry.Proj.basicOpen 𝒜_k (MvPolynomial.X a))
    have hCov_W : (⨆ a : Fin (N + 1), W a) = ⊤ := by
      rw [eq_top_iff]
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      have hx : fst_PB.base x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜_k).Opens) := trivial
      rw [← hCov_k, TopologicalSpace.Opens.mem_iSup] at hx
      exact hx
    have hIso_Φ : CategoryTheory.IsIso Φ := by
      have hLocal := (AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme.{u})
        (f := Φ) W hCov_W).mpr
      refine hLocal fun a => ?_
      change CategoryTheory.IsIso (Φ ∣_ W a)
      let U_k := AlgebraicGeometry.Proj.basicOpen 𝒜_k (MvPolynomial.X a)
      let U_K := AlgebraicGeometry.Proj.basicOpen 𝒜_K (f_grad (MvPolynomial.X a))
      let V_Φ : (AlgebraicGeometry.Proj 𝒜_K).Opens := (TopologicalSpace.Opens.map Φ.base).obj (W a)
      have hV_eq : V_Φ = U_K := by
        have h1 : V_Φ = (TopologicalSpace.Opens.map (Φ ≫ fst_PB).base).obj U_k := rfl
        have h2 : Φ ≫ fst_PB = π := CategoryTheory.Limits.pullback.lift_fst _ _ _
        rw [h1, h2]
        exact AlgebraicGeometry.Proj.map_preimage_basicOpen f_grad hf_irrel (MvPolynomial.X a)
      let iso_V_UK : (V_Φ : AlgebraicGeometry.Scheme.{u}) ≅ (U_K : AlgebraicGeometry.Scheme.{u}) :=
        (AlgebraicGeometry.Proj 𝒜_K).isoOfEq hV_eq
      have hiso_V_ι : iso_V_UK.inv ≫ V_Φ.ι = U_K.ι :=
        AlgebraicGeometry.Scheme.isoOfEq_inv_ι _ hV_eq
      let iso_Uk := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_k (MvPolynomial.X a)
        (hXa_k a) Nat.one_pos
      let iso_UK := AlgebraicGeometry.Proj.basicOpenIsoSpec 𝒜_K (f_grad (MvPolynomial.X a))
        (f_grad.map_mem (hXa_k a)) Nat.one_pos
      have hp_W : CategoryTheory.IsPullback
          (fst_PB ∣_ U_k ≫ iso_Uk.hom) ((W a).ι ≫ snd_PB)
          (iso_Uk.inv ≫ U_k.ι ≫ p_k) s_φ := by
        have hp0 := (AlgebraicGeometry.isPullback_morphismRestrict fst_PB U_k).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback p_k s_φ)
        refine CategoryTheory.IsPullback.of_iso hp0 (CategoryTheory.Iso.refl _) iso_Uk
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ ?_ ?_
        · simp
        · exact (CategoryTheory.Category.id_comp _).symm
        · simp
        · simp
      have hp_W' : CategoryTheory.IsPullback
          (fst_PB ∣_ U_k ≫ iso_Uk.hom) ((W a).ι ≫ snd_PB)
          (AlgebraicGeometry.Proj.awayι 𝒜_k (MvPolynomial.X a)
            (hXa_k a) Nat.one_pos ≫ p_k) s_φ := by
        rwa [← CategoryTheory.Category.assoc iso_Uk.inv, AlgebraicGeometry.Proj.basicOpenIsoSpec_inv_ι] at hp_W
