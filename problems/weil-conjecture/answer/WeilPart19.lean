      dsimp [g₀]; infer_instance
    have : AlgebraicGeometry.QuasiCompact g₀ := by
      dsimp [g₀]; infer_instance
    have : AlgebraicGeometry.Surjective g₀ := by
      refine AlgebraicGeometry.Surjective.mk (fun s => ?_)
      obtain ⟨w, hw⟩ := hSurjπ.surj s
      let w₀ : ↥W := (α (-u w)).base w
      have hw₀_mem : w₀ ∈ U₀ := by
        change u ((α (-u w)).base w) = 0
