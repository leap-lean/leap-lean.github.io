        (AlgebraicGeometry.Scheme.Hom.resLE μ_R U_R O_R le_rfl) hφ_comp
        (q_C ∣_ O_R) (O_KR.ι ≫ f_CK)
        (q_Y ∣_ U_R) (U_KR.ι ≫ f_YK)
        (AlgebraicGeometry.Scheme.Hom.resLE μ_K U_KR O_KR hO_K)
        hpO_K hpU_K hφK_comm hφK_comp hIso_φK
    refine ⟨h, hh_ne, ?_⟩
    intro S _ φ_RS hUnitS C_S Y_S q_CS f_CS q_YS f_YS μ_S U_S hpCS hpYS hcommS hcompS hUS
    subst hUS
    let O_SR : C_S.Opens := (TopologicalSpace.Opens.map q_CS.base).obj O_R
    let U_SR : Y_S.Opens := (TopologicalSpace.Opens.map q_YS.base).obj U_R
    obtain ⟨hO_S, _, hpO_S, hpU_S, hφS_comm, hφS_comp, hIso_iff_S⟩ :=
      pullback_resLE_and_morphismRestrict_over_base
        (AlgebraicGeometry.Spec (CommRingCat.of R)) (AlgebraicGeometry.Spec (CommRingCat.of S))
        C_R Y_R C_S Y_S (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS))
        fC fY μ_R hμ q_CS f_CS q_YS f_YS μ_S hpCS hpYS hcommS hcompS U_R O_R le_rfl
    have hEqS : O_SR = (TopologicalSpace.Opens.map μ_S.base).obj U_SR := by
      ext x
      have hb : (μ_S ≫ q_YS).base x = (q_CS ≫ μ_R).base x := by rw [hcommS]
      change (q_CS ≫ μ_R).base x ∈ U_R ↔ (μ_S ≫ q_YS).base x ∈ U_R
      rw [hb]
    have hIso_φS := h_spread S φ_RS hUnitS
      (O_SR : AlgebraicGeometry.Scheme.{u}) (U_SR : AlgebraicGeometry.Scheme.{u})
      (q_CS ∣_ O_R) (O_SR.ι ≫ f_CS)
      (q_YS ∣_ U_R) (U_SR.ι ≫ f_YS)
      (AlgebraicGeometry.Scheme.Hom.resLE μ_S U_SR O_SR hO_S)
      hpO_S hpU_S hφS_comm hφS_comp
    exact (hIso_iff_S hEqS).mp hIso_φS
  refine ⟨hConj1, hConj2, ?_⟩
  intro C_R Y_R C_K Y_K fC fY _ _ μ_R hμ q_C f_CK q_Y f_YK μ_K hpC hpY hcommK hcompK hFinK
  have _ : AlgebraicGeometry.IsLocallyNoetherian C_R :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian fC
  have _ : CompactSpace ↥Y_R := AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace fY
  obtain ⟨m, V, hAffV, hCovV⟩ :=
    exists_finite_affineOpen_cover_of_isCompact (⊤ : Y_R.Opens) isCompact_univ
  have _ : AlgebraicGeometry.IsAffineHom ξ := isAffineHom_specMap (algebraMap R K)
  have _ : AlgebraicGeometry.IsAffineHom q_Y :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hpY.flip inferInstance
  have _ : AlgebraicGeometry.IsAffineHom μ_K := @AlgebraicGeometry.IsFinite.toIsAffineHom _ _ μ_K hFinK
  have h_aff_piece : ∀ α : Fin m,
      ∃ (h_α : R) (_ : h_α ≠ 0),
        ∀ (S : Type u) [CommRing S] (φ_RS : R →+* S),
          IsUnit (φ_RS h_α) →
          ∀ (C_S : AlgebraicGeometry.Scheme.{u})
            (q_CS : C_S ⟶ C_R) (f_CS : C_S ⟶ AlgebraicGeometry.Spec (CommRingCat.of S)),
            CategoryTheory.IsPullback q_CS f_CS fC
              (AlgebraicGeometry.Spec.map (CommRingCat.ofHom φ_RS)) →
            AlgebraicGeometry.IsAffineOpen
              ((TopologicalSpace.Opens.map q_CS.base).obj
                ((TopologicalSpace.Opens.map μ_R.base).obj (V α))) := by
    intro α
    let O_α : C_R.Opens := (TopologicalSpace.Opens.map μ_R.base).obj (V α)
    let O_αK : C_K.Opens := (TopologicalSpace.Opens.map q_C.base).obj O_α
