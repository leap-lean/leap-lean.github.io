      let R₀ : CategoryTheory.Presieve E := CategoryTheory.Presieve.ofArrows E_fam u_fam
      let S_cov : CategoryTheory.Sieve E := CategoryTheory.Sieve.generate R₀
      have hS_mem : S_cov ∈ W.smallEtaleTopology E := by
        let P_et : CategoryTheory.MorphismProperty AlgebraicGeometry.Scheme.{u} := @AlgebraicGeometry.Etale
        have hEqTop := AlgebraicGeometry.Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
          (P := P_et) (Q := P_et) W (le_refl P_et)
        have hPreMem : S_cov ∈ (AlgebraicGeometry.Scheme.smallPretopology P_et P_et).toGrothendieck E := by
          refine (CategoryTheory.Pretopology.mem_toGrothendieck _ E S_cov).mpr ⟨R₀, ?_, CategoryTheory.Sieve.le_generate R₀⟩
          refine ⟨?_, ?_⟩
          · intro x
            obtain ⟨y₀, hy₀⟩ := hx_fam x
            refine ⟨↥(E_fam x).left, AlgebraicGeometry.Scheme.forget.map (u_fam x).left, ?_, y₀, hy₀⟩
            exact CategoryTheory.Presieve.map.of
              (CategoryTheory.Presieve.map.of
                (CategoryTheory.Presieve.map.of (CategoryTheory.Presieve.ofArrows.mk x)))
