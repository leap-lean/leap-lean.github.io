            change (θ_γ ≫ CategoryTheory.Limits.pullback.fst π π).base w = w
            rw [hθ_fst]
            rfl
          have hR : (CategoryTheory.Limits.pullback.fst π π).base (ψ.base z) = (f₁.base z).1 := by
            change (ψ ≫ CategoryTheory.Limits.pullback.fst π π).base z = (f₁.base z).1
            rw [hψ_fst]
            rfl
          exact hL.symm.trans (hfst.trans hR)
        have h2 : (α γ).base w = (f₂.base z).1 := by
