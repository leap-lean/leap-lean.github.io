            dsimp only [α_R]
            rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, map_one,
              Algebra.TensorProduct.lift_tmul, map_one, mul_one]
            rfl
          · apply AlgHom.ext; intro d
            change α_R (β_hom (algebraMap BD Loc ((1 : B) ⊗ₜ[R'] d))) =
              algebraMap BD Loc ((1 : B) ⊗ₜ[R'] d)
            rw [IsLocalization.Away.lift_eq]
            change α_R ((Algebra.TensorProduct.map (AlgHom.id R' B) (IsScalarTower.toAlgHom R' D E))
              ((1 : B) ⊗ₜ[R'] d)) = _
            dsimp only [α_R]
            rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
              Algebra.TensorProduct.lift_tmul, map_one, one_mul]
            exact IsLocalization.Away.lift_eq g hUnit_g d
