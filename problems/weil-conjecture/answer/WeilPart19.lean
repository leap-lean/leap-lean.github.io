        ← CategoryTheory.Category.assoc (iso₁ a').inv, hiso₁_inv a']
      dsimp only [π]
      rw [← CategoryTheory.Category.assoc,
        AlgebraicGeometry.Proj.awayι_comp_map f_grad hf_irrel zero_lt_one
          (MvPolynomial.X a') (hX1_k a'),
        CategoryTheory.Category.assoc, (hSpecPB a').w, CategoryTheory.Category.assoc]
    let Φ : AlgebraicGeometry.Proj 𝒜_k₀ ⟶ CategoryTheory.Limits.pullback p_k s_φ :=
      CategoryTheory.Limits.pullback.lift π p_k₀ hComm_π
    let fst_P := CategoryTheory.Limits.pullback.fst p_k s_φ
    let snd_P := CategoryTheory.Limits.pullback.snd p_k s_φ
    let W : Fin (N + 1) → (CategoryTheory.Limits.pullback p_k s_φ).Opens :=
      fun a => (TopologicalSpace.Opens.map fst_P.base).obj (U₀ a)
    have hCovW : ⨆ a, W a = ⊤ := by
      apply TopologicalSpace.Opens.ext
      ext x
      simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion, TopologicalSpace.Opens.coe_top,
        Set.mem_univ, iff_true]
      have hx : fst_P.base x ∈ (⊤ : (AlgebraicGeometry.Proj 𝒜_k).Opens) := trivial
      rw [← hCovU₀, TopologicalSpace.Opens.mem_iSup] at hx
      exact hx
    have hIsoΦ : CategoryTheory.IsIso Φ := by
      change CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme Φ
      rw [AlgebraicGeometry.IsZariskiLocalAtTarget.iff_of_iSup_eq_top
        (P := CategoryTheory.MorphismProperty.isomorphisms AlgebraicGeometry.Scheme) W hCovW]
      intro a
      change CategoryTheory.IsIso (Φ ∣_ W a)
      have sq_W : CategoryTheory.IsPullback (fst_P ∣_ U₀ a) ((W a).ι ≫ snd_P)
          ((U₀ a).ι ≫ p_k) s_φ :=
        (AlgebraicGeometry.isPullback_morphismRestrict fst_P (U₀ a)).paste_vert
          (CategoryTheory.IsPullback.of_hasPullback p_k s_φ)
      let π_a : (U₁ a : AlgebraicGeometry.Scheme.{u}) ⟶ (U₀ a : AlgebraicGeometry.Scheme.{u}) :=
        (iso₁ a).hom ≫
          AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (HomogeneousLocalization.Away.map f_grad (MvPolynomial.X a))) ≫
          (iso₀ a).inv
      have hπ_a_ι : π_a ≫ (U₀ a).ι = (U₁ a).ι ≫ π := by
        rw [← CategoryTheory.Iso.cancel_iso_inv_left (iso₁ a)]
        dsimp only [π_a]
        rw [CategoryTheory.Category.assoc, CategoryTheory.Category.assoc, hiso₀_inv a,
          ← CategoryTheory.Category.assoc (iso₁ a).inv, (iso₁ a).inv_hom_id,
          CategoryTheory.Category.id_comp, ← CategoryTheory.Category.assoc, hiso₁_inv a]
        exact (AlgebraicGeometry.Proj.awayι_comp_map f_grad hf_irrel zero_lt_one
          (MvPolynomial.X a) (hX1_k a)).symm
      have sq_U₁ : CategoryTheory.IsPullback π_a ((U₁ a).ι ≫ p_k₀) ((U₀ a).ι ≫ p_k) s_φ := by
        refine (hSpecPB a).of_iso (iso₁ a).symm (iso₀ a).symm
          (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ ?_ ?_
        · dsimp only [π_a]
          simp only [CategoryTheory.Iso.symm_hom, CategoryTheory.Iso.inv_hom_id_assoc]
        · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
            CategoryTheory.Iso.symm_hom]
          rw [← CategoryTheory.Category.assoc, hiso₁_inv a]
        · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
            CategoryTheory.Iso.symm_hom]
          rw [← CategoryTheory.Category.assoc, hiso₀_inv a]
        · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
            CategoryTheory.Category.id_comp]
      have hPre_a : Φ ⁻¹ᵁ W a = U₁ a := by
        have hΦ_fst : Φ ≫ fst_P = π := CategoryTheory.Limits.pullback.lift_fst _ _ _
        calc
          Φ ⁻¹ᵁ W a = (Φ ≫ fst_P) ⁻¹ᵁ U₀ a := rfl
          _ = π ⁻¹ᵁ U₀ a := by rw [hΦ_fst]
          _ = U₁ a := AlgebraicGeometry.Proj.map_preimage_basicOpen f_grad hf_irrel (MvPolynomial.X a)
      let e_pre : (U₁ a : AlgebraicGeometry.Scheme.{u}) ≅
          ((Φ ⁻¹ᵁ W a : (AlgebraicGeometry.Proj 𝒜_k₀).Opens) : AlgebraicGeometry.Scheme.{u}) :=
        (AlgebraicGeometry.Proj 𝒜_k₀).isoOfEq hPre_a.symm
      let e_pb := CategoryTheory.IsPullback.isoIsPullback _ _ sq_U₁ sq_W
      have h_comp_eq : e_pre.hom ≫ (Φ ∣_ W a) = e_pb.hom := by
        apply sq_W.hom_ext
        · rw [← CategoryTheory.cancel_mono (U₀ a).ι]
          calc
            (e_pre.hom ≫ (Φ ∣_ W a)) ≫ (fst_P ∣_ U₀ a) ≫ (U₀ a).ι
              = e_pre.hom ≫ (Φ ∣_ W a) ≫ (W a).ι ≫ fst_P := by
                  simp only [CategoryTheory.Category.assoc, AlgebraicGeometry.morphismRestrict_ι]
                  rfl
            _ = e_pre.hom ≫ (Φ ⁻¹ᵁ W a).ι ≫ Φ ≫ fst_P := by
                  rw [AlgebraicGeometry.morphismRestrict_ι_assoc]
            _ = (U₁ a).ι ≫ Φ ≫ fst_P := by
                  rw [AlgebraicGeometry.Scheme.isoOfEq_hom_ι_assoc]
            _ = π_a ≫ (U₀ a).ι := by
                  have hΦ_fst : Φ ≫ fst_P = π := CategoryTheory.Limits.pullback.lift_fst _ _ _
                  rw [hΦ_fst, hπ_a_ι]
            _ = (e_pb.hom ≫ (fst_P ∣_ U₀ a)) ≫ (U₀ a).ι := by
                  rw [CategoryTheory.IsPullback.isoIsPullback_hom_fst]
        · rw [CategoryTheory.IsPullback.isoIsPullback_hom_snd]
          simp only [CategoryTheory.Category.assoc]
          rw [AlgebraicGeometry.morphismRestrict_ι_assoc,
            AlgebraicGeometry.Scheme.isoOfEq_hom_ι_assoc]
          have hΦ_snd : Φ ≫ snd_P = p_k₀ := CategoryTheory.Limits.pullback.lift_snd _ _ _
          rw [hΦ_snd]
      haveI : CategoryTheory.IsIso (e_pre.hom ≫ (Φ ∣_ W a)) := by
        rw [h_comp_eq]
        infer_instance
      exact CategoryTheory.IsIso.of_isIso_comp_left e_pre.hom (Φ ∣_ W a)
    have sqProj : CategoryTheory.IsPullback π P_k₀.hom P_k.hom α := by
      change CategoryTheory.IsPullback π p_k₀ p_k α
      rw [← hs_φ]
      refine (CategoryTheory.IsPullback.of_hasPullback p_k s_φ).of_iso (CategoryTheory.asIso Φ).symm
        (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) (CategoryTheory.Iso.refl _) ?_ ?_ ?_ ?_
      · simp only [CategoryTheory.Iso.symm_hom, CategoryTheory.asIso_inv,
          CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          CategoryTheory.IsIso.eq_inv_comp]
        exact CategoryTheory.Limits.pullback.lift_fst _ _ _
      · simp only [CategoryTheory.Iso.symm_hom, CategoryTheory.asIso_inv,
          CategoryTheory.Iso.refl_hom, CategoryTheory.Category.comp_id,
          CategoryTheory.IsIso.eq_inv_comp]
        exact CategoryTheory.Limits.pullback.lift_snd _ _ _
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.comp_id]
      · simp only [CategoryTheory.Iso.refl_hom, CategoryTheory.Category.id_comp,
          CategoryTheory.Category.comp_id]
        rfl
    let Q := CategoryTheory.Limits.pullback Z₁.hom P_k.hom
    let p₁ := CategoryTheory.Limits.pullback.fst Z₁.hom P_k.hom
    let p₂ := CategoryTheory.Limits.pullback.snd Z₁.hom P_k.hom
    let j_Q : P_k₀.left ⟶ Q :=
      CategoryTheory.Limits.pullback.lift (P_k₀.hom ≫ s) π (by
        rw [CategoryTheory.Category.assoc]
        exact sqProj.w.symm)
    have sq_Q : CategoryTheory.IsPullback j_Q P_k₀.hom p₁ s := by
      refine CategoryTheory.IsPullback.of_right ?_ ?_
        (CategoryTheory.IsPullback.of_hasPullback Z₁.hom P_k.hom).flip
      · have hj_p₂ : j_Q ≫ p₂ = π := CategoryTheory.Limits.pullback.lift_snd _ _ _
        rwa [hj_p₂]
      · exact CategoryTheory.Limits.pullback.lift_fst _ _ _
    let C_s := CategoryTheory.Limits.pullback f.left s
    let fst_Cs := CategoryTheory.Limits.pullback.fst f.left s
    let snd_Cs := CategoryTheory.Limits.pullback.snd f.left s
    have hCs_comm : (fst_Cs ≫ ι) ≫ p₁ = snd_Cs ≫ s := by
      rw [CategoryTheory.Category.assoc, hιf]
      exact CategoryTheory.Limits.pullback.condition
    let ι_s : C_s ⟶ P_k₀.left := sq_Q.lift (fst_Cs ≫ ι) snd_Cs hCs_comm
    have hι_s_fst : ι_s ≫ j_Q = fst_Cs ≫ ι := sq_Q.lift_fst _ _ _
    have hι_s_snd : ι_s ≫ P_k₀.hom = snd_Cs := sq_Q.lift_snd _ _ _
    have sq_ι : CategoryTheory.IsPullback ι_s fst_Cs j_Q ι := by
      refine CategoryTheory.IsPullback.of_right ?_ hι_s_fst sq_Q.flip
      rw [hι_s_snd, hιf]
      exact (CategoryTheory.IsPullback.of_hasPullback f.left s).flip
    have hClosed_ιs : AlgebraicGeometry.IsClosedImmersion ι_s :=
      CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback sq_ι.flip hClosed_ι
    exact ⟨N, CategoryTheory.Over.homMk ι_s hι_s_snd, hClosed_ιs⟩

theorem weil_algClosed_p1_baseChange_flat_cover_curve_resolution (K₀ : Type u) [Field K₀]
    (Y_K₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
    (π_K₀ : Y_K₀ ⟶ weilProjectiveSpaceOver K₀ 1)
    (hFin : AlgebraicGeometry.IsFinite π_K₀.left)
    (hFlat : AlgebraicGeometry.Flat π_K₀.left)
    (hSurj : AlgebraicGeometry.Surjective π_K₀.left) :
    let Ω₀ : Type u := AlgebraicClosure K₀
    let Y_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) :=
      weilBaseChangeOver K₀ Ω₀ Y_K₀
    ∃ (s : ℕ)
      (C_bar : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)))
      (μ_tilde_bar : ∀ j : Fin s, C_bar j ⟶ Y_bar)
      (μ_bar : ∀ j : Fin s, (C_bar j).left ⟶ Y_bar.left.nilradical.subscheme)
      (U_bar : Fin s → Y_bar.left.Opens),
      (∀ j : Fin s, AlgebraicGeometry.IsIntegral (C_bar j).left) ∧
      (∀ j : Fin s, IsProjectiveOverField Ω₀ (C_bar j)) ∧
      (∀ j : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension 1 (C_bar j).hom) ∧
      (∀ j : Fin s, AlgebraicGeometry.IsFinite (μ_tilde_bar j).left) ∧
      (∀ j : Fin s, μ_bar j ≫ Y_bar.left.nilradical.subschemeι = (μ_tilde_bar j).left) ∧
      (⋃ j : Fin s, Set.range (μ_tilde_bar j).left.base) = Set.univ ∧
      ((⋃ j : Fin s, (U_bar j : Set Y_bar.left))ᶜ).Finite ∧
      (∀ i j : Fin s, i ≠ j → Disjoint (U_bar i) (U_bar j)) ∧
      (∀ i j : Fin s, i ≠ j →
        ((μ_tilde_bar j).left.base) ⁻¹' (U_bar i : Set Y_bar.left) = ∅) ∧
      (∀ j : Fin s,
        CategoryTheory.IsIso
          ((μ_bar j) ∣_
            ((TopologicalSpace.Opens.map Y_bar.left.nilradical.subschemeι.base).obj
              (U_bar j)))) :=
by
  classical
  let _ := hSurj
  let Ω₀ : Type u := AlgebraicClosure K₀
  let Y_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) :=
    weilBaseChangeOver K₀ Ω₀ Y_K₀
  let P₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)) :=
    weilProjectiveSpaceOver K₀ 1
  let α₀ : AlgebraicGeometry.Spec (CommRingCat.of Ω₀) ⟶
      AlgebraicGeometry.Spec (CommRingCat.of K₀) :=
    AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ Ω₀))
  let P_bar : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) :=
    weilBaseChangeOver K₀ Ω₀ P₁

  
  have isReduced_subscheme_of_radical :
      ∀ (X : AlgebraicGeometry.Scheme.{u}) (I : X.IdealSheafData),
        I.radical = I → AlgebraicGeometry.IsReduced I.subscheme := by
    intro X I hRad
    refine @AlgebraicGeometry.IsReduced.of_openCover _ I.subschemeCover.openCover (fun U => ?_)
    change AlgebraicGeometry.IsReduced
      (AlgebraicGeometry.Spec (CommRingCat.of (↑(X.presheaf.obj (Opposite.op U.1)) ⧸ I.ideal U)))
    rw [AlgebraicGeometry.affine_isReduced_iff]
    change IsReduced (↑(X.presheaf.obj (Opposite.op U.1)) ⧸ I.ideal U)
    rw [← Ideal.isRadical_iff_quotient_reduced]
    intro x hx
    have h1 : x ∈ (I.ideal U).radical := hx
    rw [← I.radical_ideal U, hRad] at h1
    exact h1

  have radical_vanishingIdeal :
      ∀ (X : AlgebraicGeometry.Scheme.{u}) (C : TopologicalSpace.Closeds ↥X),
        (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C).radical =
          AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal C := by
    intro X C
    rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support]
    congr 1

  
  
  
  have hPropP₁ : AlgebraicGeometry.IsProper P₁.hom := by
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K₀
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let : IsScalarTower K₀ ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) K₀) :=
      IsScalarTower.of_algebraMap_eq (R := K₀) (S := ↥(𝒜 0)) (A := MvPolynomial (Fin (1 + 1)) K₀)
        (fun _ => rfl)
    let : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) K₀) :=
      Algebra.FiniteType.of_restrictScalars_finiteType K₀ ↥(𝒜 0) (MvPolynomial (Fin (1 + 1)) K₀)
    let φ : K₀ →+* ↥(𝒜 0) := algebraMap K₀ ↥(𝒜 0)
    have hφ_bij : Function.Bijective φ := by
      constructor
      · intro a b hab
        exact MvPolynomial.C_injective (Fin (1 + 1)) K₀ (congrArg Subtype.val hab)
      · intro x
        have hx : x.1 ∈ (1 : Submodule K₀ (MvPolynomial (Fin (1 + 1)) K₀)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero]
          exact x.2
        rw [Submodule.mem_one] at hx
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, Subtype.ext hr⟩
    have : CategoryTheory.IsIso (CommRingCat.ofHom φ) :=
      (ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom φ)).mpr hφ_bij
    dsimp [P₁, weilProjectiveSpaceOver]
    infer_instance
  let _ : AlgebraicGeometry.IsProper P₁.hom := hPropP₁
  have hPropP_bar : AlgebraicGeometry.IsProper P_bar.hom := by
    dsimp [P_bar, weilBaseChangeOver]
    infer_instance
  let _ : AlgebraicGeometry.IsProper P_bar.hom := hPropP_bar

  obtain ⟨hSmP₁, hBaseP₁⟩ := weil_projLine_smooth_and_baseChange_krullDim_one K₀
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 P₁.hom := hSmP₁
  obtain ⟨hIrrP_bar, hDimP_bar⟩ := hBaseP₁ Ω₀ α₀
  let _ : IrreducibleSpace ↥P_bar.left := hIrrP_bar
  have hSmP_bar : AlgebraicGeometry.SmoothOfRelativeDimension 1 P_bar.hom :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @AlgebraicGeometry.SmoothOfRelativeDimension 1)
      (CategoryTheory.IsPullback.of_hasPullback P₁.hom α₀) hSmP₁
  let _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 P_bar.hom := hSmP_bar

  let _ : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨-, hSmCurveInt, hProjFiber⟩ :=
    weil_smooth_proj_curve_fiber_integral_and_projective K₀ 2
  have hIntP_bar : AlgebraicGeometry.IsIntegral P_bar.left :=
    hSmCurveInt Ω₀ P_bar inferInstance

  have hProjP_bar : IsProjectiveOverField Ω₀ P_bar := by
    let Z₁ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)) :=
      CategoryTheory.Over.mk (𝟙 (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
    let f_P₁ : P₁ ⟶ Z₁ :=
      CategoryTheory.Over.homMk P₁.hom (CategoryTheory.Category.comp_id P₁.hom)
    let ι_P₁ : P₁.left ⟶ CategoryTheory.Limits.pullback Z₁.hom P₁.hom :=
      CategoryTheory.Limits.pullback.lift P₁.hom (𝟙 P₁.left) (by
        dsimp [Z₁]
        rw [CategoryTheory.Category.comp_id, CategoryTheory.Category.id_comp])
    have _ : CategoryTheory.IsIso Z₁.hom := by
      dsimp [Z₁]
      infer_instance
    have _ : CategoryTheory.IsIso (CategoryTheory.Limits.pullback.snd Z₁.hom P₁.hom) :=
      inferInstance
    have hIso_ιP₁ : CategoryTheory.IsIso ι_P₁ := by
      have hEq : ι_P₁ = CategoryTheory.inv (CategoryTheory.Limits.pullback.snd Z₁.hom P₁.hom) := by
        calc
          ι_P₁ = ι_P₁ ≫ (CategoryTheory.Limits.pullback.snd Z₁.hom P₁.hom ≫
              CategoryTheory.inv (CategoryTheory.Limits.pullback.snd Z₁.hom P₁.hom)) := by
            rw [CategoryTheory.IsIso.hom_inv_id, CategoryTheory.Category.comp_id]
          _ = (ι_P₁ ≫ CategoryTheory.Limits.pullback.snd Z₁.hom P₁.hom) ≫
              CategoryTheory.inv (CategoryTheory.Limits.pullback.snd Z₁.hom P₁.hom) := by
            rw [CategoryTheory.Category.assoc]
          _ = CategoryTheory.inv (CategoryTheory.Limits.pullback.snd Z₁.hom P₁.hom) := by
            rw [CategoryTheory.Limits.pullback.lift_snd, CategoryTheory.Category.id_comp]
      rw [hEq]
      infer_instance
    exact hProjFiber Z₁ P₁ f_P₁
      ⟨1, ι_P₁, inferInstance, CategoryTheory.Limits.pullback.lift_fst _ _ _⟩ Ω₀ α₀

  
  have hπ_comm : (CategoryTheory.Limits.pullback.fst Y_K₀.hom α₀ ≫ π_K₀.left) ≫ P₁.hom =
      CategoryTheory.Limits.pullback.snd Y_K₀.hom α₀ ≫ α₀ := by
    rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w π_K₀,
      CategoryTheory.Limits.pullback.condition]
  let π_bar : Y_bar.left ⟶ P_bar.left :=
    CategoryTheory.Limits.pullback.lift
      (CategoryTheory.Limits.pullback.fst Y_K₀.hom α₀ ≫ π_K₀.left)
      (CategoryTheory.Limits.pullback.snd Y_K₀.hom α₀) hπ_comm
  have hπ_bar_hom : π_bar ≫ P_bar.hom = Y_bar.hom :=
    CategoryTheory.Limits.pullback.lift_snd _ _ _
  have hp_π_tot : CategoryTheory.IsPullback (π_bar ≫ P_bar.hom)
      (CategoryTheory.Limits.pullback.fst Y_K₀.hom α₀) α₀ (π_K₀.left ≫ P₁.hom) := by
    have h1 : π_bar ≫ P_bar.hom = CategoryTheory.Limits.pullback.snd Y_K₀.hom α₀ := hπ_bar_hom
    have h2 : π_K₀.left ≫ P₁.hom = Y_K₀.hom := CategoryTheory.Over.w π_K₀
    rw [h1, h2]
    exact (CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom α₀).flip
  have hp_π_bar : CategoryTheory.IsPullback π_bar
      (CategoryTheory.Limits.pullback.fst Y_K₀.hom α₀)
      (CategoryTheory.Limits.pullback.fst P₁.hom α₀) π_K₀.left :=
    CategoryTheory.IsPullback.of_right hp_π_tot
      (CategoryTheory.Limits.pullback.lift_fst _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback P₁.hom α₀).flip
  have hFin_π_bar : AlgebraicGeometry.IsFinite π_bar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_π_bar.flip hFin
  have hFlat_π_bar : AlgebraicGeometry.Flat π_bar :=
    CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback hp_π_bar.flip hFlat
  let _ : AlgebraicGeometry.IsFinite π_bar := hFin_π_bar
  let _ : AlgebraicGeometry.Flat π_bar := hFlat_π_bar

  
  have hPropY_bar : AlgebraicGeometry.IsProper Y_bar.hom := by
    rw [← hπ_bar_hom]
    infer_instance
  let _ : AlgebraicGeometry.IsProper Y_bar.hom := hPropY_bar
  have hLocNoethY : AlgebraicGeometry.IsLocallyNoetherian Y_bar.left :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian Y_bar.hom
  have hCompY : CompactSpace ↥Y_bar.left :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace Y_bar.hom
  let _ : AlgebraicGeometry.IsLocallyNoetherian Y_bar.left := hLocNoethY
  let _ : CompactSpace ↥Y_bar.left := hCompY
  have hNoethY : AlgebraicGeometry.IsNoetherian Y_bar.left := AlgebraicGeometry.IsNoetherian.mk
  let _ : AlgebraicGeometry.IsNoetherian Y_bar.left := hNoethY
  let _ : TopologicalSpace.NoetherianSpace ↥Y_bar.left :=
    AlgebraicGeometry.IsNoetherian.noetherianSpace

  have hFinComp : (irreducibleComponents ↥Y_bar.left).Finite :=
    AlgebraicGeometry.finite_irreducibleComponents_of_isNoetherian
  let hFintypeComp : Fintype ↑(irreducibleComponents ↥Y_bar.left) := hFinComp.fintype
  let s : ℕ := @Fintype.card _ hFintypeComp
  let e_comp : Fin s ≃ ↑(irreducibleComponents ↥Y_bar.left) :=
    (@Fintype.equivFin _ hFintypeComp).symm

  let E : Fin s → Set ↥Y_bar.left := fun j => (e_comp j).1
  have hMemE : ∀ j : Fin s, E j ∈ irreducibleComponents ↥Y_bar.left := fun j => (e_comp j).2
  have hIrrE : ∀ j : Fin s, IsIrreducible (E j) := fun j => (hMemE j).1
  have hMaxE : ∀ (j : Fin s) (t : Set ↥Y_bar.left), IsIrreducible t → E j ⊆ t → t ⊆ E j :=
    fun j => (hMemE j).2
  have hClE_set : ∀ j : Fin s, IsClosed (E j) :=
    fun j => isClosed_of_mem_irreducibleComponents (E j) (hMemE j)

  let C_cl : Fin s → TopologicalSpace.Closeds ↥Y_bar.left := fun j => ⟨E j, hClE_set j⟩
  let I_E : Fin s → Y_bar.left.IdealSheafData :=
    fun j => AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal (C_cl j)
  let ι_E : ∀ j : Fin s, (I_E j).subscheme ⟶ Y_bar.left := fun j => (I_E j).subschemeι
  let V : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)) :=
    fun j => CategoryTheory.Over.mk (ι_E j ≫ Y_bar.hom)

  have hCl_ιE : ∀ j : Fin s, AlgebraicGeometry.IsClosedImmersion (ι_E j) :=
    fun _ => inferInstance
  have hEmb_ιE : ∀ j : Fin s, Topology.IsClosedEmbedding (ι_E j).base :=
    fun j => ((AlgebraicGeometry.isClosedImmersion_iff (ι_E j)).mp (hCl_ιE j)).2
  have hRange_ιE : ∀ j : Fin s, Set.range (ι_E j).base = E j := by
    intro j
    dsimp [ι_E, I_E, C_cl]
    rw [AlgebraicGeometry.Scheme.IdealSheafData.range_subschemeι,
      AlgebraicGeometry.Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl

  have hUnivE : (⋃ j : Fin s, Set.range (ι_E j).base) = Set.univ := by
    ext y
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    let comp_y : ↑(irreducibleComponents ↥Y_bar.left) :=
      ⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩
    refine ⟨e_comp.symm comp_y, ?_⟩
    rw [hRange_ιE]
    dsimp [E]
    rw [e_comp.apply_symm_apply]
    exact mem_irreducibleComponent

  have hIncompE : ∀ i j : Fin s, i ≠ j → ¬ (Set.range (ι_E i).base ⊆ Set.range (ι_E j).base) := by
    intro i j hij hSub
    rw [hRange_ιE i, hRange_ιE j] at hSub
    have hEq : E i = E j := Set.Subset.antisymm hSub (hMaxE i (E j) (hIrrE j) hSub)
    exact hij (e_comp.injective (Subtype.ext hEq))

  
  have hIrrV : ∀ j : Fin s, IrreducibleSpace ↥(V j).left := by
    intro j
    refine { isPreirreducible_univ := ?_, toNonempty := ?_ }
    · intro u v hu hv ⟨a, _, hau⟩ ⟨b, _, hbv⟩
      obtain ⟨u', hu', rfl⟩ := (hEmb_ιE j).isInducing.isOpen_iff.mp hu
      obtain ⟨v', hv', rfl⟩ := (hEmb_ιE j).isInducing.isOpen_iff.mp hv
      have hau' : (ι_E j).base a ∈ E j ∩ u' := ⟨hRange_ιE j ▸ ⟨a, rfl⟩, hau⟩
      have hbv' : (ι_E j).base b ∈ E j ∩ v' := ⟨hRange_ιE j ▸ ⟨b, rfl⟩, hbv⟩
      obtain ⟨y, hyE, hyu', hyv'⟩ :=
        (hIrrE j).2 u' v' hu' hv' ⟨(ι_E j).base a, hau'⟩ ⟨(ι_E j).base b, hbv'⟩
      obtain ⟨c, rfl⟩ : y ∈ Set.range (ι_E j).base := (hRange_ιE j).symm ▸ hyE
      exact ⟨c, trivial, hyu', hyv'⟩
    · obtain ⟨y, hy⟩ := (hIrrE j).1
      obtain ⟨c, _⟩ : y ∈ Set.range (ι_E j).base := (hRange_ιE j).symm ▸ hy
      exact ⟨c⟩

  have hRedV : ∀ j : Fin s, AlgebraicGeometry.IsReduced (V j).left :=
    fun j => isReduced_subscheme_of_radical Y_bar.left (I_E j)
      (radical_vanishingIdeal Y_bar.left (C_cl j))

  have hIntV : ∀ j : Fin s, AlgebraicGeometry.IsIntegral (V j).left := by
    intro j
    rw [AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced]
    exact ⟨hIrrV j, hRedV j⟩

  let g_V : ∀ j : Fin s, V j ⟶ P_bar := fun j =>
    CategoryTheory.Over.homMk (ι_E j ≫ π_bar) (by
      dsimp [V]
      rw [CategoryTheory.Category.assoc, hπ_bar_hom])

  have hFin_gV : ∀ j : Fin s, AlgebraicGeometry.IsFinite (g_V j).left := by
    intro j
    change AlgebraicGeometry.IsFinite (ι_E j ≫ π_bar)
    let _ : AlgebraicGeometry.IsClosedImmersion (ι_E j) := hCl_ιE j
    infer_instance

  have hSurj_gV : ∀ j : Fin s, AlgebraicGeometry.Surjective (g_V j).left := by
    intro j
    let _ : IrreducibleSpace ↥(V j).left := hIrrV j
    let _ : AlgebraicGeometry.IsFinite (g_V j).left := hFin_gV j
    refine ⟨fun p => ?_⟩
    let ηV : ↥(V j).left := genericPoint ↥(V j).left
    let η : ↥Y_bar.left := (ι_E j).base ηV
    have hCl_η : closure ({η} : Set ↥Y_bar.left) = E j := by
      apply Set.Subset.antisymm
      · exact closure_minimal
          (Set.singleton_subset_iff.mpr (hRange_ιE j ▸ ⟨ηV, rfl⟩)) (hClE_set j)
      · intro y hy
        obtain ⟨v, rfl⟩ : y ∈ Set.range (ι_E j).base := (hRange_ιE j).symm ▸ hy
        have hpre_cl : IsClosed ((ι_E j).base ⁻¹' closure ({η} : Set ↥Y_bar.left)) :=
          isClosed_closure.preimage (ι_E j).continuous
        have hηV_mem : ηV ∈ (ι_E j).base ⁻¹' closure ({η} : Set ↥Y_bar.left) :=
          subset_closure (Set.mem_singleton η)
        have hpre_univ : (ι_E j).base ⁻¹' closure ({η} : Set ↥Y_bar.left) = Set.univ := by
          apply Set.eq_univ_of_univ_subset
          rw [← genericPoint_spec ↥(V j).left]
          exact closure_minimal (Set.singleton_subset_iff.mpr hηV_mem) hpre_cl
        have hv_mem : v ∈ (ι_E j).base ⁻¹' closure ({η} : Set ↥Y_bar.left) := by
          rw [hpre_univ]
          trivial
        exact hv_mem
    let ξP : ↥P_bar.left := genericPoint ↥P_bar.left
    have hSpec : ξP ⤳ π_bar.base η := genericPoint_specializes (π_bar.base η)
    obtain ⟨y', hy'_spec, hy'_eq⟩ := AlgebraicGeometry.Flat.generalizingMap π_bar hSpec
    have hη_in : η ∈ closure ({y'} : Set ↥Y_bar.left) := specializes_iff_mem_closure.mp hy'_spec
    have hE_sub : E j ⊆ closure ({y'} : Set ↥Y_bar.left) :=
      hCl_η ▸ closure_minimal (Set.singleton_subset_iff.mpr hη_in) isClosed_closure
    have hy'_sub : closure ({y'} : Set ↥Y_bar.left) ⊆ E j :=
      hMaxE j (closure ({y'} : Set ↥Y_bar.left))
        (isIrreducible_singleton (x := y')).closure hE_sub
    have hy'_in_E : y' ∈ E j := hy'_sub (subset_closure (Set.mem_singleton y'))
    obtain ⟨v', hv'⟩ : y' ∈ Set.range (ι_E j).base := (hRange_ιE j).symm ▸ hy'_in_E
    have hξ_range : ξP ∈ Set.range (g_V j).left.base := by
      refine ⟨v', ?_⟩
      dsimp [g_V]
      simp [hv', hy'_eq]
    have hClosed_range : IsClosed (Set.range (g_V j).left.base) := by
      rw [← Set.image_univ]
      exact (g_V j).left.isClosedMap Set.univ isClosed_univ
    have hUniv_sub : (Set.univ : Set ↥P_bar.left) ⊆ Set.range (g_V j).left.base := by
      rw [← genericPoint_spec ↥P_bar.left]
      exact closure_minimal (Set.singleton_subset_iff.mpr hξ_range) hClosed_range
    exact hUniv_sub trivial

  have hProjDimV : ∀ j : Fin s,
      IsProjectiveOverField Ω₀ (V j) ∧ topologicalKrullDim (V j).left = (1 : WithBot ℕ∞) := by
    intro j
    obtain ⟨hProjVj, hDimEq⟩ := weil_isFinite_projective_and_krullDim_over_field Ω₀ (g_V j)
      (hIntV j) hIntP_bar hProjP_bar (hFin_gV j) (hSurj_gV j)
    exact ⟨hProjVj, hDimEq.trans hDimP_bar⟩
  have hProjV : ∀ j : Fin s, IsProjectiveOverField Ω₀ (V j) := fun j => (hProjDimV j).1
  have hDimV : ∀ j : Fin s, topologicalKrullDim (V j).left = (1 : WithBot ℕ∞) :=
    fun j => (hProjDimV j).2

  
  
  
  have hNormEx : ∀ j : Fin s,
      ∃ (C : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of Ω₀)))
        (ν : C ⟶ V j)
        (U_ν : (V j).left.Opens),
        AlgebraicGeometry.IsIntegral C.left ∧
        IsProjectiveOverField Ω₀ C ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 C.hom ∧
        AlgebraicGeometry.IsFinite ν.left ∧
        AlgebraicGeometry.Surjective ν.left ∧
        Nonempty U_ν ∧
        CategoryTheory.IsIso (ν.left ∣_ U_ν) := by
    intro j
    obtain ⟨C, ν, U_ν, hIntC, hFinν, _, hSurjν, hNonemptyUν, hIsoν, hNormCov⟩ :=
      weil_algClosed_scheme_normalization_finite_birational Ω₀ (V j) (hIntV j) (hProjV j)
        (@weil_algClosed_finiteType_domain_integralClosure_finite Ω₀ _ _)
    obtain ⟨hProjC, hDimCEq⟩ := weil_isFinite_projective_and_krullDim_over_field Ω₀ ν
      hIntC (hIntV j) (hProjV j) hFinν hSurjν
    have hDimC : topologicalKrullDim C.left = ((0 + 1 : ℕ) : WithBot ℕ∞) := by
      rw [hDimCEq, hDimV j]
      norm_num
    obtain ⟨W_reg, hSmW, hCodim⟩ :=
      weil_affineNormal_scheme_codim2_smooth_open Ω₀ 0 C hIntC hProjC hDimC hNormCov
        (@weil_algClosed_integrallyClosed_domain_smooth_away_of_height_le_one Ω₀ _ _)
    have hW_top : W_reg = ⊤ := by
      ext z
      constructor
      · intro _; trivial
      · intro _
        by_contra hz
        let Zc : Set ↥C.left := (W_reg : Set ↥C.left)ᶜ
        let z' : ↥Zc := ⟨z, hz⟩
        have _ : Nonempty (TopologicalSpace.IrreducibleCloseds ↥Zc) :=
          ⟨⟨closure ({z'} : Set ↥Zc), (isIrreducible_singleton (x := z')).closure,
            isClosed_closure⟩⟩
        have h0 : (0 : WithBot ℕ∞) ≤ topologicalKrullDim ↥Zc := Order.krullDim_nonneg
        have h2 : (0 : WithBot ℕ∞) + 2 ≤ ((0 + 1 : ℕ) : WithBot ℕ∞) :=
          (add_le_add h0 le_rfl).trans hCodim
        norm_num at h2
    rw [hW_top] at hSmW
    let _ : AlgebraicGeometry.SmoothOfRelativeDimension 1 ((⊤ : C.left.Opens).ι ≫ C.hom) := hSmW
    have hCompSm := AlgebraicGeometry.smoothOfRelativeDimension_comp 0 1
      C.left.topIso.inv ((⊤ : C.left.Opens).ι ≫ C.hom)
    rw [Nat.zero_add, ← CategoryTheory.Category.assoc, ← AlgebraicGeometry.Scheme.topIso_hom,
      CategoryTheory.Iso.inv_hom_id, CategoryTheory.Category.id_comp] at hCompSm
    exact ⟨C, ν, U_ν, hIntC, hProjC, hCompSm, hFinν, hSurjν, hNonemptyUν, hIsoν⟩

  choose C_bar ν U_ν hIntC hProjC hSmC hFinν hSurjν hNonemptyUν hIsoν using hNormEx

  
  
  
  let Y_red := Y_bar.left.nilradical.subscheme
  let i_red : Y_red ⟶ Y_bar.left := Y_bar.left.nilradical.subschemeι

  have hRad_nil : Y_bar.left.nilradical.radical = Y_bar.left.nilradical := by
    rw [← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_top]
    exact radical_vanishingIdeal Y_bar.left ⊤
  have hRed_Yred : AlgebraicGeometry.IsReduced Y_red :=
    isReduced_subscheme_of_radical Y_bar.left Y_bar.left.nilradical hRad_nil
  let _ : AlgebraicGeometry.IsReduced Y_red := hRed_Yred

  
  have hLiftRed : ∀ (Z : AlgebraicGeometry.Scheme.{u}) [AlgebraicGeometry.IsReduced Z]
      (f : Z ⟶ Y_bar.left) [AlgebraicGeometry.QuasiCompact f],
      ∃ f_red : Z ⟶ Y_red, f_red ≫ i_red = f := by
    intro Z _ f _
    have hle : i_red.ker ≤ f.ker := by
      dsimp [i_red]
      rw [Y_bar.left.nilradical.ker_subschemeι,
        ← AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_top]
      have htop : (AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal
          (⊤ : TopologicalSpace.Closeds ↥Y_bar.left)) ≤
          AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal f.ker.support :=
        AlgebraicGeometry.Scheme.IdealSheafData.gc.monotone_u
          (OrderDual.toDual_le_toDual.mpr le_top)
      refine htop.trans ?_
      rw [AlgebraicGeometry.Scheme.IdealSheafData.vanishingIdeal_support,
        AlgebraicGeometry.Scheme.IdealSheafData.le_def]
      intro U x hx
      rw [f.ker.radical_ideal U] at hx
      rw [AlgebraicGeometry.Scheme.Hom.ker_apply] at hx ⊢
      rcases hx with ⟨n, hn⟩
      rw [RingHom.mem_ker] at hn ⊢
      rw [map_pow] at hn
      exact IsNilpotent.eq_zero ⟨n, hn⟩
    exact ⟨AlgebraicGeometry.IsClosedImmersion.lift i_red f hle,
      AlgebraicGeometry.IsClosedImmersion.lift_fac i_red f hle⟩

  let ι_E_over : ∀ j : Fin s, V j ⟶ Y_bar :=
    fun j => CategoryTheory.Over.homMk (ι_E j) rfl
  let μ_tilde_bar : ∀ j : Fin s, C_bar j ⟶ Y_bar :=
    fun j => ν j ≫ ι_E_over j

  have hFin_μtilde : ∀ j : Fin s, AlgebraicGeometry.IsFinite (μ_tilde_bar j).left := by
    intro j
    change AlgebraicGeometry.IsFinite ((ν j).left ≫ ι_E j)
    let _ : AlgebraicGeometry.IsFinite (ν j).left := hFinν j
    let _ : AlgebraicGeometry.IsClosedImmersion (ι_E j) := hCl_ιE j
    infer_instance

  have hLift_μ_ex : ∀ j : Fin s,
      ∃ f_red : (C_bar j).left ⟶ Y_red, f_red ≫ i_red = (μ_tilde_bar j).left := by
    intro j
    let _ : AlgebraicGeometry.IsIntegral (C_bar j).left := hIntC j
    let _ : AlgebraicGeometry.IsFinite (μ_tilde_bar j).left := hFin_μtilde j
    exact hLiftRed (C_bar j).left (μ_tilde_bar j).left
  choose μ_bar hLift_μ using hLift_μ_ex

  have hLift_E_ex : ∀ j : Fin s,
      ∃ e_red : (V j).left ⟶ Y_red, e_red ≫ i_red = ι_E j := by
    intro j
    let _ : AlgebraicGeometry.IsReduced (V j).left := hRedV j
    let _ : AlgebraicGeometry.IsClosedImmersion (ι_E j) := hCl_ιE j
    exact hLiftRed (V j).left (ι_E j)
  choose ι_E_red hLift_E using hLift_E_ex

  have hCl_ιE_red : ∀ j : Fin s, AlgebraicGeometry.IsClosedImmersion (ι_E_red j) := by
    intro j
    have hCompCl : AlgebraicGeometry.IsClosedImmersion (ι_E_red j ≫ i_red) := by
      rw [hLift_E j]
      exact hCl_ιE j
    exact AlgebraicGeometry.IsClosedImmersion.of_comp (ι_E_red j) i_red

  have hμ_fac : ∀ j : Fin s, μ_bar j = (ν j).left ≫ ι_E_red j := by
    intro j
    apply (cancel_mono i_red).mp
    rw [hLift_μ j, CategoryTheory.Category.assoc, hLift_E j]
    rfl

  have hUniv_μtilde : (⋃ j : Fin s, Set.range (μ_tilde_bar j).left.base) = Set.univ := by
    have hRange_eq : ∀ j : Fin s, Set.range (μ_tilde_bar j).left.base = Set.range (ι_E j).base := by
      intro j
      ext y
      constructor
      · rintro ⟨c, rfl⟩
        exact ⟨(ν j).left.base c, rfl⟩
      · rintro ⟨v, rfl⟩
        obtain ⟨c, hc⟩ := (hSurjν j).surj v
        exact ⟨c, by change (ι_E j).base ((ν j).left.base c) = _; rw [hc]⟩
    simp_rw [hRange_eq]
    exact hUnivE

  
  let A_bad : Fin s → Set ↥Y_bar.left :=
    fun j => (ι_E j).base '' ((U_ν j : Set ↥(V j).left)ᶜ)
  have hCl_Abad : ∀ j : Fin s, IsClosed (A_bad j) :=
    fun j => (hEmb_ιE j).isClosedMap _ (U_ν j).isOpen.isClosed_compl
  let F_bad : Fin s → Set ↥Y_bar.left :=
    fun j => A_bad j ∪ ⋃ i ∈ ({i : Fin s | i ≠ j} : Set (Fin s)), E i
  have hCl_Fbad : ∀ j : Fin s, IsClosed (F_bad j) := by
    intro j
    exact (hCl_Abad j).union
      ((Set.toFinite _).isClosed_biUnion (fun i _ => hClE_set i))
  let U_bar : Fin s → Y_bar.left.Opens :=
    fun j => ⟨(F_bad j)ᶜ, (hCl_Fbad j).isOpen_compl⟩

  have hDisj_U : ∀ i j : Fin s, i ≠ j → Disjoint (U_bar i) (U_bar j) := by
    intro i j hij
    rw [disjoint_iff_inf_le]
    intro y ⟨hyi, hyj⟩
    have hy_univ : y ∈ (⋃ k : Fin s, Set.range (ι_E k).base) := by rw [hUnivE]; trivial
    rw [Set.mem_iUnion] at hy_univ
    obtain ⟨k, hk⟩ := hy_univ
    rw [hRange_ιE k] at hk
    by_cases hki : k = i
    · subst hki
      have hkj : k ≠ j := hij
      exact hyj (Or.inr (Set.mem_biUnion hkj hk))
    · exact hyi (Or.inr (Set.mem_biUnion hki hk))

  have hEmpty_pre : ∀ i j : Fin s, i ≠ j →
      ((μ_tilde_bar j).left.base) ⁻¹' (U_bar i : Set Y_bar.left) = ∅ := by
    intro i j hij
    rw [Set.eq_empty_iff_forall_notMem]
    intro c hc
    have hcE : (μ_tilde_bar j).left.base c ∈ E j := by
      rw [← hRange_ιE j]
      exact ⟨(ν j).left.base c, rfl⟩
    exact hc (Or.inr (Set.mem_biUnion hij.symm hcE))

  
  have hProperClosedFin : ∀ (k : Fin s) (Z : Set ↥(V k).left),
      IsClosed Z → Z ≠ Set.univ → Z.Finite := by
    intro k Z hClZ hNeZ
    let _ : IrreducibleSpace ↥(V k).left := hIrrV k
    have _ : TopologicalSpace.NoetherianSpace ↥(V k).left :=
      (hEmb_ιE k).isInducing.noetherianSpace
    obtain ⟨S, hS_fin, hS_cl, hS_irr, rfl⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hClZ
    refine hS_fin.sUnion (fun t ht => ?_)
    have ht_cl : IsClosed t := hS_cl t ht
    have ht_irr : IsIrreducible t := hS_irr t ht
    have ht_ne : t ≠ Set.univ := by
      intro h_eq
      apply hNeZ
      exact Set.eq_univ_of_univ_subset (h_eq ▸ Set.subset_sUnion_of_mem ht)
    refine Set.Subsingleton.finite (fun a ha b hb => ?_)
    by_contra hab
    obtain ⟨η, hη⟩ := QuasiSober.sober ht_irr ht_cl
    obtain ⟨x, hx_t, hx_ne⟩ : ∃ x ∈ t, x ≠ η := by
      by_cases haη : a = η
      · exact ⟨b, hb, fun hbη => hab (haη.trans hbη.symm)⟩
      · exact ⟨a, ha, haη⟩
    let c₀ : TopologicalSpace.IrreducibleCloseds ↥(V k).left :=
      ⟨closure {x}, (isIrreducible_singleton (x := x)).closure, isClosed_closure⟩
    let c₁ : TopologicalSpace.IrreducibleCloseds ↥(V k).left := ⟨t, ht_irr, ht_cl⟩
    let c₂ : TopologicalSpace.IrreducibleCloseds ↥(V k).left :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ ↥(V k).left, isClosed_univ⟩
    have hc01 : c₀ < c₁ := by
      refine lt_of_le_of_ne (closure_minimal (Set.singleton_subset_iff.mpr hx_t) ht_cl) ?_
      intro h_eq
      have h_val : closure ({x} : Set ↥(V k).left) = t := congrArg SetLike.coe h_eq
      have hη_clx : η ∈ closure ({x} : Set ↥(V k).left) := by
        rw [h_val]
        exact hη.mem
      have hx_clη : x ∈ closure ({η} : Set ↥(V k).left) := by
        rw [hη.def]
        exact hx_t
      have h1 : x ⤳ η := specializes_iff_mem_closure.mpr hη_clx
      have h2 : η ⤳ x := specializes_iff_mem_closure.mpr hx_clη
      exact hx_ne (Inseparable.eq (inseparable_iff_specializes_and.mpr ⟨h1, h2⟩))
    have hc12 : c₁ < c₂ := by
      refine lt_of_le_of_ne (Set.subset_univ t) ?_
      intro h_eq
      exact ht_ne (congrArg SetLike.coe h_eq)
    let p : LTSeries (TopologicalSpace.IrreducibleCloseds ↥(V k).left) :=
      { length := 2
        toFun := ![c₀, c₁, c₂]
        step := fun m => by
          fin_cases m
          · exact hc01
          · exact hc12 }
    have hp : (p.length : WithBot ℕ∞) ≤ topologicalKrullDim ↥(V k).left :=
      Order.LTSeries.length_le_krullDim p
    rw [hDimV k] at hp
    change ((2 : ℕ) : WithBot ℕ∞) ≤ (1 : WithBot ℕ∞) at hp
    norm_num at hp

  have hFin_compl : ((⋃ j : Fin s, (U_bar j : Set Y_bar.left))ᶜ).Finite := by
    let B_all : Set ↥Y_bar.left :=
      ⋃ k : Fin s,
        (A_bad k ∪ ⋃ i ∈ ({i : Fin s | i ≠ k} : Set (Fin s)),
          (ι_E k).base '' ((ι_E k).base ⁻¹' (E i)))
    have hSub_bad : ((⋃ j : Fin s, (U_bar j : Set Y_bar.left))ᶜ) ⊆ B_all := by
      intro y hy
      have hy_univ : y ∈ (⋃ k : Fin s, Set.range (ι_E k).base) := by rw [hUnivE]; trivial
      rw [Set.mem_iUnion] at hy_univ
      obtain ⟨k, v, rfl⟩ := hy_univ
      have hy_not_Uk : (ι_E k).base v ∉ (U_bar k : Set Y_bar.left) :=
        fun hmem => hy (Set.mem_iUnion.mpr ⟨k, hmem⟩)
      have hy_Fbad : (ι_E k).base v ∈ F_bad k := by
        by_contra hnot
        exact hy_not_Uk hnot
      refine Set.mem_iUnion.mpr ⟨k, ?_⟩
      rcases hy_Fbad with hA | hUnion
      · exact Or.inl hA
      · rw [Set.mem_iUnion₂] at hUnion
        obtain ⟨i, hik, hiE⟩ := hUnion
        exact Or.inr (Set.mem_biUnion hik ⟨v, hiE, rfl⟩)
    have hFin_Ball : B_all.Finite := by
      refine Set.finite_iUnion (fun k => ?_)
      refine Set.Finite.union ?_ ?_
      · have hNe_Uν : ((U_ν k : Set ↥(V k).left)ᶜ) ≠ Set.univ := by
          obtain ⟨u₀, hu₀⟩ := hNonemptyUν k
          intro hEq
          have : u₀ ∉ (U_ν k : Set ↥(V k).left) := by
            change u₀ ∈ (U_ν k : Set ↥(V k).left)ᶜ
            rw [hEq]
            trivial
          exact this hu₀
        exact (hProperClosedFin k _ (U_ν k).isOpen.isClosed_compl hNe_Uν).image (ι_E k).base
      · refine (Set.toFinite _).biUnion (fun i hik => ?_)
        have hCl_pre : IsClosed ((ι_E k).base ⁻¹' (E i)) :=
          (hClE_set i).preimage (ι_E k).continuous
        have hNe_pre : (ι_E k).base ⁻¹' (E i) ≠ Set.univ := by
          intro hEq
          apply hIncompE k i (Ne.symm hik)
          rw [hRange_ιE i]
          rintro _ ⟨v, rfl⟩
          have hv : v ∈ (ι_E k).base ⁻¹' (E i) := by rw [hEq]; trivial
          exact hv
        exact (hProperClosedFin k _ hCl_pre hNe_pre).image (ι_E k).base
    exact hFin_Ball.subset hSub_bad

  
  have hInj_ired : Function.Injective i_red.base :=
    ((AlgebraicGeometry.isClosedImmersion_iff i_red).mp inferInstance).2.injective

  have hIso_μ : ∀ j : Fin s,
      CategoryTheory.IsIso
        ((μ_bar j) ∣_
          ((TopologicalSpace.Opens.map i_red.base).obj (U_bar j))) := by
    intro j
    let U_red_j : Y_red.Opens := (TopologicalSpace.Opens.map i_red.base).obj (U_bar j)
    let W_j : (V j).left.Opens := ι_E_red j ⁻¹ᵁ U_red_j
    
    have hIso_ιred : CategoryTheory.IsIso (ι_E_red j ∣_ U_red_j) := by
      let _ : AlgebraicGeometry.IsClosedImmersion (ι_E_red j) := hCl_ιE_red j
      have _ : AlgebraicGeometry.IsReduced U_red_j.toScheme :=
        AlgebraicGeometry.isReduced_of_isOpenImmersion U_red_j.ι
      have hSurj_res : AlgebraicGeometry.Surjective (ι_E_red j ∣_ U_red_j) := by
        refine ⟨fun z_u => ?_⟩
        have hy_mem : i_red.base z_u.1 ∈ U_bar j := z_u.2
        have hy_univ : i_red.base z_u.1 ∈ (⋃ k : Fin s, Set.range (ι_E k).base) := by
          rw [hUnivE]; trivial
        rw [Set.mem_iUnion] at hy_univ
        obtain ⟨k, v, hv_eq⟩ := hy_univ
        have hkj : k = j := by
          by_contra hne
          have hy_Ek : i_red.base z_u.1 ∈ E k := by
            rw [← hRange_ιE k]
            exact ⟨v, hv_eq⟩
          exact hy_mem (Or.inr (Set.mem_biUnion hne hy_Ek))
        subst k
        have hv_red : (ι_E_red j).base v = z_u.1 := by
          apply hInj_ired
          calc
            i_red.base ((ι_E_red j).base v) = (ι_E_red j ≫ i_red).base v := by simp
            _ = (ι_E j).base v := by rw [hLift_E j]
            _ = i_red.base z_u.1 := hv_eq
        have hv_W : v ∈ W_j := by
          show (ι_E_red j).base v ∈ U_red_j
          rw [hv_red]
          exact z_u.2
        refine ⟨⟨v, hv_W⟩, ?_⟩
        apply U_red_j.ι.isOpenEmbedding.injective
        change ((ι_E_red j ∣_ U_red_j) ≫ U_red_j.ι).base ⟨v, hv_W⟩ = U_red_j.ι.base z_u
        rw [AlgebraicGeometry.morphismRestrict_ι]
        change (ι_E_red j).base (W_j.ι.base ⟨v, hv_W⟩) = U_red_j.ι.base z_u
        change (ι_E_red j).base v = z_u.1
        exact hv_red
      let _ : AlgebraicGeometry.Surjective (ι_E_red j ∣_ U_red_j) := hSurj_res
      exact AlgebraicGeometry.isIso_of_isClosedImmersion_of_surjective (ι_E_red j ∣_ U_red_j)
    
    have hW_le : W_j ≤ U_ν j := by
      intro v hv
      have h1 : i_red.base ((ι_E_red j).base v) ∈ U_bar j := hv
      have h2 : (ι_E j).base v = i_red.base ((ι_E_red j).base v) := by
        rw [← hLift_E j]
        simp
      have h3 : (ι_E j).base v ∈ U_bar j := h2 ▸ h1
      by_contra hv_not
      exact h3 (Or.inl ⟨v, hv_not, rfl⟩)
    have hIso_νW : CategoryTheory.IsIso ((ν j).left ∣_ W_j) := by
      let _ : CategoryTheory.IsIso ((ν j).left ∣_ (U_ν j)) := hIsoν j
      have hpre : (ν j).left ⁻¹ᵁ W_j ≤ (ν j).left ⁻¹ᵁ (U_ν j) :=
        (TopologicalSpace.Opens.map (ν j).left.base).monotone hW_le
      have hp_top : CategoryTheory.IsPullback ((ν j).left ∣_ W_j)
          ((C_bar j).left.homOfLE hpre)
          ((V j).left.homOfLE hW_le)
          ((ν j).left ∣_ (U_ν j)) := by
        refine CategoryTheory.IsPullback.of_bot ?_ ?_
          (AlgebraicGeometry.isPullback_morphismRestrict (ν j).left (U_ν j))
        · rw [AlgebraicGeometry.Scheme.homOfLE_ι, AlgebraicGeometry.Scheme.homOfLE_ι]
          exact AlgebraicGeometry.isPullback_morphismRestrict (ν j).left W_j
        · apply (cancel_mono (U_ν j).ι).mp
          simp only [CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι,
            AlgebraicGeometry.morphismRestrict_ι]
          rw [← CategoryTheory.Category.assoc, AlgebraicGeometry.Scheme.homOfLE_ι]
      exact hp_top.isIso_fst_of_isIso
    have hIso_comp : CategoryTheory.IsIso (((ν j).left ≫ ι_E_red j) ∣_ U_red_j) := by
      rw [AlgebraicGeometry.morphismRestrict_comp]
      exact @CategoryTheory.IsIso.comp_isIso _ _ _ _ _ _ _ hIso_νW hIso_ιred
    rwa [← hμ_fac j] at hIso_comp

  exact ⟨s, C_bar, μ_tilde_bar, μ_bar, U_bar,
    hIntC, hProjC, hSmC, hFin_μtilde, hLift_μ,
    hUniv_μtilde, hFin_compl, hDisj_U, hEmpty_pre, hIso_μ⟩

theorem weil_finite_tuple_curve_model_descent_over_algClosure (K₀ : Type u) [Field K₀]
    (Y_K₀ : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of K₀)))
    [AlgebraicGeometry.IsProper Y_K₀.hom]
    (s : ℕ)
    (C_bar : Fin s →
      CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K₀))))
    (μ_tilde_bar : ∀ j : Fin s,
      C_bar j ⟶ weilBaseChangeOver K₀ (AlgebraicClosure K₀) Y_K₀)
    (U_bar : Fin s → (weilBaseChangeOver K₀ (AlgebraicClosure K₀) Y_K₀).left.Opens)
    (hProj_bar : ∀ j : Fin s, IsProjectiveOverField (AlgebraicClosure K₀) (C_bar j))
    (hSm_bar : ∀ j : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension 1 (C_bar j).hom) :
    ∃ (L₁ : IntermediateField K₀ (AlgebraicClosure K₀))
      (_ : FiniteDimensional K₀ ↥L₁)
      (C_L₁ : Fin s → CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L₁)))
      (μ_tilde_L₁ : ∀ j : Fin s, C_L₁ j ⟶ weilBaseChangeOver K₀ ↥L₁ Y_K₀)
      (p_C : ∀ j : Fin s, (C_bar j).left ⟶ (C_L₁ j).left)
      (U_tilde_L₁ : Fin s → (weilBaseChangeOver K₀ ↥L₁ Y_K₀).left.Opens),
      (∀ j : Fin s, IsProjectiveOverField ↥L₁ (C_L₁ j)) ∧
      (∀ j : Fin s, AlgebraicGeometry.SmoothOfRelativeDimension 1 (C_L₁ j).hom) ∧
      (∀ j : Fin s,
        CategoryTheory.IsPullback (p_C j) (C_bar j).hom (C_L₁ j).hom
          (AlgebraicGeometry.Spec.map
            (CommRingCat.ofHom (algebraMap ↥L₁ (AlgebraicClosure K₀))))) ∧
      (∀ j : Fin s,
        p_C j ≫ (μ_tilde_L₁ j).left =
          (μ_tilde_bar j).left ≫ weilBaseChangeMap K₀ ↥L₁ (AlgebraicClosure K₀) Y_K₀) ∧
      (∀ j : Fin s,
        (TopologicalSpace.Opens.map
          (weilBaseChangeMap K₀ ↥L₁ (AlgebraicClosure K₀) Y_K₀).base).obj (U_tilde_L₁ j) =
          U_bar j) :=
by
  classical
  have hPropOfProj : ∀ (E : Type u) [Field E]
      (V : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of E))),
      IsProjectiveOverField E V → AlgebraicGeometry.IsProper V.hom := by
    rintro E _ V ⟨N, ι, hCl⟩
    let 𝒜 := MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E
    let : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    let : IsScalarTower E ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E) :=
      IsScalarTower.of_algebraMap_eq (R := E) (S := ↥(𝒜 0))
        (A := MvPolynomial (Fin (N + 1)) E) (fun _ => rfl)
    let : Algebra.FiniteType ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E) :=
      Algebra.FiniteType.of_restrictScalars_finiteType E ↥(𝒜 0) (MvPolynomial (Fin (N + 1)) E)
    let φ : E →+* ↥(𝒜 0) := algebraMap E ↥(𝒜 0)
    have hφ_bij : Function.Bijective φ := by
      constructor
      · intro a b hab
        exact MvPolynomial.C_injective (Fin (N + 1)) E (congrArg Subtype.val hab)
      · intro x
        have hx : x.1 ∈ (1 : Submodule E (MvPolynomial (Fin (N + 1)) E)) := by
          rw [← MvPolynomial.homogeneousSubmodule_zero]
          exact x.2
        rw [Submodule.mem_one] at hx
        obtain ⟨r, hr⟩ := hx
        exact ⟨r, Subtype.ext hr⟩
    have : CategoryTheory.IsIso (CommRingCat.ofHom φ) :=
      (CategoryTheory.ConcreteCategory.isIso_iff_bijective (CommRingCat.ofHom φ)).mpr hφ_bij
    have hPropP : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver E N).hom := by
      dsimp [weilProjectiveSpaceOver]
      infer_instance
    let : AlgebraicGeometry.IsProper (weilProjectiveSpaceOver E N).hom := hPropP
    let : AlgebraicGeometry.IsClosedImmersion ι.left := hCl
    rw [← CategoryTheory.Over.w ι]
    infer_instance
  have hpBaseMap_k : ∀ (A : IntermediateField K₀ (AlgebraicClosure K₀)),
      CategoryTheory.IsPullback
        (weilBaseChangeMap K₀ ↥A (AlgebraicClosure K₀) Y_K₀)
        (weilBaseChangeOver K₀ (AlgebraicClosure K₀) Y_K₀).hom
        (weilBaseChangeOver K₀ ↥A Y_K₀).hom
        (AlgebraicGeometry.Spec.map
          (CommRingCat.ofHom (algebraMap ↥A (AlgebraicClosure K₀)))) := by
    intro A
    let e_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ ↥A))
    let e_k := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ (AlgebraicClosure K₀)))
    let s_Ak := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥A (AlgebraicClosure K₀)))
    refine CategoryTheory.IsPullback.of_right ?_
      (CategoryTheory.Limits.pullback.lift_snd _ _ _)
      (CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom e_A)
    have h_fst : weilBaseChangeMap K₀ ↥A (AlgebraicClosure K₀) Y_K₀ ≫
        CategoryTheory.Limits.pullback.fst Y_K₀.hom e_A =
        CategoryTheory.Limits.pullback.fst Y_K₀.hom e_k :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have h_bot : s_Ak ≫ e_A = e_k := by
      dsimp [s_Ak, e_A, e_k]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq K₀ ↥A (AlgebraicClosure K₀)]
    rw [h_fst, h_bot]
    exact CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom e_k
  have hLiftCurveMor : ∀ {W : CategoryTheory.Over
        (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K₀)))}
      (φ_bar : W ⟶ weilBaseChangeOver K₀ (AlgebraicClosure K₀) Y_K₀)
      (A B : IntermediateField K₀ (AlgebraicClosure K₀)) (hAB : A ≤ B)
      (C_A : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥A)))
      (μ_A : C_A ⟶ weilBaseChangeOver K₀ ↥A Y_K₀)
      (p_CA : W.left ⟶ C_A.left),
      IsProjectiveOverField ↥A C_A →
      CategoryTheory.IsPullback p_CA W.hom C_A.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥A (AlgebraicClosure K₀)))) →
      p_CA ≫ μ_A.left =
        φ_bar.left ≫ weilBaseChangeMap K₀ ↥A (AlgebraicClosure K₀) Y_K₀ →
      letI : Algebra ↥A ↥B := (IntermediateField.inclusion hAB).toRingHom.toAlgebra
      ∃ (μ_B : weilBaseChangeOver ↥A ↥B C_A ⟶ weilBaseChangeOver K₀ ↥B Y_K₀)
        (p_CB : W.left ⟶ (weilBaseChangeOver ↥A ↥B C_A).left),
        IsProjectiveOverField ↥B (weilBaseChangeOver ↥A ↥B C_A) ∧
        CategoryTheory.IsPullback p_CB W.hom (weilBaseChangeOver ↥A ↥B C_A).hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥B (AlgebraicClosure K₀)))) ∧
        p_CB ≫ μ_B.left =
          φ_bar.left ≫ weilBaseChangeMap K₀ ↥B (AlgebraicClosure K₀) Y_K₀ := by
    intro W φ_bar A B hAB C_A μ_A p_CA hProj_A hp_CA hComm_A
    let : Algebra ↥A ↥B := (IntermediateField.inclusion hAB).toRingHom.toAlgebra
    have : IsScalarTower K₀ ↥A ↥B :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => Subtype.ext rfl)
    have : IsScalarTower ↥A ↥B (AlgebraicClosure K₀) :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
    let C_B := weilBaseChangeOver ↥A ↥B C_A
    have hProj_B : IsProjectiveOverField ↥B C_B :=
      weil_isProjectiveOverField_baseChange ↥A ↥B C_A hProj_A
    let s_AB := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥A ↥B))
    let s_Ak := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥A (AlgebraicClosure K₀)))
    let s_Bk := AlgebraicGeometry.Spec.map
      (CommRingCat.ofHom (algebraMap ↥B (AlgebraicClosure K₀)))
    have hs_ABk : s_Bk ≫ s_AB = s_Ak := by
      dsimp [s_AB, s_Ak, s_Bk]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq ↥A ↥B (AlgebraicClosure K₀)]
    have h_comm_CB : p_CA ≫ C_A.hom = (W.hom ≫ s_Bk) ≫ s_AB := by
      rw [CategoryTheory.Category.assoc, hs_ABk]
      exact hp_CA.w
    let p_CB : W.left ⟶ C_B.left :=
      CategoryTheory.Limits.pullback.lift p_CA (W.hom ≫ s_Bk) h_comm_CB
    have hp_CB : CategoryTheory.IsPullback p_CB W.hom C_B.hom s_Bk := by
      dsimp [p_CB, C_B, weilBaseChangeOver]
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback C_A.hom s_AB)
      rw [CategoryTheory.Limits.pullback.lift_fst, hs_ABk]
      exact hp_CA
    let q_AB : (weilBaseChangeOver K₀ ↥B Y_K₀).left ⟶ (weilBaseChangeOver K₀ ↥A Y_K₀).left :=
      weilBaseChangeMap K₀ ↥A ↥B Y_K₀
    let e_A := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ ↥A))
    let e_B := AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap K₀ ↥B))
    have hs_K0AB : s_AB ≫ e_A = e_B := by
      dsimp [s_AB, e_A, e_B]
      rw [← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq K₀ ↥A ↥B]
    have hq_AB : CategoryTheory.IsPullback q_AB
        (weilBaseChangeOver K₀ ↥B Y_K₀).hom
        (weilBaseChangeOver K₀ ↥A Y_K₀).hom s_AB := by
      refine CategoryTheory.IsPullback.of_right ?_
        (CategoryTheory.Limits.pullback.lift_snd _ _ _)
        (CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom e_A)
      have h_fst : q_AB ≫ CategoryTheory.Limits.pullback.fst Y_K₀.hom e_A =
          CategoryTheory.Limits.pullback.fst Y_K₀.hom e_B :=
        CategoryTheory.Limits.pullback.lift_fst _ _ _
      rw [h_fst, hs_K0AB]
      exact CategoryTheory.IsPullback.of_hasPullback Y_K₀.hom e_B
    let p_A := weilBaseChangeMap K₀ ↥A (AlgebraicClosure K₀) Y_K₀
    let p_B := weilBaseChangeMap K₀ ↥B (AlgebraicClosure K₀) Y_K₀
    have hp_comp : p_B ≫ q_AB = p_A := by
      dsimp [p_A, p_B, q_AB, weilBaseChangeMap, weilBaseChangeOver]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← IsScalarTower.algebraMap_eq ↥A ↥B (AlgebraicClosure K₀)]
    let fst_CB : C_B.left ⟶ C_A.left := CategoryTheory.Limits.pullback.fst C_A.hom s_AB
    have hp_CB_fst : p_CB ≫ fst_CB = p_CA :=
      CategoryTheory.Limits.pullback.lift_fst _ _ _
    have h_comm_fB : (fst_CB ≫ μ_A.left) ≫ (weilBaseChangeOver K₀ ↥A Y_K₀).hom =
        C_B.hom ≫ s_AB := by
      rw [CategoryTheory.Category.assoc, CategoryTheory.Over.w μ_A]
      exact CategoryTheory.Limits.pullback.condition
    let f_B : C_B.left ⟶ (weilBaseChangeOver K₀ ↥B Y_K₀).left :=
      hq_AB.lift (fst_CB ≫ μ_A.left) C_B.hom h_comm_fB
    let μ_B : C_B ⟶ weilBaseChangeOver K₀ ↥B Y_K₀ :=
      CategoryTheory.Over.homMk f_B (hq_AB.lift_snd _ _ _)
    have hComm_B : p_CB ≫ μ_B.left = φ_bar.left ≫ p_B := by
      apply hq_AB.hom_ext
      · change (p_CB ≫ f_B) ≫ q_AB = (φ_bar.left ≫ p_B) ≫ q_AB
        rw [CategoryTheory.Category.assoc, hq_AB.lift_fst,
          ← CategoryTheory.Category.assoc, hp_CB_fst,
          hComm_A, CategoryTheory.Category.assoc, hp_comp]
      · change (p_CB ≫ f_B) ≫ (weilBaseChangeOver K₀ ↥B Y_K₀).hom =
          (φ_bar.left ≫ p_B) ≫ (weilBaseChangeOver K₀ ↥B Y_K₀).hom
        rw [CategoryTheory.Category.assoc, hq_AB.lift_snd, hp_CB.w,
          CategoryTheory.Category.assoc, (hpBaseMap_k B).w,
          ← CategoryTheory.Category.assoc, CategoryTheory.Over.w φ_bar]
    exact ⟨μ_B, p_CB, hProj_B, hp_CB, hComm_B⟩
  have hTransportCurve : ∀ {W : CategoryTheory.Over
        (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure K₀)))}
      (φ_bar : W ⟶ weilBaseChangeOver K₀ (AlgebraicClosure K₀) Y_K₀)
      (A B : IntermediateField K₀ (AlgebraicClosure K₀)) (hAB : A ≤ B)
      (C_A : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥A)))
      (μ_A : C_A ⟶ weilBaseChangeOver K₀ ↥A Y_K₀)
      (p_CA : W.left ⟶ C_A.left),
      IsProjectiveOverField ↥A C_A →
      AlgebraicGeometry.SmoothOfRelativeDimension 1 C_A.hom →
      CategoryTheory.IsPullback p_CA W.hom C_A.hom
        (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥A (AlgebraicClosure K₀)))) →
      p_CA ≫ μ_A.left =
        φ_bar.left ≫ weilBaseChangeMap K₀ ↥A (AlgebraicClosure K₀) Y_K₀ →
      ∃ (C_B : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥B)))
        (μ_B : C_B ⟶ weilBaseChangeOver K₀ ↥B Y_K₀)
        (p_CB : W.left ⟶ C_B.left),
        IsProjectiveOverField ↥B C_B ∧
        AlgebraicGeometry.SmoothOfRelativeDimension 1 C_B.hom ∧
        CategoryTheory.IsPullback p_CB W.hom C_B.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥B (AlgebraicClosure K₀)))) ∧
        p_CB ≫ μ_B.left =
          φ_bar.left ≫ weilBaseChangeMap K₀ ↥B (AlgebraicClosure K₀) Y_K₀ := by
    intro W φ_bar A B hAB C_A μ_A p_CA hProj_A hSm_A hp_CA hComm_A
    let : Algebra ↥A ↥B := (IntermediateField.inclusion hAB).toRingHom.toAlgebra
    obtain ⟨μ_B, p_CB, hProj_B, hp_CB, hComm_B⟩ :=
      hLiftCurveMor φ_bar A B hAB C_A μ_A p_CA hProj_A hp_CA hComm_A
    have hSm_B : AlgebraicGeometry.SmoothOfRelativeDimension 1
        (weilBaseChangeOver ↥A ↥B C_A).hom :=
      @CategoryTheory.MorphismProperty.IsStableUnderBaseChange.of_isPullback _ _
        (@AlgebraicGeometry.SmoothOfRelativeDimension 1)
        (AlgebraicGeometry.smoothOfRelativeDimension_isStableUnderBaseChange 1)
        _ _ _ _ _ _ _ _
        (CategoryTheory.IsPullback.of_hasPullback C_A.hom
          (AlgebraicGeometry.Spec.map (CommRingCat.ofHom (algebraMap ↥A ↥B))))
        hSm_A
    exact ⟨weilBaseChangeOver ↥A ↥B C_A, μ_B, p_CB, hProj_B, hSm_B, hp_CB, hComm_B⟩
  have hTransportOpen : ∀ (U_b : (weilBaseChangeOver K₀ (AlgebraicClosure K₀) Y_K₀).left.Opens)
      (A B : IntermediateField K₀ (AlgebraicClosure K₀)) (hAB : A ≤ B)
      (U_A : (weilBaseChangeOver K₀ ↥A Y_K₀).left.Opens),
      (TopologicalSpace.Opens.map
        (weilBaseChangeMap K₀ ↥A (AlgebraicClosure K₀) Y_K₀).base).obj U_A = U_b →
      ∃ (U_B : (weilBaseChangeOver K₀ ↥B Y_K₀).left.Opens),
        (TopologicalSpace.Opens.map
          (weilBaseChangeMap K₀ ↥B (AlgebraicClosure K₀) Y_K₀).base).obj U_B = U_b := by
    intro U_b A B hAB U_A hU_A
    let : Algebra ↥A ↥B := (IntermediateField.inclusion hAB).toRingHom.toAlgebra
    have : IsScalarTower K₀ ↥A ↥B :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => Subtype.ext rfl)
    have : IsScalarTower ↥A ↥B (AlgebraicClosure K₀) :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
    let q_AB := weilBaseChangeMap K₀ ↥A ↥B Y_K₀
    let p_A := weilBaseChangeMap K₀ ↥A (AlgebraicClosure K₀) Y_K₀
    let p_B := weilBaseChangeMap K₀ ↥B (AlgebraicClosure K₀) Y_K₀
    have hp_comp : p_B ≫ q_AB = p_A := by
      dsimp [p_A, p_B, q_AB, weilBaseChangeMap, weilBaseChangeOver]
      apply CategoryTheory.Limits.pullback.hom_ext
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_fst,
          CategoryTheory.Limits.pullback.lift_fst, CategoryTheory.Limits.pullback.lift_fst]
      · rw [CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Limits.pullback.lift_snd,
          ← CategoryTheory.Category.assoc, CategoryTheory.Limits.pullback.lift_snd,
          CategoryTheory.Category.assoc,
          ← AlgebraicGeometry.Spec.map_comp, ← CommRingCat.ofHom_comp,
          ← IsScalarTower.algebraMap_eq ↥A ↥B (AlgebraicClosure K₀)]
    refine ⟨(TopologicalSpace.Opens.map q_AB.base).obj U_A, ?_⟩
    change (TopologicalSpace.Opens.map (p_B ≫ q_AB).base).obj U_A = U_b
    rw [hp_comp, hU_A]
  have hPerCurve : ∀ j : Fin s,
      ∃ (L_c : IntermediateField K₀ (AlgebraicClosure K₀))
        (_ : FiniteDimensional K₀ ↥L_c)
        (C_c : CategoryTheory.Over (AlgebraicGeometry.Spec (CommRingCat.of ↥L_c)))
        (μ_c : C_c ⟶ weilBaseChangeOver K₀ ↥L_c Y_K₀)
        (p_c : (C_bar j).left ⟶ C_c.left),
        IsProjectiveOverField ↥L_c C_c ∧
