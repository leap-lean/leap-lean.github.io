      refine Finset.Nonempty.cons_induction (fun a => ⟨a, Finset.mem_singleton_self a, fun x hx => ?_⟩)
        (fun a s_fin has _ ⟨b, hb_mem, hb_dvd⟩ => ?_) hG'_ne
